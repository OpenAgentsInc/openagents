// Hold the Stair, openagents.com/realms/hold-the-stair: a popping tower
// defense on the SRD 5e rules (docs/verse/game-ideas/hold-the-stair.md).
// Bubble-beasts climb a winding stair from the cellar door to the top of the
// wizard's tower; you place a party beside it with gold. Each defender rolls
// a real d20 against a beast's armor class on its turn (verse/rules/
// srd5-combat.coax), damage types meet immunities (an ember shrugs off fire),
// and a popped beast lets out the layer inside. Ten waves; lives are the
// tower's hit points.
//
// Everything is drawn flat: stair.wgsl's bg_fs draws the floor, the stair and
// the panels from the uniforms; the beasts, the party, the bolts, the red
// damage numbers and the HUD text are fx strokes (font.coax).
//   coax/bin/coax test apps/openagents-web/stair.coax --steps 2000000000

#load "font.coax";
#load "analytics.coax";
#load "../../verse/rules/srd5-combat.coax";

VERTEX_FLOATS :: 16;
MAX_VERTICES :: 36000;
PLATES :: 24;
COLS :: 14; ROWS :: 9; CELLS :: 126;
// The uniforms: size, time, fade; the map (origin x, y, tile, squash); info (screen cols, rows,
// portrait, hover cell); info2 (hurt, selected cell, plates, 0); the cells (a kind each, 128: the
// stair's progress as its fraction, 10 + class where a defender stands); the units (a defender's
// facing × 1 + its attack flash; 3 for the ghost of one about to go down); the plates.
U_MAP :: 4; U_INFO :: 8; U_INFO2 :: 12; U_CELLS :: 16; U_UNIT :: 144; U_PLATE :: 272;
UNIFORM_FLOATS :: U_PLATE + PLATES * 8;
SQUASH :: 0.86;          // the slight tilt: a tile is drawn this much shorter than wide
WALL_ROWS :: 0.55;       // the back wall above the map, and the stone rim round the rest (stair.wgsl's WALL, RIM)
RIM_TILES :: 0.16;

CELL_FLOOR :: 0; CELL_PATH :: 1; CELL_DEFENDER :: 2; CELL_DOOR :: 3; CELL_TOP :: 4;

// The stair: waypoints (column, row) from the cellar door to the tower top.
WAYPOINTS :: 8;
WAY_C :: [8] int.[0, 3, 3, 7, 7, 10, 10, 13];
WAY_R :: [8] int.[7, 7, 2, 2, 6, 6, 1, 1];

// ---- the bubble-beasts (original creatures, stat blocks in the SRD's terms)
MOTE :: 0; WISP :: 1; GLIMMER :: 2; EMBER :: 3; LAYERS :: 4;
LAYER_NAME :: [4] string.["MOTE", "WISP", "GLIMMER", "EMBER"];
LAYER_AC :: [4] int.[10, 11, 13, 12];
LAYER_HP :: [4] int.[2, 4, 5, 7];
LAYER_DEX :: [4] int.[0, 1, 3, 1];          // Dexterity save
LAYER_SPEED :: [4] f32.[1.0, 1.25, 1.9, 1.45]; // tiles a second
LAYER_SIZE :: [4] f32.[0.19, 0.24, 0.26, 0.3];
LAYER_GOLD :: [4] int.[2, 2, 3, 3];        // gold for popping it
LAYER_LIVES :: [4] int.[1, 3, 7, 11];        // what it takes from the tower at the top (itself and all inside)
LAYER_R :: [4] f32.[0.55, 0.35, 1.0, 1.0];
LAYER_G :: [4] f32.[0.8, 1.0, 0.86, 0.2];
LAYER_B :: [4] f32.[1.0, 0.45, 0.25, 0.22];
// What each pops into: up to two inner layers (-1 none).
INNER_A :: [4] int.[-1, MOTE, WISP, GLIMMER];
INNER_B :: [4] int.[-1, MOTE, WISP, WISP];

// ---- the party (SRD 5.2.1 classes at level 1)
FIGHTER :: 0; WIZARD :: 1; CLERIC :: 2; CLASSES :: 3;
CLASS_NAME :: [3] string.["FIGHTER", "WIZARD", "CLERIC"];
CLASS_COST :: [3] int.[50, 85, 65];
CLASS_RANGE :: [3] f32.[1.6, 3.4, 3.0];      // tiles
CLASS_TURN :: [3] f32.[0.9, 1.4, 1.3];       // seconds between turns (the six-second round, scaled)
CLASS_R :: [3] f32.[0.85, 0.72, 1.0];
CLASS_G :: [3] f32.[0.88, 0.55, 0.86];
CLASS_B :: [3] f32.[0.95, 1.0, 0.42];
// Fighter: Strength 16 (+3), proficiency +2: a longsword, +5 to hit, 1d8 + 3 slashing.
STAIR_FIGHTER :: SrdCreature.{name = "Fighter", ac = 16, hp = 12, dex = 1, attack = 5, dice = 1, sides = 8, bonus = 3, kind = DMG_SLASHING};
// Wizard: Intelligence 16 (+3), proficiency +2: Fire Bolt, a ranged spell attack +5, 1d10 fire.
STAIR_FIRE_BOLT :: SrdCreature.{name = "Fire Bolt", ac = 12, hp = 8, dex = 2, attack = 5, dice = 1, sides = 10, bonus = 0, kind = DMG_FIRE};
// Magic Missile (level 1): three darts that never miss, 1d4 + 1 force each. Two slots a wave.
MM_SLOTS :: 2;
// Cleric: Wisdom 16 (+3), proficiency +2: Sacred Flame, a Dexterity save against DC 13, 1d8 radiant.
SACRED_DC :: 13;

// ---- levels 2 and 3 (SRD 5.2.1 class features and spell slots; proficiency stays +2)
// Fighter 2: Action Surge, its turn takes two attacks once a wave. Fighter 3 (Champion): Improved
// Critical, a 19 or 20 crits. Wizard 2: three 1st-level slots (Magic Missile). Wizard 3: two
// 2nd-level slots a wave for Shatter: everything within 10 feet (a tile) of the target makes a
// Constitution save against DC 13, 3d8 thunder, half on a success. Cleric 2: Bless, the party in
// its reach adds a d4 to attack rolls. Cleric 3: Spiritual Weapon, a melee spell attack +5 each
// turn too, 1d8 + 3 force.
MAX_LEVEL :: 3;
UP_COST :: [6] int.[30, 50, 50, 80, 40, 65];     // (class, level 2), (class, level 3)
SHATTER_SLOTS :: 2; SHATTER_RADIUS :: 1.0; SHATTER_DC :: 13; SHATTER_MIN :: 3;
LAYER_CON :: [4] int.[0, 0, 1, 2];               // Constitution save
STAIR_SPIRIT :: SrdCreature.{name = "Spiritual Weapon", ac = 10, hp = 1, dex = 0, attack = 5, dice = 1, sides = 8, bonus = 3, kind = DMG_FORCE};
up_cost :: (cls: int, level: int) -> int { return ifx level >= MAX_LEVEL then 0 else UP_COST[cls * 2 + level - 1]; }

// ---- the waves: up to three groups each (layer, count, seconds between, delay)
WAVES :: 10;
GROUPS :: 3;
WAVE_KIND :: [30] int.[
  MOTE, -1, -1,      MOTE, -1, -1,       WISP, MOTE, -1,     WISP, MOTE, -1,     GLIMMER, WISP, -1,
  GLIMMER, WISP, -1, EMBER, GLIMMER, -1, EMBER, WISP, -1,    GLIMMER, EMBER, -1, EMBER, GLIMMER, EMBER];
WAVE_COUNT :: [30] int.[
  12, 0, 0,   20, 0, 0,   8, 14, 0,   18, 10, 0,   6, 14, 0,
  14, 10, 0,  5, 12, 0,   10, 12, 0,  18, 8, 0,    12, 12, 6];
WAVE_GAP :: [30] f32.[
  0.9, 0, 0,   0.55, 0, 0,   1.0, 0.5, 0,   0.6, 0.4, 0,   1.2, 0.6, 0,
  0.7, 0.5, 0,  1.6, 0.6, 0,  1.0, 0.5, 0,   0.45, 1.0, 0,  0.8, 0.5, 0.6];
WAVE_DELAY :: [30] f32.[
  0, 0, 0,   0, 0, 0,   0, 2, 0,   0, 3, 0,   0, 1, 0,
  0, 3, 0,   0, 2, 0,   0, 4, 0,   0, 3, 0,   0, 4, 9];

START_GOLD :: 140;
START_LIVES :: 50;
// How many defenders go on the field in one round: three, and one more every two waves.
ROUND_BASE :: 3; ROUND_EVERY :: 2;
BEASTS :: 320;
DEFENDERS :: 48;
FX :: 160;
STEP :: 0.0166666667;

// Phases
BUILD :: 0; FIGHT :: 1; WON :: 2; LOST :: 3;

// Fx kinds
FX_NUM :: 1; FX_MISS :: 2; FX_IMMUNE :: 3; FX_BOLT :: 4; FX_SLASH :: 5; FX_POP :: 6; FX_FLAME :: 7; FX_DART :: 8; FX_SAVED :: 9; FX_CRIT :: 10; FX_SHATTER :: 11; FX_SPIRIT :: 12; FX_LEVEL :: 13;

// Buttons
B_START :: 0; B_FAST :: 1; B_GALAXY :: 2; B_FIGHTER :: 3; B_WIZARD :: 4; B_CLERIC :: 5; B_SELL :: 6; B_CLOSE :: 7; B_AGAIN :: 8; B_PAUSE :: 9; B_UPGRADE :: 10; BUTTONS :: 11;

OUTBOX_CAP :: 128;
ACT_NAVIGATE :: 1;
KEY_ESCAPE :: -1; KEY_ENTER :: -2;
LONG_PRESS :: 0.45;

INK_R :: 0.86; INK_G :: 0.88; INK_B :: 0.92;
GOLD_R :: 1.0; GOLD_G :: 0.8; GOLD_B :: 0.35;

Rect :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }
Beast :: struct { live: bool; kind: int; d: f32; hp: int; wob: f32; age: f32; }
Defender :: struct {
  live: bool; cls: int; cell: int; wait: f32; slots: int;
  level: int; surge: bool; slots2: int; bless: int;   // bless: the d4 Bless added to its last roll (0 none)
  hits: int; misses: int; pops: int;
  roll: int; total: int; vs: int; hit: bool; crit: bool; dealt: int; how: int;   // the last turn (how: 0 attack, 1 save, 2 auto)
  aim: f32; flash: f32;
}
Fx :: struct { kind: int; x: f32; y: f32; x2: f32; y2: f32; t: f32; life: f32; amount: int; r: f32; g: f32; b: f32; big: bool; dx: f32; }

Stair :: struct {
  started: bool;
  track: [1] Track;
  dice: [1] SrdDice;
  time: f64; clock: f32; acc: f32;
  width: f32; height: f32; dpr: f32;
  golden: bool; still: bool; touch: bool;
  // the map's layout this frame
  portrait: bool; ox: f32; oy: f32; tile: f32; scols: int; srows: int;
  path_len: f32;
  cells: [CELLS] int;
  prog: [CELLS] f32;        // how far up the stair a stair cell is (tiles)
  phase: int; wave: int; lives: int; gold: int; speed: int;
  spawned: [GROUPS] int; spawn_t: [GROUPS] f32; wave_t: f32;
  beasts: [BEASTS] Beast;
  party: [DEFENDERS] Defender;
  pops: int; leaked: int; placed: int; placed_round: int;
  pick: int;                // the class armed for placing (-1 none)
  paused: bool;
  fx: [FX] Fx; fx_next: int;
  hurt: f32;
  banner: f32;              // the wave's name across the map as it starts (seconds left)
  selected: int;            // a cell (-1 none)
  card: int;                // a defender whose card shows (-1 none)
  hover: int;               // the cell under the mouse (-1)
  hover_b: int;
  boxes: [BUTTONS] Rect; shown: [BUTTONS] bool; enabled: [BUTTONS] bool;
  press: int; press_id: int; down_t: f32; down_x: f32; down_y: f32; down_cell: int; down_on: bool; long_done: bool;
  plate_n: int;
  toast: [64] u8; toast_n: int; toast_t: f32;
  outbox: [OUTBOX_CAP] u8; out_n: int; action: int;
  facts: bool; tracked_wave: int;
}

// ---- small things

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
lo_i :: (a: int, b: int) -> int { if a < b { return a; } return b; }
hi_i :: (a: int, b: int) -> int { if a > b { return a; } return b; }
clamp01 :: (v: f32) -> f32 { return lo(1, hi(0, v)); }
GAP :: 0.5; SPACE :: 1.2;
text_width :: (text: string, cap: f32) -> f32 { return measure(text, GAP, SPACE, false) * cap; }
in_rect :: (b: Rect, x: f32, y: f32) -> bool { return b.x1 > b.x0 && x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }
put :: (buf: [] u8, at: int, text: string) -> int {
  n := at;
  for c: text { if n >= buf.count { break; } buf[n] = c; n += 1; }
  return n;
}
put_int :: (buf: [] u8, at: int, v: int) -> int {
  n := at;
  x := v;
  if x < 0 { if n < buf.count { buf[n] = 45; n += 1; } x = -x; }
  digits: [20] u8; d := 0;
  if x == 0 { digits[0] = 48; d = 1; }
  while x > 0 && d < 20 { digits[d] = cast(u8) (48 + x % 10); x = x / 10; d += 1; }
  while d > 0 { d -= 1; if n < buf.count { buf[n] = digits[d]; n += 1; } }
  return n;
}
// A number after key= in a URL's query (or -1).
query_number :: (url: string, key: string) -> f32 {
  at := 0;
  while at + key.count + 1 <= url.count {
    before := ifx at == 0 then cast(u8) 63 else url[at - 1];
    if (before == 63 || before == 38) && url[at..<at + key.count] == key && url[at + key.count] == 61 {
      i := at + key.count + 1;
      v: f32 = 0; digits := 0;
      while i < url.count && url[i] >= 48 && url[i] <= 57 && digits < 6 { v = v * 10 + f32(url[i] - 48); i += 1; digits += 1; }
      if digits == 0 { return -1; }
      return v;
    }
    at += 1;
  }
  return -1;
}

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  return lit_bar(out, at, ax, ay, bx, by, core, light, glow, red, green, blue, mode, 0, 0, 0, 0);
}
// A stroke with stair.wgsl's mode and its four more numbers (bar).
lit_bar :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32, b0: f32, b1: f32, b2: f32, b3: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { return false; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = b0; out[o + 13] = b1; out[o + 14] = b2; out[o + 15] = b3;
  }
  return true;
}
seg :: (out: [] f32, n: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32, r: f32, g: f32, b: f32) -> int {
  if lit(out, n, ax, ay, bx, by, core, light, glow, r, g, b, 0) { return n + 6; }
  return n;
}
disc :: (out: [] f32, n: int, x: f32, y: f32, rad: f32, light: f32, glow: f32, r: f32, g: f32, b: f32) -> int {
  return seg(out, n, x - 0.01, y, x + 0.01, y, rad, light, glow, r, g, b);
}
// A ring on the floor (squashed by the tilt), one quad: stair.wgsl's mode 1.
ring :: (out: [] f32, n: int, x: f32, y: f32, rad: f32, width: f32, light: f32, r: f32, g: f32, b: f32, sides: int) -> int {
  return ring_sq(out, n, x, y, rad, width, light, r, g, b, f32(SQUASH));
}
ring_sq :: (out: [] f32, n: int, x: f32, y: f32, rad: f32, width: f32, light: f32, r: f32, g: f32, b: f32, squash: f32) -> int {
  if lit_bar(out, n, x - 0.01, y, x + 0.01, y, rad, light, width * 2 + 1, r, g, b, 1, width * 0.5, squash, 0, 0) { return n + 6; }
  return n;
}
// A glossy bubble (mode 2) with the layer inside showing (inner: its radius as a share, 0 none).
bubble :: (out: [] f32, n: int, x: f32, y: f32, rad: f32, light: f32, r: f32, g: f32, b: f32, inner: f32, ir: f32, ig: f32, ib: f32) -> int {
  if lit_bar(out, n, x - 0.01, y, x + 0.01, y, rad, light, rad * 0.7, r, g, b, 2, inner, ir, ig, ib) { return n + 6; }
  return n;
}
// A soft light (mode 3).
glow_disc :: (out: [] f32, n: int, x: f32, y: f32, rad: f32, light: f32, r: f32, g: f32, b: f32) -> int {
  if lit_bar(out, n, x - 0.01, y, x + 0.01, y, rad, light, 1, r, g, b, 3, 0, 0, 0, 0) { return n + 6; }
  return n;
}
ink :: (k: f32, light: f32, red: f32, green: f32, blue: f32) -> Ink {
  i: Ink;
  i.core = 0.6 * k; i.light = light; i.glow = 1.2 * k; i.red = red; i.green = green; i.blue = blue; i.mode = 0; i.scale = k;
  return i;
}
say_at :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return draw_text(out, n, t, x, base, cap, GAP, SPACE, k, false, false);
}
say_mid :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return say_at(out, n, t, x - text_width(t, cap) / 2, base, cap, k);
}

// ---- the stair

cell_of :: (c: int, r: int) -> int { return c + r * COLS; }
// Distance along the stair at the centre of each waypoint, and where a distance is (tile units).
path_length :: () -> f32 {
  l := 0.0f32;
  for i: 1..<WAYPOINTS { l += f32(abs_i(WAY_C[i] - WAY_C[i - 1]) + abs_i(WAY_R[i] - WAY_R[i - 1])); }
  return l + 1.0;   // the door and the top are half a tile each, and half a tile off the top
}
abs_i :: (v: int) -> int { return ifx v < 0 then -v else v; }
P2 :: struct { x: f32; y: f32; }
path_at :: (d: f32) -> P2 {
  // half a tile in from the door
  left := d - 0.5;
  if left < 0 { return P2.{x = f32(WAY_C[0]) + 0.5 + left, y = f32(WAY_R[0]) + 0.5}; }
  for i: 1..<WAYPOINTS {
    dc := WAY_C[i] - WAY_C[i - 1]; dr := WAY_R[i] - WAY_R[i - 1];
    seglen := f32(abs_i(dc) + abs_i(dr));
    if left <= seglen || i == WAYPOINTS - 1 {
      t := left / hi(seglen, 0.001);
      return P2.{x = f32(WAY_C[i - 1]) + 0.5 + f32(dc) * t, y = f32(WAY_R[i - 1]) + 0.5 + f32(dr) * t};
    }
    left -= seglen;
  }
  return P2.{x = 13.5, y = 1.5};
}
lay_cells :: (s: [] Stair) {
  for i: 0..<CELLS { s[0].cells[i] = CELL_FLOOR; s[0].prog[i] = 0; }
  d := 0.5f32;
  for i: 1..<WAYPOINTS {
    c := WAY_C[i - 1]; r := WAY_R[i - 1];
    while true {
      s[0].cells[cell_of(c, r)] = CELL_PATH; s[0].prog[cell_of(c, r)] = d;
      if c == WAY_C[i] && r == WAY_R[i] { break; }
      if c < WAY_C[i] { c += 1; } else if c > WAY_C[i] { c -= 1; } else if r < WAY_R[i] { r += 1; } else { r -= 1; }
      d += 1;
    }
  }
  s[0].cells[cell_of(WAY_C[0], WAY_R[0])] = CELL_DOOR;
  s[0].cells[cell_of(WAY_C[WAYPOINTS - 1], WAY_R[WAYPOINTS - 1])] = CELL_TOP;
  for i: 0..<DEFENDERS { if s[0].party[i].live { s[0].cells[s[0].party[i].cell] = CELL_DEFENDER; } }
}
free_cell :: (s: [] Stair, cell: int) -> bool { return cell >= 0 && cell < CELLS && s[0].cells[cell] == CELL_FLOOR; }
defender_at :: (s: [] Stair, cell: int) -> int {
  for i: 0..<DEFENDERS { if s[0].party[i].live && s[0].party[i].cell == cell { return i; } }
  return -1;
}

// ---- starting

stair_reset :: (s: [] Stair) {
  s[0].phase = BUILD; s[0].wave = 0; s[0].lives = START_LIVES; s[0].gold = START_GOLD; s[0].speed = 1;
  for i: 0..<BEASTS { s[0].beasts[i].live = false; }
  for i: 0..<DEFENDERS { s[0].party[i].live = false; }
  for i: 0..<FX { s[0].fx[i].life = 0; }
  s[0].pops = 0; s[0].leaked = 0; s[0].placed = 0; s[0].placed_round = 0;
  s[0].pick = -1; s[0].paused = false;
  s[0].selected = -1; s[0].card = -1; s[0].hurt = 0;
  s[0].path_len = path_length();
  lay_cells(s);
}
stair_start :: (s: [] Stair) {
  if s[0].started { return; }
  s[0].started = true;
  s[0].dice[0] = srd_dice(20261030);
  s[0].hover = -1; s[0].hover_b = -1; s[0].press = -1; s[0].press_id = -1; s[0].down_cell = -1;
  s[0].tracked_wave = 0;
  track_init(s[0].track[..], "hold-the-stair");
  stair_reset(s);
}

say :: (s: [] Stair, t: string) { s[0].toast_n = put(s[0].toast[..], 0, t); s[0].toast_t = 2.4; }

// ---- the fight

add_fx :: (s: [] Stair, kind: int, x: f32, y: f32, x2: f32, y2: f32, life: f32, amount: int, r: f32, g: f32, b: f32, big: bool) {
  k := s[0].fx_next; s[0].fx_next = (k + 1) % FX;
  dx := srd_unit(s[0].dice[..]) * 2 - 1;
  s[0].fx[k] = Fx.{kind = kind, x = x, y = y, x2 = x2, y2 = y2, t = 0, life = life, amount = amount, r = r, g = g, b = b, big = big, dx = dx};
}
beast_xy :: (s: [] Stair, i: int) -> P2 { return path_at(s[0].beasts[i].d); }
cell_xy :: (cell: int) -> P2 { return P2.{x = f32(cell % COLS) + 0.5, y = f32(cell / COLS) + 0.5}; }

spawn :: (s: [] Stair, kind: int, d: f32) -> int {
  for i: 0..<BEASTS {
    if !s[0].beasts[i].live {
      s[0].beasts[i] = Beast.{live = true, kind = kind, d = d, hp = LAYER_HP[kind], wob = srd_unit(s[0].dice[..]) * 6.28};
      return i;
    }
  }
  return -1;
}
live_beasts :: (s: [] Stair) -> int { n := 0; for i: 0..<BEASTS { if s[0].beasts[i].live { n += 1; } } return n; }

// A beast loses `amount` of `kind` damage: immunities and resistances first; at 0 it pops.
hurt_beast :: (s: [] Stair, i: int, amount: int, kind: int, crit: bool, by: int) {
  b := s[0].beasts[i];
  p := beast_xy(s, i);
  if b.kind == EMBER && kind == DMG_FIRE { add_fx(s, FX_IMMUNE, p.x, p.y, 0, 0, 0.9, 0, 1, 0.45, 0.45, false); return; }
  dealt := amount;
  if b.kind == WISP && kind == DMG_COLD { dealt = amount / 2; }
  if by >= 0 { s[0].party[by].dealt = dealt; }
  add_fx(s, FX_NUM, p.x, p.y, 0, 0, 0.9, dealt, 1, 0.16, 0.1, crit);
  s[0].beasts[i].hp -= dealt;
  if s[0].beasts[i].hp > 0 { return; }
  // pop: the layer inside comes out where it was
  s[0].beasts[i].live = false;
  s[0].gold += LAYER_GOLD[b.kind]; s[0].pops += 1;
  if by >= 0 { s[0].party[by].pops += 1; }
  add_fx(s, FX_POP, p.x, p.y, 0, 0, 0.6, 0, LAYER_R[b.kind], LAYER_G[b.kind], LAYER_B[b.kind], b.kind >= GLIMMER);
  if INNER_A[b.kind] >= 0 { j := spawn(s, INNER_A[b.kind], b.d + 0.12); }
  if INNER_B[b.kind] >= 0 { j := spawn(s, INNER_B[b.kind], hi(b.d - 0.12, 0)); }
}

// The beast furthest along within range of a cell (-1 none); skip: a layer to pass over (-1 none).
first_in_range :: (s: [] Stair, cell: int, range: f32, skip: int) -> int {
  c := cell_xy(cell);
  best := -1; far := -1.0f32;
  for i: 0..<BEASTS {
    if !s[0].beasts[i].live || s[0].beasts[i].kind == skip { continue; }
    p := beast_xy(s, i);
    dx := p.x - c.x; dy := p.y - c.y;
    if dx * dx + dy * dy <= range * range && s[0].beasts[i].d > far { far = s[0].beasts[i].d; best = i; }
  }
  return best;
}

// A wave's spell slots and Action Surge come back.
refresh :: (s: [] Stair, k: int) {
  lv := s[0].party[k].level;
  s[0].party[k].slots = ifx lv >= 2 then MM_SLOTS + 1 else MM_SLOTS;
  s[0].party[k].slots2 = ifx lv >= 3 then SHATTER_SLOTS else 0;
  s[0].party[k].surge = lv >= 2;
}
// A cleric of level 2 or more with this defender in its reach blesses it.
blessed :: (s: [] Stair, k: int) -> bool {
  c := cell_xy(s[0].party[k].cell);
  for i: 0..<DEFENDERS {
    d := s[0].party[i];
    if !d.live || d.cls != CLERIC || d.level < 2 { continue; }
    e := cell_xy(d.cell);
    if (e.x - c.x) * (e.x - c.x) + (e.y - c.y) * (e.y - c.y) <= CLASS_RANGE[CLERIC] * CLASS_RANGE[CLERIC] { return true; }
  }
  return false;
}
// An attack roll as srd_attack's, with a crit on crit_on or better and Bless's d4 when blessed.
stair_attack :: (s: [] Stair, k: int, c: SrdCreature, ac: int, crit_on: int) -> SrdAttack {
  dice := s[0].dice[..];
  a: SrdAttack;
  a.roll = srd_roll(dice, 20);
  bless := ifx blessed(s, k) then srd_roll(dice, 4) else 0;
  s[0].party[k].bless = bless;
  a.total = a.roll + c.attack + bless;
  a.crit = a.roll >= crit_on;
  a.hit = a.roll != 1 && (a.crit || a.total >= ac);
  if a.hit {
    n := ifx a.crit then c.dice * 2 else c.dice;
    a.damage = srd_max_i(srd_sum(dice, n, c.sides) + c.bonus, 1);
  }
  return a;
}
// A fighter's attack on the beast furthest along in reach (false: nothing in reach).
fighter_attack :: (s: [] Stair, k: int) -> bool {
  d := s[0].party[k];
  c := cell_xy(d.cell);
  t := first_in_range(s, d.cell, CLASS_RANGE[FIGHTER], -1);
  if t < 0 { return false; }
  b := s[0].beasts[t]; p := beast_xy(s, t);
  a := stair_attack(s, k, STAIR_FIGHTER, LAYER_AC[b.kind], ifx d.level >= 3 then 19 else 20);
  record(s, k, a.roll, a.total, LAYER_AC[b.kind], a.hit, a.crit, 0, p);
  add_fx(s, FX_SLASH, c.x, c.y, p.x, p.y, 0.26, 0, 0.9, 0.92, 1.0, a.crit);
  if a.crit { add_fx(s, FX_CRIT, p.x, p.y, 0, 0, 1.1, a.roll, 1, 0.86, 0.4, true); }
  if a.hit { hurt_beast(s, t, a.damage, STAIR_FIGHTER.kind, a.crit, k); } else { add_fx(s, FX_MISS, p.x, p.y, 0, 0, 0.7, a.roll, 0.8, 0.8, 0.85, false); }
  return true;
}
// Live beasts within r tiles of a beast.
crowd :: (s: [] Stair, t: int, r: f32) -> int {
  p := beast_xy(s, t);
  n := 0;
  for i: 0..<BEASTS {
    if !s[0].beasts[i].live { continue; }
    q := beast_xy(s, i);
    if (q.x - p.x) * (q.x - p.x) + (q.y - p.y) * (q.y - p.y) <= r * r { n += 1; }
  }
  return n;
}

// One defender's turn.
take_turn :: (s: [] Stair, k: int) -> bool {
  d := s[0].party[k];
  c := cell_xy(d.cell);
  dice := s[0].dice[..];
  if d.cls == FIGHTER {
    if !fighter_attack(s, k) { return false; }
    // Action Surge: once a wave, a second attack
    if s[0].party[k].surge {
      s[0].party[k].surge = false;
      ok := fighter_attack(s, k);
    }
    return true;
  }
  if d.cls == WIZARD {
    t := first_in_range(s, d.cell, CLASS_RANGE[WIZARD], -1);
    if t < 0 { return false; }
    // Shatter, where three or more crowd together
    if d.slots2 > 0 && crowd(s, t, f32(SHATTER_RADIUS)) >= SHATTER_MIN {
      s[0].party[k].slots2 -= 1;
      at := beast_xy(s, t);
      record(s, k, 0, 0, SHATTER_DC, true, false, 3, at);
      add_fx(s, FX_SHATTER, at.x, at.y, c.x, c.y, 0.6, 0, 0.75, 0.8, 1.0, false);
      dmg := srd_sum(dice, 3, 8);
      total := 0;
      for i: 0..<BEASTS {
        if !s[0].beasts[i].live { continue; }
        q := beast_xy(s, i);
        if (q.x - at.x) * (q.x - at.x) + (q.y - at.y) * (q.y - at.y) > f32(SHATTER_RADIUS) * f32(SHATTER_RADIUS) { continue; }
        sv := srd_save(dice, LAYER_CON[s[0].beasts[i].kind], SHATTER_DC);
        took := ifx sv.success then dmg / 2 else dmg;
        total += took;
        hurt_beast(s, i, took, DMG_THUNDER, false, k);
      }
      s[0].party[k].dealt = total;
      return true;
    }
    // an ember is immune to fire: Magic Missile while a slot lasts, else Fire Bolt at what isn't an ember
    if s[0].beasts[t].kind == EMBER {
      if d.slots > 0 {
        s[0].party[k].slots -= 1;
        p := beast_xy(s, t);
        record(s, k, 0, 0, 0, true, false, 2, p);
        total := 0;
        for dart: 0..<3 {
          if !s[0].beasts[t].live { t = first_in_range(s, d.cell, CLASS_RANGE[WIZARD], -1); if t < 0 { break; } }
          q := beast_xy(s, t);
          add_fx(s, FX_DART, c.x, c.y, q.x, q.y, 0.45, 0, 0.75, 0.6, 1.0, false);
          dmg := srd_roll(dice, 4) + 1; total += dmg;
          hurt_beast(s, t, dmg, DMG_FORCE, false, k);
        }
        s[0].party[k].dealt = total;
        return true;
      }
      other := first_in_range(s, d.cell, CLASS_RANGE[WIZARD], EMBER);
      if other >= 0 { t = other; }
    }
    b := s[0].beasts[t]; p := beast_xy(s, t);
    a := stair_attack(s, k, STAIR_FIRE_BOLT, LAYER_AC[b.kind], 20);
    record(s, k, a.roll, a.total, LAYER_AC[b.kind], a.hit, a.crit, 0, p);
    add_fx(s, FX_BOLT, c.x, c.y, p.x, p.y, 0.4, 0, 1.0, 0.3, 0.15, a.crit);
    if a.crit { add_fx(s, FX_CRIT, p.x, p.y, 0, 0, 1.1, a.roll, 1, 0.86, 0.4, true); }
    if a.hit { hurt_beast(s, t, a.damage, DMG_FIRE, a.crit, k); } else { add_fx(s, FX_MISS, p.x, p.y, 0, 0, 0.7, a.roll, 0.8, 0.8, 0.85, false); }
    return true;
  }
  // Cleric: Sacred Flame, the target saves (Dexterity) against DC 13 or takes 1d8 radiant
  t := first_in_range(s, d.cell, CLASS_RANGE[CLERIC], -1);
  if t < 0 { return false; }
  b := s[0].beasts[t]; p := beast_xy(s, t);
  sv := srd_save(dice, LAYER_DEX[b.kind], SACRED_DC);
  record(s, k, sv.roll, sv.total, SACRED_DC, !sv.success, false, 1, p);
  add_fx(s, FX_FLAME, p.x, p.y, c.x, c.y, 0.55, 0, 1.0, 0.92, 0.55, false);
  if !sv.success { hurt_beast(s, t, srd_roll(dice, 8), DMG_RADIANT, false, k); } else { add_fx(s, FX_SAVED, p.x, p.y, 0, 0, 0.7, sv.roll, 0.8, 0.8, 0.85, false); }
  // Spiritual Weapon: a spectral mace strikes too
  if d.level >= 3 {
    w := first_in_range(s, d.cell, CLASS_RANGE[CLERIC], -1);
    if w >= 0 {
      q := beast_xy(s, w);
      a := srd_attack(dice, STAIR_SPIRIT, LAYER_AC[s[0].beasts[w].kind]);
      add_fx(s, FX_SPIRIT, q.x, q.y, c.x, c.y, 0.4, 0, 1.0, 0.9, 0.5, a.crit);
      if a.hit { hurt_beast(s, w, a.damage, DMG_FORCE, a.crit, k); } else { add_fx(s, FX_MISS, q.x, q.y, 0, 0, 0.7, a.roll, 0.8, 0.8, 0.85, false); }
    }
  }
  return true;
}
record :: (s: [] Stair, k: int, roll: int, total: int, vs: int, hit: bool, crit: bool, how: int, at: P2) {
  s[0].party[k].roll = roll; s[0].party[k].total = total; s[0].party[k].vs = vs;
  s[0].party[k].hit = hit; s[0].party[k].crit = crit; s[0].party[k].how = how; s[0].party[k].dealt = 0;
  if hit { s[0].party[k].hits += 1; } else { s[0].party[k].misses += 1; }
  c := cell_xy(s[0].party[k].cell);
  s[0].party[k].aim = atan2_f(at.y - c.y, at.x - c.x);
  s[0].party[k].flash = 1;
}
atan2_f :: (y: f32, x: f32) -> f32 {
  // enough for which way a defender faces
  if abs(x) < 0.0001 && abs(y) < 0.0001 { return 0; }
  a := 0.0f32;
  if abs(x) >= abs(y) { z := y / x; a = z / (1 + 0.28 * z * z); if x < 0 { a += ifx y >= 0 then 3.14159265 else -3.14159265; } }
  else { z := x / y; a = 1.5707963 - z / (1 + 0.28 * z * z); if y < 0 { a -= 3.14159265; } }
  return a;
}

wave_groups_done :: (s: [] Stair) -> bool {
  w := s[0].wave - 1;
  for g: 0..<GROUPS { if WAVE_KIND[w * GROUPS + g] >= 0 && s[0].spawned[g] < WAVE_COUNT[w * GROUPS + g] { return false; } }
  return true;
}

start_wave :: (s: [] Stair) -> bool {
  if s[0].phase != BUILD || s[0].wave >= WAVES { return false; }
  s[0].wave += 1; s[0].phase = FIGHT; s[0].wave_t = 0; s[0].banner = 1.6;
  for g: 0..<GROUPS { s[0].spawned[g] = 0; s[0].spawn_t[g] = WAVE_DELAY[(s[0].wave - 1) * GROUPS + g]; }
  for i: 0..<DEFENDERS { refresh(s, i); }
  s[0].placed_round = 0;
  if round_allowance(s[0].wave) > round_allowance(s[0].wave - 1) {
    buf: [48] u8;
    n := put(buf[..], 0, "NOW "); n = put_int(buf[..], n, round_allowance(s[0].wave)); n = put(buf[..], n, " DEFENDERS A ROUND");
    say(s, cast(string) buf[0..<n]);
  }
  return true;
}
// Defenders allowed in the round that a wave opens (wave 0 is the build before the first).
round_allowance :: (wave: int) -> int { return ROUND_BASE + hi_i(wave, 0) / ROUND_EVERY; }
round_left :: (s: [] Stair) -> int { return hi_i(round_allowance(s[0].wave) - s[0].placed_round, 0); }

step :: (s: [] Stair, dt: f32) {
  for i: 0..<FX { if s[0].fx[i].life > 0 { s[0].fx[i].t += dt; if s[0].fx[i].t >= s[0].fx[i].life { s[0].fx[i].life = 0; } } }
  s[0].hurt = hi(0, s[0].hurt - dt * 1.5);
  s[0].banner = hi(0, s[0].banner - dt);
  for i: 0..<DEFENDERS { if s[0].party[i].live { s[0].party[i].flash = hi(0, s[0].party[i].flash - dt * 4); } }
  if s[0].phase != FIGHT { return; }
  w := s[0].wave - 1;
  s[0].wave_t += dt;
  // spawns at the cellar door
  for g: 0..<GROUPS {
    kind := WAVE_KIND[w * GROUPS + g];
    if kind < 0 || s[0].spawned[g] >= WAVE_COUNT[w * GROUPS + g] { continue; }
    s[0].spawn_t[g] -= dt;
    if s[0].spawn_t[g] <= 0 {
      j := spawn(s, kind, 0);
      s[0].spawned[g] += 1;
      s[0].spawn_t[g] += WAVE_GAP[w * GROUPS + g];
    }
  }
  // the climb
  for i: 0..<BEASTS {
    if !s[0].beasts[i].live { continue; }
    s[0].beasts[i].d += LAYER_SPEED[s[0].beasts[i].kind] * dt;
    s[0].beasts[i].wob += dt * 3;
    s[0].beasts[i].age += dt;
    if s[0].beasts[i].d >= s[0].path_len {
      s[0].beasts[i].live = false;
      s[0].lives -= LAYER_LIVES[s[0].beasts[i].kind];
      s[0].leaked += 1;
      s[0].hurt = 1;
    }
  }
  if s[0].lives <= 0 {
    s[0].lives = 0; s[0].phase = LOST; s[0].selected = -1; s[0].card = -1;
    for i: 0..<BEASTS { s[0].beasts[i].live = false; }
    return;
  }
  // the party's turns, in the order they were placed
  for k: 0..<DEFENDERS {
    if !s[0].party[k].live { continue; }
    s[0].party[k].wait -= dt;
    if s[0].party[k].wait <= 0 {
      if take_turn(s, k) { s[0].party[k].wait += CLASS_TURN[s[0].party[k].cls]; } else { s[0].party[k].wait = 0; }
    }
  }
  if wave_groups_done(s) && live_beasts(s) == 0 {
    bonus := 30 + s[0].wave * 8;
    s[0].gold += bonus;
    if s[0].wave >= WAVES { s[0].phase = WON; s[0].selected = -1; s[0].card = -1; return; }
    s[0].phase = BUILD;
    buf: [48] u8;
    n := put(buf[..], 0, "WAVE "); n = put_int(buf[..], n, s[0].wave); n = put(buf[..], n, " HELD · +"); n = put_int(buf[..], n, bonus); n = put(buf[..], n, " GOLD");
    say(s, cast(string) buf[0..<n]);
  }
}

place :: (s: [] Stair, cell: int, cls: int) -> bool {
  if !free_cell(s, cell) || s[0].gold < CLASS_COST[cls] || s[0].phase == WON || s[0].phase == LOST || round_left(s) <= 0 { return false; }
  for i: 0..<DEFENDERS {
    if !s[0].party[i].live {
      d: Defender;
      d.live = true; d.cls = cls; d.cell = cell; d.slots = MM_SLOTS; d.level = 1;
      // initiative: a d20 sets where in the round its first turn falls
      d.wait = f32(srd_roll(s[0].dice[..], 20)) / 20 * CLASS_TURN[cls];
      d.roll = -1;
      s[0].party[i] = d;
      s[0].gold -= CLASS_COST[cls];
      s[0].placed += 1; s[0].placed_round += 1;
      lay_cells(s);
      track_tally(s[0].track[..], "place", CLASS_NAME[cls]);
      return true;
    }
  }
  return false;
}
// What a defender has cost, levels and all.
spent :: (s: [] Stair, k: int) -> int {
  d := s[0].party[k];
  n := CLASS_COST[d.cls];
  for lv: 1..<d.level { n += up_cost(d.cls, lv); }
  return n;
}
// A level up: it costs gold, not a place in the round; the new level's slots come at once.
upgrade :: (s: [] Stair, k: int) -> bool {
  if k < 0 || !s[0].party[k].live || s[0].phase == WON || s[0].phase == LOST { return false; }
  d := s[0].party[k];
  if d.level >= MAX_LEVEL || s[0].gold < up_cost(d.cls, d.level) { return false; }
  s[0].gold -= up_cost(d.cls, d.level);
  s[0].party[k].level += 1;
  lv := s[0].party[k].level;
  if lv == 2 { s[0].party[k].slots += 1; s[0].party[k].surge = true; }
  if lv == 3 { s[0].party[k].slots2 = SHATTER_SLOTS; }
  c := cell_xy(d.cell);
  add_fx(s, FX_LEVEL, c.x, c.y, 0, 0, 0.9, lv, CLASS_R[d.cls], CLASS_G[d.cls], CLASS_B[d.cls], false);
  track_tally(s[0].track[..], "upgrade", CLASS_NAME[d.cls]);
  return true;
}
sell :: (s: [] Stair, k: int) {
  if k < 0 || !s[0].party[k].live { return; }
  s[0].gold += spent(s, k) * 7 / 10;
  s[0].party[k].live = false;
  s[0].placed_round = hi_i(s[0].placed_round - 1, 0);   // a sold defender gives its place in the round back
  lay_cells(s);
}

// ---- layout

layout :: (s: [] Stair, w: f32, h: f32, k: f32) {
  s[0].portrait = h > w * 1.1;
  top := 52 * k;
  bottom := ifx s[0].portrait then 184 * k else 118 * k;
  s[0].scols = ifx s[0].portrait then ROWS else COLS;
  s[0].srows = ifx s[0].portrait then COLS else ROWS;
  aw := w - 24 * k; ah := h - top - bottom - 16 * k;
  // the map, the back wall above it and the rim round it
  rows := f32(s[0].srows) + f32(WALL_ROWS) + f32(RIM_TILES);
  t := lo(aw / (f32(s[0].scols) + 2 * f32(RIM_TILES)), ah / (rows * f32(SQUASH)));
  t = hi(t, 8);
  s[0].tile = t;
  s[0].ox = (w - t * f32(s[0].scols)) / 2;
  s[0].oy = top + 8 * k + (ah - t * f32(SQUASH) * rows) / 2 + f32(WALL_ROWS) * t * f32(SQUASH);
}
// Logical (column, row) tile units to the screen.
to_screen :: (s: [] Stair, x: f32, y: f32) -> P2 {
  sx := x; sy := y;
  if s[0].portrait { sx = y; sy = f32(COLS) - x; }
  return P2.{x = s[0].ox + sx * s[0].tile, y = s[0].oy + sy * s[0].tile * f32(SQUASH)};
}
cell_at :: (s: [] Stair, x: f32, y: f32) -> int {
  if s[0].tile <= 0 { return -1; }
  fx := (x - s[0].ox) / s[0].tile; fy := (y - s[0].oy) / (s[0].tile * f32(SQUASH));
  if fx < 0 || fy < 0 || fx >= f32(s[0].scols) || fy >= f32(s[0].srows) { return -1; }
  sc := cast(int) floor(fx); sr := cast(int) floor(fy);
  if s[0].portrait { return cell_of(COLS - 1 - sr, sc); }
  return cell_of(sc, sr);
}

set_button :: (s: [] Stair, b: int, r: Rect, on: bool) { s[0].boxes[b] = r; s[0].shown[b] = true; s[0].enabled[b] = on; }
buttons :: (s: [] Stair, w: f32, h: f32, k: f32) {
  for b: 0..<BUTTONS { s[0].shown[b] = false; }
  over := s[0].phase == WON || s[0].phase == LOST;
  set_button(s, B_GALAXY, Rect.{x0 = 10 * k, y0 = 10 * k, x1 = (ifx s[0].portrait then 78 * k else 96 * k), y1 = 42 * k}, true);
  if over {
    cx := w / 2; cy := h / 2;
    bw := lo(140 * k, w / 2 - 30 * k);
    set_button(s, B_AGAIN, Rect.{x0 = cx - bw - 10 * k, y0 = cy + 30 * k, x1 = cx - 10 * k, y1 = cy + 74 * k}, true);
    set_button(s, B_GALAXY, Rect.{x0 = cx + 10 * k, y0 = cy + 30 * k, x1 = cx + bw + 10 * k, y1 = cy + 74 * k}, true);
    return;
  }
  bh := 46 * k;
  if s[0].portrait {
    y1 := h - 14 * k; y0 := y1 - bh;
    set_button(s, B_START, Rect.{x0 = 14 * k, y0 = y0, x1 = w - 178 * k, y1 = y1}, s[0].phase == BUILD);
    set_button(s, B_PAUSE, Rect.{x0 = w - 168 * k, y0 = y0, x1 = w - 96 * k, y1 = y1}, true);
    set_button(s, B_FAST, Rect.{x0 = w - 86 * k, y0 = y0, x1 = w - 14 * k, y1 = y1}, true);
    ry1 := y0 - 12 * k; ry0 := ry1 - bh - 18 * k;
    if s[0].card < 0 {
      bw := (w - 28 * k - 16 * k) / 3;
      for c: 0..<CLASSES {
        x0 := 14 * k + f32(c) * (bw + 8 * k);
        set_button(s, B_FIGHTER + c, Rect.{x0 = x0, y0 = ry0, x1 = x0 + bw, y1 = ry1}, can_pick(s, c));
      }
    }
    if s[0].card >= 0 {
      if s[0].party[s[0].card].level < MAX_LEVEL { set_button(s, B_UPGRADE, Rect.{x0 = w - 134 * k, y0 = ry1 - 78 * k, x1 = w - 14 * k, y1 = ry1 - 44 * k}, can_upgrade(s)); }
      set_button(s, B_SELL, Rect.{x0 = w - 134 * k, y0 = ry1 - 34 * k, x1 = w - 14 * k, y1 = ry1}, true);
    }
    return;
  }
  y1 := h - 22 * k; y0 := y1 - bh - 8 * k;
  set_button(s, B_START, Rect.{x0 = w - 386 * k, y0 = y0, x1 = w - 196 * k, y1 = y1}, s[0].phase == BUILD);
  set_button(s, B_PAUSE, Rect.{x0 = w - 186 * k, y0 = y0, x1 = w - 110 * k, y1 = y1}, true);
  set_button(s, B_FAST, Rect.{x0 = w - 100 * k, y0 = y0, x1 = w - 24 * k, y1 = y1}, true);
  if s[0].card < 0 {
    bw := 170 * k;
    for c: 0..<CLASSES {
      x0 := 24 * k + f32(c) * (bw + 10 * k);
      set_button(s, B_FIGHTER + c, Rect.{x0 = x0, y0 = y0, x1 = x0 + bw, y1 = y1}, can_pick(s, c));
    }
  }
  if s[0].card >= 0 {
    set_button(s, B_SELL, Rect.{x0 = w - 500 * k, y0 = y0, x1 = w - 396 * k, y1 = y1}, true);
    if s[0].party[s[0].card].level < MAX_LEVEL { set_button(s, B_UPGRADE, Rect.{x0 = w - 700 * k, y0 = y0, x1 = w - 510 * k, y1 = y1}, can_upgrade(s)); }
  }
}
can_upgrade :: (s: [] Stair) -> bool {
  k := s[0].card;
  if k < 0 || !s[0].party[k].live || s[0].party[k].level >= MAX_LEVEL { return false; }
  return s[0].gold >= up_cost(s[0].party[k].cls, s[0].party[k].level);
}
can_pick :: (s: [] Stair, c: int) -> bool { return s[0].gold >= CLASS_COST[c] && round_left(s) > 0; }
button_at :: (s: [] Stair, x: f32, y: f32) -> int {
  for b: 0..<BUTTONS { if s[0].shown[b] && in_rect(s[0].boxes[b], x, y) { return b; } }
  return -1;
}

press :: (s: [] Stair, b: int) {
  if !s[0].enabled[b] { return; }
  if b == B_START { if start_wave(s) { s[0].selected = -1; s[0].card = -1; } return; }
  if b == B_FAST { s[0].speed = ifx s[0].speed >= 3 then 1 else s[0].speed + 1; return; }
  if b == B_PAUSE { s[0].paused = !s[0].paused; return; }
  if b == B_GALAXY { leave_to(s, "/verse/galaxy"); return; }
  if b == B_AGAIN { stair_reset(s); s[0].tracked_wave = 0; return; }
  if b == B_SELL { sell(s, s[0].card); s[0].card = -1; s[0].selected = -1; return; }
  if b == B_UPGRADE { ok := upgrade(s, s[0].card); return; }
  if b >= B_FIGHTER && b <= B_CLERIC { pick(s, b - B_FIGHTER); return; }
}
leave_to :: (s: [] Stair, url: string) {
  if s[0].action != 0 { return; }
  s[0].out_n = put(s[0].outbox[..], 0, url);
  s[0].action = ACT_NAVIGATE;
}

tap_cell :: (s: [] Stair, cell: int) {
  if s[0].phase == WON || s[0].phase == LOST { return; }
  d := defender_at(s, cell);
  if d >= 0 { s[0].card = ifx s[0].card == d then -1 else d; s[0].selected = -1; return; }
  s[0].card = -1;
  if !free_cell(s, cell) { s[0].selected = -1; return; }
  if s[0].pick < 0 { s[0].selected = -1; say(s, "PICK A DEFENDER FIRST"); return; }
  // On a phone the first tap shows the defender's reach on that tile; the second places it.
  if s[0].touch && s[0].selected != cell { s[0].selected = cell; return; }
  drop(s, cell);
}
// Arm a class for placing (again to put it down).
pick :: (s: [] Stair, c: int) {
  if s[0].pick == c { s[0].pick = -1; s[0].selected = -1; return; }
  if round_left(s) <= 0 { say(s, "NO MORE DEFENDERS THIS ROUND"); return; }
  if s[0].gold < CLASS_COST[c] { say(s, "NOT ENOUGH GOLD"); return; }
  s[0].pick = c; s[0].card = -1;
}
drop :: (s: [] Stair, cell: int) {
  c := s[0].pick;
  if c < 0 { return; }
  if round_left(s) <= 0 { say(s, "NO MORE DEFENDERS THIS ROUND"); s[0].pick = -1; s[0].selected = -1; return; }
  if s[0].gold < CLASS_COST[c] { say(s, "NOT ENOUGH GOLD"); s[0].pick = -1; s[0].selected = -1; return; }
  if place(s, cell, c) {
    s[0].selected = -1;
    if !can_pick(s, c) { s[0].pick = -1; }
  }
}
// The tile whose reach shows: the one tapped on a phone, the one under the mouse otherwise.
aim_cell :: (s: [] Stair) -> int {
  if s[0].pick < 0 { return -1; }
  c := ifx s[0].touch then s[0].selected else s[0].hover;
  return ifx free_cell(s, c) then c else -1;
}

// ---- in from the host

stair_pointer :: (s: [] Stair, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  stair_start(s);
  if kind != 0 { s[0].touch = true; }
  b := button_at(s, x, y);
  cell := cell_at(s, x, y);
  if kind == 0 && phase != 3 { s[0].hover_b = b; s[0].hover = cell; } else { s[0].hover_b = -1; s[0].hover = -1; }
  if phase == 0 {
    track_pointer(s[0].track[..], x, y, phase, kind, "");
    if b >= 0 { s[0].press = b; s[0].press_id = id; return true; }
    s[0].down_on = true; s[0].down_t = s[0].clock; s[0].down_x = x; s[0].down_y = y; s[0].down_cell = cell; s[0].long_done = false;
    s[0].press_id = id;
    return cell >= 0;
  }
  if phase == 1 {
    if s[0].down_on {
      dx := x - s[0].down_x; dy := y - s[0].down_y;
      if dx * dx + dy * dy > 144 * s[0].dpr * s[0].dpr { s[0].down_on = false; }
    }
    return s[0].press >= 0 || s[0].down_on;
  }
  if phase == 2 || phase == 3 {
    if s[0].press >= 0 {
      if phase == 2 && b == s[0].press { press(s, b); }
      s[0].press = -1;
      return true;
    }
    if s[0].down_on {
      s[0].down_on = false;
      if phase == 2 && !s[0].long_done && cell == s[0].down_cell {
        if cell >= 0 { tap_cell(s, cell); return true; }
        s[0].selected = -1; s[0].card = -1; s[0].pick = -1;
      }
      return cell >= 0;
    }
  }
  return false;
}
// A finger held still on a defender shows its card (the long-press).
long_press :: (s: [] Stair) {
  if !s[0].down_on || s[0].long_done || s[0].clock - s[0].down_t < LONG_PRESS { return; }
  d := defender_at(s, s[0].down_cell);
  if d < 0 { return; }
  s[0].long_done = true; s[0].card = d; s[0].selected = -1;
}

stair_key :: (s: [] Stair, key: int, mods: int) -> bool #export_c {
  stair_start(s);
  track_key(s[0].track[..], key, false);
  if key == KEY_ESCAPE { s[0].selected = -1; s[0].card = -1; s[0].pick = -1; return true; }
  if key == 'p' || key == 'P' { press(s, B_PAUSE); return true; }
  if key == KEY_ENTER || key == ' ' {
    if s[0].phase == WON || s[0].phase == LOST { stair_reset(s); return true; }
    ok := start_wave(s); if ok { s[0].selected = -1; s[0].card = -1; }
    return true;
  }
  if key >= '1' && key <= '3' { pick(s, key - '1'); return true; }
  if key == 'f' || key == 'F' { press(s, B_FAST); return true; }
  if (key == 'u' || key == 'U') && s[0].card >= 0 { ok := upgrade(s, s[0].card); return true; }
  return false;
}
stair_key_up :: (s: [] Stair, key: int, mods: int) -> bool #export_c { track_key_up(s[0].track[..], key); return false; }
stair_blur :: (s: [] Stair) #export_c { s[0].down_on = false; s[0].press = -1; track_blur(s[0].track[..]); }
stair_cursor :: (s: [] Stair) -> int #export_c {
  if s[0].hover_b >= 0 { return 1; }
  if s[0].hover >= 0 && (free_cell(s, s[0].hover) || defender_at(s, s[0].hover) >= 0) { return 1; }
  return 0;
}

stair_message :: (s: [] Stair, kind: int, t: string) #export_c {
  stair_start(s);
  if kind == HOST_PAGE {
    s[0].facts = true;
    url := fact_of(t, "url");
    sp := query_number(url, "speed");
    if sp >= 1 && sp <= 8 { s[0].speed = cast(int) sp; }
    g := query_number(url, "gold");
    if g >= 0 && g <= 99999 { s[0].gold = cast(int) g; }
    wv := query_number(url, "wave");
    if wv >= 1 && wv <= WAVES { s[0].wave = cast(int) wv - 1; }
    if fact_of(t, "coarse") == "1" { s[0].touch = true; }
    if query_is(url, "stage", "highlight") { stage_highlight(s); }
  }
  ok := track_message(s[0].track[..], kind, t);
  if kind == HOST_PAGE { track_world(s[0].track[..], "hold-the-stair"); }
}
// ?KEY=VALUE in a page's URL, exactly.
query_is :: (url: string, key: string, value: string) -> bool {
  at := 0;
  while at + key.count + 1 + value.count <= url.count {
    before := ifx at == 0 then cast(u8) 63 else url[at - 1];
    if (before == 63 || before == 38) && url[at..<at + key.count] == key && url[at + key.count] == 61 {
      i := at + key.count + 1;
      after := i + value.count;
      return url[i..<after] == value && (after == url.count || url[after] == 38 || url[after] == 35);
    }
    at += 1;
  }
  return false;
}
// A staged moment for clips (?stage=highlight, docs/verse/clips.md): the last wave against
// a full party at level 3, the stair crowded and every class firing.
// The free tile beside the stair nearest a point part of the way up it.
spot_near :: (s: [] Stair, along: f32) -> int {
  best := -1; bd := 1000.0f32;
  m := path_at(s[0].path_len * along);
  for cell: 0..<CELLS {
    if !free_cell(s, cell) || !beside_path(s, cell) { continue; }
    c := cell_xy(cell);
    dd := (c.x - m.x) * (c.x - m.x) + (c.y - m.y) * (c.y - m.y);
    if dd < bd { bd = dd; best = cell; }
  }
  return best;
}
stage_highlight :: (s: [] Stair) {
  stair_reset(s);
  s[0].gold = 99999; s[0].wave = WAVES - 1;
  for i: 0..<20 {
    s[0].placed_round = 0;
    spot := spot_near(s, 0.08 + 0.8 * f32(i) / 19);   // spread up the whole climb
    if spot < 0 || !place(s, spot, AI_CLASSES[i % 6]) { break; }
  }
  for k: 0..<DEFENDERS { while s[0].party[k].live && upgrade(s, k) {} }
  for i: 0..<FX { s[0].fx[i].life = 0; }
  s[0].gold = 1260; s[0].placed_round = 0;
  ok := start_wave(s);
  s[0].toast_t = 0;
}
stair_golden :: (s: [] Stair, on: bool) #export_c { s[0].golden = on; }
stair_action :: (s: [] Stair) -> int #export_c { a := s[0].action; s[0].action = 0; return a; }
stair_action_done :: (s: [] Stair) #export_c { s[0].out_n = 0; }

coaxial_stair_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_stair_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_stair_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

// ---- drawing

plate :: (s: [] Stair, u: [] f32, r: Rect, alpha: f32, style: f32) { plate_icon(s, u, r, alpha, style, -1); }
// A panel; icon: a class whose portrait stair.wgsl paints at its left (-1 none).
plate_icon :: (s: [] Stair, u: [] f32, r: Rect, alpha: f32, style: f32, icon: int) {
  if s[0].plate_n >= PLATES { return; }
  o := U_PLATE + s[0].plate_n * 8;
  u[o] = r.x0; u[o + 1] = r.y0; u[o + 2] = r.x1; u[o + 3] = r.y1;
  u[o + 4] = alpha; u[o + 5] = style; u[o + 6] = hi(s[0].dpr, 0.5); u[o + 7] = f32(icon + 1);
  s[0].plate_n += 1;
}

// The bubble-beasts: glossy see-through bubbles with the layer inside showing, glowing eyes and a
// grin, looking the way they climb; embers burn at the crown, glimmers throw sparkles, wisps trail.
draw_beasts :: (s: [] Stair, out: [] f32, at: int) -> int {
  n := at;
  t := s[0].tile;
  for i: 0..<BEASTS {
    b := s[0].beasts[i];
    if !b.live { continue; }
    p := path_at(b.d);
    q := to_screen(s, p.x, p.y);
    ahead := to_screen(s, path_at(b.d + 0.2).x, path_at(b.d + 0.2).y);
    lx := ahead.x - q.x; ly := ahead.y - q.y;
    ll := hi(sqrt(lx * lx + ly * ly), 0.001); lx /= ll; ly /= ll;
    bob := sin(b.wob) * t * 0.04;
    // out of its outer skin (or the cellar door) with a bounce
    grow := clamp01(b.age / 0.28);
    pop := 1 - (1 - grow) * (1 - grow) * (1 - grow) + 0.22 * sin(grow * 3.14159);
    rad := LAYER_SIZE[b.kind] * t * (0.35 + 0.65 * pop);
    y := q.y - t * 0.24 + bob;
    r := LAYER_R[b.kind]; g := LAYER_G[b.kind]; bl := LAYER_B[b.kind];
    // a bubble a little squashed and stretched as it bobs
    inner := INNER_A[b.kind];
    share := ifx inner >= 0 then 0.5f32 else 0.0f32;
    ir := 0.0f32; ig := 0.0f32; ib := 0.0f32;
    if inner >= 0 { ir = LAYER_R[inner]; ig = LAYER_G[inner]; ib = LAYER_B[inner]; }
    n = bubble(out, n, q.x, y, rad, 1.0, r, g, bl, share, ir, ig, ib);
    // the face: two glowing eyes (one on a mote), a grin; a blink now and then
    ex := q.x + lx * rad * 0.2; ey := y - rad * 0.05 + ly * rad * 0.12;
    bw := b.wob * 0.11 + f32(i) * 0.37;
    blink := bw - floor(bw) > 0.94;
    hh := ifx blink then rad * 0.01 else rad * 0.07;
    ew := hi(0.9, rad * 0.12);
    if b.kind == MOTE {
      n = seg(out, n, ex, ey - hh, ex, ey + hh, ew * 1.2, 1.0, ew * 2, 1, 1, 1);
    } else {
      sp := rad * 0.27;
      n = seg(out, n, ex - sp, ey - hh, ex - sp, ey + hh, ew, 1.0, ew * 2, 1, 1, 1);
      n = seg(out, n, ex + sp, ey - hh, ex + sp, ey + hh, ew, 1.0, ew * 2, 1, 1, 1);
      mw := hi(0.6, rad * 0.045);
      my := ey + rad * 0.3;
      n = seg(out, n, ex - rad * 0.16, my - rad * 0.05, ex, my + rad * 0.03, mw, 0.85, mw * 2, 1, 1, 1);
      n = seg(out, n, ex, my + rad * 0.03, ex + rad * 0.16, my - rad * 0.05, mw, 0.85, mw * 2, 1, 1, 1);
    }
    if b.kind == EMBER {
      for j: 0..<3 {
        fx := q.x + f32(j - 1) * rad * 0.38;
        fy := y - rad * (0.82 - 0.12 * abs(f32(j - 1)));
        lick := rad * (0.32 + 0.14 * sin(s[0].clock * 13 + f32(j) * 2.1 + b.wob));
        sway := rad * 0.12 * sin(s[0].clock * 9 + f32(j) * 1.7);
        n = seg(out, n, fx, fy, fx + sway, fy - lick, rad * 0.11, 0.9, rad * 0.2, 1.0, 0.18, 0.12);
        n = seg(out, n, fx, fy, fx + sway * 0.7, fy - lick * 0.6, rad * 0.05, 1.0, rad * 0.08, 1.0, 0.9, 0.45);
      }
    }
    if b.kind == GLIMMER {
      for j: 0..<2 {
        a := s[0].clock * 2.4 + f32(j) * 3.14159 + b.wob;
        sx := q.x + cos(a) * rad * 1.3; sy := y + sin(a) * rad * 1.1;
        tw := rad * (0.12 + 0.06 * sin(s[0].clock * 10 + f32(j) * 2));
        n = seg(out, n, sx - tw, sy, sx + tw, sy, hi(0.6, rad * 0.035), 1.0, rad * 0.08, 1.0, 0.95, 0.6);
        n = seg(out, n, sx, sy - tw, sx, sy + tw, hi(0.6, rad * 0.035), 1.0, rad * 0.08, 1.0, 0.95, 0.6);
      }
    }
    if b.kind == WISP {
      tx := q.x - lx * rad * 1.0; ty := y - ly * rad * 1.0 + rad * 0.3;
      curl := sin(b.wob * 1.5) * rad * 0.4;
      n = seg(out, n, q.x - lx * rad * 0.8, y + rad * 0.25, tx, ty + curl, rad * 0.1, 0.3, rad * 0.3, r, g, bl);
    }
  }
  return n;
}
// The party itself is painted by stair.wgsl (a figure per tile); here: reach rings, and the armed
// defender's reach where it would go, with the beasts it would reach ringed.
draw_party :: (s: [] Stair, out: [] f32, at: int) -> int {
  n := at;
  t := s[0].tile;
  k := hi(s[0].dpr, 0.5);
  for i: 0..<DEFENDERS {
    d := s[0].party[i];
    if !d.live { continue; }
    if d.level >= 2 {
      // a gold pip a level, at its feet
      c := cell_xy(d.cell);
      q := to_screen(s, c.x, c.y);
      for j: 0..<d.level - 1 {
        px := q.x + t * 0.28 + f32(j) * t * 0.11; py := q.y + t * 0.18;
        pr := hi(1, t * 0.035);
        n = seg(out, n, px - pr, py, px, py - pr * 1.4, pr * 0.45, 1, pr, GOLD_R, GOLD_G, GOLD_B);
        n = seg(out, n, px, py - pr * 1.4, px + pr, py, pr * 0.45, 1, pr, GOLD_R, GOLD_G, GOLD_B);
      }
    }
    if i == s[0].card || d.cell == s[0].hover {
      c := cell_xy(d.cell);
      q := to_screen(s, c.x, c.y);
      n = ring(out, n, q.x, q.y, CLASS_RANGE[d.cls] * t, hi(1, 1.2 * k), 0.5, CLASS_R[d.cls], CLASS_G[d.cls], CLASS_B[d.cls], 0);
    }
  }
  a := aim_cell(s);
  if a >= 0 {
    c := s[0].pick;
    q := to_screen(s, cell_xy(a).x, cell_xy(a).y);
    r := CLASS_R[c]; g := CLASS_G[c]; b := CLASS_B[c];
    pulse := 0.75 + 0.25 * sin(s[0].clock * 5);
    rr := CLASS_RANGE[c] * t;
    n = ring(out, n, q.x, q.y, rr * 0.5, rr, 0.06, r, g, b, 0);
    n = ring(out, n, q.x, q.y, rr, hi(1, 1.6 * k), 0.7 * pulse, r, g, b, 0);
    for i: 0..<BEASTS {
      if !s[0].beasts[i].live { continue; }
      p := path_at(s[0].beasts[i].d); cc := cell_xy(a);
      if (p.x - cc.x) * (p.x - cc.x) + (p.y - cc.y) * (p.y - cc.y) <= CLASS_RANGE[c] * CLASS_RANGE[c] {
        bq := to_screen(s, p.x, p.y);
        n = ring_sq(out, n, bq.x, bq.y - t * 0.24, LAYER_SIZE[s[0].beasts[i].kind] * t * 1.45, hi(1, t * 0.02), 0.8, r, g, b, 1);
      }
    }
  }
  return n;
}
// A point on a curve from a to b bowed sideways by bow (a share of its length).
Curve :: struct { x: f32; y: f32; }
bow_at :: (ax: f32, ay: f32, bx: f32, by: f32, bow: f32, h: f32) -> Curve {
  mx := (ax + bx) / 2 - (by - ay) * bow; my := (ay + by) / 2 + (bx - ax) * bow;
  u1 := 1 - h;
  return Curve.{x = u1 * u1 * ax + 2 * u1 * h * mx + h * h * bx, y = u1 * u1 * ay + 2 * u1 * h * my + h * h * by};
}
draw_fx :: (s: [] Stair, out: [] f32, at: int) -> int {
  n := at;
  t := s[0].tile;
  k := hi(s[0].dpr, 0.5);
  buf: [16] u8;
  for i: 0..<FX {
    f := s[0].fx[i];
    if f.life <= 0 { continue; }
    a := clamp01(f.t / f.life);
    fade := clamp01((f.life - f.t) / (f.life * 0.5));
    p := to_screen(s, f.x, f.y);
    if f.kind == FX_SLASH {
      // a swept arc across the target, white-steel (gold on a crit)
      q := to_screen(s, f.x2, f.y2);
      cx := q.x; cy := q.y - t * 0.24;
      rad := t * (ifx f.big then 0.42f32 else 0.3f32);
      w := hi(1, t * 0.035) * (ifx f.big then 1.6f32 else 1.0f32);
      sweep := clamp01(a * 3);
      cr: f32 = 0.9; cg: f32 = 0.95; cb: f32 = 1.0;
      if f.big { cr = 1.0; cg = 0.88; cb = 0.45; }
      for j: 0..<6 {
        a0 := -2.6 + f32(j) / 6 * 2.4 * sweep; a1 := -2.6 + f32(j + 1) / 6 * 2.4 * sweep;
        taper := 0.4 + 0.6 * f32(j) / 5;
        n = seg(out, n, cx + cos(a0) * rad, cy + sin(a0) * rad, cx + cos(a1) * rad, cy + sin(a1) * rad, w * taper, fade, t * 0.08, cr, cg, cb);
      }
      continue;
    }
    if f.kind == FX_BOLT {
      // Fire Bolt: a white-hot head, a red trail throwing sparks, a burst where it lands
      q := to_screen(s, f.x2, f.y2);
      ay := p.y - t * 0.45; by := q.y - t * 0.24;
      h := clamp01(a * 2.2);
      hx := p.x + (q.x - p.x) * h; hy := ay + (by - ay) * h;
      lx := p.x + (q.x - p.x) * hi(0, h - 0.3); ly := ay + (by - ay) * hi(0, h - 0.3);
      w := hi(1, t * 0.05) * (ifx f.big then 1.5f32 else 1.0f32);
      if h < 1 {
        n = seg(out, n, lx, ly, hx, hy, w * 1.6, 0.8, t * 0.12, 1.0, 0.16, 0.08);
        n = seg(out, n, (lx + hx) / 2, (ly + hy) / 2, hx, hy, w * 0.7, 1.0, t * 0.06, 1.0, 0.85, 0.35);
        n = disc(out, n, hx, hy, w * 1.4, 1.0, t * 0.12, 1.0, 0.95, 0.7);
        for j: 0..<3 {
          sh := hi(0, h - 0.1 - f32(j) * 0.07);
          sx := p.x + (q.x - p.x) * sh + sin(f.dx * 9 + f32(j) * 2.3 + a * 20) * t * 0.06;
          sy := ay + (by - ay) * sh + cos(f.dx * 7 + f32(j) * 1.9 + a * 17) * t * 0.06;
          n = disc(out, n, sx, sy, hi(0.7, t * 0.012), 0.9, t * 0.03, 1.0, 0.75, 0.3);
        }
      } else {
        burst := clamp01((a - 0.45) / 0.55);
        n = glow_disc(out, n, q.x, by, t * (0.2 + 0.35 * burst), (1 - burst) * 0.9, 1.0, 0.3, 0.15);
        n = ring_sq(out, n, q.x, by, t * (0.1 + 0.4 * burst), hi(1, t * 0.03) * (1 - burst), 1 - burst, 1.0, 0.8, 0.35, 1);
      }
      continue;
    }
    if f.kind == FX_DART {
      // Magic Missile: a violet dart on a bowed path, its trail behind it
      q := to_screen(s, f.x2, f.y2);
      ay := p.y - t * 0.45; by := q.y - t * 0.24;
      h := clamp01(a * 1.8);
      bow := f.dx * 0.45;
      w := hi(0.8, t * 0.028);
      prev := bow_at(p.x, ay, q.x, by, bow, hi(0, h - 0.3));
      for j: 1..<5 {
        c := bow_at(p.x, ay, q.x, by, bow, hi(0, h - 0.3 + 0.3 * f32(j) / 4));
        n = seg(out, n, prev.x, prev.y, c.x, c.y, w * (0.4 + 0.6 * f32(j) / 4), fade * (0.4 + 0.6 * f32(j) / 4), t * 0.07, 0.7, 0.55, 1.0);
        prev = c;
      }
      if h < 1 { n = disc(out, n, prev.x, prev.y, w * 1.5, 1.0, t * 0.1, 0.9, 0.85, 1.0); }
      else { n = glow_disc(out, n, q.x, by, t * 0.3, fade * 0.8, 0.65, 0.5, 1.0); }
      continue;
    }
    if f.kind == FX_POP {
      // the skin bursts: a flash, a ring, droplets flung out and falling
      cy := p.y - t * 0.24;
      rad := t * (0.15 + a * 0.5);
      n = glow_disc(out, n, p.x, cy, t * 0.35 * (1 - a), (1 - a) * (1 - a) * 1.2, 1, 1, 1);
      n = ring_sq(out, n, p.x, cy, rad, hi(1, t * 0.035 * (1 - a)), fade, f.r, f.g, f.b, 1);
      drops := ifx f.big then 10 else 7;
      for j: 0..<drops {
        ang := f32(j) / f32(drops) * 6.2831853 + f.dx;
        sp := t * (0.55 + 0.25 * sin(f32(j) * 2.7 + f.dx * 5));
        dx := cos(ang) * sp * a; dy := sin(ang) * sp * a * 0.8 + t * 1.1 * a * a;
        sz := hi(0.8, t * 0.03 * (1 - a * 0.6));
        n = seg(out, n, p.x + dx * 0.8, cy + dy * 0.8 - t * 0.02, p.x + dx, cy + dy, sz, fade, t * 0.05, f.r, f.g, f.b);
      }
      continue;
    }
    if f.kind == FX_FLAME {
      // Sacred Flame: a pillar of light comes down on the target, a ring where it strikes
      cy := p.y - t * 0.2;
      fall := clamp01(a * 4);
      top := cy - t * 1.5;
      bot := top + (cy - top) * fall;
      w := t * 0.07 * (1 - a * 0.5);
      n = seg(out, n, p.x, top, p.x, bot, w * 1.8, fade * 0.7, t * 0.2, 1.0, 0.9, 0.55);
      n = seg(out, n, p.x, top, p.x, bot, w * 0.6, fade, t * 0.06, 1.0, 1.0, 0.9);
      if fall >= 1 {
        n = ring_sq(out, n, p.x, p.y, t * (0.15 + 0.35 * a), hi(1, t * 0.03), fade, 1.0, 0.9, 0.5, f32(SQUASH) * 0.6);
        for j: 0..<4 {
          rx := p.x + f32(j - 2) * t * 0.1 + t * 0.05; ry := cy - t * 0.6 * a - f32(j % 2) * t * 0.15;
          n = disc(out, n, rx, ry, hi(0.7, t * 0.015), fade, t * 0.04, 1.0, 0.95, 0.7);
        }
      }
      continue;
    }
    if f.kind == FX_CRIT {
      // a natural 20: the die itself rises over the target, gold
      rise := t * 0.6 * (1 - (1 - a) * (1 - a));
      cx := p.x; cy := p.y - t * 1.0 - rise;
      rad := t * 0.32 * (1 + 0.3 * clamp01(1 - f.t / 0.15));
      w := hi(1, t * 0.03);
      for j: 0..<6 {
        a0 := f32(j) / 6 * 6.2831853 - 1.5708; a1 := f32(j + 1) / 6 * 6.2831853 - 1.5708;
        n = seg(out, n, cx + cos(a0) * rad, cy + sin(a0) * rad, cx + cos(a1) * rad, cy + sin(a1) * rad, w, fade, t * 0.1, 1.0, 0.86, 0.4);
      }
      // the face's triangle
      for j: 0..<3 {
        a0 := f32(j) / 3 * 6.2831853 - 1.5708; a1 := f32(j + 1) / 3 * 6.2831853 - 1.5708;
        n = seg(out, n, cx + cos(a0) * rad * 0.62, cy + sin(a0) * rad * 0.62, cx + cos(a1) * rad * 0.62, cy + sin(a1) * rad * 0.62, w * 0.6, fade * 0.6, t * 0.04, 1.0, 0.86, 0.4);
      }
      cap := rad * 0.62;
      m := put_int(buf[..], 0, f.amount);
      n = say_mid(out, n, cast(string) buf[0..<m], cx, cy + cap * 0.5, cap, ink(k, fade, 1.0, 0.95, 0.75));
      n = say_mid(out, n, "CRIT", cx, cy + rad + t * 0.22, t * 0.17, ink(k, fade, 1.0, 0.86, 0.4));
      continue;
    }
    if f.kind == FX_SHATTER {
      // Shatter: a ringing boom, rings out across the crowd, cracks of light
      cy := p.y - t * 0.24;
      for j: 0..<3 {
        ra := clamp01(a * 1.6 - f32(j) * 0.18);
        if ra <= 0 || ra >= 1 { continue; }
        n = ring_sq(out, n, p.x, cy, t * f32(SHATTER_RADIUS) * ra, hi(1, t * 0.05 * (1 - ra)), (1 - ra), 0.75, 0.82, 1.0, 0.9);
      }
      n = glow_disc(out, n, p.x, cy, t * 0.6 * (1 - a * 0.5), (1 - a) * 0.8, 0.6, 0.7, 1.0);
      for j: 0..<7 {
        ang := f32(j) * 0.8976 + f.dx;
        l0 := t * 0.15; l1 := t * (0.3 + 0.5 * clamp01(a * 3));
        kink := t * 0.08 * sin(f32(j) * 3.1);
        mx := p.x + cos(ang) * (l0 + l1) * 0.5 - sin(ang) * kink; my := cy + sin(ang) * (l0 + l1) * 0.5 + cos(ang) * kink;
        n = seg(out, n, p.x + cos(ang) * l0, cy + sin(ang) * l0, mx, my, hi(0.7, t * 0.015), fade, t * 0.05, 0.85, 0.9, 1.0);
        n = seg(out, n, mx, my, p.x + cos(ang) * l1, cy + sin(ang) * l1, hi(0.7, t * 0.012), fade, t * 0.05, 0.85, 0.9, 1.0);
      }
      continue;
    }
    if f.kind == FX_SPIRIT {
      // Spiritual Weapon: a spectral mace swings down onto the target
      cx := p.x; cy := p.y - t * 0.24;
      sw := 1.9 - 1.7 * clamp01(a * 2.5);
      hx := cx + cos(sw) * t * 0.45 - t * 0.2; hy := cy - sin(sw) * t * 0.45;
      n = seg(out, n, cx - t * 0.2, cy + t * 0.05, hx, hy, hi(1, t * 0.03), fade * 0.85, t * 0.08, 1.0, 0.9, 0.55);
      n = disc(out, n, hx, hy, t * 0.07, fade, t * 0.12, 1.0, 0.95, 0.7);
      if a > 0.4 { n = glow_disc(out, n, cx, cy, t * 0.3, fade * 0.7, 1.0, 0.9, 0.5); }
      continue;
    }
    if f.kind == FX_LEVEL {
      // a level up: a column of the class's light and LEVEL N rising
      cy := p.y - t * 0.3;
      n = seg(out, n, p.x, cy + t * 0.3, p.x, cy - t * (0.4 + 0.8 * a), t * 0.12 * (1 - a), fade * 0.6, t * 0.3, f.r, f.g, f.b);
      n = ring_sq(out, n, p.x, p.y, t * (0.2 + 0.4 * a), hi(1, t * 0.03), fade, f.r, f.g, f.b, f32(SQUASH) * 0.6);
      m := put(buf[..], 0, "LEVEL "); m = put_int(buf[..], m, f.amount);
      n = say_mid(out, n, cast(string) buf[0..<m], p.x, cy - t * (0.7 + 0.4 * a), t * 0.2, ink(k, fade, 1.0, 0.92, 0.6));
      continue;
    }
    // words and numbers rise and fade (Everglade's red damage numbers)
    rise := t * 0.7 * (1 - (1 - a) * (1 - a));
    x := p.x + f.dx * t * 0.15; y := p.y - t * 0.45 - rise;
    if f.kind == FX_NUM {
      grow := 1 + 0.4 * clamp01(1 - f.t / 0.12);
      cap := (ifx f.big then 0.42f32 else 0.3f32) * t * grow;
      m := put_int(buf[..], 0, f.amount);
      line := cast(string) buf[0..<m];
      body := Ink.{core = (ifx f.big then 1.5f32 else 1.05f32) * k, light = fade, glow = 0.9 * k, red = 1.0, green = 0.16, blue = 0.1, mode = 0, scale = k};
      n = draw_text(out, n, line, x - text_width(line, cap) / 2, y, cap, GAP, SPACE, body, false, false);
      continue;
    }
    word := ifx f.kind == FX_MISS then "MISS" else ifx f.kind == FX_SAVED then "SAVED" else "IMMUNE";
    cap := 0.2 * t;
    n = say_mid(out, n, word, x, y, cap, ink(k, fade * 0.8, f.r, f.g, f.b));
  }
  return n;
}

button_label :: (s: [] Stair, b: int, buf: [] u8) -> int {
  if b == B_START {
    if s[0].phase == BUILD { n := put(buf, 0, "START WAVE "); return put_int(buf, n, s[0].wave + 1); }
    n := put(buf, 0, "WAVE "); n = put_int(buf, n, s[0].wave); return put(buf, n, " CLIMBING");
  }
  if b == B_FAST { n := put(buf, 0, "SPEED "); return put_int(buf, n, s[0].speed); }
  if b == B_GALAXY { return put(buf, 0, "GALAXY"); }
  if b == B_PAUSE { return put(buf, 0, ifx s[0].paused then "RESUME" else "PAUSE"); }
  if b == B_AGAIN { return put(buf, 0, "AGAIN"); }
  if b == B_SELL { n := put(buf, 0, "SELL +"); return put_int(buf, n, spent(s, s[0].card) * 7 / 10); }
  if b == B_UPGRADE {
    d := s[0].party[s[0].card];
    if d.level >= MAX_LEVEL { return put(buf, 0, "LEVEL 3"); }
    n := put(buf, 0, "LEVEL "); n = put_int(buf, n, d.level + 1); n = put(buf, n, " · "); n = put_int(buf, n, up_cost(d.cls, d.level));
    return ifx s[0].portrait then n else put(buf, n, " GOLD");
  }
  c := b - B_FIGHTER;
  n := put(buf, 0, CLASS_NAME[c]); n = put(buf, n, " "); return put_int(buf, n, CLASS_COST[c]);
}

draw_hud :: (s: [] Stair, out: [] f32, u: [] f32, at: int, w: f32, h: f32) -> int {
  n := at;
  k := hi(s[0].dpr, 0.5);
  buf: [96] u8;
  // the top bar
  plate(s, u, Rect.{x0 = 0, y0 = 0, x1 = w, y1 = 52 * k}, 0.85, 0);
  cap := ifx s[0].portrait then 10.5 * k else 13 * k;
  sp := ifx s[0].portrait then 12 * k else 24 * k;
  // a heart for the tower's lives, a coin for the gold
  m := put_int(buf[..], 0, s[0].lives);
  lx := ifx s[0].portrait then 88 * k else 112 * k;
  hy := 32 * k - cap * 0.5; hr := cap * 0.36;
  n = disc(out, n, lx + hr * 0.75, hy - hr * 0.35, hr, 1, hr * 0.6, 1.0, 0.3, 0.32);
  n = disc(out, n, lx + hr * 2.25, hy - hr * 0.35, hr, 1, hr * 0.6, 1.0, 0.3, 0.32);
  n = seg(out, n, lx + hr * 0.3, hy, lx + hr * 1.5, hy + hr * 1.35, hr * 0.62, 1, hr * 0.4, 1.0, 0.3, 0.32);
  n = seg(out, n, lx + hr * 2.7, hy, lx + hr * 1.5, hy + hr * 1.35, hr * 0.62, 1, hr * 0.4, 1.0, 0.3, 0.32);
  lx += hr * 3 + 6 * k;
  n = say_at(out, n, cast(string) buf[0..<m], lx, 32 * k, cap, ink(k, 1, 1.0, 0.42, 0.4));
  lx += text_width(cast(string) buf[0..<m], cap) + sp;
  m = put_int(buf[..], 0, s[0].gold);
  coin := cap * 0.55;
  n = bubble(out, n, lx + coin, hy, coin, 1, GOLD_R, GOLD_G, GOLD_B, 0, 0, 0, 0);
  n = ring_sq(out, n, lx + coin, hy, coin * 0.6, hi(0.8, coin * 0.12), 0.8, GOLD_R, GOLD_G, GOLD_B, 1);
  lx += coin * 2 + 6 * k;
  n = say_at(out, n, cast(string) buf[0..<m], lx, 32 * k, cap, ink(k, 1, GOLD_R, GOLD_G, GOLD_B));
  lx += text_width(cast(string) buf[0..<m], cap) + sp;
  m = put(buf[..], 0, "WAVE "); m = put_int(buf[..], m, s[0].wave); m = put(buf[..], m, "/"); m = put_int(buf[..], m, WAVES);
  n = say_at(out, n, cast(string) buf[0..<m], lx, 32 * k, cap, ink(k, 1, INK_R, INK_G, INK_B));
  lx += text_width(cast(string) buf[0..<m], cap) + sp;
  title := "HOLD THE STAIR";
  if !s[0].portrait && lx + text_width(title, cap) + 24 * k < w { n = say_at(out, n, title, w - text_width(title, cap) - 24 * k, 32 * k, cap, ink(k, 0.7, GOLD_R, GOLD_G, GOLD_B)); }
  // the bottom panel
  bottom := ifx s[0].portrait then 184 * k else 118 * k;
  plate(s, u, Rect.{x0 = 0, y0 = h - bottom, x1 = w, y1 = h}, 0.85, 0);
  // the defender card, or a hint
  if s[0].card >= 0 && s[0].party[s[0].card].live {
    d := s[0].party[s[0].card];
    x0 := ifx s[0].portrait then 14 * k else 24 * k;
    y0 := ifx s[0].portrait then h - bottom + 24 * k else h - bottom + 26 * k;
    // the lines keep clear of the card's buttons
    room := ifx s[0].portrait then w - 28 * k - 142 * k else w - 24 * k - 716 * k;
    lines: [6] [72] u8; lens: [6] int; tones: [6] int;   // tone 0 ink, 1 gold, 2 the class's colour
    nl := 0;
    lens[nl] = put(lines[nl][..], 0, CLASS_NAME[d.cls]); lens[nl] = put(lines[nl][..], lens[nl], " · LEVEL "); lens[nl] = put_int(lines[nl][..], lens[nl], d.level);
    if !s[0].portrait {
      lens[nl] = put(lines[nl][..], lens[nl], " · HITS "); lens[nl] = put_int(lines[nl][..], lens[nl], d.hits);
      lens[nl] = put(lines[nl][..], lens[nl], " · MISSES "); lens[nl] = put_int(lines[nl][..], lens[nl], d.misses);
      lens[nl] = put(lines[nl][..], lens[nl], " · POPS "); lens[nl] = put_int(lines[nl][..], lens[nl], d.pops);
    }
    tones[nl] = 2; nl += 1;
    attack := ifx d.cls == FIGHTER then "LONGSWORD +5 · 1D8+3 SLASHING" else ifx d.cls == WIZARD then "FIRE BOLT +5 · 1D10 FIRE" else "SACRED FLAME · DEX DC 13 · 1D8 RADIANT";
    lens[nl] = put(lines[nl][..], 0, attack); tones[nl] = 0; nl += 1;
    if d.cls == WIZARD {
      lens[nl] = put(lines[nl][..], 0, "MAGIC MISSILE 3 X 1D4+1 · "); lens[nl] = put_int(lines[nl][..], lens[nl], d.slots); lens[nl] = put(lines[nl][..], lens[nl], " LEFT");
      if d.level >= 3 { lens[nl] = put(lines[nl][..], lens[nl], " · SHATTER "); lens[nl] = put_int(lines[nl][..], lens[nl], d.slots2); lens[nl] = put(lines[nl][..], lens[nl], " LEFT"); }
      tones[nl] = 0; nl += 1;
    }
    // what its levels give
    feat := "";
    if d.cls == FIGHTER { feat = ifx d.level >= 3 then "ACTION SURGE · CRITS ON 19-20" else ifx d.level == 2 then "ACTION SURGE: 2 ATTACKS ONCE A WAVE" else "NEXT: ACTION SURGE, 2 ATTACKS ONCE A WAVE"; }
    if d.cls == WIZARD { feat = ifx d.level >= 3 then "SHATTER: 3D8 THUNDER WHERE 3 CROWD" else ifx d.level == 2 then "NEXT: SHATTER, 3D8 THUNDER ON A CROWD" else "NEXT: A THIRD MAGIC MISSILE"; }
    if d.cls == CLERIC { feat = ifx d.level >= 3 then "BLESS +1D4 IN REACH · SPIRITUAL WEAPON" else ifx d.level == 2 then "BLESS: +1D4 TO HIT IN REACH · NEXT: SPIRITUAL WEAPON" else "NEXT: BLESS, +1D4 TO HIT IN REACH"; }
    lens[nl] = put(lines[nl][..], 0, feat); tones[nl] = 2; nl += 1;
    m = 0;
    if d.roll < 0 && d.how != 3 { m = put(buf[..], 0, "NO TURN YET"); }
    else if d.how == 3 { m = put(buf[..], 0, "LAST: SHATTER, "); m = put_int(buf[..], m, d.dealt); m = put(buf[..], m, " THUNDER"); }
    else if d.how == 2 { m = put(buf[..], 0, "LAST: MAGIC MISSILE, NEVER MISSES, "); m = put_int(buf[..], m, d.dealt); }
    else if d.how == 1 {
      m = put(buf[..], 0, "LAST: SAVE D20 "); m = put_int(buf[..], m, d.roll); m = put(buf[..], m, " = "); m = put_int(buf[..], m, d.total);
      m = put(buf[..], m, " VS DC "); m = put_int(buf[..], m, d.vs); m = put(buf[..], m, ifx d.hit then " FAILED" else " SAVED");
    } else {
      m = put(buf[..], 0, "LAST: D20 "); m = put_int(buf[..], m, d.roll); m = put(buf[..], m, " + 5");
      if d.bless > 0 { m = put(buf[..], m, " + BLESS "); m = put_int(buf[..], m, d.bless); }
      m = put(buf[..], m, " = "); m = put_int(buf[..], m, d.total);
      m = put(buf[..], m, " VS AC "); m = put_int(buf[..], m, d.vs); m = put(buf[..], m, ifx d.crit then " CRIT" else ifx d.hit then " HIT" else " MISS");
    }
    lens[nl] = put(lines[nl][..], 0, cast(string) buf[0..<m]); tones[nl] = 1; nl += 1;
    ly := y0;
    for i: 0..<nl {
      line := cast(string) lines[i][0..<lens[i]];
      c := ifx i == 0 then 12 * k else 10 * k;
      while text_width(line, c) > room && c > 6 * k { c -= 0.5 * k; }
      tr: f32 = INK_R; tg: f32 = INK_G; tb: f32 = INK_B;
      if tones[i] == 1 { tr = GOLD_R; tg = GOLD_G; tb = GOLD_B; }
      if tones[i] == 2 { tr = CLASS_R[d.cls]; tg = CLASS_G[d.cls]; tb = CLASS_B[d.cls]; }
      n = say_at(out, n, line, x0, ly, c, ink(k, ifx i == 0 then 1.0f32 else 0.88f32, tr, tg, tb));
      ly += ifx i == 0 then 19 * k else 15 * k;
    }
  } else if s[0].phase != WON && s[0].phase != LOST {
    // how many more this round, and what to do next
    left := round_left(s);
    m = put(buf[..], 0, "PLACE "); m = put_int(buf[..], m, left); m = put(buf[..], m, " MORE THIS ROUND (");
    m = put_int(buf[..], m, round_allowance(s[0].wave)); m = put(buf[..], m, " A ROUND)");
    hint := "PICK A DEFENDER, THEN A TILE BESIDE THE STAIR";
    if left <= 0 { hint = ifx s[0].phase == BUILD then "START THE WAVE FOR MORE" else "MORE WHEN THE NEXT WAVE STARTS"; }
    else if s[0].pick >= 0 {
      if s[0].touch { hint = ifx aim_cell(s) >= 0 then "TAP IT AGAIN TO PLACE · TAP OFF THE MAP TO STOP" else "TAP A TILE TO SEE ITS REACH"; }
      else { hint = "CLICK A TILE TO PLACE · ESC TO STOP"; }
    }
    x0 := ifx s[0].portrait then 14 * k else 24 * k;
    yy := ifx s[0].portrait then h - bottom + 22 * k else h - bottom + 22 * k;
    c := 11 * k;
    count := cast(string) buf[0..<m];
    if s[0].portrait {
      while text_width(count, c) > w - 28 * k && c > 7 * k { c -= 0.5 * k; }
      n = say_at(out, n, count, x0, yy, c, ink(k, 1, GOLD_R, GOLD_G, GOLD_B));
      c2 := 10 * k;
      while text_width(hint, c2) > w - 28 * k && c2 > 6 * k { c2 -= 0.5 * k; }
      n = say_at(out, n, hint, x0, yy + 16 * k, c2, ink(k, 0.75, INK_R, INK_G, INK_B));
    } else {
      n = say_at(out, n, count, x0, yy, c, ink(k, 1, GOLD_R, GOLD_G, GOLD_B));
      n = say_at(out, n, hint, x0 + text_width(count, c) + 24 * k, yy, c, ink(k, 0.75, INK_R, INK_G, INK_B));
    }
  }
  // buttons
  for b: 0..<BUTTONS {
    if !s[0].shown[b] { continue; }
    r := s[0].boxes[b];
    armed := (b >= B_FIGHTER && b <= B_CLERIC && s[0].pick == b - B_FIGHTER) || (b == B_PAUSE && s[0].paused);
    style := ifx armed then 2.0f32 else ifx !s[0].enabled[b] then 3.0f32 else ifx s[0].press == b || s[0].hover_b == b then 2.0f32 else 1.0f32;
    cls := ifx b >= B_FIGHTER && b <= B_CLERIC then b - B_FIGHTER else -1;
    plate_icon(s, u, r, 1, style, cls);
    if cls >= 0 {
      // the class's portrait (stair.wgsl), its name, its cost
      light := ifx s[0].enabled[b] then 1.0f32 else 0.4f32;
      bh := r.y1 - r.y0;
      tx := r.x0 + bh * 0.8;
      room := r.x1 - tx - 8 * k;
      nc := 12 * k;
      while text_width(CLASS_NAME[cls], nc) > room && nc > 7 * k { nc -= 0.5 * k; }
      n = say_at(out, n, CLASS_NAME[cls], tx, (r.y0 + r.y1) / 2 - 2 * k, nc, ink(k, light, CLASS_R[cls], CLASS_G[cls], CLASS_B[cls]));
      m = put_int(buf[..], 0, CLASS_COST[cls]); m = put(buf[..], m, " GOLD");
      cc := lo(10 * k, nc);
      while text_width(cast(string) buf[0..<m], cc) > room && cc > 6 * k { cc -= 0.5 * k; }
      n = say_at(out, n, cast(string) buf[0..<m], tx, (r.y0 + r.y1) / 2 + cc + 4 * k, cc, ink(k, light * 0.9, GOLD_R, GOLD_G, GOLD_B));
      continue;
    }
    m = button_label(s, b, buf[..]);
    lab := cast(string) buf[0..<m];
    bc := 12 * k;
    tw := text_width(lab, bc);
    while tw > r.x1 - r.x0 - 10 * k && bc > 7 * k { bc -= 1 * k; tw = text_width(lab, bc); }
    light := ifx s[0].enabled[b] then 1.0f32 else 0.4f32;
    cr: f32 = INK_R; cg: f32 = INK_G; cb: f32 = INK_B;
    if b >= B_FIGHTER && b <= B_CLERIC { cr = CLASS_R[b - B_FIGHTER]; cg = CLASS_G[b - B_FIGHTER]; cb = CLASS_B[b - B_FIGHTER]; }
    if (b == B_START && s[0].phase == BUILD) || b == B_UPGRADE { cr = GOLD_R; cg = GOLD_G; cb = GOLD_B; }
    n = say_at(out, n, lab, (r.x0 + r.x1) / 2 - tw / 2, (r.y0 + r.y1) / 2 + bc / 2, bc, ink(k, light, cr, cg, cb));
  }
  // the next wave, on the back wall: a bubble of each layer and how many
  if s[0].phase == BUILD && s[0].wave < WAVES && s[0].tile > 0 {
    wy := s[0].oy - f32(WALL_ROWS) * s[0].tile * f32(SQUASH) * 0.5;
    wh := f32(WALL_ROWS) * s[0].tile * f32(SQUASH);
    pc := lo(wh * 0.42, 13 * k);
    br := pc * 0.62;
    // what it says and how wide, to centre it
    total := text_width("NEXT", pc) + 10 * k;
    for g: 0..<GROUPS {
      kind := WAVE_KIND[s[0].wave * GROUPS + g];
      if kind < 0 { continue; }
      m = put(buf[..], 0, "X"); m = put_int(buf[..], m, WAVE_COUNT[s[0].wave * GROUPS + g]);
      total += br * 2 + 4 * k + text_width(cast(string) buf[0..<m], pc) + 12 * k;
    }
    px := s[0].ox + f32(s[0].scols) * s[0].tile * 0.5 - total / 2;
    plate(s, u, Rect.{x0 = px - 10 * k, y0 = wy - pc * 0.5 - 7 * k, x1 = px + total + 4 * k, y1 = wy + pc * 0.5 + 7 * k}, 0.8, 0);
    n = say_at(out, n, "NEXT", px, wy + pc * 0.5, pc, ink(k, 0.8, INK_R, INK_G, INK_B));
    px += text_width("NEXT", pc) + 10 * k;
    for g: 0..<GROUPS {
      kind := WAVE_KIND[s[0].wave * GROUPS + g];
      if kind < 0 { continue; }
      n = bubble(out, n, px + br, wy, br, 1, LAYER_R[kind], LAYER_G[kind], LAYER_B[kind], 0, 0, 0, 0);
      px += br * 2 + 4 * k;
      m = put(buf[..], 0, "X"); m = put_int(buf[..], m, WAVE_COUNT[s[0].wave * GROUPS + g]);
      n = say_at(out, n, cast(string) buf[0..<m], px, wy + pc * 0.5, pc, ink(k, 1, LAYER_R[kind], LAYER_G[kind], LAYER_B[kind]));
      px += text_width(cast(string) buf[0..<m], pc) + 12 * k;
    }
  }
  // the wave's name as it starts
  if s[0].banner > 0 && s[0].phase == FIGHT {
    a := clamp01(s[0].banner / 0.4) * clamp01((1.6 - s[0].banner) / 0.15);
    m = put(buf[..], 0, "WAVE "); m = put_int(buf[..], m, s[0].wave);
    bc := lo(44 * k, w / 9);
    grow := 1 + 0.08 * (1.6 - s[0].banner);
    my := s[0].oy + f32(s[0].srows) * s[0].tile * f32(SQUASH) * 0.5;
    n = say_mid(out, n, cast(string) buf[0..<m], w / 2, my + bc * grow * 0.5, bc * grow, Ink.{core = 1.6 * k, light = a, glow = 3 * k, red = GOLD_R, green = GOLD_G, blue = GOLD_B, mode = 0, scale = k});
  }
  // a toast
  if s[0].toast_t > 0 && s[0].phase != WON && s[0].phase != LOST {
    tt := cast(string) s[0].toast[0..<s[0].toast_n];
    c := 14 * k;
    // over the map's first row, on a dark plate, clear of the wall and its preview
    ty := s[0].oy + s[0].tile * f32(SQUASH) * 0.5 + c * 0.5;
    tw := text_width(tt, c);
    plate(s, u, Rect.{x0 = w / 2 - tw / 2 - 14 * k, y0 = ty - c - 10 * k, x1 = w / 2 + tw / 2 + 14 * k, y1 = ty + 10 * k}, clamp01(s[0].toast_t) * 0.9, 0);
    n = say_mid(out, n, tt, w / 2, ty, c, ink(k, clamp01(s[0].toast_t), GOLD_R, GOLD_G, GOLD_B));
  }
  if s[0].paused && s[0].phase != WON && s[0].phase != LOST {
    py := s[0].oy + f32(s[0].srows) * s[0].tile * f32(SQUASH) * 0.5;
    pw := text_width("PAUSED", 20 * k);
    plate(s, u, Rect.{x0 = w / 2 - pw / 2 - 18 * k, y0 = py - 24 * k, x1 = w / 2 + pw / 2 + 18 * k, y1 = py + 24 * k}, 0.9, 0);
    n = say_mid(out, n, "PAUSED", w / 2, py + 10 * k, 20 * k, ink(k, 1, INK_R, INK_G, INK_B));
  }
  // the end
  if s[0].phase == WON || s[0].phase == LOST {
    cx := w / 2; cy := h / 2;
    half := lo(180 * k, w / 2 - 10 * k);
    plate(s, u, Rect.{x0 = cx - half, y0 = cy - 96 * k, x1 = cx + half, y1 = cy + 92 * k}, 0.95, 0);
    won := s[0].phase == WON;
    head := ifx won then "THE STAIR HOLDS" else "THE TOWER FALLS";
    hc := lo(22 * k, (2 * half - 40 * k) / hi(measure(head, GAP, SPACE, false), 1));
    n = say_mid(out, n, head, cx, cy - 48 * k, hc, ink(k, 1, ifx won then GOLD_R else 1.0f32, ifx won then GOLD_G else 0.4f32, ifx won then GOLD_B else 0.35f32));
    m = put(buf[..], 0, "WAVE "); m = put_int(buf[..], m, s[0].wave); m = put(buf[..], m, " OF "); m = put_int(buf[..], m, WAVES);
    m = put(buf[..], m, " · "); m = put_int(buf[..], m, s[0].pops); m = put(buf[..], m, " POPPED · "); m = put_int(buf[..], m, s[0].lives); m = put(buf[..], m, " LIVES");
    sc := lo(11 * k, (2 * half - 24 * k) / hi(measure(cast(string) buf[0..<m], GAP, SPACE, false), 1));
    n = say_mid(out, n, cast(string) buf[0..<m], cx, cy - 6 * k, sc, ink(k, 0.9, INK_R, INK_G, INK_B));
  }
  return n;
}

stair_frame :: (s: [] Stair, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  stair_start(s);
  s[0].width = width; s[0].height = height; s[0].dpr = dpr; s[0].still = still;
  k := hi(dpr, 0.5);
  step_dt := lo(hi(dt, 0), 0.1);
  if s[0].golden { step_dt = 0; }
  s[0].time += f64(step_dt);
  s[0].clock += step_dt;
  s[0].toast_t = hi(0, s[0].toast_t - step_dt);
  long_press(s);
  if !s[0].paused { s[0].acc += step_dt * f32(s[0].speed); }
  guard := 0;
  while s[0].acc >= f32(STEP) && guard < 64 { step(s, f32(STEP)); s[0].acc -= f32(STEP); guard += 1; }
  if guard >= 64 { s[0].acc = 0; }
  if s[0].wave != s[0].tracked_wave && s[0].phase == FIGHT {
    s[0].tracked_wave = s[0].wave;
    if track_begin(s[0].track[..], "wave") { track_int(s[0].track[..], "wave", s[0].wave); track_end(s[0].track[..]); }
  }
  layout(s, width, height, k);
  buttons(s, width, height, k);
  // uniforms
  for i: 0..<u.count { u[i] = 0; }
  u[0] = width; u[1] = height; u[2] = s[0].clock; u[3] = 1;
  u[U_MAP] = s[0].ox; u[U_MAP + 1] = s[0].oy; u[U_MAP + 2] = s[0].tile; u[U_MAP + 3] = f32(SQUASH);
  u[U_INFO] = f32(s[0].scols); u[U_INFO + 1] = f32(s[0].srows); u[U_INFO + 2] = ifx s[0].portrait then 1.0f32 else 0.0f32;
  u[U_INFO + 3] = f32(ifx s[0].hover >= 0 && free_cell(s, s[0].hover) then s[0].hover else -1);
  u[U_INFO2] = s[0].hurt; u[U_INFO2 + 1] = f32(aim_cell(s));
  for i: 0..<CELLS { u[U_CELLS + i] = f32(s[0].cells[i]) + s[0].prog[i] / 100; }
  // the party's figures: a class per tile, which way each faces, its attack's flash
  for i: 0..<DEFENDERS {
    d := s[0].party[i];
    if !d.live { continue; }
    u[U_CELLS + d.cell] = f32(10 + d.cls) + f32(d.level) / 100;
    dx := ifx s[0].portrait then sin(d.aim) else cos(d.aim);
    u[U_UNIT + d.cell] = (ifx dx < -0.05 then -1.0f32 else 1.0f32) * (1 + d.flash);
  }
  ghost := aim_cell(s);
  if ghost >= 0 && s[0].phase != WON && s[0].phase != LOST { u[U_CELLS + ghost] = f32(10 + s[0].pick); u[U_UNIT + ghost] = 3; }
  s[0].plate_n = 0;
  n := 0;
  if s[0].phase != WON && s[0].phase != LOST {
    n = draw_party(s, out, n);
    n = draw_beasts(s, out, n);
    n = draw_fx(s, out, n);
  }
  n = draw_hud(s, out, u, n, width, height);
  u[U_INFO2 + 2] = f32(s[0].plate_n);
  track_frame(s[0].track[..], dt, width, height, dpr);
  if n > 0 { track_loaded(s[0].track[..], "load-engine"); }
  return n;
}

// ---- checks

#test "the stair winds from the cellar door to the tower top, and the cells beside it are floor" {
  s: [1] Stair;
  stair_start(s[..]);
  #assert s[0].path_len > 26 && s[0].path_len < 29;
  a := path_at(0.5); #assert abs(a.x - 0.5) < 0.01 && abs(a.y - 7.5) < 0.01;
  z := path_at(s[0].path_len - 0.5); #assert abs(z.x - 13.5) < 0.01 && abs(z.y - 1.5) < 0.01;
  #assert s[0].cells[cell_of(0, 7)] == CELL_DOOR && s[0].cells[cell_of(13, 1)] == CELL_TOP;
  #assert s[0].cells[cell_of(3, 4)] == CELL_PATH && s[0].cells[cell_of(4, 4)] == CELL_FLOOR;
  #assert free_cell(s[..], cell_of(4, 6)) && !free_cell(s[..], cell_of(5, 2));
}

#test "placing costs gold, a placed tile is taken, and the layers pop into their insides" {
  s: [1] Stair;
  stair_start(s[..]);
  #assert place(s[..], cell_of(4, 6), FIGHTER) && s[0].gold == START_GOLD - 50;
  #assert !place(s[..], cell_of(4, 6), CLERIC) && !free_cell(s[..], cell_of(4, 6));
  #assert !place(s[..], cell_of(5, 2), CLERIC);
  i := spawn(s[..], EMBER, 5);
  hurt_beast(s[..], i, 50, DMG_FIRE, false, -1);
  #assert s[0].beasts[i].live && live_beasts(s[..]) == 1;     // immune to fire
  hurt_beast(s[..], i, 50, DMG_FORCE, false, -1);
  #assert live_beasts(s[..]) == 2 && s[0].beasts[i].kind != EMBER;    // a glimmer and a wisp
  #assert s[0].pops == 1 && s[0].gold == START_GOLD - 50 + LAYER_GOLD[EMBER];
}

// A simple player: defenders on free tiles beside the stair, from the door up, as gold allows.
AI_CLASSES :: [6] int.[FIGHTER, WIZARD, FIGHTER, CLERIC, WIZARD, FIGHTER];
beside_path :: (s: [] Stair, cell: int) -> bool {
  c := cell % COLS; r := cell / COLS;
  for dr: -1..<2 { for dc: -1..<2 {
    cc := c + dc; rr := r + dr;
    if cc >= 0 && cc < COLS && rr >= 0 && rr < ROWS && s[0].cells[cell_of(cc, rr)] != CELL_FLOOR && s[0].cells[cell_of(cc, rr)] != CELL_DEFENDER { return true; }
  } }
  return false;
}
ai_spot :: (s: [] Stair) -> int {
  // the free tile beside the stair nearest the middle of the climb
  best := -1; bd := 1000.0f32;
  for cell: 0..<CELLS {
    if !free_cell(s, cell) || !beside_path(s, cell) { continue; }
    c := cell_xy(cell);
    m := path_at(s[0].path_len * 0.45);
    dd := (c.x - m.x) * (c.x - m.x) + (c.y - m.y) * (c.y - m.y);
    if dd < bd { bd = dd; best = cell; }
  }
  return best;
}
play_through :: (s: [] Stair, builds: bool) -> int {
  guard := 0;
  while s[0].phase != WON && s[0].phase != LOST && guard < 400000 {
    if builds {
      while s[0].gold >= CLASS_COST[AI_CLASSES[s[0].placed % 6]] {
        spot := ai_spot(s);
        if spot < 0 || !place(s, spot, AI_CLASSES[s[0].placed % 6]) { break; }
      }
    }
    if s[0].phase == BUILD { ok := start_wave(s); }
    step(s, f32(STEP));
    guard += 1;
  }
  return s[0].phase;
}
#test "with no party the tower falls; a party that builds as gold allows holds the stair" {
  s: [1] Stair;
  stair_start(s[..]);
  #assert play_through(s[..], false) == LOST;
  stair_reset(s[..]);
  #assert play_through(s[..], true) == WON && s[0].wave == WAVES;
}

#test "a defender is picked before it goes down, a round allows only so many, and the allowance grows" {
  s: [1] Stair;
  stair_start(s[..]);
  s[0].gold = 2000;
  tap_cell(s[..], cell_of(4, 6));
  #assert s[0].placed == 0;                     // nothing picked: nothing placed
  pick(s[..], FIGHTER);
  #assert s[0].pick == FIGHTER;
  s[0].hover = cell_of(4, 6);
  #assert aim_cell(s[..]) == cell_of(4, 6);     // its reach shows before it is put down
  tap_cell(s[..], cell_of(4, 6));
  #assert s[0].placed == 1 && s[0].pick == FIGHTER;
  s[0].touch = true;
  tap_cell(s[..], cell_of(4, 5));
  #assert s[0].placed == 1 && s[0].selected == cell_of(4, 5);   // a phone's first tap only aims
  tap_cell(s[..], cell_of(4, 5));
  #assert s[0].placed == 2;
  #assert round_allowance(0) == 3 && round_allowance(1) == 3 && round_allowance(2) == 4 && round_allowance(9) == 7;
  tap_cell(s[..], cell_of(2, 4)); tap_cell(s[..], cell_of(2, 4));
  #assert s[0].placed == 3 && round_left(s[..]) == 0 && s[0].pick == -1;
  #assert !place(s[..], cell_of(4, 3), FIGHTER);
  #assert start_wave(s[..]) && round_left(s[..]) == 3;
  pick(s[..], WIZARD); pick(s[..], WIZARD);
  #assert s[0].pick == -1;                      // the same button again stops placing
}

#test "levels cost gold, not a place in the round; each gives its SRD feature; selling returns 70% of all of it" {
  s: [1] Stair;
  stair_start(s[..]);
  s[0].gold = 1000;
  #assert place(s[..], cell_of(4, 6), FIGHTER) && place(s[..], cell_of(2, 4), WIZARD) && place(s[..], cell_of(4, 3), CLERIC);
  f := defender_at(s[..], cell_of(4, 6)); w := defender_at(s[..], cell_of(2, 4)); c := defender_at(s[..], cell_of(4, 3));
  left := round_left(s[..]);
  #assert upgrade(s[..], f) && s[0].party[f].level == 2 && s[0].gold == 1000 - 50 - 85 - 65 - 30 && round_left(s[..]) == left;
  #assert s[0].party[f].surge;                                  // Action Surge, at once
  #assert upgrade(s[..], f) && s[0].party[f].level == 3 && !upgrade(s[..], f);   // 3 is the top
  #assert upgrade(s[..], w) && s[0].party[w].slots == MM_SLOTS + 1;
  #assert upgrade(s[..], w) && s[0].party[w].slots2 == SHATTER_SLOTS;
  // Bless: a level-2 cleric in reach adds a d4; the fighter is in the cleric's reach
  #assert !blessed(s[..], f);
  #assert upgrade(s[..], c) && blessed(s[..], f);
  // Improved Critical: a level-3 fighter's 19 crits; checked over many rolls
  crit19 := false;
  for i: 0..<400 { a := stair_attack(s[..], f, STAIR_FIGHTER, 30, 19); if a.roll == 19 { #assert a.crit && a.hit; crit19 = true; } #assert a.total == a.roll + 5 + s[0].party[f].bless && s[0].party[f].bless >= 1 && s[0].party[f].bless <= 4; }
  #assert crit19;
  // Shatter: three crowded beasts all take thunder
  j0 := spawn(s[..], EMBER, 12.0); j1 := spawn(s[..], EMBER, 12.2); j2 := spawn(s[..], EMBER, 12.4);
  s[0].party[w].cell = cell_of(6, 3);
  #assert take_turn(s[..], w) && s[0].party[w].slots2 == SHATTER_SLOTS - 1 && s[0].party[w].how == 3 && s[0].party[w].dealt > 0;
  before := s[0].gold;
  sell(s[..], f);
  #assert s[0].gold == before + (50 + 30 + 50) * 7 / 10;
}

#test "pause stops the clock and resume starts it" {
  s: [1] Stair;
  stair_start(s[..]);
  #assert start_wave(s[..]);
  s[0].enabled[B_PAUSE] = true; press(s[..], B_PAUSE);
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := stair_frame(s[..], out[..], u[..], 1440, 900, 1, 0.05, false);
  t0 := s[0].wave_t;
  n = stair_frame(s[..], out[..], u[..], 1440, 900, 1, 0.05, false);
  #assert s[0].wave_t == t0;
  s[0].enabled[B_PAUSE] = true; press(s[..], B_PAUSE);
  n = stair_frame(s[..], out[..], u[..], 1440, 900, 1, 0.05, false);
  #assert s[0].wave_t > t0;
}

#test "the staged highlight is the last wave against a full party at level 3, and the stair is busy" {
  s: [1] Stair;
  stair_start(s[..]);
  stair_message(s[..], HOST_PAGE, "url=https://openagents.com/realms/hold-the-stair?stage=highlight");
  #assert s[0].phase == FIGHT && s[0].wave == WAVES && s[0].placed >= 16;
  for k: 0..<DEFENDERS { if s[0].party[k].live { #assert s[0].party[k].level == MAX_LEVEL; } }
  for i: 0..<720 { step(s[..], f32(STEP)); }
  #assert live_beasts(s[..]) >= 8 && s[0].pops >= 10;
  #assert !query_is("https://x/y?stage=highlights", "stage", "highlight") && query_is("https://x/y?a=1&stage=highlight#z", "stage", "highlight");
}
