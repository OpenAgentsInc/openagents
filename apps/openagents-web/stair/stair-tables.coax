// Hold the Stair's content as text tables (hts-content-tables): the bubble-beasts' layers, the
// party's classes and levels, the forty waves, the start and the stair itself, a statement a line,
// that an agent can write and stair_tables_read checks. A table that breaks a rule is refused
// whole with its line and the reason, never bent to fit; the game plays STAIR_TABLES.
//
//   layer NAME ac A hp H dex D con C speed S size Z gold G lives L colour R G B inside A B
//       NAME: mote, wisp, glimmer or ember (their rules are the engine's: an ember's fire
//       immunity, a wisp's cold resistance); A 5-25, H 1-99, D and C -5 to 10, S 0.2-4 tiles a
//       second, Z 0.1-0.45 tiles, G 0-99 gold popped, L 1-99 lives taken at the top, R G B 0-1,
//       inside: the two layers it pops into (- for none), each lower than itself
//   class NAME cost C range R turn T          NAME fighter, wizard, cleric, rogue, ranger, bard or paladin; C 1-999 gold,
//       R 0.5-8 tiles, T 0.2-6 seconds between turns
//   level NAME C2 C3                          gold for levels 2 and 3, 1-999
//   wave N KIND COUNT gap G delay D           a group of wave N (1-10, at most three groups):
//       COUNT 1-200 beasts of KIND, G 0.05-10 seconds apart, the first after D 0-60 seconds
//   start gold G lives L                      G 0-9999, L 1-999
//   round R every E                           R 1-20 defenders a round, one more each E waves (1-10)
//   stair C R C R ...                         the stair's corners from the cellar door to the top
//   stair2 C R C R ...                        (optional) a second stair; the beasts take the two in turn
//       (2 to 16 of them, column 0-13, row 0-8), each straight across or down from the last
//   seed N                                    the dice's seed for the map (1-999999999; optional)
//   # anything after a hash is a note
// Every layer, class, level, wave, start, round and stair must be there.
//   coax/bin/coax test apps/openagents-web/stair.coax

TABLE_LAYERS :: 8; LATE_FROM :: 21; TABLE_CLASSES :: 7; TABLE_WAVES :: 40; TABLE_GROUPS :: 3; TABLE_CORNERS :: 16;
TABLE_ERROR :: 160;
STAIR_SEED :: 20261030;   // the dice's seed when a table names none
TABLE_LAYER_NAMES :: [8] string.["mote", "wisp", "glimmer", "ember", "frostling", "ironskin", "shadow", "hulk"];
TABLE_CLASS_NAMES :: [7] string.["fighter", "wizard", "cleric", "rogue", "ranger", "bard", "paladin"];

Content :: struct {
  ok: bool; line: int; error: [TABLE_ERROR] u8; error_n: int;
  ac: [TABLE_LAYERS] int; hp: [TABLE_LAYERS] int; dex: [TABLE_LAYERS] int; con: [TABLE_LAYERS] int;
  speed: [TABLE_LAYERS] f32; size: [TABLE_LAYERS] f32; gold: [TABLE_LAYERS] int; lives: [TABLE_LAYERS] int;
  red: [TABLE_LAYERS] f32; green: [TABLE_LAYERS] f32; blue: [TABLE_LAYERS] f32;
  inner_a: [TABLE_LAYERS] int; inner_b: [TABLE_LAYERS] int; inner_c: [TABLE_LAYERS] int; inner_d: [TABLE_LAYERS] int;
  cost: [TABLE_CLASSES] int; range: [TABLE_CLASSES] f32; turn: [TABLE_CLASSES] f32;
  up: [TABLE_CLASSES * 4] int;   // levels 2 to 5
  kind: [TABLE_WAVES * TABLE_GROUPS] int; count: [TABLE_WAVES * TABLE_GROUPS] int;
  gap: [TABLE_WAVES * TABLE_GROUPS] f32; delay: [TABLE_WAVES * TABLE_GROUPS] f32;
  start_gold: int; start_lives: int; round_base: int; round_every: int;
  seed: u64;   // the dice's seed for this map: the same seed rolls the same game
  late: f32;   // a map's own weight on the late waves' beasts' hit points (from LATE_FROM on; 1 as written)
  way_n: int; way_c: [TABLE_CORNERS] int; way_r: [TABLE_CORNERS] int;
  way2_n: int; way2_c: [TABLE_CORNERS] int; way2_r: [TABLE_CORNERS] int;   // a second stair (0: none)
  // what was given, to refuse a table missing a part
  had_layer: [TABLE_LAYERS] bool; had_class: [TABLE_CLASSES] bool; had_level: [TABLE_CLASSES] bool;
  waves: int;   // how many, 1 to TABLE_WAVES
  had_wave: [TABLE_WAVES] bool; had_start: bool; had_round: bool;
}

// The first playable's content.
STAIR_TABLES :: [67] string.[
  "# the bubble-beasts: original creatures, stat blocks in the SRD's terms",
  "layer mote    ac 10 hp 2 dex 0 con 0 speed 1.0  size 0.19 gold 2 lives 1  colour 0.55 0.8 1.0   inside - -",
  "layer wisp    ac 11 hp 4 dex 1 con 0 speed 1.25 size 0.24 gold 2 lives 3  colour 0.35 1.0 0.45  inside mote mote",
  "layer glimmer ac 13 hp 5 dex 3 con 1 speed 1.6  size 0.26 gold 3 lives 7  colour 1.0 0.86 0.25  inside wisp wisp",
  "layer ember   ac 12 hp 7 dex 1 con 2 speed 1.45 size 0.3  gold 3 lives 11 colour 1.0 0.2 0.22   inside glimmer wisp",
  "layer frostling ac 12 hp 8 dex 1 con 2 speed 1.3 size 0.31 gold 4 lives 15 colour 0.9 0.96 1.0 inside glimmer glimmer",
  "layer ironskin ac 15 hp 10 dex 0 con 3 speed 1.0 size 0.34 gold 5 lives 23 colour 0.6 0.62 0.68 inside ember ember",
  "layer shadow  ac 13 hp 9 dex 3 con 1 speed 1.5 size 0.3  gold 5 lives 31 colour 0.24 0.18 0.34 inside frostling frostling",
  "layer hulk    ac 17 hp 60 dex -1 con 5 speed 0.6 size 0.44 gold 20 lives 93 colour 0.62 0.3 0.9 inside ironskin ironskin ironskin ironskin",
  "# the party: SRD 5.2.1 classes; ranges in tiles, turns in seconds (the six-second round, scaled)",
  "class fighter cost 50 range 1.6 turn 0.9",
  "class wizard  cost 85 range 3.4 turn 1.4",
  "class cleric  cost 65 range 3.0 turn 1.3",
  "class rogue   cost 60 range 1.6 turn 0.8",
