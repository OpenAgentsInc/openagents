  "level bard    40 60 130 190",
  "level paladin 50 75 160 230",
  "# the waves: light to wave 8, heavy at 9 and 10, then thirty more (stair.coax's play_as players check the curve)",
  "wave 1 mote 12 gap 0.9 delay 0",
  "wave 2 mote 20 gap 0.55 delay 0",
  "wave 3 wisp 6 gap 1.0 delay 0;  wave 3 mote 12 gap 0.5 delay 2",
  "wave 4 wisp 12 gap 0.6 delay 0; wave 4 mote 10 gap 0.4 delay 3",
  "wave 5 glimmer 3 gap 1.6 delay 0; wave 5 wisp 10 gap 0.6 delay 1",
