// What a player does on the Grid, as analytics.coax events (docs/verse/analytics-events.md):
// the face keeps one GridSeen and calls thegrid_track once a frame. A station come up to
// (visit, once a visit), a station's panel opened (station), an answer button (answer, the
// station and the button), a suggestion sent (suggest; its words are the survey's) or not
// (fail), the galaxy button (galaxy), walking milestones (walk), the pack failing (fail), how
// many others are here when that changes (others), the camera into your head and out (setting first-person).
GridSeen :: struct {
  started: bool;
  x: f32; z: f32;
  panel: int; answer: int; sent: int; failed: bool; pressed: bool;
  others: int; inside: bool;
}
GT_STATION_ID :: [7] string.["pylons", "guide", "foreman", "suggest", "games", "builds", "gym"];

thegrid_track :: (s: [] TheGrid, w: [] GridSeen, t: [] Track, x: f32, z: f32) #export_c {
  if !t[0].ready { return; }
  if !w[0].started { w[0].started = true; w[0].x = x; w[0].z = z; w[0].panel = s[0].panel; w[0].answer = s[0].answer; w[0].sent = s[0].sent; }
  gt_dx := x - w[0].x; gt_dz := z - w[0].z;
  track_walk(t, cast(f64) sqrt(gt_dx * gt_dx + gt_dz * gt_dz));
  w[0].x = x; w[0].z = z;
  if s[0].near >= 0 && s[0].near < STATIONS { track_area(t, GT_STATION_ID[s[0].near]); }
  if s[0].panel != w[0].panel {
    if s[0].panel >= 0 && s[0].panel < STATIONS { track_act(t, "station", GT_STATION_ID[s[0].panel]); }
    w[0].panel = s[0].panel;
  }
  if s[0].answer != w[0].answer {
    if s[0].answer >= 0 && s[0].panel >= 0 && s[0].panel < STATIONS { track_act_n(t, "answer", GT_STATION_ID[s[0].panel], s[0].answer); }
    w[0].answer = s[0].answer;
  }
  if s[0].sent != w[0].sent {
    if s[0].sent == SENT_OK { track_act(t, "suggest", ""); }
    if s[0].sent == SENT_FAILED { track_fail(t, "suggest", 0); }
    w[0].sent = s[0].sent;
  }
  if s[0].pressed && !w[0].pressed { track_act(t, "galaxy", ""); }
  w[0].pressed = s[0].pressed;
  if s[0].failed && !w[0].failed { track_fail(t, "pack", 0); }
  w[0].failed = s[0].failed;
  if thegrid_others(s) != w[0].others { w[0].others = thegrid_others(s); track_act_n(t, "others", "", w[0].others); }
  gt_in := verse_orbit_inside(s[0].orbit);
  if gt_in != w[0].inside { w[0].inside = gt_in; track_setting(t, "first-person", gt_in); }
}
