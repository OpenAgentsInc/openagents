// The Grid, openagents.com/realms/the-grid: the bare Verse world the demo
// opened on (aethyr-demo src/grid_world.cpp), its own art from the demo's
// scene, packed by verse/tools/pack_grid.py. A floor of lines out to 264 m
// fading into the black field; the stations by the start (the Pylon
// terminal, the help desk, the suggestion box, the build board), the Game
// Lab, the gym and its boards; the gate to Everglade and the Lagrange arch;
// and the robots walking their recorded patrols, with the Foreman standing
// by the start, three times their size.
//
// You walk it with the engine's controller (verse/player.coax, its own
// library) among the stations' walls and see it through the free orbit
// (verse/camera.coax), as a robot yourself. Walk into the Everglade gate and
// you go to Everglade; GALAXY goes back to the galaxy. Nothing here changes
// the Grid.
//
// thegrid.wgsl draws the scene from the assets alone: the art's faces and
// lines in world space, and the robots skinned from their clips' frames,
// each robot one instance of store 0 (place, yaw, scale and the two frames
// it is between). thegrid-face.c binds it for the browser.
//   coax/bin/coax test apps/openagents-web/thegrid.coax --steps 2000000000

#load "font.coax";
#load "analytics.coax";
#load "../../verse/camera.coax";
#load "../../verse/terrain.coax";
#load "place-orbit.coax";

VERTEX_FLOATS :: 16;   // a HUD stroke's vertex, as Everglade's
MAX_VERTICES :: 16000;
PLATES :: 12;
// width, height, time, fade, still, plates, dpr, robot vertex base; the view's
// four rows; the eye (and a line's width); the fade and bones a frame; the plates
U_VIEW :: 8; U_EYE :: 24; U_FIELD :: 28; U_PLATE :: 32;
UNIFORM_FLOATS :: U_PLATE + PLATES * 8;

FADE_NEAR :: 6.0; FADE_FAR :: 110.0;   // metres: the art fades into the field between these
LINE_PX :: 1.5;                        // a line's width, CSS pixels

CLIPS :: 4;
CLIP_WALK :: 0; CLIP_IDLE :: 1; CLIP_WAVE :: 2;
PATROLS :: 8;
SAMPLES :: 2400;       // every patrol's samples: x, z, yaw, clip, clip time each
SAMPLE_FLOATS :: 5;
ROBOTS :: 16;          // store 0's instances; 0 stands for the art and is never a robot
ROBOT_FLOATS :: 8;     // x, y, z, yaw; scale, frame a, frame b, blend
FOREMAN_X :: 2.8; FOREMAN_Z :: 2.5; FOREMAN_YAW :: -1.079; FOREMAN_SCALE :: 3.0;
WALK_SPEED :: 1.46;    // m/s: the robots' walk, as its clip was made for
DRAWS :: 4;

WALLS :: 16;           // the player's walls (player.coax WALL numbers each)
GATE_X :: 9.0; GATE_Z :: 1.0; GATE_R :: 1.0;   // the Everglade gate's portal, and how near is through it
GALAXY :: "/verse/galaxy";
EVERGLADE :: "/realms/everglade";
ACT_NAVIGATE :: 1;     // host.js: go to the outbox's URL
OUTBOX :: 64;

HOLD_FORWARD :: 1; HOLD_BACK :: 2; HOLD_LEFT :: 4; HOLD_RIGHT :: 8; HOLD_RUN :: 16; HOLD_JUMP :: 32;
HOLD_TURN_LEFT :: 64; HOLD_TURN_RIGHT :: 128; HOLD_TILT_UP :: 256; HOLD_TILT_DOWN :: 512;
KEY_ESCAPE :: -1; KEY_ENTER :: -2; KEY_BACKSPACE :: -3; KEY_LEFT :: -4; KEY_RIGHT :: -5; KEY_UP :: -6; KEY_DOWN :: -7; KEY_SHIFT :: -13;
LOOK_DRAG :: 0.0055;
WHEEL_ZOOM :: 0.006;
NAME_NEAR :: 45.0;     // metres: a place's name shows this near

INK_R :: 0.92; INK_G :: 0.92; INK_B :: 0.95;
DIM_R :: 0.62; DIM_G :: 0.64; DIM_B :: 0.68;

// The places, as the demo's grid-layout.json names them: x, z, and the
// height their name stands at.
PLACES :: 8;
PLACE_NAME :: [8] string.["PYLON TERMINAL", "ASK US", "FOREMAN", "SUGGESTION BOX", "GAME LAB", "BUILD STATUS", "GYM", "TO EVERGLADE"];
PLACE :: [24] f32.[0, 4, 2.8,  -6, -5, 2.4,  2.8, 2.5, 6.4,  12, -10, 2.15,  -8, 3, 5.1,  30, -7, 13.5,  0, 48.8, 5.3,  9, 1, 5.8];

// The walls you can't walk through: the demo's colliders, the build board's
// post and the Foreman's feet. min x, y, z, max x, y, z.
SOLIDS :: 10;
SOLID :: [60] f32.[
  8.5, 0, 26, 9, 1.2, 50,         -9, 0, 26, -8.5, 1.2, 50,       -8.5, 0, 49.5, 8.5, 1.2, 50,
  3, 0, 26, 8.5, 1.2, 26.5,       -8.5, 0, 26, -3, 1.2, 26.5,     -1.4, 0, 3.5, 1.4, 1.2, 4.5,
  -7.3, 0, -5.5, -4.7, 1.2, -4.5, 11.66, 0, -10.3, 12.34, 1.2, -9.7,
  29.8, 0, -7.2, 30.2, 5, -6.8,   2.2, 0, 1.9, 3.4, 5, 3.1
];

Box :: struct { x0: f32; y0: f32; x1: f32; y1: f32; }

// ---- the stations (the demo's grid-ui.js panels): walk up to one (STATION_NEAR
// of its place) and press E, or tap its name, and its panel opens over the
// bottom of the screen: what it is, and up to three buttons. A button shows
// an answer, goes to a page, or (the suggestion box) sends what you typed to
// the site's feedback (POST /api/playtest/survey/answer, question
// grid_suggestion), where the admin dashboard shows it. Places 0 to 6 are
// stations; 7 is the Everglade gate.
STATIONS :: 7;
STATION_NEAR :: 3.0;
STATION_PYLONS :: 0; STATION_GUIDE :: 1; STATION_FOREMAN :: 2; STATION_SUGGEST :: 3; STATION_GAMES :: 4;
STATION_BUILDS :: 5; STATION_GYM :: 6;
STATION_TITLE :: [7] string.["PYLON TERMINAL", "GRID GUIDE", "FOREMAN", "LEAVE A SUGGESTION", "GAME LAB", "BUILD STATUS", "GYM BOARDS"];
STATION_TEXT :: [7] string.[
  "Pylons are the computers that run work for OpenAgents. No live pylons to show right now. What we are building, and the work open on it, is on the projects page.",
  "Explore the Grid, meet the robots on their rounds, and walk up to a station. Ask about something below.",
  "The Foreman keeps OpenAgents' work moving: every project's tasks, who is on them and what just finished, signed on Nostr and shown on the projects page.",
  "Tell us what would make the Verse better. Type it, then press SEND.",
  "The Game Lab isn't open yet. The worlds made so far are on the galaxy: open one from there.",
  "What is being built in the Verse, live: the tasks in progress, the ones just finished and their commits, from the project's signed Nostr events.",
  "The original Gym and its RESULTS and EVALS boards, kept as they were in the first Verse."
];
STATION_PROMPT :: [7] string.["USE THE PYLON TERMINAL", "ASK THE GRID GUIDE", "SEE THE FOREMAN", "LEAVE A SUGGESTION",
  "VISIT THE GAME LAB", "READ THE BUILD BOARD", "READ THE GYM BOARDS"];
// Each station's buttons, three each: a label ("" none) and what it does.
BUTTON_NONE :: 0; BUTTON_ANSWER :: 1; BUTTON_LINK :: 2; BUTTON_SEND :: 3;
STATION_BUTTON :: [21] string.[
  "PROJECTS", "", "",
  "CONTROLS", "FIND A PLACE", "WHAT IS THIS?",
  "PROJECTS", "", "",
  "SEND", "", "",
  "GALAXY", "", "",
  "THE VERSE PROJECT", "ALL PROJECTS", "",
  "", "", ""
];
STATION_DOES :: [21] int.[
  BUTTON_LINK, BUTTON_NONE, BUTTON_NONE,
  BUTTON_ANSWER, BUTTON_ANSWER, BUTTON_ANSWER,
  BUTTON_LINK, BUTTON_NONE, BUTTON_NONE,
  BUTTON_SEND, BUTTON_NONE, BUTTON_NONE,
  BUTTON_LINK, BUTTON_NONE, BUTTON_NONE,
  BUTTON_LINK, BUTTON_LINK, BUTTON_NONE,
  BUTTON_NONE, BUTTON_NONE, BUTTON_NONE
];
// A link's page, or an answer's words.
STATION_WHAT :: [21] string.[
  "/projects", "", "",
  "W A S D or the arrows walk and turn, drag the mouse to look, you run, Shift walks, Space jumps, the wheel zooms. On a phone the left thumb walks, the right looks and a tap jumps. Walk up to a station and press E, or tap its name, to open it.",
  "The Pylon terminal stands just ahead of where you start, with the Foreman beside it. The help desk, the Game Lab, the suggestion box and the build board are round them, the gym is north up the long walk, and the gate to Everglade is close by. Each place's name shows as you come near.",
  "The Grid is where the Verse began: the first Verse demo's world, its stations and its robots walking their rounds, now in Coax. Walk through the gate to go on to Everglade, or press GALAXY to see every world.",
  "/projects", "", "",
  "", "", "",
  "/verse/galaxy", "", "",
  "/projects/verse", "/projects", "",
  "", "", ""
];
SUGGEST_URL :: "/api/playtest/survey/answer";
SUGGEST_Q :: "grid_suggestion";
TYPED :: 1000;           // the most a suggestion keeps (the server's own cap)
POST_BYTES :: 4096;
SENT_NONE :: 0; SENT_SENDING :: 1; SENT_OK :: 2; SENT_FAILED :: 3;
MSG_FACTS :: 600;

TheGrid :: struct {
  started: bool;
  time: f64;
  width: f32; height: f32; dpr: f32;
  touch: bool; golden: bool;
  orbit: Orbit;
  held: int;
  drag_on: bool; drag_id: int; drag_x: f32; drag_y: f32;
  look_yaw: f32; look_pitch: f32;
  key_x: f32; key_y: f32; run: bool; jump: bool;
  feet: Point; face: f32; act: int; walk_time: f32; idle_time: f32;
  // the assets: grid.data (asset 0) read, the GPU's four in
  data_ready: bool; failed: bool; arrived: int;
  faces: int; art_lines: int; robot_lines: int; robot_indices: int; robot_base: int; bones: int;
  clip_n: int; clip_first: [CLIPS] int; clip_frames: [CLIPS] int; clip_length: [CLIPS] f32;
  scale: f32; rate: f32;
  patrol_n: int; patrol_at: [PATROLS] int; patrol_len: [PATROLS] int;
  samples: [SAMPLES * SAMPLE_FLOATS] f32;
  // what the host draws: [first, count, base instance, instances], and store 0
  draws: [DRAWS * 4] u32;
  robots: [ROBOTS * ROBOT_FLOATS] f32; robot_n: int;
  walls: [WALLS * 6] f32; wall_n: int;
  galaxy_button: Box; button_finger: int; pressed: bool;
  outbox: [OUTBOX] u8; out_n: int; action: int;
  plate_n: int;
  // the stations: which is near, which is open, its buttons, what an answer says
  near: int; panel: int; answer: int;
  buttons: [3] Box; close_button: Box; open_button: Box; panel_finger: int;
  typed: [TYPED] u8; typed_n: int;
  post: [POST_BYTES] u8; post_n: int; sent: int;   // a suggestion for the face to send, and how it went
  visitor: [64] u8; visitor_n: int; player: [64] u8; player_n: int; stamp: [24] u8; stamp_n: int;
  field: [4] f32;
  prompt: [64] u8; prompt_n: int;
}

// ---- small things

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { return false; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

ink :: (k: f32, light: f32, red: f32, green: f32, blue: f32) -> Ink {
  i: Ink;
  i.core = 0.55 * k; i.light = light; i.glow = 1.2 * k; i.red = red; i.green = green; i.blue = blue; i.mode = 0; i.scale = k;
  return i;
}
GAP :: 0.5; SPACE :: 1.2;
text_width :: (text: string, cap: f32) -> f32 { return measure(text, GAP, SPACE, false) * cap; }

word_at :: (b: string, at: int) -> u32 {
  return cast(u32) b[at] | (cast(u32) b[at + 1] << 8) | (cast(u32) b[at + 2] << 16) | (cast(u32) b[at + 3] << 24);
}
whole_at :: (b: string, at: int) -> int { return cast(int) word_at(b, at); }
real_at :: (b: string, at: int) -> f32 { return f32_from_bits(word_at(b, at)); }

// ---- the page's state

coaxial_thegrid_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_thegrid_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_thegrid_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

thegrid_start :: (s: [] TheGrid) {
  s[0].started = true;
  s[0].feet = v3(0, 0, 0); s[0].face = 0;
  s[0].orbit = verse_orbit_start(s[0].feet, 0);
  s[0].button_finger = -1; s[0].drag_id = -1;
  s[0].near = -1; s[0].panel = -1; s[0].answer = -1; s[0].panel_finger = -1;
  n := 0;
  for i: 0..<SOLIDS {
    if n >= WALLS { break; }
    for k: 0..<6 { s[0].walls[n * 6 + k] = SOLID[i * 6 + k]; }
    n += 1;
  }
  s[0].wall_n = n;
}

thegrid_walls :: (s: [] TheGrid) -> int #export_c { if !s[0].started { thegrid_start(s); } return s[0].wall_n; }
thegrid_golden :: (s: [] TheGrid, on: bool) #export_c { s[0].golden = on; }

// ---- where you are, kept so a reload puts you back (eg-pos, place.coax)

// Open ground on the Grid: inside the field, clear of the stations and out of
// the Everglade gate's portal (a place kept there would send you on at once).
thegrid_place_open :: (s: [] TheGrid, x: f32, z: f32) -> bool #export_c {
  if !s[0].started { thegrid_start(s); }
  if !finite(x) || !finite(z) || x * x + z * z > f32(FADE_FAR * FADE_FAR) { return false; }
  if flat_gap(v3(x, 0, z), v3(f32(GATE_X), 0, f32(GATE_Z))) < f32(GATE_R) + 1.5 { return false; }
  return verse_place_clear(s[0].walls[..], s[0].wall_n, x, 0, z, 0.35);
}
// A kept place made good: itself when open, else the nearest open spot, else the spawn.
thegrid_place_fix :: (s: [] TheGrid, p: Place) -> Place #export_c {
  q := p; q.y = 0; q.room = -1;
  for i: 0..<PLACE_TRIES {
    t := verse_place_try(p.x, p.z, i);
    if thegrid_place_open(s, t.x, t.z) { q.x = t.x; q.z = t.z; return q; }
  }
  q.x = 0; q.z = 0; q.face = 0; q.yaw = 0;
  return q;
}
// You are put at a kept place: the feet and the orbit as kept.
thegrid_place_camera :: (s: [] TheGrid, p: Place) #export_c {
  if !s[0].started { thegrid_start(s); }
  s[0].feet = v3(p.x, 0, p.z); s[0].face = p.face;
  s[0].orbit = verse_place_orbit(p, s[0].feet);
}

// grid.data (pack_grid.py's header): the counts, the clips and the patrols.
// False, and nothing kept, when it isn't one.
thegrid_data :: (s: [] TheGrid, b: string) -> bool #export_c {
  if !s[0].started { thegrid_start(s); }
  if b.count < 44 || b[0] != 'A' || b[1] != 'G' || b[2] != 'R' || b[3] != 'D' { s[0].failed = true; return false; }
  clips := whole_at(b, 28);
  if clips < 1 || clips > CLIPS { s[0].failed = true; return false; }
  at := 32 + clips * 12;
  if b.count < at + 12 { s[0].failed = true; return false; }
  patrol_count := whole_at(b, at + 8);
  if patrol_count < 0 || patrol_count > PATROLS { s[0].failed = true; return false; }
  // walk the patrols once to check every one fits, before keeping anything
  p := at + 12; total := 0;
  for i: 0..<patrol_count {
    if b.count < p + 4 { s[0].failed = true; return false; }
    m := whole_at(b, p);
    if m < 1 || total + m > SAMPLES || b.count < p + 4 + m * 20 { s[0].failed = true; return false; }
    total += m; p += 4 + m * 20;
  }
  s[0].faces = whole_at(b, 4); s[0].art_lines = whole_at(b, 8); s[0].robot_lines = whole_at(b, 12);
  s[0].robot_indices = whole_at(b, 16); s[0].robot_base = whole_at(b, 20); s[0].bones = whole_at(b, 24);
  s[0].clip_n = clips;
  for c: 0..<clips {
    s[0].clip_first[c] = whole_at(b, 32 + c * 12);
    s[0].clip_frames[c] = whole_at(b, 36 + c * 12);
    s[0].clip_length[c] = real_at(b, 40 + c * 12);
  }
  s[0].scale = real_at(b, at); s[0].rate = real_at(b, at + 4);
  p = at + 12; total = 0;
  for i: 0..<patrol_count {
    m := whole_at(b, p);
    s[0].patrol_at[i] = total; s[0].patrol_len[i] = m;
    for j: 0..<m * SAMPLE_FLOATS { s[0].samples[(total * SAMPLE_FLOATS) + j] = real_at(b, p + 4 + j * 4); }
    total += m; p += 4 + m * 20;
  }
  s[0].patrol_n = patrol_count;
  s[0].data_ready = true;
  return true;
}
// One of the GPU's four assets (the vertices, lines, bones and indices) came, or didn't.
thegrid_arrived :: (s: [] TheGrid, ok: bool) #export_c {
  if !s[0].started { thegrid_start(s); }
  if ok { s[0].arrived += 1; } else { s[0].failed = true; }
}
ready :: (s: [] TheGrid) -> bool { return s[0].data_ready && s[0].arrived >= 4 && !s[0].failed; }
thegrid_draws :: (s: [] TheGrid) -> int #export_c { return ifx ready(s) then DRAWS else 0; }
thegrid_store_bytes :: (s: [] TheGrid) -> int #export_c { return (hi_i(s[0].robot_n, 0) + 1) * ROBOT_FLOATS * 4; }
hi_i :: (a: int, b: int) -> int { return ifx a > b then a else b; }

// ---- the controls

hold_bit :: (key: int) -> int {
  if key == 'w' || key == 'W' { return HOLD_FORWARD; }
  if key == 's' || key == 'S' { return HOLD_BACK; }
  if key == 'a' || key == 'A' { return HOLD_LEFT; }
  if key == 'd' || key == 'D' { return HOLD_RIGHT; }
  if key == KEY_SHIFT { return HOLD_RUN; }
  if key == ' ' { return HOLD_JUMP; }
  if key == KEY_LEFT { return HOLD_TURN_LEFT; }
  if key == KEY_RIGHT { return HOLD_TURN_RIGHT; }
  if key == KEY_UP { return HOLD_TILT_UP; }
  if key == KEY_DOWN { return HOLD_TILT_DOWN; }
  return 0;
}

leave_to :: (s: [] TheGrid, url: string) {
  if s[0].action != 0 { return; }
  n := 0;
  for i: 0..<url.count { if n < OUTBOX { s[0].outbox[n] = url[i]; n += 1; } }
  s[0].out_n = n; s[0].action = ACT_NAVIGATE;
}
thegrid_action :: (s: [] TheGrid) -> int #export_c { a := s[0].action; s[0].action = 0; return a; }
thegrid_action_done :: (s: [] TheGrid) #export_c { s[0].out_n = 0; }

thegrid_key :: (s: [] TheGrid, key: int, mods: int) -> bool #export_c {
  if !s[0].started { thegrid_start(s); }
  if s[0].panel >= 0 { return panel_key(s, key, mods); }
  if (key == 'e' || key == 'E') && s[0].near >= 0 { open_station(s, s[0].near); return true; }
  if key == '+' || key == '=' { s[0].orbit = verse_orbit_zoom(s[0].orbit, -0.8); return true; }
  if key == '-' || key == '_' { s[0].orbit = verse_orbit_zoom(s[0].orbit, 0.8); return true; }
  b := hold_bit(key);
  if b == 0 { return false; }
  s[0].held = s[0].held | b;
  return true;
}

thegrid_key_up :: (s: [] TheGrid, key: int, mods: int) -> bool #export_c {
  b := hold_bit(key);
  if b == 0 { return false; }
  if s[0].held & b != 0 { s[0].held = s[0].held - b; }
  return true;
}

thegrid_blur :: (s: [] TheGrid) #export_c { s[0].held = 0; s[0].drag_on = false; s[0].button_finger = -1; s[0].pressed = false; s[0].panel_finger = -1; }

in_box :: (b: Box, x: f32, y: f32) -> bool { return b.x1 > b.x0 && x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }

// A mouse drag turns the camera; a press on GALAXY, lifted on it, goes
// there; any other finger is the face's (the sticks), so this says it isn't used.
thegrid_pointer :: (s: [] TheGrid, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  if !s[0].started { thegrid_start(s); }
  if kind != 0 { s[0].touch = true; }
  if s[0].panel >= 0 { return panel_pointer(s, x, y, phase, id); }
  if phase == 0 && in_box(s[0].open_button, x, y) { s[0].panel_finger = id; return true; }
  if id == s[0].panel_finger {
    if phase == 2 && s[0].near >= 0 && in_box(s[0].open_button, x, y) { open_station(s, s[0].near); }
    if phase >= 2 { s[0].panel_finger = -1; }
    return true;
  }
  if phase == 0 && in_box(s[0].galaxy_button, x, y) { s[0].button_finger = id; s[0].pressed = true; return true; }
  if id == s[0].button_finger {
    if phase == 2 && in_box(s[0].galaxy_button, x, y) { leave_to(s, GALAXY); }
    if phase >= 2 { s[0].button_finger = -1; s[0].pressed = false; }
    return true;
  }
  if kind != 0 { return false; }
  k := hi(s[0].dpr, 0.5);
  if phase == 0 { s[0].drag_on = true; s[0].drag_id = id; s[0].drag_x = x; s[0].drag_y = y; return true; }
  if !s[0].drag_on || id != s[0].drag_id { return false; }
  if phase == 1 {
    s[0].look_yaw -= (x - s[0].drag_x) / k * f32(LOOK_DRAG);
    s[0].look_pitch -= (y - s[0].drag_y) / k * f32(LOOK_DRAG);
    s[0].drag_x = x; s[0].drag_y = y;
    return true;
  }
  s[0].drag_on = false;
  return true;
}

thegrid_cursor :: (s: [] TheGrid) -> int #export_c { return ifx s[0].pressed then 1 else 0; }

// ---- the stations' panels

open_station :: (s: [] TheGrid, i: int) {
  if i < 0 || i >= STATIONS { return; }
  s[0].panel = i; s[0].answer = -1; s[0].held = 0;
  if i == STATION_SUGGEST && s[0].sent == SENT_OK { s[0].sent = SENT_NONE; }
}
close_panel :: (s: [] TheGrid) { s[0].panel = -1; s[0].panel_finger = -1; }
// While a panel is open you stand still; the suggestion box takes typing.
thegrid_busy :: (s: [] TheGrid) -> bool #export_c { return s[0].panel >= 0; }
thegrid_wants_text :: (s: [] TheGrid) -> bool #export_c { return s[0].panel == STATION_SUGGEST && s[0].sent != SENT_SENDING; }

press :: (s: [] TheGrid, b: int) {
  i := s[0].panel;
  if i < 0 || b < 0 || b > 2 { return; }
  k := i * 3 + b;
  does := STATION_DOES[k];
  if does == BUTTON_ANSWER { s[0].answer = k; }
  if does == BUTTON_LINK { leave_to(s, STATION_WHAT[k]); }
  if does == BUTTON_SEND { send_suggestion(s); }
}

panel_key :: (s: [] TheGrid, key: int, mods: int) -> bool {
  if key == KEY_ESCAPE { close_panel(s); return true; }
  if s[0].panel == STATION_SUGGEST {
    if key == KEY_ENTER { send_suggestion(s); return true; }
    if s[0].sent == SENT_SENDING { return true; }
    if key == KEY_BACKSPACE {
      n := s[0].typed_n;
      while n > 0 { n -= 1; if (s[0].typed[n] & 0xC0) != 0x80 { break; } }
      s[0].typed_n = n;
      return true;
    }
    if (mods & 10) != 0 { return false; }
    if key < 32 || key == 127 { return key >= 0; }
    if s[0].sent == SENT_FAILED { s[0].sent = SENT_NONE; }
    type_code(s, key);
    return true;
  }
  if key >= '1' && key <= '3' { press(s, key - '1'); return true; }
  if key == KEY_ENTER || key == 'e' || key == 'E' { press(s, 0); return true; }
  return (mods & 10) == 0 && key != KEY_SHIFT;
}
// A code point as UTF-8 onto what's typed, if it fits.
type_code :: (s: [] TheGrid, c: int) {
  n := s[0].typed_n;
  size := ifx c < 0x80 then 1 else ifx c < 0x800 then 2 else ifx c < 0x10000 then 3 else 4;
  if n + size > TYPED { return; }
  if size == 1 { s[0].typed[n] = cast(u8) c; }
  if size == 2 { s[0].typed[n] = cast(u8) (0xC0 | (c >> 6)); s[0].typed[n + 1] = cast(u8) (0x80 | (c & 63)); }
  if size == 3 { s[0].typed[n] = cast(u8) (0xE0 | (c >> 12)); s[0].typed[n + 1] = cast(u8) (0x80 | ((c >> 6) & 63)); s[0].typed[n + 2] = cast(u8) (0x80 | (c & 63)); }
  if size == 4 {
    s[0].typed[n] = cast(u8) (0xF0 | (c >> 18)); s[0].typed[n + 1] = cast(u8) (0x80 | ((c >> 12) & 63));
    s[0].typed[n + 2] = cast(u8) (0x80 | ((c >> 6) & 63)); s[0].typed[n + 3] = cast(u8) (0x80 | (c & 63));
  }
  s[0].typed_n = n + size;
}
typed_text :: (s: [] TheGrid) -> string { return cast(string) s[0].typed[0..<s[0].typed_n]; }

panel_pointer :: (s: [] TheGrid, x: f32, y: f32, phase: int, id: int) -> bool {
  if phase == 0 { s[0].panel_finger = id; return true; }
  if id != s[0].panel_finger { return true; }
  if phase == 2 {
    if in_box(s[0].close_button, x, y) { close_panel(s); }
    else { for b: 0..<3 { if in_box(s[0].buttons[b], x, y) { press(s, b); } } }
  }
  if phase >= 2 { s[0].panel_finger = -1; }
  return true;
}

// ---- a suggestion: the feedback's answer body, every text escaped

json_put :: (out: [] u8, at: int, text: string) -> int {
  n := at;
  for i: 0..<text.count {
    c := text[i];
    if n + 2 >= out.count { return n; }
    if c == '"' || c == '\\' { out[n] = '\\'; out[n + 1] = c; n += 2; continue; }
    out[n] = ifx c < 32 then cast(u8) ' ' else c; n += 1;
  }
  return n;
}
raw_put :: (out: [] u8, at: int, text: string) -> int {
  n := at;
  for i: 0..<text.count { if n < out.count { out[n] = text[i]; n += 1; } }
  return n;
}
// The respondent id the feedback wants (16 hex digits): this browser's visitor and this visit's stamp, hashed.
respondent :: (visitor: string, stamp: string, out: [] u8) -> int {
  prime: u64 = 0x100000001b3;
  h: u64 = 0xcbf29ce484222325;
  for i: 0..<visitor.count { h = mul_wrap(h ^ cast(u64) visitor[i], prime); }
  h = mul_wrap(h ^ cast(u64) '|', prime);
  for i: 0..<stamp.count { h = mul_wrap(h ^ cast(u64) stamp[i], prime); }
  hex := "0123456789abcdef";
  for k: 0..<16 {
    shift: u64 = cast(u64) (60 - 4 * k);
    if k < out.count { out[k] = hex[cast(int) ((h >> shift) & cast(u64) 15)]; }
  }
  return 16;
}
grid_suggestion_body :: (out: [] u8, text: string, visitor: string, stamp: string, player: string) -> int {
  rid: [16] u8;
  r := respondent(visitor, stamp, rid[..]);
  n := raw_put(out, 0, "{\"rid\":\"");
  n = raw_put(out, n, cast(string) rid[0..<r]);
  n = raw_put(out, n, "\",\"q\":\"");
  n = raw_put(out, n, SUGGEST_Q);
  n = raw_put(out, n, "\",\"a\":\"");
  n = json_put(out, n, text);
  n = raw_put(out, n, "\",\"player\":\"");
  n = json_put(out, n, player);
  n = raw_put(out, n, "\"}");
  if n >= out.count - 1 { return 0; }
  return n;
}
blank :: (text: string) -> bool { for i: 0..<text.count { if text[i] != ' ' { return false; } } return true; }
send_suggestion :: (s: [] TheGrid) {
  if s[0].panel != STATION_SUGGEST || s[0].sent == SENT_SENDING || s[0].post_n > 0 || blank(typed_text(s)) { return; }
  n := grid_suggestion_body(s[0].post[..], typed_text(s), cast(string) s[0].visitor[0..<s[0].visitor_n],
                            cast(string) s[0].stamp[0..<s[0].stamp_n], cast(string) s[0].player[0..<s[0].player_n]);
  if n == 0 { return; }
  s[0].post_n = n; s[0].sent = SENT_SENDING;
}
// The face's side: the body to send, that it went, and the answer ("STATUS\n" then the body).
thegrid_post :: (s: [] TheGrid) -> int #export_c { return s[0].post_n; }
thegrid_post_sent :: (s: [] TheGrid) #export_c { s[0].post_n = 0; }
thegrid_post_answer :: (s: [] TheGrid, reply: string) #export_c {
  if s[0].sent != SENT_SENDING { return; }
  ok := reply.count >= 4 && reply[0..<4] == "200\n";
  s[0].sent = ifx ok then SENT_OK else SENT_FAILED;
  if ok { s[0].typed_n = 0; }
}
// The page facts: visitor= and now= make the respondent id; player= goes with it.
take_fact :: (line: string, name: string, out: [] u8) -> int {
  if line.count < name.count || line[0..<name.count] != name { return -1; }
  n := 0;
  for k: name.count..<line.count { if n < out.count { out[n] = line[k]; n += 1; } }
  return n;
}
thegrid_message :: (s: [] TheGrid, kind: int, text: string) #export_c {
  if kind != MSG_FACTS { return; }
  i := 0;
  while i < text.count {
    e := i; while e < text.count && text[e] != '\n' { e += 1; }
    line := text[i..<e];
    i = e + 1;
    v := take_fact(line, "visitor=", s[0].visitor[..]); if v >= 0 { s[0].visitor_n = v; }
    p := take_fact(line, "player=", s[0].player[..]); if p >= 0 { s[0].player_n = p; }
    t := take_fact(line, "now=", s[0].stamp[..]); if t >= 0 { s[0].stamp_n = t; }
  }
}

// The nearest station within STATION_NEAR of you, or -1.
nearest_station :: (you: Point) -> int {
  best := -1; most := f32(STATION_NEAR * STATION_NEAR);
  for p: 0..<STATIONS {
    dx := PLACE[p * 3] - you.x; dz := PLACE[p * 3 + 1] - you.z;
    d := dx * dx + dz * dz;
    if d < most { most = d; best = p; }
  }
  return best;
}

thegrid_wheel :: (s: [] TheGrid, dy: f32) #export_c {
  if finite(dy) { s[0].orbit = verse_orbit_zoom(s[0].orbit, clamp(dy, -400, 400) * f32(WHEEL_ZOOM)); }
}

axis :: (held: int, plus: int, minus: int) -> f32 {
  a := 0.0f32;
  if held & plus != 0 { a += 1; }
  if held & minus != 0 { a -= 1; }
  return a;
}

thegrid_controls :: (s: [] TheGrid, dt: f32, dyaw: f32, dpitch: f32) #export_c {
  if !s[0].started { thegrid_start(s); }
  h := s[0].held;
  s[0].key_x = axis(h, HOLD_RIGHT, HOLD_LEFT);
  s[0].key_y = axis(h, HOLD_FORWARD, HOLD_BACK);
  s[0].run = h & HOLD_RUN != 0;
  s[0].jump = h & HOLD_JUMP != 0;
  o := verse_orbit_look(s[0].orbit, s[0].look_yaw + dyaw, s[0].look_pitch + dpitch);
  o = verse_orbit_keys(o, axis(h, HOLD_TURN_LEFT, HOLD_TURN_RIGHT), axis(h, HOLD_TILT_UP, HOLD_TILT_DOWN), dt);
  s[0].orbit = o;
  s[0].look_yaw = 0; s[0].look_pitch = 0;
}

thegrid_player_theta :: (s: [] TheGrid) -> f32 #export_c { return wrap_angle(s[0].orbit.yaw + f32(PI)); }

// ---- the robots

floor_mod :: (a: f32, m: f32) -> f32 { if m <= 0 { return 0; } r := a - floor(a / m) * m; return ifx r >= m then 0.0f32 else r; }

// A robot at x, z facing yaw, playing clip c at clip time t, as instance i of store 0.
pose :: (s: [] TheGrid, i: int, x: f32, z: f32, yaw: f32, size: f32, c: int, t: f32) {
  if i < 1 || i >= ROBOTS { return; }
  clip := ifx c >= 0 && c < s[0].clip_n then c else 0;
  frames := hi_i(s[0].clip_frames[clip], 1);
  span := s[0].clip_length[clip];
  f := ifx span > 0 then floor_mod(t, span) / span * f32(frames) else 0.0f32;
  a := cast(int) floor(f);
  if a >= frames { a = frames - 1; }
  if a < 0 { a = 0; }
  k := i * ROBOT_FLOATS;
  s[0].robots[k] = x; s[0].robots[k + 1] = 0; s[0].robots[k + 2] = z; s[0].robots[k + 3] = yaw;
  s[0].robots[k + 4] = size;
  s[0].robots[k + 5] = f32(s[0].clip_first[clip] + a);
  s[0].robots[k + 6] = f32(s[0].clip_first[clip] + (a + 1) % frames);
  s[0].robots[k + 7] = clamp(f - f32(a), 0, 1);
}

// Each patrol replays its samples on a loop, between two samples as the clock falls.
walk_patrols :: (s: [] TheGrid, clock: f32) -> int {
  n := 1;
  for p: 0..<s[0].patrol_n {
    m := s[0].patrol_len[p];
    if m < 1 || n >= ROBOTS - 2 { continue; }
    q := floor_mod(clock * hi(s[0].rate, 1), f32(m));
    i := cast(int) floor(q);
    if i >= m { i = m - 1; }
    j := (i + 1) % m;
    w := q - f32(i);
    a := (s[0].patrol_at[p] + i) * SAMPLE_FLOATS; b := (s[0].patrol_at[p] + j) * SAMPLE_FLOATS;
    sa := s[0].samples[a..<a + SAMPLE_FLOATS]; sb := s[0].samples[b..<b + SAMPLE_FLOATS];
    x := lerp(sa[0], sb[0], w); z := lerp(sa[1], sb[1], w);
    yaw := sa[2] + wrap_angle(sb[2] - sa[2]) * w;
    c := cast(int) sa[3];
    t := sa[4] + w / hi(s[0].rate, 1);
    pose(s, n, x, z, yaw, s[0].scale, c, t);
    n += 1;
  }
  return n;
}

// ---- the scene

NEAR :: 0.1; FAR :: 420.0;
view :: (shot: Shot, width: f32, height: f32, u: [] f32, at: int) {
  f := unit_or(sub(shot.at, shot.eye), v3(0, 0, 1));
  r := unit_or(cross(f, v3(0, 1, 0)), v3(1, 0, 0));
  up := cross(r, f);
  aspect := width / hi(height, 1);
  fy := clamp(aspect * 1.25, 0.95, 1.9);
  fx := fy / aspect;
  depth := f32(FAR / (FAR - NEAR));
  e := shot.eye;
  rows := [16] f32.[
    r.x * fx, r.y * fx, r.z * fx, -dot(r, e) * fx,
    up.x * fy, up.y * fy, up.z * fy, -dot(up, e) * fy,
    f.x * depth, f.y * depth, f.z * depth, (-dot(f, e) - f32(NEAR)) * depth,
    f.x, f.y, f.z, -dot(f, e)
  ];
  for i: 0..<16 { u[at + i] = rows[i]; }
}

// The floor is y 0: the camera stays a little above it.
floor_room :: (r: OrbitRay) -> f32 {
  if r.dir.y >= -0.0001 { return r.far; }
  return clamp((r.from.y - 0.2) / -r.dir.y, 0, r.far);
}

camera_frame :: (s: [] TheGrid, feet: Point, vx: f32, vz: f32, dt: f32) -> Shot {
  speed := sqrt(vx * vx + vz * vz);
  o := verse_orbit_follow(s[0].orbit, feet, yaw_of(vx, vz), finite(speed) && speed > 0.6, dt);
  room := verse_orbit_room(o, s[0].walls[0..<0], s[0].walls[0..<s[0].wall_n * 6]);
  room = lo(room, floor_room(verse_orbit_ray(o)));
  o = verse_orbit_limit(o, room, dt);
  s[0].orbit = o;
  return verse_orbit_shot(o);
}

// ---- the HUD

plate :: (s: [] TheGrid, u: [] f32, b: Box, alpha: f32, look: f32) {
  n := s[0].plate_n;
  if n >= PLATES { return; }
  k := U_PLATE + n * 8;
  u[k] = b.x0; u[k + 1] = b.y0; u[k + 2] = b.x1; u[k + 3] = b.y1;
  u[k + 4] = alpha; u[k + 5] = look; u[k + 6] = s[0].dpr; u[k + 7] = 0;
  s[0].plate_n = n + 1;
}

phone :: (s: [] TheGrid) -> bool { return s[0].touch || s[0].width / hi(s[0].dpr, 0.5) < 700; }

hint :: (s: [] TheGrid) -> string {
  if s[0].failed { return "THE GRID DIDN'T LOAD · RELOAD THE PAGE TO TRY AGAIN"; }
  if !ready(s) { return "THE GRID IS ON ITS WAY"; }
  if phone(s) { return "LEFT THUMB WALKS · RIGHT THUMB LOOKS · TAP JUMPS"; }
  return "WASD MOVE · DRAG OR ARROWS TURN · WHEEL ZOOMS · SHIFT WALKS";
}

// The nearest place, or none further than 14 m.
where :: (you: Point) -> string {
  best := -1; most := 196.0f32;
  for p: 0..<PLACES {
    dx := PLACE[p * 3] - you.x; dz := PLACE[p * 3 + 1] - you.z;
    d := dx * dx + dz * dz;
    if d < most { most = d; best = p; }
  }
  if best < 0 { return "WALK UP TO A PLACE TO SEE ITS NAME"; }
  return PLACE_NAME[best];
}

Screen :: struct { x: f32; y: f32; w: f32; ok: bool; }
on_screen :: (u: [] f32, p: Point, width: f32, height: f32) -> Screen {
  s: Screen;
  cx := u[U_VIEW] * p.x + u[U_VIEW + 1] * p.y + u[U_VIEW + 2] * p.z + u[U_VIEW + 3];
  cy := u[U_VIEW + 4] * p.x + u[U_VIEW + 5] * p.y + u[U_VIEW + 6] * p.z + u[U_VIEW + 7];
  cw := u[U_VIEW + 12] * p.x + u[U_VIEW + 13] * p.y + u[U_VIEW + 14] * p.z + u[U_VIEW + 15];
  s.w = cw;
  s.ok = cw > 0.5;
  if !s.ok { return s; }
  s.x = (cx / cw + 1) * 0.5 * width; s.y = (1 - cy / cw) * 0.5 * height;
  s.ok = s.x > -200 && s.x < width + 200 && s.y > 0 && s.y < height;
  return s;
}

labels :: (s: [] TheGrid, out: [] f32, u: [] f32, n: int, you: Point) -> int {
  k := hi(s[0].dpr, 0.5);
  m := n;
  for p: 0..<PLACES {
    pp := v3(PLACE[p * 3], PLACE[p * 3 + 2], PLACE[p * 3 + 1]);
    if flat_gap(pp, you) > f32(NAME_NEAR) { continue; }
    sc := on_screen(u, pp, s[0].width, s[0].height);
    if !sc.ok { continue; }
    cap := 7.5 * k;
    w := text_width(PLACE_NAME[p], cap);
    m = draw_text(out, m, PLACE_NAME[p], sc.x - w / 2, sc.y, cap, GAP, SPACE, ink(k, 0.85, INK_R, INK_G, INK_B), false, false);
  }
  return m;
}

open_prompt :: (s: [] TheGrid) -> string {
  if s[0].near < 0 { return ""; }
  m := raw_put(s[0].prompt[..], 0, ifx phone(s) then "" else "E · ");
  m = raw_put(s[0].prompt[..], m, STATION_PROMPT[s[0].near]);
  s[0].prompt_n = m;
  return cast(string) s[0].prompt[0..<m];
}

// A station's panel along the bottom: its title and CLOSE, what it is (or
// the answer a button gave), the suggestion's typed line, and its buttons.
wrap_lines :: (text: string, width: f32, cap: f32, starts: [] int, ends: [] int) -> int {
  lines := 0; from := 0;
  next: [1] int;
  while from < text.count && lines < starts.count {
    e := wrap(text, from, width / cap, GAP, SPACE, false, next[..]);
    starts[lines] = from; ends[lines] = e; lines += 1;
    if next[0] <= from { break; }
    from = next[0];
  }
  return lines;
}
panel_view :: (s: [] TheGrid, out: [] f32, u: [] f32, at: int) -> int {
  k := hi(s[0].dpr, 0.5);
  w := s[0].width; h := s[0].height;
  gutter := 16 * k;
  pw := lo(w - 2 * gutter, 760 * k);
  x0 := (w - pw) / 2; x1 := x0 + pw;
  cap := 8.5 * k; lead := cap * 2.1;
  i := s[0].panel;
  said := STATION_TEXT[i];
  if s[0].answer >= 0 { said = STATION_WHAT[s[0].answer]; }
  if i == STATION_SUGGEST && s[0].sent == SENT_OK { said = "Thank you. Your suggestion is in."; }
  if i == STATION_SUGGEST && s[0].sent == SENT_FAILED { said = "It didn't go. Check your connection and press SEND again."; }
  inner := pw - 32 * k;
  starts: [6] int; ends: [6] int;
  lines := wrap_lines(said, inner, cap, starts[..], ends[..]);
  buttons := 0;
  for b: 0..<3 { if STATION_BUTTON[i * 3 + b].count > 0 { buttons += 1; } }
  typing := i == STATION_SUGGEST;
  ph := 30 * k + cap + 14 * k + f32(hi_i(lines, 1)) * lead + (ifx typing then 56 * k else 0.0f32)
        + (ifx buttons > 0 then 60 * k else 0.0f32) + 16 * k;
  y0 := h - gutter - ph;
  plate(s, u, Box.{x0 = x0, y0 = y0, x1 = x1, y1 = h - gutter}, 0.9, 0);
  n := at;
  y := y0 + 18 * k + cap;
  n = draw_text(out, n, STATION_TITLE[i], x0 + 16 * k, y, cap, GAP, SPACE, ink(k, 0.95, INK_R, INK_G, INK_B), false, false);
  cw := text_width("CLOSE", 8 * k) + 28 * k;
  cb := Box.{x0 = x1 - 10 * k - cw, y0 = y0 + 8 * k, x1 = x1 - 10 * k, y1 = y0 + 8 * k + 34 * k};
  s[0].close_button = cb;
  plate(s, u, cb, 0.85, 1);
  n = draw_text(out, n, "CLOSE", cb.x0 + 14 * k, cb.y1 - 13 * k, 8 * k, GAP, SPACE, ink(k, 0.95, INK_R, INK_G, INK_B), false, false);
  y += 14 * k;
  for l: 0..<lines {
    y += lead;
    if ends[l] > starts[l] {
      n = draw_text(out, n, said[starts[l]..<ends[l]], x0 + 16 * k, y - lead * 0.4, cap, GAP, SPACE, ink(k, 0.85, DIM_R, DIM_G, DIM_B), false, false);
    }
  }
  if typing {
    y += 12 * k;
    fb := Box.{x0 = x0 + 12 * k, y0 = y, x1 = x1 - 12 * k, y1 = y + 40 * k};
    plate(s, u, fb, 0.95, 0);
    s[0].field[0] = fb.x0; s[0].field[1] = fb.y0; s[0].field[2] = fb.x1 - fb.x0; s[0].field[3] = fb.y1 - fb.y0;
    tc := cap;
    base := fb.y1 - 15 * k;
    if s[0].sent == SENT_SENDING {
      n = draw_text(out, n, "SENDING", fb.x0 + 12 * k, base, tc * 0.85, GAP, SPACE, ink(k, 0.6, DIM_R, DIM_G, DIM_B), false, false);
    } else if s[0].typed_n > 0 {
      typed := typed_text(s);
      shown := typed; skip := 0;
      tw := text_width(shown, tc);
      while tw > fb.x1 - fb.x0 - 3 * tc && skip < typed.count { skip += 1; while skip < typed.count && (typed[skip] & 0xC0) == 0x80 { skip += 1; } shown = typed[skip..<typed.count]; tw = text_width(shown, tc); }
      n = draw_text(out, n, shown, fb.x0 + 12 * k, base, tc, GAP, SPACE, ink(k, 0.95, 1, 1, 1), false, false);
      cx := fb.x0 + 12 * k + tw + 3 * k;
      if (cast(int) (s[0].time * 2)) % 2 == 0 && lit(out, n, cx, base, cx, base - tc, 0.6 * k, 0.9, 1.2 * k, 1, 1, 1, 0) { n += 6; }
    } else {
      n = draw_text(out, n, "TYPE YOUR SUGGESTION", fb.x0 + 12 * k, base, tc * 0.85, GAP, SPACE, ink(k, 0.5, DIM_R, DIM_G, DIM_B), false, false);
    }
    y = fb.y1;
  }
  if buttons > 0 {
    y += 14 * k;
    bx := x0 + 12 * k;
    for b: 0..<3 {
      label := STATION_BUTTON[i * 3 + b];
      if label.count == 0 { continue; }
      bs := 8.5 * k;
      bw := text_width(label, bs) + 32 * k;
      if bx + bw > x1 - 12 * k { bs = bs * (x1 - 12 * k - bx - 32 * k) / text_width(label, bs); bw = x1 - 12 * k - bx; }
      bb := Box.{x0 = bx, y0 = y, x1 = bx + bw, y1 = y + 40 * k};
      s[0].buttons[b] = bb;
      on := s[0].answer == i * 3 + b;
      plate(s, u, bb, 0.9, ifx on then 2.0f32 else 1.0f32);
      n = draw_text(out, n, label, bb.x0 + 16 * k, bb.y1 - 15 * k, bs, GAP, SPACE, ink(k, 0.95, INK_R, INK_G, INK_B), false, false);
      bx = bb.x1 + 10 * k;
    }
  }
  return n;
}

hud :: (s: [] TheGrid, out: [] f32, u: [] f32, move_on: bool, ox: f32, oy: f32, pad_x: f32, pad_y: f32, you: Point) -> int {
  k := hi(s[0].dpr, 0.5);
  w := s[0].width; h := s[0].height;
  n := ifx ready(s) then labels(s, out, u, 0, you) else 0;
  gutter := 16 * k;
  cap := 11 * k;
  title := "THE GRID";
  small := 7 * k;
  sub_line := where(you);
  tw := hi(text_width(title, cap), text_width(sub_line, small));
  plate(s, u, Box.{x0 = gutter, y0 = gutter, x1 = gutter + tw + 28 * k, y1 = gutter + cap + small + 34 * k}, 0.82, 0);
  n = draw_text(out, n, title, gutter + 14 * k, gutter + 12 * k + cap, cap, GAP, SPACE, ink(k, 0.95, INK_R, INK_G, INK_B), false, false);
  n = draw_text(out, n, sub_line, gutter + 14 * k, gutter + 22 * k + cap + small, small, GAP, SPACE, ink(k, 0.8, DIM_R, DIM_G, DIM_B), false, false);
  // GALAXY, top right: back to the galaxy.
  word := "GALAXY";
  bw := text_width(word, 9 * k) + 32 * k; bh := 38 * k;
  gb := Box.{x0 = w - gutter - bw, y0 = gutter, x1 = w - gutter, y1 = gutter + bh};
  s[0].galaxy_button = gb;
  plate(s, u, gb, 0.85, ifx s[0].pressed then 2.0f32 else 1.0f32);
  n = draw_text(out, n, word, gb.x0 + 16 * k, gb.y1 - 14 * k, 9 * k, GAP, SPACE, ink(k, 0.95, INK_R, INK_G, INK_B), false, false);
  s[0].open_button = Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0};
  for b: 0..<3 { s[0].buttons[b] = Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0}; }
  s[0].close_button = Box.{x0 = 0, y0 = 0, x1 = 0, y1 = 0};
  if s[0].panel >= 0 { return panel_view(s, out, u, n); }
  line := hint(s);
  hs := 7.5 * k;
  room := w - 2 * gutter - 24 * k;
  lw := text_width(line, hs);
  if lw > room { hs = hs * room / lw; lw = room; }
  y1 := h - gutter;
  plate(s, u, Box.{x0 = (w - lw) / 2 - 12 * k, y0 = y1 - hs - 20 * k, x1 = (w + lw) / 2 + 12 * k, y1 = y1}, 0.72, 0);
  n = draw_text(out, n, line, (w - lw) / 2, y1 - 10 * k, hs, GAP, SPACE, ink(k, 0.85, DIM_R, DIM_G, DIM_B), false, false);
  // A station near: E (or a tap on its name) opens it.
  if s[0].near >= 0 {
    ask := open_prompt(s);
    ts := 9 * k;
    aw := text_width(ask, ts) + 32 * k;
    if aw > w - 2 * gutter { ts = ts * (w - 2 * gutter) / aw; aw = w - 2 * gutter; }
    ob := Box.{x0 = (w - aw) / 2, y0 = y1 - hs - 76 * k, x1 = (w + aw) / 2, y1 = y1 - hs - 34 * k};
    s[0].open_button = ob;
    plate(s, u, ob, 0.85, ifx s[0].panel_finger >= 0 then 2.0f32 else 1.0f32);
    n = draw_text(out, n, ask, ob.x0 + 16 * k, ob.y1 - 15 * k, ts, GAP, SPACE, ink(k, 0.95, INK_R, INK_G, INK_B), false, false);
  }
  if move_on {
    r := 46 * k;
    for i: 0..<32 {
      a0 := f32(i) * f32(TAU) / 32; a1 := f32(i + 1) * f32(TAU) / 32;
      if lit(out, n, ox + cos(a0) * r, oy + sin(a0) * r, ox + cos(a1) * r, oy + sin(a1) * r, 0.8 * k, 0.5, 1.5 * k, DIM_R, DIM_G, DIM_B, 0) { n += 6; }
    }
    kx := ox + pad_x * r; ky := oy - pad_y * r;
    if lit(out, n, kx - 0.01, ky, kx + 0.01, ky, 14 * k, 0.8, 6 * k, INK_R, INK_G, INK_B, 0) { n += 6; }
  }
  return n;
}

// ---- the frame

thegrid_frame :: (s: [] TheGrid, out: [] f32, u: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool,
                  fx: f32, fy: f32, fz: f32, face: f32, act: int, vx: f32, vz: f32,
                  move_on: bool, ox: f32, oy: f32, pad_x: f32, pad_y: f32) -> int #export_c {
  if !s[0].started { thegrid_start(s); }
  if u.count < UNIFORM_FLOATS { return 0; }
  t := ifx finite(dt) then clamp(dt, 0, 0.25) else 0.0f32;
  s[0].time += f64(t);
  s[0].width = width; s[0].height = height; s[0].dpr = hi(dpr, 0.5);
  feet := v3(fx, fy, fz);
  if !finite3(feet) { feet = s[0].feet; }
  s[0].feet = feet; s[0].face = face; s[0].act = act;
  speed := sqrt(vx * vx + vz * vz);
  walking := finite(speed) && speed > 0.3;
  if walking { s[0].walk_time += t * speed / f32(WALK_SPEED); } else { s[0].idle_time += t; }

  // Through the Everglade gate: on to Everglade.
  if ready(s) && flat_gap(feet, v3(f32(GATE_X), 0, f32(GATE_Z))) < f32(GATE_R) { leave_to(s, EVERGLADE); }

  s[0].near = ifx s[0].panel >= 0 || !ready(s) then -1 else nearest_station(feet);

  shot := camera_frame(s, feet, vx, vz, t);

  s[0].plate_n = 0;
  for i: 0..<UNIFORM_FLOATS { u[i] = 0; }
  view(shot, width, height, u, U_VIEW);

  clock := ifx s[0].golden then 2.0f32 else f32(s[0].time);
  r := 1;
  if ready(s) {
    r = walk_patrols(s, clock);
    pose(s, r, f32(FOREMAN_X), f32(FOREMAN_Z), f32(FOREMAN_YAW), f32(FOREMAN_SCALE), CLIP_IDLE, ifx s[0].golden then 0.0f32 else f32(s[0].time));
    r += 1;
    pose(s, r, feet.x, feet.z, face, 1, ifx walking then CLIP_WALK else CLIP_IDLE, ifx walking then s[0].walk_time else s[0].idle_time);
    s[0].robots[r * ROBOT_FLOATS + 1] = feet.y;
    r += 1;
  }
  s[0].robot_n = r - 1;
  robots := cast(u32) s[0].robot_n;
  f := cast(u32) s[0].faces; al := cast(u32) (6 * s[0].art_lines); ri := cast(u32) s[0].robot_indices; rl := cast(u32) (6 * s[0].robot_lines);
  d := [16] u32.[0, f, 0, 1,  f, al, 0, 1,  f + al, ri, 1, robots,  f + al + ri, rl, 1, robots];
  for i: 0..<16 { s[0].draws[i] = d[i]; }

  u[0] = width; u[1] = height; u[2] = f32(s[0].time); u[3] = 1; u[4] = ifx still then 1.0f32 else 0.0f32;
  u[6] = s[0].dpr; u[7] = f32(s[0].robot_base);
  u[U_EYE] = shot.eye.x; u[U_EYE + 1] = shot.eye.y; u[U_EYE + 2] = shot.eye.z;
  u[U_EYE + 3] = f32(LINE_PX) * s[0].dpr;
  u[U_FIELD] = f32(FADE_NEAR); u[U_FIELD + 1] = f32(FADE_FAR); u[U_FIELD + 2] = f32(s[0].bones);

  n := hud(s, out, u, move_on && s[0].panel < 0, ox, oy, pad_x, pad_y, feet);
  u[5] = f32(s[0].plate_n);
  return n;
}

// ---- checks

DATA :: "AGRD";

// A small grid.data: 10 face vertices, 3 art lines, 2 robot lines, 6 robot
// indices from vertex 10, 4 bones, the three clips and two patrols.
put_word :: (out: [] u8, at: int, v: u32) -> int {
  for i: 0..<4 { out[at + i] = cast,trunc(u8) (v >> cast(u32) (i * 8)); }
  return at + 4;
}
put_real :: (out: [] u8, at: int, v: f32) -> int { return put_word(out, at, f32_bits(v)); }
fake_data :: (out: [] u8) -> int {
  for i: 0..<4 { out[i] = DATA[i]; }
  n := 4;
  head := [7] u32.[10, 3, 2, 6, 10, 4, 3];
  for i: 0..<7 { n = put_word(out, n, head[i]); }
  clips := [9] f32.[0, 32, 1.3333334, 32, 60, 2.5, 92, 24, 1];
  for c: 0..<3 { n = put_word(out, n, cast(u32) clips[c * 3]); n = put_word(out, n, cast(u32) clips[c * 3 + 1]); n = put_real(out, n, clips[c * 3 + 2]); }
  n = put_real(out, n, 1.5); n = put_real(out, n, 24); n = put_word(out, n, 2);
  // a robot walking +x from (13, 6), and one standing waving
  n = put_word(out, n, 48);
  for i: 0..<48 { n = put_real(out, n, 13 + f32(i) * 0.06); n = put_real(out, n, 6); n = put_real(out, n, 1.5707964); n = put_real(out, n, 0); n = put_real(out, n, f32(i) / 24); }
  n = put_word(out, n, 2);
  for i: 0..<2 { n = put_real(out, n, 11); n = put_real(out, n, -2); n = put_real(out, n, -2.2); n = put_real(out, n, 2); n = put_real(out, n, f32(i) / 24); }
  return n;
}

#test "a kept place on the Grid: open ground stays, a station or the gate's portal moves you clear" {
  g: [1] TheGrid;
  thegrid_start(g[..]);
  p := verse_place(-6, 0, -4, 1, 2, 0.4, 7, 0, -1, 1000);
  #assert thegrid_place_open(g[..], -6, -4);
  q := thegrid_place_fix(g[..], p);
  #assert q.x == -6 && q.z == -4 && q.yaw == 2;
  in_gate := thegrid_place_fix(g[..], verse_place(f32(GATE_X), 0, f32(GATE_Z), 0, 0, 0.3, 5, 0, -1, 1000));
  #assert flat_gap(v3(in_gate.x, 0, in_gate.z), v3(f32(GATE_X), 0, f32(GATE_Z))) >= f32(GATE_R) + 1.5;
  cx := (g[0].walls[0] + g[0].walls[3]) / 2; cz := (g[0].walls[2] + g[0].walls[5]) / 2;
  m := thegrid_place_fix(g[..], verse_place(cx, 0, cz, 0, 0, 0.3, 5, 0, -1, 1000));
  #assert thegrid_place_open(g[..], m.x, m.z);
  thegrid_place_camera(g[..], q);
  #assert g[0].orbit.yaw == 2 && g[0].orbit.want == 7 && g[0].feet.x == -6;
}

#test "the uniforms line up with thegrid.wgsl's" {
  #assert UNIFORM_FLOATS % 4 == 0 && U_PLATE == 32 && UNIFORM_FLOATS == 128;
  #assert ROBOT_FLOATS == 8 && SOLIDS <= WALLS;
}

#test "grid.data opens: its counts, clips and patrols; nothing draws until the GPU's four assets are in" {
  g: [1] TheGrid;
  b: [2048] u8;
  n := fake_data(b[..]);
  #assert thegrid_data(g[..], cast(string) b[0..<n]);
  #assert g[0].faces == 10 && g[0].art_lines == 3 && g[0].robot_base == 10 && g[0].bones == 4;
  #assert g[0].clip_n == 3 && g[0].clip_first[2] == 92 && g[0].clip_frames[1] == 60 && g[0].clip_length[0] > 1.33;
  #assert g[0].patrol_n == 2 && g[0].patrol_len[0] == 48 && g[0].patrol_at[1] == 48 && g[0].scale == 1.5;
  #assert thegrid_draws(g[..]) == 0 && hint(g[..]) == "THE GRID IS ON ITS WAY";
  for i: 0..<4 { thegrid_arrived(g[..], true); }
  #assert thegrid_draws(g[..]) == DRAWS;
  // a broken or cut file is refused and keeps nothing
  h: [1] TheGrid;
  #assert !thegrid_data(h[..], cast(string) b[0..<n - 30]) && h[0].failed && !h[0].data_ready && h[0].patrol_n == 0;
  #assert thegrid_draws(h[..]) == 0 && hint(h[..]) == "THE GRID DIDN'T LOAD · RELOAD THE PAGE TO TRY AGAIN";
  #assert !thegrid_data(h[..], "NOPE and more bytes than a header, so only the tag is wrong here");
}

#test "a frame draws the art, then every robot: the patrols, the Foreman and you" {
  g: [1] TheGrid;
  b: [2048] u8;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  n := fake_data(b[..]);
  ok := thegrid_data(g[..], cast(string) b[0..<n]);
  for i: 0..<4 { thegrid_arrived(g[..], true); }
  m := thegrid_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, 0, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert m > 0 && m <= MAX_VERTICES;
  #assert g[0].robot_n == 4;   // two patrol_count, the Foreman, you
  #assert g[0].draws[0] == 0 && g[0].draws[1] == 10 && g[0].draws[4] == 10 && g[0].draws[5] == 18;
  #assert g[0].draws[8] == 28 && g[0].draws[9] == 6 && g[0].draws[10] == 1 && g[0].draws[11] == 4;
  #assert g[0].draws[12] == 34 && g[0].draws[13] == 12 && g[0].draws[15] == 4;
  #assert thegrid_store_bytes(g[..]) == 5 * ROBOT_FLOATS * 4;
  // the walker walks its clip, between two of its frames; the Foreman stands three times as tall
  #assert g[0].robots[ROBOT_FLOATS + 4] == 1.5 && g[0].robots[ROBOT_FLOATS + 5] >= 0 && g[0].robots[ROBOT_FLOATS + 5] < 32;
  #assert g[0].robots[2 * ROBOT_FLOATS + 5] >= 92 && g[0].robots[2 * ROBOT_FLOATS + 5] < 116;
  #assert g[0].robots[3 * ROBOT_FLOATS + 4] == 3 && g[0].robots[3 * ROBOT_FLOATS] == 2.8;
  #assert g[0].robots[3 * ROBOT_FLOATS + 5] >= 32 && g[0].robots[3 * ROBOT_FLOATS + 5] < 92;
  // half a second on, the walker is 0.72 m further along +x
  for i: 0..<30 { m = thegrid_frame(g[..], out[..], u[..], 1280, 800, 1, 1.0 / 60.0, false, 0, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0); }
  #assert abs(g[0].robots[ROBOT_FLOATS] - (13 + 0.06 * 12.5)) < 0.05;
  // you, in front of the camera
  p := [4] f32.[0, 1, 0, 1];
  cw := 0.0f32; cx := 0.0f32; cy := 0.0f32;
  for i: 0..<4 { cx += u[U_VIEW + i] * p[i]; cy += u[U_VIEW + 4 + i] * p[i]; cw += u[U_VIEW + 12 + i] * p[i]; }
  #assert cw > 0 && abs(cx / cw) < 1 && abs(cy / cw) < 1;
  #assert u[U_EYE + 3] == 1.5 && u[U_FIELD + 2] == 4 && u[7] == 10;
}

#test "golden mode holds the robots at one moment" {
  g: [1] TheGrid;
  b: [2048] u8;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  n := fake_data(b[..]);
  ok := thegrid_data(g[..], cast(string) b[0..<n]);
  for i: 0..<4 { thegrid_arrived(g[..], true); }
  thegrid_golden(g[..], true);
  m := thegrid_frame(g[..], out[..], u[..], 1280, 800, 1, 0.1, false, 0, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  x := g[0].robots[ROBOT_FLOATS];
  for i: 0..<10 { m = thegrid_frame(g[..], out[..], u[..], 1280, 800, 1, 0.1, false, 0, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0); }
  #assert g[0].robots[ROBOT_FLOATS] == x;
}

#test "the Everglade gate goes to Everglade; GALAXY, pressed and lifted on it, to the galaxy" {
  g: [1] TheGrid;
  b: [2048] u8;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  n := fake_data(b[..]);
  ok := thegrid_data(g[..], cast(string) b[0..<n]);
  for i: 0..<4 { thegrid_arrived(g[..], true); }
  m := thegrid_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 0, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert thegrid_action(g[..]) == 0;
  gb := g[0].galaxy_button;
  #assert gb.x1 > gb.x0 && gb.x1 <= 1280;
  #assert thegrid_pointer(g[..], (gb.x0 + gb.x1) / 2, (gb.y0 + gb.y1) / 2, 0, 0, 1) && g[0].pressed && !g[0].drag_on;
  #assert thegrid_pointer(g[..], (gb.x0 + gb.x1) / 2, (gb.y0 + gb.y1) / 2, 2, 0, 1) && !g[0].pressed;
  #assert thegrid_action(g[..]) == ACT_NAVIGATE && cast(string) g[0].outbox[0..<g[0].out_n] == GALAXY;
  thegrid_action_done(g[..]);
  // pressed and dragged off, it doesn't go; a drag elsewhere turns the camera
  #assert thegrid_pointer(g[..], gb.x0 + 2, gb.y0 + 2, 0, 0, 2);
  #assert thegrid_pointer(g[..], 300, 500, 2, 0, 2) && thegrid_action(g[..]) == 0;
  #assert thegrid_pointer(g[..], 600, 400, 0, 0, 3) && g[0].drag_on;
  #assert !thegrid_pointer(g[..], 300, 500, 0, 1, 4);
  m = thegrid_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 9.2, 0, 1.1, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert thegrid_action(g[..]) == ACT_NAVIGATE && cast(string) g[0].outbox[0..<g[0].out_n] == EVERGLADE;
}

#test "walk up to a station and press E: its panel opens, its buttons answer or go, Esc closes" {
  g: [1] TheGrid;
  b: [2048] u8;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  n := fake_data(b[..]);
  ok := thegrid_data(g[..], cast(string) b[0..<n]);
  for i: 0..<4 { thegrid_arrived(g[..], true); }
  // at the start nothing is near enough
  m := thegrid_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 0, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].near == -1 && !thegrid_key(g[..], 'e', 0);
  // by the help desk
  m = thegrid_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, -6, 0, -3.6, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].near == STATION_GUIDE && open_prompt(g[..]) == "E · ASK THE GRID GUIDE";
  #assert g[0].open_button.x1 > g[0].open_button.x0;
  #assert thegrid_key(g[..], 'E', 0) && g[0].panel == STATION_GUIDE && thegrid_busy(g[..]) && !thegrid_wants_text(g[..]);
  m = thegrid_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, -6, 0, -3.6, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  #assert m > 0 && g[0].plate_n <= PLATES && g[0].near == -1;
  for k: 0..<3 { #assert g[0].buttons[k].x1 > g[0].buttons[k].x0 && g[0].buttons[k].x1 <= 1280; }
  // W types nothing and walks nowhere; 2 answers where things are
  #assert thegrid_key(g[..], 'w', 0) && g[0].held == 0;
  #assert thegrid_key(g[..], '2', 0) && g[0].answer == STATION_GUIDE * 3 + 1;
  // a click on WHAT IS THIS?
  bb := g[0].buttons[2];
  #assert thegrid_pointer(g[..], bb.x0 + 3, bb.y0 + 3, 0, 0, 1) && thegrid_pointer(g[..], bb.x0 + 3, bb.y0 + 3, 2, 0, 1);
  #assert g[0].answer == STATION_GUIDE * 3 + 2 && thegrid_action(g[..]) == 0;
  #assert thegrid_key(g[..], KEY_ESCAPE, 0) && g[0].panel == -1 && !thegrid_busy(g[..]);
  // the build board goes to the Verse project's page
  m = thegrid_frame(g[..], out[..], u[..], 1280, 800, 1, 0.016, false, 30, 0, -5.4, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].near == STATION_BUILDS && thegrid_key(g[..], 'e', 0);
  #assert thegrid_key(g[..], KEY_ENTER, 0) && thegrid_action(g[..]) == ACT_NAVIGATE && cast(string) g[0].outbox[0..<g[0].out_n] == "/projects/verse";
  thegrid_action_done(g[..]);
  // every station's links are the site's own pages, and every button does something
  for i: 0..<STATIONS {
    #assert STATION_TITLE[i].count > 0 && STATION_TEXT[i].count > 0 && STATION_PROMPT[i].count > 0;
    for k: 0..<3 {
      d := STATION_DOES[i * 3 + k];
      #assert (STATION_BUTTON[i * 3 + k].count > 0) == (d != BUTTON_NONE);
      if d == BUTTON_LINK { #assert STATION_WHAT[i * 3 + k][0] == '/'; }
      if d == BUTTON_ANSWER { #assert STATION_WHAT[i * 3 + k].count > 20; }
    }
  }
}

#test "the suggestion box: type, SEND, and it goes to the site's feedback; a failure keeps what you typed" {
  g: [1] TheGrid;
  b: [2048] u8;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  u: [UNIFORM_FLOATS] f32;
  n := fake_data(b[..]);
  ok := thegrid_data(g[..], cast(string) b[0..<n]);
  for i: 0..<4 { thegrid_arrived(g[..], true); }
  thegrid_message(g[..], MSG_FACTS, "tab=t\nvisitor=v-1\nnow=1730000000000\nplayer=p-4\n");
  g[0].touch = true;
  m := thegrid_frame(g[..], out[..], u[..], 1170, 2532, 3, 0.016, false, 12, 0, -8.6, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].near == STATION_SUGGEST && open_prompt(g[..]) == "LEAVE A SUGGESTION";
  ob := g[0].open_button;
  #assert thegrid_pointer(g[..], (ob.x0 + ob.x1) / 2, (ob.y0 + ob.y1) / 2, 0, 1, 5);
  #assert thegrid_pointer(g[..], (ob.x0 + ob.x1) / 2, (ob.y0 + ob.y1) / 2, 2, 1, 5) && g[0].panel == STATION_SUGGEST;
  #assert thegrid_wants_text(g[..]);
  m = thegrid_frame(g[..], out[..], u[..], 1170, 2532, 3, 0.016, false, 12, 0, -8.6, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  #assert g[0].field[2] > 0 && g[0].field[1] + g[0].field[3] <= 2532;
  // nothing typed: SEND sends nothing
  #assert thegrid_key(g[..], KEY_ENTER, 0) && thegrid_post(g[..]) == 0;
  for c: "More \"lamps\"" { #assert thegrid_key(g[..], cast(int) c, 0); }
  #assert thegrid_key(g[..], KEY_BACKSPACE, 0) && typed_text(g[..]) == "More \"lamps";
  #assert thegrid_key(g[..], '!', 0);
  sb := g[0].buttons[0];
  #assert thegrid_pointer(g[..], sb.x0 + 3, sb.y0 + 3, 0, 1, 6) && thegrid_pointer(g[..], sb.x0 + 3, sb.y0 + 3, 2, 1, 6);
  body := cast(string) g[0].post[0..<thegrid_post(g[..])];
  #assert g[0].sent == SENT_SENDING && !thegrid_wants_text(g[..]);
  #assert body[0..<8] == "{\"rid\":\"" && body[24..<body.count] == "\",\"q\":\"grid_suggestion\",\"a\":\"More \\\"lamps!\",\"player\":\"p-4\"}";
  for k: 8..<24 { #assert (body[k] >= '0' && body[k] <= '9') || (body[k] >= 'a' && body[k] <= 'f'); }
  thegrid_post_sent(g[..]);
  // it didn't go: what you typed stays, and SEND tries again
  thegrid_post_answer(g[..], "0\n");
  #assert g[0].sent == SENT_FAILED && typed_text(g[..]) == "More \"lamps!";
  #assert thegrid_key(g[..], KEY_ENTER, 0) && thegrid_post(g[..]) > 0;
  thegrid_post_sent(g[..]);
  thegrid_post_answer(g[..], "200\n{\"saved\":true}");
  #assert g[0].sent == SENT_OK && g[0].typed_n == 0;
  m = thegrid_frame(g[..], out[..], u[..], 1170, 2532, 3, 0.016, false, 12, 0, -8.6, 3.14, 0, 0, 0, false, 0, 0, 0, 0);
  cb := g[0].close_button;
  #assert thegrid_pointer(g[..], cb.x0 + 2, cb.y0 + 2, 0, 1, 7) && thegrid_pointer(g[..], cb.x0 + 2, cb.y0 + 2, 2, 1, 7) && g[0].panel == -1;
}

#test "the stations and the gym are walls; the hint and names fit a phone" {
  g: [1] TheGrid;
  #assert thegrid_walls(g[..]) == SOLIDS;
  // the terminal stands 4 m ahead of the start, across your way
  #assert g[0].walls[5 * 6] < 0 && g[0].walls[5 * 6 + 3] > 0 && g[0].walls[5 * 6 + 2] == 3.5;
  g[0].touch = true;
  for i: 0..<4 { thegrid_arrived(g[..], true); }
  #assert text_width(hint(g[..]), 6.5 * 3) < 1170 - 96;
  #assert where(v3(0, 0, 1)) == "PYLON TERMINAL" && where(v3(100, 0, 100)) == "WALK UP TO A PLACE TO SEE ITS NAME";
  #assert where(v3(9, 0, 0)) == "TO EVERGLADE";
}
