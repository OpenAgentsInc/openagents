 s:[1]ValleyCanyon;u:[CANYON_UNIFORMS]f32;out:[CANYON_HUD]f32;s[0].portrait=true;_:=canyon_frame(s[..],out[..],u[..],1280,800,1);#assert u[2]>0;
 #assert canyon_key(s[..],71) && s[0].blonde;_=canyon_frame(s[..],out[..],u[..],1280,800,1);#assert u[2]<0;
 b:=canyon_hair_box(1280,800);#assert canyon_pointer(s[..],b.x+4,b.y+4,0) && !s[0].blonde;
 s[0].portrait=false;off:=canyon_pointer(s[..],b.x+4,b.y+4,0);#assert off && !s[0].blonde;
}
