// The face views use the TF0290 hero frame's lights and skin profile, moved with Echo,
// through a longer lens from farther back so the face is not widened by perspective.
CANYON_FACE_DISTANCE :: 1.58;
CANYON_FACE_LENS :: 4.2;
#test "Face views reuse the Slay hero lighting at Echo's position without the letterbox" #steps 1000000000 {
 s:[1]ValleyCanyon;names:[64]u8;shot_fixture(s[0].shot[0].data[0..<620],names[..]);s[0].shot[0].bytes=620;s[0].shot[0].ready=true;s[0].shot[0].frame=7;
 #assert canyon_key(s[..],72) && s[0].closeup;u:[CANYON_UNIFORMS]f32;out:[CANYON_HUD*12]f32;_:=canyon_frame(s[..],out[..],u[..],1280,800,1);
 feet:=pc.walk_feet(s[0].you);#assert u[112]==1 && u[113]<0.001 && u[15]==CANYON_FACE_LENS && s[0].shot[0].frame==7;
 s[0].shot[0].frame=124;hero:=slay_shot_meta(s[0].shot[..],19);s[0].shot[0].frame=7;#assert abs(u[116]-feet.x-hero)<0.0001;
 #assert canyon_key(s[..],67) && !s[0].closeup;_=canyon_frame(s[..],out[..],u[..],1280,800,1);#assert u[112]==0;
}
canyon_face_lighting :: (s:[]ValleyCanyon,u:[]f32,at:Point) {
 q:=s[0].shot[..];keep:=q[0].frame;q[0].frame=124;
 // Turn the hero rig about the vertical so it sits where it did relative to the shot camera:
 // the shot camera's heading maps onto the face camera's, which looks down -z.
 turn:=canyon_face_turn(slay_shot_meta(q,9),slay_shot_meta(q,11));c:=turn.x;sn:=turn.y;
 for k:0..<4 {base:=[4]int.[14,24,39,51][k];v:=canyon_yaw(v3(slay_shot_meta(q,base),slay_shot_meta(q,base+1),slay_shot_meta(q,base+2)),c,sn);slot:=[4]int.[97,24,28,0][k];
  if k<3 {canyon_uniform_point(u,slot,v);} else {u[11]=slay_oct_x(v.x,v.y,v.z);u[127]=slay_oct_y(v.x,v.y,v.z);}}
 for k:0..<3 {u[120+k]=slay_shot_meta(q,27+k);}
 u[116]=slay_shot_meta(q,19)+at.x;u[117]=slay_shot_meta(q,20)+at.y;u[118]=slay_shot_meta(q,21)+at.z;
 u[112]=1;u[113]=0.0001;u[115]=slay_shot_meta(q,18);u[114]=slay_shot_meta(q,23);u[119]=pc.atan2(sn,c);u[123]=slay_shot_meta(q,42);u[31]=slay_shot_meta(q,43);
 u[124]=0.25015828;u[125]=0.61049557;u[126]=1;
 // The orb Rect Light keeps its hero-frame offset from the head, turned with the rig.
 rect:=canyon_yaw(v3(slay_shot_meta(q,44)-slay_shot_meta(q,36),slay_shot_meta(q,45)-slay_shot_meta(q,37),slay_shot_meta(q,46)-slay_shot_meta(q,38)),c,sn);
 u[83]=at.x+rect.x;u[87]=at.y+CANYON_FACE_HEAD+rect.y;u[91]=at.z+rect.z;u[23]=slay_shot_meta(q,47);u[27]=slay_shot_meta(q,48);u[95]=slay_shot_meta(q,49);u[107]=slay_shot_meta(q,50);q[0].frame=keep;
 l:=unit_or(v3(u[24],u[25],u[26]),v3(0,1,0));r:=unit_or(cross(v3(0,1,0),l),v3(1,0,0));canyon_uniform_point(u,80,r);canyon_uniform_point(u,84,cross(l,r));canyon_uniform_point(u,88,l);canyon_uniform_point(u,92,v3(at.x,at.y+1.4,at.z));u[96]=0.6;
}
// The face camera's target height above the feet, where the head sits in the walk pose.
CANYON_FACE_HEAD :: 1.6;
canyon_yaw :: (v:Point,c:f32,s:f32)->Point {return v3(c*v.x+s*v.z,v.y,-s*v.x+c*v.z);}
// Cosine and sine of the turn that takes a camera heading (x,z) onto the face camera's -z.
canyon_face_turn :: (hx:f32,hz:f32)->Point {h:=sqrt(hx*hx+hz*hz);if h<0.000001 {return v3(1,0,0);}return v3(-hz/h,hx/h,0);}
#test "The face view turns the hero rig so the shot camera's heading becomes the face camera's" {
 for d:[4]Point.[v3(0.8,-0.3,0.6),v3(-1,0.2,0),v3(0,0,1),v3(0.3,0,-0.4)] {t:=canyon_face_turn(d.x,d.z);r:=canyon_yaw(d,t.x,t.y);h:=sqrt(d.x*d.x+d.z*d.z);#assert abs(r.x)<0.00001 && abs(r.z+h)<0.00001 && r.y==d.y;}
 t:=canyon_face_turn(0,0);#assert t.x==1 && t.y==0;
}
// The orb Rect Light (shot meta 44..50) goes into the shader's free slots 83/87/91 (position),
// 23/27/95 (colour x candelas), 107 (attenuation radius) and 11/127 (octahedral aim).
canyon_rect_light :: (u:[]f32,q:[]SlayShot,at:Point) {
 u[83]=slay_shot_meta(q,44)+at.x;u[87]=slay_shot_meta(q,45)+at.y;u[91]=slay_shot_meta(q,46)+at.z;
 u[23]=slay_shot_meta(q,47);u[27]=slay_shot_meta(q,48);u[95]=slay_shot_meta(q,49);u[107]=slay_shot_meta(q,50);
 x:=slay_shot_meta(q,51);y:=slay_shot_meta(q,52);z:=slay_shot_meta(q,53);u[11]=slay_oct_x(x,y,z);u[127]=slay_oct_y(x,y,z);
}
canyon_shot_last :: (s:[]ValleyCanyon)->f32 {if !s[0].shot[0].ready {return 0;}return cast(f32)(shot_info(s[0].shot[0].data[0..<s[0].shot[0].bytes]).frames-1);}
canyon_shot_replay :: (s:[]ValleyCanyon) {if !s[0].shot[0].ready {return;}s[0].shot[0].frame=0;s[0].shot[0].playing=true;slay_shot_present(s[0].shot[..],s[0].echo[..],s[0].pack[..]);}
canyon_replay_box :: (w:f32,h:f32)->HudBox {return HudBox.{x=w-176,y=h-140,width=160,height=44};}
// G or the HAIR button swaps Echo's source brown groom for the sample's blonde hair colours.
// Echo's head height on screen in CSS pixels, from the frame's camera (u[8..22], u[19]).
canyon_head_pixels :: (s:[]ValleyCanyon,u:[]f32,css_height:f32)->f32 {
 head:=ifx s[0].source_shot && s[0].shot[0].ready then v3(u[92],u[93],u[94]) else v3(u[104],u[105]+CANYON_FACE_HEAD,u[106]);
 z:=dot(sub(head,v3(u[8],u[9],u[10])),v3(u[20],u[21],u[22]));if z<=0.05 {return 100000;}return 0.25*u[19]/z*css_height*0.5;
}
// Share of hair strands drawn, falling with the head's on-screen area below 300 pixels (the strands
// per pixel stay about the same), never under 2%. Close views draw half: strands are under a pixel
// wide even there, half of them at twice the coverage look the same, and all of them held the face
// view and the shot near 20 fps.
CANYON_HAIR_FULL_PIXELS :: 300.0;
CANYON_HAIR_MAX_SHARE :: 0.5;
canyon_hair_share :: (head:f32)->f32 {r:=head/CANYON_HAIR_FULL_PIXELS;return clamp(r*r,0.02,CANYON_HAIR_MAX_SHARE);}
canyon_hair_box :: (w:f32,h:f32)->HudBox {return HudBox.{x=w-176,y=h-192,width=160,height=44};}
canyon_shows_echo :: (s:[]ValleyCanyon)->bool {return s[0].portrait || s[0].source_shot;}
canyon_key :: (s:[]ValleyCanyon,key:int)->bool #export_c #effects(all) {
  if key==71 || key==103 {s[0].blonde=!s[0].blonde;return true;}
  if key==74 || key==106 {if !s[0].shot[0].ready {return true;}canyon_blur(s);s[0].portrait=true;s[0].performance=false;s[0].source_shot=true;s[0].shot[0].frame=124;s[0].shot[0].playing=false;slay_shot_present(s[0].shot[..],s[0].echo[..],s[0].pack[..]);return true;}
  if key==77 || key==109 {if !s[0].shot[0].ready {return true;}canyon_spell_start(s);return true;}
  if s[0].source_shot && s[0].spell {
   if key==84 || key==116 {canyon_spell_start(s);return true;}
   if key==80 || key==112 {if !s[0].shot[0].playing && s[0].spell_t>=SPELL_SECONDS {canyon_spell_start(s);return true;}s[0].shot[0].playing=!s[0].shot[0].playing;return true;}
   if key==44 || key==46 {s[0].shot[0].playing=false;s[0].spell_t=pc.lo(SPELL_SECONDS,pc.hi(0,s[0].spell_t+(ifx key==46 then 1.0f32 else -1.0f32)/24));s[0].shot[0].frame=canyon_spell_frame(s);slay_shot_present(s[0].shot[..],s[0].echo[..],s[0].pack[..]);return true;}
  }
  if s[0].source_shot {if key==84 || key==116 {canyon_shot_replay(s);return true;}if key==80 || key==112 {if !s[0].shot[0].playing && s[0].shot[0].frame>=canyon_shot_last(s) {canyon_shot_replay(s);return true;}s[0].shot[0].playing=!s[0].shot[0].playing;return true;}if key==44 || key==46 {s[0].shot[0].playing=false;s[0].shot[0].frame=pc.lo(199,pc.hi(0,s[0].shot[0].frame+(ifx key==46 then 1.0f32 else -1.0f32)));slay_shot_present(s[0].shot[..],s[0].echo[..],s[0].pack[..]);return true;}}
  if key==70 || key==102 {s[0].source_shot=false;canyon_blur(s);s[0].portrait=true;s[0].closeup=true;s[0].performance=true;canyon_echo_restart(s);canyon_face_select(s,4);return true;}
  if s[0].performance {
   if key==91 || key==93 {clip:=(s[0].echo[0].face[0].clip+(ifx key==93 then 1 else 19))%20;canyon_face_select(s,clip);return true;}
   if key==80 || key==112 {s[0].echo[0].face[0].playing=!s[0].echo[0].face[0].playing;return true;}
   if key==84 || key==116 {canyon_face_select(s,s[0].echo[0].face[0].clip);return true;}
   if key==66 || key==98 {s[0].echo[0].face[0].enabled=!s[0].echo[0].face[0].enabled;character_present(s[0].echo[..],s[0].pack[..]);return true;}
   if key==44 || key==46 {e:=s[0].echo[..];if character_has_face(e,s[0].pack[..]) {b:=character_face_bytes(e,s[0].pack[..]);f:=face_info(b);rate:=face_float(b,f.clip_table+e[0].face[0].clip*80+68);e[0].face[0].playing=false;e[0].face[0].time=pc.lo(e[0].face[0].end,pc.hi(0,e[0].face[0].time+(ifx key==46 then 1.0f32 else -1.0f32)/rate));e[0].face[0].age=0.15;character_face_clock(e,s[0].pack[..],0);}return true;}
  }
  if key==72 || key==104 {s[0].source_shot=false;s[0].performance=false;canyon_blur(s);s[0].portrait=true;s[0].closeup=!s[0].closeup;canyon_echo_restart(s);return true;}if key==67 || key==99 {s[0].performance=false;s[0].closeup=false;canyon_blur(s);s[0].portrait=!s[0].portrait;canyon_echo_restart(s);return true;}if key==79 || key==111 {s[0].walking=!s[0].walking;canyon_blur(s);return true;}if key==118 || key==86 {s[0].mode=(s[0].mode+1)%5;return true;}if key==105 || key==73 {s[0].solo=(s[0].solo+1)%3;return true;}
  if key==114 || key==82 {canyon_blur(s);s[0].started=false;canyon_start(s);canyon_echo_restart(s);s[0].orbit=0.65;s[0].tilt=0.12;s[0].distance=14;s[0].portrait=false;s[0].closeup=false;s[0].performance=false;s[0].source_shot=false;s[0].face_cycle=0;s[0].mode=0;s[0].solo=2;return true;}
  if key==49 || key==27 {url:="/worlds/valley-lab";for c,k:url {s[0].outbox[k]=c;}s[0].out_n=url.count;s[0].action=1;return true;}return false;
}
// Mouse drag uses the Grid's look convention; touch is the same shared Sticks controller as the parent lab.
canyon_pointer :: (s:[]ValleyCanyon,x:f32,y:f32,phase:int)->bool {return canyon_pointer_event(s,x,y,phase,1,0);}
canyon_pointer_event :: (s:[]ValleyCanyon,x:f32,y:f32,phase:int,kind:int,id:int)->bool #export_c #effects(all) {
 if phase==0 && canyon_shows_echo(s) {b:=canyon_hair_box(s[0].width/s[0].d,s[0].height/s[0].d);if x/s[0].d>=b.x && x/s[0].d<=b.x+b.width && y/s[0].d>=b.y && y/s[0].d<=b.y+b.height {s[0].blonde=!s[0].blonde;return true;}}
 if phase==0 && s[0].source_shot {b:=canyon_replay_box(s[0].width/s[0].d,s[0].height/s[0].d);if x/s[0].d>=b.x && x/s[0].d<=b.x+b.width && y/s[0].d>=b.y && y/s[0].d<=b.y+b.height {canyon_shot_replay(s);return true;}}
 if phase==0 {cx:=x/s[0].d;cy:=y/s[0].d;if cy<80 {if s[0].walking && cy>=48 && cx>s[0].width/s[0].d*0.4 && cx<s[0].width/s[0].d*0.6 {_:=canyon_hold(s,32,true);_=canyon_hold(s,32,false);return true;}if cy<48 && cx>s[0].width/s[0].d-110 {_:=canyon_key(s,79);return true;}if cx<160 {_:=canyon_key(s,49);}else {_:=canyon_key(s,82);}return true;}
  if cy>s[0].height/s[0].d-90 {if cx<s[0].width/s[0].d*0.5 {_:=canyon_key(s,86);}else {_:=canyon_key(s,73);}return true;}
 }
 if s[0].walking && kind!=0 {slot:= -1;for k:0..<4 {if s[0].active[k] && s[0].ids[k]==id {slot=k;}}if phase==0 {for k:0..<4 {if !s[0].active[k] {slot=k;break;}}if slot<0 {return false;}s[0].active[slot]=true;s[0].ids[slot]=id;}if slot<0 {return false;}
  s[0].thumbs=sticks_touch(s[0].thumbs,slot,phase,x,y,s[0].width,s[0].height,s[0].d,s[0].now,false);if phase>=2 {s[0].active[slot]=false;}return true;
 }
 if phase==0 {s[0].drag=true;s[0].drag_id=id;s[0].x=x;s[0].y=y;return true;}if !s[0].drag || s[0].drag_id!=id {return false;}
 if phase==1 {dx:=(x-s[0].x)/s[0].d*STICKS_LOOK;dy:=(y-s[0].y)/s[0].d*STICKS_LOOK;if s[0].walking {s[0].look_x-=dx;s[0].look_y-=dy;}else {s[0].orbit-=dx;s[0].tilt=clamp(s[0].tilt+dy,-0.7,1.3);}s[0].x=x;s[0].y=y;}if phase>=2 {s[0].drag=false;}return true;
}
canyon_wheel :: (s:[]ValleyCanyon,dy:f32) #export_c #effects(all) {if s[0].walking {s[0].you=pc.walk_zoom(s[0].you,dy*0.01);}else {s[0].distance=clamp(s[0].distance+dy*0.01,2,80);}}
canyon_uniform_point :: (u:[]f32,at:int,p:Point) {u[at]=p.x;u[at+1]=p.y;u[at+2]=p.z;}
#test "Canyon source frames fit declared budget at desktop phone and high DPR" #steps 1000000000 {
  s:[1]ValleyCanyon;s[0].pack_verified=true;out:[CANYON_HUD*12]f32;u:[CANYON_UNIFORMS]f32;size:=echo_rig_fixture(s[0].pack[0].data[..],1);canyon_asset(s[..],0,size);canyon_asset(s[..],1,187564308);canyon_asset(s[..],2,73674948);canyon_asset(s[..],3,35);
  for screen:0..<3 {for mode:0..<5 {s[0].mode=mode;n:=canyon_frame(s[..],out[..],u[..],[3]f32.[1280,390,1170][screen],[3]f32.[800,844,2532][screen],[3]f32.[1,1,3][screen]);#assert n>0 && n<CANYON_HUD && budget_ok(s[0].meter[0]) && s[0].draws[1]==2999985 && s[0].draws[3]==2;}}
}
// The frame's uniform floats: 0..127 the scene and lights, 128..130 the shot's lens.
CANYON_UNIFORMS :: 136;
// The spell orbit (M): the film's cut of TF0290 (source frames 1126 to 1152, TF_Edit's 125-frame
// offset) in slow motion, from the cut's own close-up, while the camera pulls back and turns once
// around her head. Frames past the cut are unfinished handles (the jaw hangs open), so it stays inside.
SPELL_FROM :: 125.0f32;
SPELL_TO :: 151.0f32;
SPELL_SECONDS :: 7.0f32;
SPELL_PULL :: 2.6f32;
SPELL_DROP :: 0.22f32;
SPELL_RISE :: 0.12f32;
SpellCamera :: struct {eye:Point;at:Point;}
spell_ease :: (p:f32)->f32 {q:=clamp(p,0,1);return q*q*(3-2*q);}
spell_camera :: (eye0:Point,look0:Point,head0:Point,head:Point,p:f32)->SpellCamera {
 // Pull back first so the turn clears her arms, then turn: her back faces the camera mid-clip.
 e:=spell_ease(p);pull:=spell_ease(p*2.5);turn:=spell_ease((p-0.2)/0.8);o:=sub(eye0,head0);r0:=sqrt(dot(o,o));flat:=sqrt(o.x*o.x+o.z*o.z);
 yaw:=pc.atan2(o.x,o.z)+6.2831853*turn;pitch:=pc.atan2(o.y,flat)+SPELL_RISE*e;r:=r0*(1+(SPELL_PULL-1)*pull);
 pivot:=add(head,v3(0,-SPELL_DROP*e,0));eye:=add(pivot,v3(sin(yaw)*cos(pitch)*r,sin(pitch)*r,cos(yaw)*cos(pitch)*r));
 // The shot's own aim at the start, handed over to the pivot in the first third.
 k:=spell_ease(p*3);start:=add(head,sub(look0,head0));at:=add(times(start,1-k),times(pivot,k));
 return SpellCamera.{eye=eye,at=at};
}
#test "The spell orbit starts on the shot camera, turns once and ends pulled back" {
 eye0:=v3(0.1,1.6,0.6);head0:=v3(0,1.55,0);look0:=v3(0.02,1.52,0);
 c:=spell_camera(eye0,look0,head0,head0,0);#assert abs(c.eye.x-0.1)<0.0001 && abs(c.eye.y-1.6)<0.0001 && abs(c.eye.z-0.6)<0.0001 && abs(c.at.x-0.02)<0.0001;
 h:=spell_camera(eye0,look0,head0,head0,0.5);#assert h.eye.z<0;
 e:=spell_camera(eye0,look0,head0,head0,1);d:=sub(e.eye,e.at);o:=sub(eye0,head0);#assert abs(sqrt(dot(d,d))-SPELL_PULL*sqrt(dot(o,o)))<0.001 && e.eye.z>0 && abs(e.at.y-(1.55-SPELL_DROP))<0.0001;
}
canyon_spell_frame :: (s:[]ValleyCanyon)->f32 {return SPELL_FROM+(SPELL_TO-SPELL_FROM)*clamp(s[0].spell_t/SPELL_SECONDS,0,1);}
canyon_spell_start :: (s:[]ValleyCanyon) {
 q:=s[0].shot[..];canyon_blur(s);s[0].portrait=true;s[0].performance=false;s[0].source_shot=true;q[0].frame=SPELL_FROM;q[0].playing=true;
 s[0].spell_eye=v3(slay_shot_meta(q,0),slay_shot_meta(q,1),slay_shot_meta(q,2));s[0].spell_head=v3(slay_shot_meta(q,36),slay_shot_meta(q,37),slay_shot_meta(q,38));
 o:=sub(s[0].spell_head,s[0].spell_eye);fw:=v3(slay_shot_meta(q,9),slay_shot_meta(q,10),slay_shot_meta(q,11));s[0].spell_look=add(s[0].spell_eye,times(fw,sqrt(dot(o,o))));
 s[0].spell_lens=slay_shot_meta(q,12);s[0].spell=true;s[0].spell_t=0;slay_shot_present(q,s[0].echo[..],s[0].pack[..]);
}
// TF0290's filmback width in metres (24.89 mm).
SLAY_SENSOR_WIDTH :: 0.02489f32;
canyon_frame :: (s:[]ValleyCanyon,out:[]f32,u:[]f32,w:f32,h:f32,d:f32)->int #export_c #effects(all) {
  if !(w>0 && h>0 && d>0) {return 0;}u[128]=0;u[129]=0;u[130]=0;s[0].width=w;s[0].height=h;s[0].d=d;s[0].ready=true;canyon_start(s);bounds:=canyon_bounds();target:=times(add(bounds.low,bounds.high),0.5);
  eye:=add(target,v3(sin(s[0].orbit)*cos(s[0].tilt)*s[0].distance,sin(s[0].tilt)*s[0].distance,cos(s[0].orbit)*cos(s[0].tilt)*s[0].distance));
  if s[0].walking {feet:=pc.walk_feet(s[0].you);shot:=pc.walk_shot(s[0].you);eye=v3(shot.eye.x,shot.eye.y,shot.eye.z);target=v3(shot.at.x,shot.at.y,shot.at.z);}if s[0].portrait {feet:=pc.walk_feet(s[0].you);eye=v3(feet.x,feet.y+1.2,feet.z+2.2);target=v3(feet.x,feet.y+1.1,feet.z);if s[0].closeup {eye=v3(feet.x,feet.y+1.65,feet.z+CANYON_FACE_DISTANCE);target=v3(feet.x,feet.y+CANYON_FACE_HEAD,feet.z);}}s[0].eye=eye;
  forward:=unit_or(sub(target,eye),v3(0,0,-1));right:=unit_or(cross(forward,v3(0,1,0)),v3(1,0,0));up:=cross(right,forward);
  for k:0..<128 {u[k]=0;}u[0]=w;u[1]=h;u[3]=1;u[4]=cast(f32)s[0].mode;u[6]=1.5;u[7]=ifx s[0].walking then 1.0f32 else 0.0f32;u[100]=canyon_ground();
  canyon_uniform_point(u,8,eye);canyon_uniform_point(u,12,right);u[15]=ifx w<h then 1.7f32 else 1.7f32*h/w;
  canyon_uniform_point(u,16,up);u[19]=ifx w<h then 1.7f32*w/h else 1.7f32;canyon_uniform_point(u,20,forward);
  if s[0].walking {u[15]=1;u[19]=w/h;}
  u[111]=ifx s[0].echo[0].face[0].enabled && s[0].echo[0].face[0].fade>0 then 1.0f32 else 0.0f32;feet:=pc.walk_feet(s[0].you);canyon_uniform_point(u,104,v3(feet.x,feet.y-0.01,feet.z));u[108]=cos(pc.walk_face(s[0].you));u[109]=sin(pc.walk_face(s[0].you));if s[0].portrait {u[108]=1;u[109]=0;u[110]=1;u[7]=0;u[15]=1.7320508;u[19]=1.7320508*w/h;if s[0].closeup {u[15]=CANYON_FACE_LENS;u[19]=CANYON_FACE_LENS*w/h;}}
  canyon_uniform_point(u,24,unit_or(v3(-0.4,0.8,0.45),v3(0,1,0)));
  light:=unit_or(v3(-0.4,0.8,0.45),v3(0,1,0));lr:=unit_or(cross(v3(0,1,0),light),v3(1,0,0));lu:=cross(light,lr);canyon_uniform_point(u,80,lr);canyon_uniform_point(u,84,lu);canyon_uniform_point(u,88,light);canyon_uniform_point(u,92,times(add(bounds.low,bounds.high),0.5));u[96]=16;
  if s[0].portrait {canyon_uniform_point(u,92,v3(feet.x,feet.y+1,feet.z));u[96]=1.1;}
  if s[0].source_shot && s[0].shot[0].ready {
   q:=s[0].shot[..];for k:0..<12 {u[8+(k/3)*4+k%3]=slay_shot_meta(q,k);}s[0].eye=v3(u[8],u[9],u[10]);u[15]=slay_shot_meta(q,12);u[19]=u[15]*w/h;
   for k:0..<3 {u[104+k]=0;u[97+k]=slay_shot_meta(q,14+k);u[24+k]=slay_shot_meta(q,24+k);u[92+k]=slay_shot_meta(q,36+k);u[116+k]=slay_shot_meta(q,19+k);u[120+k]=slay_shot_meta(q,27+k);}u[108]=1;u[109]=0;u[5]=s[0].shot[0].frame/24;for k:0..<4 {u[100+k]=slay_shot_meta(q,30+k);}
   u[112]=1;u[113]=2.4;u[115]=slay_shot_meta(q,18);u[114]=slay_shot_meta(q,23);u[119]=0;u[123]=slay_shot_meta(q,42);u[31]=slay_shot_meta(q,43);canyon_rect_light(u,q,v3(0,0,0));for k:0..<3 {u[28+k]=slay_shot_meta(q,39+k);}
   // The lens for the post pass's depth of field: focus distance (m), f-number and focal length (m).
   u[128]=slay_shot_meta(q,34);u[129]=slay_shot_meta(q,13);u[130]=slay_shot_meta(q,12)*SLAY_SENSOR_WIDTH*0.5;
   u[124]=0.25015828;u[125]=0.61049557;u[126]=1;
   if s[0].spell {
    c:=spell_camera(s[0].spell_eye,s[0].spell_look,s[0].spell_head,v3(u[92],u[93],u[94]),s[0].spell_t/SPELL_SECONDS);
    fw:=unit_or(sub(c.at,c.eye),v3(0,0,-1));rt:=unit_or(cross(fw,v3(0,1,0)),v3(1,0,0));canyon_uniform_point(u,8,c.eye);canyon_uniform_point(u,12,rt);canyon_uniform_point(u,16,cross(rt,fw));canyon_uniform_point(u,20,fw);s[0].eye=c.eye;
    u[15]=s[0].spell_lens;u[19]=u[15]*w/h;reach:=sub(c.at,c.eye);u[128]=sqrt(dot(reach,reach));u[130]=s[0].spell_lens*SLAY_SENSOR_WIDTH*0.5;
   }
   l:=unit_or(v3(u[24],u[25],u[26]),v3(0,1,0));r:=unit_or(cross(v3(0,1,0),l),v3(1,0,0));canyon_uniform_point(u,80,r);canyon_uniform_point(u,84,cross(l,r));canyon_uniform_point(u,88,l);
  }
  if s[0].portrait && s[0].closeup && !s[0].source_shot && s[0].shot[0].ready {canyon_face_lighting(s,u,v3(feet.x,feet.y,feet.z));}
  share:=canyon_hair_share(canyon_head_pixels(s,u,h/d));s[0].hair_share=share;u[2]=ifx s[0].blonde then -share else share;
  for instance:0..<2 {at:=32+instance*24;canyon_matrix(u[at..<at+24],instance);}for k:0..<48 {s[0].pose_words[k]=f32_bits(u[32+k]);}
  s[0].draws=[20]u32.[0,cast(u32)(CANYON_TRIANGLES*3),cast(u32)(ifx s[0].solo==2 then 0 else s[0].solo),cast(u32)(ifx s[0].solo==2 then 2 else 1)*cast(u32)(ifx s[0].portrait then 0 else 1),2999985,522009,2,1,4470303,13811136,2,1,18281439,134418,2,cast(u32)(ifx s[0].source_shot then 1 else 0),18415857,2880,2,cast(u32)(ifx s[0].source_shot then 1 else 0)];
  pen:=HdPen.{d=d,top=0,bottom=h/d,cyan=false,sans=false};n:=hd_text(out,0,"VALLEY LAB / CANYON PAIR",20,34,ifx w/d<700 then 13.0f32 else 18.0f32,pen,0);
  n=hd_text(out,n,ifx s[0].walking then "O ORBIT" else "O WALK",w/d-100,34,11,pen,0);
  if s[0].walking {n=hd_text(out,n,"TOUCH / MOVE",20,h/d-165,10,pen,0);n=hd_text(out,n,"DRAG / LOOK",w/d-135,h/d-165,10,pen,0);}
  n=hd_text(out,n,"1 BACK",20,62,11,pen,0);n=hd_text(out,n,"RESET",w/d-80,62,11,pen,0);if s[0].walking {n=hd_text(out,n,"JUMP",w/d*0.5-20,62,11,pen,0);}
  n=hd_text_fit(out,n,ifx canyon_ready(s) then (ifx s[0].solo==2 then "ORIGINAL SOURCE / 1,999,990 TRIANGLES" else "ORIGINAL SOURCE / 999,995 TRIANGLES") else ifx s[0].failed then "PRIVATE SOURCE PACK MISSING OR REFUSED" else "LOADING ORIGINAL SOURCE PACK",20,94,11,w/d-40,pen,1);
  n=hd_text_fit(out,n,"ANCIENT WORLD / L0 X0 Y0 / INSTANCE 0 + 1",20,116,10,w/d-40,pen,0);
  n=hd_text_fit(out,n,"ORIGINAL 4K ALBEDO + ROUGHNESS / SOURCE POSES",20,h/d-142,10,w/d-40,pen,0);
  n=hd_text_fit(out,n,ifx s[0].walking then "ECHO SOURCE MESH + 24 CLIPS / COAX CONTROLLER PORT" else "METAVERSE ENGINE STUDIO LIGHTING / ORIGINAL SOURCE POSES",20,h/d-120,10,w/d-40,pen,1);
  n=hd_text(out,n,[5]string.["VIEW / PBR","VIEW / ALBEDO","VIEW / NORMALS","VIEW / ROUGHNESS","VIEW / VERTEX PAINT"][s[0].mode],20,h/d-98,11,pen,0);
  for k:0..<2 {b:=HudBox.{x=16+cast(f32)k*w/d*0.5,y=h/d-82,width=w/d*0.5-32,height=44};n=hd_panel(out,n,b,pen,false);n=hd_text_fit(out,n,ifx k==0 then "V / VIEW" else ifx s[0].solo==2 then "I / BOTH" else ifx s[0].solo==0 then "I / INSTANCE 0" else "I / INSTANCE 1",b.x+8,b.y+28,11,b.width-16,pen,0);}
  n=hd_text_fit(out,n,ifx s[0].walking then "WASD MOVE / DRAG LOOK / SPACE JUMP / C INSPECT / H FACE / O ORBIT" else "DRAG ORBIT / WHEEL ZOOM / O WALK / R RESET",20,h/d-16,10,w/d-40,pen,0);
