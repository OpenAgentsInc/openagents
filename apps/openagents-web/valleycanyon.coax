 #assert canyon_hair_share(600)==0.5 && canyon_hair_share(300)==0.5 && abs(canyon_hair_share(150)-0.25)<0.00001 && canyon_hair_share(10)==0.02f32;
 s:[1]ValleyCanyon;u:[CANYON_UNIFORMS]f32;out:[CANYON_HUD]f32;s[0].portrait=true;s[0].closeup=true;_:=canyon_frame(s[..],out[..],u[..],1280,800,1);#assert u[2]==0.5;
 s[0].portrait=false;s[0].closeup=false;_=canyon_frame(s[..],out[..],u[..],1280,800,1);#assert u[2]<0.5;
}
