 #assert canyon_key(s[..],80) && s[0].shot[0].frame==0 && s[0].shot[0].playing;
 s[0].shot[0].playing=false;s[0].shot[0].frame=1;s[0].width=1280;s[0].height=800;s[0].d=1;b:=canyon_replay_box(1280,800);
 #assert canyon_pointer(s[..],b.x+4,b.y+4,0) && s[0].shot[0].frame==0 && s[0].shot[0].playing;
