// Valley Lab's isolated exact source pair. GPU-resident source geometry; shared Metaverse Engine camera/UI.
#load "../../metaverse/valley/canyon.coax";
#load "../../metaverse/valley/canyon-pack-policy.coax";
#load "../../metaverse/valley/slay-gpu-policy.coax";
#load "../../metaverse-engine/ui/draw.coax";
#load "../../metaverse-engine/core/budget.coax";
#load "../../metaverse-engine/core/assets.coax";
#load "../../metaverse-engine/core/sticks.coax";
#load "../../metaverse/valley/slay-shot-play.coax";
#load "../../metaverse-engine/render/slay-lights.coax";
#load "../../metaverse-engine/move/locomotion.coax" as locomotion;
#load "../../metaverse-engine/move/walk.coax" as pc;
#load "../../metaverse-engine/cam/follow.coax" as camera;
#load "../../metaverse-engine/physics/collision-profiles.coax" as collision;
CANYON_HUD :: 32768;
#test "Source blend profiles keep body opaque, strands covered and orb additive" {
 s:[1]ValleyCanyon;for i:-1..<6 {#assert canyon_draw_blend(s[..],i)==(ifx i==2 then 2 else 0);}s[0].source_shot=true;for i:-1..<6 {#assert canyon_draw_blend(s[..],i)==(ifx i==4 then 1 else ifx i==2 then 2 else 0);}
}
canyon_draw_blend :: (s:[]ValleyCanyon,index:int)->int #export_c #effects(all) {return ifx index==2 then 2 else ifx s[0].source_shot && index==4 then 1 else 0;}
#test "Source strand sampling is bounded and inspection gets nine samples per displayed pixel" {s:[1]ValleyCanyon;#assert canyon_sampling(s[..])==2;s[0].portrait=true;#assert canyon_sampling(s[..])==3 && canyon_pixel_budget()==2097152;}
canyon_sampling :: (s:[]ValleyCanyon)->int #export_c #effects(all) {return ifx s[0].portrait then 3 else 2;}
canyon_pixel_budget :: ()->int #export_c #effects(all) {return 2097152;}
#test "Head inspection has the source close camera and reset restores the walk" #steps 1000000000 {s:[1]ValleyCanyon;#assert canyon_key(s[..],72) && s[0].portrait && s[0].closeup;u:[CANYON_UNIFORMS]f32;out:[CANYON_HUD*12]f32;n:=canyon_frame(s[..],out[..],u[..],1280,800,1);#assert n>0 && abs(u[9]-s[0].you.body.pos.y-1.65)<0.00001 && abs(u[10]-s[0].you.body.pos.z-CANYON_FACE_DISTANCE)<0.00001 && s[0].draws[5]==522009 && s[0].draws[9]==13811136;#assert canyon_key(s[..],82) && !s[0].portrait && !s[0].closeup;}
#test "Echo inspection matches the fixed Unreal reference camera and freezes the source pose" #steps 1000000000 {
 s:[1]ValleyCanyon;canyon_start(s[..]);#assert canyon_key(s[..],67) && s[0].portrait;t:=s[0].echo[0].time;canyon_step(s[..],1.0/64.0,false);#assert s[0].echo[0].time==t;out:[CANYON_HUD*12]f32;u:[CANYON_UNIFORMS]f32;n:=canyon_frame(s[..],out[..],u[..],1280,800,1);#assert n>0 && u[96]==1.1 && u[92]==s[0].you.body.pos.x && s[0].draws[3]==0;#assert canyon_key(s[..],67) && !s[0].portrait;
}
// The private original-source bundle, GPU streams and 35 mipmapped 4K texture layers.
CANYON_BUDGET :: FrameBudget.{steps=8,vertices=50000000,draws=12,bytes=4600000000};
canyon_storage_limit :: ()->int #export_c #effects(all) {return slay_gpu_storage();}
ValleyCanyon :: struct {walking:bool=true;blonde:bool;hair_share:f32;portrait:bool;closeup:bool;performance:bool;source_shot:bool;shot:[1]SlayShot;face_cycle:f32;started:bool;you:pc.Player;keys:int;look_x:f32;look_y:f32;thumbs:Sticks;active:[4]bool;ids:[4]int;now:f64;drag_id:int;echo:[1]Character;pack:[1]CharacterPack;ready:bool;pack_digest:[32]u8;pack_verified:bool;pack_checks:int;pose_words:[48]u32;assets:[4]int;failed:bool;orbit:f32=0.65;tilt:f32=0.12;distance:f32=14;mode:int;solo:int=2;drag:bool;x:f32;y:f32;d:f32=1;width:f32=1280;height:f32=800;eye:Point;draws:[20]u32;meter:[1]BudgetMeter;action:int;outbox:[64]u8;out_n:int;spell:bool;spell_t:f32;spell_eye:Point;spell_look:Point;spell_head:Point;spell_lens:f32;}
#test "Canyon requires the source geometry maps and admitted Echo rig before drawing" #steps 1000000000 {
 s:[1]ValleyCanyon;s[0].pack_verified=true;#assert !canyon_ready(s[..]);n:=echo_rig_fixture(s[0].pack[0].data[..],1);canyon_asset(s[..],0,n);canyon_asset(s[..],1,187564308);canyon_asset(s[..],2,73674948);#assert !canyon_ready(s[..]);canyon_asset(s[..],3,35);#assert canyon_ready(s[..]);canyon_asset(s[..],2,4);#assert !canyon_ready(s[..]) && s[0].failed;
}
#test "Canyon pointer orbit mode isolation and two full source draws stay bounded" {
  s:[1]ValleyCanyon;s[0].walking=false;s[0].width=390;s[0].height=844;#assert canyon_key(s[..],86) && s[0].mode==1;#assert canyon_key(s[..],73) && s[0].solo==0;
  _:=canyon_pointer(s[..],200,300,0);_ = canyon_pointer(s[..],230,330,1);#assert s[0].orbit<0.65 && s[0].tilt>0.12;_ = canyon_pointer(s[..],230,330,2);#assert !s[0].drag;
}
#test "Canyon walk moves stops jumps and resets through the Metaverse Engine" #steps 1000000000 {
  s:[1]ValleyCanyon;canyon_start(s[..]);z:=s[0].you.body.pos.z;
  #assert canyon_hold(s[..],87,true);for k:0..<16 {canyon_step(s[..],1.0/64.0,false);}#assert s[0].you.body.pos.z>z;
  #assert canyon_hold(s[..],87,false);canyon_blur(s[..]);#assert s[0].keys==0 && s[0].thumbs.pad_y==0;
  #assert canyon_hold(s[..],32,true);canyon_step(s[..],1.0/64.0,false);#assert s[0].you.body.vel.y>0;
  _:=canyon_key(s[..],82);#assert s[0].you.body.pos.z==z && s[0].you.body.on_ground;
  _=canyon_key(s[..],79);#assert !s[0].walking && s[0].keys==0;
}
#test "Canyon retains a jump tap released before the next frame" #steps 1000000000 {
  s:[1]ValleyCanyon;canyon_start(s[..]);_:=canyon_hold(s[..],32,true);_=canyon_hold(s[..],32,false);canyon_step(s[..],1.0/64.0,false);#assert s[0].you.body.vel.y>0 && s[0].keys==0;
  _=canyon_key(s[..],82);_=canyon_pointer(s[..],640,62,0);canyon_step(s[..],1.0/64.0,false);#assert s[0].you.body.vel.y>0;
  _=canyon_key(s[..],82);_=canyon_hold(s[..],32,true);canyon_blur(s[..]);#assert !s[0].you.body.jumps.held && s[0].you.body.jumps.waiting==1;canyon_step(s[..],1.0/64.0,false);#assert s[0].you.body.vel.y>0;
}
#test "Canyon conservative source bounds stop a capsule and touch moves it" #steps 1000000000 {
  s:[1]ValleyCanyon;canyon_start(s[..]);walls:[12]f32;canyon_walls(walls[..]);
  ground:=canyon_ground();s[0].you=pc.walk_place((walls[0]+walls[3])*0.5,ground,walls[2]-1,0);s[0].you.cam.phi=1.3;
  _:=canyon_hold(s[..],87,true);for k:0..<90 {canyon_step(s[..],1.0/64.0,false);}
  #assert s[0].you.body.pos.z<=walls[2]-0.41 && s[0].you.body.collision_refusals==0;
  _=canyon_key(s[..],82);s[0].width=390;s[0].height=844;z:=s[0].you.body.pos.z;
  _=canyon_pointer(s[..],80,500,0);_=canyon_pointer(s[..],80,440,1);for k:0..<16 {canyon_step(s[..],1.0/64.0,false);}#assert s[0].you.body.pos.z>z;
  _=canyon_pointer(s[..],80,440,2);#assert s[0].thumbs.pad_y==0 && !s[0].thumbs.move_on;
}
#test "Canyon mouse touch and arrow look use the existing non-inverted controller" #steps 1000000000 {
 s:[1]ValleyCanyon;canyon_start(s[..]);before:=s[0].you.cam.phi;
 _:=canyon_pointer_event(s[..],900,400,0,0,7);_=canyon_pointer_event(s[..],900,350,1,0,7);canyon_step(s[..],1.0/64.0,false);#assert s[0].you.cam.phi>before;_=canyon_pointer_event(s[..],900,350,2,0,7);
 _=canyon_key(s[..],82);before=s[0].you.cam.phi;_=canyon_pointer_event(s[..],900,400,0,1,8);_=canyon_pointer_event(s[..],900,350,1,1,8);canyon_step(s[..],1.0/64.0,false);#assert s[0].you.cam.phi>before;
 _=canyon_key(s[..],82);before=s[0].you.cam.phi;_=canyon_hold(s[..],-6,true);canyon_step(s[..],1.0/64.0,false);#assert s[0].you.cam.phi>before;
}
// The inspection floor and conservative box proxies are lab fixtures, not exported Unreal terrain/collision.
canyon_ground :: ()->f32 {return canyon_bounds().low.y-0.1;}
canyon_walls :: (walls:[]f32) {
  for instance:0..<2 {low:=v3(1000,1000,1000);high:=times(low,-1);
    for corner:0..<8 {p:=canyon_point(v3(ifx (corner&1)==0 then -0.657790899f32 else 0.217893705f32,ifx (corner&2)==0 then -0.0481042676f32 else 0.785208821f32,ifx (corner&4)==0 then -0.296127528f32 else 0.565942883f32),instance);
      low=v3(pc.lo(low.x,p.x),pc.lo(low.y,p.y),pc.lo(low.z,p.z));high=v3(pc.hi(high.x,p.x),pc.hi(high.y,p.y),pc.hi(high.z,p.z));}
    at:=instance*6;walls[at]=low.x;walls[at+1]=canyon_ground();walls[at+2]=low.z;walls[at+3]=high.x;walls[at+4]=high.y;walls[at+5]=high.z;
  }
}
canyon_start :: (s:[]ValleyCanyon) {
  if s[0].started {return;}s[0].started=true;b:=canyon_bounds();s[0].you=pc.walk_place((b.low.x+b.high.x)*0.5,canyon_ground(),b.low.z-6,0);s[0].you.body.on_ground=true;s[0].you.cam.phi=1.3;s[0].you.cam.dist=3;s[0].you.cam.prev_dist=3;s[0].you.cam.max_dist=3;
}
canyon_blur :: (s:[]ValleyCanyon) #export_c #effects(all) {s[0].keys=0;s[0].spell=false;s[0].thumbs=metaverse_sticks_reset();for k:0..<4 {s[0].active[k]=false;}s[0].look_x=0;s[0].look_y=0;s[0].drag=false;s[0].you=pc.walk_input(s[0].you,0,0,0,0,false,false,0,0);}
canyon_hold :: (s:[]ValleyCanyon,key:int,down:bool)->bool #export_c #effects(all) {
  if key== -1 {canyon_blur(s);return true;}bit:=0;if key==87 || key==119 {bit=1;}if key==83 || key==115 {bit=2;}if key==65 || key==97 {bit=4;}if key==68 || key==100 {bit=8;}if key==32 {bit=16;}if key== -13 {bit=32;}
  if s[0].walking && bit!=0 {if down {s[0].keys|=bit;}else {s[0].keys=(s[0].keys|bit)-bit;}if bit==16 {p:=s[0].you;s[0].you=pc.walk_input(p,p.body.key_x,p.body.key_y,p.body.pad_x,p.body.pad_y,p.body.run,down,0,0);}return true;}
  if down && s[0].walking {if key== -4 {s[0].look_x+=0.12;return true;}if key== -5 {s[0].look_x-=0.12;return true;}if key== -6 {s[0].look_y+=0.08;return true;}if key== -7 {s[0].look_y-=0.08;return true;}}
  return down && canyon_key(s,key);
}
canyon_step :: (s:[]ValleyCanyon,dt:f32,still:bool) #export_c #effects(all) {
 canyon_start(s);if still || !s[0].walking {return;}if s[0].source_shot && s[0].spell {if s[0].shot[0].playing {s[0].spell_t=pc.lo(SPELL_SECONDS,s[0].spell_t+pc.lo(pc.hi(dt,0),0.125));if s[0].spell_t>=SPELL_SECONDS {s[0].shot[0].playing=false;}}s[0].shot[0].frame=canyon_spell_frame(s);slay_shot_present(s[0].shot[..],s[0].echo[..],s[0].pack[..]);return;}if s[0].source_shot {if s[0].shot[0].playing {s[0].shot[0].frame+=pc.lo(pc.hi(dt,0),0.125)*24;last:=canyon_shot_last(s);if s[0].shot[0].frame>=last {s[0].shot[0].frame=last;s[0].shot[0].playing=false;}slay_shot_present(s[0].shot[..],s[0].echo[..],s[0].pack[..]);}return;}if s[0].portrait {if s[0].performance && s[0].echo[0].ready {character_face_clock(s[0].echo[..],s[0].pack[..],pc.lo(pc.hi(dt,0),0.125));}return;}k:=s[0].keys;t:=s[0].thumbs;p:=pc.walk_input(s[0].you,cast(f32)((ifx (k&8)!=0 then 1 else 0)-(ifx (k&4)!=0 then 1 else 0)),cast(f32)((ifx (k&1)!=0 then 1 else 0)-(ifx (k&2)!=0 then 1 else 0)),t.pad_x,t.pad_y,pc.walk_runs((k&32)!=0,t.run,t.pad_x,t.pad_y),(k&16)!=0 || t.jump,s[0].look_x+t.dyaw,s[0].look_y+t.dpitch);
 walls:[12]f32;canyon_walls(walls[..]);declaration:=collision.collision_profile_lookup("valley-canyon");w:=pc.World.{ground=canyon_ground(),room=80,walls=walls[..],collision=declaration.profile,locomotion=locomotion.LocomotionProfile.{source_velocity=true,walk_speed=1.47,run_speed=4.27,gravity=9.8,jump_speed=6,acceleration=5,turn_rate=10}};
 trace:=pc.advance_traced(w,p,dt);s[0].you=trace.player;wish:=pc.wish(p);want:=pc.atan2(wish.x,wish.z);
 for step:0..<trace.count {target:=trace.targets[step];e:=s[0].echo[..];e[0].drive_inputs=true;e[0].input_on=target.act==1 || target.act==2;e[0].run_requested=target.act==2;e[0].speed=sqrt(target.velocity.x*target.velocity.x+target.velocity.z*target.velocity.z);e[0].falling=target.act==3;e[0].turn=pc.wrap_angle(want-target.face);character_step(e,s[0].pack[..],1.0/64.0);}
 s[0].now+=cast(f64)(trace.count)/64;s[0].look_x=0;s[0].look_y=0;s[0].thumbs=metaverse_sticks_used(t);
}
canyon_ready :: (s:[]ValleyCanyon)->bool #export_c #effects(all) {return s[0].pack_verified && !s[0].failed && s[0].echo[0].ready && s[0].assets[0]>0 && s[0].assets[1]==187564308 && s[0].assets[2]==73674948 && s[0].assets[3]==35;}
canyon_face_select :: (s:[]ValleyCanyon,clip:int) {_:=character_face_play(s[0].echo[..],s[0].pack[..],clip);}
canyon_echo_restart :: (s:[]ValleyCanyon) {character_reset(s[0].echo[..]);character_locomote(s[0].echo[..],s[0].pack[..],0,0,true,0);}
canyon_catalog :: (s:[]ValleyCanyon,b:[]u8) #export_c #effects(all) {s[0].assets[0]=b.count;if !echo_catalog_admit(s[0].pack[..],0,b) || !echo_spawn(s[0].echo[..],s[0].pack[..],0) {s[0].failed=true;return;}if scan_u32(b,0)==0x33504345 {at:=20+cast(int)scan_u32(b,4)+cast(int)scan_u32(b,8);if !shot_admit(s[0].shot[..],b[at..<b.count],character_face_bytes(s[0].echo[..],s[0].pack[..])) {s[0].failed=true;}else {_:=canyon_key(s,74);}}}
canyon_catalog_capacity :: (scratch:[]EchoCatalogScratch)->int #export_c #effects(all) {return scratch[0].bytes.count;}
canyon_asset :: (s:[]ValleyCanyon,index:int,bytes:int) #export_c #effects(all) {
 if index<0 || index>3 {return;}s[0].assets[index]=bytes;if bytes==0 {s[0].failed=true;return;}
 if index==0 && !(character_pack_rig(s[0].pack[..],0,bytes) && echo_spawn(s[0].echo[..],s[0].pack[..],0)) {s[0].failed=true;}
 if (index==1 && bytes!=187564308) || (index==2 && bytes!=73674948) || (index==3 && bytes!=35) {s[0].failed=true;}
}
