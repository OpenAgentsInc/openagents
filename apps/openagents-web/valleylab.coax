valley_key :: (s:[]ValleyLab,key:int,down:bool)->bool #export_c #effects(all) {
  valley_start(s);bit:=0;
  if down && (key==78 || key==110) {url:="/worlds/valley-world?pack=valley-world";for c,k:url {s[0].outbox[k]=c;}s[0].out_n=url.count;s[0].action=1;return true;}
  if down && (key==80 || key==112) {valley_canyon_open(s);return true;}
  if down && key==48 {valley_scan_lab(s,0);return true;}
  if down && s[0].scan_lab {if key==118 || key==86 {s[0].mode=(s[0].mode+1)%5;return true;}if key==108 || key==76 {valley_scan_lab(s,1-s[0].scan_selected);return true;}if key==114 || key==82 {valley_scan_lab(s,s[0].scan_selected);return true;}if key==104 || key==72 || key==102 || key==70 || key==99 || key==67 {return true;}}
  if down && key>=52 && key<=54 {if s[0].field_lab {valley_field_lab(s,key-45);}else if s[0].grid_lab {valley_grid_lab(s,key-45);}else if s[0].rock_lab {valley_rock_lab(s,key-45);}else {valley_lab(s,key-45);}return true;}
  if down && key==57 {valley_field_lab(s,7);return true;}
  if down && key==56 {valley_grid_lab(s,7);return true;}
  if down && key==55 {valley_rock_lab(s,7);return true;}
  if down && s[0].mode>=7 && (key==104 || key==72) {s[0].parent_level=(s[0].parent_level+1)%(ifx s[0].rock_lab then 2 else 3);return true;}
  if down && (key==116 || key==84) {s[0].tolerance=ifx s[0].tolerance==16 then 64 else ifx s[0].tolerance==64 then 256 else 16;return true;}
  if down && s[0].mode>=7 && (key==101 || key==69 || key==98 || key==66) {if key==98 || key==66 {s[0].pages[0].budget=ifx s[0].grid_lab then (ifx s[0].pages[0].budget==2192 then 1096 else 2192) else ifx s[0].rock_lab then (ifx s[0].pages[0].budget==256 then 255 else 256) else (ifx s[0].pages[0].budget==512 then 256 else 512);}page_reset(s[0].pages[..]);for k:0..<2 {s[0].retry[k]=0;}return true;}
  if down && key>=49 && key<=51 {valley_station(s,key-49);return true;}
  if down && (key==104 || key==72) {valley_level(s);return true;}
  if down && (key==102 || key==70) {valley_fixture(s);return true;}
  if down && (key==99 || key==67) {if s[0].stage==0 {valley_station(s,2);}s[0].cluster_path=!s[0].cluster_path;s[0].mode=ifx s[0].cluster_path then 5 else 0;return true;}
  if down && (key==118 || key==86) {s[0].mode=(s[0].mode+1)%7;if s[0].mode==5 && s[0].stage==0 {valley_station(s,2);s[0].mode=5;}return true;}
  if down && s[0].field_lab && (key==108 || key==76) {#assert valley_load_rock(s,ifx s[0].divisions==8 then 16 else 8);return true;}
  if down && s[0].field_lab && (key==114 || key==82) {valley_field_lab(s,s[0].mode);return true;}
  if down && (key==108 || key==76) {#assert valley_load_rock(s,ifx s[0].divisions==8 then 16 else ifx s[0].divisions==16 then 32 else 8);return true;}
  if s[0].stage!=0 && bit==0 {
    if down && (key== -4 || key== -5) {s[0].orbit+=ifx key== -4 then 0.12f32 else -0.12f32;return true;}
    if down && (key== -6 || key== -7) {s[0].tilt=clamp(s[0].tilt+(ifx key== -6 then 0.08f32 else -0.08f32),-0.1,1.2);return true;}
  }

  if key==119 || key==87 {bit=1;}if key==115 || key==83 {bit=2;}
  if key==97 || key==65 {bit=4;}if key==100 || key==68 {bit=8;}
  if key==32 {bit=16;}if key== -13 {bit=32;}
  if bit!=0 {if down {s[0].keys|=bit;}else {s[0].keys=(s[0].keys|bit)-bit;}return true;}
  if !down {return false;}
  if key==114 || key==82 {s[0].orbit=0.65;s[0].tilt=0.28;s[0].distance=9;valley_blur(s);s[0].ready=false;valley_start(s);return true;}
  if key== -4 {s[0].look_x+=0.12;return true;}if key== -5 {s[0].look_x-=0.12;return true;}
  if key== -6 {s[0].look_y-=0.08;return true;}if key== -7 {s[0].look_y+=0.08;return true;}
  if key== -1 {valley_blur(s);return true;}return false;
