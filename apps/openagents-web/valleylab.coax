// Valley Lab: original graybox, shared Aethyr walking/collision/camera and touch controls.
#load "../../aethyr/walk.coax" as pc;
#load "../../aethyr/sticks.coax";
#load "../../aethyr/points.coax";
#load "../../aethyr/ui/draw.coax";
#load "../../aethyr/budget.coax";
#load "../../verse/valley/rock.coax";
#load "../../verse/valley/rock-parent.coax";
#load "../../verse/valley/rock-grid.coax";
#load "../../verse/valley/field.coax";
#load "../../verse/valley/scan.coax";
#load "../../aethyr/render/geometry/hierarchy.coax";
#load "../../aethyr/render/geometry/fan.coax";
#load "../../aethyr/render/geometry/cut.coax";
#load "../../verse/valley/parents.coax";
#load "../../aethyr/render/geometry/pages.coax";

VALLEY_VERTICES :: 81920;
VALLEY_MESH :: 16384;
VALLEY_INDICES :: 65536;
VALLEY_BUDGET :: FrameBudget.{steps=8,vertices=80000,draws=3,bytes=9500000};
ValleyLab :: struct {
  ready:bool; you:pc.Player; thumbs:Sticks;
  keys:int; look_x:f32; look_y:f32; zoom:f32;
  width:f32=1280; height:f32=800; d:f32=1; now:f64;
  active:[4]bool; ids:[4]int;
  eye:Point; forward:Point; right:Point; up:Point; scale:f32;
  mesh:[VALLEY_MESH*8]f32; mesh_n:int; draws:[4]u32;
  meter:[1]BudgetMeter;
  clusters:[1]Clusters;cluster_path:bool;
  hierarchy:[1]GeometryHierarchy;level:int=1;fixture:int;
  candidate_rock:[1]Rock; // bounded admission scratch, counted in the frame arena
  rock:[1]Rock;registry:[1]AssetRegistry;rock_ready:bool;divisions:int=16;
  index:[VALLEY_INDICES]u32;index_n:int;
  stage:int;mode:int;orbit:f32=0.65;tilt:f32=0.28;distance:f32=9;
  rock_lab:bool;rock_group:RockParent;grid_lab:bool;grid_group:[2]RockGrid;grid_selected:[ROCK_MAX_INDICES/3]bool;field_lab:bool;field_record:[6]FieldRock;
  parents_ready:bool;sources:[2]ParentMesh;coarse:[2]ParentMesh;page_key:[2]AssetId;page_bytes:[2]int;
  pages:[1]GeometryPages;parent_level:int;tolerance:f32=16;render_triangles:int;coarse_count:int;pixel_error:[2]f32;
  lab_tick:int;retry:[2]int;need_page:int= -1;tickets:[2]PageTicket;http:[8]PageTicket;page_url:[128]u8;page_url_n:int;rock_parent_supported:bool;
  scan:[1]Scan;scan_candidate:[1]Scan;scan_data:[SCAN_BYTES]u8;scan_registry:[1]AssetRegistry;scan_lab:bool;scan_ready:bool;scan_selected:int;scan_loaded:int= -1;scan_need:bool;scan_http:[8]int;scan_state:int;
  inbox:[SCAN_BYTES*2+16]u8;action:int;outbox:[64]u8;out_n:int;
  drag:bool;drag_id:int;drag_x:f32;drag_y:f32;

}
// A single source for drawn boxes AND collision. min x/y/z, max x/y/z.
VALLEY_BOXES :: [19*6]f32.[
  -42,-1,-40,-35,15,48, 35,-1,-40,42,18,48,
  -35,-1,42,-6,13,49, 6,-1,42,35,16,49,
  -35,-1,-42,35,10,-35,
  -27,0,-18,-19,7,-10, 19,0,-12,27,9,-4,
  -29,0,8,-20,12,19, 22,0,17,31,15,30,
  -12,0,21,-8,8,25, 8,0,21,12,8,25,
  -12,8,21,12,11,25,
  -6,0,8,-3,0.3,11, -3,0,8,0,0.6,11, 0,0,8,3,0.9,11,
  -17,0,31,-13,3,35, 14,0,33,18,4,37,
  -2,0,-22,2,1.2,-18, -6,-1,49,6,12,55
];

// Checks precede behavior: real movement, jump, collision, reset and bounded drawing.
#test "Valley stations stop held movement and expose one content identified indexed rock" #steps 1000000000 {
  s:[1]ValleyLab;valley_start(s[..]);s[0].keys=1;valley_station(s[..],1);
  #assert s[0].stage==1 && s[0].keys==0 && s[0].registry[0].held==1;
  #assert s[0].rock[0].vertices==1734 && s[0].rock[0].indices==9216 && s[0].rock[0].bytes==78504;
  tick:=s[0].you.clock.ticks;valley_step(s[..],0.1,false);#assert s[0].you.clock.ticks==tick;
  s[0].width=390;s[0].height=844;
  #assert valley_pointer(s[..],20,700,0,1,5) && s[0].mode==0 && s[0].drag;
  #assert valley_pointer(s[..],20,700,2,1,5) && !s[0].drag;
  #assert valley_pointer(s[..],50,780,0,1,6) && s[0].mode==1 && !s[0].drag;
  old:=s[0].rock[0].id;#assert !valley_load_rock(s[..],33) && asset_same(old,s[0].rock[0].id);
  #assert valley_load_rock(s[..],8) && s[0].registry[0].held==1 && s[0].registry[0].used==20904;
  for i:0..<6 {s[0].inbox[i]="assets"[i];}valley_hash(s[..],6);#assert s[0].stage==1;
  for i:0..<8 {s[0].inbox[i]="geometry"[i];}valley_hash(s[..],8);#assert s[0].stage==2;
  #assert valley_key(s[..],118,true) && s[0].mode==4;
  #assert valley_key(s[..],49,true) && s[0].stage==0 && s[0].keys==0;
}
#test "Valley full detail GPU index pulling covers the source without expansion" #steps 2000000000 {
  s:[1]ValleyLab;out:[VALLEY_VERTICES*12]f32;u:[88]f32;valley_start(s[..]);valley_station(s[..],2);
  for detail:[3]int.[8,16,32] {
    #assert valley_load_rock(s[..],detail);
    n:=valley_frame(s[..],out[..],u[..],390,844,1,0,true);
    #assert n>0 && budget_ok(s[0].meter[0]);
    #assert s[0].mesh_n==1728+s[0].rock[0].vertices && s[0].index_n==1728+s[0].rock[0].indices;
    for k:0..<s[0].rock[0].indices {#assert s[0].index[1296+k]==cast(u32)1296+s[0].rock[0].i[k];}
    #assert s[0].draws[1]==cast(u32)s[0].index_n && s[0].registry[0].held==1;
  }
}
#test "Valley cluster decoding covers every source triangle once and fits all detail buffers" #steps 3000000000 {
  s:[1]ValleyLab;out:[VALLEY_VERTICES*12]f32;u:[88]f32;valley_start(s[..]);
  #assert valley_key(s[..],99,true) && s[0].stage==2 && s[0].mode==5 && s[0].cluster_path;
  for detail:[3]int.[8,16,32] {
    #assert valley_load_rock(s[..],detail);r:=s[0].rock[..];c:=s[0].clusters[..];covered:=0;
    #assert c[0].triangles==r[0].indices/3 && c[0].count>1;
    for a:c[0].leaf[0..<c[0].count] {
      #assert a.first==covered && a.vertices<=64 && a.triangles<=124 && a.triangles>0;
      for k:0..<a.vertices {p:=r[0].p[cast(int)a.source[k]];
        #assert p.x>=a.low.x && p.y>=a.low.y && p.z>=a.low.z && p.x<=a.high.x && p.y<=a.high.y && p.z<=a.high.z;}
      for k:0..<a.triangles*3 {#assert cast(int)a.local[k]<a.vertices && a.source[cast(int)a.local[k]]==r[0].i[a.first*3+k];}
      covered+=a.triangles;
    }
    #assert covered==r[0].indices/3;
    n:=valley_frame(s[..],out[..],u[..],390,844,1,0,true);
    #assert n>0 && budget_ok(s[0].meter[0]) && s[0].mesh_n==1296+c[0].vertices && s[0].index_n==1296+r[0].indices;
    base:=1296;at:=1296;
    for a:c[0].leaf[0..<c[0].count] {
      for k:0..<a.triangles*3 {#assert s[0].index[at+k]==cast(u32)(base+cast(int)a.local[k]);}
      base+=a.vertices;at+=a.triangles*3;
    }
    // Cluster reconstruction can also be shaded normally for a reference comparison.
    s[0].mode=0;_:=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);
    #assert s[0].mesh_n==1296+c[0].vertices && budget_ok(s[0].meter[0]);s[0].mode=5;
  }
  #assert valley_key(s[..],99,true) && !s[0].cluster_path && s[0].mode==0;
}
#test "Valley hierarchy cuts retain every rock triangle and fit each detail profile" #steps 2000000000 {
  s:[1]ValleyLab;out:[VALLEY_VERTICES*12]f32;u:[88]f32;valley_start(s[..]);
  #assert valley_key(s[..],104,true) && s[0].stage==2 && s[0].mode==6;
  for detail:[3]int.[8,16,32] {
    #assert valley_load_rock(s[..],detail);h:=s[0].hierarchy[..];
    #assert h[0].count==s[0].clusters[0].count*2-1 && h[0].node[h[0].root].triangles==s[0].rock[0].indices/3;
    for node,id:h[0].node[0..<h[0].count] {
      if node.left>=0 {a:=h[0].node[node.left];b:=h[0].node[node.right];
        #assert a.parent==id && b.parent==id && a.first+a.leaves==b.first && node.leaves==a.leaves+b.leaves;
        #assert node.low.x<=a.low.x && node.low.x<=b.low.x && node.high.y>=a.high.y && node.high.y>=b.high.y;
      }
    }
    previous:=h[0].leaves;
    for level:0..<h[0].node[h[0].root].height+1 {s[0].level=level;triangles:=0;leaves:=0;groups:=0;
      for k:0..<h[0].leaves {owner:=hierarchy_owner(h,k,level);node:=h[0].node[owner];
        if k==node.first {triangles+=node.triangles;leaves+=node.leaves;groups+=1;}
      }
      #assert triangles==s[0].rock[0].indices/3 && leaves==h[0].leaves && groups<=previous;previous=groups;
    }
    _:=valley_frame(s[..],out[..],u[..],390,844,1,0,true);
    #assert s[0].mesh_n==1728+s[0].clusters[0].vertices && s[0].index_n==1728+s[0].rock[0].indices && budget_ok(s[0].meter[0]);
  }
}
#test "Valley simplification fixtures expose real counts errors and phone controls" #steps 1000000000 {
  s:[1]ValleyLab;out:[VALLEY_VERTICES*12]f32;u:[88]f32;
  valley_start(s[..]);#assert valley_key(s[..],104,true);#assert valley_key(s[..],102,true) && s[0].fixture==1 && s[0].level==0;
  frame:=valley_frame(s[..],out[..],u[..],390,844,1,0,true);
  #assert valley_probe(s[..],35)==4 && valley_probe(s[..],36)==0 && s[0].index_n==1740;
  #assert valley_pointer(s[..],270,780,0,1,10) && s[0].level==1;
  frame=valley_frame(s[..],out[..],u[..],390,844,1,0,true);
  #assert valley_probe(s[..],35)==2 && valley_probe(s[..],36)==0 && s[0].index_n==1734;
  #assert valley_pointer(s[..],100,720,0,1,11) && s[0].fixture==2 && s[0].level==0;
  #assert valley_key(s[..],104,true);frame=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);
  #assert valley_probe(s[..],35)==2 && valley_probe(s[..],36)==750 && budget_ok(s[0].meter[0]);
  #assert valley_key(s[..],104,true) && s[0].level==0 && valley_probe(s[..],35)==4 && valley_probe(s[..],36)==0;
}
#test "Valley parent stages render actual reductions preserve the seam and fall back before HTTP" #steps 1000000000 {
  s:[1]ValleyLab;out:[VALLEY_VERTICES*12]f32;u:[88]f32;valley_lab(s[..],7);
  #assert cast(string)s[0].outbox[0..<s[0].out_n]=="parents";
  #assert !s[0].rock_parent_supported && s[0].sources[0].indices==18 && s[0].coarse[1].indices==12;
  frame:=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==12;
  #assert valley_key(s[..],104,true);frame=valley_frame(s[..],out[..],u[..],390,844,1,0,true);#assert s[0].render_triangles==10;
  #assert valley_key(s[..],104,true);frame=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==8;
  valley_lab(s[..],8);s[0].tolerance=0;frame=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==10;
  s[0].tolerance=256;frame=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==8 && s[0].pixel_error[1]>0;
  valley_lab(s[..],9);frame=valley_frame(s[..],out[..],u[..],390,844,1,0,true);
  #assert s[0].render_triangles==12 && s[0].need_page>=0 && s[0].pages[0].used==0 && budget_ok(s[0].meter[0]);
  page:=geometry_page(s[0].coarse[0]);ticket:=s[0].tickets[0];#assert page_arrive(s[0].pages[..],ticket,page.data[0..<page.bytes]);
  s[0].need_page= -1;frame=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==10 && s[0].pages[0].used==256;
  #assert valley_key(s[..],101,true) && s[0].pages[0].used==0;
}
#test "Valley real rock parent cuts only its star and pages before replacement" #steps 1500000000 {
  s:[1]ValleyLab;out:[VALLEY_VERTICES*12]f32;u:[88]f32;valley_rock_lab(s[..],7);
  frame:=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==3072 && s[0].rock_group.supported;
  #assert valley_key(s[..],104,true);frame=valley_frame(s[..],out[..],u[..],390,844,1,0,true);
  #assert s[0].render_triangles==3070 && valley_probe(s[..],61)==4 && budget_ok(s[0].meter[0]);
  valley_rock_lab(s[..],8);s[0].tolerance=0;frame=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==3072;
  s[0].tolerance=256;frame=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==3070;
  valley_rock_lab(s[..],9);s[0].tolerance=256;frame=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);
  #assert s[0].render_triangles==3072 && s[0].need_page==0 && s[0].pages[0].used==0;
  p:=geometry_page(s[0].rock_group.coarse);#assert page_arrive(s[0].pages[..],s[0].tickets[0],p.data[0..<p.bytes]);s[0].need_page= -1;
  frame=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==3070 && s[0].pages[0].used==256;
  for detail:[3]int.[8,16,32] {#assert valley_load_rock(s[..],detail);valley_rock_lab(s[..],7);s[0].parent_level=1;
    frame=valley_frame(s[..],out[..],u[..],390,844,1,0,true);#assert s[0].render_triangles==s[0].rock[0].indices/3-2 && budget_ok(s[0].meter[0]);
  }
}
#test "Valley adjacent groups render source mixed coarse and admitted pages across all profiles" #steps 1500000000 {
  s:[1]ValleyLab;out:[VALLEY_VERTICES*12]f32;u:[88]f32;valley_grid_lab(s[..],7);
  for level:0..<3 {s[0].parent_level=level;frame:=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);
    #assert s[0].render_triangles==3072-level*8 && s[0].coarse_count==level && budget_ok(s[0].meter[0]);}
  valley_grid_lab(s[..],8);s[0].tolerance=0;frame:=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==3072;
  s[0].tolerance=256;frame=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==3056;
  valley_grid_lab(s[..],9);s[0].tolerance=256;frame=valley_frame(s[..],out[..],u[..],390,844,1,0,true);#assert s[0].render_triangles==3072 && s[0].need_page==0;
  for k:0..<2 {page:=geometry_page(s[0].grid_group[k].coarse);#assert page_arrive(s[0].pages[..],s[0].tickets[k],page.data[0..<page.bytes]);s[0].need_page= -1;
    frame=valley_frame(s[..],out[..],u[..],390,844,1,0,true);#assert s[0].render_triangles==3072-(k+1)*8 && s[0].pages[0].used==(k+1)*1096;}
  for detail:[3]int.[8,16,32] {#assert valley_load_rock(s[..],detail);valley_grid_lab(s[..],7);s[0].parent_level=2;
    frame=valley_frame(s[..],out[..],u[..],390,844,1,0,true);#assert s[0].render_triangles==s[0].rock[0].indices/3-16 && budget_ok(s[0].meter[0]);}
}
#test "Valley field replays its six transforms shares two pages and stays in declared budgets" #steps 800000000 {
  s:[1]ValleyLab;out:[VALLEY_VERTICES*12]f32;u:[88]f32;valley_field_lab(s[..],7);
  for level:0..<3 {s[0].parent_level=level;frame:=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);
    #assert s[0].render_triangles==18432-level*48 && s[0].coarse_count==level*6 && budget_ok(s[0].meter[0]);}
  valley_field_lab(s[..],8);s[0].tolerance=0;frame:=valley_frame(s[..],out[..],u[..],390,844,1,0,true);#assert s[0].render_triangles==18432;
  s[0].tolerance=256;frame=valley_frame(s[..],out[..],u[..],390,844,1,0,true);#assert s[0].render_triangles==18336 && s[0].coarse_count==12;
  valley_field_lab(s[..],9);s[0].tolerance=256;frame=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==18432 && s[0].need_page==0;
  for k:0..<2 {p:=geometry_page(s[0].grid_group[k].coarse);#assert page_arrive(s[0].pages[..],s[0].tickets[k],p.data[0..<p.bytes]);s[0].need_page= -1;
    frame=valley_frame(s[..],out[..],u[..],1280,800,1,0,true);#assert s[0].render_triangles==18432-(k+1)*48;}
  #assert s[0].pages[0].used==2192 && s[0].registry[0].held==1 && s[0].pages[0].requests==2 && budget_ok(s[0].meter[0]);
  #assert valley_key(s[..],108,true) && s[0].divisions==8;frame=valley_frame(s[..],out[..],u[..],390,844,1,0,true);#assert budget_ok(s[0].meter[0]);
  #assert valley_key(s[..],108,true) && s[0].divisions==16;frame=valley_frame(s[..],out[..],u[..],390,844,1,0,true);#assert budget_ok(s[0].meter[0]);
  for screen:0..<3 {b:=budget_screen(screen);frame=valley_frame(s[..],out[..],u[..],b.width,b.height,b.dpr,0,true);#assert budget_ok(s[0].meter[0]) && s[0].index_n<=VALLEY_INDICES && s[0].mesh_n<VALLEY_MESH;}
  for t:0..<s[0].rock[0].indices/3 {expected:=false;for k:0..<2 {for id:s[0].grid_group[k].triangles {if id==t {expected=true;}}}#assert s[0].grid_selected[t]==expected;}
}
#test "Valley walker moves, jumps, lands and releases input on blur" #steps 1000000000 {
  s:[1]ValleyLab;valley_start(s[..]);
  #assert valley_key(s[..],119,true);
  for i:0..<64 {valley_step(s[..],1.0/64.0,false);}
  #assert s[0].you.pos.z> -11 && s[0].you.pos.z<0;
  #assert valley_key(s[..],32,true);valley_step(s[..],1.0/64.0,false);
  #assert !s[0].you.on_ground && s[0].you.vel.y>0;
  valley_blur(s[..]);#assert s[0].keys==0 && !s[0].thumbs.move_on;
  for i:0..<128 {valley_step(s[..],1.0/64.0,false);}
  #assert s[0].you.on_ground && abs(s[0].you.pos.y)<0.1;
  #assert valley_key(s[..],114,true) && s[0].you.pos.z== -12;
}
#test "Valley drawn gate stops the capsule and its low steps can be climbed" #steps 1000000000 {
  s:[1]ValleyLab;valley_start(s[..]);s[0].you=pc.walk_place(-10,0,18,0);s[0].keys=1;
  for i:0..<128 {valley_step(s[..],1.0/64.0,false);}
  #assert s[0].you.pos.z<21 && s[0].you.pos.z>19;
  s[0].you=pc.walk_place(-4.5,0,6,0);
  for i:0..<40 {valley_step(s[..],1.0/64.0,false);}
  #assert s[0].you.pos.y>0.2 && s[0].you.pos.z>8;
}
#test "Valley keyboard and touch controls drive the same shared walker" #steps 1000000000 {
  a:[1]ValleyLab;b:[1]ValleyLab;valley_start(a[..]);valley_start(b[..]);
  a[0].keys=1;b[0].thumbs.pad_y=1;
  for i:0..<64 {valley_step(a[..],1.0/64.0,false);valley_step(b[..],1.0/64.0,false);}
  #assert a[0].you.pos.z==b[0].you.pos.z && a[0].you.pos.x==b[0].you.pos.x;
}
#test "Valley frames fit desktop and phone buffers and freeze for goldens" #steps 1000000000 {
  #assert budget_declared(VALLEY_BUDGET,VALLEY_VERTICES)==BUDGET_NONE;
  s:[1]ValleyLab;out:[VALLEY_VERTICES*12]f32;u:[88]f32;
  for screen:0..<3 {
    w:=[3]f32.[1280,390,1170][screen];h:=[3]f32.[800,844,2532][screen];d:=[3]f32.[1,1,3][screen];
    n:=valley_frame(s[..],out[..],u[..],w,h,d,0.016,true);
    #assert n>0 && n<VALLEY_VERTICES && s[0].mesh_n>600 && s[0].mesh_n<=VALLEY_MESH;
    #assert budget_ok(s[0].meter[0]) && s[0].you.clock.ticks==0;
    for v:s[0].mesh[0..<s[0].mesh_n*8] {#assert v==v && abs(v)<100000;}
  }
}

valley_start :: (s:[]ValleyLab) {
  if s[0].ready {return;}s[0].ready=true;
  s[0].you=pc.walk_place(0,0,-12,0);s[0].you.phi=1.12;
  s[0].you.max_dist=7;s[0].you.dist=7;s[0].you.prev_dist=7;
