valley_pointer :: (s:[]ValleyLab,x:f32,y:f32,phase:int,kind:int,id:int)->bool #export_c #effects(all) {
  valley_start(s);slot:=-1;
  for i:0..<4 {if s[0].active[i] && s[0].ids[i]==id {slot=i;}}
  if phase==0 {
    if y<234*s[0].d {
      cx:=x/s[0].d;cy:=y/s[0].d;w:=s[0].width/s[0].d;
      if cy<48 && cx>=145 && cx<w-100 {_:=valley_key(s,78,true);}
      else if cy>=190 && cy<=226 && cx>=320 && cx<=w-16 {valley_scan_lab(s,0);}
      else if cy>=190 && cy<=226 && cx>=168 && cx<=312 {valley_field_lab(s,7);}
      else if cy>=190 && cy<=226 && cx>=16 && cx<=160 {valley_grid_lab(s,7);}
      else if cy>=82 && cy<=126 && cx>=16 && cx<322 {valley_station(s,cast(int)((cx-16)/102));}
      else if cy>=136 && cy<=180 && cx>=16 && cx<w-16 {tab:=cast(int)((cx-16)/((lo(w,440)-32)/4));if tab==3 {valley_rock_lab(s,7);}else if tab<3 {if s[0].field_lab {valley_field_lab(s,7+tab);}else if s[0].grid_lab {valley_grid_lab(s,7+tab);}else if s[0].rock_lab {valley_rock_lab(s,7+tab);}else {valley_lab(s,7+tab);}}}
      else if cy<70 && cx>s[0].width/s[0].d-100 {_:=valley_key(s,114,true);}
      return true;
    }
    if s[0].scan_lab {cx:=x/s[0].d;cy:=y/s[0].d;w:=s[0].width/s[0].d;h:=s[0].height/s[0].d;top:=ifx w<700 then h-126 else 476.0f32;if cx>=16 && cx<=lo(w-16,376) && cy>=top && cy<=top+28 {valley_canyon_open(s);return true;}}
    if s[0].mode>=7 && s[0].width/s[0].d<700 {
      cx:=x/s[0].d;cy:=y/s[0].d;w:=s[0].width/s[0].d;h:=s[0].height/s[0].d;
      if cx>=16 && cx<=w-16 && cy>=h-138 && cy<=h-98 {_:=valley_key(s,ifx s[0].mode==9 then 118 else ifx s[0].mode==7 then 104 else 116,true);return true;}
      if cy>=h-88 && cy<=h-44 {
        if s[0].mode==9 {cell:=(w-48)/3;for k:0..<3 {left:=16+cast(f32)k*(cell+8);if cx>=left && cx<=left+cell {_:=valley_key(s,[3]int.[116,101,98][k],true);return true;}}}
        else {if cx>=16 && cx<=w*0.5-16 {_:=valley_key(s,118,true);return true;}if cx>=w*0.5+16 && cx<=w-16 {_:=valley_key(s,116,true);return true;}}
      }
    }
    if s[0].stage!=0 && s[0].mode==6 && s[0].width/s[0].d<700 && y>=s[0].height-138*s[0].d && y<=s[0].height-98*s[0].d && x>=16*s[0].d && x<=s[0].width-16*s[0].d {valley_fixture(s);return true;}
    if s[0].stage!=0 && s[0].width/s[0].d<700 && y>=s[0].height-88*s[0].d && y<=s[0].height-44*s[0].d {
      cx:=x/s[0].d;w:=s[0].width/s[0].d;
      if cx>=16 && cx<=w*0.5-16 {_:=valley_key(s,118,true);return true;}
      if cx>=w*0.5+16 && cx<=w-16 {if s[0].scan_lab {_:=valley_key(s,108,true);return true;}if s[0].mode==6 {valley_level(s);return true;}#assert valley_load_rock(s,ifx s[0].divisions==8 then 16 else ifx s[0].divisions==16 then 32 else 8);return true;}
    }
    if s[0].stage!=0 {s[0].drag=true;s[0].drag_id=id;s[0].drag_x=x;s[0].drag_y=y;return true;}

    for i:0..<4 {if !s[0].active[i] {slot=i;break;}}
    if slot<0 {return false;}s[0].active[slot]=true;s[0].ids[slot]=id;
  }
  if s[0].stage!=0 && s[0].drag && s[0].drag_id==id {
    if phase==1 {s[0].orbit-=(x-s[0].drag_x)/s[0].d*0.006;s[0].tilt=clamp(s[0].tilt+(y-s[0].drag_y)/s[0].d*0.006,-0.1,1.2);s[0].drag_x=x;s[0].drag_y=y;}
    if phase>=2 {s[0].drag=false;}return true;
  }
  if slot<0 {return false;}
