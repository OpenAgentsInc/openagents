// Valley Lab: original graybox, shared Aethyr walking/collision/camera and touch controls.
#load "../../aethyr/walk.coax" as pc;
#load "../../aethyr/sticks.coax";
#load "../../aethyr/points.coax";
#load "../../aethyr/ui/draw.coax";
#load "../../aethyr/budget.coax";

VALLEY_VERTICES :: 16000;
VALLEY_MESH :: 12288;
VALLEY_BUDGET :: FrameBudget.{steps=8,vertices=15000,draws=3,bytes=2000000};
ValleyLab :: struct {
  ready:bool; you:pc.Player; thumbs:Sticks;
  keys:int; look_x:f32; look_y:f32; zoom:f32;
  width:f32=1280; height:f32=800; d:f32=1; now:f64;
  active:[4]bool; ids:[4]int;
  eye:Point; forward:Point; right:Point; up:Point; scale:f32;
  mesh:[VALLEY_MESH*8]f32; mesh_n:int; draws:[4]u32;
  meter:[1]BudgetMeter;
}
// A single source for drawn boxes AND collision. min x/y/z, max x/y/z.
VALLEY_BOXES :: [19*6]f32.[
  -42,-1,-40,-35,15,48, 35,-1,-40,42,18,48,
  -35,-1,42,-6,13,49, 6,-1,42,35,16,49,
  -35,-1,-42,35,10,-35,
  -27,0,-18,-19,7,-10, 19,0,-12,27,9,-4,
  -29,0,8,-20,12,19, 22,0,17,31,15,30,
  -12,0,21,-8,8,25, 8,0,21,12,8,25,
  -12,8,21,12,11,25,
  -6,0,8,-3,0.3,11, -3,0,8,0,0.6,11, 0,0,8,3,0.9,11,
  -17,0,31,-13,3,35, 14,0,33,18,4,37,
  -2,0,-22,2,1.2,-18, -6,-1,49,6,12,55
];

// Checks precede behavior: real movement, jump, collision, reset and bounded drawing.
#test "Valley walker moves, jumps, lands and releases input on blur" {
  s:[1]ValleyLab;valley_start(s[..]);
  #assert valley_key(s[..],119,true);
  for i:0..<64 {valley_step(s[..],1.0/64.0,false);}
  #assert s[0].you.pos.z> -11 && s[0].you.pos.z<0;
  #assert valley_key(s[..],32,true);valley_step(s[..],1.0/64.0,false);
  #assert !s[0].you.on_ground && s[0].you.vel.y>0;
  valley_blur(s[..]);#assert s[0].keys==0 && !s[0].thumbs.move_on;
  for i:0..<128 {valley_step(s[..],1.0/64.0,false);}
  #assert s[0].you.on_ground && abs(s[0].you.pos.y)<0.1;
  #assert valley_key(s[..],114,true) && s[0].you.pos.z== -12;
}
#test "Valley drawn gate stops the capsule and its low steps can be climbed" {
  s:[1]ValleyLab;valley_start(s[..]);s[0].you=pc.walk_place(-10,0,18,0);s[0].keys=1;
  for i:0..<128 {valley_step(s[..],1.0/64.0,false);}
  #assert s[0].you.pos.z<21 && s[0].you.pos.z>19;
  s[0].you=pc.walk_place(-4.5,0,6,0);
  for i:0..<40 {valley_step(s[..],1.0/64.0,false);}
  #assert s[0].you.pos.y>0.2 && s[0].you.pos.z>8;
}
#test "Valley keyboard and touch controls drive the same shared walker" {
  a:[1]ValleyLab;b:[1]ValleyLab;valley_start(a[..]);valley_start(b[..]);
  a[0].keys=1;b[0].thumbs.pad_y=1;
  for i:0..<64 {valley_step(a[..],1.0/64.0,false);valley_step(b[..],1.0/64.0,false);}
  #assert a[0].you.pos.z==b[0].you.pos.z && a[0].you.pos.x==b[0].you.pos.x;
}
#test "Valley frames fit desktop and phone buffers and freeze for goldens" #steps 100000000 {
  #assert budget_declared(VALLEY_BUDGET,VALLEY_VERTICES)==BUDGET_NONE;
  s:[1]ValleyLab;out:[VALLEY_VERTICES*12]f32;u:[88]f32;
  for screen:0..<3 {
    w:=[3]f32.[1280,390,1170][screen];h:=[3]f32.[800,844,2532][screen];d:=[3]f32.[1,1,3][screen];
    n:=valley_frame(s[..],out[..],u[..],w,h,d,0.016,true);
    #assert n>0 && n<VALLEY_VERTICES && s[0].mesh_n>600 && s[0].mesh_n<=VALLEY_MESH;
    #assert budget_ok(s[0].meter[0]) && s[0].you.clock.ticks==0;
    for v:s[0].mesh[0..<s[0].mesh_n*8] {#assert v==v && abs(v)<100000;}
  }
}

valley_start :: (s:[]ValleyLab) {
  if s[0].ready {return;}s[0].ready=true;
  s[0].you=pc.walk_place(0,0,-12,0);s[0].you.phi=1.12;
  s[0].you.max_dist=7;s[0].you.dist=7;s[0].you.prev_dist=7;
}
valley_blur :: (s:[]ValleyLab) #export_c {
  s[0].keys=0;s[0].look_x=0;s[0].look_y=0;s[0].zoom=0;s[0].thumbs=Sticks.{};
  for i:0..<4 {s[0].active[i]=false;}
  s[0].you=pc.walk_input(s[0].you,0,0,0,0,false,false,0,0);
}
valley_key :: (s:[]ValleyLab,key:int,down:bool)->bool #export_c {
  valley_start(s);bit:=0;
  if key==119 || key==87 {bit=1;}if key==115 || key==83 {bit=2;}
  if key==97 || key==65 {bit=4;}if key==100 || key==68 {bit=8;}
  if key==32 {bit=16;}if key== -13 {bit=32;}
  if bit!=0 {if down {s[0].keys|=bit;}else {s[0].keys=(s[0].keys|bit)-bit;}return true;}
  if !down {return false;}
  if key==114 || key==82 {valley_blur(s);s[0].ready=false;valley_start(s);return true;}
  if key== -4 {s[0].look_x+=0.12;return true;}if key== -5 {s[0].look_x-=0.12;return true;}
  if key== -6 {s[0].look_y-=0.08;return true;}if key== -7 {s[0].look_y+=0.08;return true;}
  if key== -1 {valley_blur(s);return true;}return false;
}
valley_pointer :: (s:[]ValleyLab,x:f32,y:f32,phase:int,kind:int,id:int)->bool #export_c {
  valley_start(s);slot:=-1;
  for i:0..<4 {if s[0].active[i] && s[0].ids[i]==id {slot=i;}}
  if phase==0 {
    if y<92*s[0].d {if x>s[0].width-100*s[0].d {valley_blur(s);s[0].ready=false;valley_start(s);}return true;}
    for i:0..<4 {if !s[0].active[i] {slot=i;break;}}
    if slot<0 {return false;}s[0].active[slot]=true;s[0].ids[slot]=id;
  }
  if slot<0 {return false;}
  s[0].thumbs=sticks_touch(s[0].thumbs,slot,phase,x,y,s[0].width,s[0].height,s[0].d,s[0].now,false);
  if phase==2 || phase==3 {s[0].active[slot]=false;}return true;
}
valley_wheel :: (s:[]ValleyLab,delta:f32) #export_c {s[0].zoom+=delta*0.01;}
valley_step :: (s:[]ValleyLab,dt:f32,still:bool) {
  valley_start(s);if still {return;}
  k:=s[0].keys;t:=s[0].thumbs;
  p:=pc.walk_input(s[0].you,cast(f32)((ifx (k&8)!=0 then 1 else 0)-(ifx (k&4)!=0 then 1 else 0)),
    cast(f32)((ifx (k&1)!=0 then 1 else 0)-(ifx (k&2)!=0 then 1 else 0)),t.pad_x,t.pad_y,
    (k&32)!=0 || t.run,(k&16)!=0 || t.jump,s[0].look_x+t.dyaw,s[0].look_y+t.dpitch);
  p=pc.walk_zoom(p,s[0].zoom+t.zoom*0.01);
  empty:[]f32;walls:=VALLEY_BOXES;
  s[0].you=pc.walk_advance_in_realm(p,dt,empty,walls[..],empty,"valley-lab");
  s[0].look_x=0;s[0].look_y=0;s[0].zoom=0;s[0].thumbs=verse_sticks_used(t);s[0].now+=cast(f64)dt;
}
valley_vertex :: (s:[]ValleyLab,p:Point,c:Point) {
  #assert s[0].mesh_n<VALLEY_MESH;
  r:=sub(p,s[0].eye);z:=dot(r,s[0].forward);at:=s[0].mesh_n*8;
  s[0].mesh[at]=2*dot(r,s[0].right)*s[0].scale/s[0].width;
  s[0].mesh[at+1]=2*dot(r,s[0].up)*s[0].scale/s[0].height;
  s[0].mesh[at+2]=300.0/299.8*(z-0.2);s[0].mesh[at+3]=z;
  s[0].mesh[at+4]=c.x;s[0].mesh[at+5]=c.y;s[0].mesh[at+6]=c.z;s[0].mesh[at+7]=1;s[0].mesh_n+=1;
}
valley_box :: (s:[]ValleyLab,x:f32,y:f32,z:f32,rx:f32,ry:f32,rz:f32,c:Point) {
  corners:[8]Point;for i:0..<8 {corners[i]=v3(x+(ifx (i&1)==0 then -rx else rx),y+(ifx (i&2)==0 then 0.0f32 else ry),z+(ifx (i&4)==0 then -rz else rz));}
  faces:=[36]int.[0,1,3,0,3,2,4,6,7,4,7,5,0,4,5,0,5,1,2,3,7,2,7,6,0,2,6,0,6,4,1,5,7,1,7,3];
  for i:0..<36 {valley_vertex(s,corners[faces[i]],times(c,[6]f32.[0.72,0.60,0.48,1,0.65,0.85][i/6]));}
}
valley_frame :: (s:[]ValleyLab,out:[]f32,u:[]f32,w:f32,h:f32,d:f32,dt:f32,still:bool)->int #export_c {
  valley_start(s);if !(w>0) || !(h>0) || !(d>0) || u.count<88 || out.count<VALLEY_VERTICES*12 {return 0;}
  s[0].width=w;s[0].height=h;s[0].d=d;valley_step(s,dt,still);
  eye:=pc.walk_eye(s[0].you);at:=pc.walk_at(s[0].you);s[0].eye=v3(eye.x,eye.y,eye.z);
  s[0].forward=unit_or(sub(v3(at.x,at.y,at.z),s[0].eye),v3(0,0,1));
  s[0].right=unit_or(cross(s[0].forward,v3(0,1,0)),v3(-1,0,0));s[0].up=cross(s[0].right,s[0].forward);s[0].scale=h*0.85;
  for i:0..<88 {u[i]=0;}u[0]=w;u[1]=h;u[3]=1;u[80]=0;u[81]=h;s[0].mesh_n=0;
  // Tiled sand gives movement a readable metre scale. Every top is the shared flat floor.
  for x: -7..<7 {for z: -7..<9 {
    tone:=ifx ((x+z)&1)==0 then 1.0f32 else 0.96f32;
    valley_box(s,cast(f32)x*6+3,-0.12,cast(f32)z*6+3,3,0.12,3,times(v3(0.60,0.42,0.25),tone));
  }}
  for i:0..<19 {
    b:=i*6;lo_x:=VALLEY_BOXES[b];lo_y:=VALLEY_BOXES[b+1];lo_z:=VALLEY_BOXES[b+2];
    hi_x:=VALLEY_BOXES[b+3];hi_y:=VALLEY_BOXES[b+4];hi_z:=VALLEY_BOXES[b+5];
    valley_box(s,(lo_x+hi_x)*0.5,lo_y,(lo_z+hi_z)*0.5,(hi_x-lo_x)*0.5,hi_y-lo_y,(hi_z-lo_z)*0.5,v3(0.69,0.45,0.28));
  }
  feet:=pc.walk_feet(s[0].you);body:=v3(0.18,0.34,0.36);
  valley_box(s,feet.x,feet.y+0.65,feet.z,0.28,0.65,0.18,body);
  valley_box(s,feet.x,feet.y+1.35,feet.z,0.2,0.4,0.2,v3(0.86,0.72,0.51));
  gait:=ifx pc.flat_speed(s[0].you)>0.1 then sin(cast(f32)s[0].now*10)*0.15 else 0.0f32;
  valley_box(s,feet.x-0.15,feet.y,feet.z+gait,0.10,0.65,0.12,body);
  valley_box(s,feet.x+0.15,feet.y,feet.z-gait,0.10,0.65,0.12,body);
  s[0].draws=[4]u32.[0,cast(u32)s[0].mesh_n,0x80000000,1];
  pen:=HdPen.{d=d,top=0,bottom=h/d,cyan=false,sans=false};n:=0;
  n=hd_text(out,n,"VALLEY LAB",20,34,18,pen,0);
  n=hd_text_fit(out,n,"01 / WALKABLE GRAYBOX",20,59,11,w/d-125,pen,1);
  n=hd_text(out,n,"RESET",w/d-84,36,12,pen,0);
  if w/d>=700 {n=hd_text(out,n,"WASD MOVE  /  SHIFT RUN  /  SPACE JUMP  /  ARROWS LOOK  /  R RESET",20,h/d-22,11,pen,0);}
  else {n=hd_text_fit(out,n,"LEFT DRAG MOVE / RIGHT DRAG LOOK / TAP JUMP",16,h/d-22,10,w/d-32,pen,0);}
  if s[0].thumbs.move_on {t:=s[0].thumbs;n=hd_ring(out,n,t.ox/d,t.oy/d,44,44,0,6.2831853,pen,2);n=hd_ring(out,n,t.ox/d+t.pad_x*44,t.oy/d-t.pad_y*44,12,12,0,6.2831853,pen,0);}
  s[0].meter[0]=budget_meter(VALLEY_BUDGET);budget_measure(s[0].meter[..],n+s[0].mesh_n,3,budget_arena_bytes(size_of(ValleyLab),VALLEY_VERTICES,12,88));
  _:=budget_take(s[0].meter[..],BUDGET_STEPS,s[0].you.clock.ran);#assert budget_ok(s[0].meter[0]);return n;
}
valley_probe :: (s:[]ValleyLab,field:int)->int #export_c {
  if field==0 {return cast(int)(s[0].you.pos.x*1000);}if field==1 {return cast(int)(s[0].you.pos.y*1000);}
  if field==2 {return cast(int)(s[0].you.pos.z*1000);}if field==3 {return s[0].you.clock.ticks;}
  if field==4 {return s[0].keys;}return s[0].mesh_n;
}
