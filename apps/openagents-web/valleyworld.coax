// Valley Lab's contiguous source-world slice. Echo, input, pose and camera are shared with the inspector.
#load "valleycanyon.coax";
#load "../../verse/valley/world-catalog.coax";
#load "../../verse/valley/world-pack-policy.coax";
#load "../../verse/valley/world-host-policy.coax";
#load "../../verse/valley/world-select.coax";
#load "../../verse/valley/detail-runtime.coax";
#load "../../aethyr/frame-pacing.coax";
#load "../../aethyr/ground.coax" as ground;
#load "../../aethyr/query.coax" as query;
VW_RIG_BYTES :: 10142528;
WORLD_BUDGET :: FrameBudget.{steps=8,vertices=3000000000,draws=65542,bytes=8000000000};
#test "World budget covers the oracle's entire source scene in both passes" {m:=[1]BudgetMeter.[budget_meter(WORLD_BUDGET)];budget_measure(m[..],407418897*6+(522009+2957442)*2+CANYON_HUD,65542,8000000000);#assert budget_ok(m[0]);}
ValleyWorld :: struct {
 canyon:[1]ValleyCanyon;loaded:bool;started:bool;catalog_bytes:int;
 heights:[VW_POINTS]f32;source:[VW_DRAWS*4]u32;bounds:[VW_DRAWS*4]f32;
 draws:[(VW_DRAWS+2)*4]u32;draw_count:int;source_count:int;visible:int;triangles:int;
 shadow_draws:[(VW_DRAWS+2)*4]u32;shadow_count:int;shadow_triangles:int;
 selection:[2]WhSelection;geometry_mode:int=1;geometry_stats:bool;hierarchy_at:int;hierarchy_bytes:int;hierarchy_leaves:int;hierarchy_nodes:int;fallbacks:int;
 detail:[1]DetailState;detail_digest:[2][32]u8;
 vertices:int;indices:int;layers:int;matrix_word:int;material_word:int;vertex_word:int;
 assets:[4]int;digest:[32]u8;verified:bool;failed:bool;checks:int;station:int;
 meter:[1]BudgetMeter;
}
#test "World movement holds while private ground is missing" {
 s:[1]ValleyWorld;world_step(s[..],0.1,false);#assert !s[0].started && !s[0].loaded;
}
#test "World detailed page replaces one complete source draw in both passes and keeps indexed ownership" {
 s:[1]ValleyWorld;s[0].source_count=1;s[0].source[0]=7614858;s[0].source[1]=70686;s[0].source[2]=3;s[0].source[3]=1;s[0].detail[0].ready[0]=true;s[0].detail[0].chosen=0;u:[128]f32;b:[1]u8;
 world_select(s[..],u[..],b[..],false);world_select(s[..],u[..],b[..],true);#assert s[0].selection[0].indices==5992848 && s[0].selection[1].indices==5992848;
 #assert world_draw_index(s[..],0,false,0)==4 && world_draw_index(s[..],0,true,1)==4051752 && world_draw_index(s[..],1,false,0)== -1;
 #assert world_hold(s[..],75,true) && s[0].detail[0].mode==2;#assert world_detail_source(s[..])==0;s[0].detail[0].ready[1]=true;#assert world_detail_source(s[..])==1 && world_detail_bytes(s[..])==56385280;
 #assert world_hold(s[..],107,true) && world_detail_source(s[..])== -1 && world_detail_bytes(s[..])==0;
}
#test "World defaults to the measured pass cut and exposes reference and cluster diagnostics" {
 s:[1]ValleyWorld;#assert s[0].geometry_mode==1;#assert world_hold(s[..],71,true) && s[0].geometry_mode==2;#assert world_hold(s[..],103,true) && s[0].geometry_mode==0;#assert world_hold(s[..],71,true) && s[0].geometry_mode==1;
 #assert world_hold(s[..],76,true) && s[0].geometry_stats;#assert world_hold(s[..],108,true) && !s[0].geometry_stats;
 b:[32]u8;n:=world_digits(b[..],0,407418897);#assert cast(string)b[0..<n]=="407418897";#assert world_digits(b[..],0,0)==1 && b[0]=='0';
}
#test "World traversal refuses source coverage holes and the bounded outer edge" {s:[1]ValleyWorld;#assert !world_safe(s[..],-114,0);for k:0..<VW_POINTS {s[0].heights[k]= -128;}#assert !world_safe(s[..],0,0);for k:0..<VW_POINTS {s[0].heights[k]= -5;}#assert world_safe(s[..],0,0);s[0].heights[113*257+113]= -128;#assert !world_safe(s[..],0,0);}
#test "World reset releases input and places Echo on the sampled source surface" #steps 1000000000 {
 s:[1]ValleyWorld;s[0].loaded=true;for k:0..<VW_POINTS {s[0].heights[k]= -5;}
 world_start(s[..]);#assert s[0].canyon[0].you.pos.y== -5;
 _:=world_hold(s[..],87,true);world_step(s[..],0.125,false);#assert s[0].canyon[0].you.pos.z!= -5;
 s[0].canyon[0].echo[0].input_on=true;s[0].canyon[0].echo[0].run_requested=true;s[0].canyon[0].walking=false;s[0].canyon[0].portrait=true;s[0].canyon[0].closeup=true;
 _=world_hold(s[..],82,true);#assert s[0].canyon[0].keys==0 && s[0].canyon[0].you.pos.y== -5 && !s[0].canyon[0].echo[0].input_on && !s[0].canyon[0].echo[0].run_requested && s[0].canyon[0].walking && !s[0].canyon[0].portrait && !s[0].canyon[0].closeup;
}
#test "World's source visibility is conservative behind and around the eye" {
 u:[128]f32;u[15]=1;u[19]=1;u[12]=1;u[17]=1;u[22]=1;
 #assert world_visible(u[..],v3(0,0,5),1);#assert !world_visible(u[..],v3(0,0,-5),1);
 #assert world_visible(u[..],v3(0,0,-0.5),1);#assert world_visible(u[..],v3(8,0,5),3);
 #assert world_inside(u[..],v3(0,0,5),1,false) && !world_inside(u[..],v3(4,0,5),1,false) && !world_inside(u[..],v3(0,0,0.5),1,false);
 u[80]=1;u[85]=1;u[90]=1;u[96]=45;#assert world_inside(u[..],v3(44,0,0),1,true) && !world_inside(u[..],v3(45,0,0),1,true);
}
#test "World separates offscreen casters and falls back completely when hierarchy bytes are absent" {
 s:[1]ValleyWorld;s[0].source_count=1;s[0].source[0]=12;s[0].source[1]=6;s[0].source[2]=3;s[0].source[3]=1;s[0].bounds[2]= -10;s[0].bounds[3]=1;
 u:[128]f32;u[12]=1;u[17]=1;u[22]=1;u[15]=1;u[19]=1;u[80]=1;u[85]=1;u[90]=1;u[96]=45;b:[1]u8;
 world_select(s[..],u[..],b[..],false);world_select(s[..],u[..],b[..],true);#assert s[0].selection[0].indices==0 && s[0].selection[1].indices==6;
 s[0].geometry_mode=0;world_select(s[..],u[..],b[..],false);#assert s[0].selection[0].indices==6;
 s[0].geometry_mode=2;s[0].hierarchy_bytes=252;world_select(s[..],u[..],b[..],true);#assert s[0].selection[1].indices==6 && s[0].selection[1].nodes==0 && s[0].fallbacks==0;
}
#test "World draw capacity reserves the two Echo records after every unbatchable source placement" #steps 1000000000 {
 s:[1]ValleyWorld;s[0].geometry_mode=0;s[0].source_count=VW_DRAWS;
 for k:0..<VW_DRAWS {s[0].source[k*4]=cast(u32)(k*3);s[0].source[k*4+1]=3;s[0].source[k*4+2]=cast(u32)(k+3);s[0].source[k*4+3]=1;s[0].bounds[k*4+2]=5;}
 u:[128]f32;u[12]=1;u[17]=1;u[22]=1;u[15]=1;u[19]=1;b:[1]u8;world_select(s[..],u[..],b[..],false);
 #assert s[0].selection[0].draws==VW_DRAWS+2 && !s[0].selection[0].overflow && s[0].draws[(VW_DRAWS-1)*4]==cast(u32)((VW_DRAWS-1)*3) && s[0].draws[VW_DRAWS*4]==0 && s[0].draws[(VW_DRAWS+1)*4]==0;
}
#test "World frames batch adjacent source instances and fit desktop phone and high DPR budgets" #steps 1000000000 {
 s:[1]ValleyWorld;s[0].loaded=true;s[0].source_count=2;s[0].vertices=116686256;s[0].indices=50173080;s[0].layers=240;for k:0..<VW_POINTS {s[0].heights[k]= -5;}
 for k:0..<2 {s[0].source[k*4]=7427745;s[0].source[k*4+1]=3;s[0].source[k*4+2]=cast(u32)(3+k);s[0].source[k*4+3]=1;s[0].bounds[k*4+1]= -5;s[0].bounds[k*4+3]=10;}
 out:[CANYON_HUD*12]f32;u:[128]f32;for screen:0..<3 {n:=world_frame(s[..],out[..],u[..],[3]f32.[1280,390,1170][screen],[3]f32.[800,844,2532][screen],[3]f32.[1,1,3][screen]);#assert n>0 && n<CANYON_HUD && s[0].visible==2 && s[0].draw_count==3 && s[0].draws[3]==2 && s[0].draws[9]==2957442 && budget_ok(s[0].meter[0]);}
}
#test "World spawn requires a gentle patch across both terrain triangles before moving or jumping" #steps 1000000000 {s:[1]ValleyWorld;s[0].loaded=true;for k:0..<VW_POINTS {s[0].heights[k]= -5;}s[0].heights[108*257+112]=5;#assert world_surface(s[..],0,-5).gx==0 && world_surface(s[..],0,-5).gz==0 && !world_spawn_safe(s[..],0,-5);world_start(s[..]);q:=world_surface(s[..],s[0].canyon[0].you.pos.x,s[0].canyon[0].you.pos.z);#assert q.gx*q.gx+q.gz*q.gz<0.49;world_step(s[..],1.0/64.0,false);#assert s[0].canyon[0].you.on_ground;_:=world_hold(s[..],32,true);_=world_hold(s[..],32,false);world_step(s[..],0.001,false);#assert s[0].canyon[0].you.jumps.waiting==1;world_step(s[..],0.02,false);#assert s[0].canyon[0].you.vel.y>0;}
world_surface :: (s:[]ValleyWorld,x:f32,z:f32)->query.QueryGround {field:=[1]query.QueryHeightfield.[query.QueryHeightfield.{ground=world_ground(),heights=s[0].heights[..]}];return query.query_base_ground(query.Colliders.{ground= -128,heightfields=field[..]},x,z);}
world_ground :: ()->ground.Ground {return ground.Ground.{n=256,cell=1,west= -112,south= -112};}
world_height :: (s:[]ValleyWorld,x:f32,z:f32)->f32 {return world_surface(s,x,z).y;}
world_safe :: (s:[]ValleyWorld,x:f32,z:f32)->bool {ix:=cast(int)floor(x+112);iz:=cast(int)floor(z+112);if ix<1 || iz<1 || ix>254 || iz>254 {return false;}for dz: -1..<3 {for dx: -1..<3 {if s[0].heights[(iz+dz)*257+ix+dx]< -127 {return false;}}}return true;}
world_spawn_safe :: (s:[]ValleyWorld,x:f32,z:f32)->bool {ix:=cast(int)floor(x+112);iz:=cast(int)floor(z+112);if ix<3 || iz<3 || ix>251 || iz>251 || !world_safe(s,x,z) {return false;}for dz: -2..<3 {for dx: -2..<3 {k:=(iz+dz)*257+ix+dx;a:=s[0].heights[k];b:=s[0].heights[k+1];c:=s[0].heights[k+257];d:=s[0].heights[k+258];if a< -127 || b< -127 || c< -127 || d< -127 || (b-a)*(b-a)+(d-b)*(d-b)>=0.49 || (d-c)*(d-c)+(c-a)*(c-a)>=0.49 {return false;}}}return true;}
world_start :: (s:[]ValleyWorld) {
 if s[0].started || !s[0].loaded {return;}s[0].started=true;c:=s[0].canyon[..];c[0].started=true;
 p:=[4]Point.[v3(0,0,-5),v3(-55,0,25),v3(60,0,45),v3(0,0,80)][s[0].station];best:f32=1000000;
 for z:2..<254 {for x:2..<254 {px:=cast(f32)x-112;pz:=cast(f32)z-112;distance:=(px-p.x)*(px-p.x)+(pz-p.z)*(pz-p.z);if distance<best && world_spawn_safe(s,px,pz) {best=distance;c[0].you.pos.x=px;c[0].you.pos.z=pz;}}}

 if best<1000000 {p.x=c[0].you.pos.x;p.z=c[0].you.pos.z;}
 c[0].you=pc.walk_place(p.x,world_height(s,p.x,p.z),p.z,0);c[0].you.on_ground=true;c[0].you.phi=1.3;c[0].you.dist=4;c[0].you.prev_dist=4;c[0].you.max_dist=6;
}
world_hold :: (s:[]ValleyWorld,key:int,down:bool)->bool #export_c #effects(all) {
 if down && (key==75 || key==107) {s[0].detail[0].mode=(s[0].detail[0].mode+1)%3;s[0].detail[0].revision+=1;return true;}
 if down && (key==71 || key==103) {s[0].geometry_mode=(s[0].geometry_mode+1)%3;return true;}
 if down && (key==76 || key==108) {s[0].geometry_stats=!s[0].geometry_stats;return true;}
 if down && (key==86 || key==118) {s[0].canyon[0].mode=(s[0].canyon[0].mode+1)%4;return true;}
 if down && key>=50 && key<=53 {s[0].station=key-50;s[0].started=false;canyon_blur(s[0].canyon[..]);world_echo_reset(s);world_start(s);return true;}
 if down && (key==82 || key==114) {s[0].started=false;s[0].canyon[0].portrait=false;s[0].canyon[0].closeup=false;canyon_blur(s[0].canyon[..]);world_echo_reset(s);world_start(s);return true;}
 return canyon_hold(s[0].canyon[..],key,down);
}
world_echo_reset :: (s:[]ValleyWorld) {s[0].canyon[0].walking=true;s[0].canyon[0].portrait=false;s[0].canyon[0].closeup=false;e:=s[0].canyon[0].echo[..];e[0].input_on=false;e[0].run_requested=false;echo_reset(e);echo_advance(e,0,0,true,0);}
world_pointer :: (s:[]ValleyWorld,x:f32,y:f32,phase:int,kind:int,id:int)->bool #export_c #effects(all) {
 c:=s[0].canyon[..];if phase==0 {cx:=x/c[0].d;cy:=y/c[0].d;width:=c[0].width/c[0].d;height:=c[0].height/c[0].d;
  if cy<72 {if cx>width-110 {return world_hold(s,82,true);}if cx<100 && cy<48 {return world_hold(s,49,true);}return true;}
  if cy>=72 && cy<=108 && cx>=16 && cx<=width-16 {station:=cast(int)((cx-16)/((width-32)/4));if station>=0 && station<4 {return world_hold(s,50+station,true);}}
  if cy>=height-120 && cy<=height-92 && cx>=width-90 {_:=world_hold(s,32,true);return world_hold(s,32,false);}
  if cy>height-90 {return world_hold(s,ifx cx>=width*0.5 then 50+(s[0].station+1)%4 else 86,true);}
 }
 return canyon_pointer_event(c,x,y,phase,kind,id);
}
world_step :: (s:[]ValleyWorld,dt:f32,still:bool) #export_c #effects(all) {
 world_start(s);if !s[0].loaded || still {return;}c:=s[0].canyon[..];if !c[0].walking || c[0].portrait {return;}
 k:=c[0].keys;t:=c[0].thumbs;p:=pc.walk_input(c[0].you,cast(f32)((ifx (k&8)!=0 then 1 else 0)-(ifx (k&4)!=0 then 1 else 0)),cast(f32)((ifx (k&1)!=0 then 1 else 0)-(ifx (k&2)!=0 then 1 else 0)),t.pad_x,t.pad_y,pc.walk_runs((k&32)!=0,t.run,t.pad_x,t.pad_y),(k&16)!=0 || t.jump,c[0].look_x+t.dyaw,c[0].look_y+t.dpitch);
 field:=[1]query.QueryHeightfield.[query.QueryHeightfield.{ground=world_ground(),heights=s[0].heights[..]}];
 walls:=[24]f32.[-114,-128,-114,-111,256,146,143,-128,-114,146,256,146,-114,-128,-114,146,256,-111,-114,-128,143,146,256,146];
 w:=pc.World.{ground= -128,room=150,heightfields=field[..],walls=walls[..],collision=collision.collision_profile_lookup("valley-canyon").profile,locomotion=locomotion.LocomotionProfile.{source_velocity=true,walk_speed=1.47,run_speed=4.27,gravity=9.8,jump_speed=6,acceleration=5,turn_rate=10}};
 trace:=pc.advance_traced(w,p,dt);next:=trace.player;blocked:=!world_safe(s,next.pos.x,next.pos.z);if blocked {next.pos=p.pos;next.prev_pos=p.pos;next.vel=pc.Vec3.{};next.target=p.target;next.prev_target=p.target;next.on_ground=p.on_ground;next.act=pc.Act.idle;}c[0].you=next;wish:=pc.wish(p);want:=pc.atan2(wish.x,wish.z);
 for step:0..<trace.count {target:=trace.targets[step];c[0].echo[0].drive_inputs=true;c[0].echo[0].input_on=!blocked && (target.act==1 || target.act==2);c[0].echo[0].run_requested=target.act==2;echo_advance(c[0].echo[..],1.0/64.0,ifx blocked then 0.0f32 else sqrt(target.velocity.x*target.velocity.x+target.velocity.z*target.velocity.z),target.act!=3,pc.wrap_angle(want-target.face));}
 c[0].now+=cast(f64)(trace.count)/64;c[0].look_x=0;c[0].look_y=0;c[0].thumbs=verse_sticks_used(t);
}
world_asset :: (s:[]ValleyWorld,index:int,bytes:int) #export_c #effects(all) {
 if index<0 || index>3 {return;}s[0].assets[index]=bytes;if bytes==0 {s[0].failed=true;return;}
 if index==0 {
  if bytes<VW_RIG_BYTES || bytes>s[0].canyon[0].echo[0].data.count {s[0].failed=true;return;}
  trailer:=s[0].canyon[0].echo[0].data[VW_RIG_BYTES..<bytes];if !vw_catalog_valid(trailer) || !echo_admit(s[0].canyon[0].echo[..],VW_RIG_BYTES) {s[0].failed=true;return;}
  s[0].catalog_bytes=bytes;s[0].source_count=cast(int)scan_u32(trailer,8);s[0].vertices=cast(int)scan_u32(trailer,12);s[0].indices=cast(int)scan_u32(trailer,16);s[0].layers=cast(int)scan_u32(trailer,20);
  s[0].vertex_word=cast(int)scan_u32(trailer,44);s[0].matrix_word=cast(int)scan_u32(trailer,48);s[0].material_word=cast(int)scan_u32(trailer,52);
  for k:0..<VW_POINTS {s[0].heights[k]=scan_float(trailer,VW_HEADER+k*4);}
  for k:0..<s[0].source_count {at:=VW_HEADER+VW_POINTS*4+k*32;for j:0..<4 {s[0].source[k*4+j]=scan_u32(trailer,at+j*4);s[0].bounds[k*4+j]=scan_float(trailer,at+16+j*4);}}
 }
 s[0].loaded=s[0].verified && !s[0].failed && s[0].catalog_bytes>0 && s[0].assets[1]==s[0].vertices && s[0].assets[2]==s[0].indices && s[0].assets[3]==s[0].layers;
}
// The host owns a bounded byte carrier. Coax decides its shape and copies only Echo's original rig.
world_catalog_capacity :: ()->int #export_c #effects(all) {return WH_CAP;}
world_detail_capacity :: ()->int #export_c #effects(all) {return DETAIL_CAP;}
world_detail_source :: (s:[]ValleyWorld)->int #export_c #effects(all) {return detail_effective(s[0].detail[..]);}
world_detail_bytes :: (s:[]ValleyWorld)->int #export_c #effects(all) {slot:=world_detail_source(s);return ifx slot<0 then 0 else detail_info(slot).bytes;}
world_detail_gate :: (s:[]ValleyWorld,slot:int,bytes:int)->bool #export_c #effects(all) {return detail_accept(slot,detail_digest_id(s[0].detail_digest[slot][..]),bytes);}
world_detail_asset :: (s:[]ValleyWorld,slot:int,bytes:int) #export_c #effects(all) {_:=detail_arrive(s[0].detail[..],slot,detail_digest_id(s[0].detail_digest[slot][..]),bytes);}
world_draw_index :: (s:[]ValleyWorld,index:int,shadow:bool,field:int)->int #export_c #effects(all) {draws:=ifx shadow then s[0].shadow_draws[..] else s[0].draws[..];first:=cast(int)draws[index*4];if field==0 {return ifx first>=DETAIL_TAG then 4+world_detail_source(s) else -1;}return ifx first>=DETAIL_TAG then first-DETAIL_TAG else first;}
world_catalog :: (s:[]ValleyWorld,b:[]u8) #export_c #effects(all) {
 if b.count<VW_RIG_BYTES+VW_HEADER || b.count>WH_CAP {world_asset(s,0,0);return;}
 n:=cast(int)scan_u32(b,VW_RIG_BYTES+8);if n<1 || n>VW_DRAWS {world_asset(s,0,0);return;}
 core:=VW_RIG_BYTES+VW_HEADER+VW_POINTS*4+n*32;if core>b.count || !vw_catalog_valid(b[VW_RIG_BYTES..<core]) {world_asset(s,0,0);return;}
 // Legacy VWD1 is still read unchanged; the larger VWH1 carrier never enlarges Echo's arena.
 for k:0..<core {s[0].canyon[0].echo[0].data[k]=b[k];}world_asset(s,0,core);s[0].assets[0]=b.count;
 s[0].hierarchy_at=0;s[0].hierarchy_bytes=0;s[0].hierarchy_leaves=0;s[0].hierarchy_nodes=0;
 if b.count>core && wh_valid(b[core..<b.count],n,s[0].indices/4) {
  h:=b[core..<b.count];if wh_bindings(h,s[0].source[0..<n*4]) {s[0].hierarchy_at=core;s[0].hierarchy_bytes=b.count-core;s[0].hierarchy_nodes=cast(int)scan_u32(h,12);for m:0..<cast(int)scan_u32(h,8) {s[0].hierarchy_leaves+=cast(int)scan_u32(h,32+m*24+20);}}
 }
}
world_visible :: (u:[]f32,p:Point,r:f32)->bool {
 q:=sub(p,v3(u[8],u[9],u[10]));z:=dot(q,v3(u[20],u[21],u[22]));
 if z+r<0.05 || z-r>300 {return false;}
 return abs(dot(q,v3(u[12],u[13],u[14])))*u[15]<=z+r*sqrt(1+u[15]*u[15]) && abs(dot(q,v3(u[16],u[17],u[18])))*u[19]<=z+r*sqrt(1+u[19]*u[19]);
}
#test "Valley daylight uses the original CF light direction in Coax axes" {sun:=world_sun();#assert abs(dot(sun,sun)-1)<0.000001 && sun.x>0.77 && sun.y>0.61 && sun.z>0.14;}
world_sun :: ()->Point {return v3(0.7742571472,0.6158125107,0.1459480103);}
#test "World retains offscreen source casters across the shader's doubled depth extent" {u:[128]f32;u[80]=1;u[85]=1;u[90]=1;u[96]=45;#assert world_shadowed(u[..],v3(0,0,-89),1) && world_shadowed(u[..],v3(46,0,0),1);#assert !world_shadowed(u[..],v3(100,0,0),1) && !world_shadowed(u[..],v3(0,0,-92),1);#assert world_inside(u[..],v3(0,0,89),1,true) && !world_inside(u[..],v3(0,0,90),1,true);}
world_shadowed :: (u:[]f32,p:Point,r:f32)->bool {q:=sub(p,v3(u[92],u[93],u[94]));return abs(dot(q,v3(u[80],u[81],u[82])))<=u[96]+r && abs(dot(q,v3(u[84],u[85],u[86])))<=u[96]+r && abs(dot(q,v3(u[88],u[89],u[90])))<=2*u[96]+r;}
// Wholly admitted source spheres need no node decode or local plane transform.
world_inside :: (u:[]f32,p:Point,r:f32,shadow:bool)->bool {
 if shadow {q:=sub(p,v3(u[92],u[93],u[94]));return abs(dot(q,v3(u[80],u[81],u[82])))+r<=u[96] && abs(dot(q,v3(u[84],u[85],u[86])))+r<=u[96] && abs(dot(q,v3(u[88],u[89],u[90])))+r<=2*u[96];}
 q:=sub(p,v3(u[8],u[9],u[10]));z:=dot(q,v3(u[20],u[21],u[22]));return z-r>=0.05 && z+r<=300 && abs(dot(q,v3(u[12],u[13],u[14])))*u[15]+r*sqrt(1+u[15]*u[15])<=z && abs(dot(q,v3(u[16],u[17],u[18])))*u[19]+r*sqrt(1+u[19]*u[19])<=z;
}
world_frame :: (s:[]ValleyWorld,out:[]f32,u:[]f32,w:f32,h:f32,d:f32)->int #export_c #effects(all) {empty:[1]u8;return world_frame_data(s,out,u,w,h,d,empty[0..<0]);}
world_digits :: (out:[]u8,at:int,value:int)->int {n:=at;if value>=10 {n=world_digits(out,n,value/10);}out[n]=cast(u8)('0'+value%10);return n+1;}
world_number :: (out:[]f32,n:int,label:string,value:int,y:f32,pen:HdPen)->int {text:[96]u8;at:=0;for c:label {text[at]=c;at+=1;}at=world_digits(text[..],at,value);return hd_text(out,n,cast(string)text[0..<at],20,y,10,pen,0);}
world_select :: (s:[]ValleyWorld,u:[]f32,b:[]u8,shadow:bool) {
 pass:=ifx shadow then 1 else 0;target:=ifx shadow then s[0].shadow_draws[..] else s[0].draws[..];scene:=target[0..<VW_DRAWS*4];stats:=s[0].selection[pass..<pass+1];stats[0]=WhSelection.{};planes:[6]WhPlane;wh_planes(u,planes[..],shadow);
 use_hierarchy:=s[0].geometry_mode==2 && s[0].hierarchy_bytes>0 && s[0].hierarchy_at<=b.count && s[0].hierarchy_bytes<=b.count-s[0].hierarchy_at;
 if !s[0].canyon[0].portrait {for k:0..<s[0].source_count {at:=k*4;
  if k==s[0].detail[0].chosen && world_detail_source(s)>=0 {info:=detail_info(world_detail_source(s));wh_emit(scene,stats,DETAIL_TAG+info.index_word,info.indices,k+3);stats[0].instances+=1;continue;}
  p:=v3(s[0].bounds[at],s[0].bounds[at+1],s[0].bounds[at+2]);r:=s[0].bounds[at+3];camera:=world_visible(u,p,r);caster:=world_shadowed(u,p,r);
  visible:=s[0].geometry_mode==0 || (ifx shadow then caster else camera);
  if visible {if use_hierarchy && !world_inside(u,p,r,shadow) {wh_select(scene,stats,b[s[0].hierarchy_at..<s[0].hierarchy_at+s[0].hierarchy_bytes],k,planes[..],3);}else {wh_emit(scene,stats,cast(int)s[0].source[at],cast(int)s[0].source[at+1],k+3);stats[0].instances+=1;if use_hierarchy {stats[0].fast+=1;}}}
 }}
 if stats[0].overflow {s[0].fallbacks+=1;stats[0]=WhSelection.{};for k:0..<s[0].source_count {at:=k*4;wh_emit(scene,stats,cast(int)s[0].source[at],cast(int)s[0].source[at+1],k+3);stats[0].instances+=1;}}
 // Valley keeps its own groom extent when sharing the Slay inspector frame.
 for k:1..<3 {for j:0..<4 {target[stats[0].draws*4+j]=s[0].canyon[0].draws[k*4+j];}if k==2 {target[stats[0].draws*4+1]=2957442;}stats[0].draws+=1;}
}
world_frame_data :: (s:[]ValleyWorld,out:[]f32,u:[]f32,w:f32,h:f32,d:f32,b:[]u8)->int #export_c #effects(all) {
 world_start(s);c:=s[0].canyon[..];_:=canyon_frame(c,out,u,w,h,d);s[0].visible=0;s[0].triangles=0;s[0].draw_count=0;
 // This profile uses the original Valley body rig. Slay's morph/shot flags stay clear.
 u[7]=0;u[111]=0;u[112]=0;u[113]=0;u[114]= -1;u[116]=cast(f32)s[0].vertex_word;u[120]=cast(f32)s[0].matrix_word;u[124]=cast(f32)s[0].material_word;
 sun:=world_sun();right:=unit_or(cross(v3(0,1,0),sun),v3(1,0,0));canyon_uniform_point(u,24,sun);canyon_uniform_point(u,80,right);canyon_uniform_point(u,84,cross(sun,right));canyon_uniform_point(u,88,sun);
 feet:=pc.walk_feet(c[0].you);canyon_uniform_point(u,92,v3(feet.x,feet.y,feet.z));if !c[0].portrait {u[96]=45;}
 if s[0].loaded && world_detail_source(s)>=0 {s[0].detail[0].chosen=detail_choose(s[0].detail[..],s[0].source[0..<s[0].source_count*4],s[0].bounds[0..<s[0].source_count*4],DetailView.{eye=v3(u[8],u[9],u[10]),forward=scan_axis(u,20),right=scan_axis(u,12),up=scan_axis(u,16),sx=u[15],sy=u[19]});}
 if s[0].loaded {world_select(s,u,b,false);world_select(s,u,b,true);s[0].draw_count=s[0].selection[0].draws;s[0].shadow_count=s[0].selection[1].draws;s[0].visible=s[0].selection[0].instances;s[0].triangles=s[0].selection[0].indices/3;s[0].shadow_triangles=s[0].selection[1].indices/3;}
 pen:=HdPen.{d=d,top=0,bottom=h/d};n:=hd_text(out,0,"VALLEY LAB / ANCIENT WORLD",110,32,ifx w/d<700 then 10.0f32 else 18.0f32,pen,0);
 n=hd_text_fit(out,n,ifx s[0].loaded then (ifx s[0].source_count==27501 then "ORIGINAL WORLD / ECHO / 250 METRE BASIN" else "PARTIAL SOURCE EXPORT / ECHO / WORK IN PROGRESS") else ifx s[0].failed then "PRIVATE WORLD PACK MISSING OR REFUSED" else "LOADING PRIVATE SOURCE WORLD",20,56,10,w/d-40,pen,1);
 for k:0..<4 {box:=HudBox.{x=16+cast(f32)k*(w/d-32)/4,y=72,width=(w/d-32)/4-4,height=36};n=hd_panel(out,n,box,pen,s[0].station==k);n=hd_text_fit(out,n,[4]string.["2 BASIN","3 WEST","4 EAST","5 NORTH"][k],box.x+6,box.y+23,10,box.width-12,pen,0);}
 if s[0].geometry_stats {n=hd_text(out,n,[3]string.["G / SOURCE REFERENCE","G / CAMERA + SHADOW CUT","G / CLUSTER CUT / DEPTH 3"][s[0].geometry_mode],20,132,10,pen,0);n=world_number(out,n,"COLOR TRIANGLES ",s[0].triangles,152,pen);n=world_number(out,n,"SHADOW TRIANGLES ",s[0].shadow_triangles,172,pen);n=world_number(out,n,"TREE NODES VISITED ",s[0].selection[0].nodes+s[0].selection[1].nodes,192,pen);n=world_number(out,n,"RESIDENT LEAF CLUSTERS ",s[0].hierarchy_leaves,212,pen);n=world_number(out,n,"CONSERVATIVE FALLBACKS ",s[0].fallbacks,232,pen);}
 if s[0].geometry_stats {n=hd_text(out,n,ifx world_detail_source(s)==0 then "K / ORIGINAL SOURCE / Q16" else ifx world_detail_source(s)==1 then "K / ORIGINAL SOURCE / F32 REFERENCE" else "K / ORIGINAL FALLBACK",20,252,10,pen,0);n=world_number(out,n,"DETAIL INSTANCE ",s[0].detail[0].chosen+1,272,pen);}
 n=hd_text(out,n,"1 BACK",20,32,10,pen,1);n=hd_text(out,n,"RESET",w/d-70,32,10,pen,1);
 n=hd_text(out,n,"JUMP",w/d-70,h/d-106,11,pen,1);
 for k:0..<2 {box:=HudBox.{x=16+cast(f32)k*w/d*0.5,y=h/d-82,width=w/d*0.5-32,height=44};n=hd_panel(out,n,box,pen,false);n=hd_text_fit(out,n,ifx k==0 then [4]string.["V / LIT","V / ALBEDO","V / NORMALS","V / ROUGHNESS"][c[0].mode] else "NEXT PART",box.x+8,box.y+28,10,box.width-16,pen,0);}
 n=hd_text_fit(out,n,"WASD MOVE / DRAG LOOK / SPACE JUMP / R RESET / 2-5 VIEWS / C ECHO / G GEOMETRY / K DETAIL / L STATS",20,h/d-20,10,w/d-40,pen,0);
 s[0].meter[0]=budget_meter(WORLD_BUDGET);budget_measure(s[0].meter[..],n+(s[0].triangles+s[0].shadow_triangles)*3+(ifx s[0].loaded then (522009+2957442)*2 else 0),s[0].draw_count+s[0].shadow_count+2,budget_arena_bytes(size_of(ValleyWorld),CANYON_HUD,12,128)+WH_CAP+5*DETAIL_CAP+WORLD_PACK_BYTES+s[0].vertices+s[0].indices+s[0].layers*22369620+cast(int)w*cast(int)h*8);#assert budget_ok(s[0].meter[0]);return n;
}
world_probe :: (s:[]ValleyWorld,f:int)->int #export_c #effects(all) {
 if f==19 {return s[0].detail[0].mode;}if f==20 {return world_detail_source(s);}if f==21 {return (ifx s[0].detail[0].ready[0] then 1 else 0)+(ifx s[0].detail[0].ready[1] then 2 else 0);}if f==22 {return s[0].detail[0].chosen;}if f==23 {return ifx s[0].detail[0].chosen>=0 && world_detail_source(s)>=0 then detail_info(0).indices/3 else 0;}if f==24 {return s[0].detail[0].revision;}if f==25 {return s[0].detail[0].refused;}
 if f==0 {return ifx s[0].loaded then 1 else 0;}if f==1 {return s[0].triangles;}if f==2 {return s[0].visible;}if f==3 {return s[0].source_count;}if f==6 {return s[0].checks;}if f==7 {return ifx s[0].failed then 1 else 0;}
 if f==4 {return s[0].meter[0].used[BUDGET_BYTES]/1024;}if f==5 {return s[0].meter[0].used[BUDGET_VERTICES];}if f==8 {return s[0].draw_count;}
 if f==9 {return s[0].shadow_triangles;}if f==10 {return s[0].shadow_count;}if f==11 {return s[0].hierarchy_leaves;}if f==12 {return s[0].selection[0].nodes+s[0].selection[1].nodes;}if f==13 {return s[0].selection[0].rejected+s[0].selection[1].rejected;}if f==14 {return s[0].geometry_mode;}if f==15 {return s[0].fallbacks;}if f==16 {return s[0].hierarchy_bytes;}if f==17 {return s[0].hierarchy_nodes;}if f==18 {return s[0].selection[0].fast+s[0].selection[1].fast;}
 return canyon_probe(s[0].canyon[..],f);
}
world_pack_gate :: (s:[]ValleyWorld,bytes:int)->bool #export_c #effects(all) {
 s[0].checks+=1;s[0].verified=world_pack_accept(s[0].digest[..],bytes);if !s[0].verified {s[0].failed=true;}return s[0].verified;
}
