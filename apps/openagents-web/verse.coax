// The Verse's way in, drawn by Coax: the landing (openagents.com/verse) and
// the galaxy after it (/verse/galaxy), ported from the playtest's Kiki flow
// (aethyr-cpp frozen/kiki at revision 8, demo/kiki-2026-10-27b).
//
// The landing, as playtest.openagents.com drew it: CREATE YOUR WORLD over
// ENTER THE VERSE, the one line about the house, and PLAYTEST NOW, which
// opens the Haunted House (/realm/haunted-house) directly. No email is asked for; one this browser gave the old
// playtest is still joined again (POST /api/playtest/join, how "return").
//
// The galaxy: the playtest's worlds turning on their orbits, from the realm
// host's table (realms.json, written into realms.coax): an open world opens
// its realm's page (/realm/<slug>), today the Haunted House. Coding is coming
// soon and the rest are locked, as the playtest drew them. A world the table
// doesn't list (the fixture realm) shows only with ?realms=all. Drag turns it. Players' own
// realms (pt-planets) circle outside them, the newest REALMS, and each
// opens its world (/realm/haunted-house#<id>); MAKE YOUR REALM sets one up
// (a name, its kind, look, view and time of day) on the server
// (/api/playtest/planets), or YOUR REALM opens the one you have.
//
// Panels and buttons are plates (realm.coax's look: a dark wood fill and a
// thin bronze line, drawn by verse.wgsl), the words parchment and bronze in
// Filament (font.coax). The host (coax/web/host.js) moves bytes; every
// decision is here. What people do is recorded through analytics.coax.

#load "font.coax";
#load "ui.coax";
#load "textkeys.coax";
#load "analytics.coax";
#load "world.coax";
#load "realms.coax";

VERTEX_FLOATS :: 16;   // x, y, along, across, length, core, light, glow, red, green, blue, mode, 0, 0, 0, 0
MAX_VERTICES :: 40000;
PLATES :: 16;          // the most plates one frame shows
PANEL_AT :: 8;         // width, height, time, fade, still, plates, dpr, 0; then per plate x0, y0, x1, y1, scale, alpha, look, 0
UNIFORM_FLOATS :: PANEL_AT + PLATES * 8;

MODE_STROKE :: 0.0;
MODE_LINK :: 1.0;
MODE_PULSE :: 2.0;
MODE_GLOW_TEXT :: 3.0;
MODE_BAR :: 4.0;
MODE_ORB :: 5.0;   // verse.wgsl: a shaded sphere (the landing's orbs)

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 { return lo(high, hi(low, a)); }
ease :: (x: f32) -> f32 { t := clamp(x, 0, 1); return t * t * (3 - 2 * t); }

// One stroke as a quad wide enough for its glow, as splash.coax draws one.
lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  length := sqrt(dx * dx + dy * dy);
  if length <= 0 { return false; }
  ux := dx / length; uy := dy / length;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, length + r, length + r, -r, length + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = length; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

// A round light: a disc of radius radius in a glow, as graph.coax draws a node.
tinted_dot :: (out: [] f32, at: int, x: f32, y: f32, radius: f32, light: f32, glow: f32, red: f32, green: f32, blue: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count || light <= 0 { return false; }
  r := radius + glow;
  a := [6] f32.[-r, r, r, -r, r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = x + a[v]; out[o + 1] = y + c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = 0; out[o + 5] = radius; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = MODE_STROKE;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

// ---- the page's state, kept by the host

PAGE_LANDING :: 0; PAGE_GALAXY :: 1;
EMAIL_MAX :: 120;          // the playtest's limit
OUTBOX :: 256;
REQ_URL :: 64; REQ_BODY :: 400;
WAIT_JOIN :: 2.5;          // seconds GO waits for the server before going on anyway
TOAST_TIME :: 2.8;
NUDGE_TIME :: 0.7;
MSG_KEPT :: 4;             // host.js: what this app kept in the browser (action 4), on each visit
ACT_KEEP :: 4;             // host.js: keep the outbox's text in this browser

// The landing's buttons and the galaxy's.
BTN_FIELD :: 0; BTN_GO :: 1; BTN_ENTER :: 2;
BTN_HOUSE :: 3; BTN_CODING :: 4;
BTN_REALM :: 5;                        // MAKE YOUR REALM, or YOUR REALM
BTN_NAME :: 6; BTN_CHOICE :: 7;        // the setup: the name box, then a row per choice
BTN_MAKE :: BTN_CHOICE + CHOICES; BTN_BACK :: BTN_MAKE + 1;
BUTTONS :: BTN_BACK + 1;

// A realm's setup, the demo's planet setup (aethyr-cpp tools/serve.py
// PLANET_KINDS, PLANET_CHOICES): what the server keeps, and the words shown.
CHOICES :: 4;
CHOICE_LABEL :: [CHOICES] string.["KIND", "LOOK", "VIEW", "TIME"];
CHOICE_COUNT :: [CHOICES] int.[3, 4, 3, 3];
CHOICE_KEY :: [CHOICES] string.["kind", "art", "cam", "cycle"];
CHOICE_VALUE :: [13] string.["forest", "village", "cemetery", "Low poly", "Painted", "Pixel", "Ink",
                             "Third person", "First person", "Top down", "Day/night cycle", "Always day", "Always night"];
CHOICE_SHOWN :: [13] string.["FOREST", "VILLAGE", "CEMETERY", "LOW POLY", "PAINTED", "PIXEL", "INK",
                             "THIRD PERSON", "FIRST PERSON", "TOP DOWN", "DAY AND NIGHT", "ALWAYS DAY", "ALWAYS NIGHT"];
CHOICE_AT :: [CHOICES] int.[0, 3, 7, 10];
REALMS :: 8; REALM_ID :: 64; REALM_NAME :: 40; NAME_MAX :: 40;
REALM_ORBIT :: 0.53f32;
// The galaxy's requests, one at a time: the realm you have, the realms, a
// player key for a browser that has none, and the setup's.
WANT_MINE :: 1; WANT_LIST :: 2; WANT_PLAYER :: 4; WANT_MAKE :: 8;
HTTP_PLAYER :: 8;          // host.js: send this browser's playtest player key
ACT_PLAYER :: 5;           // host.js: keep the outbox as the browser's playtest player

// The landing's notes under the box.
NOTE_NONE :: 0; NOTE_BAD :: 1; NOTE_EMPTY :: 2;

VerseState :: struct {
  started: bool;
  time: f32; width: f32; height: f32; dpr: f32; still: bool;
  page: int;                 // PAGE_* (the host sets it: data-page)
  touch: bool;               // the last pointer was a finger
  press: int; press_id: int; hover: int;
  boxes: [BUTTONS] Box; shown: [BUTTONS] bool;
  // the landing
  email: [EMAIL_MAX] u8; email_n: int;
  kept: [EMAIL_MAX] u8; kept_n: int;   // the email this browser gave on an earlier visit
  focused: bool; typed_at: f32; opened: bool;
  note: int; nudge_at: f32;
  landed: bool;              // the page's step event is sent
  going: bool; going_at: f32; join_id: int; answered: bool;
  orbs: [ORBS] Orb; orb_n: int; orb_id: int; seeded: bool; orb_acc: f32;
  hold: Orb; holding: bool; hold_at: f32;   // the orb being made under a press
  dt: f32;                   // this frame's seconds, for the orbs
  near: bool; near_x: f32; near_y: f32;    // the mouse, which the orbs drift toward (CSS pixels)
  bounced: [BOUNCED] int; bounced_n: int;  // pairs (a id * 65536 + b id) that have bounced once
  sparks: [SPARKS] Spark; spark_n: int; luck: f32;
  // the galaxy
  rot: f32; tilt: f32; spun: bool;
  down: bool; down_id: int; down_x: f32; down_y: f32; drag_rot: f32; drag_tilt: f32; moved: f32;
  over: int;                 // the planet under the mouse, or the one a first tap picked (-1 none)
  all: bool;                 // ?realms=all: unlisted worlds too
  toast: [96] u8; toast_n: int; toast_at: f32;
  // players' realms, newest first, and yours
  realm_ids: [REALMS * REALM_ID] u8; realm_id_n: [REALMS] int;
  realm_names: [REALMS * REALM_NAME] u8; realm_name_n: [REALMS] int; realm_kind: [REALMS] int; realm_n: int;
  mine: [REALM_ID] u8; mine_n: int; mine_name: [REALM_NAME] u8; mine_name_n: int;
  player: [32] u8; player_n: int;  // this browser's playtest player's public id (the page facts', or a new one)
  wants: int; want_out: int; want_id: int;   // WANT_* still to ask, the one out and its request id
  realm_total: int; counted: bool;          // how many realms the server has, once asked
  setup: bool; name: [NAME_MAX] u8; name_n: int; picks: [CHOICES] int; making: bool;
  typed_all: bool;   // Cmd+A: all of the focused box (the email or the realm's name) is selected (textkeys.coax)
  // to the host: one request, the keyboard field, an action
  req_url: [REQ_URL] u8; req_url_n: int; req_body: [REQ_BODY] u8; req_body_n: int; req_flags: int; req_ready: bool;
  field: [4] f32;
  outbox: [OUTBOX] u8; out_n: int; action: int;
  next: [OUTBOX] u8; next_n: int;   // where to go once the action before it is taken
  plates: [PLATES] Box; plate_look: [PLATES] f32; plate_alpha: [PLATES] f32; plate_n: int;
}

// Which page (the host's data-page), before anything else.
verse_page :: (s: [] VerseState, page: int) #export_c {
  if !s[0].started { verse_reset(s); }
  s[0].page = ifx page == PAGE_GALAXY then PAGE_GALAXY else PAGE_LANDING;
}

verse_reset :: (s: [] VerseState) {
  s[0].started = true;
  s[0].press = -1; s[0].press_id = -1; s[0].hover = -1; s[0].over = -1; s[0].join_id = -1; s[0].want_id = -1;
  s[0].wants = WANT_MINE | WANT_LIST; s[0].picks[0] = 2;
  s[0].rot = 0.6; s[0].tilt = 0.42; s[0].nudge_at = -100; s[0].toast_at = -100;
}

email_text :: (s: [] VerseState) -> string { return cast(string) s[0].email[0..<s[0].email_n]; }
kept_text :: (s: [] VerseState) -> string { return cast(string) s[0].kept[0..<s[0].kept_n]; }

// An email as the server takes it (verse.api's check): something, one @,
// then two or more dot-separated parts, no spaces, at most 120 bytes.
email_ok :: (text: string) -> bool {
  if text.count < 5 || text.count > EMAIL_MAX { return false; }
  at := -1;
  for i: 0..<text.count {
    c := text[i];
    if c <= 32 || c >= 127 { return false; }
    if c == '@' { if at >= 0 { return false; } at = i; }
  }
  if at < 1 { return false; }
  dots := 0; part := 0;
  for i: at + 1..<text.count {
    if text[i] == '.' { if part == 0 { return false; } dots += 1; part = 0; } else { part += 1; }
  }
  return dots >= 1 && part > 0;
}

// A byte an email may hold as typed: printable ASCII without quotes or
// backslashes (so the request's JSON needs no escapes), lowercase.
email_byte :: (c: int) -> int {
  if c < 33 || c > 126 || c == '"' || c == '\\' || c == '<' || c == '>' { return -1; }
  if c >= 'A' && c <= 'Z' { return c + 32; }
  return c;
}

email_type :: (s: [] VerseState, text: string) {
  if s[0].typed_all { s[0].email_n = 0; s[0].typed_all = false; }
  for i: 0..<text.count {
    c := email_byte(cast(int) text[i]);
    if c >= 0 && s[0].email_n < EMAIL_MAX { s[0].email[s[0].email_n] = cast(u8) c; s[0].email_n += 1; }
  }
  s[0].typed_at = s[0].time; s[0].note = NOTE_NONE;
}

// Cmd or Ctrl with A, C or X in a focused box holding text (textkeys.coax):
// whether it was one. Cutting empties the box through n.
box_command :: (s: [] VerseState, cmd: int, text: string, n: [] int) -> bool {
  if cmd == TK_ALL { s[0].typed_all = text.count > 0; return true; }
  if cmd != TK_COPY && cmd != TK_CUT { return false; }
  if s[0].typed_all {
    act(s, TK_ACT_COPY, text);
    if cmd == TK_CUT { n[0] = 0; s[0].typed_all = false; }
  }
  return true;
}

// ---- out to the host

act :: (s: [] VerseState, action: int, text: string) { s[0].out_n = put(s[0].outbox[..], 0, text); s[0].action = action; }
// Go to url once the action waiting (if any) is taken.
go_to :: (s: [] VerseState, url: string) { s[0].next_n = put(s[0].next[..], 0, url); }

// One request to this site (the face hands it to coaxial_http).
request :: (s: [] VerseState, url: string, flags: int) {
  s[0].req_url_n = put(s[0].req_url[..], 0, url); s[0].req_flags = flags; s[0].req_ready = true;
}
verse_requested :: (s: [] VerseState, id: int) #export_c {
  s[0].req_ready = false;
  if s[0].want_id == -2 { s[0].want_id = id; if id < 0 { realm_answered(s, "0\n"); } }
  if s[0].going && s[0].join_id == -2 { s[0].join_id = id; if id < 0 { s[0].answered = true; } }
}

// The join: {email, player, sid, how}, as the playtest sent it.
join :: (s: [] VerseState, t: [] Track, how: string, wanted: bool) {
  b := s[0].req_body[..]; n := 0;
  n = put(b, n, "{\"email\":\""); n = put(b, n, email_text(s));
  n = put(b, n, "\",\"player\":\""); n = put(b, n, cast(string) t[0].pid[0..<t[0].pid_n]);
  n = put(b, n, "\",\"sid\":\""); n = put(b, n, cast(string) t[0].sid[0..<t[0].sid_n]);
  n = put(b, n, "\",\"how\":\""); n = put(b, n, how); n = put(b, n, "\"}");
  s[0].req_body_n = n;
  request(s, "/api/playtest/join", ifx wanted then HTTP_POST | HTTP_ANSWER else HTTP_POST);
}

// ---- what a press does

// PLAYTEST NOW: straight into the Haunted House, as a guest (or as the email given before).
enter :: (s: [] VerseState, t: [] Track) {
  if s[0].going { return; }
  s[0].note = NOTE_NONE; s[0].focused = false;
  s[0].going = true; s[0].going_at = s[0].time; s[0].answered = true;
  if track_begin(t, "start") { track_str(t, "how", ifx s[0].kept_n > 0 then "email" else "guest"); track_str(t, "to", "house"); track_end(t); }
  go_to(s, PLANET_PATH[HOUSE]);
}

focus :: (s: [] VerseState, t: [] Track) {
  s[0].focused = true; s[0].typed_at = s[0].time;
  if !s[0].opened { s[0].opened = true; track(t, "join-open"); }
}

// The planet p was picked (via the map or its tag).
pick :: (s: [] VerseState, t: [] Track, p: int, via: string) {
  open := realm_kind_at(s, p) == KIND_OPEN;
  if track_begin(t, "planet-click") { track_str(t, "planet", realm_id_at(s, p)); track_str(t, "via", via); track_bool(t, "open", open); track_end(t); }
  if p >= PLANETS { open_realm(s, realm_id_at(s, p)); return; }
  if open {
    if s[0].next_n == 0 && s[0].action == 0 { s[0].answered = true; go_to(s, PLANET_PATH[p]); }
    return;
  }
  n := 0;
  if PLANET_KIND[p] == KIND_SOON {
    n = put(s[0].toast[..], 0, PLANET_NAME[p]); n = put(s[0].toast[..], n, " IS COMING SOON. THE HAUNTED HOUSE IS OPEN NOW.");
  } else {
    n = put(s[0].toast[..], 0, PLANET_NAME[p]); n = put(s[0].toast[..], n, " IS LOCKED FOR THE PLAYTEST");
  }
  s[0].toast_n = n; s[0].toast_at = s[0].time;
}

press_button :: (s: [] VerseState, t: [] Track, b: int) {
  if b == BTN_ENTER { enter(s, t); return; }
  if b == BTN_HOUSE { pick(s, t, HOUSE, "tag"); return; }
  if b == BTN_CODING { pick(s, t, CODING, "tag"); return; }
  if b == BTN_REALM { realm_button(s, t); return; }
  if b == BTN_NAME { s[0].focused = true; return; }
  if b >= BTN_CHOICE && b < BTN_CHOICE + CHOICES { c := b - BTN_CHOICE; s[0].picks[c] = (s[0].picks[c] + 1) % CHOICE_COUNT[c]; return; }
  if b == BTN_MAKE { make_realm(s, t); return; }
  if b == BTN_BACK { s[0].setup = false; s[0].focused = false; }
}

// ---- input

// A key: a code point, or a named key below zero (ui.coax KEY_*).
verse_key :: (s: [] VerseState, t: [] Track, key: int, mods: int) -> bool #export_c {
  if s[0].page == PAGE_GALAXY { return setup_key(s, t, key, mods) || world_key(s, t, key); }
  if s[0].page != PAGE_LANDING || s[0].going { return false; }
  if key == KEY_ENTER { enter(s, t); return true; }
  return false;
}

// Typed or pasted text (kind 1), what this browser kept (4), and the join's answer.
verse_message :: (s: [] VerseState, t: [] Track, kind: int, bytes: string) #export_c {
  if kind == MSG_TEXT && s[0].page == PAGE_GALAXY { if s[0].setup { name_type(s, bytes); } return; }
  if kind >= HTTP_KIND && kind < HTTP_KIND + HTTPS && kind - HTTP_KIND == s[0].want_id && s[0].want_out != 0 {
    s[0].want_id = -1; realm_answered(s, bytes); return;
  }
  if kind == MSG_TEXT {
    return;
  }
  if kind == MSG_KEPT {
    n := 0;
    for i: 0..<bytes.count { c := email_byte(cast(int) bytes[i]); if c >= 0 && n < EMAIL_MAX { s[0].kept[n] = cast(u8) c; n += 1; } }
    s[0].kept_n = ifx email_ok(cast(string) s[0].kept[0..<n]) then n else 0;
    if s[0].email_n == 0 { for i: 0..<s[0].kept_n { s[0].email[i] = s[0].kept[i]; } s[0].email_n = s[0].kept_n; }
    return;
  }
  if kind >= HTTP_KIND && kind < HTTP_KIND + HTTPS && kind - HTTP_KIND == s[0].join_id { s[0].answered = true; s[0].join_id = -1; }
}

// The planet at (x, y) (-1 none): of those in reach, the one whose middle
// is nearest for its size, so a small world in front of a big one's glow
// still answers.
planet_at :: (s: [] VerseState, x: f32, y: f32) -> int {
  best := -1; score := 1.0e9f32;
  for p: 0..<PLANETS + s[0].realm_n {
    if !planet_shown(s, p) { continue; }
    q := project(s, p);
    reach := hi(q.r * 1.5, 22 * s[0].dpr);
    dx := q.x - x; dy := q.y - y;
    near := (dx * dx + dy * dy) / (reach * reach);
    if near < 1 && near < score { best = p; score = near; }
  }
  return best;
}

// The button at (x, y), of those drawn last frame (-1 none).
button_at :: (s: [] VerseState, x: f32, y: f32) -> int {
  slop := 4 * s[0].dpr;
  for i: 0..<BUTTONS {
    if !s[0].shown[i] { continue; }
    b := s[0].boxes[i];
    if x >= b.x0 - slop && x <= b.x1 + slop && y >= b.y0 - slop && y <= b.y1 + slop { return i; }
  }
  return -1;
}

// The pointer in device pixels: phase 0 down, 1 move, 2 up, 3 cancel; kind 0 a mouse, 1 a finger or pen.
verse_pointer :: (s: [] VerseState, t: [] Track, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c {
  if phase == POINTER_DOWN { s[0].touch = kind != 0; }
  b := button_at(s, x, y);
  galaxy := s[0].page == PAGE_GALAXY;
  // on the galaxy an open world under the pointer wins over a tag lying across it
  if galaxy && b >= 0 && !s[0].setup && b != BTN_REALM { under := planet_at(s, x, y); if under >= 0 && realm_kind_at(s, under) == KIND_OPEN { b = -1; } }
  s[0].hover = ifx kind == 0 && phase != POINTER_CANCEL then b else -1;
  if galaxy && kind == 0 && !s[0].down { s[0].over = ifx b < 0 then planet_at(s, x, y) else -1; }
  if phase == POINTER_DOWN {
    if b >= 0 { s[0].press = b; s[0].press_id = id; return true; }
    if galaxy && s[0].setup { s[0].focused = false; return true; }
    if galaxy {
      s[0].down = true; s[0].down_id = id; s[0].down_x = x; s[0].down_y = y;
      s[0].drag_rot = s[0].rot; s[0].drag_tilt = s[0].tilt; s[0].moved = 0;
      return true;
    }
    // the landing: a press in the stars starts an orb, growing while held
    if !s[0].going { orb_hold(s, x, y); }
    return true;
  }
  if s[0].press >= 0 && id == s[0].press_id {
    if phase == POINTER_UP && b == s[0].press { press_button(s, t, b); }
    if phase != POINTER_MOVE { s[0].press = -1; s[0].press_id = -1; }
    return true;
  }
  if !galaxy {
    k := hi(s[0].dpr, 0.5);
    if phase == POINTER_MOVE {
      s[0].near = kind == 0; s[0].near_x = x / k; s[0].near_y = y / k;
      if s[0].holding { s[0].hold.x = x / k; s[0].hold.y = y / k; }
    } else { orb_drop(s); if phase == POINTER_CANCEL { s[0].near = false; } }
    return kind == 0 || s[0].holding;
  }
  if galaxy && s[0].down && id == s[0].down_id {
    k := hi(s[0].dpr, 0.5);
    if phase == POINTER_MOVE {
      s[0].moved = hi(s[0].moved, abs(x - s[0].down_x) + abs(y - s[0].down_y));
      if s[0].moved > 6 * k {
        s[0].rot = s[0].drag_rot + (x - s[0].down_x) / k * 0.006;
        s[0].tilt = clamp(s[0].drag_tilt + (y - s[0].down_y) / k * 0.004, 0.12, 1.2);
        s[0].spun = true;
      }
      return true;
    }
    s[0].down = false;
    if phase == POINTER_UP && s[0].moved <= 6 * k {
      p := planet_at(s, x, y);
      if p >= 0 {
        // a finger's first tap on a planet names it; the next opens it
        if kind != 0 && s[0].over != p { s[0].over = p; } else { pick(s, t, p, "map"); }
      } else if kind != 0 { s[0].over = -1; }
    }
    return true;
  }
  return kind == 0;
}

verse_wants_text :: (s: [] VerseState) -> bool #export_c {
  if s[0].page == PAGE_GALAXY { return s[0].setup && s[0].focused && !s[0].making; }
  return s[0].page == PAGE_LANDING && s[0].focused && !s[0].going;
}
verse_cursor :: (s: [] VerseState) -> int #export_c {
  if s[0].hover >= 0 || s[0].press >= 0 { return 1; }
  if s[0].page == PAGE_LANDING { return 2; }   // the playtest's crosshair over the orbs
  if s[0].page == PAGE_GALAXY && s[0].over >= 0 && realm_kind_at(s, s[0].over) == KIND_OPEN { return 1; }
  return 0;
}
// What the pointer is over, for the click event.
verse_label :: (s: [] VerseState, x: f32, y: f32) -> string #export_c {
  b := button_at(s, x, y);
  if b == BTN_FIELD { return "email"; }
  if b == BTN_GO { return "go"; }
  if b == BTN_ENTER { return "enter"; }
  if b == BTN_HOUSE { return "house-tag"; }
  if b == BTN_CODING { return "coding-tag"; }
  if b == BTN_REALM { return ifx s[0].mine_n > 0 then "your-realm" else "make-realm"; }
  if b == BTN_NAME { return "realm-name"; }
  if b >= BTN_CHOICE && b < BTN_CHOICE + CHOICES { return CHOICE_KEY[b - BTN_CHOICE]; }
  if b == BTN_MAKE { return "realm-make"; }
  if b == BTN_BACK { return "realm-back"; }
  if s[0].page == PAGE_GALAXY && !s[0].setup { p := planet_at(s, x, y); if p >= 0 { return realm_id_at(s, p); } }
  return "";
}
verse_action :: (s: [] VerseState) -> int #export_c { a := s[0].action; s[0].action = 0; return a; }
verse_action_done :: (s: [] VerseState) #export_c { for i: 0..<OUTBOX { s[0].outbox[i] = 0; } s[0].out_n = 0; }

// ---- the galaxy's worlds (the playtest's map, app.js galaxy.bodies)

// PLANETS and PLANET_* are realms.coax's; these two have tags of their own.
HOUSE :: 1; CODING :: 5;
ORBITS :: [6] f32.[0.15, 0.26, 0.3, 0.34, 0.42, 0.46];

Seen :: struct { x: f32; y: f32; r: f32; depth: f32; }

// Where planet p is on the screen now, in device pixels: the playtest's
// projection (a tilted disc, nearer is bigger), the house turning on its own.
project :: (s: [] VerseState, p: int) -> Seen {
  w := s[0].width; h := s[0].height;
  m := lo(w, h) * 0.95; cx := w * 0.5; cy := h * 0.55;
  orbit := REALM_ORBIT; size := 0.024f32;
  a := 0.35f32 + cast(f32) (p - PLANETS) * 6.2831853 / cast(f32) REALMS;
  if p < PLANETS { a = PLANET_A[p]; orbit = PLANET_R[p]; size = PLANET_SIZE[p]; }
  if p == HOUSE { a = ifx s[0].still then 1.2f32 else s[0].time * 0.3; }
  x := orbit * cos(a + s[0].rot); z := orbit * sin(a + s[0].rot);
  depth := z * cos(s[0].tilt);
  k := 1 / (1 + depth * 0.9);
  return Seen.{x = cx + x * m * k, y = cy + z * sin(s[0].tilt) * m * k, r = size * m * k, depth = depth};
}

// The galaxy's worlds and then players' realms (p from PLANETS).
planet_shown :: (s: [] VerseState, p: int) -> bool { return p >= PLANETS || PLANET_LISTED[p] || s[0].all; }
realm_kind_at :: (s: [] VerseState, p: int) -> int { return ifx p >= PLANETS then KIND_OPEN else PLANET_KIND[p]; }
realm_id_at :: (s: [] VerseState, p: int) -> string {
  if p < PLANETS { return PLANET_ID[p]; }
  i := p - PLANETS;
  return cast(string) s[0].realm_ids[i * REALM_ID..<i * REALM_ID + s[0].realm_id_n[i]];
}
realm_name_at :: (s: [] VerseState, p: int) -> string {
  if p < PLANETS { return PLANET_NAME[p]; }
  i := p - PLANETS;
  return cast(string) s[0].realm_names[i * REALM_NAME..<i * REALM_NAME + s[0].realm_name_n[i]];
}

// ---- players' realms (pt-planets): the server's /api/playtest/planets

KIND_TINT_R :: [3] f32.[0.45, 0.95, 0.72];   // forest, village, cemetery
KIND_TINT_G :: [3] f32.[0.85, 0.78, 0.62];
KIND_TINT_B :: [3] f32.[0.52, 0.45, 0.98];

realm_kind_of :: (kind: string) -> int {
  if kind == "forest" { return 0; }
  if kind == "village" { return 1; }
  return 2;
}
mine_text :: (s: [] VerseState) -> string { return cast(string) s[0].mine[0..<s[0].mine_n]; }
name_text :: (s: [] VerseState) -> string { return cast(string) s[0].name[0..<s[0].name_n]; }
player_text :: (s: [] VerseState) -> string { return cast(string) s[0].player[0..<s[0].player_n]; }

// A world's name for the map: unescaped, printable, at most REALM_NAME bytes.
realm_name_into :: (raw: string, out: [] u8) -> int {
  buf: [160] u8;
  n := world_unescape(raw, buf[..]);
  o := 0;
  for i: 0..<n { c := buf[i]; if c >= 32 && c < 127 && o < out.count { out[o] = c; o += 1; } }
  return o;
}

// The page facts' player (its public id; the key stays in the browser).
verse_facts :: (s: [] VerseState, facts: string) #export_c {
  if !s[0].started { verse_reset(s); }
  s[0].all = text_has(fact_of(facts, "url"), "realms=all");
  id := fact_of(facts, "player");
  if !world_id_ok(id) || id.count > 32 { return; }
  for i: 0..<id.count { s[0].player[i] = id[i]; }
  s[0].player_n = id.count;
}

open_realm :: (s: [] VerseState, id: string) {
  if s[0].next_n > 0 || s[0].action != 0 || !world_id_ok(id) { return; }
  n := put(s[0].next[..], 0, "/realm/haunted-house#");
  s[0].next_n = put(s[0].next[..], n, id);
  s[0].answered = true; s[0].going_at = s[0].time;
}

// MAKE YOUR REALM opens the setup; YOUR REALM opens the one you have.
realm_button :: (s: [] VerseState, t: [] Track) {
  if s[0].mine_n > 0 {
    if track_begin(t, "planet-click") { track_str(t, "planet", mine_text(s)); track_str(t, "via", "your-realm"); track_bool(t, "open", true); track_end(t); }
    open_realm(s, mine_text(s));
    return;
  }
  s[0].setup = true; s[0].focused = true; s[0].typed_at = s[0].time; s[0].typed_all = false;
  track(t, "planet-setup");
}

// CREATE: a player key first if this browser has none, then the realm.
make_realm :: (s: [] VerseState, t: [] Track) {
  if s[0].making { return; }
  s[0].making = true; s[0].focused = false;
  s[0].wants = s[0].wants | (ifx s[0].player_n > 0 then WANT_MAKE else WANT_PLAYER);
  if track_begin(t, "planet-create") {
    for c: 0..<CHOICES { track_str(t, CHOICE_KEY[c], CHOICE_VALUE[CHOICE_AT[c] + s[0].picks[c]]); }
    track_end(t);
  }
}

name_byte :: (c: int) -> int {
  if c < 32 || c > 126 || c == '"' || c == '\\' || c == '<' || c == '>' { return -1; }
  return c;
}
name_type :: (s: [] VerseState, text: string) {
  if s[0].making { return; }
  if s[0].typed_all { s[0].name_n = 0; s[0].typed_all = false; }
  for i: 0..<text.count {
    c := name_byte(cast(int) text[i]);
    if c >= 0 && s[0].name_n < NAME_MAX { s[0].name[s[0].name_n] = cast(u8) c; s[0].name_n += 1; }
  }
  s[0].focused = true; s[0].typed_at = s[0].time; s[0].typed_all = false;
}

// The galaxy's keys: the setup's name box, ENTER to create, ESCAPE to close.
setup_key :: (s: [] VerseState, t: [] Track, key: int, mods: int) -> bool {
  if !s[0].setup { return false; }
  if key == KEY_ESCAPE { s[0].setup = false; s[0].focused = false; return true; }
  if s[0].making { return true; }
  if key == KEY_ENTER { make_realm(s, t); return true; }
  if !s[0].focused && key > 32 && key < 127 && mods & (MOD_CTRL | MOD_META) == 0 { s[0].focused = true; }
  if !s[0].focused { return false; }
  n: [1] int; n[0] = s[0].name_n;
  if box_command(s, tk_command(key, mods), name_text(s), n[..]) { s[0].name_n = n[0]; return true; }
  if key == KEY_BACKSPACE { s[0].name_n = ifx s[0].typed_all then 0 else tk_back(name_text(s), mods); s[0].typed_all = false; s[0].typed_at = s[0].time; return true; }
  if key < 32 { s[0].typed_all = false; }
  if key > 0 && key < 127 && mods & (MOD_CTRL | MOD_META) == 0 {
    buf: [4] u8; buf[0] = cast(u8) key;
    name_type(s, cast(string) buf[0..<1]);
    return true;
  }
  return false;
}

// The galaxy without a pointer: LEFT and RIGHT step through the open worlds
// it shows (the table's order, then players' realms), ENTER opens the one
// chosen, as a click on it would.
world_key :: (s: [] VerseState, t: [] Track, key: int) -> bool {
  if s[0].setup { return false; }
  if key == KEY_ENTER && s[0].over >= 0 { pick(s, t, s[0].over, "key"); return true; }
  if key != KEY_LEFT && key != KEY_RIGHT { return false; }
  n := PLANETS + s[0].realm_n;
  step := ifx key == KEY_RIGHT then 1 else n - 1;
  p := ifx s[0].over >= 0 then s[0].over else ifx key == KEY_RIGHT then n - 1 else 0;
  for i: 0..<n {
    p = (p + step) % n;
    if planet_shown(s, p) && realm_kind_at(s, p) == KIND_OPEN { s[0].over = p; return true; }
  }
  return false;
}

// The next of the galaxy's requests, one at a time.
realm_ask :: (s: [] VerseState) {
  if s[0].wants & WANT_MINE != 0 && s[0].player_n == 0 { s[0].wants -= WANT_MINE; }
  bit := 0;
  order := [4] int.[WANT_MINE, WANT_LIST, WANT_PLAYER, WANT_MAKE];
  for b: 0..<4 { if s[0].wants & order[b] != 0 { bit = order[b]; break; } }
  if bit == 0 { return; }
  s[0].wants -= bit; s[0].want_out = bit; s[0].want_id = -2;
  s[0].req_body_n = 0;
  if bit == WANT_MINE { request(s, "/api/playtest/planets/mine", HTTP_ANSWER | HTTP_PLAYER); return; }
  if bit == WANT_LIST {
    u := s[0].req_url[..];
    n := put(u, 0, "/api/playtest/planets?after=");
    after := ifx s[0].counted then s[0].realm_total - REALMS else 1000000000;
    n = put_int(u, n, ifx after < 0 then 0 else after);
    s[0].req_url_n = n; s[0].req_flags = HTTP_ANSWER; s[0].req_ready = true;
    return;
  }
  if bit == WANT_PLAYER {
    s[0].req_body_n = put(s[0].req_body[..], 0, "{}");
    request(s, "/api/playtest/player", HTTP_POST | HTTP_ANSWER);
    return;
  }
  b := s[0].req_body[..]; n := 0;
  n = put(b, n, "{\"user\":{\"id\":\""); n = put(b, n, player_text(s));
  n = put(b, n, "\",\"name\":\"Guest\"},\"settings\":{\"name\":\""); n = put(b, n, name_text(s)); n = put(b, n, "\"");
  for c: 0..<CHOICES {
    n = put(b, n, ",\""); n = put(b, n, CHOICE_KEY[c]); n = put(b, n, "\":\"");
    n = put(b, n, CHOICE_VALUE[CHOICE_AT[c] + s[0].picks[c]]); n = put(b, n, "\"");
  }
  n = put(b, n, "}}");
  s[0].req_body_n = n;
  request(s, "/api/playtest/planets", HTTP_POST | HTTP_ANSWER | HTTP_PLAYER);
}

realm_say :: (s: [] VerseState, text: string) { s[0].toast_n = put(s[0].toast[..], 0, text); s[0].toast_at = s[0].time; }

// A planet object's id, name and kind into slot i of the map's realms.
realm_keep :: (s: [] VerseState, t: string, obj: int, i: int) -> bool {
  at: [1] int;
  idn := world_field(t, obj, "id", at[..]);
  if at[0] < 0 || !world_id_ok(t[at[0]..<at[0] + idn]) || idn > REALM_ID { return false; }
  for k: 0..<idn { s[0].realm_ids[i * REALM_ID + k] = t[at[0] + k]; }
  s[0].realm_id_n[i] = idn;
  nn := world_field(t, obj, "name", at[..]);
  s[0].realm_name_n[i] = ifx at[0] >= 0 then realm_name_into(t[at[0]..<at[0] + nn], s[0].realm_names[i * REALM_NAME..<(i + 1) * REALM_NAME]) else 0;
  kn := world_field(t, obj, "kind", at[..]);
  s[0].realm_kind[i] = ifx at[0] >= 0 then realm_kind_of(t[at[0]..<at[0] + kn]) else 2;
  return true;
}

// A galaxy request's answer ("STATUS\n" and the body; "0\n" none).
realm_answered :: (s: [] VerseState, bytes: string) {
  w := s[0].want_out; s[0].want_out = 0; s[0].want_id = -1;
  ok := bytes.count > 4 && bytes[0..<4] == "200\n";
  t := ifx ok then bytes[4..<bytes.count] else "";
  o := world_space(t, 0);
  at: [1] int;
  if w == WANT_MINE {
    if !ok { return; }
    pn := world_field(t, o, "planet", at[..]);
    if at[0] < 0 || t[at[0]] != '{' { return; }
    p := at[0];
    idn := world_field(t, p, "id", at[..]);
    if at[0] < 0 || idn > REALM_ID || !world_id_ok(t[at[0]..<at[0] + idn]) { return; }
    for k: 0..<idn { s[0].mine[k] = t[at[0] + k]; } s[0].mine_n = idn;
    nn := world_field(t, p, "name", at[..]);
    s[0].mine_name_n = ifx at[0] >= 0 then realm_name_into(t[at[0]..<at[0] + nn], s[0].mine_name[..]) else 0;
    return;
  }
  if w == WANT_LIST {
    if !ok { return; }
    nn := world_field(t, o, "n", at[..]);
    if at[0] >= 0 { s[0].realm_total = fact_int(t[at[0]..<at[0] + nn]); }
    if !s[0].counted { s[0].counted = true; if s[0].realm_total > 0 { s[0].wants = s[0].wants | WANT_LIST; } return; }
    an := world_field(t, o, "planets", at[..]);
    if at[0] < 0 || t[at[0]] != '[' { return; }
    // newest last on the wire: the last REALMS, newest first on the map
    starts: [64] int; count := 0;
    i := world_space(t, at[0] + 1);
    while i < t.count && t[i] == '{' && count < 64 {
      e := world_value_end(t, i);
      if e < 0 { break; }
      starts[count] = i; count += 1;
      i = world_space(t, e);
      if i < t.count && t[i] == ',' { i = world_space(t, i + 1); }
    }
    kept := 0;
    j := count - 1;
    while j >= 0 && kept < REALMS { if realm_keep(s, t, starts[j], kept) { kept += 1; } j -= 1; }
    s[0].realm_n = kept;
    return;
  }
  if w == WANT_PLAYER {
    idn := world_field(t, o, "id", at[..]);
    if !ok || at[0] < 0 || idn > 32 || !world_id_ok(t[at[0]..<at[0] + idn]) || t.count > OUTBOX {
      s[0].making = false; realm_say(s, "THAT DIDN'T REACH THE SERVER. TRY AGAIN."); return;
    }
    for k: 0..<idn { s[0].player[k] = t[at[0] + k]; } s[0].player_n = idn;
    act(s, ACT_PLAYER, t);
    s[0].wants = s[0].wants | WANT_MAKE;
    return;
  }
  if w == WANT_MAKE {
    s[0].making = false;
    idn := world_field(t, o, "id", at[..]);
    if !ok || at[0] < 0 || idn > REALM_ID || !world_id_ok(t[at[0]..<at[0] + idn]) {
      realm_say(s, ifx bytes.count > 4 && bytes[0..<4] == "403\n" then "THAT REALM ISN'T YOURS TO SET UP" else "THAT DIDN'T REACH THE SERVER. TRY AGAIN.");
      return;
    }
    for k: 0..<idn { s[0].mine[k] = t[at[0] + k]; } s[0].mine_n = idn;
    s[0].setup = false;
    open_realm(s, mine_text(s));
  }
}

// ---- the look (realm.coax's): change it here

GAP :: 0.5;       // letter gap, in cap heights
SPACE :: 1.2;     // a space, in cap heights
WIDE :: 1.1;      // the eyebrows' wide spacing
PARCH_R :: 0.91; PARCH_G :: 0.863; PARCH_B :: 0.753;   // #e8dcc0, words
GOLD_R :: 0.80; GOLD_G :: 0.64; GOLD_B :: 0.36;        // bronze
EMBER_R :: 0.91; EMBER_G :: 0.47; EMBER_B :: 0.17;     // the Haunted House's orange, the focus
LOOK_PLAIN :: 0.0; LOOK_LIT :: 1.0; LOOK_HOVER :: 2.0;

white :: (k: f32, light: f32) -> Ink { return ink(0.55 * k, light, 1.2 * k, PARCH_R, PARCH_G, PARCH_B); }
bronze :: (k: f32, light: f32) -> Ink { return ink(0.55 * k, light, 1.2 * k, GOLD_R, GOLD_G, GOLD_B); }
ember :: (k: f32, light: f32) -> Ink { return ink(0.55 * k, light, 1.4 * k, EMBER_R, EMBER_G, EMBER_B); }

plate :: (s: [] VerseState, b: Box, alpha: f32, look: f32) {
  n := s[0].plate_n;
  if n >= PLATES { return; }
  s[0].plates[n] = b; s[0].plate_alpha[n] = alpha; s[0].plate_look[n] = look; s[0].plate_n = n + 1;
}
button_look :: (s: [] VerseState, i: int, lit_up: bool) -> f32 {
  look: f32 = ifx lit_up then LOOK_LIT else LOOK_PLAIN;
  if s[0].press == i || s[0].hover == i { look += LOOK_HOVER; }
  return look;
}

// A space for a letter gap: wide-spaced words keep a clear space between them.
space_for :: (gap: f32) -> f32 { return hi(SPACE, gap * 2.4); }
centred :: (d: f32, out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, gap: f32, k: Ink) -> int {
  w := measure(text, gap, space_for(gap), false) * cap;
  return write(d, out, at, text, x - w * 0.5, base, cap, gap, space_for(gap), k, false, false);
}
// The largest cap up to cap at which text fits width.
fit_cap :: (text: string, cap: f32, gap: f32, width: f32) -> f32 { return lo(cap, width / hi(measure(text, gap, space_for(gap), false), 0.001)); }

// A button: its plate and its label, centred.
plate_button :: (s: [] VerseState, out: [] f32, at: int, i: int, b: Box, label: string, lit_up: bool) -> int {
  k := s[0].dpr;
  s[0].boxes[i] = b; s[0].shown[i] = true;
  plate(s, b, 0.92, button_look(s, i, lit_up));
  size := fit_cap(label, 9 * k, GAP, b.x1 - b.x0 - 16 * k);
  return centred(k, out, at, label, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + size * 0.5, size, GAP, white(k, 0.95));
}

// An ellipse as a closed line of segments.
ring :: (out: [] f32, at: int, cx: f32, cy: f32, rx: f32, ry: f32, segments: int, core: f32, light: f32, glow: f32,
         red: f32, green: f32, blue: f32) -> int {
  vertices := at;
  if light <= 0 { return vertices; }
  step := 6.2831853 / cast(f32) segments;
  for i: 0..<segments {
    a := cast(f32) i * step; b := a + step;
    if lit(out, vertices, cx + rx * cos(a), cy + ry * sin(a), cx + rx * cos(b), cy + ry * sin(b), core, light, glow, red, green, blue, MODE_STROKE) { vertices += 6; }
  }
  return vertices;
}

// The OpenAgents mark (the power symbol) and the word, top left.
brand :: (s: [] VerseState, out: [] f32, at: int, word: string) -> int {
  k := s[0].dpr;
  x := 16 * k + 8 * k; y := 16 * k + 9 * k; r := 6 * k;
  vertices := at;
  landing := s[0].page == PAGE_LANDING;
  mr: f32 = ifx landing then CONTENT else PARCH_R; mg: f32 = ifx landing then CONTENT else PARCH_G; mb: f32 = ifx landing then CONTENT else PARCH_B;
  for i: 0..<24 {
    a := -1.5707963 + 0.6 + cast(f32) i * (6.2831853 - 1.2) / 24.0;
    b := a + (6.2831853 - 1.2) / 24.0;
    if lit(out, vertices, x + r * cos(a), y + r * sin(a), x + r * cos(b), y + r * sin(b), 0.7 * k, 0.9, 1.5 * k, mr, mg, mb, MODE_STROKE) { vertices += 6; }
  }
  if lit(out, vertices, x, y - r - 1.5 * k, x, y - 1 * k, 0.7 * k, 0.9, 1.5 * k, mr, mg, mb, MODE_STROKE) { vertices += 6; }
  if s[0].page == PAGE_LANDING { return write(k, out, vertices, "OpenAgents", x + r + 10 * k, y + 5 * k, sans_cap(14) * k, GAP, SPACE, sans_ink(CONTENT), false, false); }
  return write(k, out, vertices, word, x + r + 10 * k, y + 4.5 * k, 9 * k, GAP, SPACE, white(k, 0.95), false, false);
}

// ---- the landing's orbs (the playtest's app.js orbs, revision 9)
// Faint grey worlds pulling on each other behind the hero. A press in the
// stars makes one that grows while held and joins the rest when let go;
// two that touch bounce once, then merge in a burst of sparks; each trails
// sparks as it moves and drifts toward the mouse. Every number is the
// playtest's ORB, in CSS pixels per frame at 60 fps.

ORBS :: 41; SPARKS :: 900; BOUNCED :: 128;
Orb :: struct { id: int; x: f32; y: f32; r: f32; vx: f32; vy: f32; }
Spark :: struct { x: f32; y: f32; vx: f32; vy: f32; life: f32; max: f32; size: f32; }

ORB_GRAVITY :: 0.22; ORB_SOFTENING :: 500.0; ORB_KICK :: 0.9; ORB_SWIRL :: 0.22;
ORB_POINTER :: 0.00035; ORB_DRAG :: 0.998; ORB_WALL :: 0.75; ORB_BOUNCE :: 0.7; ORB_MAX_SPEED :: 9.0;
ORB_HOLD_START :: 3.0; ORB_HOLD_GROW_MS :: 28.0; ORB_HOLD_MAX :: 46.0; ORB_MERGED_MAX :: 64.0;
ORB_TRAIL_EVERY :: 0.6; ORB_TRAIL_LIFE :: 40.0; ORB_BURST :: 34; ORB_BURST_SPEED :: 3.2; ORB_BURST_LIFE :: 55.0;
ORB_DUST_EVERY :: 0.9; ORB_DUST_NEAR :: 50.0; ORB_DUST_FAR :: 150.0; ORB_DUST_SPEED :: 2.2;
ORB_ALPHA :: 0.4;
SPARK_R :: 1.0; SPARK_G :: 0.824; SPARK_B :: 0.627;   // 255, 210, 160

// A number in [0, 1), the same run every visit.
luck :: (s: [] VerseState) -> f32 {
  s[0].luck += 1;
  v := sin(s[0].luck * 12.9898 + 78.233) * 43758.5453;
  return v - floor(v);
}
new_orb :: (s: [] VerseState, x: f32, y: f32, r: f32) -> Orb { s[0].orb_id += 1; return Orb.{id = s[0].orb_id, x = x, y = y, r = r}; }

// Sends orb i sideways around the biggest other orb, into an orbit.
orb_kick :: (s: [] VerseState, i: int) {
  big := -1;
  for j: 0..<s[0].orb_n { if j != i && (big < 0 || s[0].orbs[j].r > s[0].orbs[big].r) { big = j; } }
  if big < 0 { return; }
  a := s[0].orbs[i]; b := s[0].orbs[big];
  dx := a.x - b.x; dy := a.y - b.y; d := hi(sqrt(dx * dx + dy * dy), 0.0001);
  v := ORB_KICK * sqrt(ORB_GRAVITY * b.r * b.r / sqrt(d * d + ORB_SOFTENING));
  s[0].orbs[i].vx += -dy / d * v; s[0].orbs[i].vy += dx / d * v;
}
orb_seed :: (s: [] VerseState, w: f32, h: f32) {
  s[0].seeded = true; s[0].orb_n = 4;
  s[0].orbs[0] = new_orb(s, w * 0.5, h * 0.7, 24);
  s[0].orbs[1] = new_orb(s, w * 0.22, h * 0.32, 9);
  s[0].orbs[2] = new_orb(s, w * 0.78, h * 0.66, 7);
  s[0].orbs[3] = new_orb(s, w * 0.7, h * 0.22, 5);
  for i: 1..<4 { orb_kick(s, i); }
}
// A press at (x, y), device pixels.
orb_hold :: (s: [] VerseState, x: f32, y: f32) {
  k := hi(s[0].dpr, 0.5);
  s[0].hold = new_orb(s, x / k, y / k, ORB_HOLD_START); s[0].holding = true; s[0].hold_at = s[0].time;
}
orb_drop :: (s: [] VerseState) {
  if !s[0].holding { return; }
  s[0].holding = false;
  if s[0].orb_n >= ORBS - 1 { for i: 1..<s[0].orb_n { s[0].orbs[i - 1] = s[0].orbs[i]; } s[0].orb_n -= 1; }
  s[0].orbs[s[0].orb_n] = s[0].hold; s[0].orb_n += 1;
  orb_kick(s, s[0].orb_n - 1);
}
spark :: (s: [] VerseState, x: f32, y: f32, vx: f32, vy: f32, life: f32, size: f32) {
  if s[0].spark_n >= SPARKS { return; }
  s[0].sparks[s[0].spark_n] = Spark.{x = x, y = y, vx = vx, vy = vy, life = life, max = life, size = size}; s[0].spark_n += 1;
}
bounced_once :: (s: [] VerseState, key: int) -> bool {
  for i: 0..<s[0].bounced_n { if s[0].bounced[i] == key { return true; } }
  return false;
}
// One frame of the playtest's step, in a w x h CSS pixel hero.
orb_step :: (s: [] VerseState, w: f32, h: f32) {
  calm := s[0].still;
  if s[0].holding {
    s[0].hold.r = lo(ORB_HOLD_MAX, ORB_HOLD_START + (s[0].time - s[0].hold_at) * 1000 / ORB_HOLD_GROW_MS);
    // dust drifts in toward the orb being made
    if !calm && luck(s) < ORB_DUST_EVERY {
      a := luck(s) * 6.2831853; d := s[0].hold.r + ORB_DUST_NEAR + luck(s) * (ORB_DUST_FAR - ORB_DUST_NEAR);
      spark(s, s[0].hold.x + cos(a) * d, s[0].hold.y + sin(a) * d, -cos(a) * ORB_DUST_SPEED, -sin(a) * ORB_DUST_SPEED, (d - s[0].hold.r) / ORB_DUST_SPEED, 2);
    }
  }
  n := s[0].orb_n;
  for i: 0..<n {
    a := s[0].orbs[i];
    for j: 0..<n {
      if i == j { continue; }
      b := s[0].orbs[j];
      dx := b.x - a.x; dy := b.y - a.y; d2 := dx * dx + dy * dy + ORB_SOFTENING; d := sqrt(d2);
      f := ORB_GRAVITY * b.r * b.r / d2;
      a.vx += f * (dx - ORB_SWIRL * dy) / d; a.vy += f * (dy + ORB_SWIRL * dx) / d;
    }
    if s[0].near && !s[0].holding { a.vx += (s[0].near_x - a.x) * ORB_POINTER; a.vy += (s[0].near_y - a.y) * ORB_POINTER; }
    a.vx *= ORB_DRAG; a.vy *= ORB_DRAG;
    sp := sqrt(a.vx * a.vx + a.vy * a.vy);
    if sp > ORB_MAX_SPEED { a.vx *= ORB_MAX_SPEED / sp; a.vy *= ORB_MAX_SPEED / sp; }
    s[0].orbs[i] = a;
  }
  for i: 0..<n {
    a := s[0].orbs[i];
    a.x += a.vx; a.y += a.vy;
    if a.x < a.r || a.x > w - a.r { a.vx *= -ORB_WALL; a.x = clamp(a.x, a.r, hi(a.r, w - a.r)); }
    if a.y < a.r || a.y > h - a.r { a.vy *= -ORB_WALL; a.y = clamp(a.y, a.r, hi(a.r, h - a.r)); }
    s[0].orbs[i] = a;
    // a trail of sparks behind each moving orb
    sp := sqrt(a.vx * a.vx + a.vy * a.vy);
    if !calm && luck(s) < ORB_TRAIL_EVERY * lo(1, sp / 2) {
      back := a.r / hi(sp, 0.0001);
      jx := (luck(s) - 0.5) * a.r * 0.6; jy := (luck(s) - 0.5) * a.r * 0.6;
      spark(s, a.x - a.vx * back + jx, a.y - a.vy * back + jy, -a.vx * 0.15 + (luck(s) - 0.5) * 0.3, -a.vy * 0.15 + (luck(s) - 0.5) * 0.3,
            ORB_TRAIL_LIFE * (0.6 + luck(s) * 0.6), 1.4 + a.r * 0.06);
    }
  }
  // touching orbs bounce apart first, then merge into one
  i := 0;
  while i < s[0].orb_n {
    j := s[0].orb_n - 1;
    while j > i {
      a := s[0].orbs[i]; b := s[0].orbs[j];
      dx := b.x - a.x; dy := b.y - a.y; d := hi(sqrt(dx * dx + dy * dy), 0.0001); touch := (a.r + b.r) * 0.92;
      if d > touch { j -= 1; continue; }
      key := ifx a.id < b.id then a.id * 65536 + b.id else b.id * 65536 + a.id;
      ma := a.r * a.r; mb := b.r * b.r; m := ma + mb;
      if !bounced_once(s, key) {
        nx := dx / d; ny := dy / d; closing := (a.vx - b.vx) * nx + (a.vy - b.vy) * ny;
        if closing > 0 {
          q := (1 + ORB_BOUNCE) * closing / m;
          a.vx -= q * mb * nx; a.vy -= q * mb * ny; b.vx += q * ma * nx; b.vy += q * ma * ny;
          s[0].bounced[s[0].bounced_n % BOUNCED] = key; s[0].bounced_n = lo_i(s[0].bounced_n + 1, BOUNCED);
          for e: 0..<8 { if calm { break; } spark(s, a.x + nx * a.r, a.y + ny * a.r, (luck(s) - 0.5) * 2.4, (luck(s) - 0.5) * 2.4, 26, 1.2); }
        }
        push := (touch - d) / 2;
        a.x -= nx * push; a.y -= ny * push; b.x += nx * push; b.y += ny * push;
        s[0].orbs[i] = a; s[0].orbs[j] = b;
        j -= 1; continue;
      }
      a.vx = (a.vx * ma + b.vx * mb) / m; a.vy = (a.vy * ma + b.vy * mb) / m;
      a.x = (a.x * ma + b.x * mb) / m; a.y = (a.y * ma + b.y * mb) / m;
      a.r = lo(ORB_MERGED_MAX, sqrt(m));
      for e: 0..<ORB_BURST {
        if calm { break; }
        ang := luck(s) * 6.2831853; v := ORB_BURST_SPEED * (0.3 + luck(s));
        spark(s, a.x + cos(ang) * a.r, a.y + sin(ang) * a.r, cos(ang) * v + a.vx, sin(ang) * v + a.vy, ORB_BURST_LIFE * (0.5 + luck(s) * 0.7), 1 + luck(s) * 1.6);
      }
      s[0].orbs[i] = a;
      for o: j + 1..<s[0].orb_n { s[0].orbs[o - 1] = s[0].orbs[o]; }
      s[0].orb_n -= 1;
      j -= 1;
    }
    i += 1;
  }
  // the sparks drift, slow and fade
  live := 0;
  for e: 0..<s[0].spark_n {
    p := s[0].sparks[e];
    p.x += p.vx; p.y += p.vy; p.vx *= 0.97; p.vy *= 0.97; p.life -= 1;
    if p.life > 0 { s[0].sparks[live] = p; live += 1; }
  }
  s[0].spark_n = live;
}
lo_i :: (a: int, b: int) -> int { if a < b { return a; } return b; }

// The orbs at 60 steps a second whatever the frame rate, and drawn.
draw_orbs :: (s: [] VerseState, out: [] f32, at: int, dt: f32) -> int {
  k := hi(s[0].dpr, 0.5); w := s[0].width / k; h := s[0].height / k;
  if !s[0].seeded { orb_seed(s, w, h); }
  s[0].orb_acc = lo(s[0].orb_acc + clamp(dt, 0, 0.1), 0.1);
  // still (reduced motion, or the release walk's golden): they move only while a press makes one
  moving := !s[0].still || s[0].holding;
  while s[0].orb_acc >= 1.0 / 60.0 { s[0].orb_acc -= 1.0 / 60.0; if moving { orb_step(s, w, h); } }
  vertices := at;
  for e: 0..<s[0].spark_n {
    p := s[0].sparks[e];
    if tinted_dot(out, vertices, p.x * k, p.y * k, p.size * 0.5 * k, (p.life / p.max) * 0.85, 0.5 * k, SPARK_R, SPARK_G, SPARK_B) { vertices += 6; }
  }
  for i: 0..<s[0].orb_n + (ifx s[0].holding then 1 else 0) {
    a := ifx i < s[0].orb_n then s[0].orbs[i] else s[0].hold;
    if orb_dot(out, vertices, a.x * k, a.y * k, a.r * k) { vertices += 6; }
    // the thin ring around each, 4 pixels out
    rr := (a.r + 4) * k;
    vertices = ring(out, vertices, a.x * k, a.y * k, rr, rr, 48, 0.5 * k, 0.16 * 0.93 * ORB_ALPHA, 0.6 * k, 1, 1, 1);
  }
  return vertices;
}
// One orb: the shaded sphere and its faint halo (verse.wgsl MODE_ORB).
orb_dot :: (out: [] f32, at: int, x: f32, y: f32, radius: f32) -> bool {
  if !tinted_dot(out, at, x, y, radius, ORB_ALPHA, radius, 1, 1, 1) { return false; }
  for v: 0..<6 { out[(at + v) * VERTEX_FLOATS + 11] = MODE_ORB; }
  return true;
}

// ---- the landing

TITLE :: "ENTER THE VERSE";
TITLE_1 :: "ENTER"; TITLE_2 :: "THE VERSE";
EYEBROW :: "CREATE YOUR WORLD";
column :: (s: [] VerseState) -> f32 { return lo(400 * s[0].dpr, s[0].width - 32 * s[0].dpr); }   // the realm setup's panel
LEDE :: "Edit our haunted house. Can you make it scarier?";
LEDE_1 :: "Edit our haunted house.";
LEDE_2 :: "Can you make it scarier?";
PLAY :: "PLAYTEST NOW";
LOOK_HUD :: 4.0;   // verse.wgsl: the playtest's glass bar button (hud-button.js)
EYEBROW_GREY :: 0.604;   // #9a9aa0, the eyebrow
CONTENT :: 0.93;   // #ededed, the words

grey :: (k: f32, light: f32, c: f32) -> Ink { return ink(0.55 * k, light, 1.2 * k, c, c, c * 1.02); }
// The playtest's Geist, as the system sans (font.coax), px CSS pixels tall.
sans_ink :: (c: f32) -> Ink { return Ink.{core = 0, light = 1, glow = 0, red = c, green = c, blue = c, mode = MODE_SANS, sans = true}; }
sans_cap :: (px: f32) -> f32 { return px * SANS_CAP / SANS_SCALE; }
centred_sans :: (d: f32, out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return write(d, out, at, text, x - ink_width(text, cap, GAP, SPACE, k) * 0.5, base, cap, GAP, SPACE, k, false, false);
}

// Where the hero's lines sit, as the playtest's CSS lays them out: a grid of
// the eyebrow, the title, the lede and the button, gap 18, centred on the
// screen (on a short screen no eyebrow, gap 10 and a 56-pixel button).
Hero :: struct { eyebrow: f32; title: f32; title_cap: f32; title_lines: int; lede: f32; lines: int; lede_cap: f32; button: Box; low: bool; }
hero :: (s: [] VerseState) -> Hero {
  k := s[0].dpr; w := s[0].width / k; h := s[0].height / k;
  o: Hero;
  o.low = h <= 520;
  gap := ifx o.low then 10.0f32 else 18.0f32;
  font := ifx o.low then 24.0f32 else clamp(w * 0.044, 22, 44);   // clamp(22px, 4.4vw, 44px)
  // too wide for one line, the title breaks after ENTER (the playtest's text-wrap: balance)
  // (when the playtest's Michroma line, about 16.8 ems with its .22em spacing, wouldn't fit)
  o.title_lines = ifx font * 16.8 > w - 32 then 2 else 1;
  o.title_cap = fit_cap(ifx o.title_lines == 2 then TITLE_2 else TITLE, font * 0.9, 0.62, w - 32) * k;
  o.lede_cap = sans_cap(ifx o.low then 14.0f32 else 16.0f32);
  o.lines = ifx sans_width(LEDE, sans_em(o.lede_cap)) > w - 32 then 2 else 1;
  bh := ifx o.low then 56.0f32 else 64.0f32;
  bw := lo(360, w - 64);
  eyebrow_h := ifx o.low then 0.0f32 else 13.0f32;
  title_h := font * 1.45 * cast(f32) o.title_lines; lede_h := 25.6 * cast(f32) o.lines;
  total := eyebrow_h + (ifx o.low then 0.0f32 else gap) + title_h + gap + lede_h + gap + 8 + bh;
  top := ifx o.low then 36 + (h - 36 - total) * 0.5 else (h - total) * 0.5;
  y := top;
  o.eyebrow = (y + eyebrow_h * 0.5 + 4) * k;
  if !o.low { y += eyebrow_h + gap; }
  o.title = (y + font * 1.45 * 0.5) * k + o.title_cap * 0.5;
  y += title_h + gap;
  o.lede = (y + 12.8) * k + o.lede_cap * k * 0.5;
  y += lede_h + gap + 8;
  cx := w * 0.5;
  o.button = Box.{x0 = (cx - bw * 0.5) * k, y0 = y * k, x1 = (cx + bw * 0.5) * k, y1 = (y + bh) * k};
  o.lede_cap *= k;
  return o;
}

draw_landing :: (s: [] VerseState, out: [] f32, at: int) -> int {
  k := s[0].dpr; d := k; w := s[0].width; cx := w * 0.5;
  vertices := draw_orbs(s, out, at, s[0].dt);
  vertices = brand(s, out, vertices, "OPENAGENTS");
  o := hero(s);
  if !o.low {
    eyebrow := fit_cap(EYEBROW, 7.5 * k, WIDE, w - 32 * k);
    vertices = centred(d, out, vertices, EYEBROW, cx, o.eyebrow, eyebrow, WIDE, grey(k, 0.95, EYEBROW_GREY));
  }
  title_ink := ink(1.25 * k * o.title_cap / (30 * k), 1, 4 * k, CONTENT, CONTENT, CONTENT);
  if o.title_lines == 1 { vertices = centred(d, out, vertices, TITLE, cx, o.title, o.title_cap, 0.62, title_ink); }
  else {
    line := (o.title_cap / k / 0.9) * 1.45 * k;   // the font's line height
    vertices = centred(d, out, vertices, TITLE_1, cx, o.title, o.title_cap, 0.62, title_ink);
    vertices = centred(d, out, vertices, TITLE_2, cx, o.title + line, o.title_cap, 0.62, title_ink);
  }
  if o.lines == 1 { vertices = centred_sans(d, out, vertices, LEDE, cx, o.lede, o.lede_cap, sans_ink(CONTENT)); }
  else {
    vertices = centred_sans(d, out, vertices, LEDE_1, cx, o.lede, o.lede_cap, sans_ink(CONTENT));
    vertices = centred_sans(d, out, vertices, LEDE_2, cx, o.lede + 25.6 * k, o.lede_cap, sans_ink(CONTENT));
  }
  // PLAYTEST NOW: the glass bar (verse.wgsl draws it), its words in wide capitals
  b := o.button;
  s[0].boxes[BTN_ENTER] = b; s[0].shown[BTN_ENTER] = true;
  plate(s, b, 1, LOOK_HUD + (ifx s[0].press == BTN_ENTER then 2.0f32 else ifx s[0].hover == BTN_ENTER then 1.0f32 else 0.0f32));
  cap := fit_cap(PLAY, (b.y1 - b.y0) * 0.26 * 0.86, WIDE * 0.62, b.x1 - b.x0 - 32 * k);
  vertices = centred(d, out, vertices, PLAY, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + cap * 0.5, cap, WIDE * 0.62, ink(0.85 * k, 1, 1.6 * k, 0.97, 0.97, 0.98));
  return vertices;
}

// ---- the galaxy

draw_galaxy :: (s: [] VerseState, out: [] f32, at: int) -> int {
  k := s[0].dpr; d := k; w := s[0].width; h := s[0].height; cx := w * 0.5;
  vertices := at;
  phone := s[0].touch || w < 640 * k;
  vertices = write(d, out, vertices, "THE VERSE", 16 * k, 16 * k + 13 * k, 9 * k, WIDE * 0.6, space_for(WIDE * 0.6), white(k, 0.95), false, false);
  // who you are, top right: the email given, else a guest
  who := ifx s[0].kept_n > 0 then kept_text(s) else "GUEST";
  wcap := 8 * k;
  ww := lo(measure(who, GAP, SPACE, false) * wcap + 28 * k, w * 0.5);
  wb := Box.{x0 = w - 16 * k - ww, y0 = 14 * k, x1 = w - 16 * k, y1 = 44 * k};
  plate(s, wb, 0.85, LOOK_PLAIN);
  vertices = draw_fit(d, out, vertices, who, wb.x0 + 14 * k, (wb.y0 + wb.y1) * 0.5 + wcap * 0.5, wcap, GAP, SPACE, white(k, 0.9), ww - 28 * k);
  vertices = centred(d, out, vertices, "GALAXY", cx, 82 * k, 9 * k, WIDE, bronze(k, 0.9));

  // the orbits, then the worlds
  m := lo(w, h) * 0.95; cy := h * 0.55;
  for o: 0..<6 {
    r := ORBITS[o] * m;
    vertices = ring(out, vertices, cx, cy, r, r * sin(s[0].tilt), 72, 0.5 * k, 0.13, 1 * k, 0.93, 0.93, 0.95);
  }
  pulse := ifx s[0].still then 0.35f32 else (s[0].time / 1.6) - floor(s[0].time / 1.6);
  // the setup covers the middle: its worlds wait behind it, unlit
  shown_planets := ifx s[0].setup then 0 else PLANETS;
  shown_realms := ifx s[0].setup then 0 else s[0].realm_n;
  for p: 0..<shown_planets {
    if !planet_shown(s, p) { continue; }
    q := project(s, p);
    if PLANET_KIND[p] == KIND_OPEN {
      if tinted_dot(out, vertices, q.x, q.y, 0.1, 3.2, q.r * 3.4, EMBER_R, EMBER_G, EMBER_B) { vertices += 6; }
      if tinted_dot(out, vertices, q.x, q.y, q.r * 0.5, 1, q.r * 0.6, 0.94, 0.85, 0.75) { vertices += 6; }
      // a ring swells out of the house and fades, over and over
      vertices = ring(out, vertices, q.x, q.y, q.r * (1.1 + pulse * 2.2), q.r * (1.1 + pulse * 2.2), 40, 0.9 * k, 0.85 * (1 - pulse), 2 * k, EMBER_R, EMBER_G, EMBER_B);
    } else {
      bright := ifx PLANET_KIND[p] == KIND_SOON then 1.0f32 else 0.55f32;
      if tinted_dot(out, vertices, q.x, q.y, 0.1, 2.2 * bright, q.r * 3.0, 0.93, 0.93, 0.95) { vertices += 6; }
      if tinted_dot(out, vertices, q.x, q.y, q.r * 0.75 * 0.55, bright, q.r * 0.5, 0.95, 0.95, 0.96) { vertices += 6; }
    }
    if s[0].over == p { vertices = ring(out, vertices, q.x, q.y, q.r * 1.4 + 2 * k, q.r * 1.4 + 2 * k, 40, 0.6 * k, 0.6, 1.5 * k, 0.93, 0.93, 0.95); }
  }
  // players' realms on the outer orbit, tinted by their kind
  if s[0].realm_n > 0 {
    r := REALM_ORBIT * m;
    vertices = ring(out, vertices, cx, cy, r, r * sin(s[0].tilt), 96, 0.5 * k, 0.1, 1 * k, GOLD_R, GOLD_G, GOLD_B);
  }
  for i: 0..<shown_realms {
    p := PLANETS + i; q := project(s, p); c := s[0].realm_kind[i];
    if tinted_dot(out, vertices, q.x, q.y, 0.1, 2.4, q.r * 3.0, KIND_TINT_R[c], KIND_TINT_G[c], KIND_TINT_B[c]) { vertices += 6; }
    if tinted_dot(out, vertices, q.x, q.y, q.r * 0.5, 1, q.r * 0.6, KIND_TINT_R[c], KIND_TINT_G[c], KIND_TINT_B[c]) { vertices += 6; }
    if s[0].over == p { vertices = ring(out, vertices, q.x, q.y, q.r * 1.4 + 2 * k, q.r * 1.4 + 2 * k, 40, 0.6 * k, 0.6, 1.5 * k, 0.93, 0.93, 0.95); }
  }
  // MAKE YOUR REALM, or YOUR REALM once you have one
  realm_label := ifx s[0].mine_n > 0 then "YOUR REALM" else "MAKE YOUR REALM";
  rw := measure(realm_label, GAP, SPACE, false) * 8 * k + 36 * k;
  vertices = plate_button(s, out, vertices, BTN_REALM, Box.{x0 = cx - rw * 0.5, y0 = 96 * k, x1 = cx + rw * 0.5, y1 = 124 * k}, realm_label, true);

  // the tags under the worlds that answer (the house opens; Coding says when)
  tcap := ifx phone then 7 * k else 8 * k;
  for which: 0..<2 {
    if s[0].setup { break; }
    p := ifx which == 0 then HOUSE else CODING;
    i := ifx which == 0 then BTN_HOUSE else BTN_CODING;
    if s[0].over == p { continue; }
    label := "CODING · COMING SOON";
    if which == 0 { label = ifx phone then "HAUNTED HOUSE · TAP TO ENTER" else "HAUNTED HOUSE · CLICK TO ENTER"; }
    q := project(s, p);
    tw := measure(label, GAP, SPACE, false) * tcap + 24 * k;
    top := q.y + q.r * 1.5 + 6 * k;
    b := Box.{x0 = q.x - tw * 0.5, y0 = top, x1 = q.x + tw * 0.5, y1 = top + 26 * k};
    if b.x0 < 8 * k { b.x1 += 8 * k - b.x0; b.x0 = 8 * k; }
    if b.x1 > w - 8 * k { b.x0 -= b.x1 - (w - 8 * k); b.x1 = w - 8 * k; }
    s[0].boxes[i] = b; s[0].shown[i] = true;
    plate(s, b, 0.9, button_look(s, i, which == 0));
    vertices = centred(d, out, vertices, label, (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + tcap * 0.5, tcap, GAP, ifx which == 0 then ember(k, 1) else white(k, 0.9));
  }
  // the world under the pointer: its name and whether it opens
  if s[0].over >= 0 && !s[0].setup {
    p := s[0].over; q := project(s, p);
    name := realm_name_at(s, p);
    state := "LOCKED";
    if realm_kind_at(s, p) == KIND_SOON { state = "COMING SOON"; }
    if realm_kind_at(s, p) == KIND_OPEN { state = ifx phone then "OPEN · TAP AGAIN TO ENTER" else "OPEN"; }
    if p >= PLANETS { state = ifx phone then "A PLAYER'S REALM · TAP AGAIN TO ENTER" else "A PLAYER'S REALM · OPEN"; }
    lw := hi(measure(name, GAP, SPACE, false) * 9 * k, measure(state, GAP, SPACE, false) * 7 * k) + 28 * k;
    bottom := q.y - q.r - 10 * k;
    b := Box.{x0 = q.x - lw * 0.5, y0 = bottom - 46 * k, x1 = q.x + lw * 0.5, y1 = bottom};
    if b.x0 < 8 * k { b.x1 += 8 * k - b.x0; b.x0 = 8 * k; }
    if b.x1 > w - 8 * k { b.x0 -= b.x1 - (w - 8 * k); b.x1 = w - 8 * k; }
    plate(s, b, 0.92, LOOK_PLAIN);
    vertices = write(d, out, vertices, name, b.x0 + 14 * k, b.y0 + 21 * k, 9 * k, GAP, SPACE, white(k, 0.97), false, false);
    vertices = write(d, out, vertices, state, b.x0 + 14 * k, b.y0 + 37 * k, 7 * k, GAP, SPACE,
                     ifx realm_kind_at(s, p) == KIND_OPEN then ember(k, 0.95) else bronze(k, 0.85), false, false);
  }
  if s[0].setup { vertices = draw_setup(s, out, vertices); }

  // what to do, at the bottom
  hint := ifx s[0].spun then 0.45f32 else 0.7f32;
  line1 := "DRAG TO TURN THE GALAXY";
  line2 := ifx phone then "TAP THE ORANGE PLANET TO ENTER" else "CLICK THE ORANGE PLANET, THE HAUNTED HOUSE, TO ENTER";
  hc := lo(fit_cap(line1, 7.5 * k, GAP, w - 32 * k), fit_cap(line2, 7.5 * k, GAP, w - 32 * k));
  vertices = centred(d, out, vertices, line1, cx, h - 74 * k, hc, GAP, white(k, hint));
  vertices = centred(d, out, vertices, line2, cx, h - 56 * k, hc, GAP, white(k, hint));

  // a world that doesn't open says so for a moment
  shown := 1 - ease((s[0].time - s[0].toast_at - TOAST_TIME) / 0.4);
  if s[0].toast_n > 0 && s[0].time - s[0].toast_at < TOAST_TIME + 0.4 {
    say := cast(string) s[0].toast[0..<s[0].toast_n];
    room := w - 32 * k;
    lines := line_total(say, 8.5 * k, room - 28 * k, GAP, SPACE, false);
    tw := lo(measure(say, GAP, SPACE, false) * 8.5 * k + 28 * k, room);
    th := 18 * k + cast(f32) lines * 16 * k;
    b := Box.{x0 = cx - tw * 0.5, y0 = h - 110 * k - th, x1 = cx + tw * 0.5, y1 = h - 110 * k};
    plate(s, b, 0.95 * shown, LOOK_LIT);
    used: [1] f32;
    vertices = draw_wrapped(d, out, vertices, say, b.x0 + 14 * k, b.y0 + 9 * k, 8.5 * k, GAP, SPACE, white(k, shown), tw - 28 * k, 16 * k, false, true, used[..]);
  }
  return vertices;
}

// The setup: a name, then a row per choice (a press cycles it), CREATE and CANCEL.
setup_box :: (s: [] VerseState) -> Box {
  k := s[0].dpr; w := column(s); cx := s[0].width * 0.5; cy := s[0].height * 0.55;
  return Box.{x0 = cx - w * 0.5, y0 = cy - 160 * k, x1 = cx + w * 0.5, y1 = cy + 160 * k};
}
draw_setup :: (s: [] VerseState, out: [] f32, at: int) -> int {
  k := s[0].dpr; d := k;
  b := setup_box(s);
  plate(s, b, 0.96, LOOK_PLAIN);
  vertices := write(d, out, at, "MAKE YOUR REALM", b.x0 + 16 * k, b.y0 + 26 * k, 8 * k, WIDE, space_for(WIDE), bronze(k, 0.95), false, false);
  vertices = write(d, out, vertices, "NAME", b.x0 + 16 * k, b.y0 + 52 * k, 7 * k, GAP, SPACE, white(k, 0.6), false, false);
  f := Box.{x0 = b.x0 + 14 * k, y0 = b.y0 + 60 * k, x1 = b.x1 - 14 * k, y1 = b.y0 + 98 * k};
  s[0].boxes[BTN_NAME] = f; s[0].shown[BTN_NAME] = true;
  focused := s[0].focused && !s[0].making;
  plate(s, f, 0.95, ifx focused || s[0].hover == BTN_NAME then LOOK_LIT else LOOK_PLAIN);
  cap := 10 * k; base := (f.y0 + f.y1) * 0.5 + cap * 0.5; left := f.x0 + 12 * k;
  text := name_text(s);
  if text.count == 0 && !focused {
    vertices = write(d, out, vertices, "A NAME FOR YOUR REALM", left, base, cap, GAP, SPACE, white(k, 0.32), false, false);
  } else {
    vertices = draw_fit(d, out, vertices, text, left, base, cap, GAP, SPACE, ifx s[0].typed_all then ember(k, 0.97) else white(k, 0.97), f.x1 - f.x0 - 24 * k);
    since := s[0].time - s[0].typed_at;
    if focused && (s[0].still || since / 1.06 - floor(since / 1.06) < 0.5) {
      x := floor(left + lo(measure(text, GAP, SPACE, false) * cap + GAP * 0.6 * cap, f.x1 - f.x0 - 24 * k)) + 0.5;
      if lit(out, vertices, x, base + 2 * k, x, base - cap - 3 * k, 0.5 * k, 1, 3 * k, EMBER_R, EMBER_G, EMBER_B, MODE_STROKE) { vertices += 6; }
    }
  }
  for c: 0..<CHOICES {
    top := b.y0 + 110 * k + cast(f32) c * 38 * k;
    vertices = write(d, out, vertices, CHOICE_LABEL[c], b.x0 + 16 * k, top + 19 * k, 7 * k, WIDE, space_for(WIDE), white(k, 0.6), false, false);
    cb := Box.{x0 = b.x0 + 100 * k, y0 = top, x1 = b.x1 - 14 * k, y1 = top + 30 * k};
    vertices = plate_button(s, out, vertices, BTN_CHOICE + c, cb, CHOICE_SHOWN[CHOICE_AT[c] + s[0].picks[c]], false);
  }
  half := (b.x1 - b.x0 - 40 * k) * 0.5;
  make := Box.{x0 = b.x0 + 14 * k, y0 = b.y1 - 44 * k, x1 = b.x0 + 14 * k + half, y1 = b.y1 - 14 * k};
  back := Box.{x0 = make.x1 + 12 * k, y0 = make.y0, x1 = b.x1 - 14 * k, y1 = make.y1};
  vertices = plate_button(s, out, vertices, BTN_MAKE, make, ifx s[0].making then "MAKING..." else "CREATE", true);
  vertices = plate_button(s, out, vertices, BTN_BACK, back, "CANCEL", false);
  return vertices;
}

// ---- the frame

// The host calls this once a frame. dt is seconds since the last frame;
// still: the visitor prefers reduced motion. Returns the vertex count.
verse_frame :: (s: [] VerseState, t: [] Track, out: [] f32, uniforms: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c {
  if s.count < 1 || uniforms.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  if !s[0].started { verse_reset(s); }
  // back to a page left by going on (the browser kept it): it answers again
  if s[0].going && s[0].next_n == 0 && s[0].time - s[0].going_at > 6 { s[0].going = false; }
  s[0].time += clamp(dt, 0, 0.1); s[0].dt = dt;
  s[0].width = width; s[0].height = height; s[0].dpr = hi(dpr, 0.5); s[0].still = still;
  if s[0].page == PAGE_GALAXY && !s[0].down && !still { s[0].rot += 0.036 * clamp(dt, 0, 0.1); }
  s[0].plate_n = 0;
  for i: 0..<BUTTONS { s[0].shown[i] = false; }
  s[0].field[0] = 0; s[0].field[1] = 0; s[0].field[2] = 0; s[0].field[3] = 0;

  // the page's own step, once the visit's facts are in
  if !s[0].landed && t.count > 0 && t[0].ready {
    s[0].landed = true;
    if s[0].page == PAGE_GALAXY { track(t, "map"); }
    else {
      track(t, "landing");
      // a returning player's visit is tied to their email too
      if s[0].kept_n > 0 && email_text(s) == kept_text(s) {
        join(s, t, "return", false);
        if track_begin(t, "join") { track_str(t, "email", kept_text(s)); track_bool(t, "returning", true); track_str(t, "how", "return"); track_end(t); }
      }
    }
  }
  // the galaxy's requests, one at a time, after any action waiting
  if s[0].page == PAGE_GALAXY && s[0].wants != 0 && s[0].want_id == -1 && !s[0].req_ready && s[0].action == 0 && s[0].next_n == 0 { realm_ask(s); }
  // GO waits for the server's answer (or WAIT_JOIN), and the keep before it
  if s[0].next_n > 0 && s[0].action == 0 && !s[0].req_ready && (s[0].answered || s[0].time - s[0].going_at > WAIT_JOIN) {
    act(s, ACT_NAVIGATE, cast(string) s[0].next[0..<s[0].next_n]);
    s[0].next_n = 0;
  }

  for i: 0..<UNIFORM_FLOATS { uniforms[i] = 0; }
  uniforms[0] = width; uniforms[1] = height; uniforms[2] = ifx still then 20.0f32 else s[0].time;
  uniforms[3] = ifx still then 1.0f32 else ease(s[0].time / 0.8);
  uniforms[4] = ifx still then 1.0f32 else 0.0f32;
  uniforms[6] = s[0].dpr;
  n := ifx s[0].page == PAGE_GALAXY then draw_galaxy(s, out, 0) else draw_landing(s, out, 0);
  uniforms[5] = cast(f32) s[0].plate_n;
  for i: 0..<s[0].plate_n {
    o := PANEL_AT + i * 8; b := s[0].plates[i];
    uniforms[o] = b.x0; uniforms[o + 1] = b.y0; uniforms[o + 2] = b.x1; uniforms[o + 3] = b.y1;
    uniforms[o + 4] = s[0].dpr; uniforms[o + 5] = s[0].plate_alpha[i]; uniforms[o + 6] = s[0].plate_look[i]; uniforms[o + 7] = 0;
  }
  return n;
}

coaxial_verse_max_vertices :: () -> int #export_c { return MAX_VERTICES; }
coaxial_verse_vertex_floats :: () -> int #export_c { return VERTEX_FLOATS; }
coaxial_verse_uniform_floats :: () -> int #export_c { return UNIFORM_FLOATS; }

// ---- checks

// A page at w x h CSS pixels and dpr 2, its facts in, one frame drawn.
page_at :: (s: [] VerseState, t: [] Track, page: int, w: f32, h: f32) {
  s[0].page = page;
  track_init(t, ifx page == PAGE_GALAXY then "galaxy" else "landing");
  facts := "tab=0123456789abcdef\nfresh=1\nvisitor=feedfacecafebeef\nnow=1000\nnav=50\nurl=https://openagents.com/verse\nua=Mozilla/5.0\ncoarse=0";
  _ := track_message(t, HOST_PAGE, facts);
  out: [6 * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  drawn := verse_frame(s, t, out[..], u[..], w * 2, h * 2, 2, 0.016, true);
  offline(s);
}
redraw :: (s: [] VerseState, t: [] Track, dt: f32) {
  frame(s, t, dt);
  offline(s);
}
frame :: (s: [] VerseState, t: [] Track, dt: f32) {
  out: [6 * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  _ := verse_frame(s, t, out[..], u[..], s[0].width, s[0].height, s[0].dpr, dt, true);
}
// The galaxy's requests with no server: each fails at once.
offline :: (s: [] VerseState) { if s[0].page == PAGE_GALAXY && s[0].req_ready && s[0].want_id == -2 { verse_requested(s, -1); } }
url_is :: (s: [] VerseState, url: string) -> bool { return s[0].req_ready && cast(string) s[0].req_url[0..<s[0].req_url_n] == url; }
poke :: (s: [] VerseState, t: [] Track, x: f32, y: f32, phase: int, kind: int, id: int) { _ := verse_pointer(s, t, x, y, phase, kind, id); }
take_action :: (s: [] VerseState) { _ := verse_action(s); verse_action_done(s); }
click :: (s: [] VerseState, t: [] Track, b: Box) {
  x := (b.x0 + b.x1) * 0.5; y := (b.y0 + b.y1) * 0.5;
  poke(s, t, x, y, POINTER_DOWN, 0, 1);
  poke(s, t, x, y, POINTER_UP, 0, 1);
}
batch_has :: (t: [] Track, text: string) -> bool { return text_has(cast(string) t[0].buf[0..<t[0].buf_n], text); }

#test "an email is what the server takes" {
  #assert email_ok("a@b.co") && email_ok("chris@openagents.com") && email_ok("x.y+z@mail.example.org");
  #assert !email_ok("") && !email_ok("a@b") && !email_ok("@b.co") && !email_ok("a@@b.co") && !email_ok("a@b..co");
  #assert !email_ok("a@.co") && !email_ok("a@b.co.") && !email_ok("a b@c.co") && !email_ok("a@b@c.co");
  #assert email_byte('A') == 'a' && email_byte('"') < 0 && email_byte('\\') < 0 && email_byte(' ') < 0;
}

#test "the landing fits a phone and a desktop" {
  for size: 0..<2 {
    s: [1] VerseState; t: [1] Track;
    w := ifx size == 0 then 390.0f32 else 1440.0f32; h := ifx size == 0 then 844.0f32 else 900.0f32;
    page_at(s[..], t[..], PAGE_LANDING, w, h);
    out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
    n := verse_frame(s[..], t[..], out[..], u[..], w * 2, h * 2, 2, 0, true);
    #assert n > 0 && n % 6 == 0 && n < MAX_VERTICES;
    for v: 0..<n { x := out[v * VERTEX_FLOATS]; #assert x > -40 && x < w * 2 + 40; }
    #assert !s[0].shown[BTN_FIELD] && !s[0].shown[BTN_GO] && s[0].shown[BTN_ENTER];
    e := s[0].boxes[BTN_ENTER];
    #assert e.x0 >= 32 * 2 - 1 && e.x1 <= w * 2 - 32 * 2 + 1 && e.y0 > h && e.y1 < h * 2;
    #assert u[5] == 1 && u[PANEL_AT + 6] == LOOK_HUD && s[0].orb_n == 4;
  }
}

#test "PLAYTEST NOW goes straight to the Haunted House as a guest, once; Enter does too" {
  s: [1] VerseState; t: [1] Track;
  page_at(s[..], t[..], PAGE_LANDING, 1440, 900);
  #assert batch_has(t[..], "\"ev\":\"landing\"");
  click(s[..], t[..], s[0].boxes[BTN_ENTER]);
  #assert batch_has(t[..], "\"ev\":\"start\"") && batch_has(t[..], "\"how\":\"guest\"") && !s[0].req_ready;
  redraw(s[..], t[..], 0.016);
  #assert s[0].action == ACT_NAVIGATE && cast(string) s[0].outbox[0..<s[0].out_n] == "/realm/haunted-house";
  take_action(s[..]);
  click(s[..], t[..], s[0].boxes[BTN_ENTER]);
  redraw(s[..], t[..], 0.016);
  #assert s[0].action == 0;
}

#test "a press in the stars makes an orb that grows while held, then joins the rest" {
  s: [1] VerseState; t: [1] Track;
  page_at(s[..], t[..], PAGE_LANDING, 1440, 900);
  #assert s[0].orb_n == 4 && !s[0].holding;
  poke(s[..], t[..], 200, 200, POINTER_DOWN, 0, 1);
  #assert s[0].holding && s[0].hold.r == ORB_HOLD_START && s[0].press < 0;
  for i: 0..<30 { frame(s[..], t[..], 1.0 / 60.0); }
  #assert s[0].hold.r > 10 && s[0].spark_n == 0;   // still (reduced motion): no sparks
  s[0].still = false;
  for i: 0..<30 { orb_step(s[..], 1440, 900); }
  #assert s[0].spark_n > 0;   // dust drifting in toward it
  poke(s[..], t[..], 200, 200, POINTER_UP, 0, 1);
  #assert !s[0].holding && s[0].orb_n >= 2 && s[0].orbs[s[0].orb_n - 1].r > 10;   // (its first moments may have merged two)
  for i: 0..<120 { orb_step(s[..], 1440, 900); }
  #assert s[0].orb_n >= 1 && s[0].orb_n <= 5;
  for i: 0..<s[0].orb_n { o := s[0].orbs[i]; #assert o.x >= 0 && o.x <= 1440 && o.y >= 0 && o.y <= 900; }
  #assert verse_cursor(s[..]) == 2 && !verse_wants_text(s[..]);
}

#test "a returning player's email is filled in and joined again" {
  s: [1] VerseState; t: [1] Track;
  s[0].page = PAGE_LANDING;
  verse_message(s[..], t[..], MSG_KEPT, "me@example.org");
  page_at(s[..], t[..], PAGE_LANDING, 1440, 900);
  #assert email_text(s[..]) == "me@example.org" && s[0].req_ready && s[0].req_flags == HTTP_POST;
  #assert text_has(cast(string) s[0].req_body[0..<s[0].req_body_n], "\"how\":\"return\"");
  verse_requested(s[..], 0);
  click(s[..], t[..], s[0].boxes[BTN_ENTER]);
  #assert s[0].action == 0 && !s[0].req_ready && batch_has(t[..], "\"how\":\"email\"");
  redraw(s[..], t[..], 0.016);
  #assert s[0].action == ACT_NAVIGATE;
}

#test "only the Haunted House opens" {
  s: [1] VerseState; t: [1] Track;
  page_at(s[..], t[..], PAGE_GALAXY, 1440, 900);
  #assert batch_has(t[..], "\"ev\":\"map\"");
  #assert s[0].shown[BTN_HOUSE] && s[0].shown[BTN_CODING];
  click(s[..], t[..], s[0].boxes[BTN_CODING]);
  redraw(s[..], t[..], 0.016);
  #assert s[0].action == 0 && s[0].toast_n > 0 && batch_has(t[..], "\"planet\":\"coding\"");
  for p: 0..<PLANETS {
    if PLANET_KIND[p] == KIND_OPEN { continue; }
    q := project(s[..], p);
    if planet_at(s[..], q.x, q.y) != p || button_at(s[..], q.x, q.y) >= 0 { continue; }
    poke(s[..], t[..], q.x, q.y, POINTER_DOWN, 0, 1);
    poke(s[..], t[..], q.x, q.y, POINTER_UP, 0, 1);
    redraw(s[..], t[..], 0.016);
    #assert s[0].action == 0;
  }
  q := project(s[..], HOUSE);
  poke(s[..], t[..], q.x, q.y, POINTER_DOWN, 0, 1);
  poke(s[..], t[..], q.x, q.y, POINTER_UP, 0, 1);
  redraw(s[..], t[..], 0.016);
  #assert s[0].action == ACT_NAVIGATE && cast(string) s[0].outbox[0..<s[0].out_n] == "/realm/haunted-house";
  #assert batch_has(t[..], "\"open\":true");
}

#test "every open world opens its own realm page; an unlisted one only with realms=all" {
  #assert PLANET_ID[HOUSE] == "house" && PLANET_ID[CODING] == "coding" && PLANET_PATH[HOUSE] == "/realm/haunted-house";
  fixture := -1;
  for p: 0..<PLANETS {
    #assert (PLANET_KIND[p] == KIND_OPEN) == (PLANET_PATH[p].count > 0);
    if PLANET_ID[p] == "fixture" { fixture = p; }
  }
  #assert fixture >= 0 && !PLANET_LISTED[fixture];
  for all: 0..<2 {
    s: [1] VerseState; t: [1] Track;
    if all == 1 { verse_facts(s[..], "url=https://openagents.com/verse/galaxy?realms=all"); }
    page_at(s[..], t[..], PAGE_GALAXY, 1440, 900);
    q := project(s[..], fixture);
    #assert (planet_at(s[..], q.x, q.y) == fixture) == (all == 1);
    if all == 0 { continue; }
    poke(s[..], t[..], q.x, q.y, POINTER_DOWN, 0, 1);
    poke(s[..], t[..], q.x, q.y, POINTER_UP, 0, 1);
    redraw(s[..], t[..], 0.016);
    #assert s[0].action == ACT_NAVIGATE && cast(string) s[0].outbox[0..<s[0].out_n] == "/realm/fixture";
  }
}

#test "without a pointer, the arrows choose an open world and ENTER opens it" {
  for all: 0..<2 {
    s: [1] VerseState; t: [1] Track;
    if all == 1 { verse_facts(s[..], "url=https://openagents.com/verse/galaxy?realms=all"); }
    page_at(s[..], t[..], PAGE_GALAXY, 1440, 900);
    seen := 0; last := -1;
    for i: 0..<PLANETS + 2 {
      #assert verse_key(s[..], t[..], KEY_RIGHT, 0);
      p := s[0].over;
      #assert p >= 0 && realm_kind_at(s[..], p) == KIND_OPEN && planet_shown(s[..], p);
      if p > last { seen += 1; last = p; }
    }
    open := 0;
    for p: 0..<PLANETS { if PLANET_KIND[p] == KIND_OPEN && (PLANET_LISTED[p] || all == 1) { open += 1; } }
    #assert seen == open;
    #assert verse_key(s[..], t[..], KEY_LEFT, 0) && verse_key(s[..], t[..], KEY_RIGHT, 0);
    s[0].over = -1;
    #assert verse_key(s[..], t[..], KEY_RIGHT, 0) && s[0].over == HOUSE;
    #assert verse_key(s[..], t[..], KEY_ENTER, 0);
    redraw(s[..], t[..], 0.016);
    #assert s[0].action == ACT_NAVIGATE && cast(string) s[0].outbox[0..<s[0].out_n] == "/realm/haunted-house";
  }
}

#test "a drag turns the galaxy and opens nothing" {
  s: [1] VerseState; t: [1] Track;
  page_at(s[..], t[..], PAGE_GALAXY, 390, 844);
  before := s[0].rot;
  x := s[0].width * 0.5; y := s[0].height * 0.2;
  poke(s[..], t[..], x, y, POINTER_DOWN, 1, 7);
  poke(s[..], t[..], x + 200, y + 40, POINTER_MOVE, 1, 7);
  poke(s[..], t[..], x + 200, y + 40, POINTER_UP, 1, 7);
  redraw(s[..], t[..], 0.016);
  #assert s[0].rot != before && s[0].tilt > 0.42 && s[0].action == 0;
}

#test "a finger's first tap names a world, the second opens it" {
  s: [1] VerseState; t: [1] Track;
  page_at(s[..], t[..], PAGE_GALAXY, 390, 844);
  q := project(s[..], HOUSE);
  for tap: 0..<2 {
    poke(s[..], t[..], q.x, q.y, POINTER_DOWN, 1, 9);
    poke(s[..], t[..], q.x, q.y, POINTER_UP, 1, 9);
    redraw(s[..], t[..], 0.016);
    if tap == 0 { #assert s[0].over == HOUSE && s[0].action == 0; }
  }
  #assert s[0].action == ACT_NAVIGATE;
}

#test "the galaxy asks for your realm and the newest realms, and draws them" {
  s: [1] VerseState; t: [1] Track;
  s[0].page = PAGE_GALAXY;
  verse_facts(s[..], "tab=1\nplayer=p-0123456789abcdef\naccount=");
  #assert player_text(s[..]) == "p-0123456789abcdef";
  track_init(t[..], "galaxy");
  _ := track_message(t[..], HOST_PAGE, "tab=0123456789abcdef\nfresh=1\nvisitor=feedfacecafebeef\nnow=1000\nnav=50");
  s[0].width = 2880; s[0].height = 1800; s[0].dpr = 2;
  frame(s[..], t[..], 0.016);
  #assert url_is(s[..], "/api/playtest/planets/mine") && s[0].req_flags == HTTP_ANSWER | HTTP_PLAYER;
  verse_requested(s[..], 2);
  verse_message(s[..], t[..], HTTP_KIND + 2, "200\n{\"planet\": {\"id\": \"planet-mine1\", \"name\": \"My \\\"Den\\\"\", \"kind\": \"forest\"}, \"invited\": false, \"saved\": null}");
  #assert mine_text(s[..]) == "planet-mine1" && cast(string) s[0].mine_name[0..<s[0].mine_name_n] == "My \"Den\"";
  frame(s[..], t[..], 0.016);
  #assert url_is(s[..], "/api/playtest/planets?after=1000000000");
  verse_requested(s[..], 3);
  verse_message(s[..], t[..], HTTP_KIND + 3, "200\n{\"n\": 12, \"planets\": []}");
  frame(s[..], t[..], 0.016);
  #assert url_is(s[..], "/api/playtest/planets?after=4");
  verse_requested(s[..], 4);
  verse_message(s[..], t[..], HTTP_KIND + 4, "200\n{\"n\": 12, \"planets\": [{\"n\": 11, \"id\": \"planet-a\", \"name\": \"Old\", \"kind\": \"village\"}, {\"n\": 12, \"id\": \"planet-b\", \"name\": \"New\", \"kind\": \"cemetery\"}]}");
  #assert s[0].realm_n == 2 && realm_id_at(s[..], PLANETS) == "planet-b" && realm_name_at(s[..], PLANETS + 1) == "Old";
  #assert s[0].realm_kind[0] == 2 && s[0].realm_kind[1] == 1 && realm_kind_at(s[..], PLANETS) == KIND_OPEN;
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := verse_frame(s[..], t[..], out[..], u[..], 2880, 1800, 2, 0, true);
  #assert n > 0 && n < MAX_VERTICES && !s[0].req_ready && s[0].shown[BTN_REALM] && u[5] <= PLATES;
  // a realm on the map opens its world; YOUR REALM opens yours
  q := project(s[..], PLANETS);
  #assert planet_at(s[..], q.x, q.y) == PLANETS;
  poke(s[..], t[..], q.x, q.y, POINTER_DOWN, 0, 1);
  poke(s[..], t[..], q.x, q.y, POINTER_UP, 0, 1);
  frame(s[..], t[..], 0.016);
  #assert s[0].action == ACT_NAVIGATE && cast(string) s[0].outbox[0..<s[0].out_n] == "/realm/haunted-house#planet-b";
  take_action(s[..]);
  click(s[..], t[..], s[0].boxes[BTN_REALM]);
  frame(s[..], t[..], 0.016);
  #assert s[0].action == ACT_NAVIGATE && cast(string) s[0].outbox[0..<s[0].out_n] == "/realm/haunted-house#planet-mine1";
}

#test "a guest with no key makes a realm: a key first, kept, then the realm, then it opens" {
  s: [1] VerseState; t: [1] Track;
  page_at(s[..], t[..], PAGE_GALAXY, 390, 844);
  #assert s[0].shown[BTN_REALM] && s[0].mine_n == 0 && s[0].wants == 0;
  click(s[..], t[..], s[0].boxes[BTN_REALM]);
  #assert s[0].setup && verse_wants_text(s[..]) && batch_has(t[..], "planet-setup");
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  n := verse_frame(s[..], t[..], out[..], u[..], 780, 1688, 2, 0, true);
  #assert n > 0 && u[5] <= PLATES && s[0].shown[BTN_NAME] && s[0].shown[BTN_MAKE] && s[0].shown[BTN_BACK];
  for c: 0..<CHOICES { b := s[0].boxes[BTN_CHOICE + c]; #assert s[0].shown[BTN_CHOICE + c] && b.x0 >= 0 && b.x1 <= 780; }
  verse_message(s[..], t[..], MSG_TEXT, "Ann's \"Den\"");
  #assert name_text(s[..]) == "Ann's Den";
  click(s[..], t[..], s[0].boxes[BTN_CHOICE]);       // kind: cemetery to forest
  click(s[..], t[..], s[0].boxes[BTN_CHOICE + 3]);   // time: day and night to always day
  #assert verse_key(s[..], t[..], KEY_ENTER, 0) && s[0].making;
  frame(s[..], t[..], 0.016);
  #assert url_is(s[..], "/api/playtest/player") && s[0].req_flags == HTTP_POST | HTTP_ANSWER;
  verse_requested(s[..], 1);
  verse_message(s[..], t[..], HTTP_KIND + 1, "200\n{\"id\": \"p-feed\", \"key\": \"k-secret\", \"account\": null}");
  #assert s[0].action == ACT_PLAYER && player_text(s[..]) == "p-feed";
  frame(s[..], t[..], 0.016);
  #assert !s[0].req_ready;   // the key is kept before the realm is asked for
  take_action(s[..]);
  frame(s[..], t[..], 0.016);
  #assert url_is(s[..], "/api/playtest/planets") && s[0].req_flags == HTTP_POST | HTTP_ANSWER | HTTP_PLAYER;
  body := cast(string) s[0].req_body[0..<s[0].req_body_n];
  #assert body == "{\"user\":{\"id\":\"p-feed\",\"name\":\"Guest\"},\"settings\":{\"name\":\"Ann's Den\",\"kind\":\"forest\",\"art\":\"Low poly\",\"cam\":\"Third person\",\"cycle\":\"Always day\"}}";
  verse_requested(s[..], 2);
  verse_message(s[..], t[..], HTTP_KIND + 2, "200\n{\"id\": \"planet-feed\", \"n\": 5, \"name\": \"Ann's Den\"}");
  frame(s[..], t[..], 0.016);
  #assert s[0].action == ACT_NAVIGATE && cast(string) s[0].outbox[0..<s[0].out_n] == "/realm/haunted-house#planet-feed";
  #assert batch_has(t[..], "planet-create") && !batch_has(t[..], "k-secret");
}

#test "a refused realm says so, and CANCEL closes the setup" {
  s: [1] VerseState; t: [1] Track;
  page_at(s[..], t[..], PAGE_GALAXY, 1440, 900);
  verse_facts(s[..], "player=p-1");
  click(s[..], t[..], s[0].boxes[BTN_REALM]);
  redraw(s[..], t[..], 0.016);
  click(s[..], t[..], s[0].boxes[BTN_MAKE]);
  frame(s[..], t[..], 0.016);
  #assert url_is(s[..], "/api/playtest/planets");
  verse_requested(s[..], 0);
  verse_message(s[..], t[..], HTTP_KIND, "403\n{\"error\":\"not yours\"}");
  #assert !s[0].making && s[0].setup && s[0].toast_n > 0 && s[0].mine_n == 0;
  redraw(s[..], t[..], 0.016);
  click(s[..], t[..], s[0].boxes[BTN_BACK]);
  #assert !s[0].setup;
  redraw(s[..], t[..], 0.016);
  #assert s[0].action == 0;
}
