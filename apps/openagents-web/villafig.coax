// Hecate's Cemetery's figures: you (a person, a soft shadow) and the pets
// (dogs, glowing white), posed by the Verse engine's figures and motions
// (verse/figure.coax, verse/motion.coax). villa-face.c links this as its own
// library, because the engine's figure maths and the realm's camera maths
// each bring their own small helpers. The face keeps one Figs, steps each
// figure by how fast it moves, plays the emotes villa.coax asks for, and
// writes each figure's bones (BONE_FLOATS each) into villa.coax's state,
// where villa.coax draws them as rounded shapes.
//
// The pets' emotes: the engine's SIT, BOW (a play bow), WAG, DIG and the
// pick-up a fetch uses, and three written here as motion documents, the
// same kind an agent writes from a sentence: ROLL OVER, HOWL and SLEEP.
//   coax/bin/coax test apps/openagents-web/villafig.coax --library

#load "../../verse/motion.coax";

VF_FIGS :: 16;
VF_MOTIONS :: 24;
VF_NUMBERS :: 10;      // a shape's numbers, figure.coax SHAPE_NAMES order
VF_FADE :: 0.35;       // seconds one gait takes to blend into the next

// The pets' stock emotes, in the order villa.coax's buttons name them.
VF_PET_EMOTES :: 6;
VF_PET_EMOTE_NAMES :: [6] string.["sit", "play_bow", "roll_over", "howl", "wag", "sleep"];
VF_EXTRA :: 3;
VF_EXTRA_TEXT :: [3] string.[
  "motion roll_over; rig animal; seconds 2.6; once; still; fade 0.3; at 0.5; lift 0 -0.3 0; pelvis 0 0 80; front_left_shoulder -30 0 0; front_right_shoulder -30 0 0; hind_left_hip 30 0 0; hind_right_hip 30 0 0; at 1.1; lift 0 -0.33 0; pelvis 0 0 170; front_left_elbow 90 0 0; front_right_elbow 90 0 0; hind_left_knee 90 0 0; hind_right_knee 90 0 0; head 20 0 0; at 1.6; pelvis 0 0 170; at 2.1; lift 0 -0.3 0; pelvis 0 0 80; at 2.6; lift 0 0 0; pelvis 0 0 0; front_left_shoulder 0 0 0; front_right_shoulder 0 0 0; hind_left_hip 0 0 0; hind_right_hip 0 0 0; front_left_elbow 0 0 0; front_right_elbow 0 0 0; hind_left_knee 0 0 0; hind_right_knee 0 0 0; head 0 0 0",
  "motion howl; rig animal; seconds 3.2; once; still; fade 0.5; at 0.8; pelvis -32 0 0; lift 0 -0.1 0; front_left_shoulder 32 0 0; front_right_shoulder 32 0 0; hind_left_hip -75 0 0; hind_right_hip -75 0 0; hind_left_knee 125 0 0; hind_right_knee 125 0 0; hind_left_hock -110 0 0; hind_right_hock -110 0 0; hind_left_paw 50 0 0; hind_right_paw 50 0 0; neck -60 0 0; head -40 0 0; tail 60 0 0; at 2.6; neck -65 0 0; head -45 0 0; at 3.2; neck -10 0 0; head 0 0 0",
  "motion sleep; rig animal; seconds 1.8; hold; still; fade 0.6; at 1.8; lift 0 -0.36 0; front_left_shoulder -70 0 0; front_right_shoulder -70 0 0; front_left_paw 60 0 0; front_right_paw 60 0 0; hind_left_hip -80 0 -30; hind_right_hip -80 0 30; hind_left_knee 120 0 0; hind_right_knee 120 0 0; hind_left_hock -110 0 0; hind_right_hock -110 0 0; neck 30 0 0; head 30 0 0; tail 80 40 0; tail_2 10 40 0; left_ear 30 0 0; right_ear 30 0 0"
];

VfFig :: struct {
  shape: Shape;
  skel: Skeleton;
  gait: Gait = Gait.stand;
  was: Gait = Gait.stand;
  since: f32 = 10;
  phase: f32;
  now: Play;
  last: Play;
}

Figs :: struct {
  started: bool;
  clock: f32;
  motions: [VF_MOTIONS] Motion; motion_n: int; stock_n: int;
  figs: [VF_FIGS] VfFig;
  error: [MOTION_ERROR] u8; error_n: int;   // why the last motion an agent wrote was refused
}

vf_start :: (f: [] Figs) #export_c {
  f[0].started = true;
  f[0].motion_n = 0;
  for i: 0..<ANIMAL_MOTIONS { if verse_motion_read(f[0].motions[f[0].motion_n..<f[0].motion_n + 1], ANIMAL_MOTION_TEXT[i]) { f[0].motion_n += 1; } }
  for i: 0..<VF_EXTRA { if verse_motion_read(f[0].motions[f[0].motion_n..<f[0].motion_n + 1], VF_EXTRA_TEXT[i]) { f[0].motion_n += 1; } }
  for i: 0..<PERSON_MOTIONS { if verse_motion_read(f[0].motions[f[0].motion_n..<f[0].motion_n + 1], PERSON_MOTION_TEXT[i]) { f[0].motion_n += 1; } }
  f[0].stock_n = f[0].motion_n;
  for i: 0..<VF_FIGS {
    s: Shape;
    f[0].figs[i] = VfFig.{};
    f[0].figs[i].shape = s;
    f[0].figs[i].skel = verse_figure_skeleton(s);
    f[0].figs[i].now = Play.{}; f[0].figs[i].last = Play.{};
  }
}

// A motion slot by name: -1 none.
vf_motion_named :: (f: [] Figs, name: string) -> int #export_c {
  for i: 0..<f[0].motion_n {
    m := f[0].motions[i..<i + 1];
    if m[0].ok && verse_motion_name(m) == name { return i; }
  }
  return -1;
}

// The slot of the pet's n-th stock emote (VF_PET_EMOTE_NAMES), or -1.
vf_pet_emote :: (f: [] Figs, n: int) -> int #export_c {
  if n < 0 || n >= VF_PET_EMOTES { return -1; }
  return vf_motion_named(f, VF_PET_EMOTE_NAMES[n]);
}

// A motion an agent wrote, added to the library (or replacing the one of
// that name it added before): its slot, or -1 and the reason (vf_error).
vf_motion_add :: (f: [] Figs, text: string) -> int #export_c {
  if !f[0].started { vf_start(f); }
  one: [1] Motion;
  if !verse_motion_read(one[..], text) {
    e := verse_motion_error(one[..]);
    n := 0;
    while n < e.count && n < MOTION_ERROR { f[0].error[n] = e[n]; n += 1; }
    f[0].error_n = n;
    return -1;
  }
  f[0].error_n = 0;
  name := verse_motion_name(one[..]);
  for i: f[0].stock_n..<f[0].motion_n {
    if verse_motion_name(f[0].motions[i..<i + 1]) == name { f[0].motions[i] = one[0]; return i; }
  }
  if f[0].motion_n >= VF_MOTIONS { return -1; }
  f[0].motions[f[0].motion_n] = one[0];
  f[0].motion_n += 1;
  return f[0].motion_n - 1;
}
vf_error :: (f: [] Figs) -> string #export_c { return cast(string) f[0].error[0..<f[0].error_n]; }

// Figure i's build: a person or a dog, its ten numbers (figure.coax
// SHAPE_NAMES), its pattern and colours. Out-of-range numbers are held to
// their range.
vf_set :: (f: [] Figs, i: int, dog: bool, numbers: [] f32, pattern: int, cr: f32, cg: f32, cb: f32, mr: f32, mg: f32, mb: f32) #export_c {
  if i < 0 || i >= VF_FIGS { return; }
  if !f[0].started { vf_start(f); }
  s: Shape;
  s.rig = ifx dog then Rig.animal else Rig.person;
  for k: 0..<VF_NUMBERS { if k < numbers.count { s = verse_figure_shape_set(s, k, numbers[k]); } }
  s.pattern = pattern;
  s.coat = fv(cr, cg, cb); s.marks = fv(mr, mg, mb);
  s.look = ifx dog then LOOK_LIT else LOOK_SOFT;
  s = verse_figure_shape_fix(s);
  f[0].figs[i].shape = s;
  f[0].figs[i].skel = verse_figure_skeleton(s);
}

// The gait for a speed (metres a second).
gait_for_speed :: (s: Shape, speed: f32) -> Gait {
  if !(speed > 0.15) { return Gait.stand; }
  if s.rig == Rig.person { return ifx speed > 3.6 then Gait.run else Gait.walk; }
  if speed < 1.9 { return Gait.walk; }
  if speed < 4.0 { return Gait.trot; }
  return Gait.run;
}

vf_tick :: (f: [] Figs, dt: f32) #export_c {
  if !f[0].started { vf_start(f); }
  if finite(dt) { f[0].clock += clamp(dt, 0, 0.25); }
}

// Figure i moved this fast this frame: its gait follows, its stride runs on.
vf_step :: (f: [] Figs, i: int, speed: f32, dt: f32) #export_c {
  if i < 0 || i >= VF_FIGS { return; }
  t := ifx finite(dt) then clamp(dt, 0, 0.25) else 0.0f32;
  w := f[0].figs[i];
  g := gait_for_speed(w.shape, speed);
  if g != w.gait {
    if g != Gait.stand && w.now.motion >= 0 && w.now.motion < f[0].motion_n && f[0].motions[w.now.motion].still && w.now.stop < 0 { w.now.stop = f[0].clock; }
    w.was = w.gait; w.gait = g; w.since = 0;
  }
  w.since += t;
  shown := ifx w.gait == Gait.stand && w.since < f32(VF_FADE) then w.was else w.gait;
  w.phase = fract(w.phase + verse_figure_stride_rate(w.shape, shown) * t);
  // finished plays end
  for k: 0..<2 {
    play := ifx k == 0 then w.last else w.now;
    if play.motion < 0 { continue; }
    if play.motion >= f[0].motion_n || verse_motion_done(f[0].motions[play.motion..<play.motion + 1], play, f[0].clock) {
      if k == 0 { w.last = Play.{}; } else { w.now = Play.{}; }
    }
  }
  f[0].figs[i] = w;
}

// Plays motion slot on figure i; the one playing fades out under it. The
// same loop or hold again stops it.
vf_emote :: (f: [] Figs, i: int, slot: int) -> bool #export_c {
  if i < 0 || i >= VF_FIGS || slot < 0 || slot >= f[0].motion_n { return false; }
  m := f[0].motions[slot..<slot + 1];
  w := f[0].figs[i];
  if m[0].rig != w.shape.rig { return false; }
  now := f[0].clock;
  if w.now.motion == slot && w.now.stop < 0 && !verse_motion_done(m, w.now, now) && m[0].mode != MODE_ONCE {
    w.now.stop = now; f[0].figs[i] = w; return true;
  }
  if w.now.motion >= 0 && w.now.stop < 0 { w.now.stop = now; }
  w.last = w.now;
  w.now = Play.{motion = slot, start = now};
  f[0].figs[i] = w;
  return true;
}

// Figure i is playing a motion that keeps it where it is (a sit, a dig).
vf_still :: (f: [] Figs, i: int) -> bool #export_c {
  if i < 0 || i >= VF_FIGS { return false; }
  p := f[0].figs[i].now;
  if p.motion < 0 || p.motion >= f[0].motion_n || p.stop >= 0 { return false; }
  return f[0].motions[p.motion].still && !verse_motion_done(f[0].motions[p.motion..<p.motion + 1], p, f[0].clock);
}

// The motion figure i plays now, or -1.
vf_playing :: (f: [] Figs, i: int) -> int #export_c {
  if i < 0 || i >= VF_FIGS { return -1; }
  p := f[0].figs[i].now;
  if p.motion < 0 || p.stop >= 0 { return -1; }
  return p.motion;
}

vf_pose :: (f: [] Figs, w: VfFig) -> Pose {
  p := verse_figure_gait(w.shape.rig, w.gait, w.phase, f[0].clock);
  if w.since < f32(VF_FADE) { p = verse_figure_blend(verse_figure_gait(w.shape.rig, w.was, w.phase, f[0].clock), p, smooth01(w.since / f32(VF_FADE))); }
  for play: [2] Play.[w.last, w.now] {
    if play.motion < 0 || play.motion >= f[0].motion_n { continue; }
    m := f[0].motions[play.motion..<play.motion + 1];
    if m[0].rig != w.shape.rig { continue; }
    p = verse_motion_over(m, play, p, f[0].clock);
  }
  return p;
}

// Figure i posed standing at x, y, z facing yaw (radians, 0 toward +z):
// its bones into out (BONE_FLOATS each) and a sphere round them into bound.
vf_place :: (f: [] Figs, i: int, x: f32, y: f32, z: f32, yaw: f32, out: [] f32, bound: [] f32) -> int #export_c {
  if i < 0 || i >= VF_FIGS || !f[0].started { return 0; }
  w := f[0].figs[i];
  return verse_figure_place(w.skel, vf_pose(f, w), Place.{x = x, y = y, z = z, yaw = yaw}, out, bound);
}

vf_bone_floats :: () -> int #export_c { return BONE_FLOATS; }
vf_size :: () -> int #export_c { return size_of(Figs); }
vf_max_bones :: () -> int #export_c { return MAX_PARTS; }

#test "the pets' six emotes and the person's all read, and play on a dog" {
  f: [1] Figs;
  vf_start(f[..]);
  #assert f[0].motion_n == ANIMAL_MOTIONS + VF_EXTRA + PERSON_MOTIONS;
  for n: 0..<VF_PET_EMOTES { #assert vf_pet_emote(f[..], n) >= 0; }
  #assert vf_motion_named(f[..], "pick_up") >= 0 && vf_motion_named(f[..], "dig") >= 0;
  numbers := [10] f32.[1, 1, 1, 1, 1, 1, 0.8, 1, 1, 1];
  vf_set(f[..], 1, true, numbers[..], PATTERN_SOCKS, 0.6, 0.4, 0.2, 0.9, 0.9, 0.9);
  #assert f[0].figs[1].shape.rig == Rig.animal;
  bones: [MAX_PARTS * BONE_FLOATS] f32; bound: [4] f32;
  n := vf_place(f[..], 1, 0, 0, 0, 0, bones[..], bound[..]);
  #assert n > 20 && bound[3] > 0.3 && bound[1] > 0.2;
  // A still emote: it sits, and a walk ends it.
  #assert vf_emote(f[..], 1, vf_pet_emote(f[..], 0));
  vf_tick(f[..], 0.5); vf_step(f[..], 1, 0, 0.5);
  #assert vf_still(f[..], 1);
  vf_tick(f[..], 0.1); vf_step(f[..], 1, 2.5, 0.1);
  #assert !vf_still(f[..], 1) && f[0].figs[1].gait == Gait.trot;
  // A person's emote doesn't play on a dog.
  #assert !vf_emote(f[..], 1, vf_motion_named(f[..], "wave"));
}

#test "an agent's motion is added, named again it replaces, a bad one says why" {
  f: [1] Figs;
  vf_start(f[..]);
  before := f[0].motion_n;
  k := vf_motion_add(f[..], "motion spin_twice; rig animal; seconds 2; once; at 0; pelvis 0 0 0; at 1; pelvis 0 180 0; at 2; pelvis 0 0 0");
  #assert k == before && f[0].motion_n == before + 1;
  #assert vf_motion_add(f[..], "motion spin_twice; rig animal; seconds 3; once; at 0; pelvis 0 0 0") == k && f[0].motion_n == before + 1;
  #assert vf_motion_add(f[..], "motion bad; rig animal; seconds 1; at 0; neck 170 0 0") == -1 && vf_error(f[..]).count > 0;
}

#test "a person walks and runs by speed" {
  f: [1] Figs;
  vf_start(f[..]);
  numbers := [10] f32.[1, 1, 1, 0.9, 1, 1, 0, 1, 1, 1];
  vf_set(f[..], 0, false, numbers[..], 0, 0.02, 0.02, 0.03, 0, 0, 0);
  vf_step(f[..], 0, 1.5, 0.1);
  #assert f[0].figs[0].gait == Gait.walk;
  vf_step(f[..], 0, 6, 0.1);
  #assert f[0].figs[0].gait == Gait.run;
  bones: [MAX_PARTS * BONE_FLOATS] f32; bound: [4] f32;
  #assert vf_place(f[..], 0, 1, 0, 2, 0.5, bones[..], bound[..]) > 10 && bound[1] > 0.6;
}
