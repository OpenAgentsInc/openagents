// Your pet in Hecate's Cemetery, and the others' tombstones and memorials
// (hc-pet-upload, hc-pet-avatar-agent, hc-pet-customize, hc-emotes,
// hc-tombstones, hc-memorial-page, hc-memorial-share; coax/web/api/villa.c and
// migrations/0028_villa_pets.sql answer). Loaded by villa.coax: the panel is
// drawn in its HUD, its presses and typing come first, and the face makes the
// requests this file writes (villa_pet_next, villa_pet_url, villa_pet_body)
// and hands back their answers (villa_pet_answer). Uploads go through the
// page (action 30, coax/web/uploads.js). The photos and videos a memorial
// shows (hc-memorial-media, migrations/0034_villa_memorial_media.sql) are
// drawn by the host into the boxes this file names (media_text, coaxial_media
// in coax/web/host.js): only the ones their owner put on it.

PET_FIELDS :: 6;
PF_NAME :: 0; PF_BORN :: 1; PF_DIED :: 2; PF_LINE :: 3; PF_STORY :: 4; PF_TRAITS :: 5;
FIELD_BYTES :: 1200;
PF_CAP :: [6] int.[40, 24, 24, 120, 1200, 300];
PF_LABEL :: [6] string.["NAME", "BORN", "PASSED", "A LINE FOR THE STONE", "ABOUT THEM", "WHAT MADE THEM THEM"];
PF_KEY :: [6] string.["name", "born", "died", "line", "story", "traits"];

// The avatar's numbers (verse/figure.coax Shape, in its order) and what the panel calls them.
AV_NUMBERS :: 10;
AV_KEY :: [10] string.["size", "legs", "body", "girth", "head", "snout", "ears", "ear_size", "tail", "fluff"];
AV_LABEL :: [10] string.["SIZE", "LEGS", "BODY", "BUILD", "HEAD", "SNOUT", "EARS DOWN", "EAR SIZE", "TAIL", "FLUFF"];
AV_LO :: [10] f32.[0.4, 0.5, 0.6, 0.6, 0.7, 0.4, 0, 0.5, 0, 0.5];
AV_HI :: [10] f32.[1.8, 1.6, 1.6, 1.6, 1.5, 1.6, 1, 1.8, 1.8, 2];
AV_USUAL :: [10] f32.[1, 1, 1, 1, 1, 1, 0, 1, 1, 1];
PATTERN_WORDS :: [5] string.["plain", "patches", "points", "stripes", "socks"];
// Coat swatches: linear RGB.
SWATCHES :: 8;
SWATCH :: [24] f32.[0.02, 0.02, 0.02,  0.3, 0.15, 0.05,  0.55, 0.36, 0.2,  0.8, 0.55, 0.25,  0.92, 0.8, 0.55,  0.95, 0.93, 0.9,  0.45, 0.45, 0.48,  0.6, 0.3, 0.12];
EMOTES :: 6;
EMOTE_LABEL :: [6] string.["SIT", "PLAY BOW", "ROLL OVER", "HOWL", "WAG", "SLEEP"];

// The requests, one at a time, first wanted first.
ASK_MINE :: 1; ASK_NEW :: 2; ASK_SAVE :: 4; ASK_AGENT :: 8; ASK_PLACE :: 16; ASK_GARDEN :: 32; ASK_MEMORIAL :: 64; ASK_NOTE :: 128; ASK_HIDE :: 256; ASK_VASES :: 512; ASK_VASE :: 1024; ASK_CLEAN :: 2048; ASK_REPORT :: 4096; ASK_EMOTE :: 8192; ASK_EMOTE_KEEP :: 16384;
ASK_SHOW :: 32768; ASK_FILE_DELETE :: 65536;   // a kept file on or off the memorial; a file deleted
ASK_KINDS :: 17;

PV_NONE :: 0; PV_PET :: 1; PV_MEMORIAL :: 2;
AGENT_NONE :: 0; AGENT_READING :: 1; AGENT_READY :: 2; AGENT_FAILED :: 3;
GARDEN_MAX :: 60;
CHOICES :: 8;
NOTES :: 6;
NOTE_BYTES :: 600;
BUTTONS :: 48;
// What a button does.
B_OPEN :: 1; B_CLOSE :: 2; B_FIELD :: 3; B_PHOTOS :: 4; B_AGENT :: 5; B_PLAY :: 6; B_TAB :: 7; B_SLIDER :: 8; B_PATTERN :: 9;
B_COAT :: 10; B_MARKS :: 11; B_EMOTE :: 12; B_MEMORIAL :: 13; B_SHARE :: 14; B_NOTE :: 15; B_SEND :: 16; B_HIDE :: 17;
B_SKILL :: 18; B_DO :: 19; B_KIND :: 20; B_SLOT :: 21; B_PLACE_VASE :: 22; B_CLEAN :: 23; B_REPORT :: 24; B_MAKE_EMOTE :: 25; B_EMOTE_FIELD :: 26;
B_SHOW_FILE :: 27; B_DELETE_FILE :: 28; B_MEDIA :: 29; B_REPORT_MEDIA :: 30;
// What a report is of (0031_villa_reports.sql), B_REPORT's arg: the kind times a million plus the note or line number.
REPORT_MEMORIAL :: 0; REPORT_NOTE :: 1; REPORT_CHAT :: 2; REPORT_FILE :: 3;
REPORT_KIND_WORDS :: [4] string.["memorial", "note", "chat", "file"];
// Your pet's kept photos and videos, and the ones a memorial shows.
MY_FILES :: 12; FILE_ID :: 20; FILE_NAME :: 40;
MEDIA_MAX :: 6; MEDIA_ID :: 16; MEDIA_TEXT :: 1200;
// The steps the analytics record (hc-analytics), as the face names them.
EVS :: 8;
EV_PET_MADE :: 0; EV_AVATAR :: 1; EV_EMOTE :: 2; EV_PLACED :: 3; EV_FETCH :: 4; EV_OBEY :: 5; EV_DIG :: 6; EV_FLOWER :: 7;
EV_VASE :: 8; EV_VASE_CLEAN :: 9; EV_MEMORIAL :: 10; EV_SHARE :: 11; EV_NOTE :: 12; EV_CHAT :: 13; EV_TIP :: 14; EV_UPLOAD :: 15;
EV_KINDS :: 16;
EV_NAMES :: [16] string.["villa-pet-made", "villa-avatar", "villa-emote", "villa-tombstone", "villa-fetch", "villa-obey", "villa-dig", "villa-flower",
  "villa-vase", "villa-vase-clean", "villa-memorial", "villa-share", "villa-note", "villa-chat", "villa-tip", "villa-upload"];
pet_ev :: (p: [] PetUi, kind: int, arg: int) {
  if p[0].ev_n >= EVS { return; }
  p[0].evs[p[0].ev_n] = kind; p[0].ev_arg[p[0].ev_n] = arg; p[0].ev_n += 1;
}
// Skills, as bits.
SKILL_FETCH :: 1; SKILL_OBEY :: 2; SKILL_DIG :: 4;
SKILL_WORDS :: [3] string.["fetch", "obedience", "digging"];
SKILL_LABEL :: [3] string.["FETCH", "SIT, STAY, COME", "DIGGING"];
// The field's flowers: three kinds, each glowing its own colour.
FLOWER_KINDS :: 3;
FLOWER_NAME :: [3] string.["MOONPETAL", "LANTERN", "STARBELL"];
FLOWER_RGB :: [9] f32.[0.55, 0.75, 1.0,  1.0, 0.72, 0.32,  0.78, 0.55, 1.0];
VASE_SLOTS :: 7;
VASES_MAX :: 80;
PV_VASE :: 3;
DO_THROW :: 0; DO_SIT :: 1; DO_STAY :: 2; DO_COME :: 3; DO_DIG :: 4; DO_PICK :: 5; DO_VASE :: 6;
TYPE_NOTE :: 100;    // focus: the note box on a memorial
TYPE_EMOTE :: 101;   // focus: what they used to do, for an emote the agent makes
// Emotes the agent made (0032_villa_emotes.sql): kept on the pet, at most eight.
MY_EMOTES :: 8; EMOTE_TEXT :: 3000; EMOTE_SAID :: 300; EMOTE_TRIES :: 3;
EM_NONE :: 0; EM_MAKING :: 1; EM_CHECK :: 2; EM_FAILED :: 3;

PetUi :: struct {
  view: int;
  tab: int;                                  // 0 about them, 1 their look
  asks: int;
  has: bool; placed: bool; plot: int;
  id: [24] u8; id_n: int;
  slug: [12] u8; slug_n: int;
  text: [PET_FIELDS * FIELD_BYTES] u8; text_n: [PET_FIELDS] int;
  focus: int;                                // the field being typed in, -1 none
  avatar: [AV_NUMBERS] f32; pattern: int; coat: [3] f32; marks: [3] f32;
  look_new: bool;                            // the face should set the dog's shape
  dirty: bool; dirty_t: f32;                 // edits not yet sent, and how long ago
  agent: int; note: [200] u8; note_n: int;
  choices: int; choice: [CHOICES * 220] u8; choice_n: [CHOICES] int;
  files: [900] u8; files_n: int;
  emote: int;                                // asked of the face, -1 none
  // The garden's tombstones (everyone's placed pets).
  garden: int; garden_t: f32;
  g_plot: [GARDEN_MAX] int; g_mine: [GARDEN_MAX] bool;
  g_name: [GARDEN_MAX * 40] u8; g_name_n: [GARDEN_MAX] int;
  g_line: [GARDEN_MAX * 120] u8; g_line_n: [GARDEN_MAX] int;
  g_slug: [GARDEN_MAX * 8] u8;
  near: int;                                 // the tombstone you stand at, -1 none
  // A memorial open.
  m_slug: [8] u8; m_ok: bool; m_mine: bool; m_status: int;
  m_name: [40] u8; m_name_n: int; m_dates: [60] u8; m_dates_n: int; m_line: [120] u8; m_line_n: int;
  m_story: [1200] u8; m_story_n: int; m_traits: [300] u8; m_traits_n: int; m_ach: [300] u8; m_ach_n: int;
  notes: int; n_num: [NOTES] int; n_name: [NOTES * 40] u8; n_name_n: [NOTES] int; n_text: [NOTES * NOTE_BYTES] u8; n_text_n: [NOTES] int;
  hide_n: int;
  report_kind: int; report_ref: int;
  my_n: int; my_name: [MY_EMOTES * 24] u8; my_name_n: [MY_EMOTES] int; my_label: [MY_EMOTES * 16] u8; my_label_n: [MY_EMOTES] int;
  my_text: [MY_EMOTES * EMOTE_TEXT] u8; my_text_n: [MY_EMOTES] int;
  em: int;                                   // EM_*: an emote being made
  em_said: [EMOTE_SAID] u8; em_said_n: int;  // what was said, kept while it's made
  em_name: [24] u8; em_name_n: int; em_label: [16] u8; em_label_n: int;
  em_text: [EMOTE_TEXT] u8; em_text_n: int;  // the agent's motion, for the face to check
  em_error: [300] u8; em_error_n: int;       // why the engine refused the last one
  em_tries: int;   // the report to send (REPORT_*; a note's or a chat line's number)
  // your pet's kept files: whether the memorial shows each, or an admin hid it
  fl_n: int; fl_id: [MY_FILES * FILE_ID] u8; fl_id_n: [MY_FILES] int; fl_name: [MY_FILES * FILE_NAME] u8; fl_name_n: [MY_FILES] int;
  fl_video: [MY_FILES] bool; fl_shown: [MY_FILES] bool; fl_held: [MY_FILES] bool;
  file_at: int; file_on: bool; file_sure: int;   // the file to show, hide or delete; DELETE pressed once (-1 none)
  // the memorial's photos and videos (their ids' hex), the one open large (-1 none), the one reported
  m_media_n: int; m_media: [MEDIA_MAX * MEDIA_ID] u8; m_video: [MEDIA_MAX] bool; m_big: int; report_media: int;
  // what the host draws this frame: "image|video URL X0 Y0 X1 Y1" a line (coaxial_media)
  media_text: [MEDIA_TEXT] u8; media_n: int;
  typed: [NOTE_BYTES] u8; typed_n: int;
  toast: [120] u8; toast_n: int; toast_t: f32;
  evs: [EVS] int; ev_arg: [EVS] int; ev_n: int;   // steps for the analytics (EV_*), the face sends them
  field_box: Box;
  button: [BUTTONS] Box; button_kind: [BUTTONS] int; button_arg: [BUTTONS] int; buttons: int;
  slide: int;                                // the slider being dragged, -1 none
  skills: int;                               // SKILL_* bits
  // Flowers picked (by kind), the vase being arranged (a kind per slot, -1 empty) and the kind in hand.
  bag: [FLOWER_KINDS] int;
  vase: [VASE_SLOTS] int; holding: int;
  put_x: f32; put_z: f32; put_yaw: f32; put_plot: int;   // where the vase goes
  // The vases left in the garden and the field.
  vases: int; vases_t: f32;
  v_n: [VASES_MAX] int; v_x: [VASES_MAX] f32; v_z: [VASES_MAX] f32; v_yaw: [VASES_MAX] f32; v_age: [VASES_MAX] f32; v_mine: [VASES_MAX] bool;
  v_flowers: [VASES_MAX * VASE_SLOTS] int;   // a kind per slot, -1 empty
  clean_n: int;
  doing: int;                                // a play the HUD asked for (DO_*), -1 none
  action: int; outbox: [256] u8; out_n: int;
}

// ---- small things

pet_s :: (b: [] u8, n: int) -> string { return cast(string) b[0..<n]; }
pet_field :: (p: [] PetUi, f: int) -> string { return cast(string) p[0].text[f * FIELD_BYTES..<f * FIELD_BYTES + p[0].text_n[f]]; }
pet_put :: (out: [] u8, at: int, s: string) -> int {
  if at < 0 || at + s.count > out.count { return -1; }
  for k: 0..<s.count { out[at + k] = s[k]; }
  return at + s.count;
}
pet_copy :: (dst: [] u8, s: string) -> int {
  n := lo_int(s.count, dst.count);
  for k: 0..<n { dst[k] = s[k]; }
  return n;
}
lo_int :: (a: int, b: int) -> int { return ifx a < b then a else b; }
pet_toast :: (p: [] PetUi, s: string) { p[0].toast_n = pet_copy(p[0].toast[..], s); p[0].toast_t = 4; }

// A JSON string's contents, written escaped, into out at; the end, -1 if it doesn't fit.
pj_put_str :: (out: [] u8, at: int, s: string) -> int {
  o := pet_put(out, at, "\"");
  for c: s {
    if o < 0 || o + 7 > out.count { return -1; }
    if c == 34 || c == 92 { out[o] = 92; out[o + 1] = c; o += 2; }
    else if c == 10 { out[o] = 92; out[o + 1] = 'n'; o += 2; }
    else if c < 32 { out[o] = 32; o += 1; }
    else { out[o] = c; o += 1; }
  }
  return pet_put(out, o, "\"");
}
pj_put_num :: (out: [] u8, at: int, v: f32) -> int {
  if at < 0 { return -1; }
  w := ifx finite(v) then v else 0.0f32;
  o := at;
  if w < 0 { o = pet_put(out, o, "-"); w = -w; }
  whole := cast(int) floor(w);
  frac := cast(int) floor((w - f32(whole)) * 1000 + 0.5);
  if frac >= 1000 { whole += 1; frac -= 1000; }
  digits: [12] u8; d := 0;
  if whole == 0 { digits[0] = '0'; d = 1; }
  while whole > 0 && d < 12 { digits[d] = cast(u8) (48 + whole % 10); whole /= 10; d += 1; }
  for k: 0..<d { if o < 0 || o >= out.count { return -1; } out[o] = digits[d - 1 - k]; o += 1; }
  if o < 0 || o + 4 > out.count { return -1; }
  out[o] = '.'; out[o + 1] = cast(u8) (48 + frac / 100); out[o + 2] = cast(u8) (48 + frac / 10 % 10); out[o + 3] = cast(u8) (48 + frac % 10);
  return o + 4;
}

pj_put_int :: (out: [] u8, at: int, v: int) -> int {
  if at < 0 { return -1; }
  digits: [20] u8; d := 0; w := ifx v < 0 then -v else v;
  if w == 0 { digits[0] = '0'; d = 1; }
  while w > 0 && d < 20 { digits[d] = cast(u8) (48 + w % 10); w /= 10; d += 1; }
  o := ifx v < 0 then pet_put(out, at, "-") else at;
  for k: 0..<d { if o < 0 || o >= out.count { return -1; } out[o] = digits[d - 1 - k]; o += 1; }
  return o;
}

// ---- reading JSON (the server's answers): enough for objects, arrays, strings and numbers

pj_space :: (t: string, i: int) -> int {
  j := i;
  while j < t.count && (t[j] == 32 || t[j] == 10 || t[j] == 13 || t[j] == 9) { j += 1; }
  return j;
}
pj_string_end :: (t: string, i: int) -> int {
  j := i + 1;
  while j < t.count {
    if t[j] == 92 { j += 2; continue; }
    if t[j] == 34 { return j + 1; }
    j += 1;
  }
  return t.count;
}
// Where the value at i ends.
pj_end :: (t: string, i: int) -> int {
  if i >= t.count { return t.count; }
  if t[i] == 34 { return pj_string_end(t, i); }
  if t[i] == 123 || t[i] == 91 {
    depth := 0; j := i;
    while j < t.count {
      c := t[j];
      if c == 34 { j = pj_string_end(t, j); continue; }
      if c == 123 || c == 91 { depth += 1; }
      if c == 125 || c == 93 { depth -= 1; if depth == 0 { return j + 1; } }
      j += 1;
    }
    return t.count;
  }
  j := i;
  while j < t.count && t[j] != 44 && t[j] != 125 && t[j] != 93 && t[j] != 32 && t[j] != 10 { j += 1; }
  return j;
}
// The value of key in the object at obj, or -1.
pj_get :: (t: string, obj: int, key: string) -> int {
  i := pj_space(t, obj);
  if i >= t.count || t[i] != 123 { return -1; }
  i = pj_space(t, i + 1);
  while i < t.count && t[i] == 34 {
    e := pj_string_end(t, i);
    keyed := e - i - 2 == key.count;
    if keyed { for k: 0..<key.count { if t[i + 1 + k] != key[k] { keyed = false; break; } } }
    i = pj_space(t, e);
    if i >= t.count || t[i] != 58 { return -1; }
    i = pj_space(t, i + 1);
    if keyed { return i; }
    i = pj_space(t, pj_end(t, i));
    if i < t.count && t[i] == 44 { i = pj_space(t, i + 1); } else { return -1; }
  }
  return -1;
}
// A string value, unescaped, into out; its length (0 when not a string).
pj_str :: (t: string, at: int, out: [] u8) -> int {
  if at < 0 || at >= t.count || t[at] != 34 { return 0; }
  e := pj_string_end(t, at) - 1;
  i := at + 1; o := 0;
  while i < e && o < out.count {
    c := t[i];
    if c == 92 && i + 1 < e {
      d := t[i + 1];
      if d == 'n' { out[o] = 10; } else if d == 't' { out[o] = 32; } else if d == 'u' { out[o] = '?'; i += 4; } else { out[o] = d; }
      o += 1; i += 2; continue;
    }
    out[o] = c; o += 1; i += 1;
  }
  return o;
}
pj_num :: (t: string, at: int) -> f32 {
  if at < 0 || at >= t.count { return 0; }
  i := at; neg := false;
  if t[i] == 45 { neg = true; i += 1; }
  v := 0.0f64; seen := false;
  while i < t.count && t[i] >= 48 && t[i] <= 57 { v = v * 10 + cast(f64) (t[i] - 48); i += 1; seen = true; }
  if i < t.count && t[i] == 46 {
    i += 1; d := 0.1f64;
    while i < t.count && t[i] >= 48 && t[i] <= 57 { v += cast(f64) (t[i] - 48) * d; d *= 0.1; i += 1; }
  }
  if !seen || v > 1000000 { return 0; }
  return cast(f32) (ifx neg then -v else v);
}
pj_true :: (t: string, at: int) -> bool { return at >= 0 && at < t.count && t[at] == 't'; }
// The array at at's next element after i (i = at to start), or -1 at its end.
pj_next :: (t: string, at: int, i: int) -> int {
  if at < 0 || at >= t.count || t[at] != 91 { return -1; }
  j := 0;
  if i == at { j = pj_space(t, at + 1); }
  else { j = pj_space(t, pj_end(t, i)); if j < t.count && t[j] == 44 { j = pj_space(t, j + 1); } else { return -1; } }
  if j >= t.count || t[j] == 93 { return -1; }
  return j;
}

// ---- what the server said

// A pet (yours) as the server has it: its fields, look, the agent's choices, its files.
pet_take :: (p: [] PetUi, t: string, all: bool) {
  i := pj_space(t, 0);
  id := pj_get(t, i, "id");
  if id < 0 { return; }
  p[0].has = true;
  p[0].id_n = pj_str(t, id, p[0].id[..]);
  p[0].slug_n = pj_str(t, pj_get(t, i, "slug"), p[0].slug[..]);
  st: [12] u8;
  sn := pj_str(t, pj_get(t, i, "status"), st[..]);
  p[0].placed = sn == 6 && st[0] == 'p';
  pl := pj_get(t, i, "plot");
  p[0].plot = ifx pl >= 0 && t[pl] != 'n' then cast(int) pj_num(t, pl) else -1;
  if all {
    for f: 0..<PET_FIELDS {
      if f == p[0].focus { continue; }
      p[0].text_n[f] = pj_str(t, pj_get(t, i, PF_KEY[f]), p[0].text[f * FIELD_BYTES..<f * FIELD_BYTES + PF_CAP[f]]);
    }
  }
  ems := pj_get(t, i, "emotes");
  if ems >= 0 {
    e := ems; c := 0;
    while c < MY_EMOTES {
      e = pj_next(t, ems, e);
      if e < 0 { break; }
      p[0].my_name_n[c] = pj_str(t, pj_get(t, e, "name"), p[0].my_name[c * 24..<c * 24 + 24]);
      p[0].my_label_n[c] = pj_str(t, pj_get(t, e, "label"), p[0].my_label[c * 16..<c * 16 + 16]);
      p[0].my_text_n[c] = pj_str(t, pj_get(t, e, "text"), p[0].my_text[c * EMOTE_TEXT..<(c + 1) * EMOTE_TEXT]);
      c += 1;
    }
    p[0].my_n = c;
  }
  fls := pj_get(t, i, "files");
  if fls >= 0 {
    e := fls; c := 0;
    while c < MY_FILES {
      e = pj_next(t, fls, e);
      if e < 0 { break; }
      st2: [12] u8;
      if pet_s(st2[..], pj_str(t, pj_get(t, e, "status"), st2[..])) != "kept" { continue; }
      p[0].fl_id_n[c] = pj_str(t, pj_get(t, e, "id"), p[0].fl_id[c * FILE_ID..<(c + 1) * FILE_ID]);
      p[0].fl_name_n[c] = pj_str(t, pj_get(t, e, "name"), p[0].fl_name[c * FILE_NAME..<(c + 1) * FILE_NAME]);
      kd: [8] u8;
      p[0].fl_video[c] = pet_s(kd[..], pj_str(t, pj_get(t, e, "kind"), kd[..])) == "video";
      p[0].fl_shown[c] = pj_true(t, pj_get(t, e, "shown"));
      p[0].fl_held[c] = pj_true(t, pj_get(t, e, "held"));
      c += 1;
    }
    p[0].fl_n = c;
  }
  ag: [12] u8;
  an := pj_str(t, pj_get(t, i, "agent"), ag[..]);
  p[0].agent = ifx an == 7 then AGENT_READING else ifx an == 5 then AGENT_READY else ifx an == 6 then AGENT_FAILED else AGENT_NONE;
  p[0].note_n = pj_str(t, pj_get(t, i, "agent_note"), p[0].note[..]);
  if all || p[0].agent == AGENT_READY {
    av := pj_get(t, i, "avatar");
    if av >= 0 {
      for k: 0..<AV_NUMBERS { v := pj_get(t, av, AV_KEY[k]); if v >= 0 { p[0].avatar[k] = clamp(pj_num(t, v), AV_LO[k], AV_HI[k]); } }
      pw: [12] u8;
      pn := pj_str(t, pj_get(t, av, "pattern"), pw[..]);
      for k: 0..<5 { if pet_s(pw[..], pn) == PATTERN_WORDS[k] { p[0].pattern = k; } }
      for which: 0..<2 {
        arr := pj_get(t, av, ifx which == 0 then "coat" else "marks");
        e := arr; c := 0;
        while c < 3 { e = pj_next(t, arr, e); if e < 0 { break; } v := clamp(pj_num(t, e), 0, 1); if which == 0 { p[0].coat[c] = v; } else { p[0].marks[c] = v; } c += 1; }
      }
      p[0].look_new = true;
      sk := pj_get(t, av, "skills");
      if sk >= 0 {
        bits := 0; e := sk; w: [16] u8;
        while true { e = pj_next(t, sk, e); if e < 0 { break; } n := pj_str(t, e, w[..]); for q: 0..<3 { if pet_s(w[..], n) == SKILL_WORDS[q] { bits = bits | (1 << q); } } }
        p[0].skills = bits;
      }
    }
    ch := pj_get(t, i, "choices");
    p[0].choices = 0;
    e := ch;
    while p[0].choices < CHOICES {
      e = pj_next(t, ch, e);
      if e < 0 { break; }
      c := p[0].choices;
      slot := p[0].choice[c * 220..<c * 220 + 220];
      n := pj_str(t, pj_get(t, e, "part"), slot);
      n = pet_put(slot, n, ": ");
      if n < 0 { continue; }
      n += pj_str(t, pj_get(t, e, "why"), slot[n..<220]);
      p[0].choice_n[c] = n;
      p[0].choices = c + 1;
    }
  }
}

pet_take_garden :: (p: [] PetUi, t: string) {
  arr := pj_get(t, 0, "pets");
  e := arr; n := 0;
  while n < GARDEN_MAX {
    e = pj_next(t, arr, e);
    if e < 0 { break; }
    p[0].g_plot[n] = clamp_i(cast(int) pj_num(t, pj_get(t, e, "plot")), 0, 63);
    p[0].g_name_n[n] = pj_str(t, pj_get(t, e, "name"), p[0].g_name[n * 40..<n * 40 + 40]);
    p[0].g_line_n[n] = pj_str(t, pj_get(t, e, "line"), p[0].g_line[n * 120..<n * 120 + 120]);
    _ := pj_str(t, pj_get(t, e, "slug"), p[0].g_slug[n * 8..<n * 8 + 8]);
    p[0].g_mine[n] = pj_true(t, pj_get(t, e, "mine"));
    n += 1;
  }
  p[0].garden = n;
}
clamp_i :: (v: int, a: int, b: int) -> int { return ifx v < a then a else ifx v > b then b else v; }

pet_take_vases :: (p: [] PetUi, t: string) {
  arr := pj_get(t, 0, "vases");
  e := arr; n := 0;
  while n < VASES_MAX {
    e = pj_next(t, arr, e);
    if e < 0 { break; }
    p[0].v_n[n] = cast(int) pj_num(t, pj_get(t, e, "n"));
    p[0].v_x[n] = pj_num(t, pj_get(t, e, "x")); p[0].v_z[n] = pj_num(t, pj_get(t, e, "z")); p[0].v_yaw[n] = pj_num(t, pj_get(t, e, "yaw"));
    p[0].v_age[n] = pj_num(t, pj_get(t, e, "age"));
    p[0].v_mine[n] = pj_true(t, pj_get(t, e, "mine"));
    for k: 0..<VASE_SLOTS { p[0].v_flowers[n * VASE_SLOTS + k] = -1; }
    fl := pj_get(t, e, "flowers"); f := fl;
    while true {
      f = pj_next(t, fl, f);
      if f < 0 { break; }
      slot := cast(int) pj_num(t, pj_get(t, f, "slot")); kind := cast(int) pj_num(t, pj_get(t, f, "kind"));
      if slot >= 0 && slot < VASE_SLOTS && kind >= 0 && kind < FLOWER_KINDS { p[0].v_flowers[n * VASE_SLOTS + slot] = kind; }
    }
    n += 1;
  }
  p[0].vases = n;
}

pet_take_memorial :: (p: [] PetUi, t: string) {
  i := pj_space(t, 0);
  p[0].m_name_n = pj_str(t, pj_get(t, i, "name"), p[0].m_name[..]);
  born: [24] u8; died: [24] u8;
  bn := pj_str(t, pj_get(t, i, "born"), born[..]); dn := pj_str(t, pj_get(t, i, "died"), died[..]);
  d := pet_put(p[0].m_dates[..], 0, pet_s(born[..], bn));
  if dn > 0 { d = pet_put(p[0].m_dates[..], d, ifx bn > 0 then " - " else ""); d = pet_put(p[0].m_dates[..], d, pet_s(died[..], dn)); }
  p[0].m_dates_n = ifx d < 0 then 0 else d;
  p[0].m_line_n = pj_str(t, pj_get(t, i, "line"), p[0].m_line[..]);
  p[0].m_story_n = pj_str(t, pj_get(t, i, "story"), p[0].m_story[..]);
  p[0].m_traits_n = pj_str(t, pj_get(t, i, "traits"), p[0].m_traits[..]);
  p[0].m_ach_n = pj_str(t, pj_get(t, i, "achievements"), p[0].m_ach[..]);
  p[0].m_mine = pj_true(t, pj_get(t, i, "mine"));
  md := pj_get(t, i, "media");
  p[0].m_media_n = 0; p[0].m_big = -1;
  e := md;
  while md >= 0 && p[0].m_media_n < MEDIA_MAX {
    e = pj_next(t, md, e);
    if e < 0 { break; }
    c := p[0].m_media_n;
    hex: [MEDIA_ID] u8;
    hn := pj_str(t, pj_get(t, e, "id"), hex[..]);
    if hn != MEDIA_ID { continue; }
    ok := true;
    for q: 0..<MEDIA_ID { h := hex[q]; if !((h >= '0' && h <= '9') || (h >= 'a' && h <= 'f')) { ok = false; } }
    if !ok { continue; }
    for q: 0..<MEDIA_ID { p[0].m_media[c * MEDIA_ID + q] = hex[q]; }
    kd: [8] u8;
    p[0].m_video[c] = pet_s(kd[..], pj_str(t, pj_get(t, e, "kind"), kd[..])) == "video";
    p[0].m_media_n = c + 1;
  }
  pet_take_notes(p, t);
  p[0].m_ok = p[0].m_name_n > 0;
}
pet_take_notes :: (p: [] PetUi, t: string) {
  arr := pj_get(t, 0, "notes");
  if arr < 0 { return; }
  // the last NOTES of them
  total := 0; e := arr;
  while true { e = pj_next(t, arr, e); if e < 0 { break; } total += 1; }
  skip := ifx total > NOTES then total - NOTES else 0;
  e = arr; k := 0; n := 0;
  while n < NOTES {
    e = pj_next(t, arr, e);
    if e < 0 { break; }
    k += 1;
    if k <= skip { continue; }
    p[0].n_num[n] = cast(int) pj_num(t, pj_get(t, e, "n"));
    p[0].n_name_n[n] = pj_str(t, pj_get(t, e, "name"), p[0].n_name[n * 40..<n * 40 + 40]);
    p[0].n_text_n[n] = pj_str(t, pj_get(t, e, "text"), p[0].n_text[n * NOTE_BYTES..<n * NOTE_BYTES + NOTE_BYTES]);
    n += 1;
  }
  p[0].notes = n;
}

// ---- the requests the face makes

pet_start :: (p: [] PetUi) {
  p[0].focus = -1; p[0].slide = -1; p[0].near = -1; p[0].emote = -1; p[0].plot = -1;
  p[0].file_sure = -1; p[0].m_big = -1;
  for k: 0..<AV_NUMBERS { p[0].avatar[k] = AV_USUAL[k]; }
  p[0].coat[0] = 0.55; p[0].coat[1] = 0.36; p[0].coat[2] = 0.2;
  p[0].marks[0] = 0.92; p[0].marks[1] = 0.88; p[0].marks[2] = 0.82;
  p[0].skills = 7; p[0].holding = -1; p[0].doing = -1; p[0].put_plot = -1;
  for k: 0..<VASE_SLOTS { p[0].vase[k] = -1; }
  p[0].asks = ASK_MINE | ASK_GARDEN | ASK_VASES;
}

// The next request wanted (an ASK_*), 0 none.
pet_next :: (p: [] PetUi) -> int {
  for k: 0..<ASK_KINDS {
    b := 1 << k;
    if p[0].asks & b == 0 { continue; }
    needs_pet := b == ASK_SAVE || b == ASK_AGENT || b == ASK_PLACE || b == ASK_HIDE || b == ASK_SHOW || b == ASK_FILE_DELETE;
    if needs_pet && !p[0].has { continue; }
    if b == ASK_SAVE && (p[0].dirty_t < 0.8 && p[0].asks & (ASK_AGENT | ASK_PLACE) == 0) { continue; }
    return b;
  }
  return 0;
}
pet_post :: (kind: int) -> bool { return kind != ASK_MINE && kind != ASK_GARDEN && kind != ASK_MEMORIAL && kind != ASK_VASES; }

pet_url :: (p: [] PetUi, kind: int, out: [] u8) -> int {
  n := 0;
  if kind == ASK_MINE || kind == ASK_NEW { n = pet_put(out, 0, "/api/villa/pets"); }
  else if kind == ASK_VASES || kind == ASK_VASE { n = pet_put(out, 0, "/api/villa/vases"); }
  else if kind == ASK_REPORT { n = pet_put(out, 0, "/api/villa/report"); }
  else if kind == ASK_CLEAN { n = pet_put(out, 0, "/api/villa/vases/"); n = pj_put_int(out, n, p[0].clean_n); n = pet_put(out, n, "/clean"); }
  else if kind == ASK_GARDEN { n = pet_put(out, 0, "/api/villa/garden"); }
  else if kind == ASK_MEMORIAL || kind == ASK_NOTE {
    n = pet_put(out, 0, "/api/villa/memorial/"); n = pet_put(out, n, pet_s(p[0].m_slug[..], 8));
    if kind == ASK_NOTE { n = pet_put(out, n, "/notes"); }
  } else {
    n = pet_put(out, 0, "/api/villa/pets/"); n = pet_put(out, n, pet_s(p[0].id[..], p[0].id_n));
    if kind == ASK_AGENT { n = pet_put(out, n, "/agent"); }
    if kind == ASK_PLACE { n = pet_put(out, n, "/place"); }
    if kind == ASK_EMOTE { n = pet_put(out, n, "/emote"); }
    if kind == ASK_EMOTE_KEEP { n = pet_put(out, n, "/emote/keep"); }
    if kind == ASK_SHOW || kind == ASK_FILE_DELETE {
      f := clamp_i(p[0].file_at, 0, MY_FILES - 1);
      n = pet_put(out, n, "/files/"); n = pet_put(out, n, pet_s(p[0].fl_id[f * FILE_ID..<(f + 1) * FILE_ID], p[0].fl_id_n[f]));
      n = pet_put(out, n, ifx kind == ASK_FILE_DELETE then "/delete" else ifx p[0].file_on then "/show" else "/unshow");
    }
    if kind == ASK_HIDE {
      n = pet_put(out, n, "/notes/");
      digits: [12] u8; d := 0; v := p[0].hide_n;
      if v <= 0 { digits[0] = '0'; d = 1; }
      while v > 0 && d < 12 { digits[d] = cast(u8) (48 + v % 10); v /= 10; d += 1; }
      for k: 0..<d { if n < 0 || n >= out.count { return 0; } out[n] = digits[d - 1 - k]; n += 1; }
      n = pet_put(out, n, "/hide");
    }
  }
  return ifx n < 0 then 0 else n;
}

pet_body :: (p: [] PetUi, kind: int, out: [] u8) -> int {
  if kind == ASK_NEW {
    n := pet_put(out, 0, "{\"name\":");
    n = pj_put_str(out, n, pet_field(p, PF_NAME));
    return pet_put(out, n, "}");
  }
  if kind == ASK_NOTE {
    n := pet_put(out, 0, "{\"text\":");
    n = pj_put_str(out, n, pet_s(p[0].typed[..], p[0].typed_n));
    return pet_put(out, n, "}");
  }
  if kind == ASK_PLACE { return pet_put(out, 0, "{\"near\":40}"); }
  if kind == ASK_EMOTE {
    n := pet_put(out, 0, "{\"said\":"); n = pj_put_str(out, n, pet_s(p[0].em_said[..], p[0].em_said_n));
    if p[0].em_error_n > 0 {
      n = pet_put(out, n, ",\"error\":"); n = pj_put_str(out, n, pet_s(p[0].em_error[..], p[0].em_error_n));
      n = pet_put(out, n, ",\"last\":"); n = pj_put_str(out, n, pet_s(p[0].em_text[..], p[0].em_text_n));
    }
    return pet_put(out, n, "}");
  }
  if kind == ASK_EMOTE_KEEP {
    n := pet_put(out, 0, "{\"name\":"); n = pj_put_str(out, n, pet_s(p[0].em_name[..], p[0].em_name_n));
    n = pet_put(out, n, ",\"label\":"); n = pj_put_str(out, n, pet_s(p[0].em_label[..], p[0].em_label_n));
    n = pet_put(out, n, ",\"text\":"); n = pj_put_str(out, n, pet_s(p[0].em_text[..], p[0].em_text_n));
    n = pet_put(out, n, ",\"said\":"); n = pj_put_str(out, n, pet_s(p[0].em_said[..], p[0].em_said_n));
    return pet_put(out, n, "}");
  }
  if kind == ASK_REPORT {
    rk := clamp_i(p[0].report_kind, 0, 3);
    n := pet_put(out, 0, "{\"kind\":\""); n = pet_put(out, n, REPORT_KIND_WORDS[rk]); n = pet_put(out, n, "\",\"ref\":\"");
    if rk == REPORT_MEMORIAL { n = pet_put(out, n, pet_s(p[0].m_slug[..], 8)); }
    else if rk == REPORT_FILE { f := clamp_i(p[0].report_media, 0, MEDIA_MAX - 1); n = pet_put(out, n, pet_s(p[0].m_media[f * MEDIA_ID..<(f + 1) * MEDIA_ID], MEDIA_ID)); }
    else { n = pj_put_int(out, n, p[0].report_ref); }
    return pet_put(out, n, "\"}");
  }
  if kind == ASK_VASE {
    n := pet_put(out, 0, "{\"x\":"); n = pj_put_num(out, n, p[0].put_x);
    n = pet_put(out, n, ",\"z\":"); n = pj_put_num(out, n, p[0].put_z);
    n = pet_put(out, n, ",\"yaw\":"); n = pj_put_num(out, n, p[0].put_yaw);
    if p[0].put_plot >= 0 { n = pet_put(out, n, ",\"plot\":"); n = pj_put_int(out, n, p[0].put_plot); }
    n = pet_put(out, n, ",\"flowers\":[");
    first := true;
    for k: 0..<VASE_SLOTS {
      if p[0].vase[k] < 0 { continue; }
      if !first { n = pet_put(out, n, ","); }
      first = false;
      n = pet_put(out, n, "{\"kind\":"); n = pj_put_int(out, n, p[0].vase[k]); n = pet_put(out, n, ",\"slot\":"); n = pj_put_int(out, n, k); n = pet_put(out, n, "}");
    }
    n = pet_put(out, n, "]}");
    return ifx n < 0 then 0 else n;
  }
  if kind != ASK_SAVE { return pet_put(out, 0, "{}"); }
  n := pet_put(out, 0, "{");
  for f: 0..<PET_FIELDS {
    n = pj_put_str(out, n, PF_KEY[f]); n = pet_put(out, n, ":");
    n = pj_put_str(out, n, pet_field(p, f)); n = pet_put(out, n, ",");
  }
  n = pet_put(out, n, "\"avatar\":{");
  for k: 0..<AV_NUMBERS { n = pj_put_str(out, n, AV_KEY[k]); n = pet_put(out, n, ":"); n = pj_put_num(out, n, p[0].avatar[k]); n = pet_put(out, n, ","); }
  n = pet_put(out, n, "\"pattern\":"); n = pj_put_str(out, n, PATTERN_WORDS[clamp_i(p[0].pattern, 0, 4)]);
  n = pet_put(out, n, ",\"skills\":[");
  sk_first := true;
  for q: 0..<3 { if p[0].skills & (1 << q) != 0 { if !sk_first { n = pet_put(out, n, ","); } sk_first = false; n = pj_put_str(out, n, SKILL_WORDS[q]); } }
  n = pet_put(out, n, "]");
  for which: 0..<2 {
    n = pet_put(out, n, ifx which == 0 then ",\"coat\":[" else "],\"marks\":[");
    for c: 0..<3 { if c > 0 { n = pet_put(out, n, ","); } n = pj_put_num(out, n, ifx which == 0 then p[0].coat[c] else p[0].marks[c]); }
  }
  n = pet_put(out, n, "]}}");
  return ifx n < 0 then 0 else n;
}

// An answer to a request: its status and body.
pet_answer :: (p: [] PetUi, kind: int, status: int, t: string) {
  if p[0].asks & kind != 0 { p[0].asks = p[0].asks - kind; }
  if kind == ASK_GARDEN { if status == 200 { pet_take_garden(p, t); } p[0].garden_t = 0; return; }
  if kind == ASK_MINE {
    if status != 200 { return; }
    arr := pj_get(t, 0, "pets");
    first := pj_next(t, arr, arr);
    if first >= 0 { pet_take(p, t[first..<pj_end(t, first)], true); }
    return;
  }
  if kind == ASK_MEMORIAL {
    p[0].m_status = status;
    if status == 200 { pet_take_memorial(p, t); } else { p[0].m_ok = false; }
    return;
  }
  if kind == ASK_HIDE { if status == 200 { pet_take_notes(p, t); } return; }
  if kind == ASK_EMOTE {
    if status != 200 {
      p[0].em = EM_FAILED;
      pet_toast(p, ifx status == 429 then "A little slower: try again in a moment" else "We couldn't make that one: try again");
      return;
    }
    mo := pj_get(t, 0, "motion");
    p[0].em_name_n = pj_str(t, pj_get(t, mo, "name"), p[0].em_name[..]);
    p[0].em_label_n = pj_str(t, pj_get(t, mo, "label"), p[0].em_label[..]);
    p[0].em_text_n = pj_str(t, pj_get(t, mo, "text"), p[0].em_text[..]);
    p[0].em = EM_CHECK;   // the face reads it with the engine's reader and plays it
    return;
  }
  if kind == ASK_EMOTE_KEEP {
    if status == 200 { pet_take(p, t, false); pet_toast(p, "Their new emote is kept: it's with the others"); }
    return;
  }
  if kind == ASK_SHOW || kind == ASK_FILE_DELETE {
    if status == 200 {
      pet_take(p, t, false);
      p[0].file_sure = -1;
      pet_toast(p, ifx kind == ASK_FILE_DELETE then "It's deleted: it's gone from our bucket" else ifx p[0].file_on then "It's on their memorial now" else "It's off their memorial");
      if p[0].placed { p[0].asks = p[0].asks | ASK_MEMORIAL; }   // a memorial open on your pet shows it at once
    } else { pet_toast(p, "That didn't change: try again"); }
    return;
  }
  if kind == ASK_REPORT {
    pet_toast(p, ifx status == 200 then "Thank you: we'll look at it" else ifx status == 429 then "A little slower: try again later" else ifx status == 404 then "It isn't there any more" else "That report didn't send: try again");
    return;
  }
  if kind == ASK_VASES { if status == 200 { pet_take_vases(p, t); } p[0].vases_t = 0; return; }
  if kind == ASK_VASE {
    if status == 200 {
      used := 0;
      for k: 0..<VASE_SLOTS { if p[0].vase[k] >= 0 { used += 1; } p[0].vase[k] = -1; }
      pet_ev(p, EV_VASE, ifx p[0].put_plot >= 0 then 100 + used else used);   // 100 and up: left by a tombstone
      p[0].asks = p[0].asks | ASK_VASES;
      pet_toast(p, ifx p[0].put_plot >= 0 then "Your vase is by their stone" else "Your vase is left here for everyone to see");
    } else {
      e: [160] u8;
      en := pj_str(t, pj_get(t, 0, "error"), e[..]);
      // the flowers come back to the bag
      for k: 0..<VASE_SLOTS { if p[0].vase[k] >= 0 { p[0].bag[p[0].vase[k]] += 1; p[0].vase[k] = -1; } }
      pet_toast(p, ifx en > 0 then pet_s(e[..], en) else "The vase didn't stay: try again");
    }
    return;
  }
  if kind == ASK_CLEAN { p[0].asks = p[0].asks | ASK_VASES; if status == 200 { pet_toast(p, "You cleaned up your vase"); pet_ev(p, EV_VASE_CLEAN, 0); } return; }
  if kind == ASK_NOTE {
    if status == 200 { p[0].typed_n = 0; pet_take_notes(p, t); pet_toast(p, "Your note is on the memorial"); pet_ev(p, EV_NOTE, 0); }
    else if status == 429 { pet_toast(p, "A little slower: try again in a minute"); }
    else if status == 400 { pet_toast(p, "Notes can't carry links"); }
    else { pet_toast(p, "That note didn't send: try again"); }
    return;
  }
  if status != 200 {
    if kind == ASK_AGENT { p[0].agent = AGENT_FAILED; }
    e: [160] u8;
    n := pj_str(t, pj_get(t, 0, "error"), e[..]);
    pet_toast(p, ifx n > 0 then pet_s(e[..], n) else "That didn't save: try again");
    return;
  }
  pet_take(p, t, kind == ASK_NEW);
  if kind == ASK_NEW { p[0].dirty = true; p[0].asks = p[0].asks | ASK_SAVE; pet_ev(p, EV_PET_MADE, 0); }
  if kind == ASK_AGENT { pet_ev(p, EV_AVATAR, 0); }
  if kind == ASK_SAVE { p[0].dirty = false; }
  if kind == ASK_PLACE {
    p[0].asks = p[0].asks | ASK_GARDEN;
    pet_toast(p, "Their tombstone is in the garden now");
    pet_ev(p, EV_PLACED, 0);
  }
}

// An edit: kept here at once, sent a moment later (a new pet is made first).
pet_changed :: (p: [] PetUi) {
  p[0].dirty = true; p[0].dirty_t = 0;
  if !p[0].has { if p[0].text_n[PF_NAME] > 0 { p[0].asks = p[0].asks | ASK_NEW; } return; }
  p[0].asks = p[0].asks | ASK_SAVE;
}

pet_tick :: (p: [] PetUi, dt: f32) {
  p[0].dirty_t += dt;
  p[0].garden_t += dt;
  if p[0].toast_t > 0 { p[0].toast_t -= dt; }
  if p[0].garden_t > 30 { p[0].asks = p[0].asks | ASK_GARDEN; p[0].garden_t = 0; }
  p[0].vases_t += dt;
  if p[0].vases_t > 45 { p[0].asks = p[0].asks | ASK_VASES; p[0].vases_t = 0; }
  for k: 0..<p[0].vases { p[0].v_age[k] += dt; }
  if p[0].agent == AGENT_READING && p[0].asks & ASK_AGENT == 0 && p[0].dirty_t > 200 { p[0].agent = AGENT_FAILED; }
}

// ---- typing

pet_typed :: (p: [] PetUi, t: string) {
  if p[0].focus == TYPE_EMOTE {
    for c: t { if c >= 32 && p[0].em_said_n < EMOTE_SAID { p[0].em_said[p[0].em_said_n] = c; p[0].em_said_n += 1; } }
    return;
  }
  if p[0].focus == TYPE_NOTE {
    for c: t { if c >= 32 && p[0].typed_n < NOTE_BYTES { p[0].typed[p[0].typed_n] = c; p[0].typed_n += 1; } }
    return;
  }
  f := p[0].focus;
  if f < 0 || f >= PET_FIELDS { return; }
  for c: t {
    if p[0].text_n[f] >= PF_CAP[f] { break; }
    if c < 32 && !(c == 10 && f == PF_STORY) { continue; }
    p[0].text[f * FIELD_BYTES + p[0].text_n[f]] = c; p[0].text_n[f] += 1;
  }
  pet_changed(p);
}
pet_backspace :: (p: [] PetUi) {
  if p[0].focus == TYPE_EMOTE {
    while p[0].em_said_n > 0 { p[0].em_said_n -= 1; if p[0].em_said[p[0].em_said_n] & 0xC0 != 0x80 { break; } }
    return;
  }
  if p[0].focus == TYPE_NOTE {
    while p[0].typed_n > 0 { p[0].typed_n -= 1; if p[0].typed[p[0].typed_n] & 0xC0 != 0x80 { break; } }
    return;
  }
  f := p[0].focus;
  if f < 0 || f >= PET_FIELDS { return; }
  while p[0].text_n[f] > 0 {
    p[0].text_n[f] -= 1;
    if p[0].text[f * FIELD_BYTES + p[0].text_n[f]] & 0xC0 != 0x80 { break; }
  }
  pet_changed(p);
}
// A key while the panel is open: true when it's the panel's.
pet_key :: (p: [] PetUi, key: int) -> bool {
  if p[0].view == PV_NONE { return false; }
  if key == -1 { if p[0].focus != -1 { p[0].focus = -1; } else { pet_close(p); } return true; }
  if p[0].focus == -1 { return false; }
  if key == -3 { pet_backspace(p); return true; }
  if key == -2 {
    if p[0].focus == TYPE_NOTE { pet_send_note(p); return true; }
    if p[0].focus == TYPE_EMOTE { pet_make_emote(p); return true; }
    if p[0].focus == PF_STORY { pet_typed(p, "\n"); return true; }
    p[0].focus = ifx p[0].focus + 1 < PET_FIELDS then p[0].focus + 1 else -1;
    return true;
  }
  return true;   // typed letters come as text; the keys themselves walk nobody
}
// Asks the agent for an emote from what's typed.
pet_make_emote :: (p: [] PetUi) {
  if p[0].em_said_n == 0 { pet_toast(p, "Tell us something they always did first"); return; }
  if !p[0].has { pet_toast(p, "Give them a name first"); return; }
  if p[0].em == EM_MAKING || p[0].em == EM_CHECK { return; }
  p[0].em = EM_MAKING; p[0].em_tries = 1; p[0].em_error_n = 0; p[0].focus = -1;
  p[0].asks = p[0].asks | ASK_EMOTE;
}
// The face's check of the agent's motion: it played, or why the engine refused it.
pet_emote_checked :: (p: [] PetUi, ok: bool, why: string) {
  if p[0].em != EM_CHECK { return; }
  if ok {
    p[0].em = EM_NONE; p[0].em_said_n = 0;
    p[0].asks = p[0].asks | ASK_EMOTE_KEEP;
    pet_ev(p, EV_EMOTE, 100);
    return;
  }
  n := 0;
  while n < why.count && n < 300 { p[0].em_error[n] = why[n]; n += 1; }
  p[0].em_error_n = n;
  if p[0].em_tries >= EMOTE_TRIES { p[0].em = EM_FAILED; pet_toast(p, "We couldn't make that one: try saying it another way"); return; }
  p[0].em_tries += 1; p[0].em = EM_MAKING;
  p[0].asks = p[0].asks | ASK_EMOTE;
}
pet_send_note :: (p: [] PetUi) {
  if p[0].typed_n == 0 { return; }
  p[0].asks = p[0].asks | ASK_NOTE;
}

pet_open_memorial :: (p: [] PetUi, slug: string) {
  if slug.count != 8 { return; }
  for k: 0..<8 { p[0].m_slug[k] = slug[k]; }
  p[0].view = PV_MEMORIAL; p[0].m_ok = false; p[0].m_status = 0; p[0].focus = -1; p[0].typed_n = 0;
  pet_ev(p, EV_MEMORIAL, 0);
  p[0].asks = p[0].asks | ASK_MEMORIAL;
}
pet_close :: (p: [] PetUi) {
  p[0].view = PV_NONE; p[0].focus = -1; p[0].slide = -1;
  if p[0].dirty && p[0].has { p[0].asks = p[0].asks | ASK_SAVE; p[0].dirty_t = 10; }
}

// ---- presses

pet_button :: (p: [] PetUi, b: Box, kind: int, arg: int) {
  n := p[0].buttons;
  if n >= BUTTONS { return; }
  p[0].button[n] = b; p[0].button_kind[n] = kind; p[0].button_arg[n] = arg;
  p[0].buttons = n + 1;
}
pet_hit :: (p: [] PetUi, x: f32, y: f32) -> int {
  k := p[0].buttons - 1;
  while k >= 0 { if in_box(p[0].button[k], x, y) { return k; } k -= 1; }
  return -1;
}
pet_slide_to :: (p: [] PetUi, k: int, x: f32) {
  i := p[0].slide;
  if i < 0 || i >= AV_NUMBERS || k < 0 { return; }
  b := p[0].button[k];
  t := clamp((x - b.x0) / hi(b.x1 - b.x0, 1), 0, 1);
  p[0].avatar[i] = AV_LO[i] + t * (AV_HI[i] - AV_LO[i]);
  p[0].look_new = true;
  pet_changed(p);
}

// A press or a drag on the panel (phase 0 down, 1 move, 2 up). True when it was the panel's.
pet_pointer :: (p: [] PetUi, x: f32, y: f32, phase: int) -> bool {
  if phase == 1 && p[0].slide >= 0 {
    for k: 0..<p[0].buttons { if p[0].button_kind[k] == B_SLIDER && p[0].button_arg[k] == p[0].slide { pet_slide_to(p, k, x); } }
    return true;
  }
  if phase == 2 { was := p[0].slide >= 0; p[0].slide = -1; return was || (p[0].view != PV_NONE && pet_hit(p, x, y) >= 0); }
  if phase != 0 { return false; }
  k := pet_hit(p, x, y);
  if k < 0 { if p[0].view != PV_NONE { p[0].focus = -1; return in_box(p[0].button[0], x, y); } return false; }
  kind := p[0].button_kind[k]; arg := p[0].button_arg[k];
  if kind != B_FIELD && kind != B_NOTE && kind != B_EMOTE_FIELD { p[0].focus = -1; }
  if kind == B_OPEN { p[0].view = PV_PET; p[0].tab = 0; if !p[0].has { p[0].focus = PF_NAME; } }
  else if kind == B_CLOSE { pet_close(p); }
  else if kind == B_FIELD { p[0].focus = arg; }
  else if kind == B_NOTE { p[0].focus = TYPE_NOTE; }
  else if kind == B_EMOTE_FIELD { p[0].focus = TYPE_EMOTE; }
  else if kind == B_MAKE_EMOTE { pet_make_emote(p); }
  else if kind == B_SEND { pet_send_note(p); }
  else if kind == B_TAB { p[0].tab = arg; }
  else if kind == B_PHOTOS {
    if !p[0].has { pet_toast(p, "Give them a name first"); return true; }
    n := pet_put(p[0].outbox[..], 0, "/api/villa/pets/");
    n = pet_put(p[0].outbox[..], n, pet_s(p[0].id[..], p[0].id_n));
    n = pet_put(p[0].outbox[..], n, "/files");
    if n > 0 { p[0].out_n = n; p[0].action = 30; }
  }
  else if kind == B_AGENT {
    if !p[0].has { pet_toast(p, "Give them a name first"); return true; }
    if p[0].agent == AGENT_READING { return true; }
    p[0].agent = AGENT_READING; p[0].dirty_t = 0;
    p[0].asks = p[0].asks | ASK_SAVE | ASK_AGENT;
  }
  else if kind == B_PLAY {
    if !p[0].has { pet_toast(p, "Give them a name first"); return true; }
    p[0].asks = p[0].asks | ASK_SAVE | ASK_PLACE;
    p[0].view = PV_NONE;
  }
  else if kind == B_SLIDER { p[0].slide = arg; pet_slide_to(p, k, x); }
  else if kind == B_PATTERN { p[0].pattern = arg; p[0].look_new = true; pet_changed(p); }
  else if kind == B_COAT || kind == B_MARKS {
    for c: 0..<3 { v := SWATCH[arg * 3 + c]; if kind == B_COAT { p[0].coat[c] = v; } else { p[0].marks[c] = v; } }
    p[0].look_new = true; pet_changed(p);
  }
  else if kind == B_EMOTE { p[0].emote = arg; pet_ev(p, EV_EMOTE, arg); }
  else if kind == B_MEMORIAL {
    if arg >= 0 && arg < p[0].garden { pet_open_memorial(p, pet_s(p[0].g_slug[arg * 8..<arg * 8 + 8], 8)); }
    else if p[0].slug_n == 8 { pet_open_memorial(p, pet_s(p[0].slug[..], 8)); }
  }
  else if kind == B_SHARE {
    n := pet_put(p[0].outbox[..], 0, "https://openagents.com/api/villa/m/");
    n = pet_put(p[0].outbox[..], n, pet_s(p[0].m_slug[..], 8));
    if n > 0 { p[0].out_n = n; p[0].action = 2; pet_toast(p, "The link is copied: send it to family and friends"); pet_ev(p, EV_SHARE, 0); }
  }
  else if kind == B_SKILL { p[0].skills = p[0].skills ^ (1 << arg); pet_changed(p); }
  else if kind == B_DO { p[0].doing = arg; }
  else if kind == B_KIND { p[0].holding = ifx p[0].holding == arg then -1 else arg; }
  else if kind == B_SLOT {
    cur := p[0].vase[arg];
    if cur >= 0 { p[0].bag[cur] += 1; p[0].vase[arg] = -1; }
    else if p[0].holding >= 0 && p[0].bag[p[0].holding] > 0 {
      p[0].vase[arg] = p[0].holding; p[0].bag[p[0].holding] -= 1;
      if p[0].bag[p[0].holding] == 0 { p[0].holding = -1; }
    } else { pet_toast(p, "Pick a flower below, then a place in the vase"); }
  }
  else if kind == B_PLACE_VASE {
    some := false;
    for q: 0..<VASE_SLOTS { if p[0].vase[q] >= 0 { some = true; } }
    if !some { pet_toast(p, "Put a flower in the vase first"); return true; }
    p[0].asks = p[0].asks | ASK_VASE; p[0].view = PV_NONE;
  }
  else if kind == B_CLEAN { p[0].clean_n = arg; p[0].asks = p[0].asks | ASK_CLEAN; }
  else if kind == B_REPORT {
    p[0].report_kind = arg / 1000000; p[0].report_ref = arg % 1000000;
    p[0].asks = p[0].asks | ASK_REPORT;
  }
  else if kind == B_SHOW_FILE {
    if arg < 0 || arg >= p[0].fl_n { return true; }
    p[0].file_at = arg; p[0].file_on = !p[0].fl_shown[arg]; p[0].file_sure = -1;
    p[0].asks = p[0].asks | ASK_SHOW;
  }
  else if kind == B_DELETE_FILE {
    if arg < 0 || arg >= p[0].fl_n { return true; }
    if p[0].file_sure != arg { p[0].file_sure = arg; return true; }   // once more to be sure
    p[0].file_at = arg; p[0].asks = p[0].asks | ASK_FILE_DELETE;
  }
  else if kind == B_MEDIA { p[0].m_big = ifx p[0].m_big == arg || arg < 0 || arg >= p[0].m_media_n then -1 else arg; }
  else if kind == B_REPORT_MEDIA {
    if arg < 0 || arg >= p[0].m_media_n { return true; }
    p[0].report_kind = REPORT_FILE; p[0].report_media = arg; p[0].asks = p[0].asks | ASK_REPORT;
  }
  else if kind == B_HIDE {
    // the owner hides a note: the face sends it as a save of the note's state
    p[0].hide_n = arg; p[0].asks = p[0].asks | ASK_HIDE;
  }
  return true;
}

// ---- drawing (in villa.coax's HUD)

pt :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: f32, alpha: f32) -> int {
  return draw_text(out, n, t, x, base, cap, GAP, SPACE, ink(k, alpha, PALE_R, PALE_G, PALE_B), false, false);
}
pt_dim :: (out: [] f32, n: int, t: string, x: f32, base: f32, cap: f32, k: f32) -> int {
  return draw_text(out, n, t, x, base, cap, GAP, SPACE, ink(k, 0.62, SILVER_R, SILVER_G, SILVER_B), false, false);
}
outline :: (out: [] f32, n: int, b: Box, k: f32, alpha: f32) -> int {
  m := n;
  xs := [4] f32.[b.x0, b.x1, b.x1, b.x0]; ys := [4] f32.[b.y0, b.y0, b.y1, b.y1];
  for i: 0..<4 {
    j := (i + 1) % 4;
    if lit(out, m, xs[i], ys[i], xs[j], ys[j], 0.6 * k, alpha, 1.2 * k, SILVER_R, SILVER_G, SILVER_B, 0) { m += 6; }
  }
  return m;
}
// A button: its outline, its word centred, and its press.
btn :: (s: [] Villa, out: [] f32, n: int, b: Box, word: string, kind: int, arg: int, on: bool) -> int {
  k := hi(s[0].dpr, 0.5);
  cap := 8 * k;
  m := outline(out, n, b, k, ifx on then 0.95f32 else 0.45f32);
  if on { m = outline(out, m, Box.{x0 = b.x0 + 2 * k, y0 = b.y0 + 2 * k, x1 = b.x1 - 2 * k, y1 = b.y1 - 2 * k}, k, 0.35); }
  m = pt(out, m, word, (b.x0 + b.x1 - text_width(word, cap)) / 2, (b.y0 + b.y1 + cap) / 2, cap, k, ifx on then 1.0f32 else 0.85f32);
  pet_button(s[0].pet[..], b, kind, arg);
  return m;
}
// Text wrapped to a width, from its top line's base; at most lines lines. Returns n; the next base into y[0].
wrapped :: (out: [] f32, n: int, t: string, x: f32, base: f32, width: f32, cap: f32, k: f32, lines: int, alpha: f32, y: [] f32) -> int {
  m := n; from := 0; line := 0; b := base;
  next: [1] int;
  while from < t.count && line < lines {
    next[0] = t.count;
    end := wrap(t, from, width / cap, GAP, SPACE, false, next[..]);
    if end <= from && next[0] <= from { break; }
    m = pt(out, m, t[from..<end], x, b, cap, k, alpha);
    from = next[0]; line += 1; b += cap * 1.9;
  }
  y[0] = b;
  return m;
}

pet_panel_box :: (s: [] Villa) -> Box {
  k := hi(s[0].dpr, 0.5); w := s[0].width; h := s[0].height; g := 16 * k;
  pw := lo(470 * k, w - 2 * g);
  return Box.{x0 = w - g - pw, y0 = g, x1 = w - g, y1 = h - g};
}

// A text field: its label, its box and what's typed (the end of it when long).
field_draw :: (s: [] Villa, out: [] f32, n: int, f: int, x0: f32, x1: f32, top: f32, lines: int) -> int {
  k := hi(s[0].dpr, 0.5); p := s[0].pet[..];
  cap := 8.5 * k; m := n;
  m = pt_dim(out, m, PF_LABEL[f], x0, top + 8 * k, 7 * k, k);
  b := Box.{x0 = x0, y0 = top + 14 * k, x1 = x1, y1 = top + 14 * k + f32(lines) * cap * 1.9 + 12 * k};
  focused := p[0].focus == f;
  m = outline(out, m, b, k, ifx focused then 0.95f32 else 0.4f32);
  pet_button(p, b, B_FIELD, f);
  t := pet_field(p, f);
  y: [1] f32;
  if lines == 1 {
    show := t; room := (b.x1 - b.x0 - 16 * k);
    while show.count > 0 && text_width(show, cap) > room { show = show[1..<show.count]; }
    m = pt(out, m, show, b.x0 + 8 * k, b.y0 + 6 * k + cap, cap, k, 0.95);
    if focused { cx := b.x0 + 8 * k + text_width(show, cap) + 2 * k; if lit(out, m, cx, b.y0 + 5 * k, cx, b.y1 - 5 * k, 0.6 * k, 0.9, 1 * k, PALE_R, PALE_G, PALE_B, 0) { m += 6; } }
  } else {
    m = wrapped(out, m, t, b.x0 + 8 * k, b.y0 + 6 * k + cap, b.x1 - b.x0 - 16 * k, cap, k, lines, 0.95, y[..]);
  }
  if focused { p[0].field_box = b; }
  return m;
}

pet_draw_about :: (s: [] Villa, out: [] f32, n: int, x0: f32, x1: f32, top: f32) -> int {
  k := hi(s[0].dpr, 0.5); p := s[0].pet[..]; m := n;
  y := top;
  m = field_draw(s, out, m, PF_NAME, x0, x1, y, 1); y += 52 * k;
  half := (x0 + x1) / 2;
  m = field_draw(s, out, m, PF_BORN, x0, half - 6 * k, y, 1);
  m = field_draw(s, out, m, PF_DIED, half + 6 * k, x1, y, 1); y += 52 * k;
  m = field_draw(s, out, m, PF_LINE, x0, x1, y, 1); y += 52 * k;
  m = field_draw(s, out, m, PF_STORY, x0, x1, y, 4); y += 98 * k;
  m = field_draw(s, out, m, PF_TRAITS, x0, x1, y, 2); y += 66 * k;
  bh := 34 * k;
  m = pt_dim(out, m, "WHAT THEY CAN DO", x0, y + 6 * k, 7 * k, k); y += 12 * k;
  sw := (x1 - x0 - 2 * 6 * k) / 3;
  for q: 0..<3 {
    bx := x0 + f32(q) * (sw + 6 * k);
    m = btn(s, out, m, Box.{x0 = bx, y0 = y, x1 = bx + sw, y1 = y + 28 * k}, SKILL_LABEL[q], B_SKILL, q, p[0].skills & (1 << q) != 0);
  }
  y += 38 * k;
  m = btn(s, out, m, Box.{x0 = x0, y0 = y, x1 = x1, y1 = y + bh}, "ADD PHOTOS OR A SHORT VIDEO", B_PHOTOS, 0, false);
  y += bh + 4 * k;
  uy: [1] f32;
  m = wrapped(out, m, "ONLY YOU SEE THEM UNLESS YOU PUT ONE ON THEIR MEMORIAL. THEY'RE USED FOR THEIR AVATAR AND MEMORIAL, NEVER FOR ANYTHING ELSE", x0, y + 7 * k, x1 - x0, 6.5 * k, k, 2, 0.6, uy[..]);
  y = uy[0] - 4 * k;
  // the kept ones, each on or off the memorial, and DELETE (pressed twice)
  for f: 0..<lo_int(p[0].fl_n, 3) {
    dw := 62 * k; sw2 := 124 * k; rh := 20 * k;
    name := pet_s(p[0].fl_name[f * FILE_NAME..<(f + 1) * FILE_NAME], p[0].fl_name_n[f]);
    room := x1 - x0 - dw - sw2 - 16 * k;
    while name.count > 0 && text_width(name, 7 * k) > room { name = name[0..<name.count - 1]; }
    m = pt_dim(out, m, name, x0, y + 13 * k, 7 * k, k);
    if p[0].fl_held[f] { m = pt_dim(out, m, "TAKEN DOWN BY US", x1 - dw - sw2 - 6 * k + 8 * k, y + 13 * k, 6.5 * k, k); }
    else { m = btn(s, out, m, Box.{x0 = x1 - dw - sw2 - 6 * k, y0 = y, x1 = x1 - dw - 6 * k, y1 = y + rh}, ifx p[0].fl_shown[f] then "ON THE MEMORIAL" else "PUT ON MEMORIAL", B_SHOW_FILE, f, p[0].fl_shown[f]); }
    m = btn(s, out, m, Box.{x0 = x1 - dw, y0 = y, x1 = x1, y1 = y + rh}, ifx p[0].file_sure == f then "SURE?" else "DELETE", B_DELETE_FILE, f, p[0].file_sure == f);
    y += rh + 4 * k;
  }
  if p[0].fl_n > 3 { more: [24] u8; m = pt_dim(out, m, pet_s(more[..], pet_count(more[..], p[0].fl_n - 3, " MORE KEPT")), x0, y + 8 * k, 6.5 * k, k); y += 14 * k; }
  // the files, a line each: name, then how far or what happened
  ft := pet_s(p[0].files[..], p[0].files_n);
  i := 0; line := 0;
  while i < ft.count && line < 2 {
    j := i; while j < ft.count && ft[j] != 10 { j += 1; }
    row := ft[i..<j];
    // name|permille|status|note
    bars: [4] int; bc := 0;
    for c: 0..<row.count { if row[c] == '|' && bc < 3 { bars[bc] = c; bc += 1; } }
    if bc == 3 && row[bars[1] + 1..<bars[2]] != "kept" {   // kept ones are listed above
      name := row[0..<bars[0]]; status := row[bars[1] + 1..<bars[2]]; note := row[bars[2] + 1..<row.count];
      word := ifx status == "kept" then "KEPT" else ifx status == "sending" then "SENDING" else ifx status == "scanning" then "CHECKING" else "NOT KEPT";
      m = pt_dim(out, m, name, x0, y + 8 * k, 7 * k, k);
      m = pt(out, m, word, x1 - text_width(word, 7 * k), y + 8 * k, 7 * k, k, 0.85);
      if note.count > 0 && status != "kept" { y += 14 * k; m = pt_dim(out, m, note, x0, y + 8 * k, 6.5 * k, k); }
      y += 16 * k; line += 1;
    }
    i = j + 1;
  }
  y += 6 * k;
  agent_word := ifx p[0].agent == AGENT_READING then "LOOKING AT THEM..." else ifx p[0].agent == AGENT_READY then "MAKE THEIR AVATAR AGAIN" else "MAKE THEIR AVATAR";
  m = btn(s, out, m, Box.{x0 = x0, y0 = y, x1 = x1, y1 = y + bh}, agent_word, B_AGENT, 0, p[0].agent == AGENT_READING);
  y += bh + 8 * k;
  if p[0].agent == AGENT_FAILED && p[0].note_n > 0 { m = pt_dim(out, m, pet_s(p[0].note[..], p[0].note_n), x0, y + 6 * k, 7 * k, k); y += 16 * k; }
  if p[0].agent == AGENT_READY { m = pt_dim(out, m, "THEIR LOOK: WHAT WE SAW, AND CHANGE ANY OF IT", x0, y + 6 * k, 7 * k, k); y += 16 * k; }
  play := ifx p[0].placed then "VISIT THEIR MEMORIAL" else "PLAY: PUT THEIR STONE IN THE GARDEN";
  m = btn(s, out, m, Box.{x0 = x0, y0 = y, x1 = x1, y1 = y + bh}, play, ifx p[0].placed then B_MEMORIAL else B_PLAY, -1, true);
  return m;
}

pet_draw_look :: (s: [] Villa, out: [] f32, n: int, x0: f32, x1: f32, top: f32) -> int {
  k := hi(s[0].dpr, 0.5); p := s[0].pet[..]; m := n;
  y := top; cap := 7 * k;
  yb: [1] f32;
  for c: 0..<p[0].choices {
    m = wrapped(out, m, pet_s(p[0].choice[c * 220..<c * 220 + 220], p[0].choice_n[c]), x0, y + cap, x1 - x0, cap, k, 2, 0.8, yb[..]);
    y = yb[0] - cap + 4 * k;
    if y > top + 110 * k { break; }
  }
  if p[0].choices > 0 { y += 8 * k; }
  half := (x0 + x1) / 2; col := 0;
  for i: 0..<AV_NUMBERS {
    cx0 := ifx col == 0 then x0 else half + 8 * k; cx1 := ifx col == 0 then half - 8 * k else x1;
    m = pt_dim(out, m, AV_LABEL[i], cx0, y + 8 * k, cap, k);
    b := Box.{x0 = cx0, y0 = y + 12 * k, x1 = cx1, y1 = y + 30 * k};
    mid := (b.y0 + b.y1) / 2;
    if lit(out, m, b.x0, mid, b.x1, mid, 0.5 * k, 0.45, 1 * k, SILVER_R, SILVER_G, SILVER_B, 0) { m += 6; }
    t := (p[0].avatar[i] - AV_LO[i]) / (AV_HI[i] - AV_LO[i]);
    kx := b.x0 + t * (b.x1 - b.x0);
    if lit(out, m, kx - 0.01, mid, kx + 0.01, mid, 6 * k, 0.9, 3 * k, PALE_R, PALE_G, PALE_B, 0) { m += 6; }
    pet_button(p, b, B_SLIDER, i);
    col = 1 - col;
    if col == 0 { y += 38 * k; }
  }
  y += 6 * k;
  m = pt_dim(out, m, "MARKINGS", x0, y + 8 * k, cap, k); y += 14 * k;
  pw := (x1 - x0 - 4 * 6 * k) / 5;
  for i: 0..<5 {
    bx := x0 + f32(i) * (pw + 6 * k);
    m = btn(s, out, m, Box.{x0 = bx, y0 = y, x1 = bx + pw, y1 = y + 28 * k}, PATTERN_WORDS[i], B_PATTERN, i, p[0].pattern == i);
  }
  y += 38 * k;
  for which: 0..<2 {
    m = pt_dim(out, m, ifx which == 0 then "COAT" else "MARKINGS' COLOUR", x0, y + 8 * k, cap, k); y += 14 * k;
    sw := (x1 - x0 - 7 * 6 * k) / 8;
    for i: 0..<SWATCHES {
      bx := x0 + f32(i) * (sw + 6 * k);
      b := Box.{x0 = bx, y0 = y, x1 = bx + sw, y1 = y + 22 * k};
      cur := ifx which == 0 then p[0].coat[..] else p[0].marks[..];
      on := abs(cur[0] - SWATCH[i * 3]) + abs(cur[1] - SWATCH[i * 3 + 1]) + abs(cur[2] - SWATCH[i * 3 + 2]) < 0.02;
      cy := (b.y0 + b.y1) / 2;
      if lit(out, m, b.x0 + 5 * k, cy, b.x1 - 5 * k, cy, 6 * k, 0.95, 1 * k, SWATCH[i * 3], SWATCH[i * 3 + 1], SWATCH[i * 3 + 2], 0) { m += 6; }
      m = outline(out, m, b, k, ifx on then 0.95f32 else 0.3f32);
      pet_button(p, b, ifx which == 0 then B_COAT else B_MARKS, i);
    }
    y += 32 * k;
  }
  m = pt_dim(out, m, "EMOTES: SEE THEM DO IT", x0, y + 8 * k, cap, k); y += 14 * k;
  ew := (x1 - x0 - 2 * 6 * k) / 3;
  for i: 0..<EMOTES {
    bx := x0 + f32(i % 3) * (ew + 6 * k); by := y + f32(i / 3) * 34 * k;
    m = btn(s, out, m, Box.{x0 = bx, y0 = by, x1 = bx + ew, y1 = by + 28 * k}, EMOTE_LABEL[i], B_EMOTE, i, false);
  }
  y += f32((EMOTES + 2) / 3) * 34 * k;
  for i: 0..<p[0].my_n {
    bx := x0 + f32(i % 3) * (ew + 6 * k); by := y + f32(i / 3) * 34 * k;
    m = btn(s, out, m, Box.{x0 = bx, y0 = by, x1 = bx + ew, y1 = by + 28 * k}, pet_s(p[0].my_label[i * 16..<i * 16 + 16], p[0].my_label_n[i]), B_EMOTE, 100 + i, false);
  }
  y += f32((p[0].my_n + 2) / 3) * 34 * k + 4 * k;
  m = pt_dim(out, m, "A NEW ONE: SOMETHING THEY ALWAYS DID", x0, y + 8 * k, cap, k); y += 14 * k;
  eb := Box.{x0 = x0, y0 = y, x1 = x1 - 86 * k, y1 = y + 32 * k};
  focused := p[0].focus == TYPE_EMOTE;
  m = outline(out, m, eb, k, ifx focused then 0.95f32 else 0.4f32);
  pet_button(p, eb, B_EMOTE_FIELD, 0);
  said := pet_s(p[0].em_said[..], p[0].em_said_n);
  while said.count > 0 && text_width(said, 8 * k) > eb.x1 - eb.x0 - 16 * k { said = said[1..<said.count]; }
  if said.count == 0 && !focused { m = pt_dim(out, m, "SHE ALWAYS SPUN TWICE BEFORE LYING DOWN", eb.x0 + 8 * k, (eb.y0 + eb.y1 + 8 * k) / 2, 7 * k, k); }
  else { m = pt(out, m, said, eb.x0 + 8 * k, (eb.y0 + eb.y1 + 8 * k) / 2, 8 * k, k, 0.95); }
  if focused { p[0].field_box = eb; }
  busy := p[0].em == EM_MAKING || p[0].em == EM_CHECK;
  m = btn(s, out, m, Box.{x0 = x1 - 80 * k, y0 = eb.y0, x1 = x1, y1 = eb.y1}, ifx busy then "MAKING..." else "MAKE IT", B_MAKE_EMOTE, 0, false);
  return m;
}

pet_draw_memorial :: (s: [] Villa, out: [] f32, n: int, x0: f32, x1: f32, top: f32, bottom: f32) -> int {
  k := hi(s[0].dpr, 0.5); p := s[0].pet[..]; m := n;
  y := top; yb: [1] f32;
  if !p[0].m_ok {
    m = pt_dim(out, m, ifx p[0].m_status == 0 then "OPENING THE MEMORIAL..." else "THIS MEMORIAL ISN'T HERE ANY MORE", x0, y + 10 * k, 8 * k, k);
    return m;
  }
  big := 16 * k;
  m = pt(out, m, pet_s(p[0].m_name[..], p[0].m_name_n), x0, y + big, big, k, 1);
  if !p[0].m_mine { m = btn(s, out, m, Box.{x0 = x1 - 64 * k, y0 = y, x1 = x1, y1 = y + 20 * k}, "REPORT", B_REPORT, REPORT_MEMORIAL * 1000000, false); }
  y += big + 14 * k;
  if p[0].m_dates_n > 0 { m = pt_dim(out, m, pet_s(p[0].m_dates[..], p[0].m_dates_n), x0, y + 8 * k, 8 * k, k); y += 20 * k; }
  if p[0].m_line_n > 0 { m = wrapped(out, m, pet_s(p[0].m_line[..], p[0].m_line_n), x0, y + 9 * k, x1 - x0, 9 * k, k, 2, 0.95, yb[..]); y = yb[0]; }
  y += 6 * k;
  // the photos and videos their owner put here, drawn by the host (coaxial_media); one open large
  if p[0].m_media_n > 0 && p[0].m_big >= 0 && p[0].m_big < p[0].m_media_n {
    large := Box.{x0 = x0, y0 = y, x1 = x1, y1 = y + lo(260 * k, (bottom - y) * 0.6)};
    m = outline(out, m, large, k, 0.35);
    pet_button(p, large, B_MEDIA, p[0].m_big);
    pet_media(p, p[0].m_big, Box.{x0 = large.x0 + 2 * k, y0 = large.y0 + 2 * k, x1 = large.x1 - 2 * k, y1 = large.y1 - 2 * k});
    y = large.y1 + 6 * k;
    if !p[0].m_mine { m = btn(s, out, m, Box.{x0 = x1 - 64 * k, y0 = y, x1 = x1, y1 = y + 18 * k}, "REPORT", B_REPORT_MEDIA, p[0].m_big, false); }
    m = pt_dim(out, m, ifx p[0].m_video[p[0].m_big] then "A VIDEO THEY SHARED, WITHOUT SOUND. TAP TO CLOSE" else "A PHOTO THEY SHARED. TAP TO CLOSE", x0, y + 12 * k, 6.5 * k, k);
    y += 26 * k;
  } else if p[0].m_media_n > 0 {
    per := 3; gap := 6 * k;
    tw := (x1 - x0 - gap * f32(per - 1)) / f32(per); th := tw * 0.72;
    for q: 0..<p[0].m_media_n {
      row := q / per; col := q % per;
      tb := Box.{x0 = x0 + f32(col) * (tw + gap), y0 = y + f32(row) * (th + gap), x1 = x0 + f32(col) * (tw + gap) + tw, y1 = y + f32(row) * (th + gap) + th};
      m = outline(out, m, tb, k, 0.3);
      pet_button(p, tb, B_MEDIA, q);
      pet_media(p, q, Box.{x0 = tb.x0 + 2 * k, y0 = tb.y0 + 2 * k, x1 = tb.x1 - 2 * k, y1 = tb.y1 - 2 * k});
    }
    rows := (p[0].m_media_n + per - 1) / per;
    y += f32(rows) * (th + gap) + 4 * k;
  }
  parts := [3] string.["THEIR STORY", "WHAT MADE THEM THEM", "WHAT THEY DID"];
  for q: 0..<3 {
    t := ifx q == 0 then pet_s(p[0].m_story[..], p[0].m_story_n) else ifx q == 1 then pet_s(p[0].m_traits[..], p[0].m_traits_n) else pet_s(p[0].m_ach[..], p[0].m_ach_n);
    if t.count == 0 { continue; }
    m = pt_dim(out, m, parts[q], x0, y + 7 * k, 7 * k, k); y += 14 * k;
    m = wrapped(out, m, t, x0, y + 8 * k, x1 - x0, 8 * k, k, ifx q == 0 then 6 else 3, 0.9, yb[..]); y = yb[0];
  }
  y += 4 * k;
  m = pt_dim(out, m, "FROM THOSE WHO KNEW THEM", x0, y + 7 * k, 7 * k, k); y += 14 * k;
  for i: 0..<p[0].notes {
    if y > bottom - 120 * k { break; }
    who := pet_s(p[0].n_name[i * 40..<i * 40 + 40], p[0].n_name_n[i]);
    m = pt_dim(out, m, who, x0, y + 7 * k, 7 * k, k);
    if p[0].m_mine { m = btn(s, out, m, Box.{x0 = x1 - 54 * k, y0 = y - 4 * k, x1 = x1, y1 = y + 14 * k}, "HIDE", B_HIDE, p[0].n_num[i], false); }
    else { m = btn(s, out, m, Box.{x0 = x1 - 64 * k, y0 = y - 4 * k, x1 = x1, y1 = y + 14 * k}, "REPORT", B_REPORT, REPORT_NOTE * 1000000 + p[0].n_num[i] % 1000000, false); }
    y += 13 * k;
    m = wrapped(out, m, pet_s(p[0].n_text[i * NOTE_BYTES..<(i + 1) * NOTE_BYTES], p[0].n_text_n[i]), x0, y + 8 * k, x1 - x0, 8 * k, k, 3, 0.88, yb[..]);
    y = yb[0];
  }
  // leave a note
  nb := Box.{x0 = x0, y0 = bottom - 92 * k, x1 = x1 - 76 * k, y1 = bottom - 54 * k};
  focused := p[0].focus == TYPE_NOTE;
  m = outline(out, m, nb, k, ifx focused then 0.95f32 else 0.4f32);
  pet_button(p, nb, B_NOTE, 0);
  typed := pet_s(p[0].typed[..], p[0].typed_n);
  show := typed;
  while show.count > 0 && text_width(show, 8 * k) > nb.x1 - nb.x0 - 16 * k { show = show[1..<show.count]; }
  if typed.count == 0 && !focused { m = pt_dim(out, m, "LEAVE A NOTE FOR THEM", nb.x0 + 8 * k, (nb.y0 + nb.y1 + 8 * k) / 2, 8 * k, k); }
  else { m = pt(out, m, show, nb.x0 + 8 * k, (nb.y0 + nb.y1 + 8 * k) / 2, 8 * k, k, 0.95); }
  if focused { p[0].field_box = nb; }
  m = btn(s, out, m, Box.{x0 = x1 - 68 * k, y0 = nb.y0, x1 = x1, y1 = nb.y1}, "SEND", B_SEND, 0, false);
  m = btn(s, out, m, Box.{x0 = x0, y0 = bottom - 42 * k, x1 = x1, y1 = bottom - 8 * k}, "SHARE THIS MEMORIAL: COPY ITS LINK", B_SHARE, 0, true);
  return m;
}

// A memorial's photo or video q for the host to draw into b this frame.
pet_media :: (p: [] PetUi, q: int, b: Box) {
  if q < 0 || q >= p[0].m_media_n || b.x1 - b.x0 < 4 || b.y1 - b.y0 < 4 { return; }
  t := p[0].media_text[..]; n := p[0].media_n;
  n = pet_put(t, n, ifx p[0].m_video[q] then "video /api/villa/memorial/" else "image /api/villa/memorial/");
  n = pet_put(t, n, pet_s(p[0].m_slug[..], 8)); n = pet_put(t, n, "/media/");
  n = pet_put(t, n, pet_s(p[0].m_media[q * MEDIA_ID..<(q + 1) * MEDIA_ID], MEDIA_ID));
  xs := [4] f32.[b.x0, b.y0, b.x1, b.y1];
  for c: 0..<4 { n = pet_put(t, n, " "); n = pj_put_int(t, n, cast(int) xs[c]); }
  n = pet_put(t, n, "\n");
  if n > 0 { p[0].media_n = n; }
}
// A count and a word into out: its length.
pet_count :: (out: [] u8, v: int, word: string) -> int { n := pj_put_int(out, 0, v); n = pet_put(out, n, word); return ifx n < 0 then 0 else n; }

// Where the toast's plate starts: under the first visit's tip when one shows (villatips.coax), never over it.
pet_toast_top :: (s: [] Villa) -> f32 {
  k := hi(s[0].dpr, 0.5);
  ty := 16 * k + 52 * k;
  tip := s[0].tips[0].bottom;
  if tip > 0 && ty < tip + 8 * k { ty = tip + 8 * k; }
  return ty;
}

// The panel, or its button and the tombstone you stand at; and the toast.
pet_draw :: (s: [] Villa, out: [] f32, u: [] f32, n: int) -> int {
  p := s[0].pet[..];
  p[0].media_n = 0;   // named again below while a memorial shows them
  p[0].field_box = no_box();   // its buttons were reset by play_hud, drawn first
  k := hi(s[0].dpr, 0.5); w := s[0].width; h := s[0].height; g := 16 * k;
  m := n;
  if p[0].view == PV_NONE {
    word := ifx p[0].has then "YOUR PET" else "BRING YOUR PET";
    cap := 9 * k;
    bw := text_width(word, cap) + 36 * k;
    top := ifx phone(s) then g + 11 * k + 24 * k + 8 * k else g;   // a phone's is under the place's name
    b := Box.{x0 = w - g - bw, y0 = top, x1 = w - g, y1 = top + 38 * k};
    if !(phone(s) && s[0].chat[0].typing) {
      plate(s, u, b, 0.78, 0);
      m = btn(s, out, m, b, word, B_OPEN, 0, false);
    }
    if p[0].near >= 0 && p[0].near < p[0].garden {
      i := p[0].near;
      cw := lo(420 * k, w - 2 * g);
      cb := Box.{x0 = (w - cw) / 2, y0 = h - g - 150 * k, x1 = (w + cw) / 2, y1 = h - g - 46 * k};
      plate(s, u, cb, 0.82, 0);
      m = pt(out, m, pet_s(p[0].g_name[i * 40..<i * 40 + 40], p[0].g_name_n[i]), cb.x0 + 14 * k, cb.y0 + 24 * k, 12 * k, k, 1);
      yb: [1] f32;
      m = wrapped(out, m, pet_s(p[0].g_line[i * 120..<i * 120 + 120], p[0].g_line_n[i]), cb.x0 + 14 * k, cb.y0 + 46 * k, cb.x1 - cb.x0 - 28 * k, 8 * k, k, 1, 0.85, yb[..]);
      m = btn(s, out, m, Box.{x0 = cb.x0 + 14 * k, y0 = cb.y1 - 40 * k, x1 = cb.x1 - 14 * k, y1 = cb.y1 - 10 * k}, "OPEN THEIR MEMORIAL", B_MEMORIAL, i, true);
    }
  } else {
    b := pet_panel_box(s);
    plate(s, u, b, 0.9, 0);
    pet_button(p, b, 0, 0);   // the panel itself: presses on it stay on it
    pad := 16 * k;
    x0 := b.x0 + pad; x1 := b.x1 - pad;
    m = btn(s, out, m, Box.{x0 = x1 - 70 * k, y0 = b.y0 + 12 * k, x1 = x1, y1 = b.y0 + 40 * k}, "CLOSE", B_CLOSE, 0, false);
    if p[0].view == PV_PET {
      m = pt(out, m, ifx p[0].has then "YOUR PET" else "BRING YOUR PET", x0, b.y0 + 32 * k, 11 * k, k, 1);
      tw := (x1 - x0 - 8 * k) / 2;
      ty := b.y0 + 52 * k;
      m = btn(s, out, m, Box.{x0 = x0, y0 = ty, x1 = x0 + tw, y1 = ty + 30 * k}, "ABOUT THEM", B_TAB, 0, p[0].tab == 0);
      m = btn(s, out, m, Box.{x0 = x1 - tw, y0 = ty, x1 = x1, y1 = ty + 30 * k}, "THEIR LOOK", B_TAB, 1, p[0].tab == 1);
      if p[0].tab == 0 { m = pet_draw_about(s, out, m, x0, x1, ty + 44 * k); }
      else { m = pet_draw_look(s, out, m, x0, x1, ty + 44 * k); }
    } else if p[0].view == PV_VASE {
      m = pet_draw_vase(s, out, m, x0, x1, b.y0 + 52 * k);
    } else {
      m = pet_draw_memorial(s, out, m, x0, x1, b.y0 + 52 * k, b.y1 - pad);
    }
  }
  if p[0].toast_t > 0 && p[0].toast_n > 0 {
    t := pet_s(p[0].toast[..], p[0].toast_n);
    cap := 8 * k;
    tw := text_width(t, cap);
    ty := pet_toast_top(s);
    tb := Box.{x0 = (w - tw) / 2 - 14 * k, y0 = ty, x1 = (w + tw) / 2 + 14 * k, y1 = ty + cap + 22 * k};
    plate(s, u, tb, 0.85 * clamp(p[0].toast_t, 0, 1), 0);
    m = pt(out, m, t, tb.x0 + 14 * k, tb.y0 + 11 * k + cap, cap, k, clamp(p[0].toast_t, 0, 1));
  }
  return m;
}

// ---- checks

#test "a pet's answer is read: its fields, look, the agent's choices; an edit is written back" {
  p: [1] PetUi;
  pet_start(p[..]);
  t := "{\"id\": \"q-0123456789abcdef\", \"slug\": \"ab12cd34\", \"name\": \"Hecate\", \"born\": \"2012\", \"died\": \"\", \"line\": \"Queen \\\"of\\\" the garden\", \"story\": \"She dug.\", \"traits\": \"\", \"status\": \"placed\", \"plot\": 12, \"agent\": \"ready\", \"agent_note\": \"\", \"avatar\": {\"size\": 0.5, \"body\": 1.5, \"ears\": 1, \"pattern\": \"socks\", \"coat\": [0.3, 0.15, 0.05], \"marks\": [0.9, 0.9, 0.9]}, \"choices\": [{\"part\": \"body\", \"why\": \"Her long back.\"}], \"files\": []}";
  pet_take(p[..], t, true);
  #assert p[0].has && p[0].placed && p[0].plot == 12 && p[0].agent == AGENT_READY;
  #assert pet_field(p[..], PF_NAME) == "Hecate" && pet_field(p[..], PF_LINE) == "Queen \"of\" the garden";
  #assert abs(p[0].avatar[0] - 0.5) < 0.001 && abs(p[0].avatar[2] - 1.5) < 0.001 && p[0].pattern == 4 && abs(p[0].coat[0] - 0.3) < 0.001;
  #assert p[0].choices == 1 && pet_s(p[0].choice[0..<220], p[0].choice_n[0]) == "body: Her long back.";
  out: [9000] u8;
  n := pet_body(p[..], ASK_SAVE, out[..]);
  body := cast(string) out[0..<n];
  #assert n > 0 && pj_get(body, 0, "line") > 0;
  back: [200] u8;
  #assert pet_s(back[..], pj_str(body, pj_get(body, 0, "line"), back[..])) == "Queen \"of\" the garden";
  av := pj_get(body, 0, "avatar");
  #assert abs(pj_num(body, pj_get(body, av, "body")) - 1.5) < 0.001;
  #assert pet_url(p[..], ASK_PLACE, out[..]) == 40;
}

#test "typing names a new pet, which is made first, then saved" {
  p: [1] PetUi;
  pet_start(p[..]);
  pet_answer(p[..], ASK_MINE, 200, "{\"pets\": []}");
  #assert !p[0].has && pet_next(p[..]) == ASK_GARDEN;
  p[0].view = PV_PET; p[0].focus = PF_NAME;
  pet_typed(p[..], "Hec");
  #assert pet_key(p[..], -3) && pet_field(p[..], PF_NAME) == "He";
  #assert pet_key(p[..], 'w');     // a letter while typing walks nobody
  pet_answer(p[..], ASK_GARDEN, 200, "{\"pets\": [{\"slug\": \"zz12zz34\", \"name\": \"Old Bo\", \"line\": \"Good boy\", \"plot\": 9, \"mine\": false}]}");
  #assert p[0].garden == 1 && p[0].g_plot[0] == 9;
  #assert pet_next(p[..]) == ASK_NEW;
  out: [400] u8;
  #assert cast(string) out[0..<pet_body(p[..], ASK_NEW, out[..])] == "{\"name\":\"He\"}";
  pet_answer(p[..], ASK_NEW, 200, "{\"id\": \"q-0000000000000001\", \"slug\": \"aaaabbbb\", \"name\": \"He\", \"status\": \"draft\", \"agent\": \"none\"}");
  #assert p[0].has && p[0].asks & ASK_SAVE != 0;
}

#test "a memorial is read with its notes; a note is sent; the link is copied" {
  p: [1] PetUi;
  pet_start(p[..]);
  pet_open_memorial(p[..], "ab12cd34");
  #assert p[0].view == PV_MEMORIAL && pet_next(p[..]) == ASK_MINE;
  pet_answer(p[..], ASK_GARDEN, 200, "{\"pets\": []}");
  pet_answer(p[..], ASK_MINE, 200, "{\"pets\": []}");
  #assert pet_next(p[..]) == ASK_MEMORIAL;
  out: [400] u8;
  #assert cast(string) out[0..<pet_url(p[..], ASK_MEMORIAL, out[..])] == "/api/villa/memorial/ab12cd34";
  pet_answer(p[..], ASK_MEMORIAL, 200, "{\"name\": \"Hecate\", \"born\": \"2012\", \"died\": \"2025\", \"line\": \"Queen\", \"story\": \"She dug.\", \"mine\": true, \"notes\": [{\"n\": 4, \"name\": \"Guest ABCD\", \"text\": \"Best girl\", \"hidden\": false}]}");
  #assert p[0].m_ok && p[0].m_mine && pet_s(p[0].m_dates[..], p[0].m_dates_n) == "2012 - 2025" && p[0].notes == 1 && p[0].n_num[0] == 4;
  p[0].focus = TYPE_NOTE;
  pet_typed(p[..], "Miss you");
  #assert pet_key(p[..], -2) && p[0].asks & ASK_NOTE != 0;
  #assert cast(string) out[0..<pet_body(p[..], ASK_NOTE, out[..])] == "{\"text\":\"Miss you\"}";
}

#test "kept files go on the memorial by their owner's choice; a memorial names its photos and videos for the host" {
  p: [1] PetUi;
  pet_start(p[..]);
  t := "{\"id\": \"q-0123456789abcdef\", \"slug\": \"ab12cd34\", \"name\": \"Hecate\", \"status\": \"placed\", \"plot\": 3, \"agent\": \"none\", \"files\": [{\"id\": \"g-00000000000000aa\", \"name\": \"park.jpg\", \"kind\": \"image\", \"status\": \"kept\", \"shown\": false, \"held\": false}, {\"id\": \"g-00000000000000bb\", \"name\": \"x.exe\", \"kind\": \"image\", \"status\": \"refused\"}, {\"id\": \"g-00000000000000cc\", \"name\": \"spin.mp4\", \"kind\": \"video\", \"status\": \"kept\", \"shown\": true, \"held\": true}]}";
  pet_take(p[..], t, true);
  #assert p[0].fl_n == 2 && !p[0].fl_shown[0] && p[0].fl_video[1] && p[0].fl_shown[1] && p[0].fl_held[1];
  p[0].button_kind[0] = B_SHOW_FILE; p[0].button_arg[0] = 0; p[0].button[0] = Box.{x0 = 0, y0 = 0, x1 = 10, y1 = 10}; p[0].buttons = 1;
  #assert pet_pointer(p[..], 5, 5, 0) && p[0].file_on;
  #assert p[0].has;
  #assert p[0].asks & ASK_SHOW != 0;
  out: [400] u8;
  #assert cast(string) out[0..<pet_url(p[..], ASK_SHOW, out[..])] == "/api/villa/pets/q-0123456789abcdef/files/g-00000000000000aa/show" && pet_post(ASK_SHOW);
  p[0].button_kind[0] = B_DELETE_FILE;
  #assert pet_pointer(p[..], 5, 5, 0) && p[0].file_sure == 0 && p[0].asks & ASK_FILE_DELETE == 0;   // once: are you sure?
  #assert pet_pointer(p[..], 5, 5, 0) && p[0].asks & ASK_FILE_DELETE != 0;
  #assert cast(string) out[0..<pet_url(p[..], ASK_FILE_DELETE, out[..])] == "/api/villa/pets/q-0123456789abcdef/files/g-00000000000000aa/delete";
  pet_open_memorial(p[..], "ab12cd34");
  pet_answer(p[..], ASK_MEMORIAL, 200, "{\"name\": \"Hecate\", \"mine\": false, \"media\": [{\"id\": \"00000000000000aa\", \"kind\": \"image\"}, {\"id\": \"../../etc\", \"kind\": \"image\"}, {\"id\": \"00000000000000cc\", \"kind\": \"video\"}], \"notes\": []}");
  #assert p[0].m_media_n == 2 && p[0].m_video[1] && p[0].m_big == -1;   // an id that isn't a file's is dropped
  pet_media(p[..], 1, Box.{x0 = 10, y0 = 20, x1 = 110.6, y1 = 90});
  #assert cast(string) p[0].media_text[0..<p[0].media_n] == "video /api/villa/memorial/ab12cd34/media/00000000000000cc 10 20 110 90\n";
  p[0].report_media = 1; p[0].report_kind = REPORT_FILE;
  #assert cast(string) out[0..<pet_body(p[..], ASK_REPORT, out[..])] == "{\"kind\":\"file\",\"ref\":\"00000000000000cc\"}";
}

// The vase being arranged: seven places in a fan over its mouth, the flowers
// picked below; a flower chosen, then a place; a place pressed again gives it back.
pet_draw_vase :: (s: [] Villa, out: [] f32, n: int, x0: f32, x1: f32, top: f32) -> int {
  k := hi(s[0].dpr, 0.5); p := s[0].pet[..]; m := n;
  m = pt(out, m, "ARRANGE YOUR VASE", x0, top - 20 * k, 11 * k, k, 1);
  cx := (x0 + x1) / 2; base := top + 250 * k;
  // the vase: a rounded body drawn in light
  vw := 54 * k; vh := 90 * k;
  pts := [12] f32.[-0.45, 0, -0.62, -0.35, -0.5, -0.75, -0.3, -1, 0.3, -1, 0.5, -0.75];
  for i: 0..<5 {
    for side: 0..<2 {
      sg := ifx side == 0 then 1.0f32 else -1.0f32;
      ax := cx + sg * pts[i * 2] * vw; ay := base + pts[i * 2 + 1] * vh;
      bx := cx + sg * pts[i * 2 + 2] * vw; by := base + pts[i * 2 + 3] * vh;
      if i < 5 && lit(out, m, ax, ay, bx, by, 0.9 * k, 0.8, 2 * k, SILVER_R, SILVER_G, SILVER_B, 0) { m += 6; }
    }
  }
  if lit(out, m, cx - 0.45 * vw, base, cx + 0.45 * vw, base, 0.9 * k, 0.8, 2 * k, SILVER_R, SILVER_G, SILVER_B, 0) { m += 6; }
  mouth := base - vh;
  for q: 0..<VASE_SLOTS {
    a := f32(PI) * (0.15 + 0.7 * f32(q) / f32(VASE_SLOTS - 1));
    fx := cx - cos(a) * 110 * k; fy := mouth - sin(a) * 120 * k;
    kind := p[0].vase[q];
    if kind >= 0 {
      if lit(out, m, cx + (fx - cx) * 0.15, mouth + 6 * k, fx, fy, 0.7 * k, 0.6, 1 * k, 0.35, 0.6, 0.4, 0) { m += 6; }
      if lit(out, m, fx - 0.01, fy, fx + 0.01, fy, 9 * k, 1.0, 8 * k, FLOWER_RGB[kind * 3], FLOWER_RGB[kind * 3 + 1], FLOWER_RGB[kind * 3 + 2], 0) { m += 6; }
    } else {
      m = outline(out, m, Box.{x0 = fx - 9 * k, y0 = fy - 9 * k, x1 = fx + 9 * k, y1 = fy + 9 * k}, k, 0.3);
    }
    pet_button(p, Box.{x0 = fx - 18 * k, y0 = fy - 18 * k, x1 = fx + 18 * k, y1 = fy + 18 * k}, B_SLOT, q);
  }
  y := base + 24 * k;
  m = pt_dim(out, m, "YOUR FLOWERS: CHOOSE ONE, THEN A PLACE IN THE VASE", x0, y, 7 * k, k); y += 10 * k;
  fw := (x1 - x0 - 2 * 6 * k) / 3;
  for q: 0..<FLOWER_KINDS {
    bx := x0 + f32(q) * (fw + 6 * k);
    b := Box.{x0 = bx, y0 = y, x1 = bx + fw, y1 = y + 52 * k};
    m = outline(out, m, b, k, ifx p[0].holding == q then 0.95f32 else 0.4f32);
    if lit(out, m, bx + 18 * k - 0.01, y + 18 * k, bx + 18 * k + 0.01, y + 18 * k, 7 * k, 1.0, 6 * k, FLOWER_RGB[q * 3], FLOWER_RGB[q * 3 + 1], FLOWER_RGB[q * 3 + 2], 0) { m += 6; }
    m = pt(out, m, FLOWER_NAME[q], bx + 32 * k, y + 22 * k, 7 * k, k, 0.9);
    count: [8] u8;
    cn := pj_put_int(count[..], 0, p[0].bag[q]);
    m = pt_dim(out, m, pet_s(count[..], lo_int(hi_int(cn, 0), 8)), bx + 32 * k, y + 40 * k, 7 * k, k);
    pet_button(p, b, B_KIND, q);
  }
  y += 66 * k;
  word := ifx p[0].put_plot >= 0 then "LEAVE IT BY THEIR STONE" else "LEAVE IT HERE";
  m = btn(s, out, m, Box.{x0 = x0, y0 = y, x1 = x1, y1 = y + 34 * k}, word, B_PLACE_VASE, 0, true);
  return m;
}
hi_int :: (a: int, b: int) -> int { return ifx a > b then a else b; }
