// WorldBuilder's ground (openagents.com/create-world, #13225): one Aethyr terrain tile
// (metaverse-engine/world/terrain-tile.coax), 256 cells of a metre round the Grid's middle, edited with the engine's
// brushes (metaverse-engine/world/terrain-edit.coax) and undone through Aethyrforge's scene log (metaverse-engine/editor/edit.coax
// land steps). The bare Grid is its first material; grass, dirt, sand, stone, snow and water are
// painted over it. The tile's outer ring of samples stays at height 0, where the Grid's endless floor
// (the page's background) carries on.
//
// The limits, shown on the page: a world's ground is WB_LAND_METRES a side, a height reaches
// WB_LAND_HIGH metres either way, and the ground's undo keeps WB_LAND_UNDO bytes of changed samples
// (the oldest steps go first).
//   coax/bin/coax test apps/openagents-web/worldbuilder-plan.coax

#load "../../metaverse-engine/world/terrain-edit.coax";
#load "../../coax/lib/quantity.coax" as wb_units;

WB_LAND_CELLS :: 256;
WB_LAND_SIDE :: 257;
WB_LAND_SAMPLES :: 66049;
WB_LAND_METRES :: 256;
WB_LAND_HALF :: 128.0;
WB_LAND_HIGH :: 40.0;
WB_LAND_UNDO :: 3145728;

WB_LAYERS :: 7;
L_GRID :: 0; L_GRASS :: 1; L_DIRT :: 2; L_SAND :: 3; L_STONE :: 4; L_SNOW :: 5; L_WATER :: 6;
WB_LAYER_NAMES :: [WB_LAYERS] string.["grid", "grass", "dirt", "sand", "stone", "snow", "water"];
// The tools a brush or an edit uses on the ground.
LT_PAINT :: 0; LT_RAISE :: 1; LT_LOWER :: 2; LT_SMOOTH :: 3; LT_FLATTEN :: 4;

WbLand :: struct {
  on: bool;                                  // the samples are laid (the bare Grid, level)
  heights: [WB_LAND_SAMPLES] f32;
  ids: [WB_LAND_SAMPLES * 4] u8; weights: [WB_LAND_SAMPLES * 4] u8;
  // the ground as it stood before the edit or stroke under way, for its undo step
  was_h: [WB_LAND_SAMPLES] f32; was_ids: [WB_LAND_SAMPLES * 4] u8; was_w: [WB_LAND_SAMPLES * 4] u8;
  undo: [WB_LAND_UNDO] u8;
  stroke: bool; reach: TerrainEditRect;      // a brush stroke under way and the samples it has touched
  level: f32;                                // a flatten stroke's level: the height where it began
  version: int;                              // changes whenever a sample does (the page sends them to the GPU again)
  bare: bool = true;                         // level and all Grid: nothing to keep or draw beyond the floor
}

wb_land_edit :: (l: [] WbLand) -> TerrainEdit {
  return TerrainEdit.{side = WB_LAND_SIDE, spacing = 1, west = -WB_LAND_HALF, south = -WB_LAND_HALF,
    heights = l[0].heights[..], ids = l[0].ids[..], weights = l[0].weights[..], limit = WB_LAND_HIGH, pin = true};
}
wb_land_ground :: () -> Ground { return Ground.{n = WB_LAND_CELLS, cell = 1, west = -WB_LAND_HALF, south = -WB_LAND_HALF}; }
// Lays the bare, level Grid (a new world, or before a kept one is read).
wb_land_reset :: (l: [] WbLand) {
  for k: 0..<WB_LAND_SAMPLES { l[0].heights[k] = 0; }
  terrain_edit_fill(wb_land_edit(l), L_GRID);
  l[0].on = true; l[0].stroke = false; l[0].bare = true; l[0].version += 1;
}
wb_land_begin :: (l: [] WbLand) { if !l[0].on { wb_land_reset(l); } }
// The drawn ground's height at (x, z): the tile's triangle there, 0 past its edge.
wb_land_y :: (l: [] WbLand, x: f32, z: f32) -> f32 {
  if !l[0].on || l[0].bare { return 0; }
  if x <= -WB_LAND_HALF || x >= WB_LAND_HALF || z <= -WB_LAND_HALF || z >= WB_LAND_HALF { return 0; }
  q := ground_sample(wb_land_ground(), l[0].heights[..], wb_units.Quantity.{value = x}, wb_units.Quantity.{value = z});
  return ifx q.ok then q.height.value else 0.0f32;
}
wb_land_keep :: (l: [] WbLand) {
  for k: 0..<WB_LAND_SAMPLES { l[0].was_h[k] = l[0].heights[k]; }
  for k: 0..<WB_LAND_SAMPLES * 4 { l[0].was_ids[k] = l[0].ids[k]; l[0].was_w[k] = l[0].weights[k]; }
}
// Whether anything but the level, bare Grid is there.
wb_land_scan :: (l: [] WbLand) {
  bare := true;
  for k: 0..<WB_LAND_SAMPLES {
    if l[0].heights[k] != 0 || l[0].ids[k * 4] != L_GRID || l[0].weights[k * 4] != 255 { bare = false; break; }
  }
  l[0].bare = bare;
}

// One act of a tool over a shape: the samples it reached. `amount` is metres for raise and lower,
// the level for flatten; `strength` 0 to 1.
wb_land_tool :: (l: [] WbLand, tool: int, layer: int, s: TerrainEditShape, amount: f32, strength: f32) -> TerrainEditRect {
  wb_land_begin(l);
  t := wb_land_edit(l);
  r: TerrainEditRect;
  if tool == LT_PAINT { r = terrain_edit_paint(t, s, layer, strength); }
  else if tool == LT_RAISE { r = terrain_edit_raise(t, s, amount); }
  else if tool == LT_LOWER { r = terrain_edit_raise(t, s, -amount); }
  else if tool == LT_SMOOTH { r = terrain_edit_grow(t, terrain_edit_smooth(t, s, strength)); }
  else if tool == LT_FLATTEN { r = terrain_edit_flatten(t, s, amount, strength); }
  if r.any { l[0].version += 1; l[0].bare = false; }
  return r;
}

// ---- keeping the ground: lines after the things', each starting "~" (no model's name does)
//   ~H J I0 N DATA   row J's heights from sample I0, N of them: centimetres + 32768 as three characters
//   ~P J DATA        row J's materials as runs: a count (two characters), how many influences
//                    ('1'..'4'), then each influence's layer ('a' + its number) and, past the
//                    first of one, its weight (one character, 0 to 63)
// A character holds six bits: '0' + value. Rows that are level, and rows that are all bare Grid,
// are left out.

wb_c6 :: (v: int) -> u8 { return cast(u8) (48 + (v & 63)); }
wb_d6 :: (c: u8) -> int { return ifx c >= 48 && c < 112 then cast(int) c - 48 else -1; }
wb_put_c :: (b: [] u8, at: int, c: u8) -> int { if at < b.count { b[at] = c; return at + 1; } return at; }
wb_put_dec :: (b: [] u8, at: int, v: int) -> int {
  d: [12] u8; k := 0; q := ifx v < 0 then 0 else v;
  while true { d[k] = cast(u8) (48 + q % 10); k += 1; q /= 10; if q == 0 { break; } }
  n := at;
  while k > 0 { k -= 1; n = wb_put_c(b, n, d[k]); }
  return n;
}
wb_same_sample :: (l: [] WbLand, a: int, b: int) -> bool {
  for q: 0..<4 { if l[0].ids[a * 4 + q] != l[0].ids[b * 4 + q] || l[0].weights[a * 4 + q] != l[0].weights[b * 4 + q] { return false; } }
  return true;
}
// The ground's lines into b from `at`: where they end, or -1 when b can't hold them.
wb_land_save :: (l: [] WbLand, b: [] u8, at: int) -> int {
  n := at;
  if !l[0].on || l[0].bare { return n; }
  for j: 0..<WB_LAND_SIDE {
    row := j * WB_LAND_SIDE;
    i0 := 0; while i0 < WB_LAND_SIDE && l[0].heights[row + i0] == 0 { i0 += 1; }
    if i0 < WB_LAND_SIDE {
      i1 := WB_LAND_SIDE - 1; while l[0].heights[row + i1] == 0 { i1 -= 1; }
      if n + 24 + (i1 - i0 + 1) * 3 > b.count { return -1; }
      n = wb_put_c(b, n, '~'); n = wb_put_c(b, n, 'H'); n = wb_put_c(b, n, ' ');
      n = wb_put_dec(b, n, j); n = wb_put_c(b, n, ' '); n = wb_put_dec(b, n, i0); n = wb_put_c(b, n, ' '); n = wb_put_dec(b, n, i1 - i0 + 1); n = wb_put_c(b, n, ' ');
      for i: i0..<i1 + 1 {
        cm := cast(int) floor(l[0].heights[row + i] * 100 + 0.5) + 32768;
        cm = ifx cm < 0 then 0 else ifx cm > 65535 then 65535 else cm;
        n = wb_put_c(b, n, wb_c6(cm >> 12)); n = wb_put_c(b, n, wb_c6(cm >> 6)); n = wb_put_c(b, n, wb_c6(cm));
      }
      n = wb_put_c(b, n, '\n');
    }
    plain := true;
    for i: 0..<WB_LAND_SIDE { if l[0].ids[(row + i) * 4] != L_GRID || l[0].weights[(row + i) * 4] != 255 { plain = false; break; } }
    if plain { continue; }
    if n + 12 > b.count { return -1; }
    n = wb_put_c(b, n, '~'); n = wb_put_c(b, n, 'P'); n = wb_put_c(b, n, ' '); n = wb_put_dec(b, n, j); n = wb_put_c(b, n, ' ');
    i := 0;
    while i < WB_LAND_SIDE {
      e := i + 1; while e < WB_LAND_SIDE && wb_same_sample(l, row + i, row + e) { e += 1; }
      if n + 16 > b.count { return -1; }
      n = wb_put_c(b, n, wb_c6((e - i) >> 6)); n = wb_put_c(b, n, wb_c6(e - i));
      k := 0; for q: 0..<4 { if l[0].weights[(row + i) * 4 + q] > 0 { k += 1; } }
      n = wb_put_c(b, n, cast(u8) (48 + k));
      for q: 0..<4 {
        w := cast(int) l[0].weights[(row + i) * 4 + q];
        if w == 0 { continue; }
        n = wb_put_c(b, n, cast(u8) (97 + cast(int) l[0].ids[(row + i) * 4 + q]));
        if k > 1 { n = wb_put_c(b, n, wb_c6(ifx (w * 63 + 127) / 255 < 1 then 1 else (w * 63 + 127) / 255)); }
      }
      i = e;
    }
    n = wb_put_c(b, n, '\n');
  }
  return n;
}
wb_dec_at :: (t: string, at: [] int) -> int {
  i := at[0];
  while i < t.count && t[i] == ' ' { i += 1; }
  if i >= t.count || t[i] < '0' || t[i] > '9' { at[0] = -1; return 0; }
  v := 0;
  while i < t.count && t[i] >= '0' && t[i] <= '9' && v < 100000 { v = v * 10 + (cast(int) t[i] - 48); i += 1; }
  at[0] = i;
  return v;
}
// One kept line of ground (without its "~"); a line that isn't whole changes nothing past where it breaks.
wb_land_line :: (l: [] WbLand, line: string) {
  if line.count < 3 || line[1] != ' ' { return; }
  at: [1] int; at[0] = 1;
  j := wb_dec_at(line, at[..]);
  if at[0] < 0 || j >= WB_LAND_SIDE { return; }
  row := j * WB_LAND_SIDE;
  if line[0] == 'H' {
    i0 := wb_dec_at(line, at[..]); if at[0] < 0 { return; }
    n := wb_dec_at(line, at[..]); if at[0] < 0 { return; }
    p := at[0] + 1;
    if i0 + n > WB_LAND_SIDE || p + n * 3 > line.count { return; }
    for i: 0..<n {
      a := wb_d6(line[p + i * 3]); b := wb_d6(line[p + i * 3 + 1]); c := wb_d6(line[p + i * 3 + 2]);
      if a < 0 || b < 0 || c < 0 { return; }
      h := cast(f32) (((a << 12) | (b << 6) | c) - 32768) / 100;
      edge := j == 0 || j == WB_LAND_SIDE - 1 || i0 + i == 0 || i0 + i == WB_LAND_SIDE - 1;
      l[0].heights[row + i0 + i] = ifx edge then 0.0f32 else ifx h > WB_LAND_HIGH then cast(f32) WB_LAND_HIGH else ifx h < -WB_LAND_HIGH then cast(f32) -WB_LAND_HIGH else h;
    }
    return;
  }
  if line[0] != 'P' { return; }
  p := at[0] + 1; i := 0;
  while i < WB_LAND_SIDE && p + 4 <= line.count {
    hi := wb_d6(line[p]); lo := wb_d6(line[p + 1]); k := cast(int) line[p + 2] - 48;
    if hi < 0 || lo < 0 || k < 1 || k > 4 { return; }
    run := (hi << 6) | lo;
    p += 3;
    id: [4] int; w: [4] int; sum := 0;
    for q: 0..<k {
      if p >= line.count { return; }
      id[q] = cast(int) line[p] - 97; p += 1;
      if id[q] < 0 || id[q] >= WB_LAYERS { return; }
      for e: 0..<q { if id[e] == id[q] { return; } }
      w[q] = 63;
      if k > 1 { if p >= line.count { return; } w[q] = wb_d6(line[p]); p += 1; if w[q] < 1 { return; } }
      sum += w[q];
    }
    if run < 1 || i + run > WB_LAND_SIDE { return; }
    // bytes that add to 255, the first influence taking what rounding leaves
    bytes: [4] int; left := 255;
    for q: 1..<k { bytes[q] = w[q] * 255 / sum; if bytes[q] < 1 { bytes[q] = 1; } left -= bytes[q]; }
    bytes[0] = left;
    if left < 1 { return; }
    for e: i..<i + run {
      for q: 0..<4 {
        l[0].ids[(row + e) * 4 + q] = ifx q < k then cast(u8) id[q] else cast(u8) TERRAIN_TILE_NO_MATERIAL;
        l[0].weights[(row + e) * 4 + q] = ifx q < k then cast(u8) bytes[q] else cast(u8) 0;
      }
    }
    i += run;
  }
}
// After a kept ground's lines: what it read is made a tile again (no triangle of more than four materials).
wb_land_loaded :: (l: [] WbLand) {
  wb_land_scan(l);
  if !l[0].bare { terrain_edit_settle(wb_land_edit(l), TerrainEditRect.{any = true, i0 = 0, j0 = 0, i1 = WB_LAND_SIDE - 1, j1 = WB_LAND_SIDE - 1}); }
  l[0].version += 1;
}

// ---- the layers' looks: an Aethyr material table (metaverse-engine/world/terrain-tile.coax, `aethyr.terrain.materials.v1`),
// procedural albedos only. The page hands these numbers to its shader, which evaluates
// metaverse-engine/render/terrain-shade.coax's equations with them.
wb_layer_look :: (id: int, a: [3] f32, b: [3] f32, f1: f32, f2: f32, g1: f32) -> TerrainMaterial {
  m: TerrainMaterial;
  m.id = id; m.albedo_a = a; m.albedo_b = b;
  m.blend_scale = [2] f32.[f1, f2]; m.blend_weight = [2] f32.[0.7, 0.3];
  m.gain = [2] f32.[1 - g1 * 0.5, g1]; m.gain_scale = 0.37;
  return m;
}
wb_land_table :: () -> [WB_LAYERS] TerrainMaterial {
  t: [WB_LAYERS] TerrainMaterial;
  t[L_GRID] = wb_layer_look(L_GRID, [3] f32.[0.10, 0.13, 0.16], [3] f32.[0.10, 0.13, 0.16], 1, 1, 0);
  t[L_GRASS] = wb_layer_look(L_GRASS, [3] f32.[0.26, 0.47, 0.17], [3] f32.[0.42, 0.60, 0.22], 0.19, 1.7, 0.22);
  t[L_DIRT] = wb_layer_look(L_DIRT, [3] f32.[0.40, 0.28, 0.17], [3] f32.[0.55, 0.41, 0.26], 0.23, 2.1, 0.20);
  t[L_SAND] = wb_layer_look(L_SAND, [3] f32.[0.80, 0.69, 0.46], [3] f32.[0.90, 0.81, 0.58], 0.13, 2.6, 0.10);
  t[L_STONE] = wb_layer_look(L_STONE, [3] f32.[0.40, 0.41, 0.43], [3] f32.[0.60, 0.60, 0.58], 0.41, 2.9, 0.28);
  t[L_SNOW] = wb_layer_look(L_SNOW, [3] f32.[0.84, 0.89, 0.96], [3] f32.[0.98, 0.99, 1.00], 0.11, 1.3, 0.06);
  t[L_WATER] = wb_layer_look(L_WATER, [3] f32.[0.07, 0.27, 0.46], [3] f32.[0.13, 0.42, 0.58], 0.09, 0.7, 0.10);
  return t;
}
// The table as the shader reads it: twelve floats a layer from u[at] (gpu/worldbuilder.coax WB_U_LAYERS).
wb_land_looks :: (u: [] f32, at: int) {
  t := wb_land_table();
  for k: 0..<WB_LAYERS {
    m := t[k]; o := at + k * 12;
    if o + 12 > u.count { return; }
    u[o] = m.albedo_a[0]; u[o + 1] = m.albedo_a[1]; u[o + 2] = m.albedo_a[2]; u[o + 3] = m.blend_scale[0];
    u[o + 4] = m.albedo_b[0]; u[o + 5] = m.albedo_b[1]; u[o + 6] = m.albedo_b[2]; u[o + 7] = m.blend_scale[1];
    u[o + 8] = m.blend_weight[0]; u[o + 9] = m.blend_weight[1]; u[o + 10] = m.gain[0]; u[o + 11] = m.gain[1];
  }
}
// The ground as the GPU keeps it, four floats a sample: its height, then its six painted layers'
// shares as bytes, three a float (grass, dirt, sand; stone, snow, water), the bare Grid what is left.
wb_land_gpu :: (l: [] WbLand, out: [] f32) {
  if out.count < WB_LAND_SAMPLES * 4 { return; }
  for k: 0..<WB_LAND_SAMPLES {
    share: [WB_LAYERS] int;
    total := 0;
    for q: 0..<4 { w := cast(int) l[0].weights[k * 4 + q]; total += w; id := cast(int) l[0].ids[k * 4 + q]; if w > 0 && id < WB_LAYERS { share[id] += w; } }
    if total > 0 && total != 255 { for q: 1..<WB_LAYERS { share[q] = share[q] * 255 / total; } }
    out[k * 4] = l[0].heights[k];
    out[k * 4 + 1] = cast(f32) (share[L_GRASS] + share[L_DIRT] * 256 + share[L_SAND] * 65536);
    out[k * 4 + 2] = cast(f32) (share[L_STONE] + share[L_SNOW] * 256 + share[L_WATER] * 65536);
    out[k * 4 + 3] = 0;
  }
}
#test "the layers are a material table Aethyr takes, and the GPU's copy packs a sample's shares" {
  t := wb_land_table();
  #assert terrain_materials_check(t[..]).code == TERRAIN_TILE_OK;
  u: [132] f32;
  wb_land_looks(u[..], 48);
  #assert u[48 + L_SAND * 12] == 0.80 && u[48 + L_WATER * 12 + 6] == 0.58 && u[48 + 8] == 0.7 && u[47] == 0;
}
