// WorldBuilder's planner (openagents.com/create-world, worldbuilder.coax): typed edits in, the
// world out. The model (coax/web/api/worldbuilder.c) reads what someone typed and answers edits as
// lines, one an edit, its fields in a fixed order; this file reads those bounded fields (an op from
// its nine, catalogue names matched whole, numbers) and carries each edit out on the world. Nothing
// here reads the words someone typed.
//
// The world: up to WB_OBJECTS things, each a catalogue mesh standing on the ground (y = 0, the
// meshes are packed with their base at 0 and their footprint centred) at x, z, turned by yaw and
// scaled. Each has an id that never changes. "Last" is what the newest edit placed or changed,
// so "make it bigger" and "delete them" find it. Every edit goes through Aethyrforge's typed scene
// edit log (aethyr/forge/edit.coax) with undo and redo (#13226).
//
// Where things go is worked out from an anchor (the tapped spot, the middle of the view, the last
// edit's things, the newest thing of a name, the grid's middle) and a side as the camera sees it
// (left, right, toward you, away from you, around): a thing placed beside another stands clear of
// it, its footprint and the other's apart plus the distance asked. Several are spread over a disc,
// each kept off the others and off what stands there already, from a seeded draw (aethyr/rand.coax),
// so the same edits on the same world give the same world.
//   coax/bin/coax test apps/openagents-web/worldbuilder-plan.coax

#load "../../aethyr/rand.coax";
#load "../../aethyr/forge/edit.coax";
#load "worldbuilder-land.coax";

WB_OBJECTS :: FORGE_SCENE_ITEMS;   // things a world holds (the page shows the count and this)
WB_MESHES :: 1024;                 // catalogue meshes
WB_NAME :: 48;
WB_PER_EDIT :: 200;                // things one edit places at most
WB_NAMES :: 16;                    // names one edit lists
WB_LAST :: 512;                    // ids "last" remembers
WB_PARTS :: 256;                   // pieces all the buildings hold

OP_NONE :: 0; OP_PLACE :: 1; OP_MOVE :: 2; OP_ROTATE :: 3; OP_SCALE :: 4; OP_DELETE :: 5; OP_DUPLICATE :: 6; OP_UNDO :: 7; OP_CLEAR :: 8; OP_REDO :: 9;
// the ground's edits (worldbuilder-land.coax): OP_PAINT + a tool (LT_*)
OP_PAINT :: 10; OP_RAISE :: 11; OP_LOWER :: 12; OP_SMOOTH :: 13; OP_FLATTEN :: 14;
T_LAST :: 0; T_NAMES :: 1; T_NEAREST :: 2; T_ALL :: 3;
A_HERE :: 0; A_VIEW :: 1; A_LAST :: 2; A_NAMED :: 3; A_ORIGIN :: 4; A_SELF :: 5; A_EDGE :: 6;
S_AT :: 0; S_LEFT :: 1; S_RIGHT :: 2; S_FRONT :: 3; S_BEHIND :: 4; S_AROUND :: 5;

WbCat :: struct {
  n: int;
  name: [WB_MESHES * WB_NAME] u8; name_n: [WB_MESHES] int;
  first: [WB_MESHES] int; count: [WB_MESHES] int;
  box: [WB_MESHES * 6] f32;      // x0 y0 z0 x1 y1 z1, metres
  // the pack's own meshes are the first real_n; after them come the buildings (WB_PREFABS), each a
  // list of the pack's pieces where they stand in it
  real_n: int;
  part_first: [WB_MESHES] int; part_n: [WB_MESHES] int;
  parts: [WB_PARTS] WbPart; parts_n: int;
}
WbPart :: struct { mesh: int; x: f32; y: f32; z: f32; yaw: f32; }
WbAct :: struct {
  op: int; asset: int = -1; count: int = 1;
  targets: int; names: [WB_NAMES] int; names_n: int;
  anchor: int = A_HERE; anchor_names: [WB_NAMES] int; anchor_names_n: int;
  side: int; distance: f32; spread: f32; size: f32 = 1; factor: f32 = 1; degrees: f32;
  layer: int = -1;   // a ground edit's layer (WB_LAYER_NAMES), from the asset's field
  sized: bool;       // `size` was given (a ground edit's height in metres)
}
// Where the person is looking from: the tapped spot (if any), the middle of the view, and the
// camera's yaw (0 looks along -z; left and right, toward and away follow it).
WbView :: struct { has_here: bool; here_x: f32; here_z: f32; view_x: f32; view_z: f32; yaw: f32; }
WbWorld :: struct {
  fg: [1] ForgeSceneState;
  objs: [WB_OBJECTS] ForgeItem; n: int;
  ops: [FORGE_SCENE_OPS] ForgeItemOp;
  steps: [FORGE_SCENE_STEPS] ForgeStep;
  land: [1] WbLand;   // the ground the things stand on (worldbuilder-land.coax)
  land_rev: int;      // the forge log's land revision the ground was last seen at
  last: [WB_LAST] int; last_n: int;
  version: int;     // changes with every edit (the page redraws its instances)
  seed: int;
  full: bool;       // the last edit wanted more room than the world has
  missing: bool;    // the last edit named something the catalogue doesn't have
  unkept: bool;     // the last save had no room for the ground
}

wb_lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
wb_hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
wb_abs :: (a: f32) -> f32 { if a < 0 { return -a; } return a; }

// ---- the catalogue: the pack's M lines (worldbuilder_pack.coax)

wb_mesh_name :: (c: [] WbCat, m: int) -> string { return cast(string) c[0].name[m * WB_NAME..<m * WB_NAME + c[0].name_n[m]]; }
// A mesh by its whole name, -1 when the catalogue has none.
wb_find :: (c: [] WbCat, name: string) -> int {
  if name.count == 0 { return -1; }
  for m: 0..<c[0].n { if wb_mesh_name(c, m) == name { return m; } }
  return -1;
}
// The footprint's radius at scale 1 (half the longer side).
wb_radius :: (c: [] WbCat, m: int) -> f32 {
  if m < 0 || m >= c[0].n { return 0.5; }
  b := c[0].box[m * 6..<m * 6 + 6];
  return 0.5 * wb_hi(b[3] - b[0], b[5] - b[2]);
}
wb_int_at :: (t: string, at: [] int) -> int {
  i := at[0]; neg := false; v := 0; digits := 0;
  while i < t.count && t[i] == ' ' { i += 1; }
  if i < t.count && t[i] == '-' { neg = true; i += 1; }
  while i < t.count && t[i] >= '0' && t[i] <= '9' && digits < 9 { v = v * 10 + cast(int) (t[i] - '0'); i += 1; digits += 1; }
  at[0] = ifx digits > 0 then i else -1;
  return ifx neg then -v else v;
}
// A decimal ("-12.5"), at[0] past it, or -1 when there is none.
wb_num_at :: (t: string, at: [] int) -> f32 {
  i := at[0];
  while i < t.count && t[i] == ' ' { i += 1; }
  neg := i < t.count && t[i] == '-';
  at[0] = i;
  whole := wb_int_at(t, at);
  if at[0] < 0 { return 0; }
  v := cast(f32) (ifx whole < 0 then -whole else whole);
  i = at[0];
  if i < t.count && t[i] == '.' {
    i += 1; step: f32 = 0.1;
    while i < t.count && t[i] >= '0' && t[i] <= '9' { v += step * cast(f32) (t[i] - '0'); step *= 0.1; i += 1; }
    at[0] = i;
  }
  return ifx neg then -v else v;
}
// One "M NAME FIRST COUNT K X0 Y0 Z0 X1 Y1 Z1" line into the catalogue.
wb_cat_line :: (c: [] WbCat, line: string) {
  if line.count < 4 || line[0] != 'M' || line[1] != ' ' { return; }
  e := 2; while e < line.count && line[e] != ' ' { e += 1; }
  m := c[0].n;
  if m >= WB_MESHES || e - 2 > WB_NAME || e == 2 { return; }
  at: [1] int; at[0] = e;
  first := wb_int_at(line, at[..]); if at[0] < 0 { return; }
  count := wb_int_at(line, at[..]); if at[0] < 0 { return; }
  lic := wb_int_at(line, at[..]); if at[0] < 0 || first < 0 || count <= 0 || lic < 0 { return; }
  for j: 0..<6 { v := wb_num_at(line, at[..]); if at[0] < 0 { return; } c[0].box[m * 6 + j] = v; }
  for i: 2..<e { c[0].name[m * WB_NAME + i - 2] = line[i]; }
  c[0].name_n[m] = e - 2; c[0].first[m] = first; c[0].count[m] = count;
  c[0].n = m + 1;
}
wb_catalog :: (c: [] WbCat, text: string) {
  c[0].n = 0; c[0].parts_n = 0;
  i := 0;
  while i < text.count { e := i; while e < text.count && text[e] != '\n' { e += 1; } wb_cat_line(c, text[i..<e]); i = e + 1; }
  c[0].real_n = c[0].n;
  for m: 0..<c[0].n { c[0].part_first[m] = -1; c[0].part_n[m] = 0; }
  wb_prefabs(c, WB_PREFABS);
}

// ---- buildings: the village kit is pieces (walls 2 m wide, 3.12 m high; corners; roofs), so a
// house is pieces put together. A building is "B NAME" and then a piece a line,
// "PIECE X Y Z DEGREES": where its middle stands in the building and its turn (a wall's outer face is
// its -z, so the front wall, at +z, is turned 180).
// The API's catalogue lists the same names (coax/web/api/worldbuilder.c WB_BUILDINGS).
WB_PREFABS :: "B house/cottage\nvillage/wall-plaster-door-round -1 0 2 180\nvillage/wall-plaster-window-wide-round 1 0 2 180\nvillage/wall-plaster-window-thin-round -1 0 -2 0\nvillage/wall-plaster-straight 1 0 -2 0\nvillage/wall-plaster-window-wide-flat 2 0 -1 -90\nvillage/wall-plaster-straight 2 0 1 -90\nvillage/wall-plaster-straight -2 0 -1 90\nvillage/wall-plaster-window-wide-flat -2 0 1 90\nvillage/corner-exterior-wood 2 0 2 0\nvillage/corner-exterior-wood -2 0 2 0\nvillage/corner-exterior-wood 2 0 -2 0\nvillage/corner-exterior-wood -2 0 -2 0\nvillage/roof-front-wood4 0 3.12 2 180\nvillage/roof-front-wood4 0 3.12 -2 0\nvillage/roof-roundtiles-4x4 0 3 0 0\nB house/timber-house\nvillage/wall-woodwear-door-round 1 0 2 180\nvillage/wall-woodwear-window-wide-flat -1 0 2 180\nvillage/wall-woodwear-straight -1 0 -2 0\nvillage/wall-woodwear-window-thin-round 1 0 -2 0\nvillage/wall-woodwear-straight 2 0 -1 -90\nvillage/wall-woodwear-window-wide-round 2 0 1 -90\nvillage/wall-woodwear-window-wide-round -2 0 -1 90\nvillage/wall-woodwear-straight -2 0 1 90\nvillage/corner-exterior-wood 2 0 2 0\nvillage/corner-exterior-wood -2 0 2 0\nvillage/corner-exterior-wood 2 0 -2 0\nvillage/corner-exterior-wood -2 0 -2 0\nvillage/roof-front-wood4 0 3.12 2 180\nvillage/roof-front-wood4 0 3.12 -2 0\nvillage/roof-flattiles-4x4 0 3 0 0\nB house/long-house\nvillage/wall-unevenbrick-door-round -1 0 3 180\nvillage/wall-unevenbrick-window-wide-round 1 0 3 180\nvillage/wall-unevenbrick-straight -1 0 -3 0\nvillage/wall-unevenbrick-window-thin-round 1 0 -3 0\nvillage/wall-unevenbrick-window-wide-flat 2 0 -2 -90\nvillage/wall-unevenbrick-straight 2 0 0 -90\nvillage/wall-unevenbrick-window-wide-flat 2 0 2 -90\nvillage/wall-unevenbrick-window-wide-flat -2 0 -2 90\nvillage/wall-unevenbrick-straight -2 0 0 90\nvillage/wall-unevenbrick-window-wide-flat -2 0 2 90\nvillage/corner-exteriorwide-brick 2 0 3 0\nvillage/corner-exteriorwide-brick -2 0 3 0\nvillage/corner-exteriorwide-brick 2 0 -3 0\nvillage/corner-exteriorwide-brick -2 0 -3 0\nvillage/roof-front-brick4 0 3.12 3 180\nvillage/roof-front-brick4 0 3.12 -3 0\nvillage/roof-roundtiles-4x6 0 3 0 0\n";
// A building a mesh after the pack's: its box the union of its pieces' boxes as they stand. One
// whose pieces the catalogue lacks isn't added.
wb_prefabs :: (c: [] WbCat, text: string) {
  i := 0; m := -1;
  while i < text.count {
    e := i; while e < text.count && text[e] != '\n' { e += 1; }
    line := text[i..<e];
    i = e + 1;
    if line.count > 2 && line[0] == 'B' && line[1] == ' ' {
      m = -1;
      name := line[2..<line.count];
      if c[0].n >= WB_MESHES || name.count > WB_NAME || wb_find(c, name) >= 0 { continue; }
      m = c[0].n;
      for k: 0..<name.count { c[0].name[m * WB_NAME + k] = name[k]; }
      c[0].name_n[m] = name.count; c[0].first[m] = 0; c[0].count[m] = 0;
      c[0].part_first[m] = c[0].parts_n; c[0].part_n[m] = 0;
      for j: 0..<3 { c[0].box[m * 6 + j] = 1000000; c[0].box[m * 6 + 3 + j] = -1000000; }
      c[0].n = m + 1;
      continue;
    }
    if m < 0 || line.count == 0 { continue; }
    sp := 0; while sp < line.count && line[sp] != ' ' { sp += 1; }
    piece := wb_find(c, line[0..<sp]);
    at: [1] int; at[0] = sp;
    x := wb_num_at(line, at[..]); ok := at[0] >= 0;
    y := wb_num_at(line, at[..]); ok = ok && at[0] >= 0;
    z := wb_num_at(line, at[..]); ok = ok && at[0] >= 0;
    deg := wb_num_at(line, at[..]); ok = ok && at[0] >= 0;
    if !ok || piece < 0 || piece >= c[0].real_n || c[0].parts_n >= WB_PARTS {
      // a building with a piece missing is no building: take it back out
      c[0].parts_n = c[0].part_first[m]; c[0].n = m; m = -1;
      continue;
    }
    yaw := deg * 0.017453292;
    c[0].parts[c[0].parts_n] = WbPart.{mesh = piece, x = x, y = y, z = z, yaw = yaw};
    c[0].parts_n += 1; c[0].part_n[m] += 1;
    b := c[0].box[piece * 6..<piece * 6 + 6];
    co := cos(yaw); sn := sin(yaw);
    for q: 0..<4 {
      lx := ifx q % 2 == 0 then b[0] else b[3]; lz := ifx q < 2 then b[2] else b[5];
      wx := x + co * lx + sn * lz; wz := z - sn * lx + co * lz;
      c[0].box[m * 6] = wb_lo(c[0].box[m * 6], wx); c[0].box[m * 6 + 3] = wb_hi(c[0].box[m * 6 + 3], wx);
      c[0].box[m * 6 + 2] = wb_lo(c[0].box[m * 6 + 2], wz); c[0].box[m * 6 + 5] = wb_hi(c[0].box[m * 6 + 5], wz);
    }
    c[0].box[m * 6 + 1] = wb_lo(c[0].box[m * 6 + 1], y + b[1]); c[0].box[m * 6 + 4] = wb_hi(c[0].box[m * 6 + 4], y + b[4]);
  }
}
wb_is_building :: (c: [] WbCat, m: int) -> bool { return m >= c[0].real_n && m < c[0].n; }

// ---- the model's lines: "A op|asset|count|targets|names|anchor|anchor_names|side|distance|spread|size|factor|degrees"

wb_field :: (line: string, k: int) -> string {
  f := 0; i := 0;
  while i <= line.count {
    e := i; while e < line.count && line[e] != '|' { e += 1; }
    if f == k { return line[i..<e]; }
    f += 1; i = e + 1;
  }
  return "";
}
wb_word :: (t: string, words: [] string) -> int { for i: 0..<words.count { if t == words[i] { return i; } } return -1; }
wb_number :: (t: string, fallback: f32) -> f32 { at: [1] int; v := wb_num_at(t, at[..]); return ifx at[0] < 0 then fallback else v; }
// A list of names ("a,b") as catalogue meshes; a name the catalogue lacks is left out and counted.
wb_names :: (c: [] WbCat, t: string, out: [] int, missing: [] int) -> int {
  n := 0; i := 0;
  while i < t.count {
    e := i; while e < t.count && t[e] != ',' { e += 1; }
    s := i; while s < e && t[s] == ' ' { s += 1; }
    q := e; while q > s && t[q - 1] == ' ' { q -= 1; }
    if q > s {
      m := wb_find(c, t[s..<q]);
      if m >= 0 && n < out.count { out[n] = m; n += 1; } else if m < 0 { missing[0] += 1; }
    }
    i = e + 1;
  }
  return n;
}
OPS :: [15] string.["", "place", "move", "rotate", "scale", "delete", "duplicate", "undo", "clear", "redo", "paint", "raise", "lower", "smooth", "flatten"];
TARGETS :: [4] string.["last", "names", "nearest", "all"];
ANCHORS :: [7] string.["here", "view", "last", "named", "origin", "self", "edge"];
SIDES :: [6] string.["at", "left", "right", "front", "behind", "around"];
// One edit from its line (without the "A "): ok false for an op it doesn't know or a place of
// something the catalogue lacks.
WbRead :: struct { ok: bool; act: WbAct; missing: int; }
wb_read :: (c: [] WbCat, line: string) -> WbRead {
  r: WbRead;
  ops := OPS; targets := TARGETS; anchors := ANCHORS; sides := SIDES;
  op := wb_word(wb_field(line, 0), ops[..]);
  if op <= 0 { return r; }
  a: WbAct; a.op = op;
  miss: [1] int;
  a.asset = wb_find(c, wb_field(line, 1));
  if op == OP_PLACE && a.asset < 0 { r.missing = 1; return r; }
  a.count = cast(int) wb_number(wb_field(line, 2), 1);
  if a.count < 1 { a.count = 1; }
  t := wb_word(wb_field(line, 3), targets[..]); a.targets = ifx t < 0 then T_LAST else t;
  a.names_n = wb_names(c, wb_field(line, 4), a.names[..], miss[..]);
  an := wb_word(wb_field(line, 5), anchors[..]); a.anchor = ifx an < 0 then (ifx op == OP_MOVE || op == OP_DUPLICATE then A_SELF else A_HERE) else an;
  a.anchor_names_n = wb_names(c, wb_field(line, 6), a.anchor_names[..], miss[..]);
  sd := wb_word(wb_field(line, 7), sides[..]); a.side = ifx sd < 0 then S_AT else sd;
  a.distance = wb_number(wb_field(line, 8), 0);
  a.spread = wb_number(wb_field(line, 9), 0);
  a.size = wb_number(wb_field(line, 10), 1);
  a.sized = wb_field(line, 10).count > 0;
  layers := WB_LAYER_NAMES;
  a.layer = wb_word(wb_field(line, 1), layers[..]);
  if op == OP_PAINT && a.layer < 0 { r.missing = 1; return r; }
  a.factor = wb_number(wb_field(line, 11), 1);
  a.degrees = wb_number(wb_field(line, 12), 0);
  r.ok = true; r.act = a; r.missing = miss[0];
  return r;
}

// ---- the world, backed by Aethyrforge's scene edit log (aethyr/forge/edit.coax)

wb_scene :: (w: [] WbWorld) -> ForgeScene {
  return ForgeScene.{st = w[0].fg[..], items = w[0].objs[..], ops = w[0].ops[..], steps = w[0].steps[..],
    land_side = WB_LAND_SIDE, heights = w[0].land[0].heights[..], land_ids = w[0].land[0].ids[..], land_weights = w[0].land[0].weights[..], land = w[0].land[0].undo[..]};
}
// After the log moved: the count of things, and the ground when a land step changed it.
wb_sync :: (w: [] WbWorld) {
  w[0].n = w[0].fg[0].n;
  if w[0].fg[0].land_rev != w[0].land_rev { w[0].land_rev = w[0].fg[0].land_rev; w[0].land[0].version += 1; wb_land_scan(w[0].land[..]); }
}
wb_reset :: (w: [] WbWorld) { forge_scene_reset(wb_scene(w)); wb_land_reset(w[0].land[..]); wb_sync(w); w[0].last_n = 0; w[0].version += 1; }
wb_index :: (w: [] WbWorld, id: int) -> int { return forge_scene_find(wb_scene(w), id); }
wb_can_undo :: (w: [] WbWorld) -> bool { return forge_scene_can_undo(wb_scene(w)); }
wb_can_redo :: (w: [] WbWorld) -> bool { return forge_scene_can_redo(wb_scene(w)); }
wb_last_add :: (w: [] WbWorld, id: int) { if w[0].last_n < WB_LAST { w[0].last[w[0].last_n] = id; w[0].last_n += 1; } }
wb_last_from_top :: (w: [] WbWorld) {
  w[0].last_n = 0;
  done := w[0].fg[0].done;
  if done <= 0 { return; }
  st := w[0].steps[done - 1];
  if st.kind == FORGE_SCENE_LAND { return; }
  s := wb_scene(w);
  for k: st.first..<st.first + st.count {
    o := w[0].ops[k];
    if o.has && forge_scene_find(s, o.a.id) >= 0 { wb_last_add(w, o.a.id); }
  }
}
wb_undo :: (w: [] WbWorld) -> bool {
  if !forge_scene_undo(wb_scene(w)) { return false; }
  wb_sync(w); wb_last_from_top(w); w[0].version += 1;
  return true;
}
wb_redo :: (w: [] WbWorld) -> bool {
  if !forge_scene_redo(wb_scene(w)) { return false; }
  wb_sync(w); wb_last_from_top(w); w[0].version += 1;
  return true;
}
wb_add_kind :: (w: [] WbWorld, kind: int, mesh: int, x: f32, z: f32, yaw: f32, scale: f32) -> int {
  if w[0].fg[0].n >= WB_OBJECTS { w[0].full = true; return -1; }
  s := wb_scene(w);
  id := ifx kind == FORGE_SCENE_DUPLICATE
    then forge_scene_duplicate(s, mesh, x, 0, z, yaw, scale)
    else forge_scene_place(s, mesh, x, 0, z, yaw, scale);
  wb_sync(w);
  if id >= 0 { wb_last_add(w, id); }
  return id;
}
wb_add :: (w: [] WbWorld, mesh: int, x: f32, z: f32, yaw: f32, scale: f32) -> int {
  return wb_add_kind(w, FORGE_SCENE_PLACE, mesh, x, z, yaw, scale);
}

// The camera's directions on the ground: away from the viewer and to their right.
WbDir :: struct { x: f32; z: f32; }
wb_away :: (v: WbView) -> WbDir { return WbDir.{x = sin(v.yaw), z = -cos(v.yaw)}; }
wb_right :: (v: WbView) -> WbDir { return WbDir.{x = cos(v.yaw), z = sin(v.yaw)}; }
wb_side_dir :: (v: WbView, side: int) -> WbDir {
  f := wb_away(v); r := wb_right(v);
  if side == S_LEFT { return WbDir.{x = -r.x, z = -r.z}; }
  if side == S_RIGHT { return r; }
  if side == S_FRONT { return WbDir.{x = -f.x, z = -f.z}; }
  if side == S_BEHIND { return f; }
  return WbDir.{};
}

// A spot and how far its things reach from it.
WbSpot :: struct { x: f32; z: f32; r: f32; ok: bool; }
// The middle and reach of a set of objects (by index).
wb_group :: (w: [] WbWorld, c: [] WbCat, idx: [] int) -> WbSpot {
  if idx.count == 0 { return WbSpot.{}; }
  sx: f32 = 0; sz: f32 = 0;
  for i: idx { sx += w[0].objs[i].x; sz += w[0].objs[i].z; }
  cx := sx / cast(f32) idx.count; cz := sz / cast(f32) idx.count;
  r: f32 = 0;
  for i: idx {
    o := w[0].objs[i];
    dx := o.x - cx; dz := o.z - cz;
    r = wb_hi(r, sqrt(dx * dx + dz * dz) + wb_radius(c, o.mesh) * o.scale);
  }
  return WbSpot.{x = cx, z = cz, r = r, ok = true};
}
wb_last_idx :: (w: [] WbWorld, out: [] int) -> int {
  n := 0;
  for k: 0..<w[0].last_n { i := wb_index(w, w[0].last[k]); if i >= 0 && n < out.count { out[n] = i; n += 1; } }
  return n;
}
wb_has :: (list: [] const int, n: int, v: int) -> bool { for i: 0..<n { if list[i] == v { return true; } } return false; }
// The anchor's spot, before any side.
wb_anchor :: (w: [] WbWorld, c: [] WbCat, v: WbView, a: WbAct) -> WbSpot {
  view := WbSpot.{x = v.view_x, z = v.view_z, ok = true};
  if a.anchor == A_HERE { return ifx v.has_here then WbSpot.{x = v.here_x, z = v.here_z, ok = true} else view; }
  if a.anchor == A_ORIGIN { return WbSpot.{ok = true}; }
  if a.anchor == A_LAST {
    idx: [WB_LAST] int; n := wb_last_idx(w, idx[..]);
    g := wb_group(w, c, idx[0..<n]);
    return ifx g.ok then g else view;
  }
  if a.anchor == A_NAMED {
    best := -1;
    for i: 0..<w[0].n { if wb_has(a.anchor_names[..], a.anchor_names_n, w[0].objs[i].mesh) { best = i; } }
    if best >= 0 { o := w[0].objs[best]; return WbSpot.{x = o.x, z = o.z, r = wb_radius(c, o.mesh) * o.scale, ok = true}; }
    return ifx v.has_here then WbSpot.{x = v.here_x, z = v.here_z, ok = true} else view;
  }
  return view;
}
// The objects an edit acts on, as indices.
wb_targets :: (w: [] WbWorld, c: [] WbCat, v: WbView, a: WbAct, out: [] int) -> int {
  n := 0;
  if a.targets == T_ALL { for i: 0..<w[0].n { if n < out.count { out[n] = i; n += 1; } } return n; }
  if a.targets == T_NAMES {
    for i: 0..<w[0].n { if wb_has(a.names[..], a.names_n, w[0].objs[i].mesh) && n < out.count { out[n] = i; n += 1; } }
    return n;
  }
  if a.targets == T_NEAREST {
    probe := a; if probe.anchor == A_SELF { probe.anchor = A_HERE; }
    p := wb_anchor(w, c, v, probe);
    best := -1; bd: f32 = 1000000000;
    for i: 0..<w[0].n {
      o := w[0].objs[i];
      if a.names_n > 0 && !wb_has(a.names[..], a.names_n, o.mesh) { continue; }
      d := (o.x - p.x) * (o.x - p.x) + (o.z - p.z) * (o.z - p.z);
      if d < bd { bd = d; best = i; }
    }
    if best >= 0 { out[0] = best; return 1; }
    return 0;
  }
  return wb_last_idx(w, out);
}

// Whether a footprint at (x, z) of radius r is clear of every thing standing (but those skipped).
wb_clear :: (w: [] WbWorld, c: [] WbCat, x: f32, z: f32, r: f32, from: int) -> bool {
  for i: from..<w[0].n {
    o := w[0].objs[i];
    room := r + wb_radius(c, o.mesh) * o.scale * 0.8;
    dx := o.x - x; dz := o.z - z;
    if dx * dx + dz * dz < room * room { return false; }
  }
  return true;
}
// A seeded draw in 0..1 for this world's edit number e, item i and property p.
wb_draw :: (w: [] WbWorld, e: int, i: int, p: int) -> f32 {
  return rand_unit(w[0].seed + e * 7919, p, i);
}
// Is this mesh a growing thing (turned any which way when placed), else made (turned to face you)?
wb_natural :: (c: [] WbCat, m: int) -> bool {
  n := wb_mesh_name(c, m);
  return n.count > 7 && n[0..<7] == "nature/";
}

// ---- the edits

WbDone :: struct { placed: int; changed: int; ok: bool; ground: int; }   // ground: edits of the ground among `changed`

wb_place :: (w: [] WbWorld, c: [] WbCat, v: WbView, a: WbAct) -> WbDone {
  done: WbDone;
  if a.asset < 0 || a.asset >= c[0].n { return done; }
  count := a.count; if count > WB_PER_EDIT { count = WB_PER_EDIT; }
  size := ifx a.size > 0.05 && a.size < 20 then a.size else 1.0f32;
  r := wb_radius(c, a.asset) * size;
  p := wb_anchor(w, c, v, a);
  if a.side != S_AT && a.side != S_AROUND {
    d := wb_side_dir(v, a.side);
    spread_r := ifx count > 1 then (ifx a.spread > 0 then a.spread else r * 1.3 * sqrt(cast(f32) count)) else r;
    far := p.r + spread_r + wb_hi(a.distance, 0) + 0.4;
    p.x += d.x * far; p.z += d.z * far;
  }
  start := w[0].n;
  w[0].last_n = 0;
  e := w[0].version;
  if a.side == S_AROUND {
    ring := p.r + r + wb_hi(a.distance, 0) + 0.4;
    for i: 0..<count {
      t := (cast(f32) i + 0.3 * wb_draw(w, e, i, 1)) / cast(f32) count * 6.2831853;
      x := p.x + ring * cos(t); z := p.z + ring * sin(t);
      yaw := ifx wb_natural(c, a.asset) then wb_draw(w, e, i, 2) * 6.2831853 else -v.yaw;
      if wb_add(w, a.asset, x, z, yaw, size) >= 0 { done.placed += 1; }
    }
    done.ok = done.placed > 0;
    return done;
  }
  if count == 1 {
    x := p.x; z := p.z;
    // put where nothing stands, unless it was asked for on a tapped spot or a thing's side
    nudge := a.anchor == A_VIEW || a.anchor == A_ORIGIN || (a.anchor == A_HERE && !v.has_here);
    if nudge {
      k := 0;
      while k < 64 && !wb_clear(w, c, x, z, r, 0) {
        k += 1; t := cast(f32) k * 2.3999632; rr := (r + 0.5) * sqrt(cast(f32) k);
        x = p.x + rr * cos(t); z = p.z + rr * sin(t);
      }
    }
    yaw := ifx wb_natural(c, a.asset) then wb_draw(w, e, 0, 2) * 6.2831853 else -v.yaw;
    if wb_add(w, a.asset, x, z, yaw, size) >= 0 { done.placed = 1; }
    done.ok = done.placed > 0;
    return done;
  }
  // several: spread over a disc, each clear of the others and of what stood there
  disc := ifx a.spread > 0 then a.spread else r * 1.3 * sqrt(cast(f32) count) + r;
  for i: 0..<count {
    x := p.x; z := p.z; tries := 0;
    while tries < 24 {
      u := wb_draw(w, e, i * 31 + tries, 3); t := wb_draw(w, e, i * 31 + tries, 4) * 6.2831853;
      rr := disc * sqrt(u);
      x = p.x + rr * cos(t); z = p.z + rr * sin(t);
      if wb_clear(w, c, x, z, r * 0.7, start) { break; }
      tries += 1;
    }
    yaw := ifx wb_natural(c, a.asset) then wb_draw(w, e, i, 2) * 6.2831853 else -v.yaw;
    jit := 1.0f32 + (wb_draw(w, e, i, 5) - 0.5) * 0.3 * (ifx wb_natural(c, a.asset) then 1.0f32 else 0.0f32);
    if wb_add(w, a.asset, x, z, yaw, size * jit) >= 0 { done.placed += 1; }
  }
  done.ok = done.placed > 0;
  return done;
}

wb_set_last :: (w: [] WbWorld, idx: [] int) { w[0].last_n = 0; for i: idx { wb_last_add(w, w[0].objs[i].id); } }

wb_move :: (w: [] WbWorld, c: [] WbCat, v: WbView, a: WbAct, idx: [] int) -> WbDone {
  done: WbDone;
  if idx.count == 0 { return done; }
  dx: f32 = 0; dz: f32 = 0;
  if a.anchor == A_SELF {
    d := wb_side_dir(v, a.side);
    step := ifx a.distance > 0 then a.distance else 3.0f32;
    dx = d.x * step; dz = d.z * step;
  } else {
    g := wb_group(w, c, idx);
    p := wb_anchor(w, c, v, a);
    // the anchor may be one of the things moved ("last"): then it is where they are now
    tx := p.x; tz := p.z;
    if a.side != S_AT && a.side != S_AROUND {
      d := wb_side_dir(v, a.side);
      far := p.r + g.r + wb_hi(a.distance, 0) + 0.4;
      tx += d.x * far; tz += d.z * far;
    }
    dx = tx - g.x; dz = tz - g.z;
  }
  s := wb_scene(w);
  for i: idx {
    o := w[0].objs[i];
    if forge_scene_move(s, o.id, o.x + dx, o.y, o.z + dz) { done.changed += 1; }
  }
  if done.changed > 0 { wb_set_last(w, idx); done.ok = true; }
  return done;
}

wb_delete :: (w: [] WbWorld, idx: [] int) -> WbDone {
  done: WbDone;
  if idx.count == 0 { return done; }
  ids: [WB_OBJECTS] int;
  for k: 0..<idx.count { ids[k] = w[0].objs[idx[k]].id; }
  s := wb_scene(w);
  for k: 0..<idx.count {
    if forge_scene_delete(s, ids[k]) { done.changed += 1; }
  }
  wb_sync(w);
  if done.changed > 0 { w[0].last_n = 0; done.ok = true; }
  return done;
}

wb_duplicate :: (w: [] WbWorld, c: [] WbCat, v: WbView, a: WbAct, idx: [] int) -> WbDone {
  done: WbDone;
  if idx.count == 0 { return done; }
  g := wb_group(w, c, idx);
  dx: f32 = 0; dz: f32 = 0;
  if a.anchor != A_SELF && a.anchor != A_LAST && a.side == S_AT && !(a.anchor == A_HERE && !v.has_here) {
    p := wb_anchor(w, c, v, a); dx = p.x - g.x; dz = p.z - g.z;
  } else {
    side := ifx a.side == S_AT || a.side == S_AROUND then S_RIGHT else a.side;
    d := wb_side_dir(v, side);
    far := 2 * g.r + wb_hi(a.distance, 0) + 0.5;
    dx = d.x * far; dz = d.z * far;
  }
  copies: [WB_OBJECTS] ForgeItem; n := 0;
  for i: idx { copies[n] = w[0].objs[i]; n += 1; }
  w[0].last_n = 0;
  for k: 0..<n { o := copies[k]; if wb_add_kind(w, FORGE_SCENE_DUPLICATE, o.mesh, o.x + dx, o.z + dz, o.yaw, o.scale) >= 0 { done.placed += 1; } }
  done.ok = done.placed > 0;
  return done;
}

// ---- the ground's edits (worldbuilder-land.coax): by chat here, by brush from the page

// Where a ground edit acts: everything (targets all), a strip along the world's edge on a side as
// the camera sees it (anchor edge), or a disc at the anchor, beside it on a side, or round a thing.
wb_land_shape :: (w: [] WbWorld, c: [] WbCat, v: WbView, a: WbAct, reach: f32) -> TerrainEditShape {
  if a.targets == T_ALL { return terrain_edit_box(-WB_LAND_HALF, -WB_LAND_HALF, WB_LAND_HALF, WB_LAND_HALF, 0); }
  r := wb_lo(wb_hi(ifx a.spread > 0 then a.spread else reach, 1), WB_LAND_HALF);
  if a.anchor == A_EDGE {
    d := wb_side_dir(v, ifx a.side == S_AT || a.side == S_AROUND then S_LEFT else a.side);
    wide := ifx a.spread > 0 then wb_lo(a.spread, WB_LAND_HALF) else 16.0f32;
    h: f32 = WB_LAND_HALF;
    if wb_abs(d.x) >= wb_abs(d.z) {
      if d.x > 0 { return terrain_edit_box(h - wide, -h, h, h, wide * 0.5); }
      return terrain_edit_box(-h, -h, -h + wide, h, wide * 0.5);
    }
    if d.z > 0 { return terrain_edit_box(-h, h - wide, h, h, wide * 0.5); }
    return terrain_edit_box(-h, -h, h, -h + wide, wide * 0.5);
  }
  probe := a; if probe.anchor == A_SELF { probe.anchor = A_HERE; }
  p := wb_anchor(w, c, v, probe);
  x := p.x; z := p.z;
  if a.side == S_LEFT || a.side == S_RIGHT || a.side == S_FRONT || a.side == S_BEHIND {
    d := wb_side_dir(v, a.side);
    far := p.r + wb_hi(a.distance, 0) + r * 0.7;
    x += d.x * far; z += d.z * far;
  } else { r += p.r; }
  return terrain_edit_disc(x, z, wb_lo(r, WB_LAND_HALF));
}
// One ground edit, as one undo step.
wb_land_act :: (w: [] WbWorld, c: [] WbCat, v: WbView, a: WbAct) -> WbDone {
  done: WbDone;
  l := w[0].land[..];
  tool := a.op - OP_PAINT;
  if tool == LT_PAINT && a.layer < 0 { return done; }
  wb_land_begin(l);
  wb_land_keep(l);
  all := a.targets == T_ALL;
  shape := wb_land_shape(w, c, v, a, ifx tool == LT_PAINT then 8.0f32 else ifx tool == LT_FLATTEN then 4.0f32 else 10.0f32);
  strength := ifx a.factor > 0 && a.factor < 1 then wb_hi(a.factor, 0.05) else 1.0f32;
  r: TerrainEditRect;
  if tool == LT_PAINT { r = wb_land_tool(l, tool, a.layer, shape, 0, strength); }
  else if tool == LT_RAISE || tool == LT_LOWER {
    high := ifx a.sized && a.size > 0 then wb_lo(a.size, WB_LAND_HIGH) else ifx tool == LT_RAISE then 4.0f32 else 3.0f32;
    r = wb_land_tool(l, tool, 0, shape, high, 1);
  } else if tool == LT_SMOOTH {
    for pass: 0..<4 { r = terrain_edit_join(r, wb_land_tool(l, tool, 0, shape, 0, strength)); }
  } else {
    level := ifx a.sized then a.size else ifx all then 0.0f32 else terrain_edit_height(wb_land_edit(l), shape.x, shape.z);
    r = wb_land_tool(l, tool, 0, shape, level, 1);
  }
  if !r.any { return done; }
  if forge_scene_land_step(wb_scene(w), l[0].was_h[..], l[0].was_ids[..], l[0].was_w[..], r.i0, r.j0, r.i1, r.j1) {
    done.changed = 1; done.ground = 1; done.ok = true; w[0].version += 1;
  }
  wb_sync(w);
  return done;
}
// A brush stroke from the page: begin where it goes down, a dab a frame while it is held, end when
// it lifts (one undo step for the whole stroke). `strength` is the brush's, 0 to 1; dt the frame's seconds.
wb_stroke_begin :: (w: [] WbWorld, x: f32, z: f32) {
  l := w[0].land[..];
  wb_land_begin(l);
  wb_land_keep(l);
  l[0].stroke = true; l[0].reach = TerrainEditRect.{};
  l[0].level = terrain_edit_height(wb_land_edit(l), x, z);
}
wb_stroke_dab :: (w: [] WbWorld, tool: int, layer: int, x: f32, z: f32, radius: f32, strength: f32, dt: f32) {
  l := w[0].land[..];
  if !l[0].stroke { return; }
  st := wb_lo(wb_hi(strength, 0.02), 1);
  shape := terrain_edit_disc(x, z, wb_lo(wb_hi(radius, 1), WB_LAND_HALF));
  r: TerrainEditRect;
  if tool == LT_PAINT { r = wb_land_tool(l, tool, layer, shape, 0, st); }
  else if tool == LT_RAISE || tool == LT_LOWER { r = wb_land_tool(l, tool, 0, shape, 14 * st * dt, 1); }
  else if tool == LT_SMOOTH { r = wb_land_tool(l, tool, 0, shape, 0, wb_lo(st * dt * 20, 1)); }
  else { r = wb_land_tool(l, tool, 0, shape, l[0].level, wb_lo(st * dt * 10, 1)); }
  l[0].reach = terrain_edit_join(l[0].reach, r);
}
wb_stroke_end :: (w: [] WbWorld) -> bool {
  l := w[0].land[..];
  if !l[0].stroke { return false; }
  l[0].stroke = false;
  r := l[0].reach;
  if !r.any { return false; }
  ok := forge_scene_land_step(wb_scene(w), l[0].was_h[..], l[0].was_ids[..], l[0].was_w[..], r.i0, r.j0, r.i1, r.j1);
  if ok { w[0].version += 1; }
  wb_sync(w);
  return ok;
}

// Carries one edit out through Aethyrforge's scene edit log: every edit has undo and redo.
wb_apply :: (w: [] WbWorld, c: [] WbCat, v: WbView, a: WbAct) -> WbDone {
  done: WbDone;
  if a.op == OP_UNDO {
    times := ifx a.count < 1 then 1 else a.count;
    for t: 0..<times { if wb_undo(w) { done.changed += 1; } }
    done.ok = done.changed > 0;
    return done;
  }
  if a.op == OP_REDO {
    times := ifx a.count < 1 then 1 else a.count;
    for t: 0..<times { if wb_redo(w) { done.changed += 1; } }
    done.ok = done.changed > 0;
    return done;
  }
  if a.op >= OP_PAINT && a.op <= OP_FLATTEN { return wb_land_act(w, c, v, a); }
  s := wb_scene(w);
  if a.op == OP_CLEAR {
    removed := forge_scene_clear(s);
    wb_sync(w);
    if removed > 0 { w[0].last_n = 0; done.changed = removed; done.ok = true; w[0].version += 1; }
    return done;
  }
  idx: [WB_OBJECTS] int; n := 0;
  if a.op == OP_PLACE {
    forge_scene_begin(s, FORGE_SCENE_PLACE);
    done = wb_place(w, c, v, a);
    done.ok = forge_scene_end(s);
  } else {
    n = wb_targets(w, c, v, a, idx[..]);
    if a.op == OP_MOVE {
      forge_scene_begin(s, FORGE_SCENE_MOVE);
      done = wb_move(w, c, v, a, idx[0..<n]);
      done.ok = forge_scene_end(s);
    } else if a.op == OP_ROTATE {
      forge_scene_begin(s, FORGE_SCENE_ROTATE);
      for i: idx[0..<n] {
        o := w[0].objs[i];
        if forge_scene_rotate(s, o.id, o.yaw + a.degrees * 0.017453292) { done.changed += 1; }
      }
      done.ok = forge_scene_end(s);
      if done.ok { wb_set_last(w, idx[0..<n]); }
    } else if a.op == OP_SCALE {
      f := ifx a.factor > 0.05 && a.factor < 20 then a.factor else 1.0f32;
      forge_scene_begin(s, FORGE_SCENE_SCALE);
      for i: idx[0..<n] {
        o := w[0].objs[i];
        if forge_scene_scale(s, o.id, wb_lo(wb_hi(o.scale * f, 0.05), 40)) { done.changed += 1; }
      }
      done.ok = forge_scene_end(s);
      if done.ok { wb_set_last(w, idx[0..<n]); }
    } else if a.op == OP_DELETE {
      forge_scene_begin(s, FORGE_SCENE_DELETE);
      done = wb_delete(w, idx[0..<n]);
      done.ok = forge_scene_end(s);
    } else if a.op == OP_DUPLICATE {
      forge_scene_begin(s, FORGE_SCENE_DUPLICATE);
      done = wb_duplicate(w, c, v, a, idx[0..<n]);
      done.ok = forge_scene_end(s);
    }
  }
  wb_sync(w);
  if done.ok { w[0].version += 1; }
  return done;
}

// An answer's lines: "S say" and "A edit" lines, carried out in order. What it did, in sum.
WbSum :: struct { placed: int; changed: int; edits: int; missing: int; say: [160] u8; say_n: int; ground: int; }
wb_answer :: (w: [] WbWorld, c: [] WbCat, v: WbView, text: string) -> WbSum {
  sum: WbSum;
  w[0].full = false;
  i := 0;
  while i < text.count {
    e := i; while e < text.count && text[e] != '\n' { e += 1; }
    line := text[i..<e];
    if line.count > 2 && line[0] == 'S' && line[1] == ' ' {
      k := 0; for j: 2..<line.count { if k < sum.say.count { sum.say[k] = line[j]; k += 1; } }
      sum.say_n = k;
    }
    if line.count > 2 && line[0] == 'A' && line[1] == ' ' {
      r := wb_read(c, line[2..<line.count]);
      sum.missing += r.missing;
      if r.ok {
        d := wb_apply(w, c, v, r.act);
        if d.ok { sum.edits += 1; }
        sum.placed += d.placed; sum.changed += d.changed; sum.ground += d.ground;
      }
    }
    i = e + 1;
  }
  w[0].missing = sum.missing > 0;
  return sum;
}

// ---- keeping a world: a line a thing, "NAME X Z YAW SCALE" (names, so a newer pack still reads it)

wb_put :: (b: [] u8, at: int, t: string) -> int { n := at; for i: 0..<t.count { if n < b.count { b[n] = t[i]; n += 1; } } return n; }
wb_put_num :: (b: [] u8, at: int, v: f32) -> int {
  n := at;
  x := v;
  if x < 0 { n = wb_put(b, n, "-"); x = -x; }
  whole := cast(int) x;
  frac := cast(int) ((x - cast(f32) whole) * 1000 + 0.5);
  if frac >= 1000 { whole += 1; frac -= 1000; }
  d: [12] u8; k := 0; q := whole;
  while true { d[k] = cast(u8) (48 + q % 10); k += 1; q /= 10; if q == 0 { break; } }
  while k > 0 { k -= 1; if n < b.count { b[n] = d[k]; n += 1; } }
  n = wb_put(b, n, ".");
  for p: 0..<3 { div := ifx p == 0 then 100 else ifx p == 1 then 10 else 1; if n < b.count { b[n] = cast(u8) (48 + (frac / div) % 10); n += 1; } }
  return n;
}
wb_save :: (w: [] WbWorld, c: [] WbCat, b: [] u8) -> int {
  n := wb_put(b, 0, "WB1\n");
  for i: 0..<w[0].n {
    o := w[0].objs[i];
    n = wb_put(b, n, wb_mesh_name(c, o.mesh)); n = wb_put(b, n, " ");
    n = wb_put_num(b, n, o.x); n = wb_put(b, n, " "); n = wb_put_num(b, n, o.z); n = wb_put(b, n, " ");
    n = wb_put_num(b, n, o.yaw); n = wb_put(b, n, " "); n = wb_put_num(b, n, o.scale); n = wb_put(b, n, "\n");
  }
  // the ground after the things; when it can't all fit, none of it is kept (the page says so)
  g := wb_land_save(w[0].land[..], b, n);
  w[0].unkept = g < 0;
  return ifx g < 0 then n else g;
}
wb_load :: (w: [] WbWorld, c: [] WbCat, text: string) -> int {
  if text.count < 4 || text[0..<4] != "WB1\n" { return 0; }
  wb_reset(w);
  s := wb_scene(w);
  i := 4;
  while i < text.count {
    e := i; while e < text.count && text[e] != '\n' { e += 1; }
    line := text[i..<e];
    if line.count > 1 && line[0] == '~' { wb_land_line(w[0].land[..], line[1..<line.count]); i = e + 1; continue; }
    sp := 0; while sp < line.count && line[sp] != ' ' { sp += 1; }
    m := wb_find(c, line[0..<sp]);
    if m >= 0 {
      at: [1] int; at[0] = sp;
      x := wb_num_at(line, at[..]); ok := at[0] >= 0;
      z := wb_num_at(line, at[..]); ok = ok && at[0] >= 0;
      yaw := wb_num_at(line, at[..]); ok = ok && at[0] >= 0;
      sc := wb_num_at(line, at[..]); ok = ok && at[0] >= 0 && sc > 0;
      if ok { id := forge_scene_load(s, m, x, 0, z, yaw, sc); }
    }
    i = e + 1;
  }
  wb_land_loaded(w[0].land[..]);
  wb_sync(w);
  w[0].last_n = 0;
  return w[0].n;
}

// ---- checks: typed edits in, the world out

WB_TEST_CAT :: "pack worldbuilder\nL 0 Quaternius|CC0 1.0|\nM nature/birch-1 0 30 0 -3 0 -3 3 13 3\nM nature/rock-1 30 12 0 -0.5 0 -0.5 0.5 0.6 0.5\nM nature/rock-2 42 12 0 -0.6 0 -0.4 0.6 0.5 0.4\nM village/house-1 54 90 0 -4 0 -3 4 7 3\nM nature/grass-1 144 6 0 -0.2 0 -0.2 0.2 0.3 0.2\nM nature/flower-1 150 6 0 -0.15 0 -0.15 0.15 0.4 0.15\n";
wb_test_view :: () -> WbView { return WbView.{has_here = true, here_x = 2, here_z = -5, view_x = 0, view_z = -8, yaw = 0}; }
wb_one :: (w: [] WbWorld, c: [] WbCat, v: WbView, line: string) -> WbSum { return wb_answer(w, c, v, line); }
wb_near :: (a: f32, b: f32, tol: f32) -> bool { return wb_abs(a - b) <= tol; }
wb_count :: (w: [] WbWorld, c: [] WbCat, name: string) -> int { m := wb_find(c, name); n := 0; for i: 0..<w[0].n { if w[0].objs[i].mesh == m { n += 1; } } return n; }

#test "the catalogue reads the pack's M lines: names, index ranges and bounds" {
  c: [1] WbCat; wb_catalog(c[..], WB_TEST_CAT);
  #assert c[0].n == 6 && wb_find(c[..], "village/house-1") == 3 && wb_find(c[..], "nature/oak") == -1;
  #assert c[0].first[3] == 54 && c[0].count[3] == 90 && wb_radius(c[..], 3) == 4;
}
#test "an edit's line: its op, names matched whole, numbers, and what an unknown name is" {
  c: [1] WbCat; wb_catalog(c[..], WB_TEST_CAT);
  r := wb_read(c[..], "place|nature/rock-1|5|||last||around|1.5||0.8||");
  #assert r.ok && r.act.op == OP_PLACE && r.act.asset == 1 && r.act.count == 5 && r.act.anchor == A_LAST && r.act.side == S_AROUND;
  #assert r.act.distance == 1.5 && wb_near(r.act.size, 0.8, 0.0001) && r.act.factor == 1;
  d := wb_read(c[..], "delete|||names|nature/rock-1,nature/rock-2,nature/oak|||||||");
  #assert d.ok && d.act.targets == T_NAMES && d.act.names_n == 2 && d.missing == 1;
  #assert !wb_read(c[..], "explode|||||||||||").ok;
  #assert !wb_read(c[..], "place|nature/oak|1||||||||||").ok && wb_read(c[..], "place|nature/oak|1||||||||||").missing == 1;
  m := wb_read(c[..], "move|||last|||||||||");
  #assert m.ok && m.act.anchor == A_SELF && m.act.side == S_AT;
}
#test "put a tree here; five rocks around it; a house to the left of the tree" {
  c: [1] WbCat; wb_catalog(c[..], WB_TEST_CAT);
  w: [1] WbWorld; v := wb_test_view();
  s := wb_one(w[..], c[..], v, "S A birch, right there.\nA place|nature/birch-1|1|||here||at||||||\n");
  #assert s.placed == 1 && w[0].n == 1 && w[0].objs[0].x == 2 && w[0].objs[0].z == -5;
  #assert cast(string) s.say[0..<s.say_n] == "A birch, right there.";
  s = wb_one(w[..], c[..], v, "A place|nature/rock-1|5|||last||around||||||\n");
  #assert s.placed == 5 && w[0].n == 6 && w[0].last_n == 5;
  // each rock on a ring clear of the tree's trunk-to-crown footprint
  for i: 1..<6 { o := w[0].objs[i]; d := sqrt((o.x - 2) * (o.x - 2) + (o.z + 5) * (o.z + 5)); #assert d > 3 && d < 5; }
  s = wb_one(w[..], c[..], v, "A place|village/house-1|1|||named|nature/birch-1|left||||||\n");
  h := w[0].objs[6];
  // left as the camera (yaw 0, looking along -z) sees it is -x: the house's 4 m and the tree's 3 m apart, and a gap
  #assert s.placed == 1 && h.z == -5 && h.x < 2 - 7 && h.x > 2 - 8;
}
#test "move that further back; make it bigger; delete the rocks; undo brings them back" {
  c: [1] WbCat; wb_catalog(c[..], WB_TEST_CAT);
  w: [1] WbWorld; v := wb_test_view();
  s := wb_one(w[..], c[..], v, "A place|nature/birch-1|1|||here||at||||||\nA place|nature/rock-1|3|||here||right||||||\nA place|village/house-1|1|||here||left||||||\n");
  #assert w[0].n == 5;
  hz := w[0].objs[4].z;
  s = wb_one(w[..], c[..], v, "A move|||last||self||behind|4|||||\n");
  #assert s.changed == 1 && wb_near(w[0].objs[4].z, hz - 4, 0.001);
  s = wb_one(w[..], c[..], v, "A scale|||last||||||||1.5||\n");
  #assert wb_near(w[0].objs[4].scale, 1.5, 0.001);
  s = wb_one(w[..], c[..], v, "A delete|||names|nature/rock-1|||||||\n");
  #assert s.changed == 3 && w[0].n == 2 && wb_count(w[..], c[..], "nature/rock-1") == 0;
  s = wb_one(w[..], c[..], v, "A undo||1|||||||||\n");
  #assert w[0].n == 5 && wb_count(w[..], c[..], "nature/rock-1") == 3;
  s = wb_one(w[..], c[..], v, "A undo||2|||||||||\n");
  #assert w[0].n == 5 && wb_near(w[0].objs[4].scale, 1, 0.001) && wb_near(w[0].objs[4].z, hz, 0.001);
}
#test "fill the area with grass and flowers: many, spread, none on another, the same every time" {
  c: [1] WbCat; wb_catalog(c[..], WB_TEST_CAT);
  w: [1] WbWorld; u: [1] WbWorld; v := wb_test_view();
  a := "A place|nature/grass-1|40|||here||at||8|||\nA place|nature/flower-1|25|||here||at||8|||\n";
  s := wb_one(w[..], c[..], v, a); t := wb_one(u[..], c[..], v, a);
  #assert s.placed == 65 && w[0].n == 65;
  for i: 0..<w[0].n {
    o := w[0].objs[i];
    #assert sqrt((o.x - 2) * (o.x - 2) + (o.z + 5) * (o.z + 5)) <= 8.01;
    #assert o.x == u[0].objs[i].x && o.z == u[0].objs[i].z;
  }
}
#test "rotate, duplicate beside, nearest to the tap, clear, and undo of clear" {
  c: [1] WbCat; wb_catalog(c[..], WB_TEST_CAT);
  w: [1] WbWorld; v := wb_test_view();
  s := wb_one(w[..], c[..], v, "A place|nature/rock-1|1|||origin||at||||||\nA place|village/house-1|1|||here||at||||||\n");
  s = wb_one(w[..], c[..], v, "A rotate|||last|||||||||90\n");
  #assert wb_near(w[0].objs[1].yaw, 1.5707963, 0.001);
  s = wb_one(w[..], c[..], v, "A duplicate|||last|||||||||\n");
  #assert w[0].n == 3 && w[0].objs[2].mesh == 3 && w[0].objs[2].x > w[0].objs[1].x + 7;
  s = wb_one(w[..], c[..], v, "A delete|||nearest|nature/rock-1|here||||||||\n");
  #assert w[0].n == 2 && wb_count(w[..], c[..], "nature/rock-1") == 0;
  s = wb_one(w[..], c[..], v, "A clear||||||||||||\n");
  #assert w[0].n == 0;
  s = wb_one(w[..], c[..], v, "A undo||||||||||||\n");
  #assert w[0].n == 2;
}
#test "a world holds WB_OBJECTS things and says when it is full; an edit that does nothing can't be undone" {
  c: [1] WbCat; wb_catalog(c[..], WB_TEST_CAT);
  w: [1] WbWorld; v := wb_test_view();
  for k: 0..<21 { s := wb_one(w[..], c[..], v, "A place|nature/grass-1|200|||origin||at||60|||\n"); }
  #assert w[0].n == WB_OBJECTS && w[0].full;
  steps_was := w[0].fg[0].step_n;
  s := wb_one(w[..], c[..], v, "A delete|||names|nature/rock-1|||||||\n");
  #assert s.edits == 0 && w[0].fg[0].step_n == steps_was;
  // all 21 compound steps (past the old 8-snapshot cap) undo and redo through the forge edit log
  for k: 0..<21 { #assert wb_undo(w[..]); }
  #assert w[0].n == 0 && !wb_can_undo(w[..]) && wb_can_redo(w[..]);
  for k: 0..<21 { #assert wb_redo(w[..]); }
  #assert w[0].n == WB_OBJECTS && !wb_can_redo(w[..]);
}

#test "every edit kind undoes and redoes through Aethyrforge's edit log, including scatter and redo lines" {
  c: [1] WbCat; wb_catalog(c[..], WB_TEST_CAT);
  w: [1] WbWorld; v := wb_test_view();
  // scatter 12 grass as one compound step
  s := wb_one(w[..], c[..], v, "A place|nature/grass-1|12|||origin||at||6|||\n");
  #assert s.placed == 12 && w[0].n == 12 && wb_can_undo(w[..]) && !wb_can_redo(w[..]);
  gx := w[0].objs[11].x; gz := w[0].objs[11].z;
  // place house, move, rotate, scale, duplicate, delete grass, clear
  s = wb_one(w[..], c[..], v, "A place|village/house-1|1|||here||at||||||\n");
  s = wb_one(w[..], c[..], v, "A move|||last||self||behind|3|||||\n");
  s = wb_one(w[..], c[..], v, "A rotate|||last|||||||||45\n");
  s = wb_one(w[..], c[..], v, "A scale|||last||||||||2.0||\n");
  s = wb_one(w[..], c[..], v, "A duplicate|||last|||||||||\n");
  #assert w[0].n == 14;
  hx := w[0].objs[12].x; hz := w[0].objs[12].z; hyaw := w[0].objs[12].yaw;
  s = wb_one(w[..], c[..], v, "A delete|||names|nature/grass-1|||||||\n");
  #assert w[0].n == 2;
  s = wb_one(w[..], c[..], v, "A clear||||||||||||\n");
  #assert w[0].n == 0;
  // undo clear and delete via model line; redo delete via model line
  s = wb_one(w[..], c[..], v, "A undo||2|||||||||\n");
  #assert s.changed == 2 && w[0].n == 14 && w[0].objs[11].x == gx && w[0].objs[11].z == gz;
  #assert w[0].objs[12].x == hx && w[0].objs[12].z == hz && w[0].objs[12].yaw == hyaw && wb_near(w[0].objs[12].scale, 2.0, 0.001);
  s = wb_one(w[..], c[..], v, "A redo||2|||||||||\n");
  #assert s.changed == 2 && w[0].n == 0 && !wb_can_redo(w[..]);
  // undo all 8 steps back to empty, then redo the scatter step and branch with a new edit
  for k: 0..<8 { #assert wb_undo(w[..]); }
  #assert w[0].n == 0 && !wb_can_undo(w[..]) && wb_can_redo(w[..]);
  #assert wb_redo(w[..]) && w[0].n == 12 && w[0].objs[11].x == gx;
  s = wb_one(w[..], c[..], v, "A place|nature/rock-1|1|||here||at||||||\n");
  #assert w[0].n == 13 && !wb_can_redo(w[..]);
}
WB_PIECES_CAT :: "M village/wall-plaster-door-round 0 9 1 -1 0 -0.205 1 3.12 0.205\nM village/wall-plaster-window-wide-round 9 9 1 -1 0 -0.205 1 3.12 0.205\nM village/wall-plaster-window-thin-round 18 9 1 -1 0 -0.205 1 3.12 0.205\nM village/wall-plaster-straight 27 9 1 -1 0 -0.205 1 3.12 0.205\nM village/wall-plaster-window-wide-flat 36 9 1 -1 0 -0.205 1 3.12 0.205\nM village/corner-exterior-wood 45 9 1 -0.1 0 -0.1 0.1 3 0.1\nM village/roof-roundtiles-4x4 54 9 1 -2.75 0 -2.78 2.75 4.25 2.78\nM village/roof-front-wood4 63 9 1 -2.2 0 -0.565 2.2 3.07 0.565\n";
#test "a building is the kit's pieces put together: one thing, its box round them all; one missing a piece isn't there" {
  c: [1] WbCat; wb_catalog(c[..], WB_PIECES_CAT);
  m := wb_find(c[..], "house/cottage");
  #assert c[0].real_n == 8 && m == 8 && c[0].n == 9 && wb_is_building(c[..], m) && !wb_is_building(c[..], 0);
  #assert c[0].part_n[m] == 15 && c[0].parts[c[0].part_first[m] + 14].mesh == 6 && c[0].parts[c[0].part_first[m] + 14].y == 3;
  b := c[0].box[m * 6..<m * 6 + 6];
  #assert wb_near(b[0], -2.75, 0.001) && wb_near(b[3], 2.75, 0.001) && wb_near(b[2], -2.78, 0.001) && wb_near(b[5], 2.78, 0.001);
  #assert b[1] == 0 && wb_near(b[4], 7.25, 0.001);
  // the timber house and the long house need pieces this catalogue lacks
  #assert wb_find(c[..], "house/timber-house") == -1 && wb_find(c[..], "house/long-house") == -1 && c[0].parts_n == 15;
  w: [1] WbWorld; v := wb_test_view();
  s := wb_one(w[..], c[..], v, "A place|house/cottage|1|||here||at||||||\n");
  #assert s.placed == 1 && w[0].objs[0].mesh == m;
}
#test "a world kept as lines comes back the same" {
  c: [1] WbCat; wb_catalog(c[..], WB_TEST_CAT);
  w: [1] WbWorld; v := wb_test_view();
  s := wb_one(w[..], c[..], v, "A place|nature/rock-2|7|||here||at||||||\nA place|village/house-1|1|||here||behind|2|||||\n");
  b: [65536] u8; n := wb_save(w[..], c[..], b[..]);
  u: [1] WbWorld;
  #assert wb_load(u[..], c[..], cast(string) b[0..<n]) == 8;
  for i: 0..<8 {
    #assert u[0].objs[i].mesh == w[0].objs[i].mesh && wb_near(u[0].objs[i].x, w[0].objs[i].x, 0.001) && wb_near(u[0].objs[i].z, w[0].objs[i].z, 0.001);
    #assert wb_near(u[0].objs[i].yaw, w[0].objs[i].yaw, 0.001) && wb_near(u[0].objs[i].scale, w[0].objs[i].scale, 0.001);
  }
  #assert wb_load(u[..], c[..], "something else") == 0;
}

#test "the ground by chat: grass everywhere, a hill here, a beach along the left, level round the house; each one undo step" #steps 4000000000 {
  c: [1] WbCat; wb_catalog(c[..], WB_TEST_CAT);
  w: [1] WbWorld; v := wb_test_view();
  l := w[0].land[..];
  #assert wb_read(c[..], "paint|grass||all|||||||||").ok && !wb_read(c[..], "paint|lava||all|||||||||").ok && wb_read(c[..], "raise|||||here||at||12|5||").act.sized;
  s := wb_one(w[..], c[..], v, "A paint|grass||all|||||||||\n");
  mid := 128 * WB_LAND_SIDE + 128;
  #assert s.edits == 1 && !l[0].bare && terrain_edit_share(wb_land_edit(l), mid, L_GRASS) == 1 && terrain_edit_share(wb_land_edit(l), 0, L_GRASS) == 1;
  // a hill 5 m high, 12 m across, on the tapped spot (2, -5)
  s = wb_one(w[..], c[..], v, "A raise|||||here||at||12|5||\n");
  #assert s.edits == 1 && wb_near(wb_land_y(l, 2, -5), 5, 0.01) && wb_land_y(l, 2, 20) == 0 && wb_land_y(l, 8, -5) > 0.5 && wb_land_y(l, 8, -5) < 4.5;
  // a thing placed on the hill stands on it (the page seats it at wb_land_y)
  s = wb_one(w[..], c[..], v, "A place|village/house-1|1|||here||at||||||\n");
  #assert w[0].n == 1;
  // sand along the left edge as the camera sees it (yaw 0: left is -x), 20 m wide
  s = wb_one(w[..], c[..], v, "A paint|sand||||edge||left||20|||\n");
  west := 128 * WB_LAND_SIDE + 5; east := 128 * WB_LAND_SIDE + 250;
  #assert terrain_edit_share(wb_land_edit(l), west, L_SAND) == 1 && terrain_edit_share(wb_land_edit(l), east, L_SAND) == 0 && terrain_edit_share(wb_land_edit(l), mid, L_SAND) == 0;
  // level the ground round the house: to the height where it stands
  s = wb_one(w[..], c[..], v, "A flatten|||||named|village/house-1|at|||||\n");
  #assert s.edits == 1 && wb_near(wb_land_y(l, 2, -5), 5, 0.01) && wb_near(wb_land_y(l, 5, -5), 5, 0.05);
  // lower makes a hollow, smooth softens it; neither moves the world's edge
  s = wb_one(w[..], c[..], v, "A lower|||||origin||at||10|3||\nA smooth|||||origin||at||12|||\n");
  #assert s.edits == 2 && wb_land_y(l, 0, 40) == 0 && wb_land_y(l, 0, 60) == 0 && l[0].heights[0] == 0;
  hollow := wb_land_y(l, 2, -5);
  #assert hollow < 4.5;
  // undo walks back through every step, the thing between them too; redo forward again
  #assert wb_undo(w[..]) && wb_undo(w[..]) && wb_undo(w[..]) && wb_land_y(l, 9, -5) < 4.5 && wb_land_y(l, 9, -5) > 2;
  #assert wb_undo(w[..]) && terrain_edit_share(wb_land_edit(l), west, L_SAND) == 0 && terrain_edit_share(wb_land_edit(l), west, L_GRASS) == 1;
  #assert wb_undo(w[..]) && w[0].n == 0 && wb_undo(w[..]) && wb_land_y(l, 2, -5) == 0 && !l[0].bare;
  #assert wb_undo(w[..]) && l[0].bare && !wb_can_undo(w[..]);
  for k: 0..<7 { #assert wb_redo(w[..]); }
  #assert !wb_can_redo(w[..]) && w[0].n == 1 && terrain_edit_share(wb_land_edit(l), west, L_SAND) == 1 && wb_land_y(l, 2, -5) == hollow;
  // an edit that changes nothing (grass over grass off the sand) leaves no step
  steps := w[0].fg[0].step_n;
  s = wb_one(w[..], c[..], v, "A paint|grass||||origin||at||3|||\n");
  #assert s.edits == 0 && w[0].fg[0].step_n == steps;
}
#test "a brush stroke is one undo step; the ground is kept with the world and comes back the same to a centimetre" #steps 4000000000 {
  c: [1] WbCat; wb_catalog(c[..], WB_TEST_CAT);
  w: [1] WbWorld; v := wb_test_view();
  l := w[0].land[..];
  wb_stroke_begin(w[..], 10, 10);
  for k: 0..<30 { wb_stroke_dab(w[..], LT_RAISE, 0, 10 + cast(f32) k * 0.5, 10, 6, 1, 1.0 / 60.0); }
  #assert wb_stroke_end(w[..]) && w[0].fg[0].step_n == 1 && wb_land_y(l, 15, 10) > 1;
  wb_stroke_begin(w[..], 12, 10);
  for k: 0..<20 { wb_stroke_dab(w[..], LT_PAINT, L_STONE, 12 + cast(f32) k * 0.5, 10, 4, 0.6, 1.0 / 60.0); }
  #assert wb_stroke_end(w[..]) && w[0].fg[0].step_n == 2;
  wb_stroke_begin(w[..], 50, 50);
  #assert !wb_stroke_end(w[..]) && w[0].fg[0].step_n == 2;   // a stroke that touched nothing
  s := wb_one(w[..], c[..], v, "A place|nature/rock-1|1|||here||at||||||\nA paint|water||||origin||at||9|||\n");
  top := wb_land_y(l, 15, 10); stone := terrain_edit_share(wb_land_edit(l), (10 + 128) * WB_LAND_SIDE + 15 + 128, L_STONE);
  #assert stone > 0.5;
  b: [200000] u8;
  n := wb_save(w[..], c[..], b[..]);
  #assert n > 0 && !w[0].unkept;
  u: [1] WbWorld;
  #assert wb_load(u[..], c[..], cast(string) b[0..<n]) == 1;
  k := u[0].land[..];
  #assert !k[0].bare && wb_near(wb_land_y(k, 15, 10), top, 0.011) && wb_near(terrain_edit_share(wb_land_edit(k), (10 + 128) * WB_LAND_SIDE + 15 + 128, L_STONE), stone, 0.03);
  #assert terrain_edit_share(wb_land_edit(k), 128 * WB_LAND_SIDE + 128, L_WATER) == 1 && terrain_edit_share(wb_land_edit(k), 0, L_GRID) == 1;
  for j: 0..<WB_LAND_CELLS { for i: 0..<WB_LAND_CELLS {
    #assert tt_triangle_ids(k[0].ids[..], k[0].weights[..], tt_corners(WB_LAND_CELLS, i, j, true)) <= 4 && tt_triangle_ids(k[0].ids[..], k[0].weights[..], tt_corners(WB_LAND_CELLS, i, j, false)) <= 4;
  } }
  // a buffer too small for the ground keeps the things and says the ground isn't kept
  small: [64] u8;
  n = wb_save(w[..], c[..], small[..]);
  #assert w[0].unkept && n > 0 && n <= 64;
  // a broken line changes nothing past its break and a bare world keeps no ground lines
  wb_land_line(k, "H 300 0 1 000");
  wb_land_line(k, "P 5 zz");
  fresh: [1] WbWorld;
  n = wb_save(fresh[..], c[..], b[..]);
  #assert n == 4;
}
