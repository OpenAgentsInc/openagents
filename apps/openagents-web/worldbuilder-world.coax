// WorldBuilder's world behind world.edit.v1 (GitHub #13422, the browser editor's E13;
// docs/editor/2026-11-12-browser-editor.md, docs/protocol/world-edit-v1.md): every change to the
// things of a WorldBuilder world, and every dab of a brush on its ground, is one typed edit
// (metaverse-engine/editor/world-edit.coax), checked here by WorldBuilder's own rules and carried
// out on the engine's edit log (metaverse-engine/editor/edit.coax), which keeps its inverse.
//
// The world is kept in this browser and has no account, so no server holds it: the page's own
// Coax is what checks an edit, with the codec every world uses. The chat's edits
// (worldbuilder-plan.coax), the editor shell's batches and the viewport's drags all come through
// wbe_thing and wbe_dab, and each edit taken moves the world's revision by one.
//
// WorldBuilder's rules, each refused in words (wbe_why):
//   a world holds WB_OBJECTS things;
//   a thing's kind is one of the models (its number is the model's place in the pack, from 1);
//   a thing stands on the ground: its height is the ground's, never an edit's;
//   a thing has a place, a turn, a size and a kind, and no other column;
//   there are no content tables;
//   a brush is 1 m to 40 m wide, presses 1 to 100 percent, acts on the ground (256 m a side) and
//   paints one of the ground's materials;
//   a batch changes things or shapes the ground, not both;
//   the world has no live lane to publish to.
//
// A `terrain` edit here: brush paint, raise, lower, smooth or flatten; x, z its middle and r its
// radius, centimetres; v how hard it presses, 1 to 100 percent; mat the material painted
// (worldbuilder-land.coax L_*). At 100 percent one dab raises or lowers the middle WBE_LIFT_CM,
// paints fully, smooths by two thirds and levels by a third toward the height at its own middle.
//
// The chat's ground commands that are no disc (the whole ground, a strip along an edge, a level
// in metres: worldbuilder-plan.coax wb_land_act) are steps of the same log and move the revision,
// but a `terrain` edit cannot say their shape, so they are not world.edit.v1 edits.
//   coax/bin/coax test apps/openagents-web/worldbuilder-plan.coax
#load "../../metaverse-engine/editor/viewport.coax";
#load "../../metaverse-engine/editor/shell-model.coax";

WBE_ID :: "create-world";
WBE_R_LO :: 100; WBE_R_HI :: 4000;   // a brush's radius, centimetres
WBE_LIFT_CM :: 47;                   // what one dab at full strength raises or lowers the middle
WBE_LISTED :: EM_ENTS;               // things a model lists: the newest, and the selected one

WBE_OK :: 0;
WBE_NOT_EDIT :: 1; WBE_FULL :: 2; WBE_KIND :: 3; WBE_NO_THING :: 4; WBE_SAME :: 5; WBE_CELL :: 6; WBE_HEIGHT :: 7; WBE_COLUMN :: 8;
WBE_NUMBER :: 9; WBE_BRUSH :: 10; WBE_PRESS :: 11; WBE_EDGE :: 12; WBE_MAT :: 13; WBE_STALE :: 14; WBE_BATCH :: 15; WBE_MIXED :: 16;
WBE_PUBLISH :: 17; WBE_NO_UNDO :: 18; WBE_NO_REDO :: 19; WBE_EMPTY :: 20; WBE_LOG :: 21; WBE_TURN :: 22;

// A refusal in words.
wbe_why :: (why: int) -> string {
  if why == WBE_NOT_EDIT { return "That is not an edit this world reads."; }
  if why == WBE_FULL { return "This world is full: 4096 things at most. Delete some to add more."; }
  if why == WBE_KIND { return "The models have no such kind."; }
  if why == WBE_NO_THING { return "No thing has that number."; }
  if why == WBE_SAME { return "That changes nothing."; }
  if why == WBE_CELL { return "A WorldBuilder world has no content tables to edit."; }
  if why == WBE_HEIGHT { return "A thing stands on the ground: its height is the ground's."; }
  if why == WBE_COLUMN { return "A thing has a place, a turn, a size and a kind, and nothing else to set."; }
  if why == WBE_NUMBER { return "The world numbers a new thing itself."; }
  if why == WBE_BRUSH { return "A brush is 1 m to 40 m wide."; }
  if why == WBE_PRESS { return "A brush presses 1 to 100 percent."; }
  if why == WBE_EDGE { return "The ground is 256 m a side: that is past its edge."; }
  if why == WBE_MAT { return "The ground has no such material."; }
  if why == WBE_STALE { return "The world changed since that was made. Try again."; }
  if why == WBE_BATCH { return "That is not a batch of edits."; }
  if why == WBE_MIXED { return "Shape the ground and change things in separate steps."; }
  if why == WBE_PUBLISH { return "This world is kept in this browser. It has nowhere to publish to."; }
  if why == WBE_NO_UNDO { return "Nothing to undo."; }
  if why == WBE_NO_REDO { return "Nothing to redo."; }
  if why == WBE_EMPTY { return "Nothing is placed."; }
  if why == WBE_LOG { return "That stroke changed more ground than one undo step keeps. It was taken back."; }
  if why == WBE_TURN { return "A turn is -179 to 180 degrees."; }
  return "";
}

WbeTook :: struct { ok: bool; id: int; why: int; }
wbe_no :: (why: int) -> WbeTook { return WbeTook.{why = why}; }
wbe_pct :: (scale: f32) -> int { p := we_pct(scale); return ifx p < EDITOR_SCALE_MIN then EDITOR_SCALE_MIN else ifx p > EDITOR_SCALE_MAX then EDITOR_SCALE_MAX else p; }
// A thing's kind on the wire is its model's place in the catalogue, from 1.
wbe_kind :: (mesh: int) -> int { return mesh + 1; }

// One edit of a thing, checked by WorldBuilder's rules and carried out on the edit log (inside the
// step that is open, or as a step of its own). Refused, the world is as it was.
wbe_thing :: (w: [] WbWorld, c: [] WbCat, e: WorldEdit) -> WbeTook {
  if !we_valid(e) || e.op == WE_TERRAIN { return wbe_no(WBE_NOT_EDIT); }
  if e.op == WE_CELL { return wbe_no(WBE_CELL); }
  s := wb_scene(w);
  if e.op == WE_SPAWN {
    if e.id != 0 { return wbe_no(WBE_NUMBER); }
    if e.kind > c[0].n { return wbe_no(WBE_KIND); }
    if w[0].fg[0].n >= WB_OBJECTS { w[0].full = true; return wbe_no(WBE_FULL); }
    id := editor_scene_place(s, e.kind - 1, we_m(e.x), 0, we_m(e.z), we_rad(e.yaw), cast(f32) e.scale / 100);
    if id < 0 { return wbe_no(WBE_FULL); }
    w[0].rev += 1; wb_sync(w);
    return WbeTook.{ok = true, id = id + 1};
  }
  i := editor_scene_find(s, e.id - 1);
  if i < 0 { return wbe_no(WBE_NO_THING); }
  was := w[0].objs[i];
  ok := false;
  if e.op == WE_DESPAWN { ok = editor_scene_delete(s, was.id); }
  else if e.op == WE_MOVE { ok = editor_scene_move(s, was.id, we_m(e.x), was.y, we_m(e.z)); }
  else if e.op == WE_ROTATE { ok = editor_scene_rotate(s, was.id, we_rad(e.yaw)); }
  else if e.op == WE_SCALE { ok = editor_scene_scale(s, was.id, cast(f32) e.scale / 100); }
  else if e.op == WE_SET {
    if e.col == WEC_Y { return wbe_no(WBE_HEIGHT); }
    if e.col == WEC_X || e.col == WEC_Z {
      if e.v < -WE_REACH || e.v > WE_REACH { return wbe_no(WBE_EDGE); }
      ok = editor_scene_move(s, was.id, ifx e.col == WEC_X then we_m(e.v) else was.x, was.y, ifx e.col == WEC_Z then we_m(e.v) else was.z);
    } else if e.col == WEC_YAW {
      if !we_turn_ok(e.v) { return wbe_no(WBE_TURN); }
      ok = editor_scene_rotate(s, was.id, we_rad(e.v));
    } else if e.col == WEC_KIND {
      if e.v < 1 || e.v > c[0].n { return wbe_no(WBE_KIND); }
      next := was; next.mesh = e.v - 1;
      ok = editor_scene_reshape(s, EDITOR_SCENE_MOVE, was.id, next);
    } else { return wbe_no(WBE_COLUMN); }
  }
  if !ok { return wbe_no(WBE_SAME); }
  w[0].rev += 1; wb_sync(w);
  return WbeTook.{ok = true, id = e.id};
}

// ---- the ground: a stroke is dabs between a begin and an end, and one step of the log

wbe_stroke_begin :: (w: [] WbWorld) {
  l := w[0].land[..];
  wb_land_begin(l);
  wb_land_keep(l);
  l[0].stroke = true; l[0].reach = TerrainEditRect.{};
  w[0].stroke_rev = w[0].rev;
}
// One dab: a `terrain` edit checked and carried out on the ground in place. It needs a stroke begun.
wbe_dab :: (w: [] WbWorld, e: WorldEdit) -> WbeTook {
  l := w[0].land[..];
  if !we_valid(e) || e.op != WE_TERRAIN || !l[0].stroke { return wbe_no(WBE_NOT_EDIT); }
  if e.r < WBE_R_LO || e.r > WBE_R_HI { return wbe_no(WBE_BRUSH); }
  if e.v < 1 || e.v > VP_STRENGTH_MAX { return wbe_no(WBE_PRESS); }
  half := cast(int) WB_LAND_HALF * 100;
  if e.x < -half || e.x > half || e.z < -half || e.z > half { return wbe_no(WBE_EDGE); }
  tool := e.col;
  if tool == LT_PAINT && e.mat >= WB_LAYERS { return wbe_no(WBE_MAT); }
  st := cast(f32) e.v / 100;
  x := we_m(e.x); z := we_m(e.z);
  shape := terrain_edit_disc(x, z, we_m(e.r));
  r: TerrainEditRect;
  if tool == LT_PAINT { r = wb_land_tool(l, tool, e.mat, shape, 0, st); }
  else if tool == LT_RAISE || tool == LT_LOWER { r = wb_land_tool(l, tool, 0, shape, cast(f32) WBE_LIFT_CM / 100 * st, 1); }
  else if tool == LT_SMOOTH { r = wb_land_tool(l, tool, 0, shape, 0, wb_lo(st * 0.667, 1)); }
  else { r = wb_land_tool(l, tool, 0, shape, terrain_edit_height(wb_land_edit(l), x, z), wb_lo(st * 0.333, 1)); }
  l[0].reach = terrain_edit_join(l[0].reach, r);
  w[0].rev += 1;
  return WbeTook.{ok = true};
}
// The stroke ends as one step. False when it changed nothing; when it changed more ground than
// a step keeps, the log takes it back (why: WBE_LOG) and the revision is as it was.
wbe_stroke_end :: (w: [] WbWorld) -> WbeTook {
  l := w[0].land[..];
  if !l[0].stroke { return wbe_no(WBE_SAME); }
  l[0].stroke = false;
  r := l[0].reach;
  if !r.any { w[0].rev = w[0].stroke_rev; return wbe_no(WBE_SAME); }
  // whether any sample differs: a step that is refused though one does is one too big for the log, which takes it back
  changed := false;
  for k: 0..<WB_LAND_SAMPLES {
    if l[0].heights[k] != l[0].was_h[k] || l[0].ids[k * 4] != l[0].was_ids[k * 4] || l[0].weights[k * 4] != l[0].was_w[k * 4] { changed = true; break; }
  }
  ok := editor_scene_land_step(wb_scene(w), l[0].was_h[..], l[0].was_ids[..], l[0].was_w[..], r.i0, r.j0, r.i1, r.j1);
  if ok { w[0].version += 1; wb_sync(w); return WbeTook.{ok = true}; }
  w[0].rev = w[0].stroke_rev; l[0].version += 1; wb_land_scan(l); wb_sync(w);
  return wbe_no(ifx changed then WBE_LOG else WBE_SAME);
}
// A stroke given up: the ground as it was when it began.
wbe_stroke_cancel :: (w: [] WbWorld) {
  l := w[0].land[..];
  if !l[0].stroke { return; }
  l[0].stroke = false;
  for k: 0..<WB_LAND_SAMPLES { l[0].heights[k] = l[0].was_h[k]; }
  for k: 0..<WB_LAND_SAMPLES * 4 { l[0].ids[k] = l[0].was_ids[k]; l[0].weights[k] = l[0].was_w[k]; }
  l[0].version += 1; wb_land_scan(l);
  w[0].rev = w[0].stroke_rev;
}

// ---- a batch (world.edit.v1), as the editor shell or an agent's turn sends it

WbeBatch :: struct { ok: bool; why: int; at: int = -1; edits: int; }
WbeWork :: struct { e: [WE_BATCH] WorldEdit; }
// The step kind of the log a batch's first edit makes.
wbe_step_kind :: (e: WorldEdit) -> int {
  if e.op == WE_SPAWN { return EDITOR_SCENE_PLACE; } if e.op == WE_DESPAWN { return EDITOR_SCENE_DELETE; }
  if e.op == WE_ROTATE { return EDITOR_SCENE_ROTATE; } if e.op == WE_SCALE { return EDITOR_SCENE_SCALE; }
  return EDITOR_SCENE_MOVE;
}
// Carries a batch out: fenced by the world's revision, whole or not at all, one step of the log
// (one undo takes it back). An undo or a redo walks the log; `original` removes every thing.
wbe_batch :: (w: [] WbWorld, c: [] WbCat, x: [] WbeWork, body: string) -> WbeBatch {
  b := WbeBatch.{};
  batch := we_batch_read(body, x[0].e[..]);
  if !batch.ok { b.why = WBE_BATCH; return b; }
  if batch.rev != w[0].rev { b.why = WBE_STALE; return b; }
  if batch.what == WB_PUBLISH_NOW || batch.what == WB_PUBLISH_NEXT { b.why = WBE_PUBLISH; return b; }
  if batch.what == WB_UNDO { if !wb_undo(w) { b.why = WBE_NO_UNDO; return b; } b.ok = true; return b; }
  if batch.what == WB_REDO { if !wb_redo(w) { b.why = WBE_NO_REDO; return b; } b.ok = true; return b; }
  s := wb_scene(w);
  rev := w[0].rev;
  if batch.what == WB_ORIGINAL {
    if w[0].n == 0 { b.why = WBE_EMPTY; return b; }
    editor_scene_begin(s, EDITOR_SCENE_CLEAR);
    while w[0].n > 0 {
      if !wbe_thing(w, c, WorldEdit.{ok = true, op = WE_DESPAWN, id = w[0].objs[w[0].n - 1].id + 1}).ok { break; }
      b.edits += 1;
    }
    b.ok = editor_scene_end(s);
    wb_sync(w); w[0].last_n = 0; w[0].version += 1;
    return b;
  }
  land := 0;
  for i: 0..<batch.n { if x[0].e[i].op == WE_TERRAIN { land += 1; } }
  if land > 0 && land < batch.n { b.why = WBE_MIXED; return b; }
  if land > 0 {
    wbe_stroke_begin(w);
    for i: 0..<batch.n {
      r := wbe_dab(w, x[0].e[i]);
      if !r.ok { wbe_stroke_cancel(w); b.why = r.why; b.at = i; return b; }
    }
    done := wbe_stroke_end(w);
    if !done.ok { b.why = done.why; return b; }
    b.ok = true; b.edits = batch.n;
    return b;
  }
  editor_scene_begin(s, wbe_step_kind(x[0].e[0]));
  w[0].last_n = 0;
  for i: 0..<batch.n {
    r := wbe_thing(w, c, x[0].e[i]);
    if !r.ok {
      editor_scene_cancel(s); wb_sync(w); w[0].rev = rev; w[0].last_n = 0; w[0].version += 1;
      b.why = r.why; b.at = i;
      return b;
    }
    if x[0].e[i].op != WE_DESPAWN { wb_last_add(w, r.id - 1); }
  }
  b.ok = editor_scene_end(s);
  wb_sync(w); w[0].version += 1;
  if !b.ok { b.why = WBE_SAME; w[0].rev = rev; return b; }
  b.edits = batch.n;
  return b;
}

// ---- what the editor shell is told (shell-model.coax, editor.model.v1)

// What a page keeps for the shell: the selected thing's number on the wire (0: none), the point
// last tapped, the last refusal, and the model with what it was made from.
WbePage :: struct {
  sel: int;
  here: bool; here_x: int; here_z: int;
  no: [EM_WORDS] u8; no_n: int; no_gen: int;
  model: [EM_BYTES] u8; model_n: int; model_rev: int; key: [8] int;
  x: [1] WbeWork;
}
wbe_refuse :: (p: [] WbePage, words: string) { p[0].no_n = em_copy(p[0].no[..], words); p[0].no_gen += 1; }
wbe_accept :: (p: [] WbePage) { if p[0].no_n > 0 { p[0].no_n = 0; p[0].no_gen += 1; } }
wbe_select :: (w: [] WbWorld, p: [] WbePage, id: int) { p[0].sel = ifx id > 0 && wb_index(w, id - 1) >= 0 then id else 0; }
// A model's name as a person reads it: "nature/birch-1" is "Birch 1 (nature)". "" when it does not fit a kind's name.
wbe_name :: (name: string, out: [] u8) -> string {
  slash := -1;
  for i: 0..<name.count { if name[i] == '/' { slash = i; } }
  n := 0;
  for i: slash + 1..<name.count {
    b := name[i];
    if b == '-' || b == '_' { b = ' '; }
    if n == 0 && b >= 'a' && b <= 'z' { b -= 32; }
    if n < out.count { out[n] = b; n += 1; }
  }
  if slash > 0 {
    n = ct_put(out, n, " ("); n = ct_put(out, n, name[0..<slash]); n = ct_put(out, n, ")");
  }
  if n == 0 || n > out.count || n > EM_NAME { return ""; }
  return cast(string) out[0..<n];
}
// The kinds Add offers before a world uses any: a few of each sort, by their names in the pack (one the pack lacks is left out).
WBE_STARTERS :: [27] string.["nature/commontree-1", "nature/pine-1", "nature/birch-1", "nature/cherryblossom-1", "nature/deadtree-1", "nature/giantpine-1", "nature/twistedtree-1",
  "nature/bush-common", "nature/bush-large-flowers", "nature/flower-1-group", "nature/grass-common-tall", "nature/fern-1", "nature/mushroom-redcap", "nature/rock-big-1", "nature/rock-medium-1", "nature/rockpath-round-wide",
  "fantasy-props/barrel", "fantasy-props/bench", "fantasy-props/crate-wooden", "fantasy-props/chest-wood", "fantasy-props/cauldron", "fantasy-props/anvil",
  "dungeon/woodfire", "dungeon/torch", "dungeon/statue-horse", "dungeon/column", "village/prop-woodenfence-single"];
WBE_MAT_NAMES :: [WB_LAYERS] string.["Bare grid", "Grass", "Dirt", "Sand", "Stone", "Snow", "Water"];
// The page's model, made again only when what it is made from changed. It lists the newest
// WBE_LISTED things (and the selected one), says how many the world holds and takes, and names
// the kinds those things are, then the buildings, then the starters (EM_KINDS in all), with how
// many kinds the pack has.
wbe_model :: (w: [] WbWorld, c: [] WbCat, p: [] WbePage) -> string {
  if p[0].sel > 0 && wb_index(w, p[0].sel - 1) < 0 { p[0].sel = 0; }
  key: [8] int;
  key[0] = w[0].rev; key[1] = w[0].version; key[2] = p[0].sel; key[3] = ifx p[0].here then p[0].here_x else -1; key[4] = ifx p[0].here then p[0].here_z else -1;
  key[5] = p[0].no_gen; key[6] = c[0].n; key[7] = w[0].fg[0].done * 4096 + w[0].fg[0].step_n;
  same := p[0].model_n > 0;
  for k: 0..<8 { if key[k] != p[0].key[k] { same = false; } }
  if same || (w[0].land[0].stroke && p[0].model_n > 0) { return cast(string) p[0].model[0..<p[0].model_n]; }
  p[0].key = key;
  out := p[0].model[..];
  cols: [WE_COLS] bool; cols[WEC_X] = true; cols[WEC_Z] = true; cols[WEC_YAW] = true; cols[WEC_KIND] = true;
  n := em_begin(out, WBE_ID, 0, w[0].rev, w[0].fg[0].done, w[0].fg[0].step_n - w[0].fg[0].done, p[0].sel);
  n = em_cols(out, n, cols[..]);
  // the things listed: the newest, and the selected one when it is older than those
  from := ifx w[0].n > WBE_LISTED then w[0].n - WBE_LISTED else 0;
  at_sel := ifx p[0].sel > 0 then wb_index(w, p[0].sel - 1) else -1;
  if at_sel >= 0 && at_sel < from { from += 1; } else { at_sel = -1; }
  // the kinds those things are, then the buildings, EM_KINDS at most
  kinds: [EM_KINDS] int; nk := 0; nb: [EM_NAME + 8] u8;
  starters := WBE_STARTERS;
  for pass: 0..<3 {
    lo := ifx pass == 0 then from else ifx pass == 1 then c[0].real_n else 0;
    hi := ifx pass == 0 then w[0].n else ifx pass == 1 then c[0].n else starters.count;
    for i: lo..<hi {
      m := ifx pass == 0 then w[0].objs[i].mesh else ifx pass == 1 then i else wb_find(c, starters[i]);
      if m < 0 || m >= c[0].n || nk >= EM_KINDS || wb_has(kinds[..], nk, m) { continue; }
      if wbe_name(wb_mesh_name(c, m), nb[..]).count == 0 { continue; }
      kinds[nk] = m; nk += 1;
    }
    if pass == 0 && at_sel >= 0 && nk < EM_KINDS && !wb_has(kinds[..], nk, w[0].objs[at_sel].mesh) { kinds[nk] = w[0].objs[at_sel].mesh; nk += 1; }
  }
  for k: 0..<nk { n = em_kind(out, n, wbe_kind(kinds[k]), wbe_name(wb_mesh_name(c, kinds[k]), nb[..])); }
  l := w[0].land[..];
  for pass: 0..<2 {
    lo := ifx pass == 0 then at_sel else from;
    hi := ifx pass == 0 then at_sel + 1 else w[0].n;
    if pass == 0 && at_sel < 0 { continue; }
    for i: lo..<hi {
      o := w[0].objs[i];
      n = em_entity(out, n, o.id + 1, wbe_kind(o.mesh), we_cm(o.x), we_cm(wb_land_y(l, o.x, o.z)), we_cm(o.z), we_deg(o.yaw), we_pct(o.scale));
    }
  }
  n = em_all(out, n, w[0].n, WB_OBJECTS);
  if c[0].n > nk { n = em_kinds_all(out, n, c[0].n); }
  n = em_local(out, n);
  n = em_land(out, n, WBE_R_LO, WBE_R_HI);
  mats := WBE_MAT_NAMES;
  for k: 1..<WB_LAYERS { n = em_mat(out, n, k, mats[k]); }
  n = em_mat(out, n, L_GRID, mats[L_GRID]);
  if p[0].here { n = em_here(out, n, p[0].here_x, p[0].here_z); }
  if p[0].no_n > 0 { n = em_no(out, n, cast(string) p[0].no[0..<p[0].no_n]); }
  p[0].model_n = ifx n > out.count then 0 else n;
  p[0].model_rev += 1;
  return cast(string) p[0].model[0..<p[0].model_n];
}
// The shell's batch, carried out here; a refusal goes into the next model in words.
wbe_shell_batch :: (w: [] WbWorld, c: [] WbCat, p: [] WbePage, body: string) -> bool {
  b := wbe_batch(w, c, p[0].x[..], body);
  if b.ok { wbe_accept(p); } else { wbe_refuse(p, wbe_why(b.why)); }
  return b.ok;
}
// One edit of the viewport's (a drag that moved, turned or sized the selected thing), as a step of its own.
wbe_view_edit :: (w: [] WbWorld, c: [] WbCat, p: [] WbePage, e: WorldEdit) -> bool {
  r := wbe_thing(w, c, e);
  if r.ok { wbe_accept(p); w[0].version += 1; w[0].last_n = 0; wb_last_add(w, r.id - 1); } else { wbe_refuse(p, wbe_why(r.why)); }
  return r.ok;
}

// ---- picking and the gizmo (viewport.coax)

// Every thing as a box for a pick: its footprint as it is turned and sized, as tall as its model, on the ground.
WbePick :: struct { boxes: [WB_OBJECTS * QUERY_BOX] f32; n: int; }
wbe_boxes :: (w: [] WbWorld, c: [] WbCat, k: [] WbePick) -> Colliders {
  l := w[0].land[..];
  for i: 0..<w[0].n {
    o := w[0].objs[i];
    b := c[0].box[o.mesh * 6..<o.mesh * 6 + 6];
    hx := wb_hi(wb_abs(b[0]), wb_abs(b[3])) * o.scale; hz := wb_hi(wb_abs(b[2]), wb_abs(b[5])) * o.scale;
    ex := wb_abs(cos(o.yaw)) * hx + wb_abs(sin(o.yaw)) * hz; ez := wb_abs(sin(o.yaw)) * hx + wb_abs(cos(o.yaw)) * hz;
    y := wb_land_y(l, o.x, o.z);
    at := i * QUERY_BOX;
    k[0].boxes[at] = o.x - ex; k[0].boxes[at + 1] = y; k[0].boxes[at + 2] = o.z - ez;
    k[0].boxes[at + 3] = o.x + ex; k[0].boxes[at + 4] = y + wb_hi(b[4] * o.scale, 0.3); k[0].boxes[at + 5] = o.z + ez;
  }
  k[0].n = w[0].n;
  return Colliders.{ground = -1000, boxes = k[0].boxes[0..<w[0].n * QUERY_BOX]};
}
// The thing a point of the screen picks (its number on the wire), or 0: vp_pick on the things' boxes.
wbe_pick :: (w: [] WbWorld, c: [] WbCat, k: [] WbePick, v: VpView, x: f32, y: f32) -> int {
  hit := vp_pick(wbe_boxes(w, c, k), v, x, y);
  if !hit.hit || hit.shape != QueryShape.box || hit.index < 0 || hit.index >= k[0].n { return 0; }
  return w[0].objs[hit.index].id + 1;
}
// The selected thing as the gizmo holds it (id 0: none).
wbe_held :: (w: [] WbWorld, p: [] WbePage) -> VpThing {
  i := ifx p[0].sel > 0 then wb_index(w, p[0].sel - 1) else -1;
  if i < 0 { return VpThing.{}; }
  o := w[0].objs[i];
  return VpThing.{id = p[0].sel, x = we_cm(o.x), y = we_cm(o.y), z = we_cm(o.z), yaw = we_deg(o.yaw), scale = wbe_pct(o.scale)};
}

// ---- checks

WbeTest :: struct { w: [1] WbWorld; c: [1] WbCat; p: [1] WbePage; m: [1] EdModel; scratch: [EM_BYTES] u8; pick: [1] WbePick; body: [WE_BATCH_BODY] u8; }
wbe_test :: (h: [] WbeTest) { wb_catalog(h[0].c[..], WB_TEST_CAT); }
// A batch of edits (JSON, comma apart) made from revision `rev`.
wbe_body_at :: (b: [] u8, rev: int, what: string, edits: string) -> string {
  n := ct_put(b, 0, "{\"schema\":\""); n = ct_put(b, n, WE_SCHEMA); n = ct_put(b, n, "\",\"rev\":"); n = ct_put_int(b, n, rev);
  n = ct_put(b, n, ",\"do\":\""); n = ct_put(b, n, what); n = ct_put(b, n, "\",\"edits\":["); n = ct_put(b, n, edits); n = ct_put(b, n, "]}");
  return cast(string) b[0..<n];
}
// ... made from the world's revision.
wbe_test_body :: (h: [] WbeTest, what: string, edits: string) -> string {
  return wbe_body_at(h[0].body[..], h[0].w[0].rev, what, edits);
}
wbe_test_send :: (h: [] WbeTest, what: string, edits: string) -> WbeBatch { return wbe_batch(h[0].w[..], h[0].c[..], h[0].p[0].x[..], wbe_test_body(h, what, edits)); }

#test "a thing is placed, moved, turned, sized, given another kind and removed by typed edits, each one revision, and the log takes each back" {
  h: [1] WbeTest; wbe_test(h[..]); w := h[0].w[..]; c := h[0].c[..];
  a := wbe_thing(w, c, we_read("{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":350,\"y\":0,\"z\":-1200,\"yaw\":90,\"scale\":150}"));
  #assert a.ok && a.id == 1 && w[0].n == 1 && w[0].rev == 1 && wb_mesh_name(c, w[0].objs[0].mesh) == "nature/rock-1";
  #assert wb_near(w[0].objs[0].x, 3.5, 0.001) && wb_near(w[0].objs[0].z, -12, 0.001) && wb_near(w[0].objs[0].scale, 1.5, 0.001) && wb_near(w[0].objs[0].yaw, 1.5708, 0.001);
  #assert wbe_thing(w, c, we_read("{\"op\":\"move\",\"id\":1,\"x\":500,\"y\":0,\"z\":-1200}")).ok && wb_near(w[0].objs[0].x, 5, 0.001) && w[0].rev == 2;
  #assert wbe_thing(w, c, we_read("{\"op\":\"rotate\",\"id\":1,\"yaw\":-45}")).ok && wbe_thing(w, c, we_read("{\"op\":\"scale\",\"id\":1,\"scale\":200}")).ok && w[0].rev == 4;
  #assert wbe_thing(w, c, we_read("{\"op\":\"set\",\"id\":1,\"col\":\"z\",\"v\":0}")).ok && wb_near(w[0].objs[0].z, 0, 0.001) && wb_near(w[0].objs[0].x, 5, 0.001);
  #assert wbe_thing(w, c, we_read("{\"op\":\"set\",\"id\":1,\"col\":\"yaw\",\"v\":180}")).ok && wbe_thing(w, c, we_read("{\"op\":\"set\",\"id\":1,\"col\":\"kind\",\"v\":1}")).ok;
  #assert wb_mesh_name(c, w[0].objs[0].mesh) == "nature/birch-1" && w[0].rev == 7 && w[0].fg[0].done == 7;
  #assert wbe_thing(w, c, we_read("{\"op\":\"despawn\",\"id\":1}")).ok && w[0].n == 0 && w[0].rev == 8;
  // the log takes each back, and an undo is a revision too
  #assert wb_undo(w) && w[0].n == 1 && w[0].rev == 9 && wb_undo(w) && wb_mesh_name(c, w[0].objs[0].mesh) == "nature/rock-1" && wb_redo(w) && w[0].rev == 11;
}
#test "WorldBuilder's rules refuse in words, and a refused edit changes nothing" {
  h: [1] WbeTest; wbe_test(h[..]); w := h[0].w[..]; c := h[0].c[..];
  #assert wbe_thing(w, c, we_read("{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":0,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}")).ok;
  r := wbe_thing(w, c, we_read("{\"op\":\"spawn\",\"id\":0,\"kind\":99,\"x\":0,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}"));
  #assert !r.ok && r.why == WBE_KIND && wbe_why(r.why) == "The models have no such kind.";
  #assert wbe_thing(w, c, we_read("{\"op\":\"spawn\",\"id\":5,\"kind\":2,\"x\":0,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}")).why == WBE_NUMBER;
  #assert wbe_thing(w, c, we_read("{\"op\":\"move\",\"id\":9,\"x\":1,\"y\":0,\"z\":1}")).why == WBE_NO_THING && wbe_thing(w, c, we_read("{\"op\":\"move\",\"id\":1,\"x\":0,\"y\":0,\"z\":0}")).why == WBE_SAME;
  #assert wbe_thing(w, c, we_read("{\"op\":\"set\",\"id\":1,\"col\":\"y\",\"v\":50}")).why == WBE_HEIGHT && wbe_thing(w, c, we_read("{\"op\":\"set\",\"id\":1,\"col\":\"hp\",\"v\":5}")).why == WBE_COLUMN;
  #assert wbe_thing(w, c, we_read("{\"op\":\"set\",\"id\":1,\"col\":\"yaw\",\"v\":270}")).why == WBE_TURN && wbe_thing(w, c, we_read("{\"op\":\"set\",\"id\":1,\"col\":\"kind\",\"v\":0}")).why == WBE_KIND;
  #assert wbe_thing(w, c, we_read("{\"op\":\"cell\",\"table\":\"pieces\",\"row\":1,\"col\":\"name\",\"v\":\"x\"}")).why == WBE_CELL && wbe_thing(w, c, WorldEdit.{}).why == WBE_NOT_EDIT;
  #assert wbe_thing(w, c, we_read("{\"op\":\"terrain\",\"brush\":\"raise\",\"x\":0,\"z\":0,\"r\":800,\"v\":60,\"mat\":0}")).why == WBE_NOT_EDIT;
  #assert w[0].n == 1 && w[0].rev == 1 && w[0].fg[0].done == 1 && !w[0].full;
  // every refusal has its words
  for k: 1..<23 { #assert wbe_why(k).count > 10; }
  #assert wbe_why(0) == "" && wbe_why(99) == "";
}
#test "the thing limit: a full world refuses one more in words, in a batch too, and the batch is taken back whole" #steps 4000000000 {
  h: [1] WbeTest; wbe_test(h[..]); w := h[0].w[..]; c := h[0].c[..];
  s := wb_scene(w);
  for k: 0..<WB_OBJECTS - 1 { _ := editor_scene_load(s, 1, cast(f32) (k % 64), 0, cast(f32) (k / 64), 0, 1); }
  wb_sync(w);
  #assert w[0].n == WB_OBJECTS - 1;
  one := "{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":0,\"y\":0,\"z\":900,\"yaw\":0,\"scale\":100}";
  b := wbe_test_send(h[..], "apply", "{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":0,\"y\":0,\"z\":900,\"yaw\":0,\"scale\":100},{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":0,\"y\":0,\"z\":950,\"yaw\":0,\"scale\":100}");
  #assert !b.ok && b.why == WBE_FULL && b.at == 1 && w[0].n == WB_OBJECTS - 1 && w[0].rev == 0 && w[0].fg[0].done == 0 && w[0].full;
  #assert wbe_why(b.why) == "This world is full: 4096 things at most. Delete some to add more.";
  #assert wbe_test_send(h[..], "apply", one).ok && w[0].n == WB_OBJECTS && w[0].rev == 1;
  #assert wbe_test_send(h[..], "apply", one).why == WBE_FULL && w[0].n == WB_OBJECTS;
}
#test "a batch is fenced by the revision and is one step: one undo takes all of it back; undo, redo, original and publish answer as batches" {
  h: [1] WbeTest; wbe_test(h[..]); w := h[0].w[..]; c := h[0].c[..];
  two := "{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":100,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100},{\"op\":\"spawn\",\"id\":0,\"kind\":1,\"x\":900,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}";
  b := wbe_test_send(h[..], "apply", two);
  #assert b.ok && b.edits == 2 && w[0].n == 2 && w[0].rev == 2 && w[0].fg[0].done == 1 && w[0].last_n == 2;
  // a batch made from another revision is refused whole
  stale := wbe_body_at(h[0].body[..], 1, "apply", "{\"op\":\"despawn\",\"id\":1}");
  #assert wbe_batch(w, c, h[0].p[0].x[..], stale).why == WBE_STALE && w[0].n == 2 && wbe_batch(w, c, h[0].p[0].x[..], "{}").why == WBE_BATCH;
  #assert wbe_test_send(h[..], "undo", "").ok && w[0].n == 0 && w[0].rev == 3 && wbe_test_send(h[..], "undo", "").why == WBE_NO_UNDO;
  #assert wbe_test_send(h[..], "redo", "").ok && w[0].n == 2 && w[0].rev == 4 && wbe_test_send(h[..], "redo", "").why == WBE_NO_REDO;
  // a refused edit takes the batch's earlier edits back
  mixed := wbe_test_send(h[..], "apply", "{\"op\":\"move\",\"id\":1,\"x\":300,\"y\":0,\"z\":0},{\"op\":\"move\",\"id\":7,\"x\":300,\"y\":0,\"z\":0}");
  #assert !mixed.ok && mixed.at == 1 && mixed.why == WBE_NO_THING && wb_near(w[0].objs[0].x, 1, 0.001) && w[0].rev == 4 && w[0].fg[0].done == 1;
  #assert wbe_test_send(h[..], "publish-now", "").why == WBE_PUBLISH && wbe_test_send(h[..], "publish-next", "").why == WBE_PUBLISH;
  o := wbe_test_send(h[..], "original", "");
  #assert o.ok && o.edits == 2 && w[0].n == 0 && w[0].rev == 6 && wbe_test_send(h[..], "original", "").why == WBE_EMPTY;
  #assert wb_undo(w) && w[0].n == 2;
}
#test "the ground takes terrain edits: a batch of dabs is one step, a refused dab takes the stroke back, and things and ground do not mix" #steps 4000000000 {
  h: [1] WbeTest; wbe_test(h[..]); w := h[0].w[..]; l := w[0].land[..];
  raise := "{\"op\":\"terrain\",\"brush\":\"raise\",\"x\":0,\"z\":0,\"r\":800,\"v\":100,\"mat\":0}";
  b := wbe_test_send(h[..], "apply", "{\"op\":\"terrain\",\"brush\":\"raise\",\"x\":0,\"z\":0,\"r\":800,\"v\":100,\"mat\":0},{\"op\":\"terrain\",\"brush\":\"raise\",\"x\":0,\"z\":0,\"r\":800,\"v\":100,\"mat\":0}");
  #assert b.ok && b.edits == 2 && w[0].rev == 2 && w[0].fg[0].done == 1 && !l[0].bare && wb_near(wb_land_y(l, 0, 0), 0.94, 0.02);
  // paint sand; lower; smooth; flatten: each a dab the ground takes
  #assert wbe_test_send(h[..], "apply", "{\"op\":\"terrain\",\"brush\":\"paint\",\"x\":2000,\"z\":0,\"r\":400,\"v\":100,\"mat\":3}").ok;
  at := (0 + 128) * WB_LAND_SIDE + (20 + 128);
  #assert terrain_edit_share(wb_land_edit(l), at, L_SAND) > 0.9;
  #assert wbe_test_send(h[..], "apply", "{\"op\":\"terrain\",\"brush\":\"lower\",\"x\":-3000,\"z\":0,\"r\":400,\"v\":50,\"mat\":0}").ok && wb_land_y(l, -30, 0) < -0.2;
  #assert wbe_test_send(h[..], "apply", "{\"op\":\"terrain\",\"brush\":\"smooth\",\"x\":0,\"z\":0,\"r\":800,\"v\":60,\"mat\":0}").ok;
  top := wb_land_y(l, 0, 0);
  #assert wbe_test_send(h[..], "apply", "{\"op\":\"terrain\",\"brush\":\"flatten\",\"x\":0,\"z\":0,\"r\":800,\"v\":100,\"mat\":0}").ok && wb_near(wb_land_y(l, 0, 0), top, 0.01);
  rev := w[0].rev; done := w[0].fg[0].done;
  #assert rev == 6 && done == 5;
  // refused: too wide, too hard, past the edge, no such material; a refused dab takes the stroke's earlier dabs back
  #assert wbe_test_send(h[..], "apply", "{\"op\":\"terrain\",\"brush\":\"raise\",\"x\":0,\"z\":0,\"r\":4001,\"v\":60,\"mat\":0}").why == WBE_BRUSH && wbe_test_send(h[..], "apply", "{\"op\":\"terrain\",\"brush\":\"raise\",\"x\":0,\"z\":0,\"r\":50,\"v\":60,\"mat\":0}").why == WBE_BRUSH;
  #assert wbe_test_send(h[..], "apply", "{\"op\":\"terrain\",\"brush\":\"raise\",\"x\":0,\"z\":0,\"r\":800,\"v\":101,\"mat\":0}").why == WBE_PRESS && wbe_test_send(h[..], "apply", "{\"op\":\"terrain\",\"brush\":\"raise\",\"x\":0,\"z\":0,\"r\":800,\"v\":0,\"mat\":0}").why == WBE_PRESS;
  #assert wbe_test_send(h[..], "apply", "{\"op\":\"terrain\",\"brush\":\"paint\",\"x\":0,\"z\":0,\"r\":800,\"v\":60,\"mat\":7}").why == WBE_MAT;
  far := wbe_test_send(h[..], "apply", "{\"op\":\"terrain\",\"brush\":\"raise\",\"x\":5000,\"z\":5000,\"r\":800,\"v\":100,\"mat\":0},{\"op\":\"terrain\",\"brush\":\"raise\",\"x\":12900,\"z\":0,\"r\":800,\"v\":60,\"mat\":0}");
  #assert !far.ok && far.why == WBE_EDGE && far.at == 1 && wb_land_y(l, 50, 50) == 0 && w[0].rev == rev && w[0].fg[0].done == done && !l[0].stroke;
  both := wbe_test_send(h[..], "apply", "{\"op\":\"terrain\",\"brush\":\"raise\",\"x\":0,\"z\":0,\"r\":800,\"v\":100,\"mat\":0},{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":0,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}");
  #assert both.why == WBE_MIXED && w[0].rev == rev;
  // the log takes each stroke back, the first last
  for k: 0..<5 { #assert wb_undo(w); }
  #assert l[0].bare && wb_land_y(l, 0, 0) == 0 && !wb_can_undo(w);
}
#test "the model for the shell: the world, its revision and steps, the things with their kinds' names, how many it holds and takes, its brushes and materials, here and the last refusal" {
  h: [1] WbeTest; wbe_test(h[..]); w := h[0].w[..]; c := h[0].c[..]; p := h[0].p[..]; m := h[0].m[..];
  #assert wbe_test_send(h[..], "apply", "{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":350,\"y\":0,\"z\":-1200,\"yaw\":90,\"scale\":150},{\"op\":\"spawn\",\"id\":0,\"kind\":4,\"x\":0,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}").ok;
  wbe_select(w, p, 2); p[0].here = true; p[0].here_x = 420; p[0].here_z = -75;
  text := wbe_model(w, c, p);
  #assert em_read(m, text, h[0].scratch[..]) && p[0].model_rev == 1;
  wn := m[0].world;
  #assert cast(string) wn[0..<m[0].world_n] == "create-world" && m[0].lane == 0 && m[0].rev == 2 && m[0].undo == 1 && m[0].redo == 0 && m[0].sel == 2;
  #assert m[0].cols[WEC_X] && m[0].cols[WEC_Z] && m[0].cols[WEC_YAW] && m[0].cols[WEC_KIND] && !m[0].cols[WEC_Y] && m[0].table_n == 0;
  name: [EM_NAME] u8;
  #assert m[0].ne == 2 && m[0].e_id[0] == 1 && m[0].e_kind[0] == 2 && m[0].e_x[0] == 350 && m[0].e_z[0] == -1200 && m[0].e_yaw[0] == 90 && m[0].e_scale[0] == 150;
  #assert em_kind_name(m, 2, name[..]) == "Rock 1 (nature)" && em_kind_name(m, 4, name[..]) == "House 1 (village)" && em_kind_name(m, 1, name[..]) == "Birch 1 (nature)" && m[0].nk == 3 && m[0].kinds_all == 6;
  #assert m[0].all && m[0].all_n == 2 && m[0].all_cap == WB_OBJECTS && m[0].local && m[0].land && m[0].land_lo == 100 && m[0].land_hi == 4000;
  mn := m[0].mat_name[0];
  #assert m[0].nm == WB_LAYERS && m[0].mat_id[0] == L_GRASS && cast(string) mn[0..<m[0].mat_n[0]] == "Grass" && m[0].mat_id[WB_LAYERS - 1] == L_GRID;
  #assert m[0].here && m[0].here_x == 420 && m[0].here_z == -75 && m[0].no_n == 0;
  // nothing changed: the same model, not made again
  _ := wbe_model(w, c, p);
  #assert p[0].model_rev == 1;
  // a refusal is in the next model in words, and the next change that stands takes it out
  #assert !wbe_shell_batch(w, c, p, wbe_test_body(h[..], "publish-now", ""));
  #assert em_read(m, wbe_model(w, c, p), h[0].scratch[..]) && p[0].model_rev == 2;
  no := m[0].no;
  #assert cast(string) no[0..<m[0].no_n] == "This world is kept in this browser. It has nowhere to publish to.";
  #assert wbe_shell_batch(w, c, p, wbe_test_body(h[..], "apply", "{\"op\":\"despawn\",\"id\":2}"));
  #assert em_read(m, wbe_model(w, c, p), h[0].scratch[..]) && m[0].no_n == 0 && m[0].ne == 1 && m[0].sel == 0 && m[0].rev == 3 && m[0].undo == 2;
  // a model's name as a person reads it
  #assert wbe_name("nature/birch-1", name[..]) == "Birch 1 (nature)" && wbe_name("rock", name[..]) == "Rock" && wbe_name("", name[..]) == "" && wbe_name("a-name-far-too-long-for-a-kind/and-its-folder-too", name[..]) == "";
}
#test "a world with more things than a model lists: the newest are listed, the selected one too, and the count says how many there are" #steps 4000000000 {
  h: [1] WbeTest; wbe_test(h[..]); w := h[0].w[..]; c := h[0].c[..]; p := h[0].p[..]; m := h[0].m[..];
  s := wb_scene(w);
  for k: 0..<400 { _ := editor_scene_load(s, k % 3, cast(f32) k, 0, 0, 0, 1); }
  wb_sync(w);
  #assert em_read(m, wbe_model(w, c, p), h[0].scratch[..]) && m[0].ne == WBE_LISTED && m[0].e_id[0] == 400 - WBE_LISTED + 1 && m[0].e_id[WBE_LISTED - 1] == 400 && m[0].all_n == 400;
  wbe_select(w, p, 3);
  #assert em_read(m, wbe_model(w, c, p), h[0].scratch[..]) && m[0].ne == WBE_LISTED && m[0].e_id[0] == 3 && m[0].e_id[1] == 400 - WBE_LISTED + 2 && m[0].sel == 3 && em_entity_at(m, 3) == 0;
  // a number no thing has selects nothing
  wbe_select(w, p, 999);
  #assert p[0].sel == 0;
}
#test "a pick is vp_pick on the things' boxes: the thing under the pointer, or none; the gizmo holds the selected thing in the wire's units" {
  h: [1] WbeTest; wbe_test(h[..]); w := h[0].w[..]; c := h[0].c[..]; p := h[0].p[..];
  #assert wbe_test_send(h[..], "apply", "{\"op\":\"spawn\",\"id\":0,\"kind\":4,\"x\":0,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100},{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":2000,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}").ok;
  v := VpView.{ex = 0, ey = 20, ez = 20, ax = 0, ay = 0, az = 0, fov = 0.9, w = 1000, h = 500};
  #assert wbe_pick(w, c, h[0].pick[..], v, 500, 250) == 1;
  rock := vp_project(v, 20, 0.3, 0);
  #assert rock.ok && wbe_pick(w, c, h[0].pick[..], v, rock.x, rock.y) == 2 && wbe_pick(w, c, h[0].pick[..], v, 950, 480) == 0;
  wbe_select(w, p, 2);
  t := wbe_held(w, p);
  #assert t.id == 2 && t.x == 2000 && t.z == 0 && t.scale == 100 && wbe_held(w, h[0].p[..]).yaw == 0;
  wbe_select(w, p, 0);
  #assert wbe_held(w, p).id == 0;
  // a drag's edit is a step of its own, and its refusal is words for the shell
  #assert wbe_view_edit(w, c, p, WorldEdit.{ok = true, op = WE_MOVE, id = 2, x = 2500, y = 0, z = 100}) && wb_near(w[0].objs[1].x, 25, 0.001) && w[0].fg[0].done == 2;
  #assert !wbe_view_edit(w, c, p, WorldEdit.{ok = true, op = WE_MOVE, id = 9, x = 1, y = 0, z = 1}) && cast(string) p[0].no[0..<p[0].no_n] == "No thing has that number.";
}
#test "a world kept before typed edits loads as it was: a size outside 25 to 400 percent and a turn that is no whole degree stay until that thing is edited, and it keeps the same" #steps 4000000000 {
  h: [1] WbeTest; wbe_test(h[..]); w := h[0].w[..]; c := h[0].c[..];
  old := "WB1\nnature/rock-1 1.000 -2.000 0.000 12.000\nnature/birch-1 3.000 0.000 1.234 0.100\n~H 128 120 3 81h81h81h\n";
  #assert wb_load(w, c, old) == 2 && w[0].n == 2 && w[0].objs[0].scale == 12 && wb_near(w[0].objs[1].yaw, 1.234, 0.0001) && wb_near(w[0].objs[1].scale, 0.1, 0.0001);
  #assert wb_near(wb_land_y(w[0].land[..], -7, 0), 1.2, 0.01) && !w[0].land[0].bare && !wb_can_undo(w);
  // it is kept in the same bytes
  out: [4096] u8;
  n := wb_save(w, c, out[..]);
  #assert cast(string) out[0..<n] == old;
  // a move of one thing leaves its size and the other thing as they were
  #assert wbe_thing(w, c, we_read("{\"op\":\"move\",\"id\":1,\"x\":500,\"y\":0,\"z\":-200}")).ok && w[0].objs[0].scale == 12 && wb_near(w[0].objs[1].yaw, 1.234, 0.0001);
  // the model names sizes as they are, and a size edit brings one into the edit's range
  #assert em_read(h[0].m[..], wbe_model(w, c, h[0].p[..]), h[0].scratch[..]) && h[0].m[0].e_scale[0] == 1200 && h[0].m[0].e_scale[1] == 10;
  #assert wbe_thing(w, c, we_read("{\"op\":\"scale\",\"id\":1,\"scale\":400}")).ok && w[0].objs[0].scale == 4;
}
