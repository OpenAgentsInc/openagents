// WorldBuilder (openagents.com/create-world): an empty Grid and one line to type in, bottom
// centre. What you type goes to /api/worldbuilder/act (coax/web/api/worldbuilder.c), which asks
// the model for typed edits; worldbuilder-plan.coax carries them out on Aethyrforge's scene edit
// log (metaverse-engine/editor/edit.coax), drawn here from the Quaternius pack (worldbuilder_pack.coax), each
// mesh one instanced draw. The things stand on the world's ground, an Aethyr terrain tile
// (worldbuilder-land.coax) painted and shaped by chat, and drawn from its samples in one draw. A tap
// or click on the ground says where "here" is. The chat box edits components/core/edit.coax's
// EditBuf with the site's keys (textkeys.coax), and the HUD and its buttons (SEND, FRAME, WALK,
// EDIT) are drawn by components/kit/controls.coax in the Verse skin. The world is kept in this
// browser (the slot's save, host action 4).
//
// The editor (GitHub #13422, the browser editor's E13): `?edit` (the EDIT button) opens the Metaverse
// Engine's editor shell over the page (metaverse-engine/editor/shell.coax). The page tells it the
// world as editor.model.v1 (worldbuilder-world.coax wbe_model) and takes its messages: 520 a
// world.edit.v1 batch, 521 a selection, 522 the viewport's tools, 523 a planned add. Undo, redo,
// the things' list and fields, picking, the move, turn and size drags and the land's brush are the
// shell's and the viewport's (metaverse-engine/editor/viewport.coax); this page has none of its own.
// Every edit is checked here by WorldBuilder's rules (worldbuilder-world.coax) and a refusal goes
// back in words. The chat line stays this page's: it asks WorldBuilder's own model under the day's
// shared cap, which the shell's agent strip (the /chat conversation, for an account) does not.
//
// The limits are shown, never hidden: the day's shared spend and its $50 cap, a visitor's pace
// (4 at once, then one every 1.5 s), and how many things a world holds.
//   coax/bin/coax test apps/openagents-web/worldbuilder.coax

#module "openagents.worldbuilder";

#load "../../components/core/edit.coax";
#load "../../components/kit/controls.coax";
#load "../../components/layout/flex.coax";
#load "../../components/skin/metaverse.coax";
#load "../../components/backend/gpu.coax";
#load "textkeys.coax";
#load "worldbuilder-plan.coax";
#load "../../metaverse-engine/physics/ground-query.coax";

VERTEX_FLOATS :: GP_VERTEX_FLOATS;
MAX_VERTICES :: 8192;
VIEW_AT :: 8; HERE_AT :: 24; EYE_AT :: 28; RAY_AT :: 32; BRUSH_AT :: 44; LAYERS_AT :: 48;   // BRUSH_AT: a ring on the ground (the brush, or round the selected thing)
UNIFORM_FLOATS :: 132;   // 33 vec4s (gpu/worldbuilder.bindings)

KEY_ESCAPE :: -1;   KEY_ENTER :: -2;    KEY_BACKSPACE :: -3; KEY_LEFT :: -4;
KEY_RIGHT :: -5;    KEY_UP :: -6;       KEY_DOWN :: -7;      KEY_HOME :: -8;
KEY_END :: -9;      KEY_DELETE :: -12;   KEY_TAB :: -15;
MOD_SHIFT :: 1; MOD_CTRL :: 2; MOD_ALT :: 4; MOD_META :: 8;
POINTER_DOWN :: 0; POINTER_MOVE :: 1; POINTER_UP :: 2; POINTER_CANCEL :: 3;

MSG_TEXT :: 1;          // typed or pasted text, UTF-8
MSG_SLOT :: 4;          // host.js: the slot's save, given back on a visit
MSG_PACK :: 605;
MSG_HTTP :: 512;        // host.js: answer to request id as message 512 + id
MSG_BATCH :: 520;       // the editor shell's: a world.edit.v1 batch
MSG_SELECT :: 521;      // ... the thing to select
MSG_VIEW :: 522;        // ... the viewport's tools, as words (viewport.coax vp_act)
MSG_PLAN :: 523;        // ... "add KIND COUNT": several of a kind planned from the point last tapped
MSG_ROOM :: 525;        // host.js: the part of the window the shell's panes leave free, "X0 Y0 X1 Y1" in CSS pixels
MSG_PAGE :: 600;        // host.js: the page's facts, the address among them
ACT_GO :: 1;            // host.js: go to a page of the site
ACT_KEEP :: 4;
EDIT_URL :: "/create-world?edit";
DAB_S :: 0.033333335;   // seconds between a held brush's dabs
INSTANCE_FLOATS :: 16;
WB_INSTANCES :: 12288;  // pieces drawn: a building is a dozen or so
TYPED :: 300;
REPLY :: 200;
BODY :: 15000;
SAVE_CAP :: 1310720;    // a kept world's text at most: its things, then its ground (worldbuilder-face.c's inbox holds as much)
ACT_URL :: "/api/worldbuilder/act";
STATUS_URL :: "/api/worldbuilder/status";
RECENT :: 24;
PRESENT :: 60;
FOV :: 0.9;
PITCH_LO :: 0.18; PITCH_HI :: 1.45;
DIST_LO :: 3.0; DIST_HI :: 160.0; DIST_FAR :: 420.0;   // the nearest view, the farthest of a small scene, and of any
FRAME_WAIT :: 4.0;      // seconds after the person moves the view before a command may frame it again
TAP_SLOP :: 8.0;        // CSS pixels a press may move and still be a tap
DOUBLE_S :: 0.35;       // seconds between clicks of a double or triple click

HIT_BUTTON :: 1;
HIT_FIELD :: 2;
BTN_SEND :: 0; BTN_FRAME :: 3; BTN_VIEW :: 4; BTN_EDIT :: 5;
REPLY_PLAIN :: 0; REPLY_NOTICE :: 1;

WB_UNDER :: 256; WB_OVER :: 256; WB_LINES :: 48; WB_HITS :: 40; WB_POOL :: 2048;

WorldBuilder :: struct {
  started: bool;
  time: f32; width: f32; height: f32; dpr: f32; still: bool; golden: bool;
  // the camera: it looks at (tx, tz) from dist away, turned yaw (0 looks along -z), pitch down
  tx: f32; tz: f32; gx: f32; gz: f32; yaw: f32; pitch: f32 = 0.6; dist: f32 = 26;
  ty: f32;                            // the ground's height under what it looks at
  // the walk (worldbuilder-walk.coax, #13225): your character on the ground under Everglade's follow
  // camera. The page that holds the zone says each frame whether a character is there (walk_ok),
  // where it stands and where the follow camera is; `walk` is which view has the screen (Tab, or the
  // WALK and OVERVIEW button). In the walk the keys are the character's until the chat box takes them
  // (Enter or a click on it; Escape or sending gives them back).
  walk: bool = true; walk_ok: bool; typing: bool;
  cam_eye: [3] f32; cam_fwd: [3] f32; cam_yaw: f32;   // the follow camera: its eye, the way it looks, and that as a yaw (0 looks along -z)
  me_x: f32; me_z: f32; me_face: f32;
  stick_on: bool; stick: [4] f32;     // a phone's thumb stick to draw: its middle and its knob, device pixels
  goal_dist: f32 = 26; framing: bool; // a frame eases the distance too, until the person moves the view
  moved_at: f32 = -100;               // when the person last turned, zoomed or tapped the view
  // pointers: one drags the view or selects in the chat box, two pinch the view nearer
  down: bool; down_id: int; down_x: f32; down_y: f32; last_x: f32; last_y: f32; moved: bool;
  down_kind: int; down_btn: int = -1; hover_kind: int; hover_btn: int = -1; hover_b: int = -1; press_btn: int = -1;
  // the editor (?edit): the shell is over the page. The viewport's tools (viewport.coax) take the
  // pointer while one is picked; `ep` is what the shell is told; `room` is the part of the window
  // its panes leave free (logical pixels), where this page's own HUD goes
  edit: bool; vp: [1] Viewport; vview: VpView; vkeys: [6] bool;
  ep: [1] WbePage; pick: [1] WbePick;
  room: [4] f32; room_on: bool;
  go_edit: bool;                      // EDIT was pressed: go once the world is kept
  drag_key: int;                      // what the scene was last drawn for while a thing is dragged
  plan_body: [8192] u8;               // a planned add's batch
  // the land's brush (the viewport's): where it is on the ground, the stroke under way, and the time to its next dab
  brush_x: f32; brush_z: f32; brush_shown: bool; stroking: bool; dab_wait: f32;
  two: bool; two_id: int; two_x: f32; two_y: f32; pinch: f32;
  // "here": the spot last tapped
  has_here: bool; here_x: f32; here_z: f32; here_at: f32;
  // the chat box (components/core/edit.coax), the words sent while waiting, the one line answered
  ed: [1] EditBuf;
  ed_scroll: f32; ed_follow: bool; ed_text_x: f32; ed_text_w: f32;
  text_undo_live: bool; caret_at: f32;
  click_at: f32 = -10; click_x: f32; clicks: int; drag_unit: int; drag_from: int; drag_to: int;
  heard: [TYPED] u8; heard_n: int;
  reply: [REPLY] u8; reply_n: int; reply_kind: int; reply_at: f32;
  waiting: bool; act_id: int = -1; status_id: int = -1; want_status: bool = true;
  // the request the face hands to the host
  req_url: [64] u8; req_url_n: int; req_body: [BODY] u8; req_body_n: int; req_ready: bool; req_flags: int; req_what: int;
  // the limits: the day's spend and cap (millionths of a dollar), resting, the pace
  spent: int; cap: int = 50000000; known: bool; resting: bool; flood_until: f32;
  // the world and the pack
  world: [1] WbWorld; cat: [1] WbCat; cat_ready: bool; pack_failed: bool; loaded: int; total: int;
  saved: [SAVE_CAP] u8; saved_n: int; saved_waiting: bool; saved_version: int;
  outbox: [SAVE_CAP] u8; out_n: int; action: int;
  drawn_version: int = -1;
  draws: [(WB_MESHES + 1) * 4] u32; draw_n: int;
  objects: [WB_INSTANCES * INSTANCE_FLOATS] f32; inst_n: int;
  view: [16] f32; eye: [3] f32; fwd: [3] f32; right: [3] f32; up: [3] f32;
  // the glyph and icon atlas (coax/web/gpui.js) and the control kit's sheet
  atlas: [1] Atlas;
  scratch: [9800] f32; sbytes: [64] u8;
  under: [WB_UNDER] Prim; over: [WB_OVER] Prim; lines: [WB_LINES] SheetLine; hits: [WB_HITS] SheetHit; pool: [WB_POOL] u8;
  nu: int; no: int; nh: int;
  field: [4] f32;
  // the ground as the GPU keeps it (wb_land_gpu), and the versions the face sends the stores by
  ground: [WB_LAND_SAMPLES * 4] f32; ground_seen: int = -1; ground_version: int;
  land_seated: int = -1;              // the ground version the things were last seated on
  scene_version: int;
  fx: [1] FxTree;                     // the top's layout (wb_top_layout)
}
REQ_ACT :: 1; REQ_STATUS :: 2;

ease :: (x: f32) -> f32 { t := clamp(x, 0, 1); return t * t * (3 - 2 * t); }
lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 { return lo(high, hi(low, a)); }
most_i :: (a: int, b: int) -> int { if a > b { return a; } return b; }
clamp_i :: (a: int, low: int, high: int) -> int { return ifx a < low then low else ifx a > high then high else a; }

put :: (buf: [] u8, at: int, text: string) -> int {
  n := at;
  for i: 0..<text.count { if n >= buf.count { break; } buf[n] = text[i]; n += 1; }
  return n;
}
put_int :: (buf: [] u8, at: int, v: int) -> int {
  digits: [20] u8; n := 0; x := most_i(v, 0);
  while true { digits[n] = cast(u8) (48 + x % 10); n += 1; x /= 10; if x == 0 { break; } }
  k := at;
  while n > 0 && k < buf.count { n -= 1; buf[k] = digits[n]; k += 1; }
  return k;
}
trim_from :: (text: string) -> int { i := 0; while i < text.count && text[i] == ' ' { i += 1; } return i; }
trim_to :: (text: string) -> int { j := text.count; while j > 0 && text[j - 1] == ' ' { j -= 1; } return j; }
same_word :: (a: string, b: string) -> bool {
  if a.count != b.count { return false; }
  for i: 0..<a.count {
    ca := ifx a[i] >= 'A' && a[i] <= 'Z' then a[i] + 32 else a[i];
    cb := ifx b[i] >= 'A' && b[i] <= 'Z' then b[i] + 32 else b[i];
    if ca != cb { return false; }
  }
  return true;
}

// ---- in from the host

wb_begin :: (s: [] WorldBuilder) {
  if s[0].started { return; }
  s[0].started = true;
  s[0].world[0].seed = 13207;
}

int_of :: (t: string) -> int { at: [1] int; v := wb_int_at(t, at[..]); return ifx at[0] < 0 then -1 else v; }
// The answer's status line: "STATUS\n" then the body.
status_of :: (t: string) -> int { e := 0; while e < t.count && t[e] != '\n' { e += 1; } return int_of(t[0..<e]); }
body_of :: (t: string) -> string { e := 0; while e < t.count && t[e] != '\n' { e += 1; } return ifx e + 1 <= t.count then t[e + 1..<t.count] else ""; }

set_reply :: (s: [] WorldBuilder, text: string, kind: int) {
  s[0].reply_n = put(s[0].reply[..], 0, text); s[0].reply_kind = kind; s[0].reply_at = s[0].time;
}
// The words sent come back to the edit buffer when they weren't carried out, to send again.
give_back :: (s: [] WorldBuilder) {
  if s[0].ed[0].n == 0 && s[0].heard_n > 0 {
    eb_set(s[0].ed[..], cast(string) s[0].heard[0..<s[0].heard_n]);
    s[0].ed_follow = true;
  }
  s[0].heard_n = 0;
}

// Inserts or pastes single-line UTF-8 text into the edit buffer, capped at TYPED bytes on whole code points.
ed_receive :: (s: [] WorldBuilder, text: string, paste_step: bool) {
  e := s[0].ed[..];
  e[0].clock = s[0].time;
  clean: [TYPED] u8; n := 0;
  room := TYPED - (e[0].n - (eb_sel_hi(e) - eb_sel_lo(e)));
  if room <= 0 { return; }
  i := 0;
  while i < text.count {
    r := rune_at(text, i);
    if r.code == '\n' || r.code == '\r' || r.code == '\t' {
      if n + 1 > room { break; }
      clean[n] = ' '; n += 1;
    } else if r.code >= 32 && r.code != 127 {
      if n + r.len > room || n + r.len > clean.count { break; }
      for k: 0..<r.len { clean[n + k] = text[i + k]; }
      n += r.len;
    }
    i += r.len;
  }
  if n == 0 { return; }
  piece := cast(string) clean[0..<n];
  s[0].text_undo_live = true; s[0].ed_follow = true; s[0].caret_at = s[0].time;
  if paste_step && !eb_one_char(piece) { _ = eb_paste(e, piece); }
  else { _ = eb_insert(e, piece); }
}

// The character has the view and the ground under it.
walking :: (s: [] WorldBuilder) -> bool { return s[0].walk && s[0].walk_ok; }
worldbuilder_walking :: (s: [] WorldBuilder) -> bool #export_c #effects(all) { return walking(s); }
// The player's hands reach the world: no editor, or its tool is Play with the camera not flying (viewport.coax vp_hands).
hands :: (s: [] WorldBuilder) -> bool { return !s[0].edit || vp_hands(s[0].vp[..]); }
// The keys are the character's: walking, the chat box hasn't taken them, and no tool of the editor's is picked.
worldbuilder_roams :: (s: [] WorldBuilder) -> bool #export_c #effects(all) { return walking(s) && !s[0].typing && hands(s); }
// The time the world runs this frame: the frame's own, or what the editor's clock gives (pause and step).
worldbuilder_run_dt :: (s: [] WorldBuilder, dt: f32) -> f32 #export_c #effects(all) { return ifx s[0].edit then vp_run_dt(s[0].vp[..], dt) else dt; }
// Where "here" is for an edit. Walking, it is where your character stands, the view's middle a few
// metres ahead of it, and left, right, front and behind follow the camera behind it.
wb_view :: (s: [] WorldBuilder) -> PlaceView {
  if walking(s) {
    fx := s[0].cam_fwd[0]; fz := s[0].cam_fwd[2];
    fl := sqrt(fx * fx + fz * fz);
    if fl < 0.0001 { fx = 0; fz = -1; fl = 1; }
    return PlaceView.{has_here = true, here_x = s[0].me_x, here_z = s[0].me_z, view_x = s[0].me_x + fx / fl * 6, view_z = s[0].me_z + fz / fl * 6, yaw = s[0].cam_yaw, walker = true};
  }
  return PlaceView.{has_here = s[0].has_here, here_x = s[0].here_x, here_z = s[0].here_z, view_x = s[0].gx, view_z = s[0].gz, yaw = s[0].yaw};
}

take_act :: (s: [] WorldBuilder, text: string) {
  s[0].waiting = false; s[0].act_id = -1;
  st := status_of(text); body := body_of(text);
  if st == 200 {
    sum := wb_answer(s[0].world[..], s[0].cat[..], wb_view(s), body);
    // the view frames what was built, unless the person moved it a moment ago
    if (sum.placed > 0 || sum.changed > sum.ground) && s[0].world[0].n > 0 && s[0].time - s[0].moved_at > FRAME_WAIT && !walking(s) { frame_all(s); }
    s[0].heard_n = 0;
    s[0].text_undo_live = false;
    if sum.say_n > 0 { set_reply(s, cast(string) sum.say[0..<sum.say_n], REPLY_PLAIN); }
    else if sum.edits == 0 { set_reply(s, "Nothing changed.", REPLY_PLAIN); }
    else { s[0].reply_n = 0; }
    if s[0].world[0].full { set_reply(s, "This world is full: 4096 things at most. Delete some to add more.", REPLY_NOTICE); }
    s[0].want_status = true;
    return;
  }
  give_back(s);
  if st == 429 && body.count >= 5 && body[0..<5] == "flood" {
    wait := int_of(body[5..<body.count]);
    s[0].flood_until = s[0].time + cast(f32) (ifx wait > 0 then wait else 1500) / 1000;
    set_reply(s, "Too fast for the shared line.", REPLY_NOTICE);
    return;
  }
  if st == 429 { s[0].resting = true; set_reply(s, "", REPLY_NOTICE); return; }
  set_reply(s, "That didn't go through. Send it again.", REPLY_NOTICE);
}
take_status :: (s: [] WorldBuilder, text: string) {
  s[0].status_id = -1;
  if status_of(text) != 200 { return; }
  b := body_of(text);
  at: [1] int;
  w := 0; while w < b.count && b[w] != ' ' { w += 1; }
  at[0] = w;
  spent := wb_int_at(b, at[..]); if at[0] < 0 { return; }
  cap := wb_int_at(b, at[..]); if at[0] < 0 || cap <= 0 { return; }
  s[0].spent = spent; s[0].cap = cap; s[0].known = true;
  s[0].resting = b[0..<w] == "resting";
}
load_saved :: (s: [] WorldBuilder) {
  if !s[0].saved_waiting || !s[0].cat_ready { return; }
  s[0].saved_waiting = false;
  n := wb_load(s[0].world[..], s[0].cat[..], cast(string) s[0].saved[0..<s[0].saved_n]);
  s[0].saved_version = s[0].world[0].version;
}

worldbuilder_message :: (s: [] WorldBuilder, kind: int, text: string) #export_c #effects(all) {
  wb_begin(s);
  if kind == MSG_PACK {
    at: [1] int;
    s[0].loaded = wb_int_at(text, at[..]); if at[0] < 0 { return; }
    s[0].total = wb_int_at(text, at[..]); if at[0] < 0 { s[0].total = 0; }
    return;
  }
  if kind == MSG_TEXT {
    if worldbuilder_wants_text(s) { ed_receive(s, text, true); }
    return;
  }
  // the page's address: ?edit opens the editor's shell over it (coax/web/host.js)
  if kind == MSG_PAGE { s[0].edit = has(text, "?edit") || has(text, "&edit"); return; }
  if kind == MSG_ROOM { take_room(s, text); return; }
  if kind >= MSG_BATCH && kind <= MSG_PLAN { if s[0].edit { take_shell(s, kind, text); } return; }
  if kind == MSG_SLOT {
    s[0].saved_n = put(s[0].saved[..], 0, text); s[0].saved_waiting = true;
    load_saved(s);
    return;
  }
  if kind >= MSG_HTTP && kind < MSG_HTTP + 8 {
    id := kind - MSG_HTTP;
    if id == s[0].act_id { take_act(s, text); }
    else if id == s[0].status_id { take_status(s, text); }
  }
}
// The part of the window the shell's panes leave free: this page's own HUD is laid out inside it.
take_room :: (s: [] WorldBuilder, text: string) {
  at: [1] int; v: [4] int;
  for k: 0..<4 { v[k] = wb_int_at(text, at[..]); if at[0] < 0 { return; } }
  if v[2] - v[0] < 120 || v[3] - v[1] < 120 { s[0].room_on = false; return; }   // no room worth the name: the whole window
  for k: 0..<4 { s[0].room[k] = cast(f32) v[k]; }
  s[0].room_on = true;
}
// The editor shell's messages (metaverse-engine/editor/shell.coax): a batch of edits, a selection, the
// viewport's tools, a planned add. An edit is checked here by WorldBuilder's rules; a refusal goes back in the model.
take_shell :: (s: [] WorldBuilder, kind: int, text: string) {
  w := s[0].world[..]; c := s[0].cat[..]; p := s[0].ep[..]; vp := s[0].vp[..];
  if kind == MSG_SELECT { at: [1] int; id := wb_int_at(text, at[..]); wbe_select(w, p, ifx at[0] < 0 then 0 else id); return; }
  if kind == MSG_VIEW {
    was := vp[0].tool;
    if vp_act(vp, text, s[0].vview) && was == VT_LAND && vp[0].tool != VT_LAND { stroke_end(s); s[0].brush_shown = false; }
    return;
  }
  if !s[0].cat_ready { return; }
  // a command to the model is out, or a stroke is under way: the world is about to change under the batch
  if s[0].waiting || s[0].stroking { wbe_refuse(p, "The last change is still on its way. Try again."); return; }
  s[0].text_undo_live = false;
  if kind == MSG_BATCH { if wbe_shell_batch(w, c, p, text) { s[0].reply_n = 0; } return; }
  // "add KIND COUNT": several of a kind, planned from the point last tapped clear of what stands (place.coax pl_plan), as one batch
  if kind == MSG_PLAN && ct_part(text, ' ', 0) == "add" && ct_parts(text, ' ') == 3 {
    k := ct_num(ct_part(text, ' ', 1)); n := ct_num(ct_part(text, ' ', 2));
    if !k.ok || !n.ok || k.v < 1 || k.v > c[0].n || n.v < 1 || n.v > WE_BATCH || !p[0].here { return; }
    for i: 0..<w[0].n { w[0].plan[i] = wb_stood(w, c, i); }
    out: [WE_BATCH] PlaceOut; edits: [WE_BATCH] WorldEdit;
    spot := PlaceSpot.{x = cast(f32) p[0].here_x / 100, z = cast(f32) p[0].here_z / 100, ok = true};
    made := pl_plan(wb_kind(c, k.v - 1), spot, wb_view(s), PlaceAsk.{count = n.v, nudge = true, clear = true, seed = w[0].seed + w[0].version * 7919}, w[0].plan[0..<w[0].n], out[..]);
    for i: 0..<made { edits[i] = WorldEdit.{ok = true, op = WE_SPAWN, id = 0, kind = k.v, x = vp_cm(out[i].x), z = vp_cm(out[i].z), yaw = vp_wrap(we_deg(out[i].yaw)), scale = wbe_pct(out[i].scale)}; }
    if made > 0 && wbe_shell_batch(w, c, p, we_batch_write(w[0].rev, WB_APPLY, edits[..], made, s[0].plan_body[..])) { s[0].reply_n = 0; }
  }
}
// What the editor shell is told (worldbuilder-world.coax wbe_model, editor.model.v1), and a count that changes when it does.
worldbuilder_edit_model :: (s: [] WorldBuilder) -> string #export_c #effects(all) { return ifx s[0].edit && s[0].cat_ready then wbe_model(s[0].world[..], s[0].cat[..], s[0].ep[..]) else ""; }
worldbuilder_edit_rev :: (s: [] WorldBuilder) -> int #export_c #effects(all) {
  if !s[0].edit || !s[0].cat_ready { return 0; }
  _ := wbe_model(s[0].world[..], s[0].cat[..], s[0].ep[..]);
  return s[0].ep[0].model_rev;
}
worldbuilder_catalog :: (s: [] WorldBuilder, text: string) #export_c #effects(all) {
  wb_begin(s);
  wb_catalog(s[0].cat[..], text);
  s[0].cat_ready = s[0].cat[0].n > 0;
  s[0].drawn_version = -1;
  load_saved(s);
}
worldbuilder_pack_failed :: (s: [] WorldBuilder) #export_c #effects(all) { if !s[0].cat_ready { s[0].pack_failed = true; } }

// ---- out to the host: the request (the face hands it over), the save

put_json_text :: (b: [] u8, at: int, t: string) -> int {
  n := put(b, at, "\"");
  for i: 0..<t.count {
    c := t[i];
    if c == '"' || c == '\\' { n = put(b, n, "\\"); }
    if c >= 32 && n < b.count { b[n] = c; n += 1; }
  }
  return put(b, n, "\"");
}
// The page's turn for the model: what was typed, here, the camera, what the world holds, the
// newest things and what the last edit touched (coax/web/api/worldbuilder.c WB_SYSTEM reads it).
build_act :: (s: [] WorldBuilder, words: string) -> int {
  b := s[0].req_body[..]; w := s[0].world[..]; c := s[0].cat[..];
  n := put(b, 0, "{\"text\":"); n = put_json_text(b, n, words);
  // here, the camera and the way it looks, as the edits will read them (wb_view): walking, here is
  // where your character stands and the camera is the follow camera behind it
  v := wb_view(s);
  n = put(b, n, ",\"walking\":"); n = put(b, n, ifx v.walker then "true" else "false");
  n = put(b, n, ",\"here\":");
  if v.has_here { n = put(b, n, "["); n = wb_put_num(b, n, v.here_x); n = put(b, n, ","); n = wb_put_num(b, n, v.here_z); n = put(b, n, "]"); }
  else { n = put(b, n, "null"); }
  n = put(b, n, ",\"cam\":{\"x\":"); n = wb_put_num(b, n, ifx v.walker then s[0].cam_eye[0] else s[0].gx); n = put(b, n, ",\"z\":"); n = wb_put_num(b, n, ifx v.walker then s[0].cam_eye[2] else s[0].gz);
  n = put(b, n, ",\"looks\":["); n = wb_put_num(b, n, sin(v.yaw)); n = put(b, n, ","); n = wb_put_num(b, n, -cos(v.yaw)); n = put(b, n, "]}");
  // what the world holds: each asset and how many
  n = put(b, n, ",\"present\":{");
  counts: [WB_MESHES] int;
  for i: 0..<w[0].n { counts[w[0].objs[i].mesh] += 1; }
  shown := 0;
  for m: 0..<c[0].n {
    if counts[m] == 0 || shown >= PRESENT { continue; }
    if shown > 0 { n = put(b, n, ","); }
    n = put_json_text(b, n, wb_mesh_name(c, m)); n = put(b, n, ":"); n = put_int(b, n, counts[m]);
    shown += 1;
  }
  n = put(b, n, "},\"recent\":[");
  from := ifx w[0].n > RECENT then w[0].n - RECENT else 0;
  for i: from..<w[0].n {
    o := w[0].objs[i];
    if i > from { n = put(b, n, ","); }
    n = put(b, n, "{\"id\":"); n = put_int(b, n, o.id); n = put(b, n, ",\"asset\":"); n = put_json_text(b, n, wb_mesh_name(c, o.mesh));
    n = put(b, n, ",\"x\":"); n = wb_put_num(b, n, o.x); n = put(b, n, ",\"z\":"); n = wb_put_num(b, n, o.z);
    n = put(b, n, ",\"size\":"); n = wb_put_num(b, n, o.scale); n = put(b, n, "}");
  }
  n = put(b, n, "],\"last\":[");
  seen: [WB_MESHES] bool; first := true;
  for k: 0..<w[0].last_n {
    i := wb_index(w, w[0].last[k]);
    if i < 0 || seen[w[0].objs[i].mesh] { continue; }
    seen[w[0].objs[i].mesh] = true;
    if !first { n = put(b, n, ","); }
    first = false;
    n = put_json_text(b, n, wb_mesh_name(c, w[0].objs[i].mesh));
  }
  n = put(b, n, "]}");
  return n;
}
ask :: (s: [] WorldBuilder, url: string, body_n: int, flags: int, what: int) {
  s[0].req_url_n = put(s[0].req_url[..], 0, url);
  s[0].req_body_n = body_n; s[0].req_flags = flags; s[0].req_ready = true; s[0].req_what = what;
}
// The face hands the request to the host and gives its id back here.
worldbuilder_requested :: (s: [] WorldBuilder, id: int) #export_c #effects(all) {
  s[0].req_ready = false;
  if s[0].req_what == REQ_ACT {
    if id < 0 { s[0].waiting = false; give_back(s); set_reply(s, "That didn't go through. Send it again.", REPLY_NOTICE); return; }
    s[0].act_id = id;
  } else { s[0].status_id = id; }
}
can_send :: (s: [] WorldBuilder) -> bool {
  return s[0].cat_ready && !s[0].waiting && !s[0].resting && s[0].time >= s[0].flood_until && !s[0].req_ready;
}

undo :: (s: [] WorldBuilder) {
  if s[0].waiting || s[0].stroking { return; }
  s[0].text_undo_live = false;
  if wb_undo(s[0].world[..]) { s[0].reply_n = 0; } else { set_reply(s, "Nothing to undo.", REPLY_PLAIN); }
}
redo :: (s: [] WorldBuilder) {
  if s[0].waiting || s[0].stroking { return; }
  s[0].text_undo_live = false;
  if wb_redo(s[0].world[..]) { s[0].reply_n = 0; } else { set_reply(s, "Nothing to redo.", REPLY_PLAIN); }
}

send_typed :: (s: [] WorldBuilder) {
  raw := eb_text(s[0].ed[..]);
  a := trim_from(raw); z := trim_to(raw);
  if z <= a { return; }
  words := cast(string) raw[a..<z];
  // "undo" and "redo" by chat run straight against the forge edit log: instant and free.
  if same_word(words, "undo") {
    if s[0].waiting { return; }
    eb_clear(s[0].ed[..]); s[0].ed_scroll = 0;
    undo(s);
    return;
  }
  if same_word(words, "redo") {
    if s[0].waiting { return; }
    eb_clear(s[0].ed[..]); s[0].ed_scroll = 0;
    redo(s);
    return;
  }
  if !can_send(s) { return; }
  s[0].heard_n = put(s[0].heard[..], 0, words);
  n := build_act(s, words);
  eb_clear(s[0].ed[..]); s[0].ed_scroll = 0; s[0].text_undo_live = false;
  s[0].reply_n = 0;
  s[0].waiting = true;
  s[0].typing = false;   // sent: walking, the keys are the character's again
  ask(s, ACT_URL, n, 1 | 4, REQ_ACT);
}

// Once a frame: ask for the day's spend when it is wanted and nothing else is going.
pump :: (s: [] WorldBuilder) {
  if s[0].want_status && !s[0].req_ready && s[0].status_id < 0 {
    s[0].want_status = false;
    ask(s, STATUS_URL, 0, 4, REQ_STATUS);
  }
  // keep the world in this browser after every change
  v := s[0].world[0].version;
  if v != s[0].saved_version && s[0].action == 0 && s[0].cat_ready && !s[0].saved_waiting {
    s[0].saved_version = v;
    s[0].out_n = wb_save(s[0].world[..], s[0].cat[..], s[0].outbox[..]);
    s[0].action = ACT_KEEP;
    if s[0].world[0].unkept { set_reply(s, "This ground is too detailed to keep in this browser: its things are kept, its ground isn't.", REPLY_NOTICE); }
  }
  // EDIT: the page opens again with the editor's shell over it, once the world is kept (it comes back from the slot)
  if s[0].go_edit && s[0].action == 0 && v == s[0].saved_version && !s[0].waiting {
    s[0].go_edit = false;
    s[0].out_n = put(s[0].outbox[..], 0, EDIT_URL); s[0].action = ACT_GO;
  }
}
worldbuilder_action :: (s: [] WorldBuilder) -> int #export_c #effects(all) { a := s[0].action; s[0].action = 0; return a; }
worldbuilder_action_done :: (s: [] WorldBuilder) #export_c #effects(all) { s[0].out_n = 0; }
// The chat box has the keyboard: not while the character roams, and not while the editor's camera flies unless the box was pressed.
worldbuilder_wants_text :: (s: [] WorldBuilder) -> bool #export_c #effects(all) { return !worldbuilder_roams(s) && !(flying(s) && !s[0].typing); }
flying :: (s: [] WorldBuilder) -> bool { return s[0].edit && s[0].vp[0].fly; }

// ---- keys and the pointer

ed_step :: (s: [] WorldBuilder, to: int, extend: bool) {
  if extend { eb_select_to(s[0].ed[..], to); } else { eb_move_to(s[0].ed[..], to); }
  s[0].ed_follow = true; s[0].caret_at = s[0].time;
}

worldbuilder_key :: (s: [] WorldBuilder, key: int, down: bool, mods: int) -> bool #export_c #effects(all) {
  wb_begin(s);
  // the editor's camera flies: W, S, A and D move it, Q lowers and E raises it, until the chat box takes the keys
  if flying(s) && !s[0].typing && (mods & (MOD_CTRL | MOD_META)) == 0 {
    names := "wsadqe"; caps := "WSADQE";
    for i: 0..<6 { if key == cast(int) names[i] || key == cast(int) caps[i] { s[0].vkeys[i] = down; return true; } }
  }
  if !down { return false; }
  e := s[0].ed[..];
  e[0].clock = s[0].time;
  // Tab: the walk or the overview
  if key == KEY_TAB { toggle_view(s); return true; }
  // walking, the keys are the character's (the page that holds the zone gives it what comes back
  // unused); Enter gives them to the chat box, and Cmd or Ctrl keys stay the page's
  if worldbuilder_roams(s) {
    if key == KEY_ENTER { s[0].typing = true; s[0].caret_at = s[0].time; return true; }
    if (mods & (MOD_CTRL | MOD_META)) == 0 { return false; }
  }
  shift := (mods & MOD_SHIFT) != 0;
  meta := (mods & MOD_META) != 0;
  word_mod := (mods & MOD_ALT) != 0 || ((mods & MOD_CTRL) != 0 && !meta);

  // Cmd/Ctrl+Z, Cmd/Ctrl+Shift+Z and Cmd/Ctrl+Y: edit buffer undo/redo while editing text, else world undo/redo.
  if key > 0 && (mods & (MOD_CTRL | MOD_META)) != 0 && (mods & MOD_ALT) == 0 {
    lower := ifx key >= 'A' && key <= 'Z' then key + 32 else key;
    if lower == 'z' && !shift {
      if s[0].text_undo_live && eb_can_undo(e) { _ = eb_undo(e); s[0].ed_follow = true; s[0].caret_at = s[0].time; }
      else { undo(s); }
      return true;
    }
    if (lower == 'z' && shift) || (lower == 'y' && !shift) {
      if s[0].text_undo_live && eb_can_redo(e) { _ = eb_redo(e); s[0].ed_follow = true; s[0].caret_at = s[0].time; }
      else { redo(s); }
      return true;
    }
  }

  // Cmd/Ctrl+. frames everything built (the FRAME button's key)
  if key == '.' && (mods & (MOD_CTRL | MOD_META)) != 0 { frame_all(s); return true; }

  // Cmd or Ctrl: the keys every typed box on the site shares (textkeys.coax)
  cmd := tk_command(key, mods);
  if cmd == TK_ALL {
    eb_select_all(e);
    s[0].text_undo_live = true; s[0].caret_at = s[0].time;
    return true;
  }
  if cmd == TK_COPY || cmd == TK_CUT {
    has_sel := eb_sel_hi(e) > eb_sel_lo(e);
    text := ifx has_sel then eb_selected(e) else ifx e[0].n > 0 then eb_text(e) else cast(string) s[0].reply[0..<s[0].reply_n];
    if text.count == 0 { return true; }
    if s[0].action == ACT_KEEP { s[0].saved_version = -1; }   // a save not yet taken is made again next frame
    s[0].out_n = tk_copy(s[0].outbox[..], text); s[0].action = TK_ACT_COPY;
    if cmd == TK_CUT && e[0].n > 0 {
      s[0].text_undo_live = true;
      if !has_sel { eb_select_all(e); }
      eb_cut_selection(e);
      s[0].ed_follow = true; s[0].caret_at = s[0].time;
    }
    return true;
  }
  if cmd == TK_BROWSER { return false; }   // Cmd+V pastes through the field; Cmd+R, Cmd+L stay the browser's

  if key == KEY_ENTER { send_typed(s); return true; }
  if key == KEY_LEFT {
    if !shift && e[0].anchor != e[0].caret && !meta && !word_mod { ed_step(s, eb_sel_lo(e), false); }
    else if meta { ed_step(s, 0, shift); }
    else if word_mod { ed_step(s, eb_prev_word(e, e[0].caret), shift); }
    else { ed_step(s, eb_prev_boundary(e, e[0].caret), shift); }
    return true;
  }
  if key == KEY_RIGHT {
    if !shift && e[0].anchor != e[0].caret && !meta && !word_mod { ed_step(s, eb_sel_hi(e), false); }
    else if meta { ed_step(s, e[0].n, shift); }
    else if word_mod { ed_step(s, eb_next_word(e, e[0].caret), shift); }
    else { ed_step(s, eb_next_boundary(e, e[0].caret), shift); }
    return true;
  }
  if key == KEY_HOME || key == KEY_UP { ed_step(s, 0, shift); return true; }
  if key == KEY_END || key == KEY_DOWN { ed_step(s, e[0].n, shift); return true; }
  if key == KEY_BACKSPACE {
    s[0].text_undo_live = true; s[0].ed_follow = true; s[0].caret_at = s[0].time;
    if e[0].anchor != e[0].caret { eb_delete_to(e, e[0].caret); }
    else if meta { eb_delete_to(e, 0); }
    else if word_mod { eb_delete_to(e, eb_prev_word(e, e[0].caret)); }
    else { eb_delete_to(e, eb_prev_boundary(e, e[0].caret)); }
    return true;
  }
  if key == KEY_DELETE {
    s[0].text_undo_live = true; s[0].ed_follow = true; s[0].caret_at = s[0].time;
    if e[0].anchor != e[0].caret { eb_delete_to(e, e[0].caret); }
    else if meta { eb_delete_to(e, e[0].n); }
    else if word_mod { eb_delete_to(e, eb_next_word(e, e[0].caret)); }
    else { eb_delete_to(e, eb_next_boundary(e, e[0].caret)); }
    return true;
  }
  if key == KEY_ESCAPE {
    if e[0].n == 0 { s[0].typing = false; }
    if e[0].n > 0 {
      s[0].text_undo_live = true;
      eb_select_all(e);
      eb_delete_to(e, e[0].caret);
      s[0].ed_scroll = 0;
    }
    return true;
  }
  // a key typed before the field had the keyboard
  if key >= 32 && key < 127 {
    one: [1] u8; one[0] = cast(u8) key;
    ed_receive(s, cast(string) one[..], false);
    return true;
  }
  return false;
}
worldbuilder_blur :: (s: [] WorldBuilder) #export_c #effects(all) {
  stroke_end(s);
  vp_cancel(s[0].vp[..]);
  for i: 0..<6 { s[0].vkeys[i] = false; }
  s[0].down = false; s[0].two = false; s[0].press_btn = -1; s[0].down_kind = 0; s[0].down_btn = -1; s[0].brush_shown = false;
}

wb_scale :: (s: [] WorldBuilder) -> f32 { return hi(s[0].dpr, 0.5); }

// The sheet hit under logical coordinates (lx, ly), or -1.
hit_at :: (s: [] WorldBuilder, lx: f32, ly: f32) -> int {
  best := -1;
  for k: 0..<s[0].nh {
    h := s[0].hits[k];
    if lx >= h.x && lx < h.x + h.w && ly >= h.y && ly < h.y + h.h { best = k; }
  }
  return best;
}

field_offset :: (s: [] WorldBuilder, lx: f32) -> int {
  sk := metaverse_skin();
  tx := lx - s[0].ed_text_x + s[0].ed_scroll;
  return text_offset(s[0].atlas[..], sk.body.face, eb_text(s[0].ed[..]), ifx tx < 0 then 0.0f32 else tx);
}

// Where a screen point's ray (the viewport's, vp_ray) meets the ground: the terrain tile where it is
// shaped (the engine's exact ground ray, metaverse-engine/physics/ground-query.coax), else the level floor.
ground_at :: (s: [] WorldBuilder, x: f32, y: f32) -> PlaceSpot {
  r := vp_ray(s[0].vview, x, y);
  if !r.ok { return PlaceSpot.{}; }
  l := s[0].world[0].land[..];
  if l[0].on && !l[0].bare {
    hit := ground_ray(wb_land_ground(), l[0].heights[..], r.o, r.d, 2000, GROUND_RAY_CELLS);
    if hit.status == GroundRayStatus.ok && hit.hit { return PlaceSpot.{x = hit.point.x, z = hit.point.z, ok = true}; }
  }
  g := vp_ground(r, 0);
  return PlaceSpot.{x = g.x, z = g.z, ok = g.ok};
}
set_here :: (s: [] WorldBuilder, x: f32, y: f32) {
  g := ground_at(s, x, y);
  if !g.ok { return; }
  s[0].has_here = true; s[0].here_x = g.x; s[0].here_z = g.z; s[0].here_at = s[0].time;
  s[0].gx = g.x; s[0].gz = g.z; s[0].framing = false; s[0].moved_at = s[0].time;
  // the editor's "here" is the same point: Add places a new thing there
  vp_here(s[0].vp[..], VpSpot.{ok = true, x = g.x, z = g.z});
  s[0].ep[0].here = true; s[0].ep[0].here_x = s[0].vp[0].here_x; s[0].ep[0].here_z = s[0].vp[0].here_z;
}

// ---- the view: framing what was built (#13224)

// The farthest the view may pull back: further for a scene that reaches further.
dist_far :: (s: [] WorldBuilder) -> f32 {
  idx: [WB_OBJECTS] int; n := 0;
  for i: 0..<s[0].world[0].n { idx[n] = i; n += 1; }
  g := wb_group(s[0].world[..], s[0].cat[..], idx[0..<n]);
  return clamp(hi(cast(f32) DIST_HI, g.r * 3.2), DIST_HI, DIST_FAR);
}
// Sends the view to hold everything built, filling most of it: the middle of the things and far
// enough back for their reach on the narrower way of the screen. An empty world frames the middle.
frame_all :: (s: [] WorldBuilder) {
  idx: [WB_OBJECTS] int; n := 0;
  for i: 0..<s[0].world[0].n { idx[n] = i; n += 1; }
  g := wb_group(s[0].world[..], s[0].cat[..], idx[0..<n]);
  aspect := s[0].width / hi(s[0].height, 1);
  t: f32 = 1 / tan(cast(f32) FOV * 0.5);
  sx := t / hi(aspect, 0.3); sy := t;
  if aspect < 1 { sx = t * 0.9; sy = sx * aspect; }
  s[0].gx = ifx g.ok then g.x else 0.0f32; s[0].gz = ifx g.ok then g.z else 0.0f32;
  reach := ifx g.ok then hi(g.r, 3) else 9.0f32;
  s[0].goal_dist = clamp(reach * hi(sx, sy) * 1.3 + 2, DIST_LO, dist_far(s));
  s[0].framing = true;
}
// The person moved the view themselves: a frame under way stops, and commands leave it be a while.
view_moved :: (s: [] WorldBuilder) { s[0].framing = false; s[0].moved_at = s[0].time; }
// The walk or the overview. Coming out of the walk, the overview looks at where your character stands.
toggle_view :: (s: [] WorldBuilder) {
  if !s[0].walk_ok { return; }
  s[0].walk = !s[0].walk;
  s[0].typing = false;
  if !s[0].walk { s[0].gx = s[0].me_x; s[0].gz = s[0].me_z; s[0].tx = s[0].me_x; s[0].tz = s[0].me_z; s[0].framing = false; }
}

// ---- the brush

// The land's brush is the viewport's (viewport.coax VT_LAND): the shell picks its kind, radius, strength and
// material. Held on the ground it dabs every DAB_S, each dab one typed `terrain` edit
// (worldbuilder-world.coax wbe_dab), and the stroke ends as one step of the log.
brushing :: (s: [] WorldBuilder) -> bool { return s[0].edit && s[0].vp[0].tool == VT_LAND; }
stroke_dab :: (s: [] WorldBuilder) {
  r := wbe_dab(s[0].world[..], vp_dab(s[0].vp[..], VpSpot.{ok = true, x = s[0].brush_x, z = s[0].brush_z}));
  if !r.ok && r.why != WBE_NOT_EDIT { wbe_refuse(s[0].ep[..], wbe_why(r.why)); }
}
stroke_end :: (s: [] WorldBuilder) {
  if !s[0].stroking { return; }
  s[0].stroking = false;
  r := wbe_stroke_end(s[0].world[..]);
  if r.ok { s[0].reply_n = 0; wbe_accept(s[0].ep[..]); }
  else if r.why == WBE_LOG { wbe_refuse(s[0].ep[..], wbe_why(r.why)); }
}
// The GPU's copy of the ground, made again when a sample changed.
ground_store :: (s: [] WorldBuilder) {
  l := s[0].world[0].land[..];
  if !l[0].on || l[0].version == s[0].ground_seen { return; }
  s[0].ground_seen = l[0].version;
  wb_land_gpu(l, s[0].ground[..]);
  s[0].ground_version += 1;
}
worldbuilder_ground_bytes :: (s: [] WorldBuilder) -> int #export_c #effects(all) { return WB_LAND_SAMPLES * 16; }
worldbuilder_ground_version :: (s: [] WorldBuilder) -> int #export_c #effects(all) { return s[0].ground_version; }
worldbuilder_scene_version :: (s: [] WorldBuilder) -> int #export_c #effects(all) { return s[0].scene_version; }

button_enabled :: (s: [] WorldBuilder, btn: int) -> bool {
  if btn == BTN_SEND { return can_send(s) && s[0].ed[0].n > 0; }
  if btn == BTN_FRAME { return s[0].cat_ready; }
  if btn == BTN_EDIT { return s[0].cat_ready && !s[0].edit; }
  if btn == BTN_VIEW { return s[0].walk_ok; }
  return false;
}

// The brush's place on the ground under the pointer.
brush_to :: (s: [] WorldBuilder, x: f32, y: f32) -> bool {
  g := ground_at(s, x, y);
  if !g.ok { return false; }
  s[0].brush_x = g.x; s[0].brush_z = g.z; s[0].brush_shown = true;
  return true;
}
// A press on the world while a tool of the editor's is picked (viewport.coax): the land's brush
// strokes the ground; any other tool taps to select the thing under the pointer and mark the point
// as "here", or drags the selected thing (move, turn, size) into one typed edit. A drag that holds
// nothing turns the view, or looks around when the camera flies.
tool_press :: (s: [] WorldBuilder, x: f32, y: f32) {
  vp := s[0].vp[..];
  if vp[0].tool == VT_LAND {
    vp_press(vp, x, y, VpThing.{});
    if s[0].cat_ready && !s[0].waiting && brush_to(s, x, y) {
      wbe_stroke_begin(s[0].world[..]);
      s[0].stroking = true; s[0].dab_wait = 0;
      stroke_dab(s);   // it acts at once: a tap is a dab
    }
    return;
  }
  vp_press(vp, x, y, wbe_held(s[0].world[..], s[0].ep[..]));
}
tool_move :: (s: [] WorldBuilder, x: f32, y: f32, dx: f32, dy: f32, k: f32) {
  vp := s[0].vp[..];
  if s[0].stroking { _ = brush_to(s, x, y); vp_drag(vp, s[0].vview, x, y); return; }
  vp_drag(vp, s[0].vview, x, y);
  if !vp[0].far || vp[0].holding || vp[0].tool == VT_LAND { return; }
  if vp[0].fly { vp_fly_look(vp, dx, dy); return; }
  if !walking(s) {
    s[0].yaw -= dx / k * 0.006;
    s[0].pitch = clamp(s[0].pitch + dy / k * 0.005, PITCH_LO, PITCH_HI);
    view_moved(s);
  }
}
tool_release :: (s: [] WorldBuilder, cancelled: bool) {
  vp := s[0].vp[..]; w := s[0].world[..]; c := s[0].cat[..]; p := s[0].ep[..];
  stroked := s[0].stroking;
  stroke_end(s);
  if cancelled { vp_cancel(vp); return; }
  r := vp_release(vp);
  if stroked || vp[0].tool == VT_LAND { return; }
  if r.tap {
    wbe_select(w, p, wbe_pick(w, c, s[0].pick[..], s[0].vview, r.x, r.y));
    set_here(s, r.x, r.y);
    return;
  }
  if r.edit.ok && s[0].cat_ready && !s[0].waiting { _ = wbe_view_edit(w, c, p, r.edit); }
}
worldbuilder_pointer :: (s: [] WorldBuilder, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c #effects(all) {
  wb_begin(s);
  k := wb_scale(s);
  lx := x / k; ly := y / k;
  tooled := !hands(s);   // a tool of the editor's has the pointer in the world
  if phase == POINTER_MOVE && !s[0].down {
    hi_idx := hit_at(s, lx, ly);
    s[0].hover_kind = ifx hi_idx >= 0 then s[0].hits[hi_idx].kind else 0;
    s[0].hover_btn = ifx hi_idx >= 0 then s[0].hits[hi_idx].a else -1;
    s[0].hover_b = ifx hi_idx >= 0 then s[0].hits[hi_idx].b else -1;
    s[0].brush_shown = false;
    if hi_idx < 0 && brushing(s) && kind == 0 { _ = brush_to(s, x, y); }
    return false;
  }
  if phase == POINTER_DOWN {
    if s[0].down && !s[0].two && id != s[0].down_id {
      if tooled { tool_release(s, true); }
      s[0].two = true; s[0].two_id = id; s[0].two_x = x; s[0].two_y = y;
      dx := x - s[0].last_x; dy := y - s[0].last_y; s[0].pinch = sqrt(dx * dx + dy * dy);
      s[0].moved = true;
      return true;
    }
    s[0].down = true; s[0].down_id = id; s[0].down_x = x; s[0].down_y = y; s[0].last_x = x; s[0].last_y = y;
    s[0].moved = false;
    hi_idx := hit_at(s, lx, ly);
    s[0].down_kind = ifx hi_idx >= 0 then s[0].hits[hi_idx].kind else 0;
    s[0].down_btn = ifx hi_idx >= 0 then s[0].hits[hi_idx].a else -1;
    s[0].hover_b = ifx hi_idx >= 0 then s[0].hits[hi_idx].b else -1;
    s[0].press_btn = ifx s[0].down_kind == HIT_BUTTON then s[0].down_btn else -1;
    if s[0].down_kind == HIT_FIELD { s[0].typing = true; } else if s[0].down_kind == 0 { s[0].typing = false; }
    // walking with no tool picked, a press on the world is the character's camera's and its thumb stick's
    if walking(s) && s[0].down_kind == 0 && !tooled { s[0].down = false; s[0].down_btn = -1; s[0].press_btn = -1; return false; }
    if s[0].down_kind == 0 && tooled { tool_press(s, x, y); }
    if s[0].down_kind == HIT_FIELD {
      e := s[0].ed[..];
      off := field_offset(s, lx);
      s[0].text_undo_live = true; s[0].ed_follow = true; s[0].caret_at = s[0].time;
      if s[0].time - s[0].click_at <= DOUBLE_S && abs(lx - s[0].click_x) <= 6 { s[0].clicks += 1; } else { s[0].clicks = 1; }
      s[0].click_at = s[0].time; s[0].click_x = lx;
      if s[0].clicks == 2 {
        from := eb_word_from(e, off); to := eb_word_to(e, off);
        eb_move_to(e, from); eb_select_to(e, to);
        s[0].drag_unit = 1; s[0].drag_from = from; s[0].drag_to = to;
      } else if s[0].clicks >= 3 {
        eb_select_all(e);
        s[0].drag_unit = 2; s[0].drag_from = 0; s[0].drag_to = e[0].n;
      } else {
        eb_move_to(e, off);
        s[0].drag_unit = 0; s[0].drag_from = off; s[0].drag_to = off;
      }
    }
    return true;
  }
  if !s[0].down { return false; }
  if phase == POINTER_MOVE {
    if s[0].two && id == s[0].two_id { s[0].two_x = x; s[0].two_y = y; }
    else if id == s[0].down_id {
      if s[0].down_kind == HIT_FIELD && !s[0].two {
        e := s[0].ed[..];
        off := field_offset(s, lx);
        if s[0].drag_unit == 1 {
          from := eb_word_from(e, off); to := eb_word_to(e, off);
          if from < s[0].drag_from { eb_move_to(e, s[0].drag_to); eb_select_to(e, from); }
          else { eb_move_to(e, s[0].drag_from); eb_select_to(e, ifx to > s[0].drag_to then to else s[0].drag_to); }
        } else if s[0].drag_unit == 0 {
          eb_select_to(e, off);
        }
        s[0].ed_follow = true; s[0].caret_at = s[0].time;
      } else if s[0].down_kind == 0 && tooled && !s[0].two {
        tool_move(s, x, y, x - s[0].last_x, y - s[0].last_y, k);
      } else if s[0].down_kind == 0 {
        dx := x - s[0].last_x; dy := y - s[0].last_y;
        if !s[0].moved && abs(x - s[0].down_x) + abs(y - s[0].down_y) > TAP_SLOP * k { s[0].moved = true; }
        if s[0].moved && !s[0].two {
          s[0].yaw -= dx / k * 0.006;
          s[0].pitch = clamp(s[0].pitch + dy / k * 0.005, PITCH_LO, PITCH_HI);
          view_moved(s);
        }
      }
      s[0].last_x = x; s[0].last_y = y;
    }
    if s[0].two {
      ddx := s[0].two_x - s[0].last_x; ddy := s[0].two_y - s[0].last_y;
      d := sqrt(ddx * ddx + ddy * ddy);
      if s[0].pinch > 1 && d > 1 { s[0].dist = clamp(s[0].dist * s[0].pinch / d, DIST_LO, dist_far(s)); view_moved(s); }
      s[0].pinch = d;
    }
    return true;
  }
  // up or cancel
  if s[0].two && id == s[0].two_id { s[0].two = false; return true; }
  if id != s[0].down_id { return true; }
  was_kind := s[0].down_kind; was_btn := s[0].down_btn;
  pinched := s[0].two;
  s[0].down = false; s[0].two = false; s[0].press_btn = -1; s[0].down_kind = 0; s[0].down_btn = -1;
  if kind != 0 { s[0].brush_shown = false; }   // a finger lifted: no brush hangs where it was
  if was_kind == 0 && tooled { tool_release(s, phase != POINTER_UP || pinched); return true; }
  if phase == POINTER_UP && !s[0].moved {
    hi_idx := hit_at(s, lx, ly);
    now_kind := ifx hi_idx >= 0 then s[0].hits[hi_idx].kind else 0;
    now_btn := ifx hi_idx >= 0 && now_kind == HIT_BUTTON then s[0].hits[hi_idx].a else -1;
    if was_kind == HIT_BUTTON && now_kind == HIT_BUTTON && now_btn == was_btn {
      if was_btn == BTN_SEND { send_typed(s); }
      else if was_btn == BTN_FRAME { if walking(s) { toggle_view(s); } frame_all(s); }
      else if was_btn == BTN_VIEW { toggle_view(s); }
      else if was_btn == BTN_EDIT && button_enabled(s, BTN_EDIT) { s[0].go_edit = true; }
    } else if was_kind == 0 && now_kind == 0 { set_here(s, x, y); }
  }
  return true;
}
// The wheel pulls the view back or in by a share of how far it is, so a step feels the same near and far.
worldbuilder_wheel :: (s: [] WorldBuilder, dy: f32) -> bool #export_c #effects(all) {
  s[0].dist = clamp(s[0].dist * exp(clamp(dy, -400, 400) * 0.0015), DIST_LO, dist_far(s));
  view_moved(s);
  return true;
}
worldbuilder_cursor :: (s: [] WorldBuilder) -> int #export_c #effects(all) {
  if s[0].hover_kind == HIT_FIELD { return 3; }
  if s[0].hover_kind == HIT_BUTTON && button_enabled(s, s[0].hover_btn) { return 1; }
  if brushing(s) && s[0].hover_kind == 0 { return 2; }
  return 0;
}

// ---- the camera

view_rows :: (s: [] WorldBuilder) {
  aspect := s[0].width / hi(s[0].height, 1);
  hx := sin(s[0].yaw); hz := -cos(s[0].yaw);
  cp := cos(s[0].pitch); sp := sin(s[0].pitch);
  fx := hx * cp; fy := -sp; fz := hz * cp;
  ex := s[0].tx - fx * s[0].dist; ey := s[0].ty - fy * s[0].dist; ez := s[0].tz - fz * s[0].dist;
  if walking(s) {
    // Everglade's follow camera: its eye and the way it looks (the zone's, worldbuilder-walk.coax)
    cl := sqrt(s[0].cam_fwd[0] * s[0].cam_fwd[0] + s[0].cam_fwd[1] * s[0].cam_fwd[1] + s[0].cam_fwd[2] * s[0].cam_fwd[2]);
    if cl > 0.0001 && abs(s[0].cam_fwd[1]) < cl * 0.999 {
      fx = s[0].cam_fwd[0] / cl; fy = s[0].cam_fwd[1] / cl; fz = s[0].cam_fwd[2] / cl;
      ex = s[0].cam_eye[0]; ey = s[0].cam_eye[1]; ez = s[0].cam_eye[2];
    }
  }
  if flying(s) {
    // the editor's fly camera (viewport.coax): its own eye and the way it looks
    fv := vp_fly_view(s[0].vp[..], s[0].vview);
    ex = fv.ex; ey = fv.ey; ez = fv.ez; fx = fv.ax - fv.ex; fy = fv.ay - fv.ey; fz = fv.az - fv.ez;
  }
  rx := -fz; rz := fx; rl := sqrt(rx * rx + rz * rz); rx /= rl; rz /= rl;   // f × (0, 1, 0)
  ux := -rz * fy; uy := rz * fx - rx * fz; uz := rx * fy;                    // r × f
  t: f32 = 1 / tan(cast(f32) FOV * 0.5);
  sx := t / hi(aspect, 0.3); sy := t;
  if aspect < 1 { sx = t * 0.9; sy = sx * aspect; }   // a phone: as wide a view as a screen that's wider
  zn: f32 = 0.3; zf: f32 = 900.0;
  a := zf / (zn - zf); b := zn * zf / (zn - zf);
  v := s[0].view[..];
  v[0] = sx * rx; v[1] = 0; v[2] = sx * rz; v[3] = -sx * (rx * ex + rz * ez);
  v[4] = sy * ux; v[5] = sy * uy; v[6] = sy * uz; v[7] = -sy * (ux * ex + uy * ey + uz * ez);
  v[8] = -a * fx; v[9] = -a * fy; v[10] = -a * fz; v[11] = a * (fx * ex + fy * ey + fz * ez) + b;
  v[12] = fx; v[13] = fy; v[14] = fz; v[15] = -(fx * ex + fy * ey + fz * ez);
  s[0].eye[0] = ex; s[0].eye[1] = ey; s[0].eye[2] = ez;
  s[0].fwd[0] = fx; s[0].fwd[1] = fy; s[0].fwd[2] = fz;
  s[0].right[0] = rx / sx; s[0].right[1] = 0; s[0].right[2] = rz / sx;
  s[0].up[0] = ux / sy; s[0].up[1] = uy / sy; s[0].up[2] = uz / sy;
  // the same view as the viewport's tools read it: a pick's ray and a drag's ground point come from it
  s[0].vview = VpView.{ex = ex, ey = ey, ez = ez, ax = ex + fx, ay = ey + fy, az = ez + fz, fov = 2 * vp_atan2(1, sy), w = s[0].width, h = s[0].height};
}

// ---- the scene: one draw a mesh, its instances' rows

// One piece's rows: rotation about y by yaw, its scale, and its mesh's box folded in, so the
// shader's unorm16 position (0..1 in the box) lands where the piece stands.
rows_of :: (s: [] WorldBuilder, mesh: int, x: f32, y: f32, z: f32, yaw: f32, k: f32, at: int) {
  b := s[0].cat[0].box[mesh * 6..<mesh * 6 + 6];
  ex := b[3] - b[0]; ey := b[4] - b[1]; ez := b[5] - b[2];
  c := cos(yaw); sn := sin(yaw);
  r := s[0].objects[..];
  r[at] = c * k * ex; r[at + 1] = 0; r[at + 2] = sn * k * ez; r[at + 3] = x + k * (c * b[0] + sn * b[2]);
  r[at + 4] = 0; r[at + 5] = k * ey; r[at + 6] = 0; r[at + 7] = y + k * b[1];
  r[at + 8] = -sn * k * ex; r[at + 9] = 0; r[at + 10] = c * k * ez; r[at + 11] = z + k * (-sn * b[0] + c * b[2]);
  r[at + 12] = 1; r[at + 13] = 1; r[at + 14] = 1; r[at + 15] = 0;
}
// How many pieces a thing draws: a building its pieces, anything else itself.
pieces_of :: (s: [] WorldBuilder, m: int) -> int { return ifx wb_is_building(s[0].cat[..], m) then s[0].cat[0].part_n[m] else 1; }
// The scene: one draw a mesh of the pack, its instances' rows, rebuilt when the world changes.
scene :: (s: [] WorldBuilder) {
  w := s[0].world[..]; c := s[0].cat[..];
  l := w[0].land[..];
  // a thing a tool is dragging is drawn where the drag has it (viewport.coax vp_dragging), until the drag ends as an edit
  vp := s[0].vp[..];
  dragging := s[0].edit && vp_dragging(vp);
  drag_key := ifx dragging then 1 + vp[0].now.x * 31 + vp[0].now.z * 17 + vp[0].now.yaw * 7 + vp[0].now.scale else 0;
  if drag_key != s[0].drag_key { s[0].drag_key = drag_key; s[0].drawn_version = -1; }
  if !s[0].cat_ready || (s[0].drawn_version == w[0].version && s[0].land_seated == l[0].version) { return; }
  s[0].drawn_version = w[0].version; s[0].land_seated = l[0].version; s[0].scene_version += 1;
  counts: [WB_MESHES] int; start: [WB_MESHES] int;
  // the things that fit, in order (every thing but past WB_INSTANCES pieces)
  total := 0; upto := 0;
  while upto < w[0].n {
    m := w[0].objs[upto].mesh;
    if total + pieces_of(s, m) > WB_INSTANCES - 1 { break; }
    total += pieces_of(s, m);
    if wb_is_building(c, m) { for p: 0..<c[0].part_n[m] { counts[c[0].parts[c[0].part_first[m] + p].mesh] += 1; } }
    else { counts[m] += 1; }
    upto += 1;
  }
  s[0].draw_n = 0;
  // the ground first: one draw of the tile's cells, six vertices each, no index buffer (the top bit
  // of its base instance says so, coax/web/host.js); its row 0 of the store only says "the ground".
  // A level, bare Grid needs none: the page's background is that floor.
  for q: 0..<INSTANCE_FLOATS { s[0].objects[q] = 0; }
  s[0].objects[15] = 1;
  if l[0].on && !l[0].bare {
    s[0].draws[0] = 0; s[0].draws[1] = cast(u32) (WB_LAND_CELLS * WB_LAND_CELLS * 6);
    s[0].draws[2] = 0x80000000; s[0].draws[3] = 1;
    s[0].draw_n = 1;
  }
  at := 1;
  for m: 0..<c[0].real_n {
    start[m] = at;
    if counts[m] == 0 { continue; }
    d := s[0].draw_n * 4;
    s[0].draws[d] = cast(u32) c[0].first[m]; s[0].draws[d + 1] = cast(u32) c[0].count[m];
    s[0].draws[d + 2] = cast(u32) at; s[0].draws[d + 3] = cast(u32) counts[m];
    s[0].draw_n += 1;
    at += counts[m];
  }
  s[0].inst_n = at;
  for i: 0..<upto {
    o := w[0].objs[i];
    if dragging && o.id + 1 == vp[0].held.id {
      if vp[0].tool == VT_MOVE { o.x = we_m(vp[0].now.x); o.z = we_m(vp[0].now.z); }
      if vp[0].tool == VT_TURN { o.yaw = we_rad(vp[0].now.yaw); }
      if vp[0].tool == VT_SIZE { o.scale = cast(f32) vp[0].now.scale / 100; }
    }
    if wb_is_building(c, o.mesh) {
      co := cos(o.yaw); sn := sin(o.yaw); k := o.scale;
      for p: 0..<c[0].part_n[o.mesh] {
        q := c[0].parts[c[0].part_first[o.mesh] + p];
        x := o.x + k * (co * q.x + sn * q.z); z := o.z + k * (-sn * q.x + co * q.z);
        rows_of(s, q.mesh, x, wb_land_y(l, o.x, o.z) + k * q.y, z, o.yaw + q.yaw, k, start[q.mesh] * INSTANCE_FLOATS);
        start[q.mesh] += 1;
      }
    } else {
      rows_of(s, o.mesh, o.x, wb_land_y(l, o.x, o.z), o.z, o.yaw, o.scale, start[o.mesh] * INSTANCE_FLOATS);
      start[o.mesh] += 1;
    }
  }
}
worldbuilder_draw_count :: (s: [] WorldBuilder) -> int #export_c #effects(all) { return ifx s[0].cat_ready then s[0].draw_n else 0; }
worldbuilder_store_bytes :: (s: [] WorldBuilder) -> int #export_c #effects(all) { return s[0].inst_n * INSTANCE_FLOATS * 4; }

// ---- the HUD: components/kit/controls.coax in the Verse skin (components/skin/metaverse.coax)

// "$1.25"
put_dollars :: (b: [] u8, at: int, micros: int) -> int {
  cents := (micros + 5000) / 10000;
  n := put(b, at, "$"); n = put_int(b, n, cents / 100); n = put(b, n, ".");
  if cents % 100 < 10 { n = put(b, n, "0"); }
  return put_int(b, n, cents % 100);
}
put_mb :: (b: [] u8, at: int, bytes: int) -> int { n := put_int(b, at, (bytes + 524288) / 1048576); return put(b, n, " MB"); }

wb_button :: (sh: [] Sheet, m: TextMeasure, sk: UiSkin, s: [] WorldBuilder, x: f32, y: f32, label: string, btn: int, primary: bool) -> f32 {
  enabled := button_enabled(s, btn);
  hot := enabled && ((s[0].hover_kind == HIT_BUTTON && s[0].hover_btn == btn) || s[0].press_btn == btn);
  state := ifx primary && enabled then UISKIN_PRIMARY else ifx hot then UISKIN_HOVER else UISKIN_REST;
  no0 := sh[0].no;
  w := button(sh, m, sk, x, y, label, state, HIT_BUTTON, btn);
  if !enabled && sh[0].no > no0 { sh[0].over[sh[0].no - 1].fill = sk.faint; }
  return w;
}

// A hint over the chat box, when the room is wide enough to hold it whole.
wb_hint :: (sh: [] Sheet, m: TextMeasure, sk: UiSkin, cx: f32, y: f32, room: f32, text: string) {
  if measure_width(m, sk.small.face, text) > room { return; }
  _ = wb_centred(sh, m, cx, y, sk.small.line, sk.small.face, sk.muted, text);
}
wb_centred :: (sh: [] Sheet, m: TextMeasure, cx: f32, y: f32, line_h: f32, face: int, color: Rgba, text: string) -> f32 {
  w := measure_width(m, face, text);
  return sheet_text(sh, m, -1, cx - w * 0.5, y, line_h, face, color, text);
}

// Where the top's boxes go (fx_layout's nodes): `panel` the WorldBuilder panel, and the buttons from
// `buttons` on, in the order of `labels`. Wide, one row: the panel, then the buttons at the right
// edge. Narrow (a phone), a column: the buttons in rows at the right, as many to a row as fit, then
// the panel under them. Nothing overlaps at any width.
WbTop :: struct { panel: int; buttons: int; }
wb_top_layout :: (t: [] FxTree, m: TextMeasure, sk: UiSkin, lw: f32, g: f32, phone: bool, want_w: f32, hud_h: f32, labels: [] string) -> WbTop {
  fx_reset(t);
  root := fx_add(t, -1);
  fx_pad(t, root, g, g, g, g);
  inner := hi(lw - 2 * g, 0);
  out: WbTop;
  if !phone {
    t[0].nodes[root].direction = FX_ROW; t[0].nodes[root].gap = g; t[0].nodes[root].align = FX_START;
    out.panel = fx_add(t, root);
    t[0].nodes[out.panel].width = want_w; t[0].nodes[out.panel].height = hud_h;
    fx_flex(t, out.panel, 0, 1, FX_AUTO);
    gap := fx_add(t, root); fx_flex(t, gap, 1, 1, 0);
    row := fx_add(t, root);
    t[0].nodes[row].direction = FX_ROW; t[0].nodes[row].gap = sk.space;
    for k: 0..<labels.count {
      b := fx_add(t, row);
      if k == 0 { out.buttons = b; }
      t[0].nodes[b].width = button_width(m, sk, labels[k]); t[0].nodes[b].height = sk.control_h; fx_flex(t, b, 0, 0, FX_AUTO);
    }
    fx_flex(t, row, 0, 0, FX_AUTO);
    fx_layout(t, lw, FX_AUTO);
    return out;
  }
  t[0].nodes[root].direction = FX_COLUMN; t[0].nodes[root].gap = sk.space; t[0].nodes[root].align = FX_START;
  // rows of buttons, right-aligned, each holding as many as fit
  first := true; k := 0;
  while k < labels.count {
    row := fx_add(t, root);
    t[0].nodes[row].direction = FX_ROW; t[0].nodes[row].gap = sk.space; t[0].nodes[row].justify = FX_END;
    t[0].nodes[row].self = FX_STRETCH; t[0].nodes[row].height = sk.control_h;
    used: f32 = 0; in_row := 0;
    while k < labels.count {
      bw := button_width(m, sk, labels[k]);
      if in_row > 0 && used + sk.space + bw > inner { break; }
      b := fx_add(t, row);
      if first { out.buttons = b; first = false; }
      t[0].nodes[b].width = bw; t[0].nodes[b].height = sk.control_h; fx_flex(t, b, 0, 0, FX_AUTO);
      used += ifx in_row > 0 then sk.space + bw else bw;
      in_row += 1; k += 1;
    }
  }
  out.panel = fx_add(t, root);
  t[0].nodes[out.panel].width = lo(want_w, inner); t[0].nodes[out.panel].height = hud_h;

  fx_layout(t, lw, FX_AUTO);
  return out;
}

draw_ui :: (s: [] WorldBuilder, out: [] f32) -> int {
  a := s[0].atlas[..];
  a[0].frame += 1;
  d := wb_scale(s);
  lw := s[0].width / d; lh := s[0].height / d;
  g: f32 = 16;
  // the room this page's HUD has: the window, or the part of it the editor's panes leave free
  rx0: f32 = 0; ry0: f32 = 0; rx1 := lw; ry1 := lh;
  if s[0].edit && s[0].room_on {
    rx0 = clamp(s[0].room[0], 0, lw); ry0 = clamp(s[0].room[1], 0, lh);
    rx1 = clamp(s[0].room[2], rx0, lw); ry1 = clamp(s[0].room[3], ry0, lh);
  }
  rw := rx1 - rx0; cx := (rx0 + rx1) * 0.5;
  phone := rw < 640;
  sk := metaverse_skin();
  m := measure_font(a);

  sh: [1] Sheet;
  sh[0] = Sheet.{under = s[0].under[..], over = s[0].over[..], lines = s[0].lines[..], hits = s[0].hits[..], pool = s[0].pool[..],
                 hover_kind = s[0].hover_kind, hover_a = s[0].hover_btn, hover_b = s[0].hover_b};

  buf: [240] u8;

  // a phone's thumb stick, where the thumb is (the zone's: everglade/zone-touch.coax decides it)
  if s[0].stick_on && walking(s) {
    r0: f32 = 46; r1: f32 = 20;
    sheet_fill(sh[..], s[0].stick[0] / d - r0, s[0].stick[1] / d - r0, r0 * 2, r0 * 2, r0, opacity(sk.ink, 0.10));
    sheet_fill(sh[..], s[0].stick[2] / d - r1, s[0].stick[3] / d - r1, r1 * 2, r1 * 2, r1, opacity(sk.accent, 0.55));
  }

  // WorldBuilder, how full the world is, and the shared limits, top left in a Verse panel
  cn := put_int(buf[..], 0, s[0].world[0].n); cn = put(buf[..], cn, " of "); cn = put_int(buf[..], cn, WB_OBJECTS); cn = put(buf[..], cn, " things");
  count := sheet_pool(sh[..], cast(string) buf[0..<cn]);
  ln := 0;
  if s[0].known {
    ln = put_dollars(buf[..], 0, s[0].spent); ln = put(buf[..], ln, " of ");
    ln = put_dollars(buf[..], ln, s[0].cap); ln = put(buf[..], ln, " shared AI used today");
  } else { ln = put(buf[..], 0, "$50 of AI a day, shared by everyone"); }
  limits := sheet_pool(sh[..], cast(string) buf[0..<ln]);
  pace := "4 commands at once, then 1 every 1.5 s";

  title_w := measure_width(m, sk.title.face, "WorldBuilder") + sk.space * 1.5 + measure_width(m, sk.small.face, count);
  lim_w := measure_width(m, sk.small.face, limits);
  pace_w := measure_width(m, sk.small.face, pace);
  want_w := hi(hi(title_w, lim_w), pace_w) + 2 * sk.pad;
  hud_body := sk.small.line * 2 + 4 + (ifx s[0].known then sk.bar_h + 6 else 0.0f32);
  hud_h := panel_height(sk, hud_body, true);

  // The top: the panel and the buttons (WALK or OVERVIEW, FRAME, EDIT), laid out by the
  // component system's flex (components/layout/flex.coax). Wide, one row: the panel left, the
  // buttons right. On a phone the buttons go above the panel, in as many rows as they need.
  // With the editor's shell over the page there is no EDIT: undo, redo, the things and the land's
  // brush are the shell's.
  view_label := ifx walking(s) then "OVERVIEW" else "WALK";
  labels := [3] string.[view_label, "FRAME", "EDIT"];
  ids := [3] int.[BTN_VIEW, BTN_FRAME, BTN_EDIT];
  first := ifx s[0].walk_ok then 0 else 1;   // no WALK or OVERVIEW until your character is there
  last := ifx s[0].edit then 2 else 3;
  top := wb_top_layout(s[0].fx[..], m, sk, rw, g, phone, want_w, hud_h, labels[first..<last]);
  fx := s[0].fx[..];
  for k: first..<last {
    nd := fx[0].nodes[top.buttons + k - first];
    _ = wb_button(sh[..], m, sk, s, rx0 + nd.x, ry0 + nd.y, labels[k], ids[k], false);
  }
  pnode := fx[0].nodes[top.panel];
  hud_x := rx0 + pnode.x; hud_y := ry0 + pnode.y; hud_w := pnode.w;
  inside := panel(sh[..], m, sk, hud_x, hud_y, hud_w, hud_h, "WorldBuilder");
  count_x := hud_x + sk.pad + measure_width(m, sk.title.face, "WorldBuilder") + sk.space * 1.5;
  if count_x + measure_width(m, sk.small.face, count) <= hud_x + hud_w - sk.pad {
    _ = sheet_text(sh[..], m, -1, count_x, hud_y + sk.pad + (sk.title.line - sk.small.line) * 0.5, sk.small.line, sk.small.face, sk.accent, count);
  }
  cy := inside.y;
  _ = sheet_text(sh[..], m, -1, inside.x, cy, sk.small.line, sk.small.face, sk.muted, limits);
  cy += sk.small.line + 4;
  if s[0].known && s[0].cap > 0 {
    share := clamp(cast(f32) s[0].spent / cast(f32) s[0].cap, 0, 1);
    cy += bar(sh[..], sk, inside.x, cy, inside.w, share, ifx s[0].resting then sk.warning else sk.accent) + 6;
  }
  _ = sheet_text(sh[..], m, -1, inside.x, cy, sk.small.line, sk.small.face, sk.faint, pace);

  // the pack, while it comes: a panel and progress bar in the middle of the screen
  if !s[0].cat_ready {
    pn := 0;
    if s[0].pack_failed { pn = put(buf[..], 0, "The models didn't arrive. Reload the page."); }
    else {
      pn = put(buf[..], 0, "Bringing in 785 models");
      if s[0].total > 0 { pn = put(buf[..], pn, " · "); pn = put_mb(buf[..], pn, s[0].loaded); pn = put(buf[..], pn, " of "); pn = put_mb(buf[..], pn, s[0].total); }
    }
    pload := sheet_pool(sh[..], cast(string) buf[0..<pn]);
    has_bar := s[0].total > 0 && !s[0].pack_failed;
    pw := lo(rw - 2 * g, hi(measure_width(m, sk.body.face, pload) + 2 * sk.pad, 320));
    pbody := sk.body.line + (ifx has_bar then sk.space + sk.bar_h else 0.0f32);
    ph := panel_height(sk, pbody, false);
    px := cx - pw * 0.5; py := ry0 + (ry1 - ry0) * 0.44 - ph * 0.5;
    pins := panel(sh[..], m, sk, px, py, pw, ph, "");
    _ = wb_centred(sh[..], m, cx, pins.y, sk.body.line, sk.body.face, ifx s[0].pack_failed then sk.danger else sk.ink, pload);
    if has_bar {
      pshare := clamp(cast(f32) s[0].loaded / cast(f32) s[0].total, 0, 1);
      _ = bar(sh[..], sk, pins.x, pins.y + sk.body.line + sk.space, pins.w, pshare, sk.accent);
    }
  }

  // the chat box (EditBuf) and SEND, bottom centre
  fw := lo(rw - 2 * g, 680);
  fh := sk.control_h + 2 * sk.space;
  fx0 := cx - fw * 0.5;
  fy1 := ry1 - g - (ifx phone then 8.0f32 else 12.0f32);
  fy0 := fy1 - fh;
  send_w := button_width(m, sk, "SEND");
  sx := fx0 + fw - sk.space - send_w;
  sy := fy0 + sk.space;

  _ = panel(sh[..], m, sk, fx0, fy0, fw, fh, "");
  _ = wb_button(sh[..], m, sk, s, sx, sy, "SEND", BTN_SEND, true);

  field_w := sx - sk.space - fx0;
  sheet_hit(sh[..], HIT_FIELD, 0, 0, fx0, fy0, field_w, fh);
  s[0].field[0] = fx0 * d; s[0].field[1] = fy0 * d; s[0].field[2] = (fx0 + field_w) * d; s[0].field[3] = fy1 * d;

  tx := fx0 + sk.pad;
  tw := hi(sx - sk.space - tx, 24);
  ty := fy0 + (fh - sk.body.line) * 0.5;
  s[0].ed_text_x = tx; s[0].ed_text_w = tw;

  e := s[0].ed[..];
  typed := eb_text(e);
  total_w := text_width(a, sk.body.face, typed);
  caret_x := text_x_at(a, sk.body.face, typed, e[0].caret);
  max_scroll := hi(total_w + 4 - tw, 0);
  if s[0].ed_follow {
    if caret_x < s[0].ed_scroll { s[0].ed_scroll = caret_x; }
    else if caret_x + 4 > s[0].ed_scroll + tw { s[0].ed_scroll = caret_x + 4 - tw; }
    s[0].ed_follow = false;
  }
  s[0].ed_scroll = clamp(s[0].ed_scroll, 0, max_scroll);

  sh[0].nu = prim_clip(sh[0].under, sh[0].nu, tx - 2, fy0 + 2, tx + tw + 2, fy1 - 2);
  sh[0].no = prim_clip(sh[0].over, sh[0].no, tx - 2, fy0 + 2, tx + tw + 2, fy1 - 2);
  pen_x := tx - s[0].ed_scroll;
  sel_a := eb_sel_lo(e); sel_b := eb_sel_hi(e);
  if e[0].n > 0 && sel_b > sel_a {
    sa := text_x_at(a, sk.body.face, typed, sel_a);
    sb := text_x_at(a, sk.body.face, typed, sel_b);
    sheet_fill(sh[..], pen_x + sa, ty, hi(sb - sa, 2), sk.body.line, 2, sk.selection);
  }
  if e[0].n > 0 {
    _ = sheet_text(sh[..], m, -1, pen_x, ty, sk.body.line, sk.body.face, sk.ink, typed);
  } else {
    hint := ifx worldbuilder_roams(s) then (ifx phone then "Tap here to say what to build" else "Press Enter to say what to build") else ifx s[0].world[0].n == 0 && s[0].world[0].land[0].bare then "Put a tree here" else "Say what to build";
    _ = sheet_text(sh[..], m, -1, tx, ty, sk.body.line, sk.body.face, sk.faint, hint);
  }
  blink := s[0].still || cast(int) floor((s[0].time - s[0].caret_at) * 2) % 2 == 0;
  if sel_a == sel_b && blink && !worldbuilder_roams(s) {
    sheet_fill(sh[..], pen_x + caret_x, ty + 2, 2, sk.body.line - 4, 0, sk.accent);
  }
  sheet_unclip(sh[..]);

  // over the chat box: the words sent while waiting, resting or flood notices, the model's reply, or the ground hint
  ry := fy0 - sk.space - sk.body.line;
  if s[0].waiting && s[0].heard_n > 0 {
    rn := put(buf[..], 0, "\""); rn = put(buf[..], rn, cast(string) s[0].heard[0..<s[0].heard_n]); rn = put(buf[..], rn, "\"");
    line := sheet_pool(sh[..], cast(string) buf[0..<rn]);
    pulse := ifx s[0].still then 0.85f32 else 0.55 + 0.35 * sin(s[0].time * 5);
    _ = wb_centred(sh[..], m, cx, ry, sk.body.line, sk.body.face, opacity(sk.ink, pulse), line);
  } else if s[0].resting {
    _ = wb_centred(sh[..], m, cx, ry - sk.small.line - 2, sk.body.line, sk.strong.face, sk.warning, "WorldBuilder is resting until midnight, Chicago time.");
    _ = wb_centred(sh[..], m, cx, ry, sk.small.line, sk.small.face, sk.muted, "Today's shared $50 of AI is used up. Your world is kept.");
  } else if s[0].time < s[0].flood_until {
    left := cast(int) ((s[0].flood_until - s[0].time) * 10 + 0.999);
    rn := put(buf[..], 0, "Too fast for the shared line: send again in ");
    rn = put_int(buf[..], rn, left / 10); rn = put(buf[..], rn, "."); rn = put_int(buf[..], rn, left % 10); rn = put(buf[..], rn, " s");
    line := sheet_pool(sh[..], cast(string) buf[0..<rn]);
    _ = wb_centred(sh[..], m, cx, ry, sk.body.line, sk.body.face, sk.warning, line);
  } else if s[0].reply_n > 0 {
    line := sheet_pool(sh[..], cast(string) s[0].reply[0..<s[0].reply_n]);
    tone := ifx s[0].reply_kind == REPLY_NOTICE then sk.warning else sk.ink;
    _ = wb_centred(sh[..], m, cx, ry, sk.body.line, sk.body.face, tone, line);
  } else if !hands(s) {
    // a tool of the editor's is picked: the shell says what it does
  } else if walking(s) && s[0].cat_ready {
    hint := ifx phone then "Left thumb walks · drag to look · \"here\" is where you stand" else "W A S D walks · Space jumps · drag to look · Tab for the overview · \"here\" is where you stand";
    wb_hint(sh[..], m, sk, cx, ry, rw - 2 * g, hint);
  } else if !s[0].has_here && s[0].cat_ready {
    hint := ifx phone then "Tap the ground to say where \"here\" is · drag to turn · pinch to zoom" else "Click the ground to say where \"here\" is · drag to turn · scroll to zoom";
    wb_hint(sh[..], m, sk, cx, ry, rw - 2 * g, hint);
  }

  s[0].nu = sh[0].nu; s[0].no = sh[0].no; s[0].nh = sh[0].nh;
  if !a[0].ready { return 0; }
  v := gpu_draw(out, 0, a, d, s[0].under[0..<s[0].nu], 0, 0, -8, lh + 8);
  v = gpu_draw(out, v, a, d, s[0].over[0..<s[0].no], 0, 0, -8, lh + 8);
  return v;
}

// ---- the frame and the atlas exports (coax/web/gpui.js)

worldbuilder_frame :: (s: [] WorldBuilder, out: [] f32, uniforms: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c #effects(all) {
  if s.count < 1 || uniforms.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  wb_begin(s);
  held := still || s[0].golden;
  s[0].width = width; s[0].height = height; s[0].dpr = hi(dpr, 0.5); s[0].still = held;
  step := clamp(dt, 0, 0.1);
  s[0].time += step;
  s[0].ed[0].clock = s[0].time;
  // the view glides to where it was sent: the spot last tapped, or a frame of what was built
  glide := ifx held then 1.0f32 else 1 - exp(-step * 4);
  s[0].tx += (s[0].gx - s[0].tx) * glide; s[0].tz += (s[0].gz - s[0].tz) * glide;
  if s[0].framing {
    s[0].dist += (s[0].goal_dist - s[0].dist) * glide;
    if abs(s[0].goal_dist - s[0].dist) < 0.01 { s[0].dist = s[0].goal_dist; s[0].framing = false; }
  }
  s[0].ty += (wb_land_y(s[0].world[0].land[..], s[0].tx, s[0].tz) - s[0].ty) * glide;
  // a brush held down dabs every DAB_S (three a frame at most, when a frame was long)
  if s[0].stroking {
    s[0].dab_wait += step;
    for k: 0..<3 { if s[0].dab_wait >= DAB_S { s[0].dab_wait -= DAB_S; stroke_dab(s); } }
    if s[0].dab_wait >= DAB_S { s[0].dab_wait = 0; }
  }
  // the editor's camera flies on its keys: W and S, A and D, E and Q
  if flying(s) {
    kd := s[0].vkeys;
    vp_fly_step(s[0].vp[..], step, (ifx kd[0] then 1.0f32 else 0.0f32) - (ifx kd[1] then 1.0f32 else 0.0f32), (ifx kd[3] then 1.0f32 else 0.0f32) - (ifx kd[2] then 1.0f32 else 0.0f32), (ifx kd[5] then 1.0f32 else 0.0f32) - (ifx kd[4] then 1.0f32 else 0.0f32), false);
  }
  pump(s);
  ground_store(s);
  scene(s);
  for i: 0..<UNIFORM_FLOATS { uniforms[i] = 0; }
  uniforms[0] = width; uniforms[1] = height; uniforms[2] = ifx held then 20.0f32 else s[0].time;
  uniforms[3] = ifx held then 1.0f32 else ease(s[0].time / 0.5);
  uniforms[4] = ifx held then 1.0f32 else 0.0f32;
  uniforms[6] = s[0].dpr;
  view_rows(s);
  for i: 0..<16 { uniforms[VIEW_AT + i] = s[0].view[i]; }
  if s[0].has_here {
    uniforms[HERE_AT] = s[0].here_x; uniforms[HERE_AT + 2] = s[0].here_z;
    uniforms[HERE_AT + 3] = ifx held then 0.8f32 else 0.55 + 0.45 * ease(1 - (s[0].time - s[0].here_at) / 0.6) + 0.15 * sin(s[0].time * 3);
  }
  for i: 0..<3 {
    uniforms[EYE_AT + i] = s[0].eye[i]; uniforms[RAY_AT + i] = s[0].fwd[i];
    uniforms[RAY_AT + 4 + i] = s[0].right[i]; uniforms[RAY_AT + 8 + i] = s[0].up[i];
  }
  // the ring on the ground: the land's brush under the pointer, else round the selected thing (where a drag has it)
  if brushing(s) && (s[0].brush_shown || s[0].stroking) && !s[0].golden {
    uniforms[BRUSH_AT] = s[0].brush_x; uniforms[BRUSH_AT + 1] = cast(f32) s[0].vp[0].brush_r / 100; uniforms[BRUSH_AT + 2] = s[0].brush_z;
    uniforms[BRUSH_AT + 3] = ifx s[0].stroking then 1.0f32 else 0.7f32;
  } else if s[0].edit && !brushing(s) && !s[0].golden {
    th := wbe_held(s[0].world[..], s[0].ep[..]);
    if th.id > 0 {
      if vp_dragging(s[0].vp[..]) { th = s[0].vp[0].now; }
      mesh := s[0].world[0].objs[wb_index(s[0].world[..], th.id - 1)].mesh;
      uniforms[BRUSH_AT] = we_m(th.x); uniforms[BRUSH_AT + 2] = we_m(th.z);
      uniforms[BRUSH_AT + 1] = wb_radius(s[0].cat[..], mesh) * cast(f32) th.scale / 100 * 1.2 + 0.3;
      uniforms[BRUSH_AT + 3] = 0.9;
    }
  }
  wb_land_looks(uniforms, LAYERS_AT);
  return draw_ui(s, out);
}
worldbuilder_golden :: (s: [] WorldBuilder, on: bool) #export_c #effects(all) { s[0].golden = on; }
coaxial_worldbuilder_max_vertices :: () -> int #export_c #effects(all) { return MAX_VERTICES; }
coaxial_worldbuilder_vertex_floats :: () -> int #export_c #effects(all) { return VERTEX_FLOATS; }
coaxial_worldbuilder_uniform_floats :: () -> int #export_c #effects(all) { return UNIFORM_FLOATS; }

worldbuilder_glyph_count :: () -> int #export_c #effects(all) { return GP_GLYPHS; }
worldbuilder_glyph_code :: (k: int) -> int #export_c #effects(all) {
  if k < 95 { return k + 32; }
  extra := GP_EXTRA;
  return ifx k - 95 < 3 then cast(int) extra[k - 95] else 63;
}
worldbuilder_font_count :: () -> int #export_c #effects(all) { return GP_FONTS; }
worldbuilder_font_size :: (k: int) -> f32 #export_c #effects(all) { sizes := FONT_SIZES; return ifx k >= 0 && k < GP_FONTS then sizes[k] else 14.0f32; }
worldbuilder_font_weight :: (k: int) -> int #export_c #effects(all) { weights := FONT_WEIGHTS; return ifx k >= 0 && k < GP_FONTS then weights[k] else 0; }
worldbuilder_icon_count :: () -> int #export_c #effects(all) { return ICON_COUNT; }
worldbuilder_icon_size :: (i: int) -> f32 #export_c #effects(all) { sizes := ICON_SIZES; return ifx i >= 0 && i < ICON_COUNT then sizes[i] else 16.0f32; }
worldbuilder_icon_name :: (s: [] WorldBuilder, i: int) -> int #export_c #effects(all) {
  if s.count < 1 || i < 0 || i >= ICON_COUNT { return 0; }
  names := ICON_NAMES;
  n := ifx names[i].count < 64 then names[i].count else 64;
  for k: 0..<n { s[0].sbytes[k] = names[i][k]; }
  return n;
}
worldbuilder_set_font :: (s: [] WorldBuilder, slot: int) #export_c #effects(all) {
  if s.count < 1 || slot < 0 || slot >= GP_FONTS { return; }
  sizes := FONT_SIZES;
  gp_set_font(s[0].atlas[..], slot, sizes[slot], s[0].scratch[0..<7], s[0].scratch[7..<7 + GP_GLYPHS], s[0].scratch[7 + GP_GLYPHS..<7 + GP_GLYPHS + GP_GLYPHS * GP_GLYPHS]);
}
worldbuilder_set_icon :: (s: [] WorldBuilder, i: int, x: f32, y: f32, w: f32, h: f32) #export_c #effects(all) { if s.count > 0 { gp_set_icon(s[0].atlas[..], i, x, y, w, h); } }
worldbuilder_set_atlas :: (s: [] WorldBuilder, width: f32, height: f32, levels: int) #export_c #effects(all) { if s.count > 0 { gp_set_atlas(s[0].atlas[..], width, height, levels); } }
worldbuilder_set_dynamic :: (s: [] WorldBuilder, size: f32, pen_x: f32, pen_y: f32, y0: f32, cols: int, color_cols: int, color_width: f32, color_height: f32) #export_c #effects(all) {
  if s.count > 0 { gp_set_dynamic(s[0].atlas[..], size, pen_x, pen_y, y0, cols, color_cols, color_width, color_height); }
}
worldbuilder_next_cluster :: (s: [] WorldBuilder) -> int #export_c #effects(all) { if s.count < 1 { return -1; } return gp_next_cluster(s[0].atlas[..]); }
worldbuilder_cluster :: (s: [] WorldBuilder, slot: int) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return gp_cluster(s[0].atlas[..], slot, s[0].sbytes[..]); }
worldbuilder_measured :: (s: [] WorldBuilder, slot: int, advance: f32, color: bool) #export_c #effects(all) { if s.count > 0 { gp_measured(s[0].atlas[..], slot, advance, color); } }
worldbuilder_next_cell :: (s: [] WorldBuilder) -> int #export_c #effects(all) { if s.count < 1 { return -1; } return gp_next_cell(s[0].atlas[..]); }
worldbuilder_cell :: (s: [] WorldBuilder, cell: int) -> bool #export_c #effects(all) { if s.count < 1 { return false; } return gp_cell(s[0].atlas[..], cell, s[0].scratch[0..<6]); }
worldbuilder_cell_ready :: (s: [] WorldBuilder, cell: int) #export_c #effects(all) { if s.count > 0 { gp_cell_ready(s[0].atlas[..], cell); } }

// ---- checks

TEST_CAT :: WB_TEST_CAT;
wb_test_atlas :: (a: [] Atlas) {
  text_test_atlas(a);
  gp_set_atlas(a, 4096, 4096, 2);
  for k: 0..<ICON_COUNT { gp_set_icon(a, k, 0, 0, 32, 32); }
}
ready :: (s: [] WorldBuilder) {
  wb_test_atlas(s[0].atlas[..]);
  worldbuilder_catalog(s, TEST_CAT);
}
frame :: (s: [] WorldBuilder) -> int {
  if !s[0].atlas[0].ready { wb_test_atlas(s[0].atlas[..]); }
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  return worldbuilder_frame(s, out[..], u[..], 1600, 1000, 2, 1.0 / 60.0, false);
}
type_in :: (s: [] WorldBuilder, t: string) { worldbuilder_message(s, MSG_TEXT, t); }
typed_now :: (s: [] WorldBuilder) -> string { return eb_text(s[0].ed[..]); }
body :: (s: [] WorldBuilder) -> string { return cast(string) s[0].req_body[0..<s[0].req_body_n]; }
has :: (t: string, part: string) -> bool {
  if part.count > t.count { return false; }
  for i: 0..<t.count - part.count + 1 { if t[i..<i + part.count] == part { return true; } }
  return false;
}
btn_hit :: (s: [] WorldBuilder, btn: int) -> SheetHit {
  for k: 0..<s[0].nh { if s[0].hits[k].kind == HIT_BUTTON && s[0].hits[k].a == btn { return s[0].hits[k]; } }
  return SheetHit.{};
}
tap_btn :: (s: [] WorldBuilder, btn: int) -> bool {
  h := btn_hit(s, btn);
  if h.w <= 0 { return false; }
  d := wb_scale(s);
  cx := (h.x + h.w * 0.5) * d; cy := (h.y + h.h * 0.5) * d;
  return worldbuilder_pointer(s, cx, cy, POINTER_DOWN, 0, 1) && worldbuilder_pointer(s, cx, cy, POINTER_UP, 0, 1);
}

#test "a typed line goes out as the page's JSON, with here, the camera and what the world holds" {
  s: [1] WorldBuilder;
  ready(s[..]);
  n := frame(s[..]);
  #assert n > 0;
  // the status is asked for at load
  #assert s[0].req_ready && s[0].req_what == REQ_STATUS;
  worldbuilder_requested(s[..], 0);
  worldbuilder_message(s[..], MSG_HTTP + 0, "200\nok 1250000 50000000");
  #assert s[0].known && s[0].spent == 1250000 && !s[0].resting;
  // a tap on the ground in the middle of the screen sets here near where the camera looks
  #assert worldbuilder_pointer(s[..], 800, 500, POINTER_DOWN, 0, 1) && worldbuilder_pointer(s[..], 800, 500, POINTER_UP, 0, 1);
  #assert s[0].has_here && abs(s[0].here_x) < 0.5 && abs(s[0].here_z) < 0.5;
  type_in(s[..], "put a \"tree\" here");
  #assert worldbuilder_key(s[..], KEY_ENTER, true, 0);
  #assert s[0].waiting && s[0].req_ready && s[0].req_what == REQ_ACT && s[0].ed[0].n == 0;
  #assert has(body(s[..]), "{\"text\":\"put a \\\"tree\\\" here\",\"walking\":false,\"here\":[") && has(body(s[..]), "\"present\":{}");
  worldbuilder_requested(s[..], 1);
  // a second line can't go while one is out
  type_in(s[..], "more");
  #assert !worldbuilder_key(s[..], KEY_ENTER, true, 0) || !s[0].req_ready;
  worldbuilder_message(s[..], MSG_HTTP + 1, "200\nS A birch, right there.\nA place|nature/birch-1|1|||here||at||||||\n");
  #assert !s[0].waiting && s[0].world[0].n == 1 && cast(string) s[0].reply[0..<s[0].reply_n] == "A birch, right there.";
  #assert s[0].want_status;
  n = frame(s[..]);
  #assert s[0].draw_n == 1 && s[0].draws[0] == 0 && s[0].draws[1] == 30 && s[0].draws[3] == 1;
  // the world is kept in this browser after the change
  #assert worldbuilder_action(s[..]) == ACT_KEEP && has(cast(string) s[0].outbox[0..<s[0].out_n], "nature/birch-1 ");
}
#test "a flood answer shows the wait and gives the words back; resting says until midnight Chicago time" {
  s: [1] WorldBuilder;
  ready(s[..]);
  type_in(s[..], "add rocks");
  #assert worldbuilder_key(s[..], KEY_ENTER, true, 0);
  worldbuilder_requested(s[..], 2);
  worldbuilder_message(s[..], MSG_HTTP + 2, "429\nflood 1200");
  #assert !s[0].waiting && typed_now(s[..]) == "add rocks" && s[0].flood_until > s[0].time + 1.1;
  #assert !can_send(s[..]);
  s[0].time += 1.3;
  #assert can_send(s[..]);
  #assert worldbuilder_key(s[..], KEY_ENTER, true, 0);
  worldbuilder_requested(s[..], 3);
  worldbuilder_message(s[..], MSG_HTTP + 3, "429\nresting");
  #assert s[0].resting && !can_send(s[..]) && s[0].ed[0].n == 9;
}
#test "the scene draws one instanced draw a mesh, its rows folding in the mesh's box" {
  s: [1] WorldBuilder;
  ready(s[..]);
  v := wb_view(s[..]);
  sum := wb_answer(s[0].world[..], s[0].cat[..], v, "A place|nature/rock-1|5|||origin||at||||||\nA place|nature/birch-1|2|||origin||at||||||\nA place|nature/rock-1|1|||origin||right||||||\n");
  scene(s[..]);
  #assert s[0].draw_n == 2 && s[0].draws[0] == 0 && s[0].draws[2] == 1 && s[0].draws[3] == 2 && s[0].draws[4] == 30 && s[0].draws[6] == 3 && s[0].draws[7] == 6;
  // a rock's corner (0, 0, 0) in its box lands at its spot less half its 1 m footprint, at scale 1 unturned
  o := s[0].world[0].objs[0];
  #assert abs(s[0].objects[3 * INSTANCE_FLOATS + 5] - 0.6 * o.scale) < 0.001;
  // the store's row 0 is the ground's, though a level bare Grid draws none
  #assert worldbuilder_store_bytes(s[..]) == 9 * 64 && s[0].objects[15] == 1;
}
#test "a building draws as its pieces, each turned and placed with it" {
  s: [1] WorldBuilder;
  wb_test_atlas(s[0].atlas[..]);
  worldbuilder_catalog(s[..], WB_PIECES_CAT);
  sum := wb_answer(s[0].world[..], s[0].cat[..], wb_view(s[..]), "A place|house/cottage|1|||origin||at||||||\nA place|village/roof-roundtiles-4x4|1|||origin||right||||||\n");
  scene(s[..]);
  // eight meshes: five walls (the straight one three times), the corner (four), the roof (two: the
  // cottage's and the one alone) and the gable (two)
  #assert s[0].draw_n == 8 && s[0].inst_n == 17 && worldbuilder_store_bytes(s[..]) == 17 * 64;
  #assert s[0].draws[5 * 4 + 3] == 4 && s[0].draws[6 * 4 + 3] == 2;
  // the cottage's roof stands 3 m up
  #assert abs(s[0].objects[s[0].draws[6 * 4 + 2] * INSTANCE_FLOATS + 7] - 3) < 0.001;
}
#test "the page has no undo, redo or brush buttons of its own; a drag turns the view; EDIT opens the editor once the world is kept" {
  s: [1] WorldBuilder;
  ready(s[..]);
  sum := wb_answer(s[0].world[..], s[0].cat[..], wb_view(s[..]), "A place|nature/rock-1|3|||origin||at||||||\n");
  n := frame(s[..]);
  // the buttons: FRAME and EDIT (WALK joins them when your character is there), and SEND
  kinds := 0; for k: 0..<s[0].nh { if s[0].hits[k].kind == HIT_BUTTON { kinds += 1; } }
  #assert kinds == 3 && btn_hit(s[..], BTN_FRAME).w > 0 && btn_hit(s[..], BTN_EDIT).w > 0 && btn_hit(s[..], BTN_SEND).w > 0 && btn_hit(s[..], BTN_VIEW).w == 0;
  yaw := s[0].yaw;
  #assert worldbuilder_pointer(s[..], 600, 500, POINTER_DOWN, 0, 1);
  #assert worldbuilder_pointer(s[..], 700, 520, POINTER_MOVE, 0, 1) && worldbuilder_pointer(s[..], 700, 520, POINTER_UP, 0, 1);
  #assert s[0].yaw != yaw && !s[0].has_here;
  // EDIT: the world is kept first (the frame's save is taken), then the page goes to its address with ?edit
  #assert worldbuilder_action(s[..]) == ACT_KEEP;
  worldbuilder_action_done(s[..]);
  #assert tap_btn(s[..], BTN_EDIT) && s[0].go_edit;
  n = frame(s[..]);
  #assert worldbuilder_action(s[..]) == ACT_GO && cast(string) s[0].outbox[0..<s[0].out_n] == "/create-world?edit" && !s[0].go_edit;
}
#test "Redo works by Cmd/Ctrl+Shift+Z, Cmd/Ctrl+Y, and 'redo' by chat" {
  s: [1] WorldBuilder;
  ready(s[..]);
  _ = frame(s[..]);
  worldbuilder_requested(s[..], 0);
  _ = wb_answer(s[0].world[..], s[0].cat[..], wb_view(s[..]), "A place|nature/birch-1|2|||origin||at||||||\n");
  _ = wb_answer(s[0].world[..], s[0].cat[..], wb_view(s[..]), "A place|nature/rock-1|1|||origin||right||||||\n");
  #assert s[0].world[0].n == 3;
  // Cmd+Z and Ctrl+Z undo both steps
  #assert worldbuilder_key(s[..], 'z', true, MOD_META) && s[0].world[0].n == 2;
  #assert worldbuilder_key(s[..], 'z', true, MOD_CTRL) && s[0].world[0].n == 0;
  // Cmd+Shift+Z and Ctrl+Y redo them
  #assert worldbuilder_key(s[..], 'Z', true, MOD_META | MOD_SHIFT) && s[0].world[0].n == 2;
  #assert worldbuilder_key(s[..], 'y', true, MOD_CTRL) && s[0].world[0].n == 3;
  // "undo" and "redo" typed in chat run locally without asking the model
  type_in(s[..], "undo");
  #assert worldbuilder_key(s[..], KEY_ENTER, true, 0) && !s[0].req_ready && s[0].world[0].n == 2;
  type_in(s[..], "REDO");
  #assert worldbuilder_key(s[..], KEY_ENTER, true, 0) && !s[0].req_ready && s[0].world[0].n == 3;
}
#test "a saved world comes back once the catalogue is in, whichever arrives first" {
  s: [1] WorldBuilder;
  worldbuilder_message(s[..], MSG_SLOT, "WB1\nnature/rock-1 1.000 -2.000 0.000 1.000\nnature/birch-1 3.000 0.000 0.500 1.200\n");
  #assert s[0].world[0].n == 0;
  ready(s[..]);
  #assert s[0].world[0].n == 2;
  n := frame(s[..]);
  // loading isn't a change to keep again
  #assert worldbuilder_action(s[..]) == 0;
}
#test "the chat box uses EditBuf and keeps the site's keys: arrows, click, drag, Shift, Cmd+A/C/X/V and text undo/redo" {
  s: [1] WorldBuilder;
  ready(s[..]);
  _ = frame(s[..]);
  type_in(s[..], "put a tree here");
  #assert worldbuilder_key(s[..], 'a', true, MOD_META) && eb_selected(s[0].ed[..]) == "put a tree here";
  #assert worldbuilder_key(s[..], 'c', true, MOD_META);
  #assert worldbuilder_action(s[..]) == TK_ACT_COPY && cast(string) s[0].outbox[0..<s[0].out_n] == "put a tree here";
  #assert typed_now(s[..]) == "put a tree here";
  worldbuilder_action_done(s[..]);
  #assert !worldbuilder_key(s[..], 'v', true, MOD_META);   // the browser pastes into the field; its text comes as MSG_TEXT
  #assert worldbuilder_key(s[..], 'a', true, MOD_CTRL) && eb_selected(s[0].ed[..]) == "put a tree here";
  worldbuilder_message(s[..], MSG_TEXT, "add rocks");
  #assert eb_sel_lo(s[0].ed[..]) == eb_sel_hi(s[0].ed[..]) && typed_now(s[..]) == "add rocks";
  // EditBuf's own undo and redo on the typed text
  #assert worldbuilder_key(s[..], 'z', true, MOD_META) && typed_now(s[..]) == "put a tree here";
  #assert worldbuilder_key(s[..], 'z', true, MOD_META | MOD_SHIFT) && typed_now(s[..]) == "add rocks";
  // caret movement by arrows and Shift selection, then replacing the selection
  #assert worldbuilder_key(s[..], KEY_LEFT, true, MOD_ALT) && s[0].ed[0].caret == 4;
  #assert worldbuilder_key(s[..], KEY_RIGHT, true, MOD_SHIFT | MOD_ALT) && eb_selected(s[0].ed[..]) == "rocks";
  type_in(s[..], "pines");
  #assert typed_now(s[..]) == "add pines";
  // click places the caret, drag selects across characters (test atlas advances 8 logical px a glyph, dpr = 2)
  _ = frame(s[..]);
  d := wb_scale(s[..]);
  fy := (s[0].field[1] + s[0].field[3]) * 0.5;
  x0 := (s[0].ed_text_x + 4 * 8) * d;
  x1 := (s[0].ed_text_x + 9 * 8) * d;
  #assert worldbuilder_pointer(s[..], x0, fy, POINTER_DOWN, 0, 1) && worldbuilder_pointer(s[..], x0, fy, POINTER_UP, 0, 1);
  #assert s[0].ed[0].caret == 4 && s[0].ed[0].anchor == 4;
  s[0].time += 1.0;   // past double-click window
  #assert worldbuilder_pointer(s[..], x0, fy, POINTER_DOWN, 0, 1);
  #assert worldbuilder_pointer(s[..], x1, fy, POINTER_MOVE, 0, 1) && worldbuilder_pointer(s[..], x1, fy, POINTER_UP, 0, 1);
  #assert eb_selected(s[0].ed[..]) == "pines";
  // Cmd+X cuts only the selection when selected, or the whole line when nothing is selected
  #assert worldbuilder_key(s[..], 'x', true, MOD_META) && worldbuilder_action(s[..]) == TK_ACT_COPY && typed_now(s[..]) == "add ";
  worldbuilder_action_done(s[..]);
  type_in(s[..], "two");
  #assert typed_now(s[..]) == "add two";
  #assert worldbuilder_key(s[..], KEY_BACKSPACE, true, MOD_ALT) && typed_now(s[..]) == "add ";
  #assert worldbuilder_key(s[..], 'a', true, MOD_META) && worldbuilder_key(s[..], KEY_BACKSPACE, true, 0) && s[0].ed[0].n == 0;
  #assert !worldbuilder_key(s[..], 'r', true, MOD_META);   // Cmd+R stays the browser's
}

// A press and a lift at device pixels (x, y).
tap_at :: (s: [] WorldBuilder, x: f32, y: f32) -> bool { return worldbuilder_pointer(s, x, y, POINTER_DOWN, 0, 1) && worldbuilder_pointer(s, x, y, POINTER_UP, 0, 1); }
// The page opened with ?edit, its models in, one frame drawn.
ready_edit :: (s: [] WorldBuilder) {
  ready(s);
  worldbuilder_message(s, MSG_PAGE, "url=http://127.0.0.1:9581/create-world?edit\n");
  _ = frame(s);
}
// The model the shell would be told, read with the shell's own reader.
WbShell :: struct { m: [1] EdModel; scratch: [EM_BYTES] u8; body: [WE_BATCH_BODY] u8; }
shell_reads :: (s: [] WorldBuilder, k: [] WbShell) -> bool { return em_read(k[0].m[..], worldbuilder_edit_model(s), k[0].scratch[..]); }
// The shell's batch of edits (JSON, comma apart), made from the revision its model has.
shell_sends :: (s: [] WorldBuilder, k: [] WbShell, what: string, edits: string) {
  worldbuilder_message(s, MSG_BATCH, wbe_body_at(k[0].body[..], s[0].world[0].rev, what, edits));
}
shell_no :: (k: [] WbShell) -> string { m := k[0].m[..]; return cast(string) m[0].no[0..<m[0].no_n]; }
#test "?edit: the page tells the shell its world and takes its batches: place, move, turn, size and remove are each one revision, undo and redo walk them, and a refusal comes back in words" #steps 4000000000 {
  s: [1] WorldBuilder; k: [1] WbShell; m := k[0].m[..];
  ready(s[..]);
  _ = frame(s[..]);
  // without ?edit the page tells no shell anything and takes none of its messages
  #assert worldbuilder_edit_model(s[..]) == "" && worldbuilder_edit_rev(s[..]) == 0 && btn_hit(s[..], BTN_EDIT).w > 0;
  shell_sends(s[..], k[..], "apply", "{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":0,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}");
  #assert s[0].world[0].n == 0;
  worldbuilder_message(s[..], MSG_PAGE, "url=http://127.0.0.1:9581/create-world?edit\n");
  _ = frame(s[..]);
  // with it: no EDIT button, and the model names the world, kept on this device, with its limit and its land's brushes
  #assert s[0].edit && btn_hit(s[..], BTN_EDIT).w == 0 && shell_reads(s[..], k[..]);
  #assert m[0].local && m[0].all && m[0].all_n == 0 && m[0].all_cap == 4096 && m[0].land && m[0].nm == 7 && m[0].rev == 0 && m[0].undo == 0 && m[0].ne == 0;
  r0 := worldbuilder_edit_rev(s[..]);
  shell_sends(s[..], k[..], "apply", "{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":300,\"y\":0,\"z\":-400,\"yaw\":0,\"scale\":100}");
  #assert s[0].world[0].n == 1 && s[0].world[0].rev == 1 && worldbuilder_edit_rev(s[..]) != r0 && shell_reads(s[..], k[..]) && m[0].ne == 1 && m[0].rev == 1 && m[0].undo == 1 && m[0].e_x[0] == 300 && m[0].e_z[0] == -400;
  shell_sends(s[..], k[..], "apply", "{\"op\":\"move\",\"id\":1,\"x\":500,\"y\":0,\"z\":-400}");
  shell_sends(s[..], k[..], "apply", "{\"op\":\"rotate\",\"id\":1,\"yaw\":90}");
  shell_sends(s[..], k[..], "apply", "{\"op\":\"scale\",\"id\":1,\"scale\":150}");
  #assert shell_reads(s[..], k[..]) && m[0].rev == 4 && m[0].undo == 4 && m[0].e_x[0] == 500 && m[0].e_yaw[0] == 90 && m[0].e_scale[0] == 150;
  // the scene draws it where it now stands
  _ = frame(s[..]);
  #assert abs(s[0].objects[INSTANCE_FLOATS + 3] - (5 - 0.5 * 1.5 * 0)) < 1.0 && worldbuilder_action(s[..]) == ACT_KEEP;
  worldbuilder_action_done(s[..]);
  shell_sends(s[..], k[..], "undo", "");
  #assert shell_reads(s[..], k[..]) && m[0].rev == 5 && m[0].undo == 3 && m[0].redo == 1 && m[0].e_scale[0] == 100;
  shell_sends(s[..], k[..], "redo", "");
  #assert shell_reads(s[..], k[..]) && m[0].rev == 6 && m[0].redo == 0 && m[0].e_scale[0] == 150;
  // the shell selects a thing by its number; a number no thing has selects nothing
  worldbuilder_message(s[..], MSG_SELECT, "1");
  #assert shell_reads(s[..], k[..]) && m[0].sel == 1;
  worldbuilder_message(s[..], MSG_SELECT, "44");
  #assert shell_reads(s[..], k[..]) && m[0].sel == 0;
  // refused in words: a kind the models have not, a stale revision, a publish; the world is as it was
  shell_sends(s[..], k[..], "apply", "{\"op\":\"spawn\",\"id\":0,\"kind\":999,\"x\":0,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}");
  #assert shell_reads(s[..], k[..]) && shell_no(k[..]) == "The models have no such kind." && m[0].rev == 6 && m[0].ne == 1;
  worldbuilder_message(s[..], MSG_BATCH, wbe_body_at(k[0].body[..], 2, "apply", "{\"op\":\"despawn\",\"id\":1}"));
  #assert shell_reads(s[..], k[..]) && shell_no(k[..]) == "The world changed since that was made. Try again." && m[0].ne == 1;
  shell_sends(s[..], k[..], "publish-now", "");
  #assert shell_reads(s[..], k[..]) && shell_no(k[..]) == "This world is kept in this browser. It has nowhere to publish to.";
  // while a command to the model is out, the world is about to change: a batch waits
  worldbuilder_requested(s[..], 0);
  type_in(s[..], "add rocks");
  #assert worldbuilder_key(s[..], KEY_ENTER, true, 0) && s[0].waiting;
  shell_sends(s[..], k[..], "apply", "{\"op\":\"despawn\",\"id\":1}");
  #assert s[0].world[0].n == 1 && shell_reads(s[..], k[..]) && shell_no(k[..]) == "The last change is still on its way. Try again.";
  worldbuilder_requested(s[..], 1);
  worldbuilder_message(s[..], MSG_HTTP + 1, "200\nS Rocks.\nA place|nature/rock-2|2|||origin||around||||||\n");
  // the chat's edits are typed edits of the same log: the revision moved by one for each thing, and the shell's undo takes the command back
  #assert s[0].world[0].n == 3 && s[0].world[0].rev == 8 && shell_reads(s[..], k[..]) && m[0].ne == 3 && m[0].undo == 5;
  shell_sends(s[..], k[..], "apply", "{\"op\":\"despawn\",\"id\":1}");
  #assert shell_reads(s[..], k[..]) && m[0].ne == 2 && m[0].no_n == 0 && m[0].rev == 9;
  shell_sends(s[..], k[..], "undo", ""); shell_sends(s[..], k[..], "undo", "");
  #assert s[0].world[0].n == 1 && wb_mesh_name(s[0].cat[..], s[0].world[0].objs[0].mesh) == "nature/rock-1";
}
#test "?edit: over the thing limit the shell's Add is refused in words, and the page's own line says the same" #steps 4000000000 {
  s: [1] WorldBuilder; k: [1] WbShell; m := k[0].m[..];
  ready_edit(s[..]);
  sc := wb_scene(s[0].world[..]);
  for i: 0..<WB_OBJECTS { _ := forge_scene_load(sc, 1, cast(f32) (i % 64), 0, cast(f32) (i / 64), 0, 1); }
  wb_sync(s[0].world[..]); s[0].world[0].version += 1;
  shell_sends(s[..], k[..], "apply", "{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":0,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}");
  #assert shell_reads(s[..], k[..]) && shell_no(k[..]) == "This world is full: 4096 things at most. Delete some to add more." && s[0].world[0].n == WB_OBJECTS && s[0].world[0].rev == 0;
  // the model lists the newest 256 and says how many there are and how many the world takes
  #assert m[0].ne == EM_ENTS && m[0].all_n == WB_OBJECTS && m[0].all_cap == WB_OBJECTS;
}
#test "?edit: with a tool picked the pointer is the viewport's: a tap selects the thing under it and marks here, a drag moves, turns and sizes it as one edit each, and Add plans several clear of what stands" #steps 4000000000 {
  s: [1] WorldBuilder; k: [1] WbShell; m := k[0].m[..];
  ready_edit(s[..]);
  shell_sends(s[..], k[..], "apply", "{\"op\":\"spawn\",\"id\":0,\"kind\":4,\"x\":0,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}");
  _ = frame(s[..]);
  // Play: a tap on the ground is "here" for the chat and for the shell's Add, and selects nothing
  #assert tap_at(s[..], 300, 700) && s[0].has_here && s[0].ep[0].here && s[0].ep[0].sel == 0;
  worldbuilder_message(s[..], MSG_VIEW, "tool select");
  #assert !hands(s[..]) && s[0].vp[0].tool == VT_SELECT;
  // the house stands where the view looks: a tap in the middle selects it
  #assert tap_at(s[..], 800, 500) && s[0].ep[0].sel == 1 && shell_reads(s[..], k[..]) && m[0].sel == 1 && m[0].here;
  _ = frame(s[..]);
  // a ring is drawn round it
  u: [UNIFORM_FLOATS] f32; out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  _ = worldbuilder_frame(s[..], out[..], u[..], 1600, 1000, 2, 1.0 / 60.0, false);
  #assert u[BRUSH_AT + 1] > 4 && u[BRUSH_AT + 3] > 0.5 && abs(u[BRUSH_AT]) < 0.01;
  // Move: a drag from the house along the ground is one move edit, snapped to the grid, and the thing is drawn where the drag has it meanwhile
  worldbuilder_message(s[..], MSG_VIEW, "tool move");
  rev := s[0].world[0].rev;
  #assert worldbuilder_pointer(s[..], 800, 500, POINTER_DOWN, 0, 1) && worldbuilder_pointer(s[..], 1000, 500, POINTER_MOVE, 0, 1);
  #assert vp_dragging(s[0].vp[..]) && s[0].vp[0].now.x != 0 && s[0].vp[0].now.x % 50 == 0;
  _ = frame(s[..]);
  #assert s[0].drag_key != 0 && s[0].world[0].objs[0].x == 0;
  #assert worldbuilder_pointer(s[..], 1000, 500, POINTER_UP, 0, 1);
  #assert s[0].world[0].rev == rev + 1 && s[0].world[0].objs[0].x != 0 && s[0].world[0].fg[0].done == 2 && s[0].yaw == 0;
  // Turn and Size: a drag sideways, a drag up
  at := vp_project(s[0].vview, s[0].world[0].objs[0].x, 1, 0);
  worldbuilder_message(s[..], MSG_VIEW, "tool turn");
  #assert worldbuilder_pointer(s[..], at.x, at.y, POINTER_DOWN, 0, 1) && worldbuilder_pointer(s[..], at.x + 90, at.y, POINTER_MOVE, 0, 1) && worldbuilder_pointer(s[..], at.x + 90, at.y, POINTER_UP, 0, 1);
  #assert s[0].world[0].rev == rev + 2 && abs(s[0].world[0].objs[0].yaw - 0.7853982) < 0.01;
  worldbuilder_message(s[..], MSG_VIEW, "tool size");
  #assert worldbuilder_pointer(s[..], at.x, at.y, POINTER_DOWN, 0, 1) && worldbuilder_pointer(s[..], at.x, at.y - 100, POINTER_MOVE, 0, 1) && worldbuilder_pointer(s[..], at.x, at.y - 100, POINTER_UP, 0, 1);
  #assert s[0].world[0].rev == rev + 3 && abs(s[0].world[0].objs[0].scale - 1.5) < 0.001 && s[0].world[0].fg[0].done == 4;
  // a drag that holds nothing turns the view, and a tap on bare ground selects nothing
  worldbuilder_message(s[..], MSG_VIEW, "tool select");
  #assert worldbuilder_pointer(s[..], 200, 700, POINTER_DOWN, 0, 1) && worldbuilder_pointer(s[..], 300, 700, POINTER_MOVE, 0, 1) && worldbuilder_pointer(s[..], 300, 700, POINTER_UP, 0, 1) && s[0].yaw != 0 && s[0].ep[0].sel == 1;
  _ = frame(s[..]);
  #assert tap_at(s[..], 100, 760) && s[0].ep[0].sel == 0;
  // Add, several: planned from here, clear of each other and of the house, as one batch and one step
  worldbuilder_message(s[..], MSG_PLAN, "add 2 5");
  #assert s[0].world[0].n == 6 && s[0].world[0].rev == rev + 8 && s[0].world[0].fg[0].done == 5;
  for i: 1..<6 { for j: 0..<i { dx := s[0].world[0].objs[i].x - s[0].world[0].objs[j].x; dz := s[0].world[0].objs[i].z - s[0].world[0].objs[j].z; #assert dx * dx + dz * dz > 0.25; } }
  // what is no plan, or names no kind, places nothing
  worldbuilder_message(s[..], MSG_PLAN, "add 999 3"); worldbuilder_message(s[..], MSG_PLAN, "add 2"); worldbuilder_message(s[..], MSG_PLAN, "drop 2 3");
  #assert s[0].world[0].n == 6;
}
#test "?edit: the land's brush is the viewport's: a held brush dabs typed terrain edits, a stroke is one undo step, and things stay on the ground" #steps 4000000000 {
  s: [1] WorldBuilder; k: [1] WbShell; m := k[0].m[..];
  ready_edit(s[..]);
  w := s[0].world[..]; l := w[0].land[..];
  shell_sends(s[..], k[..], "apply", "{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":0,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}");
  _ = frame(s[..]);
  #assert s[0].draw_n == 1 && worldbuilder_action(s[..]) == ACT_KEEP;
  worldbuilder_action_done(s[..]);
  // the shell picks the tool and tells the brush: raise, 8 m, full strength
  worldbuilder_message(s[..], MSG_VIEW, "tool land"); worldbuilder_message(s[..], MSG_VIEW, "brush raise"); worldbuilder_message(s[..], MSG_VIEW, "radius 800"); worldbuilder_message(s[..], MSG_VIEW, "strength 100");
  #assert brushing(s[..]) && worldbuilder_cursor(s[..]) == 2;
  _ = frame(s[..]);
  rev := w[0].rev;
  #assert worldbuilder_pointer(s[..], 800, 500, POINTER_DOWN, 0, 1) && s[0].stroking && w[0].rev == rev + 1;
  model_rev := worldbuilder_edit_rev(s[..]);
  for i: 0..<20 { _ = worldbuilder_pointer(s[..], 800 + cast(f32) i, 500, POINTER_MOVE, 0, 1); _ = frame(s[..]); }
  // a dab every thirtieth of a second while it is held, and the shell is not told of each
  #assert w[0].rev >= rev + 9 && w[0].rev <= rev + 12 && worldbuilder_edit_rev(s[..]) == model_rev;
  yaw := s[0].yaw;
  #assert worldbuilder_pointer(s[..], 820, 500, POINTER_UP, 0, 1) && !s[0].stroking && s[0].yaw == yaw;
  top := wb_land_y(l, 0, 0);
  #assert top > 1 && !l[0].bare && w[0].fg[0].step_n == 2 && shell_reads(s[..], k[..]) && m[0].undo == 2 && m[0].rev == w[0].rev && m[0].e_y[0] > 100;
  _ = frame(s[..]);
  // the ground draws first, one draw without an index buffer; the rock stands on the hill; the GPU's copy has its height
  #assert s[0].draw_n == 2 && s[0].draws[1] == 393216 && s[0].draws[2] == 0x80000000 && s[0].draws[6] == 1;
  #assert abs(s[0].objects[INSTANCE_FLOATS + 7] - top) < 0.001 && s[0].ground[(128 * WB_LAND_SIDE + 128) * 4] == top;
  #assert worldbuilder_ground_version(s[..]) > 0 && worldbuilder_action(s[..]) == ACT_KEEP && has(cast(string) s[0].outbox[0..<s[0].out_n], "~H 128 ");
  worldbuilder_action_done(s[..]);
  // paint sand, 8 m, full strength: one tap is one dab
  worldbuilder_message(s[..], MSG_VIEW, "brush paint"); worldbuilder_message(s[..], MSG_VIEW, "mat 3");
  _ = frame(s[..]);
  #assert tap_at(s[..], 800, 300);
  at := (cast(int) floor(s[0].brush_z + 128.5)) * WB_LAND_SIDE + cast(int) floor(s[0].brush_x + 128.5);
  #assert terrain_edit_share(wb_land_edit(l), at, L_SAND) > 0.9 && w[0].fg[0].step_n == 3 && !s[0].has_here;
  _ = frame(s[..]);
  #assert s[0].ground[at * 4 + 1] >= 230 * 65536;
  // the brush's ring is drawn under the pointer, as wide as the brush
  #assert !worldbuilder_pointer(s[..], 800, 300, POINTER_MOVE, 0, 1) && s[0].brush_shown;
  u: [UNIFORM_FLOATS] f32; out: [MAX_VERTICES * VERTEX_FLOATS] f32;
  _ = worldbuilder_frame(s[..], out[..], u[..], 1600, 1000, 2, 1.0 / 60.0, false);
  #assert u[BRUSH_AT + 1] == 8 && u[BRUSH_AT + 3] > 0.5;
  // the shell's undo takes the paint back, then the hill; the rock comes down with it
  shell_sends(s[..], k[..], "undo", "");
  #assert terrain_edit_share(wb_land_edit(l), at, L_SAND) == 0;
  shell_sends(s[..], k[..], "undo", "");
  #assert l[0].bare;
  _ = frame(s[..]);
  #assert s[0].draw_n == 1 && s[0].objects[INSTANCE_FLOATS + 7] == 0;
  // another tool puts the brush away: a tap is a pick again
  worldbuilder_message(s[..], MSG_VIEW, "tool select");
  #assert !brushing(s[..]) && tap_at(s[..], 800, 300) && s[0].has_here && w[0].fg[0].step_n == 3 && w[0].fg[0].done == 1;
}
#test "?edit: the page's own HUD is laid out in the room the shell's panes leave; the camera flies on its keys; pause stops the world's clock" {
  s: [1] WorldBuilder;
  ready_edit(s[..]);
  whole := btn_hit(s[..], BTN_SEND);
  // the room, in CSS pixels of an 800 by 500 window: the strip above, a pane each side, the foot below
  worldbuilder_message(s[..], MSG_ROOM, "300 70 400 420");
  _ = frame(s[..]);
  #assert !s[0].room_on && btn_hit(s[..], BTN_SEND).x == whole.x;   // too small to be a room: the whole window
  worldbuilder_message(s[..], MSG_ROOM, "290 70 620 430");
  _ = frame(s[..]);
  send := btn_hit(s[..], BTN_SEND); fr := btn_hit(s[..], BTN_FRAME);
  #assert s[0].room_on && send.x > 290 && send.x + send.w < 620 && send.y + send.h < 430 && send.y > 70 && fr.x > 290 && fr.x + fr.w <= 620 && fr.y >= 70;
  #assert s[0].field[0] >= 290 * 2 && s[0].field[3] <= 430 * 2;
  // fly: the camera leaves the overview's and W moves it ahead; the keys come back to the chat box when it is pressed
  eye := s[0].eye;
  worldbuilder_message(s[..], MSG_VIEW, "fly on");
  #assert flying(s[..]) && !worldbuilder_wants_text(s[..]) && worldbuilder_key(s[..], 'w', true, 0);
  for i: 0..<30 { _ = frame(s[..]); }
  d := (s[0].eye[0] - eye[0]) * (s[0].eye[0] - eye[0]) + (s[0].eye[1] - eye[1]) * (s[0].eye[1] - eye[1]) + (s[0].eye[2] - eye[2]) * (s[0].eye[2] - eye[2]);
  #assert d > 9 && s[0].ed[0].n == 0;
  #assert worldbuilder_key(s[..], 'w', false, 0) && !s[0].vkeys[0];
  // a drag looks around
  fyaw := s[0].vp[0].fyaw;
  #assert worldbuilder_pointer(s[..], 900, 400, POINTER_DOWN, 0, 1) && worldbuilder_pointer(s[..], 960, 400, POINTER_MOVE, 0, 1) && worldbuilder_pointer(s[..], 960, 400, POINTER_UP, 0, 1) && s[0].vp[0].fyaw != fyaw;
  worldbuilder_message(s[..], MSG_VIEW, "fly off");
  #assert !flying(s[..]) && worldbuilder_wants_text(s[..]);
  // pause and step are the editor's clock
  #assert worldbuilder_run_dt(s[..], 0.016) == 0.016;
  worldbuilder_message(s[..], MSG_VIEW, "run pause");
  #assert worldbuilder_run_dt(s[..], 0.016) == 0;
  worldbuilder_message(s[..], MSG_VIEW, "step");
  #assert worldbuilder_run_dt(s[..], 0.016) > 0.016 && worldbuilder_run_dt(s[..], 0.016) == 0;
}
#test "FRAME and a command bring everything built into view; the person's own move is left alone a while" {
  s: [1] WorldBuilder;
  ready(s[..]);
  _ = frame(s[..]);
  worldbuilder_requested(s[..], 0);
  type_in(s[..], "a row of houses");
  #assert worldbuilder_key(s[..], KEY_ENTER, true, 0);
  worldbuilder_requested(s[..], 1);
  worldbuilder_message(s[..], MSG_HTTP + 1, "200\nS Houses.\nA place|village/house-1|1|||origin||at||||||\nA place|village/house-1|1|||origin||right|60|||||\n");
  // two houses some 70 m apart: the view goes to their middle and pulls back to hold them
  #assert s[0].framing && s[0].gx > 25 && s[0].goal_dist > 50 && s[0].goal_dist < 160;
  for k: 0..<240 { _ = frame(s[..]); }
  #assert !s[0].framing && abs(s[0].dist - s[0].goal_dist) < 0.02 && abs(s[0].tx - s[0].gx) < 0.1;
  // the wheel moves it by a share of the distance, and a command right after leaves the view where the person put it
  far := s[0].dist;
  #assert worldbuilder_wheel(s[..], -200) && abs(s[0].dist - far * 0.7408182) < 0.01;
  near := s[0].dist;
  type_in(s[..], "another");
  #assert worldbuilder_key(s[..], KEY_ENTER, true, 0);
  worldbuilder_requested(s[..], 2);
  worldbuilder_message(s[..], MSG_HTTP + 2, "200\nS One more.\nA place|village/house-1|1|||origin||left|80|||||\n");
  #assert !s[0].framing && s[0].dist == near;
  // FRAME (the button, or Cmd/Ctrl+.) frames all three
  _ = frame(s[..]);
  #assert tap_btn(s[..], BTN_FRAME) && s[0].framing && s[0].goal_dist > far;
  s[0].framing = false;
  #assert worldbuilder_key(s[..], '.', true, MOD_CTRL) && s[0].framing;
}
