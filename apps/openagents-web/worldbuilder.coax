// WorldBuilder (openagents.com/create-world): an empty Grid and one line to type in, bottom
// centre. What you type goes to /api/worldbuilder/act (coax/web/api/worldbuilder.c), which asks
// the model for typed edits; worldbuilder-plan.coax carries them out on the world, drawn here from
// the Quaternius pack (worldbuilder_pack.coax), each mesh one instanced draw. A tap or click on the
// ground says where "here" is. The world is kept in this browser (the slot's save, host action 4).
//
// The limits are shown, never hidden: the day's shared spend and its $50 cap, a visitor's pace
// (4 at once, then one every 1.5 s), and how many things a world holds.
//   coax/bin/coax test apps/openagents-web/worldbuilder.coax

#load "font.coax";
#load "ui.coax";
#load "worldbuilder-plan.coax";

VERTEX_FLOATS :: 16;
MAX_VERTICES :: 24000;
PLATES :: 16;
VIEW_AT :: 8; HERE_AT :: 24; EYE_AT :: 28; RAY_AT :: 32;
PANEL_AT :: 44;
UNIFORM_FLOATS :: PANEL_AT + PLATES * 8;
MODE_STROKE :: 0.0;
MODE_BAR :: 4.0;   // ui.coax's

MSG_DATA_TEXT :: 2;
MSG_SLOT :: 4;          // host.js: the slot's save, given back on a visit
HOST_FACTS :: 600;
MSG_PACK :: 605;
MSG_HTTP :: 512;        // host.js: answer to request id as message 512 + id
ACT_KEEP :: 4;
INSTANCE_FLOATS :: 16;
WB_INSTANCES :: 12288;  // pieces drawn: a building is a dozen or so
TYPED :: 300;
REPLY :: 200;
BODY :: 15000;
SAVE_CAP :: 262144;
ACT_URL :: "/api/worldbuilder/act";
STATUS_URL :: "/api/worldbuilder/status";
RECENT :: 24;
PRESENT :: 60;
FOV :: 0.9;
PITCH_LO :: 0.18; PITCH_HI :: 1.45;
DIST_LO :: 3.0; DIST_HI :: 160.0;
TAP_SLOP :: 8.0;        // CSS pixels a press may move and still be a tap
BTN_SEND :: 0; BTN_UNDO :: 1; BTN_FIELD :: 2; BUTTONS :: 3;
REPLY_PLAIN :: 0; REPLY_NOTICE :: 1;

WorldBuilder :: struct {
  started: bool;
  time: f32; width: f32; height: f32; dpr: f32; still: bool; golden: bool;
  // the camera: it looks at (tx, tz) from dist away, turned yaw (0 looks along -z), pitch down
  tx: f32; tz: f32; gx: f32; gz: f32; yaw: f32; pitch: f32 = 0.6; dist: f32 = 26;
  // pointers: one drags the view, two pinch it nearer
  down: bool; down_id: int; down_x: f32; down_y: f32; last_x: f32; last_y: f32; moved: bool; on_ui: int = -1;
  two: bool; two_id: int; two_x: f32; two_y: f32; pinch: f32;
  // "here": the spot last tapped
  has_here: bool; here_x: f32; here_z: f32; here_at: f32;
  // the line typed, the words sent (shown while the answer comes), the one line answered
  typed: [TYPED] u8; typed_n: int;
  heard: [TYPED] u8; heard_n: int;
  reply: [REPLY] u8; reply_n: int; reply_kind: int; reply_at: f32;
  waiting: bool; act_id: int = -1; status_id: int = -1; want_status: bool = true;
  // the request the face hands to the host
  req_url: [64] u8; req_url_n: int; req_body: [BODY] u8; req_body_n: int; req_ready: bool; req_flags: int; req_what: int;
  // the limits: the day's spend and cap (millionths of a dollar), resting, the pace
  spent: int; cap: int = 50000000; known: bool; resting: bool; flood_until: f32;
  // the world and the pack
  world: [1] WbWorld; cat: [1] WbCat; cat_ready: bool; pack_failed: bool; loaded: int; total: int;
  saved: [SAVE_CAP] u8; saved_n: int; saved_waiting: bool; saved_version: int;
  outbox: [SAVE_CAP] u8; out_n: int; action: int;
  drawn_version: int = -1;
  draws: [WB_MESHES * 4] u32; draw_n: int;
  objects: [WB_INSTANCES * INSTANCE_FLOATS] f32; inst_n: int;
  view: [16] f32; eye: [3] f32; fwd: [3] f32; right: [3] f32; up: [3] f32;
  plates: [PLATES] Box; plate_look: [PLATES] f32; plate_alpha: [PLATES] f32; plate_n: int;
  boxes: [BUTTONS] Box; shown: [BUTTONS] bool; press: int = -1; hover: int = -1;
  field: [4] f32;
}
REQ_ACT :: 1; REQ_STATUS :: 2;

lo :: (a: f32, b: f32) -> f32 { if a < b { return a; } return b; }
hi :: (a: f32, b: f32) -> f32 { if a > b { return a; } return b; }
clamp :: (a: f32, low: f32, high: f32) -> f32 { return lo(high, hi(low, a)); }
ease :: (x: f32) -> f32 { t := clamp(x, 0, 1); return t * t * (3 - 2 * t); }

// One stroke as a quad wide enough for its glow (droprealm.coax's).
lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  length := sqrt(dx * dx + dy * dy);
  if length <= 0 { return false; }
  ux := dx / length; uy := dy / length;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, length + r, length + r, -r, length + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = length; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

// A round light: a disc of radius radius in a glow (droprealm.coax's).
tinted_dot :: (out: [] f32, at: int, x: f32, y: f32, radius: f32, light: f32, glow: f32, red: f32, green: f32, blue: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count || light <= 0 { return false; }
  r := radius + glow;
  a := [6] f32.[-r, r, r, -r, r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = x + a[v]; out[o + 1] = y + c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = 0; out[o + 5] = radius; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = MODE_STROKE;
    out[o + 12] = 0; out[o + 13] = 0; out[o + 14] = 0; out[o + 15] = 0;
  }
  return true;
}

// ---- in from the host

wb_begin :: (s: [] WorldBuilder) {
  if s[0].started { return; }
  s[0].started = true;
  s[0].world[0].seed = 13207;
}

int_of :: (t: string) -> int { at: [1] int; v := wb_int_at(t, at[..]); return ifx at[0] < 0 then -1 else v; }
// The answer's status line: "STATUS\n" then the body.
status_of :: (t: string) -> int { e := 0; while e < t.count && t[e] != '\n' { e += 1; } return int_of(t[0..<e]); }
body_of :: (t: string) -> string { e := 0; while e < t.count && t[e] != '\n' { e += 1; } return ifx e + 1 <= t.count then t[e + 1..<t.count] else ""; }

set_reply :: (s: [] WorldBuilder, text: string, kind: int) {
  s[0].reply_n = put(s[0].reply[..], 0, text); s[0].reply_kind = kind; s[0].reply_at = s[0].time;
}
// The words sent come back to the field when they weren't carried out, to send again.
give_back :: (s: [] WorldBuilder) {
  if s[0].typed_n == 0 { s[0].typed_n = put(s[0].typed[..], 0, cast(string) s[0].heard[0..<s[0].heard_n]); }
  s[0].heard_n = 0;
}

wb_view :: (s: [] WorldBuilder) -> WbView {
  return WbView.{has_here = s[0].has_here, here_x = s[0].here_x, here_z = s[0].here_z, view_x = s[0].gx, view_z = s[0].gz, yaw = s[0].yaw};
}

take_act :: (s: [] WorldBuilder, text: string) {
  s[0].waiting = false; s[0].act_id = -1;
  st := status_of(text); body := body_of(text);
  if st == 200 {
    sum := wb_answer(s[0].world[..], s[0].cat[..], wb_view(s), body);
    s[0].heard_n = 0;
    if sum.say_n > 0 { set_reply(s, cast(string) sum.say[0..<sum.say_n], REPLY_PLAIN); }
    else if sum.edits == 0 { set_reply(s, "Nothing changed.", REPLY_PLAIN); }
    else { s[0].reply_n = 0; }
    if s[0].world[0].full { set_reply(s, "This world is full: 4096 things at most. Delete some to add more.", REPLY_NOTICE); }
    s[0].want_status = true;
    return;
  }
  give_back(s);
  if st == 429 && body.count >= 5 && body[0..<5] == "flood" {
    wait := int_of(body[5..<body.count]);
    s[0].flood_until = s[0].time + cast(f32) (ifx wait > 0 then wait else 1500) / 1000;
    set_reply(s, "Too fast for the shared line.", REPLY_NOTICE);
    return;
  }
  if st == 429 { s[0].resting = true; set_reply(s, "", REPLY_NOTICE); return; }
  set_reply(s, "That didn't go through. Send it again.", REPLY_NOTICE);
}
take_status :: (s: [] WorldBuilder, text: string) {
  s[0].status_id = -1;
  if status_of(text) != 200 { return; }
  b := body_of(text);
  at: [1] int;
  w := 0; while w < b.count && b[w] != ' ' { w += 1; }
  at[0] = w;
  spent := wb_int_at(b, at[..]); if at[0] < 0 { return; }
  cap := wb_int_at(b, at[..]); if at[0] < 0 || cap <= 0 { return; }
  s[0].spent = spent; s[0].cap = cap; s[0].known = true;
  s[0].resting = b[0..<w] == "resting";
}
load_saved :: (s: [] WorldBuilder) {
  if !s[0].saved_waiting || !s[0].cat_ready { return; }
  s[0].saved_waiting = false;
  n := wb_load(s[0].world[..], s[0].cat[..], cast(string) s[0].saved[0..<s[0].saved_n]);
  s[0].saved_version = s[0].world[0].version;
}

worldbuilder_message :: (s: [] WorldBuilder, kind: int, text: string) #export_c #effects(all) {
  wb_begin(s);
  if kind == MSG_PACK {
    at: [1] int;
    s[0].loaded = wb_int_at(text, at[..]); if at[0] < 0 { return; }
    s[0].total = wb_int_at(text, at[..]); if at[0] < 0 { s[0].total = 0; }
    return;
  }
  if kind == MSG_TEXT {
    for i: 0..<text.count { if s[0].typed_n < TYPED && text[i] >= 32 { s[0].typed[s[0].typed_n] = text[i]; s[0].typed_n += 1; } }
    return;
  }
  if kind == MSG_SLOT {
    s[0].saved_n = put(s[0].saved[..], 0, text); s[0].saved_waiting = true;
    load_saved(s);
    return;
  }
  if kind >= MSG_HTTP && kind < MSG_HTTP + 8 {
    id := kind - MSG_HTTP;
    if id == s[0].act_id { take_act(s, text); }
    else if id == s[0].status_id { take_status(s, text); }
  }
}
worldbuilder_catalog :: (s: [] WorldBuilder, text: string) #export_c #effects(all) {
  wb_begin(s);
  wb_catalog(s[0].cat[..], text);
  s[0].cat_ready = s[0].cat[0].n > 0;
  s[0].drawn_version = -1;
  load_saved(s);
}
worldbuilder_pack_failed :: (s: [] WorldBuilder) #export_c #effects(all) { if !s[0].cat_ready { s[0].pack_failed = true; } }

// ---- out to the host: the request (the face hands it over), the save

put_json_text :: (b: [] u8, at: int, t: string) -> int {
  n := put(b, at, "\"");
  for i: 0..<t.count {
    c := t[i];
    if c == '"' || c == '\\' { n = put(b, n, "\\"); }
    if c >= 32 && n < b.count { b[n] = c; n += 1; }
  }
  return put(b, n, "\"");
}
// The page's turn for the model: what was typed, here, the camera, what the world holds, the
// newest things and what the last edit touched (coax/web/api/worldbuilder.c WB_SYSTEM reads it).
build_act :: (s: [] WorldBuilder, words: string) -> int {
  b := s[0].req_body[..]; w := s[0].world[..]; c := s[0].cat[..];
  n := put(b, 0, "{\"text\":"); n = put_json_text(b, n, words);
  n = put(b, n, ",\"here\":");
  if s[0].has_here { n = put(b, n, "["); n = wb_put_num(b, n, s[0].here_x); n = put(b, n, ","); n = wb_put_num(b, n, s[0].here_z); n = put(b, n, "]"); }
  else { n = put(b, n, "null"); }
  n = put(b, n, ",\"cam\":{\"x\":"); n = wb_put_num(b, n, s[0].gx); n = put(b, n, ",\"z\":"); n = wb_put_num(b, n, s[0].gz);
  n = put(b, n, ",\"looks\":["); n = wb_put_num(b, n, sin(s[0].yaw)); n = put(b, n, ","); n = wb_put_num(b, n, -cos(s[0].yaw)); n = put(b, n, "]}");
  // what the world holds: each asset and how many
  n = put(b, n, ",\"present\":{");
  counts: [WB_MESHES] int;
  for i: 0..<w[0].n { counts[w[0].objs[i].mesh] += 1; }
  shown := 0;
  for m: 0..<c[0].n {
    if counts[m] == 0 || shown >= PRESENT { continue; }
    if shown > 0 { n = put(b, n, ","); }
    n = put_json_text(b, n, wb_mesh_name(c, m)); n = put(b, n, ":"); n = put_int(b, n, counts[m]);
    shown += 1;
  }
  n = put(b, n, "},\"recent\":[");
  from := ifx w[0].n > RECENT then w[0].n - RECENT else 0;
  for i: from..<w[0].n {
    o := w[0].objs[i];
    if i > from { n = put(b, n, ","); }
    n = put(b, n, "{\"id\":"); n = put_int(b, n, o.id); n = put(b, n, ",\"asset\":"); n = put_json_text(b, n, wb_mesh_name(c, o.mesh));
    n = put(b, n, ",\"x\":"); n = wb_put_num(b, n, o.x); n = put(b, n, ",\"z\":"); n = wb_put_num(b, n, o.z);
    n = put(b, n, ",\"size\":"); n = wb_put_num(b, n, o.scale); n = put(b, n, "}");
  }
  n = put(b, n, "],\"last\":[");
  seen: [WB_MESHES] bool; first := true;
  for k: 0..<w[0].last_n {
    i := wb_index(w, w[0].last[k]);
    if i < 0 || seen[w[0].objs[i].mesh] { continue; }
    seen[w[0].objs[i].mesh] = true;
    if !first { n = put(b, n, ","); }
    first = false;
    n = put_json_text(b, n, wb_mesh_name(c, w[0].objs[i].mesh));
  }
  n = put(b, n, "]}");
  return n;
}
ask :: (s: [] WorldBuilder, url: string, body_n: int, flags: int, what: int) {
  s[0].req_url_n = put(s[0].req_url[..], 0, url);
  s[0].req_body_n = body_n; s[0].req_flags = flags; s[0].req_ready = true; s[0].req_what = what;
}
// The face hands the request to the host and gives its id back here.
worldbuilder_requested :: (s: [] WorldBuilder, id: int) #export_c #effects(all) {
  s[0].req_ready = false;
  if s[0].req_what == REQ_ACT {
    if id < 0 { s[0].waiting = false; give_back(s); set_reply(s, "That didn't go through. Send it again.", REPLY_NOTICE); return; }
    s[0].act_id = id;
  } else { s[0].status_id = id; }
}
can_send :: (s: [] WorldBuilder) -> bool {
  return s[0].cat_ready && !s[0].waiting && !s[0].resting && s[0].time >= s[0].flood_until && !s[0].req_ready;
}
send_typed :: (s: [] WorldBuilder) {
  a := trim_from(cast(string) s[0].typed[0..<s[0].typed_n]); z := trim_to(cast(string) s[0].typed[0..<s[0].typed_n]);
  if z <= a || !can_send(s) { return; }
  words := cast(string) s[0].typed[a..<z];
  s[0].heard_n = put(s[0].heard[..], 0, words);
  n := build_act(s, words);
  s[0].typed_n = 0;
  s[0].reply_n = 0;
  s[0].waiting = true;
  ask(s, ACT_URL, n, 1 | 4, REQ_ACT);
}
// Once a frame: ask for the day's spend when it is wanted and nothing else is going.
pump :: (s: [] WorldBuilder) {
  if s[0].want_status && !s[0].req_ready && s[0].status_id < 0 {
    s[0].want_status = false;
    ask(s, STATUS_URL, 0, 4, REQ_STATUS);
  }
  // keep the world in this browser after every change
  v := s[0].world[0].version;
  if v != s[0].saved_version && s[0].action == 0 && s[0].cat_ready && !s[0].saved_waiting {
    s[0].saved_version = v;
    s[0].out_n = wb_save(s[0].world[..], s[0].cat[..], s[0].outbox[..]);
    s[0].action = ACT_KEEP;
  }
}
worldbuilder_action :: (s: [] WorldBuilder) -> int #export_c #effects(all) { a := s[0].action; s[0].action = 0; return a; }
worldbuilder_action_done :: (s: [] WorldBuilder) #export_c #effects(all) { s[0].out_n = 0; }
worldbuilder_wants_text :: (s: [] WorldBuilder) -> bool #export_c #effects(all) { return true; }

undo :: (s: [] WorldBuilder) {
  if s[0].waiting { return; }
  if wb_undo(s[0].world[..]) { s[0].reply_n = 0; } else { set_reply(s, "Nothing to undo.", REPLY_PLAIN); }
}

// ---- keys and the pointer

worldbuilder_key :: (s: [] WorldBuilder, key: int, down: bool) -> bool #export_c #effects(all) {
  wb_begin(s);
  if !down { return false; }
  if key == KEY_ENTER { send_typed(s); return true; }
  if key == KEY_BACKSPACE { s[0].typed_n = pop(s[0].typed[..], s[0].typed_n); return true; }
  if key == KEY_ESCAPE { s[0].typed_n = 0; return true; }
  // a key typed before the field had the keyboard
  if key >= 32 && key < 127 && s[0].typed_n < TYPED { s[0].typed[s[0].typed_n] = cast(u8) key; s[0].typed_n += 1; return true; }
  return false;
}
worldbuilder_blur :: (s: [] WorldBuilder) #export_c #effects(all) { s[0].down = false; s[0].two = false; s[0].press = -1; }

button_at :: (s: [] WorldBuilder, x: f32, y: f32) -> int {
  for i: 0..<BUTTONS { if s[0].shown[i] && inside(s[0].boxes[i], x, y) { return i; } }
  return -1;
}
// Where a screen point's ray meets the ground.
ground_at :: (s: [] WorldBuilder, x: f32, y: f32) -> WbSpot {
  nx := x / hi(s[0].width, 1) * 2 - 1; ny := 1 - y / hi(s[0].height, 1) * 2;
  rx := s[0].fwd[0] + nx * s[0].right[0] + ny * s[0].up[0];
  ry := s[0].fwd[1] + nx * s[0].right[1] + ny * s[0].up[1];
  rz := s[0].fwd[2] + nx * s[0].right[2] + ny * s[0].up[2];
  if ry > -0.0001 { return WbSpot.{}; }
  t := -s[0].eye[1] / ry;
  if t > 2000 { return WbSpot.{}; }
  return WbSpot.{x = s[0].eye[0] + rx * t, z = s[0].eye[2] + rz * t, ok = true};
}
set_here :: (s: [] WorldBuilder, x: f32, y: f32) {
  g := ground_at(s, x, y);
  if !g.ok { return; }
  s[0].has_here = true; s[0].here_x = g.x; s[0].here_z = g.z; s[0].here_at = s[0].time;
}
worldbuilder_pointer :: (s: [] WorldBuilder, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c #effects(all) {
  wb_begin(s);
  k := hi(s[0].dpr, 0.5);
  if phase == POINTER_MOVE && !s[0].down { s[0].hover = button_at(s, x, y); return false; }
  if phase == POINTER_DOWN {
    if s[0].down && !s[0].two && id != s[0].down_id {
      s[0].two = true; s[0].two_id = id; s[0].two_x = x; s[0].two_y = y;
      dx := x - s[0].last_x; dy := y - s[0].last_y; s[0].pinch = sqrt(dx * dx + dy * dy);
      s[0].moved = true;
      return true;
    }
    s[0].down = true; s[0].down_id = id; s[0].down_x = x; s[0].down_y = y; s[0].last_x = x; s[0].last_y = y;
    s[0].moved = false; s[0].on_ui = button_at(s, x, y); s[0].press = s[0].on_ui;
    return true;
  }
  if !s[0].down { return false; }
  if phase == POINTER_MOVE {
    if s[0].two && id == s[0].two_id { s[0].two_x = x; s[0].two_y = y; }
    else if id == s[0].down_id {
      if s[0].on_ui < 0 {
        dx := x - s[0].last_x; dy := y - s[0].last_y;
        if !s[0].moved && abs(x - s[0].down_x) + abs(y - s[0].down_y) > TAP_SLOP * k { s[0].moved = true; }
        if s[0].moved && !s[0].two {
          s[0].yaw -= dx / k * 0.006;
          s[0].pitch = clamp(s[0].pitch + dy / k * 0.005, PITCH_LO, PITCH_HI);
        }
      }
      s[0].last_x = x; s[0].last_y = y;
    }
    if s[0].two {
      ddx := s[0].two_x - s[0].last_x; ddy := s[0].two_y - s[0].last_y;
      d := sqrt(ddx * ddx + ddy * ddy);
      if s[0].pinch > 1 && d > 1 { s[0].dist = clamp(s[0].dist * s[0].pinch / d, DIST_LO, DIST_HI); }
      s[0].pinch = d;
    }
    return true;
  }
  // up or cancel
  if s[0].two && id == s[0].two_id { s[0].two = false; return true; }
  if id != s[0].down_id { return true; }
  was := s[0].on_ui;
  s[0].down = false; s[0].two = false; s[0].press = -1;
  if phase == POINTER_UP && !s[0].moved {
    if was >= 0 && button_at(s, x, y) == was {
      if was == BTN_SEND { send_typed(s); }
      if was == BTN_UNDO { undo(s); }
    } else if was < 0 { set_here(s, x, y); }
  }
  return true;
}
worldbuilder_wheel :: (s: [] WorldBuilder, dy: f32) -> bool #export_c #effects(all) {
  s[0].dist = clamp(s[0].dist * exp(dy * 0.0015), DIST_LO, DIST_HI);
  return true;
}
worldbuilder_cursor :: (s: [] WorldBuilder) -> int #export_c #effects(all) {
  if s[0].hover == BTN_FIELD { return 3; }
  return ifx s[0].hover >= 0 then 1 else 0;
}

// ---- the camera

view_rows :: (s: [] WorldBuilder) {
  aspect := s[0].width / hi(s[0].height, 1);
  hx := sin(s[0].yaw); hz := -cos(s[0].yaw);
  cp := cos(s[0].pitch); sp := sin(s[0].pitch);
  fx := hx * cp; fy := -sp; fz := hz * cp;
  ex := s[0].tx - fx * s[0].dist; ey := -fy * s[0].dist; ez := s[0].tz - fz * s[0].dist;
  rx := -fz; rz := fx; rl := sqrt(rx * rx + rz * rz); rx /= rl; rz /= rl;   // f × (0, 1, 0)
  ux := -rz * fy; uy := rz * fx - rx * fz; uz := rx * fy;                    // r × f
  t: f32 = 1 / tan(cast(f32) FOV * 0.5);
  sx := t / hi(aspect, 0.3); sy := t;
  if aspect < 1 { sx = t * 0.9; sy = sx * aspect; }   // a phone: as wide a view as a screen that's wider
  zn: f32 = 0.3; zf: f32 = 900.0;
  a := zf / (zn - zf); b := zn * zf / (zn - zf);
  v := s[0].view[..];
  v[0] = sx * rx; v[1] = 0; v[2] = sx * rz; v[3] = -sx * (rx * ex + rz * ez);
  v[4] = sy * ux; v[5] = sy * uy; v[6] = sy * uz; v[7] = -sy * (ux * ex + uy * ey + uz * ez);
  v[8] = -a * fx; v[9] = -a * fy; v[10] = -a * fz; v[11] = a * (fx * ex + fy * ey + fz * ez) + b;
  v[12] = fx; v[13] = fy; v[14] = fz; v[15] = -(fx * ex + fy * ey + fz * ez);
  s[0].eye[0] = ex; s[0].eye[1] = ey; s[0].eye[2] = ez;
  s[0].fwd[0] = fx; s[0].fwd[1] = fy; s[0].fwd[2] = fz;
  s[0].right[0] = rx / sx; s[0].right[1] = 0; s[0].right[2] = rz / sx;
  s[0].up[0] = ux / sy; s[0].up[1] = uy / sy; s[0].up[2] = uz / sy;
}

// ---- the scene: one draw a mesh, its instances' rows

// One piece's rows: rotation about y by yaw, its scale, and its mesh's box folded in, so the
// shader's unorm16 position (0..1 in the box) lands where the piece stands.
rows_of :: (s: [] WorldBuilder, mesh: int, x: f32, y: f32, z: f32, yaw: f32, k: f32, at: int) {
  b := s[0].cat[0].box[mesh * 6..<mesh * 6 + 6];
  ex := b[3] - b[0]; ey := b[4] - b[1]; ez := b[5] - b[2];
  c := cos(yaw); sn := sin(yaw);
  r := s[0].objects[..];
  r[at] = c * k * ex; r[at + 1] = 0; r[at + 2] = sn * k * ez; r[at + 3] = x + k * (c * b[0] + sn * b[2]);
  r[at + 4] = 0; r[at + 5] = k * ey; r[at + 6] = 0; r[at + 7] = y + k * b[1];
  r[at + 8] = -sn * k * ex; r[at + 9] = 0; r[at + 10] = c * k * ez; r[at + 11] = z + k * (-sn * b[0] + c * b[2]);
  r[at + 12] = 1; r[at + 13] = 1; r[at + 14] = 1; r[at + 15] = 0;
}
// How many pieces a thing draws: a building its pieces, anything else itself.
pieces_of :: (s: [] WorldBuilder, m: int) -> int { return ifx wb_is_building(s[0].cat[..], m) then s[0].cat[0].part_n[m] else 1; }
// The scene: one draw a mesh of the pack, its instances' rows, rebuilt when the world changes.
scene :: (s: [] WorldBuilder) {
  w := s[0].world[..]; c := s[0].cat[..];
  if !s[0].cat_ready || s[0].drawn_version == w[0].version { return; }
  s[0].drawn_version = w[0].version;
  counts: [WB_MESHES] int; start: [WB_MESHES] int;
  // the things that fit, in order (every thing but past WB_INSTANCES pieces)
  total := 0; upto := 0;
  while upto < w[0].n {
    m := w[0].objs[upto].mesh;
    if total + pieces_of(s, m) > WB_INSTANCES { break; }
    total += pieces_of(s, m);
    if wb_is_building(c, m) { for p: 0..<c[0].part_n[m] { counts[c[0].parts[c[0].part_first[m] + p].mesh] += 1; } }
    else { counts[m] += 1; }
    upto += 1;
  }
  s[0].draw_n = 0;
  at := 0;
  for m: 0..<c[0].real_n {
    start[m] = at;
    if counts[m] == 0 { continue; }
    d := s[0].draw_n * 4;
    s[0].draws[d] = cast(u32) c[0].first[m]; s[0].draws[d + 1] = cast(u32) c[0].count[m];
    s[0].draws[d + 2] = cast(u32) at; s[0].draws[d + 3] = cast(u32) counts[m];
    s[0].draw_n += 1;
    at += counts[m];
  }
  s[0].inst_n = at;
  for i: 0..<upto {
    o := w[0].objs[i];
    if wb_is_building(c, o.mesh) {
      co := cos(o.yaw); sn := sin(o.yaw); k := o.scale;
      for p: 0..<c[0].part_n[o.mesh] {
        q := c[0].parts[c[0].part_first[o.mesh] + p];
        x := o.x + k * (co * q.x + sn * q.z); z := o.z + k * (-sn * q.x + co * q.z);
        rows_of(s, q.mesh, x, k * q.y, z, o.yaw + q.yaw, k, start[q.mesh] * INSTANCE_FLOATS);
        start[q.mesh] += 1;
      }
    } else {
      rows_of(s, o.mesh, o.x, 0, o.z, o.yaw, o.scale, start[o.mesh] * INSTANCE_FLOATS);
      start[o.mesh] += 1;
    }
  }
}
worldbuilder_draw_count :: (s: [] WorldBuilder) -> int #export_c #effects(all) { return ifx s[0].cat_ready then s[0].draw_n else 0; }
worldbuilder_store_bytes :: (s: [] WorldBuilder) -> int #export_c #effects(all) { return s[0].inst_n * INSTANCE_FLOATS * 4; }

// ---- the look

GAP :: 0.5; SPACE :: 1.2;
TEXT_R :: 0.86; TEXT_G :: 0.94; TEXT_B :: 1.0;
CYAN_R :: 0.45; CYAN_G :: 0.85; CYAN_B :: 1.0;
SUN_R :: 1.0; SUN_G :: 0.86; SUN_B :: 0.45;
LOOK_PLAIN :: 0.0; LOOK_LIT :: 1.0; LOOK_HOVER :: 2.0;
pale :: (k: f32, light: f32) -> Ink { return ink(0.55 * k, light, 1.2 * k, TEXT_R, TEXT_G, TEXT_B); }
cyan :: (k: f32, light: f32) -> Ink { return ink(0.55 * k, light, 1.2 * k, CYAN_R, CYAN_G, CYAN_B); }
warm :: (k: f32, light: f32) -> Ink { return ink(0.55 * k, light, 1.2 * k, SUN_R, SUN_G, SUN_B); }
plate :: (s: [] WorldBuilder, b: Box, alpha: f32, look: f32) {
  n := s[0].plate_n;
  if n >= PLATES { return; }
  s[0].plates[n] = b; s[0].plate_alpha[n] = alpha; s[0].plate_look[n] = look; s[0].plate_n = n + 1;
}
text_w :: (text: string, cap: f32) -> f32 { return measure(text, GAP, SPACE, false) * cap; }
centred :: (d: f32, out: [] f32, at: int, text: string, x: f32, base: f32, cap: f32, k: Ink) -> int {
  return write(d, out, at, text, x - text_w(text, cap) * 0.5, base, cap, GAP, SPACE, k, false, false);
}
fit_cap :: (text: string, cap: f32, width: f32) -> f32 { return lo(cap, width / hi(measure(text, GAP, SPACE, false), 0.001)); }
look_of :: (s: [] WorldBuilder, b: int, on: bool) -> f32 {
  if !on { return LOOK_PLAIN; }
  return ifx s[0].hover == b || s[0].press == b then LOOK_LIT + LOOK_HOVER else LOOK_LIT;
}
// "$1.25"
put_dollars :: (b: [] u8, at: int, micros: int) -> int {
  cents := (micros + 5000) / 10000;
  n := put(b, at, "$"); n = put_int(b, n, cents / 100); n = put(b, n, ".");
  if cents % 100 < 10 { n = put(b, n, "0"); }
  return put_int(b, n, cents % 100);
}
put_kb :: (b: [] u8, at: int, bytes: int) -> int { n := put_int(b, at, (bytes + 524288) / 1048576); return put(b, n, " MB"); }

// The text after its last n characters' worth of room: what fits, from the end.
tail_fit :: (text: string, cap: f32, room: f32) -> int {
  from := 0;
  while from < text.count && text_w(text[from..<text.count], cap) > room { from += 1; while from < text.count && (text[from] & 0xC0) == 0x80 { from += 1; } }
  return from;
}

draw_ui :: (s: [] WorldBuilder, out: [] f32) -> int {
  k := s[0].dpr; w := s[0].width; h := s[0].height; d := k;
  g := 16 * k;
  phone := w < 640 * k;
  vertices := 0;
  buf: [240] u8;

  // the name, how full the world is, and the limits, top left
  n := put(buf[..], 0, "WORLDBUILDER");
  head := cast(string) buf[0..<n];
  lb: [160] u8;
  m := put_int(lb[..], 0, s[0].world[0].n); m = put(lb[..], m, " OF "); m = put_int(lb[..], m, WB_OBJECTS); m = put(lb[..], m, " THINGS");
  count := cast(string) lb[0..<m];
  lim: [200] u8;
  q := 0;
  if s[0].known { q = put_dollars(lim[..], 0, s[0].spent); q = put(lim[..], q, " OF "); q = put_dollars(lim[..], q, s[0].cap); q = put(lim[..], q, " SHARED AI USED TODAY"); }
  else { q = put(lim[..], 0, "$50 OF AI A DAY, SHARED BY EVERYONE"); }
  limits := cast(string) lim[0..<q];
  pace := "4 COMMANDS AT ONCE, THEN 1 EVERY 1.5 S";
  tw := hi(hi(text_w(head, 11 * k), text_w(limits, 6.5 * k)), text_w(pace, 6.5 * k)) + 28 * k;
  ub := 92 * k;
  tb := Box.{x0 = g, y0 = g, x1 = lo(g + tw, w - 2 * g - ub), y1 = g + 70 * k};
  room := tb.x1 - tb.x0 - 28 * k;
  plate(s, tb, 0.88, LOOK_PLAIN);
  vertices = write(d, out, vertices, head, tb.x0 + 14 * k, tb.y0 + 22 * k, fit_cap(head, 11 * k, room), GAP, SPACE, pale(k, 0.97), false, false);
  vertices = write(d, out, vertices, count, tb.x0 + 14 * k + text_w(head, fit_cap(head, 11 * k, room)) + 10 * k, tb.y0 + 22 * k, fit_cap(count, 6.5 * k, hi(room - text_w(head, 11 * k) - 10 * k, 10 * k)), GAP, SPACE, cyan(k, 0.8), false, false);
  vertices = write(d, out, vertices, limits, tb.x0 + 14 * k, tb.y0 + 42 * k, fit_cap(limits, 6.5 * k, room), GAP, SPACE, cyan(k, 0.75), false, false);
  vertices = write(d, out, vertices, pace, tb.x0 + 14 * k, tb.y0 + 58 * k, fit_cap(pace, 6.5 * k, room), GAP, SPACE, cyan(k, 0.75), false, false);

  // UNDO, top right: free, no model asked
  can_undo := s[0].world[0].undo_count > 0 && !s[0].waiting;
  b := Box.{x0 = w - g - ub, y0 = g, x1 = w - g, y1 = g + 36 * k};
  s[0].boxes[BTN_UNDO] = b; s[0].shown[BTN_UNDO] = can_undo;
  if can_undo {
    plate(s, b, 0.9, look_of(s, BTN_UNDO, true));
    vertices = centred(d, out, vertices, "UNDO", (b.x0 + b.x1) * 0.5, (b.y0 + b.y1) * 0.5 + 4.5 * k, 9 * k, pale(k, 0.95));
  }

  // the pack, while it comes
  if !s[0].cat_ready {
    pn := 0;
    if s[0].pack_failed { pn = put(buf[..], 0, "THE MODELS DIDN'T ARRIVE. RELOAD THE PAGE."); }
    else {
      pn = put(buf[..], 0, "BRINGING IN 785 MODELS");
      if s[0].total > 0 { pn = put(buf[..], pn, " "); pn = put_kb(buf[..], pn, s[0].loaded); pn = put(buf[..], pn, " OF "); pn = put_kb(buf[..], pn, s[0].total); }
    }
    line := cast(string) buf[0..<pn];
    vertices = centred(d, out, vertices, line, w * 0.5, h * 0.45, fit_cap(line, 9 * k, w - 2 * g), pale(k, 0.9));
    if s[0].total > 0 && !s[0].pack_failed {
      share := clamp(cast(f32) s[0].loaded / cast(f32) s[0].total, 0, 1);
      bw := lo(w - 4 * g, 320 * k); x0 := (w - bw) * 0.5; y := h * 0.45 + 16 * k;
      if lit(out, vertices, x0, y, x0 + bw, y, 0.5 * k, 0.25, 1 * k, CYAN_R, CYAN_G, CYAN_B, MODE_STROKE) { vertices += 6; }
      if share > 0 && lit(out, vertices, x0, y, x0 + bw * share, y, 1.2 * k, 1, 2.5 * k, CYAN_R, CYAN_G, CYAN_B, MODE_STROKE) { vertices += 6; }
    }
  }

  // the line to type in, bottom centre, and SEND
  fw := lo(w - 2 * g, 680 * k); fh := 50 * k;
  fx0 := (w - fw) * 0.5; fy1 := h - g - (ifx phone then 8 * k else 12 * k); fy0 := fy1 - fh;
  sw := 78 * k;
  fb := Box.{x0 = fx0, y0 = fy0, x1 = fx0 + fw - sw - 8 * k, y1 = fy1};
  sb := Box.{x0 = fb.x1 + 8 * k, y0 = fy0, x1 = fx0 + fw, y1 = fy1};
  s[0].boxes[BTN_FIELD] = fb; s[0].shown[BTN_FIELD] = true;
  s[0].field[0] = fb.x0; s[0].field[1] = fb.y0; s[0].field[2] = fb.x1; s[0].field[3] = fb.y1;
  plate(s, fb, 0.92, LOOK_LIT);
  ready := can_send(s) && s[0].typed_n > 0;
  s[0].boxes[BTN_SEND] = sb; s[0].shown[BTN_SEND] = ready;
  plate(s, sb, ifx ready then 0.92f32 else 0.5f32, look_of(s, BTN_SEND, ready));
  vertices = centred(d, out, vertices, "SEND", (sb.x0 + sb.x1) * 0.5, (sb.y0 + sb.y1) * 0.5 + 4.5 * k, 9 * k, pale(k, ifx ready then 0.95f32 else 0.35f32));
  cap := 9 * k;
  tx := fb.x0 + 16 * k; base := (fb.y0 + fb.y1) * 0.5 + 4.5 * k; troom := fb.x1 - fb.x0 - 32 * k;
  if s[0].typed_n > 0 {
    typed := cast(string) s[0].typed[0..<s[0].typed_n];
    from := tail_fit(typed, cap, troom - 8 * k);
    shown := typed[from..<typed.count];
    vertices = write(d, out, vertices, shown, tx, base, cap, GAP, SPACE, pale(k, 0.97), false, false);
    cx := tx + text_w(shown, cap) + 3 * k;
    blink := s[0].still || cast(int) (s[0].time * 2) % 2 == 0;
    if blink && lit(out, vertices, cx, base + 2 * k, cx, base - cap - 2 * k, 0.6 * k, 0.9, 1.2 * k, CYAN_R, CYAN_G, CYAN_B, MODE_STROKE) { vertices += 6; }
  } else {
    hint := ifx s[0].world[0].n == 0 then "PUT A TREE HERE" else "SAY WHAT TO BUILD";
    vertices = write(d, out, vertices, hint, tx, base, fit_cap(hint, cap, troom), GAP, SPACE, pale(k, 0.32), false, false);
  }

  // over the line: the words sent while their answer comes, or the one line answered
  ry := fy0 - 16 * k;
  rroom := w - 2 * g;
  if s[0].waiting && s[0].heard_n > 0 {
    rn := put(buf[..], 0, "“"); rn = put(buf[..], rn, cast(string) s[0].heard[0..<s[0].heard_n]); rn = put(buf[..], rn, "”");
    line := cast(string) buf[0..<rn];
    pulse := ifx s[0].still then 0.7f32 else 0.55 + 0.35 * sin(s[0].time * 5);
    vertices = centred(d, out, vertices, line, w * 0.5, ry, fit_cap(line, 8 * k, rroom), pale(k, pulse));
  } else if s[0].resting {
    a := "WORLDBUILDER IS RESTING UNTIL MIDNIGHT, CHICAGO TIME";
    bb := "TODAY'S SHARED $50 OF AI IS USED UP. YOUR WORLD IS KEPT.";
    vertices = centred(d, out, vertices, a, w * 0.5, ry - 16 * k, fit_cap(a, 8.5 * k, rroom), warm(k, 0.95));
    vertices = centred(d, out, vertices, bb, w * 0.5, ry, fit_cap(bb, 7 * k, rroom), pale(k, 0.75));
  } else if s[0].time < s[0].flood_until {
    left := cast(int) ((s[0].flood_until - s[0].time) * 10 + 0.999);
    rn := put(buf[..], 0, "TOO FAST FOR THE SHARED LINE: SEND AGAIN IN ");
    rn = put_int(buf[..], rn, left / 10); rn = put(buf[..], rn, "."); rn = put_int(buf[..], rn, left % 10); rn = put(buf[..], rn, " S");
    line := cast(string) buf[0..<rn];
    vertices = centred(d, out, vertices, line, w * 0.5, ry, fit_cap(line, 8 * k, rroom), warm(k, 0.95));
  } else if s[0].reply_n > 0 {
    rn := put(buf[..], 0, cast(string) s[0].reply[0..<s[0].reply_n]);
    for i: 0..<rn { if buf[i] >= 'a' && buf[i] <= 'z' { buf[i] -= 32; } }
    line := cast(string) buf[0..<rn];
    vertices = centred(d, out, vertices, line, w * 0.5, ry, fit_cap(line, 8.5 * k, rroom), ifx s[0].reply_kind == REPLY_NOTICE then warm(k, 0.95) else pale(k, 0.92));
  } else if !s[0].has_here && s[0].cat_ready {
    hint := ifx phone then "TAP THE GROUND TO SAY WHERE “HERE” IS · DRAG TO TURN · PINCH TO ZOOM" else "CLICK THE GROUND TO SAY WHERE “HERE” IS · DRAG TO TURN · SCROLL TO ZOOM";
    vertices = centred(d, out, vertices, hint, w * 0.5, ry, fit_cap(hint, 7 * k, rroom), pale(k, 0.55));
  }
  return vertices;
}

// ---- the frame

worldbuilder_frame :: (s: [] WorldBuilder, out: [] f32, uniforms: [] f32, width: f32, height: f32, dpr: f32, dt: f32, still: bool) -> int #export_c #effects(all) {
  if s.count < 1 || uniforms.count < UNIFORM_FLOATS || width < 1 || height < 1 { return 0; }
  wb_begin(s);
  held := still || s[0].golden;
  s[0].width = width; s[0].height = height; s[0].dpr = hi(dpr, 0.5); s[0].still = held;
  step := clamp(dt, 0, 0.1);
  s[0].time += step;
  // the view glides to the spot last tapped
  if s[0].has_here { s[0].gx = s[0].here_x; s[0].gz = s[0].here_z; }
  glide := ifx held then 1.0f32 else 1 - exp(-step * 4);
  s[0].tx += (s[0].gx - s[0].tx) * glide; s[0].tz += (s[0].gz - s[0].tz) * glide;
  pump(s);
  scene(s);
  s[0].plate_n = 0;
  for i: 0..<BUTTONS { s[0].shown[i] = false; }
  for i: 0..<UNIFORM_FLOATS { uniforms[i] = 0; }
  uniforms[0] = width; uniforms[1] = height; uniforms[2] = ifx held then 20.0f32 else s[0].time;
  uniforms[3] = ifx held then 1.0f32 else ease(s[0].time / 0.5);
  uniforms[4] = ifx held then 1.0f32 else 0.0f32;
  uniforms[6] = s[0].dpr;
  view_rows(s);
  for i: 0..<16 { uniforms[VIEW_AT + i] = s[0].view[i]; }
  if s[0].has_here {
    uniforms[HERE_AT] = s[0].here_x; uniforms[HERE_AT + 2] = s[0].here_z;
    uniforms[HERE_AT + 3] = ifx held then 0.8f32 else 0.55 + 0.45 * ease(1 - (s[0].time - s[0].here_at) / 0.6) + 0.15 * sin(s[0].time * 3);
  }
  for i: 0..<3 {
    uniforms[EYE_AT + i] = s[0].eye[i]; uniforms[RAY_AT + i] = s[0].fwd[i];
    uniforms[RAY_AT + 4 + i] = s[0].right[i]; uniforms[RAY_AT + 8 + i] = s[0].up[i];
  }
  n := draw_ui(s, out);
  uniforms[5] = cast(f32) s[0].plate_n;
  for i: 0..<s[0].plate_n {
    o := PANEL_AT + i * 8; b := s[0].plates[i];
    uniforms[o] = b.x0; uniforms[o + 1] = b.y0; uniforms[o + 2] = b.x1; uniforms[o + 3] = b.y1;
    uniforms[o + 4] = s[0].dpr; uniforms[o + 5] = s[0].plate_alpha[i]; uniforms[o + 6] = s[0].plate_look[i]; uniforms[o + 7] = 0;
  }
  return n;
}
worldbuilder_golden :: (s: [] WorldBuilder, on: bool) #export_c #effects(all) { s[0].golden = on; }
coaxial_worldbuilder_max_vertices :: () -> int #export_c #effects(all) { return MAX_VERTICES; }
coaxial_worldbuilder_vertex_floats :: () -> int #export_c #effects(all) { return VERTEX_FLOATS; }
coaxial_worldbuilder_uniform_floats :: () -> int #export_c #effects(all) { return UNIFORM_FLOATS; }

// ---- checks

TEST_CAT :: WB_TEST_CAT;
ready :: (s: [] WorldBuilder) { worldbuilder_catalog(s, TEST_CAT); }
frame :: (s: [] WorldBuilder) -> int {
  out: [MAX_VERTICES * VERTEX_FLOATS] f32; u: [UNIFORM_FLOATS] f32;
  return worldbuilder_frame(s, out[..], u[..], 1600, 1000, 2, 1.0 / 60.0, false);
}
type_in :: (s: [] WorldBuilder, t: string) { worldbuilder_message(s, MSG_TEXT, t); }
body :: (s: [] WorldBuilder) -> string { return cast(string) s[0].req_body[0..<s[0].req_body_n]; }
has :: (t: string, part: string) -> bool {
  if part.count > t.count { return false; }
  for i: 0..<t.count - part.count + 1 { if t[i..<i + part.count] == part { return true; } }
  return false;
}

#test "a typed line goes out as the page's JSON, with here, the camera and what the world holds" {
  s: [1] WorldBuilder;
  ready(s[..]);
  n := frame(s[..]);
  // the status is asked for at load
  #assert s[0].req_ready && s[0].req_what == REQ_STATUS;
  worldbuilder_requested(s[..], 0);
  worldbuilder_message(s[..], MSG_HTTP + 0, "200\nok 1250000 50000000");
  #assert s[0].known && s[0].spent == 1250000 && !s[0].resting;
  // a tap on the ground in the middle of the screen sets here near where the camera looks
  #assert worldbuilder_pointer(s[..], 800, 500, POINTER_DOWN, 0, 1) && worldbuilder_pointer(s[..], 800, 500, POINTER_UP, 0, 1);
  #assert s[0].has_here && abs(s[0].here_x) < 0.5 && abs(s[0].here_z) < 0.5;
  type_in(s[..], "put a \"tree\" here");
  #assert worldbuilder_key(s[..], KEY_ENTER, true);
  #assert s[0].waiting && s[0].req_ready && s[0].req_what == REQ_ACT && s[0].typed_n == 0;
  #assert has(body(s[..]), "{\"text\":\"put a \\\"tree\\\" here\",\"here\":[") && has(body(s[..]), "\"present\":{}");
  worldbuilder_requested(s[..], 1);
  // a second line can't go while one is out
  type_in(s[..], "more");
  #assert !worldbuilder_key(s[..], KEY_ENTER, true) || !s[0].req_ready;
  worldbuilder_message(s[..], MSG_HTTP + 1, "200\nS A birch, right there.\nA place|nature/birch-1|1|||here||at||||||\n");
  #assert !s[0].waiting && s[0].world[0].n == 1 && cast(string) s[0].reply[0..<s[0].reply_n] == "A birch, right there.";
  #assert s[0].want_status;
  n = frame(s[..]);
  #assert s[0].draw_n == 1 && s[0].draws[0] == 0 && s[0].draws[1] == 30 && s[0].draws[3] == 1;
  // the world is kept in this browser after the change
  #assert worldbuilder_action(s[..]) == ACT_KEEP && has(cast(string) s[0].outbox[0..<s[0].out_n], "nature/birch-1 ");
}
#test "a flood answer shows the wait and gives the words back; resting says until midnight Chicago time" {
  s: [1] WorldBuilder;
  ready(s[..]);
  type_in(s[..], "add rocks");
  #assert worldbuilder_key(s[..], KEY_ENTER, true);
  worldbuilder_requested(s[..], 2);
  worldbuilder_message(s[..], MSG_HTTP + 2, "429\nflood 1200");
  #assert !s[0].waiting && cast(string) s[0].typed[0..<s[0].typed_n] == "add rocks" && s[0].flood_until > s[0].time + 1.1;
  #assert !can_send(s[..]);
  s[0].time += 1.3;
  #assert can_send(s[..]);
  #assert worldbuilder_key(s[..], KEY_ENTER, true);
  worldbuilder_requested(s[..], 3);
  worldbuilder_message(s[..], MSG_HTTP + 3, "429\nresting");
  #assert s[0].resting && !can_send(s[..]) && s[0].typed_n == 9;
}
#test "the scene draws one instanced draw a mesh, its rows folding in the mesh's box" {
  s: [1] WorldBuilder;
  ready(s[..]);
  v := wb_view(s[..]);
  sum := wb_answer(s[0].world[..], s[0].cat[..], v, "A place|nature/rock-1|5|||origin||at||||||\nA place|nature/birch-1|2|||origin||at||||||\nA place|nature/rock-1|1|||origin||right||||||\n");
  scene(s[..]);
  #assert s[0].draw_n == 2 && s[0].draws[0] == 0 && s[0].draws[3] == 2 && s[0].draws[4] == 30 && s[0].draws[6] == 2 && s[0].draws[7] == 6;
  // a rock's corner (0, 0, 0) in its box lands at its spot less half its 1 m footprint, at scale 1 unturned
  o := s[0].world[0].objs[0];
  #assert abs(s[0].objects[2 * INSTANCE_FLOATS + 5] - 0.6 * o.scale) < 0.001;
  #assert worldbuilder_store_bytes(s[..]) == 8 * 64;
}
#test "a building draws as its pieces, each turned and placed with it" {
  s: [1] WorldBuilder;
  worldbuilder_catalog(s[..], WB_PIECES_CAT);
  sum := wb_answer(s[0].world[..], s[0].cat[..], wb_view(s[..]), "A place|house/cottage|1|||origin||at||||||\nA place|village/roof-roundtiles-4x4|1|||origin||right||||||\n");
  scene(s[..]);
  // seven meshes: five walls (the straight one three times), the corner (four) and the roof (two: the cottage's and the one alone)
  #assert s[0].draw_n == 7 && s[0].inst_n == 14 && worldbuilder_store_bytes(s[..]) == 14 * 64;
  #assert s[0].draws[5 * 4 + 3] == 4 && s[0].draws[6 * 4 + 3] == 2;
  // the cottage's roof stands 3 m up
  #assert abs(s[0].objects[s[0].draws[6 * 4 + 2] * INSTANCE_FLOATS + 7] - 3) < 0.001;
}
#test "UNDO takes back the last edit without asking the model; a drag turns the view and is no tap" {
  s: [1] WorldBuilder;
  ready(s[..]);
  sum := wb_answer(s[0].world[..], s[0].cat[..], wb_view(s[..]), "A place|nature/rock-1|3|||origin||at||||||\n");
  n := frame(s[..]);
  b := s[0].boxes[BTN_UNDO];
  #assert s[0].shown[BTN_UNDO];
  #assert worldbuilder_pointer(s[..], b.x0 + 4, b.y0 + 4, POINTER_DOWN, 0, 1) && worldbuilder_pointer(s[..], b.x0 + 4, b.y0 + 4, POINTER_UP, 0, 1);
  #assert s[0].world[0].n == 0 && s[0].req_what != REQ_ACT;
  yaw := s[0].yaw;
  #assert worldbuilder_pointer(s[..], 600, 500, POINTER_DOWN, 0, 1);
  #assert worldbuilder_pointer(s[..], 700, 520, POINTER_MOVE, 0, 1) && worldbuilder_pointer(s[..], 700, 520, POINTER_UP, 0, 1);
  #assert s[0].yaw != yaw && !s[0].has_here;
}
#test "a saved world comes back once the catalogue is in, whichever arrives first" {
  s: [1] WorldBuilder;
  worldbuilder_message(s[..], MSG_SLOT, "WB1\nnature/rock-1 1.000 -2.000 0.000 1.000\nnature/birch-1 3.000 0.000 0.500 1.200\n");
  #assert s[0].world[0].n == 0;
  ready(s[..]);
  #assert s[0].world[0].n == 2;
  n := frame(s[..]);
  // loading isn't a change to keep again
  #assert worldbuilder_action(s[..]) == 0;
}
