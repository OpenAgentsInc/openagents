<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light by default; values-night supplies the dark theme, as a DayNight theme does. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/oa_accent</item>
        <item name="android:colorControlActivated">@color/oa_accent</item>
        <item name="android:textColorPrimary">@color/oa_text</item>
        <item name="android:textColorSecondary">@color/oa_secondary</item>
        <item name="android:textColorHint">@color/oa_secondary</item>
        <item name="android:statusBarColor">@color/oa_background</item>
        <item name="android:navigationBarColor">@color/oa_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/oa_background</item>
        <item name="android:buttonStyle">@style/OaButton</item>
        <item name="android:textAppearanceButton">@style/OaButtonText</item>
    </style>
    <style name="OaButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/oa_text</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="OaButtonText" parent="android:style/TextAppearance.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
