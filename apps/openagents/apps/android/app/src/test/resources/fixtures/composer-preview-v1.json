              "key": "question-title",
              "element": {
                "kind": "text",
                "props": {
                  "value": "Which files should I compare?",
                  "role": "heading"
                }
              },
              "style": {}
            },
            {
              "key": "question-first",
              "element": {
                "kind": "choice",
                "props": {
                  "label": "diagram.png",
                  "selected": true,
                  "enabled": true,
                  "intent": "answer-first"
                }
              },
              "style": {}
            },
            {
              "key": "question-second",
              "element": {
                "kind": "choice",
                "props": {
                  "label": "notes.txt",
                  "selected": false,
                  "enabled": true,
                  "intent": "answer-second"
                }
              },
              "style": {}
            },
            {
              "key": "question-approve",
              "element": {
                "kind": "button",
                "props": {
                  "label": "Continue",
                  "enabled": true,
                  "intent": "continue"
                }
              },
              "style": {}
            }
          ]
        }
      },
      "style": {}
    }
  }
