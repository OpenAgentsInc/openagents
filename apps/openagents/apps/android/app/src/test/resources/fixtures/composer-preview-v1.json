        "node": "remove-diagram",
        "label": "Remove diagram"
      }
    }
  ],
  "attachment_actions": [
    {
      "node": "attach-photo",
      "label": "Photo library"
    },
    {
      "node": "attach-camera",
      "label": "Take photo"
    },
    {
      "node": "attach-file",
      "label": "Choose file"
    }
  ],
  "mention_suggestions": [
    {
      "node": "mention-foreman",
      "label": "@Foreman"
    },
    {
      "node": "mention-codex",
      "label": "@Codex"
    }
  ],
  "shared_cards": {
