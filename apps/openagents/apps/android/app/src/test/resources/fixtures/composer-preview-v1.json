    },
    {
      "token": "queue-next",
      "label": "Queue for later"
    },
    {
      "token": "steer-turn",
      "label": "Add direction"
    }
  ],
  "context_chips": [
    {
      "key": "project-chip",
      "label": "Project: demo"
    },
    {
      "key": "model-chip",
      "label": "Codex · Code"
    }
