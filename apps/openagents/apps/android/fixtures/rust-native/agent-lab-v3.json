{
  "schema": "rust-native.view.v3",
  "instance": "agent-lab-demo",
  "revision": 1,
  "root": {
    "key": "screen",
    "style": {"gap_points": 12},
    "element": {
      "kind": "stack",
      "props": {
        "axis": "vertical",
        "children": [
          {
            "key": "title",
            "style": {"text_size": 24, "weight": "semibold"},
            "element": {"kind": "text", "props": {"value": "Agent Lab", "role": "heading"}}
          },
          {
            "key": "foreman-card",
            "style": {"background": {"red": 34, "green": 39, "blue": 46, "alpha": 255}, "radius": 12, "padding_points": [16, 16, 16, 16]},
            "element": {
              "kind": "stack",
              "props": {
                "axis": "vertical",
                "children": [
                  {
                    "key": "foreman-name",
                    "style": {},
                    "element": {"kind": "text", "props": {"value": "Foreman", "role": "heading"}}
                  },
                  {
                    "key": "foreman-summary",
                    "style": {},
                    "element": {"kind": "text", "props": {"value": "Helps organize your work", "role": "body"}}
                  },
                  {
                    "key": "foreman-actions",
                    "style": {"menu": "context"},
                    "element": {
                      "kind": "stack",
                      "props": {
                        "axis": "horizontal",
                        "children": [
                          {"key": "foreman-use", "style": {}, "element": {"kind": "button", "props": {"label": "Use", "enabled": true, "intent": {"action": "use", "agent": "foreman"}}}},
                          {"key": "foreman-inspect", "style": {}, "element": {"kind": "button", "props": {"label": "Inspect", "enabled": true, "intent": {"action": "inspect", "agent": "foreman"}}}},
                          {"key": "foreman-assign", "style": {}, "element": {"kind": "button", "props": {"label": "Assign", "enabled": true, "intent": {"action": "assign", "agent": "foreman"}}}}
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "key": "custom-agent-name",
            "style": {},
            "element": {"kind": "field", "props": {"label": "Agent name", "value": "", "placeholder": "Name your agent", "secret": false, "multiline": false, "enabled": true, "max_bytes": 80, "on_change": {"action": "edit_name"}}}
          },
          {"key": "save-agent", "style": {}, "element": {"kind": "button", "props": {"label": "Save agent", "enabled": true, "intent": {"action": "save_agent"}}}},
          {"key": "run-agent", "style": {}, "element": {"kind": "button", "props": {"label": "Run", "enabled": true, "intent": {"action": "run_agent"}}}},
          {"key": "relaunch-agent", "style": {}, "element": {"kind": "button", "props": {"label": "Relaunch", "enabled": true, "intent": {"action": "relaunch_agent"}}}}
        ]
      }
    }
  }
}
