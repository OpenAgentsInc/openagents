{
  "name": "@openagentsinc/sarah-livekit-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Explicit-dispatch LiveKit Agents worker for admitted Sarah voice generations.",
  "type": "module",
  "scripts": {
    "acceptance": "node --import tsx src/acceptance-cli.ts",
    "build": "vp pack src/agent.ts --format esm --platform node --target node24 --out-dir dist",
    "start": "node dist/agent.mjs start",
    "test": "vp test --run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "1.6.0",
    "@livekit/agents-plugin-openai": "1.6.0",
    "@livekit/protocol": "1.50.4",
    "@livekit/rtc-node": "0.13.32",
    "@openagentsinc/audio-contract": "workspace:*",
    "ws": "8.21.1",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "livekit-server-sdk": "2.17.0",
    "typescript": "catalog:"
  }
}
