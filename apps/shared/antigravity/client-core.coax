// Shared compiled Coax C core for OpenAgents iOS & OpenAgents macOS (GitHub #13993).
// Compiles to Generated/client_core.c + Generated/client_core.h with ZERO GPU
// renderer, ZERO AppCore/durable-chat/account-view-wire, and ZERO public relay code.
//
// Owns all protocol, cryptography, Tailscale framing, workspace Git/PR wire,
// and Antigravity-only policy rules:
//   - NIP-44 device identity & request/reply sealing/opening (apps/shared/app/device/seal.coax)
//   - Tailscale admission, direct grants, direct transport & push frames (coax/lib/nostr/host/tailnet.coax)
//   - Environment runtime wire with Review Mode (coax/lib/agent/environment/wire.coax)
//   - Workspace Git/Diff/Branch/Worktree/PR wire (coax/lib/agent/workspace/wire.coax)
//   - #authority Antigravity-only model & effort policy (coax/lib/agent/environment/phone-agent-policy.coax)
//
//   coax/bin/coax test apps/shared/antigravity/client-core.coax
#run_steps 250000000;
#load "../app/device/seal.coax";
#load "../../../coax/lib/nostr/host/tailnet.coax";
#load "../../../coax/lib/agent/environment/phone-agent-policy.coax";
#load "../../../coax/lib/agent/environment/remote-reliability.coax";
#load "../../../coax/lib/agent/environment/route-policy.coax";

mc_copy :: (out: [] u8, s: string) -> int #effects(all) {
  if s.count > out.count { return -1; }
  for c, i: s { out[i] = c; }
  return s.count;
}

mc_host_key_ok :: (key: string) -> bool #export_c #effects(all) {
  return hb_hex64(key);
}

mc_is_agy_model :: (id: string) -> bool #export_c #effects(all) {
  return pa_mobile_agy_allowed(id);
}

mc_normalize_agy_model :: (want: string, out: [] u8) -> int #export_c #effects(all) {
  return mc_copy(out, pa_mobile_agy_model(want));
}

mc_normalize_agy_effort :: (model: string, want: string, out: [] u8) -> int #export_c #effects(all) {
  eng := ifx pa_core_model(model) then PA_CORE else PA_AGY;
  return mc_copy(out, pa_effort(eng, model, want));
}

mc_is_core_model :: (id: string) -> bool #export_c #effects(all) {
  return pa_mobile_core_allowed(id);
}

mc_normalize_core_model :: (want: string, out: [] u8) -> int #export_c #effects(all) {
  return mc_copy(out, pa_mobile_core_model(want));
}

mc_folder_ok :: (folder: string) -> bool #export_c #effects(all) {
  return ea_folder_ok(folder);
}

mc_mode_ok :: (mode: string) -> bool #export_c #effects(all) {
  return ea_mode_ok(mode);
}

// #authority Layer-2 reliability & route-policy C ABI exports (#14030, #14032).
mc_rr_sync_action :: (transport_up: bool, auth_valid: bool, client_cursor: int, log_floor: int, log_head: int) -> int #export_c #effects(all) {
  return rr_sync_action(transport_up, auth_valid, client_cursor, log_floor, log_head);
}

mc_rr_request_liveness :: (kind: int, req_epoch: int, live_epoch: int, process_alive: bool, now_ms: int, expires_ms: int) -> int #export_c #effects(all) {
  return rr_request_liveness(kind, req_epoch, live_epoch, process_alive, now_ms, expires_ms);
}

mc_route_select :: (
  tailnet_cfg: bool, tailnet_ok: bool, tailnet_fail_ms: int,
  lan_cfg: bool, lan_ok: bool, lan_fail_ms: int,
  nostr_cfg: bool, nostr_ok: bool, nostr_fail_ms: int,
  now_ms: int
) -> int #export_c #effects(all) {
  return rp_route_select(tailnet_cfg, tailnet_ok, tailnet_fail_ms, lan_cfg, lan_ok, lan_fail_ms, nostr_cfg, nostr_ok, nostr_fail_ms, now_ms);
}

mc_cred_audience_ok :: (presented_aud: int, expected_aud: int, now_ms: int, expires_ms: int) -> bool #export_c #effects(all) {
  return rp_cred_audience_ok(presented_aud, expected_aud, now_ms, expires_ms);
}

// Builds a bounded, policy-checked EaRequest JSON payload using caller-owned scratch q.
// Enforces at the wire boundary that any specified model is an Antigravity model (never Claude
// or Inkling), effort is valid for Antigravity, review mode is auto/default/plan/accept-edits/turbo,
// folder is only passed on OpenSession, item_id only on ReadSubagent/StopSubagent, option_id only
// on RespondInteraction, and attachments only on OpenSession/SendMessage.
mc_env_request :: (
  q: [] EaRequest,
  method: string,
  session: string,
  command: string,
  generation: int,
  revision: int,
  text: string,
  interaction: string,
  allow: bool,
  before: int,
  issued: int,
  expires: int,
  model: string,
  effort: string,
  folder: string,
  item: string,
  mode: string,
  option_id: string,
  attachments: string,
  out: [] u8
) -> int #export_c #effects(all) {
  if q.count < 1 || ea_right(method) < 0 { return -1; }
  if generation < 0 || revision < 0 || before < 0 || issued < 0 || expires < 0 { return -1; }
  q[0] = EaRequest.{};
  q[0].nm = ea_copy(q[0].method[..], method);
  q[0].nw = ea_copy(q[0].workspace[..], "default");
  q[0].ns = ea_copy(q[0].session[..], session);
  q[0].nc = ea_copy(q[0].command[..], command);
  q[0].nt = ea_copy(q[0].text[..], text);
  q[0].ni = ea_copy(q[0].interaction[..], interaction);
  if q[0].nm < 1 || q[0].nw < 1 || q[0].ns < 0 || q[0].nc < 0 || q[0].nt < 0 || q[0].ni < 0 { return -1; }
  q[0].generation = generation;
  q[0].revision = revision;
  q[0].allow = allow;
  q[0].before = before;
  q[0].issued = issued;
  q[0].expires = expires;
  if model.count > 0 {
    if method == "ListSessions" && model == "antigravity" {
      q[0].nmo = ea_copy(q[0].model[..], "antigravity");
      if q[0].nmo < 1 { return -1; }
    } else {
      if !pa_mobile_agy_allowed(model) { return -1; }
      resolved := pa_mobile_agy_model(model);
      if !ea_choice(resolved) { return -1; }
      q[0].nmo = ea_copy(q[0].model[..], resolved);
      if q[0].nmo < 1 { return -1; }
    }
  }
  if effort.count > 0 {
    eff_model := ifx model.count > 0 then pa_mobile_agy_model(model) else PA_AGY_DEFAULT;
    eff_eng := ifx pa_core_model(eff_model) then PA_CORE else PA_AGY;
    resolved_effort := pa_effort(eff_eng, eff_model, effort);
    if resolved_effort.count > 0 {
      if !ea_choice(resolved_effort) { return -1; }
      q[0].nef = ea_copy(q[0].effort[..], resolved_effort);
      if q[0].nef < 1 { return -1; }
    }
  }
  if folder.count > 0 {
    if method != "OpenSession" || !ea_folder_ok(folder) { return -1; }
    q[0].nf = ea_copy(q[0].folder[..], folder);
    if q[0].nf < 1 { return -1; }
  }
  sub := method == "ReadSubagent" || method == "StopSubagent";
  if sub {
    if item.count < 1 { return -1; }
    q[0].nit = ea_copy(q[0].item[..], item);
    if q[0].nit < 1 { return -1; }
  } else if item.count > 0 {
    return -1;
  }
  if mode.count > 0 {
    if !ea_mode_ok(mode) { return -1; }
    // Omit "mode" when it is the host default ("auto") so default requests stay 100%
    // backward-compatible with deployed 16-key openagents-environment daemons.
    if mode != "auto" {
      q[0].nmd = ea_copy(q[0].mode[..], mode);
      if q[0].nmd < 1 { return -1; }
    }
  }
  if option_id.count > 0 {
    if method != "RespondInteraction" { return -1; }
    q[0].nop = ea_copy(q[0].option[..], option_id);
    if q[0].nop < 1 { return -1; }
  }
  if attachments.count > 0 {
    if method != "OpenSession" && method != "SendMessage" { return -1; }
    q[0].nat = ea_copy(q[0].attachments[..], attachments);
    if q[0].nat < 1 { return -1; }
  }
  return ea_write(q, out);
}

// Strict frozen v1 wire-compatibility predicate matching the 16-key ea_read allowlist of
// deployed openagents-environment hosts (before EaRequest.mode existed). Any default request
// produced by OpenAgents iOS/macOS MUST satisfy this predicate so legacy hosts never return "unsupported".
mc_v1_ea_compat :: (raw: string) -> bool #export_c #effects(all) {
  nodes: [64] JvNode; d: [1] Jv;
  if raw.count > 24576 || !jv_parse(d[..], raw, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return false; }
  v1_fields := [16] string.[
    "method", "workspace_id", "session_id", "command_id",
    "generation", "expected_revision", "text", "interaction_id",
    "allow", "before", "expires_at_ms", "issued_at_ms",
    "model", "effort", "folder", "item_id",
  ];
  for i: 0..<jv_len(d[0], 0) {
    k := jv_key(d[0], jv_at(d[0], 0, i));
    known := false;
    for allowed: v1_fields { if k == allowed { known = true; break; } }
    if !known { return false; }
  }
  return true;
}

mc_view_valid :: (v: [] EaView, host: string, method: string, raw: string) -> bool #export_c #effects(all) {
  if v.count < 1 || !hb_hex64(host) || !ea_view_read(raw, v) { return false; }
  return cast(string) v[0].host[0..<v[0].nh] == host && cast(string) v[0].method[0..<v[0].nm] == method;
}

// Encodes a typed WsRequest (Git diff, branches, worktrees, push, PRs) using caller-owned scratch q.
mc_ws_request :: (
  q: [] WsRequest,
  method: string,
  workspace: string,
  branch: string,
  base: string,
  title: string,
  body: string,
  number: int,
  page: int,
  cursor: int,
  expected: string,
  command: string,
  issued: int,
  expires: int,
  out: [] u8
) -> int #export_c #effects(all) {
  if q.count < 1 || ws_right(method) < 0 { return -1; }
  q[0] = WsRequest.{};
  q[0].nm = js_copy(q[0].method[..], method);
  q[0].nw = js_copy(q[0].workspace[..], ifx workspace.count > 0 then workspace else "default");
  q[0].nb = js_copy(q[0].branch[..], branch);
  q[0].na = js_copy(q[0].base[..], base);
  q[0].nt = js_copy(q[0].title[..], title);
  q[0].nd = js_copy(q[0].body[..], body);
  q[0].nx = js_copy(q[0].expected[..], expected);
  q[0].nc = js_copy(q[0].command[..], command);
  if q[0].nm < 1 || q[0].nw < 1 || q[0].nb < 0 || q[0].na < 0 || q[0].nt < 0 || q[0].nd < 0 || q[0].nx < 0 || q[0].nc < 0 { return -1; }
  q[0].number = number;
  q[0].page = page;
  q[0].cursor = cursor;
  q[0].issued = issued;
  q[0].expires = expires;
  return ws_write(q, out);
}

mc_ws_view_valid :: (v: [] WsView, host: string, method: string, raw: string) -> bool #export_c #effects(all) {
  if v.count < 1 || !hb_hex64(host) || !ws_view_read(raw, v) { return false; }
  return cast(string) v[0].host[..] == host && cast(string) v[0].method[0..<v[0].nm] == method;
}

// Encodes a typed DmRequest (ListSessionMeta, UpdateSessionMeta, ListArtifacts, ReadArtifact,
// ReadSwarm, ListAutomations, ToggleAutomation, RunAutomation, ReadAntigravityConfig, UpdateAntigravityConfig) (#14013-#14018).
// pinned_flag / archived_flag: -1 omit, 0 false, 1 true.
mc_dm_request :: (
  q: [] DmRequest,
  method: string,
  session: string,
  command: string,
  title: string,
  folder: string,
  text: string,
  pinned_flag: int,
  archived_flag: int,
  issued: int,
  expires: int,
  out: [] u8
) -> int #export_c #effects(all) {
  if q.count < 1 || !dm_method_valid(method) { return -1; }
  q[0] = DmRequest.{};
  q[0].nm = ea_copy(q[0].method[..], method);
  q[0].nw = ea_copy(q[0].workspace[..], "default");
  q[0].ns = ea_copy(q[0].session[..], session);
  q[0].nc = ea_copy(q[0].command[..], command);
  q[0].ntl = ea_copy(q[0].title[..], title);
  q[0].nf = ea_copy(q[0].folder[..], folder);
  q[0].nt = ea_copy(q[0].text[..], text);
  if q[0].nm < 1 || q[0].ns < 0 || q[0].nc < 0 || q[0].ntl < 0 || q[0].nf < 0 || q[0].nt < 0 { return -1; }
  if pinned_flag == 0 || pinned_flag == 1 { q[0].has_pinned = true; q[0].pinned = pinned_flag == 1; }
  if archived_flag == 0 || archived_flag == 1 { q[0].has_archived = true; q[0].archived = archived_flag == 1; }
  q[0].issued = issued;
  q[0].expires = expires;
  return dm_write(q, out);
}

mc_dm_view_valid :: (v: [] DmView, host: string, method: string, raw: string) -> bool #export_c #effects(all) {
  if v.count < 1 || !hb_hex64(host) || !dm_view_read(raw, v) { return false; }
  return cast(string) v[0].host[0..<v[0].nh] == host && cast(string) v[0].method[0..<v[0].nm] == method;
}

#test "shared Antigravity client core enforces dynamic Antigravity ACP models, review modes, and workspace RPCs" {
  #assert mc_is_core_model("oa:auto") && mc_is_core_model("oa:gemini-4-neon") && mc_is_core_model("oa:inkling-2-mini");
  #assert mc_is_agy_model("oa:auto") && mc_is_agy_model("oa:gemini-4-neon") && mc_is_agy_model("oa:inkling-2-mini");
  #assert mc_is_agy_model("gemini-4-neon") && mc_is_agy_model("antigravity") && mc_is_agy_model("gemini-pro-orchestrator") && mc_is_agy_model("claude-opus-5-5") && mc_is_agy_model("gpt-oss-120b");
  #assert !mc_is_agy_model("inkling-2-mini") && !mc_is_agy_model("inkling") && !mc_is_agy_model("default") && !mc_is_agy_model("--bad");
  #assert mc_mode_ok("auto") && mc_mode_ok("default") && mc_mode_ok("plan") && mc_mode_ok("accept-edits") && mc_mode_ok("turbo") && !mc_mode_ok("invalid");

  q: [1] EaRequest;
  out: [65536] u8;
  r: [1] EaRequest;
  // Unified OpenAgents Core (`oa-worker`) model slugs round-trip & keep strict v1 16-key compat in auto mode (#14060, #14073)
  nc := mc_env_request(q[..], "OpenSession", "0123456789abcdef0123456789abcdef", "0123456789abcdef0123456789abcdef", 1, 0, "Run OpenAgents Core turn", "", false, 0, 1700000000000, 1700000300000, "oa:auto", "high", "apps/openagents-ios", "", "auto", "", "", out[..]);
  #assert nc > 0 && mc_v1_ea_compat(cast(string) out[0..<nc]) && ea_read(cast(string) out[0..<nc], r[..]) && cast(string) r[0].model[0..<r[0].nmo] == "oa:auto" && cast(string) r[0].effort[0..<r[0].nef] == "high";
  nc = mc_env_request(q[..], "OpenSession", "0123456789abcdef0123456789abcdef", "0123456789abcdef0123456789abcdef", 1, 0, "Local $0 Inkling turn", "", false, 0, 1700000000000, 1700000300000, "oa:local", "xhigh", "", "", "auto", "", "", out[..]);
  #assert nc > 0 && mc_v1_ea_compat(cast(string) out[0..<nc]) && ea_read(cast(string) out[0..<nc], r[..]) && cast(string) r[0].model[0..<r[0].nmo] == "oa:inkling-2-mini" && cast(string) r[0].effort[0..<r[0].nef] == "high";
  n := mc_env_request(q[..], "OpenSession", "0123456789abcdef0123456789abcdef", "0123456789abcdef0123456789abcdef", 1, 0, "Review diff", "", false, 0, 1700000000000, 1700000300000, "gemini-4-neon", "high", "apps/openagents-ios", "", "plan", "", "", out[..]);
  #assert n > 0 && ea_read(cast(string) out[0..<n], r[..]);
  #assert cast(string) r[0].mode[0..<r[0].nmd] == "plan" && cast(string) r[0].model[0..<r[0].nmo] == "gemini-4-neon";
  // accept-edits & turbo modes round-trip cleanly (#13996)
  n = mc_env_request(q[..], "OpenSession", "0123456789abcdef0123456789abcdef", "0123456789abcdef0123456789abcdef", 1, 0, "Edit files", "", false, 0, 1700000000000, 1700000300000, "gemini-4-neon", "high", "", "", "accept-edits", "", "", out[..]);
  #assert n > 0 && ea_read(cast(string) out[0..<n], r[..]) && cast(string) r[0].mode[0..<r[0].nmd] == "accept-edits";
  // RespondInteraction option_id round-trips and is rejected on non-interaction methods (#13997)
  n = mc_env_request(q[..], "RespondInteraction", "0123456789abcdef0123456789abcdef", "0123456789abcdef0123456789abcdef", 1, 0, "", "int-1", false, 0, 1700000000000, 1700000300000, "", "", "", "", "", "reject_always", "", out[..]);
  #assert n > 0 && ea_read(cast(string) out[0..<n], r[..]) && cast(string) r[0].option[0..<r[0].nop] == "reject_always";
  #assert mc_env_request(q[..], "ListSessions", "", "", 0, 0, "", "", false, 0, 0, 0, "", "", "", "", "", "reject_always", "", out[..]) < 0;
  // Structured attachments round-trip on OpenSession/SendMessage and are rejected on reads (#14002)
  att := "[{\"name\":\"shot.jpg\",\"mime_type\":\"image/jpeg\",\"data\":\"/9j/4AAQ\"}]";
  n = mc_env_request(q[..], "SendMessage", "0123456789abcdef0123456789abcdef", "0123456789abcdef0123456789abcdef", 1, 1, "Inspect this", "", false, 0, 1700000000000, 1700000300000, "gemini-4-neon", "medium", "", "", "auto", "", att, out[..]);
  #assert n > 0 && ea_read(cast(string) out[0..<n], r[..]) && r[0].nat == att.count;
  #assert mc_env_request(q[..], "ReadSession", "0123456789abcdef0123456789abcdef", "", 0, 0, "", "", false, 0, 0, 0, "", "", "", "", "", "", att, out[..]) < 0;

  // ListSessions with "antigravity" preserves the native ~/.gemini query sentinel
  n = mc_env_request(q[..], "ListSessions", "", "", 0, 0, "", "", false, 0, 0, 0, "antigravity", "", "", "", "", "", "", out[..]);
  #assert n > 0 && ea_read(cast(string) out[0..<n], r[..]) && cast(string) r[0].model[0..<r[0].nmo] == "antigravity";

  // Invalid mode or local Inkling / default rejected at wire boundary; Orchestrator omits effort; HostUpdateAgy valid (#14004, #14005)
  #assert mc_env_request(q[..], "OpenSession", "0123456789abcdef0123456789abcdef", "0123456789abcdef0123456789abcdef", 1, 0, "hi", "", false, 0, 1700000000000, 1700000300000, "gemini-4-neon", "high", "", "", "bogus", "", "", out[..]) < 0;
  #assert mc_env_request(q[..], "OpenSession", "0123456789abcdef0123456789abcdef", "0123456789abcdef0123456789abcdef", 1, 0, "hi", "", false, 0, 1700000000000, 1700000300000, "inkling-2-mini", "high", "", "", "auto", "", "", out[..]) < 0;
  n = mc_env_request(q[..], "OpenSession", "0123456789abcdef0123456789abcdef", "0123456789abcdef0123456789abcdef", 1, 0, "hi", "", false, 0, 1700000000000, 1700000300000, "gemini-pro-orchestrator", "high", "", "", "auto", "", "", out[..]);
  #assert n > 0 && ea_read(cast(string) out[0..<n], r[..]) && cast(string) r[0].model[0..<r[0].nmo] == "gemini-pro-orchestrator" && r[0].nef == 0;
  n = mc_env_request(q[..], "OpenSession", "0123456789abcdef0123456789abcdef", "0123456789abcdef0123456789abcdef", 1, 0, "hi", "", false, 0, 1700000000000, 1700000300000, "claude-opus-5-5", "max", "", "", "auto", "", "", out[..]);
  #assert n > 0 && ea_read(cast(string) out[0..<n], r[..]) && cast(string) r[0].model[0..<r[0].nmo] == "claude-opus-5-5" && cast(string) r[0].effort[0..<r[0].nef] == "max";
  n = mc_env_request(q[..], "HostUpdateAgy", "", "0123456789abcdef0123456789abcdef", 0, 0, "", "", false, 0, 1700000000000, 1700000300000, "", "", "", "", "", "", "", out[..]);
  #assert n > 0 && ea_read(cast(string) out[0..<n], r[..]) && cast(string) r[0].method[0..<r[0].nm] == "HostUpdateAgy";

  // Workspace ReadWorkspace & SwitchBranch encoding
  wq: [1] WsRequest; wr: [1] WsRequest;
  wn := mc_ws_request(wq[..], "ReadWorkspace", "default", "", "", "", "", 0, 0, 0, "", "", 0, 0, out[..]);
  #assert wn > 0 && ws_read(cast(string) out[0..<wn], wr[..]) && cast(string) wr[0].method[0..<wr[0].nm] == "ReadWorkspace";
  rev := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
  wn = mc_ws_request(wq[..], "SwitchBranch", "default", "feat/antigravity", "", "", "", 0, 0, 0, rev, "0123456789abcdef0123456789abcdef", 1700000000000, 1700000060000, out[..]);
  #assert wn > 0 && ws_read(cast(string) out[0..<wn], wr[..]) && cast(string) wr[0].branch[0..<wr[0].nb] == "feat/antigravity";
  #assert mc_ws_request(wq[..], "SwitchBranch", "default", "-rf", "", "", "", 0, 0, 0, rev, "0123456789abcdef0123456789abcdef", 1700000000000, 1700000060000, out[..]) < 0;
}

#test "default OpenSession and SendMessage requests strictly obey v1 16-key legacy host wire compatibility" {
  q: [1] EaRequest;
  out: [65536] u8;
  r: [1] EaRequest;
  sid := "0123456789abcdef0123456789abcdef";
  cmd := "abcdef0123456789abcdef0123456789";

  // Default mode ("auto" or "") MUST omit "mode", "option_id", "attachments" and pass mc_v1_ea_compat
  models := [5] string.["gemini-4-neon", "gemini-4-carbon", "gemini-4-hydrogen", "gemini-4-argon", "gemini-3.8-flash"];
  efforts := [4] string.["low", "medium", "high", "xhigh"];
  for m: models {
    for e: efforts {
      n := mc_env_request(q[..], "OpenSession", sid, cmd, 1, 0, "hello world", "", false, 0, 1700000000000, 1700000300000, m, e, "", "", "auto", "", "", out[..]);
      #assert n > 0;
      raw := cast(string) out[0..<n];
      #assert mc_v1_ea_compat(raw) && ea_read(raw, r[..]) && r[0].nmd == 0 && r[0].nop == 0 && r[0].nat == 0;

      n2 := mc_env_request(q[..], "SendMessage", sid, cmd, 1, 2, "follow up", "", false, 0, 1700000000000, 1700000300000, m, e, "", "", "", "", "", out[..]);
      #assert n2 > 0;
      raw2 := cast(string) out[0..<n2];
      #assert mc_v1_ea_compat(raw2) && ea_read(raw2, r[..]) && r[0].nmd == 0 && r[0].nop == 0 && r[0].nat == 0;
    }
  }

  // Explicit non-default mode ("plan" / "default") emits "mode" (v2 host) and fails strict v1 allowlist as expected
  np := mc_env_request(q[..], "OpenSession", sid, cmd, 1, 0, "plan it", "", false, 0, 1700000000000, 1700000300000, "gemini-4-neon", "medium", "", "", "plan", "", "", out[..]);
  #assert np > 0 && !mc_v1_ea_compat(cast(string) out[0..<np]) && ea_read(cast(string) out[0..<np], r[..]) && cast(string) r[0].mode[0..<r[0].nmd] == "plan";

  // Every read/control method stays strictly v1 compatible when option_id/attachments omitted
  methods := [6] string.["DescribeEnvironment", "ListSessions", "ReadSession", "StopTurn", "RespondInteraction", "ReadSubagent"];
  for meth: methods {
    item_arg := ifx meth == "ReadSubagent" then "0:0" else "";
    nr := mc_env_request(q[..], meth, sid, cmd, 1, 0, "", "int-1", true, 0, 1700000000000, 1700000300000, "", "", "", item_arg, "", "", "", out[..]);
    #assert nr > 0 && mc_v1_ea_compat(cast(string) out[0..<nr]) && ea_read(cast(string) out[0..<nr], r[..]);
  }
}

#forall "fuzz: arbitrary ASCII bytes in message text round-trip safely through mc_env_request and mc_v1_ea_compat" b: u8 {
  q: [1] EaRequest;
  out: [65536] u8;
  r: [1] EaRequest;
  tb: [4] u8;
  tb[0] = 'x';
  // Keep valid printable/newline UTF-8 ASCII bytes (ea_write escapes quotes/backslashes/control chars cleanly)
  tb[1] = ifx b < 128 && (b >= 32 || b == 10 || b == 9) then b else 'a';
  tb[2] = '"';
  tb[3] = '\\';
  n := mc_env_request(q[..], "OpenSession", "0123456789abcdef0123456789abcdef", "abcdef0123456789abcdef0123456789", 1, 0, cast(string) tb[..], "", false, 0, 1700000000000, 1700000300000, "gemini-4-neon", "medium", "", "", "auto", "", "", out[..]);
  #assert n > 0 && mc_v1_ea_compat(cast(string) out[0..<n]) && ea_read(cast(string) out[0..<n], r[..]);
  #assert cast(string) r[0].text[0..<r[0].nt] == cast(string) tb[..];
}

#test "client-core: exported #authority Layer-2 reliability and route-policy C ABI (#14030, #14032)" {
  #assert mc_rr_sync_action(false, true, 5, 0, 10) == RR_SYNC_WAIT_TRANSPORT;
  #assert mc_rr_sync_action(true, false, 5, 0, 10) == RR_SYNC_WAIT_AUTH;
  #assert mc_rr_sync_action(true, true, 2, 5, 10) == RR_SYNC_SNAPSHOT;
  #assert mc_rr_sync_action(true, true, 5, 5, 10) == RR_SYNC_INCREMENTAL;
  #assert mc_rr_request_liveness(RR_REQ_LIVE_CALLBACK, 1, 2, true, 100, 0) == RR_LIFE_DEAD_PROCESS;
  #assert mc_rr_request_liveness(RR_REQ_ASYNC_MESSAGE, 1, 2, false, 100, 0) == RR_LIFE_ACTIVE;
  #assert mc_route_select(true, false, 1000, true, true, 0, true, true, 0, 5000) == RP_ROUTE_LAN;
  #assert mc_route_select(true, false, 1000, true, true, 0, true, true, 0, 16000) == RP_ROUTE_TAILNET;
  #assert mc_cred_audience_ok(RP_AUD_TAILNET_GRANT, RP_AUD_TAILNET_GRANT, 100, 200);
  #assert !mc_cred_audience_ok(RP_AUD_PAIRING_BOOTSTRAP, RP_AUD_TAILNET_GRANT, 100, 200);
}
