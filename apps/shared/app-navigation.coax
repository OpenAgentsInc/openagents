// Shared history navigation. Domain bytes use the existing environment codec;
// the browser is a separate read-only EnvironmentApp and shares one HTTP slot.
#load "environment-app.coax";
#load "../../coax/lib/nostr/nip51.coax"; // the existing folded substring matcher
#load "../../coax/native/workspace.coax";
#load "../../coax/lib/crypto/sha256-memory.coax";
NAV_THREADS :: 512; NAV_VISIBLE :: 96;
NavThread :: struct {host:int;session:EaSession;}
NavGroup :: struct {loaded:bool;failed:bool;complete:bool;cursor:[128]u8;nc:int;offer:EaOffer;offset:int;}
NavDraft :: struct {key:[224]u8;nk:int;body:[16384]u8;nb:int;age:int;}
AppNavigation :: struct {
 open:bool;rail:bool=true;history_open:bool=true;account_refresh:bool;settings:bool;creating:bool;started:bool;refresh:bool;next:int;page_size:int=32;account_at:int;
 query:[128]u8;nq:int;browser:[1]EnvironmentApp;groups:[64]NavGroup;rows:[NAV_THREADS]NavThread;n:int;
 drafts:[16]NavDraft;clock:int;pending:[96]u8;np:int;note:[256]u8;nn:int;
}
// The id is SHA-256 of "host TAB session", pinned here: a change to how it is hashed fails this check
// (saved rows, drafts and the open chat are matched by it) instead of silently losing chats on a device.
#test "a computer chat's row id is SHA-256 of host TAB session, pinned to a known digest" {
 b:[64]u8;h:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
 #assert nav_session_id(h,"alpha",b[..])=="nav.chat.2a80f5775a9b70a8e30e7da08f35f50aea42f6";
 #assert nav_session_id(h,"",b[..])=="" && nav_session_id("short","alpha",b[..])=="";
}
#test "history filtering searches title and computer without changing the stored query" {
 n:[1]AppNavigation;n[0].nq=ea_copy(n[0].query[..],"MAC");
 #assert nav_match(n[..],"Morning task","Mac") && !nav_match(n[..],"Morning task","CoderOS");
 n[0].nq=ea_copy(n[0].query[..],"TASK");#assert nav_match(n[..],"Morning task","CoderOS");
}
#test "draft cache is scoped to its exact conversation and bounded by replacement" {
 n:[1]AppNavigation;nav_keep_draft(n[..],"mac/chat","unsent **text**");nav_keep_draft(n[..],"coder/chat","other");
 #assert nav_draft(n[..],"mac/chat")=="unsent **text**" && nav_draft(n[..],"absent")=="";
 nav_keep_draft(n[..],"mac/chat","updated");#assert nav_draft(n[..],"mac/chat")=="updated";
}
#test "navigation refresh replaces only that host and preserves session identities" {
 n:[1]AppNavigation;n[0].browser[0].selected=0;n[0].browser[0].view[0].ok=true;n[0].browser[0].view[0].ns=1;
 s:=n[0].browser[0].view[0].sessions[..];s[0].ni=ea_copy(s[0].id[..],"one");nav_accept(n[..],0);
 n[0].browser[0].selected=1;s[0].ni=ea_copy(s[0].id[..],"two");nav_accept(n[..],0);
 n[0].browser[0].selected=0;s[0].ni=ea_copy(s[0].id[..],"three");nav_accept(n[..],0);
 #assert n[0].n==2 && n[0].groups[0].loaded && n[0].groups[1].loaded;
 #assert cast(string)n[0].rows[0].session.id[0..<n[0].rows[0].session.ni]=="two";
}
#test "each loaded computer gets a share of bounded history and search starts at latest" {
 n:[1]AppNavigation;n[0].browser[0].catalog[0].n=2;n[0].n=2;n[0].rows[1].host=1;
 #assert nav_page_size(n[..],true)==32 && nav_page_size(n[..],false)==48;
 n[0].groups[0].offset=96;n[0].account_at=32;nav_search(n[..],"coder");#assert n[0].groups[0].offset==0 && n[0].account_at==0;
}
nav_search :: (n:[]AppNavigation,text:string) {n[0].nq=ea_copy(n[0].query[..],text);for i:0..<64 {n[0].groups[i].offset=0;}n[0].account_at=0;}
nav_page_size :: (n:[]AppNavigation,account:bool)->int {
 groups:=ifx account then 1 else 0;
 for host:0..<n[0].browser[0].catalog[0].n {entry:=n[0].browser[0].catalog[0].entries[host];for i:0..<n[0].n {r:=n[0].rows[i];if r.host==host && nav_match(n,cast(string)r.session.title[0..<r.session.nt],cast(string)entry.label[0..<entry.nl]) {groups+=1;break;}}}
 return NAV_VISIBLE/(ifx groups>0 then groups else 1);
}
nav_note :: (n:[]AppNavigation,text:string) {n[0].nn=ea_copy(n[0].note[..],text);}
nav_match :: (n:[]AppNavigation,title:string,host:string)->bool {q:=cast(string)n[0].query[0..<n[0].nq];return q.count==0 || nl_contains_folded(title,q) || nl_contains_folded(host,q);}
nav_keep_draft :: (n:[]AppNavigation,key:string,body:string) {
 if key.count==0 || key.count>224 || body.count>16384 {return;}at:=0;old:=n[0].clock+1;
 for i:0..<16 {d:=n[0].drafts[i];if cast(string)d.key[0..<d.nk]==key {at=i;break;}if d.age<old {at=i;old=d.age;}}
 n[0].clock+=1;n[0].drafts[at].nk=ea_copy(n[0].drafts[at].key[..],key);n[0].drafts[at].nb=ea_copy(n[0].drafts[at].body[..],body);n[0].drafts[at].age=n[0].clock;
}
nav_draft :: (n:[]AppNavigation,key:string)->string {for i:0..<16 {if n[0].drafts[i].nk>0 && cast(string)n[0].drafts[i].key[0..<n[0].drafts[i].nk]==key {return cast(string)n[0].drafts[i].body[0..<n[0].drafts[i].nb];}}return "";}
// A row follows its full host/session identity, including after catalog reorder.
nav_session_id :: (host:string,session:string,out:[]u8)->string {
 if host.count!=64 || session.count<1 || session.count>128 || out.count<47 {return "";}
 key:[193]u8;for c,i:host {key[i]=c;}key[64]='\t';for c,i:session {key[65+i]=c;}
 // key and hash are two locals, never overlapping: the checked form (as hmac and bip39 call it) is the same
 // code on the device and in a compile-time check, so the pinned digest below checks the device's path
 hash:[32]u8;if sha256_hash_checked(key[0..<65+session.count],hash[..],false)!=SHA_OK {return "";}
 prefix:="nav.chat.";for c,i:prefix {out[i]=c;}hex:="0123456789abcdef";
 for i:0..<19 {out[9+2*i]=hex[cast(int)(hash[i]>>4)];out[10+2*i]=hex[cast(int)(hash[i]&15)];}return cast(string)out[0..<47];
}
nav_row_id :: (n:[]AppNavigation,i:int,out:[]u8)->string {r:=n[0].rows[i];return nav_session_id(cast(string)n[0].browser[0].catalog[0].entries[r.host].host[..],cast(string)r.session.id[0..<r.session.ni],out);}
nav_accept :: (n:[]AppNavigation,before:int) {
 b:=n[0].browser[..];host:=b[0].selected;if host<0 || host>=64 || !b[0].view[0].ok {return;}
 v:=b[0].view[..];g:=n[0].groups[host];g.loaded=true;g.failed=v[0].ne>0 || b[0].uncertain;
 if g.failed {n[0].groups[host]=g;return;}
 if before==0 {g.offset=0;to:=0;for i:0..<n[0].n {if n[0].rows[i].host!=host {n[0].rows[to]=n[0].rows[i];to+=1;}}n[0].n=to;}
 for i:0..<v[0].ns {s:=v[0].sessions[i];at:= -1;for j:0..<n[0].n {r:=n[0].rows[j];if r.host==host && cast(string)r.session.id[0..<r.session.ni]==cast(string)s.id[0..<s.ni] {at=j;break;}}
  if at<0 {if n[0].n>=NAV_THREADS {nav_note(n,"History is limited to 512 chats. Filter by computer or open older chats on that computer.");break;}at=n[0].n;n[0].n+=1;}n[0].rows[at]=NavThread.{host=host,session=s};
 }
 g.complete=v[0].complete;g.nc=ea_copy(g.cursor[..],cast(string)v[0].cursor[0..<v[0].nc]);g.offer=b[0].offer[0];n[0].groups[host]=g;
}
nav_begin :: (n:[]AppNavigation) {n[0].started=true;n[0].next=0;n[0].refresh=false;old:=n[0].browser[0].catalog[0];eu_enter(n[0].browser[..]);n[0].browser[0].catalog[0]=old;}
#test "a reordered catalog keeps each history group on its exact host" {
 n:[1]AppNavigation;old:[1]EaCatalog;old[0].n=2;_:=ea_copy(old[0].entries[0].host[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");_:=ea_copy(old[0].entries[1].host[..],"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb");
 n[0].browser[0].catalog[0].n=1;n[0].browser[0].catalog[0].entries[0]=old[0].entries[1];n[0].n=2;n[0].rows[0].host=0;n[0].rows[1].host=1;n[0].groups[1].loaded=true;
 nav_reindex(n[..],old[..]);#assert n[0].n==1 && n[0].rows[0].host==0 && n[0].groups[0].loaded;
}
nav_reindex :: (n:[]AppNavigation,old:[]EaCatalog) {
 map:[64]int;groups:[64]NavGroup;for i:0..<64 {map[i]= -1;}
 for i:0..<old[0].n {for j:0..<n[0].browser[0].catalog[0].n {if cast(string)old[0].entries[i].host[..]==cast(string)n[0].browser[0].catalog[0].entries[j].host[..] {map[i]=j;groups[j]=n[0].groups[i];}}}
 count:=0;for i:0..<n[0].n {r:=n[0].rows[i];if map[r.host]>=0 {r.host=map[r.host];n[0].rows[count]=r;count+=1;}}n[0].n=count;n[0].groups=groups;
}
nav_observe :: (n:[]AppNavigation,e:[]EnvironmentApp) {
 if !e[0].active || e[0].selected<0 || !e[0].view[0].ok || e[0].uncertain {return;}
 host:= -1;for i:0..<n[0].browser[0].catalog[0].n {if cast(string)n[0].browser[0].catalog[0].entries[i].host[..]==cast(string)e[0].catalog[0].entries[e[0].selected].host[..] {host=i;}}
 if host<0 {return;}
 for i:0..<e[0].view[0].ns {s:=e[0].view[0].sessions[i];if cast(string)s.id[0..<s.ni]!=cast(string)e[0].session[0..<e[0].ns] {continue;}at:= -1;
  for j:0..<n[0].n {r:=n[0].rows[j];if r.host==host && cast(string)r.session.id[0..<r.session.ni]==cast(string)s.id[0..<s.ni] {at=j;break;}}
  if at<0 {if n[0].n>=NAV_THREADS {return;}at=n[0].n;n[0].n+=1;}n[0].rows[at]=NavThread.{host=host,session=s};n[0].groups[host].offer=e[0].offer[0];
 }
}
nav_reply :: (n:[]AppNavigation,status:int,raw:string,failed:bool) {
 b:=n[0].browser[..];catalog:=b[0].selected<0;before:=b[0].request[0].before;old:[1]EaCatalog;old[0]=b[0].catalog[0];
 eu_reply(b,4,status,raw,failed);
 if catalog {if !b[0].catalog[0].ok {b[0].catalog[0]=old[0];nav_note(n,"Computers could not be loaded. Refresh to retry.");n[0].next=64;}else {nav_reindex(n,old[..]);nav_note(n,"");n[0].next=0;}return;}
 if b[0].uncertain {n[0].groups[b[0].selected].loaded=true;n[0].groups[b[0].selected].failed=true;}
 else {nav_accept(n,before);}
 if n[0].next<=b[0].selected {n[0].next=b[0].selected+1;}
}
nav_next :: (n:[]AppNavigation) {
 b:=n[0].browser[..];if !n[0].open || b[0].flight || b[0].action!=0 {return;}
 if !n[0].started || n[0].refresh {nav_begin(n);return;}
 if n[0].next>=b[0].catalog[0].n {return;}
 b[0].selected=n[0].next;b[0].page=1;b[0].uncertain=false;eu_request(b,"ListSessions");eu_http(b,false);
}
