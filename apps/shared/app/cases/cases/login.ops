# Log in: a logged-out send opens the login card; email, code, and the account is in.
clock data record auth.state: auth state => 200 {"loggedIn":false}
clock data record auth.start: auth email_start => 200 {}
clock data record auth.verify: auth email_verify => 200 {"loggedIn":true}
clock data release auth.state
state account.logged_in
tap chat.composer
type chat.composer Fix the failing build
state send.state
tap chat.composer.send
tree
state login.step
tap login.email
type login.email ada@example.com
tap login.send
clock data
clock data release auth.start
state login.step
tap login.code
type login.code 123456
tap login.verify
clock data release auth.verify
state login.step
state account.logged_in
state send.state
state chat.draft
logs
