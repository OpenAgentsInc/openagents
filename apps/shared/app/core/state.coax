// The state of the shared app core (GitHub #13645; coax/native.md "Application
// state and dispatch"): one caller-owned record with declared capacities. The
// host allocates one zeroed AppCore and calls app_init before anything else;
// zeroed memory alone is not a constructed state.
//
// Views read this record and never change it. Every change goes through
// app_dispatch (dispatch.coax). Other shared modules (login, environment, the
// chat view) read it through the accessors below and keep their dependence on
// field names in one place.
//
// Size: about 19 MiB, most of it the task transcript buffers the #13620 client
// needs (four of XH_LOG_MAX). It is too large for a stack; see INTEGRATION.md.
//   coax/bin/coax test apps/shared/app/core/core.coax --library --traversal 1000000000
#load "effects.coax";
#load "../../chat-task-protocol.coax";
#load "../../durable-chat.coax";

// Who may own an effect. A guest is a shared module outside the core (the
// environment picker today): the core carries its requests and hands its
// results back through the dispatch answer APP_GUEST.
OWN_ACCOUNT :: 0;      // login state and the login flow's requests
OWN_CHAT :: 1;         // the current conversation and its task
OWN_PAGE :: 2;         // copy and open-link, asked for by a tap
OWN_ENVIRONMENT :: 3;  // guest: environment and repository reads
OWN_SCREEN :: 8;       // the active Projects, Usage or Worlds page's serial effects
OWN_GUEST_LAST :: 8;   // guests 3..6 and 8; owner 7 remains the independent device lane
OWN_DEVICE :: 7;       // the conversation on a paired computer, and the paired list (device/lane.coax); no account

app_guest_owner :: (owner:int)->bool {return owner>=OWN_ENVIRONMENT && owner<=OWN_GUEST_LAST && owner!=OWN_DEVICE;}

// Is an account logged in. Unknown until the host answers the first FX_AUTH_STATE.
AUTH_UNKNOWN :: 0; AUTH_OUT :: 1; AUTH_IN :: 2;
// Where the email-code login is.
LOGIN_IDLE :: 0; LOGIN_SENDING :: 1; LOGIN_CODE :: 2; LOGIN_VERIFYING :: 3;

// Surfaces a change can touch. A view redraws a surface whose bit is set, then clears it.
SURF_TRANSCRIPT :: 1; SURF_COMPOSER :: 2; SURF_TASK :: 4; SURF_ACCOUNT :: 8; SURF_ENVIRONMENT :: 16; SURF_NOTE :: 32;
SURF_ALL :: 63;

// Why the app is not idle (app_busy).
BUSY_EFFECT :: 1;      // a request waits for the host, or the host holds one
BUSY_SCHEDULED :: 2;   // a read is scheduled; app_next_wake says when
BUSY_DIRTY :: 4;       // a surface changed and has not been drawn

APP_DRAFTS :: 8; APP_DRAFT_BYTES :: 16384;
APP_SLOT_VALUE :: 256; APP_SLOT_LABEL :: 128;
APP_NOTE :: 256; APP_EMAIL :: 254; APP_CODE :: 16; APP_WORDS :: 400;
APP_ID :: 36;

// A composer draft, kept for one conversation ("" is the new chat).
AppDraft :: struct { used: bool; key: [APP_ID] u8; key_n: int; text: [APP_DRAFT_BYTES] u8; n: int; touched: int; }
// A selection another module fills: a plain value and the words to show for it.
AppSlot :: struct { value: [APP_SLOT_VALUE] u8; value_n: int; label: [APP_SLOT_LABEL] u8; label_n: int; }
// A guest's completion, waiting to be routed by the root that loads the guest.
AppGuest :: struct { waiting: bool; owner: int; purpose: int; op: int; outcome: int; status: int; }

AppCore :: struct {
  ready: bool; in_dispatch: bool;
  // facts the host reports with every event
  mono_ms: int; wall_ms: int; foreground: bool;
  // the account
  auth: int; login: int; login_wanted: bool; account_op: int; account_purpose: int;
  email: [APP_EMAIL] u8; email_n: int; words: [APP_WORDS] u8; words_n: int;
  // conversations: the current one, its drafts and the selections sent with a request
  chat: [1] DurableChat;
  drafts: [APP_DRAFTS] AppDraft; draft_clock: int;
  environment: [1] AppSlot; repository: [1] AppSlot;
  rejoin: [APP_ID] u8; rejoin_n: int;
  // the chat owner's single request in flight and its schedule (task-client.coax)
  flight: int; purpose: int; last_task: bool;
  want_history: bool; want_turn: bool;
  read_at: int; poll_at: int; task_at: int; idle_at: int;
  scratch: [1] CtHistory;
  task_data: [XH_LOG_MAX] u8; task_pools: [2] [XH_LOG_MAX] u8; task_decode: [XH_LOG_MAX] u8;
  // what we tell the person about the last thing that went wrong ("" when nothing)
  note: [APP_NOTE] u8; note_n: int;
  dirty: int;
  guest: AppGuest;
  guest_due: [FX_OWNERS] int; // monotonic deadlines, 0 none; guests use the same sleeping host timer
  // the conversation on the person's own computer, with no account (apps/shared/app/device/)
  device: [] DeviceLane;               // attached by the host (app_host_device); empty: none
  out: [1] FxOutbox;
  refusals: int;                      // events refused so far
}

// Construct the state in zeroed caller-owned storage. Call once, before the first event.
app_init :: (c: [] AppCore) {
  fx_init(c[0].out[..]);
  c[0].chat[0] = DurableChat.{}; c[0].chat[0].enabled = true;
  c[0].scratch[0].legacy_revision = -1; c[0].scratch[0].next = -1;
  c[0].auth = AUTH_UNKNOWN; c[0].login = LOGIN_IDLE; c[0].foreground = true;
  c[0].dirty = SURF_ALL; c[0].ready = true;
}

app_mark :: (c: [] AppCore, surfaces: int) { c[0].dirty = c[0].dirty | (surfaces & SURF_ALL); }
app_say :: (c: [] AppCore, text: string) {
  n := js_copy(c[0].note[..], text); c[0].note_n = ifx n < 0 then 0 else n;
  app_mark(c, SURF_NOTE);
}
app_note :: (c: [] AppCore) -> string { return cast(string) c[0].note[0..<c[0].note_n]; }
app_words :: (c: [] AppCore) -> string { return cast(string) c[0].words[0..<c[0].words_n]; }
app_email :: (c: [] AppCore) -> string { return cast(string) c[0].email[0..<c[0].email_n]; }
app_chat :: (c: [] AppCore) -> [] DurableChat { return c[0].chat[..]; }
app_task :: (c: [] AppCore) -> [] NativeTaskApp { return c[0].chat[0].native[..]; }
// The current conversation's ID, "" for a chat not saved yet.
app_conversation :: (c: [] AppCore) -> string { return dca_id(c[0].chat[..]); }

// ---------------------------------------------------------------- drafts

app_draft_find :: (c: [] AppCore, key: string) -> int {
  for i: 0..<APP_DRAFTS { if c[0].drafts[i].used && cast(string) c[0].drafts[i].key[0..<c[0].drafts[i].key_n] == key { return i; } }
  return -1;
}
// The draft of one conversation, "" when it has none.
app_draft_of :: (c: [] AppCore, key: string) -> string {
  at := app_draft_find(c, key);
  return ifx at < 0 then "" else cast(string) c[0].drafts[at].text[0..<c[0].drafts[at].n];
}
// The current conversation's draft.
app_draft :: (c: [] AppCore) -> string { return app_draft_of(c, app_conversation(c)); }
// Keep text as a conversation's draft; "" forgets it. With every slot used, the draft touched
// longest ago gives way. False (and no change) when the key or the text is too long.
app_draft_keep :: (c: [] AppCore, key: string, text: string) -> bool {
  if key.count > APP_ID || text.count > APP_DRAFT_BYTES { return false; }
  at := app_draft_find(c, key);
  if text.count == 0 { if at >= 0 { c[0].drafts[at].used = false; c[0].drafts[at].n = 0; } return true; }
  if at < 0 {
    for i: 0..<APP_DRAFTS { if !c[0].drafts[i].used { at = i; break; } }
    if at < 0 { at = 0; for i: 1..<APP_DRAFTS { if c[0].drafts[i].touched < c[0].drafts[at].touched { at = i; } } }
    c[0].drafts[at].used = true; c[0].drafts[at].key_n = js_copy(c[0].drafts[at].key[..], key);
  }
  c[0].drafts[at].n = js_copy(c[0].drafts[at].text[..], text);
  c[0].draft_clock += 1; c[0].drafts[at].touched = c[0].draft_clock;
  return true;
}
// Forget drafts. keep_new: keep the new chat's draft (key ""), which belongs to no conversation.
app_drafts_clear :: (c: [] AppCore, keep_new: bool) {
  for i: 0..<APP_DRAFTS { if keep_new && c[0].drafts[i].used && c[0].drafts[i].key_n == 0 { continue; } c[0].drafts[i].used = false; c[0].drafts[i].n = 0; c[0].drafts[i].key_n = 0; }
}

// ---------------------------------------------------------------- selections

app_slot_set :: (s: [] AppSlot, value: string, label: string) -> bool {
  if value.count > APP_SLOT_VALUE || label.count > APP_SLOT_LABEL { return false; }
  s[0].value_n = js_copy(s[0].value[..], value); s[0].label_n = js_copy(s[0].label[..], label);
  return true;
}
app_environment :: (c: [] AppCore) -> string { return cast(string) c[0].environment[0].value[0..<c[0].environment[0].value_n]; }
app_environment_label :: (c: [] AppCore) -> string { return cast(string) c[0].environment[0].label[0..<c[0].environment[0].label_n]; }
app_repository :: (c: [] AppCore) -> string { return cast(string) c[0].repository[0].value[0..<c[0].repository[0].value_n]; }
app_repository_label :: (c: [] AppCore) -> string { return cast(string) c[0].repository[0].label[0..<c[0].repository[0].label_n]; }

// ---------------------------------------------------------------- what the composer may do

// Send: SEND_EMPTY nothing to send; SEND_LOGIN the person must log in first (ask the login flow);
// SEND_WAIT login state is not known yet, or an earlier request is unresolved; SEND_STOP a reply
// is running, so the button stops it; SEND_READY.
SEND_EMPTY :: 0; SEND_LOGIN :: 1; SEND_WAIT :: 2; SEND_STOP :: 3; SEND_READY :: 4;
app_send_state :: (c: [] AppCore) -> int {
  if app_device_on(c) { return dl_send_state(c); }
  d := c[0].chat[..];
  if c[0].auth == AUTH_IN && dca_working(d) { return SEND_STOP; }
  if app_draft(c).count == 0 { return SEND_EMPTY; }
  if c[0].auth == AUTH_OUT { return SEND_LOGIN; }
  if c[0].auth != AUTH_IN || dca_blocked(d) || (d[0].id_n > 0 && !d[0].loaded) { return SEND_WAIT; }
  return SEND_READY;
}
// Stop: STOP_NONE nothing runs; STOP_READY it can be asked; STOP_ASKED we are sending it;
// STOP_UNCERTAIN we sent it and do not know that it arrived (ACT_RETRY sends the same request
// again); STOP_SEEN the service has it and the reply is winding down.
STOP_NONE :: 0; STOP_READY :: 1; STOP_ASKED :: 2; STOP_UNCERTAIN :: 3; STOP_SEEN :: 4;
app_stop_state :: (c: [] AppCore) -> int {
  if app_device_on(c) { return dl_stop_state(c); }
  d := c[0].chat[..]; n := d[0].native[..];
  if d[0].pending == 2 { return ifx d[0].uncertain then STOP_UNCERTAIN else STOP_ASKED; }
  if d[0].want_stop { return STOP_ASKED; }
  if n[0].verb == "stop" && nta_pending(n) { return ifx n[0].uncertain then STOP_UNCERTAIN else STOP_ASKED; }
  if dca_working(d) { return ifx d[0].view[0].stop_requested then STOP_SEEN else STOP_READY; }
  if n[0].bound && n[0].has_status && !xt_terminal(n[0].status[0].state) { return ifx n[0].status[0].stop then STOP_SEEN else STOP_READY; }
  return STOP_NONE;
}
// A permission prompt: PERMIT_NONE; PERMIT_READING the task waits for an answer and we are still
// reading what it asks (Deny works, Allow does not yet); PERMIT_READY both work; PERMIT_SENT an
// answer is on its way; PERMIT_UNCERTAIN we sent one and do not know that it arrived.
PERMIT_NONE :: 0; PERMIT_READING :: 1; PERMIT_READY :: 2; PERMIT_SENT :: 3; PERMIT_UNCERTAIN :: 4;
app_permission_state :: (c: [] AppCore) -> int {
  if app_device_on(c) { return dl_permission_state(c); }
  n := c[0].chat[0].native[..];
  if n[0].verb != "stop" && nta_pending(n) { return ifx n[0].uncertain then PERMIT_UNCERTAIN else PERMIT_SENT; }
  if !nta_permission(n) { return PERMIT_NONE; }
  return ifx nta_reviewable(n) then PERMIT_READY else PERMIT_READING;
}
