// The GPU history bridge uses the existing navigation/controller and environment codecs.
#import "Basic";
#load "devices.coax";
dh_answer :: (h:[]DeviceHistory,c:[]AppCore,host:string,id:string,cursor:string) {
 v:[1]EaView;v[0].ok=true;v[0].nh=ea_copy(v[0].host[..],host);v[0].nm=ea_copy(v[0].method[..],"ListSessions");v[0].ns=1;v[0].complete=cursor.count==0;v[0].nc=ea_copy(v[0].cursor[..],cursor);
 s:=v[0].sessions[..];s[0].ni=ea_copy(s[0].id[..],id);s[0].nw=ea_copy(s[0].workspace[..],"default");s[0].nt=ea_copy(s[0].title[..],"Same title\nwith a line break");s[0].nc=ea_copy(s[0].control[..],"observe-only");
 raw:[65536]u8;n:=ea_view_write(v[..],raw[..]);#assert n>0;op:=h[0].op;gen:=fx_generation(c[0].out[..],DH_OWNER);#assert fx_take(c[0].out[..],op);
 #assert app_dispatch(c,AppEvent.{kind=EV_DONE,op=op,generation=gen,outcome=FXO_DONE,status=200,text=cast(string)raw[0..<n],mono_ms=c[0].mono_ms,wall_ms=c[0].wall_ms})==APP_GUEST;
 #assert dh_guest(h,c,cast(string)raw[0..<n]);
}
dh_checks :: () {
 c:[1]AppCore;d:[1]DeviceLane;h:[1]DeviceHistory;app_init(c[..]);#assert app_device_attach(c[..],d[..]);c[0].foreground=true;
 a:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";b:="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
 dl_list_read(c[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tMac\nbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tCoderOS\n");
 dh_sync(h[..],c[..],false);#assert h[0].op==0;
 dh_sync(h[..],c[..],true);first:=h[0].op;#assert first>0 && c[0].auth!=AUTH_IN;dh_sync(h[..],c[..],true);#assert h[0].op==first;
 dh_answer(h[..],c[..],a,"one","123");dh_sync(h[..],c[..],true);#assert h[0].op>0;
 dh_answer(h[..],c[..],b,"one","");dh_sync(h[..],c[..],true);#assert h[0].nav[0].n==2 && h[0].op==0 && c[0].guest_due[DH_OWNER]>0;
 x:[64]u8;y:[64]u8;id:=dh_row_id(h[..],0,x[..]);other:=dh_row_id(h[..],1,y[..]);#assert id!=other;
 // Catalog reorder must preserve both identity and the group it belongs to.
 dl_list_read(c[..],"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tCoderOS\naaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tMac\n");
 dh_sync(h[..],c[..],true);#assert dh_row_id(h[..],0,y[..])==id && h[0].nav[0].rows[0].host==1;
 dh_sync(h[..],c[..],false);#assert h[0].op==0 && c[0].guest_due[DH_OWNER]==0;
 // A held read belongs to the drawer, not to the active conversation.
 dh_sync(h[..],c[..],true);op:=h[0].op;gen:=fx_generation(c[0].out[..],DH_OWNER);#assert fx_take(c[0].out[..],op);
 dh_sync(h[..],c[..],false);#assert app_dispatch(c[..],AppEvent.{kind=EV_DONE,op=op,generation=gen,outcome=FXO_DONE,status=200,text="{}"})==APP_R_LATE;
 #assert !app_device_on(c[..]) && h[0].nav[0].n==2;
}
dh_pages :: () {
 c:[1]AppCore;d:[1]DeviceLane;h:[1]DeviceHistory;app_init(c[..]);#assert app_device_attach(c[..],d[..]);c[0].foreground=true;
 a:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";dl_list_read(c[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tMac\n");dh_sync(h[..],c[..],true);dh_answer(h[..],c[..],a,"one","123");dh_sync(h[..],c[..],true);
 #assert dh_more(h[..],c[..],0);at:=fx_find(c[0].out[..],h[0].op);q:[1]EaRequest;
 #assert ea_read(fx_body(c[0].out[..],at),q[..]) && q[0].before==123;
 dh_answer(h[..],c[..],a,"two","");dh_sync(h[..],c[..],true);#assert h[0].nav[0].n==2;
 c[0].mono_ms=DH_INTERVAL;dh_sync(h[..],c[..],true);#assert h[0].op>0;
 // A refresh updates the loaded page without forgetting earlier rows.
 dh_answer(h[..],c[..],a,"two","");dh_sync(h[..],c[..],true);#assert h[0].nav[0].n==2;
}
dh_fences :: () {
 c:[1]AppCore;d:[1]DeviceLane;h:[1]DeviceHistory;app_init(c[..]);#assert app_device_attach(c[..],d[..]);c[0].foreground=true;
 host:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
 dl_list_read(c[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tFirst\naaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tDuplicate\n");
 #assert app_device_count(c[..])==1 && app_device_name(c[..],0)=="First";
 raw:[24576]u8;q:[1]EaRequest;q[0].nm=ea_copy(q[0].method[..],"SendMessage");n:=ea_write(q[..],raw[..]);
 #assert n>0 && app_guest_device(c[..],DH_OWNER,1,host,cast(string)raw[0..<n])==0;
 dh_sync(h[..],c[..],true);old:=h[0].op;#assert old>0;app_logged_out(c[..],"");dh_sync(h[..],c[..],true);
 #assert h[0].op>0 && h[0].op!=old; // a fenced account generation cannot wedge device history
}
native_check :: (i:int,run:bool)->int #export_c #effects(all) {
 if i==0 {if run {dh_checks();}else {print("paired history serializes reads without login, survives reorder and fences late replies");}}
 if i==1 {if run {dh_pages();}else {print("paired history preserves earlier pages across automatic refresh");}}
 if i==2 {if run {dh_fences();}else {print("paired history rejects writes, deduplicates hosts and recovers from account fencing");}}
 return 3;
}
