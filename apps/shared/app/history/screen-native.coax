// Actual shared page + core, with disposable public account histories.
#import "Basic";
#load "../../../openagents-ios/chat.coax";
hs_setup :: (s:[]ChatPage,c:[]AppCore,o:[]ChOut) {
 app_init(c);c[0].auth=AUTH_IN;c[0].foreground=true;ch_test_atlas(s[0].atlas[..]);chat_attach(s,c,"");chat_step(s);
 _:=ch_test_frame(s,o);#assert chat_activate(s,"nav.menu");_:=ch_test_frame(s,o);
}
hs_answer :: (s:[]ChatPage,c:[]AppCore,count:int) {
 summaries:[60][512]u8;items:[60]string;ids:[60][36]u8;raw:[65536]u8;
 for i:0..<count {
  for j:0..<36 {ids[i][j]=ifx j<4 then "cnv_"[j] else 'a';}
  ids[i][34]=cast(u8)('0'+i/10);ids[i][35]=cast(u8)('0'+i%10);
  conv:=[1]CtConversation.[CtConversation.{id=cast(string)ids[i][..],title="A long\nconversation title that should stay on one line",revision=1,created=1,updated=2}];
  n:=ctr_summary(conv[..],summaries[i][..]);#assert n>0;items[i]=cast(string)summaries[i][0..<n];
 }
 n:=ctr_index(items[0..<count],"",raw[..]);#assert n>0;
 op:=s[0].history[0].op;gen:=fx_generation(c[0].out[..],HI_OWNER);#assert op>0 && fx_take(c[0].out[..],op);
 #assert app_dispatch(c,AppEvent.{kind=EV_DONE,op=op,generation=gen,outcome=FXO_DONE,status=200,text=cast(string)raw[0..<n]})==APP_GUEST;
 chat_guest(s,cast(string)raw[0..<n]);
}
hs_open :: () {
 s:[1]ChatPage;c:[1]AppCore;o:[1]ChOut;hs_setup(s[..],c[..],o[..]);hs_answer(s[..],c[..],1);_:=ch_test_frame(s[..],o[..]);
 id:="cnv_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa00";#assert surface_find(ch_live(s[..]),id)>=0 && chat_refused(s[..])==0;
 #assert chat_activate(s[..],id) && !s[0].drawer && app_conversation(c[..])==id && c[0].flight>0;
}
hs_window :: () {
 s:[1]ChatPage;c:[1]AppCore;o:[1]ChOut;hs_setup(s[..],c[..],o[..]);hs_answer(s[..],c[..],60);_:=ch_test_frame(s[..],o[..]);
 #assert chat_rows(s[..])<35 && ch_scroll_max(s[..])>0 && chat_refused(s[..])==0;
 id:="cnv_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa00";row:=surface_find(ch_live(s[..]),id);r:=ch_rows(s[..]).rows[row];width:=r.w;
 s[0].share=0.25;s[0].reduced=false;_:=chat_frame(s[..],o[0].v[..],1206,2622,3,0);
 row=surface_find(ch_live(s[..]),id);#assert row>=0 && ch_rows(s[..]).rows[row].w==width;
 s[0].reduced=true;chat_scroll_to(s[..],ch_scroll_max(s[..]));_:=ch_test_frame(s[..],o[..]);
 #assert !chat_activate(s[..],id) && chat_refused(s[..])==0 && !chat_moving(s[..]);
 #assert chat_activate(s[..],"cnv_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa59");
}
hs_devices :: () {
 s:[1]ChatPage;c:[1]AppCore;d:[1]DeviceLane;o:[1]ChOut;hs_setup(s[..],c[..],o[..]);#assert app_device_attach(c[..],d[..]);
 dl_list_read(c[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tMac\n");chat_step(s[..]);
 h:=s[0].devices[..];b:=h[0].nav[0].browser[..];b[0].selected=0;b[0].view[0].ok=true;b[0].view[0].ns=1;
 item:=b[0].view[0].sessions[..];item[0].ni=ea_copy(item[0].id[..],"saved-session");item[0].nt=ea_copy(item[0].title[..],"A saved computer chat");nav_accept(h[0].nav[..],0);
 _:=ch_test_frame(s[..],o[..]);id:[64]u8;key:=dh_row_id(h,0,id[..]);
 #assert h[0].nav[0].n==1 && h[0].nav[0].browser[0].catalog[0].n==1;
 #assert key.count<EL_ID;
 #assert surface_find(ch_live(s[..]),key)>=0;
 #assert chat_refused(s[..])==0;
 #assert chat_activate(s[..],key) && !s[0].drawer && app_device_on(c[..]);
 e:=app_device_env(c[..]);#assert cast(string)e[0].session[0..<e[0].ns]=="saved-session";
 // A retained unknown write cannot be replaced by navigating to another chat.
 e[0].uncertain=true;eu_request(e,"SendMessage");s[0].drawer=true;_:=ch_test_frame(s[..],o[..]);
 #assert !chat_activate(s[..],key) && s[0].drawer && e[0].uncertain && cast(string)e[0].session[0..<e[0].ns]=="saved-session";
}
native_check :: (i:int,run:bool)->int #export_c #effects(all) {
 if i==0 {if run {hs_open();}else {print("GPU history opens the selected saved conversation through the real core");}}
 if i==1 {if run {hs_window();}else {print("60 chats realize only visible rows, keep width through animation and sleep still");}}
 if i==2 {if run {hs_devices();}else {print("GPU drawer opens a computer session and preserves unresolved commands");}}
 return 3;
}
