// The login card (GitHub #13645): the flow in flow.coax drawn on the G0 frame
// context (components/kit/frame.coax) with the form set
// (components/kit/form.coax). It reads the flow and changes nothing: a press
// on a row gives back the row's action, and the root hands it to lf_press.
//
//   h := lf_card(f, l, x, y, w, editing);            // in the root's frame, between uiframe_begin and uiframe_end
//   act := surface_action(surface, row);              // a tap, VoiceOver or the driver on a committed row
//   if act != 0 { _ := lf_press(l, act); }
//
// The rows and their stable IDs:
//
//   login         region "Log in"
//   login.title   heading: "Log in", or "Email code" in the code step
//   login.sent    the email the code went to (code step)
//   login.email   field "Email address" (email step)       LF_ACT_EMAIL
//   login.code    field "Email code" (code step)           LF_ACT_CODE
//   login.send    "Send code" (email step)                 LF_ACT_SEND
//   login.verify  "Log in" (code step)                     LF_ACT_VERIFY
//   login.resend  "Resend code" (code step)                LF_ACT_RESEND
//   login.change  "Change email" (code step)               LF_ACT_CHANGE
//   login.cancel  "Cancel" (both steps; works while busy)  LF_ACT_CANCEL
//   login.note    the flow's words, a live row (only when there are words)
//
// While a request is in flight the step's action shows the activity mark and
// every other part is disabled, except Cancel. The root puts lf_focus_id(l)
// into the frame's UiInput, so the focused field is lit, and passes editing
// when the platform editor is over it (then the field paints its frame only).
// Words are the shared rules' and the service's; the card adds its labels.
//   coax/bin/coax test apps/shared/app/login/card.coax

#load "flow.coax";
#load "../../../../components/kit/form.coax";

// The id of the field that holds the keyboard ("" for none), for the frame's UiInput.
lf_focus_id :: (l: [] LoginFlow) -> string {
  f := l[0].focus;
  return ifx f == LF_FIELD_EMAIL then "login.email" else ifx f == LF_FIELD_CODE then "login.code" else "";
}

// The card at (x, y), w wide, when the flow's card is open; 0 and nothing drawn when it is not.
// Returns its height.
lf_card :: (f: [] UiFrame, l: [] LoginFlow, x: f32, y: f32, w: f32, editing: bool) -> f32 {
  if !l[0].open { return 0; }
  s := f[0].skin; sh := f[0].sheet;
  step := lf_step(l); code := l[0].state == ALF_CODE; busy := lf_busy(l);
  pad := s.pad; ix := x + pad; iw := w - 2 * pad;
  region := uiframe_semantic(f, "login", EL_REGION, "Log in", x, y, w, pad, 0, 0);
  ground := sheet_box(sh, x, y, w, 0, s.space, 1, s.surface, s.field_edge);
  uiframe_open(f, region);
  h := pad;
  h += ctx_heading(f, "login.title", "login.sent", ix, y + h, iw, ifx code then "Email code" else "Log in", ifx code then al_trim(lf_email(l)) else "") + s.space;
  rest := ifx busy then EL_S_DISABLED else 0;
  if code { h += ctx_field(f, "login.code", ix, y + h, iw, "Email code", lf_code(l), "000000", editing && l[0].focus == LF_FIELD_CODE, rest, LF_ACT_CODE); }
  else { h += ctx_field(f, "login.email", ix, y + h, iw, "Email address", lf_email(l), "you@example.com", editing && l[0].focus == LF_FIELD_EMAIL, rest, LF_ACT_EMAIL); }
  h += s.space;
  // the step's action: busy while its request is in flight
  label := "Send code";
  if step == LF_REQUESTING { label = "Sending code…"; }
  else if step == LF_VERIFYING || step == LF_CHECKING { label = "Checking code…"; }
  else if code { label = "Log in"; }
  work := ifx busy then EL_S_BUSY else 0;
  if code { h += ctx_action(f, "login.verify", ix, y + h, iw, label, true, work, LF_ACT_VERIFY); }
  else { h += ctx_action(f, "login.send", ix, y + h, iw, label, true, work, LF_ACT_SEND); }
  // the quiet actions: Cancel always, and in the code step a new code or another email
  m := f[0].m;
  cw := form_link_width(m, s, "Cancel");
  if code {
    // after an unknown verify a new code is not offered: the press checks what the host holds first
    again := ifx l[0].unknown == LS_VERIFY then EL_S_DISABLED else rest;
    _ := ctx_link(f, "login.resend", ix - s.space, y + h, "Resend code", "Resend email code", again, LF_ACT_RESEND);
    lw := form_link_width(m, s, "Change email");
    _ := ctx_link(f, "login.change", ix + iw + s.space - lw, y + h, "Change email", "Change email", rest, LF_ACT_CHANGE);
    h += s.control_h;
  }
  _ := ctx_link(f, "login.cancel", ix + (iw - cw) / 2, y + h, "Cancel", "Cancel", 0, LF_ACT_CANCEL);
  h += s.control_h;
  words := lf_words(l);
  if words.count > 0 { h += s.space / 2 + ctx_notice(f, "login.note", ix, y + h + s.space / 2, iw, words, l[0].failure); }
  h += pad;
  uiframe_close(f);
  if ground >= 0 { sh[0].under[ground].h = h; }
  if region >= 0 { f[0].rows[0].rows[region].h = h; }
  return h;
}

// ---------------------------------------------------------------- checks

#load "../../../../components/skin/arcade.coax";

LfCardStore :: struct {
  under_a: [128] Prim; over_a: [128] Prim; hits_a: [16] SheetHit; pool_a: [512] u8; rows_a: [24] El;
  under_b: [128] Prim; over_b: [128] Prim; hits_b: [16] SheetHit; pool_b: [512] u8; rows_b: [24] El;
  keys: [8] Keyed; atlas: [1] Atlas;
  surface: [1] UiSurface; keyed: [1] KeyedStore;
}
lf_t_card_init :: (st: [] LfCardStore) {
  st[0].surface[0] = surface_over(
    Sheet.{under = st[0].under_a[..], over = st[0].over_a[..], hits = st[0].hits_a[..], pool = st[0].pool_a[..]}, st[0].rows_a[..],
    Sheet.{under = st[0].under_b[..], over = st[0].over_b[..], hits = st[0].hits_b[..], pool = st[0].pool_b[..]}, st[0].rows_b[..]);
  st[0].keyed[0] = KeyedStore.{rows = st[0].keys[..]};
  text_test_atlas(st[0].atlas[..]);
}
// One frame of the card on a 390-unit-wide screen; false when the surface refused it.
lf_t_card_frame :: (st: [] LfCardStore, l: [] LoginFlow) -> bool {
  f: [1] UiFrame;
  uiframe_begin(f[..], st[0].surface[..], st[0].keyed[..], measure_font(st[0].atlas[..]), arcade_phone_skin(), uiinput(0, 0, false, false, "", lf_focus_id(l)), 0, 0.016, false, false);
  _ := lf_card(f[..], l, 16, 80, 358, false);
  return uiframe_end(f[..], st[0].surface[..]);
}
lf_t_has :: (st: [] LfCardStore, id: string) -> bool { return surface_find(st[0].surface[..], id) >= 0; }
lf_t_state :: (st: [] LfCardStore, id: string, state: int) -> bool { t := [1] ElTable.[surface_rows(st[0].surface[..])]; return elt_has(t[..], surface_find(st[0].surface[..], id), state); }
lf_t_label :: (st: [] LfCardStore, id: string) -> string { t := [1] ElTable.[surface_rows(st[0].surface[..])]; return elt_label(t[..], surface_find(st[0].surface[..], id)); }
// A press on a committed row, as a tap, VoiceOver or the driver gives it.
lf_t_press :: (st: [] LfCardStore, l: [] LoginFlow, id: string) -> bool {
  at := surface_find(st[0].surface[..], id);
  if at < 0 { return false; }
  act := surface_action(st[0].surface[..], at);
  return act != 0 && lf_press(l, act);
}
lf_t_text :: (st: [] LfCardStore, text: string) -> int {
  sh := surface_sheet(st[0].surface[..]); n := 0;
  for i: 0..<sh.no { if sh.over[i].kind == PRIM_TEXT && sh.over[i].text == text { n += 1; } }
  return n;
}

#test "the card: each step's rows under their stable ids, pressed through the committed rows; it says Log in" #steps 400000000 {
  st: [1] LfCardStore; lf_t_card_init(st[..]);
  l: [1] LoginFlow; lf_t_out(l[..]);
  // closed: nothing drawn
  #assert lf_t_card_frame(st[..], l[..]) && !lf_t_has(st[..], "login");
  lf_open(l[..]);
  #assert lf_t_card_frame(st[..], l[..]);
  #assert lf_t_has(st[..], "login");
  #assert lf_t_label(st[..], "login") == "Log in";
  #assert lf_t_has(st[..], "login.email");
  #assert lf_t_has(st[..], "login.send");
  #assert lf_t_has(st[..], "login.cancel");
  #assert !lf_t_has(st[..], "login.code") && !lf_t_has(st[..], "login.verify") && !lf_t_has(st[..], "login.note") && lf_t_state(st[..], "login.email", EL_S_FOCUSED);
  #assert lf_t_text(st[..], "Send code") == 1 && lf_t_text(st[..], "Sign in") == 0 && lf_t_text(st[..], "you@example.com") == 1;
  // Send code with nothing typed: the shared rule's words as a live row
  #assert lf_t_press(st[..], l[..], "login.send") && lf_t_card_frame(st[..], l[..]) && lf_t_state(st[..], "login.note", EL_S_LIVE) && lf_t_label(st[..], "login.note") == "Type your email.";
  #assert lf_set(l[..], LF_FIELD_EMAIL, "ada@example.com") && lf_t_card_frame(st[..], l[..]) && !lf_t_has(st[..], "login.note");
  #assert lf_t_press(st[..], l[..], "login.send") && lf_t_card_frame(st[..], l[..]);
  // in flight: the action is busy, the field rests, Cancel still works
  #assert lf_t_text(st[..], "Sending code…") == 1 && lf_t_state(st[..], "login.send", EL_S_BUSY | EL_S_DISABLED) && lf_t_state(st[..], "login.email", EL_S_DISABLED) && !lf_t_state(st[..], "login.cancel", EL_S_DISABLED);
  #assert !lf_t_press(st[..], l[..], "login.send");
  #assert lf_t_answer(l[..], lf_t_take(l[..], LS_START), LS_DONE, 200, false, "", "") && lf_t_card_frame(st[..], l[..]);
  // the code step
  #assert lf_t_has(st[..], "login.code") && lf_t_has(st[..], "login.verify") && lf_t_has(st[..], "login.resend") && lf_t_has(st[..], "login.change") && lf_t_has(st[..], "login.cancel");
  #assert !lf_t_has(st[..], "login.email") && !lf_t_has(st[..], "login.send") && lf_t_label(st[..], "login.sent") == "ada@example.com" && lf_t_text(st[..], "Email code") >= 1;
  #assert lf_t_label(st[..], "login.note") == ALF_SENT && lf_t_state(st[..], "login.code", EL_S_FOCUSED);
  #assert lf_set(l[..], LF_FIELD_CODE, "123456") && lf_t_press(st[..], l[..], "login.verify") && lf_t_card_frame(st[..], l[..]);
  #assert lf_t_text(st[..], "Checking code…") == 1 && lf_t_state(st[..], "login.verify", EL_S_BUSY) && lf_t_state(st[..], "login.resend", EL_S_DISABLED);
  #assert lf_t_answer(l[..], lf_t_take(l[..], LS_VERIFY), LS_DONE, 200, true, "", "a...@example.com");
  // logged in: the card is gone
  #assert lf_t_card_frame(st[..], l[..]) && !lf_t_has(st[..], "login") && lf_logged_in(l[..]);
}

#test "the card's Cancel closes it while a request is in flight, and the typed email stays" #steps 400000000 {
  st: [1] LfCardStore; lf_t_card_init(st[..]);
  l: [1] LoginFlow; lf_t_out(l[..]); lf_open(l[..]);
  #assert lf_set(l[..], LF_FIELD_EMAIL, "ada@example.com") && lf_t_card_frame(st[..], l[..]) && lf_t_press(st[..], l[..], "login.send") && lf_t_card_frame(st[..], l[..]);
  #assert lf_t_press(st[..], l[..], "login.cancel") && !l[0].open && lf_email(l[..]) == "ada@example.com";
  #assert lf_t_card_frame(st[..], l[..]) && !lf_t_has(st[..], "login");
  // an unknown verify: a new code is not offered until the host is asked
  lf_open(l[..]);
  #assert lf_press(l[..], LF_ACT_SEND) && lf_t_answer(l[..], lf_t_take(l[..], LS_START), LS_DONE, 200, false, "", "");
  #assert lf_set(l[..], LF_FIELD_CODE, "123456") && lf_press(l[..], LF_ACT_VERIFY) && lf_t_answer(l[..], lf_t_take(l[..], LS_VERIFY), LS_UNKNOWN, 0, false, "", "");
  #assert lf_t_card_frame(st[..], l[..]) && lf_t_state(st[..], "login.resend", EL_S_DISABLED) && !lf_t_state(st[..], "login.verify", EL_S_DISABLED) && lf_t_label(st[..], "login.note") == LF_UNKNOWN_VERIFY;
}

#test "the flow's own words fit a semantic row's label whole" {
  words := [6] string.[LF_RESENT, LF_UNKNOWN_START, LF_UNKNOWN_VERIFY, LF_NOT_YET, LF_UNREAD, ALF_SENT];
  for w: words { #assert w.count <= EL_LABEL; }
}
