// Native checks: the real AppCore exceeds the evaluator storage limit.
#import "Basic";
#load "identity.coax";
iks_check_0 :: () {
 c:[1]AppCore;app_init(c[..]);s:[1]IdentitySettings;c[0].auth=AUTH_IN;
 iks_sync(s[..],c[..]);op:=s[0].op;#assert op>0 && fx_next(c[0].out[..])==op;
 iks_sync(s[..],c[..]);#assert s[0].op==op && fx_held(c[0].out[..])==1;
 _:=fx_take(c[0].out[..],op);b:[512]u8;n:=aiw_write("fixture",AIW_G,2,b[..]);
 gen:=fx_generation(c[0].out[..],IKS_OWNER);#assert app_dispatch(c[..],AppEvent.{kind=EV_DONE,op=op,generation=gen,outcome=FXO_DONE,status=200,text=cast(string)b[0..<n]})==APP_GUEST;
 #assert iks_guest(s[..],c[..],cast(string)b[0..<n]) && s[0].loaded && s[0].source==2 && iks_pubkey(s[..])==AIW_G;
 #assert iks_request(s[..],c[..],IKS_ROTATE) && s[0].confirm==IKS_ROTATE && s[0].op==0;
 #assert iks_request(s[..],c[..],IKS_CANCEL) && s[0].confirm==0 && s[0].op==0;
 c[0].auth=AUTH_OUT;iks_sync(s[..],c[..]);#assert !s[0].loaded && s[0].source==0 && iks_pubkey(s[..])=="" && !s[0].backup;
}
iks_check_1 :: () {
 c:[1]AppCore;app_init(c[..]);c[0].auth=AUTH_IN;s:[1]IdentitySettings;s[0].signed_in=true;s[0].loaded=true;s[0].source=2;
 for i:0..<64 {s[0].pubkey[i]=AIW_G[i];}
 #assert iks_request(s[..],c[..],IKS_RESTORE) && s[0].confirm==IKS_RESTORE;
 #assert !iks_request(s[..],c[..],IKS_CONFIRM) && s[0].op==0;
 s[0].secret_ready=true;#assert iks_request(s[..],c[..],IKS_CONFIRM) && s[0].op>0;
 at:=fx_find(c[0].out[..],s[0].op);#assert at>=0 && c[0].out[0].slots[at].kind==FX_IDENTITY && fx_body(c[0].out[..],at)==AIW_G;
 #assert !iks_request(s[..],c[..],IKS_ROTATE);
}


native_check :: (i:int,run:bool)->int #export_c #effects(all) {
 if i==0 {if run {iks_check_0();}else {print("identity provisioning and account fencing");}}
 if i==1 {if run {iks_check_1();}else {print("confirmed private custody uses public-only requests");}}
 return 2;
}
