// Native debug/release and ASan/UBSan qualification of the actual app core.
// coax/web/tool.sh apps/shared/app/settings/identity-qualify.coax
#import "Basic";
#load "../../../../coax/lib/sys/native-check.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])<1 || args_count(a[..])>2 {tool_errln("choose debug or release, optionally screen");return 2;}
 mode:=args_at(a[..],0);if mode!="debug" && mode!="release" {return 2;}
 source:=ifx args_count(a[..])==2 && args_at(a[..],1)=="screen" then "apps/shared/app/settings/identity-screen-native.coax" else "apps/shared/app/settings/identity-native.coax";
 return nc_suite_mode(source,ifx mode=="debug" then 0 else 1);
}
