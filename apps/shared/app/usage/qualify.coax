// Actual compiled GPU page through the shared normal/sanitized qualifier.
#import "Basic";
#load "../../../../coax/lib/sys/native-check.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {return 2;}
 mode:=args_at(a[..],0);if mode!="debug" && mode!="release" {return 2;}
 return nc_suite_mode("apps/shared/app/usage/screen-native.coax",ifx mode=="debug" then 0 else 1);
}
