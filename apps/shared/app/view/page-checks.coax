// Checks for page.coax. Example data only: a synthetic conversation, turn
// and task written into a zeroed core field by field. No account data, no
// host, no service.

#load "../../../../components/app/checks-kit.coax";
#load "../../../../components/skin/conversation.coax";

#test "an observed native session has a fixed read-only footer instead of a writable composer" #steps 4000000000 {
 c:[1]AppCore;p:[1]ViewPageTest;lane:[1]DeviceLane;app_test_init(p[0].t[..]);app_init(c[..]);#assert app_device_attach(c[..],lane[..]);lane[0].on=true;
 e:=lane[0].e[..];e[0].active=true;e[0].ns=6;_=el_copy(e[0].session[..],"native");e[0].view[0].ok=true;e[0].view[0].ns=1;e[0].view[0].sessions[0].ni=el_copy(e[0].view[0].sessions[0].id[..],"native");
 view_pt_conversation(p[..],c[..]);#assert app_test_find(p[0].t[..],"chat.readonly")>=0 && app_test_find(p[0].t[..],VIEW_COMPOSER_ID)<0;
 e[0].view[0].sessions[0].managed=true;view_pt_conversation(p[..],c[..]);#assert app_test_find(p[0].t[..],"chat.readonly")<0 && app_test_find(p[0].t[..],VIEW_COMPOSER_ID)>=0;
}

view_pt_conversation :: (p:[]ViewPageTest,c:[]AppCore) {
 app_test_begin(p[0].t[..],"","",true);p[0].t[0].f[0].skin=conversation_skin();
 _:=view_page(p[0].t[0].f[..],p[0].v[..],c,view_pt_lay(600));#assert app_test_end(p[0].t[..]);
}

#test "conversation reply Copy dispatches the whole original Markdown without a second parser" #steps 4000000000 {
 c:[1]AppCore;p:[1]ViewPageTest;app_test_init(p[0].t[..]);view_pt_core(c[..],VIEW_PT_PAGE);view_pt_running(c[..],"A **complete** reply.\n\n- one\n- two");
 view_pt_conversation(p[..],c[..]);#assert app_test_pressable(p[0].t[..],"chat.reply.copy");
 q:=view_pt_press(p[..],c[..],"chat.reply.copy");#assert q.kind==VIEW_P_DISPATCH && q.what==VIEW_C_COPY && q.text=="A **complete** reply.\n\n- one\n- two";
 view_pt_conversation(p[..],c[..]);#assert app_test_label(p[0].t[..],"chat.reply.copy")=="Copied";
}

#test "conversation activity expands real calls and preserves child expansion across measurement" #steps 4000000000 {
 c:[1]AppCore;p:[1]ViewPageTest;app_test_init(p[0].t[..]);view_pt_core(c[..],VIEW_PT_PAGE);view_pt_running(c[..],"");view_pt_asking(p[..],c[..]);
 n:=c[0].chat[0].native[..];n[0].status[0].state=XT_COMPLETED;n[0].shown[0].parts[0].resolved=true;
 n[0].shown[0].parts[1]=SPart.{kind=P_TOOL,tk=TK_READ,arg="notes.md",input="notes.md",output="Public fixture output",resolved=true};n[0].shown[0].n=2;
 view_pt_conversation(p[..],c[..]);vm:=p[0].v[0].model[..];i:=0;while i<vm[0].n && vm[0].rows[i].kind!=VK_TOOL {i+=1;}
 #assert i<vm[0].n && vm[0].rows[i].group_count==2;id:[EL_ID]u8;_=el_copy(id[..],view_row_id(vm,i));root:=cast(string)id[0..<vm[0].rows[i].id_n];
 #assert view_pt_press(p[..],c[..],root).kind==VIEW_P_LOCAL;view_pt_conversation(p[..],c[..]);
 childbuf:[EL_ID]u8;child:=view_group_key(childbuf[..],root,1);#assert app_test_pressable(p[0].t[..],child);
 #assert view_pt_press(p[..],c[..],child).kind==VIEW_P_LOCAL;view_pt_conversation(p[..],c[..]);
 #assert app_test_has(p[0].t[..],child,EL_S_EXPANDED);view_pt_conversation(p[..],c[..]);#assert app_test_has(p[0].t[..],child,EL_S_EXPANDED);
}

#test "conversation activity is Coder Desktop's group: thoughts and calls under one summary, open while it works, folded once done" #steps 4000000000 {
 c:[1]AppCore;p:[1]ViewPageTest;app_test_init(p[0].t[..]);view_pt_core(c[..],VIEW_PT_PAGE);view_pt_running(c[..],"");view_pt_asking(p[..],c[..]);
 n:=c[0].chat[0].native[..];n[0].status[0].state=XT_RUNNING;ses:=n[0].shown[..];ses[0].asking= -1;ses[0].n=0;
 s_delta(ses,P_THINK,"Look at the notes first.");
 ses[0].parts[1]=SPart.{kind=P_TOOL,id="call_1",tk=TK_EXEC,arg="ls notes",output="notes.txt",resolved=true};
 ses[0].parts[2]=SPart.{kind=P_TOOL,id="call_2",tk=TK_READ,arg="notes.txt",input="{\"file_path\":\"notes.txt\"}"};ses[0].n=3;
 view_pt_conversation(p[..],c[..]);vm:=p[0].v[0].model[..];i:=0;while i<vm[0].n && vm[0].rows[i].kind!=VK_TOOL {i+=1;}
 // one group for the thought and both calls, under the first part's id
 #assert i<vm[0].n && vm[0].rows[i].group_count==3 && view_row_id(vm,i)=="tool.0123456789abcdef.0";
 t:=p[0].t[..];root:="tool.0123456789abcdef.0";
 #assert app_test_label(t,root)=="Thought process · ran 1 command · read 1 file" && app_test_has(t,root,EL_S_EXPANDED) && app_test_has(t,root,EL_S_BUSY);
 // the rows show while it works: the thought's words, the command, the read still in flight
 #assert app_test_label(t,"tool.0123456789abcdef.0.call.1")=="Ran ls notes" && app_test_label(t,"tool.0123456789abcdef.0.call.2")=="Read notes.txt";
 #assert app_test_has(t,"tool.0123456789abcdef.0.call.2",EL_S_BUSY) && app_test_find(t,"tool.0123456789abcdef.0.call.0.words")>=0;
 // a row opens onto its call and output
 #assert view_pt_press(p[..],c[..],"tool.0123456789abcdef.0.call.1").kind==VIEW_P_LOCAL;view_pt_conversation(p[..],c[..]);
 #assert app_test_has(t,"tool.0123456789abcdef.0.call.1",EL_S_EXPANDED) && app_test_find(t,"tool.0123456789abcdef.0.call.1.output")>=0;
 // done: it folds to its summary, and a press on the summary opens it again
 n[0].status[0].state=XT_COMPLETED;ses[0].parts[2].resolved=true;view_pt_conversation(p[..],c[..]);
 #assert !app_test_has(t,root,EL_S_EXPANDED) && !app_test_has(t,root,EL_S_BUSY) && app_test_find(t,"tool.0123456789abcdef.0.call.1")<0;
 #assert view_pt_press(p[..],c[..],root).kind==VIEW_P_LOCAL;view_pt_conversation(p[..],c[..]);
 #assert app_test_has(t,root,EL_S_EXPANDED) && app_test_find(t,"tool.0123456789abcdef.0.call.1")>=0;
 #assert view_pt_press(p[..],c[..],root).kind==VIEW_P_LOCAL;view_pt_conversation(p[..],c[..]);#assert !app_test_has(t,root,EL_S_EXPANDED);
}

#test "a computer's tool calls group by their tools' own names, and the turn shows the working line with its seconds" #steps 4000000000 {
 c:[1]AppCore;p:[1]ViewPageTest;lane:[1]DeviceLane;app_test_init(p[0].t[..]);app_init(c[..]);#assert app_device_attach(c[..],lane[..]);lane[0].on=true;
 e:=lane[0].e[..];e[0].active=true;e[0].ns=el_copy(e[0].session[..],"coder");v:=e[0].view[..];v[0].ok=true;v[0].ns=1;
 v[0].sessions[0].ni=el_copy(v[0].sessions[0].id[..],"coder");v[0].sessions[0].managed=true;v[0].sessions[0].busy=true;
 names:=[3]string.["Bash","Task","Bash"];texts:=[3]string.["ls -la\ntotal 0","Survey the tests","git status"];roles:=[3]string.["tool","tool","tool"];
 for q:0..<3 {m:=v[0].items[q];m.ni=el_copy(m.id[..],ifx q==0 then "p0" else ifx q==1 then "p1" else "p2");m.nr=el_copy(m.role[..],roles[q]);m.nk=el_copy(m.tool[..],names[q]);
  m.text_at=ea_text_put(v,texts[q]);m.nt=texts[q].count;m.complete=q<2;v[0].items[q]=m;}
 v[0].ni=3;
 view_pt_conversation(p[..],c[..]);t:=p[0].t[..];
 #assert app_test_label(t,"dev.p0")=="Ran 2 commands · ran a subagent" && app_test_has(t,"dev.p0",EL_S_BUSY) && app_test_has(t,"dev.p0",EL_S_EXPANDED);
 #assert app_test_label(t,"dev.p0.call.0")=="Ran ls -la" && app_test_label(t,"dev.p0.call.1")=="Ran a subagent Survey the tests" && app_test_has(t,"dev.p0.call.2",EL_S_BUSY);
 // a call the computer stamped says how long it has run
 #assert app_test_value(t,"dev.p0.call.2")=="";
 v[0].items[2].started=1700000000000;c[0].wall_ms=1700000065500;view_pt_conversation(p[..],c[..]);#assert app_test_value(t,"dev.p0.call.2")=="1m 5s" && app_test_has(t,"dev.p0.call.2",EL_S_BUSY);
 // the sub-agent says how many calls its agent has made
 v[0].items[1].calls=3;v[0].items[1].nn=el_copy(v[0].items[1].now[..],"Read /w/a.toml");view_pt_conversation(p[..],c[..]);#assert app_test_value(t,"dev.p0.call.1")=="3 tool calls";
 // its row opens its own transcript (the page opens it; the item that started it rides along); a command's row opens in place
 q:=view_pt_press(p[..],c[..],"dev.p0.call.1");#assert q.kind==VIEW_P_DISPATCH && q.what==VIEW_C_SUBAGENT && q.text=="p1" && view_code(q.what)==0;
 #assert view_pt_press(p[..],c[..],"dev.p0.call.0").kind==VIEW_P_LOCAL;
 // the last word was the computer's call: no working line yet; once a message of the person's is last, the line shows
 #assert app_test_find(t,"chat.typing")<0;
 m:=v[0].items[3];m.ni=el_copy(m.id[..],"p3");m.nr=el_copy(m.role[..],"user");m.text_at=ea_text_put(v,"And the tests?");m.nt=14;m.complete=true;v[0].items[3]=m;v[0].ni=4;
 view_pt_conversation(p[..],c[..]);
 #assert p[0].v[0].working_from>=0 && app_test_find(t,"chat.typing")>=0 && app_test_label(t,"chat.typing")=="Working" && app_test_has(t,"chat.typing",EL_S_BUSY);
}

#test "a computer's thinking folds into its turn's group as a thought, never a reply" #steps 4000000000 {
 c:[1]AppCore;p:[1]ViewPageTest;lane:[1]DeviceLane;app_test_init(p[0].t[..]);app_init(c[..]);#assert app_device_attach(c[..],lane[..]);lane[0].on=true;
 e:=lane[0].e[..];e[0].active=true;e[0].ns=el_copy(e[0].session[..],"coder");v:=e[0].view[..];v[0].ok=true;v[0].ns=1;
 v[0].sessions[0].ni=el_copy(v[0].sessions[0].id[..],"coder");v[0].sessions[0].managed=true;v[0].sessions[0].busy=true;
 roles:=[3]string.["thought","tool","thought"];names:=[3]string.["","Bash",""];texts:=[3]string.["Look first","ls","Then **edit**"];
 for q:0..<3 {m:=v[0].items[q];m.ni=el_copy(m.id[..],ifx q==0 then "t0" else ifx q==1 then "t1" else "t2");m.nr=el_copy(m.role[..],roles[q]);m.nk=el_copy(m.tool[..],names[q]);
  m.text_at=ea_text_put(v,texts[q]);m.nt=texts[q].count;m.complete=q<2;v[0].items[q]=m;}
 v[0].ni=3;
 view_pt_conversation(p[..],c[..]);t:=p[0].t[..];
 #assert app_test_label(t,"dev.t0")=="Thought 2 times · ran 1 command" && app_test_has(t,"dev.t0",EL_S_BUSY) && app_test_has(t,"dev.t0",EL_S_EXPANDED);
 #assert app_test_label(t,"dev.t0.call.1")=="Ran ls";
 #assert app_test_find(t,"dev.t2")<0;
}

VIEW_PT_CNV :: "cnv_0123456789abcdef0123456789abcdef";
VIEW_PT_TURN :: "trn_0123456789abcdef0123456789abcdef";

ViewPageTest :: struct { t: [1] AppTest; v: [1] ChatView; pool: [4096] u8; }

view_pt_lay :: (h: f32) -> ViewLayout { return ViewLayout.{x = 0, top = 0, w = 300, bottom = h, chips_h = 0}; }
// One frame of the page at 300 by h layout units, measured in cells. Returns whether the frame was committed.
view_pt_frame :: (p: [] ViewPageTest, c: [] AppCore, h: f32, pressed: string) -> ViewOut {
  app_test_begin(p[0].t[..], pressed, "", true);
  out := view_page(p[0].t[0].f[..], p[0].v[..], c, view_pt_lay(h));
  #assert app_test_end(p[0].t[..]);
  return out;
}
view_pt_press :: (p: [] ViewPageTest, c: [] AppCore, id: string) -> ViewPress {
  r := app_test_row(p[0].t[..], id);
  #assert r.id_n > 0;
  return view_press(p[0].v[..], c, p[0].t[0].ks[..], id, r.action);
}
// A logged-in core with an open, read conversation whose page is `raw`.
view_pt_core :: (c: [] AppCore, raw: string) {
  app_init(c); c[0].auth = AUTH_IN;
  d := c[0].chat[..];
  d[0].id_n = el_copy(d[0].id[..], VIEW_PT_CNV);
  if raw.count > 0 { #assert ctr_history_read(raw, d[0].history[..]); }
  d[0].loaded = true;
}
view_pt_running :: (c: [] AppCore, reply: string) {
  d := c[0].chat[..];
  #assert ct_view_begin(d[0].view[..], VIEW_PT_CNV, VIEW_PT_TURN);
  d[0].view[0].state = CT_RUNNING; d[0].view[0].bytes = el_copy(d[0].view[0].content[..], reply); d[0].has_view = true;
}
// The turn's task waits on a command, read in full: Allow and Deny both work.
view_pt_asking :: (p: [] ViewPageTest, c: [] AppCore) {
  n := c[0].chat[0].native[..];
  n[0].selected = true; n[0].bound = true; n[0].has_status = true; n[0].available = true;
  _ := el_copy(n[0].turn[..], VIEW_PT_TURN); _ := el_copy(n[0].conversation[..], VIEW_PT_CNV);
  n[0].host_label_n = el_copy(n[0].host_label[..], "Studio Mac");
  n[0].status[0].state = XT_WAITING;
  n[0].canonical_n = el_copy(n[0].canonical[..], "status"); n[0].captured_n = el_copy(n[0].captured[..], "status");
  s := n[0].shown[..]; s_init(s, p[0].pool[..]);
  s[0].parts[0] = SPart.{kind = P_TOOL, id = "call_1", tk = TK_EXEC, arg = "rm notes.txt", input = "{\"command\":\"rm notes.txt\"}"};
  s[0].n = 1; s[0].asking = 0;
  n[0].has_session = true;
}
VIEW_PT_PAGE :: "{\"schema\":\"openagents.chat.conversation.v2alpha1\",\"id\":\"cnv_0123456789abcdef0123456789abcdef\",\"revision\":2,\"project_id\":null,\"legacy_thread_id\":null,\"legacy_thread_revision\":null,\"messages\":[{\"id\":\"trn_0123456789abcdef0123456789abcdef.user\",\"turn_id\":\"trn_0123456789abcdef0123456789abcdef\",\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Tidy the notes\"}],\"created_at_ms\":10}],\"active_turn_id\":\"trn_0123456789abcdef0123456789abcdef\",\"created_at_ms\":1,\"updated_at_ms\":10,\"next_cursor\":null}";

#test "a new chat shows the empty state over the composer, and Send rests until there is text" #steps 4000000000 {
  a: [1] AppCore; c := a[..]; p: [1] ViewPageTest; app_test_init(p[0].t[..]);
  app_init(c); c[0].auth = AUTH_IN;
  out := view_pt_frame(p[..], c, 600, "");
  t := p[0].t[..];
  #assert app_test_find(t, "chat.empty") >= 0 && app_test_label(t, "chat.empty") == VIEW_EMPTY_TITLE;
  #assert app_test_find(t, VIEW_COMPOSER_ID) >= 0 && app_test_row(t, VIEW_COMPOSER_ID).action == VIEW_A_FIELD && out.composer_y < 600 && out.chips_y == out.composer_y;
  // a press on the field asks the host for the keyboard
  #assert view_pt_press(p[..], c, VIEW_COMPOSER_ID).kind == VIEW_P_FOCUS;
  // with text, Send sends
  #assert app_draft_keep(c, "", "Hello");
  out = view_pt_frame(p[..], c, 600, "");
  q := view_pt_press(p[..], c, VIEW_SEND_ID);
  #assert q.kind == VIEW_P_DISPATCH && q.what == VIEW_C_SEND && view_app_event(q.what, q.text, 5, 6).code == ACT_SEND;
}
#test "a saved message and a streaming reply paint in order; Send turns to Stop while it runs" #steps 4000000000 {
  a: [1] AppCore; c := a[..]; p: [1] ViewPageTest; app_test_init(p[0].t[..]);
  view_pt_core(c, VIEW_PT_PAGE); view_pt_running(c, "Reading **notes**");
  out := view_pt_frame(p[..], c, 600, "");
  t := p[0].t[..];
  u := app_test_row(t, "m.0123456789abcdef.u"); r := app_test_row(t, "chat.reply");
  #assert u.id_n > 0 && r.id_n > 0 && u.y < r.y && app_test_find(t, "chat.empty") < 0;
  #assert app_test_texts(t, "Tidy the notes") == 1;
  q := view_pt_press(p[..], c, VIEW_SEND_ID);
  #assert q.kind == VIEW_P_DISPATCH && q.what == VIEW_C_STOP && view_code(q.what) == ACT_STOP;
}
#test "the task's prompt sits after its call; Allow and Deny reach the core, and an unknown answer is retried as it was" #steps 4000000000 {
  a: [1] AppCore; c := a[..]; p: [1] ViewPageTest; app_test_init(p[0].t[..]);
  view_pt_core(c, VIEW_PT_PAGE); view_pt_running(c, ""); view_pt_asking(p[..], c);
  #assert app_permission_state(c) == PERMIT_READY;
  out := view_pt_frame(p[..], c, 600, "");
  t := p[0].t[..];
  head := app_test_row(t, "task.0123456789abcdef.head"); tool := app_test_row(t, "tool.0123456789abcdef.0");
  prompt := app_test_row(t, "task.0123456789abcdef.permission"); state := app_test_row(t, "task.0123456789abcdef.state");
  #assert head.id_n > 0 && tool.id_n > 0 && prompt.id_n > 0 && state.id_n > 0 && head.y < tool.y && tool.y < prompt.y && prompt.y < state.y;
  #assert app_test_label(t, "task.0123456789abcdef.head") == "Studio Mac" && app_test_label(t, "task.0123456789abcdef.permission") == "Run this command?";
  #assert app_test_pressable(t, "task.0123456789abcdef.permission.allow") && app_test_pressable(t, "task.0123456789abcdef.permission.deny");
  allow := view_pt_press(p[..], c, "task.0123456789abcdef.permission.allow"); deny := view_pt_press(p[..], c, "task.0123456789abcdef.permission.deny");
  #assert allow.what == VIEW_C_ALLOW && view_code(allow.what) == ACT_ALLOW && deny.what == VIEW_C_DENY && view_code(deny.what) == ACT_DENY;
  // no typing mark: the task's state line speaks for the turn
  #assert app_test_find(t, "chat.typing") < 0;
  // an answer sent and not confirmed: the prompt offers Try again, which sends the same request
  n := c[0].chat[0].native[..];
  n[0].verb = "approve"; n[0].body_n = 4; n[0].uncertain = true;
  #assert app_permission_state(c) == PERMIT_UNCERTAIN;
  out = view_pt_frame(p[..], c, 600, "");
  #assert app_test_pressable(t, "task.0123456789abcdef.permission.retry");
  retry := view_pt_press(p[..], c, "task.0123456789abcdef.permission.retry");
  #assert retry.what == VIEW_C_RETRY && view_code(retry.what) == ACT_RETRY;
}
#test "a tool row opens on a press and stays where it is while it grows" #steps 4000000000 {
  a: [1] AppCore; c := a[..]; p: [1] ViewPageTest; app_test_init(p[0].t[..]);
  view_pt_core(c, VIEW_PT_PAGE); view_pt_running(c, ""); view_pt_asking(p[..], c);
  n := c[0].chat[0].native[..]; n[0].status[0].state = XT_RUNNING;
  ses := n[0].shown[..]; ses[0].asking = -1; ses[0].parts[0].output = "removed notes.txt"; ses[0].parts[0].resolved = true;
  _ := view_pt_frame(p[..], c, 600, "");
  t := p[0].t[..]; id := "tool.0123456789abcdef.0";
  before := app_test_row(t, id);
  #assert app_test_pressable(t, id) && !app_test_has(t, id, EL_S_EXPANDED);
  #assert view_pt_press(p[..], c, id).kind == VIEW_P_LOCAL;
  out := view_pt_frame(p[..], c, 600, "");
  #assert app_test_has(t, id, EL_S_EXPANDED);
  out = view_pt_frame(p[..], c, 600, "");
  after := app_test_row(t, id);
  #assert after.y == before.y && app_test_find(t, "task.0123456789abcdef.state") >= 0 && app_test_row(t, "task.0123456789abcdef.state").y > after.y + after.h;
}
#test "an unconfirmed send offers Try again, a note offers Reconnect, and an open chat not read yet shows the reconnecting banner" #steps 4000000000 {
  a: [1] AppCore; c := a[..]; p: [1] ViewPageTest; app_test_init(p[0].t[..]);
  app_init(c); c[0].auth = AUTH_IN;
  d := c[0].chat[..];
  d[0].id_n = el_copy(d[0].id[..], VIEW_PT_CNV);
  _ := view_pt_frame(p[..], c, 600, "");
  t := p[0].t[..];
  #assert app_test_find(t, "chat.banner") >= 0 && app_test_has(t, "chat.banner", EL_S_LIVE) && app_test_find(t, "chat.empty") < 0;
  d[0].loaded = true; d[0].pending = 1; d[0].uncertain = true; d[0].submitted_n = el_copy(d[0].submitted[..], "Hello");
  app_say(c, "We could not reach OpenAgents.");
  _ = view_pt_frame(p[..], c, 600, "");
  #assert app_test_find(t, "chat.banner") < 0 && app_test_find(t, "chat.sent") >= 0;
  retry := view_pt_press(p[..], c, "chat.unsure.retry"); again := view_pt_press(p[..], c, "chat.note.retry");
  #assert retry.what == VIEW_C_RETRY && again.what == VIEW_C_RECONNECT && app_test_label(t, "chat.note") == "We could not reach OpenAgents.";
}
#test "only the rows near the viewport are painted; scrolling up shows Jump to latest, which follows the end again" #steps 8000000000 {
  a: [1] AppCore; c := a[..]; p: [1] ViewPageTest; app_test_init(p[0].t[..]);
  // 24 saved messages of one line each
  raw: [16384] u8; o: [1] Jo; jo_start(o[..], raw[..]);
  jo_put(o[..], "{\"schema\":\"openagents.chat.conversation.v2alpha1\",\"id\":\"cnv_0123456789abcdef0123456789abcdef\",\"revision\":2,\"project_id\":null,\"legacy_thread_id\":null,\"legacy_thread_revision\":null,\"messages\":[");
  for k: 0..<24 {
    if k > 0 { jo_put(o[..], ","); }
    jo_put(o[..], "{\"id\":\"cnv_0123456789abcdef0123456789abcdef.legacy."); jo_int(o[..], k);
    jo_put(o[..], "\",\"turn_id\":\"\",\"role\":\""); jo_put(o[..], ifx k % 2 == 0 then "user" else "assistant");
    jo_put(o[..], "\",\"content\":[{\"type\":\"text\",\"text\":\"Line "); jo_int(o[..], k); jo_put(o[..], "\"}],\"created_at_ms\":10}");
  }
  jo_put(o[..], "],\"active_turn_id\":null,\"created_at_ms\":1,\"updated_at_ms\":10,\"next_cursor\":null}");
  view_pt_core(c, jo_text(o[..]));
  #assert c[0].chat[0].history[0].n == 24;
  _ := view_pt_frame(p[..], c, 600, "");
  t := p[0].t[..];
  #assert app_test_find(t, "m.legacy.23") >= 0 && app_test_find(t, "m.legacy.0") < 0 && app_test_find(t, "chat.jump") < 0;
  view_scroll(p[0].v[..], -4000);
  _ = view_pt_frame(p[..], c, 600, "");
  #assert app_test_find(t, "m.legacy.23") < 0 && app_test_pressable(t, "chat.jump");
  #assert view_pt_press(p[..], c, "chat.jump").kind == VIEW_P_LOCAL;
  _ = view_pt_frame(p[..], c, 600, "");
  #assert app_test_find(t, "m.legacy.23") >= 0 && app_test_find(t, "chat.jump") < 0;
}
#test "Copy on a code block in an answer copies that block's text" #steps 4000000000 {
  a: [1] AppCore; c := a[..]; p: [1] ViewPageTest; app_test_init(p[0].t[..]);
  view_pt_core(c, VIEW_PT_PAGE); view_pt_running(c, "Run this:\n\n```sh\ncoax test\n```\n");
  _ := view_pt_frame(p[..], c, 600, "");
  t := p[0].t[..];
  #assert app_test_pressable(t, "chat.reply.code.1.copy");
  q := view_pt_press(p[..], c, "chat.reply.code.1.copy");
  #assert q.kind == VIEW_P_DISPATCH && q.what == VIEW_C_COPY && q.text == "coax test" && view_code(q.what) == ACT_COPY;
}

#test "local archive presentation offers Restore but never hides an active Stop control" #steps 4000000000 {
 c:[1]AppCore;p:[1]ViewPageTest;app_test_init(p[0].t[..]);view_pt_core(c[..],VIEW_PT_PAGE);
 lay:=view_pt_lay(600);lay.archived=true;lay.restore_action=468;
 app_test_begin(p[0].t[..],"","",true);p[0].t[0].f[0].skin=conversation_skin();_=view_page(p[0].t[0].f[..],p[0].v[..],c[..],lay);#assert app_test_end(p[0].t[..]);
 #assert app_test_pressable(p[0].t[..],"chat.restore") && app_test_find(p[0].t[..],VIEW_COMPOSER_ID)<0;
 view_pt_running(c[..],"Working");app_test_begin(p[0].t[..],"","",true);p[0].t[0].f[0].skin=conversation_skin();_=view_page(p[0].t[0].f[..],p[0].v[..],c[..],lay);#assert app_test_end(p[0].t[..]);
 #assert app_test_find(p[0].t[..],"chat.restore")<0 && app_test_find(p[0].t[..],VIEW_SEND_ID)>=0;
}

#test "a computer's edit names its file as a link to the workspace and opens onto its change" #steps 4000000000 {
 c:[1]AppCore;p:[1]ViewPageTest;lane:[1]DeviceLane;app_test_init(p[0].t[..]);app_init(c[..]);#assert app_device_attach(c[..],lane[..]);lane[0].on=true;
 e:=lane[0].e[..];e[0].active=true;e[0].ns=el_copy(e[0].session[..],"coder");v:=e[0].view[..];v[0].ok=true;v[0].ns=1;
 v[0].sessions[0].ni=el_copy(v[0].sessions[0].id[..],"coder");v[0].sessions[0].managed=true;
 m:=v[0].items[0];m.ni=el_copy(m.id[..],"p0");m.nr=el_copy(m.role[..],"tool");m.nk=el_copy(m.tool[..],"Edit");m.text_at=ea_text_put(v,"The file was updated");m.nt=20;m.complete=true;
 m.np=el_copy(m.path[..],"/w/apps/a.coax");m.diff_at=ea_text_put(v,"-x := 1\n+x := 2\n");m.ndiff=16;v[0].items[0]=m;v[0].ni=1;
 view_pt_conversation(p[..],c[..]);t:=p[0].t[..];
 // the turn is done, so its group is folded: open it
 if app_test_find(t,"dev.p0.call.0")<0 {#assert view_pt_press(p[..],c[..],"dev.p0").kind==VIEW_P_LOCAL;view_pt_conversation(p[..],c[..]);}
 #assert app_test_label(t,"dev.p0.call.0")=="Edited a.coax" && app_test_row(t,"dev.p0.call.0.path").role==EL_LINK && app_test_has(t,"dev.p0.call.0",EL_S_EXPANDS);
 #assert view_pt_press(p[..],c[..],"dev.p0.call.0").kind==VIEW_P_LOCAL;view_pt_conversation(p[..],c[..]);
 #assert app_test_find(t,"dev.p0.call.0.diff")>=0 && app_test_find(t,"dev.p0.call.0.output")>=0;
 q:=view_pt_press(p[..],c[..],"dev.p0.call.0.path");#assert q.kind==VIEW_P_DISPATCH && q.what==VIEW_C_FILE && view_code(q.what)==0;
}
