// The chat page (GitHub #13645, for #13620): the transcript of the current
// conversation over the composer, built each frame from the app core's state
// with the app's GPU components (components/app/) on the frame context.
//
// One frame, inside the root's uiframe_begin and uiframe_end:
//
//   out := view_page(f, v, c, ViewLayout.{x = 0, top = safe_top, w = w, bottom = composer_bottom, chips_h = chip_row_h, ...});
//   // the environment and repository chips go in out.chips_* (apps/shared/app/environment/)
//   // out.again: a row changed height while it was painted; draw one more frame
//
// A press on a committed row:
//
//   p := view_press(v, c, keyed, surface_id(surface, row), surface_action(surface, row));
//   if p.kind == VIEW_P_DISPATCH { _ := view_dispatch(c, p.what, p.text, mono_ms, wall_ms); }
//   if p.kind == VIEW_P_FOCUS { /* the host puts the platform editor over out.composer */ }
//
// What the page keeps (ChatView): the rows' model, the virtualized list (the
// reading position is an anchor row, list.coax), one Markdown document and
// one decoded message at a time, and a measuring sheet. It never calls a host
// and never writes the core. Text it paints from memory it reuses (a decoded
// message, the parsed document) is copied into the sheet's pool, so the
// committed generation does not change under the person's eyes.
//
// Rows are measured on a separate sheet before they are placed, so a row
// appears at its real height. A row whose height changes while it is painted
// (a tool row opening on its spring) is placed again next frame (out.again).
//   coax/bin/coax test apps/shared/app/view/page.coax

#load "core.coax";
#load "list.coax";
#load "../../../../components/app/task.coax";
#load "../../../../components/app/activity.coax";
#load "../../../../components/app/conversation.coax";
#load "../../../../components/zeron/tools.coax";

// The page's action numbers: what a press on one of its rows is.
VIEW_A_FIELD :: 1;      // the composer's text: the host gives it the keyboard
VIEW_A_SEND :: 2;       // Send, or Stop while a reply runs
VIEW_A_ALLOW :: 3; VIEW_A_DENY :: 4;
VIEW_A_RETRY :: 5;      // a notice's Try again
VIEW_A_RECONNECT :: 6;  // a notice's Reconnect, the banner's Try again
VIEW_A_JUMP :: 7;       // back to the latest message
VIEW_A_TOOL :: 8;       // a tool row, or its pager
VIEW_A_COPY :: 9;       // Copy on a code block
VIEW_A_MESSAGE_COPY :: 10;
VIEW_A_ACT :: 11;       // a turn's activity group (the conversation look): its summary, or one of its rows
VIEW_A_FOLD :: 12;      // a long message's Show more or Show less (Zeron's 5-line fold)
VIEW_FOLDS :: 16;       // the long messages the page keeps open (the most recent opened)

// What view_press found.
VIEW_P_NONE :: 0;       // not the page's
VIEW_P_LOCAL :: 1;      // the page changed its own state: draw a frame
VIEW_P_FOCUS :: 2;      // the host gives the composer the keyboard
VIEW_P_DISPATCH :: 3;   // dispatch `what` (VIEW_C_*) with `text` to the core (view_dispatch)

VIEW_COMPOSER_ID :: "chat.composer";
VIEW_SEND_ID :: "chat.composer.send";
VIEW_PLACEHOLDER :: "Message";
VIEW_EMPTY_TITLE :: "OpenAgents";
VIEW_TYPING_LABEL :: "Writing a reply";
VIEW_OVERSCAN :: 400;   // layout units painted past each edge of the viewport
VIEW_SLACK :: 4;        // how close to the end still counts as the end
VIEW_ESTIMATE :: 48;    // a row never measured
VIEW_COPY_BYTES :: 65536;
// The measuring sheet's capacity: one row at a time.
VIEW_M_UNDER :: 2048; VIEW_M_OVER :: 8192; VIEW_M_LINES :: 4096; VIEW_M_HITS :: 256; VIEW_M_POOL :: 262144;

ViewLayout :: struct {
  x: f32; top: f32; w: f32;   // the page's column, and the top of the transcript (under the safe area)
  bottom: f32;                // where the composer's bottom edge docks (over the keyboard or the safe area)
  chips_h: f32;               // the chip row's height over the composer (0: no chips)
  editing: bool;              // the platform editor holds the keyboard over the composer's text
  editor_h: f32;              // its text height, layout units
  archived:bool;restore_action:int; // local library presentation; never execution authority
  fade_top: f32;              // the transcript fades out toward this edge, under a transparent bar over top (0: it ends at top)
  unit: f32;                  // points a layout unit (the composer's layout is in points)
}
ViewOut :: struct {
  readonly:bool;
  composer: ComposerBox; composer_y: f32;   // the composer as drawn, and its top
  chips_x: f32; chips_y: f32; chips_w: f32; // the slot the environment chips draw in
  again: bool;                              // a row's height changed as it was painted: draw again
}
ViewPress :: struct { kind: int; what: int; text: string; }

ChatView :: struct {
  sub: [128] u8; sub_n: int;                  // the item id of the sub-agent row last pressed (VIEW_C_SUBAGENT's text)
  wall_ms: int;                               // the core's civil time this frame: a computer's running call says how long it has run
  model: [1] ViewModel;
  list: [1] VList; a: [VIEW_ROWS] VRow; b: [VIEW_ROWS] VRow; made: bool;
  doc: [1] MdDoc;
  msg: [1] CtMessage; text: [VIEW_MESSAGE_TEXT] u8;
  m_under: [VIEW_M_UNDER] Prim; m_over: [VIEW_M_OVER] Prim; m_lines: [VIEW_M_LINES] SheetLine; m_hits: [VIEW_M_HITS] SheetHit; m_pool: [VIEW_M_POOL] u8;
  copy: [VIEW_COPY_BYTES] u8; copy_n: int;
  copied: [EL_ID] u8; copied_n: int; copied_block: int;   // the code block copied last ("": none)
  viewport: f32;
  measure_keys:[64]Keyed;measure_store:[1]KeyedStore;
  dev: [] EnvironmentApp; dev_name: string;   // this frame's conversation on a paired computer (empty: none)
  working_from: f32;                          // the frame clock the working line appeared at (-1: none shows)
  unfolded: [VIEW_FOLDS][EL_ID] u8; unfolded_n: [VIEW_FOLDS] int; unfolded_next: int;   // the long messages opened, by row id (a ring)
}

view_init :: (v: [] ChatView) {
  if v[0].made { return; }
  v[0].list[0] = vlist_over(v[0].a[..], v[0].b[..], VIEW_ESTIMATE);
  v[0].copied_block = -1; v[0].working_from = -1; v[0].made = true;
}

// Whether the message row `id` was opened past its fold.
view_unfolded :: (v: [] ChatView, id: string) -> bool {
  for i: 0..<VIEW_FOLDS { if v[0].unfolded_n[i] == id.count && id.count > 0 && cast(string) v[0].unfolded[i][0..<id.count] == id { return true; } }
  return false;
}
// Opens a folded message, or folds an open one again. The most recent VIEW_FOLDS stay open.
view_fold_toggle :: (v: [] ChatView, id: string) {
  for i: 0..<VIEW_FOLDS { if v[0].unfolded_n[i] == id.count && id.count > 0 && cast(string) v[0].unfolded[i][0..<id.count] == id { v[0].unfolded_n[i] = 0; return; } }
  if id.count == 0 || id.count > EL_ID { return; }
  k := v[0].unfolded_next % VIEW_FOLDS; v[0].unfolded_n[k] = el_copy(v[0].unfolded[k][..], id); v[0].unfolded_next = k + 1;
}

// ---------------------------------------------------------------- text

// Copies every run of text painted since `from` into the sheet's pool.
view_keep :: (sh: [] Sheet, from: int) {
  for i: from..<sh[0].no { if sh[0].over[i].kind == PRIM_TEXT { sh[0].over[i].text = sheet_pool(sh, sh[0].over[i].text); } }
}
// A saved message's text, decoded into the page's buffer ("" when it does not read).
view_saved_text :: (v: [] ChatView, d: [] DurableChat, index: int) -> string {
  if !ctr_history_message(d[0].history[..], index, v[0].msg[..], v[0].text[..]) { return ""; }
  return cast(string) v[0].text[0..<v[0].msg[0].bytes];
}
// Parses Markdown into the page's one document. Returns its blocks.
view_parse :: (v: [] ChatView, source: string) -> int {
  doc := v[0].doc[..];
  doc[0].n = 0; doc[0].nb = 0; doc[0].nr = 0; doc[0].ni = 0; doc[0].nlink = 0; doc[0].keep_rules = false;
  return md_parse(doc, source, 0);
}

// ---------------------------------------------------------------- the task's records

view_engine :: (engine: string) -> string {
  return ifx engine == "codex" then "Codex" else ifx engine == "claude" || engine == "claude_code" || engine == "claude-code" then "Claude Code" else engine;
}
// What a computer's chat runs on, as the computer reports it: the offered model's label for the
// conversation's model (Gemini 4 Neon, Antigravity, a Claude model), else the engine its model id
// names; "" when the computer said nothing. Never a name the computer did not give (a phone's chat
// runs on whatever agent that computer has, coax/lib/agent/environment/phone-agent-policy.coax).
view_device_engine :: (e: [] EnvironmentApp) -> string {
  if e.count != 1 { return ""; }
  c := eu_current(e); if c < 0 { return ""; }
  ss := e[0].view[0].sessions[c]; id := cast(string) e[0].view[0].sessions[c].model[0..<ss.nmo];
  if id.count == 0 { return ""; }
  o := e[0].offer[..];
  for i: 0..<o[0].n { m := o[0].models[i]; if cast(string) o[0].models[i].id[0..<m.ni] == id && m.nl > 0 { return cast(string) o[0].models[i].label[0..<m.nl]; } }
  return ifx id == "antigravity" then "Antigravity" else ifx id == "default" || (id.count > 7 && cast(string) id[0..<7] == "claude-") then "Claude Code" else id;
}
view_app_task :: (d: [] DurableChat, f: ViewFacts) -> AppTask {
  n := d[0].native[..]; st := n[0].status[0]; b := n[0].b[0];
  t: AppTask;
  t.computer = cast(string) n[0].host_label[0..<n[0].host_label_n];
  t.engine = view_engine(b.engine); t.model = b.model; t.effort = b.effort;
  t.state = ifx st.state >= XT_QUEUED && st.state <= XT_UNKNOWN then st.state else APP_TASK_UNKNOWN;   // XT_* and APP_TASK_* are the protocol's order
  t.stopping = st.stop || f.stop == VIEW_STOP_ASKED || f.stop == VIEW_STOP_SEEN;
  t.detail = view_task_error(st.error);
  return t;
}
// A task's error in words: never the protocol's code.
view_task_error :: (code: string) -> string {
  if code.count == 0 { return ""; }
  return ifx code == "login_required" then "The computer needs you to log in to its engine."
    else ifx code == "engine_unavailable" || code == "engine_lost" then "The engine stopped answering."
    else ifx code == "model_unavailable" then "The model is not available."
    else ifx code == "expired" then "It ran out of time."
    else ifx code == "route_refused" then "No computer could take it."
    else ifx code == "resident_restarted" then "The computer restarted."
    else "Something went wrong on the computer.";
}
view_tool_title :: (p: SPart) -> string {
  k := p.tk;
  return ifx k == TK_EXEC then "Ran a command" else ifx k == TK_READ then "Read" else ifx k == TK_EDIT then "Edited" else ifx k == TK_WRITE then "Wrote"
    else ifx k == TK_SEARCH then "Searched" else ifx k == TK_GLOB then "Found files" else ifx k == TK_FETCH then "Fetched" else ifx k == TK_WEB then "Searched the web"
    else ifx k == TK_TODO then "Updated the plan" else ifx k == TK_AGENT then "Asked an agent" else ifx p.name.count > 0 then p.name else "Used a tool";
}
view_app_tool :: (s: [] Session, k: int, ended: bool) -> AppTool {
  p := s[0].parts[k];
  t := AppTool.{icon = tool_icon(Tool.{kind=p.tk}), title = view_tool_title(p), arg = ifx p.arg.count > 0 then p.arg else p.detail, input = p.input, output = p.output};
  t.state = ifx p.failed then APP_TOOL_FAILED else ifx p.resolved || ended then APP_TOOL_DONE else ifx k == s[0].asking then APP_TOOL_PENDING else APP_TOOL_RUNNING;
  return t;
}
view_app_permission :: (s: [] Session, k: int, f: ViewFacts, has: bool) -> AppPermission {
  p: AppPermission;
  p.title = "Allow this?"; p.detail = "";
  if has && k >= 0 && k < s[0].n {
    part := s[0].parts[k];
    // the session asks in its own words (a notice after the calls): those words are the detail
    if part.kind == P_NOTICE { p.detail = s_text_of(s, k); }
    else {
    p.title = ifx part.tk == TK_EXEC then "Run this command?" else ifx part.tk == TK_EDIT || part.tk == TK_WRITE then "Change this file?" else ifx part.tk == TK_READ then "Read this file?" else "Allow this?";
    p.detail = ifx part.arg.count > 0 then part.arg else part.detail;
    }
  }
  p.state = ifx f.permit == VIEW_PERMIT_SENT then APP_PERMISSION_SENDING else ifx f.permit == VIEW_PERMIT_UNCERTAIN then APP_PERMISSION_UNCERTAIN else APP_PERMISSION_HELD;
  p.allow = f.allowing; p.can_allow = f.permit == VIEW_PERMIT_READY;
  return p;
}
view_app_result :: (s: [] Session) -> AppTaskResult {
  r := AppTaskResult.{seconds = s[0].turn_ms / 1000, cents = ifx s[0].cost > 0 then cast(int) (s[0].cost * 100 + 0.5) else -1};
  for k: 0..<s[0].n { if s[0].parts[k].kind == P_TOOL { r.tools += 1; if s[0].parts[k].failed { r.failed += 1; } } }
  return r;
}

// ---------------------------------------------------------------- a conversation on a paired computer

// A message row's text: a saved one, the one in flight, or the computer's.
view_row_text :: (v: [] ChatView, d: [] DurableChat, r: ViewRow) -> string {
  if r.kind == VK_MESSAGE { return view_saved_text(v, d, r.index); }
  if r.kind == VK_SENT { return cast(string) d[0].submitted[0..<d[0].submitted_n]; }
  if r.kind == VK_DEVICE_SENT { return r.text; }
  if r.kind == VK_DEVICE_MESSAGE { return ifx v[0].dev.count == 1 then ea_item_text(v[0].dev[0].view[..], r.index) else ""; }
  return ct_view_text(d[0].view[..]);
}
// The computer's tool item: its name, the first line of what it reports as the argument, and the whole as its result.
view_device_app_tool :: (e: [] EnvironmentApp, i: int) -> AppTool {
  m := e[0].view[0].items[i]; text := ea_item_text(e[0].view[..], i);
  first := text; for c, k: text { if c == '\n' { first = cast(string) text[0..<k]; break; } }
  t := AppTool.{icon = ICON_WIDGET, title = ifx m.nk > 0 then cast(string) e[0].view[0].items[i].tool[0..<m.nk] else "Used a tool", arg = first, output = text};
  t.state = ifx m.complete then APP_TOOL_DONE else APP_TOOL_RUNNING;
  return t;
}
view_device_permission :: (f: ViewFacts) -> AppPermission {
  p := AppPermission.{title = "Allow this?", detail = "Your computer asks before it goes on."};
  p.state = ifx f.permit == VIEW_PERMIT_SENT then APP_PERMISSION_SENDING else ifx f.permit == VIEW_PERMIT_UNCERTAIN then APP_PERMISSION_UNCERTAIN else APP_PERMISSION_HELD;
  p.allow = f.allowing; p.can_allow = f.permit == VIEW_PERMIT_READY;
  return p;
}

// ---------------------------------------------------------------- a turn's activity

// In the conversation look a turn's thoughts and tool calls are one activity group, as Coder
// Desktop draws a message's work (components/app/activity.coax, GitHub #13713): the summary
// ("Thought process · ran 2 commands"), then a row for each thought and call that opens onto its
// call and output. The group is open while it works and folds to its summary once done, unless
// the person chose otherwise; that choice is kept under the group's id (APP_TOOL_OPEN: 0 none,
// 1 opened, 2 folded), each row's own under the row's id (view_group_key).

// The activity kind of a session's tool kind (TK_*).
view_act_kind :: (tk: int) -> int {
  return ifx tk == TK_THOUGHT then APP_ACT_THOUGHT else ifx tk == TK_EXEC then APP_ACT_EXEC else ifx tk == TK_READ then APP_ACT_READ
    else ifx tk == TK_EDIT then APP_ACT_EDIT else ifx tk == TK_WRITE then APP_ACT_WRITE else ifx tk == TK_SEARCH then APP_ACT_SEARCH
    else ifx tk == TK_GLOB then APP_ACT_GLOB else ifx tk == TK_FETCH || tk == TK_WEB then APP_ACT_WEB else ifx tk == TK_TODO then APP_ACT_TODO
    else ifx tk == TK_AGENT then APP_ACT_AGENT else -1;
}
// What a row says it did, by its activity kind; any other tool goes by its name.
view_act_verb :: (kind: int, name: string) -> string {
  return ifx kind == APP_ACT_EXEC then "Ran" else ifx kind == APP_ACT_READ then "Read" else ifx kind == APP_ACT_EDIT then "Edited"
    else ifx kind == APP_ACT_WRITE then "Wrote" else ifx kind == APP_ACT_SEARCH then "Searched" else ifx kind == APP_ACT_GLOB then "Found files"
    else ifx kind == APP_ACT_WEB then "Fetched" else ifx kind == APP_ACT_TODO then "Updated todos" else ifx kind == APP_ACT_AGENT then "Ran a subagent"
    else ifx kind == APP_ACT_THOUGHT then "Thought process" else ifx name.count > 0 then name else "Used a tool";
}
// The first line of text.
view_first_line :: (text: string) -> string { for c, k: text { if c == '\n' { return cast(string) text[0..<k]; } } return text; }
// A tool of no kind of its own is APP_ACT_KINDS: the terminal's glyph, and the summary counts it as a tool.
// Part k of the task's session as a row: a thought's words, or a call with its argument and result.
view_act_native :: (s: [] Session, k: int, ended: bool) -> AppActRow {
  p := s[0].parts[k];
  if p.kind == P_THINK { return AppActRow.{kind = APP_ACT_THOUGHT, verb = "Thought process", output = s_text_of(s, k)}; }
  t := view_app_tool(s, k, ended);
  kind := view_act_kind(p.tk);
  arg := ifx p.arg.count > 0 then p.arg else p.detail;
  r := AppActRow.{kind = ifx kind < 0 then APP_ACT_KINDS else kind, verb = view_act_verb(kind, p.name), target = view_first_line(arg), output = p.output};
  // the whole argument when the line says less; the call's input while nothing has come back
  r.call = ifx r.target != arg then arg else ifx p.output.count == 0 && p.input.count > 0 && p.input != arg then p.input else "";
  r.failed = t.state == APP_TOOL_FAILED; r.running = t.state == APP_TOOL_RUNNING || t.state == APP_TOOL_PENDING;
  return r;
}
// Item i of the computer's view as a row: its tool's name says its kind; its text is the call
// while it runs and the result once it is done.
view_act_device :: (e: [] EnvironmentApp, i: int, wall_ms: int) -> AppActRow { return view_act_item(e[0].view[..], i, wall_ms); }
// Item i of a computer's view (a session's page, or a sub-agent's: subagent/flow.coax) as a row.
view_act_item :: (v: [] EaView, i: int, wall_ms: int) -> AppActRow {
  m := v[0].items[i]; text := ea_item_text(v, i);
  if ea_thought(v, i) { return AppActRow.{kind = APP_ACT_THOUGHT, verb = "Thought process", output = text}; }
  name := ifx m.nk > 0 then cast(string) v[0].items[i].tool[0..<m.nk] else "";
  kind := view_act_kind(tk_of_name(name));
  r := AppActRow.{kind = ifx kind < 0 then APP_ACT_KINDS else kind, verb = view_act_verb(kind, name), target = view_first_line(text)};
  // a call the computer says is still running carries when it began
  if m.complete && m.started == 0 { r.output = text; } else { r.running = true; if r.target != text { r.call = text; } }
  if m.started > 0 && wall_ms > 0 { r.timed = true; r.secs = (wall_ms - m.started) / 1000; }
  // an edit or a write names its file (a link to the computer's workspace) and shows what it changed
  if m.np > 0 {
    r.path = cast(string) v[0].items[i].path[0..<m.np]; from := 0; for ch, q: r.path { if ch == '/' { from = q + 1; } }
    if from < r.path.count { r.target = cast(string) r.path[from..<r.path.count]; }
    r.diff = ea_item_diff(v, i); r.diff_cut = m.diff_cut;
  }
  // a sub-agent says how many calls its agent has made; while it runs, its row opens onto the newest
  if m.calls > 0 {
    r.calls = m.calls;
    if r.running && m.nn > 0 { r.output = cast(string) v[0].items[i].now[0..<m.nn]; }
  }
  // a sub-agent's row opens its own transcript (ReadSubagent), on a computer that keeps one
  if kind == APP_ACT_AGENT { r.opens = true; }
  return r;
}
// The rows of the group that starts at model row r, into rows and ids (buf holds the ids).
// Returns how many; live says whether any of them is still at work.
view_act_rows :: (v: [] ChatView, d: [] DurableChat, r: ViewRow, id: string, rows: [] AppActRow, ids: [] string, buf: [][EL_ID] u8, live: [] bool) -> int {
  n := 0; live[0] = false;
  last := ifx r.group_count > 1 then r.group_last else r.index;
  for k: r.index..<last + 1 {
    if n == rows.count { break; }
    if r.kind == VK_TOOL {
      if !d[0].native[0].has_session { break; }
      ses := d[0].native[0].shown[..];
      if k < 0 || k >= ses[0].n || (ses[0].parts[k].kind != P_TOOL && ses[0].parts[k].kind != P_THINK) { continue; }
      rows[n] = view_act_native(ses, k, xt_terminal(d[0].native[0].status[0].state));
      if ses[0].parts[k].kind == P_THINK && k == ses[0].n - 1 && !xt_terminal(d[0].native[0].status[0].state) { live[0] = true; }
    } else {
      if v[0].dev.count != 1 || k < 0 || k >= v[0].dev[0].view[0].ni { continue; }
      rows[n] = view_act_device(v[0].dev, k, v[0].wall_ms);
      if ea_thought(v[0].dev[0].view[..], k) && !v[0].dev[0].view[0].items[k].complete { live[0] = true; }
    }
    if rows[n].running { live[0] = true; }
    ids[n] = view_group_key(buf[n][..], id, k); n += 1;
  }
  return n;
}
VIEW_ACT_MOST :: 16;   // rows a group holds (view_group_tools makes no longer one)
// The group that starts at model row r, at (x, y), w wide. Returns its height.
view_activity :: (f: [] UiFrame, v: [] ChatView, d: [] DurableChat, r: ViewRow, id: string, x: f32, y: f32, w: f32) -> f32 {
  rows: [VIEW_ACT_MOST] AppActRow; ids: [VIEW_ACT_MOST] string; buf: [VIEW_ACT_MOST][EL_ID] u8; live: [1] bool;
  n := view_act_rows(v, d, r, id, rows[..], ids[..], buf[..], live[..]);
  c: [1] AppActCount;
  for q: 0..<n { app_act_count(c[..], ifx rows[q].kind < APP_ACT_KINDS then rows[q].kind else -1, rows[q].failed); }
  sb: [256] u8; sn := app_act_summary(sb[..], c[0]);
  k := uiframe_key(f, id);
  open := app_act_open(cast(int) keyed_slot(f[0].keyed, k, APP_TOOL_OPEN), live[0]);
  h := app_act_head(f, id, x, y, w, sheet_pool(f[0].sheet, cast(string) sb[0..<sn]), live[0], open, VIEW_A_ACT);
  if !open { return h; }
  h += f[0].skin.app.gap_small;
  for q: 0..<n {
    // a thought's words wrap as Markdown, in the page's one document: what it painted is kept before the next parse
    from := f[0].sheet[0].no;
    if rows[q].kind == APP_ACT_THOUGHT && rows[q].output.count > 0 { rows[q].blocks = view_parse(v, rows[q].output); rows[q].doc = v[0].doc[..]; rows[q].block0 = 0; }
    h += app_act_row(f, ids[q], x, y + h, w, rows[q], q < n - 1, VIEW_A_ACT);
    view_keep(f[0].sheet, from);
  }
  return h;
}

// ---------------------------------------------------------------- one row

// Whether a tool row is open, read without marking it seen (for measuring).
view_open_now :: (keyed: [] KeyedStore, id: string) -> bool {
  k := keyed_find(keyed, id);
  return k >= 0 && keyed_slot(keyed, k, APP_TOOL_OPEN) > 0;
}
view_group_key :: (out:[]u8,id:string,index:int)->string {n:=el_put(out,0,id);n=el_put(out,n,".call.");n=el_put_i(out,n,index);return cast(string)out[0..<n];}
view_group_row :: (f:[]UiFrame,v:[]ChatView,d:[]DurableChat,facts:ViewFacts,r:ViewRow,id:string,x:f32,y:f32,w:f32,open:bool)->f32 {
 tools:[16]AppTool;ids:[16]string;buf:[16][EL_ID]u8;n:=0;commands:=0;failed:=0;
 for k:r.index..<r.group_last+1 {if n==16 {break;}
  if r.kind==VK_TOOL {ses:=d[0].native[0].shown[..];if ses[0].parts[k].kind!=P_TOOL {continue;}tools[n]=view_app_tool(ses,k,xt_terminal(d[0].native[0].status[0].state));if ses[0].parts[k].tk==TK_EXEC {commands+=1;}}
  else {tools[n]=view_device_app_tool(v[0].dev,k);name:=tools[n].title;if name=="Bash" || name=="exec_command" || name=="shell" || name=="terminal" {commands+=1;}}
  if tools[n].state==APP_TOOL_FAILED {failed+=1;}ids[n]=view_group_key(buf[n][..],id,k);n+=1;
 }
 caption:[160]u8;at:=0;
 if commands>0 {at=el_put(caption[..],at,"Ran ");at=el_put_i(caption[..],at,commands);at=el_put(caption[..],at,ifx commands==1 then " command" else " commands");}
 if n>commands {if at>0 {at=el_put(caption[..],at,", ");}at=el_put(caption[..],at,"Used ");at=el_put_i(caption[..],at,n-commands);at=el_put(caption[..],at,ifx n-commands==1 then " tool" else " tools");}
 if failed>0 {at=el_put(caption[..],at," (");at=el_put_i(caption[..],at,failed);at=el_put(caption[..],at," failed)");}
 return app_tool_group(f,id,x,y,w,sheet_pool(f[0].sheet,cast(string)caption[0..<at]),ids[0..<n],tools[0..<n],open,VIEW_A_TOOL);
}
// Paints row i of the model at (x, y), w wide, and returns its height with the gap under it.
// `open` is whether a tool row starts open (measuring passes what the person set).
view_row :: (f: [] UiFrame, v: [] ChatView, d: [] DurableChat, facts: ViewFacts, i: int, x: f32, y: f32, w: f32, open: bool) -> f32 {
  vm := v[0].model[..]; r := vm[0].rows[i]; id := view_row_id(vm, i);
  s := f[0].skin; sh := f[0].sheet; n := d[0].native[..]; ses := n[0].shown[..];
  from := sh[0].no; h: f32 = 0; gap := s.app.gap * 2;
  if r.kind == VK_MESSAGE || r.kind == VK_SENT || r.kind == VK_REPLY || r.kind == VK_DEVICE_MESSAGE || r.kind == VK_DEVICE_SENT {
    text := view_row_text(v, d, r);
    agent := r.kind == VK_REPLY || ((r.kind == VK_MESSAGE || r.kind == VK_DEVICE_MESSAGE) && r.assistant);
    if agent {
      blocks := view_parse(v, text);
      copied := ifx v[0].copied_n > 0 && cast(string) v[0].copied[0..<v[0].copied_n] == id then v[0].copied_block else -1;
      h = app_message_agent(f, id, x, y, w, v[0].doc[..], blocks, copied, VIEW_A_COPY);
      if s.chat.enabled && text.count>0 {
        cid:[EL_ID]u8;h+=s.app.gap_small;
        h+=app_message_actions(f,app_id(cid[..],id,".copy"),x,y+h,v[0].copied_n>0 && cast(string)v[0].copied[0..<v[0].copied_n]==id && v[0].copied_block== -2,VIEW_A_MESSAGE_COPY);
      }
    } else if s.chat.enabled { h = app_message_user_fold(f, id, x, y, w, text, view_unfolded(v, id), VIEW_A_FOLD); }
    else { h = app_message_user(f, id, x, y, w, text); }
  } else if r.kind == VK_TYPING {
    if s.chat.enabled { secs := ifx v[0].working_from >= 0 then cast(int) (f[0].clock - v[0].working_from) else 0; h = app_working(f, id, x, y, secs, ""); }
    else { h = app_typing(f, id, x, y, VIEW_TYPING_LABEL); }
  }
  else if r.kind == VK_THOUGHT || r.kind == VK_DEVICE_THOUGHT { gap = 0; }   // outside the conversation look a thought shows nowhere; in it, view_group_tools folds it into its group
  else if r.kind == VK_TASK_HEAD { if !s.chat.enabled {h = app_task_header(f, id, x, y, w, view_app_task(d, facts));gap=s.app.gap;}else {gap=0;} }
  else if (r.kind == VK_TOOL || r.kind == VK_DEVICE_TOOL) && s.chat.enabled { h = view_activity(f, v, d, r, id, x, y, w); gap = s.app.gap; }
  else if r.kind == VK_TOOL {if r.group_count>1 {h=view_group_row(f,v,d,facts,r,id,x,y,w,open);}else {h = app_tool(f, id, x, y, w, view_app_tool(ses, r.index, xt_terminal(n[0].status[0].state)), open, VIEW_A_TOOL);} gap = s.app.gap_small; }
  else if r.kind == VK_PERMISSION { h = app_permission(f, id, x, y, w, view_app_permission(ses, r.index, facts, n[0].has_session), VIEW_A_ALLOW, VIEW_A_DENY); gap = s.app.gap; }
  else if r.kind == VK_TASK_STATE {task:=view_app_task(d,facts);if s.chat.enabled && !task.stopping && ((task.state==APP_TASK_RUNNING && ct_view_text(d[0].view[..]).count>0) || task.state==APP_TASK_COMPLETED) {gap=0;}else {h = app_task_state(f, id, x, y, w, task); gap = s.app.gap;} }
  else if r.kind == VK_TASK_RESULT { h = app_task_result(f, id, x, y, w, view_app_result(ses)); }
  else if r.kind == VK_DEVICE_TOOL && v[0].dev.count == 1 {if r.group_count>1 {h=view_group_row(f,v,d,facts,r,id,x,y,w,open);}else {h = app_tool(f, id, x, y, w, view_device_app_tool(v[0].dev, r.index), open, VIEW_A_TOOL);} gap = s.app.gap_small; }
  else if r.kind == VK_DEVICE_PERMISSION { h = app_permission(f, id, x, y, w, view_device_permission(facts), VIEW_A_ALLOW, VIEW_A_DENY); gap = s.app.gap; }
  else if r.kind == VK_DEVICE_STATE {
    t := AppTask.{computer = v[0].dev_name, engine = view_device_engine(v[0].dev), state = APP_TASK_RUNNING, stopping = facts.stop == VIEW_STOP_ASKED || facts.stop == VIEW_STOP_SEEN};
    h = app_task_state(f, id, x, y, w, t); gap = s.app.gap;
  }
  else if r.kind == VK_NOTICE {
    if r.act == VIEW_DO_RETRY { h = app_retry(f, id, x, y, w, r.text, "Try again", 0, VIEW_A_RETRY); }
    else if r.act == VIEW_DO_RECONNECT { h = app_retry(f, id, x, y, w, r.text, "Reconnect", 0, VIEW_A_RECONNECT); }
    else if r.text == VIEW_W_STOPPED || r.act == VIEW_DO_QUIET { h = app_meta(f, id, x, y, w, r.text, false); }
    else { h = app_notice(f, id, x, y, w, r.text, APP_NOTICE_ERROR); }
  }
  view_keep(sh, from);
  return h + gap;
}

// A row's height, laid out on the page's measuring sheet: nothing is recorded and nothing is kept.
view_measure :: (f: [] UiFrame, v: [] ChatView, d: [] DurableChat, facts: ViewFacts, i: int, w: f32) -> f32 {
  sh := [1] Sheet.[Sheet.{under = v[0].m_under[..], over = v[0].m_over[..], lines = v[0].m_lines[..], hits = v[0].m_hits[..], pool = v[0].m_pool[..]}];
  mf := [1] UiFrame.[uiframe_over(sh[..], f[0].m, f[0].skin)];
  // Copy only this group's keyed subtree for measuring. Measurement never
  // ticks or mutates the live animations and respects open child details.
  id:=view_row_id(v[0].model[..],i);count:=0;
  for source:f[0].keyed[0].rows {key:=source;kid:=cast(string)key.id[0..<key.id_n];if kid.count>=id.count && cast(string)kid[0..<id.count]==id && (kid.count==id.count || kid[id.count]=='.') && count<64 {v[0].measure_keys[count]=key;count+=1;}}
  v[0].measure_store[0]=KeyedStore.{rows=v[0].measure_keys[..]};for k:count..<64 {v[0].measure_keys[k]=Keyed.{};}
  keyed_begin(v[0].measure_store[..],0,true);mf[0].keyed=v[0].measure_store[..];
  mf[0].clock = f[0].clock; mf[0].reduced_motion = true;
  return view_row(mf[..], v, d, facts, i, 0, 0, w, view_open_now(f[0].keyed, view_row_id(v[0].model[..], i)));
}

// ---------------------------------------------------------------- the page

view_composer_state :: (d: [] DurableChat, facts: ViewFacts) -> int {
  if facts.send == VIEW_SEND_STOP { return APP_COMPOSER_RUNNING; }
  if facts.device { return ifx facts.sent.count > 0 && !facts.send_unsure then APP_COMPOSER_SENDING else APP_COMPOSER_READY; }
  if d[0].pending == 1 && !d[0].uncertain { return APP_COMPOSER_SENDING; }
  return APP_COMPOSER_READY;
}

// One frame of the chat page.
view_page :: (f: [] UiFrame, v: [] ChatView, c: [] AppCore, lay: ViewLayout) -> ViewOut {
  view_init(v);
  s := f[0].skin; a := s.app; d := view_chat_of(c); l := v[0].list[..]; vm := v[0].model[..];
  facts := view_facts(c); v[0].wall_ms = c[0].wall_ms;
  view_attach_device(v, c);
  if facts.device && v[0].dev.count == 1 { view_build_device(vm, v[0].dev, facts); } else { view_build(vm, d, facts); }
  if s.chat.enabled {view_group_tools(vm);}
  typing := false; for i: 0..<vm[0].n { if vm[0].rows[i].kind == VK_TYPING { typing = true; } }
  if !typing { v[0].working_from = -1; } else if v[0].working_from < 0 { v[0].working_from = f[0].clock; }
  out: ViewOut;
  // the composer docks at the bottom, the chip slot over it
  // Zeron's composer: a one-line capsule at rest in a conversation (no keyboard, no draft), the card
  // with its chips in the action row once it holds the keyboard or a draft, or the chat is new
  draft := view_draft_of(c);
  compact := s.chat.enabled && !vm[0].empty && !lay.editing && draft.count == 0;
  look := AppComposer.{placeholder = VIEW_PLACEHOLDER, text = draft, state = view_composer_state(d, facts), editing = lay.editing, editor_h = lay.editor_h, unit = lay.unit, compact = compact,
    deliver = ifx facts.deliver == VIEW_DELIVER_STEER then "Steer" else ifx facts.deliver == VIEW_DELIVER_QUEUE then "Queue" else ""};
  pad := ifx s.chat.enabled then s.chat.inset else a.gap * 2;
  out.readonly=facts.readonly;
  if s.chat.enabled && lay.archived && facts.stop==VIEW_STOP_NONE && facts.permit==VIEW_PERMIT_NONE {out.readonly=true;out.composer.height=s.control_h;_=app_button(f,"chat.restore",lay.x+pad,lay.bottom-s.control_h,lay.w-2*pad,ICON_ARCHIVE,"Archived · Restore",APP_BUTTON_QUIET,0,lay.restore_action);}
  else if s.chat.enabled && facts.readonly {out.composer.height=s.control_h;_=app_notice(f,"chat.readonly",lay.x+pad,lay.bottom-s.control_h,lay.w-2*pad,"Read-only session",APP_NOTICE_INFO);}
  else {out.composer = app_composer(f, VIEW_COMPOSER_ID, VIEW_SEND_ID, lay.x + pad, lay.bottom, lay.w - 2 * pad, look, VIEW_A_FIELD, VIEW_A_SEND);}
  out.composer_y = lay.bottom - out.composer.height;
  out.chips_x = lay.x + pad; out.chips_w = lay.w - 2 * pad;
  out.chips_y = out.composer_y - (ifx lay.chips_h > 0 && !out.readonly then lay.chips_h + a.gap else 0.0f32);
  above := out.chips_y;
  if s.chat.enabled && !out.readonly {
    // the chips ride in the card's action row, left of the action (Zeron's toolbar); the capsule has none
    b := out.composer; inset := s.cmp.action_inset + (b.send - s.cmp.chip_h) / 2;
    out.chips_x = lay.x + pad + inset; out.chips_w = ifx compact || lay.chips_h <= 0 then 0.0f32 else b.send_x - inset - s.app.gap;
    if look.deliver.count > 0 && out.chips_w > 0 { pw := ceil(measure_width(f[0].m, s.label.face, look.deliver)) + 2 * s.cmp.chip_pad - b.send; if pw > 0 { out.chips_w -= pw; } if out.chips_w < 0 { out.chips_w = 0; } }
    out.chips_y = out.composer_y + b.row_y + (b.send - lay.chips_h) / 2; above = out.composer_y;
  }
  // the transcript fills what is left
  top := lay.top; bottom := above - a.gap;
  viewport := ifx bottom > top then bottom - top else 0.0f32;
  cx := lay.x + pad; cw := lay.w - 2 * pad;
  if v[0].viewport > 0 && viewport != v[0].viewport { vlist_viewport(l, viewport); }
  v[0].viewport = viewport;
  vlist_begin(l);
  for i: 0..<vm[0].n { _ := vlist_row(l, view_row_id(vm, i), vm[0].rows[i].stamp); }
  vlist_place(l, viewport, VIEW_OVERSCAN);
  guard := 0;
  while guard < VIEW_ROWS {
    i := vlist_need(l);
    if i < 0 { break; }
    vlist_measured(l, i, view_measure(f, v, d, facts, i, cw));
    vlist_place(l, viewport, VIEW_OVERSCAN);
    guard += 1;
  }
  // Under a transparent bar (lay.fade_top), the rows scrolled past the top keep drawing up to the
  // bar's top, fading out over the bar as Zeron's soft edge does; what can be pressed still ends at top.
  faded := lay.fade_top > 0 && lay.fade_top < top;
  if faded {
    sh := f[0].sheet;
    sheet_under(sh, prim_clip(sh[0].under, sh[0].nu, lay.x, lay.fade_top, lay.x + lay.w, bottom));
    sheet_over_n(sh, prim_clip(sh[0].over, sh[0].no, lay.x, lay.fade_top, lay.x + lay.w, bottom));
    // the soft edge reaches s.chat.fade below the bar's top once the transcript has scrolled that far
    // (at the very top nothing is under the bar, and the first row stays whole)
    band := top - lay.fade_top; more := s.chat.fade - band; if more > l[0].top { more = l[0].top; } if more > 0 { band += more; }
    uiframe_fade_edge(f, lay.fade_top, band);   // a row's own foot fade keeps it (uiframe_fade_foot)
    elt_clip(f[0].rows, lay.x, top, lay.x + lay.w, bottom);
  } else { uiframe_clip(f, lay.x, top, lay.x + lay.w, bottom); }
  for i: l[0].first..<l[0].last {
    y := top + vlist_y(l, i);
    h := view_row(f, v, d, facts, i, cx, y, cw, false);
    if h != vlist_height(l, i) { vlist_measured(l, i, h); out.again = true; }
  }
  // the empty conversation: the name alone (app_empty's circle would hold no mark)
  if vm[0].empty {
    if s.chat.enabled {_:=app_conversation_empty(f,cx,top+(viewport-s.chat.mark-s.chat.greeting_gap-s.display.line)/2,cw,"Let's build");}
    else {ey := top + (viewport - s.title.line) / 2;
      th := app_centred(f, s.title, s.ink, cx, ey, cw, VIEW_EMPTY_TITLE);
      _ := uiframe_semantic(f, "chat.empty", EL_HEADING, VIEW_EMPTY_TITLE, cx, ey, cw, th, 0, 0);}
  }
  if faded { uiframe_fade_edge(f, 0, 0); }
  uiframe_unclip(f);
  vlist_settle(l, VIEW_SLACK);
  if vm[0].rejoining { _ := app_banner(f, "chat.banner", cx, top + a.gap, cw, APP_BANNER_RECONNECTING, 0); }
  if !l[0].follow && l[0].content > viewport { _ := app_jump(f, "chat.jump", lay.x + lay.w / 2, bottom - a.icon_button - a.gap, "Jump to latest", 0, VIEW_A_JUMP); }
  return out;
}

// This frame's conversation on a paired computer, or none.
view_attach_device :: (v: [] ChatView, c: [] AppCore) {
  if app_device_on(c) { v[0].dev = app_device_env(c); v[0].dev_name = view_device_name(c); } else { v[0].dev = v[0].dev[0..<0]; v[0].dev_name = ""; }
}
// A scroll by dy layout units (positive: toward the latest message).
view_scroll :: (v: [] ChatView, dy: f32) { view_init(v); vlist_scroll(v[0].list[..], dy); }

// ---------------------------------------------------------------- presses

// The model row whose id is `pressed` or the start of it (a tool row's pager, a message's code block).
view_owner :: (vm: [] ViewModel, pressed: string, kind: int) -> int {
  for i: 0..<vm[0].n {
    if vm[0].rows[i].kind != kind { continue; }
    id := view_row_id(vm, i);
    if pressed.count >= id.count && cast(string) pressed[0..<id.count] == id && (pressed.count == id.count || pressed[id.count] == '.') { return i; }
  }
  return -1;
}
// The code block a Copy id names ("chat.reply.code.3.copy": 3), or -1.
view_code_block :: (id: string) -> int {
  mark := ".code.";
  for at: 0..<id.count {
    if at + mark.count > id.count || cast(string) id[at..<at + mark.count] != mark { continue; }
    k := at + mark.count; n := 0; digits := 0;
    while k < id.count && id[k] >= '0' && id[k] <= '9' { n = n * 10 + cast(int) (id[k] - '0'); k += 1; digits += 1; }
    if digits > 0 { return n; }
  }
  return -1;
}
// A press on the committed row `pressed` whose action is `action`. `keyed` is the
// frame's keyed store (a tool row keeps what is open there).
view_press :: (v: [] ChatView, c: [] AppCore, keyed: [] KeyedStore, pressed: string, action: int) -> ViewPress {
  view_init(v);
  vm := v[0].model[..]; facts := view_facts(c);
  if action == VIEW_A_FIELD { return ViewPress.{kind = VIEW_P_FOCUS}; }
  if action == VIEW_A_SEND { return ViewPress.{kind = VIEW_P_DISPATCH, what = ifx facts.send == VIEW_SEND_STOP then VIEW_C_STOP else VIEW_C_SEND}; }
  // an answer whose outcome is unknown is sent again as it was
  if action == VIEW_A_ALLOW || action == VIEW_A_DENY {
    what := ifx facts.permit == VIEW_PERMIT_UNCERTAIN then VIEW_C_RETRY else ifx action == VIEW_A_ALLOW then VIEW_C_ALLOW else VIEW_C_DENY;
    return ViewPress.{kind = VIEW_P_DISPATCH, what = what};
  }
  if action == VIEW_A_RETRY { return ViewPress.{kind = VIEW_P_DISPATCH, what = VIEW_C_RETRY}; }
  if action == VIEW_A_RECONNECT { return ViewPress.{kind = VIEW_P_DISPATCH, what = VIEW_C_RECONNECT}; }
  if action == VIEW_A_FOLD {
    // "<row>.more": the message opens or folds again, and stays where it is on screen while it eases
    tail := ".more"; if pressed.count <= tail.count || cast(string) pressed[pressed.count - tail.count..<pressed.count] != tail { return ViewPress.{}; }
    id := cast(string) pressed[0..<pressed.count - tail.count];
    view_fold_toggle(v, id); vlist_pin(v[0].list[..], id);
    return ViewPress.{kind = VIEW_P_LOCAL};
  }
  if action == VIEW_A_JUMP { vlist_jump(v[0].list[..]); return ViewPress.{kind = VIEW_P_LOCAL}; }
  if action == VIEW_A_TOOL {
    i := view_owner(vm, pressed, VK_TOOL); if i < 0 { i = view_owner(vm, pressed, VK_DEVICE_TOOL); }
    if i < 0 { return ViewPress.{}; }
    id := view_row_id(vm, i);
    vlist_pin(v[0].list[..], id);   // it stays where it is while it opens
    if vm[0].rows[i].group_count>1 && pressed!=id {r:=vm[0].rows[i];buf:[EL_ID]u8;
      for k:r.index..<r.group_last+1 {child:=view_group_key(buf[..],id,k);if pressed.count>=child.count && cast(string)pressed[0..<child.count]==child && (pressed.count==child.count || pressed[child.count]=='.') {return ViewPress.{kind=ifx app_tool_press(keyed,child,pressed) then VIEW_P_LOCAL else VIEW_P_NONE};}}
      return ViewPress.{};
    }
    return ViewPress.{kind = ifx app_tool_press(keyed, id, pressed) then VIEW_P_LOCAL else VIEW_P_NONE};
  }
  if action == VIEW_A_ACT {
    i := view_owner(vm, pressed, VK_TOOL); if i < 0 { i = view_owner(vm, pressed, VK_DEVICE_TOOL); }
    if i < 0 { return ViewPress.{}; }
    id := view_row_id(vm, i); r := vm[0].rows[i];
    vlist_pin(v[0].list[..], id);   // it stays where it is while it opens
    if pressed == id {
      // the summary: the other of what shows now
      view_attach_device(v, c);
      rows: [VIEW_ACT_MOST] AppActRow; ids: [VIEW_ACT_MOST] string; buf: [VIEW_ACT_MOST][EL_ID] u8; live: [1] bool;
      _ := view_act_rows(v, view_chat_of(c), r, id, rows[..], ids[..], buf[..], live[..]);
      k := keyed_find(keyed, id); if k < 0 { return ViewPress.{}; }
      keyed_slot_set(keyed, k, APP_TOOL_OPEN, cast(f32) app_act_choose(cast(int) keyed_slot(keyed, k, APP_TOOL_OPEN), live[0]));
      return ViewPress.{kind = VIEW_P_LOCAL};
    }
    buf: [EL_ID] u8; last := ifx r.group_count > 1 then r.group_last else r.index;
    for k: r.index..<last + 1 {
      child := view_group_key(buf[..], id, k);
      if pressed.count >= child.count && cast(string) pressed[0..<child.count] == child && (pressed.count == child.count || pressed[child.count] == '.') {
        // a computer session's file: the page opens that computer's workspace on its changes
        if r.kind == VK_DEVICE_TOOL && app_act_path_pressed(child, pressed) { return ViewPress.{kind = VIEW_P_DISPATCH, what = VIEW_C_FILE}; }
        // a computer session's sub-agent: the page opens its transcript (text: the item that started it)
        if r.kind == VK_DEVICE_TOOL && pressed == child {
          view_attach_device(v, c);
          if v[0].dev.count == 1 && k < v[0].dev[0].view[0].ni && view_act_device(v[0].dev, k, 0).kind == APP_ACT_AGENT {
            m := v[0].dev[0].view[0].items[k]; v[0].sub_n = el_copy(v[0].sub[..], cast(string) v[0].dev[0].view[0].items[k].id[0..<m.ni]);
            return ViewPress.{kind = VIEW_P_DISPATCH, what = VIEW_C_SUBAGENT, text = cast(string) v[0].sub[0..<v[0].sub_n]};
          }
        }
        return ViewPress.{kind = ifx app_act_press(keyed, child, pressed) then VIEW_P_LOCAL else VIEW_P_NONE};
      }
    }
    return ViewPress.{};
  }
  if action == VIEW_A_MESSAGE_COPY {
    view_attach_device(v,c);i:=view_owner(vm,pressed,VK_MESSAGE);if i<0 {i=view_owner(vm,pressed,VK_REPLY);}if i<0 {i=view_owner(vm,pressed,VK_DEVICE_MESSAGE);}
    if i<0 {return ViewPress.{};}r:=vm[0].rows[i];text:=view_row_text(v,view_chat_of(c),r);
    if text.count<1 || text.count>v[0].copy.count {return ViewPress.{};}
    v[0].copy_n=el_put(v[0].copy[..],0,text);v[0].copied_n=el_copy(v[0].copied[..],view_row_id(vm,i));v[0].copied_block= -2;
    return ViewPress.{kind=VIEW_P_DISPATCH,what=VIEW_C_COPY,text=cast(string)v[0].copy[0..<v[0].copy_n]};
  }
  if action == VIEW_A_COPY {
    view_attach_device(v, c);
    i := view_owner(vm, pressed, VK_MESSAGE); if i < 0 { i = view_owner(vm, pressed, VK_REPLY); } if i < 0 { i = view_owner(vm, pressed, VK_DEVICE_MESSAGE); }
    b := view_code_block(pressed);
    if i < 0 || b < 0 { return ViewPress.{}; }
    d := view_chat_of(c); r := vm[0].rows[i];
    text := view_row_text(v, d, r);
    blocks := view_parse(v, text);
    if b >= blocks || v[0].doc[0].blocks[b].kind != MB_CODE { return ViewPress.{}; }
    v[0].copy_n = el_put(v[0].copy[..], 0, md_block_text(v[0].doc[..], b));
    v[0].copied_n = el_copy(v[0].copied[..], view_row_id(vm, i)); v[0].copied_block = b;
    return ViewPress.{kind = VIEW_P_DISPATCH, what = VIEW_C_COPY, text = cast(string) v[0].copy[0..<v[0].copy_n]};
  }
  return ViewPress.{};
}

#load "page-checks.coax" #test;
