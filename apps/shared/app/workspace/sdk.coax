// SDK admission for exact public workspace commands and correlated replies.
#load "../../../../coax/lib/agent/workspace/wire.coax";
#authority;
#test "workspace SDK only routes admitted requests to the exact host and method" {
 q:[1]WsRequest;q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");q[0].nw=js_copy(q[0].workspace[..],"default");b:[24576]u8;n:=ws_write(q[..],b[..]);h:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
 #assert ow_effect(1,h,cast(string)b[0..<n]) && ow_effect(0,h,cast(string)b[0..<n]) && ow_effect(3,h,"");#assert !ow_effect(4,h,"") && !ow_effect(1,"bad",cast(string)b[0..<n]) && !ow_effect(2,h,"{}");
 #assert ow_mutation(cast(string)b[0..<n])==0 && ow_mutation("{}")== -1;
 v:[1]WsView;_=js_copy(v[0].host[..],h);v[0].method=q[0].method;v[0].nm=q[0].nm;v[0].workspace=q[0].workspace;v[0].nw=q[0].nw;raw:[1048576]u8;nr:=ws_view_write(v[..],raw[..]);#assert ow_reply(h,cast(string)b[0..<n],cast(string)raw[0..<nr]);v[0].host[0]='b';nr=ws_view_write(v[..],raw[..]);#assert !ow_reply(h,cast(string)b[0..<n],cast(string)raw[0..<nr]);
}
ow_effect :: (mode:int,host:string,raw:string)->bool #export_c #effects(all) {if mode<0 || mode>3 || !ea_id(host,64) {return false;}if mode>=2 {return raw.count==0;}q:[1]WsRequest;return ws_read(raw,q[..]);}
ow_mutation :: (raw:string)->int #export_c #effects(all) {q:[1]WsRequest;return ifx ws_read(raw,q[..]) then ws_right(cast(string)q[0].method[0..<q[0].nm]) else -1;}
ow_reply :: (host:string,request:string,raw:string)->bool #export_c #effects(all) {q:[1]WsRequest;v:[1]WsView;if !ws_read(request,q[..]) || !ws_view_read(raw,v[..]) {return false;}return cast(string)v[0].host[..]==host && cast(string)v[0].method[0..<v[0].nm]==cast(string)q[0].method[0..<q[0].nm] && cast(string)v[0].command[0..<v[0].nc]==cast(string)q[0].command[0..<q[0].nc] && (cast(string)v[0].workspace[0..<v[0].nw]==cast(string)q[0].workspace[0..<q[0].nw] || cast(string)q[0].method[0..<q[0].nm]=="RemoveWorktree" && cast(string)v[0].workspace[0..<v[0].nw]=="default");}
#test "workspace SDK rejects cross-context replies and admits every exact transport mode" {
 h:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";q:[1]WsRequest;q[0].nm=js_copy(q[0].method[..],"PushBranch");q[0].nw=js_copy(q[0].workspace[..],"default");q[0].nc=js_copy(q[0].command[..],"0123456789abcdef0123456789abcdef");q[0].nx=js_copy(q[0].expected[..],h);q[0].issued=1;q[0].expires=2;b:[24576]u8;n:=ws_write(q[..],b[..]);#assert n>0 && ow_mutation(cast(string)b[0..<n])==1;
  #assert !ow_reply(h,"{}","{}") && !ow_reply(h,cast(string)b[0..<n],"{}");
 for mode:-1..<5 {#assert ow_effect(mode,h,cast(string)b[0..<n])==(mode==0 || mode==1);#assert ow_effect(mode,h,"")==(mode==2 || mode==3);}
 v:[1]WsView;_=js_copy(v[0].host[..],h);v[0].method=q[0].method;v[0].nm=q[0].nm;v[0].command=q[0].command;v[0].nc=q[0].nc;v[0].workspace=q[0].workspace;v[0].nw=q[0].nw;raw:[49152]u8;size:=ws_view_write(v[..],raw[..]);#assert ow_reply(h,cast(string)b[0..<n],cast(string)raw[0..<size]);v[0].command[0]='1';size=ws_view_write(v[..],raw[..]);#assert !ow_reply(h,cast(string)b[0..<n],cast(string)raw[0..<size]);v[0].command=q[0].command;v[0].nw=js_copy(v[0].workspace[..],h);size=ws_view_write(v[..],raw[..]);#assert !ow_reply(h,cast(string)b[0..<n],cast(string)raw[0..<size]);
 q[0].nm=js_copy(q[0].method[..],"RemoveWorktree");q[0].workspace=v[0].workspace;q[0].nw=64;n=ws_write(q[..],b[..]);v[0].method=q[0].method;v[0].nm=q[0].nm;v[0].nw=js_copy(v[0].workspace[..],"default");size=ws_view_write(v[..],raw[..]);#assert ow_reply(h,cast(string)b[0..<n],cast(string)raw[0..<size]);v[0].nw=js_copy(v[0].workspace[..],"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc");size=ws_view_write(v[..],raw[..]);#assert !ow_reply(h,cast(string)b[0..<n],cast(string)raw[0..<size]);v[0].nw=js_copy(v[0].workspace[..],"default");v[0].nm=js_copy(v[0].method[..],"ReadWorkspace");size=ws_view_write(v[..],raw[..]);#assert !ow_reply(h,cast(string)b[0..<n],cast(string)raw[0..<size]);q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");q[0].nc=0;q[0].nx=0;q[0].issued=0;q[0].expires=0;n=ws_write(q[..],b[..]);v[0].nc=0;size=ws_view_write(v[..],raw[..]);#assert !ow_reply(h,cast(string)b[0..<n],cast(string)raw[0..<size]);
}
