#load "flow.coax";
#load "../../../../components/app/base.coax";
#load "../../../../components/app/reader.coax";
WSC_ACTION :: 570; WSC_FIELD :: 571;
wsc_id :: (prefix:string,index:int,out:[]u8)->string {n:=js_copy(out,prefix);if index>=100 {out[n]=cast(u8)('0'+index/100);n+=1;}if index>=10 {out[n]=cast(u8)('0'+index/10%10);n+=1;}out[n]=cast(u8)('0'+index%10);return cast(string)out[0..<n+1];}
wsc_view :: (s:[]WorkspaceScreen,f:[]UiFrame,x:f32,origin:f32,w:f32,top:f32,bottom:f32,focus:string)->f32 {
 k:=f[0].skin;y:=origin;gap:=k.app.gap;off:=ifx s[0].pending then EL_S_DISABLED else 0;v:=s[0].view[..];
 if s[0].nn>0 {y+=app_notice(f,"workspace.note",x,y,w,cast(string)s[0].note[0..<s[0].nn],APP_NOTICE_ERROR)+gap;}
 if s[0].unknown {y+=app_button(f,"workspace.retry",x,y,w,-1,"Check result",APP_BUTTON_PRIMARY,ifx s[0].op>0 then EL_S_DISABLED else 0,WSC_ACTION)+gap;}
 if s[0].host[0]==0 {for i:0..<s[0].catalog[0].n {id:[64]u8;y+=app_button(f,wsc_id("workspace.computer.",i,id[..]),x,y,w,-1,cast(string)s[0].catalog[0].entries[i].label[0..<s[0].catalog[0].entries[i].nl],APP_BUTTON_DEFAULT,0,WSC_ACTION)+gap;}if s[0].catalog[0].n==0 {y+=app_text(f,"workspace.no.computers",x,y,w,APP_TEXT_BODY,ifx s[0].catalog_loaded then "No connected computers" else "Connecting…");}return y-origin;}
 y+=app_button(f,"workspace.computers",x,y,w,-1,"Computers",APP_BUTTON_QUIET,ifx s[0].pending then EL_S_DISABLED else 0,WSC_ACTION)+gap;
 for i:0..<s[0].catalog[0].n {entry:=s[0].catalog[0].entries[i];if cast(string)entry.host[..]==cast(string)s[0].host[..] {y+=app_text(f,"workspace.computer.name",x,y,w,APP_TEXT_CAPTION,cast(string)s[0].catalog[0].entries[i].label[0..<entry.nl])+gap;}}
 if v[0].nr>0 {y+=app_text(f,"workspace.repository",x,y,w,APP_TEXT_CAPTION,app_fit(f,k.small.face,cast(string)v[0].repository[0..<v[0].nr],w))+gap;}
 if s[0].confirm {
  q:=s[0].intent[..];y+=app_text(f,"workspace.confirm.method",x,y,w,APP_TEXT_TITLE,wsc_label(s[0].form))+gap;
  y+=app_text(f,"workspace.confirm.path",x,y,w,APP_TEXT_CAPTION,app_fit(f,k.small.face,cast(string)v[0].path[0..<v[0].npath],w))+gap;
  label:=ifx q[0].nb>0 then cast(string)q[0].branch[0..<q[0].nb] else ifx q[0].nt>0 then cast(string)q[0].title[0..<q[0].nt] else cast(string)q[0].workspace[0..<q[0].nw];y+=app_text(f,"workspace.confirm.target",x,y,w,APP_TEXT_BODY,app_fit(f,k.body.face,label,w))+gap;
  y+=app_button(f,"workspace.confirm",x,y,w,-1,"Confirm",APP_BUTTON_PRIMARY,off,WSC_ACTION)+gap;
  if !s[0].pending {y+=app_button(f,"workspace.cancel",x,y,w,-1,"Cancel",APP_BUTTON_QUIET,0,WSC_ACTION)+gap;}return y-origin;
 }
 if s[0].form>0 {
  if s[0].form==1 || s[0].form==2 || s[0].form==3 {y+=app_field(f,"workspace.branch",x,y,w,"Branch",wsc_field(s,"workspace.branch"),"feature/name",false,focus=="workspace.branch","",off,WSC_FIELD)+gap;}
  if s[0].form==1 || s[0].form==3 || s[0].form==6 {y+=app_field(f,"workspace.base",x,y,w,"Base",wsc_field(s,"workspace.base"),"main",false,focus=="workspace.base","",off,WSC_FIELD)+gap;}
  if s[0].form==6 || s[0].form==7 {y+=app_field(f,"workspace.title",x,y,w,"Title",wsc_field(s,"workspace.title"),"Pull request title",false,focus=="workspace.title","",off,WSC_FIELD)+gap;y+=ctx_textarea(f,"workspace.body",x,y,w,"Description",wsc_field(s,"workspace.body"),"",4,focus=="workspace.body",off,WSC_FIELD)+gap;}
  y+=app_button(f,"workspace.review",x,y,w,-1,"Review",APP_BUTTON_PRIMARY,off,WSC_ACTION)+gap;y+=app_button(f,"workspace.cancel",x,y,w,-1,"Cancel",APP_BUTTON_QUIET,off,WSC_ACTION)+gap;return y-origin;
 }
 if !s[0].loaded {return y-origin+app_text(f,"workspace.loading",x,y,w,APP_TEXT_BODY,"Connecting…");}
 y+=app_text(f,"workspace.branch.current",x,y,w,APP_TEXT_TITLE,app_fit(f,k.title.face,ifx v[0].nb>0 then cast(string)v[0].branch[0..<v[0].nb] else "Detached HEAD",w))+gap;
 for i:0..<4 {id:[64]u8;title:=ifx i==0 then "Diff" else ifx i==1 then "Branch" else ifx i==2 then "Trees" else "PRs";_=app_button(f,wsc_id("workspace.tab.",i,id[..]),x+cast(f32)i*w/4,y,w/4-4,-1,title,ifx s[0].tab==i then APP_BUTTON_PRIMARY else APP_BUTTON_QUIET,0,WSC_ACTION);}y+=k.control_h+gap;
 if v[0].next>0 {y+=app_button(f,"workspace.more",x,y,w,-1,"Next",APP_BUTTON_QUIET,off,WSC_ACTION)+gap;}if s[0].cursor>0 {y+=app_button(f,"workspace.first",x,y,w,-1,"First",APP_BUTTON_QUIET,off,WSC_ACTION)+gap;}
 if s[0].tab==0 {
  y+=app_read_text(f,"workspace.status",x,y,w,top,bottom,ifx v[0].ns==0 then "No changes" else cast(string)v[0].status[0..<v[0].ns])+gap;
  if v[0].diff_cut {y+=app_text(f,"workspace.diff.cut",x,y,w,APP_TEXT_CAPTION,"Diff shortened")+gap;}
  if v[0].nd>0 {y+=app_read_text(f,"workspace.diff",x,y,w,top,bottom,cast(string)v[0].diff[0..<v[0].nd])+gap;}
  y+=app_button(f,"workspace.push",x,y,w,-1,"Push branch",APP_BUTTON_DEFAULT,off,WSC_ACTION)+gap;
 } else if s[0].tab==1 {
  y+=app_button(f,"workspace.newbranch",x,y,w,-1,"New branch",APP_BUTTON_DEFAULT,off,WSC_ACTION)+gap;
  for i:0..<v[0].nbra {if y+k.control_h>top && y<bottom {id:[64]u8;_=app_button(f,wsc_id("workspace.branch.",i,id[..]),x,y,w,-1,app_fit(f,k.body.face,cast(string)v[0].branches[i].name[0..<v[0].branches[i].n],w-2*k.app.card_pad),APP_BUTTON_QUIET,off,WSC_ACTION);}y+=k.control_h;}
 } else if s[0].tab==2 {
  y+=app_button(f,"workspace.newtree",x,y,w,-1,"New worktree",APP_BUTTON_DEFAULT,off,WSC_ACTION)+gap;
  for i:0..<v[0].nt {r:=v[0].trees[i];if y+2*k.control_h>top && y<bottom {id:[64]u8;label:=cast(string)v[0].trees[i].path[0..<r.np];_=app_button(f,wsc_id("workspace.tree.",i,id[..]),x,y,w,-1,app_fit(f,k.body.face,label,w-2*k.app.card_pad),APP_BUTTON_QUIET,off,WSC_ACTION);_=app_button(f,wsc_id("workspace.remove.",i,id[..]),x,y+k.control_h,w,-1,"Remove",APP_BUTTON_QUIET,off,WSC_ACTION);}y+=2*k.control_h+gap;}
 } else {
  if v[0].ng>0 {y+=app_text(f,"workspace.github",x,y,w,APP_TEXT_CAPTION,"Sign in to GitHub on this computer")+gap;}
  y+=app_button(f,"workspace.newpr",x,y,w,-1,"New pull request",APP_BUTTON_DEFAULT,off | (ifx v[0].ng>0 then EL_S_DISABLED else 0),WSC_ACTION)+gap;
  for i:0..<v[0].np {r:=v[0].prs[i];if y+k.control_h>top && y<bottom {id:[64]u8;_=app_button(f,wsc_id("workspace.pr.",i,id[..]),x,y,w,-1,app_fit(f,k.body.face,cast(string)v[0].prs[i].title[0..<r.nt],w-2*k.app.card_pad),APP_BUTTON_QUIET,off,WSC_ACTION);}y+=k.control_h;}
 }return y-origin;
}
wsc_press :: (s:[]WorkspaceScreen,c:[]AppCore,id:string)->bool {
 if id=="workspace.back" {s[0].open=false;return true;}if id=="workspace.retry" {s[0].retry=true;return true;}
 if s[0].pending || s[0].op>0 {return false;}
 if id=="workspace.more" || id=="workspace.first" {s[0].cursor=ifx id=="workspace.more" then s[0].view[0].next else 0;s[0].due=0;s[0].loaded=false;return true;}
 if id=="workspace.cancel" {s[0].form=0;s[0].confirm=false;return true;}
 if id=="workspace.review" {return wsc_intent(s);}
 if id=="workspace.confirm" {if !s[0].confirm {return false;}s[0].pending=true;s[0].ready=false;return true;}
 b:[64]u8;if id=="workspace.computers" {s[0].host[0]=0;s[0].catalog_loaded=false;return true;}for i:0..<s[0].catalog[0].n {if id==wsc_id("workspace.computer.",i,b[..]) {host:=cast(string)s[0].catalog[0].entries[i].host[..];return wsc_open(s,host,dl_find(c,host)<0);}}for i:0..<4 {if id==wsc_id("workspace.tab.",i,b[..]) {s[0].tab=i;s[0].cursor=0;s[0].due=0;s[0].loaded=false;return true;}}
 s[0].nn=0;
 if id=="workspace.newbranch" || id=="workspace.newtree" || id=="workspace.push" || id=="workspace.newpr" {s[0].form=ifx id=="workspace.newbranch" then 1 else ifx id=="workspace.newtree" then 3 else ifx id=="workspace.push" then 5 else 6;s[0].nb=0;s[0].na=js_copy(s[0].base[..],"main");s[0].nt=0;s[0].nd=0;s[0].number=0;return true;}
 for i:0..<s[0].view[0].nbra {if id==wsc_id("workspace.branch.",i,b[..]) {s[0].form=2;s[0].branch=s[0].view[0].branches[i].name;s[0].nb=s[0].view[0].branches[i].n;s[0].na=0;return wsc_intent(s);}}
 for i:0..<s[0].view[0].nt {if id==wsc_id("workspace.tree.",i,b[..]) {s[0].view[0].workspace=s[0].view[0].trees[i].id;s[0].view[0].nw=64;s[0].due=0;s[0].loaded=false;return true;}if id==wsc_id("workspace.remove.",i,b[..]) {s[0].view[0].workspace=s[0].view[0].trees[i].id;s[0].view[0].nw=64;s[0].after_read=4;s[0].due=0;s[0].loaded=false;s[0].form=0;s[0].nb=0;s[0].na=0;return true;}}
 for i:0..<s[0].view[0].np {if id==wsc_id("workspace.pr.",i,b[..]) {r:=s[0].view[0].prs[i];s[0].form=7;s[0].number=r.number;s[0].title=r.title;s[0].nt=r.nt;s[0].body=r.body;s[0].nd=r.nd;s[0].na=0;s[0].nb=0;return true;}}
 return false;
}
