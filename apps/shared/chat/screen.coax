// Shared OpenAgents chat screen (Chapters 1, 2, and 3 of the OpenAgents Book).
// Consumed by both apps/openagents-desktop (primary app) and apps/openagents-ios (mobile).
//
// Chapter 1: GPU-rendered composer text input, semantic element table, driver seam.
// Chapter 2: Explicit ChatState, serialized ChatAction dispatch, per-surface dirty marks.
// Chapter 3: GPU-rendered transcript surface with Markdown blocks, scrolling, pin-to-bottom,
//            and jump-to-bottom, isolated on its own dirty mark.
//
//   coax/bin/coax test apps/shared/chat/screen.coax

#load "../../../components/backend/gpu.coax";
#load "../../../components/skin/arcade.coax";
#load "../../../components/kit/form.coax";
#load "../../../components/kit/markdown.coax";
#load "../../../components/core/edit.coax";
#load "../../../components/core/scroll.coax";

CS_UNDER :: 512;
CS_OVER :: 128;
CS_HITS :: 64;
CS_LINES :: 128;
CS_POOL :: 16384;
CS_ROWS :: 128;
CS_KEYED :: 32;
CS_MAX_VERTICES :: 8192;
CS_MAX_MESSAGES :: 32;
CS_MSG_CAP :: 512;

CHAT_FORM_DESKTOP :: 0;
CHAT_FORM_MOBILE :: 1;

CHAT_ROLE_USER :: 0;
CHAT_ROLE_ASSISTANT :: 1;
CHAT_ROLE_SYSTEM :: 2;

CS_SCALE_DESKTOP :: 1.0f32;
CS_SCALE_MOBILE :: 1.12f32;
CS_MARGIN_DESKTOP :: 24.0f32;
CS_MARGIN_MOBILE :: 16.0f32;
CS_PANEL_MAX_DESKTOP :: 760.0f32;
CS_PANEL_MAX_MOBILE :: 420.0f32;

CS_HIT_COMPOSER :: 1;
CS_HIT_SEND :: 2;
CS_HIT_JUMP_BOTTOM :: 3;

CS_ACT_EDIT :: 1;
CS_ACT_SEND :: 2;
CS_ACT_APPEND :: 3;
CS_ACT_SCROLL :: 4;
CS_ACT_JUMP_BOTTOM :: 5;

CS_DISPATCH_OK :: 0;
CS_DISPATCH_REFUSED_EMPTY :: 1;
CS_DISPATCH_REFUSED_FULL :: 2;
CS_DISPATCH_REFUSED_REENTRANT :: 3;
CS_DISPATCH_REFUSED_UNKNOWN :: 4;

ChatMessage :: struct {
  id: int;
  role: int;
  body: [CS_MSG_CAP] u8;
  body_n: int;
}

ChatState :: struct {
  draft: [1] EditBuf;
  messages: [CS_MAX_MESSAGES] ChatMessage;
  message_count: int;
  next_message_id: int;
  send_enabled: bool;
  // Chapter 3: transcript scroll & pin-to-bottom state.
  // Zero-initialized state starts pinned to bottom (!unpinned).
  scroll_y: f32;
  content_h: f32;
  viewport_h: f32;
  unpinned: bool;
  unread_below: int;
}

ChatAction :: struct {
  kind: int;
  role: int;
  text: string;
  delta_y: f32;
}

ChatDispatchResult :: struct {
  accepted: bool;
  reason: int;
  dirty_composer: bool;
  dirty_transcript: bool;
  seq: int;
}

CsGeneration :: struct {
  under: [CS_UNDER] Prim;
  over: [CS_OVER] Prim;
  lines: [CS_LINES] SheetLine;
  hits: [CS_HITS] SheetHit;
  pool: [CS_POOL] u8;
  rows: [CS_ROWS] El;
}

ComposerScreen :: struct {
  ready: bool;
  form_factor: int;
  time: f32;
  d: f32;
  width: f32;
  height: f32;
  safe_top: f32;
  safe_bottom: f32;
  keyboard: f32;
  reduced_motion: bool;
  reduced_transparency: bool;
  focused: bool;
  pressed: int;
  down_x: f32;
  down_y: f32;
  moving: bool;
  // Chapter 2: explicit state record, serialized dispatch, per-surface dirty marks.
  state: [1] ChatState;
  dispatching: bool;
  action_seq: int;
  actions_refused: int;
  dirty_composer: bool;
  dirty_transcript: bool;
  redraws: int;
  composer_redraws: int;
  transcript_redraws: int;
  // GPU atlas + two surfaces (composer and transcript) + keyed state.
  atlas: [1] Atlas;
  gen: [2] CsGeneration;
  surface: [1] UiSurface;
  tgen: [2] CsGeneration;
  transcript: [1] UiSurface;
  keys: [CS_KEYED] Keyed;
  keyed: [1] KeyedStore;
  tkeys: [CS_KEYED] Keyed;
  tkeyed: [1] KeyedStore;
  md_doc: [1] MdDoc;
}

cs_scale :: (s: [] ComposerScreen) -> f32 {
  return ifx s[0].form_factor == CHAT_FORM_MOBILE then CS_SCALE_MOBILE else CS_SCALE_DESKTOP;
}

cs_margin :: (s: [] ComposerScreen) -> f32 {
  return ifx s[0].form_factor == CHAT_FORM_MOBILE then CS_MARGIN_MOBILE else CS_MARGIN_DESKTOP;
}

cs_panel_max :: (s: [] ComposerScreen) -> f32 {
  return ifx s[0].form_factor == CHAT_FORM_MOBILE then CS_PANEL_MAX_MOBILE else CS_PANEL_MAX_DESKTOP;
}

cs_init :: (s: [] ComposerScreen) {
  if s[0].ready { return; }
  a := Sheet.{under = s[0].gen[0].under[..], over = s[0].gen[0].over[..], lines = s[0].gen[0].lines[..], hits = s[0].gen[0].hits[..], pool = s[0].gen[0].pool[..]};
  b := Sheet.{under = s[0].gen[1].under[..], over = s[0].gen[1].over[..], lines = s[0].gen[1].lines[..], hits = s[0].gen[1].hits[..], pool = s[0].gen[1].pool[..]};
  s[0].surface[0] = surface_over(a, s[0].gen[0].rows[..], b, s[0].gen[1].rows[..]);
  s[0].keyed[0] = KeyedStore.{rows = s[0].keys[..]};

  ta := Sheet.{under = s[0].tgen[0].under[..], over = s[0].tgen[0].over[..], lines = s[0].tgen[0].lines[..], hits = s[0].tgen[0].hits[..], pool = s[0].tgen[0].pool[..]};
  tb := Sheet.{under = s[0].tgen[1].under[..], over = s[0].tgen[1].over[..], lines = s[0].tgen[1].lines[..], hits = s[0].tgen[1].hits[..], pool = s[0].tgen[1].pool[..]};
  s[0].transcript[0] = surface_over(ta, s[0].tgen[0].rows[..], tb, s[0].tgen[1].rows[..]);
  s[0].tkeyed[0] = KeyedStore.{rows = s[0].tkeys[..]};

  s[0].dirty_composer = true;
  s[0].dirty_transcript = true;
  s[0].ready = true;
}

cs_rows :: (s: [] ComposerScreen) -> ElTable { return surface_rows(s[0].surface[..]); }
cs_trows :: (s: [] ComposerScreen) -> ElTable { return surface_rows(s[0].transcript[..]); }

cs_find_composer :: (s: [] ComposerScreen, id: string) -> int {
  t := [1] ElTable.[cs_rows(s)];
  return elt_find(t[..], id);
}

cs_find_transcript :: (s: [] ComposerScreen, id: string) -> int {
  t := [1] ElTable.[cs_trows(s)];
  return elt_find(t[..], id);
}

cs_find :: (s: [] ComposerScreen, id: string) -> int {
  ti := cs_find_transcript(s, id);
  if ti >= 0 { return ti; }
  ci := cs_find_composer(s, id);
  if ci >= 0 { return cs_trows(s).n + ci; }
  return -1;
}

cs_draft :: (s: [] ComposerScreen) -> string { return eb_text(s[0].state[0].draft[..]); }

cs_out :: (out: [] u8, text: string) -> int { return el_put(out, 0, text); }

cs_msg_body :: (st: [] ChatState, idx: int) -> string {
  return cast(string) st[0].messages[idx].body[0..<st[0].messages[idx].body_n];
}

cs_msg_id :: (id: int, out: [] u8) -> int {
  n := el_put(out, 0, "message.");
  return el_put_i(out, n, id);
}

cs_role_prefix :: (role: int) -> string {
  if role == CHAT_ROLE_ASSISTANT { return "assistant: "; }
  if role == CHAT_ROLE_SYSTEM { return "system: "; }
  return "you: ";
}

cs_msg_line :: (st: [] ChatState, idx: int, out: [] u8) -> int {
  n := el_put(out, 0, cs_role_prefix(st[0].messages[idx].role));
  return el_put(out, n, cs_msg_body(st, idx));
}

chat_state_pinned :: (st: [] ChatState) -> bool {
  if st.count < 1 { return true; }
  return !st[0].unpinned;
}

// Pure all-or-nothing state transition for one action.
chat_state_apply :: (st: [] ChatState, act: ChatAction) -> ChatDispatchResult {
  if st.count < 1 { return ChatDispatchResult.{accepted = false, reason = CS_DISPATCH_REFUSED_UNKNOWN}; }
  if act.kind == CS_ACT_EDIT {
    eb_set(st[0].draft[..], act.text);
    st[0].send_enabled = eb_text(st[0].draft[..]).count > 0;
    return ChatDispatchResult.{accepted = true, reason = CS_DISPATCH_OK, dirty_composer = true, dirty_transcript = false};
  }
  if act.kind == CS_ACT_SEND {
    draft := eb_text(st[0].draft[..]);
    if draft.count == 0 || !st[0].send_enabled {
      return ChatDispatchResult.{accepted = false, reason = CS_DISPATCH_REFUSED_EMPTY};
    }
    if st[0].message_count >= CS_MAX_MESSAGES {
      return ChatDispatchResult.{accepted = false, reason = CS_DISPATCH_REFUSED_FULL};
    }
    idx := st[0].message_count;
    next_id := st[0].next_message_id + 1;
    st[0].messages[idx].id = next_id;
    st[0].messages[idx].role = CHAT_ROLE_USER;
    st[0].messages[idx].body_n = el_copy(st[0].messages[idx].body[..], draft);
    st[0].message_count = idx + 1;
    st[0].next_message_id = next_id;
    eb_set(st[0].draft[..], "");
    st[0].send_enabled = false;
    st[0].unpinned = false;
    st[0].unread_below = 0;
    return ChatDispatchResult.{accepted = true, reason = CS_DISPATCH_OK, dirty_composer = true, dirty_transcript = true};
  }
  if act.kind == CS_ACT_APPEND {
    if act.text.count == 0 {
      return ChatDispatchResult.{accepted = false, reason = CS_DISPATCH_REFUSED_EMPTY};
    }
    if st[0].message_count >= CS_MAX_MESSAGES {
      return ChatDispatchResult.{accepted = false, reason = CS_DISPATCH_REFUSED_FULL};
    }
    idx := st[0].message_count;
    next_id := st[0].next_message_id + 1;
    st[0].messages[idx].id = next_id;
    st[0].messages[idx].role = act.role;
    st[0].messages[idx].body_n = el_copy(st[0].messages[idx].body[..], act.text);
    st[0].message_count = idx + 1;
    st[0].next_message_id = next_id;
    if st[0].unpinned {
      st[0].unread_below += 1;
    }
    return ChatDispatchResult.{accepted = true, reason = CS_DISPATCH_OK, dirty_composer = false, dirty_transcript = true};
  }
  if act.kind == CS_ACT_SCROLL {
    next := scroll_clamp(st[0].scroll_y + act.delta_y, st[0].content_h, st[0].viewport_h);
    st[0].scroll_y = next;
    at_end := scroll_at_end(st[0].content_h, st[0].viewport_h, next, 2.0f32);
    st[0].unpinned = !at_end;
    if at_end { st[0].unread_below = 0; }
    return ChatDispatchResult.{accepted = true, reason = CS_DISPATCH_OK, dirty_composer = false, dirty_transcript = true};
  }
  if act.kind == CS_ACT_JUMP_BOTTOM {
    st[0].scroll_y = scroll_max(st[0].content_h, st[0].viewport_h);
    st[0].unpinned = false;
    st[0].unread_below = 0;
    return ChatDispatchResult.{accepted = true, reason = CS_DISPATCH_OK, dirty_composer = false, dirty_transcript = true};
  }
  return ChatDispatchResult.{accepted = false, reason = CS_DISPATCH_REFUSED_UNKNOWN};
}

chat_state_equal :: (a: [] ChatState, b: [] ChatState) -> bool {
  if a.count < 1 || b.count < 1 { return false; }
  if a[0].send_enabled != b[0].send_enabled { return false; }
  if a[0].message_count != b[0].message_count { return false; }
  if a[0].next_message_id != b[0].next_message_id { return false; }
  if a[0].unpinned != b[0].unpinned { return false; }
  if a[0].unread_below != b[0].unread_below { return false; }
  if eb_text(a[0].draft[..]) != eb_text(b[0].draft[..]) { return false; }
  for i: 0..<a[0].message_count {
    if a[0].messages[i].id != b[0].messages[i].id { return false; }
    if a[0].messages[i].role != b[0].messages[i].role { return false; }
    if a[0].messages[i].body_n != b[0].messages[i].body_n { return false; }
    if cs_msg_body(a, i) != cs_msg_body(b, i) { return false; }
  }
  return true;
}

// Serialized action dispatch on the screen.
cs_dispatch :: (s: [] ComposerScreen, act: ChatAction) -> ChatDispatchResult {
  if s.count < 1 { return ChatDispatchResult.{accepted = false, reason = CS_DISPATCH_REFUSED_UNKNOWN}; }
  if s[0].dispatching {
    s[0].actions_refused += 1;
    return ChatDispatchResult.{accepted = false, reason = CS_DISPATCH_REFUSED_REENTRANT, seq = s[0].action_seq};
  }
  s[0].dispatching = true;
  res := chat_state_apply(s[0].state[..], act);
  s[0].dispatching = false;
  if !res.accepted {
    s[0].actions_refused += 1;
    res.seq = s[0].action_seq;
    return res;
  }
  s[0].action_seq += 1;
  res.seq = s[0].action_seq;
  if res.dirty_composer { s[0].dirty_composer = true; }
  if res.dirty_transcript { s[0].dirty_transcript = true; }
  return res;
}

cs_dirty :: (s: [] ComposerScreen) -> bool {
  if s.count < 1 { return false; }
  return !s[0].ready || s[0].dirty_composer || s[0].dirty_transcript || s[0].moving;
}

cs_composer_top :: (s: [] ComposerScreen, k: UiSkin, h: f32) -> f32 {
  sc := cs_scale(s);
  fh := form_field_height(k);
  top := s[0].safe_top / sc + k.space;
  bottom := h - s[0].safe_bottom / sc - k.space;
  if s[0].keyboard > 0 { bottom = h - s[0].keyboard / sc - k.space; }
  py := bottom - fh;
  if py < top { py = top; }
  return py;
}

cs_layout_composer :: (s: [] ComposerScreen, f: [] UiFrame, w: f32, h: f32, duplicate_id: bool) {
  k := f[0].skin;
  margin := cs_margin(s);
  panel_max := cs_panel_max(s);
  pw := ifx w - 2 * margin < panel_max then w - 2 * margin else panel_max;
  px := (w - pw) / 2;
  fh := form_field_height(k);
  py := cs_composer_top(s, k, h);
  send_w := button_width(f[0].m, k, "Send");
  gap := k.space;
  field_w := pw - send_w - gap;
  if field_w < 80 { field_w = 80; }
  send_x := px + field_w + gap;
  send_y := py + (fh - k.control_h) / 2;
  send_state := ifx s[0].state[0].send_enabled then 0 else EL_S_DISABLED;
  _ := ctx_field(f, "composer.input", px, py, field_w, "Message", cs_draft(s), "Message", s[0].focused, 0, CS_HIT_COMPOSER);
  _ := ctx_button(f, "composer.send", send_x, send_y, "Send", s[0].state[0].send_enabled, send_state, CS_HIT_SEND);
  if duplicate_id {
    _ := ctx_field(f, "composer.input", px, py + fh + k.space, field_w, "Message", cs_draft(s), "Message", false, 0, CS_HIT_COMPOSER);
  }
}

cs_measure_message :: (a: [] Atlas, doc: [] MdDoc, m: TextMeasure, k: UiSkin, sh: [] Sheet, role: int, body: string, w: f32) -> f32 {
  h := k.label.line + 4.0f32;
  if role == CHAT_ROLE_ASSISTANT {
    doc[0] = MdDoc.{};
    n := md_parse(doc, body, 0);
    if n > 0 {
      for b: 0..<n {
        h += markdown_height(sh, m, k, doc, b, w);
        if b + 1 < n { h += k.md.block_gap; }
      }
      return h + k.space;
    }
  }
  // Plain text / user message: wrap by width estimate or single line.
  line_w := text_width(a, k.body.face, body);
  lines := 1;
  if w > 16 && line_w > w {
    lines = cast(int) (line_w / w) + 1;
  }
  return h + cast(f32) lines * k.body.line + k.space;
}

cs_layout_transcript :: (s: [] ComposerScreen, f: [] UiFrame, w: f32, h: f32) {
  k := f[0].skin;
  sc := cs_scale(s);
  margin := cs_margin(s);
  panel_max := cs_panel_max(s);
  pw := ifx w - 2 * margin < panel_max then w - 2 * margin else panel_max;
  px := (w - pw) / 2;
  top := s[0].safe_top / sc + k.space;
  composer_top := cs_composer_top(s, k, h);
  vp_h := composer_top - top - k.space;
  if vp_h < 32 { vp_h = 32; }

  // Measure total content height across all messages.
  total_h := 0.0f32;
  msg_h: [CS_MAX_MESSAGES] f32;
  for i: 0..<s[0].state[0].message_count {
    mh := cs_measure_message(s[0].atlas[..], s[0].md_doc[..], f[0].m, k, f[0].sheet, s[0].state[0].messages[i].role, cs_msg_body(s[0].state[..], i), pw);
    msg_h[i] = mh;
    total_h += mh;
  }
  s[0].state[0].content_h = total_h;
  s[0].state[0].viewport_h = vp_h;
  if !s[0].state[0].unpinned {
    s[0].state[0].scroll_y = scroll_max(total_h, vp_h);
  } else {
    s[0].state[0].scroll_y = scroll_clamp(s[0].state[0].scroll_y, total_h, vp_h);
    if scroll_at_end(total_h, vp_h, s[0].state[0].scroll_y, 2.0f32) {
      s[0].state[0].unpinned = false;
      s[0].state[0].unread_below = 0;
    }
  }

  if s[0].state[0].message_count > 0 {
    _ := uiframe_semantic(f, "transcript.list", EL_TEXT, "Transcript", px, top, pw, vp_h, 0, 0);
  }

  y := top - s[0].state[0].scroll_y;
  id_buf: [32] u8;
  line_buf: [CS_MSG_CAP + 16] u8;
  for i: 0..<s[0].state[0].message_count {
    mh := msg_h[i];
    msg_bottom := y + mh;
    // Virtualize: paint only messages intersecting the viewport.
    if msg_bottom >= top && y <= top + vp_h {
      id_n := cs_msg_id(s[0].state[0].messages[i].id, id_buf[..]);
      line_n := cs_msg_line(s[0].state[..], i, line_buf[..]);
      id := cast(string) id_buf[0..<id_n];
      line := cast(string) line_buf[0..<line_n];
      role := s[0].state[0].messages[i].role;
      body := cs_msg_body(s[0].state[..], i);
      _ := uiframe_semantic(f, id, EL_TEXT, line, px, y, pw, mh, 0, 0);

      role_label := ifx role == CHAT_ROLE_ASSISTANT then "assistant" else ifx role == CHAT_ROLE_SYSTEM then "system" else "you";
      role_color := ifx role == CHAT_ROLE_ASSISTANT then k.accent else k.muted;
      _ := sheet_text(f[0].sheet, f[0].m, -1, px, y, k.label.line, k.label.face, role_color, sheet_pool(f[0].sheet, role_label));
      cy := y + k.label.line + 4.0f32;

      if role == CHAT_ROLE_ASSISTANT {
        s[0].md_doc[0] = MdDoc.{};
        bn := md_parse(s[0].md_doc[..], body, 0);
        if bn > 0 {
          for b: 0..<bn {
            cy += markdown_block(f[0].sheet, f[0].m, k, s[0].md_doc[..], b, px, cy, pw);
            if b + 1 < bn { cy += k.md.block_gap; }
          }
        } else {
          _ := sheet_text(f[0].sheet, f[0].m, -1, px, cy, k.body.line, k.body.face, k.ink, sheet_pool(f[0].sheet, body));
        }
      } else {
        _ := sheet_text(f[0].sheet, f[0].m, -1, px, cy, k.body.line, k.body.face, k.ink, sheet_pool(f[0].sheet, body));
      }
    }
    y += mh;
  }

  // When scrolled away from bottom, expose jump-to-bottom control.
  if s[0].state[0].unpinned && scroll_max(total_h, vp_h) > 0 {
    jb_label := "Jump to bottom";
    jb_w := button_width(f[0].m, k, jb_label);
    jb_x := px + pw - jb_w;
    jb_y := top + vp_h - k.control_h - k.space;
    if jb_y < top { jb_y = top; }
    _ := ctx_button(f, "transcript.jump_bottom", jb_x, jb_y, jb_label, true, 0, CS_HIT_JUMP_BOTTOM);
  }
}

cs_render :: (s: [] ComposerScreen, out: [] f32, px_w: int, px_h: int, scale: f32, dt: f32, duplicate_id: bool) -> int {
  if s.count < 1 || px_w <= 0 || px_h <= 0 || scale <= 0 { return 0; }
  cs_init(s);
  a := s[0].atlas[..];
  sc := cs_scale(s);
  d := (ifx scale < 1 then 1.0f32 else scale) * sc;
  w := cast(f32) px_w / d;
  h := cast(f32) px_h / d;
  if d != s[0].d || w != s[0].width || h != s[0].height {
    s[0].dirty_composer = true;
    s[0].dirty_transcript = true;
  }
  s[0].d = d;
  s[0].width = w;
  s[0].height = h;
  if duplicate_id { s[0].dirty_composer = true; }
  // Frame redraws only when at least one surface is dirty or animating.
  if !s[0].dirty_composer && !s[0].dirty_transcript && !s[0].moving {
    return 0;
  }
  step := ifx dt > 0 && dt < 0.1 then dt else 0.016f32;
  if !s[0].reduced_motion { s[0].time += step; }
  a[0].frame += 1;
  k := ifx s[0].form_factor == CHAT_FORM_MOBILE then arcade_phone_skin() else arcade_skin();
  v := paint_quad(out, 0, d, 0, 0, w, h, 0, 0, k.canvas, k.canvas);
  if !a[0].ready { return v; }

  focus_id := ifx s[0].focused then "composer.input" else "";
  pressed_id := ifx s[0].pressed == CS_HIT_COMPOSER then "composer.input" else ifx s[0].pressed == CS_HIT_SEND then "composer.send" else ifx s[0].pressed == CS_HIT_JUMP_BOTTOM then "transcript.jump_bottom" else "";
  inp := uiinput(s[0].down_x, s[0].down_y, s[0].pressed != 0, s[0].pressed != 0, pressed_id, focus_id);

  moving := false;
  if s[0].dirty_transcript {
    tf: [1] UiFrame;
    uiframe_begin(tf[..], s[0].transcript[..], s[0].tkeyed[..], measure_font(a), k, inp, s[0].time, step, s[0].reduced_motion, s[0].reduced_transparency);
    cs_layout_transcript(s, tf[..], w, h);
    if uiframe_moving(tf[..]) { moving = true; }
    tb := 1 - s[0].transcript[0].front;
    if s[0].transcript[0].writing && s[0].transcript[0].rows[tb].renamed > 0 {
      s[0].transcript[0].rows[tb].lost += s[0].transcript[0].rows[tb].renamed;
    }
    if uiframe_end(tf[..], s[0].transcript[..]) {
      s[0].dirty_transcript = false;
      s[0].transcript_redraws += 1;
    }
  }

  if s[0].dirty_composer {
    f: [1] UiFrame;
    uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_font(a), k, inp, s[0].time, step, s[0].reduced_motion, s[0].reduced_transparency);
    cs_layout_composer(s, f[..], w, h, duplicate_id);
    if uiframe_moving(f[..]) { moving = true; }
    b := 1 - s[0].surface[0].front;
    if s[0].surface[0].writing && s[0].surface[0].rows[b].renamed > 0 {
      s[0].surface[0].rows[b].lost += s[0].surface[0].rows[b].renamed;
    }
    if uiframe_end(f[..], s[0].surface[..]) {
      s[0].dirty_composer = false;
      s[0].composer_redraws += 1;
    }
  }

  s[0].moving = moving;
  s[0].redraws += 1;

  tsh := surface_sheet(s[0].transcript[..]);
  v = gpu_draw(out, v, a, d, tsh.under[0..<tsh.nu], 0, 0, -8, h + 8);
  v = gpu_draw(out, v, a, d, tsh.over[0..<tsh.no], 0, 0, -8, h + 8);
  sh := surface_sheet(s[0].surface[..]);
  v = gpu_draw(out, v, a, d, sh.under[0..<sh.nu], 0, 0, -8, h + 8);
  v = gpu_draw(out, v, a, d, sh.over[0..<sh.no], 0, 0, -8, h + 8);
  gpu_monochrome(out, v);
  return v;
}

cs_pointer :: (s: [] ComposerScreen, x: f32, y: f32, phase: int) -> bool {
  if s.count < 1 || s[0].d <= 0 { return false; }
  ux := x / s[0].d;
  uy := y / s[0].d;
  s[0].down_x = ux;
  s[0].down_y = uy;
  if phase == 0 {
    row := surface_hit(s[0].surface[..], ux, uy);
    next_pressed := ifx row >= 0 then cs_rows(s).rows[row].action else 0;
    if next_pressed == 0 {
      trow := surface_hit(s[0].transcript[..], ux, uy);
      next_pressed = ifx trow >= 0 then cs_trows(s).rows[trow].action else 0;
    }
    if next_pressed != s[0].pressed {
      if next_pressed == CS_HIT_JUMP_BOTTOM || s[0].pressed == CS_HIT_JUMP_BOTTOM {
        s[0].dirty_transcript = true;
      } else {
        s[0].dirty_composer = true;
      }
    }
    s[0].pressed = next_pressed;
    return s[0].pressed != 0;
  }
  if phase == 2 {
    was := s[0].pressed;
    if s[0].pressed != 0 {
      if s[0].pressed == CS_HIT_JUMP_BOTTOM { s[0].dirty_transcript = true; } else { s[0].dirty_composer = true; }
    }
    s[0].pressed = 0;
    row := surface_hit(s[0].surface[..], ux, uy);
    hit := ifx row >= 0 then cs_rows(s).rows[row].action else 0;
    if hit == 0 {
      trow := surface_hit(s[0].transcript[..], ux, uy);
      hit = ifx trow >= 0 then cs_trows(s).rows[trow].action else 0;
    }
    if was == CS_HIT_COMPOSER && hit == CS_HIT_COMPOSER {
      if !s[0].focused { s[0].dirty_composer = true; }
      s[0].focused = true;
      return true;
    }
    if was == CS_HIT_SEND && hit == CS_HIT_SEND {
      res := cs_dispatch(s, ChatAction.{kind = CS_ACT_SEND});
      return res.accepted;
    }
    if was == CS_HIT_JUMP_BOTTOM && hit == CS_HIT_JUMP_BOTTOM {
      res := cs_dispatch(s, ChatAction.{kind = CS_ACT_JUMP_BOTTOM});
      return res.accepted;
    }
    if row < 0 {
      if s[0].focused { s[0].dirty_composer = true; }
      s[0].focused = false;
    }
    return false;
  }
  if phase == 3 {
    if s[0].pressed != 0 {
      if s[0].pressed == CS_HIT_JUMP_BOTTOM { s[0].dirty_transcript = true; } else { s[0].dirty_composer = true; }
    }
    s[0].pressed = 0;
    return false;
  }
  return false;
}

cs_scroll :: (s: [] ComposerScreen, delta_y: f32) -> bool {
  if s.count < 1 { return false; }
  res := cs_dispatch(s, ChatAction.{kind = CS_ACT_SCROLL, delta_y = delta_y});
  return res.accepted;
}

cs_activate :: (s: [] ComposerScreen, id: string) -> bool {
  if s.count < 1 { return false; }
  if cs_find(s, id) < 0 { return false; }
  if id == "composer.input" {
    if !s[0].focused { s[0].dirty_composer = true; }
    s[0].focused = true;
    return true;
  }
  if id == "composer.send" {
    res := cs_dispatch(s, ChatAction.{kind = CS_ACT_SEND});
    return res.accepted;
  }
  if id == "transcript.jump_bottom" {
    res := cs_dispatch(s, ChatAction.{kind = CS_ACT_JUMP_BOTTOM});
    return res.accepted;
  }
  return false;
}

cs_tree :: (s: [] ComposerScreen, out: [] u8) -> int {
  n := surface_tree(s[0].transcript[..], out);
  if n >= out.count { return n; }
  m := surface_tree(s[0].surface[..], out[n..<out.count]);
  return n + m;
}

cs_parse_int :: (s: string) -> int {
  if s.count == 0 { return 0; }
  neg := false;
  i := 0;
  if s[0] == '-' { neg = true; i = 1; }
  else if s[0] == '+' { i = 1; }
  v := 0;
  while i < s.count {
    c := s[i];
    if c < '0' || c > '9' { break; }
    v = v * 10 + cast(int) (c - '0');
    i += 1;
  }
  return ifx neg then -v else v;
}

// Shared coax drive handler: tree, counts, state draft|messages|send|pinned, type, tap, scroll.
cs_drive :: (s: [] ComposerScreen, op: string, out: [] u8) -> int {
  if s.count < 1 { return -1; }
  if op == "tree" { return cs_tree(s, out); }
  if op == "counts" { return uiframe_counts(s[0].surface[..], s[0].keyed[..], out); }
  if op.count > 6 && op[0..<6] == "state " {
    key := cast(string) op[6..<op.count];
    if key == "draft" {
      n := cs_out(out, cs_draft(s));
      return el_put(out, n, "\n");
    }
    if key == "messages" {
      if s[0].state[0].message_count == 0 { return cs_out(out, "\n"); }
      n := 0;
      line_buf: [CS_MSG_CAP + 16] u8;
      for i: 0..<s[0].state[0].message_count {
        ln := cs_msg_line(s[0].state[..], i, line_buf[..]);
        n = el_put(out, n, cast(string) line_buf[0..<ln]);
        n = el_put(out, n, "\n");
      }
      return n;
    }
    if key == "send" {
      return cs_out(out, ifx s[0].state[0].send_enabled then "enabled\n" else "disabled\n");
    }
    if key == "pinned" {
      return cs_out(out, ifx chat_state_pinned(s[0].state[..]) then "true\n" else "false\n");
    }
    return cs_out(out, "unknown state\n");
  }
  if op.count > 5 && op[0..<5] == "type " {
    rest := cast(string) op[5..<op.count];
    cut := 0;
    while cut < rest.count && rest[cut] != ' ' { cut += 1; }
    id := cast(string) rest[0..<cut];
    text := ifx cut < rest.count then cast(string) rest[cut + 1..<rest.count] else "";
    if id != "composer.input" || cs_find_composer(s, id) < 0 { return cs_out(out, "no such field\n"); }
    _ := cs_dispatch(s, ChatAction.{kind = CS_ACT_EDIT, text = text});
    return cs_out(out, "typed\n");
  }
  if op.count > 4 && op[0..<4] == "tap " {
    id := cast(string) op[4..<op.count];
    if cs_find(s, id) < 0 { return cs_out(out, "no such control\n"); }
    if id == "composer.input" {
      if !s[0].focused { s[0].dirty_composer = true; }
      s[0].focused = true;
      return cs_out(out, "tapped composer.input\n");
    }
    if id == "composer.send" {
      res := cs_dispatch(s, ChatAction.{kind = CS_ACT_SEND});
      if !res.accepted {
        return cs_out(out, "composer.send can't be pressed now\n");
      }
      return cs_out(out, "tapped composer.send\n");
    }
    if id == "transcript.jump_bottom" {
      res := cs_dispatch(s, ChatAction.{kind = CS_ACT_JUMP_BOTTOM});
      if !res.accepted {
        return cs_out(out, "transcript.jump_bottom can't be pressed now\n");
      }
      return cs_out(out, "tapped transcript.jump_bottom\n");
    }
    return cs_out(out, "can't be pressed now\n");
  }
  if op.count > 7 && op[0..<7] == "scroll " {
    rest := cast(string) op[7..<op.count];
    delta := cast(f32) cs_parse_int(rest);
    _ := cs_scroll(s, delta);
    return cs_out(out, "scrolled\n");
  }
  return -1;
}

CsOut :: struct { v: [CS_MAX_VERTICES * GP_VERTEX_FLOATS] f32; }

cs_test_atlas :: (a: [] Atlas) { text_test_atlas(a); gp_set_atlas(a, 4096, 4096, 2); }

#test "shared chapter 3: transcript markdown, scrolling, pin-to-bottom, and jump-to-bottom" #steps 400000000 {
  s: [1] ComposerScreen;
  o: [1] CsOut;
  cs_test_atlas(s[0].atlas[..]);
  s[0].form_factor = CHAT_FORM_DESKTOP;
  n0 := cs_render(s[..], o[0].v[..], 1280, 420, 1, 0.016, false);
  #assert n0 > 0 && chat_state_pinned(s[0].state[..]);

  // Typing dirties only composer.
  r1 := cs_dispatch(s[..], ChatAction.{kind = CS_ACT_EDIT, text = "hello"});
  #assert r1.accepted && r1.dirty_composer && !r1.dirty_transcript;
  #assert s[0].dirty_composer && !s[0].dirty_transcript;
  _ := cs_render(s[..], o[0].v[..], 1280, 420, 1, 0.016, false);
  #assert s[0].composer_redraws == 2 && s[0].transcript_redraws == 1;

  // Sending dirties both composer and transcript.
  r2 := cs_dispatch(s[..], ChatAction.{kind = CS_ACT_SEND});
  #assert r2.accepted && r2.dirty_composer && r2.dirty_transcript;
  #assert s[0].state[0].message_count == 1;
  _ := cs_render(s[..], o[0].v[..], 1280, 420, 1, 0.016, false);
  #assert cs_find_transcript(s[..], "transcript.list") >= 0;
  #assert cs_find_transcript(s[..], "message.1") >= 0;

  // Append several markdown assistant messages so content overflows the 420px viewport.
  for i: 0..<6 {
    ra := cs_dispatch(s[..], ChatAction.{kind = CS_ACT_APPEND, role = CHAT_ROLE_ASSISTANT, text = "# Heading\n\nBody with **bold** and `code`.\n\n- item one\n- item two"});
    #assert ra.accepted && !ra.dirty_composer && ra.dirty_transcript;
  }
  n2 := cs_render(s[..], o[0].v[..], 1280, 420, 1, 0.016, false);
  #assert n2 > 0;
  #assert s[0].state[0].content_h > s[0].state[0].viewport_h;
  #assert chat_state_pinned(s[0].state[..]);
  #assert s[0].state[0].scroll_y == scroll_max(s[0].state[0].content_h, s[0].state[0].viewport_h);
  #assert cs_find_transcript(s[..], "transcript.jump_bottom") < 0;

  // Scrolling up unpins the transcript and exposes transcript.jump_bottom.
  rs := cs_scroll(s[..], -120.0f32);
  #assert rs && !chat_state_pinned(s[0].state[..]);
  #assert !s[0].dirty_composer && s[0].dirty_transcript;
  _ := cs_render(s[..], o[0].v[..], 1280, 420, 1, 0.016, false);
  #assert cs_find_transcript(s[..], "transcript.jump_bottom") >= 0;

  // Appending while unpinned preserves scroll position and increments unread_below.
  prev_y := s[0].state[0].scroll_y;
  ra2 := cs_dispatch(s[..], ChatAction.{kind = CS_ACT_APPEND, role = CHAT_ROLE_ASSISTANT, text = "New reply while reading above"});
  #assert ra2.accepted && !chat_state_pinned(s[0].state[..]) && s[0].state[0].unread_below == 1;
  _ := cs_render(s[..], o[0].v[..], 1280, 420, 1, 0.016, false);
  #assert s[0].state[0].scroll_y == prev_y;

  // Jump to bottom re-pins, clears unread_below, and hides jump_bottom.
  rj := cs_dispatch(s[..], ChatAction.{kind = CS_ACT_JUMP_BOTTOM});
  #assert rj.accepted && chat_state_pinned(s[0].state[..]) && s[0].state[0].unread_below == 0;
  _ := cs_render(s[..], o[0].v[..], 1280, 420, 1, 0.016, false);
  #assert cs_find_transcript(s[..], "transcript.jump_bottom") < 0;
}
