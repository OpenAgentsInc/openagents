// Test-only measurement of app chrome, not transcript or authored content.
// Count visible English words; punctuation/glyphs and accessibility-only labels
// are not prose. Native fields display their accessible name as a placeholder.
#load "../../components/core/tree.coax";
copy_words :: (text:string)->int {
 n:=0;word:=false;for c:text {letter:=(c>='A' && c<='Z') || (c>='a' && c<='z') || (c>='0' && c<='9');if letter && !word {n+=1;}word=letter || (word && (c=='\'' || c=='-'));}return n;
}
copy_tree_words :: (t:[]Tree,root:string)->int {
 n:=0;at:=ifx root.count>0 then tr_find(t,root) else -1;
 for i:0..<t[0].n {
  inside:=at<0;hidden:=false;j:=i;while j>=0 {if j==at {inside=true;}if tr_attr_of(t,j,AT_HIDDEN)=="true" {hidden=true;}j=t[0].nodes[j].parent;}
  if !inside || hidden {continue;}
  if t[0].nodes[i].has_text {n+=copy_words(tr_text_of(t,i));}
  if t[0].nodes[i].tag==TG_INPUT || t[0].nodes[i].tag==TG_TEXTAREA {n+=copy_words(tr_attr_of(t,i,AT_LABEL));}
 }return n;
}
#test "copy counts prose and field names, excluding icon and screen-reader labels" {
 t:[1]Tree;tr_begin(t[..]);x:=tr_leaf(t[..],"text",TG_P,"","Read-only · 5h left");x=tr_open(t[..],"icon",TG_BUTTON,"ib");tr_attr(t[..],x,AT_LABEL,"Refresh all conversations");tr_close(t[..]);x=tr_open(t[..],"field",TG_INPUT,"");tr_attr(t[..],x,AT_LABEL,"Email address");tr_close(t[..]);
 #assert copy_tree_words(t[..],"")==5 && copy_words("‹ › ↻ …")==0;
}
