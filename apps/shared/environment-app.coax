// Shared environment application state and actions. Its drawing, on the tree kit, is
// environment-render.coax: only the desktop loads it, so a phone never loads the tree kit.
// Installed hosts provide authenticated HTTP, random command IDs and a timer.
#load "../../coax/lib/agent/environment/wire.coax";
#load "../../coax/lib/nostr/json.coax";
#load "../../components/core/tree.coax";       // tr_hash, tr_join: row IDs (environment-render.coax draws)
#load "../../components/core/elements.coax";   // el_put

EnvironmentApp :: struct {
  active:bool;local:bool;page:int;catalog:[1]EaCatalog;view:[1]EaView;request:[1]EaRequest;
  selected:int= -1;session:[128]u8;ns:int;flight:bool;random:bool;timer:bool;uncertain:bool;retry_wait:int;
  action:int;body:[131072]u8;nb:int;draft:[16384]u8;nd:int;note:[512]u8;nn:int;
  // The computer's last offer and the person's model/effort choice (empty:
  // the open conversation's, else the computer's default). menu: 1 model, 2 effort.
  offer:[1]EaOffer;model:[64]u8;nmo:int;effort:[16]u8;nef:int;menu:int;
  expanded:[64]int;expanded_n:int;history_before:int;sync_requested:bool;paused:bool;workspace:bool;
  // The folders the computer last offered (DescribeEnvironment, ListSessions) and the one a new
  // session opens in (nfo 0: the workspace itself). An older computer offers none and gets none.
  // A computer that names its workspace (root) offers the projects in it; an older one, subfolders.
  folders:[EA_FOLDERS]EaFolder;nfolders:int;folder:[EA_FOLDER]u8;nfo:int;root:[EA_FOLDER]u8;nroot:int;
  // The newest StopSubagent (GitHub #13776): the item of the call that started its sub-agent, where
  // it stands (EU_SUB_*) and, refused, the computer's code. A sub-agent's page reads it.
  stop_item:[128]u8;nstop_item:int;stop_state:int;stop_error:[32]u8;nstop_error:int;
}
EU_SUB_SENDING::1;EU_SUB_ACCEPTED::2;EU_SUB_UNSURE::3;EU_SUB_REFUSED::4;
// Stops one sub-agent of the open Coder Desktop chat's running turn (StopSubagent, GitHub #13776):
// item is the ReadSession item of the call that started it. The write has its own command
// identity, as Stop does. False when nothing goes: another write is out or unsure, or the open
// conversation is not a running Coder Desktop chat.
eu_stop_subagent :: (e:[]EnvironmentApp,item:string)->bool #effects(all) {
  if e[0].flight || e[0].random || e[0].uncertain || e[0].action!=0 || item.count<1 || item.count>128 {return false;}
  k:=eu_current(e);if k<0 || !e[0].view[0].sessions[k].desktop || !e[0].view[0].sessions[k].busy {return false;}
  eu_mutate(e,"StopSubagent",false);if !e[0].random {return false;}
  e[0].request[0].nit=ea_copy(e[0].request[0].item[..],item);e[0].nstop_item=ea_copy(e[0].stop_item[..],item);e[0].stop_state=EU_SUB_SENDING;e[0].nstop_error=0;return true;
}
// Where the newest StopSubagent landed, when the request is one.
eu_sub_settle :: (e:[]EnvironmentApp,state:int,code:string) #effects(all) {
  if cast(string)e[0].request[0].method[0..<e[0].request[0].nm]!="StopSubagent" {return;}
  e[0].stop_state=state;e[0].nstop_error=ea_copy(e[0].stop_error[..],ifx code.count>32 then cast(string)code[0..<32] else code);if e[0].nstop_error<0 {e[0].nstop_error=0;}
}
#test "a running Coder Desktop chat stops one sub-agent under its own command, and says where it landed (#13776)" {
  e:[1]EnvironmentApp;e[0].active=true;e[0].page=2;e[0].selected=0;e[0].catalog[0].n=1;
  h:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";n:=ea_copy(e[0].catalog[0].entries[0].host[..],h);
  e[0].ns=ea_copy(e[0].session[..],"desktop-0123456789abcdef0123456789abcdef");e[0].view[0].ns=1;row:=e[0].view[0].sessions[..];
  row[0].ni=ea_copy(row[0].id[..],"desktop-0123456789abcdef0123456789abcdef");row[0].busy=true;row[0].desktop=false;row[0].generation=7;
  #assert !eu_stop_subagent(e[..],"3:0") && !e[0].random;   // a chat that is not Coder Desktop's has no such stop
  row[0].desktop=true;#assert !eu_stop_subagent(e[..],"") && eu_stop_subagent(e[..],"3:0");
  q:=e[0].request[..];#assert e[0].random && e[0].action==11 && cast(string)q[0].method[0..<q[0].nm]=="StopSubagent" && cast(string)q[0].item[0..<q[0].nit]=="3:0" && q[0].generation==7 && e[0].stop_state==EU_SUB_SENDING;
  #assert !eu_stop_subagent(e[..],"5:0");   // one write at a time
  e[0].action=0;eu_reply(e[..],11,0,"{\"command_id\":\"11111111111111111111111111111111\",\"session_id\":\"\",\"now_ms\":1700000000000}",false);
  #assert e[0].flight && e[0].action==4 && e[0].request[0].nit==3;
  // a lost reply leaves it unsure; the computer's refusal says why
  e[0].action=0;eu_reply(e[..],4,0,"",true);#assert e[0].uncertain && e[0].stop_state==EU_SUB_UNSURE;
  e[0].uncertain=false;e[0].flight=true;e[0].stop_state=EU_SUB_SENDING;
  v:[1]EaView;v[0].nh=ea_copy(v[0].host[..],h);v[0].nm=ea_copy(v[0].method[..],"StopSubagent");v[0].ne=ea_copy(v[0].error[..],"conflict");b:[8192]u8;w:=ea_view_write(v[..],b[..]);
  eu_reply(e[..],4,200,cast(string)b[0..<w],false);#assert e[0].stop_state==EU_SUB_REFUSED && cast(string)e[0].stop_error[0..<e[0].nstop_error]=="conflict" && e[0].view[0].ns==1;
  e[0].flight=true;v[0].ne=0;v[0].nq=ea_copy(v[0].command[..],"11111111111111111111111111111111");v[0].nt=ea_copy(v[0].status[..],"accepted");w=ea_view_write(v[..],b[..]);
  eu_reply(e[..],4,200,cast(string)b[0..<w],false);#assert e[0].stop_state==EU_SUB_ACCEPTED && e[0].nstop_error==0;
}
// The folder a new session asks for: the chosen one while the computer still offers it, else "".
eu_folder :: (e:[]EnvironmentApp)->string #effects(all) {
  want:=cast(string)e[0].folder[0..<e[0].nfo];if want.count==0 {return "";}
  for i:0..<e[0].nfolders {if cast(string)e[0].folders[i].path[0..<e[0].folders[i].np]==want {return want;}}return "";
}
eu_take_folders :: (e:[]EnvironmentApp,v:[]EaView) #effects(all) {e[0].nfolders=v[0].nfolders;for i:0..<v[0].nfolders {e[0].folders[i]=v[0].folders[i];}e[0].nroot=v[0].nroot;for i:0..<v[0].nroot {e[0].root[i]=v[0].root[i];}}
#test "a computer's workspace name and folders replace the ones it offered before, each from its first byte" {
 e:[1]EnvironmentApp;e[0].nfolders=1;e[0].folders[0].np=ea_copy(e[0].folders[0].path[..],"old");e[0].nroot=ea_copy(e[0].root[..],"zip");
 v:[1]EaView;v[0].nroot=ea_copy(v[0].root[..],"work");v[0].nfolders=2;
 v[0].folders[0].np=ea_copy(v[0].folders[0].path[..],"apps");v[0].folders[1].np=ea_copy(v[0].folders[1].path[..],"docs");
 eu_take_folders(e[..],v[..]);
 #assert e[0].nroot==4 && cast(string)e[0].root[0..<4]=="work" && e[0].nfolders==2;
 #assert cast(string)e[0].folders[0].path[0..<e[0].folders[0].np]=="apps" && cast(string)e[0].folders[1].path[0..<e[0].folders[1].np]=="docs";
 // an older computer names none and offers none: the old ones go
 z:[1]EaView;eu_take_folders(e[..],z[..]);#assert e[0].nroot==0 && e[0].nfolders==0;
}
#test "a new session names the chosen folder only while the computer offers it" {
 e:[1]EnvironmentApp;e[0].active=true;e[0].nd=ea_copy(e[0].draft[..],"hello");e[0].nfo=ea_copy(e[0].folder[..],"apps");
 eu_mutate(e[..],"OpenSession",false);#assert e[0].request[0].nf==0;   // an older computer offered none: no folder
 e[0].random=false;e[0].action=0;e[0].nfolders=1;e[0].folders[0].np=ea_copy(e[0].folders[0].path[..],"apps");
 eu_mutate(e[..],"OpenSession",false);#assert cast(string)e[0].request[0].folder[0..<e[0].request[0].nf]=="apps";
 e[0].random=false;e[0].action=0;eu_mutate(e[..],"SendMessage",false);#assert e[0].request[0].nf==0;
}
#test "history navigation pauses polling without replacing an uncertain command" {
 e:[1]EnvironmentApp;e[0].active=true;e[0].timer=true;e[0].uncertain=true;e[0].request[0].nc=ea_copy(e[0].request[0].command[..],"01234567890123456789012345678901");
 eu_pause(e[..],true);eu_reply(e[..],12,0,"{}",false);
 #assert e[0].paused && !e[0].timer && e[0].action==0 && e[0].uncertain && e[0].request[0].nc==32;
}
eu_wait :: (e:[]EnvironmentApp) #effects(all) {
 running:=false;for i:0..<e[0].view[0].ns {s:=e[0].view[0].sessions[i];if cast(string)s.id[0..<s.ni]==cast(string)e[0].session[0..<e[0].ns] {running=s.busy;}}
 retry:=e[0].uncertain && eu_read_retry(e);
 if !e[0].paused && e[0].active && !e[0].flight && !e[0].random && ((!e[0].uncertain && e[0].page==2 && e[0].ns>0 && e[0].history_before==0) || retry) && !e[0].timer && e[0].action==0 {e[0].timer=true;e[0].action=12;e[0].nb=ea_copy(e[0].body[..],"{}");}
}
eu_read_retry :: (e:[]EnvironmentApp)->bool #effects(all) {m:=cast(string)e[0].request[0].method[0..<e[0].request[0].nm];return m=="ReadSession" || m=="ListSessions" || m=="DescribeEnvironment";}
#test "mobile reconnect retries only the original read and never a pending write" {
 e:[1]EnvironmentApp;e[0].active=true;e[0].workspace=true;e[0].page=2;e[0].selected=0;e[0].catalog[0].n=1;e[0].uncertain=true;
 eu_request(e[..],"ReadSession");e[0].request[0].before=42;eu_wait(e[..]);#assert e[0].timer && e[0].action==12;e[0].action=0;
 eu_reply(e[..],12,0,"{}",false);#assert e[0].flight && e[0].request[0].before==42 && e[0].action==4 && !e[0].uncertain;
 e[0].flight=false;e[0].action=0;e[0].uncertain=true;eu_request(e[..],"SendMessage");eu_wait(e[..]);#assert !e[0].timer && e[0].action==0 && e[0].uncertain;
}
eu_pause :: (e:[]EnvironmentApp,on:bool) #effects(all) {e[0].paused=on;if on && e[0].action==12 {e[0].action=0;e[0].timer=false;}if !on {eu_wait(e);}}
eu_item_key :: (v:[]EaView,i:int)->int #effects(all) {m:=v[0].items[i];return tr_hash(cast(string)m.id[0..<m.ni]);}
eu_item_id :: (v:[]EaView,i:int,out:[]u8)->string #effects(all) {return tr_join(out,"environment.message.",eu_item_key(v,i));}
eu_tool_open :: (e:[]EnvironmentApp,key:int)->bool #effects(all) {for i:0..<e[0].expanded_n {if e[0].expanded[i]==key {return true;}}return false;}
#test "reading earlier history is not replaced by a polling timer" {
  e:[1]EnvironmentApp;e[0].active=true;e[0].page=2;e[0].ns=1;e[0].timer=true;e[0].history_before=1000001;
  eu_reply(e[..],12,0,"{}",false);#assert e[0].action==0 && !e[0].flight && !e[0].timer;
}
#test "environment sends retain their command across timeout and never mint on retry" {
  e:[1]EnvironmentApp;e[0].active=true;e[0].page=2;e[0].selected=0;e[0].catalog[0].n=1;
  h:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";n:=ea_copy(e[0].catalog[0].entries[0].host[..],h);e[0].nd=ea_copy(e[0].draft[..],"hello");
  eu_press(e[..],"env.composer.send");#assert e[0].action==11 && e[0].random;
  e[0].action=0;eu_reply(e[..],11,0,"{\"command_id\":\"11111111111111111111111111111111\",\"session_id\":\"22222222222222222222222222222222\",\"now_ms\":1700000000000}",false);
  #assert e[0].action==4 && e[0].request[0].nc==32 && e[0].flight;
  e[0].action=0;eu_reply(e[..],4,0,"",true);#assert e[0].uncertain && e[0].nd==5;
  eu_press(e[..],"env.composer.send");#assert e[0].action==0 && !e[0].random;
  eu_press(e[..],"env.reconnect");#assert e[0].action==4 && e[0].request[0].command[0]=='1';
}
#test "a running Coder Desktop chat takes words as a steer and an empty Send as Stop; any other running chat only stops (#13713)" {
  e:[1]EnvironmentApp;e[0].active=true;e[0].page=2;e[0].selected=0;e[0].catalog[0].n=1;
  e[0].ns=ea_copy(e[0].session[..],"desktop-0123456789abcdef0123456789abcdef");e[0].view[0].ns=1;row:=e[0].view[0].sessions[..];
  row[0].ni=ea_copy(row[0].id[..],"desktop-0123456789abcdef0123456789abcdef");row[0].busy=true;row[0].desktop=true;
  e[0].nd=ea_copy(e[0].draft[..],"use b");eu_press(e[..],"env.composer.send");#assert e[0].random && cast(string)e[0].request[0].method[0..<e[0].request[0].nm]=="SendMessage" && ea_text(cast(string)e[0].request[0].text[0..<e[0].request[0].nt]);
  e[0].random=false;e[0].action=0;eu_press(e[..],"env.composer.stop");#assert cast(string)e[0].request[0].method[0..<e[0].request[0].nm]=="StopTurn";
  e[0].random=false;e[0].action=0;e[0].nd=0;eu_press(e[..],"env.composer.send");#assert cast(string)e[0].request[0].method[0..<e[0].request[0].nm]=="StopTurn";
  e[0].random=false;e[0].action=0;row[0].desktop=false;e[0].nd=ea_copy(e[0].draft[..],"use b");eu_press(e[..],"env.composer.send");#assert cast(string)e[0].request[0].method[0..<e[0].request[0].nm]=="StopTurn";
  e[0].random=false;e[0].action=0;row[0].busy=false;eu_press(e[..],"env.composer.stop");#assert !e[0].random && e[0].action==0;
}
#test "a detached environment ignores late timers and identity replies" {
  e:[1]EnvironmentApp;e[0].timer=true;e[0].random=true;
  eu_reply(e[..],12,0,"{}",false);eu_reply(e[..],11,0,"{}",false);#assert e[0].action==0 && !e[0].flight;
}
eu_error :: (code:string)->string #effects(all) {
  if code=="forbidden" {return "Connection revoked. Reconnect on desktop.";}
  if code=="conflict" {return "Chat changed. Refresh first.";}
  if code=="capacity" {return "Chat limit reached. Open an existing chat.";}
  if code=="record_limit" {return "History full. Turn stopped. Start another chat.";}
  if code=="storage_unavailable" {return "Couldn't save command. No turn started.";}
  if code=="expired" {return "Command expired. Refresh first.";}
  if code=="stale_cursor" {return "History expired. Refresh.";}
  if code=="not_found" {return "Chat unavailable on this computer.";}
  if code=="model_unavailable" {return "Model/effort unavailable. Choose another.";}
  if code=="no_agent" {return "No agent can run on this computer. Set one up on it first.";}
  return "Request failed. Refresh to check.";
}
#test "each refusal code a computer sends has its own words, and an unknown one asks for a refresh" {
  codes:=[10]string.["forbidden","conflict","capacity","record_limit","storage_unavailable","expired","stale_cursor","not_found","model_unavailable","no_agent"];
  // each code's words, and no two codes share them
  for c,i:codes {#assert eu_error(c)!="Request failed. Refresh to check.";for d,k:codes {if k!=i {#assert eu_error(c)!=eu_error(d);}}}
  #assert eu_error("forbidden")=="Connection revoked. Reconnect on desktop." && eu_error("no_agent")=="No agent can run on this computer. Set one up on it first.";
  #assert eu_error("")=="Request failed. Refresh to check." && eu_error("other")=="Request failed. Refresh to check.";
}
eu_note :: (e:[]EnvironmentApp,text:string) #effects(all) {e[0].nn=ea_copy(e[0].note[..],text);}
// The open conversation's summary, or -1.
eu_current :: (e:[]EnvironmentApp)->int #effects(all) {
  for i:0..<e[0].view[0].ns {s:=e[0].view[0].sessions[i];if e[0].ns>0 && cast(string)s.id[0..<s.ni]==cast(string)e[0].session[0..<e[0].ns] {return i;}}return -1;
}
// The offered model a turn runs on: the person's choice, else the open
// conversation's, else the computer's default (first); -1 with no offer.
eu_model :: (e:[]EnvironmentApp)->int #effects(all) {
  o:=e[0].offer[..];if o[0].n==0 {return -1;}id:=cast(string)e[0].model[0..<e[0].nmo];
  c:=eu_current(e);if id.count==0 && c>=0 {s:=e[0].view[0].sessions[c];id=cast(string)e[0].view[0].sessions[c].model[0..<s.nmo];}
  for i:0..<o[0].n {m:=o[0].models[i];if cast(string)o[0].models[i].id[0..<m.ni]==id {return i;}}return 0;
}
// Its effort level: the chosen one when the model takes it, else the
// conversation's, else the default, else the model's last; -1 for none.
eu_level :: (e:[]EnvironmentApp,m:int)->int #effects(all) {
  o:=e[0].offer[..];if m<0 || m>=o[0].n || o[0].models[m].ladder==0 {return -1;}ladder:=o[0].models[m].ladder;
  c:=eu_current(e);want:=cast(string)e[0].effort[0..<e[0].nef];
  if want.count==0 && c>=0 {s:=e[0].view[0].sessions[c];want=cast(string)e[0].view[0].sessions[c].effort[0..<s.nef];}
  for i:0..<o[0].nv {l:=o[0].levels[i];if (ladder&(1<<i))!=0 && cast(string)o[0].levels[i].id[0..<l.ni]==want {return i;}}
  d:=o[0].default_level;if d>=0 && (ladder&(1<<d))!=0 {return d;}
  last:= -1;for i:0..<o[0].nv {if (ladder&(1<<i))!=0 {last=i;}}return last;
}
eu_http :: (e:[]EnvironmentApp,catalog:bool) #effects(all) {
  if e[0].flight || e[0].action!=0 {return;}
  if !catalog && cast(string)e[0].request[0].method[0..<e[0].request[0].nm]=="StopSubagent" {e[0].stop_state=EU_SUB_SENDING;}
  if e[0].local {n:=ea_write(e[0].request[..],e[0].body[..]);if n>0 {e[0].nb=n;e[0].action=14;e[0].flight=true;}return;}
  path:[512]u8;n:=0;wire:[24576]u8;nw:=0;
  if catalog {n=el_put(path[..],0,"/api/chat/environments/v1");}
  else {
    if e[0].selected<0 || e[0].selected>=e[0].catalog[0].n {return;}
    n=el_put(path[..],0,"/api/chat/environment/v1?host=");n=el_put(path[..],n,cast(string)e[0].catalog[0].entries[e[0].selected].host[..]);nw=ea_write(e[0].request[..],wire[..]);if nw<1 {return;}
  }
  read:=!catalog && ea_right(cast(string)e[0].request[0].method[0..<e[0].request[0].nm])==0;
  if read {n=el_put(path[..],n,"&method=");n=el_put(path[..],n,cast(string)e[0].request[0].method[0..<e[0].request[0].nm]);n=el_put(path[..],n,"&session=");n=el_put(path[..],n,cast(string)e[0].request[0].session[0..<e[0].request[0].ns]);n=el_put(path[..],n,"&before=");n=json_write_int(path[..],n,e[0].request[0].before);}
  o:[1]Jo;jo_start(o[..],e[0].body[..]);jo_obj(o[..]);jo_key(o[..],"path");jo_str(o[..],cast(string)path[0..<n]);jo_key(o[..],"method");jo_str(o[..],ifx catalog || read then "GET" else "POST");
  if !catalog && !read {jo_key(o[..],"body");jo_str(o[..],cast(string)wire[0..<nw]);}jo_end(o[..]);
  if o[0].bad {eu_note(e,"Request exceeds the installed limit.");return;}e[0].nb=o[0].n;e[0].action=4;e[0].flight=true;
}
eu_enter :: (e:[]EnvironmentApp) #effects(all) {e[0]=EnvironmentApp.{};e[0].active=true;eu_http(e,true);}
eu_enter_local :: (e:[]EnvironmentApp) #effects(all) {
  e[0]=EnvironmentApp.{};e[0].active=true;e[0].local=true;e[0].selected=0;e[0].catalog[0].n=1;e[0].page=1;
  eu_request(e,"DescribeEnvironment");eu_http(e,false);
}
eu_request :: (e:[]EnvironmentApp,method:string) #effects(all) {
  q:=e[0].request[..];q[0]=EaRequest.{};q[0].nm=ea_copy(q[0].method[..],method);q[0].nw=ea_copy(q[0].workspace[..],"default");q[0].ns=ea_copy(q[0].session[..],cast(string)e[0].session[0..<e[0].ns]);
  for i:0..<e[0].view[0].ns {s:=e[0].view[0].sessions[i];if cast(string)s.id[0..<s.ni]==cast(string)e[0].session[0..<e[0].ns] {q[0].generation=s.generation;q[0].revision=s.revision;q[0].ni=ea_copy(q[0].interaction[..],cast(string)s.interaction[0..<s.nr]);}}
}
eu_mutate :: (e:[]EnvironmentApp,method:string,allow:bool) #effects(all) {
  if e[0].flight || e[0].random || e[0].uncertain || e[0].action!=0 {return;}
  eu_request(e,method);q:=e[0].request[..];q[0].allow=allow;
  if method=="OpenSession" || method=="SendMessage" {
    if !ea_text(cast(string)e[0].draft[0..<e[0].nd]) {return;}q[0].nt=ea_copy(q[0].text[..],cast(string)e[0].draft[0..<e[0].nd]);
    // Each turn names its model and effort when the computer offers them; an older one gets neither.
    m:=eu_model(e);l:=eu_level(e,m);o:=e[0].offer[..];
    if m>=0 {q[0].nmo=ea_copy(q[0].model[..],cast(string)o[0].models[m].id[0..<o[0].models[m].ni]);}
    if l>=0 {q[0].nef=ea_copy(q[0].effort[..],cast(string)o[0].levels[l].id[0..<o[0].levels[l].ni]);}
    f:=eu_folder(e);if method=="OpenSession" && f.count>0 {q[0].nf=ea_copy(q[0].folder[..],f);}
  }
  e[0].random=true;e[0].action=11;e[0].nb=ea_copy(e[0].body[..],"{}");
}
eu_reply :: (e:[]EnvironmentApp,op:int,status:int,raw:string,failed:bool) #effects(all) {
  if !e[0].active {return;}
  if op==12 {
    if !e[0].timer {return;}e[0].timer=false;
    if !e[0].paused && e[0].uncertain && eu_read_retry(e) && !e[0].flight && !e[0].random {
      if e[0].retry_wait>0 {e[0].retry_wait-=1;return;}
      e[0].uncertain=false;eu_http(e,e[0].selected<0);return;
    }
    if !e[0].paused && !e[0].flight && !e[0].random && !e[0].uncertain && e[0].page==2 && e[0].ns>0 && e[0].history_before==0 {eu_request(e,"ReadSession");eu_http(e,false);}return;
  }
  if op==11 {
    if !e[0].random {return;}e[0].random=false;
    nodes:[16]JvNode;d:[1]Jv;q:=e[0].request[..];
    if failed || !jv_parse(d[..],raw,nodes[..]) {eu_note(e,"Could not create a command identity.");eu_sub_settle(e,EU_SUB_REFUSED,"identity");return;}
    q[0].nc=jv_str(d[0],jv_get(d[0],0,"command_id"),q[0].command[..]);
    q[0].issued=jv_int(d[0],jv_get(d[0],0,"now_ms"),0);q[0].expires=ea_deadline(q[0].issued);
    if cast(string)q[0].method[0..<q[0].nm]=="OpenSession" {q[0].ns=jv_str(d[0],jv_get(d[0],0,"session_id"),q[0].session[..]);}
    if q[0].nc!=32 || !ea_id(cast(string)q[0].command[..],32) || q[0].ns<1 || q[0].expires<=0 {eu_note(e,"Invalid command identity.");eu_sub_settle(e,EU_SUB_REFUSED,"identity");return;}
    eu_http(e,false);return;
  }
  if (op!=4 && op!=14) || !e[0].flight {return;}e[0].flight=false;e[0].sync_requested=false;
  if failed || status!=200 {
    e[0].uncertain=true;e[0].retry_wait=4;eu_note(e,ifx ea_right(cast(string)e[0].request[0].method[0..<e[0].request[0].nm])>0 then "Offline · command pending" else "Offline");eu_sub_settle(e,EU_SUB_UNSURE,"");return;
  }
  if e[0].selected<0 {if !ea_catalog_read(raw,e[0].catalog[..]) {eu_note(e,"Unreadable environment list.");return;}e[0].uncertain=false;eu_note(e,"");return;}
  next:[1]EaView;
  if e[0].local && cast(string)e[0].request[0].method[0..<e[0].request[0].nm]=="DescribeEnvironment" && ea_view_read(raw,next[..]) {
    e[0].catalog[0].entries[0].host=next[0].host;e[0].catalog[0].entries[0].nl=ea_copy(e[0].catalog[0].entries[0].label[..],"This computer");eu_take_folders(e,next[..]);
    eu_request(e,"ListSessions");eu_http(e,false);return;
  }
  if !ea_view_read(raw,next[..]) || cast(string)next[0].host[..]!=cast(string)e[0].catalog[0].entries[e[0].selected].host[..] {eu_note(e,"The reply did not match this computer.");e[0].uncertain=true;eu_sub_settle(e,EU_SUB_UNSURE,"");return;}
  if cast(string)next[0].method[0..<next[0].nm]!=cast(string)e[0].request[0].method[0..<e[0].request[0].nm] || (next[0].nt>0 && (next[0].nq!=e[0].request[0].nc || cast(string)next[0].command[0..<next[0].nq]!=cast(string)e[0].request[0].command[0..<e[0].request[0].nc])) {eu_note(e,"The reply did not match this request.");e[0].uncertain=true;eu_sub_settle(e,EU_SUB_UNSURE,"");return;}
  // a sub-agent's refused stop is its page's to say: the chat keeps what it shows and goes on being read
  if next[0].ne>0 && cast(string)e[0].request[0].method[0..<e[0].request[0].nm]=="StopSubagent" {e[0].uncertain=false;eu_sub_settle(e,EU_SUB_REFUSED,cast(string)next[0].error[0..<next[0].ne]);eu_wait(e);return;}
  e[0].view[0]=next[0];e[0].uncertain=false;if next[0].offer.n>0 {e[0].offer[0]=next[0].offer;}
  if next[0].ne>0 {eu_note(e,eu_error(cast(string)next[0].error[0..<next[0].ne]));return;}
  eu_sub_settle(e,EU_SUB_ACCEPTED,"");
  q:=e[0].request[..];method:=cast(string)q[0].method[0..<q[0].nm];
  if method=="DescribeEnvironment" || (method=="ListSessions" && q[0].before==0) {eu_take_folders(e,next[..]);}
  if method=="OpenSession" {e[0].ns=ea_copy(e[0].session[..],cast(string)q[0].session[0..<q[0].ns]);e[0].page=2;}
  if (method=="OpenSession" || method=="SendMessage") && cast(string)next[0].status[0..<next[0].nt]=="accepted" {e[0].nd=0;}
  eu_note(e,ifx cast(string)next[0].status[0..<next[0].nt]=="unknown" then "Outcome unknown · not retried" else "");
  eu_wait(e);
}
eu_press :: (e:[]EnvironmentApp,id:string) #effects(all) {
  if id=="env.choices.close" {e[0].menu=0;return;}
  if id=="env.latest" {eu_press(e,"env.refresh");return;}
  for i:0..<e[0].view[0].ni {m:=e[0].view[0].items[i];b:[96]u8;if (m.nk>0 || cast(string)m.role[0..<m.nr]=="tool") && id==eu_item_id(e[0].view[..],i,b[..]) {
    key:=eu_item_key(e[0].view[..],i);for k:0..<e[0].expanded_n {if e[0].expanded[k]==key {e[0].expanded_n-=1;e[0].expanded[k]=e[0].expanded[e[0].expanded_n];return;}}
    if e[0].expanded_n<64 {e[0].expanded[e[0].expanded_n]=key;e[0].expanded_n+=1;}return;
  }}
  if id=="env.reconnect" {e[0].uncertain=false;eu_http(e,e[0].selected<0);return;}
  if id=="env.new" && !e[0].flight && !e[0].random {e[0].ns=0;e[0].nd=0;e[0].page=2;e[0].menu=0;e[0].expanded_n=0;e[0].history_before=0;e[0].view[0]=EaView.{};return;}
  if id=="env.model" || id=="env.effort" {want:=ifx id=="env.model" then 1 else 2;e[0].menu=ifx e[0].menu==want then 0 else want;return;}
  o:=e[0].offer[..];
  for i:0..<o[0].n {b:[96]u8;if id==tr_join(b[..],"env.model.",i) {m:=o[0].models[i];e[0].nmo=ea_copy(e[0].model[..],cast(string)o[0].models[i].id[0..<m.ni]);e[0].menu=0;return;}}
  for i:0..<o[0].nv {b:[96]u8;if id==tr_join(b[..],"env.effort.",i) {l:=o[0].levels[i];e[0].nef=ea_copy(e[0].effort[..],cast(string)o[0].levels[i].id[0..<l.ni]);e[0].menu=0;return;}}
  if id=="env.sessions" && !e[0].flight && !e[0].random {e[0].page=1;eu_request(e,"ListSessions");eu_http(e,false);return;}
  if id=="env.refresh" && !e[0].flight && !e[0].random {
    e[0].sync_requested=true;
    if e[0].uncertain {e[0].uncertain=false;eu_http(e,e[0].selected<0);return;}
    e[0].history_before=0;eu_request(e,ifx e[0].page==1 then "ListSessions" else "ReadSession");eu_http(e,false);return;
  }
  if (id=="env.earlier" || id=="env.more") && !e[0].flight && !e[0].random {cursor:=cast(string)e[0].view[0].cursor[0..<e[0].view[0].nc];before:=0;for c:cursor {if c<'0' || c>'9' {return;}before=before*10+cast(int)(c-'0');}if before>0 {eu_request(e,ifx id=="env.more" then "ListSessions" else "ReadSession");e[0].request[0].before=before;if id=="env.earlier" {e[0].history_before=before;}eu_http(e,false);}return;}
  for i:0..<e[0].catalog[0].n {b:[96]u8;if id==tr_join(b[..],"environment.",i) && !e[0].flight {e[0].selected=i;e[0].page=1;eu_request(e,"ListSessions");eu_http(e,false);return;}}
  for i:0..<e[0].view[0].ns {b:[96]u8;if id==tr_join(b[..],"environment.session.",i) && !e[0].flight {row:=e[0].view[0].sessions[i];e[0].ns=ea_copy(e[0].session[..],cast(string)row.id[0..<row.ni]);e[0].nmo=0;e[0].nef=0;e[0].menu=0;e[0].expanded_n=0;e[0].history_before=0;e[0].page=2;eu_request(e,"ReadSession");eu_http(e,false);return;}}
  // A Coder Desktop chat's running turn takes more input (GitHub #13713): with words in the
  // composer Send steers it; with none it stops it. env.composer.stop always stops.
  if id=="env.composer.send" || id=="env.composer.stop" {
    busy:=false;steer:=false;for i:0..<e[0].view[0].ns {row:=e[0].view[0].sessions[i];if cast(string)row.id[0..<row.ni]==cast(string)e[0].session[0..<e[0].ns] {busy=row.busy;steer=row.desktop && id=="env.composer.send" && ea_text(cast(string)e[0].draft[0..<e[0].nd]);}}
    if id=="env.composer.stop" && !busy {return;}
    eu_mutate(e,ifx busy && !steer then "StopTurn" else ifx e[0].ns==0 then "OpenSession" else "SendMessage",false);return;
  }
  if id=="env.allow" || id=="env.deny" {eu_mutate(e,"RespondInteraction",id=="env.allow");}
}
