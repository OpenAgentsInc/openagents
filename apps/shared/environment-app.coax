// Shared environment application state/actions and component composition.
// Installed hosts provide authenticated HTTP, random command IDs and a timer.
#load "../../coax/lib/agent/environment/wire.coax";
#load "../../coax/lib/nostr/json.coax";
#load "../../components/kit/frames.coax";

EnvironmentApp :: struct {
  active:bool;local:bool;page:int;catalog:[1]EaCatalog;view:[1]EaView;request:[1]EaRequest;
  selected:int= -1;session:[128]u8;ns:int;flight:bool;random:bool;timer:bool;uncertain:bool;
  action:int;body:[131072]u8;nb:int;draft:[16384]u8;nd:int;note:[512]u8;nn:int;
  // The computer's last offer and the person's model/effort choice (empty:
  // the open conversation's, else the computer's default). menu: 1 model, 2 effort.
  offer:[1]EaOffer;model:[64]u8;nmo:int;effort:[16]u8;nef:int;menu:int;
  expanded:[64]int;expanded_n:int;history_before:int;sync_requested:bool;paused:bool;workspace:bool;
}
#test "history navigation pauses polling without replacing an uncertain command" {
 e:[1]EnvironmentApp;e[0].active=true;e[0].timer=true;e[0].uncertain=true;e[0].request[0].nc=ea_copy(e[0].request[0].command[..],"01234567890123456789012345678901");
 eu_pause(e[..],true);eu_reply(e[..],12,0,"{}",false);
 #assert e[0].paused && !e[0].timer && e[0].action==0 && e[0].uncertain && e[0].request[0].nc==32;
}
eu_wait :: (e:[]EnvironmentApp) #effects(all) {
 running:=false;for i:0..<e[0].view[0].ns {s:=e[0].view[0].sessions[i];if cast(string)s.id[0..<s.ni]==cast(string)e[0].session[0..<e[0].ns] {running=s.busy;}}
 if !e[0].paused && e[0].active && !e[0].flight && !e[0].random && !e[0].uncertain && e[0].page==2 && running && !e[0].timer && e[0].action==0 && e[0].history_before==0 {e[0].timer=true;e[0].action=12;e[0].nb=ea_copy(e[0].body[..],"{}");}
}
eu_pause :: (e:[]EnvironmentApp,on:bool) #effects(all) {e[0].paused=on;if on && e[0].action==12 {e[0].action=0;e[0].timer=false;}if !on {eu_wait(e);}}
#test "tool output is collapsed literal detail, with stable identity across polling" {
  e:[1]EnvironmentApp;e[0].active=true;e[0].page=2;e[0].selected=0;e[0].catalog[0].n=1;e[0].ns=ea_copy(e[0].session[..],"chat");
  v:=e[0].view[..];v[0].ni=1;m:=v[0].items[0];m.ni=ea_copy(m.id[..],"tool-1");m.nr=ea_copy(m.role[..],"tool");m.nk=ea_copy(m.tool[..],"Bash");m.complete=true;
  raw:="## literal tool output\n$ echo **not markdown**";m.text_at=ea_text_put(v,raw);m.nt=raw.count;v[0].items[0]=m;
  t:[1]Tree;u:[1]Ui;md:[1]MdDoc;id:[96]u8;pre:[96]u8;key:=eu_item_id(v,0,id[..]);
  tr_begin(t[..]);eu_render(e[..],t[..],u[..],md[..]);#assert tr_find(t[..],key)>=0 && tr_find(t[..],tr_cat(pre[..],key,".out"))<0 && tr_find(t[..],"env.history.partial")<0;
  eu_press(e[..],key);tr_begin(t[..]);eu_render(e[..],t[..],u[..],md[..]);#assert tr_text_of(t[..],tr_find(t[..],tr_cat(pre[..],key,".out")))==raw;
  v[0].items[1]=m;v[0].items[0].ni=ea_copy(v[0].items[0].id[..],"new-row");v[0].ni=2;
  #assert eu_tool_open(e[..],eu_item_key(v,1)) && !eu_tool_open(e[..],eu_item_key(v,0));
}
#test "refresh is a small header status and earlier history is above the transcript" {
  e:[1]EnvironmentApp;e[0].page=2;e[0].selected=0;e[0].catalog[0].n=1;e[0].flight=true;e[0].ns=1;e[0].view[0].nc=ea_copy(e[0].view[0].cursor[..],"1000001");
  t:[1]Tree;u:[1]Ui;md:[1]MdDoc;tr_begin(t[..]);eu_render(e[..],t[..],u[..],md[..]);
  at:=tr_find(t[..],"env.refresh");#assert at>=0 && t[0].nodes[at].parent==tr_find(t[..],"env.header") && tr_attr_of(t[..],at,AT_STATE)=="loading" && tr_attr_of(t[..],at,AT_DISABLED)=="";
  #assert tr_find(t[..],"env.earlier")<tr_find(t[..],"env.welcome");
}
eu_item_key :: (v:[]EaView,i:int)->int #effects(all) {m:=v[0].items[i];return tr_hash(cast(string)m.id[0..<m.ni]);}
eu_item_id :: (v:[]EaView,i:int,out:[]u8)->string #effects(all) {return tr_join(out,"environment.message.",eu_item_key(v,i));}
eu_tool_open :: (e:[]EnvironmentApp,key:int)->bool #effects(all) {for i:0..<e[0].expanded_n {if e[0].expanded[i]==key {return true;}}return false;}
#test "background polling keeps the settled status quiet; an explicit refresh shows progress" {
  e:[1]EnvironmentApp;e[0].page=2;e[0].selected=0;e[0].catalog[0].n=1;e[0].flight=true;e[0].view[0].ok=true;
  e[0].view[0].nm=ea_copy(e[0].view[0].method[..],"ReadSession");e[0].request[0].nm=ea_copy(e[0].request[0].method[..],"ReadSession");
  t:[1]Tree;u:[1]Ui;md:[1]MdDoc;tr_begin(t[..]);eu_render(e[..],t[..],u[..],md[..]);#assert tr_attr_of(t[..],tr_find(t[..],"env.refresh"),AT_STATE)=="ready";
  e[0].sync_requested=true;tr_begin(t[..]);eu_render(e[..],t[..],u[..],md[..]);#assert tr_attr_of(t[..],tr_find(t[..],"env.refresh"),AT_STATE)=="loading";
}
#test "reading earlier history is not replaced by a polling timer" {
  e:[1]EnvironmentApp;e[0].active=true;e[0].page=2;e[0].ns=1;e[0].timer=true;e[0].history_before=1000001;
  eu_reply(e[..],12,0,"{}",false);#assert e[0].action==0 && !e[0].flight && !e[0].timer;
}
#test "environment sends retain their command across timeout and never mint on retry" {
  e:[1]EnvironmentApp;e[0].active=true;e[0].page=2;e[0].selected=0;e[0].catalog[0].n=1;
  h:="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";n:=ea_copy(e[0].catalog[0].entries[0].host[..],h);e[0].nd=ea_copy(e[0].draft[..],"hello");
  eu_press(e[..],"env.composer.send");#assert e[0].action==11 && e[0].random;
  e[0].action=0;eu_reply(e[..],11,0,"{\"command_id\":\"11111111111111111111111111111111\",\"session_id\":\"22222222222222222222222222222222\",\"now_ms\":1700000000000}",false);
  #assert e[0].action==4 && e[0].request[0].nc==32 && e[0].flight;
  e[0].action=0;eu_reply(e[..],4,0,"",true);#assert e[0].uncertain && e[0].nd==5;
  eu_press(e[..],"env.composer.send");#assert e[0].action==0 && !e[0].random;
  eu_press(e[..],"env.reconnect");#assert e[0].action==4 && e[0].request[0].command[0]=='1';
}
#test "a detached environment ignores late timers and identity replies" {
  e:[1]EnvironmentApp;e[0].timer=true;e[0].random=true;
  eu_reply(e[..],12,0,"{}",false);eu_reply(e[..],11,0,"{}",false);#assert e[0].action==0 && !e[0].flight;
}
#test "a failed computer read never claims that discovery ran or the account has no computers" {
  e:[1]EnvironmentApp;e[0].active=true;e[0].page=1;e[0].selected=0;e[0].catalog[0].n=1;e[0].flight=true;
  eu_request(e[..],"ListSessions");eu_reply(e[..],4,503,"{}",false);
  t:[1]Tree;u:[1]Ui;markdown:[1]MdDoc;tr_begin(t[..]);eu_render(e[..],t[..],u[..],markdown[..]);
  #assert e[0].uncertain && tr_find(t[..],"env.reconnect")>=0 && tr_find(t[..],"env.partial")<0 && tr_find(t[..],"env.empty")<0;
}
#test "a turn names the offered model and effort, and an older computer's turn names neither" {
  e:[1]EnvironmentApp;e[0].active=true;e[0].page=2;e[0].selected=0;e[0].catalog[0].n=1;e[0].nd=ea_copy(e[0].draft[..],"hello");
  eu_press(e[..],"env.composer.send");#assert e[0].random && e[0].request[0].nmo==0 && e[0].request[0].nef==0;
  o:=e[0].offer;o[0].nv=2;o[0].default_level=1;n:=ea_copy(o[0].levels[0].id[..],"low");o[0].levels[0].ni=3;n=ea_copy(o[0].levels[0].label[..],"Low");o[0].levels[0].nl=3;
  n=ea_copy(o[0].levels[1].id[..],"high");o[0].levels[1].ni=4;n=ea_copy(o[0].levels[1].label[..],"High");o[0].levels[1].nl=4;
  o[0].n=2;o[0].models[0].ni=ea_copy(o[0].models[0].id[..],"default");o[0].models[0].nl=ea_copy(o[0].models[0].label[..],"Default");o[0].models[0].ladder=3;
  o[0].models[1].ni=ea_copy(o[0].models[1].id[..],"claude-haiku-4-5");o[0].models[1].nl=ea_copy(o[0].models[1].label[..],"Haiku 4.5");e[0].offer=o;
  e[0].random=false;e[0].action=0;eu_press(e[..],"env.composer.send");#assert cast(string)e[0].request[0].model[0..<e[0].request[0].nmo]=="default" && cast(string)e[0].request[0].effort[0..<e[0].request[0].nef]=="high";
  eu_press(e[..],"env.effort");#assert e[0].menu==2;eu_press(e[..],"env.effort.0");#assert e[0].menu==0;
  e[0].random=false;e[0].action=0;eu_press(e[..],"env.composer.send");#assert cast(string)e[0].request[0].effort[0..<e[0].request[0].nef]=="low";
  eu_press(e[..],"env.model.1");e[0].random=false;e[0].action=0;eu_press(e[..],"env.composer.send");#assert cast(string)e[0].request[0].model[0..<e[0].request[0].nmo]=="claude-haiku-4-5" && e[0].request[0].nef==0;
  t:[1]Tree;u:[1]Ui;markdown:[1]MdDoc;e[0].random=false;tr_begin(t[..]);eu_render(e[..],t[..],u[..],markdown[..]);
  #assert tr_find(t[..],"env.model")>=0 && tr_find(t[..],"env.effort")<0;
}
eu_error :: (code:string)->string #effects(all) {
  if code=="forbidden" {return "This connection is no longer allowed. Reconnect the computer from its desktop.";}
  if code=="conflict" {return "The conversation changed. Refresh it before trying again.";}
  if code=="capacity" {return "This computer has reached its managed chat limit. Existing chats are still available.";}
  if code=="record_limit" {return "Recording reached its limit, so this turn stopped. Start a new chat.";}
  if code=="storage_unavailable" {return "The computer could not save this command safely. No new turn was started.";}
  if code=="expired" {return "The command expired before it could start. Refresh and try again.";}
  if code=="stale_cursor" {return "This history page is no longer available. Refresh the conversation.";}
  if code=="not_found" {return "This conversation is no longer available on that computer.";}
  if code=="model_unavailable" {return "This computer's Claude does not offer that model and effort. Pick another.";}
  return "The computer could not complete this request. Refresh to check its current state.";
}
eu_note :: (e:[]EnvironmentApp,text:string) #effects(all) {e[0].nn=ea_copy(e[0].note[..],text);}
// The open conversation's summary, or -1.
eu_current :: (e:[]EnvironmentApp)->int #effects(all) {
  for i:0..<e[0].view[0].ns {s:=e[0].view[0].sessions[i];if e[0].ns>0 && cast(string)s.id[0..<s.ni]==cast(string)e[0].session[0..<e[0].ns] {return i;}}return -1;
}
// The offered model a turn runs on: the person's choice, else the open
// conversation's, else the computer's default (first); -1 with no offer.
eu_model :: (e:[]EnvironmentApp)->int #effects(all) {
  o:=e[0].offer[..];if o[0].n==0 {return -1;}id:=cast(string)e[0].model[0..<e[0].nmo];
  c:=eu_current(e);if id.count==0 && c>=0 {s:=e[0].view[0].sessions[c];id=cast(string)e[0].view[0].sessions[c].model[0..<s.nmo];}
  for i:0..<o[0].n {m:=o[0].models[i];if cast(string)o[0].models[i].id[0..<m.ni]==id {return i;}}return 0;
}
// Its effort level: the chosen one when the model takes it, else the
// conversation's, else the default, else the model's last; -1 for none.
eu_level :: (e:[]EnvironmentApp,m:int)->int #effects(all) {
  o:=e[0].offer[..];if m<0 || m>=o[0].n || o[0].models[m].ladder==0 {return -1;}ladder:=o[0].models[m].ladder;
  c:=eu_current(e);want:=cast(string)e[0].effort[0..<e[0].nef];
  if want.count==0 && c>=0 {s:=e[0].view[0].sessions[c];want=cast(string)e[0].view[0].sessions[c].effort[0..<s.nef];}
  for i:0..<o[0].nv {l:=o[0].levels[i];if (ladder&(1<<i))!=0 && cast(string)o[0].levels[i].id[0..<l.ni]==want {return i;}}
  d:=o[0].default_level;if d>=0 && (ladder&(1<<d))!=0 {return d;}
  last:= -1;for i:0..<o[0].nv {if (ladder&(1<<i))!=0 {last=i;}}return last;
}
eu_http :: (e:[]EnvironmentApp,catalog:bool) #effects(all) {
  if e[0].flight || e[0].action!=0 {return;}
  if e[0].local {n:=ea_write(e[0].request[..],e[0].body[..]);if n>0 {e[0].nb=n;e[0].action=14;e[0].flight=true;}return;}
  path:[512]u8;n:=0;wire:[24576]u8;nw:=0;
  if catalog {n=mc(path[..],0,"/api/chat/environments/v1");}
  else {
    if e[0].selected<0 || e[0].selected>=e[0].catalog[0].n {return;}
    n=mc(path[..],0,"/api/chat/environment/v1?host=");n=mc(path[..],n,cast(string)e[0].catalog[0].entries[e[0].selected].host[..]);nw=ea_write(e[0].request[..],wire[..]);if nw<1 {return;}
  }
  read:=!catalog && ea_right(cast(string)e[0].request[0].method[0..<e[0].request[0].nm])==0;
  if read {n=mc(path[..],n,"&method=");n=mc(path[..],n,cast(string)e[0].request[0].method[0..<e[0].request[0].nm]);n=mc(path[..],n,"&session=");n=mc(path[..],n,cast(string)e[0].request[0].session[0..<e[0].request[0].ns]);n=mc(path[..],n,"&before=");n=json_write_int(path[..],n,e[0].request[0].before);}
  o:[1]Jo;jo_start(o[..],e[0].body[..]);jo_obj(o[..]);jo_key(o[..],"path");jo_str(o[..],cast(string)path[0..<n]);jo_key(o[..],"method");jo_str(o[..],ifx catalog || read then "GET" else "POST");
  if !catalog && !read {jo_key(o[..],"body");jo_str(o[..],cast(string)wire[0..<nw]);}jo_end(o[..]);
  if o[0].bad {eu_note(e,"Request exceeds the installed limit.");return;}e[0].nb=o[0].n;e[0].action=4;e[0].flight=true;
}
eu_enter :: (e:[]EnvironmentApp) #effects(all) {e[0]=EnvironmentApp.{};e[0].active=true;eu_http(e,true);}
eu_enter_local :: (e:[]EnvironmentApp) #effects(all) {
  e[0]=EnvironmentApp.{};e[0].active=true;e[0].local=true;e[0].selected=0;e[0].catalog[0].n=1;e[0].page=1;
  eu_request(e,"DescribeEnvironment");eu_http(e,false);
}
eu_request :: (e:[]EnvironmentApp,method:string) #effects(all) {
  q:=e[0].request[..];q[0]=EaRequest.{};q[0].nm=ea_copy(q[0].method[..],method);q[0].nw=ea_copy(q[0].workspace[..],"default");q[0].ns=ea_copy(q[0].session[..],cast(string)e[0].session[0..<e[0].ns]);
  for i:0..<e[0].view[0].ns {s:=e[0].view[0].sessions[i];if cast(string)s.id[0..<s.ni]==cast(string)e[0].session[0..<e[0].ns] {q[0].generation=s.generation;q[0].revision=s.revision;q[0].ni=ea_copy(q[0].interaction[..],cast(string)s.interaction[0..<s.nr]);}}
}
eu_mutate :: (e:[]EnvironmentApp,method:string,allow:bool) #effects(all) {
  if e[0].flight || e[0].random || e[0].uncertain || e[0].action!=0 {return;}
  eu_request(e,method);q:=e[0].request[..];q[0].allow=allow;
  if method=="OpenSession" || method=="SendMessage" {
    if !ea_text(cast(string)e[0].draft[0..<e[0].nd]) {return;}q[0].nt=ea_copy(q[0].text[..],cast(string)e[0].draft[0..<e[0].nd]);
    // Each turn names its model and effort when the computer offers them; an older one gets neither.
    m:=eu_model(e);l:=eu_level(e,m);o:=e[0].offer[..];
    if m>=0 {q[0].nmo=ea_copy(q[0].model[..],cast(string)o[0].models[m].id[0..<o[0].models[m].ni]);}
    if l>=0 {q[0].nef=ea_copy(q[0].effort[..],cast(string)o[0].levels[l].id[0..<o[0].levels[l].ni]);}
  }
  e[0].random=true;e[0].action=11;e[0].nb=ea_copy(e[0].body[..],"{}");
}
eu_reply :: (e:[]EnvironmentApp,op:int,status:int,raw:string,failed:bool) #effects(all) {
  if !e[0].active {return;}
  if op==12 {
    if !e[0].timer {return;}e[0].timer=false;
    if !e[0].paused && !e[0].flight && !e[0].random && !e[0].uncertain && e[0].page==2 && e[0].ns>0 && e[0].history_before==0 {eu_request(e,"ReadSession");eu_http(e,false);}return;
  }
  if op==11 {
    if !e[0].random {return;}e[0].random=false;
    nodes:[16]JvNode;d:[1]Jv;q:=e[0].request[..];
    if failed || !jv_parse(d[..],raw,nodes[..]) {eu_note(e,"Could not create a command identity.");return;}
    q[0].nc=jv_str(d[0],jv_get(d[0],0,"command_id"),q[0].command[..]);
    q[0].issued=jv_int(d[0],jv_get(d[0],0,"now_ms"),0);q[0].expires=ea_deadline(q[0].issued);
    if cast(string)q[0].method[0..<q[0].nm]=="OpenSession" {q[0].ns=jv_str(d[0],jv_get(d[0],0,"session_id"),q[0].session[..]);}
    if q[0].nc!=32 || !ea_id(cast(string)q[0].command[..],32) || q[0].ns<1 || q[0].expires<=0 {eu_note(e,"Invalid command identity.");return;}
    eu_http(e,false);return;
  }
  if (op!=4 && op!=14) || !e[0].flight {return;}e[0].flight=false;e[0].sync_requested=false;
  if failed || status!=200 {
    e[0].uncertain=true;eu_note(e,ifx ea_right(cast(string)e[0].request[0].method[0..<e[0].request[0].nm])>0 then "Connection lost. Reconnect checks this same command before trying anything else." else "Could not reach this computer. Reconnect to try again.");return;
  }
  if e[0].selected<0 {if !ea_catalog_read(raw,e[0].catalog[..]) {eu_note(e,"Unreadable environment list.");return;}e[0].uncertain=false;eu_note(e,"");return;}
  next:[1]EaView;
  if e[0].local && cast(string)e[0].request[0].method[0..<e[0].request[0].nm]=="DescribeEnvironment" && ea_view_read(raw,next[..]) {
    e[0].catalog[0].entries[0].host=next[0].host;e[0].catalog[0].entries[0].nl=ea_copy(e[0].catalog[0].entries[0].label[..],"This computer");
    eu_request(e,"ListSessions");eu_http(e,false);return;
  }
  if !ea_view_read(raw,next[..]) || cast(string)next[0].host[..]!=cast(string)e[0].catalog[0].entries[e[0].selected].host[..] {eu_note(e,"The reply did not match this computer.");e[0].uncertain=true;return;}
  if cast(string)next[0].method[0..<next[0].nm]!=cast(string)e[0].request[0].method[0..<e[0].request[0].nm] || (next[0].nt>0 && (next[0].nq!=e[0].request[0].nc || cast(string)next[0].command[0..<next[0].nq]!=cast(string)e[0].request[0].command[0..<e[0].request[0].nc])) {eu_note(e,"The reply did not match this request.");e[0].uncertain=true;return;}
  e[0].view[0]=next[0];e[0].uncertain=false;if next[0].offer.n>0 {e[0].offer[0]=next[0].offer;}
  if next[0].ne>0 {eu_note(e,eu_error(cast(string)next[0].error[0..<next[0].ne]));return;}
  q:=e[0].request[..];method:=cast(string)q[0].method[0..<q[0].nm];
  if method=="OpenSession" {e[0].ns=ea_copy(e[0].session[..],cast(string)q[0].session[0..<q[0].ns]);e[0].page=2;}
  if (method=="OpenSession" || method=="SendMessage") && cast(string)next[0].status[0..<next[0].nt]=="accepted" {e[0].nd=0;}
  eu_note(e,ifx cast(string)next[0].status[0..<next[0].nt]=="unknown" then "This command's outcome is unknown. It will not be run again automatically." else "");
  eu_wait(e);
}
eu_press :: (e:[]EnvironmentApp,id:string) #effects(all) {
  if id=="env.choices.close" {e[0].menu=0;return;}
  if id=="env.latest" {eu_press(e,"env.refresh");return;}
  for i:0..<e[0].view[0].ni {m:=e[0].view[0].items[i];b:[96]u8;if (m.nk>0 || cast(string)m.role[0..<m.nr]=="tool") && id==eu_item_id(e[0].view[..],i,b[..]) {
    key:=eu_item_key(e[0].view[..],i);for k:0..<e[0].expanded_n {if e[0].expanded[k]==key {e[0].expanded_n-=1;e[0].expanded[k]=e[0].expanded[e[0].expanded_n];return;}}
    if e[0].expanded_n<64 {e[0].expanded[e[0].expanded_n]=key;e[0].expanded_n+=1;}return;
  }}
  if id=="env.reconnect" {e[0].uncertain=false;eu_http(e,e[0].selected<0);return;}
  if id=="env.new" && !e[0].flight && !e[0].random {e[0].ns=0;e[0].nd=0;e[0].page=2;e[0].menu=0;e[0].expanded_n=0;e[0].history_before=0;e[0].view[0]=EaView.{};return;}
  if id=="env.model" || id=="env.effort" {want:=ifx id=="env.model" then 1 else 2;e[0].menu=ifx e[0].menu==want then 0 else want;return;}
  o:=e[0].offer[..];
  for i:0..<o[0].n {b:[96]u8;if id==tr_join(b[..],"env.model.",i) {m:=o[0].models[i];e[0].nmo=ea_copy(e[0].model[..],cast(string)o[0].models[i].id[0..<m.ni]);e[0].menu=0;return;}}
  for i:0..<o[0].nv {b:[96]u8;if id==tr_join(b[..],"env.effort.",i) {l:=o[0].levels[i];e[0].nef=ea_copy(e[0].effort[..],cast(string)o[0].levels[i].id[0..<l.ni]);e[0].menu=0;return;}}
  if id=="env.sessions" && !e[0].flight && !e[0].random {e[0].page=1;eu_request(e,"ListSessions");eu_http(e,false);return;}
  if id=="env.refresh" && !e[0].flight && !e[0].random {
    e[0].sync_requested=true;
    if e[0].uncertain {e[0].uncertain=false;eu_http(e,e[0].selected<0);return;}
    e[0].history_before=0;eu_request(e,ifx e[0].page==1 then "ListSessions" else "ReadSession");eu_http(e,false);return;
  }
  if (id=="env.earlier" || id=="env.more") && !e[0].flight && !e[0].random {cursor:=cast(string)e[0].view[0].cursor[0..<e[0].view[0].nc];before:=0;for c:cursor {if c<'0' || c>'9' {return;}before=before*10+cast(int)(c-'0');}if before>0 {eu_request(e,ifx id=="env.more" then "ListSessions" else "ReadSession");e[0].request[0].before=before;if id=="env.earlier" {e[0].history_before=before;}eu_http(e,false);}return;}
  for i:0..<e[0].catalog[0].n {b:[96]u8;if id==tr_join(b[..],"environment.",i) && !e[0].flight {e[0].selected=i;e[0].page=1;eu_request(e,"ListSessions");eu_http(e,false);return;}}
  for i:0..<e[0].view[0].ns {b:[96]u8;if id==tr_join(b[..],"environment.session.",i) && !e[0].flight {row:=e[0].view[0].sessions[i];e[0].ns=ea_copy(e[0].session[..],cast(string)row.id[0..<row.ni]);e[0].nmo=0;e[0].nef=0;e[0].menu=0;e[0].expanded_n=0;e[0].history_before=0;e[0].page=2;eu_request(e,"ReadSession");eu_http(e,false);return;}}
  if id=="env.composer.send" {
    busy:=false;for i:0..<e[0].view[0].ns {row:=e[0].view[0].sessions[i];if cast(string)row.id[0..<row.ni]==cast(string)e[0].session[0..<e[0].ns] {busy=row.busy;}}
    eu_mutate(e,ifx busy then "StopTurn" else ifx e[0].ns==0 then "OpenSession" else "SendMessage",false);return;
  }
  if id=="env.allow" || id=="env.deny" {eu_mutate(e,"RespondInteraction",id=="env.allow");}
}
eu_render :: (e:[]EnvironmentApp,t:[]Tree,u:[]Ui,markdown:[]MdDoc) #effects(all) {
  busy:=e[0].flight || e[0].random;x:= -1;
  if e[0].page==0 {
    x=k_text(t,u,"env.title",TG_H1,"","Your computers");x=k_link(t,"env.close","Account chats");
    if e[0].catalog[0].ok && e[0].catalog[0].n==0 && !busy {x=k_text(t,u,"env.empty",TG_P,"","No computers are connected to this account.");}
    for i:0..<e[0].catalog[0].n {b:[96]u8;row:=e[0].catalog[0].entries[i];x=k_row(t,u,tr_join(b[..],"environment.",i),cast(string)row.label[0..<row.nl],"",false);if busy {tr_attr(t,x,AT_DISABLED,"");}}
  } else if e[0].page==1 {
    row:=e[0].catalog[0].entries[e[0].selected];x=k_text(t,u,"env.title",TG_H1,"",cast(string)row.label[0..<row.nl]);x=k_link(t,"env.close","All chats");
    x=k_button(t,u,"env.new","New Claude chat",ifx busy || e[0].uncertain then BS_DISABLED else BS_PRIMARY);x=k_link(t,"env.refresh","Refresh");if busy {tr_attr(t,x,AT_DISABLED,"");}
    if e[0].view[0].ok && !e[0].view[0].complete && e[0].view[0].nc==0 && e[0].view[0].ne==0 && !busy {x=k_text(t,u,"env.partial",TG_P,"","Some conversations could not be indexed. Refresh if a chat is missing.");}
    for i:0..<e[0].view[0].ns {b:[96]u8;s:=e[0].view[0].sessions[i];x=k_row(t,u,tr_join(b[..],"environment.session.",i),cast(string)s.title[0..<s.nt],"",false);if busy {tr_attr(t,x,AT_DISABLED,"");}}
    if e[0].view[0].nc>0 {x=k_link(t,"env.more","More conversations");if busy {tr_attr(t,x,AT_DISABLED,"");}}
  } else {
    row:=e[0].catalog[0].entries[e[0].selected];x=tr_open(t,"env.header",TG_HEADER,"");tr_attr(t,x,AT_ROLE,"toolbar");if e[0].workspace {x=k_side_open(t,"nav.toggle","Show chats");}else {x=k_button(t,u,"env.sessions","Chats",BS_PLAIN);}caption:[384]u8;label:=cast(string)row.label[0..<row.nl];current:=eu_current(e);if e[0].workspace && current>=0 {label=tr_cat(caption[..],cast(string)e[0].view[0].sessions[current].title[0..<e[0].view[0].sessions[current].nt]," · ");n:=mc(caption[..],label.count,cast(string)row.label[0..<row.nl]);label=cast(string)caption[0..<n];}x=k_text(t,u,"env.executing",TG_SPAN,"",label);
    showing:=busy && (e[0].sync_requested || !e[0].view[0].ok || cast(string)e[0].view[0].method[0..<e[0].view[0].nm]!="ReadSession" || cast(string)e[0].request[0].method[0..<e[0].request[0].nm]!="ReadSession");
    x=k_button(t,u,"env.refresh","↻",BS_PLAIN);tr_attr(t,x,AT_LABEL,ifx showing then "Refreshing conversation" else ifx e[0].uncertain then "Connection lost. Reconnect" else ifx e[0].history_before>0 then "Return to latest messages" else "Conversation up to date. Refresh");
    tr_attr(t,x,AT_STATE,ifx showing then "loading" else ifx e[0].uncertain then "offline" else ifx e[0].view[0].ok then "ready" else "idle");
    if e[0].workspace {x=k_icon_button(t,"nav.new",IC_PLUS,"New chat");}tr_close(t);
    active:=false;asking:=false;reviewable:=true;writable:=e[0].ns==0;
    for i:0..<e[0].view[0].ns {s:=e[0].view[0].sessions[i];if cast(string)s.id[0..<s.ni]==cast(string)e[0].session[0..<e[0].ns] {active=s.busy;asking=s.nr>0;writable=s.managed && cast(string)s.control[0..<s.nc]=="available";}}
    x=tr_open(t,"env.messages",TG_SECTION,"transcript");tr_attr(t,x,AT_STATE,cast(string)e[0].session[0..<e[0].ns]);
    if e[0].view[0].nc>0 {x=k_link(t,"env.earlier","Earlier messages");if busy {tr_attr(t,x,AT_DISABLED,"");}}
    if e[0].history_before>0 {x=k_link(t,"env.latest","Back to latest");}
    if e[0].view[0].ni==0 {x=k_text(t,u,"env.welcome",TG_P,"",ifx e[0].ns==0 then "Start a Claude conversation on this computer." else "Loading conversation…");}
    for i:0..<e[0].view[0].ni {b:[96]u8;m:=e[0].view[0].items[i];id:=eu_item_id(e[0].view[..],i,b[..]);
      if m.nk>0 || cast(string)m.role[0..<m.nr]=="tool" {
        if !m.complete {reviewable=false;}
        x=k_tool_line(t,u,id,ifx m.nk>0 then cast(string)m.tool[0..<m.nk] else "Tool",ifx !m.complete then "Partial output" else "",TL_INFO,eu_tool_open(e,eu_item_key(e[0].view[..],i)),"",ea_item_text(e[0].view[..],i));
      }else {x=k_message(t,u,id,cast(string)m.role[0..<m.nr]!="user",markdown,ea_item_text(e[0].view[..],i));}
    }tr_close(t);
    if asking {x=k_button(t,u,"env.allow","Allow once",ifx busy || !reviewable then BS_DISABLED else BS_PRIMARY);x=k_button(t,u,"env.deny","Deny",ifx busy then BS_DISABLED else BS_PLAIN);}
    if asking && !reviewable {x=k_text(t,u,"env.approval.partial",TG_P,"","This request is too large to review here. Deny it or stop this turn.");}
    m:=eu_model(e);l:=eu_level(e,m);o:=e[0].offer[..];name:[96]u8;title:="Claude Code";
    if writable && m>=0 {
      // The next turn's model and effort; a running turn keeps its own.
      if e[0].workspace {x=tr_open(t,"env.options",TG_FOOTER,"composer-options");}
      ml:=cast(string)o[0].models[m].label[0..<o[0].models[m].nl];a:[96]u8;open:=e[0].menu==1 && !busy && !e[0].workspace;
      k_select_begin(t,u,"env.model",tr_cat(a[..],"Model · ",ml),"Claude model for the next message",open);
      if open {for i:0..<o[0].n {b:[96]u8;x=k_row(t,u,tr_join(b[..],"env.model.",i),cast(string)o[0].models[i].label[0..<o[0].models[i].nl],"",i==m);}}
      k_select_end(t,open);title=ml;
      if l>=0 {
        ll:=cast(string)o[0].levels[l].label[0..<o[0].levels[l].nl];c:[96]u8;open=e[0].menu==2 && !busy && !e[0].workspace;
        k_select_begin(t,u,"env.effort",tr_cat(c[..],"Effort · ",ll),"Reasoning effort for the next message",open);
        if open {for i:0..<o[0].nv {if (o[0].models[m].ladder&(1<<i))!=0 {b:[96]u8;x=k_row(t,u,tr_join(b[..],"env.effort.",i),cast(string)o[0].levels[i].label[0..<o[0].levels[i].nl],"",i==l);}}}
        k_select_end(t,open);title=tr_cat(name[..],tr_cat(c[..],ml," · "),ll);
      }
      if e[0].workspace {tr_close(t);}
      if e[0].workspace && e[0].menu>0 {
        x=tr_open(t,"env.choices",TG_SECTION,"");tr_attr(t,x,AT_ROLE,"dialog");tr_attr(t,x,AT_LABEL,ifx e[0].menu==1 then "Model" else "Reasoning effort");
        x=k_text(t,u,"env.choices.title",TG_H2,"",ifx e[0].menu==1 then "Model" else "Reasoning effort");x=k_link(t,"env.choices.close","Close choices");
        if e[0].menu==1 {for i:0..<o[0].n {b:[96]u8;x=k_row(t,u,tr_join(b[..],"env.model.",i),cast(string)o[0].models[i].label[0..<o[0].models[i].nl],"",i==m);}}
        else {for i:0..<o[0].nv {if (o[0].models[m].ladder&(1<<i))!=0 {b:[96]u8;x=k_row(t,u,tr_join(b[..],"env.effort.",i),cast(string)o[0].levels[i].label[0..<o[0].levels[i].nl],"",i==l);}}}tr_close(t);
      }
    }
    if writable {f:=k_composer_begin(t,u,"env.composer","Message Claude");if busy || active || e[0].uncertain {tr_attr(t,f,AT_DISABLED,"disabled");}k_composer_end(t,u,"env.composer",ifx active then "Stop" else "Send",!busy && !e[0].uncertain && (active || e[0].nd>0));frame:=tr_find(t,"env.composer.frame");if frame>=0 {tr_attr(t,frame,AT_TITLE,title);}}
    else {x=k_text(t,u,"env.readonly",TG_P,"","Read only. Open a new managed chat to control Claude; this app does not take over Terminal sessions.");}
  }
  if e[0].nn>0 {x=k_text(t,u,"env.note",TG_P,"",cast(string)e[0].note[0..<e[0].nn]);}
  if e[0].uncertain && e[0].page!=2 {x=k_button(t,u,"env.reconnect","Reconnect",ifx busy then BS_DISABLED else BS_PRIMARY);}
}
