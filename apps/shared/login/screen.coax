// The native login screen, drawn by the shared display-list kit over a live
// GPU scene (components/gpu-components.md, "The first screen: login", stage
// G1; GitHub #13645). Email, then the code; the page says "Log in". It is
// compiled Coax linked into the app, like the component gallery, and does
// not run in the JavaScript runtime or depend on Updates.
//
// This file is the screen's state, layout, paint and semantics. It has no
// effects: the host (apps/shared/login/host.c and apps/shared/native/
// NativeLogin.swift on iOS) owns the GPU surface, the keyboard and the
// account. Each frame the host
//   - gives the window's facts (login_env: safe areas, the keyboard, reduced
//     motion, whether a scene is drawn behind) and asks for the frame's
//     vertices (login_frame);
//   - takes the action the screen asks for (login_action: start the email,
//     verify the code, open the key login) and answers it (login_reply). The
//     host calls the native auth adapter; no token or pending handle ever
//     enters this file;
//   - places the platform editor over the focused field (login_focus,
//     login_field) and sends back the whole value on each edit (login_set_text).
//     While a field holds the keyboard the screen paints its frame only, so
//     there is one caret and one set of glyphs;
//   - reads the semantic rows (login_rows, login_row...) for VoiceOver, and
//     activates one by id (login_activate), which does what a tap does. The
//     same rows answer the driver (login_drive: tree, tap ID, type ID TEXT).
//
// The form is the form set (components/kit/form.coax) in the phone skin
// (components/skin/arcade.coax), called through the frame context
// (components/kit/frame.coax): each part records its semantic row and its hit
// region under a stable id, the form's entry and its move with the keyboard
// are keyed state, and the display list, hits and rows commit together on
// one surface (components/paint/surface.coax). A press, VoiceOver and the
// driver all read the committed rows. Layout is in the skin's units, drawn
// LG_SCALE times larger so its 14-unit text is read at phone size; every
// number the host sees is in points.
//   coax/bin/coax test apps/shared/login/screen.coax

#load "../../../components/kit/form.coax";
#load "../../../components/core/edit.coax";
#load "../../../components/skin/arcade.coax";
#load "../../../components/backend/gpu.coax";

LG_SCALE :: ARCADE_PHONE_SCALE;   // points per layout unit: the atlas is made at the screen's scale times this
LG_MAX_VERTICES :: 16384;
// The surface's declared capacity, a generation: primitives, runs of text, hits, pooled bytes, semantic rows; and keyed ids.
LG_UNDER :: 256; LG_OVER :: 160; LG_HITS :: 24; LG_POOL :: 768; LG_ROWS :: 24; LG_KEYED :: 24;
LG_EMAIL_MAX :: 254; LG_CODE_MAX :: 32; LG_NOTE_MAX :: 240;
LG_PANEL_MAX :: 340.0;       // the form's widest, units
LG_MARGIN :: 14.0;           // the form from the screen's sides, units
LG_REST :: 0.68;             // where the form's middle rests over its scene, a share of the screen's height
LG_REST_CARD :: 0.42;        // and as a card over another screen
LG_RISE :: 14.0;             // units the form rises as it enters

// Steps, fields, hits and actions.
LG_STEP_EMAIL :: 0; LG_STEP_CODE :: 1;
LG_FIELD_NONE :: 0; LG_FIELD_EMAIL :: 1; LG_FIELD_CODE :: 2;
// What a row dispatches when pressed (its action in the semantic table).
LG_HIT_EMAIL :: 1; LG_HIT_CODE :: 2; LG_HIT_SEND :: 3; LG_HIT_VERIFY :: 4; LG_HIT_RESEND :: 5; LG_HIT_CHANGE :: 6; LG_HIT_KEY :: 7; LG_HIT_CLOSE :: 8;
LG_HIT_APPLE :: 9; LG_HIT_GOOGLE :: 10; LG_HIT_GITHUB :: 11; LG_HIT_SSO :: 12; LG_HIT_PW :: 13;
// What the host is asked to do.
LG_ACT_NONE :: 0; LG_ACT_START :: 1; LG_ACT_VERIFY :: 2; LG_ACT_KEY :: 3; LG_ACT_CLOSE :: 4;
LG_ACT_APPLE :: 5; LG_ACT_GOOGLE :: 6; LG_ACT_GITHUB :: 7; LG_ACT_SSO :: 8; LG_ACT_PW :: 9;

// One generation of the surface's arrays.
LgGeneration :: struct { under: [LG_UNDER] Prim; over: [LG_OVER] Prim; hits: [LG_HITS] SheetHit; pool: [LG_POOL] u8; rows: [LG_ROWS] El; }

LoginScreen :: struct {
  ready: bool; time: f32; d: f32; width: f32; height: f32;     // d: device px per unit; the size in units
  atlas: [1] Atlas; sbytes: [64] u8;
  // the window's facts, in points
  safe_top: f32; safe_bottom: f32; keyboard: f32; reduced: bool; scene: bool;
  no_key: bool;                         // the host has no key login: the form does not offer one
  workos: bool;                         // WorkOS OAuth/Apple/SSO row offered on the email step (#14101)
  card: bool;                           // a card over another screen: the view is clear, a scrim dims what is behind, and it can be closed
  step: int; busy: int;                 // busy: the action in flight (LG_ACT_*), or 0
  done: bool;                           // the code was accepted: the host is opening the app
  email: [1] EditBuf; code: [1] EditBuf;
  note: [LG_NOTE_MAX] u8; note_n: int; failure: bool;
  focus: int;
  // the pointer: where it is (units), whether a finger is down, and the id it went down on
  px: f32; py: f32; touching: bool; pressed: [EL_ID] u8; pressed_n: int;
  action: int;
  // the surface: two generations committed together, and the state kept by id
  gen: [2] LgGeneration; surface: [1] UiSurface;
  keys: [LG_KEYED] Keyed; keyed: [1] KeyedStore;
  stamp: int;
  entered: f32;                         // the form's entry, 0 to 1
  moving: bool;                         // keyed motion is still under way
  refused: int;                         // frames the surface refused (it kept the one before)
}

lg_init :: (s: [] LoginScreen) {
  s[0].ready = true;
  g := s[0].gen[..];
  s[0].surface[0] = surface_over(
    Sheet.{under = g[0].under[..], over = g[0].over[..], hits = g[0].hits[..], pool = g[0].pool[..]}, g[0].rows[..],
    Sheet.{under = g[1].under[..], over = g[1].over[..], hits = g[1].hits[..], pool = g[1].pool[..]}, g[1].rows[..]);
  s[0].keyed[0] = KeyedStore.{rows = s[0].keys[..]};
}
// The committed rows, the row with an id (or -1), and a row's box in units.
lg_rows :: (s: [] LoginScreen) -> ElTable { return surface_rows(s[0].surface[..]); }
lg_find :: (s: [] LoginScreen, id: string) -> int { return surface_find(s[0].surface[..], id); }
lg_focus_id :: (s: [] LoginScreen) -> string { return ifx s[0].focus == LG_FIELD_EMAIL then "login.email" else ifx s[0].focus == LG_FIELD_CODE then "login.code" else ""; }
lg_out :: (out: [] u8, text: string) -> int {
  n := 0;
  for c: text { if n >= out.count { break; } out[n] = c; n += 1; }
  return n;
}
lg_note :: (s: [] LoginScreen, text: string, failure: bool) {
  s[0].note_n = lg_out(s[0].note[..], text);
  while s[0].note_n > 0 && s[0].note_n < text.count && (text[s[0].note_n] & 0xC0) == 0x80 { s[0].note_n -= 1; }   // not inside a character
  s[0].failure = failure && s[0].note_n > 0;
}
lg_email :: (s: [] LoginScreen) -> string { return eb_text(s[0].email[..]); }
lg_code :: (s: [] LoginScreen) -> string { return eb_text(s[0].code[..]); }

// The phone skin with what enters faded by p (0..1): the form's frame, text and fields come up together.
lg_skin :: (p: f32) -> UiSkin {
  s := arcade_phone_skin();
  if p >= 1 { return s; }
  s.ink = opacity(s.ink, p); s.muted = opacity(s.muted, p); s.faint = opacity(s.faint, p);
  s.accent = opacity(s.accent, p); s.on_accent = opacity(s.on_accent, p);
  s.surface = opacity(s.surface, p); s.raised = opacity(s.raised, p);
  s.hairline = opacity(s.hairline, p); s.field_edge = opacity(s.field_edge, p); s.hover = opacity(s.hover, p);
  return s;
}

// Lays the form out for a screen w by h units through the frame context:
// each part paints, records its row and leaves its hit. Returns the entry's
// progress.
lg_layout :: (s: [] LoginScreen, f: [] UiFrame, w: f32, h: f32) -> f32 {
  m := f[0].m;
  // the form's own keyed state: its entry, and where it sits (a spring toward its resting place)
  key := uiframe_key(f, "login.form");
  p := am_unit(keyed_entry(f[0].keyed, key, f[0].skin.motion.menu, AM_OUT_QUAD));
  f[0].skin = lg_skin(p);
  k := f[0].skin;
  code_step := s[0].step == LG_STEP_CODE; busy := s[0].busy != LG_ACT_NONE || s[0].done;
  pw := ifx w - 2 * LG_MARGIN < LG_PANEL_MAX then w - 2 * LG_MARGIN else LG_PANEL_MAX;
  px := (w - pw) / 2; cw := pw - 2 * k.pad;
  // the content's height: the heading, the field, the action, the links and the notice
  title := ifx code_step then "Email code" else "Log in";
  detail := ifx code_step then lg_email(s) else "";
  note := cast(string) s[0].note[0..<s[0].note_n];
  heading_h := k.title.line + (ifx detail.count > 0 then k.body.line else 0.0f32);
  wos_row := !code_step && s[0].workos;
  ph := 2 * k.pad + heading_h + k.space + form_field_height(k) + k.space + k.control_h + k.control_h + (ifx wos_row then k.control_h else 0.0f32);
  note_h: f32 = 0;
  if note.count > 0 {
    // measured on a scratch sheet, so the panel is as tall as its notice
    scratch_over: [24] Prim; scratch_under: [4] Prim; t: [1] Sheet; t[0] = Sheet.{under = scratch_under[..], over = scratch_over[..]};
    note_h = form_notice(t[..], m, k, 0, 0, cw, note, s[0].failure);
    ph += k.space / 2 + note_h;
  }
  // where it rests: its middle at LG_REST, clear of the keyboard and the safe areas
  top := s[0].safe_top / LG_SCALE + k.space; bottom := h - s[0].safe_bottom / LG_SCALE - k.space;
  if s[0].keyboard > 0 { bottom = h - s[0].keyboard / LG_SCALE - k.space; }
  share: f32 = ifx s[0].card then LG_REST_CARD else LG_REST; rest := h * share - ph / 2;
  if rest + ph > bottom { rest = bottom - ph; }
  if rest < top { rest = top; }
  // the keyboard and a taller notice move it on its spring; entering, it rises into place
  py := uiframe_spring(f, key, rest) + (1 - p) * LG_RISE;
  form := uiframe_semantic(f, "login.form", EL_REGION, "Log in", px, py, pw, ph, 0, 0);
  // over another screen the card is opaque: what is behind it must not show through its wash
  if s[0].card { sheet_fill(f[0].sheet, px, py, pw, ph, 0, k.surface); }
  animated_frame(f[0].sheet, k, px, py, pw, ph, p, 1);
  uiframe_open(f, form);
  x := px + k.pad; y := py + k.pad;
  _ := ctx_heading(f, "login.title", "login.sent", x, y, cw, title, detail);
  y += heading_h + k.space;
  // the field: under the platform editor while it holds the keyboard
  state := ifx busy then EL_S_DISABLED else 0;
  fh: f32 = 0;
  if code_step { fh = ctx_field(f, "login.code", x, y, cw, "Email code", lg_code(s), "000000", s[0].focus == LG_FIELD_CODE, state, LG_HIT_CODE); }
  else { fh = ctx_field(f, "login.email", x, y, cw, "Email address", lg_email(s), "you@example.com", s[0].focus == LG_FIELD_EMAIL, state, LG_HIT_EMAIL); }
  y += fh + k.space;
  // the action
  label := ifx code_step then (ifx busy then "Checking code…" else "Log in") else (ifx busy then "Sending code…" else "Send code");
  if code_step && s[0].busy == LG_ACT_START { label = "Sending code…"; }
  work := ifx busy then EL_S_BUSY else 0;
  bh: f32 = 0;
  if code_step { bh = ctx_action(f, "login.verify", x, y, cw, label, true, work, LG_HIT_VERIFY); }
  else { bh = ctx_action(f, "login.send", x, y, cw, label, true, work, LG_HIT_SEND); }
  y += bh;
  if wos_row {
    // WorkOS OAuth/SSO row: Sign in with Apple (Guideline 4.8), Google, GitHub, Enterprise SSO.
    wa := form_link_width(m, k, "Apple");
    wg := form_link_width(m, k, "Google");
    wh := form_link_width(m, k, "GitHub");
    ws := form_link_width(m, k, "SSO");
    gap := (cw - (wa + wg + wh + ws)) / 3.0f32;
    if gap < 2.0f32 { gap = 2.0f32; }
    ox := x;
    _ := ctx_link(f, "login.apple", ox, y, "Apple", "Sign in with Apple", state, LG_HIT_APPLE); ox += wa + gap;
    _ := ctx_link(f, "login.google", ox, y, "Google", "Continue with Google", state, LG_HIT_GOOGLE); ox += wg + gap;
    _ := ctx_link(f, "login.github", ox, y, "GitHub", "Continue with GitHub", state, LG_HIT_GITHUB); ox += wh + gap;
    _ := ctx_link(f, "login.sso", ox, y, "SSO", "Enterprise SSO", state, LG_HIT_SSO);
    y += k.control_h;
  }
  // the quiet actions under it
  if code_step {
    _ := ctx_link(f, "login.resend", x - k.space, y, "Resend code", "Resend email code", state, LG_HIT_RESEND);
    lw := form_link_width(m, k, "Change email");
    _ := ctx_link(f, "login.change", x + cw + k.space - lw, y, "Change email", "Change email", state, LG_HIT_CHANGE);
  } else if s[0].card {
    _ := ctx_link(f, "login.close", x - k.space, y, "Cancel", "Cancel", state, LG_HIT_CLOSE);
    if s[0].workos && !s[0].no_key {
      pw_w := form_link_width(m, k, "Password");
      _ := ctx_link(f, "login.password", x + (cw - pw_w) / 2, y, "Password", "Email and password", state, LG_HIT_PW);
      lw := form_link_width(m, k, "Use a Nostr key");
      _ := ctx_link(f, "login.key", x + cw + k.space - lw, y, "Use a Nostr key", "Nostr key", state, LG_HIT_KEY);
    } else if s[0].workos {
      pw_w := form_link_width(m, k, "Use password");
      _ := ctx_link(f, "login.password", x + cw + k.space - pw_w, y, "Use password", "Email and password", state, LG_HIT_PW);
    } else if !s[0].no_key {
      lw := form_link_width(m, k, "Use a Nostr key");
      _ := ctx_link(f, "login.key", x + cw + k.space - lw, y, "Use a Nostr key", "Nostr key", state, LG_HIT_KEY);
    }
  } else if s[0].workos && !s[0].no_key {
    _ := ctx_link(f, "login.password", x - k.space, y, "Use password", "Email and password", state, LG_HIT_PW);
    lw := form_link_width(m, k, "Use a Nostr key");
    _ := ctx_link(f, "login.key", x + cw + k.space - lw, y, "Use a Nostr key", "Nostr key", state, LG_HIT_KEY);
  } else if s[0].workos {
    pw_w := form_link_width(m, k, "Use password");
    _ := ctx_link(f, "login.password", x + (cw - pw_w) / 2, y, "Use password", "Email and password", state, LG_HIT_PW);
  } else if !s[0].no_key {
    lw := form_link_width(m, k, "Use a Nostr key");
    _ := ctx_link(f, "login.key", x + (cw - lw) / 2, y, "Use a Nostr key", "Nostr key", state, LG_HIT_KEY);
  }
  y += k.control_h;
  if note.count > 0 { _ := ctx_notice(f, "login.note", x, y + k.space / 2, cw, note, s[0].failure); }
  uiframe_close(f);
  return p;
}
// What the accessibility bridge compares: the committed rows' names, state, values and whole-unit boxes.
lg_stamp :: (s: [] LoginScreen) -> int {
  t := [1] ElTable.[lg_rows(s)];
  st := 17;
  for i: 0..<t[0].n {
    r := t[0].rows[i];
    for c: elt_id(t[..], i) { st = (st * 31 + cast(int) c) & 0x3fffffff; }
    for c: elt_label(t[..], i) { st = (st * 31 + cast(int) c) & 0x3fffffff; }
    for c: elt_value_of(t[..], i) { st = (st * 31 + cast(int) c) & 0x3fffffff; }
    st = (st * 31 + r.state) & 0x3fffffff;
    st = (st * 31 + el_round(r.x) + 7 * el_round(r.y) + 13 * el_round(r.w) + 17 * el_round(r.h)) & 0x3fffffff;
  }
  return st;
}

// What pressing a part does: a tap, VoiceOver's activation and the driver all come here.
lg_press :: (s: [] LoginScreen, kind: int) -> bool {
  if s[0].busy != LG_ACT_NONE || s[0].done { return false; }
  if kind == LG_HIT_EMAIL && s[0].step == LG_STEP_EMAIL { s[0].focus = LG_FIELD_EMAIL; return true; }
  if kind == LG_HIT_CODE && s[0].step == LG_STEP_CODE { s[0].focus = LG_FIELD_CODE; return true; }
  if kind == LG_HIT_SEND && s[0].step == LG_STEP_EMAIL || kind == LG_HIT_RESEND && s[0].step == LG_STEP_CODE {
    if lg_email(s).count == 0 { lg_note(s, "Enter your email address.", true); s[0].focus = LG_FIELD_EMAIL; return true; }
    if kind == LG_HIT_RESEND { eb_clear(s[0].code[..]); }
    lg_note(s, "", false); s[0].busy = LG_ACT_START; s[0].action = LG_ACT_START; return true;
  }
  if kind == LG_HIT_VERIFY && s[0].step == LG_STEP_CODE {
    if lg_code(s).count == 0 { lg_note(s, "Enter the code from your email.", true); s[0].focus = LG_FIELD_CODE; return true; }
    lg_note(s, "", false); s[0].busy = LG_ACT_VERIFY; s[0].action = LG_ACT_VERIFY; return true;
  }
  if kind == LG_HIT_CHANGE && s[0].step == LG_STEP_CODE {
    s[0].step = LG_STEP_EMAIL; eb_clear(s[0].code[..]); lg_note(s, "", false); s[0].focus = LG_FIELD_EMAIL; return true;
  }
  if kind == LG_HIT_KEY && s[0].step == LG_STEP_EMAIL { s[0].focus = LG_FIELD_NONE; s[0].action = LG_ACT_KEY; return true; }
  if kind == LG_HIT_APPLE && s[0].step == LG_STEP_EMAIL && s[0].workos { s[0].focus = LG_FIELD_NONE; lg_note(s, "", false); s[0].busy = LG_ACT_APPLE; s[0].action = LG_ACT_APPLE; return true; }
  if kind == LG_HIT_GOOGLE && s[0].step == LG_STEP_EMAIL && s[0].workos { s[0].focus = LG_FIELD_NONE; lg_note(s, "", false); s[0].busy = LG_ACT_GOOGLE; s[0].action = LG_ACT_GOOGLE; return true; }
  if kind == LG_HIT_GITHUB && s[0].step == LG_STEP_EMAIL && s[0].workos { s[0].focus = LG_FIELD_NONE; lg_note(s, "", false); s[0].busy = LG_ACT_GITHUB; s[0].action = LG_ACT_GITHUB; return true; }
  if kind == LG_HIT_SSO && s[0].step == LG_STEP_EMAIL && s[0].workos { s[0].focus = LG_FIELD_NONE; lg_note(s, "", false); s[0].busy = LG_ACT_SSO; s[0].action = LG_ACT_SSO; return true; }
  if kind == LG_HIT_PW && s[0].step == LG_STEP_EMAIL && s[0].workos { s[0].focus = LG_FIELD_NONE; lg_note(s, "", false); s[0].busy = LG_ACT_PW; s[0].action = LG_ACT_PW; return true; }
  if kind == LG_HIT_CLOSE && s[0].card { s[0].focus = LG_FIELD_NONE; s[0].action = LG_ACT_CLOSE; return true; }
  return false;
}
// Pressing a committed row dispatches its action.
lg_press_row :: (s: [] LoginScreen, row: int) -> bool {
  act := surface_action(s[0].surface[..], row);
  return act != 0 && lg_press(s, act);
}
lg_set :: (s: [] LoginScreen, field: int, text: string) {
  // typing answers a failure: its notice goes
  if s[0].failure && text != (ifx field == LG_FIELD_CODE then lg_code(s) else lg_email(s)) { lg_note(s, "", false); }
  if field == LG_FIELD_EMAIL && text.count <= LG_EMAIL_MAX { eb_set(s[0].email[..], text); }
  if field == LG_FIELD_CODE && text.count <= LG_CODE_MAX { eb_set(s[0].code[..], text); }
}
lg_moving :: (s: [] LoginScreen) -> bool {
  if !s[0].ready { return true; }
  if s[0].reduced { return false; }
  if s[0].busy != LG_ACT_NONE || s[0].done { return true; }       // the activity mark turns
  return s[0].moving;
}

// ---------------------------------------------------------------- the host's calls

// The window's facts, in points. scene: a scene is drawn behind, so the screen leaves the canvas clear.
// The screen as a card over another screen (the chat): the host's view is clear, the screen dims
// what is behind it, and Cancel or a tap outside the card closes it (LG_ACT_CLOSE).
login_card :: (s: [] LoginScreen, card: bool) #export_c #effects(all) { if s.count > 0 { s[0].card = card; } }
// A host with no key login: the form leaves the key link out.
login_keys :: (s: [] LoginScreen, offered: bool) #export_c #effects(all) { if s.count > 0 { s[0].no_key = !offered; } }
// Enables WorkOS OAuth/Apple/SSO choices on the email step (#14101).
login_workos :: (s: [] LoginScreen, offered: bool) #export_c #effects(all) { if s.count > 0 { s[0].workos = offered; } }
login_env :: (s: [] LoginScreen, safe_top: f32, safe_bottom: f32, keyboard: f32, reduced: bool, scene: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].safe_top = ifx safe_top > 0 then safe_top else 0.0f32; s[0].safe_bottom = ifx safe_bottom > 0 then safe_bottom else 0.0f32;
  s[0].keyboard = ifx keyboard > 0 then keyboard else 0.0f32; s[0].reduced = reduced; s[0].scene = scene;
}
// One frame of width by height device pixels. Returns the vertex count. A frame the surface
// refuses (something did not fit) is counted, and the frame committed before is drawn again.
login_frame :: (s: [] LoginScreen, out: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int #export_c #effects(all) {
  if s.count < 1 || width < 1 || height < 1 { return 0; }
  if !s[0].ready { lg_init(s); }
  a := s[0].atlas[..];
  d := (ifx dpr < 1 then 1.0f32 else dpr) * LG_SCALE;
  w := width / d; h := height / d;
  s[0].d = d; s[0].width = w; s[0].height = h;
  t := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  if !s[0].reduced { s[0].time += t; }
  a[0].frame += 1;
  k := arcade_phone_skin();
  v := 0;
  // a card: the scrim over the screen behind it, coming up with the card. Else, with no scene behind, the plain canvas colour
  if s[0].card { scrim := opacity(arcade_scrim(), am_unit(s[0].entered)); v = paint_quad(out, 0, d, 0, 0, w, h, 0, 0, scrim, scrim); }
  else if !s[0].scene { v = paint_quad(out, 0, d, 0, 0, w, h, 0, 0, k.canvas, k.canvas); }
  if !a[0].ready { return v; }
  f: [1] UiFrame;
  input := uiinput(s[0].px, s[0].py, s[0].touching, s[0].touching, cast(string) s[0].pressed[0..<s[0].pressed_n], lg_focus_id(s));
  uiframe_begin(f[..], s[0].surface[..], s[0].keyed[..], measure_font(a), k, input, s[0].time, t, s[0].reduced, false);
  s[0].entered = lg_layout(s, f[..], w, h);
  s[0].moving = uiframe_moving(f[..]);
  if !uiframe_end(f[..], s[0].surface[..]) { s[0].refused += 1; }
  s[0].stamp = lg_stamp(s);
  sh := surface_sheet(s[0].surface[..]);
  v = gpu_draw(out, v, a, d, sh.under[0..<sh.nu], 0, 0, -8, h + 8);
  v = gpu_draw(out, v, a, d, sh.over[0..<sh.no], 0, 0, -8, h + 8);
  gpu_monochrome(out, v);
  return v;
}
// A touch, in device pixels: phase 0 down, 1 moved, 2 up, 3 cancelled. It is routed through the
// committed rows: a part is pressed when the finger lifts on the row it went down on. A tap
// outside the form lets the keyboard go.
login_pointer :: (s: [] LoginScreen, x: f32, y: f32, phase: int) -> bool #export_c #effects(all) {
  if s.count < 1 || !(s[0].d > 0) { return false; }
  ux := x / s[0].d; uy := y / s[0].d;
  s[0].px = ux; s[0].py = uy;
  row := surface_hit(s[0].surface[..], ux, uy);
  id := surface_id(s[0].surface[..], row);
  acts := surface_action(s[0].surface[..], row) != 0;
  was := cast(string) s[0].pressed[0..<s[0].pressed_n];
  if phase == 0 {
    s[0].touching = true; s[0].pressed_n = ifx acts then el_copy(s[0].pressed[..], id) else 0;
    return acts;
  }
  if phase == 1 { if was != id { s[0].pressed_n = 0; } return s[0].pressed_n > 0; }
  held := s[0].pressed_n > 0 && was == id;
  s[0].touching = false; s[0].pressed_n = 0;
  if phase != 2 { return false; }
  if held { return lg_press_row(s, row); }
  // outside the form: the keyboard goes; with no keyboard, a card closes
  if row < 0 && s[0].focus != LG_FIELD_NONE { s[0].focus = LG_FIELD_NONE; return true; }
  if row < 0 && s[0].card && s[0].busy == LG_ACT_NONE && !s[0].done { s[0].action = LG_ACT_CLOSE; return true; }
  return false;
}
// The action the host is asked for (LG_ACT_*), once.
login_action :: (s: [] LoginScreen) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  act := s[0].action; s[0].action = LG_ACT_NONE;
  return act;
}
// The host's answer to an action. ok: the email was sent, or the code was accepted. message: the
// server's own words for a refusal ("" for the screen's).
login_reply :: (s: [] LoginScreen, action: int, ok: bool, message: string) #export_c #effects(all) {
  if s.count < 1 || action != s[0].busy { return; }
  s[0].busy = LG_ACT_NONE;
  if action == LG_ACT_START {
    if !ok { lg_note(s, ifx message.count > 0 then message else "The email could not be requested. Try again.", true); return; }
    s[0].step = LG_STEP_CODE; eb_clear(s[0].code[..]); lg_note(s, "We sent a code to your email.", false); s[0].focus = LG_FIELD_CODE;
    return;
  }
  if action == LG_ACT_VERIFY {
    if !ok { eb_clear(s[0].code[..]); lg_note(s, ifx message.count > 0 then message else "The code was not accepted. Try again.", true); s[0].focus = LG_FIELD_CODE; return; }
    s[0].done = true; s[0].focus = LG_FIELD_NONE; lg_note(s, "", false);
    return;
  }
  if action == LG_ACT_APPLE || action == LG_ACT_GOOGLE || action == LG_ACT_GITHUB || action == LG_ACT_SSO {
    if !ok { lg_note(s, ifx message.count > 0 then message else "Sign-in did not complete. Try again.", message.count > 0); return; }
    s[0].done = true; s[0].focus = LG_FIELD_NONE; lg_note(s, "", false);
  }
}
// The whole value of a field after an edit in the platform editor.
login_set_text :: (s: [] LoginScreen, field: int, text: string) #export_c #effects(all) { if s.count > 0 { lg_set(s, field, text); } }
// A field's value into out: its length.
login_text :: (s: [] LoginScreen, field: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  if field == LG_FIELD_EMAIL { return lg_out(out, lg_email(s)); }
  if field == LG_FIELD_CODE { return lg_out(out, lg_code(s)); }
  return 0;
}
// Return in the editor: the step's action.
login_submit :: (s: [] LoginScreen) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  return lg_press(s, ifx s[0].step == LG_STEP_CODE then LG_HIT_VERIFY else LG_HIT_SEND);
}
// The field that holds the keyboard (LG_FIELD_*), and the host saying the keyboard went away.
login_focus :: (s: [] LoginScreen) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return s[0].focus; }
login_blur :: (s: [] LoginScreen) #export_c #effects(all) { if s.count > 0 { s[0].focus = LG_FIELD_NONE; } }
// A field's committed box, in points: x, y, w, h, then where its text starts inside it. False when it is not shown.
login_field :: (s: [] LoginScreen, field: int, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 5 || field < 1 || field > 2 { return false; }
  t := [1] ElTable.[lg_rows(s)];
  i := elt_find(t[..], ifx field == LG_FIELD_CODE then "login.code" else "login.email");
  if i < 0 { return false; }
  r := t[0].rows[i];
  out[0] = r.x * LG_SCALE; out[1] = r.y * LG_SCALE; out[2] = r.w * LG_SCALE; out[3] = r.h * LG_SCALE;
  out[4] = form_field_inset(arcade_phone_skin()) * LG_SCALE;
  return true;
}
// How the platform editor is styled, from the skin: the text's size and line (points), then the
// ink, the placeholder's ink and the caret's, each straight RGBA.
login_editor :: (out: [] f32) -> bool #export_c #effects(all) {
  if out.count < 14 { return false; }
  k := arcade_phone_skin();
  out[0] = k.body.size * LG_SCALE; out[1] = k.body.line * LG_SCALE;
  out[2] = k.ink.r; out[3] = k.ink.g; out[4] = k.ink.b; out[5] = k.ink.a;
  out[6] = k.faint.r; out[7] = k.faint.g; out[8] = k.faint.b; out[9] = k.faint.a;
  out[10] = k.accent.r; out[11] = k.accent.g; out[12] = k.accent.b; out[13] = k.accent.a;
  return true;
}
// The form's panel for the scene behind it, in points: x, y, w, h and its corner.
login_form :: (s: [] LoginScreen, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 5 { return false; }
  t := [1] ElTable.[lg_rows(s)];
  i := elt_find(t[..], "login.form");
  if i < 0 { return false; }
  r := t[0].rows[i];
  out[0] = r.x * LG_SCALE; out[1] = r.y * LG_SCALE; out[2] = r.w * LG_SCALE; out[3] = r.h * LG_SCALE;
  out[4] = arcade_phone_skin().animated.frame_square_limit * LG_SCALE;
  return true;
}
// Whether the next frame differs with no input: the entry, the keyboard's move, the activity mark.
login_moving :: (s: [] LoginScreen) -> bool #export_c #effects(all) { return s.count > 0 && lg_moving(s); }
login_done :: (s: [] LoginScreen) -> bool #export_c #effects(all) { return s.count > 0 && s[0].done; }
// Frames the surface refused since the screen opened (0 on a surface sized for its screen).
login_refused :: (s: [] LoginScreen) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return s[0].refused; }
login_scale :: () -> f32 #export_c #effects(all) { return LG_SCALE; }
login_max_vertices :: () -> int #export_c #effects(all) { return LG_MAX_VERTICES; }

// ---- the committed semantic rows, for the accessibility bridge and the driver

login_rows :: (s: [] LoginScreen) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return lg_rows(s).n; }
login_rows_stamp :: (s: [] LoginScreen) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return s[0].stamp; }
// Row i: its box in points (x, y, w, h), its role (components/core/elements.coax EL_*), its state
// (EL_S_* bits) and its parent row (-1: none).
login_row :: (s: [] LoginScreen, i: int, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 7 { return false; }
  t := [1] ElTable.[lg_rows(s)];
  if !elt_ok(t[..], i) { return false; }
  r := t[0].rows[i];
  out[0] = r.x * LG_SCALE; out[1] = r.y * LG_SCALE; out[2] = r.w * LG_SCALE; out[3] = r.h * LG_SCALE;
  out[4] = cast(f32) r.role; out[5] = cast(f32) r.state; out[6] = cast(f32) r.parent;
  return true;
}
login_row_id :: (s: [] LoginScreen, i: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  t := [1] ElTable.[lg_rows(s)]; return lg_out(out, elt_id(t[..], i));
}
login_row_label :: (s: [] LoginScreen, i: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  t := [1] ElTable.[lg_rows(s)]; return lg_out(out, elt_label(t[..], i));
}
login_row_value :: (s: [] LoginScreen, i: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  t := [1] ElTable.[lg_rows(s)]; return lg_out(out, elt_value_of(t[..], i));
}
// Activating a row by its id does what a tap on it does.
login_activate :: (s: [] LoginScreen, id: string) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  return lg_press_row(s, lg_find(s, id));
}
// coax drive: `tree`, `tap ID` and `type ID TEXT` over the same rows, and `counts` (the surface's
// and the keyed store's). The answer's length, or -1 for an operation it doesn't know.
login_drive :: (s: [] LoginScreen, op: string, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return -1; }
  if op == "tree" { return surface_tree(s[0].surface[..], out); }
  if op == "counts" { return uiframe_counts(s[0].surface[..], s[0].keyed[..], out); }
  if op.count > 4 && op[0..<4] == "tap " {
    row := lg_find(s, cast(string) op[4..<op.count]);
    if row < 0 { return lg_out(out, "no such row\n"); }
    return lg_out(out, ifx lg_press_row(s, row) then "tapped\n" else "nothing to press\n");
  }
  if op.count > 5 && op[0..<5] == "type " {
    rest := cast(string) op[5..<op.count];
    cut := 0; while cut < rest.count && rest[cut] != ' ' { cut += 1; }
    id := cast(string) rest[0..<cut]; text := ifx cut < rest.count then cast(string) rest[cut + 1..<rest.count] else "";
    field := ifx id == "login.email" then LG_FIELD_EMAIL else ifx id == "login.code" then LG_FIELD_CODE else LG_FIELD_NONE;
    if field == LG_FIELD_NONE || lg_find(s, id) < 0 { return lg_out(out, "no such field\n"); }
    lg_set(s, field, text);
    return lg_out(out, "typed\n");
  }
  return -1;
}

// ---------------------------------------------------------------- checks

LgOut :: struct { v: [LG_MAX_VERTICES * GP_VERTEX_FLOATS] f32; }
// A fixed atlas: every glyph 8 wide.
lg_test_atlas :: (a: [] Atlas) { text_test_atlas(a); gp_set_atlas(a, 4096, 4096, 2); }
// A screen on a 402 by 874 point phone at 3x.
lg_test_frame :: (s: [] LoginScreen, o: [] LgOut) -> int { return login_frame(s, o[0].v[..], 1206, 2622, 3, 0.016); }
lg_test_text :: (s: [] LoginScreen, text: string) -> int {
  sh := surface_sheet(s[0].surface[..]); n := 0;
  for i: 0..<sh.no { if sh.over[i].kind == PRIM_TEXT && sh.over[i].text == text { n += 1; } }
  return n;
}
// A finger down and up on the middle of a committed row (its box is in units; the pointer is in device px).
lg_test_tap :: (s: [] LoginScreen, id: string) -> bool {
  i := lg_find(s, id); if i < 0 { return false; }
  r := lg_rows(s).rows[i]; x := (r.x + r.w / 2) * s[0].d; y := (r.y + r.h / 2) * s[0].d;
  _ := login_pointer(s, x, y, 0);
  return login_pointer(s, x, y, 2);
}
lg_test_has :: (s: [] LoginScreen, id: string, state: int) -> bool { t := [1] ElTable.[lg_rows(s)]; return elt_has(t[..], lg_find(s, id), state); }

#test "login: email, then the code, through the host's two actions; the page says Log in" #steps 900000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_env(s[..], 59, 34, 0, true, true);
  n := lg_test_frame(s[..], o[..]);
  #assert n > 0 && lg_test_text(s[..], "Log in") == 1 && lg_test_text(s[..], "Send code") == 1 && lg_test_text(s[..], "you@example.com") == 1;
  #assert lg_test_text(s[..], "Sign in") == 0 && login_refused(s[..]) == 0;
  // an empty email asks for one, and starts nothing
  #assert lg_test_tap(s[..], "login.send") && login_action(s[..]) == LG_ACT_NONE && s[0].failure && login_focus(s[..]) == LG_FIELD_EMAIL;
  login_set_text(s[..], LG_FIELD_EMAIL, "ada@example.com");
  #assert !s[0].failure && s[0].note_n == 0;
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_tap(s[..], "login.send") && login_action(s[..]) == LG_ACT_START && login_action(s[..]) == LG_ACT_NONE;
  // busy: the action says so, and nothing can be pressed
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_text(s[..], "Sending code…") == 1 && !lg_test_tap(s[..], "login.send") && !lg_test_tap(s[..], "login.email") && login_moving(s[..]) == false;
  #assert lg_test_has(s[..], "login.send", EL_S_BUSY | EL_S_DISABLED) && lg_test_has(s[..], "login.email", EL_S_DISABLED);
  buf: [300] u8; #assert cast(string) buf[0..<login_text(s[..], LG_FIELD_EMAIL, buf[..])] == "ada@example.com";
  // a refusal keeps the step and shows the server's words
  login_reply(s[..], LG_ACT_START, false, "Too many emails. Try again in a minute.");
  _ := lg_test_frame(s[..], o[..]);
  #assert s[0].step == LG_STEP_EMAIL && s[0].failure && lg_find(s[..], "login.note") >= 0 && lg_test_has(s[..], "login.note", EL_S_LIVE);
  #assert lg_test_tap(s[..], "login.send") && login_action(s[..]) == LG_ACT_START;
  login_reply(s[..], LG_ACT_START, true, "");
  _ := lg_test_frame(s[..], o[..]);
  #assert s[0].step == LG_STEP_CODE && login_focus(s[..]) == LG_FIELD_CODE && lg_test_text(s[..], "Email code") == 1 && lg_test_text(s[..], "ada@example.com") == 1;
  #assert lg_find(s[..], "login.code") >= 0 && lg_find(s[..], "login.email") < 0 && lg_find(s[..], "login.resend") >= 0 && lg_find(s[..], "login.change") >= 0 && lg_find(s[..], "login.sent") >= 0;
  // no code: nothing is verified
  #assert lg_test_tap(s[..], "login.verify") && login_action(s[..]) == LG_ACT_NONE;
  login_set_text(s[..], LG_FIELD_CODE, "123456");
  #assert login_submit(s[..]) && login_action(s[..]) == LG_ACT_VERIFY;
  // a wrong code clears the field and keeps the keyboard there
  login_reply(s[..], LG_ACT_VERIFY, false, "That code isn't right. 4 tries left.");
  _ := lg_test_frame(s[..], o[..]);
  #assert !login_done(s[..]) && lg_code(s[..]).count == 0 && login_focus(s[..]) == LG_FIELD_CODE && s[0].failure;
  login_set_text(s[..], LG_FIELD_CODE, "415926");
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_tap(s[..], "login.verify") && login_action(s[..]) == LG_ACT_VERIFY;
  login_reply(s[..], LG_ACT_VERIFY, true, "");
  #assert login_done(s[..]) && login_focus(s[..]) == LG_FIELD_NONE && !lg_test_tap(s[..], "login.verify");
  // an answer to an action that is not in flight changes nothing
  login_reply(s[..], LG_ACT_START, false, "late");
  #assert login_done(s[..]) && s[0].note_n == 0;
}

#test "login: resend clears the code, change email goes back, and the key login is asked of the host" #steps 900000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_env(s[..], 59, 34, 0, true, false);
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_tap(s[..], "login.key") && login_action(s[..]) == LG_ACT_KEY;
  login_set_text(s[..], LG_FIELD_EMAIL, "ada@example.com");
  #assert login_submit(s[..]) && login_action(s[..]) == LG_ACT_START;
  login_reply(s[..], LG_ACT_START, true, "");
  login_set_text(s[..], LG_FIELD_CODE, "12");
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_tap(s[..], "login.resend") && login_action(s[..]) == LG_ACT_START && lg_code(s[..]).count == 0;
  login_reply(s[..], LG_ACT_START, true, "");
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_tap(s[..], "login.change") && s[0].step == LG_STEP_EMAIL && login_focus(s[..]) == LG_FIELD_EMAIL && lg_email(s[..]) == "ada@example.com";
  // values past their bounds are refused whole
  long: [300] u8; for i: 0..<300 { long[i] = 'a'; }
  login_set_text(s[..], LG_FIELD_EMAIL, cast(string) long[..]);
  #assert lg_email(s[..]) == "ada@example.com";
}

#test "login: the focused field paints its frame only, and reports its committed box for the platform editor" #steps 900000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_env(s[..], 59, 34, 0, true, true);
  login_set_text(s[..], LG_FIELD_EMAIL, "ada@example.com");
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_text(s[..], "ada@example.com") == 1;
  #assert lg_test_tap(s[..], "login.email") && login_focus(s[..]) == LG_FIELD_EMAIL;
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_text(s[..], "ada@example.com") == 0 && lg_test_text(s[..], "you@example.com") == 0 && lg_test_has(s[..], "login.email", EL_S_FOCUSED);
  box: [5] f32; #assert login_field(s[..], LG_FIELD_EMAIL, box[..]) && !login_field(s[..], LG_FIELD_CODE, box[..]);
  row: [7] f32; #assert login_row(s[..], lg_find(s[..], "login.email"), row[..]);
  #assert box[0] == row[0] && box[1] == row[1] && box[2] == row[2] && abs(box[3] - 44 * LG_SCALE) < 0.01 && box[4] > 0;
  // a tap outside the form lets the keyboard go, and the text is painted again
  _ := login_pointer(s[..], 30, 300, 0); #assert login_pointer(s[..], 30, 300, 2) && login_focus(s[..]) == LG_FIELD_NONE;
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_text(s[..], "ada@example.com") == 1;
  // a tap on the form's own ground keeps it
  #assert lg_test_tap(s[..], "login.email"); _ := lg_test_frame(s[..], o[..]);
  form: [5] f32; #assert login_form(s[..], form[..]);
  _ := login_pointer(s[..], (form[0] + 4) * 3, (form[1] + 4) * 3, 0); #assert !login_pointer(s[..], (form[0] + 4) * 3, (form[1] + 4) * 3, 2) && login_focus(s[..]) == LG_FIELD_EMAIL;
  style: [14] f32; #assert login_editor(style[..]) && abs(style[0] - 14 * LG_SCALE) < 0.01 && style[2] == style[3] && style[10] == 1;
}

#test "login: every control records a committed row with a stable id, a role, a label, its state, its value and a 44 point target" #steps 900000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_env(s[..], 59, 34, 0, true, true);
  _ := lg_test_frame(s[..], o[..]);
  ids := [5] string.["login.form", "login.title", "login.email", "login.send", "login.key"]; roles := [5] int.[EL_REGION, EL_HEADING, EL_FIELD, EL_BUTTON, EL_BUTTON];
  labels := [5] string.["Log in", "Log in", "Email address", "Send code", "Nostr key"];
  #assert login_rows(s[..]) == 5;
  for i: 0..<5 {
    row: [7] f32; b: [64] u8;
    #assert login_row(s[..], i, row[..]) && cast(string) b[0..<login_row_id(s[..], i, b[..])] == ids[i] && cast(string) b[0..<login_row_label(s[..], i, b[..])] == labels[i];
    #assert cast(int) row[4] == roles[i] && row[0] >= 0 && row[0] + row[2] <= 402 && row[1] >= 59 && row[1] + row[3] <= 874 - 34;
    #assert cast(int) row[6] == (ifx i == 0 then -1 else 0);    // the form's region is the parent of its parts
    if roles[i] == EL_FIELD || roles[i] == EL_BUTTON { #assert row[3] >= 44 && row[2] >= 44; }
  }
  row: [7] f32; #assert !login_row(s[..], 5, row[..]);
  // the rows are the hits: activation does the same as the tap, and only a row with an action can be pressed
  stamp := login_rows_stamp(s[..]);
  #assert login_activate(s[..], "login.email") && login_focus(s[..]) == LG_FIELD_EMAIL && !login_activate(s[..], "login.code") && !login_activate(s[..], "login.title") && !login_activate(s[..], "nothing");
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_has(s[..], "login.email", EL_S_FOCUSED) && login_rows_stamp(s[..]) != stamp;
  out: [600] u8; n := login_drive(s[..], "tree", out[..]);
  #assert el_has(cast(string) out[0..<n], "login.send button \"Send code\"") && el_has(cast(string) out[0..<n], "login.email field \"Email address\"");
  n = login_drive(s[..], "type login.email ada@example.com", out[..]); #assert cast(string) out[0..<n] == "typed\n" && lg_email(s[..]) == "ada@example.com";
  // the field's row carries its value
  _ := lg_test_frame(s[..], o[..]);
  v: [64] u8; #assert cast(string) v[0..<login_row_value(s[..], lg_find(s[..], "login.email"), v[..])] == "ada@example.com";
  n = login_drive(s[..], "tap login.send", out[..]); #assert cast(string) out[0..<n] == "tapped\n" && login_action(s[..]) == LG_ACT_START;
  n = login_drive(s[..], "counts", out[..]); #assert el_has(cast(string) out[0..<n], "refused 0") && el_has(cast(string) out[0..<n], "keyed 1/");
  #assert login_drive(s[..], "dance", out[..]) == -1;
}

#test "login: the form rests low, rises clear of the keyboard, and stays inside small and large screens" #steps 900000000 {
  sizes := [3] f32.[320, 402, 1024]; heights := [3] f32.[568, 874, 1366];
  for q: 0..<3 {
    s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
    login_env(s[..], 20, 0, 0, true, true);
    _ := login_frame(s[..], o[0].v[..], sizes[q] * 3, heights[q] * 3, 3, 0.016);
    form: [5] f32; #assert login_form(s[..], form[..]);
    #assert form[0] >= 0 && form[0] + form[2] <= sizes[q] && form[1] >= 20 && form[1] + form[3] <= heights[q] && form[2] <= LG_PANEL_MAX * LG_SCALE + 0.01;
    rest := form[1];
    login_env(s[..], 20, 0, 336, true, true);
    _ := login_frame(s[..], o[0].v[..], sizes[q] * 3, heights[q] * 3, 3, 0.016);
    #assert login_form(s[..], form[..]);
    if heights[q] - 336 >= form[3] + 20 + 2 * 12 * LG_SCALE { #assert form[1] + form[3] <= heights[q] - 336 && form[1] >= 20; }
    #assert form[1] <= rest && login_refused(s[..]) == 0;
    sh := surface_sheet(s[0].surface[..]);
    for i: 0..<sh.nh { hit := sh.hits[i]; #assert hit.h >= 44 && hit.x >= 0 && (hit.x + hit.w) * LG_SCALE <= sizes[q] + 0.01 && uiframe_hit_row(hit) >= 0; }
  }
}

#test "login: the form enters with the kit's motion, sleeps when nothing moves, and reduced motion shows it at once" #steps 900000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_env(s[..], 59, 34, 0, false, true);
  #assert login_moving(s[..]);
  _ := lg_test_frame(s[..], o[..]);
  early := s[0].entered; form: [5] f32; #assert login_form(s[..], form[..]); y0 := form[1];
  #assert early > 0 && early < 1 && login_moving(s[..]);
  for i: 0..<40 { _ := lg_test_frame(s[..], o[..]); }
  #assert s[0].entered == 1 && login_form(s[..], form[..]) && form[1] < y0 && !login_moving(s[..]);
  // a still screen draws the same vertices again: the host presents nothing
  a: [1] LgOut; n := lg_test_frame(s[..], a[..]); m := lg_test_frame(s[..], o[..]);
  #assert n == m; for i: 0..<n * GP_VERTEX_FLOATS { #assert a[0].v[i] == o[0].v[i]; }
  // every vertex is grey
  for i: 0..<n { at := i * GP_VERTEX_FLOATS; #assert o[0].v[at + 12] == o[0].v[at + 13] && o[0].v[at + 13] == o[0].v[at + 14]; }
  // a press lights the action while the finger is down, from the frame's input
  r0 := lg_rows(s[..]).rows[lg_find(s[..], "login.send")];
  _ := login_pointer(s[..], (r0.x + 4) * s[0].d, (r0.y + 4) * s[0].d, 0); _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_has(s[..], "login.send", EL_S_PRESSED);
  _ := login_pointer(s[..], 0, 0, 3); _ := lg_test_frame(s[..], o[..]);
  #assert !lg_test_has(s[..], "login.send", EL_S_PRESSED);
  // the keyboard moves it on its keyed spring, then it rests again
  login_env(s[..], 59, 34, 336, false, true);
  _ := lg_test_frame(s[..], o[..]); #assert login_moving(s[..]);
  for i: 0..<300 { _ := lg_test_frame(s[..], o[..]); }
  #assert !login_moving(s[..]) && login_form(s[..], form[..]) && form[1] + form[3] <= 874 - 336;
  // reduced motion: entered in one frame, never moving, even while busy
  r: [1] LoginScreen; lg_test_atlas(r[0].atlas[..]); login_env(r[..], 59, 34, 0, true, true);
  _ := lg_test_frame(r[..], o[..]);
  #assert r[0].entered == 1 && !login_moving(r[..]);
  login_set_text(r[..], LG_FIELD_EMAIL, "a@b.c"); #assert login_submit(r[..]) && !login_moving(r[..]);
}

#test "login: with no scene the form is on the plain canvas colour; with one the canvas is left clear" #steps 900000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_env(s[..], 59, 34, 0, true, false);
  plain := lg_test_frame(s[..], o[..]);
  // the first quad covers the screen
  #assert o[0].v[0] <= 0 && o[0].v[1] <= 0;
  login_env(s[..], 59, 34, 0, true, true);
  over := lg_test_frame(s[..], o[..]);
  #assert plain == over + 6 && lg_test_text(s[..], "Log in") == 1;
  // before the atlas is ready the plain screen is still the canvas, and nothing else
  e: [1] LoginScreen; login_env(e[..], 0, 0, 0, true, false);
  #assert lg_test_frame(e[..], o[..]) == 6;
  login_env(e[..], 0, 0, 0, true, true); #assert lg_test_frame(e[..], o[..]) == 0;
}

#test "login: as a card it dims the screen behind it, sits higher, and closes by Cancel or a tap outside it" #steps 900000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_card(s[..], true); login_env(s[..], 59, 34, 0, true, false);
  n := lg_test_frame(s[..], o[..]); n = lg_test_frame(s[..], o[..]);
  // the first quad is the scrim: it covers the screen
  #assert n > 6 && o[0].v[0] <= 0 && o[0].v[1] <= 0;
  form: [5] f32; #assert login_form(s[..], form[..]) && form[1] + form[3] / 2 < 874 * 0.5;
  #assert lg_find(s[..], "login.close") >= 0 && lg_find(s[..], "login.key") >= 0 && lg_test_text(s[..], "Cancel") == 1;
  #assert lg_test_tap(s[..], "login.close") && login_action(s[..]) == LG_ACT_CLOSE;
  // a tap outside: first the keyboard goes, then the card closes
  #assert lg_test_tap(s[..], "login.email"); _ := lg_test_frame(s[..], o[..]);
  _ := login_pointer(s[..], 30, 300, 0); #assert login_pointer(s[..], 30, 300, 2) && login_focus(s[..]) == LG_FIELD_NONE && login_action(s[..]) == LG_ACT_NONE;
  _ := login_pointer(s[..], 30, 300, 0); #assert login_pointer(s[..], 30, 300, 2) && login_action(s[..]) == LG_ACT_CLOSE;
  // while an action is in flight it stays
  login_set_text(s[..], LG_FIELD_EMAIL, "ada@example.com"); #assert login_submit(s[..]) && login_action(s[..]) == LG_ACT_START;
  _ := login_pointer(s[..], 30, 300, 0); #assert !login_pointer(s[..], 30, 300, 2) && login_action(s[..]) == LG_ACT_NONE;
  // the full screen has no Cancel and does not close
  t: [1] LoginScreen; lg_test_atlas(t[0].atlas[..]); login_env(t[..], 59, 34, 0, true, true);
  _ := lg_test_frame(t[..], o[..]);
  #assert lg_find(t[..], "login.close") < 0; _ := login_pointer(t[..], 30, 300, 0); #assert !login_pointer(t[..], 30, 300, 2) && login_action(t[..]) == LG_ACT_NONE;
}

#test "login: WorkOS mode renders Apple, Google, GitHub, and SSO links cleanly without overlap" #steps 900000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_workos(s[..], true); login_env(s[..], 59, 34, 0, true, true);
  _ := lg_test_frame(s[..], o[..]);
  #assert s[0].refused == 0;
  ia := lg_find(s[..], "login.apple"); ig := lg_find(s[..], "login.google"); ih := lg_find(s[..], "login.github"); is := lg_find(s[..], "login.sso");
  #assert ia >= 0 && ig >= 0 && ih >= 0 && is >= 0;
  rows := lg_rows(s[..]);
  #assert rows.rows[ia].x + rows.rows[ia].w <= rows.rows[ig].x;
  #assert rows.rows[ig].x + rows.rows[ig].w <= rows.rows[ih].x;
  #assert rows.rows[ih].x + rows.rows[ih].w <= rows.rows[is].x;
  #assert lg_test_tap(s[..], "login.apple") && login_action(s[..]) == LG_ACT_APPLE;
  login_reply(s[..], LG_ACT_APPLE, false, "Sign-in cancelled.");
  #assert !s[0].done && s[0].busy == LG_ACT_NONE;
  #assert lg_test_tap(s[..], "login.google") && login_action(s[..]) == LG_ACT_GOOGLE;
  login_reply(s[..], LG_ACT_GOOGLE, true, "");
  #assert s[0].done && s[0].busy == LG_ACT_NONE;
  // Password link in WorkOS mode triggers LG_ACT_PW
  p: [1] LoginScreen; lg_test_atlas(p[0].atlas[..]);
  login_workos(p[..], true); login_env(p[..], 59, 34, 0, true, true);
  _ := lg_test_frame(p[..], o[..]);
  #assert p[0].refused == 0 && lg_find(p[..], "login.password") >= 0;
  #assert lg_test_tap(p[..], "login.password") && login_action(p[..]) == LG_ACT_PW;
}
