// The native login screen, drawn by the shared display-list kit over a live
// GPU scene (components/gpu-components.md, "The first screen: login", stage
// G1; GitHub #13645). Email, then the code; the page says "Log in". It is
// compiled Coax linked into the app, like the component gallery, and does
// not run in the JavaScript runtime or depend on Updates.
//
// This file is the screen's state, layout, paint and semantics. It has no
// effects: the host (apps/shared/login/host.c and apps/shared/native/
// NativeLogin.swift on iOS) owns the GPU surface, the keyboard and the
// account. Each frame the host
//   - gives the window's facts (login_env: safe areas, the keyboard, reduced
//     motion, whether a scene is drawn behind) and asks for the frame's
//     vertices (login_frame);
//   - takes the action the screen asks for (login_action: start the email,
//     verify the code, open the key login) and answers it (login_reply). The
//     host calls the native auth adapter; no token or pending handle ever
//     enters this file;
//   - places the platform editor over the focused field (login_focus,
//     login_field) and sends back the whole value on each edit (login_set_text).
//     While a field holds the keyboard the screen paints its frame only, so
//     there is one caret and one set of glyphs;
//   - reads the semantic rows (login_rows, login_row...) for VoiceOver, and
//     activates one by id (login_activate), which does what a tap does. The
//     same rows answer the driver (login_drive: tree, tap ID, type ID TEXT).
//
// The form is the form set (components/kit/form.coax) in the phone skin
// (components/skin/arcade.coax). Layout is in the skin's units, drawn
// LG_SCALE times larger so its 14-unit text is read at phone size; every
// number the host sees is in points.
//   coax/bin/coax test apps/shared/login/screen.coax

#load "../../../components/kit/form.coax";
#load "../../../components/core/elements.coax";
#load "../../../components/core/edit.coax";
#load "../../../components/skin/arcade.coax";
#load "../../../components/backend/gpu.coax";

LG_SCALE :: 1.2;             // points per layout unit: the atlas is made at the screen's scale times this
LG_MAX_VERTICES :: 16384;
LG_UNDER :: 256; LG_OVER :: 128; LG_HITS :: 16; LG_POOL :: 512; LG_ROWS :: 16;
LG_EMAIL_MAX :: 254; LG_CODE_MAX :: 32; LG_NOTE_MAX :: 240;
LG_PANEL_MAX :: 340.0;       // the form's widest, units
LG_MARGIN :: 14.0;           // the form from the screen's sides, units
LG_REST :: 0.68;             // where the form's middle rests, a share of the screen's height
LG_RISE :: 14.0;             // units the form rises as it enters

// Steps, fields, hits and actions.
LG_STEP_EMAIL :: 0; LG_STEP_CODE :: 1;
LG_FIELD_NONE :: 0; LG_FIELD_EMAIL :: 1; LG_FIELD_CODE :: 2;
LG_HIT_EMAIL :: 1; LG_HIT_CODE :: 2; LG_HIT_SEND :: 3; LG_HIT_VERIFY :: 4; LG_HIT_RESEND :: 5; LG_HIT_CHANGE :: 6; LG_HIT_KEY :: 7;
LG_ACT_NONE :: 0; LG_ACT_START :: 1; LG_ACT_VERIFY :: 2; LG_ACT_KEY :: 3;
// A row's state for the accessibility bridge.
LG_ROW_DISABLED :: 1; LG_ROW_FOCUSED :: 2; LG_ROW_LIVE :: 4; LG_ROW_HEADING :: 8;

LoginScreen :: struct {
  ready: bool; time: f32; d: f32; width: f32; height: f32;     // d: device px per unit; the size in units
  atlas: [1] Atlas; sbytes: [64] u8;
  // the window's facts, in points
  safe_top: f32; safe_bottom: f32; keyboard: f32; reduced: bool; scene: bool;
  step: int; busy: int;                 // busy: the action in flight (LG_ACT_*), or 0
  done: bool;                           // the code was accepted: the host is opening the app
  email: [1] EditBuf; code: [1] EditBuf;
  note: [LG_NOTE_MAX] u8; note_n: int; failure: bool;
  focus: int; down: int;
  action: int;
  enter: [1] ArMotion; rise: [1] UiSpring; placed: bool;
  under: [LG_UNDER] Prim; over: [LG_OVER] Prim; hits: [LG_HITS] SheetHit; pool: [LG_POOL] u8;
  nu: int; no: int; nh: int;
  el: [1] Elements; flags: [LG_ROWS] int; stamp: int;
  panel: [5] f32;                       // the form's panel: x, y, w, h and its corner, units
  fields: [8] f32;                      // each field's box (email, then code): x, y, w, h, units; w 0 when not shown
  lost: int;                            // parts a full sheet could not hold this frame
}

lg_init :: (s: [] LoginScreen) {
  s[0].ready = true;
  s[0].rise[0] = UiSpring.{clamp = false, damping = 26, stiffness = 260};
  ar_motion_to(s[0].enter[..], true, ArcadeMotionSkin.{}.menu, AM_OUT_QUAD);
}
lg_out :: (out: [] u8, text: string) -> int {
  n := 0;
  for c: text { if n >= out.count { break; } out[n] = c; n += 1; }
  return n;
}
lg_note :: (s: [] LoginScreen, text: string, failure: bool) {
  s[0].note_n = lg_out(s[0].note[..], text);
  while s[0].note_n > 0 && s[0].note_n < text.count && (text[s[0].note_n] & 0xC0) == 0x80 { s[0].note_n -= 1; }   // not inside a character
  s[0].failure = failure && s[0].note_n > 0;
}
lg_email :: (s: [] LoginScreen) -> string { return eb_text(s[0].email[..]); }
lg_code :: (s: [] LoginScreen) -> string { return eb_text(s[0].code[..]); }

// The phone skin with what enters faded by p (0..1): the form's frame, text and fields come up together.
lg_skin :: (p: f32) -> UiSkin {
  s := arcade_phone_skin();
  if p >= 1 { return s; }
  s.ink = opacity(s.ink, p); s.muted = opacity(s.muted, p); s.faint = opacity(s.faint, p);
  s.accent = opacity(s.accent, p); s.on_accent = opacity(s.on_accent, p);
  s.surface = opacity(s.surface, p); s.raised = opacity(s.raised, p);
  s.hairline = opacity(s.hairline, p); s.field_edge = opacity(s.field_edge, p); s.hover = opacity(s.hover, p);
  return s;
}

// A semantic row, in points, with its state.
lg_row :: (s: [] LoginScreen, id: string, role: int, label: string, x: f32, y: f32, w: f32, h: f32, flags: int) {
  e := s[0].el[..];
  before := e[0].n;
  el_add(e, id, role, label, x * LG_SCALE, y * LG_SCALE, w * LG_SCALE, h * LG_SCALE);
  if e[0].n > before && before < LG_ROWS { s[0].flags[before] = flags; }
}

// Lays the form out for a screen w by h units, painting it and recording
// its hits and rows. p: the entry's progress.
lg_layout :: (s: [] LoginScreen, w: f32, h: f32, p: f32) {
  a := s[0].atlas[..];
  s[0].nu = 0; s[0].no = 0; s[0].nh = 0; s[0].lost = 0;
  el_clear(s[0].el[..]);
  for i: 0..<LG_ROWS { s[0].flags[i] = 0; }
  for i: 0..<8 { s[0].fields[i] = 0; }
  sh: [1] Sheet; sh[0] = Sheet.{under = s[0].under[..], over = s[0].over[..], hits = s[0].hits[..], pool = s[0].pool[..]};
  k := lg_skin(p); m := measure_font(a);
  code_step := s[0].step == LG_STEP_CODE; busy := s[0].busy != LG_ACT_NONE || s[0].done;
  pw := ifx w - 2 * LG_MARGIN < LG_PANEL_MAX then w - 2 * LG_MARGIN else LG_PANEL_MAX;
  px := (w - pw) / 2; cw := pw - 2 * k.pad;
  // the content's height: the heading, the field, the action, the links and the notice
  title := ifx code_step then "Email code" else "Log in";
  detail := ifx code_step then lg_email(s) else "";
  note := cast(string) s[0].note[0..<s[0].note_n];
  heading_h := k.title.line + (ifx detail.count > 0 then k.body.line else 0.0f32);
  ph := 2 * k.pad + heading_h + k.space + form_field_height(k) + k.space + k.control_h + k.control_h;
  note_h: f32 = 0;
  if note.count > 0 {
    // measured on a scratch sheet, so the panel is as tall as its notice
    scratch_over: [24] Prim; scratch_under: [4] Prim; t: [1] Sheet; t[0] = Sheet.{under = scratch_under[..], over = scratch_over[..]};
    note_h = form_notice(t[..], m, k, 0, 0, cw, note, s[0].failure);
    ph += k.space / 2 + note_h;
  }
  // where it rests: its middle at LG_REST, clear of the keyboard and the safe areas
  top := s[0].safe_top / LG_SCALE + k.space; bottom := h - s[0].safe_bottom / LG_SCALE - k.space;
  if s[0].keyboard > 0 { bottom = h - s[0].keyboard / LG_SCALE - k.space; }
  py := h * LG_REST - ph / 2;
  if py + ph > bottom { py = bottom - ph; }
  if py < top { py = top; }
  // the keyboard and a taller notice move it on a spring
  if !s[0].placed || s[0].reduced { s[0].rise[0].value = py; s[0].rise[0].velocity = 0; s[0].placed = true; }
  s[0].rise[0].target = py;
  py = s[0].rise[0].value + (1 - p) * LG_RISE;
  s[0].panel[0] = px; s[0].panel[1] = py; s[0].panel[2] = pw; s[0].panel[3] = ph; s[0].panel[4] = k.animated.frame_square_limit;
  animated_frame(sh[..], k, px, py, pw, ph, p, 1);
  x := px + k.pad; y := py + k.pad;
  // the heading
  _ := form_heading(sh[..], m, k, x, y, cw, title, detail);
  lg_row(s, "login.title", EL_ITEM, title, x, y, cw, k.title.line, LG_ROW_HEADING);
  if detail.count > 0 { lg_row(s, "login.sent", EL_ITEM, detail, x, y + k.title.line, cw, k.body.line, 0); }
  y += heading_h + k.space;
  // the field
  field := ifx code_step then LG_FIELD_CODE else LG_FIELD_EMAIL;
  focused := s[0].focus == field;
  fh := form_field(sh[..], m, k, x, y, cw, ifx code_step then lg_code(s) else lg_email(s), ifx code_step then "000000" else "you@example.com",
                   focused, focused, busy, ifx code_step then LG_HIT_CODE else LG_HIT_EMAIL, 0);
  at := (field - 1) * 4;
  s[0].fields[at] = x; s[0].fields[at + 1] = y; s[0].fields[at + 2] = cw; s[0].fields[at + 3] = fh;
  lg_row(s, ifx code_step then "login.code" else "login.email", EL_FIELD, ifx code_step then "Email code" else "Email address", x, y, cw, fh,
         (ifx busy then LG_ROW_DISABLED else 0) | (ifx focused then LG_ROW_FOCUSED else 0));
  y += fh + k.space;
  // the action
  hit := ifx code_step then LG_HIT_VERIFY else LG_HIT_SEND;
  label := ifx code_step then (ifx busy then "Checking code…" else "Log in") else (ifx busy then "Sending code…" else "Send code");
  if code_step && s[0].busy == LG_ACT_START { label = "Sending code…"; }
  state := ifx busy then FORM_BUSY else ifx s[0].down == hit then FORM_PRESSED else FORM_PRIMARY;
  bh := form_button(sh[..], m, k, x, y, cw, label, state, s[0].time, s[0].reduced, hit, 0);
  lg_row(s, ifx code_step then "login.verify" else "login.send", EL_BUTTON, label, x, y, cw, bh, ifx busy then LG_ROW_DISABLED else 0);
  y += bh;
  // the quiet actions under it
  if code_step {
    rw := form_link(sh[..], m, k, x - k.space, y, "Resend code", s[0].down == LG_HIT_RESEND, busy, LG_HIT_RESEND, 0);
    lg_row(s, "login.resend", EL_BUTTON, "Resend email code", x - k.space, y, rw, k.control_h, ifx busy then LG_ROW_DISABLED else 0);
    lw := form_link_width(m, k, "Change email");
    _ := form_link(sh[..], m, k, x + cw + k.space - lw, y, "Change email", s[0].down == LG_HIT_CHANGE, busy, LG_HIT_CHANGE, 0);
    lg_row(s, "login.change", EL_BUTTON, "Change email", x + cw + k.space - lw, y, lw, k.control_h, ifx busy then LG_ROW_DISABLED else 0);
  } else {
    lw := form_link_width(m, k, "Use a Nostr key");
    _ := form_link(sh[..], m, k, x + (cw - lw) / 2, y, "Use a Nostr key", s[0].down == LG_HIT_KEY, busy, LG_HIT_KEY, 0);
    lg_row(s, "login.key", EL_BUTTON, "Nostr key", x + (cw - lw) / 2, y, lw, k.control_h, ifx busy then LG_ROW_DISABLED else 0);
  }
  y += k.control_h;
  if note.count > 0 {
    y += k.space / 2;
    _ := form_notice(sh[..], m, k, x, y, cw, note, s[0].failure);
    lg_row(s, "login.note", EL_ITEM, note, x, y, cw, note_h, LG_ROW_LIVE);
  }
  s[0].nu = sh[0].nu; s[0].no = sh[0].no; s[0].nh = sh[0].nh;
  if s[0].nu >= LG_UNDER || s[0].no >= LG_OVER || s[0].nh >= LG_HITS { s[0].lost += 1; }
  s[0].lost += s[0].el[0].lost;
  // what the accessibility bridge compares: the rows' names, state and whole-point boxes
  st := 17;
  for i: 0..<s[0].el[0].n {
    r := s[0].el[0].rows[i];
    for c: el_id(s[0].el[..], i) { st = (st * 31 + cast(int) c) & 0x3fffffff; }
    for c: el_label(s[0].el[..], i) { st = (st * 31 + cast(int) c) & 0x3fffffff; }
    st = (st * 31 + s[0].flags[i]) & 0x3fffffff;
    st = (st * 31 + el_round(r.x) + 7 * el_round(r.y) + 13 * el_round(r.w) + 17 * el_round(r.h)) & 0x3fffffff;
  }
  if code_step { for c: lg_code(s) { st = (st * 31 + cast(int) c) & 0x3fffffff; } } else { for c: lg_email(s) { st = (st * 31 + cast(int) c) & 0x3fffffff; } }
  s[0].stamp = st;
}

lg_hit_at :: (s: [] LoginScreen, x: f32, y: f32) -> int {
  kind := 0;
  for i: 0..<s[0].nh { h := s[0].hits[i]; if x >= h.x && x < h.x + h.w && y >= h.y && y < h.y + h.h { kind = h.kind; } }
  return kind;
}

// What pressing a part does: a tap, VoiceOver's activation and the driver all come here.
lg_press :: (s: [] LoginScreen, kind: int) -> bool {
  if s[0].busy != LG_ACT_NONE || s[0].done { return false; }
  if kind == LG_HIT_EMAIL && s[0].step == LG_STEP_EMAIL { s[0].focus = LG_FIELD_EMAIL; return true; }
  if kind == LG_HIT_CODE && s[0].step == LG_STEP_CODE { s[0].focus = LG_FIELD_CODE; return true; }
  if kind == LG_HIT_SEND && s[0].step == LG_STEP_EMAIL || kind == LG_HIT_RESEND && s[0].step == LG_STEP_CODE {
    if lg_email(s).count == 0 { lg_note(s, "Enter your email address.", true); s[0].focus = LG_FIELD_EMAIL; return true; }
    if kind == LG_HIT_RESEND { eb_clear(s[0].code[..]); }
    lg_note(s, "", false); s[0].busy = LG_ACT_START; s[0].action = LG_ACT_START; return true;
  }
  if kind == LG_HIT_VERIFY && s[0].step == LG_STEP_CODE {
    if lg_code(s).count == 0 { lg_note(s, "Enter the code from your email.", true); s[0].focus = LG_FIELD_CODE; return true; }
    lg_note(s, "", false); s[0].busy = LG_ACT_VERIFY; s[0].action = LG_ACT_VERIFY; return true;
  }
  if kind == LG_HIT_CHANGE && s[0].step == LG_STEP_CODE {
    s[0].step = LG_STEP_EMAIL; eb_clear(s[0].code[..]); lg_note(s, "", false); s[0].focus = LG_FIELD_EMAIL; return true;
  }
  if kind == LG_HIT_KEY && s[0].step == LG_STEP_EMAIL { s[0].focus = LG_FIELD_NONE; s[0].action = LG_ACT_KEY; return true; }
  return false;
}
lg_kind_of :: (id: string) -> int {
  if id == "login.email" { return LG_HIT_EMAIL; }
  if id == "login.code" { return LG_HIT_CODE; }
  if id == "login.send" { return LG_HIT_SEND; }
  if id == "login.verify" { return LG_HIT_VERIFY; }
  if id == "login.resend" { return LG_HIT_RESEND; }
  if id == "login.change" { return LG_HIT_CHANGE; }
  if id == "login.key" { return LG_HIT_KEY; }
  return 0;
}
lg_set :: (s: [] LoginScreen, field: int, text: string) {
  if field == LG_FIELD_EMAIL && text.count <= LG_EMAIL_MAX { eb_set(s[0].email[..], text); }
  if field == LG_FIELD_CODE && text.count <= LG_CODE_MAX { eb_set(s[0].code[..], text); }
}
lg_moving :: (s: [] LoginScreen) -> bool {
  if !s[0].ready { return true; }
  if s[0].reduced { return false; }
  if s[0].enter[0].phase == AM_ENTERING || s[0].enter[0].phase == AM_EXITING { return true; }
  if s[0].busy != LG_ACT_NONE || s[0].done { return true; }       // the activity mark turns
  rest := s[0].rise[0].value - s[0].rise[0].target;
  return rest > 0.05 || rest < -0.05 || s[0].rise[0].velocity > 0.05 || s[0].rise[0].velocity < -0.05;
}

// ---------------------------------------------------------------- the host's calls

// The window's facts, in points. scene: a scene is drawn behind, so the screen leaves the canvas clear.
login_env :: (s: [] LoginScreen, safe_top: f32, safe_bottom: f32, keyboard: f32, reduced: bool, scene: bool) #export_c #effects(all) {
  if s.count < 1 { return; }
  s[0].safe_top = ifx safe_top > 0 then safe_top else 0.0f32; s[0].safe_bottom = ifx safe_bottom > 0 then safe_bottom else 0.0f32;
  s[0].keyboard = ifx keyboard > 0 then keyboard else 0.0f32; s[0].reduced = reduced; s[0].scene = scene;
}
// One frame of width by height device pixels. Returns the vertex count.
login_frame :: (s: [] LoginScreen, out: [] f32, width: f32, height: f32, dpr: f32, dt: f32) -> int #export_c #effects(all) {
  if s.count < 1 || width < 1 || height < 1 { return 0; }
  if !s[0].ready { lg_init(s); }
  a := s[0].atlas[..];
  d := (ifx dpr < 1 then 1.0f32 else dpr) * LG_SCALE;
  w := width / d; h := height / d;
  s[0].d = d; s[0].width = w; s[0].height = h;
  t := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  if !s[0].reduced { s[0].time += t; }
  ar_motion_tick(s[0].enter[..], t);
  if s[0].reduced { s[0].enter[0].value = 1; s[0].enter[0].phase = AM_ENTERED; }
  ui_spring_step(s[0].rise[..], t, s[0].reduced);
  a[0].frame += 1;
  k := arcade_phone_skin();
  v := 0;
  // with no scene behind, the plain canvas colour
  if !s[0].scene { v = paint_quad(out, 0, d, 0, 0, w, h, 0, 0, k.canvas, k.canvas); }
  if !a[0].ready { return v; }
  lg_layout(s, w, h, am_unit(s[0].enter[0].value));
  v = gpu_draw(out, v, a, d, s[0].under[0..<s[0].nu], 0, 0, -8, h + 8);
  v = gpu_draw(out, v, a, d, s[0].over[0..<s[0].no], 0, 0, -8, h + 8);
  gpu_monochrome(out, v);
  return v;
}
// A touch, in device pixels: phase 0 down, 1 moved, 2 up, 3 cancelled. A part is pressed when the
// finger lifts on the part it went down on; a tap on nothing lets the keyboard go.
login_pointer :: (s: [] LoginScreen, x: f32, y: f32, phase: int) -> bool #export_c #effects(all) {
  if s.count < 1 || !(s[0].d > 0) { return false; }
  kind := lg_hit_at(s, x / s[0].d, y / s[0].d);
  if phase == 0 { s[0].down = kind; return kind != 0; }
  if phase == 1 { if kind != s[0].down { s[0].down = 0; } return s[0].down != 0; }
  was := s[0].down; s[0].down = 0;
  if phase != 2 { return false; }
  if was != 0 && was == kind { return lg_press(s, kind); }
  // outside the form: the keyboard goes
  ux := x / s[0].d; uy := y / s[0].d; f := s[0].panel;
  outside := ux < f[0] || ux >= f[0] + f[2] || uy < f[1] || uy >= f[1] + f[3];
  if was == 0 && outside && s[0].focus != LG_FIELD_NONE { s[0].focus = LG_FIELD_NONE; return true; }
  return false;
}
// The action the host is asked for (LG_ACT_*), once.
login_action :: (s: [] LoginScreen) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  act := s[0].action; s[0].action = LG_ACT_NONE;
  return act;
}
// The host's answer to an action. ok: the email was sent, or the code was accepted. message: the
// server's own words for a refusal ("" for the screen's).
login_reply :: (s: [] LoginScreen, action: int, ok: bool, message: string) #export_c #effects(all) {
  if s.count < 1 || action != s[0].busy { return; }
  s[0].busy = LG_ACT_NONE;
  if action == LG_ACT_START {
    if !ok { lg_note(s, ifx message.count > 0 then message else "The email could not be requested. Try again.", true); return; }
    s[0].step = LG_STEP_CODE; eb_clear(s[0].code[..]); lg_note(s, "We sent a code to your email.", false); s[0].focus = LG_FIELD_CODE;
    return;
  }
  if action == LG_ACT_VERIFY {
    if !ok { eb_clear(s[0].code[..]); lg_note(s, ifx message.count > 0 then message else "The code was not accepted. Try again.", true); s[0].focus = LG_FIELD_CODE; return; }
    s[0].done = true; s[0].focus = LG_FIELD_NONE; lg_note(s, "", false);
  }
}
// The whole value of a field after an edit in the platform editor.
login_set_text :: (s: [] LoginScreen, field: int, text: string) #export_c #effects(all) { if s.count > 0 { lg_set(s, field, text); } }
// A field's value into out: its length.
login_text :: (s: [] LoginScreen, field: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  if field == LG_FIELD_EMAIL { return lg_out(out, lg_email(s)); }
  if field == LG_FIELD_CODE { return lg_out(out, lg_code(s)); }
  return 0;
}
// Return in the editor: the step's action.
login_submit :: (s: [] LoginScreen) -> bool #export_c #effects(all) {
  if s.count < 1 { return false; }
  return lg_press(s, ifx s[0].step == LG_STEP_CODE then LG_HIT_VERIFY else LG_HIT_SEND);
}
// The field that holds the keyboard (LG_FIELD_*), and the host saying the keyboard went away.
login_focus :: (s: [] LoginScreen) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return s[0].focus; }
login_blur :: (s: [] LoginScreen) #export_c #effects(all) { if s.count > 0 { s[0].focus = LG_FIELD_NONE; } }
// A field's committed box, in points: x, y, w, h, then where its text starts inside it. False when it is not shown.
login_field :: (s: [] LoginScreen, field: int, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 5 || field < 1 || field > 2 || !(s[0].fields[(field - 1) * 4 + 2] > 0) { return false; }
  for i: 0..<4 { out[i] = s[0].fields[(field - 1) * 4 + i] * LG_SCALE; }
  out[4] = form_field_inset(arcade_phone_skin()) * LG_SCALE;
  return true;
}
// How the platform editor is styled, from the skin: the text's size and line (points), then the
// ink, the placeholder's ink and the caret's, each straight RGBA.
login_editor :: (out: [] f32) -> bool #export_c #effects(all) {
  if out.count < 14 { return false; }
  k := arcade_phone_skin();
  out[0] = k.body.size * LG_SCALE; out[1] = k.body.line * LG_SCALE;
  out[2] = k.ink.r; out[3] = k.ink.g; out[4] = k.ink.b; out[5] = k.ink.a;
  out[6] = k.faint.r; out[7] = k.faint.g; out[8] = k.faint.b; out[9] = k.faint.a;
  out[10] = k.accent.r; out[11] = k.accent.g; out[12] = k.accent.b; out[13] = k.accent.a;
  return true;
}
// The form's panel for the scene behind it, in points: x, y, w, h and its corner.
login_form :: (s: [] LoginScreen, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 5 || !(s[0].panel[2] > 0) { return false; }
  for i: 0..<5 { out[i] = s[0].panel[i] * LG_SCALE; }
  return true;
}
// Whether the next frame differs with no input: the entry, the keyboard's move, the activity mark.
login_moving :: (s: [] LoginScreen) -> bool #export_c #effects(all) { return s.count > 0 && lg_moving(s); }
login_done :: (s: [] LoginScreen) -> bool #export_c #effects(all) { return s.count > 0 && s[0].done; }
login_lost :: (s: [] LoginScreen) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return s[0].lost; }
login_scale :: () -> f32 #export_c #effects(all) { return LG_SCALE; }
login_max_vertices :: () -> int #export_c #effects(all) { return LG_MAX_VERTICES; }

// ---- the semantic rows, for the accessibility bridge and the driver

login_rows :: (s: [] LoginScreen) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return s[0].el[0].n; }
login_rows_stamp :: (s: [] LoginScreen) -> int #export_c #effects(all) { if s.count < 1 { return 0; } return s[0].stamp; }
// Row i: its box in points (x, y, w, h), its role (components/core/elements.coax EL_*) and its state (LG_ROW_*).
login_row :: (s: [] LoginScreen, i: int, out: [] f32) -> bool #export_c #effects(all) {
  if s.count < 1 || out.count < 6 || i < 0 || i >= s[0].el[0].n { return false; }
  r := s[0].el[0].rows[i];
  out[0] = r.x; out[1] = r.y; out[2] = r.w; out[3] = r.h; out[4] = cast(f32) r.role; out[5] = cast(f32) (ifx i < LG_ROWS then s[0].flags[i] else 0);
  return true;
}
login_row_id :: (s: [] LoginScreen, i: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || i < 0 || i >= s[0].el[0].n { return 0; }
  return lg_out(out, el_id(s[0].el[..], i));
}
login_row_label :: (s: [] LoginScreen, i: int, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 || i < 0 || i >= s[0].el[0].n { return 0; }
  return lg_out(out, el_label(s[0].el[..], i));
}
// Activating a row by its id does what a tap on it does.
login_activate :: (s: [] LoginScreen, id: string) -> bool #export_c #effects(all) {
  if s.count < 1 || el_find(s[0].el[..], id) < 0 { return false; }
  return lg_press(s, lg_kind_of(id));
}
// coax drive: `tree`, `tap ID` and `type ID TEXT` over the same rows. The answer's length, or -1 for an operation it doesn't know.
login_drive :: (s: [] LoginScreen, op: string, out: [] u8) -> int #export_c #effects(all) {
  if s.count < 1 { return -1; }
  if op == "tree" { return el_tree(s[0].el[..], out); }
  if op.count > 4 && op[0..<4] == "tap " {
    id := cast(string) op[4..<op.count];
    if el_find(s[0].el[..], id) < 0 { return lg_out(out, "no such row\n"); }
    return lg_out(out, ifx lg_press(s, lg_kind_of(id)) then "tapped\n" else "nothing to press\n");
  }
  if op.count > 5 && op[0..<5] == "type " {
    rest := cast(string) op[5..<op.count];
    cut := 0; while cut < rest.count && rest[cut] != ' ' { cut += 1; }
    id := cast(string) rest[0..<cut]; text := ifx cut < rest.count then cast(string) rest[cut + 1..<rest.count] else "";
    field := ifx id == "login.email" then LG_FIELD_EMAIL else ifx id == "login.code" then LG_FIELD_CODE else LG_FIELD_NONE;
    if field == LG_FIELD_NONE || el_find(s[0].el[..], id) < 0 { return lg_out(out, "no such field\n"); }
    lg_set(s, field, text);
    return lg_out(out, "typed\n");
  }
  return -1;
}

// ---- the atlas's tables, for the host that builds it (the component gallery's fonts and icons)

login_font_count :: () -> int #export_c #effects(all) { return GP_FONTS; }
login_font_size :: (k: int) -> f32 #export_c #effects(all) { sizes := FONT_SIZES; return ifx k >= 0 && k < GP_FONTS then sizes[k] else 14.0f32; }
login_font_weight :: (k: int) -> int #export_c #effects(all) { weights := FONT_WEIGHTS; return ifx k >= 0 && k < GP_FONTS then weights[k] else 0; }

// ---------------------------------------------------------------- checks

LgOut :: struct { v: [LG_MAX_VERTICES * GP_VERTEX_FLOATS] f32; }
// A fixed atlas: every glyph 8 wide.
lg_test_atlas :: (a: [] Atlas) { text_test_atlas(a); gp_set_atlas(a, 4096, 4096, 2); }
// A screen on a 402 by 874 point phone at 3x, entered (reduced motion draws it at once).
lg_test_frame :: (s: [] LoginScreen, o: [] LgOut) -> int { return login_frame(s, o[0].v[..], 1206, 2622, 3, 0.016); }
lg_test_text :: (s: [] LoginScreen, text: string) -> int {
  n := 0;
  for i: 0..<s[0].no { if s[0].over[i].kind == PRIM_TEXT && s[0].over[i].text == text { n += 1; } }
  return n;
}
lg_test_tap :: (s: [] LoginScreen, id: string) -> bool {
  i := el_find(s[0].el[..], id); if i < 0 { return false; }
  r := s[0].el[0].rows[i]; x := (r.x + r.w / 2) * 3; y := (r.y + r.h / 2) * 3;
  _ := login_pointer(s, x, y, 0);
  return login_pointer(s, x, y, 2);
}

#test "login: email, then the code, through the host's two actions; the page says Log in" #steps 600000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_env(s[..], 59, 34, 0, true, true);
  n := lg_test_frame(s[..], o[..]);
  #assert n > 0 && lg_test_text(s[..], "Log in") == 1 && lg_test_text(s[..], "Send code") == 1 && lg_test_text(s[..], "you@example.com") == 1;
  #assert lg_test_text(s[..], "Sign in") == 0 && s[0].lost == 0;
  // an empty email asks for one, and starts nothing
  #assert lg_test_tap(s[..], "login.send") && login_action(s[..]) == LG_ACT_NONE && s[0].failure && login_focus(s[..]) == LG_FIELD_EMAIL;
  login_set_text(s[..], LG_FIELD_EMAIL, "ada@example.com");
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_tap(s[..], "login.send") && login_action(s[..]) == LG_ACT_START && login_action(s[..]) == LG_ACT_NONE;
  // busy: the action says so, and nothing can be pressed
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_text(s[..], "Sending code…") == 1 && !lg_test_tap(s[..], "login.send") && !lg_test_tap(s[..], "login.email") && login_moving(s[..]) == false;
  buf: [300] u8; #assert cast(string) buf[0..<login_text(s[..], LG_FIELD_EMAIL, buf[..])] == "ada@example.com";
  // a refusal keeps the step and shows the server's words
  login_reply(s[..], LG_ACT_START, false, "Too many emails. Try again in a minute.");
  _ := lg_test_frame(s[..], o[..]);
  #assert s[0].step == LG_STEP_EMAIL && s[0].failure && el_find(s[0].el[..], "login.note") >= 0;
  #assert lg_test_tap(s[..], "login.send") && login_action(s[..]) == LG_ACT_START;
  login_reply(s[..], LG_ACT_START, true, "");
  _ := lg_test_frame(s[..], o[..]);
  #assert s[0].step == LG_STEP_CODE && login_focus(s[..]) == LG_FIELD_CODE && lg_test_text(s[..], "Email code") == 1 && lg_test_text(s[..], "ada@example.com") == 1;
  #assert el_find(s[0].el[..], "login.code") >= 0 && el_find(s[0].el[..], "login.email") < 0 && el_find(s[0].el[..], "login.resend") >= 0 && el_find(s[0].el[..], "login.change") >= 0;
  // no code: nothing is verified
  #assert lg_test_tap(s[..], "login.verify") && login_action(s[..]) == LG_ACT_NONE;
  login_set_text(s[..], LG_FIELD_CODE, "123456");
  #assert login_submit(s[..]) && login_action(s[..]) == LG_ACT_VERIFY;
  // a wrong code clears the field and keeps the keyboard there
  login_reply(s[..], LG_ACT_VERIFY, false, "That code isn't right. 4 tries left.");
  _ := lg_test_frame(s[..], o[..]);
  #assert !login_done(s[..]) && lg_code(s[..]).count == 0 && login_focus(s[..]) == LG_FIELD_CODE && s[0].failure;
  login_set_text(s[..], LG_FIELD_CODE, "415926");
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_tap(s[..], "login.verify") && login_action(s[..]) == LG_ACT_VERIFY;
  login_reply(s[..], LG_ACT_VERIFY, true, "");
  #assert login_done(s[..]) && login_focus(s[..]) == LG_FIELD_NONE && !lg_test_tap(s[..], "login.verify");
  // an answer to an action that is not in flight changes nothing
  login_reply(s[..], LG_ACT_START, false, "late");
  #assert login_done(s[..]) && s[0].note_n == 0;
}

#test "login: resend clears the code, change email goes back, and the key login is asked of the host" #steps 600000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_env(s[..], 59, 34, 0, true, false);
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_tap(s[..], "login.key") && login_action(s[..]) == LG_ACT_KEY;
  login_set_text(s[..], LG_FIELD_EMAIL, "ada@example.com");
  #assert login_submit(s[..]) && login_action(s[..]) == LG_ACT_START;
  login_reply(s[..], LG_ACT_START, true, "");
  login_set_text(s[..], LG_FIELD_CODE, "12");
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_tap(s[..], "login.resend") && login_action(s[..]) == LG_ACT_START && lg_code(s[..]).count == 0;
  login_reply(s[..], LG_ACT_START, true, "");
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_tap(s[..], "login.change") && s[0].step == LG_STEP_EMAIL && login_focus(s[..]) == LG_FIELD_EMAIL && lg_email(s[..]) == "ada@example.com";
  // values past their bounds are refused whole
  long: [300] u8; for i: 0..<300 { long[i] = 'a'; }
  login_set_text(s[..], LG_FIELD_EMAIL, cast(string) long[..]);
  #assert lg_email(s[..]) == "ada@example.com";
}

#test "login: the focused field paints its frame only, and reports its box for the platform editor" #steps 600000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_env(s[..], 59, 34, 0, true, true);
  login_set_text(s[..], LG_FIELD_EMAIL, "ada@example.com");
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_text(s[..], "ada@example.com") == 1;
  #assert lg_test_tap(s[..], "login.email") && login_focus(s[..]) == LG_FIELD_EMAIL;
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_text(s[..], "ada@example.com") == 0 && lg_test_text(s[..], "you@example.com") == 0;
  box: [5] f32; #assert login_field(s[..], LG_FIELD_EMAIL, box[..]) && !login_field(s[..], LG_FIELD_CODE, box[..]);
  i := el_find(s[0].el[..], "login.email"); r := s[0].el[0].rows[i];
  #assert box[0] == r.x && box[1] == r.y && box[2] == r.w && abs(box[3] - 44 * LG_SCALE) < 0.01 && box[4] > 0;
  // a tap on nothing lets the keyboard go, and the text is painted again
  _ := login_pointer(s[..], 30, 300, 0); #assert login_pointer(s[..], 30, 300, 2) && login_focus(s[..]) == LG_FIELD_NONE;
  _ := lg_test_frame(s[..], o[..]);
  #assert lg_test_text(s[..], "ada@example.com") == 1;
  style: [14] f32; #assert login_editor(style[..]) && abs(style[0] - 14 * LG_SCALE) < 0.01 && style[2] == style[3] && style[10] == 1;
}

#test "login: every control records a row with a stable id, a role, a label, its state and a 44 point target" #steps 600000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_env(s[..], 59, 34, 0, true, true);
  _ := lg_test_frame(s[..], o[..]);
  ids := [4] string.["login.title", "login.email", "login.send", "login.key"]; roles := [4] int.[EL_ITEM, EL_FIELD, EL_BUTTON, EL_BUTTON];
  labels := [4] string.["Log in", "Email address", "Send code", "Nostr key"];
  #assert login_rows(s[..]) == 4;
  for i: 0..<4 {
    row: [6] f32; b: [64] u8;
    #assert login_row(s[..], i, row[..]) && cast(string) b[0..<login_row_id(s[..], i, b[..])] == ids[i] && cast(string) b[0..<login_row_label(s[..], i, b[..])] == labels[i];
    #assert cast(int) row[4] == roles[i] && row[0] >= 0 && row[0] + row[2] <= 402 && row[1] >= 59 && row[1] + row[3] <= 874 - 34;
    if roles[i] != EL_ITEM { #assert row[3] >= 44 && row[2] >= 44; }
  }
  row: [6] f32; #assert login_row(s[..], 0, row[..]) && cast(int) row[5] == LG_ROW_HEADING && !login_row(s[..], 4, row[..]);
  // the rows are the hits: a row's middle presses its part, and activation does the same as the tap
  stamp := login_rows_stamp(s[..]);
  #assert login_activate(s[..], "login.email") && login_focus(s[..]) == LG_FIELD_EMAIL && !login_activate(s[..], "login.code") && !login_activate(s[..], "nothing");
  _ := lg_test_frame(s[..], o[..]);
  #assert login_row(s[..], 1, row[..]) && (cast(int) row[5] & LG_ROW_FOCUSED) != 0 && login_rows_stamp(s[..]) != stamp;
  out: [512] u8; n := login_drive(s[..], "tree", out[..]);
  #assert el_has(cast(string) out[0..<n], "login.send button \"Send code\"") && el_has(cast(string) out[0..<n], "login.email field \"Email address\"");
  n = login_drive(s[..], "type login.email ada@example.com", out[..]); #assert cast(string) out[0..<n] == "typed\n" && lg_email(s[..]) == "ada@example.com";
  n = login_drive(s[..], "tap login.send", out[..]); #assert cast(string) out[0..<n] == "tapped\n" && login_action(s[..]) == LG_ACT_START;
  #assert login_drive(s[..], "dance", out[..]) == -1;
  // busy rows say they are disabled
  _ := lg_test_frame(s[..], o[..]);
  #assert login_row(s[..], 2, row[..]) && (cast(int) row[5] & LG_ROW_DISABLED) != 0;
}

#test "login: the form rests low, rises clear of the keyboard, and stays inside small and large screens" #steps 900000000 {
  sizes := [3] f32.[320, 402, 1024]; heights := [3] f32.[568, 874, 1366];
  for q: 0..<3 {
    s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
    login_env(s[..], 20, 0, 0, true, true);
    _ := login_frame(s[..], o[0].v[..], sizes[q] * 3, heights[q] * 3, 3, 0.016);
    form: [5] f32; #assert login_form(s[..], form[..]);
    #assert form[0] >= 0 && form[0] + form[2] <= sizes[q] && form[1] >= 20 && form[1] + form[3] <= heights[q] && form[2] <= LG_PANEL_MAX * LG_SCALE + 0.01;
    rest := form[1];
    login_env(s[..], 20, 0, 336, true, true);
    _ := login_frame(s[..], o[0].v[..], sizes[q] * 3, heights[q] * 3, 3, 0.016);
    #assert login_form(s[..], form[..]);
    if heights[q] - 336 >= form[3] + 20 + 2 * 12 * LG_SCALE { #assert form[1] + form[3] <= heights[q] - 336 && form[1] >= 20; }
    #assert form[1] <= rest;
    for i: 0..<s[0].nh { hit := s[0].hits[i]; #assert hit.h >= 44 && hit.x >= 0 && (hit.x + hit.w) * LG_SCALE <= sizes[q] + 0.01; }
  }
}

#test "login: the form enters with the kit's motion, sleeps when nothing moves, and reduced motion shows it at once" #steps 900000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_env(s[..], 59, 34, 0, false, true);
  #assert login_moving(s[..]);
  _ := lg_test_frame(s[..], o[..]);
  early := s[0].enter[0].value; form: [5] f32; #assert login_form(s[..], form[..]); y0 := form[1];
  #assert early > 0 && early < 1 && login_moving(s[..]);
  for i: 0..<40 { _ := lg_test_frame(s[..], o[..]); }
  #assert s[0].enter[0].value == 1 && login_form(s[..], form[..]) && form[1] < y0 && !login_moving(s[..]);
  // a still screen draws the same vertices again: the host presents nothing
  a: [1] LgOut; n := lg_test_frame(s[..], a[..]); m := lg_test_frame(s[..], o[..]);
  #assert n == m; for i: 0..<n * GP_VERTEX_FLOATS { #assert a[0].v[i] == o[0].v[i]; }
  // every vertex is grey
  for i: 0..<n { at := i * GP_VERTEX_FLOATS; #assert o[0].v[at + 12] == o[0].v[at + 13] && o[0].v[at + 13] == o[0].v[at + 14]; }
  // the keyboard moves it on a spring, then it rests again
  login_env(s[..], 59, 34, 336, false, true);
  _ := lg_test_frame(s[..], o[..]); #assert login_moving(s[..]);
  for i: 0..<200 { _ := lg_test_frame(s[..], o[..]); }
  #assert !login_moving(s[..]) && login_form(s[..], form[..]) && form[1] + form[3] <= 874 - 336;
  // reduced motion: entered in one frame, never moving, even while busy
  r: [1] LoginScreen; lg_test_atlas(r[0].atlas[..]); login_env(r[..], 59, 34, 0, true, true);
  _ := lg_test_frame(r[..], o[..]);
  #assert r[0].enter[0].value == 1 && !login_moving(r[..]);
}

#test "login: with no scene the form is on the plain canvas colour; with one the canvas is left clear" #steps 600000000 {
  s: [1] LoginScreen; o: [1] LgOut; lg_test_atlas(s[0].atlas[..]);
  login_env(s[..], 59, 34, 0, true, false);
  plain := lg_test_frame(s[..], o[..]);
  // the first quad covers the screen
  #assert o[0].v[0] <= 0 && o[0].v[1] <= 0;
  login_env(s[..], 59, 34, 0, true, true);
  over := lg_test_frame(s[..], o[..]);
  #assert plain == over + 6 && lg_test_text(s[..], "Log in") == 1;
  // before the atlas is ready the plain screen is still the canvas, and nothing else
  e: [1] LoginScreen; login_env(e[..], 0, 0, 0, true, false);
  #assert lg_test_frame(e[..], o[..]) == 6;
  login_env(e[..], 0, 0, 0, true, true); #assert lg_test_frame(e[..], o[..]) == 0;
}
