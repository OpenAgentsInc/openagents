// Replay account-owned ciphertext through the installed custody provider.
// This consumer schedules existing operations; it cannot establish custody.
#load "nostr-inbox.coax";
#load "../../coax/native/messaging-store-wire.coax";
#load "../../coax/lib/nostr/filter.coax";
#load "../../coax/tests/nostr/nip59_vectors.coax" #test;
#authority;
NostrInboxJournal :: struct {
 generation:int;seed:[64]u8;serial:int;phase:int;busy:bool;action:int;operation:[64]u8;
 body:[400000]u8;nb:int;index:[1]MsIndex;at:int;cursor:int;revision:int;
 ready:bool;failed:bool;retry:bool;rejected:int;
}
#load "nostr-inbox-journal-checks.coax" #test;
#test "journal replay keeps the exact request across an uncertain transport failure" {
 s:[1]NostrInbox;j:[1]NostrInboxJournal;q:[1]MsRequest;
 id:="dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659";
 #assert ndi_bind(s[..],"account",id) && ndj_start(j[..],s[..],id) && ndj_next(j[..],s[..]);
 #assert j[0].action==22 && nms_request_read(cast(string)j[0].body[0..<j[0].nb],q[..]) && q[0].action==5;
 #assert cast(string)q[0].payload[0..<q[0].n]=="{\"kinds\":[1059],\"#p\":[\"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659\"]}";
 op:=j[0].operation;n:=j[0].nb;spare:[64]u8;#assert ndj_allocate(j[..],spare[..]) && cast(string)spare[..]!=cast(string)op[..] && cast(string)j[0].operation[..]==cast(string)op[..];
 j[0].action=0;#assert !ndj_reply(j[..],s[..],1,"",true) && j[0].retry;
 #assert ndj_retry(j[..],s[..]) && j[0].action==22 && cast(string)j[0].operation[..]==cast(string)op[..] && j[0].nb==n;
 #assert !ndj_reply(j[..],s[..],2,"{}",false) && j[0].busy;
 #assert !ndj_reply(j[..],s[..],1,"{}",false) && j[0].busy;
}
#test "a matching empty index ends local replay without claiming live relay discovery" {
 s:[1]NostrInbox;j:[1]NostrInboxJournal;b:[4096]u8;p:[2048]u8;rows:[1]MsIndexRow;
 id:="dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659";
 #assert ndi_bind(s[..],"a",id) && ndj_start(j[..],s[..],id) && ndj_next(j[..],s[..]);
 n:=ms_index_write(3,0,true,rows[0..<0],p[..]);n=nsr_write("store","index",cast(string)j[0].operation[..],id,"ok",3,0,cast(string)p[0..<n],b[..]);
 #assert ndj_reply(j[..],s[..],1,cast(string)b[0..<n],false) && ndj_next(j[..],s[..]) && j[0].ready && !j[0].busy && j[0].phase==0;
 #assert !ndj_next(j[..],s[..]);ndj_clear(j[..]);#assert j[0].nb==0 && !j[0].ready && j[0].body[0]==0;
}
#test "journal ownership cannot be recycled by a late read or a changed account" {
 s:[1]NostrInbox;j:[1]NostrInboxJournal;
 id:="dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659";
 #assert !ndj_start(j[..],s[..],id) && !ndj_next(j[..],s[..]) && !ndj_retry(j[..],s[..]);
 #assert ndi_bind(s[..],"a",id) && !ndj_start(j[..],s[..],"bad") && ndj_start(j[..],s[..],id) && ndj_next(j[..],s[..]);
 #assert ndi_bind(s[..],"b",id) && !ndj_reply(j[..],s[..],1,"{}",false) && !ndj_next(j[..],s[..]);
}
#test "cold replay opens the exact journal original and deduplicates the next pass" {
 s:[1]NostrInbox;j:[1]NostrInboxJournal;b:[20000]u8;p:[4096]u8;rows:[1]MsIndexRow;scratch:[4096]u8;
 me:="dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659";wrap:=N59_TS_WRAP;rumor:=N59_TS_RUMOR;
 e:=nostr_event_read(cast(string)wrap[..],scratch[..],false);#assert e.error==NE_OK;_=hex_encode_checked(cast(string)e.id[..],rows[0].id[..],false);_=hex_encode_checked(cast(string)e.public_key[..],rows[0].author[..],false);rows[0].kind=1059;rows[0].created=e.created_at;
 #assert ndi_bind(s[..],"a",me) && ndj_start(j[..],s[..],me);
 for pass:0..<2 {
  #assert ndj_next(j[..],s[..]);n:=ms_index_write(7,0,true,rows[..],p[..]);n=nsr_write("store","index",cast(string)j[0].operation[..],me,"ok",7,0,cast(string)p[0..<n],b[..]);
  #assert ndj_reply(j[..],s[..],1,cast(string)b[0..<n],false) && ndj_next(j[..],s[..]);
  if pass==0 {
   n=nsr_write("store","event",cast(string)j[0].operation[..],me,"ok",7,0,cast(string)wrap[..],b[..]);
   #assert ndj_reply(j[..],s[..],1,cast(string)b[0..<n],false) && j[0].phase==3 && j[0].action==21 && s[0].pending;
   j[0].action=0;#assert !ndj_reply(j[..],s[..],1,"",true) && s[0].pending && ndj_retry(j[..],s[..]) && j[0].action==21;
   n=nsr_write("custody","open",cast(string)j[0].operation[..],me,"ok",0,0,cast(string)rumor[..],b[..]);
   #assert ndj_reply(j[..],s[..],1,cast(string)b[0..<n],false) && !s[0].pending && s[0].n==1;
   #assert ndj_next(j[..],s[..]);
  }
  #assert j[0].ready && j[0].phase==0 && !j[0].busy && s[0].n==1;
  #assert ndj_refresh(j[..],s[..]);
 }
}
#test "journal reset erases every retained request cursor and operation namespace" {
 j:[1]NostrInboxJournal;
 for i:0..<j[0].body.count {j[0].body[i]=165;}for i:0..<64 {j[0].seed[i]=165;j[0].operation[i]=165;}
 j[0].generation=9;j[0].serial=7;j[0].phase=3;j[0].busy=true;j[0].action=21;j[0].nb=50;j[0].at=4;j[0].cursor=5;j[0].revision=6;j[0].ready=true;j[0].failed=true;j[0].retry=true;j[0].rejected=2;j[0].index[0].n=1;
 ndj_clear(j[..]);#assert crypto_zeroed(j[0].body[..]) && crypto_zeroed(j[0].seed[..]) && crypto_zeroed(j[0].operation[..]);
 #assert j[0].generation==0 && j[0].serial==0 && j[0].phase==0 && !j[0].busy && j[0].action==0 && j[0].nb==0 && j[0].at==0 && j[0].cursor==0 && j[0].revision==0 && !j[0].ready && !j[0].failed && !j[0].retry && j[0].rejected==0 && j[0].index[0].n==0;
}
#test "journal refresh and retry refuse every blocked owner independently" {
 s:[1]NostrInbox;j:[1]NostrInboxJournal;id:="dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659";
 #assert ndi_bind(s[..],"a",id) && ndj_start(j[..],s[..],id);
 for blocked:0..<5 {
  j[0].generation=ifx blocked==0 then 2 else 1;s[0].na=ifx blocked==1 then 0 else 1;j[0].busy=blocked==2;s[0].pending=blocked==3;j[0].retry=blocked==4;
  #assert !ndj_refresh(j[..],s[..]);
 }
 j[0].generation=1;s[0].na=1;j[0].busy=false;s[0].pending=false;j[0].retry=false;j[0].revision=9;j[0].cursor=12;j[0].ready=true;j[0].failed=true;
 #assert ndj_refresh(j[..],s[..]) && j[0].phase==1 && j[0].revision==0 && j[0].cursor==0 && !j[0].ready && !j[0].failed;
 for blocked:0..<4 {
  j[0].generation=ifx blocked==0 then 2 else 1;j[0].retry=blocked!=1;j[0].busy=blocked==2;j[0].nb=ifx blocked==3 then 0 else 10;
  #assert !ndj_retry(j[..],s[..]);
 }
 j[0].busy=false;j[0].retry=true;j[0].nb=10;j[0].phase=1;j[0].failed=true;
 #assert ndj_retry(j[..],s[..]) && !j[0].retry && !j[0].failed && j[0].busy && j[0].action==22;
}
#test "journal pagination skips exactly known originals and pins every requested cursor" {
 s:[1]NostrInbox;j:[1]NostrInboxJournal;q:[1]MsRequest;b:[20000]u8;p:[4096]u8;rows:[1]MsIndexRow;
 id:="dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659";
 #assert ndi_bind(s[..],"a",id) && ndj_start(j[..],s[..],id);
 j[0].phase=2;j[0].index[0].n=3;j[0].index[0].cursor=7;j[0].index[0].rows[1].id[0]='1';j[0].index[0].rows[2].id[0]='2';s[0].n=2;s[0].messages[1].outer[0]='1';
 // The first two are known. The third is not, so its exact ID is requested.
 for i:0..<64 {j[0].index[0].rows[2].id[i]='2';}
 #assert ndj_next(j[..],s[..]) && j[0].at==2 && nms_request_read(cast(string)j[0].body[0..<j[0].nb],q[..]);
 #assert q[0].action==6 && q[0].revision==0 && q[0].cursor==0 && q[0].subscription==0 && cast(string)q[0].payload[0..<q[0].n]==cast(string)j[0].index[0].rows[2].id[..];
 j[0].busy=false;j[0].at=3;j[0].revision=11;
 #assert ndj_next(j[..],s[..]) && j[0].phase==1 && j[0].cursor==7 && nms_request_read(cast(string)j[0].body[0..<j[0].nb],q[..]) && q[0].cursor==7 && q[0].revision==11;
 // A nonadvancing page cannot silently repeat the same bounded window.
 n:=ms_index_write(11,7,false,rows[0..<0],p[..]);n=nsr_write("store","index",cast(string)j[0].operation[..],id,"ok",11,7,cast(string)p[0..<n],b[..]);
 #assert !ndj_reply(j[..],s[..],1,cast(string)b[0..<n],false) && j[0].failed;
 j[0].busy=true;j[0].failed=false;j[0].ready=true;n=nsr_write("store","index",cast(string)j[0].operation[..],id,"conflict",11,0,"",b[..]);
 #assert n>0 && ndj_reply(j[..],s[..],1,cast(string)b[0..<n],false) && j[0].phase==1 && j[0].revision==0 && j[0].cursor==0 && !j[0].ready;
 #assert ndj_filter("bad",p[..])== -1;
}
ndj_clear :: (j:[]NostrInboxJournal) #effects(all) {
 for i:0..<j[0].body.count {j[0].body[i]=0;}j[0].index[0]=MsIndex.{}; // mutant: equivalent (j[0] -> j[1] only in body.count: the fixed array extent is a type-level constant; its receiver/index is not evaluated. Actual body[i] erasure is checked byte for byte)
 for i:0..<64 {j[0].seed[i]=0;j[0].operation[i]=0;}
 j[0].generation=0;j[0].serial=0;j[0].phase=0;j[0].busy=false;j[0].action=0;j[0].nb=0;j[0].at=0;j[0].cursor=0;j[0].revision=0;j[0].ready=false;j[0].failed=false;j[0].retry=false;j[0].rejected=0;
}
// A fresh per-login random seed is an operation namespace, never a private key.
// Callers supply it from the existing installed entropy operation.
ndj_start :: (j:[]NostrInboxJournal,s:[]NostrInbox,seed:string)->bool #effects(all) {
 if s[0].na==0 || !aw_hex(seed,64) || j[0].busy || s[0].pending {return false;}
 ndj_clear(j);j[0].generation=s[0].generation;_=ndi_copy(j[0].seed[..],seed);j[0].phase=1;return true;
}
// Other Nostr effects may allocate an ID without changing an outstanding
// journal request's operation reference. The scheduler owns one seed/counter.
ndj_allocate :: (j:[]NostrInboxJournal,out:[]u8)->bool #effects(all) {
 if out.count!=64 {return false;}
 if j[0].serial==2147483647 {return false;}j[0].serial+=1;
 b:[160]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_arr(o[..]);jo_str(o[..],"OpenAgents Nostr operation v1");jo_str(o[..],cast(string)j[0].seed[..]);jo_int(o[..],j[0].serial);jo_end(o[..]);
 hash:[32]u8;if o[0].bad || sha256_hash_checked(b[0..<o[0].n],hash[..],false)!=SHA_OK {return false;}
 return hex_encode_checked(cast(string)hash[..],out,false).error==NC_OK;
}
ndj_operation :: (j:[]NostrInboxJournal)->bool #effects(all) {return ndj_allocate(j,j[0].operation[..]);}
ndj_refresh :: (j:[]NostrInboxJournal,s:[]NostrInbox)->bool #effects(all) {
 if j[0].generation!=s[0].generation || s[0].na==0 || j[0].busy || s[0].pending || j[0].retry {return false;}
 j[0].phase=1;j[0].revision=0;j[0].cursor=0;j[0].ready=false;j[0].failed=false;return true;
}
ndj_retry :: (j:[]NostrInboxJournal,s:[]NostrInbox)->bool #effects(all) {
 if j[0].generation!=s[0].generation || !j[0].retry || j[0].busy || j[0].nb<1 {return false;}
 j[0].retry=false;j[0].failed=false;j[0].busy=true;j[0].action=ifx j[0].phase==3 then NSC_OP else MS_OP;return true;
}
ndj_next :: (j:[]NostrInboxJournal,s:[]NostrInbox)->bool #effects(all) {
 if j[0].generation!=s[0].generation || s[0].na==0 || j[0].phase==0 || j[0].busy || j[0].failed {return false;}
 while j[0].phase==2 && j[0].at<j[0].index[0].n {
  known:=false;for i:0..<s[0].n {if cast(string)s[0].messages[i].outer[..]==cast(string)j[0].index[0].rows[j[0].at].id[..] {known=true;}}
  if !known {break;}j[0].at+=1;
 }
 if j[0].phase==2 && j[0].at>=j[0].index[0].n {
  if j[0].index[0].cursor==0 {j[0].phase=0;j[0].ready=j[0].index[0].complete && !s[0].full;return true;}
  j[0].cursor=j[0].index[0].cursor;j[0].phase=1;
 }
 if !ndj_operation(j) {j[0].failed=true;return false;}
 none:[1]string;id:=cast(string)s[0].identity[..];op:=cast(string)j[0].operation[..];n:= -1;
 if j[0].phase==1 {filter:[1024]u8;nf:=ndj_filter(id,filter[..]);if nf>=0 {n=nms_request_write("index",op,id,"",none[0..<0],0,j[0].revision,j[0].cursor,cast(string)filter[0..<nf],j[0].body[..]);}} // mutant: equivalent (>= -> > or 0 -> 1: the filter writer returns -1 or a complete filter JSON object longer than one byte, never 0 or 1)
 else if j[0].phase==2 {n=nms_request_write("event",op,id,"",none[0..<0],0,0,0,cast(string)j[0].index[0].rows[j[0].at].id[..],j[0].body[..]);}
 // phase 3 is emitted by the event reply while its exact original is owned.
 if n<0 {j[0].failed=true;return false;} // mutant: equivalent (0 -> 1 or < -> <=: the request writer returns -1 or complete request JSON longer than one byte; the unsupported phase retains -1)
 j[0].nb=n;j[0].action=MS_OP;j[0].busy=true;return true;
}
ndj_filter :: (identity:string,out:[]u8)->int #effects(all) {
 if !aw_hex(identity,64) {return -1;}f:NostrFilter;kinds:=[1]int.[1059];tags:[1]NostrTagFilter;keys:=[1]string.[identity];
 f.has_kinds=true;f.kinds=kinds[..];tags[0].name='p';tags[0].values=keys[..];f.tags=tags[..];return nf_write(f,out,false);
}
ndj_reply :: (j:[]NostrInboxJournal,s:[]NostrInbox,generation:int,raw:string,failed:bool)->bool #effects(all) {
 if !j[0].busy || generation!=j[0].generation || generation!=s[0].generation {return false;}
 if failed {j[0].busy=false;j[0].failed=true;j[0].retry=true;return false;}
 r:[1]NsResult;defer {secure_zero(r[0].payload[..]);} // mutant: equivalent (removing this deferred local erasure is unobservable to a safe Coax caller after return; retain it for native stack hygiene)
 if !nsr_read(raw,r[..]) || cast(string)r[0].identity[..]!=cast(string)s[0].identity[..] || cast(string)r[0].operation[..]!=cast(string)j[0].operation[..] {return false;}
 expected:=ifx j[0].phase==1 then 5 else ifx j[0].phase==2 then 6 else 4;
 if r[0].service!=(ifx j[0].phase==3 then 1 else 2) || r[0].action!=expected {return false;}
 j[0].busy=false;j[0].action=0;
 if j[0].phase==3 {
  if !ndi_opened(s,generation,raw) {j[0].rejected+=1;}j[0].phase=2;j[0].at+=1;return true;
 }
 if r[0].status==9 {j[0].phase=1;j[0].revision=0;j[0].cursor=0;j[0].ready=false;return true;}
 if r[0].status!=0 {j[0].failed=true;return false;}
 if j[0].phase==1 {
  p:[1]MsIndex;
  if !ms_index_read(cast(string)r[0].payload[0..<r[0].n],p[..]) || p[0].revision!=r[0].revision || p[0].cursor!=r[0].cursor || (p[0].cursor!=0 && p[0].cursor<=j[0].cursor) {j[0].failed=true;return false;}
  for i:0..<p[0].n {if p[0].rows[i].kind!=1059 {j[0].failed=true;return false;}}
  j[0].index[0]=p[0];j[0].revision=p[0].revision;j[0].phase=2;j[0].at=0;return true;
 }
 if !ndj_operation(j) {j[0].failed=true;return false;}
 original:=cast(string)r[0].payload[0..<r[0].n];scratch:[65536]u8;e:=nostr_event_read(original,scratch[..],false);outer:[64]u8;
 if e.error!=NE_OK || e.kind!=1059 || hex_encode_checked(cast(string)e.id[..],outer[..],false).error!=NC_OK || cast(string)outer[..]!=cast(string)j[0].index[0].rows[j[0].at].id[..] {j[0].failed=true;return false;}
 n:=nsc_request("open",cast(string)j[0].operation[..],cast(string)s[0].identity[..],original,j[0].body[..]);
 if n<0 || !ndi_begin(s,cast(string)j[0].operation[..],cast(string)j[0].index[0].rows[j[0].at].id[..]) {j[0].failed=true;return false;} // mutant: equivalent (0 -> 1 or < -> <= on n only: nsc_request returns -1 or complete custody request JSON longer than one byte, never 0 or 1)
 j[0].nb=n;j[0].phase=3;j[0].action=NSC_OP;j[0].busy=true;return true;
}
