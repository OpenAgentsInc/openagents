// Simulated App Tester CLI & Desktop Journey Runner (MVP)
// (docs/apps/2026-11-20-simulated-tester-spec.md §11, GitHub #13892).
//
// Usage:
//   coax/web/tool.sh apps/shared/tester/cli.coax --checks
//   coax/web/tool.sh apps/shared/tester/cli.coax --selftest --target desktop [--out DIR] [--app PATH]
//   coax/web/tool.sh apps/shared/tester/cli.coax --target desktop --mode local [--only ID] [--out DIR] [--app PATH]
#load "adapter-web.coax";
#load "../../openagents-desktop/tests/tester/catalog.coax";
#load "../../openagents-ios/Tests/tester/catalog.coax";
#load "../../openagents-web/tests/tester/catalog.coax";

cxterm_write :: (s: [] u8) -> int #foreign #effects(all);

t_out :: (s: string) {
  ob: [8192] u8;
  n := 0;
  for c: s {
    ob[n] = c;
    n += 1;
    if n == ob.count { _ = cxterm_write(ob[0..<n]); n = 0; }
  }
  if n > 0 { _ = cxterm_write(ob[0..<n]); }
}
t_outln :: (s: string) { t_out(s); t_out("\n"); }

t_has_substr :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  if needle.count > hay.count { return false; }
  limit := hay.count - needle.count + 1;
  for i: 0..<limit {
    match := true;
    for j: 0..<needle.count {
      if hay[i + j] != needle[j] { match = false; break; }
    }
    if match { return true; }
  }
  return false;
}

t_run_scenario :: (s: [] DaSession, sc_id: string, res_out: [] TsResult) {
  t0 := proc_now_ms();
  obs: [1] TsObservation;
  active: [1] bool;
  rep: [DA_REPLY] u8;
  r := TsResult.{
    scenario_id = sc_id, client_id = "desktop-1", target = "desktop-mac",
    mode = da_slice(s[0].mode[..], s[0].mode_n), verdict = "pass",
    cleanup = "ok"
  };

  if sc_id == "desktop.launch.cold" {
    r.steps_run = 2;
    if !da_observe(s, "01-cold-launch", "cold launch state", obs[..], active[..]) {
      r.verdict = "infrastructure-fail"; r.first_failure = "observe"; r.summary = "probe observe failed";
    } else if active[0] {
      r.verdict = "product-fail"; r.first_failure = "focus-isolation"; r.summary = "scratch app became active and stole focus";
    } else if obs[0].width < 420 || obs[0].height < 320 {
      r.verdict = "product-fail"; r.first_failure = "window-size"; r.summary = "window content size below minimum 420x320";
    } else if !obs[0].composer_focused {
      r.verdict = "product-fail"; r.first_failure = "composer-focus"; r.summary = "composer was not focused on cold launch";
    } else {
      r.summary = "cold launch ready, zero focus stealing, composer focused";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "desktop.composer.type-and-multiline" {
    r.steps_run = 4;
    _ = da_act(s, "type", "composer", "type hello tester", 250, rep[..]);
    proc_sleep(100);
    _ = da_act(s, "key", "composer", "key shift+return", 100, rep[..]);
    proc_sleep(100);
    _ = da_act(s, "type", "composer", "type line two", 250, rep[..]);
    proc_sleep(150);
    if !da_observe(s, "02-composer-multiline", "multiline draft", obs[..], active[..]) {
      r.verdict = "infrastructure-fail"; r.first_failure = "observe"; r.summary = "observe failed after typing";
    } else if !t_has_substr(obs[0].composer_text, "hello tester") || !t_has_substr(obs[0].composer_text, "line two") {
      r.verdict = "product-fail"; r.first_failure = "draft-mismatch"; r.summary = "composer text did not contain both typed lines";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else {
      _ = da_act(s, "key", "composer", "key cmd+a", 100, rep[..]);
      proc_sleep(80);
      _ = da_act(s, "key", "composer", "key cmd+x", 100, rep[..]);
      proc_sleep(120);
      _ = da_observe(s, "", "cleared draft", obs[..], active[..]);
      if obs[0].composer_text.count != 0 {
        r.verdict = "product-fail"; r.first_failure = "clear-failed"; r.summary = "cmd+a + cmd+x did not clear composer draft";
      } else {
        r.summary = "typed multiline draft, verified content, cleared cleanly with Cmd+A + Cmd+X";
        r.screenshot_ref = "screenshots/02-composer-multiline.png";
      }
    }
  } else if sc_id == "desktop.palette.open-and-dismiss" {
    r.steps_run = 3;
    n1 := da_act(s, "key", "palette", "key cmd+k", 100, rep[..]);
    proc_sleep(200);
    _ = da_act(s, "type", "palette", "type Settings", 200, rep[..]);
    proc_sleep(150);
    _ = da_observe(s, "03-palette-open", "command palette open", obs[..], active[..]);
    n2 := da_act(s, "key", "palette", "key escape", 100, rep[..]);
    proc_sleep(200);
    if n1 <= 0 || n2 <= 0 {
      r.verdict = "infrastructure-fail"; r.first_failure = "probe"; r.summary = "palette key command failed";
    } else if !da_observe(s, "", "after palette escape", obs[..], active[..]) {
      r.verdict = "infrastructure-fail"; r.first_failure = "observe"; r.summary = "observe failed after palette escape";
    } else if !obs[0].composer_focused {
      r.verdict = "product-fail"; r.first_failure = "focus-restore"; r.summary = "composer did not regain focus after dismissing Cmd+K palette with Escape";
      r.screenshot_ref = "screenshots/03-palette-open.png";
    } else {
      r.summary = "Cmd+K palette opened, filtered, and Escape restored composer focus";
      r.screenshot_ref = "screenshots/03-palette-open.png";
    }
  } else if sc_id == "desktop.settings.pages-and-search" {
    r.steps_run = 3;
    _ = da_act(s, "key", "settings", "key cmd+,", 100, rep[..]);
    proc_sleep(250);
    if !da_observe(s, "04-settings-open", "settings open", obs[..], active[..]) {
      r.verdict = "infrastructure-fail"; r.first_failure = "observe"; r.summary = "observe failed in settings";
    } else if obs[0].settings_page < 0 {
      r.verdict = "product-fail"; r.first_failure = "settings-not-open"; r.summary = "Cmd+, did not open Settings page";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else {
      _ = da_act(s, "key", "settings", "key cmd+f", 100, rep[..]);
      proc_sleep(120);
      _ = da_act(s, "type", "settings", "type model", 200, rep[..]);
      proc_sleep(150);
      _ = da_act(s, "key", "settings", "key escape", 100, rep[..]);
      proc_sleep(120);
      _ = da_act(s, "key", "settings", "key escape", 100, rep[..]);
      proc_sleep(200);
      _ = da_observe(s, "", "settings closed", obs[..], active[..]);
      if obs[0].settings_page >= 0 {
        // Try Cmd+[ (Back to Chats) as documented menu shortcut.
        _ = da_act(s, "key", "settings", "key cmd+[", 100, rep[..]);
        proc_sleep(200);
        _ = da_observe(s, "", "after cmd+[", obs[..], active[..]);
        if obs[0].settings_page >= 0 {
          r.verdict = "product-fail"; r.first_failure = "settings-close"; r.summary = "Settings did not close on Escape or Cmd+[";
        } else {
          r.verdict = "product-fail"; r.first_failure = "escape-close"; r.summary = "Escape twice did not close Settings (only Cmd+[ closed it)";
        }
      } else {
        r.summary = "Settings opened with Cmd+,, searched, and closed cleanly with Escape";
        r.screenshot_ref = "screenshots/04-settings-open.png";
      }
    }
  } else if sc_id == "desktop.zoom.step-and-reset" {
    r.steps_run = 3;
    n1 := da_act(s, "key", "window", "key cmd+=", 100, rep[..]);
    proc_sleep(150);
    _ = da_observe(s, "05-zoom-in", "zoomed in", obs[..], active[..]);
    n2 := da_act(s, "key", "window", "key cmd+-", 100, rep[..]);
    proc_sleep(120);
    n3 := da_act(s, "key", "window", "key cmd+0", 100, rep[..]);
    proc_sleep(150);
    if n1 <= 0 || n2 <= 0 || n3 <= 0 || !da_observe(s, "", "zoom reset", obs[..], active[..]) {
      r.verdict = "product-fail"; r.first_failure = "zoom"; r.summary = "zoom shortcuts failed or app stopped responding";
    } else {
      r.summary = "zoom in (Cmd+=), out (Cmd+-), and reset (Cmd+0) succeeded";
      r.screenshot_ref = "screenshots/05-zoom-in.png";
    }
  } else if sc_id == "desktop.layout.narrow-and-wide" {
    r.steps_run = 3;
    _ = da_act(s, "resize", "window", "size 1400 860", 100, rep[..]);
    proc_sleep(180);
    _ = da_act(s, "resize", "window", "size 760 640", 100, rep[..]);
    proc_sleep(220);
    if !da_observe(s, "06-narrow-760", "narrow 760x640", obs[..], active[..]) {
      r.verdict = "infrastructure-fail"; r.first_failure = "observe"; r.summary = "observe failed after narrow resize";
    } else if obs[0].width != 760 || obs[0].height != 640 {
      r.verdict = "product-fail"; r.first_failure = "resize-mismatch"; r.summary = "window did not adopt narrow 760x640 content size";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else {
      _ = da_act(s, "resize", "window", "size 1280 820", 100, rep[..]);
      proc_sleep(200);
      _ = da_observe(s, "", "restored 1280x820", obs[..], active[..]);
      if obs[0].width != 1280 || obs[0].height != 820 {
        r.verdict = "product-fail"; r.first_failure = "restore-mismatch"; r.summary = "window did not restore to 1280x820";
      } else {
        r.summary = "resized 1400x860 -> 760x640 narrow -> 1280x820 cleanly";
        r.screenshot_ref = "screenshots/06-narrow-760.png";
      }
    }
  } else if sc_id == "desktop.sidebar.toggle" {
    r.steps_run = 2;
    _ = da_act(s, "key", "sidebar", "key cmd+b", 100, rep[..]);
    proc_sleep(180);
    _ = da_observe(s, "07-sidebar-hidden", "sidebar toggled off", obs[..], active[..]);
    _ = da_act(s, "key", "sidebar", "key cmd+b", 100, rep[..]);
    proc_sleep(180);
    if !da_observe(s, "", "sidebar restored", obs[..], active[..]) {
      r.verdict = "infrastructure-fail"; r.first_failure = "observe"; r.summary = "observe failed after sidebar toggle";
    } else if !obs[0].composer_focused {
      r.verdict = "product-fail"; r.first_failure = "focus-lost"; r.summary = "Cmd+B sidebar toggle lost composer focus";
    } else {
      r.summary = "Cmd+B toggled sidebar off and back on while preserving composer focus";
      r.screenshot_ref = "screenshots/07-sidebar-hidden.png";
    }
  } else if sc_id == "desktop.models.picker" {
    r.steps_run = 2;
    n1 := da_act(s, "key", "models", "key cmd+/", 100, rep[..]);
    proc_sleep(200);
    _ = da_observe(s, "08-models-picker", "model picker open", obs[..], active[..]);
    n2 := da_act(s, "key", "models", "key escape", 100, rep[..]);
    proc_sleep(200);
    if n1 <= 0 || n2 <= 0 || !da_observe(s, "", "model picker closed", obs[..], active[..]) {
      r.verdict = "infrastructure-fail"; r.first_failure = "probe"; r.summary = "model picker shortcut failed";
    } else if !obs[0].composer_focused {
      r.verdict = "product-fail"; r.first_failure = "focus-restore"; r.summary = "Escape from Cmd+/ model picker did not restore composer focus";
      r.screenshot_ref = "screenshots/08-models-picker.png";
    } else {
      r.summary = "Cmd+/ model picker opened and Escape restored composer focus";
      r.screenshot_ref = "screenshots/08-models-picker.png";
    }
  } else if sc_id == "desktop.simulator.pane-toggle" {
    r.steps_run = 2;
    n1 := da_act(s, "key", "simulator", "key alt+cmd+s", 100, rep[..]);
    proc_sleep(350);
    _ = da_observe(s, "09-sim-pane", "simulator pane open", obs[..], active[..]);
    n2 := da_act(s, "key", "simulator", "key alt+cmd+s", 100, rep[..]);
    proc_sleep(250);
    if n1 <= 0 || n2 <= 0 || !da_observe(s, "", "simulator pane closed", obs[..], active[..]) {
      r.verdict = "product-fail"; r.first_failure = "sim-toggle"; r.summary = "Opt+Cmd+S simulator pane toggle failed or crashed";
    } else if active[0] {
      r.verdict = "product-fail"; r.first_failure = "focus-steal"; r.summary = "toggling simulator pane stole focus";
    } else {
      r.summary = "Opt+Cmd+S toggled iOS Simulator pane open and closed with zero focus steal";
      r.screenshot_ref = "screenshots/09-sim-pane.png";
    }
  } else if sc_id == "desktop.files.open-edit-dirty" {
    r.steps_run = 3;
    b1: [1] DaBuf;
    b2: [1] DaBuf;
    sample := da_cat(b1[..], da_slice(s[0].home_dir[..], s[0].home_n), "/tester-sample.txt");
    _ = fs_write(sample, "line one\nline two\n");
    _ = da_act(s, "open", "file-pane", da_cat(b2[..], "open ", sample), 100, rep[..]);
    proc_sleep(300);
    fn := da_probe(da_slice(s[0].sock_path[..], s[0].sock_n), "file", rep[..], 3000);
    nodes: [128] JvNode;
    doc: [1] Jv;
    mode_val := 0;
    dirty_before := false;
    if fn > 0 && jv_parse(doc[..], cast(string) rep[0..<fn], nodes[..]) {
      mode_val = jv_int(doc[0], jv_get(doc[0], 0, "mode"), 0);
      dirty_before = jv_bool(doc[0], jv_get(doc[0], 0, "dirty")) || jv_int(doc[0], jv_get(doc[0], 0, "dirty"), 0) != 0;
    }
    _ = da_observe(s, "10-file-pane", "file pane open", obs[..], active[..]);
    if mode_val != 1 {
      r.verdict = "product-fail"; r.first_failure = "file-not-editable"; r.summary = "opening small text file did not enter editable file-pane mode (mode != 1)";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else if dirty_before {
      r.verdict = "product-fail"; r.first_failure = "dirty-on-open"; r.summary = "freshly opened file reported dirty=true before any edit";
    } else {
      _ = da_act(s, "type", "file-pane", "type X", 100, rep[..]);
      proc_sleep(350);
      fn2 := da_probe(da_slice(s[0].sock_path[..], s[0].sock_n), "file", rep[..], 3000);
      dirty_after := false;
      if fn2 > 0 && jv_parse(doc[..], cast(string) rep[0..<fn2], nodes[..]) {
        dirty_after = jv_bool(doc[0], jv_get(doc[0], 0, "dirty")) || jv_int(doc[0], jv_get(doc[0], 0, "dirty"), 0) != 0;
      }
      if !dirty_after {
        r.verdict = "product-fail"; r.first_failure = "edit-not-dirty"; r.summary = "typing in opened file pane did not mark file dirty (keyboard focus did not move to file editor)";
      } else {
        // Save with Cmd+S, verify dirty clears and disk file contains the typed edit.
        _ = da_act(s, "key", "file-pane", "key cmd+s", 100, rep[..]);
        proc_sleep(300);
        fn3 := da_probe(da_slice(s[0].sock_path[..], s[0].sock_n), "file", rep[..], 3000);
        dirty_saved := true;
        if fn3 > 0 && jv_parse(doc[..], cast(string) rep[0..<fn3], nodes[..]) {
          dirty_saved = jv_bool(doc[0], jv_get(doc[0], 0, "dirty")) || jv_int(doc[0], jv_get(doc[0], 0, "dirty"), 0) != 0;
        }
        disk: [256] u8;
        dn := fs_read(sample, disk[..]);
        if dirty_saved {
          r.verdict = "product-fail"; r.first_failure = "save-still-dirty"; r.summary = "Cmd+S did not clear dirty state in file pane";
        } else if dn <= 0 || !t_has_substr(cast(string) disk[0..<dn], "X") {
          r.verdict = "product-fail"; r.first_failure = "save-disk-mismatch"; r.summary = "Cmd+S cleared dirty but edit was not written to disk";
        } else {
          r.summary = "opened scratch file, typed edit (dirty=true), Cmd+S saved to disk (dirty=false)";
          r.screenshot_ref = "screenshots/10-file-pane.png";
        }
      }
    }
  } else if sc_id == "desktop.chat.mock-send-and-stream" {
    r.steps_run = 3;
    // Start a fresh chat (Cmd+N) to ensure clean composer focus.
    _ = da_act(s, "key", "chat", "key cmd+n", 100, rep[..]);
    proc_sleep(200);
    _ = da_act(s, "type", "composer", "type ping from simulated tester", 250, rep[..]);
    proc_sleep(120);
    _ = da_act(s, "key", "composer", "key return", 100, rep[..]);
    // Wait up to 8s for worker run to settle (running -> false).
    deadline := proc_now_ms() + 8000;
    settled := false;
    while proc_now_ms() < deadline {
      proc_sleep(250);
      if da_observe(s, "", "poll chat settle", obs[..], active[..]) {
        if !obs[0].running && obs[0].composer_text.count == 0 {
          settled = true;
          break;
        }
      }
    }
    _ = da_observe(s, "11-chat-reply", "after mock reply", obs[..], active[..]);
    if !settled {
      r.verdict = "product-fail"; r.first_failure = "chat-not-settled"; r.summary = "sending prompt to mock worker did not clear draft and settle within 8s";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else {
      r.summary = "sent prompt via composer, mock worker replied and settled cleanly";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "desktop.git.toolbar-visible" {
    r.steps_run = 4;
    proc_sleep(250);
    b_br := da_box(s, "coder.git.branch");
    b_md := da_box(s, "coder.git.mode");
    b_cm := da_box(s, "coder.git.commit");
    b_ac := da_box(s, "coder.git.actions");
    _ = da_observe(s, "12-git-toolbar", "git toolbar boxes", obs[..], active[..]);
    if !b_br.ok || !b_md.ok || !b_cm.ok || !b_ac.ok {
      r.verdict = "product-fail"; r.first_failure = "git-toolbar-missing";
      r.summary = "one or more Git Actions toolbar chips (coder.git.branch/mode/commit/actions) not drawn in git repo";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else if b_br.w <= 0 || b_md.w <= 0 || b_cm.w <= 0 || b_ac.w <= 0 {
      r.verdict = "product-fail"; r.first_failure = "git-toolbar-zero-box";
      r.summary = "Git Actions toolbar chip rendered with zero width";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else {
      r.summary = "Git Actions toolbar chips (branch, mode, commit, actions) all drawn with valid bounds";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "desktop.git.mode-toggle" {
    r.steps_run = 2;
    c1 := da_click_box(s, "coder.git.mode", rep[..]);
    proc_sleep(200);
    _ = da_observe(s, "13-git-mode", "after git mode toggle 1", obs[..], active[..]);
    c2 := da_click_box(s, "coder.git.mode", rep[..]);
    proc_sleep(200);
    if !c1 || !c2 {
      r.verdict = "product-fail"; r.first_failure = "git-mode-click";
      r.summary = "clicking coder.git.mode (Local vs. Worktree) chip failed";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else if active[0] {
      r.verdict = "product-fail"; r.first_failure = "focus-steal";
      r.summary = "toggling Git mode stole macOS focus";
    } else {
      r.summary = "toggled Local <-> Worktree mode chip twice cleanly with zero focus steal";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "desktop.git.branch-and-commit-guard" {
    r.steps_run = 4;
    // Open branch menu, dismiss with Escape.
    c_br := da_click_box(s, "coder.git.branch", rep[..]);
    proc_sleep(250);
    _ = da_observe(s, "14-git-branch-menu", "branch picker open", obs[..], active[..]);
    _ = da_act(s, "key", "git-branch", "key escape", 100, rep[..]);
    proc_sleep(200);
    // Create an uncommitted file in the scratch repo and click Commit on main.
    b1: [1] DaBuf;
    dirty := da_cat(b1[..], da_slice(s[0].repo_dir[..], s[0].repo_n), "/uncommitted.txt");
    _ = fs_write(dirty, "dirty change on main\n");
    c_cm := da_click_box(s, "coder.git.commit", rep[..]);
    proc_sleep(350);
    _ = da_observe(s, "14-git-commit-dialog", "commit dialog on main", obs[..], active[..]);
    _ = da_act(s, "key", "git-commit", "key escape", 100, rep[..]);
    proc_sleep(200);
    if !c_br || !c_cm {
      r.verdict = "product-fail"; r.first_failure = "git-click";
      r.summary = "clicking coder.git.branch or coder.git.commit failed";
      r.screenshot_ref = "screenshots/14-git-commit-dialog.png";
    } else if !da_observe(s, "", "after commit escape", obs[..], active[..]) {
      r.verdict = "infrastructure-fail"; r.first_failure = "observe"; r.summary = "observe failed after commit escape";
    } else {
      r.summary = "branch menu opened/dismissed and Commit on main triggered dialog & cancelled cleanly";
      r.screenshot_ref = "screenshots/14-git-commit-dialog.png";
    }
  } else if sc_id == "desktop.git.worktree-per-chat" {
    r.steps_run = 3;
    _ = da_act(s, "key", "chat", "key cmd+n", 100, rep[..]);
    proc_sleep(250);
    _ = da_act(s, "type", "composer", "type create worktree test", 200, rep[..]);
    proc_sleep(120);
    _ = da_act(s, "key", "composer", "key return", 100, rep[..]);
    // Wait up to 6s for a per-chat worktree directory to appear under $HOME/worktrees.
    wt_check_cmd: [1024] u8;
    wj: [1] Jo;
    jo_start(wj[..], wt_check_cmd[..]);
    jo_put(wj[..], "find '");
    jo_put(wj[..], da_slice(s[0].home_dir[..], s[0].home_n));
    jo_put(wj[..], "/worktrees' -maxdepth 3 -name .git 2>/dev/null | grep -q .");
    found_wt := false;
    deadline := proc_now_ms() + 6000;
    while proc_now_ms() < deadline {
      proc_sleep(300);
      if da_run_sh(cast(string) wt_check_cmd[0..<wj[0].n], 2000) {
        found_wt = true;
        break;
      }
    }
    _ = da_observe(s, "15-git-worktree-chat", "per-chat worktree state", obs[..], active[..]);
    if !found_wt {
      r.verdict = "product-fail"; r.first_failure = "no-worktree-created";
      r.summary = "starting a chat in a git repo did not create a coder/<id> worktree under CODER_WORKTREES within 6s";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else {
      r.summary = "starting a chat in a git repo created an isolated per-chat worktree under CODER_WORKTREES";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "desktop.composer.undo-redo" {
    r.steps_run = 5;
    _ = da_act(s, "key", "composer", "key cmd+n", 150, rep[..]);
    proc_sleep(250);
    _ = da_act(s, "type", "composer", "type undo redo check", 200, rep[..]);
    proc_sleep(150);
    _ = da_act(s, "key", "composer", "key cmd+a", 100, rep[..]);
    _ = da_act(s, "key", "composer", "key cmd+x", 100, rep[..]);
    proc_sleep(150);
    _ = da_observe(s, "", "after cut", obs[..], active[..]);
    cut_ok := obs[0].composer_text.count == 0;
    _ = da_act(s, "key", "composer", "key cmd+z", 100, rep[..]);
    proc_sleep(150);
    _ = da_observe(s, "15-composer-undo", "after undo", obs[..], active[..]);
    undo_ok := obs[0].composer_text == "undo redo check";
    _ = da_act(s, "key", "composer", "key shift+cmd+Z", 100, rep[..]);
    proc_sleep(150);
    _ = da_observe(s, "", "after redo", obs[..], active[..]);
    redo_ok := obs[0].composer_text.count == 0;
    if !cut_ok {
      r.verdict = "product-fail"; r.first_failure = "cut-failed"; r.summary = "Cmd+A + Cmd+X did not clear composer before undo";
    } else if !undo_ok {
      r.verdict = "product-fail"; r.first_failure = "undo-failed"; r.summary = "Cmd+Z did not restore cut composer text";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else if !redo_ok {
      r.verdict = "product-fail"; r.first_failure = "redo-failed"; r.summary = "Shift+Cmd+Z did not redo cut in composer";
    } else {
      r.summary = "Cmd+A + Cmd+X cut, Cmd+Z restored draft, Shift+Cmd+Z cleared again";
      r.screenshot_ref = "screenshots/15-composer-undo.png";
    }
  } else if sc_id == "desktop.find.in-thread" {
    r.steps_run = 3;
    _ = da_act(s, "key", "find", "key cmd+f", 120, rep[..]);
    proc_sleep(200);
    _ = da_act(s, "type", "find", "type probe", 150, rep[..]);
    proc_sleep(150);
    _ = da_observe(s, "16-find-in-thread", "find open", obs[..], active[..]);
    _ = da_act(s, "key", "find", "key escape", 120, rep[..]);
    proc_sleep(200);
    _ = da_observe(s, "", "after find escape", obs[..], active[..]);
    if !obs[0].composer_focused {
      r.verdict = "product-fail"; r.first_failure = "find-escape-focus";
      r.summary = "Escape from in-thread Find did not restore composer focus";
      r.screenshot_ref = "screenshots/16-find-in-thread.png";
    } else {
      r.summary = "Cmd+F opened in-thread Find, typed query, and Escape restored composer focus";
      r.screenshot_ref = "screenshots/16-find-in-thread.png";
    }
  } else if sc_id == "desktop.terminal.toggle" {
    r.steps_run = 2;
    _ = da_act(s, "key", "terminal", "key cmd+j", 150, rep[..]);
    proc_sleep(350);
    _ = da_observe(s, "17-terminal-open", "terminal pane open", obs[..], active[..]);
    _ = da_act(s, "key", "terminal", "key cmd+j", 150, rep[..]);
    proc_sleep(250);
    _ = da_observe(s, "", "terminal pane closed", obs[..], active[..]);
    if !obs[0].composer_focused {
      r.verdict = "product-fail"; r.first_failure = "terminal-close-focus";
      r.summary = "closing terminal pane with Cmd+J did not restore composer focus";
      r.screenshot_ref = "screenshots/17-terminal-open.png";
    } else {
      r.summary = "Cmd+J toggled embedded terminal pane open and closed cleanly with focus restored";
      r.screenshot_ref = "screenshots/17-terminal-open.png";
    }
  } else if sc_id == "desktop.settings.usage-dashboard" {
    r.steps_run = 4;
    // Open command palette, jump to Usage settings (#13877), capture screenshot, press Escape to close.
    _ = da_act(s, "key", "palette", "key cmd+k", 120, rep[..]);
    proc_sleep(200);
    _ = da_act(s, "type", "palette", "type Usage", 150, rep[..]);
    proc_sleep(200);
    _ = da_act(s, "key", "palette", "key return", 150, rep[..]);
    proc_sleep(350);
    _ = da_observe(s, "18-settings-usage", "settings usage dashboard", obs[..], active[..]);
    opened_settings := obs[0].settings_page >= 0;
    _ = da_act(s, "key", "settings", "key escape", 120, rep[..]);
    proc_sleep(250);
    _ = da_observe(s, "", "after usage escape", obs[..], active[..]);
    closed_ok := obs[0].settings_page < 0 && obs[0].composer_focused;
    if !opened_settings {
      r.verdict = "product-fail"; r.first_failure = "usage-not-opened";
      r.summary = "Cmd+K -> Usage did not open Settings Usage dashboard";
      r.screenshot_ref = "screenshots/18-settings-usage.png";
    } else if !closed_ok {
      r.verdict = "product-fail"; r.first_failure = "usage-escape-failed";
      r.summary = "Escape from Settings -> Usage did not return focus to composer";
      r.screenshot_ref = "screenshots/18-settings-usage.png";
    } else {
      r.summary = "Cmd+K -> Usage opened Settings Usage dashboard cleanly and Escape restored composer focus";
      r.screenshot_ref = "screenshots/18-settings-usage.png";
    }
  } else if sc_id == "desktop.chat.multi-switch" {
    r.steps_run = 5;
    // Create a new chat, type a distinct draft, switch to Chat 1 (Cmd+1), verify draft isolation, switch back.
    _ = da_act(s, "key", "chat", "key cmd+n", 150, rep[..]);
    proc_sleep(250);
    _ = da_act(s, "type", "composer", "type alpha draft", 200, rep[..]);
    proc_sleep(150);
    _ = da_observe(s, "19-multi-chat-draft", "draft on new chat", obs[..], active[..]);
    has_alpha := obs[0].composer_text == "alpha draft";
    _ = da_act(s, "key", "chat", "key cmd+1", 150, rep[..]);
    proc_sleep(250);
    _ = da_observe(s, "", "switched to chat 1", obs[..], active[..]);
    switched_ok := obs[0].composer_text != "alpha draft";
    if !has_alpha {
      r.verdict = "product-fail"; r.first_failure = "draft-type-failed";
      r.summary = "failed to type draft on newly created chat";
    } else if !switched_ok {
      r.verdict = "product-fail"; r.first_failure = "chat-switch-draft-leak";
      r.summary = "Cmd+1 did not isolate composer draft when switching chats";
      r.screenshot_ref = "screenshots/19-multi-chat-draft.png";
    } else {
      r.summary = "Cmd+N + Cmd+1 switched between chats cleanly with independent composer drafts";
      r.screenshot_ref = "screenshots/19-multi-chat-draft.png";
    }
  } else if sc_id == "desktop.git.output-tray" {
    r.steps_run = 3;
    // Query box of coder.git.actions, click to open Git Actions menu, capture screenshot, press Escape.
    bx := da_box(s, "coder.git.actions");
    if !bx.ok {
      r.verdict = "product-fail"; r.first_failure = "git-actions-box-missing";
      r.summary = "coder.git.actions toolbar chip box not found";
    } else {
      cbuf: [128] u8; cj: [1] Jo; jo_start(cj[..], cbuf[..]);
      jo_put(cj[..], "click "); jo_int(cj[..], bx.x + bx.w / 2); jo_put(cj[..], " "); jo_int(cj[..], bx.y + bx.h / 2);
      _ = da_act(s, "click", "git.actions", cast(string) cbuf[0..<cj[0].n], 150, rep[..]);
      proc_sleep(250);
      _ = da_observe(s, "20-git-actions-menu", "git actions menu open", obs[..], active[..]);
      _ = da_act(s, "key", "git.actions", "key escape", 120, rep[..]);
      proc_sleep(200);
      _ = da_observe(s, "", "after git actions escape", obs[..], active[..]);
      if !obs[0].composer_focused {
        r.verdict = "product-fail"; r.first_failure = "git-actions-escape-focus";
        r.summary = "Escape from Git Actions menu did not restore composer focus";
        r.screenshot_ref = "screenshots/20-git-actions-menu.png";
      } else {
        r.summary = "clicked Git toolbar chip, opened Git Actions menu, and Escape restored composer focus";
        r.screenshot_ref = "screenshots/20-git-actions-menu.png";
      }
    }
  } else {
    r.verdict = "unqualified";
    r.first_failure = "unknown-scenario";
    r.summary = "scenario id not implemented in desktop runner";
  }

  r.duration_ms = proc_now_ms() - t0;
  da_record_result(s, r);
  res_out[0] = r;
}

t_write_reports :: (s: [] DaSession, results: [] TsResult, count: int) {
  out_dir := da_slice(s[0].out_dir[..], s[0].out_n);
  b: [1] DaBuf;

  // Write agent-definition.json & agent-invocation.json.
  jb: [AR_WIRE_BUF] u8;
  dn := ar_write_def(dt_agent_definition(), jb[..]);
  if dn > 0 { _ = fs_write(da_cat(b[..], out_dir, "/agent-definition.json"), cast(string) jb[0..<dn]); }
  inv := ArInvRecord.{
    invocation_id = "inv-desktop-mvp", root_session_id = "sess-desktop-mvp", parent_invocation_id = "",
    agent_id = "desktop-journey-tester", depth = 0, target_kind = "desktop-mac",
    seat = "desktop-client", device_lease = "mac-local-scratch", account_lease = "",
    workspace_dir = da_slice(s[0].home_dir[..], s[0].home_n),
    budget = dt_agent_definition().budget, seed = 1, state = "completed",
    evidence_dir = out_dir
  };
  in_n := ar_write_inv(inv, jb[..]);
  if in_n > 0 { _ = fs_write(da_cat(b[..], out_dir, "/agent-invocation.json"), cast(string) jb[0..<in_n]); }

  passed := 0;
  failed := 0;
  infra := 0;
  for i: 0..<count {
    if results[i].verdict == "pass" { passed += 1; }
    else if results[i].verdict == "product-fail" { failed += 1; }
    else { infra += 1; }
  }

  // Write report.json
  rj: [65536] u8;
  j: [1] Jo;
  jo_start(j[..], rj[..]);
  jo_obj(j[..]);
  jo_key(j[..], "schema"); jo_str(j[..], TESTER_REPORT_SCHEMA);
  jo_key(j[..], "target"); jo_str(j[..], "desktop-mac");
  jo_key(j[..], "mode"); jo_str(j[..], da_slice(s[0].mode[..], s[0].mode_n));
  jo_key(j[..], "total"); jo_int(j[..], count);
  jo_key(j[..], "passed"); jo_int(j[..], passed);
  jo_key(j[..], "product_failed"); jo_int(j[..], failed);
  jo_key(j[..], "other_failed"); jo_int(j[..], infra);
  jo_key(j[..], "results"); jo_arr(j[..]);
  rb: [TS_BUF] u8;
  for i: 0..<count {
    rn := ts_write_result(results[i], rb[..]);
    if rn > 0 { jo_raw(j[..], cast(string) rb[0..<rn]); }
  }
  jo_end(j[..]);
  jo_end(j[..]);
  jo_put(j[..], "\n");
  _ = fs_write(da_cat(b[..], out_dir, "/report.json"), cast(string) rj[0..<j[0].n]);

  // Write report.html
  rh: [65536] u8;
  hj: [1] Jo;
  jo_start(hj[..], rh[..]);
  jo_put(hj[..], "<!doctype html><html><head><meta charset='utf-8'><title>OpenAgents Desktop Simulated Tester Report</title>");
  jo_put(hj[..], "<style>body{font-family:system-ui,sans-serif;max-width:960px;margin:24px auto;padding:0 16px;background:#111;color:#eee}table{width:100%;border-collapse:collapse}th,td{padding:8px 10px;border-bottom:1px solid #333;text-align:left}.pass{color:#4ade80;font-weight:600}.fail{color:#f87171;font-weight:600}.meta{color:#9ca3af}</style></head><body>");
  jo_put(hj[..], "<h1>OpenAgents Desktop Simulated Tester Report</h1><p class='meta'>Passed: ");
  ib_h: [32] u8;
  jo_put(hj[..], da_int_str(passed, ib_h[..]));
  jo_put(hj[..], " / ");
  jo_put(hj[..], da_int_str(count, ib_h[..]));
  jo_put(hj[..], " | Product failures: ");
  jo_put(hj[..], da_int_str(failed, ib_h[..]));
  jo_put(hj[..], " | Infra/other: ");
  jo_put(hj[..], da_int_str(infra, ib_h[..]));
  jo_put(hj[..], "</p><table><thead><tr><th>Scenario</th><th>Verdict</th><th>Duration</th><th>Summary</th><th>Screenshot</th></tr></thead><tbody>");
  for i: 0..<count {
    cls := ifx results[i].verdict == "pass" then "pass" else "fail";
    jo_put(hj[..], "<tr><td><code>");
    jo_put(hj[..], results[i].scenario_id);
    jo_put(hj[..], "</code></td><td class='");
    jo_put(hj[..], cls);
    jo_put(hj[..], "'>");
    jo_put(hj[..], results[i].verdict);
    jo_put(hj[..], "</td><td>");
    jo_put(hj[..], da_int_str(results[i].duration_ms, ib_h[..]));
    jo_put(hj[..], " ms</td><td>");
    jo_put(hj[..], results[i].summary);
    jo_put(hj[..], "</td><td>");
    if results[i].screenshot_ref.count > 0 {
      jo_put(hj[..], "<a href='");
      jo_put(hj[..], results[i].screenshot_ref);
      jo_put(hj[..], "'>view</a>");
    } else {
      jo_put(hj[..], "-");
    }
    jo_put(hj[..], "</td></tr>");
  }
  jo_put(hj[..], "</tbody></table></body></html>\n");
  _ = fs_write(da_cat(b[..], out_dir, "/report.html"), cast(string) rh[0..<hj[0].n]);
}

t_substr :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  if hay.count < needle.count { return false; }
  for i: 0..<(hay.count - needle.count + 1) {
    match := true;
    for j: 0..<needle.count {
      if hay[i + j] != needle[j] { match = false; break; }
    }
    if match { return true; }
  }
  return false;
}

t_run_ios_scenario :: (s: [] IosSession, sc_id: string, res_out: [] TsResult) {
  t0 := proc_now_ms();
  obs: [1] TsObservation;
  rep: [DA_REPLY] u8;
  r := TsResult.{
    scenario_id = sc_id, client_id = "ios-sim-1", target = "ios-sim",
    mode = "local", verdict = "pass", cleanup = "ok"
  };

  if sc_id == "ios.launch.cold" {
    r.steps_run = 4;
    ex_i: [1024] u8; ji: [1] Jo; jo_start(ji[..], ex_i[..]);
    jo_put(ji[..], "\"app_path\":"); jo_str(ji[..], da_slice(s[0].app_path[..], s[0].app_n));
    ex_l: [512] u8; jl: [1] Jo; jo_start(jl[..], ex_l[..]);
    jo_put(jl[..], "\"bundle_id\":"); jo_str(jl[..], da_slice(s[0].bundle_id[..], s[0].bundle_n));
    ok_b := ios_act(s, "boot", "ios-sim", "", 500, rep[..]);
    ok_i := ok_b && ios_act(s, "install", "ios-sim", cast(string) ex_i[0..<ji[0].n], 500, rep[..]);
    ok_l := ok_i && ios_act(s, "launch", "ios-app", cast(string) ex_l[0..<jl[0].n], 500, rep[..]);
    proc_sleep(2000);
    ok_o := ios_observe(s, "ios-01-cold-launch", "iOS cold launch", obs[..]);
    if !ok_b {
      r.verdict = "infrastructure-fail"; r.first_failure = "boot"; r.summary = "simhost boot simulator failed";
    } else if !ok_i {
      r.verdict = "infrastructure-fail"; r.first_failure = "install"; r.summary = "simhost install OpenAgents.app failed";
    } else if !ok_l {
      r.verdict = "product-fail"; r.first_failure = "launch"; r.summary = "simhost launch OpenAgents iOS failed";
    } else if !ok_o {
      r.verdict = "product-fail"; r.first_failure = "screenshot"; r.summary = "screenshot failed or blank after cold launch";
    } else {
      r.summary = "booted headless simulator, installed & launched OpenAgents iOS, captured non-blank frame";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.nav.sidebar-drawer" {
    r.steps_run = 2;
    ok1 := ios_act(s, "tap", "nav-button", "\"x\":34,\"y\":88", 200, rep[..]);
    proc_sleep(500);
    ok_o := ios_observe(s, "ios-02-sidebar", "sidebar drawer open", obs[..]);
    ok2 := ios_act(s, "swipe", "sidebar", "\"x\":320,\"y\":400,\"x2\":30,\"y2\":400,\"duration\":0.25", 300, rep[..]);
    proc_sleep(450);
    if !ok1 || !ok2 {
      r.verdict = "product-fail"; r.first_failure = "hid-nav"; r.summary = "simhost tap or swipe on sidebar drawer failed";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else if !ok_o {
      r.verdict = "infrastructure-fail"; r.first_failure = "screenshot"; r.summary = "sidebar screenshot failed";
    } else {
      r.summary = "tapped top-left nav button and swiped sidebar drawer closed via simhost HID";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.input.composer-type" {
    r.steps_run = 2;
    ok1 := ios_act(s, "tap", "composer", "\"x\":196,\"y\":780", 200, rep[..]);
    proc_sleep(400);
    ok2 := ios_act(s, "text", "composer", "\"text\":\"hello from ios tester\"", 400, rep[..]);
    proc_sleep(450);
    ok_o := ios_observe(s, "ios-03-composer", "composer typed", obs[..]);
    _ = ios_act(s, "tap", "dismiss-kb", "\"x\":196,\"y\":220", 200, rep[..]);
    proc_sleep(300);
    if !ok1 || !ok2 {
      r.verdict = "product-fail"; r.first_failure = "hid-text"; r.summary = "simhost tap or text into iOS composer failed";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else if !ok_o {
      r.verdict = "infrastructure-fail"; r.first_failure = "screenshot"; r.summary = "composer screenshot failed";
    } else {
      r.summary = "tapped iOS composer, typed text via simhost HID, captured keyboard & draft";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.appearance.light-dark" {
    r.steps_run = 2;
    ok1 := ios_act(s, "set_appearance", "ios-sim", "\"state\":\"light\"", 200, rep[..]);
    proc_sleep(500);
    ok_o := ios_observe(s, "ios-04-light", "light mode", obs[..]);
    ok2 := ios_act(s, "set_appearance", "ios-sim", "\"state\":\"dark\"", 200, rep[..]);
    proc_sleep(500);
    if !ok1 || !ok2 || !ok_o {
      r.verdict = "product-fail"; r.first_failure = "appearance"; r.summary = "light/dark appearance transition failed";
    } else {
      r.summary = "switched iOS Simulator light -> dark appearance and captured frame cleanly";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.lifecycle.rotate" {
    r.steps_run = 2;
    ok1 := ios_act(s, "rotate", "ios-sim", "\"direction\":\"right\"", 200, rep[..]);
    proc_sleep(600);
    ok_o := ios_observe(s, "ios-05-landscape", "landscape orientation", obs[..]);
    ok2 := ios_act(s, "rotate", "ios-sim", "\"direction\":\"left\"", 200, rep[..]);
    proc_sleep(500);
    if !ok1 || !ok2 || !ok_o {
      r.verdict = "product-fail"; r.first_failure = "rotate"; r.summary = "portrait <-> landscape rotation failed";
    } else {
      r.summary = "rotated iOS app portrait -> landscape -> portrait and captured frame";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.lifecycle.background-resume" {
    r.steps_run = 2;
    ex_l: [512] u8; jl: [1] Jo; jo_start(jl[..], ex_l[..]);
    jo_put(jl[..], "\"bundle_id\":"); jo_str(jl[..], da_slice(s[0].bundle_id[..], s[0].bundle_n));
    ok1 := ios_act(s, "button", "ios-sim", "\"name\":\"HOME\"", 200, rep[..]);
    proc_sleep(900);
    ok2 := ios_act(s, "launch", "ios-app", cast(string) ex_l[0..<jl[0].n], 500, rep[..]);
    proc_sleep(1000);
    ok_o := ios_observe(s, "ios-06-resumed", "after background resume", obs[..]);
    if !ok1 || !ok2 || !ok_o {
      r.verdict = "product-fail"; r.first_failure = "resume"; r.summary = "background (home) + relaunch failed";
    } else {
      r.summary = "backgrounded via Home button and resumed OpenAgents iOS cleanly";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.accessibility.describe" {
    r.steps_run = 1;
    ok_d := ios_act(s, "describe", "ios-app", "", 200, rep[..]);
    _ = ios_observe(s, "ios-07-describe", "after describe", obs[..]);
    if !ok_d {
      r.verdict = "product-fail"; r.first_failure = "describe-failed"; r.summary = "simhost describe failed on OpenAgents iOS";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else {
      r.summary = "simhost describe returned live OpenAgents iOS accessibility tree";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.lifecycle.draft-persistence" {
    r.steps_run = 4;
    // Note: ios.input.composer-type typed "hello from ios tester" earlier, and ios.lifecycle.background-resume
    // already backgrounded + relaunched. Verify the draft persisted in the live accessibility tree (#13906).
    ok_d := ios_act(s, "describe", "ios-app", "", 200, rep[..]);
    ok_o := ios_observe(s, "ios-08-draft-persist", "draft persistence check", obs[..]);
    tree := cast(string) rep[0..<rep.count];
    kept := ok_d && (t_substr(tree, "Hello from iOS tester") || t_substr(tree, "hello from ios tester"));
    if !ok_d {
      r.verdict = "product-fail"; r.first_failure = "describe-failed"; r.summary = "simhost describe failed during draft persistence check";
    } else if !kept {
      r.verdict = "product-fail"; r.first_failure = "draft-lost";
      r.summary = "unsent composer draft was lost across background + relaunch (#13906)";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else {
      r.summary = "unsent composer draft persisted across background + relaunch (#13906)";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
    _ = ok_o;
  } else if sc_id == "ios.sidebar.settings-sheet" {
    r.steps_run = 4;
    ok1 := ios_act(s, "tap", "open-sidebar", "\"x\":34,\"y\":84", 200, rep[..]);
    proc_sleep(450);
    // Tap Settings gear at bottom-right of sidebar drawer (~275, 815 on 402x874).
    ok2 := ios_act(s, "tap", "settings-gear", "\"x\":275,\"y\":815", 250, rep[..]);
    proc_sleep(500);
    ok_d := ios_act(s, "describe", "ios-settings", "", 200, rep[..]);
    ok_o := ios_observe(s, "ios-09-settings", "iOS Settings sheet", obs[..]);
    // Dismiss Settings (top-left back/close button or swipe down).
    _ = ios_act(s, "tap", "settings-close", "\"x\":34,\"y\":84", 200, rep[..]);
    proc_sleep(400);
    _ = ios_act(s, "swipe", "close-sidebar", "\"x\":340,\"y\":400,\"x2\":30,\"y2\":400,\"duration\":0.25", 250, rep[..]);
    proc_sleep(400);
    if !ok1 || !ok2 || !ok_d || !ok_o {
      r.verdict = "product-fail"; r.first_failure = "settings-open"; r.summary = "failed to open or inspect iOS Settings sheet";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else {
      r.summary = "opened sidebar, tapped Settings gear, captured Settings frame & accessibility tree, dismissed";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.composer.computer-picker" {
    r.steps_run = 3;
    // Tap Computer chip at bottom-left of composer (~95, 812).
    ok1 := ios_act(s, "tap", "computer-chip", "\"x\":95,\"y\":812", 250, rep[..]);
    proc_sleep(500);
    ok_d := ios_act(s, "describe", "ios-computer-picker", "", 200, rep[..]);
    ok_o := ios_observe(s, "ios-10-computer-picker", "computer picker sheet", obs[..]);
    // Dismiss picker by tapping dimmed backdrop near top.
    _ = ios_act(s, "tap", "dismiss-picker", "\"x\":200,\"y\":160", 200, rep[..]);
    proc_sleep(400);
    if !ok1 || !ok_d || !ok_o {
      r.verdict = "product-fail"; r.first_failure = "computer-picker"; r.summary = "failed to open or capture Computer picker sheet";
    } else {
      r.summary = "tapped Computer chip, captured picker sheet & accessibility tree, dismissed cleanly";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.composer.repo-picker" {
    r.steps_run = 3;
    // Tap Repository chip next to Computer chip (~235, 812).
    ok1 := ios_act(s, "tap", "repo-chip", "\"x\":235,\"y\":812", 250, rep[..]);
    proc_sleep(500);
    ok_d := ios_act(s, "describe", "ios-repo-picker", "", 200, rep[..]);
    ok_o := ios_observe(s, "ios-11-repo-picker", "repo picker sheet", obs[..]);
    _ = ios_act(s, "tap", "dismiss-picker", "\"x\":200,\"y\":160", 200, rep[..]);
    proc_sleep(400);
    if !ok1 || !ok_d || !ok_o {
      r.verdict = "product-fail"; r.first_failure = "repo-picker"; r.summary = "failed to open or capture Repository picker sheet";
    } else {
      r.summary = "tapped Repository chip, captured picker sheet & accessibility tree, dismissed cleanly";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.conversation.options-menu" {
    r.steps_run = 3;
    // Tap top-right Conversation options (...) button (346, 66, 44, 44 -> center 368, 88).
    ok1 := ios_act(s, "tap", "conversation-options", "\"x\":368,\"y\":88", 250, rep[..]);
    proc_sleep(500);
    ok_d := ios_act(s, "describe", "ios-options-menu", "", 200, rep[..]);
    ok_o := ios_observe(s, "ios-12-options-menu", "conversation options menu", obs[..]);
    _ = ios_act(s, "tap", "dismiss-options", "\"x\":200,\"y\":320", 200, rep[..]);
    proc_sleep(400);
    if !ok1 || !ok_d || !ok_o {
      r.verdict = "product-fail"; r.first_failure = "options-menu"; r.summary = "failed to open or capture Conversation options menu";
    } else {
      r.summary = "tapped Conversation options (...), captured menu & accessibility tree, dismissed cleanly";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.settings.usage-screen" {
    r.steps_run = 5;
    ok1 := ios_act(s, "tap", "open-sidebar", "\"x\":34,\"y\":84", 200, rep[..]);
    proc_sleep(450);
    ok2 := ios_act(s, "tap", "settings-gear", "\"x\":275,\"y\":815", 250, rep[..]);
    proc_sleep(450);
    // Tap Usage button inside Settings: Button "Usage" (16, 152, 370, 53) -> center (201, 178).
    ok3 := ios_act(s, "tap", "settings-usage", "\"x\":201,\"y\":178", 250, rep[..]);
    proc_sleep(500);
    ok_d := ios_act(s, "describe", "ios-usage", "", 200, rep[..]);
    ok_o := ios_observe(s, "ios-13-usage", "iOS Settings Usage screen", obs[..]);
    // Navigate back from Usage -> Settings -> close sidebar.
    _ = ios_act(s, "tap", "usage-back", "\"x\":38,\"y\":84", 200, rep[..]);
    proc_sleep(350);
    _ = ios_act(s, "tap", "settings-back", "\"x\":38,\"y\":84", 200, rep[..]);
    proc_sleep(350);
    _ = ios_act(s, "swipe", "close-sidebar", "\"x\":340,\"y\":400,\"x2\":30,\"y2\":400,\"duration\":0.25", 250, rep[..]);
    proc_sleep(400);
    if !ok1 || !ok2 || !ok3 || !ok_d || !ok_o {
      r.verdict = "product-fail"; r.first_failure = "usage-screen"; r.summary = "failed to open or capture iOS Settings -> Usage screen";
    } else {
      r.summary = "navigated Sidebar -> Settings -> Usage, captured Usage screen & accessibility tree, returned cleanly";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.sidebar.search-filter" {
    r.steps_run = 5;
    ok1 := ios_act(s, "tap", "open-sidebar", "\"x\":38,\"y\":84", 200, rep[..]);
    proc_sleep(450);
    // Tap Search row in sidebar drawer (~110, 150) which opens Recents & Search chats.
    ok2 := ios_act(s, "tap", "sidebar-search", "\"x\":110,\"y\":150", 250, rep[..]);
    proc_sleep(450);
    // Tap "Search chats" input at bottom (x=180, y=805), type filter query, capture UI.
    _ = ios_act(s, "tap", "search-chats-input", "\"x\":180,\"y\":805", 200, rep[..]);
    proc_sleep(350);
    ok3 := ios_act(s, "text", "sidebar-search", "\"text\":\"openagents\"", 300, rep[..]);
    proc_sleep(450);
    ok_o := ios_observe(s, "ios-14-sidebar-search", "iOS sidebar search filter", obs[..]);
    // Dismiss keyboard and tap "New chat" pill (315, 745) to return cleanly to Chat screen.
    _ = ios_act(s, "tap", "dismiss-kb", "\"x\":200,\"y\":250", 200, rep[..]);
    proc_sleep(350);
    _ = ios_act(s, "tap", "new-chat-return", "\"x\":315,\"y\":745", 250, rep[..]);
    proc_sleep(450);
    if !ok1 || !ok2 || !ok3 || !ok_o {
      r.verdict = "product-fail"; r.first_failure = "sidebar-search"; r.summary = "failed to open or type into iOS sidebar Search";
    } else {
      r.summary = "opened sidebar Search, typed filter query, captured Search UI, dismissed cleanly";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
  } else if sc_id == "ios.accessibility.audit" {
    r.steps_run = 1;
    ok_d := ios_act(s, "describe", "ios-audit", "", 200, rep[..]);
    ok_o := ios_observe(s, "ios-15-a11y-audit", "iOS accessibility audit", obs[..]);
    tree := cast(string) rep[0..<rep.count];
    has_root := t_substr(tree, "OpenAgents");
    has_sidebar := t_substr(tree, "Open sidebar");
    has_options := t_substr(tree, "Conversation options");
    if !ok_d || !has_root || !has_sidebar || !has_options {
      r.verdict = "product-fail"; r.first_failure = "a11y-missing-controls";
      r.summary = "accessibility audit missing required OpenAgents / Open sidebar / Conversation options labels";
      r.screenshot_ref = obs[0].screenshot_ref;
    } else {
      r.summary = "accessibility audit verified OpenAgents root, Open sidebar, and Conversation options labels";
      r.screenshot_ref = obs[0].screenshot_ref;
    }
    _ = ok_o;
  } else {
    r.verdict = "unqualified"; r.first_failure = "unknown"; r.summary = "unknown iOS scenario";
  }

  r.duration_ms = proc_now_ms() - t0;
  ios_record_result(s, r);
  res_out[0] = r;
}

t_write_ios_reports :: (s: [] IosSession, results: [] TsResult, count: int) {
  out_dir := da_slice(s[0].out_dir[..], s[0].out_n);
  b: [1] DaBuf;
  jb: [AR_WIRE_BUF] u8;
  dn := ar_write_def(ios_agent_definition(), jb[..]);
  if dn > 0 { _ = fs_write(da_cat(b[..], out_dir, "/agent-definition.json"), cast(string) jb[0..<dn]); }
  inv := ArInvRecord.{
    invocation_id = "inv-ios-mvp", root_session_id = "sess-ios-mvp", parent_invocation_id = "",
    agent_id = "ios-sim-tester", depth = 0, target_kind = "ios-sim",
    seat = "mobile-client", device_lease = da_slice(s[0].device[..], s[0].device_n), account_lease = "",
    workspace_dir = out_dir, budget = ios_agent_definition().budget, seed = 1, state = "completed",
    evidence_dir = out_dir
  };
  in_n := ar_write_inv(inv, jb[..]);
  if in_n > 0 { _ = fs_write(da_cat(b[..], out_dir, "/agent-invocation.json"), cast(string) jb[0..<in_n]); }

  passed := 0; failed := 0; infra := 0;
  for i: 0..<count {
    if results[i].verdict == "pass" { passed += 1; }
    else if results[i].verdict == "product-fail" { failed += 1; }
    else { infra += 1; }
  }
  rj: [65536] u8;
  j: [1] Jo;
  jo_start(j[..], rj[..]);
  jo_obj(j[..]);
  jo_key(j[..], "schema"); jo_str(j[..], TESTER_REPORT_SCHEMA);
  jo_key(j[..], "target"); jo_str(j[..], "ios-sim");
  jo_key(j[..], "mode"); jo_str(j[..], "local");
  jo_key(j[..], "total"); jo_int(j[..], count);
  jo_key(j[..], "passed"); jo_int(j[..], passed);
  jo_key(j[..], "product_failed"); jo_int(j[..], failed);
  jo_key(j[..], "other_failed"); jo_int(j[..], infra);
  jo_key(j[..], "results"); jo_arr(j[..]);
  rb: [TS_BUF] u8;
  for i: 0..<count {
    rn := ts_write_result(results[i], rb[..]);
    if rn > 0 { jo_raw(j[..], cast(string) rb[0..<rn]); }
  }
  jo_end(j[..]);
  jo_end(j[..]);
  jo_put(j[..], "\n");
  _ = fs_write(da_cat(b[..], out_dir, "/report.json"), cast(string) rj[0..<j[0].n]);

  rh: [65536] u8;
  hj: [1] Jo;
  jo_start(hj[..], rh[..]);
  jo_put(hj[..], "<!doctype html><html><head><meta charset='utf-8'><title>OpenAgents iOS Simulated Tester Report</title>");
  jo_put(hj[..], "<style>body{font-family:system-ui,sans-serif;max-width:960px;margin:24px auto;padding:0 16px;background:#111;color:#eee}table{width:100%;border-collapse:collapse}th,td{padding:8px 10px;border-bottom:1px solid #333;text-align:left}.pass{color:#4ade80;font-weight:600}.fail{color:#f87171;font-weight:600}.meta{color:#9ca3af}</style></head><body>");
  jo_put(hj[..], "<h1>OpenAgents iOS Simulated Tester Report</h1><p class='meta'>Passed: ");
  ib_h: [32] u8;
  jo_put(hj[..], da_int_str(passed, ib_h[..]));
  jo_put(hj[..], " / ");
  jo_put(hj[..], da_int_str(count, ib_h[..]));
  jo_put(hj[..], "</p><table><thead><tr><th>Scenario</th><th>Verdict</th><th>Duration</th><th>Summary</th><th>Screenshot</th></tr></thead><tbody>");
  for i: 0..<count {
    cls := ifx results[i].verdict == "pass" then "pass" else "fail";
    jo_put(hj[..], "<tr><td><code>"); jo_put(hj[..], results[i].scenario_id);
    jo_put(hj[..], "</code></td><td class='"); jo_put(hj[..], cls); jo_put(hj[..], "'>");
    jo_put(hj[..], results[i].verdict); jo_put(hj[..], "</td><td>");
    jo_put(hj[..], da_int_str(results[i].duration_ms, ib_h[..])); jo_put(hj[..], " ms</td><td>");
    jo_put(hj[..], results[i].summary); jo_put(hj[..], "</td><td>");
    if results[i].screenshot_ref.count > 0 {
      jo_put(hj[..], "<a href='"); jo_put(hj[..], results[i].screenshot_ref); jo_put(hj[..], "'>view</a>");
    } else { jo_put(hj[..], "-"); }
    jo_put(hj[..], "</td></tr>");
  }
  jo_put(hj[..], "</tbody></table></body></html>\n");
  _ = fs_write(da_cat(b[..], out_dir, "/report.html"), cast(string) rh[0..<hj[0].n]);
}

t_write_web_reports :: (s: [] WebSession, results: [] TsResult, count: int) {
  out_dir := da_slice(s[0].out_dir[..], s[0].out_n);
  b: [1] DaBuf;
  jb: [AR_WIRE_BUF] u8;
  dn := ar_write_def(web_agent_definition(), jb[..]);
  if dn > 0 { _ = fs_write(da_cat(b[..], out_dir, "/agent-definition.json"), cast(string) jb[0..<dn]); }
  inv := ArInvRecord.{
    invocation_id = "inv-web-mvp", root_session_id = "sess-web-mvp", parent_invocation_id = "",
    agent_id = "web-journey-tester", depth = 0, target_kind = "web",
    seat = "web-client", device_lease = "headless-chrome-webgpu", account_lease = "",
    workspace_dir = out_dir,
    budget = web_agent_definition().budget, seed = 1, state = "completed",
    evidence_dir = out_dir
  };
  in_n := ar_write_inv(inv, jb[..]);
  if in_n > 0 { _ = fs_write(da_cat(b[..], out_dir, "/agent-invocation.json"), cast(string) jb[0..<in_n]); }
  passed := 0; failed := 0; infra := 0;
  for i: 0..<count {
    if results[i].verdict == "pass" { passed += 1; }
    else if results[i].verdict == "product-fail" { failed += 1; }
    else { infra += 1; }
  }
  rj: [65536] u8; j: [1] Jo;
  jo_start(j[..], rj[..]);
  jo_obj(j[..]);
  jo_key(j[..], "schema"); jo_str(j[..], TESTER_REPORT_SCHEMA);
  jo_key(j[..], "target"); jo_str(j[..], "web");
  jo_key(j[..], "mode"); jo_str(j[..], "local");
  jo_key(j[..], "total"); jo_int(j[..], count);
  jo_key(j[..], "passed"); jo_int(j[..], passed);
  jo_key(j[..], "product_failed"); jo_int(j[..], failed);
  jo_key(j[..], "other_failed"); jo_int(j[..], infra);
  jo_key(j[..], "results"); jo_arr(j[..]);
  rb: [TS_BUF] u8;
  for i: 0..<count {
    rn := ts_write_result(results[i], rb[..]);
    if rn > 0 { jo_raw(j[..], cast(string) rb[0..<rn]); }
  }
  jo_end(j[..]); jo_end(j[..]);
  _ = fs_write(da_cat(b[..], out_dir, "/report.json"), cast(string) rj[0..<j[0].n]);

  rh: [65536] u8; hj: [1] Jo; jo_start(hj[..], rh[..]);
  ib_h: [32] u8;
  jo_put(hj[..], "<!doctype html><html><head><meta charset='utf-8'><title>OpenAgents Web Tester Report</title>");
  jo_put(hj[..], "<style>body{font-family:system-ui,sans-serif;background:#0e0f12;color:#e6e8ec;padding:24px;}table{border-collapse:collapse;width:100%;}th,td{border:1px solid #262a33;padding:8px 10px;text-align:left;}th{background:#171a21;}.pass{color:#5ee38c;}.fail{color:#ff6b6b;}a{color:#7cb7ff;}</style></head><body>");
  jo_put(hj[..], "<h1>OpenAgents Web Tester Report</h1><p>Target: web (headless WebGPU Chrome) &middot; Passed: ");
  jo_put(hj[..], da_int_str(passed, ib_h[..])); jo_put(hj[..], " / ");
  jo_put(hj[..], da_int_str(count, ib_h[..])); jo_put(hj[..], "</p><table><thead><tr><th>Scenario</th><th>Verdict</th><th>Duration</th><th>Summary</th><th>Screenshot</th></tr></thead><tbody>");
  for i: 0..<count {
    jo_put(hj[..], "<tr><td><code>"); jo_put(hj[..], results[i].scenario_id); jo_put(hj[..], "</code></td><td class='");
    jo_put(hj[..], ifx results[i].verdict == "pass" then "pass" else "fail"); jo_put(hj[..], "'>");
    jo_put(hj[..], results[i].verdict); jo_put(hj[..], "</td><td>");
    jo_put(hj[..], da_int_str(results[i].duration_ms, ib_h[..])); jo_put(hj[..], " ms</td><td>");
    jo_put(hj[..], results[i].summary); jo_put(hj[..], "</td><td>");
    if results[i].screenshot_ref.count > 0 {
      jo_put(hj[..], "<a href='"); jo_put(hj[..], results[i].screenshot_ref); jo_put(hj[..], "'>view</a>");
    } else { jo_put(hj[..], "-"); }
    jo_put(hj[..], "</td></tr>");
  }
  jo_put(hj[..], "</tbody></table></body></html>\n");
  _ = fs_write(da_cat(b[..], out_dir, "/report.html"), cast(string) rh[0..<hj[0].n]);
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("tester: failed to load arguments"); return 2; }

  do_checks := false;
  do_selftest := false;
  target := "desktop";
  mode := "local";
  only := "";
  out_dir := "";
  app_path := "";
  device := "OpenAgents Sidebar Regression";
  bundle_id := "com.openagents.app";

  i := 0;
  while i < a[0].n {
    arg := args_at(a[..], i);
    if arg == "--checks" { do_checks = true; }
    else if arg == "--selftest" { do_selftest = true; }
    else if arg == "--target" && i + 1 < a[0].n { i += 1; target = args_at(a[..], i); }
    else if arg == "--mode" && i + 1 < a[0].n { i += 1; mode = args_at(a[..], i); }
    else if arg == "--only" && i + 1 < a[0].n { i += 1; only = args_at(a[..], i); }
    else if arg == "--out" && i + 1 < a[0].n { i += 1; out_dir = args_at(a[..], i); }
    else if arg == "--app" && i + 1 < a[0].n { i += 1; app_path = args_at(a[..], i); }
    else if arg == "--device" && i + 1 < a[0].n { i += 1; device = args_at(a[..], i); }
    else if arg == "--bundle" && i + 1 < a[0].n { i += 1; bundle_id = args_at(a[..], i); }
    i += 1;
  }

  if do_checks {
    d := dt_agent_definition();
    id := ios_agent_definition();
    wd := web_agent_definition();
    jb: [AR_WIRE_BUF] u8;
    if ar_write_def(d, jb[..]) <= 0 || ar_write_def(id, jb[..]) <= 0 || ar_write_def(wd, jb[..]) <= 0 {
      tool_errln("tester --checks: failed to encode AgentDefinition");
      return 1;
    }
    ib1: [32] u8;
    ib2: [32] u8;
    ib3: [32] u8;
    t_out("tester --checks: ok (");
    t_out(da_int_str(DT_SCENARIO_COUNT, ib1[..]));
    t_out(" desktop + ");
    t_out(da_int_str(IOS_SCENARIO_COUNT, ib2[..]));
    t_out(" ios-sim + ");
    t_out(da_int_str(WEB_SCENARIO_COUNT, ib3[..]));
    t_outln(" web scenarios registered, agent definitions & schemas valid)");
    return 0;
  }

  cwd_buf: [DA_PATH] u8;
  repo := fs_cwd(cwd_buf[..]);

  if target == "web" {
    b_out: [1] DaBuf;
    if out_dir.count == 0 {
      ib: [32] u8;
      out_dir = da_cat3(b_out[..], repo, "/build/tester-runs/web-", da_int_str(proc_now_ms() % 1000000, ib[..]));
    }
    wsess: [1] WebSession;
    if !web_start(wsess[..], repo, out_dir) {
      web_stop(wsess[..]);
      return 1;
    }
    if do_selftest {
      obs: [1] TsObservation;
      ok_w := web_shot(wsess[..], "/", "1280x820", "selftest-web", 2500, obs[..]);
      web_stop(wsess[..]);
      if !ok_w {
        tool_errln("selftest web: FAIL — headless Chrome shot failed");
        return 1;
      }
      t_outln("selftest web: PASS (local coax serve ok, headless WebGPU Chrome screenshot captured)");
      return 0;
    }
    wsc := web_scenarios();
    wresults: [WEB_SCENARIO_COUNT] TsResult;
    wrc := 0; wpass := 0; wfail := 0;
    for k: 0..<WEB_SCENARIO_COUNT {
      if only.count > 0 && wsc[k].id != only { continue; }
      t0 := proc_now_ms();
      obs: [1] TsObservation;
      ok_s := web_shot(wsess[..], wsc[k].route, wsc[k].viewport, wsc[k].id, 2500, obs[..]);
      r := TsResult.{
        scenario_id = wsc[k].id, client_id = "web-1", target = "web", mode = "local",
        verdict = ifx ok_s then "pass" else "product-fail",
        duration_ms = proc_now_ms() - t0, steps_run = 1,
        first_failure = ifx ok_s then "" else "shot-failed",
        summary = ifx ok_s then wsc[k].title else "headless WebGPU Chrome shot failed or blank frame",
        screenshot_ref = obs[0].screenshot_ref, cleanup = "ok"
      };
      web_record_result(wsess[..], r);
      wresults[wrc] = r; wrc += 1;
      if ok_s { wpass += 1; } else { wfail += 1; }
      ib: [32] u8;
      t_out(r.verdict); t_out("  "); t_out(r.scenario_id); t_out("  (");
      t_out(da_int_str(r.duration_ms, ib[..])); t_out(" ms)  "); t_outln(r.summary);
    }
    web_stop(wsess[..]);
    t_write_web_reports(wsess[..], wresults[..], wrc);
    ibp: [32] u8; ibf: [32] u8;
    t_out("\nSummary: "); t_out(da_int_str(wpass, ibp[..]));
    t_out(" passed, "); t_out(da_int_str(wfail, ibf[..]));
    t_out(". Report: "); t_out(out_dir); t_outln("/report.html");
    return ifx wfail == 0 then 0 else 1;
  }

  if target == "ios-sim" {
    b_app: [1] DaBuf;
    if app_path.count == 0 {
      app_path = da_cat(b_app[..], repo, "/apps/openagents-ios/build/Build/Products/Debug-iphonesimulator/OpenAgents.app");
    }
    b_out: [1] DaBuf;
    if out_dir.count == 0 {
      ib: [32] u8;
      out_dir = da_cat3(b_out[..], repo, "/build/tester-runs/ios-sim-", da_int_str(proc_now_ms() % 1000000, ib[..]));
    }
    isess: [1] IosSession;
    if !ios_start(isess[..], repo, app_path, device, bundle_id, out_dir) {
      ios_stop(isess[..]);
      return 1;
    }
    if do_selftest {
      rep: [DA_REPLY] u8;
      n := ios_rpc(isess[..], "list", "", rep[..], 15000);
      if n <= 0 || !da_json_ok(cast(string) rep[0..<n]) {
        ios_stop(isess[..]);
        tool_errln("selftest ios-sim: FAIL — simhost list failed");
        return 1;
      }
      _ = ios_act(isess[..], "boot", "ios-sim", "", 500, rep[..]);
      obs: [1] TsObservation;
      ok_s := ios_observe(isess[..], "selftest-ios", "ios selftest", obs[..]);
      ios_stop(isess[..]);
      if !ok_s {
        tool_errln("selftest ios-sim: FAIL — simhost screenshot failed");
        return 1;
      }
      t_outln("selftest ios-sim: PASS (isolated simhost ok, headless screenshot captured, zero Simulator.app window)");
      return 0;
    }
    if !fs_exists(app_path) {
      ios_stop(isess[..]);
      tool_err("tester: OpenAgents iOS simulator app not found at ");
      tool_errln(app_path);
      return 1;
    }
    isc := ios_scenarios();
    iresults: [IOS_SCENARIO_COUNT] TsResult;
    irc := 0; ipass := 0; ifail := 0;
    for k: 0..<IOS_SCENARIO_COUNT {
      if only.count > 0 && isc[k].id != only { continue; }
      one: [1] TsResult;
      t_run_ios_scenario(isess[..], isc[k].id, one[..]);
      iresults[irc] = one[0];
      irc += 1;
      if one[0].verdict == "pass" { ipass += 1; } else { ifail += 1; }
      ib: [32] u8;
      t_out(one[0].verdict); t_out("  "); t_out(one[0].scenario_id);
      t_out("  ("); t_out(da_int_str(one[0].duration_ms, ib[..])); t_out(" ms)  ");
      t_outln(one[0].summary);
    }
    ios_stop(isess[..]);
    t_write_ios_reports(isess[..], iresults[..], irc);
    ib1: [32] u8; ib2: [32] u8;
    t_out("\nSummary: "); t_out(da_int_str(ipass, ib1[..]));
    t_out(" passed, "); t_out(da_int_str(ifail, ib2[..]));
    t_out(" failed. Report: "); t_out(out_dir); t_outln("/report.html");
    return ifx ifail == 0 then 0 else 1;
  }

  if target != "desktop" {
    tool_errln("tester: supported targets are desktop and ios-sim (web follows in Phase 3)");
    return 2;
  }
  b_app: [1] DaBuf;
  if app_path.count == 0 {
    app_path = da_cat(b_app[..], repo, "/apps/openagents-desktop/build/OpenAgents.app");
  }
  if !fs_exists(app_path) {
    tool_err("tester: OpenAgents.app not found at ");
    tool_errln(app_path);
    tool_errln("Build it first with: apps/openagents-desktop/build.sh");
    return 1;
  }

  b_out: [1] DaBuf;
  if out_dir.count == 0 {
    ib: [32] u8;
    out_dir = da_cat3(b_out[..], repo, "/build/tester-runs/desktop-", da_int_str(proc_now_ms() % 1000000, ib[..]));
  }

  sess: [1] DaSession;
  if !da_stage(sess[..], repo, app_path, out_dir, mode) { return 1; }
  if !da_launch(sess[..]) {
    _ = da_stop(sess[..]);
    return 1;
  }

  if do_selftest {
    obs: [1] TsObservation;
    active: [1] bool;
    ok := da_observe(sess[..], "selftest", "selftest observation", obs[..], active[..]);
    _ = da_stop(sess[..]);
    if !ok { tool_errln("selftest: failed to observe launched app"); return 1; }
    if active[0] { tool_errln("selftest: FAIL — app stole focus (active=true)"); return 1; }
    if obs[0].width < 420 || obs[0].height < 320 { tool_errln("selftest: FAIL — invalid window size"); return 1; }
    t_outln("selftest desktop: PASS (probe ok, zero focus stealing, valid window geometry, clean quit)");
    return 0;
  }

  sc := dt_scenarios();
  results: [DT_SCENARIO_COUNT] TsResult;
  rcount := 0;
  passed := 0;
  failed := 0;

  for k: 0..<DT_SCENARIO_COUNT {
    if only.count > 0 && sc[k].id != only { continue; }
    one: [1] TsResult;
    t_run_scenario(sess[..], sc[k].id, one[..]);
    results[rcount] = one[0];
    rcount += 1;
    if one[0].verdict == "pass" { passed += 1; } else { failed += 1; }
    ib: [32] u8;
    t_out(one[0].verdict);
    t_out("  ");
    t_out(one[0].scenario_id);
    t_out("  (");
    t_out(da_int_str(one[0].duration_ms, ib[..]));
    t_out(" ms)  ");
    t_outln(one[0].summary);
  }

  _ = da_stop(sess[..]);
  t_write_reports(sess[..], results[..], rcount);

  ib1: [32] u8;
  ib2: [32] u8;
  t_out("\nSummary: ");
  t_out(da_int_str(passed, ib1[..]));
  t_out(" passed, ");
  t_out(da_int_str(failed, ib2[..]));
  t_out(" failed. Report: ");
  t_out(out_dir);
  t_outln("/report.html");
  return ifx failed == 0 then 0 else 1;
}
