{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oa-collection-lock-v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "assets"
  ],
  "properties": {
    "schema": {
      "const": "oa-collection-lock-v1"
    },
    "id": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)+$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "previews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "profile"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "profile": {
            "const": "geometry-contact-sheet"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
