+    pub fn into_streaming(self, frames: usize) -> Result<(Self, LoopFeeder), String> {
+        let Self {
+            source,
+            mut emitter,
+            bus,
+            priority,
+            start,
+            progress,
+        } = self;
+        let Source::Clip(clip) = source else {
+            return Err("Audio source is already streaming".into());
