+                    websocket::client(&format!("ws://{address}/world"), socket)
+                        .await
+                        .unwrap(),
+                ),
+            };
+            connect(stream, &cfg, unix_now().unwrap()).await.unwrap()
+        };
+        let channel = open().await;
+        // The chamber signer cannot differ from the proved device identity.
+        assert!(
