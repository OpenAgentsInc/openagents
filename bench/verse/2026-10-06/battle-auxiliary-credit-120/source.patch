+            read_frame(&mut read, MAX_RESPONSE_BYTES).await.unwrap(),
+            denied
+        );
+        let result = timeout(Duration::from_secs(1), task)
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            result.unwrap_err(),
+            "Chamber connection is not authenticated"
+        );
+        assert!(events.recv().await.is_none());
+    }
