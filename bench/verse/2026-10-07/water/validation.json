  "web": {
    "command": "scripts/build-everglade-web.sh --with-pack SITE; openagents browser run -- python3 -I webcheck.py SITE OUT CDP_DIR",
    "browser": "headless Chrome on an Apple M5 Max",
    "pages": {
      "webgpu": {
        "url": "?zone=water&frames",
        "probe": {
          "canvas_has_webgl2": false,
          "navigator_gpu": true,
          "webgpu_adapter": true,
          "status": null,
          "title": "Everglade"
        },
        "screenshot": "web-webgpu.png",
        "errors": [
          "Failed to load resource: the server responded with a status of 404 (File not found)"
        ]
      },
      "webgl2": {
        "url": "?gl&zone=water&frames",
        "probe": {
          "canvas_has_webgl2": true,
          "navigator_gpu": true,
          "webgpu_adapter": true,
          "status": null,
          "title": "Everglade"
        },
        "screenshot": "web-webgl2.png",
        "errors": []
      }
    },
    "result": "The Water Lab draws its sea, river, and falls through the shared water shader on WebGPU (the canvas holds a WebGPU context) and with ?gl on WebGL2 (the canvas holds a WebGL2 context), at 60 frames a second in both; the only console error is the test server's missing favicon."
  },
  "tests": {
    "shader_validation": "cargo test -p verse-pbr --lib shading (both renderers, default and GLES variants) and cargo test -p verse --lib gles (the SHADERS table, GLSL ES 3.00 and Metal translation)",
    "surface_parity": "cargo test -p verse-pbr --lib water::parity: 80 GPU-displaced points over five ticks up to 37,000,017, crests to 1.6 m: worst 2.1 um against WaveSet::at_rest and 37 um against Surface::sample (its own five-round inversion), under the 1 mm bound"
  },
  "timing_note": "frame_ms_with_readback includes a blocking readback on a machine running other builds; the per-view water cost is the difference with the dry render and is noisy to about a millisecond. Per-tier GPU budgets are W11's measurement.",
  "dry_renders": "The renders without water are compared and digested (capture.json) but not retained."
}