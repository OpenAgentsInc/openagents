<?xml version="1.0" encoding="utf-8"?>
<!-- Paper Mono, the one typeface every surface uses. The faces come from
     crates/paper-mono/fonts through the paperMonoFonts task in
     app/build.gradle.kts. Paper Mono has no italic. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/paper_mono_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/paper_mono_medium" android:fontStyle="normal" android:fontWeight="500" />
    <font android:font="@font/paper_mono_semibold" android:fontStyle="normal" android:fontWeight="600" />
    <font android:font="@font/paper_mono_bold" android:fontStyle="normal" android:fontWeight="700" />
</font-family>
