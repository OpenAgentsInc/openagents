<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notices when Coder on your computers finishes or asks (#11165);
         asked for after you sign in to your account. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Nearby pairing: receiving mDNS from computers on the same Wi-Fi.
         Held only while the nearby list is open (NearbyMulticast.kt). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Requested only when you scan an invitation QR code. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <!-- Opening the Tailscale sign-in page in a browser. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
    <application android:label="${appLabel}" android:theme="@style/OpenAgentsTheme"
        android:icon="@drawable/ic_launcher" android:allowBackup="false"
        android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The desktop app's pairing QR code is the App Link
                 https://openagents.com/connect#<code>, so the system camera
                 opens this app with it. openagents.com serves the matching
                 /.well-known/assetlinks.json (this release key's SHA-256). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="openagents.com" android:path="/connect" />
            </intent-filter>
        </activity>
    </application>
</manifest>
