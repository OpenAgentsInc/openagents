<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's default entitlements. Multicast lets nearby pairing listen for
  computers on _openagents._udp (mDNS, crates/openagents-connect/src/nearby.rs).
  Apple approved it for com.openagents.app, and the OpenAgents App Store
  profile carries it. Push builds sign with Push/OpenAgents-Push.entitlements
  instead, which repeats it.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.multicast</key>
	<true/>
</dict>
</plist>
