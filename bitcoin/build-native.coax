// Emit one native Coax translation unit and its C header.
#load "platform/native-build.coax";
tool_main :: () -> int #export_c {
  a: [1] Args; if !args_load(a[..]) || args_count(a[..]) != 3 { tool_errln("usage: build-native SOURCE OUTPUT.c OUTPUT.h"); return 2; }
  return ifx bn_emit(args_at(a[..],0),args_at(a[..],1),args_at(a[..],2)) then 0 else 1;
}
