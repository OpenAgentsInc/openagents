// Read-only small-fixture explorer service.
// tool.sh: run-steps 250000000
#run_steps 250000000;
#load "../../platform/explorer-http.coax";
tool_main :: () -> int #export_c {
  a: [1] Args; if !args_load(a[..]) || args_count(a[..]) < 4 || args_count(a[..]) > 6 { tool_errln("usage: explorer-api CHAIN STATE BLOCKFILE_OR_DIRECTORY PORT [REQUEST_LIMIT [WEB_ROOT]]"); return 2; }
  chain := 0; for i: 1..<6 { if args_at(a[..],0) == CHAIN_NAMES[i] { chain = i; } }
  port := ex_decimal(args_at(a[..],3)); limit := ifx args_count(a[..]) >= 5 then ex_decimal(args_at(a[..],4)) else 0;
  web := ifx args_count(a[..]) == 6 then args_at(a[..],5) else "";
  if chain == 0 || port < 0 || port > 65535 || limit < 0 { return 2; }
  p := chain_params(chain); s: [1] ExplorerServer; table: [67108864] u8; s[0].table = table[..]; #assert ex_id(p.genesis.hash,s[0].genesis[..]);
  state := args_at(a[..],1); store := args_at(a[..],2);
  if !api_reload(s[..],state,chain) { tool_errln("explorer state unavailable"); return 1; }
  listener := cxsock_listen(port); if listener < 0 { return 1; }
  print("explorer-api http://127.0.0.1:% chain % profile pow-only\n",cxsock_port(listener),CHAIN_NAMES[chain]); flushed := cxtool_out_flush(); count := 0;
  while limit == 0 || count < limit {
    h := cxsock_accept(listener,1000); if h < 0 { continue; }
    api_connection(s[..],h,state,store,p,web); closed := cxsock_close(h); count += 1;
  }
  closed := cxsock_close(listener); return 0;
}
