// #12704 file adapter. One exclusive owner of STATE for the whole command;
// header and block inputs stay immutable. No concurrent append/rename/unlink.
// init|tip|recover|disconnect CHAIN STATE
// apply CHAIN STATE HEADERS_80_BYTES NOW_UNIX_SECONDS BLOCK...
// tool.sh: run-steps 250000000
#run_steps 250000000;
#load "../../../coax/lib/bitcoin/lightchain.coax";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";
#import "Basic";

LC_TOOL_HEADERS :: 4096; LC_TOOL_TABLE :: 8388608; LC_TOOL_BATCH :: 8388608;
// These are this teaching adapter's explicit resource limits. The library
// accepts caller-sized views; a node supplies its own storage/cache policy.
LcFile :: struct {
  table: [LC_TOOL_TABLE] u8; stage: [LC_TOOL_TABLE] u8;
  batch: [LC_TOOL_BATCH] u8; frame: [LC_TOOL_BATCH + 28] u8;
  log: [33554432] u8; raw: [16777216] u8;
  tree: [1] BlockTree; links: [LC_TOOL_HEADERS] BiLink; entries: [LC_TOOL_HEADERS] BiEntry;
  slots: [8192] int; chain: [LC_TOOL_HEADERS] int; path: [128] int;
  ins: [30000] TxIn; outs: [120000] TxOut; items: [100000] TxItem;
  ids: [2240000] u8; wids: [2240000] u8; merkle: [2240000] u8;
}
lc_file_chain :: (s: string) -> int {
  for i: 1..<6 { if s == CHAIN_NAMES[i] { return i; } }
  return 0;
}
lc_file_number :: (s: string) -> int {
  if s.count == 0 || s.count > 10 { return -1; }
  n := 0; for ch: s { if ch < '0' || ch > '9' { return -1; } n = n * 10 + cast(int) (ch - '0'); }
  return n;
}
lc_file_show :: (tip: LcTip) {
  print("profile pow-only, height %, hash ", tip.height);
  digits := "0123456789abcdef";
  for k: 0..<32 {
    v := tip.hash[31-k]; pair := [2] u8.[digits[v >> 4], digits[v & 15]];
    print("%", cast(string) pair[..]);
  }
  print("\n");
}
lc_file_append :: (f: [] LcFile, path: string, r: LcResult, sequence: u64, initial: bool) -> bool {
  if r.code != LC_OK || r.n > LC_TOOL_BATCH || sequence == 0xffffffffffffffff { return false; }
  start := ifx initial then 20 else 0;
  if initial { #assert kv_header_vartime(0, f[0].frame[..]) == 20; }
  frame := f[0].frame[start..<f[0].frame.count];
  for i: 0..<r.n { frame[8+i] = f[0].batch[i]; }
  kv_seal_vartime(frame, r.n, sequence + 1, 0);
  // The acknowledgement comes only after the complete frame and name sync.
  return fs_append_durable(path, cast(string) f[0].frame[0..<start+8+r.n]);
}
tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 3 { tool_errln("usage: light-chain init|tip|recover|disconnect CHAIN STATE; apply CHAIN STATE HEADERS NOW BLOCK..."); return 2; }
  action := args_at(a[..], 0); chain := lc_file_chain(args_at(a[..], 1)); path := args_at(a[..], 2);
  if chain == 0 { return 2; }
  p := chain_params(chain); f: [1] LcFile;
  if action == "init" {
    if args_count(a[..]) != 3 || fs_exists(path) { return 2; }
    g: [32] u8; #assert cp_unhex(p.genesis.hash, g[..]) == 32 && bitcoin_reverse32(g[..], g[..]) == SHA_OK;
    r := lc_init_vartime(chain, g[..], f[0].table[..], 0, f[0].stage[..], f[0].batch[..]);
    if !lc_file_append(f[..], path, r, 0, true) { return 1; }
    lc_file_show(lc_tip_vartime(f[0].stage[..], r.used)); return 0;
  }
  size := fs_read(path, f[0].log[..]); if size < 0 { return 1; }
  opened := kv_open_vartime(f[0].log[0..<size], f[0].table[..]);
  if opened.code != KV_OK { print("storage refused %\n", opened.code); return 1; }
  tip := lc_tip_vartime(f[0].table[..], opened.used);
  if tip.code != LC_OK || tip.chain != chain { print("refused %\n", LC_CONTEXT); return 1; }
  if action == "recover" {
    if args_count(a[..]) != 3 { return 2; }
    if opened.cut && !fs_truncate(path, opened.keep) { return 1; }
    print("recover: keep %, cut %\n", opened.keep, opened.cut); return 0;
  }
  if opened.cut { tool_errln("recover the torn tail before using this state"); return 1; }
  if action == "tip" { if args_count(a[..]) != 3 { return 2; } lc_file_show(tip); return 0; }
  r: LcResult;
  if action == "disconnect" {
    if args_count(a[..]) != 3 { return 2; }
    r = lc_disconnect_vartime(f[0].table[..], opened.used, f[0].stage[..], f[0].batch[..]);
  } else if action == "apply" {
    count := args_count(a[..]) - 5; blocks: [128] LcBlock;
    now := lc_file_number(args_at(a[..], 4)); headers := args_at(a[..], 3);
    total := fs_size(headers); stamp := fs_mtime_ns(headers);
    if count < 1 || count > blocks.count || now < 0 || total < 80 || total % 80 != 0 || total / 80 > LC_TOOL_HEADERS { return 2; }
    #assert bi_init(f[0].tree[..], p, f[0].links[..], f[0].entries[..], f[0].slots[..], f[0].chain[..]);
    raw: [80] u8;
    for i: 0..<total / 80 {
      if fs_read_at(headers, 80*i, raw[..]) != 80 { return 1; }
      h := bi_accept_header_vartime(f[0].tree[..], raw[..], now);
      if h.code != BI_OK { print("header refused %\n", h.code); return 1; }
    }
    if fs_size(headers) != total || fs_mtime_ns(headers) != stamp { return 1; }
    at := 0;
    for i: 0..<count {
      block_path := args_at(a[..], 5+i); n := fs_size(block_path);
      if n < 81 || n > 4000000 || n > f[0].raw.count - at { return 2; }
      bytes := f[0].raw[at..<at+n]; if fs_read(block_path, bytes) != n { return 1; }
      hash: [32] u8; #assert pow_block_hash_vartime(bytes[0..<80], hash[..]) == POW_OK;
      blocks[i] = LcBlock.{index=bi_find(f[0].tree[..], hash[..]), bytes=bytes}; at += n;
    }
    w := LcWork.{ins=f[0].ins[..], outs=f[0].outs[..], items=f[0].items[..], ids=f[0].ids[..], wids=f[0].wids[..], merkle=f[0].merkle[..], path=f[0].path[..]};
    r = lc_reorg_vartime(f[0].tree[..], f[0].table[..], opened.used, blocks[count-1].index, blocks[0..<count], f[0].stage[..], f[0].batch[..], w);
  } else { return 2; }
  if r.code != LC_OK { print("refused %\n", r.code); return 1; }
  if !lc_file_append(f[..], path, r, opened.seq, false) { tool_errln("append failed; reopen and recover before retrying"); return 1; }
  print("committed: disconnected %, connected %\n", r.disconnected, r.connected);
  lc_file_show(lc_tip_vartime(f[0].stage[..], r.used)); return 0;
}
