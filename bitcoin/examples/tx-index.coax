#run_steps 250000000;
#load "../../coax/lib/bitcoin/txindex.coax";
#import "Basic";
main :: () {
  d: [1] LcDemo; lc_demo_tree(d[..]); txi_demo_init(d[..]);
  positions: [128] int; end := 0; raw: [1024] u8;
  for i: 1..<LC_PREFIX.count {
    bytes := tx_unhex(LC_PREFIX[i],raw[..]); positions[i] = end+8; end += 8+bytes.count;
    blocks := [1] LcBlock.[LcBlock.{index=i,bytes=bytes}]; locs := [1] TxiLoc.[TxiLoc.{file=0,pos=positions[i]}];
    lc_demo_publish(d[..],txi_reorg_vartime(d[0].tree[..],d[0].live[..],d[0].used,i,blocks[..],locs[..],d[0].stage[..],d[0].batch[..],lc_demo_work(d[..])));
  }
  for i: 0..<6 { positions[101+i] = end+8; end += 8+d[0].raw[i].n; }
  a: [2] LcBlock; alocs: [2] TxiLoc; lc_demo_branch(d[..],0,2,a[..]);
  for i: 0..<2 { alocs[i] = TxiLoc.{file=0,pos=positions[101+i]}; }
  lc_demo_publish(d[..],txi_reorg_vartime(d[0].tree[..],d[0].live[..],d[0].used,102,a[..],alocs[..],d[0].stage[..],d[0].batch[..],lc_demo_work(d[..])));
  id: [32] u8; #assert cp_unhex("ec9bc0753b795b707db19571400e119ebb3dea2129b99ea793be32e602afc2be",id[..]) == 32;
  original := txi_find_vartime(d[0].live[..],d[0].used,id[..],false); #assert original.code == LC_OK && original.active;
  print("index profile: proof of work; scripts not validated\n");
  print("A tip 102: spend active %, confirmations %, raw % bytes\n",original.active,103-original.height,original.n);
  b: [4] LcBlock; locs: [4] TxiLoc; lc_demo_branch(d[..],2,4,b[..]);
  for i: 0..<4 { locs[i] = TxiLoc.{file=0,pos=positions[103+i]}; }
  r := txi_reorg_vartime(d[0].tree[..],d[0].live[..],d[0].used,106,b[..],locs[..],d[0].stage[..],d[0].batch[..],lc_demo_work(d[..]));
  #assert r.code == LC_MISSING && lc_tip_vartime(d[0].live[..],d[0].used).height == 102;
  print("late missing input: refusal %, index tip 102\n",r.code);
  lc_demo_publish(d[..],txi_reorg_vartime(d[0].tree[..],d[0].live[..],d[0].used,105,b[0..<3],locs[0..<3],d[0].stage[..],d[0].batch[..],lc_demo_work(d[..])));
  stale := txi_find_vartime(d[0].live[..],d[0].used,id[..],false);
  #assert stale.code == LC_OK && !stale.active;
  print("B tip 103: A spend active %, confirmations 0\n",stale.active);
  print("active-only lookup: refusal %\n",txi_find_vartime(d[0].live[..],d[0].used,id[..],true).code);
  abytes := a[0].bytes;
  #assert txi_check_tx_vartime(stale,id[..],abytes[0..<80],abytes[stale.offset..<stale.offset+stale.n],d[0].ins[..],d[0].outs[..],d[0].items[..]) == LC_OK;
  lc_demo_publish(d[..],txi_disconnect_vartime(d[0].live[..],d[0].used,d[0].stage[..],d[0].batch[..]));
  lc_demo_publish(d[..],txi_reorg_vartime(d[0].tree[..],d[0].live[..],d[0].used,102,a[..],alocs[..],d[0].stage[..],d[0].batch[..],lc_demo_work(d[..])));
  again := txi_find_vartime(d[0].live[..],d[0].used,id[..],false);
  #assert again.code == LC_OK && again.active && again.pos == original.pos && again.seq == original.seq;
  print("reconnect: A spend active %; original position retained\n",again.active);
}
