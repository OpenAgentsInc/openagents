// Freeze the acknowledged recording as bounded, immutable realm data.
// This tool grants no validation: record.coax creates the input; the independent
// raw-block/Core oracle checks it before publication. No network effects.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/json/json.coax";
LabText :: struct {data:[2097152]u8;n:int;bad:bool;}
lp_add :: (b:[]LabText,text:string) {if text.count>b[0].data.count-b[0].n {b[0].bad=true;return;}for c:text {b[0].data[b[0].n]=c;b[0].n+=1;}}
lp_num :: (b:[]LabText,n:int) {buf:[64]u8;o:[1]Jo;jo_start(o[..],buf[..]);jo_int(o[..],n);lp_add(b,jo_text(o[..]));}
lp_str :: (b:[]LabText,text:string) {buf:[32768]u8;o:[1]Jo;jo_start(o[..],buf[..]);jo_str(o[..],text);if o[0].bad {b[0].bad=true;}lp_add(b,jo_text(o[..]));}
lp_field :: (b:[]LabText,d:Jv,node:int,key:string,kind:int) {
  lp_add(b,key);lp_add(b,"=");v:=jv_get(d,node,key);
  if kind==0 {lp_num(b,jv_int(d,v,-1));}else if kind==1 {lp_str(b,ifx jv_kind(d,v)==JV_STRING then jv_raw(d,v) else "");}
  else {lp_add(b,ifx jv_bool(d,v) then "true" else "false");}lp_add(b,",");
}
#test "projection text escapes exact identifiers and fails closed at capacity" {
  b:[1]LabText;lp_str(b[..],"a\"b");#assert cast(string)b[0].data[0..<b[0].n]=="\"a\\\"b\"";
  lp_num(b[..],4294967295);#assert b[0].n==16;
  b[0].n=b[0].data.count;lp_add(b[..],"x");#assert b[0].bad;
}
tool_main :: ()->int #export_c #effects(all) {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=2 {tool_errln("usage: project RECORD_DIRECTORY OUTPUT.coax");return 2;}
  blocks:[1]LabText;txs:[1]LabText;ins:[1]LabText;outs:[1]LabText;meta:[1]LabText;all:[1]LabText;
  nb:=0;nt:=0;ni:=0;no:=0;
  for phase:0..<3 {
    buf:[2097152]u8;nodes:[32768]JvNode;d:[1]Jv;path:[4096]u8;
    n:=fs_read(fs_join(args_at(a[..],0),[3]string.["a.json","b.json","c.json"][phase],path[..]),buf[..]);
    if n<0 || !jv_parse(d[..],cast(string)buf[0..<n],nodes[..]) {return 1;}
    snap:=jv_get(d[0],0,"snapshot");rows:=jv_get(d[0],0,"blocks");count:=jv_len(d[0],rows);
    if jv_raw(d[0],jv_get(d[0],snap,"profile"))!="validated-v1" || count<1 || count>128 {return 1;}
    lp_add(meta[..],"  LabDataSnapshot.{first=");lp_num(meta[..],nb);lp_add(meta[..],",count=");lp_num(meta[..],count);lp_add(meta[..],",");
    lp_field(meta[..],d[0],snap,"height",0);lp_field(meta[..],d[0],snap,"hash",1);lp_add(meta[..],"},\n");
    for k:0..<count {
      b:=jv_at(d[0],rows,k);tt:=jv_get(d[0],b,"transactions");tn:=jv_len(d[0],tt);if tn<1 || tn>16 {return 1;}
      lp_add(blocks[..],"  LabDataBlock.{");for key:[5]string.["height","time","size","weight","active"] {lp_field(blocks[..],d[0],b,key,ifx key=="active" then 2 else 0);}
      for key:[3]string.["hash","previous","chainwork"] {lp_field(blocks[..],d[0],b,key,1);}
      lp_add(blocks[..],"tx=");lp_num(blocks[..],nt);lp_add(blocks[..],",count=");lp_num(blocks[..],tn);lp_add(blocks[..],"},\n");
      for j:0..<tn {
        t:=jv_at(d[0],tt,j);ii:=jv_get(d[0],t,"inputs");oo:=jv_get(d[0],t,"outputs");ic:=jv_len(d[0],ii);oc:=jv_len(d[0],oo);
        if ic<1 || ic>16 || oc<1 || oc>16 {return 1;}
        lp_add(txs[..],"  LabDataTx.{");lp_field(txs[..],d[0],t,"txid",1);lp_field(txs[..],d[0],t,"order",0);lp_field(txs[..],d[0],t,"weight",0);lp_field(txs[..],d[0],t,"size",0);
        lp_add(txs[..],"block=");lp_num(txs[..],nb);lp_add(txs[..],",input=");lp_num(txs[..],ni);lp_add(txs[..],",ni=");lp_num(txs[..],ic);
        lp_add(txs[..],",output=");lp_num(txs[..],no);lp_add(txs[..],",no=");lp_num(txs[..],oc);lp_add(txs[..],"},\n");
        for i:0..<ic {p:=jv_at(d[0],ii,i);lp_add(ins[..],"  LabDataInput.{");lp_field(ins[..],d[0],p,"txid",1);lp_field(ins[..],d[0],p,"vout",0);lp_field(ins[..],d[0],p,"coinbase",2);lp_add(ins[..],"},\n");ni+=1;}
        for i:0..<oc {
          p:=jv_at(d[0],oo,i);lp_add(outs[..],"  LabDataOutput.{");lp_field(outs[..],d[0],p,"value_sat",0);
          for key:[3]string.["script_hex","address","status"] {lp_field(outs[..],d[0],p,key,1);}
          spend:=jv_get(d[0],p,"spend");lp_add(outs[..],"spend=");lp_str(outs[..],jv_raw(d[0],jv_get(d[0],spend,"txid")));
          lp_add(outs[..],",spend_block=");lp_str(outs[..],jv_raw(d[0],jv_get(d[0],spend,"block")));
          lp_add(outs[..],",vin=");lp_num(outs[..],jv_int(d[0],jv_get(d[0],spend,"vin"),-1));lp_add(outs[..],"},\n");no+=1;
        }nt+=1;
      }nb+=1;
    }
  }
  lp_add(all[..],"// Generated by bitcoin/lab/project.coax from fully rebuilt Core regtest recordings.\n// Source blocks remain in bitcoin/fixtures/explorer-core-reorg; observation time unknown.\n");
  lp_add(all[..],"LabDataSnapshot :: struct {first:int;count:int;height:int;hash:string;}\nLabDataBlock :: struct {height:int;time:int;size:int;weight:int;active:bool;hash:string;previous:string;chainwork:string;tx:int;count:int;}\nLabDataTx :: struct {txid:string;order:int;weight:int;size:int;block:int;input:int;ni:int;output:int;no:int;}\nLabDataInput :: struct {txid:string;vout:int;coinbase:bool;}\nLabDataOutput :: struct {value_sat:int;script_hex:string;address:string;status:string;spend:string;spend_block:string;vin:int;}\n");
  lp_add(all[..],"LAB_SNAPSHOTS :: [3]LabDataSnapshot.[\n");lp_add(all[..],cast(string)meta[0].data[0..<meta[0].n]);lp_add(all[..],"];\n");
  for which:0..<4 {
    part:=ifx which==0 then blocks[..] else ifx which==1 then txs[..] else ifx which==2 then ins[..] else outs[..];
    lp_add(all[..],[4]string.["LAB_BLOCKS :: [","LAB_TXS :: [","LAB_INPUTS :: [","LAB_OUTPUTS :: ["][which]);lp_num(all[..],[4]int.[nb,nt,ni,no][which]);
    lp_add(all[..],[4]string.["]LabDataBlock.[\n","]LabDataTx.[\n","]LabDataInput.[\n","]LabDataOutput.[\n"][which]);lp_add(all[..],cast(string)part[0].data[0..<part[0].n]);lp_add(all[..],"];\n");
    if part[0].bad {return 1;}
  }
  if all[0].bad {return 1;}
  return ifx fs_write(args_at(a[..],1),cast(string)all[0].data[0..<all[0].n]) then 0 else 1;
}
