// Real HTTP pages through the actual shared producer; run natively/sanitized.
#import "Basic";
#load "../../apps/openagents-web/bitcoin-lab.coax";
#load "client.coax";
#load "../../coax/lib/sys/tool.coax";
sc_pump :: (s:[]BitcoinLab,port:int)->bool {
  r:=s[0].remote[..];reply:[LAB_REPLY_MAX]u8;
  for turn:0..<8 {any:=false;for slot:0..<2 {if r[0].effects[slot].wanted {any=true;n:=lf_get(port,cast(string)r[0].effects[slot].path[0..<r[0].effects[slot].n],reply[..]);if n<0 {return false;}lr_dispatched(r,slot,slot);lr_receive(r,slot,cast(string)reply[0..<n]);}}if !any {return r[0].model[0].ready;}}return false;
}
sc_frames :: (s:[]BitcoinLab,vertices:[]f32,u:[]f32,stats:[]int)->bool {
  for screen:0..<3 {for mode:0..<6 {r:=s[0].remote[..];r[0].table=mode>0;r[0].detail=ifx mode>0 then mode-1 else 0;r[0].table_page=0;
    for turn:0..<1000 {
      d:=[3]f32.[1,3,2][screen];n:=lab_frame(s,vertices,u,[3]f32.[320,390,1440][screen]*d,[3]f32.[568,844,900][screen]*d,d,0,true);stats[0]+=1;
      if n+s[0].mesh_n>stats[1] {stats[1]=n+s[0].mesh_n;}
      if n<=0 || !budget_ok(s[0].meter[0]) || s[0].mesh_n>4096 || !lab_scene_ready(s) {return false;}
      for node:s[0].nodes[0..<s[0].count] {if node.box.width<44 || node.box.height<44 || node.box.x<0 || node.box.x+node.box.width>s[0].w {return false;}}
      if mode==0 {break;}before:=r[0].table_page;lab_do(s,244);if before==r[0].table_page {break;}if turn==999 {return false;}
    }
  }}return true;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {return 2;}port:=lr_number(args_at(a[..],0),65535);s:[1]BitcoinLab;v:[LAB_VERTICES*12]f32;u:[LAB_UNIFORMS]f32;stats:[2]int;
  lab_start(s[..]);lab_do(s[..],222);if !sc_pump(s[..],port) || s[0].remote[0].model[0].identity.height!=105 {return 1;}r:=s[0].remote[..];
  if !sc_frames(s[..],v[..],u[..],stats[..]) {return 1;}
  tip:=r[0].model[0].identity.hash;lr_visit(r,3,cast(string)tip[..],0);if !sc_pump(s[..],port) || r[0].total!=72 || r[0].returned!=32 {return 1;}
  for page:0..<3 {
    if !sc_frames(s[..],v[..],u[..],stats[..]) {return 1;}
    if page<2 {lab_do(s[..],225);if !sc_pump(s[..],port) || r[0].offset!=(page+1)*32 {return 1;}}
  }
  lab_do(s[..],2007);if !sc_pump(s[..],port) || r[0].kind!=4 || r[0].total!=40 {return 1;}
  for page:0..<3 {
    if !sc_frames(s[..],v[..],u[..],stats[..]) {return 1;}
    if page<2 {lab_do(s[..],225);if !sc_pump(s[..],port) || r[0].offset!=(page+1)*16 {return 1;}}
  }
  lab_do(s[..],229);if !sc_pump(s[..],port) || r[0].kind!=5 || !sc_frames(s[..],v[..],u[..],stats[..]) {return 1;}
  lab_do(s[..],230);if !sc_pump(s[..],port) || r[0].kind!=6 || lr_int(r,0,"balance_sat")!=10000000000 || !sc_frames(s[..],v[..],u[..],stats[..]) {return 1;}
  print("PASS % real large-page graph/table/layout frames, peak % vertices, state % bytes / arena % bytes, bounded 24/32/16 pages and complete 40-link traversal\n",stats[0],stats[1],size_of(BitcoinLab),budget_arena_bytes(size_of(BitcoinLab),LAB_VERTICES,12,LAB_UNIFORMS));return 0;
}
