// Full-chain native explorer. Headers come from our P2P sync; raw Core
// block files are an import source, never a query/index backend.
#run_steps 250000000;
#load "explorer-http.coax";
#load "kvstream-file.coax";
#load "../../coax/lib/bitcoin/addrindex-private.coax";
#load "../../coax/lib/crypto/rand_foreign.coax";
#load "explorer-mempool.coax";
bf_unlock :: (handle: int) -> int #foreign;
NODE_CAP :: 600000;
NODE_BATCH :: 4096;
NativeExplorer :: struct {
  live: [] u8; api: [1] ExplorerServer; mempool: [1] MpNative;
  tree: [1] BlockTree; links: [NODE_CAP] BiLink; entries: [NODE_CAP] BiEntry;
  slots: [2097152] int; chain: [NODE_CAP] int; files: [NODE_CAP] TxiLoc; sizes: [NODE_CAP] int;
  path: [NODE_CAP] int; raw: [134217728] u8;
  batch: [67108864] u8; frame: [67108872] u8; scratch: [1048576] u8;
  blocks: [NODE_BATCH] LcBlock; locations: [NODE_BATCH] TxiLoc;
  used: int; seq: u64; mask: u64; segment: int; segment_limit: int; overflow: string; budget_ms: int;
  replay_started: bool; replay_seen: bool; replay_at: int; deadline: int; last_segment: int;
}
#test "native explorer resource numbers keep exact signed boundaries" {
  #assert node_number("") == -1 && node_number("-1") == -1 && node_number("1a") == -1;
  #assert node_number("0") == 0 && node_number("68719476736") == 68719476736;
  #assert node_number("9223372036854775807") == 9223372036854775807;
  #assert node_number("9223372036854775808") == -1 && node_number("00000000000000000000") == -1;
}
node_number :: (text: string) -> int {
  if text.count == 0 || text.count > 19 { return -1; } n := 0;
  for c: text { if c < '0' || c > '9' { return -1; } d := cast(int)(c-'0'); if n > (9223372036854775807-d)/10 { return -1; } n = n*10+d; } return n;
}
node_arena_capacity :: () -> int #export_c {
  a: [1] Args; if !args_load(a[..]) { return 0; }
  n := ifx args_count(a[..]) >= 8 then node_number(args_at(a[..],7)) else 137438953472;
  return ifx n >= KS_HEAD && n <= 137438953472 then n else 0;
}
node_segment_path :: (s: [] NativeExplorer, state: string, index: int, out: [] u8) -> string {
  if index == 0 { return state; }
  name: [4096] u8; alternate: [4096] u8; o: [1] Jo; jo_start(o[..],name[..]);
  jo_put(o[..],state); jo_put(o[..],".segment-"); jo_int(o[..],index); if o[0].bad { return ""; }
  selected := jo_text(o[..]);
  if s[0].overflow.count > 0 {
    other := fs_join(s[0].overflow,fs_base(selected),alternate[..]);
    here := fs_kind(selected); there := fs_kind(other);
    if (here != FS_NONE && here != FS_FILE) || (there != FS_NONE && there != FS_FILE) || (here == FS_FILE && there == FS_FILE) { return ""; }
    if there == FS_FILE || (here == FS_NONE && bf_free_bytes(s[0].overflow) > bf_free_bytes(fs_dir(state))) { selected = other; }
  }
  if selected.count > out.count { return ""; } for i: 0..<selected.count { out[i] = selected[i]; } return cast(string)out[0..<selected.count];
}
node_last_segment :: (s: [] NativeExplorer, state: string) -> int {
  names: [1] FsList; prefixbuf: [4096] u8; pathbuf: [4096] u8; o: [1] Jo;
  jo_start(o[..],prefixbuf[..]); jo_put(o[..],fs_base(state)); jo_put(o[..],".segment-"); if o[0].bad { return -1; }
  prefix := jo_text(o[..]); last := 0; count := 0;
  for dir: [2] string.[fs_dir(state),s[0].overflow] {
    if dir.count == 0 { continue; } n := fs_list(dir,names[..]); if n < 0 || names[0].full { return -1; }
    for i: 0..<n {
      name := fs_entry(names[..],i); if name.count < prefix.count || name[0..<prefix.count] != prefix { continue; }
      index := node_number(name[prefix.count..<name.count]); if index < 1 || fs_kind(fs_join(dir,name,pathbuf[..])) != FS_FILE { return -1; }
      count += 1; if index > last { last = index; }
    }
  }
  return ifx count == last then last else -1;
}
node_headers :: (s: [] NativeExplorer, path: string, p: ChainParams, now: int, archive: string) -> bool {
  n := fs_size(path); stamp := fs_mtime_ns(path);
  if n < 80 || n % 80 != 0 || n/80 > NODE_CAP { return false; }
  header: [80] u8; pending := 0;
  for i: 0..<n/80 {
    if bf_read_at(path,80*i,header[..]) != 80 { return false; }
    before := s[0].tree[0].count; h := bi_accept_header_vartime(s[0].tree[..],header[..],now);
    if h.code != BI_OK { print("header % refused %\n",i,h.code); return false; }
    if archive.count > 0 && s[0].tree[0].count > before {
      for k: 0..<80 { s[0].scratch[pending+k] = header[k]; } pending += 80;
      if pending+80 > s[0].scratch.count { if !bf_append_sync(archive,s[0].scratch[0..<pending]) { return false; } pending = 0; }
    }
  }
  if archive.count > 0 && pending > 0 && !bf_append_sync(archive,s[0].scratch[0..<pending]) { return false; }
  return fs_size(path) == n && fs_mtime_ns(path) == stamp;
}
node_catalog :: (s: [] NativeExplorer, store: string, p: ChainParams) -> bool {
  pathbuf: [4096] u8; keybuf: [4096] u8; key := fs_join(store,"xor.dat",keybuf[..]); mask: [8] u8;
  if fs_exists(key) { if bf_read_at(key,0,mask[..]) != 8 || fs_size(key) != 8 { return false; } s[0].mask = kv_get64(mask[..],0); }
  magicbytes := p.magic; magic := cb_load_le32(magicbytes[..],0).value; file := 0;
  for i: 0..<s[0].tree[0].count { s[0].sizes[i] = 0; }
  while true {
    path := api_block_path(store,file,pathbuf[..]); if !fs_exists(path) { break; }
    size := fs_size(path); at := 0; head: [88] u8;
    while at < size {
      n := ifx size-at < 88 then size-at else 88;
      if bf_read_at(path,at,head[0..<n]) != n { return false; }
      // Core preallocation is physical zeros, independent of its XOR key.
      if kv_zero_from(head[0..<n],0) {
        if !bf_zero_tail(path,at,size,s[0].scratch[..]) { return false; } break;
      }
      f := bf_next_vartime(head[0..<n],at,size,BF_BLOCK,magic,s[0].mask);
      if f.code != BF_OK { print("block file % position % refused %\n",file,at,f.code); return false; }
      for k: 0..<80 { head[8+k] = bf_byte(head[..],8+k,s[0].mask,at); }
      hash: [32] u8; #assert pow_block_hash_vartime(head[8..<88],hash[..]) == POW_OK;
      index := bi_find(s[0].tree[..],hash[..]);
      if index >= 0 && s[0].sizes[index] == 0 { s[0].files[index] = TxiLoc.{file=file,pos=at+8}; s[0].sizes[index] = f.n; }
      at += f.size;
    }
    file += 1;
  }
  return file > 0;
}
node_commit :: (s: [] NativeExplorer, path: string, result: LcResult) -> bool {
  if result.code != LC_OK || s[0].seq == 0xffffffffffffffff { return false; }
  if !kv_frame_size_ok(result.n) { return false; }
  pathbuf: [4096] u8; target := node_segment_path(s,path,s[0].segment,pathbuf[..]); if target.count == 0 { return false; } size := fs_size(target);
  if size > 20 && result.n+8 > s[0].segment_limit-size { s[0].segment += 1; target = node_segment_path(s,path,s[0].segment,pathbuf[..]); if target.count == 0 { return false; } size = fs_size(target); }
  if size <= 0 { header: [20] u8; #assert kv_header_vartime(0,header[..]) == 20; if !bf_append_sync(target,header[..]) { return false; } }
  for i: 0..<result.n { s[0].frame[8+i] = s[0].batch[i]; }
  kv_seal_vartime(s[0].frame[..],result.n,s[0].seq+1,0);
  if !bf_append_sync(target,s[0].frame[0..<8+result.n]) { return false; }
  s[0].used = result.used; s[0].seq += 1; return true;
}
node_init :: (s: [] NativeExplorer, path: string, p: ChainParams) -> int {
  if !s[0].replay_started {
    s[0].last_segment = node_last_segment(s,path); if s[0].last_segment < 0 { return 1; }
    seed: [16] u8; if cxrand_draw(seed[..],16) != 0 { return 1; }
    initial := ks_init(s[0].live,seed[..]); if initial != KS_HEAD { return 1; }
    s[0].used = initial; s[0].replay_started = true;
    if fs_size(path) == 0 {
      if s[0].last_segment != 0 { return 1; }
      small: [4096] u8; stage: [4096] u8; g := s[0].entries[0].hash;
      r := axi_init_vartime(p.chain,g[..],small[..],0,stage[..],s[0].batch[..]);
      if r.code != LC_OK { return 1; }
      used := kv_apply_vartime(s[0].live,initial,s[0].batch[0..<r.n],0); if used < 0 { return 1; }
      header: [20] u8; #assert kv_header_vartime(0,header[..]) == 20;
      if !bf_append_sync(path,header[..]) { return 1; } r.used = used;
      return ifx node_commit(s,path,r) then 0 else 1;
    }
  }
  while true {
    currentbuf: [4096] u8; currentpath := node_segment_path(s,path,s[0].segment,currentbuf[..]); if currentpath.count == 0 { return 1; }
    slice := kvs_open_file_slice(currentpath,s[0].live,s[0].used,s[0].frame[..],s[0].scratch[..],s[0].seq,s[0].replay_seen,s[0].replay_at,1); opened := slice.opened;
    if opened.code != KV_OK || opened.mask != 0 { print("state refused %\n",opened.code); return 1; }
    s[0].used = opened.used; s[0].seq = opened.seq; s[0].replay_at = opened.keep; s[0].replay_seen = s[0].replay_seen || opened.frames > 0;
    if s[0].seq % 256 == 0 { print("replayed segment % sequence % arena %\n",s[0].segment,s[0].seq,s[0].used); flushed := cxtool_out_flush(); }
    if slice.paused { if cxsock_now_ms() >= s[0].deadline { return 75; } continue; }
    nextbuf: [4096] u8; nextpath := node_segment_path(s,path,s[0].segment+1,nextbuf[..]); if nextpath.count == 0 { return 1; } has_next := fs_exists(nextpath);
    if opened.cut {
      if has_next || !fs_truncate(currentpath,opened.keep) { return 1; }
    }
    if !has_next { if s[0].segment != s[0].last_segment { return 1; } break; }
    short := fs_size(nextpath);
    if short >= 0 && short < KV_HEADER {
      afterbuf: [4096] u8; after := node_segment_path(s,path,s[0].segment+2,afterbuf[..]); prefix: [20] u8;
      if after.count == 0 || fs_exists(after) || bf_read_at(nextpath,0,prefix[0..<short]) != short || !kvs_header_prefix(prefix[0..<short],0) { return 1; }
      #assert kv_header_vartime(0,prefix[..]) == 20;
      if !fs_truncate(nextpath,0) || !bf_append_sync(nextpath,prefix[..]) { return 1; }
    }
    s[0].segment += 1; s[0].replay_at = 0;
    if cxsock_now_ms() >= s[0].deadline { return 75; }
  }
  if axi_context_vartime(s[0].live,s[0].used) != LC_OK { return 1; }
  tip := lc_tip_vartime(s[0].live,s[0].used); return ifx tip.chain == p.chain then 0 else 1;
}
node_import :: (s: [] NativeExplorer, state: string, store: string, deadline: int) -> int {
  best := s[0].tree[0].best_header; tip := lc_tip_vartime(s[0].live,s[0].used);
  current := bi_find(s[0].tree[..],tip.hash[..]); if current < 0 { return 1; }
  if current == best { return 0; }
  fork := bi_last_common_ancestor(s[0].links[..],current,best); count := s[0].links[best].height-s[0].links[fork].height; at := best;
  for i: 0..<count { s[0].path[count-1-i] = at; at = s[0].links[at].prev; }
  w := LcWork.{ins=s[0].api[0].ins[..],outs=s[0].api[0].outs[..],items=s[0].api[0].items[..],ids=s[0].api[0].ids[..],wids=s[0].api[0].wids[..],merkle=s[0].api[0].work[..],path=s[0].chain[..]};
  next := 0; reorg := current != fork;
  while next < count {
    n := 0; bytes := 0;
    while n < NODE_BATCH && next+n < count {
      index := s[0].path[next+n]; size := s[0].sizes[index];
      if size < 81 { print("missing block at height %\n",s[0].links[index].height); return 1; }
      // Keep frames comfortably below 64 MiB. Dense blocks stand alone.
      if !reorg && n > 0 && (n == 64 || bytes+size > 1048576) { break; }
      if size > s[0].raw.count-bytes { return 1; }
      loc := s[0].files[index]; buffer: [4096] u8; path := api_block_path(store,loc.file,buffer[..]);
      raw := s[0].raw[bytes..<bytes+size]; if bf_read_at(path,loc.pos,raw) != size { return 1; }
      for i: 0..<size { raw[i] = bf_byte(raw,i,s[0].mask,loc.pos); }
      s[0].blocks[n] = LcBlock.{index=index,bytes=raw}; s[0].locations[n] = loc; n += 1; bytes += size;
    }
    if reorg && n != count { return 1; }
    r := axi_private_reorg_vartime(s[0].tree[..],s[0].live,s[0].used,s[0].blocks[n-1].index,s[0].blocks[0..<n],s[0].locations[0..<n],s[0].batch[..],w);
    if !node_commit(s,state,r) { print("private preparation refused %; reopen required\n",r.code); return 1; }
    next += n; tip = lc_tip_vartime(s[0].live,s[0].used);
    print("committed height %/% arena % segment % sequence %\n",tip.height,s[0].links[best].height,s[0].used,s[0].segment,s[0].seq); flushed := cxtool_out_flush();
    if cxsock_now_ms() >= deadline && next < count { return 75; }
  }
  return 0;
}
// A listener-backed service retains its arena at a bounded checkpoint.
// The local controller resumes it by updating STATE.continue. Data routes
// remain unavailable until the preferred chain is completely imported.
node_wait_continue :: (s: [] NativeExplorer, state: string, store: string, listener: int, p: ChainParams, web: string, control: string, phase: string) {
  stamp := fs_mtime_ns(control);
  print("% paused sequence %; update %.continue to resume\n",phase,s[0].seq,state); flushed := cxtool_out_flush();
  while fs_mtime_ns(control) == stamp {
    h := cxsock_accept(listener,1000);
    if h >= 0 { api_connection(s[0].api[..],h,state,store,p,web); closed := cxsock_close(h); }
  }
  s[0].deadline = cxsock_now_ms()+s[0].budget_ms;
}
node_finish_replay :: (s: [] NativeExplorer, state: string, store: string, listener: int, p: ChainParams, web: string, control: string) -> int {
  result := node_init(s,state,p);
  while result == 75 && listener >= 0 {
    node_wait_continue(s,state,store,listener,p,web,control,"replay"); result = node_init(s,state,p);
  }
  return result;
}
node_finish_import :: (s: [] NativeExplorer, state: string, store: string, deadline: int, listener: int, p: ChainParams, web: string, control: string) -> int {
  result := node_import(s,state,store,deadline);
  while result == 75 && listener >= 0 {
    node_wait_continue(s,state,store,listener,p,web,control,"import");
    result = node_import(s,state,store,s[0].deadline);
  }
  return result;
}
node_main :: (s: [] NativeExplorer) -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) || (args_count(a[..]) < 7 || args_count(a[..]) > 11) { tool_errln("usage: explorer-node CHAIN STATE BLOCK_DIRECTORY HEADERS NOW PORT WEB_ROOT [ARENA_BYTES [OVERFLOW_DIRECTORY [SEGMENT_BYTES [BUDGET_MS]]]]"); return 2; }
  chain := 0; for i: 1..<6 { if args_at(a[..],0) == CHAIN_NAMES[i] { chain = i; } }
  now := node_number(args_at(a[..],4)); port := node_number(args_at(a[..],5));
  if chain == 0 || now < 0 || port < 0 || port > 65535 { return 2; }
  s[0].budget_ms = ifx args_count(a[..]) == 11 then node_number(args_at(a[..],10)) else 780000;
  if s[0].budget_ms < 1 || s[0].budget_ms > 780000 { return 2; }
  s[0].segment_limit = ifx args_count(a[..]) >= 10 then node_number(args_at(a[..],9)) else 1073741824;
  if s[0].segment_limit < 1024 || s[0].segment_limit > 1073741824 { return 2; }
  s[0].overflow = ifx args_count(a[..]) >= 9 then args_at(a[..],8) else "";
  if s[0].overflow.count > 0 && !fs_mkdir(s[0].overflow) { return 1; }
  overflowbuf: [4096] u8;
  if s[0].overflow.count > 0 { overflow_lock := bf_lock(fs_join(s[0].overflow,".explorer-lock",overflowbuf[..])); if overflow_lock < 0 { tool_errln("overflow directory requires exclusive ownership"); return 1; } }
  p := chain_params(chain); state := args_at(a[..],1); store := args_at(a[..],2); started := cxsock_now_ms(); deadline := started+s[0].budget_ms;
  s[0].deadline = deadline;
  lock := bf_lock(state); if lock < 0 { tool_errln("state requires exclusive ownership"); return 1; }
  archivebuf: [4096] u8; o: [1] Jo; jo_start(o[..],archivebuf[..]); jo_put(o[..],state); jo_put(o[..],".headers");
  archive := jo_text(o[..]); if o[0].bad { return 2; }
  controlbuf: [4096] u8; jo_start(o[..],controlbuf[..]); jo_put(o[..],state); jo_put(o[..],".continue");
  control := jo_text(o[..]); if o[0].bad { return 2; }
  if !bi_init(s[0].tree[..],p,s[0].links[..],s[0].entries[..],s[0].slots[..],s[0].chain[..]) { return 1; }
  if fs_exists(archive) && !node_headers(s,archive,p,now,"") { return 1; }
  source := args_at(a[..],3); source_stamp := fs_mtime_ns(source);
  if !node_headers(s,source,p,now,archive) || !node_catalog(s,store,p) { released := bf_unlock(lock); return 1; }
  api := s[0].api[..]; api[0].table = s[0].live; api[0].external = true; api[0].mask = s[0].mask;
  #assert ex_id(p.genesis.hash,api[0].genesis[..]);
  listener := ifx port > 0 then cxsock_listen(port) else -1; if port > 0 && listener < 0 { return 1; }
  result := node_finish_replay(s,state,store,listener,p,args_at(a[..],6),control);
  if result == 0 { result = node_finish_import(s,state,store,s[0].deadline,listener,p,args_at(a[..],6),control); }
  if result != 0 { released := bf_unlock(lock); return result; }
  api[0].used = s[0].used; api[0].tip = lc_tip_vartime(s[0].live,s[0].used); api[0].loaded = true;
  if port == 0 { released := bf_unlock(lock); return 0; }
  print("explorer-node ready height % on 127.0.0.1:% profile pow-only\n",api[0].tip.height,cxsock_port(listener)); flushed := cxtool_out_flush();
  stamp := source_stamp; checked := cxsock_now_ms();
  while true {
    h := cxsock_accept(listener,1000); if h >= 0 { mp_native_refresh(s[0].mempool[..],api,state); api_connection(api,h,state,store,p,args_at(a[..],6)); closed := cxsock_close(h); }
    elapsed := cxsock_now_ms()-checked;
    if elapsed >= 10000 && fs_mtime_ns(source) != stamp {
      api[0].loaded = false;
      if !node_headers(s,source,p,now+(cxsock_now_ms()-started)/1000,archive) || !node_catalog(s,store,p) { return 1; }
      result = node_finish_import(s,state,store,cxsock_now_ms()+s[0].budget_ms,listener,p,args_at(a[..],6),control); if result != 0 { return result; }
      api[0].used = s[0].used; api[0].tip = lc_tip_vartime(s[0].live,s[0].used); api[0].loaded = true;
      stamp = fs_mtime_ns(source); checked = cxsock_now_ms();
    }
  }
  return 0;
}
