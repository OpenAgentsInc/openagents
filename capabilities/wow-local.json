{
  "v": 1,
  "slug": "wow-local",
  "name": "WoW, a private shared realm",
  "summary": "Runs a bounded Voyager episode against a private vmangos 1.12.1 realm through a supervised headless helper.",
  "transport": "subprocess",
  "detect": {
    "binary": "wow-bridge",
    "version": [
      "wow-bridge",
      "--version"
    ]
  },
  "enforces": [
    "max_actions",
    "max_seconds",
    "world",
    "account",
    "character",
    "account_lease",
    "character_lease",
    "parallel"
  ],
  "cannot_enforce": [
    "tool_set",
    "budget_cents",
    "model",
    "effort"
  ],
  "sees_repository": false,
  "concurrent_max": 2,
  "cost": "local",
  "isolation": [
    "account",
    "character"
  ],
  "invoke": [
    "voyager",
    "run",
    "--world"
  ],
  "refuses": [
    {
      "name": "missing_prerequisites",
      "match": "build-wow-bridge.sh",
      "explanation": "Build the pinned helper and provide a private credential file and reachable realm."
    }
  ]
}
