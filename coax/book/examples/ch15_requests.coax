#import "Basic";
#load "lib/ch15_request_policy.coax";

main :: () {
    first := request_begin(Request.{}, 10, 20);
    second := request_begin(request_cancel(first), 11, 30);
    stale := request_complete(second, first.epoch, 12, true, 99);
    print("old completion: epoch %, phase %\n", stale.epoch, cast(int) stale.phase);
    done := request_complete(stale, second.epoch, 13, true, 42);
    print("current completion: epoch %, result %\n", done.epoch, done.value);
    late := request_complete(request_begin(done, 20, 30), 3, 30, true, 7);
    print("deadline: expired %\n", late.phase == RequestPhase.expired);
}
