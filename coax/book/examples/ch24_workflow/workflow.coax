#import_proto "../../../../proto/descriptors/ios-home.pb" as Book;
#load "../lib/ch15_request_policy.coax";

// Representation only: decoded bytes grant no permission to invoke a HUD action.
// Request policy keeps its own #authority scope in the same source graph.

// Decoder checks run in the evaluator. Writer overlap checks require native memory.
#test "read independent protobuf bytes" {
    expected := [33] u8.[8,1,18,4,98,111,111,107,26,7,112,114,101,118,105,101,119,34,12,98,111,111,107,45,114,101,113,117,101,115,116,40,7];
    r := workflow_read(expected[..]);
    #assert r.error == 0 && r.revision == 7;
    bad := [2] u8.[255,255];
    #assert workflow_read(bad[..]).error != 0;
}
#test "a revision remains uint64, without a narrowing cast" {
    wide := [42] u8.[8,1,18,4,98,111,111,107,26,7,112,114,101,118,105,101,119,34,12,98,111,111,107,45,114,101,113,117,101,115,116,40,255,255,255,255,255,255,255,255,255,1];
    r := workflow_read(wide[..]);
    #assert r.error == 0 && r.revision == 18446744073709551615;
}

WorkflowRead :: struct { revision: u64; error: u32; }

workflow_packet :: (epoch: u32, out: [] u8) -> int #export_c {
    a: [128] u8; b: [128] u8;
    p := Book_HudInvocation_new();
    p = Book_HudInvocation_set_schema(p, 1, a[..]);
    p = Book_HudInvocation_set_world(p, "book", b[..]);
    p = Book_HudInvocation_set_action_id(p, "preview", a[..]);
    p = Book_HudInvocation_set_request_id(p, "book-request", b[..]);
    p = Book_HudInvocation_set_revision(p, cast(u64) epoch, a[..]);
    encoded := Book_HudInvocation_encode(p, out);
    if encoded.error != 0 { return -1; }
    return encoded.wire.count;
}

workflow_read :: (wire: [] u8) -> WorkflowRead #export_c {
    p := Book_HudInvocation_decode(wire);
    r := Book_HudInvocation_get_revision(p);
    return WorkflowRead.{revision = r.value, error = r.error};
}
