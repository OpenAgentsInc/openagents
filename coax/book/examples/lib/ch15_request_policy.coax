// Chapter 15: one bounded request, with no scheduler or host effects.
#authority;

RequestPhase :: enum u8 { idle; running; succeeded; failed; cancelled; expired; }
Request :: struct { epoch: u32; phase: RequestPhase; deadline: u64; value: int; }

// Write the observable traces first. A cancelled callback must never win a retry.
#test "cancel, retry, old completion, current completion" {
    first := request_begin(Request.{}, 10, 20);
    #assert first.epoch == 1 && first.phase == RequestPhase.running;
    #assert first.deadline == 20 && first.value == 0;
    cancelled := request_cancel(first);
    #assert cancelled.phase == RequestPhase.cancelled;
    #assert cancelled.epoch == 1 && cancelled.deadline == 20 && cancelled.value == 0;
    second := request_begin(cancelled, 11, 30);
    #assert second.epoch == 2 && second.deadline == 30;
    stale := request_complete(second, first.epoch, 12, true, 99);
    #assert stale.phase == RequestPhase.running && stale.value == 0;
    #assert stale.epoch == 2 && stale.deadline == 30;
    done := request_complete(stale, second.epoch, 13, true, 42);
    #assert done.phase == RequestPhase.succeeded && done.value == 42;
    #assert done.epoch == 2 && done.deadline == 30;
}

#forall "launch admission and terminal restart" phase: 0..<6, now: 9..<12, deadline: 9..<12 {
    s := Request.{epoch = 7, phase = cast(RequestPhase) phase, deadline = 99, value = 17};
    r := request_begin(s, cast(u64) now, cast(u64) deadline);
    if phase == 1 || deadline <= now {
        #assert r.epoch == 7 && cast(int) r.phase == phase && r.deadline == 99 && r.value == 17;
    } else {
        #assert r.epoch == 8 && r.phase == RequestPhase.running;
        #assert r.deadline == cast(u64) deadline && r.value == 0;
    }
}

#forall "an exhausted identity is refused without wrapping" phase: 0..<6 {
    s := Request.{epoch = 4294967295, phase = cast(RequestPhase) phase, deadline = 90, value = 4};
    r := request_begin(s, 1, 2);
    #assert r.epoch == 4294967295 && cast(int) r.phase == phase && r.deadline == 90 && r.value == 4;
}

#forall "cancellation changes only an active phase" phase: 0..<6 {
    s := Request.{epoch = 9, phase = cast(RequestPhase) phase, deadline = 20, value = 0};
    r := request_cancel(s);
    #assert r.epoch == 9 && r.deadline == 20 && r.value == 0;
    if phase == 1 { #assert r.phase == RequestPhase.cancelled; }
    else { #assert cast(int) r.phase == phase; }
}

#forall "completion identity, deadline and outcome" phase: 0..<6, epoch: 6..<9, now: 19..<22, ok: 0..<2 {
    s := Request.{epoch = 7, phase = cast(RequestPhase) phase, deadline = 20, value = 0};
    r := request_complete(s, cast(u32) epoch, cast(u64) now, ok == 1, -42);
    #assert r.epoch == 7 && r.deadline == 20;
    if phase != 1 || epoch != 7 {
        #assert cast(int) r.phase == phase && r.value == 0;
    } else if now >= 20 {
        #assert r.phase == RequestPhase.expired && r.value == 0;
    } else if ok == 1 {
        #assert r.phase == RequestPhase.succeeded && r.value == -42;
    } else {
        #assert r.phase == RequestPhase.failed && r.value == 0;
    }
}

#forall "a timer expires only a running request, at the deadline" phase: 0..<6, now: 19..<22 {
    s := Request.{epoch = 7, phase = cast(RequestPhase) phase, deadline = 20, value = 0};
    r := request_tick(s, cast(u64) now);
    #assert r.epoch == 7 && r.deadline == 20 && r.value == 0;
    if phase == 1 && now >= 20 { #assert r.phase == RequestPhase.expired; }
    else { #assert cast(int) r.phase == phase; }
}

#test "terminal results survive duplicate completion, cancellation and timer" {
    active := request_begin(Request.{}, 0, 10);
    done := request_complete(active, active.epoch, 1, true, 42);
    duplicate := request_complete(done, active.epoch, 2, false, 9);
    cancelled := request_cancel(duplicate);
    late := request_tick(cancelled, 100);
    #assert late.phase == RequestPhase.succeeded && late.value == 42;
    #assert late.epoch == 1 && late.deadline == 10;
}

request_begin :: (s: Request, now: u64, deadline: u64) -> Request #export_c {
    if s.phase == RequestPhase.running || deadline <= now || s.epoch == 4294967295 { return s; }
    return Request.{epoch = s.epoch + 1, phase = RequestPhase.running, deadline = deadline};
}
request_cancel :: (s: Request) -> Request #export_c {
    r := s;
    if r.phase == RequestPhase.running { r.phase = RequestPhase.cancelled; }
    return r;
}
request_tick :: (s: Request, now: u64) -> Request #export_c {
    r := s;
    if r.phase == RequestPhase.running && now >= r.deadline { r.phase = RequestPhase.expired; }
    return r;
}
request_complete :: (s: Request, epoch: u32, now: u64, ok: bool, value: int) -> Request #export_c {
    if s.phase != RequestPhase.running || epoch != s.epoch { return s; }
    r := request_tick(s, now);
    if r.phase != RequestPhase.running { return r; }
    if ok { r.phase = RequestPhase.succeeded; r.value = value; }
    else { r.phase = RequestPhase.failed; }
    return r;
}
