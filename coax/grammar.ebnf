(* Coax 0.17.0 accepted subset. Planned language syntax is not in this grammar.
   Lexing: ASCII identifiers (excluding reserved keywords); integer tokens in
   decimal/hex/binary with separators, up to the u64 maximum; decimal float
   tokens with a fraction and/or exponent ("1.5", "2e-3"; never "1." so that
   "0..<n" stays a range) and an optional f32/f64 suffix ("1.5f32" is typed); character literals 'a' and '\n' (integer tokens);
   escaped byte strings; whitespace, line comments and nested block comments.
   A unary minus is a separate token. *)

file = { module | export | load | import | proto-import | procedure | constant | struct | enum | assertion | check | authority } ;
module = "#module", string, ";" ;
(* At most one claim per unit: a lowercase dotted logical module ID. *)
export = "#export", identifier, { ",", identifier }, ";" ;
(* Names the module's own declarations; a module with any list keeps the
   rest private. Valid only in a unit that belongs to a logical module. *)
load = "#load", string, [ "as", identifier ], ";" ;
(* The aliased form names a .coax path whose unit claims a #module; types,
   procedures, constants and enums are then written alias.Name. *)
(* Source loads form a bounded acyclic graph; each canonical source loads once.
   Paths and descriptor imports resolve relative to their declaring source. *)
import = "#import", string, ";" ;
proto-import = "#import_proto", string, "as", identifier, ";" ;
(* Proto imports generate ordinary declarations; see proto.md for supported
   descriptors, naming, budgets, borrowed lifetimes and strict wire policy. *)
procedure = identifier, "::", "(", [ parameters ], ")",
            [ "->", type ], ( [ "#export_c" ], block | "#foreign", ";" ) ;
parameters = parameter, { ",", parameter }, [ "," ] ;
parameter = identifier, ":", type ;
constant = identifier, "::", expression, ";" ;
struct = identifier, "::", "struct", field-block ;
field-block = "{", { field | profile-fields }, "}" ;
profile-fields = "#if", "BUILD_DEBUG", field-block, [ "else", field-block ] ;
field = identifier, ":", type, [ "=", expression ], ";" ;
enum = identifier, "::", "enum", type, "{", { member }, "}" ;
member = identifier, [ "=", expression ], ";" ;
assertion = "#assert", expression, ";" ;
authority = "#authority", ";" ;
check = "#test", string, block
      | "#forall", [ string ], binding, { ",", binding }, block ;
binding = identifier, ":", ( type | expression, "..<", expression ) ;

type = identifier | reserved-type-name
     | type-parameter                    (* $T: generic procedures only, spec 7.2 *)
     | "[", expression, "]", type        (* fixed array; length known while checking *)
     | "[", "]", type ;                   (* view *)
type-parameter = "$", identifier ;       (* one token: no space after '$' *)

block = "{", { statement }, "}" ;
statement = block | declaration | assignment, ";" | return | if | while | for |
            "break", ";" | "continue", ";" | defer | assertion | profile-statements | expression, ";" ;
profile-statements = "#if", "BUILD_DEBUG", block, [ "else", block ] ;
(* BUILD_DEBUG is a fixed workspace selector: true unless --release. Both
   branches parse; only selected AST participates in semantics/emission.
   This is not arbitrary constant-expression or top-level conditional compilation. *)
declaration = identifier, ":=", expression, ";" |
              identifier, ":", type, [ "=", ( expression | "---" ) ], ";" ;
assignment = place, ( "=" | "+=" | "-=" | "*=" | "/=" | "%=" |
                      "&=" | "|=" | "^=" | "<<=" | ">>=" ), expression ;
place = expression ;  (* an identifier, field or element; checked *)
return = "return", [ expression ], ";" ;
if = "if", expression, block, [ "else", ( if | block ) ] ;
while = "while", expression, block ;
for = "for", identifier, ":", expression, "..<", expression, block
    | "for", identifier, [ ",", identifier ], ":", expression, block ;
defer = "defer", ( block | ( assignment | expression ), ";" ) ;

expression = disjunction ;
disjunction = conjunction, { "||", conjunction } ;
conjunction = comparison, { "&&", comparison } ;
(* Comparisons do not chain, including mixed equality/ordering. *)
comparison = sum, [ ( "==" | "!=" | "<" | "<=" | ">" | ">=" ), sum ] ;
sum = product, { ( "+" | "-" | "|" | "^" ), product } ;
product = unary, { ( "*" | "/" | "%" | "&" | "<<" | ">>" ), unary } ;
unary = ( "-" | "!" | "#run" ), unary
      | "cast", [ ",", "trunc" ], "(", type, ")", unary
      | postfix ;
postfix = primary, { ".", identifier
                   | ".", "{", [ field-init, { ",", field-init }, [ "," ] ], "}"
                   | "[", expression, "]"
                   | "[", expression, "..<", expression, "]"
                   | "[", "..", "]" } ;
field-init = identifier, "=", expression ;
primary = integer | float | character | string | "true" | "false" |
          identifier, [ "(", [ arguments ], ")" ] |
          "size_of", "(", type, ")" |
          "type_info", "(", type, ")" |
          ( "field_info" | "enum_info" ), "(", type, ",", expression, ")" |
          "ifx", expression, "then", expression, "else", expression |
          "[", expression, "]", type, ".", "[", [ arguments ], "]" |
          "(", expression, ")" ;
arguments = expression, { ",", expression }, [ "," ] ;

(* Semantics also require: unique names with no shadowing; immutable
   parameters, constants and loop variables; untyped literals that fit the
   type their use requires; one namespace for procedures, constants, structs
   and enums; no struct containing itself by value; correctly typed calls,
   returns, fields and elements; a void zero-argument main unless the file is
   built as a library; no unused expression results; literal checked print
   formats; deferred code that does not leave its block; left-to-right
   evaluation; and bounded compile-time execution. print is provided by
   Basic; type_name is an unevaluated but typechecked intrinsic. A call
   named after a number type converts (int(x) is cast(int) x); sin, cos,
   tan, exp, log, sqrt, floor, abs, pow, len, byte_at, bytes_overlap,
   f32_bits, f64_bits, f32_from_bits and f64_from_bits are intrinsics.
   #foreign procedures pass integers, floats and bool. coax metal accepts
   only f32/bool values, no loops, strings or foreign calls, and acyclic
   calls. A #forall binding is bool, an enum, an integer of at most 16 bits
   or an int range with constant bounds. In an #authority file every
   procedure except main and #foreign ones is reached from a check.
   A $T type parameter is bound by its first use among a procedure's
   parameter types and means that one type everywhere else in the
   procedure; only $T and [] $T are accepted, never in struct fields or
   outside a procedure, and a generic procedure is not yet callable. *)
