// Computer-local Claude Code effects: fixed commands, isolated profiles and
// read-only quota probes. State/decisions stay in Coax; OS effects use proc/fs.
#load "wire.coax";
#load "../../sys/proc.coax";
#load "../../sys/fs.coax";
#load "../../sys/openagents-paths.coax";
#load "../../crypto/sha256-kernel.coax";
#load "../../net/http.coax";
cxproc_self_path :: (out:[]u8)->int #foreign #effects(all);
cxsecret_read_service :: (service:[]u8,account:[]u8,out:[]u8)->int #foreign #effects(all);
PA_USAGE_URL :: "https://api.anthropic.com/api/oauth/usage";
PaProbe :: struct {h:int= -1;kind:int;last:int;deadline:int;backoff:int;authenticated:bool;raw:[16384]u8;n:int;http:int;}
PaFlow :: struct {h:int= -1;view:PaLogin;profile:int= -1;raw:[16384]u8;n:int;}
PaNative :: struct {store:[1]PaStore;accounts:[8]PaAccount;probes:[8]PaProbe;flows:[4]PaFlow;next:int;}
#test "status parsing never includes raw provider credentials in an observation" {
 a:[1]PaAccount;#assert pa_status("{\"loggedIn\":true,\"authMethod\":\"claude.ai\",\"email\":\"alice@example.com\",\"subscriptionType\":\"max\",\"access_token\":\"NEVER-RETURN\"}",a[..]);
 #assert cast(string)a[0].email[0..<a[0].ne]=="alice@example.com" && cast(string)a[0].plan[0..<a[0].np]=="max";
 #assert !pa_status("{\"loggedIn\":false,\"authMethod\":\"none\"}",a[..]);
 #assert !pa_status("{\"loggedIn\":true,\"authMethod\":\"api_key\"}",a[..]);
}
pa_status :: (raw:string,a:[]PaAccount)->bool #effects(all) {
 nodes:[128]JvNode;d:[1]Jv;if !jv_parse(d[..],raw,nodes[..]) {return false;}j:=d[0];a[0].ne=pa_string(j,0,"email",a[0].email[..]);if a[0].ne<0 {a[0].ne=0;}a[0].np=pa_string(j,0,"subscriptionType",a[0].plan[..]);if a[0].np<0 {a[0].np=0;}
 return jv_bool(j,jv_get(j,0,"loggedIn")) && jv_raw(j,jv_get(j,0,"authMethod"))=="claude.ai";
}
pa_account_error :: (a:[]PaAccount,code:string) {a[0].ner=pa_copy(a[0].error[..],code);a[0].stale=true;}
pa_state :: (a:[]PaAccount,state:string) {a[0].ns=pa_copy(a[0].state[..],state);}
pa_flow_state :: (f:[]PaFlow,state:string) {f[0].view.ns=pa_copy(f[0].view.state[..],state);}
pa_running :: (f:[]PaFlow)->bool {s:=cast(string)f[0].view.state[0..<f[0].view.ns];return s=="starting" || s=="awaiting_code" || s=="verifying";}
pa_system_dir :: (out:[]u8)->string #effects(all) {home:[1200]u8;override:[1200]u8;custom:=proc_getenv("CLAUDE_CONFIG_DIR",override[..]);if custom.count>0 {return fs_realpath(custom,out);}return fs_join(proc_getenv("HOME",home[..]),".claude",out);}
pa_directory :: (root:string,id:string,out:[]u8)->string #effects(all) {if id=="system" {return pa_system_dir(out);}if !ea_id(id,32) {return "";}b:[1400]u8;return fs_join(fs_join(root,"claude-profiles",b[..]),id,out);}
pa_program :: (out:[]u8)->string #effects(all) {home:[1200]u8;candidate:=fs_join(proc_getenv("HOME",home[..]),".local/bin/claude",out);return ifx fs_kind(candidate)==FS_FILE then candidate else "claude";}
pa_cli_start :: (directory:string,system:bool,login:bool)->int #effects(all) {
 exe:[1400]u8;h:=proc_new();if h<0 {return -1;}
 good:=proc_arg(h,pa_program(exe[..])) && proc_arg(h,"auth") && proc_arg(h,ifx login then "login" else "status");if !login {good=good && proc_arg(h,"--json");}
 good=good && proc_env(h,"BROWSER=/usr/bin/true") && proc_env(h,"NO_OPEN_BROWSER=1") && proc_env(h,"CI=1");
 for key:[4]string.["ANTHROPIC_API_KEY","ANTHROPIC_AUTH_TOKEN","CLAUDE_CODE_OAUTH_TOKEN","CLAUDECODE"] {good=good && proc_unset(h,key);}
 if !system {b:[1536]u8;n:=pa_copy(b[..],"CLAUDE_CONFIG_DIR=");for c:directory {if n>=b.count {good=false;break;}b[n]=c;n+=1;}good=good && proc_env(h,cast(string)b[0..<n]);}
 good=good && proc_err_to_out(h);if !good || proc_start(h)!=0 {_ = proc_release(h);return -1;}return h;
}
pa_credentials :: (directory:string,system:bool,out:[]u8)->int #effects(all) {
 // Keychain denial is not absence: never fall back to a stale file on denial.
 service:[256]u8;n:=pa_copy(service[..],"Claude Code-credentials");custom:[1200]u8;override:=proc_getenv("CLAUDE_CONFIG_DIR",custom[..]);
 if !system || override.count>0 {digest:[64]u8;if !S_hex(S_hash(ifx system then override else directory),digest[..]) {return -1;}service[n]='-';n+=1;for i:0..<8 {service[n]=digest[i];n+=1;}}
 raw:[16384]u8;defer {for i:0..<raw.count {raw[i]=0;}}user:[256]u8;username:=proc_username(user[..]);size:=cxsecret_read_service(service[0..<n],user[0..<username.count],raw[..]);
 if size==0 || size== -2 {path:[1536]u8;size=fs_read(fs_join(directory,".credentials.json",path[..]),raw[..]);}
 if size<1 {return -1;}return pa_token(cast(string)raw[0..<size],out);
}
pa_http_start :: (directory:string,system:bool)->int #effects(all) {
 // Isolate the shared synchronous HTTP client in an owned child, so a quota
 // outage cannot stall the computer's chat/event loop. No token in argv.
 exe:[4096]u8;n:=cxproc_self_path(exe[..]);if n<1 || n>exe.count {return -1;}h:=proc_new();if h<0 {return -1;}
 good:=proc_arg(h,cast(string)exe[0..<n]) && proc_arg(h,"accounts-probe") && proc_arg(h,"--directory") && proc_arg(h,directory);if system {good=good && proc_arg(h,"--system");}
 if !good || proc_start(h)!=0 {_ = proc_release(h);return -1;}return h;
}
pa_probe_command :: (directory:string,system:bool,out:[]u8)->int #effects(all) {
 a:[1]PaAccount;token:[4096]u8;header:[8192]u8;work:[1]HttpWork;body:[16384]u8;
 defer {for i:0..<token.count {token[i]=0;}for i:0..<header.count {header[i]=0;}for i:0..<work[0].req.count {work[0].req[i]=0;}}
 n:=pa_credentials(directory,system,token[..]);if n<1 {pa_account_error(a[..],"credentials_unavailable");return pa_probe_write(0,a[..],out);}
 at:=pa_copy(header[..],"Authorization: Bearer ");for c:token[0..<n] {header[at]=c;at+=1;}
 headers:=[2]string.[cast(string)header[0..<at],"anthropic-beta: oauth-2025-04-20"];
 r:=http_do(work[..],"GET",PA_USAGE_URL,headers[..],"",10000,0,body[..]);
 if r.error==HTTP_OK && r.code==200 && pa_usage(cast(string)body[0..<r.n],a[..]) {a[0].stale=false;}
 else {pa_account_error(a[..],ifx r.code==429 then "rate_limited" else ifx r.code==401 || r.code==403 then "login_required" else "usage_unavailable");}
 return pa_probe_write(r.code,a[..],out);
}
pa_probe_start :: (p:[]PaProbe,a:[]PaAccount,directory:string,system:bool,now:int) {
 if p[0].h>=0 {return;}p[0].last=now;p[0].n=0;p[0].http=0;p[0].kind=1;p[0].deadline=now+15000;p[0].h=pa_cli_start(directory,system,false);
 if p[0].h<0 {pa_state(a,"unavailable");pa_account_error(a,"cli_unavailable");return;}pa_state(a,"checking");a[0].stale=true;
}
pa_probe_tick :: (p:[]PaProbe,a:[]PaAccount,directory:string,system:bool,now:int) {
 if p[0].h<0 {return;}line:[16384]u8;
 for count:0..<32 {n:=proc_line(p[0].h,0,line[..]);if n==PROC_TIMEOUT || n==PROC_EOF {break;}if n<0 || p[0].n+n+1>p[0].raw.count {p[0].deadline=0;break;}
  text:=cast(string)line[0..<n];
  for c:text {p[0].raw[p[0].n]=c;p[0].n+=1;}p[0].raw[p[0].n]=10;p[0].n+=1;
 }
 status:=proc_wait(p[0].h,0);if status==PROC_RUNNING && now<p[0].deadline {return;}_ = proc_release(p[0].h);p[0].h= -1;
 if p[0].kind==1 {
  p[0].authenticated=status==0 && pa_status(cast(string)p[0].raw[0..<p[0].n],a);
  if !p[0].authenticated {pa_state(a,ifx status==PROC_RUNNING then "unavailable" else "login_required");pa_account_error(a,ifx status==PROC_RUNNING then "probe_timeout" else "login_required");return;}
  p[0].h=pa_http_start(directory,system);p[0].kind=2;p[0].deadline=now+15000;p[0].n=0;
  if p[0].h<0 {pa_state(a,"connected");pa_account_error(a,"usage_unavailable");}return;
 }
 pa_state(a,"connected");next:[1]PaAccount;code:=[1]int.[0];ok:=status==0 && pa_probe_read(cast(string)p[0].raw[0..<p[0].n],next[..],code[..]);
 if ok && code[0]==200 && next[0].nw>0 && next[0].ner==0 {a[0].windows=next[0].windows;a[0].nw=next[0].nw;a[0].observed=now;a[0].stale=false;a[0].ner=0;}
 else {pa_account_error(a,ifx ok && next[0].ner>0 then cast(string)next[0].error[0..<next[0].ner] else "usage_unavailable");if code[0]==401 || code[0]==403 {p[0].authenticated=false;pa_state(a,"login_required");}if code[0]==429 {p[0].backoff=now+300000;}}
 for i:0..<p[0].raw.count {p[0].raw[i]=0;}p[0].n=0;
}
pa_flow_tick :: (f:[]PaFlow,now:int) {
 if f[0].h<0 || !pa_running(f) {return;}
 if now>=f[0].view.expires {_ = proc_release(f[0].h);f[0].h= -1;pa_flow_state(f,"expired");return;}
 line:[16384]u8;for count:0..<32 {n:=proc_line(f[0].h,0,line[..]);if n==PROC_TIMEOUT || n==PROC_EOF {break;}if n<0 {pa_flow_state(f,"failed");break;}
  // Only an exact Claude authorize URL leaves this process. Prompts/other
  // stdout and stderr are discarded rather than becoming app diagnostics.
  for i:0..<n {if i+8>n || cast(string)line[i..<i+8]!="https://" {continue;}end:=i;while end<n && line[end]>32 && line[end]<127 {end+=1;}url:=cast(string)line[i..<end];if pa_authorize(url) {f[0].view.nu=pa_copy(f[0].view.url[..],url);pa_flow_state(f,"awaiting_code");break;}}
 }
 status:=proc_wait(f[0].h,0);if status!=PROC_RUNNING || !pa_running(f) {_ = proc_release(f[0].h);f[0].h= -1;pa_flow_state(f,ifx status==0 then "completed" else "failed");f[0].view.nu=0;}
}
