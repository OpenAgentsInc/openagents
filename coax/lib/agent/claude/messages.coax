// ---- inbound control frames (the subtypes the CLI sends the SDK)

// Every subtype the crate's ControlRequestData models, inbound or outbound.
CL_CONTROL_SUBTYPES :: [42] string.["initialize", "interrupt", "can_use_tool", "set_permission_mode",
  "set_model", "set_max_thinking_tokens", "rename_session", "set_color", "mcp_status",
  "get_context_usage", "get_session_cost", "list_models", "get_usage", "get_binary_version",
  "mcp_call", "file_suggestions", "hook_callback", "mcp_message", "rewind_files",
  "cancel_async_message", "read_file", "seed_read_state", "mcp_set_servers", "register_repo_root",
  "reload_plugins", "reload_skills", "reload_output_styles", "mcp_reconnect", "mcp_toggle",
  "stop_task", "background_tasks", "get_task_output", "apply_flag_settings", "get_settings",
  "get_hooks_listing", "update_settings", "elicitation", "request_user_dialog",
  "list_permission_rules", "mcp_read_resource", "oauth_token_refresh", "host_auth_token_refresh"];

cl_control_known :: (subtype: string) -> bool {
  if subtype.count == 0 { return false; }
  for s: CL_CONTROL_SUBTYPES { if s == subtype { return true; } }
  return false;
}

// The request fields a control request of this subtype requires (under "request").
cl_control_spec :: (subtype: string) -> string {
  if subtype == "can_use_tool" { return "s:request.tool_name x:request.input s:request.tool_use_id ?a:request.permission_suggestions ?s:request.blocked_path ?s:request.decision_reason ?s:request.decision_reason_type ?b:request.classifier_approvable ?b:request.suppress_always_allow_rule ?b:request.default_to_no ?s:request.title ?s:request.display_name ?s:request.agent_id ?s:request.description ?b:request.requires_user_interaction"; }
  if subtype == "hook_callback" { return "s:request.callback_id x:request.input ?s:request.tool_use_id"; }
  if subtype == "mcp_message" { return "s:request.server_name x:request.message"; }
  if subtype == "elicitation" { return "s:request.mcp_server_name s:request.message ?s:request.mode ?s:request.url ?s:request.elicitation_id ?s:request.title ?s:request.display_name ?s:request.description"; }
  if subtype == "request_user_dialog" { return "s:request.dialog_kind x:request.payload ?s:request.tool_use_id"; }
  if subtype == "set_permission_mode" { return "s:request.mode=default|acceptEdits|bypassPermissions|plan|dontAsk|auto"; }
  if subtype == "set_model" { return "?s:request.model"; }
  if subtype == "rename_session" { return "s:request.title"; }
  if subtype == "set_color" { return "s:request.color"; }
  if subtype == "mcp_call" { return "s:request.tool"; }
  if subtype == "file_suggestions" { return "s:request.query"; }
  if subtype == "rewind_files" { return "s:request.user_message_id ?b:request.dry_run"; }
  if subtype == "cancel_async_message" { return "s:request.message_uuid"; }
  if subtype == "read_file" { return "s:request.path"; }
  if subtype == "seed_read_state" { return "s:request.path f:request.mtime"; }
  if subtype == "mcp_set_servers" { return "x:request.servers"; }
  if subtype == "register_repo_root" { return "s:request.directory"; }
  if subtype == "mcp_reconnect" { return "s:request.serverName"; }
  if subtype == "mcp_toggle" { return "s:request.serverName b:request.enabled"; }
  if subtype == "stop_task" || subtype == "get_task_output" { return "s:request.task_id"; }
  if subtype == "apply_flag_settings" { return "x:request.settings"; }
  if subtype == "update_settings" { return "s:request.source x:request.settings"; }
  if subtype == "mcp_read_resource" { return "s:request.serverName s:request.uri"; }
  return "";
}
