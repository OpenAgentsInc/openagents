}

ClApiRetry :: struct {
  attempt: int; max_retries: int; retry_delay_ms: int; error_status: ClOptInt;
  error: ClAssistantError; has_no_response: bool; waited_ms: int; retry_wait_ms: int;
}
cl_api_retry_of :: (m: ClMessage) -> ClApiRetry {
  r: ClApiRetry; l := m.line;
  r.attempt = cl_int(l, "attempt").value; r.max_retries = cl_int(l, "max_retries").value;
  r.retry_delay_ms = cl_int(l, "retry_delay_ms").value; r.error_status = cl_opt_int(l, "error_status");
  r.error = cl_assistant_error(l, cl_at(l, "error"));
  r.has_no_response = cl_at(l, "no_response").tok == JSON_OBJECT;
  r.waited_ms = cl_int(l, "no_response.waited_ms").value; r.retry_wait_ms = cl_int(l, "no_response.retry_wait_ms").value;
  return r;
}

