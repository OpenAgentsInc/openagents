// One entry of background_tasks_changed's tasks.
ClBackgroundTask :: struct {
  found: bool; task_id: string; run_id: string; task_type: string; subagent_type: string;
  description: string; parent_task_id: string; ambient: ClOptBool;
}
ClBackgroundTasks :: struct { tasks: string; count: int; }
cl_background_tasks_of :: (m: ClMessage) -> ClBackgroundTasks {
  t := cl_raw(m.line, "tasks");
  return ClBackgroundTasks.{tasks = t, count = cl_count(t)};
}
cl_background_task :: (ar: [] ClArena, tasks: string, index: int) -> ClBackgroundTask {
  b: ClBackgroundTask;
  v := cl_item(tasks, index);
  if !v.ok || v.tok != JSON_OBJECT { return b; }
  e := tasks[v.from..<v.to];
  b.found = true; b.task_id = cl_str(ar, e, "task_id"); b.run_id = cl_str(ar, e, "run_id");
  b.task_type = cl_str(ar, e, "task_type"); b.subagent_type = cl_str(ar, e, "subagent_type");
  b.description = cl_str(ar, e, "description"); b.parent_task_id = cl_str(ar, e, "parent_task_id");
  b.ambient = cl_opt_bool(e, "ambient");
  return b;
}

