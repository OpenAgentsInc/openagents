// task_started, task_updated, task_progress and task_notification.
ClTask :: struct {
  task_id: string; run_id: string; tool_use_id: string; description: string; subagent_type: string;
  task_type: string; workflow_name: string; prompt: string; skip_transcript: ClOptBool;
  is_backgrounded: ClOptBool; spawn_depth: ClOptInt; parent_task_id: string; ambient: ClOptBool;
  status: string; output_file: string; summary: string; reason: string; resource_links: string;
  usage: ClTaskUsage; last_tool_name: string;
  patch: string;   // task_updated's patch, JSON
}
cl_task_of :: (ar: [] ClArena, m: ClMessage) -> ClTask {
  t: ClTask; l := m.line;
  t.task_id = cl_str(ar, l, "task_id"); t.run_id = cl_str(ar, l, "run_id"); t.tool_use_id = cl_str(ar, l, "tool_use_id");
  t.description = cl_str(ar, l, "description"); t.subagent_type = cl_str(ar, l, "subagent_type");
  t.task_type = cl_str(ar, l, "task_type"); t.workflow_name = cl_str(ar, l, "workflow_name"); t.prompt = cl_str(ar, l, "prompt");
  t.skip_transcript = cl_opt_bool(l, "skip_transcript"); t.is_backgrounded = cl_opt_bool(l, "is_backgrounded");
  t.spawn_depth = cl_opt_int(l, "spawn_depth"); t.parent_task_id = cl_str(ar, l, "parent_task_id");
  t.ambient = cl_opt_bool(l, "ambient"); t.status = cl_str(ar, l, "status"); t.output_file = cl_str(ar, l, "output_file");
  t.summary = cl_str(ar, l, "summary"); t.reason = cl_str(ar, l, "reason"); t.resource_links = cl_raw(l, "resource_links");
  t.usage = cl_task_usage(l); t.last_tool_name = cl_str(ar, l, "last_tool_name"); t.patch = cl_raw(l, "patch");
  return t;
}

