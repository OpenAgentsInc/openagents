FX_HOOK_RESPONSE :: "{\"type\":\"system\",\"subtype\":\"hook_response\",\"hook_id\":\"h1\",\"hook_name\":\"PreToolUse\",\"hook_event\":\"PreToolUse\",\"output\":\"ok\",\"stdout\":\"ok\",\"stderr\":\"\",\"exit_code\":0,\"outcome\":\"success\",\"uuid\":\"u\",\"session_id\":\"s\"}";
