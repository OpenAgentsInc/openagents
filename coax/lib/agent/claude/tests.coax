  #assert r.callback_id == "cb-pre-1" && r.tool_use_id == "tu-1" && r.hook_event_name == "PreToolUse";
}

#test "hook started and response" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  s := cl_classify(ar[..], FX_HOOK_STARTED);
  #assert s.system == ClSystem.hook_started && cl_hook_event_of(ar[..], s).hook_id == "h1";
  r := cl_classify(ar[..], FX_HOOK_RESPONSE);
  h := cl_hook_event_of(ar[..], r);
  #assert r.system == ClSystem.hook_response && h.hook_id == "h1" && h.outcome == "success" && h.exit_code.value == 0;
}

#test "0.3.289 system subtypes parse to typed values" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  p := cl_classify(ar[..], FX_CRP);
  c := cl_control_request_progress_of(ar[..], p);
  #assert p.system == ClSystem.control_request_progress && c.request_id == "sdk-1" && c.attempt.has && c.attempt.value == 2;
  f := cl_classify(ar[..], FX_REFUSAL);
  #assert f.system == ClSystem.model_refusal_no_fallback && cl_model_refusal_no_fallback_of(ar[..], f).original_model == "opus";
  b := cl_classify(ar[..], FX_BG);
  tasks := cl_background_tasks_of(b);
  #assert b.system == ClSystem.background_tasks_changed && cl_background_task(ar[..], tasks.tasks, 0).task_id == "t1";
  w := cl_classify(ar[..], FX_SHUTDOWN);
  #assert w.system == ClSystem.worker_shutting_down && cl_worker_shutting_down_of(ar[..], w).reason == "deploy";
  i := cl_classify(ar[..], FX_INFO);
  info := cl_informational_of(ar[..], i);
  #assert i.system == ClSystem.informational && info.level == "warning" && info.prevent_continuation.has && info.prevent_continuation.value;
}

#test "0.3.289 top-level types parse to typed values" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  g := cl_classify(ar[..], FX_GOAL);
  goal := cl_active_goal_of(ar[..], g);
  #assert g.kind == ClKind.active_goal && goal.has_value && goal.condition == "tests pass" && goal.iterations == 3;
  c := cl_classify(ar[..], FX_GOAL_CLEARED);
  #assert c.kind == ClKind.active_goal && !cl_active_goal_of(ar[..], c).has_value;
  r := cl_classify(ar[..], FX_RESET);
  #assert r.kind == ClKind.conversation_reset && cl_type_name(r) == "conversation_reset";
  #assert cl_str(ar[..], r.line, "type") == "conversation_reset" && cl_conversation_reset_of(ar[..], r).new_conversation_id == "c2";
}

#test "0.3.289 result fields and new terminal reasons" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  m := cl_classify(ar[..], FX_R289);
  r := cl_result_of(ar[..], m);
  #assert m.result == ClResultKind.success && r.terminal_reason == ClTerminal.budget_exhausted;
  #assert r.queued_turn_count.has && r.queued_turn_count.value == 0 && r.user_message_uuid == "um-1";
  u := cl_model_usage(ar[..], r.model_usage, "claude-haiku");
  #assert u.canonical_model == "claude-haiku-4-5" && u.cost_basis == "list" && u.provider == "firstParty";
}

#test "0.3.289 assistant error values" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  m := cl_classify(ar[..], FX_ASSISTANT_ERROR);
  a := cl_assistant_of(ar[..], m);
  #assert m.kind == ClKind.assistant && a.error == ClAssistantError.cloud_credential_error && a.timestamp == "2026-10-04T00:00:00Z";
}

#test "inbound control frames at 0.3.289" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  e := cl_classify(ar[..], FX_ELICIT);
  er := cl_request_of(ar[..], e);
  #assert e.frame == ClFrame.control_request && e.subtype == "elicitation" && er.mode == "url" && er.elicitation_id == "e1";
  d := cl_classify(ar[..], FX_DIALOG);
  #assert d.frame == ClFrame.control_request && d.subtype == "request_user_dialog";
  c := cl_classify(ar[..], FX_CANCEL);
  #assert c.frame == ClFrame.control_cancel && cl_str(ar[..], c.line, "request_id") == "r1";
  f := cl_classify(ar[..], FX_BRAND_NEW);
  #assert f.frame == ClFrame.unsupported_control && f.subtype == "brand_new" && cl_str(ar[..], f.line, "request_id") == "r3";
  #assert cl_int(f.line, "request.x").value == 1;
  p := cl_classify(ar[..], FX_PERMISSION_289);
  pr := cl_request_of(ar[..], p);
  #assert p.frame == ClFrame.control_request && pr.decision_reason_type == "classifier" && pr.display_name == "Search docs";
}

#test "a control response carries pending requests" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  m := cl_classify(ar[..], FX_CARRIED);
  #assert m.frame == ClFrame.control_response;
  r := cl_response_of(ar[..], m);
  #assert r.ok && r.sdk_number == 3 && r.response == "{}";
  #assert cl_str(ar[..], cl_json(r.pending_permission_requests, cl_item(r.pending_permission_requests, 0)), "request_id") == "p1";
}

#test "0.3.292 subagent messages carry agent_id" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  a := cl_assistant_of(ar[..], cl_classify(ar[..], FX_SUB_ASSISTANT));
  #assert a.agent_id == "task-7" && a.subagent_type == "Explore" && a.task_description == "Find the config";
  u := cl_classify(ar[..], FX_SUB_USER);
  #assert u.kind == ClKind.user && cl_user_of(ar[..], u).agent_id == "task-7" && u.parent_tool_use_id == "tu-1";
}

#test "inbound user messages parse typed and keep their frame" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  m := cl_classify(ar[..], FX_USER_WIRE);
  u := cl_user_of(ar[..], m);
  #assert m.kind == ClKind.user && u.is_synthetic.value && u.is_replay.value && u.has_uuid && m.uuid == "u1";
  #assert cl_raw(u.tool_use_result, "stdout") == "\"ok\"" && m.line == FX_USER_WIRE;
}

#test "0.3.292 task events carry run and parent ids" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  s := cl_classify(ar[..], FX_TASK_STARTED);
  t := cl_task_of(ar[..], s);
  #assert s.system == ClSystem.task_started && t.run_id == "r-01" && t.parent_task_id == "t1" && t.spawn_depth.value == 2;
  u := cl_classify(ar[..], FX_TASK_UPDATED);
  #assert u.system == ClSystem.task_updated && cl_task_of(ar[..], u).run_id == "r-01";
  p := cl_classify(ar[..], FX_TASK_PROGRESS);
  #assert p.system == ClSystem.task_progress && cl_task_of(ar[..], p).run_id == "r-01" && cl_task_of(ar[..], p).usage.duration_ms == 5;
  n := cl_classify(ar[..], FX_TASK_NOTE);
  #assert n.system == ClSystem.task_notification && cl_task_of(ar[..], n).run_id == "r-01";
  b := cl_classify(ar[..], FX_BG2);
  task := cl_background_task(ar[..], cl_background_tasks_of(b).tasks, 0);
  #assert task.run_id == "r-01" && task.subagent_type == "general-purpose" && task.parent_task_id == "t1";
}

#test "0.3.295 rate limit overage fields" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  r := cl_rate_limit_of(ar[..], cl_classify(ar[..], FX_OVERAGE));
  #assert r.status == "allowed_warning" && r.overage_enabled.value && r.overage_status == "allowed";
  #assert r.overage_resets_at.value == 1760000000 && r.overage_disabled_reason == "out_of_credits";
}

#test "0.3.295 text block citations survive" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  a := cl_assistant_of(ar[..], cl_classify(ar[..], FX_CITED));
  content := cl_raw(a.message, "content");
  first := cl_json(content, cl_item(content, 0));
  cites := cl_raw(first, "citations");
  #assert cl_json(cites, cl_item(cites, 0)) == FX_CITATION;
  d := cl_classify(ar[..], FX_CITED_DELTA);
  #assert d.kind == ClKind.stream_event && cl_raw(cl_stream_event_of(ar[..], d).event, "delta.citation") == FX_CITATION;
}

#test "0.3.296 startup failure reasons stay typed" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  a := cl_classify(ar[..], FX_STARTUP0);
  #assert a.result == ClResultKind.error_during_execution && cl_result_of(ar[..], a).startup_failure_reason == "org_config_required_unavailable";
  b := cl_classify(ar[..], FX_STARTUP1);
  #assert b.result == ClResultKind.error_during_execution && cl_result_of(ar[..], b).startup_failure_reason == "org_config_refused";
}

#test "a known type missing a required field, or with a value it doesn't allow, stays raw" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  m := cl_classify(ar[..], FX_ASSISTANT_NO_UUID);
  #assert m.frame == ClFrame.message && m.kind == ClKind.unknown && m.type_name == "assistant";
  #assert cl_classify(ar[..], FX_INIT_NO_SKILLS).kind == ClKind.unknown;
  #assert cl_classify(ar[..], FX_USER_BAD_PRIORITY).kind == ClKind.unknown;
  #assert cl_classify(ar[..], "{\"type\":\"control_request\",\"request_id\":\"x\",\"request\":{\"subtype\":\"can_use_tool\"}}").kind == ClKind.unknown;
}

#test "escaped strings decode into the arena" {
  buf: [4096] u8; ar: [1] ClArena; ar[0].buf = buf[..];
  m := cl_classify(ar[..], FX_ESCAPED);
  s := cl_prompt_suggestion_of(ar[..], m).suggestion;
  #assert s.count == 16 && s[0..<14] == "say \"hi\"\nthen " && s[14] == 0xC3 && s[15] == 0xA9 && ar[0].at == 16;
}
