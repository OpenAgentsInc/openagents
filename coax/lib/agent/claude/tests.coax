FX_BG :: "{\"type\":\"system\",\"subtype\":\"background_tasks_changed\",\"uuid\":\"u\",\"session_id\":\"s\",\"tasks\":[{\"task_id\":\"t1\",\"task_type\":\"local_bash\",\"description\":\"build\",\"ambient\":false}]}";
