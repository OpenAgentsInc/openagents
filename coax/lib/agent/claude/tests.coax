FX_INFO :: "{\"type\":\"system\",\"subtype\":\"informational\",\"uuid\":\"u\",\"session_id\":\"s\",\"content\":\"heads up\",\"level\":\"warning\",\"prevent_continuation\":true}";
FX_GOAL :: "{\"type\":\"active_goal\",\"value\":{\"condition\":\"tests pass\",\"iterations\":3,\"set_at\":1700000000000,\"tokens_at_start\":100},\"uuid\":\"u\",\"session_id\":\"s\"}";
FX_GOAL_CLEARED :: "{\"type\":\"active_goal\",\"value\":null,\"uuid\":\"u\",\"session_id\":\"s\"}";
FX_RESET :: "{\"type\":\"conversation_reset\",\"new_conversation_id\":\"c2\",\"trigger\":\"clear\",\"uuid\":\"u\",\"session_id\":\"s\"}";
FX_R289 :: "{\"type\":\"result\",\"subtype\":\"success\",\"duration_ms\":10,\"duration_api_ms\":8,\"is_error\":false,\"num_turns\":1,\"result\":\"ok\",\"total_cost_usd\":0.001,\"usage\":{\"input_tokens\":1,\"output_tokens\":1},\"modelUsage\":{\"claude-haiku\":{\"inputTokens\":1,\"outputTokens\":1,\"cacheReadInputTokens\":0,\"cacheCreationInputTokens\":0,\"webSearchRequests\":0,\"costUSD\":0.001,\"contextWindow\":200000,\"maxOutputTokens\":64000,\"thinkingTokens\":0,\"canonicalModel\":\"claude-haiku-4-5\",\"provider\":\"firstParty\",\"costBasis\":\"list\"}},\"permission_denials\":[],\"structured_output\":null,\"terminal_reason\":\"budget_exhausted\",\"queued_turn_count\":0,\"result_index\":0,\"user_message_uuid\":\"um-1\",\"uuid\":\"u\",\"session_id\":\"s\"}";
FX_ASSISTANT_ERROR :: "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[]},\"parent_tool_use_id\":null,\"error\":\"cloud_credential_error\",\"timestamp\":\"2026-10-04T00:00:00Z\",\"uuid\":\"u\",\"session_id\":\"s\"}";
FX_ELICIT :: "{\"type\":\"control_request\",\"request_id\":\"r1\",\"request\":{\"subtype\":\"elicitation\",\"mcp_server_name\":\"docs\",\"message\":\"Pick\",\"mode\":\"url\",\"url\":\"https://example.com\",\"elicitation_id\":\"e1\"}}";
FX_DIALOG :: "{\"type\":\"control_request\",\"request_id\":\"r2\",\"request\":{\"subtype\":\"request_user_dialog\",\"dialog_kind\":\"confirm\",\"payload\":{\"text\":\"ok?\"},\"tool_use_id\":\"tu\"}}";
FX_CANCEL :: "{\"type\":\"control_cancel_request\",\"request_id\":\"r1\"}";
FX_BRAND_NEW :: "{\"type\":\"control_request\",\"request_id\":\"r3\",\"request\":{\"subtype\":\"brand_new\",\"x\":1}}";
FX_PERMISSION_289 :: "{\"type\":\"control_request\",\"request_id\":\"r4\",\"request\":{\"subtype\":\"can_use_tool\",\"tool_name\":\"mcp__docs__search\",\"input\":{},\"tool_use_id\":\"tu\",\"decision_reason_type\":\"classifier\",\"classifier_approvable\":true,\"mcp_server\":{\"name\":\"docs\"},\"display_name\":\"Search docs\"}}";
FX_CARRIED :: "{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"sdk-3\",\"response\":{},\"pending_permission_requests\":[{\"type\":\"control_request\",\"request_id\":\"p1\",\"request\":{\"subtype\":\"can_use_tool\",\"tool_name\":\"Bash\",\"input\":{},\"tool_use_id\":\"tu\"}}]}}";
FX_SUB_ASSISTANT :: "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[]},\"parent_tool_use_id\":\"tu-1\",\"agent_id\":\"task-7\",\"subagent_type\":\"Explore\",\"task_description\":\"Find the config\",\"uuid\":\"a1\",\"session_id\":\"s\"}";
FX_SUB_USER :: "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"hi\"},\"parent_tool_use_id\":\"tu-1\",\"agent_id\":\"task-7\",\"session_id\":\"s\"}";
FX_USER_WIRE :: "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"tu\",\"content\":\"ok\"}]},\"parent_tool_use_id\":null,\"isSynthetic\":true,\"isReplay\":true,\"tool_use_result\":{\"stdout\":\"ok\"},\"uuid\":\"u1\",\"session_id\":\"s\"}";
FX_TASK_STARTED :: "{\"type\":\"system\",\"subtype\":\"task_started\",\"uuid\":\"u\",\"session_id\":\"s\",\"task_id\":\"t2\",\"run_id\":\"r-01\",\"description\":\"d\",\"parent_task_id\":\"t1\",\"spawn_depth\":2}";
FX_TASK_UPDATED :: "{\"type\":\"system\",\"subtype\":\"task_updated\",\"uuid\":\"u\",\"session_id\":\"s\",\"task_id\":\"t2\",\"run_id\":\"r-01\",\"patch\":{\"status\":\"running\"}}";
FX_TASK_PROGRESS :: "{\"type\":\"system\",\"subtype\":\"task_progress\",\"uuid\":\"u\",\"session_id\":\"s\",\"task_id\":\"t2\",\"run_id\":\"r-01\",\"description\":\"d\",\"usage\":{\"total_tokens\":1,\"tool_uses\":0,\"duration_ms\":5}}";
FX_TASK_NOTE :: "{\"type\":\"system\",\"subtype\":\"task_notification\",\"uuid\":\"u\",\"session_id\":\"s\",\"task_id\":\"t2\",\"run_id\":\"r-01\",\"status\":\"completed\",\"output_file\":\"/o\",\"summary\":\"done\"}";
FX_BG2 :: "{\"type\":\"system\",\"subtype\":\"background_tasks_changed\",\"uuid\":\"u\",\"session_id\":\"s\",\"tasks\":[{\"task_id\":\"t2\",\"run_id\":\"r-01\",\"task_type\":\"local_agent\",\"subagent_type\":\"general-purpose\",\"description\":\"d\",\"parent_task_id\":\"t1\"}]}";
FX_OVERAGE :: "{\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"allowed_warning\",\"overageStatus\":\"allowed\",\"overageResetsAt\":1760000000,\"overageDisabledReason\":\"out_of_credits\",\"overageEnabled\":true},\"uuid\":\"u\",\"session_id\":\"s\"}";
FX_CITATION :: "{\"type\":\"web_search_result_location\",\"url\":\"https://x\",\"title\":\"X\",\"cited_text\":\"c\",\"encrypted_index\":\"e\"}";
FX_CITED :: "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"cited\",\"citations\":[{\"type\":\"web_search_result_location\",\"url\":\"https://x\",\"title\":\"X\",\"cited_text\":\"c\",\"encrypted_index\":\"e\"}]}]},\"parent_tool_use_id\":null,\"uuid\":\"a\",\"session_id\":\"s\"}";
