  #assert jo_text(o[..]) == "{\"waiting\":[],\"browsers\":[]}";
}

#test "cli json: the whole-output readers take what the writers wrote and refuse what they did not" {
  ab: [2048] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]}; b: [512] u8;
  s := cj_read_session(ar[..], cj_session(b[..], "x", "codex", "running", 2, 3, 7, "/w", "a \"task\""));
  #assert s.ok && s.id == "x" && s.engine == "codex" && s.state == "running" && s.turns == 2 && s.steps == 3 && s.started_us == 7 && s.cwd == "/w" && s.task == "a \"task\"" && s.cut == -1;
  #assert !cj_read_session(ar[..], "{\"id\":\"x\",\"engine\":\"codex\",\"state\":\"running\",\"turns\":2,\"steps\":3,\"started_us\":7,\"cwd\":\"/w\",\"task\":\"t\"}").ok;
  #assert !cj_read_session(ar[..], "{\"id\":\"x\",\"engine\":\"codex\",\"state\":\"finished\",\"turns\":\"2\",\"steps\":3,\"started_us\":7,\"cwd\":\"/w\",\"task\":\"t\"}").ok;
  #assert cj_read_session(ar[..], "{\"id\":\"x\",\"engine\":\"codex\",\"state\":\"finished\",\"turns\":2,\"steps\":3,\"started_us\":7,\"cwd\":\"/w\",\"task\":\"t\",\"cut\":18}").cut == 18;
  #assert cj_read_stop(CJ_STOP_NOT_RUNNING) == CJ_STOP_NOT_RUNNING && cj_read_stop(CJ_STOP_STOPPED) == CJ_STOP_STOPPED && cj_read_stop(CJ_STOP_KILLED) == CJ_STOP_KILLED;
  #assert cj_read_stop("{\"stopped\":false}") == "" && cj_read_stop("{}") == "" && cj_read_stop("{\"stopped\":true,\"killed\":false}") == "";
  #assert cj_read_import(ar[..], "{\"id\":\"a\",\"turns\":1}").n == 1 && !cj_read_import(ar[..], "{\"id\":\"a\",\"pid\":1}").ok && cj_read_detached(ar[..], "{\"id\":\"a\",\"pid\":9}").n == 9;
  q := cj_read_queued(ar[..], "{\"job\":\"j\",\"state\":\"held\",\"dest\":\"box\"}");
  #assert q.ok && q.held && q.dest == "box" && cj_read_queued(ar[..], "{\"job\":\"j\",\"state\":\"queued\"}").ok && !cj_read_queued(ar[..], "{\"job\":\"j\",\"state\":\"queued\",\"dest\":\"box\"}").ok && !cj_read_queued(ar[..], "{\"job\":\"j\",\"state\":\"done\"}").ok;
  j := cj_read_job(ar[..], "{\"id\":\"j1\",\"task\":\"t\",\"engine\":\"echo\",\"cwd\":\"/w\",\"credentials\":\"gh\",\"at\":5,\"refused\":\"no\",\"handled\":9}");
  #assert j.ok && j.handled && j.refused == "no" && j.session == "" && j.credentials == "gh" && j.handled_us == 9;
  #assert !cj_read_job(ar[..], "{\"id\":\"j1\",\"task\":\"t\",\"engine\":\"echo\",\"cwd\":\"/w\",\"at\":5,\"handled\":9}").ok;
  p := cj_read_plugin(ar[..], "{\"name\":\"fmt\",\"state\":\"active\",\"signed\":false,\"commands\":[],\"defines\":[\"format\"],\"provides\":[\"format\"],\"uses\":[]}");
  #assert p.ok && p.name == "fmt" && cj_items("{\"defines\":[\"format\"]}", "defines") == 1 && cj_plugin_item_at(ar[..], "{\"defines\":[\"format\"]}", "defines", 0) == "format";
  #assert !cj_read_plugin(ar[..], "{\"name\":\"fmt\",\"state\":\"failed\",\"signed\":false,\"commands\":[],\"defines\":[],\"provides\":[],\"uses\":[]}").ok;
  #assert !cj_read_plugin(ar[..], "{\"name\":\"fmt\",\"state\":\"active\",\"signed\":false,\"commands\":[],\"defines\":[],\"provides\":[]}").ok;
  u := cj_read_usage_agent(ar[..], "{\"agent\":\"codex\",\"plan\":\"\",\"windows\":[{\"label\":\"Week\",\"used_percent\":4,\"resets_at\":9}],\"error\":\"why\"}");
  w := cj_read_usage_window(ar[..], "{\"agent\":\"codex\",\"plan\":\"\",\"windows\":[{\"label\":\"Week\",\"used_percent\":4,\"resets_at\":9}]}", 0);
  #assert u.ok && u.windows == 1 && u.error == "why" && w.ok && w.label == "Week" && w.used_percent == 4 && w.resets_at == 9;
  #assert !cj_read_usage_agent(ar[..], "{\"agent\":\"codex\",\"plan\":\"\"}").ok;
  h := cj_read_host_browser(ar[..], "{\"grant\":\"cc\",\"key\":\"dd\",\"label\":\"Mine\",\"expires_at\":9}");
  #assert h.ok && h.id == "cc" && h.at == 9 && !cj_read_host_waiting(ar[..], "{\"grant\":\"cc\",\"key\":\"dd\",\"label\":\"Mine\",\"expires_at\":9}").ok;
}

#test "cli json: decide, policy, router, consent, memory" {
  b: [2048] u8; ab: [2048] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  #assert cj_text(b[..], cj_decided(b[..], 0, "yes", 962)) == "{\"choice\":\"yes\",\"probability\":0.962}";
  #assert cj_text(b[..], cj_decided(b[..], 0, "no", 1000)) == "{\"choice\":\"no\",\"probability\":1.000}";
  #assert cj_text(b[..], cj_decided(b[..], 0, "a", 7)) == "{\"choice\":\"a\",\"probability\":0.007}" && cj_text(b[..], cj_decided(b[..], 0, "a", 40)) == "{\"choice\":\"a\",\"probability\":0.040}";
  #assert cj_text(b[..], cj_decide_error(b[..], 0, "needs a question")) == "{\"error\":\"needs a question\"}";
  d := cj_read_decide(ar[..], "{\"choice\":\"yes\",\"probability\":0.962}");
  #assert d.ok && d.decided && d.choice == "yes" && d.thousandths == 962 && cj_read_decide(ar[..], "{\"choice\":\"no\",\"probability\":1.000}").thousandths == 1000;
  #assert !cj_read_decide(ar[..], "{\"choice\":\"yes\",\"probability\":0.96}").ok && !cj_read_decide(ar[..], "{\"choice\":\"yes\"}").ok && !cj_read_decide(ar[..], "{}").ok;
  e := cj_read_decide(ar[..], "{\"error\":\"needs a question\"}");
  #assert e.ok && !e.decided && e.error == "needs a question" && cj_decide_why(ar[..], "{\"error\":\"needs a question\"}") == "needs a question" && cj_decide_why(ar[..], "{\"choice\":\"yes\",\"probability\":0.962}") == "";
  eb: [512] u8; mb: [512] u8; jb: [128] u8;
  entry := cj_policy_entry(eb[..], "candidate", "kim,,lee", "echo", "agent", "issue", true, true, "work on requests");
  #assert entry == "{\"mode\":\"candidate\",\"authors\":[\"kim\",\"lee\"],\"engine\":\"echo\",\"label\":\"agent\",\"channel\":\"issue\",\"deliver\":true,\"ci\":true,\"policy\":\"work on requests\"}";
  plain := cj_policy_entry(mb[..], "ignore", "*", "", "", "", false, false, "");
  #assert plain == "{\"mode\":\"ignore\",\"authors\":[\"*\"]}";
  n := cj_policy_entry_mail(b[..], plain, "kim@example.com", true);
  #assert cj_text(b[..], n) == "{\"mode\":\"ignore\",\"authors\":[\"*\"],\"to\":\"kim@example.com\",\"send\":true}";
  pr := cj_read_policy(ar[..], cj_text(b[..], n), jb[..]);
  #assert pr.ok && pr.mode == "ignore" && pr.authors == "*" && pr.to == "kim@example.com" && pr.send && !pr.deliver && !pr.ci && pr.engine == "";
  pe := cj_read_policy(ar[..], entry, jb[..]);
  #assert pe.ok && pe.authors == "kim,lee" && pe.deliver && pe.ci && pe.policy == "work on requests" && pe.channel == "issue" && pe.label == "agent";
  #assert !cj_read_policy(ar[..], "{\"mode\":\"ignore\"}", jb[..]).ok && !cj_read_policy(ar[..], "{\"mode\":\"ignore\",\"authors\":[\"*\"],\"deliver\":false}", jb[..]).ok;
  n = json_raw(b[..], 0, CJ_SOURCES_OPEN); n = cj_sources_member(b[..], n, true, "local", plain); n = cj_sources_member(b[..], n, false, "team", entry); n = json_raw(b[..], n, CJ_SOURCES_CLOSE);
  #assert cj_text(b[..], n) == "{\"sources\":{\n  \"local\":{\"mode\":\"ignore\",\"authors\":[\"*\"]},\n  \"team\":{\"mode\":\"candidate\",\"authors\":[\"kim\",\"lee\"],\"engine\":\"echo\",\"label\":\"agent\",\"channel\":\"issue\",\"deliver\":true,\"ci\":true,\"policy\":\"work on requests\"}}}\n";
  n = cj_router_trigger(b[..], 0, "t1", "local", "ci", "addressed to the agent: new worker", "s1", "", 5);
  #assert cj_text(b[..], n) == "{\"kind\":\"trigger\",\"id\":\"t1\",\"source\":\"local\",\"thread\":\"ci\",\"fate\":\"addressed to the agent: new worker\",\"session\":\"s1\",\"at_us\":5}\n";
  #assert cj_router_id(ar[..], cast(string) b[0..<n - 1]) == "t1" && cj_router_session(ar[..], cast(string) b[0..<n - 1]) == "s1";
  t := cj_read_router_line(ar[..], cast(string) b[0..<n - 1]);
  #assert t.ok && t.kind == "trigger" && t.fate == "addressed to the agent: new worker" && t.session == "s1" && t.note == "" && t.at_us == 5;
  n = cj_router_trigger(b[..], 0, "t2", "team", "", "dropped: no decision", "", "why", 6);
  #assert cj_text(b[..], n) == "{\"kind\":\"trigger\",\"id\":\"t2\",\"source\":\"team\",\"thread\":\"\",\"fate\":\"dropped: no decision\",\"note\":\"why\",\"at_us\":6}\n";
  #assert cj_router_session(ar[..], cast(string) b[0..<n - 1]) == "";
  long: [2100] u8; for i: 0..<long.count { long[i] = 'x'; }
  big: [4096] u8;
  #assert cj_router_trigger(big[..], 0, "t", "s", "h", "f", "", cast(string) long[..], 1) == 85 + CJ_ROUTER_NOTE;
  n = cj_router_batch(b[..], 0, 8, 12, false, 7);
  #assert cj_text(b[..], n) == "{\"kind\":\"batch\",\"events\":8,\"ms\":12,\"decided\":false,\"at_us\":7}\n" && cj_read_router_line(ar[..], cast(string) b[0..<n - 1]).events == 8;
  n = cj_router_recall(b[..], 0, "t1", 1, 2, 438);
  #assert cj_text(b[..], n) == "{\"kind\":\"recall\",\"id\":\"t1\",\"sessions\":1,\"hops\":2,\"bytes\":438}\n" && cj_read_router_line(ar[..], cast(string) b[0..<n - 1]).hops == 2;
  #assert !cj_read_router_line(ar[..], "{\"kind\":\"other\"}").ok && !cj_read_router_line(ar[..], "{\"kind\":\"batch\",\"events\":8}").ok;
  n = cj_consent_open(b[..], 0, 3); n = cj_consent_grant(b[..], n, true, 0, "microcoder", "user", "revoked", 0, 0); n = cj_consent_grant(b[..], n, false, 1, "system-one", "session,project", "active", 2, 74); n = cj_consent_close(b[..], n);
  #assert cj_text(b[..], n) == "{\"events\":3,\"grants\":[{\"grant\":0,\"engine\":\"microcoder\",\"classes\":\"user\",\"state\":\"revoked\",\"sends\":0,\"bytes\":0},{\"grant\":1,\"engine\":\"system-one\",\"classes\":\"session,project\",\"state\":\"active\",\"sends\":2,\"bytes\":74}]}";
  g := cj_read_consent_grant(ar[..], cj_item(cj_text(b[..], n), "grants", 1));
  #assert g.ok && g.grant == 1 && g.engine == "system-one" && g.classes == "session,project" && g.sends == 2 && g.bytes == 74;
  #assert !cj_read_consent_grant(ar[..], "{\"grant\":0,\"engine\":\"x\",\"classes\":\"user\",\"state\":\"paused\",\"sends\":0,\"bytes\":0}").ok;
  n = cj_remembered(b[..], 0, "build", "user", 2, "conflict");
  #assert cj_text(b[..], n) == "{\"key\":\"build\",\"scope\":\"user\",\"event\":2,\"state\":\"conflict\"}" && cj_read_remembered(ar[..], cj_text(b[..], n)).event == 2;
  #assert !cj_read_remembered(ar[..], "{\"key\":\"build\",\"scope\":\"team\",\"event\":2,\"state\":\"current\"}").ok;
  n = cj_recall_open(b[..], 0, 6, true);
  n = cj_recall_fact(b[..], n, true, "deploy", "Ship it.", "project", 1, true, 718); n = cj_recall_fact_end(b[..], n);
  n = cj_recall_fact(b[..], n, false, "build", "make", "user", 3, true, 637); n = cj_recall_said(b[..], n, "s1", 2, "held"); n = cj_recall_fact_end(b[..], n);
  n = cj_recall_close(b[..], n);
  #assert cj_text(b[..], n) == "{\"verified\":true,\"events\":6,\"ranked\":true,\"facts\":[{\"key\":\"deploy\",\"text\":\"Ship it.\",\"scope\":\"project\",\"version\":1,\"score\":718},{\"key\":\"build\",\"text\":\"make\",\"scope\":\"user\",\"version\":3,\"score\":637,\"said_in\":{\"session\":\"s1\",\"line\":2,\"state\":\"held\"}}]}";
  rc := cj_read_recall(cj_text(b[..], n)); f := cj_read_recall_fact(ar[..], cj_item(cj_text(b[..], n), "facts", 1));
  #assert rc.ok && rc.events == 6 && rc.ranked && rc.facts == 2 && f.ok && f.has_score && f.score == 637 && f.said && f.session == "s1" && f.line == 2 && f.state == "held";
  n = cj_recall_open(b[..], 0, 0, false); n = cj_recall_close(b[..], n);
  #assert cj_text(b[..], n) == "{\"verified\":true,\"events\":0,\"ranked\":false,\"facts\":[]}";
}
