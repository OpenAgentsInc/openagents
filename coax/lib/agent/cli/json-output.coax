  cj_host_open(o[..]); cj_host_waiting(o[..], "aa", "bb", "A \"quoted\" browser", 5); cj_host_allowed(o[..]); cj_host_browser(o[..], "cc", "dd", "Mine", 9); cj_host_close(o[..]);
  #assert !o[0].bad && jo_text(o[..]) == "{\"waiting\":[{\"id\":\"aa\",\"key\":\"bb\",\"label\":\"A \\\"quoted\\\" browser\",\"asked_at\":5}],\"browsers\":[{\"grant\":\"cc\",\"key\":\"dd\",\"label\":\"Mine\",\"expires_at\":9}]}";
