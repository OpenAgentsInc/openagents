// Local Capability Authoring & Two-Arm Eval Runner (GitHub #13896, #14059).
//
// Drafts SKILL.md + positive/held-out eval cases from an authoring interview,
// executes real two-arm comparisons (baseline vs. candidate) via /bin/sh,
// records and verifies canonical ATIF-v1.8 logs (coax/lib/nostr/atif/log.coax),
// enforces the #authority promotion gate (capability-gate.coax), and either
// promotes passing capabilities into the local Skills repertoire or preserves
// rejected experiment evidence with its ATIF digest.
//
// Usage:
//   coax/web/tool.sh coax/lib/agent/desktop/capability-eval.coax draft --slug SLUG --goal G --inputs I --outputs O --nongoals N --out-dir DIR
//   coax/web/tool.sh coax/lib/agent/desktop/capability-eval.coax run --slug SLUG --skill-md PATH --pos-base CMD --pos-cand CMD --neg-base CMD --neg-cand CMD --skills-dir DIR --exp-dir DIR [--max-latency-ms N]
//   coax/web/tool.sh coax/lib/agent/desktop/capability-eval.coax selftest
#load "capability-author.coax";
#load "../../sys/tool.coax";

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("capability-eval: arguments did not fit"); return 2; }
  cmd := args_at(a[..], 0);

  if cmd == "selftest" {
    tb: [1024] u8; tmp := fs_temp("oa-cap-eval-", tb[..]);
    if tmp.count == 0 { tool_errln("selftest: fs_temp failed"); return 1; }
    dr_b: [1024] u8; draft_dir := fs_join(tmp, "draft", dr_b[..]);
    sk_b: [1024] u8; skills_dir := fs_join(tmp, "skills", sk_b[..]);
    ex_b: [1024] u8; exp_dir := fs_join(tmp, "experiments", ex_b[..]);

    err := ce_write_draft("fast-lint", "Run targeted lint checks", "file path", "lint report", "never modify files", draft_dir);
    if err.count > 0 { tool_errln(err); return 1; }
    sm_b: [1024] u8; sm_p := fs_join(draft_dir, "SKILL.md", sm_b[..]);

    // 1) Passing two-arm eval (baseline fails positive, candidate passes both positive and held-out)
    jb: [4096] u8; jn: [1] int;
    v1 := ce_run_two_arm("fast-lint", sm_p, "exit 1", "exit 0", "exit 0", "exit 0", skills_dir, exp_dir, 0, jb[..], jn[..]);
    if v1 != CAP_PASS { tool_errln("selftest: expected CAP_PASS for passing candidate"); return 1; }
    inst_dir_b: [1024] u8; inst_dir := fs_join(skills_dir, "fast-lint", inst_dir_b[..]);
    inst_md_b: [1024] u8; inst_md := fs_join(inst_dir, "SKILL.md", inst_md_b[..]);
    if !fs_exists(inst_md) { tool_errln("selftest: promoted SKILL.md missing"); return 1; }
    card_b: [2048] u8;
    cn := ce_format_verdict_card(cast(string) jb[0..<jn[0]], card_b[..]);
    if cn <= 0 || !ce_contains_ci(cast(string) card_b[0..<cn], "PROMOTED") {
      tool_errln("selftest: verdict card missing PROMOTED");
      return 1;
    }
    pr_b: [2048] u8;
    pn := ce_build_skills_prompt(skills_dir, "", 2048, pr_b[..]);
    if pn <= 0 || !ce_contains_ci(cast(string) pr_b[0..<pn], "fast-lint") {
      tool_errln("selftest: promoted skill missing from next-turn prompt listing");
      return 1;
    }

    // 2) Deliberately regressed candidate (fails held-out case) must be REJECTED and evidence preserved
    v2 := ce_run_two_arm("broken-lint", sm_p, "exit 0", "exit 0", "exit 0", "exit 1", skills_dir, exp_dir, 0, jb[..], jn[..]);
    if v2 != CAP_FAIL_REGRESSED { tool_errln("selftest: expected CAP_FAIL_REGRESSED for regressed candidate"); return 1; }
    bad_dir_b: [1024] u8; bad_dir := fs_join(skills_dir, "broken-lint", bad_dir_b[..]);
    if fs_exists(bad_dir) { tool_errln("selftest: rejected candidate should not be promoted"); return 1; }
    rej_b: [1024] u8; rej_p := fs_join(exp_dir, "broken-lint-rejected.json", rej_b[..]);
    if !fs_exists(rej_p) { tool_errln("selftest: rejected experiment evidence missing"); return 1; }

    rm_argv := [3] string.["/bin/rm", "-rf", tmp];
    ro: [64] u8; re: [64] u8;
    _ = proc_run(rm_argv[..], 5000, ro[..], re[..]);
    print("capability-eval selftest: PASS (promoted=fast-lint rejected=broken-lint atif_verified=true)\n");
    return 0;
  }

  if cmd == "draft" {
    slug := ""; goal := ""; inputs := ""; outputs := ""; nongoals := ""; out_dir := "";
    i := 1;
    while i < a[0].n {
      k := args_at(a[..], i);
      if k == "--slug" && i + 1 < a[0].n { slug = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--goal" && i + 1 < a[0].n { goal = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--inputs" && i + 1 < a[0].n { inputs = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--outputs" && i + 1 < a[0].n { outputs = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--nongoals" && i + 1 < a[0].n { nongoals = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--out-dir" && i + 1 < a[0].n { out_dir = args_at(a[..], i + 1); i += 2; continue; }
      i += 1;
    }
    err := ce_write_draft(slug, goal, inputs, outputs, nongoals, out_dir);
    if err.count > 0 { tool_errln(err); return 1; }
    print("draft ok\n");
    return 0;
  }

  if cmd == "run" {
    slug := ""; skill_md := ""; pos_base := "exit 1"; pos_cand := "exit 0"; neg_base := "exit 0"; neg_cand := "exit 0";
    skills_dir := ""; exp_dir := ""; max_lat := 0;
    i := 1;
    while i < a[0].n {
      k := args_at(a[..], i);
      if k == "--slug" && i + 1 < a[0].n { slug = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--skill-md" && i + 1 < a[0].n { skill_md = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--pos-base" && i + 1 < a[0].n { pos_base = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--pos-cand" && i + 1 < a[0].n { pos_cand = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--neg-base" && i + 1 < a[0].n { neg_base = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--neg-cand" && i + 1 < a[0].n { neg_cand = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--skills-dir" && i + 1 < a[0].n { skills_dir = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--exp-dir" && i + 1 < a[0].n { exp_dir = args_at(a[..], i + 1); i += 2; continue; }
      if k == "--max-latency-ms" && i + 1 < a[0].n { max_lat = ce_parse_int(args_at(a[..], i + 1)); i += 2; continue; }
      i += 1;
    }
    jb: [4096] u8; jn: [1] int;
    v := ce_run_two_arm(slug, skill_md, pos_base, pos_cand, neg_base, neg_cand, skills_dir, exp_dir, max_lat, jb[..], jn[..]);
    if v < 0 { tool_errln("capability-eval: run failed"); return 1; }
    print("%", cast(string) jb[0..<jn[0]]);
    return ifx v == CAP_PASS then 0 else 3;
  }

  print("usage: capability-eval [draft|run|selftest]\n");
  return 0;
}
