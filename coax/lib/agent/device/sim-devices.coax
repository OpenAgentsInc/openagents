// Which iOS simulators there are, and whether one is contested (docs/desktop/ios-simulator-spec.md
// sections 3 and 9.1 rule 4; GitHub #13811). The one place that reads `xcrun simctl list` and
// decides that another tool holds a simulator: the phone app's dev loop
// (apps/shared/app/preview/loop.coax) and the simulator helper (sim-host.coax, oasim) both load it.
//   list := "...";                                   // `xcrun simctl list devices -j`
//   ds: [1] SdList; sd_parse(list, ds[..]);           // ds[0].d[0..<ds[0].n]: udid, name, runtime, state
//   s := sd_sim_find(text, "Coax Native Starter");    // `xcrun simctl list devices` (text), by exact name
//   if sd_targets(ps_line, name, s.udid, s.booted) { ... }   // a build or install from elsewhere holds it
#load "../../json/json.coax";

sd_starts :: (s: string, p: string) -> bool { return s.count >= p.count && s[0..<p.count] == p; }
sd_find :: (s: string, part: string, from: int) -> int {
  if part.count == 0 || part.count > s.count { return -1; }
  for i: from..<s.count - part.count + 1 { if s[i..<i + part.count] == part { return i; } }
  return -1;
}

// ---- the text list (`xcrun simctl list devices`), as dev.sh reads it

// A simulator in `xcrun simctl list devices`, whose line is "    NAME (UDID) (State) ".
// The UDID is a slice of list.
SdSim :: struct { found: bool; udid: string; booted: bool; }
sd_sim_find :: (list: string, name: string) -> SdSim {
  i := 0;
  while i < list.count {  // mutant: equivalent (at the end, an empty line names no simulator)
    e := i;
    while e < list.count && list[e] != '\n' { e += 1; }
    line := list[i..<e];
    k := 0;
    while k < line.count && line[k] == ' ' { k += 1; }
    rest := line[k..<line.count];
    if k > 0 && name.count > 0 && rest.count > name.count + 2 && sd_starts(rest, name) && rest[name.count..<name.count + 2] == " (" {  // mutant: equivalent (a name is no shorter than 1 and rest never starts with a space; rest just 2 past the name holds no ")" after its " (")
      u := name.count + 2; v := u;
      while v < rest.count && rest[v] != ')' { v += 1; }
      if v < rest.count { return SdSim.{found = true, udid = rest[u..<v], booted = sd_find(rest, "(Booted)", v) >= 0}; }  // mutant: equivalent ("(Booted)" is past v, which is past 0)
    }
    i = e + 1;
  }
  return SdSim.{};
}
#test "a simulator by its exact name: its UDID and whether it is booted" {
  list := "== Devices ==\n-- iOS 26.0 --\n    Coax Native Starter 2 (BBBB) (Shutdown) \n    Coax Native Starter (AAAA) (Booted) \n    OpenAgents Dev (CCCC) (Shutdown) \n";
  a := sd_sim_find(list, "Coax Native Starter");
  #assert a.found && a.udid == "AAAA" && a.booted;
  b := sd_sim_find(list, "OpenAgents Dev");
  #assert b.found && b.udid == "CCCC" && !b.booted;
  #assert !sd_sim_find(list, "OpenAgents").found && !sd_sim_find(list, "").found && !sd_sim_find("", "OpenAgents Dev").found;
}

// The program a command line runs: its first word's last path part ("/usr/bin/xcrun -x" is "xcrun").
sd_program :: (cmd: string) -> string {
  e := 0;
  while e < cmd.count && cmd[e] != ' ' { e += 1; }
  b := e;
  while b > 0 && cmd[b - 1] != '/' { b -= 1; }
  return cmd[b..<e];
}
// The command line after its first word.
sd_after_word :: (cmd: string) -> string {
  e := 0;
  while e < cmd.count && cmd[e] != ' ' { e += 1; }
  return ifx e < cmd.count then cmd[e + 1..<cmd.count] else "";
}
// Whether a process's command line targets the simulator: an xcodebuild that names it, or a simctl
// install or launch that names it or, while it is booted, "booted". Only the program counts, so a
// shell whose script mentions xcodebuild does not.
sd_targets :: (cmd: string, name: string, udid: string, booted: bool) -> bool {
  names_it := (name.count > 0 && sd_find(cmd, name, 0) >= 0) || (udid.count > 0 && sd_find(cmd, udid, 0) >= 0);  // mutant: equivalent (sd_find of an empty name or UDID is -1)
  prog := sd_program(cmd);
  if prog == "xcodebuild" { return names_it; }
  if (prog == "simctl" || (prog == "xcrun" && sd_starts(sd_after_word(cmd), "simctl "))) && (sd_find(cmd, " install ", 0) >= 0 || sd_find(cmd, " launch ", 0) >= 0) {  // mutant: equivalent (the line starts with its program, so " install " and " launch " are never at 0)
    return names_it || (booted && sd_find(cmd, " booted", 0) >= 0);  // mutant: equivalent (the line starts with its program, so " booted" is never at 0)
  }
  return false;
}
#test "an xcodebuild or simctl install or launch that targets the simulator" {
  #assert sd_targets("xcodebuild -scheme OpenAgents -destination platform=iOS Simulator,name=Coax Native Starter build", "Coax Native Starter", "AAAA", true);
  #assert sd_targets("xcodebuild -destination id=AAAA build", "Coax Native Starter", "AAAA", false);
  #assert !sd_targets("xcodebuild -destination id=CCCC build", "Coax Native Starter", "AAAA", true);
  #assert sd_targets("xcrun simctl install booted /x/OpenAgents.app", "Coax Native Starter", "AAAA", true);
  #assert !sd_targets("xcrun simctl install booted /x/OpenAgents.app", "OpenAgents Dev", "CCCC", false);
  #assert sd_targets("xcrun simctl launch --terminate-running-process AAAA com.x", "Coax Native Starter", "AAAA", false);
  #assert !sd_targets("xcrun simctl io AAAA screenshot a.png", "Coax Native Starter", "AAAA", true);
  #assert !sd_targets("vim Coax Native Starter.txt", "Coax Native Starter", "AAAA", true);
  #assert !sd_targets("/bin/zsh -c xcodebuild -destination name=Coax Native Starter", "Coax Native Starter", "AAAA", true);
  #assert sd_targets("/Applications/Xcode.app/Contents/Developer/usr/bin/xcodebuild -destination id=AAAA", "Coax Native Starter", "AAAA", true);
  #assert sd_targets("/Library/Developer/PrivateFrameworks/CoreSimulator.framework/Resources/bin/simctl launch AAAA com.x", "X", "AAAA", false);
  #assert sd_program("/usr/bin/xcrun simctl") == "xcrun" && sd_program("xcodebuild") == "xcodebuild" && sd_program("") == "";
  #assert sd_after_word("xcrun simctl list") == "simctl list" && sd_after_word("xcrun") == "";
}
// The first line of ps (`ps -axo command=`) whose process targets the simulator, "" when none.
sd_targeted_by :: (ps: string, name: string, udid: string, booted: bool) -> string {
  i := 0;
  while i < ps.count {  // mutant: equivalent (at the end, an empty line targets nothing)
    e := i;
    while e < ps.count && ps[e] != '\n' { e += 1; }
    if sd_targets(ps[i..<e], name, udid, booted) { return ps[i..<e]; }
    i = e + 1;
  }
  return "";
}
#test "the process that holds a simulator, from ps" {
  ps := "/sbin/launchd\nxcrun simctl io AAAA screenshot a.png\nxcodebuild -destination id=AAAA build\n";
  #assert sd_targeted_by(ps, "X", "AAAA", true) == "xcodebuild -destination id=AAAA build";
  #assert sd_targeted_by(ps, "X", "BBBB", true) == "" && sd_targeted_by("", "X", "AAAA", true) == "";
}

// The first app running on the simulator that is neither Apple's nor ours, from launchctl list's
// "UIKitApplication:BUNDLE[...]" entries (a slice of list). "" when none.
sd_other_app :: (list: string, ours: string) -> string {
  at := 0;
  while at < list.count {  // mutant: equivalent (sd_find from the end finds nothing)
    i := sd_find(list, "UIKitApplication:", at);
    if i < 0 { return ""; }
    b := i + 17; e := b;
    while e < list.count && list[e] != '[' && list[e] != '\n' && list[e] != ' ' && list[e] != '\t' { e += 1; }
    bundle := list[b..<e];
    if bundle.count > 0 && bundle != ours && !sd_starts(bundle, "com.apple.") { return bundle; }
    at = e;
  }
  return "";
}
#test "another app session on the simulator, past Apple's and ours" {
  l := "37453\t0\tUIKitApplication:com.apple.Spotlight[79e5][rb-legacy]\n82288\t0\tUIKitApplication:com.openagents.app[242f][rb-legacy]\n";
  #assert sd_other_app(l, "com.openagents.app") == "";
  m := "1\t0\tUIKitApplication:com.openagents.app[242f]\n2\t0\tUIKitApplication:com.example.game[11]\n";
  #assert sd_other_app(m, "com.openagents.app") == "com.example.game" && sd_other_app("", "x") == "";
}

// A simulator's name as a file name: letters and digits, the rest "-".
sd_slug :: (name: string, out: [] u8) -> string {
  n := 0;
  for c: name {
    if n >= out.count { break; }
    ok := (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
    out[n] = c; if !ok { out[n] = cast(u8) '-'; }
    n += 1;
  }
  return cast(string) out[0..<n];
}
#test "simulator names as file names" { b: [64] u8; #assert sd_slug("Coax Native Starter", b[..]) == "Coax-Native-Starter" && sd_slug("", b[..]) == ""; }

// ---- the JSON list (`xcrun simctl list devices -j`), as the helper reads it

SD_MOST :: 64;          // simulators listed at most
SD_NONE :: 0; SD_SHUTDOWN :: 1; SD_BOOTING :: 2; SD_BOOTED :: 3; SD_SHUTTING :: 4;   // a simulator's state
SdDevice :: struct {
  udid: [64] u8; udid_n: int;
  name: [128] u8; name_n: int;
  runtime: [48] u8; runtime_n: int;     // "iOS 26.5"
  state: int;                            // SD_*
}
SdList :: struct { d: [SD_MOST] SdDevice; n: int; ok: bool; }
sd_udid :: (l: [] SdList, i: int) -> string { return cast(string) l[0].d[i].udid[0..<l[0].d[i].udid_n]; }
sd_name :: (l: [] SdList, i: int) -> string { return cast(string) l[0].d[i].name[0..<l[0].d[i].name_n]; }
sd_runtime :: (l: [] SdList, i: int) -> string { return cast(string) l[0].d[i].runtime[0..<l[0].d[i].runtime_n]; }
sd_put :: (out: [] u8, s: string) -> int { n := 0; for c: s { if n < out.count { out[n] = c; n += 1; } } return n; }

// A runtime's identifier as a person reads it: "com.apple.CoreSimulator.SimRuntime.iOS-26-5" is
// "iOS 26.5". "" for a runtime that is not iOS (v1 shows iOS only: spec, Non-goals).
sd_runtime_name :: (id: string, out: [] u8) -> string {
  p := "com.apple.CoreSimulator.SimRuntime.iOS-";
  if !sd_starts(id, p) || id.count == p.count { return ""; }
  n := sd_put(out, "iOS ");
  for c: id[p.count..<id.count] {
    if n >= out.count { break; }
    out[n] = ifx c == '-' then cast(u8) '.' else c; n += 1;
  }
  return cast(string) out[0..<n];
}
#test "runtimes as a person reads them, iOS only" {
  b: [48] u8;
  #assert sd_runtime_name("com.apple.CoreSimulator.SimRuntime.iOS-26-5", b[..]) == "iOS 26.5";
  #assert sd_runtime_name("com.apple.CoreSimulator.SimRuntime.iOS-18-0", b[..]) == "iOS 18.0";
  #assert sd_runtime_name("com.apple.CoreSimulator.SimRuntime.watchOS-11-0", b[..]) == "" && sd_runtime_name("com.apple.CoreSimulator.SimRuntime.iOS-", b[..]) == "";
}
sd_state :: (s: string) -> int {
  if s == "Shutdown" { return SD_SHUTDOWN; }
  if s == "Booting" { return SD_BOOTING; }
  if s == "Booted" { return SD_BOOTED; }
  if s == "Shutting Down" { return SD_SHUTTING; }
  return SD_NONE;
}
sd_state_word :: (st: int) -> string {
  if st == SD_SHUTDOWN { return "shutdown"; }
  if st == SD_BOOTING { return "booting"; }
  if st == SD_BOOTED { return "booted"; }
  if st == SD_SHUTTING { return "shutting_down"; }
  return "unknown";
}
// `xcrun simctl list devices -j` into out: every available iOS simulator, in the order listed.
// False when the text is not the list.
SD_NODES :: 16384;
sd_parse :: (text: string, out: [] SdList) -> bool {
  out[0].n = 0; out[0].ok = false;
  nodes: [SD_NODES] JvNode; d: [1] Jv;
  if !jv_parse(d[..], text, nodes[..]) { return false; }
  v := d[0];
  devs := jv_get(v, 0, "devices");
  if jv_kind(v, devs) != JV_OBJECT { return false; }
  rt := v.nodes[devs].first;
  while rt != -1 {
    rb: [48] u8;
    runtime := sd_runtime_name(jv_key(v, rt), rb[..]);
    if runtime.count > 0 && jv_kind(v, rt) == JV_ARRAY {  // mutant: equivalent (a runtime name starts "iOS ", so it is never 1 long)
      e := v.nodes[rt].first;
      while e != -1 && out[0].n < SD_MOST {
        if jv_kind(v, jv_get(v, e, "isAvailable")) != JV_FALSE {
          x := out[0].n;
          dv := SdDevice.{};
          dv.udid_n = jv_str(v, jv_get(v, e, "udid"), dv.udid[..]);
          dv.name_n = jv_str(v, jv_get(v, e, "name"), dv.name[..]);
          sb: [32] u8; sn := jv_str(v, jv_get(v, e, "state"), sb[..]);
          dv.state = ifx sn > 0 then sd_state(cast(string) sb[0..<sn]) else SD_NONE;  // mutant: equivalent (sd_state of "" or one letter is SD_NONE)
          dv.runtime_n = sd_put(dv.runtime[..], runtime);
          if dv.udid_n > 0 && dv.name_n > 0 { out[0].d[x] = dv; out[0].n += 1; }
        }
        e = v.nodes[e].next;
      }
    }
    rt = v.nodes[rt].next;
  }
  out[0].ok = true;
  return true;
}
#test "the JSON list: iOS simulators that are available, their runtime and state" {
  j := "{\"devices\":{\"com.apple.CoreSimulator.SimRuntime.watchOS-11-0\":[{\"udid\":\"W1\",\"name\":\"Watch\",\"state\":\"Shutdown\",\"isAvailable\":true}],\"com.apple.CoreSimulator.SimRuntime.iOS-26-5\":[{\"lastBootedAt\":\"x\",\"udid\":\"A1\",\"isAvailable\":true,\"name\":\"iPhone 17\",\"state\":\"Booted\"},{\"udid\":\"B2\",\"isAvailable\":false,\"name\":\"Gone\",\"state\":\"Shutdown\"},{\"udid\":\"C3\",\"isAvailable\":true,\"name\":\"iPad \\\"Air\\\"\",\"state\":\"Shutdown\"}]}}";
  l: [1] SdList;
  #assert sd_parse(j, l[..]) && l[0].ok && l[0].n == 2;
  #assert sd_udid(l[..], 0) == "A1" && sd_name(l[..], 0) == "iPhone 17" && sd_runtime(l[..], 0) == "iOS 26.5" && l[0].d[0].state == SD_BOOTED;
  #assert sd_udid(l[..], 1) == "C3" && sd_name(l[..], 1) == "iPad \"Air\"" && l[0].d[1].state == SD_SHUTDOWN;
  #assert !sd_parse("{}", l[..]) && l[0].n == 0 && !sd_parse("not json", l[..]);
  #assert sd_state("Booting") == SD_BOOTING && sd_state("Shutting Down") == SD_SHUTTING && sd_state("x") == SD_NONE;
  #assert sd_state_word(SD_BOOTED) == "booted" && sd_state_word(SD_SHUTDOWN) == "shutdown" && sd_state_word(SD_BOOTING) == "booting" && sd_state_word(SD_SHUTTING) == "shutting_down" && sd_state_word(9) == "unknown";
}
// A simulator by UDID or exact name; -1 when the list has none. A UDID wins over a name.
sd_pick :: (l: [] SdList, device: string) -> int {
  if device.count == 0 { return -1; }
  for i: 0..<l[0].n { if sd_udid(l, i) == device { return i; } }
  for i: 0..<l[0].n { if sd_name(l, i) == device { return i; } }
  return -1;
}
// The first booted simulator, -1 when none is.
sd_first_booted :: (l: [] SdList) -> int {
  for i: 0..<l[0].n { if l[0].d[i].state == SD_BOOTED { return i; } }
  return -1;
}
#test "a simulator by UDID or name, and the first booted one" {
  l: [1] SdList;
  j := "{\"devices\":{\"com.apple.CoreSimulator.SimRuntime.iOS-26-5\":[{\"udid\":\"A1\",\"name\":\"B2\",\"state\":\"Shutdown\"},{\"udid\":\"B2\",\"name\":\"Two\",\"state\":\"Booted\"}]}}";
  #assert sd_parse(j, l[..]);
  #assert sd_pick(l[..], "B2") == 1 && sd_pick(l[..], "A1") == 0 && sd_pick(l[..], "Two") == 1 && sd_pick(l[..], "Three") == -1 && sd_pick(l[..], "") == -1;
  #assert sd_first_booted(l[..]) == 1;
  e: [1] SdList; #assert sd_first_booted(e[..]) == -1;
}

// Whether the string at `at` is want (false when there is none).
sd_is :: (v: Jv, at: int, want: string) -> bool { b: [256] u8; n := jv_str(v, at, b[..]); return n == want.count && cast(string) b[0..<n] == want; }
// The deviceTypeIdentifier of the device udid in `simctl list devices -j`.
sd_device_type :: (text: string, udid: string, out: [] u8) -> int {
  nodes: [SD_NODES] JvNode; d: [1] Jv;
  if !jv_parse(d[..], text, nodes[..]) { return -1; }
  v := d[0]; devs := jv_get(v, 0, "devices"); rt := ifx jv_kind(v, devs) == JV_OBJECT then v.nodes[devs].first else -1;
  while rt != -1 {
    e := ifx jv_kind(v, rt) == JV_ARRAY then v.nodes[rt].first else -1;
    while e != -1 {
      if sd_is(v, jv_get(v, e, "udid"), udid) { return jv_str(v, jv_get(v, e, "deviceTypeIdentifier"), out); }
      e = v.nodes[e].next;
    }
    rt = v.nodes[rt].next;
  }
  return -1;
}
// The bundlePath of a device type in `simctl list devicetypes -j`.
sd_type_bundle :: (text: string, id: string, out: [] u8) -> int {
  nodes: [SD_NODES] JvNode; d: [1] Jv;
  if !jv_parse(d[..], text, nodes[..]) { return -1; }
  v := d[0]; ts := jv_get(v, 0, "devicetypes"); e := ifx jv_kind(v, ts) == JV_ARRAY then v.nodes[ts].first else -1;
  while e != -1 {
    if sd_is(v, jv_get(v, e, "identifier"), id) { return jv_str(v, jv_get(v, e, "bundlePath"), out); }
    e = v.nodes[e].next;
  }
  return -1;
}
#test "a device's type and the type's bundle, from simctl's lists" {
  devs := "{\"devices\":{\"com.apple.CoreSimulator.SimRuntime.iOS-26-5\":[{\"udid\":\"A1\",\"deviceTypeIdentifier\":\"com.apple.CoreSimulator.SimDeviceType.iPhone-17\",\"name\":\"x\"}]}}";
  b: [256] u8;
  n := sd_device_type(devs, "A1", b[..]);
  #assert n > 0 && cast(string) b[0..<n] == "com.apple.CoreSimulator.SimDeviceType.iPhone-17" && sd_device_type(devs, "B2", b[..]) == -1;
  types := "{\"devicetypes\":[{\"bundlePath\":\"\\/L\\/iPhone 17.simdevicetype\",\"identifier\":\"com.apple.CoreSimulator.SimDeviceType.iPhone-17\"}]}";
  #assert sd_device_type("{", "A1", b[..]) == -1 && sd_device_type("{\"devices\":5,\"udid\":\"A1\",\"deviceTypeIdentifier\":\"t\"}", "A1", b[..]) == -1;
  #assert sd_device_type("[{\"udid\":\"A1\",\"deviceTypeIdentifier\":\"t\"}]", "A1", b[..]) == -1 && sd_device_type("{\"devices\":{\"r\":5},\"udid\":\"A1\",\"deviceTypeIdentifier\":\"t\"}", "A1", b[..]) == -1;
  #assert sd_type_bundle("{", "x", b[..]) == -1 && sd_type_bundle("{\"devicetypes\":5,\"identifier\":\"x\",\"bundlePath\":\"p\"}", "x", b[..]) == -1;
  #assert sd_type_bundle("{\"devicetypes\":[{\"bundlePath\":\"p\"}]}", "", b[..]) == -1;
  k := sd_type_bundle(types, "com.apple.CoreSimulator.SimDeviceType.iPhone-17", b[..]);
  #assert k > 0 && cast(string) b[0..<k] == "/L/iPhone 17.simdevicetype" && sd_type_bundle(types, "x", b[..]) == -1;
}


// OA_SIM_ONLY (checks and test launches): keeps only the devices whose UDID only names (a
// comma-separated list), so a check never sees the person's devices. "" keeps them all.
sd_keep :: (l: [] SdList, only: string) {
  if only.count == 0 { return; }
  k := 0;
  for i: 0..<l[0].n { if sd_find(only, sd_udid(l, i), 0) >= 0 { l[0].d[k] = l[0].d[i]; k += 1; } }
  l[0].n = k;
}
#test "OA_SIM_ONLY keeps only the devices it names" {
  t := "{\"devices\":{\"com.apple.CoreSimulator.SimRuntime.iOS-26-5\":[{\"udid\":\"A1\",\"name\":\"a\",\"state\":\"Shutdown\",\"isAvailable\":true,\"deviceTypeIdentifier\":\"x\"},{\"udid\":\"B2\",\"name\":\"b\",\"state\":\"Booted\",\"isAvailable\":true,\"deviceTypeIdentifier\":\"x\"},{\"udid\":\"C3\",\"name\":\"c\",\"state\":\"Shutdown\",\"isAvailable\":true,\"deviceTypeIdentifier\":\"x\"}]}}";
  l: [1] SdList;
  #assert sd_parse(t, l[..]) && l[0].n == 3;
  sd_keep(l[..], "");
  #assert l[0].n == 3;
  sd_keep(l[..], "C3,A1");
  #assert l[0].n == 2 && sd_udid(l[..], 0) == "A1" && sd_udid(l[..], 1) == "C3";
  sd_keep(l[..], "Z9");
  #assert l[0].n == 0;
}
#test "the text helpers at their edges: whole matches, the first place, no trailing line feed, short buffers" {
  #assert sd_starts("ab", "ab") && !sd_starts("a", "ab") && sd_starts("ab", "");
  #assert sd_find("abc", "b", 0) == 1 && sd_find("ab", "ab", 0) == 0 && sd_find("a", "", 0) == -1 && sd_find("a", "abc", 0) == -1 && sd_find("abc", "a", 1) == -1;
  // a simulator's line without the list's last line feed; one space of indent; a one-letter name
  #assert sd_sim_find("    Phone (AAAA) (Booted)", "Phone").udid == "AAAA" && sd_sim_find("    Phone (AAAA) (Booted)", "Phone").booted;
  a := sd_sim_find(" P (B1) (Shutdown) ", "P"); #assert a.found && a.udid == "B1" && !a.booted;
  #assert !sd_sim_find("Phone (AAAA) (Booted)", "Phone").found && !sd_sim_find("    Phone", "Phone").found && !sd_sim_find("    Phone (AAAA", "Phone").found;
  b := sd_sim_find("    N ()", "N"); #assert b.found && b.udid == "";
  #assert !sd_sim_find("XPhone (AAAA) (Booted)", "Phone").found && !sd_sim_find("", "P").found && !sd_sim_find("    ", "P").found;
  #assert sd_sim_find("    P (ABC) (Booted)", "P").udid == "ABC" && sd_sim_find("x\n P (B1)", "P").udid == "B1";
  #assert sd_sim_find("    Other (BBBB) (Booted)\n    Phone (AAAA) (Shutdown)", "Phone").udid == "AAAA";
  #assert sd_after_word(" a") == "a" && sd_after_word("a ") == "";
  // ps's lines: the first line is a target, the last has no line feed
  #assert sd_targeted_by("xcodebuild -destination id=AAAA", "X", "AAAA", true) == "xcodebuild -destination id=AAAA";
  #assert sd_targeted_by("/sbin/launchd\nxcodebuild -destination id=AAAA", "X", "AAAA", true) == "xcodebuild -destination id=AAAA";
  #assert sd_targeted_by("/sbin/launchd", "X", "AAAA", true) == "";
  // a one-letter name or UDID; a name the program's own path starts with
  #assert sd_targets("xcodebuild -destination id=Q", "", "Q", false) && sd_targets("xcodebuild -destination name=P", "P", "", false) && !sd_targets("xcodebuild build", "", "", true);
  #assert sd_targets("/Applications/Xcode.app/Contents/Developer/usr/bin/xcodebuild build", "/Applications", "", false);
  #assert sd_targets("/Applications/Xcode.app/Contents/Developer/usr/bin/xcodebuild build", "", "/Applications", false);
  #assert !sd_targets("sh simctl install booted /x.app", "X", "AAAA", true) && sd_targets("simctl install booted /x.app", "X", "AAAA", true) && !sd_targets("xcrun simctl install booted /x.app", "X", "AAAA", false);
  // launchctl's list: an entry at the very start, each end of a bundle, an empty and a one-letter bundle
  #assert sd_other_app("UIKitApplication:com.x.game[1]", "ours") == "com.x.game";
  #assert sd_other_app("1 UIKitApplication:com.x.y\n", "ours") == "com.x.y" && sd_other_app("1 UIKitApplication:com.x.y z", "ours") == "com.x.y" && sd_other_app("1 UIKitApplication:com.x.y\tz", "ours") == "com.x.y";
  #assert sd_other_app("1 UIKitApplication:com.x.y", "ours") == "com.x.y" && sd_other_app("1 UIKitApplication:com.x.yz[", "ours") == "com.x.yz";
  #assert sd_other_app("UIKitApplication:[1]\nUIKitApplication:com.x.z[2]", "ours") == "com.x.z" && sd_other_app("UIKitApplication:q[1]", "ours") == "q";
  #assert sd_other_app("UIKitApplication:com.apple.x[1]\nUIKitApplication:ours[2]", "ours") == "";
  // file names: each letter range's ends and their neighbours
  s: [16] u8; #assert sd_slug("azAZ09`{@[/:", s[..]) == "azAZ09------" && sd_slug("abc", s[0..<2]) == "ab";
  p: [4] u8; #assert sd_put(p[0..<2], "abc") == 2 && cast(string) p[0..<2] == "ab" && sd_put(p[..], "") == 0;
  r: [8] u8; #assert sd_runtime_name("com.apple.CoreSimulator.SimRuntime.iOS-26-5", r[..]) == "iOS 26.5" && sd_runtime_name("com.apple.CoreSimulator.SimRuntime.iOS-26-5", r[0..<6]) == "iOS 26";
}
#test "the JSON list at its edges: a failed parse after a good one, a device lacking its UDID, name or state, the most it holds" {
  l: [1] SdList;
  #assert sd_parse("{\"devices\":{\"com.apple.CoreSimulator.SimRuntime.iOS-26-5\":[{\"udid\":\"A\",\"name\":\"N\",\"state\":\"Booted\"}]}}", l[..]) && l[0].ok && l[0].d[0].state == SD_BOOTED;
  #assert !sd_parse("{}", l[..]) && !l[0].ok;
  j := "{\"devices\":{\"com.apple.CoreSimulator.SimRuntime.iOS-26-5\":[{\"name\":\"N\"},{\"udid\":\"A\"},{\"udid\":\"\",\"name\":\"N\"},{\"udid\":\"B\",\"name\":\"\"},{\"udid\":\"C\",\"name\":\"M\"}]}}";
  #assert sd_parse(j, l[..]) && l[0].n == 1 && sd_udid(l[..], 0) == "C" && l[0].d[0].state == SD_NONE;
  // more than the list holds: the first SD_MOST
  b: [8192] u8; n := sd_put(b[..], "{\"devices\":{\"com.apple.CoreSimulator.SimRuntime.iOS-26-5\":[");
  for i: 0..<SD_MOST + 1 { if i > 0 { b[n] = ','; n += 1; } n += sd_put(b[n..<b.count], "{\"udid\":\"U\",\"name\":\"N\",\"state\":\"Booted\"}"); }
  n += sd_put(b[n..<b.count], "]}}");
  #assert sd_parse(cast(string) b[0..<n], l[..]) && l[0].n == SD_MOST;
  // a pick and the first booted at the list's first place; a one-letter device
  k := "{\"devices\":{\"com.apple.CoreSimulator.SimRuntime.iOS-26-5\":[{\"udid\":\"Z\",\"name\":\"Y\",\"state\":\"Booted\"},{\"udid\":\"B\",\"name\":\"Two\",\"state\":\"Booted\"}]}}";
  #assert sd_parse(k, l[..]) && sd_pick(l[..], "Z") == 0 && sd_pick(l[..], "Y") == 0 && sd_first_booted(l[..]) == 0;
}
