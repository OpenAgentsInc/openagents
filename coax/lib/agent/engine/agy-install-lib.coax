// Managed Google Antigravity CLI (`agy`) installer library (GitHub #13839): fetch the
// release manifest, verify >= 1.5.0 < 2.0.0 and streaming SHA-512 in pure Coax, install
// into immutable ~/.openagents/runtimes/agy/releases/<release_id>/ directories, switch
// active.json atomically, and prune only unleased inactive versions. Loaded by the
// agy-install tool (agy-install.coax) and by agyworker's --connect (the desktop's
// "Connect Google Antigravity").

#load "antigravity.coax";
#load "../../sys/proc.coax";
#load "../../sys/tool.coax";
#load "../../crypto/sha512.coax";

// Stream-hash a file on disk with SHA-512 (64 KiB chunks) into 128 lowercase hex chars.
agy_sha512_file_hex :: (path: string, out_hex: [] u8) -> string {
  if out_hex.count < 128 { return ""; }
  sz := fs_size(path);
  if sz < 0 { return ""; }
  st: [208] u8;
  if sha512_init(st[..]) != SHA512_OK { return ""; }
  chunk: [65536] u8;
  off := 0;
  while off < sz {
    n := fs_read_at(path, off, chunk[..]);
    if n <= 0 { return ""; }
    if sha512_update_checked(st[..], chunk[0..<n], false) != SHA512_OK { return ""; }
    off += n;
  }
  dig: [64] u8;
  if sha512_final_checked(st[..], dig[..], false) != SHA512_OK { return ""; }
  hex := "0123456789abcdef";
  for i: 0..<64 {
    out_hex[i * 2] = hex[cast(int) (dig[i] >> 4)];
    out_hex[i * 2 + 1] = hex[cast(int) (dig[i] & 15)];
  }
  return cast(string) out_hex[0..<128];
}

// Copy a file in 64 KiB chunks in pure Coax (works on Windows and POSIX without cp).
agy_copy_file :: (from: string, to: string) -> bool {
  sz := fs_size(from);
  if sz < 0 { return false; }
  if sz == 0 { return fs_write(to, ""); }
  chunk: [65536] u8;
  off := 0;
  while off < sz {
    n := fs_read_at(from, off, chunk[..]);
    if n <= 0 { return false; }
    ok := ifx off == 0 then fs_write(to, cast(string) chunk[0..<n]) else fs_append(to, cast(string) chunk[0..<n]);
    if !ok { return false; }
    off += n;
  }
  return true;
}

// True when path is located directly under dir (e.g., <root>/staging/<rid>.progress).
agy_under_dir :: (path: string, dir: string) -> bool {
  if dir.count == 0 || path.count <= dir.count + 1 { return false; }
  if cast(string) path[0..<dir.count] != dir { return false; }
  sep := path[dir.count];
  return sep == '/' || sep == '\\';
}

#test "agy-install-lib: agy_under_dir distinguishes staging paths from external artifacts" {
  #assert agy_under_dir("/root/staging/abc.progress", "/root/staging");
  #assert agy_under_dir("C:\\root\\staging\\abc.progress", "C:\\root\\staging");
  #assert !agy_under_dir("/root/staging2/abc.exe", "/root/staging");
  #assert !agy_under_dir("/tmp/user.exe", "/root/staging");
  #assert !agy_under_dir("/root/staging", "/root/staging");
}

// Retry fs_remove with bounded backoff for briefly locked Windows runtime folders (#13839).
agy_remove_retry :: (path: string) -> bool {
  if fs_remove(path) { return true; }
  attempt := 0;
  while true {
    delay := agy_win_retry_delay_ms(attempt);
    if delay < 0 { return false; }
    proc_sleep(delay);
    if fs_remove(path) { return true; }
    attempt += 1;
  }
  return false;
}

// Retry fs_rename with bounded backoff for briefly locked Windows runtime folders (#13839).
agy_rename_retry :: (from: string, to: string) -> bool {
  if fs_rename(from, to) { return true; }
  attempt := 0;
  while true {
    delay := agy_win_retry_delay_ms(attempt);
    if delay < 0 { return false; }
    proc_sleep(delay);
    if fs_rename(from, to) { return true; }
    attempt += 1;
  }
  return false;
}

// True when a process with pid is currently alive (POSIX `kill -0`, Windows `tasklist` — #14004).
agy_pid_alive :: (pid: int) -> bool {
  if pid <= 0 { return false; }
  pb: [32] u8; ps := agy_int_to_str(pid, pb[..]);
  if ps.count == 0 { return false; }
  if tool_os() == 3 {
    fb: [48] u8; fn := cl_copy(fb[..], "PID eq "); fn += cl_copy(fb[fn..<fb.count], ps);
    argv := [4] string.["tasklist", "/FI", cast(string) fb[0..<fn], "/NH"];
    out: [512] u8; err: [128] u8;
    r := proc_run(argv[..], 3000, out[..], err[..]);
    if r.started != 0 || r.status != 0 { return true; } // Fail safe on Windows: never delete a lease if tasklist fails
    return agy_has(cast(string) out[0..<r.out_n], ps);
  }
  argv := [3] string.["kill", "-0", ps];
  out: [64] u8; err: [64] u8;
  r := proc_run(argv[..], 2000, out[..], err[..]);
  return r.started == 0 && r.status == 0;
}

// Load active leases from <root>/leases/. When check_alive is true, stale leases
// belonging to exited PIDs are removed automatically.
agy_leases_load_disk :: (root: string, leases: [] AgyLeases, check_alive: bool) -> int {
  leases[0] = AgyLeases.{};
  db: [1024] u8; dir := agy_leases_dir(root, db[..]);
  if dir.count == 0 || fs_kind(dir) != FS_DIR { return 0; }
  list: [1] FsList;
  if fs_list(dir, list[..]) < 0 { return 0; }
  loaded := 0;
  for i: 0..<list[0].n {
    name := fs_entry(list[..], i);
    ridb: [64] u8;
    pid := agy_parse_lease_filename(name, ridb[..]);
    if pid <= 0 { continue; }
    rid := cast(string) ridb[0..<64];
    if check_alive && !agy_pid_alive(pid) {
      fpb: [1200] u8;
      fp := fs_join(dir, name, fpb[..]);
      if fp.count > 0 { _ = fs_remove(fp); }
      continue;
    }
    if agy_lease_acquire(leases, rid, pid) >= 0 { loaded += 1; }
  }
  return loaded;
}

// Prune inactive, unleased releases under <root>/releases/. Returns count removed.
agy_prune_disk :: (root: string, active_id: string, check_alive: bool) -> int {
  leases: [1] AgyLeases;
  _ = agy_leases_load_disk(root, leases[..], check_alive);
  rb: [1024] u8; rels := fs_join(root, "releases", rb[..]);
  if rels.count == 0 || fs_kind(rels) != FS_DIR { return 0; }
  list: [1] FsList;
  if fs_list(rels, list[..]) < 0 { return 0; }
  pruned := 0;
  for i: 0..<list[0].n {
    cand := fs_entry(list[..], i);
    if !agy_can_prune_release(leases[..], active_id, cand) { continue; }
    cb: [1200] u8; cp := fs_join(rels, cand, cb[..]);
    if cp.count > 0 && agy_remove_retry(cp) { pruned += 1; }
  }
  return pruned;
}

// Fetch the live Google Antigravity CLI manifest JSON for (os, arch, musl) via curl.
agy_fetch_manifest :: (os: string, arch: string, musl: bool, out_json: [] u8) -> string {
  ub: [256] u8; url := agy_manifest_url(os, arch, musl, ub[..]);
  if url.count == 0 { return ""; }
  argv := [3] string.["curl", "-fsSL", url];
  err: [1024] u8;
  r := proc_run(argv[..], 30000, out_json, err[..]);
  if r.started != 0 || r.status != 0 || r.out_n <= 0 { return ""; }
  return cast(string) out_json[0..<r.out_n];
}

// Locate the extracted agy executable inside extract_dir (direct or one level deep).
agy_find_extracted_exe :: (extract_dir: string, exe_name: string, out: [] u8) -> string {
  p := fs_join(extract_dir, exe_name, out);
  if p.count > 0 && fs_kind(p) == FS_FILE { return p; }
  alt := ifx exe_name == "antigravity" then "agy" else "antigravity";
  p = fs_join(extract_dir, alt, out);
  if p.count > 0 && fs_kind(p) == FS_FILE { return p; }
  list: [1] FsList;
  if fs_list(extract_dir, list[..]) < 0 { return ""; }
  for i: 0..<list[0].n {
    sub := fs_entry(list[..], i);
    sb: [1200] u8; sp := fs_join(extract_dir, sub, sb[..]);
    if sp.count == 0 || fs_kind(sp) != FS_DIR { continue; }
    p = fs_join(sp, exe_name, out);
    if p.count > 0 && fs_kind(p) == FS_FILE { return p; }
    p = fs_join(sp, alt, out);
    if p.count > 0 && fs_kind(p) == FS_FILE { return p; }
  }
  return "";
}

// Install and verify a managed agy release from manifest_json into root:
// 1. Validate manifest (>= 1.5.0 < 2.0.0, 128-hex SHA-512, pinned GCS URL).
// 2. Download artifact (or read artifact_override) and verify streaming SHA-512.
// 3. Extract into immutable <root>/releases/<release_id>/ and switch active.json atomically.
// 4. Prune unleased old versions without touching active or leased releases.
// Returns "" on success (writing installed exe path into out_exe), else an error message.
agy_install_from_manifest :: (
  root: string,
  manifest_json: string,
  os: string,
  arch: string,
  musl: bool,
  artifact_override: string,
  check_alive: bool,
  out_exe: [] u8
) -> string {
  rel: [1] AgyRelease;
  if !agy_parse_release(manifest_json, os, arch, musl, rel[..]) {
    return "invalid Antigravity CLI release manifest (requires >= 1.5.0 < 2.0.0, 128-hex sha512, and pinned GCS URL)";
  }
  sha_expect := cast(string) rel[0].sha512[0..<rel[0].nsha512];
  url := cast(string) rel[0].url[0..<rel[0].nurl];
  exe_name := cast(string) rel[0].exe[0..<rel[0].nexe];
  ridb: [80] u8; rid := agy_release_id_from_sha512(sha_expect, ridb[..]);
  if rid.count != 64 { return "failed to derive release ID"; }

  rel_root_b: [1024] u8; rel_root := fs_join(root, "releases", rel_root_b[..]);
  stg_root_b: [1024] u8; stg_root := fs_join(root, "staging", stg_root_b[..]);
  if !fs_mkdir_all(rel_root) || !fs_mkdir_all(stg_root) { return "failed to create managed agy directories"; }

  rdir_b: [1200] u8; rdir := agy_release_dir(root, rid, rdir_b[..]);
  exe_b: [1280] u8; target_exe := agy_managed_exe_path(root, rid, os == "windows", exe_b[..]);
  if rdir.count == 0 || target_exe.count == 0 { return "managed path overflow"; }

  if fs_kind(target_exe) != FS_FILE {
    dl_b: [1280] u8;
    dl_path := artifact_override;
    downloaded := false;
    if dl_path.count == 0 {
      dnb: [96] u8; dn := cl_copy(dnb[..], rid); dn += cl_copy(dnb[dn..<dnb.count], ".download");
      dl_path = fs_join(stg_root, cast(string) dnb[0..<dn], dl_b[..]);
      if dl_path.count == 0 { return "staging path overflow"; }
      _ = agy_remove_retry(dl_path);
      argv := [5] string.["curl", "-fsSL", "-o", dl_path, url];
      co: [1024] u8; ce: [1024] u8;
      r := proc_run(argv[..], 300000, co[..], ce[..]);
      if r.started != 0 || r.status != 0 {
        _ = agy_remove_retry(dl_path);
        return "failed to download Antigravity CLI release artifact";
      }
      downloaded = true;
    }

    got_hex_b: [128] u8;
    got_hex := agy_sha512_file_hex(dl_path, got_hex_b[..]);
    if got_hex != sha_expect {
      if downloaded { _ = agy_remove_retry(dl_path); }
      return "SHA-512 checksum mismatch for Antigravity CLI release artifact";
    }

    enb: [96] u8; en := cl_copy(enb[..], rid); en += cl_copy(enb[en..<enb.count], ".extract");
    ext_b: [1280] u8; ext_dir := fs_join(stg_root, cast(string) enb[0..<en], ext_b[..]);
    if ext_dir.count == 0 { return "extract path overflow"; }
    _ = agy_remove_retry(ext_dir);
    if !fs_mkdir_all(ext_dir) { return "failed to create staging extract directory"; }

    if rel[0].is_tar_gz {
      argv := [5] string.["tar", "-xzf", dl_path, "-C", ext_dir];
      to: [1024] u8; te: [1024] u8;
      tr := proc_run(argv[..], 120000, to[..], te[..]);
      if tr.started != 0 || tr.status != 0 {
        _ = agy_remove_retry(ext_dir);
        if downloaded { _ = agy_remove_retry(dl_path); }
        return "failed to extract Antigravity CLI tarball";
      }
      found_b: [1280] u8; found := agy_find_extracted_exe(ext_dir, exe_name, found_b[..]);
      if found.count == 0 {
        _ = agy_remove_retry(ext_dir);
        if downloaded { _ = agy_remove_retry(dl_path); }
        return "extracted archive does not contain Antigravity executable";
      }
      dest_in_ext_b: [1280] u8; dest_in_ext := fs_join(ext_dir, exe_name, dest_in_ext_b[..]);
      if found != dest_in_ext {
        if !agy_rename_retry(found, dest_in_ext) {
          _ = agy_remove_retry(ext_dir);
          if downloaded { _ = agy_remove_retry(dl_path); }
          return "failed to place extracted executable";
        }
      }
    } else {
      dest_in_ext_b: [1280] u8; dest_in_ext := fs_join(ext_dir, exe_name, dest_in_ext_b[..]);
      if downloaded || agy_under_dir(dl_path, stg_root) {
        if !agy_rename_retry(dl_path, dest_in_ext) {
          _ = agy_remove_retry(ext_dir);
          return "failed to stage Windows executable";
        }
        downloaded = false;
      } else {
        // Keep external --artifact inputs intact; copy in pure Coax so Windows needs no cp.
        if !agy_copy_file(dl_path, dest_in_ext) {
          _ = agy_remove_retry(ext_dir);
          return "failed to copy Windows executable";
        }
      }
    }
    if downloaded { _ = agy_remove_retry(dl_path); }

    _ = agy_remove_retry(rdir);
    if !agy_rename_retry(ext_dir, rdir) {
      _ = agy_remove_retry(ext_dir);
      return "failed to move release into immutable directory";
    }
  }

  // Verify downloaded live binary responds to ACP initialize with valid version & capabilities
  // before atomically flipping active.json (#14004). Skip for offline synthetic fixture overrides.
  if artifact_override.count == 0 {
    vh := proc_new();
    if vh >= 0 {
      defer { _ = proc_release(vh); }
      vok := proc_arg(vh, target_exe) && proc_arg(vh, "acp") && proc_arg(vh, "--stdio") && proc_env(vh, "AGY_CLI_DISABLE_AUTO_UPDATE=1");
      if vok && proc_start(vh) == 0 {
        init_req := "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":1,\"clientCapabilities\":{},\"clientInfo\":{\"name\":\"openagents\",\"version\":\"1.0\"}}}\n";
        _ = proc_send(vh, init_req);
        _ = proc_close_stdin(vh);
        vbuf: [16384] u8; vn := 0; vdead := proc_now_ms() + 10000;
        while proc_now_ms() < vdead {
          ln := cxproc_read_line(vh, 500);
          if ln == PROC_TIMEOUT { continue; }
          if ln < 0 { break; }
          if ln > 0 && ln <= vbuf.count {
            for bi: 0..<ln { vbuf[bi] = cast(u8) cxproc_line_byte(vh, bi); }
            line_s := cast(string) vbuf[0..<ln];
            res_s := cl_raw(line_s, "result");
            if res_s.count > 2 {
              vab: [4096] u8; var_a := [1] ClArena.[ClArena.{buf = vab[..]}];
              verr := agy_verify_init_result(res_s, var_a[..]);
              _ = proc_kill(vh, PROC_SIGKILL);
              _ = proc_wait(vh, 500);
              if verr.count > 0 {
                _ = agy_remove_retry(rdir);
                return verr;
              }
              vn = ln;
              break;
            }
          }
        }
        if vn == 0 { _ = proc_kill(vh, PROC_SIGKILL); _ = proc_wait(vh, 500); }
      }
    }
  }

  // Atomic active pointer switch via durable temp-file rename (#13839).
  ap_b: [1200] u8; ap := agy_active_pointer_path(root, ap_b[..]);
  af_b: [128] u8; af := agy_format_active_release(rid, af_b[..]);
  if ap.count == 0 || af.count == 0 || !fs_replace_durable(ap, af) {
    return "failed to switch active.json atomically";
  }

  _ = agy_prune_disk(root, rid, check_alive);

  if target_exe.count <= out_exe.count {
    _ = cl_copy(out_exe, target_exe);
  }
  return "";
}

agy_detect_arch :: (out: [] u8) -> string {
  argv := [2] string.["uname", "-m"];
  ob: [64] u8; eb: [64] u8;
  r := proc_run(argv[..], 5000, ob[..], eb[..]);
  if r.started == 0 && r.status == 0 && r.out_n > 0 {
    n := r.out_n;
    while n > 0 && ob[n - 1] <= 32 { n -= 1; }
    m := cast(string) ob[0..<n];
    if m == "arm64" || m == "aarch64" { return cast(string) out[0..<cl_copy(out, "arm64")]; }
    if m == "x86_64" || m == "amd64" { return cast(string) out[0..<cl_copy(out, "x64")]; }
  }
  return cast(string) out[0..<cl_copy(out, ifx tool_os() == TOOL_MAC then "arm64" else "x64")];
}

// Detect musl libc on Linux (Alpine / Void / static musl containers; #14004).
agy_detect_musl :: () -> bool {
  if tool_os() != TOOL_LINUX { return false; }
  if fs_exists("/etc/alpine-release") || fs_exists("/lib/ld-musl-x86_64.so.1") || fs_exists("/lib/ld-musl-aarch64.so.1") {
    return true;
  }
  argv := [2] string.["ldd", "--version"];
  ob: [256] u8; eb: [256] u8;
  r := proc_run(argv[..], 2000, ob[..], eb[..]);
  if r.started == 0 {
    if agy_has(cast(string) ob[0..<r.out_n], "musl") || agy_has(cast(string) eb[0..<r.err_n], "musl") {
      return true;
    }
  }
  return false;
}

agy_print :: (s: string) {
  print("%", s);
}


// The manifest's system name for this machine: "windows", "darwin" or "linux".
agy_host_os :: () -> string {
  o := tool_os();
  if o == 3 { return "windows"; }
  if o == TOOL_MAC { return "darwin"; }
  return "linux";
}

// This machine's CPU as the manifest names it ("x64" or "arm64"). Windows has no uname:
// its PROCESSOR_ARCHITECTURE (and PROCESSOR_ARCHITEW6432 under emulation) says it.
agy_host_arch :: (out: [] u8) -> string {
  if tool_os() == 3 {
    wb: [32] u8; w := proc_getenv("PROCESSOR_ARCHITEW6432", wb[..]);
    if w.count == 0 { w = proc_getenv("PROCESSOR_ARCHITECTURE", wb[..]); }
    a := ifx w == "ARM64" || w == "arm64" then "arm64" else "x64";
    return cast(string) out[0..<cl_copy(out, a)];
  }
  return agy_detect_arch(out);
}

// Install (or reuse) the newest managed agy for this machine under HOME's managed root:
// "" and its path in out_exe, else why not.
agy_install_latest :: (out_exe: [] u8) -> string {
  hb: [4096] u8; home := proc_getenv("HOME", hb[..]);
  if home.count == 0 { home = proc_getenv("USERPROFILE", hb[..]); }
  rb: [4200] u8; root := agy_managed_root(home, rb[..]);
  if root.count == 0 { return "could not find the home folder to install the Antigravity CLI in"; }
  os := agy_host_os();
  ab: [16] u8; arch := agy_host_arch(ab[..]);
  musl := agy_detect_musl();
  mb: [8192] u8; mjson := agy_fetch_manifest(os, arch, musl, mb[..]);
  if mjson.count == 0 { return "could not reach Google's Antigravity CLI release list (check the internet connection)"; }
  err := agy_install_from_manifest(root, mjson, os, arch, musl, "", true, out_exe);
  if err.count > 0 { return err; }
  ap_b: [4260] u8; ap := agy_active_pointer_path(root, ap_b[..]);
  fb: [512] u8; fn := fs_read(ap, fb[..]);
  idb: [80] u8; rid := ifx fn > 0 then agy_parse_active_release(cast(string) fb[0..<fn], idb[..]) else "";
  if rid.count == 0 { return "the Antigravity CLI installed but its active release could not be read"; }
  ep_b: [4300] u8; ep := agy_managed_exe_path(root, rid, os == "windows", ep_b[..]);
  if ep.count == 0 || ep.count > out_exe.count { return "the Antigravity CLI's path did not fit"; }
  _ = cl_copy(out_exe, ep);
  return "";
}
