// The Antigravity engine: Google's Antigravity CLI (`agy acp`), driven as the
// ACP engine (cursor.coax, cue_*) with Antigravity's own CuAgent, one session
// per conversation (GitHub #13192). What differs from Cursor is here; the
// protocol, the held first message and the closing are the shared engine's.
//
//   agy_agent      the agent: `agy acp`, no authenticate (agy signs in on
//                  its own: Google, a Gemini key, or Application Default
//                  Credentials), session/resume (no replayed history)
//   agy_program    where agy is: PATH, then ~/.local/bin/agy (its installer's place)
//   agy_launch     agy started with the credentials file's variables
//   agy_configure  the owner's model, effort and mode for the opened session
//   agy_signed_out whether a refusal means agy is not signed in
//   agy_outside    a tool's Antigravity-named paths (rawInput Path, Cwd, ...) with ".."
//
// Credentials: Coder passes its own environment through. Besides, the file
// ~/.openagents/coder/antigravity.env names Google Cloud sign-in for agy, one
// NAME=value a line ('#' comments): AGY_ADC_AUTH, GOOGLE_APPLICATION_CREDENTIALS
// (a path to the key, never the key), GOOGLE_CLOUD_PROJECT and
// GOOGLE_CLOUD_LOCATION. Other names are ignored, and a variable already set
// in Coder's environment wins over the file.
//
// Modes: Coder answers every permission itself (its policy, --ask, or the
// session's trust), so the session runs in agy's `default` mode, where edits
// and commands are asked; a resumed session in another mode is set back.

#load "cursor.coax";
#load "../../sys/fs.coax";

AGY_INSTALL :: "curl -fsSL https://antigravity.google/cli/install.sh | bash";
AGY_MISSING :: "The Antigravity CLI (agy) was not found. Install it with: curl -fsSL https://antigravity.google/cli/install.sh | bash";
AGY_OLD_VERSION :: "The Antigravity CLI (agy) is too old (requires >= 1.5.0). Upgrade it with: curl -fsSL https://antigravity.google/cli/install.sh | bash";
AGY_SIGNED_OUT :: "Antigravity is not signed in. Run agy once to sign in, or name Google Cloud credentials in ~/.openagents/coder/antigravity.env (AGY_ADC_AUTH=1, GOOGLE_APPLICATION_CREDENTIALS=PATH, GOOGLE_CLOUD_PROJECT=ID).";
AGY_SIGNIN_REQUIRED :: "Sign in to Antigravity in Settings → Providers before you continue.";
AGY_ENV_FILE :: "/.openagents/coder/antigravity.env";
AGY_ENV_NAMES :: [4] string.["AGY_ADC_AUTH", "GOOGLE_APPLICATION_CREDENTIALS", "GOOGLE_CLOUD_PROJECT", "GOOGLE_CLOUD_LOCATION"];
AGY_MODE :: "default";
AGY_MODE_AUTO :: "auto";
AGY_APP_DATA_DIR :: "antigravity-acp";
AGY_APP_DATA_NATIVE :: "antigravity";
AGY_VERSION_PREFIX :: "agy_acp_server_";
AGY_MODEL_NOT_APPLIED :: 1; AGY_EFFORT_NOT_APPLIED :: 2;
AGY_MANIFEST_BASE :: "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests";
AGY_STORAGE_PREFIX :: "https://storage.googleapis.com/antigravity-public/antigravity-cli/";
AGY_MANAGED_SUBDIR :: "/.openagents/runtimes/agy";
AGY_MAX_LEASES :: 32;
AGY_BG_HOLD_MS :: 1800000;   // 30 minutes (T3 AntigravityAdapterV2)

// T3 Antigravity authentication methods (antigravityAuthSupport.ts / contracts/settings.ts).
AGY_AUTH_OAUTH_PERSONAL :: "oauth-personal";
AGY_AUTH_OAUTH_BUSINESS :: "oauth-business";
AGY_AUTH_GEMINI_API_KEY :: "gemini-api-key";
AGY_AUTH_AGENT_PLATFORM :: "agent-platform";

// Exact 19 ambient environment variables stripped by T3 antigravityAuthSupport.ts so isolated
// profiles never leak ambient Google/GCP/Gemini credentials or XDG overrides.
AGY_REMOVED_ENV_COUNT :: 19;
AGY_REMOVED_ENV_KEYS :: [AGY_REMOVED_ENV_COUNT] string.[
  "GEMINI_API_KEY",
  "GOOGLE_API_KEY",
  "GOOGLE_GENAI_USE_VERTEXAI",
  "GOOGLE_CLOUD_PROJECT",
  "GOOGLE_CLOUD_LOCATION",
  "GOOGLE_APPLICATION_CREDENTIALS",
  "CLOUDSDK_CORE_PROJECT",
  "CLOUDSDK_CONFIG",
  "ANTIGRAVITY_API_KEY",
  "ANTIGRAVITY_AUTH_METHOD",
  "ANTIGRAVITY_PROFILE",
  "AGY_PROFILE",
  "GEMINI_CLI_HOME",
  "GEMINI_CONFIG_DIR",
  "XDG_CONFIG_HOME",
  "XDG_DATA_HOME",
  "XDG_CACHE_HOME",
  "SSH_CLIENT",
  "SSH_TTY"
];

AgyAuthConfig :: struct {
  method: string;
  api_key: string;
  gcp_project: string;
  gcp_location: string;
  skip_permissions: bool;
  app_data_dir: string;
  process_per_session: bool;
}

agy_auth_normalize :: (raw: string) -> string {
  if raw == AGY_AUTH_OAUTH_BUSINESS { return AGY_AUTH_OAUTH_BUSINESS; }
  if raw == AGY_AUTH_GEMINI_API_KEY { return AGY_AUTH_GEMINI_API_KEY; }
  if raw == AGY_AUTH_AGENT_PLATFORM { return AGY_AUTH_AGENT_PLATFORM; }
  return AGY_AUTH_OAUTH_PERSONAL;
}

agy_auth_uses_browser :: (method: string) -> bool {
  m := agy_auth_normalize(method);
  return m == AGY_AUTH_OAUTH_PERSONAL || m == AGY_AUTH_OAUTH_BUSINESS;
}

agy_auth_label :: (method: string) -> string {
  m := agy_auth_normalize(method);
  if m == AGY_AUTH_OAUTH_BUSINESS { return "Gemini Enterprise"; }
  if m == AGY_AUTH_GEMINI_API_KEY { return "Gemini API key"; }
  if m == AGY_AUTH_AGENT_PLATFORM { return "Agent Platform (Vertex AI)"; }
  return "Google account";
}

// Validate auth configuration (exact port of T3 antigravityAuthConfigIssue).
// Returns "" when valid, else an actionable message.
agy_auth_config_issue :: (cfg: AgyAuthConfig) -> string {
  m := agy_auth_normalize(cfg.method);
  if m == AGY_AUTH_OAUTH_PERSONAL { return ""; }
  if m == AGY_AUTH_OAUTH_BUSINESS {
    if cfg.gcp_project.count == 0 { return "Enter a GCP project for Gemini Enterprise."; }
    if cfg.gcp_location.count == 0 { return "Enter a GCP location for Gemini Enterprise."; }
    return "";
  }
  if m == AGY_AUTH_GEMINI_API_KEY {
    if cfg.api_key.count == 0 { return "Enter an API key for Gemini API key sign-in."; }
    return "";
  }
  // agent-platform: either express API key OR GCP project + location (gcloud ADC)
  if cfg.api_key.count > 0 { return ""; }
  if cfg.gcp_project.count == 0 { return "Enter an API key or a GCP project for Agent Platform."; }
  if cfg.gcp_location.count == 0 { return "Enter an API key or a GCP location for Agent Platform."; }
  return "";
}

// Format <profile>/antigravity-acp/settings.json content (exact T3 writeAntigravitySettings schema).
agy_format_settings_json :: (cfg: AgyAuthConfig, out: [] u8) -> string {
  o := [1] ClOut.[ClOut.{buf = out}];
  m := agy_auth_normalize(cfg.method);
  cl_put(o[..], "{\"auth\":{\"type\":");
  cl_put_string(o[..], m);
  cl_put(o[..], "}");
  need_gcp := m == AGY_AUTH_OAUTH_BUSINESS || (m == AGY_AUTH_AGENT_PLATFORM && cfg.api_key.count == 0);
  if need_gcp && (cfg.gcp_project.count > 0 || cfg.gcp_location.count > 0) {
    cl_put(o[..], ",\"gcp\":{");
    wrote := false;
    if cfg.gcp_project.count > 0 {
      cl_put(o[..], "\"project\":");
      cl_put_string(o[..], cfg.gcp_project);
      wrote = true;
    }
    if cfg.gcp_location.count > 0 {
      if wrote { cl_put(o[..], ","); }
      cl_put(o[..], "\"location\":");
      cl_put_string(o[..], cfg.gcp_location);
    }
    cl_put(o[..], "}");
  }
  cl_put(o[..], "}\n");
  if o[0].failed { return ""; }
  return cast(string) out[0..<o[0].len];
}

// Materialize <profile>/antigravity-acp/settings.json durably on disk.
agy_write_settings_json :: (profile_dir: string, cfg: AgyAuthConfig) -> bool {
  if profile_dir.count == 0 { return false; }
  db: [1200] u8; acp_dir := fs_join(profile_dir, AGY_APP_DATA_DIR, db[..]);
  if acp_dir.count == 0 || !fs_mkdir_all(acp_dir) { return false; }
  sb: [1280] u8; spath := fs_join(acp_dir, "settings.json", sb[..]);
  if spath.count == 0 { return false; }
  jb: [2048] u8; content := agy_format_settings_json(cfg, jb[..]);
  if content.count == 0 { return false; }
  return fs_replace_durable(spath, content);
}

// Prepare CuLaunch with full T3 Antigravity auth method, 19-key sanitization, and profile isolation.
agy_prepare_launch_auth :: (l: [] CuLaunch, e: [] AgyEnv, program: string, cwd: string, profile_dir: string, cfg: AgyAuthConfig) {
  l[0] = CuLaunch.{};
  l[0].program = program; l[0].cwd = cwd;
  m := agy_auth_normalize(cfg.method);
  if !agy_env_has(e, "AGY_CLI_DISABLE_AUTO_UPDATE") {
    agy_env_push(e, "AGY_CLI_DISABLE_AUTO_UPDATE=1");
  }
  if !agy_env_has(e, "AGY_ACP_FORCE_FILE_STORAGE") {
    agy_env_push(e, "AGY_ACP_FORCE_FILE_STORAGE=1");
  }
  if profile_dir.count > 0 {
    l[0].args[0] = "--gemini-dir";
    l[0].args[1] = profile_dir;
    l[0].args[2] = "--app-data-dir";
    l[0].args[3] = ifx cfg.app_data_dir.count > 0 then cfg.app_data_dir else AGY_APP_DATA_DIR;
    l[0].args_n = 4;
    if !agy_env_has(e, "GEMINI_HOME") {
      agy_env_push_kv(e, "GEMINI_HOME", profile_dir);
    }
  } else if cfg.app_data_dir.count > 0 && l[0].args_n + 2 <= l[0].args.count {
    l[0].args[l[0].args_n] = "--app-data-dir";
    l[0].args[l[0].args_n + 1] = cfg.app_data_dir;
    l[0].args_n += 2;
  }
  if cfg.skip_permissions && l[0].args_n < l[0].args.count {
    l[0].args[l[0].args_n] = "--dangerously-skip-permissions";
    l[0].args_n += 1;
  }
  if cfg.process_per_session && l[0].args_n < l[0].args.count {
    l[0].args[l[0].args_n] = "--process-per-session";
    l[0].args_n += 1;
  }
  // Strip all 19 ambient Google/GCP/Gemini/XDG/SSH variables (T3 removedEnvironmentKeys).
  rem := AGY_REMOVED_ENV_KEYS;
  for i: 0..<AGY_REMOVED_ENV_COUNT {
    if l[0].unset_n < l[0].unset.count {
      l[0].unset[l[0].unset_n] = rem[i];
      l[0].unset_n += 1;
    }
  }
  // SSH_CONNECTION suppresses surprise macOS `open` browser spawns on browser-based auth methods
  // during background probes and chat sessions; strip it for non-browser credential methods.
  if agy_auth_uses_browser(m) {
    if !agy_env_has(e, "SSH_CONNECTION") {
      agy_env_push(e, "SSH_CONNECTION=127.0.0.1 0 127.0.0.1 0");
    }
  } else {
    if l[0].unset_n < l[0].unset.count {
      l[0].unset[l[0].unset_n] = "SSH_CONNECTION";
      l[0].unset_n += 1;
    }
  }
  // Inject API key for the matching auth method (never logged).
  if m == AGY_AUTH_GEMINI_API_KEY && cfg.api_key.count > 0 {
    agy_env_push_kv(e, "GEMINI_API_KEY", cfg.api_key);
  } else if m == AGY_AUTH_AGENT_PLATFORM && cfg.api_key.count > 0 {
    agy_env_push_kv(e, "GOOGLE_API_KEY", cfg.api_key);
  }
  for i: 0..<e[0].nvars {
    if i < l[0].env.count { l[0].env[i] = e[0].vars[i]; }
  }
  l[0].env_n = ifx e[0].nvars < l[0].env.count then e[0].nvars else l[0].env.count;
}

agy_agent_with_auth :: (auth_method: string) -> CuAgent {
  a := agy_agent();
  if auth_method.count > 0 { a.login = agy_auth_normalize(auth_method); }
  return a;
}

// Launch agy with full T3 auth config: writes settings.json, sanitizes all 19 ambient env vars,
// authenticates eagerly with the configured authMethodId, and sets the 30-minute background hold.
agy_launch_auth :: (x: [] CuEngine, program: string, cwd: string, name: string, version: string, profile_dir: string, cfg: AgyAuthConfig) -> string {
  m := agy_auth_normalize(cfg.method);
  if profile_dir.count > 0 { _ = agy_write_settings_json(profile_dir, cfg); }
  cue_agent(x, agy_agent_with_auth(m));
  e: [1] AgyEnv;
  l: [1] CuLaunch;
  agy_prepare_launch_auth(l[..], e[..], program, cwd, profile_dir, cfg);
  _ = agy_wrap_windows_cmd(l[..]);
  why := cue_start(x, l[0], name, version);
  if why.count == 0 {
    cue_set_bg_hold_limit(x, AGY_BG_HOLD_MS);
    stb: [32] u8; rb: [32] u8;
    w := agy_watch_limits(cl_getenv("CODER_AGY_STALL_S", stb[..]), cl_getenv("CODER_AGY_RECOVER", rb[..]));
    cue_watch_set(x, w.stall_ms, w.recoveries);
  }
  return why;
}

agy_agent :: () -> CuAgent {
  a: [1] CuAgent;
  a[0].name = "agy"; a[0].program = "agy"; a[0].login = ""; a[0].resume = CU_SESSION_RESUME;
  a[0].defer_finalize_background = true; a[0].steers_with_prompt = true;
  return a[0];
}

agy_on_path_sep :: (path_env: string, sep: u8, name: string, out: [] u8) -> string {
  at := 0;
  while at <= path_env.count {
    e := at; while e < path_env.count && path_env[e] != sep { e += 1; }
    if e > at {
      dir := cast(string) path_env[at..<e];
      joined := fs_join(dir, name, out);
      if joined.count > 0 && fs_exists(joined) { return joined; }
    }
    at = e + 1;
  }
  return "";
}

// agy on PATH (POSIX `:` or Windows `;` with .exe/.cmd/.bat), else managed
// ~/.openagents/runtimes/agy/active.json, else HOME/.local/bin/agy.
agy_find :: (path_env: string, home: string, out: [] u8) -> string {
  found := cu_on_path(path_env, "agy", out);
  if found.count > 0 { return found; }
  // Windows PATH entries separated by ';' with .exe / .cmd / .bat launchers (#13839)
  has_semi := false;
  for c: path_env { if c == ';' { has_semi = true; break; } }
  if has_semi {
    win_names := [3] string.["agy.exe", "agy.cmd", "agy.bat"];
    for wn: win_names {
      wf := agy_on_path_sep(path_env, ';', wn, out);
      if wf.count > 0 { return wf; }
    }
  }
  if home.count == 0 || home.count > 4000 { return ""; }
  // Managed versioned installation under ~/.openagents/runtimes/agy/active.json (#13839)
  rb: [4200] u8; root := agy_managed_root(home, rb[..]);
  if root.count > 0 {
    ab: [4260] u8; ap := agy_active_pointer_path(root, ab[..]);
    fb: [512] u8; fn := fs_read(ap, fb[..]);
    if fn > 0 {
      idb: [80] u8; rid := agy_parse_active_release(cast(string) fb[0..<fn], idb[..]);
      if rid.count == 64 {
        eb: [4300] u8; ep := agy_managed_exe_path(root, rid, false, eb[..]);
        if ep.count > 0 && ep.count <= out.count && fs_exists(ep) {
          return cast(string) out[0..<cl_copy(out, ep)];
        }
        epw := agy_managed_exe_path(root, rid, true, eb[..]);
        if epw.count > 0 && epw.count <= out.count && fs_exists(epw) {
          return cast(string) out[0..<cl_copy(out, epw)];
        }
      }
    }
  }
  n := cl_copy(out, home); n += cl_copy(out[n..<out.count], "/.local/bin/agy");
  if n >= out.count || !fs_exists(cast(string) out[0..<n]) { return ""; }
  return cast(string) out[0..<n];
}
agy_program :: (out: [] u8) -> string {
  pb: [8192] u8; path := cl_getenv("PATH", pb[..]);
  hb: [4096] u8; home := cl_getenv("HOME", hb[..]);
  if home.count == 0 { home = cl_getenv("USERPROFILE", hb[..]); }
  return agy_find(path, home, out);
}

// ---------------------------------------------------------------- the credentials file

AgyEnv :: struct {
  buf: [4096] u8; n: int;
  vars: [CU_ENV] string; nvars: int;     // NAME=value, into buf
}

agy_env_name_ok :: (name: string) -> bool {
  names := AGY_ENV_NAMES;
  for k: names { if k == name { return true; } }
  return false;
}

// The file's lines kept in e: the allowed names with a value, the first of each name.
agy_env_parse :: (text: string, e: [] AgyEnv) {
  at := 0;
  while at < text.count {
    end := at; while end < text.count && text[end] != 10 { end += 1; }
    line := cast(string) text[at..<end]; at = end + 1;
    s := 0; t := line.count;
    while s < t && (line[s] == ' ' || line[s] == 9) { s += 1; }
    while t > s && (line[t - 1] == ' ' || line[t - 1] == 9 || line[t - 1] == 13) { t -= 1; }
    if s == t || line[s] == '#' { continue; }
    eq := s; while eq < t && line[eq] != '=' { eq += 1; }
    if eq == t || eq + 1 == t { continue; }
    name := cast(string) line[s..<eq];
    if !agy_env_name_ok(name) || agy_env_has(e, name) || e[0].nvars >= CU_ENV { continue; }
    if e[0].n + (t - s) > e[0].buf.count { continue; }
    from := e[0].n;
    e[0].n += cl_copy(e[0].buf[from..<e[0].buf.count], cast(string) line[s..<t]);
    e[0].vars[e[0].nvars] = cast(string) e[0].buf[from..<e[0].n]; e[0].nvars += 1;
  }
}
agy_env_has :: (e: [] AgyEnv, name: string) -> bool {
  for i: 0..<e[0].nvars {
    v := e[0].vars[i];
    if v.count > name.count && cast(string) v[0..<name.count] == name && v[name.count] == '=' { return true; }
  }
  return false;
}

// HOME's credentials file into e, less the names Coder's own environment sets. Whether a file was read.
agy_env_load :: (e: [] AgyEnv) -> bool {
  e[0].n = 0; e[0].nvars = 0;
  hb: [4096] u8; home := cl_getenv("HOME", hb[..]);
  if home.count == 0 || home.count > 4000 { return false; }
  pb: [4200] u8; pn := cl_copy(pb[..], home); pn += cl_copy(pb[pn..<pb.count], AGY_ENV_FILE);
  fb: [4096] u8; n := fs_read(cast(string) pb[0..<pn], fb[..]);
  if n <= 0 { return false; }
  all: [1] AgyEnv; agy_env_parse(cast(string) fb[0..<n], all[..]);
  for i: 0..<all[0].nvars {
    v := all[0].vars[i];
    eq := 0; while eq < v.count && v[eq] != '=' { eq += 1; }
    vb: [8] u8;
    if cl_getenv(cast(string) v[0..<eq], vb[..]).count > 0 { continue; }   // Coder's own environment wins
    from := e[0].n;
    e[0].n += cl_copy(e[0].buf[from..<e[0].buf.count], v);
    e[0].vars[e[0].nvars] = cast(string) e[0].buf[from..<e[0].n]; e[0].nvars += 1;
  }
  return true;
}

agy_env_push :: (e: [] AgyEnv, entry: string) {
  if entry.count == 0 || e[0].nvars >= CU_ENV || e[0].n + entry.count > e[0].buf.count { return; }
  from := e[0].n;
  e[0].n += cl_copy(e[0].buf[from..<e[0].buf.count], entry);
  e[0].vars[e[0].nvars] = cast(string) e[0].buf[from..<e[0].n];
  e[0].nvars += 1;
}

agy_env_push_kv :: (e: [] AgyEnv, key: string, value: string) {
  need := key.count + 1 + value.count;
  if key.count == 0 || value.count == 0 || e[0].nvars >= CU_ENV || e[0].n + need > e[0].buf.count { return; }
  from := e[0].n;
  e[0].n += cl_copy(e[0].buf[from..<e[0].buf.count], key);
  e[0].buf[e[0].n] = '='; e[0].n += 1;
  e[0].n += cl_copy(e[0].buf[e[0].n..<e[0].buf.count], value);
  e[0].vars[e[0].nvars] = cast(string) e[0].buf[from..<e[0].n];
  e[0].nvars += 1;
}

// Prepare CuLaunch with credentials, AGY_CLI_DISABLE_AUTO_UPDATE=1, and optional
// isolated profile flags (--gemini-dir <dir> --app-data-dir antigravity-acp) and env.
agy_prepare_launch :: (l: [] CuLaunch, e: [] AgyEnv, program: string, cwd: string, profile_dir: string, has_auto_update: bool, has_gemini_home: bool, has_ssh_conn: bool) {
  l[0] = CuLaunch.{};
  l[0].program = program; l[0].cwd = cwd;
  if !has_auto_update && !agy_env_has(e, "AGY_CLI_DISABLE_AUTO_UPDATE") {
    agy_env_push(e, "AGY_CLI_DISABLE_AUTO_UPDATE=1");
  }
  if profile_dir.count > 0 {
    l[0].args[0] = "--gemini-dir";
    l[0].args[1] = profile_dir;
    l[0].args[2] = "--app-data-dir";
    l[0].args[3] = AGY_APP_DATA_DIR;
    l[0].args_n = 4;
    if !agy_env_has(e, "AGY_ACP_FORCE_FILE_STORAGE") {
      agy_env_push(e, "AGY_ACP_FORCE_FILE_STORAGE=1");
    }
    if !has_gemini_home && !agy_env_has(e, "GEMINI_HOME") {
      agy_env_push_kv(e, "GEMINI_HOME", profile_dir);
    }
    if !has_ssh_conn && !agy_env_has(e, "SSH_CONNECTION") {
      agy_env_push(e, "SSH_CONNECTION=127.0.0.1 0 127.0.0.1 0");
    }
    // Strip all 19 ambient Google/GCP/Gemini/XDG/SSH variables so an isolated OAuth profile
    // cannot inherit ambient credentials, matching agy_prepare_launch_auth (#13995).
    rem := AGY_REMOVED_ENV_KEYS;
    for i: 0..<AGY_REMOVED_ENV_COUNT {
      if l[0].unset_n < l[0].unset.count {
        l[0].unset[l[0].unset_n] = rem[i];
        l[0].unset_n += 1;
      }
    }
  }
  for i: 0..<e[0].nvars { l[0].env[i] = e[0].vars[i]; }
  l[0].env_n = e[0].nvars;
}

// Prepare an isolated `agy acp ... --login` launch with DISPLAY/WAYLAND_DISPLAY stripped so
// agy prints the Google OAuth URL to stdout instead of opening a browser (#13837).
agy_prepare_login :: (l: [] CuLaunch, e: [] AgyEnv, program: string, cwd: string, profile_dir: string) {
  agy_prepare_launch(l, e, program, cwd, profile_dir, false, false, false);
  if l[0].args_n < l[0].args.count { l[0].args[l[0].args_n] = "--login"; l[0].args_n += 1; }
  if l[0].unset_n + 2 <= l[0].unset.count {
    l[0].unset[l[0].unset_n] = "DISPLAY"; l[0].unset_n += 1;
    l[0].unset[l[0].unset_n] = "WAYLAND_DISPLAY"; l[0].unset_n += 1;
  }
}

// Extract and validate an https://accounts.google.com/... OAuth URL from `agy --login` output (#13837).
AGY_OAUTH_PREFIX :: "https://accounts.google.com/";
agy_parse_oauth_url :: (text: string, out: [] u8) -> string {
  if text.count < AGY_OAUTH_PREFIX.count { return ""; }
  start := -1;
  for i: 0..<text.count - AGY_OAUTH_PREFIX.count + 1 {
    if cast(string) text[i..<i + AGY_OAUTH_PREFIX.count] == AGY_OAUTH_PREFIX { start = i; break; }
  }
  if start < 0 { return ""; }
  end := start;
  while end < text.count && text[end] > 32 && text[end] != '"' && text[end] != '\'' && text[end] != ')' && text[end] != '>' {
    end += 1;
  }
  url := cast(string) text[start..<end];
  if url.count <= AGY_OAUTH_PREFIX.count || url.count > out.count { return ""; }
  return cast(string) out[0..<cl_copy(out, url)];
}

// Validate a loopback OAuth callback URL (http://127.0.0.1:... or http://localhost:... with code=) (#13837).
agy_validate_callback_url :: (url: string) -> bool {
  if url.count < 16 { return false; }
  is_v4 := url.count >= 17 && cast(string) url[0..<17] == "http://127.0.0.1:";
  is_lh := url.count >= 17 && cast(string) url[0..<17] == "http://localhost:";
  if !is_v4 && !is_lh { return false; }
  return s_has(url, "code=");
}

// Drain running Antigravity processes and clear session state on sign-out (#13837).
agy_signout_drain :: (x: [] CuEngine) {
  if x[0].live { cue_close(x); }
  x[0].nresume = 0;
  x[0].last_session_n = 0;
  x[0].restart_required = false;
  x[0].ready = false;
}

// True when a path starts with "~/" (agy does not tilde-expand skills.json entries; #14024).
agy_is_tilde_path :: (p: string) -> bool {
  return p.count >= 2 && p[0] == '~' && (p[1] == '/' || p[1] == '\\');
}

// Extract a skill name from a file-listed skill entry (e.g. "/path/to/my-skill/SKILL.md" -> "my-skill",
// "/path/to/review.md" -> "review"), skipping "~/" entries (#14024).
agy_skill_name_from_path :: (p: string) -> string {
  if p.count == 0 || agy_is_tilde_path(p) { return ""; }
  end := p.count;
  while end > 0 && (p[end - 1] == '/' || p[end - 1] == '\\') { end -= 1; }
  if end == 0 { return ""; }
  slash := -1;
  for i: 0..<end { if p[i] == '/' || p[i] == '\\' { slash = i; } }
  base := cast(string) p[(slash + 1)..<end];
  if base == "SKILL.md" || base == "skill.md" {
    if slash <= 0 { return ""; }
    p_end := slash;
    while p_end > 0 && (p[p_end - 1] == '/' || p[p_end - 1] == '\\') { p_end -= 1; }
    p_slash := -1;
    for i: 0..<p_end { if p[i] == '/' || p[i] == '\\' { p_slash = i; } }
    return cast(string) p[(p_slash + 1)..<p_end];
  }
  if base.count > 3 && cast(string) base[(base.count - 3)..<base.count] == ".md" {
    return cast(string) base[0..<(base.count - 3)];
  }
  return base;
}

// Literal filter check for skills.json include_only / exclude lists (#14024):
// - null / absent include_only allows all; explicit [] allows none
// - null / absent exclude excludes none
// - matching is strictly literal (exact string equality, no glob/regex)
agy_skill_allowed :: (name: string, include_only_json: string, exclude_json: string, ar: [] ClArena) -> bool {
  if name.count == 0 { return false; }
  if exclude_json.count > 0 && exclude_json != "null" && exclude_json[0] == '[' {
    ne := cl_count(exclude_json);
    for i: 0..<ne {
      v := cl_text(ar, exclude_json, cl_item(exclude_json, i));
      if v == name { return false; }
    }
  }
  if include_only_json.count > 0 && include_only_json != "null" && include_only_json[0] == '[' {
    ni := cl_count(include_only_json);
    for i: 0..<ni {
      v := cl_text(ar, include_only_json, cl_item(include_only_json, i));
      if v == name { return true; }
    }
    return false;
  }
  return true;
}

// Parse skill names from a skills.json file ({"skills":[...], "files":[...], "include_only":..., "exclude":...}
// or top-level array). Handles null lists, skips "~/" entries, supports file-listed skills, and applies
// literal include_only/exclude filters (#13837, #14024).
agy_parse_skills_json :: (json: string, ar: [] ClArena, out_names: [] u8) -> int {
  inc_raw := cl_raw(json, "include_only");
  exc_raw := cl_raw(json, "exclude");
  used := 0;
  skills_raw := cl_raw(json, "skills");
  files_raw := cl_raw(json, "files");
  // If top-level is an array (no "skills"/"files" key), treat json itself as the list.
  i0 := 0;
  while i0 < json.count && json[i0] <= 32 { i0 += 1; }
  top_is_arr := i0 < json.count && json[i0] == '[';
  arr := ifx skills_raw.count > 0 then skills_raw else ifx top_is_arr then json else "";
  if arr.count > 0 && arr != "null" && arr[0] == '[' {
    n := cl_count(arr);
    for i: 0..<n {
      sl := cl_item(arr, i);
      item := cl_json(arr, sl);
      name := "";
      if item.count > 0 && item[0] == '"' {
        raw_s := cl_text(ar, arr, sl);
        if agy_is_tilde_path(raw_s) { continue; }
        name = agy_skill_name_from_path(raw_s);
      } else {
        raw_path := cl_str(ar, item, "path");
        if raw_path.count == 0 { raw_path = cl_str(ar, item, "file"); }
        if raw_path.count > 0 && agy_is_tilde_path(raw_path) { continue; }
        name = cl_str(ar, item, "name");
        if name.count == 0 && raw_path.count > 0 { name = agy_skill_name_from_path(raw_path); }
        if agy_is_tilde_path(name) { continue; }
      }
      if name.count == 0 || !agy_skill_allowed(name, inc_raw, exc_raw, ar) { continue; }
      need := name.count + (ifx used > 0 then 1 else 0);
      if used + need > out_names.count { break; }
      if used > 0 { out_names[used] = '\n'; used += 1; }
      used += cl_copy(out_names[used..<out_names.count], name);
    }
  }
  if files_raw.count > 0 && files_raw != "null" && files_raw[0] == '[' {
    nf := cl_count(files_raw);
    for i: 0..<nf {
      sl := cl_item(files_raw, i);
      item := cl_json(files_raw, sl);
      raw_s := ifx item.count > 0 && item[0] == '"' then cl_text(ar, files_raw, sl) else cl_str(ar, item, "path");
      if raw_s.count == 0 || agy_is_tilde_path(raw_s) { continue; }
      name := agy_skill_name_from_path(raw_s);
      if name.count == 0 || !agy_skill_allowed(name, inc_raw, exc_raw, ar) { continue; }
      need := name.count + (ifx used > 0 then 1 else 0);
      if used + need > out_names.count { break; }
      if used > 0 { out_names[used] = '\n'; used += 1; }
      used += cl_copy(out_names[used..<out_names.count], name);
    }
  }
  return used;
}

// True when a filename is an Antigravity SQLite index database that must be skipped during
// local usage/history aggregation so partial/corrupted index rows are never reported (#13838).
agy_is_index_db :: (name: string) -> bool {
  if name.count == 0 { return false; }
  // Strip leading directory components
  s := 0;
  for i: 0..<name.count { if name[i] == '/' || name[i] == '\\' { s = i + 1; } }
  base := cast(string) name[s..<name.count];
  if base == "index.db" || base == "index.db-wal" || base == "index.db-shm" || base == "index.sqlite" || base == "index.sqlite3" { return true; }
  if base.count > 9 && cast(string) base[base.count - 9..<base.count] == "-index.db" { return true; }
  if base.count > 9 && cast(string) base[base.count - 9..<base.count] == ".index.db" { return true; }
  if base.count > 13 && cast(string) base[base.count - 13..<base.count] == "-index.db-wal" { return true; }
  if base.count > 13 && cast(string) base[base.count - 13..<base.count] == "-index.db-shm" { return true; }
  return false;
}

// Read-only extraction of `token.access_token` (or top-level `access_token`) from an
// Antigravity 1.5.x `antigravity-oauth-token` JSON blob. Wipes scratch memory immediately;
// never mutates or logs the token (#13838).
agy_read_cli_token :: (blob: string, out: [] u8) -> string {
  if blob.count == 0 { return ""; }
  ab: [16384] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  tok := cl_str(ar[..], blob, "token.access_token");
  if tok.count == 0 { ar[0].at = 0; tok = cl_str(ar[..], blob, "access_token"); }
  n := 0;
  if tok.count > 0 && tok.count <= out.count { n = cl_copy(out, tok); }
  for i: 0..<ab.count { ab[i] = 0; }
  return cast(string) out[0..<n];
}

// Pure path builder for the Antigravity 1.5.x file-backed OAuth token (#13838).
agy_token_path_join :: (home: string, profile_dir: string, use_acp: bool, out: [] u8) -> string {
  if profile_dir.count > 0 {
    b: [1024] u8; p := fs_join(profile_dir, AGY_APP_DATA_DIR, b[..]);
    return fs_join(p, "antigravity-oauth-token", out);
  }
  if home.count == 0 { return ""; }
  return fs_join(home, ifx use_acp then ".gemini/antigravity-acp/antigravity-oauth-token" else ".gemini/antigravity-cli/antigravity-oauth-token", out);
}

// Resolve the Antigravity 1.5.x file-backed OAuth token path for a profile or default home (#13838).
agy_token_path :: (home: string, profile_dir: string, out: [] u8) -> string {
  if profile_dir.count > 0 { return agy_token_path_join(home, profile_dir, true, out); }
  if home.count == 0 { return ""; }
  b1: [1024] u8; p1 := agy_token_path_join(home, "", true, b1[..]);
  if fs_exists(p1) { return cast(string) out[0..<cl_copy(out, p1)]; }
  return agy_token_path_join(home, "", false, out);
}

// ---------------------------------------------------------------- managed CLI installation & leases (#13839)

AgyRelease :: struct {
  version: [32] u8; nversion: int;
  url: [256] u8; nurl: int;
  sha512: [128] u8; nsha512: int;
  exe: [32] u8; nexe: int;
  is_tar_gz: bool;
}

AgyLease :: struct {
  release_id: [64] u8; nrelease: int;
  pid: int;
  active: bool;
}

AgyLeases :: struct {
  items: [AGY_MAX_LEASES] AgyLease;
}

agy_is_hex :: (c: u8) -> bool {
  return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

agy_is_release_id :: (id: string) -> bool {
  if id.count != 64 { return false; }
  for c: id { if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) { return false; } }
  return true;
}

// Map (os, arch, musl) to Google's Antigravity CLI manifest target name.
agy_cli_target :: (os: string, arch: string, musl: bool, out: [] u8) -> string {
  if os != "darwin" && os != "linux" && os != "windows" { return ""; }
  if arch != "x64" && arch != "arm64" { return ""; }
  cpu := ifx arch == "x64" then "amd64" else "arm64";
  n := cl_copy(out, os);
  n += cl_copy(out[n..<out.count], "_");
  n += cl_copy(out[n..<out.count], cpu);
  if os == "linux" && musl { n += cl_copy(out[n..<out.count], "_musl"); }
  return cast(string) out[0..<n];
}

// Validate and parse a Google Antigravity CLI release manifest JSON for (os, arch, musl).
// Enforces >= 1.5.0 < 2.0.0, 128-hex SHA-512, and pinned Google Cloud Storage URL layout.
agy_parse_release :: (json: string, os: string, arch: string, musl: bool, out: [] AgyRelease) -> bool {
  out[0] = AgyRelease.{};
  tb: [32] u8;
  if agy_cli_target(os, arch, musl, tb[..]).count == 0 { return false; }
  ab: [4096] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  ver := cl_str(ar[..], json, "version");
  url := cl_str(ar[..], json, "url");
  sha := cl_str(ar[..], json, "sha512");
  if ver.count == 0 || ver.count > out[0].version.count || !agy_version_ok(ver) { return false; }
  // Require strict X.Y.Z digits
  dots := 0; seg := 0;
  for c: ver {
    if c == '.' { if seg == 0 { return false; } dots += 1; seg = 0; }
    else if c >= '0' && c <= '9' { seg += 1; }
    else { return false; }
  }
  if dots != 2 || seg == 0 { return false; }
  if sha.count != 128 { return false; }
  for c, i: sha {
    if !agy_is_hex(c) { return false; }
    out[0].sha512[i] = ifx c >= 'A' && c <= 'F' then c + 32 else c;
  }
  out[0].nsha512 = 128;
  // Validate URL: https://storage.googleapis.com/antigravity-public/antigravity-cli/<ver>-<digits>/<folder>/cli_<os>_<cpu><suffix>.<ext>
  if url.count > out[0].url.count || url.count <= AGY_STORAGE_PREFIX.count + ver.count + 2 { return false; }
  if cast(string) url[0..<AGY_STORAGE_PREFIX.count] != AGY_STORAGE_PREFIX { return false; }
  pos := AGY_STORAGE_PREFIX.count;
  if cast(string) url[pos..<pos + ver.count] != ver { return false; }
  pos += ver.count;
  if url[pos] != '-' { return false; }
  pos += 1;
  dcount := 0;
  while pos < url.count && url[pos] >= '0' && url[pos] <= '9' { pos += 1; dcount += 1; }
  if dcount == 0 || pos >= url.count || url[pos] != '/' { return false; }
  pos += 1;
  rest := cast(string) url[pos..<url.count];
  eb: [128] u8; en := 0;
  en += cl_copy(eb[en..<eb.count], os);
  en += cl_copy(eb[en..<eb.count], ifx arch == "arm64" then "-arm" else "-x64");
  if os == "linux" && musl { en += cl_copy(eb[en..<eb.count], "-musl"); }
  en += cl_copy(eb[en..<eb.count], "/cli_");
  en += cl_copy(eb[en..<eb.count], ifx os == "darwin" then "mac" else os);
  en += cl_copy(eb[en..<eb.count], "_");
  en += cl_copy(eb[en..<eb.count], arch);
  if os == "linux" && musl { en += cl_copy(eb[en..<eb.count], "_musl"); }
  en += cl_copy(eb[en..<eb.count], ifx os == "windows" then ".exe" else ".tar.gz");
  if rest != cast(string) eb[0..<en] { return false; }
  out[0].nversion = cl_copy(out[0].version[..], ver);
  out[0].nurl = cl_copy(out[0].url[..], url);
  out[0].nexe = cl_copy(out[0].exe[..], ifx os == "windows" then "agy.exe" else "antigravity");
  out[0].is_tar_gz = os != "windows";
  return true;
}

agy_managed_root :: (home: string, out: [] u8) -> string {
  if home.count == 0 || home.count + AGY_MANAGED_SUBDIR.count > out.count { return ""; }
  n := cl_copy(out, home);
  n += cl_copy(out[n..<out.count], AGY_MANAGED_SUBDIR);
  return cast(string) out[0..<n];
}

agy_release_dir :: (root: string, release_id: string, out: [] u8) -> string {
  if root.count == 0 || !agy_is_release_id(release_id) { return ""; }
  b: [1024] u8; p := fs_join(root, "releases", b[..]);
  return fs_join(p, release_id, out);
}

agy_active_pointer_path :: (root: string, out: [] u8) -> string {
  if root.count == 0 { return ""; }
  return fs_join(root, "active.json", out);
}

agy_managed_exe_path :: (root: string, release_id: string, is_windows: bool, out: [] u8) -> string {
  db: [1024] u8; dir := agy_release_dir(root, release_id, db[..]);
  if dir.count == 0 { return ""; }
  return fs_join(dir, ifx is_windows then "agy.exe" else "antigravity", out);
}

agy_parse_active_release :: (json: string, out: [] u8) -> string {
  ab: [512] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  rid := cl_str(ar[..], json, "releaseId");
  if !agy_is_release_id(rid) || rid.count > out.count { return ""; }
  return cast(string) out[0..<cl_copy(out, rid)];
}

agy_format_active_release :: (release_id: string, out: [] u8) -> string {
  if !agy_is_release_id(release_id) || out.count < 82 { return ""; }
  n := cl_copy(out, "{\"releaseId\":\"");
  n += cl_copy(out[n..<out.count], release_id);
  n += cl_copy(out[n..<out.count], "\"}\n");
  return cast(string) out[0..<n];
}

agy_lease_acquire :: (l: [] AgyLeases, release_id: string, pid: int) -> int {
  if !agy_is_release_id(release_id) || pid <= 0 { return -1; }
  for i: 0..<AGY_MAX_LEASES {
    if !l[0].items[i].active {
      l[0].items[i].nrelease = cl_copy(l[0].items[i].release_id[..], release_id);
      l[0].items[i].pid = pid;
      l[0].items[i].active = true;
      return i;
    }
  }
  return -1;
}

agy_lease_release :: (l: [] AgyLeases, release_id: string, pid: int) -> bool {
  for i: 0..<AGY_MAX_LEASES {
    if l[0].items[i].active && l[0].items[i].pid == pid && cast(string) l[0].items[i].release_id[0..<l[0].items[i].nrelease] == release_id {
      l[0].items[i].active = false;
      l[0].items[i].pid = 0;
      l[0].items[i].nrelease = 0;
      return true;
    }
  }
  return false;
}

agy_lease_count :: (l: [] AgyLeases, release_id: string) -> int {
  c := 0;
  for i: 0..<AGY_MAX_LEASES {
    if l[0].items[i].active && cast(string) l[0].items[i].release_id[0..<l[0].items[i].nrelease] == release_id { c += 1; }
  }
  return c;
}

// Derive a canonical 64-hex release ID from a 128-hex SHA-512 digest (#13839).
agy_release_id_from_sha512 :: (sha512_hex: string, out: [] u8) -> string {
  if sha512_hex.count != 128 || out.count < 64 { return ""; }
  for i: 0..<128 { if !agy_is_hex(sha512_hex[i]) { return ""; } }
  for i: 0..<64 {
    c := sha512_hex[i];
    out[i] = ifx c >= 'A' && c <= 'F' then c + 32 else c;
  }
  return cast(string) out[0..<64];
}

// Build the official Google Antigravity CLI manifest URL for (os, arch, musl) (#13839).
agy_manifest_url :: (os: string, arch: string, musl: bool, out: [] u8) -> string {
  tb: [32] u8; target := agy_cli_target(os, arch, musl, tb[..]);
  if target.count == 0 { return ""; }
  need := AGY_MANIFEST_BASE.count + 1 + target.count + 5;
  if need > out.count { return ""; }
  n := cl_copy(out, AGY_MANIFEST_BASE);
  n += cl_copy(out[n..<out.count], "/");
  n += cl_copy(out[n..<out.count], target);
  n += cl_copy(out[n..<out.count], ".json");
  return cast(string) out[0..<n];
}

// Extract the 64-hex release ID if exe_path sits inside <root>/releases/<release_id>/... (#13839).
agy_release_id_from_exe_path :: (root: string, exe_path: string, out: [] u8) -> string {
  if root.count == 0 || exe_path.count == 0 || out.count < 64 { return ""; }
  rb: [1024] u8; rels := fs_join(root, "releases", rb[..]);
  if rels.count == 0 || exe_path.count <= rels.count + 65 { return ""; }
  if cast(string) exe_path[0..<rels.count] != rels { return ""; }
  sep := exe_path[rels.count];
  if sep != '/' && sep != '\\' { return ""; }
  start := rels.count + 1;
  rid := cast(string) exe_path[start..<start + 64];
  if !agy_is_release_id(rid) { return ""; }
  after := exe_path[start + 64];
  if after != '/' && after != '\\' { return ""; }
  return cast(string) out[0..<cl_copy(out, rid)];
}

agy_leases_dir :: (root: string, out: [] u8) -> string {
  if root.count == 0 { return ""; }
  return fs_join(root, "leases", out);
}

agy_int_to_str :: (v: int, out: [] u8) -> string {
  if v <= 0 || out.count == 0 { return ""; }
  tmp: [32] u8; k := 0; n := v;
  while n > 0 && k < tmp.count { tmp[k] = cast(u8) ('0' + (n % 10)); k += 1; n /= 10; }
  if k > out.count { return ""; }
  for i: 0..<k { out[i] = tmp[k - 1 - i]; }
  return cast(string) out[0..<k];
}

agy_lease_file_path :: (root: string, release_id: string, pid: int, out: [] u8) -> string {
  if root.count == 0 || !agy_is_release_id(release_id) || pid <= 0 { return ""; }
  db: [1024] u8; dir := agy_leases_dir(root, db[..]);
  if dir.count == 0 { return ""; }
  pb: [32] u8; ps := agy_int_to_str(pid, pb[..]);
  nb: [128] u8; nn := cl_copy(nb[..], release_id);
  nn += cl_copy(nb[nn..<nb.count], ".");
  nn += cl_copy(nb[nn..<nb.count], ps);
  nn += cl_copy(nb[nn..<nb.count], ".lease");
  return fs_join(dir, cast(string) nb[0..<nn], out);
}

// Parse "<64-hex>.<pid>.lease" into out_rid and return pid (> 0), or -1 if malformed (#13839).
agy_parse_lease_filename :: (name: string, out_rid: [] u8) -> int {
  if name.count < 72 || out_rid.count < 64 { return -1; }
  if cast(string) name[name.count - 6..<name.count] != ".lease" { return -1; }
  if name[64] != '.' { return -1; }
  rid := cast(string) name[0..<64];
  if !agy_is_release_id(rid) { return -1; }
  pid_str := cast(string) name[65..<name.count - 6];
  if pid_str.count == 0 || pid_str.count > 10 { return -1; }
  pid := 0;
  for c: pid_str {
    if c < '0' || c > '9' { return -1; }
    pid = pid * 10 + cast(int) (c - '0');
  }
  if pid <= 0 { return -1; }
  _ = cl_copy(out_rid, rid);
  return pid;
}

// Write a disk lease file for a running agy process so pruning never deletes its active version (#13839).
agy_lease_acquire_file :: (root: string, release_id: string, pid: int) -> bool {
  db: [1024] u8; dir := agy_leases_dir(root, db[..]);
  if dir.count == 0 || !fs_mkdir_all(dir) { return false; }
  fb: [1200] u8; path := agy_lease_file_path(root, release_id, pid, fb[..]);
  if path.count == 0 { return false; }
  pb: [32] u8; ps := agy_int_to_str(pid, pb[..]);
  return fs_write(path, ps);
}

agy_lease_release_file :: (root: string, release_id: string, pid: int) -> bool {
  fb: [1200] u8; path := agy_lease_file_path(root, release_id, pid, fb[..]);
  if path.count == 0 { return false; }
  return fs_remove(path);
}

// True only when candidate_id is a valid release ID that is neither the active release
// nor leased by any running agy process (#13839).
agy_can_prune_release :: (l: [] AgyLeases, active_id: string, candidate_id: string) -> bool {
  if !agy_is_release_id(candidate_id) { return false; }
  if candidate_id == active_id { return false; }
  return agy_lease_count(l, candidate_id) == 0;
}

// True when program ends in .cmd or .bat (case-insensitive) for Windows launcher handling (#13839).
agy_is_windows_cmd :: (program: string) -> bool {
  if program.count < 4 { return false; }
  s := program.count - 4;
  if program[s] != '.' { return false; }
  a := ifx program[s + 1] >= 'A' && program[s + 1] <= 'Z' then program[s + 1] + 32 else program[s + 1];
  b := ifx program[s + 2] >= 'A' && program[s + 2] <= 'Z' then program[s + 2] + 32 else program[s + 2];
  c := ifx program[s + 3] >= 'A' && program[s + 3] <= 'Z' then program[s + 3] + 32 else program[s + 3];
  return (a == 'c' && b == 'm' && c == 'd') || (a == 'b' && b == 'a' && c == 't');
}

// Wrap a Windows .cmd/.bat launcher through cmd.exe /d /s /c <program> acp <args...> (#13839).
agy_wrap_windows_cmd :: (l: [] CuLaunch) -> bool {
  if !agy_is_windows_cmd(l[0].program) { return false; }
  if l[0].args_n + 5 > l[0].args.count { return false; }
  orig := l[0].program;
  i := l[0].args_n - 1;
  while i >= 0 { l[0].args[i + 5] = l[0].args[i]; i -= 1; }
  l[0].program = "cmd.exe";
  l[0].args[0] = "/d";
  l[0].args[1] = "/s";
  l[0].args[2] = "/c";
  l[0].args[3] = orig;
  l[0].args[4] = "acp";
  l[0].args_n += 5;
  l[0].raw_args = true;
  return true;
}

// Bounded retry backoff (ms) for briefly locked Windows runtime folders during install/update; -1 past cap (#13839).
agy_win_retry_delay_ms :: (attempt: int) -> int {
  if attempt == 0 { return 100; }
  if attempt == 1 { return 250; }
  if attempt == 2 { return 500; }
  if attempt == 3 { return 1000; }
  if attempt == 4 { return 2000; }
  return -1;
}

// Parse an Antigravity agentInfo.version (stripping any agy_acp_server_ prefix).
// Accepts >= 1.5.10 (including >= 2.0.0), date-stamped RC builds (agy_acp_server_YYYYMMDD_*),
// and empty/absent version; refuses explicit < 1.5.10 (#14004).
agy_version_ok :: (version: string) -> bool {
  if version.count == 0 { return true; }
  s := version;
  has_prefix := false;
  if s.count >= AGY_VERSION_PREFIX.count && cast(string) s[0..<AGY_VERSION_PREFIX.count] == AGY_VERSION_PREFIX {
    s = cast(string) s[AGY_VERSION_PREFIX.count..<s.count];
    has_prefix = true;
  }
  if s.count > 0 && (s[0] == 'v' || s[0] == 'V') { s = cast(string) s[1..<s.count]; }
  if s.count == 0 || s[0] < '0' || s[0] > '9' { return false; }
  // Accept date-stamped RC server builds such as "agy_acp_server_20261120_1_rc" (#14004).
  if has_prefix && s.count >= 9 && s[8] == '_' {
    date_ok := true;
    for k: 0..<8 { if s[k] < '0' || s[k] > '9' { date_ok = false; break; } }
    if date_ok { return true; }
  }
  i := 0; major := 0;
  while i < s.count && s[i] >= '0' && s[i] <= '9' {
    if major > 100000 { return false; }
    major = major * 10 + cast(int) (s[i] - '0'); i += 1;
  }
  if i >= s.count || s[i] != '.' { return false; }
  i += 1;
  if i >= s.count || s[i] < '0' || s[i] > '9' { return false; }
  minor := 0;
  while i < s.count && s[i] >= '0' && s[i] <= '9' {
    if minor > 100000 { return false; }
    minor = minor * 10 + cast(int) (s[i] - '0'); i += 1;
  }
  patch := 0;
  if i < s.count && s[i] == '.' {
    i += 1;
    if i >= s.count || s[i] < '0' || s[i] > '9' { return false; }
    while i < s.count && s[i] >= '0' && s[i] <= '9' {
      if patch > 100000 { return false; }
      patch = patch * 10 + cast(int) (s[i] - '0'); i += 1;
    }
  }
  if i < s.count && s[i] != '-' && s[i] != '+' { return false; }
  if major >= 2 { return true; }
  return major == 1 && (minor > 5 || (minor == 5 && patch >= 10));
}

// Empty when the reported version is acceptable, else an actionable upgrade message naming AGY_INSTALL.
agy_check_version :: (version: string) -> string {
  if agy_version_ok(version) { return ""; }
  return AGY_OLD_VERSION;
}

// agy started in cwd with the credentials file's variables and optional isolated profile dir.
agy_launch_with_opts :: (x: [] CuEngine, program: string, cwd: string, name: string, version: string, profile_dir: string, app_data_dir: string, skip_permissions: bool) -> string {
  cue_agent(x, agy_agent());
  e: [1] AgyEnv; r := agy_env_load(e[..]);
  ab: [8] u8; gb: [8] u8; sb: [8] u8;
  has_au := cl_getenv("AGY_CLI_DISABLE_AUTO_UPDATE", ab[..]).count > 0;
  has_gh := cl_getenv("GEMINI_HOME", gb[..]).count > 0;
  has_sc := cl_getenv("SSH_CONNECTION", sb[..]).count > 0;
  l: [1] CuLaunch;
  agy_prepare_launch(l[..], e[..], program, cwd, profile_dir, has_au, has_gh, has_sc);
  if profile_dir.count == 0 && app_data_dir.count > 0 && l[0].args_n + 2 <= l[0].args.count {
    l[0].args[l[0].args_n] = "--app-data-dir";
    l[0].args[l[0].args_n + 1] = app_data_dir;
    l[0].args_n += 2;
  }
  if skip_permissions && l[0].args_n < l[0].args.count {
    l[0].args[l[0].args_n] = "--dangerously-skip-permissions";
    l[0].args_n += 1;
  }
  pps_b: [16] u8; pps := cl_getenv("CODER_AGY_PROCESS_PER_SESSION", pps_b[..]);
  if (pps == "1" || pps == "true") && l[0].args_n < l[0].args.count {
    l[0].args[l[0].args_n] = "--process-per-session";
    l[0].args_n += 1;
  }
  _ = agy_wrap_windows_cmd(l[..]);
  why := cue_start(x, l[0], name, version);
  if why.count == 0 {
    cue_set_bg_hold_limit(x, AGY_BG_HOLD_MS);
    stb: [32] u8; rb: [32] u8;
    w := agy_watch_limits(cl_getenv("CODER_AGY_STALL_S", stb[..]), cl_getenv("CODER_AGY_RECOVER", rb[..]));
    cue_watch_set(x, w.stall_ms, w.recoveries);
  }
  return why;
}

agy_launch_with_skip :: (x: [] CuEngine, program: string, cwd: string, name: string, version: string, profile_dir: string, skip_permissions: bool) -> string {
  adb: [64] u8; app_data := cl_getenv("CODER_AGY_APP_DATA_DIR", adb[..]);
  return agy_launch_with_opts(x, program, cwd, name, version, profile_dir, app_data, skip_permissions);
}

agy_launch_with :: (x: [] CuEngine, program: string, cwd: string, name: string, version: string, profile_dir: string) -> string {
  return agy_launch_with_skip(x, program, cwd, name, version, profile_dir, false);
}

// agy started in cwd with the credentials file's variables, initialize sent: "" or why it did not start.
agy_launch :: (x: [] CuEngine, program: string, cwd: string, name: string, version: string) -> string {
  pb: [1024] u8; prof := cl_getenv("CODER_AGY_PROFILE_DIR", pb[..]);
  return agy_launch_with(x, program, cwd, name, version, prof);
}

// Respawn agy after an unexpected exit and resume the previous session.
agy_respawn_with :: (x: [] CuEngine, program: string, cwd: string, name: string, version: string, profile_dir: string) -> string {
  _ = cue_prepare_restart(x);
  return agy_launch_with(x, program, cwd, name, version, profile_dir);
}
agy_respawn :: (x: [] CuEngine, program: string, cwd: string, name: string, version: string) -> string {
  pb: [1024] u8; prof := cl_getenv("CODER_AGY_PROFILE_DIR", pb[..]);
  return agy_respawn_with(x, program, cwd, name, version, prof);
}

// ---------------------------------------------------------------- the stall watchdog's limits

// agy waits a fixed 5 minutes on a reply stream that went silent before it retries (twice in the
// task-fit runs, GitHub #13193). The shared engine's watchdog (cue_watch) cancels such a turn and
// asks it to continue. agy sends a thought chunk every 2 to 3 s while a model thinks, but nothing
// while it writes a tool call's arguments (27 s for a 1,500-line file on Flash at low) or waits
// for a first token (up to 83 s in the us location, #13227), so the limit sits above both.
AGY_STALL_S :: 120;
AGY_RECOVERIES :: 2;
AgyWatch :: struct { stall_ms: int; recoveries: int; }
// A count from a setting's word, or fallback when the word is not digits.
agy_count :: (word: string, fallback: int) -> int {
  if word.count == 0 || word.count > 6 { return fallback; }
  v := 0;
  for c: word { if c < '0' || c > '9' { return fallback; } v = v * 10 + cast(int) (c - '0'); }
  return v;
}
// The limits from CODER_AGY_STALL_S (seconds; 0 turns the watchdog off) and CODER_AGY_RECOVER.
agy_watch_limits :: (stall_word: string, recover_word: string) -> AgyWatch {
  return AgyWatch.{stall_ms = agy_count(stall_word, AGY_STALL_S) * 1000, recoveries = agy_count(recover_word, AGY_RECOVERIES)};
}

#test "antigravity: the watchdog's limits come from the settings, else 120 s and 2" {
  w := agy_watch_limits("", "");
  #assert w.stall_ms == 120000 && w.recoveries == 2;
  w = agy_watch_limits("30", "5"); #assert w.stall_ms == 30000 && w.recoveries == 5;
  w = agy_watch_limits("0", "0"); #assert w.stall_ms == 0 && w.recoveries == 0;
  w = agy_watch_limits("4m", "-1"); #assert w.stall_ms == 120000 && w.recoveries == 2;
  w = agy_watch_limits("1234567", "1"); #assert w.stall_ms == 120000 && w.recoveries == 1;
}

// ---------------------------------------------------------------- the opened session

// The owner's model and effort, and agy's default mode, for the session that just opened
// (result: session/new's or session/resume's). A model agy lists (models.availableModels, such
// as gemini-4-hydrogen-low) is set with session/set_model, else a model config option's value
// (gemini-4-hydrogen) with session/set_config_option; the effort is the thought_level option's
// value. Every setting sent holds the first message until it is answered. Returns which were
// not applied (AGY_MODEL_NOT_APPLIED, AGY_EFFORT_NOT_APPLIED).
//
// With no effort named, a turn thinks at AGY_EFFORT (low; GitHub #13193): a model named with its
// level (one agy lists, gemini-4-argon-medium) is set as given; a base model (gemini-4-argon) is
// set as its -low variant when agy lists one, else set as named with thought_level low; no model
// is agy's own with thought_level low. At medium, Flash and Carbon spent 7 to 15 s thinking before
// a call's first byte, and Carbon's long calls thought for 5 to 6 minutes (#13227).
//
// A caller with another default passes it as fallback (agy_configure_at): OpenAgents Desktop's
// chats think at high (coder/tui/agyworker.coax, AGYW_EFFORT), where the owner reads the thoughts.
AGY_EFFORT :: "low";
agy_configure_mode :: (x: [] CuEngine, result: string, model: string, effort: string, want_mode: string) -> int {
  return agy_configure_at(x, result, model, effort, want_mode, AGY_EFFORT);
}
agy_configure_at :: (x: [] CuEngine, result: string, model: string, effort: string, want_mode: string, fallback: string) -> int {
  ar := x[0].c[0].ar[..];
  x[0].hold = 0;
  missed := 0;
  level := effort;                 // the thought level to set: the owner's, else the fallback unless the model carries one
  if level.count == 0 { level = fallback; }
  if model.count > 0 {
    lb: [160] u8; ln := cl_copy(lb[..], model); ln += cl_copy(lb[ln..<lb.count], "-"); ln += cl_copy(lb[ln..<lb.count], fallback);
    if cu_model_has(result, model, ar) { cue_set_model(x, model); if effort.count == 0 { level = ""; } }
    else if effort.count == 0 && ln < lb.count && cu_model_has(result, cast(string) lb[0..<ln], ar) { cue_set_model(x, cast(string) lb[0..<ln]); level = ""; }
    else {
      bb: [128] u8; bn := cl_copy(bb[..], cu_config_id(result, "model", model, ar));
      if bn == 0 { missed = missed | AGY_MODEL_NOT_APPLIED; } else { cue_set(x, cast(string) bb[0..<bn], model); }
    }
  }
  if level.count > 0 {   // mutant: equivalent (when level is empty, cu_config_id returns "" and effort is also empty)
    ib: [128] u8; idn := cl_copy(ib[..], cu_config_id(result, "thought_level", level, ar));
    if idn > 0 { cue_set(x, cast(string) ib[0..<idn], level); }
    else if effort.count > 0 { missed = missed | AGY_EFFORT_NOT_APPLIED; }   // our default is quiet when not offered
  }
  target := want_mode;
  if target.count == 0 { target = AGY_MODE; }
  if target == AGY_MODE_AUTO && !cu_mode_has(result, AGY_MODE_AUTO, ar) { target = AGY_MODE; }
  mode := cl_str(ar, result, "modes.currentModeId");
  if cu_mode_has(result, target, ar) && mode != target { cue_set_mode(x, target); }
  return missed;
}

// The model a session runs on once agy_configure_mode has set model and effort on it (result:
// session/new's): agy's own id, the one `agy models` lists (gemini-4-carbon-low), into out. It
// follows that function's choices: a listed model as named; a base model as its -low variant when
// listed; no model is agy's default (the model config option's currentValue, else
// models.currentModelId) at the thought level set. "" only when agy named nothing at all.
agy_effective_model :: (result: string, model: string, effort: string, ar: [] ClArena, out: [] u8) -> string {
  return agy_effective_at(result, model, effort, AGY_EFFORT, ar, out);
}
// The same, for a caller whose default level is fallback (agy_configure_at).
agy_effective_at :: (result: string, model: string, effort: string, fallback: string, ar: [] ClArena, out: [] u8) -> string {
  level := ifx effort.count > 0 then effort else fallback;
  base := model;
  if model.count > 0 {
    if cu_model_has(result, model, ar) && effort.count == 0 { return cast(string) out[0..<cl_copy(out, model)]; }
  } else {
    base = cu_config_current(result, "model", ar);
    if base.count == 0 { return cast(string) out[0..<cl_copy(out, cl_str(ar, result, "models.currentModelId"))]; }
  }
  // the base model at the level set, when agy lists that id
  n := cl_copy(out, base); n += cl_copy(out[n..<out.count], "-"); n += cl_copy(out[n..<out.count], level);
  if n < out.count && cu_model_has(result, cast(string) out[0..<n], ar) { return cast(string) out[0..<n]; }
  return cast(string) out[0..<cl_copy(out, base)];
}
// What a person reads for that model: agy's name for it ("Gemini 4 Carbon (Low)"), else its id.
agy_model_shown :: (result: string, id: string, ar: [] ClArena) -> string {
  name := cu_model_name(result, id, ar);
  return ifx name.count > 0 then name else id;
}

agy_configure :: (x: [] CuEngine, result: string, model: string, effort: string) -> int {
  return agy_configure_mode(x, result, model, effort, AGY_MODE);
}

agy_has :: (text: string, part: string) -> bool {
  if part.count > text.count { return false; }
  for i: 0..<text.count - part.count + 1 { if cast(string) text[i..<i + part.count] == part { return true; } }
  return false;
}

// agy's refusal when it has no sign-in ("Authentication required"), or an expired one.
agy_signed_out :: (message: string) -> bool {
  return agy_has(message, "Authentication required") || agy_has(message, "Authentication expired") || agy_has(message, "log back in");
}

// A refused turn the model provider caused (quota, rate, overload, unavailable): routing cools agy down.
agy_provider :: (message: string) -> bool {
  if agy_signed_out(message) { return false; }
  marks := [8] string.["RESOURCE_EXHAUSTED", "quota", "Quota", "rate limit", "Rate limit", "429", "unavailable", "overloaded"];
  for m: marks { if agy_has(message, m) { return true; } }
  return agy_has(message, "UNAVAILABLE") || agy_has(message, "503");
}

// Lost or invalid thinking signature on a resumed session: caller should recover via cue_fresh_session().
agy_lost_thinking_signature :: (message: string) -> bool {
  marks := [8] string.[
    "thought_signature", "thinking_signature", "thinking signature",
    "thought signature", "invalid signature in thinking", "Invalid signature in thinking",
    "missing thought signature", "corrupted thought signature",
  ];
  for m: marks { if agy_has(message, m) { return true; } }
  return false;
}

#test "antigravity: a provider's refusal is told from a sign-in's" {
  #assert agy_provider("The model is unavailable. Try again later.") && agy_provider("RESOURCE_EXHAUSTED: quota exceeded") && agy_provider("HTTP 429");
  #assert !agy_provider("Authentication required") && !agy_provider("Unknown model ID: nope") && !agy_provider("");
}

// ---------------------------------------------------------------- a model call that failed

// agy reports a model call it gave up on (a location that does not serve the model, a quota
// still exhausted after its own retries) as the turn's words, "\n⚠ MESSAGE\n", answers
// session/prompt with stopReason end_turn, and reports no usage. Measured on agy 1.5.6
// (GitHub #13227): GOOGLE_CLOUD_LOCATION=us-east5 with gemini-4-carbon. Such a turn failed.

// The message of agy's failure notice, or "" when the words are not one.
agy_notice :: (text: string) -> string {
  a := 0; b := text.count;
  while a < b && text[a] <= 32 { a += 1; }
  while b > a && text[b - 1] <= 32 { b -= 1; }
  mark := "⚠";
  if b - a < mark.count || cast(string) text[a..<a + mark.count] != mark { return ""; }
  a += mark.count;
  while a < b && text[a] <= 32 { a += 1; }
  return ifx a < b then cast(string) text[a..<b] else "";
}
// One chunk of the turn's words: a notice is kept, other words forget it.
agy_chunk :: (x: [] CuEngine, text: string) {
  m := agy_notice(text);
  if m.count > 0 { x[0].notice_n = cl_copy(x[0].notice[..], m); return; }
  for c: text { if c > 32 { x[0].notice_n = 0; return; } }
}
// Why the turn session/prompt answered (result) failed: agy's notice when its words were one and
// the answer reports no usage; "" when it did not fail this way.
agy_turn_failed :: (x: [] CuEngine, result: string) -> string {
  if x[0].notice_n == 0 || cl_raw(result, "usage").count > 0 { return ""; }
  return cast(string) x[0].notice[0..<x[0].notice_n];
}

// ---------------------------------------------------------------- 1.5 reliability helpers (#13835)

// Normalized per-turn usage from session/prompt's result.usage.
// Prevents double-counting thoughtTokens inside outputTokens (t3code #39686).
AgyUsage :: struct {
  input: int;
  cached_read: int;
  cached_write: int;
  thought: int;
  output: int;      // non-thought output tokens
  total: int;
}

agy_parse_usage :: (usage_json: string) -> AgyUsage {
  u: AgyUsage;
  if usage_json.count == 0 { return u; }
  iv := cl_int(usage_json, "inputTokens"); if iv.ok { u.input = iv.value; }
  cr := cl_int(usage_json, "cachedReadTokens"); if cr.ok { u.cached_read = cr.value; }
  cw := cl_int(usage_json, "cachedWriteTokens"); if cw.ok { u.cached_write = cw.value; }
  th := cl_int(usage_json, "thoughtTokens"); if th.ok { u.thought = th.value; }
  ov := cl_int(usage_json, "outputTokens"); raw_out := ifx ov.ok then ov.value else 0;
  tv := cl_int(usage_json, "totalTokens"); if tv.ok { u.total = tv.value; }
  // When agy folds thoughtTokens into outputTokens (total == input + cached_read + cached_write + raw_out),
  // subtract thoughtTokens so output is never double-counted alongside thought.
  if u.thought > 0 && raw_out >= u.thought && u.total > 0 && u.input + u.cached_read + u.cached_write + raw_out == u.total {
    u.output = raw_out - u.thought;
  } else {
    u.output = raw_out;
  }
  return u;
}

// Detect a mid-turn 404 or upstream error recorded in agy's brain/ transcript log (#13835).
// Returns a retryable error summary in out, or "" for normal log lines.
agy_log_upstream_error :: (line: string, ar: [] ClArena, out: [] u8) -> string {
  if line.count == 0 { return ""; }
  st := cl_str(ar, line, "status");
  content := cl_str(ar, line, "content");
  if content.count == 0 { content = cl_str(ar, line, "error"); }
  is_err := st == "ERROR" || st == "FAILED";
  has_404 := s_has(content, "404") || s_has(line, "HTTP 404") || s_has(line, "status 404") || s_has(line, "NOT_FOUND");
  has_up := s_has(content, "RESOURCE_EXHAUSTED") || s_has(content, "UNAVAILABLE") || s_has(content, "upstream error");
  if !is_err && !has_404 && !has_up { return ""; }
  if has_404 {
    n := cl_copy(out, "Antigravity upstream 404 error (retryable)");
    if content.count > 0 && content.count <= 200 {
      n += cl_copy(out[n..<out.count], ": ");
      n += cl_copy(out[n..<out.count], content);
    }
    return cast(string) out[0..<n];
  }
  if has_up || is_err {
    msg := ifx content.count > 0 then content else "Antigravity upstream error (retryable).";
    return cast(string) out[0..<cl_copy(out, msg)];
  }
  return "";
}

// True when a patch emitted by agy is a truncated snippet rather than a unified diff (#13835).
agy_is_snippet_patch :: (patch: string) -> bool {
  if patch.count == 0 { return false; }
  return !s_has(patch, "@@ ") || s_has(patch, "\n...\n");
}

#test "antigravity: a turn whose words are agy's failure notice, with no usage, failed" {
  #assert agy_notice("\n⚠ Selected model is not supported in the selected location.\n") == "Selected model is not supported in the selected location.";
  #assert agy_notice("⚠ RESOURCE_EXHAUSTED (code 429)") == "RESOURCE_EXHAUSTED (code 429)" && agy_notice("Done. ⚠ careful") == "" && agy_notice("⚠  ") == "" && agy_notice("") == "";
  xb: [1] CuEngine; x := xb[..];
  agy_chunk(x, "\n⚠ Selected model is not supported in the selected location.\n");
  #assert agy_turn_failed(x, "{\"stopReason\":\"end_turn\"}") == "Selected model is not supported in the selected location.";
  #assert agy_turn_failed(x, "{\"stopReason\":\"end_turn\",\"usage\":{\"totalTokens\":9}}") == "";   // the model answered
  agy_chunk(x, "  \n"); #assert x[0].notice_n > 0;                                             // blank words keep it
  agy_chunk(x, "I fixed it."); #assert agy_turn_failed(x, "{\"stopReason\":\"end_turn\"}") == "";   // later words forget it
  agy_chunk(x, "⚠ quota"); #assert x[0].notice_n > 0;
  sent := cue_send(x, "next"); #assert !sent && x[0].notice_n == 0;                          // a new message starts clean
}

AGY_PATH_KEYS :: [11] string.[
  "Path", "Cwd", "TargetFile", "AbsolutePath", "DirectoryPath",
  "path", "file_path", "cwd", "target_file", "absolute_path", "directory_path"
];

agy_path_is_abs :: (p: string) -> bool {
  if p.count == 0 { return false; }
  if p[0] == '/' { return true; }
  if p.count >= 2 && p[0] == '\\' && p[1] == '\\' { return true; }
  if p.count >= 2 && ((p[0] >= 'a' && p[0] <= 'z') || (p[0] >= 'A' && p[0] <= 'Z')) && p[1] == ':' { return true; }
  return false;
}

agy_path_outside_cwd :: (path: string, cwd: string) -> bool {
  if path.count == 0 { return false; }
  if cu_has_dotdot(path) { return true; }
  if cwd.count > 0 && agy_path_is_abs(path) {
    return !cu_path_under_root(path, cwd);
  }
  return false;
}

// True when any path in toolCall.locations[].path or toolCall.rawInput contains ".."
// (POSIX or Windows) or resolves to an absolute path outside cwd (#13996).
agy_outside_cwd :: (tool: string, cwd: string, ar: [] ClArena) -> bool {
  locs := cl_raw(tool, "locations");
  n := cl_count(locs);
  for i: 0..<n {
    item := cl_json(locs, cl_item(locs, i));
    if agy_path_outside_cwd(cl_str(ar, item, "path"), cwd) { return true; }
  }
  raw := cl_raw(tool, "rawInput");
  keys := AGY_PATH_KEYS;
  for k: keys { if agy_path_outside_cwd(cl_str(ar, raw, k), cwd) { return true; } }
  return false;
}

// True when a path agy's tools name in rawInput or locations contains "..".
agy_outside :: (tool: string, ar: [] ClArena) -> bool {
  return agy_outside_cwd(tool, "", ar);
}

// ---------------------------------------------------------------- checks

// (cue_out_has lowercases what it reads)
agy_out_has :: (x: [] CuEngine, part: string) -> bool { return agy_has(cu_outbox(x[0].c), part); }

agy_test :: (x: [] CuEngine, c: [] CuClient, p: [] ClProcess, line: [] u8, arena: [] u8, out: [] u8) {
  cue_test(x, c, p, line, arena, out);
  cue_agent(x, agy_agent());
}

AGY_OPENED :: "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"sessionId\":\"g-1\",\"models\":{\"availableModels\":[{\"modelId\":\"gemini-4-hydrogen-low\",\"name\":\"Gemini 4 Hydrogen (Low)\"}],\"currentModelId\":\"gemini-4-carbon-medium\"},\"modes\":{\"currentModeId\":\"default\",\"availableModes\":[{\"id\":\"default\"},{\"id\":\"auto\"}]},\"configOptions\":[{\"id\":\"model\",\"category\":\"model\",\"type\":\"select\",\"options\":[{\"value\":\"gemini-4-hydrogen\"},{\"value\":\"gemini-4-carbon\"}]},{\"id\":\"thought_level\",\"category\":\"thought_level\",\"type\":\"select\",\"options\":[{\"value\":\"low\"},{\"value\":\"medium\"},{\"value\":\"high\"}]}]}}";

AGY_OPENED_MEDIUM :: "{\"sessionId\":\"g-1\",\"models\":{\"availableModels\":[{\"modelId\":\"gemini-4-argon-medium\"},{\"modelId\":\"gemini-4-argon-low\"}]},\"configOptions\":[{\"id\":\"model\",\"category\":\"model\",\"type\":\"select\",\"options\":[{\"value\":\"gemini-4-argon\"}]},{\"id\":\"thought_level\",\"category\":\"thought_level\",\"type\":\"select\",\"options\":[{\"value\":\"low\"},{\"value\":\"medium\"}]}]}";

#test "antigravity: initialize answered opens a session at once, with no authenticate" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [4096] u8; out: [2048] u8;
  x := xb[..]; agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"protocolVersion\":1}}");
  #assert ev.kind == CuEventKind.initialized && !agy_out_has(x, "authenticate");
  #assert agy_out_has(x, "\"id\":2,\"method\":\"session/new\"") && agy_out_has(x, "\"cwd\":\"/w\"");
  ev = cue_feed(x, AGY_OPENED);
  #assert ev.kind == CuEventKind.answered && ev.of == CU_SESSION_NEW && x[0].ready && cu_session_id(x[0].c) == "g-1";
}

#test "antigravity: a resumed session uses session/resume, replays nothing, and a refusal opens a new one" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [4096] u8; out: [2048] u8;
  x := xb[..]; agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  cue_resume(x, "old-g");
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  #assert !x[0].replay && x[0].nresume == 0 && agy_out_has(x, "\"method\":\"session/resume\"") && agy_out_has(x, "\"sessionId\":\"old-g\"");
  #assert !agy_out_has(x, "session/load");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"modes\":{\"currentModeId\":\"default\"}}}");
  #assert ev.of == CU_SESSION_RESUME && x[0].ready && cu_session_id(x[0].c) == "old-g";   // the answer need not repeat the id
  // a permission after resume is the owner's: nothing replays
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"method\":\"session/request_permission\",\"params\":{\"options\":[{\"optionId\":\"allow\",\"kind\":\"allow_once\"},{\"optionId\":\"deny\",\"kind\":\"reject_once\"}],\"toolCall\":{\"kind\":\"execute\"}}}");
  #assert ev.kind == CuEventKind.permission;
  cu_permit(x[0].c, cu_allow_option(x[0].c));
  #assert agy_out_has(x, "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":{\"outcome\":{\"outcome\":\"selected\",\"optionId\":\"allow\"}}}");

  yb: [1] CuEngine; db: [1] CuClient; qb: [1] ClProcess; line2: [1024] u8; arena2: [4096] u8; out2: [2048] u8;
  y := yb[..]; agy_test(y, db[..], qb[..], line2[..], arena2[..], out2[..]);
  cue_resume(y, "gone");
  ev = cue_feed(y, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  ev = cue_feed(y, "{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32603,\"message\":\"Failed to read session gone\"}}");
  #assert ev.kind == CuEventKind.refused && ev.of == CU_SESSION_RESUME && agy_out_has(y, "\"method\":\"session/new\"");
  ev = cue_feed(y, "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"sessionId\":\"g-2\"}}");
  #assert y[0].ready && cu_session_id(y[0].c) == "g-2";
}

#test "antigravity: a listed model goes by set_model, a base model and the effort by config options, each held" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [8192] u8; out: [4096] u8;
  x := xb[..]; agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  #assert !cue_send(x, "hello");
  ev = cue_feed(x, AGY_OPENED);
  opened := ev.result;
  cu_outbox_clear(x[0].c);
  #assert agy_configure(x, opened, "gemini-4-hydrogen-low", "high") == 0 && x[0].hold == 2;
  #assert agy_out_has(x, "\"method\":\"session/set_model\",\"params\":{\"sessionId\":\"g-1\",\"modelId\":\"gemini-4-hydrogen-low\"}");
  #assert agy_out_has(x, "\"configId\":\"thought_level\",\"value\":\"high\"") && !agy_out_has(x, "session/set_mode\"");
  cue_owed(x, true); #assert !agy_out_has(x, "session/prompt");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":4,\"error\":{\"code\":-32602,\"message\":\"no\"}}");
  #assert x[0].hold == 0;
  cue_owed(x, true); #assert agy_out_has(x, "\"method\":\"session/prompt\"") && agy_out_has(x, "hello");

  cu_outbox_clear(x[0].c);
  #assert agy_configure(x, ev.result, "", "") == 0;   // (ev.result is an error's: nothing advertised, nothing asked)
  x[0].c[0].ar[0].at = 0; x[0].c[0].ar[0].full = false;    // (as a fed line resets it)
  #assert agy_configure(x, opened, "gemini-4-hydrogen", "medium") == 0 && agy_out_has(x, "\"configId\":\"model\",\"value\":\"gemini-4-hydrogen\"") && agy_out_has(x, "\"value\":\"medium\"");
  x[0].c[0].ar[0].at = 0; x[0].c[0].ar[0].full = false;
  #assert agy_configure(x, opened, "nope", "xhigh") == AGY_MODEL_NOT_APPLIED | AGY_EFFORT_NOT_APPLIED && x[0].hold == 0;
}

agy_t_reset :: (x: [] CuEngine) { cu_outbox_clear(x[0].c); x[0].c[0].ar[0].at = 0; x[0].c[0].ar[0].full = false; }

AGY_OPENED_DEFAULT :: "{\"sessionId\":\"g-1\",\"models\":{\"availableModels\":[{\"modelId\":\"gemini-4-carbon-medium\",\"name\":\"Gemini 4 Carbon (Medium)\"},{\"modelId\":\"gemini-4-carbon-low\",\"name\":\"Gemini 4 Carbon (Low)\"},{\"modelId\":\"gemini-4-argon-low\",\"name\":\"Gemini 4 Argon (Low)\"},{\"modelId\":\"gemini-4-argon-high\",\"name\":\"Gemini 4 Argon (High)\"}],\"currentModelId\":\"gemini-4-carbon-medium\"},\"configOptions\":[{\"id\":\"model\",\"category\":\"model\",\"type\":\"select\",\"currentValue\":\"gemini-4-carbon\",\"options\":[{\"value\":\"gemini-4-carbon\"},{\"value\":\"gemini-4-argon\"}]},{\"id\":\"thought_level\",\"category\":\"thought_level\",\"type\":\"select\",\"currentValue\":\"medium\",\"options\":[{\"value\":\"low\"},{\"value\":\"medium\"},{\"value\":\"high\"}]}]}";

#test "antigravity: the model a session really runs on, never just 'default'" {
  ab: [8192] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}]; o: [128] u8;
  r := AGY_OPENED_DEFAULT;
  // nothing named: agy's default model (Carbon) at our thought level (low), with agy's own name
  #assert agy_effective_model(r, "", "", ar[..], o[..]) == "gemini-4-carbon-low";
  #assert agy_model_shown(r, "gemini-4-carbon-low", ar[..]) == "Gemini 4 Carbon (Low)";
  // an effort named: the default model at that level, when listed; else the base model
  #assert agy_effective_model(r, "", "medium", ar[..], o[..]) == "gemini-4-carbon-medium";
  #assert agy_effective_model(r, "", "high", ar[..], o[..]) == "gemini-4-carbon";
  // a listed model as named; a base model as its listed variant
  #assert agy_effective_model(r, "gemini-4-argon-high", "", ar[..], o[..]) == "gemini-4-argon-high";
  #assert agy_effective_model(r, "gemini-4-argon", "", ar[..], o[..]) == "gemini-4-argon-low";
  #assert agy_effective_model(r, "gemini-4-argon", "high", ar[..], o[..]) == "gemini-4-argon-high";
  #assert agy_effective_model(r, "gemini-4-argon-high", "low", ar[..], o[..]) == "gemini-4-argon-high";
  // no config options: models.currentModelId; nothing at all: ""
  #assert agy_effective_model("{\"models\":{\"currentModelId\":\"gemini-4-neon-medium\"}}", "", "", ar[..], o[..]) == "gemini-4-neon-medium";
  #assert agy_effective_model("{}", "", "", ar[..], o[..]) == "";
  #assert agy_model_shown(r, "nope", ar[..]) == "nope";
}

#test "antigravity: with no effort named a turn thinks low; a model named with its level, or an effort, is kept" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [8192] u8; out: [4096] u8;
  x := xb[..]; agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  ev = cue_feed(x, AGY_OPENED);
  opened := ev.result;
  agy_t_reset(x);
  // a base model with a listed -low variant: that variant, and no thought level besides
  #assert agy_configure(x, opened, "gemini-4-hydrogen", "") == 0 && x[0].hold == 1;
  #assert agy_out_has(x, "\"method\":\"session/set_model\",\"params\":{\"sessionId\":\"g-1\",\"modelId\":\"gemini-4-hydrogen-low\"}") && !agy_out_has(x, "thought_level");
  agy_t_reset(x);
  // a base model with none listed: the model as named, at thought_level low
  #assert agy_configure(x, opened, "gemini-4-carbon", "") == 0 && x[0].hold == 2;
  #assert agy_out_has(x, "\"configId\":\"model\",\"value\":\"gemini-4-carbon\"") && agy_out_has(x, "\"configId\":\"thought_level\",\"value\":\"low\"");
  agy_t_reset(x);
  // no model: agy's own, at thought_level low
  #assert agy_configure(x, opened, "", "") == 0 && x[0].hold == 1 && agy_out_has(x, "\"configId\":\"thought_level\",\"value\":\"low\"") && !agy_out_has(x, "set_model");
  agy_t_reset(x);
  // a model agy lists, named with its level: as given, nothing lowered
  #assert agy_configure(x, opened, "gemini-4-hydrogen-low", "") == 0 && x[0].hold == 1 && !agy_out_has(x, "thought_level");
  agy_t_reset(x);
  #assert agy_configure(x, AGY_OPENED_MEDIUM, "gemini-4-argon-medium", "") == 0 && x[0].hold == 1;
  #assert agy_out_has(x, "\"modelId\":\"gemini-4-argon-medium\"") && !agy_out_has(x, "thought_level") && !agy_out_has(x, "argon-low");
  agy_t_reset(x);
  // an effort named: kept, whatever the model
  #assert agy_configure(x, AGY_OPENED_MEDIUM, "gemini-4-argon", "medium") == 0 && agy_out_has(x, "\"value\":\"gemini-4-argon\"") && agy_out_has(x, "\"configId\":\"thought_level\",\"value\":\"medium\"") && !agy_out_has(x, "argon-low");
  agy_t_reset(x);
  // our default unoffered is quiet; an owner's effort unoffered is reported
  #assert agy_configure(x, "{\"models\":{\"availableModels\":[]}}", "", "") == 0 && x[0].hold == 0;
  #assert agy_configure(x, "{\"models\":{\"availableModels\":[]}}", "", "high") == AGY_EFFORT_NOT_APPLIED;
}

#test "antigravity: a caller's own default level (agyworker's medium) is set as the low one is" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [8192] u8; out: [4096] u8;
  x := xb[..]; agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  r := AGY_OPENED_DEFAULT;
  agy_t_reset(x);
  // no model: agy's own, at thought_level medium
  #assert agy_configure_at(x, r, "", "", "", "medium") == 0 && agy_out_has(x, "\"configId\":\"thought_level\",\"value\":\"medium\"") && !agy_out_has(x, "set_model");
  agy_t_reset(x);
  // a base model with a listed -medium variant: that variant, and no thought level besides
  #assert agy_configure_at(x, r, "gemini-4-carbon", "", "", "medium") == 0 && agy_out_has(x, "\"modelId\":\"gemini-4-carbon-medium\"") && !agy_out_has(x, "thought_level");
  agy_t_reset(x);
  // a base model with none listed: as named, at thought_level medium
  #assert agy_configure_at(x, r, "gemini-4-argon", "", "", "medium") == 0 && agy_out_has(x, "\"configId\":\"model\",\"value\":\"gemini-4-argon\"") && agy_out_has(x, "\"value\":\"medium\"");
  agy_t_reset(x);
  // a model named with its level, or an effort the owner set, is kept
  #assert agy_configure_at(x, r, "gemini-4-argon-low", "", "", "medium") == 0 && agy_out_has(x, "\"modelId\":\"gemini-4-argon-low\"") && !agy_out_has(x, "thought_level");
  agy_t_reset(x);
  #assert agy_configure_at(x, r, "", "low", "", "medium") == 0 && agy_out_has(x, "\"configId\":\"thought_level\",\"value\":\"low\"");
  agy_t_reset(x);
  // and the model it names follows the same choices
  ab: [8192] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}]; o: [128] u8;
  #assert agy_effective_at(r, "", "", "medium", ar[..], o[..]) == "gemini-4-carbon-medium";
  #assert agy_effective_at(r, "", "low", "medium", ar[..], o[..]) == "gemini-4-carbon-low";
  #assert agy_effective_at(r, "gemini-4-argon-high", "", "medium", ar[..], o[..]) == "gemini-4-argon-high";
  o2: [128] u8;
  #assert agy_effective_at(r, "", "", AGY_EFFORT, ar[..], o[..]) == agy_effective_model(r, "", "", ar[..], o2[..]) && cast(string) o2[0..<19] == "gemini-4-carbon-low";
}

#test "antigravity: agy_configure_at and agy_effective_at 1-char and truncation boundaries" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [8192] u8; out: [4096] u8;
  x := xb[..]; agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  r := "{\"models\":{\"currentModelId\":\"m\",\"availableModels\":[{\"modelId\":\"m\"},{\"modelId\":\"m-e\"}]},\"configOptions\":[{\"id\":\"t\",\"category\":\"thought_level\",\"currentValue\":\"e\",\"options\":[{\"value\":\"e\"},{\"value\":\"\"}]}],\"modes\":{\"currentModeId\":\"x\",\"availableModes\":[{\"id\":\"default\"},{\"id\":\"a\"},{\"id\":\"x\"}]}}";
  // 1-char model, 1-char effort, 1-char configId, 1-char want_mode
  agy_t_reset(x);
  #assert agy_configure_at(x, r, "m", "e", "a", "low") == 0 && agy_out_has(x, "\"modelId\":\"m\"") && agy_out_has(x, "\"configId\":\"t\",\"value\":\"e\"") && agy_out_has(x, "\"modeId\":\"a\"");
  // empty want_mode falls back to AGY_MODE ("default"); missing 1-char effort reports AGY_EFFORT_NOT_APPLIED
  agy_t_reset(x);
  #assert agy_configure_at(x, r, "", "z", "", "low") == AGY_EFFORT_NOT_APPLIED && agy_out_has(x, "\"modeId\":\"default\"");
  // empty level (effort "" and fallback "") does not call cue_set even when "" is an option
  agy_t_reset(x);
  #assert agy_configure_at(x, r, "", "", "x", "") == 0 && !agy_out_has(x, "set_config_option");
  // model + "-" + fallback truncated to lb.count (160) is not treated as a listed model
  long_m: [158] u8; for i: 0..<158 { long_m[i] = 'm'; }
  long_id: [160] u8; for i: 0..<158 { long_id[i] = 'm'; } long_id[158] = '-'; long_id[159] = 'e';
  rb: [512] u8; rn := cl_copy(rb[..], "{\"models\":{\"availableModels\":[{\"modelId\":\"");
  rn += cl_copy(rb[rn..<rb.count], cast(string) long_id[..]);
  rn += cl_copy(rb[rn..<rb.count], "\"}]}}");
  agy_t_reset(x);
  #assert agy_configure_at(x, cast(string) rb[0..<rn], cast(string) long_m[..], "", "", "extra") == AGY_MODEL_NOT_APPLIED;
  // agy_effective_at: 1-char model & effort, listed model with effort vs without effort, and out truncation
  ab: [8192] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}]; o: [128] u8;
  #assert agy_effective_at(r, "m", "", "e", ar[..], o[..]) == "m";
  #assert agy_effective_at(r, "m", "e", "low", ar[..], o[..]) == "m-e";
  #assert agy_effective_at(r, "m", "z", "e", ar[..], o[..]) == "m";
  short_o: [3] u8;
  r_short := "{\"models\":{\"availableModels\":[{\"modelId\":\"m-h\"}]}}";
  #assert agy_effective_at(r_short, "m", "hi", "low", ar[..], short_o[..]) == "m";
}

#test "antigravity: a session in another mode is set back to default" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [4096] u8; out: [2048] u8;
  x := xb[..]; agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  c := x[0].c; c[0].session_n = cu_keep(c[0].session[..], "g-1");
  cu_outbox_clear(c);
  r := "{\"modes\":{\"currentModeId\":\"auto\",\"availableModes\":[{\"id\":\"default\"},{\"id\":\"auto\"}]}}";
  #assert agy_configure(x, r, "", "") == 0 && x[0].hold == 1 && agy_out_has(x, "\"method\":\"session/set_mode\",\"params\":{\"sessionId\":\"g-1\",\"modeId\":\"default\"}");
  cu_outbox_clear(c);
  #assert agy_configure(x, "{\"modes\":{\"currentModeId\":\"plan\",\"availableModes\":[{\"id\":\"plan\"}]}}", "", "") == 0 && x[0].hold == 0 && cu_outbox(c).count == 0;
}

#test "antigravity: the credentials file keeps the four sign-in names, first of each, nothing else" {
  e: [1] AgyEnv;
  agy_env_parse("# Antigravity on Google Cloud\nAGY_ADC_AUTH=1\n  GOOGLE_APPLICATION_CREDENTIALS=/k/sa.json  \nGEMINI_API_KEY=secret\nGOOGLE_CLOUD_PROJECT=p1\r\nGOOGLE_CLOUD_PROJECT=p2\nGOOGLE_CLOUD_LOCATION=\nnot a line\n", e[..]);
  #assert e[0].nvars == 3;
  #assert e[0].vars[0] == "AGY_ADC_AUTH=1" && e[0].vars[1] == "GOOGLE_APPLICATION_CREDENTIALS=/k/sa.json" && e[0].vars[2] == "GOOGLE_CLOUD_PROJECT=p1";
  #assert agy_env_has(e[..], "GOOGLE_CLOUD_PROJECT") && !agy_env_has(e[..], "GOOGLE_CLOUD") && !agy_env_has(e[..], "GEMINI_API_KEY");
  f: [1] AgyEnv; agy_env_parse("", f[..]); #assert f[0].nvars == 0;
}

#test "antigravity: signed out, paths outside, and the agent's quirks" {
  #assert agy_signed_out("Authentication required") && agy_signed_out("Authentication expired. Please log back in.");
  #assert !agy_signed_out("Unknown model ID: nope") && !agy_signed_out("");
  ab: [4096] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  #assert agy_outside("{\"rawInput\":{\"Path\":\"/w/../etc/passwd\"}}", ar[..]) && agy_outside("{\"rawInput\":{\"Cwd\":\"..\"}}", ar[..]);
  #assert agy_outside("{\"rawInput\":{\"path\":\"foo\\\\..\\\\secret\"}}", ar[..]);
  #assert !agy_outside("{\"rawInput\":{\"Path\":\"/w/a..b\",\"CommandLine\":\"cd .. && ls\"}}", ar[..]);
  #assert agy_outside_cwd("{\"rawInput\":{\"AbsolutePath\":\"/etc/passwd\"}}", "/w/repo", ar[..]);
  #assert agy_outside_cwd("{\"rawInput\":{\"TargetFile\":\"/w/repo2/file.txt\"}}", "/w/repo", ar[..]);
  #assert agy_outside_cwd("{\"locations\":[{\"path\":\"/tmp/escape.txt\"}]}", "/w/repo", ar[..]);
  #assert !agy_outside_cwd("{\"rawInput\":{\"AbsolutePath\":\"/w/repo/src/a.txt\"},\"locations\":[{\"path\":\"/w/repo/src/a.txt\"}]}", "/w/repo", ar[..]);
  a := agy_agent();
  #assert a.program == "agy" && a.login == "" && a.resume == CU_SESSION_RESUME && a.unset_n == 0;
  c := cu_agent_cursor();
  #assert c.program == "agent" && c.login == "cursor_login" && c.resume == CU_SESSION_LOAD && c.unset_n == 2;
}

// ---------------------------------------------------------------- for owners of either agent

// Whether the engine's agent is Antigravity's (else Cursor's).
agy_is :: (x: [] CuEngine) -> bool { return cue_profile(x).program == "agy"; }
// The agent's name in what an owner shows: "Antigravity" or "Cursor".
cue_title :: (x: [] CuEngine) -> string { return ifx agy_is(x) then "Antigravity" else "Cursor"; }

agy_put_int :: (out: [] u8, n: int, v: int) -> int {
  d: [20] u8; k := 0; u := ifx v < 0 then 0 else v;
  while true { d[k] = cast(u8) ('0' + u % 10); k += 1; u = u / 10; if u == 0 || k == d.count { break; } }
  m := n;
  while k > 0 && m < out.count { k -= 1; out[m] = d[k]; m += 1; }
  return m;
}
// What the stall watchdog just did (cue_watch's code), as one line for the owner's log and chat; "" for none.
cue_watch_notice :: (x: [] CuEngine, code: int, out: [] u8) -> string {
  if code == CUE_WATCH_NONE || code == CUE_WATCH_BG_DONE { return ""; }
  n := cl_copy(out, cue_title(x));
  s := (x[0].silent_ms + 500) / 1000;
  if code == CUE_WATCH_ENDED {
    n += cl_copy(out[n..<out.count], " did not answer the cancel within "); n = agy_put_int(out, n, s); n += cl_copy(out[n..<out.count], " s. It was closed.");
    return cast(string) out[0..<n];
  }
  n += cl_copy(out[n..<out.count], " sent nothing for "); n = agy_put_int(out, n, s); n += cl_copy(out[n..<out.count], " s");
  if code == CUE_WATCH_RECOVERING {
    n += cl_copy(out[n..<out.count], ". The turn was cancelled and asked to continue (recovery "); n = agy_put_int(out, n, x[0].recovered);
    n += cl_copy(out[n..<out.count], " of "); n = agy_put_int(out, n, x[0].recover_max); n += cl_copy(out[n..<out.count], ").");
  } else {
    n += cl_copy(out[n..<out.count], " again after "); n = agy_put_int(out, n, x[0].recover_max);
    n += cl_copy(out[n..<out.count], ifx x[0].recover_max == 1 then " recovery. The turn was cancelled." else " recoveries. The turn was cancelled.");
  }
  return cast(string) out[0..<n];
}
// Why a turn the watchdog gave up on failed, for the turn's end.
cue_stall_why :: (x: [] CuEngine, out: [] u8) -> string {
  n := cl_copy(out, cue_title(x)); n += cl_copy(out[n..<out.count], " stopped answering: silent for "); n = agy_put_int(out, n, (x[0].silent_ms + 500) / 1000);
  n += cl_copy(out[n..<out.count], " s after "); n = agy_put_int(out, n, x[0].recovered); n += cl_copy(out[n..<out.count], ifx x[0].recovered == 1 then " recovery." else " recoveries.");
  return cast(string) out[0..<n];
}

#test "antigravity: the watchdog's notices say what happened, plainly" {
  xb: [1] CuEngine; x := xb[..]; cue_agent(x, agy_agent());
  cue_watch_set(x, 120000, 2); x[0].silent_ms = 120400; x[0].recovered = 1;
  ob: [256] u8;
  #assert cue_watch_notice(x, CUE_WATCH_NONE, ob[..]) == "";
  #assert cue_watch_notice(x, CUE_WATCH_RECOVERING, ob[..]) == "Antigravity sent nothing for 120 s. The turn was cancelled and asked to continue (recovery 1 of 2).";
  x[0].recovered = 2;
  #assert cue_watch_notice(x, CUE_WATCH_GAVE_UP, ob[..]) == "Antigravity sent nothing for 120 s again after 2 recoveries. The turn was cancelled.";
  #assert cue_watch_notice(x, CUE_WATCH_ENDED, ob[..]) == "Antigravity did not answer the cancel within 120 s. It was closed.";
  #assert cue_stall_why(x, ob[..]) == "Antigravity stopped answering: silent for 120 s after 2 recoveries.";
  cue_watch_set(x, 9000, 1); x[0].silent_ms = 9000; x[0].recovered = 1;
  #assert cue_watch_notice(x, CUE_WATCH_GAVE_UP, ob[..]) == "Antigravity sent nothing for 9 s again after 1 recovery. The turn was cancelled.";
  #assert agy_put_int(ob[..], 0, 0) == 1 && ob[0] == '0';
}

#test "antigravity: the engine names its agent" {
  xb: [1] CuEngine;
  #assert !agy_is(xb[..]) && cue_title(xb[..]) == "Cursor";
  cue_agent(xb[..], agy_agent());
  #assert agy_is(xb[..]) && cue_title(xb[..]) == "Antigravity";
}

#test "antigravity: version gate accepts >= 1.5.10, >= 2.0.0 and date-stamped RCs, and refuses < 1.5.10" {
  #assert agy_version_ok("");
  #assert agy_version_ok("1.5.10") && agy_version_ok("1.5.14") && agy_version_ok("1.9.0-rc1");
  #assert agy_version_ok("agy_acp_server_1.5.10") && agy_version_ok("agy_acp_server_1.5.14") && agy_version_ok("v1.6.1");
  #assert agy_version_ok("2.0.0") && agy_version_ok("agy_acp_server_2.0.0") && agy_version_ok("agy_acp_server_20261120_1_rc");
  #assert !agy_version_ok("1.5.9") && !agy_version_ok("1.5.0") && !agy_version_ok("1.4.12") && !agy_version_ok("agy_acp_server_1.4.9") && !agy_version_ok("0.9.0") && !agy_version_ok("not-a-version");
  #assert agy_check_version("agy_acp_server_1.5.14") == "";
  why := agy_check_version("agy_acp_server_1.5.9");
  #assert why.count > 0 && agy_has(why, AGY_INSTALL);
}

#test "antigravity: launch sets AGY_CLI_DISABLE_AUTO_UPDATE and optional isolated profile flags and env" {
  e: [1] AgyEnv; l: [1] CuLaunch;
  agy_prepare_launch(l[..], e[..], "agy", "/w", "", false, false, false);
  #assert l[0].args_n == 0 && l[0].env_n == 1 && l[0].env[0] == "AGY_CLI_DISABLE_AUTO_UPDATE=1";

  e2: [1] AgyEnv; l2: [1] CuLaunch;
  agy_prepare_launch(l2[..], e2[..], "agy", "/w", "", true, false, false);
  #assert l2[0].args_n == 0 && l2[0].env_n == 0;

  e3: [1] AgyEnv; l3: [1] CuLaunch;
  agy_prepare_launch(l3[..], e3[..], "agy", "/w", "/tmp/agy-prof", false, false, false);
  #assert l3[0].args_n == 4 && l3[0].args[0] == "--gemini-dir" && l3[0].args[1] == "/tmp/agy-prof";
  #assert l3[0].args[2] == "--app-data-dir" && l3[0].args[3] == "antigravity-acp";
  #assert l3[0].env_n == 4 && l3[0].unset_n == AGY_REMOVED_ENV_COUNT;
  #assert l3[0].env[0] == "AGY_CLI_DISABLE_AUTO_UPDATE=1";
  #assert l3[0].env[1] == "AGY_ACP_FORCE_FILE_STORAGE=1";
  #assert l3[0].env[2] == "GEMINI_HOME=/tmp/agy-prof";
  #assert l3[0].env[3] == "SSH_CONNECTION=127.0.0.1 0 127.0.0.1 0";

  e4: [1] AgyEnv; l4: [1] CuLaunch;
  agy_prepare_launch(l4[..], e4[..], "agy", "/w", "/tmp/agy-prof", true, true, true);
  #assert l4[0].args_n == 4 && l4[0].env_n == 1 && l4[0].env[0] == "AGY_ACP_FORCE_FILE_STORAGE=1";
}

#test "antigravity: configure_mode selects auto when advertised and falls back to default otherwise" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; c := cb[..]; agy_test(x, c, pb[..], line[..], arena[..], out[..]);
  c[0].session_n = cu_keep(c[0].session[..], "g-1");
  cu_outbox_clear(c);
  r_auto := "{\"modes\":{\"currentModeId\":\"default\",\"availableModes\":[{\"id\":\"default\"},{\"id\":\"auto\"}]}}";
  #assert agy_configure_mode(x, r_auto, "", "", AGY_MODE_AUTO) == 0 && x[0].hold == 1;
  #assert agy_out_has(x, "\"method\":\"session/set_mode\",\"params\":{\"sessionId\":\"g-1\",\"modeId\":\"auto\"}");
  cu_outbox_clear(c);
  r_no_auto := "{\"modes\":{\"currentModeId\":\"plan\",\"availableModes\":[{\"id\":\"default\"},{\"id\":\"plan\"}]}}";
  #assert agy_configure_mode(x, r_no_auto, "", "", AGY_MODE_AUTO) == 0 && x[0].hold == 1;
  #assert agy_out_has(x, "\"method\":\"session/set_mode\",\"params\":{\"sessionId\":\"g-1\",\"modeId\":\"default\"}");
}

#test "antigravity: capability flags, lost thinking-signature detection, and held-turn steering" {
  a := agy_agent();
  #assert a.defer_finalize_background && a.steers_with_prompt;
  #assert agy_lost_thinking_signature("Invalid signature in thinking block") && agy_lost_thinking_signature("missing thought_signature on resumed turn");
  #assert agy_lost_thinking_signature("corrupted thought signature") && !agy_lost_thinking_signature("RESOURCE_EXHAUSTED") && !agy_lost_thinking_signature("");

  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; c := cb[..]; agy_test(x, c, pb[..], line[..], arena[..], out[..]);
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"sessionId\":\"g-bg\"}}");
  #assert ev.kind == CuEventKind.answered && x[0].ready && cue_last_session(x) == "g-bg";
  #assert cue_send(x, "start bg");
  ev = cue_feed(x, CUE_T_BG_EXEC);
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"stopReason\":\"end_turn\"}}");
  #assert ev.kind == CuEventKind.none && cue_held_bg(x);
  cu_outbox_clear(c);
  // Mid-turn steer while held sends session/prompt directly without session/cancel.
  #assert cue_steer(x, "follow up") && !cue_held_bg(x);
  #assert agy_out_has(x, "session/prompt") && !agy_out_has(x, "session/cancel");
}

#test "antigravity: 1.5 reliability helpers (thoughtTokens de-dup, mid-turn 404 watcher, snippet patch)" {
  // 1. thoughtTokens folded into outputTokens is not double-counted
  u1 := agy_parse_usage("{\"inputTokens\":20482,\"outputTokens\":4146,\"cachedReadTokens\":39899,\"cachedWriteTokens\":0,\"thoughtTokens\":1587,\"totalTokens\":64527}");
  #assert u1.input == 20482 && u1.cached_read == 39899 && u1.thought == 1587 && u1.output == 2559 && u1.total == 64527;
  // When thoughtTokens is separate from outputTokens (total == input + cached + output + thought), keep output intact
  u2 := agy_parse_usage("{\"inputTokens\":100,\"outputTokens\":50,\"cachedReadTokens\":0,\"cachedWriteTokens\":0,\"thoughtTokens\":20,\"totalTokens\":170}");
  #assert u2.output == 50 && u2.thought == 20;

  // 2. Mid-turn 404 / upstream error detection
  ab: [2048] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  eb: [512] u8;
  err404 := agy_log_upstream_error("{\"type\":\"PLANNER_RESPONSE\",\"status\":\"ERROR\",\"content\":\"HTTP 404 Not Found\"}", ar[..], eb[..]);
  #assert s_has(err404, "404") && s_has(err404, "retryable");
  #assert agy_log_upstream_error("{\"type\":\"PLANNER_RESPONSE\",\"status\":\"DONE\",\"content\":\"All good.\"}", ar[..], eb[..]) == "";

  // 3. Snippet patch detection
  #assert agy_is_snippet_patch("fn foo() {\n...\n}");
  #assert !agy_is_snippet_patch("--- a/x\n+++ b/x\n@@ -1,2 +1,2 @@\n-a\n+b\n");
  #assert !agy_is_snippet_patch("");
}

#test "antigravity: OAuth --login launch, profile env stripping, callback validation, sign-out drain, and skills.json" {
  e: [1] AgyEnv; l: [1] CuLaunch;
  agy_prepare_login(l[..], e[..], "/usr/local/bin/agy", "/tmp", "/tmp/p1");
  #assert l[0].args_n == 5 && l[0].args[0] == "--gemini-dir" && l[0].args[1] == "/tmp/p1" && l[0].args[4] == "--login";
  #assert l[0].unset_n == AGY_REMOVED_ENV_COUNT + 2 && l[0].unset[0] == "GEMINI_API_KEY" && l[0].unset[AGY_REMOVED_ENV_COUNT] == "DISPLAY" && l[0].unset[AGY_REMOVED_ENV_COUNT + 1] == "WAYLAND_DISPLAY";

  ub: [256] u8;
  #assert agy_parse_oauth_url("Open https://accounts.google.com/o/oauth2/v2/auth?client_id=abc in your browser.", ub[..]) == "https://accounts.google.com/o/oauth2/v2/auth?client_id=abc";
  #assert agy_parse_oauth_url("Open https://evil.example.com/oauth in your browser.", ub[..]) == "";
  #assert agy_validate_callback_url("http://127.0.0.1:41234/callback?code=xyz&state=1");
  #assert agy_validate_callback_url("http://localhost:8080/cb?code=abc");
  #assert !agy_validate_callback_url("https://evil.example.com/?code=abc");
  #assert !agy_validate_callback_url("http://127.0.0.1:41234/callback?state=1");

  // Sign-out drain clears session/resume state
  xb: [1] CuEngine; x := xb[..];
  x[0].nresume = 3; x[0].last_session_n = 4; x[0].restart_required = true; x[0].ready = true;
  agy_signout_drain(x);
  #assert x[0].nresume == 0 && x[0].last_session_n == 0 && !x[0].restart_required && !x[0].ready;

  // skills.json discovery & Layer-1 edge cases (#13837, #14024)
  ab: [2048] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  sb: [256] u8;
  sn := agy_parse_skills_json("{\"skills\":[{\"name\":\"coax-review\"},{\"name\":\"git-hygiene\"}]}", ar[..], sb[..]);
  #assert cast(string) sb[0..<sn] == "coax-review\ngit-hygiene";
  // null lists must not fail or treat outer object as array
  ar[0].at = 0;
  #assert agy_parse_skills_json("{\"skills\":null,\"files\":null,\"include_only\":null,\"exclude\":null}", ar[..], sb[..]) == 0;
  // ~/ entries skipped, file-listed skills parsed, literal filter matching (no glob)
  ar[0].at = 0;
  sn2 := agy_parse_skills_json("{\"skills\":[{\"name\":\"a*\",\"path\":\"/ok/a*\"},{\"name\":\"skip-tilde\",\"path\":\"~/never/SKILL.md\"}],\"files\":[\"/repo/skills/deploy/SKILL.md\",\"~/bad/SKILL.md\",\"/repo/docs/lint.md\"],\"include_only\":[\"a*\",\"deploy\"],\"exclude\":[\"lint\"]}", ar[..], sb[..]);
  #assert cast(string) sb[0..<sn2] == "a*\ndeploy";
  // include_only: [] allows none; include_only: null allows all except excluded
  ar[0].at = 0;
  #assert agy_parse_skills_json("{\"skills\":[{\"name\":\"x\"}],\"include_only\":[]}", ar[..], sb[..]) == 0;
  ar[0].at = 0;
  sn3 := agy_parse_skills_json("{\"skills\":[{\"name\":\"x\"},{\"name\":\"y\"}],\"include_only\":null,\"exclude\":[\"y\"]}", ar[..], sb[..]);
  #assert cast(string) sb[0..<sn3] == "x";
}

#test "antigravity: index DB filtering and read-only CLI token extraction (#13838)" {
  #assert agy_is_index_db("index.db");
  #assert agy_is_index_db("/home/me/.gemini/antigravity-acp/index.db");
  #assert agy_is_index_db("/home/me/.gemini/antigravity-acp/conversations-index.db");
  #assert agy_is_index_db("cache.index.db");
  #assert agy_is_index_db("index.db-wal") && agy_is_index_db("index.sqlite");
  #assert !agy_is_index_db("session-abc123.db") && !agy_is_index_db("transcript.jsonl") && !agy_is_index_db("");

  tb: [128] u8;
  #assert agy_read_cli_token("{\"token\":{\"access_token\":\"ya29.test-tok\",\"refresh_token\":\"1//ref\"}}", tb[..]) == "ya29.test-tok";
  #assert agy_read_cli_token("{\"access_token\":\"ya29.top\"}", tb[..]) == "ya29.top";
  #assert agy_read_cli_token("{}", tb[..]) == "";
  #assert agy_read_cli_token("", tb[..]) == "";

  pb: [512] u8;
  #assert agy_token_path_join("/home/me", "/tmp/p1", true, pb[..]) == "/tmp/p1/antigravity-acp/antigravity-oauth-token";
  #assert agy_token_path_join("/home/me", "", true, pb[..]) == "/home/me/.gemini/antigravity-acp/antigravity-oauth-token";
  #assert agy_token_path_join("/home/me", "", false, pb[..]) == "/home/me/.gemini/antigravity-cli/antigravity-oauth-token";
}

#test "antigravity: managed CLI release manifest, version leases, pruning, and Windows .cmd launcher (#13839)" {
  // 1. Target mapping & release manifest validation
  tb: [32] u8;
  #assert agy_cli_target("darwin", "arm64", false, tb[..]) == "darwin_arm64";
  #assert agy_cli_target("linux", "x64", true, tb[..]) == "linux_amd64_musl";
  #assert agy_cli_target("windows", "x64", false, tb[..]) == "windows_amd64";
  #assert agy_cli_target("freebsd", "x64", false, tb[..]) == "";

  sha := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rel: [1] AgyRelease;
  m_mac := "{\"version\":\"1.5.12\",\"url\":\"https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.12-20261120/darwin-arm/cli_mac_arm64.tar.gz\",\"sha512\":\"0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}";
  #assert agy_parse_release(m_mac, "darwin", "arm64", false, rel[..]);
  #assert cast(string) rel[0].version[0..<rel[0].nversion] == "1.5.12" && rel[0].is_tar_gz;
  #assert cast(string) rel[0].exe[0..<rel[0].nexe] == "antigravity";
  #assert cast(string) rel[0].sha512[0..<rel[0].nsha512] == sha;

  m_win := "{\"version\":\"1.5.12\",\"url\":\"https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.12-99/windows-x64/cli_windows_x64.exe\",\"sha512\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}";
  #assert agy_parse_release(m_win, "windows", "x64", false, rel[..]);
  #assert !rel[0].is_tar_gz && cast(string) rel[0].exe[0..<rel[0].nexe] == "agy.exe";

  // Refuse spoofed URL or < 1.5.0 version
  m_evil := "{\"version\":\"1.5.12\",\"url\":\"https://evil.example.com/1.5.12-1/darwin-arm/cli_mac_arm64.tar.gz\",\"sha512\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}";
  #assert !agy_parse_release(m_evil, "darwin", "arm64", false, rel[..]);
  m_old := "{\"version\":\"1.4.9\",\"url\":\"https://storage.googleapis.com/antigravity-public/antigravity-cli/1.4.9-1/darwin-arm/cli_mac_arm64.tar.gz\",\"sha512\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}";
  #assert !agy_parse_release(m_old, "darwin", "arm64", false, rel[..]);

  // 2. Immutable paths, atomic active pointer, and version leases preventing pruning
  rid_a := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
  rid_b := "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
  rid_c := "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
  rb: [256] u8; root := agy_managed_root("/home/me", rb[..]);
  #assert root == "/home/me/.openagents/runtimes/agy";
  eb: [512] u8;
  #assert agy_managed_exe_path(root, rid_a, false, eb[..]) == "/home/me/.openagents/runtimes/agy/releases/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/antigravity";
  #assert agy_managed_exe_path(root, rid_a, true, eb[..]) == "/home/me/.openagents/runtimes/agy/releases/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/agy.exe";
  ab: [128] u8; aj := agy_format_active_release(rid_b, ab[..]);
  idb: [80] u8;
  #assert agy_parse_active_release(aj, idb[..]) == rid_b;
  #assert agy_parse_active_release("{\"releaseId\":\"../escape\"}", idb[..]) == "";

  leases: [1] AgyLeases;
  #assert agy_lease_acquire(leases[..], rid_a, 4242) >= 0;
  #assert agy_lease_count(leases[..], rid_a) == 1;
  // rid_a is leased, rid_b is active, rid_c is unleased & inactive
  #assert !agy_can_prune_release(leases[..], rid_b, rid_a);
  #assert !agy_can_prune_release(leases[..], rid_b, rid_b);
  #assert agy_can_prune_release(leases[..], rid_b, rid_c);
  // Once process 4242 exits and releases its lease, rid_a becomes prunable
  #assert agy_lease_release(leases[..], rid_a, 4242);
  #assert agy_can_prune_release(leases[..], rid_b, rid_a);

  // 3. Windows .cmd launcher wrapping & lock retry backoff
  #assert agy_is_windows_cmd("C:\\Users\\me\\bin\\agy.cmd") && agy_is_windows_cmd("AGY.CMD") && agy_is_windows_cmd("agy.bat");
  #assert !agy_is_windows_cmd("/usr/local/bin/agy") && !agy_is_windows_cmd("agy.exe");
  e: [1] AgyEnv; l: [1] CuLaunch;
  agy_prepare_launch(l[..], e[..], "C:\\bin\\agy.cmd", "C:\\work", "C:\\prof", false, false, false);
  #assert agy_wrap_windows_cmd(l[..]);
  #assert l[0].program == "cmd.exe" && l[0].raw_args && l[0].args_n == 9;
  #assert l[0].args[0] == "/d" && l[0].args[1] == "/s" && l[0].args[2] == "/c" && l[0].args[3] == "C:\\bin\\agy.cmd" && l[0].args[4] == "acp" && l[0].args[5] == "--gemini-dir";
  #assert agy_win_retry_delay_ms(0) == 100 && agy_win_retry_delay_ms(4) == 2000 && agy_win_retry_delay_ms(5) == -1;

  // 4. Release ID derivation, manifest URL, exe-path extraction, and lease filename parsing
  mub: [256] u8;
  #assert agy_manifest_url("darwin", "arm64", false, mub[..]) == "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/darwin_arm64.json";
  #assert agy_manifest_url("windows", "x64", false, mub[..]) == "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/windows_amd64.json";
  ridb: [80] u8;
  #assert agy_release_id_from_sha512(sha, ridb[..]) == "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  exeb: [256] u8;
  exe_p := agy_managed_exe_path("/tmp/agy", rid_a, false, exeb[..]);
  #assert agy_release_id_from_exe_path("/tmp/agy", exe_p, ridb[..]) == rid_a;
  #assert agy_release_id_from_exe_path("/tmp/agy", "/usr/local/bin/agy", ridb[..]) == "";
  lfb: [256] u8;
  lf := agy_lease_file_path("/tmp/agy", rid_a, 9876, lfb[..]);
  #assert agy_parse_lease_filename(fs_base(lf), ridb[..]) == 9876 && cast(string) ridb[0..<64] == rid_a;
  #assert agy_parse_lease_filename("bad.lease", ridb[..]) == -1;
}

// ---------------------------------------------------------------- T3 parity: OAuth parsing, verification, error classification

AGY_OAUTH_MODE_NONE :: 0;
AGY_OAUTH_MODE_CODE :: 1;      // /o/oauth2/auth -> redirect_uri=https://antigravity.google/oauth-callback
AGY_OAUTH_MODE_LOOPBACK :: 2;  // /o/oauth2/v2/auth -> http://127.0.0.1:<port>/... or http://localhost:<port>/...

agy_hex_val :: (c: u8) -> int {
  if c >= '0' && c <= '9' { return cast(int) (c - '0'); }
  if c >= 'a' && c <= 'f' { return cast(int) (c - 'a' + 10); }
  if c >= 'A' && c <= 'F' { return cast(int) (c - 'A' + 10); }
  return -1;
}

// Percent-decode a query parameter value into out.
agy_url_decode :: (raw: string, out: [] u8) -> string {
  n := 0; i := 0;
  while i < raw.count && n < out.count {
    if raw[i] == '%' && i + 2 < raw.count {
      hi := agy_hex_val(raw[i + 1]); lo := agy_hex_val(raw[i + 2]);
      if hi >= 0 && lo >= 0 { out[n] = cast(u8) ((hi << 4) | lo); n += 1; i += 3; continue; }
    } else if raw[i] == '+' {
      out[n] = ' '; n += 1; i += 1; continue;
    }
    out[n] = raw[i]; n += 1; i += 1;
  }
  return cast(string) out[0..<n];
}

// Extract and percent-decode query parameter `key` from url into out, or "" if absent.
agy_query_param :: (url: string, key: string, out: [] u8) -> string {
  q := -1;
  for i: 0..<url.count { if url[i] == '?' { q = i + 1; break; } }
  if q < 0 || key.count == 0 { return ""; }
  at := q;
  while at < url.count {
    amp := at;
    while amp < url.count && url[amp] != '&' && url[amp] != '#' { amp += 1; }
    eq := at;
    while eq < amp && url[eq] != '=' { eq += 1; }
    if eq < amp && cast(string) url[at..<eq] == key {
      return agy_url_decode(cast(string) url[eq + 1..<amp], out);
    }
    if amp < url.count && url[amp] == '#' { break; }
    at = amp + 1;
  }
  return "";
}

// Parse and validate an Antigravity Google OAuth URL (exact port of T3 parseAntigravityAuthorizationUrl).
// Returns AGY_OAUTH_MODE_CODE (1), AGY_OAUTH_MODE_LOOPBACK (2), or AGY_OAUTH_MODE_NONE (0).
agy_parse_auth_url_detail :: (text: string, url_out: [] u8, state_out: [] u8) -> int {
  url := agy_parse_oauth_url(text, url_out);
  if url.count == 0 { return AGY_OAUTH_MODE_NONE; }
  code_pfx := "https://accounts.google.com/o/oauth2/auth?";
  loop_pfx := "https://accounts.google.com/o/oauth2/v2/auth?";
  is_code := url.count > code_pfx.count && cast(string) url[0..<code_pfx.count] == code_pfx;
  is_loop := url.count > loop_pfx.count && cast(string) url[0..<loop_pfx.count] == loop_pfx;
  if !is_code && !is_loop { return AGY_OAUTH_MODE_NONE; }
  rtb: [64] u8; if agy_query_param(url, "response_type", rtb[..]) != "code" { return AGY_OAUTH_MODE_NONE; }
  cb: [128] u8; if agy_query_param(url, "client_id", cb[..]).count == 0 { return AGY_OAUTH_MODE_NONE; }
  rb: [256] u8; redir := agy_query_param(url, "redirect_uri", rb[..]);
  _ = agy_query_param(url, "state", state_out);
  if is_code && redir == "https://antigravity.google/oauth-callback" { return AGY_OAUTH_MODE_CODE; }
  if (redir.count >= 17 && (cast(string) redir[0..<17] == "http://127.0.0.1:" || cast(string) redir[0..<17] == "http://localhost:")) {
    return AGY_OAUTH_MODE_LOOPBACK;
  }
  return AGY_OAUTH_MODE_NONE;
}

// Parse a pasted authorization code or callback URL (exact port of T3 antigravityLoginResponse).
// Accepts raw code (no whitespace/control chars) OR https://antigravity.google/oauth-callback?state=...&code=...
// (or loopback http://127.0.0.1:.../http://localhost:...). Validates expected_state when non-empty.
// Returns extracted code in out, or "" on error (writing reason into err_out).
agy_parse_login_response :: (raw_input: string, expected_state: string, out: [] u8, err_out: [] u8) -> string {
  a := 0; b := raw_input.count;
  while a < b && raw_input[a] <= 32 { a += 1; }
  while b > a && raw_input[b - 1] <= 32 { b -= 1; }
  if a >= b { _ = cl_copy(err_out, "Paste the sign-in code or callback URL."); return ""; }
  s := cast(string) raw_input[a..<b];
  is_url := (s.count >= 8 && cast(string) s[0..<8] == "https://") || (s.count >= 7 && cast(string) s[0..<7] == "http://");
  if !is_url {
    for c: s {
      if c <= 32 || c == 127 { _ = cl_copy(err_out, "Authorization code must be a single line with no spaces."); return ""; }
    }
    if s.count > out.count { _ = cl_copy(err_out, "Authorization code is too long."); return ""; }
    return cast(string) out[0..<cl_copy(out, s)];
  }
  agy_cb := "https://antigravity.google/oauth-callback";
  is_agy_cb := s.count >= agy_cb.count && cast(string) s[0..<agy_cb.count] == agy_cb;
  is_loop_cb := s.count >= 17 && (cast(string) s[0..<17] == "http://127.0.0.1:" || cast(string) s[0..<17] == "http://localhost:");
  if !is_agy_cb && !is_loop_cb {
    _ = cl_copy(err_out, "Paste the Antigravity callback URL or the sign-in code.");
    return "";
  }
  eb: [128] u8; err_param := agy_query_param(s, "error", eb[..]);
  if err_param.count > 0 {
    n := cl_copy(err_out, "Google sign-in returned an error: ");
    n += cl_copy(err_out[n..<err_out.count], err_param);
    return "";
  }
  if expected_state.count > 0 {
    sb: [256] u8; got_state := agy_query_param(s, "state", sb[..]);
    if got_state != expected_state {
      _ = cl_copy(err_out, "Sign-in callback state does not match this sign-in attempt.");
      return "";
    }
  }
  code := agy_query_param(s, "code", out);
  if code.count == 0 { _ = cl_copy(err_out, "Callback URL does not contain an authorization code."); return ""; }
  return code;
}

// Broad sign-in required error detection (exact port of T3 isAntigravitySignInRequiredError).
agy_is_signin_required :: (message: string) -> bool {
  if agy_signed_out(message) { return true; }
  marks := [17] string.[
    "No browser is available here", "remote (SSH)", "agy acp --login", "-32000",
    "Sign in to Antigravity", "invalid_rapt",
    "not authenticated", "Not authenticated", "UNAUTHENTICATED",
    "please log in", "Please log in", "sign in", "Sign in",
    "invalid_grant", "token expired", "could not find default credentials",
    "Reauthentication is needed"
  ];
  for m: marks { if agy_has(message, m) { return true; } }
  return false;
}

// Translate raw agy ACP auth/SSH errors into clean T3-parity messages (never leaking SSH boilerplate).
agy_format_auth_error :: (raw: string, method: string, for_probe: bool) -> string {
  if !agy_is_signin_required(raw) { return raw; }
  if !for_probe { return AGY_SIGNIN_REQUIRED; }
  m := agy_auth_normalize(method);
  if m == AGY_AUTH_AGENT_PLATFORM && (agy_has(raw, "invalid_rapt") || agy_has(raw, "invalid_grant") || agy_has(raw, "could not find default credentials") || agy_has(raw, "Reauthentication is needed")) {
    return "Google Cloud ADC session expired — run `gcloud auth application-default login` or enter a Vertex AI express API key.";
  }
  if agy_has(raw, "No browser") || agy_has(raw, "remote (SSH)") || agy_has(raw, "agy acp --login") || agy_has(raw, "Authentication required") || agy_has(raw, "-32000") {
    if m == AGY_AUTH_OAUTH_BUSINESS { return "Antigravity is installed. Sign in with Gemini Enterprise to load models."; }
    if m == AGY_AUTH_OAUTH_PERSONAL { return "Antigravity is installed. Sign in with Google to load models."; }
    return "Antigravity could not authenticate with the configured credentials.";
  }
  return raw;
}

// Format Antigravity version for UI display (exact port of T3 getProviderVersionLabel).
// "agy_acp_server_20261120_1_rc" -> "2026-11-20 rc", "1.5.12" -> "v1.5.12".
agy_version_label :: (version: string, out: [] u8) -> string {
  if version.count == 0 { return ""; }
  if version.count >= AGY_VERSION_PREFIX.count + 10 && cast(string) version[0..<AGY_VERSION_PREFIX.count] == AGY_VERSION_PREFIX {
    rest := cast(string) version[AGY_VERSION_PREFIX.count..<version.count];
    all_digits := true;
    for i: 0..<8 { if rest[i] < '0' || rest[i] > '9' { all_digits = false; break; } }
    if all_digits && rest[8] == '_' {
      n := 0;
      n += cl_copy(out[n..<out.count], cast(string) rest[0..<4]);
      n += cl_copy(out[n..<out.count], "-");
      n += cl_copy(out[n..<out.count], cast(string) rest[4..<6]);
      n += cl_copy(out[n..<out.count], "-");
      n += cl_copy(out[n..<out.count], cast(string) rest[6..<8]);
      pos := 9;
      while pos < rest.count && rest[pos] >= '0' && rest[pos] <= '9' { pos += 1; }
      if pos + 1 < rest.count && rest[pos] == '_' {
        n += cl_copy(out[n..<out.count], " ");
        n += cl_copy(out[n..<out.count], cast(string) rest[pos + 1..<rest.count]);
      }
      return cast(string) out[0..<n];
    }
  }
  if version[0] >= '0' && version[0] <= '9' {
    n := cl_copy(out, "v");
    n += cl_copy(out[n..<out.count], version);
    return cast(string) out[0..<n];
  }
  return cast(string) out[0..<cl_copy(out, version)];
}

// Client info name rule (T3 AntigravityAcpSupport.ts): "openagents" on >= 1.5.1, "zed" on 1.5.0.
agy_client_info_name :: (agent_version: string) -> string {
  if agent_version == "1.5.0" || agent_version == "v1.5.0" || agent_version == "agy_acp_server_1.5.0" {
    return "zed";
  }
  return "openagents";
}

// Verify an ACP initialize result from a downloaded managed agy binary (exact port of T3 AntigravityInstallation.ts).
agy_verify_init_result :: (result: string, ar: [] ClArena) -> string {
  name := cl_str(ar, result, "agentInfo.name");
  if name != "Antigravity ACP Server" { return "Downloaded binary is not Antigravity ACP Server."; }
  ver := cl_str(ar, result, "agentInfo.version");
  if !agy_version_ok(ver) { return AGY_OLD_VERSION; }
  if !cl_bool(result, "agentCapabilities.loadSession").value { return "Downloaded Antigravity binary does not support loadSession."; }
  if cl_raw(result, "agentCapabilities.sessionCapabilities.resume").count == 0 { return "Downloaded Antigravity binary does not support session/resume."; }
  return "";
}

// Parse Go duration strings like "1h2m3s", "500ms", "1500us" into milliseconds (T3 AntigravityTurnOutcome.ts).
agy_parse_go_duration_ms :: (dur: string) -> int {
  if dur.count == 0 { return 0; }
  total_ms := 0;
  i := 0;
  while i < dur.count {
    if dur[i] < '0' || dur[i] > '9' { return 0; }
    whole := 0;
    while i < dur.count && dur[i] >= '0' && dur[i] <= '9' { whole = whole * 10 + cast(int) (dur[i] - '0'); i += 1; }
    frac := 0; frac_div := 1;
    if i < dur.count && dur[i] == '.' {
      i += 1;
      while i < dur.count && dur[i] >= '0' && dur[i] <= '9' {
        if frac_div < 1000000 { frac = frac * 10 + cast(int) (dur[i] - '0'); frac_div *= 10; }
        i += 1;
      }
    }
    u0 := i;
    while i < dur.count && (dur[i] < '0' || dur[i] > '9') { i += 1; }
    unit := cast(string) dur[u0..<i];
    if unit == "h" { total_ms += whole * 3600000 + (frac * 3600000) / frac_div; }
    else if unit == "m" { total_ms += whole * 60000 + (frac * 60000) / frac_div; }
    else if unit == "s" { total_ms += whole * 1000 + (frac * 1000) / frac_div; }
    else if unit == "ms" { total_ms += whole + frac / frac_div; }
    else if unit == "us" || unit == "µs" || unit == "μs" { total_ms += whole / 1000; }
    else if unit == "ns" { total_ms += whole / 1000000; }
    else { return 0; }
  }
  return total_ms;
}

#test "antigravity: T3 auth methods, settings.json, 19-key sanitization, OAuth parsing, init verification, and Go durations" {
  // 1. Auth config validation & labels
  #assert agy_auth_normalize("") == AGY_AUTH_OAUTH_PERSONAL;
  #assert agy_auth_normalize("bogus") == AGY_AUTH_OAUTH_PERSONAL;
  #assert agy_auth_normalize("agent-platform") == AGY_AUTH_AGENT_PLATFORM;
  #assert agy_auth_uses_browser("oauth-personal") && agy_auth_uses_browser("oauth-business");
  #assert !agy_auth_uses_browser("gemini-api-key") && !agy_auth_uses_browser("agent-platform");
  #assert agy_auth_label("oauth-personal") == "Google account";
  #assert agy_auth_label("oauth-business") == "Gemini Enterprise";
  #assert agy_auth_label("gemini-api-key") == "Gemini API key";
  #assert agy_auth_label("agent-platform") == "Agent Platform (Vertex AI)";

  #assert agy_auth_config_issue(AgyAuthConfig.{method = "oauth-personal"}) == "";
  #assert agy_auth_config_issue(AgyAuthConfig.{method = "oauth-business"}).count > 0;
  #assert agy_auth_config_issue(AgyAuthConfig.{method = "oauth-business", gcp_project = "p", gcp_location = "us-central1"}) == "";
  #assert agy_auth_config_issue(AgyAuthConfig.{method = "gemini-api-key"}).count > 0;
  #assert agy_auth_config_issue(AgyAuthConfig.{method = "gemini-api-key", api_key = "AIzaTest"}) == "";
  #assert agy_auth_config_issue(AgyAuthConfig.{method = "agent-platform"}).count > 0;
  #assert agy_auth_config_issue(AgyAuthConfig.{method = "agent-platform", api_key = "AIzaExpress"}) == "";
  #assert agy_auth_config_issue(AgyAuthConfig.{method = "agent-platform", gcp_project = "openagentsgemini", gcp_location = "global"}) == "";
  #assert agy_auth_config_issue(AgyAuthConfig.{method = "agent-platform", gcp_project = "openagentsgemini"}).count > 0;

  // 2. settings.json formatting
  jb: [512] u8;
  #assert agy_format_settings_json(AgyAuthConfig.{method = "oauth-personal"}, jb[..]) == "{\"auth\":{\"type\":\"oauth-personal\"}}\n";
  #assert agy_format_settings_json(AgyAuthConfig.{method = "agent-platform", gcp_project = "openagentsgemini", gcp_location = "global"}, jb[..]) == "{\"auth\":{\"type\":\"agent-platform\"},\"gcp\":{\"project\":\"openagentsgemini\",\"location\":\"global\"}}\n";
  #assert agy_format_settings_json(AgyAuthConfig.{method = "agent-platform", api_key = "k1", gcp_project = "ignored"}, jb[..]) == "{\"auth\":{\"type\":\"agent-platform\"}}\n";

  // 3. Full 19-key sanitization & method-specific env injection
  e1: [1] AgyEnv; l1: [1] CuLaunch;
  agy_prepare_launch_auth(l1[..], e1[..], "agy", "/w", "/tmp/p1", AgyAuthConfig.{method = "oauth-personal"});
  #assert l1[0].unset_n == 19 && agy_env_has(e1[..], "AGY_ACP_FORCE_FILE_STORAGE") && agy_env_has(e1[..], "SSH_CONNECTION");
  e2: [1] AgyEnv; l2: [1] CuLaunch;
  agy_prepare_launch_auth(l2[..], e2[..], "agy", "/w", "/tmp/p2", AgyAuthConfig.{method = "agent-platform", api_key = "express-k"});
  #assert l2[0].unset_n == 20 && !agy_env_has(e2[..], "SSH_CONNECTION") && agy_env_has(e2[..], "GOOGLE_API_KEY");
  e3: [1] AgyEnv; l3: [1] CuLaunch;
  agy_prepare_launch_auth(l3[..], e3[..], "agy", "/w", "/tmp/p3", AgyAuthConfig.{method = "gemini-api-key", api_key = "gem-k", skip_permissions = true});
  #assert l3[0].unset_n == 20 && agy_env_has(e3[..], "GEMINI_API_KEY") && !agy_env_has(e3[..], "GOOGLE_API_KEY");
  #assert l3[0].args_n == 5 && l3[0].args[4] == "--dangerously-skip-permissions";

  // 4. OAuth URL detail & login response parsing
  ub: [512] u8; sb: [128] u8;
  m1 := agy_parse_auth_url_detail("Visit https://accounts.google.com/o/oauth2/auth?response_type=code&client_id=cid&state=st42&redirect_uri=https%3A%2F%2Fantigravity.google%2Foauth-callback", ub[..], sb[..]);
  #assert m1 == AGY_OAUTH_MODE_CODE && cast(string) sb[0..<4] == "st42";
  cb: [128] u8; eb: [128] u8;
  #assert agy_parse_login_response("https://antigravity.google/oauth-callback?state=st42&code=4%2Fabc123", "st42", cb[..], eb[..]) == "4/abc123";
  #assert agy_parse_login_response("https://antigravity.google/oauth-callback?state=wrong&code=4%2Fabc123", "st42", cb[..], eb[..]) == "";
  #assert agy_parse_login_response("raw-code-xyz", "st42", cb[..], eb[..]) == "raw-code-xyz";

  // 5. Version label, init verification & Go duration parser
  vb: [64] u8;
  #assert agy_version_label("agy_acp_server_20261120_1_rc", vb[..]) == "2026-11-20 rc";
  #assert agy_version_label("1.5.12", vb[..]) == "v1.5.12";
  #assert agy_client_info_name("1.5.0") == "zed" && agy_client_info_name("1.5.12") == "openagents";
  ab: [2048] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  #assert agy_verify_init_result("{\"agentInfo\":{\"name\":\"Antigravity ACP Server\",\"version\":\"1.5.12\"},\"agentCapabilities\":{\"loadSession\":true,\"sessionCapabilities\":{\"resume\":{}}}}", ar[..]) == "";
  #assert agy_verify_init_result("{\"agentInfo\":{\"name\":\"Other\",\"version\":\"1.5.12\"}}", ar[..]).count > 0;
  #assert agy_parse_go_duration_ms("1h2m3.5s") == 3723500 && agy_parse_go_duration_ms("500ms") == 500;
  #assert agy_is_signin_required("UNAUTHENTICATED: please log in") && agy_is_signin_required("could not find default credentials");
  ssh_err := "No browser is available here (this is a remote (SSH) session, so the browser's sign-in redirect can't reach this machine). Run 'agy acp --login'";
  #assert agy_is_signin_required(ssh_err);
  #assert agy_format_auth_error(ssh_err, "oauth-personal", false) == AGY_SIGNIN_REQUIRED;
  #assert agy_format_auth_error(ssh_err, "oauth-personal", true) == "Antigravity is installed. Sign in with Google to load models.";
  #assert agy_format_auth_error("invalid_rapt: reauth needed", "agent-platform", true) == "Google Cloud ADC session expired — run `gcloud auth application-default login` or enter a Vertex AI express API key.";
}
