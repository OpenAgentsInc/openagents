// The Cursor engine: the person's own Cursor agent (`agent acp`, their Cursor login), driven
// through the Coax Cursor client (coax/lib/agent/cursor), one ACP session per conversation.
// Moved from Coder's terminal (coder/tui/cursor.coax) with no change in behaviour; Coder is its
// first owner.
//
// The engine does the protocol's own steps: it starts the agent and sends initialize, logs in
// once initialize is answered (authenticate), then opens the conversation's session (session/new,
// or session/load of a session to resume, whose replayed history it answers itself: nothing is
// allowed, no plan accepted, no question asked), holds the first message until the session is
// open and every setting sent with it is answered, and closes the agent when it ends. Every
// other event goes to the owner, one at a time (cue_poll), after the engine's part of it: the
// owner prints it, applies its own settings (cue_set), answers permission requests, plans and
// questions under its own rules, and sends the owed message once its settings are out
// (cue_owed).
//
//   cue_attach   the owner's buffers                cue_program  where the agent is (PATH, then the usual places)
//   cue_launch   the agent started, initialize sent  cue_resume   a session to load in place of a new one
//   cue_send     a message: now, or owed            cue_poll     the next event, after the engine's part
//   cue_set      one of the session's settings      cue_owed     the owed message, once nothing is held
//   cue_close    the agent stopped
#load "claude.coax";
#load "../cursor/cursor.coax";

CUE_OWED :: 16384;        // a message owed until the session is open, as Coder kept it

CuEngine :: struct {
  c: [] CuClient; p: [] ClProcess;  // the owner's
  line: [] u8; arena: [] u8; out: [] u8;
  live: bool;                     // the agent is running
  ready: bool;                    // its session is open
  replay: bool;                   // session/load is replaying history: show nothing, allow nothing
  hold: int;                      // setting answers still expected before the owed message goes
  owed: [CUE_OWED] u8; nowed: int; // the message that goes once the session is open
  resume: [CU_ID] u8; nresume: int; // a session to load in place of a new one
  cwd: [1024] u8; ncwd: int;
  err: [2048] u8; err_n: int;     // why the agent stopped, when it said nothing itself
}

cue_attach :: (x: [] CuEngine, c: [] CuClient, p: [] ClProcess, line: [] u8, arena: [] u8, out: [] u8) {
  x[0].c = c; x[0].p = p;
  x[0].line = line; x[0].arena = arena; x[0].out = out;
  x[0].p[0].handle = -1;
}

// Where the agent is: on PATH, else the usual places under HOME ("" when there is none).
cue_program :: (out: [] u8) -> string {
  pb: [8192] u8; path := cl_getenv("PATH", pb[..]);
  hb: [4096] u8; home := cl_getenv("HOME", hb[..]);
  return cu_find(path, home, out);
}

// A fresh client, the agent started in cwd and initialize sent: "" or why it did not start.
cue_launch :: (x: [] CuEngine, program: string, cwd: string, name: string, version: string) -> string {
  x[0].c[0] = CuClient.{};
  cu_init(x[0].c, x[0].line, x[0].arena, x[0].out);
  l: [1] CuLaunch; l[0].program = program; l[0].cwd = cwd;
  why := cu_start(x[0].c, x[0].p, l[0]);
  if why.count > 0 { return why; }
  x[0].ncwd = e_set(x[0].cwd[..], 0, cwd);
  x[0].live = true; x[0].ready = false; x[0].replay = false; x[0].hold = 0;
  r := cu_initialize(x[0].c, name, version);
  return "";
}
cue_resume :: (x: [] CuEngine, session: string) { x[0].nresume = e_set(x[0].resume[..], 0, session); }

// A message: at once on an open session with nothing held, else owed (cut to CUE_OWED). Whether it went.
cue_send :: (x: [] CuEngine, msg: string) -> bool {
  if x[0].live && x[0].ready && x[0].hold == 0 { r := cu_session_prompt(x[0].c, msg); return true; }
  x[0].nowed = e_set(x[0].owed[..], 0, msg);
  return false;
}
// The owed message, once nothing is held and the owner still wants it (its turn is running).
cue_owed :: (x: [] CuEngine, running: bool) {
  if x[0].hold > 0 || x[0].nowed == 0 || !running { return; }
  r := cu_session_prompt(x[0].c, e_str(x[0].owed[..], x[0].nowed));
  x[0].nowed = 0;
}
// One of the session's settings (a model, a thought level): the owed message waits for its answer.
cue_set :: (x: [] CuEngine, id: string, value: string) { r := cu_set_config(x[0].c, id, value); x[0].hold += 1; }

cue_close :: (x: [] CuEngine) {
  if !x[0].live { return; }
  cu_close_process(x[0].p);
  x[0].live = false; x[0].ready = false; x[0].replay = false; x[0].hold = 0;
}

// The next event into ev (idle: nothing more for now), after the engine's part of it. An event
// the engine has answered itself (a replayed request) comes back as none. Never blocks.
cue_poll :: (x: [] CuEngine, ev: [] CuEvent) {
  ev[0] = cu_poll(x[0].c, x[0].p, 0);
  ev[0].kind = cue_take(x, ev[0].kind, ev[0].of);
}
// The engine's part of an event of kind k (of: the request answered); the kind the owner sees.
cue_take :: (x: [] CuEngine, k: CuEventKind, of: int) -> CuEventKind {
  if k == CuEventKind.end || k == CuEventKind.failed { cue_gone(x); return k; }
  if k == CuEventKind.answered || k == CuEventKind.refused || k == CuEventKind.initialized { cue_session(x, k, of); return k; }
  // a replayed history asks nothing of anyone
  if x[0].replay && cue_replayed(x[0].c, k) { return CuEventKind.none; }
  return k;
}
cue_gone :: (x: [] CuEngine) {
  x[0].err_n = 0;
  if cu_error(x[0].c).count == 0 { x[0].err_n = cl_stderr(x[0].p, x[0].err[..]).count; }
  cue_close(x);
}
// Initialize answered, logging in answered, the session opened or refused, a setting answered.
cue_session :: (x: [] CuEngine, k: CuEventKind, of: int) {
  c := x[0].c;
  if k == CuEventKind.initialized { r := cu_authenticate(c); return; }
  cwd := e_str(x[0].cwd[..], x[0].ncwd);
  if k == CuEventKind.answered && of == CU_AUTHENTICATE {
    if x[0].nresume > 0 {
      x[0].replay = true;
      r := cu_session_load(c, e_str(x[0].resume[..], x[0].nresume), cwd);
      x[0].nresume = 0;
    } else { r := cu_session_new(c, cwd); }
    return;
  }
  if k == CuEventKind.refused && of == CU_SESSION_LOAD { x[0].replay = false; x[0].nresume = 0; r := cu_session_new(c, cwd); return; }
  if k == CuEventKind.refused && of == CU_SESSION_SET_CONFIG { x[0].hold -= 1; return; }
  if k == CuEventKind.answered && (of == CU_SESSION_NEW || of == CU_SESSION_LOAD) { x[0].ready = true; x[0].replay = false; return; }
  if k == CuEventKind.answered && of == CU_SESSION_SET_CONFIG { if x[0].hold > 0 { x[0].hold -= 1; } }
}
// A request during a replay, answered: no question asked, no plan accepted, nothing allowed. Whether it was one.
cue_replayed :: (c: [] CuClient, k: CuEventKind) -> bool {
  if k == CuEventKind.question { cu_question(c, true); return true; }
  if k == CuEventKind.plan { cu_plan(c, false); return true; }
  if k == CuEventKind.permission { cu_decline(c); return true; }
  return false;
}
// Why the agent stopped: what the client recorded, else what the agent last wrote to stderr.
cue_why :: (x: [] CuEngine) -> string {
  why := cu_error(x[0].c);
  return ifx why.count > 0 then why else e_str(x[0].err[..], x[0].err_n);
}

// ---------------------------------------------------------------- checks

// An engine over the test's buffers with initialize sent (request 0) and no process.
cue_test :: (x: [] CuEngine, c: [] CuClient, p: [] ClProcess, line: [] u8, arena: [] u8, out: [] u8) {
  cue_attach(x, c, p, line, arena, out);
  cu_init(x[0].c, line, arena, out);
  x[0].live = true; x[0].ncwd = e_set(x[0].cwd[..], 0, "/w");
  r := cu_initialize(x[0].c, "t", "1");
}
cue_feed :: (x: [] CuEngine, line: string) -> CuEvent {
  cu_outbox_clear(x[0].c);
  ev := cu_feed(x[0].c, line);
  ev.kind = cue_take(x, ev.kind, ev.of);
  return ev;
}

// The session opened as the agent opens it: initialize, authenticate, session/new answered.
cue_test_open :: (x: [] CuEngine) {
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"protocolVersion\":1}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"sessionId\":\"s-1\"}}");
}
cue_out_has :: (x: [] CuEngine, part: string) -> bool { return s_has(cu_outbox(x[0].c), part); }

#test "cursor engine: initialize answered logs in, logging in opens a session in the folder" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [1024] u8; out: [2048] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"protocolVersion\":1}}");
  #assert ev.kind == CuEventKind.initialized && cue_out_has(x, "\"method\":\"authenticate\"");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{}}");
  #assert cue_out_has(x, "\"method\":\"session/new\"") && cue_out_has(x, "\"cwd\":\"/w\"");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"sessionId\":\"s-1\"}}");
  #assert x[0].ready && !x[0].replay && cu_outbox(x[0].c).count == 0;
}

#test "cursor engine: a message waits for the session and its settings, then goes once" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [1024] u8; out: [2048] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  #assert !cue_send(x, "hello") && x[0].nowed == 5;
  cue_test_open(x);
  cu_outbox_clear(x[0].c);
  cue_set(x, "model", "fast");
  cue_owed(x, true);
  #assert x[0].hold == 1 && x[0].nowed == 5 && !cue_out_has(x, "session/prompt");
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{}}");
  #assert x[0].hold == 0;
  cue_owed(x, false);
  #assert x[0].nowed == 5;                         // the owner's turn is over: nothing goes
  cue_owed(x, true);
  #assert x[0].nowed == 0 && cue_out_has(x, "\"method\":\"session/prompt\"") && cue_out_has(x, "hello");
  cu_outbox_clear(x[0].c);
  #assert cue_send(x, "again") && cue_out_has(x, "again");
}

#test "cursor engine: a resumed session's replay is answered by the engine" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [1024] u8; out: [2048] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  cue_resume(x, "old-session");
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{}}");
  #assert x[0].replay && x[0].nresume == 0 && cue_out_has(x, "\"method\":\"session/load\"") && cue_out_has(x, "old-session");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"session/request_permission\",\"params\":{\"options\":[{\"optionId\":\"ok\",\"kind\":\"allow_once\"}],\"toolCall\":{\"kind\":\"execute\"}}}");
  #assert ev.kind == CuEventKind.none && cue_out_has(x, "cancelled");
}

#test "cursor engine: a refused load opens a new session, whose requests are the owner's" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [1024] u8; out: [2048] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  cue_resume(x, "old-session");
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-32000,\"message\":\"no such session\"}}");
  #assert ev.kind == CuEventKind.refused && !x[0].replay && cue_out_has(x, "\"method\":\"session/new\"");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"sessionId\":\"s-2\"}}");
  #assert x[0].ready && cu_session_id(x[0].c) == "s-2";
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"session/request_permission\",\"params\":{\"options\":[{\"optionId\":\"ok\",\"kind\":\"allow_once\"}],\"toolCall\":{\"kind\":\"execute\"}}}");
  #assert ev.kind == CuEventKind.permission && cu_outbox(x[0].c).count == 0;
}
