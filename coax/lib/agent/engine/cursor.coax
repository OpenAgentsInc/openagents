// The ACP engine: an agent CLI's Agent Client Protocol server, driven through the shared ACP
// client (coax/lib/agent/cursor), one session per conversation. Cursor (`agent acp`, the
// person's Cursor login) is its first agent and the default; Antigravity (`agy acp`,
// antigravity.coax) is the second, the same engine with its own CuAgent (cue_agent).
// Moved from Coder's terminal (coder/tui/cursor.coax) with no change in behaviour; Coder is its
// first owner.
//
// The engine does the protocol's own steps: it starts the agent and sends initialize, logs in
// once initialize is answered (authenticate, when the agent has a login method), then opens the
// conversation's session (session/new, or session/load of a session to resume, whose replayed
// history it answers itself: nothing is allowed, no plan accepted, no question asked; or
// session/resume, which replays nothing), holds the first message until the session is
// open and every setting sent with it is answered, and closes the agent when it ends. Every
// other event goes to the owner, one at a time (cue_poll), after the engine's part of it: the
// owner prints it, applies its own settings (cue_set), answers permission requests, plans and
// questions under its own rules, and sends the owed message once its settings are out
// (cue_owed).
//
//   cue_attach   the owner's buffers                cue_program  where the agent is (PATH, then the usual places)
//   cue_launch   the agent started, initialize sent  cue_resume   a session to load in place of a new one
//   cue_send     a message: now, or owed            cue_poll     the next event, after the engine's part
//   cue_set      one of the session's settings      cue_owed     the owed message, once nothing is held
//   cue_set_model, cue_set_mode  the same for session/set_model and session/set_mode
//   cue_agent    which agent (Cursor's by default)   cue_start    cue_launch with the owner's own CuLaunch
//   cue_close    the agent stopped
//   cue_watch    the stall watchdog, on the owner's clock  cue_cancel   the owner's stop of a turn
//
// The stall watchdog (GitHub #13193): agy waits a fixed 5 minutes on a model reply that went
// silent before it retries. While a turn is in flight the owner calls cue_watch(now) on every
// poll; if the agent sends nothing at all for stall_ms, while no tool call runs and no question
// waits on the owner, the engine cancels the turn (session/cancel), and when the cancelled turn
// ends it asks the same session to continue (CUE_CONTINUE), at most recover_max times a turn.
// After that a silence cancels the turn for good (cue_stalled), and a cancel unanswered for
// another stall_ms closes the agent. A tool call counts as running from its pending or
// in_progress status to its completed, failed or cancelled one. Off (stall_ms 0) unless set.
#load "claude.coax";
#load "../cursor/cursor.coax";

CUE_OWED :: 98304;        // a message (or multipart prompt blocks) owed until the session is open (#13998, #14002)
CUE_TOOLS :: 16;          // tool calls the watchdog follows at once
CUE_BG_HOLD_LIMIT_MS :: 120000; // safety ceiling for a held detached background turn (Antigravity overrides to 30m)
CUE_BG_USAGE_SETTLE_MS :: 1500; // quiet window after usage_update (with no active bg work) to confirm no tool_call follows (agy emits tool_call 2-5ms after usage_update)
CUE_BG_WAKE_GRACE_MS :: 60000;  // fallback quiet window awaiting reactive wakeup after bg tool finishes when stall_ms is 0
CUE_SLEEP_JUMP_MS :: 15000;     // poll gap treated as host sleep/wake rather than model silence

CuEngine :: struct {
  c: [] CuClient; p: [] ClProcess;  // the owner's
  line: [] u8; arena: [] u8; out: [] u8;
  live: bool;                     // the agent is running
  ready: bool;                    // its session is open
  replay: bool;                   // session/load is replaying history: show nothing, allow nothing
  hold: int;                      // setting answers still expected before the owed message goes
  owed: [CUE_OWED] u8; nowed: int; // the message that goes once the session is open
  owed_blocks: bool;              // true when owed holds pre-encoded ACP prompt blocks JSON (#14002)
  resume: [CU_ID] u8; nresume: int; // a session to load in place of a new one
  last_session: [CU_ID] u8; last_session_n: int; // last open session id for crash auto-respawn
  restart_required: bool;         // set on unexpected agent exit so the next turn respawns + resumes
  cwd: [1024] u8; ncwd: int;
  err: [2048] u8; err_n: int;     // why the agent stopped, when it said nothing itself
  agent: CuAgent;                 // the agent and its quirks; none (no name) is Cursor's
  notice: [1024] u8; notice_n: int; // the turn's words were agy's failure notice (antigravity.coax, agy_chunk)
  // background command & detached subagent held-turn state (defer_finalize_background)
  bg_tools: [CUE_TOOLS] int; nbg_tools: int; // active non-daemon execute/schedule tool calls (hashed ids)
  bg_subagents: int;              // live detached subagents (e.g. agr_subagents_running; excludes SUBAGENT_STATE_KILLED)
  held_bg: bool;                  // session/prompt settled while background work is active
  held_bg_since: int;             // owner's clock (ms) when held_bg began (-1 until first cue_watch)
  bg_hold_limit_ms: int;          // optional override for CUE_BG_HOLD_LIMIT_MS (0 uses default 120000; Antigravity uses 1800000 = 30m)
  detached_stream: bool;          // detached session/update or permission arrived while held_bg
  bg_usage_settled: bool;         // usage_update arrived while held_bg with no active bg work; waiting CUE_BG_USAGE_SETTLE_MS
  bg_usage_since: int;            // owner's clock (ms) when bg_usage_settled was first observed (-1 until first cue_watch)
  bg_idle_since: int;             // owner's clock (ms) when held_bg became idle awaiting reactive wakeup (-1 while active)
  bg_no_wake: bool;               // true when held work ended with no reactive wakeup expected (e.g. SUBAGENT_STATE_KILLED)
  system_append: [4608] u8; system_append_n: int; // optional _meta.antigravity.systemPrompt.append for session/new
  add_dirs: [2048] u8; add_dirs_n: int;           // optional additionalDirectories JSON string items (#14009)
  ag_meta: [1024] u8; ag_meta_n: int;             // optional _meta.antigravity inner fields (#14010)
  agy_meta: [1024] u8; agy_meta_n: int;           // optional _meta.agy inner fields (#14010)
  fs_read_enabled: bool;                          // advertise clientCapabilities.fs.readTextFile (#14010)
  // the stall watchdog (cue_watch): off while stall_ms is 0, as for Cursor; agy_launch turns it on
  stall_ms: int; recover_max: int;
  active_prompt_id: int;          // JSON-RPC request id of the latest in-flight session/prompt (0 when none)
  heard: bool;                    // the agent sent something since the last cue_watch
  watching: bool; quiet_since: int; // a turn is in flight; the owner's clock when the agent last spoke
  last_watch: int; has_watch: bool; // previous cue_watch clock for sleep/wake jump detection
  tools: [CUE_TOOLS] int; ntools: int; // tool calls running (their ids hashed): a tool's time is not the model's silence
  recovered: int;                 // recoveries in this turn
  recovering: int;                // CUE_RECOVER_CANCELLED or CUE_RECOVER_GAVE_UP: the watchdog's cancel is out
  stalled: bool;                  // the watchdog gave up on this turn (cue_stalled)
  silent_ms: int;                 // the last silence the watchdog acted on
  spent: [512] u8; spent_n: int;  // the usage of a turn's part the watchdog cancelled and continued (cue_spent)
}

cue_attach :: (x: [] CuEngine, c: [] CuClient, p: [] ClProcess, line: [] u8, arena: [] u8, out: [] u8) {
  x[0].c = c; x[0].p = p;
  x[0].line = line; x[0].arena = arena; x[0].out = out;
  x[0].p[0].handle = -1;
}

// Where the agent is: on PATH, else the usual places under HOME ("" when there is none).
cue_program :: (out: [] u8) -> string {
  pb: [8192] u8; path := cl_getenv("PATH", pb[..]);
  hb: [4096] u8; home := cl_getenv("HOME", hb[..]);
  return cu_find(path, home, out);
}

// Which agent the next launch starts (Cursor's when never set).
cue_agent :: (x: [] CuEngine, ag: CuAgent) { x[0].agent = ag; }
cue_profile :: (x: [] CuEngine) -> CuAgent { return ifx x[0].agent.name.count > 0 then x[0].agent else cu_agent_cursor(); }

// A fresh client, the agent started in cwd and initialize sent: "" or why it did not start.
cue_launch :: (x: [] CuEngine, program: string, cwd: string, name: string, version: string) -> string {
  l: [1] CuLaunch; l[0].program = program; l[0].cwd = cwd;
  return cue_start(x, l[0], name, version);
}
cue_bg_clear :: (x: [] CuEngine, clear_tools: bool) {
  x[0].held_bg = false; x[0].held_bg_since = -1; x[0].detached_stream = false;
  x[0].bg_usage_settled = false; x[0].bg_usage_since = -1;
  x[0].bg_idle_since = -1; x[0].bg_no_wake = false;
  if clear_tools { x[0].nbg_tools = 0; x[0].bg_subagents = 0; }
}
// cue_launch with the owner's launch (its environment): the engine's agent is the one started.
cue_start :: (x: [] CuEngine, launch: CuLaunch, name: string, version: string) -> string {
  x[0].c[0] = CuClient.{};
  cu_init(x[0].c, x[0].line, x[0].arena, x[0].out);
  l := launch; l.agent = cue_profile(x);
  cwd := l.cwd;
  why := cu_start(x[0].c, x[0].p, l);
  if why.count > 0 { return why; }
  x[0].ncwd = e_set(x[0].cwd[..], 0, cwd);
  x[0].live = true; x[0].ready = false; x[0].replay = false; x[0].hold = 0;
  x[0].restart_required = false;
  x[0].active_prompt_id = 0;
  cue_bg_clear(x, true);
  cue_watch_set(x, 0, 0);
  if x[0].fs_read_enabled {
    r := cu_initialize_fs(x[0].c, name, version, true);
  } else {
    r := cu_initialize(x[0].c, name, version);
  }
  return "";
}
cue_resume :: (x: [] CuEngine, session: string) { x[0].nresume = e_set(x[0].resume[..], 0, session); }
cue_last_session :: (x: [] CuEngine) -> string { return e_str(x[0].last_session[..], x[0].last_session_n); }
cue_needs_restart :: (x: [] CuEngine) -> bool { return x[0].restart_required; }
cue_held_bg :: (x: [] CuEngine) -> bool { return x[0].held_bg; }
cue_turn_active :: (x: [] CuEngine) -> bool { return cue_prompting(x) || x[0].held_bg; }

// Prepare to respawn after an unexpected exit: queues last_session for session/resume (or session/load).
cue_prepare_restart :: (x: [] CuEngine) -> bool {
  if !x[0].restart_required { return false; }
  if x[0].last_session_n > 0 { cue_resume(x, e_str(x[0].last_session[..], x[0].last_session_n)); }
  x[0].restart_required = false;
  return true;
}
// Respawn the agent after an unexpected exit and resume the previous session.
cue_respawn :: (x: [] CuEngine, launch: CuLaunch, name: string, version: string) -> string {
  _ = cue_prepare_restart(x);
  return cue_start(x, launch, name, version);
}
// Open a fresh session (dropping any resume/last_session), e.g. after a lost thinking-signature error.
cue_fresh_session :: (x: [] CuEngine) {
  x[0].nresume = 0; x[0].last_session_n = 0; x[0].restart_required = false;
  cue_bg_clear(x, true);
  x[0].ntools = 0; x[0].recovering = 0; x[0].active_prompt_id = 0;
  if x[0].live {
    x[0].ready = false; x[0].replay = false;
    r := cu_session_new_full(
      x[0].c,
      e_str(x[0].cwd[..], x[0].ncwd),
      e_str(x[0].system_append[..], x[0].system_append_n),
      e_str(x[0].add_dirs[..], x[0].add_dirs_n),
      e_str(x[0].ag_meta[..], x[0].ag_meta_n),
      e_str(x[0].agy_meta[..], x[0].agy_meta_n)
    );
  }
}

// A message: at once on an open session with nothing held, else owed (cut to CUE_OWED). Whether it went.
cue_send :: (x: [] CuEngine, msg: string) -> bool {
  x[0].notice_n = 0;
  if x[0].live && x[0].ready && x[0].hold == 0 {
    if x[0].held_bg { cue_bg_clear(x, false); }
    r := cu_session_prompt(x[0].c, msg);
    x[0].active_prompt_id = r;
    x[0].heard = true;
    x[0].recovering = 0;
    return true;
  }
  x[0].nowed = e_set(x[0].owed[..], 0, msg);
  x[0].owed_blocks = false;
  return false;
}
// A multipart ACP prompt (comma-separated JSON content blocks such as text + image/resource; #14002):
// sends at once when the session is open and unheld, else queues in owed for cu_session_prompt_blocks.
cue_send_blocks :: (x: [] CuEngine, blocks_json: string) -> bool {
  x[0].notice_n = 0;
  if x[0].live && x[0].ready && x[0].hold == 0 {
    if x[0].held_bg { cue_bg_clear(x, false); }
    r := cu_session_prompt_blocks(x[0].c, blocks_json);
    x[0].active_prompt_id = r;
    x[0].heard = true;
    x[0].recovering = 0;
    return true;
  }
  x[0].nowed = e_set(x[0].owed[..], 0, blocks_json);
  x[0].owed_blocks = true;
  return false;
}
// Mid-turn steer: when steers_with_prompt is true, send session/prompt directly without session/cancel
// so running subagents stay alive. Otherwise cancel first and queue the message as owed.
cue_steer :: (x: [] CuEngine, msg: string) -> bool {
  if !cue_turn_active(x) { return cue_send(x, msg); }
  x[0].notice_n = 0;
  if !x[0].live || !x[0].ready || x[0].hold > 0 {
    x[0].nowed = e_set(x[0].owed[..], 0, msg);
    x[0].owed_blocks = false;
    return false;
  }
  if cue_profile(x).steers_with_prompt {
    cue_bg_clear(x, false);
    r := cu_session_prompt(x[0].c, msg);
    x[0].active_prompt_id = r;
    x[0].heard = true;
    x[0].recovering = 0;
    return true;
  }
  cue_cancel(x);
  x[0].nowed = e_set(x[0].owed[..], 0, msg);
  x[0].owed_blocks = false;
  return false;
}
// The owed message, once nothing is held and the owner still wants it (its turn is running).
cue_owed :: (x: [] CuEngine, running: bool) {
  if x[0].hold > 0 || x[0].nowed == 0 || !running { return; }
  payload := e_str(x[0].owed[..], x[0].nowed);
  r := ifx x[0].owed_blocks then cu_session_prompt_blocks(x[0].c, payload) else cu_session_prompt(x[0].c, payload);
  x[0].active_prompt_id = r;
  x[0].heard = true;
  x[0].recovering = 0;
  x[0].nowed = 0;
  x[0].owed_blocks = false;
}
// One of the session's settings (a model, a thought level): the owed message waits for its answer.
cue_set :: (x: [] CuEngine, id: string, value: string) { r := cu_set_config(x[0].c, id, value); x[0].hold += 1; }
cue_set_model :: (x: [] CuEngine, model: string) { r := cu_set_model(x[0].c, model); x[0].hold += 1; }
cue_set_mode :: (x: [] CuEngine, mode: string) { r := cu_set_mode(x[0].c, mode); x[0].hold += 1; }

cue_close :: (x: [] CuEngine) {
  if !x[0].live { return; }
  cu_close_process(x[0].p);
  x[0].live = false; x[0].ready = false; x[0].replay = false; x[0].hold = 0;
  x[0].active_prompt_id = 0;
  cue_bg_clear(x, true);
  x[0].restart_required = false;
}

// The next event into ev (idle: nothing more for now), after the engine's part of it. An event
// the engine has answered itself (a replayed request) comes back as none. Never blocks.
cue_poll :: (x: [] CuEngine, ev: [] CuEvent) {
  ev[0] = cu_poll(x[0].c, x[0].p, 0);
  ev[0].kind = cue_take(x, ev[0].kind, ev[0].of);
  ev[0].kind = cue_heard(x, ev[0]);
}
// The engine's part of an event of kind k (of: the request answered); the kind the owner sees.
cue_take :: (x: [] CuEngine, k: CuEventKind, of: int) -> CuEventKind {
  if k == CuEventKind.end || k == CuEventKind.failed { cue_gone(x); return k; }
  if k == CuEventKind.answered || k == CuEventKind.refused || k == CuEventKind.initialized { cue_session(x, k, of); return k; }
  // a replayed history asks nothing of anyone
  if x[0].replay && cue_replayed(x[0].c, k) { return CuEventKind.none; }
  return k;
}
cue_gone :: (x: [] CuEngine) {
  was_ready := x[0].ready;
  sid := cu_session_id(x[0].c);
  if sid.count > 0 { x[0].last_session_n = e_set(x[0].last_session[..], 0, sid); }
  x[0].err_n = 0;
  if cu_error(x[0].c).count == 0 { x[0].err_n = cl_stderr(x[0].p, x[0].err[..]).count; }
  cue_close(x);
  if was_ready { x[0].restart_required = true; }
}
// Initialize answered, logging in answered, the session opened or refused, a setting answered.
cue_session :: (x: [] CuEngine, k: CuEventKind, of: int) {
  c := x[0].c;
  if k == CuEventKind.initialized {
    login := cue_profile(x).login;
    if login.count > 0 { r := cu_authenticate_with(c, login); } else { cue_open(x); }
    return;
  }
  cwd := e_str(x[0].cwd[..], x[0].ncwd);
  if k == CuEventKind.answered && of == CU_AUTHENTICATE { cue_open(x); return; }
  if k == CuEventKind.refused && (of == CU_SESSION_LOAD || of == CU_SESSION_RESUME) { x[0].replay = false; x[0].nresume = 0; r := cu_session_new(c, cwd); return; }
  if k == CuEventKind.refused && of == CU_SESSION_SET_CONFIG { x[0].hold -= 1; return; }
  if k == CuEventKind.refused && (of == CU_SESSION_SET_MODEL || of == CU_SESSION_SET_MODE) { if x[0].hold > 0 { x[0].hold -= 1; } return; }
  if k == CuEventKind.answered && (of == CU_SESSION_NEW || of == CU_SESSION_LOAD || of == CU_SESSION_RESUME) {
    x[0].ready = true; x[0].replay = false;
    sid := cu_session_id(c);
    if sid.count > 0 { x[0].last_session_n = e_set(x[0].last_session[..], 0, sid); }
    return;
  }
  if k == CuEventKind.answered && (of == CU_SESSION_SET_CONFIG || of == CU_SESSION_SET_MODEL || of == CU_SESSION_SET_MODE) { if x[0].hold > 0 { x[0].hold -= 1; } }
}
// The conversation's session: a new one, or the one to resume (session/load replays its
// history, which the engine answers; session/resume replays none).
cue_open :: (x: [] CuEngine) {
  c := x[0].c;
  cwd := e_str(x[0].cwd[..], x[0].ncwd);
  sys_app := e_str(x[0].system_append[..], x[0].system_append_n);
  add_dirs := e_str(x[0].add_dirs[..], x[0].add_dirs_n);
  ag_meta := e_str(x[0].ag_meta[..], x[0].ag_meta_n);
  agy_meta := e_str(x[0].agy_meta[..], x[0].agy_meta_n);
  if x[0].nresume == 0 { r := cu_session_new_full(c, cwd, sys_app, add_dirs, ag_meta, agy_meta); return; }
  if cue_profile(x).resume == CU_SESSION_RESUME { r := cu_session_resume(c, e_str(x[0].resume[..], x[0].nresume), cwd); }
  else { x[0].replay = true; r := cu_session_load(c, e_str(x[0].resume[..], x[0].nresume), cwd); }
  x[0].nresume = 0;
}
cue_set_system_append :: (x: [] CuEngine, text: string) {
  x[0].system_append_n = e_set(x[0].system_append[..], 0, text);
}
cue_set_add_dirs :: (x: [] CuEngine, dirs_json: string) {
  x[0].add_dirs_n = e_set(x[0].add_dirs[..], 0, dirs_json);
}
cue_set_ag_meta :: (x: [] CuEngine, meta_fields: string) {
  x[0].ag_meta_n = e_set(x[0].ag_meta[..], 0, meta_fields);
}
cue_set_agy_meta :: (x: [] CuEngine, meta_fields: string) {
  x[0].agy_meta_n = e_set(x[0].agy_meta[..], 0, meta_fields);
}
cue_set_fs_read :: (x: [] CuEngine, enabled: bool) {
  x[0].fs_read_enabled = enabled;
}
cue_list_sessions :: (x: [] CuEngine, cwd: string) -> int {
  return ifx x[0].live then cu_session_list(x[0].c, cwd) else 0;
}
cue_close_session :: (x: [] CuEngine) -> int {
  sid := cu_session_id(x[0].c);
  if !x[0].live || sid.count == 0 { return 0; }
  return cu_session_close(x[0].c, sid);
}
cue_set_bg_hold_limit :: (x: [] CuEngine, ms: int) {
  x[0].bg_hold_limit_ms = ifx ms > 0 then ms else 0;
}
// A request during a replay, answered: no question asked, no plan accepted, nothing allowed. Whether it was one.
cue_replayed :: (c: [] CuClient, k: CuEventKind) -> bool {
  if k == CuEventKind.question { cu_question(c, true); return true; }
  if k == CuEventKind.plan { cu_plan(c, false); return true; }
  if k == CuEventKind.permission { cu_decline(c); return true; }
  return false;
}
// Why the agent stopped: what the client recorded, else what the agent last wrote to stderr.
cue_why :: (x: [] CuEngine) -> string {
  why := cu_error(x[0].c);
  return ifx why.count > 0 then why else e_str(x[0].err[..], x[0].err_n);
}

// ---------------------------------------------------------------- the stall watchdog

CUE_WATCH_NONE :: 0;        // nothing to tell
CUE_WATCH_RECOVERING :: 1;  // a silence: the turn was cancelled and will be asked to continue
CUE_WATCH_GAVE_UP :: 2;     // a silence past the recoveries: the turn was cancelled for good
CUE_WATCH_ENDED :: 3;       // the cancel went unanswered too: the agent was closed
CUE_WATCH_BG_DONE :: 4;     // a held detached background turn ended (idle or 120s safety cap)
CUE_RECOVER_CANCELLED :: 1; CUE_RECOVER_GAVE_UP :: 2;
CUE_CONTINUE :: "Your last reply stopped arriving, so the turn was cancelled. Continue where you left off. Don't repeat steps that already finished. If you were writing multiple large files in one response, write 1-2 files per turn instead.";

// The watchdog's limits: silent milliseconds (0: off) and recoveries a turn. A launch turns it off.
cue_watch_set :: (x: [] CuEngine, stall_ms: int, recover_max: int) {
  x[0].stall_ms = ifx stall_ms > 0 then stall_ms else 0;
  x[0].recover_max = ifx recover_max > 0 then recover_max else 0;
  x[0].heard = false; x[0].watching = false; x[0].ntools = 0;
  x[0].has_watch = false; x[0].last_watch = 0;
  x[0].recovered = 0; x[0].recovering = 0; x[0].stalled = false; x[0].silent_ms = 0;
}
// The usage of a turn's part the watchdog cancelled and continued, once ("" when none): the owner
// counts it, since that cancelled answer never reaches the owner.
cue_spent :: (x: [] CuEngine) -> string { n := x[0].spent_n; x[0].spent_n = 0; return cast(string) x[0].spent[0..<n]; }
// Whether the watchdog gave up on the turn that just ended (its answer is a cancelled one).
cue_stalled :: (x: [] CuEngine) -> bool { return x[0].stalled; }
// The owner's explicit Stop: sends session/cancel without tearing down the runtime,
// clears any held detached background turn, and prevents recovery.
cue_cancel :: (x: [] CuEngine) {
  cu_session_cancel(x[0].c);
  x[0].recovering = 0;
  cue_bg_clear(x, true);
}
cue_stop :: (x: [] CuEngine) { cue_cancel(x); }

// Whether a session/prompt is waiting for its answer.
cue_prompting :: (x: [] CuEngine) -> bool {
  c := x[0].c;
  for k: 0..<c[0].npend { if c[0].pend_of[k] == CU_SESSION_PROMPT { return true; } }
  return false;
}
// Request id of the newest still-pending session/prompt (0 when none).
cue_last_prompt_id :: (x: [] CuEngine) -> int {
  c := x[0].c;
  last := 0;
  for k: 0..<c[0].npend { if c[0].pend_of[k] == CU_SESSION_PROMPT { last = c[0].pend_id[k]; } }
  return last;
}
cue_hash :: (s: string) -> int {
  h := 7;
  for ch: s { h = (h * 131 + cast(int) ch) % 1000000007; }
  return h;
}
// A tool call's status: pending or in_progress runs it, completed, failed or cancelled ends it.
cue_tool :: (x: [] CuEngine, id: string, status: string) {
  if id.count == 0 || status.count == 0 { return; }
  h := cue_hash(id);
  at := -1;
  for i: 0..<x[0].ntools { if x[0].tools[i] == h { at = i; } }
  if status == "pending" || status == "in_progress" {
    if at < 0 && x[0].ntools < CUE_TOOLS { x[0].tools[x[0].ntools] = h; x[0].ntools += 1; }
    return;
  }
  if at < 0 { return; }
  for j: at..<x[0].ntools - 1 { x[0].tools[j] = x[0].tools[j + 1]; }
  x[0].ntools -= 1;
}

// Track active non-daemon execute tool calls (kind == "execute" && rawInput.IsDaemon != true).
cue_bg_tool :: (x: [] CuEngine, id: string, status: string, tool_kind: string, is_daemon: bool) {
  if id.count == 0 { return; }
  h := cue_hash(id);
  at := -1;
  for i: 0..<x[0].nbg_tools { if x[0].bg_tools[i] == h { at = i; } }
  if status == "completed" || status == "failed" || status == "cancelled" {
    if at < 0 { return; }
    for j: at..<x[0].nbg_tools - 1 { x[0].bg_tools[j] = x[0].bg_tools[j + 1]; }
    x[0].nbg_tools -= 1;
    return;
  }
  if tool_kind == "execute" {
    if is_daemon {
      if at >= 0 {
        for j: at..<x[0].nbg_tools - 1 { x[0].bg_tools[j] = x[0].bg_tools[j + 1]; }
        x[0].nbg_tools -= 1;
      }
      return;
    }
    if (status == "pending" || status == "in_progress" || status.count == 0) && at < 0 && x[0].nbg_tools < CUE_TOOLS {
      x[0].bg_tools[x[0].nbg_tools] = h;
      x[0].nbg_tools += 1;
    }
  }
}

// Update the count of live detached subagents (GitHub #13832). Killed/completed subagents
// must not be counted so they never wedge a held parent turn.
cue_bg_subagents_set :: (x: [] CuEngine, running: int) {
  prev := x[0].bg_subagents;
  next := ifx running > 0 then running else 0;
  x[0].bg_subagents = next;
  if next > 0 {
    x[0].bg_usage_settled = false; x[0].bg_usage_since = -1;
    x[0].bg_idle_since = -1; x[0].bg_no_wake = false;
  } else if prev > 0 && x[0].held_bg {
    x[0].bg_idle_since = -1;
  }
}
// Tell the held-turn watchdog whether the just-ended background work expects a reactive wakeup
// from the agent (false when all remaining subagents were killed via SUBAGENT_STATE_KILLED).
cue_bg_expect_wake :: (x: [] CuEngine, expect: bool) {
  x[0].bg_no_wake = !expect;
}
cue_bg_subagents :: (x: [] CuEngine) -> int { return x[0].bg_subagents; }

// The watchdog and held-turn part of an event: the agent spoke, a tool call started or ended,
// the turn ended or was held open for a background execute tool or detached subagent.
cue_heard :: (x: [] CuEngine, ev: CuEvent) -> CuEventKind {
  k := ev.kind;
  if k == CuEventKind.idle { return k; }
  defer_bg := cue_profile(x).defer_finalize_background;
  steers := cue_profile(x).steers_with_prompt;
  if x[0].stall_ms == 0 && !defer_bg && !steers && x[0].active_prompt_id == 0 { return k; }
  if x[0].stall_ms > 0 { x[0].heard = true; }
  ar := x[0].c[0].ar[..];
  if k == CuEventKind.permission {
    if x[0].held_bg {
      x[0].detached_stream = true;
      x[0].bg_usage_settled = false; x[0].bg_usage_since = -1;
      x[0].bg_idle_since = -1; x[0].bg_no_wake = false;
    }
    return k;
  }
  if k == CuEventKind.notification {
    update := cl_raw(ev.params, "update");
    kind := cl_str(ar, update, "sessionUpdate");
    if kind == "tool_call" || kind == "tool_call_update" {
      tid := cl_str(ar, update, "toolCallId");
      st := cl_str(ar, update, "status");
      if x[0].stall_ms > 0 || defer_bg { cue_tool(x, tid, st); }
      if defer_bg {
        is_active_call := st.count == 0 || st == "pending" || st == "in_progress";
        if !x[0].held_bg && !cue_prompting(x) && is_active_call {
          x[0].held_bg = true; x[0].held_bg_since = -1; x[0].detached_stream = true;
        }
        if x[0].held_bg {
          x[0].bg_usage_settled = false; x[0].bg_usage_since = -1;
          x[0].bg_idle_since = -1; x[0].bg_no_wake = false;
        }
        tk := cl_str(ar, update, "kind");
        tname := cl_str(ar, update, "name");
        if tname.count == 0 { tname = cl_str(ar, update, "title"); }
        if tname == "schedule" { tk = "execute"; }
        raw := cl_raw(update, "rawInput");
        is_daemon := cl_bool(raw, "IsDaemon").value;
        cue_bg_tool(x, tid, st, tk, is_daemon);
      }
    } else if x[0].held_bg {
      if kind == "usage_update" {
        // agy emits usage_update at the end of EVERY LLM step — including 2-5ms BEFORE each
        // tool_call and while a chained background command is still running. Arm the short
        // CUE_BG_USAGE_SETTLE_MS debounce only when no background work or permission is active;
        // cue_watch finalizes with CUE_WATCH_BG_DONE once the window passes quietly.
        if x[0].nbg_tools == 0 && x[0].bg_subagents == 0 && x[0].c[0].asking == 0 {
          x[0].bg_usage_settled = true; x[0].bg_usage_since = -1; x[0].bg_idle_since = -1;
        }
      } else if kind == "agent_message_chunk" || kind == "agent_thought_chunk" {
        x[0].detached_stream = true;
        x[0].bg_usage_settled = false; x[0].bg_usage_since = -1;
        x[0].bg_idle_since = -1; x[0].bg_no_wake = false;
      }
    } else if defer_bg && !cue_prompting(x) && (kind == "agent_message_chunk" || kind == "agent_thought_chunk") {
      // Scheduled wake / post-settle continuation arrived with no prompt open: hold run open & steerable (#13835).
      x[0].held_bg = true; x[0].held_bg_since = -1; x[0].detached_stream = true;
      x[0].bg_usage_settled = false; x[0].bg_usage_since = -1;
      x[0].bg_idle_since = -1; x[0].bg_no_wake = false;
    }
    return k;
  }
  if (k != CuEventKind.answered && k != CuEventKind.refused) || ev.of != CU_SESSION_PROMPT { return k; }
  // Superseded prompt response: on steers_with_prompt agents (e.g. agy acp), sending a
  // mid-turn session/prompt causes the server to answer the older prompt end_turn while
  // carrying the turn on under the newer prompt (or vice versa). Ignore any answer whose
  // id is not active_prompt_id, or while another session/prompt is still pending, so we
  // never prematurely end the active turn or desync future turns into an empty-reply loop.
  if x[0].active_prompt_id > 0 && ev.id > 0 && ev.id != x[0].active_prompt_id {
    return CuEventKind.none;
  }
  if cue_prompting(x) {
    x[0].active_prompt_id = cue_last_prompt_id(x);
    return CuEventKind.none;
  }
  x[0].active_prompt_id = 0;
  x[0].ntools = 0;
  if x[0].stall_ms > 0 && k == CuEventKind.answered && x[0].recovering == CUE_RECOVER_CANCELLED && cl_str(ar, ev.result, "stopReason") == "cancelled" {
    u := cl_raw(ev.result, "usage");
    x[0].spent_n = ifx u.count <= x[0].spent.count then e_set(x[0].spent[..], 0, u) else 0;
    r := cu_session_prompt(x[0].c, CUE_CONTINUE);
    x[0].active_prompt_id = r;
    x[0].recovering = 0;
    return CuEventKind.none;
  }
  if defer_bg && k == CuEventKind.answered && (x[0].nbg_tools > 0 || x[0].bg_subagents > 0) && cl_str(ar, ev.result, "stopReason") != "cancelled" {
    x[0].held_bg = true; x[0].held_bg_since = -1; x[0].detached_stream = false;
    x[0].bg_usage_settled = false; x[0].bg_usage_since = -1;
    x[0].bg_idle_since = -1; x[0].bg_no_wake = false;
    x[0].recovering = 0; x[0].watching = false;
    return CuEventKind.none;
  }
  cue_bg_clear(x, true);
  x[0].recovering = 0; x[0].watching = false;     // (recovered and stalled stay for the owner's end of the turn)
  return k;
}

// The watchdog and held-turn timer, once per owner poll with the owner's clock in milliseconds:
// CUE_WATCH_NONE, or what it just did (cue_watch_notice says it).
cue_watch :: (x: [] CuEngine, now: int) -> int {
  if !x[0].live {
    x[0].watching = false; x[0].heard = false; x[0].has_watch = false;
    return CUE_WATCH_NONE;
  }
  // Detect host sleep/wake or backwards clock jump so waking does not immediately time out a turn.
  slept := false;
  sleep_delta := 0;
  if x[0].has_watch {
    step := now - x[0].last_watch;
    if step < 0 || step >= CUE_SLEEP_JUMP_MS { slept = true; sleep_delta = step; }
  }
  x[0].last_watch = now; x[0].has_watch = true;
  if x[0].held_bg {
    if x[0].held_bg_since < 0 { x[0].held_bg_since = now; }
    else if slept {
      if sleep_delta > 0 { x[0].held_bg_since += sleep_delta; } else { x[0].held_bg_since = now; }
    }
    hold_limit := ifx x[0].bg_hold_limit_ms > 0 then x[0].bg_hold_limit_ms else CUE_BG_HOLD_LIMIT_MS;
    if now - x[0].held_bg_since >= hold_limit {
      cue_bg_clear(x, true);
      return CUE_WATCH_BG_DONE;
    }
    if x[0].nbg_tools > 0 || x[0].bg_subagents > 0 || x[0].c[0].asking != 0 {
      x[0].bg_usage_settled = false; x[0].bg_usage_since = -1; x[0].bg_idle_since = -1;
      return CUE_WATCH_NONE;
    }
    if x[0].bg_no_wake && !x[0].detached_stream {
      cue_bg_clear(x, true);
      return CUE_WATCH_BG_DONE;
    }
    if x[0].bg_usage_settled {
      if x[0].bg_usage_since < 0 { x[0].bg_usage_since = now; }
      else if slept {
        if sleep_delta > 0 { x[0].bg_usage_since += sleep_delta; } else { x[0].bg_usage_since = now; }
      }
      if now - x[0].bg_usage_since >= CUE_BG_USAGE_SETTLE_MS {
        cue_bg_clear(x, true);
        return CUE_WATCH_BG_DONE;
      }
      return CUE_WATCH_NONE;
    }
    // Background tool or completed subagent just finished: keep the turn open across agy's
    // reactive wakeup delay (typically 3-15s, up to stall_ms on high thinking) until the wakeup
    // streams its follow-up tools & final reply + usage_update.
    if x[0].bg_idle_since < 0 { x[0].bg_idle_since = now; }
    else if slept {
      if sleep_delta > 0 { x[0].bg_idle_since += sleep_delta; } else { x[0].bg_idle_since = now; }
    }
    wake_grace := CUE_BG_WAKE_GRACE_MS;
    if x[0].stall_ms > 0 && x[0].stall_ms < wake_grace { wake_grace = x[0].stall_ms; }
    if now - x[0].bg_idle_since >= wake_grace {
      cue_bg_clear(x, true);
      return CUE_WATCH_BG_DONE;
    }
    return CUE_WATCH_NONE;
  }
  if x[0].stall_ms == 0 { return CUE_WATCH_NONE; }
  if !cue_prompting(x) { x[0].watching = false; x[0].heard = false; return CUE_WATCH_NONE; }
  if !x[0].watching { x[0].watching = true; x[0].quiet_since = now; x[0].heard = false; x[0].stalled = false; x[0].recovered = 0; return CUE_WATCH_NONE; }
  if slept || x[0].heard || x[0].c[0].asking != 0 || x[0].ntools > 0 { x[0].quiet_since = now; x[0].heard = false; return CUE_WATCH_NONE; }
  quiet := now - x[0].quiet_since;
  if quiet < x[0].stall_ms { return CUE_WATCH_NONE; }
  x[0].silent_ms = quiet; x[0].quiet_since = now;
  if x[0].recovering != 0 {
    x[0].recovering = 0; x[0].stalled = true; x[0].watching = false;
    cue_close(x);
    return CUE_WATCH_ENDED;
  }
  cu_session_cancel(x[0].c);
  if x[0].recovered < x[0].recover_max { x[0].recovered += 1; x[0].recovering = CUE_RECOVER_CANCELLED; return CUE_WATCH_RECOVERING; }
  x[0].recovering = CUE_RECOVER_GAVE_UP; x[0].stalled = true;
  return CUE_WATCH_GAVE_UP;
}

// ---------------------------------------------------------------- checks

// An engine over the test's buffers with initialize sent (request 0) and no process.
cue_test :: (x: [] CuEngine, c: [] CuClient, p: [] ClProcess, line: [] u8, arena: [] u8, out: [] u8) {
  cue_attach(x, c, p, line, arena, out);
  cu_init(x[0].c, line, arena, out);
  x[0].live = true; x[0].ncwd = e_set(x[0].cwd[..], 0, "/w");
  r := cu_initialize(x[0].c, "t", "1");
}
cue_feed :: (x: [] CuEngine, line: string) -> CuEvent {
  cu_outbox_clear(x[0].c);
  ev := cu_feed(x[0].c, line);
  ev.kind = cue_take(x, ev.kind, ev.of);
  ev.kind = cue_heard(x, ev);
  return ev;
}

// The session opened as the agent opens it: initialize, authenticate, session/new answered.
cue_test_open :: (x: [] CuEngine) {
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"protocolVersion\":1}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"sessionId\":\"s-1\"}}");
}
cue_out_has :: (x: [] CuEngine, part: string) -> bool { return s_has(cu_outbox(x[0].c), part); }

#test "cursor engine: initialize answered logs in, logging in opens a session in the folder" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [1024] u8; out: [2048] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"protocolVersion\":1}}");
  #assert ev.kind == CuEventKind.initialized && cue_out_has(x, "\"method\":\"authenticate\"");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{}}");
  #assert cue_out_has(x, "\"method\":\"session/new\"") && cue_out_has(x, "\"cwd\":\"/w\"");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"sessionId\":\"s-1\"}}");
  #assert x[0].ready && !x[0].replay && cu_outbox(x[0].c).count == 0;
}

#test "cursor engine: a message waits for the session and its settings, then goes once" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [1024] u8; out: [2048] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  #assert !cue_send(x, "hello") && x[0].nowed == 5;
  cue_test_open(x);
  cu_outbox_clear(x[0].c);
  cue_set(x, "model", "fast");
  cue_owed(x, true);
  #assert x[0].hold == 1 && x[0].nowed == 5 && !cue_out_has(x, "session/prompt");
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{}}");
  #assert x[0].hold == 0;
  cue_owed(x, false);
  #assert x[0].nowed == 5;                         // the owner's turn is over: nothing goes
  cue_owed(x, true);
  #assert x[0].nowed == 0 && cue_out_has(x, "\"method\":\"session/prompt\"") && cue_out_has(x, "hello");
  cu_outbox_clear(x[0].c);
  #assert cue_send(x, "again") && cue_out_has(x, "again");
}

#test "cursor engine: a resumed session's replay is answered by the engine" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [1024] u8; out: [2048] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  cue_resume(x, "old-session");
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{}}");
  #assert x[0].replay && x[0].nresume == 0 && cue_out_has(x, "\"method\":\"session/load\"") && cue_out_has(x, "old-session");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"session/request_permission\",\"params\":{\"options\":[{\"optionId\":\"ok\",\"kind\":\"allow_once\"}],\"toolCall\":{\"kind\":\"execute\"}}}");
  #assert ev.kind == CuEventKind.none && cue_out_has(x, "cancelled");
}

#test "cursor engine: a refused load opens a new session, whose requests are the owner's" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [1024] u8; out: [2048] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  cue_resume(x, "old-session");
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-32000,\"message\":\"no such session\"}}");
  #assert ev.kind == CuEventKind.refused && !x[0].replay && cue_out_has(x, "\"method\":\"session/new\"");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"sessionId\":\"s-2\"}}");
  #assert x[0].ready && cu_session_id(x[0].c) == "s-2";
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"session/request_permission\",\"params\":{\"options\":[{\"optionId\":\"ok\",\"kind\":\"allow_once\"}],\"toolCall\":{\"kind\":\"execute\"}}}");
  #assert ev.kind == CuEventKind.permission && cu_outbox(x[0].c).count == 0;
}

// ---------------------------------------------------------------- the stall watchdog's checks

// An open session watched (1 s silent, recoveries as given) with its first message sent: request 4.
cue_test_turn :: (x: [] CuEngine, recoveries: int) {
  cue_test_open(x);
  cue_watch_set(x, 1000, recoveries);
  #assert cue_send(x, "fix it");
  #assert cue_watch(x, 0) == CUE_WATCH_NONE && x[0].watching;
}
CUE_T_SAYS :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"Working.\"}}}}";
CUE_T_THINKS :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"agent_thought_chunk\",\"content\":{\"type\":\"text\",\"text\":\"hm\"}}}}";
CUE_T_TOOL :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"call_7\",\"name\":\"run_command\",\"status\":\"in_progress\",\"kind\":\"execute\"}}}";
CUE_T_TOOL_ASKS :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"call_7\",\"name\":\"run_command\",\"status\":\"pending\",\"kind\":\"execute\"}}}";
CUE_T_TOOL_DONE :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"call_7\",\"status\":\"completed\",\"content\":[]}}}";
CUE_T_PERMISSION :: "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"method\":\"session/request_permission\",\"params\":{\"options\":[{\"optionId\":\"allow\",\"kind\":\"allow_once\"}],\"toolCall\":{\"kind\":\"execute\"}}}";
cue_t_answer :: (id: int, reason: string, out: [] u8) -> string {
  n := e_set(out, 0, "{\"jsonrpc\":\"2.0\",\"id\":"); tb: [8] u8; tb[0] = cast(u8) ('0' + id); n = e_set(out, n, cast(string) tb[0..<1]);
  n = e_set(out, n, ",\"result\":{\"stopReason\":\""); n = e_set(out, n, reason); n = e_set(out, n, "\"}}");
  return cast(string) out[0..<n];
}

#test "stall watchdog: a turn that goes silent is cancelled, continued in the same session, and ends as the agent ends it" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  cue_test_turn(x, 2);
  ev := cue_feed(x, CUE_T_SAYS);
  #assert cue_watch(x, 500) == CUE_WATCH_NONE;
  #assert cue_watch(x, 1499) == CUE_WATCH_NONE && !cue_out_has(x, "session/cancel");     // 999 ms silent: not yet
  #assert cue_watch(x, 1500) == CUE_WATCH_RECOVERING && x[0].silent_ms == 1000 && x[0].recovered == 1;
  #assert cue_out_has(x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/cancel\",\"params\":{\"sessionid\":\"s-1\"}}");   // (cue_out_has lowercases what it reads)
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"stopReason\":\"cancelled\",\"usage\":{\"inputTokens\":7426,\"outputTokens\":115}}}");
  #assert ev.kind == CuEventKind.none && x[0].recovering == 0;                              // the owner sees no end
  #assert cue_spent(x) == "{\"inputTokens\":7426,\"outputTokens\":115}" && cue_spent(x) == "";   // its usage, once
  ab: [256] u8;
  #assert cue_out_has(x, "\"id\":5,\"method\":\"session/prompt\"") && cue_out_has(x, "continue where you left off.");
  #assert cue_watch(x, 1600) == CUE_WATCH_NONE && cue_prompting(x);
  ev = cue_feed(x, CUE_T_SAYS);
  ev = cue_feed(x, cue_t_answer(5, "end_turn", ab[..]));
  #assert ev.kind == CuEventKind.answered && ev.of == CU_SESSION_PROMPT && !cue_stalled(x) && x[0].recovered == 1;
  #assert cue_send(x, "next") && cue_watch(x, 1700) == CUE_WATCH_NONE && x[0].recovered == 0;   // a new turn starts with none
  ev = cue_feed(x, cue_t_answer(6, "end_turn", ab[..]));
  #assert cue_watch(x, 9000) == CUE_WATCH_NONE && !x[0].watching;                           // no turn: nothing to watch
}

#test "stall watchdog: past the recoveries the turn is cancelled for good, and an unanswered cancel closes the agent" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  cue_test_turn(x, 1);
  #assert cue_watch(x, 1000) == CUE_WATCH_RECOVERING;
  ab: [256] u8;
  ev := cue_feed(x, cue_t_answer(4, "cancelled", ab[..]));
  #assert ev.kind == CuEventKind.none && cue_out_has(x, "continue where you left off.");
  #assert cue_watch(x, 1100) == CUE_WATCH_NONE;
  cu_outbox_clear(x[0].c);
  #assert cue_watch(x, 2099) == CUE_WATCH_NONE && cue_watch(x, 2100) == CUE_WATCH_GAVE_UP && cue_stalled(x);
  #assert cue_out_has(x, "session/cancel") && !cue_out_has(x, "session/prompt");
  ev = cue_feed(x, cue_t_answer(5, "cancelled", ab[..]));
  #assert ev.kind == CuEventKind.answered && cue_stalled(x) && !cue_out_has(x, "session/prompt");   // the owner ends it, failed

  // a cancel the agent never answers: one more silence closes it
  yb: [1] CuEngine; db: [1] CuClient; qb: [1] ClProcess; line2: [1024] u8; arena2: [2048] u8; out2: [4096] u8;
  y := yb[..]; cue_test(y, db[..], qb[..], line2[..], arena2[..], out2[..]);
  cue_test_turn(y, 2);
  #assert cue_watch(y, 1000) == CUE_WATCH_RECOVERING && y[0].live;
  #assert cue_watch(y, 1999) == CUE_WATCH_NONE && cue_watch(y, 2000) == CUE_WATCH_ENDED && !y[0].live && cue_stalled(y);
  #assert cue_watch(y, 5000) == CUE_WATCH_NONE;
}

#test "stall watchdog: a running tool, a waiting permission and steady thinking never trip it" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  cue_test_turn(x, 2);
  ev := cue_feed(x, CUE_T_TOOL); #assert x[0].ntools == 1;
  ev = cue_feed(x, CUE_T_TOOL_ASKS); #assert x[0].ntools == 1;                           // the same call, asking first
  #assert cue_watch(x, 60000) == CUE_WATCH_NONE;                                           // a minute-long command
  ev = cue_feed(x, CUE_T_PERMISSION); #assert ev.kind == CuEventKind.permission;
  #assert cue_watch(x, 90000) == CUE_WATCH_NONE;                                           // the owner deciding
  cu_permit(x[0].c, cu_allow_option(x[0].c));
  #assert cue_watch(x, 120000) == CUE_WATCH_NONE;
  ev = cue_feed(x, CUE_T_TOOL_DONE); #assert x[0].ntools == 0;
  #assert cue_watch(x, 120001) == CUE_WATCH_NONE;                                          // the clock starts again here
  for t: 1..<40 { ev = cue_feed(x, CUE_T_THINKS); #assert cue_watch(x, 120001 + t * 900) == CUE_WATCH_NONE; }
  #assert cue_watch(x, 120001 + 39 * 900 + 999) == CUE_WATCH_NONE && !cue_out_has(x, "session/cancel");
  #assert cue_watch(x, 120001 + 39 * 900 + 1000) == CUE_WATCH_RECOVERING;                  // then a real silence
}

#test "stall watchdog: off unless set, so a Cursor turn and a normal turn are untouched; the owner's stop is the owner's" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  cue_test_open(x);
  #assert cue_send(x, "fix it") && x[0].stall_ms == 0;
  #assert cue_watch(x, 0) == CUE_WATCH_NONE && cue_watch(x, 3600000) == CUE_WATCH_NONE && !cue_out_has(x, "session/cancel");
  ab: [256] u8;
  ev := cue_feed(x, cue_t_answer(4, "cancelled", ab[..]));
  #assert ev.kind == CuEventKind.answered;

  yb: [1] CuEngine; db: [1] CuClient; qb: [1] ClProcess; line2: [1024] u8; arena2: [2048] u8; out2: [4096] u8;
  y := yb[..]; cue_test(y, db[..], qb[..], line2[..], arena2[..], out2[..]);
  cue_test_turn(y, 2);
  for t: 1..<10 { ev = cue_feed(y, CUE_T_SAYS); #assert cue_watch(y, t * 999) == CUE_WATCH_NONE; }
  ev = cue_feed(y, cue_t_answer(4, "end_turn", ab[..]));
  #assert ev.kind == CuEventKind.answered && !cue_stalled(y) && !cue_out_has(y, "session/cancel");

  // the owner's stop during a recovery: its cancelled end goes to the owner, with no continue
  #assert cue_send(y, "again") && cue_watch(y, 20000) == CUE_WATCH_NONE;
  #assert cue_watch(y, 21000) == CUE_WATCH_RECOVERING;
  cue_cancel(y);
  ev = cue_feed(y, cue_t_answer(5, "cancelled", ab[..]));
  #assert ev.kind == CuEventKind.answered && !cue_stalled(y) && !cue_out_has(y, "session/prompt");
}

CUE_T_BG_EXEC :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"bg-1\",\"kind\":\"execute\",\"status\":\"in_progress\",\"rawInput\":{\"CommandLine\":\"sleep 5\"}}}}";
CUE_T_BG_EXEC2 :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"bg-2\",\"kind\":\"execute\",\"status\":\"in_progress\",\"rawInput\":{\"CommandLine\":\"git push\"}}}}";
CUE_T_BG_DAEMON :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"bg-d\",\"kind\":\"execute\",\"status\":\"in_progress\",\"rawInput\":{\"CommandLine\":\"server\",\"IsDaemon\":true}}}}";
CUE_T_BG_DONE :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"bg-1\",\"status\":\"completed\"}}}";
CUE_T_BG_DONE2 :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"bg-2\",\"status\":\"completed\"}}}";
CUE_T_BG_READ :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"r-1\",\"kind\":\"read\",\"status\":\"in_progress\",\"title\":\"File a.coax\"}}}";
CUE_T_USAGE :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"usage_update\",\"used\":1000,\"size\":1048576}}}";

#test "held-turn background commands: waits across reactive wakeup gap, ignores mid-wakeup/active-tool usage_update, settles cleanly" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  a := cu_agent_cursor(); a.defer_finalize_background = true; a.steers_with_prompt = true; cue_agent(x, a);
  cue_test_open(x);
  #assert cue_send(x, "run build");
  // Daemon execute does not count as a blocking background tool.
  ev := cue_feed(x, CUE_T_BG_DAEMON); #assert x[0].nbg_tools == 0;
  // Non-daemon execute does.
  ev = cue_feed(x, CUE_T_BG_EXEC); #assert x[0].nbg_tools == 1;
  ab: [256] u8;
  // session/prompt settles while bg-1 is active -> turn is held open.
  ev = cue_feed(x, cue_t_answer(4, "end_turn", ab[..]));
  #assert ev.kind == CuEventKind.none && cue_held_bg(x) && cue_turn_active(x);
  // Detached update, permission, and usage_update while bg-1 is STILL running do not end the turn.
  ev = cue_feed(x, CUE_T_SAYS); #assert ev.kind == CuEventKind.notification && cue_held_bg(x);
  ev = cue_feed(x, CUE_T_PERMISSION); #assert ev.kind == CuEventKind.permission && cue_held_bg(x);
  cu_permit(x[0].c, cu_allow_option(x[0].c));
  ev = cue_feed(x, CUE_T_USAGE); #assert ev.kind == CuEventKind.notification && cue_held_bg(x);
  #assert cue_watch(x, 1000) == CUE_WATCH_NONE && cue_watch(x, 5000) == CUE_WATCH_NONE && cue_held_bg(x);
  // bg-1 completes -> do NOT end immediately! agy takes 3-15s+ before emitting its reactive wakeup.
  ev = cue_feed(x, CUE_T_BG_DONE); #assert x[0].nbg_tools == 0 && cue_held_bg(x);
  #assert cue_watch(x, 5100) == CUE_WATCH_NONE && cue_watch(x, 17000) == CUE_WATCH_NONE && cue_held_bg(x);
  // Reactive wakeup arrives: usage_update followed 5ms later by chained bg-2 tool_call must NOT end turn!
  ev = cue_feed(x, CUE_T_USAGE);
  #assert cue_watch(x, 17002) == CUE_WATCH_NONE;
  ev = cue_feed(x, CUE_T_BG_EXEC2); #assert x[0].nbg_tools == 1 && !x[0].bg_usage_settled;
  // Interim message + usage_update while bg-2 is running must NOT end turn.
  ev = cue_feed(x, CUE_T_SAYS);
  ev = cue_feed(x, CUE_T_USAGE);
  #assert cue_watch(x, 19000) == CUE_WATCH_NONE && cue_watch(x, 25000) == CUE_WATCH_NONE && cue_held_bg(x);
  // bg-2 completes, followed by unclosed read_file, then final reply + final usage_update.
  ev = cue_feed(x, CUE_T_BG_DONE2); #assert x[0].nbg_tools == 0;
  #assert cue_watch(x, 25100) == CUE_WATCH_NONE;
  ev = cue_feed(x, CUE_T_BG_READ);
  ev = cue_feed(x, CUE_T_SAYS);
  ev = cue_feed(x, CUE_T_USAGE);
  #assert cue_watch(x, 30000) == CUE_WATCH_NONE && cue_held_bg(x);
  #assert cue_watch(x, 30000 + CUE_BG_USAGE_SETTLE_MS - 1) == CUE_WATCH_NONE && cue_held_bg(x);
  #assert cue_watch(x, 30000 + CUE_BG_USAGE_SETTLE_MS) == CUE_WATCH_BG_DONE && !cue_held_bg(x) && !cue_turn_active(x);

  // Second turn: bg tool finishes with NO reactive wakeup at all -> settles after CUE_BG_WAKE_GRACE_MS.
  #assert cue_send(x, "run tests");
  ev = cue_feed(x, CUE_T_BG_EXEC);
  ev = cue_feed(x, cue_t_answer(5, "end_turn", ab[..]));
  #assert ev.kind == CuEventKind.none && cue_held_bg(x);
  #assert cue_watch(x, 40000) == CUE_WATCH_NONE;
  ev = cue_feed(x, CUE_T_BG_DONE); #assert x[0].nbg_tools == 0;
  #assert cue_watch(x, 41000) == CUE_WATCH_NONE && cue_held_bg(x);
  for i: 1..<6 { #assert cue_watch(x, 41000 + i * 10000) == CUE_WATCH_NONE && cue_held_bg(x); }
  #assert cue_watch(x, 41000 + CUE_BG_WAKE_GRACE_MS - 1) == CUE_WATCH_NONE && cue_held_bg(x);
  #assert cue_watch(x, 41000 + CUE_BG_WAKE_GRACE_MS) == CUE_WATCH_BG_DONE && !cue_held_bg(x);

  // Third turn: 120s safety ceiling ends held turn even if bg tool never finishes.
  #assert cue_send(x, "long bg");
  ev = cue_feed(x, CUE_T_BG_EXEC);
  ev = cue_feed(x, cue_t_answer(6, "end_turn", ab[..]));
  #assert ev.kind == CuEventKind.none && cue_held_bg(x);
  #assert cue_watch(x, 200000) == CUE_WATCH_NONE;
  for i: 1..<12 { #assert cue_watch(x, 200000 + i * 10000) == CUE_WATCH_NONE && cue_held_bg(x); }
  #assert cue_watch(x, 200000 + 119999) == CUE_WATCH_NONE && cue_held_bg(x);
  #assert cue_watch(x, 200000 + 120000) == CUE_WATCH_BG_DONE && !cue_held_bg(x);

  // Stale cancelled tool_call_update after turn ended must NOT reopen held_bg.
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"bg-1\",\"status\":\"cancelled\"}}}");
  #assert !cue_held_bg(x) && !cue_turn_active(x);
}

#test "mid-turn steering and explicit stop: steers_with_prompt skips cancel, explicit stop cancels without teardown" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  a := cu_agent_cursor(); a.defer_finalize_background = true; a.steers_with_prompt = true; cue_agent(x, a);
  cue_test_open(x);
  #assert cue_send(x, "initial");
  cu_outbox_clear(x[0].c);
  // Steer during active turn with steers_with_prompt: sends session/prompt directly, no session/cancel.
  #assert cue_steer(x, "also check docs");
  #assert cue_out_has(x, "session/prompt") && !cue_out_has(x, "session/cancel");
  cu_outbox_clear(x[0].c);
  // Explicit Stop sends session/cancel and keeps runtime alive.
  cue_stop(x);
  #assert cue_out_has(x, "session/cancel") && x[0].live;

  // Default agent (steers_with_prompt == false): steer cancels and queues message.
  yb: [1] CuEngine; db: [1] CuClient; qb: [1] ClProcess; line2: [1024] u8; arena2: [2048] u8; out2: [4096] u8;
  y := yb[..]; cue_test(y, db[..], qb[..], line2[..], arena2[..], out2[..]);
  cue_test_open(y);
  #assert cue_send(y, "initial");
  cu_outbox_clear(y[0].c);
  #assert !cue_steer(y, "redirect");
  #assert cue_out_has(y, "session/cancel") && !cue_out_has(y, "session/prompt") && y[0].nowed > 0;
}

#test "resilience: unexpected exit marks restart_required with session/resume, fresh session drops it, sleep jump resets watchdog" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  cue_test_turn(x, 2);
  // Simulate a 10-minute host sleep jump during a turn: watchdog must not trip immediately.
  #assert cue_watch(x, 500) == CUE_WATCH_NONE;
  #assert cue_watch(x, 600500) == CUE_WATCH_NONE && !cue_out_has(x, "session/cancel");
  // After waking, normal silence of stall_ms (1000 ms) still trips recovery.
  #assert cue_watch(x, 601499) == CUE_WATCH_NONE;
  #assert cue_watch(x, 601500) == CUE_WATCH_RECOVERING;
  // Backwards clock jump also resets safely.
  #assert cue_watch(x, 1000) == CUE_WATCH_NONE;

  // Unexpected process exit marks restart_required and preserves last_session for resume.
  #assert cue_take(x, CuEventKind.end, 0) == CuEventKind.end;
  #assert !x[0].live && cue_needs_restart(x) && cue_last_session(x) == "s-1";
  #assert cue_prepare_restart(x) && !cue_needs_restart(x) && e_str(x[0].resume[..], x[0].nresume) == "s-1";

  // Fresh session drops resume/last_session and sends session/new when live.
  x[0].live = true; x[0].ready = true; cu_outbox_clear(x[0].c);
  cue_fresh_session(x);
  #assert x[0].nresume == 0 && x[0].last_session_n == 0 && !x[0].ready && cue_out_has(x, "session/new");
}

#test "detached subagents: running subagent holds turn open after prompt settles; zero running settles via cue_watch" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  a := cu_agent_cursor(); a.defer_finalize_background = true; a.steers_with_prompt = true; cue_agent(x, a);
  cue_test_turn(x, 2);
  // One detached subagent is running when session/prompt settles -> turn stays held_bg.
  cue_bg_subagents_set(x, 1);
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"stopReason\":\"end_turn\"}}");
  #assert ev.kind == CuEventKind.none && cue_held_bg(x);
  #assert cue_watch(x, 1000) == CUE_WATCH_NONE && cue_held_bg(x);
  // Mid-turn steer while held opens a new prompt without session/cancel; when that settles with
  // bg_subagents still > 0, the turn stays held until running drops to 0.
  cu_outbox_clear(x[0].c);
  #assert cue_steer(x, "keep checking") && cue_out_has(x, "session/prompt") && !cue_out_has(x, "session/cancel");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":5,\"result\":{\"stopReason\":\"end_turn\"}}");
  #assert ev.kind == CuEventKind.none && cue_held_bg(x);
  // Once subagent is killed (no wakeup expected), cue_watch releases the held turn immediately.
  cue_bg_subagents_set(x, 0);
  cue_bg_expect_wake(x, false);
  #assert cue_watch(x, 1100) == CUE_WATCH_BG_DONE && !cue_held_bg(x);
}

#test "scheduled wake runs: detached post-settle stream opens held_bg, accepts steers, and settles via cue_watch after usage_update" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  a := cu_agent_cursor(); a.defer_finalize_background = true; a.steers_with_prompt = true; cue_agent(x, a);
  cue_test_turn(x, 2);
  // Settle initial prompt cleanly (no background tools).
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"stopReason\":\"end_turn\"}}");
  #assert ev.kind == CuEventKind.answered && !cue_held_bg(x) && !cue_turn_active(x);
  // Scheduled wake arrives with a detached agent_message_chunk -> opens held_bg and makes turn steerable.
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"text\":\"Timer fired.\"}}}}");
  #assert cue_held_bg(x) && cue_turn_active(x);
  // usage_update arms settle debounce, and cue_watch finalizes with CUE_WATCH_BG_DONE once quiet.
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"update\":{\"sessionUpdate\":\"usage_update\"}}}");
  #assert cue_watch(x, 1000) == CUE_WATCH_NONE && cue_held_bg(x);
  #assert cue_watch(x, 1000 + CUE_BG_USAGE_SETTLE_MS) == CUE_WATCH_BG_DONE && !cue_held_bg(x) && !cue_turn_active(x);
}

#test "cue_send_blocks sends multipart ACP image+text blocks immediately and through held cue_owed" {
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  blocks := "{\"type\":\"text\",\"text\":\"inspect\"},{\"type\":\"image\",\"mimeType\":\"image/png\",\"data\":\"iVBORw==\"}";
  // Before session is ready, cue_send_blocks queues with owed_blocks = true
  #assert !cue_send_blocks(x, blocks) && x[0].nowed == blocks.count && x[0].owed_blocks;
  cue_test_open(x);
  cu_outbox_clear(x[0].c);
  cue_owed(x, true);
  #assert x[0].nowed == 0 && !x[0].owed_blocks;
  #assert cue_out_has(x, "\"method\":\"session/prompt\"") && cue_out_has(x, "\"type\":\"image\"");
  #assert cue_out_has(x, "\"mimetype\":\"image/png\"") && cue_out_has(x, "\"data\":\"ivborw==\"");
  // Also works immediately on an already-ready session
  cu_outbox_clear(x[0].c);
  #assert cue_send_blocks(x, blocks) && cue_out_has(x, "\"type\":\"image\"");
}

#test "mid-turn steers_with_prompt: superseded prompt end_turn is swallowed in both response orders" {
  // 1. Standard agy acp order: prompt #4 is active, steer sends prompt #5, server answers #4 end_turn
  //    immediately while carrying the turn on under #5. Engine MUST swallow #4 and only finish on #5.
  xb: [1] CuEngine; cb: [1] CuClient; pb: [1] ClProcess; line: [1024] u8; arena: [2048] u8; out: [4096] u8;
  x := xb[..]; cue_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  a := cu_agent_cursor(); a.defer_finalize_background = true; a.steers_with_prompt = true; cue_agent(x, a);
  cue_test_open(x);
  #assert cue_send(x, "initial") && x[0].active_prompt_id == 4;
  // Rapid double-steer (#5, #6)
  #assert cue_steer(x, "steer one") && x[0].active_prompt_id == 5;
  #assert cue_steer(x, "steer two") && x[0].active_prompt_id == 6;
  ab: [256] u8;
  ev := cue_feed(x, cue_t_answer(4, "end_turn", ab[..]));
  #assert ev.kind == CuEventKind.none && cue_turn_active(x) && x[0].active_prompt_id == 6;
  ev = cue_feed(x, cue_t_answer(5, "end_turn", ab[..]));
  #assert ev.kind == CuEventKind.none && cue_turn_active(x) && x[0].active_prompt_id == 6;
  ev = cue_feed(x, cue_t_answer(6, "end_turn", ab[..]));
  #assert ev.kind == CuEventKind.answered && ev.of == CU_SESSION_PROMPT && ev.id == 6 && !cue_turn_active(x) && x[0].active_prompt_id == 0;

  // 2. Reverse order: steer #8 answers early while original #7 stays pending on the server.
  //    Engine MUST keep turn active until #7 finishes.
  #assert cue_send(x, "turn two") && x[0].active_prompt_id == 7;
  #assert cue_steer(x, "steer reverse") && x[0].active_prompt_id == 8;
  ev = cue_feed(x, cue_t_answer(8, "end_turn", ab[..]));
  #assert ev.kind == CuEventKind.none && cue_turn_active(x) && x[0].active_prompt_id == 7;
  ev = cue_feed(x, cue_t_answer(7, "end_turn", ab[..]));
  #assert ev.kind == CuEventKind.answered && ev.of == CU_SESSION_PROMPT && ev.id == 7 && !cue_turn_active(x) && x[0].active_prompt_id == 0;
}
