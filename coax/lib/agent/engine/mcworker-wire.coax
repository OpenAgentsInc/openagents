// Microcoder's worker lines, one codec for both ends (compliance plan step C11, GitHub #13250;
// proto/coder/microcoder-worker-lines-v1.json). The worker (coder/tui/mcworker.coax) and its
// owners (mcworker-client.coax for Coder's terminal and the turn runner, coder/tui/memory.coax for
// embeddings) speak one JSON object a line each way. Every line is written and read here.
//
//   the owner writes, the worker reads (mww_request):
//     {"task":T,"session":S,"cwd":D[,"local":true],"sandbox":P,"policy":{"enabled":B,"allow":N,"ceiling":N,"roots":R}
//      [,"gated":true][,"model":M][,"effort":E]}                                   mww_task
//     {"answer":true,"ticket":N}  {"answer":false,"ticket":N,"why":W}              mww_answer
//     {"results":[{"exit":N,"output":O}],"ticket":N}   the sub-agents' results    mww_results
//     {"stop":true}  {"forget":true}                                               MWW_STOP_LINE, MWW_FORGET_LINE
//     {"embed":TEXT}  {"embed":TEXT,"query":true}                                  mww_embed
//     {"steer":T,"id":I[,"turn":N]}   input for the running turn (GitHub #13715)    mww_steer
//     {"steer":T,"id":I,"parent":true}   a parent run's note to its sub-agent (#13776)   mww_note
//     {"interrupt":true[,"resubmit":true]}   end the running turn                   mww_interrupt
//     {"queue":OP[,"id":I][,"to":N][,"now":true][,"key":K][,"text":T,"message":{...}]}   follow-ups   mww_queue
//   the worker writes, the owner reads (mww_read):
//     {"kind":"journal","path":P}                                                  mww_journal
//     {"kind":"ready"}                                                             mww_ready
//     {"kind":"reply","text":T}                                                    mww_reply
//     {"kind":"thought","text":T}                                                  mww_thought
//     {"kind":"thought","text":T}   a step's thinking, whole, before its answer    mww_thought
//     {"kind":"attempt","schema":...}   coder.observability.v2 with a null engine  mww_attempt (stream.coax's cst_attempt)
//     {"kind":"command","command":C,"exit":N,"timed_out":B,"output":O}             mww_command
//     {"kind":"view","path":P,"found":B}                                           mww_view
//     {"kind":"ask","command":C,"ticket":N}                                        mww_ask
//     {"kind":"ended","ending":E,"text":T}                                         mww_ended
//     {"kind":"embedding","values":[...]}  {"kind":"embedding","error":W}          mww_embedding, mww_embedding_error
//     {"kind":"turn","turn":N,"source":S,"id":I,"text":T}   a turn starts          mww_turn
//     {"kind":"steer","id":I,"status":S,"turn":N[,"reason":R][,"step":K][,"text":T]}   mww_steered
//     {"kind":"queue","paused":B,"reason":R,"active":I,"items":[{"id":I,"text":T}]}   mww_queue_begin/item/end
//     {"kind":"queue_refused","op":O,"id":I,"reason":R}                            mww_queue_refused
//     {"kind":"stop_agent","agent":N}   stop sub-agent N (the run's own choice)     mww_stop_agent
//
// Sub-agents that do not block (GitHub #13766): the owner answers a delegate line as soon as one
// sub-agent ends, fails or is stopped, or a steer for the run is accepted, not only when all have
// ended; each one still running is reported as such in its result (its output says so and
// gives its number) and keeps running. A stop_agent line names a sub-agent the run chose to stop
// (a delegated task with resume and stop): the owner stops that one alone; nothing waits on it.
// An owner that does not know the kind skips it, as it skips any.
//
// Follow-ups (GitHub #13715, #13716; after Codex's turn/steer, turn/interrupt and t3code's queue):
// the worker numbers its turns (turn) and says each one's start, with where it came from: source
// "message" (an owner's task line), "queue" (the head of the follow-up queue, sent when the
// worker went idle) or "resubmit" (the steers an interrupt sent again). A steer goes into the
// running turn between its steps; its status is accepted, rejected (reason no_active_turn,
// expected_turn_mismatch, active_turn_not_steerable, invalid or full), applied (it reached the
// model, as step), queued (its turn ended first: it heads the paused queue) or resubmitted. The
// queue line is the whole queue after every change, the worker's own: an owner shows it as it is.
// A queue op that cannot be done says why (queue_refused: unknown_id, invalid, full, dispatched,
// no_key).
//
// A worker's line has no newline here (the worker adds it when it sends); an owner's line ends
// with one, as the client always wrote it. A writer gives the line's length, or -1 when it does
// not fit. The readers look members up by name, in any order, and take what the two ends always
// took: a member of another type reads as absent.
//   coax/bin/coax test coax/lib/agent/engine/mcworker-wire.coax --library
//   coax/web/tool.sh coax/lib/agent/engine/mcworker-profile.coax proto/coder/microcoder-worker-lines-v1.json
#load "../claude/fields.coax";
#load "../session/stream.coax";

MWW_NONE :: 0;
// a worker's line
MWW_JOURNAL :: 1; MWW_READY :: 2; MWW_REPLY :: 3; MWW_ATTEMPT :: 4; MWW_COMMAND :: 5;
MWW_VIEW :: 6; MWW_ASK :: 7; MWW_ENDED :: 8; MWW_EMBEDDING :: 9;
MWW_DELEGATE :: 10;            // {"kind":"delegate","tasks":[{"level":L,"task":T}],"ticket":N}: a run with sub-agents hands tasks to its owner (GitHub #13655)
// an owner's line
MWW_TASK :: 11; MWW_ANSWER :: 12; MWW_STOP :: 13; MWW_FORGET :: 14; MWW_EMBED :: 15; MWW_RESULTS :: 16;
MWW_THOUGHT :: 18;             // {"kind":"thought","text":T}: a step's thinking (GitHub #13671)
MWW_RECALL :: 17;              // {"recall":[{"task":T,"reply":R}]}: the owner's kept turns of the conversation (GitHub #13661)
// follow-ups (GitHub #13715): the owner's lines, then the worker's
MWW_STEER :: 19; MWW_INTERRUPT :: 20; MWW_QUEUE :: 21;
MWW_TURN :: 22; MWW_STEERED :: 23; MWW_QUEUED :: 24; MWW_QUEUE_REFUSED :: 25;
// sub-agents that do not block (GitHub #13766): the worker's lines
MWW_STOP_AGENT :: 26;
MWW_TODOS :: 27;               // {"kind":"todos","todos":[{"id":I,"content":C,"status":S}]}: live agent checklist
MWW_DEVICE :: 28;              // {"kind":"device","op":OP,"ok":B,"shot":P}: after an oasim command's line, what it did to the simulator (GitHub #13811)
MWW_PERMIT :: 29;              // {"kind":"permit","ticket":N,"question":B,"title":T,"command":C,"options":O}: interactive permission or user-input question (GitHub #13831)
MWW_STATS :: 30;               // {"kind":"stats","ttft_ms":N,"decode_ms":N,"output_tokens":N}: per-attempt inference timing (TTFT and decode speed)
MWW_META :: 31;                // {"kind":"meta","title":T,"commands":[...]}: live session title & available slash commands (#14010)
// queue ops
MWW_QUEUE_OPS :: [10] string.["open", "add", "update", "delete", "move", "promote", "pause", "resume", "clear", "list"];

MWW_STOP_LINE :: "{\"stop\":true}\n";
MWW_FORGET_LINE :: "{\"forget\":true}\n";
MWW_EMBED_MOST :: 16384;       // the most bytes of an embedding's list a line carries

// ---- the owner's lines

// A message as the worker reads it: the task, the session it belongs to, the folder, the model
// server on this machine (local), the sandbox, the owner's policy, whether each command
// waits for an answer (gated), and the owner's model and effort when given.
McTask :: struct {
  task: string; session: string; cwd: string; local: bool; sandbox: string;
  policy: bool; allow: int; ceiling: int; roots: string; gated: bool;
  model: string;                 // the owner's --model ("" for the worker's default)
  effort: string;                // low, medium or high ("" for the worker's default, low)
  agents: bool;                  // the owner runs sub-agents: the run may delegate tasks (MWW_DELEGATE) and waits for mww_results
  claude: bool;                  // with agents: the owner runs Claude Code too, so a task's level may be haiku, sonnet, opus or fable (GitHub #13660)
  edits: bool;                   // a gated run whose edits are not refused: the owner gates commands only to show each as it starts
  unlimited: bool;               // the run has no budget: no model call, command, view or time limit ends it (GitHub #13667)
  no_ask: bool;                  // disable ask: "question" interactive prompting (GitHub #13701)
  openrouter: string;            // with agents: the OpenRouter model a task's level openrouter runs on ("" for none)
  no_steer: bool;                // the turn takes no steers ("steerable":false): a sub-agent's, which no person watches (GitHub #13715)
  device: bool;                  // the iOS Simulator is there: a step may hold device ops (coax/lib/microcoder/device.coax, GitHub #13811)
  mode: string;                  // optional review mode ("auto"|"default"|"plan"|"accept-edits"|"turbo", #13996)
  attachments: string;           // optional JSON array of attachment objects ([{"name":...,"mime_type":...,"data":...}], #14002)
  subagent_type: string;         // optional subagent persona ("Explore"|"Plan"|"general-purpose"|"verification"|custom, #14096)
  agent_id: string;              // optional stable subagent id (a<prefix>-<16hex>, #14096)
  allowed_tools: string;         // optional CSV allowlist for subagent (#14096)
  disallowed_tools: string;      // optional CSV denylist for subagent (#14096)
  omit_claudemd: bool;           // skip CLAUDE.md/AGENTS.md & git status for one-shot Explore/Plan (#14096)
  read_only: bool;               // strictly read-only tool & Bash guard (#14096)
  is_subagent: bool;             // marks child worker as a subagent (disables recursive Agent tool, #14096)
  git: string;                   // a sub-agent's git rule: "none", "commit" or "push" (mc_gg_refuse_publish, #14104); "" on a chat's own task
  is_fork: bool;                 // marks child worker as a FORK_AGENT sharing parent cached context (#14096)
  fork_context_path: string;     // path to serialized parent history + sibling placeholder tool_results (#14096)
}
mww_task :: (o: [] u8, t: McTask) -> int {
  n := json_raw(o, 0, "{\"task\":"); n = json_write_string(o, n, t.task);
  n = json_raw(o, n, ",\"session\":"); n = json_write_string(o, n, t.session);
  n = json_raw(o, n, ",\"cwd\":"); n = json_write_string(o, n, t.cwd);
  if t.local { n = json_raw(o, n, ",\"local\":true"); }
  n = json_raw(o, n, ",\"sandbox\":"); n = json_write_string(o, n, t.sandbox);
  n = json_raw(o, n, ",\"policy\":{\"enabled\":"); n = json_raw(o, n, ifx t.policy then "true" else "false");
  n = json_raw(o, n, ",\"allow\":"); n = json_write_int(o, n, t.allow);
  n = json_raw(o, n, ",\"ceiling\":"); n = json_write_int(o, n, t.ceiling);
  n = json_raw(o, n, ",\"roots\":"); n = json_write_string(o, n, t.roots); n = json_raw(o, n, "}");
  if t.gated { n = json_raw(o, n, ",\"gated\":true"); }
  if t.agents { n = json_raw(o, n, ",\"agents\":true"); }
  if t.claude { n = json_raw(o, n, ",\"claude\":true"); }
  if t.edits { n = json_raw(o, n, ",\"edits\":true"); }
  if t.unlimited { n = json_raw(o, n, ",\"unlimited\":true"); }
  if t.no_ask { n = json_raw(o, n, ",\"no_ask\":true"); }
  if t.model.count > 0 { n = json_raw(o, n, ",\"model\":"); n = json_write_string(o, n, t.model); }
  if t.effort.count > 0 { n = json_raw(o, n, ",\"effort\":"); n = json_write_string(o, n, t.effort); }
  if t.openrouter.count > 0 { n = json_raw(o, n, ",\"openrouter\":"); n = json_write_string(o, n, t.openrouter); }
  if t.no_steer { n = json_raw(o, n, ",\"steerable\":false"); }
  if t.device { n = json_raw(o, n, ",\"device\":true"); }
  if t.mode.count > 0 { n = json_raw(o, n, ",\"mode\":"); n = json_write_string(o, n, t.mode); }
  if t.attachments.count > 0 { n = json_raw(o, n, ",\"attachments\":"); n = json_raw(o, n, t.attachments); }
  if t.subagent_type.count > 0 { n = json_raw(o, n, ",\"subagent_type\":"); n = json_write_string(o, n, t.subagent_type); }
  if t.agent_id.count > 0 { n = json_raw(o, n, ",\"agent_id\":"); n = json_write_string(o, n, t.agent_id); }
  if t.allowed_tools.count > 0 { n = json_raw(o, n, ",\"allowed_tools\":"); n = json_write_string(o, n, t.allowed_tools); }
  if t.disallowed_tools.count > 0 { n = json_raw(o, n, ",\"disallowed_tools\":"); n = json_write_string(o, n, t.disallowed_tools); }
  if t.omit_claudemd { n = json_raw(o, n, ",\"omit_claudemd\":true"); }
  if t.read_only { n = json_raw(o, n, ",\"read_only\":true"); }
  if t.is_subagent { n = json_raw(o, n, ",\"is_subagent\":true"); }
  if t.git.count > 0 { n = json_raw(o, n, ",\"git\":"); n = json_write_string(o, n, t.git); }
  if t.is_fork { n = json_raw(o, n, ",\"is_fork\":true"); }
  if t.fork_context_path.count > 0 { n = json_raw(o, n, ",\"fork_context_path\":"); n = json_write_string(o, n, t.fork_context_path); }
  n = json_raw(o, n, "}\n");
  return n;
}
// The answer for the waiting command; refused with why ("refused" when empty).
mww_answer :: (o: [] u8, allow: bool, ticket: int, why: string) -> int {
  n := json_raw(o, 0, ifx allow then "{\"answer\":true" else "{\"answer\":false");
  n = json_raw(o, n, ",\"ticket\":"); n = json_write_int(o, n, ticket);
  if !allow { n = json_raw(o, n, ",\"why\":"); n = json_write_string(o, n, ifx why.count > 0 then why else "refused"); }
  n = json_raw(o, n, "}\n");
  return n;
}
// The answer for an interactive permission or question, carrying the chosen native optionId whether allowed or denied (GitHub #13831, #13997).
mww_answer_option :: (o: [] u8, allow: bool, ticket: int, option: string, why: string) -> int {
  n := json_raw(o, 0, ifx allow then "{\"answer\":true" else "{\"answer\":false");
  n = json_raw(o, n, ",\"ticket\":"); n = json_write_int(o, n, ticket);
  if option.count > 0 { n = json_raw(o, n, ",\"option\":"); n = json_write_string(o, n, option); }
  if !allow { n = json_raw(o, n, ",\"why\":"); n = json_write_string(o, n, ifx why.count > 0 then why else "refused"); }
  n = json_raw(o, n, "}\n");
  return n;
}
// The sub-agents' results for the waiting MWW_DELEGATE: results is a JSON list with one
// {"exit":N,"output":TEXT} for each task, in order.
mww_results :: (o: [] u8, ticket: int, results: string) -> int {
  n := json_raw(o, 0, "{\"results\":"); n = json_raw(o, n, results);
  n = json_raw(o, n, ",\"ticket\":"); n = json_write_int(o, n, ticket);
  return json_raw(o, n, "}\n");
}
// Input for the running turn: id is the owner's, stable for a resend (the worker takes it once);
// turn the turn it is meant for (0: whichever runs).
mww_steer :: (o: [] u8, id: string, text: string, turn: int) -> int {
  n := json_raw(o, 0, "{\"steer\":"); n = json_write_string(o, n, text);
  n = json_raw(o, n, ",\"id\":"); n = json_write_string(o, n, id);
  if turn > 0 { n = json_raw(o, n, ",\"turn\":"); n = json_write_int(o, n, turn); }
  return json_raw(o, n, "}\n");
}
// A parent run's note to its running sub-agent (GitHub #13776): a steer that "parent" marks, which
// a sub-agent's turn takes though it takes no person's steers ("steerable":false). A worker older
// than it rejects it active_turn_not_steerable, so its owner learns the note did not reach it.
mww_note :: (o: [] u8, id: string, text: string) -> int {
  n := json_raw(o, 0, "{\"steer\":"); n = json_write_string(o, n, text);
  n = json_raw(o, n, ",\"id\":"); n = json_write_string(o, n, id);
  return json_raw(o, n, ",\"parent\":true}\n");
}
// End the running turn; with resubmit, the steers it had not taken yet start a turn of their own.
mww_interrupt :: (o: [] u8, resubmit: bool) -> int {
  return json_raw(o, 0, ifx resubmit then "{\"interrupt\":true,\"resubmit\":true}\n" else "{\"interrupt\":true}\n");
}
// One queue op (MWW_QUEUE_OPS). open binds the queue to key (the chat's id: its file); add and
// update carry the text shown and message, the task object the turn sends (mww_task's, no line
// end); move takes to (the place, from 0); promote with now starts it at once. Members that are
// "", 0 or false are left out (to is written whenever op is move).
mww_queue :: (o: [] u8, op: string, id: string, text: string, message: string, to: int, now: bool, key: string) -> int {
  n := json_raw(o, 0, "{\"queue\":"); n = json_write_string(o, n, op);
  if id.count > 0 { n = json_raw(o, n, ",\"id\":"); n = json_write_string(o, n, id); }
  if op == "move" { n = json_raw(o, n, ",\"to\":"); n = json_write_int(o, n, to); }
  if now { n = json_raw(o, n, ",\"now\":true"); }
  if key.count > 0 { n = json_raw(o, n, ",\"key\":"); n = json_write_string(o, n, key); }
  if text.count > 0 { n = json_raw(o, n, ",\"text\":"); n = json_write_string(o, n, text); }
  if message.count > 0 { n = json_raw(o, n, ",\"message\":"); n = json_raw(o, n, message); }
  return json_raw(o, n, "}\n");
}
// A text to embed: a query's when query is set, else a document's.
// The turns of a conversation the owner kept, for a worker that has not seen them (a chat opened
// again, GitHub #13661). turns: a JSON list, [{"task":T,"reply":R}], oldest first. The worker
// forgets what it held and remembers these (the newest it has room for).
mww_recall :: (o: [] u8, turns: string) -> int {
  n := json_raw(o, 0, "{\"recall\":"); n = json_raw(o, n, turns);
  return json_raw(o, n, "}\n");
}
mww_embed :: (o: [] u8, text: string, query: bool) -> int {
  n := json_raw(o, 0, "{\"embed\":"); n = json_write_string(o, n, text);
  return json_raw(o, n, ifx query then ",\"query\":true}\n" else "}\n");
}

// An owner's line as the worker takes it. The worker tries the kinds in this order and takes the
// first that fits: stop and forget when the member is a boolean (either value), embed when the
// member is there, answer when it is a boolean, task when it is a string that is not empty.
// Anything else is MWW_NONE, which the worker skips.
MwwRequest :: struct {
  kind: int;
  text: string;                  // embed: the text
  query: bool;                   // embed: a query's embedding
  allow: bool; ticket: JsonInt; why: string; option: string;       // answer
  task: string; cwd: string; session: string; sandbox: string; model: string; effort: string;
  mode: string; attachments: string;
  openrouter: string;            // the OpenRouter model offered to sub-agents as level openrouter
  local: bool; gated: bool; agents: bool; edits: bool; claude: bool; unlimited: bool; no_ask: bool; device: bool;
  results: string;               // results: the list's JSON text
  recall: string;                // recall: the turns' JSON text
  id: string;                    // steer, queue: the item's id
  turn: JsonInt;                 // steer: the turn it is meant for
  parent: bool;                  // steer: a parent run's note to its sub-agent (mww_note)
  op: string;                    // queue: the op
  message: string;               // queue add, update: the task object's JSON text
  to: JsonInt;                   // queue move: the place
  now: bool;                     // queue promote: start it at once
  key: string;                   // queue open: the key its file is named by
  resubmit: bool;                // interrupt: send the held steers again as a turn
  policy: string;                // the policy member's JSON text, "" when there is none
  policy_on: bool;               // policy.enabled is true
  ceiling: JsonInt;              // policy.ceiling
  subagent_type: string; agent_id: string; allowed_tools: string; disallowed_tools: string;
  omit_claudemd: bool; read_only: bool; is_subagent: bool;
  is_fork: bool; fork_context_path: string;
  git: string;                   // task: a sub-agent's git rule ("" when the line has none)
}
// The strings are in msg or in ar; they hold until either changes. model is read only for a task
// that is not local, as the worker always did.
mww_request :: (ar: [] ClArena, msg: string, r: [] MwwRequest) -> int {
  r[0] = MwwRequest.{};
  if cl_bool(msg, "stop").ok { r[0].kind = MWW_STOP; return MWW_STOP; }
  if cl_bool(msg, "forget").ok { r[0].kind = MWW_FORGET; return MWW_FORGET; }
  if cl_raw(msg, "embed").count > 0 {
    q := cl_bool(msg, "query");
    r[0].query = q.ok && q.value;
    r[0].text = cl_str(ar, msg, "embed");
    r[0].kind = MWW_EMBED; return MWW_EMBED;
  }
  if cl_at(msg, "recall").tok == JSON_ARRAY { r[0].recall = cl_raw(msg, "recall"); r[0].kind = MWW_RECALL; return MWW_RECALL; }
  if cl_at(msg, "results").tok == JSON_ARRAY {
    r[0].results = cl_raw(msg, "results");
    r[0].ticket = cl_int(msg, "ticket");
    r[0].kind = MWW_RESULTS; return MWW_RESULTS;
  }
  ans := cl_bool(msg, "answer");
  if ans.ok {
    r[0].allow = ans.value;
    r[0].ticket = cl_int(msg, "ticket");
    r[0].why = cl_str(ar, msg, "why");
    r[0].option = cl_str(ar, msg, "option");
    r[0].kind = MWW_ANSWER; return MWW_ANSWER;
  }
  if cl_at(msg, "steer").tok == JSON_STRING {
    r[0].text = cl_str(ar, msg, "steer"); r[0].id = cl_str(ar, msg, "id"); r[0].turn = cl_int(msg, "turn");
    pa := cl_bool(msg, "parent"); r[0].parent = pa.ok && pa.value;
    r[0].kind = MWW_STEER; return MWW_STEER;
  }
  if cl_bool(msg, "interrupt").ok {
    rs := cl_bool(msg, "resubmit"); r[0].resubmit = rs.ok && rs.value;
    r[0].kind = MWW_INTERRUPT; return MWW_INTERRUPT;
  }
  if cl_at(msg, "queue").tok == JSON_STRING {
    r[0].op = cl_str(ar, msg, "queue"); r[0].id = cl_str(ar, msg, "id"); r[0].text = cl_str(ar, msg, "text");
    r[0].to = cl_int(msg, "to"); now := cl_bool(msg, "now"); r[0].now = now.ok && now.value;
    r[0].key = cl_str(ar, msg, "key");
    if cl_at(msg, "message").tok == JSON_OBJECT { r[0].message = cl_raw(msg, "message"); }
    r[0].kind = MWW_QUEUE; return MWW_QUEUE;
  }
  r[0].task = cl_str(ar, msg, "task");
  if r[0].task.count == 0 { return MWW_NONE; }
  r[0].cwd = cl_str(ar, msg, "cwd");
  local := cl_bool(msg, "local");
  r[0].local = local.ok && local.value;
  if !r[0].local { r[0].model = cl_str(ar, msg, "model"); }
  gated := cl_bool(msg, "gated");
  r[0].gated = gated.ok && gated.value;
  agents := cl_bool(msg, "agents"); edits := cl_bool(msg, "edits");
  r[0].agents = agents.ok && agents.value; r[0].edits = edits.ok && edits.value;
  unlimited := cl_bool(msg, "unlimited"); r[0].unlimited = unlimited.ok && unlimited.value;
  claude := cl_bool(msg, "claude"); r[0].claude = claude.ok && claude.value;
  no_ask := cl_bool(msg, "no_ask"); r[0].no_ask = no_ask.ok && no_ask.value;
  device := cl_bool(msg, "device"); r[0].device = device.ok && device.value;
  r[0].sandbox = cl_str(ar, msg, "sandbox");
  on := cl_bool(msg, "policy.enabled");
  r[0].policy_on = on.ok && on.value;
  r[0].ceiling = cl_int(msg, "policy.ceiling");
  r[0].session = cl_str(ar, msg, "session");
  r[0].policy = cl_raw(msg, "policy");
  r[0].effort = cl_str(ar, msg, "effort");
  r[0].openrouter = cl_str(ar, msg, "openrouter");
  r[0].mode = cl_str(ar, msg, "mode");
  if cl_at(msg, "attachments").tok == JSON_ARRAY { r[0].attachments = cl_raw(msg, "attachments"); }
  r[0].subagent_type = cl_str(ar, msg, "subagent_type");
  r[0].agent_id = cl_str(ar, msg, "agent_id");
  r[0].allowed_tools = cl_str(ar, msg, "allowed_tools");
  r[0].disallowed_tools = cl_str(ar, msg, "disallowed_tools");
  oc := cl_bool(msg, "omit_claudemd"); r[0].omit_claudemd = oc.ok && oc.value;
  ro := cl_bool(msg, "read_only"); r[0].read_only = ro.ok && ro.value;
  isub := cl_bool(msg, "is_subagent"); r[0].is_subagent = isub.ok && isub.value;
  r[0].git = cl_str(ar, msg, "git");
  ifk := cl_bool(msg, "is_fork"); r[0].is_fork = ifk.ok && ifk.value;
  r[0].fork_context_path = cl_str(ar, msg, "fork_context_path");
  r[0].kind = MWW_TASK; return MWW_TASK;
}

// A task line read whole, as mww_task wrote it: every member, the policy's too (the worker reads
// only what it uses, mww_request). false when the line has no task or no whole policy.
mww_task_read :: (ar: [] ClArena, msg: string, t: [] McTask) -> bool {
  t[0] = McTask.{};
  t[0].task = cl_str(ar, msg, "task");
  on := cl_bool(msg, "policy.enabled"); allow := cl_int(msg, "policy.allow"); ceiling := cl_int(msg, "policy.ceiling");
  if t[0].task.count == 0 || !on.ok || !allow.ok || !ceiling.ok || cl_at(msg, "policy.roots").tok != JSON_STRING { return false; }
  t[0].session = cl_str(ar, msg, "session"); t[0].cwd = cl_str(ar, msg, "cwd"); t[0].sandbox = cl_str(ar, msg, "sandbox");
  local := cl_bool(msg, "local"); gated := cl_bool(msg, "gated");
  t[0].local = local.ok && local.value; t[0].gated = gated.ok && gated.value;
  agents := cl_bool(msg, "agents"); edits := cl_bool(msg, "edits");
  t[0].agents = agents.ok && agents.value; t[0].edits = edits.ok && edits.value;
  unlimited := cl_bool(msg, "unlimited"); t[0].unlimited = unlimited.ok && unlimited.value;
  claude := cl_bool(msg, "claude"); t[0].claude = claude.ok && claude.value;
  no_ask := cl_bool(msg, "no_ask"); t[0].no_ask = no_ask.ok && no_ask.value;
  t[0].policy = on.value; t[0].allow = allow.value; t[0].ceiling = ceiling.value; t[0].roots = cl_str(ar, msg, "policy.roots");
  t[0].model = cl_str(ar, msg, "model"); t[0].effort = cl_str(ar, msg, "effort");
  t[0].openrouter = cl_str(ar, msg, "openrouter");
  steerable := cl_bool(msg, "steerable"); t[0].no_steer = steerable.ok && !steerable.value;
  device := cl_bool(msg, "device"); t[0].device = device.ok && device.value;
  t[0].mode = cl_str(ar, msg, "mode");
  if cl_at(msg, "attachments").tok == JSON_ARRAY { t[0].attachments = cl_raw(msg, "attachments"); }
  t[0].subagent_type = cl_str(ar, msg, "subagent_type");
  t[0].agent_id = cl_str(ar, msg, "agent_id");
  t[0].allowed_tools = cl_str(ar, msg, "allowed_tools");
  t[0].disallowed_tools = cl_str(ar, msg, "disallowed_tools");
  oc := cl_bool(msg, "omit_claudemd"); t[0].omit_claudemd = oc.ok && oc.value;
  ro := cl_bool(msg, "read_only"); t[0].read_only = ro.ok && ro.value;
  isub := cl_bool(msg, "is_subagent"); t[0].is_subagent = isub.ok && isub.value;
  t[0].git = cl_str(ar, msg, "git");
  ifk := cl_bool(msg, "is_fork"); t[0].is_fork = ifk.ok && ifk.value;
  t[0].fork_context_path = cl_str(ar, msg, "fork_context_path");
  return !ar[0].full;
}

// ---- the worker's lines

mww_journal :: (o: [] u8, path: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"journal\",\"path\":"); n = json_write_string(o, n, path);
  return json_raw(o, n, "}");
}
mww_ready :: (o: [] u8) -> int { return json_raw(o, 0, "{\"kind\":\"ready\"}"); }
// A step's thinking, as the model summarized it (GitHub #13671).
mww_thought :: (o: [] u8, text: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"thought\",\"text\":"); n = json_write_string(o, n, text);
  return json_raw(o, n, "}");
}
// What an oasim command did to the simulator (docs/desktop/ios-simulator-spec.md 7.5): its verb,
// whether it went, the screenshot it took ("" for none, and then no shot member).
mww_device :: (o: [] u8, op: string, ok: bool, shot: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"device\",\"op\":"); n = json_write_string(o, n, op);
  n = json_raw(o, n, ifx ok then ",\"ok\":true" else ",\"ok\":false");
  if shot.count > 0 { n = json_raw(o, n, ",\"shot\":"); n = json_write_string(o, n, shot); }
  return json_raw(o, n, "}");
}
// The device line for a command the run ran, when the command is oasim's (its program's last
// path part, as the page reads it): the verb its second word, ok when it exited 0, the shot the
// path its one JSON line names. 0 when it is not an oasim command.
mww_device_of :: (o: [] u8, command: string, exit: int, output: string) -> int {
  i := 0; while i < command.count && command[i] == ' ' { i += 1; }
  j := i; while j < command.count && command[j] != ' ' { j += 1; }
  base := i; for c, ci: command[i..<j] { if c == '/' { base = i + ci + 1; } }
  if cast(string) command[base..<j] != "oasim" { return 0; }
  v := j; while v < command.count && command[v] == ' ' { v += 1; }
  e := v; while e < command.count && command[e] != ' ' { e += 1; }
  if e == v { return 0; }
  ab: [4096] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  shot := ""; if exit == 0 && json_valid(output) { shot = cl_str(ar[..], output, "path"); }
  return mww_device(o, cast(string) command[v..<e], exit == 0, shot);
}
mww_todos :: (o: [] u8, todos_json: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"todos\",\"todos\":");
  n = json_raw(o, n, ifx todos_json.count > 0 then todos_json else "[]");
  return json_raw(o, n, "}");
}
mww_reply :: (o: [] u8, text: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"reply\",\"text\":"); n = json_write_string(o, n, text);
  return json_raw(o, n, "}");
}
// One request attempt: coder.observability.v2's line with no engine (the owner names it when it
// relays the line to the session log, micro-observation.coax). values: the seven counts of
// CST_ATTEMPT_COUNTS, -1 for one that was not observed.
mww_attempt :: (o: [] u8, gateway: string, model: string, effort: string, outcome: string, status: int, values: [] int) -> int {
  return cst_attempt(o, "", gateway, model, effort, outcome, status, values);
}
// Per-attempt inference timing emitted beside a finished attempt: time-to-first-token (ms, -1
// unknown), decode window (ms, 0 unknown), and generated output tokens (0 unknown).
mww_stats :: (o: [] u8, ttft_ms: int, decode_ms: int, output_tokens: int) -> int {
  n := json_raw(o, 0, "{\"kind\":\"stats\",\"ttft_ms\":"); n = json_write_int(o, n, ttft_ms);
  n = json_raw(o, n, ",\"decode_ms\":"); n = json_write_int(o, n, decode_ms);
  n = json_raw(o, n, ",\"output_tokens\":"); n = json_write_int(o, n, output_tokens);
  return json_raw(o, n, "}");
}
mww_command :: (o: [] u8, command: string, exit: int, timed_out: bool, output: string) -> int {
  return mww_command_tool(o, command, exit, timed_out, output, "", "", "", "");
}
// Rich tool completion carrying real tool kind, parallel toolCallId, file path, and unified diff (#14010).
// Optional keys are omitted when empty so existing command lines are byte-for-byte identical.
mww_command_tool :: (o: [] u8, command: string, exit: int, timed_out: bool, output: string, tool: string, tool_id: string, path: string, diff: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"command\",\"command\":"); n = json_write_string(o, n, command);
  n = json_raw(o, n, ",\"exit\":"); n = json_write_int(o, n, exit);
  n = json_raw(o, n, ifx timed_out then ",\"timed_out\":true" else ",\"timed_out\":false");
  n = json_raw(o, n, ",\"output\":"); n = json_write_string(o, n, output);
  if tool.count > 0 { n = json_raw(o, n, ",\"tool\":"); n = json_write_string(o, n, tool); }
  if tool_id.count > 0 { n = json_raw(o, n, ",\"id\":"); n = json_write_string(o, n, tool_id); }
  if path.count > 0 { n = json_raw(o, n, ",\"path\":"); n = json_write_string(o, n, path); }
  if diff.count > 0 { n = json_raw(o, n, ",\"diff\":"); n = json_write_string(o, n, diff); }
  return json_raw(o, n, "}");
}
mww_view :: (o: [] u8, path: string, found: bool) -> int {
  n := json_raw(o, 0, "{\"kind\":\"view\",\"path\":"); n = json_write_string(o, n, path);
  return json_raw(o, n, ifx found then ",\"found\":true}" else ",\"found\":false}");
}
mww_ask :: (o: [] u8, command: string, ticket: int) -> int {
  return mww_ask_tool(o, command, ticket, "", "", "");
}
// Rich tool start carrying real tool kind, parallel toolCallId, and file path (#14010).
mww_ask_tool :: (o: [] u8, command: string, ticket: int, tool: string, tool_id: string, path: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"ask\",\"command\":"); n = json_write_string(o, n, command);
  n = json_raw(o, n, ",\"ticket\":"); n = json_write_int(o, n, ticket);
  if tool.count > 0 { n = json_raw(o, n, ",\"tool\":"); n = json_write_string(o, n, tool); }
  if tool_id.count > 0 { n = json_raw(o, n, ",\"id\":"); n = json_write_string(o, n, tool_id); }
  if path.count > 0 { n = json_raw(o, n, ",\"path\":"); n = json_write_string(o, n, path); }
  return json_raw(o, n, "}");
}
// Live session metadata update: auto-generated title (session_info_update) and/or slash commands (available_commands_update; #14010).
mww_meta :: (o: [] u8, title: string, commands_json: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"meta\"");
  if title.count > 0 { n = json_raw(o, n, ",\"title\":"); n = json_write_string(o, n, title); }
  if commands_json.count > 0 { n = json_raw(o, n, ",\"commands\":"); n = json_raw(o, n, commands_json); }
  return json_raw(o, n, "}");
}
// Interactive permission escalation or structured user-input question (GitHub #13831, #13997).
// options_json is a JSON array of {"optionId":I,"name":L,"kind":K} objects (or "[]").
// warning is an optional security warning from _meta.agy.security.warning (omitted when empty).
mww_permit_warn :: (o: [] u8, ticket: int, question: bool, title: string, command: string, warning: string, options_json: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"permit\",\"ticket\":"); n = json_write_int(o, n, ticket);
  n = json_raw(o, n, ifx question then ",\"question\":true" else ",\"question\":false");
  n = json_raw(o, n, ",\"title\":"); n = json_write_string(o, n, title);
  n = json_raw(o, n, ",\"command\":"); n = json_write_string(o, n, command);
  if warning.count > 0 { n = json_raw(o, n, ",\"warning\":"); n = json_write_string(o, n, warning); }
  n = json_raw(o, n, ",\"options\":"); n = json_raw(o, n, ifx options_json.count > 0 then options_json else "[]");
  return json_raw(o, n, "}");
}
mww_permit :: (o: [] u8, ticket: int, question: bool, title: string, command: string, options_json: string) -> int {
  return mww_permit_warn(o, ticket, question, title, command, "", options_json);
}
// tasks: the delegated tasks' JSON list, [{"level":L,"task":T}]; L is hydrogen, carbon or neon, or a Claude model (haiku, sonnet, opus, fable).
mww_delegate :: (o: [] u8, tasks: string, ticket: int) -> int {
  n := json_raw(o, 0, "{\"kind\":\"delegate\",\"tasks\":"); n = json_raw(o, n, tasks);
  n = json_raw(o, n, ",\"ticket\":"); n = json_write_int(o, n, ticket);
  return json_raw(o, n, "}");
}
mww_delegate_ex :: (o: [] u8, tasks: string, ticket: int, wait_all: bool) -> int {
  n := json_raw(o, 0, "{\"kind\":\"delegate\",\"tasks\":"); n = json_raw(o, n, tasks);
  n = json_raw(o, n, ",\"ticket\":"); n = json_write_int(o, n, ticket);
  if wait_all { n = json_raw(o, n, ",\"wait_all\":true"); }
  return json_raw(o, n, "}");
}
// Stop sub-agent number agent (its place among the turn's sub-agents, from 1), and only it.
mww_stop_agent :: (o: [] u8, agent: int) -> int {
  n := json_raw(o, 0, "{\"kind\":\"stop_agent\",\"agent\":"); n = json_write_int(o, n, agent);
  return json_raw(o, n, "}");
}
// ending: finished, asked, stopped, failed, no_capacity, bad_replies or idle (mc_ending_name).
mww_ended :: (o: [] u8, ending: string, text: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"ended\",\"ending\":"); n = json_write_string(o, n, ending);
  n = json_raw(o, n, ",\"text\":"); n = json_write_string(o, n, text);
  return json_raw(o, n, "}");
}
// values: a JSON list of numbers as the embedding service gave it. It goes on one line: spaces,
// tabs and line ends are dropped, and bytes after MWW_EMBED_MOST are cut.
mww_embedding :: (o: [] u8, values: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"embedding\",\"values\":");
  // json_raw returns -1 or 29 (the prefix length), never 0 or 1.
  if n < 0 { return -1; } // mutant: equivalent
  kept := 0;
  for ch: values {
    if ch != 32 && ch != 10 && ch != 13 && ch != 9 && kept < MWW_EMBED_MOST {
      if n >= o.count { return -1; }
      o[n] = ch; n += 1; kept += 1;
    }
  }
  return json_raw(o, n, "}");
}
mww_embedding_error :: (o: [] u8, why: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"embedding\",\"error\":"); n = json_write_string(o, n, why);
  return json_raw(o, n, "}");
}
// A turn starts: its number, source message, queue or resubmit, and for a queued or resubmitted
// one the item's id and the text the person wrote ("" for a message: its owner has it).
mww_turn :: (o: [] u8, turn: int, source: string, id: string, text: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"turn\",\"turn\":"); n = json_write_int(o, n, turn);
  n = json_raw(o, n, ",\"source\":"); n = json_write_string(o, n, source);
  n = json_raw(o, n, ",\"id\":"); n = json_write_string(o, n, id);
  n = json_raw(o, n, ",\"text\":"); n = json_write_string(o, n, text);
  return json_raw(o, n, "}");
}
// A steer's status (accepted, rejected, applied, queued, resubmitted); reason for a rejected one,
// step for an applied one (0: left out).
// text: the steer's words, on accepted, so an owner that did not send it (a steer from the paired
// phone, GitHub #13713) can show it; "" leaves it out.
mww_steered :: (o: [] u8, id: string, status: string, turn: int, reason: string, step: int, text: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"steer\",\"id\":"); n = json_write_string(o, n, id);
  n = json_raw(o, n, ",\"status\":"); n = json_write_string(o, n, status);
  n = json_raw(o, n, ",\"turn\":"); n = json_write_int(o, n, turn);
  if reason.count > 0 { n = json_raw(o, n, ",\"reason\":"); n = json_write_string(o, n, reason); }
  if step > 0 { n = json_raw(o, n, ",\"step\":"); n = json_write_int(o, n, step); }
  if text.count > 0 { n = json_raw(o, n, ",\"text\":"); n = json_write_string(o, n, text); }
  return json_raw(o, n, "}");
}
// The whole queue, in three parts: begin, each item in order (k its place), end. Each returns
// where the line has reached, or -1 once it does not fit.
mww_queue_begin :: (o: [] u8, paused: bool, reason: string, active: string) -> int {
  n := json_raw(o, 0, ifx paused then "{\"kind\":\"queue\",\"paused\":true" else "{\"kind\":\"queue\",\"paused\":false");
  n = json_raw(o, n, ",\"reason\":"); n = json_write_string(o, n, reason);
  n = json_raw(o, n, ",\"active\":"); n = json_write_string(o, n, active);
  return json_raw(o, n, ",\"items\":[");
}
mww_queue_item :: (o: [] u8, at: int, k: int, id: string, text: string) -> int {
  n := json_raw(o, at, ifx k > 0 then ",{\"id\":" else "{\"id\":"); n = json_write_string(o, n, id);
  n = json_raw(o, n, ",\"text\":"); n = json_write_string(o, n, text);
  return json_raw(o, n, "}");
}
mww_queue_end :: (o: [] u8, at: int) -> int { return json_raw(o, at, "]}"); }
mww_queue_refused :: (o: [] u8, op: string, id: string, reason: string) -> int {
  n := json_raw(o, 0, "{\"kind\":\"queue_refused\",\"op\":"); n = json_write_string(o, n, op);
  n = json_raw(o, n, ",\"id\":"); n = json_write_string(o, n, id);
  n = json_raw(o, n, ",\"reason\":"); n = json_write_string(o, n, reason);
  return json_raw(o, n, "}");
}

// A worker's line as its owner takes it. Only the members of the line's kind are read.
MwwLine :: struct {
  kind: int;
  text: string;                  // reply: more of the reply. ended: the reply, or why it ended
  command: string;               // command, ask
  path: string;                  // journal: the journal file. view: the file viewed
  output: string;                // command
  ending: string;                // ended
  exit: JsonInt;                 // command
  timed_out: ClBool;             // command
  found: ClBool;                 // view
  ticket: JsonInt;               // ask, delegate
  agent: JsonInt;                // stop_agent: the sub-agent's number, from 1
  tasks: string;                 // delegate: the tasks' JSON list
  gateway: string; outcome: string; status: JsonInt; usd_micros: JsonInt; provider_cost_usd_micros: JsonInt;   // attempt, what an owner shows
  model: string; input_tokens: JsonInt; cached_tokens: JsonInt; output_tokens: JsonInt; reasoning_tokens: JsonInt;   // attempt: the context it used
  values: string;                // embedding: the list's JSON text, "" when there is none
  error: string;                 // embedding: the error member's JSON text, "" when there is none
  why: string;                   // embedding: the error's words
  turn: JsonInt;                 // turn, steer: the turn's number
  source: string;                // turn: message, queue or resubmit
  id: string;                    // turn, steer, queue_refused, ask/command toolCallId
  steer_status: string;          // steer: accepted, rejected, applied, queued or resubmitted
  reason: string;                // steer (rejected), queue (why paused), queue_refused
  step: JsonInt;                 // steer (applied)
  paused: ClBool;                // queue
  active: string;                // queue: the item whose turn runs ("" for none)
  items: string;                 // queue: the items' JSON list ([{"id","text"}]); read each with cl_item
  todos: string;                 // todos: the todo list's JSON array ([{"id","content","status"}]); read each with cl_item
  op: string;                    // queue_refused; device: the oasim verb
  ok: ClBool; shot: string;      // device: whether it went, the screenshot it took ("" for none)
  question: ClBool; title: string; options: string; warning: string; // permit: interactive permission or user-input question; meta: title
  ttft_ms: JsonInt; decode_ms: JsonInt;               // stats: time-to-first-token and decode duration in ms
  tool: string; diff: string; commands: string;       // ask/command: real tool kind & diff; meta: available commands JSON (#14010)
  wait_all: ClBool;                                   // delegate: wait for all sync tasks in batch before returning MWW_RESULTS (#14096)
}
// The line's kind, MWW_NONE for a kind that is not a worker's. The strings are in line or in ar;
// they hold until either changes. A string that does not fit in ar reads as "".
mww_read :: (ar: [] ClArena, line: string, l: [] MwwLine) -> int {
  l[0] = MwwLine.{};
  kind := cl_str(ar, line, "kind");
  k := MWW_NONE;
  if kind == "journal" { k = MWW_JOURNAL; l[0].path = cl_str(ar, line, "path"); }
  else if kind == "ready" { k = MWW_READY; }
  else if kind == "reply" { k = MWW_REPLY; l[0].text = cl_str(ar, line, "text"); }
  else if kind == "thought" { k = MWW_THOUGHT; l[0].text = cl_str(ar, line, "text"); }
  else if kind == "todos" { k = MWW_TODOS; l[0].todos = cl_raw(line, "todos"); }
  else if kind == "attempt" {
    k = MWW_ATTEMPT;
    l[0].usd_micros = cl_int(line, "usd_micros");
    l[0].provider_cost_usd_micros = cl_int(line, "provider_cost_usd_micros");
    l[0].outcome = cl_str(ar, line, "outcome");
    l[0].gateway = cl_str(ar, line, "gateway");
    l[0].status = cl_int(line, "status");
    l[0].model = cl_str(ar, line, "model");
    l[0].input_tokens = cl_int(line, "input_tokens"); l[0].cached_tokens = cl_int(line, "cached_tokens"); l[0].output_tokens = cl_int(line, "output_tokens"); l[0].reasoning_tokens = cl_int(line, "reasoning_tokens");
  }
  else if kind == "command" {
    k = MWW_COMMAND;
    l[0].command = cl_str(ar, line, "command");
    l[0].exit = cl_int(line, "exit");
    l[0].timed_out = cl_bool(line, "timed_out");
    l[0].output = cl_str(ar, line, "output");
    l[0].tool = cl_str(ar, line, "tool");
    l[0].id = cl_str(ar, line, "id");
    l[0].path = cl_str(ar, line, "path");
    l[0].diff = cl_str(ar, line, "diff");
  }
  else if kind == "view" { k = MWW_VIEW; l[0].path = cl_str(ar, line, "path"); l[0].found = cl_bool(line, "found"); }
  else if kind == "delegate" { k = MWW_DELEGATE; l[0].ticket = cl_int(line, "ticket"); l[0].tasks = cl_raw(line, "tasks"); l[0].wait_all = cl_bool(line, "wait_all"); }
  else if kind == "ask" {
    k = MWW_ASK;
    l[0].ticket = cl_int(line, "ticket");
    l[0].command = cl_str(ar, line, "command");
    l[0].tool = cl_str(ar, line, "tool");
    l[0].id = cl_str(ar, line, "id");
    l[0].path = cl_str(ar, line, "path");
  }
  else if kind == "permit" {
    k = MWW_PERMIT;
    l[0].ticket = cl_int(line, "ticket");
    l[0].question = cl_bool(line, "question");
    l[0].title = cl_str(ar, line, "title");
    l[0].command = cl_str(ar, line, "command");
    l[0].warning = cl_str(ar, line, "warning");
    l[0].options = cl_raw(line, "options");
  }
  else if kind == "ended" { k = MWW_ENDED; l[0].ending = cl_str(ar, line, "ending"); l[0].text = cl_str(ar, line, "text"); }
  else if kind == "embedding" { k = MWW_EMBEDDING; l[0].error = cl_raw(line, "error"); l[0].values = cl_raw(line, "values"); l[0].why = cl_str(ar, line, "error"); }
  else if kind == "turn" { k = MWW_TURN; l[0].turn = cl_int(line, "turn"); l[0].source = cl_str(ar, line, "source"); l[0].id = cl_str(ar, line, "id"); l[0].text = cl_str(ar, line, "text"); }
  else if kind == "steer" {
    k = MWW_STEERED; l[0].id = cl_str(ar, line, "id"); l[0].steer_status = cl_str(ar, line, "status"); l[0].turn = cl_int(line, "turn");
    l[0].reason = cl_str(ar, line, "reason"); l[0].step = cl_int(line, "step"); l[0].text = cl_str(ar, line, "text");
  }
  // the items are left as JSON: a long queue's text would not fit an owner's arena at once
  else if kind == "queue" { k = MWW_QUEUED; l[0].paused = cl_bool(line, "paused"); l[0].reason = cl_str(ar, line, "reason"); l[0].active = cl_str(ar, line, "active"); l[0].items = cl_raw(line, "items"); }
  else if kind == "stop_agent" { k = MWW_STOP_AGENT; l[0].agent = cl_int(line, "agent"); }
  else if kind == "device" { k = MWW_DEVICE; l[0].op = cl_str(ar, line, "op"); l[0].ok = cl_bool(line, "ok"); l[0].shot = cl_str(ar, line, "shot"); }
  else if kind == "stats" { k = MWW_STATS; l[0].ttft_ms = cl_int(line, "ttft_ms"); l[0].decode_ms = cl_int(line, "decode_ms"); l[0].output_tokens = cl_int(line, "output_tokens"); }
  else if kind == "meta" { k = MWW_META; l[0].title = cl_str(ar, line, "title"); l[0].commands = cl_raw(line, "commands"); }
  else if kind == "queue_refused" { k = MWW_QUEUE_REFUSED; l[0].op = cl_str(ar, line, "op"); l[0].id = cl_str(ar, line, "id"); l[0].reason = cl_str(ar, line, "reason"); }
  l[0].kind = k;
  return k;
}
// An attempt line read whole and written again, its engine kept (null when it has none): the
// line's length in out, or -1 when the line is not an attempt of coder.observability.v2.
mww_attempt_again :: (ar: [] ClArena, line: string, out: [] u8) -> int {
  if !json_valid(line) || cl_str(ar, line, "kind") != "attempt" || cl_str(ar, line, "schema") != CST_OBSERVABILITY_V2 { return -1; }
  status := cl_int(line, "status");
  if !status.ok { return -1; }
  values: [7] int; keys := CST_ATTEMPT_COUNTS;
  for i: 0..<7 { v := cl_int(line, keys[i]); values[i] = ifx v.ok then v.value else -1; }
  return cst_attempt(out, cl_str(ar, line, "engine"), cl_str(ar, line, "gateway"), cl_str(ar, line, "model"),
                     cl_str(ar, line, "requested_effort"), cl_str(ar, line, "outcome"), status.value, values[..]);
}

#test "microcoder worker lines: a message and an answer as the worker reads them" {
  o: [1024] u8;
  t := McTask.{task = "say \"hi\"", session = "s-1", cwd = "/w", sandbox = "read-only", policy = true, allow = 0, ceiling = 3, roots = "/w\n", gated = true};
  n := mww_task(o[..], t);
  #assert cast(string) o[0..<n] == "{\"task\":\"say \\\"hi\\\"\",\"session\":\"s-1\",\"cwd\":\"/w\",\"sandbox\":\"read-only\",\"policy\":{\"enabled\":true,\"allow\":0,\"ceiling\":3,\"roots\":\"/w\\n\"},\"gated\":true}\n";
  ab: [1024] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  r: [1] MwwRequest;
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_TASK;
  #assert r[0].task == "say \"hi\"" && r[0].session == "s-1" && r[0].cwd == "/w" && r[0].sandbox == "read-only";
  #assert !r[0].local && r[0].gated && r[0].policy_on && r[0].ceiling.ok && r[0].ceiling.value == 3 && r[0].model == "" && r[0].effort == "";
  #assert r[0].policy == "{\"enabled\":true,\"allow\":0,\"ceiling\":3,\"roots\":\"/w\\n\"}";
  t.local = true; t.policy = false; t.gated = false;
  n = mww_task(o[..], t);
  #assert cast(string) o[0..<n] == "{\"task\":\"say \\\"hi\\\"\",\"session\":\"s-1\",\"cwd\":\"/w\",\"local\":true,\"sandbox\":\"read-only\",\"policy\":{\"enabled\":false,\"allow\":0,\"ceiling\":3,\"roots\":\"/w\\n\"}}\n";
  t.model = "gemini-4-argon"; t.effort = "medium";
  n = mww_task(o[..], t);
  #assert cast(string) o[0..<n] == "{\"task\":\"say \\\"hi\\\"\",\"session\":\"s-1\",\"cwd\":\"/w\",\"local\":true,\"sandbox\":\"read-only\",\"policy\":{\"enabled\":false,\"allow\":0,\"ceiling\":3,\"roots\":\"/w\\n\"},\"model\":\"gemini-4-argon\",\"effort\":\"medium\"}\n";
  // read whole, it is written back the same
  ar[0].at = 0; back: [1] McTask; o2: [1024] u8;
  #assert mww_task_read(ar[..], cast(string) o[0..<n - 1], back[..]) && back[0].model == "gemini-4-argon" && back[0].roots == "/w\n" && back[0].allow == 0;
  #assert mww_task(o2[..], back[0]) == n && cast(string) o2[0..<n] == cast(string) o[0..<n];
  #assert !mww_task_read(ar[..], "{\"task\":\"t\",\"cwd\":\"/w\"}", back[..]) && !mww_task_read(ar[..], "{\"task\":\"t\",\"policy\":{\"enabled\":true,\"ceiling\":0}}", back[..]);
  // a local task's model is not read
  ar[0].at = 0;
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_TASK && r[0].local && r[0].model == "" && r[0].effort == "medium" && !r[0].policy_on;
  n = mww_answer(o[..], true, 7, "ignored");
  #assert cast(string) o[0..<n] == "{\"answer\":true,\"ticket\":7}\n";
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_ANSWER && r[0].allow && r[0].ticket.ok && r[0].ticket.value == 7 && r[0].why == "";
  n = mww_answer(o[..], false, 8, "");
  #assert cast(string) o[0..<n] == "{\"answer\":false,\"ticket\":8,\"why\":\"refused\"}\n";
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_ANSWER && !r[0].allow && r[0].ticket.value == 8 && r[0].why == "refused";
  n = mww_embed(o[..], "a \"fact\"", false);
  #assert cast(string) o[0..<n] == "{\"embed\":\"a \\\"fact\\\"\"}\n";
  ar[0].at = 0;
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_EMBED && r[0].text == "a \"fact\"" && !r[0].query;
  n = mww_embed(o[..], "q", true);
  #assert cast(string) o[0..<n] == "{\"embed\":\"q\",\"query\":true}\n";
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_EMBED && r[0].text == "q" && r[0].query;
}
#test "microcoder worker lines: what the worker takes and skips" {
  ab: [256] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  r: [1] MwwRequest;
  #assert mww_request(ar[..], "{\"stop\":true}", r[..]) == MWW_STOP && mww_request(ar[..], "{\"forget\":true}", r[..]) == MWW_FORGET;
  // a boolean of either value stops or forgets; stop comes before every other member
  #assert mww_request(ar[..], "{\"stop\":false,\"task\":\"t\"}", r[..]) == MWW_STOP && mww_request(ar[..], "{\"forget\":false}", r[..]) == MWW_FORGET;
  #assert mww_request(ar[..], "{\"stop\":1,\"task\":\"t\",\"cwd\":\"/w\"}", r[..]) == MWW_TASK;
  // an embed member of any type is an embedding request; one that is no string has no text
  #assert mww_request(ar[..], "{\"embed\":7}", r[..]) == MWW_EMBED && r[0].text == "";
  #assert mww_request(ar[..], "{\"answer\":true}", r[..]) == MWW_ANSWER && !r[0].ticket.ok;
  #assert mww_request(ar[..], "{\"answer\":\"yes\",\"task\":\"t\"}", r[..]) == MWW_TASK && r[0].cwd == "";
  #assert mww_request(ar[..], "{\"task\":\"\"}", r[..]) == MWW_NONE && mww_request(ar[..], "{\"task\":7}", r[..]) == MWW_NONE;
  #assert mww_request(ar[..], "{}", r[..]) == MWW_NONE && mww_request(ar[..], "not json", r[..]) == MWW_NONE && mww_request(ar[..], "", r[..]) == MWW_NONE;
  #assert mww_request(ar[..], "{\"task\":\"t\",\"policy\":{\"enabled\":true,\"ceiling\":0}}", r[..]) == MWW_TASK && r[0].policy_on && r[0].ceiling.ok && r[0].ceiling.value == 0;
  #assert mww_request(ar[..], "{\"task\":\"t\",\"policy\":{\"enabled\":true}}", r[..]) == MWW_TASK && r[0].policy_on && !r[0].ceiling.ok;
  #assert mww_request(ar[..], "{\"task\":\"t\"}", r[..]) == MWW_TASK && r[0].policy == "" && !r[0].policy_on && !r[0].gated && !r[0].local;
}
#test "microcoder worker lines: each of the worker's lines, written and read" {
  o: [2048] u8; ab: [2048] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  l: [1] MwwLine;
  n := mww_journal(o[..], "/h/worker-1.ajr");
  #assert cast(string) o[0..<n] == "{\"kind\":\"journal\",\"path\":\"/h/worker-1.ajr\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_JOURNAL && l[0].path == "/h/worker-1.ajr";
  n = mww_ready(o[..]);
  #assert cast(string) o[0..<n] == "{\"kind\":\"ready\"}" && mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_READY;
  n = mww_reply(o[..], "a\nb");
  #assert cast(string) o[0..<n] == "{\"kind\":\"reply\",\"text\":\"a\\nb\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_REPLY && l[0].text == "a\nb";
  n = mww_thought(o[..], "first\nthen");
  #assert cast(string) o[0..<n] == "{\"kind\":\"thought\",\"text\":\"first\\nthen\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_THOUGHT && l[0].text == "first\nthen";
  n = mww_command(o[..], "ls \"x\"", 3, false, "out\n");
  #assert cast(string) o[0..<n] == "{\"kind\":\"command\",\"command\":\"ls \\\"x\\\"\",\"exit\":3,\"timed_out\":false,\"output\":\"out\\n\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_COMMAND && l[0].command == "ls \"x\"" && l[0].exit.ok && l[0].exit.value == 3;
  #assert l[0].timed_out.ok && !l[0].timed_out.value && l[0].output == "out\n";
  n = mww_command(o[..], "sleep 9", -1, true, "");
  #assert cast(string) o[0..<n] == "{\"kind\":\"command\",\"command\":\"sleep 9\",\"exit\":-1,\"timed_out\":true,\"output\":\"\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_COMMAND && l[0].timed_out.value && l[0].exit.value == -1;
  n = mww_view(o[..], "a.txt", true);
  #assert cast(string) o[0..<n] == "{\"kind\":\"view\",\"path\":\"a.txt\",\"found\":true}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_VIEW && l[0].path == "a.txt" && l[0].found.ok && l[0].found.value;
  n = mww_view(o[..], "b.txt", false);
  #assert cast(string) o[0..<n] == "{\"kind\":\"view\",\"path\":\"b.txt\",\"found\":false}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_VIEW && l[0].found.ok && !l[0].found.value;
  n = mww_ask(o[..], "rm -rf build", 4);
  #assert cast(string) o[0..<n] == "{\"kind\":\"ask\",\"command\":\"rm -rf build\",\"ticket\":4}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_ASK && l[0].command == "rm -rf build" && l[0].ticket.ok && l[0].ticket.value == 4;
  n = mww_ended(o[..], "finished", "done");
  #assert cast(string) o[0..<n] == "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"done\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_ENDED && l[0].ending == "finished" && l[0].text == "done";
  n = mww_embedding(o[..], "[\n  0.5,\n\t-1e-3 , 2\r\n]");
  #assert cast(string) o[0..<n] == "{\"kind\":\"embedding\",\"values\":[0.5,-1e-3,2]}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_EMBEDDING && l[0].values == "[0.5,-1e-3,2]" && l[0].error == "";
  n = mww_embedding_error(o[..], "no Vertex key file");
  #assert cast(string) o[0..<n] == "{\"kind\":\"embedding\",\"error\":\"no Vertex key file\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_EMBEDDING && l[0].error == "\"no Vertex key file\"" && l[0].why == "no Vertex key file" && l[0].values == "";
  values := [7] int.[10, 2, 0, -1, -1, -1, 12];
  n = mww_attempt(o[..], "vertex", "m", "low", "rate_limited", 429, values[..]);
  #assert n > 0 && mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_ATTEMPT;
  #assert l[0].gateway == "vertex" && l[0].outcome == "rate_limited" && l[0].status.value == 429 && l[0].usd_micros.ok && l[0].usd_micros.value == 12 && !l[0].provider_cost_usd_micros.ok;
  #assert mww_read(ar[..], "{\"kind\":\"attempt\",\"gateway\":\"openrouter\",\"outcome\":\"done\",\"status\":200,\"provider_cost_usd_micros\":345,\"usd_micros\":400}", l[..]) == MWW_ATTEMPT;
  #assert l[0].provider_cost_usd_micros.ok && l[0].provider_cost_usd_micros.value == 345 && l[0].usd_micros.ok && l[0].usd_micros.value == 400;
  #assert !l[0].input_tokens.ok && l[0].model == "";
  #assert mww_read(ar[..], "{\"kind\":\"attempt\",\"model\":\"gemini-4-neon\",\"input_tokens\":1200,\"cached_tokens\":800,\"output_tokens\":90}", l[..]) == MWW_ATTEMPT;
  #assert l[0].model == "gemini-4-neon" && l[0].input_tokens.value == 1200 && l[0].cached_tokens.value == 800 && l[0].output_tokens.value == 90;
  back: [2048] u8;
  m := mww_attempt_again(ar[..], cast(string) o[0..<n], back[..]);
  #assert m == n && cast(string) back[0..<m] == cast(string) o[0..<n] && cl_raw(cast(string) back[0..<m], "engine") == "null";
  #assert mww_attempt_again(ar[..], "{\"kind\":\"attempt\",\"schema\":\"coder.observability.v1\",\"status\":200}", back[..]) < 0;
  #assert mww_attempt_again(ar[..], "{\"kind\":\"reply\",\"text\":\"x\"}", back[..]) < 0;
  // not a worker's line; a writer whose line does not fit
  #assert mww_read(ar[..], "{\"kind\":\"session\"}", l[..]) == MWW_NONE && mww_read(ar[..], "{}", l[..]) == MWW_NONE && mww_read(ar[..], "x", l[..]) == MWW_NONE;
  small: [20] u8;
  #assert mww_reply(small[..], "a reply that is long") < 0 && mww_embedding(small[..], "[1,2,3]") < 0 && mww_ready(small[..]) == 16;
}
#test "microcoder worker lines: an embedding's list is cut at its bound" {
  big: [MWW_EMBED_MOST + 64] u8; for i: 0..<big.count { big[i] = '1'; }
  o: [MWW_EMBED_MOST + 128] u8;
  n := mww_embedding(o[..], cast(string) big[..]);
  #assert n == 29 + MWW_EMBED_MOST + 1 && o[n - 1] == 125 && o[n - 2] == 49;
}

#test "an oasim command's device line: its verb, whether it went, its screenshot; nothing for another command" {
  o: [512] u8; ab: [1024] u8; ar: [1] ClArena; ar[0].buf = ab[..]; l: [1] MwwLine;
  n := mww_device_of(o[..], "oasim tap 201 640", 0, "{\"id\":2,\"ok\":true}\n");
  #assert cast(string) o[0..<n] == "{\"kind\":\"device\",\"op\":\"tap\",\"ok\":true}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_DEVICE && l[0].op == "tap" && l[0].ok.ok && l[0].ok.value && l[0].shot == "";
  n = mww_device_of(o[..], "  /A/Resources/oasim screenshot --settle 300 --out s/d-1.png", 0, "{\"id\":2,\"ok\":true,\"path\":\"/w/s/d-1.png\",\"bytes\":9}");
  #assert cast(string) o[0..<n] == "{\"kind\":\"device\",\"op\":\"screenshot\",\"ok\":true,\"shot\":\"/w/s/d-1.png\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_DEVICE && l[0].shot == "/w/s/d-1.png";
  n = mww_device_of(o[..], "oasim tap 1 2", 1, "{\"ok\":false,\"code\":\"no_grant\",\"path\":\"x\"}");
  #assert cast(string) o[0..<n] == "{\"kind\":\"device\",\"op\":\"tap\",\"ok\":false}" && mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_DEVICE && !l[0].ok.value;
  #assert mww_device_of(o[..], "oasim screenshot", 0, "not json") > 0 && cl_raw(cast(string) o[0..<mww_device_of(o[..], "oasim screenshot", 0, "not json")], "shot") == "";
  #assert mww_device_of(o[..], "ls oasim", 0, "") == 0 && mww_device_of(o[..], "oasimx tap 1 2", 0, "") == 0 && mww_device_of(o[..], "oasim", 0, "") == 0 && mww_device_of(o[..], "", 0, "") == 0;
  #assert mww_device_of(o[..], "/x/my-oasim tap 1 2", 0, "") == 0 && mww_device_of(o[..], "oasim   ", 0, "") == 0;
  // one space before it, three; a one-letter shot; a shot whose JSON escapes a quote
  #assert mww_device_of(o[..], " oasim tap 1 2", 0, "") > 0 && mww_device_of(o[..], "   oasim tap 1 2", 0, "") > 0;
  n = mww_device(o[..], "screenshot", true, "x"); #assert cast(string) o[0..<n] == "{\"kind\":\"device\",\"op\":\"screenshot\",\"ok\":true,\"shot\":\"x\"}";
  n = mww_device_of(o[..], "oasim screenshot", 0, "{\"ok\":true,\"path\":\"/w/a\\\"b.png\"}");
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_DEVICE && l[0].kind == MWW_DEVICE && l[0].shot == "/w/a\"b.png";
  // a line read after another holds nothing of the one before
  n = mww_steered(o[..], "s-1", "applied", 2, "", 0, ""); #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_STEERED && l[0].id == "s-1";
  n = mww_device(o[..], "tap", true, ""); #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_DEVICE && l[0].shot == "" && l[0].id == "" && !l[0].turn.ok;
}

#test "sub-agents: a task's agents and edits, the delegate line and the results line, each way" {
  o: [1024] u8; ab: [1024] u8; ar: [1] ClArena; ar[0].buf = ab[..];
  t := McTask.{task = "do", session = "s", cwd = "/w", sandbox = "danger-full-access", gated = true, agents = true, edits = true};
  n := mww_task(o[..], t);
  r: [1] MwwRequest; back: [1] McTask;
  #assert n > 0 && mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_TASK && r[0].agents && r[0].edits && r[0].gated && !r[0].unlimited;
  t.unlimited = true; n = mww_task(o[..], t);
  #assert n > 0 && mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_TASK && r[0].unlimited && mww_task_read(ar[..], cast(string) o[0..<n - 1], back[..]) && back[0].unlimited;
  t.no_ask = true; n = mww_task(o[..], t);
  #assert n > 0 && mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_TASK && r[0].no_ask && mww_task_read(ar[..], cast(string) o[0..<n - 1], back[..]) && back[0].no_ask;
  t.no_steer = true; n = mww_task(o[..], t);
  #assert n > 0 && cl_raw(cast(string) o[0..<n - 1], "steerable") == "false" && mww_task_read(ar[..], cast(string) o[0..<n - 1], back[..]) && back[0].no_steer;
  t.no_steer = false;
  t.device = true; n = mww_task(o[..], t);
  #assert n > 0 && cl_raw(cast(string) o[0..<n - 1], "device") == "true" && mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_TASK && r[0].device && mww_task_read(ar[..], cast(string) o[0..<n - 1], back[..]) && back[0].device;
  t.device = false; n = mww_task(o[..], t);
  #assert cl_raw(cast(string) o[0..<n - 1], "device") == "" && mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_TASK && !r[0].device && mww_task_read(ar[..], cast(string) o[0..<n - 1], back[..]) && !back[0].device;
  t.unlimited = false; t.no_ask = false; n = mww_task(o[..], t);
  #assert mww_task_read(ar[..], cast(string) o[0..<n - 1], back[..]) && back[0].agents && back[0].edits;
  n = mww_task(o[..], McTask.{task = "do", cwd = "/w"});
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_TASK && !r[0].agents && !r[0].edits;
  n = mww_recall(o[..], "[{\"task\":\"hi\",\"reply\":\"hello\"}]");
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_RECALL && cl_count(r[0].recall) == 1 && cl_str(ar[..], r[0].recall, "0.reply") == "hello";
  n = mww_delegate(o[..], "[{\"level\":\"hydrogen\",\"task\":\"a\"}]", 4);
  l: [1] MwwLine;
  #assert cast(string) o[0..<n] == "{\"kind\":\"delegate\",\"tasks\":[{\"level\":\"hydrogen\",\"task\":\"a\"}],\"ticket\":4}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_DELEGATE && l[0].ticket.value == 4 && l[0].tasks == "[{\"level\":\"hydrogen\",\"task\":\"a\"}]";
  n = mww_results(o[..], 4, "[{\"exit\":0,\"output\":\"ok\"}]");
  #assert cast(string) o[0..<n] == "{\"results\":[{\"exit\":0,\"output\":\"ok\"}],\"ticket\":4}\n";
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_RESULTS && r[0].ticket.value == 4 && r[0].results == "[{\"exit\":0,\"output\":\"ok\"}]";
}

#test "sub-agents that do not block: the stop_agent line, written and read" {
  o: [256] u8; ab: [256] u8; ar: [1] ClArena; ar[0].buf = ab[..]; l: [1] MwwLine; r: [1] MwwRequest;
  n := mww_stop_agent(o[..], 2);
  #assert cast(string) o[0..<n] == "{\"kind\":\"stop_agent\",\"agent\":2}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_STOP_AGENT && l[0].agent.ok && l[0].agent.value == 2 && !l[0].ticket.ok;
  // one with no number reads with none; the worker takes neither as an owner's line
  #assert mww_read(ar[..], "{\"kind\":\"stop_agent\"}", l[..]) == MWW_STOP_AGENT && !l[0].agent.ok;
  n = mww_todos(o[..], "[{\"id\":\"1\",\"content\":\"Step one\",\"status\":\"in_progress\"}]");
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_TODOS && cl_count(l[0].todos) == 1 && cl_str(ar[..], l[0].todos, "0.status") == "in_progress";
  #assert mww_request(ar[..], "{\"kind\":\"stop_agent\",\"agent\":2}", r[..]) == MWW_NONE;
  small: [20] u8; #assert mww_stop_agent(small[..], 2) < 0;
}

#test "follow-ups: the steer, interrupt and queue lines, each way" {
  o: [2048] u8; ab: [2048] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  r: [1] MwwRequest; l: [1] MwwLine;
  n := mww_steer(o[..], "s-1", "use \"b\" too", 3);
  #assert cast(string) o[0..<n] == "{\"steer\":\"use \\\"b\\\" too\",\"id\":\"s-1\",\"turn\":3}\n";
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_STEER && r[0].text == "use \"b\" too" && r[0].id == "s-1" && r[0].turn.ok && r[0].turn.value == 3;
  n = mww_steer(o[..], "s-2", "x", 0);
  #assert cast(string) o[0..<n] == "{\"steer\":\"x\",\"id\":\"s-2\"}\n" && mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_STEER && !r[0].turn.ok;
  #assert !r[0].parent;
  // a parent's note to its sub-agent (#13776): marked parent, with no turn
  n = mww_note(o[..], "note-1-1", "check b too");
  #assert cast(string) o[0..<n] == "{\"steer\":\"check b too\",\"id\":\"note-1-1\",\"parent\":true}\n";
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_STEER && r[0].parent && r[0].text == "check b too" && r[0].id == "note-1-1" && !r[0].turn.ok;
  #assert mww_request(ar[..], "{\"steer\":\"x\",\"id\":\"s\",\"parent\":false}", r[..]) == MWW_STEER && !r[0].parent;
  small: [24] u8; #assert mww_note(small[..], "note-1-1", "check b too") < 0;
  n = mww_interrupt(o[..], true);
  #assert cast(string) o[0..<n] == "{\"interrupt\":true,\"resubmit\":true}\n" && mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_INTERRUPT && r[0].resubmit;
  n = mww_interrupt(o[..], false);
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_INTERRUPT && !r[0].resubmit;
  ar[0].at = 0;
  n = mww_queue(o[..], "add", "q-1", "fix it", "{\"task\":\"fix it\",\"cwd\":\"/w\"}", 0, false, "");
  #assert cast(string) o[0..<n] == "{\"queue\":\"add\",\"id\":\"q-1\",\"text\":\"fix it\",\"message\":{\"task\":\"fix it\",\"cwd\":\"/w\"}}\n";
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_QUEUE && r[0].op == "add" && r[0].id == "q-1" && r[0].text == "fix it" && r[0].message == "{\"task\":\"fix it\",\"cwd\":\"/w\"}";
  // the nested task is not read as a task line
  #assert r[0].task == "";
  n = mww_queue(o[..], "move", "q-1", "", "", 0, false, "");
  #assert cast(string) o[0..<n] == "{\"queue\":\"move\",\"id\":\"q-1\",\"to\":0}\n" && mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_QUEUE && r[0].to.ok && r[0].to.value == 0;
  n = mww_queue(o[..], "promote", "q-1", "", "", 0, true, "");
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_QUEUE && r[0].now && r[0].message == "";
  n = mww_queue(o[..], "open", "", "", "", 0, false, "chat-7");
  #assert cast(string) o[0..<n] == "{\"queue\":\"open\",\"key\":\"chat-7\"}\n" && mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_QUEUE && r[0].key == "chat-7";
  // the worker's lines
  n = mww_turn(o[..], 2, "queue", "q-1", "fix it");
  #assert cast(string) o[0..<n] == "{\"kind\":\"turn\",\"turn\":2,\"source\":\"queue\",\"id\":\"q-1\",\"text\":\"fix it\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_TURN && l[0].turn.value == 2 && l[0].source == "queue" && l[0].id == "q-1" && l[0].text == "fix it";
  n = mww_steered(o[..], "s-1", "rejected", 2, "expected_turn_mismatch", 0, "");
  #assert cast(string) o[0..<n] == "{\"kind\":\"steer\",\"id\":\"s-1\",\"status\":\"rejected\",\"turn\":2,\"reason\":\"expected_turn_mismatch\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_STEERED && l[0].steer_status == "rejected" && l[0].reason == "expected_turn_mismatch" && !l[0].step.ok;
  n = mww_steered(o[..], "s-1", "applied", 2, "", 4, "");
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_STEERED && l[0].steer_status == "applied" && l[0].step.value == 4 && l[0].reason == "";
  // an accepted steer carries its words, for an owner that did not send it
  n = mww_steered(o[..], "s-3", "accepted", 2, "", 0, "use b");
  #assert cast(string) o[0..<n] == "{\"kind\":\"steer\",\"id\":\"s-3\",\"status\":\"accepted\",\"turn\":2,\"text\":\"use b\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_STEERED && l[0].text == "use b" && l[0].steer_status == "accepted";
  n = mww_steered(o[..], "s-4", "applied", 7, "", 0, "");
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_STEERED && l[0].id == "s-4" && l[0].turn.value == 7;
  n = mww_queue_begin(o[..], true, "error", "");
  n = mww_queue_item(o[..], n, 0, "q-1", "a"); n = mww_queue_item(o[..], n, 1, "q-2", "b"); n = mww_queue_end(o[..], n);
  #assert cast(string) o[0..<n] == "{\"kind\":\"queue\",\"paused\":true,\"reason\":\"error\",\"active\":\"\",\"items\":[{\"id\":\"q-1\",\"text\":\"a\"},{\"id\":\"q-2\",\"text\":\"b\"}]}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_QUEUED && l[0].paused.value && l[0].reason == "error" && cl_count(l[0].items) == 2 && cl_str(ar[..], l[0].items, "1.id") == "q-2";
  n = mww_queue_begin(o[..], false, "", "q-1"); n = mww_queue_end(o[..], n);
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_QUEUED && l[0].active == "q-1" && !l[0].paused.value;
  n = mww_queue_refused(o[..], "delete", "q-9", "unknown_id");
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_QUEUE_REFUSED && l[0].op == "delete" && l[0].id == "q-9" && l[0].reason == "unknown_id";
  // a stop still comes first, and a steer that is no string is no steer
  #assert mww_request(ar[..], "{\"stop\":true,\"steer\":\"x\"}", r[..]) == MWW_STOP && mww_request(ar[..], "{\"steer\":7}", r[..]) == MWW_NONE;
}

#test "microcoder worker lines: permit and answer_option round-trip" {
  ab: [8192] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  o: [2048] u8; l: [1] MwwLine; r: [1] MwwRequest;
  opts := "[{\"optionId\":\"allow_once\",\"name\":\"Allow once\",\"kind\":\"allow_once\"},{\"optionId\":\"reject_once\",\"name\":\"Deny\",\"kind\":\"reject_once\"}]";
  n := mww_permit(o[..], 9, false, "Run command", "rm -rf /tmp/demo", opts);
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_PERMIT && l[0].ticket.ok && l[0].ticket.value == 9 && !l[0].question.value && l[0].title == "Run command" && l[0].command == "rm -rf /tmp/demo" && cl_count(l[0].options) == 2;
  n = mww_permit(o[..], 10, true, "Pick a target", "", "[{\"optionId\":\"opt_a\",\"name\":\"Alpha\"}]");
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_PERMIT && l[0].question.value && l[0].ticket.value == 10;
  n = mww_answer_option(o[..], true, 9, "allow_once", "");
  #assert cast(string) o[0..<n] == "{\"answer\":true,\"ticket\":9,\"option\":\"allow_once\"}\n";
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_ANSWER && r[0].allow && r[0].ticket.value == 9 && r[0].option == "allow_once";
  n = mww_answer_option(o[..], false, 9, "", "user denied");
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_ANSWER && !r[0].allow && r[0].why == "user denied" && r[0].option == "";
  // edge cases: empty/1-char option and why, denied with option ignored, empty/1-char options_json
  n = mww_answer_option(o[..], true, 1, "", "");
  #assert cast(string) o[0..<n] == "{\"answer\":true,\"ticket\":1}\n";
  n = mww_answer_option(o[..], true, 1, "x", "");
  #assert cast(string) o[0..<n] == "{\"answer\":true,\"ticket\":1,\"option\":\"x\"}\n";
  n = mww_answer_option(o[..], false, 1, "reject_always", "");
  #assert cast(string) o[0..<n] == "{\"answer\":false,\"ticket\":1,\"option\":\"reject_always\",\"why\":\"refused\"}\n";
  n = mww_answer_option(o[..], false, 1, "", "n");
  #assert cast(string) o[0..<n] == "{\"answer\":false,\"ticket\":1,\"why\":\"n\"}\n";
  n = mww_permit(o[..], 11, false, "T", "", "");
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_PERMIT && l[0].options == "[]" && l[0].warning == "";
  n = mww_permit_warn(o[..], 13, false, "Run", "rm -rf /", "Destructive command", "[{\"optionId\":\"allow\",\"name\":\"Allow\",\"kind\":\"allow_once\"}]");
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_PERMIT && l[0].warning == "Destructive command";
  n = mww_permit(o[..], 12, false, "T", "", "0");
  #assert cast(string) o[0..<n] == "{\"kind\":\"permit\",\"ticket\":12,\"question\":false,\"title\":\"T\",\"command\":\"\",\"options\":0}";
  n = mww_stats(o[..], 340, 2100, 88);
  #assert cast(string) o[0..<n] == "{\"kind\":\"stats\",\"ttft_ms\":340,\"decode_ms\":2100,\"output_tokens\":88}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_STATS && l[0].ttft_ms.ok && l[0].ttft_ms.value == 340 && l[0].decode_ms.ok && l[0].decode_ms.value == 2100 && l[0].output_tokens.ok && l[0].output_tokens.value == 88;
}

#test "microcoder worker lines: task flags, request kinds, explicit false booleans and task_read guards" {
  ab: [4096] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  o: [2048] u8; r: [1] MwwRequest; back: [1] McTask;
  // mww_task: claude, 1-char model/effort/openrouter
  t := McTask.{task = "t", session = "s", cwd = "/w", sandbox = "ro", policy = true, allow = 2, ceiling = 5, roots = "/w", gated = true, claude = true, model = "m", effort = "e", openrouter = "r"};
  n := mww_task(o[..], t);
  #assert cast(string) o[0..<n] == "{\"task\":\"t\",\"session\":\"s\",\"cwd\":\"/w\",\"sandbox\":\"ro\",\"policy\":{\"enabled\":true,\"allow\":2,\"ceiling\":5,\"roots\":\"/w\"},\"gated\":true,\"claude\":true,\"model\":\"m\",\"effort\":\"e\",\"openrouter\":\"r\"}\n";
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_TASK && r[0].kind == MWW_TASK && r[0].claude && r[0].model == "m" && r[0].openrouter == "r";
  ar[0].at = 0;
  back[0] = McTask.{task = "stale", local = true, gated = true};
  #assert mww_task_read(ar[..], cast(string) o[0..<n - 1], back[..]) && back[0].task == "t" && back[0].policy && back[0].allow == 2 && back[0].gated && back[0].claude && back[0].openrouter == "r" && !back[0].local;
  // mww_request: r[0].kind set for every kind
  ar[0].at = 0;
  #assert mww_request(ar[..], "{\"stop\":true}", r[..]) == MWW_STOP && r[0].kind == MWW_STOP;
  #assert mww_request(ar[..], "{\"forget\":true}", r[..]) == MWW_FORGET && r[0].kind == MWW_FORGET;
  #assert mww_request(ar[..], "{\"embed\":\"e\",\"query\":false}", r[..]) == MWW_EMBED && r[0].kind == MWW_EMBED && !r[0].query;
  #assert mww_request(ar[..], "{\"recall\":[]}", r[..]) == MWW_RECALL && r[0].kind == MWW_RECALL;
  #assert mww_request(ar[..], "{\"results\":[]}", r[..]) == MWW_RESULTS && r[0].kind == MWW_RESULTS;
  #assert mww_request(ar[..], "{\"answer\":true}", r[..]) == MWW_ANSWER && r[0].kind == MWW_ANSWER;
  #assert mww_request(ar[..], "{\"steer\":\"hi\"}", r[..]) == MWW_STEER && r[0].kind == MWW_STEER;
  #assert mww_request(ar[..], "{\"interrupt\":true,\"resubmit\":false}", r[..]) == MWW_INTERRUPT && r[0].kind == MWW_INTERRUPT && !r[0].resubmit;
  #assert mww_request(ar[..], "{\"queue\":\"promote\",\"now\":false}", r[..]) == MWW_QUEUE && r[0].kind == MWW_QUEUE && !r[0].now;
  // explicit false booleans in task (for both mww_request and mww_task_read)
  ar[0].at = 0;
  fmsg := "{\"task\":\"t\",\"local\":false,\"gated\":false,\"agents\":false,\"edits\":false,\"unlimited\":false,\"claude\":false,\"no_ask\":false,\"device\":false,\"policy\":{\"enabled\":false,\"allow\":0,\"ceiling\":0,\"roots\":\"\"}}";
  #assert mww_request(ar[..], fmsg, r[..]) == MWW_TASK && !r[0].local && !r[0].gated && !r[0].agents && !r[0].edits && !r[0].unlimited && !r[0].claude && !r[0].no_ask && !r[0].device;
  ar[0].at = 0;
  #assert mww_task_read(ar[..], fmsg, back[..]) && !back[0].local && !back[0].gated && !back[0].agents && !back[0].edits && !back[0].unlimited && !back[0].claude && !back[0].no_ask && !back[0].device;
  // mww_task_read rejects missing each required field individually
  ar[0].at = 0;
  #assert !mww_task_read(ar[..], "{\"task\":\"\",\"policy\":{\"enabled\":true,\"allow\":0,\"ceiling\":0,\"roots\":\"\"}}", back[..]);
  #assert !mww_task_read(ar[..], "{\"task\":\"t\",\"policy\":{\"allow\":0,\"ceiling\":0,\"roots\":\"\"}}", back[..]);
  #assert !mww_task_read(ar[..], "{\"task\":\"t\",\"policy\":{\"enabled\":true,\"ceiling\":0,\"roots\":\"\"}}", back[..]);
  #assert !mww_task_read(ar[..], "{\"task\":\"t\",\"policy\":{\"enabled\":true,\"allow\":0,\"roots\":\"\"}}", back[..]);
  #assert !mww_task_read(ar[..], "{\"task\":\"t\",\"policy\":{\"enabled\":true,\"allow\":0,\"ceiling\":0}}", back[..]);
  // clearing stale fields on failed mww_task_read
  back[0] = McTask.{task = "stale", local = true};
  #assert !mww_task_read(ar[..], "{}", back[..]) && !back[0].local;
}

#test "subagents (#14096): extended McTask metadata and mww_delegate_ex wait_all round-trip" {
  ab: [4096] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  o: [2048] u8; r: [1] MwwRequest; back: [1] McTask; l: [1] MwwLine;
  t := McTask.{
    task = "inspect files", session = "s1", cwd = "/w", sandbox = "danger-full-access",
    policy = true, allow = 1, ceiling = 3, roots = "/w",
    subagent_type = "Explore", agent_id = "aexplore-0123456789abcdef",
    allowed_tools = "Read,Glob,Grep", disallowed_tools = "Edit,Write,Agent",
    omit_claudemd = true, read_only = true, is_subagent = true, git = "commit",
  };
  n := mww_task(o[..], t);
  #assert n > 0 && mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_TASK;
  #assert r[0].subagent_type == "Explore" && r[0].agent_id == "aexplore-0123456789abcdef";
  #assert r[0].allowed_tools == "Read,Glob,Grep" && r[0].disallowed_tools == "Edit,Write,Agent";
  #assert r[0].omit_claudemd && r[0].read_only && r[0].is_subagent && r[0].git == "commit";
  ar[0].at = 0;
  #assert mww_task_read(ar[..], cast(string) o[0..<n - 1], back[..]);
  #assert back[0].subagent_type == "Explore" && back[0].agent_id == "aexplore-0123456789abcdef";
  #assert back[0].omit_claudemd && back[0].read_only && back[0].is_subagent && back[0].git == "commit";

  dn := mww_delegate_ex(o[..], "[{\"level\":\"neon\",\"subagent_type\":\"Explore\",\"task\":\"scan\"}]", 7, true);
  #assert dn > 0 && mww_read(ar[..], cast(string) o[0..<dn], l[..]) == MWW_DELEGATE;
  #assert l[0].ticket.ok && l[0].ticket.value == 7 && l[0].wait_all.ok && l[0].wait_all.value;
}

#test "microcoder worker lines: optional single-byte fields, tool metadata, meta lines, and refusal edges" {
  ab: [4096] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  o: [2048] u8; r: [1] MwwRequest; back: [1] McTask; l: [1] MwwLine;
  // mww_task / mww_request / mww_task_read: mode, attachments, 1-byte optional strings, is_fork, fork_context_path
  t := McTask.{
    task = "t", session = "s", cwd = "/", sandbox = "r", policy = true, allow = 0, ceiling = 1, roots = "/",
    mode = "a", attachments = "0", subagent_type = "E", agent_id = "i",
    allowed_tools = "R", disallowed_tools = "W", git = "c", is_fork = true, fork_context_path = "p",
  };
  n := mww_task(o[..], t);
  #assert cast(string) o[0..<n] == "{\"task\":\"t\",\"session\":\"s\",\"cwd\":\"/\",\"sandbox\":\"r\",\"policy\":{\"enabled\":true,\"allow\":0,\"ceiling\":1,\"roots\":\"/\"},\"mode\":\"a\",\"attachments\":0,\"subagent_type\":\"E\",\"agent_id\":\"i\",\"allowed_tools\":\"R\",\"disallowed_tools\":\"W\",\"git\":\"c\",\"is_fork\":true,\"fork_context_path\":\"p\"}\n";
  #assert mww_request(ar[..], cast(string) o[0..<n - 1], r[..]) == MWW_TASK && r[0].mode == "a" && r[0].attachments == "" && r[0].is_fork && r[0].fork_context_path == "p";
  ar[0].at = 0;
  #assert mww_task_read(ar[..], cast(string) o[0..<n - 1], back[..]) && back[0].mode == "a" && back[0].attachments == "" && back[0].allowed_tools == "R" && back[0].disallowed_tools == "W" && back[0].is_fork && back[0].fork_context_path == "p";
  // attachments as array vs object/string, and explicit false booleans for omit_claudemd/read_only/is_subagent/is_fork
  ar[0].at = 0;
  arr_msg := "{\"task\":\"t\",\"mode\":\"plan\",\"attachments\":[{\"name\":\"a\"}],\"omit_claudemd\":false,\"read_only\":false,\"is_subagent\":false,\"is_fork\":false,\"policy\":{\"enabled\":true,\"allow\":0,\"ceiling\":0,\"roots\":\"\"}}";
  #assert mww_request(ar[..], arr_msg, r[..]) == MWW_TASK && r[0].mode == "plan" && r[0].attachments == "[{\"name\":\"a\"}]" && !r[0].omit_claudemd && !r[0].read_only && !r[0].is_subagent && !r[0].is_fork;
  ar[0].at = 0;
  #assert mww_task_read(ar[..], arr_msg, back[..]) && back[0].attachments == "[{\"name\":\"a\"}]" && !back[0].omit_claudemd && !back[0].read_only && !back[0].is_subagent && !back[0].is_fork;
  ar[0].at = 0;
  obj_msg := "{\"task\":\"t\",\"attachments\":{},\"policy\":{\"enabled\":true,\"allow\":0,\"ceiling\":0,\"roots\":\"\"}}";
  #assert mww_request(ar[..], obj_msg, r[..]) == MWW_TASK && r[0].attachments == "" && mww_task_read(ar[..], obj_msg, back[..]) && back[0].attachments == "";
  // 1-char optional fields in mww_answer, mww_steer, mww_queue, mww_todos, mww_permit_warn, mww_steered
  n = mww_answer(o[..], false, 1, "x"); #assert cast(string) o[0..<n] == "{\"answer\":false,\"ticket\":1,\"why\":\"x\"}\n";
  n = mww_steer(o[..], "s", "t", 1); #assert cast(string) o[0..<n] == "{\"steer\":\"t\",\"id\":\"s\",\"turn\":1}\n";
  n = mww_queue(o[..], "add", "i", "t", "0", 0, false, "k"); #assert cast(string) o[0..<n] == "{\"queue\":\"add\",\"id\":\"i\",\"key\":\"k\",\"text\":\"t\",\"message\":0}\n";
  n = mww_todos(o[..], ""); #assert cast(string) o[0..<n] == "{\"kind\":\"todos\",\"todos\":[]}";
  n = mww_todos(o[..], "0"); #assert cast(string) o[0..<n] == "{\"kind\":\"todos\",\"todos\":0}";
  n = mww_permit_warn(o[..], 1, false, "T", "c", "!", "[]"); #assert cast(string) o[0..<n] == "{\"kind\":\"permit\",\"ticket\":1,\"question\":false,\"title\":\"T\",\"command\":\"c\",\"warning\":\"!\",\"options\":[]}";
  n = mww_steered(o[..], "i", "s", 1, "r", 1, "t"); #assert cast(string) o[0..<n] == "{\"kind\":\"steer\",\"id\":\"i\",\"status\":\"s\",\"turn\":1,\"reason\":\"r\",\"step\":1,\"text\":\"t\"}";
  // mww_command_tool, mww_ask_tool, mww_meta, reasoning_tokens
  ar[0].at = 0;
  n = mww_command_tool(o[..], "c", 0, false, "o", "t", "i", "p", "d");
  #assert cast(string) o[0..<n] == "{\"kind\":\"command\",\"command\":\"c\",\"exit\":0,\"timed_out\":false,\"output\":\"o\",\"tool\":\"t\",\"id\":\"i\",\"path\":\"p\",\"diff\":\"d\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_COMMAND && l[0].tool == "t" && l[0].id == "i" && l[0].path == "p" && l[0].diff == "d";
  n = mww_ask_tool(o[..], "c", 1, "t", "i", "p");
  #assert cast(string) o[0..<n] == "{\"kind\":\"ask\",\"command\":\"c\",\"ticket\":1,\"tool\":\"t\",\"id\":\"i\",\"path\":\"p\"}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_ASK && l[0].tool == "t" && l[0].id == "i" && l[0].path == "p";
  n = mww_meta(o[..], "", ""); #assert cast(string) o[0..<n] == "{\"kind\":\"meta\"}";
  n = mww_meta(o[..], "T", "0"); #assert cast(string) o[0..<n] == "{\"kind\":\"meta\",\"title\":\"T\",\"commands\":0}";
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_META && l[0].kind == MWW_META && l[0].title == "T" && l[0].commands == "0";
  #assert mww_read(ar[..], "{\"kind\":\"attempt\",\"reasoning_tokens\":7}", l[..]) == MWW_ATTEMPT && l[0].reasoning_tokens.ok && l[0].reasoning_tokens.value == 7;
  // mww_embedding exact buffer overflow, mww_attempt_again missing status
  exact: [30] u8;
  #assert mww_embedding(exact[..], "[1]") == -1;
  o2: [2048] u8;
  #assert mww_attempt_again(ar[..], "{\"kind\":\"attempt\",\"schema\":\"coder.observability.v2\"}", o2[..]) == -1;
}

#test "mww_attempt_again rejects valid JSON over JSON_MAX_STRING" {
  ab: [128] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  // A valid JSON attempt with a >65536-byte string fails json_valid (JSON_MAX_STRING) while cl_str (CL_DOC_MAX) still parses kind/schema.
  big_attempt: [66000] u8;
  ba := json_raw(big_attempt[..], 0, "{\"kind\":\"attempt\",\"schema\":\"coder.observability.v2\",\"gateway\":\"vertex\",\"model\":\"m\",\"requested_effort\":\"low\",\"outcome\":\"rate_limited\",\"status\":429,\"pad\":\"");
  for idx: 0..<65537 { big_attempt[ba] = 'a'; ba += 1; }
  ba = json_raw(big_attempt[..], ba, "\"}");
  o2: [2048] u8;
  #assert mww_attempt_again(ar[..], cast(string) big_attempt[0..<ba], o2[..]) == -1;
}
