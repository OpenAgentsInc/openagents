// Checks are loaded only by the codec's #test edge.
#load "execution-fixtures.coax";
#test "escaped-key fixtures have exact independent bytes and retain every other field" {
 out:[1024]u8;raw:="{\"task_id\":\"x\",\"count\":1}";
 #assert ex_test_alias(raw,"task_id",out[..])=="{\"\\u0074ask_id\":\"x\",\"count\":1}";
 #assert ex_test_alias(raw,"absent",out[..])==raw;
 #assert ex_test_alias("{","task_id",out[..])=="";
}
#test "execution binding round trips all pinned identities and refuses a short output or arena" {
 b:=ex_test_binding();out:[8192]u8;again:[8192]u8;arena:[1024]u8;read:[1]ExBinding;
 n:=ex_binding_write(b,out[..]);#assert n>0 && ex_binding_read(cast(string)out[0..<n],read[..],arena[..]);
 #assert read[0].engine=="codex" && read[0].account=="system" && read[0].turn==b.turn && read[0].report_at==999 && read[0].input_bytes==201;
 #assert ex_binding_write(read[0],again[..])==n && cast(string)again[0..<n]==cast(string)out[0..<n];
 #assert ex_binding_write(b,again[0..<n-1])<0 && ex_binding_write(b,again[0..<n])==n;
 #assert !ex_binding_read(cast(string)out[0..<n],read[..],arena[0..<1]);
 b.engine="claude";b.account=EX_TEST_ID;b.model="claude-opus-5-5";b.effort="";#assert ex_binding_write(b,out[..])>0;
}
#test "every binding field is required typed and closed, integers never round" {
 out:[8192]u8;changed:[8192]u8;arena:[1024]u8;read:[1]ExBinding;n:=ex_binding_write(ex_test_binding(),out[..]);raw:=cast(string)out[0..<n];
 keys:=[19]string.["schema","task_id","conversation_id","turn_id","route_id","host_pubkey","workspace_id","session_id","command_id","engine_id","account_id","model_id","effort_id","input_sha256","input_bytes","report_sha256","report_observed_at_ms","issued_at_ms","expires_at_ms"];
 for key:keys {#assert !ex_binding_read(ex_test_field(raw,key,"",changed[..]),read[..],arena[..]);#assert !ex_binding_read(ex_test_field(raw,key,"null",changed[..]),read[..],arena[..]);}
 for number:[7]string.["0","-0","-1","1.0","1e3","\"1000\"","9007199254740992"] {#assert !ex_binding_read(ex_test_field(raw,"issued_at_ms",number,changed[..]),read[..],arena[..]);}
 for text:[4]string.["\"micro\"","\"psionic\"","\"Codex\"","\"\""] {#assert !ex_binding_read(ex_test_field(raw,"engine_id",text,changed[..]),read[..],arena[..]);}
 for key:[3]string.["task_id","input_sha256","account_id"] {#assert !ex_binding_read(ex_test_field(raw,key,"\"../secret\"",changed[..]),read[..],arena[..]);}
 o:[1]Jo;jo_start(o[..],changed[..]);jo_put(o[..],cast(string)raw[0..<raw.count-1]);jo_put(o[..],",\"token\":\"never\"}");#assert !ex_binding_read(jo_text(o[..]),read[..],arena[..]);
 jo_start(o[..],changed[..]);jo_put(o[..],cast(string)raw[0..<raw.count-1]);jo_put(o[..],",\"task_id\":\"0123456789abcdef0123456789abcdef\"}");#assert !ex_binding_read(jo_text(o[..]),read[..],arena[..]);
}
#test "binding byte lengths deadlines and report identity remain exact at their boundaries" {
 b:=ex_test_binding();#assert ex_binding_valid(b);
 b.input_bytes=EX_INPUT_MAX;#assert ex_binding_valid(b);b.input_bytes+=1;#assert !ex_binding_valid(b);b.input_bytes=0;#assert !ex_binding_valid(b);b.input_bytes=1;
 b.report_at=b.issued;#assert ex_binding_valid(b);b.report_at+=1;#assert !ex_binding_valid(b);b.report_at=0;#assert !ex_binding_valid(b);b.report_at=1;
 b.expires=b.issued+300000;#assert ex_binding_valid(b);b.expires+=1;#assert !ex_binding_valid(b);b.expires=b.issued;#assert !ex_binding_valid(b);
 b.issued=9007199254440991;b.expires=9007199254740991;#assert ex_binding_valid(b);b.issued+=1;b.expires+=1;#assert !ex_binding_valid(b);
}
#test "chunk byte offsets round trip UTF8 and all fields are required" {
 chunk:=ExChunk.{task=EX_TEST_ID,command=EX_TEST_ID,hash=EX_TEST_HASH,total=100,offset=7,text="café\n",issued=1000,expires=301000};
 b:[32768]u8;c:[32768]u8;arena:[8192]u8;read:[1]ExChunk;n:=ex_chunk_write(chunk,b[..]);raw:=cast(string)b[0..<n];
 #assert n>0 && ex_chunk_read(raw,read[..],arena[..]) && read[0].offset==7 && read[0].text.count==6 && read[0].text=="café\n";
 #assert ex_chunk_write(read[0],c[..])==n && cast(string)c[0..<n]==raw;
 for key:[9]string.["schema","task_id","command_id","input_sha256","input_bytes","offset","text","issued_at_ms","expires_at_ms"] {
  #assert !ex_chunk_read(ex_test_field(raw,key,"",c[..]),read[..],arena[..]);#assert !ex_chunk_read(ex_test_field(raw,key,"null",c[..]),read[..],arena[..]);
 }
 for offset:[5]string.["-1","1.0","1e0","100","9007199254740992"] {#assert !ex_chunk_read(ex_test_field(raw,"offset",offset,c[..]),read[..],arena[..]);}
 #assert !ex_chunk_read(raw,read[..],arena[0..<3]) && ex_chunk_write(chunk,c[0..<n-1])<0;
}
#test "worst-case escaped chunks leave space for HOST metadata without clipping" {
 bytes:[EX_CHUNK_MAX+1]u8;for i:0..<bytes.count {bytes[i]=1;}b:[32768]u8;arena:[8192]u8;read:[1]ExChunk;
 c:=ExChunk.{task=EX_TEST_ID,command=EX_TEST_ID,hash=EX_TEST_HASH,total=EX_INPUT_MAX,offset=EX_INPUT_MAX-EX_CHUNK_MAX,text=cast(string)bytes[0..<EX_CHUNK_MAX],issued=1,expires=300001};
 n:=ex_chunk_write(c,b[..]);#assert n>EX_CHUNK_MAX && n<32768 && ex_chunk_read(cast(string)b[0..<n],read[..],arena[..]) && read[0].text.count==EX_CHUNK_MAX;
 c.text=cast(string)bytes[..];#assert ex_chunk_write(c,b[..])<0;c.text="";#assert ex_chunk_write(c,b[..])<0;
 bytes[0]=0;c.text=cast(string)bytes[0..<1];#assert ex_chunk_write(c,b[..])<0;bytes[0]=255;c.text=cast(string)bytes[0..<1];#assert ex_chunk_write(c,b[..])<0;
}
#test "complete execution input preserves Project context history roles and current request" {
 v:[1]ExInput;read:[1]ExInput;ex_test_input(v[..]);b:[8192]u8;c:[8192]u8;n:=ex_input_write(v[..],b[..]);
 #assert n>0 && ex_input_read(cast(string)b[0..<n],read[..]) && read[0].n==3 && read[0].ni==9 && read[0].nr==16;
 #assert !read[0].assistant[0] && read[0].assistant[1] && !read[0].assistant[2] && ex_input_text(read[..],2)=="Run the checks.";
 #assert ex_input_write(read[..],c[..])==n && cast(string)c[0..<n]==cast(string)b[0..<n];
 #assert ex_input_write(v[..],c[0..<n-1])<0 && ex_input_text(read[..],-1)=="" && ex_input_text(read[..],3)=="";
}
#test "execution input refuses missing context fields unsupported roles and malformed strings" {
 v:[1]ExInput;read:[1]ExInput;ex_test_input(v[..]);b:[8192]u8;c:[8192]u8;n:=ex_input_write(v[..],b[..]);raw:=cast(string)b[0..<n];
 for key:[4]string.["schema","instructions","reference","messages"] {#assert !ex_input_read(ex_test_field(raw,key,"",c[..]),read[..]);#assert !ex_input_read(ex_test_field(raw,key,"null",c[..]),read[..]);}
 for messages:[7]string.["[]","{}","[{\"role\":\"tool\",\"text\":\"x\"}]","[{\"role\":\"system\",\"text\":\"x\"}]","[{\"role\":\"assistant\",\"text\":\"x\"}]","[{\"role\":\"user\",\"text\":\"\"}]","[{\"role\":\"user\",\"text\":\"x\",\"allow\":true}]"] {#assert !ex_input_read(ex_test_field(raw,"messages",messages,c[..]),read[..]);}
 #assert !ex_input_read(ex_test_field(raw,"instructions","\"\\u0000\"",c[..]),read[..]);
 bad:=[3]u8.['"',255,'"'];#assert !ex_input_read(ex_test_field(raw,"reference",cast(string)bad[..],c[..]),read[..]);
}
#test "execution context uses the existing complete 32KiB budget and bounded whole history" #steps 50000000 {
 v:[1]ExInput;read:[1]ExInput;v[0].n=2;v[0].assistant[0]=true;v[0].counts[0]=EX_HISTORY_MAX-1;v[0].starts[1]=EX_HISTORY_MAX-1;v[0].counts[1]=1;v[0].bytes=EX_HISTORY_MAX;
 for i:0..<EX_HISTORY_MAX {v[0].text[i]=1;}v[0].ni=32768;for i:0..<32768 {v[0].instructions[i]=1;}
 out:[EX_INPUT_MAX]u8;n:=ex_input_write(v[..],out[..]);#assert n>EX_HISTORY_MAX && n<EX_INPUT_MAX && ex_input_read(cast(string)out[0..<n],read[..]);
 #assert read[0].bytes==EX_HISTORY_MAX && read[0].ni==32768 && read[0].text[EX_HISTORY_MAX-1]==1;
 v[0].nr=1;v[0].reference[0]='x';#assert !ex_input_valid(v[..]);v[0].nr=0;
 v[0].counts[1]=2;v[0].bytes+=1;#assert !ex_input_valid(v[..]);v[0].counts[1]=1;v[0].bytes-=1;
 v[0].assistant[0]=false;#assert !ex_input_valid(v[..]);v[0].assistant[0]=true;v[0].assistant[1]=true;#assert !ex_input_valid(v[..]);
}
#test "all 128 messages survive the codec and a user message stops at its existing 16KiB bound" {
 v:[1]ExInput;read:[1]ExInput;v[0].n=EX_MESSAGES;v[0].bytes=EX_MESSAGES;
 for i:0..<EX_MESSAGES {v[0].starts[i]=i;v[0].counts[i]=1;v[0].text[i]='x';}
 out:[131072]u8;n:=ex_input_write(v[..],out[..]);#assert n>0 && ex_input_read(cast(string)out[0..<n],read[..]) && read[0].n==EX_MESSAGES && ex_input_text(read[..],EX_MESSAGES-1)=="x";
 v[0].n=EX_MESSAGES+1;#assert ex_input_write(v[..],out[..])<0;
 v[0]=ExInput.{};v[0].n=1;v[0].counts[0]=16384;v[0].bytes=16384;for i:0..<16385 {v[0].text[i]='x';}
 n=ex_input_write(v[..],out[..]);#assert n>0 && ex_input_read(cast(string)out[0..<n],read[..]) && read[0].bytes==16384;
 v[0].counts[0]+=1;v[0].bytes+=1;#assert ex_input_write(v[..],out[..])<0;
}
#test "binding choices include their exact field ceilings and empty effort survives decoding" {
 b:=ex_test_binding();text:[129]u8;for i:0..<text.count {text[i]='a';}out:[8192]u8;read:[1]ExBinding;arena:[1024]u8;
 b.workspace=cast(string)text[0..<64];#assert ex_binding_valid(b);b.workspace=cast(string)text[0..<65];#assert !ex_binding_valid(b);b.workspace="default";
 b.model=cast(string)text[0..<128];#assert ex_binding_valid(b);b.model=cast(string)text[..];#assert !ex_binding_valid(b);b.model="model";
 b.effort=cast(string)text[0..<16];#assert ex_binding_valid(b);b.effort=cast(string)text[0..<17];#assert !ex_binding_valid(b);b.effort="";
 n:=ex_binding_write(b,out[..]);#assert n>0 && ex_binding_read(cast(string)out[0..<n],read[..],arena[..]) && read[0].effort=="";
 b.task="bad";#assert ex_binding_write(b,out[..])<0;
}
#test "syntax errors do not publish output and chunk identities are validated before writing" {
 b:[1]ExBinding;c:[1]ExChunk;v:[1]ExInput;arena:[8192]u8;
 #assert !ex_binding_read("{",b[..],arena[..]) && !ex_chunk_read("{",c[..],arena[..]) && !ex_input_read("{",v[..]);
 c[0]=ExChunk.{task=EX_TEST_ID,command=EX_TEST_ID,hash=EX_TEST_HASH,total=1,text="x",issued=1,expires=300001};
 out:[32768]u8;#assert ex_chunk_valid(c[0]);
 c[0].task="bad";#assert !ex_chunk_valid(c[0]) && ex_chunk_write(c[0],out[..])<0;c[0].task=EX_TEST_ID;
 c[0].command="bad";#assert !ex_chunk_valid(c[0]);c[0].command=EX_TEST_ID;c[0].hash="bad";#assert !ex_chunk_valid(c[0]);
}
#test "input typed admission covers a one-byte request full reference and poisoned unused entries" {
 v:[1]ExInput;v[0].n=1;v[0].bytes=1;v[0].counts[0]=1;v[0].text[0]='x';#assert ex_input_valid(v[..]);
 v[0].starts[1]=0;v[0].counts[1]=1;#assert ex_input_text(v[..],1)=="";
 v[0].nr=32768;for i:0..<32768 {v[0].reference[i]='r';}#assert ex_input_valid(v[..]);
 v[0].nr=0;v[0].ni=1;v[0].instructions[0]=255;#assert !ex_input_valid(v[..]);v[0].ni=0;v[0].nr=1;v[0].reference[0]=255;#assert !ex_input_valid(v[..]);v[0].nr=0;
 v[0].text[1]='y';v[0].starts[0]=1;#assert !ex_input_valid(v[..]);v[0].starts[0]=0;v[0].counts[0]=0;#assert !ex_input_valid(v[..]);
 v[0].counts[0]=2;#assert !ex_input_valid(v[..]);
}
#test "typed input rejects an empty interior message and refuses a span before it crosses storage" {
 v:[1]ExInput;v[0].n=2;v[0].bytes=1;v[0].assistant[0]=true;v[0].starts[1]=0;v[0].counts[1]=1;v[0].text[0]='x';
 #assert !ex_input_valid(v[..]);
 v[0].bytes=EX_HISTORY_MAX;v[0].counts[0]=EX_HISTORY_MAX-1;v[0].starts[1]=EX_HISTORY_MAX-1;v[0].counts[1]=2;
 for i:0..<EX_HISTORY_MAX {v[0].text[i]='x';}#assert !ex_input_valid(v[..]);
}
#test "input message collections are arrays with at most 128 complete objects" {
 v:[1]ExInput;read:[1]ExInput;ex_test_input(v[..]);raw:[8192]u8;changed:[131072]u8;n:=ex_input_write(v[..],raw[..]);text:=cast(string)raw[0..<n];
 #assert !ex_input_read(ex_test_field(text,"messages","{\"a\":{\"role\":\"user\",\"text\":\"x\"}}",changed[..]),read[..]);
 array:[16384]u8;o:[1]Jo;jo_start(o[..],array[..]);jo_arr(o[..]);for i:0..<129 {jo_obj(o[..]);jo_key(o[..],"role");jo_str(o[..],"user");jo_key(o[..],"text");jo_str(o[..],"x");jo_end(o[..]);}jo_end(o[..]);
 #assert !ex_input_read(ex_test_field(text,"messages",jo_text(o[..]),changed[..]),read[..]);
 #assert ex_input_read(ex_test_field(text,"messages","[{\"role\":\"user\",\"text\":\"x\"}]",changed[..]),read[..]) && read[0].n==1;
}
#test "binding chunk and input readers enforce exact encoded-size boundaries" #steps 50000000 {
 raw:[EX_INPUT_MAX+1]u8;small:[8192]u8;arena:[8192]u8;b:[1]ExBinding;c:[1]ExChunk;v:[1]ExInput;
 n:=ex_binding_write(ex_test_binding(),small[..]);for i:0..<n {raw[i]=small[i];}for i:n..<8194 {raw[i]=' ';}
 #assert ex_binding_read(cast(string)raw[0..<8192],b[..],arena[..]) && !ex_binding_read(cast(string)raw[0..<8193],b[..],arena[..]);
 chunk:=ExChunk.{task=EX_TEST_ID,command=EX_TEST_ID,hash=EX_TEST_HASH,total=1,text="x",issued=1,expires=300001};n=ex_chunk_write(chunk,small[..]);
 for i:0..<n {raw[i]=small[i];}for i:n..<32770 {raw[i]=' ';}
 #assert ex_chunk_read(cast(string)raw[0..<32768],c[..],arena[..]) && !ex_chunk_read(cast(string)raw[0..<32769],c[..],arena[..]);
 ex_test_input(v[..]);n=ex_input_write(v[..],small[..]);for i:0..<n {raw[i]=small[i];}for i:n..<raw.count {raw[i]=' ';}
 #assert ex_input_read(cast(string)raw[0..<EX_INPUT_MAX],v[..]) && !ex_input_read(cast(string)raw[..],v[..]);
}
#test "every closed execution object refuses decoded-key aliases including nested message fields" {
 raw:[16384]u8;changed:[16384]u8;arena:[8192]u8;b:[1]ExBinding;c:[1]ExChunk;v:[1]ExInput;
 n:=ex_binding_write(ex_test_binding(),raw[..]);text:=cast(string)raw[0..<n];
 for key:[19]string.["schema","task_id","conversation_id","turn_id","route_id","host_pubkey","workspace_id","session_id","command_id","engine_id","account_id","model_id","effort_id","input_sha256","input_bytes","report_sha256","report_observed_at_ms","issued_at_ms","expires_at_ms"] {#assert !ex_binding_read(ex_test_alias(text,key,changed[..]),b[..],arena[..]);}
 chunk:=ExChunk.{task=EX_TEST_ID,command=EX_TEST_ID,hash=EX_TEST_HASH,total=1,text="x",issued=1,expires=300001};n=ex_chunk_write(chunk,raw[..]);text=cast(string)raw[0..<n];
 for key:[9]string.["schema","task_id","command_id","input_sha256","input_bytes","offset","text","issued_at_ms","expires_at_ms"] {#assert !ex_chunk_read(ex_test_alias(text,key,changed[..]),c[..],arena[..]);}
 ex_test_input(v[..]);n=ex_input_write(v[..],raw[..]);text=cast(string)raw[0..<n];
 for key:[4]string.["schema","instructions","reference","messages"] {#assert !ex_input_read(ex_test_alias(text,key,changed[..]),v[..]);}
 for rows:[2]string.["[{\"\\u0072ole\":\"user\",\"text\":\"x\"}]","[{\"role\":\"user\",\"\\u0074ext\":\"x\"}]"] {#assert !ex_input_read(ex_test_field(text,"messages",rows,changed[..]),v[..]);}
}
