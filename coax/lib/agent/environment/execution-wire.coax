// One codec for routed execution bindings, complete inputs and input chunks.
// The caller retains the arena behind Binding/Chunk strings. Input owns its text.
#load "execution-policy.coax";
#load "wire.coax"; // shared model/effort identifier classification
#load "../../json/shape.coax";
#load "../../project/context-budget.coax";
EX_BINDING_SCHEMA :: "openagents.environment.execution.binding.v1alpha1";
EX_INPUT_SCHEMA :: "openagents.environment.execution.input.v1alpha1";
EX_CHUNK_SCHEMA :: "openagents.environment.execution.chunk.v1alpha1";
ExArena :: struct {buf:[]u8;n:int;bad:bool;}
ex_string :: (v:Jv,at:int,key:string,a:[]ExArena)->string #effects(all) {
 if a[0].bad {return "";}n:=js_string(v,jv_get(v,at,key),a[0].buf[a[0].n..<a[0].buf.count]);
 if n<0 {a[0].bad=true;return "";}start:=a[0].n;a[0].n+=n;return cast(string)a[0].buf[start..<start+n];
}
ex_text_valid :: (text:string,maximum:int)->bool #effects(all) {
 if text.count>maximum || !js_utf8(text) {return false;}for c:text {if c==0 {return false;}}return true;
}
ex_encoded :: (o:[]Jo)->int #effects(all) {return ifx o[0].bad then -1 else o[0].n;}
ex_binding_valid :: (b:ExBinding)->bool #effects(all) {
 return ea_id(b.task,32) && ex_reference(b.conversation,"cnv_") && ex_reference(b.turn,"trn_") && ea_id(b.route,32) &&
  ea_id(b.host,64) && b.workspace.count<=64 && ea_choice(b.workspace) && ea_id(b.session,32) && ea_id(b.command,32) &&
  (b.engine=="claude" || b.engine=="codex") && pa_profile(b.account) && b.model.count<=128 && ea_choice(b.model) &&
  b.effort.count<=16 && (b.effort.count==0 || ea_choice(b.effort)) && ea_id(b.input_hash,64) && b.input_bytes>0 && b.input_bytes<=EX_INPUT_MAX &&
  ea_id(b.report_hash,64) && b.report_at>0 && b.report_at<=b.issued && ea_fresh(b.issued,b.expires,b.issued);
}
ex_binding_read :: (raw:string,out:[]ExBinding,arena:[]u8)->bool #export_c #effects(all) {
 d:[1]Jv;nodes:[64]JvNode;if raw.count>8192 || !jv_parse(d[..],raw,nodes[..]) {return false;}v:=d[0];
 keys:=[19]string.["schema","task_id","conversation_id","turn_id","route_id","host_pubkey","workspace_id","session_id","command_id","engine_id","account_id","model_id","effort_id","input_sha256","input_bytes","report_sha256","report_observed_at_ms","issued_at_ms","expires_at_ms"];
 if !js_fields(v,0,keys[..]) || jv_len(v,0)!=keys.count || jv_raw(v,jv_get(v,0,"schema"))!=EX_BINDING_SCHEMA {return false;}
 a:=[1]ExArena.[ExArena.{buf=arena}];b:ExBinding;
 b.task=ex_string(v,0,"task_id",a[..]);b.conversation=ex_string(v,0,"conversation_id",a[..]);b.turn=ex_string(v,0,"turn_id",a[..]);b.route=ex_string(v,0,"route_id",a[..]);
 b.host=ex_string(v,0,"host_pubkey",a[..]);b.workspace=ex_string(v,0,"workspace_id",a[..]);b.session=ex_string(v,0,"session_id",a[..]);b.command=ex_string(v,0,"command_id",a[..]);
 b.engine=ex_string(v,0,"engine_id",a[..]);b.account=ex_string(v,0,"account_id",a[..]);b.model=ex_string(v,0,"model_id",a[..]);b.effort=ex_string(v,0,"effort_id",a[..]);
 b.input_hash=ex_string(v,0,"input_sha256",a[..]);b.report_hash=ex_string(v,0,"report_sha256",a[..]);
 b.input_bytes=js_number(v,jv_get(v,0,"input_bytes"));b.report_at=js_number(v,jv_get(v,0,"report_observed_at_ms"));b.issued=js_number(v,jv_get(v,0,"issued_at_ms"));b.expires=js_number(v,jv_get(v,0,"expires_at_ms"));
 if a[0].bad || !ex_binding_valid(b) {return false;}out[0]=b;return true;
}
ex_binding_write :: (b:ExBinding,out:[]u8)->int #export_c #effects(all) {
 if !ex_binding_valid(b) {return -1;}o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],EX_BINDING_SCHEMA);
 jo_key(o[..],"task_id");jo_str(o[..],b.task);jo_key(o[..],"conversation_id");jo_str(o[..],b.conversation);jo_key(o[..],"turn_id");jo_str(o[..],b.turn);jo_key(o[..],"route_id");jo_str(o[..],b.route);
 jo_key(o[..],"host_pubkey");jo_str(o[..],b.host);jo_key(o[..],"workspace_id");jo_str(o[..],b.workspace);jo_key(o[..],"session_id");jo_str(o[..],b.session);jo_key(o[..],"command_id");jo_str(o[..],b.command);
 jo_key(o[..],"engine_id");jo_str(o[..],b.engine);jo_key(o[..],"account_id");jo_str(o[..],b.account);jo_key(o[..],"model_id");jo_str(o[..],b.model);jo_key(o[..],"effort_id");jo_str(o[..],b.effort);
 jo_key(o[..],"input_sha256");jo_str(o[..],b.input_hash);jo_key(o[..],"input_bytes");jo_int(o[..],b.input_bytes);jo_key(o[..],"report_sha256");jo_str(o[..],b.report_hash);
 jo_key(o[..],"report_observed_at_ms");jo_int(o[..],b.report_at);jo_key(o[..],"issued_at_ms");jo_int(o[..],b.issued);jo_key(o[..],"expires_at_ms");jo_int(o[..],b.expires);jo_end(o[..]);return ex_encoded(o[..]);
}
ex_chunk_valid :: (c:ExChunk)->bool #effects(all) {
 return ea_id(c.task,32) && ea_id(c.command,32) && ea_id(c.hash,64) && ex_text_valid(c.text,EX_CHUNK_MAX) &&
  ex_chunk_action(c.offset,c.text.count,c.total,c.offset,false)==1 && ea_fresh(c.issued,c.expires,c.issued);
}
ex_chunk_read :: (raw:string,out:[]ExChunk,arena:[]u8)->bool #export_c #effects(all) {
 d:[1]Jv;nodes:[32]JvNode;if raw.count>32768 || !jv_parse(d[..],raw,nodes[..]) {return false;}v:=d[0];
 keys:=[9]string.["schema","task_id","command_id","input_sha256","input_bytes","offset","text","issued_at_ms","expires_at_ms"];
 if !js_fields(v,0,keys[..]) || jv_len(v,0)!=keys.count || jv_raw(v,jv_get(v,0,"schema"))!=EX_CHUNK_SCHEMA {return false;}
 a:=[1]ExArena.[ExArena.{buf=arena}];c:ExChunk;c.task=ex_string(v,0,"task_id",a[..]);c.command=ex_string(v,0,"command_id",a[..]);c.hash=ex_string(v,0,"input_sha256",a[..]);c.text=ex_string(v,0,"text",a[..]);
 c.total=js_number(v,jv_get(v,0,"input_bytes"));c.offset=js_number(v,jv_get(v,0,"offset"));c.issued=js_number(v,jv_get(v,0,"issued_at_ms"));c.expires=js_number(v,jv_get(v,0,"expires_at_ms"));
 if a[0].bad || !ex_chunk_valid(c) {return false;}out[0]=c;return true;
}
ex_chunk_write :: (c:ExChunk,out:[]u8)->int #export_c #effects(all) {
 if !ex_chunk_valid(c) {return -1;}o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],EX_CHUNK_SCHEMA);
 jo_key(o[..],"task_id");jo_str(o[..],c.task);jo_key(o[..],"command_id");jo_str(o[..],c.command);jo_key(o[..],"input_sha256");jo_str(o[..],c.hash);jo_key(o[..],"input_bytes");jo_int(o[..],c.total);
 jo_key(o[..],"offset");jo_int(o[..],c.offset);jo_key(o[..],"text");jo_str(o[..],c.text);jo_key(o[..],"issued_at_ms");jo_int(o[..],c.issued);jo_key(o[..],"expires_at_ms");jo_int(o[..],c.expires);jo_end(o[..]);return ex_encoded(o[..]);
}
ex_input_text :: (v:[]ExInput,i:int)->string #effects(all) {if i<0 || i>=v[0].n {return "";}return cast(string)v[0].text[v[0].starts[i]..<v[0].starts[i]+v[0].counts[i]];}
ex_input_valid :: (v:[]ExInput)->bool #effects(all) {
 if v[0].ni<0 || v[0].nr<0 || v[0].ni>32768 || v[0].nr>32768 || !pcb_context(v[0].ni+v[0].nr) || v[0].n<1 || v[0].n>EX_MESSAGES || v[0].bytes<1 || v[0].bytes>EX_HISTORY_MAX {return false;}
 if !ex_text_valid(cast(string)v[0].instructions[0..<v[0].ni],32768) || !ex_text_valid(cast(string)v[0].reference[0..<v[0].nr],32768) || v[0].assistant[v[0].n-1] {return false;}
 at:=0;for i:0..<v[0].n {size:=v[0].counts[i];if v[0].starts[i]!=at || size<1 || size>v[0].bytes-at {return false;}
  if !ex_text_valid(ex_input_text(v,i),ifx v[0].assistant[i] then EX_HISTORY_MAX else 16384) {return false;}at+=size;
 }return at==v[0].bytes;
}
ex_input_read :: (raw:string,out:[]ExInput)->bool #export_c #effects(all) {
 d:[1]Jv;nodes:[512]JvNode;if raw.count>EX_INPUT_MAX || !jv_parse(d[..],raw,nodes[..]) {return false;}v:=d[0];keys:=[4]string.["schema","instructions","reference","messages"];
 if !js_fields(v,0,keys[..]) || jv_len(v,0)!=keys.count || jv_raw(v,jv_get(v,0,"schema"))!=EX_INPUT_SCHEMA {return false;}
 next:[1]ExInput;next[0].ni=js_string(v,jv_get(v,0,"instructions"),next[0].instructions[..]);next[0].nr=js_string(v,jv_get(v,0,"reference"),next[0].reference[..]);
 list:=jv_get(v,0,"messages");count:=jv_len(v,list);if jv_kind(v,list)!=JV_ARRAY || count<1 || count>EX_MESSAGES {return false;}
 fields:=[2]string.["role","text"];
 for i:0..<count {row:=jv_at(v,list,i);if !js_fields(v,row,fields[..]) || jv_len(v,row)!=fields.count {return false;}role:=jv_raw(v,jv_get(v,row,"role"));if role!="user" && role!="assistant" {return false;}
  size:=js_string(v,jv_get(v,row,"text"),next[0].text[next[0].bytes..<next[0].text.count]);if size<1 {return false;}
  next[0].assistant[i]=role=="assistant";next[0].starts[i]=next[0].bytes;next[0].counts[i]=size;next[0].bytes+=size;
 }next[0].n=count;if !ex_input_valid(next[..]) {return false;}out[0]=next[0];return true;
}
ex_input_write :: (v:[]ExInput,out:[]u8)->int #export_c #effects(all) {
 if !ex_input_valid(v) {return -1;}o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],EX_INPUT_SCHEMA);
 jo_key(o[..],"instructions");jo_str(o[..],cast(string)v[0].instructions[0..<v[0].ni]);jo_key(o[..],"reference");jo_str(o[..],cast(string)v[0].reference[0..<v[0].nr]);jo_key(o[..],"messages");jo_arr(o[..]);
 for i:0..<v[0].n {jo_obj(o[..]);jo_key(o[..],"role");jo_str(o[..],ifx v[0].assistant[i] then "assistant" else "user");jo_key(o[..],"text");jo_str(o[..],ex_input_text(v,i));jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);n:=ex_encoded(o[..]);return ifx n>EX_INPUT_MAX then -1 else n;
}

#load "execution-checks.coax" #test;
