// Which agent answers a chat that a paired phone or macOS companion starts on this computer, and
// what the client is offered to pick from (#14073, #14060: Unified OpenAgents Core Switch).
// The rule: when OpenAgents Core (`oa-worker`) is available, every top-level primary chat routes
// through OpenAgents Core (`oa:auto`, `oa:cloud` / `oa:gemini-4-neon`, and optional $0 `oa:local`
// / `oa:inkling-2-mini` turns inside cloud chats). Legacy model IDs (`gemini-4-neon`, `inkling-2-mini`,
// `flawed:gemini-4-neon`) seamlessly map onto OpenAgents Core. External local harnesses
// (`PA_AGY` / Antigravity, `PA_CLAUDE` / Claude Code) are NEVER selected as top-level primary chat
// engines while OpenAgents Core is available, and external harness sub-agent delegation is strictly
// gated on explicit user opt-in (`allow_local_harnesses`).
//
// When a legacy host does not have `oa-worker` installed (`!f.core`), the policy preserves the
// fallback order: Antigravity (`PA_AGY`), Inkling (`PA_INKLING`), Microcoder (`PA_MICRO`), Claude (`PA_CLAUDE`).
//
//   coax/bin/coax test coax/lib/agent/environment/phone-agent-policy.coax --library
//   coax/bin/coax mutate coax/lib/agent/environment/phone-agent-policy.coax --library --root-only
#authority;

PA_NONE :: -1; PA_CLAUDE :: 0; PA_MICRO :: 1; PA_AGY :: 2; PA_INKLING :: 3; PA_CORE :: 4;
PA_ORDER :: [5] int.[PA_CORE, PA_AGY, PA_INKLING, PA_MICRO, PA_CLAUDE];

// Unified OpenAgents Core (`oa-worker`) models: cloud-first Auto, explicit Cloud, and $0 local Inkling.
PA_CORE_ID :: "openagents";
PA_CORE_DEFAULT :: "oa:auto";
PA_CORE_CLOUD :: "oa:cloud";
PA_CORE_NEON :: "oa:gemini-4-neon";
PA_CORE_LOCAL :: "oa:local";
PA_CORE_INKLING :: "oa:inkling-2-mini";
PA_CORE_EFFORT :: "high";
PA_CORE_MODELS :: 3;
PA_CORE_MODEL_ID :: [PA_CORE_MODELS] string.["oa:auto", "oa:gemini-4-neon", "oa:inkling-2-mini"];
PA_CORE_MODEL_LABEL :: [PA_CORE_MODELS] string.["OpenAgents Auto", "OpenAgents Cloud · Gemini 4 Neon", "OpenAgents Local · Inkling 2 Mini"];

// Primary Neon + Antigravity models (legacy fallback when oa-worker is absent) and local Inkling 2 Mini.
PA_NEON_MODELS :: 5;
PA_NEON_ID :: [PA_NEON_MODELS] string.["gemini-4-neon", "gemini-4-carbon", "gemini-4-hydrogen", "gemini-4-argon", "gemini-3.8-flash"];
PA_NEON_LABEL :: [PA_NEON_MODELS] string.["Gemini 4 Neon", "Gemini 4 Carbon", "Gemini 4 Hydrogen", "Gemini 4 Argon", "Gemini 3.8 Flash"];
PA_AGY_ID :: "antigravity";
PA_AGY_DEFAULT :: "gemini-4-neon";
PA_AGY_LABEL :: "Antigravity";
PA_AGY_EFFORT :: "high";

PA_INKLING_ID :: "inkling-2-mini";
PA_INKLING_LABEL :: "Inkling 2 Mini";
PA_INKLING_EFFORT :: "medium";

// Legacy Microcoder models (fallback when oa-worker and agy are unavailable and mcworker is installed).
PA_MICRO_MODELS :: 4;
PA_MICRO_ID :: [PA_MICRO_MODELS] string.["gemini-4-neon", "gemini-4-carbon", "gemini-4-hydrogen", "gemini-4-argon"];
PA_MICRO_LABEL :: [PA_MICRO_MODELS] string.["Gemini 4 Neon", "Gemini 4 Carbon", "Gemini 4 Hydrogen", "Gemini 4 Argon"];
PA_MICRO_EFFORT :: "low";

// Thinking / effort levels offered for OpenAgents Core, Antigravity, and Inkling (#14005).
PA_EFFORTS :: 7;
PA_EFFORT_ID :: [PA_EFFORTS] string.["none", "minimal", "low", "medium", "high", "xhigh", "max"];
PA_EFFORT_LABEL :: [PA_EFFORTS] string.["Off", "Minimal", "Low", "Medium", "High", "X-High", "Max"];

// What this computer can run now.
PaFacts :: struct {
  claude: bool;
  gemini: bool;
  agy: bool;
  inkling: bool;
  core: bool;
  core_local: bool;
  allow_local_harnesses: bool;
}
// A chat's agent: the engine, its model, the engine the phone asked for (PA_NONE: no preference)
// and whether it is not that one.
PaPick :: struct { engine: int; model: string; fell_back: bool; asked: int; }
// What the chat's own transcript says when it fell back: the engine asked for, then what runs.
PA_ENGINE_NAME :: [5] string.["Claude Code", "Microcoder on Gemini", "Antigravity", "Inkling 2 Mini", "OpenAgents Core"];

pa_usable :: (f: PaFacts, engine: int) -> bool #effects(all) {
  if engine == PA_CORE { return f.core; }
  if engine == PA_CLAUDE { return f.claude; }
  if engine == PA_MICRO { return f.gemini; }
  if engine == PA_AGY { return f.agy; }
  if engine == PA_INKLING { return f.inkling; }
  return false;
}
pa_micro_model :: (id: string) -> bool #effects(all) {
  for m: PA_MICRO_ID { if id == m { return true; } }
  return false;
}
pa_inkling_model :: (id: string) -> bool #effects(all) {
  return id == PA_INKLING_ID || id == "inkling";
}
pa_core_local_model :: (id: string) -> bool #effects(all) {
  return id == PA_CORE_LOCAL || id == PA_CORE_INKLING;
}
pa_core_model :: (id: string) -> bool #effects(all) {
  return id == PA_CORE_ID || id == PA_CORE_DEFAULT || id == PA_CORE_CLOUD || id == PA_CORE_NEON
      || id == "flawed:gemini-4-neon" || pa_core_local_model(id)
      || (id.count > 10 && cast(string) id[0..<10] == "oa:gemini-");
}
pa_agy_model :: (id: string) -> bool #effects(all) {
  return id == PA_AGY_ID || (id.count > 7 && cast(string) id[0..<7] == "gemini-");
}
pa_engine_of :: (id: string) -> int #effects(all) {
  if pa_core_model(id) { return PA_CORE; }
  if pa_inkling_model(id) { return PA_INKLING; }
  if pa_agy_model(id) { return PA_AGY; }
  if id == "default" || (id.count > 7 && cast(string) id[0..<7] == "claude-") { return PA_CLAUDE; }
  return PA_NONE;
}
// Canonical OpenAgents Core model ID for `want` (preserves explicit cloud/local/gemini variants).
pa_core_canonical_model :: (want: string, core_local: bool) -> string #effects(all) {
  if pa_core_local_model(want) || pa_inkling_model(want) {
    return ifx core_local then PA_CORE_INKLING else PA_CORE_DEFAULT;
  }
  if want == PA_CORE_CLOUD || want == PA_CORE_NEON || want == "flawed:gemini-4-neon" || want == PA_AGY_DEFAULT {
    return PA_CORE_NEON;
  }
  if want.count > 10 && cast(string) want[0..<10] == "oa:gemini-" { return want; }
  if want.count > 7 && cast(string) want[0..<7] == "gemini-" { return want; }
  return PA_CORE_DEFAULT;
}
// Map a canonical PA_CORE model ID to the wire model ID sent in McTask to `oa-worker`.
pa_core_task_model :: (model: string) -> string #effects(all) {
  if pa_core_local_model(model) || pa_inkling_model(model) { return PA_CORE_LOCAL; }
  if model == PA_CORE_NEON || model == PA_CORE_CLOUD || model == "flawed:gemini-4-neon" { return PA_CORE_CLOUD; }
  if model.count > 10 && cast(string) model[0..<10] == "oa:gemini-" { return cast(string) model[3..<model.count]; }
  if model.count > 7 && cast(string) model[0..<7] == "gemini-" { return model; }
  return PA_CORE_DEFAULT;
}
// Opt-in external local harness sub-agent delegation gate (#14073):
// OpenAgents Core is always permitted when available; external harnesses (`PA_AGY`, `PA_CLAUDE`)
// are permitted ONLY as delegated sub-agents when `allow_local_harnesses` is explicitly enabled.
pa_subagent_harness_allowed :: (f: PaFacts, harness: int) -> bool #effects(all) {
  if harness == PA_CORE { return f.core; }
  if harness == PA_AGY || harness == PA_CLAUDE {
    return f.allow_local_harnesses && pa_usable(f, harness);
  }
  return false;
}
pa_pick :: (f: PaFacts, want: string) -> PaPick #effects(all) {
  asked := pa_engine_of(want);
  // Converged OpenAgents Core path (#14073): primary chat is ALWAYS PA_CORE when oa-worker is ready.
  // Legacy Gemini & Inkling IDs map seamlessly onto PA_CORE; external harnesses never take primary chat.
  if f.core {
    if pa_core_local_model(want) || pa_inkling_model(want) {
      if f.core_local {
        return PaPick.{engine = PA_CORE, model = PA_CORE_INKLING, fell_back = false, asked = PA_CORE};
      }
      return PaPick.{engine = PA_CORE, model = PA_CORE_DEFAULT, fell_back = true, asked = PA_INKLING};
    }
    if pa_core_model(want) || (want.count > 7 && cast(string) want[0..<7] == "gemini-") {
      return PaPick.{engine = PA_CORE, model = pa_core_canonical_model(want, f.core_local), fell_back = false, asked = PA_CORE};
    }
    if want == PA_AGY_ID || asked == PA_CLAUDE {
      return PaPick.{engine = PA_CORE, model = PA_CORE_DEFAULT, fell_back = true, asked = asked};
    }
    return PaPick.{engine = PA_CORE, model = PA_CORE_DEFAULT, fell_back = false, asked = PA_NONE};
  }
  engine := PA_NONE;
  if asked != PA_NONE && pa_usable(f, asked) { engine = asked; }
  else { for e: PA_ORDER { if pa_usable(f, e) { engine = e; break; } } }
  ids := PA_MICRO_ID;
  model := "";
  if engine == PA_AGY { model = ifx asked == PA_AGY && want != PA_AGY_ID then want else PA_AGY_DEFAULT; }
  if engine == PA_INKLING { model = PA_INKLING_ID; }
  if engine == PA_MICRO { model = ifx pa_micro_model(want) then want else ids[0]; }
  if engine == PA_CLAUDE { model = ifx asked == PA_CLAUDE then want else "default"; }
  return PaPick.{engine = engine, model = model, fell_back = asked != PA_NONE && engine != PA_NONE && engine != asked, asked = asked};
}
// The effort level a turn runs at for `engine` and `model` ("" for none).
pa_effort :: (engine: int, model: string, want: string) -> string #effects(all) {
  if engine == PA_CORE {
    if pa_core_local_model(model) {
      if want == "low" || want == "medium" || want == "high" { return want; }
      if want == "xhigh" || want == "max" { return "high"; }
      return PA_INKLING_EFFORT;
    }
    if model == "gemini-3.8-flash" || model == "oa:gemini-3.8-flash" {
      if want == "xhigh" || want == "max" { return "high"; }
    }
    if want == "none" || want == "minimal" || want == "low" || want == "medium" || want == "high" || want == "xhigh" || want == "max" { return want; }
    return PA_CORE_EFFORT;
  }
  if engine == PA_AGY {
    if model == "gemini-pro-orchestrator" { return ""; }
    if model == "gemini-3.8-flash" {
      if want == "xhigh" || want == "max" { return "high"; }
    }
    if want == "none" || want == "minimal" || want == "low" || want == "medium" || want == "high" || want == "xhigh" || want == "max" { return want; }
    return PA_AGY_EFFORT;
  }
  if engine == PA_INKLING {
    if want == "low" || want == "medium" || want == "high" { return want; }
    if want == "xhigh" { return "high"; }
    return PA_INKLING_EFFORT;
  }
  if engine == PA_MICRO { return PA_MICRO_EFFORT; }
  if engine == PA_CLAUDE { return want; }
  return "";
}
// What a person calls the agent a pick runs: its model's name for OpenAgents Core, Neon/Antigravity,
// Inkling, or Microcoder, else the engine's.
pa_label :: (p: PaPick) -> string #effects(all) {
  if p.engine == PA_CORE {
    for i: 0..<PA_CORE_MODELS { if PA_CORE_MODEL_ID[i] == p.model { return PA_CORE_MODEL_LABEL[i]; } }
    return PA_ENGINE_NAME[PA_CORE];
  }
  if p.engine == PA_AGY {
    for i: 0..<PA_NEON_MODELS { if PA_NEON_ID[i] == p.model { return PA_NEON_LABEL[i]; } }
    return PA_AGY_LABEL;
  }
  if p.engine == PA_INKLING { return PA_INKLING_LABEL; }
  if p.engine == PA_MICRO {
    for i: 0..<PA_MICRO_MODELS { if PA_MICRO_ID[i] == p.model { return PA_MICRO_LABEL[i]; } }
    return PA_ENGINE_NAME[PA_MICRO];
  }
  if p.engine == PA_CLAUDE { return PA_ENGINE_NAME[PA_CLAUDE]; }
  return "";
}
// The line a chat that fell back shows once, in plain words, into out; "" when it did not fall back.
pa_note :: (p: PaPick, out: [] u8) -> string #effects(all) {
  if !p.fell_back || p.asked < 0 || p.asked >= 5 { return ""; }
  parts := [4] string.[PA_ENGINE_NAME[p.asked], " isn't set up on this computer, so this chat runs on ", pa_label(p), "."];
  n := 0;
  for t: parts { for c: t { if n >= out.count { return ""; } out[n] = c; n += 1; } }
  return cast(string) out[0..<n];
}
// The engines the phone is offered, in order, into out: how many.
// When OpenAgents Core (`f.core`) is ready, ONLY PA_CORE is offered as the top-level primary chat engine (#14073).
pa_offer :: (f: PaFacts, out: [] int) -> int #effects(all) {
  if f.core {
    if out.count == 0 { return 0; }
    out[0] = PA_CORE;
    return 1;
  }
  n := 0;
  for e: PA_ORDER { if n < out.count && pa_usable(f, e) { out[n] = e; n += 1; } }
  return n;
}
// Dynamic ACP / OpenAgents Core model catalog validation (#14005, #14073): accepts OpenAgents Core IDs
// (`oa:auto`, `oa:cloud`, `oa:local`, `oa:gemini-4-neon`, `oa:inkling-2-mini`, `flawed:gemini-4-neon`)
// and safe ACP model slugs while excluding bare legacy local sentinels ("inkling", "default") and flags.
pa_agy_catalog_slug_ok :: (id: string) -> bool #effects(all) {
  if id.count < 1 || id.count > 128 { return false; }
  if pa_inkling_model(id) || id == "default" || id == "gemini-" || id == "claude-" || id == "oa:gemini-" { return false; }
  if id[0] == '-' || id[id.count - 1] == '-' { return false; }
  for c: id {
    ok := (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '-' && c <= ':') || c == '_';
    if !ok { return false; }
  }
  return true;
}
pa_mobile_agy_allowed :: (id: string) -> bool #effects(all) {
  return pa_agy_catalog_slug_ok(id);
}
pa_mobile_agy_model :: (want: string) -> string #effects(all) {
  if pa_core_model(want) { return pa_core_canonical_model(want, true); }
  if pa_agy_catalog_slug_ok(want) && want != PA_AGY_ID { return want; }
  return PA_AGY_DEFAULT;
}
pa_mobile_core_allowed :: (id: string) -> bool #effects(all) {
  return pa_agy_catalog_slug_ok(id);
}
pa_mobile_core_model :: (want: string) -> string #effects(all) {
  if pa_core_model(want) { return pa_core_canonical_model(want, true); }
  if pa_agy_catalog_slug_ok(want) && want != PA_AGY_ID { return want; }
  return PA_CORE_DEFAULT;
}

// ---- checks

#test "a model id names its engine, and an unknown one names none" {
  #assert pa_engine_of("oa:auto") == PA_CORE && pa_engine_of("oa:cloud") == PA_CORE && pa_engine_of("oa:gemini-4-neon") == PA_CORE;
  #assert pa_engine_of("oa:local") == PA_CORE && pa_engine_of("oa:inkling-2-mini") == PA_CORE && pa_engine_of("openagents") == PA_CORE;
  #assert pa_engine_of("flawed:gemini-4-neon") == PA_CORE && pa_engine_of("oa:gemini-x") == PA_CORE && pa_engine_of("oa:gemini-4-carbon") == PA_CORE && pa_engine_of("oa:gemini-") == PA_NONE;
  #assert pa_engine_of("gemini-4-neon") == PA_AGY && pa_engine_of("gemini-4-argon") == PA_AGY && pa_engine_of("gemini-3.8-flash") == PA_AGY;
  #assert pa_engine_of("antigravity") == PA_AGY && pa_engine_of("gemini-pro-orchestrator") == PA_AGY && pa_engine_of("gemini-x") == PA_AGY;
  #assert pa_engine_of("inkling-2-mini") == PA_INKLING && pa_engine_of("inkling") == PA_INKLING;
  #assert pa_engine_of("default") == PA_CLAUDE && pa_engine_of("claude-opus-5-5") == PA_CLAUDE && pa_engine_of("claude-") == PA_NONE && pa_engine_of("claude-x") == PA_CLAUDE;
  #assert pa_engine_of("") == PA_NONE && pa_engine_of("gemini-") == PA_NONE && pa_engine_of("gpt-5") == PA_NONE && pa_engine_of("Claude-opus") == PA_NONE;
  #assert pa_micro_model("gemini-4-neon") && pa_micro_model("gemini-4-argon") && !pa_micro_model("gemini-9") && !pa_micro_model("inkling-2-mini");
}
#test "an engine is usable only when what it needs is here" {
  none := PaFacts.{}; all := PaFacts.{claude = true, gemini = true, agy = true, inkling = true, core = true};
  for e: [5] int.[PA_CLAUDE, PA_MICRO, PA_AGY, PA_INKLING, PA_CORE] { #assert !pa_usable(none, e) && pa_usable(all, e); }
  #assert pa_usable(PaFacts.{core = true}, PA_CORE) && !pa_usable(PaFacts.{core = true}, PA_AGY) && !pa_usable(PaFacts.{core = true}, PA_CLAUDE);
  #assert pa_usable(PaFacts.{claude = true}, PA_CLAUDE) && !pa_usable(PaFacts.{claude = true}, PA_MICRO) && !pa_usable(PaFacts.{claude = true}, PA_AGY) && !pa_usable(PaFacts.{claude = true}, PA_INKLING);
  #assert pa_usable(PaFacts.{gemini = true}, PA_MICRO) && !pa_usable(PaFacts.{gemini = true}, PA_CLAUDE) && !pa_usable(PaFacts.{gemini = true}, PA_INKLING);
  #assert pa_usable(PaFacts.{agy = true}, PA_AGY) && !pa_usable(PaFacts.{agy = true}, PA_MICRO) && !pa_usable(PaFacts.{agy = true}, PA_INKLING);
  #assert pa_usable(PaFacts.{inkling = true}, PA_INKLING) && !pa_usable(PaFacts.{inkling = true}, PA_AGY) && !pa_usable(PaFacts.{inkling = true}, PA_MICRO);
  #assert !pa_usable(all, PA_NONE) && !pa_usable(all, 5);
}
#test "OpenAgents Core is primary chat engine, maps legacy IDs, and gates external harnesses behind opt-in (#14073)" {
  core_all := PaFacts.{core = true, core_local = true, agy = true, inkling = true, claude = true, gemini = true};
  // Default / oa:auto / openagents -> PA_CORE oa:auto
  p := pa_pick(core_all, ""); #assert p.engine == PA_CORE && p.model == "oa:auto" && !p.fell_back && p.asked == PA_NONE;
  p = pa_pick(core_all, "oa:auto"); #assert p.engine == PA_CORE && p.model == "oa:auto" && !p.fell_back && p.asked == PA_CORE;
  p = pa_pick(core_all, "openagents"); #assert p.engine == PA_CORE && p.model == "oa:auto" && !p.fell_back;
  // Cloud explicit + legacy Gemini & flawed:gemini-4-neon map seamlessly to PA_CORE
  p = pa_pick(core_all, "oa:cloud"); #assert p.engine == PA_CORE && p.model == "oa:gemini-4-neon" && !p.fell_back;
  p = pa_pick(core_all, "oa:gemini-4-neon"); #assert p.engine == PA_CORE && p.model == "oa:gemini-4-neon" && !p.fell_back;
  p = pa_pick(core_all, "flawed:gemini-4-neon"); #assert p.engine == PA_CORE && p.model == "oa:gemini-4-neon" && !p.fell_back;
  p = pa_pick(core_all, "gemini-4-neon"); #assert p.engine == PA_CORE && p.model == "oa:gemini-4-neon" && !p.fell_back;
  p = pa_pick(core_all, "gemini-x"); #assert p.engine == PA_CORE && p.model == "gemini-x" && !p.fell_back && p.asked == PA_CORE;
  p = pa_pick(core_all, "gemini-"); #assert p.engine == PA_CORE && p.model == "oa:auto" && !p.fell_back && p.asked == PA_NONE;
  p = pa_pick(core_all, "oa:gemini-x"); #assert p.engine == PA_CORE && p.model == "oa:gemini-x" && !p.fell_back && p.asked == PA_CORE;
  #assert pa_core_canonical_model("oa:gemini-", true) == "oa:auto" && pa_core_canonical_model("gemini-", true) == "oa:auto";
  // Optional $0 local Inkling turns inside cloud chats (and fallback to oa:auto when local weights absent)
  p = pa_pick(core_all, "oa:local"); #assert p.engine == PA_CORE && p.model == "oa:inkling-2-mini" && !p.fell_back && p.asked == PA_CORE;
  p = pa_pick(core_all, "oa:inkling-2-mini"); #assert p.engine == PA_CORE && p.model == "oa:inkling-2-mini" && !p.fell_back;
  p = pa_pick(core_all, "inkling-2-mini"); #assert p.engine == PA_CORE && p.model == "oa:inkling-2-mini" && !p.fell_back;
  p = pa_pick(core_all, "inkling"); #assert p.engine == PA_CORE && p.model == "oa:inkling-2-mini" && !p.fell_back;
  core_cloud_only := PaFacts.{core = true, core_local = false, agy = true, claude = true};
  p = pa_pick(core_cloud_only, "oa:local"); #assert p.engine == PA_CORE && p.model == "oa:auto" && p.fell_back && p.asked == PA_INKLING;
  p = pa_pick(core_cloud_only, "inkling-2-mini"); #assert p.engine == PA_CORE && p.model == "oa:auto" && p.fell_back && p.asked == PA_INKLING;
  #assert pa_core_canonical_model("oa:local", false) == "oa:auto" && pa_core_canonical_model("oa:local", true) == "oa:inkling-2-mini";
  // External harnesses NEVER take primary top-level chat when OpenAgents Core is ready
  p = pa_pick(core_all, "antigravity"); #assert p.engine == PA_CORE && p.model == "oa:auto" && p.fell_back && p.asked == PA_AGY;
  p = pa_pick(core_all, "claude-opus-5-5"); #assert p.engine == PA_CORE && p.model == "oa:auto" && p.fell_back && p.asked == PA_CLAUDE;
  p = pa_pick(core_all, "default"); #assert p.engine == PA_CORE && p.model == "oa:auto" && p.fell_back && p.asked == PA_CLAUDE;
  // External harnesses are strictly opt-in delegated sub-agents only (allow_local_harnesses)
  #assert pa_subagent_harness_allowed(core_all, PA_CORE);
  #assert !pa_subagent_harness_allowed(core_all, PA_AGY) && !pa_subagent_harness_allowed(core_all, PA_CLAUDE) && !pa_subagent_harness_allowed(core_all, PA_MICRO);
  opt_in := PaFacts.{core = true, agy = true, claude = true, allow_local_harnesses = true};
  #assert pa_subagent_harness_allowed(opt_in, PA_AGY) && pa_subagent_harness_allowed(opt_in, PA_CLAUDE) && !pa_subagent_harness_allowed(opt_in, PA_INKLING);
  opt_in_missing := PaFacts.{core = true, agy = false, claude = false, allow_local_harnesses = true};
  #assert !pa_subagent_harness_allowed(opt_in_missing, PA_AGY) && !pa_subagent_harness_allowed(opt_in_missing, PA_CLAUDE);
  // Task model wire mapping for oa-worker
  #assert pa_core_task_model("oa:auto") == "oa:auto" && pa_core_task_model("oa:gemini-4-neon") == "oa:cloud" && pa_core_task_model("oa:cloud") == "oa:cloud";
  #assert pa_core_task_model("flawed:gemini-4-neon") == "oa:cloud" && pa_core_task_model("oa:local") == "oa:local" && pa_core_task_model("oa:inkling-2-mini") == "oa:local";
  #assert pa_core_task_model("inkling-2-mini") == "oa:local" && pa_core_task_model("oa:gemini-x") == "gemini-x" && pa_core_task_model("gemini-x") == "gemini-x";
  #assert pa_core_task_model("oa:gemini-") == "oa:auto" && pa_core_task_model("gemini-") == "oa:auto";
  // Top-level offer exposes ONLY PA_CORE when OpenAgents Core is ready
  o: [5] int;
  #assert pa_offer(core_all, o[..]) == 1 && o[0] == PA_CORE;
  #assert pa_offer(core_all, o[0..<0]) == 0;
  // Labels and fallback notes for PA_CORE
  #assert pa_label(PaPick.{engine = PA_CORE, model = "oa:auto"}) == "OpenAgents Auto";
  #assert pa_label(PaPick.{engine = PA_CORE, model = "oa:gemini-4-neon"}) == "OpenAgents Cloud · Gemini 4 Neon";
  #assert pa_label(PaPick.{engine = PA_CORE, model = "oa:inkling-2-mini"}) == "OpenAgents Local · Inkling 2 Mini";
  #assert pa_label(PaPick.{engine = PA_CORE, model = "gemini-4-carbon"}) == "OpenAgents Core";
  nb: [160] u8;
  #assert pa_note(pa_pick(PaFacts.{agy = true}, "oa:auto"), nb[..]) == "OpenAgents Core isn't set up on this computer, so this chat runs on Gemini 4 Neon.";
  #assert pa_note(pa_pick(core_all, "claude-opus-5-5"), nb[..]) == "Claude Code isn't set up on this computer, so this chat runs on OpenAgents Auto.";
}
#test "the legacy Neon + Inkling Mac runs Gemini 4 Neon on Antigravity and Inkling 2 Mini locally when oa-worker is absent" {
  mac := PaFacts.{agy = true, inkling = true};
  p := pa_pick(mac, "default");
  #assert p.engine == PA_AGY && p.model == "gemini-4-neon" && p.fell_back;
  p = pa_pick(mac, "claude-opus-5-5"); #assert p.engine == PA_AGY && p.model == "gemini-4-neon" && p.fell_back;
  // explicit Neon, Antigravity models, and Inkling choices never fall back
  p = pa_pick(mac, "gemini-4-neon"); #assert p.engine == PA_AGY && p.model == "gemini-4-neon" && !p.fell_back;
  p = pa_pick(mac, "gemini-4-carbon"); #assert p.engine == PA_AGY && p.model == "gemini-4-carbon" && !p.fell_back;
  p = pa_pick(mac, "antigravity"); #assert p.engine == PA_AGY && p.model == "gemini-4-neon" && !p.fell_back;
  p = pa_pick(mac, "inkling-2-mini"); #assert p.engine == PA_INKLING && p.model == "inkling-2-mini" && !p.fell_back;
  p = pa_pick(mac, "inkling"); #assert p.engine == PA_INKLING && p.model == "inkling-2-mini" && !p.fell_back;
  // no preference: Gemini 4 Neon via Antigravity, not a fallback
  p = pa_pick(mac, ""); #assert p.engine == PA_AGY && p.model == "gemini-4-neon" && !p.fell_back;
  p = pa_pick(mac, "gpt-5"); #assert p.engine == PA_AGY && p.model == "gemini-4-neon" && !p.fell_back;
  // Inkling-only Mac: defaults cleanly to Inkling 2 Mini
  local_only := PaFacts.{inkling = true};
  p = pa_pick(local_only, ""); #assert p.engine == PA_INKLING && p.model == "inkling-2-mini" && !p.fell_back;
  p = pa_pick(local_only, "gemini-4-neon"); #assert p.engine == PA_INKLING && p.model == "inkling-2-mini" && p.fell_back && p.asked == PA_AGY;
}
#test "a missing engine is never picked, whatever was asked" {
  for c: 0..<2 { for g: 0..<2 { for a: 0..<2 { for k: 0..<2 {
    f := PaFacts.{claude = c == 1, gemini = g == 1, agy = a == 1, inkling = k == 1};
    for want: [11] string.["", "default", "claude-opus-5-5", "gemini-4-neon", "gemini-4-hydrogen", "antigravity", "inkling-2-mini", "oa:auto", "gpt-5", "gemini-", "claude-"] {
      p := pa_pick(f, want);
      #assert (p.engine == PA_NONE) == (!f.claude && !f.gemini && !f.agy && !f.inkling);
      if p.engine != PA_NONE { #assert pa_usable(f, p.engine); }
      w := pa_engine_of(want);
      if w != PA_NONE && pa_usable(f, w) { #assert p.engine == w && !p.fell_back; }
      if w != PA_NONE && !pa_usable(f, w) { #assert p.fell_back == (p.engine != PA_NONE); }
      if w == PA_NONE { #assert !p.fell_back; }
      if p.engine == PA_MICRO { #assert pa_micro_model(p.model); }
      if p.engine == PA_AGY { #assert pa_engine_of(p.model) == PA_AGY; }
      if p.engine == PA_INKLING { #assert p.model == PA_INKLING_ID; }
      if p.engine == PA_CLAUDE { #assert pa_engine_of(p.model) == PA_CLAUDE; }
    }
  } } } }
}
#test "a chat that fell back says so once, in plain words: what was asked for and what runs" {
  b: [160] u8; mac := PaFacts.{agy = true, inkling = true};
  #assert pa_note(pa_pick(mac, "default"), b[..]) == "Claude Code isn't set up on this computer, so this chat runs on Gemini 4 Neon.";
  #assert pa_note(pa_pick(PaFacts.{inkling = true}, "gemini-4-neon"), b[..]) == "Antigravity isn't set up on this computer, so this chat runs on Inkling 2 Mini.";
  #assert pa_note(pa_pick(PaFacts.{agy = true}, "inkling-2-mini"), b[..]) == "Inkling 2 Mini isn't set up on this computer, so this chat runs on Gemini 4 Neon.";
  #assert pa_note(pa_pick(PaFacts.{claude = true}, "antigravity"), b[..]) == "Antigravity isn't set up on this computer, so this chat runs on Claude Code.";
  #assert pa_note(pa_pick(PaFacts.{gemini = true}, "gemini-4-argon"), b[..]) == "Antigravity isn't set up on this computer, so this chat runs on Gemini 4 Argon.";
  // no fallback, no note: what was asked runs, or nothing was asked
  #assert pa_note(pa_pick(mac, "gemini-4-carbon"), b[..]) == "" && pa_note(pa_pick(mac, "inkling-2-mini"), b[..]) == "" && pa_note(pa_pick(mac, ""), b[..]) == "" && pa_note(pa_pick(PaFacts.{}, "default"), b[..]) == "";
  #assert pa_note(PaPick.{engine = PA_AGY, model = "gemini-4-neon", fell_back = true, asked = 5}, b[..]) == "" && pa_note(PaPick.{engine = PA_AGY, model = "gemini-4-neon", fell_back = true, asked = PA_NONE}, b[..]) == "";
  small: [20] u8; #assert pa_note(pa_pick(mac, "default"), small[..]) == "";
  exact: [78] u8; #assert pa_note(pa_pick(mac, "default"), exact[..]).count == 78 && pa_note(pa_pick(mac, "default"), exact[0..<77]) == "";
  #assert pa_pick(mac, "default").asked == PA_CLAUDE && pa_pick(mac, "").asked == PA_NONE && pa_pick(mac, "antigravity").asked == PA_AGY && pa_pick(mac, "inkling-2-mini").asked == PA_INKLING;
  // the name of what runs
  #assert pa_label(pa_pick(mac, "gemini-4-hydrogen")) == "Gemini 4 Hydrogen" && pa_label(pa_pick(mac, "gemini-4-argon")) == "Gemini 4 Argon" && pa_label(pa_pick(mac, "gemini-3.8-flash")) == "Gemini 3.8 Flash";
  #assert pa_label(pa_pick(mac, "inkling-2-mini")) == "Inkling 2 Mini" && pa_label(PaPick.{engine = PA_AGY, model = "gemini-9"}) == "Antigravity";
  #assert pa_label(pa_pick(PaFacts.{gemini = true}, "")) == "Gemini 4 Neon" && pa_pick(PaFacts.{gemini = true}, "").model == "gemini-4-neon";
  #assert pa_label(pa_pick(PaFacts.{claude = true}, "")) == "Claude Code" && pa_label(PaPick.{engine = PA_MICRO, model = "gemini-9"}) == "Microcoder on Gemini" && pa_label(PaPick.{engine = PA_NONE}) == "";
}
#test "the fallback order is OpenAgents Core, then Antigravity, then Inkling 2 Mini, then Microcoder, then Claude Code" {
  #assert pa_pick(PaFacts.{core = true, claude = true, gemini = true, agy = true, inkling = true}, "").engine == PA_CORE;
  #assert pa_pick(PaFacts.{claude = true, gemini = true, agy = true, inkling = true}, "").engine == PA_AGY;
  #assert pa_pick(PaFacts.{claude = true, gemini = true, inkling = true}, "").engine == PA_INKLING;
  #assert pa_pick(PaFacts.{claude = true, gemini = true}, "").engine == PA_MICRO;
  #assert pa_pick(PaFacts.{claude = true}, "gemini-4-neon").engine == PA_CLAUDE && pa_pick(PaFacts.{claude = true}, "gemini-4-neon").model == "default";
  #assert pa_pick(PaFacts.{agy = true}, "default").engine == PA_AGY && pa_pick(PaFacts.{agy = true}, "default").fell_back;
  #assert pa_pick(PaFacts.{}, "default").engine == PA_NONE && !pa_pick(PaFacts.{}, "default").fell_back;
  // Claude Code here and asked for on legacy host without oa-worker: its own model
  p := pa_pick(PaFacts.{claude = true, agy = true, inkling = true}, "claude-opus-5-5"); #assert p.engine == PA_CLAUDE && p.model == "claude-opus-5-5" && !p.fell_back;
}
#test "the offer lists only the engines this computer runs, the working default first" {
  o: [5] int;
  #assert pa_offer(PaFacts.{agy = true, inkling = true}, o[..]) == 2 && o[0] == PA_AGY && o[1] == PA_INKLING;
  #assert pa_offer(PaFacts.{claude = true, gemini = true, agy = true, inkling = true}, o[..]) == 4 && o[0] == PA_AGY && o[1] == PA_INKLING && o[2] == PA_MICRO && o[3] == PA_CLAUDE;
  #assert pa_offer(PaFacts.{claude = true}, o[..]) == 1 && o[0] == PA_CLAUDE;
  #assert pa_offer(PaFacts.{inkling = true}, o[..]) == 1 && o[0] == PA_INKLING;
  #assert pa_offer(PaFacts.{}, o[..]) == 0;
  small: [1] int; #assert pa_offer(PaFacts.{claude = true, gemini = true, agy = true, inkling = true}, small[..]) == 1 && small[0] == PA_AGY;
  for c: 0..<2 { for g: 0..<2 { for a: 0..<2 { for k: 0..<2 {
    f := PaFacts.{claude = c == 1, gemini = g == 1, agy = a == 1, inkling = k == 1};
    n := pa_offer(f, o[..]);
    if n > 0 { #assert o[0] == pa_pick(f, "").engine; for i: 0..<n { #assert pa_usable(f, o[i]); } }
  } } } }
}
#test "effort resolution clamps to each engine's supported levels and defaults cleanly" {
  #assert pa_effort(PA_CORE, "oa:auto", "") == "high" && pa_effort(PA_CORE, "oa:auto", "xhigh") == "xhigh" && pa_effort(PA_CORE, "oa:auto", "low") == "low" && pa_effort(PA_CORE, "oa:auto", "medium") == "medium" && pa_effort(PA_CORE, "oa:auto", "high") == "high" && pa_effort(PA_CORE, "oa:auto", "max") == "max" && pa_effort(PA_CORE, "oa:auto", "minimal") == "minimal" && pa_effort(PA_CORE, "oa:auto", "none") == "none" && pa_effort(PA_CORE, "oa:auto", "bogus") == "high";
  #assert pa_effort(PA_CORE, "gemini-3.8-flash", "xhigh") == "high" && pa_effort(PA_CORE, "oa:gemini-3.8-flash", "max") == "high";
  #assert pa_effort(PA_CORE, "oa:inkling-2-mini", "") == "medium" && pa_effort(PA_CORE, "oa:inkling-2-mini", "low") == "low" && pa_effort(PA_CORE, "oa:inkling-2-mini", "medium") == "medium" && pa_effort(PA_CORE, "oa:inkling-2-mini", "high") == "high" && pa_effort(PA_CORE, "oa:local", "xhigh") == "high" && pa_effort(PA_CORE, "oa:local", "max") == "high" && pa_effort(PA_CORE, "oa:local", "bogus") == "medium";
  #assert pa_effort(PA_AGY, "gemini-4-neon", "") == "high" && pa_effort(PA_AGY, "gemini-4-neon", "xhigh") == "xhigh" && pa_effort(PA_AGY, "gemini-4-neon", "low") == "low" && pa_effort(PA_AGY, "gemini-4-neon", "high") == "high" && pa_effort(PA_AGY, "gemini-4-neon", "medium") == "medium" && pa_effort(PA_AGY, "gemini-4-neon", "max") == "max" && pa_effort(PA_AGY, "gemini-4-neon", "minimal") == "minimal" && pa_effort(PA_AGY, "gemini-4-neon", "none") == "none" && pa_effort(PA_AGY, "gemini-4-neon", "bogus") == "high";
  #assert pa_effort(PA_AGY, "gemini-3.8-flash", "xhigh") == "high" && pa_effort(PA_AGY, "gemini-3.8-flash", "max") == "high" && pa_effort(PA_AGY, "gemini-3.8-flash", "high") == "high";
  #assert pa_effort(PA_AGY, "gemini-pro-orchestrator", "high") == "";
  #assert pa_effort(PA_INKLING, "inkling-2-mini", "") == "medium" && pa_effort(PA_INKLING, "inkling-2-mini", "low") == "low" && pa_effort(PA_INKLING, "inkling-2-mini", "medium") == "medium" && pa_effort(PA_INKLING, "inkling-2-mini", "high") == "high" && pa_effort(PA_INKLING, "inkling-2-mini", "xhigh") == "high" && pa_effort(PA_INKLING, "inkling-2-mini", "bogus") == "medium";
  #assert pa_effort(PA_MICRO, "gemini-4-neon", "high") == "low" && pa_effort(PA_CLAUDE, "default", "high") == "high" && pa_effort(PA_NONE, "", "high") == "";
}
#test "mobile client supports OpenAgents Core & dynamic ACP model slugs and rejects bare local sentinels or malformed ids" {
  #assert pa_mobile_core_allowed("oa:auto") && pa_mobile_core_allowed("oa:cloud") && pa_mobile_core_allowed("oa:local") && pa_mobile_core_allowed("oa:gemini-4-neon") && pa_mobile_core_allowed("oa:inkling-2-mini") && pa_mobile_core_allowed("flawed:gemini-4-neon") && pa_mobile_core_allowed("openagents");
  #assert pa_mobile_core_model("oa:auto") == "oa:auto" && pa_mobile_core_model("oa:cloud") == "oa:gemini-4-neon" && pa_mobile_core_model("oa:local") == "oa:inkling-2-mini" && pa_mobile_core_model("flawed:gemini-4-neon") == "oa:gemini-4-neon" && pa_mobile_core_model("gemini-4-carbon") == "gemini-4-carbon" && pa_mobile_core_model("antigravity") == "oa:auto" && pa_mobile_core_model("") == "oa:auto";
  #assert pa_mobile_agy_allowed("oa:auto") && pa_mobile_agy_allowed("oa:gemini-4-neon") && pa_mobile_agy_allowed("oa:inkling-2-mini") && pa_mobile_agy_allowed("gemini-4-neon") && pa_mobile_agy_allowed("gemini-4-carbon") && pa_mobile_agy_allowed("gemini-3.8-flash") && pa_mobile_agy_allowed("antigravity");
  #assert pa_mobile_agy_allowed("gemini-pro-orchestrator") && pa_mobile_agy_allowed("gemini-5-pro") && pa_mobile_agy_allowed("claude-opus-5-5") && pa_mobile_agy_allowed("gpt-oss-120b") && pa_mobile_agy_allowed("vertex/gemini_5:latest");
  #assert !pa_mobile_agy_allowed("inkling-2-mini") && !pa_mobile_agy_allowed("inkling") && !pa_mobile_agy_allowed("default") && !pa_mobile_agy_allowed("") && !pa_mobile_agy_allowed("gemini-") && !pa_mobile_agy_allowed("claude-") && !pa_mobile_agy_allowed("oa:gemini-") && !pa_mobile_agy_allowed("--danger") && !pa_mobile_agy_allowed("bad-");
  #assert pa_mobile_agy_model("oa:cloud") == "oa:gemini-4-neon" && pa_mobile_agy_model("oa:local") == "oa:inkling-2-mini" && pa_mobile_agy_model("gemini-4-carbon") == "gemini-4-carbon" && pa_mobile_agy_model("gemini-3.8-flash") == "gemini-3.8-flash" && pa_mobile_agy_model("claude-opus-5-5") == "claude-opus-5-5" && pa_mobile_agy_model("gemini-pro-orchestrator") == "gemini-pro-orchestrator";
  #assert pa_mobile_agy_model("antigravity") == PA_AGY_DEFAULT && pa_mobile_agy_model("inkling-2-mini") == PA_AGY_DEFAULT && pa_mobile_agy_model("default") == PA_AGY_DEFAULT && pa_mobile_agy_model("") == PA_AGY_DEFAULT;
  id128: [129] u8; for i: 0..<129 { id128[i] = 'a'; }
  #assert pa_mobile_agy_allowed("a") && pa_mobile_agy_allowed("z") && pa_mobile_agy_allowed("A") && pa_mobile_agy_allowed("Z") && pa_mobile_agy_allowed("0") && pa_mobile_agy_allowed("9");
  #assert !pa_mobile_agy_allowed("-a") && !pa_mobile_agy_allowed("{") && !pa_mobile_agy_allowed("@") && !pa_mobile_agy_allowed("[") && !pa_mobile_agy_allowed(";") && !pa_mobile_agy_allowed(",");
  #assert pa_mobile_agy_allowed(cast(string) id128[0..<128]) && !pa_mobile_agy_allowed(cast(string) id128[..]);
  #assert !pa_mobile_agy_allowed("a b");
}
