// Operator fixture: the existing read-only RuntimeRequest codec, never a
// hand-written JSON body. Used to verify a resident computer after an update.
#load "wire.coax";
#load "../../sys/tool.coax";
#load "../../sys/fs.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=3 {tool_errln("read-request METHOD SESSION OUTPUT");return 2;}
 out:[24576]u8;n:=ea_read_body(args_at(a[..],0),args_at(a[..],1),"",out[..]);
 if n<1 || !fs_write(args_at(a[..],2),cast(string)out[0..<n]) {return 1;}return 0;
}
