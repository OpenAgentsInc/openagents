// One codec for the explicit shared-user bootstrap profile. Every client uses
// these typed bounded records. HOST envelope/signature verification is separate.
#load "policy.coax";
#load "../../json/json.coax";

EA_SCHEMA :: "openagents.environment.runtime.v1alpha1";
EA_CONFIG :: "openagents.environment.configuration.v1alpha1";
EA_CATALOG :: "openagents.environment.catalog.v1alpha1";
EaCatalogEntry :: struct {host:[64]u8;label:[80]u8;nl:int;}
EaCatalog :: struct {ok:bool;entries:[64]EaCatalogEntry;n:int;}
ea_catalog_write :: (c:[]EaCatalog,out:[]u8)->int #export_c #effects(all) {
  if c[0].n<0 || c[0].n>64 {return -1;}
  o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],EA_CATALOG);jo_key(o[..],"environments");jo_arr(o[..]);
  for i:0..<c[0].n {row:=c[0].entries[i];if !ea_id(cast(string)row.host[..],64) || row.nl<1 || row.nl>80 {return -1;}
    jo_obj(o[..]);jo_key(o[..],"host_pubkey");jo_str(o[..],cast(string)row.host[..]);jo_key(o[..],"display_name");jo_str(o[..],cast(string)row.label[0..<row.nl]);jo_end(o[..]);}
  jo_end(o[..]);jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;
}
ea_catalog_read :: (raw:string,c:[]EaCatalog)->bool #effects(all) {
  c[0]=EaCatalog.{};nodes:[512]JvNode;d:[1]Jv;if !jv_parse(d[..],raw,nodes[..]) {return false;}j:=d[0];list:=jv_get(j,0,"environments");
  if jv_raw(j,jv_get(j,0,"schema"))!=EA_CATALOG || jv_kind(j,list)!=JV_ARRAY || jv_len(j,list)>64 {return false;}
  c[0].n=jv_len(j,list);for i:0..<c[0].n {row:=jv_at(j,list,i);n:=jv_str(j,jv_get(j,row,"host_pubkey"),c[0].entries[i].host[..]);c[0].entries[i].nl=jv_str(j,jv_get(j,row,"display_name"),c[0].entries[i].label[..]);
    if n!=64 || !ea_id(cast(string)c[0].entries[i].host[..],64) || c[0].entries[i].nl<1 {return false;}}
  c[0].ok=true;return true;
}
EaConfiguration :: struct {device:[64]u8;grant:[64]u8;workspace:[1024]u8;nw:int;label:[80]u8;nl:int;enabled:bool;history:[1024]u8;nh:int;}
ea_config_write :: (c:[]EaConfiguration,out:[]u8)->int #effects(all) {
  o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],EA_CONFIG);
  jo_key(o[..],"device");jo_str(o[..],cast(string)c[0].device[..]);jo_key(o[..],"grant");jo_str(o[..],cast(string)c[0].grant[..]);jo_key(o[..],"workspace");jo_str(o[..],cast(string)c[0].workspace[0..<c[0].nw]);
  jo_key(o[..],"display_name");jo_str(o[..],cast(string)c[0].label[0..<c[0].nl]);jo_key(o[..],"enabled");jo_bool(o[..],c[0].enabled);jo_key(o[..],"history_root");jo_str(o[..],cast(string)c[0].history[0..<c[0].nh]);jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;
}
ea_config_read :: (raw:string,c:[]EaConfiguration)->bool #effects(all) {
  c[0]=EaConfiguration.{};nodes:[32]JvNode;d:[1]Jv;if !jv_parse(d[..],raw,nodes[..]) {return false;}j:=d[0];
  fields:=[7]string.["schema","device","grant","workspace","display_name","enabled","history_root"];seen:[7]bool;
  if jv_kind(j,0)!=JV_OBJECT || jv_len(j,0)!=7 {return false;}
  for i:0..<7 {key:=jv_key(j,jv_at(j,0,i));found:=false;for f,k:fields {if f==key {if seen[k] {return false;}seen[k]=true;found=true;}}if !found {return false;}}
  if jv_raw(j,jv_get(j,0,"schema"))!=EA_CONFIG || ea_field(j,"device",c[0].device[..])!=64 || ea_field(j,"grant",c[0].grant[..])!=64 {return false;}
  c[0].nh=ea_field(j,"history_root",c[0].history[..]);if c[0].nh<1 {return false;}c[0].nw=ea_field(j,"workspace",c[0].workspace[..]);c[0].nl=ea_field(j,"display_name",c[0].label[..]);
  if c[0].nw<1 || c[0].nl<1 || !ea_id(cast(string)c[0].device[..],64) || !ea_id(cast(string)c[0].grant[..],64) {return false;}
  k:=jv_kind(j,jv_get(j,0,"enabled"));if k!=JV_TRUE && k!=JV_FALSE {return false;}c[0].enabled=k==JV_TRUE;return true;
}
// A turn's model and effort are optional: a request without them keeps the
// conversation's (a new one starts on the computer's default), and peers
// without this field still read every request that leaves them out.
EaRequest :: struct {
  method:[32]u8;nm:int;workspace:[64]u8;nw:int;session:[128]u8;ns:int;
  command:[32]u8;nc:int;generation:int;revision:int;text:[16384]u8;nt:int;
  interaction:[128]u8;ni:int;allow:bool;before:int;expires:int;issued:int;
  model:[64]u8;nmo:int;effort:[16]u8;nef:int;
  folder:[EA_FOLDER]u8;nf:int;
  item:[128]u8;nit:int;
}
// ReadSubagent (GitHub #13713): one sub-agent's own transcript, the agent a ReadSession item
// started ("item_id", required there and refused anywhere else). Its view's items are the
// agent's calls (role "tool") and words ("assistant"), newest page first; "next_cursor" names
// the earlier rows, and "complete" says the agent has finished. An older computer refuses it.
// StopSubagent (GitHub #13776): a write that stops that one sub-agent of a Coder Desktop chat's
// running turn, as Coder Desktop's own one-agent Stop does; its siblings and the turn go on. It
// names the same item_id, required there too. An older computer refuses the method.
// A Coder session's working folder, relative to the workspace the grant binds: OpenSession may
// name one of the folders the computer offers ("folder"; GitHub #13713). Optional both ways: an
// older computer offers none and an older phone names none. A folder is plain relative segments,
// none empty, hidden, "." or "..", so it can never leave the bound workspace by its spelling;
// the computer checks the real path too.
EA_FOLDER :: 256;EA_FOLDERS :: 24;
EaFolder :: struct {path:[EA_FOLDER]u8;np:int;}
ea_folder_ok :: (p:string)->bool #effects(all) {
  if p.count<1 || p.count>EA_FOLDER {return false;}
  start:=0;i:=0;
  while i<=p.count {
    if i==p.count || p[i]=='/' {if i==start || p[start]=='.' {return false;}start=i+1;}
    else if p[i]<32 || p[i]==127 || p[i]=='\\' {return false;}
    i+=1;
  }
  return true;
}
// desktop: a Coder Desktop chat whose worker the computer's daemon runs (GitHub #13713), optional
// on the wire as "surface":"coder-desktop". Its running turn takes more input: SendMessage while it
// is busy steers the turn, and one while it is idle starts a follow-up. An older reader skips the
// member and still reads and stops it; an older computer sends none.
EA_SURFACE_DESKTOP :: "coder-desktop";
EaSession :: struct {id:[128]u8;ni:int;workspace:[64]u8;nw:int;title:[256]u8;nt:int;managed:bool;control:[32]u8;nc:int;generation:int;revision:int;busy:bool;interaction:[128]u8;nr:int;updated:int;model:[64]u8;nmo:int;effort:[16]u8;nef:int;desktop:bool;}
// What the computer's Claude offers a turn: its models and effort levels.
// Bit k of a model's ladder is level k; a model with no ladder takes no effort.
// The default model's id is "default" (the CLI's own choice, no --model).
EA_MODELS :: 12;EA_LEVELS :: 8;
EaModel :: struct {id:[64]u8;ni:int;label:[48]u8;nl:int;ladder:int;}
EaLevel :: struct {id:[16]u8;ni:int;label:[24]u8;nl:int;}
EaOffer :: struct {models:[EA_MODELS]EaModel;n:int;levels:[EA_LEVELS]EaLevel;nv:int;default_level:int;}
EA_ITEMS :: 64;
// A turn's thinking. v1alpha1 readers know four item roles (user, assistant, tool, notice) and draw
// any other as a reply, so a thought never travels in "items": it goes in "thoughts", each at the
// v1alpha1 item it comes before, and a reader that knows it puts it back in place (GitHub #13713).
EA_ROLE_THOUGHT :: "thought";
// started: a call still running, when it began on the computer, wall ms (0: not running, or not
// known). `complete` says the text is whole, not that the call is done. Optional on the wire
// ("started_at_ms"): an older computer sends none and an older reader skips it.
// calls, now: a sub-agent's call, the calls its agent has made and the newest ("Bash ls -la");
// optional on the wire ("subagent_calls", "subagent_now"), absent for any other item.
// path, diff: an edit's or a write's file and what it changed, "-" and "+" lines (in the view's text
// arena at diff_at, at most EA_DIFF bytes; diff_cut: it was longer). Optional on the wire ("path",
// "diff", "diff_cut"), absent for any other item and from an older computer.
EA_DIFF :: 4000;
EaItem :: struct {id:[128]u8;ni:int;role:[16]u8;nr:int;text_at:int;nt:int;tool:[128]u8;nk:int;complete:bool;started:int;calls:int;now:[160]u8;nn:int;path:[512]u8;np:int;diff_at:int;ndiff:int;diff_cut:bool;}
// An edit's change as "-" lines (before) then "+" lines (after), whole lines only, into out: its
// length. cut[0] says some lines did not fit.
ea_diff_make :: (out:[]u8,before:string,after:string,cut:[]bool)->int #effects(all) {
  n:=0;cut[0]=false;
  for side:0..<2 {
    t:=ifx side==0 then before else after;mark:=ifx side==0 then cast(u8)'-' else cast(u8)'+';start:=0;i:=0;
    while start<t.count {
      i=start;while i<t.count && t[i]!='\n' {i+=1;}
      if n+(i-start)+2>out.count {cut[0]=true;return n;}
      out[n]=mark;n+=1;for k:start..<i {out[n]=t[k];n+=1;}out[n]='\n';n+=1;start=i+1;
    }
  }
  return n;
}
ea_item_diff :: (v:[]EaView,i:int)->string #effects(all) {
  if i<0 || i>=v[0].ni || v[0].items[i].ndiff<1 {return "";}m:=v[0].items[i];return cast(string)v[0].text[m.diff_at..<m.diff_at+m.ndiff];
}
EaView :: struct {folders:[EA_FOLDERS]EaFolder;nfolders:int;root:[EA_FOLDER]u8;nroot:int;ok:bool;host:[64]u8;nh:int;label:[80]u8;nl:int;method:[32]u8;nm:int;sessions:[128]EaSession;ns:int;items:[EA_ITEMS]EaItem;ni:int;text:[49152]u8;text_n:int;error:[64]u8;ne:int;complete:bool;cursor:[128]u8;nc:int;command:[32]u8;nq:int;status:[32]u8;nt:int;epoch:[128]u8;np:int;offer:EaOffer;}
ea_text_put :: (v:[]EaView,text:string)->int #effects(all) {
  if text.count>16384 || v[0].text_n+text.count>v[0].text.count {return -1;}
  at:=v[0].text_n;for c,i:text {v[0].text[at+i]=c;}v[0].text_n+=text.count;return at;
}
ea_item_text :: (v:[]EaView,i:int)->string #effects(all) {
  if i<0 || i>=v[0].ni {return "";}m:=v[0].items[i];
  return cast(string)v[0].text[m.text_at..<m.text_at+m.nt];
}
ea_copy :: (out:[]u8,s:string)->int #effects(all) {if s.count>out.count {return -1;}for c,i:s {out[i]=c;}return s.count;}
ea_field :: (d:Jv,key:string,out:[]u8)->int #effects(all) {return jv_str(d,jv_get(d,0,key),out);}
// A model or effort id: lowercase letters, digits, '.' and '-'.
ea_choice :: (id:string)->bool #effects(all) {
  if id.count==0 {return false;}
  for c:id {if !((c>='a' && c<='z') || (c>='0' && c<='9') || c=='.' || c=='-') {return false;}}return true;
}
// An optional choice field of object `at`: 0 when absent, -1 when present but not an id.
ea_optional :: (d:Jv,at:int,key:string,out:[]u8)->int #effects(all) {
  k:=jv_get(d,at,key);if k<0 {return 0;}n:=jv_str(d,k,out);
  if n<1 || !ea_choice(cast(string)out[0..<n]) {return -1;}return n;
}
ea_read :: (raw:string,q:[]EaRequest)->bool #export_c #effects(all) {
  q[0]=EaRequest.{};nodes:[64]JvNode;d:[1]Jv;
  if raw.count>24576 || !jv_parse(d[..],raw,nodes[..]) || jv_kind(d[0],0)!=JV_OBJECT {return false;}
  v:=d[0];fields:=[16]string.["method","workspace_id","session_id","command_id","generation","expected_revision","text","interaction_id","allow","before","expires_at_ms","issued_at_ms","model","effort","folder","item_id"];seen:[16]bool;
  for i:0..<jv_len(v,0) {known:=false;k:=jv_key(v,jv_at(v,0,i));for key,j:fields {if k==key {if seen[j] {return false;}seen[j]=true;known=true;}}if !known {return false;}}
  q[0].nm=ea_field(v,"method",q[0].method[..]);q[0].nw=ea_field(v,"workspace_id",q[0].workspace[..]);
  q[0].ns=ea_field(v,"session_id",q[0].session[..]);q[0].nc=ea_field(v,"command_id",q[0].command[..]);
  q[0].nt=ea_field(v,"text",q[0].text[..]);q[0].ni=ea_field(v,"interaction_id",q[0].interaction[..]);
  q[0].nmo=ea_optional(v,0,"model",q[0].model[..]);q[0].nef=ea_optional(v,0,"effort",q[0].effort[..]);
  if q[0].nm<1 || q[0].nw<0 || q[0].ns<0 || q[0].nc<0 || q[0].nt<0 || q[0].ni<0 || q[0].nmo<0 || q[0].nef<0 {return false;}
  // a folder only opens a session, and only one spelled as a plain relative path
  if seen[14] {q[0].nf=ea_field(v,"folder",q[0].folder[..]);if q[0].nf<1 || !ea_folder_ok(cast(string)q[0].folder[0..<q[0].nf]) || cast(string)q[0].method[0..<q[0].nm]!="OpenSession" {return false;}}
  sub:=cast(string)q[0].method[0..<q[0].nm]=="ReadSubagent" || cast(string)q[0].method[0..<q[0].nm]=="StopSubagent";
  if seen[15] {q[0].nit=ea_field(v,"item_id",q[0].item[..]);if q[0].nit<1 || !sub {return false;}}else if sub {return false;}
  q[0].generation=jv_int(v,jv_get(v,0,"generation"),-1);q[0].revision=jv_int(v,jv_get(v,0,"expected_revision"),-1);
  q[0].before=jv_int(v,jv_get(v,0,"before"),-1);b:=jv_kind(v,jv_get(v,0,"allow"));
  q[0].expires=jv_int(v,jv_get(v,0,"expires_at_ms"),-1);q[0].issued=jv_int(v,jv_get(v,0,"issued_at_ms"),-1);
  if q[0].generation<0 || q[0].revision<0 || q[0].before<0 || q[0].expires<0 || q[0].issued<0 || (b!=JV_TRUE && b!=JV_FALSE) {return false;}
  q[0].allow=b==JV_TRUE;return ea_right(cast(string)q[0].method[0..<q[0].nm])>=0;
}
ea_write :: (q:[]EaRequest,out:[]u8)->int #effects(all) {
  o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);
  jo_key(o[..],"method");jo_str(o[..],cast(string)q[0].method[0..<q[0].nm]);
  jo_key(o[..],"workspace_id");jo_str(o[..],cast(string)q[0].workspace[0..<q[0].nw]);
  jo_key(o[..],"session_id");jo_str(o[..],cast(string)q[0].session[0..<q[0].ns]);
  jo_key(o[..],"command_id");jo_str(o[..],cast(string)q[0].command[0..<q[0].nc]);
  jo_key(o[..],"generation");jo_int(o[..],q[0].generation);jo_key(o[..],"expected_revision");jo_int(o[..],q[0].revision);
  jo_key(o[..],"text");jo_str(o[..],cast(string)q[0].text[0..<q[0].nt]);
  jo_key(o[..],"interaction_id");jo_str(o[..],cast(string)q[0].interaction[0..<q[0].ni]);
  jo_key(o[..],"allow");jo_bool(o[..],q[0].allow);jo_key(o[..],"before");jo_int(o[..],q[0].before);jo_key(o[..],"expires_at_ms");jo_int(o[..],q[0].expires);jo_key(o[..],"issued_at_ms");jo_int(o[..],q[0].issued);
  if q[0].nmo>0 {jo_key(o[..],"model");jo_str(o[..],cast(string)q[0].model[0..<q[0].nmo]);}
  if q[0].nef>0 {jo_key(o[..],"effort");jo_str(o[..],cast(string)q[0].effort[0..<q[0].nef]);}
  if q[0].nf>0 {jo_key(o[..],"folder");jo_str(o[..],cast(string)q[0].folder[0..<q[0].nf]);}
  if q[0].nit>0 {jo_key(o[..],"item_id");jo_str(o[..],cast(string)q[0].item[0..<q[0].nit]);}jo_end(o[..]);
  return ifx o[0].bad then -1 else o[0].n;
}
ea_read_body :: (method:string,id:string,before:string,out:[]u8)->int #export_c #effects(all) {
  if ea_right(method)!=0 || id.count>128 {return -1;}
  q:[1]EaRequest;q[0].nm=ea_copy(q[0].method[..],method);q[0].nw=ea_copy(q[0].workspace[..],"default");q[0].ns=ea_copy(q[0].session[..],id);
  for c:before {if c<'0' || c>'9' || q[0].before>900719925474099 {return -1;}q[0].before=q[0].before*10+cast(int)(c-'0');}
  return ea_write(q[..],out);
}
ea_summary :: (o:[]Jo,s_in:EaSession) #effects(all) {
  s:=s_in;
  jo_obj(o);jo_key(o,"session_id");jo_str(o,cast(string)s.id[0..<s.ni]);jo_key(o,"workspace_id");jo_str(o,cast(string)s.workspace[0..<s.nw]);
  jo_key(o,"title");jo_str(o,cast(string)s.title[0..<s.nt]);jo_key(o,"origin");jo_str(o,ifx s.managed then "managed" else "observed-native");
  jo_key(o,"control");jo_str(o,cast(string)s.control[0..<s.nc]);jo_key(o,"generation");jo_int(o,s.generation);jo_key(o,"revision");jo_int(o,s.revision);
  jo_key(o,"busy");jo_bool(o,s.busy);jo_key(o,"interaction_id");jo_str(o,cast(string)s.interaction[0..<s.nr]);jo_key(o,"updated_at_ms");jo_int(o,s.updated);
  if s.nmo>0 {jo_key(o,"model");jo_str(o,cast(string)s.model[0..<s.nmo]);}if s.nef>0 {jo_key(o,"effort");jo_str(o,cast(string)s.effort[0..<s.nef]);}
  if s.desktop {jo_key(o,"surface");jo_str(o,EA_SURFACE_DESKTOP);}jo_end(o);
}
ea_item :: (o:[]Jo,m_in:EaItem,text:string,diff:string) #effects(all) {
  m:=m_in;
  jo_obj(o);jo_key(o,"item_id");jo_str(o,cast(string)m.id[0..<m.ni]);jo_key(o,"role");jo_str(o,cast(string)m.role[0..<m.nr]);
  jo_key(o,"text");jo_str(o,text);jo_key(o,"tool_name");jo_str(o,cast(string)m.tool[0..<m.nk]);jo_key(o,"complete");jo_bool(o,m.complete);
  if m.started>0 {jo_key(o,"started_at_ms");jo_int(o,m.started);}
  if m.calls>0 {jo_key(o,"subagent_calls");jo_int(o,m.calls);if m.nn>0 {jo_key(o,"subagent_now");jo_str(o,cast(string)m.now[0..<m.nn]);}}
  if m.np>0 {jo_key(o,"path");jo_str(o,cast(string)m.path[0..<m.np]);}
  if diff.count>0 {jo_key(o,"diff");jo_str(o,diff);if m.diff_cut {jo_key(o,"diff_cut");jo_bool(o,true);}}jo_end(o);
}
ea_thought :: (v:[]EaView,i:int)->bool #effects(all) {m:=v[0].items[i];return cast(string)m.role[0..<m.nr]==EA_ROLE_THOUGHT;}
ea_thoughts_write :: (o:[]Jo,v:[]EaView) #effects(all) {
  any:=false;for i:0..<v[0].ni {if ea_thought(v,i) {any=true;}}if !any {return;}
  jo_key(o,"thoughts");jo_arr(o);at:=0;
  for i:0..<v[0].ni {if !ea_thought(v,i) {at+=1;continue;}m:=v[0].items[i];
    jo_obj(o);jo_key(o,"item_id");jo_str(o,cast(string)m.id[0..<m.ni]);jo_key(o,"text");jo_str(o,ea_item_text(v,i));jo_key(o,"complete");jo_bool(o,m.complete);jo_key(o,"at");jo_int(o,at);jo_end(o);}
  jo_end(o);
}
// The thoughts are optional (an older computer sends none); each goes back at its place among items.
ea_thoughts_read :: (j:Jv,v:[]EaView)->bool #effects(all) {
  list:=jv_get(j,0,"thoughts");if list<0 {return true;}
  if jv_kind(j,list)!=JV_ARRAY || v[0].ni+jv_len(j,list)>EA_ITEMS {return false;}
  plain:=v[0].ni;last:=0;
  for t:0..<jv_len(j,list) {row:=jv_at(j,list,t);at:=jv_int(j,jv_get(j,row,"at"),-1);if at<last || at>plain {return false;}last=at;
    m:EaItem;m.ni=jv_str(j,jv_get(j,row,"item_id"),m.id[..]);m.nr=ea_copy(m.role[..],EA_ROLE_THOUGHT);m.text_at=v[0].text_n;
    end:=ifx v[0].text_n+16384<v[0].text.count then v[0].text_n+16384 else v[0].text.count;m.nt=jv_str(j,jv_get(j,row,"text"),v[0].text[v[0].text_n..<end]);m.complete=jv_bool(j,jv_get(j,row,"complete"));
    if m.ni<1 || m.nt<0 {return false;}v[0].text_n+=m.nt;
    // the t thoughts before it are in place already, each at an item no later than this one's
    k:=at+t;q:=v[0].ni;while q>k {v[0].items[q]=v[0].items[q-1];q-=1;}v[0].items[k]=m;v[0].ni+=1;
  }
  return true;
}
ea_view_write :: (v:[]EaView,out:[]u8)->int #effects(all) {
  o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],EA_SCHEMA);jo_key(o[..],"host_pubkey");jo_str(o[..],cast(string)v[0].host[0..<v[0].nh]);
  jo_key(o[..],"display_name");jo_str(o[..],cast(string)v[0].label[0..<v[0].nl]);jo_key(o[..],"method");jo_str(o[..],cast(string)v[0].method[0..<v[0].nm]);
  jo_key(o[..],"sessions");jo_arr(o[..]);for i:0..<v[0].ns {ea_summary(o[..],v[0].sessions[i]);}jo_end(o[..]);
  jo_key(o[..],"items");jo_arr(o[..]);for i:0..<v[0].ni {if !ea_thought(v,i) {ea_item(o[..],v[0].items[i],ea_item_text(v,i),ea_item_diff(v,i));}}jo_end(o[..]);
  jo_key(o[..],"error");jo_str(o[..],cast(string)v[0].error[0..<v[0].ne]);jo_key(o[..],"complete");jo_bool(o[..],v[0].complete);
  jo_key(o[..],"next_cursor");jo_str(o[..],cast(string)v[0].cursor[0..<v[0].nc]);jo_key(o[..],"command_id");jo_str(o[..],cast(string)v[0].command[0..<v[0].nq]);
  jo_key(o[..],"command_status");jo_str(o[..],cast(string)v[0].status[0..<v[0].nt]);jo_key(o[..],"source_epoch");jo_str(o[..],cast(string)v[0].epoch[0..<v[0].np]);
  ea_thoughts_write(o[..],v);if v[0].offer.n>0 {ea_offer_write(o[..],v[..]);}
  if v[0].nroot>0 {jo_key(o[..],"workspace_name");jo_str(o[..],cast(string)v[0].root[0..<v[0].nroot]);}
  if v[0].nfolders>0 {jo_key(o[..],"folders");jo_arr(o[..]);for i:0..<v[0].nfolders {jo_str(o[..],cast(string)v[0].folders[i].path[0..<v[0].folders[i].np]);}jo_end(o[..]);}jo_end(o[..]);
  return ifx o[0].bad then -1 else o[0].n;
}
ea_offer_write :: (o:[]Jo,v:[]EaView) #effects(all) {
  jo_key(o,"efforts");jo_arr(o);
  for i:0..<v[0].offer.nv {l:=v[0].offer.levels[i];jo_obj(o);jo_key(o,"effort_id");jo_str(o,cast(string)l.id[0..<l.ni]);jo_key(o,"display_name");jo_str(o,cast(string)l.label[0..<l.nl]);jo_end(o);}
  jo_end(o);d:=v[0].offer.default_level;
  jo_key(o,"default_effort");jo_str(o,ifx d>=0 && d<v[0].offer.nv then cast(string)v[0].offer.levels[d].id[0..<v[0].offer.levels[d].ni] else "");
  jo_key(o,"models");jo_arr(o);
  for i:0..<v[0].offer.n {m:=v[0].offer.models[i];jo_obj(o);jo_key(o,"model_id");jo_str(o,cast(string)m.id[0..<m.ni]);jo_key(o,"display_name");jo_str(o,cast(string)m.label[0..<m.nl]);
    jo_key(o,"efforts");jo_arr(o);for k:0..<v[0].offer.nv {if (m.ladder & (1<<k))!=0 {l:=v[0].offer.levels[k];jo_str(o,cast(string)l.id[0..<l.ni]);}}jo_end(o);jo_end(o);}
  jo_end(o);
}
// The offer is optional (an older computer sends none); one that is present is whole.
ea_offer_read :: (j:Jv,v:[]EaView)->bool #effects(all) {
  models:=jv_get(j,0,"models");if models<0 {return true;}
  levels:=jv_get(j,0,"efforts");f:=v[0].offer.levels[..];
  if jv_kind(j,models)!=JV_ARRAY || jv_kind(j,levels)!=JV_ARRAY || jv_len(j,models)>EA_MODELS || jv_len(j,levels)>EA_LEVELS {return false;}
  v[0].offer.nv=jv_len(j,levels);v[0].offer.default_level= -1;def:[16]u8;nd:=ea_optional(j,0,"default_effort",def[..]);
  for i:0..<v[0].offer.nv {row:=jv_at(j,levels,i);l:=v[0].offer.levels[i];l.ni=ea_optional(j,row,"effort_id",l.id[..]);l.nl=jv_str(j,jv_get(j,row,"display_name"),l.label[..]);
    if l.ni<1 || l.nl<1 {return false;}v[0].offer.levels[i]=l;if nd>0 && cast(string)l.id[0..<l.ni]==cast(string)def[0..<nd] {v[0].offer.default_level=i;}}
  v[0].offer.n=jv_len(j,models);
  for i:0..<v[0].offer.n {row:=jv_at(j,models,i);m:=v[0].offer.models[i];m.ni=ea_optional(j,row,"model_id",m.id[..]);m.nl=jv_str(j,jv_get(j,row,"display_name"),m.label[..]);
    if m.ni<1 || m.nl<1 {return false;}list:=jv_get(j,row,"efforts");if jv_kind(j,list)!=JV_ARRAY {return false;}
    for k:0..<jv_len(j,list) {id:[16]u8;n:=jv_str(j,jv_at(j,list,k),id[..]);found:= -1;
      for x:0..<v[0].offer.nv {l:=v[0].offer.levels[x];if n>0 && cast(string)l.id[0..<l.ni]==cast(string)id[0..<n] {found=x;}}
      if found<0 {return false;}m.ladder|=1<<found;}
    v[0].offer.models[i]=m;}
  return true;
}
// The folders a computer offers are optional (an older one sends none); each is a plain relative path.
// A computer that names its workspace ("workspace_name") offers its projects in it, not subfolders.
ea_folders_read :: (j:Jv,v:[]EaView)->bool #effects(all) {
  v[0].nroot=0;k:=jv_get(j,0,"workspace_name");
  if k>=0 {n:=jv_str(j,k,v[0].root[..]);if n<1 || n>80 {return false;}for c:cast(string)v[0].root[0..<n] {if c<32 || c==127 || c=='/' {return false;}}v[0].nroot=n;}
  list:=jv_get(j,0,"folders");if list<0 {return true;}
  if jv_kind(j,list)!=JV_ARRAY || jv_len(j,list)>EA_FOLDERS {return false;}
  for i:0..<jv_len(j,list) {f:=v[0].folders[i..<i+1];f[0].np=jv_str(j,jv_at(j,list,i),f[0].path[..]);if f[0].np<1 || !ea_folder_ok(cast(string)f[0].path[0..<f[0].np]) {return false;}}
  v[0].nfolders=jv_len(j,list);return true;
}
ea_view_read :: (raw:string,v:[]EaView)->bool #export_c #effects(all) {
  v[0]=EaView.{};nodes:[4096]JvNode;d:[1]Jv;if raw.count>1048576 || !jv_parse(d[..],raw,nodes[..]) {return false;}j:=d[0];
  if jv_raw(j,jv_get(j,0,"schema"))!=EA_SCHEMA {return false;}
  v[0].nh=ea_field(j,"host_pubkey",v[0].host[..]);v[0].nl=ea_field(j,"display_name",v[0].label[..]);v[0].nm=ea_field(j,"method",v[0].method[..]);
  v[0].ne=ea_field(j,"error",v[0].error[..]);v[0].nc=ea_field(j,"next_cursor",v[0].cursor[..]);v[0].nq=ea_field(j,"command_id",v[0].command[..]);
  v[0].nt=ea_field(j,"command_status",v[0].status[..]);v[0].np=ea_field(j,"source_epoch",v[0].epoch[..]);
  if v[0].nh!=64 || v[0].nl<0 || v[0].nm<1 || v[0].ne<0 || v[0].nc<0 || v[0].nq<0 || v[0].nt<0 || v[0].np<0 {return false;}
  if !ea_id(cast(string)v[0].host[..],64) {return false;}v[0].complete=jv_bool(j,jv_get(j,0,"complete"));
  list:=jv_get(j,0,"sessions");items:=jv_get(j,0,"items");
  if jv_kind(j,list)!=JV_ARRAY || jv_kind(j,items)!=JV_ARRAY {return false;}
  v[0].ns=jv_len(j,list);v[0].ni=jv_len(j,items);if v[0].ns>128 || v[0].ni>64 {return false;}
  for i:0..<v[0].ns {s:=v[0].sessions[i];row:=jv_at(j,list,i);
    s.ni=jv_str(j,jv_get(j,row,"session_id"),s.id[..]);s.nw=jv_str(j,jv_get(j,row,"workspace_id"),s.workspace[..]);s.nt=jv_str(j,jv_get(j,row,"title"),s.title[..]);
    origin:=jv_raw(j,jv_get(j,row,"origin"));if origin!="managed" && origin!="observed-native" {return false;}s.managed=origin=="managed";
    s.nc=jv_str(j,jv_get(j,row,"control"),s.control[..]);s.nr=jv_str(j,jv_get(j,row,"interaction_id"),s.interaction[..]);
    s.generation=jv_int(j,jv_get(j,row,"generation"),-1);s.revision=jv_int(j,jv_get(j,row,"revision"),-1);s.updated=jv_int(j,jv_get(j,row,"updated_at_ms"),-1);s.busy=jv_bool(j,jv_get(j,row,"busy"));
    s.nmo=ea_optional(j,row,"model",s.model[..]);s.nef=ea_optional(j,row,"effort",s.effort[..]);s.desktop=jv_raw(j,jv_get(j,row,"surface"))==EA_SURFACE_DESKTOP;
    if s.ni<1 || s.nw<0 || s.nt<0 || s.nc<1 || s.nr<0 || s.generation<0 || s.revision<0 || s.updated<0 || s.nmo<0 || s.nef<0 {return false;}v[0].sessions[i]=s;
  }
  for i:0..<v[0].ni {m:=v[0].items[i];row:=jv_at(j,items,i);
    m.ni=jv_str(j,jv_get(j,row,"item_id"),m.id[..]);m.nr=jv_str(j,jv_get(j,row,"role"),m.role[..]);m.text_at=v[0].text_n;end:=ifx v[0].text_n+16384<v[0].text.count then v[0].text_n+16384 else v[0].text.count;m.nt=jv_str(j,jv_get(j,row,"text"),v[0].text[v[0].text_n..<end]);m.nk=jv_str(j,jv_get(j,row,"tool_name"),m.tool[..]);m.complete=jv_bool(j,jv_get(j,row,"complete"));
    at:=jv_get(j,row,"started_at_ms");m.started=ifx at<0 then 0 else jv_int(j,at,-1);
    sc:=jv_get(j,row,"subagent_calls");m.calls=ifx sc<0 then 0 else jv_int(j,sc,-1);
    sn:=jv_get(j,row,"subagent_now");m.nn=ifx sn<0 then 0 else jv_str(j,sn,m.now[..]);
    if m.ni<1 || m.nr<1 || m.nt<0 || m.nk<0 || m.started<0 || m.calls<0 || m.nn<0 || (m.nn>0 && m.calls==0) {return false;}v[0].text_n+=m.nt;
    pk:=jv_get(j,row,"path");m.np=ifx pk<0 then 0 else jv_str(j,pk,m.path[..]);
    dk:=jv_get(j,row,"diff");m.diff_at=v[0].text_n;m.ndiff=0;
    if dk>=0 {dend:=ifx v[0].text_n+EA_DIFF<v[0].text.count then v[0].text_n+EA_DIFF else v[0].text.count;m.ndiff=jv_str(j,dk,v[0].text[v[0].text_n..<dend]);}
    ck:=jv_get(j,row,"diff_cut");m.diff_cut=ck>=0 && jv_bool(j,ck);
    if m.np<0 || m.ndiff<0 || (m.diff_cut && m.ndiff==0) {return false;}v[0].text_n+=m.ndiff;v[0].items[i]=m;
  }
  if !ea_thoughts_read(j,v) || !ea_offer_read(j,v) || !ea_folders_read(j,v) {return false;}
  v[0].ok=true;return true;
}

#test "runtime view is owned, host-scoped and refuses malformed item bounds" {
  v:[1]EaView;v[0].nh=ea_copy(v[0].host[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");v[0].nm=ea_copy(v[0].method[..],"DescribeEnvironment");v[0].complete=true;
  out:[4096]u8;n:=ea_view_write(v[..],out[..]);other:[1]EaView;#assert n>0 && ea_view_read(cast(string)out[0..<n],other[..]);
  #assert other[0].ok && other[0].complete && other[0].nh==64;
  #assert !ea_view_read("{}",other[..]);
}
#test "decoded timeline copies own one bounded arena without retained pointers" {
  v:[1]EaView;v[0].nh=ea_copy(v[0].host[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");v[0].nm=ea_copy(v[0].method[..],"ReadSession");v[0].ni=1;
  v[0].items[0].ni=ea_copy(v[0].items[0].id[..],"item-1");v[0].items[0].nr=ea_copy(v[0].items[0].role[..],"assistant");
  text:="**héllo**\n\"world\"";v[0].items[0].text_at=ea_text_put(v[..],text);v[0].items[0].nt=text.count;
  out:[4096]u8;n:=ea_view_write(v[..],out[..]);r:[1]EaView;#assert n>0 && ea_view_read(cast(string)out[0..<n],r[..]);
  copy:=[1]EaView.[r[0]];for i:0..<r[0].text_n {r[0].text[i]=0;}
  #assert ea_item_text(copy[..],0)==text;
  oversized:[16385]u8;before:=copy[0].text_n;#assert ea_text_put(copy[..],cast(string)oversized[..])== -1 && copy[0].text_n==before;
}

#test "runtime request codec preserves escaped text and rejects a duplicate or unknown method" {
  q:[1]EaRequest;q[0].nm=ea_copy(q[0].method[..],"SendMessage");q[0].nt=ea_copy(q[0].text[..],"hello\n\"world\"");q[0].generation=7;q[0].revision=4;
  out:[24576]u8;n:=ea_write(q[..],out[..]);r:[1]EaRequest;
  #assert n>0 && ea_read(cast(string)out[0..<n],r[..]);#assert r[0].generation==7 && r[0].revision==4 && r[0].nt==13;
  #assert !ea_read("{\"method\":\"RunCommand\"}",r[..]);
  #assert !ea_read("{\"method\":\"ReadSession\",\"method\":\"SendMessage\"}",r[..]);
  #assert !ea_read("[]",r[..]);
}

#test "a turn's model and effort are optional, bounded ids, and absent ones are never written" {
  q:[1]EaRequest;q[0].nm=ea_copy(q[0].method[..],"OpenSession");q[0].nt=ea_copy(q[0].text[..],"hi");
  out:[24576]u8;n:=ea_write(q[..],out[..]);r:[1]EaRequest;
  #assert n>0 && ea_read(cast(string)out[0..<n],r[..]) && r[0].nmo==0 && r[0].nef==0;
  plain:=cast(string)out[0..<n];found:=false;for i:0..<plain.count-7 {if cast(string)plain[i..<i+7]=="\"model\"" {found=true;}}#assert !found;
  q[0].nmo=ea_copy(q[0].model[..],"claude-opus-5-5");q[0].nef=ea_copy(q[0].effort[..],"xhigh");n=ea_write(q[..],out[..]);
  #assert n>0 && ea_read(cast(string)out[0..<n],r[..]) && cast(string)r[0].model[0..<r[0].nmo]=="claude-opus-5-5" && cast(string)r[0].effort[0..<r[0].nef]=="xhigh";
  #assert !ea_read("{\"method\":\"OpenSession\",\"workspace_id\":\"default\",\"session_id\":\"\",\"command_id\":\"\",\"generation\":0,\"expected_revision\":0,\"text\":\"hi\",\"interaction_id\":\"\",\"allow\":false,\"before\":0,\"expires_at_ms\":0,\"issued_at_ms\":0,\"model\":\"--dangerously\\nskip\"}",r[..]);
  #assert !ea_read("{\"method\":\"OpenSession\",\"workspace_id\":\"default\",\"session_id\":\"\",\"command_id\":\"\",\"generation\":0,\"expected_revision\":0,\"text\":\"hi\",\"interaction_id\":\"\",\"allow\":false,\"before\":0,\"expires_at_ms\":0,\"issued_at_ms\":0,\"effort\":\"\"}",r[..]);
}
#test "a computer's offer and a session's choice survive the view codec; an offer naming an unknown effort is refused" {
  v:[1]EaView;v[0].nh=ea_copy(v[0].host[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");v[0].nm=ea_copy(v[0].method[..],"ListSessions");
  o:=v[0].offer;o.nv=2;o.levels[0].ni=ea_copy(o.levels[0].id[..],"low");o.levels[0].nl=ea_copy(o.levels[0].label[..],"Low");o.levels[1].ni=ea_copy(o.levels[1].id[..],"high");o.levels[1].nl=ea_copy(o.levels[1].label[..],"High");o.default_level=1;
  o.n=2;o.models[0].ni=ea_copy(o.models[0].id[..],"default");o.models[0].nl=ea_copy(o.models[0].label[..],"Default");o.models[0].ladder=3;
  o.models[1].ni=ea_copy(o.models[1].id[..],"claude-haiku-4-5");o.models[1].nl=ea_copy(o.models[1].label[..],"Haiku 4.5");v[0].offer=o;
  v[0].ns=1;v[0].sessions[0].ni=ea_copy(v[0].sessions[0].id[..],"s1");v[0].sessions[0].nc=ea_copy(v[0].sessions[0].control[..],"available");v[0].sessions[0].nmo=ea_copy(v[0].sessions[0].model[..],"default");v[0].sessions[0].nef=ea_copy(v[0].sessions[0].effort[..],"high");
  out:[16384]u8;n:=ea_view_write(v[..],out[..]);r:[1]EaView;#assert n>0 && ea_view_read(cast(string)out[0..<n],r[..]);
  #assert r[0].offer.n==2 && r[0].offer.nv==2 && r[0].offer.default_level==1 && r[0].offer.models[0].ladder==3 && r[0].offer.models[1].ladder==0;
  #assert cast(string)r[0].sessions[0].effort[0..<r[0].sessions[0].nef]=="high";
  #assert ea_view_read("{\"schema\":\"openagents.environment.runtime.v1alpha1\",\"host_pubkey\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"display_name\":\"\",\"method\":\"ListSessions\",\"sessions\":[],\"items\":[],\"error\":\"\",\"complete\":true,\"next_cursor\":\"\",\"command_id\":\"\",\"command_status\":\"\",\"source_epoch\":\"\",\"efforts\":[{\"effort_id\":\"low\",\"display_name\":\"Low\"}],\"default_effort\":\"low\",\"models\":[{\"model_id\":\"x\",\"display_name\":\"X\",\"efforts\":[\"low\"]}]}",r[..]) && r[0].offer.models[0].ladder==1;
  #assert !ea_view_read("{\"schema\":\"openagents.environment.runtime.v1alpha1\",\"host_pubkey\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"display_name\":\"\",\"method\":\"ListSessions\",\"sessions\":[],\"items\":[],\"error\":\"\",\"complete\":true,\"next_cursor\":\"\",\"command_id\":\"\",\"command_status\":\"\",\"source_epoch\":\"\",\"efforts\":[{\"effort_id\":\"low\",\"display_name\":\"Low\"}],\"default_effort\":\"low\",\"models\":[{\"model_id\":\"x\",\"display_name\":\"X\",\"efforts\":[\"max\"]}]}",r[..]);
  v[0].offer=EaOffer.{};n=ea_view_write(v[..],out[..]);#assert n>0 && ea_view_read(cast(string)out[0..<n],r[..]) && r[0].offer.n==0;
}

#test "a Coder Desktop chat says so on the wire; a session without the member is not one" {
  v:[1]EaView;v[0].nh=ea_copy(v[0].host[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");v[0].nm=ea_copy(v[0].method[..],"ListSessions");v[0].ns=2;
  for i:0..<2 {v[0].sessions[i].ni=ea_copy(v[0].sessions[i].id[..],ifx i==0 then "desktop-0123456789abcdef0123456789abcdef" else "s1");v[0].sessions[i].nc=ea_copy(v[0].sessions[i].control[..],"available");v[0].sessions[i].managed=true;}
  v[0].sessions[0].desktop=true;
  out:[16384]u8;n:=ea_view_write(v[..],out[..]);r:[1]EaView;found:=false;for i:0..<(ifx n>25 then n-25 else 0) {if cast(string)out[i..<i+25]=="\"surface\":\"coder-desktop\"" {found=true;}}
  #assert n>0 && found && ea_view_read(cast(string)out[0..<n],r[..]) && r[0].sessions[0].desktop && !r[0].sessions[1].desktop;
}

#test "a thought travels beside items at its place, so a v1alpha1 reader never sees it as a reply" {
  v:[1]EaView;v[0].nh=ea_copy(v[0].host[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");v[0].nm=ea_copy(v[0].method[..],"ReadSession");
  roles:=[5]string.["user","thought","tool","thought","assistant"];texts:=[5]string.["Fix it","Look first","ls","Then edit","Done"];
  for r,i:roles {m:=v[0].items[i];b:[8]u8;b[0]=cast(u8)('a'+i);m.ni=ea_copy(m.id[..],cast(string)b[0..<1]);m.nr=ea_copy(m.role[..],r);m.text_at=ea_text_put(v[..],texts[i]);m.nt=texts[i].count;m.complete=i!=3;v[0].items[i]=m;}
  v[0].ni=5;out:[8192]u8;n:=ea_view_write(v[..],out[..]);r:[1]EaView;#assert n>0 && ea_view_read(cast(string)out[0..<n],r[..]);
  #assert r[0].ni==5;for i:0..<5 {#assert cast(string)r[0].items[i].role[0..<r[0].items[i].nr]==roles[i] && ea_item_text(r[..],i)==texts[i];}
  #assert !r[0].items[3].complete && r[0].items[1].complete;
  // the items a v1alpha1 reader sees hold no thought
  w:=cast(string)out[0..<n];k:=0;found:=false;while k+9<w.count {if cast(string)w[k..<k+9]=="\"thought\"" {found=true;}k+=1;}#assert !found;
  // a thought out of order or past the end is refused
  bad:="{\"schema\":\"openagents.environment.runtime.v1alpha1\",\"host_pubkey\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"display_name\":\"\",\"method\":\"ReadSession\",\"sessions\":[],\"items\":[],\"error\":\"\",\"complete\":true,\"next_cursor\":\"\",\"command_id\":\"\",\"command_status\":\"\",\"source_epoch\":\"\",\"thoughts\":[{\"item_id\":\"t\",\"text\":\"x\",\"complete\":true,\"at\":1}]}";
  #assert !ea_view_read(bad,r[..]);
  good:="{\"schema\":\"openagents.environment.runtime.v1alpha1\",\"host_pubkey\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"display_name\":\"\",\"method\":\"ReadSession\",\"sessions\":[],\"items\":[],\"error\":\"\",\"complete\":true,\"next_cursor\":\"\",\"command_id\":\"\",\"command_status\":\"\",\"source_epoch\":\"\",\"thoughts\":[{\"item_id\":\"t\",\"text\":\"x\",\"complete\":true,\"at\":0}]}";
  #assert ea_view_read(good,r[..]) && r[0].ni==1 && ea_thought(r[..],0);
}

#test "a running call's start travels as an optional field; a bad start is refused, and none reads as not running" {
  v:[1]EaView;v[0].nh=ea_copy(v[0].host[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");v[0].nm=ea_copy(v[0].method[..],"ReadSession");
  for i:0..<2 {m:=v[0].items[i];m.ni=ea_copy(m.id[..],ifx i==0 then "a" else "b");m.nr=ea_copy(m.role[..],"tool");m.nk=ea_copy(m.tool[..],"Bash");m.text_at=ea_text_put(v[..],"ls");m.nt=2;m.complete=true;m.started=ifx i==0 then 0 else 1700000000123;v[0].items[i]=m;}
  v[0].ni=2;out:[8192]u8;n:=ea_view_write(v[..],out[..]);r:[1]EaView;#assert n>0 && ea_view_read(cast(string)out[0..<n],r[..]);
  #assert r[0].items[0].started==0 && r[0].items[1].started==1700000000123;
  head:="{\"schema\":\"openagents.environment.runtime.v1alpha1\",\"host_pubkey\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"display_name\":\"\",\"method\":\"ReadSession\",\"sessions\":[],\"items\":[{\"item_id\":\"a\",\"role\":\"tool\",\"text\":\"ls\",\"tool_name\":\"Bash\",";
  tail:="}],\"error\":\"\",\"complete\":true,\"next_cursor\":\"\",\"command_id\":\"\",\"command_status\":\"\",\"source_epoch\":\"\"}";
  b:[1024]u8;k:=0;
  k=0;for c:head {b[k]=c;k+=1;}for c:"\"complete\":true,\"started_at_ms\":\"5\"" {b[k]=c;k+=1;}for c:tail {b[k]=c;k+=1;}#assert !ea_view_read(cast(string)b[0..<k],r[..]);
  k=0;for c:head {b[k]=c;k+=1;}for c:"\"complete\":false,\"started_at_ms\":-5" {b[k]=c;k+=1;}for c:tail {b[k]=c;k+=1;}#assert !ea_view_read(cast(string)b[0..<k],r[..]);
  k=0;for c:head {b[k]=c;k+=1;}for c:"\"complete\":false" {b[k]=c;k+=1;}for c:tail {b[k]=c;k+=1;}#assert ea_view_read(cast(string)b[0..<k],r[..]) && r[0].items[0].started==0;
}

#test "a sub-agent's call count and newest call travel as optional fields; a newest call without a count is refused" {
  v:[1]EaView;v[0].nh=ea_copy(v[0].host[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");v[0].nm=ea_copy(v[0].method[..],"ReadSession");
  m:=v[0].items[0];m.ni=ea_copy(m.id[..],"a");m.nr=ea_copy(m.role[..],"tool");m.nk=ea_copy(m.tool[..],"Task");m.text_at=ea_text_put(v[..],"Find it");m.nt=7;m.complete=true;m.calls=3;m.nn=ea_copy(m.now[..],"Read /w/a.toml");v[0].items[0]=m;
  m=v[0].items[1];m.ni=ea_copy(m.id[..],"b");m.nr=ea_copy(m.role[..],"tool");m.nk=ea_copy(m.tool[..],"Bash");m.text_at=ea_text_put(v[..],"ls");m.nt=2;m.complete=true;v[0].items[1]=m;v[0].ni=2;
  out:[8192]u8;n:=ea_view_write(v[..],out[..]);r:[1]EaView;#assert n>0 && ea_view_read(cast(string)out[0..<n],r[..]);
  #assert r[0].items[0].calls==3 && cast(string)r[0].items[0].now[0..<r[0].items[0].nn]=="Read /w/a.toml" && r[0].items[1].calls==0 && r[0].items[1].nn==0;
  #assert !ea_view_read("{\"schema\":\"openagents.environment.runtime.v1alpha1\",\"host_pubkey\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"display_name\":\"\",\"method\":\"ReadSession\",\"sessions\":[],\"items\":[{\"item_id\":\"a\",\"role\":\"tool\",\"text\":\"x\",\"tool_name\":\"Task\",\"complete\":true,\"subagent_now\":\"Bash ls\"}],\"error\":\"\",\"complete\":true,\"next_cursor\":\"\",\"command_id\":\"\",\"command_status\":\"\",\"source_epoch\":\"\"}",r[..]);
}
#test "a working folder travels only on OpenSession and only as plain relative segments; a computer's folders are optional" {
  #assert ea_folder_ok("src") && ea_folder_ok("apps/web") && ea_folder_ok("my folder");
  #assert !ea_folder_ok("") && !ea_folder_ok("/etc") && !ea_folder_ok("a/") && !ea_folder_ok("a//b") && !ea_folder_ok("..") && !ea_folder_ok("a/../b") && !ea_folder_ok(".git") && !ea_folder_ok("a/.ssh") && !ea_folder_ok("a\\b") && !ea_folder_ok("a\nb");
  q:[1]EaRequest;q[0].nm=ea_copy(q[0].method[..],"OpenSession");q[0].nw=ea_copy(q[0].workspace[..],"default");q[0].nf=ea_copy(q[0].folder[..],"apps/web");
  raw:[2048]u8;n:=ea_write(q[..],raw[..]);r:[1]EaRequest;#assert n>0 && ea_read(cast(string)raw[0..<n],r[..]) && cast(string)r[0].folder[0..<r[0].nf]=="apps/web";
  // no folder: the key is left out, as an older phone sends it
  q[0].nf=0;n=ea_write(q[..],raw[..]);#assert ea_read(cast(string)raw[0..<n],r[..]) && r[0].nf==0;
  // a folder on another method, or one that leaves the workspace, is refused
  q[0].nm=ea_copy(q[0].method[..],"SendMessage");q[0].nf=ea_copy(q[0].folder[..],"src");n=ea_write(q[..],raw[..]);#assert !ea_read(cast(string)raw[0..<n],r[..]);
  q[0].nm=ea_copy(q[0].method[..],"OpenSession");q[0].nf=ea_copy(q[0].folder[..],"../x");n=ea_write(q[..],raw[..]);#assert !ea_read(cast(string)raw[0..<n],r[..]);
  v:[1]EaView;v[0].nh=ea_copy(v[0].host[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");v[0].nm=ea_copy(v[0].method[..],"DescribeEnvironment");
  out:[4096]u8;n=ea_view_write(v[..],out[..]);w:[1]EaView;#assert n>0 && ea_view_read(cast(string)out[0..<n],w[..]) && w[0].nfolders==0;
  v[0].nfolders=2;v[0].folders[0].np=ea_copy(v[0].folders[0].path[..],"apps");v[0].folders[1].np=ea_copy(v[0].folders[1].path[..],"docs");
  n=ea_view_write(v[..],out[..]);#assert n>0 && ea_view_read(cast(string)out[0..<n],w[..]) && w[0].nfolders==2 && cast(string)w[0].folders[1].path[0..<w[0].folders[1].np]=="docs" && w[0].nroot==0;
  // a computer that names its workspace offers projects in it
  v[0].nroot=ea_copy(v[0].root[..],"work");n=ea_view_write(v[..],out[..]);#assert n>0 && ea_view_read(cast(string)out[0..<n],w[..]) && cast(string)w[0].root[0..<w[0].nroot]=="work";
  v[0].folders[1].np=ea_copy(v[0].folders[1].path[..],"..");n=ea_view_write(v[..],out[..]);#assert !ea_view_read(cast(string)out[0..<n],w[..]);
}
#test "an edit's file and change travel as optional fields; a cut without a change is refused" {
  cut:[1]bool;d:[64]u8;n:=ea_diff_make(d[..],"a\nb","c",cut[..]);#assert cast(string)d[0..<n]=="-a\n-b\n+c\n" && !cut[0];
  n=ea_diff_make(d[0..<7],"a\nb","c",cut[..]);#assert cast(string)d[0..<n]=="-a\n-b\n" && cut[0];
  n=ea_diff_make(d[..],"","new",cut[..]);#assert cast(string)d[0..<n]=="+new\n";
  v:[1]EaView;v[0].nh=ea_copy(v[0].host[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");v[0].nm=ea_copy(v[0].method[..],"ReadSession");
  m:=v[0].items[0];m.ni=ea_copy(m.id[..],"a");m.nr=ea_copy(m.role[..],"tool");m.nk=ea_copy(m.tool[..],"Edit");m.text_at=ea_text_put(v[..],"updated");m.nt=7;m.complete=true;
  m.np=ea_copy(m.path[..],"/w/a.coax");m.diff_at=ea_text_put(v[..],"-old\n+new\n");m.ndiff=10;m.diff_cut=true;v[0].items[0]=m;
  m=v[0].items[1];m.ni=ea_copy(m.id[..],"b");m.nr=ea_copy(m.role[..],"tool");m.nk=ea_copy(m.tool[..],"Bash");m.text_at=ea_text_put(v[..],"ls");m.nt=2;m.complete=true;v[0].items[1]=m;v[0].ni=2;
  out:[8192]u8;w:=ea_view_write(v[..],out[..]);r:[1]EaView;#assert w>0 && ea_view_read(cast(string)out[0..<w],r[..]);
  #assert cast(string)r[0].items[0].path[0..<r[0].items[0].np]=="/w/a.coax" && ea_item_diff(r[..],0)=="-old\n+new\n" && r[0].items[0].diff_cut && ea_item_text(r[..],0)=="updated";
  #assert r[0].items[1].np==0 && ea_item_diff(r[..],1)=="" && !r[0].items[1].diff_cut && ea_item_text(r[..],1)=="ls";
  #assert !ea_view_read("{\"schema\":\"openagents.environment.runtime.v1alpha1\",\"host_pubkey\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"display_name\":\"\",\"method\":\"ReadSession\",\"sessions\":[],\"items\":[{\"item_id\":\"a\",\"role\":\"tool\",\"text\":\"x\",\"tool_name\":\"Edit\",\"complete\":true,\"diff_cut\":true}],\"error\":\"\",\"complete\":true,\"next_cursor\":\"\",\"command_id\":\"\",\"command_status\":\"\",\"source_epoch\":\"\"}",r[..]);
}

#test "ReadSubagent names the item that started its agent, and only it may" {
  r:[1]EaRequest;
  ok:="{\"method\":\"ReadSubagent\",\"workspace_id\":\"default\",\"session_id\":\"s\",\"command_id\":\"\",\"generation\":0,\"expected_revision\":0,\"text\":\"\",\"interaction_id\":\"\",\"allow\":false,\"before\":0,\"expires_at_ms\":0,\"issued_at_ms\":0,\"item_id\":\"3:0\"}";
  #assert ea_read(ok,r[..]) && cast(string)r[0].item[0..<r[0].nit]=="3:0";
  out:[2048]u8;n:=ea_write(r[..],out[..]);again:[1]EaRequest;#assert n>0 && ea_read(cast(string)out[0..<n],again[..]) && again[0].nit==3;
  #assert !ea_read("{\"method\":\"ReadSubagent\",\"workspace_id\":\"default\",\"session_id\":\"s\",\"command_id\":\"\",\"generation\":0,\"expected_revision\":0,\"text\":\"\",\"interaction_id\":\"\",\"allow\":false,\"before\":0,\"expires_at_ms\":0,\"issued_at_ms\":0}",r[..]);
  #assert !ea_read("{\"method\":\"ReadSession\",\"workspace_id\":\"default\",\"session_id\":\"s\",\"command_id\":\"\",\"generation\":0,\"expected_revision\":0,\"text\":\"\",\"interaction_id\":\"\",\"allow\":false,\"before\":0,\"expires_at_ms\":0,\"issued_at_ms\":0,\"item_id\":\"3:0\"}",r[..]);
  // StopSubagent names its item the same way, and may not leave it out (#13776)
  stop:="{\"method\":\"StopSubagent\",\"workspace_id\":\"default\",\"session_id\":\"s\",\"command_id\":\"0123456789abcdef0123456789abcdef\",\"generation\":7,\"expected_revision\":0,\"text\":\"\",\"interaction_id\":\"\",\"allow\":false,\"before\":0,\"expires_at_ms\":2,\"issued_at_ms\":1,\"item_id\":\"3:0\"}";
  #assert ea_read(stop,r[..]) && cast(string)r[0].item[0..<r[0].nit]=="3:0" && ea_right(cast(string)r[0].method[0..<r[0].nm])==1;
  n=ea_write(r[..],out[..]);#assert n>0 && cast(string)out[0..<n]==stop;
  #assert !ea_read("{\"method\":\"StopSubagent\",\"workspace_id\":\"default\",\"session_id\":\"s\",\"command_id\":\"0123456789abcdef0123456789abcdef\",\"generation\":7,\"expected_revision\":0,\"text\":\"\",\"interaction_id\":\"\",\"allow\":false,\"before\":0,\"expires_at_ms\":2,\"issued_at_ms\":1}",r[..]);
  // a read without an item is unchanged on the wire
  q:[1]EaRequest;q[0].nm=ea_copy(q[0].method[..],"ReadSession");q[0].nw=ea_copy(q[0].workspace[..],"default");n=ea_write(q[..],out[..]);found:=false;for i:0..<(ifx n>7 then n-7 else 0) {if cast(string)out[i..<i+7]=="item_id" {found=true;}}#assert n>0 && !found;
}
