// Deterministic #authority Secret & PII Redaction, Default-OFF Consent, and
// Objective Verifier-Label Admission Gate for Coding Trajectories (GitHub #13926).
//
// Hard invariants:
// - Default consent is strictly OFF (global AND workspace opt-in required).
// - Fail-closed secret gate: if any known secret signature survives redaction,
//   admission is refused atomically with the offending byte offset reported.
// - Objective verifier-label gate: trajectories lacking machine-verified
//   compiler, test, patch, or exact-replay outcomes are refused (never LLM summaries).
// - Held-out decontamination: any task/repo hash flagged as held-out is refused.
#authority;

RT_ADMIT :: 0;
RT_REFUSE_OPT_OUT :: 1;
RT_REFUSE_SECRET_LEAK :: 2;
RT_REFUSE_NO_VERIFIER :: 3;
RT_REFUSE_HELD_OUT :: 4;
RT_REFUSE_ATIF_UNVERIFIED :: 5;

RtAdmission :: struct {
  global_opt_in: bool;
  workspace_opt_in: bool;
  secret_clean: bool;
  has_compiler_verdict: bool;
  has_test_verdict: bool;
  has_patch_replay_verdict: bool;
  held_out_contaminated: bool;
  atif_verified: bool;
}

rt_is_tok_char :: (c: u8) -> bool #effects() {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.' || c == '/' || c == '+' || c == '=';
}

rt_is_path_char :: (c: u8) -> bool #effects() {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.';
}

rt_starts_at :: (s: string, pos: int, pat: string) -> bool #effects(reads, traps) {
  if pos < 0 || pos + pat.count > s.count { return false; }
  for i: 0..<pat.count {
    if s[pos + i] != pat[i] { return false; }
  }
  return true;
}

rt_copy :: (dst: [] u8, used: int, src: string) -> int #effects(reads, writes, traps) {
  if used < 0 || used + src.count > dst.count { return -1; }
  for i: 0..<src.count { dst[used + i] = src[i]; }
  return used + src.count;
}

// Returns the byte index of the first detected secret signature, or -1 if clean.
rt_find_secret :: (s: string) -> int #effects(reads, traps) {
  for i: 0..<s.count {
    if rt_starts_at(s, i, "AKIA") { return i; }
    if rt_starts_at(s, i, "sk-") { return i; }
    if rt_starts_at(s, i, "ghp_") { return i; }
    if rt_starts_at(s, i, "gho_") { return i; }
    if rt_starts_at(s, i, "github_pat_") { return i; }
    if rt_starts_at(s, i, "nsec1") { return i; }
    if rt_starts_at(s, i, "xprv") { return i; }
    if rt_starts_at(s, i, "Bearer ") { return i; }
    if rt_starts_at(s, i, "-----BEGIN ") { return i; }
    if rt_starts_at(s, i, "API_KEY=") { return i; }
    if rt_starts_at(s, i, "SECRET=") { return i; }
    if rt_starts_at(s, i, "PASSWORD=") { return i; }
    if rt_starts_at(s, i, "MNEMONIC=") { return i; }
  }
  return -1;
}

// Deterministically redacts secret tokens, PEM blocks, .env secrets, and host
// home paths (/Users/<user>/, /home/<user>/). Returns bytes written, or -1 on overflow.
rt_redact :: (src: string, dst: [] u8) -> int #effects(reads, writes, traps) {
  i := 0;
  used := 0;
  while i < src.count {
    if rt_starts_at(src, i, "-----BEGIN ") {
      j := i;
      while j < src.count && !rt_starts_at(src, j, "-----END ") { j += 1; }   // mutant: equivalent (j == src.count exits on next check; rt_starts_at bounds-checks)
      while j < src.count && src[j] != '\n' { j += 1; }
      used = rt_copy(dst, used, "[REDACTED_PEM]");
      if used < 0 { return -1; }   // mutant: equivalent (rt_copy returns >= 1 for non-empty replacement, -1 on overflow)
      i = j;
      continue;
    }
    if rt_starts_at(src, i, "AKIA") || rt_starts_at(src, i, "sk-") ||
       rt_starts_at(src, i, "ghp_") || rt_starts_at(src, i, "gho_") ||
       rt_starts_at(src, i, "github_pat_") || rt_starts_at(src, i, "nsec1") ||
       rt_starts_at(src, i, "xprv") {
      j := i;
      while j < src.count && rt_is_tok_char(src[j]) { j += 1; }
      used = rt_copy(dst, used, "[REDACTED_SECRET]");
      if used < 0 { return -1; }   // mutant: equivalent (rt_copy returns >= 1 for non-empty replacement, -1 on overflow)
      i = j;
      continue;
    }
    if rt_starts_at(src, i, "Bearer ") {
      j := i + 7;
      while j < src.count && rt_is_tok_char(src[j]) { j += 1; }
      used = rt_copy(dst, used, "[REDACTED_BEARER]");
      if used < 0 { return -1; }   // mutant: equivalent (rt_copy returns >= 1 for non-empty replacement, -1 on overflow)
      i = j;
      continue;
    }
    if rt_starts_at(src, i, "MNEMONIC=") {
      j := i + 9;
      while j < src.count && src[j] != '\n' && src[j] != '"' { j += 1; }
      used = rt_copy(dst, used, "[REDACTED_MNEMONIC]");
      if used < 0 { return -1; }   // mutant: equivalent (rt_copy returns >= 1 for non-empty replacement, -1 on overflow)
      i = j;
      continue;
    }
    if rt_starts_at(src, i, "API_KEY=") || rt_starts_at(src, i, "SECRET=") || rt_starts_at(src, i, "PASSWORD=") {
      j := i;
      while j < src.count && src[j] != '\n' && src[j] != ' ' && src[j] != '\t' { j += 1; }
      used = rt_copy(dst, used, "[REDACTED_ENV]");
      if used < 0 { return -1; }   // mutant: equivalent (rt_copy returns >= 1 for non-empty replacement, -1 on overflow)
      i = j;
      continue;
    }
    if rt_starts_at(src, i, "/Users/") || rt_starts_at(src, i, "/home/") {
      prefix_len := ifx src[i + 1] == 'U' then 7 else 6;
      j := i + prefix_len;
      while j < src.count && rt_is_path_char(src[j]) { j += 1; }
      used = rt_copy(dst, used, "~");
      if used < 0 { return -1; }   // mutant: equivalent (rt_copy returns >= 1 for non-empty replacement, -1 on overflow)
      i = j;
      continue;
    }
    if used >= dst.count { return -1; }
    dst[used] = src[i];
    used += 1;
    i += 1;
  }
  return used;
}

// #authority admission gate for redacted ATIF-v1.8 coding trajectories.
rt_admit_trajectory :: (a: RtAdmission) -> int #effects() {
  if !a.global_opt_in || !a.workspace_opt_in { return RT_REFUSE_OPT_OUT; }
  if !a.secret_clean { return RT_REFUSE_SECRET_LEAK; }
  if a.held_out_contaminated { return RT_REFUSE_HELD_OUT; }
  if !a.atif_verified { return RT_REFUSE_ATIF_UNVERIFIED; }
  if !a.has_compiler_verdict && !a.has_test_verdict && !a.has_patch_replay_verdict {
    return RT_REFUSE_NO_VERIFIER;
  }
  return RT_ADMIT;
}

rt_verdict_label :: (code: int) -> string #effects() {
  if code == RT_ADMIT { return "ADMITTED: opted-in, secret-clean, verifier-labeled, non-heldout"; }
  if code == RT_REFUSE_OPT_OUT { return "REFUSED: contribution is OFF by default (explicit opt-in required)"; }
  if code == RT_REFUSE_SECRET_LEAK { return "REFUSED: fail-closed secret gate detected unredacted secret"; }
  if code == RT_REFUSE_NO_VERIFIER { return "REFUSED: missing objective compiler/test/replay verifier verdict"; }
  if code == RT_REFUSE_HELD_OUT { return "REFUSED: blocked by held-out benchmark exposure ledger"; }
  if code == RT_REFUSE_ATIF_UNVERIFIED { return "REFUSED: ATIF-v1.8 steps_digest unverified"; }
  return "REFUSED: unknown admission code";
}

#test "redact-trajectory: adversarial secret suite, fail-closed gate, and #authority admission (#13926)" {
  // Adversarial secret-injection fixture covering AWS, OpenAI/Anthropic, GitHub, Nostr, Bitcoin, Bearer, PEM, .env, and host paths
  raw := "aws=AKIAIOSFODNN7EXAMPLE oai=sk-ant-12345 gh=ghp_abc123 gho=gho_xyz987 pat=github_pat_11AA nostr=nsec1qqqqqqqq btc=xprv9s21ZrQH auth=Bearer tok_999 API_KEY=supersecret SECRET=top PASSWORD=pw123 path=/Users/alice/work/repo home=/home/bob/src\n-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0\n-----END PRIVATE KEY-----\ndone";
  #assert rt_find_secret(raw) == 4;

  out: [1024] u8;
  n := rt_redact(raw, out[..]);
  #assert n > 0;
  redacted := cast(string) out[0..<n];
  // Fail-closed secret gate confirms ZERO secret signatures remain
  #assert rt_find_secret(redacted) == -1;

  // Verify exact redacted outputs for every token, env, PEM, and path family
  #assert rt_starts_at(redacted, 0, "aws=[REDACTED_SECRET]");
  #assert rt_starts_at("ab", 0, "ab");
  #assert !rt_starts_at("xb", 0, "ab");
  #assert !rt_starts_at(redacted, -1, "aws");
  #assert !rt_starts_at("ab", 0, "abc");

  b1: [128] u8;
  n1 := rt_redact("AKIA1 x", b1[..]);
  #assert n1 > 0 && cast(string) b1[0..<n1] == "[REDACTED_SECRET] x";
  n2 := rt_redact("Bearer a b", b1[..]);
  #assert n2 > 0 && cast(string) b1[0..<n2] == "[REDACTED_BEARER] b";
  n2b := rt_redact("Bearer  z", b1[..]);
  #assert n2b > 0 && cast(string) b1[0..<n2b] == "[REDACTED_BEARER] z";
  n3 := rt_redact("API_KEY=1\t2\nSECRET=a b", b1[..]);
  #assert n3 > 0 && cast(string) b1[0..<n3] == "[REDACTED_ENV]\t2\n[REDACTED_ENV] b";
  n4 := rt_redact("API_KEY=1\nok", b1[..]);
  #assert n4 > 0 && cast(string) b1[0..<n4] == "[REDACTED_ENV]\nok";
  n5 := rt_redact("/Users/alice/repo /home/bob/src", b1[..]);
  #assert n5 > 0 && cast(string) b1[0..<n5] == "~/repo ~/src";
  n5b := rt_redact("/Users//a /home//b", b1[..]);
  #assert n5b > 0 && cast(string) b1[0..<n5b] == "~/a ~/b";
  n6 := rt_redact("-----BEGIN KEY-----\na\n-----END KEY-----\nok", b1[..]);
  #assert n6 > 0 && cast(string) b1[0..<n6] == "[REDACTED_PEM]\nok";
  n7 := rt_redact("-----BEGIN KEY-----\nunterminated", b1[..]);
  #assert n7 > 0 && cast(string) b1[0..<n7] == "[REDACTED_PEM]";

  // rt_copy exact capacity and negative used boundaries
  exact2: [2] u8;
  #assert rt_copy(exact2[..], 0, "ab") == 2;
  #assert rt_copy(exact2[..], -1, "a") == -1;

  // Buffer overflow fails closed (-1)
  tiny: [4] u8;
  #assert rt_redact("AKIA1234", tiny[..]) == -1;
  #assert rt_redact("Bearer abc", tiny[..]) == -1;
  #assert rt_redact("API_KEY=1", tiny[..]) == -1;
  #assert rt_redact("-----BEGIN KEY-----\nx\n-----END KEY-----", tiny[..]) == -1;
  #assert rt_redact("/Users/a", tiny[0..<0]) == -1;
  #assert rt_redact("abcde", tiny[..]) == -1;

  // rt_find_secret detects each secret family individually
  #assert rt_find_secret("sk-123") == 0;
  #assert rt_find_secret("ghp_123") == 0;
  #assert rt_find_secret("gho_123") == 0;
  #assert rt_find_secret("github_pat_123") == 0;
  #assert rt_find_secret("nsec1abc") == 0;
  #assert rt_find_secret("xprv123") == 0;
  #assert rt_find_secret("Bearer tok") == 0;
  #assert rt_find_secret("-----BEGIN RSA") == 0;
  #assert rt_find_secret("API_KEY=x") == 0;
  #assert rt_find_secret("SECRET=x") == 0;
  #assert rt_find_secret("PASSWORD=x") == 0;
  #assert rt_find_secret("clean text") == -1;

  // Token and path char boundaries
  #assert rt_is_tok_char('a') && rt_is_tok_char('z') && rt_is_tok_char('A') && rt_is_tok_char('Z') && rt_is_tok_char('0') && rt_is_tok_char('9');
  #assert rt_is_tok_char('_') && rt_is_tok_char('-') && rt_is_tok_char('.') && rt_is_tok_char('/') && rt_is_tok_char('+') && rt_is_tok_char('=');
  #assert !rt_is_tok_char(' ') && !rt_is_tok_char('!') && !rt_is_tok_char('{') && !rt_is_tok_char('[') && !rt_is_tok_char(':');
  #assert rt_is_path_char('a') && rt_is_path_char('z') && rt_is_path_char('A') && rt_is_path_char('Z') && rt_is_path_char('0') && rt_is_path_char('9');
  #assert rt_is_path_char('_') && rt_is_path_char('-') && rt_is_path_char('.') && !rt_is_path_char('/') && !rt_is_path_char(' ') && !rt_is_path_char('{') && !rt_is_path_char('[') && !rt_is_path_char(':');

  // #authority admission gate
  good := RtAdmission.{
    global_opt_in = true,
    workspace_opt_in = true,
    secret_clean = true,
    has_compiler_verdict = true,
    has_test_verdict = false,
    has_patch_replay_verdict = false,
    held_out_contaminated = false,
    atif_verified = true
  };
  #assert rt_admit_trajectory(good) == RT_ADMIT;
  #assert rt_verdict_label(RT_ADMIT) == "ADMITTED: opted-in, secret-clean, verifier-labeled, non-heldout";

  // Alternative verifier verdicts (test or patch/replay) also admit
  t_only := good; t_only.has_compiler_verdict = false; t_only.has_test_verdict = true;
  #assert rt_admit_trajectory(t_only) == RT_ADMIT;
  p_only := good; p_only.has_compiler_verdict = false; p_only.has_patch_replay_verdict = true;
  #assert rt_admit_trajectory(p_only) == RT_ADMIT;

  // Default-OFF opt-out refuses (both global and workspace)
  no_g := good; no_g.global_opt_in = false;
  #assert rt_admit_trajectory(no_g) == RT_REFUSE_OPT_OUT;
  no_w := good; no_w.workspace_opt_in = false;
  #assert rt_admit_trajectory(no_w) == RT_REFUSE_OPT_OUT;
  #assert rt_verdict_label(RT_REFUSE_OPT_OUT) == "REFUSED: contribution is OFF by default (explicit opt-in required)";

  // Secret leak refuses
  leak := good; leak.secret_clean = false;
  #assert rt_admit_trajectory(leak) == RT_REFUSE_SECRET_LEAK;
  #assert rt_verdict_label(RT_REFUSE_SECRET_LEAK) == "REFUSED: fail-closed secret gate detected unredacted secret";

  // Held-out contamination refuses
  ho := good; ho.held_out_contaminated = true;
  #assert rt_admit_trajectory(ho) == RT_REFUSE_HELD_OUT;
  #assert rt_verdict_label(RT_REFUSE_HELD_OUT) == "REFUSED: blocked by held-out benchmark exposure ledger";

  // Unverified ATIF refuses
  ua := good; ua.atif_verified = false;
  #assert rt_admit_trajectory(ua) == RT_REFUSE_ATIF_UNVERIFIED;
  #assert rt_verdict_label(RT_REFUSE_ATIF_UNVERIFIED) == "REFUSED: ATIF-v1.8 steps_digest unverified";

  // Missing objective verifier (LLM summary only) refuses
  nv := good; nv.has_compiler_verdict = false;
  #assert rt_admit_trajectory(nv) == RT_REFUSE_NO_VERIFIER;
  #assert rt_verdict_label(RT_REFUSE_NO_VERIFIER) == "REFUSED: missing objective compiler/test/replay verifier verdict";

  #assert rt_verdict_label(99) == "REFUSED: unknown admission code";
}

#test "rt_redact strips BIP-39 12-word mnemonics cleanly and fails closed on overflow" {
  buf: [128] u8;
  s1 := "MNEMONIC=abandon ability able about above absent absorb abstract absurd abuse access accident\nok";
  #assert rt_find_secret(s1) == 0;
  n1 := rt_redact(s1, buf[..]);
  #assert n1 > 0 && cast(string) buf[0..<n1] == "[REDACTED_MNEMONIC]\nok" && rt_find_secret(cast(string) buf[0..<n1]) == -1;

  s2 := "{\"k\":\"MNEMONIC=zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo wrong\"}";
  n2 := rt_redact(s2, buf[..]);
  #assert n2 > 0 && cast(string) buf[0..<n2] == "{\"k\":\"[REDACTED_MNEMONIC]\"}" && rt_find_secret(cast(string) buf[0..<n2]) == -1;

  s3 := "MNEMONIC=\nok";
  n3 := rt_redact(s3, buf[..]);
  #assert n3 > 0 && cast(string) buf[0..<n3] == "[REDACTED_MNEMONIC]\nok";

  tiny: [4] u8;
  #assert rt_redact("MNEMONIC=one two", tiny[..]) == -1;
}
