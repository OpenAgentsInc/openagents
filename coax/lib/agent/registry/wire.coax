// Single JSON codec for openagents.agent.v1alpha1 (definition, invocation, barrier)
// (docs/apps/2026-11-20-simulated-tester-spec.md §4.2, GitHub #13891).
#load "../../json/json.coax";
#load "policy.coax";

AR_WIRE_BUF :: 16384;

ArDefRecord :: struct {
  agent_id: string;
  name: string;
  description: string;
  version: int;
  kind: string;
  execution_mode: string;
  runtime: string;
  input_contract: string;
  output_contract: string;
  max_depth: int;
  max_concurrency: int;
  budget: ArBudget;
  model_hint: string;
}

ArInvRecord :: struct {
  invocation_id: string;
  root_session_id: string;
  parent_invocation_id: string;
  agent_id: string;
  depth: int;
  target_kind: string;
  seat: string;
  device_lease: string;
  account_lease: string;
  workspace_dir: string;
  budget: ArBudget;
  seed: int;
  state: string;
  evidence_dir: string;
}

ArBarrierRecord :: struct {
  barrier_id: string;
  root_session_id: string;
  expected: int;
  arrived: int;
  deadline_ms: int;
  released: bool;
}

ar_w_byte :: (out: [] u8, pos: [] int, b: u8) -> bool {
  if pos[0] >= out.count { return false; }
  out[pos[0]] = b;
  pos[0] += 1;
  return true;
}

ar_w_raw :: (out: [] u8, pos: [] int, s: string) -> bool {
  for c: s { if !ar_w_byte(out, pos, c) { return false; } }
  return true;
}

ar_w_hex :: (n: int) -> u8 {
  if n < 10 { return cast(u8) (48 + n); }
  return cast(u8) (87 + n);
}

ar_w_str :: (out: [] u8, pos: [] int, s: string) -> bool {
  if !ar_w_byte(out, pos, cast(u8) 34) { return false; }
  for c: s {
    if c == 34 { if !ar_w_raw(out, pos, "\\\"") { return false; } }
    else if c == 92 { if !ar_w_raw(out, pos, "\\\\") { return false; } }
    else if c == 10 { if !ar_w_raw(out, pos, "\\n") { return false; } }
    else if c == 13 { if !ar_w_raw(out, pos, "\\r") { return false; } }
    else if c == 9 { if !ar_w_raw(out, pos, "\\t") { return false; } }
    else if c < 32 {
      if !ar_w_raw(out, pos, "\\u00") { return false; }
      if !ar_w_byte(out, pos, ar_w_hex(cast(int) (c / 16))) { return false; }
      if !ar_w_byte(out, pos, ar_w_hex(cast(int) (c % 16))) { return false; }
    } else {
      if !ar_w_byte(out, pos, c) { return false; }
    }
  }
  return ar_w_byte(out, pos, cast(u8) 34);
}

ar_w_int :: (out: [] u8, pos: [] int, v: int) -> bool {
  n := v;
  if n == 0 { return ar_w_byte(out, pos, cast(u8) 48); }
  if n < 0 {
    if !ar_w_byte(out, pos, cast(u8) 45) { return false; }
    n = -n;
  }
  digits: [24] u8;
  k := 0;
  while n > 0 && k < 24 {
    digits[k] = cast(u8) (48 + (n % 10));
    n = n / 10;
    k += 1;
  }
  while k > 0 {
    k -= 1;
    if !ar_w_byte(out, pos, digits[k]) { return false; }
  }
  return true;
}

ar_w_bool :: (out: [] u8, pos: [] int, v: bool) -> bool {
  return ar_w_raw(out, pos, ifx v then "true" else "false");
}

ar_write_def :: (d: ArDefRecord, out: [] u8) -> int {
  pos := [1] int.[0];
  ok := ar_w_raw(out, pos[..], "{\"schema\":\"openagents.agent.spec.v1\",\"agent_id\":")
    && ar_w_str(out, pos[..], d.agent_id)
    && ar_w_raw(out, pos[..], ",\"name\":") && ar_w_str(out, pos[..], d.name)
    && ar_w_raw(out, pos[..], ",\"description\":") && ar_w_str(out, pos[..], d.description)
    && ar_w_raw(out, pos[..], ",\"version\":") && ar_w_int(out, pos[..], d.version)
    && ar_w_raw(out, pos[..], ",\"kind\":") && ar_w_str(out, pos[..], d.kind)
    && ar_w_raw(out, pos[..], ",\"execution_mode\":") && ar_w_str(out, pos[..], d.execution_mode)
    && ar_w_raw(out, pos[..], ",\"runtime\":") && ar_w_str(out, pos[..], d.runtime)
    && ar_w_raw(out, pos[..], ",\"input_contract\":") && ar_w_str(out, pos[..], d.input_contract)
    && ar_w_raw(out, pos[..], ",\"output_contract\":") && ar_w_str(out, pos[..], d.output_contract)
    && ar_w_raw(out, pos[..], ",\"max_depth\":") && ar_w_int(out, pos[..], d.max_depth)
    && ar_w_raw(out, pos[..], ",\"max_concurrency\":") && ar_w_int(out, pos[..], d.max_concurrency)
    && ar_w_raw(out, pos[..], ",\"max_wall_ms\":") && ar_w_int(out, pos[..], d.budget.wall_ms)
    && ar_w_raw(out, pos[..], ",\"max_turns\":") && ar_w_int(out, pos[..], d.budget.turns)
    && ar_w_raw(out, pos[..], ",\"max_tokens\":") && ar_w_int(out, pos[..], d.budget.tokens)
    && ar_w_raw(out, pos[..], ",\"max_cost_usd_e6\":") && ar_w_int(out, pos[..], d.budget.cost_usd_e6)
    && ar_w_raw(out, pos[..], ",\"model_hint\":") && ar_w_str(out, pos[..], d.model_hint)
    && ar_w_raw(out, pos[..], "}");
  return ifx ok then pos[0] else -1;
}

ar_write_inv :: (v: ArInvRecord, out: [] u8) -> int {
  pos := [1] int.[0];
  ok := ar_w_raw(out, pos[..], "{\"schema\":\"openagents.agent.invocation.v1\",\"invocation_id\":")
    && ar_w_str(out, pos[..], v.invocation_id)
    && ar_w_raw(out, pos[..], ",\"root_session_id\":") && ar_w_str(out, pos[..], v.root_session_id)
    && ar_w_raw(out, pos[..], ",\"parent_invocation_id\":") && ar_w_str(out, pos[..], v.parent_invocation_id)
    && ar_w_raw(out, pos[..], ",\"agent_id\":") && ar_w_str(out, pos[..], v.agent_id)
    && ar_w_raw(out, pos[..], ",\"depth\":") && ar_w_int(out, pos[..], v.depth)
    && ar_w_raw(out, pos[..], ",\"target_kind\":") && ar_w_str(out, pos[..], v.target_kind)
    && ar_w_raw(out, pos[..], ",\"seat\":") && ar_w_str(out, pos[..], v.seat)
    && ar_w_raw(out, pos[..], ",\"device_lease\":") && ar_w_str(out, pos[..], v.device_lease)
    && ar_w_raw(out, pos[..], ",\"account_lease\":") && ar_w_str(out, pos[..], v.account_lease)
    && ar_w_raw(out, pos[..], ",\"workspace_dir\":") && ar_w_str(out, pos[..], v.workspace_dir)
    && ar_w_raw(out, pos[..], ",\"max_wall_ms\":") && ar_w_int(out, pos[..], v.budget.wall_ms)
    && ar_w_raw(out, pos[..], ",\"seed\":") && ar_w_int(out, pos[..], v.seed)
    && ar_w_raw(out, pos[..], ",\"state\":") && ar_w_str(out, pos[..], v.state)
    && ar_w_raw(out, pos[..], ",\"evidence_dir\":") && ar_w_str(out, pos[..], v.evidence_dir)
    && ar_w_raw(out, pos[..], "}");
  return ifx ok then pos[0] else -1;
}

ar_write_barrier :: (b: ArBarrierRecord, out: [] u8) -> int {
  pos := [1] int.[0];
  ok := ar_w_raw(out, pos[..], "{\"schema\":\"openagents.agent.barrier.v1\",\"barrier_id\":")
    && ar_w_str(out, pos[..], b.barrier_id)
    && ar_w_raw(out, pos[..], ",\"root_session_id\":") && ar_w_str(out, pos[..], b.root_session_id)
    && ar_w_raw(out, pos[..], ",\"expected\":") && ar_w_int(out, pos[..], b.expected)
    && ar_w_raw(out, pos[..], ",\"arrived\":") && ar_w_int(out, pos[..], b.arrived)
    && ar_w_raw(out, pos[..], ",\"deadline_ms\":") && ar_w_int(out, pos[..], b.deadline_ms)
    && ar_w_raw(out, pos[..], ",\"released\":") && ar_w_bool(out, pos[..], b.released)
    && ar_w_raw(out, pos[..], "}");
  return ifx ok then pos[0] else -1;
}

#test "agent registry wire writes valid JSON for definition, invocation, and barrier" {
  buf: [AR_WIRE_BUF] u8;
  sb: [256] u8;
  nodes: [128] JvNode;
  doc: [1] Jv;

  d := ArDefRecord.{
    agent_id = "desktop-journey-tester", name = "Desktop Journey Tester",
    description = "Drives OpenAgents Desktop through deterministic journeys",
    version = 1, kind = "tester", execution_mode = "deterministic",
    runtime = "coax-tool:apps/shared/tester/cli.coax",
    input_contract = "tester.run_request.v1", output_contract = "tester.result.v1",
    max_depth = 2, max_concurrency = 4,
    budget = ArBudget.{wall_ms = 180000, turns = 0, tokens = 0, cost_usd_e6 = 0},
    model_hint = ""
  };
  n := ar_write_def(d, buf[..]);
  #assert n > 0;
  #assert jv_parse(doc[..], cast(string) buf[0..<n], nodes[..]);
  sn := jv_str(doc[0], jv_get(doc[0], 0, "schema"), sb[..]);
  #assert sn > 0 && cast(string) sb[0..<sn] == "openagents.agent.spec.v1";
  kn := jv_str(doc[0], jv_get(doc[0], 0, "kind"), sb[..]);
  #assert kn > 0 && ar_kind_of(cast(string) sb[0..<kn]) == AR_KIND_TESTER;
  mn := jv_str(doc[0], jv_get(doc[0], 0, "execution_mode"), sb[..]);
  #assert mn > 0 && ar_mode_of(cast(string) sb[0..<mn]) == AR_MODE_DETERMINISTIC;

  inv := ArInvRecord.{
    invocation_id = "inv-1", root_session_id = "sess-1", parent_invocation_id = "",
    agent_id = "desktop-journey-tester", depth = 0, target_kind = "desktop-mac",
    seat = "desktop-client", device_lease = "mac-local", account_lease = "",
    workspace_dir = "/tmp/oa-test", budget = d.budget, seed = 42, state = "running",
    evidence_dir = "/tmp/oa-test/out"
  };
  ni := ar_write_inv(inv, buf[..]);
  #assert ni > 0;
  #assert jv_parse(doc[..], cast(string) buf[0..<ni], nodes[..]);
  s_inv := jv_str(doc[0], jv_get(doc[0], 0, "schema"), sb[..]);
  #assert s_inv > 0 && cast(string) sb[0..<s_inv] == "openagents.agent.invocation.v1";

  bar := ArBarrierRecord.{
    barrier_id = "bar-1", root_session_id = "sess-1", expected = 2, arrived = 2,
    deadline_ms = 10000, released = true
  };
  nb := ar_write_barrier(bar, buf[..]);
  #assert nb > 0;
  #assert jv_parse(doc[..], cast(string) buf[0..<nb], nodes[..]);
  sbn := jv_str(doc[0], jv_get(doc[0], 0, "schema"), sb[..]);
  #assert sbn > 0 && cast(string) sb[0..<sbn] == "openagents.agent.barrier.v1";
}
