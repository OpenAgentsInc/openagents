// Single JSON codec for openagents.agent.v1alpha1 (spec, invocation, barrier)
// (docs/apps/2026-11-20-simulated-tester-spec.md §4.2, GitHub #13891).
#load "../../json/json.coax";
#load "policy.coax";

AR_WIRE_BUF :: 16384;

ArDefRecord :: struct {
  agent_id: string;
  name: string;
  description: string;
  version: int;
  kind: string;
  execution_mode: string;
  runtime: string;
  input_contract: string;
  output_contract: string;
  max_depth: int;
  max_concurrency: int;
  budget: ArBudget;
  model_hint: string;
}

ArInvRecord :: struct {
  invocation_id: string;
  root_session_id: string;
  parent_invocation_id: string;
  agent_id: string;
  depth: int;
  target_kind: string;
  seat: string;
  device_lease: string;
  account_lease: string;
  workspace_dir: string;
  budget: ArBudget;
  seed: int;
  state: string;
  evidence_dir: string;
}

ArBarrierRecord :: struct {
  barrier_id: string;
  root_session_id: string;
  expected: int;
  arrived: int;
  deadline_ms: int;
  released: bool;
}

ar_write_def :: (d: ArDefRecord, out: [] u8) -> int {
  j: [1] Jo;
  jo_start(j[..], out);
  jo_obj(j[..]);
  jo_key(j[..], "schema"); jo_str(j[..], "openagents.agent.spec.v1");
  jo_key(j[..], "agent_id"); jo_str(j[..], d.agent_id);
  jo_key(j[..], "name"); jo_str(j[..], d.name);
  jo_key(j[..], "description"); jo_str(j[..], d.description);
  jo_key(j[..], "version"); jo_int(j[..], d.version);
  jo_key(j[..], "kind"); jo_str(j[..], d.kind);
  jo_key(j[..], "execution_mode"); jo_str(j[..], d.execution_mode);
  jo_key(j[..], "runtime"); jo_str(j[..], d.runtime);
  jo_key(j[..], "input_contract"); jo_str(j[..], d.input_contract);
  jo_key(j[..], "output_contract"); jo_str(j[..], d.output_contract);
  jo_key(j[..], "max_depth"); jo_int(j[..], d.max_depth);
  jo_key(j[..], "max_concurrency"); jo_int(j[..], d.max_concurrency);
  jo_key(j[..], "max_wall_ms"); jo_int(j[..], d.budget.wall_ms);
  jo_key(j[..], "max_turns"); jo_int(j[..], d.budget.turns);
  jo_key(j[..], "max_tokens"); jo_int(j[..], d.budget.tokens);
  jo_key(j[..], "max_cost_usd_e6"); jo_int(j[..], d.budget.cost_usd_e6);
  jo_key(j[..], "model_hint"); jo_str(j[..], d.model_hint);
  jo_end(j[..]);
  return ifx j[0].bad then -1 else j[0].n;
}

ar_write_inv :: (v: ArInvRecord, out: [] u8) -> int {
  j: [1] Jo;
  jo_start(j[..], out);
  jo_obj(j[..]);
  jo_key(j[..], "schema"); jo_str(j[..], "openagents.agent.invocation.v1");
  jo_key(j[..], "invocation_id"); jo_str(j[..], v.invocation_id);
  jo_key(j[..], "root_session_id"); jo_str(j[..], v.root_session_id);
  jo_key(j[..], "parent_invocation_id"); jo_str(j[..], v.parent_invocation_id);
  jo_key(j[..], "agent_id"); jo_str(j[..], v.agent_id);
  jo_key(j[..], "depth"); jo_int(j[..], v.depth);
  jo_key(j[..], "target_kind"); jo_str(j[..], v.target_kind);
  jo_key(j[..], "seat"); jo_str(j[..], v.seat);
  jo_key(j[..], "device_lease"); jo_str(j[..], v.device_lease);
  jo_key(j[..], "account_lease"); jo_str(j[..], v.account_lease);
  jo_key(j[..], "workspace_dir"); jo_str(j[..], v.workspace_dir);
  jo_key(j[..], "max_wall_ms"); jo_int(j[..], v.budget.wall_ms);
  jo_key(j[..], "seed"); jo_int(j[..], v.seed);
  jo_key(j[..], "state"); jo_str(j[..], v.state);
  jo_key(j[..], "evidence_dir"); jo_str(j[..], v.evidence_dir);
  jo_end(j[..]);
  return ifx j[0].bad then -1 else j[0].n;
}

ar_write_barrier :: (b: ArBarrierRecord, out: [] u8) -> int {
  j: [1] Jo;
  jo_start(j[..], out);
  jo_obj(j[..]);
  jo_key(j[..], "schema"); jo_str(j[..], "openagents.agent.barrier.v1");
  jo_key(j[..], "barrier_id"); jo_str(j[..], b.barrier_id);
  jo_key(j[..], "root_session_id"); jo_str(j[..], b.root_session_id);
  jo_key(j[..], "expected"); jo_int(j[..], b.expected);
  jo_key(j[..], "arrived"); jo_int(j[..], b.arrived);
  jo_key(j[..], "deadline_ms"); jo_int(j[..], b.deadline_ms);
  jo_key(j[..], "released"); jo_bool(j[..], b.released);
  jo_end(j[..]);
  return ifx j[0].bad then -1 else j[0].n;
}

#test "agent registry wire writes valid JSON and refuses overflow" {
  buf: [AR_WIRE_BUF] u8;
  tiny: [8] u8;
  sb: [256] u8;
  nodes: [128] JvNode;
  doc: [1] Jv;

  d := ArDefRecord.{
    agent_id = "desktop-journey-tester", name = "Desktop Journey Tester",
    description = "Drives OpenAgents Desktop through deterministic journeys",
    version = 1, kind = "tester", execution_mode = "deterministic",
    runtime = "coax-tool:apps/shared/tester/cli.coax",
    input_contract = "tester.run_request.v1", output_contract = "tester.result.v1",
    max_depth = 2, max_concurrency = 4,
    budget = ArBudget.{wall_ms = 180000, turns = 0, tokens = 0, cost_usd_e6 = 0},
    model_hint = ""
  };
  #assert ar_write_def(d, tiny[..]) == -1;
  n := ar_write_def(d, buf[..]);
  #assert n > 0;
  #assert jv_parse(doc[..], cast(string) buf[0..<n], nodes[..]);
  sn := jv_str(doc[0], jv_get(doc[0], 0, "schema"), sb[..]);
  #assert sn > 0 && cast(string) sb[0..<sn] == "openagents.agent.spec.v1";
  kn := jv_str(doc[0], jv_get(doc[0], 0, "kind"), sb[..]);
  #assert kn > 0 && ar_kind_of(cast(string) sb[0..<kn]) == AR_KIND_TESTER;
  mn := jv_str(doc[0], jv_get(doc[0], 0, "execution_mode"), sb[..]);
  #assert mn > 0 && ar_mode_of(cast(string) sb[0..<mn]) == AR_MODE_DETERMINISTIC;

  inv := ArInvRecord.{
    invocation_id = "inv-1", root_session_id = "sess-1", parent_invocation_id = "",
    agent_id = "desktop-journey-tester", depth = 0, target_kind = "desktop-mac",
    seat = "desktop-client", device_lease = "mac-local", account_lease = "",
    workspace_dir = "/tmp/oa-test", budget = d.budget, seed = 42, state = "running",
    evidence_dir = "/tmp/oa-test/out"
  };
  #assert ar_write_inv(inv, tiny[..]) == -1;
  ni := ar_write_inv(inv, buf[..]);
  #assert ni > 0;
  #assert jv_parse(doc[..], cast(string) buf[0..<ni], nodes[..]);
  s_inv := jv_str(doc[0], jv_get(doc[0], 0, "schema"), sb[..]);
  #assert s_inv > 0 && cast(string) sb[0..<s_inv] == "openagents.agent.invocation.v1";

  bar := ArBarrierRecord.{
    barrier_id = "bar-1", root_session_id = "sess-1", expected = 2, arrived = 2,
    deadline_ms = 10000, released = true
  };
  #assert ar_write_barrier(bar, tiny[..]) == -1;
  nb := ar_write_barrier(bar, buf[..]);
  #assert nb > 0;
  #assert jv_parse(doc[..], cast(string) buf[0..<nb], nodes[..]);
  sbn := jv_str(doc[0], jv_get(doc[0], 0, "schema"), sb[..]);
  #assert sbn > 0 && cast(string) sb[0..<sbn] == "openagents.agent.barrier.v1";
}
