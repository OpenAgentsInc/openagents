// The delegation router's labelled set (docs/router/README.md, "Getting
// better"): tasks with what the decision model should answer about each and,
// for some, what should run. fixtures/labels.tsv holds them, one a line:
//
//   id  current  summary  want  task          (tab-separated; "-" for none)
//
//   current  the conversation's computer and agent, "mac/claude"
//   summary  the conversation so far
//   want     what is held, "key=value,key=value". A key is a question
//            (engine, needs, named_engine, named_station, named_depth,
//            continue, difficulty, weight, effort, station_ENGINE) and its
//            value the answer; or run_engine or run_station, and its value
//            what runs. "a|b" takes either.
//
// The computers are fixtures/stations.json. A row is scored against a
// finished decision: each want is right or wrong. The set measures the
// questions' wording against a door. It says nothing about which agent
// writes the better patch.
#load "decide.coax";

RTREV_ROWS :: 256;

RtrevRow :: struct { id: string; current: string; summary: string; want: string; task: string; }

// Field k (from 0) of a tab-separated line.
rtrev_field :: (line: string, k: int) -> string {
  at := 0; f := 0;
  while at <= line.count {
    e := at; while e < line.count && line[e] != 9 { e += 1; }
    if f == k { return cast(string) line[at..<e]; }
    at = e + 1; f += 1;
  }
  return "";
}

// The rows of a labels file (its first line is the header): how many, or -1
// for a line without five fields or more rows than fit.
rtrev_rows :: (text: string, rows: [] RtrevRow) -> int {
  n := 0; at := 0; first := true;
  while at < text.count {
    e := at; while e < text.count && text[e] != 10 { e += 1; }
    line := cast(string) text[at..<e]; at = e + 1;
    if first { first = false; continue; }
    if line.count == 0 { continue; }
    r := RtrevRow.{id = rtrev_field(line, 0), current = rtrev_field(line, 1), summary = rtrev_field(line, 2), want = rtrev_field(line, 3), task = rtrev_field(line, 4)};
    if r.id.count == 0 || r.want.count == 0 || r.task.count == 0 || n == rows.count { return -1; }
    rows[n] = r; n += 1;
  }
  return n;
}

// The row as the request's task and conversation.
rtrev_apply :: (q: [] RtrRequest, r: RtrevRow) {
  q[0].text = r.task;
  q[0].summary = ifx r.summary == "-" then "" else r.summary;
  q[0].current_station = ""; q[0].current_engine = ""; q[0].current_model = "";
  if r.current != "-" {
    slash := 0; while slash < r.current.count && r.current[slash] != '/' { slash += 1; }
    q[0].current_station = cast(string) r.current[0..<slash];
    if slash < r.current.count { q[0].current_engine = cast(string) r.current[slash + 1..<r.current.count]; }
  }
}

// What a decision holds for a want's key: an answer's choice, or what runs. "" for none.
rtrev_got :: (d: [] RtrDecision, key: string) -> string {
  if key == "run_engine" { return d[0].engine; }
  if key == "run_station" { return d[0].station; }
  for i: 0..<d[0].nanswers { if d[0].answers[i].key == key { return d[0].answers[i].choice; } }
  return "";
}

// Whether got is one of want's alternatives ("a|b").
rtrev_match :: (want: string, got: string) -> bool {
  at := 0;
  while at <= want.count {
    e := at; while e < want.count && want[e] != '|' { e += 1; }
    if cast(string) want[at..<e] == got { return true; }
    at = e + 1;
  }
  return false;
}

RtrevScore :: struct { wants: int; right: int; }

// Scores d against a row's wants. miss receives the first want that is wrong
// as "key=want (got X)", "" when all are right.
rtrev_score :: (d: [] RtrDecision, want: string, miss: [] u8, nmiss: [] int) -> RtrevScore {
  s: RtrevScore; nmiss[0] = 0;
  at := 0;
  while at < want.count {
    e := at; while e < want.count && want[e] != ',' { e += 1; }
    eq := at; while eq < e && want[eq] != '=' { eq += 1; }
    if eq < e {
      key := cast(string) want[at..<eq]; value := cast(string) want[eq + 1..<e];
      got := rtrev_got(d, key);
      s.wants += 1;
      if rtrev_match(value, got) { s.right += 1; }
      else if nmiss[0] == 0 {
        n := rtr_put(miss, 0, key); n = rtr_put(miss, n, "="); n = rtr_put(miss, n, value); n = rtr_put(miss, n, " (got ");
        n = rtr_put(miss, n, ifx got.count > 0 then got else "nothing"); n = rtr_put(miss, n, ")");
        nmiss[0] = n;
      }
    }
    at = e + 1;
  }
  return s;
}

// DIR/ID SUFFIX as a path.
rtrev_path :: (dir: string, id: string, suffix: string, out: [] u8) -> string {
  n := rtr_put(out, 0, dir);
  if n > 0 && out[n - 1] != '/' { n = rtr_put(out, n, "/"); }
  n = rtr_put(out, n, id); n = rtr_put(out, n, suffix);
  return cast(string) out[0..<n];
}
// That file's bytes without its last line end; "" when it can't be read.
rtrev_file :: (dir: string, id: string, suffix: string, out: [] u8) -> string {
  pb: [1024] u8;
  k := fs_read(rtrev_path(dir, id, suffix, pb[..]), out);
  if k <= 0 || k >= out.count { return ""; }
  while k > 0 && (out[k - 1] == 10 || out[k - 1] == 13) { k -= 1; }
  return cast(string) out[0..<k];
}

// One row decided from the exchange recorded in dir (ID.request.json as it
// was sent, ID.answer.json as it came back): "" when d is decided, else what
// is wrong. The request written now must be the recorded one byte for byte,
// and the answer must hold to it as a live one must.
rtrev_replay :: (dir: string, q: [] RtrRequest, e: [] RtrEligible, r: RtrevRow, d: [] RtrDecision, w: [] RtrWork, sent: [] u8, got: [] u8, ar: [] ClArena) -> string {
  rtrev_apply(q, r);
  request := rtr_begin(q, e, d, w, "replay");
  if request.count == 0 { return "the request can't be written"; }
  recorded := rtrev_file(dir, r.id, ".request.json", sent);
  if recorded.count == 0 { return "no recorded request"; }
  if request != recorded { return "the request is not the one that was sent"; }
  answer := rtrev_file(dir, r.id, ".answer.json", got);
  if answer.count == 0 { return "no recorded answer"; }
  gr := gd_result(w[0].body[..], ar, 200, answer);
  if gr.problem.count > 0 { return "the recorded answer does not hold to its request"; }
  rtr_finish(q, e, gr, d, w);
  return "";
}

#test "a labels file reads into rows; a short line is refused" {
  rows: [4] RtrevRow;
  text := "id\tcurrent\tsummary\twant\ttask\ntypo\t-\t-\tengine=codex,needs=none\tFix the typo\n\nfollow\tmac/claude\tWe renamed it.\tcontinue=yes\tNow the help text\n";
  #assert rtrev_rows(text, rows[..]) == 2 && rows[0].id == "typo" && rows[0].current == "-" && rows[0].want == "engine=codex,needs=none" && rows[0].task == "Fix the typo";
  #assert rows[1].current == "mac/claude" && rows[1].summary == "We renamed it." && rows[1].task == "Now the help text";
  #assert rtrev_rows("h\nonly\ttwo\n", rows[..]) == -1 && rtrev_rows("h\n", rows[..]) == 0 && rtrev_rows(text, rows[0..<1]) == -1;
  #assert rtrev_field("a\tb\t\td", 2) == "" && rtrev_field("a\tb\t\td", 3) == "d" && rtrev_field("a", 1) == "";
  q: [1] RtrRequest;
  rtrev_apply(q[..], rows[1]);
  #assert q[0].text == "Now the help text" && q[0].summary == "We renamed it." && q[0].current_station == "mac" && q[0].current_engine == "claude";
  rtrev_apply(q[..], rows[0]);
  #assert q[0].summary == "" && q[0].current_station == "" && q[0].current_engine == "";
}

#test "a decision is scored want by want, with alternatives and the first miss" {
  d: [1] RtrDecision; miss: [128] u8; nm: [1] int;
  rtr_decision_clear(d[..]); d[0].engine = "claude"; d[0].station = "mac";
  rtr_answer(d[..], "engine", "codex", -1, 900); rtr_answer(d[..], "difficulty", "hard", 3, 600); rtr_answer(d[..], "needs", "none", -1, 900);
  s := rtrev_score(d[..], "engine=codex,difficulty=hard|very hard,run_engine=claude,run_station=mac", miss[..], nm[..]);
  #assert s.wants == 4 && s.right == 4 && nm[0] == 0;
  s = rtrev_score(d[..], "engine=claude,needs=apple,continue=yes", miss[..], nm[..]);
  #assert s.wants == 3 && s.right == 0 && cast(string) miss[0..<nm[0]] == "engine=claude (got codex)";
  s = rtrev_score(d[..], "continue=yes", miss[..], nm[..]);
  #assert s.right == 0 && cast(string) miss[0..<nm[0]] == "continue=yes (got nothing)";
  #assert rtrev_match("a|b", "b") && rtrev_match("a", "a") && !rtrev_match("a|b", "c") && !rtrev_match("a|b", "");
}

// ---- v2alpha1 System One Front labelled eval & replay (#14056)

// Apply a labels-v2 row to a default full-capability RoutePlanRequest.
// current format: "-" or "pack/tier" (e.g. "coder/cloud_deep", "wallet/local_inkling").
rtrev2_apply :: (q: [] Rtr2PlanRequest, r: RtrevRow) {
  q[0] = Rtr2PlanRequest.{
    text = r.task,
    summary = ifx r.summary == "-" then "" else r.summary,
    local_inkling_ready = true,
    cloud_ready = true,
    remote_station_ready = true,
    user_compute_pref = "auto"
  };
  q[0].available_delegates[0] = "claude";
  q[0].available_delegates[1] = "codex";
  q[0].available_delegates[2] = "antigravity";
  q[0].available_delegates[3] = "cursor";
  q[0].navailable_delegates = 4;
  if r.current != "-" {
    slash := 0; while slash < r.current.count && r.current[slash] != '/' { slash += 1; }
    pk := cast(string) r.current[0..<slash];
    if pk.count > 0 { q[0].active_packs[0] = pk; q[0].nactive_packs = 1; }
    if slash < r.current.count { q[0].active_compute_tier = cast(string) r.current[slash + 1..<r.current.count]; }
  }
}

rtrev2_got :: (p: [] Rtr2Plan, key: string) -> string {
  if key == "pack" { return ifx p[0].npacks > 0 then p[0].capability_packs[0] else ""; }
  if key == "tier" { return p[0].compute_tier; }
  if key == "delegate" { return p[0].explicit_delegate; }
  if key == "continue" { return ifx p[0].continue_active then "yes" else "no"; }
  if key == "missing" { return ifx p[0].missing_capability_hint.count > 0 then "yes" else "no"; }
  if key == "missing_hint" { return p[0].missing_capability_hint; }
  if key == "effort" { return p[0].effort; }
  for i: 0..<p[0].nanswers { if p[0].answers[i].key == key { return p[0].answers[i].choice; } }
  return "";
}

rtrev2_score :: (p: [] Rtr2Plan, want: string, miss: [] u8, nmiss: [] int) -> RtrevScore {
  s: RtrevScore; nmiss[0] = 0;
  at := 0;
  while at < want.count {
    e := at; while e < want.count && want[e] != ',' { e += 1; }
    eq := at; while eq < e && want[eq] != '=' { eq += 1; }
    if eq < e {
      key := cast(string) want[at..<eq]; value := cast(string) want[eq + 1..<e];
      got := rtrev2_got(p, key);
      s.wants += 1;
      if rtrev_match(value, got) { s.right += 1; }
      else if nmiss[0] == 0 {
        n := rtr_put(miss, 0, key); n = rtr_put(miss, n, "="); n = rtr_put(miss, n, value); n = rtr_put(miss, n, " (got ");
        n = rtr_put(miss, n, ifx got.count > 0 then got else "nothing"); n = rtr_put(miss, n, ")");
        nmiss[0] = n;
      }
    }
    at = e + 1;
  }
  return s;
}

rtrev2_replay :: (dir: string, q: [] Rtr2PlanRequest, e: [] Rtr2Eligible, r: RtrevRow, p: [] Rtr2Plan, w: [] Rtr2Work, sent: [] u8, got: [] u8, ar: [] ClArena) -> string {
  rtrev2_apply(q, r);
  request := rtr2_begin(q, e, p, w, "replay");
  if request.count == 0 { return "the request can't be written"; }
  recorded := rtrev_file(dir, r.id, ".request.json", sent);
  if recorded.count == 0 { return "no recorded request"; }
  if request != recorded { return "the request is not the one that was sent"; }
  answer := rtrev_file(dir, r.id, ".answer.json", got);
  if answer.count == 0 { return "no recorded answer"; }
  gr := gd_result(w[0].body[..], ar, 200, answer);
  if gr.problem.count > 0 { return "the recorded answer does not hold to its request"; }
  rtr2_finish(q, e, gr, p, w);
  return "";
}

#test "v2 eval: applies rows and scores RoutePlan wants" {
  q: [1] Rtr2PlanRequest; p: [1] Rtr2Plan; miss: [128] u8; nm: [1] int;
  row := RtrevRow.{id = "w1", current = "coder/cloud_deep", summary = "Fixing tests", want = "pack=coder,tier=cloud_deep,delegate=none,continue=yes,missing=no", task = "Now run the test suite"};
  rtrev2_apply(q[..], row);
  #assert q[0].nactive_packs == 1 && q[0].active_packs[0] == "coder" && q[0].active_compute_tier == "cloud_deep";
  rtr2_plan_clear(p[..]);
  p[0].ok = true; rtr2_plan_add_pack(p[..], "coder"); p[0].compute_tier = "cloud_deep"; p[0].explicit_delegate = "none"; p[0].continue_active = true;
  s := rtrev2_score(p[..], row.want, miss[..], nm[..]);
  #assert s.wants == 5 && s.right == 5 && nm[0] == 0;
}
