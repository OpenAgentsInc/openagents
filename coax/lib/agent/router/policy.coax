// The delegation router's rules in code (docs/router/README.md, "Code decides
// what is possible; the model decides among it"). Two steps, both pure:
//
//   rtr_eligible  which computers may take new work and which coding agents
//                 can run on each, from the request's facts, with the one
//                 fact that ruled each other one out. Numbers are compared
//                 here, never by the model.
//   rtr_pick      what runs, from the eligible sets and the decision model's
//                 answers (RtrAnswers; has is false when no door answered).
//
// What rtr_pick holds to, whatever the model answers:
//
//   - What runs is an eligible agent on an eligible computer that has that
//     agent, takes work of the task's weight, and has what the task needs (a
//     Mac that builds for Apple platforms, a GPU, or the conversation's own
//     computer).
//   - The agent, in this order: the one the person named, when it is
//     eligible; the conversation's, while the message continues the same
//     work; the model's answer, when it is sure (RTR_SURE_MILLI); else the
//     most capable eligible one.
//   - The computer, in the same order: the one the person named; the
//     conversation's; the model's answer for the agent that runs; else the
//     one with the most room.
//   - When no computer can run that agent for this task, the most capable
//     agent that some computer can run takes it, and the decision says so.
//   - With no answer, the conversation's agent and computer are kept, else
//     the defaults run, and the work is taken to be heavy.
//
// #authority policy for both v1alpha1 station routing and v2alpha1 System One
// Front RoutePlan routing (#14056).
#authority;
#load "test-fixtures.coax";
#load "../engine/route-policy.coax";   // cr_model: the model profile for a difficulty

RTR_FRESH_MS :: 120000;     // a report older than two minutes: the computer is not reachable
RTR_SURE_MILLI :: 500;      // below this probability the default runs
RTR_HEAVY :: 2;             // the weight a "nothing heavy" computer refuses
RTR_EFFORT_NAMES :: [3] string.["low", "medium", "high"];
RTR_LEVEL_NAMES :: [5] string.["trivial", "easy", "moderate", "hard", "very hard"];
RTR_WEIGHT_NAMES :: [3] string.["light", "medium", "heavy"];
RTR_NEED_NONE :: 0; RTR_NEED_APPLE :: 1; RTR_NEED_GPU :: 2; RTR_NEED_THIS :: 3;
RTR_NEED_NAMES :: [4] string.["none", "apple", "gpu", "this_computer"];
RTR_DEPTH_NONE :: 0; RTR_DEPTH_FASTER :: 1; RTR_DEPTH_CAREFUL :: 2;
RTR_DEPTH_NAMES :: [3] string.["none", "faster", "more_careful"];

RtrEligible :: struct {
  station: [RTR_STATIONS] bool;                 // may take new work, and an agent can run there
  pair: [RTR_STATIONS * RTR_ENGINES] bool;       // [station * RTR_ENGINES + engine]: that agent can run on that eligible computer
  engine: [RTR_ENGINES] bool;                   // it can run on at least one eligible computer
  nstations: int;
  nengines: int;
}

// What the decision model answered, as indexes. A question that was not
// asked, or an answer that names nothing known, is -1.
RtrAnswers :: struct {
  has: bool;                               // a door answered
  engine: int;                             // ca_index
  engine_milli: int;
  station_for: [RTR_ENGINES] int;          // the computer if that agent takes the task: a row of the request
  station_for_milli: [RTR_ENGINES] int;
  difficulty: int;                         // 0 to 4
  effort: int;                             // 0 to 2
  weight: int;                             // 0 to 2
  needs: int;                              // RTR_NEED_
  named_station: int;                      // the computer the person asked for: a row; -1 for none
  named_station_milli: int;
  named_engine: int;                       // the agent the person asked for: ca_index; -1 for none
  named_engine_milli: int;
  depth: int;                              // RTR_DEPTH_
  depth_milli: int;
  continue_milli: int;                     // P(the message continues the conversation's work); -1 when not asked
}

rtr_no_answers :: () -> RtrAnswers #effects(all) {
  a := RtrAnswers.{engine = -1, difficulty = -1, effort = -1, weight = -1, needs = -1, named_station = -1, named_engine = -1, depth = -1, continue_milli = -1};
  for k: 0..<RTR_ENGINES { a.station_for[k] = -1; }
  return a;
}

// "" when the computer in row i may take new work, else the one fact that
// rules it out.
rtr_station_fact :: (q: [] RtrRequest, i: int) -> string #effects(all) {
  at := q[0].stations[i].reported_at_ms; now := q[0].now_ms;
  if at <= 0 || now < at || now - at > RTR_FRESH_MS { return "not_reachable"; }
  if q[0].stations[i].keep_clear { return "keep_clear"; }
  if q[0].stations[i].disk_free_mb < q[0].stations[i].disk_floor_mb { return "disk_below_floor"; }
  if q[0].stations[i].max_agents > 0 && q[0].stations[i].work >= q[0].stations[i].max_agents { return "at_agent_limit"; }
  return "";
}

// "" when the agent can take work, else the one fact that rules it out.
rtr_agent_fact :: (a: RtrAgent) -> string #effects(all) {
  if !a.reported || !a.installed { return "not_installed"; }
  if !a.logged_in { return "logged_out"; }
  if a.quota_used_up { return "quota_used_up"; }
  if a.cooldown { return "cooldown"; }
  return "";
}

// Fills e, and d's eligible lists and blocked list.
rtr_eligible :: (q: [] RtrRequest, e: [] RtrEligible, d: [] RtrDecision) #effects(all) {
  e[0] = RtrEligible.{};
  names := RTR_ENGINE_NAMES;
  for i: 0..<q[0].n {
    fact := rtr_station_fact(q, i);
    if fact.count > 0 { rtr_block(d, q[0].stations[i].id, "", fact); continue; } // mutant: equivalent (every non-empty fact string has count >= 9)
    any := false;
    for k: 0..<RTR_ENGINES {
      why := rtr_agent_fact(q[0].stations[i].agents[k]);
      if why.count == 0 { e[0].pair[i * RTR_ENGINES + k] = true; any = true; }
      else if q[0].stations[i].agents[k].reported { rtr_block(d, q[0].stations[i].id, names[k], why); }
    }
    if !any { rtr_block(d, q[0].stations[i].id, "", "no_agent"); continue; }
    e[0].station[i] = true; e[0].nstations += 1;
    d[0].eligible_stations[d[0].neligible_stations] = q[0].stations[i].id; d[0].neligible_stations += 1;
  }
  for k: 0..<RTR_ENGINES {
    for i: 0..<q[0].n { if e[0].station[i] && e[0].pair[i * RTR_ENGINES + k] { e[0].engine[k] = true; } }
    if e[0].engine[k] {
      e[0].nengines += 1;
      d[0].eligible_engines[d[0].neligible_engines] = names[k]; d[0].neligible_engines += 1;
    }
  }
}

// Whether the person's rules for the computer in row i allow work of this weight.
rtr_weight_ok :: (q: [] RtrRequest, i: int, weight: int) -> bool #effects(all) {
  return !(q[0].stations[i].nothing_heavy && weight >= RTR_HEAVY);
}

// Whether the computer in row i reports what it is: its OS. One that doesn't
// (its resident service is older than station reports) is known by name only.
rtr_facts_known :: (q: [] RtrRequest, i: int) -> bool #effects(all) { return q[0].stations[i].os.count > 0; }

// Whether the computer in row i has what the task needs. A computer that
// reports no facts is not ruled out by a need it can't be asked about: the
// model chose it by name, and an older computer must stay usable.
rtr_need_ok :: (q: [] RtrRequest, i: int, needs: int) -> bool #effects(all) {
  if needs == RTR_NEED_APPLE { return q[0].stations[i].apple_builds || !rtr_facts_known(q, i); }
  if needs == RTR_NEED_GPU { return q[0].stations[i].gpu.count > 0 || !rtr_facts_known(q, i); }
  if needs == RTR_NEED_THIS { return q[0].current_station.count == 0 || q[0].stations[i].id == q[0].current_station; }
  return true;
}

// Why row i can't run engine for this task, as a reason code; "" when it can.
rtr_why_not :: (q: [] RtrRequest, e: [] RtrEligible, i: int, engine: int, weight: int, needs: int) -> string #effects(all) {
  if i < 0 || i >= q[0].n || engine < 0 || engine >= RTR_ENGINES || !e[0].station[i] { return "station_not_eligible"; }
  if !e[0].pair[i * RTR_ENGINES + engine] { return "station_lacks_engine"; }
  if !rtr_need_ok(q, i, needs) { return "station_lacks_need"; }
  if !rtr_weight_ok(q, i, weight) { return "too_heavy_for_station"; }
  return "";
}

rtr_can :: (q: [] RtrRequest, e: [] RtrEligible, i: int, engine: int, weight: int, needs: int) -> bool #effects(all) {
  return rtr_why_not(q, e, i, engine, weight, needs).count == 0;
}

// Whether row a has more room than row b: less work running, then more free
// memory, then more free disk. Equal rows keep the earlier one.
rtr_more_room :: (q: [] RtrRequest, a: int, b: int) -> bool #effects(all) {
  if q[0].stations[a].work != q[0].stations[b].work { return q[0].stations[a].work < q[0].stations[b].work; } // mutant: equivalent (work != work already excludes equality)
  if q[0].stations[a].memory_free_mb != q[0].stations[b].memory_free_mb { return q[0].stations[a].memory_free_mb > q[0].stations[b].memory_free_mb; } // mutant: equivalent (memory_free_mb != memory_free_mb already excludes equality)
  return q[0].stations[a].disk_free_mb > q[0].stations[b].disk_free_mb;
}

// The computer with the most room that can run engine for this task, or -1.
rtr_roomiest :: (q: [] RtrRequest, e: [] RtrEligible, engine: int, weight: int, needs: int) -> int #effects(all) {
  best := -1;
  for i: 0..<q[0].n {
    if !rtr_can(q, e, i, engine, weight, needs) { continue; }
    if best < 0 || rtr_more_room(q, i, best) { best = i; }
  }
  return best;
}

// Whether the conversation's agent and computer are kept: the model says the
// message continues its work, or no door answered and there is a conversation.
rtr_continues :: (q: [] RtrRequest, a: RtrAnswers) -> bool #effects(all) {
  if a.has { return a.continue_milli >= RTR_SURE_MILLI; }
  return q[0].current_station.count > 0 || q[0].current_engine.count > 0;
}

// The computer that runs engine for this task, or -1: the one the person
// named, then the conversation's, then the model's answer for this agent,
// then the one with the most room. With explain, d's reasons say which, and
// why an earlier one was passed over.
rtr_place :: (q: [] RtrRequest, e: [] RtrEligible, a: RtrAnswers, engine: int, weight: int, needs: int, d: [] RtrDecision, explain: bool) -> int #effects(all) {
  if a.has && a.named_station >= 0 && a.named_station < q[0].n && a.named_station_milli >= RTR_SURE_MILLI {
    if rtr_can(q, e, a.named_station, engine, weight, needs) { if explain { rtr_reason(d, "named_station"); } return a.named_station; }
    if explain { rtr_reason(d, "named_station_cannot"); rtr_reason(d, rtr_why_not(q, e, a.named_station, engine, weight, needs)); }
  }
  if rtr_continues(q, a) {
    cur := rtr_station_index(q, q[0].current_station);
    if cur >= 0 {
      if rtr_can(q, e, cur, engine, weight, needs) { if explain { rtr_reason(d, "continued"); } return cur; }
      if explain { rtr_reason(d, "current_cannot"); rtr_reason(d, rtr_why_not(q, e, cur, engine, weight, needs)); }
    }
  }
  answer := ifx a.has then a.station_for[engine] else -1;
  if answer >= 0 && a.station_for_milli[engine] >= RTR_SURE_MILLI && rtr_can(q, e, answer, engine, weight, needs) { return answer; }
  if explain && a.has {
    runs := 0;
    for i: 0..<q[0].n { if e[0].station[i] && e[0].pair[i * RTR_ENGINES + engine] { runs += 1; } }
    if runs == 1 { }     // that question was not asked: nothing differs from an answer
    else if answer < 0 || answer >= q[0].n || rtr_can(q, e, answer, engine, weight, needs) { rtr_reason(d, "unsure_station"); }
    else { rtr_reason(d, rtr_why_not(q, e, answer, engine, weight, needs)); }
  }
  return rtr_roomiest(q, e, engine, weight, needs);
}

// What runs. d already holds rtr_eligible's lists; this sets ok, station,
// engine, model, effort, difficulty, weight, needs, reasons and error.
rtr_pick :: (q: [] RtrRequest, e: [] RtrEligible, a: RtrAnswers, d: [] RtrDecision) #effects(all) {
  names := RTR_ENGINE_NAMES; efforts := RTR_EFFORT_NAMES; need_names := RTR_NEED_NAMES;
  d[0].ok = false;
  if e[0].nstations == 0 { d[0].error = "no_station"; return; }
  if !a.has { rtr_reason(d, "door_unavailable"); }
  // without an answer the work is taken to be heavy, so a "nothing heavy" computer stays clear
  weight := ifx a.has && a.weight >= 0 && a.weight <= 2 then a.weight else RTR_HEAVY; // mutant: equivalent (RTR_HEAVY == 2, so a.weight == 2 yields 2 on both branches)
  difficulty := ifx a.has && a.difficulty >= 0 && a.difficulty <= 4 then a.difficulty else -1;
  effort := ifx a.has && a.effort >= 0 && a.effort <= 2 then a.effort else 2; // mutant: equivalent (fallback == 2, so a.effort == 2 yields 2 on both branches)
  needs := ifx a.has && a.needs >= 1 && a.needs <= 3 then a.needs else RTR_NEED_NONE;
  // the agent: named, the conversation's, the answer when it is sure, the most capable
  engine := -1;
  if a.has && a.named_engine >= 0 && a.named_engine < RTR_ENGINES && a.named_engine_milli >= RTR_SURE_MILLI {
    if e[0].engine[a.named_engine] { engine = a.named_engine; rtr_reason(d, "named_engine"); }
    else { rtr_reason(d, "named_engine_cannot"); }
  }
  if engine < 0 && rtr_continues(q, a) {
    cur := ca_index(q[0].current_engine);
    if cur >= 0 && cur < RTR_ENGINES { // mutant: equivalent (ca_index returns -1..3, always < RTR_ENGINES)
      if e[0].engine[cur] { engine = cur; rtr_reason(d, "continued"); }
      else { rtr_reason(d, "current_cannot"); rtr_reason(d, "engine_not_eligible"); }
    }
  }
  if engine < 0 {
    if a.has && a.engine >= 0 && a.engine < RTR_ENGINES && e[0].engine[a.engine] && a.engine_milli >= RTR_SURE_MILLI { engine = a.engine; }
    else {
      for k: 0..<RTR_ENGINES { if engine < 0 && e[0].engine[k] { engine = k; } } // mutant: equivalent (e.nstations > 0 guarantees at least one eligible engine in 0..<4)
      if a.has {
        if e[0].nengines == 1 { }     // that question was not asked
        else if a.engine >= 0 && a.engine < RTR_ENGINES && !e[0].engine[a.engine] { rtr_reason(d, "engine_not_eligible"); }
        else { rtr_reason(d, "unsure_engine"); }
      }
    }
  }
  station := rtr_place(q, e, a, engine, weight, needs, d, true);
  if station < 0 {
    // no computer runs that agent for this task: the most capable agent one does
    for k: 0..<RTR_ENGINES {
      if k != engine && e[0].engine[k] { // mutant: equivalent (rtr_place already returns -1 for k == engine and for any ineligible engine)
        s := rtr_place(q, e, a, k, weight, needs, d, false);
        if s >= 0 { station = s; engine = k; rtr_reason(d, "engine_moved"); break; }
      }
    }
  }
  if station < 0 {
    // why nothing can: no eligible computer has what the task needs, or those that do take nothing this heavy
    has_need := false;
    for i: 0..<q[0].n { if e[0].station[i] && rtr_need_ok(q, i, needs) { has_need = true; } }
    rtr_reason(d, ifx has_need then "too_heavy_for_station" else "station_lacks_need");
    d[0].error = "no_station"; d[0].needs = ifx needs != RTR_NEED_NONE then need_names[needs] else "";
    return;
  }
  if a.has && a.depth_milli >= RTR_SURE_MILLI {
    if a.depth == RTR_DEPTH_FASTER { if effort > 0 { effort -= 1; } rtr_reason(d, "faster"); }
    if a.depth == RTR_DEPTH_CAREFUL { if effort < 2 { effort += 1; } rtr_reason(d, "more_careful"); }
  }
  d[0].ok = true;
  d[0].station = q[0].stations[station].id;
  d[0].engine = names[engine];
  d[0].difficulty = difficulty; d[0].weight = ifx a.has then weight else -1;
  d[0].needs = ifx needs != RTR_NEED_NONE then need_names[needs] else "";
  d[0].effort = efforts[effort];
  d[0].model = cr_model(names[engine], ifx difficulty >= 0 then difficulty else 4);
}

// ---- checks (rtr_fx_two and rtr_fx_draw live in test-fixtures.coax)

#test "a computer is ruled out by one fact: its report's age, the person's rule, its disk, its agent limit" {
  q: [1] RtrRequest; rtr_fx_two(q[..]);
  #assert rtr_station_fact(q[..], 0) == "" && rtr_station_fact(q[..], 1) == "";
  q[0].stations[0].reported_at_ms = 1000000 - RTR_FRESH_MS; #assert rtr_station_fact(q[..], 0) == "";
  q[0].stations[0].reported_at_ms = 1000000 - RTR_FRESH_MS - 1; #assert rtr_station_fact(q[..], 0) == "not_reachable";
  q[0].stations[0].reported_at_ms = 0; #assert rtr_station_fact(q[..], 0) == "not_reachable";
  q[0].stations[0].reported_at_ms = 1000001; #assert rtr_station_fact(q[..], 0) == "not_reachable";
  q[0].stations[0].reported_at_ms = 1000000; #assert rtr_station_fact(q[..], 0) == "";
  q[0].stations[0].keep_clear = true; #assert rtr_station_fact(q[..], 0) == "keep_clear";
  q[0].stations[0].keep_clear = false; q[0].stations[0].disk_free_mb = 19999; #assert rtr_station_fact(q[..], 0) == "disk_below_floor";
  q[0].stations[0].disk_free_mb = 20000; #assert rtr_station_fact(q[..], 0) == "";
  q[0].stations[0].max_agents = 1; #assert rtr_station_fact(q[..], 0) == "at_agent_limit";
  q[0].stations[0].max_agents = 2; #assert rtr_station_fact(q[..], 0) == "";
}

#test "an agent is ruled out by one fact: not installed, logged out, quota used up, resting" {
  #assert rtr_agent_fact(RtrAgent.{}) == "not_installed" && rtr_agent_fact(RtrAgent.{reported = true}) == "not_installed";
  #assert rtr_agent_fact(RtrAgent.{reported = true, installed = true}) == "logged_out";
  #assert rtr_agent_fact(RtrAgent.{reported = true, installed = true, logged_in = true, quota_used_up = true}) == "quota_used_up";
  #assert rtr_agent_fact(RtrAgent.{reported = true, installed = true, logged_in = true, cooldown = true}) == "cooldown";
  #assert rtr_agent_fact(RtrAgent.{reported = true, installed = true, logged_in = true}) == "";
}

#test "eligibility lists what can run, and each fact that rules a computer or an agent out" {
  q: [1] RtrRequest; e: [1] RtrEligible; d: [1] RtrDecision;
  rtr_fx_two(q[..]); rtr_decision_clear(d[..]); rtr_eligible(q[..], e[..], d[..]);
  #assert e[0].nstations == 2 && e[0].station[0] && e[0].station[1] && e[0].nengines == 2 && e[0].engine[0] && e[0].engine[1] && !e[0].engine[2];
  #assert e[0].pair[0] && e[0].pair[1] && !e[0].pair[RTR_ENGINES] && e[0].pair[RTR_ENGINES + 1];
  #assert d[0].neligible_stations == 2 && d[0].eligible_stations[1] == "coderos" && d[0].neligible_engines == 2 && d[0].eligible_engines[0] == "claude";
  #assert d[0].nblocked == 1 && d[0].blocked[0].station == "coderos" && d[0].blocked[0].engine == "claude" && d[0].blocked[0].fact == "logged_out";
  // the Mac is kept clear: Claude Code is logged in nowhere else, so only Codex is left
  q[0].stations[0].keep_clear = true; rtr_decision_clear(d[..]); rtr_eligible(q[..], e[..], d[..]);
  #assert e[0].nstations == 1 && !e[0].station[0] && e[0].nengines == 1 && !e[0].engine[0] && e[0].engine[1];
  #assert d[0].nblocked == 2 && d[0].blocked[0].station == "mac" && d[0].blocked[0].engine == "" && d[0].blocked[0].fact == "keep_clear";
  // a computer with no agent that can run is not eligible
  q[0].stations[1].agents[1].quota_used_up = true; rtr_decision_clear(d[..]); rtr_eligible(q[..], e[..], d[..]);
  #assert e[0].nstations == 0 && e[0].nengines == 0 && d[0].nblocked == 4 && d[0].blocked[3].fact == "no_agent" && d[0].blocked[2].fact == "quota_used_up";
}

// Answers with the agent and the computer for it, both sure, and the rest plain.
rtr_fx_answer :: (engine: int, station: int) -> RtrAnswers #effects(all) {
  a := rtr_no_answers(); a.has = true;
  a.engine = engine; a.engine_milli = 900;
  for k: 0..<RTR_ENGINES { a.station_for[k] = station; a.station_for_milli[k] = 900; }
  a.difficulty = 1; a.effort = 1; a.weight = 0; a.needs = RTR_NEED_NONE; a.depth = RTR_DEPTH_NONE; a.depth_milli = 900;
  return a;
}
// One pick on the two computers, from a clean decision.
rtr_fx_pick :: (q: [] RtrRequest, a: RtrAnswers, d: [] RtrDecision) #effects(all) {
  e: [1] RtrEligible;
  rtr_decision_clear(d); rtr_eligible(q, e[..], d); rtr_pick(q, e[..], a, d);
}

#test "what runs: a sure answer, the default when unsure, and never what code ruled out" {
  q: [1] RtrRequest; d: [1] RtrDecision; rtr_fx_two(q[..]);
  a := rtr_fx_answer(1, 1); a.difficulty = 0; a.effort = 0;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "coderos" && d[0].engine == "codex" && d[0].effort == "low" && d[0].difficulty == 0 && d[0].weight == 0 && d[0].model == "" && d[0].needs == "" && d[0].nreasons == 0;
  // a hard task for Claude Code on the Mac
  a = rtr_fx_answer(0, 0); a.difficulty = 3; a.effort = 2; a.weight = 1;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "mac" && d[0].engine == "claude" && d[0].model == "opus" && d[0].effort == "high" && d[0].nreasons == 0;
  // the same, heavy: the Mac takes nothing heavy and coderos has no Claude Code login, so Codex runs on coderos
  a.weight = 2;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "coderos" && d[0].engine == "codex" && d[0].nreasons == 1 && d[0].reasons[0] == "engine_moved";
  // the model answers a computer per agent: Claude Code's is the Mac whatever it says for Codex
  a = rtr_fx_answer(0, 1); a.station_for[0] = 0;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "mac" && d[0].engine == "claude" && d[0].nreasons == 0;
  // an unsure agent: the most capable eligible one, and only the Mac runs it
  a = rtr_fx_answer(1, 1); a.engine_milli = 499;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].nreasons == 1 && d[0].reasons[0] == "unsure_engine";
  // a sure agent and an unsure computer: the one with the most room
  a = rtr_fx_answer(1, 0); a.station_for_milli[1] = 499;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "coderos" && d[0].nreasons == 1 && d[0].reasons[0] == "unsure_station";
  // an agent that is eligible nowhere
  a = rtr_fx_answer(2, 0);
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].reasons[0] == "engine_not_eligible";
}

#test "what a task needs: a Mac that builds for Apple platforms, a GPU, this computer" {
  q: [1] RtrRequest; d: [1] RtrDecision; rtr_fx_two(q[..]); q[0].stations[1].gpu = "RTX 4080";
  // Codex on coderos, but the task is an iOS build: the Mac
  a := rtr_fx_answer(1, 1); a.needs = RTR_NEED_APPLE;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "mac" && d[0].engine == "codex" && d[0].needs == "apple" && d[0].nreasons == 1 && d[0].reasons[0] == "station_lacks_need";
  // Claude Code on the Mac, but the task needs a GPU: only coderos has one, and it runs Codex only
  a = rtr_fx_answer(0, 0); a.needs = RTR_NEED_GPU;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "coderos" && d[0].engine == "codex" && d[0].needs == "gpu" && d[0].nreasons == 1 && d[0].reasons[0] == "engine_moved";
  // a heavy iOS build: the only Mac takes nothing heavy, so nothing runs
  a = rtr_fx_answer(1, 1); a.needs = RTR_NEED_APPLE; a.weight = 2;
  rtr_fx_pick(q[..], a, d[..]);
  #assert !d[0].ok && d[0].error == "no_station" && d[0].needs == "apple" && d[0].station == "" && d[0].reasons[d[0].nreasons - 1] == "too_heavy_for_station";
  // a task that needs a GPU when no eligible computer has one
  q[0].stations[1].keep_clear = true; a = rtr_fx_answer(1, 0); a.needs = RTR_NEED_GPU;
  rtr_fx_pick(q[..], a, d[..]);
  #assert !d[0].ok && d[0].error == "no_station" && d[0].needs == "gpu" && d[0].reasons[d[0].nreasons - 1] == "station_lacks_need";
  q[0].stations[1].keep_clear = false;
  // this computer's files: the conversation's computer, whatever was answered
  q[0].current_station = "mac"; a = rtr_fx_answer(1, 1); a.needs = RTR_NEED_THIS; a.continue_milli = 100;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "mac" && d[0].needs == "this_computer";
  #assert rtr_need_ok(q[..], 0, RTR_NEED_APPLE) && !rtr_need_ok(q[..], 1, RTR_NEED_APPLE) && rtr_need_ok(q[..], 1, RTR_NEED_GPU) && !rtr_need_ok(q[..], 0, RTR_NEED_GPU);
  #assert rtr_need_ok(q[..], 0, RTR_NEED_THIS) && !rtr_need_ok(q[..], 1, RTR_NEED_THIS) && rtr_need_ok(q[..], 1, RTR_NEED_NONE);
  q[0].current_station = ""; #assert rtr_need_ok(q[..], 1, RTR_NEED_THIS);
  // a computer that reports no facts is not ruled out by a Mac or a GPU need
  q[0].stations[1].os = ""; #assert rtr_need_ok(q[..], 1, RTR_NEED_APPLE) && !rtr_facts_known(q[..], 1);
  q[0].stations[0].os = ""; #assert rtr_need_ok(q[..], 0, RTR_NEED_GPU);
}

#test "what the person named wins when it can run, and the decision says when it can't" {
  q: [1] RtrRequest; d: [1] RtrDecision; rtr_fx_two(q[..]);
  // "do it with Codex", though the model would pick Claude Code
  a := rtr_fx_answer(0, 0); a.named_engine = 1; a.named_engine_milli = 950;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "mac" && d[0].reasons[0] == "named_engine";
  // "run it on coderos"
  a = rtr_fx_answer(1, 0); a.named_station = 1; a.named_station_milli = 950;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "coderos" && d[0].engine == "codex" && d[0].reasons[0] == "named_station";
  // "use Claude Code on coderos": it is logged out there, so it runs on the Mac
  a = rtr_fx_answer(1, 1); a.named_engine = 0; a.named_engine_milli = 950; a.named_station = 1; a.named_station_milli = 950;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].nreasons == 3;
  #assert d[0].reasons[0] == "named_engine" && d[0].reasons[1] == "named_station_cannot" && d[0].reasons[2] == "station_lacks_engine";
  // "use Microcoder": it is installed nowhere
  a = rtr_fx_answer(1, 1); a.named_engine = 2; a.named_engine_milli = 950;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "coderos" && d[0].nreasons == 1 && d[0].reasons[0] == "named_engine_cannot";
  // an unsure name is no name
  a = rtr_fx_answer(0, 0); a.named_engine = 1; a.named_engine_milli = 400; a.named_station = 1; a.named_station_milli = 400;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].nreasons == 0;
  // "quick answer" and "think harder" move the effort one step, inside low to high
  a = rtr_fx_answer(1, 1); a.depth = RTR_DEPTH_FASTER;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].effort == "low" && d[0].reasons[0] == "faster";
  a.effort = 0; rtr_fx_pick(q[..], a, d[..]); #assert d[0].effort == "low";
  a.effort = 1; a.depth = RTR_DEPTH_CAREFUL; rtr_fx_pick(q[..], a, d[..]); #assert d[0].effort == "high" && d[0].reasons[0] == "more_careful";
  a.effort = 2; rtr_fx_pick(q[..], a, d[..]); #assert d[0].effort == "high";
  a.effort = 1; a.depth_milli = 400; rtr_fx_pick(q[..], a, d[..]); #assert d[0].effort == "medium" && d[0].nreasons == 0;
}

#test "a conversation keeps its agent and computer while the message continues its work" {
  q: [1] RtrRequest; d: [1] RtrDecision; rtr_fx_two(q[..]);
  q[0].current_station = "mac"; q[0].current_engine = "claude";
  // the model would send this follow-up to Codex on coderos; the conversation stays, and the model follows the message
  a := rtr_fx_answer(1, 1); a.continue_milli = 900; a.difficulty = 3;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].model == "opus" && d[0].nreasons == 1 && d[0].reasons[0] == "continued";
  // different work: the answer runs
  a.continue_milli = 200;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "coderos" && d[0].nreasons == 0;
  // a named agent beats the conversation's, and the conversation's computer is kept when it runs that agent
  a.continue_milli = 900; a.named_engine = 1; a.named_engine_milli = 950;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "mac" && d[0].reasons[0] == "named_engine" && d[0].reasons[1] == "continued";
  // the conversation's agent has run out: the answer runs, and the decision says why
  a = rtr_fx_answer(1, 1); a.continue_milli = 900; q[0].stations[0].agents[0].quota_used_up = true;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "mac" && d[0].reasons[0] == "current_cannot" && d[0].reasons[1] == "engine_not_eligible" && d[0].reasons[2] == "continued";
  // the conversation's computer is kept clear now: its agent moves to where it can run
  q[0].stations[0].agents[0].quota_used_up = false; q[0].stations[1].agents[0].logged_in = true; q[0].stations[0].keep_clear = true;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "coderos" && d[0].reasons[0] == "continued" && d[0].reasons[1] == "current_cannot" && d[0].reasons[2] == "station_not_eligible";
}

#test "no door: the conversation is kept, else the most capable agent, the work taken to be heavy" {
  q: [1] RtrRequest; d: [1] RtrDecision; rtr_fx_two(q[..]);
  rtr_fx_pick(q[..], rtr_no_answers(), d[..]);
  // Claude Code is the most capable, only the Mac runs it, and the Mac takes nothing heavy: Codex on coderos
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "coderos" && d[0].effort == "high" && d[0].difficulty == -1 && d[0].weight == -1;
  #assert d[0].nreasons == 2 && d[0].reasons[0] == "door_unavailable" && d[0].reasons[1] == "engine_moved";
  q[0].stations[0].nothing_heavy = false;
  rtr_fx_pick(q[..], rtr_no_answers(), d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].model == "opus" && d[0].nreasons == 1;
  // a conversation on Codex on coderos stays there
  q[0].current_station = "coderos"; q[0].current_engine = "codex";
  rtr_fx_pick(q[..], rtr_no_answers(), d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "coderos" && d[0].reasons[0] == "door_unavailable" && d[0].reasons[1] == "continued";
  // nothing eligible, and only computers that take nothing heavy
  q[0].current_station = ""; q[0].current_engine = "";
  q[0].stations[0].keep_clear = true; q[0].stations[1].keep_clear = true;
  rtr_fx_pick(q[..], rtr_no_answers(), d[..]);
  #assert !d[0].ok && d[0].error == "no_station" && d[0].station == "";
  q[0].stations[0].keep_clear = false; q[0].stations[0].nothing_heavy = true;
  rtr_fx_pick(q[..], rtr_no_answers(), d[..]);
  #assert !d[0].ok && d[0].error == "no_station" && d[0].reasons[1] == "too_heavy_for_station";
}

// Whatever the model answers: what runs is a computer code allows, running
// an agent that can run there, at a weight its rules take, with what the
// task needs. What the person named runs whenever it can.
#forall "whatever the model answers, what runs is allowed, and what was named runs when it can" v:0..<30000 {
  q: [1] RtrRequest; e: [1] RtrEligible; d: [1] RtrDecision;
  rtr_fx_two(q[..]);
  q[0].stations[1].gpu = "RTX 4080";
  q[0].stations[0].keep_clear = rtr_fx_draw(v, 1, 4) == 0; q[0].stations[1].nothing_heavy = rtr_fx_draw(v, 2, 2) == 0;
  q[0].stations[0].agents[0].logged_in = rtr_fx_draw(v, 3, 3) != 0; q[0].stations[1].agents[0].logged_in = rtr_fx_draw(v, 4, 2) == 0;
  q[0].stations[1].agents[1].quota_used_up = rtr_fx_draw(v, 5, 4) == 0;
  cs := rtr_fx_draw(v, 6, 3); ce := rtr_fx_draw(v, 7, 3);
  q[0].current_station = ifx cs == 1 then "mac" else ifx cs == 2 then "coderos" else "";
  q[0].current_engine = ifx ce == 1 then "claude" else ifx ce == 2 then "codex" else "";
  a := rtr_no_answers();
  a.has = rtr_fx_draw(v, 8, 8) != 0;
  a.engine = rtr_fx_draw(v, 9, 7) - 1; a.engine_milli = ifx rtr_fx_draw(v, 10, 3) == 0 then 100 else 900;
  for k: 0..<RTR_ENGINES { a.station_for[k] = rtr_fx_draw(v, 11 + k, 4) - 1; a.station_for_milli[k] = ifx rtr_fx_draw(v, 15 + k, 3) == 0 then 100 else 900; }
  a.difficulty = rtr_fx_draw(v, 19, 7) - 1; a.effort = rtr_fx_draw(v, 20, 5) - 1; a.weight = rtr_fx_draw(v, 21, 5) - 1;
  a.needs = rtr_fx_draw(v, 22, 6) - 1;
  a.named_station = rtr_fx_draw(v, 23, 6) - 3; a.named_station_milli = ifx rtr_fx_draw(v, 24, 2) == 0 then 100 else 900;
  a.named_engine = rtr_fx_draw(v, 25, 9) - 4; a.named_engine_milli = ifx rtr_fx_draw(v, 26, 2) == 0 then 100 else 900;
  a.depth = rtr_fx_draw(v, 27, 4) - 1; a.depth_milli = ifx rtr_fx_draw(v, 28, 2) == 0 then 100 else 900;
  a.continue_milli = ifx rtr_fx_draw(v, 29, 3) == 0 then -1 else ifx rtr_fx_draw(v, 30, 2) == 0 then 100 else 900;
  rtr_decision_clear(d[..]); rtr_eligible(q[..], e[..], d[..]); rtr_pick(q[..], e[..], a, d[..]);
  weight := ifx a.has && a.weight >= 0 && a.weight <= 2 then a.weight else RTR_HEAVY;
  needs := ifx a.has && a.needs >= 1 && a.needs <= 3 then a.needs else RTR_NEED_NONE;
  if d[0].ok {
    s := rtr_station_index(q[..], d[0].station); k := ca_index(d[0].engine);
    #assert s >= 0 && k >= 0 && k < RTR_ENGINES && e[0].station[s] && e[0].pair[s * RTR_ENGINES + k];
    #assert rtr_station_fact(q[..], s) == "" && rtr_agent_fact(q[0].stations[s].agents[k]) == "";
    #assert rtr_weight_ok(q[..], s, weight) && rtr_need_ok(q[..], s, needs);
    #assert d[0].error == "" && d[0].effort.count > 0;
    named_engine := a.has && a.named_engine >= 0 && a.named_engine < RTR_ENGINES && a.named_engine_milli >= RTR_SURE_MILLI;
    if named_engine && rtr_roomiest(q[..], e[..], a.named_engine, weight, needs) >= 0 { #assert k == a.named_engine; }
    named_station := a.has && a.named_station >= 0 && a.named_station < q[0].n && a.named_station_milli >= RTR_SURE_MILLI;
    if named_station && rtr_can(q[..], e[..], a.named_station, k, weight, needs) { #assert s == a.named_station; }
    // a conversation that continues keeps its computer when that computer can run what runs, and nothing was named
    cur := rtr_station_index(q[..], q[0].current_station);
    if !named_station && rtr_continues(q[..], a) && cur >= 0 && rtr_can(q[..], e[..], cur, k, weight, needs) { #assert s == cur; }
  } else {
    #assert d[0].error == "no_station" && d[0].station == "" && d[0].engine == "";
    // nothing ran only because nothing could: no eligible agent has a computer for this task
    for k: 0..<RTR_ENGINES { #assert rtr_roomiest(q[..], e[..], k, weight, needs) == -1; }
  }
}

// ---- v2alpha1 System One Front RoutePlan #authority policy (#14056)

RTR2_MISS_KINDS :: 6;
RTR2_MISS_NAMES :: [RTR2_MISS_KINDS] string.[
  "none", "messaging_integration", "calendar_email", "media_smart_home", "web_automation", "custom_api_tool"
];

Rtr2Eligible :: struct {
  pack: [RTR2_PACKS] bool;
  npacks: int;
  tier: [RTR2_TIERS] bool;
  ntiers: int;
  delegate: [RTR2_DELEGATES] bool; // index 0 ("none") is always true
  ndelegates: int;                 // count of external delegates (1..4)
}

Rtr2Answers :: struct {
  has: bool;
  primary_pack: int;               // 0..7 or -1
  primary_pack_milli: int;
  secondary_pack: int;             // 0..7 or -1 (none)
  secondary_pack_milli: int;
  compute_tier: int;               // 0..3 or -1
  compute_tier_milli: int;
  explicit_delegate: int;          // 0..4 or -1
  explicit_delegate_milli: int;
  difficulty: int;                 // 0..4 or -1
  effort: int;                     // 0..2 or -1
  continue_milli: int;             // -1 when not asked
  missing_cap_milli: int;          // -1 when not asked
  missing_cap_kind: int;           // 0..5 or -1
  missing_cap_kind_milli: int;
}

rtr2_no_answers :: () -> Rtr2Answers #effects(all) {
  return Rtr2Answers.{
    primary_pack = -1, secondary_pack = -1, compute_tier = -1,
    explicit_delegate = -1, difficulty = -1, effort = -1,
    continue_milli = -1, missing_cap_milli = -1, missing_cap_kind = -1
  };
}

rtr2_lower :: (c: u8) -> u8 #effects(all) {
  return ifx c >= 'A' && c <= 'Z' then cast(u8) (c + 32) else c;
}

rtr2_has_ci :: (hay: string, needle: string) -> bool #effects(all) {
  if needle.count == 0 || hay.count < needle.count { return false; }
  for i: 0..<(hay.count - needle.count + 1) {
    ok := true;
    for j: 0..<needle.count {
      if rtr2_lower(hay[i + j]) != rtr2_lower(needle[j]) { ok = false; break; }
    }
    if ok { return true; }
  }
  return false;
}

// Pure deterministic offline capability pack classifier when no System One door is available.
rtr2_fallback_pack :: (text: string, repo: string) -> int #effects(all) {
  if rtr2_has_ci(text, "new capability") || rtr2_has_ci(text, "create a skill") || rtr2_has_ci(text, "build a plugin") || rtr2_has_ci(text, "author a capability") {
    return RTR2_PACK_AUTHOR;
  }
  if rtr2_has_ci(text, "lightning") || rtr2_has_ci(text, "wallet") || rtr2_has_ci(text, "bitcoin") || rtr2_has_ci(text, "sats") || rtr2_has_ci(text, "invoice") || rtr2_has_ci(text, "bolt11") {
    return RTR2_PACK_WALLET;
  }
  if rtr2_has_ci(text, "metaverse") || rtr2_has_ci(text, "gamebuilder") || rtr2_has_ci(text, "realm") || rtr2_has_ci(text, "3d scene") || rtr2_has_ci(text, "everglade") {
    return RTR2_PACK_METAVERSE;
  }
  if rtr2_has_ci(text, "gbench") || rtr2_has_ci(text, "benchmark") || rtr2_has_ci(text, "eval suite") || rtr2_has_ci(text, "lora") || rtr2_has_ci(text, "hillclimb") {
    return RTR2_PACK_GYM;
  }
  if rtr2_has_ci(text, "book") || rtr2_has_ci(text, "transcript") || rtr2_has_ci(text, "knowledge base") || rtr2_has_ci(text, "nip-kb") || rtr2_has_ci(text, "documentation") {
    return RTR2_PACK_KNOWLEDGE;
  }
  if rtr2_has_ci(text, "terminal") || rtr2_has_ci(text, "shell command") || rtr2_has_ci(text, "cli ") || rtr2_has_ci(text, "tmux") {
    return RTR2_PACK_CLI;
  }
  if repo.count > 0 || rtr2_has_ci(text, ".coax") || rtr2_has_ci(text, ".swift") || rtr2_has_ci(text, ".py") ||
     rtr2_has_ci(text, "fix ") || rtr2_has_ci(text, "bug") || rtr2_has_ci(text, "refactor") || rtr2_has_ci(text, "compile") ||
     rtr2_has_ci(text, "unittest") || rtr2_has_ci(text, "pull request") || rtr2_has_ci(text, "code") {
    return RTR2_PACK_CODER;
  }
  return RTR2_PACK_GENERAL;
}

// Compute eligible packs, compute tiers, and external delegates from request facts and user preference.
rtr2_eligible :: (q: [] Rtr2PlanRequest, e: [] Rtr2Eligible) #effects(all) {
  e[0] = Rtr2Eligible.{};
  // Packs: empty available_packs means all 8 built-in packs are installed
  if q[0].navailable_packs == 0 {
    for i: 0..<RTR2_PACKS { e[0].pack[i] = true; }
    e[0].npacks = RTR2_PACKS;
  } else {
    for i: 0..<q[0].navailable_packs {
      k := rtr2_pack_index(q[0].available_packs[i]);
      if k >= 0 && !e[0].pack[k] { e[0].pack[k] = true; e[0].npacks += 1; }
    }
  }
  // Compute tiers: enforce hardware readiness + user_compute_pref (local / cloud / auto)
  pref := q[0].user_compute_pref;
  allow_local := pref != "cloud";
  allow_cloud := pref != "local";
  if allow_local && q[0].local_inkling_ready { e[0].tier[RTR2_TIER_LOCAL] = true; e[0].ntiers += 1; }
  if allow_cloud && q[0].cloud_ready {
    e[0].tier[RTR2_TIER_CLOUD_FAST] = true; e[0].ntiers += 1;
    e[0].tier[RTR2_TIER_CLOUD_DEEP] = true; e[0].ntiers += 1;
  }
  if allow_cloud && q[0].remote_station_ready { e[0].tier[RTR2_TIER_REMOTE] = true; e[0].ntiers += 1; }
  // Delegates: index 0 ("none") is always allowed; external local harnesses require
  // explicit user opt-in via allow_local_harnesses == true (#14071).
  e[0].delegate[RTR2_DEL_NONE] = true;
  if q[0].allow_local_harnesses {
    for i: 0..<q[0].navailable_delegates {
      k := rtr2_delegate_index(q[0].available_delegates[i]);
      if k > 0 && !e[0].delegate[k] { e[0].delegate[k] = true; e[0].ndelegates += 1; } // mutant: equivalent (delegate[0] is already true, so !delegate[0] is false)
    }
  }
}

rtr2_continues :: (q: [] Rtr2PlanRequest, a: Rtr2Answers) -> bool #effects(all) {
  if q[0].nactive_packs == 0 { return false; }
  if a.has && a.continue_milli >= 0 { return a.continue_milli >= RTR_SURE_MILLI; }
  return true;
}

rtr2_first_pack :: (e: [] Rtr2Eligible) -> int #effects(all) {
  if e[0].pack[RTR2_PACK_GENERAL] { return RTR2_PACK_GENERAL; }
  for i: 1..<RTR2_PACKS { if e[0].pack[i] { return i; } }
  return -1;
}

rtr2_fallback_tier :: (e: [] Rtr2Eligible, primary_pack: int, difficulty: int) -> int #effects(all) {
  light := (primary_pack == RTR2_PACK_GENERAL || primary_pack == RTR2_PACK_KNOWLEDGE) && difficulty <= 1;
  if light && e[0].tier[RTR2_TIER_LOCAL] { return RTR2_TIER_LOCAL; }
  if difficulty >= 3 && e[0].tier[RTR2_TIER_CLOUD_DEEP] { return RTR2_TIER_CLOUD_DEEP; }
  if e[0].tier[RTR2_TIER_CLOUD_FAST] { return RTR2_TIER_CLOUD_FAST; }
  if e[0].tier[RTR2_TIER_CLOUD_DEEP] { return RTR2_TIER_CLOUD_DEEP; }
  if e[0].tier[RTR2_TIER_LOCAL] { return RTR2_TIER_LOCAL; }
  if e[0].tier[RTR2_TIER_REMOTE] { return RTR2_TIER_REMOTE; }
  return -1;
}

// Pure #authority v2 RoutePlan decision from request facts, eligible sets, and door answers.
rtr2_pick :: (q: [] Rtr2PlanRequest, e: [] Rtr2Eligible, a: Rtr2Answers, p: [] Rtr2Plan) #effects(all) {
  pack_names := RTR2_PACK_NAMES;
  tier_names := RTR2_TIER_NAMES;
  del_names := RTR2_DELEGATE_NAMES;
  efforts := RTR_EFFORT_NAMES;
  miss_names := RTR2_MISS_NAMES;

  p[0].ok = false;
  if q[0].text.count == 0 { p[0].error = "no_task"; return; }
  if e[0].ntiers == 0 || e[0].npacks == 0 { p[0].error = "no_compute"; return; }
  if !a.has { rtr2_plan_reason(p, "door_unavailable"); }

  if q[0].user_compute_pref == "local" { rtr2_plan_reason(p, "user_pref_local"); }
  else if q[0].user_compute_pref == "cloud" { rtr2_plan_reason(p, "user_pref_cloud"); }

  difficulty := ifx a.has && a.difficulty >= 0 && a.difficulty <= 4 then a.difficulty else -1;
  cont := rtr2_continues(q, a);
  p[0].continue_active = cont;

  // 1. Missing-capability detection (Episode 289 P9 trigger)
  missing := a.has && a.missing_cap_milli >= RTR_SURE_MILLI;
  if missing {
    hint := "custom_capability";
    if a.missing_cap_kind > 0 && a.missing_cap_kind < RTR2_MISS_KINDS && a.missing_cap_kind_milli >= RTR_SURE_MILLI {
      hint = miss_names[a.missing_cap_kind];
    }
    p[0].missing_capability_hint = hint;
    rtr2_plan_reason(p, "missing_capability");
    if e[0].pack[RTR2_PACK_AUTHOR] { rtr2_plan_add_pack(p, pack_names[RTR2_PACK_AUTHOR]); }
    else { rtr2_plan_reason(p, "pack_unavailable"); }
    if e[0].pack[RTR2_PACK_GENERAL] { rtr2_plan_add_pack(p, pack_names[RTR2_PACK_GENERAL]); }
  }

  // 2. Capability packs (preserve active packs on continuation for prompt cache stability)
  if cont {
    rtr2_plan_reason(p, "continued");
    for i: 0..<q[0].nactive_packs {
      k := rtr2_pack_index(q[0].active_packs[i]);
      if k >= 0 && e[0].pack[k] { rtr2_plan_add_pack(p, pack_names[k]); }
    }
  }
  if !missing {
    if a.has && a.primary_pack >= 0 && a.primary_pack < RTR2_PACKS && a.primary_pack_milli >= RTR_SURE_MILLI {
      if e[0].pack[a.primary_pack] { rtr2_plan_add_pack(p, pack_names[a.primary_pack]); }
      else { rtr2_plan_reason(p, "pack_unavailable"); }
    } else if !cont {
      if a.has { rtr2_plan_reason(p, "unsure_pack"); }
      fb := rtr2_fallback_pack(q[0].text, q[0].repo);
      if e[0].pack[fb] { rtr2_plan_add_pack(p, pack_names[fb]); }
    }
    if a.has && a.secondary_pack >= 0 && a.secondary_pack < RTR2_PACKS && a.secondary_pack_milli >= RTR_SURE_MILLI && e[0].pack[a.secondary_pack] {
      rtr2_plan_add_pack(p, pack_names[a.secondary_pack]);
    }
  }
  if p[0].npacks == 0 { rtr2_plan_add_pack(p, pack_names[rtr2_first_pack(e)]); }
  primary := rtr2_pack_index(p[0].capability_packs[0]);

  // 3. Explicit external delegate (demoted subagent harness)
  del := RTR2_DEL_NONE;
  if a.has && a.explicit_delegate > 0 && a.explicit_delegate < RTR2_DELEGATES && a.explicit_delegate_milli >= RTR_SURE_MILLI {
    if e[0].delegate[a.explicit_delegate] {
      del = a.explicit_delegate;
      rtr2_plan_reason(p, "delegate_requested");
    } else {
      rtr2_plan_reason(p, "delegate_unavailable");
    }
  } else if cont {
    ad := rtr2_delegate_index(q[0].active_delegate);
    if ad > 0 && e[0].delegate[ad] { del = ad; } // mutant: equivalent (del is already 0, so ad == 0 setting del = 0 is a no-op)
  }
  p[0].explicit_delegate = del_names[del];

  // 4. Compute tier (local_inkling, cloud_fast, cloud_deep, remote_station)
  tier := -1;
  if a.has && a.compute_tier >= 0 && a.compute_tier < RTR2_TIERS && a.compute_tier_milli >= RTR_SURE_MILLI {
    if e[0].tier[a.compute_tier] {
      tier = a.compute_tier;
    } else if a.compute_tier == RTR2_TIER_LOCAL {
      rtr2_plan_reason(p, "tier_fallback_cloud");
    } else {
      rtr2_plan_reason(p, "tier_fallback_local");
    }
  } else if a.has && e[0].ntiers > 1 && !cont {
    rtr2_plan_reason(p, "unsure_tier");
  }
  if tier < 0 && cont {
    at := rtr2_tier_index(q[0].active_compute_tier);
    if at >= 0 && e[0].tier[at] { tier = at; }
  }
  if tier < 0 {
    def_diff := ifx primary == RTR2_PACK_GENERAL then 0 else 2; // mutant: equivalent (rtr2_fallback_tier treats 0 and 1 identically as light <= 1)
    eff_diff := ifx difficulty >= 0 then difficulty else def_diff;
    tier = rtr2_fallback_tier(e, primary, eff_diff);
  }
  p[0].compute_tier = tier_names[tier];

  // 5. Effort
  eff := ifx a.has && a.effort >= 0 && a.effort <= 2 then a.effort
         else ifx tier == RTR2_TIER_LOCAL then 0
         else ifx tier == RTR2_TIER_CLOUD_DEEP || difficulty >= 3 then 2
         else 1;
  p[0].effort = efforts[eff];
  p[0].difficulty = difficulty;
  p[0].ok = true;
}

#test "v2 policy: eligibility, fallback classification, user pref, delegation, continuation, and missing capability" {
  q: [1] Rtr2PlanRequest; e: [1] Rtr2Eligible; p: [1] Rtr2Plan;
  // Empty task fails closed
  q[0] = Rtr2PlanRequest.{local_inkling_ready = true, cloud_ready = true};
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], rtr2_no_answers(), p[..]);
  #assert !p[0].ok && p[0].error == "no_task";

  // No compute available fails closed
  q[0] = Rtr2PlanRequest.{text = "hi"};
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], rtr2_no_answers(), p[..]);
  #assert !p[0].ok && p[0].error == "no_compute";

  // Deterministic offline fallback across all 8 packs
  #assert rtr2_fallback_pack("author a capability for Slack", "") == RTR2_PACK_AUTHOR;
  #assert rtr2_fallback_pack("create a skill for Notion", "") == RTR2_PACK_AUTHOR;
  #assert rtr2_fallback_pack("build a plugin for Linear", "") == RTR2_PACK_AUTHOR;
  #assert rtr2_fallback_pack("add a new capability", "") == RTR2_PACK_AUTHOR;
  #assert rtr2_fallback_pack("pay this bolt11 lightning invoice of 500 sats from my bitcoin wallet", "") == RTR2_PACK_WALLET;
  #assert rtr2_fallback_pack("check wallet balance", "") == RTR2_PACK_WALLET;
  #assert rtr2_fallback_pack("send bitcoin", "") == RTR2_PACK_WALLET;
  #assert rtr2_fallback_pack("pay 100 sats", "") == RTR2_PACK_WALLET;
  #assert rtr2_fallback_pack("decode invoice", "") == RTR2_PACK_WALLET;
  #assert rtr2_fallback_pack("pay bolt11", "") == RTR2_PACK_WALLET;
  #assert rtr2_fallback_pack("open the metaverse realm in gamebuilder", "") == RTR2_PACK_METAVERSE;
  #assert rtr2_fallback_pack("open gamebuilder", "") == RTR2_PACK_METAVERSE;
  #assert rtr2_fallback_pack("enter realm", "") == RTR2_PACK_METAVERSE;
  #assert rtr2_fallback_pack("edit 3d scene", "") == RTR2_PACK_METAVERSE;
  #assert rtr2_fallback_pack("launch everglade", "") == RTR2_PACK_METAVERSE;
  #assert rtr2_fallback_pack("run gbench eval suite", "") == RTR2_PACK_GYM;
  #assert rtr2_fallback_pack("run benchmark", "") == RTR2_PACK_GYM;
  #assert rtr2_fallback_pack("run eval suite", "") == RTR2_PACK_GYM;
  #assert rtr2_fallback_pack("train lora", "") == RTR2_PACK_GYM;
  #assert rtr2_fallback_pack("run hillclimb", "") == RTR2_PACK_GYM;
  #assert rtr2_fallback_pack("search the book and transcript in the knowledge base", "") == RTR2_PACK_KNOWLEDGE;
  #assert rtr2_fallback_pack("find transcript", "") == RTR2_PACK_KNOWLEDGE;
  #assert rtr2_fallback_pack("query knowledge base", "") == RTR2_PACK_KNOWLEDGE;
  #assert rtr2_fallback_pack("search nip-kb", "") == RTR2_PACK_KNOWLEDGE;
  #assert rtr2_fallback_pack("read documentation", "") == RTR2_PACK_KNOWLEDGE;
  #assert rtr2_fallback_pack("run this terminal command", "") == RTR2_PACK_CLI;
  #assert rtr2_fallback_pack("run shell command", "") == RTR2_PACK_CLI;
  #assert rtr2_fallback_pack("open cli tool", "") == RTR2_PACK_CLI;
  #assert rtr2_fallback_pack("attach tmux", "") == RTR2_PACK_CLI;
  #assert rtr2_fallback_pack("fix the bug in app.coax", "") == RTR2_PACK_CODER;
  #assert rtr2_fallback_pack("edit app.swift", "") == RTR2_PACK_CODER;
  #assert rtr2_fallback_pack("edit main.py", "") == RTR2_PACK_CODER;
  #assert rtr2_fallback_pack("fix typo", "") == RTR2_PACK_CODER;
  #assert rtr2_fallback_pack("found a bug", "") == RTR2_PACK_CODER;
  #assert rtr2_fallback_pack("refactor module", "") == RTR2_PACK_CODER;
  #assert rtr2_fallback_pack("compile it", "") == RTR2_PACK_CODER;
  #assert rtr2_fallback_pack("run unittest", "") == RTR2_PACK_CODER;
  #assert rtr2_fallback_pack("open pull request", "") == RTR2_PACK_CODER;
  #assert rtr2_fallback_pack("review code", "") == RTR2_PACK_CODER;
  #assert rtr2_fallback_pack("explain this", "openagents") == RTR2_PACK_CODER;
  #assert rtr2_fallback_pack("hello how are you", "") == RTR2_PACK_GENERAL;
  #assert !rtr2_has_ci("abc", "") && !rtr2_has_ci("a", "ab") && rtr2_has_ci("AbC", "abc") && !rtr2_has_ci("abc", "xyz");

  // User pref local forces local_inkling even if door chose cloud_deep
  q[0] = Rtr2PlanRequest.{text = "fix bug", local_inkling_ready = true, cloud_ready = true, user_compute_pref = "local"};
  a := rtr2_no_answers(); a.has = true; a.primary_pack = RTR2_PACK_CODER; a.primary_pack_milli = 950;
  a.compute_tier = RTR2_TIER_CLOUD_DEEP; a.compute_tier_milli = 900; a.difficulty = 3; a.effort = 2;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  #assert p[0].ok && p[0].compute_tier == "local_inkling" && p[0].capability_packs[0] == "coder" && p[0].effort == "high" && p[0].difficulty == 3;
  #assert p[0].reasons[0] == "user_pref_local" && p[0].reasons[1] == "tier_fallback_local";

  // User pref cloud blocks local_inkling and falls back to cloud
  q[0] = Rtr2PlanRequest.{text = "hello", local_inkling_ready = true, cloud_ready = true, user_compute_pref = "cloud"};
  a = rtr2_no_answers(); a.has = true; a.primary_pack = RTR2_PACK_GENERAL; a.primary_pack_milli = 950;
  a.compute_tier = RTR2_TIER_LOCAL; a.compute_tier_milli = 900; a.difficulty = 0;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  #assert p[0].ok && p[0].compute_tier == "cloud_fast" && p[0].effort == "medium" && p[0].reasons[0] == "user_pref_cloud" && p[0].reasons[1] == "tier_fallback_cloud";

  // Explicit delegate requires allow_local_harnesses opt-in (#14071): refused when false, allowed when true
  q[0] = Rtr2PlanRequest.{text = "use claude to fix this", local_inkling_ready = true, cloud_ready = true, allow_local_harnesses = false};
  q[0].available_delegates[0] = "claude"; q[0].navailable_delegates = 1;
  a = rtr2_no_answers(); a.has = true; a.primary_pack = RTR2_PACK_CODER; a.primary_pack_milli = 900;
  a.explicit_delegate = RTR2_DEL_CLAUDE; a.explicit_delegate_milli = 900;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  #assert p[0].ok && e[0].ndelegates == 0 && p[0].explicit_delegate == "none" && p[0].reasons[0] == "delegate_unavailable";

  // Explicit delegate available vs unavailable when opted in
  q[0] = Rtr2PlanRequest.{text = "use claude to fix this", local_inkling_ready = true, cloud_ready = true, allow_local_harnesses = true};
  q[0].available_delegates[0] = "claude"; q[0].available_delegates[1] = "claude"; q[0].navailable_delegates = 2;
  a = rtr2_no_answers(); a.has = true; a.primary_pack = RTR2_PACK_CODER; a.primary_pack_milli = 900;
  a.explicit_delegate = RTR2_DEL_CLAUDE; a.explicit_delegate_milli = 900;
  a.secondary_pack = RTR2_PACK_CLI; a.secondary_pack_milli = 800;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  #assert p[0].ok && p[0].explicit_delegate == "claude" && p[0].npacks == 2 && p[0].capability_packs[1] == "cli" && p[0].reasons[0] == "delegate_requested";
  a.explicit_delegate = RTR2_DEL_CODEX;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  #assert p[0].ok && p[0].explicit_delegate == "none" && p[0].reasons[0] == "delegate_unavailable";

  // Multi-turn continuation preserves active packs, compute tier, and delegate (when opted in)
  q[0] = Rtr2PlanRequest.{text = "now run the tests", local_inkling_ready = true, cloud_ready = true, active_compute_tier = "cloud_deep", active_delegate = "claude", allow_local_harnesses = true};
  q[0].active_packs[0] = "coder"; q[0].nactive_packs = 1;
  q[0].available_delegates[0] = "claude"; q[0].navailable_delegates = 1;
  a = rtr2_no_answers(); a.has = true; a.continue_milli = 850;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  #assert p[0].ok && p[0].continue_active && p[0].capability_packs[0] == "coder" && p[0].compute_tier == "cloud_deep" && p[0].explicit_delegate == "claude" && p[0].effort == "high";

  // Missing capability triggers Episode 289 P9 authoring hint + capability_author pack
  q[0] = Rtr2PlanRequest.{text = "post a summary to our Slack channel", local_inkling_ready = true, cloud_ready = true};
  a = rtr2_no_answers(); a.has = true; a.missing_cap_milli = 920; a.missing_cap_kind = 1; a.missing_cap_kind_milli = 880;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  #assert p[0].ok && p[0].missing_capability_hint == "messaging_integration" && p[0].capability_packs[0] == "capability_author" && p[0].capability_packs[1] == "general";

  // Restricted available_packs + remote_station fallback
  q[0] = Rtr2PlanRequest.{text = "check this", remote_station_ready = true};
  q[0].available_packs[0] = "wallet"; q[0].available_packs[1] = "wallet"; q[0].navailable_packs = 2;
  a = rtr2_no_answers(); a.has = true; a.missing_cap_milli = 900; a.missing_cap_kind = 0; a.missing_cap_kind_milli = 900;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  #assert p[0].ok && p[0].capability_packs[0] == "wallet" && p[0].compute_tier == "remote_station" && p[0].missing_capability_hint == "custom_capability";

  // Restricted available_packs with ineligible primary pack
  a = rtr2_no_answers(); a.has = true; a.primary_pack = RTR2_PACK_CODER; a.primary_pack_milli = 900;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  #assert p[0].ok && p[0].capability_packs[0] == "wallet" && p[0].reasons[0] == "pack_unavailable";

  // Offline general turn prefers local_inkling at low effort
  q[0] = Rtr2PlanRequest.{text = "hello", local_inkling_ready = true, cloud_ready = true};
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], rtr2_no_answers(), p[..]);
  #assert p[0].ok && p[0].capability_packs[0] == "general" && p[0].compute_tier == "local_inkling" && p[0].effort == "low" && p[0].reasons[0] == "door_unavailable";

  // Unsure pack & unsure tier reasons
  a = rtr2_no_answers(); a.has = true; a.primary_pack = RTR2_PACK_CODER; a.primary_pack_milli = 300; a.compute_tier = RTR2_TIER_CLOUD_DEEP; a.compute_tier_milli = 300;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  #assert p[0].ok && p[0].reasons[0] == "unsure_pack" && p[0].reasons[1] == "unsure_tier";

  // Boundary: exact RTR_SURE_MILLI = 500
  q[0] = Rtr2PlanRequest.{text = "build a plugin", local_inkling_ready = true, cloud_ready = true, remote_station_ready = true, allow_local_harnesses = true};
  q[0].active_packs[0] = "coder"; q[0].nactive_packs = 1;
  q[0].available_delegates[0] = "codex"; q[0].navailable_delegates = 1;
  a = rtr2_no_answers(); a.has = true; a.continue_milli = 500; a.primary_pack = RTR2_PACK_WALLET; a.primary_pack_milli = 500;
  a.secondary_pack = RTR2_PACK_GYM; a.secondary_pack_milli = 500; a.explicit_delegate = RTR2_DEL_CODEX; a.explicit_delegate_milli = 500;
  a.compute_tier = RTR2_TIER_REMOTE; a.compute_tier_milli = 500; a.difficulty = 4; a.effort = 0;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  #assert p[0].ok && p[0].continue_active && p[0].npacks == 3 && p[0].explicit_delegate == "codex" && p[0].compute_tier == "remote_station" && p[0].effort == "low" && p[0].difficulty == 4;
  // Just below RTR_SURE_MILLI = 499
  a.continue_milli = 499; a.missing_cap_milli = 499; a.explicit_delegate_milli = 499; a.primary_pack_milli = 499; a.secondary_pack_milli = 499; a.compute_tier_milli = 499;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  #assert p[0].ok && !p[0].continue_active && p[0].missing_capability_hint == "" && p[0].explicit_delegate == "none" && p[0].compute_tier == "cloud_deep";
}

#forall "v2 policy: whatever the model answers, chosen packs, compute tier and delegate are always eligible" v:0..<4096 {
  q: [1] Rtr2PlanRequest; e: [1] Rtr2Eligible; p: [1] Rtr2Plan;
  q[0] = Rtr2PlanRequest.{
    text = ifx rtr_fx_draw(v, 0, 16) == 0 then "" else "handle this task",
    local_inkling_ready = rtr_fx_draw(v, 1, 2) != 0,
    cloud_ready = rtr_fx_draw(v, 2, 2) != 0,
    remote_station_ready = rtr_fx_draw(v, 3, 3) == 0,
    user_compute_pref = ifx rtr_fx_draw(v, 4, 4) == 0 then "local" else ifx rtr_fx_draw(v, 4, 4) == 1 then "cloud" else "auto",
    allow_local_harnesses = rtr_fx_draw(v, 24, 2) == 0
  };
  if rtr_fx_draw(v, 5, 2) == 0 { q[0].active_packs[0] = "coder"; q[0].nactive_packs = 1; q[0].active_compute_tier = "cloud_deep"; }
  if rtr_fx_draw(v, 6, 2) == 0 { q[0].available_delegates[0] = "claude"; q[0].navailable_delegates = 1; }
  if rtr_fx_draw(v, 7, 3) == 0 { q[0].available_packs[0] = "general"; q[0].available_packs[1] = "coder"; q[0].navailable_packs = 2; }
  a := rtr2_no_answers();
  a.has = rtr_fx_draw(v, 8, 4) != 0;
  a.primary_pack = rtr_fx_draw(v, 9, 10) - 1; a.primary_pack_milli = ifx rtr_fx_draw(v, 10, 2) == 0 then 200 else 850;
  a.secondary_pack = rtr_fx_draw(v, 11, 10) - 1; a.secondary_pack_milli = ifx rtr_fx_draw(v, 12, 2) == 0 then 200 else 850;
  a.compute_tier = rtr_fx_draw(v, 13, 6) - 1; a.compute_tier_milli = ifx rtr_fx_draw(v, 14, 2) == 0 then 200 else 850;
  a.explicit_delegate = rtr_fx_draw(v, 15, 7) - 1; a.explicit_delegate_milli = ifx rtr_fx_draw(v, 16, 2) == 0 then 200 else 850;
  a.difficulty = rtr_fx_draw(v, 17, 7) - 1; a.effort = rtr_fx_draw(v, 18, 5) - 1;
  a.continue_milli = ifx rtr_fx_draw(v, 19, 3) == 0 then -1 else ifx rtr_fx_draw(v, 20, 2) == 0 then 200 else 850;
  a.missing_cap_milli = ifx rtr_fx_draw(v, 21, 4) == 0 then 850 else 100;
  a.missing_cap_kind = rtr_fx_draw(v, 22, 8) - 1; a.missing_cap_kind_milli = ifx rtr_fx_draw(v, 23, 2) == 0 then 200 else 850;
  rtr2_plan_clear(p[..]); rtr2_eligible(q[..], e[..]); rtr2_pick(q[..], e[..], a, p[..]);
  if p[0].ok {
    #assert q[0].text.count > 0 && p[0].npacks >= 1;
    for i: 0..<p[0].npacks {
      pk := rtr2_pack_index(p[0].capability_packs[i]);
      #assert pk >= 0 && e[0].pack[pk];
    }
    tk := rtr2_tier_index(p[0].compute_tier);
    #assert tk >= 0 && e[0].tier[tk];
    if q[0].user_compute_pref == "local" { #assert tk == RTR2_TIER_LOCAL; }
    if q[0].user_compute_pref == "cloud" { #assert tk != RTR2_TIER_LOCAL; }
    dk := rtr2_delegate_index(p[0].explicit_delegate);
    #assert dk >= 0 && e[0].delegate[dk];
    if !q[0].allow_local_harnesses { #assert dk == RTR2_DEL_NONE; }
    #assert p[0].effort == "low" || p[0].effort == "medium" || p[0].effort == "high";
  } else {
    #assert p[0].error == "no_task" || p[0].error == "no_compute";
  }
}

#test "policy mutation coverage: v1 and v2 exact boundaries" {
  // v1 rtr_no_answers fields
  na := rtr_no_answers();
  #assert !na.has && na.engine == -1 && na.difficulty == -1 && na.effort == -1 && na.weight == -1 && na.needs == -1;
  #assert na.named_station == -1 && na.named_engine == -1 && na.depth == -1 && na.continue_milli == -1;
  for k: 0..<RTR_ENGINES { #assert na.station_for[k] == -1; }

  // v1 rtr_station_fact, rtr_facts_known, rtr_need_ok, rtr_why_not, rtr_more_room, rtr_roomiest
  q: [1] RtrRequest; e: [1] RtrEligible; d: [1] RtrDecision;
  rtr_fx_two(q[..]);
  q[0].stations[0].reported_at_ms = -1; #assert rtr_station_fact(q[..], 0) == "not_reachable";
  q[0].stations[0].reported_at_ms = 1; q[0].now_ms = 1; #assert rtr_station_fact(q[..], 0) == "";
  q[0].stations[0].reported_at_ms = 990000; q[0].now_ms = 1000000;
  q[0].stations[0].os = "x"; #assert rtr_facts_known(q[..], 0);
  q[0].stations[0].os = ""; #assert !rtr_facts_known(q[..], 0);
  q[0].stations[0].os = "macos";
  q[0].stations[1].gpu = "g"; #assert rtr_need_ok(q[..], 1, RTR_NEED_GPU);
  q[0].stations[1].gpu = ""; #assert !rtr_need_ok(q[..], 1, RTR_NEED_GPU);

  rtr_decision_clear(d[..]); rtr_eligible(q[..], e[..], d[..]);
  #assert rtr_why_not(q[..], e[..], -1, 0, 0, 0) == "station_not_eligible";
  #assert rtr_why_not(q[..], e[..], 2, 0, 0, 0) == "station_not_eligible";
  #assert rtr_why_not(q[..], e[..], 0, -1, 0, 0) == "station_not_eligible";
  #assert rtr_why_not(q[..], e[..], 0, 4, 0, 0) == "station_not_eligible";

  // rtr_more_room tie-breakers: work -> memory_free_mb -> disk_free_mb -> equal false
  q[0].stations[0].work = 1; q[0].stations[1].work = 1;
  q[0].stations[0].memory_free_mb = 500; q[0].stations[1].memory_free_mb = 500;
  q[0].stations[0].disk_free_mb = 500; q[0].stations[1].disk_free_mb = 500;
  #assert !rtr_more_room(q[..], 0, 1) && !rtr_more_room(q[..], 1, 0);
  q[0].stations[0].disk_free_mb = 501; #assert rtr_more_room(q[..], 0, 1) && !rtr_more_room(q[..], 1, 0);
  q[0].stations[1].memory_free_mb = 501; #assert rtr_more_room(q[..], 1, 0) && !rtr_more_room(q[..], 0, 1);
  q[0].stations[0].work = 0; #assert rtr_more_room(q[..], 0, 1) && !rtr_more_room(q[..], 1, 0);

  // rtr_continues exact boundary 500 vs 499 and offline current_station / current_engine
  a := rtr_no_answers(); a.has = true; a.continue_milli = 500; #assert rtr_continues(q[..], a);
  a.continue_milli = 499; #assert !rtr_continues(q[..], a);
  a.has = false; q[0].current_station = ""; q[0].current_engine = ""; #assert !rtr_continues(q[..], a);
  q[0].current_station = "a"; #assert rtr_continues(q[..], a);
  q[0].current_station = ""; q[0].current_engine = "a"; #assert rtr_continues(q[..], a);

  // v1 rtr_pick exact boundaries: ok reset, named_station/engine/station_for/depth at 500, difficulty 4, weight 2, effort 2
  rtr_fx_two(q[..]); q[0].stations[0].nothing_heavy = false;
  d[0].ok = true; e[0].nstations = 0; rtr_pick(q[..], e[..], rtr_no_answers(), d[..]); #assert !d[0].ok;
  a = rtr_fx_answer(1, 0); a.engine_milli = 500; a.station_for_milli[1] = 500; a.difficulty = 4; a.weight = 2; a.effort = 2;
  a.named_station = 0; a.named_station_milli = 500; a.named_engine = 0; a.named_engine_milli = 500;
  a.depth = RTR_DEPTH_FASTER; a.depth_milli = 500;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "mac" && d[0].engine == "claude" && d[0].difficulty == 4 && d[0].weight == 2 && d[0].effort == "medium";
  a.difficulty = 5; a.weight = 3; a.effort = 3; a.named_station = 2; a.named_engine = -1;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].difficulty == -1 && d[0].weight == 2 && d[0].effort == "medium";

  // v2 rtr2_no_answers + rtr2_eligible exact counts + rtr2_first_pack + rtr2_fallback_tier
  na2 := rtr2_no_answers();
  #assert !na2.has && na2.primary_pack == -1 && na2.secondary_pack == -1 && na2.compute_tier == -1;
  #assert na2.explicit_delegate == -1 && na2.difficulty == -1 && na2.effort == -1;
  #assert na2.continue_milli == -1 && na2.missing_cap_milli == -1 && na2.missing_cap_kind == -1;

  q2: [1] Rtr2PlanRequest; e2: [1] Rtr2Eligible; p2: [1] Rtr2Plan;
  q2[0] = Rtr2PlanRequest.{text = "hi", local_inkling_ready = true, cloud_ready = true, remote_station_ready = true, allow_local_harnesses = false};
  q2[0].available_delegates[0] = "none"; q2[0].available_delegates[1] = "claude"; q2[0].available_delegates[2] = "codex"; q2[0].navailable_delegates = 3;
  rtr2_eligible(q2[..], e2[..]);
  #assert e2[0].npacks == 8 && e2[0].ntiers == 4 && e2[0].ndelegates == 0;
  q2[0].allow_local_harnesses = true;
  rtr2_eligible(q2[..], e2[..]);
  #assert e2[0].npacks == 8 && e2[0].ntiers == 4 && e2[0].ndelegates == 2;
  #assert rtr2_first_pack(e2[..]) == RTR2_PACK_GENERAL;
  e2[0].pack[RTR2_PACK_GENERAL] = false; #assert rtr2_first_pack(e2[..]) == RTR2_PACK_KNOWLEDGE;
  for i: 0..<RTR2_PACKS { e2[0].pack[i] = false; }
  #assert rtr2_first_pack(e2[..]) == -1;

  // rtr2_fallback_tier exact boundaries
  rtr2_eligible(q2[..], e2[..]);
  #assert rtr2_fallback_tier(e2[..], RTR2_PACK_KNOWLEDGE, 1) == RTR2_TIER_LOCAL;
  #assert rtr2_fallback_tier(e2[..], RTR2_PACK_KNOWLEDGE, 2) == RTR2_TIER_CLOUD_FAST;
  #assert rtr2_fallback_tier(e2[..], RTR2_PACK_CODER, 2) == RTR2_TIER_CLOUD_FAST;
  #assert rtr2_fallback_tier(e2[..], RTR2_PACK_CODER, 3) == RTR2_TIER_CLOUD_DEEP;
  e2[0].tier[RTR2_TIER_CLOUD_FAST] = false;
  #assert rtr2_fallback_tier(e2[..], RTR2_PACK_CODER, 2) == RTR2_TIER_CLOUD_DEEP;
  e2[0].tier[RTR2_TIER_CLOUD_DEEP] = false;
  #assert rtr2_fallback_tier(e2[..], RTR2_PACK_CODER, 3) == RTR2_TIER_LOCAL;
  e2[0].tier[RTR2_TIER_LOCAL] = false;
  #assert rtr2_fallback_tier(e2[..], RTR2_PACK_CODER, 3) == RTR2_TIER_REMOTE;
  e2[0].tier[RTR2_TIER_REMOTE] = false;
  #assert rtr2_fallback_tier(e2[..], RTR2_PACK_CODER, 3) == -1;

  // rtr2_continues exact boundary: continue_milli == 0 vs -1 vs 500
  q2[0].active_packs[0] = "coder"; q2[0].nactive_packs = 1;
  a2 := rtr2_no_answers(); a2.has = true; a2.continue_milli = 0; #assert !rtr2_continues(q2[..], a2);
  a2.continue_milli = -1; #assert rtr2_continues(q2[..], a2);
  a2.has = false; #assert rtr2_continues(q2[..], a2);

  // rtr2_pick exact ok reset, difficulty 0/4/5, missing_cap_milli == 500, missing_cap_kind 5/6 & 500
  p2[0].ok = true; q2[0].text = ""; rtr2_eligible(q2[..], e2[..]); rtr2_pick(q2[..], e2[..], rtr2_no_answers(), p2[..]); #assert !p2[0].ok;
  q2[0].text = "test"; q2[0].nactive_packs = 0;
  a2 = rtr2_no_answers(); a2.has = true; a2.difficulty = 0; a2.missing_cap_milli = 500; a2.missing_cap_kind = 5; a2.missing_cap_kind_milli = 500;
  rtr2_plan_clear(p2[..]); rtr2_eligible(q2[..], e2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].difficulty == 0 && p2[0].missing_capability_hint == "custom_api_tool" && p2[0].reasons[0] == "missing_capability";
  a2.difficulty = 5; a2.missing_cap_kind = 6;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].difficulty == -1 && p2[0].missing_capability_hint == "custom_capability";
  // Effort from difficulty == 3 when tier is cloud_fast
  a2 = rtr2_no_answers(); a2.has = true; a2.primary_pack = RTR2_PACK_CODER; a2.primary_pack_milli = 900;
  a2.compute_tier = RTR2_TIER_CLOUD_FAST; a2.compute_tier_milli = 900; a2.difficulty = 3;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].effort == "high";

  // Kill remaining v1 boundary mutants
  q[0].stations[0].reported_at_ms = 0; q[0].now_ms = 0;
  #assert rtr_station_fact(q[..], 0) == "not_reachable";
  rtr_fx_two(q[..]); q[0].stations[0].nothing_heavy = false;
  rtr_decision_clear(d[..]); rtr_eligible(q[..], e[..], d[..]);
  e[0].station[2] = true;
  #assert rtr_why_not(q[..], e[..], 2, 0, 0, 0) == "station_not_eligible";
  e[0].station[2] = false;
  // rtr_roomiest keeps index 0 when station 0 has more room than station 1
  q[0].stations[0].work = 0; q[0].stations[1].work = 2;
  #assert rtr_roomiest(q[..], e[..], 1, 0, 0) == 0;
  // rtr_place: named_station == 0 overrides roomiest == 1 at milli == 500, fails at 499; -1/out-of-bounds ignored
  rtr_fx_two(q[..]); q[0].stations[0].nothing_heavy = false;
  a = rtr_fx_answer(1, 1);
  #assert a.engine_milli == 900 && a.station_for[0] == 1 && a.station_for_milli[0] == 900 && a.difficulty == 1 && a.effort == 1 && a.weight == 0 && a.needs == 0 && a.depth == 0 && a.depth_milli == 900;
  a.named_station = 0; a.named_station_milli = 500;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].station == "mac" && d[0].reasons[0] == "named_station";
  a.named_station_milli = 499;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].station == "coderos";
  a.named_station = -1; a.named_station_milli = 900;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].station == "coderos";
  a.named_station = 2; a.named_station_milli = 900;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].station == "coderos";
  // rtr_place: station_for[1] == 0 overrides roomiest == 1 at milli == 500, fails at 499 -> unsure_station; out-of-range -> unsure_station; runs == 1 -> no unsure_station
  a = rtr_fx_answer(1, 0); a.station_for_milli[1] = 500;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].station == "mac" && d[0].nreasons == 0;
  a.station_for_milli[1] = 499;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].station == "coderos" && d[0].reasons[0] == "unsure_station";
  a.station_for[1] = 2; a.station_for_milli[1] = 900;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].station == "coderos" && d[0].reasons[0] == "unsure_station";
  a.station_for[1] = -1;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].station == "coderos" && d[0].reasons[0] == "unsure_station";
  a = rtr_fx_answer(0, -1); a.station_for_milli[0] = 100;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].station == "mac" && d[0].nreasons == 0;
  // rtr_pick: a.has == false ignores nonzero difficulty/station_for; named_engine == 0 not overwritten by continuation; engine_milli == 500; engine_not_eligible for engine == 0; engine_moved to engine 0 on station 0; difficulty == 0 model
  a = rtr_fx_answer(1, 0); a.has = false; a.difficulty = 1; a.weight = 0; a.effort = 0;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].difficulty == -1 && d[0].weight == -1 && d[0].effort == "high" && d[0].engine == "claude" && d[0].station == "mac";
  q[0].current_engine = "codex"; q[0].current_station = "coderos";
  a = rtr_fx_answer(1, 1); a.named_engine = 0; a.named_engine_milli = 900; a.continue_milli = 900; a.difficulty = 0;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].engine == "claude" && d[0].model == cr_model("claude", 0);
  q[0].current_engine = ""; q[0].current_station = "";
  a = rtr_fx_answer(1, 1); a.engine_milli = 500;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].engine == "codex" && d[0].nreasons == 0;
  a.engine_milli = 499;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].engine == "claude" && d[0].reasons[0] == "unsure_engine";
  // engine_not_eligible when engine == 0 (claude) is logged out everywhere
  q[0].stations[0].agents[0].logged_in = false; q[0].stations[0].agents[2] = RtrAgent.{reported = true, installed = true, logged_in = true};
  a = rtr_fx_answer(0, 0);
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].engine == "codex" && d[0].reasons[0] == "engine_not_eligible";
  // engine_moved from codex (1) -> claude (0) on station 0 when apple need can only be met on mac without codex
  rtr_fx_two(q[..]); q[0].stations[0].nothing_heavy = false; q[0].stations[0].agents[1].logged_in = false;
  a = rtr_fx_answer(1, 1); a.needs = RTR_NEED_APPLE;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].reasons[0] == "engine_moved";

  // Kill remaining v2 boundary mutants
  #assert rtr2_lower('Z') == 'z' && rtr2_lower('[') == '[' && rtr2_has_ci("abZ", "z") && rtr2_has_ci("Z", "z");
  #assert rtr2_fallback_pack("hi", "x") == RTR2_PACK_CODER;
  // rtr2_eligible: general (index 0) and bogus (-1) in available_packs; bogus (-1) in available_delegates
  q2[0] = Rtr2PlanRequest.{text = "hi", local_inkling_ready = true, cloud_ready = true, allow_local_harnesses = true};
  q2[0].available_packs[0] = "general"; q2[0].available_packs[1] = "bogus"; q2[0].navailable_packs = 2;
  q2[0].available_delegates[0] = "bogus"; q2[0].available_delegates[1] = "claude"; q2[0].navailable_delegates = 2;
  rtr2_eligible(q2[..], e2[..]);
  #assert e2[0].npacks == 1 && e2[0].pack[0] && e2[0].ndelegates == 1 && e2[0].delegate[1];
  // rtr2_pick: a.has == false ignores a.difficulty; missing with author unavailable -> pack_unavailable & general absent; cont with active_packs[0]="general" + "bogus"; secondary_pack=0; explicit_delegate=0; active_delegate="none"; unsure_tier only when ntiers > 1 && !cont; active_compute_tier="local_inkling" (0); eff_diff when difficulty==0 vs -1 and general vs coder
  a2 = rtr2_no_answers(); a2.difficulty = 3;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].difficulty == -1 && p2[0].compute_tier == "local_inkling";
  q2[0].available_packs[0] = "wallet"; q2[0].navailable_packs = 1;
  rtr2_eligible(q2[..], e2[..]);
  a2 = rtr2_no_answers(); a2.has = true; a2.missing_cap_milli = 900;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].npacks == 1 && p2[0].capability_packs[0] == "wallet" && p2[0].reasons[0] == "missing_capability" && p2[0].reasons[1] == "pack_unavailable";
  // cont with general (0) + bogus (-1), active_compute_tier = local_inkling (0), active_delegate = none (0)
  q2[0] = Rtr2PlanRequest.{text = "more", local_inkling_ready = true, cloud_ready = true, active_compute_tier = "local_inkling", active_delegate = "none"};
  q2[0].active_packs[0] = "general"; q2[0].active_packs[1] = "bogus"; q2[0].nactive_packs = 2;
  rtr2_eligible(q2[..], e2[..]);
  a2 = rtr2_no_answers(); a2.has = true; a2.continue_milli = 900; a2.explicit_delegate = 0; a2.explicit_delegate_milli = 900;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].npacks == 1 && p2[0].capability_packs[0] == "general" && p2[0].compute_tier == "local_inkling" && p2[0].explicit_delegate == "none" && p2[0].nreasons == 1 && p2[0].reasons[0] == "continued";
  // secondary_pack == 0 (general) added alongside primary coder; explicit tier == 0 (local_inkling) NOT overwritten by active_compute_tier == cloud_deep
  q2[0] = Rtr2PlanRequest.{text = "hi", local_inkling_ready = true, cloud_ready = true, active_compute_tier = "cloud_deep"};
  q2[0].active_packs[0] = "coder"; q2[0].nactive_packs = 1;
  rtr2_eligible(q2[..], e2[..]);
  a2 = rtr2_no_answers(); a2.has = true; a2.continue_milli = 900; a2.primary_pack = RTR2_PACK_CODER; a2.primary_pack_milli = 900;
  a2.secondary_pack = RTR2_PACK_GENERAL; a2.secondary_pack_milli = 900;
  a2.compute_tier = RTR2_TIER_LOCAL; a2.compute_tier_milli = 900;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].npacks == 2 && p2[0].capability_packs[1] == "general" && p2[0].compute_tier == "local_inkling";
  // ntiers == 1 (only local) does NOT emit unsure_tier; ntiers == 2 with unsure tier DOES emit unsure_tier
  q2[0] = Rtr2PlanRequest.{text = "fix bug", local_inkling_ready = true, cloud_ready = false};
  rtr2_eligible(q2[..], e2[..]);
  a2 = rtr2_no_answers(); a2.has = true; a2.primary_pack = RTR2_PACK_CODER; a2.primary_pack_milli = 900;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].nreasons == 0;
  // difficulty == 0 on coder vs difficulty == -1 on coder (eff_diff == 2 -> cloud_fast, not cloud_deep!)
  q2[0] = Rtr2PlanRequest.{text = "fix bug", local_inkling_ready = true, cloud_ready = true};
  rtr2_eligible(q2[..], e2[..]);
  a2 = rtr2_no_answers(); a2.has = true; a2.primary_pack = RTR2_PACK_CODER; a2.primary_pack_milli = 900; a2.difficulty = 0;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].compute_tier == "cloud_fast" && p2[0].effort == "medium";
  a2.difficulty = -1;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].compute_tier == "cloud_fast" && p2[0].effort == "medium";
  a2.primary_pack = RTR2_PACK_GENERAL;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].compute_tier == "local_inkling" && p2[0].effort == "low";

  // Final 20 boundary kills across v1 & v2
  // Line 189: !a.has ignores named_station even with milli=900; named_station==2 emits 0 reasons (not named_station_cannot)
  rtr_fx_two(q[..]); q[0].stations[0].nothing_heavy = false;
  a = rtr_fx_answer(1, 0); a.has = false; a.named_station = 0; a.named_station_milli = 900; a.station_for[1] = 0; a.station_for_milli[1] = 900;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].station == "mac" && d[0].reasons[0] == "door_unavailable" && d[0].nreasons == 1;
  // Line 200: !a.has with station_for[1] == 0 and station_for_milli[1] == 900 on coderos-only claude -> must pick roomiest coderos (1), not mac (0)
  q[0].stations[0].agents[0].logged_in = false;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].engine == "codex" && d[0].station == "coderos" && d[0].nreasons == 1;
  rtr_fx_two(q[..]); q[0].stations[0].nothing_heavy = false;
  a = rtr_fx_answer(1, 1); a.named_station = 2; a.named_station_milli = 900;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].station == "coderos" && d[0].nreasons == 0;
  // Line 204: 3 stations where 2 run codex and 1 does not -> runs==2 (not 1), emits unsure_station
  q[0].n = 3; q[0].stations[2] = q[0].stations[0]; q[0].stations[2].id = "box3"; q[0].stations[2].agents[1].logged_in = false;
  a = rtr_fx_answer(1, 1); a.station_for_milli[1] = 100;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].reasons[0] == "unsure_station";
  // Line 206: answer == 0 on a nothing_heavy station with weight == 2 -> emits too_heavy_for_station (not unsure_station)
  rtr_fx_two(q[..]);
  a = rtr_fx_answer(1, 0); a.weight = 2;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].station == "coderos" && d[0].reasons[0] == "too_heavy_for_station";
  // Line 249 & 252: station == 0 (mac) with claude does NOT enter engine_moved loop; and when codex moves to claude on mac (station 0), micro (2) does NOT overwrite it!
  rtr_fx_two(q[..]); q[0].stations[0].nothing_heavy = false;
  a = rtr_fx_answer(0, 0);
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].nreasons == 0;
  q[0].stations[0].agents[1].logged_in = false;
  q[0].stations[0].agents[2] = RtrAgent.{reported = true, installed = true, logged_in = true};
  a = rtr_fx_answer(1, 1); a.needs = RTR_NEED_APPLE;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].reasons[0] == "engine_moved";

  // Line 570 & 572: rtr2_has_ci index 0 mismatch and end-of-string non-match
  #assert !rtr2_has_ci("ab", "xb") && !rtr2_has_ci("ab", "bc");
  // Line 693: missing capability when available_packs = ["capability_author", "knowledge"] (no general) -> mounts only capability_author
  q2[0] = Rtr2PlanRequest.{text = "post to slack", local_inkling_ready = true};
  q2[0].available_packs[0] = "capability_author"; q2[0].available_packs[1] = "knowledge"; q2[0].navailable_packs = 2;
  rtr2_eligible(q2[..], e2[..]);
  a2 = rtr2_no_answers(); a2.has = true; a2.missing_cap_milli = 900;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].npacks == 1 && p2[0].capability_packs[0] == "capability_author";
  // Line 701: cont preserves active_packs[0] == "general" (k == 0) ahead of primary_pack == "coder"
  q2[0] = Rtr2PlanRequest.{text = "next", local_inkling_ready = true, cloud_ready = true};
  q2[0].active_packs[0] = "general"; q2[0].nactive_packs = 1;
  rtr2_eligible(q2[..], e2[..]);
  a2 = rtr2_no_answers(); a2.has = true; a2.continue_milli = 900; a2.primary_pack = RTR2_PACK_CODER; a2.primary_pack_milli = 900;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].capability_packs[0] == "general" && p2[0].capability_packs[1] == "coder";
  // Line 711: offline fallback picks wallet when available, falls back to general when wallet unavailable
  q2[0] = Rtr2PlanRequest.{text = "check wallet", local_inkling_ready = true};
  q2[0].available_packs[0] = "general"; q2[0].available_packs[1] = "wallet"; q2[0].navailable_packs = 2;
  rtr2_eligible(q2[..], e2[..]);
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], rtr2_no_answers(), p2[..]);
  #assert p2[0].ok && p2[0].capability_packs[0] == "wallet";
  q2[0].navailable_packs = 1;
  rtr2_eligible(q2[..], e2[..]);
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], rtr2_no_answers(), p2[..]);
  #assert p2[0].ok && p2[0].capability_packs[0] == "general";
  // Line 745: ntiers == 2 (local + remote, no cloud) emits unsure_tier when tier is unsure
  q2[0] = Rtr2PlanRequest.{text = "hi", local_inkling_ready = true, cloud_ready = false, remote_station_ready = true};
  rtr2_eligible(q2[..], e2[..]);
  #assert e2[0].ntiers == 2;
  a2 = rtr2_no_answers(); a2.has = true; a2.primary_pack = RTR2_PACK_GENERAL; a2.primary_pack_milli = 900;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].reasons[0] == "unsure_tier";
  // Line 750: cont with active_compute_tier == "local_inkling" (at == 0) on coder pack keeps local_inkling (not cloud_fast!)
  q2[0] = Rtr2PlanRequest.{text = "continue", local_inkling_ready = true, cloud_ready = true, active_compute_tier = "local_inkling"};
  q2[0].active_packs[0] = "coder"; q2[0].nactive_packs = 1;
  rtr2_eligible(q2[..], e2[..]);
  a2 = rtr2_no_answers(); a2.has = true; a2.continue_milli = 900;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].compute_tier == "local_inkling";
  // Line 753: knowledge pack with difficulty == 0 -> local_inkling, whereas difficulty == -1 -> def_diff == 2 -> cloud_fast!
  q2[0] = Rtr2PlanRequest.{text = "docs", local_inkling_ready = true, cloud_ready = true};
  rtr2_eligible(q2[..], e2[..]);
  a2 = rtr2_no_answers(); a2.has = true; a2.primary_pack = RTR2_PACK_KNOWLEDGE; a2.primary_pack_milli = 900; a2.difficulty = 0;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].compute_tier == "local_inkling";
  a2.difficulty = -1;
  rtr2_plan_clear(p2[..]); rtr2_pick(q2[..], e2[..], a2, p2[..]);
  #assert p2[0].ok && p2[0].compute_tier == "cloud_fast";
}
