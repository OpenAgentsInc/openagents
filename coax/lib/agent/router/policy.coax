// The delegation router's rules in code (docs/router/README.md, "Code decides
// what is possible; the model decides among it"). Two steps, both pure:
//
//   rtr_eligible  which computers may take new work and which coding agents
//                 can run on each, from the request's facts, with the one
//                 fact that ruled each other one out. Numbers are compared
//                 here, never by the model.
//   rtr_pick      what runs, from the eligible sets and the decision model's
//                 answers (RtrAnswers; has is false when no door answered).
//
// What rtr_pick holds to, whatever the model answers:
//
//   - What runs is an eligible agent on an eligible computer that has that
//     agent, takes work of the task's weight, and has what the task needs (a
//     Mac that builds for Apple platforms, a GPU, or the conversation's own
//     computer).
//   - The agent, in this order: the one the person named, when it is
//     eligible; the conversation's, while the message continues the same
//     work; the model's answer, when it is sure (RTR_SURE_MILLI); else the
//     most capable eligible one.
//   - The computer, in the same order: the one the person named; the
//     conversation's; the model's answer for the agent that runs; else the
//     one with the most room.
//   - When no computer can run that agent for this task, the most capable
//     agent that some computer can run takes it, and the decision says so.
//   - With no answer, the conversation's agent and computer are kept, else
//     the defaults run, and the work is taken to be heavy.
//
// Not here yet (docs/router/README.md): another account when one runs out,
// and #authority with its mutation pass.
#load "wire.coax";
#load "../engine/route-policy.coax";   // cr_model: the model profile for a difficulty

RTR_FRESH_MS :: 120000;     // a report older than two minutes: the computer is not reachable
RTR_SURE_MILLI :: 500;      // below this probability the default runs
RTR_HEAVY :: 2;             // the weight a "nothing heavy" computer refuses
RTR_EFFORT_NAMES :: [3] string.["low", "medium", "high"];
RTR_LEVEL_NAMES :: [5] string.["trivial", "easy", "moderate", "hard", "very hard"];
RTR_WEIGHT_NAMES :: [3] string.["light", "medium", "heavy"];
RTR_NEED_NONE :: 0; RTR_NEED_APPLE :: 1; RTR_NEED_GPU :: 2; RTR_NEED_THIS :: 3;
RTR_NEED_NAMES :: [4] string.["none", "apple", "gpu", "this_computer"];
RTR_DEPTH_NONE :: 0; RTR_DEPTH_FASTER :: 1; RTR_DEPTH_CAREFUL :: 2;
RTR_DEPTH_NAMES :: [3] string.["none", "faster", "more_careful"];

RtrEligible :: struct {
  station: [RTR_STATIONS] bool;                 // may take new work, and an agent can run there
  pair: [RTR_STATIONS * RTR_ENGINES] bool;       // [station * RTR_ENGINES + engine]: that agent can run on that eligible computer
  engine: [RTR_ENGINES] bool;                   // it can run on at least one eligible computer
  nstations: int;
  nengines: int;
}

// What the decision model answered, as indexes. A question that was not
// asked, or an answer that names nothing known, is -1.
RtrAnswers :: struct {
  has: bool;                               // a door answered
  engine: int;                             // ca_index
  engine_milli: int;
  station_for: [RTR_ENGINES] int;          // the computer if that agent takes the task: a row of the request
  station_for_milli: [RTR_ENGINES] int;
  difficulty: int;                         // 0 to 4
  effort: int;                             // 0 to 2
  weight: int;                             // 0 to 2
  needs: int;                              // RTR_NEED_
  named_station: int;                      // the computer the person asked for: a row; -1 for none
  named_station_milli: int;
  named_engine: int;                       // the agent the person asked for: ca_index; -1 for none
  named_engine_milli: int;
  depth: int;                              // RTR_DEPTH_
  depth_milli: int;
  continue_milli: int;                     // P(the message continues the conversation's work); -1 when not asked
}

rtr_no_answers :: () -> RtrAnswers {
  a := RtrAnswers.{engine = -1, difficulty = -1, effort = -1, weight = -1, needs = -1, named_station = -1, named_engine = -1, depth = -1, continue_milli = -1};
  for k: 0..<RTR_ENGINES { a.station_for[k] = -1; }
  return a;
}

// "" when the computer in row i may take new work, else the one fact that
// rules it out.
rtr_station_fact :: (q: [] RtrRequest, i: int) -> string {
  at := q[0].stations[i].reported_at_ms; now := q[0].now_ms;
  if at <= 0 || now < at || now - at > RTR_FRESH_MS { return "not_reachable"; }
  if q[0].stations[i].keep_clear { return "keep_clear"; }
  if q[0].stations[i].disk_free_mb < q[0].stations[i].disk_floor_mb { return "disk_below_floor"; }
  if q[0].stations[i].max_agents > 0 && q[0].stations[i].work >= q[0].stations[i].max_agents { return "at_agent_limit"; }
  return "";
}

// "" when the agent can take work, else the one fact that rules it out.
rtr_agent_fact :: (a: RtrAgent) -> string {
  if !a.reported || !a.installed { return "not_installed"; }
  if !a.logged_in { return "logged_out"; }
  if a.quota_used_up { return "quota_used_up"; }
  if a.cooldown { return "cooldown"; }
  return "";
}

// Fills e, and d's eligible lists and blocked list.
rtr_eligible :: (q: [] RtrRequest, e: [] RtrEligible, d: [] RtrDecision) {
  e[0] = RtrEligible.{};
  names := RTR_ENGINE_NAMES;
  for i: 0..<q[0].n {
    fact := rtr_station_fact(q, i);
    if fact.count > 0 { rtr_block(d, q[0].stations[i].id, "", fact); continue; }
    any := false;
    for k: 0..<RTR_ENGINES {
      why := rtr_agent_fact(q[0].stations[i].agents[k]);
      if why.count == 0 { e[0].pair[i * RTR_ENGINES + k] = true; any = true; }
      else if q[0].stations[i].agents[k].reported { rtr_block(d, q[0].stations[i].id, names[k], why); }
    }
    if !any { rtr_block(d, q[0].stations[i].id, "", "no_agent"); continue; }
    e[0].station[i] = true; e[0].nstations += 1;
    d[0].eligible_stations[d[0].neligible_stations] = q[0].stations[i].id; d[0].neligible_stations += 1;
  }
  for k: 0..<RTR_ENGINES {
    for i: 0..<q[0].n { if e[0].station[i] && e[0].pair[i * RTR_ENGINES + k] { e[0].engine[k] = true; } }
    if e[0].engine[k] {
      e[0].nengines += 1;
      d[0].eligible_engines[d[0].neligible_engines] = names[k]; d[0].neligible_engines += 1;
    }
  }
}

// Whether the person's rules for the computer in row i allow work of this weight.
rtr_weight_ok :: (q: [] RtrRequest, i: int, weight: int) -> bool {
  return !(q[0].stations[i].nothing_heavy && weight >= RTR_HEAVY);
}

// Whether the computer in row i reports what it is: its OS. One that doesn't
// (its resident service is older than station reports) is known by name only.
rtr_facts_known :: (q: [] RtrRequest, i: int) -> bool { return q[0].stations[i].os.count > 0; }

// Whether the computer in row i has what the task needs. A computer that
// reports no facts is not ruled out by a need it can't be asked about: the
// model chose it by name, and an older computer must stay usable.
rtr_need_ok :: (q: [] RtrRequest, i: int, needs: int) -> bool {
  if needs == RTR_NEED_APPLE { return q[0].stations[i].apple_builds || !rtr_facts_known(q, i); }
  if needs == RTR_NEED_GPU { return q[0].stations[i].gpu.count > 0 || !rtr_facts_known(q, i); }
  if needs == RTR_NEED_THIS { return q[0].current_station.count == 0 || q[0].stations[i].id == q[0].current_station; }
  return true;
}

// Why row i can't run engine for this task, as a reason code; "" when it can.
rtr_why_not :: (q: [] RtrRequest, e: [] RtrEligible, i: int, engine: int, weight: int, needs: int) -> string {
  if i < 0 || i >= q[0].n || engine < 0 || engine >= RTR_ENGINES || !e[0].station[i] { return "station_not_eligible"; }
  if !e[0].pair[i * RTR_ENGINES + engine] { return "station_lacks_engine"; }
  if !rtr_need_ok(q, i, needs) { return "station_lacks_need"; }
  if !rtr_weight_ok(q, i, weight) { return "too_heavy_for_station"; }
  return "";
}

rtr_can :: (q: [] RtrRequest, e: [] RtrEligible, i: int, engine: int, weight: int, needs: int) -> bool {
  return rtr_why_not(q, e, i, engine, weight, needs).count == 0;
}

// Whether row a has more room than row b: less work running, then more free
// memory, then more free disk. Equal rows keep the earlier one.
rtr_more_room :: (q: [] RtrRequest, a: int, b: int) -> bool {
  if q[0].stations[a].work != q[0].stations[b].work { return q[0].stations[a].work < q[0].stations[b].work; }
  if q[0].stations[a].memory_free_mb != q[0].stations[b].memory_free_mb { return q[0].stations[a].memory_free_mb > q[0].stations[b].memory_free_mb; }
  return q[0].stations[a].disk_free_mb > q[0].stations[b].disk_free_mb;
}

// The computer with the most room that can run engine for this task, or -1.
rtr_roomiest :: (q: [] RtrRequest, e: [] RtrEligible, engine: int, weight: int, needs: int) -> int {
  best := -1;
  for i: 0..<q[0].n {
    if !rtr_can(q, e, i, engine, weight, needs) { continue; }
    if best < 0 || rtr_more_room(q, i, best) { best = i; }
  }
  return best;
}

// Whether the conversation's agent and computer are kept: the model says the
// message continues its work, or no door answered and there is a conversation.
rtr_continues :: (q: [] RtrRequest, a: RtrAnswers) -> bool {
  if a.has { return a.continue_milli >= RTR_SURE_MILLI; }
  return q[0].current_station.count > 0 || q[0].current_engine.count > 0;
}

// The computer that runs engine for this task, or -1: the one the person
// named, then the conversation's, then the model's answer for this agent,
// then the one with the most room. With explain, d's reasons say which, and
// why an earlier one was passed over.
rtr_place :: (q: [] RtrRequest, e: [] RtrEligible, a: RtrAnswers, engine: int, weight: int, needs: int, d: [] RtrDecision, explain: bool) -> int {
  if a.has && a.named_station >= 0 && a.named_station < q[0].n && a.named_station_milli >= RTR_SURE_MILLI {
    if rtr_can(q, e, a.named_station, engine, weight, needs) { if explain { rtr_reason(d, "named_station"); } return a.named_station; }
    if explain { rtr_reason(d, "named_station_cannot"); rtr_reason(d, rtr_why_not(q, e, a.named_station, engine, weight, needs)); }
  }
  if rtr_continues(q, a) {
    cur := rtr_station_index(q, q[0].current_station);
    if cur >= 0 {
      if rtr_can(q, e, cur, engine, weight, needs) { if explain { rtr_reason(d, "continued"); } return cur; }
      if explain { rtr_reason(d, "current_cannot"); rtr_reason(d, rtr_why_not(q, e, cur, engine, weight, needs)); }
    }
  }
  answer := ifx a.has then a.station_for[engine] else -1;
  if answer >= 0 && a.station_for_milli[engine] >= RTR_SURE_MILLI && rtr_can(q, e, answer, engine, weight, needs) { return answer; }
  if explain && a.has {
    runs := 0;
    for i: 0..<q[0].n { if e[0].station[i] && e[0].pair[i * RTR_ENGINES + engine] { runs += 1; } }
    if runs == 1 { }     // that question was not asked: nothing differs from an answer
    else if answer < 0 || answer >= q[0].n || rtr_can(q, e, answer, engine, weight, needs) { rtr_reason(d, "unsure_station"); }
    else { rtr_reason(d, rtr_why_not(q, e, answer, engine, weight, needs)); }
  }
  return rtr_roomiest(q, e, engine, weight, needs);
}

// What runs. d already holds rtr_eligible's lists; this sets ok, station,
// engine, model, effort, difficulty, weight, needs, reasons and error.
rtr_pick :: (q: [] RtrRequest, e: [] RtrEligible, a: RtrAnswers, d: [] RtrDecision) {
  names := RTR_ENGINE_NAMES; efforts := RTR_EFFORT_NAMES; need_names := RTR_NEED_NAMES;
  d[0].ok = false;
  if e[0].nstations == 0 { d[0].error = "no_station"; return; }
  if !a.has { rtr_reason(d, "door_unavailable"); }
  // without an answer the work is taken to be heavy, so a "nothing heavy" computer stays clear
  weight := ifx a.has && a.weight >= 0 && a.weight <= 2 then a.weight else RTR_HEAVY;
  difficulty := ifx a.has && a.difficulty >= 0 && a.difficulty <= 4 then a.difficulty else -1;
  effort := ifx a.has && a.effort >= 0 && a.effort <= 2 then a.effort else 2;
  needs := ifx a.has && a.needs >= 1 && a.needs <= 3 then a.needs else RTR_NEED_NONE;
  // the agent: named, the conversation's, the answer when it is sure, the most capable
  engine := -1;
  if a.has && a.named_engine >= 0 && a.named_engine < RTR_ENGINES && a.named_engine_milli >= RTR_SURE_MILLI {
    if e[0].engine[a.named_engine] { engine = a.named_engine; rtr_reason(d, "named_engine"); }
    else { rtr_reason(d, "named_engine_cannot"); }
  }
  if engine < 0 && rtr_continues(q, a) {
    cur := ca_index(q[0].current_engine);
    if cur >= 0 && cur < RTR_ENGINES {
      if e[0].engine[cur] { engine = cur; rtr_reason(d, "continued"); }
      else { rtr_reason(d, "current_cannot"); rtr_reason(d, "engine_not_eligible"); }
    }
  }
  if engine < 0 {
    if a.has && a.engine >= 0 && a.engine < RTR_ENGINES && e[0].engine[a.engine] && a.engine_milli >= RTR_SURE_MILLI { engine = a.engine; }
    else {
      for k: 0..<RTR_ENGINES { if engine < 0 && e[0].engine[k] { engine = k; } }
      if a.has {
        if e[0].nengines == 1 { }     // that question was not asked
        else if a.engine >= 0 && a.engine < RTR_ENGINES && !e[0].engine[a.engine] { rtr_reason(d, "engine_not_eligible"); }
        else { rtr_reason(d, "unsure_engine"); }
      }
    }
  }
  station := rtr_place(q, e, a, engine, weight, needs, d, true);
  if station < 0 {
    // no computer runs that agent for this task: the most capable agent one does
    for k: 0..<RTR_ENGINES {
      if station < 0 && k != engine && e[0].engine[k] {
        s := rtr_place(q, e, a, k, weight, needs, d, false);
        if s >= 0 { station = s; engine = k; rtr_reason(d, "engine_moved"); }
      }
    }
  }
  if station < 0 {
    // why nothing can: no eligible computer has what the task needs, or those that do take nothing this heavy
    has_need := false;
    for i: 0..<q[0].n { if e[0].station[i] && rtr_need_ok(q, i, needs) { has_need = true; } }
    rtr_reason(d, ifx has_need then "too_heavy_for_station" else "station_lacks_need");
    d[0].error = "no_station"; d[0].needs = ifx needs != RTR_NEED_NONE then need_names[needs] else "";
    return;
  }
  if a.has && a.depth_milli >= RTR_SURE_MILLI {
    if a.depth == RTR_DEPTH_FASTER { if effort > 0 { effort -= 1; } rtr_reason(d, "faster"); }
    if a.depth == RTR_DEPTH_CAREFUL { if effort < 2 { effort += 1; } rtr_reason(d, "more_careful"); }
  }
  d[0].ok = true;
  d[0].station = q[0].stations[station].id;
  d[0].engine = names[engine];
  d[0].difficulty = difficulty; d[0].weight = ifx a.has then weight else -1;
  d[0].needs = ifx needs != RTR_NEED_NONE then need_names[needs] else "";
  d[0].effort = efforts[effort];
  d[0].model = cr_model(names[engine], ifx difficulty >= 0 then difficulty else 4);
}

// ---- checks

// Two computers and their agents, for the checks here and in the files that load this one.
// mac: claude and codex ready, one piece of work, nothing heavy. coderos: codex ready, claude logged out, no work.
rtr_fx_two :: (q: [] RtrRequest) {
  q[0] = RtrRequest.{};
  q[0].text = "fix the typo in the README"; q[0].now_ms = 1000000; q[0].n = 2;
  q[0].stations[0].id = "mac"; q[0].stations[0].name = "MacBook Pro"; q[0].stations[0].os = "macos"; q[0].stations[0].reported_at_ms = 990000;
  q[0].stations[0].cores = 12; q[0].stations[0].memory_total_mb = 65536; q[0].stations[0].memory_free_mb = 22000;
  q[0].stations[0].disk_free_mb = 180000; q[0].stations[0].disk_floor_mb = 20000; q[0].stations[0].load_1m_milli = 1200;
  q[0].stations[0].work = 1; q[0].stations[0].nothing_heavy = true; q[0].stations[0].apple_builds = true;
  q[0].stations[0].agents[0] = RtrAgent.{reported = true, installed = true, logged_in = true};
  q[0].stations[0].agents[1] = RtrAgent.{reported = true, installed = true, logged_in = true};
  q[0].stations[1].id = "coderos"; q[0].stations[1].name = "coderos"; q[0].stations[1].os = "linux"; q[0].stations[1].reported_at_ms = 995000;
  q[0].stations[1].cores = 32; q[0].stations[1].memory_total_mb = 131072; q[0].stations[1].memory_free_mb = 90000;
  q[0].stations[1].disk_free_mb = 400000; q[0].stations[1].disk_floor_mb = 20000; q[0].stations[1].load_1m_milli = 300;
  q[0].stations[1].agents[0] = RtrAgent.{reported = true, installed = true, logged_in = false};
  q[0].stations[1].agents[1] = RtrAgent.{reported = true, installed = true, logged_in = true};
}

#test "a computer is ruled out by one fact: its report's age, the person's rule, its disk, its agent limit" {
  q: [1] RtrRequest; rtr_fx_two(q[..]);
  #assert rtr_station_fact(q[..], 0) == "" && rtr_station_fact(q[..], 1) == "";
  q[0].stations[0].reported_at_ms = 1000000 - RTR_FRESH_MS; #assert rtr_station_fact(q[..], 0) == "";
  q[0].stations[0].reported_at_ms = 1000000 - RTR_FRESH_MS - 1; #assert rtr_station_fact(q[..], 0) == "not_reachable";
  q[0].stations[0].reported_at_ms = 0; #assert rtr_station_fact(q[..], 0) == "not_reachable";
  q[0].stations[0].reported_at_ms = 1000001; #assert rtr_station_fact(q[..], 0) == "not_reachable";
  q[0].stations[0].reported_at_ms = 1000000; #assert rtr_station_fact(q[..], 0) == "";
  q[0].stations[0].keep_clear = true; #assert rtr_station_fact(q[..], 0) == "keep_clear";
  q[0].stations[0].keep_clear = false; q[0].stations[0].disk_free_mb = 19999; #assert rtr_station_fact(q[..], 0) == "disk_below_floor";
  q[0].stations[0].disk_free_mb = 20000; #assert rtr_station_fact(q[..], 0) == "";
  q[0].stations[0].max_agents = 1; #assert rtr_station_fact(q[..], 0) == "at_agent_limit";
  q[0].stations[0].max_agents = 2; #assert rtr_station_fact(q[..], 0) == "";
}

#test "an agent is ruled out by one fact: not installed, logged out, quota used up, resting" {
  #assert rtr_agent_fact(RtrAgent.{}) == "not_installed" && rtr_agent_fact(RtrAgent.{reported = true}) == "not_installed";
  #assert rtr_agent_fact(RtrAgent.{reported = true, installed = true}) == "logged_out";
  #assert rtr_agent_fact(RtrAgent.{reported = true, installed = true, logged_in = true, quota_used_up = true}) == "quota_used_up";
  #assert rtr_agent_fact(RtrAgent.{reported = true, installed = true, logged_in = true, cooldown = true}) == "cooldown";
  #assert rtr_agent_fact(RtrAgent.{reported = true, installed = true, logged_in = true}) == "";
}

#test "eligibility lists what can run, and each fact that rules a computer or an agent out" {
  q: [1] RtrRequest; e: [1] RtrEligible; d: [1] RtrDecision;
  rtr_fx_two(q[..]); rtr_decision_clear(d[..]); rtr_eligible(q[..], e[..], d[..]);
  #assert e[0].nstations == 2 && e[0].station[0] && e[0].station[1] && e[0].nengines == 2 && e[0].engine[0] && e[0].engine[1] && !e[0].engine[2];
  #assert e[0].pair[0] && e[0].pair[1] && !e[0].pair[RTR_ENGINES] && e[0].pair[RTR_ENGINES + 1];
  #assert d[0].neligible_stations == 2 && d[0].eligible_stations[1] == "coderos" && d[0].neligible_engines == 2 && d[0].eligible_engines[0] == "claude";
  #assert d[0].nblocked == 1 && d[0].blocked[0].station == "coderos" && d[0].blocked[0].engine == "claude" && d[0].blocked[0].fact == "logged_out";
  // the Mac is kept clear: Claude Code is logged in nowhere else, so only Codex is left
  q[0].stations[0].keep_clear = true; rtr_decision_clear(d[..]); rtr_eligible(q[..], e[..], d[..]);
  #assert e[0].nstations == 1 && !e[0].station[0] && e[0].nengines == 1 && !e[0].engine[0] && e[0].engine[1];
  #assert d[0].nblocked == 2 && d[0].blocked[0].station == "mac" && d[0].blocked[0].engine == "" && d[0].blocked[0].fact == "keep_clear";
  // a computer with no agent that can run is not eligible
  q[0].stations[1].agents[1].quota_used_up = true; rtr_decision_clear(d[..]); rtr_eligible(q[..], e[..], d[..]);
  #assert e[0].nstations == 0 && e[0].nengines == 0 && d[0].nblocked == 4 && d[0].blocked[3].fact == "no_agent" && d[0].blocked[2].fact == "quota_used_up";
}

// Answers with the agent and the computer for it, both sure, and the rest plain.
rtr_fx_answer :: (engine: int, station: int) -> RtrAnswers {
  a := rtr_no_answers(); a.has = true;
  a.engine = engine; a.engine_milli = 900;
  for k: 0..<RTR_ENGINES { a.station_for[k] = station; a.station_for_milli[k] = 900; }
  a.difficulty = 1; a.effort = 1; a.weight = 0; a.needs = RTR_NEED_NONE; a.depth = RTR_DEPTH_NONE; a.depth_milli = 900;
  return a;
}
// One pick on the two computers, from a clean decision.
rtr_fx_pick :: (q: [] RtrRequest, a: RtrAnswers, d: [] RtrDecision) {
  e: [1] RtrEligible;
  rtr_decision_clear(d); rtr_eligible(q, e[..], d); rtr_pick(q, e[..], a, d);
}

#test "what runs: a sure answer, the default when unsure, and never what code ruled out" {
  q: [1] RtrRequest; d: [1] RtrDecision; rtr_fx_two(q[..]);
  a := rtr_fx_answer(1, 1); a.difficulty = 0; a.effort = 0;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "coderos" && d[0].engine == "codex" && d[0].effort == "low" && d[0].difficulty == 0 && d[0].weight == 0 && d[0].model == "" && d[0].needs == "" && d[0].nreasons == 0;
  // a hard task for Claude Code on the Mac
  a = rtr_fx_answer(0, 0); a.difficulty = 3; a.effort = 2; a.weight = 1;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "mac" && d[0].engine == "claude" && d[0].model == "opus" && d[0].effort == "high" && d[0].nreasons == 0;
  // the same, heavy: the Mac takes nothing heavy and coderos has no Claude Code login, so Codex runs on coderos
  a.weight = 2;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "coderos" && d[0].engine == "codex" && d[0].nreasons == 1 && d[0].reasons[0] == "engine_moved";
  // the model answers a computer per agent: Claude Code's is the Mac whatever it says for Codex
  a = rtr_fx_answer(0, 1); a.station_for[0] = 0;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "mac" && d[0].engine == "claude" && d[0].nreasons == 0;
  // an unsure agent: the most capable eligible one, and only the Mac runs it
  a = rtr_fx_answer(1, 1); a.engine_milli = 499;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].nreasons == 1 && d[0].reasons[0] == "unsure_engine";
  // a sure agent and an unsure computer: the one with the most room
  a = rtr_fx_answer(1, 0); a.station_for_milli[1] = 499;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "coderos" && d[0].nreasons == 1 && d[0].reasons[0] == "unsure_station";
  // an agent that is eligible nowhere
  a = rtr_fx_answer(2, 0);
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].reasons[0] == "engine_not_eligible";
}

#test "what a task needs: a Mac that builds for Apple platforms, a GPU, this computer" {
  q: [1] RtrRequest; d: [1] RtrDecision; rtr_fx_two(q[..]); q[0].stations[1].gpu = "RTX 4080";
  // Codex on coderos, but the task is an iOS build: the Mac
  a := rtr_fx_answer(1, 1); a.needs = RTR_NEED_APPLE;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "mac" && d[0].engine == "codex" && d[0].needs == "apple" && d[0].nreasons == 1 && d[0].reasons[0] == "station_lacks_need";
  // Claude Code on the Mac, but the task needs a GPU: only coderos has one, and it runs Codex only
  a = rtr_fx_answer(0, 0); a.needs = RTR_NEED_GPU;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "coderos" && d[0].engine == "codex" && d[0].needs == "gpu" && d[0].nreasons == 1 && d[0].reasons[0] == "engine_moved";
  // a heavy iOS build: the only Mac takes nothing heavy, so nothing runs
  a = rtr_fx_answer(1, 1); a.needs = RTR_NEED_APPLE; a.weight = 2;
  rtr_fx_pick(q[..], a, d[..]);
  #assert !d[0].ok && d[0].error == "no_station" && d[0].needs == "apple" && d[0].station == "" && d[0].reasons[d[0].nreasons - 1] == "too_heavy_for_station";
  // a task that needs a GPU when no eligible computer has one
  q[0].stations[1].keep_clear = true; a = rtr_fx_answer(1, 0); a.needs = RTR_NEED_GPU;
  rtr_fx_pick(q[..], a, d[..]);
  #assert !d[0].ok && d[0].error == "no_station" && d[0].needs == "gpu" && d[0].reasons[d[0].nreasons - 1] == "station_lacks_need";
  q[0].stations[1].keep_clear = false;
  // this computer's files: the conversation's computer, whatever was answered
  q[0].current_station = "mac"; a = rtr_fx_answer(1, 1); a.needs = RTR_NEED_THIS; a.continue_milli = 100;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "mac" && d[0].needs == "this_computer";
  #assert rtr_need_ok(q[..], 0, RTR_NEED_APPLE) && !rtr_need_ok(q[..], 1, RTR_NEED_APPLE) && rtr_need_ok(q[..], 1, RTR_NEED_GPU) && !rtr_need_ok(q[..], 0, RTR_NEED_GPU);
  #assert rtr_need_ok(q[..], 0, RTR_NEED_THIS) && !rtr_need_ok(q[..], 1, RTR_NEED_THIS) && rtr_need_ok(q[..], 1, RTR_NEED_NONE);
  q[0].current_station = ""; #assert rtr_need_ok(q[..], 1, RTR_NEED_THIS);
  // a computer that reports no facts is not ruled out by a Mac or a GPU need
  q[0].stations[1].os = ""; #assert rtr_need_ok(q[..], 1, RTR_NEED_APPLE) && !rtr_facts_known(q[..], 1);
  q[0].stations[0].os = ""; #assert rtr_need_ok(q[..], 0, RTR_NEED_GPU);
}

#test "what the person named wins when it can run, and the decision says when it can't" {
  q: [1] RtrRequest; d: [1] RtrDecision; rtr_fx_two(q[..]);
  // "do it with Codex", though the model would pick Claude Code
  a := rtr_fx_answer(0, 0); a.named_engine = 1; a.named_engine_milli = 950;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "mac" && d[0].reasons[0] == "named_engine";
  // "run it on coderos"
  a = rtr_fx_answer(1, 0); a.named_station = 1; a.named_station_milli = 950;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].station == "coderos" && d[0].engine == "codex" && d[0].reasons[0] == "named_station";
  // "use Claude Code on coderos": it is logged out there, so it runs on the Mac
  a = rtr_fx_answer(1, 1); a.named_engine = 0; a.named_engine_milli = 950; a.named_station = 1; a.named_station_milli = 950;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].nreasons == 3;
  #assert d[0].reasons[0] == "named_engine" && d[0].reasons[1] == "named_station_cannot" && d[0].reasons[2] == "station_lacks_engine";
  // "use Microcoder": it is installed nowhere
  a = rtr_fx_answer(1, 1); a.named_engine = 2; a.named_engine_milli = 950;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "coderos" && d[0].nreasons == 1 && d[0].reasons[0] == "named_engine_cannot";
  // an unsure name is no name
  a = rtr_fx_answer(0, 0); a.named_engine = 1; a.named_engine_milli = 400; a.named_station = 1; a.named_station_milli = 400;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].nreasons == 0;
  // "quick answer" and "think harder" move the effort one step, inside low to high
  a = rtr_fx_answer(1, 1); a.depth = RTR_DEPTH_FASTER;
  rtr_fx_pick(q[..], a, d[..]); #assert d[0].effort == "low" && d[0].reasons[0] == "faster";
  a.effort = 0; rtr_fx_pick(q[..], a, d[..]); #assert d[0].effort == "low";
  a.effort = 1; a.depth = RTR_DEPTH_CAREFUL; rtr_fx_pick(q[..], a, d[..]); #assert d[0].effort == "high" && d[0].reasons[0] == "more_careful";
  a.effort = 2; rtr_fx_pick(q[..], a, d[..]); #assert d[0].effort == "high";
  a.effort = 1; a.depth_milli = 400; rtr_fx_pick(q[..], a, d[..]); #assert d[0].effort == "medium" && d[0].nreasons == 0;
}

#test "a conversation keeps its agent and computer while the message continues its work" {
  q: [1] RtrRequest; d: [1] RtrDecision; rtr_fx_two(q[..]);
  q[0].current_station = "mac"; q[0].current_engine = "claude";
  // the model would send this follow-up to Codex on coderos; the conversation stays, and the model follows the message
  a := rtr_fx_answer(1, 1); a.continue_milli = 900; a.difficulty = 3;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].model == "opus" && d[0].nreasons == 1 && d[0].reasons[0] == "continued";
  // different work: the answer runs
  a.continue_milli = 200;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "coderos" && d[0].nreasons == 0;
  // a named agent beats the conversation's, and the conversation's computer is kept when it runs that agent
  a.continue_milli = 900; a.named_engine = 1; a.named_engine_milli = 950;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "mac" && d[0].reasons[0] == "named_engine" && d[0].reasons[1] == "continued";
  // the conversation's agent has run out: the answer runs, and the decision says why
  a = rtr_fx_answer(1, 1); a.continue_milli = 900; q[0].stations[0].agents[0].quota_used_up = true;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "mac" && d[0].reasons[0] == "current_cannot" && d[0].reasons[1] == "engine_not_eligible" && d[0].reasons[2] == "continued";
  // the conversation's computer is kept clear now: its agent moves to where it can run
  q[0].stations[0].agents[0].quota_used_up = false; q[0].stations[1].agents[0].logged_in = true; q[0].stations[0].keep_clear = true;
  rtr_fx_pick(q[..], a, d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "coderos" && d[0].reasons[0] == "continued" && d[0].reasons[1] == "current_cannot" && d[0].reasons[2] == "station_not_eligible";
}

#test "no door: the conversation is kept, else the most capable agent, the work taken to be heavy" {
  q: [1] RtrRequest; d: [1] RtrDecision; rtr_fx_two(q[..]);
  rtr_fx_pick(q[..], rtr_no_answers(), d[..]);
  // Claude Code is the most capable, only the Mac runs it, and the Mac takes nothing heavy: Codex on coderos
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "coderos" && d[0].effort == "high" && d[0].difficulty == -1 && d[0].weight == -1;
  #assert d[0].nreasons == 2 && d[0].reasons[0] == "door_unavailable" && d[0].reasons[1] == "engine_moved";
  q[0].stations[0].nothing_heavy = false;
  rtr_fx_pick(q[..], rtr_no_answers(), d[..]);
  #assert d[0].ok && d[0].engine == "claude" && d[0].station == "mac" && d[0].model == "opus" && d[0].nreasons == 1;
  // a conversation on Codex on coderos stays there
  q[0].current_station = "coderos"; q[0].current_engine = "codex";
  rtr_fx_pick(q[..], rtr_no_answers(), d[..]);
  #assert d[0].ok && d[0].engine == "codex" && d[0].station == "coderos" && d[0].reasons[0] == "door_unavailable" && d[0].reasons[1] == "continued";
  // nothing eligible, and only computers that take nothing heavy
  q[0].current_station = ""; q[0].current_engine = "";
  q[0].stations[0].keep_clear = true; q[0].stations[1].keep_clear = true;
  rtr_fx_pick(q[..], rtr_no_answers(), d[..]);
  #assert !d[0].ok && d[0].error == "no_station" && d[0].station == "";
  q[0].stations[0].keep_clear = false; q[0].stations[0].nothing_heavy = true;
  rtr_fx_pick(q[..], rtr_no_answers(), d[..]);
  #assert !d[0].ok && d[0].error == "no_station" && d[0].reasons[1] == "too_heavy_for_station";
}

// Draw k of case v: 0 to n - 1.
rtr_fx_draw :: (v: int, k: int, n: int) -> int {
  x := ((v % 65521) * 31 + k * 7919 + 17) % 65521;
  x = (x * 1103 + 12345) % 65521;
  x = (x * 1103 + 12345) % 65521;
  return x % n;
}
// Case v of the pick's fuzz: the two computers under a mix of rules, logins
// and a conversation, and answers drawn from v, past the tables too.
rtr_fx_case :: (q: [] RtrRequest, v: int) -> RtrAnswers {
  rtr_fx_two(q);
  q[0].stations[1].gpu = "RTX 4080";
  q[0].stations[0].keep_clear = rtr_fx_draw(v, 1, 4) == 0; q[0].stations[1].nothing_heavy = rtr_fx_draw(v, 2, 2) == 0;
  q[0].stations[0].agents[0].logged_in = rtr_fx_draw(v, 3, 3) != 0; q[0].stations[1].agents[0].logged_in = rtr_fx_draw(v, 4, 2) == 0;
  q[0].stations[1].agents[1].quota_used_up = rtr_fx_draw(v, 5, 4) == 0;
  cs := rtr_fx_draw(v, 6, 3); ce := rtr_fx_draw(v, 7, 3);
  q[0].current_station = ifx cs == 1 then "mac" else ifx cs == 2 then "coderos" else "";
  q[0].current_engine = ifx ce == 1 then "claude" else ifx ce == 2 then "codex" else "";
  a := rtr_no_answers();
  a.has = rtr_fx_draw(v, 8, 8) != 0;
  a.engine = rtr_fx_draw(v, 9, 7) - 1; a.engine_milli = ifx rtr_fx_draw(v, 10, 3) == 0 then 100 else 900;
  for k: 0..<RTR_ENGINES { a.station_for[k] = rtr_fx_draw(v, 11 + k, 4) - 1; a.station_for_milli[k] = ifx rtr_fx_draw(v, 15 + k, 3) == 0 then 100 else 900; }
  a.difficulty = rtr_fx_draw(v, 19, 7) - 1; a.effort = rtr_fx_draw(v, 20, 5) - 1; a.weight = rtr_fx_draw(v, 21, 5) - 1;
  a.needs = rtr_fx_draw(v, 22, 6) - 1;
  a.named_station = rtr_fx_draw(v, 23, 6) - 3; a.named_station_milli = ifx rtr_fx_draw(v, 24, 2) == 0 then 100 else 900;
  a.named_engine = rtr_fx_draw(v, 25, 9) - 4; a.named_engine_milli = ifx rtr_fx_draw(v, 26, 2) == 0 then 100 else 900;
  a.depth = rtr_fx_draw(v, 27, 4) - 1; a.depth_milli = ifx rtr_fx_draw(v, 28, 2) == 0 then 100 else 900;
  a.continue_milli = ifx rtr_fx_draw(v, 29, 3) == 0 then -1 else ifx rtr_fx_draw(v, 30, 2) == 0 then 100 else 900;
  return a;
}

// Whatever the model answers: what runs is a computer code allows, running
// an agent that can run there, at a weight its rules take, with what the
// task needs. What the person named runs whenever it can.
#forall "whatever the model answers, what runs is allowed, and what was named runs when it can" v:0..<30000 {
  q: [1] RtrRequest; e: [1] RtrEligible; d: [1] RtrDecision;
  a := rtr_fx_case(q[..], v);
  rtr_decision_clear(d[..]); rtr_eligible(q[..], e[..], d[..]); rtr_pick(q[..], e[..], a, d[..]);
  weight := ifx a.has && a.weight >= 0 && a.weight <= 2 then a.weight else RTR_HEAVY;
  needs := ifx a.has && a.needs >= 1 && a.needs <= 3 then a.needs else RTR_NEED_NONE;
  if d[0].ok {
    s := rtr_station_index(q[..], d[0].station); k := ca_index(d[0].engine);
    #assert s >= 0 && k >= 0 && k < RTR_ENGINES && e[0].station[s] && e[0].pair[s * RTR_ENGINES + k];
    #assert rtr_station_fact(q[..], s) == "" && rtr_agent_fact(q[0].stations[s].agents[k]) == "";
    #assert rtr_weight_ok(q[..], s, weight) && rtr_need_ok(q[..], s, needs);
    #assert d[0].error == "" && d[0].effort.count > 0;
    named_engine := a.has && a.named_engine >= 0 && a.named_engine < RTR_ENGINES && a.named_engine_milli >= RTR_SURE_MILLI;
    if named_engine && rtr_roomiest(q[..], e[..], a.named_engine, weight, needs) >= 0 { #assert k == a.named_engine; }
    named_station := a.has && a.named_station >= 0 && a.named_station < q[0].n && a.named_station_milli >= RTR_SURE_MILLI;
    if named_station && rtr_can(q[..], e[..], a.named_station, k, weight, needs) { #assert s == a.named_station; }
    // a conversation that continues keeps its computer when that computer can run what runs, and nothing was named
    cur := rtr_station_index(q[..], q[0].current_station);
    if !named_station && rtr_continues(q[..], a) && cur >= 0 && rtr_can(q[..], e[..], cur, k, weight, needs) { #assert s == cur; }
  } else {
    #assert d[0].error == "no_station" && d[0].station == "" && d[0].engine == "";
    // nothing ran only because nothing could: no eligible agent has a computer for this task
    for k: 0..<RTR_ENGINES { #assert rtr_roomiest(q[..], e[..], k, weight, needs) == -1; }
  }
}
