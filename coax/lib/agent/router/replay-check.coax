// The router against answers Google gave (docs/router/README.md). On
// 2026-11-14 every task of the two labelled sets went to Gemini Decision 1
// with the sample computers (fixtures/stations.json): fixtures/labels.tsv,
// which the questions' wording was tuned on, and fixtures/labels-held.tsv,
// which was written afterwards and scored once. fixtures/google/ and
// fixtures/google-held/ hold each request as it was sent and each answer as
// it came back. This check rebuilds each request and holds it to the recorded
// bytes, holds each recorded answer to its request as a live one is held,
// decides, and scores the wants. It fails when a request changed, an answer
// no longer holds, or fewer wants are right than on that day.
//
// A change to the questions, the labels or the sample computers changes the
// requests, and this check then fails by design. Record both sets again and
// set the two numbers below to what the new answers score:
//   coax/web/tool.sh coax/lib/agent/router/router.coax eval --door google --save coax/lib/agent/router/fixtures/google
//   coax/web/tool.sh coax/lib/agent/router/router.coax eval --door google --labels coax/lib/agent/router/fixtures/labels-held.tsv --save coax/lib/agent/router/fixtures/google-held
// Tune wording on the first set only. A change that lowers either score
// needs a reason in its commit.
//   coax/web/tool.sh coax/lib/agent/router/replay-check.coax
#import "Basic";
#load "eval.coax";
#load "../../sys/tool.coax";
#load "../../sys/args.coax";

RTRR_STATIONS :: "coax/lib/agent/router/fixtures/stations.json";
RTRR_TUNED_RIGHT :: 66;     // of 66 wants, 33 tasks, on 2026-11-14
RTRR_HELD_RIGHT :: 30;      // of 31 wants, 20 tasks, on 2026-11-14

// One labelled set against its recorded exchanges: true when every exchange holds and at least floor wants are right.
rtrr_set :: (name: string, labels: string, dir: string, needed: int, q: [] RtrRequest) -> bool {
  lraw: [131072] u8; rows: [RTREV_ROWS] RtrevRow;
  ln := fs_read(labels, lraw[..]);
  n := ifx ln > 0 && ln < lraw.count then rtrev_rows(cast(string) lraw[0..<ln], rows[..]) else -1;
  if n <= 0 { print("FAIL %: the labels do not read\n", name); return false; }
  d: [1] RtrDecision; w: [1] RtrWork; e: [1] RtrEligible;
  sent: [32768] u8; got: [65536] u8; ab: [4096] u8; ar: [1] ClArena; miss: [256] u8; nm: [1] int;
  wants := 0; right := 0; bad := 0;
  for i: 0..<n {
    ar[0] = ClArena.{buf = ab[..]};
    problem := rtrev_replay(dir, q, e[..], rows[i], d[..], w[..], sent[..], got[..], ar[..]);
    if problem.count > 0 { print("FAIL %, %: %\n", name, rows[i].id, problem); bad += 1; continue; }
    s := rtrev_score(d[..], rows[i].want, miss[..], nm[..]);
    wants += s.wants; right += s.right;
    if s.right < s.wants { print("miss  %, %: %\n", name, rows[i].id, cast(string) miss[0..<nm[0]]); }
  }
  print("%: % tasks, % of % wants right (% needed), % exchanges that no longer hold\n", name, n, right, wants, needed, bad);
  return bad == 0 && right >= needed;
}

tool_main :: () -> int #export_c #effects(all) {
  raw: [RTR_REQUEST_MAX] u8; nodes: [16384] JvNode; wire: [RTR_REQUEST_MAX] u8; q: [1] RtrRequest;
  sn := fs_read(RTRR_STATIONS, raw[..]);
  if sn <= 0 || !rtr_request_read(cast(string) raw[0..<sn], nodes[..], wire[..], q[..]) { print("FAIL the sample computers do not read\n"); return 1; }
  good := rtrr_set("tuned", "coax/lib/agent/router/fixtures/labels.tsv", "coax/lib/agent/router/fixtures/google", RTRR_TUNED_RIGHT, q[..]);
  good = rtrr_set("held out", "coax/lib/agent/router/fixtures/labels-held.tsv", "coax/lib/agent/router/fixtures/google-held", RTRR_HELD_RIGHT, q[..]) && good;
  if !good { print("router replay fails\n"); return 1; }
  print("router replay holds\n");
  return 0;
}
