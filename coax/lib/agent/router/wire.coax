// The delegation router on the wire (docs/router/README.md): the one codec of
// openagents.router.v1alpha1 (proto/openagents/router/v1alpha1/router.proto).
// A RouteRequest is a coding task and what each connected computer reports;
// a RouteDecision says which computer, coding agent, model and effort take
// it, and why. Both go through the JSON mapper (#import_proto with the json
// option), so the keys are the schema's json_names in field-number order and
// a zero, empty or false field without presence is left out.
//
// rtr_request_read turns a request's JSON into an RtrRequest and
// rtr_request_write turns it back; rtr_decision_write turns an RtrDecision
// into JSON. Every string in an RtrRequest borrows the
// reader's wire buffer; every string in an RtrDecision borrows what its maker
// gave it (the request, or a constant).
//
// Generated proto code can't run in a compile-time #test (it asks whether
// buffers overlap), so this codec's checks are a tool that runs natively.
// Goldens: proto/coder/router-v1alpha1.json, held by wire-goldens.coax:
//   coax/web/tool.sh coax/lib/agent/router/wire-goldens.coax
#import_proto "../../../../proto/descriptors/router.pb" as RTP;
#import_proto "../../../../proto/descriptors/router-v2.pb" as RTP2;
#load "../../proto/json.coax";
#load "../engine/availability-policy.coax";   // ca_index: an engine's place in claude, codex, micro, psionic

RTR_REQUEST_SCHEMA :: "openagents.router.request.v1alpha1";
RTR_DECISION_SCHEMA :: "openagents.router.decision.v1alpha1";
RTR_STATIONS :: 16;      // computers in one request
RTR_ENGINES :: 4;        // claude, codex, micro, psionic
RTR_REPOS :: 16;
RTR_WORK :: 16;          // pieces of work one computer reports         // repositories one computer reports
RTR_REASONS :: 12;
RTR_ANSWERS :: 16;
RTR_BLOCKED :: 80;       // every computer, and every agent on every computer
RTR_ID_MAX :: 32;        // a station_id: 1 to 32 of [a-z0-9-]
RTR_TEXT_MAX :: 16384;   // the task
RTR_REQUEST_MAX :: 131072;   // a request's JSON, and its wire
RTR_DECISION_MAX :: 32768;   // a decision's JSON, and its wire

RTR_ENGINE_NAMES :: [RTR_ENGINES] string.["claude", "codex", "micro", "psionic"];

RtrAgent :: struct {
  reported: bool;        // the computer's report lists this agent
  installed: bool;
  logged_in: bool;
  quota_used_up: bool;
  cooldown: bool;
  version: string;
  plan: string;
  quota_resets_at: string;
}

RtrStation :: struct {
  id: string;
  name: string;
  os: string;
  gpu: string;
  reported_at_ms: int;
  cores: int;
  memory_total_mb: int;
  memory_free_mb: int;
  disk_free_mb: int;
  disk_floor_mb: int;
  load_1m_milli: int;
  load_15m_milli: int;
  apple_builds: bool;
  in_use: bool;
  agents: [RTR_ENGINES] RtrAgent;   // by ca_index
  work: int;                      // pieces of work it runs now
  work_engine: [RTR_WORK] string;
  work_model: [RTR_WORK] string;
  work_title: [RTR_WORK] string;
  work_state: [RTR_WORK] string;
  work_started_at_ms: [RTR_WORK] int;
  repos: [RTR_REPOS] string;
  nrepos: int;
  keep_clear: bool;
  nothing_heavy: bool;
  max_agents: int;                // 0: no limit
}

RtrRequest :: struct {
  text: string;
  summary: string;
  repo: string;
  current_station: string;
  current_engine: string;
  current_model: string;
  now_ms: int;
  stations: [RTR_STATIONS] RtrStation;
  n: int;
}

RtrAnswer :: struct {
  key: string;
  choice: string;
  level: int;            // -1: no level (a choice)
  milli: int;            // -1: no probability
}

RtrBlocked :: struct {
  station: string;
  engine: string;        // "": the computer itself is ruled out
  fact: string;
}

RtrDecision :: struct {
  ok: bool;
  station: string;
  engine: string;
  model: string;
  effort: string;
  difficulty: int;       // -1: not decided
  weight: int;           // -1: not decided
  door: string;
  door_problem: string;
  reasons: [RTR_REASONS] string;
  nreasons: int;
  answers: [RTR_ANSWERS] RtrAnswer;
  nanswers: int;
  eligible_stations: [RTR_STATIONS] string;
  neligible_stations: int;
  eligible_engines: [RTR_ENGINES] string;
  neligible_engines: int;
  blocked: [RTR_BLOCKED] RtrBlocked;
  nblocked: int;
  input_tokens: int;
  latency_ms: int;
  error: string;
  needs: string;         // apple, gpu, this_computer; "": nothing
}

// A decision with nothing decided.
rtr_decision_clear :: (d: [] RtrDecision) {
  d[0] = RtrDecision.{};
  d[0].difficulty = -1; d[0].weight = -1;
}

rtr_reason :: (d: [] RtrDecision, code: string) {
  for i: 0..<d[0].nreasons { if d[0].reasons[i] == code { return; } }
  if d[0].nreasons < RTR_REASONS { d[0].reasons[d[0].nreasons] = code; d[0].nreasons += 1; }
}

rtr_block :: (d: [] RtrDecision, station: string, engine: string, fact: string) {
  if d[0].nblocked >= RTR_BLOCKED { return; }
  d[0].blocked[d[0].nblocked] = RtrBlocked.{station = station, engine = engine, fact = fact};
  d[0].nblocked += 1;
}

rtr_answer :: (d: [] RtrDecision, key: string, choice: string, level: int, milli: int) {
  if d[0].nanswers >= RTR_ANSWERS { return; }
  d[0].answers[d[0].nanswers] = RtrAnswer.{key = key, choice = choice, level = level, milli = milli};
  d[0].nanswers += 1;
}

// Whether id can name a computer: 1 to 32 of a-z, 0-9 and "-", and not
// "none". It becomes an option key of the station questions, where "none"
// means that the person named no computer, so nothing else is taken.
rtr_id_ok :: (id: string) -> bool {
  if id.count == 0 || id.count > RTR_ID_MAX || id == "none" { return false; }
  for c: id { if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') { return false; } }
  return true;
}

// Appends s to out at n: the new length (what does not fit is dropped).
rtr_put :: (out: [] u8, n: int, s: string) -> int {
  m := n;
  for c: s { if m < out.count { out[m] = c; m += 1; } }
  return m;
}

// A computer's name as a station_id: lower case, anything outside a-z, 0-9
// and "-" becomes "-", runs of "-" are one, at most 32, and "this-computer"
// when nothing is left or the name is "none".
rtr_id_from_name :: (name: string, out: [] u8) -> string {
  n := 0; keep := 0;       // keep: the length up to the last letter or digit, so no id ends in "-"
  for c: name {
    if n == RTR_ID_MAX || n == out.count { break; }
    upper := c >= 'A' && c <= 'Z';
    if upper || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') { out[n] = ifx upper then c + 32 else c; n += 1; keep = n; }
    else if keep == n && n != 0 { out[n] = '-'; n += 1; }
  }
  id := cast(string) out[0..<keep];
  return ifx rtr_id_ok(id) then id else "this-computer";
}
#test "a name becomes an id: letters lowered, digits kept, anything else one dash, never at an end" {
  b: [64] u8;
  #assert rtr_id_from_name("AZaz09", b[..]) == "azaz09" && rtr_id_from_name("MacBook Pro", b[..]) == "macbook-pro" && rtr_id_from_name("My Mac (2).local", b[..]) == "my-mac-2-local";
  // the bytes beside each range are not letters or digits: @ [ ` { / :
  #assert rtr_id_from_name("a@b", b[..]) == "a-b" && rtr_id_from_name("a[b", b[..]) == "a-b" && rtr_id_from_name("a`b", b[..]) == "a-b";
  #assert rtr_id_from_name("a{b", b[..]) == "a-b" && rtr_id_from_name("a/b", b[..]) == "a-b" && rtr_id_from_name("a:b", b[..]) == "a-b";
  #assert rtr_id_from_name("--x__y--", b[..]) == "x-y" && rtr_id_from_name("a-", b[..]) == "a" && rtr_id_from_name("-a", b[..]) == "a" && rtr_id_from_name("a--b", b[..]) == "a-b";
  #assert rtr_id_from_name("", b[..]) == "this-computer" && rtr_id_from_name("none", b[..]) == "this-computer" && rtr_id_from_name("???", b[..]) == "this-computer";
  // at most 32, and no more than the buffer holds
  #assert rtr_id_from_name("0123456789012345678901234567890123", b[..]) == "01234567890123456789012345678901" && rtr_id_from_name("a-very-long-host-name-that-goes-on-and-on", b[..]) == "a-very-long-host-name-that-goes";
  #assert rtr_id_from_name("abcdef", b[0..<4]) == "abcd" && rtr_id_from_name("abc-ef", b[0..<4]) == "abc";
}

// The computer called id in q: its index, or -1.
rtr_station_index :: (q: [] RtrRequest, id: string) -> int {
  for i: 0..<q[0].n { if q[0].stations[i].id == id { return i; } }
  return -1;
}

// One computer of a request into q's row i. False for an id rtr_id_ok refuses,
// an agent the router doesn't know twice, or a list over its bound.
rtr_station_read :: (v: RTP_Station, q: [] RtrRequest, i: int) -> bool {
  id := RTP_Station_get_station_id(v); name := RTP_Station_get_display_name(v);
  os := RTP_Station_get_os(v); gpu := RTP_Station_get_gpu(v);
  at := RTP_Station_get_reported_at_ms(v); cores := RTP_Station_get_cpu_cores(v);
  mt := RTP_Station_get_memory_total_mb(v); mf := RTP_Station_get_memory_free_mb(v);
  df := RTP_Station_get_disk_free_mb(v); dfl := RTP_Station_get_disk_floor_mb(v);
  l1 := RTP_Station_get_load_1m_milli(v); l15 := RTP_Station_get_load_15m_milli(v);
  apple := RTP_Station_get_apple_builds(v); in_use := RTP_Station_get_in_use(v);
  if !rtr_id_ok(id.value) { return false; }
  q[0].stations[i] = RtrStation.{};
  q[0].stations[i].id = id.value;
  q[0].stations[i].name = ifx name.value.count > 0 then name.value else id.value;
  q[0].stations[i].os = os.value; q[0].stations[i].gpu = gpu.value;
  q[0].stations[i].reported_at_ms = cast(int) at.value; q[0].stations[i].cores = cast(int) cores.value;
  q[0].stations[i].memory_total_mb = cast(int) mt.value; q[0].stations[i].memory_free_mb = cast(int) mf.value;
  q[0].stations[i].disk_free_mb = cast(int) df.value; q[0].stations[i].disk_floor_mb = cast(int) dfl.value;
  q[0].stations[i].load_1m_milli = cast(int) l1.value; q[0].stations[i].load_15m_milli = cast(int) l15.value;
  q[0].stations[i].apple_builds = apple.value; q[0].stations[i].in_use = in_use.value;
  rules := RTP_Station_get_rules(v);
  if rules.present {
    kc := RTP_StationRules_get_keep_clear(rules.value); nh := RTP_StationRules_get_nothing_heavy(rules.value);
    ma := RTP_StationRules_get_max_agents(rules.value);
    q[0].stations[i].keep_clear = kc.value; q[0].stations[i].nothing_heavy = nh.value;
    q[0].stations[i].max_agents = cast(int) ma.value;
  }
  ai := RTP_Station_iter_agents(v);
  while ai.has_value {
    engine := RTP_StationAgent_get_engine(ai.value);
    k := ca_index(engine.value);
    if k >= 0 && k < RTR_ENGINES {
      if q[0].stations[i].agents[k].reported { return false; }
      installed := RTP_StationAgent_get_installed(ai.value); logged_in := RTP_StationAgent_get_logged_in(ai.value);
      used := RTP_StationAgent_get_quota_used_up(ai.value); cooldown := RTP_StationAgent_get_cooldown(ai.value);
      version := RTP_StationAgent_get_version(ai.value); plan := RTP_StationAgent_get_plan(ai.value);
      resets := RTP_StationAgent_get_quota_resets_at(ai.value);
      q[0].stations[i].agents[k] = RtrAgent.{reported = true, installed = installed.value, logged_in = logged_in.value,
        quota_used_up = used.value, cooldown = cooldown.value, version = version.value, plan = plan.value, quota_resets_at = resets.value};
    }
    ai = RTP_Station_next_agents(ai);
  }
  wi := RTP_Station_iter_work(v);
  while wi.has_value {
    k := q[0].stations[i].work;
    if k == RTR_WORK { return false; }
    we := RTP_StationWork_get_engine(wi.value); wm := RTP_StationWork_get_model(wi.value); wt := RTP_StationWork_get_title(wi.value);
    ws := RTP_StationWork_get_state(wi.value); wa := RTP_StationWork_get_started_at_ms(wi.value);
    q[0].stations[i].work_engine[k] = we.value; q[0].stations[i].work_model[k] = wm.value; q[0].stations[i].work_title[k] = wt.value;
    q[0].stations[i].work_state[k] = ws.value; q[0].stations[i].work_started_at_ms[k] = cast(int) wa.value;
    q[0].stations[i].work += 1;
    wi = RTP_Station_next_work(wi);
  }
  ri := RTP_Station_iter_repos(v);
  while ri.has_value {
    if q[0].stations[i].nrepos == RTR_REPOS { return false; }
    q[0].stations[i].repos[q[0].stations[i].nrepos] = ri.value; q[0].stations[i].nrepos += 1;
    ri = RTP_Station_next_repos(ri);
  }
  return true;
}

// A request's JSON into q. False for a body that is not a RouteRequest, more
// than RTR_STATIONS computers, two computers with one id, or a task over
// RTR_TEXT_MAX. wire must not overlap text, and q's strings borrow it.
rtr_request_read :: (text: string, nodes: [] JvNode, wire: [] u8, q: [] RtrRequest) -> bool {
  m := RTP_RouteRequest_from_json(text, nodes, wire);
  if m.error != 0 { return false; }
  task := RTP_RouteRequest_get_text(m); summary := RTP_RouteRequest_get_summary(m); repo := RTP_RouteRequest_get_repo(m);
  cs := RTP_RouteRequest_get_current_station(m); ce := RTP_RouteRequest_get_current_engine(m); cm := RTP_RouteRequest_get_current_model(m);
  now := RTP_RouteRequest_get_now_ms(m);
  if task.value.count > RTR_TEXT_MAX { return false; }
  q[0] = RtrRequest.{};
  q[0].text = task.value; q[0].summary = summary.value; q[0].repo = repo.value;
  q[0].current_station = cs.value; q[0].current_engine = ce.value; q[0].current_model = cm.value;
  q[0].now_ms = cast(int) now.value;
  si := RTP_RouteRequest_iter_stations(m);
  while si.has_value {
    if q[0].n == RTR_STATIONS { return false; }
    if !rtr_station_read(si.value, q, q[0].n) { return false; }
    if rtr_station_index(q, q[0].stations[q[0].n].id) != -1 { return false; }   // q[0].n is not counted yet: an earlier row has the id
    q[0].n += 1;
    si = RTP_RouteRequest_next_stations(si);
  }
  return true;
}

// The computer in row i as a Station message. It is built in sa and sb (each
// at least RTR_STATION_MAX) and borrows one of them; ca and cb hold its
// children while they are built.
RTR_STATION_MAX :: 8192;
rtr_station_message :: (q: [] RtrRequest, i: int, sa: [] u8, sb: [] u8, ca: [] u8, cb: [] u8) -> RTP_Station {
  names := RTR_ENGINE_NAMES;
  m := RTP_Station_new();
  m = RTP_Station_set_station_id(m, q[0].stations[i].id, sa);
  // a computer with no display name is called by its id: that name is not written back
  m = RTP_Station_set_display_name(m, ifx q[0].stations[i].name == q[0].stations[i].id then "" else q[0].stations[i].name, sb);
  m = RTP_Station_set_reported_at_ms(m, cast(s64) q[0].stations[i].reported_at_ms, sa);
  m = RTP_Station_set_os(m, q[0].stations[i].os, sb);
  m = RTP_Station_set_cpu_cores(m, cast(s32) q[0].stations[i].cores, sa);
  m = RTP_Station_set_memory_total_mb(m, cast(s64) q[0].stations[i].memory_total_mb, sb);
  m = RTP_Station_set_memory_free_mb(m, cast(s64) q[0].stations[i].memory_free_mb, sa);
  m = RTP_Station_set_disk_free_mb(m, cast(s64) q[0].stations[i].disk_free_mb, sb);
  m = RTP_Station_set_disk_floor_mb(m, cast(s64) q[0].stations[i].disk_floor_mb, sa);
  m = RTP_Station_set_load_1m_milli(m, cast(s32) q[0].stations[i].load_1m_milli, sb);
  m = RTP_Station_set_load_15m_milli(m, cast(s32) q[0].stations[i].load_15m_milli, sa);
  m = RTP_Station_set_apple_builds(m, q[0].stations[i].apple_builds, sb);
  m = RTP_Station_set_gpu(m, q[0].stations[i].gpu, sa);
  // m is in sa
  to_a := false;
  for k: 0..<RTR_ENGINES {
    if !q[0].stations[i].agents[k].reported { continue; }
    g := q[0].stations[i].agents[k];
    c := RTP_StationAgent_new();
    c = RTP_StationAgent_set_engine(c, names[k], ca);
    c = RTP_StationAgent_set_installed(c, g.installed, cb);
    c = RTP_StationAgent_set_logged_in(c, g.logged_in, ca);
    c = RTP_StationAgent_set_quota_used_up(c, g.quota_used_up, cb);
    c = RTP_StationAgent_set_cooldown(c, g.cooldown, ca);
    c = RTP_StationAgent_set_version(c, g.version, cb);
    c = RTP_StationAgent_set_plan(c, g.plan, ca);
    c = RTP_StationAgent_set_quota_resets_at(c, g.quota_resets_at, cb);
    if to_a { m = RTP_Station_append_agents(m, c, sa); } else { m = RTP_Station_append_agents(m, c, sb); }
    to_a = !to_a;
  }
  for k: 0..<q[0].stations[i].work {
    c := RTP_StationWork_new();
    c = RTP_StationWork_set_engine(c, q[0].stations[i].work_engine[k], ca);
    c = RTP_StationWork_set_model(c, q[0].stations[i].work_model[k], cb);
    c = RTP_StationWork_set_title(c, q[0].stations[i].work_title[k], ca);
    c = RTP_StationWork_set_state(c, q[0].stations[i].work_state[k], cb);
    c = RTP_StationWork_set_started_at_ms(c, cast(s64) q[0].stations[i].work_started_at_ms[k], ca);
    if to_a { m = RTP_Station_append_work(m, c, sa); } else { m = RTP_Station_append_work(m, c, sb); }
    to_a = !to_a;
  }
  for k: 0..<q[0].stations[i].nrepos {
    if to_a { m = RTP_Station_append_repos(m, q[0].stations[i].repos[k], sa); } else { m = RTP_Station_append_repos(m, q[0].stations[i].repos[k], sb); }
    to_a = !to_a;
  }
  if q[0].stations[i].keep_clear || q[0].stations[i].nothing_heavy || q[0].stations[i].max_agents != 0 {
    c := RTP_StationRules_new();
    c = RTP_StationRules_set_keep_clear(c, q[0].stations[i].keep_clear, ca);
    c = RTP_StationRules_set_nothing_heavy(c, q[0].stations[i].nothing_heavy, cb);
    c = RTP_StationRules_set_max_agents(c, cast(s32) q[0].stations[i].max_agents, ca);
    if to_a { m = RTP_Station_set_rules(m, c, sa); } else { m = RTP_Station_set_rules(m, c, sb); }
    to_a = !to_a;
  }
  if to_a { m = RTP_Station_set_in_use(m, q[0].stations[i].in_use, sa); } else { m = RTP_Station_set_in_use(m, q[0].stations[i].in_use, sb); }
  return m;
}

// A request's JSON into out: its length, or 0 when it doesn't fit or a
// string is not UTF-8. What rtr_request_read read is written back byte for
// byte (an agent the router doesn't know is not kept).
rtr_request_write :: (q: [] RtrRequest, out: [] u8) -> int {
  x: [RTR_REQUEST_MAX] u8; y: [RTR_REQUEST_MAX] u8;
  sa: [RTR_STATION_MAX] u8; sb: [RTR_STATION_MAX] u8; ca: [1024] u8; cb: [1024] u8;
  m := RTP_RouteRequest_new();
  m = RTP_RouteRequest_set_text(m, q[0].text, x[..]);
  m = RTP_RouteRequest_set_summary(m, q[0].summary, y[..]);
  m = RTP_RouteRequest_set_repo(m, q[0].repo, x[..]);
  m = RTP_RouteRequest_set_current_station(m, q[0].current_station, y[..]);
  m = RTP_RouteRequest_set_current_engine(m, q[0].current_engine, x[..]);
  m = RTP_RouteRequest_set_current_model(m, q[0].current_model, y[..]);
  m = RTP_RouteRequest_set_now_ms(m, cast(s64) q[0].now_ms, x[..]);
  to_x := false;
  for i: 0..<q[0].n {
    s := rtr_station_message(q, i, sa[..], sb[..], ca[..], cb[..]);
    if s.error != 0 { return 0; }
    if to_x { m = RTP_RouteRequest_append_stations(m, s, x[..]); } else { m = RTP_RouteRequest_append_stations(m, s, y[..]); }
    to_x = !to_x;
  }
  v := RTP_RouteRequest_to_json(m, out);
  return ifx v.error != 0 then 0 else v.wire.count;
}

// ---- a computer's own report (DescribeStation)

RTR_REPORT_MAX :: 16384;   // a station report's JSON, and its wire

// Row i of q as a StationReport from host (64 hex): its length in out, or 0
// when it doesn't fit or a string is not UTF-8.
rtr_report_write :: (q: [] RtrRequest, i: int, host: string, out: [] u8) -> int {
  if i < 0 || i >= RTR_STATIONS { return 0; }
  x: [RTR_REPORT_MAX] u8; y: [RTR_REPORT_MAX] u8;
  sa: [RTR_STATION_MAX] u8; sb: [RTR_STATION_MAX] u8; ca: [1024] u8; cb: [1024] u8;
  s := rtr_station_message(q, i, sa[..], sb[..], ca[..], cb[..]);
  if s.error != 0 { return 0; }
  m := RTP_StationReport_new();
  m = RTP_StationReport_set_host_pubkey(m, host, x[..]);
  m = RTP_StationReport_set_station(m, s, y[..]);
  v := RTP_StationReport_to_json(m, out);
  return ifx v.error != 0 then 0 else v.wire.count;
}

// A report's JSON into row i of q, and its host key into host (64 bytes).
// False for a body that is not a StationReport, a host key that is not 64
// lowercase hex, no station, or one rtr_station_read refuses. wire must not
// overlap text, and the row's strings borrow it.
rtr_report_read :: (text: string, nodes: [] JvNode, wire: [] u8, q: [] RtrRequest, i: int, host: [] u8) -> bool {
  if i < 0 || i >= RTR_STATIONS || host.count < 64 { return false; }
  m := RTP_StationReport_from_json(text, nodes, wire);
  if m.error != 0 { return false; }
  h := RTP_StationReport_get_host_pubkey(m); s := RTP_StationReport_get_station(m);
  if h.value.count != 64 || !s.present { return false; }
  for c: h.value { if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) { return false; } }
  for c, k: h.value { host[k] = c; }
  return rtr_station_read(s.value, q, i);
}

// DescribeStation's params: refresh reads the computer again.
rtr_describe_write :: (refresh: bool, out: [] u8) -> int {
  x: [64] u8;
  m := RTP_DescribeStation_new();
  m = RTP_DescribeStation_set_refresh(m, refresh, x[..]);
  v := RTP_DescribeStation_to_json(m, out);
  return ifx v.error != 0 then 0 else v.wire.count;
}

// -1 for a body that is not DescribeStation's params exactly as
// rtr_describe_write writes them (no other field, no other order); 1 to read
// the computer again, 0 for its last report.
rtr_describe_read :: (text: string) -> int {
  if text.count > 256 { return -1; }
  nodes: [16] JvNode; wire: [256] u8; again: [256] u8;
  m := RTP_DescribeStation_from_json(text, nodes[..], wire[..]);
  if m.error != 0 { return -1; }
  r := RTP_DescribeStation_get_refresh(m);
  n := rtr_describe_write(r.value, again[..]);
  if n < 1 || cast(string) again[0..<n] != text { return -1; }
  return ifx r.value then 1 else 0;
}

// "coderos", or "coderos/codex" for an agent on a computer.
rtr_blocked_id :: (b: RtrBlocked, out: [] u8) -> string {
  n := 0;
  for c: b.station { if n < out.count { out[n] = c; n += 1; } }
  if b.engine.count > 0 {
    if n < out.count { out[n] = '/'; n += 1; }
    for c: b.engine { if n < out.count { out[n] = c; n += 1; } }
  }
  return cast(string) out[0..<n];
}

// A decision's JSON into d: false for a body that is not a RouteDecision or
// a list over its bound. wire must not overlap text, and d's strings borrow it.
rtr_decision_read :: (text: string, nodes: [] JvNode, wire: [] u8, d: [] RtrDecision) -> bool {
  m := RTP_RouteDecision_from_json(text, nodes, wire);
  if m.error != 0 { return false; }
  rtr_decision_clear(d);
  ok := RTP_RouteDecision_get_ok(m); station := RTP_RouteDecision_get_station(m); engine := RTP_RouteDecision_get_engine(m);
  model := RTP_RouteDecision_get_model(m); effort := RTP_RouteDecision_get_effort(m);
  difficulty := RTP_RouteDecision_get_difficulty(m); weight := RTP_RouteDecision_get_weight(m);
  door := RTP_RouteDecision_get_door(m); problem := RTP_RouteDecision_get_door_problem(m);
  tokens := RTP_RouteDecision_get_input_tokens(m); ms := RTP_RouteDecision_get_latency_ms(m);
  error := RTP_RouteDecision_get_error(m); needs := RTP_RouteDecision_get_needs(m);
  d[0].ok = ok.value; d[0].station = station.value; d[0].engine = engine.value; d[0].model = model.value; d[0].effort = effort.value;
  if difficulty.present { d[0].difficulty = cast(int) difficulty.value; }
  if weight.present { d[0].weight = cast(int) weight.value; }
  d[0].door = door.value; d[0].door_problem = problem.value;
  d[0].input_tokens = cast(int) tokens.value; d[0].latency_ms = cast(int) ms.value; d[0].error = error.value; d[0].needs = needs.value;
  ri := RTP_RouteDecision_iter_reasons(m);
  while ri.has_value { if d[0].nreasons == RTR_REASONS { return false; } d[0].reasons[d[0].nreasons] = ri.value; d[0].nreasons += 1; ri = RTP_RouteDecision_next_reasons(ri); }
  ai := RTP_RouteDecision_iter_answers(m);
  while ai.has_value {
    if d[0].nanswers == RTR_ANSWERS { return false; }
    key := RTP_RouteAnswer_get_key(ai.value); choice := RTP_RouteAnswer_get_choice(ai.value);
    level := RTP_RouteAnswer_get_level(ai.value); milli := RTP_RouteAnswer_get_probability_milli(ai.value);
    rtr_answer(d, key.value, choice.value, ifx level.present then cast(int) level.value else -1, ifx milli.present then cast(int) milli.value else -1);
    ai = RTP_RouteDecision_next_answers(ai);
  }
  si := RTP_RouteDecision_iter_eligible_stations(m);
  while si.has_value { if d[0].neligible_stations == RTR_STATIONS { return false; } d[0].eligible_stations[d[0].neligible_stations] = si.value; d[0].neligible_stations += 1; si = RTP_RouteDecision_next_eligible_stations(si); }
  ei := RTP_RouteDecision_iter_eligible_engines(m);
  while ei.has_value { if d[0].neligible_engines == RTR_ENGINES { return false; } d[0].eligible_engines[d[0].neligible_engines] = ei.value; d[0].neligible_engines += 1; ei = RTP_RouteDecision_next_eligible_engines(ei); }
  bi := RTP_RouteDecision_iter_blocked(m);
  while bi.has_value {
    if d[0].nblocked == RTR_BLOCKED { return false; }
    id := RTP_RouteBlocked_get_id(bi.value); fact := RTP_RouteBlocked_get_fact(bi.value);
    slash := 0; while slash < id.value.count && id.value[slash] != '/' { slash += 1; }
    rtr_block(d, cast(string) id.value[0..<slash], ifx slash < id.value.count then cast(string) id.value[slash + 1..<id.value.count] else "", fact.value);
    bi = RTP_RouteDecision_next_blocked(bi);
  }
  return true;
}

// A decision's JSON into out: its length, or 0 when it doesn't fit or a
// string is not UTF-8.
rtr_decision_write :: (d: [] RtrDecision, out: [] u8) -> int {
  x: [RTR_DECISION_MAX] u8; y: [RTR_DECISION_MAX] u8; c1: [1024] u8; c2: [1024] u8;
  m := RTP_RouteDecision_new();
  m = RTP_RouteDecision_set_ok(m, d[0].ok, x[..]);
  m = RTP_RouteDecision_set_station(m, d[0].station, y[..]);
  m = RTP_RouteDecision_set_engine(m, d[0].engine, x[..]);
  m = RTP_RouteDecision_set_model(m, d[0].model, y[..]);
  m = RTP_RouteDecision_set_effort(m, d[0].effort, x[..]);
  // m is in x: the next write goes to y, and to_x says where the one after goes
  to_x := false;
  if d[0].difficulty >= 0 { m = RTP_RouteDecision_set_difficulty(m, cast(s32) d[0].difficulty, y[..]); to_x = true; }
  if d[0].weight >= 0 {
    if to_x { m = RTP_RouteDecision_set_weight(m, cast(s32) d[0].weight, x[..]); } else { m = RTP_RouteDecision_set_weight(m, cast(s32) d[0].weight, y[..]); }
    to_x = !to_x;
  }
  if to_x { m = RTP_RouteDecision_set_door(m, d[0].door, x[..]); } else { m = RTP_RouteDecision_set_door(m, d[0].door, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP_RouteDecision_set_door_problem(m, d[0].door_problem, x[..]); } else { m = RTP_RouteDecision_set_door_problem(m, d[0].door_problem, y[..]); }
  to_x = !to_x;
  for i: 0..<d[0].nreasons {
    if to_x { m = RTP_RouteDecision_append_reasons(m, d[0].reasons[i], x[..]); } else { m = RTP_RouteDecision_append_reasons(m, d[0].reasons[i], y[..]); }
    to_x = !to_x;
  }
  for i: 0..<d[0].nanswers {
    a := RTP_RouteAnswer_new();
    a = RTP_RouteAnswer_set_key(a, d[0].answers[i].key, c1[..]);
    a = RTP_RouteAnswer_set_choice(a, d[0].answers[i].choice, c2[..]);
    // a is in c2
    if d[0].answers[i].level >= 0 && d[0].answers[i].milli >= 0 {
      a = RTP_RouteAnswer_set_level(a, cast(s32) d[0].answers[i].level, c1[..]);
      a = RTP_RouteAnswer_set_probability_milli(a, cast(s32) d[0].answers[i].milli, c2[..]);
    } else if d[0].answers[i].level >= 0 {
      a = RTP_RouteAnswer_set_level(a, cast(s32) d[0].answers[i].level, c1[..]);
    } else if d[0].answers[i].milli >= 0 {
      a = RTP_RouteAnswer_set_probability_milli(a, cast(s32) d[0].answers[i].milli, c1[..]);
    }
    if to_x { m = RTP_RouteDecision_append_answers(m, a, x[..]); } else { m = RTP_RouteDecision_append_answers(m, a, y[..]); }
    to_x = !to_x;
  }
  for i: 0..<d[0].neligible_stations {
    if to_x { m = RTP_RouteDecision_append_eligible_stations(m, d[0].eligible_stations[i], x[..]); } else { m = RTP_RouteDecision_append_eligible_stations(m, d[0].eligible_stations[i], y[..]); }
    to_x = !to_x;
  }
  for i: 0..<d[0].neligible_engines {
    if to_x { m = RTP_RouteDecision_append_eligible_engines(m, d[0].eligible_engines[i], x[..]); } else { m = RTP_RouteDecision_append_eligible_engines(m, d[0].eligible_engines[i], y[..]); }
    to_x = !to_x;
  }
  for i: 0..<d[0].nblocked {
    ib: [RTR_ID_MAX + 1 + 16] u8;
    b := RTP_RouteBlocked_new();
    b = RTP_RouteBlocked_set_id(b, rtr_blocked_id(d[0].blocked[i], ib[..]), c1[..]);
    b = RTP_RouteBlocked_set_fact(b, d[0].blocked[i].fact, c2[..]);
    if to_x { m = RTP_RouteDecision_append_blocked(m, b, x[..]); } else { m = RTP_RouteDecision_append_blocked(m, b, y[..]); }
    to_x = !to_x;
  }
  if to_x { m = RTP_RouteDecision_set_input_tokens(m, cast(s32) d[0].input_tokens, x[..]); } else { m = RTP_RouteDecision_set_input_tokens(m, cast(s32) d[0].input_tokens, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP_RouteDecision_set_latency_ms(m, cast(s32) d[0].latency_ms, x[..]); } else { m = RTP_RouteDecision_set_latency_ms(m, cast(s32) d[0].latency_ms, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP_RouteDecision_set_error(m, d[0].error, x[..]); } else { m = RTP_RouteDecision_set_error(m, d[0].error, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP_RouteDecision_set_needs(m, d[0].needs, x[..]); } else { m = RTP_RouteDecision_set_needs(m, d[0].needs, y[..]); }
  v := RTP_RouteDecision_to_json(m, out);
  return ifx v.error != 0 then 0 else v.wire.count;
}

#test "a computer's id: 1 to 32 of a-z, 0-9 and -" {
  #assert rtr_id_ok("oa-build-1") && rtr_id_ok("a") && rtr_id_ok("01234567890123456789012345678901");
  #assert !rtr_id_ok("none") && !rtr_id_ok("") && !rtr_id_ok("A") && !rtr_id_ok("a/b") && !rtr_id_ok("my mac") && !rtr_id_ok("012345678901234567890123456789012");
}

// ---- openagents.router.v2alpha1 (System One Front RoutePlan) (#14056)

RTR2_PLAN_REQ_SCHEMA :: "openagents.router.plan_request.v2alpha1";
RTR2_PLAN_SCHEMA :: "openagents.router.plan.v2alpha1";
RTR2_PACKS :: 8;
RTR2_TIERS :: 4;
RTR2_DELEGATES :: 5;
RTR2_PLAN_MAX :: 32768;

RTR2_PACK_GENERAL :: 0;
RTR2_PACK_KNOWLEDGE :: 1;
RTR2_PACK_CODER :: 2;
RTR2_PACK_WALLET :: 3;
RTR2_PACK_METAVERSE :: 4;
RTR2_PACK_CLI :: 5;
RTR2_PACK_GYM :: 6;
RTR2_PACK_AUTHOR :: 7;

RTR2_PACK_NAMES :: [RTR2_PACKS] string.[
  "general", "knowledge", "coder", "wallet", "metaverse", "cli", "gym", "capability_author"
];

RTR2_TIER_LOCAL :: 0;
RTR2_TIER_CLOUD_FAST :: 1;
RTR2_TIER_CLOUD_DEEP :: 2;
RTR2_TIER_REMOTE :: 3;

RTR2_TIER_NAMES :: [RTR2_TIERS] string.[
  "local_inkling", "cloud_fast", "cloud_deep", "remote_station"
];

RTR2_DEL_NONE :: 0;
RTR2_DEL_CLAUDE :: 1;
RTR2_DEL_CODEX :: 2;
RTR2_DEL_ANTIGRAVITY :: 3;
RTR2_DEL_CURSOR :: 4;

RTR2_DELEGATE_NAMES :: [RTR2_DELEGATES] string.[
  "none", "claude", "codex", "antigravity", "cursor"
];

rtr2_pack_index :: (name: string) -> int {
  names := RTR2_PACK_NAMES;
  for i: 0..<RTR2_PACKS { if names[i] == name { return i; } }
  return -1;
}

rtr2_tier_index :: (name: string) -> int {
  names := RTR2_TIER_NAMES;
  for i: 0..<RTR2_TIERS { if names[i] == name { return i; } }
  return -1;
}

rtr2_delegate_index :: (name: string) -> int {
  names := RTR2_DELEGATE_NAMES;
  for i: 0..<RTR2_DELEGATES { if names[i] == name { return i; } }
  return -1;
}

Rtr2PlanRequest :: struct {
  text: string;
  summary: string;
  repo: string;
  active_packs: [RTR2_PACKS] string;
  nactive_packs: int;
  active_compute_tier: string;
  active_delegate: string;
  local_inkling_ready: bool;
  cloud_ready: bool;
  remote_station_ready: bool;
  available_delegates: [RTR2_DELEGATES] string;
  navailable_delegates: int;
  available_packs: [RTR2_PACKS] string;
  navailable_packs: int;
  user_compute_pref: string; // "", "auto", "local", "cloud"
  allow_local_harnesses: bool; // Opt-in (default false): allow external local harness delegates (#14071)
  now_ms: int;
}

Rtr2Plan :: struct {
  ok: bool;
  capability_packs: [RTR2_PACKS] string;
  npacks: int;
  compute_tier: string;
  explicit_delegate: string;
  continue_active: bool;
  missing_capability_hint: string;
  effort: string;
  difficulty: int;          // -1: not decided
  door: string;
  door_problem: string;
  reasons: [RTR_REASONS] string;
  nreasons: int;
  answers: [RTR_ANSWERS] RtrAnswer;
  nanswers: int;
  input_tokens: int;
  latency_ms: int;
  error: string;
}

rtr2_plan_clear :: (p: [] Rtr2Plan) {
  p[0] = Rtr2Plan.{};
  p[0].difficulty = -1;
}

rtr2_plan_reason :: (p: [] Rtr2Plan, code: string) {
  for i: 0..<p[0].nreasons { if p[0].reasons[i] == code { return; } }
  if p[0].nreasons < RTR_REASONS { p[0].reasons[p[0].nreasons] = code; p[0].nreasons += 1; }
}

rtr2_plan_answer :: (p: [] Rtr2Plan, key: string, choice: string, level: int, milli: int) {
  if p[0].nanswers >= RTR_ANSWERS { return; }
  p[0].answers[p[0].nanswers] = RtrAnswer.{key = key, choice = choice, level = level, milli = milli};
  p[0].nanswers += 1;
}

rtr2_plan_add_pack :: (p: [] Rtr2Plan, pack: string) {
  if pack.count == 0 { return; }
  for i: 0..<p[0].npacks { if p[0].capability_packs[i] == pack { return; } }
  if p[0].npacks < RTR2_PACKS { p[0].capability_packs[p[0].npacks] = pack; p[0].npacks += 1; }
}

rtr2_plan_request_read :: (text: string, nodes: [] JvNode, wire: [] u8, q: [] Rtr2PlanRequest) -> bool {
  m := RTP2_RoutePlanRequest_from_json(text, nodes, wire);
  if m.error != 0 { return false; }
  task := RTP2_RoutePlanRequest_get_text(m);
  if task.value.count > RTR_TEXT_MAX { return false; }
  q[0] = Rtr2PlanRequest.{};
  q[0].text = task.value;
  q[0].summary = RTP2_RoutePlanRequest_get_summary(m).value;
  q[0].repo = RTP2_RoutePlanRequest_get_repo(m).value;
  q[0].active_compute_tier = RTP2_RoutePlanRequest_get_active_compute_tier(m).value;
  q[0].active_delegate = RTP2_RoutePlanRequest_get_active_delegate(m).value;
  q[0].local_inkling_ready = RTP2_RoutePlanRequest_get_local_inkling_ready(m).value;
  q[0].cloud_ready = RTP2_RoutePlanRequest_get_cloud_ready(m).value;
  q[0].remote_station_ready = RTP2_RoutePlanRequest_get_remote_station_ready(m).value;
  q[0].user_compute_pref = RTP2_RoutePlanRequest_get_user_compute_pref(m).value;
  q[0].now_ms = cast(int) RTP2_RoutePlanRequest_get_now_ms(m).value;
  ai := RTP2_RoutePlanRequest_iter_active_packs(m);
  while ai.has_value {
    if q[0].nactive_packs == RTR2_PACKS { return false; }
    if rtr2_pack_index(ai.value) < 0 { return false; }
    q[0].active_packs[q[0].nactive_packs] = ai.value; q[0].nactive_packs += 1;
    ai = RTP2_RoutePlanRequest_next_active_packs(ai);
  }
  di := RTP2_RoutePlanRequest_iter_available_delegates(m);
  while di.has_value {
    if q[0].navailable_delegates == RTR2_DELEGATES { return false; }
    if rtr2_delegate_index(di.value) <= 0 { return false; }
    q[0].available_delegates[q[0].navailable_delegates] = di.value; q[0].navailable_delegates += 1;
    di = RTP2_RoutePlanRequest_next_available_delegates(di);
  }
  pi := RTP2_RoutePlanRequest_iter_available_packs(m);
  while pi.has_value {
    if q[0].navailable_packs == RTR2_PACKS { return false; }
    if rtr2_pack_index(pi.value) < 0 { return false; }
    q[0].available_packs[q[0].navailable_packs] = pi.value; q[0].navailable_packs += 1;
    pi = RTP2_RoutePlanRequest_next_available_packs(pi);
  }
  return true;
}

rtr2_plan_request_write :: (q: [] Rtr2PlanRequest, out: [] u8) -> int {
  x: [RTR2_PLAN_MAX] u8; y: [RTR2_PLAN_MAX] u8;
  m := RTP2_RoutePlanRequest_new();
  m = RTP2_RoutePlanRequest_set_text(m, q[0].text, x[..]);
  m = RTP2_RoutePlanRequest_set_summary(m, q[0].summary, y[..]);
  m = RTP2_RoutePlanRequest_set_repo(m, q[0].repo, x[..]);
  to_x := false;
  for i: 0..<q[0].nactive_packs {
    if to_x { m = RTP2_RoutePlanRequest_append_active_packs(m, q[0].active_packs[i], x[..]); }
    else { m = RTP2_RoutePlanRequest_append_active_packs(m, q[0].active_packs[i], y[..]); }
    to_x = !to_x;
  }
  if to_x { m = RTP2_RoutePlanRequest_set_active_compute_tier(m, q[0].active_compute_tier, x[..]); } else { m = RTP2_RoutePlanRequest_set_active_compute_tier(m, q[0].active_compute_tier, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP2_RoutePlanRequest_set_active_delegate(m, q[0].active_delegate, x[..]); } else { m = RTP2_RoutePlanRequest_set_active_delegate(m, q[0].active_delegate, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP2_RoutePlanRequest_set_local_inkling_ready(m, q[0].local_inkling_ready, x[..]); } else { m = RTP2_RoutePlanRequest_set_local_inkling_ready(m, q[0].local_inkling_ready, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP2_RoutePlanRequest_set_cloud_ready(m, q[0].cloud_ready, x[..]); } else { m = RTP2_RoutePlanRequest_set_cloud_ready(m, q[0].cloud_ready, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP2_RoutePlanRequest_set_remote_station_ready(m, q[0].remote_station_ready, x[..]); } else { m = RTP2_RoutePlanRequest_set_remote_station_ready(m, q[0].remote_station_ready, y[..]); }
  to_x = !to_x;
  for i: 0..<q[0].navailable_delegates {
    if to_x { m = RTP2_RoutePlanRequest_append_available_delegates(m, q[0].available_delegates[i], x[..]); }
    else { m = RTP2_RoutePlanRequest_append_available_delegates(m, q[0].available_delegates[i], y[..]); }
    to_x = !to_x;
  }
  for i: 0..<q[0].navailable_packs {
    if to_x { m = RTP2_RoutePlanRequest_append_available_packs(m, q[0].available_packs[i], x[..]); }
    else { m = RTP2_RoutePlanRequest_append_available_packs(m, q[0].available_packs[i], y[..]); }
    to_x = !to_x;
  }
  if to_x { m = RTP2_RoutePlanRequest_set_user_compute_pref(m, q[0].user_compute_pref, x[..]); } else { m = RTP2_RoutePlanRequest_set_user_compute_pref(m, q[0].user_compute_pref, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP2_RoutePlanRequest_set_now_ms(m, cast(s64) q[0].now_ms, x[..]); } else { m = RTP2_RoutePlanRequest_set_now_ms(m, cast(s64) q[0].now_ms, y[..]); }
  v := RTP2_RoutePlanRequest_to_json(m, out);
  return ifx v.error != 0 then 0 else v.wire.count;
}

rtr2_plan_read :: (text: string, nodes: [] JvNode, wire: [] u8, p: [] Rtr2Plan) -> bool {
  m := RTP2_RoutePlan_from_json(text, nodes, wire);
  if m.error != 0 { return false; }
  rtr2_plan_clear(p);
  p[0].ok = RTP2_RoutePlan_get_ok(m).value;
  pi := RTP2_RoutePlan_iter_capability_packs(m);
  while pi.has_value {
    if p[0].npacks == RTR2_PACKS { return false; }
    p[0].capability_packs[p[0].npacks] = pi.value; p[0].npacks += 1;
    pi = RTP2_RoutePlan_next_capability_packs(pi);
  }
  p[0].compute_tier = RTP2_RoutePlan_get_compute_tier(m).value;
  p[0].explicit_delegate = RTP2_RoutePlan_get_explicit_delegate(m).value;
  p[0].continue_active = RTP2_RoutePlan_get_continue_active(m).value;
  p[0].missing_capability_hint = RTP2_RoutePlan_get_missing_capability_hint(m).value;
  p[0].effort = RTP2_RoutePlan_get_effort(m).value;
  df := RTP2_RoutePlan_get_difficulty(m);
  if df.present { p[0].difficulty = cast(int) df.value; }
  p[0].door = RTP2_RoutePlan_get_door(m).value;
  p[0].door_problem = RTP2_RoutePlan_get_door_problem(m).value;
  ri := RTP2_RoutePlan_iter_reasons(m);
  while ri.has_value {
    if p[0].nreasons == RTR_REASONS { return false; }
    p[0].reasons[p[0].nreasons] = ri.value; p[0].nreasons += 1;
    ri = RTP2_RoutePlan_next_reasons(ri);
  }
  ai := RTP2_RoutePlan_iter_answers(m);
  while ai.has_value {
    if p[0].nanswers == RTR_ANSWERS { return false; }
    k := RTP2_RoutePlanAnswer_get_key(ai.value);
    c := RTP2_RoutePlanAnswer_get_choice(ai.value);
    lv := RTP2_RoutePlanAnswer_get_level(ai.value);
    pm := RTP2_RoutePlanAnswer_get_probability_milli(ai.value);
    p[0].answers[p[0].nanswers] = RtrAnswer.{
      key = k.value, choice = c.value,
      level = ifx lv.present then cast(int) lv.value else -1,
      milli = ifx pm.present then cast(int) pm.value else -1
    };
    p[0].nanswers += 1;
    ai = RTP2_RoutePlan_next_answers(ai);
  }
  p[0].input_tokens = cast(int) RTP2_RoutePlan_get_input_tokens(m).value;
  p[0].latency_ms = cast(int) RTP2_RoutePlan_get_latency_ms(m).value;
  p[0].error = RTP2_RoutePlan_get_error(m).value;
  return true;
}

rtr2_plan_write :: (p: [] Rtr2Plan, out: [] u8) -> int {
  x: [RTR2_PLAN_MAX] u8; y: [RTR2_PLAN_MAX] u8; c1: [1024] u8; c2: [1024] u8;
  m := RTP2_RoutePlan_new();
  m = RTP2_RoutePlan_set_ok(m, p[0].ok, x[..]);
  to_x := false;
  for i: 0..<p[0].npacks {
    if to_x { m = RTP2_RoutePlan_append_capability_packs(m, p[0].capability_packs[i], x[..]); }
    else { m = RTP2_RoutePlan_append_capability_packs(m, p[0].capability_packs[i], y[..]); }
    to_x = !to_x;
  }
  if to_x { m = RTP2_RoutePlan_set_compute_tier(m, p[0].compute_tier, x[..]); } else { m = RTP2_RoutePlan_set_compute_tier(m, p[0].compute_tier, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP2_RoutePlan_set_explicit_delegate(m, p[0].explicit_delegate, x[..]); } else { m = RTP2_RoutePlan_set_explicit_delegate(m, p[0].explicit_delegate, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP2_RoutePlan_set_continue_active(m, p[0].continue_active, x[..]); } else { m = RTP2_RoutePlan_set_continue_active(m, p[0].continue_active, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP2_RoutePlan_set_missing_capability_hint(m, p[0].missing_capability_hint, x[..]); } else { m = RTP2_RoutePlan_set_missing_capability_hint(m, p[0].missing_capability_hint, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP2_RoutePlan_set_effort(m, p[0].effort, x[..]); } else { m = RTP2_RoutePlan_set_effort(m, p[0].effort, y[..]); }
  to_x = !to_x;
  if p[0].difficulty >= 0 {
    if to_x { m = RTP2_RoutePlan_set_difficulty(m, cast(s32) p[0].difficulty, x[..]); } else { m = RTP2_RoutePlan_set_difficulty(m, cast(s32) p[0].difficulty, y[..]); }
    to_x = !to_x;
  }
  if to_x { m = RTP2_RoutePlan_set_door(m, p[0].door, x[..]); } else { m = RTP2_RoutePlan_set_door(m, p[0].door, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP2_RoutePlan_set_door_problem(m, p[0].door_problem, x[..]); } else { m = RTP2_RoutePlan_set_door_problem(m, p[0].door_problem, y[..]); }
  to_x = !to_x;
  for i: 0..<p[0].nreasons {
    if to_x { m = RTP2_RoutePlan_append_reasons(m, p[0].reasons[i], x[..]); } else { m = RTP2_RoutePlan_append_reasons(m, p[0].reasons[i], y[..]); }
    to_x = !to_x;
  }
  for i: 0..<p[0].nanswers {
    a := RTP2_RoutePlanAnswer_new();
    a = RTP2_RoutePlanAnswer_set_key(a, p[0].answers[i].key, c1[..]);
    a = RTP2_RoutePlanAnswer_set_choice(a, p[0].answers[i].choice, c2[..]);
    if p[0].answers[i].level >= 0 && p[0].answers[i].milli >= 0 {
      a = RTP2_RoutePlanAnswer_set_level(a, cast(s32) p[0].answers[i].level, c1[..]);
      a = RTP2_RoutePlanAnswer_set_probability_milli(a, cast(s32) p[0].answers[i].milli, c2[..]);
    } else if p[0].answers[i].level >= 0 {
      a = RTP2_RoutePlanAnswer_set_level(a, cast(s32) p[0].answers[i].level, c1[..]);
    } else if p[0].answers[i].milli >= 0 {
      a = RTP2_RoutePlanAnswer_set_probability_milli(a, cast(s32) p[0].answers[i].milli, c1[..]);
    }
    if to_x { m = RTP2_RoutePlan_append_answers(m, a, x[..]); } else { m = RTP2_RoutePlan_append_answers(m, a, y[..]); }
    to_x = !to_x;
  }
  if to_x { m = RTP2_RoutePlan_set_input_tokens(m, cast(s32) p[0].input_tokens, x[..]); } else { m = RTP2_RoutePlan_set_input_tokens(m, cast(s32) p[0].input_tokens, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP2_RoutePlan_set_latency_ms(m, cast(s32) p[0].latency_ms, x[..]); } else { m = RTP2_RoutePlan_set_latency_ms(m, cast(s32) p[0].latency_ms, y[..]); }
  to_x = !to_x;
  if to_x { m = RTP2_RoutePlan_set_error(m, p[0].error, x[..]); } else { m = RTP2_RoutePlan_set_error(m, p[0].error, y[..]); }
  v := RTP2_RoutePlan_to_json(m, out);
  return ifx v.error != 0 then 0 else v.wire.count;
}
