// Read-only, bounded Claude history. No transcript field can dispatch a tool.
// Own the source text until rendering ends. IDs and records borrow its bytes;
// escaped metadata is decoded into the graph's own pool. No foreign system or
// thinking block is rendered. Coder's filesystem/CLI adapter is separate.
#load "claude/fields.coax";
#load "../json/json.coax";

CSR_FILE_MAX :: 33554432;
CSR_LINE_MAX :: 1048576;
CSR_NODES :: 8192;
CSR_HASH :: 16384;
CSR_OUTPUT_MAX :: 32768;
CSR_TURN_MAX :: 16384;
CSR_WARNINGS :: [16] string.["malformed_records", "unknown_records", "record_limit", "metadata_limit", "compaction_gap", "preserved_segment_unavailable", "messages_removed", "missing_parent", "parent_cycle", "output_unavailable", "content_truncated", "output_truncated", "discovery_limit", "long_records", "duplicate_records", "file_changed"];

CsrNode :: struct {
  id: string; parent: string; message_id: string; timestamp: string; record: string;
  cwd: string; branch: string;
  kind: int; removed: bool; selected: bool; child: bool; result: bool;
  boundary: bool; head: string; tail: string; anchor: string;
  summary: bool;
}
CsrGraph :: struct {
  nodes: [CSR_NODES] CsrNode; n: int;
  table: [CSR_HASH] int;
  order: [CSR_NODES] int; norder: int;
  snips: [CSR_NODES] string; nsnips: int;
  replacements: [CSR_NODES] string; nreplacements: int;
  pool: [524288] u8; used: int;
  warnings: [16] int;
  cwd: string; branch: string; title: string; title_rank: int;
  first: string; last: string;
}

csr_has :: (text: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  for i: 0..<text.count - needle.count + 1 { if cast(string) text[i..<i + needle.count] == needle { return true; } }
  return false;
}
csr_cut :: (s: string, limit: int) -> string {
  if limit < 0 { return ""; }
  if s.count <= limit { return s; }
  k := limit; while k > 0 && (s[k] & 192) == 128 { k -= 1; }
  return cast(string) s[0..<k];
}
csr_uuid :: (s: string) -> bool {
  if s.count != 36 { return false; }
  for c, i: s {
    if i == 8 || i == 13 || i == 18 || i == 23 { if c != '-' { return false; } }
    else if jv_hex(c) < 0 { return false; }
  }
  return true;
}
csr_uuid_prefix :: (s: string) -> bool {
  if s.count < 8 || s.count > 36 { return false; }
  for c, i: s {
    if i == 8 || i == 13 || i == 18 || i == 23 { if c != '-' { return false; } }
    else if jv_hex(c) < 0 { return false; }
  }
  return true;
}
csr_warn :: (g: [] CsrGraph, code: int) { g[0].warnings[code] += 1; }
csr_value :: (g: [] CsrGraph, d: Jv, v: int) -> string {
  if jv_kind(d, v) != JV_STRING { return ""; }
  raw := jv_raw(d, v);
  if !csr_has(raw, "\\") { return raw; }
  n := jv_str(d, v, g[0].pool[g[0].used..<g[0].pool.count]);
  if n < 0 { csr_warn(g, 3); return ""; }
  at := g[0].used; g[0].used += n;
  return cast(string) g[0].pool[at..<g[0].used];
}
csr_get :: (g: [] CsrGraph, d: Jv, path: string) -> string { return csr_value(g, d, jv_path(d, 0, path)); }
csr_alias :: (d: Jv, object: int, camel: string, snake: string) -> int {
  at := jv_get(d, object, camel); return ifx at >= 0 then at else jv_get(d, object, snake);
}
csr_bool :: (d: Jv, path: string) -> bool { return jv_kind(d, jv_path(d, 0, path)) == JV_TRUE; }
csr_slot :: (g: [] CsrGraph, id: string) -> int {
  h := 0; for c: id { h = (h * 33 + cast(int) c) % CSR_HASH; }
  for step: 0..<CSR_HASH {
    at := (h + step) % CSR_HASH; v := g[0].table[at];
    if v == 0 || g[0].nodes[v - 1].id == id { return at; }
  }
  return -1;
}
csr_find :: (g: [] CsrGraph, id: string) -> int {
  if id.count == 0 { return -1; }
  at := csr_slot(g, id);
  return ifx at < 0 then -1 else g[0].table[at] - 1;
}
csr_array_ids :: (g: [] CsrGraph, d: Jv, path: string, replacement: bool) {
  list := jv_path(d, 0, path);
  for i: 0..<jv_len(d, list) {
    v := jv_at(d, list, i);
    raw := jv_raw(d, v);
    id := "";
    if replacement {
      b: [256] u8;
      k := jv_get(d, v, "toolUseId"); if k < 0 { k = jv_get(d, v, "tool_use_id"); }
      n := jv_str(d, k, b[..]);
      if n > 0 && n <= 128 {
        if g[0].used + n > g[0].pool.count { csr_warn(g, 3); continue; }
        at := g[0].used; for j: 0..<n { g[0].pool[at + j] = b[j]; } g[0].used += n;
        id = cast(string) g[0].pool[at..<g[0].used];
      }
    } else if jv_kind(d, v) == JV_STRING {
      if !csr_has(raw, "\\") { id = raw; }
      else {
        n := jv_str(d, v, g[0].pool[g[0].used..<g[0].pool.count]);
        if n < 0 { csr_warn(g, 3); continue; }
        at := g[0].used; g[0].used += n; id = cast(string) g[0].pool[at..<g[0].used];
      }
    }
    if id.count == 0 { continue; }
    if replacement {
      if g[0].nreplacements >= CSR_NODES { csr_warn(g, 2); return; }
      g[0].replacements[g[0].nreplacements] = id; g[0].nreplacements += 1;
    } else {
      if g[0].nsnips >= CSR_NODES { csr_warn(g, 2); return; }
      g[0].snips[g[0].nsnips] = id; g[0].nsnips += 1;
    }
  }
}
csr_record :: (g: [] CsrGraph, line: string) {
  nb: [4096] JvNode; d: [1] Jv;
  if !cl_root(line).ok || !jv_parse(d[..], line, nb[..]) || jv_kind(d[0], 0) != JV_OBJECT { csr_warn(g, 0); return; }
  if csr_bool(d[0], "isSidechain") { return; }
  kind := csr_get(g, d[0], "type");
  if g[0].cwd.count == 0 { g[0].cwd = csr_get(g, d[0], "cwd"); }
  branch := csr_get(g, d[0], "gitBranch"); if branch.count > 0 { g[0].branch = branch; }
  rank := ifx kind == "custom-title" then 3 else ifx kind == "ai-title" then 2 else ifx kind == "summary" then 1 else 0;
  if rank > 0 && rank >= g[0].title_rank {
    title := csr_get(g, d[0], ifx rank == 3 then "customTitle" else ifx rank == 2 then "aiTitle" else "summary");
    if title.count > 0 { g[0].title = title; g[0].title_rank = rank; }
  }
  if kind == "content-replacement" {
    if csr_get(g, d[0], "agentId").count == 0 { csr_array_ids(g, d[0], "replacements", true); }
    return;
  }
  if kind != "user" && kind != "assistant" && kind != "system" {
    known := [19] string.["summary", "custom-title", "ai-title", "progress", "file-history-snapshot", "attribution-snapshot", "queue-operation", "last-prompt", "tag", "agent-name", "agent-color", "agent-setting", "mode", "worktree-state", "context-collapse-commit", "context-collapse-snapshot", "content-replacement", "pr-link", "saved_hook_context"];
    hit := false; for k: known { if kind == k { hit = true; } }
    if !hit { csr_warn(g, 1); }
    // New Claude record types can sit between real messages. Keep only their
    // identity/parent edge as a non-rendered bridge, never their payload.
    if csr_get(g, d[0], "uuid").count == 0 { return; }
  }
  boundary := kind == "system" && csr_get(g, d[0], "subtype") == "compact_boundary";
  metadata := csr_alias(d[0], 0, "compactMetadata", "compact_metadata");
  seg := csr_alias(d[0], metadata, "preservedSegment", "preserved_segment");
  preserved := jv_kind(d[0], seg) == JV_OBJECT;
  if boundary {
    csr_warn(g, 4);
    if !preserved { g[0].n = 0; g[0].nsnips = 0; for i: 0..<CSR_HASH { g[0].table[i] = 0; } }
  }
  csr_array_ids(g, d[0], "snipMetadata.removedUuids", false);
  csr_array_ids(g, d[0], "snipMetadata.removed_uuids", false);
  csr_array_ids(g, d[0], "snip_metadata.removedUuids", false);
  csr_array_ids(g, d[0], "snip_metadata.removed_uuids", false);
  id := csr_get(g, d[0], "uuid");
  if id.count == 0 || id.count > 128 { csr_warn(g, 0); return; }
  if (kind == "user" || kind == "assistant") && jv_kind(d[0], jv_path(d[0], 0, "message")) != JV_OBJECT { csr_warn(g, 0); return; }
  slot := csr_slot(g, id); if slot < 0 { csr_warn(g, 2); return; }
  at := g[0].table[slot] - 1;
  if at < 0 {
    if g[0].n >= CSR_NODES { csr_warn(g, 2); return; }
    at = g[0].n; g[0].n += 1; g[0].table[slot] = at + 1;
  } else { csr_warn(g, 14); }
  parent := csr_get(g, d[0], "parentUuid"); if parent.count == 0 { parent = csr_get(g, d[0], "logicalParentUuid"); }
  g[0].nodes[at] = CsrNode.{id = id, parent = parent, message_id = csr_get(g, d[0], "message.id"), timestamp = csr_get(g, d[0], "timestamp"), record = line, cwd = csr_get(g, d[0], "cwd"), branch = branch, kind = ifx kind == "user" then 1 else ifx kind == "assistant" then 2 else 3, boundary = boundary};
  g[0].nodes[at].summary = kind == "user" && csr_bool(d[0], "isCompactSummary") && !csr_bool(d[0], "isMeta") && !csr_bool(d[0], "isVirtual");
  if boundary && preserved {
    g[0].nodes[at].head = csr_value(g, d[0], csr_alias(d[0], seg, "headUuid", "head_uuid"));
    g[0].nodes[at].tail = csr_value(g, d[0], csr_alias(d[0], seg, "tailUuid", "tail_uuid"));
    g[0].nodes[at].anchor = csr_value(g, d[0], csr_alias(d[0], seg, "anchorUuid", "anchor_uuid"));
    if g[0].nodes[at].head.count == 0 || g[0].nodes[at].tail.count == 0 || g[0].nodes[at].anchor.count == 0 { csr_warn(g, 5); }
  }
  content := jv_path(d[0], 0, "message.content");
  if jv_kind(d[0], content) == JV_ARRAY {
    for i: 0..<jv_len(d[0], content) {
      block := jv_at(d[0], content, i); t := jv_get(d[0], block, "type");
      if jv_raw(d[0], t) == "tool_result" { g[0].nodes[at].result = true; }
    }
  }
}
csr_parse :: (g: [] CsrGraph, text: string) {
  g[0] = CsrGraph.{};
  from := 0;
  for i: 0..<text.count + 1 {
    if i == text.count || text[i] == 10 {
      if i - from > CSR_LINE_MAX { csr_warn(g, 13); }
      else if jv_ws(cast(string) text[from..<i], 0) < i - from { csr_record(g, cast(string) text[from..<i]); }
      from = i + 1;
    }
  }
}
csr_newer :: (a: CsrNode, b: CsrNode, ai: int, bi: int) -> bool {
  // ISO timestamps sort lexically; byte order breaks ties deterministically.
  n := ifx a.timestamp.count < b.timestamp.count then a.timestamp.count else b.timestamp.count;
  for i: 0..<n { if a.timestamp[i] != b.timestamp[i] { return a.timestamp[i] > b.timestamp[i]; } }
  if a.timestamp.count != b.timestamp.count { return a.timestamp.count > b.timestamp.count; }
  return ai > bi;
}
csr_select :: (g: [] CsrGraph) {
  // The final preserved boundary reconnects its retained segment to the anchor.
  boundary := -1; for i: 0..<g[0].n { if g[0].nodes[i].boundary { boundary = i; } }
  if boundary >= 0 && g[0].nodes[boundary].head.count > 0 {
    b := g[0].nodes[boundary]; head := csr_find(g, b.head); tail := csr_find(g, b.tail); anchor := csr_find(g, b.anchor);
    kept: [CSR_NODES] bool; at := tail; reached := false;
    for step: 0..<g[0].n {
      if at < 0 || kept[at] { break; }
      kept[at] = true; if at == head { reached = true; break; }
      at = csr_find(g, g[0].nodes[at].parent);
    }
    if !reached || head < 0 || anchor < 0 { csr_warn(g, 5); }
    else {
      g[0].nodes[head].parent = b.anchor;
      for i: 0..<g[0].n {
        if i != head && g[0].nodes[i].parent == b.anchor { g[0].nodes[i].parent = b.tail; }
        if i < boundary && !kept[i] { g[0].nodes[i].removed = true; }
      }
    }
  }
  for i: 0..<g[0].nsnips { at := csr_find(g, g[0].snips[i]); if at >= 0 { g[0].nodes[at].removed = true; csr_warn(g, 6); } }
  // Bypass removed ancestors, bounded even if the deleted region is cyclic.
  for i: 0..<g[0].n {
    if g[0].nodes[i].removed { continue; }
    at := csr_find(g, g[0].nodes[i].parent); steps := 0;
    while at >= 0 && g[0].nodes[at].removed && steps < g[0].n {
      g[0].nodes[i].parent = g[0].nodes[at].parent; at = csr_find(g, g[0].nodes[i].parent); steps += 1;
    }
    if steps >= g[0].n { csr_warn(g, 8); g[0].nodes[i].parent = ""; }
    else if at >= 0 { g[0].nodes[at].child = true; }
  }
  leaf := -1;
  for i: 0..<g[0].n {
    if g[0].nodes[i].removed || g[0].nodes[i].child { continue; }
    at := i;
    for step: 0..<g[0].n {
      if at < 0 || g[0].nodes[at].removed { break; }
      if g[0].nodes[at].kind != 3 {
        if leaf < 0 || csr_newer(g[0].nodes[at], g[0].nodes[leaf], at, leaf) { leaf = at; }
        break;
      }
      at = csr_find(g, g[0].nodes[at].parent);
    }
  }
  if leaf < 0 {
    for i: 0..<g[0].n { if !g[0].nodes[i].removed && g[0].nodes[i].kind != 3 && (leaf < 0 || csr_newer(g[0].nodes[i], g[0].nodes[leaf], i, leaf)) { leaf = i; } }
  }
  chain: [CSR_NODES] int; nchain := 0; at := leaf;
  while at >= 0 {
    if g[0].nodes[at].selected { csr_warn(g, 8); break; }
    g[0].nodes[at].selected = true; chain[nchain] = at; nchain += 1;
    p := g[0].nodes[at].parent; at = csr_find(g, p);
    if at < 0 && p.count > 0 { csr_warn(g, 7); }
  }
  g[0].norder = 0;
  for k: 0..<nchain {
    index := chain[nchain - 1 - k]; g[0].order[g[0].norder] = index; g[0].norder += 1;
    node := g[0].nodes[index];
    if node.timestamp.count > 0 { if g[0].first.count == 0 { g[0].first = node.timestamp; } g[0].last = node.timestamp; }
    if node.kind != 2 || node.message_id.count == 0 { continue; }
    for pass: 0..<2 {
      begin := g[0].norder;
      for i: 0..<g[0].n {
        r := g[0].nodes[i]; if r.removed || r.selected { continue; }
        parent := csr_find(g, r.parent);
        match := ifx pass == 0 then r.kind == 2 && r.message_id == node.message_id else r.kind == 1 && r.result && parent >= 0 && g[0].nodes[parent].message_id == node.message_id;
        if !match { continue; }
        pos := g[0].norder;
        while pos > begin && csr_newer(g[0].nodes[g[0].order[pos - 1]], r, g[0].order[pos - 1], i) { g[0].order[pos] = g[0].order[pos - 1]; pos -= 1; }
        g[0].order[pos] = i; g[0].norder += 1; g[0].nodes[i].selected = true;
      }
    }
  }
  active_cwd := ""; active_branch := "";
  for i: 0..<g[0].norder {
    node := g[0].nodes[g[0].order[i]];
    if active_cwd.count == 0 && node.cwd.count > 0 { active_cwd = node.cwd; }
    if node.branch.count > 0 { active_branch = node.branch; }
  }
  if active_cwd.count > 0 { g[0].cwd = active_cwd; }
  g[0].branch = active_branch;
}

csr_meta_text :: (s: string) -> bool {
  i := 0; while i < s.count && (s[i] == ' ' || s[i] == 9 || s[i] == 10 || s[i] == 13) { i += 1; }
  t := cast(string) s[i..<s.count];
  if t.count == 0 || csr_has(csr_cut(t, 29), "[Request interrupted by user") { return true; }
  if t.count < 2 || t[0] != '<' || t[1] < 'a' || t[1] > 'z' { return false; }
  at := 2;
  while at < t.count {
    c := t[at];
    if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == ':' || c == '-') { break; }
    at += 1;
  }
  return at < t.count && (t[at] == ' ' || t[at] == 9 || t[at] == 10 || t[at] == 13 || t[at] == '/' || t[at] == '>');
}
csr_preview :: (g: [] CsrGraph, s: string, limit: int) -> string {
  cut := csr_cut(s, limit); if cut.count < s.count { csr_warn(g, 10); } return cut;
}
csr_content :: (g: [] CsrGraph, d: Jv, v: int, out: [] u8) -> string {
  n := 0;
  if jv_kind(d, v) == JV_STRING { n = jv_str(d, v, out); return ifx n < 0 then "" else cast(string) out[0..<n]; }
  if jv_kind(d, v) == JV_ARRAY {
    for i: 0..<jv_len(d, v) {
      b := jv_at(d, v, i); f := ifx jv_kind(d, b) == JV_STRING then b else jv_get(d, b, "text");
      if jv_kind(d, f) != JV_STRING { continue; }
      if n > 0 && n < out.count { out[n] = 10; n += 1; }
      k := jv_str(d, f, out[n..<out.count]);
      if k < 0 { csr_warn(g, 10); break; } n += k;
    }
  }
  if jv_kind(d, v) == JV_OBJECT {
    fields := [3] string.["text", "output", "content"];
    for f: fields { at := jv_get(d, v, f); if jv_kind(d, at) == JV_STRING { n = jv_str(d, at, out); return ifx n < 0 then "" else cast(string) out[0..<n]; } }
  }
  return cast(string) out[0..<n];
}
csr_turn :: (g: [] CsrGraph, index: int, max_tool: int, out: [] u8) -> string {
  r := g[0].nodes[index]; if r.kind == 3 { return ""; }
  nb: [4096] JvNode; d: [1] Jv;
  if !jv_parse(d[..], r.record, nb[..]) { return ""; }
  flags := [4] string.["isMeta", "isCompactSummary", "isVirtual", "isVisibleInTranscriptOnly"];
  for f: flags { if csr_bool(d[0], f) { return ""; } }
  content := jv_path(d[0], 0, "message.content");
  text: [4096] u8; nt := 0; calls: [8192] u8; nc := 0; results: [8192] u8; nr := 0;
  // Decode string fields into scratch space, never the persistent metadata pool.
  scratch: [CSR_LINE_MAX] u8;
  count := ifx jv_kind(d[0], content) == JV_ARRAY then jv_len(d[0], content) else 1;
  for i: 0..<count {
    b := ifx jv_kind(d[0], content) == JV_ARRAY then jv_at(d[0], content, i) else content;
    t := ifx jv_kind(d[0], b) == JV_STRING then "text" else jv_raw(d[0], jv_get(d[0], b, "type"));
    if t == "text" || t == "input_text" || t == "output_text" || t == "image" {
      v := ifx jv_kind(d[0], b) == JV_STRING then b else jv_get(d[0], b, "text");
      n := ifx t == "image" then 0 else jv_str(d[0], v, scratch[..]);
      s := ifx t == "image" then "[image content unavailable]" else ifx n < 0 then "" else cast(string) scratch[0..<n];
      if t == "image" { csr_warn(g, 9); }
      if csr_meta_text(s) { continue; }
      if nt > 0 && nt < text.count { text[nt] = 10; nt += 1; }
      shown := csr_preview(g, s, ifx text.count - nt < 2048 then text.count - nt else 2048);
      for c: shown { text[nt] = ifx c < 32 && c != 10 && c != 9 then cast(u8) '?' else c; nt += 1; }
    } else if t == "tool_use" || t == "tool_result" {
      item: [8192] u8; n := 0;
      if t == "tool_use" {
        n = json_raw(item[..], n, "{\"id\":"); k := jv_str(d[0], jv_get(d[0], b, "id"), scratch[..]);
        n = json_write_string(item[..], n, ifx k < 0 then "" else csr_preview(g, cast(string) scratch[0..<k], 128));
        n = json_raw(item[..], n, ",\"name\":"); k = jv_str(d[0], jv_get(d[0], b, "name"), scratch[..]);
        n = json_write_string(item[..], n, ifx k < 0 then "unknown" else csr_preview(g, cast(string) scratch[0..<k], 128));
        n = json_raw(item[..], n, ",\"input\":");
        n = json_write_string(item[..], n, csr_preview(g, jv_raw(d[0], jv_get(d[0], b, "input")), max_tool));
      } else {
        k := jv_str(d[0], jv_get(d[0], b, "tool_use_id"), scratch[..]);
        id := ifx k < 0 then "" else cast(string) scratch[0..<k];
        unavailable := false; for ri: 0..<g[0].nreplacements { if id == g[0].replacements[ri] { unavailable = true; } }
        n = json_raw(item[..], n, "{\"tool_use_id\":"); n = json_write_string(item[..], n, csr_preview(g, id, 128));
        value := csr_content(g, d[0], jv_get(d[0], b, "content"), scratch[..]);
        unavailable = unavailable || csr_has(value, "<persisted-output>") || csr_has(value, "[Old tool result content cleared]");
        n = json_raw(item[..], n, ",\"content\":"); n = json_write_string(item[..], n, ifx unavailable then "[output summarized/stored elsewhere]" else csr_preview(g, value, max_tool));
        n = json_raw(item[..], n, ifx unavailable then ",\"unavailable\":true" else ",\"unavailable\":false");
        n = json_raw(item[..], n, ifx jv_kind(d[0], jv_get(d[0], b, "is_error")) == JV_TRUE then ",\"is_error\":true" else ",\"is_error\":false");
        if unavailable { csr_warn(g, 9); }
      }
      n = json_raw(item[..], n, ",\"inert\":true}");
      if t == "tool_use" {
        if n < 0 || nc + n + 1 > calls.count { csr_warn(g, 10); continue; }
        if nc > 0 { calls[nc] = ','; nc += 1; } for j: 0..<n { calls[nc] = item[j]; nc += 1; }
      } else {
        if n < 0 || nr + n + 1 > results.count { csr_warn(g, 10); continue; }
        if nr > 0 { results[nr] = ','; nr += 1; } for j: 0..<n { results[nr] = item[j]; nr += 1; }
      }
    }
  }
  if nt == 0 && nc == 0 && nr == 0 { return ""; }
  n := json_raw(out, 0, ifx r.kind == 1 then "{\"role\":\"user\",\"uuid\":" else "{\"role\":\"assistant\",\"uuid\":");
  n = json_write_string(out, n, r.id); n = json_raw(out, n, ",\"text\":"); n = json_write_string(out, n, cast(string) text[0..<nt]);
  n = json_raw(out, n, ",\"tool_calls\":["); n = json_raw(out, n, cast(string) calls[0..<nc]);
  n = json_raw(out, n, "],\"tool_results\":["); n = json_raw(out, n, cast(string) results[0..<nr]); n = json_raw(out, n, "],\"inert\":true}");
  if n < 0 { csr_warn(g, 10); return ifx r.kind == 1 then "{\"role\":\"user\",\"text\":\"[record exceeds output budget]\",\"tool_calls\":[],\"tool_results\":[],\"inert\":true}" else "{\"role\":\"assistant\",\"text\":\"[record exceeds output budget]\",\"tool_calls\":[],\"tool_results\":[],\"inert\":true}"; }
  return cast(string) out[0..<n];
}
csr_warnings :: (g: [] CsrGraph, out: [] u8, at: int) -> int {
  n := json_raw(out, at, "["); comma := false; names := CSR_WARNINGS;
  for i: 0..<names.count {
    if g[0].warnings[i] == 0 { continue; }
    n = json_raw(out, n, ifx comma then ",{\"code\":" else "{\"code\":"); comma = true;
    n = json_write_string(out, n, names[i]); n = json_raw(out, n, ",\"count\":"); n = json_write_int(out, n, g[0].warnings[i]); n = json_raw(out, n, "}");
  }
  return json_raw(out, n, "]");
}

// Only an explicitly marked summary on the recovered branch is context.
// Keep generated summaries separate from the human's messages. Text blocks
// alone are exposed; no thinking, signatures, system/attachment or tool data.
csr_context_text :: (g: [] CsrGraph, index: int, out: [] u8) -> string {
  r := g[0].nodes[index]; if !r.summary || r.removed || !r.selected { return ""; }
  nb: [4096] JvNode; d: [1] Jv;
  if !jv_parse(d[..], r.record, nb[..]) { return ""; }
  content := jv_path(d[0], 0, "message.content");
  if jv_kind(d[0], content) == JV_STRING {
    n := jv_str(d[0], content, out); return ifx n < 0 then "" else cast(string) out[0..<n];
  }
  n := 0;
  for i: 0..<jv_len(d[0], content) {
    b := jv_at(d[0], content, i); t := jv_raw(d[0], jv_get(d[0], b, "type"));
    if t != "text" && t != "input_text" && t != "output_text" { continue; }
    if n > 0 && n < out.count { out[n] = 10; n += 1; }
    k := jv_str(d[0], jv_get(d[0], b, "text"), out[n..<out.count]);
    if k < 0 { csr_warn(g, 10); break; } n += k;
  }
  return cast(string) out[0..<n];
}
csr_context_parts :: (text: string) -> int {
  at := 0; parts := 0;
  while at < text.count { at += csr_cut(cast(string) text[at..<text.count], 2048).count; parts += 1; }
  return parts;
}
csr_context_turn :: (g: [] CsrGraph, index: int, part: int, out: [] u8) -> string {
  scratch: [CSR_LINE_MAX] u8; text := csr_context_text(g, index, scratch[..]);
  parts := csr_context_parts(text); if part < 0 || part >= parts { return ""; }
  at := 0; for i: 0..<part { at += csr_cut(cast(string) text[at..<text.count], 2048).count; }
  chunk := csr_cut(cast(string) text[at..<text.count], 2048);
  n := json_raw(out, 0, "{\"role\":\"context\",\"kind\":\"compaction_summary\",\"uuid\":"); n = json_write_string(out, n, g[0].nodes[index].id);
  n = json_raw(out, n, ",\"part\":"); n = json_write_int(out, n, part);
  n = json_raw(out, n, ",\"parts\":"); n = json_write_int(out, n, parts);
  n = json_raw(out, n, ",\"text\":"); n = json_write_string(out, n, chunk);
  n = json_raw(out, n, ",\"tool_calls\":[],\"tool_results\":[],\"inert\":true}");
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
csr_show :: (g: [] CsrGraph, sid: string, path: string, max_turns: int, before: int, max_tool: int, out: [] u8) -> string {
  return csr_show_mode(g, sid, path, max_turns, before, max_tool, false, out);
}
csr_context_show :: (g: [] CsrGraph, sid: string, path: string, max_turns: int, before: int, max_tool: int, out: [] u8) -> string {
  return csr_show_mode(g, sid, path, max_turns, before, max_tool, true, out);
}
csr_show_mode :: (g: [] CsrGraph, sid: string, path: string, max_turns: int, before: int, max_tool: int, context: bool, out: [] u8) -> string {
  eligible: [CSR_NODES] int; chunks: [CSR_NODES] int; total := 0; turn: [CSR_TURN_MAX] u8; available := false;
  last_user: [512] u8; nu := 0; last_action: [512] u8; na := 0;
  first_user: [256] u8; nf := 0;
  for i: 0..<g[0].norder {
    index := g[0].order[i];
    if g[0].nodes[index].summary {
      available = true;
      if context {
        scratch: [CSR_LINE_MAX] u8; text := csr_context_text(g, index, scratch[..]); parts := csr_context_parts(text);
        if total + parts > CSR_NODES { return "{\"schema\":\"coder.session-reader.v1\",\"source\":\"claude\",\"inert\":true,\"error\":\"context_limit\"}"; }
        for part: 0..<parts { eligible[total] = index; chunks[total] = part; total += 1; }
      }
    }
    v := csr_turn(g, g[0].order[i], max_tool, turn[..]); if v.count == 0 { continue; }
    if !context { eligible[total] = g[0].order[i]; total += 1; }
    // Small summary fields are decoded from the bounded rendered turn.
    ar: [1] ClArena; ab: [8192] u8; ar[0].buf = ab[..]; text := cl_str(ar[..], v, "text");
    if g[0].nodes[g[0].order[i]].kind == 1 && text.count > 0 {
      t := csr_cut(text, 400); nu = t.count; for j: 0..<nu { last_user[j] = t[j]; }
      if nf == 0 { t = csr_cut(text, 200); nf = t.count; for j: 0..<nf { first_user[j] = t[j]; } }
    } else if g[0].nodes[g[0].order[i]].kind == 2 {
      t := ifx text.count > 0 then csr_cut(text, 400) else "recorded inert foreign tool calls";
      na = t.count; for j: 0..<na { last_action[j] = t[j]; }
    }
  }
  if before > total { return "{\"schema\":\"coder.session-reader.v1\",\"source\":\"claude\",\"inert\":true,\"error\":\"invalid_before\"}"; }
  end := ifx before > 0 && before < total then before else total;
  observed := g[0].warnings;
  start := end; page: [CSR_OUTPUT_MAX] u8; used := 0;
  while start > 0 && end - start < max_turns {
    t := ifx context then csr_context_turn(g, eligible[start - 1], chunks[start - 1], turn[..]) else csr_turn(g, eligible[start - 1], max_tool, turn[..]); g[0].warnings = observed;
    extra := t.count + (ifx used > 0 then 1 else 0);
    if used + extra > CSR_OUTPUT_MAX - 8192 { csr_warn(g, 11); break; }
    pos := page.count - used - extra;
    for i: 0..<t.count { page[pos + i] = t[i]; }
    if used > 0 { page[pos + t.count] = ','; }
    used += extra; start -= 1;
  }
  n := json_raw(out, 0, "{\"schema\":\"coder.session-reader.v1\",\"source\":\"claude\",\"inert\":true,\"session_id\":"); n = json_write_string(out, n, csr_cut(sid, 128));
  n = json_raw(out, n, ",\"path\":"); n = json_write_string(out, n, csr_cut(path, 2048));
  n = json_raw(out, n, ",\"cwd\":"); n = json_write_string(out, n, csr_preview(g, g[0].cwd, 1024));
  n = json_raw(out, n, ",\"branch\":"); n = json_write_string(out, n, csr_preview(g, g[0].branch, 200));
  n = json_raw(out, n, ",\"title\":"); n = json_write_string(out, n, csr_preview(g, ifx g[0].title.count > 0 then g[0].title else cast(string) first_user[0..<nf], 200));
  n = json_raw(out, n, ",\"created_at\":"); n = json_write_string(out, n, csr_cut(g[0].first, 64));
  n = json_raw(out, n, ",\"updated_at\":"); n = json_write_string(out, n, csr_cut(g[0].last, 64));
  n = json_raw(out, n, ",\"last_user_request\":"); n = json_write_string(out, n, cast(string) last_user[0..<nu]);
  n = json_raw(out, n, ",\"last_assistant_action\":"); n = json_write_string(out, n, cast(string) last_action[0..<na]);
  n = json_raw(out, n, ifx available then ",\"context_available\":true" else ",\"context_available\":false");
  n = json_raw(out, n, ifx context then ",\"view\":\"compaction_context\"" else ",\"view\":\"conversation\"");
  n = json_raw(out, n, ",\"total_turns\":"); n = json_write_int(out, n, total);
  n = json_raw(out, n, ",\"start\":"); n = json_write_int(out, n, start); n = json_raw(out, n, ",\"end\":"); n = json_write_int(out, n, end);
  n = json_raw(out, n, ",\"next_before\":"); n = ifx start > 0 then json_write_int(out, n, start) else json_raw(out, n, "null");
  n = json_raw(out, n, ",\"turns\":["); n = json_raw(out, n, cast(string) page[page.count - used..<page.count]);
  n = json_raw(out, n, "],\"warnings\":"); n = csr_warnings(g, out, n); n = json_raw(out, n, "}");
  return ifx n < 0 then "{\"error\":\"output buffer too small\"}" else cast(string) out[0..<n];
}
