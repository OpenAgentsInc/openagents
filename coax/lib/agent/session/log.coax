// The session log: one conversation on disk, one JSON object a line, the
// same for every program that keeps or reads a conversation
// (docs/apps/2026-11-10-apps-roadmap.md, Step 2; docs/protocol/session-log-v1.md).
// It is Coder's session log (~/.openagents/coder/sessions/ID.jsonl), which
// Coder's terminal and runs, the turn runner, `coder import`, the desktop app,
// the Metaverse Engine's chat and the agent boards write and read. This file is its one
// writer and its one reader: every line of every kind is built here (sl_session ...
// sl_job) and read here (sl_next, sl_read: "the reader" below; C2, #13239), and
// the shape is pinned by proto/coder/session-log-v1.json (the check:
// coax/web/tool.sh coax/lib/agent/session/log-profile.coax proto/coder/session-log-v1.json)
// and described by proto/openagents/session/log/v1alpha1/log.proto. A reader
// that knows only some keys still reads every line: a key it does not know
// rides along, and a kind it does not know it skips.
//
// The lines ([ ] is left out when empty or 0):
//   {"kind":"session","schema":"openagents.session.v1","id":ID[,"version":V][,"engine":E][,"cwd":DIR][,"started_us":T]
//     [,"title":T][,"model":M][,"imported":"claude"][,"parent":P,"at":N][,"pid":N][,"report_to":ID][,"resume":R]
//     [,"allow":A,"ceiling":C][,"deadline_s":N]}       the first line; Coder always writes version, engine, cwd and started_us
//   {"kind":"user","text":T}                 a message the person sent
//   {"kind":"thinking","text":T}             the model's thinking
//   {"kind":"reply","text":T}                the answer's text (Markdown); one per stretch of text
//   {"kind":"tool","label":"Bash(ls)"[,"tool":K][,"name":NAME][,"id":ID][,"arg":A][,"detail":D][,"old":O][,"new":N][,"input":I]}
//                                            a tool call: K is its kind (SL_TOOLS), old and new an edit's text,
//                                            input the call's JSON or a file change's unified diff
//   {"kind":"result","text":T,"error":B[,"bytes":N][,"output":WHOLE][,"id":ID][,"open":true]}
//                                            its result: text is the first 4000 bytes; a longer one says its size
//                                            (and the desktop app keeps the whole in output)
//   {"kind":"routed","text":T[,"tool":K][,"id":ID][,"arg":A][,"detail":D][,"output":O][,"error":true][,"resolved":true]}
//                                            a routing or loading step (the Lab's decision)
//   {"kind":"notice","notice":K,"text":T}    K is SL_NOTICES: error, signed_out, limit, install, stopped, ...
//   {"kind":"ask","text":T}                  an approval waiting on the person
//   {"kind":"answer","text":T}               the person's answer to it
//   {"kind":"approval","tool":L,"effect":E,"inside":B,"verdict":V,"why":W}   a policy verdict on a call
//   {"kind":"agent","engine":E}              the person switched agent
//   {"kind":"context","text":T} {"kind":"keys","text":T} {"kind":"note","text":T}   what a turn added to its prompt, keys typed, a note
//   {"kind":"memory","text":T[,"withheld":N]}    the remembered facts a first message carried
//   {"kind":"request","sha256":H,"bytes":N}  the digest and length of what a turn sent its engine (`coder replay` checks it)
//   {"kind":"engine_session","engine":E,"id":ID}   the engine's own session, for a fork that resumes it
//   {"kind":"diff","path":P,"adds":N,"dels":N[,"old":T,"new":T]}   an edit's own text (Coder; legacy: wave 2, #13250, moves it to the tool line)
//   {"kind":"hook","on":EV,"plugin":P,"run":CMD[,"tool":L],"ok":B,"text":OUT}   a plugin hook ran
//   {"kind":"goal","check":CMD,"turn":N,"met":B,"text":OUT}   a goal's check ran
//   {"kind":"job","id":ID,"ending":E,"text":T}   a job this session started ended (--report-to)
//   {"kind":"end","ending":E,"ms":N,"steps":N[,"cost_usd_e6":N][,"text":T][,"cause":C]}
//                                            E: finished, stopped, failed, expired, redirected or lost
// Stream records ride in the same file under their own schemas (coder.reply-stream.v1,
// coder.observability.v1/v2, coder.route.v2); they are not this file's.
//
// Reading the record back (sl_load, through the reader) rebuilds it. It also reads what was written
// before this format: Coder's own lines (a tool line with only its label, a
// result with only text, an edit's separate {"kind":"diff","path","old","new"}
// line, an end whose text is the failure, a header with no schema) and the
// desktop app's first format ({"k":"user","t":T} ...), so no saved
// conversation is lost. Lines of any other kind are skipped. No transcript
// field can run anything.

#load "session.coax";
#load "../claude/fields.coax";
#load "../../crypto/sha256.coax";   // the request line's digest

SL_SCHEMA :: "openagents.session.v1";
SL_RESULT_TEXT :: 4000;           // Coder's cut for a result's text
SL_ARENA :: 262144;

// A tool kind's name on disk, by TK_*.
SL_TOOLS :: [15] string.["thought", "exec", "read", "edit", "search", "fetch", "write", "glob", "web", "todo", "mcp", "agent", "tool", "route", "load"];
// What Coder's label calls it (the tool's own name), by TK_*; "" takes the part's detail.
SL_LABELS :: [15] string.["Thought", "Bash", "Read", "Edit", "Grep", "WebFetch", "Write", "Glob", "WebSearch", "TodoWrite", "", "Agent", "", "Route", "Load"];
// A notice kind's name on disk, by N_* (N_ASK is its own line, "ask").
SL_NOTICES :: [10] string.["error", "signed_out", "limit", "install", "stopped", "ask", "busy", "offline", "meta", "codex_install"];

sl_index :: (names: [] const string, name: string) -> int { for i: 0..<names.count { if names[i] == name { return i; } } return -1; }

// ---------------------------------------------------------------- the writer
// Each call appends one line's JSON to out from n, with no newline, and returns the new length,
// or -1 when it does not fit (and -1 stays -1 down a chain of calls). sl_nl ends the line.

sl_nl :: (out: [] u8, n: int) -> int { return json_raw(out, n, "\n"); }
// ,"key":"value", always; and only when there is a value.
sl_key_str :: (out: [] u8, n: int, key: string, v: string) -> int {
  m := json_raw(out, n, ",\""); m = json_raw(out, m, key); m = json_raw(out, m, "\":"); return json_write_string(out, m, v);
}
sl_opt_str :: (out: [] u8, n: int, key: string, v: string) -> int { return ifx v.count > 0 then sl_key_str(out, n, key, v) else n; }
sl_key_int :: (out: [] u8, n: int, key: string, v: int) -> int {
  m := json_raw(out, n, ",\""); m = json_raw(out, m, key); m = json_raw(out, m, "\":"); return json_write_int(out, m, v);
}
sl_key_bool :: (out: [] u8, n: int, key: string, v: bool) -> int {
  m := json_raw(out, n, ",\""); m = json_raw(out, m, key); m = json_raw(out, m, "\":"); return json_raw(out, m, ifx v then "true" else "false");
}
// {"kind":"K"
sl_open :: (out: [] u8, n: int, kind: string) -> int { m := json_raw(out, n, "{\"kind\":"); return json_write_string(out, m, kind); }
sl_close :: (out: [] u8, n: int) -> int { return json_raw(out, n, "}"); }

// The header's fields. A string left empty and a number left 0 (started_us: below 0) are left out;
// always writes version, engine, cwd and started_us whatever they hold, as Coder's header does.
SlHeader :: struct {
  id: string; version: string; engine: string; cwd: string;
  started_us: int = -1;
  title: string; model: string;     // a /chat conversation's (chat.record)
  imported: string;                 // coder import: the engine the conversation came from
  parent: string; at: int;          // a fork's parent session and the turns it kept
  pid: int;                         // a detached run's process
  report_to: string;                // --report-to: the session a job's result goes to
  resume: string;                   // the engine session a fork resumes
  allow: string; ceiling: string;   // the approval policy
  deadline_s: int;                  // --deadline
  always: bool;
}
sl_session :: (out: [] u8, n: int, h: SlHeader) -> int {
  m := sl_open(out, n, "session"); m = sl_key_str(out, m, "schema", SL_SCHEMA); m = sl_key_str(out, m, "id", h.id);
  if h.always { m = sl_key_str(out, m, "version", h.version); m = sl_key_str(out, m, "engine", h.engine); m = sl_key_str(out, m, "cwd", h.cwd); }
  else { m = sl_opt_str(out, m, "version", h.version); m = sl_opt_str(out, m, "engine", h.engine); m = sl_opt_str(out, m, "cwd", h.cwd); }
  if h.always || h.started_us >= 0 { m = sl_key_int(out, m, "started_us", ifx h.started_us >= 0 then h.started_us else 0); }
  m = sl_opt_str(out, m, "title", h.title); m = sl_opt_str(out, m, "model", h.model); m = sl_opt_str(out, m, "imported", h.imported);
  if h.parent.count > 0 { m = sl_key_str(out, m, "parent", h.parent); m = sl_key_int(out, m, "at", h.at); }
  if h.pid > 0 { m = sl_key_int(out, m, "pid", h.pid); }
  m = sl_opt_str(out, m, "report_to", h.report_to); m = sl_opt_str(out, m, "resume", h.resume);
  if h.allow.count > 0 { m = sl_key_str(out, m, "allow", h.allow); m = sl_key_str(out, m, "ceiling", h.ceiling); }
  if h.deadline_s > 0 { m = sl_key_int(out, m, "deadline_s", h.deadline_s); }
  return sl_close(out, m);
}

// A line of one text field: {"kind":"user","text":T}, and so reply, thinking, ask, answer,
// context, keys and note ("text"), and agent ("engine").
sl_text :: (out: [] u8, n: int, kind: string, key: string, text: string) -> int {
  return sl_close(out, sl_key_str(out, sl_open(out, n, kind), key, text));
}

// A tool call. Coder's own line has only its label.
SlTool :: struct { label: string; tool: string; name: string; id: string; arg: string; detail: string; old: string; next: string; input: string; }
sl_tool :: (out: [] u8, n: int, t: SlTool) -> int {
  m := sl_key_str(out, sl_open(out, n, "tool"), "label", t.label);
  m = sl_opt_str(out, m, "tool", t.tool); m = sl_opt_str(out, m, "name", t.name); m = sl_opt_str(out, m, "id", t.id);
  m = sl_opt_str(out, m, "arg", t.arg); m = sl_opt_str(out, m, "detail", t.detail);
  m = sl_opt_str(out, m, "old", t.old); m = sl_opt_str(out, m, "new", t.next); m = sl_opt_str(out, m, "input", t.input);
  return sl_close(out, m);
}

// Where text is cut to at most most bytes, never inside a character.
sl_cut :: (text: string, most: int) -> int {
  cut := ifx text.count > most then most else text.count;
  while cut > 0 && cut < text.count && (text[cut] & 0xC0) == 0x80 { cut -= 1; }
  return cut;
}
// A call's result: shown is its text as logged (cut), bytes its whole size when cut (0: not cut),
// output the whole when it is kept, open while the call still runs.
sl_result :: (out: [] u8, n: int, shown: string, failed: bool, bytes: int, output: string, id: string, open: bool) -> int {
  m := sl_key_str(out, sl_open(out, n, "result"), "text", shown); m = sl_key_bool(out, m, "error", failed);
  if bytes > 0 { m = sl_key_int(out, m, "bytes", bytes); }
  m = sl_opt_str(out, m, "output", output); m = sl_opt_str(out, m, "id", id);
  if open { m = json_raw(out, m, ",\"open\":true"); }
  return sl_close(out, m);
}

sl_routed :: (out: [] u8, n: int, text: string, tool: string, id: string, arg: string, detail: string, output: string, failed: bool, resolved: bool) -> int {
  m := sl_key_str(out, sl_open(out, n, "routed"), "text", text);
  m = sl_opt_str(out, m, "tool", tool); m = sl_opt_str(out, m, "id", id); m = sl_opt_str(out, m, "arg", arg);
  m = sl_opt_str(out, m, "detail", detail); m = sl_opt_str(out, m, "output", output);
  if failed { m = json_raw(out, m, ",\"error\":true"); }
  if resolved { m = json_raw(out, m, ",\"resolved\":true"); }
  return sl_close(out, m);
}

sl_notice :: (out: [] u8, n: int, notice: string, text: string) -> int {
  return sl_close(out, sl_key_str(out, sl_key_str(out, sl_open(out, n, "notice"), "notice", notice), "text", text));
}

// One approval verdict: effect and verdict are CD_EFFECTS and CD_VERDICTS names.
sl_approval :: (out: [] u8, n: int, tool: string, effect: string, inside: bool, verdict: string, why: string) -> int {
  m := sl_key_str(out, sl_open(out, n, "approval"), "tool", tool); m = sl_key_str(out, m, "effect", effect);
  m = sl_key_bool(out, m, "inside", inside); m = sl_key_str(out, m, "verdict", verdict);
  return sl_close(out, sl_key_str(out, m, "why", why));
}

// SHA-256 of s (its first 64 KiB) as 64 lowercase hex digits.
sl_sha256_hex :: (s: string, out: [] u8) -> string {
  ib: [65536] u8; n := ifx s.count <= ib.count then s.count else ib.count;
  for i: 0..<n { ib[i] = s[i]; }
  d: [32] u8; x := sha256_hash_checked(ib[0..<n], d[..], false);
  digits := "0123456789abcdef";
  for i: 0..<32 { out[2 * i] = digits[cast(int) (d[i] >> 4)]; out[2 * i + 1] = digits[cast(int) (d[i] & 15)]; }
  return cast(string) out[0..<64];
}
// The digest and length of what a turn sent its engine (`coder replay` rebuilds it).
sl_request :: (out: [] u8, n: int, sent: string) -> int {
  hb: [64] u8; h := sl_sha256_hex(sent, hb[..]);
  return sl_close(out, sl_key_int(out, sl_key_str(out, sl_open(out, n, "request"), "sha256", h), "bytes", sent.count));
}

// The remembered facts a first message carried, and how many the consent gate held back.
sl_memory :: (out: [] u8, n: int, text: string, withheld: int) -> int {
  m := sl_key_str(out, sl_open(out, n, "memory"), "text", text);
  if withheld > 0 { m = sl_key_int(out, m, "withheld", withheld); }
  return sl_close(out, m);
}

sl_engine_session :: (out: [] u8, n: int, engine: string, id: string) -> int {
  return sl_close(out, sl_key_str(out, sl_key_str(out, sl_open(out, n, "engine_session"), "engine", engine), "id", id));
}

// An edit's counts, and its own text when texts is set.
sl_diff :: (out: [] u8, n: int, path: string, adds: int, dels: int, texts: bool, old: string, next: string) -> int {
  m := sl_key_str(out, sl_open(out, n, "diff"), "path", path); m = sl_key_int(out, m, "adds", adds); m = sl_key_int(out, m, "dels", dels);
  if texts { m = sl_key_str(out, m, "old", old); m = sl_key_str(out, m, "new", next); }
  return sl_close(out, m);
}

sl_hook :: (out: [] u8, n: int, on: string, plugin: string, run: string, tool: string, ok: bool, text: string) -> int {
  m := sl_key_str(out, sl_open(out, n, "hook"), "on", on); m = sl_key_str(out, m, "plugin", plugin); m = sl_key_str(out, m, "run", run);
  m = sl_opt_str(out, m, "tool", tool); m = sl_key_bool(out, m, "ok", ok);
  return sl_close(out, sl_key_str(out, m, "text", text));
}

sl_goal :: (out: [] u8, n: int, check: string, turn: int, met: bool, text: string) -> int {
  m := sl_key_str(out, sl_open(out, n, "goal"), "check", check); m = sl_key_int(out, m, "turn", turn); m = sl_key_bool(out, m, "met", met);
  return sl_close(out, sl_key_str(out, m, "text", text));
}

sl_job :: (out: [] u8, n: int, id: string, ending: string, text: string) -> int {
  return sl_close(out, sl_key_str(out, sl_key_str(out, sl_key_str(out, sl_open(out, n, "job"), "id", id), "ending", ending), "text", text));
}

// The turn's end. cost_e6 below 0 is left out; so are an empty text and cause.
sl_end :: (out: [] u8, n: int, ending: string, ms: int, steps: int, cost_e6: int, text: string, cause: string) -> int {
  m := sl_key_str(out, sl_open(out, n, "end"), "ending", ending); m = sl_key_int(out, m, "ms", ms); m = sl_key_int(out, m, "steps", steps);
  if cost_e6 >= 0 { m = sl_key_int(out, m, "cost_usd_e6", cost_e6); }
  m = sl_opt_str(out, m, "text", text); m = sl_opt_str(out, m, "cause", cause);
  return sl_close(out, m);
}

// ---------------------------------------------------------------- the reader
// Every program that reads a session log reads it here (C2, #13239): no other file looks up a
// line's key. sl_next walks a log's lines and names each one's kind cheaply (the writer puts
// "kind" first, so most lines need no parse; the memory scan reads only that), and sl_read gives a
// line's fields, typed, as its kind has them. A field the line leaves out reads empty, 0 or false
// (bytes, started_us and cost_e6: -1). A kind this log does not have (the stream records,
// Microcoder's journal, attempt) reads as SK_OTHER with its name; a line that isn't a JSON object
// reads as SK_OTHER with no name once sl_read has run.
//
//   r: [1] SlReader; r[0] = SlReader.{text = log}; l: [1] SlLine; ar: [1] ClArena; ar[0] = ClArena.{buf = ...};
//   while sl_next(r[..], l[..]) { sl_read(ar[..], l[..]); if l[0].kind == SK_USER { ... l[0].text ... } }

// The kinds, by SK_* (log.proto's Line, in its order).
SL_KINDS :: [23] string.["session", "user", "thinking", "reply", "tool", "result", "routed", "notice", "ask", "answer", "approval", "agent",
                         "context", "keys", "note", "memory", "request", "engine_session", "diff", "hook", "goal", "job", "end"];
SK_OTHER :: -1;
SK_SESSION :: 0; SK_USER :: 1; SK_THINKING :: 2; SK_REPLY :: 3; SK_TOOL :: 4; SK_RESULT :: 5; SK_ROUTED :: 6; SK_NOTICE :: 7;
SK_ASK :: 8; SK_ANSWER :: 9; SK_APPROVAL :: 10; SK_AGENT :: 11; SK_CONTEXT :: 12; SK_KEYS :: 13; SK_NOTE :: 14; SK_MEMORY :: 15;
SK_REQUEST :: 16; SK_ENGINE_SESSION :: 17; SK_DIFF :: 18; SK_HOOK :: 19; SK_GOAL :: 20; SK_JOB :: 21; SK_END :: 22;
// The desktop app's first format's kinds ({"k":K,...}), and the kinds they are now.
SL_FIRST_KINDS :: [7] string.["user", "text", "think", "tool", "notice", "route", "end"];
SL_FIRST_AS :: [7] int.[SK_USER, SK_REPLY, SK_THINKING, SK_TOOL, SK_NOTICE, SK_ROUTED, SK_END];

// first: read the desktop app's first format as the kinds it is now (the record, sl_load, does);
// else such a line is SK_OTHER, as every reader that never wrote it had it.
SlReader :: struct { text: string; at: int; no: int; first: bool; }

// One line and, once sl_read has run, its fields. Strings borrow the line, or the arena sl_read had.
SlLine :: struct {
  kind: int = SK_OTHER;
  name: string;            // the kind as written ("attempt", "journal" ... for one this log does not have)
  line: string;            // the line's bytes, without its \n
  no: int;                 // its line number in the file, from 1 (empty lines count)
  whole: bool;             // it ends with \n (a last line without one may still be being written)
  first: bool;             // the desktop app's first format ({"k":"user","t":T})
  header: SlHeader;        // session
  text: string;            // user, thinking, reply, ask, answer, context, keys, note, memory, result, routed, notice, hook, goal, job, end
  label: string; tool: string; tool_name: string;   // tool (tool_name is its "name"); tool is also approval's, routed's and hook's
  id: string; arg: string; detail: string;          // tool and routed; id is also result's, engine_session's and job's
  old: string; next: string; input: string;         // tool, and diff's old and new
  has_old: bool; has_new: bool;                     // diff: the line carries old, new (either may be "")
  output: string; error: bool; open: bool; resolved: bool;   // result and routed
  bytes: int = -1;                                  // result (when cut, its whole size) and request
  sha256: string;                                   // request
  notice: string;                                   // notice: an SL_NOTICES name (an ask is its own kind)
  effect: string; inside: bool; verdict: string; why: string;   // approval
  engine: string;                                   // agent and engine_session
  withheld: int;                                    // memory
  path: string; adds: int; dels: int;               // diff
  on: string; plugin: string; run: string; ok: bool;   // hook
  check: string; turn: int; met: bool;              // goal
  ending: string; ms: int; steps: int; cost_e6: int = -1; cause: string;   // end; ending is also job's
  timed: bool;                                      // end: the line has its ms
  cost: f64 = -1.0;                                 // the first format's end: dollars
  tk: int = -1; notice_index: int = -1;             // the first format's tool kind and notice, by TK_* and N_*
}

sl_starts :: (s: string, p: string) -> bool { return s.count >= p.count && cast(string) s[0..<p.count] == p; }

// A string value's bytes when it has no escape (a kind's name never has one), else "".
sl_plain :: (line: string, v: ClSlice) -> string {
  if !v.ok || v.tok != JSON_STRING { return ""; }
  raw := cast(string) line[v.from..<v.to];
  for c: raw { if c == '\\' { return ""; } }
  return raw;
}

// A line's kind: from its first bytes when the writer wrote it (no parse), else from its "kind",
// or the first format's "k". Sets kind, name and first.
sl_kind_of :: (l: [] SlLine) {
  line := l[0].line;
  l[0].kind = SK_OTHER; l[0].name = ""; l[0].first = false;
  p := "{\"kind\":\"";
  name := "";
  if sl_starts(line, p) {
    e := p.count; while e < line.count && line[e] != '"' && line[e] != '\\' { e += 1; }
    if e < line.count && line[e] == '"' { name = cast(string) line[p.count..<e]; }
  }
  if name.count == 0 {
    k := sl_plain(line, cl_at(line, "k"));
    if k.count > 0 {
      fk := SL_FIRST_KINDS; fa := SL_FIRST_AS;
      i := sl_index(fk[..], k);
      l[0].first = true; l[0].name = k;
      if i >= 0 { l[0].kind = fa[i]; }
      return;
    }
    name = sl_plain(line, cl_at(line, "kind"));
  }
  l[0].name = name;
  kinds := SL_KINDS;
  l[0].kind = sl_index(kinds[..], name);
}

// The next line of r with anything on it, its kind named; false at the end of the text.
sl_next :: (r: [] SlReader, l: [] SlLine) -> bool {
  t := r[0].text;
  while r[0].at < t.count {
    q := r[0].at; e := q;
    while e < t.count && t[e] != '\n' { e += 1; }
    r[0].at = e + 1; r[0].no += 1;
    if e - q < 2 { continue; }
    l[0] = SlLine.{line = cast(string) t[q..<e], no = r[0].no, whole = e < t.count};
    sl_kind_of(l);
    if l[0].first && !r[0].first { l[0].kind = SK_OTHER; l[0].name = ""; l[0].first = false; }
    return true;
  }
  return false;
}

sl_s :: (ar: [] ClArena, line: string, key: string) -> string { return cl_str(ar, line, key); }
sl_i :: (line: string, key: string, missing: int) -> int { v := cl_int(line, key); return ifx v.ok then cast(int) v.value else missing; }
sl_b :: (line: string, key: string) -> bool { v := cl_bool(line, key); return v.ok && v.value; }

// The line's fields, as its kind has them. Its strings live in ar, which this empties first, until
// the next sl_read with ar. A line that isn't a JSON object becomes SK_OTHER with no name.
sl_read :: (ar: [] ClArena, l: [] SlLine) {
  ar[0].at = 0; ar[0].full = false;
  line := l[0].line; k := l[0].kind;
  root := cl_root(line);
  if !root.ok || root.tok != JSON_OBJECT { l[0].kind = SK_OTHER; l[0].name = ""; l[0].first = false; return; }
  if l[0].first {
    l[0].text = sl_s(ar, line, "t");
    if k == SK_END { l[0].ms = sl_i(line, "ms", 0); l[0].timed = cl_at(line, "ms").ok; c := cl_num(line, "cost"); if c.ok { l[0].cost = c.value; } }
    if k == SK_NOTICE { l[0].notice_index = sl_i(line, "notice", -1); }
    if k == SK_TOOL || k == SK_ROUTED {
      l[0].tk = sl_i(line, "tk", -1);
      l[0].id = sl_s(ar, line, "id"); l[0].arg = sl_s(ar, line, "arg"); l[0].detail = sl_s(ar, line, "detail");
      l[0].old = sl_s(ar, line, "before"); l[0].next = sl_s(ar, line, "after"); l[0].input = sl_s(ar, line, "input");
      l[0].output = sl_s(ar, line, "output"); l[0].error = sl_b(line, "failed"); l[0].resolved = sl_b(line, "resolved");
    }
    return;
  }
  if k == SK_SESSION {
    l[0].header = SlHeader.{id = sl_s(ar, line, "id"), version = sl_s(ar, line, "version"), engine = sl_s(ar, line, "engine"), cwd = sl_s(ar, line, "cwd"),
      started_us = sl_i(line, "started_us", -1), title = sl_s(ar, line, "title"), model = sl_s(ar, line, "model"), imported = sl_s(ar, line, "imported"),
      parent = sl_s(ar, line, "parent"), at = sl_i(line, "at", 0), pid = sl_i(line, "pid", 0), report_to = sl_s(ar, line, "report_to"),
      resume = sl_s(ar, line, "resume"), allow = sl_s(ar, line, "allow"), ceiling = sl_s(ar, line, "ceiling"), deadline_s = sl_i(line, "deadline_s", 0)};
    // a header that names what it always writes (Coder's) is written again the same way
    l[0].header.always = cl_at(line, "version").ok && cl_at(line, "engine").ok && cl_at(line, "cwd").ok && cl_at(line, "started_us").ok;
    return;
  }
  if k == SK_AGENT { l[0].engine = sl_s(ar, line, "engine"); return; }
  if k == SK_TOOL {
    l[0].label = sl_s(ar, line, "label"); l[0].tool = sl_s(ar, line, "tool"); l[0].tool_name = sl_s(ar, line, "name");
    l[0].id = sl_s(ar, line, "id"); l[0].arg = sl_s(ar, line, "arg"); l[0].detail = sl_s(ar, line, "detail");
    l[0].old = sl_s(ar, line, "old"); l[0].next = sl_s(ar, line, "new"); l[0].input = sl_s(ar, line, "input");
    return;
  }
  if k == SK_APPROVAL {
    l[0].tool = sl_s(ar, line, "tool"); l[0].effect = sl_s(ar, line, "effect"); l[0].inside = sl_b(line, "inside");
    l[0].verdict = sl_s(ar, line, "verdict"); l[0].why = sl_s(ar, line, "why");
    return;
  }
  if k == SK_REQUEST { l[0].sha256 = sl_s(ar, line, "sha256"); l[0].bytes = sl_i(line, "bytes", -1); return; }
  if k == SK_ENGINE_SESSION { l[0].engine = sl_s(ar, line, "engine"); l[0].id = sl_s(ar, line, "id"); return; }
  if k == SK_DIFF {
    l[0].path = sl_s(ar, line, "path"); l[0].adds = sl_i(line, "adds", 0); l[0].dels = sl_i(line, "dels", 0);
    l[0].has_old = cl_at(line, "old").ok; l[0].has_new = cl_at(line, "new").ok;
    l[0].old = sl_s(ar, line, "old"); l[0].next = sl_s(ar, line, "new");
    return;
  }
  // every other kind, and one this log does not have, may carry a text
  l[0].text = sl_s(ar, line, "text");
  if k == SK_RESULT || k == SK_ROUTED {
    l[0].error = sl_b(line, "error"); l[0].id = sl_s(ar, line, "id"); l[0].output = sl_s(ar, line, "output");
    if k == SK_RESULT { l[0].bytes = sl_i(line, "bytes", -1); l[0].open = sl_b(line, "open"); }
    else { l[0].tool = sl_s(ar, line, "tool"); l[0].arg = sl_s(ar, line, "arg"); l[0].detail = sl_s(ar, line, "detail"); l[0].resolved = sl_b(line, "resolved"); }
  }
  else if k == SK_NOTICE { l[0].notice = sl_s(ar, line, "notice"); }
  else if k == SK_MEMORY { l[0].withheld = sl_i(line, "withheld", 0); }
  else if k == SK_HOOK {
    l[0].on = sl_s(ar, line, "on"); l[0].plugin = sl_s(ar, line, "plugin"); l[0].run = sl_s(ar, line, "run");
    l[0].tool = sl_s(ar, line, "tool"); l[0].ok = sl_b(line, "ok");
  }
  else if k == SK_GOAL { l[0].check = sl_s(ar, line, "check"); l[0].turn = sl_i(line, "turn", 0); l[0].met = sl_b(line, "met"); }
  else if k == SK_JOB { l[0].id = sl_s(ar, line, "id"); l[0].ending = sl_s(ar, line, "ending"); }
  else if k == SK_END {
    l[0].ending = sl_s(ar, line, "ending"); l[0].ms = sl_i(line, "ms", 0); l[0].timed = cl_at(line, "ms").ok; l[0].steps = sl_i(line, "steps", 0);
    l[0].cost_e6 = sl_i(line, "cost_usd_e6", -1); l[0].cause = sl_s(ar, line, "cause");
  }
}

// The line written again from its fields, through the writer. A line the writer wrote comes back
// byte for byte; log-profile.coax --read holds chat.record's SQL to that. Its length, or -1.
sl_rewrite :: (l: [] SlLine, out: [] u8) -> int {
  k := l[0].kind;
  if l[0].first || k == SK_OTHER { return -1; }
  if k == SK_SESSION { return sl_session(out, 0, l[0].header); }
  if k == SK_AGENT { return sl_text(out, 0, "agent", "engine", l[0].engine); }
  if k == SK_TOOL {
    return sl_tool(out, 0, SlTool.{label = l[0].label, tool = l[0].tool, name = l[0].tool_name, id = l[0].id, arg = l[0].arg, detail = l[0].detail,
                                   old = l[0].old, next = l[0].next, input = l[0].input});
  }
  if k == SK_RESULT { return sl_result(out, 0, l[0].text, l[0].error, ifx l[0].bytes > 0 then l[0].bytes else 0, l[0].output, l[0].id, l[0].open); }
  if k == SK_ROUTED { return sl_routed(out, 0, l[0].text, l[0].tool, l[0].id, l[0].arg, l[0].detail, l[0].output, l[0].error, l[0].resolved); }
  if k == SK_NOTICE { return sl_notice(out, 0, l[0].notice, l[0].text); }
  if k == SK_APPROVAL { return sl_approval(out, 0, l[0].tool, l[0].effect, l[0].inside, l[0].verdict, l[0].why); }
  if k == SK_MEMORY { return sl_memory(out, 0, l[0].text, l[0].withheld); }
  if k == SK_REQUEST { return sl_close(out, sl_key_int(out, sl_key_str(out, sl_open(out, 0, "request"), "sha256", l[0].sha256), "bytes", l[0].bytes)); }
  if k == SK_ENGINE_SESSION { return sl_engine_session(out, 0, l[0].engine, l[0].id); }
  if k == SK_DIFF { return sl_diff(out, 0, l[0].path, l[0].adds, l[0].dels, l[0].has_old || l[0].has_new, l[0].old, l[0].next); }
  if k == SK_HOOK { return sl_hook(out, 0, l[0].on, l[0].plugin, l[0].run, l[0].tool, l[0].ok, l[0].text); }
  if k == SK_GOAL { return sl_goal(out, 0, l[0].check, l[0].turn, l[0].met, l[0].text); }
  if k == SK_JOB { return sl_job(out, 0, l[0].id, l[0].ending, l[0].text); }
  if k == SK_END { return sl_end(out, 0, l[0].ending, l[0].ms, l[0].steps, l[0].cost_e6, l[0].text, l[0].cause); }
  kinds := SL_KINDS;
  return sl_text(out, 0, kinds[k], "text", l[0].text);
}

// The number of the last line a person typed (from 1, as sl_next counts), or 0. The memory scan:
// it needs only each line's kind, so nothing is parsed.
sl_last_user :: (text: string) -> int {
  r: [1] SlReader; r[0] = SlReader.{text = text}; l: [1] SlLine; last := 0;
  while sl_next(r[..], l[..]) { if l[0].kind == SK_USER && l[0].whole { last = l[0].no; } }
  return last;
}

// The header on a log's first line; its id is "" when the first line isn't one.
sl_first_header :: (text: string, ar: [] ClArena) -> SlHeader {
  e := 0; while e < text.count && text[e] != '\n' { e += 1; }
  r: [1] SlReader; r[0] = SlReader.{text = cast(string) text[0..<e]}; l: [1] SlLine;
  if !sl_next(r[..], l[..]) { return SlHeader.{}; }
  sl_read(ar, l[..]);
  return ifx l[0].kind == SK_SESSION then l[0].header else SlHeader.{};
}

// ---------------------------------------------------------------- a record as lines

// The file's first line, for a record (the desktop app). Its length (0 when it did not fit).
sl_header :: (out: [] u8, id: string, engine: string, cwd: string, started_us: int) -> int {
  n := sl_nl(out, sl_session(out, 0, SlHeader.{id = id, engine = engine, cwd = cwd, started_us = ifx started_us > 0 then started_us else -1}));
  return ifx n < 0 then 0 else n;
}

// A tool part as Coder labels a call: "Bash(ls -la)", "Edit(/w/notes.txt)".
sl_label :: (s: [] Session, k: int, buf: [] u8) -> string {
  p := s[0].parts[k];
  names := SL_LABELS;
  name := ifx p.tk >= 0 && p.tk < 15 then names[p.tk] else "";
  inside := ifx p.detail.count > 0 && name.count > 0 then p.detail else p.arg;
  if name.count == 0 { name = ifx p.detail.count > 0 then p.detail else "Tool"; inside = ""; }
  // one line, and short: the label is what a list shows
  n := 0;
  for c: name { if n < 60 { buf[n] = c; n += 1; } }
  if inside.count > 0 {
    buf[n] = '('; n += 1;
    for c: inside { if c == '\n' || n >= 196 { break; } buf[n] = c; n += 1; }
    while n > 0 && (buf[n - 1] & 0xC0) == 0x80 { n -= 1; }     // never cut inside a character
    if n > 0 && buf[n - 1] >= 0xC0 { n -= 1; }
    buf[n] = ')'; n += 1;
  }
  return cast(string) buf[0..<n];
}

// The turn's ending, read from the record: stopped, failed (it has an error notice) or finished.
sl_ending :: (s: [] Session, from: int, to: int) -> string {
  failed := false;
  for k: from..<to {
    p := s[0].parts[k];
    if p.kind != P_NOTICE { continue; }
    if p.notice == N_STOPPED { return "stopped"; }
    if p.notice != N_ASK && p.notice != N_META && p.notice != N_INSTALL && p.notice != N_CODEX_INSTALL { failed = true; }
  }
  return ifx failed then "failed" else "finished";
}

// Parts from..<to as lines, then the turn's end when it is over. Its length (0 when it did not fit).
sl_lines :: (s: [] Session, from: int, to: int, ended: bool, out: [] u8) -> int {
  tools := SL_TOOLS; notices := SL_NOTICES;
  steps := 0; n := 0;
  for k: from..<to {
    p := s[0].parts[k];
    text := s_text_of(s, k);
    if p.kind == P_USER { n = sl_nl(out, sl_text(out, n, "user", "text", text)); }
    else if p.kind == P_TEXT { n = sl_nl(out, sl_text(out, n, "reply", "text", text)); }
    else if p.kind == P_THINK { n = sl_nl(out, sl_text(out, n, "thinking", "text", text)); }
    else if p.kind == P_NOTICE {
      if p.notice == N_ASK { n = sl_nl(out, sl_text(out, n, "ask", "text", text)); }
      else { n = sl_nl(out, sl_notice(out, n, ifx p.notice >= 0 && p.notice < 10 then notices[p.notice] else "error", text)); }
    }
    else if p.kind == P_ROUTE {
      n = sl_nl(out, sl_routed(out, n, text, ifx p.tk >= 0 && p.tk < 15 then tools[p.tk] else "route", p.id, p.arg, p.detail, p.output, p.failed, p.resolved));
    }
    else if p.kind == P_TOOL {
      steps += 1;
      lb: [200] u8;
      n = sl_nl(out, sl_tool(out, n, SlTool.{label = sl_label(s, k, lb[..]), tool = ifx p.tk >= 0 && p.tk < 15 then tools[p.tk] else "tool", name = p.name,
                                            id = p.id, arg = p.arg, detail = p.detail, old = p.before, next = p.after, input = p.input}));
      if p.resolved || p.failed || p.output.count > 0 {
        cut := sl_cut(p.output, SL_RESULT_TEXT);
        whole := cut < p.output.count;
        n = sl_nl(out, sl_result(out, n, cast(string) p.output[0..<cut], p.failed, ifx whole then p.output.count else 0, ifx whole then p.output else "", p.id, !p.resolved));
      }
    }
  }
  if ended { n = sl_nl(out, sl_end(out, n, sl_ending(s, from, to), s[0].turn_ms, steps, cast(int) (s[0].cost * 1000000.0), "", "")); }
  return ifx n < 0 then 0 else n;
}

// A Coder label back into a tool part: "Bash(ls -la)" is an exec whose argument is "ls -la".
sl_from_label :: (s: [] Session, k: int, label: string) {
  open := -1;
  for i: 0..<label.count { if label[i] == '(' { open = i; break; } }
  name := ifx open >= 0 then cast(string) label[0..<open] else label;
  inside := ifx open >= 0 && label.count > open + 1 && label[label.count - 1] == ')' then cast(string) label[open + 1..<label.count - 1] else "";
  names := SL_LABELS;
  tk := TK_TOOL;
  for i: 0..<15 { if names[i].count > 0 && names[i] == name { tk = i; } }
  if name == "Task" { tk = TK_AGENT; }
  if name == "MultiEdit" || name == "NotebookEdit" { tk = TK_EDIT; }
  s[0].parts[k].tk = tk;
  if tk == TK_TOOL { s[0].parts[k].detail = s_put(s, name); s[0].parts[k].arg = s_put(s, inside); return; }
  s[0].parts[k].arg = s_put(s, inside);
  if tk == TK_EXEC || tk == TK_AGENT { s[0].parts[k].detail = s_single(s, inside); }
}

// The last tool part a result or a diff belongs to: by id, else the newest one still open, else the newest.
sl_tool_for :: (s: [] Session, id: string) -> int {
  if id.count > 0 { k := s_tool_of(s, id); if k >= 0 { return k; } }
  k := s[0].n - 1; newest := -1;
  while k >= 0 && s[0].parts[k].kind != P_USER {
    if s[0].parts[k].kind == P_TOOL { if newest < 0 { newest = k; } if !s[0].parts[k].resolved { return k; } }
    k -= 1;
  }
  return newest;
}

// Whether the turn in progress (since the last user part) already has a notice of its ending.
sl_turn_noticed :: (s: [] Session) -> bool {
  k := s[0].n - 1;
  while k >= 0 && s[0].parts[k].kind != P_USER {
    if s[0].parts[k].kind == P_NOTICE && s[0].parts[k].notice != N_ASK && s[0].parts[k].notice != N_META { return true; }
    k -= 1;
  }
  return false;
}

// The desktop app's first format, one line: {"k":"tool","t":T,"tk":N,...} (apps/openagents-desktop/zeron/store.coax before this file).
sl_load_first :: (s: [] Session, l: SlLine) -> bool {
  if l.kind == SK_END {
    if l.timed { s[0].turn_ms = l.ms; }
    if l.cost >= 0.0 { s[0].cost = l.cost; }
    return true;
  }
  kind := ifx l.kind == SK_USER then P_USER else ifx l.kind == SK_REPLY then P_TEXT else ifx l.kind == SK_THINKING then P_THINK
          else ifx l.kind == SK_TOOL then P_TOOL else ifx l.kind == SK_NOTICE then P_NOTICE else ifx l.kind == SK_ROUTED then P_ROUTE else -1;
  if kind < 0 { return true; }
  k := s_part(s, kind);
  if k < 0 { return false; }
  s_append(s, k, l.text);
  if kind == P_USER { s[0].turns += 1; }
  if kind == P_NOTICE && l.notice_index >= 0 { s[0].parts[k].notice = l.notice_index; }
  if kind == P_TOOL || kind == P_ROUTE {
    p := s[0].parts[k];
    if l.tk >= 0 { p.tk = l.tk; }
    p.id = s_put(s, l.id); p.arg = s_put(s, l.arg); p.detail = s_put(s, l.detail); p.before = s_put(s, l.old);
    p.after = s_put(s, l.next); p.input = s_put(s, l.input); p.output = s_put(s, l.output);
    p.failed = l.error; p.resolved = l.resolved;
    s[0].parts[k] = p;
  }
  return true;
}

// One line, read, into the record. False when the record is full (reading stops).
sl_load_line :: (s: [] Session, l: SlLine) -> bool {
  if l.first { return sl_load_first(s, l); }
  kind := l.kind;
  tools := SL_TOOLS; notices := SL_NOTICES;
  if kind == SK_USER || kind == SK_REPLY || kind == SK_THINKING {
    k := s_part(s, ifx kind == SK_USER then P_USER else ifx kind == SK_REPLY then P_TEXT else P_THINK);
    if k < 0 { return false; }
    s_append(s, k, l.text);
    if kind == SK_USER { s[0].turns += 1; }
    return true;
  }
  if kind == SK_TOOL || kind == SK_ROUTED {
    k := s_part(s, ifx kind == SK_TOOL then P_TOOL else P_ROUTE);
    if k < 0 { return false; }
    if kind == SK_ROUTED { s_append(s, k, l.text); }
    if l.tool.count == 0 && kind == SK_TOOL { sl_from_label(s, k, l.label); return true; }   // Coder's own line
    p := s[0].parts[k];
    tk := sl_index(tools[..], l.tool);
    p.tk = ifx tk >= 0 then tk else ifx kind == SK_TOOL then TK_TOOL else TK_ROUTE;
    p.id = s_put(s, l.id); p.arg = s_put(s, l.arg); p.detail = s_put(s, l.detail);
    p.before = s_put(s, l.old); p.after = s_put(s, l.next); p.input = s_put(s, l.input);
    p.name = s_put(s, l.tool_name);
    if kind == SK_ROUTED { p.output = s_put(s, l.output); p.failed = l.error; p.resolved = l.resolved; }
    s[0].parts[k] = p;
    return true;
  }
  if kind == SK_RESULT {
    k := sl_tool_for(s, l.id);
    if k < 0 { return true; }
    s[0].parts[k].output = s_put(s, ifx l.output.count > 0 then l.output else l.text);
    s[0].parts[k].failed = l.error;
    s[0].parts[k].resolved = !l.open;
    return true;
  }
  if kind == SK_DIFF {
    // Coder logs an edit's text on its own line, after the call
    k := sl_tool_for(s, "");
    if k < 0 || (s[0].parts[k].tk != TK_EDIT && s[0].parts[k].tk != TK_WRITE) || s[0].parts[k].before.count > 0 || s[0].parts[k].after.count > 0 {
      k = s_part(s, P_TOOL);
      if k < 0 { return false; }
      s[0].parts[k].tk = TK_EDIT; s[0].parts[k].resolved = true;
    }
    if s[0].parts[k].arg.count == 0 { s[0].parts[k].arg = s_put(s, l.path); }
    s[0].parts[k].before = s_put(s, l.old); s[0].parts[k].after = s_put(s, l.next);
    return true;
  }
  if kind == SK_NOTICE || kind == SK_ASK {
    k := s_part(s, P_NOTICE);
    if k < 0 { return false; }
    n := ifx kind == SK_ASK then N_ASK else sl_index(notices[..], l.notice);
    s[0].parts[k].notice = ifx n >= 0 then n else N_ERROR;
    s_append(s, k, l.text);
    return true;
  }
  if kind == SK_END {
    if l.timed { s[0].turn_ms = l.ms; }
    if l.cost_e6 >= 0 { s[0].cost = cast(f64) l.cost_e6 / 1000000.0; }
    // a log that names its ending without a notice (Coder's): the record shows it the same way
    ending := l.ending;
    if (ending == "stopped" || ending == "failed" || ending == "expired") && !sl_turn_noticed(s) {
      k := s_part(s, P_NOTICE);
      if k < 0 { return false; }
      s[0].parts[k].notice = ifx ending == "stopped" then N_STOPPED else N_ERROR;
      if ending != "stopped" { s_append(s, k, ifx l.text.count > 0 then l.text else ifx ending == "expired" then "The job passed its deadline." else "The turn failed."); }
    }
    return true;
  }
  return true;
}

// A log back into a fresh record: the same parts, its turns, cost and last turn's time.
sl_load :: (s: [] Session, text: string) {
  abuf: [SL_ARENA] u8; ar: [1] ClArena; ar[0].buf = abuf[..];
  r: [1] SlReader; r[0] = SlReader.{text = text, first = true}; l: [1] SlLine;
  while sl_next(r[..], l[..]) {
    sl_read(ar[..], l[..]);
    if !sl_load_line(s, l[0]) { break; }
  }
  s[0].changed = true;
}

// ---------------------------------------------------------------- checks

sl_test_same :: (a: [] Session, b: [] Session) -> bool {
  if a[0].n != b[0].n { return false; }
  for k: 0..<a[0].n {
    p := a[0].parts[k]; q := b[0].parts[k];
    if p.kind != q.kind || s_text_of(a, k) != s_text_of(b, k) || p.notice != q.notice { return false; }
    if p.tk != q.tk || p.id != q.id || p.arg != q.arg || p.detail != q.detail || p.before != q.before || p.after != q.after { return false; }
    if p.input != q.input || p.output != q.output || p.failed != q.failed || p.resolved != q.resolved || p.name != q.name { return false; }
  }
  return true;
}
// A tool part as an engine leaves it.
sl_test_tool :: (s: [] Session, id: string, tk: int, arg: string, detail: string, before: string, after: string, input: string, output: string, failed: bool) {
  k := s_part(s, P_TOOL);
  p := SPart.{kind = P_TOOL, at = s[0].np, id = s_put(s, id), tk = tk, arg = s_put(s, arg), detail = s_put(s, detail), before = s_put(s, before),
              after = s_put(s, after), input = s_put(s, input), output = s_put(s, output), failed = failed, resolved = true};
  s[0].parts[k] = p;
}

#test "a record written as a log reads back the same: every kind of part, its tool calls whole, the cost and time" {
  s: [1] Session; pool: [65536] u8; s_init(s[..], pool[..]);
  s_user(s[..], "Fix the \"sidebar\" width\nplease");
  s_delta(s[..], P_THINK, "Looking at desk.coax");
  sl_test_tool(s[..], "t1", TK_EDIT, "/w/desk.coax", "", "220", "240", "{\"file_path\":\"/w/desk.coax\"}", "ok", false);
  sl_test_tool(s[..], "t2", TK_EXEC, "ls\n -la", "ls -la", "", "", "{\"command\":\"ls\\n -la\"}", "denied", true);
  sl_test_tool(s[..], "t3", TK_MCP, "{\"title\":\"x\"}", "github · create_issue", "", "", "{\"title\":\"x\"}", "", false);
  s[0].parts[s[0].n - 1].name = s_put(s[..], "mcp__github__create_issue");
  r0 := s_part(s[..], P_ROUTE);
  s_append(s[..], r0, "Routed to Claude Code · Sonnet 5.5 · Medium · 1.9 s");
  s[0].parts[r0].tk = TK_ROUTE; s[0].parts[r0].id = s_put(s[..], "lab-route"); s[0].parts[r0].detail = s_put(s[..], "elephant-1 · 1900 ms");
  s[0].parts[r0].output = s_put(s[..], "harness  claude_code 0.9"); s[0].parts[r0].resolved = true;
  s_delta(s[..], P_TEXT, "Done: the sidebar is 240 px. ✓");
  s_notice(s[..], N_LIMIT, "Limit reached");
  s[0].cost = 0.031; s[0].turn_ms = 12500;
  s_turn_end(s[..], false, "");
  first := s[0].n;
  s_user(s[..], "again");
  s[0].stopping = true;
  s_turn_end(s[..], false, "");
  out: [65536] u8;
  h := sl_header(out[..], "20261110-120000-001", "claude", "/w", 1794000000000000);
  n1 := sl_lines(s[..], 0, first, true, out[h..<out.count]);
  n2 := sl_lines(s[..], first, s[0].n, true, out[h + n1..<out.count]);
  #assert h > 0 && n1 > 0 && n2 > 0;
  file := cast(string) out[0..<h + n1 + n2];
  r: [1] Session; rpool: [65536] u8; s_init(r[..], rpool[..]);
  sl_load(r[..], file);
  #assert sl_test_same(s[..], r[..]);
  #assert r[0].turns == 2 && r[0].turn_ms == 12500 && r[0].cost > 0.0309 && r[0].cost < 0.0311 && r[0].changed;
  // Coder's readers find their keys: the header, the label, the result's text, the ending and the steps
  #assert s_has(file, "{\"kind\":\"session\",\"schema\":\"openagents.session.v1\",\"id\":\"20261110-120000-001\",\"engine\":\"claude\",\"cwd\":\"/w\",\"started_us\":1794000000000000}\n");
  #assert s_has(file, "{\"kind\":\"tool\",\"label\":\"edit(/w/desk.coax)\",\"tool\":\"edit\",\"id\":\"t1\"");
  #assert s_has(file, "\"label\":\"bash(ls -la)\"") && s_has(file, "\"label\":\"github · create_issue\"");
  #assert s_has(file, "{\"kind\":\"result\",\"text\":\"denied\",\"error\":true,\"id\":\"t2\"}\n");
  #assert s_has(file, "\"tool\":\"mcp\",\"name\":\"mcp__github__create_issue\",\"id\":\"t3\"") && r[0].parts[4].name == "mcp__github__create_issue";
  #assert s_has(file, "{\"kind\":\"end\",\"ending\":\"failed\",\"ms\":12500,\"steps\":3,\"cost_usd_e6\":31000}\n");
  #assert s_has(file, "{\"kind\":\"notice\",\"notice\":\"stopped\",\"text\":\"\"}\n{\"kind\":\"end\",\"ending\":\"stopped\"");
}

#test "a long result keeps Coder's 4000-byte text and its size, and comes back whole; a call still running stays open" {
  s: [1] Session; pool: [32768] u8; s_init(s[..], pool[..]);
  s_user(s[..], "cat it");
  big: [5000] u8; for i: 0..<5000 { big[i] = cast(u8) ('a' + i % 26); }
  sl_test_tool(s[..], "t1", TK_EXEC, "cat big", "cat big", "", "", "", cast(string) big[..], false);
  k := s_part(s[..], P_TOOL);
  s[0].parts[k].tk = TK_READ; s[0].parts[k].id = s_put(s[..], "t2"); s[0].parts[k].arg = s_put(s[..], "/w/a.txt");
  out: [32768] u8;
  n := sl_lines(s[..], 0, s[0].n, false, out[..]);
  file := cast(string) out[0..<n];
  #assert n > 9000 && s_has(file, ",\"error\":false,\"bytes\":5000,\"output\":\"") && !s_has(file, "\"kind\":\"end\"");
  r: [1] Session; rpool: [32768] u8; s_init(r[..], rpool[..]);
  sl_load(r[..], file);
  #assert sl_test_same(s[..], r[..]) && r[0].parts[1].output.count == 5000 && !r[0].parts[2].resolved;
  // too small a buffer writes nothing
  small: [64] u8;
  #assert sl_lines(s[..], 0, s[0].n, true, small[..]) == 0 && sl_header(small[0..<8], "x", "claude", "/w", 0) == 0;
}

#test "a log Coder wrote reads into the record: labels become calls, an edit's diff line its old and new, the ending its notice" {
  text := "{\"kind\":\"session\",\"id\":\"20261102-153012-417\",\"version\":\"0.1\",\"engine\":\"claude\",\"cwd\":\"/w\",\"started_us\":5}\n{\"kind\":\"user\",\"text\":\"fix it\"}\n{\"kind\":\"request\",\"sha256\":\"ab\",\"bytes\":6}\n{\"kind\":\"reply\",\"text\":\"Looking.\"}\n{\"kind\":\"tool\",\"label\":\"Bash(ls -la)\"}\n{\"kind\":\"result\",\"text\":\"notes.txt\",\"error\":false}\n{\"kind\":\"tool\",\"label\":\"Edit(/w/notes.txt)\"}\n{\"kind\":\"result\",\"text\":\"updated\",\"error\":false}\n{\"kind\":\"diff\",\"path\":\"/w/notes.txt\",\"adds\":1,\"dels\":1,\"old\":\"bred\",\"new\":\"bread\"}\n{\"kind\":\"tool\",\"label\":\"mcp__coder__status\"}\n{\"kind\":\"result\",\"text\":\"no\",\"error\":true}\n{\"kind\":\"reply\",\"text\":\"Fixed.\"}\n{\"kind\":\"end\",\"ending\":\"finished\",\"ms\":900,\"steps\":3,\"text\":\"Fixed.\"}\n{\"kind\":\"user\",\"text\":\"again\"}\n{\"kind\":\"end\",\"ending\":\"failed\",\"ms\":5,\"steps\":0,\"text\":\"login needed\",\"cause\":\"provider\"}\n{\"kind\":\"user\",\"text\":\"once more\"}\n{\"kind\":\"end\",\"ending\":\"stopped\",\"ms\":5,\"steps\":0}\n";
  s: [1] Session; pool: [8192] u8; s_init(s[..], pool[..]);
  sl_load(s[..], text);
  #assert s[0].n == 10 && s[0].turns == 3 && s[0].turn_ms == 5;
  #assert s[0].parts[0].kind == P_USER && s[0].parts[1].kind == P_TEXT && s_text_of(s[..], 1) == "Looking.";
  #assert s[0].parts[2].kind == P_TOOL && s[0].parts[2].tk == TK_EXEC && s[0].parts[2].arg == "ls -la" && s[0].parts[2].output == "notes.txt" && s[0].parts[2].resolved;
  #assert s[0].parts[3].tk == TK_EDIT && s[0].parts[3].arg == "/w/notes.txt" && s[0].parts[3].before == "bred" && s[0].parts[3].after == "bread" && s[0].parts[3].output == "updated";
  #assert s[0].parts[4].tk == TK_TOOL && s[0].parts[4].detail == "mcp__coder__status" && s[0].parts[4].failed;
  #assert s[0].parts[5].kind == P_TEXT && s[0].parts[6].kind == P_USER;
  #assert s[0].parts[7].kind == P_NOTICE && s[0].parts[7].notice == N_ERROR && s_text_of(s[..], 7) == "login needed";
  #assert s[0].parts[8].kind == P_USER && s[0].parts[9].kind == P_NOTICE && s[0].parts[9].notice == N_STOPPED;
}

#test "the desktop app's first format still reads, alone or with new lines after it" {
  old := "{\"k\":\"user\",\"t\":\"hi\"}\n{\"k\":\"think\",\"t\":\"hm\"}\n{\"k\":\"tool\",\"tk\":3,\"id\":\"t1\",\"arg\":\"/w/a\",\"before\":\"1\",\"after\":\"2\",\"input\":\"{}\",\"output\":\"ok\",\"resolved\":true}\n{\"k\":\"text\",\"t\":\"Done.\"}\n{\"k\":\"notice\",\"t\":\"\",\"notice\":4}\n{\"k\":\"end\",\"ms\":70,\"cost\":2500e-6}\n";
  s: [1] Session; pool: [4096] u8; s_init(s[..], pool[..]);
  sl_load(s[..], old);
  #assert s[0].n == 5 && s[0].turns == 1 && s[0].turn_ms == 70 && s[0].cost > 0.00249 && s[0].cost < 0.00251;
  #assert s[0].parts[2].tk == TK_EDIT && s[0].parts[2].before == "1" && s[0].parts[2].after == "2" && s[0].parts[2].resolved && s[0].parts[4].notice == N_STOPPED;
  out: [4096] u8;
  n := sl_lines(s[..], 0, s[0].n, true, out[..]);
  r: [1] Session; rpool: [4096] u8; s_init(r[..], rpool[..]);
  both: [8192] u8; m := 0;
  for c: old { both[m] = c; m += 1; }
  for i: 0..<n { both[m] = out[i]; m += 1; }
  sl_load(r[..], cast(string) both[0..<m]);
  #assert r[0].n == 10 && r[0].turns == 2 && r[0].parts[7].tk == TK_EDIT && r[0].parts[7].output == "ok" && r[0].parts[9].notice == N_STOPPED;
}

#test "what is not a part is skipped, and a full record stops the read without a fault" {
  s: [1] Session; pool: [256] u8; s_init(s[..], pool[..]);
  sl_load(s[..], "\n{}\nnot json\n{\"kind\":\"memory\",\"text\":\"x\"}\n{\"kind\":\"result\",\"text\":\"orphan\",\"error\":false}\n{\"kind\":\"model\",\"model\":\"m\"}\n{\"kind\":\"user\",\"text\":\"one\"}\n");
  #assert s[0].n == 1 && s_text_of(s[..], 0) == "one";
  s[0].n = S_PARTS;
  sl_load(s[..], "{\"kind\":\"user\",\"text\":\"two\"}\n{\"kind\":\"user\",\"text\":\"three\"}\n");
  #assert s[0].n == S_PARTS && s[0].turns == 1;
  #assert sl_ending(s[..], 0, 0) == "finished";
}

#test "the reader names each line's kind, counts every line, reads a line's fields and writes it again the same" {
  text := "{\"kind\":\"session\",\"schema\":\"openagents.session.v1\",\"id\":\"x\",\"version\":\"0.1\",\"engine\":\"claude\",\"cwd\":\"/w\",\"started_us\":5}\n\n{\"kind\":\"user\",\"text\":\"fix \\\"it\\\"\"}\n{\"seq\":1,\"kind\":\"attempt\",\"text\":\"t\"}\nnot json\n{\"k\":\"user\",\"t\":\"old\"}\n{\"kind\":\"end\",\"ending\":\"failed\",\"ms\":9,\"steps\":2,\"text\":\"why\",\"cause\":\"provider\"}\n{\"kind\":\"user\",\"text\":\"partial";
  r: [1] SlReader; r[0] = SlReader.{text = text}; l: [1] SlLine;
  ab: [4096] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  #assert sl_next(r[..], l[..]) && l[0].kind == SK_SESSION && l[0].no == 1 && l[0].whole;
  sl_read(ar[..], l[..]);
  #assert l[0].header.id == "x" && l[0].header.engine == "claude" && l[0].header.started_us == 5 && l[0].header.always;
  out: [4096] u8; n := sl_rewrite(l[..], out[..]);
  #assert n > 0 && cast(string) out[0..<n] == l[0].line;
  #assert sl_next(r[..], l[..]) && l[0].kind == SK_USER && l[0].no == 3;
  sl_read(ar[..], l[..]);
  #assert l[0].text == "fix \"it\"";
  n = sl_rewrite(l[..], out[..]);
  #assert cast(string) out[0..<n] == l[0].line;
  #assert sl_next(r[..], l[..]) && l[0].kind == SK_OTHER && l[0].name == "attempt" && l[0].no == 4;
  sl_read(ar[..], l[..]);
  #assert l[0].text == "t" && sl_rewrite(l[..], out[..]) == -1;
  #assert sl_next(r[..], l[..]) && l[0].kind == SK_OTHER && l[0].name == "";
  #assert sl_next(r[..], l[..]) && !l[0].first && l[0].kind == SK_OTHER;   // the first format: only for a reader that asks
  fr: [1] SlReader; fr[0] = SlReader.{text = l[0].line, first = true}; fl: [1] SlLine;
  #assert sl_next(fr[..], fl[..]) && fl[0].first && fl[0].kind == SK_USER;
  sl_read(ar[..], fl[..]);
  #assert fl[0].text == "old";
  #assert sl_next(r[..], l[..]) && l[0].kind == SK_END;
  sl_read(ar[..], l[..]);
  #assert l[0].ending == "failed" && l[0].ms == 9 && l[0].timed && l[0].steps == 2 && l[0].text == "why" && l[0].cause == "provider" && l[0].cost_e6 == -1;
  n = sl_rewrite(l[..], out[..]);
  #assert cast(string) out[0..<n] == l[0].line;
  // a last line still being written: its kind from its first bytes, then no fields
  #assert sl_next(r[..], l[..]) && l[0].kind == SK_USER && !l[0].whole && l[0].no == 8;
  sl_read(ar[..], l[..]);
  #assert l[0].kind == SK_OTHER && !sl_next(r[..], l[..]);
  // the memory scan: the last whole line a person typed, by number
  #assert sl_last_user(text) == 3 && sl_last_user("{\"kind\":\"end\"}\n") == 0;
  h := sl_first_header(text, ar[..]);
  #assert h.id == "x" && h.cwd == "/w" && sl_first_header("{\"kind\":\"user\",\"text\":\"a\"}\n", ar[..]).id == "";
}
