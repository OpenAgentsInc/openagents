// Single JSON codec for openagents.tester.v1alpha1 (tester.observation.v1, tester.action.v1,
// tester.result.v1; docs/apps/2026-11-20-simulated-tester-spec.md §6, GitHub #13891).
#load "../registry/wire.coax";

TS_BUF :: 16384;

TsObservation :: struct {
  client_id: string;
  target: string;
  mode: string;
  seq: int;
  ts_ms: int;
  width: int;
  height: int;
  scale_x100: int;
  screenshot_ref: string;
  running: bool;
  settings_page: int;
  composer_focused: bool;
  composer_text: string;
  window_title: string;
  summary: string;
}

TsAction :: struct {
  action_id: string;
  source_seq: int;
  op: string;
  target: string;
  text: string;
  x: int;
  y: int;
  lease_ms: int;
  ts_ms: int;
  ok: bool;
  detail: string;
}

TsResult :: struct {
  scenario_id: string;
  client_id: string;
  target: string;
  mode: string;
  verdict: string;
  duration_ms: int;
  steps_run: int;
  first_failure: string;
  summary: string;
  screenshot_ref: string;
  cleanup: string;
}

ts_verdict_valid :: (v: string) -> bool {
  return v == "pass" || v == "product-fail" || v == "infrastructure-fail"
    || v == "blocked" || v == "inconclusive" || v == "not-applicable" || v == "unqualified";
}

ts_write_obs :: (o: TsObservation, out: [] u8) -> int {
  j: [1] Jo;
  jo_start(j[..], out);
  jo_obj(j[..]);
  jo_key(j[..], "schema"); jo_str(j[..], "tester.observation.v1");
  jo_key(j[..], "client_id"); jo_str(j[..], o.client_id);
  jo_key(j[..], "target"); jo_str(j[..], o.target);
  jo_key(j[..], "mode"); jo_str(j[..], o.mode);
  jo_key(j[..], "seq"); jo_int(j[..], o.seq);
  jo_key(j[..], "ts_ms"); jo_int(j[..], o.ts_ms);
  jo_key(j[..], "width"); jo_int(j[..], o.width);
  jo_key(j[..], "height"); jo_int(j[..], o.height);
  jo_key(j[..], "scale_x100"); jo_int(j[..], o.scale_x100);
  jo_key(j[..], "screenshot_ref"); jo_str(j[..], o.screenshot_ref);
  jo_key(j[..], "running"); jo_bool(j[..], o.running);
  jo_key(j[..], "settings_page"); jo_int(j[..], o.settings_page);
  jo_key(j[..], "composer_focused"); jo_bool(j[..], o.composer_focused);
  jo_key(j[..], "composer_text"); jo_str(j[..], o.composer_text);
  jo_key(j[..], "window_title"); jo_str(j[..], o.window_title);
  jo_key(j[..], "summary"); jo_str(j[..], o.summary);
  jo_end(j[..]);
  return ifx j[0].bad then -1 else j[0].n;
}

ts_write_action :: (a: TsAction, out: [] u8) -> int {
  if !ar_lease_ok(a.lease_ms) { return -1; }
  j: [1] Jo;
  jo_start(j[..], out);
  jo_obj(j[..]);
  jo_key(j[..], "schema"); jo_str(j[..], "tester.action.v1");
  jo_key(j[..], "action_id"); jo_str(j[..], a.action_id);
  jo_key(j[..], "source_seq"); jo_int(j[..], a.source_seq);
  jo_key(j[..], "op"); jo_str(j[..], a.op);
  jo_key(j[..], "target"); jo_str(j[..], a.target);
  jo_key(j[..], "text"); jo_str(j[..], a.text);
  jo_key(j[..], "x"); jo_int(j[..], a.x);
  jo_key(j[..], "y"); jo_int(j[..], a.y);
  jo_key(j[..], "lease_ms"); jo_int(j[..], a.lease_ms);
  jo_key(j[..], "ts_ms"); jo_int(j[..], a.ts_ms);
  jo_key(j[..], "ok"); jo_bool(j[..], a.ok);
  jo_key(j[..], "detail"); jo_str(j[..], a.detail);
  jo_end(j[..]);
  return ifx j[0].bad then -1 else j[0].n;
}

ts_write_result :: (r: TsResult, out: [] u8) -> int {
  if !ts_verdict_valid(r.verdict) { return -1; }
  j: [1] Jo;
  jo_start(j[..], out);
  jo_obj(j[..]);
  jo_key(j[..], "schema"); jo_str(j[..], "tester.result.v1");
  jo_key(j[..], "scenario_id"); jo_str(j[..], r.scenario_id);
  jo_key(j[..], "client_id"); jo_str(j[..], r.client_id);
  jo_key(j[..], "target"); jo_str(j[..], r.target);
  jo_key(j[..], "mode"); jo_str(j[..], r.mode);
  jo_key(j[..], "verdict"); jo_str(j[..], r.verdict);
  jo_key(j[..], "duration_ms"); jo_int(j[..], r.duration_ms);
  jo_key(j[..], "steps_run"); jo_int(j[..], r.steps_run);
  jo_key(j[..], "first_failure"); jo_str(j[..], r.first_failure);
  jo_key(j[..], "summary"); jo_str(j[..], r.summary);
  jo_key(j[..], "screenshot_ref"); jo_str(j[..], r.screenshot_ref);
  jo_key(j[..], "cleanup"); jo_str(j[..], r.cleanup);
  jo_end(j[..]);
  return ifx j[0].bad then -1 else j[0].n;
}

#test "tester schema encodes valid observation, action, and result JSON and refuses bad inputs" {
  buf: [TS_BUF] u8;
  tiny: [8] u8;
  sb: [256] u8;
  nodes: [128] JvNode;
  doc: [1] Jv;

  #assert ts_verdict_valid("pass") && ts_verdict_valid("product-fail") && ts_verdict_valid("infrastructure-fail");
  #assert ts_verdict_valid("blocked") && ts_verdict_valid("inconclusive") && ts_verdict_valid("not-applicable") && ts_verdict_valid("unqualified");
  #assert !ts_verdict_valid("") && !ts_verdict_valid("bogus");

  o := TsObservation.{
    client_id = "desk-1", target = "desktop-mac", mode = "local", seq = 1, ts_ms = 1234,
    width = 1280, height = 820, scale_x100 = 200, screenshot_ref = "screenshots/cold.png",
    running = false, settings_page = -1, composer_focused = true, composer_text = "hi",
    window_title = "Coder", summary = "ready"
  };
  #assert ts_write_obs(o, tiny[..]) == -1;
  no := ts_write_obs(o, buf[..]);
  #assert no > 0;
  #assert jv_parse(doc[..], cast(string) buf[0..<no], nodes[..]);
  son := jv_str(doc[0], jv_get(doc[0], 0, "schema"), sb[..]);
  #assert son > 0 && cast(string) sb[0..<son] == "tester.observation.v1";

  a := TsAction.{
    action_id = "act-1", source_seq = 1, op = "type", target = "composer",
    text = "hello", x = 0, y = 0, lease_ms = 250, ts_ms = 1250, ok = true, detail = ""
  };
  #assert ts_write_action(a, tiny[..]) == -1;
  na := ts_write_action(a, buf[..]);
  #assert na > 0;
  #assert jv_parse(doc[..], cast(string) buf[0..<na], nodes[..]);
  san := jv_str(doc[0], jv_get(doc[0], 0, "schema"), sb[..]);
  #assert san > 0 && cast(string) sb[0..<san] == "tester.action.v1";
  bad_a := a; bad_a.lease_ms = 1001;
  #assert ts_write_action(bad_a, buf[..]) == -1;

  r := TsResult.{
    scenario_id = "desktop.launch.cold", client_id = "desk-1", target = "desktop-mac",
    mode = "local", verdict = "pass", duration_ms = 420, steps_run = 3,
    first_failure = "", summary = "window opened and composer focused",
    screenshot_ref = "screenshots/cold.png", cleanup = "ok"
  };
  #assert ts_write_result(r, tiny[..]) == -1;
  nr := ts_write_result(r, buf[..]);
  #assert nr > 0;
  #assert jv_parse(doc[..], cast(string) buf[0..<nr], nodes[..]);
  svn := jv_str(doc[0], jv_get(doc[0], 0, "verdict"), sb[..]);
  #assert svn > 0 && cast(string) sb[0..<svn] == "pass";
  bad_r := r; bad_r.verdict = "bogus";
  #assert ts_write_result(bad_r, buf[..]) == -1;
}
