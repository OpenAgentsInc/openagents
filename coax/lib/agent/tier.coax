// tier.coax: which model works an issue. Golemancy's thresholds.
//
// A model reads the issue and fills a typed rubric: four scores, 0 to 3, each
// with a written anchor, and whether the issue is something an agent should
// work at all. The scores are its judgment; the thresholds below are ours and
// fixed. tier_of turns the scores into a tier, and tier_model names the model:
//
//   Haiku   housekeeping: a stated, mechanical change in one place
//   Sonnet  ordinary work: a clear bug or feature in one app or unit
//   Opus    advanced work: shared engine code, design choices, or real risk
//   Fable   the hardest: compiler, GPU and engine internals with open design,
//           or broad work that is deep, open and risky at once
//
// The words of an issue are never matched against keywords here (the
// workspace's semantic routing rule): the model's typed scores are the input.
// Shared by every app that hands an issue to a coding agent: the Everglade desktop app's
// Autopilot (apps/everglade-desktop/next.coax) and the batch report (apps/everglade-desktop/tiers.coax).
// It has no game or app dependencies, so Coder, Foreman or any tool can load it.
//
// The tiers can name either of two families of models (GitHub #13193), by a setting the app reads
// (EVERGLADE_TIER_FAMILY): Claude's, the default, run by Claude Code; or Gemini's, run by the
// Antigravity CLI (agy): Gemini 4 Hydrogen for housekeeping and ordinary work, Gemini 4 Argon (the
// one agy's own `pro` subagent runs) for advanced work and Gemini 4 Carbon, the newest, for the
// hardest. The family changes only the names: the scores and the thresholds are the same.

TIER_NONE :: 0; TIER_HAIKU :: 1; TIER_SONNET :: 2; TIER_OPUS :: 3; TIER_FABLE :: 4;

// The thresholds, on the sum of the four scores (0 to 12).
TIER_SONNET_AT :: 3;   // a sum of 3 or more is past housekeeping
TIER_OPUS_AT :: 6;
TIER_FABLE_AT :: 9;
TIER_HAIKU_RISK :: 1;  // Haiku only when the risk is 1 or less, whatever the sum

TIER_HAIKU_MODEL :: "claude-haiku-5-5";
TIER_SONNET_MODEL :: "claude-sonnet-5-5";
TIER_OPUS_MODEL :: "claude-opus-5-5";
TIER_FABLE_MODEL :: "claude-fable-5-2";

// The families: which models the tiers name, and the engine that runs them.
TIER_CLAUDE :: 0; TIER_GEMINI :: 1;
// Hydrogen's level is the tiers' choice: low for housekeeping, high for ordinary work, the only
// difference between them. Argon and Carbon are named without a level, so agy runs them at the
// Antigravity engine's default, low (antigravity.coax, AGY_EFFORT): at medium and high their long
// thinking made the task-fit runs minutes slower (docs/research/2026-11-11-antigravity-task-fit.md).
TIER_GEMINI_MODELS :: [4] string.["gemini-4-hydrogen-low", "gemini-4-hydrogen-high", "gemini-4-argon", "gemini-4-carbon"];

TierScores :: struct { scope: int; ambiguity: int; risk: int; depth: int; delegable: bool; }

tier_clamp :: (v: int) -> int { return ifx v < 0 then 0 else ifx v > 3 then 3 else v; }

// The rule, in order:
//   not delegable                           -> none (a tracker, a parked or owner-only issue)
//   depth 3 and ambiguity 2 or more         -> Fable
//   sum 9 or more                           -> Fable
//   sum 6 or more, risk 3, or depth 3       -> Opus
//   sum 3 or more, or risk 2 or more        -> Sonnet
//   otherwise                               -> Haiku
tier_of :: (t: TierScores) -> int {
  if !t.delegable { return TIER_NONE; }
  scope := tier_clamp(t.scope); ambiguity := tier_clamp(t.ambiguity); risk := tier_clamp(t.risk); depth := tier_clamp(t.depth);
  sum := scope + ambiguity + risk + depth;
  if depth == 3 && ambiguity >= 2 { return TIER_FABLE; }
  if sum >= TIER_FABLE_AT { return TIER_FABLE; }
  if sum >= TIER_OPUS_AT || risk == 3 || depth == 3 { return TIER_OPUS; }
  if sum >= TIER_SONNET_AT || risk > TIER_HAIKU_RISK { return TIER_SONNET; }
  return TIER_HAIKU;
}

tier_model :: (tier: int) -> string { return tier_model_in(tier, TIER_CLAUDE); }

// The model a tier names in a family ("" for none, or a family that is not one).
tier_model_in :: (tier: int, family: int) -> string {
  if family == TIER_GEMINI {
    if tier < TIER_HAIKU || tier > TIER_FABLE { return ""; }
    models := TIER_GEMINI_MODELS;
    return models[tier - TIER_HAIKU];
  }
  if family != TIER_CLAUDE { return ""; }
  if tier == TIER_HAIKU { return TIER_HAIKU_MODEL; }
  if tier == TIER_SONNET { return TIER_SONNET_MODEL; }
  if tier == TIER_OPUS { return TIER_OPUS_MODEL; }
  if tier == TIER_FABLE { return TIER_FABLE_MODEL; }
  return "";
}

// A family by its setting's word: "" and "claude" are Claude's, "gemini" Gemini's; anything else -1.
tier_family :: (name: string) -> int {
  if name.count == 0 || name == "claude" { return TIER_CLAUDE; }
  if name == "gemini" { return TIER_GEMINI; }
  return -1;
}
// The engine that runs a family's models, as the app's EVERGLADE_CODER_ENGINE names it.
tier_engine :: (family: int) -> string { return ifx family == TIER_GEMINI then "antigravity" else ifx family == TIER_CLAUDE then "claude" else ""; }
// The family an engine runs: Antigravity's is Gemini, Claude Code's (and "") Claude; anything else -1.
tier_family_of_engine :: (engine: string) -> int {
  if engine.count == 0 || engine == "claude" { return TIER_CLAUDE; }
  if engine == "antigravity" || engine == "agy" { return TIER_GEMINI; }
  return -1;
}

tier_name :: (tier: int) -> string {
  if tier == TIER_HAIKU { return "Haiku"; }
  if tier == TIER_SONNET { return "Sonnet"; }
  if tier == TIER_OPUS { return "Opus"; }
  if tier == TIER_FABLE { return "Fable"; }
  return "none";
}

// The rubric the model is given. Each score has an anchor for every value, so two
// readings of one issue land on the same number.
TIER_RUBRIC :: "Rate the issue on four scores, 0 to 3, using these anchors.\nscope: 0 one file, a few lines; 1 a few files in one unit; 2 several units, or a new module; 3 many units or every host.\nambiguity: 0 the issue states the exact change; 1 a clear goal with small choices; 2 needs design choices nobody has made; 3 open-ended, needs research or a spec first.\nrisk: 0 docs, copy, tests or numbers in a table; 1 one app's feature, easy to revert; 2 shared engine, library or build code that other work depends on; 3 production deploys, money, auth or secrets, the release pipeline, or data loss.\ndepth: 0 mechanical (rename, config, a budget, a label); 1 ordinary app or UI code; 2 engine systems (rendering, networking, physics, game rules, build caching); 3 the compiler, GPU shaders or kernels, concurrency, or verification.\ndelegable: false when an agent should not work it now: a tracking issue whose work is in other issues, an issue that says it is parked or waiting on the owner, or one that needs a person on a device. Otherwise true.";

// The scores as JSON-schema properties, shared by the picker's `choose` and the batch's `rate`.
TIER_PROPERTIES :: "\"scope\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":3},\"ambiguity\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":3},\"risk\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":3},\"depth\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":3},\"delegable\":{\"type\":\"boolean\"}";
TIER_REQUIRED :: "\"scope\",\"ambiguity\",\"risk\",\"depth\",\"delegable\"";

#test "tiers: housekeeping goes to Haiku, ordinary work to Sonnet" {
  #assert tier_of(TierScores.{scope = 0, ambiguity = 0, risk = 0, depth = 0, delegable = true}) == TIER_HAIKU;
  #assert tier_of(TierScores.{scope = 1, ambiguity = 0, risk = 1, depth = 0, delegable = true}) == TIER_HAIKU;
  #assert tier_of(TierScores.{scope = 1, ambiguity = 1, risk = 0, depth = 1, delegable = true}) == TIER_SONNET;
  // A small change to shared code is past housekeeping, however small.
  #assert tier_of(TierScores.{scope = 0, ambiguity = 0, risk = 2, depth = 0, delegable = true}) == TIER_SONNET;
}
#test "tiers: risk 3 or depth 3 is at least Opus; deep and open is Fable" {
  #assert tier_of(TierScores.{scope = 0, ambiguity = 0, risk = 3, depth = 0, delegable = true}) == TIER_OPUS;
  #assert tier_of(TierScores.{scope = 0, ambiguity = 0, risk = 0, depth = 3, delegable = true}) == TIER_OPUS;
  #assert tier_of(TierScores.{scope = 2, ambiguity = 1, risk = 2, depth = 1, delegable = true}) == TIER_OPUS;
  #assert tier_of(TierScores.{scope = 1, ambiguity = 2, risk = 1, depth = 3, delegable = true}) == TIER_FABLE;
  #assert tier_of(TierScores.{scope = 3, ambiguity = 2, risk = 2, depth = 2, delegable = true}) == TIER_FABLE;
}
#test "tiers: a tracker or parked issue goes to no one; scores out of range are clamped" {
  #assert tier_of(TierScores.{scope = 3, ambiguity = 3, risk = 3, depth = 3, delegable = false}) == TIER_NONE;
  #assert tier_model(TIER_NONE) == "" && tier_name(TIER_NONE) == "none";
  #assert tier_of(TierScores.{scope = -4, ambiguity = 0, risk = 0, depth = 0, delegable = true}) == TIER_HAIKU;
  #assert tier_of(TierScores.{scope = 9, ambiguity = 9, risk = 9, depth = 9, delegable = true}) == TIER_FABLE;
}
#test "tiers: every tier names a model, in order of capability" {
  #assert tier_model(TIER_HAIKU) == "claude-haiku-5-5" && tier_model(TIER_SONNET) == "claude-sonnet-5-5";
  #assert tier_model(TIER_OPUS) == "claude-opus-5-5" && tier_model(TIER_FABLE) == "claude-fable-5-2";
  #assert TIER_SONNET_AT < TIER_OPUS_AT && TIER_OPUS_AT < TIER_FABLE_AT && TIER_FABLE_AT <= 12;
}
#test "tiers: the Gemini family names Hydrogen, Argon and Carbon for the same tiers, Claude's stays the default" {
  #assert tier_model_in(TIER_HAIKU, TIER_GEMINI) == "gemini-4-hydrogen-low" && tier_model_in(TIER_SONNET, TIER_GEMINI) == "gemini-4-hydrogen-high";
  #assert tier_model_in(TIER_OPUS, TIER_GEMINI) == "gemini-4-argon" && tier_model_in(TIER_FABLE, TIER_GEMINI) == "gemini-4-carbon";
  #assert tier_model_in(TIER_NONE, TIER_GEMINI) == "" && tier_model_in(5, TIER_GEMINI) == "" && tier_model_in(-1, TIER_GEMINI) == "";
  for t: [5] int.[TIER_NONE, TIER_HAIKU, TIER_SONNET, TIER_OPUS, TIER_FABLE] { #assert tier_model_in(t, TIER_CLAUDE) == tier_model(t); }
  #assert tier_model_in(TIER_OPUS, 2) == "" && tier_model_in(TIER_HAIKU, -1) == "";
  // The family changes only the name: the same scores give the same tier.
  s := TierScores.{scope = 2, ambiguity = 1, risk = 2, depth = 1, delegable = true};
  #assert tier_of(s) == TIER_OPUS && tier_model_in(tier_of(s), TIER_GEMINI) == "gemini-4-argon";
}
#test "tiers: a family by its word, its engine, and an engine's family" {
  #assert tier_family("") == TIER_CLAUDE && tier_family("claude") == TIER_CLAUDE && tier_family("gemini") == TIER_GEMINI;
  #assert tier_family("Gemini") == -1 && tier_family("antigravity") == -1 && tier_family("gemini ") == -1;
  #assert tier_engine(TIER_CLAUDE) == "claude" && tier_engine(TIER_GEMINI) == "antigravity" && tier_engine(-1) == "" && tier_engine(2) == "";
  #assert tier_family_of_engine("") == TIER_CLAUDE && tier_family_of_engine("claude") == TIER_CLAUDE;
  #assert tier_family_of_engine("antigravity") == TIER_GEMINI && tier_family_of_engine("agy") == TIER_GEMINI;
  #assert tier_family_of_engine("codex") == -1 && tier_family_of_engine("Claude") == -1;
}
#test "tiers: a score is clamped to 0..3, and every tier has its name" {
  #assert tier_clamp(-1) == 0 && tier_clamp(0) == 0 && tier_clamp(1) == 1 && tier_clamp(2) == 2 && tier_clamp(3) == 3 && tier_clamp(4) == 3;
  #assert tier_name(1) == "Haiku" && tier_name(2) == "Sonnet" && tier_name(3) == "Opus" && tier_name(4) == "Fable" && tier_name(5) == "none";
  #assert TIER_HAIKU == 1 && TIER_SONNET == 2 && TIER_OPUS == 3 && TIER_FABLE == 4;
}
