// The run store on disk: one folder per run under the session's folder,
// which outlives the process and opens again (GitHub #13444 part 1).
//
//   DIR/log.jsonl     the store's lines (store.coax), appended one by one
//   DIR/text/H        each text the store names by hash, once: a file's
//                     content at one version, or a command's whole output
//
// DIR is the caller's; for a Coder session it is
// ~/.openagents/coder/sessions/ID.workmem (wmf_dir). Opening a folder that
// has a log applies it, so the store is where the last process left it; a
// last line a crash cut short is cut off first.
//
// The loop that owns the workspace already holds the text it read, wrote or
// ran, and gives it here; this file hashes it, keeps it once and writes the
// line. Nothing here reads the workspace except wmf_refresh, which looks at
// every file the store knows after something outside the store (a shell
// command, a person) may have changed them.
//
// Checked by `coax/web/tool.sh coax/lib/agent/workmem/workmem.coax selftest`
// (foreign effects do not run under `coax test`).
#load "view.coax";
#load "../../sys/fs.coax";
#load "../../sys/openagents-paths.coax";

WMF_TEXT :: 4194304;          // bytes of one file's content or one command's output kept (RC_FILE_MOST)

Wmf :: struct {
  s: [1] WmStore;
  dir: string; dir_buf: [FS_PATH_MAX] u8;
  line: [WM_LINE] u8;
  text: [WMF_TEXT + WM_LINE] u8;      // a text read back, or the log while it loads
  failed: bool;                       // a line was applied and could not be appended: the folder is behind the store
}

// ~/.openagents/coder/sessions/ID.workmem
wmf_dir :: (home: string, session: string, out: [] u8) -> string {
  leaf: [512] u8; n := json_raw(leaf[..], json_raw(leaf[..], json_raw(leaf[..], 0, "coder/sessions/"), session), ".workmem");
  if n < 0 || session.count == 0 { return ""; }
  return oa_path(home, cast(string) leaf[0..<n], out);
}

wmf_log_path :: (w: [] Wmf, out: [] u8) -> string { return fs_join(w[0].dir, "log.jsonl", out); }
wmf_text_path :: (w: [] Wmf, h: [32] u8, out: [] u8) -> string {
  hb: [64] u8; leaf: [69] u8;
  n := json_raw(leaf[..], json_raw(leaf[..], 0, "text/"), wm_hex(h, hb[..]));
  return fs_join(w[0].dir, cast(string) leaf[0..<n], out);
}

// Applies the folder's log to an empty store. lines: the lines applied, or
// -1 when there is no log. whole: the bytes of the log that are whole lines.
// bad: the number (from 1) of a line the store refused, which stops the load.
WmfLoad :: struct { lines: int; whole: int; bad: int; }
wmf_load :: (w: [] Wmf, dir: string) -> WmfLoad {
  w[0].s[0] = WmStore.{}; w[0].failed = false;
  n := ifx dir.count < FS_PATH_MAX then dir.count else 0;
  for i: 0..<n { w[0].dir_buf[i] = dir[i]; }
  w[0].dir = cast(string) w[0].dir_buf[0..<n];
  pb: [FS_PATH_MAX] u8; path := wmf_log_path(w, pb[..]);
  r := WmfLoad.{lines = -1};
  if n == 0 || fs_kind(path) != FS_FILE { return r; }
  r.lines = 0;
  have := 0; offset := 0;
  while true {
    got := fs_read_at(path, offset, w[0].text[have..<w[0].text.count]);
    if got <= 0 { break; }
    offset += got; have += got;
    whole := wm_whole(cast(string) w[0].text[0..<have]);
    k := wm_load(w[0].s[..], cast(string) w[0].text[0..<whole]);
    if k < 0 { r.bad = r.lines - k; return r; }
    r.lines += k; r.whole += whole;
    for i: whole..<have { w[0].text[i - whole] = w[0].text[i]; }
    have -= whole;
    if have > WM_LINE { r.bad = r.lines + 1; return r; }       // a line longer than any this log writes
  }
  return r;
}

// Opens the run's folder, making it when it is new (the header names the run
// and the workspace's folder). False when the folder can't be made or its log
// is not this store's.
wmf_open :: (w: [] Wmf, dir: string, run: string, root: string) -> bool {
  l := wmf_load(w, dir);
  pb: [FS_PATH_MAX] u8;
  if w[0].dir.count == 0 || l.bad != 0 || !fs_mkdir(fs_join(w[0].dir, "text", pb[..])) { return false; }
  path := wmf_log_path(w, pb[..]);
  if l.lines >= 0 && l.whole < fs_size(path) && !fs_truncate(path, l.whole) { return false; }
  if l.lines > 0 { return true; }
  return wmf_keep(w, wm_put_header(w[0].s[..], run, root, w[0].line[..])).ok;
}

// Appends a line the store just applied.
wmf_keep :: (w: [] Wmf, p: WmPut) -> WmPut {
  if !p.ok { return p; }
  pb: [FS_PATH_MAX] u8;
  if w[0].failed || !fs_append(wmf_log_path(w, pb[..]), p.line) { w[0].failed = true; return WmPut.{}; }
  return p;
}

// Keeps a text under its hash, once.
wmf_text_put :: (w: [] Wmf, text: string) -> [32] u8 {
  h := wm_hash(text); pb: [FS_PATH_MAX] u8; path := wmf_text_path(w, h, pb[..]);
  if fs_kind(path) != FS_FILE && !fs_write(path, text) { w[0].failed = true; }
  return h;
}
// The text with that hash into out: its length, or -1.
wmf_text_get :: (w: [] Wmf, h: [32] u8, out: [] u8) -> int {
  pb: [FS_PATH_MAX] u8;
  return fs_read(wmf_text_path(w, h, pb[..]), out);
}

// The file's content as it is now. Writes a line only when it is new to the
// store; then the result says how many reads and findings went stale.
wmf_observe :: (w: [] Wmf, path: string, text: string) -> WmPut {
  s := w[0].s[..];
  f := wm_file(s, path); h := wm_hash(text);
  if f >= 0 && s[0].files[f].versions > 0 && wm_same(s[0].files[f].hash, h) && s[0].files[f].lines == wm_line_count(text) { return WmPut.{ok = true, id = f, file = f}; }
  _ = wmf_text_put(w, text);
  return wmf_keep(w, wm_put_file(s, path, h, text.count, wm_line_count(text), w[0].line[..]));
}

// Lines from..to of the file, whose whole content is text, went to the model
// (to past the end means to the end). known: the store already had every one
// of them at this content, so the loop could have shown them without a read.
wmf_read :: (w: [] Wmf, path: string, text: string, from: int, to: int) -> WmPut {
  o := wmf_observe(w, path, text);
  if !o.ok { return o; }
  lines := wm_line_count(text);
  last := ifx to > lines then lines else to;
  if last < from { last = from; }
  p := wmf_keep(w, wm_put_read(w[0].s[..], path, wm_hash(text), from, last, w[0].line[..]));
  p.file = o.file; p.stale_reads = o.stale_reads; p.stale_findings = o.stale_findings;
  return p;
}

// Lines from..to of the file as the store has it, without touching the
// workspace: for showing the model again what it has already read. "" when
// the store has not seen all of those lines at the file's current content.
wmf_recall :: (w: [] Wmf, path: string, from: int, to: int, out: [] u8) -> string {
  s := w[0].s[..]; f := wm_file(s, path);
  if !wm_seen_file(s, f, from, to) { return ""; }
  n := wmf_text_get(w, s[0].files[f].hash, w[0].text[..]);
  if n < 0 { return ""; }
  part := wm_lines_of(cast(string) w[0].text[0..<n], from, to);
  if part.count > out.count { return ""; }
  for c, i: part { out[i] = c; }
  return cast(string) out[0..<part.count];
}

// An edit: the file's content went from before to after. Both texts are
// kept, so the model can be shown exactly what it wrote; the row has the
// lines of the new content the edit wrote. The result says how many reads
// and findings about the old content went stale.
wmf_change :: (w: [] Wmf, path: string, before: string, after: string) -> WmPut {
  o := wmf_observe(w, path, before);
  if !o.ok { return o; }
  r := wm_changed_range(before, after);
  h := wmf_text_put(w, after);
  p := wmf_keep(w, wm_put_change(w[0].s[..], path, wm_hash(before), h, r.from, r.to, after.count, wm_line_count(after), w[0].line[..]));
  p.stale_reads += o.stale_reads; p.stale_findings += o.stale_findings;
  return p;
}

// A command ran and printed output (all of it: it is kept whole, whatever
// part the model is shown). check: the task's check it is a run of, or "".
wmf_run :: (w: [] Wmf, command: string, check: string, exit: int, timed_out: bool, ms: int, output: string) -> WmPut {
  h := wmf_text_put(w, output);
  return wmf_keep(w, wm_put_run(w[0].s[..], WmRunIn.{command = command, check = check, exit = exit, timed_out = timed_out, ms = ms, output = h, bytes = output.count}, w[0].line[..]));
}
// A run's whole output into out: its length, or -1.
wmf_output :: (w: [] Wmf, run: int, out: [] u8) -> int {
  if run < 0 || run >= w[0].s[0].nruns { return -1; }
  return wmf_text_get(w, w[0].s[0].runs[run].output, out);
}

wmf_finding :: (w: [] Wmf, text: string, run: int, sources: [] WmSrc) -> WmPut { return wmf_keep(w, wm_put_finding(w[0].s[..], text, run, sources, w[0].line[..])); }
// A finding about lines of a file as the store has it now.
wmf_finding_at :: (w: [] Wmf, text: string, run: int, path: string, from: int, to: int) -> WmPut {
  s := w[0].s[..]; f := wm_file(s, path);
  if f < 0 { return WmPut.{}; }
  src := [1] WmSrc.[WmSrc.{path = path, from = from, to = to, hash = s[0].files[f].hash}];
  return wmf_finding(w, text, run, src[..]);
}
wmf_check :: (w: [] Wmf, name: string, command: string) -> WmPut { return wmf_keep(w, wm_put_check(w[0].s[..], name, command, w[0].line[..])); }
wmf_requirement :: (w: [] Wmf, text: string) -> WmPut { return wmf_keep(w, wm_put_requirement(w[0].s[..], text, w[0].line[..])); }
wmf_status :: (w: [] Wmf, req: int, status: int, evidence: [] WmEvid) -> WmPut { return wmf_keep(w, wm_put_status(w[0].s[..], req, status, evidence, w[0].line[..])); }

// Looks at every file the store knows, in the workspace (the header's root),
// and records the ones whose content is no longer what the store has (a file
// that is gone has no content). Call it after a shell command, and before
// asking wm_may_finish. changed: files with new content.
WmfRefresh :: struct { changed: int; stale_reads: int; stale_findings: int; }
wmf_refresh :: (w: [] Wmf) -> WmfRefresh {
  s := w[0].s[..]; r: WmfRefresh; pb: [FS_PATH_MAX] u8;
  for f: 0..<s[0].nfiles {
    path := fs_join(s[0].root, s[0].files[f].path, pb[..]);
    if path.count == 0 { continue; }
    n := 0;
    if fs_kind(path) == FS_FILE { n = fs_read(path, w[0].text[0..<WMF_TEXT]); }
    if n < 0 { continue; }
    before := s[0].files[f].versions;
    o := wmf_observe(w, s[0].files[f].path, cast(string) w[0].text[0..<n]);
    if o.ok && s[0].files[f].versions != before { r.changed += 1; r.stale_reads += o.stale_reads; r.stale_findings += o.stale_findings; }
  }
  return r;
}
