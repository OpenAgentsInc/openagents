// The run store: a coding agent's durable working memory (GitHub #13444 part
// 1). Everything a run read, learned, changed and ran is a row here, and
// nothing is dropped: a row is only shown or not shown (view.coax).
//
// The store is a log. Every change to it is one JSON line (schema
// openagents.workmem.v1, proto/coder/workmem-v1.json), and the rows in memory
// are what applying the lines in order makes. wm_put_* writes a line and
// applies it; wm_apply applies a line that was written before; so a store
// reopened from its file (wm_load) is the store that wrote it. This file is
// the one writer and the one reader of those lines. It has no effects:
// file.coax keeps the log and the texts on disk.
//
// The lines ([ ] is left out when empty, false or -1):
//   {"kind":"workmem","schema":"openagents.workmem.v1","run":ID,"root":DIR}    the first line
//   {"kind":"file","path":P,"sha256":H,"bytes":N,"lines":N}       a file's content as it is now
//   {"kind":"read","path":P,"sha256":H,"from":A,"to":B}           lines A..B (1-based, both shown) of that content went to the model
//   {"kind":"finding","text":T,"verified":B[,"run":N],"sources":[{"path":P,"from":A,"to":B,"sha256":H}]}
//                                                                 a note: verified names the run row that showed it; else it is a guess
//   {"kind":"change","path":P,"before":H,"after":H,"from":A,"to":B,"bytes":N,"lines":N}
//                                                                 an edit: lines A..B of the new content are what it wrote
//   {"kind":"run","command":C[,"check":NAME],"exit":N,"timed_out":B,"ms":N,"output":H,"bytes":N}
//                                                                 a command ran; its whole output is the text with hash H
//   {"kind":"check","name":NAME,"command":C}                      a check the task names; a run row with that check is a run of it
//   {"kind":"requirement","text":T}                               a requirement of the task, open
//   {"kind":"status","requirement":N,"status":"open|done|failed","evidence":[{"kind":"run|finding|change","id":N}]}
//                                                                 its status now and the rows that support it (replaces the earlier list)
// H is a SHA-256 as 64 lowercase hex digits; the text it names is kept once,
// by file.coax, under text/H. A row's number is its place among the rows of
// its kind, from 0.
//
// Staleness is never stored; it follows from the hashes. A read is stale
// when its file's content is no longer the content it read. A finding is
// stale when any source's file has changed since. Both stay in the store and
// leave the "current" view; if the file comes back to the old content they
// are current again. A line that changes a file's content reports how many
// reads and findings it made stale (WmApplied), and wm_stale_* name them.
//
// The tree digest (wm_tree) is the SHA-256 over the path and current hash of
// every file whose content the run has seen change. A run row keeps the
// digest it ran on, and finish.coax compares it with the digest now.
#load "finish.coax";
#load "../../json/json.coax";
#load "../../crypto/sha256.coax";

WM_SCHEMA :: "openagents.workmem.v1";
WM_FILES :: 1024; WM_READS :: 4096; WM_FINDINGS :: 1024; WM_SOURCES :: 4096;
WM_CHANGES :: 2048; WM_RUNS :: 2048; WM_REQS :: 128; WM_EVID :: 1024; WM_CHECKS :: 32;
WM_ARENA :: 1048576;         // bytes of paths, notes, commands and requirement texts
WM_LINE :: 32768;            // a line's bytes, at most
WM_PATH :: 4096;
WM_END :: 1073741824;        // "to the end of the file" for a read of a file whose line count is not known

WM_K_HEADER :: 1; WM_K_FILE :: 2; WM_K_READ :: 3; WM_K_FINDING :: 4; WM_K_CHANGE :: 5;
WM_K_RUN :: 6; WM_K_CHECK :: 7; WM_K_REQUIREMENT :: 8; WM_K_STATUS :: 9;
WM_KINDS :: [10] string.["", "workmem", "file", "read", "finding", "change", "run", "check", "requirement", "status"];
WM_STATUS :: [3] string.["open", "done", "failed"];            // by WF_OPEN, WF_DONE, WF_FAILED
WM_EVIDENCE :: [4] string.["", "run", "finding", "change"];    // by WF_RUN, WF_FINDING, WF_CHANGE

WmFile :: struct { path: string; hash: [32] u8; bytes: int; lines: int; versions: int; seq: int; }
// uses: how many times this range of this content was read; seq: the first time, last: the latest.
WmRead :: struct { file: int; hash: [32] u8; from: int; to: int; seq: int; last: int; uses: int; }
WmSource :: struct { file: int; from: int; to: int; hash: [32] u8; }
WmFinding :: struct { text: string; verified: bool; run: int = -1; first: int; count: int; seq: int; }
WmChange :: struct { file: int; before: [32] u8; after: [32] u8; from: int; to: int; seq: int; }
WmRun :: struct { command: string; check: string; exit: int; timed_out: bool; ms: int; output: [32] u8; bytes: int; tree: [32] u8; seq: int; }
WmCheck :: struct { name: string; command: string; seq: int; }
WmEvid :: struct { kind: int; id: int; }
WmReq :: struct { text: string; status: int; first: int; count: int; seq: int; changed: int; }

WmStore :: struct {
  run: string; root: string; seq: int;             // seq: lines applied
  files: [WM_FILES] WmFile; nfiles: int;
  reads: [WM_READS] WmRead; nreads: int;
  findings: [WM_FINDINGS] WmFinding; nfindings: int;
  sources: [WM_SOURCES] WmSource; nsources: int;
  changes: [WM_CHANGES] WmChange; nchanges: int;
  runs: [WM_RUNS] WmRun; nruns: int;
  checks: [WM_CHECKS] WmCheck; nchecks: int;
  reqs: [WM_REQS] WmReq; nreqs: int;
  evid: [WM_EVID] WmEvid; nevid: int;
  arena: [WM_ARENA] u8; na: int;
  read_calls: int; read_known: int;                // read lines applied; those whose range the store already had, current
}

// What applying a line did. id: the row it made or changed. known: (a read)
// the store already had every line of the range at this content, so nothing
// needed fetching. file, stale_reads, stale_findings: the file whose content
// changed, and how many reads and findings that made stale.
WmApplied :: struct { ok: bool; kind: int; id: int = -1; known: bool; file: int = -1; stale_reads: int; stale_findings: int; }
// A line written and applied. line ends with its newline and lives in the caller's buffer.
WmPut :: struct { ok: bool; id: int = -1; line: string; known: bool; file: int = -1; stale_reads: int; stale_findings: int; }

// A finding's source and a run, as a caller gives them.
WmSrc :: struct { path: string; from: int; to: int; hash: [32] u8; }
WmRunIn :: struct { command: string; check: string; exit: int; timed_out: bool; ms: int; output: [32] u8; bytes: int; }

// ------------------------------------------------------------------ checks

WmT :: struct { s: [1] WmStore; t: [1] WmStore; line: [WM_LINE] u8; kept: [262144] u8; n: int; }
// Keeps each written line, as file.coax appends it to the log.
wm_t_keep :: (t: [] WmT, p: WmPut) -> WmPut {
  for c, i: p.line { t[0].kept[t[0].n + i] = c; }
  t[0].n += p.line.count;
  return p;
}
wm_t_log :: (t: [] WmT) -> string { return cast(string) t[0].kept[0..<t[0].n]; }

#test "hashes: SHA-256 of a text, as hex and back" {
  hb: [64] u8;
  #assert wm_hex(wm_hash("abc"), hb[..]) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
  #assert wm_hex(wm_hash(""), hb[..]) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
  h := wm_unhex("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
  #assert h.ok && wm_same(h.h, wm_hash("abc")) && !wm_same(h.h, wm_hash("abd"));
  #assert !wm_unhex("ba78").ok && !wm_unhex("Xa7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad").ok;
  #assert !wm_unhex("BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD").ok;
  #assert wm_line_count("") == 0 && wm_line_count("a") == 1 && wm_line_count("a\n") == 1 && wm_line_count("a\nb") == 2 && wm_line_count("\n\n") == 2;
}

#test "lines of a text, and the lines an edit wrote" {
  t := "one\ntwo\nthree\nfour";
  #assert wm_lines_of(t, 1, 1) == "one\n" && wm_lines_of(t, 2, 3) == "two\nthree\n" && wm_lines_of(t, 4, 4) == "four" && wm_lines_of(t, 3, WM_END) == "three\nfour";
  #assert wm_lines_of(t, 5, 6) == "" && wm_lines_of(t, 0, 1) == "" && wm_lines_of(t, 3, 2) == "" && wm_lines_of("", 1, 1) == "";
  r := wm_changed_range("a\nb\nc\n", "a\nB\nc\n");
  #assert r.from == 2 && r.to == 2;
  r = wm_changed_range("a\nb\nc\n", "a\nx\ny\nc\n"); #assert r.from == 2 && r.to == 3;       // one line became two
  r = wm_changed_range("a\nb\nc\n", "a\nc\n"); #assert r.from == 2 && r.to == 1;             // a line removed: nothing written
  r = wm_changed_range("a\n", "a\nb\n"); #assert r.from == 2 && r.to == 2;                    // added at the end
  r = wm_changed_range("b\n", "a\nb\n"); #assert r.from == 1 && r.to == 1;                    // added at the start
  r = wm_changed_range("", "a\nb"); #assert r.from == 1 && r.to == 2;
  r = wm_changed_range("a\nb", ""); #assert r.from == 1 && r.to == 0;
  r = wm_changed_range("a\na\na\n", "a\na\n"); #assert r.from == 3 && r.to == 2;             // repeated lines: the shared start wins
  r = wm_changed_range("x\ny\n", "x\ny\n"); #assert r.from == 3 && r.to == 2;                 // no change
  r = wm_changed_range("a\nb", "a\nb\n"); #assert r.from == 2 && r.to == 2;                   // only the last newline differs
}

#test "a scripted run: reads, a finding, an edit, runs; staleness; the store reopened is the same store" #steps 100000000 {
  t: [1] WmT; s := t[0].s[..]; out := t[0].line[..];
  v1 := wm_hash("one\ntwo\nthree\n"); v2 := wm_hash("one\n2\nthree\n"); o1 := wm_hash("ok\n"); other := wm_hash("x\n");
  #assert wm_t_keep(t[..], wm_put_header(s, "run-1", "/w/app", out)).ok;
  #assert !wm_put_header(s, "run-2", "/w", out).ok;                      // one header, first
  f := wm_t_keep(t[..], wm_put_file(s, "a.coax", v1, 14, 3, out));
  #assert f.ok && f.id == 0 && f.stale_reads == 0 && f.line == "{\"kind\":\"file\",\"path\":\"a.coax\",\"sha256\":\"b6285c57e8797db5d4c51c80d6f11938afda9b11c6a003549709189e9b4b92a2\",\"bytes\":14,\"lines\":3}\n";
  r := wm_t_keep(t[..], wm_put_read(s, "a.coax", v1, 1, 2, out));
  #assert r.ok && r.id == 0 && !r.known && s[0].nreads == 1;
  #assert wm_seen(s, "a.coax", 1, 2) && wm_seen(s, "a.coax", 2, 2) && !wm_seen(s, "a.coax", 1, 3) && !wm_seen(s, "b.coax", 1, 1);
  // the same range again: answered from the store, counted on the same row
  r = wm_t_keep(t[..], wm_put_read(s, "a.coax", v1, 1, 2, out));
  #assert r.ok && r.id == 0 && r.known && s[0].nreads == 1 && s[0].reads[0].uses == 2 && s[0].reads[0].last == 4 && s[0].reads[0].seq == 3;
  // a range inside what was read is known; one that reaches past it is not
  r = wm_t_keep(t[..], wm_put_read(s, "a.coax", v1, 2, 2, out));
  #assert r.ok && r.id == 1 && r.known;
  r = wm_t_keep(t[..], wm_put_read(s, "a.coax", v1, 3, 3, out));
  #assert r.ok && r.id == 2 && !r.known && wm_seen(s, "a.coax", 1, 3);
  #assert s[0].read_calls == 4 && s[0].read_known == 2;
  _ = wm_t_keep(t[..], wm_put_file(s, "b.coax", other, 2, 1, out));
  _ = wm_t_keep(t[..], wm_put_read(s, "b.coax", other, 1, 1, out));
  // a guess with a source, then a run, then a verified finding from it
  src := [2] WmSrc.[WmSrc.{path = "a.coax", from = 2, to = 2, hash = v1}, WmSrc.{path = "b.coax", from = 1, to = 1, hash = other}];
  g := wm_t_keep(t[..], wm_put_finding(s, "two is spelled out on line 2", -1, src[0..<1], out));
  #assert g.ok && g.id == 0 && !s[0].findings[0].verified && !wm_finding_stale(s, 0);
  #assert !wm_put_finding(s, "from a run that is not there", 0, src[0..<1], out).ok && s[0].nfindings == 1;
  run := wm_t_keep(t[..], wm_put_run(s, WmRunIn.{command = "coax test a.coax", check = "unit", exit = 0, ms = 1200, output = o1, bytes = 3}, out));
  #assert run.ok && run.id == 0 && wm_same(s[0].runs[0].tree, wm_tree(s));
  g = wm_t_keep(t[..], wm_put_finding(s, "a.coax passes its checks; b is \"x\"", 0, src[..], out));
  #assert g.ok && g.id == 1 && s[0].findings[1].verified && s[0].findings[1].run == 0 && s[0].findings[1].count == 2;
  g = wm_t_keep(t[..], wm_put_finding(s, "b only", -1, src[1..<2], out));
  tree0 := wm_tree(s);
  // the edit: a.coax has new content. Its three reads and the two findings about it go stale; b's stay.
  c := wm_t_keep(t[..], wm_put_change(s, "a.coax", v1, v2, 2, 2, 12, 3, out));
  #assert c.ok && c.id == 0 && c.file == 0 && c.stale_reads == 3 && c.stale_findings == 2;
  #assert wm_read_stale(s, 0) && wm_read_stale(s, 1) && wm_read_stale(s, 2) && !wm_read_stale(s, 3);
  #assert wm_finding_stale(s, 0) && wm_finding_stale(s, 1) && !wm_finding_stale(s, 2);
  #assert !wm_seen(s, "a.coax", 1, 2) && wm_seen(s, "b.coax", 1, 1);
  #assert !wm_same(tree0, wm_tree(s)) && wm_same(s[0].runs[0].tree, tree0);
  // the same lines read again are a fetch, on a new row; the old rows are kept
  r = wm_t_keep(t[..], wm_put_read(s, "a.coax", v2, 1, 2, out));
  #assert r.ok && r.id == 4 && !r.known && s[0].nreads == 5 && !wm_read_stale(s, 4) && wm_read_stale(s, 0);
  // an edit that names content the store does not have as "before" is refused
  #assert !wm_put_change(s, "a.coax", v1, other, 1, 1, 2, 1, out).ok && s[0].nchanges == 1;
  // the file back at its first content: the old reads and findings are current again
  c = wm_t_keep(t[..], wm_put_change(s, "a.coax", v2, v1, 2, 2, 14, 3, out));
  #assert c.ok && c.stale_reads == 1 && !wm_read_stale(s, 0) && wm_read_stale(s, 4) && !wm_finding_stale(s, 0);
  // reopened: every row and every answer is the same
  u := t[0].t[..];
  #assert wm_load(u, wm_t_log(t[..])) == s[0].seq && u[0].seq == s[0].seq;
  #assert u[0].run == "run-1" && u[0].root == "/w/app";
  #assert u[0].nfiles == 2 && u[0].nreads == 5 && u[0].nfindings == 3 && u[0].nsources == 4 && u[0].nchanges == 2 && u[0].nruns == 1;
  #assert u[0].reads[0].uses == 2 && u[0].reads[0].last == 4 && u[0].read_calls == s[0].read_calls && u[0].read_known == s[0].read_known;
  #assert u[0].findings[1].text == "a.coax passes its checks; b is \"x\"" && u[0].findings[1].verified && u[0].runs[0].command == "coax test a.coax";
  #assert u[0].runs[0].check == "unit" && u[0].runs[0].ms == 1200 && wm_same(u[0].runs[0].output, o1) && wm_same(u[0].runs[0].tree, tree0);
  #assert wm_same(wm_tree(u), wm_tree(s)) && wm_read_stale(u, 4) && !wm_read_stale(u, 0) && u[0].files[0].versions == 3;
  // and it goes on from there: the next line is the same bytes from either
  mine: [512] u8;
  a := wm_put_read(s, "b.coax", other, 1, 1, out); b := wm_put_read(u, "b.coax", other, 1, 1, mine[..]);
  #assert a.ok && b.ok && a.line == b.line && a.known && b.known && a.id == b.id;
}

#test "requirements, checks and the finish rule on the store" #steps 100000000 {
  t: [1] WmT; s := t[0].s[..]; out := t[0].line[..]; why: [8] WfReason;
  v1 := wm_hash("a\n"); v2 := wm_hash("b\n"); o := wm_hash("ok\n");
  _ = wm_t_keep(t[..], wm_put_header(s, "r", "/w", out));
  #assert wm_may_finish(s, why[..]).ok;                                   // nothing to prove yet
  q := wm_t_keep(t[..], wm_put_requirement(s, "the clock counts in integer ticks", out));
  #assert q.ok && q.id == 0 && s[0].reqs[0].status == WF_OPEN;
  k := wm_t_keep(t[..], wm_put_check(s, "unit", "coax test a.coax", out));
  #assert k.ok && k.id == 0 && !wm_put_check(s, "unit", "another", out).ok && !wm_put_check(s, "", "x", out).ok;
  v := wm_may_finish(s, why[..]);
  #assert !v.ok && v.count == 2 && why[0].why == WF_REQ_OPEN && why[1].why == WF_CHECK_NEVER;
  _ = wm_t_keep(t[..], wm_put_file(s, "a.coax", v1, 2, 1, out));
  c := wm_t_keep(t[..], wm_put_change(s, "a.coax", v1, v2, 1, 1, 2, 1, out));
  run := wm_t_keep(t[..], wm_put_run(s, WmRunIn.{command = "coax test a.coax", check = "unit", exit = 1, ms = 5, output = o, bytes = 3}, out));
  // done on the model's word alone is refused by the rule; evidence must name rows that exist
  none: [1] WmEvid;
  e1 := [1] WmEvid.[WmEvid.{kind = WF_RUN, id = 7}];
  #assert !wm_put_status(s, 0, WF_DONE, e1[..], out).ok;
  #assert !wm_put_status(s, 1, WF_DONE, none[0..<0], out).ok && !wm_put_status(s, 0, 3, none[0..<0], out).ok;
  #assert wm_t_keep(t[..], wm_put_status(s, 0, WF_DONE, none[0..<0], out)).ok;
  v = wm_may_finish(s, why[..]);
  #assert !v.ok && v.count == 2 && why[0].why == WF_REQ_UNPROVEN && why[1].why == WF_CHECK_FAILING;
  // the change is evidence while its text stands; the check must still pass
  e1[0] = WmEvid.{kind = WF_CHANGE, id = c.id};
  #assert wm_t_keep(t[..], wm_put_status(s, 0, WF_DONE, e1[..], out)).ok;
  v = wm_may_finish(s, why[..]);
  #assert !v.ok && v.count == 1 && why[0].why == WF_CHECK_FAILING && why[0].row == 0;
  run = wm_t_keep(t[..], wm_put_run(s, WmRunIn.{command = "coax test a.coax", check = "unit", exit = 0, ms = 5, output = o, bytes = 3}, out));
  #assert wm_may_finish(s, why[..]).ok;
  // a run that is not of the check does not count for it
  _ = wm_t_keep(t[..], wm_put_run(s, WmRunIn.{command = "false", exit = 1, output = o, bytes = 3}, out));
  #assert wm_may_finish(s, why[..]).ok;
  // one more edit: the pass was on another tree, and the change that was evidence is gone
  _ = wm_t_keep(t[..], wm_put_change(s, "a.coax", v2, v1, 1, 1, 2, 1, out));
  v = wm_may_finish(s, why[..]);
  #assert !v.ok && v.count == 2 && why[0].why == WF_REQ_UNPROVEN && why[1].why == WF_CHECK_STALE;
  // the passing run as evidence, and the check run again on this tree
  run = wm_t_keep(t[..], wm_put_run(s, WmRunIn.{command = "coax test a.coax", check = "unit", exit = 0, ms = 5, output = o, bytes = 3}, out));
  e2 := [2] WmEvid.[WmEvid.{kind = WF_CHANGE, id = 0}, WmEvid.{kind = WF_RUN, id = run.id}];
  #assert wm_t_keep(t[..], wm_put_status(s, 0, WF_DONE, e2[..], out)).ok;
  #assert wm_may_finish(s, why[..]).ok && s[0].reqs[0].count == 2;
  #assert wm_t_keep(t[..], wm_put_status(s, 0, WF_FAILED, none[0..<0], out)).ok;
  v = wm_may_finish(s, why[..]);
  #assert !v.ok && why[0].why == WF_REQ_FAILED;
  // reopened, the rule answers the same
  u := t[0].t[..];
  #assert wm_load(u, wm_t_log(t[..])) == s[0].seq;
  v = wm_may_finish(u, why[..]);
  #assert !v.ok && v.count == 1 && why[0].why == WF_REQ_FAILED && u[0].nreqs == 1 && u[0].nchecks == 1 && u[0].nruns == 4;
  #assert u[0].reqs[0].text == "the clock counts in integer ticks" && u[0].checks[0].command == "coax test a.coax";
}

#test "lines that are not this log's are refused and change nothing" {
  t: [1] WmT; s := t[0].s[..]; out := t[0].line[..];
  #assert !wm_apply(s, "{\"kind\":\"file\",\"path\":\"a\",\"sha256\":\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\"bytes\":0,\"lines\":0}").ok;   // before the header
  #assert !wm_apply(s, "{\"kind\":\"workmem\",\"schema\":\"openagents.workmem.v2\",\"run\":\"r\",\"root\":\"/w\"}").ok;
  #assert wm_apply(s, "{\"kind\":\"workmem\",\"schema\":\"openagents.workmem.v1\",\"run\":\"r\",\"root\":\"/w\"}\n").ok && s[0].seq == 1;
  for bad: [9] string.["", "not json", "[]", "{\"kind\":\"nope\"}", "{\"kind\":\"file\",\"path\":\"\",\"sha256\":\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\"bytes\":0,\"lines\":0}",
                        "{\"kind\":\"file\",\"path\":\"a\",\"sha256\":\"e3b0\",\"bytes\":0,\"lines\":0}", "{\"kind\":\"read\",\"path\":\"a\",\"sha256\":\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\"from\":3,\"to\":2}",
                        "{\"kind\":\"read\",\"path\":\"a\",\"sha256\":\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\"from\":0,\"to\":2}", "{\"kind\":\"status\",\"requirement\":0,\"status\":\"done\",\"evidence\":[]}"] {
    #assert !wm_apply(s, bad).ok;
  }
  #assert s[0].seq == 1 && s[0].nfiles == 0 && s[0].nreads == 0 && s[0].na == 3;
  // a load stops at the first bad line and says which (1-based, negative)
  #assert wm_load(t[0].t[..], "{\"kind\":\"workmem\",\"schema\":\"openagents.workmem.v1\",\"run\":\"r\",\"root\":\"/w\"}\n{\"kind\":\"nope\"}\n") == -2;
  // a line too long for the caller's buffer is not applied
  small: [40] u8;
  #assert !wm_put_file(s, "a-path-too-long-for-forty-bytes.coax", wm_hash(""), 0, 0, small[..]).ok && s[0].nfiles == 0;
  // a read of content the store has not been told about tells it: the file is known from then on
  r := wm_put_read(s, "new.coax", wm_hash("z"), 1, WM_END, out);
  #assert r.ok && s[0].nfiles == 1 && s[0].files[0].versions == 1 && wm_seen(s, "new.coax", 5, 900);
}

// ------------------------------------------------------------------ hashes

wm_hash :: (text: string) -> [32] u8 {
  state: [SHA_STATE_BYTES] u8; out: [32] u8; chunk: [65536] u8;
  x := sha256_init(state[..]);
  at := 0;
  while at < text.count {
    n := ifx text.count - at < chunk.count then text.count - at else chunk.count;
    for i: 0..<n { chunk[i] = text[at + i]; }
    x = sha256_update_checked(state[..], chunk[0..<n], false);
    at += n;
  }
  x = sha256_final_checked(state[..], out[..], false);
  return out;
}
wm_same :: (a: [32] u8, b: [32] u8) -> bool { return wf_same_tree(a, b); }
wm_hex :: (h: [32] u8, out: [] u8) -> string {
  digits := "0123456789abcdef";
  for i: 0..<32 { out[2 * i] = digits[cast(int) (h[i] >> 4)]; out[2 * i + 1] = digits[cast(int) (h[i] & 15)]; }
  return cast(string) out[0..<64];
}
WmHash :: struct { ok: bool; h: [32] u8; }
wm_nibble :: (c: u8) -> int {
  if c >= '0' && c <= '9' { return cast(int) (c - '0'); }
  if c >= 'a' && c <= 'f' { return cast(int) (c - 'a') + 10; }
  return -1;
}
wm_unhex :: (text: string) -> WmHash {
  r: WmHash;
  if text.count != 64 { return r; }
  for i: 0..<32 {
    hi := wm_nibble(text[2 * i]); lo := wm_nibble(text[2 * i + 1]);
    if hi < 0 || lo < 0 { return r; }
    r.h[i] = cast(u8) (hi * 16 + lo);
  }
  r.ok = true;
  return r;
}
// Lines of a text: a last line with no newline counts.
wm_line_count :: (text: string) -> int {
  n := 0;
  for c: text { if c == 10 { n += 1; } }
  if text.count > 0 && text[text.count - 1] != 10 { n += 1; }
  return n;
}

// Lines from..to (1-based, both included) of a text, with their newlines; "" when the text has no such line.
wm_lines_of :: (text: string, from: int, to: int) -> string {
  if from < 1 || to < from { return ""; }
  line := 1; at := 0;
  while line < from && at < text.count { if text[at] == 10 { line += 1; } at += 1; }
  if line < from || at >= text.count { return ""; }
  end := at;
  while end < text.count && line <= to { if text[end] == 10 { line += 1; } end += 1; }
  return text[at..<end];
}
// The end of the line that starts at at: just past its newline, or the text's end.
wm_line_end :: (text: string, at: int) -> int {
  i := at;
  while i < text.count && text[i] != 10 { i += 1; }
  return ifx i < text.count then i + 1 else i;
}
// The start of the line that ends at end (end is a line's end: past a newline, or the text's end).
wm_line_start :: (text: string, end: int) -> int {
  i := end;
  if i > 0 && text[i - 1] == 10 { i -= 1; }
  while i > 0 && text[i - 1] != 10 { i -= 1; }
  return i;
}
// The lines of the new text an edit wrote: what is left between the lines
// the two texts share at their start and at their end. to is from - 1 when
// the edit only removed lines.
WmRange :: struct { from: int; to: int; }
wm_changed_range :: (before: string, after: string) -> WmRange {
  a := 0; b := 0; first := 1;
  while a < before.count && b < after.count {
    ae := wm_line_end(before, a); be := wm_line_end(after, b);
    if before[a..<ae] != after[b..<be] { break; }
    a = ae; b = be; first += 1;
  }
  ea := before.count; eb := after.count;
  while ea > a && eb > b {
    sa := wm_line_start(before, ea); sb := wm_line_start(after, eb);
    if sa < a || sb < b || before[sa..<ea] != after[sb..<eb] { break; }
    ea = sa; eb = sb;
  }
  return WmRange.{from = first, to = first + wm_line_count(after[b..<eb]) - 1};
}

// ------------------------------------------------------------------ queries

// The file's row, or -1.
wm_file :: (s: [] WmStore, path: string) -> int {
  for i: 0..<s[0].nfiles { if s[0].files[i].path == path { return i; } }
  return -1;
}
wm_read_stale :: (s: [] WmStore, i: int) -> bool { return !wm_same(s[0].reads[i].hash, s[0].files[s[0].reads[i].file].hash); }
wm_source_stale :: (s: [] WmStore, i: int) -> bool { return !wm_same(s[0].sources[i].hash, s[0].files[s[0].sources[i].file].hash); }
wm_finding_stale :: (s: [] WmStore, i: int) -> bool {
  f := s[0].findings[i];
  for k: f.first..<f.first + f.count { if wm_source_stale(s, k) { return true; } }
  return false;
}
// Is the finding about this file (one of its sources)?
wm_finding_about :: (s: [] WmStore, i: int, file: int) -> bool {
  f := s[0].findings[i];
  for k: f.first..<f.first + f.count { if s[0].sources[k].file == file { return true; } }
  return false;
}
// Does the change's text still stand (the file has the content it wrote)?
wm_change_kept :: (s: [] WmStore, i: int) -> bool { return wm_same(s[0].changes[i].after, s[0].files[s[0].changes[i].file].hash); }

// Has the model been shown every line from..to of the file as it is now?
// True means a read of that range needs no fetch: the store has it.
wm_seen_file :: (s: [] WmStore, file: int, from: int, to: int) -> bool {
  if file < 0 || from < 1 || to < from { return false; }
  f := s[0].files[file];
  last := ifx f.lines > 0 && to > f.lines then f.lines else to;
  need := from;
  while need <= last {
    next := need;
    for i: 0..<s[0].nreads {
      r := s[0].reads[i];
      if r.file == file && r.from <= need && r.to >= next && wm_same(r.hash, f.hash) { next = r.to + 1; }
    }
    if next == need { return false; }
    need = next;
  }
  return true;
}
wm_seen :: (s: [] WmStore, path: string, from: int, to: int) -> bool { return wm_seen_file(s, wm_file(s, path), from, to); }

// The tree as it is now: every file whose content the run has seen change, by path and current hash.
wm_tree :: (s: [] WmStore) -> [32] u8 {
  state: [SHA_STATE_BYTES] u8; out: [32] u8; buf: [WM_PATH + 33] u8;
  x := sha256_init(state[..]);
  for i: 0..<s[0].nfiles {
    f := s[0].files[i];
    if f.versions < 2 { continue; }
    n := 0;
    for c: f.path { buf[n] = c; n += 1; }
    buf[n] = 0; n += 1;
    for c: f.hash { buf[n] = c; n += 1; }
    x = sha256_update_checked(state[..], buf[0..<n], false);
  }
  x = sha256_final_checked(state[..], out[..], false);
  return out;
}

// An evidence row as finish.coax judges it. Nothing is decided here.
wm_fact :: (s: [] WmStore, e: WmEvid) -> WfEvidence {
  if e.kind == WF_RUN { r := s[0].runs[e.id]; return WfEvidence.{kind = WF_RUN, exit = r.exit, timed_out = r.timed_out, tree = r.tree}; }
  if e.kind == WF_FINDING { return WfEvidence.{kind = WF_FINDING, verified = s[0].findings[e.id].verified, stale = wm_finding_stale(s, e.id)}; }
  return WfEvidence.{kind = WF_CHANGE, kept = wm_change_kept(s, e.id)};
}

// May the run finish (finish.coax)? reasons[i].row is a requirement's row
// for WF_REQ_*, a check's row for WF_CHECK_*.
wm_may_finish :: (s: [] WmStore, reasons: [] WfReason) -> WfVerdict {
  none: [1] WfFile;
  return wm_may_finish_files(s, none[0..<0], reasons);
}
// The same, with what each file had when the run started and has now
// (files[i] is the file row i; file.coax wmf_facts gathers them): a file the
// run weakened is a reason too, and its reasons[i].row is the file's row.
wm_may_finish_files :: (s: [] WmStore, files: [] WfFile, reasons: [] WfReason) -> WfVerdict {
  ev: [WM_EVID + WM_RUNS] WfEvidence; reqs: [WM_REQS] WfReq; checks: [WM_CHECKS] WfCheck; n := 0;
  for i: 0..<s[0].nreqs {
    q := s[0].reqs[i];
    reqs[i] = WfReq.{status = q.status, first = n, count = q.count};
    for k: q.first..<q.first + q.count { ev[n] = wm_fact(s, s[0].evid[k]); n += 1; }
  }
  for i: 0..<s[0].nchecks {
    checks[i] = WfCheck.{first = n};
    for k: 0..<s[0].nruns {
      if s[0].runs[k].check == s[0].checks[i].name { ev[n] = wm_fact(s, WmEvid.{kind = WF_RUN, id = k}); n += 1; checks[i].count += 1; }
    }
  }
  return wf_may_finish_files(reqs[0..<s[0].nreqs], checks[0..<s[0].nchecks], ev[0..<n], wm_tree(s), files, reasons);
}

// ------------------------------------------------------------------ the writer

wm_o_hash :: (o: [] Jo, key: string, h: [32] u8) { hb: [64] u8; jo_key(o, key); jo_str(o, wm_hex(h, hb[..])); }
wm_o_str :: (o: [] Jo, key: string, v: string) { jo_key(o, key); jo_str(o, v); }
wm_o_int :: (o: [] Jo, key: string, v: int) { jo_key(o, key); jo_int(o, v); }
wm_o_open :: (o: [] Jo, out: [] u8, kind: int) { jo_start(o, out); jo_obj(o); wm_o_str(o, "kind", WM_KINDS[kind]); }

// Ends the line, applies it, and gives back what it did. A line that does
// not fit out, or that the store refuses, changes nothing.
wm_o_put :: (s: [] WmStore, o: [] Jo) -> WmPut {
  jo_end(o); jo_put(o, "\n");
  if o[0].bad { return WmPut.{}; }
  line := jo_text(o);
  a := wm_apply(s, line);
  if !a.ok { return WmPut.{}; }
  return WmPut.{ok = true, id = a.id, line = line, known = a.known, file = a.file, stale_reads = a.stale_reads, stale_findings = a.stale_findings};
}

// The first line: the run's id and the workspace's folder.
wm_put_header :: (s: [] WmStore, run: string, root: string, out: [] u8) -> WmPut {
  o: [1] Jo; wm_o_open(o[..], out, WM_K_HEADER);
  wm_o_str(o[..], "schema", WM_SCHEMA); wm_o_str(o[..], "run", run); wm_o_str(o[..], "root", root);
  return wm_o_put(s, o[..]);
}
// The file's content as it is now. New content makes the reads and findings about the old stale.
wm_put_file :: (s: [] WmStore, path: string, hash: [32] u8, bytes: int, lines: int, out: [] u8) -> WmPut {
  o: [1] Jo; wm_o_open(o[..], out, WM_K_FILE);
  wm_o_str(o[..], "path", path); wm_o_hash(o[..], "sha256", hash); wm_o_int(o[..], "bytes", bytes); wm_o_int(o[..], "lines", lines);
  return wm_o_put(s, o[..]);
}
// Lines from..to of the content with that hash went to the model. known: the store already had them.
wm_put_read :: (s: [] WmStore, path: string, hash: [32] u8, from: int, to: int, out: [] u8) -> WmPut {
  o: [1] Jo; wm_o_open(o[..], out, WM_K_READ);
  wm_o_str(o[..], "path", path); wm_o_hash(o[..], "sha256", hash); wm_o_int(o[..], "from", from); wm_o_int(o[..], "to", to);
  return wm_o_put(s, o[..]);
}
// A note with where it comes from. run: the run row that showed it (a
// compiler or command result), which makes it verified; -1 for the model's own guess.
wm_put_finding :: (s: [] WmStore, text: string, run: int, sources: [] WmSrc, out: [] u8) -> WmPut {
  o: [1] Jo; wm_o_open(o[..], out, WM_K_FINDING);
  wm_o_str(o[..], "text", text); jo_key(o[..], "verified"); jo_bool(o[..], run >= 0);
  if run >= 0 { wm_o_int(o[..], "run", run); }
  jo_key(o[..], "sources"); jo_arr(o[..]);
  for src: sources {
    jo_obj(o[..]); wm_o_str(o[..], "path", src.path); wm_o_int(o[..], "from", src.from); wm_o_int(o[..], "to", src.to); wm_o_hash(o[..], "sha256", src.hash); jo_end(o[..]);
  }
  jo_end(o[..]);
  return wm_o_put(s, o[..]);
}
// An edit: the file went from the content before to the content after, and
// lines from..to of the new content are what it wrote. Refused when before
// is not the content the store has for the file (a file the store has never
// seen takes before as its first content).
wm_put_change :: (s: [] WmStore, path: string, before: [32] u8, after: [32] u8, from: int, to: int, bytes: int, lines: int, out: [] u8) -> WmPut {
  o: [1] Jo; wm_o_open(o[..], out, WM_K_CHANGE);
  wm_o_str(o[..], "path", path); wm_o_hash(o[..], "before", before); wm_o_hash(o[..], "after", after);
  wm_o_int(o[..], "from", from); wm_o_int(o[..], "to", to); wm_o_int(o[..], "bytes", bytes); wm_o_int(o[..], "lines", lines);
  return wm_o_put(s, o[..]);
}
// A command ran. check: the name of the task's check it is a run of, or "".
wm_put_run :: (s: [] WmStore, r: WmRunIn, out: [] u8) -> WmPut {
  o: [1] Jo; wm_o_open(o[..], out, WM_K_RUN);
  wm_o_str(o[..], "command", r.command);
  if r.check.count > 0 { wm_o_str(o[..], "check", r.check); }
  wm_o_int(o[..], "exit", r.exit); jo_key(o[..], "timed_out"); jo_bool(o[..], r.timed_out); wm_o_int(o[..], "ms", r.ms);
  wm_o_hash(o[..], "output", r.output); wm_o_int(o[..], "bytes", r.bytes);
  return wm_o_put(s, o[..]);
}
// A check the task names. The run may finish only when its latest run passed on the tree as it is then.
wm_put_check :: (s: [] WmStore, name: string, command: string, out: [] u8) -> WmPut {
  o: [1] Jo; wm_o_open(o[..], out, WM_K_CHECK);
  wm_o_str(o[..], "name", name); wm_o_str(o[..], "command", command);
  return wm_o_put(s, o[..]);
}
wm_put_requirement :: (s: [] WmStore, text: string, out: [] u8) -> WmPut {
  o: [1] Jo; wm_o_open(o[..], out, WM_K_REQUIREMENT);
  wm_o_str(o[..], "text", text);
  return wm_o_put(s, o[..]);
}
// The requirement's status now (WF_OPEN, WF_DONE, WF_FAILED) and every row that supports it.
wm_put_status :: (s: [] WmStore, req: int, status: int, evidence: [] WmEvid, out: [] u8) -> WmPut {
  if status < 0 || status >= WM_STATUS.count { return WmPut.{}; }
  o: [1] Jo; wm_o_open(o[..], out, WM_K_STATUS);
  wm_o_int(o[..], "requirement", req); wm_o_str(o[..], "status", WM_STATUS[status]);
  jo_key(o[..], "evidence"); jo_arr(o[..]);
  for e: evidence {
    if e.kind < WF_RUN || e.kind > WF_CHANGE { return WmPut.{}; }
    jo_obj(o[..]); wm_o_str(o[..], "kind", WM_EVIDENCE[e.kind]); wm_o_int(o[..], "id", e.id); jo_end(o[..]);
  }
  jo_end(o[..]);
  return wm_o_put(s, o[..]);
}

// ------------------------------------------------------------------ the reader

wm_index :: (names: [] const string, name: string) -> int { for i: 0..<names.count { if names[i] == name { return i; } } return -1; }

// A string field kept in the store's arena; ok is false when it is missing, not a string, or does not fit.
WmStr :: struct { ok: bool; v: string; }
wm_j_str :: (s: [] WmStore, d: Jv, at: int, key: string) -> WmStr {
  n := jv_str(d, jv_get(d, at, key), s[0].arena[s[0].na..<WM_ARENA]);
  if n < 0 { return WmStr.{}; }
  from := s[0].na; s[0].na += n;
  return WmStr.{ok = true, v = cast(string) s[0].arena[from..<from + n]};
}
wm_j_hash :: (d: Jv, at: int, key: string) -> WmHash {
  v := jv_get(d, at, key);
  if jv_kind(d, v) != JV_STRING { return WmHash.{}; }
  return wm_unhex(jv_raw(d, v));
}
wm_j_int :: (d: Jv, at: int, key: string) -> int { return jv_int(d, jv_get(d, at, key), -1); }

// The file's row for a path field, made (with no content yet) when the path is new; -1 when it can't be.
wm_j_file :: (s: [] WmStore, d: Jv, at: int, key: string) -> int {
  mark := s[0].na;
  p := wm_j_str(s, d, at, key);
  if !p.ok || p.v.count == 0 || p.v.count > WM_PATH { s[0].na = mark; return -1; }
  f := wm_file(s, p.v);
  if f >= 0 { s[0].na = mark; return f; }
  if s[0].nfiles >= WM_FILES { s[0].na = mark; return -1; }
  f = s[0].nfiles; s[0].nfiles += 1;
  s[0].files[f] = WmFile.{path = p.v, seq = s[0].seq + 1};
  return f;
}

// The file has this content now. Counts what that makes stale into a.
wm_set_content :: (s: [] WmStore, a: WmApplied, file: int, hash: [32] u8, bytes: int, lines: int) -> WmApplied {
  r := a; r.file = file;
  f := s[0].files[file];
  if f.versions > 0 && wm_same(f.hash, hash) {
    if bytes >= 0 { s[0].files[file].bytes = bytes; s[0].files[file].lines = lines; }
    return r;
  }
  was_r: [WM_READS] bool; was_f: [WM_FINDINGS] bool;
  for i: 0..<s[0].nreads { was_r[i] = wm_read_stale(s, i); }
  for i: 0..<s[0].nfindings { was_f[i] = wm_finding_stale(s, i); }
  s[0].files[file].hash = hash; s[0].files[file].versions = f.versions + 1;
  s[0].files[file].bytes = ifx bytes >= 0 then bytes else 0; s[0].files[file].lines = ifx bytes >= 0 then lines else 0;
  for i: 0..<s[0].nreads { if !was_r[i] && wm_read_stale(s, i) { r.stale_reads += 1; } }
  for i: 0..<s[0].nfindings { if !was_f[i] && wm_finding_stale(s, i) { r.stale_findings += 1; } }
  return r;
}

// Applies one line (with or without its newline). A line that is not this
// log's, names a row that is not there, or does not fit leaves the store as
// it was and gives ok false.
wm_apply :: (s: [] WmStore, line: string) -> WmApplied {
  snap_files := s[0].nfiles; snap_na := s[0].na;
  a := wm_apply_line(s, line);
  if !a.ok {
    // undo what a refused line began: rows are only ever added at the end
    s[0].nfiles = snap_files; s[0].na = snap_na;
    return WmApplied.{};
  }
  s[0].seq += 1;
  return a;
}

wm_apply_line :: (s: [] WmStore, raw: string) -> WmApplied {
  a: WmApplied; nodes: [512] JvNode; dd: [1] Jv;
  line := raw;
  if line.count > 0 && line[line.count - 1] == 10 { line = line[0..<line.count - 1]; }
  if line.count == 0 || line.count > WM_LINE || !jv_parse(dd[..], line, nodes[..]) || jv_kind(dd[0], 0) != JV_OBJECT { return a; }
  d := dd[0];
  kb: [16] u8; kn := jv_str(d, jv_get(d, 0, "kind"), kb[..]);
  if kn < 0 { return a; }
  a.kind = wm_index(WM_KINDS[..], cast(string) kb[0..<kn]);
  if a.kind < WM_K_HEADER { return a; }
  if (a.kind == WM_K_HEADER) != (s[0].seq == 0) { return a; }
  seq := s[0].seq + 1;

  if a.kind == WM_K_HEADER {
    sb: [64] u8; sn := jv_str(d, jv_get(d, 0, "schema"), sb[..]);
    if sn < 0 || cast(string) sb[0..<sn] != WM_SCHEMA { return a; }
    run := wm_j_str(s, d, 0, "run"); root := wm_j_str(s, d, 0, "root");
    if !run.ok || !root.ok { return a; }
    s[0].run = run.v; s[0].root = root.v;
    a.ok = true; return a;
  }
  if a.kind == WM_K_FILE {
    h := wm_j_hash(d, 0, "sha256"); bytes := wm_j_int(d, 0, "bytes"); lines := wm_j_int(d, 0, "lines");
    if !h.ok || bytes < 0 || lines < 0 { return a; }
    f := wm_j_file(s, d, 0, "path");
    if f < 0 { return a; }
    a = wm_set_content(s, a, f, h.h, bytes, lines);
    a.id = f; a.ok = true; return a;
  }
  if a.kind == WM_K_READ {
    h := wm_j_hash(d, 0, "sha256"); from := wm_j_int(d, 0, "from"); to := wm_j_int(d, 0, "to");
    if !h.ok || from < 1 || to < from || s[0].nreads >= WM_READS { return a; }
    f := wm_j_file(s, d, 0, "path");
    if f < 0 { return a; }
    a = wm_set_content(s, a, f, h.h, -1, 0);
    a.known = wm_seen_file(s, f, from, to);
    row := -1;
    for i: 0..<s[0].nreads {
      r := s[0].reads[i];
      if r.file == f && r.from == from && r.to == to && wm_same(r.hash, h.h) { row = i; break; }
    }
    if row < 0 {
      row = s[0].nreads; s[0].nreads += 1;
      s[0].reads[row] = WmRead.{file = f, hash = h.h, from = from, to = to, seq = seq};
    }
    s[0].reads[row].uses += 1; s[0].reads[row].last = seq;
    s[0].read_calls += 1;
    if a.known { s[0].read_known += 1; }
    a.id = row; a.ok = true; return a;
  }
  if a.kind == WM_K_FINDING {
    verified := jv_bool(d, jv_get(d, 0, "verified")); run := wm_j_int(d, 0, "run");
    list := jv_get(d, 0, "sources");
    if jv_kind(d, list) != JV_ARRAY || verified != (run >= 0) || run >= s[0].nruns { return a; }
    if s[0].nfindings >= WM_FINDINGS || s[0].nsources + jv_len(d, list) > WM_SOURCES { return a; }
    text := wm_j_str(s, d, 0, "text");
    if !text.ok || text.v.count == 0 { return a; }
    first := s[0].nsources;
    for i: 0..<jv_len(d, list) {
      e := jv_at(d, list, i);
      h := wm_j_hash(d, e, "sha256"); from := wm_j_int(d, e, "from"); to := wm_j_int(d, e, "to");
      f := wm_j_file(s, d, e, "path");
      if !h.ok || f < 0 || from < 1 || to < from { return a; }
      if s[0].files[f].versions == 0 { s[0].files[f].hash = h.h; s[0].files[f].versions = 1; }
      s[0].sources[first + i] = WmSource.{file = f, from = from, to = to, hash = h.h};
    }
    s[0].nsources = first + jv_len(d, list);
    a.id = s[0].nfindings; s[0].nfindings += 1;
    s[0].findings[a.id] = WmFinding.{text = text.v, verified = verified, run = run, first = first, count = jv_len(d, list), seq = seq};
    a.ok = true; return a;
  }
  if a.kind == WM_K_CHANGE {
    before := wm_j_hash(d, 0, "before"); after := wm_j_hash(d, 0, "after");
    from := wm_j_int(d, 0, "from"); to := wm_j_int(d, 0, "to"); bytes := wm_j_int(d, 0, "bytes"); lines := wm_j_int(d, 0, "lines");
    if !before.ok || !after.ok || from < 0 || to < from - 1 || bytes < 0 || lines < 0 || s[0].nchanges >= WM_CHANGES { return a; }
    f := wm_j_file(s, d, 0, "path");
    if f < 0 { return a; }
    if s[0].files[f].versions == 0 { s[0].files[f].hash = before.h; s[0].files[f].versions = 1; }
    if !wm_same(s[0].files[f].hash, before.h) { return a; }
    a = wm_set_content(s, a, f, after.h, bytes, lines);
    a.id = s[0].nchanges; s[0].nchanges += 1;
    s[0].changes[a.id] = WmChange.{file = f, before = before.h, after = after.h, from = from, to = to, seq = seq};
    a.ok = true; return a;
  }
  if a.kind == WM_K_RUN {
    output := wm_j_hash(d, 0, "output"); bytes := wm_j_int(d, 0, "bytes"); ms := wm_j_int(d, 0, "ms");
    exit_at := jv_get(d, 0, "exit");
    if !output.ok || bytes < 0 || ms < 0 || jv_kind(d, exit_at) != JV_NUMBER || s[0].nruns >= WM_RUNS { return a; }
    command := wm_j_str(s, d, 0, "command");
    if !command.ok { return a; }
    check := WmStr.{ok = true};
    if jv_get(d, 0, "check") >= 0 { check = wm_j_str(s, d, 0, "check"); }
    if !check.ok { return a; }
    a.id = s[0].nruns; s[0].nruns += 1;
    s[0].runs[a.id] = WmRun.{command = command.v, check = check.v, exit = jv_int(d, exit_at, 1), timed_out = jv_bool(d, jv_get(d, 0, "timed_out")), ms = ms,
      output = output.h, bytes = bytes, tree = wm_tree(s), seq = seq};
    a.ok = true; return a;
  }
  if a.kind == WM_K_CHECK {
    if s[0].nchecks >= WM_CHECKS { return a; }
    name := wm_j_str(s, d, 0, "name"); command := wm_j_str(s, d, 0, "command");
    if !name.ok || !command.ok || name.v.count == 0 { return a; }
    for i: 0..<s[0].nchecks { if s[0].checks[i].name == name.v { return a; } }
    a.id = s[0].nchecks; s[0].nchecks += 1;
    s[0].checks[a.id] = WmCheck.{name = name.v, command = command.v, seq = seq};
    a.ok = true; return a;
  }
  if a.kind == WM_K_REQUIREMENT {
    if s[0].nreqs >= WM_REQS { return a; }
    text := wm_j_str(s, d, 0, "text");
    if !text.ok || text.v.count == 0 { return a; }
    a.id = s[0].nreqs; s[0].nreqs += 1;
    s[0].reqs[a.id] = WmReq.{text = text.v, seq = seq, changed = seq};
    a.ok = true; return a;
  }
  // WM_K_STATUS
  req := wm_j_int(d, 0, "requirement"); list := jv_get(d, 0, "evidence");
  sb: [16] u8; sn := jv_str(d, jv_get(d, 0, "status"), sb[..]);
  if sn < 0 || req < 0 || req >= s[0].nreqs || jv_kind(d, list) != JV_ARRAY || s[0].nevid + jv_len(d, list) > WM_EVID { return a; }
  status := wm_index(WM_STATUS[..], cast(string) sb[0..<sn]);
  if status < 0 { return a; }
  first := s[0].nevid;
  for i: 0..<jv_len(d, list) {
    e := jv_at(d, list, i);
    eb: [16] u8; en := jv_str(d, jv_get(d, e, "kind"), eb[..]); id := wm_j_int(d, e, "id");
    if en < 0 || id < 0 { return a; }
    kind := wm_index(WM_EVIDENCE[..], cast(string) eb[0..<en]);
    most := ifx kind == WF_RUN then s[0].nruns else ifx kind == WF_FINDING then s[0].nfindings else s[0].nchanges;
    if kind < WF_RUN || id >= most { return a; }
    s[0].evid[first + i] = WmEvid.{kind = kind, id = id};
  }
  s[0].nevid = first + jv_len(d, list);
  s[0].reqs[req].status = status; s[0].reqs[req].first = first; s[0].reqs[req].count = jv_len(d, list); s[0].reqs[req].changed = seq;
  a.id = req; a.ok = true; return a;
}

// Applies a whole log to an empty store: the lines applied, or minus the
// number (from 1) of the first line that was refused. A last line with no
// newline is one a crash cut short: it is not applied and not an error
// (file.coax cuts it off before it appends).
wm_load :: (s: [] WmStore, text: string) -> int {
  at := 0; n := 0;
  while at < text.count {
    end := at;
    while end < text.count && text[end] != 10 { end += 1; }
    if end >= text.count { break; }
    if !wm_apply(s, text[at..<end]).ok { return -(n + 1); }
    n += 1; at = end + 1;
  }
  return n;
}
// The bytes of a log that are whole lines.
wm_whole :: (text: string) -> int {
  n := text.count;
  while n > 0 && text[n - 1] != 10 { n -= 1; }
  return n;
}
