// What a file has that judges code, counted from its text (GitHub #13445
// step 4): its checks (#test and #forall), its #assert, whether it has an
// #authority line, and whether it is a compatibility baseline. file.coax
// counts a file as it was when the run started and as it is now, and
// finish.coax decides from the two whether the run weakened it.
//
// The counts are of the text, not the compiler's: the compiler names a
// file's checks only by running them (`coax test FILE --list`), and a
// baseline text is not a file. So a word is counted where it is written
// outside a comment: a check that is commented out is one check fewer, and
// a "#test" inside a string (a fixture) counts as one. Both sides are
// counted the same way, so only a difference matters.
//
// A compatibility baseline is a surface file: what `coax compat --emit
// MODULE.coax` prints, kept to compare a later module against (`coax compat
// OLD.surface NEW.coax --baseline BASE.surface`, coax/checked-state.md). Its
// first line is "coax.compat.v1". This tree has two, under coax/web/compat/.
// No effects.
#load "finish.coax";

WM_SURFACE :: "coax.compat.v1";          // the first line of a compatibility baseline

// checks: #test and #forall; asserts: #assert; authority: a line that starts
// with #authority; baseline: the text is a compatibility baseline.
WmWeak :: struct { checks: int; asserts: int; authority: bool; baseline: bool; }

wm_weak_ident :: (c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }
// Is word written at `at`, and not as the start of a longer word?
wm_weak_word :: (text: string, at: int, word: string) -> bool {
  if at + word.count > text.count { return false; }
  for c, i: word { if text[at + i] != c { return false; } }
  return at + word.count == text.count || !wm_weak_ident(text[at + word.count]);
}
wm_weak_ends :: (path: string, tail: string) -> bool {
  if path.count < tail.count { return false; }
  for c, i: tail { if path[path.count - tail.count + i] != c { return false; } }
  return true;
}

// What the file at path, with this text, has. Checks, asserts and the
// #authority line are counted in .coax files only; a baseline is known by
// its first line, whatever its name.
wm_weak_of :: (path: string, text: string) -> WmWeak {
  r: WmWeak;
  r.baseline = wm_weak_word(text, 0, WM_SURFACE) && (text.count == WM_SURFACE.count || text[WM_SURFACE.count] == 10 || text[WM_SURFACE.count] == 13);
  if !wm_weak_ends(path, ".coax") { return r; }
  i := 0; depth := 0; quoted := false; margin := true;       // depth: of /* */; margin: only blanks so far on this line
  while i < text.count {
    c := text[i];
    if c == 10 { margin = true; quoted = false; i += 1; continue; }       // a string ends with its line
    if depth > 0 {
      if c == '/' && i + 1 < text.count && text[i + 1] == '*' { depth += 1; i += 2; continue; }
      if c == '*' && i + 1 < text.count && text[i + 1] == '/' { depth -= 1; i += 2; continue; }
      i += 1; continue;
    }
    if quoted {
      if c == '\\' { i += 2; continue; }
      if c == '"' { quoted = false; }
    } else {
      if c == '/' && i + 1 < text.count && text[i + 1] == '/' { while i < text.count && text[i] != 10 { i += 1; } continue; }
      if c == '/' && i + 1 < text.count && text[i + 1] == '*' { depth = 1; i += 2; continue; }
      if c == '\'' && i + 2 < text.count && text[i + 1] != '\\' && text[i + 2] == '\'' { i += 3; margin = false; continue; }      // a character: '"' opens no string
      if c == '"' { quoted = true; }
    }
    if c == '#' {
      if wm_weak_word(text, i, "#test") || wm_weak_word(text, i, "#forall") { r.checks += 1; }
      if wm_weak_word(text, i, "#assert") { r.asserts += 1; }
      if margin && !quoted && wm_weak_word(text, i, "#authority") { r.authority = true; }
    }
    if c != ' ' && c != 9 && c != 13 { margin = false; }
    i += 1;
  }
  return r;
}

// The facts finish.coax judges a file by: what it had when the run started
// (was, of the text then) and what it has now. changed: the two texts differ.
wm_weak_fact :: (was: WmWeak, now: WmWeak, changed: bool) -> WfFile {
  return WfFile.{changed = changed, baseline = was.baseline, was_authority = was.authority, authority = now.authority, was_checks = was.checks, checks = now.checks, was_asserts = was.asserts, asserts = now.asserts};
}

// ---------------------------------------------------------------- checks

#test "a file's checks, asserts and #authority line, counted where they are written outside a comment" {
  t := "// the rule, under #authority and #test\n#authority;\nlimit :: 3;\n#test \"a\" { #assert limit == 3; #assert limit > 2; }\n  #forall \"b\" n: 0..<3 { #assert n < limit; }\n#load \"x-checks.coax\" #test;\n";
  w := wm_weak_of("pay/rule.coax", t);
  #assert w.checks == 3 && w.asserts == 3 && w.authority && !w.baseline;
  // a comment hides what it holds: a line comment, a block comment, a nested one
  w = wm_weak_of("a.coax", "// #test \"gone\" { #assert false; }\n/* #test \"x\" { #assert 1 == 1; }\n /* #authority; */\n#authority;\n#forall */ #test \"kept\" { #assert true; }\n");
  #assert w.checks == 1 && w.asserts == 1 && !w.authority;
  // #authority counts only at the start of a line (blanks before it allowed), and only as the whole word
  #assert wm_weak_of("a.coax", "  \t#authority;\n").authority && wm_weak_of("a.coax", "#authority").authority && wm_weak_of("a.coax", "x :: 1;\r\n#authority;\r\n").authority;
  #assert !wm_weak_of("a.coax", "x :: 1; #authority;\n").authority && !wm_weak_of("a.coax", "#authority_of :: 1;\n").authority;
  // a longer word is not the word
  w = wm_weak_of("a.coax", "#tests #test_only #asserts #forall_x #testing\n#test;\n#assert\n");
  #assert w.checks == 1 && w.asserts == 1;
  // a string: "//" inside it starts no comment; a word inside it counts (a fixture's check); a quote character opens no string
  w = wm_weak_of("a.coax", "u := \"http://x\"; #test \"t\" { #assert u.count > 0; }\nf := \"#test \\\"in\\\" { #assert 1; }\";\nq := '\"'; // #test \"no\"\n#assert q == 34;\n");
  #assert w.checks == 2 && w.asserts == 3;
  // an escaped quote does not end the string, and a string ends with its line at the latest
  w = wm_weak_of("a.coax", "s := \"a\\\"b // not a comment\"; #assert s.count == 3;\nopen := \"never closed\n// #assert hidden\n#assert seen;\n");
  #assert w.asserts == 2;
  // nothing is counted in a file that is not Coax; an empty file has nothing
  w = wm_weak_of("notes.md", t);
  #assert w.checks == 0 && w.asserts == 0 && !w.authority && !w.baseline;
  w = wm_weak_of("a.coax", "");
  #assert w.checks == 0 && w.asserts == 0 && !w.authority && !w.baseline;
  w = wm_weak_of("a.coax", "#");
  #assert w.checks == 0 && w.asserts == 0;
}

#test "a compatibility baseline is known by its first line" {
  #assert wm_weak_of("coax/web/compat/everglade-wire.surface", "coax.compat.v1\n0\t\teverglade-wire.coax::WirePins\t0\n").baseline;
  #assert wm_weak_of("anything.txt", "coax.compat.v1").baseline && wm_weak_of("a.coax", "coax.compat.v1\r\n").baseline;
  #assert !wm_weak_of("x.surface", "coax.compat.v2\n").baseline && !wm_weak_of("x.surface", "coax.compat.v10\n").baseline && !wm_weak_of("x.surface", "\ncoax.compat.v1\n").baseline;
  #assert !wm_weak_of("x.surface", "").baseline && !wm_weak_of("x.surface", "coax.compat.v1 and more\n").baseline && !wm_weak_of("x.surface", "coax.compat").baseline;
}

#test "the facts of one file: then and now, for the rule" {
  was := wm_weak_of("a.coax", "#authority;\n#test \"a\" { #assert 1 == 1; }\n#test \"b\" { #assert 2 == 2; }\n");
  now := wm_weak_of("a.coax", "#test \"a\" { #assert 1 == 1; }\n");
  f := wm_weak_fact(was, now, true);
  #assert f.changed && !f.baseline && f.was_authority && !f.authority && f.was_checks == 2 && f.checks == 1 && f.was_asserts == 2 && f.asserts == 1;
  #assert wf_file_why(f) == WF_WEAK_AUTHORITY;
  f = wm_weak_fact(now, was, true);
  #assert !f.was_authority && f.authority && f.was_checks == 1 && f.checks == 2 && wf_file_why(f) == 0;
  f = wm_weak_fact(wm_weak_of("x.surface", "coax.compat.v1\n1\n"), wm_weak_of("x.surface", ""), true);
  #assert f.baseline && wf_file_why(f) == WF_WEAK_BASELINE;
  #assert !wm_weak_fact(was, now, false).changed && wf_file_why(wm_weak_fact(was, now, false)) == 0;
  #assert wm_weak_ends("a.coax", ".coax") && !wm_weak_ends("coax", ".coax") && !wm_weak_ends("a.coax.md", ".coax") && wm_weak_ends(".coax", ".coax");
}
