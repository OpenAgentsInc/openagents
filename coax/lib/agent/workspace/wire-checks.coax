#load "../../json/fixture-checks.coax" #test;
WS_REQUEST_GOLDEN :: "{\"schema\":\"openagents.environment.workspace.v1\",\"method\":\"CreatePullRequest\",\"workspace\":\"default\",\"branch\":\"feature/native\",\"base\":\"main\",\"title\":\"Native controls\",\"body\":\"Line one\\nLine two\",\"number\":12,\"page\":0,\"cursor\":0,\"expected\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"command\":\"00000000000000000000000000000001\",\"issued_at\":1700000000000,\"expires_at\":1700000120000}";
WS_VIEW_GOLDEN :: "{\"schema\":\"openagents.environment.workspace.v1\",\"host\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"method\":\"CreatePullRequest\",\"command\":\"00000000000000000000000000000001\",\"workspace\":\"default\",\"revision\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"path\":\"/tmp/fixture space\",\"repository\":\"example/repo\",\"page\":2,\"cursor\":0,\"next\":8,\"diff_cut\":true,\"branch\":\"feature/native\",\"status\":\" M file.coax\",\"diff\":\"diff --git a/file b/file\\n+change\",\"error\":\"stale_state\",\"github_error\":\"github_unavailable\",\"worktrees\":[{\"id\":\"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\"path\":\"/tmp/fixture space\",\"branch\":\"main\",\"locked\":false}],\"branches\":[\"main\",\"feature/native\"],\"pull_requests\":[{\"number\":12,\"title\":\"Title\",\"url\":\"https://github.com/a/b/pull/12\",\"head\":\"feature/native\",\"base\":\"main\",\"body\":\"Body\\nSecond\",\"state\":\"OPEN\"}]}";
#test "workspace goldens preserve every scalar, row and byte; all fields are mandatory and typed" {
 q:[1]WsRequest;v:[1]WsView;out:[1048577]u8;buf:[1048577]u8;#assert ws_read(WS_REQUEST_GOLDEN,q[..]);
 #assert q[0].nm==17 && cast(string)q[0].method[0..<q[0].nm]=="CreatePullRequest" && q[0].nw==7 && q[0].nb==14 && q[0].na==4 && q[0].nt==15 && q[0].nd==17 && q[0].number==12 && q[0].nx==64 && q[0].nc==32 && q[0].issued==1700000000000 && q[0].expires==1700000120000;
 n:=ws_write(q[..],out[..]);#assert n==WS_REQUEST_GOLDEN.count && cast(string)out[0..<n]==WS_REQUEST_GOLDEN && ws_write(q[..],out[0..<n-1])== -1;
 #assert ws_view_read(WS_VIEW_GOLDEN,v[..]);size:=ws_view_write(v[..],out[..]);#assert size==WS_VIEW_GOLDEN.count && cast(string)out[0..<size]==WS_VIEW_GOLDEN && ws_view_write(v[..],out[0..<size-1])== -1;
 for key:[14]string.["schema","method","workspace","branch","base","title","body","number","expected","command","issued_at","expires_at","page","cursor"] {for bad:[4]string.["","null","[]","{}"] {#assert !ws_read(jf_replace(WS_REQUEST_GOLDEN,key,bad,buf[..]),q[..]);}}
 for key:[20]string.["schema","host","method","command","workspace","revision","branch","status","diff","error","github_error","worktrees","branches","pull_requests","path","page","cursor","next","diff_cut","repository"] {for j:0..<4 {bad:=ifx j==0 then "" else ifx j==1 then "null" else ifx j==3 then "{}" else ifx key=="worktrees" || key=="branches" || key=="pull_requests" then "123" else "[]";#assert !ws_view_read(jf_replace(WS_VIEW_GOLDEN,key,bad,buf[..]),v[..]);}}
 for key:[8]string.["method","workspace","branch","base","title","body","expected","command"] {long:[4097]u8;for i:0..<long.count {long[i]='a';}quoted:[8200]u8;cap:=ifx key=="method" || key=="command" then 32 else ifx key=="workspace" || key=="expected" then 64 else ifx key=="branch" || key=="base" then 160 else ifx key=="title" then 256 else 4096;#assert !ws_read(jf_replace(WS_REQUEST_GOLDEN,key,jf_quote(cast(string)long[0..<cap+1],quoted[..]),buf[..]),q[..]);}
 for key:[10]string.["host","method","command","workspace","revision","branch","status","diff","error","github_error"] {long:[32769]u8;for i:0..<long.count {long[i]='a';}quoted:[65540]u8;cap:=ifx key=="method" || key=="command" then 32 else ifx key=="host" || key=="workspace" || key=="revision" then 64 else ifx key=="branch" then 160 else ifx key=="status" then 16384 else ifx key=="diff" then 32768 else 40;#assert !ws_view_read(jf_replace(WS_VIEW_GOLDEN,key,jf_quote(cast(string)long[0..<cap+1],quoted[..]),buf[..]),v[..]);}
 // Whitespace is legal JSON and makes exact transport-limit cases reachable.
 #assert ws_read(WS_REQUEST_GOLDEN,q[..]);for i:0..<24577 {out[i]=' ';}for c,i:WS_REQUEST_GOLDEN {out[i]=c;}#assert ws_read(cast(string)out[0..<24576],q[..]) && !ws_read(cast(string)out[0..<24577],q[..]);
 for i:0..<out.count {out[i]=' ';}for c,i:WS_VIEW_GOLDEN {out[i]=c;}#assert ws_view_read(cast(string)out[0..<1048576],v[..]) && !ws_view_read(cast(string)out[..],v[..]);
}
#test "workspace validity separates every method and exact command freshness bounds" {
 q:[1]WsRequest;#assert ws_read(WS_REQUEST_GOLDEN,q[..]);copy:=q[0];
 for method:[7]string.["CreateBranch","SwitchBranch","CreateWorktree","RemoveWorktree","PushBranch","CreatePullRequest","EditPullRequest"] {q[0]=copy;q[0].nm=js_copy(q[0].method[..],method);#assert ws_valid(q[..]);q[0].nc=0;#assert !ws_valid(q[..]);q[0]=copy;q[0].nm=js_copy(q[0].method[..],method);q[0].nx=0;#assert !ws_valid(q[..]);}
 for time:[5]int.[0,-1,1700000000000,1700000120001,1700000120002] {q[0]=copy;q[0].expires=time;#assert !ws_valid(q[..]);}q[0]=copy;q[0].expires=q[0].issued+1;#assert ws_valid(q[..]);q[0].issued=0;#assert !ws_valid(q[..]);
 for number:[4]int.[-1,0,2147483647,2147483648] {q[0]=copy;q[0].number=number;#assert ws_valid(q[..])==(number>=0 && number<=2147483647);q[0].nm=js_copy(q[0].method[..],"EditPullRequest");#assert ws_valid(q[..])==(number>0 && number<=2147483647);}
 for method:[4]string.["CreateBranch","SwitchBranch","CreateWorktree","CreatePullRequest"] {q[0]=copy;q[0].nm=js_copy(q[0].method[..],method);q[0].nb=0;#assert ws_valid(q[..])==(method=="CreatePullRequest");q[0]=copy;q[0].nm=js_copy(q[0].method[..],method);q[0].na=0;#assert ws_valid(q[..])==(method=="SwitchBranch");}
 q[0]=copy;q[0].nt=0;#assert !ws_valid(q[..]);q[0]=copy;q[0].title[0]=10;#assert !ws_valid(q[..]);q[0]=copy;q[0].body[0]=0;#assert !ws_valid(q[..]);
}
ws_fixture_array :: (element:string,count:int,out:[]u8)->string {o:[1]Jo;jo_start(o[..],out);jo_arr(o[..]);for i:0..<count {jo_raw(o[..],element);}jo_end(o[..]);#assert !o[0].bad;return jo_text(o[..]);}
#forall "workspace text accepts printable valid UTF8 and only declared multiline controls" byte:0..<256 {b:=[1]u8.[cast(u8)byte];#assert ws_text(cast(string)b[..],false)==(byte>=32 && byte<127);#assert ws_text(cast(string)b[..],true)==(byte>=32 && byte<127 || byte==9 || byte==10);}
#test "workspace reader and writer preserve every page boundary and selected identity" {
 q:[1]WsRequest;#assert ws_read(WS_REQUEST_GOLDEN,q[..]);for page:[6]int.[-1,0,1,2,3,4] {q[0].page=page;#assert ws_valid(q[..])==(page>=0 && page<=3);}q[0].page=0;for cursor:[4]int.[-1,0,10000,10001] {q[0].cursor=cursor;#assert ws_valid(q[..])==(cursor>=0 && cursor<=10000);}
 b:[1048577]u8;part:[131072]u8;row:[16384]u8;nodes:[128]JvNode;d:[1]Jv;#assert jv_parse(d[..],WS_VIEW_GOLDEN,nodes[..]);v:[1]WsView;
 for kind:0..<3 {key:=ifx kind==0 then "worktrees" else ifx kind==1 then "branches" else "pull_requests";cap:=ifx kind==0 then 8 else ifx kind==1 then 16 else 3;element:=ifx kind==1 then "\"main\"" else jv_raw(d[0],jv_at(d[0],jv_get(d[0],0,key),0));for count:[3]int.[0,cap,cap+1] {array:=ws_fixture_array(element,count,part[..]);ok:=ws_view_read(jf_replace(WS_VIEW_GOLDEN,key,array,b[..]),v[..]);#assert ok==(count<=cap);if ok {#assert (ifx kind==0 then v[0].nt else ifx kind==1 then v[0].nbra else v[0].np)==count;}}}
 tree:=jv_raw(d[0],jv_at(d[0],jv_get(d[0],0,"worktrees"),0));for key:[4]string.["id","path","branch","locked"] {for bad:[3]string.["","null","123"] {changed:=jf_replace(tree,key,bad,row[..]);array:=ws_fixture_array(changed,1,part[..]);#assert !ws_view_read(jf_replace(WS_VIEW_GOLDEN,"worktrees",array,b[..]),v[..]);}}
 pr:=jv_raw(d[0],jv_at(d[0],jv_get(d[0],0,"pull_requests"),0));for key:[7]string.["number","title","url","head","base","body","state"] {for bad:[3]string.["","null","[]"] {changed:=jf_replace(pr,key,bad,row[..]);array:=ws_fixture_array(changed,1,part[..]);#assert !ws_view_read(jf_replace(WS_VIEW_GOLDEN,"pull_requests",array,b[..]),v[..]);}}
 array:=ws_fixture_array("\"\"",1,part[..]);#assert !ws_view_read(jf_replace(WS_VIEW_GOLDEN,"branches",array,b[..]),v[..]);
 #assert !ws_view_read(jf_replace(WS_VIEW_GOLDEN,"method","\"RunShell\"",b[..]),v[..]);#assert !ws_view_read(jf_replace(WS_VIEW_GOLDEN,"host","\"zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\"",b[..]),v[..]);
 for key:[3]string.["page","cursor","next"] {for bad:[2]string.["-1","10001"] {#assert !ws_view_read(jf_replace(WS_VIEW_GOLDEN,key,bad,b[..]),v[..]);}}
}
#test "read-only workspace calls cannot smuggle mutation fields and aliases are not authorities" {
 q:[1]WsRequest;q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");q[0].nw=js_copy(q[0].workspace[..],"default");raw:[24576]u8;n:=ws_write(q[..],raw[..]);temp:[24576]u8;
 for key:[9]string.["branch","base","title","body","number","expected","command","issued_at","expires_at"] {bad:=ifx key=="number" || key=="issued_at" || key=="expires_at" then "1" else "\"x\"";#assert !ws_read(jf_replace(cast(string)raw[0..<n],key,bad,temp[..]),q[..]);}
 q[0].nm=js_copy(q[0].method[..],"RunShell");#assert !ws_valid(q[..]);long:[161]u8;for i:0..<161 {long[i]='a';}#assert ws_branch(cast(string)long[0..<160]) && !ws_branch(cast(string)long[..]);v:[1]WsView;ws_fail(v[..],"");#assert v[0].ne==0;
}
#test "workspace semantic boundaries distinguish malformed identity from a valid opaque worktree" {
 q:[1]WsRequest;#assert ws_read(WS_REQUEST_GOLDEN,q[..]);q[0].nw=js_copy(q[0].workspace[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");#assert ws_valid(q[..]);q[0].nw=js_copy(q[0].workspace[..],"unknown");#assert !ws_valid(q[..]);q[0].nw=js_copy(q[0].workspace[..],"default");q[0].nm=js_copy(q[0].method[..],"RunShell");#assert !ws_valid(q[..]);#assert ws_read(WS_REQUEST_GOLDEN,q[..]);q[0].issued=0;q[0].expires=1;#assert !ws_valid(q[..]);q[0].issued=1;q[0].expires=2;#assert ws_valid(q[..]);q[0].nw=0;#assert ws_write(q[..],q[0].body[..])== -1;
 v:[1]WsView;b:[1048576]u8;tmp:[1048576]u8;for key:[3]string.["page","cursor","next"] {value:=ifx key=="page" then "3" else "10000";#assert ws_view_read(jf_replace(WS_VIEW_GOLDEN,key,value,b[..]),v[..]);}
 nodes:[128]JvNode;d:[1]Jv;#assert jv_parse(d[..],WS_VIEW_GOLDEN,nodes[..]);tree:=jv_raw(d[0],jv_at(d[0],jv_get(d[0],0,"worktrees"),0));row:[16384]u8;array:[131072]u8;changed:=jf_replace(tree,"path","\"/\"",row[..]);list:=ws_fixture_array(changed,1,array[..]);#assert ws_view_read(jf_replace(WS_VIEW_GOLDEN,"worktrees",list,b[..]),v[..]) && v[0].trees[0].np==1;
 list=ws_fixture_array("\"a\"",1,array[..]);#assert ws_view_read(jf_replace(WS_VIEW_GOLDEN,"branches",list,b[..]),v[..]) && v[0].branches[0].n==1;
 pr:=jv_raw(d[0],jv_at(d[0],jv_get(d[0],0,"pull_requests"),0));changed=jf_replace(pr,"number","1",row[..]);list=ws_fixture_array(changed,1,array[..]);#assert ws_view_read(jf_replace(WS_VIEW_GOLDEN,"pull_requests",list,b[..]),v[..]) && v[0].prs[0].number==1;
 changed=jf_replace(pr,"number","0",row[..]);list=ws_fixture_array(changed,1,array[..]);#assert !ws_view_read(jf_replace(WS_VIEW_GOLDEN,"pull_requests",list,b[..]),v[..]);
 changed=jf_replace(pr,"title","\"\"",row[..]);list=ws_fixture_array(changed,1,array[..]);#assert ws_view_read(jf_replace(WS_VIEW_GOLDEN,"pull_requests",list,b[..]),v[..]) && v[0].prs[0].nt==0;
 // A correlated refusal can have empty optional presentation fields.
 #assert ws_view_read(jf_replace(WS_VIEW_GOLDEN,"method","\"ReadWorkspace\"",b[..]),v[..]);v[0].nw=0;n:=ws_view_write(v[..],tmp[..]);#assert n>0 && ws_view_read(cast(string)tmp[0..<n],v[..]) && v[0].nw==0;
}
#test "workspace response rejects a fourth page kind and unknown nested PR fields" {
 v:[1]WsView;b:[1048576]u8;#assert !ws_view_read(jf_replace(WS_VIEW_GOLDEN,"page","4",b[..]),v[..]);nodes:[128]JvNode;d:[1]Jv;#assert jv_parse(d[..],WS_VIEW_GOLDEN,nodes[..]);pr:=jv_raw(d[0],jv_at(d[0],jv_get(d[0],0,"pull_requests"),0));row:[16384]u8;array:[131072]u8;changed:=jf_replace(pr,"title","\"Title\",\"unexpected\":true",row[..]);list:=ws_fixture_array(changed,1,array[..]);#assert !ws_view_read(jf_replace(WS_VIEW_GOLDEN,"pull_requests",list,b[..]),v[..]);
}
