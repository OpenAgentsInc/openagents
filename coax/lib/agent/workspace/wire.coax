// Direct repository controls above the existing HOST carriage, never prompts.
#load "../../json/shape.coax";
#load "../../json/json.coax";
#load "../environment/policy.coax";
#load "../../repo/rules.coax";
#authority;
WS_SCHEMA :: "openagents.environment.workspace.v1";
WsRequest :: struct {method:[32]u8;nm:int;workspace:[64]u8;nw:int;branch:[160]u8;nb:int;base:[160]u8;na:int;title:[256]u8;nt:int;body:[4096]u8;nd:int;number:int;page:int;cursor:int;expected:[64]u8;nx:int;command:[32]u8;nc:int;issued:int;expires:int;}
WsTree :: struct {id:[64]u8;path:[1024]u8;np:int;branch:[160]u8;nb:int;locked:bool;}
WsBranch :: struct {name:[160]u8;n:int;}
WsPr :: struct {number:int;title:[256]u8;nt:int;url:[512]u8;nu:int;head:[160]u8;nh:int;base:[160]u8;nb:int;body:[4096]u8;nd:int;state:[16]u8;ns:int;}
WsView :: struct {host:[64]u8;method:[32]u8;nm:int;command:[32]u8;nc:int;workspace:[64]u8;nw:int;revision:[64]u8;nx:int;path:[1024]u8;npath:int;repository:[200]u8;nr:int;page:int;cursor:int;next:int;diff_cut:bool;selected_locked:bool;branch:[160]u8;nb:int;status:[16384]u8;ns:int;diff:[32768]u8;nd:int;error:[40]u8;ne:int;github:[40]u8;ng:int;trees:[8]WsTree;nt:int;branches:[16]WsBranch;nbra:int;prs:[3]WsPr;np:int;}
#test "workspace methods are closed; branch arguments cannot become options or revision expressions" {
 #assert ws_right("ReadWorkspace")==0;for m:[7]string.["CreateBranch","SwitchBranch","CreateWorktree","RemoveWorktree","PushBranch","CreatePullRequest","EditPullRequest"] {#assert ws_right(m)==1;}
 #assert ws_right("RunShell")== -1 && ws_right("")== -1;
 for b:[7]string.["main","feature/chat","a-b","A_B","release/v1.2","a","0"] {#assert ws_branch(b);}
 for b:[15]string.["","-x","a..b","a@{b","a:b","a b","a\nb","a~","a^","a?","a*","a[","a\\b","/main","main/"] {#assert !ws_branch(b);}
}
ws_right :: (method:string)->int #effects(all) {if method=="ReadWorkspace" {return 0;}for m:[7]string.["CreateBranch","SwitchBranch","CreateWorktree","RemoveWorktree","PushBranch","CreatePullRequest","EditPullRequest"] {if method==m {return 1;}}return -1;}
ws_branch :: (b:string)->bool #effects(all) {return b.count<=160 && rp_ref_ok(b); }
ws_text :: (s:string,multi:bool)->bool #effects(all) {if !js_utf8(s) {return false;}for c:s {if c==127 || c<32 && !(multi && (c==10 || c==9)) {return false;}}return true;}
ws_valid :: (q:[]WsRequest)->bool #effects(all) {
 m:=cast(string)q[0].method[0..<q[0].nm];right:=ws_right(m);workspace:=cast(string)q[0].workspace[0..<q[0].nw];if right<0 || !(workspace=="default" || ea_id(workspace,64)) {return false;}
 if q[0].page<0 || q[0].page>3 || q[0].cursor<0 || q[0].cursor>10000 {return false;}
 if q[0].number<0 || q[0].number>2147483647 || !ws_text(cast(string)q[0].title[0..<q[0].nt],false) || !ws_text(cast(string)q[0].body[0..<q[0].nd],true) {return false;}
 if right==0 {return q[0].nc==0 && q[0].nx==0 && q[0].nb==0 && q[0].na==0 && q[0].nt==0 && q[0].nd==0 && q[0].number==0 && q[0].issued==0 && q[0].expires==0;}
 if !ea_id(cast(string)q[0].command[0..<q[0].nc],32) || !ea_id(cast(string)q[0].expected[0..<q[0].nx],64) || q[0].issued<=0 || q[0].expires<=q[0].issued || q[0].expires-q[0].issued>120000 {return false;}
 if m=="CreateBranch" || m=="SwitchBranch" || m=="CreateWorktree" {if !ws_branch(cast(string)q[0].branch[0..<q[0].nb]) {return false;}}
 if m=="CreateBranch" || m=="CreateWorktree" || m=="CreatePullRequest" {if !ws_branch(cast(string)q[0].base[0..<q[0].na]) {return false;}}
 if m=="CreatePullRequest" || m=="EditPullRequest" {if q[0].nt==0 {return false;}if m=="EditPullRequest" && q[0].number==0 {return false;}}return true;
}
ws_read :: (raw:string,q:[]WsRequest)->bool #export_c #effects(all) {
 nodes:[32]JvNode;d:[1]Jv;if raw.count>24576 || !jv_parse(d[..],raw,nodes[..]) {return false;}v:=d[0];f:=[14]string.["schema","method","workspace","branch","base","title","body","number","expected","command","issued_at","expires_at","page","cursor"];
 if !js_fields(v,0,f[..]) || jv_raw(v,jv_get(v,0,"schema"))!=WS_SCHEMA {return false;}
 next:[1]WsRequest;next[0].nm=js_string(v,jv_get(v,0,"method"),next[0].method[..]);next[0].nw=js_string(v,jv_get(v,0,"workspace"),next[0].workspace[..]);next[0].nb=js_string(v,jv_get(v,0,"branch"),next[0].branch[..]);next[0].na=js_string(v,jv_get(v,0,"base"),next[0].base[..]);next[0].nt=js_string(v,jv_get(v,0,"title"),next[0].title[..]);next[0].nd=js_string(v,jv_get(v,0,"body"),next[0].body[..]);next[0].nx=js_string(v,jv_get(v,0,"expected"),next[0].expected[..]);next[0].nc=js_string(v,jv_get(v,0,"command"),next[0].command[..]);next[0].page=js_number(v,jv_get(v,0,"page"));next[0].cursor=js_number(v,jv_get(v,0,"cursor"));next[0].number=js_number(v,jv_get(v,0,"number"));next[0].issued=js_number(v,jv_get(v,0,"issued_at"));next[0].expires=js_number(v,jv_get(v,0,"expires_at"));
 if next[0].nm<0 || // mutant: equivalent — tightening this boundary to zero/one only rejects names already refused by the closed method set
 next[0].nw<0 || // mutant: equivalent — empty/one-byte values cannot be default or a 64-hex workspace and are independently refused by ws_valid
 next[0].nb<0 || next[0].na<0 || next[0].nt<0 || next[0].nd<0 || next[0].nx<0 || next[0].nc<0 || next[0].issued<0 || next[0].expires<0 || !ws_valid(next[..]) {return false;}q[0]=next[0];return true;
}
ws_write :: (q:[]WsRequest,out:[]u8)->int #export_c #effects(all) {if !ws_valid(q) {return -1;}o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],WS_SCHEMA);jo_key(o[..],"method");jo_str(o[..],cast(string)q[0].method[0..<q[0].nm]);jo_key(o[..],"workspace");jo_str(o[..],cast(string)q[0].workspace[0..<q[0].nw]);jo_key(o[..],"branch");jo_str(o[..],cast(string)q[0].branch[0..<q[0].nb]);jo_key(o[..],"base");jo_str(o[..],cast(string)q[0].base[0..<q[0].na]);jo_key(o[..],"title");jo_str(o[..],cast(string)q[0].title[0..<q[0].nt]);jo_key(o[..],"body");jo_str(o[..],cast(string)q[0].body[0..<q[0].nd]);jo_key(o[..],"number");jo_int(o[..],q[0].number);jo_key(o[..],"page");jo_int(o[..],q[0].page);jo_key(o[..],"cursor");jo_int(o[..],q[0].cursor);jo_key(o[..],"expected");jo_str(o[..],cast(string)q[0].expected[0..<q[0].nx]);jo_key(o[..],"command");jo_str(o[..],cast(string)q[0].command[0..<q[0].nc]);jo_key(o[..],"issued_at");jo_int(o[..],q[0].issued);jo_key(o[..],"expires_at");jo_int(o[..],q[0].expires);jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;}
ws_fail :: (v:[]WsView,error:string) #effects(all) {v[0].ne=js_copy(v[0].error[..],error);}

ws_view_write :: (v:[]WsView,out:[]u8)->int #export_c #effects(all) {o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],WS_SCHEMA);
jo_key(o[..],"host");jo_str(o[..],cast(string)v[0].host[..]);
jo_key(o[..],"method");jo_str(o[..],cast(string)v[0].method[0..<v[0].nm]);
jo_key(o[..],"command");jo_str(o[..],cast(string)v[0].command[0..<v[0].nc]);
jo_key(o[..],"workspace");jo_str(o[..],cast(string)v[0].workspace[0..<v[0].nw]);
jo_key(o[..],"revision");jo_str(o[..],cast(string)v[0].revision[0..<v[0].nx]);jo_key(o[..],"path");jo_str(o[..],cast(string)v[0].path[0..<v[0].npath]);jo_key(o[..],"repository");jo_str(o[..],cast(string)v[0].repository[0..<v[0].nr]);jo_key(o[..],"page");jo_int(o[..],v[0].page);jo_key(o[..],"cursor");jo_int(o[..],v[0].cursor);jo_key(o[..],"next");jo_int(o[..],v[0].next);jo_key(o[..],"diff_cut");jo_bool(o[..],v[0].diff_cut);
jo_key(o[..],"branch");jo_str(o[..],cast(string)v[0].branch[0..<v[0].nb]);
jo_key(o[..],"status");jo_str(o[..],cast(string)v[0].status[0..<v[0].ns]);
jo_key(o[..],"diff");jo_str(o[..],cast(string)v[0].diff[0..<v[0].nd]);
jo_key(o[..],"error");jo_str(o[..],cast(string)v[0].error[0..<v[0].ne]);
jo_key(o[..],"github_error");jo_str(o[..],cast(string)v[0].github[0..<v[0].ng]);
jo_key(o[..],"worktrees");jo_arr(o[..]);for i:0..<v[0].nt {r:=v[0].trees[i];jo_obj(o[..]);jo_key(o[..],"id");jo_str(o[..],cast(string)r.id[..]);jo_key(o[..],"path");jo_str(o[..],cast(string)r.path[0..<r.np]);jo_key(o[..],"branch");jo_str(o[..],cast(string)r.branch[0..<r.nb]);jo_key(o[..],"locked");jo_bool(o[..],r.locked);jo_end(o[..]);}jo_end(o[..]);jo_key(o[..],"branches");jo_arr(o[..]);for i:0..<v[0].nbra {jo_str(o[..],cast(string)v[0].branches[i].name[0..<v[0].branches[i].n]);}jo_end(o[..]);jo_key(o[..],"pull_requests");jo_arr(o[..]);for i:0..<v[0].np {r:=v[0].prs[i];jo_obj(o[..]);jo_key(o[..],"number");jo_int(o[..],r.number);jo_key(o[..],"title");jo_str(o[..],cast(string)r.title[0..<r.nt]);jo_key(o[..],"url");jo_str(o[..],cast(string)r.url[0..<r.nu]);jo_key(o[..],"head");jo_str(o[..],cast(string)r.head[0..<r.nh]);jo_key(o[..],"base");jo_str(o[..],cast(string)r.base[0..<r.nb]);jo_key(o[..],"body");jo_str(o[..],cast(string)r.body[0..<r.nd]);jo_key(o[..],"state");jo_str(o[..],cast(string)r.state[0..<r.ns]);jo_end(o[..]);}jo_end(o[..]);jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;}
ws_view_read :: (raw:string,v:[]WsView)->bool #export_c #effects(all) {nodes:[2048]JvNode;d:[1]Jv;if raw.count>1048576 || !jv_parse(d[..],raw,nodes[..]) {return false;}j:=d[0];f:=[20]string.["schema","host","method","command","workspace","revision","branch","status","diff","error","github_error","worktrees","branches","pull_requests","path","page","cursor","next","diff_cut","repository"];if !js_fields(j,0,f[..]) || jv_raw(j,jv_get(j,0,"schema"))!=WS_SCHEMA {return false;}next:[1]WsView;next[0].nr=js_string(j,jv_get(j,0,"repository"),next[0].repository[..]);if next[0].nr<0 {return false;}next[0].npath=js_string(j,jv_get(j,0,"path"),next[0].path[..]);next[0].page=js_number(j,jv_get(j,0,"page"));next[0].cursor=js_number(j,jv_get(j,0,"cursor"));next[0].next=js_number(j,jv_get(j,0,"next"));cut:=jv_kind(j,jv_get(j,0,"diff_cut"));if next[0].npath<0 || next[0].page<0 || next[0].page>3 || next[0].cursor<0 || next[0].cursor>10000 || next[0].next<0 || next[0].next>10000 || cut!=JV_TRUE && cut!=JV_FALSE {return false;}next[0].diff_cut=cut==JV_TRUE;
if js_string(j,jv_get(j,0,"host"),next[0].host[..])!=64 || !ea_id(cast(string)next[0].host[..],64) {return false;}
next[0].nm=js_string(j,jv_get(j,0,"method"),next[0].method[..]);if next[0].nm<0 {return false;} // mutant: equivalent — empty/one-byte names are independently refused by ws_right below
next[0].nc=js_string(j,jv_get(j,0,"command"),next[0].command[..]);if next[0].nc<0 {return false;}
next[0].nw=js_string(j,jv_get(j,0,"workspace"),next[0].workspace[..]);if next[0].nw<0 {return false;}
next[0].nx=js_string(j,jv_get(j,0,"revision"),next[0].revision[..]);if next[0].nx<0 {return false;}
next[0].nb=js_string(j,jv_get(j,0,"branch"),next[0].branch[..]);if next[0].nb<0 {return false;}
next[0].ns=js_string(j,jv_get(j,0,"status"),next[0].status[..]);if next[0].ns<0 {return false;}
next[0].nd=js_string(j,jv_get(j,0,"diff"),next[0].diff[..]);if next[0].nd<0 {return false;}
next[0].ne=js_string(j,jv_get(j,0,"error"),next[0].error[..]);if next[0].ne<0 {return false;}
next[0].ng=js_string(j,jv_get(j,0,"github_error"),next[0].github[..]);if next[0].ng<0 {return false;}
if ws_right(cast(string)next[0].method[0..<next[0].nm])<0 || next[0].nc!=0 && !ea_id(cast(string)next[0].command[0..<next[0].nc],32) {return false;}
trees:=jv_get(j,0,"worktrees");branches:=jv_get(j,0,"branches");prs:=jv_get(j,0,"pull_requests");if jv_kind(j,trees)!=JV_ARRAY || jv_len(j,trees)>8 || jv_kind(j,branches)!=JV_ARRAY || jv_len(j,branches)>16 || jv_kind(j,prs)!=JV_ARRAY || jv_len(j,prs)>3 {return false;}next[0].nt=jv_len(j,trees);next[0].nbra=jv_len(j,branches);next[0].np=jv_len(j,prs);
for i:0..<next[0].nt {r:=next[0].trees[i..<i+1];node:=jv_at(j,trees,i);keys:=[4]string.["id","path","branch","locked"];if !js_fields(j,node,keys[..]) || js_string(j,jv_get(j,node,"id"),r[0].id[..])!=64 {return false;}r[0].np=js_string(j,jv_get(j,node,"path"),r[0].path[..]);r[0].nb=js_string(j,jv_get(j,node,"branch"),r[0].branch[..]);if r[0].np<1 || r[0].nb<0 || (jv_kind(j,jv_get(j,node,"locked"))!=JV_TRUE && jv_kind(j,jv_get(j,node,"locked"))!=JV_FALSE) {return false;}r[0].locked=jv_bool(j,jv_get(j,node,"locked"));}
for i:0..<next[0].nbra {r:=next[0].branches[i..<i+1];r[0].n=js_string(j,jv_at(j,branches,i),r[0].name[..]);if r[0].n<1 {return false;}}
for i:0..<next[0].np {r:=next[0].prs[i..<i+1];node:=jv_at(j,prs,i);keys:=[7]string.["number","title","url","head","base","body","state"];if !js_fields(j,node,keys[..]) {return false;}r[0].number=js_number(j,jv_get(j,node,"number"));if r[0].number<1 {return false;}r[0].nt=js_string(j,jv_get(j,node,"title"),r[0].title[..]);if r[0].nt<0 {return false;}r[0].nu=js_string(j,jv_get(j,node,"url"),r[0].url[..]);if r[0].nu<0 {return false;}r[0].nh=js_string(j,jv_get(j,node,"head"),r[0].head[..]);if r[0].nh<0 {return false;}r[0].nb=js_string(j,jv_get(j,node,"base"),r[0].base[..]);if r[0].nb<0 {return false;}r[0].nd=js_string(j,jv_get(j,node,"body"),r[0].body[..]);if r[0].nd<0 {return false;}r[0].ns=js_string(j,jv_get(j,node,"state"),r[0].state[..]);if r[0].ns<0 {return false;}}v[0]=next[0];return true;}
#test "workspace request and view roundtrip with exact identities; malformed/truncated packets refuse" {
 q:[1]WsRequest;q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");q[0].nw=js_copy(q[0].workspace[..],"default");raw:[24576]u8;n:=ws_write(q[..],raw[..]);r:[1]WsRequest;#assert n>0 && ws_read(cast(string)raw[0..<n],r[..]) && r[0].nw==7;for i:0..<n {#assert !ws_read(cast(string)raw[0..<i],r[..]);}
 v:[1]WsView;ws_fail(v[..],"stale_state");#assert v[0].ne==11;v[0].ne=0;_=js_copy(v[0].host[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");v[0].method=q[0].method;v[0].nm=q[0].nm;v[0].workspace=q[0].workspace;v[0].nw=q[0].nw;v[0].nt=1;v[0].trees[0].id=v[0].host;v[0].trees[0].np=js_copy(v[0].trees[0].path[..],"/tmp/repo");v[0].trees[0].locked=true;v[0].nbra=1;v[0].branches[0].n=js_copy(v[0].branches[0].name[..],"main");v[0].np=1;v[0].prs[0].number=12;v[0].prs[0].nt=js_copy(v[0].prs[0].title[..],"Fix chat");b:[1048576]u8;size:=ws_view_write(v[..],b[..]);read:[1]WsView;#assert size>0 && ws_view_read(cast(string)b[0..<size],read[..]) && read[0].nt==1 && read[0].trees[0].locked && read[0].prs[0].number==12;
 #assert !ws_view_read("{}",read[..]) && !ws_read("{}",r[..]) && ws_write(q[..],raw[0..<2])<0;
}

#load "wire-checks.coax" #test;
