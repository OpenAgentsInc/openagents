  chain=CHAIN_MAIN, magic=[4]u8.[0xf9, 0xbe, 0xb4, 0xd9], port=8333,
  pubkey_prefix=0, script_prefix=5, secret_prefix=128, xpub=0x0488b21e, xprv=0x0488ade4,
  hrp="bc", network=SW_MAINNET,
