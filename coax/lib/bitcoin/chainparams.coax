CHAIN_TESTNET3_PARAMS :: ChainParams.{
  chain=CHAIN_TESTNET3, magic=[4]u8.[0x0b, 0x11, 0x09, 0x07], port=18333,
  pubkey_prefix=111, script_prefix=196, secret_prefix=239, xpub=0x043587cf, xprv=0x04358394,
