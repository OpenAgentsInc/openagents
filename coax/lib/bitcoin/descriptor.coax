  #assert dst_gives(dst_fill("sh(wsh(pkh(%)))", b[..]), SW_MAINNET, 0, 0, 0, "a914b61b92e2ca21bac1e72a3ab859a742982bea960a87");
}

#test "single keys: where each kind of key is refused" #steps 2000000000 {
  b: [400] u8;
  #assert dst_refuses(dst_fill("pk(?)", b[..]), DS_PRIVATE_KEY);
  #assert dst_refuses(dst_fill("pk(|/0)", b[..]), DS_PRIVATE_KEY);
  #assert dst_refuses(dst_fill("wpkh(&)", b[..]), DS_UNCOMPRESSED);
  #assert dst_refuses(dst_fill("wsh(pk(&))", b[..]), DS_UNCOMPRESSED);
  #assert dst_refuses(dst_fill("sh(wpkh(&))", b[..]), DS_UNCOMPRESSED);
  #assert dst_refuses(dst_fill("tr(&)", b[..]), DS_UNCOMPRESSED);
  #assert dst_refuses("pk(07a34b99f22c790c4e36b2b3c2c35a36db06226e41c692fc82b8b56ac1c540c5bd5b8dec5235a0fa8722476c7709c02559e3aa73aa03918ba2d492eea75abea235)", DS_BAD_KEY);
  #assert dst_refuses("pk(03a34b99f22c790c4e36b2b3c2c35a36db06226e41c692fc82b8b56ac1c540c5)", DS_BAD_KEY);
  #assert dst_refuses(dst_fill("pk(~)", b[..]), DS_BAD_KEY);      // x-only only in tr()
  #assert dst_refuses(dst_fill("pk(%/0)", b[..]), DS_BAD_KEY);    // a hex key has no path
  #assert dst_refuses(dst_fill("pk(?/0)", b[..]), DS_BAD_KEY);  // nor does a WIF
  #assert dst_refuses(dst_fill("pk( %)", b[..]), DS_BAD_KEY) && dst_refuses("pk()", DS_BAD_KEY);
  #assert dst_refuses(dst_fill("pk(pk(%))", b[..]), DS_BAD_KEY);
  #assert dst_refuses(dst_fill("sh(%)", b[..]), DS_UNKNOWN_FUNCTION);
  #assert dst_refuses(dst_fill("sh(sh(pkh(%)))", b[..]), DS_CONTEXT);
  #assert dst_refuses(dst_fill("wsh(wpkh(%))", b[..]), DS_CONTEXT);
  #assert dst_refuses(dst_fill("wsh(wsh(pkh(%)))", b[..]), DS_CONTEXT);
  #assert dst_refuses(dst_fill("sh(combo(%))", b[..]), DS_CONTEXT);
  #assert dst_refuses(dst_fill("wsh(tr(~))", b[..]), DS_CONTEXT);
  #assert dst_refuses(dst_fill("tr(~,pk(%))", b[..]), DS_TAPROOT_TREE);
  // Origins.
  #assert dst_refuses(dst_fill("pkh(deadbeef/1]%)", b[..]), DS_BAD_ORIGIN);
  #assert dst_refuses(dst_fill("pkh([deadbeef]/1/2'/3/4']%)", b[..]), DS_BAD_ORIGIN);
  #assert dst_refuses(dst_fill("pkh([deadbef/0h]%)", b[..]), DS_BAD_ORIGIN);
  #assert dst_refuses(dst_fill("pkh([deadbeeef]%)", b[..]), DS_BAD_ORIGIN);
  #assert dst_refuses(dst_fill("pkh([gaaaaaaa]%)", b[..]), DS_BAD_ORIGIN);
  #assert dst_refuses(dst_fill("pkh([deadbeef/0H]%)", b[..]), DS_BAD_STEP);
  #assert dst_refuses(dst_fill("pkh([deadbeef/0h/]%)", b[..]), DS_BAD_STEP);
  #assert dst_refuses(dst_fill("pkh([deadbeef/0h/*]%)", b[..]), DS_BAD_STEP);
  #assert dst_refuses(dst_fill("pkh([deadbeef/<0;1>]%)", b[..]), DS_MULTIPATH);
  #assert dst_refuses("pkh([deadbeef])", DS_BAD_KEY);
}

