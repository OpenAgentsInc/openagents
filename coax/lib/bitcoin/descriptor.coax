  b: [400] u8;
  #assert dst_gives(dst_fill("pk(%)", b[..]), SW_MAINNET, 0, 0, 0, "2103a34b99f22c790c4e36b2b3c2c35a36db06226e41c692fc82b8b56ac1c540c5bdac");
