#test "capacity refusals" #steps 4000000000 {
  b: [132] u8; f: [9] bool; ids := [2] int.[0, 1];
  s := FrSigners.{n=3, t=2, ids=ids[..], thresh_pk=b[0..<33]};
  #assert fr_tweaks_vartime(b[0..<33], b[0..<31], f[0..<0]).code == FR_CAPACITY;
  #assert fr_tweaks_vartime(b[0..<33], b[0..<32], f[0..<2]).code == FR_TWEAK_LISTS;
  #assert fr_tweaks_vartime(b[0..<33], b[0..<0], f[0..<9]).code == FR_CAPACITY;
  #assert fr_taproot_tweak_vartime(b[0..<33], b[0..<1], b[0..<32]) == FR_CAPACITY;
  #assert fr_taproot_tweak_vartime(b[0..<33], b[0..<0], b[0..<32]) == FR_THRESH_PK;
  #assert fr_validate_info_vartime(1, b[0..<33], b[0..<32], f[0..<1]).code == FR_CAPACITY;
  s.has_pubshares = true; s.pubshares = b[0..<32];
  #assert fr_validate_signers_vartime(s).code == FR_CAPACITY;
  s.pubshares = b[0..<33];
  #assert fr_validate_signers_vartime(s).code == FR_PUBSHARE_LISTS;
  x: FrSession; mw: [1] MsSignWork; dw: [1] FrDetWork;
  #assert fr_session_vartime(s, b[0..<66], b[0..<0], f[0..<0], b[0..<0]).code == FR_PUBSHARE_LISTS;
  s.has_pubshares = false;
  #assert fr_session_vartime(s, b[0..<65], b[0..<0], f[0..<0], b[0..<0]).code == FR_THRESH_PK;
  #assert fr_sign(b[0..<63], b[0..<32], 0, s, b[0..<66], b[0..<0], f[0..<0], b[0..<0], b[0..<32], mw[..]).code == FR_CAPACITY;
  #assert fr_partial_verify_vartime(b[0..<32], b[0..<132], s, b[0..<0], f[0..<0], b[0..<0], 0).code == FR_CAPACITY;
  #assert fr_partial_verify_session_vartime(b[0..<31], 0, b[0..<66], b[0..<33], x, ids[..]).code == FR_INVALID;
  #assert fr_partial_agg_vartime(b[0..<64], x, 2, b[0..<64]).code == FR_OK || true;
  x.code = FR_CAPACITY;
  #assert fr_partial_agg_vartime(b[0..<64], x, 2, b[0..<64]).code == FR_CAPACITY;
  x.code = FR_OK;
  #assert fr_partial_agg_vartime(b[0..<63], x, 2, b[0..<64]).code == FR_CAPACITY;
  #assert fr_partial_agg_vartime(b[0..<32], x, 2, b[0..<64]).code == FR_PSIG_LISTS;
  #assert fr_det_sign(b[0..<32], 0, b[0..<66], true, s, b[0..<0], f[0..<0], b[0..<0], b[0..<0], false, b[0..<65], b[0..<32], dw[..]).code == FR_CAPACITY;
  #assert fr_combine(b[0..<31], ids[..], b[0..<32]) == false;
  #assert sc_equal(fr_scalar(-1), sc_negate(sc_small(1))) && sc_equal(fr_scalar(5), sc_small(5));
  #assert fr_position(ids[..], 1) == 1 && fr_position(ids[..], 2) == -1;
}
// A 2-of-3 from the trusted dealer: any two signers make a signature
// under the Taproot output key of the threshold key; one alone refuses.
fr_test_session :: (secshares: [] u8, pubshares: [] u8, thresh_pk: [] u8, ids: [] int, tweaks: [] u8, xonly: [] bool, msg: [] u8, sig: [] u8) -> int {
  u := ids.count;
  ps: [99] u8; pub: [198] u8; sec: [192] u8; psigs: [96] u8; agg: [66] u8; rand: [32] u8; q: [32] u8;
  for i: 0..<u { for j: 0..<33 { ps[33*i+j] = pubshares[33*ids[i]+j]; } }
  s := FrSigners.{n=3, t=2, ids=ids, pubshares=ps[0..<33*u], has_pubshares=true, thresh_pk=thresh_pk};
  ms_xbytes_vartime(fr_tweaks_vartime(thresh_pk, tweaks, xonly).q, q[..]);
  nw: [1] MsNonceWork; sw: [1] MsSignWork;
  for i: 0..<u {
    for j: 0..<32 { rand[j] = cast(u8) (ids[i] + 40); }
    #assert fr_nonce_gen(rand[..], secshares[32*ids[i]..<32*ids[i]+32], ids[i], ps[33*i..<33*i+33], q[..], msg, true, rand[0..<0], sec[64*i..<64*i+64], pub[66*i..<66*i+66], nw[..]) == FR_OK;
  }
  #assert fr_nonce_agg_vartime(pub[0..<66*u], agg[..]).code == FR_OK;
  for i: 0..<u {
    r := fr_sign(sec[64*i..<64*i+64], secshares[32*ids[i]..<32*ids[i]+32], ids[i], s, agg[..], tweaks, xonly, msg, psigs[32*i..<32*i+32], sw[..]);
    if r.code != FR_OK { return r.code; }
    #assert fr_partial_verify_vartime(psigs[32*i..<32*i+32], pub[0..<66*u], s, tweaks, xonly, msg, i).code == FR_OK;
  }
  return fr_partial_agg_vartime(psigs[0..<32*u], fr_session_vartime(s, agg[..], tweaks, xonly, msg), u, sig).code;
}
#test "a 2-of-3 from the trusted dealer signs a Taproot key path" #steps 8000000000 {
  secret: [32] u8; tp: [33] u8; sec: [96] u8; pub: [99] u8; w: [1] FrDealWork;
  for j: 0..<32 { secret[j] = cast(u8) (j + 1); }
  #assert fr_dealer(secret[..], 3, 2, tp[..], sec[..], pub[..], w[..]) == FR_OK;
  #assert ec_nonzero(w[0].c[0]) == 0 && ec_nonzero(w[0].c[1]) == 0;
  #assert fr_dealer(secret[0..<31], 3, 2, tp[..], sec[..], pub[..], w[..]) == FR_CAPACITY;
  zero: [32] u8;
  #assert fr_dealer(zero[..], 3, 2, tp[..], sec[..], pub[..], w[..]) == FR_SECSHARE;
  present := [3] bool.[true, true, true];
  #assert fr_validate_info_vartime(2, tp[..], pub[..], present[..]).code == FR_OK;
  // Any two shares give the secret back; the shares are Shamir's.
  pairs := [6] int.[0, 1, 1, 2, 0, 2];
  for p: 0..<3 {
    two: [64] u8; out: [32] u8;
    for j: 0..<32 { two[j] = sec[32*pairs[2*p]+j]; two[32+j] = sec[32*pairs[2*p+1]+j]; }
    #assert fr_combine(two[..], pairs[2*p..<2*p+2], out[..]) && bt_same(out[..], secret[..]);
  }
  // The Taproot tweak of the threshold key, and a key-path signature.
  t: [32] u8; internal: [32] u8; out: [32] u8; msg: [32] u8; sig: [64] u8; xf := [1] bool.[true];
  #assert fr_taproot_tweak_vartime(tp[..], t[0..<0], t[..]) == FR_OK;
  for j: 0..<32 { internal[j] = tp[1 + j]; msg[j] = cast(u8) (7 * j); }
  #assert taproot_output_key_vartime(internal[..], t[0..<0], out[..]) >= 0;
  ids := [2] int.[2, 0];
  #assert fr_test_session(sec[..], pub[..], tp[..], ids[..], t[..], xf[..], msg[..], sig[..]) == FR_OK;
  #assert taproot_key_path_verify_vartime(out[..], sig[..], msg[..]);
  // One signer is fewer than t: the session refuses.
  #assert fr_test_session(sec[..], pub[..], tp[..], ids[0..<1], t[..], xf[..], msg[..], sig[..]) == FR_SIGNER_COUNT;
}
// Round 1 of a 2-of-3 DKG for the checks: three participants with seeds
// 5, 8, 11, ... deal under the context "chapter 102 DKG".
fr_test_dkg :: (ctx: [] u8, commits: [] u8, pops: [] u8, shares: [] u8) {
  seeds: [96] u8; w: [1] FrDkgWork;
  for i: 0..<96 { seeds[i] = cast(u8) ((3 * i + 5) & 255); }
  for i: 0..<3 {
    #assert fr_dkg_round1(seeds[32*i..<32*i+32], i, 3, 2, ctx, commits[66*i..<66*i+66], pops[64*i..<64*i+64], shares[96*i..<96*i+96], w[..]) == FR_OK;
  }
  #assert fr_dkg_round1(seeds[0..<31], 0, 3, 2, ctx, commits[0..<66], pops[0..<64], shares[0..<96], w[..]) == FR_CAPACITY;
}
#forall "a 2-of-3 Pedersen DKG: every receiver checks every sender" i: 0..<3 #steps 8000000000 {
  cx: [16] u8; ctx := ms_hex("636861707465722031303220444b47", cx[..]);
  commits: [198] u8; pops: [192] u8; shares: [288] u8;
  fr_test_dkg(ctx, commits[..], pops[..], shares[..]);
  for j: 0..<3 {
    #assert fr_dkg_check_vartime(commits[66*i..<66*i+66], pops[64*i..<64*i+64], ctx, i, shares[96*i+32*j..<96*i+32*j+32], j) == FR_OK;
  }
}
#test "a 2-of-3 Pedersen DKG: a proof for another index or a changed share refuses" #steps 8000000000 {
  cx: [16] u8; ctx := ms_hex("636861707465722031303220444b47", cx[..]);
  commits: [198] u8; pops: [192] u8; shares: [288] u8;
  fr_test_dkg(ctx, commits[..], pops[..], shares[..]);
  #assert fr_dkg_check_vartime(commits[0..<66], pops[0..<64], ctx, 1, shares[0..<32], 0) == FR_DKG_POP;
  bad: [32] u8;
  for j: 0..<32 { bad[j] = shares[j]; } bad[31] ^= 1;
  #assert fr_dkg_check_vartime(commits[0..<66], pops[0..<64], ctx, 0, bad[..], 0) == FR_DKG_SHARE;
  #assert fr_dkg_check_vartime(commits[0..<65], pops[0..<64], ctx, 0, shares[0..<32], 0) == FR_CAPACITY;
}
#test "a 2-of-3 Pedersen DKG: everyone agrees on the key, and two sign" #steps 8000000000 {
  cx: [16] u8; ctx := ms_hex("636861707465722031303220444b47", cx[..]);
  commits: [198] u8; pops: [192] u8; shares: [288] u8;
  fr_test_dkg(ctx, commits[..], pops[..], shares[..]);
  sec: [96] u8; tp: [99] u8; pub: [297] u8; got: [96] u8;
  for j: 0..<3 {
    for i: 0..<3 { for k: 0..<32 { got[32*i+k] = shares[96*i+32*j+k]; } }
    #assert fr_dkg_finish(got[..], commits[..], 3, 2, sec[32*j..<32*j+32], tp[33*j..<33*j+33], pub[99*j..<99*j+99]) == FR_OK;
  }
  #assert bt_same(tp[0..<33], tp[33..<66]) && bt_same(tp[0..<33], tp[66..<99]);
  #assert bt_same(pub[0..<99], pub[99..<198]) && bt_same(pub[0..<99], pub[198..<297]);
  #assert fr_dkg_finish(got[0..<95], commits[..], 3, 2, sec[0..<32], tp[0..<33], pub[0..<99]) == FR_CAPACITY;
  present := [3] bool.[true, true, true];
  #assert fr_validate_info_vartime(2, tp[0..<33], pub[0..<99], present[..]).code == FR_OK;
  ids := [2] int.[1, 2]; msg: [32] u8; sig: [64] u8; q: [32] u8; f: [1] bool;
  #assert fr_test_session(sec[..], pub[0..<99], tp[0..<33], ids[..], msg[0..<0], f[0..<0], msg[..], sig[..]) == FR_OK;
  for j: 0..<32 { q[j] = tp[1 + j]; }
  #assert schnorr_verify_vartime(msg[..], q[..], sig[..]);
}
