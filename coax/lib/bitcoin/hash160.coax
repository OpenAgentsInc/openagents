// HASH160: RIPEMD-160 of the SHA-256 of the input. Bitcoin uses it for
// P2PKH and P2WPKH key hashes, P2SH script hashes and the BIP-32 key
// fingerprint (Bitcoin chapter 6). Inputs are public keys and scripts.
#load "../crypto/sha256.coax";
#load "../crypto/ripemd160.coax";
#authority;

#test "BIP-32 test vector 1: the master key's HASH160 starts with its fingerprint" {
  // The key inside vector 1's master xpub and the parent fingerprint inside
  // the m/0H xpub, both from the pinned
  // coax/tests/vectors/upstream/bip32/bip-0032.mediawiki.
  key := [33] u8.[0x03, 0x39, 0xa3, 0x60, 0x13, 0x30, 0x15, 0x97, 0xda, 0xef, 0x41, 0xfb, 0xe5, 0x93, 0xa0, 0x2c, 0xc5,
    0x13, 0xd0, 0xb5, 0x55, 0x27, 0xec, 0x2d, 0xf1, 0x05, 0x0e, 0x2e, 0x8f, 0xf4, 0x9c, 0x85, 0xc2];
  out: [20] u8; hex: [40] u8;
  #assert hash160_checked(key[..], out[..], false) == RMD_OK;
  #assert R_hex(out[..], hex[..]) && cast(string) hex[..] == "3442193e1bb70916e914552172cd4e2dbc9df811";
  #assert out[0] == 0x34 && out[1] == 0x42 && out[2] == 0x19 && out[3] == 0x3e;
}
#test "HASH160 of nothing, and refusals before any write" {
  empty: [1] u8; out: [21] u8; hex: [40] u8;
  for i: 0..<21 { out[i] = 165; }
  #assert hash160_checked(empty[0..<0], out[0..<19], false) == RMD_BAD_OUTPUT;
  #assert hash160_checked(empty[0..<0], out[..], true) == RMD_ALIAS;
  for i: 0..<21 { #assert out[i] == 165; }
  // python3 -c 'import hashlib;print(hashlib.new("ripemd160",hashlib.sha256(b"").digest()).hexdigest())'
  #assert hash160_checked(empty[0..<0], out[0..<20], false) == RMD_OK && out[20] == 165;
  #assert R_hex(out[0..<20], hex[..]) && cast(string) hex[..] == "b472a266d0bd89c13706a4132ccfb16f7c3b9fcb";
}

// book:begin hash160
// HASH160(x) = RIPEMD160(SHA256(x)). The checks run before either hash, so
// a refusal writes nothing.
hash160_checked :: (input: [] u8, out: [] u8, overlap: bool) -> u32 #export_c {
  status := ripemd160_request(input.count, out.count, overlap);
  if status != RMD_OK { return status; }
  inner: [32] u8;
  if sha256_hash_checked(input, inner[..], false) != SHA_OK { return RMD_BAD_INPUT; }
  return ripemd160_hash_checked(inner[..], out, false);
}
// book:end hash160
