// Public-data extent and shape predicates for the light explorer profile.
// These are tracking/admission boundaries, not full consensus validation.
#load "lightstore.coax";
#authority;

#test "light policy: body, index and child-height boundaries" {
  #assert !lc_body_extent(80) && lc_body_extent(81) && lc_body_extent(4000000) && !lc_body_extent(4000001);
  #assert !lc_index_extent(-1, 1) && lc_index_extent(0, 1) && !lc_index_extent(1, 1);
  #assert lc_index_extent(1, 2) && !lc_index_extent(0, 0);
  #assert lc_child_context(1, 0, 0) && !lc_child_context(1, -1, 0);
  #assert !lc_child_context(0, 0, -1) && !lc_child_context(2, 0, 0);
  #assert lc_child_context(2147483647, 0, 2147483646) && !lc_child_context(2147483648, 0, 2147483647);
}
#forall "light policy: basic transaction shape is an explicit truth table" cb: 0..<2, first: 0..<2, nin: 0..<3, nout: 0..<3 {
  expected := cb == first && nin != 0 && nout != 0;
  #assert lc_tx_shape(cb == 1, first == 1, nin, nout) == expected;
}
#test "light policy: money and weight edges" {
  #assert !lc_amount_ok(-1) && lc_amount_ok(0) && lc_amount_ok(2100000000000000) && !lc_amount_ok(2100000000000001);
  #assert lc_weight_check(3999999) == LC_OK && lc_weight_check(4000000) == LC_OK && lc_weight_check(4000001) == LC_BLOCK;
}
#test "light policy: empty, return and maximum-size scripts" {
  script: [10001] u8; script[0] = 0x51;
  #assert !lc_unspendable(script[0..<0]) && !lc_unspendable(script[0..<1]);
  #assert !lc_unspendable(script[0..<10000]) && lc_unspendable(script[..]);
  script[0] = 0x6a; #assert lc_unspendable(script[0..<1]);
}

lc_body_extent :: (n: int) -> bool { return n >= 81 && n <= 4000000; }
lc_index_extent :: (index: int, count: int) -> bool { return index >= 0 && index < count; }
lc_child_context :: (height: int, prev: int, parent_height: int) -> bool {
  return height >= 1 && height <= 2147483647 && prev >= 0 && height == parent_height + 1;
}
lc_tx_shape :: (coinbase: bool, first: bool, inputs: int, outputs: int) -> bool {
  return coinbase == first && inputs >= 1 && outputs >= 1;
}
lc_amount_ok :: (amount: int) -> bool { return amount >= 0 && amount <= 2100000000000000; }
lc_weight_check :: (weight: int) -> int { return ifx weight <= 4000000 then LC_OK else LC_BLOCK; }
lc_unspendable :: (script: [] u8) -> bool {
  return script.count > LC_SCRIPT_MAX || (script.count != 0 && script[0] == 0x6a);
}
