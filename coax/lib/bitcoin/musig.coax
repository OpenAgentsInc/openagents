  #assert msv_det_sign(6, 8) == 2;
}
#test "BIP-327 det_sign_vectors, cases 9 to 9" #steps 8000000000 {
  #assert msv_det_sign(8, 9) == 1;
}
#test "DeterministicSign refuses a secret key of 0" #steps 8000000000 {
  w: [1] MsDetWork; b: [66] u8; f: [1] bool;
  #assert ms_det_sign(b[0..<32], b[..], b[0..<33], b[0..<0], f[0..<0], b[0..<0], b[0..<1], b[..], b[0..<32], w[..]).code == MS_CAPACITY;
  // A secret key of 0 refuses before it signs.
  c := MS_DET_SIGN[0];
  o: [66] u8; k: [256] u8; m: [64] u8; pub: [66] u8; psig: [32] u8; zero: [32] u8;
  #assert ms_det_sign(zero[..], ms_hex(c.aggother, o[..]), ms_hex(c.keys, k[..]), b[0..<0], f[0..<0], ms_hex(c.msg, m[..]), b[0..<0], pub[..], psig[..], w[..]).code == MS_SECKEY;
}
#test "BIP-327 sig_agg_vectors: each a valid BIP-340 signature" #steps 8000000000 {
  #assert msv_sig_agg() == MS_SIG_AGG.count;
  x: MsSession; sig: [64] u8;
  #assert ms_partial_agg_vartime(sig[0..<31], x, sig[..]).code == MS_CAPACITY;
}
// Signer i's secret key, made from small numbers, and its public key.
ms_test_key :: (i: int, sk: [] u8, pk: [] u8) {
  for j: 0..<32 { sk[j] = cast(u8) (17 * (i + 1) + j); }
  w: [1] SignPoint;
  ms_nonce_point(sc_load(sk).value, w[..], pk);
}
#test "a 2-of-2 MuSig2 Taproot key-path signature" #steps 8000000000 {
  sk: [64] u8; keys: [66] u8;
  for i: 0..<2 { ms_test_key(i, sk[32*i..<32*i+32], keys[33*i..<33*i+33]); }
  // The aggregate key as a Taproot internal key with no script tree:
  // tweaked by MuSig2's x-only tweak, it is chapter 41's output key.
  t: [32] u8; internal: [32] u8; out: [32] u8; q: [32] u8; f := [1] bool.[true];
  #assert ms_taproot_tweak_vartime(keys[..], keys[0..<0], t[..]) == MS_OK;
  #assert ms_taproot_tweak_vartime(keys[..], keys[0..<1], t[..]) == MS_CAPACITY;
  #assert ms_taproot_tweak_vartime(keys[0..<32], keys[0..<0], t[..]) == MS_CAPACITY;
  ms_xbytes_vartime(ms_key_agg_vartime(keys[..]).q, internal[..]);
  #assert taproot_output_key_vartime(internal[..], t[0..<0], out[..]) >= 0;
  ms_xbytes_vartime(ms_key_agg_tweak_vartime(keys[..], t[..], f[..]).q, q[..]);
  #assert bt_same(q[..], out[..]);
  // Nonces, partial signatures, each checked, and the signature.
  msg: [32] u8; rand: [32] u8; sec: [194] u8; pub: [132] u8; agg: [66] u8; psigs: [64] u8; sig: [64] u8;
  nw: [1] MsNonceWork; sw: [1] MsSignWork;
  for j: 0..<32 { msg[j] = cast(u8) j; }
  for i: 0..<2 {
    for j: 0..<32 { rand[j] = cast(u8) (i + 1); }
    #assert ms_nonce_gen(rand[..], sk[32*i..<32*i+32], keys[33*i..<33*i+33], q[..], msg[..], true, rand[0..<0], sec[97*i..<97*i+97], pub[66*i..<66*i+66], nw[..]) == MS_OK;
  }
  #assert ms_nonce_agg_vartime(pub[..], agg[..]).code == MS_OK;
  for i: 0..<2 {
    #assert ms_sign(sec[97*i..<97*i+97], sk[32*i..<32*i+32], agg[..], keys[..], t[..], f[..], msg[..], psigs[32*i..<32*i+32], sw[..]).code == MS_OK;
    #assert ms_partial_verify_vartime(psigs[32*i..<32*i+32], pub[..], keys[..], t[..], f[..], msg[..], i).code == MS_OK;
    #assert ms_partial_verify_vartime(psigs[32*i..<32*i+32], pub[..], keys[..], t[..], f[..], msg[..], 1 - i).code == MS_INVALID;
  }
  x := ms_session_vartime(agg[..], keys[..], t[..], f[..], msg[..]);
  #assert ms_partial_agg_vartime(psigs[..], x, sig[..]).code == MS_OK;
  #assert taproot_key_path_verify_vartime(out[..], sig[..], msg[..]);
  sig[63] ^= 1;
  #assert !taproot_key_path_verify_vartime(out[..], sig[..], msg[..]);
}
