  #assert msv_det_sign(0, 2) == 2;
}
#test "BIP-327 det_sign_vectors, cases 3 to 4" #steps 8000000000 {
  #assert msv_det_sign(2, 4) == 2;
}
#test "BIP-327 det_sign_vectors, cases 5 to 6" #steps 8000000000 {
  #assert msv_det_sign(4, 6) == 2;
}
