// Derivation paths (Bitcoin chapter 33): path strings such as
// m/84'/0'/0'/0/5, the BIP-44 family of standard paths, and the address
// each one gives.
//
// - path_step_vartime: one step, "5", "84'" or "84h", as a BIP-32 index.
// - path_parse_vartime and path_format_vartime: a path string to its list
//   of indexes and back.
// - path_purpose_kind and path_standard_vartime: BIP-44, BIP-49, BIP-84
//   and BIP-86, purpose / coin type / account / change / address index,
//   and the output type each purpose gives.
// - path_script_vartime: the scriptPubKey a purpose gives a public key.
// - path_derive_ct: a seed and a path string to a node (chapter 32).
// - path_account_script_ct: a scriptPubKey from an account node, private
//   or watch-only.
//
// Paths, indexes and public keys are public, so the path procedures branch
// and index on them. The seed and private nodes go only through chapter
// 32's constant-time procedures, which leave their work buffer as zeros.
// Each procedure returns a count or one negative DP_* refusal, and a
// refusal writes nothing.
#load "../crypto/bip32.coax";
#load "address.coax";
#authority;

// book:begin codes
DP_MAX_DEPTH :: 255;          // a node's depth is one byte, so a path has at most 255 steps
DP_ACCOUNT_DEPTH :: 3;        // m / purpose' / coin_type' / account'

// Refusals.
DP_NO_ROOT :: -1;             // a path that isn't "m" or doesn't start with "m/"
DP_EMPTY_STEP :: -2;          // an empty step: "m/", "m//0" or "m/0/"
DP_BAD_STEP :: -3;            // a step that isn't digits and an optional h or ': "0H", "+1", "1a"
DP_OVERFLOW :: -4;            // a step of 2^31 or more before its marker, or an index past 2^32 - 1
DP_TOO_DEEP :: -5;            // more than 255 steps
DP_CAPACITY :: -6;            // an output buffer that is too small
DP_BAD_PURPOSE :: -7;         // a purpose other than 44, 49, 84 or 86
DP_BAD_FIELD :: -8;           // an account or address index of 2^31 or more, or a change other than 0 or 1
DP_BAD_NETWORK :: -9;         // a network outside 1-3
DP_NOT_ACCOUNT :: -10;        // a node that isn't at depth 3 under a hardened index
// Refusals from the chapters underneath keep their codes, offset:
DP_BIP32 :: -20;              // plus chapter 32's BIP32_* code: -21 to -30
DP_ADDRESS :: -40;            // plus chapter 29's AD_* code: -41 to -48
// book:end codes

// ---- path strings

// book:begin step
// One step: decimal digits, then h or ' for a hardened step. The number
// must be below 2^31 either way; a hardened step adds 2^31 to it. Returns
// the BIP-32 index or a refusal. Leading zeros are allowed, as Bitcoin
// Core allows them.
path_step_vartime :: (step: string) -> int #export_c {
  if step.count == 0 { return DP_EMPTY_STEP; }
  n := step.count;
  last := step[n - 1];
  hardened := last == 'h' || last == '\'';
  if hardened { n -= 1; }
  if n == 0 { return DP_BAD_STEP; }
  for i: 0..<n { if step[i] < '0' || step[i] > '9' { return DP_BAD_STEP; } }
  value := 0;
  for i: 0..<n {
    value = value * 10 + cast(int) (step[i] - '0');
    if value >= BIP32_HARDENED { return DP_OVERFLOW; }   // stops before a long run of digits can overflow
  }
  return ifx hardened then value + BIP32_HARDENED else value;
}
// book:end step

// book:begin parse
// A path string, "m" then zero to 255 steps each after a "/", into
// indexes. Returns the number of steps or a refusal, and writes indexes
// only on success.
path_parse_vartime :: (text: string, indexes: [] int) -> int #export_c {
  if text.count == 0 || text[0] != 'm' { return DP_NO_ROOT; }
  if text.count == 1 { return 0; }
  if text[1] != '/' { return DP_NO_ROOT; }
  found: [DP_MAX_DEPTH] int;
  count := 0; start := 2;
  for i: 2..<text.count + 1 {
    if i == text.count || text[i] == '/' {
      index := path_step_vartime(text[start..<i]);
      if index < 0 { return index; }
      if count == DP_MAX_DEPTH { return DP_TOO_DEEP; }
      found[count] = index; count += 1; start = i + 1;
    }
  }
  if indexes.count < count { return DP_CAPACITY; }
  for k: 0..<count { indexes[k] = found[k]; }
  return count;
}
// book:end parse

// book:begin format
// A list of indexes as a path string, with marker ('h' or '\'') after each
// hardened step. Returns the text's length or a refusal.
path_format_vartime :: (indexes: [] int, marker: u8, out: [] u8) -> int #export_c {
  if marker != 'h' && marker != '\'' { return DP_BAD_STEP; }
  if indexes.count > DP_MAX_DEPTH { return DP_TOO_DEEP; }
  text: [DP_MAX_DEPTH * 12 + 1] u8;   // "/", 10 digits and a marker per step
  text[0] = 'm'; n := 1;
  for index: indexes {
    if index < 0 || index > 4294967295 { return DP_OVERFLOW; }
    value := ifx index >= BIP32_HARDENED then index - BIP32_HARDENED else index;
    digits: [10] u8; d := 0;
    while true {
      digits[d] = cast(u8) ('0' + value % 10); d += 1; value /= 10;
      if value == 0 { break; }
    }
    text[n] = '/'; n += 1;
    while d > 0 { d -= 1; text[n] = digits[d]; n += 1; }
    if index >= BIP32_HARDENED { text[n] = marker; n += 1; }
  }
  if out.count < n { return DP_CAPACITY; }
  for k: 0..<n { out[k] = text[k]; }
  return n;
}
// book:end format

// ---- the standard paths

// book:begin standard
// The output type a BIP-43 purpose gives: BIP-44 is P2PKH, BIP-49 is
// P2SH-P2WPKH (a P2SH output), BIP-84 is P2WPKH and BIP-86 is key-path
// P2TR. Returns chapter 29's AD_* kind or DP_BAD_PURPOSE.
path_purpose_kind :: (purpose: int) -> int #export_c {
  if purpose == 44 { return AD_P2PKH; }
  if purpose == 49 { return AD_P2SH; }
  if purpose == 84 { return AD_P2WPKH; }
  if purpose == 86 { return AD_P2TR; }
  return DP_BAD_PURPOSE;
}
// m / purpose' / coin_type' / account' / change / address_index into
// indexes[0..<5]. The coin type is 0 on mainnet and 1 on every test
// network (SLIP-44). Change is 0 for receiving and 1 for change.
path_standard_vartime :: (purpose: int, network: int, account: int, change: int, index: int, indexes: [] int) -> int #export_c {
  if path_purpose_kind(purpose) < 0 { return DP_BAD_PURPOSE; }
  if network < SW_MAINNET || network > SW_REGTEST { return DP_BAD_NETWORK; }
  if account < 0 || account >= BIP32_HARDENED || change < 0 || change > 1 { return DP_BAD_FIELD; }
  if index < 0 || index >= BIP32_HARDENED { return DP_BAD_FIELD; }
  if indexes.count < 5 { return DP_CAPACITY; }
  indexes[0] = purpose + BIP32_HARDENED;
  indexes[1] = (ifx network == SW_MAINNET then 0 else 1) + BIP32_HARDENED;
  indexes[2] = account + BIP32_HARDENED;
  indexes[3] = change;
  indexes[4] = index;
  return 5;
}
// book:end standard

// book:begin script
// The scriptPubKey a purpose gives a 33-byte compressed public key. BIP-86
// uses the key's x coordinate as the Taproot internal key.
path_script_vartime :: (purpose: int, key: [] u8, out: [] u8) -> int #export_c {
  kind := path_purpose_kind(purpose);
  if kind < 0 { return kind; }
  if key.count != SE_COMPRESSED { return DP_ADDRESS + AD_BAD_KEY; }
  n: int;
  if kind == AD_P2PKH { n = p2pkh_script_vartime(key, out); }
  else if kind == AD_P2SH { n = p2sh_p2wpkh_script_vartime(key, out); }
  else if kind == AD_P2WPKH { n = p2wpkh_script_vartime(key, out); }
  else { n = p2tr_script_vartime(key[1..<SE_COMPRESSED], out); }
  return ifx n < 0 then DP_ADDRESS + n else n;
}
// book:end script

// ---- from a seed and from an account

// book:begin derive
// The node at a path string below a seed's master, into node: an xprv, or
// a tprv for the test networks. Returns 78 or a refusal, and writes node
// only on success. work (BIP32_WORK_BYTES) comes back as zeros.
path_derive_ct :: (seed: [] u8, testnet: bool, text: string, work: [] u8, node: [] u8) -> int #export_c {
  indexes: [DP_MAX_DEPTH] int;
  n := path_parse_vartime(text, indexes[..]);
  if n < 0 { return n; }
  if node.count < BIP32_NODE_BYTES { return DP_CAPACITY; }
  here: [BIP32_NODE_BYTES] u8;
  r := bip32_master_ct(seed, testnet, work, here[..]);
  if r > 0 { r = bip32_descend_ct(here[..], indexes[0..<n], work, here[..]); }
  if r > 0 { for j: 0..<BIP32_NODE_BYTES { node[j] = here[j]; } }
  for j: 0..<BIP32_NODE_BYTES { here[j] = 0; }
  return ifx r < 0 then DP_BIP32 + r else r;
}
// The scriptPubKey of change / index below an account node, for a purpose.
// The account node may be private or public: a watch-only wallet holds
// only the account's xpub and makes the same scripts. Both steps are
// normal, so CKDpub can take them. work comes back as zeros.
path_account_script_ct :: (purpose: int, account: [] u8, change: int, index: int, work: [] u8, out: [] u8) -> int #export_c {
  if path_purpose_kind(purpose) < 0 { return DP_BAD_PURPOSE; }
  if change < 0 || change > 1 || index < 0 || index >= BIP32_HARDENED { return DP_BAD_FIELD; }
  if account.count != BIP32_NODE_BYTES { return DP_BIP32 + BIP32_BAD_SIZE; }
  depth := cast(int) account[HDK_DEPTH];
  if depth != DP_ACCOUNT_DEPTH || account[HDK_INDEX] < 0x80 { return DP_NOT_ACCOUNT; }
  node: [BIP32_NODE_BYTES] u8; steps := [2] int.[change, index];
  r := bip32_descend_ct(account, steps[..], work, node[..]);
  if r > 0 { r = bip32_neuter_ct(node[..], work, node[..]); }
  n := ifx r < 0 then DP_BIP32 + r else path_script_vartime(purpose, node[HDK_KEY..<BIP32_NODE_BYTES], out);
  for j: 0..<BIP32_NODE_BYTES { node[j] = 0; }
  return n;
}
// book:end derive

// ---- checks
dp_same :: (bytes: [] u8, text: string) -> bool {
  if bytes.count != text.count { return false; }
  for i: 0..<text.count { if bytes[i] != text[i] { return false; } }
  return true;
}
dp_parses :: (text: string, want: [] int) -> bool {
  got: [DP_MAX_DEPTH] int;
  n := path_parse_vartime(text, got[..]);
  if n != want.count { return false; }
  for k: 0..<n { if got[k] != want[k] { return false; } }
  return true;
}
// A refusal leaves the buffer as it was.
dp_refuses :: (text: string, code: int) -> bool {
  got: [4] int;
  for k: 0..<4 { got[k] = -99; }
  if path_parse_vartime(text, got[..]) != code { return false; }
  for k: 0..<4 { if got[k] != -99 { return false; } }
  return true;
}
DPT_H :: BIP32_HARDENED;

#test "steps: plain, hardened either way, and the refusals" {
  #assert path_step_vartime("0") == 0 && path_step_vartime("5") == 5 && path_step_vartime("007") == 7;
  #assert path_step_vartime("84'") == 84 + DPT_H && path_step_vartime("84h") == 84 + DPT_H;
  #assert path_step_vartime("2147483647") == 2147483647 && path_step_vartime("2147483647h") == 4294967295;
  #assert path_step_vartime("2147483648") == DP_OVERFLOW && path_step_vartime("2147483648'") == DP_OVERFLOW;
  #assert path_step_vartime("99999999999999999999999999") == DP_OVERFLOW;
  #assert path_step_vartime("") == DP_EMPTY_STEP && path_step_vartime("h") == DP_BAD_STEP && path_step_vartime("'") == DP_BAD_STEP;
  #assert path_step_vartime("0H") == DP_BAD_STEP && path_step_vartime("+1") == DP_BAD_STEP && path_step_vartime("-0") == DP_BAD_STEP;
  #assert path_step_vartime("1aa") == DP_BAD_STEP && path_step_vartime("0''") == DP_BAD_STEP && path_step_vartime("0h'") == DP_BAD_STEP;
  #assert path_step_vartime("/") == DP_BAD_STEP && path_step_vartime(" 1") == DP_BAD_STEP && path_step_vartime("9a9999999999") == DP_BAD_STEP;
  #assert path_step_vartime(":") == DP_BAD_STEP && path_step_vartime("0:") == DP_BAD_STEP;
}

#test "paths: the root, the standard ones and NIP-06's" {
  none: [1] int;
  #assert dp_parses("m", none[0..<0]);
  w1 := [5] int.[84 + DPT_H, DPT_H, DPT_H, 0, 5];
  #assert dp_parses("m/84'/0'/0'/0/5", w1[..]);
  w2 := [5] int.[84 + DPT_H, DPT_H, DPT_H, 0, 5];
  #assert dp_parses("m/84h/0h/0h/0/5", w2[..]);
  w3 := [5] int.[44 + DPT_H, 1237 + DPT_H, DPT_H, 0, 0];
  #assert dp_parses("m/44'/1237'/0'/0/0", w3[..]);
  w4 := [5] int.[0, 4294967295, 1, 4294967294, 2];
  #assert dp_parses("m/0/2147483647'/1/2147483646'/2", w4[..]);
  #assert dp_refuses("", DP_NO_ROOT) && dp_refuses("M/0", DP_NO_ROOT) && dp_refuses("/0", DP_NO_ROOT) && dp_refuses("m0", DP_NO_ROOT);
  #assert dp_refuses("0/1", DP_NO_ROOT) && dp_refuses("mm/0", DP_NO_ROOT);
  #assert dp_refuses("m/", DP_EMPTY_STEP) && dp_refuses("m//0", DP_EMPTY_STEP) && dp_refuses("m/0/", DP_EMPTY_STEP);
  #assert dp_refuses("m/0//1", DP_EMPTY_STEP) && dp_refuses("m/0H", DP_BAD_STEP) && dp_refuses("m/0/x", DP_BAD_STEP);
  #assert dp_refuses("m/2147483648", DP_OVERFLOW) && dp_refuses("m/0/4294967295", DP_OVERFLOW);
  #assert dp_refuses("m/0/1/2/3/4", DP_CAPACITY);
  got: [4] int;
  #assert path_parse_vartime("m/0/1/2/3", got[..]) == 4 && got[3] == 3;
}

#test "depth: 255 steps parse and 256 refuse" #steps 50000000 {
  text: [2 + 2 * 256] u8; got: [DP_MAX_DEPTH] int;
  text[0] = 'm';
  for k: 0..<256 { text[1 + 2 * k] = '/'; text[2 + 2 * k] = cast(u8) ('0' + k % 10); }
  #assert path_parse_vartime(cast(string) text[0..<1 + 2 * 255], got[..]) == 255 && got[254] == 4;
  #assert path_parse_vartime(cast(string) text[0..<1 + 2 * 256], got[..]) == DP_TOO_DEEP;
  #assert path_parse_vartime(cast(string) text[0..<1 + 2 * 255], got[0..<254]) == DP_CAPACITY;
  // An empty step after 255 good ones is an empty step, not too deep.
  text[1 + 2 * 255] = '/'; text[2 + 2 * 255] = '/';
  #assert path_parse_vartime(cast(string) text[0..<3 + 2 * 255], got[..]) == DP_EMPTY_STEP;
}

#test "formatting gives back what parsing read" {
  out: [64] u8; got: [8] int;
  p := [5] int.[84 + DPT_H, DPT_H, DPT_H, 0, 5];
  n := path_format_vartime(p[..], '\'', out[..]);
  #assert n == 15 && dp_same(out[0..<n], "m/84'/0'/0'/0/5");
  n = path_format_vartime(p[..], 'h', out[..]);
  #assert n == 15 && dp_same(out[0..<n], "m/84h/0h/0h/0/5");
  #assert path_parse_vartime(cast(string) out[0..<n], got[..]) == 5 && got[0] == p[0] && got[4] == 5;
  e := [2] int.[4294967295, 2147483647];
  n = path_format_vartime(e[..], 'h', out[..]);
  #assert n == 24 && dp_same(out[0..<n], "m/2147483647h/2147483647");
  #assert path_format_vartime(p[0..<0], 'h', out[..]) == 1 && out[0] == 'm';
  #assert path_format_vartime(p[..], 'H', out[..]) == DP_BAD_STEP;
  bad := [1] int.[4294967296];
  #assert path_format_vartime(bad[..], 'h', out[..]) == DP_OVERFLOW;
  bad[0] = -1;
  #assert path_format_vartime(bad[..], 'h', out[..]) == DP_OVERFLOW;
  #assert path_format_vartime(p[..], 'h', out[0..<14]) == DP_CAPACITY;
  long: [256] int;
  #assert path_format_vartime(long[..], 'h', out[..]) == DP_TOO_DEEP;
}

#test "the standard paths and their output types" {
  got: [5] int;
  #assert path_standard_vartime(84, SW_MAINNET, 0, 0, 5, got[..]) == 5;
  #assert got[0] == 84 + DPT_H && got[1] == DPT_H && got[2] == DPT_H && got[3] == 0 && got[4] == 5;
  #assert path_standard_vartime(49, SW_TESTNET, 2, 1, 7, got[..]) == 5;
  #assert got[0] == 49 + DPT_H && got[1] == 1 + DPT_H && got[2] == 2 + DPT_H && got[3] == 1 && got[4] == 7;
  #assert path_standard_vartime(86, SW_REGTEST, 2147483647, 1, 2147483647, got[..]) == 5 && got[1] == 1 + DPT_H && got[2] == 4294967295;
  #assert path_standard_vartime(45, SW_MAINNET, 0, 0, 0, got[..]) == DP_BAD_PURPOSE;
  #assert path_standard_vartime(44, 0, 0, 0, 0, got[..]) == DP_BAD_NETWORK && path_standard_vartime(44, 4, 0, 0, 0, got[..]) == DP_BAD_NETWORK;
  #assert path_standard_vartime(44, SW_MAINNET, DPT_H, 0, 0, got[..]) == DP_BAD_FIELD;
  #assert path_standard_vartime(44, SW_MAINNET, -1, 0, 0, got[..]) == DP_BAD_FIELD;
  #assert path_standard_vartime(44, SW_MAINNET, 0, 2, 0, got[..]) == DP_BAD_FIELD && path_standard_vartime(44, SW_MAINNET, 0, -1, 0, got[..]) == DP_BAD_FIELD;
  #assert path_standard_vartime(44, SW_MAINNET, 0, 0, DPT_H, got[..]) == DP_BAD_FIELD && path_standard_vartime(44, SW_MAINNET, 0, 0, -1, got[..]) == DP_BAD_FIELD;
  #assert path_standard_vartime(44, SW_MAINNET, 0, 0, 0, got[0..<4]) == DP_CAPACITY;
  #assert path_purpose_kind(44) == AD_P2PKH && path_purpose_kind(49) == AD_P2SH && path_purpose_kind(84) == AD_P2WPKH;
  #assert path_purpose_kind(86) == AD_P2TR && path_purpose_kind(0) == DP_BAD_PURPOSE && path_purpose_kind(48) == DP_BAD_PURPOSE;
}

#test "scripts by purpose from G" #steps 400000000 {
  g: [33] u8; out: [AD_SCRIPT_MAX] u8;
  k := ad_unhex(G_COMPRESSED, g[..]);
  #assert path_script_vartime(44, k, out[..]) == 25 && ad_hex_is(out[0..<25], "76a914751e76e8199196d454941c45d1b3a323f1433bd688ac");
  #assert path_script_vartime(84, k, out[..]) == 22 && ad_hex_is(out[0..<22], "0014751e76e8199196d454941c45d1b3a323f1433bd6");
  #assert path_script_vartime(49, k, out[..]) == 23 && out[0] == 0xa9;
  #assert path_script_vartime(86, k, out[..]) == 34 && out[0] == 0x51;
  #assert path_script_vartime(48, k, out[..]) == DP_BAD_PURPOSE;
  #assert path_script_vartime(84, k[0..<32], out[..]) == DP_ADDRESS + AD_BAD_KEY;
  g[0] = 4;
  #assert path_script_vartime(84, k, out[..]) == DP_ADDRESS + AD_BAD_KEY;
  g[0] = 2;
  #assert path_script_vartime(84, k, out[0..<21]) == DP_ADDRESS + AD_CAPACITY;
}

#test "from a seed: BIP-32 test vector 1's m/0H/1 and the refusals" #steps 600000000 {
  seed: [16] u8; work: [BIP32_WORK_BYTES] u8; node: [BIP32_NODE_BYTES] u8; text: [BIP32_TEXT] u8;
  for i: 0..<16 { seed[i] = cast(u8) i; }
  #assert path_derive_ct(seed[..], false, "m/0h/1", work[..], node[..]) == BIP32_NODE_BYTES;
  #assert bip32_encode_ct(node[..], work[..], text[..]) == BIP32_TEXT && dp_same(text[..], HDKT_0H_1);
  for b: work { #assert b == 0; }
  for i: 0..<BIP32_NODE_BYTES { node[i] = 0xa5; }
  #assert path_derive_ct(seed[..], false, "m/0x", work[..], node[..]) == DP_BAD_STEP;
  #assert path_derive_ct(seed[0..<15], false, "m/0", work[..], node[..]) == DP_BIP32 + BIP32_BAD_SIZE;
  #assert path_derive_ct(seed[..], false, "m/0", work[..], node[0..<77]) == DP_CAPACITY;
  for b: node { #assert b == 0xa5; }
}

// The seed of "abandon" eleven times and "about", with no passphrase: the
// BIP-84, BIP-86 and BIP-49 vectors' wallet (chapter 31 makes it).
DPT_ABANDON :: "5eb00bbddcf069084889a8ab9155568165f5c453ccb85e70811aaed6f6da5fc19a5ac40b389cd370d086206dec8aa6c43daea6690f20ad3d8d48b2d2ce9e38e4";

#test "an account node, private or watch-only, gives BIP-86's first address" #steps 2000000000 {
  sb: [64] u8; work: [BIP32_WORK_BYTES] u8; account: [BIP32_NODE_BYTES] u8; xpub: [BIP32_NODE_BYTES] u8; out: [AD_SCRIPT_MAX] u8;
  seed := ad_unhex(DPT_ABANDON, sb[..]);
  #assert path_derive_ct(seed, false, "m/86'/0'/0'", work[..], account[..]) == BIP32_NODE_BYTES;
  #assert bip32_neuter_ct(account[..], work[..], xpub[..]) == BIP32_NODE_BYTES;
  want := "5120a60869f0dbcf1dc659c9cecbaf8050135ea9e8cdc487053f1dc6880949dc684c";
  #assert path_account_script_ct(86, account[..], 0, 0, work[..], out[..]) == 34 && ad_hex_is(out[0..<34], want);
  for b: work { #assert b == 0; }
  #assert path_account_script_ct(86, xpub[..], 0, 0, work[..], out[..]) == 34 && ad_hex_is(out[0..<34], want);
  #assert path_account_script_ct(85, xpub[..], 0, 0, work[..], out[..]) == DP_BAD_PURPOSE;
  #assert path_account_script_ct(86, xpub[..], 2, 0, work[..], out[..]) == DP_BAD_FIELD;
  #assert path_account_script_ct(86, xpub[..], -1, 0, work[..], out[..]) == DP_BAD_FIELD;
  #assert path_account_script_ct(86, xpub[..], 0, BIP32_HARDENED, work[..], out[..]) == DP_BAD_FIELD;
  #assert path_account_script_ct(86, xpub[..], 0, -1, work[..], out[..]) == DP_BAD_FIELD;
  #assert path_account_script_ct(86, xpub[0..<77], 0, 0, work[..], out[..]) == DP_BIP32 + BIP32_BAD_SIZE;
  #assert path_account_script_ct(86, xpub[..], 0, 0, work[..], out[0..<33]) == DP_ADDRESS + AD_CAPACITY;
  #assert path_account_script_ct(86, xpub[..], 0, 0, work[0..<100], out[..]) == DP_BIP32 + BIP32_CAPACITY;
  // Not an account: depth 2, depth 4, and depth 3 under a normal index.
  #assert path_derive_ct(seed, false, "m/86'/0'", work[..], account[..]) == BIP32_NODE_BYTES;
  #assert path_account_script_ct(86, account[..], 0, 0, work[..], out[..]) == DP_NOT_ACCOUNT;
  #assert path_derive_ct(seed, false, "m/86'/0'/0'/0", work[..], account[..]) == BIP32_NODE_BYTES;
  #assert path_account_script_ct(86, account[..], 0, 0, work[..], out[..]) == DP_NOT_ACCOUNT;
  #assert path_derive_ct(seed, false, "m/86'/0'/0", work[..], account[..]) == BIP32_NODE_BYTES;
  #assert path_account_script_ct(86, account[..], 0, 0, work[..], out[..]) == DP_NOT_ACCOUNT;
  // A node whose version is unknown refuses with chapter 32's code.
  #assert path_derive_ct(seed, false, "m/86'/0'/0'", work[..], account[..]) == BIP32_NODE_BYTES;
  account[0] = 0;
  #assert path_account_script_ct(86, account[..], 0, 0, work[..], out[..]) == DP_BIP32 + BIP32_BAD_VERSION;
}
