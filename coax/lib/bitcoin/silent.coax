// Silent payments (Bitcoin chapter 97): BIP-352's static addresses. A
// receiver publishes one sp1q address, two public keys B_scan and B_m.
// A sender pays it to a fresh Taproot output that only the receiver can
// find: the output key is B_m + t_k G, where t_k hashes an ECDH secret
// between the sum of the sender's input keys and the receiver's scan key.
// No one else can link the outputs to the address or to each other, and
// the transaction carries no extra data.
//
// This file follows BIP-352 version 1.1.2 at bips 5aadddb5: the address
// and its versions, the inputs that count and how a receiver reads their
// keys, input_hash over the smallest outpoint, the shared secret and the
// outputs t_k, labels with the change label m = 0, scanning with the
// per-group limit K_max = 2323, and the key that spends a found output.
//
// The secret values are the senders' input keys and their sum a, the
// receiver's b_scan and b_spend, the ECDH point, each t_k and label
// tweak, and the key that spends. They follow chapter 3's rules as
// chapters 101 and 105 do: multiplied by G with the fixed-base comb of
// chapter 16 (smb_multiply_web), by another point with the constant-time
// ladder (smc_multiply), hashed with the erasable SHA-256 of chapter 24,
// selected with masks, and kept in an SlWork the caller owns and every
// return clears. By-value scalar copies are not covered by that erasure.
// Addresses, input scripts, outpoints, the key sum A, input_hash and the
// output keys are public; the procedures that read only them end in
// _vartime. A candidate output key P_k is compared with the
// transaction's outputs in variable time: a match is public once found.
//
// coax/tests/bitcoin/silent.py runs BIP-352's reference.py on every
// published vector and replays the example.
#run_steps 250000000;   // the secp256k1 base-point table is built at compile time
#load "taproot.coax";
#load "../crypto/bip32.coax";
#load "../crypto/secp_mult_const.coax";
#load "../../tests/bitcoin/silent_vectors.coax";
#authority;

// book:begin codes
SL_OK :: 0;
SL_NO_INPUTS :: 1;     // no input from BIP-352's list: send nothing, scan nothing
SL_ZERO_SUM :: 2;      // the keys sum to 0: a = 0, A is the point at infinity
SL_HASH_RANGE :: 3;    // input_hash or a t_k is 0 or not below n
SL_GROUP_LIMIT :: 4;   // more than K_max recipients share one scan key
SL_BAD_KEY :: 5;       // a secret key out of range, or a public key not on the curve
SL_CAPACITY :: 6;      // a wrong length, or a buffer too small
SL_REASONS :: [7] string.["ok", "no inputs", "the keys sum to zero", "a hash out of range",
  "a group over K_max", "a bad key", "capacity"];
// Address refusals, in silent_reference.py's order.
SLA_OK :: 0; SLA_NOT_BECH32M :: 1; SLA_HRP :: 2; SLA_VERSION :: 3; SLA_LENGTH :: 4; SLA_POINT :: 5;
SLA_REASONS :: [6] string.["ok", "not Bech32m", "not sp or tsp", "version 31", "not 66 bytes", "not a public key"];
// The kinds of input BIP-352 takes a key from, and 0 for the others.
SL_IN_NONE :: 0; SL_IN_P2PKH :: 1; SL_IN_P2SH_P2WPKH :: 2; SL_IN_P2WPKH :: 3; SL_IN_P2TR :: 4;
SL_KINDS :: [5] string.["none", "P2PKH", "P2SH-P2WPKH", "P2WPKH", "P2TR"];
SL_K_MAX :: 2323;            // outputs per group a sender may make, a receiver looks for
SL_MAX_OUTPUTS :: 23255;     // the most outputs a block's weight allows one transaction
SL_ADDRESS_MAX :: 1023;      // characters, as BIP-352 recommends
SL_ITEMS :: 1003;            // witness items: a 1,000-item stack, a script, a control block, an annex
SL_USED_BYTES :: 2907;       // one bit per output, SL_MAX_OUTPUTS of them
// BIP-341's NUMS point H, as an x coordinate: SHA-256 of G uncompressed.
SL_NUMS :: [32] u8.[0x50,0x92,0x9b,0x74,0xc1,0xa0,0x49,0x54,0xb7,0x8b,0x4b,0x60,0x35,0xe9,0x7a,0x5e,
  0x07,0x8a,0x5a,0x0f,0x28,0xec,0x96,0xd5,0x47,0xbf,0xee,0x9a,0xce,0x80,0x3a,0xc0];
// book:end codes

// ---- the secret workspace
// book:begin work
// Every procedure that touches a secret takes one SlWork and clears it
// before it returns.
SlWork :: struct { sha: [1] ShaOwned; data: [37] u8; digest: [32] u8; shared: [33] u8; }
sl_clear :: (w: [] SlWork) #effects(all) { fresh: SlWork; w[0] = fresh; }
sl_done :: (w: [] SlWork, code: int) -> int #effects(all) { sl_clear(w); return code; }
// hash_tag(data): SHA-256(SHA-256(tag) || SHA-256(tag) || data) into
// w.digest, with the erasable SHA-256.
sl_tagged :: (w: [] SlWork, tag: string, data: [] u8) #effects(all) {
  t: [32] u8; th: [32] u8; s := w[0].sha[..];
  for i: 0..<tag.count { t[i] = tag[i]; }
  #assert so_init(s) && so_update(s, t[0..<tag.count], false) && so_finish(s, th[..], false);
  #assert so_init(s) && so_update(s, th[..], false) && so_update(s, th[..], false);
  #assert so_update(s, data, false) && so_finish(s, w[0].digest[..], false);
}
// The digest as a scalar; ok is false when it is 0 or not below n.
sl_digest_scalar :: (w: [] SlWork) -> ScLoad #effects(all) {
  r := sc_load(w[0].digest[..]);
  r.ok = r.ok && !sc_is_zero(r.value);
  return r;
}
// ser_32(i): four bytes, most significant first.
sl_put32 :: (out: [] u8, i: int) #effects(all) { for j: 0..<4 { out[j] = cast(u8) ((i >> (8 * (3 - j))) & 255); } }
// book:end work

// ---- points
// The compressed encoding of p into out (33 bytes); false at infinity.
sl_encode :: (p: SgPoint, out: [] u8) -> bool #effects(all) {
  e := sg_encode_public(p);
  for i: 0..<33 { out[i] = e.bytes[i]; }
  return e.length == 33;
}
sl_decode_vartime :: (b: [] u8) -> SgResult #effects(all) {
  // Equivalent: sg_decode_public refuses every other length (its 1-byte 00 has a bad prefix here) and every prefix but 02 and 03, so either test alone refuses what both do.
  if b.count != 33 || (b[0] != 2 && b[0] != 3) { return SgResult.{value=sg_infinity()}; } // mutant: equivalent
  return sg_decode_public(b);
}
sl_wipe :: (b: [] u8) #effects(all) { for i: 0..<b.count { b[i] = 0; } }
sl_same_vartime :: (a: [] u8, b: [] u8) -> bool #effects(all) {
  if a.count != b.count { return false; }
  for i: 0..<a.count { if a[i] != b[i] { return false; } }
  return true;
}

// ---- addresses
// book:begin address
// An address: Bech32m with the human-readable part sp (mainnet) or tsp
// (testnets and signet), then the version (0, the character q) and the
// 66 bytes ser_P(B_scan) || ser_P(B_m) in 5-bit groups: 116 characters on
// mainnet, 117 on a testnet. Returns the length written, or -1.
silent_address_vartime :: (testnet: bool, scan: [] u8, spend: [] u8, out: [] u8) -> int #export_c #effects(all) {
  // Equivalent: sl_decode_vartime refuses every length but 33, so each length test only repeats the key test after it.
  if scan.count != 33 || spend.count != 33 || !sl_decode_vartime(scan).ok || !sl_decode_vartime(spend).ok { return -1; } // mutant: equivalent
  body: [66] u8; words: [107] u8;
  for i: 0..<33 { body[i] = scan[i]; body[33 + i] = spend[i]; }
  // Equivalent: words starts zeroed, and words[1] is the loop's first write.
  words[0] = 0; // mutant: equivalent
  // Equivalent: word 0 is the top five bits of scan[0], 02 or 03, so 0, as words starts.
  for i: 0..<106 { words[1 + i] = b32_word(cast(string) body[..], true, i); } // mutant: equivalent
  r := b32_encode(ifx testnet then "tsp" else "sp", cast(string) words[..], false, out, true, false, B32_BECH32M);
  return ifx r.error == NC_OK then r.written else -1;
}
// book:end address

// book:begin decode
SlAddress :: struct { reason: int; testnet: bool; version: int; scan: [33] u8; spend: [33] u8; }
// Decoding, by BIP-352's version rules: version 0 holds exactly 66 bytes;
// versions 1 to 30 hold at least 66, and a version 0 sender reads the
// first 66 and ignores the rest; version 31 is reserved for a change that
// breaks compatibility, and refused. Both keys must be on the curve.
silent_decode_vartime :: (text: string) -> SlAddress #export_c #effects(all) {
  r: SlAddress;
  hrp: [84] u8; words: [SL_ADDRESS_MAX] u8;
  if text.count > SL_ADDRESS_MAX { r.reason = SLA_NOT_BECH32M; return r; }
  d := b32_decode(text, hrp[..], words[..], true, false, B32_BECH32M);
  if d.error != NC_OK { r.reason = SLA_NOT_BECH32M; return r; }
  name := cast(string) hrp[0..<d.hrp_written];
  if name != "sp" && name != "tsp" { r.reason = SLA_HRP; return r; }
  if d.written == 0 { r.reason = SLA_LENGTH; return r; }
  version := cast(int) words[0];
  if version == 31 { r.reason = SLA_VERSION; return r; }
  // 5-bit groups to bytes: the spare bits must be fewer than 5, and zero.
  // Equivalent: a 1 in acc's start reaches bit 10 at the second group, where the first byte read masks it off, and the third shift drops it past bit 11.
  body: [SL_ADDRESS_MAX] u8; n := 0; acc := 0; bits := 0; // mutant: equivalent
  for i: 1..<d.written {
    acc = ((acc << 5) | cast(int) words[i]) & 0xfff; bits += 5;
    if bits >= 8 { bits -= 8; body[n] = cast(u8) ((acc >> bits) & 255); n += 1; }
  }
  if bits >= 5 || ((acc << (8 - bits)) & 255) != 0 { r.reason = SLA_LENGTH; return r; }
  if n < 66 || (version == 0 && n != 66) { r.reason = SLA_LENGTH; return r; }
  for i: 0..<33 { r.scan[i] = body[i]; r.spend[i] = body[33 + i]; }
  if !sl_decode_vartime(r.scan[..]).ok || !sl_decode_vartime(r.spend[..]).ok { r.reason = SLA_POINT; return r; }
  r.testnet = name == "tsp"; r.version = version;
  return r;
}
// book:end decode

// ---- keys and labels
// book:begin keys
// BIP-352's BIP-32 paths: b_scan at m/352'/coin'/account'/1'/0 and b_spend
// at m/352'/coin'/account'/0'/0, hardened so that the scan key can be
// handed to a scanning server without exposing the spend key.
silent_keys :: (seed: [] u8, coin: int, account: int, scan: [] u8, spend: [] u8) -> bool #export_c #effects(all) {
  if scan.count != 32 || spend.count != 32 || coin < 0 || account < 0 || coin >= BIP32_HARDENED || account >= BIP32_HARDENED { return false; }
  chain: [32] u8;
  path := [5] int.[BIP32_HARDENED + 352, BIP32_HARDENED + coin, BIP32_HARDENED + account, BIP32_HARDENED + 1, 0];
  ok := bip32_path(seed, path[..], scan, chain[..]);
  path[3] = BIP32_HARDENED;
  ok = ok && bip32_path(seed, path[..], spend, chain[..]);
  // Equivalent: chain is a local no caller sees; clearing it is erasure, not output.
  for i: 0..<32 { chain[i] = 0; } // mutant: equivalent
  return ok;
}
// book:end keys

// book:begin label
// A label: the tweak hash_BIP0352/Label(ser_256(b_scan) || ser_32(m)) and
// its point, tweak G. The labeled address uses B_m = B_spend + tweak G.
// m = 0 is reserved for change, which a wallet always scans for.
SlLabel :: struct { m: int; point: [33] u8; tweak: [32] u8; }
silent_label :: (b_scan: [] u8, m: int, out: [] SlLabel, w: [] SlWork) -> int #export_c #effects(all) {
  if b_scan.count != 32 || out.count != 1 || w.count != 1 || m < 0 || m > 0xffffffff { return SL_CAPACITY; }
  for i: 0..<32 { w[0].data[i] = b_scan[i]; }
  // Equivalent: sl_put32 writes four bytes, and data has 37.
  sl_put32(w[0].data[32..<36], m); // mutant: equivalent
  sl_tagged(w, "BIP0352/Label", w[0].data[0..<36]);
  t := sl_digest_scalar(w);
  // Equivalent: no input is known whose SHA-256 is 0 or at least n.
  if !t.ok { return sl_done(w, SL_HASH_RANGE); } // mutant: equivalent
  out[0].m = m;
  #assert sc_store(t.value, out[0].tweak[..]);
  #assert sl_encode(smb_multiply_web(t.value), out[0].point[..]);
  // Equivalent: t is a local no caller sees; clearing it is erasure, not output.
  t = ScLoad.{}; // mutant: equivalent
  return sl_done(w, SL_OK);
}
// B_m = B_spend + the label's point, into out (33 bytes).
silent_labeled_spend_vartime :: (spend: [] u8, label: SlLabel, out: [] u8) -> int #export_c #effects(all) {
  point := label.point;
  b := sl_decode_vartime(spend); l := sl_decode_vartime(point[..]);
  if !b.ok || !l.ok || out.count != 33 { return SL_BAD_KEY; }
  return ifx sl_encode(sg_add(b.value, l.value).value, out) then SL_OK else SL_BAD_KEY;
}
// book:end label

// ---- inputs
// book:begin inputs
// The public key an input contributes, into out (33 bytes), and its kind;
// SL_IN_NONE when it is not one of BIP-352's inputs or its key can't be
// used. witness is the input's serialized stack (a count, then each item
// with its length), empty for a legacy input.
//
// - P2PKH: the last 33 bytes of the scriptSig whose HASH160 is the key
//   hash. The receiver searches from the end, so a non-standard scriptSig
//   (a third party can malleate one) still gives the key.
// - P2SH-P2WPKH: the scriptSig pushes a P2WPKH program; the key is the
//   last witness item.
// - P2WPKH: the last witness item.
// - P2TR: the output key in the scriptPubKey. The annex (a last item
//   starting 0x50, with another item before it) doesn't count. A script
//   path whose internal key, in the control block, is H is excluded:
//   nobody can sign for H, so such an input can't share the secret.
//
// Only compressed and x-only keys count; an uncompressed key excludes the
// input.
silent_input_key_vartime :: (script_sig: [] u8, witness: [] u8, prevout: [] u8, out: [] u8) -> int #export_c #effects(all) {
  if out.count != 33 { return SL_IN_NONE; }
  ins: [1] TxIn; items: [SL_ITEMS] TxItem; n := 0;
  if witness.count > 0 {
    s := tx_witness_vartime(witness, 0, ins[..], items[..]);
    if s.code != TX_OK || s.at != witness.count { return SL_IN_NONE; }
    n = s.count;
  }
  last := ifx n > 0 then witness[items[n-1].at..<items[n-1].at + items[n-1].n] else witness[0..<0];
  h: [20] u8;
  if prevout.count == 25 && prevout[0] == 0x76 && prevout[1] == 0xa9 && prevout[2] == 0x14 && prevout[23] == 0x88 && prevout[24] == 0xac {
    end := script_sig.count;
    while end >= 33 {
      key := script_sig[end-33..<end];
      #assert hash160_checked(key, h[..], false) == RMD_OK;
      if sl_same_vartime(h[..], prevout[3..<23]) && sl_decode_vartime(key).ok {
        for i: 0..<33 { out[i] = key[i]; }
        return SL_IN_P2PKH;
      }
      end -= 1;
    }
    return SL_IN_NONE;
  }
  kind := SL_IN_NONE;
  if prevout.count == 23 && prevout[0] == 0xa9 && prevout[1] == 0x14 && prevout[22] == 0x87 {
    if script_sig.count == 23 && script_sig[1] == 0 && script_sig[2] == 0x14 { kind = SL_IN_P2SH_P2WPKH; }
  } else if prevout.count == 22 && prevout[0] == 0 && prevout[1] == 0x14 {
    kind = SL_IN_P2WPKH;
  }
  if kind != SL_IN_NONE {
    if n == 0 || !sl_decode_vartime(last).ok { return SL_IN_NONE; }
    for i: 0..<33 { out[i] = last[i]; }
    return kind;
  }
  if prevout.count == 34 && prevout[0] == 0x51 && prevout[1] == 0x20 && n > 0 {
    // Equivalent: the && chain groups to the left, so a mutant there differs only for one item starting 0x50: n becomes 0 rather than staying 1, and the control-block test below needs n > 1 either way.
    if n > 1 && last.count > 0 && last[0] == 0x50 { n -= 1; } // mutant: equivalent
    if n > 1 {
      control := witness[items[n-1].at..<items[n-1].at + items[n-1].n];
      nums := SL_NUMS;
      if control.count >= 33 && sl_same_vartime(control[1..<33], nums[..]) { return SL_IN_NONE; }
    }
    p := sg_lift_x_public(prevout[2..<34]);
    if !p.ok { return SL_IN_NONE; }
    out[0] = 2;
    for i: 0..<32 { out[1 + i] = prevout[2 + i]; }
    return SL_IN_P2TR;
  }
  return SL_IN_NONE;
}
// Whether an input spends a witness version above 1 (OP_2 to OP_16 and a
// program of 2 to 40 bytes). A transaction with one is not scanned: a
// later version of silent payments may count those inputs.
silent_future_witness_vartime :: (prevout: [] u8) -> bool #export_c #effects(all) {
  return prevout.count >= 4 && prevout.count <= 42 && prevout[0] >= 0x52 && prevout[0] <= 0x60 && cast(int) prevout[1] == prevout.count - 2;
}
// An outpoint as a transaction serializes it: the txid's 32 bytes as
// stored (the reverse of how it is displayed), then the output index,
// 4 bytes little-endian.
silent_outpoint_vartime :: (txid: [] u8, vout: int, out: [] u8) -> bool #export_c #effects(all) {
  if txid.count != 32 || out.count != 36 || vout < 0 || vout > 0xffffffff { return false; }
  for i: 0..<32 { out[i] = txid[i]; }
  for i: 0..<4 { out[32 + i] = cast(u8) ((vout >> (8 * i)) & 255); }
  return true;
}
// book:end inputs

// book:begin hash
// input_hash = hash_BIP0352/Inputs(outpoint_L || ser_P(A)), outpoint_L
// the smallest outpoint, byte by byte, of all the transaction's inputs
// (not only BIP-352's). It binds the secret to this transaction: the same
// keys spending other coins give other outputs. Into out (32 bytes);
// false when it is 0 or not below n.
silent_input_hash_vartime :: (outpoints: [] u8, a_point: [] u8, out: [] u8) -> bool #export_c #effects(all) {
  if outpoints.count == 0 || outpoints.count % 36 != 0 || a_point.count != 33 || out.count != 32 { return false; }
  low := 0;
  for k: 1..<outpoints.count / 36 {
    for i: 0..<36 {
      a := outpoints[36*k + i]; b := outpoints[36*low + i];
      // Equivalent: inside a != b, a <= b is a < b.
      if a != b { if a < b { low = k; } break; } // mutant: equivalent
    }
  }
  w: [1] SlWork; data: [69] u8;
  for i: 0..<36 { data[i] = outpoints[36*low + i]; }
  for i: 0..<33 { data[36 + i] = a_point[i]; }
  sl_tagged(w[..], "BIP0352/Inputs", data[..]);
  ok := sl_digest_scalar(w[..]).ok;
  for i: 0..<32 { out[i] = w[0].digest[i]; }
  return ok;
}
// book:end hash

// ---- the sender
// book:begin sum
// a = a_1 + ... + a_n, each a P2TR input's key negated when its point has
// an odd y (the receiver reads that key as x-only, so as the even one).
// keys holds 32 bytes per input of BIP-352's list, taproot says which are
// P2TR. Writes a into out (32 bytes) and A = a G into a_point (33).
silent_key_sum :: (keys: [] u8, taproot: [] bool, out: [] u8, a_point: [] u8, w: [] SlWork) -> int #export_c #effects(all) {
  if w.count != 1 || keys.count % 32 != 0 || taproot.count != keys.count / 32 || out.count != 32 || a_point.count != 33 { return SL_CAPACITY; }
  if keys.count == 0 { return SL_NO_INPUTS; }
  a := sc_small(0);
  for k: 0..<taproot.count {
    d := sc_load(keys[32*k..<32*k+32]);
    // Equivalent: a is a local no caller sees; clearing it is erasure, not output.
    if !d.ok || sc_is_zero(d.value) { a = ScScalar.{}; return sl_done(w, SL_BAD_KEY); } // mutant: equivalent
    if taproot[k] {
      #assert sl_encode(smb_multiply_web(d.value), w[0].shared[..]);
      d.value = sc_select(cast(u64) (w[0].shared[0] & 1), sc_negate(d.value), d.value);
    }
    a = sc_add(a, d.value);
    // Equivalent: d is a local no caller sees; clearing it is erasure, not output.
    d = ScLoad.{}; // mutant: equivalent
  }
  if sc_is_zero(a) { return sl_done(w, SL_ZERO_SUM); }
  #assert sc_store(a, out) && sl_encode(smb_multiply_web(a), a_point);
  // Equivalent: a is a local no caller sees; clearing it is erasure, not output.
  a = ScScalar.{}; // mutant: equivalent
  return sl_done(w, SL_OK);
}
// book:end sum

// book:begin tk
// t_k = hash_BIP0352/SharedSecret(ser_P(ecdh_shared_secret) || ser_32(k)),
// from the shared secret in w.shared; false when it is 0 or not below n.
sl_t :: (k: int, w: [] SlWork) -> ScLoad #effects(all) {
  for i: 0..<33 { w[0].data[i] = w[0].shared[i]; }
  sl_put32(w[0].data[33..<37], k);
  sl_tagged(w, "BIP0352/SharedSecret", w[0].data[..]);
  return sl_digest_scalar(w);
}
// P_k = B_m + t_k G, as an x-only key into out.
sl_output :: (b_m: SgPoint, t: ScScalar, out: [] u8) -> bool #effects(all) {
  e := sg_encode_public(sg_add(b_m, smb_multiply_web(t)).value);
  for i: 0..<32 { out[i] = e.bytes[1 + i]; }
  return e.length == 33;
}
// book:end tk

// book:begin send
SlSent :: struct { code: int; count: int; }
// Whether every group of recipients (66 bytes each) that share a scan key
// has at most limit members. A recipient starts a group when no earlier
// recipient has its scan key.
sl_groups_fit_vartime :: (recipients: [] u8, limit: int) -> bool #effects(all) {
  r := recipients.count / 66;
  for i: 0..<r {
    first := true;
    // Equivalent: these mutants only call more recipients a group's first, and counting a group again from a later member gives no more members.
    for j: 0..<i { if sl_same_vartime(recipients[66*j..<66*j+33], recipients[66*i..<66*i+33]) { first = false; break; } } // mutant: equivalent
    if !first { continue; }
    size := 0;
    for j: i..<r { if sl_same_vartime(recipients[66*j..<66*j+33], recipients[66*i..<66*i+33]) { size += 1; } }
    if size > limit { return false; }
  }
  return true;
}
// The outputs for recipients, 66 bytes each (B_scan || B_m, as decoded),
// into outputs, 32 bytes each: x-only Taproot keys, in groups by scan
// key, each group in the order its recipients appear. Recipients sharing
// a scan key share one shared secret and take k = 0, 1, 2, ...; a
// recipient listed twice gets two outputs. When shared has room, it gets
// each recipient's shared secret (33 bytes): a secret. Sending fails
// when no input counts, a = 0, input_hash is out of range or a group
// is over K_max.
silent_send :: (keys: [] u8, taproot: [] bool, outpoints: [] u8, recipients: [] u8, outputs: [] u8, shared: [] u8, w: [] SlWork) -> SlSent #export_c #effects(all) {
  r := recipients.count / 66;
  if w.count != 1 || recipients.count % 66 != 0 || r == 0 || outputs.count < 32 * r || (shared.count != 0 && shared.count < 33 * r) {
    return SlSent.{code=SL_CAPACITY};
  }
  a: [32] u8; a_point: [33] u8; h: [32] u8;
  code := silent_key_sum(keys, taproot, a[..], a_point[..], w);
  if code != SL_OK { return SlSent.{code=code}; }
  // Equivalent: a is a local no caller sees; wiping it is erasure, not output.
  if !silent_input_hash_vartime(outpoints, a_point[..], h[..]) { sl_wipe(a[..]); return SlSent.{code=SL_HASH_RANGE}; } // mutant: equivalent
  // Check every group's size before making any output.
  // Equivalent: a is a local no caller sees; wiping it is erasure, not output.
  if !sl_groups_fit_vartime(recipients, SL_K_MAX) { sl_wipe(a[..]); return SlSent.{code=SL_GROUP_LIMIT}; } // mutant: equivalent
  // Each group: ecdh_shared_secret = (input_hash a) B_scan, then its outputs.
  written := 0;
  for i: 0..<r {
    first := true;
    for j: 0..<i { if sl_same_vartime(recipients[66*j..<66*j+33], recipients[66*i..<66*i+33]) { first = false; break; } }
    if !first { continue; }
    scan := sl_decode_vartime(recipients[66*i..<66*i+33]);
    // Equivalent: a is a local no caller sees; wiping it is erasure, not output.
    if !scan.ok { sl_wipe(a[..]); return SlSent.{code=sl_done(w, SL_BAD_KEY)}; } // mutant: equivalent
    s := sc_mul(sc_load(h[..]).value, sc_load(a[..]).value);
    e := smc_multiply(s, scan.value);
    // Equivalent: s is a local no caller sees; clearing it is erasure, not output.
    s = ScScalar.{}; // mutant: equivalent
    // Equivalent: s is input_hash times a, both in 1 to n - 1, so not 0 mod the prime n, and B_scan decoded to a point of order n: s B_scan is never infinity. a is a local.
    if !sl_encode(e.value, w[0].shared[..]) { sl_wipe(a[..]); return SlSent.{code=sl_done(w, SL_BAD_KEY)}; } // mutant: equivalent
    // Equivalent: e is a local no caller sees; clearing it is erasure, not output.
    e = SgResult.{}; // mutant: equivalent
    k := 0;
    for j: i..<r {
      if !sl_same_vartime(recipients[66*j..<66*j+33], recipients[66*i..<66*i+33]) { continue; }
      b_m := sl_decode_vartime(recipients[66*j+33..<66*j+66]);
      t := sl_t(k, w);
      // Equivalent: no input is known whose SHA-256 is 0 or at least n, so t is ok and the code is SL_BAD_KEY; a is a local.
      if !b_m.ok || !t.ok { sl_wipe(a[..]); return SlSent.{code=sl_done(w, ifx b_m.ok then SL_HASH_RANGE else SL_BAD_KEY)}; } // mutant: equivalent
      // Equivalent: P_k is infinity only when t_k is the negated discrete log of B_m, a hash no one can aim; a is a local.
      if !sl_output(b_m.value, t.value, outputs[32*written..<32*written+32]) { sl_wipe(a[..]); return SlSent.{code=sl_done(w, SL_BAD_KEY)}; } // mutant: equivalent
      // Equivalent: t is a local no caller sees; clearing it is erasure, not output.
      t = ScLoad.{}; // mutant: equivalent
      if shared.count != 0 { for b: 0..<33 { shared[33*j + b] = w[0].shared[b]; } }
      written += 1; k += 1;
    }
  }
  // Equivalent: a is a local no caller sees; wiping it is erasure, not output.
  sl_wipe(a[..]); // mutant: equivalent
  sl_clear(w);
  return SlSent.{code=SL_OK, count=written};
}
// book:end send

// ---- the receiver
// book:begin tweak
// What a receiver needs from a transaction's inputs: A = A_1 + ... + A_n,
// the keys BIP-352's inputs give (33 bytes each), and the tweak
// input_hash A (33 bytes). A server can publish the tweak for every
// transaction; it reveals nothing without b_scan. Writes A too.
silent_tweak_vartime :: (pubs: [] u8, outpoints: [] u8, tweak: [] u8, a_point: [] u8) -> int #export_c #effects(all) {
  if pubs.count % 33 != 0 || tweak.count != 33 || a_point.count != 33 { return SL_CAPACITY; }
  if pubs.count == 0 { return SL_NO_INPUTS; }
  sum := sg_infinity();
  for k: 0..<pubs.count / 33 {
    p := sl_decode_vartime(pubs[33*k..<33*k+33]);
    if !p.ok { return SL_BAD_KEY; }
    sum = sg_add(sum, p.value).value;
  }
  if !sl_encode(sum, a_point) { return SL_ZERO_SUM; }
  h: [32] u8;
  if !silent_input_hash_vartime(outpoints, a_point, h[..]) { return SL_HASH_RANGE; }
  // Equivalent: input_hash is in 1 to n - 1 and A is not infinity (refused above), so input_hash A, in a group of prime order n, is not infinity.
  return ifx sl_encode(ecmult_vartime(sc_small(0), sum, sc_load(h[..]).value).value, tweak) then SL_OK else SL_ZERO_SUM; // mutant: equivalent
}
// ecdh_shared_secret = b_scan (input_hash A), the same point the sender
// made as (input_hash a) B_scan, into w.shared. Copies it to out (33
// bytes) when out has room: a secret.
silent_shared :: (b_scan: [] u8, tweak: [] u8, out: [] u8, w: [] SlWork) -> int #export_c #effects(all) {
  if b_scan.count != 32 || w.count != 1 || (out.count != 0 && out.count != 33) { return SL_CAPACITY; }
  p := sl_decode_vartime(tweak);
  b := sc_load(b_scan);
  // Equivalent: b is a local no caller sees; clearing it is erasure, not output.
  if !p.ok || !b.ok || sc_is_zero(b.value) { b = ScLoad.{}; return SL_BAD_KEY; } // mutant: equivalent
  e := smc_multiply(b.value, p.value);
  // Equivalent: b is a local no caller sees; clearing it is erasure, not output.
  b = ScLoad.{}; // mutant: equivalent
  ok := sl_encode(e.value, w[0].shared[..]);
  // Equivalent: e is a local no caller sees; clearing it is erasure, not output.
  e = SgResult.{}; // mutant: equivalent
  for i: 0..<out.count { out[i] = w[0].shared[i]; }
  // Equivalent: b is in 1 to n - 1 and the tweak decoded to a point of order n, so b times it is never infinity.
  return ifx ok then SL_OK else SL_BAD_KEY; // mutant: equivalent
}
// book:end tweak

// book:begin scan
// An output found: its index, its x-only key, the label it was paid to
// (its m, or -1 for none) and the secret tweak that spends it (t_k, plus
// the label's tweak for a labeled one).
SlFound :: struct { output: int; key: [32] u8; label: int; tweak: [32] u8; }
SlScan :: struct { code: int; count: int; }
// The label whose point is p's compressed encoding, or -1.
sl_label_of_vartime :: (p: SgPoint, labels: [] SlLabel) -> int #effects(all) {
  e := sg_encode_public(p);
  // Equivalent: p is infinity only when the output's point is P_k or -P_k, whose x the plain comparison before it already matched.
  if e.length != 33 { return -1; } // mutant: equivalent
  for i: 0..<labels.count { if sl_same_vartime(e.bytes[..], labels[i].point[..]) { return i; } }
  return -1;
}
// Scanning: for k = 0, 1, 2, ... compute P_k = B_spend + t_k G and look
// for it among the outputs not yet found (32 bytes each). An output
// matches P_k itself, or, for a labeled address, P_k + label G: then
// output - P_k, or -output - P_k (an x-only output has two candidate
// points), is a label's point. A match moves on to k + 1; a k with no
// match ends the scan, and so does k = limit. found must have room for
// every output the scan can find.
sl_scan_upto :: (b_scan: [] u8, spend: [] u8, tweak: [] u8, outputs: [] u8, labels: [] SlLabel, found: [] SlFound, limit: int, w: [] SlWork) -> SlScan #effects(all) {
  n := outputs.count / 32;
  if outputs.count % 32 != 0 || n > SL_MAX_OUTPUTS || spend.count != 33 { return SlScan.{code=SL_CAPACITY}; }
  b_spend := sl_decode_vartime(spend);
  if !b_spend.ok { return SlScan.{code=SL_BAD_KEY}; }
  code := silent_shared(b_scan, tweak, b_scan[0..<0], w);
  if code != SL_OK { return SlScan.{code=sl_done(w, code)}; }
  used: [SL_USED_BYTES] u8;
  k := 0;
  while k < limit {
    t := sl_t(k, w);
    // Equivalent: no input is known whose SHA-256 is 0 or at least n.
    if !t.ok { return SlScan.{code=sl_done(w, SL_HASH_RANGE), count=k}; } // mutant: equivalent
    p := sg_add(b_spend.value, smb_multiply_web(t.value)).value;
    e := sg_encode_public(p);
    hit := -1; label := -1;
    for i: 0..<n {
      // Equivalent: never skipping, or marking less, changes nothing: a found output is P_j, or P_j plus a label, for an earlier j, and matching it again needs t_k to equal t_j (plus a difference of labels), a hash no one can aim.
      if ((used[i / 8] >> (i % 8)) & 1) == 1 { continue; } // mutant: equivalent
      out := outputs[32*i..<32*i+32];
      if sl_same_vartime(e.bytes[1..<33], out) { hit = i; break; }
      if labels.count == 0 { continue; }
      o := sg_lift_x_public(out);
      if !o.ok { continue; }
      minus := sg_negate(p).value;
      label = sl_label_of_vartime(sg_add(o.value, minus).value, labels);
      if label < 0 { label = sl_label_of_vartime(sg_add(sg_negate(o.value).value, minus).value, labels); }
      if label >= 0 { hit = i; break; }
    }
    // Equivalent: t is a local no caller sees; clearing it is erasure, not output.
    if hit < 0 { t = ScLoad.{}; break; } // mutant: equivalent
    // Equivalent: t is a local no caller sees; clearing it is erasure, not output.
    if k == found.count { t = ScLoad.{}; return SlScan.{code=sl_done(w, SL_CAPACITY), count=k}; } // mutant: equivalent
    // Equivalent: never skipping, or marking less, changes nothing: a found output is P_j, or P_j plus a label, for an earlier j, and matching it again needs t_k to equal t_j (plus a difference of labels), a hash no one can aim.
    used[hit / 8] |= cast(u8) (1 << (hit % 8)); // mutant: equivalent
    found[k].output = hit;
    found[k].label = ifx label >= 0 then labels[label].m else -1;
    for i: 0..<32 { found[k].key[i] = outputs[32*hit + i]; }
    total := ifx label >= 0 then sc_add(t.value, sc_load(labels[label].tweak[..]).value) else t.value;
    #assert sc_store(total, found[k].tweak[..]);
    // Equivalent: total and t are locals no caller sees; clearing them is erasure, not output.
    total = ScScalar.{}; t = ScLoad.{}; // mutant: equivalent
    k += 1;
  }
  sl_clear(w);
  return SlScan.{code=SL_OK, count=k};
}
silent_scan :: (b_scan: [] u8, spend: [] u8, tweak: [] u8, outputs: [] u8, labels: [] SlLabel, found: [] SlFound, w: [] SlWork) -> SlScan #export_c #effects(all) {
  return sl_scan_upto(b_scan, spend, tweak, outputs, labels, found, SL_K_MAX, w);
}
// book:end scan

// book:begin spend
// The key that spends a found output: d = b_spend + tweak mod n, into out
// (32 bytes). It signs a BIP-341 key-path spend as it is, with no
// TapTweak: the output key is d G itself. A BIP-340 signer negates d
// when d G has an odd y.
silent_spend_key :: (b_spend: [] u8, tweak: [] u8, out: [] u8) -> bool #export_c #effects(all) {
  // Equivalent: sc_load refuses any length but 32, so b_spend's and the tweak's lengths are refused either way; out's is not, and is checked.
  if b_spend.count != 32 || tweak.count != 32 || out.count != 32 { return false; } // mutant: equivalent
  b := sc_load(b_spend); t := sc_load(tweak);
  d := sc_add(b.value, t.value);
  ok := b.ok && t.ok && !sc_is_zero(d);
  ok = ok && sc_store(d, out);
  // Equivalent: b, t and d are locals no caller sees; clearing them is erasure, not output.
  b = ScLoad.{}; t = ScLoad.{}; d = ScScalar.{}; // mutant: equivalent
  return ok;
}
// book:end spend

// ---- checks
sl_hex :: (h: string, out: [] u8) -> [] u8 #effects(all) { return tx_unhex(h, out); }
// The labels of a receiver: 4 bytes each in r.labels.
sl_labels :: (r: SlReceive, b_scan: [] u8, out: [] SlLabel, w: [] SlWork) -> int #effects(all) {
  n := r.labels.count / 8;
  m: [4] u8;
  for i: 0..<n {
    v := sl_hex(r.labels[8*i..<8*i+8], m[..]);
    // Equivalent: every published label is below 2^24, so v[0] is 0 and any shift of it is 0.
    value := (cast(int) v[0] << 24) | (cast(int) v[1] << 16) | (cast(int) v[2] << 8) | cast(int) v[3]; // mutant: equivalent
    #assert silent_label(b_scan, value, out[i..<i+1], w) == SL_OK;
  }
  return n;
}
// The i-th word of a space-separated list.
sl_word :: (text: string, i: int) -> string #effects(all) {
  at := 0;
  for k: 0..<i { while text[at] != ' ' { at += 1; } at += 1; }
  end := at;
  while end < text.count && text[end] != ' ' { end += 1; }
  return text[at..<end];
}
// The inputs of a case: the outpoints, the public keys BIP-352 takes and,
// for the sender, their secret keys and which are P2TR. Checks each key
// is the published one. Returns how many inputs count.
SlInputs :: struct { outpoints: [36 * 8] u8; pubs: [33 * 8] u8; keys: [32 * 8] u8; taproot: [8] bool; n: int; all: int; }
sl_inputs :: (c: SlCase) -> SlInputs #effects(all) {
  r: SlInputs; r.all = c.inputs;
  for k: 0..<c.inputs {
    v := SL_INPUTS[c.first + k];
    sig: [600] u8; wit: [1200] u8; spk: [60] u8; txid: [32] u8; pub: [33] u8;
    shown := sl_hex(v.txid, txid[..]);
    for i: 0..<16 { b := shown[i]; shown[i] = shown[31-i]; shown[31-i] = b; }
    #assert silent_outpoint_vartime(shown, v.vout, r.outpoints[36*k..<36*k+36]);
    kind := silent_input_key_vartime(sl_hex(v.script_sig, sig[..]), sl_hex(v.witness, wit[..]), sl_hex(v.prevout, spk[..]), pub[..]);
    if v.pub.count == 0 { #assert kind == SL_IN_NONE; continue; }
    #assert kind != SL_IN_NONE;
    #assert tx_hex_is(pub[..], v.pub);
    for i: 0..<33 { r.pubs[33*r.n + i] = pub[i]; }
    key: [32] u8;
    #assert sl_hex(v.key, key[..]).count == 32;
    for i: 0..<32 { r.keys[32*r.n + i] = key[i]; }
    r.taproot[r.n] = kind == SL_IN_P2TR;
    r.n += 1;
  }
  return r;
}
// Whether a workspace holds nothing: every byte of its buffers is 0.
sl_is_clear :: (w: [] SlWork) -> bool #effects(all) {
  any: u8 = 0;
  for i: 0..<37 { any |= w[0].data[i]; }
  for i: 0..<32 { any |= w[0].digest[i]; }
  for i: 0..<33 { any |= w[0].shared[i]; }
  return any == 0;
}
// A case's sending: the key sum, then outputs that are exactly one of the
// published sets, with the published shared secrets, and the same outputs
// without them. Each check is its own assert.
sl_case_sends :: (c: SlCase) -> bool #effects(all) {
  w: [1] SlWork; x := sl_inputs(c);
  recipients: [66 * 8] u8; r := 0;
  for j: 0..<c.recipients {
    p := SL_RECIPIENTS[c.rfirst + j];
    a := silent_decode_vartime(p.address);
    #assert a.reason == SLA_OK;
    #assert tx_hex_is(a.scan[..], p.scan);
    #assert tx_hex_is(a.spend[..], p.spend);
    #assert p.count == 1;
    for i: 0..<33 { recipients[66*r + i] = a.scan[i]; recipients[66*r + 33 + i] = a.spend[i]; }
    r += 1;
  }
  keys := x.keys[0..<32*x.n]; taproot := x.taproot[0..<x.n]; outpoints := x.outpoints[0..<36*x.all]; to := recipients[0..<66*r];
  a: [32] u8; a_point: [33] u8;
  code := silent_key_sum(keys, taproot, a[..], a_point[..], w[..]);
  if c.sent == 0 {
    #assert code != SL_OK;
    #assert silent_send(keys, taproot, outpoints, to, a[..], a[0..<0], w[..]).code == code;
    return true;
  }
  #assert code == SL_OK;
  #assert tx_hex_is(a[..], c.a_sum);
  outputs: [32 * 8] u8; shared: [33 * 8] u8; again: [32 * 8] u8;
  made := outputs[0..<32*r];
  secrets := shared[0..<33*r]; more := again[0..<32*r];
  s := silent_send(keys, taproot, outpoints, to, made, secrets, w[..]);
  #assert s.code == SL_OK;
  #assert s.count == c.sent;
  #assert tx_hex_is(secrets, c.secrets);
  #assert sl_is_clear(w[..]);
  #assert silent_send(keys, taproot, outpoints, to, more, again[0..<0], w[..]).code == SL_OK;
  #assert sl_same_vartime(made, more);
  // The sets: 64 hex digits per output, one space between sets. The
  // outputs match exactly one of them, in any order.
  width := 64 * s.count;
  #assert (c.sets.count + 1) % (width + 1) == 0;
  matched := 0;
  // Equivalent: the text is a whole number of sets, at most 12, less one space (asserted above), so (count + 2) / (width + 1) and (count + 1) / (width - 1) floor to the same number for widths of 64 or more.
  for k: 0..<(c.sets.count + 1) / (width + 1) { // mutant: equivalent
    set := c.sets[(width + 1) * k..<(width + 1) * k + width];
    hits := 0;
    for i: 0..<s.count { for j: 0..<s.count { if tx_hex_is(made[32*i..<32*i+32], set[64*j..<64*j+64]) { hits += 1; } } }
    if hits == s.count { matched += 1; }
  }
  #assert matched == 1;
  return true;
}
// A receiver's addresses, unlabeled then one per label, each the published
// one. Returns how many it checked.
sl_receiver_addresses :: (r: SlReceive) -> int #effects(all) {
  w: [1] SlWork; scan: [32] u8; spend: [32] u8; b_scan: [33] u8; b_spend: [33] u8; text: [130] u8;
  #assert bip32_public(sl_hex(r.scan_key, scan[..]), b_scan[..]);
  #assert bip32_public(sl_hex(r.spend_key, spend[..]), b_spend[..]);
  n := silent_address_vartime(false, b_scan[..], b_spend[..], text[..]);
  #assert cast(string) text[0..<n] == sl_word(r.addresses, 0);
  labels: [4] SlLabel;
  count := sl_labels(r, scan[..], labels[..], w[..]);
  checked := 1;
  for i: 0..<count {
    b_m: [33] u8;
    #assert silent_labeled_spend_vartime(b_spend[..], labels[i], b_m[..]) == SL_OK;
    n = silent_address_vartime(false, b_scan[..], b_m[..], text[..]);
    #assert cast(string) text[0..<n] == sl_word(r.addresses, 1 + i);
    checked += 1;
  }
  return checked;
}
// A receiver's scan: A, the tweak and the shared secret, then the found
// outputs and their tweaks; each found key signs as the published
// signature does.
sl_receiver_finds :: (r: SlReceive) -> bool #effects(all) {
  w: [1] SlWork; c := SL_CASES[r.case_]; x := sl_inputs(c);
  tweak: [33] u8; a_point: [33] u8;
  code := silent_tweak_vartime(x.pubs[0..<33*x.n], x.outpoints[0..<36*x.all], tweak[..], a_point[..]);
  if r.tweak.count == 0 {
    #assert code != SL_OK;
    #assert r.n == 0;
    return true;
  }
  #assert code == SL_OK;
  #assert tx_hex_is(a_point[..], r.a_point);
  #assert tx_hex_is(tweak[..], r.tweak);
  scan: [32] u8; spend: [32] u8; b_spend: [33] u8; shared: [33] u8;
  #assert bip32_public(sl_hex(r.spend_key, spend[..]), b_spend[..]);
  #assert silent_shared(sl_hex(r.scan_key, scan[..]), tweak[..], shared[..], w[..]) == SL_OK;
  #assert tx_hex_is(shared[..], r.shared);
  labels: [4] SlLabel; found: [SL_K_MAX] SlFound; outputs: [32 * SL_K_MAX + 32] u8;
  count := sl_labels(r, scan[..], labels[..], w[..]);
  out := sl_hex(r.outputs, outputs[..]);
  s := silent_scan(scan[..], b_spend[..], tweak[..], out, labels[0..<count], found[..], w[..]);
  #assert s.code == SL_OK;
  #assert s.count == r.n;
  #assert sl_is_clear(w[..]);
  if r.found.count == 0 { return true; }
  // Each published output is found, with its tweak, and its key signs.
  msg: [32] u8; aux: [32] u8; sig: [64] u8; d: [32] u8; sw: [1] SignWork;
  text: [21] u8; m := "message"; t := "random auxiliary data";
  for i: 0..<m.count { text[i] = m[i]; }
  #assert sha256_hash_checked(text[0..<m.count], msg[..], false) == SHA_OK;
  for i: 0..<t.count { text[i] = t[i]; }
  #assert sha256_hash_checked(text[0..<t.count], aux[..], false) == SHA_OK;
  checked := 0;
  for i: 0..<r.n {
    row := r.found[256*i..<256*i+256];
    j := 0;
    // Equivalent: every published output is found, so the search stops at its match before j reaches s.count.
    while j < s.count && !tx_hex_is(found[j].key[..], row[0..<64]) { j += 1; } // mutant: equivalent
    #assert tx_hex_is(found[j].tweak[..], row[64..<128]);
    #assert silent_spend_key(spend[..], found[j].tweak[..], d[..]);
    status: int;
    for step: 0..<6 { status = schnorr_sign_step(d[..], aux[..], msg[..], sw[..], sig[..], false); }
    #assert status == SIGN_DONE;
    #assert tx_hex_is(sig[..], row[128..<256]);
    checked += 1;
  }
  #assert checked == r.n;
  return true;
}
// The receiver of BIP-352's K_max case.
sl_kmax :: () -> int #effects(all) {
  // Equivalent: receiver 0 is not the K_max case, so starting at 1 finds the same one.
  for i: 0..<SL_RECEIVES.count { if SL_RECEIVES[i].n == SL_K_MAX { return i; } } // mutant: equivalent
  // Equivalent: the K_max case is in the table, so the loop always returns first.
  return -1; // mutant: equivalent
}

#test "every published input gives the key BIP-352 takes from it, or none" #steps 2000000000 {
  for c: SL_CASES { x := sl_inputs(c); #assert x.all == c.inputs; }
}
#test "addresses: the constructed versions and refusals, and each recipient's keys" #steps 2000000000 {
  for a: SL_ADDRESSES {
    d := silent_decode_vartime(a.address);
    #assert d.reason == a.reason;
    if a.reason == SLA_OK { #assert d.testnet == a.testnet && d.version == a.version && tx_hex_is(d.scan[..], a.scan) && tx_hex_is(d.spend[..], a.spend); }
  }
  for p: SL_RECIPIENTS {
    d := silent_decode_vartime(p.address);
    #assert d.reason == SLA_OK && d.version == 0 && !d.testnet && tx_hex_is(d.scan[..], p.scan) && tx_hex_is(d.spend[..], p.spend);
  }
}
#forall "each receiver's addresses, unlabeled and labeled, are the published ones" i: 0..<SL_RECEIVES.count #steps 2000000000 #traversal 268435456 {
  // Each address is 116 characters, with a space between two.
  #assert sl_receiver_addresses(SL_RECEIVES[i]) == (SL_RECEIVES[i].addresses.count + 1) / 117;
}
// One check per run of cases: each check has its own budget.
// The K_max case: the key sum is the published one, and one address 2,324
// times is a group over K_max, so sending fails.
sl_group_fails :: (c: SlCase) -> bool #effects(all) {
  w: [1] SlWork; p := SL_RECIPIENTS[c.rfirst]; x := sl_inputs(c);
  #assert p.count == SL_K_MAX + 1;
  #assert c.sent == 0;
  d := silent_decode_vartime(p.address);
  recipients: [66 * (SL_K_MAX + 1)] u8; outputs: [32 * (SL_K_MAX + 1)] u8; a: [32] u8; a_point: [33] u8;
  // Equivalent: every recipient gets the same bytes, so they are one group whatever is copied, and a send refused for its group reads no key.
  for j: 0..<p.count { for b: 0..<33 { recipients[66*j + b] = d.scan[b]; recipients[66*j + 33 + b] = d.spend[b]; } } // mutant: equivalent
  #assert silent_key_sum(x.keys[0..<32*x.n], x.taproot[0..<x.n], a[..], a_point[..], w[..]) == SL_OK;
  #assert tx_hex_is(a[..], c.a_sum);
  #assert silent_send(x.keys[0..<32*x.n], x.taproot[0..<x.n], x.outpoints[0..<36*x.all], recipients[..], outputs[..], a[0..<0], w[..]).code == SL_GROUP_LIMIT;
  return true;
}
sl_sends :: (i: int) -> bool #effects(all) { c := SL_CASES[i]; return ifx SL_RECIPIENTS[c.rfirst].count != 1 then sl_group_fails(c) else sl_case_sends(c); }
#forall "each sender makes one of the published output sets, or fails as published (cases 0-9)" i: 0..<10 #steps 2000000000 {
  #assert sl_sends(i);
}
#forall "each sender makes one of the published output sets, or fails as published (cases 10-19)" i: 10..<20 #steps 2000000000 {
  #assert sl_sends(i);
}
#forall "each sender makes one of the published output sets, or fails as published (cases 20-, K_max among them)" i: 20..<SL_CASES.count #steps 2000000000 {
  #assert sl_sends(i);
}
sl_finds :: (i: int) -> bool #effects(all) { return sl_receiver_finds(SL_RECEIVES[i]); }
#forall "each receiver finds the published outputs, tweaks and signatures (0-4)" i: 0..<5 #steps 4000000000 { #assert sl_finds(i); }
#forall "each receiver finds the published outputs, tweaks and signatures (5-9)" i: 5..<10 #steps 4000000000 { #assert sl_finds(i); }
#forall "each receiver finds the published outputs, tweaks and signatures (10-14)" i: 10..<15 #steps 4000000000 { #assert sl_finds(i); }
#forall "each receiver finds the published outputs, tweaks and signatures (15-19)" i: 15..<20 #steps 4000000000 { #assert sl_finds(i); }
#forall "each receiver finds the published outputs, tweaks and signatures (20-24)" i: 20..<25 #steps 4000000000 { #assert sl_finds(i); }
#forall "each receiver finds the published outputs, tweaks and signatures (25-27)" i: 25..<28 #steps 4000000000 { #assert sl_finds(i); }
// The K_max case's whole scan: 2,323 of its 2,324 outputs.
#forall "each receiver finds the published outputs, tweaks and signatures (28-, the K_max case among them)" i: 28..<SL_RECEIVES.count #steps 4000000000 { #assert sl_finds(i); }
#test "the K_max case's last output is P_2323 with the change label: only the limit stops it" #steps 4000000000 {
  w: [1] SlWork; r := SL_RECEIVES[sl_kmax()]; x := sl_inputs(SL_CASES[r.case_]);
  tweak: [33] u8; a_point: [33] u8; scan: [32] u8; spend: [32] u8; b_spend: [33] u8; labels: [1] SlLabel; b_m: [33] u8; out: [32] u8;
  #assert silent_tweak_vartime(x.pubs[0..<33*x.n], x.outpoints[0..<36*x.all], tweak[..], a_point[..]) == SL_OK;
  #assert bip32_public(sl_hex(r.spend_key, spend[..]), b_spend[..]) && sl_labels(r, sl_hex(r.scan_key, scan[..]), labels[..], w[..]) == 1;
  #assert labels[0].m == 0 && silent_labeled_spend_vartime(b_spend[..], labels[0], b_m[..]) == SL_OK;
  #assert silent_shared(scan[..], tweak[..], scan[0..<0], w[..]) == SL_OK;
  for k: [2] int.[0, SL_K_MAX] {
    t := sl_t(k, w[..]);
    #assert t.ok && sl_output(sl_decode_vartime(b_m[..]).value, t.value, out[..]);
    #assert tx_hex_is(out[..], r.outputs[64*k..<64*k+64]);
  }
  // The same scan stopped at 3 finds exactly the first 3.
  found: [3] SlFound; outputs: [32 * (SL_K_MAX + 1)] u8;
  s := sl_scan_upto(scan[..], b_spend[..], tweak[..], sl_hex(r.outputs, outputs[..]), labels[..], found[..], 3, w[..]);
  #assert s.code == SL_OK;
  #assert s.count == 3;
  for k: 0..<3 { #assert tx_hex_is(found[k].key[..], r.outputs[64*k..<64*k+64]); }
  #assert sl_is_clear(w[..]);
}
#test "inputs: kinds, the annex, H, future witness versions and outpoints" {
  out: [33] u8; spk: [34] u8; wit: [200] u8; sig: [40] u8;
  // A P2TR key path: the output key, read as even.
  for i: 0..<34 { spk[i] = 0; }
  spk[0] = 0x51; spk[1] = 0x20; spk[33] = 5;
  wit[0] = 1; wit[1] = 64;
  #assert silent_input_key_vartime(sig[0..<0], wit[0..<66], spk[..], out[..]) == SL_IN_NONE;   // x = 5 is not on the curve
  spk[33] = 0;
  for i: 0..<32 { spk[2 + i] = SL_NUMS[i]; }                       // H is a point
  #assert silent_input_key_vartime(sig[0..<0], wit[0..<66], spk[..], out[..]) == SL_IN_P2TR && out[0] == 2;
  #assert silent_input_key_vartime(sig[0..<0], wit[0..<0], spk[..], out[..]) == SL_IN_NONE;    // no witness
  // A script path with H in the control block, with and without an annex.
  wit[0] = 3; wit[1] = 1; wit[2] = 0x51; wit[3] = 33; wit[4] = 0xc0;
  for i: 0..<32 { wit[5 + i] = SL_NUMS[i]; }
  wit[37] = 1; wit[38] = 0x50;
  #assert silent_input_key_vartime(sig[0..<0], wit[0..<39], spk[..], out[..]) == SL_IN_NONE;
  wit[0] = 2;
  #assert silent_input_key_vartime(sig[0..<0], wit[0..<37], spk[..], out[..]) == SL_IN_NONE;
  wit[5] ^= 1;
  #assert silent_input_key_vartime(sig[0..<0], wit[0..<37], spk[..], out[..]) == SL_IN_P2TR;
  // A witness with bytes after its stack is refused.
  #assert silent_input_key_vartime(sig[0..<0], wit[0..<38], spk[..], out[..]) == SL_IN_NONE;
  // Witness versions 2 to 16 are for later; 0 and 1 are not.
  fut: [42] u8;
  fut[0] = 0x52; fut[1] = 32; #assert silent_future_witness_vartime(fut[0..<34]) && !silent_future_witness_vartime(fut[0..<4]);
  fut[1] = 2; #assert silent_future_witness_vartime(fut[0..<4]) && !silent_future_witness_vartime(fut[0..<3]);
  fut[0] = 0x60; fut[1] = 40; #assert silent_future_witness_vartime(fut[..]) && !silent_future_witness_vartime(fut[0..<34]);
  fut[1] = 32;
  fut[0] = 0x51; #assert !silent_future_witness_vartime(fut[0..<34]);
  fut[0] = 0; #assert !silent_future_witness_vartime(fut[0..<34]);
  fut[0] = 0x61; #assert !silent_future_witness_vartime(fut[0..<34]);
  // Outpoints: the stored txid, then the index little-endian.
  op: [36] u8;
  #assert silent_outpoint_vartime(spk[0..<32], 0x01020304, op[..]) && op[32] == 4 && op[35] == 1 && op[0] == spk[0];
  #assert !silent_outpoint_vartime(spk[0..<31], 0, op[..]) && !silent_outpoint_vartime(spk[0..<32], -1, op[..]);
}
#test "refusals: no inputs, keys that sum to zero, bad keys and buffers" #steps 2000000000 {
  w: [1] SlWork; keys: [64] u8; a: [32] u8; a_point: [33] u8; flags: [2] bool; out: [64] u8; h: [32] u8;
  #assert silent_key_sum(keys[0..<0], flags[0..<0], a[..], a_point[..], w[..]) == SL_NO_INPUTS;
  #assert silent_key_sum(keys[0..<32], flags[0..<1], a[..], a_point[..], w[..]) == SL_BAD_KEY;          // 0
  // k and n - k sum to zero; as P2TR keys they can too.
  keys[31] = 5;
  n_minus := sc_negate(sc_small(5));
  #assert sc_store(n_minus, keys[32..<64]);
  #assert silent_key_sum(keys[..], flags[..], a[..], a_point[..], w[..]) == SL_ZERO_SUM;
  for i: 0..<32 { keys[32 + i] = 0xff; }
  #assert silent_key_sum(keys[..], flags[..], a[..], a_point[..], w[..]) == SL_BAD_KEY;                  // not below n
  #assert silent_key_sum(keys[0..<32], flags[..], a[..], a_point[..], w[..]) == SL_CAPACITY;
  #assert silent_send(keys[0..<32], flags[0..<1], keys[0..<36], keys[0..<64], out[..], out[0..<0], w[..]).code == SL_CAPACITY;
  #assert silent_tweak_vartime(keys[0..<0], keys[0..<36], a_point[..], a_point[..]) == SL_NO_INPUTS;
  #assert silent_tweak_vartime(keys[0..<33], keys[0..<36], a_point[..], a_point[..]) == SL_BAD_KEY;
  #assert silent_tweak_vartime(keys[0..<32], keys[0..<36], a_point[..], a_point[..]) == SL_CAPACITY;
  #assert !silent_input_hash_vartime(keys[0..<35], a_point[..], h[..]);
  #assert silent_shared(keys[0..<31], a_point[..], a_point[0..<0], w[..]) == SL_CAPACITY;
  labels: [1] SlLabel;
  #assert silent_label(keys[0..<32], -1, labels[..], w[..]) == SL_CAPACITY;
  #assert silent_labeled_spend_vartime(keys[0..<33], labels[0], a_point[..]) == SL_BAD_KEY;
  found: [1] SlFound;
  #assert silent_scan(a[..], a_point[0..<32], a_point[..], out[0..<32], labels[0..<0], found[..], w[..]).code == SL_CAPACITY;
  #assert !silent_spend_key(keys[0..<32], keys[32..<64], out[0..<32]);                                   // a tweak not below n
  #assert silent_spend_key(keys[0..<32], keys[0..<32], out[0..<32]);
  #assert !silent_spend_key(keys[0..<32], keys[0..<32], out[0..<33]);
  #assert silent_address_vartime(false, keys[0..<33], keys[0..<33], out[..]) == -1;                      // not a key
  #assert silent_address_vartime(false, a_point[..], a_point[..], out[0..<10]) == -1;                    // no room
  // Keys from a seed: m/352'/0'/0'/1'/0 and m/352'/0'/0'/0'/0, and not
  // the same key.
  seed: [16] u8; scan: [32] u8; spend: [32] u8;
  #assert silent_keys(seed[..], 0, 0, scan[..], spend[..]) && !sl_same_vartime(scan[..], spend[..]);
  #assert !silent_keys(seed[..], -1, 0, scan[..], spend[..]) && !silent_keys(seed[..], 0, 0, scan[0..<31], spend[..]);
}
#test "a workspace is clear only when every byte is 0, and clearing makes it so" {
  w: [1] SlWork;
  #assert sl_is_clear(w[..]);
  for i: 0..<37 { w[0].data[i] = 1; #assert !sl_is_clear(w[..]); w[0].data[i] = 0; }
  for i: 0..<32 { w[0].digest[i] = 1; #assert !sl_is_clear(w[..]); w[0].digest[i] = 0; }
  for i: 0..<33 { w[0].shared[i] = 1; #assert !sl_is_clear(w[..]); w[0].shared[i] = 0; }
  #assert sl_is_clear(w[..]);
  w[0].data[5] = 9; w[0].digest[3] = 9; w[0].shared[32] = 9;
  sl_clear(w[..]);
  #assert sl_is_clear(w[..]);
  w[0].shared[0] = 9;
  #assert sl_done(w[..], 42) == 42;
  #assert sl_is_clear(w[..]);
}
#test "a digest of 0 or at least n is no scalar; ser_32, wiping and comparing" {
  w: [1] SlWork;
  #assert !sl_digest_scalar(w[..]).ok;                                   // 0
  #assert sl_hex("fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141", w[0].digest[..]).count == 32;
  #assert !sl_digest_scalar(w[..]).ok;                                   // n
  w[0].digest[31] = 0x40;
  #assert sl_digest_scalar(w[..]).ok;                                    // n - 1
  for i: 0..<32 { w[0].digest[i] = 0xff; }
  #assert !sl_digest_scalar(w[..]).ok;
  b := [4] u8.[1, 2, 3, 4];
  sl_put32(b[..], 0x0a0b0c0d);
  #assert b[0] == 0x0a && b[1] == 0x0b && b[2] == 0x0c && b[3] == 0x0d;
  #assert !sl_same_vartime(b[0..<3], b[..]) && sl_same_vartime(b[1..<3], b[1..<3]);
  sl_wipe(b[..]);
  for i: 0..<4 { #assert b[i] == 0; }
}
#test "addresses: each key refused alone, and a buffer one character short" {
  key: [33] u8; off: [33] u8; text: [130] u8;
  key[0] = 2; for i: 0..<32 { key[1 + i] = SL_NUMS[i]; }               // H is a point
  off[0] = 2; off[32] = 5;                                               // x = 5 is not
  #assert silent_address_vartime(false, off[..], key[..], text[..]) == -1;
  #assert silent_address_vartime(false, key[..], off[..], text[..]) == -1;
  #assert silent_address_vartime(false, key[..], key[..], text[0..<115]) == -1;
  #assert silent_address_vartime(false, key[..], key[..], text[0..<116]) == 116;
  #assert silent_address_vartime(true, key[..], key[..], text[..]) == 117;
}
#test "keys from a seed: BIP-352's paths, the index bounds, and each refusal alone writes nothing" #steps 2000000000 {
  seed: [32] u8; scan: [32] u8; spend: [32] u8;
  for c: SL_KEYS {
    s := sl_hex(c.seed, seed[..]);
    #assert silent_keys(s, c.coin, c.account, scan[..], spend[..]);
    #assert tx_hex_is(scan[..], c.scan);
    #assert tx_hex_is(spend[..], c.spend);
  }
  for i: 0..<32 { scan[i] = 0xaa; spend[i] = 0xaa; }
  #assert !silent_keys(seed[0..<16], BIP32_HARDENED, 0, scan[..], spend[..]);
  #assert !silent_keys(seed[0..<16], 0, BIP32_HARDENED, scan[..], spend[..]);
  #assert !silent_keys(seed[0..<16], 0, 0, scan[..], spend[0..<31]);
  #assert !silent_keys(seed[0..<16], 0, 0, scan[0..<31], spend[..]);
  #assert !silent_keys(seed[0..<16], 0, -1, scan[..], spend[..]);
  for i: 0..<32 { #assert scan[i] == 0xaa && spend[i] == 0xaa; }
}
#test "labels: m's high bytes, its bound, B_m, and each refusal alone" #steps 2000000000 {
  w: [1] SlWork; b_scan: [32] u8; out: [2] SlLabel; spend: [33] u8; b_m: [33] u8; off: [33] u8;
  #assert sl_hex(SL_SCAN.b_scan, b_scan[..]).count == 32 && sl_hex(SL_SCAN.spend, spend[..]).count == 33;
  for c: SL_LABELS {
    w[0].shared[0] = 1;
    #assert silent_label(b_scan[..], c.m, out[0..<1], w[..]) == SL_OK;
    #assert out[0].m == c.m;
    #assert tx_hex_is(out[0].tweak[..], c.tweak);
    #assert tx_hex_is(out[0].point[..], c.point);
    #assert sl_is_clear(w[..]);
  }
  #assert silent_label(b_scan[..], 0x100000000, out[0..<1], w[..]) == SL_CAPACITY;
  #assert silent_label(b_scan[0..<31], 1, out[0..<1], w[..]) == SL_CAPACITY;
  #assert silent_label(b_scan[..], 1, out[0..<0], w[..]) == SL_CAPACITY;
  #assert silent_label(b_scan[..], 1, out[..], w[..]) == SL_CAPACITY;
  #assert silent_label(b_scan[..], 1, out[0..<1], w[0..<0]) == SL_CAPACITY;
  // B_m = B_spend + label 7's point; each bad key alone, and a sum at infinity.
  label := out[0];
  off[0] = 2; off[32] = 5;
  #assert silent_labeled_spend_vartime(spend[..], label, b_m[..]) == SL_OK;
  #assert silent_labeled_spend_vartime(off[..], label, b_m[..]) == SL_BAD_KEY;
  #assert silent_labeled_spend_vartime(spend[..], label, b_m[0..<32]) == SL_BAD_KEY;
  bad := label;
  for i: 0..<33 { bad.point[i] = off[i]; }
  #assert silent_labeled_spend_vartime(spend[..], bad, b_m[..]) == SL_BAD_KEY;
  minus := label.point;
  minus[0] ^= 1;
  #assert silent_labeled_spend_vartime(minus[..], label, b_m[..]) == SL_BAD_KEY;
}
#test "inputs: each template's bytes, a scriptSig that is the key, and witnesses of one item" #steps 2000000000 {
  key: [33] u8; h: [20] u8; out: [33] u8; none: [1] u8;
  key[0] = 2; for i: 0..<32 { key[1 + i] = SL_NUMS[i]; }
  #assert hash160_checked(key[..], h[..], false) == RMD_OK;
  // P2PKH, 76 a9 14 <hash> 88 ac, spent with a scriptSig of the key alone.
  pkh: [25] u8;
  pkh[0] = 0x76; pkh[1] = 0xa9; pkh[2] = 0x14; pkh[23] = 0x88; pkh[24] = 0xac;
  for i: 0..<20 { pkh[3 + i] = h[i]; }
  #assert silent_input_key_vartime(key[..], none[0..<0], pkh[..], out[..]) == SL_IN_P2PKH;
  #assert sl_same_vartime(out[..], key[..]);
  #assert silent_input_key_vartime(key[..], none[0..<0], pkh[..], out[0..<32]) == SL_IN_NONE;
  none[0] = 5;                                                          // claims five items, holds none
  #assert silent_input_key_vartime(key[..], none[..], pkh[..], out[..]) == SL_IN_NONE;
  pkh[0] = 0x77;
  #assert silent_input_key_vartime(key[..], none[0..<0], pkh[..], out[..]) == SL_IN_NONE;
  // Witnesses: a one-byte signature then the key, and the key alone.
  wit: [37] u8; one: [35] u8;
  wit[0] = 2; wit[1] = 1; wit[2] = 1; wit[3] = 33;
  for i: 0..<33 { wit[4 + i] = key[i]; }
  one[0] = 1; one[1] = 33;
  for i: 0..<33 { one[2 + i] = key[i]; }
  // P2SH-P2WPKH, a9 14 <hash> 87; the scriptSig pushes 00 14 and a program
  // (not checked against the hash here: zeros, so its first byte isn't 0x14).
  sh: [23] u8; ss: [23] u8;
  sh[0] = 0xa9; sh[1] = 0x14; sh[22] = 0x87;
  ss[0] = 0x16; ss[1] = 0; ss[2] = 0x14;
  #assert silent_input_key_vartime(ss[..], wit[..], sh[..], out[..]) == SL_IN_P2SH_P2WPKH;
  ss[1] = 1;
  #assert silent_input_key_vartime(ss[..], wit[..], sh[..], out[..]) == SL_IN_NONE;
  ss[1] = 0; sh[0] = 0xa8;
  #assert silent_input_key_vartime(ss[..], wit[..], sh[..], out[..]) == SL_IN_NONE;
  // P2WPKH, 00 14 <hash>, with the key as the only item.
  wpkh: [22] u8;
  wpkh[1] = 0x14;
  #assert silent_input_key_vartime(none[0..<0], one[..], wpkh[..], out[..]) == SL_IN_P2WPKH;
  wpkh[0] = 1;
  #assert silent_input_key_vartime(none[0..<0], one[..], wpkh[..], out[..]) == SL_IN_NONE;
  // P2TR, 51 20 <x>: one item whose bytes 1 to 32 are H is a key path, not
  // a control block; two items with the last empty have no annex.
  tr: [34] u8; sig: [66] u8;
  tr[0] = 0x51; tr[1] = 0x20;
  for i: 0..<32 { tr[2 + i] = SL_NUMS[i]; }
  sig[0] = 1; sig[1] = 64;
  for i: 0..<32 { sig[3 + i] = SL_NUMS[i]; }
  #assert silent_input_key_vartime(none[0..<0], sig[..], tr[..], out[..]) == SL_IN_P2TR;
  two := [4] u8.[2, 1, 0x51, 0];
  #assert silent_input_key_vartime(none[0..<0], two[..], tr[..], out[..]) == SL_IN_P2TR;
  tr[0] = 0x52;
  #assert silent_input_key_vartime(none[0..<0], sig[..], tr[..], out[..]) == SL_IN_NONE;
  // Future witness versions: a 1-byte program is too short, a 41-byte one too long.
  fut: [43] u8;
  fut[0] = 0x52; fut[1] = 1;
  #assert !silent_future_witness_vartime(fut[0..<3]);
  fut[1] = 41;
  #assert !silent_future_witness_vartime(fut[..]);
  // Outpoints: the largest index, and one more.
  op: [36] u8;
  #assert silent_outpoint_vartime(tr[0..<32], 0xffffffff, op[..]) && op[32] == 0xff && op[35] == 0xff;
  #assert !silent_outpoint_vartime(tr[0..<32], 0x100000000, op[..]);
}
#test "input_hash: the smallest outpoint byte by byte, two equal ones, and none" {
  ops: [72] u8; a: [33] u8; h1: [32] u8; h2: [32] u8;
  #assert !silent_input_hash_vartime(ops[0..<0], a[..], h1[..]);
  ops[0] = 1; ops[37] = 1;                                               // 01 00 ... then 00 01 ...: the second is smaller
  #assert silent_input_hash_vartime(ops[..], a[..], h1[..]);
  #assert silent_input_hash_vartime(ops[36..<72], a[..], h2[..]);
  #assert sl_same_vartime(h1[..], h2[..]);
  for i: 0..<36 { ops[i] = ops[36 + i]; }
  #assert silent_input_hash_vartime(ops[..], a[..], h1[..]);
  #assert sl_same_vartime(h1[..], h2[..]);
}
#test "sending and the tweak: each refusal alone, and bad keys found late" #steps 2000000000 {
  w: [1] SlWork; keys: [32] u8; flags: [1] bool; a: [32] u8; a_point: [33] u8; ops: [36] u8; out: [64] u8;
  key: [33] u8; off: [33] u8; to: [67] u8; bad: [66] u8;
  keys[31] = 5;
  key[0] = 2; for i: 0..<32 { key[1 + i] = SL_NUMS[i]; }
  off[0] = 2; off[32] = 5;
  for i: 0..<33 { to[i] = key[i]; to[33 + i] = key[i]; }
  #assert silent_key_sum(keys[..], flags[..], a[..], a_point[..], w[0..<0]) == SL_CAPACITY;
  #assert silent_send(keys[..], flags[..], ops[..], to[0..<66], out[..], out[0..<0], w[0..<0]).code == SL_CAPACITY;
  #assert silent_send(keys[..], flags[..], ops[..], to[..], out[..], out[0..<0], w[..]).code == SL_CAPACITY;
  #assert silent_send(keys[..], flags[..], ops[0..<35], to[0..<66], out[..], out[0..<0], w[..]).code == SL_HASH_RANGE;
  #assert silent_send(keys[..], flags[..], ops[..], to[0..<66], out[0..<32], out[0..<0], w[..]).code == SL_OK;
  for i: 0..<33 { bad[i] = off[i]; bad[33 + i] = key[i]; }
  #assert silent_send(keys[..], flags[..], ops[..], bad[..], out[..], out[0..<0], w[..]).code == SL_BAD_KEY;
  #assert sl_is_clear(w[..]);
  for i: 0..<33 { bad[i] = key[i]; bad[33 + i] = off[i]; }
  #assert silent_send(keys[..], flags[..], ops[..], bad[..], out[..], out[0..<0], w[..]).code == SL_BAD_KEY;
  #assert sl_is_clear(w[..]);
  // The tweak: keys that sum to infinity, and outpoints that don't parse.
  pubs: [66] u8; tweak: [33] u8;
  for i: 0..<33 { pubs[i] = key[i]; pubs[33 + i] = key[i]; }
  pubs[33] = 3;
  #assert silent_tweak_vartime(pubs[..], ops[..], tweak[..], a_point[..]) == SL_ZERO_SUM;
  #assert silent_tweak_vartime(pubs[0..<33], ops[0..<35], tweak[..], a_point[..]) == SL_HASH_RANGE;
  // The shared secret: a bad tweak, b_scan 0 and b_scan not below n each refused, writing nothing.
  b: [32] u8; o: [33] u8;
  for i: 0..<33 { o[i] = 0xaa; }
  b[31] = 5;
  #assert silent_shared(b[..], off[..], o[..], w[..]) == SL_BAD_KEY;
  b[31] = 0;
  #assert silent_shared(b[..], key[..], o[..], w[..]) == SL_BAD_KEY;
  for i: 0..<32 { b[i] = 0xff; }
  #assert silent_shared(b[..], key[..], o[..], w[..]) == SL_BAD_KEY;
  for i: 0..<33 { #assert o[i] == 0xaa; }
}
#test "groups of recipients: counted from each group's first member, at and over the limit" #steps 2000000000 {
  // A recipient here is 66 equal bytes; only the scan key half is compared.
  rc: [66 * 110] u8;
  // B A A A: A's group starts second.
  for i: 0..<66 { rc[i] = 11; rc[66 + i] = 10; rc[132 + i] = 10; rc[198 + i] = 10; }
  #assert !sl_groups_fit_vartime(rc[0..<264], 2);
  #assert sl_groups_fit_vartime(rc[0..<264], 3);
  // 1 2 1: a group of two at limit 2, over limit 1.
  for i: 0..<66 { rc[i] = 1; rc[66 + i] = 2; rc[132 + i] = 1; }
  #assert sl_groups_fit_vartime(rc[0..<198], 2);
  #assert !sl_groups_fit_vartime(rc[0..<198], 1);
  // 110 recipients: 108 different, then a pair.
  for k: 0..<108 { for i: 0..<66 { rc[66*k + i] = cast(u8) (20 + k); } }
  for i: 0..<132 { rc[66*108 + i] = 5; }
  #assert sl_groups_fit_vartime(rc[..], 2);
  #assert !sl_groups_fit_vartime(rc[..], 1);
  #assert sl_groups_fit_vartime(rc[0..<66*109], 1);
}
#test "scanning: outputs found out of order and far apart, a label, and each refusal" #steps 4000000000 {
  w: [1] SlWork; b_scan: [32] u8; spend: [33] u8; tweak: [33] u8; off: [33] u8;
  #assert sl_hex(SL_SCAN.b_scan, b_scan[..]).count == 32 && sl_hex(SL_SCAN.spend, spend[..]).count == 33;
  #assert sl_hex(SL_SCAN.tweak, tweak[..]).count == 33;
  outputs: [32 * 400] u8; found: [8] SlFound; labels: [1] SlLabel;
  at := [7] int.[0, 17, 9, 8, 16, 18, 370];
  for k: 0..<7 { #assert sl_hex(SL_SCAN.keys[64*k..<64*k+64], outputs[32*at[k]..<32*at[k]+32]).count == 32; }
  s := silent_scan(b_scan[..], spend[..], tweak[..], outputs[..], labels[0..<0], found[..], w[..]);
  #assert s.code == SL_OK;
  #assert s.count == 7;
  #assert sl_is_clear(w[..]);
  for k: 0..<7 {
    #assert found[k].output == at[k];
    #assert found[k].label == -1;
    #assert tx_hex_is(found[k].key[..], SL_SCAN.keys[64*k..<64*k+64]);
    #assert tx_hex_is(found[k].tweak[..], SL_SCAN.tweaks[64*k..<64*k+64]);
  }
  // P_0 plus label 7's point, then P_1; then the same with room for one.
  #assert silent_label(b_scan[..], 7, labels[..], w[..]) == SL_OK;
  two: [64] u8;
  #assert sl_hex(SL_SCAN.labeled, two[0..<32]).count == 32 && sl_hex(SL_SCAN.keys[64..<128], two[32..<64]).count == 32;
  s = silent_scan(b_scan[..], spend[..], tweak[..], two[..], labels[..], found[..], w[..]);
  #assert s.code == SL_OK;
  #assert s.count == 2;
  #assert found[0].output == 0 && found[0].label == 7 && tx_hex_is(found[0].tweak[..], SL_SCAN.labeled_tweak);
  #assert found[1].output == 1 && found[1].label == -1;
  s = silent_scan(b_scan[..], spend[..], tweak[..], two[..], labels[..], found[0..<1], w[..]);
  #assert s.code == SL_CAPACITY;
  #assert s.count == 1;
  #assert sl_is_clear(w[..]);
  // Outputs not a multiple of 32 bytes, and a B_spend that is not a key.
  #assert silent_scan(b_scan[..], spend[..], tweak[..], outputs[0..<33], labels[..], found[..], w[..]).code == SL_CAPACITY;
  off[0] = 2; off[32] = 5;
  #assert silent_scan(b_scan[..], off[..], tweak[..], outputs[..], labels[..], found[..], w[..]).code == SL_BAD_KEY;
}
#test "scanning: the most outputs a transaction can have, and one more" #steps 4000000000 {
  w: [1] SlWork; b_scan: [32] u8; spend: [33] u8; tweak: [33] u8; found: [1] SlFound; labels: [1] SlLabel;
  #assert sl_hex(SL_SCAN.b_scan, b_scan[..]).count == 32 && sl_hex(SL_SCAN.spend, spend[..]).count == 33;
  #assert sl_hex(SL_SCAN.tweak, tweak[..]).count == 33;
  big: [32 * (SL_MAX_OUTPUTS + 1)] u8;
  s := silent_scan(b_scan[..], spend[..], tweak[..], big[0..<32 * SL_MAX_OUTPUTS], labels[0..<0], found[..], w[..]);
  #assert s.code == SL_OK && s.count == 0;
  #assert silent_scan(b_scan[..], spend[..], tweak[..], big[..], labels[0..<0], found[..], w[..]).code == SL_CAPACITY;
}
#test "the check helpers: a word of a space-separated list" {
  #assert sl_word("a bcd ef", 0) == "a";
  #assert sl_word("a bcd ef", 1) == "bcd";
  #assert sl_word("a bcd ef", 2) == "ef";
}
