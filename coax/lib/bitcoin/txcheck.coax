// Transaction checks outside script (Bitcoin chapter 52): the rules a
// transaction must pass before any of its scripts run. Bitcoin Core's
// CheckTransaction (consensus/tx_check.cpp) needs only the transaction:
// at least one input and one output, a size that fits a block, output
// values and their total within 0..MAX_MONEY (CVE-2010-5139), no input
// spent twice (CVE-2018-17144), a coinbase script of 2 to 100 bytes, and
// no null outpoint outside a coinbase. Consensus::CheckTxInputs
// (consensus/tx_verify.cpp) needs the coins it spends: each one exists and
// is unspent, a coinbase's coins wait 100 blocks, input values and their
// total stay within range, and the inputs pay at least the outputs. Last,
// a transaction in a block must be final (IsFinalTx), measured against the
// median time past once CSV (BIP-113) is active.
//
// The reader is chapter 34's (tx.coax), the fee's range checks chapter
// 40's (fees.coax), IsFinalTx and the median time past chapter 39's
// (locktime.coax), and the CSV height chapter 50's (chainparams.coax).
// coax/tests/bitcoin/txcheck.py checks the reasons and constants against
// the pinned Core sources and replays the example.
//
// Transactions and coins are public, so everything here runs in variable
// time and every procedure that decides ends in _vartime (Bitcoin
// chapter 3).
#load "fees.coax";
#load "locktime.coax";
#load "chainparams.coax";
#load "../../tests/bitcoin/txcheck_vectors.coax";
#authority;

// book:begin codes
// Result codes, with Core's reject reason.
TXC_OK :: 0;
TXC_VIN_EMPTY :: 1;          // "bad-txns-vin-empty"
TXC_VOUT_EMPTY :: 2;         // "bad-txns-vout-empty"
TXC_OVERSIZE :: 3;           // "bad-txns-oversize"
TXC_VOUT_NEGATIVE :: 4;      // "bad-txns-vout-negative"
TXC_VOUT_TOOLARGE :: 5;      // "bad-txns-vout-toolarge"
TXC_VOUT_TOTAL :: 6;         // "bad-txns-txouttotal-toolarge"
TXC_DUPLICATE :: 7;          // "bad-txns-inputs-duplicate"
TXC_CB_LENGTH :: 8;          // "bad-cb-length"
TXC_PREVOUT_NULL :: 9;       // "bad-txns-prevout-null"
TXC_MISSING :: 10;           // "bad-txns-inputs-missingorspent"
TXC_PREMATURE :: 11;         // "bad-txns-premature-spend-of-coinbase"
TXC_INPUT_RANGE :: 12;       // "bad-txns-inputvalues-outofrange"
TXC_IN_BELOW_OUT :: 13;      // "bad-txns-in-belowout"
TXC_FEE_RANGE :: 14;         // "bad-txns-fee-outofrange": unreachable, as in Core
TXC_NONFINAL :: 15;          // "bad-txns-nonfinal"
TXC_CONTEXT :: 16;           // the transaction did not read, or the coins are not one per input
TXC_REASONS :: [17] string.["ok", "bad-txns-vin-empty", "bad-txns-vout-empty", "bad-txns-oversize",
  "bad-txns-vout-negative", "bad-txns-vout-toolarge", "bad-txns-txouttotal-toolarge",
  "bad-txns-inputs-duplicate", "bad-cb-length", "bad-txns-prevout-null",
  "bad-txns-inputs-missingorspent", "bad-txns-premature-spend-of-coinbase",
  "bad-txns-inputvalues-outofrange", "bad-txns-in-belowout", "bad-txns-fee-outofrange",
  "bad-txns-nonfinal", "bad context"];
// book:end codes

// book:begin limits
TXC_COINBASE_MATURITY :: 100;   // consensus.h COINBASE_MATURITY
TXC_CB_MIN :: 2;                // a coinbase scriptSig's bounds in CheckTransaction
TXC_CB_MAX :: 100;
// MAX_MONEY is chapter 40's FEE_MAX_MONEY, MAX_BLOCK_WEIGHT its
// FEE_MAX_BLOCK_WEIGHT, and WITNESS_SCALE_FACTOR chapter 34's TX_SCALE.
txc_money_range :: (v: int) -> bool #export_c { return v >= 0 && v <= FEE_MAX_MONEY; }
// book:end limits

// book:begin outpoints
// An outpoint is 36 bytes: the txid, then the output index. It is null
// when the txid is zero and the index is 0xffffffff.
txc_null_vartime :: (b: [] u8, at: int) -> bool #export_c {
  for i: 0..<32 { if b[at+i] != 0 { return false; } }
  return tx_le_vartime(b, at + 32, 4) == 0xffffffff;
}
txc_same_vartime :: (b: [] u8, x: int, y: int) -> bool #export_c {
  for i: 0..<36 { if b[x+i] != b[y+i] { return false; } }
  return true;
}
// book:end outpoints

// book:begin check
// Core's CheckTransaction, its rules in its order, on a transaction read
// by tx_read_vartime. The size is the stripped size: the witness is not
// counted, because it is not yet known to be the right one. The duplicate
// search compares every pair of inputs; Core sorts them into a set.
txcheck_vartime :: (b: [] u8, t: Tx, ins: [] TxIn, outs: [] TxOut) -> int #export_c {
  if t.code != TX_OK { return TXC_CONTEXT; }
  if t.nin == 0 { return TXC_VIN_EMPTY; }
  if t.nout == 0 { return TXC_VOUT_EMPTY; }
  if t.stripped * TX_SCALE > FEE_MAX_BLOCK_WEIGHT { return TXC_OVERSIZE; }
  total := 0;
  for k: 0..<t.nout {
    v := tx_le_vartime(b, outs[k].value, 8);
    if v < 0 { return TXC_VOUT_NEGATIVE; }
    if v > FEE_MAX_MONEY { return TXC_VOUT_TOOLARGE; }
    total += v;
    if !txc_money_range(total) { return TXC_VOUT_TOTAL; }
  }
  for i: 1..<t.nin {
    for j: 0..<i { if txc_same_vartime(b, ins[i].outpoint, ins[j].outpoint) { return TXC_DUPLICATE; } }
  }
  if tx_coinbase_vartime(b, t, ins) {
    if ins[0].script_n < TXC_CB_MIN || ins[0].script_n > TXC_CB_MAX { return TXC_CB_LENGTH; }
  } else {
    for k: 0..<t.nin { if txc_null_vartime(b, ins[k].outpoint) { return TXC_PREVOUT_NULL; } }
  }
  return TXC_OK;
}
// book:end check

// book:begin inputs
// The coin an input spends, as the UTXO set holds it (chapter 56): found
// is false when it is missing or spent.
TxcCoin :: struct { found: bool; value: int; height: int; coinbase: bool; }
TxcInputs :: struct { code: int; fee: int; }
// Core's CheckTxInputs for a transaction that passed CheckTransaction,
// spent in a block at spend_height. coins holds one coin per input.
txcheck_inputs_vartime :: (b: [] u8, t: Tx, outs: [] TxOut, coins: [] TxcCoin, spend_height: int) -> TxcInputs #export_c {
  r: TxcInputs;
  if t.code != TX_OK || coins.count != t.nin { r.code = TXC_CONTEXT; return r; }
  for k: 0..<coins.count { if !coins[k].found { r.code = TXC_MISSING; return r; } }
  value_in := 0;
  for k: 0..<coins.count {
    c := coins[k];
    if c.coinbase && spend_height - c.height < TXC_COINBASE_MATURITY { r.code = TXC_PREMATURE; return r; }
    value_in += c.value;
    if !txc_money_range(c.value) || !txc_money_range(value_in) { r.code = TXC_INPUT_RANGE; return r; }
  }
  value_out := 0;
  for k: 0..<t.nout { value_out += tx_le_vartime(b, outs[k].value, 8); }
  if value_in < value_out { r.code = TXC_IN_BELOW_OUT; return r; }
  r.fee = value_in - value_out;
  if !txc_money_range(r.fee) { r.code = TXC_FEE_RANGE; return r; }
  return r;
}
// book:end inputs

// book:begin final
// ContextualCheckBlock's lock-time rule: every transaction of a block at
// height must be final. Before CSV, IsFinalTx compares time lock times
// with the block's own time; from CSV's height (BIP-113) with the median
// time past of the 11 blocks before it.
txcheck_final_vartime :: (p: ChainParams, b: [] u8, t: Tx, ins: [] TxIn, height: int, prev_mtp: int, block_time: int) -> int #export_c {
  if t.code != TX_OK { return TXC_CONTEXT; }
  cutoff := ifx chain_deployment_active(p, DEP_CSV, height) then prev_mtp else block_time;
  if !locktime_final_vartime(b, t, ins, height, cutoff) { return TXC_NONFINAL; }
  return TXC_OK;
}
// book:end final

// ---- tests
// Read hex into raw with the reader's arrays; returns the transaction and
// its length.
TxcRead :: struct { t: Tx; n: int; }
txc_read :: (text: string, raw: [] u8, ins: [] TxIn, outs: [] TxOut, items: [] TxItem) -> TxcRead {
  r: TxcRead;
  r.n = cp_unhex(text, raw);
  #assert r.n >= 0;
  b := raw;
  r.t = tx_read_vartime(b[0..<r.n], true, ins, outs, items);
  return r;
}
txc_code :: (text: string) -> int {
  raw: [2048] u8; ins: [16] TxIn; outs: [16] TxOut; items: [16] TxItem;
  r := txc_read(text, raw[..], ins[..], outs[..], items[..]);
  return txcheck_vartime(raw[0..<r.n], r.t, ins[..], outs[..]);
}
#test "Core's BADTX cases, and every other case passes" #steps 1000000000 {
  want := [9] int.[TXC_VOUT_EMPTY, TXC_VOUT_NEGATIVE, TXC_VOUT_TOOLARGE, TXC_VOUT_TOTAL, TXC_DUPLICATE, TXC_CB_LENGTH, TXC_CB_LENGTH, TXC_PREVOUT_NULL, TXC_PREVOUT_NULL];
  bad := 0; good := 0;
  for i: 0..<TXCHECK_CASES.count {
    c := TXCHECK_CASES[i];
    code := txc_code(c.tx);
    if c.badtx { #assert code == want[bad]; bad += 1; }
    else { #assert code == TXC_OK; good += 1; }
  }
  #assert bad == 9 && good == TXCHECK_CASES.count - 9;
}
#test "no inputs, the size bound, and the money bounds" {
  // Version, an input count of 0, a flag of 0 (so no outputs are read), lock time.
  #assert txc_code("01000000000000000000") == TXC_VIN_EMPTY;
  // Chapter 34's legacy example is a coinbase whose script is one byte.
  #assert txc_code(TX_LEGACY_OK) == TXC_CB_LENGTH;
  raw: [2048] u8; ins: [16] TxIn; outs: [16] TxOut; items: [16] TxItem;
  r := txc_read(TXCHECK_CASES[0].tx, raw[..], ins[..], outs[..], items[..]);
  b := raw[0..<r.n];
  #assert r.t.code == TX_OK && txcheck_vartime(b, r.t, ins[..], outs[..]) == TXC_OK;
  t := r.t;
  t.stripped = FEE_MAX_BLOCK_WEIGHT / TX_SCALE;
  #assert txcheck_vartime(b, t, ins[..], outs[..]) == TXC_OK;
  t.stripped += 1;
  #assert txcheck_vartime(b, t, ins[..], outs[..]) == TXC_OVERSIZE;
  t.code = TX_TRUNCATED;
  #assert txcheck_vartime(b, t, ins[..], outs[..]) == TXC_CONTEXT;
  #assert txc_money_range(0) && txc_money_range(FEE_MAX_MONEY) && !txc_money_range(-1) && !txc_money_range(FEE_MAX_MONEY + 1);
  #assert TXC_REASONS[TXC_DUPLICATE] == "bad-txns-inputs-duplicate" && TXC_REASONS[TXC_NONFINAL] == "bad-txns-nonfinal";
}
// Little-endian bytes of v at at.
txc_put :: (raw: [] u8, at: int, v: int, width: int) {
  for j: 0..<width { raw[at+j] = cast,trunc(u8) (v >> (8 * j)); }
}
#test "CheckTxInputs: maturity, ranges and the fee" {
  raw: [2048] u8; ins: [16] TxIn; outs: [16] TxOut; items: [16] TxItem;
  // tx_valid's first case, one input, its output set to 1,000,000.
  r := txc_read(TXCHECK_CASES[0].tx, raw[..], ins[..], outs[..], items[..]);
  txc_put(raw[..], outs[0].value, 1000000, 8);
  b := raw[0..<r.n];
  coin: [1] TxcCoin;
  coin[0] = TxcCoin.{found=true, value=1500000, height=500, coinbase=true};
  #assert txcheck_inputs_vartime(b, r.t, outs[..], coin[..], 599).code == TXC_PREMATURE;
  ok := txcheck_inputs_vartime(b, r.t, outs[..], coin[..], 600);
  #assert ok.code == TXC_OK && ok.fee == 500000;
  coin[0].coinbase = false;
  #assert txcheck_inputs_vartime(b, r.t, outs[..], coin[..], 501).code == TXC_OK;
  coin[0].value = 999999;
  #assert txcheck_inputs_vartime(b, r.t, outs[..], coin[..], 501).code == TXC_IN_BELOW_OUT;
  coin[0].value = 1000000;
  #assert txcheck_inputs_vartime(b, r.t, outs[..], coin[..], 501).fee == 0;
  coin[0].value = FEE_MAX_MONEY + 1;
  #assert txcheck_inputs_vartime(b, r.t, outs[..], coin[..], 501).code == TXC_INPUT_RANGE;
  coin[0].value = -1;
  #assert txcheck_inputs_vartime(b, r.t, outs[..], coin[..], 501).code == TXC_INPUT_RANGE;
  coin[0].found = false;
  #assert txcheck_inputs_vartime(b, r.t, outs[..], coin[..], 501).code == TXC_MISSING;
  #assert txcheck_inputs_vartime(b, r.t, outs[..], coin[0..<0], 501).code == TXC_CONTEXT;
  // Two inputs, each within range, whose total is not.
  r2 := txc_read(TXCHECK_CASES[9].tx, raw[..], ins[..], outs[..], items[..]);
  #assert r2.t.nin >= 2;
  two: [16] TxcCoin;
  for k: 0..<r2.t.nin { two[k] = TxcCoin.{found=true, value=FEE_MAX_MONEY / 2 + 1, height=1}; }
  #assert txcheck_inputs_vartime(raw[0..<r2.n], r2.t, outs[..], two[0..<r2.t.nin], 10).code == TXC_INPUT_RANGE;
}
#test "a transaction in a block is final against the median after CSV" {
  raw: [2048] u8; ins: [16] TxIn; outs: [16] TxOut; items: [16] TxItem;
  r := txc_read(TXCHECK_CASES[0].tx, raw[..], ins[..], outs[..], items[..]);
  // A time lock of 1,500,000,000 and a sequence that is not final.
  lock := 1500000000;
  txc_put(raw[..], r.t.locktime, lock, 4);
  txc_put(raw[..], ins[0].sequence, 0xfffffffe, 4);
  b := raw[0..<r.n];
  m := CHAIN_MAINNET_PARAMS;
  #assert txcheck_final_vartime(m, b, r.t, ins[..], 419327, lock - 1, lock + 1) == TXC_OK;
  #assert txcheck_final_vartime(m, b, r.t, ins[..], 419328, lock - 1, lock + 1) == TXC_NONFINAL;
  #assert txcheck_final_vartime(m, b, r.t, ins[..], 419328, lock + 1, lock + 1) == TXC_OK;
  #assert txcheck_final_vartime(m, b, r.t, ins[..], 419327, lock + 1, lock) == TXC_NONFINAL;
  txc_put(raw[..], ins[0].sequence, 0xffffffff, 4);
  #assert txcheck_final_vartime(m, b, r.t, ins[..], 419328, 0, 0) == TXC_OK;
  t := r.t;
  t.code = TX_TRAILING;
  #assert txcheck_final_vartime(m, b, t, ins[..], 419328, 0, 0) == TXC_CONTEXT;
}
#test "outpoints: null and equal" {
  z: [72] u8;
  for i: 0..<72 { z[i] = 0; }
  #assert !txc_null_vartime(z[..], 0) && txc_same_vartime(z[..], 0, 36);
  for i: 32..<36 { z[i] = 0xff; }
  #assert txc_null_vartime(z[..], 0) && !txc_same_vartime(z[..], 0, 36);
  z[0] = 1;
  #assert !txc_null_vartime(z[..], 0);
}
