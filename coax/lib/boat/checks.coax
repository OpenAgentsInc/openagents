  #assert bt_file_body(b[..], "/x", "aGk=", true).text == "{\"path\":\"/x\",\"content\":\"aGk=\",\"encoding\":\"base64\"}";
  #assert bt_file_body(b[..], "x", "", false).problem == "a file path is absolute" && bt_file_body(b[..], "", "", false).text == "";
  #assert bt_save_body(b[..], "bx_fwh3xnws", "oa-devbox-20261114").text == "{\"sandboxId\":\"bx_fwh3xnws\",\"name\":\"oa-devbox-20261114\"}";
  #assert bt_save_body(b[..], "bx_nope", "a").text == "" && bt_save_body(b[..], "bx_fwh3xnws", "a b").text == "";
  #assert bt_sshkey_body(b[..], "ssh-ed25519 AAAAC3Nza oa@mac").text == "{\"key\":\"ssh-ed25519 AAAAC3Nza oa@mac\"}";
  #assert bt_sshkey_body(b[..], "ecdsa-sha2-nistp256 AAAA").text == "{\"key\":\"ecdsa-sha2-nistp256 AAAA\"}";
  #assert bt_sshkey_body(b[..], "-----BEGIN OPENSSH PRIVATE KEY-----").problem == "not an OpenSSH public key";
  #assert bt_sshkey_body(b[..], "ssh-ed25519 AAAA\nssh-rsa B").problem == "a public key is one line" && bt_sshkey_body(b[..], "ssh-ed2").text == "";
  #assert bt_env_body(b[..], "oa-devbox").text == "{\"name\":\"oa-devbox\"}" && bt_env_body(b[..], "a b").text == "";
  #assert bt_var_body(b[..], "v\"1").text == "{\"value\":\"v\\\"1\"}" && bt_var_body(b[..], "").text == "";
}

