BtCheck :: struct {
  out: [65536] u8;
  arena: [65536] u8;
  log: [16384] u8;
  ar: [1] ClArena;
  fake: [1] BtFake;
}

bt_check_init :: (k: [] BtCheck, answers: [] string) -> BoatClient {
  k[0].ar[0] = ClArena.{buf = k[0].arena[..]};
  k[0].fake[0] = BtFake.{answers = answers, log = k[0].log[..]};
  return BoatClient.{base = "http://127.0.0.1:8790/api/v1", fake = k[0].fake[..]};
}

bt_check_get :: (c: BoatClient, k: [] BtCheck) -> BtError { k[0].ar[0].at = 0; return bt_get(c, "bx_fwh3xnws", k[0].out[..], k[0].ar[..]).error; }

bt_check_log :: (k: [] BtCheck) -> string { return cast(string) k[0].log[0..<k[0].fake[0].nlog]; }

bt_has :: (s: string, part: string) -> bool {
  if part.count == 0 { return true; }
  i := 0;
  while i + part.count <= s.count { if cast(string) s[i..<i + part.count] == part { return true; } i += 1; }
  return false;
}

#test "names: sandbox ids are bx_ and boat's 8 letters; names go into paths plain" {
  #assert bt_id_ok("bx_fwh3xnws") && bt_id_ok("bx_sg2zeu8d") && bt_id_ok("bx_23456789") && bt_id_ok("bx_zzzzzzzz");
  #assert !bt_id_ok("bx_fwh3xnw") && !bt_id_ok("bx_fwh3xnwss") && !bt_id_ok("bx-fwh3xnws") && !bt_id_ok("ax_fwh3xnws") && !bt_id_ok("by_fwh3xnws") && !bt_id_ok("bx.fwh3xnws");
  #assert !bt_id_ok("bx_fwh3xnwl") && !bt_id_ok("bx_fwh3xnwo") && !bt_id_ok("bx_fwh3xnwi") && !bt_id_ok("bx_fwh3xnw1") && !bt_id_ok("bx_fwh3xnw0") && !bt_id_ok("bx_FWH3XNWS") && !bt_id_ok("bx_fwh3xn/s");
  #assert bt_name_ok("oa-devbox-20261113") && bt_name_ok("a") && bt_name_ok("CLAUDE_CODE_OAUTH_TOKEN") && bt_name_ok("v1.2");
  #assert !bt_name_ok("") && !bt_name_ok("-x") && !bt_name_ok(".x") && !bt_name_ok("a/b") && !bt_name_ok("a b") && !bt_name_ok("a?b");
  #assert bt_name_ok("0123456789012345678901234567890123456789012345678901234567890123") && !bt_name_ok("01234567890123456789012345678901234567890123456789012345678901234");
  #assert bt_type_ok("small") && bt_type_ok("default") && bt_type_ok("large") && bt_type_ok("xlarge") && !bt_type_ok("huge") && !bt_type_ok("");
}

#test "create: from, type, environment and a TTL; noEnv when no environment; never env" {
  b: [512] u8;
  #assert bt_create_body(b[..], BtCreate.{from = "oa-devbox-20261113", environment = "oa-devbox", name = "oa-devbox-2", ttl_s = 43200}).text == "{\"type\":\"large\",\"from\":\"oa-devbox-20261113\",\"name\":\"oa-devbox-2\",\"environment\":\"oa-devbox\",\"ttlSeconds\":43200}";
  #assert bt_create_body(b[..], BtCreate.{type = "small"}).text == "{\"type\":\"small\",\"noEnv\":true}";
  #assert bt_create_body(b[..], BtCreate.{ttl_s = 0}).text == "{\"type\":\"large\",\"noEnv\":true,\"ttlSeconds\":null}";
  #assert bt_create_body(b[..], BtCreate.{type = "huge"}).problem == "the type is small, default, large or xlarge";
  #assert bt_create_body(b[..], BtCreate.{from = "a b"}).text == "" && bt_create_body(b[..], BtCreate.{environment = "x\"y"}).text == "" && bt_create_body(b[..], BtCreate.{name = "/"}).text == "";
  small: [20] u8;
  #assert bt_create_body(small[..], BtCreate.{}).problem == "the request does not fit its buffer";
}

#test "resume, stop, update: the bodies boat takes" {
  b: [256] u8;
  #assert bt_resume_body(b[..], BtResume.{}).text == "{\"failFast\":true}";
  #assert bt_resume_body(b[..], BtResume.{type = "large", environment = "oa-devbox", ttl_s = 3600}).text == "{\"failFast\":true,\"type\":\"large\",\"environment\":\"oa-devbox\",\"ttlSeconds\":3600}";
  #assert bt_resume_body(b[..], BtResume.{type = "tiny"}).text == "" && bt_resume_body(b[..], BtResume.{environment = "a b"}).text == "";
  #assert bt_stop_body(b[..], false).text == "{}" && bt_stop_body(b[..], true).text == "{\"force\":true}";
  #assert bt_update_body(b[..], "", 28800).text == "{\"ttlSeconds\":28800}";
  #assert bt_update_body(b[..], "box-2", 0).text == "{\"name\":\"box-2\",\"ttlSeconds\":null}";
  #assert bt_update_body(b[..], "box-2", -1).text == "{\"name\":\"box-2\"}";
  #assert bt_update_body(b[..], "", -1).problem == "nothing to change" && bt_update_body(b[..], "a b", 5).text == "";
}

#test "commands: synchronous within 600 s, streamed, detached with no timeout" {
  b: [512] u8;
  #assert bt_command_body(b[..], "echo hi && uname -a", "", 0, BtMode.sync).text == "{\"command\":\"echo hi && uname -a\"}";
  #assert bt_command_body(b[..], "npm test", "/home/user/oa", 600, BtMode.stream).text == "{\"command\":\"npm test\",\"cwd\":\"/home/user/oa\",\"timeoutSeconds\":600,\"stream\":true}";
  #assert bt_command_body(b[..], "coax/build.sh", "/home/user/oa", 0, BtMode.detached).text == "{\"command\":\"coax/build.sh\",\"cwd\":\"/home/user/oa\",\"detached\":true}";
  #assert bt_command_body(b[..], "x", "", 601, BtMode.sync).problem == "a command's timeout is 1 to 600 seconds; run longer work detached";
  #assert bt_command_body(b[..], "x", "", -1, BtMode.sync).text == "";
  #assert bt_command_body(b[..], "x", "", 60, BtMode.detached).problem == "a detached command takes no timeout";
  #assert bt_command_body(b[..], "", "", 0, BtMode.sync).problem == "no command";
  #assert bt_command_body(b[..], "say \"hi\"\n", "", 1, BtMode.sync).text == "{\"command\":\"say \\\"hi\\\"\\n\",\"timeoutSeconds\":1}";
}

#test "files, saved snapshots, SSH keys, environments and their variables" {
