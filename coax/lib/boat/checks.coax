#test "stop answers while the box is still archiving; a resume then is refused as stopping, and retried" {
  k: [1] BtCheck; answers := [3] string.[BT_FX_STOP, BT_FX_RESUME_STOPPING, BT_FX_RESUME];
  c := bt_check_init(k[..], answers[..]);
  r := bt_stop(c, "bx_fwh3xnws", false, k[0].out[..], k[0].ar[..]);
  a := bt_read_action(k[0].ar[..], r.body);
  #assert !bt_failed(r.error) && a.status == "archiving" && a.stop_id == "stop_7k2m" && a.stop_status == "pending";
  r = bt_resume(c, "bx_fwh3xnws", BtResume.{ttl_s = 43200}, k[0].out[..], k[0].ar[..]);
  #assert r.error.kind == BtErrKind.stopping && r.error.retryable && r.error.code == "sandbox_stopping" && r.status == 409;
  r = bt_resume(c, "bx_fwh3xnws", BtResume.{ttl_s = 43200}, k[0].out[..], k[0].ar[..]);
  #assert !bt_failed(r.error) && bt_read_sandbox(k[0].ar[..], r.body).state == "provisioning";
  #assert bt_check_log(k[..]) == "POST /sandboxes/bx_fwh3xnws/stop {}\nPOST /sandboxes/bx_fwh3xnws/resume {\"failFast\":true,\"ttlSeconds\":43200}\nPOST /sandboxes/bx_fwh3xnws/resume {\"failFast\":true,\"ttlSeconds\":43200}\n";
  r = bt_stop(c, "nope", false, k[0].out[..], k[0].ar[..]);
  #assert r.error.kind == BtErrKind.config;
  r = bt_resume(c, "bx_fwh3xnws", BtResume.{type = "huge"}, k[0].out[..], k[0].ar[..]);
  #assert r.error.kind == BtErrKind.config && r.error.why == "the type is small, default, large or xlarge";
}

#test "every error kind, from boat's bodies: code, request id, wait, retryable" {
  ab: [8192] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  k: [1] BtCheck;
  fx := [16] string.[BT_FX_GET_404, BT_FX_RATE, BT_FX_PAY, BT_FX_IP_LIMIT, BT_FX_NO_MACHINE, BT_FX_UNAUTHORIZED, BT_FX_MACHINE_NOT_RUNNING, BT_FX_SSH_ARCHIVED,
                     BT_FX_STARTING, BT_FX_EXPIRED, BT_FX_RESTORING, BT_FX_DIRECT_FAILED, BT_FX_SAVE_LIMIT, BT_FX_NOT_JSON, BT_FX_OK_NOT_JSON, BT_FX_RESUME_STOPPING];
  c := bt_check_init(k[..], fx[..]);
  e: BtError;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.not_found && e.status == 404 && e.code == "not_found" && !e.retryable;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.rate_limited && e.retry_after_s == 3600 && e.retryable && e.code == "rate_limited" && e.request_id == "req_aff7ae485aaa4082aedd6a4a6bfd1b8d";
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.payment_required && e.code == "billing_required" && !e.retryable;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.rate_limited && e.retry_after_s == 17 && e.code == "IP_RATE_LIMIT_EXCEEDED";
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.unavailable && e.retry_after_s == 5 && e.retryable;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.unauthorized && e.status == 401;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.not_running && e.status == 409 && !e.retryable;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.not_running && e.status == 400;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.starting && e.retryable;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.snapshot_expired && !e.retryable;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.restoring && e.retryable && e.status == 502;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.may_be_running && !e.retryable;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.http && e.code == "named_snapshot_limit" && e.status == 409;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.server && e.status == 502 && e.code == "";
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.decode && e.status == 200;
  e = bt_check_get(c, k[..]); #assert e.kind == BtErrKind.stopping;
  // what the kinds are called, and the ones the bodies above don't reach
  #assert bt_kind_name(BtErrKind.none) == "none" && bt_kind_name(BtErrKind.may_be_running) == "may_be_running" && bt_kind_name(BtErrKind.http) == "http" && bt_kind_name(BtErrKind.provider_not_configured) == "provider_not_configured";
  #assert bt_error(ar[..], 409, "{\"code\":\"provider_not_configured\"}", 0).kind == BtErrKind.provider_not_configured;
  #assert bt_error(ar[..], 409, "{\"error\":{\"code\":\"idempotency_in_progress\"}}", 0).kind == BtErrKind.stopping;
  #assert bt_error(ar[..], 413, "{\"code\":\"file_too_large\"}", 0).kind == BtErrKind.too_large;
  #assert bt_error(ar[..], 500, "{\"code\":\"http_500\"}", 0).kind == BtErrKind.server && bt_error(ar[..], 403, "{}", 0).kind == BtErrKind.unauthorized;
  #assert bt_error(ar[..], 400, "{\"code\":\"invalid_json\"}", 0).kind == BtErrKind.http && bt_error(ar[..], 0, "", 0).kind == BtErrKind.transport;
  #assert !bt_failed(bt_error(ar[..], 204, "", 0)) && !bt_failed(bt_error(ar[..], 200, "{\"ok\":true}", 0)) && bt_error(ar[..], 200, "{\"ok\":false}", 0).kind == BtErrKind.decode;
}

#test "transport: no answer left in the fake reads as unreachable; an answer too big for its buffer is too_large" {
  k: [1] BtCheck; answers: [1] string;
  c := bt_check_init(k[..], answers[0..<0]);
  r := bt_get(c, "bx_fwh3xnws", k[0].out[..], k[0].ar[..]);
  #assert r.error.kind == BtErrKind.transport && r.status == 0 && r.error.why == "the host is unreachable";
  k2: [1] BtCheck; a2 := [1] string.[BT_FX_LIST];
  c2 := bt_check_init(k2[..], a2[..]);
  tiny: [40] u8;
  r = bt_get(c2, "bx_fwh3xnws", tiny[..], k2[0].ar[..]);
  #assert r.error.kind == BtErrKind.too_large && r.status == 200;
  r = bt_get(c2, "../x", tiny[..], k2[0].ar[..]);
  #assert r.error.kind == BtErrKind.config && r.error.why == "the request names no valid path (a bad id or name?)";
}

#test "a synchronous command: its output; one past its timeout is killed" {
  k: [1] BtCheck; answers := [3] string.[BT_FX_CMD, BT_FX_CMD_TIMEOUT, BT_FX_MACHINE_NOT_RUNNING];
  c := bt_check_init(k[..], answers[..]);
  r := bt_run(c, "bx_fwh3xnws", "echo hi && uname -a", "", 30, k[0].out[..], k[0].ar[..]);
  m := bt_read_command(k[0].ar[..], r.body);
  #assert m.ok && m.success && m.exit_code == 0 && m.stdout == "hi\nLinux oa-devbox-1 6.8.0\n" && m.stderr == "" && !m.timed_out && !m.truncated && m.command_id == "cmd_8h2k";
  r = bt_run(c, "bx_fwh3xnws", "coax/build.sh", "/home/user/oa", 600, k[0].out[..], k[0].ar[..]);
  m = bt_read_command(k[0].ar[..], r.body);
  #assert m.ok && !m.success && m.timed_out && m.exit_code == -1 && m.truncated;
  r = bt_run(c, "bx_fwh3xnws", "true", "", 5, k[0].out[..], k[0].ar[..]);
  #assert r.error.kind == BtErrKind.not_running;
  r = bt_run(c, "bx_fwh3xnws", "true", "", 900, k[0].out[..], k[0].ar[..]);
  #assert r.error.kind == BtErrKind.config;
  #assert bt_check_log(k[..]) == "POST /sandboxes/bx_fwh3xnws/commands {\"command\":\"echo hi && uname -a\",\"timeoutSeconds\":30}\nPOST /sandboxes/bx_fwh3xnws/commands {\"command\":\"coax/build.sh\",\"cwd\":\"/home/user/oa\",\"timeoutSeconds\":600}\nPOST /sandboxes/bx_fwh3xnws/commands {\"command\":\"true\",\"timeoutSeconds\":5}\n";
}

#test "detached: start, attach, reconnect from the stored cursor, every byte once, then status and kill" {
  k: [1] BtCheck; answers := [5] string.[BT_FX_STARTED, BT_FX_ATTACH_1, BT_FX_ATTACH_2, BT_FX_STATUS, BT_FX_KILL];
  c := bt_check_init(k[..], answers[..]);
  r := bt_detach(c, "bx_fwh3xnws", "coax/build.sh", "/home/user/oa", k[0].out[..], k[0].ar[..]);
  s := bt_read_started(k[0].ar[..], r.body);
  #assert s.ok && s.pid == 4242 && s.command_id == "cmd_9q4x";
  f: [1] BtFollow; line: [4096] u8;
  got: [64] u8; ng := 0; kinds: [16] BtFrameKind; nk := 0;
  at := BtCursor.{};
  for round: 0..<3 {
    e := bt_attach(c, f[..], "bx_fwh3xnws", s.pid, at, line[..]);
    #assert !bt_failed(e);
    for guard: 0..<20 {
      nx := bt_frame_next(f[..], k[0].ar[..], 0);
      if !nx.got { break; }
      kinds[nk] = nx.frame.kind; nk += 1;
      if nx.frame.kind == BtFrameKind.stdout { for ch: nx.frame.data { got[ng] = ch; ng += 1; } }
    }
    at = f[0].at;
    if kinds[nk - 1] == BtFrameKind.exit { break; }
  }
  #assert cast(string) got[0..<ng] == "hello\nworld\n" && at.stdout == 12 && at.stderr == 5 && nk == 8;
  #assert kinds[0] == BtFrameKind.attached && kinds[2] == BtFrameKind.heartbeat && kinds[3] == BtFrameKind.stderr && kinds[4] == BtFrameKind.reconnect && kinds[7] == BtFrameKind.exit;
  r = bt_status(c, "bx_fwh3xnws", s.pid, k[0].out[..], k[0].ar[..]);
  st := bt_read_status(k[0].ar[..], r.body);
  #assert st.ok && st.running && st.status == "running" && st.exit_code == -1 && st.next.stdout == 12 && st.next.stderr == 3;
  r = bt_kill(c, "bx_fwh3xnws", s.pid, k[0].out[..], k[0].ar[..]);
  #assert !bt_failed(r.error);
  #assert bt_check_log(k[..]) == "POST /sandboxes/bx_fwh3xnws/commands {\"command\":\"coax/build.sh\",\"cwd\":\"/home/user/oa\",\"detached\":true}\nGET /sandboxes/bx_fwh3xnws/commands/4242/stream?stdoutOffset=0&stderrOffset=0\nGET /sandboxes/bx_fwh3xnws/commands/4242/stream?stdoutOffset=6&stderrOffset=5\nGET /sandboxes/bx_fwh3xnws/commands/4242\nDELETE /sandboxes/bx_fwh3xnws/commands/4242\n";
}

#test "a streamed command: started, output, exit; a refused open and a cut stream say why" {
  k: [1] BtCheck; answers := [4] string.[BT_FX_STREAM, BT_FX_STREAM_ERROR, BT_FX_MACHINE_NOT_RUNNING, "HTTP/2 200 \r\n\r\n{\"type\":\"stdout\",\"data\":\"x\"}\n"];
  c := bt_check_init(k[..], answers[..]);
  f: [1] BtFollow; line: [4096] u8;
  #assert !bt_failed(bt_stream(c, f[..], "bx_fwh3xnws", "seq 2; exit 3", "", 60, line[..]));
  fr := bt_frame_next(f[..], k[0].ar[..], 0);     // a frame's strings live until the next line
  #assert fr.got && fr.frame.kind == BtFrameKind.started && fr.frame.command_id == "cmd_s1";
  fr = bt_frame_next(f[..], k[0].ar[..], 0); #assert fr.got && fr.frame.kind == BtFrameKind.stdout && fr.frame.data == "1\n";
  fr = bt_frame_next(f[..], k[0].ar[..], 0); #assert fr.got && fr.frame.data == "2\n";
  fr = bt_frame_next(f[..], k[0].ar[..], 0);
  #assert fr.got && fr.frame.kind == BtFrameKind.exit && fr.frame.exit_code == 3 && bt_frame_last(fr.frame) && f[0].done && !bt_failed(f[0].error);
  #assert !bt_frame_next(f[..], k[0].ar[..], 0).got;
  #assert !bt_failed(bt_stream(c, f[..], "bx_fwh3xnws", "true", "", 5, line[..]));
  nx := bt_frame_next(f[..], k[0].ar[..], 0);
  #assert nx.got && nx.frame.kind == BtFrameKind.error && nx.frame.retryable && nx.frame.error == "sandbox_direct_failed" && f[0].done;
  #assert !bt_failed(bt_stream(c, f[..], "bx_fwh3xnws", "true", "", 5, line[..]));
  nx = bt_frame_next(f[..], k[0].ar[..], 0);
  #assert !nx.got && f[0].done && f[0].error.kind == BtErrKind.not_running && f[0].error.code == "machine_not_running";
  #assert !bt_failed(bt_stream(c, f[..], "bx_fwh3xnws", "true", "", 5, line[..]));
  nx = bt_frame_next(f[..], k[0].ar[..], 0);
  #assert nx.got && nx.frame.data == "x";
  nx = bt_frame_next(f[..], k[0].ar[..], 0);
  #assert !nx.got && f[0].error.kind == BtErrKind.decode;
  #assert bt_stream(c, f[..], "bx_fwh3xnws", "", "", 5, line[..]).kind == BtErrKind.config && f[0].done;
  #assert bt_read_frame(k[0].ar[..], "not json").kind == BtFrameKind.bad && bt_frame_last(bt_read_frame(k[0].ar[..], "{\"type\":\"what\"}"));
}

#test "the cursor moves with each chunk and takes the offsets a frame names" {
  ab: [1024] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  c := BtCursor.{stdout = 3, stderr = 4};
  #assert bt_advance(c, bt_read_frame(ar[..], "{\"type\":\"stdout\",\"data\":\"ab\",\"nextOffset\":5}")).stdout == 5;
  #assert bt_advance(c, bt_read_frame(ar[..], "{\"type\":\"stderr\",\"data\":\"ab\",\"nextOffset\":9}")).stderr == 9;
  #assert bt_advance(c, bt_read_frame(ar[..], "{\"type\":\"stdout\",\"data\":\"ab\"}")).stdout == 3;
  #assert bt_advance(c, bt_read_frame(ar[..], "{\"type\":\"heartbeat\",\"stdoutOffset\":99}")).stdout == 3;
  e := bt_advance(c, bt_read_frame(ar[..], "{\"type\":\"error\",\"error\":\"x\",\"stdoutOffset\":7,\"stderrOffset\":8}"));
  #assert e.stdout == 7 && e.stderr == 8;
  #assert bt_advance(c, bt_read_frame(ar[..], "{\"type\":\"attached\",\"stdoutOffset\":1}")).stderr == 4;
}

#test "files: write one, read one back by an escaped path" {
  k: [1] BtCheck; answers := [2] string.[BT_FX_WRITE, BT_FX_READ];
  c := bt_check_init(k[..], answers[..]);
  r := bt_write_file(c, "bx_fwh3xnws", "/home/user/.oa-turn.json", "{\"turn\":1}", false, k[0].out[..], k[0].ar[..]);
  #assert !bt_failed(r.error);
  r = bt_read_file_at(c, "bx_fwh3xnws", "/home/user/a b.txt", k[0].out[..], k[0].ar[..]);
  f := bt_read_file(k[0].ar[..], r.body);
  #assert f.ok && f.size == 6 && f.content == "line\né" && !f.base64 && f.path == "/home/user/a b.txt";
  #assert bt_check_log(k[..]) == "PUT /sandboxes/bx_fwh3xnws/files {\"path\":\"/home/user/.oa-turn.json\",\"content\":\"{\\\"turn\\\":1}\"}\nGET /sandboxes/bx_fwh3xnws/files?path=/home/user/a%20b.txt\n";
  #assert bt_write_file(c, "bx_fwh3xnws", "rel", "", false, k[0].out[..], k[0].ar[..]).error.kind == BtErrKind.config;
}

#test "saved snapshots: save, list, get, delete; the plan's limit is a refusal" {
  k: [1] BtCheck; answers := [5] string.[BT_FX_SAVE, BT_FX_SAVED_LIST, BT_FX_SAVE_LIMIT, BT_FX_GET_404, "HTTP/2 200 \r\n\r\n{\"ok\":true,\"type\":\"savedSnapshot.deleted\",\"name\":\"oa-devbox-20261113\",\"status\":\"deleted\"}"];
  c := bt_check_init(k[..], answers[..]);
  r := bt_save(c, "bx_fwh3xnws", "oa-devbox-20261114", k[0].out[..], k[0].ar[..]);
  sv := bt_read_saved(k[0].ar[..], r.body);
  #assert !bt_failed(r.error) && sv.ok && sv.status == "saving" && sv.source == "bx_fwh3xnws" && sv.name == "oa-devbox-20261114";
  r = bt_saved(c, "oa-devbox-", k[0].out[..], k[0].ar[..]);
  l: [4] BtSaved;
  n := bt_read_saved_list(k[0].ar[..], r.body, l[..]);
  #assert n == 2 && l[0].status == "ready" && l[0].size_bytes == 5261334937 && l[1].status == "saving" && l[0].created == "2026-11-13T15:40:00.000Z";
  #assert bt_read_saved_list(k[0].ar[..], "{}", l[..]) == -1;
  r = bt_save(c, "bx_fwh3xnws", "oa-devbox-20261115", k[0].out[..], k[0].ar[..]);
  #assert r.error.code == "named_snapshot_limit";
  r = bt_saved_get(c, "nope", k[0].out[..], k[0].ar[..]);
  #assert r.error.kind == BtErrKind.not_found;
  r = bt_saved_delete(c, "oa-devbox-20261113", k[0].out[..], k[0].ar[..]);
  #assert !bt_failed(r.error);
  #assert bt_check_log(k[..]) == "POST /saved-snapshots {\"sandboxId\":\"bx_fwh3xnws\",\"name\":\"oa-devbox-20261114\"}\nGET /saved-snapshots?namePrefix=oa-devbox-\nPOST /saved-snapshots {\"sandboxId\":\"bx_fwh3xnws\",\"name\":\"oa-devbox-20261115\"}\nGET /saved-snapshots/nope\nDELETE /saved-snapshots/oa-devbox-20261113\n";
  #assert bt_saved(c, "a b", k[0].out[..], k[0].ar[..]).error.kind == BtErrKind.config && bt_save(c, "bx_x", "a", k[0].out[..], k[0].ar[..]).error.kind == BtErrKind.config;
}

#test "SSH: register a key, learn where the box is now; usage in whole millicents; delete confirms by header" {
  k: [1] BtCheck; answers := [4] string.[BT_FX_SSH, BT_FX_SSH_ARCHIVED, BT_FX_USAGE, BT_FX_DELETE];
  c := bt_check_init(k[..], answers[..]);
  r := bt_sshkey(c, "bx_fwh3xnws", "ssh-ed25519 AAAAC3Nza oa@mac", k[0].out[..], k[0].ar[..]);
  s := bt_read_ssh(k[0].ar[..], r.body);
  #assert s.ok && s.user == "user" && s.ip == "203.0.113.17" && s.endpoint == "user@203.0.113.17" && s.host_key == "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleHostKeyOnlyForChecks";
  r = bt_sshkey(c, "bx_fwh3xnws", "ssh-ed25519 AAAAC3Nza oa@mac", k[0].out[..], k[0].ar[..]);
  #assert r.error.kind == BtErrKind.not_running;
  #assert bt_sshkey(c, "bx_fwh3xnws", "nope", k[0].out[..], k[0].ar[..]).error.kind == BtErrKind.config;
  r = bt_usage(c, "bx_fwh3xnws", "2026-11-13T00:00:00.000Z", k[0].out[..], k[0].ar[..]);
  u := bt_read_usage(k[0].ar[..], r.body);
  #assert u.ok && u.seconds == 3456 && u.millicents == 6912 && u.running && u.type == "large";
  #assert !bt_read_usage(k[0].ar[..], "{\"seconds\":1}").ok;
  r = bt_delete(c, "bx_fwh3xnws", k[0].out[..], k[0].ar[..]);
  #assert !bt_failed(r.error) && r.status == 202;
  #assert bt_delete(c, "bx_x", k[0].out[..], k[0].ar[..]).error.kind == BtErrKind.config;
  #assert bt_check_log(k[..]) == "POST /sandboxes/bx_fwh3xnws/sshkey {\"key\":\"ssh-ed25519 AAAAC3Nza oa@mac\"}\nPOST /sandboxes/bx_fwh3xnws/sshkey {\"key\":\"ssh-ed25519 AAAAC3Nza oa@mac\"}\nGET /sandboxes/bx_fwh3xnws/usage?since=2026-11-13T00:00:00.000Z\nDELETE /sandboxes/bx_fwh3xnws [X-Ascii-Confirm-Delete]\n";
}

#test "environments: listed without their contents; a variable's value only in the body" {
  k: [1] BtCheck; answers := [3] string.[BT_FX_ENVS, BT_FX_ENV_SET, BT_FX_ENV_SET];
  c := bt_check_init(k[..], answers[..]);
  r := bt_envs(c, k[0].out[..], k[0].ar[..]);
  e: [4] BtEnv;
  n := bt_read_envs(k[0].ar[..], r.body, e[..]);
  #assert n == 2 && e[0].name == "base" && e[0].is_default && e[1].name == "oa-devbox" && e[1].id == "env_7c1q" && !e[1].is_default;
  #assert !bt_has(cast(string) k[0].arena[0..<k[0].ar[0].at], "NOT-A-REAL-TOKEN");
  r = bt_env_set(c, "env_7c1q", "GH_TOKEN", "NOT-A-REAL-SECRET", k[0].out[..], k[0].ar[..]);
  #assert !bt_failed(r.error);
  r = bt_env_create(c, "oa-devbox-2", k[0].out[..], k[0].ar[..]);
  #assert bt_check_log(k[..]) == "GET /environments\nPUT /environments/env_7c1q/vars/GH_TOKEN {\"value\":\"NOT-A-REAL-SECRET\"}\nPOST /environments {\"name\":\"oa-devbox-2\"}\n";
  #assert bt_env_set(c, "env_7c1q", "A B", "v", k[0].out[..], k[0].ar[..]).error.kind == BtErrKind.config;
  #assert bt_env_set(c, "e/x", "A", "v", k[0].out[..], k[0].ar[..]).error.kind == BtErrKind.config;
  #assert bt_env_set(c, "env_7c1q", "A", "", k[0].out[..], k[0].ar[..]).error.kind == BtErrKind.config;
  #assert bt_env_create(c, "a b", k[0].out[..], k[0].ar[..]).error.kind == BtErrKind.config;
  #assert bt_read_envs(k[0].ar[..], "{}", e[..]) == -1;
}
