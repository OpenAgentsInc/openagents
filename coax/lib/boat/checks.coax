  #assert bt_file_path(b[..], "bx_fwh3xnws", "rel") == "" && bt_file_path(b[..], "bx_q", "/x") == "";
  #assert bt_named_path(b[..], "/saved-snapshots/", "oa-devbox-20261113", "") == "/saved-snapshots/oa-devbox-20261113" && bt_named_path(b[..], "/saved-snapshots/", "../x", "") == "";
}

#test "the client: hosted boat only with BOAT_HOSTED=1, http only on loopback" {
  #assert bt_host_of("https://boat.dev/api/v1") == "boat.dev" && bt_host_of("http://127.0.0.1:8790/api/v1") == "127.0.0.1" && bt_host_of("http://[::1]:80/x") == "[::1]" && bt_host_of("ftp://x") == "";
  #assert bt_client_problem(BoatClient.{}) == "hosted boat is opt-in: set BOAT_HOSTED=1";
  #assert bt_client_problem(BoatClient.{hosted = true}) == "";
  #assert bt_client_problem(BoatClient.{base = "https://api.boat.dev/v1"}) == "hosted boat is opt-in: set BOAT_HOSTED=1";
  #assert bt_client_problem(BoatClient.{base = "https://ascii.dev/api/box/v1"}) == "hosted boat is opt-in: set BOAT_HOSTED=1";
  #assert bt_client_problem(BoatClient.{base = "https://boat.openagents.com/api/v1"}) == "";
  #assert bt_client_problem(BoatClient.{base = "https://notboat.dev/v1"}) == "";
  #assert bt_client_problem(BoatClient.{base = "http://boat.internal/v1"}) == "plain http only on loopback";
  #assert bt_client_problem(BoatClient.{base = "http://localhost:9/v1"}) == "" && bt_client_problem(BoatClient.{base = "http://[::1]:9/v1"}) == "";
  #assert bt_client_problem(BoatClient.{base = "https://x/v1?k=1"}) == "the base URL holds a character it can't";
  #assert bt_client_problem(BoatClient.{base = "https://x/v 1"}) != "" && bt_client_problem(BoatClient.{base = ""}) == "no base URL" && bt_client_problem(BoatClient.{base = "boat.dev"}) == "the base URL is not http(s)://HOST/...";
  #assert bt_client_problem(BoatClient.{base = "https://x/v1", key_env = "A B"}) == "key_env must be a plain variable name";
  k: [1] BtCheck; answers: [1] string;
  c := bt_check_init(k[..], answers[0..<0]);
  c.base = "https://boat.dev/api/v1";
  r := bt_limits(c, k[0].out[..], k[0].ar[..]);
  #assert r.error.kind == BtErrKind.config && bt_check_log(k[..]) == "";
}

