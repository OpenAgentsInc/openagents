#test "create, then wait: provisioning, then ready; the idempotency key goes as a header" {
  k: [1] BtCheck; answers := [3] string.[BT_FX_CREATE, BT_FX_GET_ARCHIVING, BT_FX_GET_READY];
  c := bt_check_init(k[..], answers[..]);
  r := bt_create(c, BtCreate.{from = "oa-devbox-20261113", environment = "oa-devbox", ttl_s = 43200}, "6f9619ff-8b86", k[0].out[..], k[0].ar[..]);
  #assert !bt_failed(r.error) && r.status == 202;
  s := bt_read_sandbox(k[0].ar[..], r.body);
  #assert s.ok && s.id == "bx_fwh3xnws" && s.state == "provisioning" && !bt_up(s) && s.type == "large" && s.vcpu == 8 && s.memory_gb == 16 && s.environment == "oa-devbox" && s.ttl_s == 43200 && s.ip == "";
  w := bt_wait_up(c, s.id, 10, k[0].out[..], k[0].ar[..]);
  #assert !bt_failed(w.error) && w.polls == 2 && bt_up(w.sandbox) && w.sandbox.ip == "203.0.113.17" && w.sandbox.ssh == "user@203.0.113.17" && w.sandbox.archive_after == "2026-11-14T03:02:11.204Z";
  #assert bt_check_log(k[..]) == "POST /sandboxes [Idempotency-Key] {\"type\":\"large\",\"from\":\"oa-devbox-20261113\",\"environment\":\"oa-devbox\",\"ttlSeconds\":43200}\nGET /sandboxes/bx_fwh3xnws\nGET /sandboxes/bx_fwh3xnws\n";
  r = bt_create(c, BtCreate.{}, "a b", k[0].out[..], k[0].ar[..]);
  #assert r.error.kind == BtErrKind.config;
}

#test "wait: a box that never comes up, one that breaks, one that is gone" {
  k: [1] BtCheck; answers := [3] string.[BT_FX_GET_ARCHIVING, BT_FX_GET_ARCHIVING, BT_FX_GET_ARCHIVING];
  c := bt_check_init(k[..], answers[..]);
  w := bt_wait_up(c, "bx_fwh3xnws", 4, k[0].out[..], k[0].ar[..]);
  #assert w.error.kind == BtErrKind.deadline && w.polls == 2 && bt_down(w.sandbox);
  k2: [1] BtCheck; a2 := [1] string.[BT_FX_GET_404];
  c2 := bt_check_init(k2[..], a2[..]);
  w = bt_wait_up(c2, "bx_fwh3xnws", 60, k2[0].out[..], k2[0].ar[..]);
  #assert w.error.kind == BtErrKind.not_found && w.polls == 1 && w.error.request_id == "req_a322cc73a1b549da9edd7ca0f9cb3f01";
  k3: [1] BtCheck; a3 := [1] string.["HTTP/2 200 \r\n\r\n{\"ok\":true,\"type\":\"sandbox.info\",\"sandbox\":{\"id\":\"bx_fwh3xnws\",\"state\":\"error\",\"error\":\"boot failed\"}}"];
  c3 := bt_check_init(k3[..], a3[..]);
  w = bt_wait_up(c3, "bx_fwh3xnws", 60, k3[0].out[..], k3[0].ar[..]);
  #assert w.error.kind == BtErrKind.not_running && w.error.code == "error" && bt_broken(w.sandbox) && w.sandbox.error == "boot failed";
  k4: [1] BtCheck; a4 := [2] string.[BT_FX_NO_MACHINE, BT_FX_GET_READY];
  c4 := bt_check_init(k4[..], a4[..]);
  w = bt_wait_up(c4, "bx_fwh3xnws", 60, k4[0].out[..], k4[0].ar[..]);
  #assert !bt_failed(w.error) && w.polls == 2;
  k5: [1] BtCheck; a5 := [1] string.["HTTP/2 200 \r\n\r\n{\"ok\":true}"];
  c5 := bt_check_init(k5[..], a5[..]);
  w = bt_wait_up(c5, "bx_fwh3xnws", 60, k5[0].out[..], k5[0].ar[..]);
  #assert w.error.kind == BtErrKind.decode;
}

