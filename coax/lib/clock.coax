// Typed clocks and multirate ticks, the library profile of roadmap R13.
// Book chapter 30 teaches it.
//
// Each clock domain is a tag type, and an instant carries its tag:
// Instant(Sim), Instant(Steady), Instant(Civil), and the astronomical scales
// Instant(UTC), Instant(TAI), Instant(TT), Instant(TDB). An instant counts
// nanoseconds in an s64 from its scale's 1970-01-01T00:00:00 reading.
// Subtracting two instants of one clock gives a span in nanoseconds; passing
// instants of two clocks to one procedure is a type error (E0348).
//
//   sim_at(ns), steady_at(ns), ... tdb_at(ns)
//                                  an instant on that clock
//   elapsed(later, earlier)        later - earlier, in nanoseconds
//   advance(at, ns)                at + ns, on the same clock
//   seconds(ns)                    a span as a chapter 29 Quantity(Second, f64)
//   map_clock(m, at)               Clock_Map(From, To): a pinned offset that
//                                  names its source; the result carries it
//   hold_put(h, value, at)         Hold(T, C): sample-and-hold with a maximum
//   hold_get(h, now)               age; a read past it is Hold_Error.stale
//   schedule_due(tasks, now, out)  which Rate_Tasks run at this tick, in
//                                  their declared order
//   utc_to_tai(at), tai_to_tt(at), tt_to_tdb(at)
//                                  scale conversions; utc_to_tai uses the
//                                  pinned leap-second table and refuses an
//                                  instant outside its coverage
//   warp_step(now, steady_ns, warp, next_event)
//                                  the simulation step for one steady step at
//                                  a warp factor, capped at the next event
//
// No procedure here reads a clock. The host reads its clocks and passes
// instants in, so computing code stays free of clock effects.
#module "coax.clock";
#export Sim, Steady, Civil, UTC, TAI, TT, TDB, Instant,
  sim_at, steady_at, civil_at, utc_at, tai_at, tt_at, tdb_at, elapsed, advance, seconds,
  Clock_Map, map_clock, Mapped, Hold, Hold_Error, Held, hold_put, hold_get,
  Rate_Task, schedule_due, Scale_Error, Scaled, LEAP_TABLE_ID, LEAP_TABLE_START, LEAP_TABLE_END,
  days_from_civil, utc_to_tai, tai_to_tt, tt_to_tdb, tdb_minus_tt_ns, warp_step;
#authority;
#load "quantity.coax" as units;

Sim :: struct {}
Steady :: struct {}
Civil :: struct {}
UTC :: struct {}
TAI :: struct {}
TT :: struct {}
TDB :: struct {}

NS :: 1000000000;
DAY_NS :: 86400 * NS;

Instant :: struct($C: copyable) { ns: s64; }

// An instant on one clock, from its nanosecond count.
sim_at :: (ns: s64) -> Instant(Sim) #effects(all) { r: Instant(Sim); r.ns = ns; return r; }
steady_at :: (ns: s64) -> Instant(Steady) #effects(all) { r: Instant(Steady); r.ns = ns; return r; }
civil_at :: (ns: s64) -> Instant(Civil) #effects(all) { r: Instant(Civil); r.ns = ns; return r; }
utc_at :: (ns: s64) -> Instant(UTC) #effects(all) { r: Instant(UTC); r.ns = ns; return r; }
tai_at :: (ns: s64) -> Instant(TAI) #effects(all) { r: Instant(TAI); r.ns = ns; return r; }
tt_at :: (ns: s64) -> Instant(TT) #effects(all) { r: Instant(TT); r.ns = ns; return r; }
tdb_at :: (ns: s64) -> Instant(TDB) #effects(all) { r: Instant(TDB); r.ns = ns; return r; }

elapsed :: (later: Instant($C: copyable), earlier: Instant($C)) -> s64 #effects(all) {
  return later.ns - earlier.ns;
}

advance :: (at: Instant($C: copyable), ns: s64) -> Instant($C) #effects(all) {
  result := at;
  result.ns = at.ns + ns;
  return result;
}

seconds :: (ns: s64) -> units.Quantity(units.Second, f64) #effects(all) {
  return units.Quantity.{value = cast(f64) ns / 1000000000.0};
}

// ---- conversions between clocks name their source

// A pinned offset from clock From to clock To. source identifies where the
// offset came from (a recorded mapping, a configuration), and every result
// carries it, so a converted instant says how it was converted.
Clock_Map :: struct($From: copyable, $To: copyable) { offset_ns: s64; source: u64; }

Mapped :: struct($To: copyable) { at: Instant($To); source: u64; }

map_clock :: (m: Clock_Map($From: copyable, $To: copyable), at: Instant($From)) -> Mapped($To) #effects(all) {
  result: Mapped($To);
  result.at.ns = at.ns + m.offset_ns;
  result.source = m.source;
  return result;
}

// ---- sample-and-hold with a maximum age

Hold_Error :: enum u8 { none; empty; stale; future; }

// The latest value written to a connection between two tasks, when it was
// written, and how old a reader may see it.
Hold :: struct($T: copyable, $C: copyable) { value: $T; at: Instant($C); max_age_ns: s64; written: bool; }

// What a reader sees: the held value and its age, or why it can't have it.
Held :: struct($T: copyable) { value: $T; age_ns: s64; error: Hold_Error; }

hold_put :: (h: Hold($T: copyable, $C: copyable), value: $T, at: Instant($C)) -> Hold($T, $C) #effects(all) {
  result := h;
  result.value = value;
  result.at = at;
  result.written = true;
  return result;
}

hold_get :: (h: Hold($T: copyable, $C: copyable), now: Instant($C)) -> Held($T) #effects(all) {
  result: Held($T);
  if !h.written { result.error = Hold_Error.empty; return result; }
  age := now.ns - h.at.ns;
  result.age_ns = age;
  if age < 0 { result.error = Hold_Error.future; return result; }
  if age > h.max_age_ns { result.error = Hold_Error.stale; return result; }
  result.value = h.value;
  return result;
}

// ---- multirate tick schedules

// A task runs at now = phase_ns + k * period_ns for every k >= 0.
Rate_Task :: struct { period_ns: s64; phase_ns: s64; }

// Write the indices of the tasks due at now into out, in declared order, and
// return how many. The order is the declaration order: given the rates and
// phases, it is the same on every run. A task with a period below one, or
// more due tasks than out holds, traps. A task whose period is below one
// never runs.
schedule_due :: (tasks: [] Rate_Task, now: Instant(Sim), out: [] s64) -> s64 #effects(all) {
  count: s64 = 0;
  for i: 0..<tasks.count {
    t := tasks[i];
    since := now.ns - t.phase_ns;
    if t.period_ns > 0 && since >= 0 && since % t.period_ns == 0 {
      out[count] = i;
      count += 1;
    }
  }
  return count;
}

// ---- astronomical time scales

Scale_Error :: enum u8 { none; before_table; after_table; }

Scaled :: struct($To: copyable) { at: Instant($To); table: u64; error: Scale_Error; }

// Days from 1970-01-01 to a proleptic Gregorian date (H. Hinnant's
// days_from_civil), for years above -399,999.
days_from_civil :: (year: s64, month: s64, day: s64) -> s64 #effects(all) {
  y := ifx month <= 2 then year - 1 else year;
  era := (y + 400000) / 400 - 1000;
  yoe := y - era * 400;
  mp := ifx month > 2 then month - 3 else month + 9;
  doy := (153 * mp + 2) / 5 + day - 1;
  doe := yoe * 365 + yoe / 4 - yoe / 100 + doy;
  return era * 146097 + doe - 719468;
}

// TAI - UTC in seconds from each date on: the 1972 start and the 27 leap
// seconds through 2017-01-01. Each row is year, month, seconds.
LEAPS :: [84] s64.[
  1972, 1, 10,  1972, 7, 11,  1973, 1, 12,  1974, 1, 13,  1975, 1, 14,  1976, 1, 15,
  1977, 1, 16,  1978, 1, 17,  1979, 1, 18,  1980, 1, 19,  1981, 7, 20,  1982, 7, 21,
  1983, 7, 22,  1985, 7, 23,  1988, 1, 24,  1990, 1, 25,  1991, 1, 26,  1992, 7, 27,
  1993, 7, 28,  1994, 7, 29,  1996, 1, 30,  1997, 7, 31,  1999, 1, 32,  2006, 1, 33,
  2009, 1, 34,  2012, 7, 35,  2015, 7, 36,  2017, 1, 37];

// The table's identity: FNV-1a over its rows and its end. A changed table is
// a different identity, and every converted instant carries it.
LEAP_TABLE_ID :: #run leap_table_id();
// Coverage: 1972-01-01T00:00:00 UTC up to, not including, 2026-06-28, the
// expiry of the IERS leap-second list these rows were checked against.
LEAP_TABLE_START :: 63072000 * NS;
LEAP_TABLE_END :: 1782604800 * NS;

leap_table_id :: () -> u64 #effects(all) {
  h: u64 = 14695981039346656037;
  for i: 0..<LEAPS.count {
    h = mul_wrap(h ^ cast(u64) LEAPS[i], 1099511628211);
  }
  return mul_wrap(h ^ cast(u64) (LEAP_TABLE_END / NS), 1099511628211);
}

// UTC instants count POSIX nanoseconds: days of 86,400 s, so the leap second
// itself (23:59:60) has no UTC instant here.
utc_to_tai :: (at: Instant(UTC)) -> Scaled(TAI) #effects(all) {
  result: Scaled(TAI);
  result.table = LEAP_TABLE_ID;
  if at.ns < LEAP_TABLE_START { result.error = Scale_Error.before_table; return result; }
  if at.ns >= LEAP_TABLE_END { result.error = Scale_Error.after_table; return result; }
  offset := LEAPS[2];
  for row: 1..<LEAPS.count / 3 {
    from := days_from_civil(LEAPS[row * 3], LEAPS[row * 3 + 1], 1) * DAY_NS;
    if at.ns >= from { offset = LEAPS[row * 3 + 2]; }
  }
  result.at.ns = at.ns + offset * NS;
  return result;
}

// TT = TAI + 32.184 s exactly.
tai_to_tt :: (at: Instant(TAI)) -> Instant(TT) #effects(all) {
  result: Instant(TT);
  result.ns = at.ns + 32184000000;
  return result;
}

// J2000.0: 2000-01-01T12:00:00 TT, on this TT scale.
J2000_TT_NS :: #run days_from_civil(2000, 1, 1) * DAY_NS + 43200 * NS;

// TDB - TT in nanoseconds: the series of USNO Circular 179, equation 2.6,
// in Julian centuries T of TT from J2000.0. The circular gives it as good to
// about 10 microseconds from 1600 to 2200.
tdb_minus_tt_ns :: (at: Instant(TT)) -> s64 #effects(all) {
  t := cast(f64) (at.ns - J2000_TT_NS) / (36525.0 * 86400.0 * 1000000000.0);
  s := 0.001657 * sin(628.3076 * t + 6.2401)
     + 0.000022 * sin(575.3385 * t + 4.2970)
     + 0.000014 * sin(1256.6152 * t + 6.1969)
     + 0.000005 * sin(606.9777 * t + 4.0212)
     + 0.000005 * sin(52.9691 * t + 0.4444)
     + 0.000002 * sin(21.3299 * t + 5.5431)
     + 0.000010 * t * sin(628.3076 * t + 4.2490);
  return cast(s64) floor(s * 1000000000.0 + 0.5);
}

tt_to_tdb :: (at: Instant(TT)) -> Instant(TDB) #effects(all) {
  result: Instant(TDB);
  result.ns = at.ns + tdb_minus_tt_ns(at);
  return result;
}

// ---- time acceleration that stops at every event

// The simulation step for one steady step of steady_ns at warp factor warp:
// steady_ns * warp, but never past next_event. The clock owns this rule, so
// a larger warp takes fewer steps and lands on every event all the same.
// A product past s64 is capped at the event. A steady step or warp below
// one, or an event already behind now, gives a step of zero.
warp_step :: (now: Instant(Sim), steady_ns: s64, warp: s64, next_event: Instant(Sim)) -> s64 #effects(all) {
  room := next_event.ns - now.ns;
  if steady_ns < 1 || warp < 1 || room < 1 { return 0; }
  if warp > room / steady_ns { return room; }
  return steady_ns * warp;
}

// ---- checks

#forall "advance and elapsed are inverse on one clock" a: -3..<4, b: -3..<4 {
  start := sim_at(a * 1000);
  later := advance(start, b * 7);
  #assert elapsed(later, start) == b * 7;
  #assert elapsed(start, later) == -(b * 7);
  #assert later.ns == a * 1000 + b * 7;
}

#test "a span becomes a chapter 29 quantity of seconds" {
  #assert seconds(1500000000).value == 1.5;
  #assert seconds(-250000000).value == -0.25;
  #assert seconds(0).value == 0.0;
}

#test "a mapped instant carries its source" {
  m: Clock_Map(Steady, Sim) = Clock_Map.{offset_ns = -40, source = 7};
  r := map_clock(m, steady_at(100));
  #assert r.at.ns == 60 && r.source == 7;
  back: Clock_Map(Sim, Steady) = Clock_Map.{offset_ns = 40, source = 8};
  b := map_clock(back, r.at);
  #assert b.at.ns == 100 && b.source == 8;
}

#test "sample-and-hold reads: empty, fresh, at the limit, stale and from the future" {
  h: Hold(f64, Sim) = Hold.{max_age_ns = 4000000};
  e := hold_get(h, sim_at(0));
  #assert e.error == Hold_Error.empty && e.value == 0.0;
  h = hold_put(h, 2.5, sim_at(1000000));
  #assert h.written && h.max_age_ns == 4000000;
  now := hold_get(h, sim_at(1000000));
  #assert now.error == Hold_Error.none && now.value == 2.5 && now.age_ns == 0;
  fresh := hold_get(h, sim_at(3000000));
  #assert fresh.error == Hold_Error.none && fresh.value == 2.5 && fresh.age_ns == 2000000;
  edge := hold_get(h, sim_at(5000000));
  #assert edge.error == Hold_Error.none && edge.age_ns == 4000000;
  stale := hold_get(h, sim_at(5000001));
  #assert stale.error == Hold_Error.stale && stale.value == 0.0 && stale.age_ns == 4000001;
  early := hold_get(h, sim_at(999999));
  #assert early.error == Hold_Error.future && early.value == 0.0 && early.age_ns == -1;
}

// An independent reference: expand every task's run times, then order the
// runs by time and declaration index, and compare tick by tick.
#test "the task order over many ticks matches an expanded reference trace" {
  tasks := [3] Rate_Task.[Rate_Task.{period_ns = 1000000, phase_ns = 0}, Rate_Task.{period_ns = 2000000, phase_ns = 0},
                          Rate_Task.{period_ns = 3000000, phase_ns = 1000000}];
  ticks := 60;
  ref_time: [200] s64;
  ref_task: [200] s64;
  n := 0;
  for task: 0..<3 {
    k := 0;
    while tasks[task].phase_ns + k * tasks[task].period_ns < ticks * 1000000 {
      ref_time[n] = tasks[task].phase_ns + k * tasks[task].period_ns;
      ref_task[n] = task;
      n += 1;
      k += 1;
    }
  }
  for i: 1..<n {
    j := i;
    while j > 0 && (ref_time[j - 1] > ref_time[j] || (ref_time[j - 1] == ref_time[j] && ref_task[j - 1] > ref_task[j])) {
      t := ref_time[j]; ref_time[j] = ref_time[j - 1]; ref_time[j - 1] = t;
      u := ref_task[j]; ref_task[j] = ref_task[j - 1]; ref_task[j - 1] = u;
      j -= 1;
    }
  }
  out: [3] s64;
  next := 0;
  for tick: 0..<ticks {
    count := schedule_due(tasks[..], sim_at(tick * 1000000), out[..]);
    for i: 0..<count {
      #assert ref_time[next] == tick * 1000000 && ref_task[next] == out[i];
      next += 1;
    }
  }
  #assert next == n && n == 60 + 30 + 20;
}

#test "a task before its phase does not run" {
  tasks := [1] Rate_Task.[Rate_Task.{period_ns = 5, phase_ns = 10}];
  out: [1] s64;
  #assert schedule_due(tasks[..], sim_at(0), out[..]) == 0;
  #assert schedule_due(tasks[..], sim_at(10), out[..]) == 1 && out[0] == 0;
  #assert schedule_due(tasks[..], sim_at(14), out[..]) == 0;
  #assert schedule_due(tasks[..], sim_at(15), out[..]) == 1;
  idle := [2] Rate_Task.[Rate_Task.{period_ns = 0, phase_ns = 0}, Rate_Task.{period_ns = 1, phase_ns = 0}];
  two: [2] s64;
  #assert schedule_due(idle[..], sim_at(0), two[..]) == 1 && two[0] == 1;
}

// Reference: count days one year and one month at a time.
naive_days :: (year: s64, month: s64, day: s64) -> s64 #effects(all) {
  lengths := [11] s64.[31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30];
  days: s64 = 0;
  for y: 1970..<year { days += ifx (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 then 366 else 365; }
  for y: year..<1970 { days -= ifx (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 then 366 else 365; }
  leap := (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
  for m: 0..<month - 1 { days += lengths[m] + ifx m == 1 && leap then 1 else 0; }
  return days + day - 1;
}

#forall "days_from_civil matches day-by-day counting" year: 1896..<2104, month: 1..<13 {
  #assert days_from_civil(year, month, 1) == naive_days(year, month, 1);
  #assert days_from_civil(year, month, 28) == naive_days(year, month, 28);
}

#forall "days_from_civil before year 0 and at it" year: -803..<-795, month: 1..<13 {
  #assert days_from_civil(year, month, 1) == naive_days(year, month, 1);
  #assert days_from_civil(year + 800, month, 15) == naive_days(year + 800, month, 15);
}

#test "known POSIX dates" {
  #assert days_from_civil(1970, 1, 1) == 0;
  #assert days_from_civil(1972, 1, 1) * 86400 == 63072000;
  #assert days_from_civil(2017, 1, 1) * 86400 == 1483228800;
  #assert days_from_civil(1969, 12, 31) == -1;
}

#test "UTC to TAI across the last leap second, and TT - UTC as IERS publishes it" {
  before := utc_to_tai(utc_at(1483228799 * NS));
  #assert before.error == Scale_Error.none && before.at.ns - 1483228799 * NS == 36 * NS;
  after := utc_to_tai(utc_at(1483228800 * NS));
  #assert after.error == Scale_Error.none && after.at.ns - 1483228800 * NS == 37 * NS;
  second := utc_to_tai(utc_at(78796800 * NS)); // 1972-07-01
  #assert second.at.ns - 78796800 * NS == 11 * NS;
  #assert utc_to_tai(utc_at(78796799 * NS)).at.ns - 78796799 * NS == 10 * NS;
  first := utc_to_tai(utc_at(LEAP_TABLE_START));
  #assert first.at.ns - LEAP_TABLE_START == 10 * NS && first.table == LEAP_TABLE_ID;
  // 2020-01-01: TT - UTC = 69.184 s.
  utc := utc_at(1577836800 * NS);
  tt := tai_to_tt(utc_to_tai(utc).at);
  #assert tt.ns - utc.ns == 69184000000;
}

#test "an instant outside the leap-second table is refused" {
  early := utc_to_tai(utc_at(LEAP_TABLE_START - 1));
  #assert early.error == Scale_Error.before_table && early.at.ns == 0 && early.table == LEAP_TABLE_ID;
  late := utc_to_tai(utc_at(LEAP_TABLE_END));
  #assert late.error == Scale_Error.after_table && late.at.ns == 0;
  last := utc_to_tai(utc_at(LEAP_TABLE_END - 1));
  #assert last.error == Scale_Error.none;
}

#test "the table identity is pinned" {
  #assert LEAP_TABLE_ID == 7334693354795583479;
  #assert leap_table_id() == LEAP_TABLE_ID;
}

#test "TDB - TT: the series at J2000.0 and a quarter year later, and its bound" {
  #assert tdb_minus_tt_ns(tt_at(J2000_TT_NS)) == -95757;
  quarter := tt_at(J2000_TT_NS + 7889400 * NS);
  #assert tdb_minus_tt_ns(quarter) == 1643268;
  #assert tt_to_tdb(quarter).ns == quarter.ns + 1643268;
  // A century either side, where the term in T counts.
  #assert tdb_minus_tt_ns(tt_at(J2000_TT_NS + 36525 * DAY_NS)) == -70935;
  #assert tdb_minus_tt_ns(tt_at(J2000_TT_NS - 36525 * DAY_NS)) == -33102;
  #assert J2000_TT_NS == 946728000 * NS;
  for day: 0..<400 {
    d := tdb_minus_tt_ns(tt_at(J2000_TT_NS + day * DAY_NS));
    #assert d > -1800000 && d < 1800000;
  }
}

#test "warp_step stops at every event, and caps an overflowing product" {
  #assert warp_step(sim_at(0), 1000, 1, sim_at(5000)) == 1000;
  #assert warp_step(sim_at(4500), 1000, 1, sim_at(5000)) == 500;
  #assert warp_step(sim_at(0), 1000, 1000000, sim_at(5000)) == 5000;
  #assert warp_step(sim_at(5000), 1000, 3, sim_at(5000)) == 0;
  #assert warp_step(sim_at(5000), 1000, 3, sim_at(4999)) == 0;
  #assert warp_step(sim_at(0), 0, 3, sim_at(10)) == 0 && warp_step(sim_at(0), 1, 0, sim_at(10)) == 0;
  #assert warp_step(sim_at(0), 1, 1, sim_at(1)) == 1 && warp_step(sim_at(0), 5, 2, sim_at(10)) == 10;
  #assert warp_step(sim_at(0), 5, 2, sim_at(11)) == 10 && warp_step(sim_at(0), 5, 3, sim_at(11)) == 11;
  #assert warp_step(sim_at(0), 1000000000, 9000000000000000000, sim_at(9000000000000000000)) == 9000000000000000000;
  #assert warp_step(sim_at(0), 2, 3, sim_at(7)) == 6;
}

#test "the same events in the same order at warp 1 and 10^6" {
  events := [4] s64.[3500000, 10000000, 10000001, 2000000000];
  orders: [2][4] s64;
  steps: [2] s64;
  warps := [2] s64.[1, 1000000];
  for w: 0..<2 {
    now := sim_at(0);
    seen := 0;
    while seen < 4 {
      step := warp_step(now, 1000000, warps[w], sim_at(events[seen]));
      now = advance(now, step);
      steps[w] += 1;
      while seen < 4 && now.ns == events[seen] { orders[w][seen] = seen; seen += 1; }
    }
  }
  for i: 0..<4 { #assert orders[0][i] == i && orders[1][i] == i; }
  #assert steps[0] == 2002 && steps[1] == 4;
}

#forall "each clock's constructor keeps the count" n: -2..<3 {
  #assert sim_at(n).ns == n && steady_at(n).ns == n && civil_at(n).ns == n && utc_at(n).ns == n;
  #assert tai_at(n).ns == n && tt_at(n).ns == n && tdb_at(n).ns == n;
  #assert elapsed(civil_at(n), civil_at(5)) == n - 5 && elapsed(tdb_at(n), tdb_at(5)) == n - 5;
  #assert tai_to_tt(tai_at(n)).ns == n + 32184000000;
}
