    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=1,column=1,offset=0},name="f",b=3,type=1,metal_done=true},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=1,column=9,offset=8},head=4,tail=4},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=1,column=10,offset=9},name="x",a=5,type=7},
    CK_Node.{kind=CK_Tag.expr_call,loc=CK_Loc.{line=1,column=13,offset=12},name="f64_from_bits",head=6,tail=6,type=7,byte_intrinsic=3},
    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=1,column=27,offset=26},type=15}];
  #assert state[0].used==expected.count-1;
  for i:0..<expected.count {a:=nodes[i];b:=expected[i];
    #assert a.kind==b.kind;
    #assert a.loc.line==b.loc.line && a.loc.column==b.loc.column && a.loc.offset==b.loc.offset;
    #assert a.name==b.name;
    #assert a.name2==b.name2;
    #assert a.loc2.line==b.loc2.line && a.loc2.column==b.loc2.column && a.loc2.offset==b.loc2.offset;
    #assert a.a==b.a;
    #assert a.b==b.b;
    #assert a.c==b.c;
    #assert a.d==b.d;
    #assert a.head==b.head;
    #assert a.tail==b.tail;
    #assert a.next==b.next;
    #assert a.op==b.op;
    #assert a.flag==b.flag;
    #assert a.flag2==b.flag2;
    #assert a.value==b.value;
    #assert a.floating==b.floating;
    #assert a.type==b.type;
    #assert a.field_index==b.field_index;
    #assert a.proc==b.proc;
    #assert a.constant==b.constant;
    #assert a.negative==b.negative;
    #assert a.folded==b.folded;
    #assert a.builtin_print==b.builtin_print;
    #assert a.byte_intrinsic==b.byte_intrinsic;
    #assert a.intrinsic==b.intrinsic;
    #assert a.mark==b.mark;
    #assert a.reached==b.reached;
    #assert a.metal_done==b.metal_done;
    #assert a.metal_active==b.metal_active;
  }
}
#test "checker capacities and structural admission" {
  caps:=CK_caps(2,0);#assert caps.nodes==22 && caps.types==22 && caps.locals==18 && caps.errors==32 && caps.bytes==5120;
  #assert CK_caps(1,0).nodes==0 && CK_caps(2147483647,0).nodes==0 && CK_caps(2,-1).nodes==0 && CK_caps(2,2147483647).nodes==0;
  nodes:[2] CK_Node;nodes[1].kind=CK_Tag.file;types:[16] CK_Type;locals:[1] CK_Local;errors:[2] CK_Error;bytes:[1] u8;state:[1] CK_State;
  c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
  #assert CK_run(c,1,CK_Options.{library=true}) && state[0].type_count==16;
  c.types=types[0..<15];#assert !CK_run(c,1,CK_Options.{library=true}) && state[0].fatal && errors[0].code=="E0381";
}
#test "bounded text reports a resource value without writing out of range" {
  nodes:[2] CK_Node;types:[16] CK_Type;locals:[1] CK_Local;errors:[2] CK_Error;bytes:=[2] u8.[17,19];state:[1] CK_State;
  c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[0..<1],state=state[..]};
  parts:=[1] string.["ab"];#assert CK_text(c,parts[..])=="" && state[0].fatal && state[0].byte_count==0 && errors[0].code=="E0381" && bytes[1]==19;
}


// Normative arithmetic vectors use arbitrary-precision integer/rational oracles.
#test "wide oracle 0" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=true};b:=CM_Int.{mag=CM_U.{w=[4] u32.[1,0,0,0]},negative=false,bad=true};
  got0:=CM_add(a,b);want0:=CM_Int.{mag=CM_U.{w=[4] u32.[1,0,0,0]},negative=false,bad=true};#assert got0.negative==want0.negative && got0.bad==want0.bad;for k:0..<4 {#assert got0.mag.w[k]==want0.mag.w[k];}
  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[1,0,0,0]},negative=true,bad=true};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
  got2:=CM_mul(a,b);want2:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=true};#assert got2.negative==want2.negative && got2.bad==want2.bad;for k:0..<4 {#assert got2.mag.w[k]==want2.mag.w[k];}
  got3:=CM_divide(a,b,false);want3:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=true};#assert got3.negative==want3.negative && got3.bad==want3.bad;for k:0..<4 {#assert got3.mag.w[k]==want3.mag.w[k];}
  got4:=CM_divide(a,b,true);want4:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=true};#assert got4.negative==want4.negative && got4.bad==want4.bad;for k:0..<4 {#assert got4.mag.w[k]==want4.mag.w[k];}
  got5:=CM_bitwise(39,a,b);want5:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=true};#assert got5.negative==want5.negative && got5.bad==want5.bad;for k:0..<4 {#assert got5.mag.w[k]==want5.mag.w[k];}
  got6:=CM_bitwise(40,a,b);want6:=CM_Int.{mag=CM_U.{w=[4] u32.[1,0,0,0]},negative=false,bad=true};#assert got6.negative==want6.negative && got6.bad==want6.bad;for k:0..<4 {#assert got6.mag.w[k]==want6.mag.w[k];}
  got7:=CM_bitwise(41,a,b);want7:=CM_Int.{mag=CM_U.{w=[4] u32.[1,0,0,0]},negative=false,bad=true};#assert got7.negative==want7.negative && got7.bad==want7.bad;for k:0..<4 {#assert got7.mag.w[k]==want7.mag.w[k];}
  #assert CM_compare(a,b)==-1;
  bytes:[48] u8;n:=CM_decimal(a,bytes[..]);#assert n==1 && cast(string)bytes[0..<n]=="0";
}
#test "wide oracle 1" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[1,0,0,0]},negative=false,bad=false};b:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=false};
