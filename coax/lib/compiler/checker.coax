#test "minimal semantic context and exact admission capacities" {
 nodes:[2]CK_Node;types:[16]CK_Type;locals:[1]CK_Local;errors:[1]CK_Error;bytes:[1]u8;state:[1]CK_State;nodes[1].kind=CK_Tag.file;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
 #assert CK_run(c,1,CK_Options.{library=true});#assert !CK_run(c,2,CK_Options.{library=true});
 c.state=state[0..<0];#assert !CK_run(c,1,CK_Options.{library=true});
}
#test "missing return and global scope isolation" {
 nodes:[32]CK_Node;types:[32]CK_Type;locals:[2]CK_Local;errors:[8]CK_Error;bytes:[2048]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 nodes[2]=CK_Node.{kind=CK_Tag.stmt_if,c=3,d=4};nodes[3].kind=CK_Tag.stmt_block;nodes[4].kind=CK_Tag.stmt_return;#assert !CK_always_returns(c,2);nodes[2].kind=CK_Tag.stmt_var;#assert !CK_always_returns(c,2);state[0].depth=256;#assert !CK_always_returns(c,2);state[0]=CK_State.{};
 locals[0]=CK_Local.{name="hidden",type=11};state[0].local_count=1;
 nodes[2]=CK_Node.{kind=CK_Tag.struct_,head=3};nodes[3]=CK_Node.{kind=CK_Tag.field,type=11,name="x",b=4};nodes[4]=CK_Node.{kind=CK_Tag.expr_ident,name="hidden"};CK_defaults(c,2);#assert state[0].error_count==1 && errors[0].code=="E0306" && state[0].local_count==1;
 state[0].error_count=0;nodes[2]=CK_Node.{kind=CK_Tag.enum_,type=16,a=5,head=3};nodes[3]=CK_Node.{kind=CK_Tag.member,name="x",a=4};nodes[5]=CK_Node.{kind=CK_Tag.type_named,name="int"};CK_enum(c,2);#assert state[0].error_count==1 && errors[0].code=="E0306" && state[0].local_count==1;
 nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,name="C"};CK_mutable(c,6,CK_Loc.{});#assert errors[1].code=="E0344";nodes[6].kind=CK_Tag.expr_int;CK_mutable(c,6,CK_Loc.{});#assert errors[2].code=="E0359";
 nodes[7]=CK_Node.{kind=CK_Tag.expr_int,type=4,value=256};state[0].unevaluated=1;CK_coerce(c,7,12);#assert nodes[7].value==0 && nodes[7].type==12;
 nodes[7]=CK_Node.{kind=CK_Tag.expr_int,type=4,value=18446744073709551615,negative=true};CK_coerce(c,7,11);#assert !nodes[7].negative;
 nodes[7]=CK_Node.{kind=CK_Tag.expr_float,type=5,floating=0x7ff0000000000000};state[0].unevaluated=0;before:=state[0].error_count;CK_coerce(c,7,6);#assert nodes[7].type==6 && state[0].error_count==before;
}

#test "constant walker entry admits exactly sixty-four edges" {
 nodes:[68]CK_Node;types:[16]CK_Type;state:[1]CK_State;for i:0..<16 {types[i]=CK_builtin(i);}nodes[2]=CK_Node.{kind=CK_Tag.expr_int,type=4,value=1};for i:3..<68 {nodes[i]=CK_Node.{kind=CK_Tag.expr_unary,op=35,a=i-1};}
 c:=CK_Context.{nodes=nodes[..],types=types[..],state=state[..]};#assert !CK_const_int(c,66).bad && CK_const_int(c,67).bad;
}
#test "fresh aggregate expressions and invalid binary operands" {
 nodes:[32]CK_Node;types:[32]CK_Type;locals:[2]CK_Local;errors:[8]CK_Error;bytes:[2048]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=17;state[0].used=10;
 nodes[1].head=2;nodes[2]=CK_Node.{kind=CK_Tag.struct_,name="S",type=16,head=3};types[16]=CK_Type.{kind=CK_Kind.struct_,name="S",decl=2};nodes[3]=CK_Node.{kind=CK_Tag.field,name="x",a=4};nodes[4]=CK_Node.{kind=CK_Tag.type_named,name="int"};nodes[5]=CK_Node.{kind=CK_Tag.type_named,name="S"};nodes[6]=CK_Node.{kind=CK_Tag.expr_struct,d=5};
 #assert CK_expr(c,6,CK_Hint.{})==16 && types[16].size==8 && nodes[2].mark==2;
 nodes[7]=CK_Node.{kind=CK_Tag.expr_bool,type=2};nodes[8]=CK_Node.{kind=CK_Tag.expr_bool,type=2};nodes[9]=CK_Node.{kind=CK_Tag.expr_binary,a=7,b=8,op=52};#assert CK_binary(c,9,CK_Hint.{})==0;
 #assert CK_expr(c,0,CK_Hint.{})==0 && CK_resolve(c,0,CK_Access.value)==0 && !CK_always_returns(c,0);CK_stmt(c,0);
}

#test "the first non-root index holds real semantic objects" {
 nodes:[8]CK_Node;types:[16]CK_Type;locals:[1]CK_Local;errors:[4]CK_Error;bytes:[128]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 nodes[2]=CK_Node.{kind=CK_Tag.type_named,name="int"};#assert CK_resolve(c,2,CK_Access.value)==11;
 nodes[2]=CK_Node.{kind=CK_Tag.expr_int,value=1};#assert CK_expr(c,2,CK_Hint.{})==4;
 nodes[2]=CK_Node.{kind=CK_Tag.stmt_assert,a=3};nodes[3]=CK_Node.{kind=CK_Tag.expr_bool,value=1};CK_stmt(c,2);#assert nodes[3].type==2 && state[0].error_count==0;
}

// Extended semantic fixtures from real parser inputs; these characterize
// typed records and diagnostics. Independent policy/numeric oracles also apply.
// Source: "// #run builds tables, structs and arrays that are baked into the program.\n#import \"Basic\";\n\nStats :: struct { count: int; largest: int; sum: int = 0; }\n\nsieve :: () -> [64] bool {\n  composite: [64] bool;\n  composite[0] = true;\n  composite[1] = true;\n  for i: 2..<64 {\n    if composite[i] { continue; }\n    j := i * i;\n    while j < 64 { composite[j] = true; j += i; }\n  }\n  return composite;\n}\n\nCOMPOSITE :: #run sieve();\n\nsummarize :: (flags: [] bool) -> Stats {\n  s: Stats;\n  for f, i: flags {\n    if !f { s.count += 1; s.largest = i; s.sum += i; }\n  }\n  return s;\n}\n\nPRIMES_BELOW_64 :: #run summarize_table();\nsummarize_table :: () -> Stats {\n  table := COMPOSITE;\n  return summarize(table[..]);\n}\n\nSQUARES :: #run squares();\nsquares :: () -> [8] u16 {\n  out: [8] u16;\n  for i: 0..<8 { out[i] = cast(u16) (i * i); }\n  return out;\n}\n\n#assert PRIMES_BELOW_64.count == 18;\n#assert SQUARES[7] == 49;\n\nmain :: () {\n  print(\"%\\n\", PRIMES_BELOW_64);\n  print(\"%\\n\", SQUARES);\n  n := 0;\n  for c, i: COMPOSITE { if !c && i > 50 { n += 1; } }\n  print(\"primes in 51..<64: %\\n\", n);\n}\n"
#test "checker matrix 0" {
