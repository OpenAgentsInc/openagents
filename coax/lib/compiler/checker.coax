      else {mismatch:=t!=target;if shift {mismatch=!CK_integer(c,t);}if mismatch {parts:=[4] string.["the target is ",c.types[target].name,", given ",c.types[t].name];CK_error(c,c.nodes[s.a].loc,"E0327",CK_text(c,parts[..]),"");}}
    }else if t!=target {fix:="";if CK_numeric(c,target) && CK_numeric(c,t) {fix=CK_join3(c,"convert it: cast(",c.types[target].name,") x");}parts:=[4] string.["the target is ",c.types[target].name,", assigned ",c.types[t].name];CK_error(c,c.nodes[s.a].loc,"E0327",CK_text(c,parts[..]),fix);}
