  got6:=CM_bitwise(40,a,b);want6:=CM_Int.{mag=CM_U.{w=[4] u32.[2686660738,1369482288,947988516,41952264]},negative=true,bad=false};#assert got6.negative==want6.negative && got6.bad==want6.bad;for k:0..<4 {#assert got6.mag.w[k]==want6.mag.w[k];}
  got7:=CM_bitwise(41,a,b);want7:=CM_Int.{mag=CM_U.{w=[4] u32.[3018799310,3685346355,999505700,58736059]},negative=true,bad=false};#assert got7.negative==want7.negative && got7.bad==want7.bad;for k:0..<4 {#assert got7.mag.w[k]==want7.mag.w[k];}
  #assert CM_compare(a,b)==1;
  bytes:[48] u8;n:=CM_decimal(a,bytes[..]);#assert n==40 && cast(string)bytes[0..<n]=="-157919252901918764600726524105318461620";
}
#test "wide oracle 24" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[1185113903,875120569,4064435469,141535439]},negative=false,bad=false};b:=CM_Int.{mag=CM_U.{w=[4] u32.[2230519592,4104343074,2697826395,529730577]},negative=false,bad=false};
  got0:=CM_add(a,b);want0:=CM_Int.{mag=CM_U.{w=[4] u32.[3415633495,684496347,2467294569,671266017]},negative=false,bad=false};#assert got0.negative==want0.negative && got0.bad==want0.bad;for k:0..<4 {#assert got0.mag.w[k]==want0.mag.w[k];}
  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[1045405689,3229222505,2928358222,388195137]},negative=true,bad=false};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
  got2:=CM_mul(a,b);want2:=CM_Int.{mag=CM_U.{w=[4] u32.[2935449688,2395249262,2545713889,1490854767]},negative=false,bad=true};#assert got2.negative==want2.negative && got2.bad==want2.bad;for k:0..<4 {#assert got2.mag.w[k]==want2.mag.w[k];}
  got3:=CM_divide(a,b,false);want3:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=false};#assert got3.negative==want3.negative && got3.bad==want3.bad;for k:0..<4 {#assert got3.mag.w[k]==want3.mag.w[k];}
  got4:=CM_divide(a,b,true);want4:=CM_Int.{mag=CM_U.{w=[4] u32.[1185113903,875120569,4064435469,141535439]},negative=false,bad=false};#assert got4.negative==want4.negative && got4.bad==want4.bad;for k:0..<4 {#assert got4.mag.w[k]==want4.mag.w[k];}
  got5:=CM_bitwise(39,a,b);want5:=CM_Int.{mag=CM_U.{w=[4] u32.[77793064,874595872,2688552969,134416385]},negative=false,bad=false};#assert got5.negative==want5.negative && got5.bad==want5.bad;for k:0..<4 {#assert got5.mag.w[k]==want5.mag.w[k];}
  got6:=CM_bitwise(40,a,b);want6:=CM_Int.{mag=CM_U.{w=[4] u32.[3337840431,4104867771,4073708895,536849631]},negative=false,bad=false};#assert got6.negative==want6.negative && got6.bad==want6.bad;for k:0..<4 {#assert got6.mag.w[k]==want6.mag.w[k];}
  got7:=CM_bitwise(41,a,b);want7:=CM_Int.{mag=CM_U.{w=[4] u32.[3260047367,3230271899,1385155926,402433246]},negative=false,bad=false};#assert got7.negative==want7.negative && got7.bad==want7.bad;for k:0..<4 {#assert got7.mag.w[k]==want7.mag.w[k];}
  #assert CM_compare(a,b)==-1;
  bytes:[48] u8;n:=CM_decimal(a,bytes[..]);#assert n==38 && cast(string)bytes[0..<n]=="11213592837595347687855712793853650735";
}
#test "wide oracle 25" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[702804065,2136940841,94902084,2433514131]},negative=false,bad=false};b:=CM_Int.{mag=CM_U.{w=[4] u32.[2557651338,2293955589,2811720020,50847756]},negative=false,bad=false};
