// The type checker, split by concern into lib/compiler/checker/ (#12646).
// The parts load in the order their declarations had in the single file,
// then the policy modules, so the declaration graph keeps that order. A part
// uses names from the others: none of them checks on its own.
#authority;
#load "checker/numeric.coax";
#load "checker/records.coax";
#load "checker/names.coax";
#load "checker/types.coax";
#load "checker/expressions.coax";
#load "checker/generics.coax";
#load "checker/statements.coax";
#load "checker/fixtures.coax";
#load "checker/matrix-1.coax";
#load "checker/matrix-2.coax";
#load "checker/matrix-3.coax";
#load "checker/matrix-4.coax";
#load "checker/generics-checks.coax";
#load "checker/quantity-checks.coax";
#load "checker/spatial-checks.coax";
#load "checker/borrow-checks.coax";
#load "checker/borrow.coax";
#load "checker/retained-checks.coax";
#load "checker/retain.coax";
#load "checker/b2-r2-checks.coax";
#load "checker/mutation-checks.coax";
#load "checker/result-checks.coax";
#load "checker/sum-checks.coax";
#load "checker/budget-checks.coax";
#load "query-index.coax";
#load "literal-projection-cache.coax";
#load "borrow-summary.coax";
#load "query-projection-cache.coax";
#load "sum-types.coax";
#load "result-handling.coax";
#load "retain-policy.coax";
#load "quantity.coax";
#load "unit-algebra.coax";
#load "unit-forms.coax";
#load "spatial-policy.coax";
#load "spatial-mutation.coax";
