    mark:=c.state[0].local_count;c.nodes[id].type=elem;CK_declare(c,s.name,elem,s.loc,"loop variable");if s.name2.count!=0 {CK_declare(c,s.name2,11,s.loc2,"loop variable");}CK_loop(c,s.c);c.state[0].local_count=mark;return;
  }
  if s.kind==CK_Tag.stmt_break || s.kind==CK_Tag.stmt_continue {
    if c.state[0].loop_depth==0 {what:="break";if s.kind==CK_Tag.stmt_continue {what="continue";}
      if c.state[0].defer_depth!=0 {CK_error(c,s.loc,"E0361",CK_join3(c,"a deferred statement cannot ",what," out of its block"),"");}else {CK_error(c,s.loc,"E0360",CK_join2(c,what," is only allowed inside a loop"),"");}}
