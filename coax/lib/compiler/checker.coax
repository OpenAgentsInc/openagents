  #assert CM_compare(a,b)==1;
  bytes:[48] u8;n:=CM_decimal(a,bytes[..]);#assert n==39 && cast(string)bytes[0..<n]=="340282366920938463463374607431768211455";
}
#test "wide oracle 6" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,2147483648]},negative=false,bad=false};b:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,2147483648]},negative=false,bad=false};
