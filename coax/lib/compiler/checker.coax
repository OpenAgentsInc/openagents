// Foundation boundary checks: fixed ABI metadata, capacities and exact limits.
#test "builtin ABI boundaries" {
nodes:[64] CK_Node;types:[32] CK_Type;locals:[16] CK_Local;errors:[8] CK_Error;bytes:[4096] u8;state:[1] CK_State;
c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
b0:=CK_builtin(-1);#assert b0.name=="<invalid>" && cast(u8)b0.kind==0 && b0.size==0 && b0.alignment==1 && b0.bits==0 && b0.is_signed==false;
b1:=CK_builtin(0);#assert b1.name=="<invalid>" && cast(u8)b1.kind==0 && b1.size==0 && b1.alignment==1 && b1.bits==0 && b1.is_signed==false;
b2:=CK_builtin(1);#assert b2.name=="void" && cast(u8)b2.kind==1 && b2.size==0 && b2.alignment==1 && b2.bits==0 && b2.is_signed==false;
b3:=CK_builtin(2);#assert b3.name=="bool" && cast(u8)b3.kind==4 && b3.size==1 && b3.alignment==1 && b3.bits==8 && b3.is_signed==false;
b4:=CK_builtin(3);#assert b4.name=="string" && cast(u8)b4.kind==5 && b4.size==16 && b4.alignment==8 && b4.bits==0 && b4.is_signed==false;
b5:=CK_builtin(4);#assert b5.name=="integer literal" && cast(u8)b5.kind==6 && b5.size==0 && b5.alignment==1 && b5.bits==0 && b5.is_signed==true;
b6:=CK_builtin(5);#assert b6.name=="float literal" && cast(u8)b6.kind==7 && b6.size==0 && b6.alignment==1 && b6.bits==0 && b6.is_signed==true;
b7:=CK_builtin(6);#assert b7.name=="f32" && cast(u8)b7.kind==3 && b7.size==4 && b7.alignment==4 && b7.bits==32 && b7.is_signed==true;
b8:=CK_builtin(7);#assert b8.name=="f64" && cast(u8)b8.kind==3 && b8.size==8 && b8.alignment==8 && b8.bits==64 && b8.is_signed==true;
b9:=CK_builtin(8);#assert b9.name=="s8" && cast(u8)b9.kind==2 && b9.size==1 && b9.alignment==1 && b9.bits==8 && b9.is_signed==true;
b10:=CK_builtin(9);#assert b10.name=="s16" && cast(u8)b10.kind==2 && b10.size==2 && b10.alignment==2 && b10.bits==16 && b10.is_signed==true;
b11:=CK_builtin(10);#assert b11.name=="s32" && cast(u8)b11.kind==2 && b11.size==4 && b11.alignment==4 && b11.bits==32 && b11.is_signed==true;
b12:=CK_builtin(11);#assert b12.name=="int" && cast(u8)b12.kind==2 && b12.size==8 && b12.alignment==8 && b12.bits==64 && b12.is_signed==true;
b13:=CK_builtin(12);#assert b13.name=="u8" && cast(u8)b13.kind==2 && b13.size==1 && b13.alignment==1 && b13.bits==8 && b13.is_signed==false;
b14:=CK_builtin(13);#assert b14.name=="u16" && cast(u8)b14.kind==2 && b14.size==2 && b14.alignment==2 && b14.bits==16 && b14.is_signed==false;
b15:=CK_builtin(14);#assert b15.name=="u32" && cast(u8)b15.kind==2 && b15.size==4 && b15.alignment==4 && b15.bits==32 && b15.is_signed==false;
b16:=CK_builtin(15);#assert b16.name=="u64" && cast(u8)b16.kind==2 && b16.size==8 && b16.alignment==8 && b16.bits==64 && b16.is_signed==false;
b17:=CK_builtin(16);#assert b17.name=="<invalid>" && cast(u8)b17.kind==0 && b17.size==0 && b17.alignment==1 && b17.bits==0 && b17.is_signed==false;
b18:=CK_builtin(17);#assert b18.name=="<invalid>" && cast(u8)b18.kind==0 && b18.size==0 && b18.alignment==1 && b18.bits==0 && b18.is_signed==false;

}
#test "CK_builtin_type names" {
nodes:[64] CK_Node;types:[32] CK_Type;locals:[16] CK_Local;errors:[8] CK_Error;bytes:[4096] u8;state:[1] CK_State;
c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
#assert CK_builtin_type("int")==11;
#assert CK_builtin_type("s64")==11;
#assert CK_builtin_type("s8")==8;
#assert CK_builtin_type("s16")==9;
#assert CK_builtin_type("s32")==10;
#assert CK_builtin_type("u8")==12;
#assert CK_builtin_type("u16")==13;
#assert CK_builtin_type("u32")==14;
#assert CK_builtin_type("u64")==15;
#assert CK_builtin_type("uint")==15;
#assert CK_builtin_type("f32")==6;
#assert CK_builtin_type("f64")==7;
#assert CK_builtin_type("bool")==2;
#assert CK_builtin_type("string")==3;
#assert CK_builtin_type("")==0;
#assert CK_builtin_type("missing")==0;
#assert CK_builtin_type("_")==0;
#assert CK_builtin_type("_member")==0;
#assert CK_builtin_type("sinx")==0;

}
#test "CK_intrinsic names" {
