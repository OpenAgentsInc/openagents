 if e.kind==CK_Tag.expr_ifx {return CK_local_backed(c,e.b) || CK_local_backed(c,e.c);}
 if (e.kind==CK_Tag.expr_field || e.kind==CK_Tag.expr_index) && CK_aggregate(c,e.type) {return CK_local_backed(c,e.a);}
