  got4:=CM_divide(a,b,true);want4:=CM_Int.{mag=CM_U.{w=[4] u32.[2820927668,1436726320,3163400236,1993221196]},negative=true,bad=false};#assert got4.negative==want4.negative && got4.bad==want4.bad;for k:0..<4 {#assert got4.mag.w[k]==want4.mag.w[k];}
