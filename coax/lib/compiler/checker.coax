    m:=c.nodes[member];prior:=d.head;while prior!=member {if c.nodes[prior].name==m.name {parts:=[5] string.["duplicate member '",m.name,"' in enum '",d.name,"'"];CK_error(c,m.loc,"E0352",CK_text(c,parts[..]),"");}prior=c.nodes[prior].next;}
    if m.a!=CK_NONE {
      saved:=c.state[0].local_count;c.state[0].local_count=0;ty:=CK_expr(c,m.a,CK_Hint.{});c.state[0].local_count=saved;
      if ty==CK_NONE {member=m.next;continue;}value:=CK_const_int(c,m.a);
      if !(CK_untyped(c,ty) || CK_integer(c,ty)) || value.bad {CK_error(c,c.nodes[m.a].loc,"E0363","an enum value must be an integer known while checking","");member=m.next;continue;}next=value;
