  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[3817584863,3965072489,2206693207,1558833460]},negative=false,bad=true};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
  got2:=CM_mul(a,b);want2:=CM_Int.{mag=CM_U.{w=[4] u32.[2721850972,2737583497,363547040,2396750711]},negative=false,bad=true};#assert got2.negative==want2.negative && got2.bad==want2.bad;for k:0..<4 {#assert got2.mag.w[k]==want2.mag.w[k];}
  got3:=CM_divide(a,b,false);want3:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=true};#assert got3.negative==want3.negative && got3.bad==want3.bad;for k:0..<4 {#assert got3.mag.w[k]==want3.mag.w[k];}
  got4:=CM_divide(a,b,true);want4:=CM_Int.{mag=CM_U.{w=[4] u32.[3942677940,2152576539,845554723,1915156495]},negative=true,bad=true};#assert got4.negative==want4.negative && got4.bad==want4.bad;for k:0..<4 {#assert got4.mag.w[k]==want4.mag.w[k];}
  got5:=CM_bitwise(39,a,b);want5:=CM_Int.{mag=CM_U.{w=[4] u32.[276004940,319816032,1209024644,13174448]},negative=false,bad=true};#assert got5.negative==want5.negative && got5.bad==want5.bad;for k:0..<4 {#assert got5.mag.w[k]==want5.mag.w[k];}
  got6:=CM_bitwise(40,a,b);want6:=CM_Int.{mag=CM_U.{w=[4] u32.[3389011091,107009,811860003,1107353603]},negative=true,bad=true};#assert got6.negative==want6.negative && got6.bad==want6.bad;for k:0..<4 {#assert got6.mag.w[k]==want6.mag.w[k];}
  got7:=CM_bitwise(41,a,b);want7:=CM_Int.{mag=CM_U.{w=[4] u32.[3665016031,319923041,2020884647,1120528051]},negative=true,bad=true};#assert got7.negative==want7.negative && got7.bad==want7.bad;for k:0..<4 {#assert got7.mag.w[k]==want7.mag.w[k];}
  #assert CM_compare(a,b)==1;
  bytes:[48] u8;n:=CM_decimal(a,bytes[..]);#assert n==40 && cast(string)bytes[0..<n]=="-151734330041706607873890983894153461172";
}
#test "wide oracle 22" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[1650820687,1375790124,473839946,229383952]},negative=true,bad=false};b:=CM_Int.{mag=CM_U.{w=[4] u32.[3897602698,253542869,1067862270,1750521876]},negative=true,bad=true};
  got0:=CM_add(a,b);want0:=CM_Int.{mag=CM_U.{w=[4] u32.[1253456089,1629332994,1541702216,1979905828]},negative=true,bad=true};#assert got0.negative==want0.negative && got0.bad==want0.bad;for k:0..<4 {#assert got0.mag.w[k]==want0.mag.w[k];}
  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[2246782011,3172720041,594022323,1521137924]},negative=false,bad=true};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
  got2:=CM_mul(a,b);want2:=CM_Int.{mag=CM_U.{w=[4] u32.[852317334,344648836,3943202204,1891742100]},negative=false,bad=true};#assert got2.negative==want2.negative && got2.bad==want2.bad;for k:0..<4 {#assert got2.mag.w[k]==want2.mag.w[k];}
  got3:=CM_divide(a,b,false);want3:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=true};#assert got3.negative==want3.negative && got3.bad==want3.bad;for k:0..<4 {#assert got3.mag.w[k]==want3.mag.w[k];}
  got4:=CM_divide(a,b,true);want4:=CM_Int.{mag=CM_U.{w=[4] u32.[1650820687,1375790124,473839946,229383952]},negative=true,bad=true};#assert got4.negative==want4.negative && got4.bad==want4.bad;for k:0..<4 {#assert got4.mag.w[k]==want4.mag.w[k];}
  got5:=CM_bitwise(39,a,b);want5:=CM_Int.{mag=CM_U.{w=[4] u32.[3933583056,1595729405,1069447678,1845419796]},negative=true,bad=true};#assert got5.negative==want5.negative && got5.bad==want5.bad;for k:0..<4 {#assert got5.mag.w[k]==want5.mag.w[k];}
  got6:=CM_bitwise(40,a,b);want6:=CM_Int.{mag=CM_U.{w=[4] u32.[1614840329,33603588,472254538,134486032]},negative=true,bad=true};#assert got6.negative==want6.negative && got6.bad==want6.bad;for k:0..<4 {#assert got6.mag.w[k]==want6.mag.w[k];}
  got7:=CM_bitwise(41,a,b);want7:=CM_Int.{mag=CM_U.{w=[4] u32.[2318742727,1562125817,597193140,1710933764]},negative=false,bad=true};#assert got7.negative==want7.negative && got7.bad==want7.bad;for k:0..<4 {#assert got7.mag.w[k]==want7.mag.w[k];}
  #assert CM_compare(a,b)==1;
  bytes:[48] u8;n:=CM_decimal(a,bytes[..]);#assert n==39 && cast(string)bytes[0..<n]=="-18173669035961014351540608561563665999";
}
#test "wide oracle 23" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[2820927668,1436726320,3163400236,1993221196]},negative=true,bad=false};b:=CM_Int.{mag=CM_U.{w=[4] u32.[3828561794,1911859196,2028038391,2326914568]},negative=true,bad=false};
