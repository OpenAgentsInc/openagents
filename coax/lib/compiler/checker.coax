  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[2246782011,3172720041,594022323,1521137924]},negative=false,bad=true};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
