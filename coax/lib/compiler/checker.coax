  got7:=CM_bitwise(41,a,b);want7:=CM_Int.{mag=CM_U.{w=[4] u32.[1,0,0,0]},negative=false,bad=false};#assert got7.negative==want7.negative && got7.bad==want7.bad;for k:0..<4 {#assert got7.mag.w[k]==want7.mag.w[k];}
