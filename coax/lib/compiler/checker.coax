// Source: "// Checks are not part of the program: they run under coax test, and their\n// #assert statements are the same always-on checks the program uses.\n#import \"Basic\";\nCoin :: enum u8 { heads; tails; }\nflip :: (c: Coin) -> Coin { return ifx c == Coin.heads then Coin.tails else Coin.heads; }\n#forall c: Coin { #assert flip(flip(c)) == c; #assert flip(c) != c; }\n#test \"a test may loop and use locals\" {\n  n := 0;\n  for i: 0..<10 { n += i; }\n  #assert n == 45;\n}\nmain :: () {\n  c := flip(Coin.heads);\n  #assert c == Coin.tails;\n  print(\"% %\\n\", cast(u8) c, cast(u8) flip(c));\n}\n"
