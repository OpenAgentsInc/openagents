#test "integer operator dispatch" {
nodes:[160]CK_Node;types:[80]CK_Type;locals:[10]CK_Local;errors:[10]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
a:=CM_from(12,false);b:=CM_from(5,false);values:=[10]u64.[17,7,60,2,2,4,13,9,384,0];for op:34..<44 {r:=CM_intop(cast(u32)op,a,b);#assert CM_low(r.mag)==values[op-34] && !r.bad && !r.negative;}#assert CM_intop(33,a,b).bad && CM_intop(44,a,b).bad;
#assert CM_intop(42,a,CM_from(1,true)).bad && CM_intop(43,a,CM_from(64,false)).bad && CM_intop(42,a,CM_from(9223372036854775808,false)).bad;
}
#test "six significant digit rounding and output bounds" {
nodes:[160]CK_Node;types:[80]CK_Type;locals:[10]CK_Local;errors:[10]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
b0:[48]u8;n0:=CM_g(4846369599423283200,b0[..]);#assert cast(string)b0[0..<n0]=="1e+16";
b1:[48]u8;n1:=CM_g(4846369624423283200,b1[..]);#assert cast(string)b1[0..<n1]=="1e+16";
b2:[48]u8;n2:=CM_g(4846369674423283200,b2[..]);#assert cast(string)b2[0..<n2]=="1.00002e+16";
b3:[48]u8;n3:=CM_g(4861130395180394688,b3[..]);#assert cast(string)b3[0..<n3]=="1e+17";
b4:[48]u8;n4:=CM_g(4847542424423283200,b4[..]);#assert cast(string)b4[0..<n4]=="1.23456e+16";
b5:[48]u8;n5:=CM_g(4847542474423283200,b5[..]);#assert cast(string)b5[0..<n5]=="1.23458e+16";
b6:[48]u8;n6:=CM_g(4846369624373283200,b6[..]);#assert cast(string)b6[0..<n6]=="1e+16";
b7:[48]u8;n7:=CM_g(4846369624473283200,b7[..]);#assert cast(string)b7[0..<n7]=="1.00001e+16";
b8:[48]u8;n8:=CM_g(4861130398305394688,b8[..]);#assert cast(string)b8[0..<n8]=="1e+17";
b9:[48]u8;n9:=CM_g(4876203697187506176,b9[..]);#assert cast(string)b9[0..<n9]=="1e+18";
b10:[48]u8;n10:=CM_g(6103021453049119613,b10[..]);#assert cast(string)b10[0..<n10]=="1e+100";
small:[5]u8;#assert CM_g(0x4341c37937e08000,small[0..<4])== -1 && CM_g(0x4341c37937e08000,small[..])==5;#assert CM_g(0x7ff0000000000000,small[..])== -1 && CM_g(0x3ff0000000000000,small[..])== -1;
}

// Additional IEEE boundaries: subnormal quotients and NaN payloads.
#test "small subnormal pack 32" {#assert CM_pack(CM_u(1),-149,false,CM_Width.f32)==1;#assert CM_pack(CM_u(2),-149,false,CM_Width.f32)==2;#assert CM_pack(CM_u(3),-149,false,CM_Width.f32)==3;#assert CM_pack(CM_u(5),-149,false,CM_Width.f32)==5;#assert CM_pack(CM_u(127),-149,false,CM_Width.f32)==127;#assert CM_pack(CM_u(1023),-149,false,CM_Width.f32)==1023;}
