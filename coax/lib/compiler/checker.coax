// Two modules may each declare a name. C spells procedures and types in one
// namespace, so colliding declarations get a scope-qualified spelling, and a
// collision C cannot spell (an #export_c/#foreign symbol, or a library
// header's type) is refused rather than merged.
CK_collisions :: (c:CK_Context,library:bool) {
  id:=c.nodes[1].head;
  while id!=CK_NONE {d:=c.nodes[id];
    named:=d.kind==CK_Tag.struct_ || d.kind==CK_Tag.enum_;
    if named || d.kind==CK_Tag.proc || d.kind==CK_Tag.constant {
      other:=c.nodes[1].head;
      while other!=CK_NONE {o:=c.nodes[other];
        types:=named && (o.kind==CK_Tag.struct_ || o.kind==CK_Tag.enum_);
        if (o.kind==d.kind || types) && o.name==d.name && o.scope!=d.scope {c.nodes[id].collides=true;}other=o.next;
      }
      // Colliding declarations form a chain, so unqualified binding only scans
      // further for names that some other module also declares.
      if c.nodes[id].collides {c.nodes[id].clash=c.state[0].clashes;c.state[0].clashes=id;}
      if c.nodes[id].collides && d.kind!=CK_Tag.constant {
        if d.kind==CK_Tag.proc {if d.flag || d.flag2 {CK_error(c,d.loc,"E0387",CK_join3(c,"C symbol '",d.name,"' is declared by more than one module"),"rename one; #export_c and #foreign names are global C symbols");}}
        else if library {CK_error(c,d.loc,"E0387",CK_join3(c,"type '",d.name,"' is declared by more than one module, and a C library header spells types by name"),"rename one of them");}
        else if d.scope!=0 {c.types[d.type].scope=d.scope;c.types[d.type].name=CK_join3(c,CK_module_name(c,d.scope),".",d.name);}
      }
    }id=d.next;
  }
  CK_exports_valid(c);
}
CK_global_names :: (c:CK_Context) {
  pass:=0;while pass<2 {
    wanted:=CK_Tag.struct_;what:="struct";if pass==1 {wanted=CK_Tag.enum_;what="enum";}
    id:=c.nodes[1].head;while id!=CK_NONE {d:=c.nodes[id];if d.kind==wanted {
      // The diagnostic order is structures first, then enums, independently
      // of their interleaving in source. Earlier enums do not precede a struct.
      prior_pass:=0;while prior_pass<=pass {
        tag:=CK_Tag.struct_;if prior_pass==1 {tag=CK_Tag.enum_;}
        prior:=c.nodes[1].head;while prior!=CK_NONE {
          if prior_pass==pass && prior==id {break;}p:=c.nodes[prior];
          if p.kind==tag && p.name==d.name && p.scope==d.scope {parts:=[4] string.["type '",d.name,"' is already declared at line ",CK_count(c,p.loc.line)];CK_error(c,d.loc,"E0372",CK_text(c,parts[..]),"");}prior=p.next;
        }prior_pass+=1;
      }
      if CK_scan(c,CK_Tag.proc,d.name,d.scope,true)!=0 || CK_scan(c,CK_Tag.constant,d.name,d.scope,true)!=0 || CK_builtin_name(c,d.name) || CK_builtin_type(d.name)!=0 {parts:=[4] string.[what," '",d.name,"' conflicts with another declaration or a built-in name"];CK_error(c,d.loc,"E0372",CK_text(c,parts[..]),"");}
    }id=d.next;}pass+=1;
  }
}
CK_enum :: (c:CK_Context,id:int) {
  d:=c.nodes[id];base:=CK_resolve(c,d.a,CK_Access.value);
  if base!=0 && !CK_integer(c,base) {CK_error(c,c.nodes[d.a].loc,"E0373",CK_join2(c,"an enum's underlying type must be an integer, found ",c.types[base].name),"");base=0;}if base==0 {base=11;}
  t:=d.type;c.types[t].elem=base;c.types[t].size=c.types[base].size;c.types[t].alignment=c.types[base].alignment;c.types[t].bits=c.types[base].bits;c.types[t].is_signed=c.types[base].is_signed;
  next:=CM_Int.{};member:=d.head;
  while member!=CK_NONE && !c.state[0].fatal {
    m:=c.nodes[member];prior:=d.head;while prior!=member {if c.nodes[prior].name==m.name {parts:=[5] string.["duplicate member '",m.name,"' in enum '",d.name,"'"];CK_error(c,m.loc,"E0352",CK_text(c,parts[..]),"");}prior=c.nodes[prior].next;}
    if m.a!=CK_NONE {
      saved:=c.state[0].local_count;c.state[0].local_count=0;ty:=CK_expr(c,m.a,CK_Hint.{});c.state[0].local_count=saved;
      if ty==CK_NONE {member=m.next;continue;}value:=CK_const_int(c,m.a);
      if !(CK_untyped(c,ty) || CK_integer(c,ty)) || value.bad {CK_error(c,c.nodes[m.a].loc,"E0363","an enum value must be an integer known while checking","");member=m.next;continue;}next=value;
    }
    if !CM_fits(next,c.types[base].bits,c.types[base].is_signed) {parts:=[6] string.["value ",CK_number(c,next)," of '",m.name,"' does not fit in ",c.types[base].name];CK_error(c,m.loc,"E0363",CK_text(c,parts[..]),"");next=CM_Int.{};}
    c.nodes[member].value=CM_canon(CM_raw(next),c.types[base].bits,c.types[base].is_signed);prior=d.head;
    while prior!=member {if c.nodes[prior].value==c.nodes[member].value {parts:=[5] string.["'",m.name,"' has the same value as '",c.nodes[prior].name,"'"];CK_error(c,m.loc,"E0363",CK_text(c,parts[..]),"give it its own value");}prior=c.nodes[prior].next;}
    next=CM_add(next,CM_from(1,false));member=m.next;
  }
}
CK_defaults :: (c:CK_Context,id:int) {
  field:=c.nodes[id].head;while field!=CK_NONE && !c.state[0].fatal {f:=c.nodes[field];if f.type!=0 {
    saved:=c.state[0].local_count;c.state[0].local_count=0;t:=CK_value(c,f.b,CK_Hint.{type=f.type});c.state[0].local_count=saved;
    if t!=CK_NONE && t!=f.type {parts:=[5] string.["field '",f.name,"' is ",c.types[f.type].name,CK_join2(c,", its default is ",c.types[t].name)];CK_error(c,c.nodes[f.b].loc,"E0367",CK_text(c,parts[..]),"");}
  }field=f.next;}
}
CK_foreign_scalar :: (c:CK_Context,t:int)->bool {return t==CK_NONE || CK_numeric(c,t) || t==2;}
CK_foreign :: (c:CK_Context,id:int) {
  p:=c.nodes[id];if !CK_foreign_scalar(c,p.type) && p.type!=1 {parts:=[4] string.["'",p.name,"' returns ",CK_join2(c,c.types[p.type].name,"; #foreign procedures pass integers, floats and bool")];CK_error(c,p.loc,"E0376",CK_text(c,parts[..]),"");}
  param:=p.head;while param!=CK_NONE {prm:=c.nodes[param];if !CK_foreign_scalar(c,prm.type) {parts:=[5] string.["parameter '",prm.name,"' is ",c.types[prm.type].name,"; #foreign procedures pass integers, floats and bool"];CK_error(c,prm.loc,"E0376",CK_text(c,parts[..]),"");}param=prm.next;}
  if CK_c_keyword(p.name) || p.name=="main" {CK_error(c,p.loc,"E0376",CK_join3(c,"'",p.name,"' cannot be a C symbol name"),"");}
  else if p.name.count>=5 && p.name[0..<5]=="coax_" {CK_error(c,p.loc,"E0376","foreign names cannot start with 'coax_', which the runtime uses","");}
}

CK_metal_type :: (t:int)->bool {return t==6 || t==2 || t==1 || t==CK_NONE;}
CK_metal_error :: (c:CK_Context,loc:CK_Loc,what:string) {CK_error(c,loc,"E0377",CK_join2(c,what," is outside the Metal scalar profile"),"Metal libraries use f32 and bool, if/else and calls; no loops, strings, integers or host calls");}
CK_metal_expr :: (c:CK_Context,id:int) {
  if id==CK_NONE {return;}e:=c.nodes[id];if !CK_enter(c,e.loc) {return;}defer CK_leave(c);
  if !CK_metal_type(e.type) {CK_metal_error(c,e.loc,CK_join3(c,"a ",c.types[e.type].name," value"));return;}
  if e.builtin_print {CK_metal_error(c,e.loc,"print");return;}
  if e.byte_intrinsic!=0 {CK_metal_error(c,e.loc,"a binary storage intrinsic");return;}
  if e.proc!=CK_NONE {
    if c.nodes[e.proc].flag2 {CK_metal_error(c,e.loc,"a #foreign call");return;}
    if c.nodes[e.proc].metal_active {CK_metal_error(c,e.loc,"a recursive call");return;}CK_metal_proc(c,e.proc);
  }
  CK_metal_expr(c,e.a);CK_metal_expr(c,e.b);CK_metal_expr(c,e.c);a:=e.head;while a!=CK_NONE {CK_metal_expr(c,a);a=c.nodes[a].next;}
}
CK_metal_stmt :: (c:CK_Context,id:int) {
  if id==CK_NONE {return;}s:=c.nodes[id];if !CK_enter(c,s.loc) {return;}defer CK_leave(c);
  if s.kind==CK_Tag.stmt_while || s.kind==CK_Tag.stmt_range || s.kind==CK_Tag.stmt_each {CK_metal_error(c,s.loc,"a loop");return;}
  if s.kind==CK_Tag.stmt_assert {CK_metal_error(c,s.loc,"#assert");return;}
  if s.kind==CK_Tag.stmt_var && !CK_metal_type(s.type) {CK_metal_error(c,s.loc,CK_join3(c,"a ",c.types[s.type].name," local"));return;}
  CK_metal_expr(c,s.a);if s.kind==CK_Tag.stmt_assign {CK_metal_expr(c,s.c);}
  child:=s.head;while child!=CK_NONE {CK_metal_stmt(c,child);child=c.nodes[child].next;}
  if s.kind!=CK_Tag.stmt_assign {CK_metal_stmt(c,s.c);}if s.kind!=CK_Tag.stmt_var {CK_metal_stmt(c,s.d);}
}
CK_metal_proc :: (c:CK_Context,id:int) {
  if c.nodes[id].metal_done {return;}
  if c.state[0].metal_depth>=64 {CK_metal_error(c,c.nodes[id].loc,"a call chain deeper than 64");return;}
  c.state[0].metal_depth+=1;c.nodes[id].metal_active=true;CK_metal_stmt(c,c.nodes[id].b);c.nodes[id].metal_active=false;c.state[0].metal_depth-=1;c.nodes[id].metal_done=true;
}
CK_metal :: (c:CK_Context) {
  p:=c.nodes[1].head;while p!=0 {v:=c.nodes[p];if v.kind==CK_Tag.proc {
    if v.flag2 {CK_metal_error(c,v.loc,"a #foreign procedure");}
    else {
      if !CK_metal_type(v.type) {CK_metal_error(c,v.loc,CK_join2(c,"returning ",c.types[v.type].name));}
      prm:=v.head;while prm!=0 {param:=c.nodes[prm];if !CK_metal_type(param.type) {CK_metal_error(c,param.loc,CK_join3(c,"a ",c.types[param.type].name," parameter"));}prm=param.next;}
    }
  }p=v.next;}
  p=c.nodes[1].head;while p!=0 {v:=c.nodes[p];if v.kind==CK_Tag.proc && !v.flag2 {CK_metal_proc(c,p);}p=v.next;}
}
CK_check :: (c:CK_Context,id:int) {
  d:=c.nodes[id];c.nodes[d.a].type=1;c.state[0].local_count=0;p:=c.nodes[d.a];param:=p.head;
  while param!=CK_NONE && !c.state[0].fatal {
    prm:=c.nodes[param];if prm.a!=CK_NONE {
      t:=CK_resolve(c,prm.a,CK_Access.value);c.nodes[param].type=t;
      if t!=CK_NONE && t!=2 && c.types[t].kind!=CK_Kind.enum_ && !(t==8 || t==9 || t==12 || t==13) {CK_error(c,prm.loc,"E0379",CK_join2(c,"#forall cannot enumerate ",c.types[t].name),CK_join3(c,"bind bool, an enum, an integer of at most 16 bits, or a range: ",prm.name,": 0..<100"));}
    }else {
      c.nodes[param].type=11;bounds:=[2] int.[prm.b,prm.c];
      for bound:bounds {t:=CK_value(c,bound,CK_Hint.{type=11});
        if t!=CK_NONE && t!=11 {CK_error(c,c.nodes[bound].loc,"E0379",CK_join2(c,"a #forall range bound must be an int constant, found ",c.types[t].name),"");}
      }
    }param=prm.next;
  }
  c.state[0].current=d.a;param=p.head;
  while param!=CK_NONE {prm:=c.nodes[param];CK_declare(c,prm.name,prm.type,prm.loc,"binding");param=prm.next;}CK_stmt(c,p.b);
}
// The typed graph's resolved callee is present only on a user call.
// One walker handles syntax unions, including struct field initializers.
CK_reach :: (c:CK_Context,id:int) {
  if id==CK_NONE {return;}n:=c.nodes[id];if !CK_enter(c,n.loc) {return;}defer CK_leave(c);
  if n.proc!=CK_NONE && !c.nodes[n.proc].flag2 && !c.nodes[n.proc].reached {c.nodes[n.proc].reached=true;CK_reach(c,c.nodes[n.proc].b);}
  CK_reach(c,n.a);CK_reach(c,n.b);CK_reach(c,n.c);CK_reach(c,n.d);
  child:=n.head;while child!=CK_NONE {CK_reach(c,child);child=c.nodes[child].next;}
}
#forall "source-unit authority excludes only foreign, main, reached or unguarded procedures" kind:0..<3, foreign:bool, main_name:bool, reached:bool, skip:bool {
 tags:=[3] CK_Tag.[CK_Tag.proc,CK_Tag.constant,CK_Tag.check];
 p:=CK_Node.{kind=tags[kind],flag2=foreign,reached=reached,skip_authority=skip,name="work"};
 if main_name {p.name="main";}
 #assert CK_requires_coverage(p)==(kind==0 && !foreign && !main_name && !reached && !skip);
}
CK_requires_coverage :: (p:CK_Node)->bool {
 return p.kind==CK_Tag.proc && !p.flag2 && p.name!="main" && !p.reached && !p.skip_authority;
}
CK_coverage :: (c:CK_Context) {
  id:=c.nodes[1].head;while id!=CK_NONE {if c.nodes[id].kind==CK_Tag.check {CK_reach(c,c.nodes[c.nodes[id].a].b);}id=c.nodes[id].next;}
  id=c.nodes[1].head;while id!=CK_NONE {p:=c.nodes[id];if CK_requires_coverage(p) {CK_error(c,p.loc,"E0380",CK_join3(c,"'",p.name,"' is not exercised by any #test or #forall"),"#authority files check every procedure: add a #test or #forall that calls it");}id=p.next;}
}
// Ordered lowering (r1a-ordered-lowering): what evaluating a checked
// expression may observably do. Evaluator and native C share one order
// (left to right, a place before its value); the emitter sequences operands
// whenever two of them could make that order observable.
CK_EFFECT_CALL :: cast(u8) 1;      // runs a procedure: may write state another operand reads
CK_EFFECT_TRAP :: cast(u8) 2;      // may stop with a trap under every arithmetic profile
CK_EFFECT_OVERFLOW :: cast(u8) 4;  // may stop with an overflow trap under checked arithmetic
CK_own_effects :: (c:CK_Context,n:CK_Node)->u8 {
  integer:=CK_integer(c,n.type);
  if n.kind==CK_Tag.expr_index || n.kind==CK_Tag.expr_slice {return CK_EFFECT_TRAP;}
  if n.kind==CK_Tag.expr_call {if n.byte_intrinsic!=0 {return CK_EFFECT_TRAP;}if n.intrinsic!=0 {return 0;}return CK_EFFECT_CALL;}
  if n.kind==CK_Tag.expr_cast {if integer && !n.flag {return CK_EFFECT_TRAP;}return 0;}
  if !integer {return 0;}
  if n.kind==CK_Tag.expr_binary {
    if n.op==37 || n.op==38 || n.op==42 || n.op==43 {return CK_EFFECT_TRAP;}
    if n.op==34 || n.op==35 || n.op==36 {return CK_EFFECT_OVERFLOW;}
  }
  if n.kind==CK_Tag.expr_unary && n.op==35 {return CK_EFFECT_OVERFLOW;}
  return 0;
}
CK_effects :: (c:CK_Context,id:int)->u8 {
  if id<0 || id>=c.nodes.count {return 0;}
  n:=c.nodes[id];if n.effects_known {return n.effects;}
  e:u8=0;tag:=cast(u32)n.kind;expression:=tag>=16 && tag<40;
  if n.kind==CK_Tag.field_init {e=CK_effects(c,n.a);}
  else if expression && !n.folded {
    e=CK_own_effects(c,n)|CK_effects(c,n.a)|CK_effects(c,n.b)|CK_effects(c,n.c);
    arg:=n.head;while arg!=CK_NONE {e=e|CK_effects(c,arg);arg=c.nodes[arg].next;}
  }
  c.nodes[id].effects=e;c.nodes[id].effects_known=true;return e;
}
// Every node of a checked graph, once, after CK_run succeeds.
CK_lower_effects :: (c:CK_Context) #export_c {for node:1..<c.state[0].used+1 {ignored:=CK_effects(c,node);}}
CK_run :: (c:CK_Context,used:int,options:CK_Options)->bool #export_c {
  if c.state.count!=1 {return false;}c.state[0]=CK_State.{used=used,type_count=16};
  if used<1 || used>=c.nodes.count || c.types.count<16 || c.errors.count<1 || c.locals.count<1 {CK_resource(c,CK_Loc.{});return false;}
  for i:0..<16 {c.types[i]=CK_builtin(i);}
  id:=c.nodes[1].head;
  while id!=CK_NONE {n:=c.nodes[id];if n.kind==CK_Tag.import_ {
    if n.name=="Basic" {if c.state[0].basic {CK_error(c,n.loc,"E0332","module Basic is imported twice","remove this import");}c.state[0].basic=true;}
    else {CK_error(c,n.loc,"E0333",CK_join3(c,"unknown module '",n.name,"'"),"coax0 has one module: \"Basic\"");}
  }id=n.next;}
  pass:=0;while pass<2 {tag:=CK_Tag.struct_;kind:=CK_Kind.struct_;if pass==1 {tag=CK_Tag.enum_;kind=CK_Kind.enum_;}id=c.nodes[1].head;
    while id!=CK_NONE {n:=c.nodes[id];if n.kind==tag {c.nodes[id].type=CK_new_type(c,CK_Type.{kind=kind,name=n.name,decl=id});}id=n.next;}pass+=1;
  }
  CK_global_names(c);CK_collisions(c,options.library);
  id=c.nodes[1].head;while id!=CK_NONE {if c.nodes[id].kind==CK_Tag.enum_ {CK_enum(c,id);}id=c.nodes[id].next;}
  id=c.nodes[1].head;while id!=CK_NONE {if c.nodes[id].kind==CK_Tag.struct_ {CK_layout(c,id);}id=c.nodes[id].next;}
  any_export:=false;id=c.nodes[1].head;
  while id!=CK_NONE && !c.state[0].fatal {
    p:=c.nodes[id];if p.kind==CK_Tag.proc {
      prior:=c.nodes[1].head;while prior!=id {old:=c.nodes[prior];if old.kind==CK_Tag.proc && old.name==p.name && old.scope==p.scope {parts:=[4] string.["procedure '",p.name,"' is already declared at line ",CK_count(c,old.loc.line)];CK_error(c,p.loc,"E0334",CK_text(c,parts[..]),"");}prior=old.next;}
      if CK_builtin_name(c,p.name) {CK_error(c,p.loc,"E0335",CK_join3(c,"'",p.name,"' is already a builtin"),"pick another name");}
      param:=p.head;while param!=CK_NONE {c.nodes[param].type=CK_resolve(c,c.nodes[param].a,CK_Access.value);param=c.nodes[param].next;}
      c.nodes[id].type=1;if p.a!=CK_NONE {c.nodes[id].type=CK_resolve(c,p.a,CK_Access.value);}if p.flag2 {CK_foreign(c,id);}
      if p.flag {any_export=true;if p.name=="main" {CK_error(c,p.loc,"E0369","'main' cannot be exported; it is the program's entry point","");}else if p.name.count>=5 && p.name[0..<5]=="coax_" {CK_error(c,p.loc,"E0369","exported names cannot start with 'coax_', which the runtime uses","");}}
    }id=p.next;
  }
  id=c.nodes[1].head;while id!=CK_NONE {n:=c.nodes[id];if n.kind==CK_Tag.constant {
    prior:=c.nodes[1].head;while prior!=id {old:=c.nodes[prior];if old.kind==CK_Tag.constant && old.name==n.name && old.scope==n.scope {CK_error(c,n.loc,"E0345",CK_join3(c,"duplicate constant '",n.name,"'"),"");}prior=old.next;}
    if CK_scan(c,CK_Tag.proc,n.name,n.scope,true)!=0 || CK_builtin_name(c,n.name) {CK_error(c,n.loc,"E0345",CK_join3(c,"constant '",n.name,"' conflicts with a procedure or intrinsic"),"");}
  }id=n.next;}
  id=c.nodes[1].head;while id!=CK_NONE {if c.nodes[id].kind==CK_Tag.constant {ignored:=CK_constant_type(c,id);}id=c.nodes[id].next;}
  id=c.nodes[1].head;while id!=CK_NONE {if c.nodes[id].kind==CK_Tag.struct_ {CK_defaults(c,id);}id=c.nodes[id].next;}
  id=c.nodes[1].head;while id!=CK_NONE {n:=c.nodes[id];if n.kind==CK_Tag.assert_ {t:=CK_value(c,n.a,CK_Hint.{});if t!=CK_NONE && t!=2 {CK_error(c,c.nodes[n.a].loc,"E0346","#assert requires bool","");}}id=n.next;}
  entry:=CK_find(c,CK_Tag.proc,"main");
  if entry==CK_NONE {if !options.library {fix:="add main :: () { ... }";if any_export {fix="build it as a library: coax lib FILE.coax";}CK_error(c,CK_Loc.{line=1,column=1},"E0336","the program has no 'main'",fix);}}
  else {p:=c.nodes[entry];if p.head!=0 || p.type!=1 || p.flag2 {CK_error(c,p.loc,"E0337","'main' takes no parameters and returns nothing in coax0","main :: () { ... }");}}
  id=c.nodes[1].head;while id!=CK_NONE && !c.state[0].fatal {p:=c.nodes[id];if p.kind==CK_Tag.proc && !p.flag2 {
    c.state[0].current=id;c.state[0].local_count=0;param:=p.head;
    while param!=CK_NONE {prm:=c.nodes[param];CK_declare(c,prm.name,prm.type,prm.loc,"parameter");param=prm.next;}CK_stmt(c,p.b);
    if p.type!=1 && p.type!=0 && !CK_always_returns(c,p.b) {parts:=[4] string.["'",p.name,"' can reach its end without returning ",c.types[p.type].name];CK_error(c,p.loc,"E0338",CK_text(c,parts[..]),"add a return at the end");}
  }id=p.next;}
  id=c.nodes[1].head;while id!=CK_NONE {if c.nodes[id].kind==CK_Tag.check {CK_check(c,id);}id=c.nodes[id].next;}
  if options.authority && c.state[0].error_count==0 {CK_coverage(c);}
  if options.metal && c.state[0].error_count==0 {CK_metal(c);}
  return c.state[0].error_count==0 && !c.state[0].fatal;
}

#test "wide signed arithmetic preserves the full literal domain" {
  one:=CM_from(1,false);two:=CM_from(2,false);negative:=CM_from(1,true);
  #assert CM_low(CM_add(one,two).mag)==3 && !CM_add(one,two).negative;
  #assert CM_low(CM_add(one,negative).mag)==0 && !CM_add(one,negative).negative;
  #assert CM_low(CM_sub(one,two).mag)==1 && CM_sub(one,two).negative;
  #assert CM_low(CM_mul(CM_from(18446744073709551615,false),two).mag)==18446744073709551614;
  #assert CM_mul(CM_from(18446744073709551615,false),two).mag.w[2]==1;
}
#test "IEEE arithmetic is encoded, including nonfinite and subnormal results" {
  #assert CM_float(34,0x3ff0000000000000,0x4000000000000000)==0x4008000000000000;
  #assert CM_float(35,0x3ff0000000000000,0x4000000000000000)==0xbff0000000000000;
  #assert CM_float(36,0x7fefffffffffffff,0x4000000000000000)==0x7ff0000000000000;
  #assert CM_float(37,0x3ff0000000000000,0)==0x7ff0000000000000;
  #assert CM_float(36,1,0x3ff0000000000000)==1;
}
#test "integer range, canonical bits, decimal text and bit operations" {
  negative:=CM_from(128,true);positive:=CM_from(255,false);out:[48] u8;
  #assert CM_fits(negative,8,true) && !CM_fits(negative,8,false) && CM_fits(positive,8,false) && !CM_fits(positive,8,true);
  #assert CM_canon(255,8,true)==18446744073709551615;
  #assert CM_compare(negative,positive)== -1 && CM_raw(negative)==18446744073709551488;
  #assert CM_signed_bits(18446744073709551615,true).negative;
  count:=CM_decimal(negative,out[..]);#assert count==4 && cast(string)out[0..<count]=="-128";
  #assert CM_low(CM_divide(positive,CM_from(10,false),false).mag)==25;
  #assert CM_low(CM_divide(positive,CM_from(10,false),true).mag)==5;
  #assert CM_low(CM_bitwise(39,positive,CM_from(15,false)).mag)==15;
  #assert CM_low(CM_shift(43,negative,1).mag)==64;
  #assert CM_convert(0x3ff0000000000000,CM_Width.f64,CM_Width.f32)==0x3f800000;
  #assert CM_to_float(CM_from(1,true))==0xbff0000000000000;
}
#test "finite division preserves encoded significands" {#assert CM_float(37,0x3ff0000000000000,0x4000000000000000)==0x3fe0000000000000;}

// Characterization fixtures from real parser input. Diagnostics/type pools
// were compared with the prior native checker. These are compatibility
// regressions, not correctness proofs; normative arithmetic/AST tests are separate.
#test "checker: empty library" {
  initial:=[2] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file}];
  nodes:[22] CK_Node;for v,i:initial {nodes[i]=v;}
  types:[22] CK_Type;locals:[18] CK_Local;errors:[32] CK_Error;bytes:[5120] u8;state:[1] CK_State;
  context:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
  ok:=CK_run(context,initial.count-1,CK_Options.{library=true,metal=false,authority=false});
  #assert ok==true && state[0].error_count==0 && state[0].depth==0;
  // The semantic pass restores its scope/depth counters.
  #assert state[0].used==1;
  #assert state[0].type_count==16;
  #assert state[0].composite_count==0;
  #assert state[0].local_count==0;
  #assert state[0].byte_count==0;
  #assert state[0].error_count==0;
  #assert state[0].current==0;
  #assert state[0].constant_depth==0;
  #assert state[0].loop_depth==0;
  #assert state[0].defer_depth==0;
  #assert state[0].unevaluated==0;
  #assert state[0].basic==false;
  #assert state[0].depth==0;
  #assert state[0].fatal==false;
  #assert state[0].metal_depth==0;

  expected:=[2] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file}];
  #assert state[0].used==expected.count-1;
  for i:0..<expected.count {a:=nodes[i];b:=expected[i];
    #assert a.kind==b.kind;
    #assert a.loc.line==b.loc.line && a.loc.column==b.loc.column && a.loc.offset==b.loc.offset;
    #assert a.name==b.name;
