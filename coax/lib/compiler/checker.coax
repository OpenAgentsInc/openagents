  if CK_find(c,CK_Tag.proc,name)!=0 {CK_error(c,loc,"E0304",CK_join3(c,"'",name,"' is already the name of a procedure"),"pick another name");return;}
  if CK_find(c,CK_Tag.constant,name)!=0 || CK_builtin_name(c,name) || CK_find(c,CK_Tag.struct_,name)!=0 || CK_find(c,CK_Tag.enum_,name)!=0 {CK_error(c,loc,"E0342",CK_join3(c,"'",name,"' is already a constant, type or intrinsic"),"pick another name");return;}
