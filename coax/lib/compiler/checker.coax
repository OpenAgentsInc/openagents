    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=1,column=45,offset=44},name="a",a=18,d=17,next=19},
    CK_Node.{kind=CK_Tag.type_named,loc=CK_Loc.{line=1,column=47,offset=46},name="f32"},
    CK_Node.{kind=CK_Tag.expr_float,loc=CK_Loc.{line=1,column=51,offset=50},floating=4591870180066957722},
    CK_Node.{kind=CK_Tag.stmt_return,loc=CK_Loc.{line=1,column=55,offset=54},a=20},
    CK_Node.{kind=CK_Tag.expr_ifx,loc=CK_Loc.{line=1,column=62,offset=61},a=23,b=26,c=27},
    CK_Node.{kind=CK_Tag.expr_ident,loc=CK_Loc.{line=1,column=66,offset=65},name="x"},
    CK_Node.{kind=CK_Tag.expr_float,loc=CK_Loc.{line=1,column=68,offset=67}},
