0,9219994337134247936)==9222246136947933184;#assert CM_convert(9221120237041090560,CM_Width.f64,CM_Width.f32)==2143289344;#assert CM_float(34,9221120237041090560,0x3ff0000000000000)==9221120237041090560 && CM_float(34,0x3ff0000000000000,9221120237041090560)==9221120237041090560;#assert CM_float(35,9221120237041090560,0x3ff0000000000000)==9221120237041090560 && CM_float(35,0x3ff0000000000000,9221120237041090560)==9221120237041090560;#assert CM_float(36,9221120237041090560,0x3ff0000000000000)==9221120237041090560 && CM_float(36,0x3ff0000000000000,9221120237041090560)==9221120237041090560;#assert CM_float(37,9221120237041090560,0x3ff0000000000000)==9221120237041090560 && CM_float(37,0x3ff0000000000000,9221120237041090560)==9221120237041090560;}
#test "normal significand has a canonical power" {v:=CM_normal_float(CM_Float.{mantissa=4503599627370496,power=0});#assert v.mantissa==4503599627370496 && v.power==0;w:=CM_normal_float(CM_Float.{mantissa=1,power= -1074});#assert w.mantissa==4503599627370496 && w.power== -1126;}
#test "subnormal quotient 0" {#assert CM_float(37,1,3)==4599676419421066581;#assert CM_float(37,1,4503599627370497)==4372995238176751614;#assert CM_float(37,1,9007199254740991)==4368491638549381121;#assert CM_float(37,1,4607182418800017409)==1;#assert CM_float(37,1,4608683618675807573)==1;}
#test "subnormal quotient 1" {#assert CM_float(37,3,3)==4607182418800017408;#assert CM_float(37,3,4503599627370497)==4379750637617807359;#assert CM_float(37,3,9007199254740991)==4375247037990436865;#assert CM_float(37,3,4607182418800017409)==3;#assert CM_float(37,3,4608683618675807573)==2;}
#test "subnormal quotient 2" {#assert CM_float(37,2251799813685247,3)==4829360000416961875;#assert CM_float(37,2251799813685247,4503599627370497)==4602678819172646906;#assert CM_float(37,2251799813685247,9007199254740991)==4598175219545276413;#assert CM_float(37,2251799813685247,4607182418800017409)==2251799813685247;#assert CM_float(37,2251799813685247,4608683618675807573)==1688849860263935;}
#test "subnormal quotient 3" {#assert CM_float(37,4503599627370495,3)==4833863600044332372;#assert CM_float(37,4503599627370495,4503599627370497)==4607182418800017404;#assert CM_float(37,4503599627370495,9007199254740991)==4602678819172646911;#assert CM_float(37,4503599627370495,4607182418800017409)==4503599627370494;#assert CM_float(37,4503599627370495,4608683618675807573)==3377699720527871;}
#test "subnormal quotient 4" {#assert CM_float(37,4503599627370497,3)==4833863600044332375;#assert CM_float(37,4503599627370497,4503599627370497)==4607182418800017408;#assert CM_float(37,4503599627370497,9007199254740991)==4602678819172646914;#assert CM_float(37,4503599627370497,4607182418800017409)==4503599627370496;#assert CM_float(37,4503599627370497,4608683618675807573)==3377699720527873;}
#test "subnormal quotient 5" {#assert CM_float(37,9007199254740991,3)==4838367199671702869;#assert CM_float(37,9007199254740991,4503599627370497)==4611686018427387901;#assert CM_float(37,9007199254740991,9007199254740991)==4607182418800017408;#assert CM_float(37,9007199254740991,4607182418800017409)==9007199254740989;#assert CM_float(37,9007199254740991,4608683618675807573)==6755399441055744;}
#test "shift dispatch 63 is valid and bad operands are retained" {a:=CM_from(1,false);b:=CM_from(63,false);#assert !CM_intop(42,a,b).bad && CM_low(CM_intop(42,a,b).mag)==9223372036854775808;#assert !CM_intop(43,a,b).bad && CM_low(CM_intop(43,a,b).mag)==0;b.bad=true;#assert CM_intop(43,a,b).bad;}
#test "format refusals and exact rounding digit boundaries" {out:[48]u8;#assert CM_g(0,out[..])== -1 && CM_g(0x4330000000000000,out[..])>0 && CM_g(0x4320000000000000,out[..])== -1 && CM_g(0x4340000000000000,out[..])>0;}

#test "decimal sticky positions and next digit six" {
b0:[48]u8;n0:=CM_g(4846369624423283201,b0[..]);#assert cast(string)b0[0..<n0]=="1.00001e+16";
b1:[48]u8;n1:=CM_g(4846369624923283200,b1[..]);#assert cast(string)b1[0..<n1]=="1.00001e+16";
b2:[48]u8;n2:=CM_g(4846369629423283200,b2[..]);#assert cast(string)b2[0..<n2]=="1.00001e+16";
}

#test "constant helper recursion at the exact bound" {
 nodes:[140]CK_Node;types:[16]CK_Type;locals:[1]CK_Local;errors:[4]CK_Error;bytes:[1024]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 nodes[2]=CK_Node.{kind=CK_Tag.expr_int,type=4,value=9};
 nodes[3]=CK_Node.{kind=CK_Tag.expr_ident,constant=4};nodes[4]=CK_Node.{kind=CK_Tag.constant,a=2,mark=2};
 #assert !CK_const_int_depth(c,3,63).bad && CK_const_int_depth(c,3,64).bad;
 nodes[5]=CK_Node.{kind=CK_Tag.expr_unary,op=35,a=2};#assert !CK_const_int_depth(c,5,63).bad && CK_const_int_depth(c,5,64).bad;
 nodes[6]=CK_Node.{kind=CK_Tag.expr_binary,op=34,a=2,b=2};#assert !CK_const_int_depth(c,6,63).bad && CK_const_int_depth(c,6,64).bad;
 nodes[6].a=3;#assert CK_const_int_depth(c,6,63).bad;nodes[6].a=2;nodes[6].b=3;#assert CK_const_int_depth(c,6,63).bad;
 nodes[6].b=2;nodes[6].op=39;#assert CK_const_int(c,6).bad;nodes[6].op=33;#assert CK_const_int(c,6).bad;
 nodes[6].op=34;nodes[6].kind=CK_Tag.expr_bool;#assert CK_const_int(c,6).bad;
 nodes[3].constant=1;nodes[1]=CK_Node.{kind=CK_Tag.constant,mark=2,a=2};#assert !CK_const_int(c,3).bad;
 state[0].local_count=1;locals[0]=CK_Local.{name="hidden",type=11};nodes[7]=CK_Node.{kind=CK_Tag.constant,name="C",a=8};nodes[8]=CK_Node.{kind=CK_Tag.expr_ident,name="hidden"};
 #assert CK_constant_type(c,7)==0 && state[0].local_count==1 && errors[0].code=="E0306";
}
#test "semantic resource boundaries refuse partial types" {
 nodes:[16]CK_Node;types:[32]CK_Type;locals:[1]CK_Local;errors:[4]CK_Error;bytes:[1024]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 nodes[2]=CK_Node.{kind=CK_Tag.type_named,name="int"};state[0].depth=256;#assert CK_resolve(c,2,CK_Access.value)==0;#assert CK_expr(c,2,CK_Hint.{})==0;
 state[0]=CK_State.{metal_depth=64};nodes[2]=CK_Node.{kind=CK_Tag.proc,name="deep"};CK_metal_proc(c,2);#assert state[0].error_count==1 && errors[0].code=="E0377" && state[0].metal_depth==64;
 state[0]=CK_State.{metal_depth=63};nodes[2].b=3;nodes[3].kind=CK_Tag.stmt_block;CK_metal_proc(c,2);#assert state[0].error_count==0 && state[0].metal_depth==63 && nodes[2].metal_done;
}

#test "unlaid nominal types resolve by value only" {
 nodes:[32]CK_Node;types:[32]CK_Type;locals:[2]CK_Local;errors:[4]CK_Error;bytes:[1024]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=17;
 nodes[1].head=2;nodes[2]=CK_Node.{kind=CK_Tag.struct_,name="S",type=16,head=3};types[16]=CK_Type.{kind=CK_Kind.struct_,name="S",decl=2};nodes[3]=CK_Node.{kind=CK_Tag.field,name="x",a=4};nodes[4]=CK_Node.{kind=CK_Tag.type_named,name="int"};nodes[5]=CK_Node.{kind=CK_Tag.type_named,name="S"};
 #assert CK_resolve(c,5,CK_Access.view)==16 && nodes[2].mark==0 && types[16].size==0;
 nodes[6]=CK_Node.{kind=CK_Tag.type_array,a=7,b=5};nodes[7]=CK_Node.{kind=CK_Tag.expr_int,value=1};array:=CK_resolve(c,6,CK_Access.value);#assert array==17 && types[array].size==8 && nodes[2].mark==2;
 nodes[8]=CK_Node.{kind=CK_Tag.type_view,b=9};nodes[9]=CK_Node.{kind=CK_Tag.type_named,name="bad"};#assert CK_resolve(c,8,CK_Access.value)==0;
 nodes[2].mark=1;CK_layout(c,2);#assert nodes[2].mark==2;
 nodes[10]=CK_Node.{kind=CK_Tag.expr_int,type=4,value=1};wide:=CM_Int.{mag=CM_U.{w=[4]u32.[0,0,1,0]}};CK_set_int(c,10,wide);#assert nodes[10].type==0;
 nodes[11]=CK_Node.{kind=CK_Tag.expr_ct,type=11};#assert CK_expr(c,11,CK_Hint.{})==11;nodes[11].kind=CK_Tag.expr_enum;#assert CK_expr(c,11,CK_Hint.{})==11;nodes[11].kind=CK_Tag.invalid;#assert CK_expr(c,11,CK_Hint.{})==0;
}



#test "rounding below the guard and two significant digits" {
#assert CM_pack(CM_u(36028797018963968),0,false,CM_Width.f64)==4854880398305394688;
#assert CM_pack(CM_u(36028797018963969),0,false,CM_Width.f64)==4854880398305394688;
#assert CM_pack(CM_u(36028797018963970),0,false,CM_Width.f64)==4854880398305394688;
#assert CM_pack(CM_u(36028797018963971),0,false,CM_Width.f64)==4854880398305394688;
