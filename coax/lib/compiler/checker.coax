    CK_Node.{kind=CK_Tag.type_named,loc=CK_Loc.{line=1,column=27,offset=26},name="int"},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=1,column=33,offset=32},name="f",a=6,b=7,next=10},
    CK_Node.{kind=CK_Tag.type_named,loc=CK_Loc.{line=1,column=42,offset=41},name="int"},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=1,column=46,offset=45},head=8,tail=8},
    CK_Node.{kind=CK_Tag.stmt_return,loc=CK_Loc.{line=1,column=47,offset=46},a=9},
    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=1,column=54,offset=53},value=1},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=1,column=58,offset=57},name="g",b=13,head=11,tail=11,next=14},
    CK_Node.{kind=CK_Tag.param,loc=CK_Loc.{line=1,column=64,offset=63},name="x",a=12},
    CK_Node.{kind=CK_Tag.type_named,loc=CK_Loc.{line=1,column=66,offset=65},name="int"},
