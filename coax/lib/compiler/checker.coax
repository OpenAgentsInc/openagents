  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[1007634126,475132876,3159605451,333693371]},negative=false,bad=false};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
