#test "caps exact admissibility" {
nodes:[64] CK_Node;types:[32] CK_Type;locals:[16] CK_Local;errors:[8] CK_Error;bytes:[4096] u8;state:[1] CK_State;
c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
a:=CK_caps(2,0);#assert a.nodes==22 && a.types==22 && a.locals==18 && a.errors==32 && a.bytes==5120;
b:=CK_caps(2147483646,2147483646);#assert b.nodes==6442450954 && b.types==6442450954 && b.locals==2147483662 && b.errors==17179869184 && b.bytes==1116691500016;
#assert CK_caps(1,0).nodes==0 && CK_caps(2147483647,0).nodes==0 && CK_caps(2,-1).nodes==0 && CK_caps(2,2147483647).nodes==0;
}
#test "local lookup and diagnostic capacity" {
nodes:[64] CK_Node;types:[32] CK_Type;locals:[16] CK_Local;errors:[8] CK_Error;bytes:[4096] u8;state:[1] CK_State;
c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
locals[0]=CK_Local.{name="x",type=8};locals[1]=CK_Local.{name="y",type=9};locals[2]=CK_Local.{name="x",type=10};state[0].local_count=3;
#assert CK_local(c,"x")==2 && CK_local(c,"y")==1 && CK_local(c,"missing")== -1;
state[0].local_count=1;#assert CK_local(c,"x")==0 && CK_local(c,"y")== -1;
for i:0..<8 {CK_error(c,CK_Loc.{line=i+1,column=2,offset=3},"code","msg","fix");#assert errors[i].loc.line==i+1 && errors[i].loc.column==2 && errors[i].loc.offset==3 && errors[i].code=="code" && errors[i].message=="msg" && errors[i].fix=="fix";}
#assert !state[0].fatal && state[0].error_count==8;CK_error(c,CK_Loc.{},"overflow",""," ");#assert state[0].fatal && state[0].error_count==8;CK_resource(c,CK_Loc.{});CK_error(c,CK_Loc.{},"ignored","","");#assert errors[7].code=="code";
}
#test "exact depth budget" {
nodes:[64] CK_Node;types:[32] CK_Type;locals:[16] CK_Local;errors:[8] CK_Error;bytes:[4096] u8;state:[1] CK_State;
c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
state[0].depth=255;loc:=CK_Loc.{line=7,column=9,offset=11};#assert CK_enter(c,loc) && state[0].depth==256;#assert !CK_enter(c,loc) && state[0].depth==256 && state[0].fatal && errors[0].loc.line==7 && errors[0].loc.column==9 && errors[0].loc.offset==11;#assert !CK_enter(c,loc);CK_leave(c);#assert state[0].depth==255 && state[0].error_count==1;
}
#test "node and type storage boundary" {
nodes:[64] CK_Node;types:[32] CK_Type;locals:[16] CK_Local;errors:[8] CK_Error;bytes:[4096] u8;state:[1] CK_State;
c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
state[0].used=62;n:=CK_new(c,CK_Tag.expr_bool,CK_Loc.{line=9});#assert n==63 && nodes[n].kind==CK_Tag.expr_bool && nodes[n].loc.line==9 && nodes[n].field_index== -1;#assert CK_new(c,CK_Tag.expr_int,CK_Loc.{})==0 && state[0].fatal;#assert CK_new(c,CK_Tag.expr_int,CK_Loc.{})==0 && state[0].used==63;
state[0].fatal=false;state[0].type_count=31;q:=CK_new_type(c,CK_Type.{name="last",size=3});#assert q==31 && state[0].type_count==32 && types[31].name=="last" && types[31].size==3;#assert CK_new_type(c,CK_Type.{})==0 && state[0].fatal;
}
#test "text capacity exact and negative integer formatting" {
nodes:[64] CK_Node;types:[32] CK_Type;locals:[16] CK_Local;errors:[8] CK_Error;bytes:[4096] u8;state:[1] CK_State;
c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
#assert CK_count(c,-9223372036854775808)=="-9223372036854775808";state[0].byte_count=4093;parts:=[3]string.["a","","bc"];#assert CK_text(c,parts[..])=="abc" && state[0].byte_count==4096;#assert CK_join2(c,"","")=="" && !state[0].fatal;#assert CK_join2(c,"x","")=="" && state[0].fatal && state[0].byte_count==4096;
}
#test "small bad operands and illegal shift widths" {
nodes:[64] CK_Node;types:[32] CK_Type;locals:[16] CK_Local;errors:[8] CK_Error;bytes:[4096] u8;state:[1] CK_State;
c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
a:=CM_Int.{mag=CM_u(12),bad=true};b:=CM_from(2,false);#assert CM_mul(a,b).bad && CM_mul(b,a).bad;
#assert CM_shift(42,b,-1).bad && CM_shift(43,b,64).bad;#assert !CM_fits(b,0,false) && !CM_fits(b,65,true) && !CM_fits(a,64,true);
bytes2:[2]u8;#assert CM_decimal(CM_from(12,false),bytes2[..])==2 && cast(string)bytes2[..]=="12";#assert CM_decimal(CM_from(123,false),bytes2[..])== -1;
}
