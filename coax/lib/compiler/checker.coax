#test "wide oracle 5" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[4294967295,4294967295,4294967295,4294967295]},negative=false,bad=false};b:=CM_Int.{mag=CM_U.{w=[4] u32.[1,0,0,0]},negative=false,bad=false};
  got0:=CM_add(a,b);want0:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=true};#assert got0.negative==want0.negative && got0.bad==want0.bad;for k:0..<4 {#assert got0.mag.w[k]==want0.mag.w[k];}
  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[4294967294,4294967295,4294967295,4294967295]},negative=false,bad=false};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
  got2:=CM_mul(a,b);want2:=CM_Int.{mag=CM_U.{w=[4] u32.[4294967295,4294967295,4294967295,4294967295]},negative=false,bad=false};#assert got2.negative==want2.negative && got2.bad==want2.bad;for k:0..<4 {#assert got2.mag.w[k]==want2.mag.w[k];}
  got3:=CM_divide(a,b,false);want3:=CM_Int.{mag=CM_U.{w=[4] u32.[4294967295,4294967295,4294967295,4294967295]},negative=false,bad=false};#assert got3.negative==want3.negative && got3.bad==want3.bad;for k:0..<4 {#assert got3.mag.w[k]==want3.mag.w[k];}
