  got6:=CM_bitwise(40,a,b);want6:=CM_Int.{mag=CM_U.{w=[4] u32.[1175193109,722,1480624299,1827669344]},negative=true,bad=false};#assert got6.negative==want6.negative && got6.bad==want6.bad;for k:0..<4 {#assert got6.mag.w[k]==want6.mag.w[k];}
  got7:=CM_bitwise(41,a,b);want7:=CM_Int.{mag=CM_U.{w=[4] u32.[1315874325,135930579,1572903407,1844733280]},negative=true,bad=false};#assert got7.negative==want7.negative && got7.bad==want7.bad;for k:0..<4 {#assert got7.mag.w[k]==want7.mag.w[k];}
