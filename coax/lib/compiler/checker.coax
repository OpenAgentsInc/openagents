#forall "inline array subobjects retain local provenance; stored borrows and calls need summaries" variant:0..<8 {
 nodes:[8]CK_Node;types:[20]CK_Type;locals:[4]CK_Local;errors:[4]CK_Error;bytes:[64]u8;state:=[1]CK_State.[CK_State.{local_count=2}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
 types[16]=CK_Type.{kind=CK_Kind.array};types[17]=CK_Type.{kind=CK_Kind.view};types[18]=CK_Type.{kind=CK_Kind.struct_};
 locals[0]=CK_Local.{name="a",local_backing=true};locals[1]=CK_Local.{name="borrow"};
