  bytes:[48] u8;n:=CM_decimal(a,bytes[..]);#assert n==39 && cast(string)bytes[0..<n]=="-18173669035961014351540608561563665999";
}
#test "wide oracle 23" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[2820927668,1436726320,3163400236,1993221196]},negative=true,bad=false};b:=CM_Int.{mag=CM_U.{w=[4] u32.[3828561794,1911859196,2028038391,2326914568]},negative=true,bad=false};
