    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=1,column=37,offset=36},value=1},
    CK_Node.{kind=CK_Tag.expr_binary,loc=CK_Loc.{line=1,column=36,offset=35},a=5,b=6,op=34}];
  nodes:[40] CK_Node;for v,i:initial {nodes[i]=v;}
  types:[40] CK_Type;locals:[24] CK_Local;errors:[80] CK_Error;bytes:[8504] u8;state:[1] CK_State;
  context:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
  ok:=CK_run(context,initial.count-1,CK_Options.{library=true,metal=false,authority=false});
  #assert ok==false && state[0].error_count==1 && state[0].depth==0;
  // The semantic pass restores its scope/depth counters.
  #assert state[0].used==7;
  #assert state[0].type_count==16;
  #assert state[0].composite_count==0;
  #assert state[0].local_count==0;
  #assert state[0].byte_count==73;
  #assert state[0].error_count==1;
  #assert state[0].current==2;
  #assert state[0].constant_depth==0;
  #assert state[0].loop_depth==0;
  #assert state[0].defer_depth==0;
  #assert state[0].unevaluated==0;
  #assert state[0].basic==false;
  #assert state[0].depth==0;
  #assert state[0].fatal==false;
  #assert state[0].metal_depth==0;

  #assert errors[0].code=="E0350" && errors[0].loc.line==1 && errors[0].loc.column==36 && errors[0].message=="constant 18446744073709551616 does not fit in 64 bits" && errors[0].fix=="";
  expected:=[8] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=2},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=1,column=1,offset=0},name="main",b=3,type=1},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=1,column=12,offset=11},head=4,tail=4},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=1,column=13,offset=12},name="x",a=7},
    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=1,column=16,offset=15},value=18446744073709551615,type=4},
    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=1,column=37,offset=36},value=1,type=4},
    CK_Node.{kind=CK_Tag.expr_binary,loc=CK_Loc.{line=1,column=36,offset=35},a=5,b=6,op=34}];
  #assert state[0].used==expected.count-1;
  for i:0..<expected.count {a:=nodes[i];b:=expected[i];
    #assert a.kind==b.kind;
    #assert a.loc.line==b.loc.line && a.loc.column==b.loc.column && a.loc.offset==b.loc.offset;
    #assert a.name==b.name;
    #assert a.name2==b.name2;
    #assert a.loc2.line==b.loc2.line && a.loc2.column==b.loc2.column && a.loc2.offset==b.loc2.offset;
    #assert a.a==b.a;
    #assert a.b==b.b;
    #assert a.c==b.c;
    #assert a.d==b.d;
