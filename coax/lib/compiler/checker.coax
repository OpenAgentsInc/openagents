#test "wide oracle 28" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[1058377323,1983820719,3323927829,1888556139]},negative=false,bad=true};b:=CM_Int.{mag=CM_U.{w=[4] u32.[3730504366,4084014685,3247451219,4286452180]},negative=true,bad=false};
  got0:=CM_add(a,b);want0:=CM_Int.{mag=CM_U.{w=[4] u32.[2672127043,2100193966,4218490686,2397896040]},negative=true,bad=true};#assert got0.negative==want0.negative && got0.bad==want0.bad;for k:0..<4 {#assert got0.mag.w[k]==want0.mag.w[k];}
  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[493914393,1772868109,2276411753,1880041024]},negative=false,bad=true};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
  got2:=CM_mul(a,b);want2:=CM_Int.{mag=CM_U.{w=[4] u32.[3378072250,1685875371,4187971337,3702054288]},negative=true,bad=true};#assert got2.negative==want2.negative && got2.bad==want2.bad;for k:0..<4 {#assert got2.mag.w[k]==want2.mag.w[k];}
  got3:=CM_divide(a,b,false);want3:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=true};#assert got3.negative==want3.negative && got3.bad==want3.bad;for k:0..<4 {#assert got3.mag.w[k]==want3.mag.w[k];}
  got4:=CM_divide(a,b,true);want4:=CM_Int.{mag=CM_U.{w=[4] u32.[1058377323,1983820719,3323927829,1888556139]},negative=false,bad=true};#assert got4.negative==want4.negative && got4.bad==want4.bad;for k:0..<4 {#assert got4.mag.w[k]==want4.mag.w[k];}
  got5:=CM_bitwise(39,a,b);want5:=CM_Int.{mag=CM_U.{w=[4] u32.[553976898,68329890,101650692,8455211]},negative=false,bad=true};#assert got5.negative==want5.negative && got5.bad==want5.bad;for k:0..<4 {#assert got5.mag.w[k]==want5.mag.w[k];}
  got6:=CM_bitwise(40,a,b);want6:=CM_Int.{mag=CM_U.{w=[4] u32.[1068863355,2126443439,4269793213,1888616043]},negative=false,bad=true};#assert got6.negative==want6.negative && got6.bad==want6.bad;for k:0..<4 {#assert got6.mag.w[k]==want6.mag.w[k];}
  got7:=CM_bitwise(41,a,b);want7:=CM_Int.{mag=CM_U.{w=[4] u32.[514886457,2058113549,4168142521,1880160832]},negative=false,bad=true};#assert got7.negative==want7.negative && got7.bad==want7.bad;for k:0..<4 {#assert got7.mag.w[k]==want7.mag.w[k];}
  #assert CM_compare(a,b)==1;
  bytes:[48] u8;n:=CM_decimal(a,bytes[..]);#assert n==39 && cast(string)bytes[0..<n]=="149626832759319235820620365163188817515";
}
#test "wide oracle 29" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[2044835978,179718831,1741241408,309849164]},negative=true,bad=false};b:=CM_Int.{mag=CM_U.{w=[4] u32.[108004227,3705344737,3922377891,2763411889]},negative=false,bad=false};
  got0:=CM_add(a,b);want0:=CM_Int.{mag=CM_U.{w=[4] u32.[2358135545,3525625905,2181136483,2453562725]},negative=false,bad=false};#assert got0.negative==want0.negative && got0.bad==want0.bad;for k:0..<4 {#assert got0.mag.w[k]==want0.mag.w[k];}
  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[2152840205,3885063568,1368652003,3073261054]},negative=true,bad=false};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
  got2:=CM_mul(a,b);want2:=CM_Int.{mag=CM_U.{w=[4] u32.[4228582558,3694381206,3580402623,2566291622]},negative=true,bad=true};#assert got2.negative==want2.negative && got2.bad==want2.bad;for k:0..<4 {#assert got2.mag.w[k]==want2.mag.w[k];}
  got3:=CM_divide(a,b,false);want3:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=false};#assert got3.negative==want3.negative && got3.bad==want3.bad;for k:0..<4 {#assert got3.mag.w[k]==want3.mag.w[k];}
  got4:=CM_divide(a,b,true);want4:=CM_Int.{mag=CM_U.{w=[4] u32.[2044835978,179718831,1741241408,309849164]},negative=true,bad=false};#assert got4.negative==want4.negative && got4.bad==want4.bad;for k:0..<4 {#assert got4.mag.w[k]==want4.mag.w[k];}
  got5:=CM_bitwise(39,a,b);want5:=CM_Int.{mag=CM_U.{w=[4] u32.[4193254654,733409215,2013101916,1535110734]},negative=true,bad=false};#assert got5.negative==want5.negative && got5.bad==want5.bad;for k:0..<4 {#assert got5.mag.w[k]==want5.mag.w[k];}
  got6:=CM_bitwise(40,a,b);want6:=CM_Int.{mag=CM_U.{w=[4] u32.[2038544393,35932174,100728896,306293836]},negative=true,bad=false};#assert got6.negative==want6.negative && got6.bad==want6.bad;for k:0..<4 {#assert got6.mag.w[k]==want6.mag.w[k];}
  got7:=CM_bitwise(41,a,b);want7:=CM_Int.{mag=CM_U.{w=[4] u32.[2154710261,697477041,1912373020,1228816898]},negative=false,bad=false};#assert got7.negative==want7.negative && got7.bad==want7.bad;for k:0..<4 {#assert got7.mag.w[k]==want7.mag.w[k];}
  #assert CM_compare(a,b)==-1;
  bytes:[48] u8;n:=CM_decimal(a,bytes[..]);#assert n==39 && cast(string)bytes[0..<n]=="-24548779952421177703066926751424821386";
}
#test "wide oracle 30" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[2328698288,254910054,2971705730,3372170639]},negative=true,bad=false};b:=CM_Int.{mag=CM_U.{w=[4] u32.[1916771301,2333926323,1998718417,1753675724]},negative=true,bad=false};
  got0:=CM_add(a,b);want0:=CM_Int.{mag=CM_U.{w=[4] u32.[4245469589,2588836377,675456851,830879068]},negative=true,bad=true};#assert got0.negative==want0.negative && got0.bad==want0.bad;for k:0..<4 {#assert got0.mag.w[k]==want0.mag.w[k];}
  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[411926987,2215951027,972987312,1618494915]},negative=true,bad=false};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
  got2:=CM_mul(a,b);want2:=CM_Int.{mag=CM_U.{w=[4] u32.[147136112,89463175,2447701839,743219020]},negative=false,bad=true};#assert got2.negative==want2.negative && got2.bad==want2.bad;for k:0..<4 {#assert got2.mag.w[k]==want2.mag.w[k];}
  got3:=CM_divide(a,b,false);want3:=CM_Int.{mag=CM_U.{w=[4] u32.[1,0,0,0]},negative=false,bad=false};#assert got3.negative==want3.negative && got3.bad==want3.bad;for k:0..<4 {#assert got3.mag.w[k]==want3.mag.w[k];}
  got4:=CM_divide(a,b,true);want4:=CM_Int.{mag=CM_U.{w=[4] u32.[411926987,2215951027,972987312,1618494915]},negative=true,bad=false};#assert got4.negative==want4.negative && got4.bad==want4.bad;for k:0..<4 {#assert got4.mag.w[k]==want4.mag.w[k];}
  got5:=CM_bitwise(39,a,b);want5:=CM_Int.{mag=CM_U.{w=[4] u32.[83910672,1891762184,148724268,385876016]},negative=false,bad=false};#assert got5.negative==want5.negative && got5.bad==want5.bad;for k:0..<4 {#assert got5.mag.w[k]==want5.mag.w[k];}
  got6:=CM_bitwise(40,a,b);want6:=CM_Int.{mag=CM_U.{w=[4] u32.[34412965,185631266,824181120,1216755084]},negative=true,bad=false};#assert got6.negative==want6.negative && got6.bad==want6.bad;for k:0..<4 {#assert got6.mag.w[k]==want6.mag.w[k];}
  got7:=CM_bitwise(41,a,b);want7:=CM_Int.{mag=CM_U.{w=[4] u32.[118323637,2077393450,972905388,1602631100]},negative=true,bad=false};#assert got7.negative==want7.negative && got7.bad==want7.bad;for k:0..<4 {#assert got7.mag.w[k]==want7.mag.w[k];}
  #assert CM_compare(a,b)==-1;
  bytes:[48] u8;n:=CM_decimal(a,bytes[..]);#assert n==40 && cast(string)bytes[0..<n]=="-267170883467340912982513872519811636656";
}
#test "wide oracle 31" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[430125248,1697401296,25334279,883010185]},negative=true,bad=false};b:=CM_Int.{mag=CM_U.{w=[4] u32.[2043597660,17409295,2663990757,1285680553]},negative=true,bad=false};
  got0:=CM_add(a,b);want0:=CM_Int.{mag=CM_U.{w=[4] u32.[2473722908,1714810591,2689325036,2168690738]},negative=true,bad=false};#assert got0.negative==want0.negative && got0.bad==want0.bad;for k:0..<4 {#assert got0.mag.w[k]==want0.mag.w[k];}
  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[1613472412,2614975295,2638656477,402670368]},negative=false,bad=false};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
