#test "generics: struct fields cannot hold a type parameter" {
  initial:=[8] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=2},
    CK_Node.{kind=CK_Tag.struct_,loc=CK_Loc.{line=1,column=1,offset=0},name="S",head=3,tail=5},
