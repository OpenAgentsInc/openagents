    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=2},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=1,column=1,offset=0},name="f",a=5,b=6,head=3,tail=3},
    CK_Node.{kind=CK_Tag.param,loc=CK_Loc.{line=1,column=7,offset=6},name="x",a=4},
    CK_Node.{kind=CK_Tag.type_named,loc=CK_Loc.{line=1,column=9,offset=8},name="f32"},
    CK_Node.{kind=CK_Tag.type_named,loc=CK_Loc.{line=1,column=15,offset=14},name="f32"},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=1,column=19,offset=18},head=7,tail=12},
    CK_Node.{kind=CK_Tag.stmt_while,loc=CK_Loc.{line=1,column=20,offset=19},a=10,c=11,next=12},
    CK_Node.{kind=CK_Tag.expr_ident,loc=CK_Loc.{line=1,column=26,offset=25},name="x"},
    CK_Node.{kind=CK_Tag.expr_float,loc=CK_Loc.{line=1,column=28,offset=27},type=6},
    CK_Node.{kind=CK_Tag.expr_binary,loc=CK_Loc.{line=1,column=27,offset=26},a=8,b=9,op=48},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=1,column=35,offset=34}},
    CK_Node.{kind=CK_Tag.stmt_return,loc=CK_Loc.{line=1,column=38,offset=37},a=13},
    CK_Node.{kind=CK_Tag.expr_ident,loc=CK_Loc.{line=1,column=45,offset=44},name="x"}];
  nodes:[58] CK_Node;for v,i:initial {nodes[i]=v;}
  types:[58] CK_Type;locals:[30] CK_Local;errors:[128] CK_Error;bytes:[11640] u8;state:[1] CK_State;
  context:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
  ok:=CK_run(context,initial.count-1,CK_Options.{library=true,metal=true,authority=false});
  #assert ok==false && state[0].error_count==1 && state[0].depth==0;
  // The semantic pass restores its scope/depth counters.
  #assert state[0].used==13;
  #assert state[0].type_count==16;
  #assert state[0].composite_count==0;
  #assert state[0].local_count==1;
  #assert state[0].byte_count==53;
  #assert state[0].error_count==1;
  #assert state[0].current==2;
  #assert state[0].constant_depth==0;
  #assert state[0].loop_depth==0;
  #assert state[0].defer_depth==0;
  #assert state[0].unevaluated==0;
  #assert state[0].basic==false;
  #assert state[0].depth==0;
  #assert state[0].fatal==false;
  #assert state[0].metal_depth==0;

  #assert errors[0].code=="E0377" && errors[0].loc.line==1 && errors[0].loc.column==20 && errors[0].message=="a loop is outside the Metal scalar profile" && errors[0].fix=="Metal libraries use f32 and bool, if/else and calls; no loops, strings, integers or host calls";
  expected:=[14] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=2},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=1,column=1,offset=0},name="f",a=5,b=6,head=3,tail=3,type=6,metal_done=true},
    CK_Node.{kind=CK_Tag.param,loc=CK_Loc.{line=1,column=7,offset=6},name="x",a=4,type=6},
    CK_Node.{kind=CK_Tag.type_named,loc=CK_Loc.{line=1,column=9,offset=8},name="f32"},
    CK_Node.{kind=CK_Tag.type_named,loc=CK_Loc.{line=1,column=15,offset=14},name="f32"},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=1,column=19,offset=18},head=7,tail=12},
    CK_Node.{kind=CK_Tag.stmt_while,loc=CK_Loc.{line=1,column=20,offset=19},a=10,c=11,next=12},
    CK_Node.{kind=CK_Tag.expr_ident,loc=CK_Loc.{line=1,column=26,offset=25},name="x",type=6},
    CK_Node.{kind=CK_Tag.expr_float,loc=CK_Loc.{line=1,column=28,offset=27},type=6},
    CK_Node.{kind=CK_Tag.expr_binary,loc=CK_Loc.{line=1,column=27,offset=26},a=8,b=9,op=48,type=2},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=1,column=35,offset=34}},
    CK_Node.{kind=CK_Tag.stmt_return,loc=CK_Loc.{line=1,column=38,offset=37},a=13},
    CK_Node.{kind=CK_Tag.expr_ident,loc=CK_Loc.{line=1,column=45,offset=44},name="x",type=6}];
  #assert state[0].used==expected.count-1;
  for i:0..<expected.count {a:=nodes[i];b:=expected[i];
    #assert a.kind==b.kind;
    #assert a.loc.line==b.loc.line && a.loc.column==b.loc.column && a.loc.offset==b.loc.offset;
    #assert a.name==b.name;
    #assert a.name2==b.name2;
    #assert a.loc2.line==b.loc2.line && a.loc2.column==b.loc2.column && a.loc2.offset==b.loc2.offset;
    #assert a.a==b.a;
    #assert a.b==b.b;
    #assert a.c==b.c;
    #assert a.d==b.d;
    #assert a.head==b.head;
    #assert a.tail==b.tail;
    #assert a.next==b.next;
    #assert a.op==b.op;
    #assert a.flag==b.flag;
    #assert a.flag2==b.flag2;
    #assert a.value==b.value;
    #assert a.floating==b.floating;
    #assert a.type==b.type;
    #assert a.field_index==b.field_index;
    #assert a.proc==b.proc;
    #assert a.constant==b.constant;
    #assert a.negative==b.negative;
    #assert a.folded==b.folded;
    #assert a.builtin_print==b.builtin_print;
    #assert a.byte_intrinsic==b.byte_intrinsic;
    #assert a.intrinsic==b.intrinsic;
    #assert a.mark==b.mark;
    #assert a.reached==b.reached;
    #assert a.metal_done==b.metal_done;
    #assert a.metal_active==b.metal_active;
  }
}
