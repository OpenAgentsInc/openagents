  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[585852136,681163225,1436124122,825350239]},negative=true,bad=false};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
  got2:=CM_mul(a,b);want2:=CM_Int.{mag=CM_U.{w=[4] u32.[160305993,1498522212,3888719649,3511052493]},negative=false,bad=true};#assert got2.negative==want2.negative && got2.bad==want2.bad;for k:0..<4 {#assert got2.mag.w[k]==want2.mag.w[k];}
  got3:=CM_divide(a,b,false);want3:=CM_Int.{mag=CM_U.{w=[4] u32.[2,0,0,0]},negative=false,bad=false};#assert got3.negative==want3.negative && got3.bad==want3.bad;for k:0..<4 {#assert got3.mag.w[k]==want3.mag.w[k];}
  got4:=CM_divide(a,b,true);want4:=CM_Int.{mag=CM_U.{w=[4] u32.[1673641719,4262031420,4269396127,384989180]},negative=true,bad=false};#assert got4.negative==want4.negative && got4.bad==want4.bad;for k:0..<4 {#assert got4.mag.w[k]==want4.mag.w[k];}
  got5:=CM_bitwise(39,a,b);want5:=CM_Int.{mag=CM_U.{w=[4] u32.[4282232825,2075806717,4290754366,1535080675]},negative=true,bad=false};#assert got5.negative==want5.negative && got5.bad==want5.bad;for k:0..<4 {#assert got5.mag.w[k]==want5.mag.w[k];}
  got6:=CM_bitwise(40,a,b);want6:=CM_Int.{mag=CM_U.{w=[4] u32.[2717974737,33554708,68760336,170991680]},negative=true,bad=false};#assert got6.negative==want6.negative && got6.bad==want6.bad;for k:0..<4 {#assert got6.mag.w[k]==want6.mag.w[k];}
  got7:=CM_bitwise(41,a,b);want7:=CM_Int.{mag=CM_U.{w=[4] u32.[1564258088,2042252009,4221994030,1364088995]},negative=false,bad=false};#assert got7.negative==want7.negative && got7.bad==want7.bad;for k:0..<4 {#assert got7.mag.w[k]==want7.mag.w[k];}
  #assert CM_compare(a,b)==-1;
  bytes:[48] u8;n:=CM_decimal(a,bytes[..]);#assert n==40 && cast(string)bytes[0..<n]=="-100279980388311628807354475787951868633";
}
#test "wide oracle 21" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[3942677940,2152576539,845554723,1915156495]},negative=true,bad=true};b:=CM_Int.{mag=CM_U.{w=[4] u32.[3465295507,1822681733,3052247931,3473989955]},negative=true,bad=false};
  got0:=CM_add(a,b);want0:=CM_Int.{mag=CM_U.{w=[4] u32.[3113006151,3975258273,3897802654,1094179154]},negative=true,bad=true};#assert got0.negative==want0.negative && got0.bad==want0.bad;for k:0..<4 {#assert got0.mag.w[k]==want0.mag.w[k];}
  got1:=CM_sub(a,b);want1:=CM_Int.{mag=CM_U.{w=[4] u32.[3817584863,3965072489,2206693207,1558833460]},negative=false,bad=true};#assert got1.negative==want1.negative && got1.bad==want1.bad;for k:0..<4 {#assert got1.mag.w[k]==want1.mag.w[k];}
  got2:=CM_mul(a,b);want2:=CM_Int.{mag=CM_U.{w=[4] u32.[2721850972,2737583497,363547040,2396750711]},negative=false,bad=true};#assert got2.negative==want2.negative && got2.bad==want2.bad;for k:0..<4 {#assert got2.mag.w[k]==want2.mag.w[k];}
  got3:=CM_divide(a,b,false);want3:=CM_Int.{mag=CM_U.{w=[4] u32.[0,0,0,0]},negative=false,bad=true};#assert got3.negative==want3.negative && got3.bad==want3.bad;for k:0..<4 {#assert got3.mag.w[k]==want3.mag.w[k];}
  got4:=CM_divide(a,b,true);want4:=CM_Int.{mag=CM_U.{w=[4] u32.[3942677940,2152576539,845554723,1915156495]},negative=true,bad=true};#assert got4.negative==want4.negative && got4.bad==want4.bad;for k:0..<4 {#assert got4.mag.w[k]==want4.mag.w[k];}
  got5:=CM_bitwise(39,a,b);want5:=CM_Int.{mag=CM_U.{w=[4] u32.[276004940,319816032,1209024644,13174448]},negative=false,bad=true};#assert got5.negative==want5.negative && got5.bad==want5.bad;for k:0..<4 {#assert got5.mag.w[k]==want5.mag.w[k];}
  got6:=CM_bitwise(40,a,b);want6:=CM_Int.{mag=CM_U.{w=[4] u32.[3389011091,107009,811860003,1107353603]},negative=true,bad=true};#assert got6.negative==want6.negative && got6.bad==want6.bad;for k:0..<4 {#assert got6.mag.w[k]==want6.mag.w[k];}
  got7:=CM_bitwise(41,a,b);want7:=CM_Int.{mag=CM_U.{w=[4] u32.[3665016031,319923041,2020884647,1120528051]},negative=true,bad=true};#assert got7.negative==want7.negative && got7.bad==want7.bad;for k:0..<4 {#assert got7.mag.w[k]==want7.mag.w[k];}
  #assert CM_compare(a,b)==1;
  bytes:[48] u8;n:=CM_decimal(a,bytes[..]);#assert n==40 && cast(string)bytes[0..<n]=="-151734330041706607873890983894153461172";
}
#test "wide oracle 22" {a:=CM_Int.{mag=CM_U.{w=[4] u32.[1650820687,1375790124,473839946,229383952]},negative=true,bad=false};b:=CM_Int.{mag=CM_U.{w=[4] u32.[3897602698,253542869,1067862270,1750521876]},negative=true,bad=true};
