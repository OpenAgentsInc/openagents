CK_local_backed :: (c:CK_Context,id:int)->bool {
 if id<2 {return false;}e:=c.nodes[id];if !CK_enter(c,e.loc) {return false;}defer CK_leave(c);
 if e.kind==CK_Tag.expr_ident {at:=CK_local(c,e.name);return at>=0 && c.locals[at].local_backing;}
