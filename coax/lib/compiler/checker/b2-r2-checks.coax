#forall "R2 B2 write summaries remain reusable when retained lookup enables the index" indexed:bool {
 nodes:[96]CK_Node;types:[24]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:[1]CK_State;queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;scratch:[1280]int;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..],result_work=scratch[..]};CB2_fixture(c);b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};out:[64]BS_Origin;
 raw:=CB_query(b,1,2,BS_Path.{},out[..]);#assert !state[0].fatal && state[0].error_count==0 && raw.count==1 && !raw.incomplete && out[0].kind==BS_PARAMETER && out[0].root==0;
 row:=nodes[31].borrow_query;#assert row>0 && queries[row-1].kind==5 && queries[row-1].status==2;before:=work[0].queries;
 b.retain_fields=true;if indexed {b.query_index=CB_index_begin(b);}path:=BS_Path.{count=2};path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};path.steps[1]=BS_Step.{kind=BS_FIELD};
 got:=CB_query(b,5,31,path,out[..]);#assert !state[0].fatal && state[0].error_count==0 && got.count==1 && !got.incomplete && out[0].kind==BS_PARAMETER && out[0].root==1 && out[0].type==12 && out[0].role==BS_DESCRIPTOR && out[0].path.count==0 && queries[row-1].status==2;
}

#forall "R2 B2 by-value mutable sum carriers keep the unsupported write boundary manual" family:0..<3 {
 nodes:[96]CK_Node;types:[24]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:[1]CK_State;queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CB2_fixture(c);state[0].type_count=23;
 types[22]=CK_Type.{kind=CK_Kind.optional,elem=19,sum_default=0};active:=1;
 if family==1 {types[22]=CK_Type.{kind=CK_Kind.union_,decl=80,sum_default= -1};nodes[80]=CK_Node.{kind=CK_Tag.union_,head=81};nodes[81]=CK_Node.{kind=CK_Tag.variant,type=19,next=82};nodes[82]=CK_Node.{kind=CK_Tag.variant,type=1,value=1};active=0;}
 if family==2 {types[22]=CK_Type.{kind=CK_Kind.result,elem=19,sum_error=11,sum_default= -1};active=0;}
 nodes[23]=CK_Node.{kind=CK_Tag.expr_sum,type=22,a=84,sum_variant=active};nodes[84]=CK_Node.{kind=CK_Tag.expr_slice,type=19,a=24};nodes[31].type=22;nodes[44].borrow_binding=90;nodes[31].borrow_writes=0;nodes[90]=CK_Node.{kind=CK_Tag.case_binding,type=19,a=85,sum_variant=active,borrow_owner=30,borrow_writes=40};nodes[85]=CK_Node.{kind=CK_Tag.expr_ident,type=22,borrow_binding=31};nodes[50].head=86;nodes[86]=CK_Node.{kind=CK_Tag.stmt_switch,a=85,head=87};nodes[87]=CK_Node.{kind=CK_Tag.switch_case,a=90,b=88,next=89,sum_variant=active};nodes[88]=CK_Node.{kind=CK_Tag.stmt_block,head=40};nodes[89]=CK_Node.{kind=CK_Tag.switch_case,b=91,sum_variant=ifx active==0 then 1 else 0};nodes[91]=CK_Node.{kind=CK_Tag.stmt_block};if family==2 {nodes[89].a=92;nodes[92]=CK_Node.{kind=CK_Tag.case_binding,type=11,a=85,sum_variant=1,borrow_owner=30};}
 b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};path:=BS_Path.{count=2};path.steps[0]=BS_Step.{kind=BS_ELEMENT};path.steps[1]=BS_Step.{kind=BS_FIELD};out:[64]BS_Origin;out[0]=BS_Origin.{kind=BS_LOCAL,root=9,type=12,role=BS_DESCRIPTOR};
 got:=CB_call_writes(b,8,path,out[..],CB_Result.{count=1});#assert !state[0].fatal && state[0].error_count==0 && got.count==1 && got.incomplete && out[0].kind==BS_LOCAL && out[0].root==9;
 #assert CB_opaque(b,8,path) && !state[0].fatal && state[0].error_count==0;
}
