 else if mode==11 {#assert !state[0].fatal && state[0].error_count==0 && r.count==0 && r.incomplete && out[0].root==901;}
 else {#assert !state[0].fatal && state[0].error_count==0 && r.count==1 && r.incomplete==(mode==12) && out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].type==(ifx mode==6 then 13 else 12) && out[0].path.steps[0].index==p.steps[0].index && out[1].root==902;}
