 nodes:[96]CK_Node;types:[24]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:[1]CK_State;queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CB2_fixture(c);b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};path:=BS_Path.{count=2};path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};path.steps[1]=BS_Step.{kind=BS_FIELD};
 if sample==0 {work[0].work=2097152;}if sample==1 {work[0].queries=128;}if sample==2 {work[0].origins=1024;}
 if sample==3 {work[0].queries=1;nodes[31].borrow_query=1;queries[0]=CK_BorrowQuery.{kind=5,decl=31,type=16,path=path,status=1};}
 out:[64]BS_Origin;r:=CB_query(b,5,31,path,out[..]);if sample==3 {#assert r.count==0 && r.incomplete && !state[0].fatal && state[0].error_count==0;}else {#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && r.count==0;}
}

