 if sample==5 {nodes[2].borrow_calls=0;}
 r:=CB_call_writes(b,8,path,out[..],CB_Result.{});#assert work[0].depth==prior;if sample==0 {#assert !state[0].fatal && state[0].error_count==0 && r.count==1 && !r.incomplete && out[0].kind==BS_PARAMETER && out[0].root==0;}else if sample==5 {#assert !state[0].fatal && state[0].error_count==0 && r.count==0 && !r.incomplete;}else {#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && r.count==0;}
}

// Node numbering is not a proof of AST kind. These admitted permutations
// exercise both ends of the same frozen prefix, independently of parser order.
CB2_reowner :: (c:CK_Context,owner:int) {c.nodes[owner]=c.nodes[2];c.nodes[1].head=owner;c.nodes[22].borrow_owner=owner;for id:[4]int.[3,4,8,9] {c.nodes[id].borrow_owner=owner;}}
