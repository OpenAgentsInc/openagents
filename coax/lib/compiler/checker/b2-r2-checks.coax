 if sample==9 || sample==10 {nodes[40].a=73;nodes[71]=CK_Node.{kind=CK_Tag.stmt_var,type=20,borrow_owner=30};nodes[72]=CK_Node.{kind=CK_Tag.expr_ident,type=20,borrow_binding=71};nodes[73]=CK_Node.{kind=CK_Tag.expr_slice,type=16,a=72,loc=CK_Loc.{line=81,column=24}};}
 if sample==10 {nodes[31].borrow_writes=0;nodes[76]=CK_Node.{kind=CK_Tag.stmt_var,type=19,a=77,borrow_owner=30,borrow_writes=40};nodes[77]=CK_Node.{kind=CK_Tag.expr_ident,type=19,borrow_binding=31};nodes[44].borrow_binding=76;}
 out:[64]BS_Origin;r:=CB_query(b,1,2,BS_Path.{},out[..]);#assert !state[0].fatal;
 if sample==1 || sample==9 || sample==10 {#assert state[0].error_count==1 && errors[0].code=="E0383";#assert errors[0].loc.line==(ifx sample==1 then 90 else 81) && errors[0].loc.column==(ifx sample==1 then 5 else 24);}
 else {#assert state[0].error_count==0;empty:=sample==5 || sample==6 || sample==8;#assert r.count==(ifx empty then 0 else 1) && r.incomplete==(sample==4 || sample==5);if !empty {#assert out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].role==BS_DESCRIPTOR && out[0].type==12 && out[0].path.count==0;}}
