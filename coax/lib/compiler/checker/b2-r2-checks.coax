 field.steps[0].index=8;#assert CB_type(b,18,field)==16 && !state[0].fatal;work[0].work=2097149;r:=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && state[0].error_count==0 && r.count==1 && !r.incomplete && out[0].type==13 && bs_path_equal(out[0].path,path);
