#forall "B2 raw return composition and retained-only manual boundary preserve known facts" sample:0..<4 {
 nodes:[96]CK_Node;types:[24]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:[1]CK_State;queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CB2_fixture(c);b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};path:=BS_Path.{count=2};path.steps[0]=BS_Step.{kind=BS_ELEMENT};path.steps[1]=BS_Step.{kind=BS_FIELD};out:[64]BS_Origin;
 if sample==2 {nodes[25]=CK_Node.{kind=CK_Tag.expr_slice,type=16,a=27,next=26};}
 if sample==3 {nodes[8].borrow_writes=70;nodes[70]=CK_Node.{kind=CK_Tag.stmt_assign,c=11,a=26,borrow_owner=2};}
 if sample==1 || sample==2 {raw:=CB_query(b,2,8,path,out[..]);#assert raw.count==1 && !raw.incomplete;}
 b.retain_fields=true;b.retain_classes=true;r:=CB_query(b,2,8,path,out[..]);#assert !state[0].fatal && state[0].error_count==0;
 if sample==0 {#assert r.count==0 && r.incomplete;for q:queries[0..<work[0].queries] {#assert q.kind!=5;}}
 else if sample==1 || sample==2 {#assert r.count==1 && !r.incomplete && out[0].kind==(ifx sample==1 then BS_PARAMETER else BS_LOCAL) && out[0].root==(ifx sample==1 then 0 else 9);for q:queries[0..<work[0].queries] {if q.decl==8 && q.kind==2 {#assert !q.retain_classes;}}}
 else {#assert r.count==1 && r.incomplete && out[0].kind==BS_LOCAL && out[0].root==9;r=CB_query(b,1,2,BS_Path.{},out[..]);#assert state[0].error_count==1 && errors[0].code=="E0383" && errors[0].loc.line==90 && errors[0].loc.column==5;}
}


// Opacity can only add incompleteness. Its helper scan is unnecessary once
// an independent recursive initializer has already made retained facts incomplete.
#forall "B2 retained opacity skips only already incomplete facts within the same work" incomplete:bool {
 nodes:[96]CK_Node;types:[24]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:[1]CK_State;queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CB2_fixture(c);b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true,retain_classes=true};path:=BS_Path.{count=2};path.steps[0]=BS_Step.{kind=BS_ELEMENT};path.steps[1]=BS_Step.{kind=BS_FIELD};out:[64]BS_Origin;prior:=0;
 if incomplete {nodes[8].a=60;nodes[2].next=70;nodes[60]=CK_Node.{kind=CK_Tag.expr_call,type=18,proc=70,borrow_owner=2};nodes[70]=CK_Node.{kind=CK_Tag.proc,type=18,b=71,borrow_returns=72,borrow_calls=73};nodes[71].kind=CK_Tag.stmt_block;nodes[72]=CK_Node.{kind=CK_Tag.stmt_return,a=73,borrow_owner=70};nodes[73]=CK_Node.{kind=CK_Tag.expr_call,type=18,proc=70,borrow_owner=70};}
 for pass:0..<2 {
  helper:=ifx pass==0 then 0 else 22;if incomplete {nodes[2].borrow_calls=60;nodes[60].borrow_next=helper;}else {nodes[2].borrow_calls=helper;}
  for id:0..<96 {nodes[id].borrow_query=0;}for type:1..<21 {types[type].retain_presence=0;types[type].retain_mutable=0;types[type].retain_fields=0;}work[0]=CB_State.{};
  r:=CB_query(b,2,8,path,out[..]);#assert !state[0].fatal;#assert state[0].error_count==0;#assert r.count==0;#assert r.incomplete==(incomplete || pass==1);
  if pass==0 {prior=work[0].work;}else {#assert ifx incomplete then work[0].work==prior else work[0].work>prior;}
 }
}

#test "R2 Result and optional identities use existing scalar IDs and checked payload layout" {
 nodes:[24]CK_Node;types:[40]CK_Type;locals:[2]CK_Local;errors:[8]CK_Error;bytes:[2048]u8;state:=[1]CK_State.[CK_State.{used=16,type_count=16}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 nodes[2]=CK_Node.{kind=CK_Tag.type_named,name="Result",head=3};nodes[3]=CK_Node.{kind=CK_Tag.type_named,name="int",next=4};nodes[4]=CK_Node.{kind=CK_Tag.type_named,name="u8"};
 a:=CK_resolve(c,2,CK_Access.value);#assert a==16 && types[a].kind==CK_Kind.result && types[a].elem==11 && types[a].sum_error==12;
 #assert types[a].size==16 && types[a].alignment==8 && types[a].sum_payload_offset==8 && types[a].sum_default== -1;
 #assert CK_resolve(c,2,CK_Access.value)==a && state[0].type_count==17 && types[13].name=="u16";
 nodes[5]=CK_Node.{kind=CK_Tag.type_optional,b=6};nodes[6]=CK_Node.{kind=CK_Tag.type_named,name="int"};b:=CK_resolve(c,5,CK_Access.value);
 #assert b==17 && types[b].kind==CK_Kind.optional && types[b].elem==11 && types[b].sum_default==0 && types[b].size==16;
 nodes[3].name="void";u:=CK_resolve(c,2,CK_Access.value);#assert u==18 && types[u].elem==1 && types[u].size==8 && types[u].sum_payload_offset==4 && types[u].sum_default== -1;
 #assert state[0].error_count==0 && !state[0].fatal;
}
