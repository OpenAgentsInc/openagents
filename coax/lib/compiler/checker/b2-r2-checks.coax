#forall "R2 current part67 current field row ownership and replacement endpoint stay authoritative" changed_slot:bool {
 nodes:[24]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=23,type_count=19}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=789,column=9,offset=78909}}];for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.view,elem=13};types[18]=CK_Type.{kind=CK_Kind.struct_,decl=10};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=18,borrow_owner=2,loc=CK_Loc.{line=790,column=7,offset=79007}};nodes[10]=CK_Node.{kind=CK_Tag.struct_,head=11};nodes[11]=CK_Node.{kind=CK_Tag.field,type=16,next=12};nodes[12]=CK_Node.{kind=CK_Tag.field,type=17};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};path:=BS_Path.{count=1};path.steps[0]=BS_Step.{kind=BS_FIELD,index=0};out:[2]BS_Origin;r:=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && r.count==1 && out[0].type==12;row:=types[18].retain_fields-1;if changed_slot {queries[row].path.steps[0].index=12;}else {queries[row].decl=17;}out[0]=BS_Origin.{kind=BS_STATIC,root=901,type=12};out[1]=BS_Origin.{kind=BS_STATIC,root=902,type=12};r=CB_query(b,2,3,path,out[..]);
 #assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==(ifx changed_slot then 790 else 789) && errors[0].loc.column==(ifx changed_slot then 7 else 9) && errors[0].loc.offset==(ifx changed_slot then 79007 else 78909) && state[0].retain_report_count==0 && r.count==0 && out[0].root==901 && out[1].root==902;
}
