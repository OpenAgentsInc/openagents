#forall "return borrow malformed facts and resource limits are hard failures not unknown" mode:0..<13 {
 nodes:[64]CK_Node;types:[20]CK_Type;locals:[4]CK_Local;errors:[4]CK_Error;bytes:[1024]u8;state:=[1]CK_State.[CK_State.{used=20,type_count=18}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;out:[64]BS_Origin;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.struct_};
 nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,head=3,b=10,borrow_returns=4};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};nodes[4]=CK_Node.{kind=CK_Tag.stmt_return,a=5};nodes[5]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[10]=CK_Node.{kind=CK_Tag.stmt_block};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};
 if mode==0 {c.borrow_queries=queries[..];CK_borrow_returns(c);}
 if mode==1 {CB_run(c,queries[0..<127],origins[..]);}
 if mode==2 {CB_run(c,queries[..],origins[0..<1023]);}
 if mode==3 {work[0].work=2097151;#assert CB_tick(b,CK_Loc.{}) && work[0].work==2097152;#assert !CB_tick(b,CK_Loc.{});}
 if mode==4 {work[0].depth=31;z:=CB_expr(b,5,BS_Path.{},false,out[..]);#assert z.count==1 && !z.incomplete && !state[0].fatal && work[0].depth==31;work[0].depth=32;z=CB_expr(b,5,BS_Path.{},false,out[..]);}
 if mode==5 {path:=BS_Path.{count=25};ignored:=CB_type(b,16,path);}
 if mode==6 {nodes[3].borrow_owner=0;ignored:=CB_query(b,2,3,BS_Path.{},out[..]);}
 if mode==7 {nodes[5].kind=CK_Tag.expr_call;ignored:=CB_expr(b,5,BS_Path.{},false,out[..]);}
 if mode==8 {work[0].queries=128;for i:0..<128 {queries[i]=CK_BorrowQuery.{kind=1,decl=2,status=2};}ignored:=CB_query(b,2,3,BS_Path.{},out[..]);}
 if mode==9 {work[0].origins=1024;ignored:=CB_query(b,2,3,BS_Path.{},out[..]);}
 if mode==10 {path:=BS_Path.{count=1};path.steps[0]=BS_Step.{kind=BS_FIELD};ignored:=CB_type(b,17,path);}
 if mode==11 {nodes[5].type=0;ignored:=CB_expr(b,5,BS_Path.{},false,out[..]);}
 if mode==12 {work[0].queries=1;queries[0]=CK_BorrowQuery.{kind=2,decl=3,type=16,status=1};nodes[3].borrow_query=1;r:=CB_query(b,2,3,BS_Path.{},out[..]);#assert r.incomplete && r.count==0 && !state[0].fatal && state[0].error_count==0;}
 else {#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381";}
}

