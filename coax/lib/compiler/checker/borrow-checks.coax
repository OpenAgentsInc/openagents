// #12674/#12676: storing a whole array into a place copies it there, so the
// place's storage stays its own; a stored descriptor is still a value.
#forall "return borrow inline places ignore stores unless a descriptor follows" mode:0..<12 {
 types:[24]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{type_count=20}];nodes:[4]CK_Node;c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c};
 types[16]=CK_Type.{kind=CK_Kind.array,elem=12,length=4};types[17]=CK_Type.{kind=CK_Kind.struct_};types[19]=CK_Type.{kind=CK_Kind.view,elem=12};
 kinds:=[4]u8.[BS_FIELD,BS_ELEMENT,BS_DEREFERENCE,BS_VARIANT];rest:BS_Path;t:=ifx mode<6 then 16 else ifx mode<9 then 19 else 17;
 // 0: no steps; 1: field; 2: element; 3: dereference; 4: field then dereference; 5: variant then element.
 shape:=mode%6;if mode>=6 {shape=(mode-6)%3;}
 if shape==1 {rest.count=1;rest.steps[0]=BS_Step.{kind=kinds[0]};}if shape==2 {rest.count=1;rest.steps[0]=BS_Step.{kind=kinds[1]};}if shape==3 {rest.count=1;rest.steps[0]=BS_Step.{kind=kinds[2]};}
 if shape==4 {rest.count=2;rest.steps[0]=BS_Step.{kind=kinds[0]};rest.steps[1]=BS_Step.{kind=kinds[2]};}if shape==5 {rest.count=2;rest.steps[0]=BS_Step.{kind=kinds[3]};rest.steps[1]=BS_Step.{kind=kinds[1]};}
 #assert CB_inline(b,t,rest)==(t==16 && shape!=3 && shape!=4) && !state[0].fatal && state[0].error_count==0;
}

