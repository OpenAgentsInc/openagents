// GitHub #12611: a returned string chosen from many literals (Everglade's
// spell hints) overflowed the 64-origin set with static origins alone.
#forall "return borrow static origins that overflow a set collapse to one per type and keep the rest" sample:0..<5 {
 nodes:[4]CK_Node;types:[16]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=3,type_count=16}];work:[1]CB_State;c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};
 out:[64]BS_Origin;values:[64]BS_Origin;small:[3]BS_Origin;left:=40;right:=26;for i:0..<64 {out[i]=BS_Origin.{kind=BS_STATIC,root=100+i,type=12};values[i]=BS_Origin.{kind=BS_STATIC,root=200+i,type=ifx sample==4 && i<25 then 11 else 12};}values[25]=BS_Origin.{kind=BS_PARAMETER,role=BS_DESCRIPTOR,type=12};
 if sample==1 || sample==2 {left=2;right=ifx sample==1 then 2 else 1;for i:0..<2 {small[i]=out[i];}}
 if sample==3 {for i:0..<64 {out[i].kind=BS_LOCAL;values[i].kind=BS_LOCAL;}right=25;}
 r:CB_Result;if sample==1 || sample==2 {r=CB_merge(b,small[..],CB_Result.{count=left},values[..],CB_Result.{count=right});}else {r=CB_merge(b,out[..],CB_Result.{count=left},values[..],CB_Result.{count=right});}
 if sample==3 {#assert state[0].fatal && errors[0].code=="E0381" && r.count==0;}
 else if sample==1 {#assert !state[0].fatal && r.count==1 && small[0].kind==BS_STATIC && small[0].root==1 && small[0].type==12;}
 else if sample==2 {#assert !state[0].fatal && r.count==3 && small[0].root==100 && small[1].root==101 && small[2].root==200;}
