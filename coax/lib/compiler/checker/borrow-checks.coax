 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=17,head=3,b=125,borrow_returns=124,loc=CK_Loc.{line=72,column=5,offset=725}};nodes[3]=CK_Node.{kind=CK_Tag.param,type=17,borrow_owner=2};nodes[123]=CK_Node.{kind=CK_Tag.expr_ident,type=17,borrow_binding=3};nodes[124]=CK_Node.{kind=CK_Tag.stmt_return,a=123};nodes[125]=CK_Node.{kind=CK_Tag.stmt_block,head=124};
