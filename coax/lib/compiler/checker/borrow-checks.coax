#forall "borrow discovery refuses poisoned invalid field facts both entering and resuming" resume:bool,variant:0..<3 {
 nodes:[8]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=4,type_count=20}];work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=57,column=7,offset=575}}];c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.struct_,decl=3};nodes[3]=CK_Node.{kind=CK_Tag.struct_};
 // Poison spare storage with a real borrowed field so a missing logical-bound/kind guard cannot hide behind a later invalid type.
 bad:=ifx variant==0 then 1 else ifx variant==1 then 5 else 4;nodes[bad]=CK_Node.{kind=ifx variant==2 then CK_Tag.expr_ident else CK_Tag.field,type=3};
 if resume {nodes[3].head=2;nodes[2]=CK_Node.{kind=CK_Tag.field,type=12,next=bad};}else {nodes[3].head=bad;}
 #assert !CB_has_borrow(b,16,0) && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381";
 #assert errors[0].loc.line==57 && errors[0].loc.column==7 && errors[0].loc.offset==575;
}

