// Checks: query memos and return borrows. A part of the checker:
// lib/compiler/checker.coax loads it (#12646).
#authority;
#test "query memo reuse works at admitted capacity without new allocation" {
 nodes:[128]CK_Node;types:[20]CK_Type;locals:[128]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:=[1]CK_State.[CK_State.{used=127,type_count=20}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=99,column=7,offset=999}}];out:[64]BS_Origin;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.struct_,decl=40};types[18]=CK_Type.{kind=CK_Kind.view,elem=13};types[19]=CK_Type.{kind=CK_Kind.array,elem=12,length=4};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,head=3,b=50,borrow_returns=5,loc=CK_Loc.{line=1,column=1,offset=1}};
 nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,next=4,borrow_owner=2,loc=CK_Loc.{line=5,column=3,offset=50}};nodes[4]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};
 nodes[5]=CK_Node.{kind=CK_Tag.stmt_return,a=6};nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[50]=CK_Node.{kind=CK_Tag.stmt_block,head=5};
 nodes[40]=CK_Node.{kind=CK_Tag.struct_,head=41};nodes[41]=CK_Node.{kind=CK_Tag.field,type=16,next=42};nodes[42]=CK_Node.{kind=CK_Tag.field,type=16};
 b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};
 // A procedure with64 caller view parameters: value and inline-storage facts are128 distinct semantic queries.
 nodes[2].borrow_returns=98;nodes[2].b=99;nodes[97]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[98]=CK_Node.{kind=CK_Tag.stmt_return,a=97};nodes[99]=CK_Node.{kind=CK_Tag.stmt_block,head=98};
 for i:0..<64 {at:=i+3;next:=at+1;if i==63 {next=0;}nodes[at]=CK_Node.{kind=CK_Tag.param,name=CK_join2(c,"arg",CK_count(c,i)),type=16,next=next,borrow_owner=2};}
 for i:0..<64 {
  value:=CB_query(b,2,i+3,BS_Path.{},out[..]);#assert value.count==1 && !value.incomplete && !state[0].fatal;
  #assert out[0].kind==BS_PARAMETER && out[0].root==i && out[0].role==BS_DESCRIPTOR && out[0].type==12 && out[0].path.count==0;
  storage:=CB_query(b,3,i+3,BS_Path.{},out[..]);#assert storage.count==1 && !storage.incomplete && !state[0].fatal;
  #assert out[0].kind==BS_LOCAL && out[0].root==i+3 && out[0].type==12 && out[0].path.count==0;
 }
 again:=CB_query(b,2,3,BS_Path.{},out[..]);#assert again.count==1 && !again.incomplete && !state[0].fatal && state[0].error_count==0;
 #assert out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].role==BS_DESCRIPTOR && out[0].type==12 && out[0].path.count==0;
 // The new procedure-return key needs an additional slot; it must refuse, rather than alias an existing value/storage entry.
 refused:=CB_query(b,1,2,BS_Path.{},out[..]);#assert refused.count==0 && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381";
 #assert errors[0].loc.line==1 && errors[0].loc.column==1 && errors[0].loc.offset==1;
}

#test "query memo separates declarations and procedure return origins" {
 nodes:[128]CK_Node;types:[20]CK_Type;locals:[128]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:=[1]CK_State.[CK_State.{used=127,type_count=20}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=99,column=7,offset=999}}];out:[64]BS_Origin;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.struct_,decl=40};types[18]=CK_Type.{kind=CK_Kind.view,elem=13};types[19]=CK_Type.{kind=CK_Kind.array,elem=12,length=4};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,head=3,b=50,borrow_returns=5,loc=CK_Loc.{line=1,column=1,offset=1}};
 nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,next=4,borrow_owner=2,loc=CK_Loc.{line=5,column=3,offset=50}};nodes[4]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};
 nodes[5]=CK_Node.{kind=CK_Tag.stmt_return,a=6};nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[50]=CK_Node.{kind=CK_Tag.stmt_block,head=5};
 nodes[40]=CK_Node.{kind=CK_Tag.struct_,head=41};nodes[41]=CK_Node.{kind=CK_Tag.field,type=16,next=42};nodes[42]=CK_Node.{kind=CK_Tag.field,type=16};
 b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};
 nodes[10]=CK_Node.{kind=CK_Tag.proc,type=16,head=11,b=51,borrow_returns=14};nodes[11]=CK_Node.{kind=CK_Tag.param,type=16,next=12,borrow_owner=10};nodes[12]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=10};
 nodes[14]=CK_Node.{kind=CK_Tag.stmt_return,a=15};nodes[15]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=12};nodes[51]=CK_Node.{kind=CK_Tag.stmt_block,head=14};
 first:=CB_query(b,2,3,BS_Path.{},out[..]);#assert first.count==1 && !first.incomplete && out[0].kind==BS_PARAMETER && out[0].root==0;
 second:=CB_query(b,2,4,BS_Path.{},out[..]);#assert second.count==1 && !second.incomplete && out[0].kind==BS_PARAMETER && out[0].root==1;
 a:=CB_query(b,1,2,BS_Path.{},out[..]);#assert a.count==1 && !a.incomplete && out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].type==12;
 z:=CB_query(b,1,10,BS_Path.{},out[..]);#assert z.count==1 && !z.incomplete && out[0].kind==BS_PARAMETER && out[0].root==1 && out[0].type==12;
 reread:=CB_query(b,1,2,BS_Path.{},out[..]);#assert reread.count==1 && !reread.incomplete && out[0].root==0 && !state[0].fatal && state[0].error_count==0;
 reread=CB_query(b,2,3,BS_Path.{},out[..]);#assert reread.count==1 && !reread.incomplete && out[0].root==0 && out[0].role==BS_DESCRIPTOR && out[0].path.count==0;
}

#test "query memo keeps distinct record projection paths independent" {
 nodes:[128]CK_Node;types:[20]CK_Type;locals:[128]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:=[1]CK_State.[CK_State.{used=127,type_count=20}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=99,column=7,offset=999}}];out:[64]BS_Origin;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.struct_,decl=40};types[18]=CK_Type.{kind=CK_Kind.view,elem=13};types[19]=CK_Type.{kind=CK_Kind.array,elem=12,length=4};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,head=3,b=50,borrow_returns=5,loc=CK_Loc.{line=1,column=1,offset=1}};
 nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,next=4,borrow_owner=2,loc=CK_Loc.{line=5,column=3,offset=50}};nodes[4]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};
 nodes[5]=CK_Node.{kind=CK_Tag.stmt_return,a=6};nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[50]=CK_Node.{kind=CK_Tag.stmt_block,head=5};
 nodes[40]=CK_Node.{kind=CK_Tag.struct_,head=41};nodes[41]=CK_Node.{kind=CK_Tag.field,type=16,next=42};nodes[42]=CK_Node.{kind=CK_Tag.field,type=16};
 b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};
 nodes[3].type=17;nodes[3].next=0;
 left:=BS_Path.{count=1};left.steps[0]=BS_Step.{kind=BS_FIELD,index=0};right:=BS_Path.{count=1};right.steps[0]=BS_Step.{kind=BS_FIELD,index=1};
 r:=CB_query(b,2,3,right,out[..]);#assert r.count==1 && !r.incomplete && out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].role==BS_DESCRIPTOR && out[0].type==12;
 #assert out[0].path.count==1 && out[0].path.steps[0].kind==BS_FIELD && out[0].path.steps[0].index==1;
 r=CB_query(b,2,3,left,out[..]);#assert r.count==1 && !r.incomplete && out[0].path.count==1 && out[0].path.steps[0].kind==BS_FIELD && out[0].path.steps[0].index==0;
 r=CB_query(b,2,3,right,out[..]);#assert r.count==1 && !r.incomplete && out[0].path.count==1 && out[0].path.steps[0].index==1 && !state[0].fatal && state[0].error_count==0;
}

#test "query memo distinguishes caller pointee from callee inline descriptor storage" {
 nodes:[128]CK_Node;types:[20]CK_Type;locals:[128]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:=[1]CK_State.[CK_State.{used=127,type_count=20}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=99,column=7,offset=999}}];out:[64]BS_Origin;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.struct_,decl=40};types[18]=CK_Type.{kind=CK_Kind.view,elem=13};types[19]=CK_Type.{kind=CK_Kind.array,elem=12,length=4};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,head=3,b=50,borrow_returns=5,loc=CK_Loc.{line=1,column=1,offset=1}};
 nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,next=4,borrow_owner=2,loc=CK_Loc.{line=5,column=3,offset=50}};nodes[4]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};
 nodes[5]=CK_Node.{kind=CK_Tag.stmt_return,a=6};nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[50]=CK_Node.{kind=CK_Tag.stmt_block,head=5};
 nodes[40]=CK_Node.{kind=CK_Tag.struct_,head=41};nodes[41]=CK_Node.{kind=CK_Tag.field,type=16,next=42};nodes[42]=CK_Node.{kind=CK_Tag.field,type=16};
 b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};
 value:=CB_query(b,2,3,BS_Path.{},out[..]);#assert value.count==1 && !value.incomplete;
 #assert out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].role==BS_DESCRIPTOR && out[0].type==12;
 storage_fact:=CB_query(b,3,3,BS_Path.{},out[..]);#assert storage_fact.count==1 && !storage_fact.incomplete;
 #assert out[0].kind==BS_LOCAL && out[0].root==3 && out[0].type==12;
 value=CB_query(b,2,3,BS_Path.{},out[..]);#assert value.count==1 && !value.incomplete && out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].role==BS_DESCRIPTOR && out[0].type==12 && !state[0].fatal;
 storage_fact=CB_query(b,3,3,BS_Path.{},out[..]);#assert storage_fact.count==1 && !storage_fact.incomplete && out[0].kind==BS_LOCAL && out[0].root==3 && state[0].error_count==0;
}

#forall "query memo refuses changed or invalid typed facts before reuse" invalid:bool {
 nodes:[128]CK_Node;types:[20]CK_Type;locals:[128]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:=[1]CK_State.[CK_State.{used=127,type_count=20}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=99,column=7,offset=999}}];out:[64]BS_Origin;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.struct_,decl=40};types[18]=CK_Type.{kind=CK_Kind.view,elem=13};types[19]=CK_Type.{kind=CK_Kind.array,elem=12,length=4};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,head=3,b=50,borrow_returns=5,loc=CK_Loc.{line=1,column=1,offset=1}};
 nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,next=4,borrow_owner=2,loc=CK_Loc.{line=5,column=3,offset=50}};nodes[4]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};
 nodes[5]=CK_Node.{kind=CK_Tag.stmt_return,a=6};nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[50]=CK_Node.{kind=CK_Tag.stmt_block,head=5};
 nodes[40]=CK_Node.{kind=CK_Tag.struct_,head=41};nodes[41]=CK_Node.{kind=CK_Tag.field,type=16,next=42};nodes[42]=CK_Node.{kind=CK_Tag.field,type=16};
 b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};
 r:=CB_query(b,2,3,BS_Path.{},out[..]);#assert r.count==1 && !r.incomplete && !state[0].fatal;
 // Deliberately malformed mutable typed-input control, not a supported graph mutation API.
 if invalid {nodes[3].type=0;}else {nodes[3].type=18;}
 r=CB_query(b,2,3,BS_Path.{},out[..]);#assert r.count==0 && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381";
 if invalid {#assert errors[0].loc.line==99 && errors[0].loc.column==7 && errors[0].loc.offset==999;}
 else {#assert errors[0].loc.line==5 && errors[0].loc.column==3 && errors[0].loc.offset==50;}
}

#test "query memo preserves explicit recursive incompleteness on repeated reads" {
 nodes:[128]CK_Node;types:[20]CK_Type;locals:[128]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:=[1]CK_State.[CK_State.{used=127,type_count=20}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=99,column=7,offset=999}}];out:[64]BS_Origin;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.struct_,decl=40};types[18]=CK_Type.{kind=CK_Kind.view,elem=13};types[19]=CK_Type.{kind=CK_Kind.array,elem=12,length=4};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,head=3,b=50,borrow_returns=5,loc=CK_Loc.{line=1,column=1,offset=1}};
 nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,next=4,borrow_owner=2,loc=CK_Loc.{line=5,column=3,offset=50}};nodes[4]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};
 nodes[5]=CK_Node.{kind=CK_Tag.stmt_return,a=6};nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[50]=CK_Node.{kind=CK_Tag.stmt_block,head=5};
 nodes[40]=CK_Node.{kind=CK_Tag.struct_,head=41};nodes[41]=CK_Node.{kind=CK_Tag.field,type=16,next=42};nodes[42]=CK_Node.{kind=CK_Tag.field,type=16};
 b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};
 nodes[3].next=0;nodes[6]=CK_Node.{kind=CK_Tag.expr_call,type=16,proc=2,head=7};nodes[7]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};
 r:=CB_query(b,1,2,BS_Path.{},out[..]);#assert r.count==0 && r.incomplete && !state[0].fatal && state[0].error_count==0;
