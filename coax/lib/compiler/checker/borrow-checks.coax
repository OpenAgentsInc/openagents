 nodes[7]=CK_Node.{kind=CK_Tag.expr_call,type=16,proc=2,head=10};nodes[8]=CK_Node.{kind=CK_Tag.expr_ident,type=19,borrow_binding=9};nodes[9]=CK_Node.{kind=CK_Tag.stmt_var,type=19,borrow_owner=2};nodes[10]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[11]=CK_Node.{kind=CK_Tag.expr_bool,type=2};
