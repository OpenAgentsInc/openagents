#forall "return borrow missing indexed returns and short cached outputs are resource failures" sample:0..<5 {
 nodes:[40]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=31,type_count=17}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;memo:[1]CB_State;c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=memo[..]};types[16]=CK_Type.{kind=CK_Kind.view,elem=12};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,head=3,b=7,borrow_returns=31,loc=CK_Loc.{line=5,column=2}};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};nodes[7].kind=CK_Tag.stmt_block;nodes[31]=CK_Node.{kind=CK_Tag.stmt_return,a=8};nodes[8]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3,loc=CK_Loc.{line=9,column=10}};out:[64]BS_Origin;
 if sample==0 {nodes[2].borrow_returns=0;}if sample==1 {nodes[31].kind=CK_Tag.stmt_var;}if sample==2 {nodes[2].borrow_returns=32;}
 if sample==3 {first:=CB_query(b,1,2,BS_Path.{},out[..]);#assert !state[0].fatal && first.count==1 && !first.incomplete;second:=CB_query(b,1,2,BS_Path.{},out[0..<0]);#assert second.count==0 && !second.incomplete;}
 else {r:=CB_query(b,1,2,BS_Path.{},ifx sample==4 then out[0..<0] else out[..]);#assert r.count==0 && !r.incomplete;}
 #assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381";#assert errors[0].loc.line==5 && errors[0].loc.column==2;
}

