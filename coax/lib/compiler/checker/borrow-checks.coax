 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.struct_,decl=40};types[18]=CK_Type.{kind=CK_Kind.view,elem=13};types[19]=CK_Type.{kind=CK_Kind.array,elem=12,length=4};
