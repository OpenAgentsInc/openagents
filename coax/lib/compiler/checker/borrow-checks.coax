 copy:=CK_clone(c,2);#assert copy==5 && nodes[copy].borrow_binding==0 && nodes[copy].borrow_owner==0 && nodes[copy].borrow_writes==0 && nodes[copy].borrow_returns==0 && nodes[copy].borrow_calls==0 && nodes[copy].borrow_next==0 && nodes[copy].borrow_status==0;
}

