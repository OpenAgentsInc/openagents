CB_has_borrow :: (b:CB_Context,t:int,depth:int)->bool {if b.retain_fields && depth==0 {return CR_presence(b,t);}return CB_discover(b,t,depth,false);}
CB_mutable_descriptors :: (b:CB_Context,t:int,depth:int)->bool {if b.retain_fields && depth==0 {return CR_mutable(b,t);}return CB_discover(b,t,depth,true);}
// Substitute a selected source fact, never every argument a helper reads.
CB_call_values :: (b:CB_Context,call:int,summary:[]BS_Origin,s:CB_Result,out:[]BS_Origin)->CB_Result {
