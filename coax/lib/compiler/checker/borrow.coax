 hinted:=link!=0 && b.state[0].field_type==type && b.state[0].field_block==block && b.state[0].field_head==link;
 if hinted {link=b.state[0].field_row;if link==0 {CK_resource(b.c,b.state[0].loc);return 0;}}
 while link!=0 {
