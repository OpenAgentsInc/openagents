CB_Result :: struct {count:int;incomplete:bool;}
CB_State :: struct {literal_current:CB_LiteralBlock;literal_previous:CB_LiteralBlock;queries:int;origins:int;work:int;depth:int;loc:CK_Loc;field_type:int;field_block:int;field_head:int;field_row:int;projections:[2]CB_QueryProjection;projection_next:bool;}
