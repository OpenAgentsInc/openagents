    failure:=ifx b.c.types[n.type].kind==CK_Kind.result then 1 else 0;witness=edge.loc;
    if path.steps[0].index==failure && failure==1 {z=CB_expr(b,edge.a,CB_prepend(b,CB_tail(path),BS_VARIANT,1),place,temp[..]);}
   }else {CK_resource(b.c,n.loc);return CB_Result.{};}
   for i:0..<z.count {if temp[i].kind==BS_LOCAL && b.c.state[0].error_count==0 {CK_error(b.c,witness,"E0383","returned borrow may refer to local inline storage through a helper or aggregate","return owned storage, or keep the borrowed backing in the caller");break;}}
   r=CB_merge(b,out,r,temp[..],z);ret=edge.borrow_next;
  }
 }else {
  owner:=n.borrow_owner;if owner<2 || owner>b.c.state[0].used || (b.c.nodes[owner].kind!=CK_Tag.proc && b.c.nodes[owner].kind!=CK_Tag.check) {CK_resource(b.c,n.loc);return CB_Result.{};}
  t:=expected_type;
  if kind==3 && !indirect {r=CB_put(b,out,r,BS_Origin.{kind=BS_LOCAL,root=decl,type=CB_key(b,t,true),path=path});}
  else if kind==5 {if n.kind!=CK_Tag.param || !indirect {CK_resource(b.c,n.loc);return CB_Result.{};}}
  else if n.kind==CK_Tag.param {
   at:=b.c.nodes[owner].head;ordinal:=0;while at!=decl {if at<2 || at>b.c.state[0].used || !CB_tick(b,n.loc) {CK_resource(b.c,n.loc);return CB_Result.{};}at=b.c.nodes[at].next;ordinal+=1;}
   r=CB_put(b,out,r,BS_Origin.{kind=BS_PARAMETER,root=ordinal,role=BS_DESCRIPTOR,type=CB_key(b,t,kind==3),path=path});
  }else if n.kind==CK_Tag.case_binding {r=CB_expr(b,n.a,CB_prepend(b,path,BS_VARIANT,n.sum_variant),kind==3,out);}
  else if n.kind==CK_Tag.stmt_var {if n.a!=0 {r=CB_expr(b,n.a,path,kind==3,out);}else {r=CB_default(b,n.type,path,out);}}
  else if n.kind==CK_Tag.stmt_each {collection:=b.c.types[b.c.nodes[n.a].type];r=CB_expr(b,n.a,CB_prepend(b,path,ifx collection.kind==CK_Kind.array then BS_ELEMENT else BS_DEREFERENCE,ifx collection.kind==CK_Kind.array then 2147483647 else 0),false,out);}
  else {CK_resource(b.c,n.loc);return CB_Result.{};}
  if !(kind==3 && !indirect) {write:=n.borrow_writes;temp:[64]BS_Origin;
  while write!=0 {p:=CB_place(b,b.c.nodes[write].c);if p.decl!=decl {CK_resource(b.c,n.loc);return CB_Result.{};}if CB_prefix(p.path,path) {rest:BS_Path;for i:p.path.count..<path.count {rest=CB_add_path(b,rest,path.steps[i].kind,path.steps[i].index);}if !CB_inline(b,expected_type,rest) {z:=CB_expr(b,b.c.nodes[write].a,rest,kind==3,temp[..]);if kind==5 {CB_external_local(b,b.c.nodes[write].a,temp[..],z);}r=CB_merge(b,out,r,temp[..],z);}}write=b.c.nodes[write].borrow_next;}
  r=CB_alias_writes_mode(b,decl,path,out,r,kind==5);
  // Raw return queries compose selected helper writes. Retained-store-only
  // misses keep B1's manual boundary; a complete raw memo above is reusable.
  // This never certifies unknown effects or expands the shared work budget.
  if b.retain_fields {r.incomplete=r.incomplete || CB_opaque(b,decl,path);}
  else {r=CB_call_writes(b,decl,path,out,r);}}
 }
 if b.c.state[0].fatal {return CB_Result.{};}if r.count>b.origins.count-b.state[0].origins {CK_resource(b.c,n.loc);return CB_Result.{};}
 start:=b.state[0].origins;for i:0..<r.count {b.origins[start+i]=out[i];}b.state[0].origins+=r.count;b.queries[slot].start=start;b.queries[slot].count=r.count;b.queries[slot].status=ifx r.incomplete then cast(u8)3 else cast(u8)2;CB_projection_commit(b,projection[0],slot+1);return r;
}
// The leaves of a type holding a borrow when every element is its own: 128
// stands for more than 64. Stops once over, so a wide or deep type costs at
// most the budget per level.
CB_leaf_count :: (b:CB_Context,type:int)->int {
 if type<1 || type>=b.c.state[0].type_count {CK_resource(b.c,b.state[0].loc);return 0;}r:=b.c.types[type];
 if (type==3 && r.kind==CK_Kind.string_) || r.kind==CK_Kind.view {return 1;}n:=0;
 if r.kind==CK_Kind.array {n=r.length*CB_leaf_count(b,r.elem);}
 else if CK_sum(b.c,type) {
  // Count every possible payload, not only a constructor's active variant.
  // Unit/owned payloads contribute zero; the existing overflow sentinel stays128.
  count:=CK_sum_count(b.c,type);variant:=0;while variant<count && n<=64 {payload:=CB_variant(b,type,variant);if payload==0 {return 0;}if CB_has_borrow(b,payload,0) {n+=CB_leaf_count(b,payload);}variant+=1;}
 }
 else if r.kind==CK_Kind.struct_ {field:=CB_fields(b,type);while field!=0 && n<=64 {if b.c.state[0].fatal || (b.retain_fields && !CB_tick(b,b.state[0].loc)) {return 128;}if field<2 || field>b.c.state[0].used || b.c.nodes[field].kind!=CK_Tag.field {CK_resource(b.c,b.state[0].loc);return 128;}if CB_has_borrow(b,b.c.nodes[field].type,0) {n+=CB_leaf_count(b,b.c.nodes[field].type);}field=b.c.nodes[field].next;}}
 else if r.kind==CK_Kind.void_ || r.kind==CK_Kind.integer || r.kind==CK_Kind.floating || r.kind==CK_Kind.bool_ || r.kind==CK_Kind.untyped_int || r.kind==CK_Kind.untyped_float || r.kind==CK_Kind.enum_ {return 0;}
 else {CK_resource(b.c,b.state[0].loc);return 0;}
 return ifx n>64 then 128 else n;
}
CB_leaves :: (b:CB_Context,proc:int,type:int,path:BS_Path,leaves:[]int)->bool {
 if !CB_tick(b,b.c.nodes[proc].loc) {return false;}if type<1 || type>=b.c.state[0].type_count {CK_resource(b.c,b.c.nodes[proc].loc);return false;}r:=b.c.types[type];
 if type==3 || r.kind==CK_Kind.view {leaves[0]+=1;if leaves[0]>64 {CK_resource(b.c,b.c.nodes[proc].loc);return false;}out:[64]BS_Origin;z:=CB_query(b,1,proc,path,out[..]);return !z.incomplete;}
 complete:=true;if CK_sum(b.c,type) {for variant:0..<CK_sum_count(b.c,type) {payload:=CB_variant(b,type,variant);if payload==0 {return false;}if CB_has_borrow(b,payload,0) {known:=CB_leaves(b,proc,payload,CB_add_path(b,path,BS_VARIANT,variant),leaves);complete=complete && known;}if b.c.state[0].fatal || b.c.state[0].error_count>0 {return false;}}return complete;}if r.kind==CK_Kind.struct_ {field:=CB_fields(b,type);at:=0;while field!=0 {if CB_has_borrow(b,b.c.nodes[field].type,0) {known:=CB_leaves(b,proc,b.c.nodes[field].type,CB_add_path(b,path,BS_FIELD,at),leaves);complete=complete && known;}field=b.c.nodes[field].next;at+=1;}}
 // An array whose elements would not all fit the 64-leaf budget is one leaf
 // set: the unknown element (a slice's index), whose origins are every
 // element's. A wide array of strings in a result is checked, not refused.
 if r.kind==CK_Kind.array && CB_has_borrow(b,r.elem,0) {if leaves[0]+r.length*CB_leaf_count(b,r.elem)>64 {return CB_leaves(b,proc,r.elem,CB_add_path(b,path,BS_ELEMENT,2147483647),leaves);}for i:0..<r.length {known:=CB_leaves(b,proc,r.elem,CB_add_path(b,path,BS_ELEMENT,i),leaves);complete=complete && known;}}return complete;
}
CB_walk :: (b:CB_Context,head:int,instances:bool) {
 c:=b.c;id:=head;
 while id!=0 {if id<2 || id>c.state[0].used {CK_resource(c,CK_Loc.{line=1,column=1});return;}n:=c.nodes[id];b.state[0].loc=n.loc;if !CB_tick(b,n.loc) {return;}
  if n.kind==CK_Tag.proc && !n.generic && !n.flag2 {if CB_has_borrow(b,n.type,0) {leaves:[1]int;known:=CB_leaves(b,id,n.type,BS_Path.{},leaves[..]);c.nodes[id].borrow_status=ifx known then cast(u8)1 else cast(u8)2;}}
  if c.state[0].fatal || c.state[0].error_count>0 {return;}id=ifx instances then n.chain else n.next;
 }
}
CB_workspace_admitted :: (query_count:int,origin_count:int)->bool {return query_count>=128 && query_count<=16384 && origin_count>=1024 && origin_count<=65536;}
CB_reset_heads :: (b:CB_Context)->bool {
 c:=b.c;if c.state[0].used<1 || c.state[0].used>=c.nodes.count {CK_resource(c,CK_Loc.{line=1,column=1});return false;}
 // Only declarations can own memo chains; expression scanning spends no query work.
 // All concrete cloning is over, and these heads live for this invocation only.
 for id:2..<c.state[0].used+1 {tag:=c.nodes[id].kind;if tag==CK_Tag.proc || tag==CK_Tag.param || tag==CK_Tag.stmt_var || tag==CK_Tag.stmt_each || tag==CK_Tag.case_binding {if !CB_tick(b,c.nodes[id].loc) {return false;}c.nodes[id].borrow_query=0;}}
 return true;
}
CB_run :: (c:CK_Context,queries:[]CK_BorrowQuery,origins:[]BS_Origin) {
 if !CB_workspace_admitted(queries.count,origins.count) {CK_resource(c,CK_Loc.{line=1,column=1});return;}state:[1]CB_State;b:=CB_Context.{c=c,queries=queries,origins=origins,state=state[..]};
 if !CB_reset_heads(b) {return;}
 CB_walk(b,c.nodes[1].head,false);if c.state[0].fatal || c.state[0].error_count>0 {return;}CB_walk(b,c.state[0].instances,true);if c.state[0].fatal || c.state[0].error_count>0 {return;}b.literal_cache=true;b.query_index=CB_index_begin(b);CR_run(b);
}
CK_borrow_returns :: (c:CK_Context) {
 if c.borrow_queries.count==0 && c.borrow_origins.count==0 {queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;CB_run(c,queries[..],origins[..]);}
 else {CB_run(c,c.borrow_queries,c.borrow_origins);}
}
// These indexes are recorded by existing typed binding/traversal only.
CK_declare_id :: (c:CK_Context,name:string,ty:int,loc:CK_Loc,immutable:string,decl:int) {before:=c.state[0].local_count;CK_declare(c,name,ty,loc,immutable);if c.state[0].local_count==before+1 {c.locals[before].decl=decl;c.nodes[decl].borrow_owner=c.state[0].current;}}
CK_borrow_root :: (c:CK_Context,id:int)->int {if id<2 {return 0;}e:=c.nodes[id];if e.kind==CK_Tag.expr_ident {return e.borrow_binding;}if e.kind==CK_Tag.expr_field || e.kind==CK_Tag.expr_index || e.kind==CK_Tag.expr_slice || e.kind==CK_Tag.expr_cast {return CK_borrow_root(c,e.a);}return 0;}
CK_borrow_call :: (c:CK_Context,id:int) {owner:=c.state[0].current;if owner<2 || c.nodes[id].borrow_owner!=0 || c.nodes[id].kind!=CK_Tag.expr_call {return;}c.nodes[id].borrow_owner=owner;c.nodes[id].borrow_next=c.nodes[owner].borrow_calls;c.nodes[owner].borrow_calls=id;}
CK_borrow_write :: (c:CK_Context,id:int) {if c.nodes[id].borrow_owner!=0 {return;}owner:=c.state[0].current;if owner<2 {return;}c.nodes[id].borrow_owner=owner;c.nodes[id].borrow_writes=c.nodes[owner].borrow_writes;c.nodes[owner].borrow_writes=id;decl:=CK_borrow_root(c,c.nodes[id].c);if decl!=0 {c.nodes[id].borrow_next=c.nodes[decl].borrow_writes;c.nodes[decl].borrow_writes=id;}}
CK_borrow_return :: (c:CK_Context,id:int) {if c.nodes[id].borrow_owner!=0 {return;}owner:=c.state[0].current;if owner<2 {return;}c.nodes[id].borrow_owner=owner;c.nodes[id].borrow_next=c.nodes[owner].borrow_returns;c.nodes[owner].borrow_returns=id;}



