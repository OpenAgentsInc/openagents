 }else {if field<2 || field>b.c.state[0].used {CK_resource(b.c,b.state[0].loc);return 0;}}
 f:=b.c.nodes[field];if f.kind!=CK_Tag.field || f.type<=CK_NONE || f.type>=b.c.state[0].type_count {CK_resource(b.c,b.state[0].loc);return 0;}
