CB_Place :: struct {decl:int;path:BS_Path;}
CK_borrow_caps :: (nodes:int)->CK_BorrowCaps #export_c {
 if nodes<1 || nodes>2147483646 {return CK_BorrowCaps.{};}
 delta:=nodes-128;queries:=128+(delta & ((delta>>63)^ -1));delta=16384-queries;queries=16384-(delta & ((delta>>63)^ -1));
 delta=nodes*4-1024;origins:=1024+(delta & ((delta>>63)^ -1));delta=65536-origins;origins=65536-(delta & ((delta>>63)^ -1));
 return CK_BorrowCaps.{queries=queries,origins=origins,work=2097152};
}
