   else {field:=CB_fields(b,t);if field!=0 {if field<2 || field>b.c.state[0].used || b.c.nodes[field].kind!=CK_Tag.field {CK_resource(b.c,b.state[0].loc);return false;}fields[used]=b.c.nodes[field].next;depths[used]=depth;used+=1;t=b.c.nodes[field].type;depth+=1;continue;}}
