  if q.kind!=4 || q.decl!=type || q.type!=b.c.types[type].decl || q.status!=2 || q.count!=head || q.retain_classes || q.start<0 || q.path.count!=0 || q.next<0 || q.next>=link {CK_resource(b.c,b.state[0].loc);return 0;}
