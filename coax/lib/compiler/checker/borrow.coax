 head:=CB_fields(b,type);if head<2 || head>b.c.state[0].used || b.c.nodes[head].kind!=CK_Tag.field {CK_resource(b.c,b.state[0].loc);return 0;}link:=b.c.types[type].retain_fields;block:=index/8;offset:=index%8;row:=0;field:=0;
