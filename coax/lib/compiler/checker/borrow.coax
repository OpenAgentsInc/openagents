// Static data lives as long as the program, so no static origin decides a
// returned borrow. When a set overflows, one static origin per type stands for
// them all: a table of strings, or every arm of a long chain of returns.
CB_static :: (o:BS_Origin)->BS_Origin {r:=o;if o.kind==BS_STATIC {r.root=1;}return r;}
CB_merge :: (b:CB_Context,out:[]BS_Origin,a:CB_Result,values:[]BS_Origin,z:CB_Result)->CB_Result {
 temp:[64]BS_Origin;r:=BS_union(out[0..<a.count],true,values[0..<z.count],true,temp[..]);
 if r.status==BS_Status.capacity || r.count>out.count {left:[64]BS_Origin;right:[64]BS_Origin;for i:0..<a.count {left[i]=CB_static(out[i]);}for i:0..<z.count {right[i]=CB_static(values[i]);}r=BS_union(left[0..<a.count],true,right[0..<z.count],true,temp[..]);}
 if r.status!=BS_Status.ok || r.count>out.count {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}
