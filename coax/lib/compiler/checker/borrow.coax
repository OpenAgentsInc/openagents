  for i:0..<s.count {
   origin:=summary[i];if origin.kind!=BS_PARAMETER {r=CB_put(b,out,r,origin);continue;}
   actual:=CB_at(b,e.head,origin.root);if actual<2 {return CB_Result.{};}
