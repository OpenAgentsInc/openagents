CB_prepend :: (b:CB_Context,path:BS_Path,kind:u8,index:int)->BS_Path {r:BS_Path;r=CB_add_path(b,r,kind,index);for i:0..<path.count {r=CB_add_path(b,r,path.steps[i].kind,path.steps[i].index);}return r;}
