}
#test "metadata table budgets include one array node and the null spare" {
 #assert !CK_meta_table_fits(0,2,true);
 #assert !CK_meta_table_fits(31,2,true) && CK_meta_table_fits(32,2,true) && CK_meta_table_fits(33,2,true);
 #assert !CK_meta_table_fits(27,2,false) && CK_meta_table_fits(28,2,false) && CK_meta_table_fits(29,2,false);
}
CK_meta_table_fits :: (remaining:int,count:int,fields:bool)->bool {
 width:=13;if fields {width=15;}return count<=(remaining-2)/width;
}
CK_meta_publish :: (c:CK_Context,id:int,result:int)->int {
 if c.state[0].fatal {return CK_NONE;}
 next:=c.nodes[id].next;c.nodes[id]=c.nodes[result];c.nodes[id].next=next;return c.nodes[id].type;
}
#forall "synthetic reflection provenance is distinct from authored expressions" mark:0..<4 {
 #assert CK_generated(mark)==(mark==1);
}
CK_generated :: (mark:int)->bool #export_c {return mark==1;}
CK_meta_capacity :: (nodes:[] CK_Node,used:int)->int #export_c {
 for i:1..<used+1 {n:=nodes[i];if n.kind==CK_Tag.expr_call && n.d!=0 && (n.name=="type_info" || n.name=="field_info" || n.name=="enum_info") {return 65536;}}
 return 0;
}
CK_meta_record :: (c:CK_Context,t:int,values:[] CK_MetaValue,loc:CK_Loc)->int {
 CK_layout(c,c.types[t].decl);
 id:=CK_new(c,CK_Tag.expr_struct,loc);c.nodes[id].type=t;c.nodes[id].mark=1;
 field:=c.nodes[c.types[t].decl].head;
 for v,index:values {
  if c.state[0].fatal {return CK_NONE;}
  f:=CK_new(c,CK_Tag.field_init,loc);value:=CK_new(c,CK_Tag.expr_int,loc);
  ft:=c.nodes[field].type;
  c.nodes[value].mark=1;c.nodes[value].type=ft;c.nodes[value].value=v.value;c.nodes[value].folded=true;
  if ft==3 {c.nodes[value].kind=CK_Tag.expr_string;c.nodes[value].name=v.text;}
  if ft==2 {c.nodes[value].kind=CK_Tag.expr_bool;}
  c.nodes[f].name=c.nodes[field].name;c.nodes[f].a=value;c.nodes[f].field_index=index;
  if c.nodes[id].head==0 {c.nodes[id].head=f;}else {c.nodes[c.nodes[id].tail].next=f;}
  c.nodes[id].tail=f;field=c.nodes[field].next;
 }
 if c.state[0].fatal {return CK_NONE;}return id;
}
CK_meta_type :: (c:CK_Context,t:int,loc:CK_Loc)->int {
 ty:=c.types[t];fields:=0;members:=0;count:=0;element:="";
 if ty.kind==CK_Kind.struct_ {fields=CK_list_count(c,c.nodes[ty.decl].head);}
 if ty.kind==CK_Kind.enum_ {members=CK_list_count(c,c.nodes[ty.decl].head);}
 if ty.kind==CK_Kind.array || ty.kind==CK_Kind.view {count=ty.length;element=c.types[ty.elem].name;}
 kinds:=[12]string.["invalid","void","integer","float","bool","string","integer literal","float literal","struct","enum","array","view"];
 values:=[11]CK_MetaValue.[CK_MetaValue.{value=1},CK_MetaValue.{text=ty.name},CK_MetaValue.{text=kinds[cast(int)ty.kind]},CK_MetaValue.{value=cast(u64)ty.size},CK_MetaValue.{value=cast(u64)ty.alignment},CK_MetaValue.{value=cast(u64)ty.bits},CK_MetaValue.{value=ifx ty.is_signed then 1 else 0},CK_MetaValue.{value=cast(u64)fields},CK_MetaValue.{value=cast(u64)members},CK_MetaValue.{value=cast(u64)count},CK_MetaValue.{text=element}];
 return CK_meta_record(c,c.nodes[CK_find(c,CK_Tag.struct_,"CoaxTypeInfo")].type,values[..],loc);
}
CK_meta_member :: (c:CK_Context,t:int,index:int,fields:bool,loc:CK_Loc)->int {
 ty:=c.types[t];member:=c.nodes[CK_at(c,c.nodes[ty.decl].head,index)];
 if fields {
  ft:=c.types[member.type];values:=[7]CK_MetaValue.[CK_MetaValue.{value=1},CK_MetaValue.{value=cast(u64)index},CK_MetaValue.{text=member.name},CK_MetaValue.{text=ft.name},CK_MetaValue.{value=cast(u64)member.field_index},CK_MetaValue.{value=cast(u64)ft.size},CK_MetaValue.{value=cast(u64)ft.alignment}];
  return CK_meta_record(c,c.nodes[CK_find(c,CK_Tag.struct_,"CoaxFieldInfo")].type,values[..],loc);
 }
 values:=[6]CK_MetaValue.[CK_MetaValue.{value=1},CK_MetaValue.{value=cast(u64)index},CK_MetaValue.{text=member.name},CK_MetaValue.{value=member.value&CM_mask(ty.bits)},CK_MetaValue.{value=cast(u64)ty.bits},CK_MetaValue.{value=ifx ty.is_signed then 1 else 0}];
 return CK_meta_record(c,c.nodes[CK_find(c,CK_Tag.struct_,"CoaxEnumInfo")].type,values[..],loc);
}
CK_meta_query :: (c:CK_Context,id:int,t:int)->int {
 if CK_sum_contains(c,t,false) {CK_error(c,c.nodes[id].loc,"E0911","this reflection schema does not support sum-containing types","");return 0;}
 e:=c.nodes[id];if c.types[t].space.kind!=SP_Kind.raw {CK_error(c,e.loc,"E0835","schema1 reflection does not describe spatial semantics","use size_of or type_name; versioned frame metadata is pending");return 0;}if c.types[t].carrier!=0 {CK_error(c,e.loc,"E0827","schema1 reflection does not describe transparent quantity carriers","use size_of and type_name; versioned physical metadata is pending");return 0;}
 if e.name=="type_info" {result:=CK_meta_type(c,t,e.loc);return CK_meta_publish(c,id,result);}
 fields:=e.name=="field_info";kind:=CK_Kind.enum_;if fields {kind=CK_Kind.struct_;}
 if c.types[t].kind!=kind {CK_error(c,e.loc,"E0382","field_info requires a struct; enum_info requires an enum","");return CK_NONE;}
 index_type:=CK_value(c,e.head,CK_Hint.{type=11});if index_type==0 {return CK_NONE;}
 if !CK_integer(c,index_type) {CK_error(c,c.nodes[e.head].loc,"E0356","a reflection index must be an integer","");return CK_NONE;}
 count:=CK_list_count(c,c.nodes[c.types[t].decl].head);
 if count==0 {CK_error(c,e.loc,"E0382","cannot select metadata from a type with no fields or members","");return CK_NONE;}
 index:=CK_const_int(c,e.head);
 if !index.bad {
  if index.negative || CM_cmp(index.mag,CM_u(cast(u64)count))>=0 {CK_error(c,c.nodes[e.head].loc,"E0374","reflection index is outside the declaration","");return CK_NONE;}
  result:=CK_meta_member(c,t,cast(int)CM_low(index.mag),fields,e.loc);return CK_meta_publish(c,id,result);
 }
 // Preflight before constructing a table. All expansion shares the bounded
 // checker node pool; a failed allocation is never partially published.
 if !CK_meta_table_fits(c.nodes.count-c.state[0].used,count,fields) {CK_resource(c,e.loc);return CK_NONE;}
 array:=CK_new(c,CK_Tag.expr_array,e.loc);c.nodes[array].mark=1;
 for i:0..<count {
  value:=CK_meta_member(c,t,i,fields,e.loc);
  if i==0 {c.nodes[array].head=value;}else {c.nodes[c.nodes[array].tail].next=value;}
  c.nodes[array].tail=value;
 }
 rt:=c.nodes[c.nodes[array].head].type;c.nodes[array].type=CK_intern(c,CK_Kind.array,rt,count);
 if c.state[0].fatal {return CK_NONE;}
 next:=c.nodes[id].next;c.nodes[id]=CK_Node.{kind=CK_Tag.expr_index,loc=e.loc,a=array,b=e.head,next=next,type=rt};return rt;
}

CK_call :: (c:CK_Context,id:int,want:CK_Hint)->int {
  if CK_spatial_constructor(c.nodes[id].name,c.nodes[id].name2)!=SP_Kind.raw {CK_error(c,c.nodes[id].loc,"E0833","spatial constructors are types, not runtime calls","");return 0;}
  if CK_unit_constructor(c.nodes[id].name,c.nodes[id].name2)!=0 {CK_error(c,c.nodes[id].loc,"E0830","unit constructors are types, not runtime calls","");return 0;}
  e:=c.nodes[id];count:=CK_list_count(c,e.head);builtin:=CK_builtin_type(e.name);
  kinds:=[1] CK_Tag.[CK_Tag.proc];
  if !CK_bind_check(c,id,kinds[..],"procedure") {a:=e.head;while a!=CK_NONE {ignored:=CK_value(c,a,CK_Hint.{});a=c.nodes[a].next;}return CK_NONE;}
  if e.name2.count!=0 {return CK_call_bound(c,id,CK_lookup(c,CK_Tag.proc,id));}
  if e.name=="convert_unit" {return CK_quantity_convert(c,id);}
  if CK_numeric(c,builtin) && e.d==CK_NONE {
    if count!=1 {CK_error(c,e.loc,"E0362",CK_join3(c,e.name,"(x) converts one value, given ",CK_count(c,count)),"");a:=e.head;while a!=CK_NONE {ignored:=CK_value(c,a,CK_Hint.{});a=c.nodes[a].next;}return CK_NONE;}
    return CK_call_cast(c,id,e.name,e.head);
  }
  proc:=CK_lookup(c,CK_Tag.proc,id);
  if e.name=="some" && proc==0 && CK_local(c,e.name)<0 && CK_lookup(c,CK_Tag.constant,id)==0 {return CK_some(c,id,want);}
  if e.name=="len" && proc==CK_NONE {
    if count!=1 {CK_error(c,e.loc,"E0375",CK_join2(c,"len takes one value, given ",CK_count(c,count)),"");return CK_NONE;}
    c.nodes[id].kind=CK_Tag.expr_field;c.nodes[id].a=e.head;c.nodes[id].head=0;c.nodes[id].tail=0;c.nodes[id].name="count";return CK_field(c,id);
  }
  if e.name=="byte_at" && proc==CK_NONE {
    if count!=2 {CK_error(c,e.loc,"E0375",CK_join3(c,"byte_at takes a string and an index, given ",CK_count(c,count)," values"),"");return CK_NONE;}
    index:=CK_new(c,CK_Tag.expr_index,e.loc);c.nodes[index].a=e.head;c.nodes[index].b=c.nodes[e.head].next;return CK_call_cast(c,id,"int",index);
  }
  byte:=CK_byte_intrinsic(e.name);
  if byte!=0 {
    c.nodes[id].byte_intrinsic=byte;n:=1;if byte==1 || byte>=7 {n=2;}
    if count!=n {CK_error(c,e.loc,"E0378","wrong byte intrinsic argument count","");return CK_NONE;}
    if byte==12 {
      a:=e.head;while a!=0 {
        t:=CK_value(c,a,CK_Hint.{type=15});if t==0 {return 0;}
        if t!=15 {CK_error(c,e.loc,"E0378","mul_wide takes two u64 operands","");return 0;}a=c.nodes[a].next;
      }
      result:=CK_find(c,CK_Tag.struct_,"CoaxU64Product");
      if result==0 {CK_error(c,e.loc,"E0378","mul_wide result type is unavailable","");return 0;}
      return c.nodes[result].type;
    }
    if byte>=7 {
      t:=CK_value(c,e.head,want);if t==CK_NONE {return CK_NONE;}
      if t!=14 && t!=15 {CK_error(c,e.loc,"E0378","wrapping operations take matching u32 or u64 operands","");return CK_NONE;}
      other:=CK_value(c,c.nodes[e.head].next,CK_Hint.{type=t});if other==CK_NONE {return CK_NONE;}
      if other!=t {CK_error(c,e.loc,"E0378","wrapping operand widths must match","");return CK_NONE;}
      return t;
    }
    if byte==6 {
      // value_barrier(x): u32 or u64 in, the same out; the optimizer can't see through it (spec section 9)
      t:=CK_value(c,e.head,want);if t==CK_NONE {return CK_NONE;}
      if t!=14 && t!=15 {CK_error(c,e.loc,"E0378","value_barrier takes a u32 or a u64","value_barrier(cast(u64) x)");return CK_NONE;}
      return t;
    }
    target:=7;if byte==2 {target=14;}else if byte==3 {target=15;}else if byte==4 {target=6;}
    a:=e.head;while a!=CK_NONE {hint:=CK_Hint.{type=target};if byte==1 {hint=CK_Hint.{};}t:=CK_value(c,a,hint);span:=t==3 || (c.types[t].kind==CK_Kind.view && c.types[t].elem==12);
      if (byte==1 && !span) || (byte!=1 && t!=target) {CK_error(c,e.loc,"E0378","byte intrinsic argument type mismatch","");}a=c.nodes[a].next;
    }
    if byte==1 {return 2;}if byte==2 {return 6;}if byte==3 {return 7;}if byte==4 {return 14;}return 15;
  }
  intrinsic:=CK_intrinsic(e.name);if intrinsic!=0 {return CK_math_call(c,id,intrinsic,want);}
  if e.d!=CK_NONE {t:=CK_resolve(c,e.d,CK_Access.value);if t==CK_NONE {return CK_NONE;}
    if CK_generic(c,t) {CK_error(c,e.loc,"E0399",CK_join3(c,e.name,"(",CK_join2(c,c.types[t].name,") depends on the instance, and generic instantiation is not yet supported")),"");return CK_NONE;}if e.name!="size_of" {return CK_meta_query(c,id,t);}CK_set_int(c,id,CM_from(cast(u64)c.types[t].size,false));return c.nodes[id].type;}
  if e.name=="type_name" {
    if count!=1 {CK_error(c,e.loc,"E0343","type_name needs exactly one expression","");return CK_NONE;}
    c.state[0].unevaluated+=1;t:=CK_value(c,e.head,CK_Hint.{});c.state[0].unevaluated-=1;if t==CK_NONE {return CK_NONE;}
    if t==1 {CK_error(c,e.loc,"E0343","type_name needs an expression with a value","");return CK_NONE;}
    if CK_generic(c,t) {CK_error(c,e.loc,"E0399",CK_join3(c,"type_name of a ",c.types[t].name," value depends on the instance, and generic instantiation is not yet supported"),"");return CK_NONE;}
    c.nodes[id].kind=CK_Tag.expr_string;c.nodes[id].name=c.types[t].name;c.nodes[id].head=0;c.nodes[id].tail=0;return 3;
  }
  if CK_lookup(c,CK_Tag.constant,id)!=0 {CK_error(c,e.loc,"E0314",CK_join3(c,"'",e.name,"' is a constant, not a procedure"),"");return CK_NONE;}
  if e.name=="print" && proc==CK_NONE {
    c.nodes[id].builtin_print=true;
    if !c.state[0].basic {CK_error(c,e.loc,"E0313","print is in module Basic, which is not imported","add #import \"Basic\"; at the top of the file");}return CK_print(c,id);
  }
  if proc==CK_NONE {
    if CK_local(c,e.name)>=0 {CK_error(c,e.loc,"E0314",CK_join3(c,"'",e.name,"' is a variable, not a procedure"),"");}
    else if CK_lookup(c,CK_Tag.struct_,id)!=0 {CK_error(c,e.loc,"E0354",CK_join3(c,"'",e.name,"' is a struct, not a procedure"),CK_join3(c,"make one: ",e.name,".{field = value}"));}
    else {CK_error(c,e.loc,"E0315",CK_join3(c,"procedure '",e.name,"' is not declared"),"");}
    a:=e.head;while a!=CK_NONE {ignored:=CK_value(c,a,CK_Hint.{});a=c.nodes[a].next;}return CK_NONE;
  }
  return CK_call_bound(c,id,proc);
}
// One argument against a concrete formal type: E0317 when they differ.
CK_argument :: (c:CK_Context,proc:int,a:int,formal:int,i:int) {CK_mismatch(c,proc,a,formal,CK_value(c,a,CK_Hint.{type=formal}),i);}
CK_mismatch :: (c:CK_Context,proc:int,a:int,formal:int,t:int,i:int) {
  if formal!=CK_NONE && t!=CK_NONE && t!=formal {fix:="";if c.types[t].kind==CK_Kind.array && c.types[formal].kind==CK_Kind.view {fix="pass a view of it: name[..]";}
    parts:=[7] string.["argument ",CK_count(c,i+1)," of '",c.nodes[proc].name,"' is ",c.types[formal].name,CK_join2(c,", given ",c.types[t].name)];CK_error(c,c.nodes[a].loc,"E0317",CK_text(c,parts[..]),fix);
  }
}
