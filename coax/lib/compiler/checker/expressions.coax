// Expressions: operators, reflection metadata, calls and arguments. A part of
// the checker: lib/compiler/checker.coax loads it (#12646).
#authority;
CK_binary :: (c:CK_Context,id:int,want:CK_Hint)->int {
  e:=c.nodes[id];if c.nodes[e.a].kind==CK_Tag.expr_null || c.nodes[e.b].kind==CK_Tag.expr_null {return CK_null_comparison(c,id);}
  comparison:=e.op>=44;shift:=e.op==42 || e.op==43;hint:=want;
  if comparison {hint=CK_Hint.{};}rhint:=hint;if shift {rhint=CK_Hint.{};}
  a:=CK_expr(c,e.a,hint);b:=CK_expr(c,e.b,rhint);if a==CK_NONE || b==CK_NONE {return CK_NONE;}
  if c.types[a].space.kind!=SP_Kind.raw || c.types[b].space.kind!=SP_Kind.raw {return CK_spatial_binary(c,id,a,b);}
  if CK_untyped(c,a) && CK_untyped(c,b) {return CK_fold_binary(c,id);}
  if shift {
    if CK_untyped(c,a) {to:=11;if CK_integer(c,hint.type) {to=hint.type;}CK_coerce(c,e.a,to);}
    if CK_untyped(c,b) {to:=11;if CK_integer(c,c.nodes[e.a].type) {to=c.nodes[e.a].type;}CK_coerce(c,e.b,to);}
  }else {if CK_untyped(c,a) {to:=b;if c.types[b].carrier!=0 {to=c.types[b].carrier;}CK_coerce(c,e.a,to);}if CK_untyped(c,b) {to:=a;if c.types[a].carrier!=0 {to=c.types[a].carrier;}CK_coerce(c,e.b,to);}}
  a=c.nodes[e.a].type;b=c.nodes[e.b].type;if a==CK_NONE || b==CK_NONE {return CK_NONE;}
  if c.types[a].carrier!=0 || c.types[b].carrier!=0 {if c.types[a].carrier!=0 && c.types[b].carrier!=0 && (e.op==36 || e.op==37) {return CK_quantity_derived(c,id,a,b);}return CK_quantity_binary(c,id,a,b);}
  pair:=CK_join3(c,c.types[a].name," and ",c.types[b].name);
  if e.op>=34 && e.op<=38 {
    if a!=b || !CK_numeric(c,a) || (e.op==38 && !CK_integer(c,a)) {
      need:=" needs two numbers of one type";if e.op==38 {need=" needs two integers of one type";}
      fix:=CK_constrain_fix(c,a,"numeric");if a==3 {fix="build strings with print's % formatting";}else if CK_numeric(c,a) && CK_numeric(c,b) {fix=CK_join3(c,"convert one: cast(",c.types[a].name,") x");}
      parts:=[4] string.[CK_op(e.op),need,", found ",pair];CK_error(c,e.loc,"E0309",CK_text(c,parts[..]),fix);return CK_NONE;
    }return a;
  }
  if e.op>=39 && e.op<=41 {
    if a!=b || !CK_integer(c,a) {CK_error(c,e.loc,"E0370",CK_join3(c,CK_op(e.op)," needs two integers of one type, found ",pair),"");return CK_NONE;}return a;
  }
  if shift {if !CK_integer(c,a) || !CK_integer(c,b) {CK_error(c,e.loc,"E0370",CK_join3(c,CK_op(e.op)," shifts an integer by an integer, found ",pair),"");return CK_NONE;}return a;}
  if e.op>=46 && e.op<=49 {
    if a!=b || !CK_ordered(c,a) {fix:=CK_constrain_fix(c,a,"ordered");if CK_numeric(c,a) && CK_numeric(c,b) {fix=CK_join3(c,"convert one: cast(",c.types[a].name,") x");}CK_error(c,e.loc,"E0310",CK_join3(c,CK_op(e.op)," compares two numbers of one type, found ",pair),fix);return CK_NONE;}return 2;
  }
  if e.op==44 || e.op==45 {
    if a!=b {parts:=[4] string.["cannot compare ",c.types[a].name," with ",c.types[b].name];CK_error(c,e.loc,"E0311",CK_text(c,parts[..]),"there are no implicit conversions in Coax");return CK_NONE;}
    if !CK_meets(c,a,2) {fix:=CK_constrain_fix(c,a,"equatable");if fix=="" {fix="compare the fields or elements you mean";}parts:=[4] string.["cannot compare ",c.types[a].name," values with ",CK_op(e.op)];CK_error(c,e.loc,"E0311",CK_text(c,parts[..]),fix);return CK_NONE;}return 2;
  }
  if e.op==50 || e.op==51 {if a!=2 || b!=2 {CK_error(c,e.loc,"E0312",CK_join3(c,CK_op(e.op)," needs two bools, found ",pair),"");return CK_NONE;}return 2;}
  return CK_NONE;
}
CK_expr :: (c:CK_Context,id:int,want:CK_Hint)->int {
  if id<2 {return CK_NONE;}if !CK_enter(c,c.nodes[id].loc) {return CK_NONE;}defer CK_leave(c);t:=CK_expr_inner(c,id,want);c.nodes[id].type=t;return t;
}
CK_prechecked :: (node:CK_Node)->bool {
 return (node.mark==1 && (node.kind==CK_Tag.expr_struct || node.kind==CK_Tag.expr_array)) || (node.mark==2 && node.kind==CK_Tag.expr_call && node.proc!=0);
}
CK_expr_inner :: (c:CK_Context,id:int,want:CK_Hint)->int {
  e:=c.nodes[id];
  if e.kind==CK_Tag.expr_sum || e.kind==CK_Tag.expr_null || e.kind==CK_Tag.expr_some || e.kind==CK_Tag.expr_try || e.kind==CK_Tag.expr_or_else {return CK_sum_expression(c,id,want);}
  if CK_prechecked(e) {return e.type;}
  if e.kind==CK_Tag.expr_int {if e.type==0 {return 4;}return e.type;}
  if e.kind==CK_Tag.expr_float {if e.type==0 {return 5;}return e.type;}
  if e.kind==CK_Tag.expr_bool {return 2;}if e.kind==CK_Tag.expr_string {return 3;}
  if e.kind==CK_Tag.expr_enum || e.kind==CK_Tag.expr_ct {return e.type;}
  if e.kind==CK_Tag.expr_run {t:=CK_value(c,e.a,want);if t==1 {CK_error(c,e.loc,"E0341","#run must produce a value","");}return t;}
  if e.kind==CK_Tag.expr_ident {
    if e.name2.count==0 {local:=CK_local(c,e.name);if local>=0 {c.nodes[id].borrow_binding=c.locals[local].decl;return c.locals[local].type;}}
    kinds:=[4] CK_Tag.[CK_Tag.constant,CK_Tag.proc,CK_Tag.struct_,CK_Tag.enum_];if !CK_bind_check(c,id,kinds[..],"declaration") {return CK_NONE;}
    constant:=CK_lookup(c,CK_Tag.constant,id);
    if constant!=CK_NONE {t:=CK_constant_type(c,constant);expr:=c.nodes[constant].a;if CK_untyped(c,t) && (c.nodes[expr].kind==CK_Tag.expr_int || c.nodes[expr].kind==CK_Tag.expr_float) {CK_copy_expr(c,id,expr,true);return t;}c.nodes[id].constant=constant;return t;}
    if CK_lookup(c,CK_Tag.proc,id)!=0 {call:=e.name;if e.name2.count!=0 {call=CK_join3(c,e.name2,".",e.name);}CK_error(c,e.loc,"E0305","procedures are not values in coax0",CK_join3(c,"call it: ",call,"()"));return CK_NONE;}
    st:=CK_lookup(c,CK_Tag.struct_,id);en:=CK_lookup(c,CK_Tag.enum_,id);
    if st!=0 || en!=0 || CK_lookup(c,CK_Tag.union_,id)!=0 {fix:=CK_join3(c,"name a member: ",e.name,".member");if st!=0 {fix=CK_join3(c,"make one: ",e.name,".{}");}CK_error(c,e.loc,"E0354",CK_join3(c,"'",e.name,"' is a type, not a value"),fix);return CK_NONE;}
    CK_error(c,e.loc,"E0306",CK_join3(c,"'",e.name,"' is not declared"),"");return CK_NONE;
  }
  if e.kind==CK_Tag.expr_call {t:=CK_call(c,id,want);CK_borrow_call(c,id);return t;}
  if e.kind==CK_Tag.expr_unary {
    t:=CK_expr(c,e.a,want);if t==CK_NONE {return CK_NONE;}
    if c.types[t].space.kind!=SP_Kind.raw {return CK_spatial_unary(c,id,t);}
    if e.op==35 {
      if t==4 {folded:=c.nodes[e.a].folded;CK_set_int(c,id,CM_negate(CK_untyped_int(c,e.a)));c.nodes[id].folded=folded;return c.nodes[id].type;}
      if t==5 {CK_set_float(c,id,c.nodes[e.a].floating^9223372036854775808);return c.nodes[id].type;}
      if !(CK_float(c,t) || (CK_integer(c,t) && c.types[t].is_signed)) {CK_error(c,e.loc,"E0307",CK_join2(c,"'-' needs a signed integer or a float, found ",c.types[t].name),"");return CK_NONE;}return t;
    }
    if t!=2 {fix:="";if CK_numeric(c,t) || CK_untyped(c,t) {fix="compare it: x == 0";}CK_error(c,e.loc,"E0308",CK_join2(c,"'!' needs a bool, found ",c.types[t].name),fix);return CK_NONE;}return t;
  }
  if e.kind==CK_Tag.expr_binary {return CK_binary(c,id,want);}if e.kind==CK_Tag.expr_field {return CK_field(c,id);}
  if e.kind==CK_Tag.expr_index {
    t:=CK_expr(c,e.a,CK_Hint.{});index:=CK_value(c,e.b,CK_Hint.{type=11});if t==CK_NONE || index==0 {return CK_NONE;}
    if !CK_integer(c,index) {CK_error(c,c.nodes[e.b].loc,"E0356",CK_join2(c,"an index must be an integer, found ",c.types[index].name),"");return CK_NONE;}
    if c.types[t].kind==CK_Kind.array && !CK_generic(c,t) && c.nodes[e.b].kind==CK_Tag.expr_int && c.state[0].unevaluated==0 {
      raw:=c.nodes[e.b].value;below:=c.types[index].is_signed && (raw>>63)!=0;
      if below || raw>=cast(u64)c.types[t].length {
        value:=CM_signed_bits(raw,below);parts:=[4] string.["index ",CK_number(c,value)," is outside ",c.types[t].name];CK_error(c,c.nodes[e.b].loc,"E0374",CK_text(c,parts[..]),CK_join2(c,"valid indexes are 0 to ",CK_count(c,c.types[t].length-1)));return CK_NONE;
      }
    }
    if c.types[t].kind==CK_Kind.array || c.types[t].kind==CK_Kind.view {return c.types[t].elem;}if t==3 {return 12;}
    CK_error(c,e.loc,"E0355",CK_join2(c,"cannot index ",c.types[t].name),"only arrays, views and strings can be indexed");return CK_NONE;
  }
  if e.kind==CK_Tag.expr_slice {
    t:=CK_expr(c,e.a,CK_Hint.{});bounds_ok:=true;bounds:=[2] int.[e.b,e.c];
    for bound:bounds {bt:=CK_value(c,bound,CK_Hint.{type=11});if bt!=0 && !CK_integer(c,bt) {CK_error(c,c.nodes[bound].loc,"E0356",CK_join2(c,"a slice bound must be an integer, found ",c.types[bt].name),"");bounds_ok=false;}}
    if t==CK_NONE || !bounds_ok {return CK_NONE;}if t==3 || c.types[t].kind==CK_Kind.view {return t;}
    if c.types[t].kind==CK_Kind.array {why:=CK_immutable(c,e.a);if why!="" {CK_error(c,e.loc,"E0366",CK_join2(c,"a view needs an array variable it may write through, and this is a ",why),"copy it into a local variable first");return CK_NONE;}return CK_intern(c,CK_Kind.view,c.types[t].elem,0);}
    CK_error(c,e.loc,"E0355",CK_join2(c,"cannot slice ",c.types[t].name),"only arrays, views and strings can be sliced");return CK_NONE;
  }
  if e.kind==CK_Tag.expr_struct {
    syntax:=c.nodes[e.d];if syntax.kind==CK_Tag.type_optional || (syntax.name=="Result" && syntax.name2.count==0) || CK_lookup(c,CK_Tag.union_,e.d)!=0 {return CK_sum_construct(c,id,CK_resolve(c,e.d,CK_Access.value));}
    name:=c.nodes[e.d].name;kinds:=[2] CK_Tag.[CK_Tag.struct_,CK_Tag.enum_];bound:=CK_bind_check(c,e.d,kinds[..],"type");d:=CK_NONE;if bound {d=CK_lookup(c,CK_Tag.struct_,e.d);}
    if d==CK_NONE {field:=e.head;while field!=CK_NONE {ignored:=CK_value(c,c.nodes[field].a,CK_Hint.{});field=c.nodes[field].next;}if !bound {return CK_NONE;}code:="E0302";if CK_lookup(c,CK_Tag.enum_,e.d)!=0 {code="E0354";}CK_error(c,e.loc,code,CK_join3(c,"'",name,"' is not a struct"),"");return CK_NONE;}
    // A generic struct's literal is its hint's instance, or the one its fields deduce; the
    // fields are then checked against that instance like any literal's.
    if c.nodes[d].generic {h:=c.types[want.type];if h.kind==CK_Kind.struct_ && c.nodes[h.decl].origin==d {d=h.decl;}else {d=CK_deduce(c,id,d);if d==CK_NONE {return CK_NONE;}}}
    CK_layout(c,d);field:=e.head;
    while field!=CK_NONE && !c.state[0].fatal {
      f:=c.nodes[field];if f.a==0 {CK_error(c,f.loc,"E0901","an ordinary record field requires = value","");return 0;}prior:=e.head;while prior!=field {if c.nodes[prior].name==f.name {CK_error(c,f.loc,"E0352",CK_join3(c,"field '",f.name,"' is given twice"),"");}prior=c.nodes[prior].next;}
      member:=c.nodes[d].head;at:=0;while member!=CK_NONE {if c.nodes[member].name==f.name {c.nodes[field].field_index=at;}at+=1;member=c.nodes[member].next;}
      if c.nodes[field].field_index<0 {ignored:=CK_value(c,f.a,CK_Hint.{});parts:=[5] string.["struct '",c.nodes[d].name,"' has no field '",f.name,"'"];CK_error(c,f.loc,"E0351",CK_text(c,parts[..]),CK_field_list(c,d,false));}
      else {member=CK_at(c,c.nodes[d].head,c.nodes[field].field_index);ft:=c.nodes[member].type;vt:=CK_value(c,f.a,CK_Hint.{type=ft});if vt!=CK_NONE && ft!=CK_NONE && vt!=ft {parts:=[5] string.["field '",f.name,"' is ",c.types[ft].name,CK_join2(c,", given ",c.types[vt].name)];CK_error(c,c.nodes[f.a].loc,"E0367",CK_text(c,parts[..]),"");}}
      field=f.next;
    }CK_literal_defaults(c,id,d);return c.nodes[d].type;
  }
  if e.kind==CK_Tag.expr_array {
    t:=CK_resolve(c,e.d,CK_Access.value);a:=e.head;
    if t==CK_NONE {while a!=CK_NONE {ignored:=CK_value(c,a,CK_Hint.{});a=c.nodes[a].next;}return CK_NONE;}
    count:=CK_list_count(c,e.head);if count!=c.types[t].length {parts:=[6] string.[c.types[t].name," needs ",CK_count(c,c.types[t].length)," elements, given ",CK_count(c,count),""];CK_error(c,e.loc,"E0358",CK_text(c,parts[..]),"");}
    while a!=CK_NONE && !c.state[0].fatal {ty:=CK_value(c,a,CK_Hint.{type=c.types[t].elem});if ty!=CK_NONE && ty!=c.types[t].elem {parts:=[4] string.["elements are ",c.types[c.types[t].elem].name,", given ",c.types[ty].name];CK_error(c,c.nodes[a].loc,"E0367",CK_text(c,parts[..]),"");}a=c.nodes[a].next;}return t;
  }
  if e.kind==CK_Tag.expr_cast {return CK_cast(c,id);}
  if e.kind==CK_Tag.expr_ifx {
    condition:=CK_value(c,e.a,CK_Hint.{});if condition!=0 && condition!=2 {CK_error(c,c.nodes[e.a].loc,"E0331",CK_join2(c,"condition must be bool, found ",c.types[condition].name),"");}
    a:=CK_expr(c,e.b,want);b:=CK_expr(c,e.c,want);
    if CK_untyped(c,a) && !CK_untyped(c,b) {CK_coerce(c,e.b,b);}else if CK_untyped(c,b) && !CK_untyped(c,a) {CK_coerce(c,e.c,a);}
    else if CK_untyped(c,a) {t:=11;if CK_numeric(c,want.type) {t=want.type;}else if a==5 || b==5 {t=7;}CK_coerce(c,e.b,t);CK_coerce(c,e.c,t);}
    a=c.nodes[e.b].type;b=c.nodes[e.c].type;if a==CK_NONE || b==CK_NONE {return CK_NONE;}
    if a!=b {parts:=[4] string.["ifx branches must have one type, found ",c.types[a].name," and ",c.types[b].name];CK_error(c,e.loc,"E0365",CK_text(c,parts[..]),"");return CK_NONE;}
    if a==1 {CK_error(c,e.loc,"E0365","ifx branches must produce values","");return CK_NONE;}return a;
  }return CK_NONE;
}

CK_call_cast :: (c:CK_Context,id:int,name:string,operand:int)->int {
  ty:=CK_new(c,CK_Tag.type_named,c.nodes[id].loc);c.nodes[ty].name=name;c.nodes[id].kind=CK_Tag.expr_cast;c.nodes[id].d=ty;c.nodes[id].a=operand;c.nodes[id].head=0;c.nodes[id].tail=0;return CK_cast(c,id);
}
CK_math_call :: (c:CK_Context,id:int,intrinsic:u32,want:CK_Hint)->int {
  e:=c.nodes[id];arity:=1;if intrinsic==9 {arity=2;}if intrinsic==10 {arity=3;}c.nodes[id].intrinsic=intrinsic;count:=CK_list_count(c,e.head);
  if count!=arity {need:="one value";if arity==2 {need="two values";}if arity==3 {need="three values";}parts:=[5] string.[e.name," takes ",need,", given ",CK_count(c,count)];CK_error(c,e.loc,"E0375",CK_text(c,parts[..]),"");a:=e.head;while a!=CK_NONE {ignored:=CK_value(c,a,CK_Hint.{});a=c.nodes[a].next;}return CK_NONE;}
  hint:=CK_Hint.{};if CK_float(c,want.type) {hint=want;}bad:=false;a:=e.head;
  while a!=CK_NONE {t:=CK_expr(c,a,hint);bad=t==CK_NONE || bad;a=c.nodes[a].next;}if bad {return CK_NONE;}
  t:=0;for i:0..<arity {arg:=CK_at(c,e.head,i);if !CK_untyped(c,c.nodes[arg].type) {t=c.nodes[arg].type;break;}}
  if t==0 {t=7;if hint.type!=CK_NONE {t=hint.type;}}
  a=e.head;while a!=CK_NONE {if CK_untyped(c,c.nodes[a].type) {CK_coerce(c,a,t);}a=c.nodes[a].next;}
  a=e.head;while a!=CK_NONE {
    at:=c.nodes[a].type;if at==0 {return CK_NONE;}
    if at!=t || !CK_float(c,t) {need:=" needs a float";if arity==2 {need=" needs two floats of one type";}if arity==3 {need=" needs three floats of one type";}fix:="";if CK_integer(c,at) {fix="convert it first: f64(x)";}parts:=[4] string.[e.name,need,", found ",c.types[at].name];CK_error(c,c.nodes[a].loc,"E0375",CK_text(c,parts[..]),fix);return CK_NONE;}a=c.nodes[a].next;
  }return t;
}
// Schema 1 is target layout metadata, lowered to ordinary typed values. No
// compiler object, pointer or host resource escapes into the target program.
CK_MetaValue :: struct {text:string;value:u64;}
#test "reflection workspace is requested only by typed query syntax" {
 nodes:[3] CK_Node;
 #assert CK_meta_capacity(nodes[..],2)==0;
 nodes[2]=CK_Node.{kind=CK_Tag.expr_call,name="field_info",d=1};
 #assert CK_meta_capacity(nodes[..],2)==65536;
 nodes[2].name="enum_info";#assert CK_meta_capacity(nodes[..],2)==65536;
 nodes[2].name="type_info";#assert CK_meta_capacity(nodes[..],2)==65536;
 nodes[2].d=0;#assert CK_meta_capacity(nodes[..],2)==0;
 nodes[1]=CK_Node.{kind=CK_Tag.expr_ident,name="type_info",d=1};
 #assert CK_meta_capacity(nodes[..],2)==0;
 nodes[1].kind=CK_Tag.expr_call;#assert CK_meta_capacity(nodes[..],2)==65536;
 nodes[1].name="size_of";#assert CK_meta_capacity(nodes[..],2)==0;
}
