// Direct semantic boundary checks.
#test "sentinels and list indexing" {
nodes:[160]CK_Node;types:[80]CK_Type;locals:[10]CK_Local;errors:[10]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
#assert CK_builtin(0).alignment==1 && CK_builtin(0).size==0;
nodes[2].next=3;nodes[3].next=4;#assert CK_at(c,2,0)==2 && CK_at(c,2,1)==3 && CK_at(c,2,2)==4 && CK_at(c,2,3)==0 && CK_at(c,2,-1)==0 && CK_at(c,0,0)==0;
nodes[2].loc=CK_Loc.{line=7};nodes[2].next=4;nodes[3]=CK_Node.{kind=CK_Tag.expr_int,value=19,loc=CK_Loc.{line=8},next=1};CK_copy_expr(c,2,3,true);#assert nodes[2].value==19 && nodes[2].loc.line==7 && nodes[2].next==4;
#assert CK_field_list(c,1,false)=="it has no fields";#assert CK_field_list(c,1,true)=="its members are:";
}
#test "classification tables and compound tokens" {
nodes:[160]CK_Node;types:[80]CK_Type;locals:[10]CK_Local;errors:[10]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
for i:0..<16 {#assert CK_default(i)==(ifx i==4 then 11 else ifx i==5 then 7 else i);#assert CK_foreign_scalar(c,i)==(i==0 || i==2 || i>=6);#assert CK_metal_type(i)==(i==0 || i==1 || i==2 || i==6);}
for op:0..<54 {expected:u32=0;if op>=24 && op<=33 {expected=cast(u32)(op+10);}#assert CK_compound(cast(u32)op)==expected;}
#assert CK_builtin_name(c,"type_name") && CK_builtin_name(c,"len") && CK_builtin_name(c,"byte_at") && CK_builtin_name(c,"sin") && CK_builtin_name(c,"f64_bits") && !CK_builtin_name(c,"print");state[0].basic=true;#assert CK_builtin_name(c,"print") && !CK_builtin_name(c,"missing");
}
#test "const integer depth and identity" {
nodes:[160]CK_Node;types:[80]CK_Type;locals:[10]CK_Local;errors:[10]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
nodes[2]=CK_Node.{kind=CK_Tag.expr_int,type=4,value=18446744073709551615,negative=true};v:=CK_const_int_depth(c,2,64);#assert v.negative && CM_low(v.mag)==1 && !v.bad;#assert CK_const_int_depth(c,2,65).bad;
nodes[2].type=3;#assert CK_const_int(c,2).bad;nodes[2]=CK_Node.{kind=CK_Tag.expr_ident,constant=3};nodes[3]=CK_Node.{kind=CK_Tag.constant,a=4,mark=2};nodes[4]=CK_Node.{kind=CK_Tag.expr_int,type=4,value=6};#assert CM_low(CK_const_int(c,2).mag)==6;nodes[3].mark=1;#assert CK_const_int(c,2).bad;nodes[2].constant=0;#assert CK_const_int(c,2).bad;
nodes[5]=CK_Node.{kind=CK_Tag.expr_unary,a=4,op=35};#assert CK_const_int(c,5).negative;nodes[5].op=34;#assert CK_const_int(c,5).bad;
for op:34..<39 {nodes[6]=CK_Node.{kind=CK_Tag.expr_binary,a=4,b=4,op=cast(u32)op};v=CK_const_int(c,6);expected:=[5]u64.[12,0,36,1,0];#assert !v.bad && CM_low(v.mag)==expected[op-34];}
}
#test "constant depth limit and local hiding" {
nodes:[160]CK_Node;types:[80]CK_Type;locals:[10]CK_Local;errors:[10]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
nodes[2]=CK_Node.{kind=CK_Tag.constant,name="C",a=3};nodes[3]=CK_Node.{kind=CK_Tag.expr_int,value=1};state[0].constant_depth=64;#assert CK_constant_type(c,2)==0 && errors[0].code=="E0347" && state[0].constant_depth==64;
state[0].constant_depth=63;state[0].local_count=1;locals[0]=CK_Local.{name="x",type=8};#assert CK_constant_type(c,2)==4 && state[0].constant_depth==63 && state[0].local_count==1 && locals[0].name=="x";
nodes[2].mark=0;nodes[3].value=18446744073709551615;#assert CK_constant_type(c,2)==0 && nodes[2].mark==2;

}
#test "return path and capacity of local declaration" {
nodes:[160]CK_Node;types:[80]CK_Type;locals:[10]CK_Local;errors:[10]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}state[0].type_count=16;
nodes[2]=CK_Node.{kind=CK_Tag.stmt_if,c=3,d=4};nodes[3].kind=CK_Tag.stmt_return;nodes[4].kind=CK_Tag.stmt_block;#assert !CK_always_returns(c,2);nodes[4].head=5;nodes[5].kind=CK_Tag.stmt_return;#assert CK_always_returns(c,2);nodes[2].d=0;#assert !CK_always_returns(c,2);
state[0].local_count=9;CK_declare(c,"last",8,CK_Loc.{line=2},"binding");#assert state[0].local_count==10 && locals[9].name=="last" && locals[9].type==8 && locals[9].loc.line==2 && locals[9].immutable=="binding";CK_declare(c,"overflow",8,CK_Loc.{},"");#assert state[0].fatal;
}
