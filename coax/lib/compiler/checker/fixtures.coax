  nodes:[28] CK_Node;for v,i:initial {nodes[i]=v;}
  types:[28] CK_Type;locals:[20] CK_Local;errors:[48] CK_Error;bytes:[6248] u8;state:[1] CK_State;
  context:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
