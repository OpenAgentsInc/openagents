    CK_Node.{kind=CK_Tag.member,loc=CK_Loc.{line=1,column=53,offset=52},name="b",a=15,value=4},
    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=1,column=55,offset=54},value=4,type=4},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=1,column=59,offset=58},name="f",a=22,b=23,head=17,tail=20,flag=true,type=11},
    CK_Node.{kind=CK_Tag.param,loc=CK_Loc.{line=1,column=65,offset=64},name="s",a=18,next=20,type=19},
