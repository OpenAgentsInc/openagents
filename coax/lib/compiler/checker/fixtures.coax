#test "checker: metal error 5" {
  initial:=[7] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=2},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=1,column=1,offset=0},name="f",b=3},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=1,column=9,offset=8},head=4,tail=4},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=1,column=10,offset=9},name="x",a=5},
    CK_Node.{kind=CK_Tag.expr_call,loc=CK_Loc.{line=1,column=13,offset=12},name="f64_from_bits",head=6,tail=6},
    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=1,column=27,offset=26}}];
  nodes:[37] CK_Node;for v,i:initial {nodes[i]=v;}
  types:[37] CK_Type;locals:[23] CK_Local;errors:[72] CK_Error;bytes:[7920] u8;state:[1] CK_State;
  context:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
  ok:=CK_run(context,initial.count-1,CK_Options.{library=true,metal=true,authority=false});
  #assert ok==false && state[0].error_count==1 && state[0].depth==0;
  // The semantic pass restores its scope/depth counters.
  #assert state[0].used==6;
  #assert state[0].type_count==16;
  #assert state[0].composite_count==0;
  #assert state[0].local_count==0;
  #assert state[0].byte_count==58;
  #assert state[0].error_count==1;
  #assert state[0].current==2;
  #assert state[0].constant_depth==0;
  #assert state[0].loop_depth==0;
  #assert state[0].defer_depth==0;
  #assert state[0].unevaluated==0;
  #assert state[0].basic==false;
  #assert state[0].depth==0;
  #assert state[0].fatal==false;
