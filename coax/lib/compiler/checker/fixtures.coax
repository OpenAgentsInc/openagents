    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=2},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=1,column=1,offset=0},name="main",b=3},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=1,column=12,offset=11},head=4,tail=12},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=1,column=13,offset=12},name="a",a=7,next=8},
    CK_Node.{kind=CK_Tag.expr_bool,loc=CK_Loc.{line=1,column=16,offset=15},value=1},
    CK_Node.{kind=CK_Tag.expr_bool,loc=CK_Loc.{line=1,column=21,offset=20}},
    CK_Node.{kind=CK_Tag.expr_binary,loc=CK_Loc.{line=1,column=20,offset=19},a=5,b=6,op=34},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=1,column=28,offset=27},name="b",a=11,next=12},
    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=1,column=31,offset=30},value=1},
    CK_Node.{kind=CK_Tag.expr_bool,loc=CK_Loc.{line=1,column=34,offset=33},value=1},
    CK_Node.{kind=CK_Tag.expr_binary,loc=CK_Loc.{line=1,column=32,offset=31},a=9,b=10,op=44},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=1,column=40,offset=39},name="c",a=15},
    CK_Node.{kind=CK_Tag.expr_float,loc=CK_Loc.{line=1,column=43,offset=42},floating=4607182418800017408},
    CK_Node.{kind=CK_Tag.expr_float,loc=CK_Loc.{line=1,column=47,offset=46},floating=4611686018427387904},
    CK_Node.{kind=CK_Tag.expr_binary,loc=CK_Loc.{line=1,column=46,offset=45},a=13,b=14,op=38}];
  nodes:[64] CK_Node;for v,i:initial {nodes[i]=v;}
  types:[64] CK_Type;locals:[32] CK_Local;errors:[144] CK_Error;bytes:[12696] u8;state:[1] CK_State;
  context:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
  ok:=CK_run(context,initial.count-1,CK_Options.{library=true,metal=false,authority=false});
  #assert ok==false && state[0].error_count==3 && state[0].depth==0;
  // The semantic pass restores its scope/depth counters.
  #assert state[0].used==15;
  #assert state[0].type_count==16;
  #assert state[0].composite_count==0;
  #assert state[0].local_count==0;
  #assert state[0].byte_count==172;
  #assert state[0].error_count==3;
  #assert state[0].current==2;
  #assert state[0].constant_depth==0;
  #assert state[0].loop_depth==0;
  #assert state[0].defer_depth==0;
  #assert state[0].unevaluated==0;
  #assert state[0].basic==false;
  #assert state[0].depth==0;
  #assert state[0].fatal==false;
  #assert state[0].metal_depth==0;

  #assert errors[0].code=="E0309" && errors[0].loc.line==1 && errors[0].loc.column==20 && errors[0].message=="'+' needs two numbers of one type, found bool and bool" && errors[0].fix=="";
  #assert errors[1].code=="E0311" && errors[1].loc.line==1 && errors[1].loc.column==32 && errors[1].message=="cannot compare integer literal with bool" && errors[1].fix=="there are no implicit conversions in Coax";
  #assert errors[2].code=="E0370" && errors[2].loc.line==1 && errors[2].loc.column==46 && errors[2].message=="'%' needs integers, found a float literal" && errors[2].fix=="";
  expected:=[16] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=2},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=1,column=1,offset=0},name="main",b=3,type=1},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=1,column=12,offset=11},head=4,tail=12},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=1,column=13,offset=12},name="a",a=7,next=8},
    CK_Node.{kind=CK_Tag.expr_bool,loc=CK_Loc.{line=1,column=16,offset=15},value=1,type=2},
    CK_Node.{kind=CK_Tag.expr_bool,loc=CK_Loc.{line=1,column=21,offset=20},type=2},
    CK_Node.{kind=CK_Tag.expr_binary,loc=CK_Loc.{line=1,column=20,offset=19},a=5,b=6,op=34},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=1,column=28,offset=27},name="b",a=11,next=12},
    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=1,column=31,offset=30},value=1,type=4},
    CK_Node.{kind=CK_Tag.expr_bool,loc=CK_Loc.{line=1,column=34,offset=33},value=1,type=2},
    CK_Node.{kind=CK_Tag.expr_binary,loc=CK_Loc.{line=1,column=32,offset=31},a=9,b=10,op=44},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=1,column=40,offset=39},name="c",a=15},
    CK_Node.{kind=CK_Tag.expr_float,loc=CK_Loc.{line=1,column=43,offset=42},floating=4607182418800017408,type=5},
    CK_Node.{kind=CK_Tag.expr_float,loc=CK_Loc.{line=1,column=47,offset=46},floating=4611686018427387904,type=5},
    CK_Node.{kind=CK_Tag.expr_binary,loc=CK_Loc.{line=1,column=46,offset=45},a=13,b=14,op=38}];
  #assert state[0].used==expected.count-1;
  for i:0..<expected.count {a:=nodes[i];b:=expected[i];
    #assert a.kind==b.kind;
    #assert a.loc.line==b.loc.line && a.loc.column==b.loc.column && a.loc.offset==b.loc.offset;
    #assert a.name==b.name;
    #assert a.name2==b.name2;
    #assert a.loc2.line==b.loc2.line && a.loc2.column==b.loc2.column && a.loc2.offset==b.loc2.offset;
    #assert a.a==b.a;
    #assert a.b==b.b;
    #assert a.c==b.c;
    #assert a.d==b.d;
    #assert a.head==b.head;
    #assert a.tail==b.tail;
    #assert a.next==b.next;
    #assert a.op==b.op;
    #assert a.flag==b.flag;
    #assert a.flag2==b.flag2;
    #assert a.value==b.value;
    #assert a.floating==b.floating;
    #assert a.type==b.type;
    #assert a.field_index==b.field_index;
    #assert a.proc==b.proc;
    #assert a.constant==b.constant;
    #assert a.negative==b.negative;
    #assert a.folded==b.folded;
    #assert a.builtin_print==b.builtin_print;
    #assert a.byte_intrinsic==b.byte_intrinsic;
    #assert a.intrinsic==b.intrinsic;
    #assert a.mark==b.mark;
    #assert a.reached==b.reached;
    #assert a.metal_done==b.metal_done;
    #assert a.metal_active==b.metal_active;
  }
}
#test "checker: error 34" {
