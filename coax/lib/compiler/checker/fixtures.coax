// Checks: arithmetic, characterization fixtures, error fixtures and boundary
// oracles. A part of the checker: lib/compiler/checker.coax loads it (#12646).
#authority;
#test "wide signed arithmetic preserves the full literal domain" {
  one:=CM_from(1,false);two:=CM_from(2,false);negative:=CM_from(1,true);
  #assert CM_low(CM_add(one,two).mag)==3 && !CM_add(one,two).negative;
  #assert CM_low(CM_add(one,negative).mag)==0 && !CM_add(one,negative).negative;
  #assert CM_low(CM_sub(one,two).mag)==1 && CM_sub(one,two).negative;
  #assert CM_low(CM_mul(CM_from(18446744073709551615,false),two).mag)==18446744073709551614;
  #assert CM_mul(CM_from(18446744073709551615,false),two).mag.w[2]==1;
}
#test "IEEE arithmetic is encoded, including nonfinite and subnormal results" {
  #assert CM_float(34,0x3ff0000000000000,0x4000000000000000)==0x4008000000000000;
  #assert CM_float(35,0x3ff0000000000000,0x4000000000000000)==0xbff0000000000000;
  #assert CM_float(36,0x7fefffffffffffff,0x4000000000000000)==0x7ff0000000000000;
  #assert CM_float(37,0x3ff0000000000000,0)==0x7ff0000000000000;
  #assert CM_float(36,1,0x3ff0000000000000)==1;
}
#test "integer range, canonical bits, decimal text and bit operations" {
  negative:=CM_from(128,true);positive:=CM_from(255,false);out:[48] u8;
  #assert CM_fits(negative,8,true) && !CM_fits(negative,8,false) && CM_fits(positive,8,false) && !CM_fits(positive,8,true);
  #assert CM_canon(255,8,true)==18446744073709551615;
  #assert CM_compare(negative,positive)== -1 && CM_raw(negative)==18446744073709551488;
  #assert CM_signed_bits(18446744073709551615,true).negative;
  count:=CM_decimal(negative,out[..]);#assert count==4 && cast(string)out[0..<count]=="-128";
  #assert CM_low(CM_divide(positive,CM_from(10,false),false).mag)==25;
  #assert CM_low(CM_divide(positive,CM_from(10,false),true).mag)==5;
  #assert CM_low(CM_bitwise(39,positive,CM_from(15,false)).mag)==15;
  #assert CM_low(CM_shift(43,negative,1).mag)==64;
  #assert CM_convert(0x3ff0000000000000,CM_Width.f64,CM_Width.f32)==0x3f800000;
  #assert CM_to_float(CM_from(1,true))==0xbff0000000000000;
}
#test "finite division preserves encoded significands" {#assert CM_float(37,0x3ff0000000000000,0x4000000000000000)==0x3fe0000000000000;}

// Characterization fixtures from real parser input. Diagnostics/type pools
// were compared with the prior native checker. These are compatibility
// regressions, not correctness proofs; normative arithmetic/AST tests are separate.
#test "checker: empty library" {
  initial:=[2] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file}];
  nodes:[22] CK_Node;for v,i:initial {nodes[i]=v;}
  types:[22] CK_Type;locals:[18] CK_Local;errors:[32] CK_Error;bytes:[5120] u8;state:[1] CK_State;
  context:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
  ok:=CK_run(context,initial.count-1,CK_Options.{library=true,metal=false,authority=false});
  #assert ok==true && state[0].error_count==0 && state[0].depth==0;
  // The semantic pass restores its scope/depth counters.
  #assert state[0].used==1;
  #assert state[0].type_count==16;
  #assert state[0].composite_count==0;
  #assert state[0].local_count==0;
  #assert state[0].byte_count==0;
  #assert state[0].error_count==0;
  #assert state[0].current==0;
  #assert state[0].constant_depth==0;
  #assert state[0].loop_depth==0;
  #assert state[0].defer_depth==0;
  #assert state[0].unevaluated==0;
  #assert state[0].basic==false;
  #assert state[0].depth==0;
  #assert state[0].fatal==false;
  #assert state[0].metal_depth==0;

  expected:=[2] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file}];
  #assert state[0].used==expected.count-1;
  for i:0..<expected.count {a:=nodes[i];b:=expected[i];
    #assert a.kind==b.kind;
    #assert a.loc.line==b.loc.line && a.loc.column==b.loc.column && a.loc.offset==b.loc.offset;
    #assert a.name==b.name;
    #assert a.name2==b.name2;
    #assert a.loc2.line==b.loc2.line && a.loc2.column==b.loc2.column && a.loc2.offset==b.loc2.offset;
    #assert a.a==b.a;
    #assert a.b==b.b;
    #assert a.c==b.c;
    #assert a.d==b.d;
    #assert a.head==b.head;
    #assert a.tail==b.tail;
    #assert a.next==b.next;
    #assert a.op==b.op;
    #assert a.flag==b.flag;
    #assert a.flag2==b.flag2;
    #assert a.value==b.value;
    #assert a.floating==b.floating;
    #assert a.type==b.type;
    #assert a.field_index==b.field_index;
    #assert a.proc==b.proc;
    #assert a.constant==b.constant;
    #assert a.negative==b.negative;
    #assert a.folded==b.folded;
    #assert a.builtin_print==b.builtin_print;
    #assert a.byte_intrinsic==b.byte_intrinsic;
    #assert a.intrinsic==b.intrinsic;
    #assert a.mark==b.mark;
    #assert a.reached==b.reached;
    #assert a.metal_done==b.metal_done;
    #assert a.metal_active==b.metal_active;
  }
  wanted_types:=[16] CK_Type.[
    CK_Type.{kind=CK_Kind.invalid,name="<invalid>",size=0,alignment=1,bits=0,is_signed=false,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.void_,name="void",size=0,alignment=1,bits=0,is_signed=false,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.bool_,name="bool",size=1,alignment=1,bits=8,is_signed=false,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.string_,name="string",size=16,alignment=8,bits=0,is_signed=false,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.untyped_int,name="integer literal",size=0,alignment=1,bits=0,is_signed=true,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.untyped_float,name="float literal",size=0,alignment=1,bits=0,is_signed=true,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.floating,name="f32",size=4,alignment=4,bits=32,is_signed=true,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.floating,name="f64",size=8,alignment=8,bits=64,is_signed=true,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.integer,name="s8",size=1,alignment=1,bits=8,is_signed=true,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.integer,name="s16",size=2,alignment=2,bits=16,is_signed=true,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.integer,name="s32",size=4,alignment=4,bits=32,is_signed=true,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.integer,name="int",size=8,alignment=8,bits=64,is_signed=true,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.integer,name="u8",size=1,alignment=1,bits=8,is_signed=false,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.integer,name="u16",size=2,alignment=2,bits=16,is_signed=false,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.integer,name="u32",size=4,alignment=4,bits=32,is_signed=false,elem=0,length=0,id=0,decl=0},
    CK_Type.{kind=CK_Kind.integer,name="u64",size=8,alignment=8,bits=64,is_signed=false,elem=0,length=0,id=0,decl=0}];
  #assert state[0].type_count==wanted_types.count;
  for i:0..<wanted_types.count {a:=types[i];b:=wanted_types[i];
    #assert a.kind==b.kind;
    #assert a.name==b.name;
    #assert a.size==b.size;
    #assert a.alignment==b.alignment;
    #assert a.bits==b.bits;
    #assert a.is_signed==b.is_signed;
    #assert a.elem==b.elem;
    #assert a.length==b.length;
    #assert a.decl==b.decl;
    #assert a.id==b.id;
  }
}
#test "checker: entry" {
  initial:=[4] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=2},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=1,column=1,offset=0},name="main",b=3},
