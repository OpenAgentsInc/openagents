    CK_Node.{kind=CK_Tag.stmt_assert,loc=CK_Loc.{line=1,column=10,offset=9},a=5},
    CK_Node.{kind=CK_Tag.expr_bool,loc=CK_Loc.{line=1,column=18,offset=17},value=1}];
  nodes:[34] CK_Node;for v,i:initial {nodes[i]=v;}
