  ok:=CK_run(context,initial.count-1,CK_Options.{library=true,metal=false,authority=false});
  #assert ok==false && state[0].error_count==2 && state[0].type_count==17 && state[0].depth==0 && state[0].generic==0 && state[0].site==CK_Site.none;
  #assert errors[0].code=="E0395" && errors[0].loc.line==1 && errors[0].loc.column==18 && errors[0].message=="a struct field cannot have the type parameter '$T'" && errors[0].fix=="list it in the struct's parameters: S :: struct($T) { ... }";
  #assert errors[1].code=="E0395" && errors[1].loc.line==1 && errors[1].loc.column==28 && errors[1].message=="a struct field cannot have the type parameter '$U'" && errors[1].fix=="list it in the struct's parameters: S :: struct($U) { ... }";
  #assert state[0].used==7 && state[0].instances==0 && state[0].instance_tail==0 && state[0].instance_count==0;
  #assert nodes[3].type==0;
  #assert nodes[5].type==0;
