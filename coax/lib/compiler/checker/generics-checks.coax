    CK_Node.{kind=CK_Tag.field,loc=CK_Loc.{line=1,column=22,offset=21},name="y",a=6,field_index=0},
    CK_Node.{kind=CK_Tag.type_view,loc=CK_Loc.{line=1,column=25,offset=24},b=7},
