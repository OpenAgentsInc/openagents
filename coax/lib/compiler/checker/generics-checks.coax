// Source: "make :: () -> $T { x: $T; return x; }\nother :: (a: $T) { b: $U; }"
#test "generics: a type parameter only in the result, or first in a body, is unbound" {
  initial:=[15] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=9},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=1,column=1,offset=0},name="make",a=3,b=4,next=9},
    CK_Node.{kind=CK_Tag.type_param,loc=CK_Loc.{line=1,column=15,offset=14},name="T"},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=1,column=18,offset=17},head=5,tail=7},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=1,column=20,offset=19},name="x",d=6,next=7},
    CK_Node.{kind=CK_Tag.type_param,loc=CK_Loc.{line=1,column=23,offset=22},name="T"},
    CK_Node.{kind=CK_Tag.stmt_return,loc=CK_Loc.{line=1,column=27,offset=26},a=8},
    CK_Node.{kind=CK_Tag.expr_ident,loc=CK_Loc.{line=1,column=34,offset=33},name="x"},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=2,column=1,offset=38},name="other",b=12,head=10,tail=10},
    CK_Node.{kind=CK_Tag.param,loc=CK_Loc.{line=2,column=11,offset=48},name="a",a=11},
    CK_Node.{kind=CK_Tag.type_param,loc=CK_Loc.{line=2,column=14,offset=51},name="T"},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=2,column=18,offset=55},head=13,tail=13},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=2,column=20,offset=57},name="b",d=14},
    CK_Node.{kind=CK_Tag.type_param,loc=CK_Loc.{line=2,column=23,offset=60},name="U"}];
  nodes:[64] CK_Node;for v,i:initial {nodes[i]=v;}
  types:[64] CK_Type;locals:[31] CK_Local;errors:[136] CK_Error;bytes:[12296] u8;state:[1] CK_State;
  context:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
  ok:=CK_run(context,initial.count-1,CK_Options.{library=true,metal=false,authority=false});
  #assert ok==false && state[0].error_count==3 && state[0].type_count==17 && state[0].depth==0 && state[0].generic==0 && state[0].site==CK_Site.none;
  #assert errors[0].code=="E0392" && errors[0].loc.line==1 && errors[0].loc.column==15 && errors[0].message=="'$T' appears only in the result of 'make'; a parameter must bind it" && errors[0].fix=="add a parameter whose type uses $T, or return a concrete type";
  #assert errors[1].code=="E0393" && errors[1].loc.line==1 && errors[1].loc.column==23 && errors[1].message=="'$T' is not bound by a parameter of 'make'" && errors[1].fix=="use $T in a parameter's type first";
  #assert errors[2].code=="E0393" && errors[2].loc.line==2 && errors[2].loc.column==23 && errors[2].message=="'$U' is not bound by a parameter of 'other'" && errors[2].fix=="use $U in a parameter's type first";
  #assert state[0].used==20 && state[0].instances==0 && state[0].instance_tail==0 && state[0].instance_count==0;
  #assert nodes[2].type==0 && nodes[2].generic==false;
  #assert nodes[5].type==0;
  #assert nodes[7].type==0;
  #assert nodes[8].type==0;
  #assert nodes[9].origin==0 && nodes[9].pristine==15 && nodes[9].chain==0 && nodes[9].key=="" && nodes[9].head==10 && nodes[9].b==12 && nodes[9].reached==false;
  #assert nodes[9].type==1 && nodes[9].generic==true;
  #assert nodes[10].type==16;
  #assert nodes[13].type==0;
  #assert nodes[15].type==0 && nodes[15].generic==false;
  #assert nodes[17].type==0;
  #assert nodes[19].type==0;
  #assert types[16].kind==CK_Kind.param && types[16].name=="$T" && types[16].elem==0 && types[16].decl==9 && types[16].size==0 && types[16].alignment==1 && types[16].bits==0 && types[16].length==0;
