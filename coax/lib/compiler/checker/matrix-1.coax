    CK_Node.{kind=CK_Tag.expr_binary,loc=CK_Loc.{line=8,column=11,offset=152},a=15,b=16,op=46},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=8,column=15,offset=156},head=19,tail=30},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=9,column=5,offset=162},name="next",a=22,next=24},
