// Source: "#import \"Basic\";\n\n// Iterative Fibonacci: locals, while, compound assignment, returns.\nfib :: (n: int) -> int {\n  a := 0;\n  b := 1;\n  i := 0;\n  while i < n {\n    next := a + b;\n    a = b;\n    b = next;\n    i += 1;\n  }\n  return a;\n}\n\nclassify :: (n: int) -> string {\n  if n % 15 == 0 { return \"FizzBuzz\"; }\n  else if n % 3 == 0 { return \"Fizz\"; }\n  else if n % 5 == 0 { return \"Buzz\"; }\n  return \"\";\n}\n\nmain :: () {\n  print(\"fib(%) = %\\n\", 50, fib(50));\n  n := 1;\n  while n <= 15 {\n    word := classify(n);\n    if word == \"\" { print(\"%\\n\", n); } else { print(\"%\\n\", word); }\n    n += 1;\n  }\n  ok: bool = fib(10) == 55 && !(1 > 2);\n  print(\"ok: %, 100%% sure\\n\", ok);\n  scratch: int = ---;\n  scratch = -7 / 2;\n  print(\"% %\\n\", scratch, -7 % 2);\n}\n"
#test "checker matrix 3" {
  initial:=[135] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=68},
    CK_Node.{kind=CK_Tag.import_,loc=CK_Loc.{line=1,column=9,offset=8},name="Basic",next=3},
