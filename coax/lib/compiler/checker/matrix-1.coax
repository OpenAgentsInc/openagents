    CK_Node.{kind=CK_Tag.constant,loc=CK_Loc.{line=5,column=1,offset=132},name="FORWARD",a=10,next=11},
    CK_Node.{kind=CK_Tag.expr_ident,loc=CK_Loc.{line=5,column=12,offset=143},name="LATER"},
    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=5,column=20,offset=151},value=2},
