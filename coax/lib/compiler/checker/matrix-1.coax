// Extended semantic fixtures from real parser inputs; these characterize
// typed records and diagnostics. Independent policy/numeric oracles also apply.
// Source: "// #run builds tables, structs and arrays that are baked into the program.\n#import \"Basic\";\n\nStats :: struct { count: int; largest: int; sum: int = 0; }\n\nsieve :: () -> [64] bool {\n  composite: [64] bool;\n  composite[0] = true;\n  composite[1] = true;\n  for i: 2..<64 {\n    if composite[i] { continue; }\n    j := i * i;\n    while j < 64 { composite[j] = true; j += i; }\n  }\n  return composite;\n}\n\nCOMPOSITE :: #run sieve();\n\nsummarize :: (flags: [] bool) -> Stats {\n  s: Stats;\n  for f, i: flags {\n    if !f { s.count += 1; s.largest = i; s.sum += i; }\n  }\n  return s;\n}\n\nPRIMES_BELOW_64 :: #run summarize_table();\nsummarize_table :: () -> Stats {\n  table := COMPOSITE;\n  return summarize(table[..]);\n}\n\nSQUARES :: #run squares();\nsquares :: () -> [8] u16 {\n  out: [8] u16;\n  for i: 0..<8 { out[i] = cast(u16) (i * i); }\n  return out;\n}\n\n#assert PRIMES_BELOW_64.count == 18;\n#assert SQUARES[7] == 49;\n\nmain :: () {\n  print(\"%\\n\", PRIMES_BELOW_64);\n  print(\"%\\n\", SQUARES);\n  n := 0;\n  for c, i: COMPOSITE { if !c && i > 50 { n += 1; } }\n  print(\"primes in 51..<64: %\\n\", n);\n}\n"
