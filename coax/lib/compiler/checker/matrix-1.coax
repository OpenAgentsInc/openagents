    CK_Node.{kind=CK_Tag.param,loc=CK_Loc.{line=4,column=9,offset=95},name="n",a=5},
    CK_Node.{kind=CK_Tag.type_named,loc=CK_Loc.{line=4,column=12,offset=98},name="int"},
    CK_Node.{kind=CK_Tag.type_named,loc=CK_Loc.{line=4,column=20,offset=106},name="int"},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=4,column=24,offset=110},head=8,tail=32},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=5,column=3,offset=114},name="a",a=9,next=10},
    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=5,column=8,offset=119}},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=6,column=3,offset=124},name="b",a=11,next=12},
