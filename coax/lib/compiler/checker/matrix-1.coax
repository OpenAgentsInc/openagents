// Source: "// expect: E0309\nmain :: () { a: s32 = 1; b: int = 2; c := a + b; }\n"
#test "checker matrix 8" {
  initial:=[14] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=2},
    CK_Node.{kind=CK_Tag.proc,loc=CK_Loc.{line=2,column=1,offset=17},name="main",b=3},
    CK_Node.{kind=CK_Tag.stmt_block,loc=CK_Loc.{line=2,column=12,offset=28},head=4,tail=10},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=2,column=14,offset=30},name="a",a=6,d=5,next=7},
    CK_Node.{kind=CK_Tag.type_named,loc=CK_Loc.{line=2,column=17,offset=33},name="s32"},
    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=2,column=23,offset=39},value=1},
    CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=2,column=26,offset=42},name="b",a=9,d=8,next=10},
