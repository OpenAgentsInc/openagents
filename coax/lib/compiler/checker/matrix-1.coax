// Source: "// Structs with defaults, enums, fixed arrays, views and loops.\n#import \"Basic\";\n\nVec2 :: struct {\n  x: f32;\n  y: f32;\n}\n\nOutcome :: enum u8 { completed; refused = 4; failed; }\n\nBody :: struct {\n  name: string = \"rock\";\n  position: Vec2;\n  velocity: Vec2 = Vec2.{x = 1, y = 0.5};\n  history: [3] s32;\n  outcome: Outcome = Outcome.refused;\n}\n\nstep :: (b: Body, dt: f32) -> Body {\n  next := b;\n  next.position.x += next.velocity.x * dt;\n  next.position.y += next.velocity.y * dt;\n  return next;\n}\n\nsum :: (values: [] int) -> int {\n  total := 0;\n  for v: values { total += v; }\n  return total;\n}\n\ndouble_all :: (values: [] int) {\n  for i: 0..<values.count { values[i] *= 2; }\n}\n\nmain :: () {\n  b: Body;\n  print(\"%\\n\", b);\n  b = step(step(b, 2), 2);\n  b.history[1] = 7;\n  print(\"% %\\n\", b.position, b.history);\n  print(\"% % %\\n\", Outcome.completed, b.outcome, cast(Outcome) 5);\n  print(\"% %\\n\", cast(u8) Outcome.failed, size_of(Body));\n\n  primes := [6] int.[2, 3, 5, 7, 11, 13];\n  print(\"% %\\n\", sum(primes[..]), sum(primes[1..<4]));\n  double_all(primes[2..<5]);\n  print(\"%\\n\", primes);\n  for p, i: primes {\n    if i == 1 { continue; }\n    if p > 20 { break; }\n    print(\"%:% \", i, p);\n  }\n  print(\"\\n\");\n\n  word := \"coaxial\";\n  print(\"% % % %\\n\", word.count, word[0], word[2..<4], word[..]);\n  grid: [2] [3] u8;\n  grid[1][2] = 9;\n  print(\"% %\\n\", grid, grid[1].count);\n  print(\"% %\\n\", ifx b.outcome == Outcome.refused then \"refused\" else \"other\", ifx primes[0] > 3 then 1 else 0);\n}\n"
