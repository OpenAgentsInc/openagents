// Source: "// Sized integers, floats, untyped literals, casts and bit operations.\n#import \"Basic\";\n\n// 32-bit FNV-1a in u64: the product stays below 2^57, so nothing overflows.\nfnv1a :: (text: string) -> u32 {\n  hash: u64 = 2166136261;\n  for byte: text {\n    hash ^= cast(u64) byte;\n    hash = (hash * 16777619) & 0xFFFF_FFFF;\n  }\n  return cast(u32) hash;\n}\n\nmain :: () {\n  small: u8 = 200;\n  big: u64 = 18446744073709551615;\n  neg: s8 = -128;\n  wide := cast(s32) small + 1000;\n  print(\"% % % %\\n\", small, big, neg, wide);\n  print(\"% %\\n\", type_name(wide), type_name(small));\n\n  half := 0.5;\n  third: f32 = 1.0 / 3.0;\n  print(\"% % % %\\n\", half, third, 1.0 / 3.0, 100.0);\n  print(\"% % %\\n\", 2.5e-7, 1e21, -0.25);\n  print(\"% %\\n\", cast(int) 7.9, cast(int) -7.9);\n  print(\"% %\\n\", cast(f64) 3, cast(f32) 16777217);\n\n  mask: u32 = 0xF0F0;\n  print(\"% % % %\\n\", mask & 0xFF, mask | 0xF, mask ^ 0xFFFF, mask >> 4);\n  print(\"% %\\n\", 1 << 40, cast(s16) -1 >> 3);\n  print(\"%\\n\", cast,trunc(u8) 300);\n  print(\"%\\n\", fnv1a(\"coax\"));\n}\n"
