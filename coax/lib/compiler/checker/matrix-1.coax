// Source: "#import \"Basic\";\n\n// Forward constants and procedures resolve before compile-time execution.\nMAX_VISIBLE :: #run visible_budget(4);\nFORWARD :: LATER + 2;\nLATER :: (40);\nLABEL :: #run label(MAX_VISIBLE);\nMINIMUM :: -9223372036854775807 - 1;\nZERO :: MINIMUM % -1;\n\n#assert MAX_VISIBLE == 64;\n#assert FORWARD == 42;\n#assert LABEL == \"dense\";\n#assert type_name(MAX_VISIBLE) == \"int\";\n#assert type_name(LABEL) == \"string\";\n#assert type_name(true) == \"bool\";\n#assert #run factorial(6) == 720;\n#assert #run (true || forbidden());\n#assert #run (false && forbidden()) == false;\n#assert \"a\\0b\" != \"a\";\n\nvisible_budget :: (tiles: int) -> int {\n  count := 0;\n  i := 0;\n  while i < tiles {\n    count += 16;\n    i += 1;\n  }\n  return count;\n}\n\nfactorial :: (n: int) -> int {\n  if n <= 1 { return 1; }\n  return n * factorial(n - 1);\n}\n\nlabel :: (count: int) -> string {\n  if count >= 64 { return \"dense\"; }\n  return \"sparse\";\n}\n\nforbidden :: () -> bool {\n  print(\"must not run\\n\");\n  return false;\n}\n\nmain :: () {\n  local := #run factorial(5);\n  print(\"visible: %, answer: %, label: %, local: %\\n\", MAX_VISIBLE, FORWARD, LABEL, local);\n  print(\"types: %, %, %\\n\", type_name(local), type_name(LABEL), type_name(forbidden()));\n  print(\"runtime: %, %, %\\n\", factorial(5), visible_budget(4), label(64));\n  print(\"min: %, remainder: %\\n\", MINIMUM, ZERO);\n}\n"
#test "checker matrix 4" {
  initial:=[178] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=142},
