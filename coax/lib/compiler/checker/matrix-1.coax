// Source: "// defer at every exit, and left-to-right evaluation of runtime operands.\n#import \"Basic\";\n\nnote :: (label: string, value: int) -> int {\n  print(\"%(%) \", label, value);\n  return value;\n}\n\nfind :: (values: [] int, wanted: int) -> int {\n  print(\"[search \");\n  defer print(\"done] \");\n  for v, i: values {\n    defer print(\".\");\n    if v == wanted { return i; }\n  }\n  return -1;\n}\n\nnested :: () {\n  defer print(\"outer\\n\");\n  {\n    defer print(\"inner-2 \");\n    defer print(\"inner-1 \");\n    print(\"body \");\n  }\n  i := 0;\n  while true {\n    defer print(\"w% \", i);\n    i += 1;\n    if i == 3 { break; }\n  }\n}\n\nmain :: () {\n  values := [4] int.[5, 8, 13, 21];\n  print(\"-> %\\n\", find(values[..], 13));\n  print(\"-> %\\n\", find(values[..], 99));\n  nested();\n  total := note(\"a\", 1) + note(\"b\", 2) * note(\"c\", 3);\n  print(\"= %\\n\", total);\n  pick := values[note(\"i\", 1)] + values[note(\"j\", 2)];\n  print(\"= %\\n\", pick);\n}\n"
