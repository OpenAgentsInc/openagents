    CK_Node.{kind=CK_Tag.expr_int,loc=CK_Loc.{line=8,column=35,offset=237},value=1},
    CK_Node.{kind=CK_Tag.expr_binary,loc=CK_Loc.{line=8,column=33,offset=235},a=19,b=21,op=35},
    CK_Node.{kind=CK_Tag.constant,loc=CK_Loc.{line=9,column=1,offset=240},name="ZERO",a=27,next=28},
    CK_Node.{kind=CK_Tag.expr_ident,loc=CK_Loc.{line=9,column=9,offset=248},name="MINIMUM"},
