// Source: "// The Mandelbrot set in ASCII: f64 arithmetic, nested ranges, ifx.\n#import \"Basic\";\n\nWIDTH :: 72;\nHEIGHT :: 28;\nLIMIT :: 200;\n\n// How many iterations z = z² + c takes to escape, up to LIMIT.\nescape :: (cr: f64, ci: f64) -> int {\n  zr := 0.0;\n  zi := 0.0;\n  for n: 0..<LIMIT {\n    if zr * zr + zi * zi > 4 { return n; }\n    t := zr * zr - zi * zi + cr;\n    zi = 2 * zr * zi + ci;\n    zr = t;\n  }\n  return LIMIT;\n}\n\nSHADES :: \" .:-=+*#%@\";\n\nmain :: () {\n  inside := 0;\n  for row: 0..<HEIGHT {\n    line: [WIDTH] u8;\n    for col: 0..<WIDTH {\n      cr := -2.2 + 3.0 * cast(f64) col / WIDTH;\n      ci := -1.2 + 2.4 * cast(f64) row / HEIGHT;\n      n := escape(cr, ci);\n      if n == LIMIT { inside += 1; }\n      shade := ifx n == LIMIT then 9 else n % 9;\n      line[col] = SHADES[shade];\n    }\n    print(\"%\\n\", cast(string) line[..]);\n  }\n  print(\"% of % points are inside\\n\", inside, WIDTH * HEIGHT);\n}\n"
#test "checker matrix 50" {
  initial:=[143] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=63},
