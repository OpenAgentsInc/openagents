// Source: "// First selected-profile Coax consumer: read the kind from the protobuf Event\n// projection in proto/nostr/event/v1alpha1/event.proto. This does NOT decode\n// signed Nostr JSON, verify identity, decrypt content, or grant authority.\n// Native host lends a valid byte view. The reader never mutates it.\n// Groups and duplicate kind fields are declined in this initial profile.\nProtoBuffer :: struct { bytes: [] u8; }\n\nvar_end :: (buffer:ProtoBuffer,at:int,end:int,maximum:int)->int {\n  cursor:=at;count:=0;\n  while cursor<end && count<maximum {\n    b:=cast(int) buffer.bytes[cursor];\n    if b<0 || b>255 {return -1;}\n    cursor+=1;count+=1;\n    if maximum==10 && count==10 && b>1 {return -1;}\n    if maximum==5 && count==5 && b>15 {return -1;}\n    if b<128 {return cursor;}\n  }\n  return -1;\n}\nvar32 :: (buffer:ProtoBuffer,at:int,end:int)->int {\n  next:=var_end(buffer,at,end,5);if next<0 {return -1;}\n  cursor:=at;value:=0;shift:=0;\n  while cursor<next {\n    value=value | ((cast(int) buffer.bytes[cursor]&127)<<shift);\n    cursor+=1;shift+=7;\n  }\n  return value;\n}\nnostr_projection_kind :: (buffer:ProtoBuffer)->int #export_c {\n  size:=buffer.bytes.count;if size<0 || size>1048576 {return -1;}\n  cursor:=0;kind:=-1;\n  while cursor<size {\n    field:=var32(buffer,cursor,size);next:=var_end(buffer,cursor,size,5);\n    if field<=0 || next<0 || (field>>3)==0 {return -1;}\n    cursor=next;wire:=field & 7;\n    if (field>>3)==4 {\n      if wire!=0 || kind>=0 {return -1;}\n      kind=var32(buffer,cursor,size);if kind<0 || kind>65535 {return -1;}\n    }\n    if wire==0 {cursor=var_end(buffer,cursor,size,10);}\n    else if wire==1 {cursor+=8;}\n    else if wire==5 {cursor+=4;}\n    else if wire==2 {\n      length:=var32(buffer,cursor,size);after:=var_end(buffer,cursor,size,5);\n      if length<0 || after<0 || length>size-after {return -1;}\n      cursor=after+length;\n    } else {return -1;}\n    if cursor<0 || cursor>size {return -1;}\n  }\n  return kind;\n}\n"
#test "checker matrix 51" {
  initial:=[346] CK_Node.[
    CK_Node.{},
    CK_Node.{kind=CK_Tag.file,head=2,tail=155},
