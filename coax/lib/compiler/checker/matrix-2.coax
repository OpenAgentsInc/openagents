// Source: "// Conway's Life on a fixed torus: structs holding arrays, value copies,\n// wrap-around indexing, and enum-labelled patterns.\n#import \"Basic\";\n\nW :: 24;\nH :: 10;\n\nGrid :: struct {\n  cells: [H] [W] bool;\n  generation: int;\n}\n\nPattern :: enum u8 { glider; blinker; block; }\n\nplace :: (g: Grid, p: Pattern, row: int, col: int) -> Grid {\n  out := g;\n  offsets: [5] [2] int;\n  n := 0;\n  if p == Pattern.glider {\n    offsets = [5] [2] int.[[2] int.[0, 1], [2] int.[1, 2], [2] int.[2, 0], [2] int.[2, 1], [2] int.[2, 2]];\n    n = 5;\n  } else if p == Pattern.blinker {\n    offsets[0] = [2] int.[0, 0];\n    offsets[1] = [2] int.[0, 1];\n    offsets[2] = [2] int.[0, 2];\n    n = 3;\n  } else {\n    offsets[0] = [2] int.[0, 0];\n    offsets[1] = [2] int.[0, 1];\n    offsets[2] = [2] int.[1, 0];\n    offsets[3] = [2] int.[1, 1];\n    n = 4;\n  }\n  for o: offsets[0..<n] {\n    out.cells[(row + o[0]) % H][(col + o[1]) % W] = true;\n  }\n  return out;\n}\n\nneighbours :: (g: Grid, row: int, col: int) -> int {\n  count := 0;\n  for dr: -1..<2 {\n    for dc: -1..<2 {\n      if dr == 0 && dc == 0 { continue; }\n      r := (row + dr + H) % H;\n      c := (col + dc + W) % W;\n      if g.cells[r][c] { count += 1; }\n    }\n  }\n  return count;\n}\n\nstep :: (g: Grid) -> Grid {\n  next: Grid;\n  next.generation = g.generation + 1;\n  for row: 0..<H {\n    for col: 0..<W {\n      n := neighbours(g, row, col);\n      next.cells[row][col] = n == 3 || (n == 2 && g.cells[row][col]);\n    }\n  }\n  return next;\n}\n\nshow :: (g: Grid) {\n  alive := 0;\n  for row: g.cells {\n    line: [W] u8;\n    for cell, col: row {\n      line[col] = ifx cell then '#' else '.';\n      if cell { alive += 1; }\n    }\n    print(\"%\\n\", cast(string) line[..]);\n  }\n  print(\"generation %, % alive\\n\\n\", g.generation, alive);\n}\n\nmain :: () {\n  g: Grid;\n  g = place(g, Pattern.glider, 0, 0);\n  g = place(g, Pattern.blinker, 2, 12);\n  g = place(g, Pattern.block, 6, 19);\n  show(g);\n  for i: 0..<4 { g = step(g); }\n  show(g);\n}\n"
