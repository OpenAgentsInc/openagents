 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};
 nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,head=3,b=5};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2,next=4};nodes[4]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};nodes[5].kind=CK_Tag.stmt_block;
 nodes[6]=CK_Node.{kind=CK_Tag.stmt_assign,borrow_owner=2,loc=CK_Loc.{line=89,column=3}};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};r:=CR_Context.{b=b,effects=effects[..],reports=reports[..],state=cr[..]};
 // The first parameter's bytes are stored through the second parameter: one obligation, and no room to stage it.
 src:=[1]BS_Origin.[BS_Origin.{kind=BS_PARAMETER,root=0,role=BS_DESCRIPTOR,type=12}];
 dst:=[1]BS_Origin.[BS_Origin.{kind=BS_PARAMETER,root=1,role=BS_DESCRIPTOR,type=3,path=BS_Path.{count=1}}];dst[0].path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};
 room:[1]RP_Obligation;
 fits:=CR_pairs(r,2,6,12,src[..],true,dst[..],true,room[..],CR_Result.{complete=true,relation=true});
 #assert !state[0].fatal && state[0].error_count==0 && fits.pending==1;
 refused:=CR_pairs(r,2,6,12,src[..],true,dst[..],true,room[0..<0],CR_Result.{complete=true,relation=true});
 #assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==89 && refused.pending==0;
}
