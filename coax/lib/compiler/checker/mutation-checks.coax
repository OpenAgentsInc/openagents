 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 for i:0..<4 {types[16+i]=CK_Type.{kind=CK_Kind.optional,elem=17+i};}types[20]=CK_Type.{kind=CK_Kind.view,elem=12};
 if malformed {types[16]=CK_Type.{kind=CK_Kind.union_,decl=4};nodes[4]=CK_Node.{kind=CK_Tag.union_,head=5};nodes[5]=CK_Node.{kind=CK_Tag.field,type=20};}
 found:=CB_discover(b,16,252,false);
 #assert found==!malformed && state[0].fatal==malformed && state[0].error_count==(ifx malformed then 1 else 0);
}
