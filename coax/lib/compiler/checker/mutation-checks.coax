 nodes[30]=CK_Node.{kind=CK_Tag.expr_call,type=1,proc=20,head=31,borrow_owner=2,loc=CK_Loc.{line=100,column=3}};nodes[31]=CK_Node.{kind=CK_Tag.expr_call,type=16,proc=40,next=32};nodes[32]=CK_Node.{kind=CK_Tag.expr_ident,type=19,borrow_binding=3};
