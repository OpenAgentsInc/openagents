 CR_leaf(r,20,30,16,BS_Path.{});
 if plain {#assert !state[0].fatal && state[0].error_count==0 && cr[0].effects==1;}
 else {#assert !state[0].fatal && state[0].error_count==1 && errors[0].code=="E0383" && errors[0].loc.line==108 && cr[0].effects==0 && work[0].queries==3;}
}
