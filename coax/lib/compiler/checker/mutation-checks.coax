}
#test "a retained pair whose pending obligations do not fit is refused" {
 nodes:[8]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=7,type_count=17}];work:[1]CB_State;queries:[8]CK_BorrowQuery;origins:[8]BS_Origin;effects:[8]CK_RetainEffect;reports:[4]CK_RetainObservation;cr:[1]CR_State;for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};
 nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,head=3,b=5};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2,next=4};nodes[4]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};nodes[5].kind=CK_Tag.stmt_block;
 nodes[6]=CK_Node.{kind=CK_Tag.stmt_assign,borrow_owner=2,loc=CK_Loc.{line=89,column=3}};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};r:=CR_Context.{b=b,effects=effects[..],reports=reports[..],state=cr[..]};
 // The first parameter's bytes are stored through the second parameter: one obligation, and no room to stage it.
 src:=[1]BS_Origin.[BS_Origin.{kind=BS_PARAMETER,root=0,role=BS_DESCRIPTOR,type=12}];
 dst:=[1]BS_Origin.[BS_Origin.{kind=BS_PARAMETER,root=1,role=BS_DESCRIPTOR,type=3,path=BS_Path.{count=1}}];dst[0].path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};
 room:[1]RP_Obligation;
 fits:=CR_pairs(r,2,6,12,src[..],true,dst[..],true,room[..],CR_Result.{complete=true,relation=true});
 #assert !state[0].fatal && state[0].error_count==0 && fits.pending==1;
 refused:=CR_pairs(r,2,6,12,src[..],true,dst[..],true,room[0..<0],CR_Result.{complete=true,relation=true});
 #assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==89 && refused.pending==0;
}
#forall "a retained array write joins its elements exactly when they would pass 64 leaves" length:0..<2 {
 // p[0] = q for q:[N]string with N 64 (one leaf each) or 65 (one joined leaf)
 nodes:[32]CK_Node;types:[24]CK_Type;errors:[8]CK_Error;state:=[1]CK_State.[CK_State.{used=31,type_count=19}];work:[1]CB_State;queries:[256]CK_BorrowQuery;origins:[2048]BS_Origin;effects:[256]CK_RetainEffect;reports:[8]CK_RetainObservation;cr:[1]CR_State;for i:0..<16 {types[i]=CK_builtin(i);}
 n:=ifx length==0 then 64 else 65;types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.array,elem=16,length=n};types[18]=CK_Type.{kind=CK_Kind.view,elem=17};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,head=3,b=5,borrow_writes=10};nodes[3]=CK_Node.{kind=CK_Tag.param,type=18,borrow_owner=2,next=4};nodes[4]=CK_Node.{kind=CK_Tag.param,type=17,borrow_owner=2};nodes[5].kind=CK_Tag.stmt_block;
 nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=18,borrow_binding=3};nodes[7]=CK_Node.{kind=CK_Tag.expr_int,type=11};nodes[8]=CK_Node.{kind=CK_Tag.expr_index,type=17,a=6,b=7};
 nodes[9]=CK_Node.{kind=CK_Tag.expr_ident,type=17,borrow_binding=4};nodes[10]=CK_Node.{kind=CK_Tag.stmt_assign,a=9,c=8,borrow_owner=2,loc=CK_Loc.{line=95,column=3}};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],retain_effects=effects[..],retain_reports=reports[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};r:=CR_Context.{b=b,effects=effects[..],reports=reports[..],state=cr[..]};
 CR_leaf(r,2,10,17,BS_Path.{});
 #assert !state[0].fatal && state[0].error_count==0 && cr[0].leaves==(ifx length==0 then 64 else 1);
}
