#forall "a retained field row is refused when a step past its eight field slots holds an index" corrupt:bool {
 nodes:[8]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=4,type_count=17}];work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=99,column=8}}];queries:[8]CK_BorrowQuery;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.struct_,decl=2,retain_fields=1};nodes[2]=CK_Node.{kind=CK_Tag.struct_,head=3};nodes[3]=CK_Node.{kind=CK_Tag.field,type=3};
 work[0].queries=1;queries[0]=CK_BorrowQuery.{kind=4,decl=16,type=2,status=2,start=0,count=3};queries[0].path.steps[0].index=3;
 if corrupt {queries[0].path.steps[8].index=1;}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],state=work[..],retain_fields=true};
 result:=CB_field(b,16,0);
 if corrupt {#assert result==0 && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==99;}
 else {#assert result==3 && !state[0].fatal && state[0].error_count==0;}
}
#forall "a union's variant past its list or a malformed variant node is refused" pick:0..<4 {
 // pick 0: ordinal 1 of a one-variant union; 1: a variant node of another kind; 2: a variant numbered 1 at ordinal 0; 3: well formed
 nodes:[8]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=7,type_count=18}];work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=102,column=4}}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.union_,decl=4};nodes[4]=CK_Node.{kind=CK_Tag.union_,head=5};
 nodes[5]=CK_Node.{kind=ifx pick==1 then CK_Tag.field else CK_Tag.variant,value=ifx pick==2 then 1 else 0,type=16};
 // A failed walk never reads node 0, even when it looks like the variant asked for.
 if pick==0 {nodes[0]=CK_Node.{kind=CK_Tag.variant,value=1,type=16};}
 got:=CB_variant(b,17,ifx pick==0 then 1 else 0);
 #assert got==(ifx pick==3 then 16 else 0) && state[0].fatal==(pick<3) && state[0].error_count==(ifx pick<3 then 1 else 0);
}
#forall "a null optional's borrow is empty at its variant and refused past it" past:bool {
 nodes:[8]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=7,type_count=18}];work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=103,column=4}}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.optional,elem=16};
 nodes[3]=CK_Node.{kind=CK_Tag.expr_null,type=17,sum_variant=0,loc=CK_Loc.{line=104,column=9}};
 path:=BS_Path.{count=ifx past then 2 else 1};path.steps[0]=BS_Step.{kind=BS_VARIANT,index=0};path.steps[1]=BS_Step.{kind=BS_FIELD,index=0};
 out:[4]BS_Origin;got:=CB_expr(b,3,path,false,out[..]);
 #assert got.count==0 && !got.incomplete && state[0].fatal==past && state[0].error_count==(ifx past then 1 else 0);
