 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.array,elem=16,length=65};types[18]=CK_Type.{kind=CK_Kind.view,elem=12,retain_join=2};
