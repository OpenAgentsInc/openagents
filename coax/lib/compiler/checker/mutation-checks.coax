// checker/b2-r2-checks.coax: its shared fixture. The checks that use it read
// only some of what it builds, so this one holds it to the whole graph.
#test "the B2 fixture builds exactly its documented graph, and reowning moves the caller and its locals" {
 nodes:[96]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};CB2_fixture(c);
 for i:0..<16 {#assert types[i].kind==CK_builtin(i).kind && types[i].name==CK_builtin(i).name && types[i].size==CK_builtin(i).size;}
 #assert state[0].used==95 && state[0].type_count==21;
 #assert types[16].kind==CK_Kind.view && types[16].elem==12;
 #assert types[17].kind==CK_Kind.struct_ && types[17].decl==34;
 #assert types[18].kind==CK_Kind.array && types[18].elem==17 && types[18].length==1;
 #assert types[19].kind==CK_Kind.view && types[19].elem==17;
 #assert types[20].kind==CK_Kind.array && types[20].elem==12 && types[20].length==4;
 #assert nodes[1].kind==CK_Tag.file && nodes[1].head==2;
 #assert nodes[2].kind==CK_Tag.proc && nodes[2].type==16 && nodes[2].head==3 && nodes[2].b==51 && nodes[2].borrow_calls==22 && nodes[2].borrow_returns==10;
 #assert nodes[3].kind==CK_Tag.param && nodes[3].type==16 && nodes[3].next==4 && nodes[3].borrow_owner==2;
 #assert nodes[4].kind==CK_Tag.param && nodes[4].type==16 && nodes[4].borrow_owner==2;
 #assert nodes[8].kind==CK_Tag.stmt_var && nodes[8].type==18 && nodes[8].borrow_owner==2;
 #assert nodes[9].kind==CK_Tag.stmt_var && nodes[9].type==20 && nodes[9].borrow_owner==2;
 #assert nodes[10].kind==CK_Tag.stmt_return && nodes[10].a==11;
 #assert nodes[11].kind==CK_Tag.expr_field && nodes[11].type==16 && nodes[11].a==12 && nodes[11].field_index==0 && nodes[11].loc.line==90 && nodes[11].loc.column==5;
 #assert nodes[12].kind==CK_Tag.expr_index && nodes[12].type==17 && nodes[12].a==24 && nodes[12].b==45;
 #assert nodes[22].kind==CK_Tag.expr_call && nodes[22].type==1 && nodes[22].proc==30 && nodes[22].head==23 && nodes[22].borrow_owner==2;
 #assert nodes[23].kind==CK_Tag.expr_slice && nodes[23].type==19 && nodes[23].a==24 && nodes[23].next==25;
 #assert nodes[24].kind==CK_Tag.expr_ident && nodes[24].type==18 && nodes[24].borrow_binding==8;
 #assert nodes[25].kind==CK_Tag.expr_ident && nodes[25].type==16 && nodes[25].borrow_binding==3 && nodes[25].next==26;
 #assert nodes[26].kind==CK_Tag.expr_slice && nodes[26].type==16 && nodes[26].a==27;
 #assert nodes[27].kind==CK_Tag.expr_ident && nodes[27].type==20 && nodes[27].borrow_binding==9;
 #assert nodes[30].kind==CK_Tag.proc && nodes[30].type==1 && nodes[30].head==31 && nodes[30].b==50 && nodes[30].borrow_writes==40;
 #assert nodes[31].kind==CK_Tag.param && nodes[31].type==19 && nodes[31].next==32 && nodes[31].borrow_owner==30 && nodes[31].borrow_writes==40;
 #assert nodes[32].kind==CK_Tag.param && nodes[32].type==16 && nodes[32].next==33 && nodes[32].borrow_owner==30;
 #assert nodes[33].kind==CK_Tag.param && nodes[33].type==16 && nodes[33].borrow_owner==30;
 #assert nodes[34].kind==CK_Tag.struct_ && nodes[34].head==35;
 #assert nodes[35].kind==CK_Tag.field && nodes[35].type==16 && nodes[35].next==36;
 #assert nodes[36].kind==CK_Tag.field && nodes[36].type==16;
 #assert nodes[40].kind==CK_Tag.stmt_assign && nodes[40].c==42 && nodes[40].a==46 && nodes[40].borrow_owner==30;
 #assert nodes[42].kind==CK_Tag.expr_field && nodes[42].type==16 && nodes[42].a==43 && nodes[42].field_index==0;
 #assert nodes[43].kind==CK_Tag.expr_index && nodes[43].type==17 && nodes[43].a==44 && nodes[43].b==45;
 #assert nodes[44].kind==CK_Tag.expr_ident && nodes[44].type==19 && nodes[44].borrow_binding==31;
 #assert nodes[45].kind==CK_Tag.expr_int && nodes[45].type==11;
 #assert nodes[46].kind==CK_Tag.expr_ident && nodes[46].type==16 && nodes[46].borrow_binding==32 && nodes[46].loc.line==81 && nodes[46].loc.column==24;
 #assert nodes[49].kind==CK_Tag.expr_ident && nodes[49].type==16 && nodes[49].borrow_binding==33;
 #assert nodes[50].kind==CK_Tag.stmt_block;
 #assert nodes[51].kind==CK_Tag.stmt_block;
 CB2_reowner(c,60);
 #assert nodes[60].kind==CK_Tag.proc && nodes[60].head==3 && nodes[60].borrow_calls==22 && nodes[60].borrow_returns==10 && nodes[1].head==60 && nodes[22].borrow_owner==60;
 #assert nodes[3].borrow_owner==60 && nodes[4].borrow_owner==60 && nodes[8].borrow_owner==60 && nodes[9].borrow_owner==60 && nodes[31].borrow_owner==30;
}

// query-projection-cache.coax
#forall "a query projection witness hits only for its own memo, layout, field rows and types" mode:0..<29 {
 // V (node 5) is an S (type 16, declared by node 20, the last node used) whose
 // fields are node 10, an int, and node 11, a [3]int (type 17). The path is
 // V.f1[1]. Row 1 is the query memo, row 2 the field block the cold walk made.
 // expect: 1 the witness hits, 0 it misses, 2 it is refused as a resource error
 expect:=[29]int.[1,0,0,0,0,0,0,1,2,2,2,2,2,2,2,2,1,1,2,1,2,2,0,0,1,0,0,0,0];
 nodes:[24]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=20,type_count=19}];queries:[8]CK_BorrowQuery;origins:[8]BS_Origin;work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=94,column=4},queries=1}];
 for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.struct_,decl=20};types[17]=CK_Type.{kind=CK_Kind.array,elem=12,length=3};
 nodes[5]=CK_Node.{kind=CK_Tag.param,type=16,borrow_query=7};nodes[10]=CK_Node.{kind=CK_Tag.field,type=12,next=11};nodes[11]=CK_Node.{kind=CK_Tag.field,type=17};nodes[20]=CK_Node.{kind=CK_Tag.struct_,head=10};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};
 path:=BS_Path.{count=2};path.steps[0]=BS_Step.{kind=BS_FIELD,index=1};path.steps[1]=BS_Step.{kind=BS_ELEMENT,index=1};
 record:[1]CB_QueryProjection;
 #assert CB_query_project(b,1,5,path,record[..])==12 && !state[0].fatal && work[0].queries==2 && queries[1].kind==4 && queries[1].path.steps[1].index==11 && types[16].retain_fields==2;
 p:=record[0];p.query=1;p.head=7;q:=path;
 #assert p.steps[0].row==2 && p.steps[0].field_head==2 && p.steps[0].field==11 && p.steps[0].next_type==17 && p.steps[1].type==17 && p.type==12;
 if mode==5 {q.steps[0].kind=BS_ELEMENT;}
 if mode>=19 && mode<=21 {q.count=1;q.steps[1]=BS_Step.{};}
 if mode==22 {q.steps[1].kind=BS_FIELD;}
 if mode==23 || mode==24 {q.steps[1].index=2147483647;}
 if mode==25 {q.steps[1].index=3;}
 queries[0]=CK_BorrowQuery.{kind=1,decl=5,status=2,path=q};
 if mode==1 {p.query=3;queries[2]=queries[0];}
 if mode==2 {queries[0].decl=6;}
 if mode==3 {queries[0].kind=2;}
 if mode==4 {p.steps[0].type=17;}
 if mode==6 {p.steps[0].decl=19;}
 if mode==7 {nodes[2]=nodes[20];types[16].decl=2;p.steps[0].decl=2;queries[1].type=2;}
 if mode==8 {nodes[10].kind=CK_Tag.param;}
 if mode==9 {p.steps[0].row=0;}
 if mode==10 {p.steps[0].row=3;queries[2]=queries[1];}
 if mode==11 {p.steps[0].field_head=0;types[16].retain_fields=0;}
 if mode==12 {queries[1].kind=3;}
 if mode==13 {queries[1].path.steps[0].kind=BS_FIELD;}
 if mode==14 {queries[1].path.steps[8].index=5;}
 if mode==15 {nodes[1]=nodes[11];queries[1].path.steps[1].index=1;p.steps[0].field=1;}
 if mode==16 {nodes[2]=nodes[11];queries[1].path.steps[1].index=2;p.steps[0].field=2;}
 if mode==17 {nodes[21]=nodes[11];state[0].used=21;p.used=21;queries[1].path.steps[1].index=21;p.steps[0].field=21;}
 if mode==18 {nodes[11].kind=CK_Tag.param;}
 if mode>=19 && mode<=21 {at:=ifx mode==19 then 1 else ifx mode==20 then 0 else 19;nodes[11].type=at;p.steps[0].next_type=at;p.type=at;}
 if mode==23 || mode==26 {types[17].kind=CK_Kind.view;}
 if mode==27 {p.type=13;}
 if mode==28 {types[17].elem=19;p.type=19;}
 hit:=CB_projection_hit(b,p,1,5,q);
 if expect[mode]==2 {#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==94;}
 else {#assert hit==(expect[mode]==1) && !state[0].fatal && state[0].error_count==0;}
}
#forall "a cold query projection refuses a step its type cannot take and an end type outside the table, and keeps one slot per key" pick:0..<7 {
 // pick 0: a hit fills the record, and committing the same key again reuses its slot;
 // 1: an invalid path; 2: a field step on an array; 3: an element step on a view;
 // 4-6: an array whose element type is 0, 1, or the first past the table
 nodes:[24]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=20,type_count=19}];queries:[8]CK_BorrowQuery;origins:[8]BS_Origin;work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=95,column=4},queries=1}];
 for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.struct_,decl=20};types[17]=CK_Type.{kind=CK_Kind.array,elem=12,length=3};types[18]=CK_Type.{kind=CK_Kind.view,elem=12};
 nodes[5]=CK_Node.{kind=CK_Tag.param,type=16,borrow_query=7};nodes[6]=CK_Node.{kind=CK_Tag.param,type=17};nodes[7]=CK_Node.{kind=CK_Tag.param,type=18};
 nodes[10]=CK_Node.{kind=CK_Tag.field,type=12,next=11};nodes[11]=CK_Node.{kind=CK_Tag.field,type=17};nodes[20]=CK_Node.{kind=CK_Tag.struct_,head=10};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};
 path:=BS_Path.{count=2};path.steps[0]=BS_Step.{kind=BS_FIELD,index=1};path.steps[1]=BS_Step.{kind=BS_ELEMENT,index=1};
 record:[1]CB_QueryProjection;
 if pick==0 {
  queries[0]=CK_BorrowQuery.{kind=1,decl=5,status=2,path=path};
  #assert CB_query_project(b,1,5,path,record[..])==12 && record[0].query==0;CB_projection_commit(b,record[0],1);
  again:[1]CB_QueryProjection;
  #assert CB_query_project(b,1,5,path,again[..])==12 && again[0].query==1 && again[0].decl==5 && work[0].projection_next;
  CB_projection_commit(b,again[0],1);
  #assert work[0].projection_next && work[0].projections[0].query==1 && work[0].projections[1].decl==0 && !state[0].fatal;
  return;
 }
 decl:=ifx pick==1 then 5 else ifx pick==3 then 7 else 6;one:=BS_Path.{count=1};
 if pick==1 {one.steps[0]=BS_Step.{kind=BS_FIELD,index= -1};}
 if pick==2 {one.steps[0]=BS_Step.{kind=BS_FIELD,index=1};}
 if pick>=3 {one.steps[0]=BS_Step.{kind=BS_ELEMENT,index=0};}
 if pick>=4 {types[17].elem=ifx pick==4 then 0 else ifx pick==5 then 1 else 19;}
 got:=CB_query_project(b,1,decl,one,record[..]);
 if pick==5 {#assert got==1 && record[0].type==1 && !state[0].fatal;}
 else {#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==95;}
}
