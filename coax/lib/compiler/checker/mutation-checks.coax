#forall "a write-summary query asks only through a parameter's descriptor, and a storage query reads no writes" pick:0..<2 {
 // Local 8 is a view that the procedure assigns from parameter 3 (write 30).
 // pick 0: a write-summary (kind 5) query of the local through its descriptor is refused;
 // 1: the local's own storage (kind 3) is the local alone.
 nodes:[40]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=39,type_count=17}];queries:[16]CK_BorrowQuery;origins:[64]BS_Origin;work:[1]CB_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};
 nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,head=3,b=5};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};nodes[5].kind=CK_Tag.stmt_block;
 nodes[8]=CK_Node.{kind=CK_Tag.stmt_var,type=16,borrow_owner=2,borrow_writes=30,loc=CK_Loc.{line=106,column=3}};
 nodes[30]=CK_Node.{kind=CK_Tag.stmt_assign,c=31,a=32};nodes[31]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=8};nodes[32]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};
 path:=BS_Path.{count=ifx pick==0 then 1 else 0};path.steps[0]=BS_Step.{kind=ifx pick==0 then BS_DEREFERENCE else 0};
 out:[4]BS_Origin;got:=CB_query(b,ifx pick==0 then cast(u8)5 else cast(u8)3,8,path,out[..]);
 if pick==0 {#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==106;}
 else {#assert !state[0].fatal && state[0].error_count==0 && got.count==1 && !got.incomplete && out[0].kind==BS_LOCAL && out[0].root==8;}
}

