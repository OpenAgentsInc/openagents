#forall "borrow discovery counts one level per nested sum, and finds none past a malformed variant" malformed:bool {
 // malformed: a union whose only variant node is a field. Otherwise four nested
 // optionals around a view, entered at level 252: the innermost is at 255, the
 // last level inside the 256-level limit.
