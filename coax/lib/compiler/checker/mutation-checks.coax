 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,head=3,b=5,borrow_writes=10};nodes[3]=CK_Node.{kind=CK_Tag.param,type=18,borrow_owner=2,next=4};nodes[4]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};nodes[5].kind=CK_Tag.stmt_block;
 nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=18,borrow_binding=3};nodes[7]=CK_Node.{kind=CK_Tag.expr_int,type=11};nodes[8]=CK_Node.{kind=CK_Tag.expr_index,type=17,a=6,b=7};
 nodes[104]=CK_Node.{kind=CK_Tag.expr_slice,type=16,a=105};nodes[107]=CK_Node.{kind=CK_Tag.expr_slice,type=16,a=105};nodes[105]=CK_Node.{kind=CK_Tag.expr_ident,type=19,borrow_binding=106};nodes[106]=CK_Node.{kind=CK_Tag.stmt_var,type=19,borrow_owner=2};
 nodes[108]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=4};nodes[109]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=4};
 nodes[9]=CK_Node.{kind=CK_Tag.expr_struct,type=17,head=60};nodes[60]=CK_Node.{kind=CK_Tag.field_init,field_index=0,a=104,next=61};nodes[61]=CK_Node.{kind=CK_Tag.field_init,field_index=1,a=107};
 nodes[12]=CK_Node.{kind=CK_Tag.expr_struct,type=17,head=62};nodes[62]=CK_Node.{kind=CK_Tag.field_init,field_index=0,a=108,next=63};nodes[63]=CK_Node.{kind=CK_Tag.field_init,field_index=1,a=109};
 nodes[10]=CK_Node.{kind=CK_Tag.stmt_assign,a=9,c=8,borrow_owner=2,loc=CK_Loc.{line=96,column=3}};nodes[11]=CK_Node.{kind=CK_Tag.stmt_assign,a=12,c=8,borrow_owner=2,loc=CK_Loc.{line=97,column=3}};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],retain_effects=effects[..],retain_reports=reports[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};r:=CR_Context.{b=b,effects=effects[..],reports=reports[..],state=cr[..]};
 CR_leaf(r,2,11,17,BS_Path.{});
 #assert !state[0].fatal && state[0].error_count==0 && cr[0].leaves==2 && cr[0].shape.count==2;
