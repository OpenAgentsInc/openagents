#forall "choosing array precision refuses a type outside the table and remembers its answer for one inside" pick:0..<5 {
 // pick 0: negative; 1: past the storage; 2: the first type past the table, whose stale memo says join; 3: void; 4: an array of 65 views
 nodes:[4]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=3,type_count=18}];work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=88,column=6}}];
