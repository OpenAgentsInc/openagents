#test "a callee summary of exactly the maximum 256 effects is applied" #steps 80000000 {
 nodes:[64]CK_Node;types:[18]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=63,type_count=18}];queries:[1024]CK_BorrowQuery;origins:[8192]BS_Origin;work:[1]CB_State;effects:[512]CK_RetainEffect;reports:[4]CK_RetainObservation;rs:=[1]CR_State.[CR_State.{effects=256}];for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.array,elem=3,length=256};types[17]=CK_Type.{kind=CK_Kind.view,elem=16};
 nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,head=3,b=5,borrow_calls=30};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,next=4,borrow_owner=2};nodes[4]=CK_Node.{kind=CK_Tag.param,type=17,borrow_owner=2};nodes[5].kind=CK_Tag.stmt_block;
 nodes[20]=CK_Node.{kind=CK_Tag.proc,type=1,head=21,b=23,retain_head=256,retain_count=256,retain_relation=true};nodes[21]=CK_Node.{kind=CK_Tag.param,type=16,next=22,borrow_owner=20};nodes[22]=CK_Node.{kind=CK_Tag.param,type=17,borrow_owner=20};nodes[23].kind=CK_Tag.stmt_block;
 nodes[30]=CK_Node.{kind=CK_Tag.expr_call,type=1,proc=20,head=31,borrow_owner=2,loc=CK_Loc.{line=98,column=7}};nodes[31]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3,next=32};nodes[32]=CK_Node.{kind=CK_Tag.expr_ident,type=17,borrow_binding=4};
 for i:0..<256 {src:=BS_Origin.{kind=BS_PARAMETER,role=BS_DESCRIPTOR,type=12,path=BS_Path.{count=1}};src.path.steps[0]=BS_Step.{kind=BS_ELEMENT,index=i};dst:=BS_Origin.{kind=BS_PARAMETER,root=1,role=BS_DESCRIPTOR,type=3,path=BS_Path.{count=2}};dst.path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};dst.path.steps[1]=BS_Step.{kind=BS_ELEMENT,index=i};effects[i]=CK_RetainEffect.{source=src,destination=dst,value_type=12,witness=30,next=i};}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};r:=CR_Context.{b=b,effects=effects[..],reports=reports[..],state=rs[..]};CR_apply(r,2,30,false);
 #assert !state[0].fatal && state[0].error_count==0 && nodes[2].retain_count==256 && rs[0].effects==512;
}
