 CK_global_names(c);
 #assert state[0].error_count==1 && errors[0].code=="E0372" && errors[0].loc.line==53 && errors[0].message=="union 'int' conflicts with another declaration or a built-in name";
}
#test "field defaults are checked outside any procedure, which is then restored" {
 nodes:[12]CK_Node;types:[24]CK_Type;locals:[2]CK_Local;errors:[4]CK_Error;bytes:[512]u8;state:=[1]CK_State.[CK_State.{used=8,type_count=17,current=1}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12,size=16,alignment=8,sum_payload_offset=8};
 // S :: struct {x: int = try .{ok=1};}, checked while inside f (node 1), which returns Result(int, u8)
 nodes[2]=CK_Node.{kind=CK_Tag.struct_,name="S",head=3};nodes[3]=CK_Node.{kind=CK_Tag.field,name="x",type=11,b=4};
 nodes[4]=CK_Node.{kind=CK_Tag.expr_try,a=5,loc=CK_Loc.{line=54,column=17}};nodes[5]=CK_Node.{kind=CK_Tag.expr_sum,type=16,a=6,sum_variant=0};nodes[6]=CK_Node.{kind=CK_Tag.expr_int,type=11};
 nodes[1]=CK_Node.{kind=CK_Tag.proc,name="f",type=16};
 CK_defaults(c,2);
 #assert state[0].current==1 && state[0].error_count==1 && errors[0].code=="E0905" && errors[0].loc.line==54 && errors[0].loc.column==17;
}

// literal-projection-cache.coax
#test "the literal projection cache hits in one unit of work and keeps two blocks first in, first out" {
 nodes:[48]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=47,type_count=17}];work:[1]CB_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.struct_,decl=1};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],literal_cache=true};
 // L (node 40) lists fields 9 down to 0 as nodes 11 down to 2: field k is node k+2,
 // and a scan to field k visits 10-k initializers. M (node 41) has one field, node 20.
 for k:0..<10 {nodes[k+2]=CK_Node.{kind=CK_Tag.field_init,field_index=k,next=ifx k==0 then 0 else k+1};}
 nodes[40]=CK_Node.{kind=CK_Tag.expr_struct,type=16,head=11};nodes[41]=CK_Node.{kind=CK_Tag.expr_struct,type=16,head=20};nodes[20]=CK_Node.{kind=CK_Tag.field_init,field_index=0};
 // literal, field, the initializer found, the work it costs
 steps:=[36]int.[40,1,3,9, 40,1,3,1, 40,9,11,1, 40,0,2,10, 40,0,2,1, 41,0,20,1, 40,0,2,10, 40,8,10,2, 40,8,10,1];
 for i:0..<9 {
  before:=work[0].work;got:=CB_literal_field(b,steps[4*i],steps[4*i+1]);
  #assert got==steps[4*i+2] && work[0].work-before==steps[4*i+3] && !state[0].fatal;
 }
 #assert work[0].literal_current.id==40 && work[0].literal_current.block==1 && work[0].literal_previous.id==40 && work[0].literal_previous.block==0;
}
#test "the literal projection cache is off for a negative field and when disabled" {
 nodes:[16]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=17}];work:[1]CB_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.struct_,decl=1};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],literal_cache=false};
 nodes[2]=CK_Node.{kind=CK_Tag.field_init,field_index=1,next=3};nodes[3]=CK_Node.{kind=CK_Tag.field_init,field_index=0};nodes[10]=CK_Node.{kind=CK_Tag.expr_struct,type=16,head=2};
 for i:0..<2 {before:=work[0].work;#assert CB_literal_field(b,10,0)==3 && work[0].work-before==2;}
 #assert work[0].literal_current.id==0 && work[0].literal_previous.id==0;
 b.literal_cache=true;
 for i:0..<2 {before:=work[0].work;#assert CB_literal_field(b,10,-1)==0 && work[0].work-before==2;}
 #assert work[0].literal_current.id==0 && work[0].literal_previous.id==0;
}
#test "the literal projection cache keys a block by its literal, not only its fields" {
 nodes:[48]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=47,type_count=17}];work:[1]CB_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.struct_,decl=1};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],literal_cache=true};
 // nodes 40 and 42 are two literals over the same initializers: field 1 is node 3, after node 2
 nodes[2]=CK_Node.{kind=CK_Tag.field_init,field_index=0,next=3};nodes[3]=CK_Node.{kind=CK_Tag.field_init,field_index=1};
 nodes[40]=CK_Node.{kind=CK_Tag.expr_struct,type=16,head=2};nodes[42]=nodes[40];
 before:=work[0].work;#assert CB_literal_field(b,40,1)==3 && work[0].work-before==2;
 before=work[0].work;#assert CB_literal_field(b,42,1)==3 && work[0].work-before==2;
 before=work[0].work;#assert CB_literal_field(b,40,1)==3 && work[0].work-before==1;
 #assert work[0].literal_current.id==42 && work[0].literal_previous.id==40;
}

// query-index.coax
#test "the query index bucket mixes the origin kind with every step's kind and index" {
 path:=BS_Path.{count=1};path.steps[0]=BS_Step.{kind=BS_ELEMENT,index=5};
 // ((1<<1) ^ 2 ^ 5) & 7 is 5; then ((5<<1) ^ 1 ^ 6) & 7 is 13 & 7, 5
 #assert CB_index_bucket(1,path)==5 && CB_index_bucket(1,BS_Path.{})==1 && CB_index_bucket(5,BS_Path.{})==5;
 path.count=2;path.steps[1]=BS_Step.{kind=BS_FIELD,index=6};
 #assert CB_index_bucket(1,path)==5;
 path.steps[1].index=0;#assert CB_index_bucket(1,path)==3;
}
#forall "the query index admits origin kinds 1 to 3 and 5 only" kind:0..<7 {
 nodes:[8]CK_Node;types:[16]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=7}];work:[1]CB_State;queries:[2]CK_BorrowQuery;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],queries=queries[..]};
 nodes[5]=CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=61,column=2}};work[0].queries=1;
 queries[0]=CK_BorrowQuery.{kind=cast(u8)kind,decl=5,status=1};
 CB_index_probe(b,5,1);
 refused:=kind==0 || kind==4 || kind==6;
 #assert state[0].fatal==refused && work[0].work==1;
 if refused {#assert errors[0].code=="E0381" && errors[0].loc.line==61;}
}
#forall "a published query index snapshot head outside its chain is refused" bad:0..<3 {
 // bad 0: the bucket's head is the chain's head, 1: past it, 2: negative
 nodes:[8]CK_Node;types:[16]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=7}];work:[1]CB_State;queries:[2]CK_BorrowQuery;rw:[16]int;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=rw[..]};b:=CB_Context.{c=c,state=work[..],queries=queries[..]};
 nodes[5]=CK_Node.{kind=CK_Tag.stmt_var,loc=CK_Loc.{line=62,column=2}};work[0].queries=1;
 queries[0]=CK_BorrowQuery.{kind=1,decl=5,status=1};
 // the snapshot for head 1 is published (marker 1); bucket 1 holds the link under test
 rw[9]=1;rw[1]=1;if bad==1 {rw[1]=2;}if bad==2 {rw[1]= -1;}
 link:=CB_index_start(b,5,1,1);
 #assert state[0].fatal==(bad!=0) && link==rw[1];
 if bad!=0 {#assert errors[0].code=="E0381" && errors[0].loc.line==62;}
}

// checker/borrow.coax
#forall "a sum's default projects through its default variant, variant 0 included" pick:0..<4 {
 // pick 0: default 0, path variant 0; 1: default 0, variant 1; 2: default 1, variant 1; 3: no default
 nodes:[16]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=24}];work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=75,column=3}}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[19]=CK_Type.{kind=CK_Kind.struct_,decl=5};
 nodes[5]=CK_Node.{kind=CK_Tag.struct_,head=6};nodes[6]=CK_Node.{kind=CK_Tag.field,type=16,b=7};nodes[7]=CK_Node.{kind=CK_Tag.expr_string,type=16,loc=CK_Loc.{line=74,column=2}};
 types[20]=CK_Type.{kind=CK_Kind.union_,decl=8,sum_default=ifx pick==3 then -1 else ifx pick==2 then 1 else 0};
 nodes[8]=CK_Node.{kind=CK_Tag.union_,head=9};nodes[9]=CK_Node.{kind=CK_Tag.variant,value=0,type=19,next=10};nodes[10]=CK_Node.{kind=CK_Tag.variant,value=1,type=19};
 path:=BS_Path.{count=2};path.steps[0]=BS_Step.{kind=BS_VARIANT,index=ifx pick==0 then 0 else 1};path.steps[1]=BS_Step.{kind=BS_FIELD,index=0};
 out:[64]BS_Origin;got:=CB_default(b,20,path,out[..]);
 #assert got.count==(ifx pick==0 || pick==2 then 1 else 0) && got.incomplete==(pick==3) && !state[0].fatal && state[0].error_count==0;
 if got.count==1 {#assert out[0].kind==BS_STATIC && out[0].root==7;}
}
#forall "a try expression borrows from its operand's success payload: variant 0 of a Result, 1 of an optional" optional:bool {
 nodes:[16]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=24}];work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=76,column=3}}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.result,elem=16,sum_error=12};types[18]=CK_Type.{kind=CK_Kind.optional,elem=16};
 nodes[3]=CK_Node.{kind=CK_Tag.expr_try,type=16,a=4,loc=CK_Loc.{line=77,column=4}};
 nodes[4]=CK_Node.{kind=ifx optional then CK_Tag.expr_some else CK_Tag.expr_sum,type=ifx optional then 18 else 17,sum_variant=ifx optional then 1 else 0,a=5};
 nodes[5]=CK_Node.{kind=CK_Tag.expr_string,type=16,loc=CK_Loc.{line=77,column=9}};
 out:[64]BS_Origin;got:=CB_expr(b,3,BS_Path.{},false,out[..]);
 #assert got.count==1 && !got.incomplete && out[0].kind==BS_STATIC && out[0].root==5 && !state[0].fatal && state[0].error_count==0;
}
#forall "a returned try propagates a Result's error borrow, and nothing through an optional's null" optional:bool {
 nodes:[16]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=19}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};
 types[18]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=16,size=24,alignment=8,sum_payload_offset=8};
 if optional {types[18]=CK_Type.{kind=CK_Kind.optional,elem=16,size=24,alignment=8,sum_payload_offset=8};}
 nodes[2]=CK_Node.{kind=CK_Tag.proc,type=18,head=3,b=6,borrow_returns=4};nodes[3]=CK_Node.{kind=CK_Tag.param,type=18,borrow_owner=2};
 nodes[4]=CK_Node.{kind=CK_Tag.expr_try,type=ifx optional then 16 else 11,a=5,propagate_type=18,loc=CK_Loc.{line=78,column=9}};nodes[5]=CK_Node.{kind=CK_Tag.expr_ident,type=18,borrow_binding=3};nodes[6]=CK_Node.{kind=CK_Tag.stmt_block};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],queries=queries[..],origins=origins[..]};
 path:=BS_Path.{count=1};path.steps[0]=BS_Step.{kind=BS_VARIANT,index=1};out:[4]BS_Origin;r:=CB_query(b,1,2,path,out[..]);
 #assert !state[0].fatal && state[0].error_count==0 && !r.incomplete && r.count==(ifx optional then 0 else 1);
 if !optional {#assert out[0].kind==BS_PARAMETER && out[0].root==0;}
}
#forall "a struct's leaf count is the over-budget 128 once the pass is fatal, out of work, or a field is malformed" mode:0..<4 {
 // mode 0: fatal; 1: retained pass out of work; 2: a field node is not a field; 3: one view leaf
 nodes:[16]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=18}];work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=79,column=2}}];for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.struct_,decl=8};
 nodes[8]=CK_Node.{kind=CK_Tag.struct_,head=9};nodes[9]=CK_Node.{kind=ifx mode==2 then CK_Tag.stmt_var else CK_Tag.field,type=16};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],retain_fields=mode==1};
 if mode==0 {state[0].fatal=true;}if mode==1 {work[0].work=2097152;}
 #assert CB_leaf_count(b,17)==(ifx mode==3 then 1 else 128);
 #assert state[0].error_count==(ifx mode==1 || mode==2 then 1 else 0);
}
#test "a retained pass asks a sum payload's borrow presence through its memo when counting leaves" {
 nodes:[16]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=19}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[18]=CK_Type.{kind=CK_Kind.optional,elem=16,size=24,alignment=8,sum_payload_offset=8};
 nodes[2]=CK_Node.{kind=CK_Tag.proc,type=18,b=6,borrow_returns=4};nodes[4]=CK_Node.{kind=CK_Tag.stmt_return,a=5};
 nodes[5]=CK_Node.{kind=CK_Tag.expr_some,type=18,sum_variant=1,a=7};nodes[6]=CK_Node.{kind=CK_Tag.stmt_block};nodes[7]=CK_Node.{kind=CK_Tag.expr_string,type=16};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],queries=queries[..],origins=origins[..],retain_fields=true};
 leaves:=[1]int.[0];
 #assert CB_leaves(b,2,18,BS_Path.{},leaves[..]) && leaves[0]==1 && !state[0].fatal && state[0].error_count==0;
 #assert types[16].retain_presence==2 && types[1].retain_presence==1;
}

