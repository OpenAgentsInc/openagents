#forall "choosing array precision refuses a type outside the table and remembers its answer for one inside" pick:0..<5 {
 // pick 0: negative; 1: past the storage; 2: the first type past the table, whose stale memo says join; 3: void; 4: an array of 65 views
 nodes:[4]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=3,type_count=18}];work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=88,column=6}}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.array,elem=16,length=65};types[18]=CK_Type.{kind=CK_Kind.view,elem=12,retain_join=2};
 types_at:=[5]int.[-1,20,18,1,17];type:=types_at[pick];
 got:=CR_join_arrays(b,type);
 if pick<3 {#assert !got && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==88;}
 else {#assert got==(pick==4) && !state[0].fatal && state[0].error_count==0 && types[type].retain_join==cast(u8)(ifx pick==4 then 2 else 1);}
}
#test "a retained pair whose pending obligations do not fit is refused" {
