 nodes[8]=CK_Node.{kind=CK_Tag.expr_struct,type=16,head=50};nodes[50]=CK_Node.{kind=CK_Tag.field_init,field_index=0,a=60};nodes[60]=CK_Node.{kind=CK_Tag.expr_string,type=3,name="static"};nodes[10]=CK_Node.{kind=CK_Tag.stmt_assign,a=8,c=7,borrow_owner=20,loc=CK_Loc.{line=107,column=3}};
 for i:0..<1280 {scratch[i]=7777;}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],bytes=bytes[..],state=state[..],retain_effects=effects[..],retain_reports=reports[..],result_work=scratch[..]};
