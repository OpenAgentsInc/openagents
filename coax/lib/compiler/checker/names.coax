 if variant==4 || variant==5 {nodes[32]=CK_Node.{kind=CK_Tag.expr_ident,name=ifx variant==4 then "a" else "z",loc=at};nodes[30]=CK_Node.{kind=CK_Tag.expr_field,name=ifx variant==4 then "K" else "U",a=32,loc=CK_Loc.{line=9,column=5,offset=78}};t=CK_expr(c,30,CK_Hint.{});}
 if variant==18 {nodes[33]=CK_Node.{kind=CK_Tag.expr_ident,name="b",loc=at};nodes[32]=CK_Node.{kind=CK_Tag.expr_field,name="F",a=33};nodes[30]=CK_Node.{kind=CK_Tag.expr_field,name="q",a=32};t=CK_expr(c,30,CK_Hint.{});}
 if variant==6 || variant==7 {nodes[33]=CK_Node.{kind=CK_Tag.expr_ident,name=ifx variant==6 then "b" else "z",loc=at};nodes[32]=CK_Node.{kind=CK_Tag.expr_field,name=ifx variant==6 then "E" else "F",a=33};nodes[30]=CK_Node.{kind=CK_Tag.expr_field,name=ifx variant==6 then "p" else "q",a=32};t=CK_expr(c,30,CK_Hint.{});}
 if variant==8 || variant==14 {nodes[30]=CK_Node.{kind=CK_Tag.expr_ident,name="g",name2=ifx variant==8 then "a" else "",loc=at};t=CK_expr(c,30,CK_Hint.{});}
