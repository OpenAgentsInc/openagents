 nodes[9]=CK_Node.{kind=CK_Tag.struct_,name="U",scope=0,type=19,next=10};
 nodes[10]=CK_Node.{kind=CK_Tag.enum_,name="F",scope=0,head=11,type=20};nodes[11]=CK_Node.{kind=CK_Tag.member,name="q",value=4};
 CK_collisions(c,false);at:=CK_Loc.{line=9,column=4,offset=77};
 // the use: node 30, its parts 31.., a missing argument 35
