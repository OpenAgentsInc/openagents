 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,name="identity",head=3,a=4,b=6};nodes[3]=CK_Node.{kind=CK_Tag.param,name="input",a=4};nodes[4]=CK_Node.{kind=CK_Tag.type_named,name="string"};nodes[6]=CK_Node.{kind=CK_Tag.stmt_block,head=7};nodes[7]=CK_Node.{kind=CK_Tag.stmt_return,a=8};nodes[8]=CK_Node.{kind=CK_Tag.expr_ident,name="input"};
 #assert CK_run(c,8,CK_Options.{library=true}) && state[0].error_count==0 && nodes[2].borrow_status==1;
 #assert CK_run(c,8,CK_Options.{library=true}) && state[0].error_count==0 && nodes[2].borrow_status==1 && nodes[8].borrow_binding==3;
}

