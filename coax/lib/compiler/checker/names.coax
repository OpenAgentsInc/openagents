 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.member,name="z",scope=1,next=3};
 nodes[3]=CK_Node.{kind=kinds[variant%4],name="v",scope=1,next=4};nodes[4]=CK_Node.{kind=CK_Tag.constant,name="w",scope=2};
 names:=[6] string.["v","v","v","v","w","z"];
 exports:=[2] CK_Export.[CK_Export.{scope=1,name=names[variant],loc=CK_Loc.{line=3,column=9}},CK_Export.{scope=1,name="v",loc=CK_Loc.{line=4,column=2}}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..],modules=modules[..],exports=exports[0..<ifx variant<2 then 2 else 1],names=index[..]};
 if indexed {#assert CK_index_names(c,7);}CK_exports_valid(c);
 counts:=[6] int.[1,1,0,0,1,1];#assert state[0].error_count==counts[variant];
 if variant<2 {#assert errors[0].code=="E0391" && errors[0].message=="'v' is already exported" && errors[0].fix=="list each name once" && errors[0].loc.line==4;}
 if variant>=4 {#assert errors[0].code=="E0390" && errors[0].loc.line==3 && errors[0].loc.column==9 && errors[0].message==CK_join3(c,"module 'a' exports '",names[variant],"', which it does not declare") && errors[0].fix=="export only the module's own declarations; reexports are not supported";}
}
#forall "qualified and unqualified bindings at the original use" variant:0..<12, indexed:bool {
 nodes:[16]CK_Node;index:[48]int;types:[16]CK_Type;locals:[2]CK_Local;errors:[2]CK_Error;bytes:[512]u8;state:=[1]CK_State.[CK_State.{type_count=16}];
 modules:=[4] string.["","a","b","c"];
 aliases:=[3] CK_Alias.[CK_Alias.{scope=0,name="a",target=1},CK_Alias.{scope=0,name="b",target=2},CK_Alias.{scope=2,name="c",target=3}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..],modules=modules[..],aliases=aliases[..],names=index[..]};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};
 nodes[2]=CK_Node.{kind=CK_Tag.struct_,name="V",scope=1,next=3};nodes[3]=CK_Node.{kind=CK_Tag.struct_,name="V",scope=2,next=4};
 nodes[4]=CK_Node.{kind=CK_Tag.enum_,name="E",scope=2};
 names:=[12] string.["V","V","V","V","Z","E","E","E","V","c","V","W"];
 quals:=[12] string.["a","b","","zz","a","b","","a","","b","",""];
 scopes:=[12] int.[0,0,1,0,0,0,0,0,2,0,0,0];
 nodes[9]=CK_Node.{kind=CK_Tag.type_named,name=names[variant],name2=quals[variant],scope=scopes[variant],loc=CK_Loc.{line=7,column=3,offset=40}};
 if variant==10 {nodes[2].scope=3;}
 if indexed {#assert CK_index_names(c,15);}CK_collisions(c,false);kinds:=[2] CK_Tag.[CK_Tag.struct_,CK_Tag.enum_];
 ok:=CK_bind_check(c,9,kinds[..],"type");
 good:=[12] bool.[true,true,true,false,false,true,true,false,true,false,false,true];
 #assert ok==good[variant] && state[0].error_count==ifx ok then 0 else 1;
 found:=[12] int.[2,3,2,0,0,0,0,0,3,0,0,0];
 #assert CK_lookup(c,CK_Tag.struct_,9)==found[variant];
 if variant==5 || variant==6 {#assert CK_lookup(c,CK_Tag.enum_,9)==4;}
 if !ok {e:=errors[0];#assert e.loc.line==7 && e.loc.column==3 && e.loc.offset==40;}
 if variant==3 {#assert errors[0].code=="E0384" && errors[0].message=="unknown module alias 'zz'" && errors[0].fix=="load it first: #load \"FILE.coax\" as zz;";}
 if variant==4 {#assert errors[0].code=="E0385" && errors[0].message=="module 'a' has no type 'Z'";}
 if variant==7 {#assert errors[0].code=="E0385" && errors[0].message=="module 'a' has no type 'E'";}
 if variant==9 {#assert errors[0].code=="E0388" && errors[0].message=="'b.c' reaches through another module's alias; aliases are not reexported" && errors[0].fix=="load that module here with its own alias";}
 if variant==10 {#assert errors[0].code=="E0386" && errors[0].message=="'V' is declared by both 'c' and 'b'" && errors[0].fix=="qualify it with a module alias: alias.V";}
}
