 nodes[4]=CK_Node.{kind=CK_Tag.struct_,name="V",scope=scopes[variant],next=5};nodes[5]=CK_Node.{kind=CK_Tag.struct_,name="V",scope=scopes[variant],next=6};
 nodes[6]=CK_Node.{kind=CK_Tag.struct_,name="V",scope=ifx variant==2 then 0 else 2,next=7};nodes[7]=CK_Node.{kind=CK_Tag.struct_,name="V",scope=1};
 nodes[9]=CK_Node.{kind=CK_Tag.type_named,name="V",scope=3};if indexed {#assert CK_index_names(c,11);}CK_collisions(c,false);
 kinds:=[1] CK_Tag.[CK_Tag.struct_];#assert !CK_bind_check(c,9,kinds[..],"type") && errors[0].code=="E0386";
 msgs:=[3] string.["'V' is declared by both 'the unowned program' and 'b'","'V' is declared by both 'a' and 'b'","'V' is declared by both 'b' and 'the unowned program'"];
