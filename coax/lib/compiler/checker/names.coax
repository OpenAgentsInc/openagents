   nodes[34]=CK_Node.{kind=CK_Tag.field_init,name="x",a=35};nodes[30]=CK_Node.{kind=CK_Tag.expr_struct,d=31,loc=at};if variant==10 {nodes[30].head=34;nodes[30].tail=34;}t=CK_expr(c,30,CK_Hint.{});}
 if variant==11 || variant==12 {nodes[30]=CK_Node.{kind=CK_Tag.expr_call,name="g",name2=ifx variant==11 then "a" else "zz",loc=at};if variant==12 {nodes[30].head=35;nodes[30].tail=35;}t=CK_expr(c,30,CK_Hint.{});}
 want:=[19] int.[16,17,19,0,3,0,18,20,0,17,0,11,0,0,0,17,0,0,0];
 errs:=[19] int.[0,0,0,1,0,1,0,0,1,0,2,0,2,1,1,0,1,1,1];
 #assert t==want[variant] && state[0].error_count==errs[variant];
 codes:=[19] string.["","","","E0385","","E0354","","","E0305","","E0384","","E0384","E0354","E0386","","E0388","E0388","E0385"];
 if errs[variant]>0 {hit:=false;for i:0..<state[0].error_count {hit=hit || (errors[i].code==codes[variant] && errors[i].loc.line==9 && errors[i].loc.column==4);}#assert hit;}
 if variant==4 {n:=nodes[30];#assert n.kind==CK_Tag.expr_ident && n.name=="K" && n.name2=="a" && n.loc.column==4 && n.loc.offset==77 && n.a==CK_NONE && n.constant==6;}
 if variant==6 || variant==7 {#assert nodes[30].kind==CK_Tag.expr_enum && nodes[30].value==cast(u64)(variant-3) && nodes[32].type==want[variant];}
 if variant==8 {#assert errors[0].fix=="call it: a.g()";}
