 types[16]=CK_Type.{kind=CK_Kind.struct_,name="V",decl=2};types[17]=CK_Type.{kind=CK_Kind.struct_,name="V",decl=3};
 types[18]=CK_Type.{kind=CK_Kind.enum_,name="E",decl=7,elem=12,size=1,bits=8};types[19]=CK_Type.{kind=CK_Kind.struct_,name="U",decl=9};types[20]=CK_Type.{kind=CK_Kind.enum_,name="F",decl=10,elem=12,size=1,bits=8};
