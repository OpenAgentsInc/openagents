// Intrinsics, diagnostics text, nesting depth, the name index, lookup,
// modules, visibility and qualified binding. A part of the checker:
// lib/compiler/checker.coax loads it (#12646).
#authority;
CK_intrinsic :: (name:string)->u32 #export_c {names:=[10] string.["sin","cos","tan","exp","log","sqrt","floor","abs","pow","fma"];for x,i:names {if x==name {return cast(u32)(i+1);}}return CK_NONE;}
CK_byte_intrinsic :: (name:string)->u32 #export_c {names:=[12] string.["bytes_overlap","f32_from_bits","f64_from_bits","f32_bits","f64_bits","value_barrier","add_wrap","sub_wrap","mul_wrap","rotl","rotr","mul_wide"];for x,i:names {if x==name {return cast(u32)(i+1);}}return CK_NONE;}
#test "return borrow reused input rebuilds constant bindings actual call lists and procedure statuses" {
 nodes:[64]CK_Node;types:[64]CK_Type;locals:[64]CK_Local;errors:[16]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.constant,name="Text",a=3,next=4};nodes[3]=CK_Node.{kind=CK_Tag.expr_string,name="literal"};nodes[4]=CK_Node.{kind=CK_Tag.proc,name="text",a=5,b=6,next=9};nodes[5]=CK_Node.{kind=CK_Tag.type_named,name="string"};nodes[6]=CK_Node.{kind=CK_Tag.stmt_block,head=7};nodes[7]=CK_Node.{kind=CK_Tag.stmt_return,a=8};nodes[8]=CK_Node.{kind=CK_Tag.expr_ident,name="Text"};nodes[9]=CK_Node.{kind=CK_Tag.proc,name="owned",a=10,b=11};nodes[10]=CK_Node.{kind=CK_Tag.type_named,name="int"};nodes[11]=CK_Node.{kind=CK_Tag.stmt_block,head=12};nodes[12]=CK_Node.{kind=CK_Tag.stmt_return,a=13};nodes[13]=CK_Node.{kind=CK_Tag.expr_int,value=1};
 for i:1..<14 {nodes[i].borrow_binding=31;nodes[i].borrow_owner=31;nodes[i].borrow_writes=31;nodes[i].borrow_returns=31;nodes[i].borrow_calls=31;nodes[i].borrow_next=31;nodes[i].borrow_status=2;}
 #assert CK_run(c,13,CK_Options.{library=true}) && !state[0].fatal && state[0].error_count==0;
 #assert nodes[8].kind==CK_Tag.expr_ident && nodes[8].constant==2 && nodes[8].borrow_binding==0;
 #assert nodes[4].borrow_calls==0 && nodes[4].borrow_returns==7 && nodes[4].borrow_status==1 && nodes[7].borrow_owner==4;
 #assert nodes[9].borrow_calls==0 && nodes[9].borrow_returns==12 && nodes[9].borrow_status==0 && nodes[12].borrow_owner==9;
}
#test "return borrow reused identity graph rebuilds only applicable binding and procedure metadata" {
 nodes:[64]CK_Node;types:[64]CK_Type;locals:[64]CK_Local;errors:[16]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,name="identity",head=3,a=4,b=6};nodes[3]=CK_Node.{kind=CK_Tag.param,name="input",a=4};nodes[4]=CK_Node.{kind=CK_Tag.type_view,b=5};nodes[5]=CK_Node.{kind=CK_Tag.type_named,name="u8"};nodes[6]=CK_Node.{kind=CK_Tag.stmt_block,head=7};nodes[7]=CK_Node.{kind=CK_Tag.stmt_return,a=8};nodes[8]=CK_Node.{kind=CK_Tag.expr_ident,name="input"};
 for i:1..<9 {nodes[i].borrow_binding=31;nodes[i].borrow_owner=31;nodes[i].borrow_writes=31;nodes[i].borrow_returns=31;nodes[i].borrow_calls=31;nodes[i].borrow_next=31;nodes[i].borrow_status=2;}
 #assert CK_run(c,8,CK_Options.{library=true}) && !state[0].fatal && state[0].error_count==0;
 #assert nodes[8].borrow_binding==3 && nodes[3].borrow_owner==2 && nodes[7].borrow_owner==2;
 #assert nodes[2].borrow_calls==0 && nodes[2].borrow_returns==7 && nodes[2].borrow_status==1;
}

#test "return borrow a second complete check does not reuse the previous invocation memo" {
