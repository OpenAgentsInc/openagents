 tq:=[19] string.["a","b","z","a","","","","","","b","zz","","","","","x","a","b",""];
 if tn[variant]!="" {nodes[31]=CK_Node.{kind=CK_Tag.type_named,name=tn[variant],name2=tq[variant],loc=at};if variant==15 {nodes[31].scope=1;}}
 t:=CK_NONE;
