 nodes:[40]CK_Node;index:[78]int;types:[24]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[2048]u8;state:=[1]CK_State.[CK_State.{}];
 modules:=[4] string.["","a","b","c"];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..],modules=modules[..],names=index[0..<ifx indexed then 78 else 0]};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};
 nodes[2]=CK_Node.{kind=CK_Tag.struct_,name="V",scope=1,next=3,loc=CK_Loc.{line=2}};nodes[3]=CK_Node.{kind=CK_Tag.struct_,name="V",scope=2,next=4,loc=CK_Loc.{line=3}};
 nodes[4]=CK_Node.{kind=CK_Tag.proc,name="g",scope=1,b=20,next=5,loc=CK_Loc.{line=4}};nodes[5]=CK_Node.{kind=CK_Tag.proc,name="g",scope=2,b=21,next=6,loc=CK_Loc.{line=5}};
 nodes[6]=CK_Node.{kind=CK_Tag.constant,name="K",scope=1,a=22,next=7};nodes[7]=CK_Node.{kind=CK_Tag.constant,name="K",scope=2,a=23,next=8};
 nodes[8]=CK_Node.{kind=CK_Tag.proc,name="main",scope=0,b=24,next=9};nodes[9]=CK_Node.{kind=CK_Tag.enum_,name="W",scope=3,head=10,next=11};nodes[10]=CK_Node.{kind=CK_Tag.member,name="w"};
 nodes[11]=CK_Node.{kind=CK_Tag.proc,name="solo",scope=1,b=25};
 for b:20..<26 {nodes[b]=CK_Node.{kind=CK_Tag.stmt_block};}
 nodes[22]=CK_Node.{kind=CK_Tag.expr_string,name="x"};nodes[23]=CK_Node.{kind=CK_Tag.expr_string,name="y"};
 library:=variant==1;
 if variant==2 {nodes[5].scope=1;}
 if variant==3 {nodes[7].scope=1;}
 if variant==4 {nodes[7].name="g";nodes[7].scope=3;}
 if variant==5 {nodes[7].name="g";nodes[7].scope=1;}
 if variant==6 {nodes[9].name="g";}
 if variant==7 {nodes[9].scope=2;nodes[9].name="g";}
 if variant==8 {nodes[4].flag=true;}
 if variant==9 {nodes[9].name="V";}
 if variant==10 {nodes[9].name="K";}
 ok:=CK_run(c,25,CK_Options.{library=library});
 codes:=[11] string.["","E0387","E0334","E0345","","E0345","","E0372","E0387","",""];
 counts:=[11] int.[0,2,1,1,0,1,0,1,1,0,0];
 #assert ok==(counts[variant]==0) && state[0].error_count==counts[variant];
 for i:0..<state[0].error_count {#assert errors[i].code==codes[variant];}
 if variant==0 || variant==6 || variant==9 {
  #assert types[nodes[2].type].name=="a.V" && types[nodes[3].type].name=="b.V" && types[nodes[2].type].scope==1 && types[nodes[3].type].scope==2;
  #assert nodes[4].collides && nodes[5].collides && !nodes[8].collides && !nodes[11].collides && nodes[6].collides && nodes[7].collides;
  #assert CK_clashes(c,CK_Tag.constant,"K") && CK_clashes(c,CK_Tag.proc,"g") && !CK_clashes(c,CK_Tag.proc,"solo") && !CK_clashes(c,CK_Tag.struct_,"g");
  if variant==9 {#assert nodes[9].collides && types[nodes[9].type].name=="c.V" && types[nodes[9].type].scope==3;}
  else {#assert types[nodes[9].type].name==nodes[9].name && types[nodes[9].type].scope==0 && !nodes[9].collides;}
 }
 if variant==1 {#assert errors[0].message=="type 'V' is declared by more than one module, and a C library header spells types by name" && errors[0].loc.line==2 && errors[1].loc.line==3;}
 if variant==8 {#assert errors[0].message=="C symbol 'g' is declared by more than one module" && errors[0].fix=="rename one; #export_c and #foreign names are global C symbols" && errors[0].loc.line==4;}
}
#test "a colliding declaration of the unowned program keeps its spelling" {
 nodes:[8]CK_Node;types:[20]CK_Type;locals:[2]CK_Local;errors:[2]CK_Error;bytes:[256]u8;state:=[1]CK_State.[CK_State.{type_count=18}];
 modules:=[2] string.["","a"];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..],modules=modules[..]};
 types[16]=CK_Type.{kind=CK_Kind.struct_,name="V"};types[17]=CK_Type.{kind=CK_Kind.struct_,name="V"};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.struct_,name="V",type=16,next=3};nodes[3]=CK_Node.{kind=CK_Tag.struct_,name="V",scope=1,type=17,next=4};
 nodes[4]=CK_Node.{kind=CK_Tag.proc,name="V",scope=1};
 CK_collisions(c,false);
 #assert nodes[2].collides && nodes[3].collides && !nodes[4].collides && types[16].name=="V" && types[16].scope==0 && types[17].name=="a.V" && types[17].scope==1;
}
#test "the unowned program and out-of-range scopes have no module name" {
 nodes:[2]CK_Node;types:[16]CK_Type;locals:[2]CK_Local;errors:[2]CK_Error;bytes:[64]u8;state:=[1]CK_State.[CK_State.{}];
 modules:=[2] string.["","verse.hud"];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..],modules=modules[..]};
 #assert CK_module_name(c,1)=="verse.hud" && CK_module_name(c,0)=="the unowned program";
 #assert CK_module_name(c,2)=="the unowned program" && CK_module_name(c,-1)=="the unowned program";
}
#forall "a local shadows an alias; only a plain name qualifies" variant:0..<5 {
 nodes:[4]CK_Node;types:[16]CK_Type;locals:[2]CK_Local;errors:[2]CK_Error;bytes:[64]u8;state:=[1]CK_State.[CK_State.{type_count=16}];
 aliases:=[1] CK_Alias.[CK_Alias.{scope=1,name="hud",target=2}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..],aliases=aliases[..]};
 nodes[2]=CK_Node.{kind=CK_Tag.expr_ident,name="hud",scope=1};
 if variant==1 {CK_declare(c,"hud",11,CK_Loc.{},"");}
 if variant==2 {nodes[2].kind=CK_Tag.expr_call;}
 if variant==3 {nodes[2].name2="x";}
 if variant==4 {nodes[2].scope=0;}
 #assert CK_qualifier(c,2)==ifx variant==0 then 2 else -1;
}
