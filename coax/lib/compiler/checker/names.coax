 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};
 nodes[2]=CK_Node.{kind=CK_Tag.struct_,name="Q",scope=4,next=3};nodes[3]=CK_Node.{kind=CK_Tag.proc,name="V",scope=4,next=4};
