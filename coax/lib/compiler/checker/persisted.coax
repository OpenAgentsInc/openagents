// Saved and wire records own their values. Descriptors never become durable.
#authority;
#forall "persisted records recursively refuse either kind of borrowed view" readonly: bool, wrapped: 0..<4 {
  types: [21] CK_Type; nodes: [8] CK_Node;
  state := [1] CK_State.[CK_State.{type_count=21, used=7}];
  c := CK_Context.{types=types[..], nodes=nodes[..], state=state[..]};
  for i: 0..<16 { types[i] = CK_builtin(i); }
  types[16] = CK_Type.{kind=CK_Kind.view, elem=11, length=ifx readonly then 1 else 0};
  types[17] = CK_Type.{kind=CK_Kind.optional, elem=16};
  types[18] = CK_Type.{kind=CK_Kind.array, elem=17, length=2};
  types[19] = CK_Type.{kind=CK_Kind.struct_, decl=1};
  nodes[1] = CK_Node.{kind=CK_Tag.struct_, head=2}; nodes[2] = CK_Node.{kind=CK_Tag.field, type=18};
  #assert !CK_persisted_type(c, 16 + wrapped);
  types[16] = CK_Type.{kind=CK_Kind.integer, bits=64};
  #assert CK_persisted_type(c, 16 + wrapped);
  #assert !CK_persisted_type(c, 5) && !CK_persisted_type(c, 0);
}
#test "persisted sums inspect every payload; unresolved and process-local handles refuse" {
  types: [22] CK_Type; nodes: [8] CK_Node;
  state := [1] CK_State.[CK_State.{type_count=22, used=7}];
  modules:=[2]string.["","coax.handle"];
  c := CK_Context.{types=types[..], nodes=nodes[..], state=state[..],modules=modules[..]};
  for i: 0..<16 { types[i] = CK_builtin(i); }
  types[16] = CK_Type.{kind=CK_Kind.result, elem=11, sum_error=12};
  #assert CK_persisted_type(c,16); types[16].sum_error=5; #assert !CK_persisted_type(c,16);
  types[17]=CK_Type.{kind=CK_Kind.union_,decl=1};nodes[1]=CK_Node.{head=2};nodes[2]=CK_Node.{type=11,next=3};nodes[3]=CK_Node.{type=12};
  #assert CK_persisted_type(c,17);nodes[3].type=5;#assert !CK_persisted_type(c,17);
  types[18]=CK_Type.{kind=CK_Kind.array,elem=11,length= -1};#assert !CK_persisted_type(c,18);
  types[19]=CK_Type.{kind=CK_Kind.param};#assert !CK_persisted_type(c,19);
  types[20]=CK_Type.{kind=CK_Kind.struct_,decl=4};nodes[4]=CK_Node.{name="Handle",scope=1};#assert !CK_persisted_type(c,20);
  nodes[4].scope=0;#assert CK_persisted_type(c,20);nodes[4].scope=2;#assert CK_persisted_type(c,20);nodes[4].scope=1;
  types[21]=CK_Type.{kind=CK_Kind.enum_};#assert CK_persisted_type(c,21);
  nodes[4].name="StableId";#assert CK_persisted_type(c,20);
}
#forall "persisted validation inspects only marked concrete records and reports the offending field" marked: bool, generic: bool, bad: bool {
  types:[17]CK_Type;nodes:[8]CK_Node;errors:[4]CK_Error;bytes:[1024]u8;
  state:=[1]CK_State.[CK_State.{type_count=17,used=7}];
  c:=CK_Context.{types=types[..],nodes=nodes[..],errors=errors[..],bytes=bytes[..],state=state[..]};
  for i:0..<16 {types[i]=CK_builtin(i);}
  nodes[1]=CK_Node.{kind=CK_Tag.proc,flag=true};
  nodes[2]=CK_Node.{kind=CK_Tag.struct_,flag=marked,generic=generic,head=3};
  nodes[3]=CK_Node.{kind=CK_Tag.field,type=11,next=4};
  nodes[4]=CK_Node.{kind=CK_Tag.field,type=ifx bad then 5 else 12,loc=CK_Loc.{line=7,column=3,offset=50}};
  nodes[5]=CK_Node.{kind=CK_Tag.struct_,flag=true};
  CK_persisted_validate(c);
  expected:=marked && !generic && bad;
  #assert state[0].error_count==(ifx expected then 1 else 0) && !state[0].fatal;
  if expected {#assert errors[0].code=="E0970" && errors[0].loc.line==7 && errors[0].loc.column==3 && errors[0].loc.offset==50;}
}
#forall "persisted validation includes both endpoint nodes" first:bool {
  types:[17]CK_Type;nodes:[9]CK_Node;errors:[4]CK_Error;bytes:[2048]u8;
  state:=[1]CK_State.[CK_State.{type_count=17,used=7}];
  c:=CK_Context.{types=types[..],nodes=nodes[..],errors=errors[..],bytes=bytes[..],state=state[..]};
  for i:0..<16 {types[i]=CK_builtin(i);}
  types[16]=CK_Type.{kind=CK_Kind.array,elem=11,length=0};
  at:=ifx first then 1 else 7;
  nodes[at]=CK_Node.{kind=CK_Tag.struct_,flag=true,head=8};nodes[8]=CK_Node.{kind=CK_Tag.field,type=16};
  CK_persisted_validate(c);#assert state[0].error_count==0;
  nodes[8].type=5;CK_persisted_validate(c);#assert state[0].error_count==1 && errors[0].code=="E0970";
}

// CK_run calls this after layout has admitted the complete value graph.
// Such a graph is finite: a recursive record can recur only through a view,
// which refuses immediately. No second recursion budget changes that contract.
CK_persisted_type :: (c: CK_Context, type: int) -> bool #effects(all) {
  t := c.types[type];
  if t.kind==CK_Kind.integer || t.kind==CK_Kind.floating || t.kind==CK_Kind.bool_ || t.kind==CK_Kind.enum_ || t.kind==CK_Kind.void_ { return true; }
  if t.kind==CK_Kind.optional { return CK_persisted_type(c,t.elem); }
  if t.kind==CK_Kind.result { return CK_persisted_type(c,t.elem) && CK_persisted_type(c,t.sum_error); }
  if t.kind==CK_Kind.array { return t.length>=0 && CK_persisted_type(c,t.elem); }
  if t.kind==CK_Kind.struct_ || t.kind==CK_Kind.union_ {
    n:=c.nodes[t.decl];
    if t.kind==CK_Kind.struct_ && n.name=="Handle" && n.scope<c.modules.count && c.modules[n.scope]=="coax.handle" { return false; }
    f:=c.nodes[t.decl].head;
    while f!=CK_NONE { if !CK_persisted_type(c,c.nodes[f].type) { return false; } f=c.nodes[f].next; }
    return true;
  }
  return false;
}
CK_persisted_validate :: (c: CK_Context) #effects(all) {
  for id: 1..<c.state[0].used+1 {
    n:=c.nodes[id];
    if n.kind==CK_Tag.struct_ && n.flag && !n.generic {
      field:=n.head;
      while field!=CK_NONE {
        f:=c.nodes[field];
        if !CK_persisted_type(c,f.type) { CK_error(c,f.loc,"E0970","a #persisted field must own its values; views and process-local handles cannot be saved","use fixed storage, an optional owned value or a stable ID"); }
        field=f.next;
      }
    }
  }
}
// An aborted allocation must not publish a reference to a generation whose
// allocation is being undone. Explicit numeric encoding remains a codec's
// responsibility; the ordinary typed error channel cannot carry IDs or views.
#forall "transaction errors own values and cannot leak a rolled-back identity" shape:0..<8 {
  types:[18]CK_Type;nodes:[6]CK_Node;state:=[1]CK_State.[CK_State.{type_count=18,used=5}];
  c:=CK_Context.{types=types[..],nodes=nodes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
  types[16]=CK_Type.{kind=CK_Kind.struct_,decl=1};nodes[1]=CK_Node.{head=2};nodes[2]=CK_Node.{type=11};
  if shape==1 {nodes[1].quantity=3;}if shape==2 {nodes[1].quantity=4;}
  if shape==3 {nodes[2].type=5;}
  if shape==4 {types[16]=CK_Type.{kind=CK_Kind.array,elem=11,length=2};}
  if shape==5 {types[16]=CK_Type.{kind=CK_Kind.optional,elem=5};}
  if shape==6 {types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};}
  if shape==7 {types[16]=CK_Type.{kind=CK_Kind.union_,decl=1};nodes[2].type=5;}
  #assert CK_transaction_error_type(c,16)==(shape==0 || shape==4 || shape==6);
  #assert CK_transaction_error_type(c,1) && CK_transaction_error_type(c,2) && CK_transaction_error_type(c,11) && CK_transaction_error_type(c,12);
  types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=5};#assert !CK_transaction_error_type(c,16);
  types[16].elem=5;types[16].sum_error=11;#assert !CK_transaction_error_type(c,16);
  types[17]=CK_Type.{kind=CK_Kind.enum_};#assert CK_transaction_error_type(c,17);
}
CK_transaction_error_type :: (c:CK_Context,type:int)->bool #effects(reads,traps) {
  t:=c.types[type];
  if t.kind==CK_Kind.integer || t.kind==CK_Kind.floating || t.kind==CK_Kind.bool_ || t.kind==CK_Kind.void_ || t.kind==CK_Kind.enum_ {return true;}
  if t.kind==CK_Kind.array || t.kind==CK_Kind.optional {return CK_transaction_error_type(c,t.elem);}
  if t.kind==CK_Kind.result {return CK_transaction_error_type(c,t.elem) && CK_transaction_error_type(c,t.sum_error);}
  if t.kind==CK_Kind.struct_ || t.kind==CK_Kind.union_ {
    n:=c.nodes[t.decl];if n.quantity==3 || n.quantity==4 {return false;}
    field:=n.head;while field!=0 {if !CK_transaction_error_type(c,c.nodes[field].type) {return false;}field=c.nodes[field].next;}
    return true;
  }
  return false;
}
