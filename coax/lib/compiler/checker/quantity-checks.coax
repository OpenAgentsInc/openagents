#forall "quantity lowering preserves every resolved operand field and result kind" family:0..<3,operation:0..<17 {
  nodes:[256]CK_Node;types:[96]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_quantity_fixture(c);
  op:=34+operation;left:=19;right:=19;if family==1 {right=7;}if family==2 {left=7;}
  nodes[10].type=left;nodes[11].type=right;nodes[10].kind=ifx left==7 then CK_Tag.expr_float else CK_Tag.expr_struct;nodes[11].kind=ifx right==7 then CK_Tag.expr_float else CK_Tag.expr_struct;nodes[12].op=cast(u32)op;
  valid:=ifx family==0 then op==34 || op==35 || (op>=44 && op<=49) else op==36 || (family==1 && op==37);
  result:=CK_quantity_binary(c,12,left,right);
  if !valid {#assert result==0 && state[0].error_count==1 && errors[0].code=="E0824" && errors[0].loc.line==73 && errors[0].loc.column==9 && errors[0].loc.offset==123;}
  else {
    comparison:=op>=44;raw:=12;
    if comparison {#assert result==2 && nodes[12].kind==CK_Tag.expr_binary;}
    else {#assert result==19 && nodes[12].kind==CK_Tag.expr_struct && nodes[12].mark==1;field:=nodes[12].head;#assert nodes[field].name=="value" && nodes[field].field_index==0;raw=nodes[field].a;}
    #assert nodes[12].next==18 && nodes[12].loc.line==73 && nodes[12].loc.column==9 && nodes[12].loc.offset==123;
    #assert nodes[raw].kind==CK_Tag.expr_binary && nodes[raw].op==cast(u32)op && nodes[raw].type==(ifx comparison then 2 else 7);
    for side:0..<2 {operand:=ifx side==0 then nodes[raw].a else nodes[raw].b;original:=10+side;ty:=ifx side==0 then left else right;
      if ty==7 {#assert operand==original;}else {#assert nodes[operand].kind==CK_Tag.expr_field && nodes[operand].a==original && nodes[operand].name=="value" && nodes[operand].field_index==0 && nodes[operand].type==7;}
    }
  }
}
