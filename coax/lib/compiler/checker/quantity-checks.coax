 #assert ratio!=one && CK_unit_form(c,ratio).count==2 && CK_unit_form(c,one).count==0;
}
#forall "derived unit metadata and concrete-type refusals precede publication" variant:0..<8 {
 nodes:[256]CK_Node;types:[96]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[8192]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_quantity_fixture(c);
 left:=16;right:=22;divide:=false;
 if variant==0 {left=7;}if variant==1 {left=18;}if variant==2 {nodes[2].unit.numerator=0;}
 if variant==3 {nodes[2].unit.length=8;}
 if variant==4 {nodes[2].unit.length= -8;divide=true;}
 if variant==5 {nodes[2].unit.length=0;nodes[16].unit.length=0;nodes[2].unit.numerator=1048576;nodes[16].unit.numerator=1048576;}
 if variant==6 {nodes[2].generic=true;}if variant==7 {nodes[2].quantity=0;}
 r:=CK_unit_compose(c,left,right,divide,CK_Loc.{line=15,column=3,offset=99});
 #assert r==0 && state[0].error_count==1 && state[0].unit_units==0 && state[0].instance_count==0;
 #assert errors[0].loc.line==15 && errors[0].loc.column==3 && errors[0].loc.offset==99;
 if variant<3 || variant>=6 {#assert errors[0].code=="E0830" && errors[0].message=="derived units require concrete @unit tags";}
 else {#assert errors[0].code=="E0829";if variant==5 {#assert errors[0].message=="derived unit scale exceeds the reduced metadata bound";}else {#assert errors[0].message=="derived unit dimensions exceed -8 through 8";}}
}
#forall "derived unit allocation refusal returns none before unit cache publication" variant:0..<7 {
 nodes:[256]CK_Node;types:[96]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[8192]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_quantity_fixture(c);
 form:=UF_product(UF_atom(16).form,UF_atom(22).form).form;
 if variant==0 {c.nodes=nodes[0..<21];}
 if variant==1 {c.types=types[0..<23];}
 if variant==2 {c.bytes=bytes[0..<0];}
 if variant==3 {state[0].instance_count=256;}
 if variant==4 {c.nodes=nodes[0..<23];}
 metadata:=Q_Unit.{length=2,numerator=1,denominator=1};
 if variant>=5 {form=UF_one();metadata.length=0;if variant==5 {c.nodes=nodes[0..<21];}else {c.types=types[0..<23];}}
 r:=CK_unit_intern(c,form,metadata,CK_Loc.{});
 #assert r==0 && state[0].unit_units==0 && state[0].error_count==1;
 if variant!=3 {#assert state[0].instance_count==0;}
 if variant==3 {#assert errors[0].code=="E0339";}else {#assert errors[0].code=="E0381" && state[0].fatal;}
}


