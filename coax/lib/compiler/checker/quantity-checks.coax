 #assert a!=0 && b!=0 && a!=b && !UF_equal(CK_unit_form(c,a),CK_unit_form(c,b));
 x:=nodes[types[a].decl].unit;y:=nodes[types[b].decl].unit;
 #assert x.mass==y.mass && x.length==y.length && x.time==y.time && x.angle==y.angle && x.numerator==y.numerator && x.denominator==y.denominator;
