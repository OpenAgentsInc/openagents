// Checks: quantities and derived units, with their fixture. A part of the
// checker: lib/compiler/checker.coax loads it (#12646).
#authority;
#test "quantity checker lowers typed scalars without changing carrier or source order" {
  nodes:[256]CK_Node;types:[96]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:=[1]CK_State.[CK_State.{used=20,type_count=22}];
  c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
  nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.struct_,name="Metre",quantity=1,type=16,next=3,unit=Q_Unit.{length=1,numerator=1,denominator=1}};
  types[16]=CK_Type.{kind=CK_Kind.struct_,name="Metre",decl=2,size=1,alignment=1};
  nodes[3]=CK_Node.{kind=CK_Tag.struct_,name="Quantity",quantity=2,generic=true,type=17,d=4,head=6,mark=2};
  nodes[4]=CK_Node.{kind=CK_Tag.type_param,name="U",next=5};nodes[5]=CK_Node.{kind=CK_Tag.type_param,name="R"};nodes[6]=CK_Node.{kind=CK_Tag.field,name="value",a=7,type=18};nodes[7]=CK_Node.{kind=CK_Tag.type_param,name="R"};
  types[17]=CK_Type.{kind=CK_Kind.struct_,name="Quantity",decl=3};types[18]=CK_Type.{kind=CK_Kind.param,name="$R",decl=3,need=4};
  nodes[8]=CK_Node.{kind=CK_Tag.struct_,name="Quantity",quantity=2,origin=3,head=9,type=19};nodes[9]=CK_Node.{kind=CK_Tag.field,name="value",type=7};
  types[19]=CK_Type.{kind=CK_Kind.struct_,name="Quantity(Metre,f64)",decl=8};types[20]=CK_Type.{kind=CK_Kind.param,name="$U",decl=8,elem=16};types[21]=CK_Type.{kind=CK_Kind.param,name="$R",decl=8,elem=7};
  CK_quantity_layout(c,3);CK_quantity_layout(c,8);#assert state[0].error_count==0 && types[19].carrier==7 && types[19].unit==16;
  nodes[10]=CK_Node.{kind=CK_Tag.expr_struct,mark=1,type=19};nodes[11]=nodes[10];nodes[12]=CK_Node.{kind=CK_Tag.expr_binary,op=34,a=10,b=11};
  #assert CK_quantity_binary(c,12,19,19)==19 && nodes[12].kind==CK_Tag.expr_struct;
  raw:=nodes[nodes[12].head].a;#assert nodes[raw].op==34 && nodes[nodes[raw].a].a==10 && nodes[nodes[raw].b].a==11;
  nodes[13]=CK_Node.{kind=CK_Tag.expr_ident,name="Metre",next=14};nodes[14]=CK_Node.{kind=CK_Tag.expr_struct,mark=1,type=19};nodes[15]=CK_Node.{kind=CK_Tag.expr_call,name="convert_unit",head=13};
  converted:=CK_quantity_convert(c,15);#assert converted!=0 && types[converted].carrier==7 && types[converted].unit==16 && state[0].error_count==0;
}

