  nodes:[256]CK_Node;types:[96]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_quantity_fixture(c);
  representation:=ifx precision==0 then 6 else 7;types[19].carrier=representation;nodes[9].type=representation;types[21].elem=representation;
  sn:=[5]int.[1,1,3,2,1048576];sd:=[5]int.[1048576,2,6,1,1];tn:=[5]int.[1048576,1,1,1,1];td:=[5]int.[1,1,2,1,1048576];bits:=[5]u64.[0x3d70000000000000,0x3fe0000000000000,0,0x4000000000000000,0x4270000000000000];
  nodes[2].unit.numerator=sn[test];nodes[2].unit.denominator=sd[test];nodes[16].unit.numerator=tn[test];nodes[16].unit.denominator=td[test];
  result:=CK_quantity_convert(c,15);#assert result!=0 && types[result].carrier==representation && types[result].unit==22 && state[0].error_count==0;
  #assert nodes[15].kind==CK_Tag.expr_struct && nodes[15].mark==1 && nodes[15].next==18 && nodes[15].loc.line==83 && nodes[15].loc.column==7 && nodes[15].loc.offset==223 && nodes[15].type==result && nodes[15].head==nodes[15].tail;
  field:=nodes[15].head;#assert nodes[field].kind==CK_Tag.field_init && nodes[field].name=="value" && nodes[field].field_index==0 && nodes[field].loc.line==83 && nodes[field].loc.column==7 && nodes[field].loc.offset==223;raw:=nodes[field].a;projection:=raw;
  if test==2 {#assert nodes[raw].kind==CK_Tag.expr_field;}
  else {#assert nodes[raw].kind==CK_Tag.expr_binary && nodes[raw].op==36 && nodes[raw].type==representation;projection=nodes[raw].a;coefficient:=nodes[raw].b;#assert nodes[coefficient].kind==CK_Tag.expr_float && nodes[coefficient].type==representation && nodes[coefficient].floating==bits[test];}
  #assert nodes[projection].kind==CK_Tag.expr_field && nodes[projection].name=="value" && nodes[projection].field_index==0 && nodes[projection].a==14 && nodes[projection].type==representation && nodes[projection].loc.line==0 && nodes[projection].loc.column==0 && nodes[projection].loc.offset==0;
}
