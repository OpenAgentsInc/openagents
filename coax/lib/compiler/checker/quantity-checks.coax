  nodes:[256]CK_Node;types:[96]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_quantity_fixture(c);small:=c;
  if mode==0 {small.nodes=nodes[0..<capacity];}if mode==1 {small.types=types[0..<capacity+2];}
