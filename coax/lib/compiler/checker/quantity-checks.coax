  nodes:[256]CK_Node;types:[96]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_quantity_fixture(c);small:=c;small.nodes=nodes[0..<capacity];result:=0;
  if operation==0 {result=CK_quantity_raw(small,10);}if operation==1 {result=CK_quantity_wrap(small,12,11,19);}if operation==2 {nodes[12].op=34;nodes[12].b=10;result=CK_quantity_binary(small,12,19,19);}if operation==3 {result=CK_quantity_target(small,19,22,CK_Loc.{});}if operation==4 {nodes[12].op=44;nodes[12].b=10;result=CK_quantity_binary(small,12,19,19);}
  if state[0].fatal {#assert result==0 && errors[0].code=="E0381";}else {#assert result!=0;}
}
#forall "quantity conversion resolves qualified target in its owning module before a local shadow" variant:0..<4 {
 nodes:[256]CK_Node;types:[96]CK_Type;locals:[16]CK_Local;errors:[16]CK_Error;bytes:[8192]u8;state:[1]CK_State;
 aliases:=[1]CK_Alias.[CK_Alias.{scope=1,name="u",target=2}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..],aliases=aliases[..]};CK_quantity_fixture(c);
 // Two same-spelled, valid unit tags make loss of qualification observable.
 nodes[16].scope=2;nodes[16].next=17;nodes[17]=CK_Node.{kind=CK_Tag.struct_,name="Target",scope=1,quantity=1,type=23,next=3,unit=Q_Unit.{length=1,numerator=1,denominator=2}};
 types[23]=CK_Type.{kind=CK_Kind.struct_,name="Target",decl=17,size=1,alignment=1};state[0].type_count=24;state[0].clashes=17;
 nodes[15].scope=1;nodes[13]=CK_Node.{kind=CK_Tag.expr_field,name="Target",scope=1,a=18,next=14};nodes[18]=CK_Node.{kind=CK_Tag.expr_ident,name="u",scope=1};
 if variant==1 {nodes[18].kind=CK_Tag.expr_float;}
 if variant==2 {nodes[13].kind=CK_Tag.expr_ident;}
 if variant==3 {nodes[13].kind=CK_Tag.expr_ident;nodes[13].name2="u";}
 result:=CK_quantity_convert(c,15);
 if variant==1 {#assert result==CK_NONE && state[0].error_count==1 && errors[0].code=="E0825" && errors[0].message=="convert_unit target must name an @unit type";}
 else {#assert result!=CK_NONE && !state[0].fatal && state[0].error_count==0;want:=22;if variant==2 {want=23;}#assert types[result].unit==want && types[result].carrier==7;}
}

