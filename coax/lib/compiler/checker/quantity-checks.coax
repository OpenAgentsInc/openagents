 nodes[16].unit=Q_Unit.{time=1,numerator=1,denominator=1};loc:=CK_Loc.{line=9,column=7,offset=123};
 p:=CK_unit_compose(c,16,22,false,loc);d:=types[p].decl;n:=nodes[d];
 #assert n.kind==CK_Tag.struct_ && n.name=="CoaxUnit" && n.origin==d && n.mark==2 && n.quantity==1 && n.unit_generated;
 #assert n.scope==3 && n.key=="f16_2147483648_22_2147483648_" && n.unit_link==0 && n.head==0 && n.d==0 && n.type==p;
 #assert n.loc.line==9 && n.loc.column==7 && n.loc.offset==123;
 #assert types[p].kind==CK_Kind.struct_ && types[p].scope==3 && types[p].size==1 && types[p].alignment==1;
 #assert types[p].name=="UnitForm(Metre^1,Target^1)" && state[0].unit_units==d && state[0].instances==d && state[0].instance_tail==d && state[0].instance_count==1;
 first:=n.unit_form;last:=nodes[first].next;#assert first!=0 && last!=0 && nodes[last].next==0;
 #assert nodes[first].kind==CK_Tag.unit_factor && nodes[first].a==16 && nodes[first].b==1 && nodes[last].kind==CK_Tag.unit_factor && nodes[last].a==22 && nodes[last].b==1;
 #assert nodes[first].loc.offset==123 && nodes[last].loc.offset==123;
 used:=state[0].used;count:=state[0].type_count;byte_count:=state[0].byte_count;
 #assert CK_unit_compose(c,22,16,false,loc)==p && state[0].used==used && state[0].type_count==count && state[0].byte_count==byte_count && state[0].instance_count==1;
 one:=CK_unit_compose(c,16,16,true,loc);od:=types[one].decl;
