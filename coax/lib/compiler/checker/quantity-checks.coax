#test "derived unit forms intern nominal products, cancel and keep dimensionless quantity units" {
 nodes:[1024]CK_Node;types:[256]CK_Type;locals:[16]CK_Local;errors:[16]CK_Error;bytes:[32768]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_quantity_fixture(c);
 nodes[16].unit=Q_Unit.{time=1,numerator=1,denominator=1};loc:=CK_Loc.{line=9,column=7,offset=123};
 p:=CK_unit_compose(c,16,22,false,loc);#assert p!=0 && state[0].error_count==0;
 f:=CK_unit_form(c,p);#assert f.count==2 && f.atoms[0]==16 && f.atoms[1]==22 && f.powers[0]==1 && f.powers[1]==1;
 #assert CK_unit_compose(c,22,16,false,loc)==p && CK_unit_compose(c,p,22,true,loc)==16;
 q:=CK_unit_compose(c,16,22,true,loc);#assert types[q].name=="UnitForm(Metre^1,Target^-1)";
 one:=CK_unit_compose(c,16,16,true,loc);#assert one!=0 && CK_unit_form(c,one).count==0;
 #assert CK_unit_compose(c,one,16,false,loc)==16 && CK_unit_compose(c,p,p,true,loc)==one;
 #assert nodes[types[p].decl].unit.length==1 && nodes[types[p].decl].unit.time==1 && nodes[types[p].decl].unit.numerator==1;
 #assert types[p].size==1 && types[p].alignment==1 && nodes[types[p].decl].quantity==1;
}
