#forall "derived constructor arity diagnostics and identity type are explicit" variant:0..<6 {
 nodes:[512]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_quantity_fixture(c);state[0].used=24;
 names:=[6]string.["UnitOne","UnitOne","UnitProduct","UnitProduct","UnitQuotient","UnitQuotient"];
 counts:=[6]int.[0,1,0,1,2,3];nodes[21]=CK_Node.{kind=CK_Tag.type_named,name=names[variant],loc=CK_Loc.{line=77,column=9,offset=123}};
 nodes[22]=CK_Node.{kind=CK_Tag.type_named,name="Metre"};nodes[23]=CK_Node.{kind=CK_Tag.type_named,name="Target"};nodes[24]=CK_Node.{kind=CK_Tag.type_named,name="Metre"};
 if counts[variant]>0 {nodes[21].head=22;}if counts[variant]>1 {nodes[22].next=23;}if counts[variant]>2 {nodes[23].next=24;}
 r:=CK_unit_type(c,21);
 if variant==0 {#assert r!=0 && state[0].error_count==0 && types[r].name=="UnitOne";}
 else if variant==4 {#assert r!=0 && state[0].error_count==0 && CK_unit_form(c,r).count==2;}
 else {#assert r==0 && state[0].error_count==1 && errors[0].code=="E0830" && errors[0].loc.offset==123;
   if variant==1 {#assert errors[0].message=="UnitOne takes no type arguments";}else {#assert errors[0].message=="unit product or quotient takes two unit type arguments";}}
}
#forall "derived constructor form capacity and power errors retain exact profile" variant:0..<3 {
 nodes:[1024]CK_Node;types:[256]CK_Type;locals:[16]CK_Local;errors:[16]CK_Error;bytes:[32768]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_quantity_fixture(c);
 for i:0..<9 {ty:=23+i;d:=21+i;name:=CK_join2(c,"U",CK_count(c,i));nodes[d]=CK_Node.{kind=CK_Tag.struct_,name=name,type=ty,quantity=1,mark=2,unit=Q_Unit.{numerator=1,denominator=1}};types[ty]=CK_Type.{kind=CK_Kind.struct_,name=name,decl=d,size=1,alignment=1};}state[0].used=29;state[0].type_count=32;
 form:=UF_one();form.count=8;for i:0..<8 {form.atoms[i]=23+i;form.powers[i]=1;}
 if variant==1 {form=UF_atom(23).form;form.powers[0]=1073741824;}
 left:=CK_unit_intern(c,form,Q_Unit.{numerator=1,denominator=1},CK_Loc.{});#assert left!=0;
 right:=31;if variant!=0 {right=left;}
 r:=CK_unit_compose(c,left,right,variant==2,CK_Loc.{line=19,column=4,offset=99});
 if variant==2 {#assert r!=0 && state[0].error_count==0 && CK_unit_form(c,r).count==0;}
 else {#assert r==0 && state[0].error_count==1 && errors[0].code=="E0831" && errors[0].loc.offset==99;
   if variant==0 {#assert errors[0].message=="derived unit exceeds eight nominal atoms";}else {#assert errors[0].message=="derived nominal atom power exceeds the signed-31-bit profile";}}
}
