  result:=CK_quantity_convert(small,15);
  if state[0].fatal || state[0].error_count>0 {#assert result==0 && (errors[0].code=="E0381" || errors[0].code=="E0339");}
  else {#assert result!=0 && types[result].carrier==7 && types[result].unit==22;}
}
#forall "quantity family shape diagnostics distinguish every malformed role" mode:0..<4 {
  nodes:[256]CK_Node;types:[96]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_quantity_fixture(c);
  if mode==0 {nodes[4].next=0;}if mode==1 {nodes[6].next=17;nodes[17]=CK_Node.{kind=CK_Tag.field,name="other",type=18};}if mode==2 {nodes[6].name="other";}if mode==3 {nodes[6].b=18;}
  CK_quantity_layout(c,3);#assert state[0].error_count==1 && errors[0].code=="E0821" && errors[0].message=="@builtin_quantity requires two parameters and one field value of the representation parameter";
}
#forall "quantity conversion refusals preserve precise invalid-type and diagnostic contracts" mode:0..<11 {
  nodes:[256]CK_Node;types:[96]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_quantity_fixture(c);
  if mode==0 {nodes[13].next=0;}if mode==1 {nodes[13].kind=CK_Tag.expr_float;}if mode==2 {nodes[13].name="Missing";}if mode==3 {nodes[14]=CK_Node.{kind=CK_Tag.expr_ident,name="Missing"};}
  if mode==4 {nodes[13].name="Quantity";}if mode==5 {nodes[13].name="f64";}if mode==6 {nodes[16].quantity=0;}if mode==7 {nodes[14]=CK_Node.{kind=CK_Tag.expr_float,type=7};}
  if mode==8 {types[16].kind=CK_Kind.param;types[16].name="$U";}if mode==9 {nodes[16].unit.length=0;nodes[16].unit.time=1;}if mode==10 {nodes[16].unit.denominator=100;}
  result:=CK_quantity_convert(c,15);#assert result==0 && state[0].error_count==1;if mode==2 || mode==3 || mode==4 {#assert errors[0].loc.line==0 && errors[0].loc.column==0 && errors[0].loc.offset==0;}else {#assert errors[0].loc.line==83 && errors[0].loc.column==7 && errors[0].loc.offset==223 && errors[0].fix=="";}
  if mode==0 {#assert errors[0].code=="E0825" && errors[0].loc.line==83 && errors[0].loc.column==7 && errors[0].loc.offset==223 && errors[0].message=="convert_unit requires a target unit type and one quantity";}
  if mode==1 {#assert errors[0].code=="E0825" && errors[0].message=="convert_unit target must name an @unit type";}if mode==2 {#assert errors[0].code=="E0302" && errors[0].message=="unknown type 'Missing'";}if mode==3 {#assert errors[0].code=="E0306" && errors[0].message=="'Missing' is not declared";}if mode==4 {#assert errors[0].code=="E0800" && errors[0].message=="'Quantity' is a generic struct, so a type names its arguments";}
  if mode==5 || mode==6 || mode==7 {#assert errors[0].code=="E0825" && errors[0].message=="convert_unit needs a declared unit type and a quantity";}
  if mode==8 {#assert errors[0].code=="E0825" && errors[0].message=="this initial conversion profile requires concrete unit types";}
  if mode==9 {#assert errors[0].code=="E0825" && errors[0].message=="conversion dimensions do not match: Quantity(Metre,f64) to Target";}
  if mode==10 {#assert errors[0].code=="E0826" && errors[0].message=="this profile converts only power-of-two unit scale ratios: Quantity(Metre,f64) to Target";}
