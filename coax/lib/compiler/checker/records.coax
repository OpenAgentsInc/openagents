// The checker graph ABI: nodes, types, locals, errors, state, capacities,
// builtins and the layout target. A part of the checker:
// lib/compiler/checker.coax loads it (#12646).
#authority;
// Indexed semantic graph. Type IDs 0..15 are fixed native scalar identities;
// declarations and composite types are allocated in the Coax type pool.
// Indexed ABI identities: zero is absence, layout mode is explicit.
CK_NONE :: 0;
CK_Access :: enum u8 {value;view;}
CK_Hint :: struct {type:int;}
CK_Loc :: struct {line:int;column:int;offset:int;}
// param: a type parameter's placeholder ($T), owned by one generic procedure (decl).
CK_Kind :: enum u8 {invalid;void_;integer;floating;bool_;string_;untyped_int;untyped_float;struct_;enum_;array;view;param;union_;result;optional;}
CK_Tag :: enum u32 {invalid=0;type_named=1;type_array=2;type_view=3;type_dynamic=4;type_param=5;type_optional=6;
  expr_int=16;expr_float=17;expr_bool=18;expr_string=19;expr_ident=20;expr_call=21;expr_unary=22;expr_binary=23;expr_run=24;expr_field=25;expr_index=26;expr_slice=27;expr_struct=28;expr_array=29;expr_cast=30;expr_ifx=31;expr_enum=32;expr_ct=33;expr_sum=34;expr_null=35;expr_some=36;expr_try=37;expr_or_else=38;
  stmt_block=40;stmt_expr=41;stmt_var=42;stmt_assign=43;stmt_return=44;stmt_if=45;stmt_while=46;stmt_range=47;stmt_each=48;stmt_break=49;stmt_continue=50;stmt_defer=51;stmt_assert=52;stmt_switch=53;
  proc=64;constant=65;struct_=66;enum_=67;param=68;field=69;member=70;field_init=71;import_=72;check=73;file=74;assert_=75;unit_factor=76;union_=77;variant=78;switch_case=79;effect_name=80;case_binding=81;
}
CK_Lowering :: enum u8 {none;spatial_binary;spatial_unary;invalid=255;}
CK_Mutation :: enum u8 {unprepared;eligible;no_alternative;unsupported;}
CR_Phase :: enum u8 {fresh;active;done;seeded;}
CK_Node :: struct {kind:CK_Tag;loc:CK_Loc;name:string;name2:string;loc2:CK_Loc;a:int;b:int;c:int;d:int;head:int;tail:int;next:int;op:u32;flag:bool;flag2:bool;value:u64;floating:u64;
  type:int;field_index:int= -1;proc:int;constant:int;negative:bool;folded:bool;builtin_print:bool;byte_intrinsic:u32;intrinsic:u32;mark:int;reached:bool;metal_done:bool;metal_active:bool;skip_authority:bool;scope:int;collides:bool;clash:int;effects:u8;own_effects:u8;effects_known:bool;generic:bool;
  origin:int;pristine:int;chain:int;key:string;quantity:u8;unit:Q_Unit;unit_form:int;unit_link:int;unit_generated:bool;frame_decl:bool;frame:SP_Frame;spatial_link:int;lowering:CK_Lowering;mutation_status:CK_Mutation;mutation_op:u32;mutation_proc:int;borrow_binding:int;borrow_owner:int;borrow_writes:int;borrow_returns:int;borrow_calls:int;borrow_next:int;borrow_status:u8;borrow_query:int;retain_head:int;retain_count:int;retain_mark:CR_Phase;retain_incomplete:bool;retain_relation:bool;effect_present:bool;pure_decl:bool;effect_head:int;effect_loc:CK_Loc;sum_variant:int= -1;propagate_type:int;source_unit:int;retain_return:int;}
CK_Type :: struct {kind:CK_Kind;name:string;size:int;alignment:int=1;bits:int;is_signed:bool;elem:int;length:int;decl:int;id:int;scope:int;need:int;carrier:int;unit:int;space:SP_Type;retain_presence:u8;retain_mutable:u8;retain_join:u8;retain_fields:int;sum_error:int;sum_payload_offset:int;sum_default:int= -1;}
CK_Local :: struct {name:string;type:int;loc:CK_Loc;immutable:string;local_backing:bool;decl:int;}
CK_Error :: struct {loc:CK_Loc;code:string;message:string;fix:string;}
// Where a type is being resolved, for $T: which procedure owns the type
// parameters in scope (generic) and whether this position may bind one (site).
CK_Site :: enum u8 {none;param;result;body;field;}
CK_State :: struct {used:int;type_count:int;composite_count:int;local_count:int;byte_count:int;error_count:int;current:int;constant_depth:int;loop_depth:int;defer_depth:int;unevaluated:int;basic:bool;depth:int;fatal:bool;metal_depth:int;clashes:int;generic:int;site:CK_Site;instances:int;instance_tail:int;instance_count:int;quantity_device:bool;unit_units:int;spatial_types:int;spatial_helpers:int;retain_report_count:int;names:int;instance_limit:int;peak_depth:int;borrow_units:int;borrow_work:int;borrow_worst:[3]int;borrow_worst_unit:[3]int;borrow_queries:int;borrow_origins:int;}
// Logical module scopes: a node's scope indexes modules (0 is the unowned
// program); an alias names a target scope from within one scope.
CK_Alias :: struct {scope:int;name:string;target:int;}
// A name in a module's `#export` list. A module with any export is sealed:
// its other declarations are private to it.
CK_Export :: struct {scope:int;name:string;loc:CK_Loc;}
CK_Context :: struct {nodes:[] CK_Node;types:[] CK_Type;locals:[] CK_Local;errors:[] CK_Error;bytes:[] u8;state:[] CK_State;modules:[] string;aliases:[] CK_Alias;exports:[] CK_Export;borrow_queries:[]CK_BorrowQuery;borrow_origins:[]BS_Origin;retain_effects:[]CK_RetainEffect;retain_reports:[]CK_RetainObservation;result_work:[]int;names:[]int;}
CK_Options :: struct {library:bool;metal:bool;authority:bool;quantity_device:bool;}
CK_Caps :: struct {nodes:int;types:int;locals:int;errors:int;bytes:int;result_work:int;names:int;}
CK_BorrowQuery :: struct {kind:u8;decl:int;type:int;path:BS_Path;status:u8;start:int;count:int;next:int;retain_classes:bool;}
CK_BorrowCaps :: struct {queries:int;origins:int;work:int;}
CK_RetainEffect :: struct {source:BS_Origin;destination:BS_Origin;value_type:int;witness:int;next:int;source_storage:bool;}
CK_RetainObservation :: struct {kind:u8;owner:int;site:int;facts_complete:bool;relation_complete:bool;forbidden:bool;pending:int;}
CK_RetainCaps :: struct {effects:int;reports:int;work:int;}
// Independent effect-opacity facts, separate from the lookup/type controls.
// Declared typed-graph semantic oracles. No captured checker outputs or private cache layout/order expectations.








// Independent typed-place, path-admission and default-value oracles.


// Independent discovery and leaf-budget semantic oracles; no captured checker outputs.














// Independent semantic controls for the fourth-feedback final discovery/leaves sites. No checker outputs captured.




// Active-pool boundaries must never read plausible poisoned unused entries.










// Literal typed-graph boundary controls for integration by the checker owner.
// No new resolver and no expected-value calculation from the implementation.

// The type graph is 256 fixed-length-one containers around one borrowed leaf.
// A view's own enclosing depth does not consume its pointee-discovery budget.

