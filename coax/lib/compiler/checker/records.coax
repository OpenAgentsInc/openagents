CK_caps :: (nodes:int,source:int)->CK_Caps #export_c {
  if nodes<2 || nodes>2147483646 || source<0 || source>2147483646 {return CK_Caps.{};}
  return CK_Caps.{nodes=nodes*3+16,types=nodes*3+16,locals=nodes+16,errors=nodes*8+16,bytes=source*8+nodes*512+4096,result_work=nodes*8+32,names=nodes*3};
}
CK_builtin :: (id:int)->CK_Type #export_c {
  names:=[16] string.["<invalid>","void","bool","string","integer literal","float literal","f32","f64","s8","s16","s32","int","u8","u16","u32","u64"];
  kinds:=[16] CK_Kind.[CK_Kind.invalid,CK_Kind.void_,CK_Kind.bool_,CK_Kind.string_,CK_Kind.untyped_int,CK_Kind.untyped_float,CK_Kind.floating,CK_Kind.floating,CK_Kind.integer,CK_Kind.integer,CK_Kind.integer,CK_Kind.integer,CK_Kind.integer,CK_Kind.integer,CK_Kind.integer,CK_Kind.integer];
  sizes:=[16] int.[0,0,1,16,0,0,4,8,1,2,4,8,1,2,4,8];
  widths:=[16] int.[0,0,8,0,0,0,32,64,8,16,32,64,8,16,32,64];
  signed:=[16] bool.[false,false,false,false,true,true,true,true,true,true,true,true,false,false,false,false];
  raw:=cast,trunc(u64)id;at:=0;if raw<16 {at=cast(int)raw;}alignment:=sizes[at];if alignment==0 {alignment=1;}if at==3 {alignment=8;}
  return CK_Type.{name=names[at],kind=kinds[at],size=sizes[at],alignment=alignment,bits=widths[at],is_signed=signed[at]};
}
// The one qualified layout target: the named native LP64 description the
// checker lays types out with. A view or string is {pointer, count}; every
// other layout-query target is unsupported rather than borrowing these values.
CK_Target :: struct {name:string;supported:bool;data_model:string;pointer_size:int;pointer_alignment:int;count_size:int;count_alignment:int;view_size:int;view_alignment:int;calling_convention:string;reason:string;}
CK_target :: (name:string)->CK_Target #export_c {
  if name!="native-lp64" {return CK_Target.{name=name,reason="only the native-lp64 layout target is qualified; other targets have no layout description"};}
  view:=CK_builtin(3);
  return CK_Target.{name=name,supported=true,data_model="LP64",pointer_size=8,pointer_alignment=8,count_size=8,count_alignment=8,view_size=view.size,view_alignment=view.alignment,calling_convention="c"};
}
CK_builtin_type :: (name:string)->int {
  names:=[14] string.["int","s64","s8","s16","s32","u8","u16","u32","u64","uint","f32","f64","bool","string"];
  ids:=[14] int.[11,11,8,9,10,12,13,14,15,15,6,7,2,3];for x,i:names {if x==name {return ids[i];}}return CK_NONE;
}
