 // Excluded generic/bodyless declarations publish no retained summary.
 for id:2..<c.state[0].used+1 {if c.nodes[id].kind==CK_Tag.proc {if !CB_tick(b,c.nodes[id].loc) {return;}c.nodes[id].retain_head=0;c.nodes[id].retain_count=0;c.nodes[id].retain_mark=CR_Phase.fresh;c.nodes[id].retain_incomplete=false;}}
