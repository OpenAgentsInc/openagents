  arg:=CB_at(b,e.head,effect.source.root);sources:[64]BS_Origin;source_b:=b;source_b.retain_classes=true;values:=CB_expr(source_b,arg,effect.source.path,effect.source_storage,sources[..]);if b.c.state[0].error_count>0 {return;}addresses:[64]BS_Origin;storage:CB_Result;
  if effect.destination.kind==BS_STATIC {addresses[0]=effect.destination;storage.count=1;}
  else {if effect.destination.kind!=BS_PARAMETER {CK_resource(b.c,e.loc);return;}target:=CB_at(b,e.head,effect.destination.root);storage=CR_address(b,target,effect.destination.path,effect.destination.type,addresses[..]);}
