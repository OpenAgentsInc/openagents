// B1-only presence memo: the checked type graph is immutable during this pass.
// The initial computation remains the shared A1 discovery with its same fuel.
CR_presence :: (b:CB_Context,type:int)->bool {
 if b.c.state[0].fatal {return false;}if type<1 || type>=b.c.state[0].type_count {CK_resource(b.c,b.state[0].loc);return false;}
 cached:=b.c.types[type].retain_presence;if cached==1 {return false;}if cached==2 {return true;}
 result:=CB_discover(b,type,0,false);if !b.c.state[0].fatal {b.c.types[type].retain_presence=ifx result then cast(u8)2 else cast(u8)1;}return result;
}
// Mutability is separate from any-borrow presence (a string has only the latter).
CR_mutable :: (b:CB_Context,type:int)->bool {
 if b.c.state[0].fatal {return false;}if type<1 || type>=b.c.state[0].type_count {CK_resource(b.c,b.state[0].loc);return false;}
 cached:=b.c.types[type].retain_mutable;if cached==1 {return false;}if cached==2 {return true;}
 result:=CB_discover(b,type,0,true);if !b.c.state[0].fatal {b.c.types[type].retain_mutable=ifx result then cast(u8)2 else cast(u8)1;}return result;
}

