 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};state[0]=CK_State.{used=10,type_count=18};nodes[1]=CK_Node.{kind=CK_Tag.file};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.array,elem=ifx mode==1 then 3 else 11,length=1};
