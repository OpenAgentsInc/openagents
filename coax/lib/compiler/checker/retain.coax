// Retained-store summaries (CR_), with their checks. A part of the checker:
// lib/compiler/checker.coax loads it (#12646).
#authority;
CR_MAX_EFFECTS :: 256;
CR_Shape :: struct {type:int;decl:int;head:int;count:int;max_field:int;max_type:int;fields:[8]int;ordinals:[8]int;}
CR_State :: struct {effects:int;reports:int;shape:CR_Shape;shape_previous:CR_Shape;leaves:int;join_arrays:bool;}
CR_Context :: struct {b:CB_Context;effects:[]CK_RetainEffect;reports:[]CK_RetainObservation;state:[]CR_State;}
CR_Result :: struct {complete:bool;relation:bool;pending:int;}
CR_shape_matches :: (shape:CR_Shape,type:int,decl:int,head:int)->bool {return shape.type==type && shape.decl==decl && shape.head==head;}
CR_shape_keep :: (r:CR_Context,shape:CR_Shape) {
 // Promote/deduplicate only a fully validated successful shape. Nested child
 // work may have changed the current slot, so retain that actual last shape.
 if !CR_shape_matches(r.state[0].shape,shape.type,shape.decl,shape.head) {r.state[0].shape_previous=r.state[0].shape;}
 r.state[0].shape=shape;
}
CK_retain_caps :: (nodes:int)->CK_RetainCaps #export_c {
 if nodes<1 || nodes>2147483646 {return CK_RetainCaps.{};}
 n:=nodes*2;delta:=n-128;n=128+(delta & ((delta>>63)^ -1));delta=16384-n;n=16384-(delta & ((delta>>63)^ -1));
 reports:=nodes;delta=reports-128;reports=128+(delta & ((delta>>63)^ -1));delta=16384-reports;reports=16384-(delta & ((delta>>63)^ -1));
 return CK_RetainCaps.{effects=n,reports=reports,work=2097152};
}
CR_record :: (r:CR_Context,kind:u8,owner:int,site:int,complete:bool,relation:bool,pending:int) {
 if r.reports.count==0 {return;}
 if r.state[0].reports>=r.reports.count {CK_resource(r.b.c,r.b.c.nodes[site].loc);return;}
 r.reports[r.state[0].reports]=CK_RetainObservation.{kind=kind,owner=owner,site=site,facts_complete=complete,relation_complete=relation,pending=pending};r.state[0].reports+=1;
}
CR_address :: (b:CB_Context,id:int,path:BS_Path,slot_type:int,out:[]BS_Origin)->CB_Result {
 if id<2 || id>b.c.state[0].used || !BS_path_valid(path) || !CB_tick(b,CK_Loc.{}) {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}
 if b.state[0].depth>=32 {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}b.state[0].depth+=1;defer b.state[0].depth-=1;e:=b.c.nodes[id];
 if e.type<1 || e.type>=b.c.state[0].type_count {CK_resource(b.c,e.loc);return CB_Result.{};}
 if e.kind==CK_Tag.expr_field {return CR_address(b,e.a,CB_prepend(b,path,BS_FIELD,e.field_index),slot_type,out);}
 if e.kind==CK_Tag.expr_index {base:=b.c.types[b.c.nodes[e.a].type];index:=2147483647;if b.c.nodes[e.b].kind==CK_Tag.expr_int && b.c.nodes[e.b].value>>31==0 {index=cast(int)b.c.nodes[e.b].value;}return CR_address(b,e.a,CB_prepend(b,path,ifx base.kind==CK_Kind.view then BS_DEREFERENCE else BS_ELEMENT,ifx base.kind==CK_Kind.view then 0 else index),slot_type,out);}
 if e.kind==CK_Tag.expr_cast {return CR_address(b,e.a,path,slot_type,out);}
 if e.kind==CK_Tag.expr_slice {
  if path.count==0 || path.steps[0].kind!=BS_DEREFERENCE {return CB_Result.{incomplete=true};}
  if b.c.types[b.c.nodes[e.a].type].kind==CK_Kind.array {return CR_address(b,e.a,CB_prepend(b,CB_tail(path),BS_ELEMENT,2147483647),slot_type,out);}
  return CR_address(b,e.a,path,slot_type,out);
 }
 if e.kind==CK_Tag.expr_ifx {result:=CR_address(b,e.b,path,slot_type,out);temp:[64]BS_Origin;other:=CR_address(b,e.c,path,slot_type,temp[..]);return CB_merge(b,out,result,temp[..],other);}
 // The strict return-query API needs an available checked return list.
 // An unmodeled getter supplies no addressed-pointee proof; it is manual,
 // rather than a fabricated empty address or an invalid query invocation.
 if e.kind==CK_Tag.expr_call {
  if e.proc==0 {return CB_Result.{incomplete=true};}
  if e.proc<2 || e.proc>b.c.state[0].used || b.c.nodes[e.proc].kind!=CK_Tag.proc {CK_resource(b.c,e.loc);return CB_Result.{};}
  if b.c.nodes[e.proc].borrow_returns==0 {return CB_Result.{incomplete=true};}
 }
 cross:= -1;for i:0..<path.count {if path.steps[i].kind==BS_DEREFERENCE {cross=i;}}
 if cross<0 {
  // The typed walk already supplies this owned slot's path and leaf type.
  // Its owner is a bound current-frame declaration, not the old descriptor.
  if e.kind==CK_Tag.expr_ident && e.borrow_binding!=0 {
   decl:=e.borrow_binding;if decl<2 || decl>b.c.state[0].used {CK_resource(b.c,e.loc);return CB_Result.{};}n:=b.c.nodes[decl];owner:=n.borrow_owner;
   if (n.kind!=CK_Tag.param && n.kind!=CK_Tag.stmt_var && n.kind!=CK_Tag.stmt_each && n.kind!=CK_Tag.case_binding) || n.type!=e.type || slot_type>=b.c.state[0].type_count {CK_resource(b.c,e.loc);return CB_Result.{};}
   if owner<2 || owner>b.c.state[0].used || (b.c.nodes[owner].kind!=CK_Tag.proc && b.c.nodes[owner].kind!=CK_Tag.check) {CK_resource(b.c,e.loc);return CB_Result.{};}
   return CB_put(b,out,CB_Result.{},BS_Origin.{kind=BS_LOCAL,root=decl,type=slot_type,path=path});
  }
  result:=CB_expr(b,id,path,true,out);for i:0..<result.count {out[i].type=slot_type;}return result;
 }
 prefix:BS_Path;for i:0..<cross {prefix=CB_add_path(b,prefix,path.steps[i].kind,path.steps[i].index);}
 // A complete-empty descriptor is a value fact, not an asserted valid
 // addressed pointee. Without a represented address this dereference stays
 // manual; complete-empty SOURCE values remain complete in CR_leaf.
 backing:[64]BS_Origin;known:=CB_expr(b,id,prefix,false,backing[..]);result:=CB_Result.{incomplete=known.incomplete || known.count==0};
 for i:0..<known.count {
  owner:=backing[i];owner.path=CB_add_path(b,owner.path,ifx owner.kind==BS_PARAMETER then BS_DEREFERENCE else BS_ELEMENT,ifx owner.kind==BS_PARAMETER then 0 else 2147483647);
  for j:cross+1..<path.count {owner.path=CB_add_path(b,owner.path,path.steps[j].kind,path.steps[j].index);}owner.type=slot_type;result=CB_put(b,out,result,owner);
 }return result;
}
// Per-call pending effects share this procedure's bounded summary capacity.
// The supplied-store RP kernel keeps its independent64-term staging limit.
CR_pending_insert :: (staging:[]RP_Obligation,used:int,value:RP_Obligation)->int {
 if used<0 || used>staging.count || staging.count>CR_MAX_EFFECTS {return -1;}at:=used;
 for i:0..<used {comparison:=rp_compare(staging[i],value);if comparison<0 {continue;}if comparison==0 {return used;}at=i;break;}
 if used>=staging.count {return -1;}i:=used;while i>at {staging[i]=staging[i-1];i-=1;}staging[at]=value;return used+1;
}
CR_effect :: (r:CR_Context,owner:int,site:int,row:RP_Obligation) {
 b:=r.b;link:=b.c.nodes[owner].retain_head;
 while link!=0 {if link<1 || link>r.state[0].effects || !CB_tick(b,b.c.nodes[site].loc) {CK_resource(b.c,b.c.nodes[site].loc);return;}old:=r.effects[link-1];if bs_compare(old.source,row.source.origin)==0 && bs_compare(old.destination,row.destination.storage.origin)==0 {return;}link=old.next;}
 if b.c.nodes[owner].retain_count>=CR_MAX_EFFECTS || r.state[0].effects>=r.effects.count {CK_resource(b.c,b.c.nodes[site].loc);return;}
 // This formal projection is invariant for the frozen canonical effect.
 formal:=CB_at(b,b.c.nodes[owner].head,row.source.origin.root);if b.c.state[0].fatal {return;}place:=CB_type(b,b.c.nodes[formal].type,row.source.origin.path);if b.c.state[0].fatal {return;}
 at:=r.state[0].effects;r.effects[at]=CK_RetainEffect.{source=row.source.origin,destination=row.destination.storage.origin,value_type=row.destination.value_type,witness=site,next=b.c.nodes[owner].retain_head,source_storage=b.c.types[place].kind==CK_Kind.array};r.state[0].effects+=1;b.c.nodes[owner].retain_head=at+1;b.c.nodes[owner].retain_count+=1;
}
CR_pairs :: (r:CR_Context,owner:int,site:int,key:int,sources:[]BS_Origin,sc:bool,addresses:[]BS_Origin,dc:bool,pending:[]RP_Obligation,prior:CR_Result)->CR_Result {
 b:=r.b;if b.c.state[0].error_count>0 {return CR_Result.{};}src:[64]RP_Term;dst:[64]RP_Address;
 if sources.count<0 || sources.count>64 || addresses.count<0 || addresses.count>64 {CK_resource(b.c,b.c.nodes[site].loc);return CR_Result.{};}
 for i:0..<sources.count {src[i]=RP_Term.{frame=ifx sources[i].kind==BS_STATIC then 0 else owner,origin=sources[i]};}
 for i:0..<addresses.count {dst[i]=RP_Address.{storage=RP_Term.{frame=ifx addresses[i].kind==BS_STATIC then 0 else owner,origin=addresses[i]},value_type=key};}
 rows:[64]RP_Obligation;decision:=RP_check(owner,key,src[0..<sources.count],sc,dst[0..<addresses.count],dc,rows[..]);
 if decision.status!=RP_Status.ok {CK_resource(b.c,b.c.nodes[site].loc);return CR_Result.{};}
 if decision.forbidden {CK_error(b.c,b.c.nodes[site].loc,"E0383","retained borrow may refer to callee-local inline storage","keep retained backing in the caller and satisfy its outlives obligation");return CR_Result.{};}
 result:=CR_Result.{complete=prior.complete && decision.facts_complete,relation=prior.relation && decision.relation_complete,pending=prior.pending};
 // Both callers own256 pending slots; their accumulated pairs are a subset of
 // this owner's canonical256-effect relation. Admit that relation before insert.
 for i:0..<decision.obligation_count {CR_effect(r,owner,site,rows[i]);if b.c.state[0].fatal {return CR_Result.{};}inserted:=CR_pending_insert(pending,result.pending,rows[i]);if inserted== -1 {CK_resource(b.c,b.c.nodes[site].loc);return CR_Result.{};}result.pending=inserted;}
 // Pending pairs can later discharge at callers. A local/manual relation
 // remains a separate sticky private fact, not indistinguishable from pending.
 for i:0..<sources.count {for j:0..<addresses.count {
  if !CB_tick(b,b.c.nodes[site].loc) {return CR_Result.{};}
  // The complete matrix was validated above. Its manual zero-obligation
  // cases are exactly the existing policy's local-source/local-address rows.
  if rp_local_source(src[i]) && !rp_external(dst[j]) {b.c.nodes[owner].retain_relation=false;}
 }}
 b.c.nodes[owner].retain_incomplete=b.c.nodes[owner].retain_incomplete || !decision.facts_complete;
 return result;
}
