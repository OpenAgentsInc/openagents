}
CR_workspace_admitted :: (effect_count:int,report_count:int)->bool {return effect_count>=128 && effect_count<=16384 && report_count>=0 && report_count<=16384;}
CR_execute :: (b:CB_Context,effects:[]CK_RetainEffect) {
