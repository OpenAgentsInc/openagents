 b.c.nodes[owner].retain_incomplete=b.c.nodes[owner].retain_incomplete || !result.complete;b.c.nodes[owner].retain_relation=b.c.nodes[owner].retain_relation && callee.retain_relation;
 CR_record(r,2,owner,call,result.complete,result.relation,result.pending);
}
// Summaries are a post-order walk of the call graph with no native recursion
// and no depth limit (#12681). A procedure is active at most once, and its
// retain_return names the call that entered it (0 for the walk's root), so a
// finished callee resumes its caller at that call. The walk's height is
// therefore bounded by the program's procedures; CB_tick bounds its work.
CR_summary :: (r:CR_Context,root:int) {
 b:=r.b;if root<2 || root>b.c.state[0].used || b.c.nodes[root].kind!=CK_Tag.proc {CK_resource(b.c,b.state[0].loc);return;}n:=b.c.nodes[root];if !CR_eligible(n.generic,n.b) {return;}if n.retain_mark==CR_Phase.done || n.retain_mark==CR_Phase.active {return;}
 if n.retain_mark!=CR_Phase.seeded {CK_resource(b.c,n.loc);return;}b.c.nodes[root].retain_mark=CR_Phase.active;b.c.nodes[root].retain_return=0;owner:=root;call:=n.borrow_calls;
 while true {
  if call==0 {
   b.c.nodes[owner].retain_mark=CR_Phase.done;CR_record(r,1,owner,owner,!b.c.nodes[owner].retain_incomplete,b.c.nodes[owner].retain_relation && b.c.nodes[owner].retain_count==0,b.c.nodes[owner].retain_count);
   back:=b.c.nodes[owner].retain_return;if back==0 || b.c.state[0].fatal {return;}
   owner=b.c.nodes[back].borrow_owner;CR_apply(r,owner,back,false);call=back;
  }else {
   if call<2 || call>b.c.state[0].used || b.c.nodes[call].kind!=CK_Tag.expr_call || b.c.nodes[call].borrow_owner!=owner || !CB_tick(b,b.c.nodes[owner].loc) {CK_resource(b.c,b.c.nodes[owner].loc);return;}e:=b.c.nodes[call];
   // A typed intrinsic has no user-procedure identity. Foreign/intrinsic
   // retention is unmodeled, including scalar-only calls: never host proof.
   if e.proc==0 {b.c.nodes[owner].retain_incomplete=true;CR_record(r,2,owner,call,false,true,0);}
   else {
    if e.proc<2 || e.proc>b.c.state[0].used || b.c.nodes[e.proc].kind!=CK_Tag.proc {CK_resource(b.c,e.loc);return;}callee:=b.c.nodes[e.proc];
    if callee.flag2 {b.c.nodes[owner].retain_incomplete=true;CR_record(r,2,owner,call,false,true,0);}
    else if callee.retain_mark==CR_Phase.active {CR_apply(r,owner,call,true);}
    else if CR_eligible(callee.generic,callee.b) && callee.retain_mark!=CR_Phase.done {
     if callee.retain_mark!=CR_Phase.seeded {CK_resource(b.c,callee.loc);return;}
     b.c.nodes[e.proc].retain_mark=CR_Phase.active;b.c.nodes[e.proc].retain_return=call;owner=e.proc;call=callee.borrow_calls;continue;
    }
    else {CR_apply(r,owner,call,false);}
   }
  }
  if b.c.state[0].fatal || b.c.state[0].error_count>0 {return;}call=b.c.nodes[call].borrow_next;
 }
}
CR_walk :: (r:CR_Context,head:int,instances:bool,seed:bool) {
