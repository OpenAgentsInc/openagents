 while id!=0 {
  if id<2 || id>b.c.state[0].used || !CB_tick(b,CK_Loc.{}) {CK_resource(b.c,b.state[0].loc);return;}n:=b.c.nodes[id];owner:=ifx n.kind==CK_Tag.check then n.a else id;
