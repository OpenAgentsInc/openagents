 else {#assert !state[0].fatal && state[0].error_count==0 && cr[0].reports==1 && reports[0].kind==2 && reports[0].owner==2 && reports[0].site==8 && reports[0].facts_complete && reports[0].relation_complete && !reports[0].forbidden && reports[0].pending==0;}
