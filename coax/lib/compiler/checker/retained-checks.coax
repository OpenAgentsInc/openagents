#forall "retained summary pending256 preserves ordering duplicate reuse and atomic257 refusal" mode:0..<5 {
 if mode>=4 {other:[257]RP_Obligation;row:RP_Obligation;#assert CR_pending_insert(other[..],0,row)== -1;#assert CR_pending_insert(other[0..<0],0,row)== -1;return;}
 pending:[256]RP_Obligation;for i:0..<256 {row:=RP_Obligation.{source=RP_Term.{origin=BS_Origin.{kind=BS_PARAMETER,role=BS_DESCRIPTOR,type=12,path=BS_Path.{count=1}}}};row.source.origin.path.steps[0]=BS_Step.{kind=BS_FIELD,index=255-i};#assert CR_pending_insert(pending[..],i,row)==i+1;}
 for i:0..<256 {#assert pending[i].source.origin.path.steps[0].index==i;}
 row:=pending[64];if mode==0 {#assert CR_pending_insert(pending[..],256,row)==256;}else {row.source.origin.path.steps[0].index=256;used:=ifx mode==1 then 256 else ifx mode==2 then -1 else 257;#assert CR_pending_insert(pending[..],used,row)== -1;}
 for i:0..<256 {#assert pending[i].source.origin.path.steps[0].index==i;}
}
