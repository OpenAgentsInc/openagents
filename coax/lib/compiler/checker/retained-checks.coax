// Admission bridge expectations use actual small workspace views.
#forall "retained workspace rejection names stable resource admission and commits no report" admitted:bool {
 nodes:[8]CK_Node;types:[16]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=7,type_count=16,retain_report_count=9}];work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=77,column=9,offset=77009}}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;effects:[128]CK_RetainEffect;reports:[2]CK_RetainObservation;for i:0..<16 {types[i]=CK_builtin(i);}nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,b=3,loc=CK_Loc.{line=88,column=6,offset=88006}};nodes[3].kind=CK_Tag.stmt_block;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],retain_effects=ifx admitted then effects[..] else effects[0..<127],retain_reports=reports[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};CR_run(b);
 if admitted {#assert !state[0].fatal && state[0].error_count==0 && state[0].retain_report_count==1;row:=reports[0];#assert row.kind==1 && row.owner==2 && row.site==2 && row.facts_complete && row.relation_complete && !row.forbidden && row.pending==0;}
 else {#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==1 && errors[0].loc.column==1 && errors[0].loc.offset==0 && state[0].retain_report_count==0;}
}
