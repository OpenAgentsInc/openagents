 for i:0..<66 {r=CB_put(b,out[..],r,BS_Origin.{kind=BS_STATIC,root=i+2,type=12});if state[0].fatal {break;}}r=CB_put(b,out[..],r,BS_Origin.{kind=BS_LOCAL,root=9,type=12});empty:[1]BS_Origin;r=CB_merge(b,out[..],r,empty[0..<0],CB_Result.{incomplete=true});#assert !state[0].fatal && r.count==2 && r.incomplete;
 src:[2]RP_Term;for i:0..<2 {src[i]=RP_Term.{frame=ifx out[i].kind==BS_STATIC then 0 else 2,origin=out[i]};}address:=BS_Origin.{kind=BS_PARAMETER,root=0,role=BS_DESCRIPTOR,type=16,path=BS_Path.{count=1}};address.path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};dst:=[1]RP_Address.[RP_Address.{storage=RP_Term.{frame=2,origin=address},value_type=12}];pending:[64]RP_Obligation;q:=RP_check(2,12,src[..],false,dst[..],true,pending[..]);#assert q.status==RP_Status.ok && !q.facts_complete && q.relation_complete && q.forbidden && q.obligation_count==0;
