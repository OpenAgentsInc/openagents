#forall "retained summary walks a long call chain in post-order and resumes each caller at its call" form:0..<4 {
 chain:=ifx form==0 then 1 else ifx form==1 then 33 else ifx form==2 then 65 else 120;
 nodes:[384]CK_Node;types:[16]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=383,type_count=16}];work:[1]CB_State;effects:[128]CK_RetainEffect;reports:[256]CK_RetainObservation;cr:[1]CR_State;for i:0..<16 {types[i]=CK_builtin(i);}
 for i:0..<chain {p:=10+3*i;nodes[p]=CK_Node.{kind=CK_Tag.proc,type=1,b=p+1,borrow_calls=ifx i+1<chain then p+2 else 0,retain_return=99,loc=CK_Loc.{line=i+1,column=1}};nodes[p+1].kind=CK_Tag.stmt_block;if i+1<chain {nodes[p+2]=CK_Node.{kind=CK_Tag.expr_call,type=1,proc=p+3,borrow_owner=p};}}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};r:=CR_Context.{b=b,effects=effects[..],reports=reports[..],state=cr[..]};for i:0..<chain {CR_seed(r,10+3*i);}CR_summary(r,10);
 #assert !state[0].fatal && state[0].error_count==0 && cr[0].reports==2*chain-1;
 for i:0..<chain {
  p:=10+3*i;#assert nodes[p].retain_mark==CR_Phase.done && nodes[p].retain_return==(ifx i==0 then 0 else p-1) && !nodes[p].retain_incomplete && nodes[p].retain_relation;
  row:=reports[2*(chain-1-i)];#assert row.kind==1 && row.owner==p && row.site==p && row.facts_complete && row.relation_complete && row.pending==0;
  if i+1<chain {apply:=reports[2*(chain-1-i)-1];#assert apply.kind==2 && apply.owner==p && apply.site==p+2 && apply.facts_complete && apply.relation_complete && apply.pending==0;}
 }
 CR_summary(r,10);CR_summary(r,10+3*(chain-1));#assert !state[0].fatal && cr[0].reports==2*chain-1;
}

#forall "retained summary applies active done generic foreign and intrinsic callees and stops on malformed calls" mode:0..<11 {
 nodes:[32]CK_Node;types:[16]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=31,type_count=16}];work:[1]CB_State;effects:[128]CK_RetainEffect;reports:[8]CK_RetainObservation;cr:[1]CR_State;for i:0..<16 {types[i]=CK_builtin(i);}
 nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,b=3,borrow_calls=4,retain_return=77,loc=CK_Loc.{line=10,column=2}};nodes[3].kind=CK_Tag.stmt_block;nodes[4]=CK_Node.{kind=CK_Tag.expr_call,type=1,proc=6,borrow_owner=2,loc=CK_Loc.{line=11,column=3}};
 nodes[6]=CK_Node.{kind=CK_Tag.proc,type=1,b=7,borrow_calls=8,retain_return=77,loc=CK_Loc.{line=20,column=2}};nodes[7].kind=CK_Tag.stmt_block;nodes[8]=CK_Node.{kind=CK_Tag.expr_call,type=1,proc=2,borrow_owner=6,loc=CK_Loc.{line=21,column=3}};
 if mode==1 || mode==9 {nodes[4].borrow_next=5;nodes[5]=CK_Node.{kind=CK_Tag.expr_call,type=1,proc=6,borrow_owner=2,loc=CK_Loc.{line=12,column=3}};nodes[6].borrow_calls=0;}
 if mode==0 {state[0].used=8;}if mode==10 {nodes[8].proc=6;}if mode==2 {nodes[6].generic=true;}if mode==3 {nodes[6].flag2=true;}if mode==4 {nodes[4].proc=0;}if mode==6 {nodes[8].borrow_owner=2;}if mode==7 {nodes[8].proc=31;}if mode==9 {nodes[5].proc=0;}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};r:=CR_Context.{b=b,effects=effects[..],reports=ifx mode==8 then reports[0..<1] else reports[..],state=cr[..]};
 CR_seed(r,2);if mode!=5 {CR_seed(r,6);}CR_summary(r,2);
 if mode==0 || mode==10 {
  // A cycle (mode 10: a procedure that calls itself): a call into an active procedure is incomplete, and so is everything above it.
  #assert !state[0].fatal && state[0].error_count==0 && cr[0].reports==4 && nodes[2].retain_return==0 && nodes[6].retain_return==4 && nodes[2].retain_mark==CR_Phase.done && nodes[6].retain_mark==CR_Phase.done && nodes[2].retain_incomplete && nodes[6].retain_incomplete;
  #assert reports[0].kind==2 && reports[0].owner==6 && reports[0].site==8 && !reports[0].facts_complete && reports[1].kind==1 && reports[1].owner==6 && !reports[1].facts_complete && reports[2].kind==2 && reports[2].owner==2 && reports[2].site==4 && !reports[2].facts_complete && reports[3].kind==1 && reports[3].owner==2 && !reports[3].facts_complete;
 }
 else if mode==1 {
  // The second call reaches a callee already done: applied once more, never re-entered.
  #assert !state[0].fatal && state[0].error_count==0 && cr[0].reports==4 && nodes[6].retain_return==4 && reports[0].owner==6 && reports[0].kind==1 && reports[1].kind==2 && reports[1].site==4 && reports[2].kind==2 && reports[2].site==5 && reports[2].facts_complete && reports[3].kind==1 && reports[3].owner==2 && reports[3].facts_complete && reports[3].relation_complete;
 }
 else if mode==2 {#assert !state[0].fatal && state[0].error_count==0 && cr[0].reports==2 && nodes[6].retain_return==77 && nodes[6].retain_mark==CR_Phase.fresh && reports[0].kind==2 && reports[0].site==4 && reports[0].facts_complete && !reports[0].relation_complete && reports[1].kind==1 && reports[1].owner==2 && !reports[1].relation_complete;}
 else if mode==3 || mode==4 {#assert !state[0].fatal && state[0].error_count==0 && cr[0].reports==2 && nodes[6].retain_return==77 && nodes[6].retain_mark==CR_Phase.seeded && reports[0].kind==2 && reports[0].site==4 && !reports[0].facts_complete && reports[0].relation_complete && reports[1].kind==1 && reports[1].owner==2 && !reports[1].facts_complete && nodes[2].retain_incomplete;}
 else if mode==9 {#assert !state[0].fatal && cr[0].reports==4 && reports[2].kind==2 && reports[2].site==5 && !reports[2].facts_complete && reports[3].kind==1 && !reports[3].facts_complete;}
 else {
  where:=ifx mode==7 then 21 else 20;
  #assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==where && nodes[2].retain_mark==CR_Phase.active && !nodes[2].retain_incomplete && cr[0].reports==(ifx mode==8 then 1 else 0);
 }
}

