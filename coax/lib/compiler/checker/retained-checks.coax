#forall "retained optional report capacity refuses rather than publishing a prefix" capacity:0..<4 {
 nodes:[16]CK_Node;types:[16]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=16}];work:[1]CB_State;queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;reports:[5]CK_RetainObservation;
 for i:0..<16 {types[i]=CK_builtin(i);}for i:0..<5 {reports[i].owner= -91;}nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,b=5,borrow_calls=6};nodes[3]=CK_Node.{kind=CK_Tag.proc,type=1,flag2=true};nodes[5].kind=CK_Tag.stmt_block;nodes[6]=CK_Node.{kind=CK_Tag.expr_call,type=1,proc=3,borrow_owner=2,loc=CK_Loc.{line=90,column=7}};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],retain_reports=reports[1..<1+capacity]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};CR_run(b);
 #assert reports[0].owner== -91 && reports[1+capacity].owner== -91;
 if capacity==1 {#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && state[0].retain_report_count==0;}
 else {#assert !state[0].fatal && state[0].error_count==0;if capacity==0 {#assert state[0].retain_report_count==0;}else {#assert state[0].retain_report_count==2;found_call:=false;found_proc:=false;for row:reports[1..<3] {if row.kind==2 && row.site==6 {found_call=true;#assert row.owner==2 && !row.facts_complete && row.relation_complete && !row.forbidden && row.pending==0;}if row.kind==1 && row.owner==2 {found_proc=true;#assert row.site==2 && !row.facts_complete && row.relation_complete && !row.forbidden && row.pending==0;}}#assert found_call && found_proc;if capacity==3 {#assert reports[3].owner== -91;}}}
}

#forall "retained STATIC source classes admit65 and66 without enlarging origin capacity" extra:bool {
 nodes:[16]CK_Node;types:[16]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=16}];work:[1]CB_State;out:[64]BS_Origin;c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],retain_classes=true};r:CB_Result;
 for i:0..<(ifx extra then 66 else 65) {o:=BS_Origin.{kind=BS_STATIC,root=i+2,type=12};o.path.count=1;o.path.steps[0]=BS_Step.{kind=BS_FIELD,index=i};r=CB_put(b,out[..],r,o);if state[0].fatal {break;}}
 #assert !state[0].fatal && state[0].error_count==0 && r.count==1 && !r.incomplete && out[0].kind==BS_STATIC && out[0].root==1 && out[0].role==0 && out[0].type==12 && out[0].path.count==0;
 for step:out[0].path.steps {#assert step.kind==0 && step.index==0;}
 src:=[1]RP_Term.[RP_Term.{origin=out[0]}];address:=BS_Origin.{kind=BS_PARAMETER,root=0,role=BS_DESCRIPTOR,type=16,path=BS_Path.{count=1}};address.path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};dst:=[1]RP_Address.[RP_Address.{storage=RP_Term.{frame=2,origin=address},value_type=12}];pending:[64]RP_Obligation;q:=RP_check(2,12,src[..],true,dst[..],true,pending[..]);#assert q.status==RP_Status.ok && q.facts_complete && q.relation_complete && !q.forbidden && q.obligation_count==0;
}
