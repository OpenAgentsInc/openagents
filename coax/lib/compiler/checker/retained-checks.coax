// B1 checks precede the retained-store graph implementation.
#test "retained local source into an uncalled void caller store is rejected at RHS" {
 nodes:[64]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=42,type_count=20}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;effects:[128]CK_RetainEffect;reports:[8]CK_RetainObservation;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],retain_effects=effects[..],retain_reports=reports[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.struct_,decl=40};types[18]=CK_Type.{kind=CK_Kind.view,elem=17};types[19]=CK_Type.{kind=CK_Kind.array,elem=12,length=8};nodes[40]=CK_Node.{kind=CK_Tag.struct_,head=41};nodes[41]=CK_Node.{kind=CK_Tag.field,type=16};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,head=3,b=4,borrow_writes=12};nodes[3]=CK_Node.{kind=CK_Tag.param,type=18,borrow_owner=2};nodes[4]=CK_Node.{kind=CK_Tag.stmt_block,head=5};nodes[5]=CK_Node.{kind=CK_Tag.stmt_var,type=19,borrow_owner=2,next=12};nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=19,borrow_binding=5};nodes[7]=CK_Node.{kind=CK_Tag.expr_slice,type=16,a=6,loc=CK_Loc.{line=40,column=17,offset=400}};nodes[8]=CK_Node.{kind=CK_Tag.expr_ident,type=18,borrow_binding=3};nodes[9]=CK_Node.{kind=CK_Tag.expr_index,type=17,a=8,b=10};nodes[10]=CK_Node.{kind=CK_Tag.expr_int,type=11};nodes[11]=CK_Node.{kind=CK_Tag.expr_field,type=16,a=9,field_index=0};nodes[12]=CK_Node.{kind=CK_Tag.stmt_assign,c=11,a=7,borrow_owner=2};
 CR_run(b);#assert !state[0].fatal && state[0].error_count==1 && errors[0].code=="E0383" && errors[0].loc.line==40 && errors[0].loc.column==17 && errors[0].loc.offset==400 && state[0].retain_report_count==0;
}
#forall "retained workspace caps are independently bounded" sample:0..<7 {
 values:=[7]int.[0,1,63,64,8192,2147483646,2147483647];r:=CK_retain_caps(values[sample]);
 if sample==0 || sample==6 {#assert r.effects==0 && r.reports==0 && r.work==0;}
 else {#assert r.effects==(ifx sample<3 then 128 else ifx sample==3 then 128 else 16384) && r.reports==(ifx sample<4 then 128 else ifx sample==4 then 8192 else 16384) && r.work==2097152;}
}
#forall "retained helper obligations apply at actual caller and keep caller sources" local:bool {
 nodes:[96]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=60,type_count=20}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;effects:[128]CK_RetainEffect;reports:[8]CK_RetainObservation;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],retain_effects=effects[..],retain_reports=reports[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.struct_,decl=40};types[18]=CK_Type.{kind=CK_Kind.view,elem=17};types[19]=CK_Type.{kind=CK_Kind.array,elem=12,length=8};nodes[40]=CK_Node.{kind=CK_Tag.struct_,head=41};nodes[41]=CK_Node.{kind=CK_Tag.field,type=16};
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,head=3,b=5,next=20,borrow_writes=12};nodes[3]=CK_Node.{kind=CK_Tag.param,type=18,next=4,borrow_owner=2};nodes[4]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};nodes[5]=CK_Node.{kind=CK_Tag.stmt_block,head=12};nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=4};nodes[8]=CK_Node.{kind=CK_Tag.expr_ident,type=18,borrow_binding=3};nodes[9]=CK_Node.{kind=CK_Tag.expr_index,type=17,a=8,b=10};nodes[10]=CK_Node.{kind=CK_Tag.expr_int,type=11};nodes[11]=CK_Node.{kind=CK_Tag.expr_field,type=16,a=9,field_index=0};nodes[12]=CK_Node.{kind=CK_Tag.stmt_assign,c=11,a=6,borrow_owner=2};
 nodes[20]=CK_Node.{kind=CK_Tag.proc,type=1,head=21,b=23,borrow_calls=30};nodes[21]=CK_Node.{kind=CK_Tag.param,type=18,next=22,borrow_owner=20};nodes[22]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=20};nodes[23]=CK_Node.{kind=CK_Tag.stmt_block,head=24};nodes[24]=CK_Node.{kind=CK_Tag.stmt_var,type=19,borrow_owner=20};nodes[25]=CK_Node.{kind=CK_Tag.expr_ident,type=18,borrow_binding=21,next=ifx local then 27 else 26};nodes[26]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=22};nodes[27]=CK_Node.{kind=CK_Tag.expr_slice,type=16,a=28};nodes[28]=CK_Node.{kind=CK_Tag.expr_ident,type=19,borrow_binding=24};nodes[30]=CK_Node.{kind=CK_Tag.expr_call,type=1,proc=2,head=25,borrow_owner=20,loc=CK_Loc.{line=70,column=9,offset=709}};
 CR_run(b);if local {#assert !state[0].fatal && state[0].error_count==1 && errors[0].code=="E0383" && errors[0].loc.line==70 && errors[0].loc.column==9 && errors[0].loc.offset==709 && state[0].retain_report_count==0;}
 else {#assert !state[0].fatal && state[0].error_count==0 && state[0].retain_report_count==3;found:=false;for i:0..<state[0].retain_report_count {row:=reports[i];if row.kind==2 && row.owner==20 && row.site==30 {found=true;#assert row.facts_complete && !row.relation_complete && !row.forbidden && row.pending==1;}}#assert found;}
}
