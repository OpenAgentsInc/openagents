 a:=CB_query(b,2,5,path,out[..]);#assert !state[0].fatal && !a.incomplete && a.count==(ifx class_first then 1 else 2);b.retain_classes=!class_first;z:=CB_query(b,2,5,path,out[..]);#assert !state[0].fatal && !z.incomplete && z.count==(ifx class_first then 2 else 1);b.retain_classes=class_first;again:=CB_query(b,2,5,path,out[..]);#assert !state[0].fatal && again.count==a.count && work[0].queries==2;
}
