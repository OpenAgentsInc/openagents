// Checks: spatial frames and operators, with their fixture. A part of the
// checker: lib/compiler/checker.coax loads it (#12646).
#authority;
// M3 integration checks precede the implementation.
CK_spatial_fixture :: (c:CK_Context) {
 CK_quantity_fixture(c);c.state[0].used=21;c.state[0].type_count=24;
 c.nodes[3].next=21;c.nodes[21]=CK_Node.{kind=CK_Tag.struct_,name="World",type=23,frame_decl=true,frame=SP_Frame.{handedness=1,convention=SP_Convention.cartesian,continuity=SP_Continuity.continuous,min_rep=32}};
 c.types[23]=CK_Type.{kind=CK_Kind.struct_,name="World",decl=21,size=1,alignment=1};
}
#test "spatial fixture is an admitted frame tag and leaves interning the next node" {
 nodes:[512]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 size:=types[23].size;alignment:=types[23].alignment;types[23].size=0;types[23].alignment=0;
 CK_frame_layout(c,21);#assert state[0].error_count==0 && nodes[21].mark==2 && types[23].size==size && types[23].alignment==alignment;
 #assert state[0].used==21 && state[0].type_count==24;t:=CK_spatial_intern(c,SP_Kind.point,23,16,6,CK_Loc.{});#assert t==24 && types[t].decl==22 && state[0].used==25;
}
#forall "spatial interning owns complete kind frame unit representation and physical layout" kind:1..<3,rep:6..<8 {
 nodes:[512]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 t:=CK_spatial_intern(c,cast(SP_Kind)kind,23,16,rep,CK_Loc.{line=17,column=3,offset=99});
 #assert t!=0 && state[0].error_count==0;info:=types[t];n:=nodes[info.decl];width:=ifx rep==6 then 4 else 8;
 #assert info.kind==CK_Kind.struct_ && info.carrier==0 && info.size==3*width && info.alignment==width && info.space.kind==cast(SP_Kind)kind && info.space.frame==23 && info.space.unit==16 && info.space.rep==width*8;
 #assert n.scope==c.modules.count+1 && info.scope==n.scope && n.origin==info.decl && n.mark==2;
 if kind==1 {#assert n.name=="CoaxPoint3" && info.name==(ifx rep==6 then "Point3(World,Metre,f32)" else "Point3(World,Metre,f64)");}else {#assert n.name=="CoaxVector3" && info.name==(ifx rep==6 then "Vector3(World,Metre,f32)" else "Vector3(World,Metre,f64)");}
 #assert n.key==(ifx rep==6 then "f23u16r6" else "f23u16r7");
 names:=[3]string.["x","y","z"];field:=n.head;for i:0..<3 {#assert field!=0 && nodes[field].kind==CK_Tag.field && nodes[field].name==names[i] && nodes[field].type==rep && nodes[field].field_index==i*width;if i==2 {#assert n.tail==field;}field=nodes[field].next;}#assert field==0;
 #assert CK_spatial_intern(c,cast(SP_Kind)kind,23,16,rep,CK_Loc.{})==t;
 other:=CK_spatial_intern(c,ifx kind==1 then SP_Kind.vector else SP_Kind.point,23,16,rep,CK_Loc.{});#assert other!=0 && other!=t;
}
#forall "spatial admission refuses wrong frame unit precision and logical scale roles" bad:0..<7 {
 nodes:[256]CK_Node;types:[96]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[8192]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);frame:=23;unit:=16;rep:=6;
 if bad==0 {frame=16;}if bad==1 {unit=7;}if bad==2 {nodes[2].unit.length=0;}if bad==3 {nodes[21].frame.min_rep=64;}if bad==4 {rep=19;}if bad==5 {nodes[21].frame.handedness=0;}if bad==6 {nodes[2].unit.numerator=0;}
 #assert CK_spatial_intern(c,SP_Kind.point,frame,unit,rep,CK_Loc.{line=17,column=3,offset=99})==0;
 #assert state[0].error_count==1 && errors[0].code=="E0833" && state[0].spatial_types==0 && state[0].instance_count==0;
 messages:=[7]string.["spatial arguments must name admitted concrete frame and unit tags","spatial types require concrete frame and unit tags and f32 or f64","Point3 requires a physical length unit","frame World requires f64 spatial coordinates","spatial types require concrete frame and unit tags and f32 or f64","spatial frame or unit metadata is invalid","spatial frame or unit metadata is invalid"];#assert errors[0].message==messages[bad];
}
#forall "spatial operators lower exact affine result and one whole-operand call" test:0..<9,rep:6..<8 {
 nodes:[2048]CK_Node;types:[256]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[32768]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 point:=CK_spatial_intern(c,SP_Kind.point,23,16,rep,CK_Loc.{});vector:=CK_spatial_intern(c,SP_Kind.vector,23,16,rep,CK_Loc.{});
 lefts:=[9]int.[point,vector,vector,point,vector,point,vector,rep,vector];rights:=[9]int.[point,vector,vector,vector,point,vector,rep,vector,rep];ops:=[9]u32.[35,34,35,34,34,35,36,36,37];kinds:=[9]SP_Kind.[SP_Kind.vector,SP_Kind.vector,SP_Kind.vector,SP_Kind.point,SP_Kind.point,SP_Kind.point,SP_Kind.vector,SP_Kind.vector,SP_Kind.vector];a:=lefts[test];b:=rights[test];
 nodes[10]=CK_Node.{kind=ifx a==rep then CK_Tag.expr_float else CK_Tag.expr_struct,type=a,mark=1};nodes[11]=CK_Node.{kind=ifx b==rep then CK_Tag.expr_float else CK_Tag.expr_struct,type=b,mark=1};nodes[12]=CK_Node.{kind=CK_Tag.expr_binary,op=ops[test],a=10,b=11,next=18,loc=CK_Loc.{line=73,column=9,offset=123}};
 result:=CK_spatial_binary(c,12,a,b);#assert result!=0 && state[0].error_count==0 && types[result].space.kind==kinds[test] && types[result].carrier==0;
 call:=nodes[12];#assert call.kind==CK_Tag.expr_call && call.mark==2 && !CK_generated(call.mark) && call.type==result && call.proc!=0 && call.next==18 && call.loc.offset==123 && call.head!=10 && call.tail!=11;
 #assert nodes[call.head].type==a && nodes[call.head].next==call.tail && nodes[call.tail].type==b && nodes[call.tail].next==0 && nodes[10].next==0 && nodes[11].next==0;
 helper:=nodes[call.proc];#assert helper.kind==CK_Tag.proc && helper.type==result && helper.origin==call.proc && helper.scope==c.modules.count+1 && helper.collides && helper.skip_authority && !helper.flag && !helper.flag2;
 keys32:=[9]string.["o35a24b24r25","o34a25b25r25","o35a25b25r25","o34a24b25r24","o34a25b24r24","o35a24b25r24","o36a25b6r25","o36a6b25r25","o37a25b6r25"];
 keys64:=[9]string.["o35a24b24r25","o34a25b25r25","o35a25b25r25","o34a24b25r24","o34a25b24r24","o35a24b25r24","o36a25b7r25","o36a7b25r25","o37a25b7r25"];#assert helper.name=="CoaxSpatialOp" && helper.key==(ifx rep==6 then keys32[test] else keys64[test]);
 #assert nodes[helper.head].name=="left" && nodes[helper.head].type==a && nodes[helper.tail].name=="right" && nodes[helper.tail].type==b && nodes[helper.head].next==helper.tail;
 ret:=nodes[nodes[helper.b].head];aggregate:=nodes[ret.a];#assert nodes[helper.b].kind==CK_Tag.stmt_block && ret.kind==CK_Tag.stmt_return && nodes[helper.b].tail==nodes[helper.b].head && aggregate.kind==CK_Tag.expr_struct && aggregate.mark==1 && aggregate.type==result;
 field:=aggregate.head;names:=[3]string.["x","y","z"];for axis:0..<3 {f:=nodes[field];value:=nodes[f.a];#assert f.kind==CK_Tag.field_init && f.name==names[axis] && f.field_index==axis && value.kind==CK_Tag.expr_binary && value.op==ops[test] && value.type==rep && CK_generated(value.mark);
  inputs:=[2]int.[value.a,value.b];expected:=[2]int.[a,b];for side:0..<2 {item:=nodes[inputs[side]];if expected[side]==rep {#assert item.kind==CK_Tag.expr_ident && item.type==rep;}else {#assert item.kind==CK_Tag.expr_field && item.name==names[axis] && item.field_index==axis && item.type==rep && CK_generated(item.mark);item=nodes[item.a];}#assert item.kind==CK_Tag.expr_ident && item.name==(ifx side==0 then "left" else "right") && item.type==expected[side] && CK_generated(item.mark);}
  if axis==2 {#assert aggregate.tail==field;}field=f.next;}#assert field==0;
 before:=state[0].instance_count;nodes[13]=CK_Node.{kind=CK_Tag.expr_binary,op=ops[test],a=10,b=11};#assert CK_spatial_binary(c,13,a,b)==result && nodes[13].proc==call.proc && state[0].instance_count==before;
}
#forall "spatial negation uses one immutable vector argument" rep:6..<8 {
 nodes:[1024]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 t:=CK_spatial_intern(c,SP_Kind.vector,23,16,rep,CK_Loc.{});nodes[10]=CK_Node.{kind=CK_Tag.expr_struct,type=t,mark=1};nodes[12]=CK_Node.{kind=CK_Tag.expr_unary,op=35,a=10,next=18};#assert CK_spatial_unary(c,12,t)==t && state[0].error_count==0;
 helper:=nodes[nodes[12].proc];#assert helper.head==helper.tail && nodes[helper.head].next==0 && nodes[helper.head].type==t;aggregate:=nodes[nodes[nodes[helper.b].head].a];field:=aggregate.head;
 for axis:0..<3 {v:=nodes[nodes[field].a];#assert v.kind==CK_Tag.expr_unary && v.op==35 && v.b==0 && v.type==rep && nodes[v.a].field_index==axis;field=nodes[field].next;}
}
#forall "spatial pool refusal publishes no partial type cache" fault:0..<5 {
 nodes:[256]CK_Node;types:[96]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[8192]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 if fault==0 {c.nodes=nodes[0..<22];}if fault==1 {c.types=types[0..<24];}if fault==2 {c.nodes=nodes[0..<25];}if fault==3 {state[0].instance_count=256;}if fault==4 {c.bytes=bytes[0..<0];}
 #assert CK_spatial_intern(c,SP_Kind.point,23,16,7,CK_Loc.{})==0 && state[0].error_count==1 && state[0].spatial_types==0;
 if fault==3 {#assert errors[0].code=="E0339" && state[0].instance_count==256;}else {#assert errors[0].code=="E0381" && state[0].fatal && state[0].instance_count==0;}
}
#forall "spatial global constructors resolve concrete arguments and refuse backend or arity" test:0..<5 {
 nodes:[512]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);state[0].used=25;
 nodes[22]=CK_Node.{kind=CK_Tag.type_named,name="Point3",head=23,tail=25};nodes[23]=CK_Node.{kind=CK_Tag.type_named,name="World",next=24};nodes[24]=CK_Node.{kind=CK_Tag.type_named,name="Metre",next=25};nodes[25]=CK_Node.{kind=CK_Tag.type_named,name="f64"};
 if test==1 {nodes[22].name="Vector3";}if test==2 {nodes[24].next=0;}if test==3 {nodes[25].name="f32";nodes[21].frame.min_rep=64;}if test==4 {state[0].quantity_device=true;}
 r:=CK_resolve(c,22,CK_Access.value);if test<2 {#assert r!=0 && state[0].error_count==0 && nodes[21].mark==2 && types[r].space.kind==(ifx test==0 then SP_Kind.point else SP_Kind.vector) && types[r].space.rep==64;}
 else {#assert r==0 && state[0].error_count==1;if test==4 {#assert errors[0].code=="E0836";}else {#assert errors[0].code=="E0833";}}
}
#forall "frame declarations reject each malformed role shape and metadata" bad:0..<7 {
 nodes:[128]CK_Node;types:[96]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[8192]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 if bad==0 {nodes[21].quantity=1;}if bad==1 {nodes[21].d=4;}if bad==2 {nodes[21].head=6;}if bad==3 {nodes[21].frame.handedness=0;}if bad==4 {nodes[21].frame.convention=SP_Convention.optical;nodes[21].frame.handedness= -1;}if bad==5 {nodes[21].frame.continuity=SP_Continuity.unset;}if bad==6 {nodes[21].frame.min_rep=16;}
 CK_frame_layout(c,21);#assert state[0].error_count==1 && errors[0].code=="E0832" && nodes[21].mark==2 && types[23].size==1 && types[23].alignment==1;
}
