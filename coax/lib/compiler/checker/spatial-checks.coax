 nodes:[1024]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 v:=CK_spatial_intern(c,SP_Kind.vector,23,16,7,CK_Loc.{});nodes[10]=CK_Node.{kind=CK_Tag.expr_struct,type=v,mark=1};nodes[11]=nodes[10];nodes[12]=CK_Node.{kind=CK_Tag.expr_binary,a=10,b=11,op=34};#assert CK_spatial_binary(c,12,v,v)==v;before:=nodes[12];
 if fault==0 {state[0].instance_count=256;}if fault==1 {c.nodes=nodes[0..<state[0].used+2];}if fault==2 {c.bytes=bytes[0..<0];}
 #assert !CK_prepare_spatial_mutations(c) && state[0].error_count==1 && nodes[12].proc==before.proc && nodes[12].head==before.head && nodes[12].tail==before.tail && nodes[12].mutation_status==CK_Mutation.unprepared && nodes[12].mutation_proc==0;
 #assert errors[0].code==(ifx fault==0 then "E0339" else "E0381");
}
#forall "spatial mutation preparation refuses unknown provenance and preserves primary location" bad:0..<6 {
 nodes:[64]CK_Node;types:[32]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[4096]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};state[0].used=2;
 nodes[2]=CK_Node.{kind=CK_Tag.expr_call,mark=2,lowering=CK_Lowering.spatial_binary,loc=CK_Loc.{line=17,column=9,offset=33}};
 if bad==0 {nodes[2].kind=CK_Tag.expr_struct;}if bad==1 {nodes[2].mark=1;}if bad==2 {nodes[2].lowering=CK_Lowering.invalid;}if bad==3 {nodes[2].op=99;}if bad==4 {nodes[2].kind=CK_Tag.expr_struct;nodes[2].lowering=CK_Lowering.spatial_unary;}if bad==5 {nodes[2].mark=1;nodes[2].lowering=CK_Lowering.spatial_unary;}
 #assert !CK_prepare_spatial_mutations(c) && state[0].error_count==1 && errors[0].code=="E0834" && errors[0].message=="spatial mutation source metadata is inconsistent" && errors[0].loc.line==17 && errors[0].loc.column==9 && errors[0].loc.offset==33;
}
