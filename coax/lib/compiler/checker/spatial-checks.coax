 values:=[10]SP_Op.[SP_Op.add,SP_Op.sub,SP_Op.mul,SP_Op.div,SP_Op.eq,SP_Op.ne,SP_Op.lt,SP_Op.dot,SP_Op.cross,SP_Op.invalid];expected:=[10]u32.[34,35,36,37,0,0,0,0,0,0];#assert CK_spatial_token(values[op])==expected[op];
}

#test "spatial mutation scan covers its first live node and excludes unused tail" {
 nodes:[8]CK_Node;types:[1]CK_Type;locals:[1]CK_Local;errors:[8]CK_Error;bytes:[1024]u8;state:[1]CK_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
 nodes[1]=CK_Node.{kind=CK_Tag.expr_call,mark=2,lowering=CK_Lowering.invalid};state[0].used=1;
 #assert !CK_prepare_spatial_mutations(c) && state[0].error_count==1 && errors[0].code=="E0834";
 nodes[1].lowering=CK_Lowering.none;nodes[2]=CK_Node.{kind=CK_Tag.expr_call,mark=2,lowering=CK_Lowering.invalid};state[0].error_count=0;
 #assert CK_prepare_spatial_mutations(c) && state[0].error_count==0;
}

