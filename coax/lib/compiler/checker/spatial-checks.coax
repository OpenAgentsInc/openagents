 nodes:[1024]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 p:=CK_spatial_intern(c,SP_Kind.point,23,16,7,CK_Loc.{});state[0].instance_count=256;nodes[10]=CK_Node.{kind=CK_Tag.expr_struct,type=p,mark=1};nodes[11]=nodes[10];nodes[12]=CK_Node.{kind=CK_Tag.expr_binary,a=10,b=11,op=35};
 #assert CK_spatial_binary(c,12,p,p)==0 && state[0].error_count==1 && errors[0].code=="E0339" && state[0].spatial_helpers==0 && nodes[12].kind==CK_Tag.expr_binary;
}

#forall "spatial mutation preparation preserves source tokens arguments and exact alternate signatures" test:0..<10,rep:6..<8 {
 nodes:[2048]CK_Node;types:[256]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[32768]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 point:=CK_spatial_intern(c,SP_Kind.point,23,16,rep,CK_Loc.{});vector:=CK_spatial_intern(c,SP_Kind.vector,23,16,rep,CK_Loc.{});
 lefts:=[10]int.[point,point,vector,vector,vector,vector,point,vector,rep,vector];rights:=[10]int.[vector,vector,vector,vector,rep,rep,point,point,vector,0];tokens:=[10]u32.[34,35,34,35,36,37,35,34,36,35];alternates:=[10]u32.[35,34,35,34,37,36,0,0,0,0];a:=lefts[test];b:=rights[test];
 nodes[10]=CK_Node.{kind=CK_Tag.expr_struct,type=a,mark=1};nodes[11]=CK_Node.{kind=CK_Tag.expr_struct,type=b,mark=1};nodes[12]=CK_Node.{kind=CK_Tag.expr_binary,a=10,b=11,op=tokens[test],loc=CK_Loc.{line=17,column=9,offset=33},next=18};
 result:=ifx test==9 then CK_spatial_unary(c,12,a) else CK_spatial_binary(c,12,a,b);#assert result!=0;
 before:=nodes[12];#assert before.op==tokens[test] && before.lowering==(ifx test==9 then CK_Lowering.spatial_unary else CK_Lowering.spatial_binary) && before.mutation_status==CK_Mutation.unprepared && before.mutation_proc==0 && before.mutation_op==0;
 #assert CK_prepare_spatial_mutations(c) && state[0].error_count==0;after:=nodes[12];
 #assert after.proc==before.proc && after.head==before.head && after.tail==before.tail && after.type==before.type && after.next==18 && after.op==before.op && after.mark==2 && after.loc.line==17 && after.loc.column==9 && after.loc.offset==33;
 #assert nodes[before.head].type==a && nodes[before.tail].type==(ifx test==9 then a else b);
 if test<6 {#assert after.mutation_status==CK_Mutation.eligible && after.mutation_op==alternates[test] && after.mutation_proc!=0 && after.mutation_proc!=before.proc;h:=nodes[after.mutation_proc];#assert h.kind==CK_Tag.proc && h.type==result && nodes[h.head].type==a && nodes[h.tail].type==b && nodes[h.head].next==h.tail && nodes[h.tail].next==0;
  aggregate:=nodes[nodes[nodes[h.b].head].a];field:=aggregate.head;for axis:0..<3 {#assert nodes[nodes[field].a].op==alternates[test];field=nodes[field].next;}#assert field==0;
 }else {#assert after.mutation_status==(ifx test==9 then CK_Mutation.unsupported else CK_Mutation.no_alternative) && after.mutation_proc==0 && after.mutation_op==0;}
}
#forall "spatial mutation candidate rejects inconsistent checked call facts" bad:0..<10 {
 nodes:[1024]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 v:=CK_spatial_intern(c,SP_Kind.vector,23,16,7,CK_Loc.{});nodes[10]=CK_Node.{kind=CK_Tag.expr_struct,type=v,mark=1};nodes[11]=nodes[10];nodes[12]=CK_Node.{kind=CK_Tag.expr_binary,a=10,b=11,op=34};#assert CK_spatial_binary(c,12,v,v)==v;h:=nodes[12].proc;
 if bad==0 {nodes[12].kind=CK_Tag.expr_struct;}if bad==1 {nodes[12].mark=1;}if bad==2 {nodes[12].lowering=CK_Lowering.spatial_unary;}if bad==3 {nodes[nodes[12].head].next=0;}if bad==4 {nodes[12].proc=0;}
 if bad==5 {nodes[h].kind=CK_Tag.struct_;}if bad==6 {nodes[h].type=7;}if bad==7 {nodes[nodes[h].head].next=0;}if bad==8 {nodes[nodes[h].head].type=7;}if bad==9 {nodes[nodes[h].tail].type=6;}
 r:=CK_spatial_mutation_candidate(c,12);#assert r.status==SOM_Status.metadata && r.operation==SP_Op.invalid;
}
