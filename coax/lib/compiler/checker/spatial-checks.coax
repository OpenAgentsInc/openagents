 nodes:[512]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);state[0].used=25;
 nodes[22]=CK_Node.{kind=CK_Tag.type_named,name="Point3",head=23,tail=25};nodes[23]=CK_Node.{kind=CK_Tag.type_named,name="World",next=24};nodes[24]=CK_Node.{kind=CK_Tag.type_named,name="Metre",next=25};nodes[25]=CK_Node.{kind=CK_Tag.type_named,name="f64"};nodes[23+missing].name="Missing";
 #assert CK_spatial_type(c,22)==0 && state[0].error_count==1 && errors[0].code=="E0302" && state[0].spatial_types==0;
}
#forall "spatial literals coerce both source orders once and preserve overflow diagnostic" rep:6..<8,side:0..<2,overflow:0..<2 {
 nodes:[1024]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 v:=CK_spatial_intern(c,SP_Kind.vector,23,16,rep,CK_Loc.{});literal:=10+side;other:=11-side;nodes[other]=CK_Node.{kind=CK_Tag.expr_struct,type=v,mark=1};nodes[literal]=CK_Node.{kind=CK_Tag.expr_float,type=5,floating=ifx overflow==0 then 0x4000000000000000 else 0x7fefffffffffffff};nodes[12]=CK_Node.{kind=CK_Tag.expr_binary,a=10,b=11,op=36};
 r:=CK_binary(c,12,CK_Hint.{});if overflow==1 && rep==6 {#assert r==0 && state[0].error_count==1 && errors[0].code=="E0350" && state[0].spatial_helpers==0;}
 else {#assert r==v && nodes[literal].type==rep && state[0].error_count==0;}
}
#forall "spatial unary refusal returns none and its primary affine diagnostic" kind:1..<3,op:0..<2 {
 nodes:[512]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 t:=CK_spatial_intern(c,cast(SP_Kind)kind,23,16,7,CK_Loc.{});nodes[10]=CK_Node.{kind=CK_Tag.expr_struct,type=t,mark=1};nodes[12]=CK_Node.{kind=CK_Tag.expr_unary,a=10,op=ifx op==0 then 35 else 33};if kind==2 && op==0 {#assert CK_spatial_unary(c,12,t)==t;}else {#assert CK_spatial_unary(c,12,t)==0 && state[0].error_count==1 && errors[0].code=="E0834" && state[0].spatial_helpers==0;}
}
