 t:=CK_spatial_intern(c,SP_Kind.point,23,16,7,CK_Loc.{});nodes[12]=CK_Node.{kind=CK_Tag.expr_call,name="type_info"};#assert CK_meta_query(c,12,t)==0 && state[0].error_count==1 && errors[0].code=="E0835";
}
#test "spatial cache never merges equal-metadata frames units or representations" {
 nodes:[2048]CK_Node;types:[256]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[32768]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 nodes[22]=nodes[21];nodes[22].name="Other";nodes[22].type=24;nodes[21].next=22;types[24]=types[23];types[24].name="Other";types[24].decl=22;state[0].used=22;state[0].type_count=25;
 frames:=[2]int.[23,24];units:=[2]int.[16,22];created:[16]int;count:=0;
 for kind:1..<3 {for frame:frames {for unit:units {for rep:6..<8 {t:=CK_spatial_intern(c,cast(SP_Kind)kind,frame,unit,rep,CK_Loc.{});#assert t!=0 && state[0].error_count==0;for i:0..<count {#assert created[i]!=t;}created[count]=t;count+=1;#assert CK_spatial_intern(c,cast(SP_Kind)kind,frame,unit,rep,CK_Loc.{})==t;}}}}
 #assert count==16 && state[0].instance_count==16;
 again:=0;for kind:1..<3 {for frame:frames {for unit:units {for rep:6..<8 {#assert CK_spatial_intern(c,cast(SP_Kind)kind,frame,unit,rep,CK_Loc.{})==created[again];again+=1;}}}}#assert state[0].instance_count==16;
 t:=created[0];id:=CK_new(c,CK_Tag.struct_,CK_Loc.{});nominal:=CK_new_type(c,CK_Type.{kind=CK_Kind.struct_,name="CoaxPoint3f23u16r6",decl=id,size=12,alignment=4});nodes[id]=CK_Node.{kind=CK_Tag.struct_,name="CoaxPoint3f23u16r6",type=nominal,mark=2};#assert CK_mangle(c,t)!=CK_mangle(c,nominal);
}
#forall "spatial helper allocation never publishes a partial procedure" spare:1..<35 {
 nodes:[1024]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 t:=CK_spatial_intern(c,SP_Kind.vector,23,16,7,CK_Loc.{});before:=state[0].instance_count;c.nodes=nodes[0..<state[0].used+spare];r:=CK_spatial_helper(c,35,t,0,t,CK_Loc.{});
 if state[0].fatal {#assert r==0 && state[0].spatial_helpers==0 && state[0].instance_count==before && state[0].error_count==1 && errors[0].code=="E0381";}else {#assert r!=0 && state[0].instance_count==before+1;}
}
#test "spatial interning and helpers do not escape prior fatal admission" {
 nodes:[512]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 t:=CK_spatial_intern(c,SP_Kind.vector,23,16,7,CK_Loc.{});h:=CK_spatial_helper(c,35,t,0,t,CK_Loc.{});#assert h!=0;state[0].fatal=true;
 #assert CK_spatial_intern(c,SP_Kind.vector,23,16,7,CK_Loc.{})==0 && CK_spatial_helper(c,35,t,0,t,CK_Loc.{})==0;
}
#forall "spatial token lowering preserves exact admitted operations and invalid sentinel" token:0..<64 {
 expected:=SP_Op.invalid;if token==34 {expected=SP_Op.add;}if token==35 {expected=SP_Op.sub;}if token==36 {expected=SP_Op.mul;}if token==37 {expected=SP_Op.div;}
 #assert CK_spatial_operation(cast(u32)token)==expected;
}
#test "spatial helper cache retains distinct typed operations through nonhead reuse" {
 nodes:[2048]CK_Node;types:[256]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[32768]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 p:=CK_spatial_intern(c,SP_Kind.point,23,16,7,CK_Loc.{});v:=CK_spatial_intern(c,SP_Kind.vector,23,16,7,CK_Loc.{});ops:=[4]u32.[35,34,34,34];lefts:=[4]int.[p,v,p,v];rights:=[4]int.[p,v,v,p];results:=[4]int.[v,v,p,p];ids:[4]int;
 for i:0..<4 {ids[i]=CK_spatial_helper(c,ops[i],lefts[i],rights[i],results[i],CK_Loc.{});#assert ids[i]!=0 && state[0].error_count==0;for j:0..<i {#assert ids[i]!=ids[j];}}
 before:=state[0].instance_count;for i:0..<4 {#assert CK_spatial_helper(c,ops[i],lefts[i],rights[i],results[i],CK_Loc.{})==ids[i];}#assert state[0].instance_count==before && before==6;
 nodes[10]=CK_Node.{kind=CK_Tag.expr_struct,type=p,mark=1};nodes[11]=CK_Node.{kind=CK_Tag.expr_struct,type=v,mark=1};nodes[12]=CK_Node.{kind=CK_Tag.expr_binary,op=34,a=10,b=11};#assert CK_binary(c,12,CK_Hint.{})==p && CK_expr(c,12,CK_Hint.{})==p && state[0].error_count==0;
}
#forall "spatial invalid affine and mismatch decisions publish no helper" failure:0..<8 {
 nodes:[1024]CK_Node;types:[256]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[32768]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 p:=CK_spatial_intern(c,SP_Kind.point,23,16,6,CK_Loc.{});v:=CK_spatial_intern(c,SP_Kind.vector,23,16,6,CK_Loc.{});a:=p;b:=p;op:u32=34;
 if failure==1 {a=v;b=p;op=35;}if failure==2 {b=6;op=36;}if failure==3 {a=v;b=7;op=36;}if failure==4 {a=v;b=19;op=36;}if failure==5 {a=v;b=CK_spatial_intern(c,SP_Kind.vector,23,22,6,CK_Loc.{});}if failure==6 {a=v;b=v;op=44;}
 if failure==7 {id:=CK_new(c,CK_Tag.struct_,CK_Loc.{});frame:=CK_new_type(c,CK_Type.{kind=CK_Kind.struct_,name="Other",decl=id,size=1,alignment=1});nodes[id]=nodes[21];nodes[id].name="Other";nodes[id].type=frame;a=v;b=CK_spatial_intern(c,SP_Kind.vector,frame,16,6,CK_Loc.{});}
 nodes[10]=CK_Node.{kind=ifx a==6 || a==7 then CK_Tag.expr_float else CK_Tag.expr_struct,type=a,mark=1};nodes[11]=CK_Node.{kind=ifx b==6 || b==7 then CK_Tag.expr_float else CK_Tag.expr_struct,type=b,mark=1};nodes[12]=CK_Node.{kind=CK_Tag.expr_binary,op=op,a=10,b=11,loc=CK_Loc.{line=17,column=3,offset=99}};
 #assert CK_spatial_binary(c,12,a,b)==0 && state[0].error_count==1 && errors[0].code=="E0834" && errors[0].loc.offset==99 && state[0].spatial_helpers==0;
 messages:=[8]string.[
 "affine operation is not admitted: Point3(World,Metre,f32) and Point3(World,Metre,f32)",
 "affine operation is not admitted: Vector3(World,Metre,f32) and Point3(World,Metre,f32)",
 "affine operation is not admitted: Point3(World,Metre,f32) and f32",
 "spatial carriers differ: Vector3(World,Metre,f32) and f64",
 "spatial scaling needs a matching raw f32 or f64: Vector3(World,Metre,f32) and Quantity(Metre,f64)",
 "nominal units differ: Vector3(World,Metre,f32) and Vector3(World,Target,f32)",
 "affine operation is not admitted: Vector3(World,Metre,f32) and Vector3(World,Metre,f32)",
 "nominal frames differ: Vector3(World,Metre,f32) and Vector3(Other,Metre,f32)"];#assert errors[0].message==messages[failure];
}
#forall "checked aggregate and call headers require exact provenance kind and target" kind:0..<5,mark:0..<4,proc:0..<3 {
 kinds:=[5]CK_Tag.[CK_Tag.expr_struct,CK_Tag.expr_array,CK_Tag.expr_call,CK_Tag.expr_ident,CK_Tag.expr_unary];want:=false;
 if mark==1 && kind<2 {want=true;}if mark==2 && kind==2 && proc!=0 {want=true;}
 #assert CK_prechecked(CK_Node.{kind=kinds[kind],mark=mark,proc=proc,type=7})==want;
}
#forall "spatial admission respects every live-range and declared-role boundary" invalid:0..<14 {
 nodes:[512]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);frame:=23;unit:=16;kind:=SP_Kind.point;
 if invalid==0 {frame=15;}if invalid==1 {frame=24;types[24]=types[23];}
 if invalid==2 {unit=15;}if invalid==3 {unit=24;types[24]=types[16];}
 if invalid==4 {kind=SP_Kind.invalid;}if invalid==5 {types[23].kind=CK_Kind.floating;}
 if invalid==6 {nodes[21].frame_decl=false;}if invalid==7 {nodes[21].quantity=1;}if invalid==8 {nodes[21].d=4;}if invalid==9 {nodes[21].head=6;}
 if invalid==10 {types[16].kind=CK_Kind.floating;}if invalid==11 {nodes[2].quantity=0;}if invalid==12 {nodes[2].generic=true;nodes[2].d=4;}if invalid==13 {kind=SP_Kind.raw;}
 #assert CK_spatial_intern(c,kind,frame,unit,7,CK_Loc.{})==0 && state[0].error_count==1 && errors[0].code=="E0833" && state[0].spatial_types==0;
 if invalid<5 || invalid==13 {#assert errors[0].message=="spatial types require concrete frame and unit tags and f32 or f64";}else {#assert errors[0].message=="spatial arguments must name admitted concrete frame and unit tags";}
}
#test "first nominal type can be an admitted frame and frame layout replaces stale shape" {
 nodes:[512]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 types[23]=types[16];types[16]=CK_Type.{kind=CK_Kind.struct_,name="World",decl=21,size=99,alignment=8};nodes[21].type=16;nodes[2].type=23;types[19].unit=23;types[20].elem=23;
 CK_frame_layout(c,21);#assert types[16].size==1 && types[16].alignment==1 && state[0].error_count==0;
 t:=CK_spatial_intern(c,SP_Kind.point,16,23,7,CK_Loc.{});#assert t!=0 && types[t].space.frame==16 && types[t].space.unit==23;
}
