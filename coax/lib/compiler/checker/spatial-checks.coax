 #assert CK_call(c,12,CK_Hint.{})==0 && state[0].error_count==1 && errors[0].code=="E0833" && errors[0].message=="spatial constructors are types, not runtime calls";
}
#forall "spatial call argument copies detach intrusive links and preserve original operands" unary:0..<2 {
 nodes:[1024]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 t:=CK_spatial_intern(c,SP_Kind.vector,23,16,7,CK_Loc.{});nodes[10]=CK_Node.{kind=CK_Tag.expr_struct,type=t,mark=1,next=14};nodes[11]=CK_Node.{kind=CK_Tag.expr_struct,type=t,mark=1,next=15};nodes[12]=CK_Node.{kind=ifx unary==1 then CK_Tag.expr_unary else CK_Tag.expr_binary,a=10,b=11,op=35,next=18};
 #assert CK_spatial_call(c,12,35,t,ifx unary==1 then 0 else t,t)==t && state[0].error_count==0;call:=nodes[12];#assert call.next==18 && nodes[10].next==14 && nodes[11].next==15 && nodes[call.tail].next==0;
 if unary==1 {#assert call.head==call.tail;}else {#assert call.head!=call.tail && nodes[call.head].next==call.tail;}
}
#forall "spatial refusal preserves operator and published helper cache across final copy failures" failure:0..<4 {
 nodes:[1024]CK_Node;types:[128]CK_Type;locals:[8]CK_Local;errors:[8]CK_Error;bytes:[16384]u8;state:[1]CK_State;c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_spatial_fixture(c);
 t:=CK_spatial_intern(c,SP_Kind.vector,23,16,7,CK_Loc.{});h:=CK_spatial_helper(c,35,t,t,t,CK_Loc.{});before:=state[0].instance_count;head:=state[0].spatial_helpers;
 nodes[10]=CK_Node.{kind=CK_Tag.expr_struct,type=t,mark=1};nodes[11]=nodes[10];nodes[12]=CK_Node.{kind=CK_Tag.expr_binary,a=10,b=11,op=35,next=18};op:u32=35;
 if failure<2 {c.nodes=nodes[0..<state[0].used+1+failure];}if failure==2 {state[0].instance_count=256;before=256;op=34;}if failure==3 {c.bytes=bytes[0..<0];op=34;}
 #assert h!=0 && CK_spatial_call(c,12,op,t,t,t)==0 && state[0].error_count==1 && state[0].spatial_helpers==head && state[0].instance_count==before;
 #assert nodes[12].kind==CK_Tag.expr_binary && nodes[12].a==10 && nodes[12].b==11 && nodes[12].op==35 && nodes[12].next==18;
 if failure==2 {#assert errors[0].code=="E0339";}else {#assert errors[0].code=="E0381" && state[0].fatal;}
}
