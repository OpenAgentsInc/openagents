// Type printing, local borrows, declarations, statements, globals, foreign and
// Metal admission, checks, coverage, effects and CK_run. A part of the
// checker: lib/compiler/checker.coax loads it (#12646).
#authority;
CK_print :: (c:CK_Context,id:int)->int {
  e:=c.nodes[id];if e.head==0 {CK_error(c,e.loc,"E0318","print needs a format string","print(\"text\\n\");");return 1;}
  fmt:=c.nodes[e.head];if fmt.kind!=CK_Tag.expr_string {ignored:=CK_value(c,e.head,CK_Hint.{});CK_error(c,fmt.loc,"E0319","print's format must be a string literal, so it can be checked","print(\"%\\n\", value);");return 1;}
  c.nodes[e.head].type=3;slots:=0;i:=0;
  while i<fmt.name.count {if fmt.name[i]!=37 {i+=1;continue;}run:=0;while i<fmt.name.count && fmt.name[i]==37 {run+=1;i+=1;}slots+=run%2;}
  given:=CK_list_count(c,e.head)-1;
  if slots!=given {a:="s";b:="s";if slots==1 {a="";}if given==1 {b="";}parts:=[8] string.["format has ",CK_count(c,slots)," '%' slot",a," but print was given ",CK_count(c,given)," value",b];CK_error(c,fmt.loc,"E0320",CK_text(c,parts[..]),"write '%%' for a literal percent sign");}
  arg:=c.nodes[e.head].next;while arg!=0 {t:=CK_value(c,arg,CK_Hint.{});if t==1 {CK_error(c,c.nodes[arg].loc,"E0321","this call returns nothing, so it cannot be printed","");}arg=c.nodes[arg].next;}return 1;
}

