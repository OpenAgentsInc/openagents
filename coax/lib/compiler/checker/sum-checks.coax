 nodes[1]=CK_Node.{kind=CK_Tag.file};nodes[2]=CK_Node.{kind=CK_Tag.expr_call,name="some",head=3,tail=3,loc=CK_Loc.{line=116,column=7}};nodes[3]=CK_Node.{kind=CK_Tag.expr_int,value=5};
 if result {nodes[3]=CK_Node.{kind=CK_Tag.expr_sum,type=16,a=4,sum_variant=0};nodes[4]=CK_Node.{kind=CK_Tag.expr_int,type=11};}
 t:=CK_value(c,2,CK_Hint.{});
 if result {#assert t==0 && state[0].error_count==1 && errors[0].code=="E0900" && nodes[2].kind==CK_Tag.expr_call && nodes[2].head==3;}
 else {#assert t>=17 && state[0].error_count==0 && nodes[2].kind==CK_Tag.expr_some && nodes[2].a==3 && nodes[2].head==0 && nodes[2].tail==0 && nodes[2].sum_variant==1;}
}
