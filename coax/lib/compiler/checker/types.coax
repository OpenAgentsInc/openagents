  if c.nodes[id].mark==1 {CK_error(c,c.nodes[id].loc,"E0340",CK_join3(c,"constant dependency cycle at '",c.nodes[id].name,"'"),"");return CK_NONE;}
  if c.state[0].constant_depth>=64 {CK_error(c,c.nodes[id].loc,"E0347","constant type dependency depth exceeds 64","");return CK_NONE;}
  c.state[0].constant_depth+=1;c.nodes[id].mark=1;
  count:=c.state[0].local_count;c.state[0].local_count=0;
  t:=CK_expr(c,c.nodes[id].a,CK_Hint.{});c.nodes[id].type=t;
  if c.types[t].kind==CK_Kind.result {CK_error(c,c.nodes[id].loc,"E0900","Result constants are outside the direct local/parameter/return handling profile","");c.nodes[id].type=0;}
  if t==4 {
