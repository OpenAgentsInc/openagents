      if (bits&9223372036854775807)!=0x7ff0000000000000 && (narrow&2147483647)==0x7f800000 && c.state[0].unevaluated==0 {
        text:[48] u8;count:=CM_g(bits,text[..]);parts:=[2] string.[cast(string)text[0..<count]," does not fit in f32"];CK_error(c,c.nodes[id].loc,"E0350",CK_text(c,parts[..]),"use f64, or a smaller value");c.nodes[id].type=0;return;
      }
