CK_cast :: (c:CK_Context,id:int)->int {
  e:=c.nodes[id];to:=CK_resolve(c,e.d,CK_Access.value);from:=CK_expr(c,e.a,CK_Hint.{type=to});if to==CK_NONE || from==CK_NONE {return CK_NONE;}
  if CK_sum(c,to) || CK_sum(c,from) {CK_error(c,e.loc,"E0903","sum tags and payloads cannot be cast directly","");return 0;}
  if CK_untyped(c,from) {
    direct:=CK_float(c,to) || (CK_integer(c,to) && from==4);
    if !e.flag && direct {CK_coerce(c,e.a,to);if c.nodes[e.a].type==0 {return CK_NONE;}CK_copy_expr(c,id,e.a,false);return c.nodes[id].type;}
    CK_coerce(c,e.a,CK_default(from));from=c.nodes[e.a].type;
  }
  ok:=false;
  if CK_numeric(c,from) && CK_numeric(c,to) {ok=!e.flag || (CK_integer(c,from) && CK_integer(c,to));}
  else if c.types[from].kind==CK_Kind.enum_ && CK_integer(c,to) {ok=!e.flag;}
  else if CK_integer(c,from) && c.types[to].kind==CK_Kind.enum_ {ok=!e.flag;}
  else if from==to {ok=!e.flag;}
  else if to==3 && c.types[from].kind==CK_Kind.view && c.types[from].elem==12 {ok=!e.flag;}
  if !ok {
