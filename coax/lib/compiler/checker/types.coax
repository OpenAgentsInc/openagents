  c.nodes[id].negative=v.negative;c.nodes[id].value=CM_raw(v);c.nodes[id].a=0;c.nodes[id].b=0;
}
CK_set_float :: (c:CK_Context,id:int,bits:u64) {c.nodes[id].kind=CK_Tag.expr_float;c.nodes[id].type=5;c.nodes[id].floating=bits;c.nodes[id].a=0;c.nodes[id].b=0;}
CK_as_double :: (c:CK_Context,id:int)->u64 {if c.nodes[id].type==5 {return c.nodes[id].floating;}return CM_to_float(CK_untyped_int(c,id));}
CK_coerce :: (c:CK_Context,id:int,to:int) {
  from:=c.nodes[id].type;if !CK_untyped(c,from) {return;}
  // an integer literal is a value of every numeric type, so of a numeric $T; each instance checks it again
  if from==4 && c.types[to].need==4 {c.nodes[id].type=to;return;}
  if from==4 && CK_integer(c,to) {
    v:=CK_untyped_int(c,id);t:=c.types[to];if !CM_fits(v,t.bits,t.is_signed) && c.state[0].unevaluated!=0 {v=CM_Int.{};}
    if !CM_fits(v,t.bits,t.is_signed) {
      if c.nodes[id].folded {parts:=[4] string.["integer overflow in a constant expression: ",CK_number(c,v)," does not fit in ",t.name];CK_error(c,c.nodes[id].loc,"E0407",CK_text(c,parts[..]),"");}
      else {parts:=[3] string.[CK_number(c,v)," does not fit in ",t.name];CK_error(c,c.nodes[id].loc,"E0350",CK_text(c,parts[..]),CK_join3(c,"use a wider type, or cast,trunc(",t.name,") to keep the low bits"));}
      c.nodes[id].type=0;return;
    }
    c.nodes[id].value=CM_canon(CM_raw(v),t.bits,t.is_signed);c.nodes[id].negative=false;c.nodes[id].type=to;return;
  }
