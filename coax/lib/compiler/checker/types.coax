}
CK_op :: (op:u32)->string {
  names:=[53] string.["end of file","identifier","keyword","integer","float","string","directive","annotation","'('","')'","'{'","'}'","'['","']'","','","';'","':'","'::'","':='","'->'","'.'","'..'","'..<'","'='","'+='","'-='","'*='","'/='","'%='","'&='","'|='","'^='","'<<='","'>>='","'+'","'-'","'*'","'/'","'%'","'&'","'|'","'^'","'<<'","'>>'","'=='","'!='","'<'","'<='","'>'","'>='","'&&'","'||'","'!'"];
  return names[cast(int)op];
}

CK_immutable :: (c:CK_Context,id:int)->string {
  e:=c.nodes[id];if e.kind==CK_Tag.expr_ident {local:=CK_local(c,e.name);if local>=0 {return c.locals[local].immutable;}return "constant";}
  if e.kind==CK_Tag.expr_field {if c.types[c.nodes[e.a].type].kind==CK_Kind.struct_ {return CK_immutable(c,e.a);}return "count";}
  if e.kind==CK_Tag.expr_index {kind:=c.types[c.nodes[e.a].type].kind;if kind==CK_Kind.view {return "";}if kind==CK_Kind.string_ {return "string byte";}return CK_immutable(c,e.a);}
  return "temporary";
}
CK_mutable :: (c:CK_Context,id:int,loc:CK_Loc) {
  if c.nodes[id].kind==CK_Tag.expr_ident && c.types[c.nodes[id].type].kind==CK_Kind.result {CK_error(c,loc,"E0908","a Result binding cannot be reassigned","");return;}
  why:=CK_immutable(c,id);if why=="" {return;}
  if why=="constant" {CK_error(c,loc,"E0344","constants cannot be assigned","");}
  else if why=="parameter" {CK_error(c,loc,"E0344","parameters cannot be assigned","copy it into a local variable");}
  else if why=="string byte" {CK_error(c,loc,"E0359","strings are immutable","copy the bytes into a '[N] u8'");}
  else if why=="count" {CK_error(c,loc,"E0359","'.count' cannot be assigned","");}
  else if why=="temporary" {CK_error(c,loc,"E0359","this value is a temporary and cannot be assigned","store it in a variable first");}
  else {CK_error(c,loc,"E0359",CK_join3(c,"a ",why," cannot be assigned"),"copy it into a local variable");}
}
CK_field_list :: (c:CK_Context,id:int,members:bool)->string {
  text:="its fields are:";if members {text="its members are:";}field:=c.nodes[id].head;
  while field!=CK_NONE {text=CK_join3(c,text," ",c.nodes[field].name);field=c.nodes[field].next;}
  if !members && c.nodes[id].head==0 {text="it has no fields";}return text;
}
CK_field :: (c:CK_Context,id:int)->int {
  e:=c.nodes[id];left:=c.nodes[e.a];
  // alias.NAME is a qualified value; alias.Enum.member a qualified member.
  if CK_qualifier(c,e.a)>=0 {c.nodes[id].kind=CK_Tag.expr_ident;c.nodes[id].name2=left.name;c.nodes[id].loc=left.loc;c.nodes[id].a=CK_NONE;return CK_expr(c,id,CK_Hint.{});}
  en:=CK_NONE;
  if left.kind==CK_Tag.expr_field {target:=CK_qualifier(c,left.a);if target>=0 {en=CK_scan(c,CK_Tag.enum_,left.name,target,true);}}
  if left.kind==CK_Tag.expr_ident && CK_lookup(c,CK_Tag.constant,e.a)==0 {en=CK_lookup(c,CK_Tag.enum_,e.a);}
  if en!=CK_NONE {
    member:=c.nodes[en].head;while member!=CK_NONE {if c.nodes[member].name==e.name {c.nodes[id].kind=CK_Tag.expr_enum;c.nodes[id].value=c.nodes[member].value;c.nodes[e.a].type=c.nodes[en].type;return c.nodes[en].type;}member=c.nodes[member].next;}
      parts:=[5] string.["enum '",c.nodes[en].name,"' has no member '",e.name,"'"];CK_error(c,e.loc,"E0351",CK_text(c,parts[..]),CK_field_list(c,en,true));return CK_NONE;
  }
  t:=CK_expr(c,e.a,CK_Hint.{});if t==CK_NONE {return CK_NONE;}kind:=c.types[t].kind;
  if CK_sum(c,t) {CK_error(c,e.loc,"E0903","sum payloads are accessible only through handling forms","");return 0;}
  if e.name=="count" && (kind==CK_Kind.array || kind==CK_Kind.view || t==3) {c.nodes[id].field_index= -2;return 11;}
  if kind==CK_Kind.struct_ {
    d:=c.types[t].decl;f:=c.nodes[d].head;index:=0;while f!=0 {if c.nodes[f].name==e.name {c.nodes[id].field_index=index;if c.nodes[e.a].kind==CK_Tag.expr_struct && c.nodes[e.a].mark==1 {value:=c.nodes[CK_at(c,c.nodes[e.a].head,index)].a;CK_copy_expr(c,id,value,true);}return c.nodes[f].type;}index+=1;f=c.nodes[f].next;}
    parts:=[5] string.["struct '",c.nodes[d].name,"' has no field '",e.name,"'"];CK_error(c,e.loc,"E0351",CK_text(c,parts[..]),CK_field_list(c,d,false));return CK_NONE;
  }
  fix:="";if kind==CK_Kind.array || kind==CK_Kind.view || t==3 {fix="it has '.count'";}
  parts:=[4] string.[c.types[t].name," has no field '",e.name,"'"];CK_error(c,e.loc,"E0351",CK_text(c,parts[..]),fix);return CK_NONE;
