}
CK_default :: (t:int)->int {if t==4 {return 11;}if t==5 {return 7;}return t;}
CK_value :: (c:CK_Context,id:int,want:CK_Hint)->int {t:=CK_expr(c,id,want);if CK_untyped(c,t) {to:=CK_default(t);if CK_numeric(c,want.type) {to=want.type;}CK_coerce(c,id,to);}return c.nodes[id].type;}
CK_fold_binary :: (c:CK_Context,id:int)->int {
  e:=c.nodes[id];any_float:=c.nodes[e.a].type==5 || c.nodes[e.b].type==5;
  if e.op>=44 && e.op<=49 {t:=11;if any_float {t=7;}CK_coerce(c,e.a,t);CK_coerce(c,e.b,t);return 2;}
  if e.op==50 || e.op==51 {CK_error(c,e.loc,"E0312",CK_join2(c,CK_op(e.op)," needs two bools, found numbers"),"");return CK_NONE;}
  if any_float {
