// Type resolution: locals, interning, constant folding, layout, coercion,
// fields, casts, spatial, unit and quantity types. A part of the checker:
// lib/compiler/checker.coax loads it (#12646).
#authority;
CK_local :: (c:CK_Context,name:string)->int {i:=c.state[0].local_count;while i>0 {i-=1;at:=i;if c.locals[at].name==name {return at;}}return -1;}
CK_builtin_name :: (c:CK_Context,name:string)->bool {return CK_spatial_constructor(name,"")!=SP_Kind.raw || CK_unit_constructor(name,"")!=0 || name=="Result" || name=="convert_unit" || name=="type_name" || name=="field_info" || name=="enum_info" || (c.state[0].basic && name=="print") || name=="len" || name=="byte_at" || CK_intrinsic(name)!=0 || CK_byte_intrinsic(name)!=0;}
CK_intern :: (c:CK_Context,kind:CK_Kind,elem:int,length:int)->int {
  for i:16..<c.state[0].type_count {t:=c.types[i];if t.kind==kind && t.elem==elem && t.length==length {return i;}}
  name:="";size:=16;alignment:=8;
  if kind==CK_Kind.array && length<0 {prefix:=CK_join3(c,"[",c.types[-length].name,"] ");name=CK_join2(c,prefix,c.types[elem].name);size=0;alignment=c.types[elem].alignment;}
  else if kind==CK_Kind.array {prefix:=CK_join3(c,"[",CK_count(c,length),"] ");name=CK_join2(c,prefix,c.types[elem].name);size=c.types[elem].size*length;alignment=c.types[elem].alignment;}
  else {name=CK_join2(c,"[] ",c.types[elem].name);}
  id:=CK_new_type(c,CK_Type.{kind=kind,name=name,size=size,alignment=alignment,elem=elem,length=length,id=c.state[0].composite_count});c.state[0].composite_count+=1;return id;
}
CK_list_count :: (c:CK_Context,head:int)->int {count:=0;id:=head;while id!=CK_NONE {count+=1;id=c.nodes[id].next;}return count;}
CK_at :: (c:CK_Context,head:int,index:int)->int {id:=head;i:=0;while id!=CK_NONE {if i==index {return id;}i+=1;id=c.nodes[id].next;}return CK_NONE;}
CK_copy_expr :: (c:CK_Context,to:int,from:int,location:bool) {next:=c.nodes[to].next;loc:=c.nodes[to].loc;c.nodes[to]=c.nodes[from];c.nodes[to].next=next;if location {c.nodes[to].loc=loc;}}

CM_intop :: (op:u32,a:CM_Int,b:CM_Int)->CM_Int {
  if op==34 {return CM_add(a,b);}if op==35 {return CM_sub(a,b);}if op==36 {return CM_mul(a,b);}
  if op==37 || op==38 {return CM_divide(a,b,op==38);}if op>=39 && op<=41 {return CM_bitwise(op,a,b);}
  if op==42 || op==43 {if b.bad || b.negative || !CM_fits(b,64,true) {return CM_Int.{bad=true};}return CM_shift(op,a,cast(int)CM_low(b.mag));}return CM_Int.{bad=true};
}
// %g's six significant digits for a finite binary64 integer. Overflowing f32
// literals have positive binary powers, so exact decimal digits are inexpensive.
CM_g :: (bits:u64,out:[] u8)->int #export_c {
  value:=CM_unpack(bits,CM_Width.f64);if value.special!=0 || value.power<0 {return -1;}
  digits:[320] u8;count:=0;v:=value.mantissa;
  while v!=0 {digits[count]=cast(u8)(v%10);v=v/10;count+=1;}
  for i:0..<value.power {carry:=0;for j:0..<count {n:=cast(int)digits[j]*2+carry;digits[j]=cast(u8)(n%10);carry=n/10;}if carry!=0 {digits[count]=cast(u8)carry;count+=1;}}
  leading:=0;for i:0..<6 {leading=leading*10+cast(int)digits[count-1-i];}
  next:=cast(int)digits[count-7];sticky:=false;for i:0..<count-7 {if digits[i]!=0 {sticky=true;}}
  if next>5 || (next==5 && (sticky || (leading&1)!=0)) {leading+=1;}
  exponent:=count-1;if leading==1000000 {leading=100000;exponent+=1;}
  significand:[6] u8;for j:0..<6 {i:=5-j;significand[i]=cast(u8)(48+leading%10);leading=leading/10;}
  keep:=6;while significand[keep-1]==48 {keep-=1;}
  text:[32] u8;used:=0;if value.negative {text[used]=45;used+=1;}text[used]=significand[0];used+=1;
  if keep>1 {text[used]=46;used+=1;for i:1..<keep {text[used]=significand[i];used+=1;}}
  text[used]=101;text[used+1]=43;used+=2;
  decimal:[48] u8;n:=CM_decimal(CM_from(cast(u64)exponent,false),decimal[..]);for i:0..<n {text[used]=decimal[i];used+=1;}
  if out.count<used {return -1;}for i:0..<used {out[i]=text[i];}return used;
}
// Explicit frames keep the semantic bound independent of the evaluator's
// native procedure-call limit, including exact-bound constant expressions.
CK_FoldFrame :: struct {id:int;depth:int;pending_left:bool;left:CM_Int;}
CK_const_int_depth :: (c:CK_Context,id:int,depth:int)->CM_Int {
  frames:[66]CK_FoldFrame;frames[0]=CK_FoldFrame.{id=id,depth=depth};top:=0;ready:=false;done:=false;value:CM_Int;
  while !done {
    frame:=frames[top];e:=c.nodes[frame.id];
    if ready {
      if top==0 {done=true;continue;}top-=1;parent:=frames[top];p:=c.nodes[parent.id];
      if parent.pending_left {frames[top].left=value;frames[top].pending_left=false;top+=1;frames[top]=CK_FoldFrame.{id=p.b,depth=parent.depth+1};ready=false;}
      else {value=CM_intop(p.op,parent.left,value);}continue;
    }
    if frame.depth>64 {value=CM_Int.{bad=true};ready=true;continue;}
    if e.kind==CK_Tag.expr_int {
      value=CM_Int.{bad=true};if CK_integer(c,e.type) || e.type==4 {signed:=c.types[e.type].is_signed;if e.type==4 {signed=e.negative;}value=CM_signed_bits(e.value,signed);}ready=true;continue;
    }
    if e.kind==CK_Tag.expr_ident {
      if e.constant!=CK_NONE && c.nodes[e.constant].mark==2 {frames[top].id=c.nodes[e.constant].a;frames[top].depth+=1;continue;}
      value=CM_Int.{bad=true};ready=true;continue;
    }
    if e.kind==CK_Tag.expr_unary && e.op==35 {top+=1;frames[top]=CK_FoldFrame.{id=e.a,depth=frame.depth+1};continue;}
    if e.kind==CK_Tag.expr_binary && e.op>=34 && e.op<=38 {frames[top].pending_left=true;top+=1;frames[top]=CK_FoldFrame.{id=e.a,depth=frame.depth+1};continue;}
    value=CM_Int.{bad=true};ready=true;
  }return value;
}
CK_const_int :: (c:CK_Context,id:int)->CM_Int {return CK_const_int_depth(c,id,0);}
CK_resolve :: (c:CK_Context,id:int,by_value:CK_Access)->int {
  if id<2 {return CK_NONE;}e:=c.nodes[id];if !CK_enter(c,e.loc) {return CK_NONE;}defer CK_leave(c);
  if e.kind==CK_Tag.type_optional {return CK_sum_type(c,CK_Kind.optional,CK_sum_inner(c,e.b),0,e.loc);}
  if e.kind==CK_Tag.type_named {
    if e.name=="Result" && e.name2.count==0 {return CK_result_syntax(c,id);}
    if CK_unit_constructor(e.name,e.name2)!=0 {return CK_unit_type(c,id);}
    if CK_spatial_constructor(e.name,e.name2)!=SP_Kind.raw {return CK_spatial_type(c,id);}
    if e.name2.count==0 {builtin:=CK_builtin_type(e.name);if builtin!=0 {CK_no_args(c,id);return builtin;}}
    kinds:=[3] CK_Tag.[CK_Tag.struct_,CK_Tag.enum_,CK_Tag.union_];if !CK_bind_check(c,id,kinds[..],"type") {return CK_NONE;}
    d:=CK_lookup(c,CK_Tag.struct_,id);if d!=CK_NONE {if c.nodes[d].generic || e.head!=CK_NONE {return CK_struct_type(c,id,d,by_value);}if by_value==CK_Access.value {CK_layout(c,d);}return c.nodes[d].type;}
    un:=CK_lookup(c,CK_Tag.union_,id);if un!=0 {CK_no_args(c,id);if by_value==CK_Access.value {CK_union_layout(c,un);}return c.nodes[un].type;}
    en:=CK_lookup(c,CK_Tag.enum_,id);if en!=0 {CK_no_args(c,id);return c.nodes[en].type;}
    later:=[11] string.["fixed32","fixed64","v2","v3","v4","quat","m3","m4","Any","Type","Code"];
    for name:later {if e.name==name {CK_error(c,e.loc,"E0301",CK_join3(c,"type '",e.name,"' is not supported by coax0 yet"),"");return CK_NONE;}}
    if e.name=="void" {CK_error(c,e.loc,"E0302","'void' is not a type you can write","leave out '-> void'");return CK_NONE;}
    CK_error(c,e.loc,"E0302",CK_join3(c,"unknown type '",e.name,"'"),"");return CK_NONE;
  }
  if e.kind==CK_Tag.type_param {return CK_type_param(c,id);}
  if e.kind==CK_Tag.type_dynamic {CK_error(c,e.loc,"E0301","dynamic arrays '[..] T' are not supported by coax0 yet","use a fixed array '[N] T' and a count");return CK_NONE;}
  if e.kind==CK_Tag.type_view {elem:=CK_resolve(c,e.b,CK_Access.view);if elem==CK_NONE {return CK_NONE;}
    if CK_sum_contains(c,elem,true) {CK_error(c,e.loc,"E0900","a view cannot contain Result","");return 0;}
    if CK_nests(c,elem) {CK_nested(c,e.loc,false,elem);return CK_NONE;}return CK_intern(c,CK_Kind.view,elem,0);}
  if c.nodes[e.a].kind==CK_Tag.type_param {count:=CK_length_param(c,e.a);elem:=CK_resolve(c,e.b,CK_Access.value);
    if count==0 || c.types[elem].kind==CK_Kind.invalid {return CK_NONE;}if CK_sum_contains(c,elem,true) {CK_error(c,e.loc,"E0900","an array cannot contain Result","");return 0;}if CK_nests(c,elem) {CK_nested(c,e.loc,true,elem);return CK_NONE;}
    // a struct argument's length is bounded here, by the array's total size
    if count*c.types[elem].size>1073741824 {CK_error(c,c.nodes[e.a].loc,"E0357",CK_join3(c,"array length ",CK_count(c,count)," is out of range (1 to 1 GiB total)"),"");return CK_NONE;}
    return CK_intern(c,CK_Kind.array,elem,count);}
  elem:=CK_resolve(c,e.b,CK_Access.value);n:=CK_value(c,e.a,CK_Hint.{type=11});length:=CK_const_int(c,e.a);
  if n==CK_NONE || elem==CK_NONE {return CK_NONE;}
  if CK_sum_contains(c,elem,true) {CK_error(c,e.loc,"E0900","an array cannot contain Result","");return 0;}if CK_nests(c,elem) {CK_nested(c,e.loc,true,elem);return CK_NONE;}
  if !CK_integer(c,n) || length.bad {CK_error(c,c.nodes[e.a].loc,"E0357","an array length must be an integer known while checking: a literal, a constant, or arithmetic on them","");return CK_NONE;}
  size:=CM_mul(length,CM_Int.{mag=CM_u(cast(u64)c.types[elem].size)});
  if length.negative || CM_zero(length.mag) || CM_cmp(size.mag,CM_u(1073741824))>0 {
    CK_error(c,c.nodes[e.a].loc,"E0357",CK_join3(c,"array length ",CK_number(c,length)," is out of range (1 to 1 GiB total)"),"");return CK_NONE;
  }
  return CK_intern(c,CK_Kind.array,elem,cast(int)CM_low(length.mag));
}
// Type parameters (r4a-type-parameters). The first $T among a procedure's
// parameters binds a placeholder type owned by that procedure; every other
// $T in its signature and body is that same type, so uses are checked
// against it like any other type. Placeholders stay out of layouts and
// emission: a generic procedure is checked but has no instances yet.
CK_generic :: (c:CK_Context,t:int)->bool {
  at:=t;while c.types[at].kind==CK_Kind.view || c.types[at].kind==CK_Kind.array {if c.types[at].length<0 {return true;}at=c.types[at].elem;}
  if c.types[at].kind==CK_Kind.result {return CK_generic(c,c.types[at].elem) || CK_generic(c,c.types[at].sum_error);}if c.types[at].kind==CK_Kind.optional {return CK_generic(c,c.types[at].elem);}
  return c.types[at].kind==CK_Kind.param || (c.types[at].kind==CK_Kind.struct_ && c.nodes[c.types[at].decl].generic);
}
// A placeholder, or a generic struct over placeholders, may sit in a view or
// array; a composite over one may not.
CK_nests :: (c:CK_Context,t:int)->bool {k:=c.types[t].kind;return CK_generic(c,t) && k!=CK_Kind.param && k!=CK_Kind.struct_;}
CK_nested :: (c:CK_Context,loc:CK_Loc,array:bool,elem:int) {
  what:="a view of '";if array {what="a fixed array of '";}
  parts:=[3] string.[what,c.types[elem].name,"' nests a type parameter; only '$T', '[] $T' and '[N] $T' are supported"];
  CK_error(c,loc,"E0394",CK_text(c,parts[..]),"take '[] $T' or '[$N] $T' and index it");
}
// The placeholder record a $NAME names for its owner: found, or bound here
// when this site may bind (value: a $N array length, bits 1).
CK_param :: (c:CK_Context,id:int,value:bool)->int {
  e:=c.nodes[id];name:=CK_join2(c,"$",e.name);owner:=c.state[0].generic;site:=c.state[0].site;bits:=0;if value {bits=1;}
  // A field's owner is its struct: a template, an instance, or a plain struct with no parameters.
  // A struct parameter is a length or a type by its first use in a field (bits 2: not used yet).
  // an instance's copy repeats its template's constraints, which were checked there
  if e.name2.count!=0 && site!=CK_Site.param && c.nodes[owner].origin==CK_NONE {CK_error(c,e.loc2,"E0808",CK_join3(c,"a constraint on '",name,"' is written where a parameter binds it"),"constrain it in the parameter list: f :: (x: $T: ordered), or Pair :: struct($T: ordered)");}
  if site==CK_Site.field {found:=CK_param_record(c,owner,name);if found!=CK_NONE {if c.types[found].bits==2 {c.types[found].bits=bits;}return found;}
    CK_error(c,e.loc,"E0395",CK_join3(c,"a struct field cannot have the type parameter '",name,"'"),CK_join3(c,"list it in the struct's parameters: S :: struct(",name,") { ... }"));return CK_NONE;}
  if owner==CK_NONE {CK_error(c,e.loc,"E0393",CK_join3(c,"'",name,"' is not bound here; only a procedure's parameters bind type parameters"),"bind it in a procedure's parameter list: f :: (x: $T)");return CK_NONE;}
  found:=CK_param_record(c,owner,name);if found!=CK_NONE {CK_constrain(c,id,found);return found;}
  proc:=c.nodes[owner].name;
  if site==CK_Site.result {parts:=[5] string.["'",name,"' appears only in the result of '",proc,"'; a parameter must bind it"];CK_error(c,e.loc,"E0392",CK_text(c,parts[..]),CK_join3(c,"add a parameter whose type uses ",name,", or return a concrete type"));return CK_NONE;}
  if site!=CK_Site.param {parts:=[5] string.["'",name,"' is not bound by a parameter of '",proc,"'"];CK_error(c,e.loc,"E0393",CK_text(c,parts[..]),CK_join3(c,"use ",name," in a parameter's type first"));return CK_NONE;}
  c.nodes[owner].generic=true;r:=CK_new_type(c,CK_Type.{kind=CK_Kind.param,name=name,decl=owner,scope=c.nodes[owner].scope,bits=bits});CK_constrain(c,id,r);return r;
}
CK_param_record :: (c:CK_Context,owner:int,name:string)->int {
  for i:16..<c.state[0].type_count {r:=c.types[i];if r.kind==CK_Kind.param && r.decl==owner && r.name==name {return i;}}return CK_NONE;
}
CK_kind_clash :: (c:CK_Context,id:int,name:string,value:bool) {
  what:="' is a type parameter, not an array length";fix:="write the length as $N in a fixed array type: [$N] T";
  if value {what="' is a value parameter, not a type";fix="write a type parameter as $T, and use $N only as an array length";}
  CK_error(c,c.nodes[id].loc,"E0368",CK_join3(c,"'",name,what),fix);
}
// A bound record stands for its binding: elem for $T, length for $N. A
// failed lookup is record 0, whose elem and length are both 0 (none).
CK_type_param :: (c:CK_Context,id:int)->int {
  r:=CK_param(c,id,false);t:=c.types[r];if t.bits==1 {CK_kind_clash(c,id,t.name,true);return CK_NONE;}
  if t.elem!=CK_NONE {return t.elem;}return r;
}
// An array length: the bound value, or minus the placeholder record.
CK_length_param :: (c:CK_Context,id:int)->int {
  r:=CK_param(c,id,true);t:=c.types[r];if t.kind==CK_Kind.param && t.bits==0 {CK_kind_clash(c,id,t.name,false);return 0;}
  if t.length!=0 {return t.length;}return -r;
}
#forall "a type parameter binds once per owner and only where a parameter may bind it" site:CK_Site, owned:bool {
 nodes:[8]CK_Node;types:[24]CK_Type;locals:[2]CK_Local;errors:[4]CK_Error;bytes:[512]u8;state:=[1]CK_State.[CK_State.{type_count=16,site=site}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
 for i:0..<16 {types[i]=CK_builtin(i);}
 nodes[2]=CK_Node.{kind=CK_Tag.proc,name="first",scope=3};nodes[3]=CK_Node.{kind=CK_Tag.type_param,name="T",loc=CK_Loc.{line=2,column=9,offset=30}};
 nodes[4]=CK_Node.{kind=CK_Tag.type_view,b=3};nodes[5]=CK_Node.{kind=CK_Tag.type_view,b=4};nodes[6]=CK_Node.{kind=CK_Tag.proc,name="other"};
 if owned {state[0].generic=2;}
 t:=CK_resolve(c,3,CK_Access.value);
 binds:=owned && site==CK_Site.param;
 #assert (t==16)==binds && nodes[2].generic==binds && state[0].depth==0;
 if binds {#assert types[16].kind==CK_Kind.param && types[16].name=="$T" && types[16].decl==2 && types[16].scope==3 && state[0].error_count==0;
   // every other use is the same type, in any site, and composes once into a view
   state[0].site=CK_Site.body;#assert CK_resolve(c,3,CK_Access.value)==16 && CK_resolve(c,4,CK_Access.view)==17 && types[17].name=="[] $T" && state[0].type_count==18;
   #assert CK_generic(c,16) && CK_generic(c,17) && !CK_generic(c,11) && state[0].error_count==0;
   #assert CK_resolve(c,5,CK_Access.value)==0 && errors[0].code=="E0394" && errors[0].message=="a view of '[] $T' nests a type parameter; only '$T', '[] $T' and '[N] $T' are supported";
   // another procedure's $T is its own placeholder
   state[0].generic=6;state[0].site=CK_Site.param;#assert CK_resolve(c,3,CK_Access.value)==18 && types[18].decl==6 && nodes[6].generic;
 }
 if !binds {#assert state[0].error_count==1 && errors[0].loc.line==2 && errors[0].loc.column==9 && state[0].type_count==16;
   want:="E0393";if site==CK_Site.field {want="E0395";}else if owned && site==CK_Site.result {want="E0392";}#assert errors[0].code==want;
   if want=="E0395" {#assert errors[0].message=="a struct field cannot have the type parameter '$T'";}
   if want=="E0392" {#assert errors[0].message=="'$T' appears only in the result of 'first'; a parameter must bind it" && errors[0].fix=="add a parameter whose type uses $T, or return a concrete type";}
   if want=="E0393" && owned {#assert errors[0].message=="'$T' is not bound by a parameter of 'first'" && errors[0].fix=="use $T in a parameter's type first";}
   if want=="E0393" && !owned {#assert errors[0].message=="'$T' is not bound here; only a procedure's parameters bind type parameters" && errors[0].fix=="bind it in a procedure's parameter list: f :: (x: $T)";}
 }
}
#test "a struct's fields are a field site, and the site around them is restored" {
 nodes:[8]CK_Node;types:[24]CK_Type;locals:[2]CK_Local;errors:[4]CK_Error;bytes:[512]u8;state:=[1]CK_State.[CK_State.{type_count=17,site=CK_Site.param,generic=5}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.struct_,name="S",decl=2};
 nodes[2]=CK_Node.{kind=CK_Tag.struct_,name="S",type=16,head=3};nodes[3]=CK_Node.{kind=CK_Tag.field,name="x",a=4,next=6};nodes[4]=CK_Node.{kind=CK_Tag.type_named,name="int"};
 nodes[5]=CK_Node.{kind=CK_Tag.proc,name="f"};nodes[6]=CK_Node.{kind=CK_Tag.field,name="y",a=7};nodes[7]=CK_Node.{kind=CK_Tag.type_param,name="T"};
 CK_layout(c,2);#assert state[0].site==CK_Site.param && state[0].generic==5 && nodes[3].type==11 && state[0].error_count==1 && errors[0].code=="E0395" && !nodes[5].generic;
}
CK_layout :: (c:CK_Context,id:int) {
  if c.nodes[id].kind==CK_Tag.union_ {CK_union_layout(c,id);return;}
  if c.nodes[id].mark==2 {return;}
  if c.nodes[id].frame_decl {CK_frame_layout(c,id);return;}
  if c.nodes[id].mark==1 {CK_error(c,c.nodes[id].loc,"E0353",CK_join3(c,"struct '",c.nodes[id].name,"' contains itself"),CK_join3(c,"hold it through a view '[] ",c.nodes[id].name,"' or an index"));c.nodes[id].mark=2;return;}
  if !CK_enter(c,c.nodes[id].loc) {return;}defer CK_leave(c);c.nodes[id].mark=1;errors:=c.state[0].error_count;
  offset:=0;alignment:=1;field:=c.nodes[id].head;
  while field!=CK_NONE && !c.state[0].fatal {
    f:=c.nodes[field];prev:=c.nodes[id].head;
    while prev!=field {if c.nodes[prev].name==f.name {parts:=[5] string.["duplicate field '",f.name,"' in struct '",c.nodes[id].name,"'"];CK_error(c,f.loc,"E0352",CK_text(c,parts[..]),"");}prev=c.nodes[prev].next;}
    if CK_c_keyword(f.name) {CK_error(c,f.loc,"E0371",CK_join3(c,"field name '",f.name,"' is reserved in C or C++, where this struct also lives"),"pick another name");}
    site:=c.state[0].site;owner:=c.state[0].generic;c.state[0].site=CK_Site.field;c.state[0].generic=id;ty:=CK_resolve(c,f.a,CK_Access.value);c.state[0].site=site;c.state[0].generic=owner;c.nodes[field].type=ty;
    if CK_sum_contains(c,ty,true) {CK_error(c,f.loc,"E0900","Result cannot be stored in a record field","");}
    // A template or an instance over a placeholder has field types but no layout.
    if c.nodes[id].generic {field=f.next;continue;}
    fa:=c.types[ty].alignment;fs:=c.types[ty].size;
    offset=(offset+fa-1)/fa*fa;c.nodes[field].field_index=offset;
    if fs>2147483647-offset {CK_resource(c,f.loc);return;}offset+=fs;delta:=fa-alignment;alignment+=delta & ((delta>>63)^ -1);field=f.next;
  }
  ty:=c.nodes[id].type;rounded:=(offset+alignment-1)/alignment*alignment;if rounded>2147483647 {CK_resource(c,c.nodes[id].loc);return;}c.types[ty].size=rounded;c.types[ty].alignment=alignment;
  if c.types[ty].size==0 {c.types[ty].size=1;}c.nodes[id].mark=2;
  // a template whose fields failed makes no instances, so they are reported once
  CK_quantity_layout(c,id);
  if c.nodes[id].generic {c.nodes[id].flag2=c.state[0].error_count!=errors;}
}
CK_untyped_int :: (c:CK_Context,id:int)->CM_Int {e:=c.nodes[id];return CM_signed_bits(e.value,e.negative);}
CK_set_int :: (c:CK_Context,id:int,v:CM_Int) {
