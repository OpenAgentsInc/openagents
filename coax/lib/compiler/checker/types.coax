}
// Compiler-owned spatial values are ordinary aggregates. These helpers consume
// initialized checker pools and publish only fully admitted private instances.
CK_spatial_constructor :: (name:string,alias:string)->SP_Kind {
 if alias.count!=0 {return SP_Kind.raw;}if name=="Point3" {return SP_Kind.point;}if name=="Vector3" {return SP_Kind.vector;}return SP_Kind.raw;
}
CK_frame_layout :: (c:CK_Context,id:int) {
 n:=c.nodes[id];if n.quantity!=0 || n.d!=0 || n.head!=0 || !SP_frame_valid(n.frame) {CK_error(c,n.loc,"E0832","@frame requires an empty nongeneric frame tag and valid explicit metadata","");}
 c.types[n.type].size=1;c.types[n.type].alignment=1;c.nodes[id].mark=2;
}
CK_spatial_intern :: (c:CK_Context,kind:SP_Kind,frame:int,unit:int,rep:int,loc:CK_Loc)->int {
 if c.state[0].fatal {return 0;}
 if (kind!=SP_Kind.point && kind!=SP_Kind.vector) || frame<16 || frame>=c.state[0].type_count || unit<16 || unit>=c.state[0].type_count || (rep!=6 && rep!=7) {CK_error(c,loc,"E0833","spatial types require concrete frame and unit tags and f32 or f64","");return 0;}
 ft:=c.types[frame];ut:=c.types[unit];f:=c.nodes[ft.decl];u:=c.nodes[ut.decl];
 if ft.kind!=CK_Kind.struct_ || !f.frame_decl || f.quantity!=0 || f.d!=0 || f.head!=0 || ut.kind!=CK_Kind.struct_ || u.quantity!=1 || u.generic {CK_error(c,loc,"E0833","spatial arguments must name admitted concrete frame and unit tags","");return 0;}
 if c.state[0].quantity_device {CK_error(c,loc,"E0836","spatial types are qualified only for native C","");return 0;}
 width:=ifx rep==6 then 4 else 8;descriptor:=SP_Type.{kind=kind,frame=frame,unit=unit,rep=width*8};admission:=SP_admit(descriptor,f.frame,u.unit);
 if admission!=SP_Status.ok {message:="spatial frame or unit metadata is invalid";if admission==SP_Status.unit {message="Point3 requires a physical length unit";}if admission==SP_Status.precision {message=CK_join3(c,"frame ",c.types[frame].name," requires f64 spatial coordinates");}CK_error(c,loc,"E0833",message,"");return 0;}
 at:=c.state[0].spatial_types;while at!=0 {t:=c.types[c.nodes[at].type];if t.space.kind==kind && t.space.frame==frame && t.space.unit==unit && t.space.rep==width*8 {return c.nodes[at].type;}at=c.nodes[at].spatial_link;}
 name:="Point3";internal:="CoaxPoint3";if kind==SP_Kind.vector {name="Vector3";internal="CoaxVector3";}
 name=CK_join3(c,name,"(",CK_join3(c,c.types[frame].name,",",CK_join3(c,c.types[unit].name,",",c.types[rep].name)));name=CK_join2(c,name,")");
 key:=CK_join3(c,CK_join3(c,"f",CK_count(c,frame),"u"),CK_count(c,unit),CK_join2(c,"r",CK_count(c,rep)));
 id:=CK_new(c,CK_Tag.struct_,loc);
 ty:=CK_new_type(c,CK_Type.{kind=CK_Kind.struct_,name=name,size=3*width,alignment=width,decl=id,scope=c.modules.count+1,space=descriptor});
 c.nodes[id]=CK_Node.{kind=CK_Tag.struct_,loc=loc,name=internal,type=ty,scope=c.modules.count+1,origin=id,key=key,mark=2};names:=[3]string.["x","y","z"];last:=0;
 for i:0..<3 {field:=CK_new(c,CK_Tag.field,loc);c.nodes[field].name=names[i];c.nodes[field].type=rep;c.nodes[field].field_index=i*width;if last==0 {c.nodes[id].head=field;}else {c.nodes[last].next=field;}last=field;}c.nodes[id].tail=last;
 if c.state[0].fatal {return 0;}if !CK_chain(c,id,loc) {return 0;}c.nodes[id].spatial_link=c.state[0].spatial_types;c.state[0].spatial_types=id;return ty;
}
CK_spatial_type :: (c:CK_Context,id:int)->int {
 e:=c.nodes[id];if CK_list_count(c,e.head)!=3 {CK_error(c,e.loc,"E0833","Point3 and Vector3 take Frame, Unit and f32 or f64","");return 0;}
 a:=e.head;b:=c.nodes[a].next;d:=c.nodes[b].next;frame:=CK_resolve(c,a,CK_Access.value);unit:=CK_resolve(c,b,CK_Access.value);rep:=CK_resolve(c,d,CK_Access.value);
 if frame==0 || unit==0 || rep==0 {return 0;}return CK_spatial_intern(c,CK_spatial_constructor(e.name,e.name2),frame,unit,rep,e.loc);
}
CK_spatial_descriptor :: (c:CK_Context,t:int)->SP_Type {
 if c.types[t].space.kind!=SP_Kind.raw {return c.types[t].space;}if t==6 {return SP_Type.{rep=32};}if t==7 {return SP_Type.{rep=64};}return SP_Type.{};
}
CK_spatial_projection :: (c:CK_Context,base:int,axis:int,rep:int,loc:CK_Loc)->int {
 if c.types[c.nodes[base].type].space.kind==SP_Kind.raw {return base;}names:=[3]string.["x","y","z"];id:=CK_new(c,CK_Tag.expr_field,loc);c.nodes[id].name=names[axis];c.nodes[id].a=base;c.nodes[id].field_index=axis;c.nodes[id].type=rep;c.nodes[id].mark=1;return id;
}
CK_spatial_helper :: (c:CK_Context,op:u32,a:int,b:int,result:int,loc:CK_Loc)->int {
 if c.state[0].fatal {return 0;}
 key:=CK_join3(c,CK_join3(c,"o",CK_count(c,cast(int)op),"a"),CK_count(c,a),CK_join3(c,"b",CK_count(c,b),CK_join2(c,"r",CK_count(c,result))));
 at:=c.state[0].spatial_helpers;while at!=0 {if c.nodes[at].key==key {return at;}at=c.nodes[at].spatial_link;}
 id:=CK_new(c,CK_Tag.proc,loc);c.nodes[id]=CK_Node.{kind=CK_Tag.proc,loc=loc,name="CoaxSpatialOp",type=result,scope=c.modules.count+1,collides=true,origin=id,key=key,skip_authority=true};
 left:=CK_new(c,CK_Tag.param,loc);c.nodes[left].name="left";c.nodes[left].type=a;c.nodes[id].head=left;c.nodes[id].tail=left;
 lref:=CK_new(c,CK_Tag.expr_ident,loc);c.nodes[lref].name="left";c.nodes[lref].type=a;c.nodes[lref].mark=1;rref:int;
 if b!=0 {right:=CK_new(c,CK_Tag.param,loc);c.nodes[right].name="right";c.nodes[right].type=b;c.nodes[left].next=right;c.nodes[id].tail=right;rref=CK_new(c,CK_Tag.expr_ident,loc);c.nodes[rref].name="right";c.nodes[rref].type=b;c.nodes[rref].mark=1;}
 rep:=ifx c.types[result].space.rep==32 then 6 else 7;aggregate:=CK_new(c,CK_Tag.expr_struct,loc);c.nodes[aggregate].type=result;c.nodes[aggregate].mark=1;last:=0;names:=[3]string.["x","y","z"];
 for axis:0..<3 {x:=CK_spatial_projection(c,lref,axis,rep,loc);y:int;kind:=CK_Tag.expr_unary;if b!=0 {kind=CK_Tag.expr_binary;y=CK_spatial_projection(c,rref,axis,rep,loc);}value:=CK_new(c,kind,loc);c.nodes[value].a=x;c.nodes[value].b=y;c.nodes[value].op=op;c.nodes[value].type=rep;c.nodes[value].mark=1;
  field:=CK_new(c,CK_Tag.field_init,loc);c.nodes[field].name=names[axis];c.nodes[field].field_index=axis;c.nodes[field].a=value;if last==0 {c.nodes[aggregate].head=field;}else {c.nodes[last].next=field;}last=field;}
 c.nodes[aggregate].tail=last;ret:=CK_new(c,CK_Tag.stmt_return,loc);c.nodes[ret].a=aggregate;body:=CK_new(c,CK_Tag.stmt_block,loc);c.nodes[body].head=ret;c.nodes[body].tail=ret;c.nodes[id].b=body;
 if c.state[0].fatal {return 0;}if !CK_chain(c,id,loc) {return 0;}c.nodes[id].spatial_link=c.state[0].spatial_helpers;c.state[0].spatial_helpers=id;return id;
}
CK_spatial_call :: (c:CK_Context,id:int,op:u32,a:int,b:int,result:int)->int {
 e:=c.nodes[id];helper:=CK_spatial_helper(c,op,a,b,result,e.loc);if helper==0 {return 0;}
 left:=CK_new(c,c.nodes[e.a].kind,c.nodes[e.a].loc);c.nodes[left]=c.nodes[e.a];c.nodes[left].next=0;last:=left;
 if b!=0 {right:=CK_new(c,c.nodes[e.b].kind,c.nodes[e.b].loc);c.nodes[right]=c.nodes[e.b];c.nodes[right].next=0;c.nodes[left].next=right;last=right;}
 if c.state[0].fatal {return 0;}c.nodes[id]=CK_Node.{kind=CK_Tag.expr_call,loc=e.loc,name="CoaxSpatialOp",head=left,tail=last,next=e.next,type=result,proc=helper,mark=2,op=op,lowering=ifx b==0 then CK_Lowering.spatial_unary else CK_Lowering.spatial_binary};return result;
}
CK_spatial_operation :: (token:u32)->SP_Op {
 tokens:=[4]u32.[34,35,36,37];operations:=[4]SP_Op.[SP_Op.add,SP_Op.sub,SP_Op.mul,SP_Op.div];for i:0..<4 {if token==tokens[i] {return operations[i];}}return SP_Op.invalid;
}
CK_spatial_binary :: (c:CK_Context,id:int,left:int,right:int)->int {
 e:=c.nodes[id];
 if c.types[left].space.kind!=SP_Kind.raw {rep:=ifx c.types[left].space.rep==32 then 6 else 7;CK_coerce(c,e.b,rep);}
 if c.types[right].space.kind!=SP_Kind.raw {rep:=ifx c.types[right].space.rep==32 then 6 else 7;CK_coerce(c,e.a,rep);}
 a:=c.nodes[e.a].type;b:=c.nodes[e.b].type;
 if a==0 || b==0 {return 0;}op:=CK_spatial_operation(e.op);
 decision:=SP_binary(op,CK_spatial_descriptor(c,a),CK_spatial_descriptor(c,b));if decision.status!=SP_Status.ok {why:="affine operation is not admitted";if decision.status==SP_Status.precision {why="spatial carriers differ";}if decision.status==SP_Status.frame {why="nominal frames differ";}if decision.status==SP_Status.unit {why="nominal units differ";}if decision.status==SP_Status.type {why="spatial scaling needs a matching raw f32 or f64";}CK_error(c,e.loc,"E0834",CK_join3(c,CK_join3(c,why,": ",c.types[a].name)," and ",c.types[b].name),"");return 0;}
 rep:=ifx decision.result.rep==32 then 6 else 7;result:=CK_spatial_intern(c,decision.result.kind,decision.result.frame,decision.result.unit,rep,e.loc);if result==0 {return 0;}return CK_spatial_call(c,id,e.op,a,b,result);
}
CK_spatial_unary :: (c:CK_Context,id:int,t:int)->int {
 e:=c.nodes[id];decision:=SP_negate(c.types[t].space);if e.op!=35 || decision.status!=SP_Status.ok {CK_error(c,e.loc,"E0834",CK_join2(c,"only vectors support spatial negation: ",c.types[t].name),"");return 0;}return CK_spatial_call(c,id,e.op,t,0,t);
}

CK_spatial_token :: (operation:SP_Op)->u32 {
 tokens:=[4]u32.[34,35,36,37];for token:tokens {if CK_spatial_operation(token)==operation {return token;}}return 0;
}
// Trusted checked-node references and acyclic argument/parameter lists are input preconditions.
CK_spatial_mutation_candidate :: (c:CK_Context,id:int)->SOM_Candidate {
 n:=c.nodes[id];if n.kind!=CK_Tag.expr_call || n.mark!=2 || n.lowering!=CK_Lowering.spatial_binary || CK_list_count(c,n.head)!=2 {return SOM_Candidate.{status=SOM_Status.metadata};}
 p:=c.nodes[n.proc];if p.kind!=CK_Tag.proc || p.type!=n.type || CK_list_count(c,p.head)!=2 {return SOM_Candidate.{status=SOM_Status.metadata};}
 a:=n.head;b:=c.nodes[a].next;pa:=p.head;pb:=c.nodes[pa].next;
 if c.nodes[pa].type!=c.nodes[a].type || c.nodes[pb].type!=c.nodes[b].type {return SOM_Candidate.{status=SOM_Status.metadata};}
 return SOM_candidate(CK_spatial_operation(n.op),CK_spatial_descriptor(c,c.nodes[a].type),CK_spatial_descriptor(c,c.nodes[b].type),CK_spatial_descriptor(c,n.type));
}
CK_prepare_spatial_mutations :: (c:CK_Context)->bool #export_c {
 if c.state[0].fatal {return false;}limit:=c.state[0].used;
 for id:1..<limit+1 {n:=c.nodes[id];if n.lowering==CK_Lowering.none {continue;}
  if n.kind==CK_Tag.expr_call && n.mark==2 && n.lowering==CK_Lowering.spatial_unary {c.nodes[id].mutation_status=CK_Mutation.unsupported;continue;}
  candidate:=CK_spatial_mutation_candidate(c,id);
  if candidate.status==SOM_Status.metadata {CK_error(c,n.loc,"E0834","spatial mutation source metadata is inconsistent","");return false;}
  if candidate.status==SOM_Status.no_alternative {c.nodes[id].mutation_status=CK_Mutation.no_alternative;continue;}
  token:=CK_spatial_token(candidate.operation);a:=n.head;b:=c.nodes[a].next;
  helper:=CK_spatial_helper(c,token,c.nodes[a].type,c.nodes[b].type,n.type,n.loc);if helper==0 {return false;}
  c.nodes[id].mutation_status=CK_Mutation.eligible;c.nodes[id].mutation_op=token;c.nodes[id].mutation_proc=helper;
 }return true;
}

// Derived-unit helpers consume admitted concrete unit tags. Generated nominal
// factor facts stay in the checked node pool, never in a runtime value.
CK_unit_constructor :: (name:string,alias:string)->int {if alias.count!=0 {return 0;}if name=="UnitOne" {return 1;}if name=="UnitProduct" {return 2;}if name=="UnitQuotient" {return 3;}return 0;}
CK_unit_form :: (c:CK_Context,unit:int)->UF_Form {
  n:=c.nodes[c.types[unit].decl];if !n.unit_generated {return UF_atom(unit).form;}
  form:=UF_one();at:=n.unit_form;
  while at!=0 {form.atoms[form.count]=c.nodes[at].a;form.powers[form.count]=c.nodes[at].b;form.count+=1;at=c.nodes[at].next;}return form;
}
CK_unit_intern :: (c:CK_Context,form:UF_Form,metadata:Q_Unit,loc:CK_Loc)->int {
  if c.state[0].fatal {return 0;}
  if form.count==1 && form.powers[0]==1 {return form.atoms[0];}
  at:=c.state[0].unit_units;while at!=0 {if UF_equal(CK_unit_form(c,c.nodes[at].type),form) {return c.nodes[at].type;}at=c.nodes[at].unit_link;}
  name:="UnitOne";key:="one";
  if form.count!=0 {name="UnitForm(";key="f";for i:0..<form.count {
    if i!=0 {name=CK_join2(c,name,",");}name=CK_join3(c,CK_join3(c,name,c.types[form.atoms[i]].name,"^"),CK_count(c,form.powers[i]),"");
    key=CK_join3(c,CK_join3(c,key,CK_count(c,form.atoms[i]),"_"),CK_count(c,form.powers[i]+2147483647),"_");
  }name=CK_join2(c,name,")");}
  id:=CK_new(c,CK_Tag.struct_,loc);if id==0 {return 0;}
  ty:=CK_new_type(c,CK_Type.{kind=CK_Kind.struct_,name=name,size=1,alignment=1,decl=id,scope=c.modules.count+1});if ty==0 {return 0;}
  c.nodes[id]=CK_Node.{kind=CK_Tag.struct_,loc=loc,name="CoaxUnit",type=ty,scope=c.modules.count+1,origin=id,key=key,mark=2,quantity=1,unit=metadata,unit_generated=true};
  last:=0;for i:0..<form.count {factor:=CK_new(c,CK_Tag.unit_factor,loc);if factor==0 {return 0;}c.nodes[factor].a=form.atoms[i];c.nodes[factor].b=form.powers[i];if last==0 {c.nodes[id].unit_form=factor;}else {c.nodes[last].next=factor;}last=factor;}
  if !CK_chain(c,id,loc) {return 0;}c.nodes[id].unit_link=c.state[0].unit_units;c.state[0].unit_units=id;return ty;
}
CK_unit_admit :: (c:CK_Context,unit:int,loc:CK_Loc)->bool {
  t:=c.types[unit];if t.kind==CK_Kind.struct_ {n:=c.nodes[t.decl];if n.quantity==1 && !n.generic && Q_unit_valid(n.unit) {return true;}}
  CK_error(c,loc,"E0830","derived units require concrete @unit tags","");return false;
}
CK_unit_compose :: (c:CK_Context,a:int,b:int,divide:bool,loc:CK_Loc)->int {
  if !CK_unit_admit(c,a,loc) || !CK_unit_admit(c,b,loc) {return 0;}
  left:=c.nodes[c.types[a].decl].unit;right:=c.nodes[c.types[b].decl].unit;metadata:=UA_product(left,right);if divide {metadata=UA_quotient(left,right);}
  if metadata.status!=Q_Status.ok {message:="derived unit scale exceeds the reduced metadata bound";if metadata.status==Q_Status.dimension {message="derived unit dimensions exceed -8 through 8";}CK_error(c,loc,"E0829",message,"");return 0;}
  form:=UF_product(CK_unit_form(c,a),CK_unit_form(c,b));if divide {form=UF_quotient(CK_unit_form(c,a),CK_unit_form(c,b));}
  if form.status!=UF_Status.ok {message:="derived unit exceeds eight nominal atoms";if form.status==UF_Status.power {message="derived nominal atom power exceeds the signed-31-bit profile";}CK_error(c,loc,"E0831",message,"");return 0;}
  return CK_unit_intern(c,form.form,metadata.unit,loc);
}
CK_unit_type :: (c:CK_Context,id:int)->int {
  e:=c.nodes[id];kind:=CK_unit_constructor(e.name,e.name2);count:=CK_list_count(c,e.head);
  if kind==1 {if count!=0 {CK_error(c,e.loc,"E0830","UnitOne takes no type arguments","");return 0;}return CK_unit_intern(c,UF_one(),Q_Unit.{numerator=1,denominator=1},e.loc);}
  if count!=2 {CK_error(c,e.loc,"E0830","unit product or quotient takes two unit type arguments","");return 0;}
  a:=CK_resolve(c,e.head,CK_Access.value);b:=CK_resolve(c,c.nodes[e.head].next,CK_Access.value);if a==0 || b==0 {return 0;}
  return CK_unit_compose(c,a,b,kind==3,e.loc);
}
CK_unit_target :: (c:CK_Context,id:int)->int {
  e:=c.nodes[id];if !CK_enter(c,e.loc) {return 0;}defer CK_leave(c);
  if e.kind==CK_Tag.expr_ident {ref:=CK_new(c,CK_Tag.type_named,e.loc);c.nodes[ref].name=e.name;c.nodes[ref].name2=e.name2;c.nodes[ref].scope=e.scope;return ref;}
  if e.kind==CK_Tag.expr_field && c.nodes[e.a].kind==CK_Tag.expr_ident {ref:=CK_new(c,CK_Tag.type_named,e.loc);c.nodes[ref].name=e.name;c.nodes[ref].name2=c.nodes[e.a].name;c.nodes[ref].scope=e.scope;return ref;}
  if e.kind!=CK_Tag.expr_call || CK_unit_constructor(e.name,e.name2)==0 {CK_error(c,e.loc,"E0830","unit type target needs a unit name or reserved unit constructor","");return 0;}
  ref:=CK_new(c,CK_Tag.type_named,e.loc);c.nodes[ref].name=e.name;c.nodes[ref].scope=e.scope;at:=e.head;last:=0;
  while at!=0 {arg:=CK_unit_target(c,at);if arg==0 {return 0;}if last==0 {c.nodes[ref].head=arg;}else {c.nodes[last].next=arg;}last=arg;at=c.nodes[at].next;}c.nodes[ref].tail=last;
  // The consumed constructor is a compile-time type fact, not a dead runtime
  // call. Its original arguments have no runtime reference after conversion.
  c.nodes[id]=CK_Node.{kind=CK_Tag.type_named,loc=e.loc,name=e.name,scope=e.scope,next=e.next};return ref;
}
CK_quantity_derived :: (c:CK_Context,id:int,a:int,b:int)->int {
  e:=c.nodes[id];carrier:=c.types[a].carrier;
  if carrier!=c.types[b].carrier {CK_error(c,e.loc,"E0823","quantity product and quotient require one representation","");return 0;}
  unit:=CK_unit_compose(c,c.types[a].unit,c.types[b].unit,e.op==37,e.loc);if unit==0 {return 0;}
  result:=CK_quantity_target(c,a,unit,e.loc);
  left:=CK_quantity_raw(c,e.a);right:=CK_quantity_raw(c,e.b);
  raw:=CK_new(c,CK_Tag.expr_binary,e.loc);c.nodes[raw].op=e.op;c.nodes[raw].a=left;c.nodes[raw].b=right;c.nodes[raw].type=carrier;return CK_quantity_wrap(c,id,raw,result);
}

CK_quantity_layout :: (c:CK_Context,id:int) {
  n:=c.nodes[id];if n.quantity==0 {return;}
  if n.quantity==1 {if n.d!=0 || n.head!=0 || !Q_unit_valid(n.unit) {CK_error(c,n.loc,"E0820","@unit requires an empty nongeneric tag and valid literal metadata","");}return;}
  origin:=n.origin;if origin==0 {origin=id;}params:=c.nodes[origin].d;field:=n.head;
  if CK_list_count(c,params)!=2 || CK_list_count(c,field)!=1 || c.nodes[field].name!="value" || c.nodes[field].b!=0 {CK_error(c,n.loc,"E0821","@builtin_quantity requires two parameters and one field value of the representation parameter","");return;}
  first:=params;second:=c.nodes[first].next;
  if n.origin==0 {
    representation:=CK_param_record(c,id,CK_join2(c,"$",c.nodes[second].name));
    if c.nodes[field].type!=representation || c.types[representation].need!=4 {CK_error(c,n.loc,"E0821","quantity value must use its second, numeric parameter","");}return;
  }
  u:=c.types[CK_param_record(c,id,CK_join2(c,"$",c.nodes[first].name))].elem;
  representation:=c.nodes[field].type;
  if c.types[u].kind!=CK_Kind.param && (c.types[u].kind!=CK_Kind.struct_ || c.nodes[c.types[u].decl].quantity!=1) {CK_error(c,n.loc,"E0821","quantity unit must be a declared @unit tag","");return;}
  if representation!=6 && representation!=7 && c.types[representation].kind!=CK_Kind.param {CK_error(c,n.loc,"E0821","quantity representation must be f32 or f64","");return;}
  if c.state[0].quantity_device {CK_error(c,n.loc,"E0828","transparent quantities are qualified only for the C backend in this milestone","");return;}
  c.types[n.type].carrier=representation;c.types[n.type].unit=u;
}
CK_quantity_raw :: (c:CK_Context,operand:int)->int {
  ty:=c.nodes[operand].type;if c.types[ty].carrier==0 {return operand;}
  raw:=CK_new(c,CK_Tag.expr_field,c.nodes[operand].loc);c.nodes[raw].a=operand;c.nodes[raw].name="value";c.nodes[raw].field_index=0;c.nodes[raw].type=c.types[ty].carrier;return raw;
}
CK_quantity_wrap :: (c:CK_Context,id:int,raw:int,quantity:int)->int {
  field:=CK_new(c,CK_Tag.field_init,c.nodes[id].loc);if field==0 {return 0;}c.nodes[field].name="value";c.nodes[field].field_index=0;c.nodes[field].a=raw;
  old:=c.nodes[id];c.nodes[id]=CK_Node.{kind=CK_Tag.expr_struct,loc=old.loc,next=old.next,head=field,tail=field,type=quantity,mark=1};return quantity;
}
CK_quantity_binary :: (c:CK_Context,id:int,a:int,b:int)->int {
  e:=c.nodes[id];left:=c.types[a].carrier!=0;right:=c.types[b].carrier!=0;ar:=a;br:=b;if left {ar=c.types[a].carrier;}if right {br=c.types[b].carrier;}
  op:Q_Op;
  if e.op>=34 && e.op<=37 {ops:=[4]Q_Op.[Q_Op.add,Q_Op.sub,Q_Op.mul,Q_Op.div];op=ops[cast(int)e.op-34];}
  else if e.op>=44 && e.op<=49 {ops:=[6]Q_Op.[Q_Op.eq,Q_Op.ne,Q_Op.lt,Q_Op.le,Q_Op.gt,Q_Op.ge];op=ops[cast(int)e.op-44];}
  else {CK_error(c,e.loc,"E0824","operator is not supported for quantities","");return 0;}
  decision:=Q_binary(op,left,right,c.types[a].unit==c.types[b].unit,ar==br);
  if decision.status!=Q_Status.ok {
    code:="E0824";fix:="raw scalar divided by quantity, compound updates and affine operators are pending";
    if decision.status==Q_Status.unit {code="E0822";fix=CK_join3(c,"write convert_unit(",c.types[c.types[a].unit].name,", value) explicitly");}
    if decision.status==Q_Status.representation {code="E0823";fix="convert the raw representation explicitly before constructing the quantity";}
    CK_error(c,e.loc,code,CK_join3(c,CK_join2(c,"incompatible quantity operands: ",c.types[a].name)," and ",c.types[b].name),fix);return 0;
  }
  lhs:=CK_quantity_raw(c,e.a);rhs:=CK_quantity_raw(c,e.b);if rhs==0 {return 0;}raw:=id;result:=2;
  if decision.result_quantity {raw=CK_new(c,CK_Tag.expr_binary,e.loc);result=ar;}
  c.nodes[raw].op=e.op;c.nodes[raw].a=lhs;c.nodes[raw].b=rhs;c.nodes[raw].type=result;
  if !decision.result_quantity {return 2;}
  quantity:=a;if !left {quantity=b;}return CK_quantity_wrap(c,id,raw,quantity);
}
CK_quantity_target :: (c:CK_Context,source:int,target:int,loc:CK_Loc)->int {
  origin:=c.nodes[c.types[source].decl].origin;inst:=CK_struct_node(c,origin);p:=c.nodes[origin].d;
  ignored:=CK_new_type(c,CK_Type.{kind=CK_Kind.param,name=CK_join2(c,"$",c.nodes[p].name),decl=inst,elem=target});p=c.nodes[p].next;
  ignored2:=CK_new_type(c,CK_Type.{kind=CK_Kind.param,name=CK_join2(c,"$",c.nodes[p].name),decl=inst,elem=c.types[source].carrier});
  result:=CK_struct_intern(c,inst,loc,CK_Access.value);return ifx c.state[0].fatal then 0 else result;
}
CK_quantity_convert :: (c:CK_Context,id:int)->int {
  e:=c.nodes[id];if CK_list_count(c,e.head)!=2 {CK_error(c,e.loc,"E0825","convert_unit requires a target unit type and one quantity","");return 0;}
  target:=e.head;value:=c.nodes[target].next;if c.nodes[target].kind==CK_Tag.expr_call && CK_unit_constructor(c.nodes[target].name,c.nodes[target].name2)!=0 {ref:=CK_unit_target(c,target);if ref==0 {return 0;}return CK_quantity_conversion(c,id,ref,value);}
  name:=c.nodes[target].name;alias:=c.nodes[target].name2;
  if c.nodes[target].kind==CK_Tag.expr_field && c.nodes[c.nodes[target].a].kind==CK_Tag.expr_ident {alias=c.nodes[c.nodes[target].a].name;}
  else if c.nodes[target].kind!=CK_Tag.expr_ident {CK_error(c,e.loc,"E0825","convert_unit target must name an @unit type","");return 0;}
  ref:=CK_new(c,CK_Tag.type_named,c.nodes[target].loc);c.nodes[ref].name=name;c.nodes[ref].name2=alias;c.nodes[ref].scope=e.scope;
  return CK_quantity_conversion(c,id,ref,value);
}
CK_quantity_conversion :: (c:CK_Context,id:int,ref:int,value:int)->int {
  e:=c.nodes[id];unit:=CK_resolve(c,ref,CK_Access.value);source:=CK_expr(c,value,CK_Hint.{});
  if unit==0 || source==0 {return 0;}
  if c.types[unit].kind!=CK_Kind.struct_ || c.nodes[c.types[unit].decl].quantity!=1 || c.types[source].carrier==0 {CK_error(c,e.loc,"E0825","convert_unit needs a declared unit type and a quantity","");return 0;}
  sourceunit:=c.types[source].unit;
  if c.types[sourceunit].kind==CK_Kind.param {CK_error(c,e.loc,"E0825","this initial conversion profile requires concrete unit types","");return 0;}
  decision:=Q_conversion(c.nodes[c.types[sourceunit].decl].unit,c.nodes[c.types[unit].decl].unit);
  if decision.status!=Q_Status.ok {code:="E0825";message:="conversion dimensions do not match";if decision.status==Q_Status.scale {code="E0826";message="this profile converts only power-of-two unit scale ratios";}CK_error(c,e.loc,code,CK_join3(c,CK_join3(c,message,": ",c.types[source].name)," to ",c.types[unit].name),"");return 0;}
  result:=CK_quantity_target(c,source,unit,e.loc);
  raw:=CK_quantity_raw(c,value);
  if decision.exponent!=0 {coefficient:=CK_new(c,CK_Tag.expr_float,e.loc);c.nodes[coefficient].type=c.types[source].carrier;c.nodes[coefficient].floating=cast(u64)(1023+decision.exponent)<<52;
    product:=CK_new(c,CK_Tag.expr_binary,e.loc);c.nodes[product].op=36;c.nodes[product].a=raw;c.nodes[product].b=coefficient;c.nodes[product].type=c.types[source].carrier;raw=product;}
  return CK_quantity_wrap(c,id,raw,result);
}

