// The CUDA compute subset: which checked procedures `coax cuda` admits.
// Native code observes the checked tree and reports through these decisions;
// this policy decides. Type codes are a versioned bridge to the native graph:
// 0 void, 1 bool, 2 f32, 3 f64, 4 s8, 5 s16, 6 s32, 7 int (s64), 8 u8,
// 9 u16, 10 u32, 11 u64, 12 string, 13 struct, 14 enum, 15 fixed array,
// 16 view, 17 anything else.
#authority;

CU_ARRAY_LIMIT :: 4096;
CU_DEPTH_LIMIT :: 64;

#forall "scalars are bool, both floats and every sized integer" code:0..<20 {
 #assert CU_scalar(cast(u32)code)==(code>=1 && code<=11);
}
#forall "numbers exclude bool" code:0..<20 {
 #assert CU_number(cast(u32)code)==(code>=2 && code<=11);
}
CU_scalar :: (code:u32)->bool #export_c {return code>=1 && code<=11;}
CU_number :: (code:u32)->bool #export_c {return code>=2 && code<=11;}

// Reasons. 0 admits; each other value names what is refused.
#test "every refusal reason has its own text and the fix names the subset" {
 #assert CU_reason_text(0)=="";
 #assert CU_reason_text(1)=="a string value" && CU_reason_text(2)=="a struct value" && CU_reason_text(3)=="an enum value";
 #assert CU_reason_text(4)=="an array that is not a fixed array of at most 4096 scalars" && CU_reason_text(5)=="a view of something other than numbers";
 #assert CU_reason_text(6)=="a value of this type";
 #assert CU_reason_text(7)=="a while loop" && CU_reason_text(8)=="defer" && CU_reason_text(9)=="#assert";
 #assert CU_reason_text(10)=="print" && CU_reason_text(11)=="a #foreign call" && CU_reason_text(12)=="a recursive call";
 #assert CU_reason_text(13)=="this storage intrinsic" && CU_reason_text(14)=="a compile-time aggregate";
 #assert CU_reason_text(15)=="a kernel that returns a value" && CU_reason_text(16)=="a kernel whose first parameter is not its int work item";
 #assert CU_reason_text(17)=="a call chain deeper than 64" && CU_reason_text(18)=="a returned value that is not a scalar";
 #assert CU_reason_text(19)=="a view parameter of a kernel that is not a view of numbers" && CU_reason_text(20)=="a #foreign procedure";
 #assert CU_reason_text(21)=="a lane loop that is not for lane: 0..<32 in a kernel" && CU_reason_text(22)=="a lane loop inside a lane loop";
 #assert CU_reason_text(23)=="a per-lane index that is not lane*k+c into a [32*k] array" && CU_reason_text(24)=="a per-lane array outside lane loops and device primitives";
 #assert CU_reason_text(25)=="a lane loop assigning a value the warp shares" && CU_reason_text(26)=="break or continue directly in a lane loop";
 #assert CU_reason_text(27)=="a device primitive with the wrong arguments" && CU_reason_text(28)=="a device primitive inside a lane loop";
 #assert CU_reason_text(29)=="an f64 bit pattern" && CU_reason_text(30)=="a view of a register array" && CU_reason_text(31)=="this f64 operation";
 #assert CU_reason_text(32)=="a thread loop that is not for thread: 0..<T in a kernel, with T a multiple of 32 from 32 to 1024";
 #assert CU_reason_text(33)=="a thread loop inside a lane loop or another thread loop";
 #assert CU_reason_text(34)=="a group kernel whose thread loops and group primitives disagree on its size, or that has lane loops or the MMA primitive";
 #assert CU_reason_text(35)=="threadgroup arrays of more than 32768 bytes in one kernel";
 #assert CU_reason_text(36)=="a threadgroup array declared inside a loop or branch, or used other than by indexing";
 #assert CU_reason_text(37)=="a thread loop that writes a threadgroup array and touches elements another thread owns";
 #assert CU_reason_text(38)=="a threadgroup array written outside thread loops";
 #assert CU_reason_text(39)=="a thread loop assigning a value the group shares";
 #assert CU_reason_text(40)=="break, continue or return directly in a thread loop";
 #assert CU_reason_text(41)=="an Apple matrix primitive with the wrong arguments or outside a group kernel's shared code";
 #assert CU_reason_text(42)=="an Apple matrix primitive in a CUDA kernel";
 #assert CU_reason_text(43)=="a matrix accumulator used other than by Apple matrix primitives";
 #assert CU_reason_text(44)=="a view written in a group kernel's shared code";
 #assert CU_reason_text(45)=="this reason" && CU_reason_text(4000000000)=="this reason";
 #assert CU_fix()=="coax cuda accepts bool, f32, f64 and sized integers, fixed arrays of at most 4096 scalars, views of numbers, if/else, for loops, break/continue and acyclic calls; every #export_c procedure is a kernel with an int work item first and no result";
}
CU_reason_text :: (reason:u32)->string #export_c {
 texts:=[45] string.["","a string value","a struct value","an enum value","an array that is not a fixed array of at most 4096 scalars",
  "a view of something other than numbers","a value of this type","a while loop","defer","#assert","print","a #foreign call",
  "a recursive call","this storage intrinsic","a compile-time aggregate","a kernel that returns a value",
  "a kernel whose first parameter is not its int work item","a call chain deeper than 64","a returned value that is not a scalar",
  "a view parameter of a kernel that is not a view of numbers","a #foreign procedure",
  "a lane loop that is not for lane: 0..<32 in a kernel","a lane loop inside a lane loop",
  "a per-lane index that is not lane*k+c into a [32*k] array","a per-lane array outside lane loops and device primitives",
  "a lane loop assigning a value the warp shares","break or continue directly in a lane loop",
  "a device primitive with the wrong arguments","a device primitive inside a lane loop",
  "an f64 bit pattern","a view of a register array","this f64 operation",
  "a thread loop that is not for thread: 0..<T in a kernel, with T a multiple of 32 from 32 to 1024",
  "a thread loop inside a lane loop or another thread loop",
  "a group kernel whose thread loops and group primitives disagree on its size, or that has lane loops or the MMA primitive",
  "threadgroup arrays of more than 32768 bytes in one kernel",
  "a threadgroup array declared inside a loop or branch, or used other than by indexing",
  "a thread loop that writes a threadgroup array and touches elements another thread owns",
  "a threadgroup array written outside thread loops","a thread loop assigning a value the group shares",
  "break, continue or return directly in a thread loop",
  "an Apple matrix primitive with the wrong arguments or outside a group kernel's shared code",
  "an Apple matrix primitive in a CUDA kernel","a matrix accumulator used other than by Apple matrix primitives",
  "a view written in a group kernel's shared code"];
 if reason>=45 {return "this reason";}
 return texts[cast(int)reason];
}
CU_fix :: ()->string #export_c {
 return "coax cuda accepts bool, f32, f64 and sized integers, fixed arrays of at most 4096 scalars, views of numbers, if/else, for loops, break/continue and acyclic calls; every #export_c procedure is a kernel with an int work item first and no result";
}

// A value's type: a local, parameter, or intermediate expression.
#forall "value admission is closed over every type code" code:0..<20, elem:0..<20 {
 r:=CU_value(cast(u32)code,cast(u32)elem,4);
 expected:u32=6;
 if code>=1 && code<=11 {expected=0;}
 else if code==12 {expected=1;} else if code==13 {expected=2;} else if code==14 {expected=3;}
 else if code==15 {expected=ifx elem>=1 && elem<=11 then 0 else 4;}
 else if code==16 {expected=ifx elem>=2 && elem<=11 then 0 else 5;}
 #assert r==expected;
}
#test "fixed arrays are bounded register storage" {
 #assert CU_value(15,2,1)==0 && CU_value(15,2,4096)==0;
 #assert CU_value(15,2,4097)==4 && CU_value(15,2,0)==4 && CU_value(15,2,-1)==4;
 #assert CU_value(16,2,0)==0 && CU_value(16,2,5000)==0;
}
CU_value :: (code:u32,elem:u32,length:int)->u32 #export_c {
 if CU_scalar(code) {return 0;}
 if code==12 {return 1;}
 if code==13 {return 2;}
 if code==14 {return 3;}
 if code==15 {if CU_scalar(elem) && length>=1 && length<=CU_ARRAY_LIMIT {return 0;}return 4;}
 if code==16 {if CU_number(elem) {return 0;}return 5;}
 return 6;
}
#forall "results are scalars or nothing" code:0..<20 {
 #assert CU_result(cast(u32)code)==cast(u32)(ifx code<=11 then 0 else 18);
}
CU_result :: (code:u32)->u32 #export_c {if code==0 || CU_scalar(code) {return 0;}return 18;}

// Statement kinds: 0 block, 1 expr, 2 var, 3 assign, 4 return, 5 if, 6 while,
// 7 for range, 8 for each, 9 break, 10 continue, 11 defer, 12 #assert.
#forall "for loops are bounded by their range or view; while, defer and #assert are refused" kind:0..<16 {
 expected:u32=0;if kind==6 {expected=7;} else if kind==11 {expected=8;} else if kind==12 {expected=9;} else if kind>12 {expected=6;}
 #assert CU_statement(cast(u32)kind)==expected;
}
CU_statement :: (kind:u32)->u32 #export_c {
 reasons:=[13] u32.[0,0,0,0,0,0,7,0,0,0,0,8,9];
 if kind>=13 {return 6;}
 return reasons[cast(int)kind];
}

// Byte intrinsics by native code: 1 bytes_overlap, 2 f32_from_bits,
// 3 f64_from_bits, 4 f32_bits, 5 f64_bits, 6 value_barrier, 7 add_wrap,
// 8 sub_wrap, 9 mul_wrap, 10 rotl, 11 rotr, 12 mul_wide.
#forall "bit reinterpretation and wrapping arithmetic are admitted" code:0..<16 {
 #assert CU_byte_intrinsic(cast(u32)code)==cast(u32)(ifx (code>=2 && code<=5) || (code>=7 && code<=11) then 0 else 13);
}
CU_byte_intrinsic :: (code:u32)->u32 #export_c {
 if code>=2 && code<=5 {return 0;}
 if code>=7 && code<=11 {return 0;}
 return 13;
}

// One call expression: what it targets and how deep the chain already is.
#forall "calls refuse print, host calls, cycles and deep chains" print:bool, foreign:bool, active:bool, depth:0..<70 {
 r:=CU_call(print,foreign,active,depth);
 expected:u32=0;
 if print {expected=10;} else if foreign {expected=11;} else if active {expected=12;} else if depth>=64 {expected=17;}
 #assert r==expected;
}
CU_call :: (print:bool,foreign:bool,active:bool,depth:int)->u32 #export_c {
 if print {return 10;}
 if foreign {return 11;}
 if active {return 12;}
 if depth>=CU_DEPTH_LIMIT {return 17;}
 return 0;
}
#forall "compile-time values must be scalars" code:0..<20 {
 #assert CU_constant(cast(u32)code)==cast(u32)(ifx code>=1 && code<=11 then 0 else 14);
}
CU_constant :: (code:u32)->u32 #export_c {if CU_scalar(code) {return 0;}return 14;}

// A kernel (#export_c procedure) returns nothing and takes its work item
// first; its other parameters are scalars or views of numbers.
#forall "kernel signatures" ret:0..<18, count:0..<3, first:0..<18 {
 expected:u32=0;
 if ret!=0 {expected=15;} else if count<1 || first!=7 {expected=16;}
 #assert CU_kernel(cast(u32)ret,count,cast(u32)first)==expected;
}
CU_kernel :: (ret:u32,count:int,first:u32)->u32 #export_c {
 if ret!=0 {return 15;}
 if count<1 || first!=7 {return 16;}
 return 0;
}
#forall "kernel parameters are scalars or views of numbers" code:0..<18, elem:0..<18 {
 expected:u32=0;
 if code==16 {expected=ifx elem>=2 && elem<=11 then 0 else 19;}
 else if code==12 {expected=1;} else if code==13 {expected=2;} else if code==14 {expected=3;}
 else if !(code>=1 && code<=11) {expected=6;}
 #assert CU_kernel_parameter(cast(u32)code,cast(u32)elem)==expected;
}
CU_kernel_parameter :: (code:u32,elem:u32)->u32 #export_c {
 if CU_scalar(code) {return 0;}
 if code==16 {if CU_number(elem) {return 0;}return 19;}
 if code==12 {return 1;}
 if code==13 {return 2;}
 if code==14 {return 3;}
 return 6;
}
#forall "#foreign procedures are refused" foreign:bool {
 #assert CU_procedure(foreign)==cast(u32)(ifx foreign then 20 else 0);
}
CU_procedure :: (foreign:bool)->u32 #export_c {if foreign {return 20;}return 0;}

// Warp kernels. A kernel that contains `for lane: 0..<32` loops runs as one
// 32-lane warp per work item: each lane runs the loop body once with its own
// `lane`. Arrays of 32*k values indexed lane*k+c inside lane loops are
// per-lane: lane l keeps elements l*k..l*k+k-1 in registers. Code outside
// lane loops is the warp's shared control flow; device primitives such as
// cu_mma_bf16_16x8x16 run there on whole per-lane arrays.
#forall "lane loops are 0..<32, in a kernel, not nested" kernel:bool, constant:bool, lo:0..<3, hi:30..<34, nested:bool {
 expected:u32=0;
 if nested {expected=22;} else if !kernel || !constant || lo!=0 || hi!=32 {expected=21;}
 #assert CU_lane_loop(kernel,constant,lo,hi,nested)==expected;
}
CU_lane_loop :: (kernel:bool,constant:bool,lo:int,hi:int,nested:bool)->u32 #export_c {
 if nested {return 22;}
 if !kernel || !constant || lo!=0 || hi!=32 {return 21;}
 return 0;
}
#forall "a per-lane index is lane*k+c with 0 <= c < k into 32*k values" length:0..<200, scale:0..<8, offset:-1..<8, form:bool {
 expected:u32=23;
 if form && length>=32 && length%32==0 && scale==length/32 && offset>=0 && offset<scale {expected=0;}
 #assert CU_lane_index(length,scale,offset,form)==expected;
}
CU_lane_index :: (length:int,scale:int,offset:int,form:bool)->u32 #export_c {
 if !form || length<32 || length%32!=0 || scale!=length/32 || offset<0 || offset>=scale {return 23;}
 return 0;
}
#forall "per-lane arrays are indexed in lane loops or passed whole to primitives outside them" in_lane:bool, indexed:bool, primitive:bool {
 expected:u32=24;
 if indexed && in_lane {expected=0;} else if primitive && !in_lane {expected=0;} else if primitive {expected=28;}
 #assert CU_lane_use(in_lane,indexed,primitive)==expected;
}
CU_lane_use :: (in_lane:bool,indexed:bool,primitive:bool)->u32 #export_c {
 if indexed && in_lane {return 0;}
 if primitive {if in_lane {return 28;}return 0;}
 return 24;
}
#forall "a lane loop writes its own locals and per-lane elements only" outer:bool, lane_array:bool {
 #assert CU_lane_assign(outer,lane_array)==cast(u32)(ifx outer && !lane_array then 25 else 0);
}
CU_lane_assign :: (outer:bool,lane_array:bool)->u32 #export_c {if outer && !lane_array {return 25;}return 0;}
#forall "break and continue may not leave a lane loop" direct:bool {
 #assert CU_lane_jump(direct)==cast(u32)(ifx direct then 26 else 0);
}
CU_lane_jump :: (direct:bool)->u32 #export_c {if direct {return 26;}return 0;}
// cu_mma_bf16_16x8x16(a, b, c): a is [128]u32 (the 16x16 BF16 A fragment), b
// is [64]u32 (16x8 BF16 B), c is [128]f32 (16x8 f32, updated in place). The
// type codes are those of compute_code (10 u32, 2 f32).
#forall "the MMA primitive takes whole per-lane arrays of the fragment sizes" a:120..<136, b:60..<68, c:120..<136, ac:0..<12, cc:0..<4 {
 expected:u32=27;
 if a==128 && b==64 && c==128 && ac==10 && cc==2 {expected=0;}
 #assert CU_primitive_mma(a,b,c,cast(u32)ac,10,cast(u32)cc)==expected;
}
#test "the MMA primitive's B fragment is u32 too" {
 #assert CU_primitive_mma(128,64,128,10,10,2)==0 && CU_primitive_mma(128,64,128,10,2,2)==27 && CU_primitive_mma(128,64,128,10,11,2)==27;
}
CU_primitive_mma :: (a:int,b:int,c:int,a_code:u32,b_code:u32,c_code:u32)->u32 #export_c {
 if a!=128 || b!=64 || c!=128 || a_code!=10 || b_code!=10 || c_code!=2 {return 27;}
 return 0;
}

// Group kernels. A kernel that contains `for thread: 0..<T` loops, T a
// constant multiple of 32 from 32 to 1024, runs as one threadgroup (a CUDA
// block) of T threads per work item; the host launches it with T threads per
// group. Code outside thread loops is the group's shared control flow and
// runs identically in every thread; each thread loop is a phase in which
// thread t runs the body as its own `thread`, fenced by a barrier on both
// sides (Metal threadgroup_barrier, CUDA __syncthreads). Fixed arrays declared
// at the kernel body's top level and indexed inside thread loops are
// per-thread registers when every such index is thread*k+c into T*k values
// (as lane arrays), and threadgroup memory otherwise. A phase that writes a
// threadgroup array touches only the elements the thread owns, at
// thread*k + c (0 <= c < k) plus nonnegative multiples of T*k; shared code
// reads threadgroup arrays and never writes them. On the CPU a thread loop
// is an ordinary loop, so the same source compiled to C is the oracle.
CU_GROUP_WARPS :: 32; // a group is at most 32 warps (1024 threads)
CU_SHARED_LIMIT :: 32768; // bytes of threadgroup arrays per kernel: Apple GPUs allow 32 KiB
#forall "thread loops are 0..<T, T a multiple of 32 up to 1024, in a kernel, not nested" kernel:bool, constant:bool, lo:-1..<2, hi:0..<1100, nested:bool {
 expected:u32=0;
 if nested {expected=33;} else if !kernel || !constant || lo!=0 || hi<32 || hi>1024 || hi%32!=0 {expected=32;}
 #assert CU_thread_loop(kernel,constant,lo,hi,nested)==expected;
}
CU_thread_loop :: (kernel:bool,constant:bool,lo:int,hi:int,nested:bool)->u32 #export_c {
 if nested {return 33;}
 if !kernel || !constant || lo!=0 || hi<32 || hi%32!=0 || hi/32>CU_GROUP_WARPS {return 32;}
 return 0;
}
// A kernel's group size: every thread loop and group primitive names the
// same T; lane loops and the warp MMA primitive belong to warp kernels.
#forall "a group kernel has one size and no warp constructs" size:0..<70, other:0..<70, lane:bool, mma:bool {
 expected:u32=0;
 if lane || mma || (other!=0 && other!=size) {expected=34;}
 #assert CU_group_size(size,other,lane,mma)==expected;
}
CU_group_size :: (size:int,other:int,lane:bool,mma:bool)->u32 #export_c {
 if lane || mma || (other!=0 && other!=size) {return 34;}
 return 0;
}
// Arrays of a group kernel indexed in thread loops: 1 per-thread registers
// (every index there is thread*k+c into T*k values and nothing else uses
// the array), 2 threadgroup memory; 0 for an array no thread loop indexes.
#forall "per-thread arrays are those every thread loop indexes as its own" in_thread:bool, own:bool, elsewhere:bool {
 expected:u32=0;
 if in_thread {expected=ifx own && !elsewhere then 1 else 2;}
 #assert CU_group_array(in_thread,own,elsewhere)==expected;
}
CU_group_array :: (in_thread:bool,own:bool,elsewhere:bool)->u32 #export_c {
 if !in_thread {return 0;}
 if own && !elsewhere {return 1;}
 return 2;
}
#forall "threadgroup arrays fit 32 KiB" bytes:0..<40000 {
 #assert CU_shared_bytes(bytes)==cast(u32)(ifx bytes>32768 then 35 else 0);
}
CU_shared_bytes :: (bytes:int)->u32 #export_c {if bytes>CU_SHARED_LIMIT {return 35;}return 0;}
#forall "threadgroup arrays are declared at the top and only indexed" top:bool, indexed:bool {
 #assert CU_shared_use(top,indexed)==cast(u32)(ifx top && indexed then 0 else 36);
}
CU_shared_use :: (top:bool,indexed:bool)->u32 #export_c {if top && indexed {return 0;}return 36;}
// An index thread*k + c + (multiples of T*k) is the thread's own: k >= 1,
// c within [0, k) over its whole range, and every other term a nonnegative
// multiple of T*k (stride). Distinct threads then never meet.
#forall "an owned index is thread*k+c with c in [0,k) plus whole strides" form:bool, k:-1..<6, lo:-1..<7, hi:-1..<7, stride:bool {
 expected:=form && k>=1 && lo>=0 && hi<k && lo<=hi && stride;
 #assert CU_owned_index(form,k,lo,hi,stride)==expected;
}
CU_owned_index :: (form:bool,k:int,lo:int,hi:int,stride:bool)->bool #export_c {
 return form && k>=1 && lo>=0 && lo<=hi && hi<k && stride;
}
#forall "a phase that writes a threadgroup array touches only owned elements" writes:bool, owned:bool {
 #assert CU_shared_access(writes,owned)==cast(u32)(ifx writes && !owned then 37 else 0);
}
CU_shared_access :: (writes:bool,owned:bool)->u32 #export_c {if writes && !owned {return 37;}return 0;}
#forall "threadgroup arrays are written in thread loops only" in_thread:bool {
 #assert CU_shared_store(in_thread)==cast(u32)(ifx in_thread then 0 else 38);
}
CU_shared_store :: (in_thread:bool)->u32 #export_c {if in_thread {return 0;}return 38;}
#forall "a thread loop writes its own locals and arrays only" outer:bool, array:bool {
 #assert CU_thread_assign(outer,array)==cast(u32)(ifx outer && !array then 39 else 0);
}
CU_thread_assign :: (outer:bool,array:bool)->u32 #export_c {if outer && !array {return 39;}return 0;}
// Shared code runs in every thread of the group at once, so a store through
// a view there (directly or in a procedure it calls) would race with itself;
// thread loops and the matrix primitives write device memory instead.
#forall "views are written in thread loops only" view:bool, in_thread:bool {
 #assert CU_group_store(view,in_thread)==cast(u32)(ifx view && !in_thread then 44 else 0);
}
CU_group_store :: (view:bool,in_thread:bool)->u32 #export_c {if view && !in_thread {return 44;}return 0;}
#forall "break, continue and return may not leave a thread loop" direct:bool {
 #assert CU_thread_jump(direct)==cast(u32)(ifx direct then 40 else 0);
}
CU_thread_jump :: (direct:bool)->u32 #export_c {if direct {return 40;}return 0;}

// Apple matrix primitives (lib/compute/apple.coax), Metal only, called in a
// group kernel's shared code by every thread of the group. Kinds: 1
// am_sg_mma_64x32x32 (simdgroup matrices: acc [2048]f32 += a [2048]f32
// times b [1024]f32 transposed, both threadgroup arrays, in a group of 128),
// 2 am_sg_spill_64x32 (acc into a [2048]f32 threadgroup array), 3
// am_matmul_bf16 (Metal 4 tensor ops on device views: a tile of BF16 weights
// times f32 activations). acc is a matrix accumulator: the simdgroups' own
// registers on the device, so nothing else may use it.
#forall "Apple matrix primitives: Metal, shared code, the right arrays" kind:0..<5, metal:bool, shared_code:bool, ti:0..<6, ai:0..<3, a_tg:bool, b_tg:bool {
 sizes:=[6] int.[0,64,127,128,256,512];threads:=sizes[ti];
 // ai 0: the sizes the simdgroup primitives take; 1 and 2: one off in acc, a or b.
 acc:=2048;a:=2048;b:=1024;
 if ai==1 {acc=2047;b=1025;} else if ai==2 {a=1024;}
 expected:u32=0;
 if !metal {expected=42;}
 else if kind<1 || kind>3 || !shared_code {expected=41;}
 else if kind==1 && (threads!=128 || ai!=0 || !a_tg || !b_tg) {expected=41;}
 else if kind==2 && (threads!=128 || ai!=0 || !a_tg) {expected=41;}
 else if kind==3 && threads!=64 && threads!=128 && threads!=256 {expected=41;}
 #assert CU_apple_primitive(cast(u32)kind,metal,shared_code,threads,acc,a,b,a_tg,b_tg)==expected;
}
#test "each simdgroup primitive checks every size it reads" {
 #assert CU_apple_primitive(1,true,true,128,2048,2048,1024,true,true)==0 && CU_apple_primitive(1,true,true,128,2048,2048,1023,true,true)==41;
 #assert CU_apple_primitive(1,true,true,128,2049,2048,1024,true,true)==41 && CU_apple_primitive(1,true,true,128,2048,2047,1024,true,true)==41;
 #assert CU_apple_primitive(2,true,true,128,2048,2048,0,true,false)==0 && CU_apple_primitive(2,true,true,128,2047,2048,0,true,false)==41;
 #assert CU_apple_primitive(2,true,true,128,2048,2049,0,true,false)==41 && CU_apple_primitive(3,true,true,64,0,0,0,false,false)==0;
}
CU_apple_primitive :: (kind:u32,metal:bool,shared_code:bool,threads:int,acc:int,a:int,b:int,a_tg:bool,b_tg:bool)->u32 #export_c {
 if !metal {return 42;}
 if kind<1 || kind>3 || !shared_code {return 41;}
 if kind==1 && (threads!=128 || acc!=2048 || a!=2048 || b!=1024 || !a_tg || !b_tg) {return 41;}
 if kind==2 && (threads!=128 || acc!=2048 || a!=2048 || !a_tg) {return 41;}
 if kind==3 && threads!=64 && threads!=128 && threads!=256 {return 41;}
 return 0;
}
// The tile of am_matmul_bf16: tm tokens by tn rows, constants the Metal 4
// matrix descriptor accepts here.
#forall "tensor-op tiles are 16, 32 or 64 tokens by 32, 64 or 128 rows" tm:0..<130, tn:0..<130, constant:bool {
 expected:u32=41;
 if constant && (tm==16 || tm==32 || tm==64) && (tn==32 || tn==64 || tn==128) {expected=0;}
 #assert CU_apple_tile(tm,tn,constant)==expected;
}
CU_apple_tile :: (tm:int,tn:int,constant:bool)->u32 #export_c {
 if !constant {return 41;}
 if tm!=16 && tm!=32 && tm!=64 {return 41;}
 if tn!=32 && tn!=64 && tn!=128 {return 41;}
 return 0;
}
#forall "a matrix accumulator is used by Apple matrix primitives only" primitive:bool {
 #assert CU_accumulator_use(primitive)==cast(u32)(ifx primitive then 0 else 43);
}
CU_accumulator_use :: (primitive:bool)->u32 #export_c {if primitive {return 0;}return 43;}

// The Metal compute subset (`coax metal-compute`): the same admission as
// CUDA, lowered to Metal Shading Language. Apple GPUs have no binary64, so an
// f64 value is a float-float pair (hi + lo, about 48 significant bits) with
// compensated addition, exact products and exp, log, sqrt, abs and floor of
// its own. What has no float-float meaning is refused: a binary64 bit
// pattern, the other transcendentals and conversion to an integer. Views are
// device memory, so a view of a kernel's register array is refused except as
// a whole argument to a device primitive.
#test "the Metal fix names the float-float profile" {
 #assert MT_fix()=="coax metal-compute accepts what coax cuda accepts; f64 is a float-float pair, so its bit patterns, sin, cos, tan, pow and conversion to an integer are refused, and views point into device memory, never into a kernel's register arrays";
}
MT_fix :: ()->string #export_c {
 return "coax metal-compute accepts what coax cuda accepts; f64 is a float-float pair, so its bit patterns, sin, cos, tan, pow and conversion to an integer are refused, and views point into device memory, never into a kernel's register arrays";
}
#forall "Metal byte intrinsics: no binary64 bit patterns, otherwise as CUDA" code:0..<16 {
 expected:=CU_byte_intrinsic(cast(u32)code);
 if code==3 || code==5 {expected=29;}
 #assert MT_byte_intrinsic(cast(u32)code)==expected;
}
MT_byte_intrinsic :: (code:u32)->u32 #export_c {
 if code==3 || code==5 {return 29;}
 return CU_byte_intrinsic(code);
}
// Math intrinsics by native code: 1 sin, 2 cos, 3 tan, 4 exp, 5 log, 6 sqrt,
// 7 floor, 8 abs, 9 pow. On f64 only exp, log, sqrt, floor and abs have a
// float-float meaning; every f32 intrinsic is the precise Metal function.
#forall "Metal f64 math: exp, log, sqrt, floor and abs" code:0..<12, wide:bool {
 expected:u32=0;
 if wide && (code<4 || code>8) {expected=31;}
 #assert MT_math(cast(u32)code,wide)==expected;
}
MT_math :: (code:u32,wide:bool)->u32 #export_c {
 if wide && (code<4 || code>8) {return 31;}
 return 0;
}
// A conversion from f64 to an integer has no float-float meaning here.
#forall "Metal refuses f64 to integer" from:0..<18, to:0..<18 {
 expected:u32=0;
 if from==3 && to>=4 && to<=11 {expected=31;}
 #assert MT_cast(cast(u32)from,cast(u32)to)==expected;
}
MT_cast :: (from:u32,to:u32)->u32 #export_c {
 if from==3 && to>=4 && to<=11 {return 31;}
 return 0;
}
// A slice of a fixed array is a view of registers: only a device primitive's
// whole argument may be one.
#forall "Metal views never point into registers" array:bool, primitive:bool {
 #assert MT_slice(array,primitive)==cast(u32)(ifx array && !primitive then 30 else 0);
}
MT_slice :: (array:bool,primitive:bool)->u32 #export_c {
 if array && !primitive {return 30;}
 return 0;
}
