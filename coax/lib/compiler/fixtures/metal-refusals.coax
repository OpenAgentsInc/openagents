#test "Metal portable refusal 0" {
  c:=MS_REFUSALS[0];t:[8192]u32;n:=wg_parse(c.tree,t[..]);w:[MS_WORDS]u32;out:[131072]u8;
  for i:0..<MS_WORDS{w[i]=4000000000;}
  #assert MS_emit(t[0..<n],c.names,out[..],w[..])==c.reason;
}
