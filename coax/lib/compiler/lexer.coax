  #assert r.diagnostic.code=="E0110";
  decoded:[8] u8;r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_ident && r.token.loc.line==2 && r.token.loc.column==1 && r.token.loc.offset==4;
}

