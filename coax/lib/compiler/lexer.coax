#test "punctuation stream advances by longest match" {text:="( ..< <<= ) := || ! &= ^";state:=[1] LX_State.[LX_begin(text.count)];decoded:[1] u8;message:[64] u8;
  rlparen:=LX_next(text,state[..],decoded[..],message[..]);#assert rlparen.has_token && rlparen.token.kind==LX_Kind.k_lparen && rlparen.diagnostic.code=="";
  rdotdotlt:=LX_next(text,state[..],decoded[..],message[..]);#assert rdotdotlt.has_token && rdotdotlt.token.kind==LX_Kind.k_dotdotlt && rdotdotlt.diagnostic.code=="";
  rshl_equal:=LX_next(text,state[..],decoded[..],message[..]);#assert rshl_equal.has_token && rshl_equal.token.kind==LX_Kind.k_shl_equal && rshl_equal.diagnostic.code=="";
  rrparen:=LX_next(text,state[..],decoded[..],message[..]);#assert rrparen.has_token && rrparen.token.kind==LX_Kind.k_rparen && rrparen.diagnostic.code=="";
  rcolonequal:=LX_next(text,state[..],decoded[..],message[..]);#assert rcolonequal.has_token && rcolonequal.token.kind==LX_Kind.k_colonequal && rcolonequal.diagnostic.code=="";
  roror:=LX_next(text,state[..],decoded[..],message[..]);#assert roror.has_token && roror.token.kind==LX_Kind.k_oror && roror.diagnostic.code=="";
  rbang:=LX_next(text,state[..],decoded[..],message[..]);#assert rbang.has_token && rbang.token.kind==LX_Kind.k_bang && rbang.diagnostic.code=="";
  ramp_equal:=LX_next(text,state[..],decoded[..],message[..]);#assert ramp_equal.has_token && ramp_equal.token.kind==LX_Kind.k_amp_equal && ramp_equal.diagnostic.code=="";
  rcaret:=LX_next(text,state[..],decoded[..],message[..]);#assert rcaret.has_token && rcaret.token.kind==LX_Kind.k_caret && rcaret.diagnostic.code=="";
}

#test "word counts, scaled comparisons and exact quotients" {
  #assert LX_words(0)==0 && LX_words(1)==1 && LX_words(31)==1 && LX_words(32)==1 && LX_words(33)==2 && LX_words(64)==2 && LX_words(65)==3;
  a:=[3] u32.[0,2,0];b:=[3] u32.[0,3,0];
  #assert LX_compare_scaled(a[..],0,b[..],0)== -1;
  #assert LX_limb(a[..],4,1)==0;
  a[0]=7;a[1]=0;b[0]=7;b[1]=0;q:=LX_divide53(a[..],b[..]);#assert q==1 && LX_big_bits(a[..])==0;
  a[0]=15;b[0]=7;q=LX_divide53(a[..],b[..]);#assert q==2 && a[0]==1;
  #assert LX_decimal("2e308")==0x7ff0000000000000;
}

#test "comments end at exact source and adjacent delimiter boundaries" {
  decoded:[1] u8;message:[64] u8;
  text:="//abc";state:=[1] LX_State.[LX_begin(text.count)];r:=LX_next(text,state[..],decoded[..],message[..]);#assert r.has_token && r.token.kind==LX_Kind.k_eof && r.diagnostic.code=="";
  text="//x\nA";state[0]=LX_begin(text.count);r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_ident && r.token.loc.line==2 && r.token.loc.column==1;
  text="/**/A";state[0]=LX_begin(text.count);r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_ident && r.token.loc.offset==4 && r.diagnostic.code=="";
  text="/*/**/*/A";state[0]=LX_begin(text.count);r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_ident && r.token.loc.offset==8 && r.diagnostic.code=="";
}

#test "single letter directives and error recovery keep the next byte" {
  decoded:[4] u8;message:[64] u8;
  text:="#x";state:=[1] LX_State.[LX_begin(text.count)];r:=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_directive && r.token.text_begin==1 && r.token.text_end==2 && r.diagnostic.code=="";
  text="@x";state[0]=LX_begin(text.count);r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_annotation && r.diagnostic.code=="";
  text="?A";state[0]=LX_begin(text.count);r=LX_next(text,state[..],decoded[..],message[..]);#assert r.diagnostic.code=="E0108";
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_ident && r.token.loc.offset==1 && r.diagnostic.code=="";
}

#test "range punctuation is never a fractional part" {
  text:="1. 2..<3";state:=[1] LX_State.[LX_begin(text.count)];decoded:[1] u8;message:[64] u8;
  r:=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_int_lit && r.token.int_value==1;
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_dot;
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_int_lit && r.token.int_value==2;
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_dotdotlt;
  text="1.0e;";state[0]=LX_begin(text.count);r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_float_lit && r.token.float_value==0x3ff0000000000000 && r.token.text_end==4;
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_semicolon;
}

#test "escaped quote at EOF and escaped-storage exhaustion" {
  decoded:[8] u8;message:[64] u8;text:="\"a\\\"";state:=[1] LX_State.[LX_begin(text.count)];
  r:=LX_next(text,state[..],decoded[..],message[..]);#assert r.has_token && r.diagnostic.code=="E0106" && r.token.decoded_count==2 && decoded[1]==34;
  text="\"\\n\"";state[0]=LX_begin(text.count);r=LX_next(text,state[..],decoded[0..<0],message[..]);#assert !r.has_token && r.diagnostic.code=="E0111";
  d:=LX_dynamic(true,113,LX_Loc.{},message[..]);#assert d.fix=="use one of \\n \\t \\r \\0 \\\\ \\\"";
}

#test "f32 overflow midpoint 0" {text:="340282356779733661637539395458142568448.0f32";state:=[1] LX_State.[LX_begin(text.count)];decoded:[1] u8;message:[64] u8;r:=LX_next(text,state[..],decoded[..],message[..]);#assert r.has_token && r.token.float_value==0x47effffff0000000 && r.diagnostic.code=="E0109";}

#test "f32 overflow midpoint 1" {text:="340282356779733623858607532500980858880.0f32";state:=[1] LX_State.[LX_begin(text.count)];decoded:[1] u8;message:[64] u8;r:=LX_next(text,state[..],decoded[..],message[..]);#assert r.has_token && r.token.float_value==0x47efffffefffffff && r.diagnostic.code=="";}

#test "float token 0" {
  text:="1.25";state:=[1] LX_State.[LX_begin(text.count)];decoded:[64] u8;message:[64] u8;
  r:=LX_next(text,state[..],decoded[..],message[..]);
  #assert r.has_token && r.token.kind==LX_Kind.k_float_lit && r.token.float_value==0x3ff4000000000000 && r.token.float_bits==0 && r.token.text_end==text.count+0;
  #assert r.diagnostic.code=="";
}

