#test "punctuation ge" {p:=LX_punctuation(">=",0);#assert p.kind==LX_Kind.k_ge && p.text_end==2;}

#test "token spelling andand" {#assert LX_name(cast(u32)LX_Kind.k_andand)=="'&&'";}

#test "punctuation andand" {p:=LX_punctuation("&&",0);#assert p.kind==LX_Kind.k_andand && p.text_end==2;}

