// Coax source bytes to tokens, diagnostics and decoded literals.
// No host calls or heap allocation. The native adapter supplies bounded storage.
#authority;
LX_Mul :: struct {value:u64;overflow:bool;}

LX_mul :: (value:u64,digit:u64,base:u64)->LX_Mul {
  lo:=cast(u64)cast,trunc(u32)value*base+digit;
  hi:=(value>>32)*base+(lo>>32);
  return LX_Mul.{value=(cast(u64)cast,trunc(u32)hi<<32) | cast(u64)cast,trunc(u32)lo,overflow=hi>4294967295};
}
// Fixed-width unsigned limbs, modulo 2^(32*count). Decimal conversion retains
// at most 800 significant digits; its largest scaled operand is below 4096 bits.
LX_big_mul :: (a:[] u32,digit:u32) {
  carry:=cast(u64)digit;for i:0..<a.count {v:=cast(u64)a[i]*10+carry;a[i]=cast,trunc(u32)v;carry=v>>32;}
}
LX_big_bits :: (a:[] u32)->int {
  n:=a.count;while n>0 {n-=1;if a[n]!=0 {v:=a[n];bits:=0;while v!=0 {bits+=1;v=v>>1;}return n*32+bits;}}return 0;
}
LX_limb :: (a:[] u32,index:int,shift:int)->u32 {
  word:=shift/32;bit:=shift%32;at:=index-word;v:u32=0;
  if at>=0 && at<a.count {v=a[at]<<bit;}
  if bit!=0 && at>0 && at-1<a.count {v=v | (a[at-1]>>(32-bit));}return v;
}
LX_big_shift :: (a:[] u32,shift:int) {i:=a.count;while i>0 {i-=1;a[i]=LX_limb(a,i,shift);}}
LX_words :: (bits:int)->int {return (bits+31)/32;}
LX_compare_scaled :: (a:[] u32,left:int,b:[] u32,right:int)->int {
  ab:=LX_big_bits(a);bb:=LX_big_bits(b);if ab!=0 {ab+=left;}if bb!=0 {bb+=right;}
  if ab<bb {return -1;}if ab>bb {return 1;}
  words:=LX_words(ab);for j:0..<words {i:=words-1-j;x:=LX_limb(a,i,left);y:=LX_limb(b,i,right);if x<y {return -1;}if x>y {return 1;}}return 0;
}
LX_big_cmp :: (a:[] u32,b:[] u32,shift:int)->int {return LX_compare_scaled(a,0,b,shift);}
LX_Shifts :: struct {positive:int;negative:int;}
LX_signed_shift :: (n:int)->LX_Shifts {
  // Split a bounded signed shift without two equivalent zero-shift branches.
  mask:=n>>63;return LX_Shifts.{positive=n & (mask ^ -1),negative=(-n) & mask};
}
LX_binary_exp :: (n:[] u32,d:[] u32)->int {
  exponent:=LX_big_bits(n)-LX_big_bits(d);shift:=LX_signed_shift(exponent);
  if LX_compare_scaled(n,shift.negative,d,shift.positive)<0 {exponent-=1;}return exponent;
}
LX_Format :: struct {scale:int;subnormal:bool;}
LX_format :: (exponent:int)->LX_Format {
  if exponent< -1022 {return LX_Format.{scale=1074,subnormal=true};}
  return LX_Format.{scale=52-exponent};
}
LX_big_sub :: (a:[] u32,b:[] u32,shift:int) {
  borrow:u64=0;
  for i:0..<a.count {v:=cast(u64)a[i];need:=cast(u64)LX_limb(b,i,shift)+borrow;
    if v<need {a[i]=cast(u32)(4294967296+v-need);borrow=1;}else {a[i]=cast(u32)(v-need);borrow=0;}}
}
LX_exp :: (value:int,digit:int,limit:int)->int {if value>(limit-digit)/10 {return limit;}return value*10+digit;}
LX_Decimal :: struct {significant:int;kept:int;fraction:int;sticky:bool;exponent:int;}
LX_exp_limit :: (length:int)->int {return length+2048;}
LX_read_decimal :: (text:string,numerator:[] u32)->LX_Decimal {
  significant:=0;kept:=0;fraction:=0;after_dot:=false;sticky:=false;at:=0;
  while at<text.count {
    c:=text[at];if c==101 || c==69 {break;}at+=1;
    if c==46 {after_dot=true;continue;}if c==95 {continue;}
    digit:=cast(int)c-48;if after_dot {fraction+=1;}
    if significant==0 && digit==0 {continue;}significant+=1;
    if kept<800 {LX_big_mul(numerator,cast(u32)digit);kept+=1;}else if digit!=0 {sticky=true;}
  }
  exponent:=0;negative:=false;
  at+=1;if at<text.count && (text[at]==43 || text[at]==45) {negative=text[at]==45;at+=1;}
  while at<text.count {exponent=LX_exp(exponent,cast(int)text[at]-48,LX_exp_limit(text.count));at+=1;}
  if negative {exponent=-exponent;}
  return LX_Decimal.{significant=significant,kept=kept,fraction=fraction,sticky=sticky,exponent=exponent};
}
LX_divide53 :: (numerator:[] u32,denominator:[] u32)->u64 {
  quotient:u64=0;
  for j:0..<53 {bit:=52-j;if LX_big_cmp(numerator,denominator,bit)>=0 {LX_big_sub(numerator,denominator,bit);quotient=quotient | (cast(u64)1<<bit);}}
  return quotient;
}
LX_decimal :: (text:string)->u64 #export_c {
  numerator:[128] u32;denominator:[128] u32;denominator[0]=1;
  parsed:=LX_read_decimal(text,numerator[..]);
  significant:=parsed.significant;fraction:=parsed.fraction;kept:=parsed.kept;exponent:=parsed.exponent;sticky:=parsed.sticky;
  if significant==0 {return 0;}
  position:=significant-fraction+exponent;
  if position>309 {return 0x7ff0000000000000;}if position< -323 {return 0;}
  decimal_exp:=position-kept;
  for i:0..<decimal_exp {LX_big_mul(numerator[..],0);}
  for i:0..< -decimal_exp {LX_big_mul(denominator[..],0);}
  binary_exp:=LX_binary_exp(numerator[..],denominator[..]);
  if binary_exp>1023 {return 0x7ff0000000000000;}
  format:=LX_format(binary_exp);shift:=LX_signed_shift(format.scale);
  LX_big_shift(numerator[..],shift.positive);LX_big_shift(denominator[..],shift.negative);
  quotient:=LX_divide53(numerator[..],denominator[..]);
  cmp:=LX_big_cmp(denominator[..],numerator[..],1);
  if cmp<0 || (cmp==0 && ((quotient&1)!=0 || sticky)) {quotient+=1;}
  if format.subnormal {return quotient;}
  if quotient==9007199254740992 {binary_exp+=1;}
  return (cast(u64)(binary_exp+1023)<<52) | (quotient&4503599627370495);
}

LX_Kind :: enum u8 {
  k_eof = 0;
  k_ident = 1;
  k_keyword = 2;
  k_int_lit = 3;
  k_float_lit = 4;
  k_string_lit = 5;
  k_directive = 6;
  k_annotation = 7;
  k_lparen = 8;
  k_rparen = 9;
  k_lbrace = 10;
  k_rbrace = 11;
  k_lbracket = 12;
  k_rbracket = 13;
  k_comma = 14;
  k_semicolon = 15;
  k_colon = 16;
  k_coloncolon = 17;
  k_colonequal = 18;
  k_arrow = 19;
  k_dot = 20;
  k_dotdot = 21;
  k_dotdotlt = 22;
  k_equal = 23;
  k_plus_equal = 24;
  k_minus_equal = 25;
  k_star_equal = 26;
  k_slash_equal = 27;
  k_percent_equal = 28;
  k_amp_equal = 29;
  k_pipe_equal = 30;
  k_caret_equal = 31;
  k_shl_equal = 32;
  k_shr_equal = 33;
  k_plus = 34;
  k_minus = 35;
  k_star = 36;
  k_slash = 37;
  k_percent = 38;
  k_amp = 39;
  k_pipe = 40;
  k_caret = 41;
  k_shl = 42;
  k_shr = 43;
  k_eqeq = 44;
  k_noteq = 45;
  k_lt = 46;
  k_le = 47;
  k_gt = 48;
  k_ge = 49;
  k_andand = 50;
  k_oror = 51;
  k_bang = 52;
}
LX_Loc :: struct {line:int;column:int;offset:int;}
LX_Token :: struct {kind:LX_Kind;text_begin:int;text_end:int;loc:LX_Loc;int_value:u64;float_value:u64;float_bits:int;decoded:bool;decoded_count:int;}
LX_Diagnostic :: struct {code:string;message:string;fix:string;loc:LX_Loc;}
LX_Item :: struct {has_token:bool;token:LX_Token;diagnostic:LX_Diagnostic;}
LX_State :: struct {pos:int;line:int;line_start:int;mode:int;start:int;start_line:int;start_column:int;decoded_count:int;}
LX_Caps :: struct {decoded:int;diagnostic:int;}
LX_keyword :: (t:string)->bool {
  words:=[41] string.["struct","union","enum","enum_flags","if","else","ifx","then","while","for","break","continue","return","defer","switch","case","using","cast","xx","inline","no_inline","job","pure","strict","deterministic","shader","try","or_else","push_context","null","true","false","it","it_index","size_of","type_of","type_info","Type","Code","remove","constraint"];
  for w:words {if t==w {return true;}}return false;
}
LX_name :: (kind:u32)->string #export_c {
  words:=[53] string.["end of file","identifier","keyword","integer","float","string","directive","annotation","'('","')'","'{'","'}'","'['","']'","','","';'","':'","'::'","':='","'->'","'.'","'..'","'..<'","'='","'+='","'-='","'*='","'/='","'%='","'&='","'|='","'^='","'<<='","'>>='","'+'","'-'","'*'","'/'","'%'","'&'","'|'","'^'","'<<'","'>>'","'=='","'!='","'<'","'<='","'>'","'>='","'&&'","'||'","'!'"];
  index:=cast(int)kind;if index>=words.count {return "?";}return words[index];
}
LX_source :: (count:int)->bool {return count>=0 && count<=2147483646;}
LX_begin :: (count:int)->LX_State #export_c {s:=LX_State.{line=1};if !LX_source(count) {s.mode=2;}return s;}
LX_capacities :: (count:int)->LX_Caps #export_c {if !LX_source(count) {return LX_Caps.{diagnostic=64};}return LX_Caps.{decoded=count+1,diagnostic=64};}
LX_start :: (s:[] LX_State) {s[0].start=s[0].pos;s[0].start_line=s[0].line;s[0].start_column=s[0].pos-s[0].line_start+1;}
LX_location :: (s:[] LX_State,at:int)->LX_Loc {return LX_Loc.{line=s[0].line,column=at-s[0].line_start+1,offset=at};}
LX_saved :: (s:[] LX_State)->LX_Loc {return LX_Loc.{line=s[0].start_line,column=s[0].start_column,offset=s[0].start};}
LX_alpha :: (c:u8)->bool {return (c>=65 && c<=90) || (c>=97 && c<=122) || c==95;}
LX_digit :: (c:u8)->bool {return c>=48 && c<=57;}
LX_ident :: (c:u8)->bool {return LX_alpha(c) || LX_digit(c);}
LX_at :: (text:string,at:int)->u8 {if at<0 || at>=text.count {return 0;}return text[at];}
LX_has :: (text:string,at:int,pattern:string)->bool {return at>=0 && at<=text.count && pattern.count<=text.count-at && text[at..<at+pattern.count]==pattern;}
LX_newline :: (s:[] LX_State) {s[0].line+=1;s[0].line_start=s[0].pos+1;}
LX_escape :: (c:u8,character:bool)->int {
  if c==110 {return 10;}if c==116 {return 9;}if c==114 {return 13;}if c==48 {return 0;}if c==92 {return 92;}
  if character && c==39 {return 39;}if !character && c==34 {return 34;}return -1;
}
LX_static :: (tag:int,loc:LX_Loc)->LX_Diagnostic {
  d:=LX_Diagnostic.{loc=loc};
  if tag==1 {d.code="E0101";d.message="block comment is never closed";d.fix="add '*/'";}
  else if tag==3 {d.code="E0103";d.message="number has no digits after its base prefix";}
  else if tag==4 {d.code="E0104";d.message="integer literal does not fit in 64 bits";}
  else if tag==6 {d.code="E0106";d.message="string is never closed";d.fix="add '\"' before the end of the line";}
  else if tag==7 {d.code="E0107";d.message="non-ASCII character outside a string or comment";d.fix="identifiers are ASCII only (spec §5)";}
  else if tag==9 {d.code="E0109";d.message="a floating-point literal can only be followed by f32 or f64";}
  else if tag==12 {d.code="E0109";d.message="floating-point literal is too large for f64";}
  else if tag==13 {d.code="E0109";d.message="floating-point literal is too large for f32";}
  else if tag==10 {d.code="E0110";d.message="a character literal is one ASCII character in single quotes";d.fix="write 'a', or an escape such as '\\n'; text belongs in \"strings\"";}
  else {d.code="E0111";d.message="lexer storage budget exceeded";}
  return d;
}
LX_dynamic :: (escape:bool,byte:u8,loc:LX_Loc,out:[] u8)->LX_Diagnostic {
  prefix:="unexpected character '";d:=LX_Diagnostic.{code="E0108",loc=loc};
  if escape {prefix="unknown escape '\\";d.code="E0105";d.fix="use one of \\n \\t \\r \\0 \\\\ \\\"";}
  if out.count<prefix.count+2 {return LX_static(11,loc);}
  for c,i:prefix {out[i]=c;}out[prefix.count]=byte;out[prefix.count+1]=39;d.message=cast(string)out[0..<prefix.count+2];
  return d;
}
LX_item :: (s:[] LX_State,kind:LX_Kind)->LX_Item {return LX_Item.{has_token=true,token=LX_Token.{kind=kind,text_begin=s[0].start,text_end=s[0].pos,loc=LX_saved(s)}};}
LX_error :: (s:[] LX_State,tag:int)->LX_Item {return LX_Item.{diagnostic=LX_static(tag,LX_saved(s))};}
LX_eof :: (text:string,s:[] LX_State)->LX_Item {return LX_Item.{has_token=true,token=LX_Token.{kind=LX_Kind.k_eof,text_begin=text.count,text_end=text.count,loc=LX_location(s,text.count)}};}
LX_store :: (s:[] LX_State,out:[] u8,byte:u8)->bool {if s[0].decoded_count>=out.count {s[0].mode=3;return false;}out[s[0].decoded_count]=byte;s[0].decoded_count+=1;return true;}
LX_string :: (text:string,s:[] LX_State,out:[] u8,message:[] u8)->LX_Item {
  closed:=false;
  while s[0].pos<text.count {
    c:=text[s[0].pos];if c==34 {closed=true;s[0].pos+=1;break;}if c==10 {break;}
    if c==92 && s[0].pos+1<text.count {
      byte:=text[s[0].pos+1];s[0].pos+=2;value:=LX_escape(byte,false);
      if value<0 {return LX_Item.{diagnostic=LX_dynamic(true,byte,LX_location(s,s[0].pos-2),message)};}
      if !LX_store(s,out,cast(u8)value) {return LX_error(s,11);}continue;
    }
    if !LX_store(s,out,c) {return LX_error(s,11);}s[0].pos+=1;
  }
  s[0].mode=0;r:=LX_item(s,LX_Kind.k_string_lit);r.token.decoded=true;r.token.decoded_count=s[0].decoded_count;
  if !closed {r.diagnostic=LX_static(6,LX_saved(s));}return r;
}
LX_character :: (text:string,s:[] LX_State)->LX_Item {
  at:=s[0].pos;value:= -1;
  if at+2<text.count && text[at+1]!=92 && text[at+1]!=39 && text[at+2]==39 && text[at+1]<128 {value=cast(int)text[at+1];s[0].pos+=3;}
  else if at+3<text.count && text[at+1]==92 && text[at+3]==39 {value=LX_escape(text[at+2],true);s[0].pos+=4;}
  if value<0 {
    s[0].pos+=1;while s[0].pos<text.count && text[s[0].pos]!=39 && text[s[0].pos]!=10 {s[0].pos+=1;}
    if s[0].pos<text.count && text[s[0].pos]==39 {s[0].pos+=1;}return LX_error(s,10);
  }
  r:=LX_item(s,LX_Kind.k_int_lit);r.token.int_value=cast(u64)value;return r;
}
LX_exponent :: (text:string,at:int)->bool {
  if LX_at(text,at)!=101 && LX_at(text,at)!=69 {return false;}
  return LX_digit(LX_at(text,at+1)) || ((LX_at(text,at+1)==43 || LX_at(text,at+1)==45) && LX_digit(LX_at(text,at+2)));
}
LX_value_digit :: (c:u8,base:int)->int {
  if LX_digit(c) {return cast(int)c-48;}
  if base==16 && c>=97 && c<=102 {return cast(int)c-97+10;}
  if base==16 && c>=65 && c<=70 {return cast(int)c-65+10;}return -1;
}
LX_number :: (text:string,s:[] LX_State)->LX_Item {
  base:=10;value:u64=0;overflow:=false;have_digits:=false;
  if LX_has(text,s[0].pos,"0x") {base=16;s[0].pos+=2;}else if LX_has(text,s[0].pos,"0b") {base=2;s[0].pos+=2;}
  while s[0].pos<text.count {
    c:=text[s[0].pos];if c==95 {s[0].pos+=1;continue;}
    d:=LX_value_digit(c,base);if d<0 || d>=base {break;}
    acc:=LX_mul(value,cast(u64)d,cast(u64)base);value=acc.value;overflow=overflow || acc.overflow;have_digits=true;s[0].pos+=1;
  }
  fraction:=base==10 && LX_at(text,s[0].pos)==46 && LX_digit(LX_at(text,s[0].pos+1));
  exponent:=base==10 && LX_exponent(text,s[0].pos);
  if fraction || exponent {
    if fraction {s[0].pos+=2;while s[0].pos<text.count && (LX_digit(text[s[0].pos]) || text[s[0].pos]==95) {s[0].pos+=1;}}
    if LX_at(text,s[0].pos)==101 || LX_at(text,s[0].pos)==69 {
      s[0].pos+=1;if LX_at(text,s[0].pos)==43 || LX_at(text,s[0].pos)==45 {s[0].pos+=1;}
      while s[0].pos<text.count && LX_digit(text[s[0].pos]) {s[0].pos+=1;}
    }
    bits:=LX_decimal(text[s[0].start..<s[0].pos]);typed:=0;
    if LX_has(text,s[0].pos,"f32") {typed=32;s[0].pos+=3;}else if LX_has(text,s[0].pos,"f64") {typed=64;s[0].pos+=3;}
    tag:=0;
    if s[0].pos<text.count && LX_ident(text[s[0].pos]) {tag=9;while s[0].pos<text.count && LX_ident(text[s[0].pos]) {s[0].pos+=1;}}
    else if bits==0x7ff0000000000000 {tag=12;}else if typed==32 && bits>=0x47effffff0000000 {tag=13;}
    r:=LX_item(s,LX_Kind.k_float_lit);r.token.float_value=bits;r.token.float_bits=typed;
    if tag!=0 {r.diagnostic=LX_static(tag,LX_saved(s));}return r;
  }
  r:=LX_item(s,LX_Kind.k_int_lit);r.token.int_value=value;
  if !have_digits {r.diagnostic=LX_static(3,LX_saved(s));}else if overflow {r.diagnostic=LX_static(4,LX_saved(s));}return r;
}
LX_punctuation :: (text:string,at:int)->LX_Token {
  three:=[3] string.["..<","<<=",">>="];
  tk:=[3] LX_Kind.[LX_Kind.k_dotdotlt,LX_Kind.k_shl_equal,LX_Kind.k_shr_equal];
  for p,i:three {if LX_has(text,at,p) {return LX_Token.{kind=tk[i],text_end=3};}}
  two:=[20] string.["<<",">>","&=","|=","^=","::",":=","->","..","==","!=","<=",">=","&&","||","+=","-=","*=","/=","%="];
  kinds:=[20] LX_Kind.[LX_Kind.k_shl,LX_Kind.k_shr,LX_Kind.k_amp_equal,LX_Kind.k_pipe_equal,LX_Kind.k_caret_equal,LX_Kind.k_coloncolon,LX_Kind.k_colonequal,LX_Kind.k_arrow,LX_Kind.k_dotdot,LX_Kind.k_eqeq,LX_Kind.k_noteq,LX_Kind.k_le,LX_Kind.k_ge,LX_Kind.k_andand,LX_Kind.k_oror,LX_Kind.k_plus_equal,LX_Kind.k_minus_equal,LX_Kind.k_star_equal,LX_Kind.k_slash_equal,LX_Kind.k_percent_equal];
  for p,i:two {if LX_has(text,at,p) {return LX_Token.{kind=kinds[i],text_end=2};}}
  one:="(){}[],;:.=+-*/%<>!&|^";
  single:=[22] LX_Kind.[LX_Kind.k_lparen,LX_Kind.k_rparen,LX_Kind.k_lbrace,LX_Kind.k_rbrace,LX_Kind.k_lbracket,LX_Kind.k_rbracket,LX_Kind.k_comma,LX_Kind.k_semicolon,LX_Kind.k_colon,LX_Kind.k_dot,LX_Kind.k_equal,LX_Kind.k_plus,LX_Kind.k_minus,LX_Kind.k_star,LX_Kind.k_slash,LX_Kind.k_percent,LX_Kind.k_lt,LX_Kind.k_gt,LX_Kind.k_bang,LX_Kind.k_amp,LX_Kind.k_pipe,LX_Kind.k_caret];
  c:=LX_at(text,at);for b,i:one {if c==b {return LX_Token.{kind=single[i],text_end=1};}}return LX_Token.{};
}
LX_next :: (text:string,s:[] LX_State,decoded:[] u8,message:[] u8)->LX_Item #export_c {
  if s[0].mode==2 {s[0].mode=3;return LX_Item.{diagnostic=LX_static(11,LX_location(s,0))};}
  if s[0].mode==3 {return LX_eof(text,s);}
  if s[0].mode==1 {return LX_string(text,s,decoded,message);}
  while s[0].pos<text.count {
    c:=text[s[0].pos];if c==10 {LX_newline(s);s[0].pos+=1;continue;}
    if c==32 || c==9 || c==13 {s[0].pos+=1;continue;}
    if LX_has(text,s[0].pos,"//") {while s[0].pos<text.count && text[s[0].pos]!=10 {s[0].pos+=1;}continue;}
    LX_start(s);
    if LX_has(text,s[0].pos,"/*") {
      depth:=1;s[0].pos+=2;
      while s[0].pos<text.count && depth>0 {
        if LX_has(text,s[0].pos,"/*") {depth+=1;s[0].pos+=2;continue;}
        if LX_has(text,s[0].pos,"*/") {depth-=1;s[0].pos+=2;continue;}
        if text[s[0].pos]==10 {LX_newline(s);}s[0].pos+=1;
      }
      if depth>0 {return LX_error(s,1);}continue;
    }
    if LX_alpha(c) {while s[0].pos<text.count && LX_ident(text[s[0].pos]) {s[0].pos+=1;}
      r:=LX_item(s,LX_Kind.k_ident);if LX_keyword(text[r.token.text_begin..<r.token.text_end]) {r.token.kind=LX_Kind.k_keyword;}return r;}
    if (c==35 || c==64) && LX_alpha(LX_at(text,s[0].pos+1)) {
      s[0].pos+=1;begin:=s[0].pos;while s[0].pos<text.count && LX_ident(text[s[0].pos]) {s[0].pos+=1;}
      kind:=LX_Kind.k_directive;if c==64 {kind=LX_Kind.k_annotation;}r:=LX_item(s,kind);r.token.text_begin=begin;return r;
    }
    if LX_digit(c) {return LX_number(text,s);}
    if c==39 {return LX_character(text,s);}
    if c==34 {s[0].pos+=1;s[0].mode=1;s[0].decoded_count=0;return LX_string(text,s,decoded,message);}
    p:=LX_punctuation(text,s[0].pos);
    if p.kind!=LX_Kind.k_eof {s[0].pos+=p.text_end;return LX_item(s,p.kind);}
    s[0].pos+=1;if c>=128 {return LX_error(s,7);}return LX_Item.{diagnostic=LX_dynamic(false,c,LX_saved(s),message)};
  }return LX_eof(text,s);
}

#test "integer accumulator wraps and reports overflow" {
  r:=LX_mul(1844674407370955161,5,10);#assert r.value==18446744073709551615 && !r.overflow;
  r=LX_mul(1844674407370955161,6,10);#assert r.value==0 && r.overflow;
  r=LX_mul(0,0,2);#assert r.value==0 && !r.overflow;
  r=LX_mul(1152921504606846975,15,16);#assert r.value==18446744073709551615 && !r.overflow;
}

#forall "ASCII byte classes" c:u8 {
  alpha:=false;digit:=false;for x:"ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz" {if c==x {alpha=true;}}
  for x:"0123456789" {if c==x {digit=true;}}
  #assert LX_alpha(c)==alpha && LX_digit(c)==digit && LX_ident(c)==(alpha || digit);
}

#test "source and lookahead bounds" {
  #assert LX_source(0) && LX_source(2147483646) && !LX_source(-1) && !LX_source(2147483647);
  #assert LX_capacities(0).decoded==1 && LX_capacities(2147483646).decoded==2147483647;
  #assert LX_capacities(-1).decoded==0 && LX_capacities(-1).diagnostic==64;
  #assert LX_capacities(0).diagnostic==64;
  #assert LX_at("ab",-1)==0 && LX_at("ab",2)==0 && LX_at("ab",0)==97;
  #assert LX_has("abc",0,"ab") && LX_has("abc",2,"c") && !LX_has("abc",2,"cd");
  #assert !LX_has("abc",-1,"a") && !LX_has("abc",4,"") && LX_has("abc",3,"");
  decoded:[1] u8;message:[64] u8;state:=[1] LX_State.[LX_begin(-1)];
  r:=LX_next("",state[..],decoded[..],message[..]);#assert r.diagnostic.code=="E0111" && !r.has_token;
  r=LX_next("",state[..],decoded[..],message[..]);#assert r.has_token && r.token.kind==LX_Kind.k_eof;
}

#test "tokens retain directive spans and physical locations" {
  text:=" // comment\n/* a\n/* b */ c */ #forall @align thing_9 struct\n";
  state:=[1] LX_State.[LX_begin(text.count)];decoded:[64] u8;message:[64] u8;
  r:=LX_next(text,state[..],decoded[..],message[..]);
  #assert r.has_token && r.diagnostic.code=="" && r.token.kind==LX_Kind.k_directive;
  #assert text[r.token.text_begin..<r.token.text_end]=="forall" && r.token.loc.line==3 && r.token.loc.column==14;
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_annotation && text[r.token.text_begin..<r.token.text_end]=="align";
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_ident && text[r.token.text_begin..<r.token.text_end]=="thing_9";
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_keyword && text[r.token.text_begin..<r.token.text_end]=="struct";
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_eof && r.token.loc.line==4 && r.token.loc.column==1 && r.token.loc.offset==text.count;
}

#test "string escapes and error recovery preserve the token" {
  text:="\"a\\qb\\n\"";state:=[1] LX_State.[LX_begin(text.count)];decoded:[64] u8;message:[64] u8;
  r:=LX_next(text,state[..],decoded[..],message[..]);
  #assert !r.has_token && r.diagnostic.code=="E0105" && r.diagnostic.loc.offset==2 && r.diagnostic.loc.column==3;
  #assert r.diagnostic.message=="unknown escape '\\q'";
  r=LX_next(text,state[..],decoded[..],message[..]);
  #assert r.has_token && r.diagnostic.code=="" && r.token.kind==LX_Kind.k_string_lit && r.token.decoded && r.token.decoded_count==3;
  #assert cast(string)decoded[0..<3]=="ab\n" && r.token.text_begin==0 && r.token.text_end==text.count;
  state[0]=LX_begin(2);r=LX_next("\"x",state[..],decoded[..],message[..]);
  #assert r.has_token && r.token.decoded_count==1 && r.diagnostic.code=="E0106";
  state[0]=LX_begin(5);r=LX_next("/*\nxx",state[..],decoded[..],message[..]);
  #assert !r.has_token && r.diagnostic.code=="E0101" && r.diagnostic.loc.line==1 && r.diagnostic.loc.column==1;
  state[0]=LX_begin(3);r=LX_next("\"x\"",state[..],decoded[0..<0],message[..]);
  #assert r.diagnostic.code=="E0111" && state[0].mode==3;
  r=LX_next("\"x\"",state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_eof && r.has_token;
}

#test "escape vocabulary distinguishes chars and strings" {
  #assert LX_escape(110,false)==10 && LX_escape(116,false)==9 && LX_escape(114,true)==13 && LX_escape(48,true)==0 && LX_escape(92,true)==92;
  #assert LX_escape(39,true)==39 && LX_escape(39,false)== -1 && LX_escape(34,false)==34 && LX_escape(34,true)== -1;
  #assert LX_escape(113,false)== -1;
  message:[64] u8;loc:=LX_Loc.{line=2,column=3,offset=4};
  d:=LX_dynamic(false,63,loc,message[..]);#assert d.code=="E0108" && d.message=="unexpected character '?'" && d.loc.offset==4;
  d=LX_dynamic(false,63,loc,message[0..<0]);#assert d.code=="E0111";
  d=LX_static(7,loc);#assert d.code=="E0107" && d.fix=="identifiers are ASCII only (spec §5)";
}

#test "exponent recognition and radix digit boundaries" {
  #assert LX_exponent("e2",0) && LX_exponent("E+3",0) && LX_exponent("e-3",0);
  #assert !LX_exponent("E+",0) && !LX_exponent("E",0) && !LX_exponent("x3",0);
  #assert LX_value_digit(48,10)==0 && LX_value_digit(57,10)==9 && LX_value_digit(65,16)==10 && LX_value_digit(70,16)==15;
  #assert LX_value_digit(97,16)==10 && LX_value_digit(102,16)==15 && LX_value_digit(103,16)== -1 && LX_value_digit(65,10)== -1;
  #assert LX_exp(99,9,1000)==999 && LX_exp(100,1,1000)==1000;
}

