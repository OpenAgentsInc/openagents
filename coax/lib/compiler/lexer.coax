#test "decimal conversion basic and ties to even" {
  #assert LX_decimal("0.0")==0 && LX_decimal("1.0")==0x3ff0000000000000;
  #assert LX_decimal("0.1")==0x3fb999999999999a;
  #assert LX_decimal("1_2.5")==0x4029000000000000;
  #assert LX_decimal("9007199254740993.0")==0x4340000000000000;
  #assert LX_decimal("9007199254740995.0")==0x4340000000000002;
}

#test "decimal exponent and boundary 0" {#assert LX_decimal("1e-324")==0x0;}

#test "decimal exponent and boundary 1" {#assert LX_decimal("2.4703282292062327e-324")==0x0;}

#test "decimal exponent and boundary 2" {#assert LX_decimal("2.4703282292062328e-324")==0x1;}

#test "decimal exponent and boundary 3" {#assert LX_decimal("4.9406564584124654e-324")==0x1;}

#test "decimal exponent and boundary 4" {#assert LX_decimal("2.2250738585072014e-308")==0x10000000000000;}

#test "decimal exponent and boundary 5" {#assert LX_decimal("1.7976931348623157e308")==0x7fefffffffffffff;}

#test "decimal exponent and boundary 6" {#assert LX_decimal("1.7976931348623158e308")==0x7fefffffffffffff;}

#test "decimal exponent and boundary 7" {#assert LX_decimal("1.7976931348623159e308")==0x7ff0000000000000;}

#test "decimal exponent and boundary 8" {#assert LX_decimal("1e309")==0x7ff0000000000000;}

#test "decimal exponent and boundary 9" {#assert LX_decimal("1e-99999")==0x0;}

#test "decimal exponent and boundary 10" {#assert LX_decimal("0e99999")==0x0;}

#test "decimal exponent and boundary 11" {#assert LX_decimal("1e+2")==0x4059000000000000;}

#test "decimal exponent and boundary 12" {#assert LX_decimal("1e-2")==0x3f847ae147ae147b;}

#test "decimal exponent and boundary 13" {#assert LX_decimal("0.99999999999999999")==0x3ff0000000000000;}

#test "decimal exponent and boundary 14" {#assert LX_decimal("1.99999999999999999")==0x4000000000000000;}

#test "decimal exponent and boundary 15" {#assert LX_decimal("1e")==0x3ff0000000000000;}

#test "decimal exponent and boundary 16" {#assert LX_decimal("1.2e+")==0x3ff3333333333333;}

#test "limbs, modular borrow and comparison boundaries" {
  a:=[3] u32.[0,0x89abcdef,0];b:[3] u32;
  #assert LX_big_bits(b[..])==0 && LX_big_bits(a[..])==64;
  #assert LX_limb(a[..],3,0)==0 && LX_limb(a[..],4,32)==0;
  #assert LX_limb(a[..],2,1)==1 && LX_limb(a[..],2,31)==0x44d5e6f7;
  #assert LX_big_cmp(b[..],b[..],3)==0;
  #assert LX_big_cmp(a[..],b[..],0)==1 && LX_big_cmp(b[..],a[..],0)== -1;
  b[0]=1;#assert LX_big_cmp(b[..],b[..],0)==0 && LX_big_cmp(b[..],b[..],1)== -1;
  a[0]=0;a[1]=1;a[2]=0;LX_big_sub(a[..],b[..],0);#assert a[0]==4294967295 && a[1]==0;
  for i:0..<3 {a[i]=0;}a[0]=1;LX_big_shift(a[..],32);#assert a[0]==0 && a[1]==1;
  #assert LX_big_cmp(a[..],b[..],32)==0 && LX_big_cmp(a[..],b[..],31)==1;
  a[0]=1;#assert LX_big_cmp(a[..],b[..],32)==1;
}

#test "binary exponent and IEEE format plans" {
  a:=[2] u32.[1,0];b:=[2] u32.[1,0];
  #assert LX_binary_exp(a[..],b[..])==0;b[0]=2;#assert LX_binary_exp(a[..],b[..])== -1;
  b[0]=4;#assert LX_binary_exp(a[..],b[..])== -2;a[0]=3;#assert LX_binary_exp(a[..],b[..])== -1;
  a[0]=8;b[0]=1;#assert LX_binary_exp(a[..],b[..])==3;
  #assert LX_format(-1023).subnormal && LX_format(-1023).scale==1074;
  #assert !LX_format(-1022).subnormal && LX_format(-1022).scale==1074;
  #assert LX_format(52).scale==0 && LX_format(53).scale== -1;
  #assert LX_decimal("9e308")==0x7ff0000000000000;
  #assert LX_decimal("1E2")==0x4059000000000000;
}

#forall "signed binary scales" n:-1074..<1075 {
  s:=LX_signed_shift(n);#assert s.positive>=0 && s.negative>=0;
  #assert s.positive-s.negative==n && s.positive*s.negative==0;
}

#test "decimal records retain bounded precision and a sticky remainder" {
  n:[128] u32;p:=LX_read_decimal("001.200e-2",n[..]);
  #assert p.significant==4 && p.kept==4 && p.fraction==3 && p.exponent== -2 && !p.sticky && n[0]==1200;
  #assert LX_exp_limit(0)==2048 && LX_exp_limit(20)==2068;
  for i:0..<128 {n[i]=0;}p=LX_read_decimal("1e999999999999999",n[..]);#assert p.exponent==2065;
  bytes:[801] u8;for i:0..<801 {bytes[i]=48;}bytes[0]=49;bytes[800]=49;
  for i:0..<128 {n[i]=0;}p=LX_read_decimal(cast(string)bytes[..],n[..]);
  #assert p.significant==801 && p.kept==800 && p.sticky;
  bytes[800]=48;for i:0..<128 {n[i]=0;}p=LX_read_decimal(cast(string)bytes[..],n[..]);#assert !p.sticky;
}
