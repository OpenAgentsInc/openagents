#forall "one-byte source classification and progress" byte:u8 {
  bytes:=[1] u8.[byte];text:=cast(string)bytes[..];state:=[1] LX_State.[LX_begin(1)];decoded:[4] u8;message:[64] u8;
  r:=LX_next(text,state[..],decoded[..],message[..]);
  if LX_alpha(byte) {#assert r.has_token && r.token.kind==LX_Kind.k_ident && r.token.text_begin==0 && r.token.text_end==1;}
  else if LX_digit(byte) {#assert r.has_token && r.token.kind==LX_Kind.k_int_lit && r.token.int_value==cast(u64)(byte-48);}
  else if byte==10 {#assert r.has_token && r.token.kind==LX_Kind.k_eof && r.token.loc.line==2 && r.token.loc.column==1;}
  else if byte==9 || byte==13 || byte==32 {#assert r.has_token && r.token.kind==LX_Kind.k_eof && r.token.loc.line==1 && r.token.loc.column==2;}
  else if byte==34 {#assert r.has_token && r.token.kind==LX_Kind.k_string_lit && r.diagnostic.code=="E0106";}
  else if byte==39 {#assert !r.has_token && r.diagnostic.code=="E0110";}
  else if byte>=128 {#assert !r.has_token && r.diagnostic.code=="E0107";}
  else {
    punctuation:="(){}[],;:.=+-*/%<>!&|^";found:=false;
    for c:punctuation {if c==byte {found=true;}}
    if found {#assert r.has_token && r.diagnostic.code=="" && r.token.text_begin==0 && r.token.text_end==1;}
    else {#assert !r.has_token && r.diagnostic.code=="E0108";}
  }
  if !r.has_token || r.token.kind!=LX_Kind.k_eof {r=LX_next(text,state[..],decoded[..],message[..]);#assert r.has_token && r.token.kind==LX_Kind.k_eof && r.diagnostic.code=="";}
}

#test "consecutive strings reset decoded storage and return EOF" {
  text:="\"a\" \"\\n\\r\\t\\0\\\\\\\"\"";state:=[1] LX_State.[LX_begin(text.count)];decoded:[64] u8;message:[64] u8;
  r:=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.decoded_count==1 && decoded[0]==97;
  r=LX_next(text,state[..],decoded[..],message[..]);
  #assert r.has_token && r.token.kind==LX_Kind.k_string_lit && r.diagnostic.code=="" && r.token.decoded && r.token.decoded_count==6;
  #assert decoded[0]==10 && decoded[1]==13 && decoded[2]==9 && decoded[3]==0 && decoded[4]==92 && decoded[5]==34;
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.has_token && r.token.kind==LX_Kind.k_eof && r.diagnostic.code=="";
}

#test "physical newline ends a string and preserves following token locations" {
  text:="\"x\ny";state:=[1] LX_State.[LX_begin(text.count)];decoded:[64] u8;message:[64] u8;
  r:=LX_next(text,state[..],decoded[..],message[..]);#assert r.has_token && r.diagnostic.code=="E0106" && r.token.text_end==2 && r.token.decoded_count==1;
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.kind==LX_Kind.k_ident && r.token.loc.offset==3 && r.token.loc.line==2 && r.token.loc.column==1;
  state[0]=LX_begin(3);r=LX_next("\"a\\",state[..],decoded[..],message[..]);
  #assert r.has_token && r.diagnostic.code=="E0106" && r.token.decoded_count==2 && decoded[1]==92;
  state[0]=LX_begin(4);r=LX_next("\"ab\"",state[..],decoded[0..<1],message[..]);#assert r.diagnostic.code=="E0111" && !r.has_token;
}

#test "radix boundaries, fractional separators and f32 rounding overflow" {
  text:="0b102 0x1G 1.2_5E-2 1e39f32 1e309";state:=[1] LX_State.[LX_begin(text.count)];decoded:[64] u8;message:[64] u8;
  r:=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.int_value==2 && r.token.text_end==4 && r.diagnostic.code=="";
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.int_value==2 && r.token.text_begin==4;
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.int_value==1 && text[r.token.text_begin..<r.token.text_end]=="0x1";
  r=LX_next(text,state[..],decoded[..],message[..]);#assert text[r.token.text_begin..<r.token.text_end]=="G";
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.token.float_value==0x3f8999999999999a && r.diagnostic.code=="";
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.diagnostic.message=="floating-point literal is too large for f32";
  r=LX_next(text,state[..],decoded[..],message[..]);#assert r.diagnostic.message=="floating-point literal is too large for f64";
  #assert LX_value_digit(71,16)== -1;
  #assert LX_name(53)=="?";
}

#test "nonempty source cannot resume after a resource failure" {
  state:=[1] LX_State.[LX_begin(-1)];decoded:[1] u8;message:[64] u8;
  r:=LX_next("A",state[..],decoded[..],message[..]);#assert !r.has_token && r.diagnostic.code=="E0111" && state[0].mode==3;
  #assert r.diagnostic.loc.line==1 && r.diagnostic.loc.column==1 && r.diagnostic.loc.offset==0;
  r=LX_next("A",state[..],decoded[..],message[..]);#assert r.has_token && r.token.kind==LX_Kind.k_eof;
}

#test "diagnostic contract 1" {d:=LX_static(1,LX_Loc.{line=3,column=4,offset=5});#assert d.code=="E0101" && d.message=="block comment is never closed" && d.fix=="add '*/'" && d.loc.line==3 && d.loc.column==4 && d.loc.offset==5;}

#test "diagnostic contract 3" {d:=LX_static(3,LX_Loc.{line=3,column=4,offset=5});#assert d.code=="E0103" && d.message=="number has no digits after its base prefix" && d.fix=="" && d.loc.line==3 && d.loc.column==4 && d.loc.offset==5;}

#test "diagnostic contract 4" {d:=LX_static(4,LX_Loc.{line=3,column=4,offset=5});#assert d.code=="E0104" && d.message=="integer literal does not fit in 64 bits" && d.fix=="" && d.loc.line==3 && d.loc.column==4 && d.loc.offset==5;}

#test "diagnostic contract 6" {d:=LX_static(6,LX_Loc.{line=3,column=4,offset=5});#assert d.code=="E0106" && d.message=="string is never closed" && d.fix=="add '\"' before the end of the line" && d.loc.line==3 && d.loc.column==4 && d.loc.offset==5;}

#test "diagnostic contract 7" {d:=LX_static(7,LX_Loc.{line=3,column=4,offset=5});#assert d.code=="E0107" && d.message=="non-ASCII character outside a string or comment" && d.fix=="identifiers are ASCII only (spec §5)" && d.loc.line==3 && d.loc.column==4 && d.loc.offset==5;}

#test "diagnostic contract 9" {d:=LX_static(9,LX_Loc.{line=3,column=4,offset=5});#assert d.code=="E0109" && d.message=="a floating-point literal can only be followed by f32 or f64" && d.fix=="" && d.loc.line==3 && d.loc.column==4 && d.loc.offset==5;}

#test "diagnostic contract 12" {d:=LX_static(12,LX_Loc.{line=3,column=4,offset=5});#assert d.code=="E0109" && d.message=="floating-point literal is too large for f64" && d.fix=="" && d.loc.line==3 && d.loc.column==4 && d.loc.offset==5;}

#test "diagnostic contract 13" {d:=LX_static(13,LX_Loc.{line=3,column=4,offset=5});#assert d.code=="E0109" && d.message=="floating-point literal is too large for f32" && d.fix=="" && d.loc.line==3 && d.loc.column==4 && d.loc.offset==5;}

#test "diagnostic contract 10" {d:=LX_static(10,LX_Loc.{line=3,column=4,offset=5});#assert d.code=="E0110" && d.message=="a character literal is one ASCII character in single quotes" && d.fix=="write 'a', or an escape such as '\\n'; text belongs in \"strings\"" && d.loc.line==3 && d.loc.column==4 && d.loc.offset==5;}

#test "diagnostic contract 11" {d:=LX_static(11,LX_Loc.{line=3,column=4,offset=5});#assert d.code=="E0111" && d.message=="lexer storage budget exceeded" && d.fix=="" && d.loc.line==3 && d.loc.column==4 && d.loc.offset==5;}

#test "exact dynamic diagnostic capacity 5" {out:[19] u8;d:=LX_dynamic(true,113,LX_Loc.{},out[..]);#assert d.message=="unknown escape '\\q'";d=LX_dynamic(true,113,LX_Loc.{},out[0..<18]);#assert d.code=="E0111";}

#test "exact dynamic diagnostic capacity 8" {out:[24] u8;d:=LX_dynamic(false,63,LX_Loc.{},out[..]);#assert d.message=="unexpected character '?'";d=LX_dynamic(false,63,LX_Loc.{},out[0..<23]);#assert d.code=="E0111";}

#test "character recovery 0" {bytes:=[2] u8.[39,39];text:=cast(string)bytes[..];state:=[1] LX_State.[LX_begin(text.count)];message:[64] u8;r:=LX_character(text,state[..]);
  #assert state[0].pos==2 && r.has_token==false;
  #assert r.diagnostic.code=="E0110";
}

