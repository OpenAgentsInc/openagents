#test "punctuation oror" {p:=LX_punctuation("||",0);#assert p.kind==LX_Kind.k_oror && p.text_end==2;}

#test "token spelling bang" {#assert LX_name(cast(u32)LX_Kind.k_bang)=="'!'";}

#test "punctuation bang" {p:=LX_punctuation("!",0);#assert p.kind==LX_Kind.k_bang && p.text_end==1;}

