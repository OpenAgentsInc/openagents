// Conservative mutation scheduling policy. Native code observes the typed
// graph and actual baseline calls; this policy makes the scheduling decision.
#authority;

#forall "root scope changes sites, never the dependency check set" root_only:bool, root_source:bool {
 #assert MS_include(root_only,root_source)==(!root_only || root_source);
}

#forall "unsafe facts or a requested reference always run the full suite" reference:bool, borrowed:bool, strings:bool, unstable:bool {
 #assert MS_selective(reference,borrowed,strings,unstable)==(!reference && !borrowed && !strings && !unstable);
}
#forall "only a proven independent check may be skipped" selective:bool, entered:bool {
 #assert MS_run(selective,entered)==(!selective || entered);
}

// The driver observes each declaration's physical source provenance.
MS_include :: (root_only:bool,root_source:bool)->bool #export_c #effects(all) {return !root_only || root_source;}

MS_selective :: (reference:bool,borrowed_aggregate:bool,string_allocation:bool,unstable_storage:bool)->bool #export_c #effects(all) {
 return !reference && !borrowed_aggregate && !string_allocation && !unstable_storage;
}
MS_run :: (selective:bool,entered:bool)->bool #export_c #effects(all) {return !selective || entered;}

// TypeKind values are a versioned bridge to the checked native type graph.
// 0 scalar, 1 contains a view, 2 descend array, 3 descend struct, 4 refuse.
#forall "type observation has a closed action for every kind" kind:0..<16 {
 expected:=ifx kind==0 || kind>=12 then 4 else ifx kind==11 then 1 else ifx kind==10 then 2 else ifx kind==8 then 3 else 0;
 #assert MS_type_action(cast(u32)kind)==cast(u32)expected;
}
#forall "string allocation observation includes unknown expressions" expr:0..<20, ty:0..<13 {
 #assert MS_string_cast(cast(u32)expr,cast(u32)ty)==(expr>=18 || ty==0 || ty>=12 || (expr==14 && ty==5));
}
#forall "tracked storage changes disable isolation" a:0..<3,b:0..<3,c:0..<3,d:0..<3 {
 #assert MS_storage_changed(cast(u64)a,cast(u64)b,cast(u64)c,cast(u64)d)==(a!=c || b!=d);
}
MS_type_action :: (kind:u32)->u32 #export_c #effects(all) {
 if kind==0 || kind>=12 {return 4;}
 if kind==11 {return 1;} if kind==10 {return 2;} if kind==8 {return 3;}
 return 0;
}
MS_string_cast :: (expr:u32,ty:u32)->bool #export_c #effects(all) {return expr>=18 || ty==0 || ty>=12 || (expr==14 && ty==5);}
MS_storage_changed :: (before_slots:u64,before_containers:u64,after_slots:u64,after_containers:u64)->bool #export_c #effects(all) {
 return before_slots!=after_slots || before_containers!=after_containers;
}

// Parallel and sharded mutation. Every mutant has one global index in source
// order; shard s of n (1-based) owns the indices congruent to s-1 modulo n, so
// the shards are disjoint and their union is the whole set. Workers only
// change who evaluates a mutant, never which mutants exist or their order.
#forall "a shard spec is 1-based and bounded" shard:0..<6, count:0..<6 {
 #assert MS_shard_valid(cast(u64)shard,cast(u64)count)==(count>=1 && shard>=1 && shard<=count);
}
#test "shard counts are capped" {
 #assert MS_shard_valid(65536,65536) && !MS_shard_valid(1,65537) && MS_shard_valid(1,65536);
}
#forall "each mutant belongs to exactly its residue shard" index:0..<12, shard:1..<6, count:1..<6 {
 #assert MS_shard_owns(cast(u64)index,cast(u64)shard,cast(u64)count)==(shard<=count && index%count==shard-1);
}
#forall "shards partition the mutants" index:0..<40, count:1..<9 {
 owners:=0;
 for s:1..<count+1 { if MS_shard_owns(cast(u64)index,cast(u64)s,cast(u64)count) {owners+=1;} }
 #assert owners==1;
}
#test "job requests are capped" {
 #assert MS_jobs_valid(1) && MS_jobs_valid(1024) && !MS_jobs_valid(0) && !MS_jobs_valid(1025);
}
MS_shard_valid :: (shard:u64,count:u64)->bool #export_c #effects(all) {return count>=1 && count<=65536 && shard>=1 && shard<=count;}
MS_shard_owns :: (index:u64,shard:u64,count:u64)->bool #export_c #effects(all) {
 if !MS_shard_valid(shard,count) {return false;}
 return index%count==shard-1;
}
MS_jobs_valid :: (jobs:u64)->bool #export_c #effects(all) {return jobs>=1 && jobs<=1024;}

// Evidence outcomes (coax.evidence.v1). 0 passed, 1 counterexample,
// 2 inconclusive (a budget ran out before a verdict), 3 infrastructure error,
// 4 not checked. A claim is a pass only when it ran to a passing verdict.
EV_PASSED :: cast(u32) 0;
EV_COUNTEREXAMPLE :: cast(u32) 1;
EV_INCONCLUSIVE :: cast(u32) 2;
EV_INFRASTRUCTURE :: cast(u32) 3;
EV_NOT_CHECKED :: cast(u32) 4;

#forall "a check passes only when it ran and passed" ran:bool, passed:bool, budget:bool {
 want:=ifx !ran then EV_NOT_CHECKED else ifx passed then EV_PASSED else ifx budget then EV_INCONCLUSIVE else EV_COUNTEREXAMPLE;
 #assert EV_check(ran,passed,budget)==want;
}
// A whole run collects its claims' outcomes as a set (EV_add) and its
// verdict is the worst one present, in the order infrastructure error,
// counterexample, inconclusive, not checked, passed. An unknown outcome
// counts as an infrastructure error; a run with no claims was not checked.
#forall "the verdict is the worst outcome and never invents a pass" a:0..<6, b:0..<6 {
 rank:=[6] u32.[0,3,2,4,1,4];
 out:=[6] u32.[0,1,2,3,4,3];
 bits:=EV_add(EV_add(0,cast(u32)a+ifx a==5 then 4 else 0),cast(u32)b+ifx b==5 then 9 else 0);
 #assert EV_verdict(bits)==(ifx rank[a]>=rank[b] then out[a] else out[b]);
 #assert (EV_verdict(bits)==EV_PASSED)==(a==0 && b==0);
 #assert EV_verdict(EV_add(0,cast(u32)a))==out[a] || a==5;
}
#test "an empty run is not checked" {
 #assert EV_verdict(0)==EV_NOT_CHECKED;
 #assert EV_add(0,EV_PASSED)==1 && EV_add(0,EV_NOT_CHECKED)==2 && EV_add(0,EV_INCONCLUSIVE)==4 && EV_add(0,EV_COUNTEREXAMPLE)==8;
 #assert EV_add(0,EV_INFRASTRUCTURE)==16 && EV_add(2,7)==18;
}
// Mutation: survivors are counterexamples; no reachable site, or an
// unreached required procedure, is not a pass; one shard alone is
// inconclusive for the file.
#forall "a mutation run passes only as a complete, killing run" sites:bool, survivors:bool, unreached:bool, shard:bool {
 want:=ifx survivors then EV_COUNTEREXAMPLE else ifx !sites || unreached then EV_NOT_CHECKED else ifx shard then EV_INCONCLUSIVE else EV_PASSED;
 #assert EV_mutation(sites,survivors,unreached,shard)==want;
}

EV_check :: (ran:bool,passed:bool,budget:bool)->u32 #export_c #effects(all) {
 if !ran {return EV_NOT_CHECKED;}
 if passed {return EV_PASSED;}
 if budget {return EV_INCONCLUSIVE;}
 return EV_COUNTEREXAMPLE;
}
EV_add :: (bits:u32,outcome:u32)->u32 #export_c #effects(all) {
 if outcome==EV_PASSED {return bits|1;}
 if outcome==EV_NOT_CHECKED {return bits|2;}
 if outcome==EV_INCONCLUSIVE {return bits|4;}
 if outcome==EV_COUNTEREXAMPLE {return bits|8;}
 return bits|16;
}
EV_verdict :: (bits:u32)->u32 #export_c #effects(all) {
 if bits&16!=0 {return EV_INFRASTRUCTURE;}
 if bits&8!=0 {return EV_COUNTEREXAMPLE;}
 if bits&4!=0 {return EV_INCONCLUSIVE;}
 if bits&1!=0 && bits&2==0 {return EV_PASSED;}
 return EV_NOT_CHECKED;
}
EV_mutation :: (sites:bool,survivors:bool,unreached:bool,shard:bool)->u32 #export_c #effects(all) {
 if survivors {return EV_COUNTEREXAMPLE;}
 if !sites || unreached {return EV_NOT_CHECKED;}
 if shard {return EV_INCONCLUSIVE;}
 return EV_PASSED;
}

// Native mutants (#13582, coax/docs/native-mutants.md). coax mutate --native
// runs each mutant's scheduled checks as native code first. Native code never
// decides a verdict: a native kill only names the check the evaluator runs
// first, and a native survivor runs the evaluator's whole schedule. This
// policy holds the runner's decisions; the driver transports observations.
//
// A mutant's native outcome. 0 not run (no switch was written for its site,
// or native code ran none of its checks), 1 every scheduled check passed,
// 2 every check native code could run passed and it could not run some,
// 3 a trap, 4 a refusal (output or a host effect), 5 a crash, 6 out of ticks,
// 7 out of wall time.
NM_NOT_RUN :: cast(u32) 0;
NM_SURVIVED :: cast(u32) 1;
NM_SURVIVED_PART :: cast(u32) 2;
NM_TRAP :: cast(u32) 3;
NM_REFUSAL :: cast(u32) 4;
NM_CRASH :: cast(u32) 5;
NM_TICKS :: cast(u32) 6;
NM_WALL :: cast(u32) 7;
NM_MAX :: cast(u64) 18446744073709551615;

// A mutant's check gets ten times the ticks its unmutated native run used and
// never fewer than 10,000, as the evaluator gives ten times the steps and
// never fewer than 10,000. A tick is one procedure entered or one loop
// iteration. Its wall time is twenty times the unmutated run's and never
// under ten seconds: ticks bound every loop and call, so the clock only
// stops what ticks cannot see.
#test "a mutant's ticks are ten times the baseline, at least 10,000, and saturate" {
 #assert NM_tick_limit(0)==10000 && NM_tick_limit(1)==10000 && NM_tick_limit(999)==10000;
 #assert NM_tick_limit(1000)==10000 && NM_tick_limit(1001)==10010 && NM_tick_limit(250000)==2500000;
 #assert NM_tick_limit(1844674407370955161)==18446744073709551610;
 #assert NM_tick_limit(1844674407370955162)==NM_MAX && NM_tick_limit(NM_MAX)==NM_MAX;
}
#test "a mutant's wall time is twenty times the baseline, at least ten seconds, and saturates" {
 #assert NM_wall_ms(0)==10000 && NM_wall_ms(1)==10000 && NM_wall_ms(499)==10000;
 #assert NM_wall_ms(500)==10000 && NM_wall_ms(501)==10020 && NM_wall_ms(120000)==2400000;
 #assert NM_wall_ms(922337203685477580)==18446744073709551600;
 #assert NM_wall_ms(922337203685477581)==NM_MAX && NM_wall_ms(NM_MAX)==NM_MAX;
}
nm_scaled :: (baseline:u64,factor:u64,least:u64)->u64 #effects(all) {
 if baseline>NM_MAX/factor {return NM_MAX;}
 scaled:=baseline*factor;
 return ifx scaled<least then least else scaled; // mutant: equivalent (at the least, both forms return it)
}
NM_tick_limit :: (baseline:u64)->u64 #export_c #effects(all) {return nm_scaled(baseline,10,10000);}
NM_wall_ms :: (baseline_ms:u64)->u64 #export_c #effects(all) {return nm_scaled(baseline_ms,20,10000);}

#forall "only a stopped check is a native kill" outcome:0..<12 {
 #assert NM_killed(cast(u32)outcome)==(outcome==3 || outcome==4 || outcome==5 || outcome==6 || outcome==7);
}
NM_killed :: (outcome:u32)->bool #export_c #effects(all) {return outcome>=NM_TRAP && outcome<=NM_WALL;}

// Native code against the evaluator, mutant for mutant, after the evaluator
// has given its verdict. The evaluator's result is 0 survived, 1 a check
// failed, 2 a check stopped at a limit or rule only the evaluator has (its
// step and traversal budgets, call depth, a read of an unset local, a
// non-finite result). same_check: the evaluator's killing check is the one
// native code recorded. ran_killer: native code ran the evaluator's killing
// check and it passed there.
// 0 they agree. 1 they differ only where their limits do: native ticks or
// wall time against evaluator steps, in either direction. 2 they disagree:
// a failure of the native path, never a verdict. 3 nothing to compare.
#forall "native and evaluator outcomes compare by the recorded check and the kind of stop" native:0..<10, same:bool, ran:bool, evaluator:0..<4 {
 want:=3;
 if native>=1 && native<=7 && evaluator<=2 {
  if native<=2 {
   want=ifx evaluator==0 then 0 else ifx !ran then 3 else ifx evaluator==2 then 1 else 2;
  } else {
   want=ifx evaluator!=0 && same then 0 else ifx native==6 || native==7 then 1 else 2;
  }
 }
 #assert NM_compare(cast(u32)native,same,ran,cast(u32)evaluator)==cast(u32)want;
}
NM_compare :: (native:u32,same_check:bool,ran_killer:bool,evaluator:u32)->u32 #export_c #effects(all) {
 if native==NM_NOT_RUN || native>NM_WALL || evaluator>2 {return 3;}
 if !NM_killed(native) {
  if evaluator==0 {return 0;}
  if !ran_killer {return 3;}
  if evaluator==2 {return 1;}
  return 2;
 }
 if evaluator!=0 && same_check {return 0;}
 if native>=NM_TICKS {return 1;}
 return 2;
}
