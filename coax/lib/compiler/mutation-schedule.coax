// Conservative mutation scheduling policy. Native code observes the typed
// graph and actual baseline calls; this policy makes the scheduling decision.
#authority;

#forall "root scope changes sites, never the dependency check set" root_only:bool, root_source:bool {
 #assert MS_include(root_only,root_source)==(!root_only || root_source);
}

#forall "unsafe facts or a requested reference always run the full suite" reference:bool, borrowed:bool, strings:bool, unstable:bool {
 #assert MS_selective(reference,borrowed,strings,unstable)==(!reference && !borrowed && !strings && !unstable);
}
#forall "only a proven independent check may be skipped" selective:bool, entered:bool {
 #assert MS_run(selective,entered)==(!selective || entered);
}

// The driver observes each declaration's physical source provenance.
MS_include :: (root_only:bool,root_source:bool)->bool #export_c {return !root_only || root_source;}

MS_selective :: (reference:bool,borrowed_aggregate:bool,string_allocation:bool,unstable_storage:bool)->bool #export_c {
 return !reference && !borrowed_aggregate && !string_allocation && !unstable_storage;
}
MS_run :: (selective:bool,entered:bool)->bool #export_c {return !selective || entered;}

// TypeKind values are a versioned bridge to the checked native type graph.
// 0 scalar, 1 contains a view, 2 descend array, 3 descend struct, 4 refuse.
#forall "type observation has a closed action for every kind" kind:0..<16 {
 expected:=ifx kind==0 || kind>=12 then 4 else ifx kind==11 then 1 else ifx kind==10 then 2 else ifx kind==8 then 3 else 0;
 #assert MS_type_action(cast(u32)kind)==cast(u32)expected;
}
#forall "string allocation observation includes unknown expressions" expr:0..<20, ty:0..<13 {
 #assert MS_string_cast(cast(u32)expr,cast(u32)ty)==(expr>=18 || ty==0 || ty>=12 || (expr==14 && ty==5));
}
#forall "tracked storage changes disable isolation" a:0..<3,b:0..<3,c:0..<3,d:0..<3 {
 #assert MS_storage_changed(cast(u64)a,cast(u64)b,cast(u64)c,cast(u64)d)==(a!=c || b!=d);
}
MS_type_action :: (kind:u32)->u32 #export_c {
 if kind==0 || kind>=12 {return 4;}
 if kind==11 {return 1;} if kind==10 {return 2;} if kind==8 {return 3;}
 return 0;
}
MS_string_cast :: (expr:u32,ty:u32)->bool #export_c {return expr>=18 || ty==0 || ty>=12 || (expr==14 && ty==5);}
MS_storage_changed :: (before_slots:u64,before_containers:u64,after_slots:u64,after_containers:u64)->bool #export_c {
 return before_slots!=after_slots || before_containers!=after_containers;
}

// Parallel and sharded mutation. Every mutant has one global index in source
// order; shard s of n (1-based) owns the indices congruent to s-1 modulo n, so
// the shards are disjoint and their union is the whole set. Workers only
// change who evaluates a mutant, never which mutants exist or their order.
#forall "a shard spec is 1-based and bounded" shard:0..<6, count:0..<6 {
 #assert MS_shard_valid(cast(u64)shard,cast(u64)count)==(count>=1 && shard>=1 && shard<=count);
}
#test "shard counts are capped" {
 #assert MS_shard_valid(65536,65536) && !MS_shard_valid(1,65537) && MS_shard_valid(1,65536);
}
#forall "each mutant belongs to exactly its residue shard" index:0..<12, shard:1..<6, count:1..<6 {
 #assert MS_shard_owns(cast(u64)index,cast(u64)shard,cast(u64)count)==(shard<=count && index%count==shard-1);
}
#forall "shards partition the mutants" index:0..<40, count:1..<9 {
 owners:=0;
 for s:1..<count+1 { if MS_shard_owns(cast(u64)index,cast(u64)s,cast(u64)count) {owners+=1;} }
 #assert owners==1;
}
#test "job requests are capped" {
 #assert MS_jobs_valid(1) && MS_jobs_valid(1024) && !MS_jobs_valid(0) && !MS_jobs_valid(1025);
}
MS_shard_valid :: (shard:u64,count:u64)->bool #export_c {return count>=1 && count<=65536 && shard>=1 && shard<=count;}
MS_shard_owns :: (index:u64,shard:u64,count:u64)->bool #export_c {
 if !MS_shard_valid(shard,count) {return false;}
 return index%count==shard-1;
}
MS_jobs_valid :: (jobs:u64)->bool #export_c {return jobs>=1 && jobs<=1024;}

// Evidence outcomes (coax.evidence.v1). 0 passed, 1 counterexample,
// 2 inconclusive (a budget ran out before a verdict), 3 infrastructure error,
// 4 not checked. A claim is a pass only when it ran to a passing verdict.
EV_PASSED :: cast(u32) 0;
EV_COUNTEREXAMPLE :: cast(u32) 1;
EV_INCONCLUSIVE :: cast(u32) 2;
EV_INFRASTRUCTURE :: cast(u32) 3;
EV_NOT_CHECKED :: cast(u32) 4;

#forall "a check passes only when it ran and passed" ran:bool, passed:bool, budget:bool {
 want:=ifx !ran then EV_NOT_CHECKED else ifx passed then EV_PASSED else ifx budget then EV_INCONCLUSIVE else EV_COUNTEREXAMPLE;
 #assert EV_check(ran,passed,budget)==want;
}
// A whole run collects its claims' outcomes as a set (EV_add) and its
// verdict is the worst one present, in the order infrastructure error,
// counterexample, inconclusive, not checked, passed. An unknown outcome
// counts as an infrastructure error; a run with no claims was not checked.
#forall "the verdict is the worst outcome and never invents a pass" a:0..<6, b:0..<6 {
 rank:=[6] u32.[0,3,2,4,1,4];
 out:=[6] u32.[0,1,2,3,4,3];
 bits:=EV_add(EV_add(0,cast(u32)a+ifx a==5 then 4 else 0),cast(u32)b+ifx b==5 then 9 else 0);
 #assert EV_verdict(bits)==(ifx rank[a]>=rank[b] then out[a] else out[b]);
 #assert (EV_verdict(bits)==EV_PASSED)==(a==0 && b==0);
 #assert EV_verdict(EV_add(0,cast(u32)a))==out[a] || a==5;
}
#test "an empty run is not checked" {
 #assert EV_verdict(0)==EV_NOT_CHECKED;
 #assert EV_add(0,EV_PASSED)==1 && EV_add(0,EV_NOT_CHECKED)==2 && EV_add(0,EV_INCONCLUSIVE)==4 && EV_add(0,EV_COUNTEREXAMPLE)==8;
 #assert EV_add(0,EV_INFRASTRUCTURE)==16 && EV_add(2,7)==18;
}
// Mutation: survivors are counterexamples; no reachable site, or an
// unreached required procedure, is not a pass; one shard alone is
// inconclusive for the file.
#forall "a mutation run passes only as a complete, killing run" sites:bool, survivors:bool, unreached:bool, shard:bool {
 want:=ifx survivors then EV_COUNTEREXAMPLE else ifx !sites || unreached then EV_NOT_CHECKED else ifx shard then EV_INCONCLUSIVE else EV_PASSED;
 #assert EV_mutation(sites,survivors,unreached,shard)==want;
}

EV_check :: (ran:bool,passed:bool,budget:bool)->u32 #export_c {
 if !ran {return EV_NOT_CHECKED;}
 if passed {return EV_PASSED;}
 if budget {return EV_INCONCLUSIVE;}
 return EV_COUNTEREXAMPLE;
}
EV_add :: (bits:u32,outcome:u32)->u32 #export_c {
 if outcome==EV_PASSED {return bits|1;}
 if outcome==EV_NOT_CHECKED {return bits|2;}
 if outcome==EV_INCONCLUSIVE {return bits|4;}
 if outcome==EV_COUNTEREXAMPLE {return bits|8;}
 return bits|16;
}
EV_verdict :: (bits:u32)->u32 #export_c {
 if bits&16!=0 {return EV_INFRASTRUCTURE;}
 if bits&8!=0 {return EV_COUNTEREXAMPLE;}
 if bits&4!=0 {return EV_INCONCLUSIVE;}
 if bits&1!=0 && bits&2==0 {return EV_PASSED;}
 return EV_NOT_CHECKED;
}
EV_mutation :: (sites:bool,survivors:bool,unreached:bool,shard:bool)->u32 #export_c {
 if survivors {return EV_COUNTEREXAMPLE;}
 if !sites || unreached {return EV_NOT_CHECKED;}
 if shard {return EV_INCONCLUSIVE;}
 return EV_PASSED;
}
