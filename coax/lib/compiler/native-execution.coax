 r:=EP_baseline(b,ss[..],cs[..],p,"/a.coax",EP_TEST_SHA,EP_TEST_COMPILER,"test compiler",20000000);#assert r.valid && r.outcome==EV_NOT_CHECKED;
 cs[0].line=4294967295;cs[0].column=4294967295;cs[0].cases=1;cs[0].outcome="passed";b=ep_test_base();p=ep_test_process();
