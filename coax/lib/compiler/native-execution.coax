 wire=EP_TEST_EXECUTION;id.name="xlpha\0omegaλ";#assert EP_execution(id,wire[..],p)==EV_INFRASTRUCTURE;
 id=ep_test_identity();id.source="!a.coax";#assert EP_execution(id,wire[..],p)==EV_INFRASTRUCTURE;
 id=ep_test_identity();id.name="x";#assert EP_execution(id,wire[..],p)==EV_INFRASTRUCTURE;
 cat=EP_TEST_CATALOG;cat[56]=0;#assert !EP_decode(cat[..],20).ok;
 small:[41]u8;#assert EP_encode_row(3,0,0,"","/",1,1,small[..])==41;
 #assert EP_decode(small[..],0).ok;
}
