 b.check_steps=0;r=EP_baseline(b,ss[..],cs[..],p,"/a.coax",EP_TEST_SHA,EP_TEST_COMPILER,"test compiler",0);#assert !r.valid && r.reason==5;
 b.check_steps=20000001;r=EP_baseline(b,ss[..],cs[..],p,"/a.coax",EP_TEST_SHA,EP_TEST_COMPILER,"test compiler",20000001);#assert !r.valid && r.reason==5;
}

#test "artifact integrity requires a valid expected hash and exact observed bytes" {
 #assert EP_integrity(EP_TEST_SHA,EP_TEST_SHA)==EV_PASSED;
 #assert EP_integrity(EP_TEST_SHA,EP_TEST_COMPILER)==EV_INFRASTRUCTURE;
 #assert EP_integrity("bad","bad")==EV_INFRASTRUCTURE;
 #assert EP_integrity("bad",EP_TEST_SHA)==EV_INFRASTRUCTURE;
 #assert EP_integrity(EP_TEST_SHA,"bad")==EV_INFRASTRUCTURE;
}
EP_integrity :: (expected_sha:string,observed_sha:string)->u32 #export_c {return ifx ep_sha(expected_sha) && expected_sha==observed_sha then EV_PASSED else EV_INFRASTRUCTURE;}

#test "requested evaluator steps refuse raised disabled and malformed caps before effects" {
 #assert EP_steps(1) && EP_steps(20000000);
 #assert !EP_steps(0) && !EP_steps(-1) && !EP_steps(20000001);
}
EP_steps :: (steps:int)->bool #export_c {return steps>0 && steps<=EP_STEPS;}

#test "original baseline profile binds source and descriptor observations" {
 m:=EP_Emission.{schema=1,command="test",backend="evaluator",compiler="test compiler",runtime_arithmetic="checked",interpreter_arithmetic="checked",build_profile="development",success=1};
 s:=[1]EP_Source.[ep_test_source()];d:=[1]EP_Source.[ep_test_source()];d[0].path="/schema.pb";d[0].observed_path="/schema.pb";p:=ep_test_process();
 #assert EP_baseline_inputs(m,s[..],s[..],d[..],true,true,p,"test compiler")==EV_PASSED;
 #assert EP_baseline_inputs(m,s[..],s[..],d[0..<0],true,true,p,"test compiler")==EV_PASSED;
 #assert EP_baseline_inputs(m,s[..],s[..],d[..],false,true,p,"test compiler")==EV_INFRASTRUCTURE;
 #assert EP_baseline_inputs(m,s[..],s[..],d[..],true,false,p,"test compiler")==EV_INFRASTRUCTURE;
 p.timeout=true;#assert EP_baseline_inputs(m,s[..],s[..],d[..],true,true,p,"test compiler")==EV_INCONCLUSIVE;
 p.timeout=false;m.compiler="";#assert EP_baseline_inputs(m,s[..],s[..],d[..],true,true,p,"")==EV_INFRASTRUCTURE;
}
#forall "baseline profile refuses each identity source or descriptor discrepancy" defect:0..<16 {
 m:=EP_Emission.{schema=1,command="test",backend="evaluator",compiler="test compiler",runtime_arithmetic="checked",interpreter_arithmetic="checked",build_profile="development",success=1};
 a:=[1]EP_Source.[ep_test_source()];b:=[1]EP_Source.[ep_test_source()];d:=[2]EP_Source.[ep_test_source(),ep_test_source()];p:=ep_test_process();n:=1;
 if defect==0 {m.schema=0;}else if defect==1 {m.command="checks-c";}else if defect==2 {m.backend="c11";}else if defect==3 {m.compiler="other";}
 else if defect==4 {m.runtime_arithmetic="wrapping";}else if defect==5 {m.interpreter_arithmetic="wrapping";}else if defect==6 {m.build_profile="release";}
 else if defect==7 {m.success=0;}else if defect==8 {m.exit_status=1;}else if defect==9 {b[0].sha=EP_TEST_COMPILER;b[0].observed_sha=EP_TEST_COMPILER;}
 else if defect==10 {b[0].path="/other";b[0].observed_path="/other";}else if defect==11 {d[0].sha="bad";d[0].observed_sha="bad";}
 else if defect==12 {d[0].observed_path="/other";}else if defect==13 {d[0].observed_sha=EP_TEST_COMPILER;}else if defect==14 {n=2;}else {p.returncode=1;}
 #assert EP_baseline_inputs(m,a[..],b[..],d[0..<n],true,true,p,"test compiler")==EV_INFRASTRUCTURE;
}
#forall "empty descriptor sets require both explicit list observations" baseline_observed:bool,emitted_observed:bool {
 s:=[1]EP_Source.[ep_test_source()];
 #assert EP_input_descriptors(s[0..<0],s[0..<0],baseline_observed,emitted_observed)==(ifx baseline_observed && emitted_observed then EV_PASSED else EV_INFRASTRUCTURE);
}
#test "descriptor bindings preserve observed equality uniqueness and one-sided presence" {
 a:=[2]EP_Source.[ep_test_source(),ep_test_source()];b:=[2]EP_Source.[ep_test_source(),ep_test_source()];
 #assert EP_input_descriptors(a[0..<1],b[0..<1],true,true)==EV_PASSED;
 #assert EP_input_descriptors(a[0..<0],b[0..<1],true,true)==EV_INFRASTRUCTURE;
 #assert EP_input_descriptors(a[0..<1],b[0..<0],true,true)==EV_INFRASTRUCTURE;
 #assert EP_input_descriptors(a[..],b[..],true,true)==EV_INFRASTRUCTURE;
 b[0].sha=EP_TEST_COMPILER;b[0].observed_sha=EP_TEST_COMPILER;
 #assert EP_input_descriptors(a[0..<1],b[0..<1],true,true)==EV_INFRASTRUCTURE;
 #assert EP_input_descriptors(a[0..<1],a[0..<1],false,true)==EV_INFRASTRUCTURE;
 #assert EP_input_descriptors(a[0..<1],a[0..<1],true,false)==EV_INFRASTRUCTURE;
}
EP_baseline_inputs :: (meta:EP_Emission,evidence_sources:[]EP_Source,profile_sources:[]EP_Source,descriptors:[]EP_Source,sources_observed:bool,descriptors_observed:bool,process:EP_Process,expected_compiler:string)->u32 #export_c {
 p:=EP_phase(process);if p!=EV_PASSED {return p;}
 if meta.schema!=1 || meta.command!="test" || meta.backend!="evaluator" || !ep_text(expected_compiler.count) || meta.compiler!=expected_compiler ||
  meta.runtime_arithmetic!="checked" || meta.interpreter_arithmetic!="checked" || meta.build_profile!="development" || meta.success!=1 || meta.exit_status!=0 ||
  !sources_observed || !descriptors_observed || !EP_sources_match(evidence_sources,profile_sources) {return EV_INFRASTRUCTURE;}
 if descriptors.count>0 && !ep_sources_valid(descriptors) {return EV_INFRASTRUCTURE;}
 return EV_PASSED;
}
EP_input_descriptors :: (baseline:[]EP_Source,emitted:[]EP_Source,baseline_observed:bool,emitted_observed:bool)->u32 #export_c {
 if !baseline_observed || !emitted_observed {return EV_INFRASTRUCTURE;}
 if baseline.count==0 && emitted.count==0 {return EV_PASSED;}
 if !EP_sources_match(baseline,emitted) {return EV_INFRASTRUCTURE;}return EV_PASSED;
}

// Checked policy over supplied observations; no filesystem, process, JSON or pointer effects.
EP_frame_limit :: ()->int #export_c {return EP_FRAME_LIMIT;}
EP_limits :: ()->EP_Limits #export_c {
 return EP_Limits.{checks=EP_CHECK_LIMIT,text_bytes=EP_TEXT_LIMIT,frame_bytes=EP_FRAME_LIMIT,
  metadata_bytes=EP_METADATA_LIMIT,process_output_bytes=EP_PROCESS_LIMIT,baseline_output_bytes=EP_METADATA_LIMIT,
  compile_ms=120000,case_ms=EP_CASE_MS,metadata_ms=5000,baseline_ms=120000,total_ms=EP_TOTAL_MS,steps=EP_STEPS};
}
EP_budget :: (case_ms:int,output_bytes:int,total_ms:int)->bool #export_c {
 return case_ms>0 && case_ms<=EP_CASE_MS && output_bytes>0 && output_bytes<=EP_PROCESS_LIMIT && total_ms>0 && total_ms<=EP_TOTAL_MS;
}
EP_mode :: (text:string)->u32 #export_c {if text=="metadata" {return 1;}if text=="one" {return 2;}return 0;}
EP_ordinal :: (text:string)->int #export_c {
 if text.count<1 {return -1;}
 if text[0]==48 && text.count!=1 {return -1;}
 value:int=0;for i:0..<text.count {if text[i]<48 || text[i]>57 {return -1;}value=value*10+cast(int)text[i]-48;if value>=EP_CHECK_LIMIT {return -1;}}
 return value;
}
EP_request :: (argc:int,mode:string,ordinal:string)->EP_Request #export_c {
 m:=EP_mode(mode);
 if m==1 && argc==2 && ordinal.count==0 {return EP_Request.{mode=1};}
 if m==2 && argc==3 {n:=EP_ordinal(ordinal);if n<0 {return EP_Request.{reason=2};}return EP_Request.{mode=2,ordinal=n};}
 return EP_Request.{reason=1};
}
EP_table :: (count:int,present:bool)->bool #export_c {return present && count>=1 && count<=EP_CHECK_LIMIT;}
EP_select :: (count:int,ordinal:int)->bool #export_c {return EP_table(count,true) && ordinal>=0 && ordinal<count;}
EP_row_valid :: (count:int,ordinal:int,index:int,line:int,column:int,name_count:int,source_count:int,run_present:bool,name_present:bool,source_present:bool)->bool #export_c {
 return EP_select(count,ordinal) && index>=0 && index<EP_CHECK_LIMIT && ep_location(line) && ep_location(column) &&
  ep_bytes(name_count) && ep_text(source_count) && run_present && (name_present || name_count==0) && source_present;
}
EP_encode_header :: (count:int,out:[]u8)->int #export_c {
 if !EP_table(count,true) || out.count<20 {return -1;}
 for i:0..<8 {out[i]=EP_MAGIC[i];}
 ep_put(out,8,1);ep_put(out,12,20);ep_put(out,16,count);return 20;
}
EP_encode_row :: (kind:u32,ordinal:int,index:int,name:string,source:string,line:int,column:int,out:[]u8)->int #export_c {
 if kind<2 || kind>4 || !EP_row_valid(EP_CHECK_LIMIT,ordinal,index,line,column,name.count,source.count,true,true,true) {return -1;}
 total:=40+name.count+source.count;if out.count<total {return -1;}
 for i:0..<8 {out[i]=EP_MAGIC[i];}
 ep_put(out,8,cast(int)kind);ep_put(out,12,total);ep_put(out,16,ordinal);ep_put(out,20,index);
 ep_put(out,24,line);ep_put(out,28,column);ep_put(out,32,name.count);ep_put(out,36,source.count);
 for i:0..<name.count {out[40+i]=name[i];}
 for i:0..<source.count {out[40+name.count+i]=source[i];}
 return total;
}
ep_put :: (out:[]u8,at:int,value:int) {n:=value;for i:0..<4 {out[at+i]=cast(u8)(n%256);n/=256;}}
ep_get :: (data:[]u8,at:int)->int {value:int=0;factor:int=1;for i:0..<4 {value+=cast(int)data[at+i]*factor;factor*=256;}return value;}
EP_decode :: (data:[]u8,offset:int)->EP_Frame #export_c {
 if offset<0 || data.count-offset<20 {return EP_Frame.{};}
 for i:0..<8 {if data[offset+i]!=EP_MAGIC[i] {return EP_Frame.{};}}
 kind:=ep_get(data,offset+8);total:=ep_get(data,offset+12);
 if total>data.count-offset {return EP_Frame.{};}
 if kind==1 {
  if total!=20 {return EP_Frame.{};}count:=ep_get(data,offset+16);
  if !EP_table(count,true) {return EP_Frame.{};}
  return EP_Frame.{ok=true,kind=1,next=offset+total,count=count};
 }
 if kind<2 || kind>4 || data.count-offset<41 {return EP_Frame.{};}
 ordinal:=ep_get(data,offset+16);index:=ep_get(data,offset+20);line:=ep_get(data,offset+24);column:=ep_get(data,offset+28);
 names:=ep_get(data,offset+32);sources:=ep_get(data,offset+36);
 if !EP_row_valid(EP_CHECK_LIMIT,ordinal,index,line,column,names,sources,true,true,true) || total!=40+names+sources {return EP_Frame.{};}
 return EP_Frame.{ok=true,kind=cast(u32)kind,next=offset+total,ordinal=ordinal,declaration_index=index,line=line,column=column,
  name_offset=offset+40,name_count=names,source_offset=offset+40+names,source_count=sources};
}
ep_transport :: (p:EP_Process)->u32 {
 if p.timeout || p.output_limit {return EV_INCONCLUSIVE;}
 if !p.launched || !p.finished || p.read_errno!=0 || !p.stdout_eof || !p.stderr_eof {return EV_INFRASTRUCTURE;}
 return EV_PASSED;
}
EP_phase :: (process:EP_Process)->u32 #export_c {
 t:=ep_transport(process);if t!=EV_PASSED {return t;}if process.returncode!=0 {return EV_INFRASTRUCTURE;}return EV_PASSED;
}
ep_span :: (data:[]u8,offset:int,count:int,expected:string)->bool {
 if count!=expected.count {return false;}for i:0..<count {if data[offset+i]!=expected[i] {return false;}}return true;
}
ep_identity :: (expected:EP_Identity,frame:EP_Frame,data:[]u8)->bool {
 return frame.ordinal==expected.ordinal && frame.declaration_index==expected.declaration_index && frame.line==expected.line && frame.column==expected.column &&
  ep_span(data,frame.name_offset,frame.name_count,expected.name) && ep_span(data,frame.source_offset,frame.source_count,expected.source);
}
EP_metadata :: (expected:[]EP_Identity,data:[]u8,process:EP_Process)->u32 #export_c {
 p:=EP_phase(process);if p!=EV_PASSED {return p;}
 if expected.count==0 {return EV_INFRASTRUCTURE;}
 h:=EP_decode(data,0);if h.count!=expected.count {return EV_INFRASTRUCTURE;}
 offset:=h.next;for i:0..<expected.count {
  f:=EP_decode(data,offset);
  if f.kind!=2 || expected[i].ordinal!=i || !ep_identity(expected[i],f,data) {return EV_INFRASTRUCTURE;}
  offset=f.next;
 }
 if offset!=data.count {return EV_INFRASTRUCTURE;}return EV_PASSED;
}
EP_execution :: (expected:EP_Identity,data:[]u8,process:EP_Process)->u32 #export_c {
 p:=ep_transport(process);if p!=EV_PASSED {return p;}
 begin:=EP_decode(data,0);if begin.kind!=3 || !ep_identity(expected,begin,data) {return EV_INFRASTRUCTURE;}
 // A signal after one whole BEGIN is a raw counterexample, not a typed trap.
 if begin.next==data.count && process.returncode<0 {return EV_COUNTEREXAMPLE;}
 end:=EP_decode(data,begin.next);
 if end.kind!=4 || !ep_identity(expected,end,data) || end.next!=data.count || process.returncode!=0 {return EV_INFRASTRUCTURE;}
 return EV_PASSED;
}
EP_outcome :: (text:string)->u32 #export_c {
 if text=="passed" {return EV_PASSED;}if text=="counterexample" {return EV_COUNTEREXAMPLE;}
 if text=="inconclusive" {return EV_INCONCLUSIVE;}if text=="infrastructure-error" {return EV_INFRASTRUCTURE;}
 if text=="not-checked" {return EV_NOT_CHECKED;}return 5;
}
ep_sha :: (text:string)->bool {
 if text.count!=64 {return false;}
 for i:0..<text.count {b:=text[i];if !((b>=48 && b<=57) || (b>=97 && b<=102)) {return false;}}
 return true;
}
ep_refuse :: (reason:u32)->EP_BaseResult {return EP_BaseResult.{outcome=EV_INFRASTRUCTURE,reason=reason};}
EP_baseline :: (base:EP_Base,sources:[]EP_Source,claims:[]EP_Claim,process:EP_Process,expected_input:string,expected_input_sha:string,expected_compiler_sha:string,expected_compiler_version:string,requested_steps:int)->EP_BaseResult #export_c {
 t:=ep_transport(process);if t!=EV_PASSED {return EP_BaseResult.{outcome=t,reason=1};}
 if base.shape!=255 || base.schema!="coax.evidence.v1" || base.command!="test" {return ep_refuse(2);}
 if !ep_text(expected_input.count) || !ep_text(expected_compiler_version.count) ||
  !ep_sha(expected_input_sha) || !ep_sha(expected_compiler_sha) || base.input!=expected_input || base.compiler_sha!=expected_compiler_sha || base.compiler_version!=expected_compiler_version {return ep_refuse(3);}
 if base.target!="coax-evaluator" || base.arithmetic!="checked" || base.runtime_arithmetic!="checked" || base.library!=1 || !base.only_null || base.listing!=0 || base.root_only!=0 {return ep_refuse(4);}
 if !EP_steps(requested_steps) || base.check_steps!=requested_steps || base.slots!=cast(int)CB_test_slot_limit() || base.containers!=cast(int)CB_test_container_limit() || base.run_steps!=cast(int)CB_default_steps() {return ep_refuse(5);}
 if !ep_sources_valid(sources) || !ep_claim_count(claims.count) {return ep_refuse(6);}
 root:bool=false;for i:0..<sources.count {
  if sources[i].path==expected_input {if sources[i].sha!=expected_input_sha {return ep_refuse(6);}root=true;}
 }
 if !root || base.exit_status!=process.returncode || (process.returncode!=0 && process.returncode!=1) {return ep_refuse(7);}
 if base.front_end=="failed" {
  if claims.count!=0 || base.verdict!="not-checked" || process.returncode!=1 {return ep_refuse(8);}
  return EP_BaseResult.{valid=true,outcome=EV_NOT_CHECKED};
 }
 if base.front_end!="ok" {return ep_refuse(8);}
 bits:u32=0;authored:bool=false;authority:bool=false;
 for i:0..<claims.count {
  c:=claims[i];outcome:=EP_outcome(c.outcome);
  if outcome>EV_NOT_CHECKED || !c.name_string || !ep_bytes(c.name.count) {return ep_refuse(9);}
  if c.kind=="#authority" {
   if authority || !c.at_null || c.source.count!=0 || c.line!= -1 || c.column!= -1 || c.cases!=0 || c.steps!=0 {return ep_refuse(9);}authority=true;
  }else {
   if (c.kind!="#test" && c.kind!="#forall") || c.at_null || !ep_location(c.line) || !ep_location(c.column) || c.cases<0 || c.steps<0 || (outcome==EV_PASSED && c.cases<1) {return ep_refuse(9);}
   found:bool=false;for j:0..<sources.count {if sources[j].path==c.source {found=true;}}
   if !found {return ep_refuse(9);}
   authored=true;
  }
  bits=EV_add(bits,outcome);
 }
 verdict:=EV_verdict(bits);
 if EP_outcome(base.verdict)!=verdict || ((verdict==EV_PASSED)!=(process.returncode==0)) {return ep_refuse(10);}
 if verdict==EV_PASSED && !authored {return EP_BaseResult.{outcome=EV_NOT_CHECKED,reason=11};}
 return EP_BaseResult.{valid=true,outcome=verdict};
}
EP_plan :: (claims:[]EP_Claim,only:string,has_only:bool,mask:[]u8)->EP_Plan #export_c {
 if !ep_claim_count(claims.count) || mask.count!=claims.count || !ep_bytes(only.count) || (!has_only && only.count!=0) {return EP_Plan.{outcome=EV_INFRASTRUCTURE};}
 for i:0..<mask.count {mask[i]=0;}
 count:int=0;quantified:bool=false;
 for i:0..<claims.count {
  c:=claims[i];if c.kind=="#authority" {continue;}
  if c.kind!="#test" && c.kind!="#forall" {return EP_Plan.{outcome=EV_INFRASTRUCTURE};}
  if !c.name_string || !ep_bytes(c.name.count) {return EP_Plan.{outcome=EV_INFRASTRUCTURE};}
  if !has_only || nc_contains(c.name,only) {
   count+=1;if c.kind=="#forall" {mask[i]=2;quantified=true;}else {mask[i]=1;}
  }
 }
 if count==0 || quantified {return EP_Plan.{outcome=EV_NOT_CHECKED,count=count};}
 return EP_Plan.{outcome=EV_PASSED,count=count};
}
ep_masks :: (claims:[]EP_Claim,mask:[]u8)->bool {
 if !ep_claim_count(claims.count) || claims.count!=mask.count {return false;}
 for i:0..<claims.count {
  c:=claims[i];if c.kind=="#authority" {if mask[i]!=0 {return false;}}
  else if c.kind=="#test" {if mask[i]!=0 && mask[i]!=1 {return false;}}
  else if c.kind=="#forall" {if mask[i]!=0 && mask[i]!=2 {return false;}}
  else {return false;}
 }
 return true;
}
EP_selected :: (claims:[]EP_Claim,mask:[]u8,ordinal:int)->EP_Identity #export_c {
 if !ep_masks(claims,mask) || !EP_select(EP_CHECK_LIMIT,ordinal) {return EP_Identity.{ordinal= -1};}
 declaration:int=0;selected:int=0;
 for i:0..<claims.count {
  c:=claims[i];if c.kind=="#authority" {continue;}
  if mask[i]==1 {
   if selected==ordinal {return EP_Identity.{ordinal=ordinal,declaration_index=declaration,line=c.line,column=c.column,name=c.name,source=c.source};}
   selected+=1;
  }
  declaration+=1;
 }
 return EP_Identity.{ordinal= -1};
}
ep_bytes :: (count:int)->bool {return count>=0 && count<=EP_TEXT_LIMIT;}
ep_text :: (count:int)->bool {return count>0 && count<=EP_TEXT_LIMIT;}
ep_location :: (value:int)->bool {return value>0 && value<=4294967295;}
ep_claim_count :: (count:int)->bool {return count<=EP_CHECK_LIMIT+1;}

ep_test_identity :: ()->EP_Identity {return EP_Identity.{ordinal=0,declaration_index=7,line=11,column=3,name="alpha\0omegaλ",source="/a.coax"};}
ep_test_process :: ()->EP_Process {return EP_Process.{launched=true,finished=true,stdout_eof=true,stderr_eof=true};}
ep_test_source :: ()->EP_Source {return EP_Source.{path="/a.coax",observed_path="/a.coax",sha=EP_TEST_SHA,observed_sha=EP_TEST_SHA};}
ep_test_claim :: ()->EP_Claim {return EP_Claim.{kind="#test",name="alpha\0omegaλ",source="/a.coax",outcome="passed",name_string=true,line=11,column=3,cases=1,steps=8};}
ep_test_base :: ()->EP_Base {return EP_Base.{shape=255,schema="coax.evidence.v1",command="test",input="/a.coax",compiler_sha=EP_TEST_COMPILER,compiler_version="test compiler",target="coax-evaluator",arithmetic="checked",runtime_arithmetic="checked",front_end="ok",verdict="passed",library=1,only_null=true,check_steps=20000000,slots=33554432,containers=2097152,run_steps=100000};}
