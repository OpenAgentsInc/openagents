 r:=EP_baseline(b,ss[..],cs[0..<0],p,"/a.coax",EP_TEST_SHA,EP_TEST_COMPILER,"test compiler",20000000);#assert r.valid && r.outcome==EV_NOT_CHECKED;
 b=ep_test_base();p=ep_test_process();cs[0].kind="#authority";cs[0].at_null=true;cs[0].source="";cs[0].line=-1;cs[0].column=-1;cs[0].cases=0;cs[0].steps=0;
 r=EP_baseline(b,ss[..],cs[0..<1],p,"/a.coax",EP_TEST_SHA,EP_TEST_COMPILER,"test compiler",20000000);#assert !r.valid && r.outcome==EV_NOT_CHECKED && r.reason==11;
 cs[1]=cs[0];r=EP_baseline(b,ss[..],cs[..],p,"/a.coax",EP_TEST_SHA,EP_TEST_COMPILER,"test compiler",20000000);#assert !r.valid && r.reason==9;
 p.timeout=true;r=EP_baseline(b,ss[..],cs[..],p,"/a.coax",EP_TEST_SHA,EP_TEST_COMPILER,"test compiler",20000000);#assert r.reason==1;
}
