 bytes:[64]u8;for i:0..<bytes.count {bytes[i]=97;}bytes[0]=cast(u8)value;
 #assert ep_sha(cast(string)bytes[..])==((value>=48 && value<=57) || (value>=97 && value<=102));
 #assert !ep_sha(cast(string)bytes[0..<63]);
}
