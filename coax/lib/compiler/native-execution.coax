 #assert !EP_sources_match(a[..],a[..]) && !EP_sources_match(a[0..<0],a[0..<0]);
 a[0].path="/";a[0].observed_path="/";#assert EP_sources_match(a[0..<1],a[0..<1]);
 a[0].path="";a[0].observed_path="";#assert !EP_sources_match(a[0..<1],a[0..<1]);
}
