#test "selection validates masks before returning any borrowed physical identity" {
 cs:=[3]EP_Claim.[ep_test_claim(),ep_test_claim(),ep_test_claim()];mask:=[3]u8.[0,2,1];cs[1].kind="#forall";
 a:=EP_selected(cs[..],mask[..],0);#assert a.ordinal==0 && a.declaration_index==2;
 #assert EP_selected(cs[..],mask[..],4096).ordinal== -1 && EP_selected(cs[..],mask[0..<2],0).ordinal== -1;
 mask[0]=2;#assert EP_selected(cs[..],mask[..],0).ordinal== -1;mask[0]=0;
 mask[1]=1;#assert EP_selected(cs[..],mask[..],0).ordinal== -1;mask[1]=3;#assert EP_selected(cs[..],mask[..],0).ordinal== -1;mask[1]=0;
 cs[0].kind="#authority";mask[0]=1;#assert EP_selected(cs[..],mask[..],0).ordinal== -1;
 mask[0]=0;cs[0].kind="other";#assert EP_selected(cs[..],mask[..],0).ordinal== -1;
 cs[0]=ep_test_claim();mask[0]=3;#assert EP_selected(cs[..],mask[..],0).ordinal== -1;
 mask[0]=0;mask[1]=0;cs[1].kind="#test";cs[1].name_string=false;
 q:=EP_plan(cs[..],"",false,mask[..]);#assert q.outcome==EV_INFRASTRUCTURE;
 cs[0].kind="other";q=EP_plan(cs[..],"",false,mask[..]);#assert q.outcome==EV_INFRASTRUCTURE;
 cs[0]=ep_test_claim();cs[1]=ep_test_claim();q=EP_plan(cs[..],"x",false,mask[..]);#assert q.outcome==EV_INFRASTRUCTURE;
 cs[0].kind="#authority";mask[0]=8;mask[1]=8;mask[2]=8;q=EP_plan(cs[..],"missing",true,mask[..]);#assert q.outcome==EV_NOT_CHECKED && mask[0]==0;
}

