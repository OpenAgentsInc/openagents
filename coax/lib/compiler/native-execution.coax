 cat[28]=3;#assert EP_metadata(ids[..],cat[..],p)==EV_INFRASTRUCTURE;
 wire[8]=2;#assert EP_execution(id,wire[..],p)==EV_INFRASTRUCTURE;
 wire=EP_TEST_EXECUTION;wire[68]=3;#assert EP_execution(id,wire[..],p)==EV_INFRASTRUCTURE;
 extra:[121]u8;for i:0..<120 {extra[i]=EP_TEST_EXECUTION[i];}
