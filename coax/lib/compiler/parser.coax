#test "check labels trim only spaces and newlines within their span" {
  #assert PS_trim_name("",0,0)=="" && PS_trim_name("xx",1,1)=="";
  #assert PS_trim_name("x \n{}",0,3)=="x" && PS_trim_name("x \n{}",1,3)=="";
  #assert PS_trim_name("x\n",0,2)=="x" && PS_trim_name("x\t",0,2)=="x\t";
  #assert PS_trim_name("x \n",0,1)=="x";
}
#test "recursive entries refuse over-budget calls without changing their location" {
  tokens:=[2] PS_Token.[PS_Token.{kind=1,loc=PS_Loc.{line=9}},PS_Token.{loc=PS_Loc.{line=10}}];nodes:[8] PS_Node;state:[1] PS_State;message:[128] u8;
  state[0]=PS_State.{depth=128};#assert PS_type(tokens[..],nodes[..],state[..],message[..])==0 && state[0].loc.line==9;
  state[0]=PS_State.{depth=128};#assert PS_expr(tokens[..],nodes[..],state[..],message[..],1)==0 && state[0].loc.line==9;
  state[0]=PS_State.{depth=128};#assert PS_unary(tokens[..],nodes[..],state[..],message[..])==0 && state[0].loc.line==9;
  state[0]=PS_State.{depth=128};#assert PS_block(tokens[..],nodes[..],state[..],message[..])==0 && state[0].loc.line==9;
  state[0]=PS_State.{depth=128};#assert PS_if(tokens[..],nodes[..],state[..],message[..])==0 && state[0].loc.line==9;
}

