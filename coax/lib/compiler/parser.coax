    PS_Token.{kind=3,text="2",raw_count=1,loc=PS_Loc.{line=1,column=13,offset=12},value=2},
    PS_Token.{kind=9,text=")",raw_count=1,loc=PS_Loc.{line=1,column=14,offset=13}},
    PS_Token.{kind=13,text="]",raw_count=1,loc=PS_Loc.{line=1,column=15,offset=14}},
    PS_Token.{kind=1,text="u8",raw_count=2,loc=PS_Loc.{line=1,column=17,offset=16}},
    PS_Token.{kind=9,text=")",raw_count=1,loc=PS_Loc.{line=1,column=19,offset=18}},
    PS_Token.{kind=19,text="->",raw_count=2,loc=PS_Loc.{line=1,column=20,offset=19}},
    PS_Token.{kind=1,text="int",raw_count=3,loc=PS_Loc.{line=1,column=22,offset=21}},
    PS_Token.{kind=10,text="{",raw_count=1,loc=PS_Loc.{line=1,column=26,offset=25}},
    PS_Token.{kind=2,text="return",raw_count=6,loc=PS_Loc.{line=1,column=27,offset=26}},
    PS_Token.{kind=3,text="0",raw_count=1,loc=PS_Loc.{line=1,column=34,offset=33}},
    PS_Token.{kind=15,text=";",raw_count=1,loc=PS_Loc.{line=1,column=35,offset=34}},
    PS_Token.{kind=11,text="}",raw_count=1,loc=PS_Loc.{line=1,column=36,offset=35}},
