#test "first diagnostic 0" {
  tokens:=[6] PS_Token.[
    PS_Token.{kind=1,text="x",raw_count=1,loc=PS_Loc.{line=1,column=1,offset=0}},
    PS_Token.{kind=17,text="::",raw_count=2,loc=PS_Loc.{line=1,column=3,offset=2}},
    PS_Token.{kind=6,text="foo",raw_count=3,loc=PS_Loc.{line=1,column=6,offset=5}},
    PS_Token.{kind=3,text="1",raw_count=1,loc=PS_Loc.{line=1,column=11,offset=10},value=1},
    PS_Token.{kind=15,text=";",raw_count=1,loc=PS_Loc.{line=1,column=12,offset=11}},
    PS_Token.{kind=0,text="",raw_count=0,loc=PS_Loc.{line=1,column=13,offset=12}}];
  nodes:[128] PS_Node;state:[1] PS_State;message:[1024] u8;
  r:=PS_parse("x :: #foo 1;",tokens[..],nodes[..],state[..],message[..]);
  #assert !r.ok && state[0].code=="E0205" && cast(string)message[0..<state[0].length]=="expected an expression, found directive" && state[0].loc.column==6;
}

