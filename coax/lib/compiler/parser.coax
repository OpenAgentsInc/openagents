#forall "import storage capacity" n:1..<64 {
  #assert PS_caps(n,0).imports==n/5;
}
#test "import counts, storage and failure ordering" {
  t:[46] PS_Token;out:[9] PS_Import;
  for i:0..<9 {
    at:=i*5;t[at]=PS_Token.{kind=6,text="import_proto",loc=PS_Loc.{line=i+1}};
    t[at+1]=PS_Token.{kind=5,text="x.pb"};t[at+2]=PS_Token.{kind=1,text="as"};
    names:=[9] string.["A","B","C","D","E","F","G","H","I"];
    t[at+3]=PS_Token.{kind=1,text=names[i]};t[at+4]=PS_Token.{kind=15,loc=PS_Loc.{offset=i*32+31}};
  }
  r:=PS_imports(t[0..<40],out[..],false);#assert r.code=="" && r.count==8 && out[7].end==256 && out[7].loc.line==8;
  r=PS_imports(t[..],out[..],false);#assert r.code=="E0502" && r.loc.line==1 && r.message=="at most eight descriptor imports per source";
  t[41].text="x\0.pb";r=PS_imports(t[..],out[..],false);#assert r.code=="E0501" && r.loc.line==9;
  t[41].text="x.pb";r=PS_imports(t[0..<5],out[0..<0],false);#assert r.code=="E0502" && r.message=="proto request storage budget exceeded";
}
#test "a closed block restores top-level proto admission" {
  t:=[8] PS_Token.[PS_Token.{kind=10},PS_Token.{kind=11},PS_Token.{kind=6,text="import_proto"},PS_Token.{kind=5,text="x.pb"},PS_Token.{kind=1,text="as"},PS_Token.{kind=1,text="X"},PS_Token.{kind=15},PS_Token.{}];out:[1] PS_Import;
  r:=PS_imports(t[..],out[..],false);#assert r.code=="" && r.count==1;
}
#forall "every short proto directive is bounded" end:0..<6 {
  t:=[5] PS_Token.[PS_Token.{kind=6,text="import_proto"},PS_Token.{kind=5,text="x.pb"},PS_Token.{kind=1,text="as"},PS_Token.{kind=1,text="X"},PS_Token.{kind=15}];out:[1] PS_Import;
  r:=PS_imports(t[0..<end],out[..],false);
  if end==0 {#assert r.code=="" && r.count==0;}else if end==5 {#assert r.code=="" && r.count==1;}else {#assert r.code=="E0501";}
}

