  tokens:=[33] PS_Token.[
    PS_Token.{kind=2,text="ifx",raw_count=3,loc=PS_Loc.{line=1,column=1,offset=0}},
    PS_Token.{kind=2,text="true",raw_count=4,loc=PS_Loc.{line=1,column=5,offset=4}},
