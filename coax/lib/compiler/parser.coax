  nodes:[128] PS_Node;state:[1] PS_State;message:[1024] u8;
  r:=PS_parse("f :: (a:[(1+2)] u8)->int {return 0;}",tokens[..],nodes[..],state[..],message[..]);#assert r.ok;
  p:=nodes[nodes[r.root].head];#assert p.kind==PS_Tag.decl_proc && nodes[nodes[p.head].a].kind==PS_Tag.type_array;
}

