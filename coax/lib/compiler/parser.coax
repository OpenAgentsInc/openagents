#test "conditional field nesting errors retain the directive location" {
 tokens:=[5]PS_Token.[PS_Token.{kind=6,text="if",loc=PS_Loc.{line=9,column=3,offset=17}},PS_Token.{kind=1,text="BUILD_DEBUG"},PS_Token.{kind=10},PS_Token.{kind=11},PS_Token.{}];
 nodes:[8]PS_Node;state:=[1]PS_State.[PS_State.{depth=128}];out:[128]u8;
 PS_profile_fields(tokens[..],nodes[..],state[..],out[..],0);
 #assert state[0].code=="E0221" && state[0].loc.line==9 && state[0].loc.column==3 && state[0].loc.offset==17 && state[0].depth==128;
}

