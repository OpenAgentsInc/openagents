    PS_Token.{kind=16,text=":",raw_count=1,loc=PS_Loc.{line=1,column=8,offset=7}},
    PS_Token.{kind=12,text="[",raw_count=1,loc=PS_Loc.{line=1,column=9,offset=8}},
    PS_Token.{kind=8,text="(",raw_count=1,loc=PS_Loc.{line=1,column=10,offset=9}},
    PS_Token.{kind=3,text="1",raw_count=1,loc=PS_Loc.{line=1,column=11,offset=10},value=1},
