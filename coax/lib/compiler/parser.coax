 all:[11]PS_Token;for i:0..<10 {all[i]=tokens[i];}nodes:[64]PS_Node;state:[1]PS_State;message:[256]u8;r:=PS_expression(all[..],nodes[..],state[..],message[..]);
 #assert state[0].code=="" && cast(u32)nodes[r].kind==38 && cast(u32)nodes[nodes[r].b].kind==38;
 lhs:=nodes[r].a;#assert nodes[lhs].kind==PS_Tag.expr_binary && nodes[lhs].op==51 && cast(u32)nodes[nodes[lhs].a].kind==37 && nodes[nodes[nodes[lhs].a].a].name=="f";
 #assert cast(u32)nodes[nodes[nodes[r].b].b].kind==35 && state[0].pos==10 && state[0].depth==0;
}
