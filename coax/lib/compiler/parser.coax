  tokens:=[7] PS_Token.[
    PS_Token.{kind=12,text="[",raw_count=1,loc=PS_Loc.{line=1,column=1,offset=0}},
    PS_Token.{kind=3,text="2",raw_count=1,loc=PS_Loc.{line=1,column=2,offset=1},value=2},
    PS_Token.{kind=13,text="]",raw_count=1,loc=PS_Loc.{line=1,column=3,offset=2}},
