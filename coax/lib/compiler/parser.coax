    PS_Token.{kind=0,text="",raw_count=0,loc=PS_Loc.{line=1,column=10,offset=9}}];
  input:[7] PS_Token;for v,j:tokens {input[j]=v;}input[end]=PS_Token.{loc=tokens[end].loc};
  nodes:[512] PS_Node;state:[1] PS_State;message:[4096] u8;
