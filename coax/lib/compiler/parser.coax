#test "grammar: procedure" {
  tokens:=[79] PS_Token.[
    PS_Token.{kind=1,text="f",raw_count=1,loc=PS_Loc.{line=1,column=1,offset=0}},
    PS_Token.{kind=17,text="::",raw_count=2,loc=PS_Loc.{line=1,column=3,offset=2}},
    PS_Token.{kind=8,text="(",raw_count=1,loc=PS_Loc.{line=1,column=6,offset=5}},
    PS_Token.{kind=1,text="x",raw_count=1,loc=PS_Loc.{line=1,column=7,offset=6}},
    PS_Token.{kind=16,text=":",raw_count=1,loc=PS_Loc.{line=1,column=8,offset=7}},
    PS_Token.{kind=1,text="int",raw_count=3,loc=PS_Loc.{line=1,column=9,offset=8}},
    PS_Token.{kind=14,text=",",raw_count=1,loc=PS_Loc.{line=1,column=12,offset=11}},
    PS_Token.{kind=1,text="y",raw_count=1,loc=PS_Loc.{line=1,column=14,offset=13}},
    PS_Token.{kind=16,text=":",raw_count=1,loc=PS_Loc.{line=1,column=15,offset=14}},
    PS_Token.{kind=12,text="[",raw_count=1,loc=PS_Loc.{line=1,column=16,offset=15}},
    PS_Token.{kind=13,text="]",raw_count=1,loc=PS_Loc.{line=1,column=17,offset=16}},
    PS_Token.{kind=1,text="u8",raw_count=2,loc=PS_Loc.{line=1,column=19,offset=18}},
    PS_Token.{kind=14,text=",",raw_count=1,loc=PS_Loc.{line=1,column=21,offset=20}},
    PS_Token.{kind=9,text=")",raw_count=1,loc=PS_Loc.{line=1,column=22,offset=21}},
