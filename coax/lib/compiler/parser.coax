 PS_Token.{kind=1,text="BUILD_DEBUG",value=0,loc=PS_Loc.{line=1,column=99,offset=98},raw_count=11},
 PS_Token.{kind=10,text="{",value=0,loc=PS_Loc.{line=1,column=111,offset=110},raw_count=1},
 PS_Token.{kind=1,text="inspect",value=0,loc=PS_Loc.{line=1,column=113,offset=112},raw_count=7},
 PS_Token.{kind=8,text="(",value=0,loc=PS_Loc.{line=1,column=120,offset=119},raw_count=1},
 PS_Token.{kind=9,text=")",value=0,loc=PS_Loc.{line=1,column=121,offset=120},raw_count=1},
 PS_Token.{kind=15,text=";",value=0,loc=PS_Loc.{line=1,column=122,offset=121},raw_count=1},
 PS_Token.{kind=11,text="}",value=0,loc=PS_Loc.{line=1,column=124,offset=123},raw_count=1},
 PS_Token.{kind=2,text="else",value=0,loc=PS_Loc.{line=1,column=126,offset=125},raw_count=4},
 PS_Token.{kind=10,text="{",value=0,loc=PS_Loc.{line=1,column=131,offset=130},raw_count=1},
 PS_Token.{kind=1,text="ship",value=0,loc=PS_Loc.{line=1,column=133,offset=132},raw_count=4},
 PS_Token.{kind=8,text="(",value=0,loc=PS_Loc.{line=1,column=137,offset=136},raw_count=1},
 PS_Token.{kind=9,text=")",value=0,loc=PS_Loc.{line=1,column=138,offset=137},raw_count=1},
 PS_Token.{kind=15,text=";",value=0,loc=PS_Loc.{line=1,column=139,offset=138},raw_count=1},
 PS_Token.{kind=11,text="}",value=0,loc=PS_Loc.{line=1,column=141,offset=140},raw_count=1},
 PS_Token.{kind=11,text="}",value=0,loc=PS_Loc.{line=1,column=143,offset=142},raw_count=1},
 PS_Token.{kind=0,text="",value=0,loc=PS_Loc.{line=1,column=144,offset=143},raw_count=0}
 ];
 {nodes:[256]PS_Node;state:[1]PS_State;out:[512]u8;r:=PS_parse("",tokens[..],nodes[..],state[..],out[..]);#assert r.ok && state[0].development;
  st:=nodes[r.root].head;#assert nodes[nodes[nodes[st].head].next].name=="magnitude";
 }

 for mode:0..<2 {
  nodes:[256]PS_Node;for i:1..<256 {nodes[i].name="spare";}state:[1]PS_State;out:[512]u8;
  r:=PS_parse_build("",tokens[..],nodes[..],state[..],out[..],mode==1);
  #assert r.ok && state[0].development==(mode==1) && state[0].depth==0;
  st:=nodes[r.root].head;first:=nodes[st].head;second:=nodes[first].next;last:=nodes[second].next;
  #assert nodes[first].name=="a" && nodes[second].name==ifx mode==1 then "magnitude" else "packed";
  #assert nodes[nodes[second].a].name==ifx mode==1 then "u64" else "u32";
  #assert nodes[last].name=="z" && nodes[last].next==0;
  proc:=nodes[st].next;block:=nodes[nodes[proc].b].head;
  #assert nodes[block].kind==PS_Tag.stmt_block && nodes[block].next==0;
  expr:=nodes[nodes[block].head].a;#assert nodes[expr].kind==PS_Tag.expr_call;
  #assert nodes[expr].name==ifx mode==1 then "inspect" else "ship";
  // Inactive nodes and private holders must not request helper declarations.
  // Every remaining non-null node belongs to the selected file tree.
  live:[256]bool;live[r.root]=true;
  for pass:0..<16 {for i:1..<state[0].used+1 {if live[i] {
   for child:[6]int.[nodes[i].a,nodes[i].b,nodes[i].c,nodes[i].d,nodes[i].head,nodes[i].next] {if child!=0 {live[child]=true;}}
  }}}
  for i:1..<state[0].used+1 {#assert live[i] || nodes[i].kind==PS_Tag.invalid;}
  #assert nodes[state[0].used+1].name=="spare";

 }
}

#test "profile blocks without else and nested choices retain only active fields" {
 tokens:=[41]PS_Token.[
 PS_Token.{kind=1,text="S",value=0,loc=PS_Loc.{line=1,column=1,offset=0},raw_count=1},
