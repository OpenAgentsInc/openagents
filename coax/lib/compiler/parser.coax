    PS_Token.{kind=11,text="}",raw_count=1,loc=PS_Loc.{line=1,column=19,offset=18}},
    PS_Token.{kind=0,text="",raw_count=0,loc=PS_Loc.{line=1,column=20,offset=19}}];
  nodes:[128] PS_Node;state:[1] PS_State;message:[1024] u8;
  r:=PS_parse("f :: () {continue }",tokens[..],nodes[..],state[..],message[..]);
  #assert !r.ok && state[0].code=="E0201" && cast(string)message[0..<state[0].length]=="expected ';' after continue, found '}'" && state[0].loc.column==18;
}

