 PS_Token.{kind=2,text="return",value=0,loc=PS_Loc.{line=1,column=123,offset=122},raw_count=6},
 PS_Token.{kind=15,text=";",value=0,loc=PS_Loc.{line=1,column=129,offset=128},raw_count=1},
 PS_Token.{kind=11,text="}",value=0,loc=PS_Loc.{line=1,column=131,offset=130},raw_count=1},
 PS_Token.{kind=0,text="",value=0,loc=PS_Loc.{line=1,column=132,offset=131},raw_count=0}
 ];
 for mode:0..<2 {
  nodes:[256]PS_Node;state:[1]PS_State;out:[512]u8;
  r:=PS_parse_build("",tokens[..],nodes[..],state[..],out[..],mode==1);#assert r.ok;
  st:=nodes[r.root].head;at:=nodes[nodes[st].head].next;
  if mode==1 {#assert nodes[at].name=="debug";at=nodes[at].next;}
  #assert nodes[at].name=="z" && nodes[at].next==0;
  proc:=nodes[st].next;block:=nodes[nodes[proc].b].head;
  if mode==1 {#assert nodes[nodes[block].head].kind==PS_Tag.stmt_assert_;}else {#assert nodes[block].head==0;}
  #assert nodes[nodes[block].next].kind==PS_Tag.stmt_ret;
 }
}

