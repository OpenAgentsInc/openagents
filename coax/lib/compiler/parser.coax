#test "quantity annotations preserve all six signed literal metadata fields" {
  tokens:[27]PS_Token;tokens[0]=PS_Token.{kind=7,text="unit"};tokens[1].kind=8;
  names:=[6]string.["mass","length","time","angle","numerator","denominator"];values:=[6]u64.[0,1,0,0,1,2];
  for i:0..<6 {at:=2+4*i;tokens[at]=PS_Token.{kind=1,text=names[i]};tokens[at+1].kind=23;tokens[at+2]=PS_Token.{kind=3,value=values[i]};if i<5 {tokens[at+3].kind=14;}}
  tokens[25].kind=9;n:[4]PS_Node;state:=[1]PS_State.[PS_State.{}];message:[128]u8;PS_quantity(tokens[..],n[..],state[..],message[..],1);
  #assert state[0].code=="" && n[1].quantity==1;for i:0..<6 {#assert n[1].unit[i]==cast(int)values[i];}
  tokens[0].text="builtin_quantity";state[0]=PS_State.{};PS_quantity(tokens[..],n[..],state[..],message[..],2);#assert state[0].code=="" && n[2].quantity==2;
}

#forall "physical annotation parsing retains every signed field in arbitrary starting order" negative:bool,shift:0..<6 {
  tokens:[40]PS_Token;names:=[6]string.["mass","length","time","angle","numerator","denominator"];
  tokens[0]=PS_Token.{kind=7,text="unit"};tokens[1].kind=8;cursor:=2;
  for i:0..<6 {field:=(i+shift)%6;tokens[cursor]=PS_Token.{kind=1,text=names[field]};cursor+=1;tokens[cursor].kind=23;cursor+=1;
    if negative {tokens[cursor].kind=35;cursor+=1;}tokens[cursor]=PS_Token.{kind=3,value=cast(u64)(field+1)};cursor+=1;
    if i!=5 {tokens[cursor].kind=14;cursor+=1;}
  }
  tokens[cursor].kind=9;cursor+=1;nodes:[3]PS_Node;state:[1]PS_State;message:[256]u8;
  PS_quantity(tokens[0..<cursor+1],nodes[..],state[..],message[..],1);
  #assert state[0].code=="" && state[0].pos==cursor && nodes[1].quantity==1;
  for field:0..<6 {want:=field+1;if negative {want= -want;}#assert nodes[1].unit[field]==want;}
}
#forall "physical annotation literal bounds include positive and negative boundary values" negative:bool {
  tokens:[33]PS_Token;names:=[6]string.["mass","length","time","angle","numerator","denominator"];
  tokens[0]=PS_Token.{kind=7,text="unit"};tokens[1].kind=8;cursor:=2;
  for i:0..<6 {tokens[cursor]=PS_Token.{kind=1,text=names[i]};cursor+=1;tokens[cursor].kind=23;cursor+=1;
    if negative {tokens[cursor].kind=35;cursor+=1;}tokens[cursor]=PS_Token.{kind=3,value=1048576};cursor+=1;
    if i!=5 {tokens[cursor].kind=14;cursor+=1;}
  }
  tokens[cursor].kind=9;cursor+=1;nodes:[3]PS_Node;state:[1]PS_State;message:[256]u8;
  PS_quantity(tokens[0..<cursor+1],nodes[..],state[..],message[..],1);
  #assert state[0].code=="";for field:0..<6 {#assert nodes[1].unit[field]==(ifx negative then -1048576 else 1048576);}
}
#forall "physical annotation errors retain the first diagnostic and source token" mode:0..<13 {
  tokens:[27]PS_Token;names:=[6]string.["mass","length","time","angle","numerator","denominator"];
  tokens[0]=PS_Token.{kind=7,text="unit"};tokens[1].kind=8;
  for i:0..<6 {tokens[2+4*i]=PS_Token.{kind=1,text=names[i]};tokens[3+4*i].kind=23;tokens[4+4*i]=PS_Token.{kind=3,value=cast(u64)(i+1)};if i!=5 {tokens[5+4*i].kind=14;}}
  tokens[25].kind=9;for i:0..<27 {tokens[i].loc=PS_Loc.{line=11,column=i+1,offset=100+i};}
  end:=27;at:=0;want:="E0820";text:="unsupported physical annotation";
  if mode==0 {tokens[0].text="unknown";}
  if mode==1 {tokens[2].text="distance";at=2;text="unknown unit metadata name";}
  if mode==2 {tokens[6].text="mass";at=6;text="unit metadata is repeated";}
  if mode==3 {tokens[21].kind=9;tokens[22].kind=0;end=23;text="invalid or incomplete unit metadata";}
  if mode==4 {tokens[2].kind=3;at=2;want="E0208";text="expected a unit metadata name, found integer";}
  if mode==5 {tokens[4].kind=4;at=4;text="unit metadata requires a bounded integer literal";}
  if mode==6 {tokens[4].kind=5;at=4;text="unit metadata requires a bounded integer literal";}
  if mode==7 {tokens[4].kind=1;tokens[4].text="bad";at=4;text="unit metadata requires a bounded integer literal";}
  if mode==8 {tokens[4].value=1048577;at=4;text="unit metadata requires a bounded integer literal";}
  if mode==9 {tokens[1].kind=23;at=1;want="E0201";text="expected '(' after @unit, found '='";}
  if mode==10 {tokens[3].kind=14;at=3;want="E0201";text="expected '=' after the unit metadata name, found ','";}
  if mode==11 {tokens[25].kind=10;at=25;want="E0201";text="expected ')' after the unit metadata, found '{'";}
  if mode==12 {tokens[4].kind=35;at=5;text="unit metadata requires a bounded integer literal";}
  nodes:[3]PS_Node;state:[1]PS_State;message:[256]u8;PS_quantity(tokens[0..<end],nodes[..],state[..],message[..],1);
  #assert state[0].code==want && state[0].loc.line==11 && state[0].loc.column==at+1 && state[0].loc.offset==100+at;
  #assert cast(string)message[0..<state[0].length]==text;
}
#forall "every unit metadata name can be recognized as repeated" repeated:0..<6 {
  tokens:[31]PS_Token;names:=[6]string.["mass","length","time","angle","numerator","denominator"];
  tokens[0]=PS_Token.{kind=7,text="unit"};tokens[1].kind=8;
  for i:0..<7 {field:=(i+repeated)%6;tokens[2+4*i]=PS_Token.{kind=1,text=names[field]};tokens[3+4*i].kind=23;tokens[4+4*i]=PS_Token.{kind=3,value=1};if i!=6 {tokens[5+4*i].kind=14;}}
  tokens[29].kind=9;nodes:[3]PS_Node;state:[1]PS_State;message:[256]u8;PS_quantity(tokens[..],nodes[..],state[..],message[..],1);
  #assert state[0].code=="E0820" && cast(string)message[0..<state[0].length]=="unit metadata is repeated";
}
#test "struct parsing routes generic builtin quantities and preserves ordinary fields" {
  tokens:[12]PS_Token;tokens[0]=PS_Token.{kind=2,text="struct"};tokens[1].kind=8;tokens[2]=PS_Token.{kind=53,text="T"};tokens[3].kind=9;
  tokens[4]=PS_Token.{kind=7,text="builtin_quantity"};tokens[5].kind=10;tokens[6]=PS_Token.{kind=1,text="value"};tokens[7].kind=16;tokens[8]=PS_Token.{kind=53,text="T"};tokens[9].kind=15;tokens[10].kind=11;
  nodes:[16]PS_Node;state:[1]PS_State;message:[256]u8;name:=PS_Token.{kind=1,text="Quantity",loc=PS_Loc.{line=3,column=2,offset=9}};
  id:=PS_struct(tokens[..],nodes[..],state[..],message[..],name);
  #assert state[0].code=="" && id==1 && state[0].pos==11 && nodes[id].kind==PS_Tag.decl_struct_ && nodes[id].name=="Quantity" && nodes[id].loc.line==3 && nodes[id].quantity==2;
  #assert nodes[nodes[id].d].name=="T" && nodes[nodes[id].d].kind==PS_Tag.type_param;
  field:=nodes[id].head;#assert field!=0 && nodes[field].name=="value" && nodes[nodes[field].a].kind==PS_Tag.type_param && nodes[nodes[field].a].name=="T";
  plain:[8]PS_Token;plain[0]=PS_Token.{kind=2,text="struct"};plain[1].kind=10;plain[2]=PS_Token.{kind=1,text="x"};plain[3].kind=16;plain[4]=PS_Token.{kind=1,text="f32"};plain[5].kind=15;plain[6].kind=11;
  state[0]=PS_State.{};id=PS_struct(plain[..],nodes[..],state[..],message[..],PS_Token.{text="Plain"});
  #assert state[0].code=="" && id==1 && state[0].pos==7 && nodes[id].quantity==0 && nodes[id].name=="Plain" && nodes[nodes[id].head].name=="x";
}
#test "struct parsing refuses directives and unknown physical annotations with original errors" {
  tokens:[5]PS_Token;tokens[0]=PS_Token.{kind=2,text="struct"};tokens[1]=PS_Token.{kind=6,text="packed",loc=PS_Loc.{line=7,column=11,offset=31}};tokens[2].kind=10;tokens[3].kind=11;
  nodes:[8]PS_Node;state:[1]PS_State;message:[256]u8;id:=PS_struct(tokens[..],nodes[..],state[..],message[..],PS_Token.{text="S"});
  #assert id==0 && state[0].code=="E0210" && state[0].loc.line==7 && state[0].loc.column==11 && cast(string)message[0..<state[0].length]=="#packed on structs is not supported by coax0 yet";
  tokens[1].kind=7;tokens[1].text="nonsense";state[0]=PS_State.{};id=PS_struct(tokens[..],nodes[..],state[..],message[..],PS_Token.{text="S"});
  #assert id==0 && state[0].code=="E0820" && state[0].loc.line==7 && state[0].loc.column==11 && cast(string)message[0..<state[0].length]=="unsupported physical annotation";
}

// Test-only token fixture: all four literal metadata words, with no lexer or
// checker dependency. The independently compiled lexer/native transport checks
// in tests/parser.py exercise the actual source spelling as a separate oracle.
PS_frame_test_tokens :: ()->[19]PS_Token {
 tokens:[19]PS_Token;tokens[0]=PS_Token.{kind=7,text="frame"};tokens[1].kind=8;
 names:=[4]string.["handedness","convention","continuity","min_precision"];
 words:=[4]string.["right","cartesian","continuous","f32"];tokens[17].kind=9;
 for i:0..<4 {at:=2+4*i;tokens[at]=PS_Token.{kind=1,text=names[i]};tokens[at+1].kind=23;tokens[at+2]=PS_Token.{kind=1,text=words[i]};if i!=3 {tokens[at+3].kind=14;}}
 for i:0..<19 {tokens[i].loc=PS_Loc.{line=17,column=i+1,offset=200+i};}return tokens;
}
#forall "frame literal vocabulary has exact raw transport values" field:0..<4 {
 words:=[9]string.["right","left","cartesian","body","optical","continuous","jumping","f32","f64"];
 values:=[9]int.[1,-1,1,2,3,1,2,32,64];owners:=[9]int.[0,0,1,1,1,2,2,3,3];
 for i:0..<9 {want:=0;if owners[i]==field {want=values[i];}#assert PS_frame_word(field,words[i])==want;}
 #assert PS_frame_word(field,"")==0 && PS_frame_word(field,"RIGHT")==0;
 #assert PS_frame_word(-1,"right")==0 && PS_frame_word(4,"f32")==0;
}
#forall "frame annotations retain every literal and arbitrary field order" hand:0..<2,convention:0..<3,continuity:0..<2,precision:0..<2,shift:0..<4 {
 tokens:=PS_frame_test_tokens();names:=[4]string.["handedness","convention","continuity","min_precision"];
 hands:=[2]string.["right","left"];conventions:=[3]string.["cartesian","body","optical"];continuities:=[2]string.["continuous","jumping"];precisions:=[2]string.["f32","f64"];
 words:=[4]string.[hands[hand],conventions[convention],continuities[continuity],precisions[precision]];
 for i:0..<4 {field:=(i+shift)%4;tokens[2+4*i].text=names[field];tokens[4+4*i].text=words[field];}
 nodes:[3]PS_Node;state:[1]PS_State;message:[256]u8;PS_frame(tokens[..],nodes[..],state[..],message[..],1);
 #assert state[0].code=="" && state[0].pos==18 && nodes[1].frame_decl && nodes[1].quantity==0;
 #assert nodes[1].frame[0]==(ifx hand==0 then 1 else -1) && nodes[1].frame[1]==convention+1 && nodes[1].frame[2]==continuity+1 && nodes[1].frame[3]==32+32*precision;
 for i:0..<6 {#assert nodes[1].unit[i]==0;}
}
#forall "frame metadata rejects each missing field without publishing metadata" missing:0..<4 {
 source:=PS_frame_test_tokens();tokens:[15]PS_Token;tokens[0]=source[0];tokens[1]=source[1];cursor:=2;
 for i:0..<4 {if i!=missing {tokens[cursor]=source[2+4*i];tokens[cursor+1]=source[3+4*i];tokens[cursor+2]=source[4+4*i];cursor+=3;if cursor!=13 {tokens[cursor].kind=14;cursor+=1;}}}
 tokens[13]=source[17];nodes:[3]PS_Node;state:[1]PS_State;message:[256]u8;PS_frame(tokens[..],nodes[..],state[..],message[..],1);
 #assert state[0].code=="E0832" && state[0].loc.offset==200 && !nodes[1].frame_decl;
 #assert cast(string)message[0..<state[0].length]=="incomplete frame metadata";
}
#forall "frame metadata rejects every duplicate name at its original token" duplicate:0..<4 {
 original:=PS_frame_test_tokens();tokens:[23]PS_Token;for i:0..<17 {tokens[i]=original[i];}tokens[17].kind=14;
 for i:0..<3 {tokens[18+i]=original[2+4*duplicate+i];}tokens[18].loc=PS_Loc.{line=19,column=4,offset=401};tokens[21].kind=9;
 nodes:[3]PS_Node;state:[1]PS_State;message:[256]u8;PS_frame(tokens[..],nodes[..],state[..],message[..],1);
 #assert state[0].code=="E0832" && state[0].loc.line==19 && state[0].loc.column==4 && state[0].loc.offset==401 && !nodes[1].frame_decl;
 #assert cast(string)message[0..<state[0].length]=="frame metadata is repeated";
}
#forall "frame metadata admits words rather than lookups or generic expressions" field:0..<4,mode:0..<8 {
 tokens:=PS_frame_test_tokens();at:=4+4*field;
 if mode==0 {tokens[at].kind=3;tokens[at].value=1;}
 if mode==1 {tokens[at].kind=5;tokens[at].text="right";}
 if mode==2 {tokens[at].kind=53;tokens[at].text="R";}
 if mode==3 {tokens[at].kind=4;tokens[at].floating=1;}
 if mode==4 {tokens[at].kind=2;tokens[at].text="true";}
 if mode==5 {tokens[at].text="Unknown";}
 if mode==6 {tokens[at].text="";}
 if mode==7 {tokens[at].kind=35;}
 nodes:[3]PS_Node;state:[1]PS_State;message:[256]u8;PS_frame(tokens[..],nodes[..],state[..],message[..],1);
 #assert state[0].code=="E0832" && state[0].loc.offset==200+at && !nodes[1].frame_decl;
}
#forall "frame metadata preserves first syntax diagnostics and refuses unknown names" mode:0..<6 {
 tokens:=PS_frame_test_tokens();at:=2;want:="E0832";
 if mode==0 {tokens[2].text="origin";}
 if mode==1 {tokens[1].kind=23;at=1;want="E0201";}
 if mode==2 {tokens[3].kind=14;at=3;want="E0201";}
 if mode==3 {tokens[17].kind=10;at=17;want="E0201";}
 if mode==4 {tokens[2].kind=3;want="E0208";}
 if mode==5 {tokens[5].kind=9;at=0;}
 nodes:[3]PS_Node;state:[1]PS_State;message:[256]u8;PS_frame(tokens[..],nodes[..],state[..],message[..],1);
 #assert state[0].code==want && state[0].loc.line==17 && state[0].loc.column==at+1 && state[0].loc.offset==200+at && !nodes[1].frame_decl;
}
#forall "physical annotation dispatch rejects a second frame unit or builtin role" mode:0..<5 {
 original:=PS_frame_test_tokens();tokens:[32]PS_Token;for i:0..<18 {tokens[i]=original[i];}
 at:=18;if mode>=3 {tokens[0].text="builtin_quantity";at=1;}
 tokens[at]=PS_Token.{kind=7,text="frame",loc=PS_Loc.{line=21,column=7,offset=511}};
 if mode==1 {tokens[at].text="unit";}if mode==2 {tokens[at].text="builtin_quantity";}if mode==4 {tokens[at].text="unit";}
 nodes:[3]PS_Node;state:[1]PS_State;message:[256]u8;PS_physical(tokens[..],nodes[..],state[..],message[..],1);
 #assert state[0].code=="E0832" && state[0].loc.offset==511 && cast(string)message[0..<state[0].length]=="a struct has at most one physical annotation";
}
#test "struct frame dispatch preserves literal metadata and ordinary empty syntax" {
 original:=PS_frame_test_tokens();tokens:[22]PS_Token;tokens[0]=PS_Token.{kind=2,text="struct"};for i:0..<18 {tokens[i+1]=original[i];}tokens[19].kind=10;tokens[20].kind=11;
 nodes:[8]PS_Node;state:[1]PS_State;message:[256]u8;id:=PS_struct(tokens[..],nodes[..],state[..],message[..],PS_Token.{text="World"});
 #assert id==1 && state[0].code=="" && state[0].pos==21 && nodes[id].frame_decl && nodes[id].frame[0]==1 && nodes[id].frame[1]==1 && nodes[id].frame[2]==1 && nodes[id].frame[3]==32;
 #assert nodes[id].d==0 && nodes[id].head==0 && nodes[id].name=="World";
}

// R2 grammar checks are token-level oracles; source/bridge checks exercise lexing separately.
#forall "R2 optional suffix binds to the named payload inside arrays" shape:0..<4 {
 tokens:=[9]PS_Token.[PS_Token.{kind=1,text="T"},PS_Token.{kind=54},PS_Token.{kind=54},PS_Token.{},PS_Token.{},PS_Token.{},PS_Token.{},PS_Token.{},PS_Token.{}];
 if shape==1 {tokens[2].kind=0;}
 if shape==2 {tokens[0].kind=12;tokens[1]=PS_Token.{kind=3,value=2};tokens[2].kind=13;tokens[3]=PS_Token.{kind=1,text="T"};tokens[4].kind=54;}
 if shape==3 {tokens[0].kind=8;tokens[1]=PS_Token.{kind=12};tokens[2]=PS_Token.{kind=13};tokens[3]=PS_Token.{kind=1,text="T"};tokens[4].kind=9;tokens[5].kind=54;}
 nodes:[64]PS_Node;state:[1]PS_State;message:[256]u8;r:=PS_type(tokens[..],nodes[..],state[..],message[..]);
 #assert r!=0 && state[0].code=="" && state[0].depth==0;
 if shape==0 {#assert cast(u32)nodes[r].kind==6 && cast(u32)nodes[nodes[r].b].kind==6 && nodes[nodes[nodes[r].b].b].name=="T" && state[0].pos==3;}
 if shape==1 {#assert cast(u32)nodes[r].kind==6 && nodes[nodes[r].b].name=="T" && nodes[r].a==0 && state[0].pos==2;}
 if shape==2 {#assert nodes[r].kind==PS_Tag.type_array && cast(u32)nodes[nodes[r].b].kind==6 && nodes[nodes[nodes[r].b].b].name=="T" && state[0].pos==5;}
 if shape==3 {#assert cast(u32)nodes[r].kind==6 && nodes[nodes[r].b].kind==PS_Tag.type_view && state[0].pos==6;}
 #assert PS_label(54)=="'?'";
}
#forall "R2 typed Result constructors retain type arguments and unit payload absence" unit:bool {
 tokens:=[14]PS_Token.[PS_Token.{kind=1,text="Result"},PS_Token.{kind=8},PS_Token.{kind=1,text="int"},PS_Token.{kind=14},PS_Token.{kind=1,text="Failure"},PS_Token.{kind=9},PS_Token.{kind=20},PS_Token.{kind=10},PS_Token.{kind=1,text="ok"},PS_Token.{kind=23},PS_Token.{kind=3,value=9},PS_Token.{kind=11},PS_Token.{},PS_Token.{}];
 if unit {tokens[2].text="void";tokens[9].kind=11;tokens[10].kind=0;tokens[11].kind=0;}
 nodes:[64]PS_Node;state:[1]PS_State;message:[256]u8;r:=PS_expression(tokens[..],nodes[..],state[..],message[..]);
 #assert r!=0 && state[0].code=="" && nodes[r].kind==PS_Tag.expr_struct_lit && nodes[nodes[r].d].name=="Result";
 args:=nodes[nodes[r].d].head;#assert nodes[args].name==(ifx unit then "void" else "int") && nodes[nodes[args].next].name=="Failure" && nodes[nodes[args].next].next==0;
 field:=nodes[r].head;#assert nodes[field].kind==PS_Tag.decl_field_init && nodes[field].name=="ok" && nodes[field].next==0;
 if unit {#assert nodes[field].a==0 && state[0].pos==10;}else {#assert nodes[nodes[field].a].value==9 && state[0].pos==12;}
}
