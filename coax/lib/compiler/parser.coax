// Token streams to a bounded, indexed syntax tree. Native hosts only copy it.
// Node 0 is null; tag ranges mirror the existing AST and are bridge-checked.
#authority;
PS_Tag :: enum u32 {
  invalid = 0;
  type_named = 1;
  type_array = 2;
  type_view = 3;
  type_dynamic = 4;
  expr_int_lit = 16;
  expr_float_lit = 17;
  expr_bool_lit = 18;
  expr_string_lit = 19;
  expr_ident = 20;
  expr_call = 21;
  expr_unary = 22;
  expr_binary = 23;
  expr_run = 24;
  expr_field = 25;
  expr_index = 26;
  expr_slice = 27;
  expr_struct_lit = 28;
  expr_array_lit = 29;
  expr_cast = 30;
  expr_ifx = 31;
  stmt_block = 40;
  stmt_expr = 41;
  stmt_var = 42;
  stmt_assign = 43;
  stmt_ret = 44;
  stmt_if_ = 45;
  stmt_while_ = 46;
  stmt_for_range = 47;
  stmt_for_each = 48;
  stmt_break_ = 49;
  stmt_continue_ = 50;
  stmt_defer = 51;
  stmt_assert_ = 52;
  decl_proc = 64;
  decl_constant = 65;
  decl_struct_ = 66;
  decl_enum_ = 67;
  decl_param = 68;
  decl_field = 69;
  decl_enum_member = 70;
  decl_field_init = 71;
  decl_import_ = 72;
  decl_check = 73;
  decl_file = 74;
  decl_assertion = 75;
}
PS_Loc :: struct {line:int;column:int;offset:int;}
PS_Token :: struct {kind:u32;text:string;loc:PS_Loc;value:u64;floating:f64;width:int;raw_count:int;}
PS_Node :: struct {kind:PS_Tag;loc:PS_Loc;name:string;name2:string;loc2:PS_Loc;a:int;b:int;c:int;d:int;head:int;tail:int;next:int;op:u32;flag:bool;flag2:bool;value:u64;floating:f64;width:int;end:int;}
PS_State :: struct {pos:int;used:int;depth:int;code:string;loc:PS_Loc;fix:string;length:int;development:bool;}
PS_Result :: struct {ok:bool;root:int;}
PS_Caps :: struct {nodes:int;message:int;imports:int;}
PS_caps :: (tokens:int,source:int)->PS_Caps #export_c {
  if tokens<1 || tokens>2147483646 || source<0 || source>2147483646 {return PS_Caps.{};}
  return PS_Caps.{nodes=tokens*3+97,message=source+512,imports=tokens/5};
}
PS_peek :: (t:[] PS_Token,s:[] PS_State,ahead:int)->PS_Token {at:=s[0].pos+ahead;if at>=t.count {return t[t.count-1];}return t[at];}
PS_at :: (t:[] PS_Token,s:[] PS_State,kind:u32)->bool {return PS_peek(t,s,0).kind==kind;}
PS_kw :: (t:[] PS_Token,s:[] PS_State,name:string)->bool {v:=PS_peek(t,s,0);return v.kind==2 && v.text==name;}
PS_skip :: (t:[] PS_Token,s:[] PS_State) {if s[0].code=="" && s[0].pos<t.count-1 {s[0].pos+=1;}}
PS_take :: (t:[] PS_Token,s:[] PS_State)->PS_Token {v:=PS_peek(t,s,0);PS_skip(t,s);return v;}
PS_write :: (s:[] PS_State,out:[] u8,text:string) {
  for c:text {if s[0].length<out.count {out[s[0].length]=c;s[0].length+=1;}}
}
PS_error :: (s:[] PS_State,out:[] u8,loc:PS_Loc,code:string,fix:string,parts:[] string) {
  if s[0].code!="" {return;}s[0].code=code;s[0].loc=loc;s[0].fix=fix;for part:parts {PS_write(s,out,part);}
}
PS_fail :: (s:[] PS_State,out:[] u8,loc:PS_Loc,code:string,message:string,fix:string) {
  parts:=[1] string.[message];PS_error(s,out,loc,code,fix,parts[..]);
}
PS_label :: (kind:u32)->string {
  words:=[53] string.["end of file","identifier","keyword","integer","float","string","directive","annotation","'('","')'","'{'","'}'","'['","']'","','","';'","':'","'::'","':='","'->'","'.'","'..'","'..<'","'='","'+='","'-='","'*='","'/='","'%='","'&='","'|='","'^='","'<<='","'>>='","'+'","'-'","'*'","'/'","'%'","'&'","'|'","'^'","'<<'","'>>'","'=='","'!='","'<'","'<='","'>'","'>='","'&&'","'||'","'!'"];
  return words[cast(int)kind];
}
PS_Description :: struct {open:string;word:string;close:string;}
PS_describe :: (v:PS_Token)->PS_Description {
  if v.kind==1 || v.kind==2 {return PS_Description.{open="'",word=v.text,close="'"};}return PS_Description.{word=PS_label(v.kind)};
}
PS_expect :: (t:[] PS_Token,s:[] PS_State,out:[] u8,kind:u32,what:string) {
  if PS_at(t,s,kind) {PS_skip(t,s);return;}
  v:=PS_peek(t,s,0);loc:=v.loc;fix:="";
  if kind==15 && s[0].pos>0 {p:=t[s[0].pos-1];loc=PS_Loc.{line=p.loc.line,column=p.loc.column+p.raw_count,offset=p.loc.offset+p.raw_count};}
  if kind==15 {fix="add ';'";}
  d:=PS_describe(v);parts:=[8] string.["expected ",PS_label(kind)," ",what,", found ",d.open,d.word,d.close];PS_error(s,out,loc,"E0201",fix,parts[..]);
}
PS_expect_kw :: (t:[] PS_Token,s:[] PS_State,out:[] u8,name:string,what:string) {
  if PS_kw(t,s,name) {PS_skip(t,s);return;}
  v:=PS_peek(t,s,0);d:=PS_describe(v);parts:=[8] string.["expected '",name,"' ",what,", found ",d.open,d.word,d.close];PS_error(s,out,v.loc,"E0201","",parts[..]);
}
PS_ident :: (t:[] PS_Token,s:[] PS_State,out:[] u8,what:string)->PS_Token {
  v:=PS_peek(t,s,0);if v.kind==1 {return PS_take(t,s);}
  d:=PS_describe(v);parts:=[6] string.["expected ",what,", found ",d.open,d.word,d.close];PS_error(s,out,v.loc,"E0208","",parts[..]);return PS_Token.{};
}
PS_new :: (n:[] PS_Node,s:[] PS_State,out:[] u8,kind:PS_Tag,loc:PS_Loc)->int {
  if s[0].code!="" {return 0;}
  if s[0].used+1>=n.count {PS_fail(s,out,loc,"E0221","parser node budget exceeded","");return 0;}
  s[0].used+=1;id:=s[0].used;n[id]=PS_Node.{kind=kind,loc=loc};return id;
}
PS_valid :: (s:[] PS_State,id:int)->int {if s[0].code!="" {return 0;}return id;}
PS_link :: (n:[] PS_Node,parent:int,child:int) {
  if n[parent].head==0 {n[parent].head=child;}else {n[n[parent].tail].next=child;}n[parent].tail=child;
}
PS_enter :: (s:[] PS_State,out:[] u8,loc:PS_Loc)->bool {
  if s[0].code!="" {return false;}
  if s[0].depth>=128 {PS_fail(s,out,loc,"E0221","parser nesting budget exceeded","reduce syntax nesting");return false;}s[0].depth+=1;return true;
}
PS_leave :: (s:[] PS_State) {s[0].depth-=1;}
PS_prec :: (k:u32)->int {
  if k>=44 && k<=49 {return 3;}
  if k==51 {return 1;}if k==50 {return 2;}
  if k==34 || k==35 || k==40 || k==41 {return 4;}
  if k==36 || k==37 || k==38 || k==39 || k==42 || k==43 {return 5;}return 0;
}
PS_assign :: (k:u32)->bool {return k>=23 && k<=33;}
PS_type :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8)->int {
  v:=PS_peek(t,s,0);if !PS_enter(s,out,v.loc) {return 0;}defer PS_leave(s);
  id:=PS_new(n,s,out,PS_Tag.type_named,v.loc);
  if v.kind==12 {
    PS_skip(t,s);
    if PS_at(t,s,13) {PS_skip(t,s);n[id].kind=PS_Tag.type_view;}
    else if PS_at(t,s,21) {PS_skip(t,s);PS_expect(t,s,out,13,"after '[..'");n[id].kind=PS_Tag.type_dynamic;}
    else {n[id].kind=PS_Tag.type_array;n[id].a=PS_expression(t,n,s,out);PS_expect(t,s,out,13,"after the array length");}
    n[id].b=PS_type(t,n,s,out);return PS_valid(s,id);
  }
  if v.kind!=1 && v.kind!=2 {parts:=[2] string.["expected a type, found ",PS_label(v.kind)];PS_error(s,out,v.loc,"E0202","",parts[..]);return 0;}
  n[id].name=PS_take(t,s).text;
  // alias.Name: a module-qualified type (name2 is the alias), exactly one alias deep.
  if v.kind==1 && PS_at(t,s,20) && PS_peek(t,s,1).kind==1 {PS_skip(t,s);n[id].name2=n[id].name;n[id].name=PS_take(t,s).text;
    if PS_at(t,s,20) && PS_peek(t,s,1).kind==1 {PS_reexport(s,out,v.loc);return 0;}}
  return PS_valid(s,id);
}
PS_origin :: (n:[] PS_Node,e:int)->PS_Loc {q:=e;while n[q].kind==PS_Tag.expr_field {q=n[q].a;}return n[q].loc;}
PS_reexport :: (s:[] PS_State,out:[] u8,loc:PS_Loc) {PS_fail(s,out,loc,"E0222","a qualified name takes one module alias; aliases are not reexported","load that module here with its own alias");}
PS_expression :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8)->int {return PS_expr(t,n,s,out,1);}
PS_expr :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8,min_prec:int)->int {
  if !PS_enter(s,out,PS_peek(t,s,0).loc) {return 0;}defer PS_leave(s);
  lhs:=PS_unary(t,n,s,out);
  while s[0].code=="" {
    op:=PS_peek(t,s,0);p:=PS_prec(op.kind);if p<min_prec || p==0 {break;}PS_skip(t,s);
    rhs:=PS_expr(t,n,s,out,p+1);
    if p==3 && PS_prec(PS_peek(t,s,0).kind)==3 {PS_fail(s,out,PS_peek(t,s,0).loc,"E0203","comparisons cannot be chained","split it with '&&'");return 0;}
    id:=PS_new(n,s,out,PS_Tag.expr_binary,op.loc);n[id].op=op.kind;n[id].a=lhs;n[id].b=rhs;lhs=id;
  }return PS_valid(s,lhs);
}
PS_unary :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8)->int {
  v:=PS_peek(t,s,0);if !PS_enter(s,out,v.loc) {return 0;}defer PS_leave(s);
  kind:PS_Tag=PS_Tag.invalid;if v.kind==6 && v.text=="run" {kind=PS_Tag.expr_run;}else if v.kind==35 || v.kind==52 {kind=PS_Tag.expr_unary;}else if PS_kw(t,s,"cast") {kind=PS_Tag.expr_cast;}
  if kind!=PS_Tag.invalid {
    PS_skip(t,s);id:=PS_new(n,s,out,kind,v.loc);if kind==PS_Tag.expr_unary {n[id].op=v.kind;}
    if kind==PS_Tag.expr_cast {
      if PS_at(t,s,14) {PS_skip(t,s);m:=PS_peek(t,s,0);if m.kind!=1 || m.text!="trunc" {PS_fail(s,out,m.loc,"E0214","the only cast modifier is 'trunc'","cast,trunc(u8) x");return 0;}PS_skip(t,s);n[id].flag=true;}
      PS_expect(t,s,out,8,"after 'cast'");n[id].d=PS_type(t,n,s,out);
      PS_expect(t,s,out,9,"after the cast type");
    }
    n[id].a=PS_unary(t,n,s,out);return PS_valid(s,id);
  }
  return PS_postfix(t,n,s,out,PS_primary(t,n,s,out));
}
PS_list_expr :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8,id:int,close:u32,what:string) {
  while !PS_at(t,s,close) && s[0].code=="" {
    a:=PS_expression(t,n,s,out);PS_link(n,id,a);
    if !PS_at(t,s,14) {break;}PS_skip(t,s);
  }PS_expect(t,s,out,close,what);
}
#forall "reflection query names select a complete record schema" kind:0..<3 {
 names:=[3]string.["type_info","field_info","enum_info"];
 #assert PS_meta_kind(names[kind])==kind+1;
 #assert PS_meta_kind("not_reflection")==0;
}
#test "reflection schemas are injected once only when requested" {
 nodes:[256]PS_Node;state:=[1]PS_State.[PS_State.{used=2}];out:[256]u8;
 nodes[1]=PS_Node.{kind=PS_Tag.decl_file};nodes[2]=PS_Node.{kind=PS_Tag.expr_call,name="type_info",d=3};
 PS_meta_types(nodes[..],state[..],out[..],1);
 #assert state[0].code=="" && nodes[nodes[1].head].name=="CoaxTypeInfo";
 #assert nodes[nodes[nodes[1].head].next].name=="CoaxFieldInfo";
 #assert nodes[nodes[nodes[nodes[1].head].next].next].name=="CoaxEnumInfo";
 #assert nodes[nodes[nodes[1].head].head].name=="schema_version";
 #assert state[0].used==53;
 state[0]=PS_State.{used=2};nodes[1]=PS_Node.{kind=PS_Tag.decl_file};nodes[2].name="other";
 PS_meta_types(nodes[..],state[..],out[..],1);#assert state[0].used==2 && nodes[1].head==0;
}
#forall "reflection query grammar retains type, selector and delimiters" query:0..<3, broken:0..<5 {
 names:=[3]string.["type_info","field_info","enum_info"];
 tokens:=[10]PS_Token.[PS_Token.{kind=1,text="info"},PS_Token.{kind=17},PS_Token.{kind=1,text=names[query]},PS_Token.{kind=8},PS_Token.{kind=1,text="u8"},PS_Token.{kind=14},PS_Token.{kind=3,value=7},PS_Token.{kind=9},PS_Token.{kind=15},PS_Token.{}];
 if query==0 {tokens[2].kind=2;tokens[5].kind=9;tokens[6].kind=15;tokens[7].kind=0;tokens[8].kind=0;}
 if broken==1 {tokens[3].kind=9;}
 if broken==2 {tokens[4].kind=3;}
 if broken==3 {if query==0 {tokens[5].kind=14;}else {tokens[5].kind=15;}}
 if broken==4 {if query==0 {tokens[5].kind=8;}else {tokens[7].kind=8;}}
 nodes:[256]PS_Node;state:[1]PS_State;out:[512]u8;
 r:=PS_parse("",tokens[..],nodes[..],state[..],out[..]);
 #assert r.ok==(broken==0);
 if broken==0 {
  call:=nodes[nodes[1].head].a;
  #assert nodes[call].kind==PS_Tag.expr_call && nodes[call].name==names[query];
  #assert nodes[nodes[call].d].name=="u8";
  if query==0 {#assert nodes[call].head==0;}else {#assert nodes[nodes[call].head].value==7;}
  #assert nodes[nodes[nodes[1].head].next].name=="CoaxTypeInfo";
 }
}
#test "injected reflection schemas carry every field and resolved spelling" {
 nodes:[256]PS_Node;state:=[1]PS_State.[PS_State.{used=1}];out:[256]u8;
 nodes[1]=PS_Node.{kind=PS_Tag.expr_call,name="type_info",d=3};
 PS_meta_types(nodes[..],state[..],out[..],0);
 expected:=[24]string.["schema_version","name","kind","size","alignment","bits","is_signed","field_count","member_count","element_count","element_name","schema_version","index","name","type_name","offset","size","alignment","schema_version","index","name","value_bits","bits","is_signed"];
 types:=[24]string.["u32","string","string","int","int","int","bool","int","int","int","string","u32","int","string","string","int","int","int","u32","int","string","u64","int","bool"];
 record:=nodes[0].head;index:=0;
 for k:0..<3 {
  field:=nodes[record].head;
  while field!=0 {#assert nodes[field].kind==PS_Tag.decl_field && nodes[field].name==expected[index];#assert nodes[nodes[field].a].kind==PS_Tag.type_named && nodes[nodes[field].a].name==types[index];index+=1;field=nodes[field].next;}
  record=nodes[record].next;
 }
 #assert index==24 && record==0;
 state[0]=PS_State.{used=1};nodes[0]=PS_Node.{};nodes[1].d=0;
 PS_meta_types(nodes[..],state[..],out[..],0);#assert state[0].used==1;
 state[0].used=1;nodes[1]=PS_Node.{kind=PS_Tag.expr_ident,name="type_info",d=3};
 PS_meta_types(nodes[..],state[..],out[..],0);#assert state[0].used==1;
 nodes[2]=PS_Node.{kind=PS_Tag.expr_call,name="type_info",d=3};
 PS_meta_types(nodes[..],state[..],out[..],0);#assert state[0].used==1;
}
#forall "wide product schema is injected once for a call or named result" variant:0..<5 {
 nodes:[32]PS_Node;state:=[1]PS_State.[PS_State.{used=3}];out:[256]u8;
 nodes[1]=PS_Node.{kind=PS_Tag.decl_file};
 nodes[2]=PS_Node.{kind=PS_Tag.expr_call,name="mul_wide"};nodes[3]=nodes[2];
 if variant==1 {nodes[2]=PS_Node.{kind=PS_Tag.type_named,name="CoaxU64Product"};nodes[3].name="other";}
 if variant==2 {nodes[2].name="other";nodes[3].name="other";}
 if variant==3 {nodes[2].kind=PS_Tag.expr_ident;nodes[3].kind=PS_Tag.expr_ident;}
 if variant==4 {state[0].used=2;nodes[2].name="other";}
 PS_wide_type(nodes[..],state[..],out[..],1);
 if variant<2 {
  d:=nodes[1].head;#assert nodes[d].kind==PS_Tag.decl_struct_ && nodes[d].name=="CoaxU64Product";
  hi:=nodes[d].head;lo:=nodes[hi].next;
  #assert nodes[hi].name=="hi" && nodes[lo].name=="lo" && nodes[lo].next==0;
  #assert nodes[nodes[hi].a].name=="u64" && nodes[nodes[lo].a].name=="u64";
  #assert state[0].used==8 && nodes[d].next==0 && state[0].code=="";
 } else {#assert state[0].used==(ifx variant==4 then 2 else 3) && nodes[1].head==0;}
}
#test "wide schema scans the first used node and ignores stale spare nodes" {
 nodes:[16]PS_Node;state:=[1]PS_State.[PS_State.{used=1}];out:[256]u8;
 nodes[1]=PS_Node.{kind=PS_Tag.expr_call,name="mul_wide"};
 PS_wide_type(nodes[..],state[..],out[..],0);
 #assert state[0].used==6 && nodes[nodes[0].head].name=="CoaxU64Product";
}
#test "normal parsing publishes the wide result schema beside the source declarations" {
 tokens:=[10]PS_Token.[PS_Token.{kind=1,text="p"},PS_Token.{kind=17},PS_Token.{kind=1,text="mul_wide"},PS_Token.{kind=8},PS_Token.{kind=3,value=1},PS_Token.{kind=14},PS_Token.{kind=3,value=2},PS_Token.{kind=9},PS_Token.{kind=15},PS_Token.{}];
 nodes:[64]PS_Node;state:[1]PS_State;out:[256]u8;
 parsed:=PS_parse("",tokens[..],nodes[..],state[..],out[..]);
 #assert parsed.ok && state[0].code=="";
 d:=nodes[nodes[1].head].next;#assert d!=0 && nodes[d].kind==PS_Tag.decl_struct_ && nodes[d].name=="CoaxU64Product";
}
PS_meta_kind :: (name:string)->int {
 if name=="type_info" {return 1;}if name=="field_info" {return 2;}if name=="enum_info" {return 3;}return 0;
}
PS_meta_record :: (n:[]PS_Node,s:[]PS_State,out:[]u8,root:int,loc:PS_Loc,name:string,names:[]string,types:[]string) {
 d:=PS_new(n,s,out,PS_Tag.decl_struct_,loc);n[d].name=name;PS_link(n,root,d);
 for i:0..<names.count {
  f:=PS_new(n,s,out,PS_Tag.decl_field,loc);n[f].name=names[i];
  t:=PS_new(n,s,out,PS_Tag.type_named,loc);n[t].name=types[i];n[f].a=t;PS_link(n,d,f);
 }
}
PS_meta_types :: (n:[]PS_Node,s:[]PS_State,out:[]u8,root:int) {
 for i:1..<s[0].used+1 {
  if n[i].kind==PS_Tag.expr_call && n[i].d!=0 && PS_meta_kind(n[i].name)!=0 {
   names:=[11]string.["schema_version","name","kind","size","alignment","bits","is_signed","field_count","member_count","element_count","element_name"];
   types:=[11]string.["u32","string","string","int","int","int","bool","int","int","int","string"];
   PS_meta_record(n,s,out,root,n[i].loc,"CoaxTypeInfo",names[..],types[..]);
   fnames:=[7]string.["schema_version","index","name","type_name","offset","size","alignment"];
   ftypes:=[7]string.["u32","int","string","string","int","int","int"];
   PS_meta_record(n,s,out,root,n[i].loc,"CoaxFieldInfo",fnames[..],ftypes[..]);
   enames:=[6]string.["schema_version","index","name","value_bits","bits","is_signed"];
   etypes:=[6]string.["u32","int","string","u64","int","bool"];
   PS_meta_record(n,s,out,root,n[i].loc,"CoaxEnumInfo",enames[..],etypes[..]);return;
  }
 }
}

PS_wide_type :: (n:[]PS_Node,s:[]PS_State,out:[]u8,root:int) {
 for i:1..<s[0].used+1 {
  if (n[i].kind==PS_Tag.expr_call && n[i].name=="mul_wide") || (n[i].kind==PS_Tag.type_named && n[i].name=="CoaxU64Product") {
   names:=[2]string.["hi","lo"];types:=[2]string.["u64","u64"];
   PS_meta_record(n,s,out,root,n[i].loc,"CoaxU64Product",names[..],types[..]);return;
  }
 }
}

PS_primary :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8)->int {
  v:=PS_peek(t,s,0);id:=PS_new(n,s,out,PS_Tag.expr_int_lit,v.loc);
  if v.kind==3 {n[id].value=v.value;PS_skip(t,s);return PS_valid(s,id);}
  if v.kind==4 {n[id].kind=PS_Tag.expr_float_lit;n[id].floating=v.floating;n[id].width=v.width;if v.width==32 {n[id].floating=cast(f64)cast(f32)v.floating;}PS_skip(t,s);return PS_valid(s,id);}
  if v.kind==5 {n[id].kind=PS_Tag.expr_string_lit;n[id].name=v.text;PS_skip(t,s);return PS_valid(s,id);}
  if v.kind==8 {PS_skip(t,s);inner:=PS_expression(t,n,s,out);PS_expect(t,s,out,9,"to close '('");return PS_valid(s,inner);}
  if v.kind==12 {
    n[id].kind=PS_Tag.expr_array_lit;n[id].d=PS_type(t,n,s,out);
    if n[n[id].d].kind!=PS_Tag.type_array {PS_fail(s,out,v.loc,"E0217","an array literal needs a fixed array type","[3] int.[1, 2, 3]");return 0;}
    PS_expect(t,s,out,20,"after the array type");PS_expect(t,s,out,12,"to start the elements");
    PS_list_expr(t,n,s,out,id,13,"to close the array literal");return PS_valid(s,id);
  }
  if (v.kind==2 || v.kind==1) && PS_meta_kind(v.text)!=0 {
    PS_skip(t,s);n[id].kind=PS_Tag.expr_call;n[id].name=v.text;PS_expect(t,s,out,8,"after the reflection query");n[id].d=PS_type(t,n,s,out);
    if v.text!="type_info" {PS_expect(t,s,out,14,"before the reflection index");a:=PS_expression(t,n,s,out);PS_link(n,id,a);}
    PS_expect(t,s,out,9,"after the reflection query");return PS_valid(s,id);
  }
  if v.kind==2 {
    if v.text=="true" || v.text=="false" {n[id].kind=PS_Tag.expr_bool_lit;if v.text=="true" {n[id].value=1;}PS_skip(t,s);return PS_valid(s,id);}
    if v.text=="ifx" {
      PS_skip(t,s);n[id].kind=PS_Tag.expr_ifx;n[id].a=PS_expression(t,n,s,out);PS_expect_kw(t,s,out,"then","after the ifx condition");
      n[id].b=PS_expression(t,n,s,out);PS_expect_kw(t,s,out,"else","in ifx; both branches are required");
      n[id].c=PS_expression(t,n,s,out);return PS_valid(s,id);
    }
    if v.text=="size_of" {
      PS_skip(t,s);n[id].kind=PS_Tag.expr_call;n[id].name=v.text;PS_expect(t,s,out,8,"after size_of");n[id].d=PS_type(t,n,s,out);
      PS_expect(t,s,out,9,"after the type");return PS_valid(s,id);
    }
    PS_reserved(s,out,v);return 0;
  }
  if v.kind==1 {
    PS_skip(t,s);n[id].name=v.text;if !PS_at(t,s,8) {n[id].kind=PS_Tag.expr_ident;return PS_valid(s,id);}
    PS_skip(t,s);n[id].kind=PS_Tag.expr_call;PS_list_expr(t,n,s,out,id,9,"after the arguments");return PS_valid(s,id);
  }
  parts:=[2] string.["expected an expression, found ",PS_label(v.kind)];PS_error(s,out,v.loc,"E0205","",parts[..]);return 0;
}
PS_reserved :: (s:[] PS_State,out:[] u8,v:PS_Token) {parts:=[3] string.["'",v.text,"' is reserved and not supported by coax0 yet"];PS_error(s,out,v.loc,"E0204","",parts[..]);}
PS_postfix :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8,first:int)->int {
  e:=first;
  while s[0].code=="" {
    v:=PS_peek(t,s,0);after:=PS_peek(t,s,1);
    if v.kind==20 && after.kind==1 {PS_skip(t,s);f:=PS_new(n,s,out,PS_Tag.expr_field,v.loc);n[f].name=PS_take(t,s).text;n[f].a=e;e=f;}
    else if v.kind==8 && n[e].kind==PS_Tag.expr_field && n[n[e].a].kind==PS_Tag.expr_ident {
      // alias.proc(...): a module-qualified call at the alias's source position.
      q:=n[e].a;n[e].kind=PS_Tag.expr_call;n[e].name2=n[q].name;n[e].loc=n[q].loc;n[e].a=0;PS_skip(t,s);PS_list_expr(t,n,s,out,e,9,"after the arguments");
    }
    else if v.kind==8 && n[e].kind==PS_Tag.expr_field && n[n[e].a].kind==PS_Tag.expr_field {PS_reexport(s,out,PS_origin(n,e));return 0;}
    else if v.kind==20 && after.kind==10 {
      head:=e;qual:="";if n[e].kind==PS_Tag.expr_field && n[n[e].a].kind==PS_Tag.expr_ident {head=n[e].a;qual=n[head].name;}
      else if n[e].kind==PS_Tag.expr_field && n[n[e].a].kind==PS_Tag.expr_field {PS_reexport(s,out,PS_origin(n,e));return 0;}
      else if n[e].kind!=PS_Tag.expr_ident {PS_fail(s,out,v.loc,"E0215","a struct literal starts with the struct's name","Point.{x = 1, y = 2}");return 0;}
      lit:=PS_new(n,s,out,PS_Tag.expr_struct_lit,n[head].loc);ty:=PS_new(n,s,out,PS_Tag.type_named,n[head].loc);n[ty].name=n[e].name;n[ty].name2=qual;n[lit].d=ty;PS_skip(t,s);PS_skip(t,s);
      while !PS_at(t,s,11) && s[0].code=="" {
        name:=PS_ident(t,s,out,"a field name");PS_expect(t,s,out,23,"after the field name; struct literals name every field");
        f:=PS_new(n,s,out,PS_Tag.decl_field_init,name.loc);n[f].name=name.text;n[f].a=PS_expression(t,n,s,out);PS_link(n,lit,f);
        if !PS_at(t,s,14) {break;}PS_skip(t,s);
      }
      PS_expect(t,s,out,11,"to close the struct literal");e=lit;
    }
    else if v.kind==12 {
      PS_skip(t,s);id:=PS_new(n,s,out,PS_Tag.expr_slice,v.loc);n[id].a=e;
      if PS_at(t,s,21) && PS_peek(t,s,1).kind==13 {PS_skip(t,s);PS_skip(t,s);e=id;continue;}
      n[id].b=PS_expression(t,n,s,out);
      if PS_at(t,s,22) {PS_skip(t,s);n[id].c=PS_expression(t,n,s,out);PS_expect(t,s,out,13,"to close the slice");}
      else {
        if PS_at(t,s,21) {PS_fail(s,out,PS_peek(t,s,0).loc,"E0216","ranges are half-open: write '..<'","a[lo ..< hi]");return 0;}
        n[id].kind=PS_Tag.expr_index;PS_expect(t,s,out,13,"to close the index");
      }e=id;
    }else {break;}
  }return PS_valid(s,e);
}
PS_block :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8)->int {
  loc:=PS_peek(t,s,0).loc;if !PS_enter(s,out,loc) {return 0;}defer PS_leave(s);
  id:=PS_new(n,s,out,PS_Tag.stmt_block,loc);PS_expect(t,s,out,10,"to start a block");
  while !PS_at(t,s,11) && !PS_at(t,s,0) && s[0].code=="" {child:=PS_stmt(t,n,s,out);PS_link(n,id,child);}
  PS_expect(t,s,out,11,"to close the block");return PS_valid(s,id);
}
PS_if :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8)->int {
  v:=PS_take(t,s);if !PS_enter(s,out,v.loc) {return 0;}defer PS_leave(s);
  id:=PS_new(n,s,out,PS_Tag.stmt_if_,v.loc);n[id].a=PS_expression(t,n,s,out);
  n[id].c=PS_block(t,n,s,out);
  if PS_kw(t,s,"else") {PS_skip(t,s);if PS_kw(t,s,"if") {n[id].d=PS_if(t,n,s,out);}else {n[id].d=PS_block(t,n,s,out);}}return PS_valid(s,id);
}
PS_for :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8)->int {
  v:=PS_take(t,s);id:=PS_new(n,s,out,PS_Tag.stmt_for_each,v.loc);name:=PS_ident(t,s,out,"a loop variable name");n[id].name=name.text;
  if PS_at(t,s,14) {PS_skip(t,s);index:=PS_ident(t,s,out,"an index variable name");n[id].name2=index.text;n[id].loc2=index.loc;}
  PS_expect(t,s,out,16,"after the loop variable");
  n[id].a=PS_expression(t,n,s,out);
  if PS_at(t,s,22) {
    PS_skip(t,s);n[id].kind=PS_Tag.stmt_for_range;if n[id].name2.count!=0 {PS_fail(s,out,n[id].loc2,"E0218","a range loop has one variable","for i: 0..<n { }");return 0;}
    n[id].b=PS_expression(t,n,s,out);
  }else if PS_at(t,s,21) {PS_fail(s,out,PS_peek(t,s,0).loc,"E0216","ranges are half-open: write '..<'","for i: 0..<n { }");return 0;}
  n[id].c=PS_block(t,n,s,out);return PS_valid(s,id);
}
PS_simple :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8)->int {
  e:=PS_expression(t,n,s,out);v:=PS_peek(t,s,0);
  if PS_assign(v.kind) {
    if n[e].kind!=PS_Tag.expr_ident && n[e].kind!=PS_Tag.expr_field && n[e].kind!=PS_Tag.expr_index {PS_fail(s,out,n[e].loc,"E0207","only a variable, a field or an element can be assigned to","");return 0;}
    PS_skip(t,s);id:=PS_new(n,s,out,PS_Tag.stmt_assign,v.loc);n[id].op=v.kind;n[id].c=e;n[id].a=PS_expression(t,n,s,out);return PS_valid(s,id);
  }id:=PS_new(n,s,out,PS_Tag.stmt_expr,n[e].loc);n[id].a=e;return PS_valid(s,id);
}
PS_uninitialized :: (t:[] PS_Token,s:[] PS_State)->bool {for i:0..<3 {if PS_peek(t,s,i).kind!=35 {return false;}}return true;}
PS_stmt :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8)->int {
  v:=PS_peek(t,s,0);if v.kind==10 {return PS_block(t,n,s,out);}
  if v.kind==6 && v.text=="if" {return PS_profile_stmt(t,n,s,out);}
  if v.kind==6 && v.text=="assert" {PS_skip(t,s);id:=PS_new(n,s,out,PS_Tag.stmt_assert_,v.loc);n[id].a=PS_expression(t,n,s,out);PS_expect(t,s,out,15,"after #assert");return PS_valid(s,id);}
  if v.kind==2 {
    if v.text=="if" {return PS_if(t,n,s,out);}if v.text=="for" {return PS_for(t,n,s,out);}
    if v.text=="while" {PS_skip(t,s);id:=PS_new(n,s,out,PS_Tag.stmt_while_,v.loc);n[id].a=PS_expression(t,n,s,out);n[id].c=PS_block(t,n,s,out);return PS_valid(s,id);}
    if v.text=="return" {PS_skip(t,s);id:=PS_new(n,s,out,PS_Tag.stmt_ret,v.loc);if !PS_at(t,s,15) {n[id].a=PS_expression(t,n,s,out);}PS_expect(t,s,out,15,"after the return");return PS_valid(s,id);}
    if v.text=="break" || v.text=="continue" {PS_skip(t,s);kind:PS_Tag=PS_Tag.stmt_break_;what:="after break";if v.text=="continue" {kind=PS_Tag.stmt_continue_;what="after continue";}id:=PS_new(n,s,out,kind,v.loc);PS_expect(t,s,out,15,what);return PS_valid(s,id);}
    if v.text=="defer" {PS_skip(t,s);id:=PS_new(n,s,out,PS_Tag.stmt_defer,v.loc);
      if PS_at(t,s,10) {n[id].c=PS_block(t,n,s,out);}
      else {n[id].c=PS_simple(t,n,s,out);PS_expect(t,s,out,15,"after the deferred statement");}return PS_valid(s,id);
    }
  }
  after:=PS_peek(t,s,1);
  if v.kind==1 && (after.kind==18 || after.kind==16) {
    id:=PS_new(n,s,out,PS_Tag.stmt_var,v.loc);n[id].name=v.text;PS_skip(t,s);op:=PS_take(t,s);
    if op.kind==16 {
      n[id].d=PS_type(t,n,s,out);
      if PS_at(t,s,23) {PS_skip(t,s);
        if PS_uninitialized(t,s) {PS_skip(t,s);PS_skip(t,s);PS_skip(t,s);n[id].flag=true;}
        else {n[id].a=PS_expression(t,n,s,out);}
      }
    }else {n[id].a=PS_expression(t,n,s,out);}
    PS_expect(t,s,out,15,"after the declaration");return PS_valid(s,id);
  }
  if v.kind==1 && after.kind==17 {PS_fail(s,out,after.loc,"E0206","local constants, procedures and types are not supported by coax0 yet","move it to the top level");return 0;}
  id:=PS_simple(t,n,s,out);what:="after the statement";if n[id].kind==PS_Tag.stmt_assign {what="after the assignment";}
  PS_expect(t,s,out,15,what);return PS_valid(s,id);
}
PS_starts_proc :: (t:[] PS_Token,s:[] PS_State)->bool {
  if !PS_at(t,s,8) {return false;}depth:=0;i:=0;
  while PS_peek(t,s,i).kind!=0 {k:=PS_peek(t,s,i).kind;if k==8 {depth+=1;}if k==9 {depth-=1;if depth==0 {after:=PS_peek(t,s,i+1).kind;return after==10 || after==19 || after==6;}}i+=1;}return false;
}
PS_proc :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8,name:PS_Token)->int {
  id:=PS_new(n,s,out,PS_Tag.decl_proc,name.loc);n[id].name=name.text;PS_expect(t,s,out,8,"to start the parameter list");
  while !PS_at(t,s,9) && s[0].code=="" {
    v:=PS_ident(t,s,out,"a parameter name");PS_expect(t,s,out,16,"after the parameter name");
    p:=PS_new(n,s,out,PS_Tag.decl_param,v.loc);n[p].name=v.text;n[p].a=PS_type(t,n,s,out);PS_link(n,id,p);
    if !PS_at(t,s,14) {break;}PS_skip(t,s);
  }
  PS_expect(t,s,out,9,"to close the parameter list");
  if PS_at(t,s,19) {PS_skip(t,s);n[id].a=PS_type(t,n,s,out);}
  while PS_at(t,s,6) && s[0].code=="" {
    d:=PS_take(t,s);if d.text=="export_c" {n[id].flag=true;}
    else if d.text=="foreign" {n[id].flag2=true;if n[id].flag {PS_fail(s,out,d.loc,"E0210","a procedure is either #foreign or #export_c, not both","");return 0;}
      PS_expect(t,s,out,15,"after #foreign; a foreign procedure has no body");return PS_valid(s,id);
    }else {parts:=[3] string.["#",d.text," is not supported on procedures by coax0 yet"];PS_error(s,out,d.loc,"E0210","",parts[..]);return 0;}
  }
  n[id].b=PS_block(t,n,s,out);return PS_valid(s,id);
}
PS_struct :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8,name:PS_Token)->int {
  id:=PS_new(n,s,out,PS_Tag.decl_struct_,name.loc);n[id].name=name.text;PS_skip(t,s);
  if PS_at(t,s,6) {d:=PS_peek(t,s,0);parts:=[3] string.["#",d.text," on structs is not supported by coax0 yet"];PS_error(s,out,d.loc,"E0210","",parts[..]);return 0;}
  PS_field_block(t,n,s,out,id);return PS_valid(s,id);
}
// Build-profile selection operates on fully parsed syntax trees. It is not
// source-text deletion or arbitrary compile-time expression evaluation.
PS_debug_condition :: (t:[]PS_Token,s:[]PS_State,out:[]u8)->PS_Loc {
 directive:=PS_take(t,s);selector:=PS_take(t,s);
 if selector.kind!=1 || selector.text!="BUILD_DEBUG" || !PS_at(t,s,10) {
  PS_fail(s,out,selector.loc,"E0210","this slice supports only #if BUILD_DEBUG followed by a block","");
 }
 return directive.loc;
}
// Branches allocate disjoint contiguous node ranges. Retain the allocation
// count/budget, but clear inactive nodes before type/schema helper discovery.
PS_discard_range :: (n:[]PS_Node,first:int,end:int) {for i:first..<end {n[i]=PS_Node.{};}}
PS_profile_stmt :: (t:[]PS_Token,n:[]PS_Node,s:[]PS_State,out:[]u8)->int {
 loc:=PS_debug_condition(t,s,out);yes_from:=s[0].used+1;yes:=PS_block(t,n,s,out);yes_end:=s[0].used+1;no:int;
 if PS_kw(t,s,"else") {PS_skip(t,s);no=PS_block(t,n,s,out);}
 else {no=PS_new(n,s,out,PS_Tag.stmt_block,loc);}
 if s[0].development {PS_discard_range(n,yes_end,s[0].used+1);return PS_valid(s,yes);}
 PS_discard_range(n,yes_from,yes_end);return PS_valid(s,no);
}
PS_field_block :: (t:[]PS_Token,n:[]PS_Node,s:[]PS_State,out:[]u8,parent:int) {
 PS_expect(t,s,out,10,"to start the struct's fields");
 while !PS_at(t,s,11) && s[0].code=="" {
  token:=PS_peek(t,s,0);
  if token.kind==6 && token.text=="if" {PS_profile_fields(t,n,s,out,parent);continue;}
  if PS_kw(t,s,"using") {PS_reserved(s,out,token);return;}
  f:=PS_ident(t,s,out,"a field name");PS_expect(t,s,out,16,"after the field name");
  field:=PS_new(n,s,out,PS_Tag.decl_field,f.loc);n[field].name=f.text;n[field].a=PS_type(t,n,s,out);
  // #flat: a shader's varying the rasterizer does not interpolate (the provoking vertex's)
  if PS_at(t,s,6) {
   d:=PS_take(t,s);
   if d.text=="flat" {n[field].flag=true;}
   else {parts:=[3] string.["#",d.text," is not supported on fields"];PS_error(s,out,d.loc,"E0210","",parts[..]);return;}
  }
  if PS_at(t,s,23) {PS_skip(t,s);n[field].b=PS_expression(t,n,s,out);}
  PS_expect(t,s,out,15,"after the field");PS_link(n,parent,field);
 }
 PS_expect(t,s,out,11,"to close the struct");
}
PS_profile_fields :: (t:[]PS_Token,n:[]PS_Node,s:[]PS_State,out:[]u8,parent:int) {
 loc:=PS_debug_condition(t,s,out);if s[0].code!="" {return;}
 if !PS_enter(s,out,loc) {return;}defer PS_leave(s);
 // Private holder records preserve ordinary field-list representation. Neither
 // holder enters the file's declaration list or acquires a layout/type identity.
 yes_from:=s[0].used+1;yes:=PS_new(n,s,out,PS_Tag.decl_struct_,loc);PS_field_block(t,n,s,out,yes);yes_end:=s[0].used+1;
 no:=PS_new(n,s,out,PS_Tag.decl_struct_,PS_Loc.{});
 if PS_kw(t,s,"else") {PS_skip(t,s);PS_field_block(t,n,s,out,no);}
 selected:=ifx s[0].development then yes else no;
 if n[selected].head!=0 {
  if n[parent].head==0 {n[parent].head=n[selected].head;}
  else {n[n[parent].tail].next=n[selected].head;}
  n[parent].tail=n[selected].tail;
 }
 if s[0].development {PS_discard_range(n,yes_end,s[0].used+1);}else {PS_discard_range(n,yes_from,yes_end);}
 n[selected]=PS_Node.{};
}

PS_enum :: (t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8,name:PS_Token)->int {
  id:=PS_new(n,s,out,PS_Tag.decl_enum_,name.loc);n[id].name=name.text;PS_skip(t,s);
  if PS_at(t,s,10) {PS_fail(s,out,PS_peek(t,s,0).loc,"E0219","an enum names its underlying integer type","Outcome :: enum u8 { ... }");return 0;}
  n[id].a=PS_type(t,n,s,out);PS_expect(t,s,out,10,"to start the enum's members");
  while !PS_at(t,s,11) && s[0].code=="" {
    v:=PS_ident(t,s,out,"an enum member name");if s[0].code!="" {return 0;}m:=PS_new(n,s,out,PS_Tag.decl_enum_member,v.loc);n[m].name=v.text;
    if PS_at(t,s,23) {PS_skip(t,s);n[m].a=PS_expression(t,n,s,out);}
    PS_expect(t,s,out,15,"after the enum member");PS_link(n,id,m);
  }
  PS_expect(t,s,out,11,"to close the enum");return PS_valid(s,id);
}
PS_trim_name :: (source:string,start:int,stop:int)->string {end:=stop;while end>start && (source[end-1]==32 || source[end-1]==10) {end-=1;}return source[start..<end];}
PS_check :: (source:string,t:[] PS_Token,n:[] PS_Node,s:[] PS_State,out:[] u8,d:PS_Token)->int {
  id:=PS_new(n,s,out,PS_Tag.decl_check,d.loc);n[id].flag=d.text=="forall";p:=PS_new(n,s,out,PS_Tag.decl_proc,d.loc);n[id].a=p;
  if PS_at(t,s,5) {n[id].name=PS_take(t,s).text;}
  else if !n[id].flag {PS_fail(s,out,PS_peek(t,s,0).loc,"E0220","#test needs a name string","#test \"refunds never exceed payment\" { ... }");return 0;}
  start:=PS_peek(t,s,0).loc.offset;
  while n[id].flag && !PS_at(t,s,10) && s[0].code=="" {
    v:=PS_ident(t,s,out,"a binding name");PS_expect(t,s,out,16,"after the binding name");
    b:=PS_new(n,s,out,PS_Tag.decl_param,v.loc);n[b].name=v.text;k:=PS_peek(t,s,1).kind;
    if k==14 || k==10 {n[b].a=PS_type(t,n,s,out);}
    else {n[b].b=PS_expression(t,n,s,out);PS_expect(t,s,out,22,"in the range; a #forall binding is a type or lo..<hi");n[b].c=PS_expression(t,n,s,out);}
    PS_link(n,p,b);if !PS_at(t,s,14) {break;}PS_skip(t,s);
  }
  if n[id].flag && n[p].head==0 {PS_fail(s,out,PS_peek(t,s,0).loc,"E0220","#forall needs at least one binding","#forall a: u8, b: bool { ... }");return 0;}
  if n[id].flag && n[id].name.count==0 {
    n[id].name=PS_trim_name(source,start,PS_peek(t,s,0).loc.offset);
  }
  n[p].name=n[id].name;n[p].b=PS_block(t,n,s,out);return PS_valid(s,id);
}
PS_parse :: (source:string,t:[]PS_Token,n:[]PS_Node,s:[]PS_State,out:[]u8)->PS_Result #export_c {
 return PS_parse_build(source,t,n,s,out,true);
}
PS_parse_build :: (source:string,t:[]PS_Token,n:[]PS_Node,s:[]PS_State,out:[]u8,development:bool)->PS_Result #export_c {
  s[0]=PS_State.{};
  if t.count==0 {PS_fail(s,out,PS_Loc.{},"E0221","parser needs an EOF-terminated token stream","");return PS_Result.{};}
  if t[t.count-1].kind!=0 {PS_fail(s,out,t[t.count-1].loc,"E0221","parser needs an EOF-terminated token stream","");return PS_Result.{};}
  root:=PS_new(n,s,out,PS_Tag.decl_file,PS_Loc.{});s[0].development=development;
  while !PS_at(t,s,0) && s[0].code=="" {
    v:=PS_peek(t,s,0);id:int;
    if v.kind==6 {
      PS_skip(t,s);
      if v.text=="import" {m:=PS_peek(t,s,0);if m.kind!=5 {PS_fail(s,out,m.loc,"E0209","expected a module name string after #import","write #import \"Basic\";");break;}
        PS_skip(t,s);id=PS_new(n,s,out,PS_Tag.decl_import_,m.loc);n[id].name=m.text;PS_expect(t,s,out,15,"after the import");
      }else if v.text=="assert" {id=PS_new(n,s,out,PS_Tag.decl_assertion,v.loc);n[id].a=PS_expression(t,n,s,out);PS_expect(t,s,out,15,"after #assert");}
      else if v.text=="test" || v.text=="forall" {id=PS_check(source,t,n,s,out,v);}
      else if v.text=="authority" {n[root].flag=true;PS_expect(t,s,out,15,"after #authority");continue;}
      else {parts:=[3] string.["#",v.text," is not supported by coax0 yet"];PS_error(s,out,v.loc,"E0210","",parts[..]);break;}
    }else if v.kind==1 && PS_peek(t,s,1).kind==17 {
      PS_skip(t,s);PS_skip(t,s);
      if PS_kw(t,s,"struct") {id=PS_struct(t,n,s,out,v);}
      else if PS_kw(t,s,"enum") {id=PS_enum(t,n,s,out,v);}
      else if PS_starts_proc(t,s) {id=PS_proc(t,n,s,out,v);}
      else {id=PS_new(n,s,out,PS_Tag.decl_constant,v.loc);n[id].name=v.text;n[id].a=PS_expression(t,n,s,out);PS_expect(t,s,out,15,"after the constant");}

    }else if v.kind==1 && (PS_peek(t,s,1).kind==16 || PS_peek(t,s,1).kind==18) {PS_fail(s,out,v.loc,"E0212","global variables are not supported by coax0 yet","");break;}
    else {PS_fail(s,out,v.loc,"E0213","expected '#import' or a declaration 'name :: ...' at the top level","");break;}
    // The exact authored range ends after the item's last token (spans: loc.offset..<end).
    last:=t[s[0].pos-1];n[id].end=last.loc.offset+last.raw_count;
    PS_link(n,root,id);
  }
  if s[0].code=="" {PS_meta_types(n,s,out,root);PS_wide_type(n,s,out,root);}
  return PS_Result.{ok=s[0].code=="",root=root};
}
// Source import syntax/admission belongs to the parser; native code reads files.
PS_Import :: struct {path:string;prefix:string;loc:PS_Loc;end:int;}
PS_Imports :: struct {count:int;code:string;message:string;loc:PS_Loc;}
PS_imports :: (t:[] PS_Token,out:[] PS_Import,metal:bool)->PS_Imports #export_c {
  depth:=0;i:=0;r:=PS_Imports.{};
  while i<t.count {
    v:=t[i];if v.kind==10 {depth+=1;}if v.kind==11 {depth-=1;}
    if v.kind!=6 || v.text!="import_proto" {i+=1;continue;}
    if depth!=0 || i+4>=t.count {return PS_Imports.{code="E0501",message="expected #import_proto \"profile.pb\" as Prefix; at top level",loc=v.loc};}
    if t[i+1].kind!=5 || t[i+2].text!="as" || t[i+3].kind!=1 || t[i+4].kind!=15 {return PS_Imports.{code="E0501",message="expected #import_proto \"profile.pb\" as Prefix; at top level",loc=v.loc};}
    if metal {return PS_Imports.{code="E0504",message="proto codecs cannot be compiled as Metal",loc=v.loc};}
    path:=t[i+1].text;prefix:=t[i+3].text;
    for b:path {if b==0 {return PS_Imports.{code="E0501",message="NUL path or duplicate proto prefix",loc=v.loc};}}
    for j:0..<r.count {if out[j].prefix==prefix {return PS_Imports.{code="E0501",message="NUL path or duplicate proto prefix",loc=v.loc};}}
    if r.count>=out.count {return PS_Imports.{code="E0502",message="proto request storage budget exceeded",loc=v.loc};}
    out[r.count]=PS_Import.{path=path,prefix=prefix,loc=v.loc,end=t[i+4].loc.offset+1};r.count+=1;i+=5;
  }
  if r.count>8 {return PS_Imports.{code="E0502",message="at most eight descriptor imports per source",loc=out[0].loc};}return r;
}

#test "a constant has a named declaration and literal value" {
