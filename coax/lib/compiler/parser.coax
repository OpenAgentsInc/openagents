#test "a top-level item's range ends after its last authored token" {
  // "x :: 1;  // c\nS :: struct {a:int;}"
  tokens:=[14] PS_Token.[PS_Token.{kind=1,text="x",raw_count=1,loc=PS_Loc.{line=1,column=1,offset=0}},PS_Token.{kind=17,raw_count=2,loc=PS_Loc.{line=1,column=3,offset=2}},
    PS_Token.{kind=3,value=1,raw_count=1,loc=PS_Loc.{line=1,column=6,offset=5}},PS_Token.{kind=15,raw_count=1,loc=PS_Loc.{line=1,column=7,offset=6}},
    PS_Token.{kind=1,text="S",raw_count=1,loc=PS_Loc.{line=2,column=1,offset=15}},PS_Token.{kind=17,raw_count=2,loc=PS_Loc.{line=2,column=3,offset=17}},
    PS_Token.{kind=2,text="struct",raw_count=6,loc=PS_Loc.{line=2,column=6,offset=20}},PS_Token.{kind=10,raw_count=1,loc=PS_Loc.{line=2,column=13,offset=27}},
    PS_Token.{kind=1,text="a",raw_count=1,loc=PS_Loc.{line=2,column=14,offset=28}},PS_Token.{kind=16,raw_count=1,loc=PS_Loc.{line=2,column=15,offset=29}},
    PS_Token.{kind=1,text="int",raw_count=3,loc=PS_Loc.{line=2,column=16,offset=30}},PS_Token.{kind=15,raw_count=1,loc=PS_Loc.{line=2,column=19,offset=33}},
    PS_Token.{kind=11,raw_count=1,loc=PS_Loc.{line=2,column=20,offset=34}},PS_Token.{loc=PS_Loc.{line=2,column=21,offset=35}}];
  nodes:[64] PS_Node;message:[256] u8;state:[1] PS_State;
  r:=PS_parse("x :: 1;  // c\nS :: struct {a:int;}",tokens[..],nodes[..],state[..],message[..]);
  #assert r.ok;first:=nodes[nodes[r.root].head];second:=nodes[first.next];
  #assert first.loc.offset==0 && first.end==7 && second.kind==PS_Tag.decl_struct_ && second.loc.offset==15 && second.end==35;
  #assert nodes[r.root].end==0;
}
#forall "a $ name in a type position is one type-parameter node" variant:0..<4 {
  // $T ; [] $T ; [4] $T ; $T.U stays one node and leaves the '.'
  tokens:=[7] PS_Token.[PS_Token.{kind=53,text="T",loc=PS_Loc.{line=2,column=7,offset=12}},PS_Token.{kind=15},PS_Token.{},PS_Token.{},PS_Token.{},PS_Token.{},PS_Token.{}];
  if variant==1 {tokens[0]=PS_Token.{kind=12,loc=PS_Loc.{line=2,column=4,offset=9}};tokens[1]=PS_Token.{kind=13};tokens[2]=PS_Token.{kind=53,text="T",loc=PS_Loc.{line=2,column=7,offset=12}};}
  if variant==2 {tokens[0]=PS_Token.{kind=12};tokens[1]=PS_Token.{kind=3,value=4};tokens[2]=PS_Token.{kind=13};tokens[3]=PS_Token.{kind=53,text="T",loc=PS_Loc.{line=2,column=7,offset=12}};}
  if variant==3 {tokens[1]=PS_Token.{kind=20};tokens[2]=PS_Token.{kind=1,text="U"};}
  nodes:[8] PS_Node;state:[1] PS_State;message:[256] u8;
  id:=PS_type(tokens[..],nodes[..],state[..],message[..]);
  #assert state[0].code=="" && state[0].depth==0;
  at:=id;if variant==1 {#assert nodes[id].kind==PS_Tag.type_view && state[0].pos==3;at=nodes[id].b;}
  if variant==2 {#assert nodes[id].kind==PS_Tag.type_array && state[0].pos==4;at=nodes[id].b;}
  #assert nodes[at].kind==PS_Tag.type_param && nodes[at].name=="T" && nodes[at].name2=="" && nodes[at].loc.line==2 && nodes[at].loc.column==7 && nodes[at].loc.offset==12;
  if variant==0 || variant==3 {#assert id==1 && state[0].pos==1 && state[0].used==1;}
}
#forall "a $ name may carry one constraint name" variant:0..<4 {
  // $T: ordered ; $T ; $T: 3 ; $T: ordered: numeric
  tokens:=[6] PS_Token.[PS_Token.{kind=53,text="T"},PS_Token.{kind=16},PS_Token.{kind=1,text="ordered",loc=PS_Loc.{line=2,column=9,offset=12}},PS_Token.{},PS_Token.{},PS_Token.{}];
  if variant==1 {tokens[1]=PS_Token.{kind=14};}
  if variant==2 {tokens[2]=PS_Token.{kind=3,value=3};}
  if variant==3 {tokens[3]=PS_Token.{kind=16};tokens[4]=PS_Token.{kind=1,text="numeric"};}
  nodes:[8] PS_Node;state:[1] PS_State;message:[128] u8;
  id:=PS_type(tokens[..],nodes[..],state[..],message[..]);
  #assert state[0].code=="" && id==1 && nodes[1].kind==PS_Tag.type_param && nodes[1].name=="T";
  if variant==0 || variant==3 {#assert nodes[1].name2=="ordered" && nodes[1].loc2.line==2 && nodes[1].loc2.column==9 && nodes[1].loc2.offset==12 && state[0].pos==3;}
  else {#assert nodes[1].name2=="" && nodes[1].loc2.line==0 && state[0].pos==1;}
  // a struct's parameter list takes the same constraint
  list:=[8] PS_Token.[PS_Token.{kind=2,text="struct"},PS_Token.{kind=8},PS_Token.{kind=53,text="T"},PS_Token.{kind=16},PS_Token.{kind=1,text="numeric"},PS_Token.{kind=9},PS_Token.{kind=10},PS_Token.{kind=11}];
  more:[8] PS_Node;again:[1] PS_State;
  d:=PS_struct(list[..],more[..],again[..],message[..],PS_Token.{kind=1,text="P"});
  #assert again[0].code=="" && d==1 && more[more[1].d].name2=="numeric";
}
#forall "a generic struct lists its $ parameters, each once" variant:0..<4 {
  // struct($T, $N) { a: $T; } ; struct() ; struct($T, $T) ; struct($T {
  tokens:=[14] PS_Token.[PS_Token.{kind=2,text="struct"},PS_Token.{kind=8},PS_Token.{kind=53,text="T",loc=PS_Loc.{line=2,column=17,offset=30}},PS_Token.{kind=14},PS_Token.{kind=53,text="N",loc=PS_Loc.{line=2,column=21,offset=34}},PS_Token.{kind=9},
    PS_Token.{kind=10},PS_Token.{kind=1,text="a"},PS_Token.{kind=16},PS_Token.{kind=53,text="T"},PS_Token.{kind=15},PS_Token.{kind=11},PS_Token.{},PS_Token.{}];
  if variant==1 {tokens[2]=PS_Token.{kind=9,loc=PS_Loc.{line=2,column=17,offset=30}};}
  if variant==2 {tokens[4].text="T";}
  if variant==3 {tokens[3]=PS_Token.{kind=10};}
  nodes:[16] PS_Node;state:[1] PS_State;message:[256] u8;
  id:=PS_struct(tokens[..],nodes[..],state[..],message[..],PS_Token.{kind=1,text="Pair"});
  if variant==0 {
    #assert state[0].code=="" && id==1 && nodes[1].kind==PS_Tag.decl_struct_ && nodes[1].name=="Pair";
    p:=nodes[1].d;q:=nodes[p].next;
    #assert p==2 && nodes[p].kind==PS_Tag.type_param && nodes[p].name=="T" && nodes[p].loc.column==17 && q==3 && nodes[q].name=="N" && nodes[q].next==0;
    f:=nodes[1].head;#assert f!=0 && nodes[f].name=="a" && nodes[nodes[f].a].kind==PS_Tag.type_param && state[0].pos==12;
  }
  if variant==1 {#assert state[0].code=="E0223" && state[0].loc.column==17 && cast(string)message[0..<state[0].length]=="a struct parameter is written $NAME";}
  if variant==2 {#assert state[0].code=="E0223" && state[0].loc.column==21 && state[0].fix=="give each parameter its own name" && cast(string)message[0..<state[0].length]=="struct parameter '$T' is listed twice";}
  if variant==3 {#assert state[0].code!="" && state[0].code!="E0223";}
}
#forall "a type name takes parenthesized type and length arguments" variant:0..<3 {
  // Pair(int) ; Box([] u8, 4) ; Pair(int
  tokens:=[10] PS_Token.[PS_Token.{kind=1,text="Pair"},PS_Token.{kind=8},PS_Token.{kind=1,text="int"},PS_Token.{kind=9},PS_Token.{},PS_Token.{},PS_Token.{},PS_Token.{},PS_Token.{},PS_Token.{}];
  if variant==1 {tokens[2]=PS_Token.{kind=12};tokens[3]=PS_Token.{kind=13};tokens[4]=PS_Token.{kind=1,text="u8"};tokens[5]=PS_Token.{kind=14};tokens[6]=PS_Token.{kind=3,value=4,text="4"};tokens[7]=PS_Token.{kind=9};}
  if variant==2 {tokens[3]=PS_Token.{kind=15};}
  nodes:[16] PS_Node;state:[1] PS_State;message:[256] u8;
  id:=PS_type(tokens[..],nodes[..],state[..],message[..]);
  if variant==0 {#assert state[0].code=="" && id==1 && state[0].pos==4 && state[0].depth==0 && nodes[1].kind==PS_Tag.type_named && nodes[1].name=="Pair";
    a:=nodes[1].head;#assert a==2 && nodes[a].kind==PS_Tag.type_named && nodes[a].name=="int" && nodes[a].next==0 && nodes[1].tail==a;}
  if variant==1 {#assert state[0].code=="" && id==1 && state[0].pos==8;a:=nodes[1].head;b:=nodes[a].next;
    #assert nodes[a].kind==PS_Tag.type_view && nodes[nodes[a].b].name=="u8" && nodes[b].kind==PS_Tag.expr_int_lit && nodes[b].value==4 && nodes[b].next==0 && nodes[1].tail==b;}
  if variant==2 {#assert state[0].code!="" && id==0;}
}
#forall "a $ name as an array length is one value-parameter node" variant:0..<3 {
  // [$N] int ; [$N] $T ; [$N + 1] int is still refused as an expression
  tokens:=[8] PS_Token.[PS_Token.{kind=12},PS_Token.{kind=53,text="N",loc=PS_Loc.{line=3,column=2,offset=20}},PS_Token.{kind=13},PS_Token.{kind=1,text="int"},PS_Token.{},PS_Token.{},PS_Token.{},PS_Token.{}];
  if variant==1 {tokens[3]=PS_Token.{kind=53,text="T"};}
  if variant==2 {tokens[2]=PS_Token.{kind=34};tokens[3]=PS_Token.{kind=3,value=1};tokens[4]=PS_Token.{kind=13};tokens[5]=PS_Token.{kind=1,text="int"};}
  nodes:[8] PS_Node;state:[1] PS_State;message:[256] u8;
  id:=PS_type(tokens[..],nodes[..],state[..],message[..]);
  if variant==2 {#assert state[0].code!="";}
  else {
    #assert state[0].code=="" && state[0].depth==0 && state[0].pos==4 && state[0].used==3 && id==1 && nodes[1].kind==PS_Tag.type_array;
    a:=nodes[1].a;#assert a==2 && nodes[a].kind==PS_Tag.type_param && nodes[a].name=="N" && nodes[a].loc.line==3 && nodes[a].loc.column==2 && nodes[a].loc.offset==20;
    if variant==0 {#assert nodes[nodes[1].b].kind==PS_Tag.type_named && nodes[nodes[1].b].name=="int";}
    else {#assert nodes[nodes[1].b].kind==PS_Tag.type_param && nodes[nodes[1].b].name=="T";}
  }
}
#test "a $ name is a type, not an expression or a name" {
  #assert PS_label(53)=="'$' name";
  d:=PS_describe(PS_Token.{kind=53,text="T"});#assert d.open=="'$" && d.word=="T" && d.close=="'";
  tokens:=[3] PS_Token.[PS_Token.{kind=53,text="T",loc=PS_Loc.{line=1,column=3,offset=2}},PS_Token.{},PS_Token.{}];
  nodes:[8] PS_Node;state:[1] PS_State;message:[256] u8;
  id:=PS_expression(tokens[..],nodes[..],state[..],message[..]);
  #assert id==0 && state[0].code=="E0205" && state[0].loc.column==3 && cast(string)message[0..<state[0].length]=="expected an expression, found '$' name";
  state[0]=PS_State.{};name:=PS_ident(tokens[..],state[..],message[..],"a parameter name");
  #assert name.kind==0 && state[0].code=="E0208" && cast(string)message[0..<state[0].length]=="expected a parameter name, found '$T'";
}
#test "a generic procedure signature parses its $ parameters in place" {
  // f :: (a: [] $T, b: $T) -> $T {}
  tokens:=[18] PS_Token.[PS_Token.{kind=1,text="f"},PS_Token.{kind=17},PS_Token.{kind=8},PS_Token.{kind=1,text="a"},PS_Token.{kind=16},PS_Token.{kind=12},PS_Token.{kind=13},PS_Token.{kind=53,text="T",loc=PS_Loc.{line=1,column=13,offset=12}},
    PS_Token.{kind=14},PS_Token.{kind=1,text="b"},PS_Token.{kind=16},PS_Token.{kind=53,text="T",loc=PS_Loc.{line=1,column=20,offset=19}},PS_Token.{kind=9},PS_Token.{kind=19},PS_Token.{kind=53,text="T",loc=PS_Loc.{line=1,column=26,offset=25}},PS_Token.{kind=10},PS_Token.{kind=11},PS_Token.{}];
  nodes:[40] PS_Node;state:[1] PS_State;message:[256] u8;
  r:=PS_parse("",tokens[..],nodes[..],state[..],message[..]);#assert r.ok;
  proc:=nodes[nodes[r.root].head];#assert proc.kind==PS_Tag.decl_proc && nodes[proc.a].kind==PS_Tag.type_param && nodes[proc.a].loc.column==26;
  a:=nodes[proc.head];b:=nodes[a.next];
  #assert nodes[a.a].kind==PS_Tag.type_view && nodes[nodes[a.a].b].kind==PS_Tag.type_param && nodes[nodes[a.a].b].loc.column==13;
  #assert nodes[b.a].kind==PS_Tag.type_param && nodes[b.a].name=="T" && nodes[b.a].loc.column==20;
}
#forall "a type is one name or one alias-qualified name" variant:0..<5 {
  tokens:=[7] PS_Token.[PS_Token.{kind=1,text="hud",loc=PS_Loc.{line=2,column=5,offset=9}},PS_Token.{kind=20},PS_Token.{kind=1,text="V"},PS_Token.{kind=15},PS_Token.{},PS_Token.{},PS_Token.{}];
  if variant==1 {tokens[2].kind=10;}
  if variant==2 {tokens[3]=PS_Token.{kind=20};tokens[4]=PS_Token.{kind=1,text="W"};}
  if variant==3 {tokens[0].kind=2;}
  if variant==4 {tokens[3]=PS_Token.{kind=20};tokens[4]=PS_Token.{kind=10};}
  nodes:[8] PS_Node;state:[1] PS_State;message:[256] u8;
  id:=PS_type(tokens[..],nodes[..],state[..],message[..]);
  if variant==0 || variant==4 {#assert id==1 && state[0].code=="" && nodes[1].name=="V" && nodes[1].name2=="hud" && state[0].pos==3 && nodes[1].kind==PS_Tag.type_named;}
  if variant==1 || variant==3 {#assert id==1 && nodes[1].name=="hud" && nodes[1].name2=="" && state[0].pos==1;}
  if variant==2 {#assert id==0 && state[0].code=="E0222" && state[0].loc.line==2 && state[0].loc.column==5 && state[0].fix=="load that module here with its own alias";
    #assert cast(string)message[0..<state[0].length]=="a qualified name takes one module alias; aliases are not reexported";}
}
#forall "postfix: an alias-qualified call or struct literal, one alias deep" variant:0..<6 {
  // hud.f(1) / hud.V.{} ; variants 2..3 reach through two names, 4..5 are plain fields
  tokens:=[9] PS_Token.[PS_Token.{kind=20},PS_Token.{kind=1,text="f"},PS_Token.{kind=8},PS_Token.{kind=3,value=1},PS_Token.{kind=9},PS_Token.{kind=15},PS_Token.{},PS_Token.{},PS_Token.{}];
  if variant==1 || variant==3 {tokens[1].text="V";tokens[2]=PS_Token.{kind=20};tokens[3]=PS_Token.{kind=10};tokens[4]=PS_Token.{kind=11};}
  if variant==4 {tokens[2]=PS_Token.{kind=15};}
  if variant==5 {tokens[2]=PS_Token.{kind=20};tokens[3]=PS_Token.{kind=1,text="g"};tokens[4]=PS_Token.{kind=15};}
  nodes:[16] PS_Node;nodes[1]=PS_Node.{kind=PS_Tag.expr_ident,name="hud",loc=PS_Loc.{line=3,column=2,offset=20}};used:=1;
  if variant==2 || variant==3 {nodes[2]=PS_Node.{kind=PS_Tag.expr_field,name="mid",a=1,loc=PS_Loc.{line=3,column=5,offset=23}};used=2;}
  state:=[1] PS_State.[PS_State.{used=used}];message:[256] u8;
  r:=PS_postfix(tokens[..],nodes[..],state[..],message[..],used);
  if variant==0 {e:=nodes[r];#assert r==2 && e.kind==PS_Tag.expr_call && e.name=="f" && e.name2=="hud" && e.a==0 && e.loc.line==3 && e.loc.column==2 && e.loc.offset==20;
    #assert nodes[e.head].kind==PS_Tag.expr_int_lit && nodes[e.head].value==1 && state[0].pos==5;}
  if variant==1 {lit:=nodes[r];ty:=nodes[lit.d];#assert lit.kind==PS_Tag.expr_struct_lit && ty.kind==PS_Tag.type_named && ty.name=="V" && ty.name2=="hud";
    #assert lit.loc.column==2 && ty.loc.column==2 && ty.loc.offset==20 && state[0].pos==5;}
  if variant==2 || variant==3 {#assert r==0 && state[0].code=="E0222" && state[0].loc.column==2 && state[0].loc.offset==20;}
  if variant==4 {#assert r==2 && nodes[2].kind==PS_Tag.expr_field && nodes[2].name=="f" && nodes[2].name2=="" && state[0].pos==2;}
  if variant==5 {#assert r==3 && nodes[3].kind==PS_Tag.expr_field && nodes[3].a==2 && nodes[3].name=="g" && state[0].pos==4;}
}
#test "a field may be written #flat or #depth, and no other note" {
  // { a:f32 #flat; b:f32; }
  tokens:=[11] PS_Token.[PS_Token.{kind=10},PS_Token.{kind=1,text="a"},PS_Token.{kind=16},PS_Token.{kind=1,text="f32"},PS_Token.{kind=6,text="flat"},PS_Token.{kind=15},
    PS_Token.{kind=1,text="b"},PS_Token.{kind=16},PS_Token.{kind=1,text="f32"},PS_Token.{kind=15},PS_Token.{kind=11}];
  nodes:[32] PS_Node;nodes[1]=PS_Node.{kind=PS_Tag.decl_struct_};state:=[1] PS_State.[PS_State.{used=2}];message:[256] u8;
  PS_field_block(tokens[..],nodes[..],state[..],message[..],1);
  f:=nodes[1].head;g:=nodes[f].next;
  #assert state[0].code=="" && nodes[f].name=="a" && nodes[f].flag && !nodes[f].flag2 && nodes[g].name=="b" && !nodes[g].flag && !nodes[g].flag2;
  tokens[4]=PS_Token.{kind=6,text="depth"};state[0]=PS_State.{used=2};nodes[1].head=0;
  PS_field_block(tokens[..],nodes[..],state[..],message[..],1);
  f=nodes[1].head;
  #assert state[0].code=="" && nodes[f].flag2 && !nodes[f].flag;
  tokens[4]=PS_Token.{kind=6,text="packed",loc=PS_Loc.{column=9}};state[0]=PS_State.{used=2};nodes[1].head=0;
  PS_field_block(tokens[..],nodes[..],state[..],message[..],1);
  #assert state[0].code=="E0210" && state[0].loc.column==9 && cast(string)message[0..<state[0].length]=="#packed is not supported on fields";
}
#test "an unqualified struct literal keeps its name and position" {
  tokens:=[4] PS_Token.[PS_Token.{kind=20},PS_Token.{kind=10},PS_Token.{kind=11},PS_Token.{}];nodes:[8] PS_Node;
  nodes[1]=PS_Node.{kind=PS_Tag.expr_ident,name="P",loc=PS_Loc.{column=4}};state:=[1] PS_State.[PS_State.{used=1}];message:[64] u8;
  r:=PS_postfix(tokens[..],nodes[..],state[..],message[..],1);
  #assert nodes[r].kind==PS_Tag.expr_struct_lit && nodes[nodes[r].d].name=="P" && nodes[nodes[r].d].name2=="" && nodes[r].loc.column==4;
  tokens[0]=PS_Token.{kind=8};state[0]=PS_State.{used=1};#assert PS_postfix(tokens[..],nodes[..],state[..],message[..],1)==1 && state[0].pos==0;
  // an index of a field is not a name: x.y[0].{}
  tokens[0]=PS_Token.{kind=20};nodes[2]=PS_Node.{kind=PS_Tag.expr_field,a=1};nodes[3]=PS_Node.{kind=PS_Tag.expr_index,a=2};state[0]=PS_State.{used=3};
  #assert PS_postfix(tokens[..],nodes[..],state[..],message[..],3)==0 && state[0].code=="E0215";
}
#test "postfix rejects a non-name struct and a closed range directly" {
  tokens:=[5] PS_Token.[PS_Token.{kind=20},PS_Token.{kind=10},PS_Token.{kind=11},PS_Token.{},PS_Token.{}];nodes:[32] PS_Node;nodes[1]=PS_Node.{kind=PS_Tag.expr_int_lit};state:=[1] PS_State.[PS_State.{used=1}];message:[256] u8;
  #assert PS_postfix(tokens[..],nodes[..],state[..],message[..],1)==0 && state[0].code=="E0215";
  tokens[0].kind=12;tokens[1].kind=3;tokens[2].kind=21;tokens[3].kind=13;nodes[1].kind=PS_Tag.expr_ident;state[0]=PS_State.{used=1};
  #assert PS_postfix(tokens[..],nodes[..],state[..],message[..],1)==0 && state[0].code=="E0216";
}
#test "raw spelling determines the semicolon location after an escaped string" {
  tokens:=[4] PS_Token.[PS_Token.{kind=1,text="x",raw_count=1},PS_Token.{kind=17,raw_count=2},PS_Token.{kind=5,text="a\0b",raw_count=6,loc=PS_Loc.{line=1,column=6,offset=5}},PS_Token.{}];nodes:[16] PS_Node;state:[1] PS_State;message:[256] u8;
  r:=PS_parse("x :: \"a\\0b\"",tokens[..],nodes[..],state[..],message[..]);#assert !r.ok && state[0].loc.column==12 && state[0].loc.offset==11;
}

