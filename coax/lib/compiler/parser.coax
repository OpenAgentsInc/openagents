#test "proto import admission 2" {
  tokens:=[12] PS_Token.[
    PS_Token.{kind=1,text="f",raw_count=1,loc=PS_Loc.{line=1,column=1,offset=0}},
    PS_Token.{kind=17,text="::",raw_count=2,loc=PS_Loc.{line=1,column=3,offset=2}},
    PS_Token.{kind=8,text="(",raw_count=1,loc=PS_Loc.{line=1,column=6,offset=5}},
