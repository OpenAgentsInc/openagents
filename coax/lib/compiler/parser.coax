 if qualified>0 {tokens[4].text="State";tokens[5].kind=20;tokens[6].text="ready";tokens[7].kind=10;tokens[8].kind=11;tokens[9].kind=11;tokens[10].kind=0;}
 if qualified==2 {tokens[4].text="module";tokens[6].text="State";tokens[7].kind=20;tokens[8]=PS_Token.{kind=1,text="ready"};tokens[9].kind=10;tokens[10].kind=11;tokens[11].kind=11;}
 nodes:[64]PS_Node;state:[1]PS_State;message:[256]u8;r:=PS_stmt(tokens[..],nodes[..],state[..],message[..]);#assert state[0].code=="" && cast(u32)nodes[r].kind==53 && nodes[nodes[r].a].name=="value";
 c:=nodes[r].head;#assert cast(u32)nodes[c].kind==79 && nodes[c].next==0 && nodes[r].tail==c && nodes[nodes[c].b].kind==PS_Tag.stmt_block;
 if qualified==0 {#assert state[0].pos==11;#assert nodes[c].name=="ok" && nodes[c].d==0 && cast(u32)nodes[nodes[c].a].kind==81 && nodes[nodes[c].a].name=="payload" && nodes[c].loc2.column==11;}
 else {#assert state[0].pos==(ifx qualified==1 then 10 else 12);p:=nodes[c].d;#assert nodes[c].name=="" && nodes[c].a==0 && nodes[p].kind==PS_Tag.expr_field && nodes[p].name=="ready";if qualified==2 {#assert nodes[nodes[p].a].kind==PS_Tag.expr_field && nodes[nodes[nodes[p].a].a].name=="module";}}
}
