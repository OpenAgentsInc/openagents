    PS_Token.{kind=1,text="S",raw_count=1,loc=PS_Loc.{line=2,column=1,offset=15}},PS_Token.{kind=17,raw_count=2,loc=PS_Loc.{line=2,column=3,offset=17}},
    PS_Token.{kind=2,text="struct",raw_count=6,loc=PS_Loc.{line=2,column=6,offset=20}},PS_Token.{kind=10,raw_count=1,loc=PS_Loc.{line=2,column=13,offset=27}},
    PS_Token.{kind=1,text="a",raw_count=1,loc=PS_Loc.{line=2,column=14,offset=28}},PS_Token.{kind=16,raw_count=1,loc=PS_Loc.{line=2,column=15,offset=29}},
    PS_Token.{kind=1,text="int",raw_count=3,loc=PS_Loc.{line=2,column=16,offset=30}},PS_Token.{kind=15,raw_count=1,loc=PS_Loc.{line=2,column=19,offset=33}},
