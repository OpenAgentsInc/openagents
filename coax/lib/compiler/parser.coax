}

#test "R2 qualified nested typed literals preserve alias type and length arguments" {
 tokens:=[20]PS_Token.[PS_Token.{kind=1,text="module"},PS_Token.{kind=20},PS_Token.{kind=1,text="Pair"},PS_Token.{kind=8},PS_Token.{kind=1,text="Result"},PS_Token.{kind=8},PS_Token.{kind=1,text="int"},PS_Token.{kind=14},PS_Token.{kind=1,text="Error"},PS_Token.{kind=9},PS_Token.{kind=14},PS_Token.{kind=3,value=4},PS_Token.{kind=9},PS_Token.{kind=20},PS_Token.{kind=10},PS_Token.{kind=1,text="item"},PS_Token.{kind=23},PS_Token.{kind=3,value=8},PS_Token.{kind=11},PS_Token.{}];
 nodes:[64]PS_Node;state:[1]PS_State;message:[256]u8;#assert PS_typed_literal(tokens[..],state[..]) && state[0].pos==0;
 r:=PS_expression(tokens[..],nodes[..],state[..],message[..]);#assert state[0].code=="" && state[0].pos==19 && nodes[r].kind==PS_Tag.expr_struct_lit;
 ty:=nodes[r].d;a:=nodes[ty].head;#assert nodes[ty].name=="Pair" && nodes[ty].name2=="module" && nodes[a].name=="Result" && nodes[nodes[a].head].name=="int" && nodes[nodes[nodes[a].head].next].name=="Error" && nodes[nodes[a].next].value==4;
 #assert nodes[nodes[nodes[r].head].a].value==8;
}
#forall "R2 typed-literal lookahead requires both delimiters after the outer argument list" mode:0..<6 {
 tokens:=[10]PS_Token.[PS_Token.{kind=1,text="Box"},PS_Token.{kind=8},PS_Token.{kind=1,text="int"},PS_Token.{kind=9},PS_Token.{kind=20},PS_Token.{kind=10},PS_Token.{kind=11},PS_Token.{},PS_Token.{},PS_Token.{}];
 if mode==1 {tokens[4].kind=21;}
 if mode==2 {tokens[5].kind=1;}
 if mode==3 {tokens[3].kind=0;}
 if mode==4 {tokens[1].kind=20;tokens[2].kind=3;}
 if mode==5 {tokens[1].kind=20;tokens[2].kind=3;tokens[3].kind=8;tokens[4]=PS_Token.{kind=1,text="int"};tokens[5].kind=9;tokens[6].kind=20;tokens[7].kind=10;tokens[8].kind=11;}
 state:[1]PS_State;#assert PS_typed_literal(tokens[..],state[..])==(mode==0) && state[0].pos==0;
 if mode==5 {nodes:[32]PS_Node;message:[256]u8;r:=PS_expression(tokens[..],nodes[..],state[..],message[..]);#assert state[0].code=="" && state[0].pos==1 && nodes[r].kind==PS_Tag.expr_ident && nodes[r].name=="Box";}
}
#test "R2 unit literals permit one trailing comma without inventing a payload" {
 tokens:=[7]PS_Token.[PS_Token.{kind=1,text="Reply"},PS_Token.{kind=20},PS_Token.{kind=10},PS_Token.{kind=1,text="done"},PS_Token.{kind=14},PS_Token.{kind=11},PS_Token.{}];
 nodes:[32]PS_Node;state:[1]PS_State;message:[256]u8;r:=PS_expression(tokens[..],nodes[..],state[..],message[..]);#assert r!=0 && state[0].code=="" && state[0].pos==6 && nodes[nodes[r].head].name=="done" && nodes[nodes[r].head].a==0 && nodes[nodes[r].head].next==0;
}
#test "R2 overqualified switch patterns are rejected at their original name" {
 tokens:=[15]PS_Token.[PS_Token.{kind=2,text="switch"},PS_Token.{kind=1,text="v"},PS_Token.{kind=10},PS_Token.{kind=2,text="case"},PS_Token.{kind=1,text="a",loc=PS_Loc.{line=3,column=8,offset=40}},PS_Token.{kind=20},PS_Token.{kind=1,text="b"},PS_Token.{kind=20},PS_Token.{kind=1,text="c"},PS_Token.{kind=20},PS_Token.{kind=1,text="d"},PS_Token.{kind=10},PS_Token.{kind=11},PS_Token.{kind=11},PS_Token.{}];
 nodes:[64]PS_Node;state:[1]PS_State;message:[256]u8;r:=PS_switch(tokens[..],nodes[..],state[..],message[..]);
 #assert r==0 && state[0].code=="E0222" && state[0].loc.line==3 && state[0].loc.column==8 && state[0].loc.offset==40 && state[0].depth==0;
}
#forall "R2 new grammar entries refuse exhausted depth with null results" entry:0..<3 {
 tokens:=[4]PS_Token.[PS_Token.{kind=1,text="T",loc=PS_Loc.{line=8,column=3,offset=20}},PS_Token.{kind=20},PS_Token.{kind=1,text="x"},PS_Token.{}];
 nodes:[32]PS_Node;state:=[1]PS_State.[PS_State.{depth=128}];message:[256]u8;r:=0;
 if entry==0 {r=PS_type(tokens[..],nodes[..],state[..],message[..]);}
 if entry==1 {r=PS_switch(tokens[..],nodes[..],state[..],message[..]);}
 if entry==2 {r=PS_expression(tokens[..],nodes[..],state[..],message[..]);}
 #assert r==0 && state[0].code=="E0221" && state[0].loc.offset==20 && state[0].depth==128;
}
#test "R2 fallback recursion respects the remaining parser nesting budget" {
 tokens:[13]PS_Token;for i:0..<6 {tokens[i*2]=PS_Token.{kind=1,text="v"};tokens[i*2+1]=PS_Token.{kind=2,text="or_else"};}tokens[11]=PS_Token.{kind=1,text="last"};
 nodes:[64]PS_Node;state:=[1]PS_State.[PS_State.{depth=124}];message:[256]u8;r:=PS_expression(tokens[..],nodes[..],state[..],message[..]);#assert r==0 && state[0].code=="E0221" && state[0].depth==124;
}
