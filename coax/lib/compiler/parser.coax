 nodes:[16]PS_Node;state:[1]PS_State;out:[256]u8;
 PS_field_block(tokens[..],nodes[..],state[..],out[..],0);
 #assert state[0].code=="E0208";
}

#forall "inactive node clearing preserves exact prefix and suffix sentinels" first:0..<8,end:0..<8 {
 if first<=end {
  nodes:[8]PS_Node;for i:0..<8 {nodes[i]=PS_Node.{kind=PS_Tag.expr_ident,name="sentinel",a=9,b=10,c=11,d=12,head=13,tail=14,next=15,value=16,width=32,flag=true};}
  PS_discard_range(nodes[..],first,end);
  for i:0..<8 {
   if i>=first && i<end {#assert nodes[i].kind==PS_Tag.invalid && nodes[i].name=="" && nodes[i].a==0 && nodes[i].b==0 && nodes[i].c==0 && nodes[i].d==0 && nodes[i].head==0 && nodes[i].tail==0 && nodes[i].next==0 && nodes[i].value==0 && nodes[i].width==0 && !nodes[i].flag;}
   else {#assert nodes[i].kind==PS_Tag.expr_ident && nodes[i].name=="sentinel" && nodes[i].a==9 && nodes[i].next==15 && nodes[i].value==16;}
  }
 }
}
#test "inactive statement ranges preserve every caller prefix node and directive location" {
 tokens:=[5]PS_Token.[PS_Token.{kind=6,text="if",loc=PS_Loc.{line=9,column=3,offset=17}},PS_Token.{kind=1,text="BUILD_DEBUG"},PS_Token.{kind=10},PS_Token.{kind=11},PS_Token.{}];
 nodes:[16]PS_Node;nodes[1]=PS_Node.{kind=PS_Tag.decl_file,name="parent"};nodes[2]=PS_Node.{kind=PS_Tag.stmt_block,name="prior"};
 state:=[1]PS_State.[PS_State.{used=2}];out:[256]u8;id:=PS_profile_stmt(tokens[..],nodes[..],state[..],out[..]);
 #assert state[0].code=="" && id==4 && nodes[id].kind==PS_Tag.stmt_block && nodes[id].loc.line==9 && nodes[id].loc.column==3 && nodes[id].loc.offset==17;
 #assert nodes[1].kind==PS_Tag.decl_file && nodes[1].name=="parent" && nodes[2].kind==PS_Tag.stmt_block && nodes[2].name=="prior";
}

