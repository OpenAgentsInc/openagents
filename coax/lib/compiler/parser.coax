    PS_Token.{kind=10,text="{",raw_count=1,loc=PS_Loc.{line=1,column=6,offset=5}},
    PS_Token.{kind=11,text="}",raw_count=1,loc=PS_Loc.{line=1,column=7,offset=6}},
    PS_Token.{kind=0,text="",raw_count=0,loc=PS_Loc.{line=1,column=8,offset=7}}];
  nodes:[128] PS_Node;state:[1] PS_State;message:[1024] u8;
  value:=PS_enum(tokens[..],nodes[..],state[..],message[..],PS_Token.{text="name"});
  #assert value==0 && state[0].code=="E0219";
}

