#load "result-flow.coax";
// Structured direct-Result obligations, after ordinary typing/specialization.
// There are no runtime ownership flags and no native handling inference.
#authority;
#test "R2 mutation handling collects Result locals from both conditional arms" {
 nodes:[20]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;ck:=[1]CK_State.[CK_State.{used=19,type_count=17}];words:[16]int;rs:[1]RF_State;cs:[1]CF_State;
 types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};
 f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],count=2,state=rs[..]},state=cs[..]};#assert RF_init(f.flow);
 nodes[2]=CK_Node.{kind=CK_Tag.stmt_if,c=3,d=4};nodes[3]=CK_Node.{kind=CK_Tag.stmt_block,head=8};nodes[4]=CK_Node.{kind=CK_Tag.stmt_block,head=12};
 nodes[8]=CK_Node.{kind=CK_Tag.stmt_var,type=16};nodes[12]=nodes[8];
 CF_collect(f,2,0);
 #assert cs[0].collected==2 && words[0]==8 && words[3]==12 && words[2]==1 && words[5]==1;
 #assert ck[0].depth==0 && ck[0].error_count==0 && rs[0].reason==RF_Reason.ok;
}
#forall "R2 mutation handling neutral choices retire their temporary snapshots" statement:bool {
 nodes:[4]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;ck:=[1]CK_State.[CK_State.{used=3,type_count=17}];words:[5]int;rs:[1]RF_State;cs:[1]CF_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],count=1,state=rs[..]},state=cs[..]};
 #assert RF_init(f.flow) && RF_register(f.flow,0,3,0) && RF_set(f.flow,0,1);
 for i:0..<3 {CF_choice(f,0,0,ifx statement then CF_Mode.statement else CF_Mode.read,CK_Loc.{});#assert CF_ok(f) && rs[0].top==3 && RF_get(f.flow,0)==1 && cs[0].alive;}
}
#forall "R2 handling transfers discharge exactly once and continuing branches agree" mode:0..<6 {
 nodes:[32]CK_Node;types:[24]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[1024]u8;work:[256]int;state:=[1]CK_State.[CK_State.{used=25,type_count=17}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..],result_work=work[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};
 nodes[2]=CK_Node.{kind=CK_Tag.proc,name="f",type=16,head=3,b=4};nodes[3]=CK_Node.{kind=CK_Tag.param,name="r",type=16};nodes[4]=CK_Node.{kind=CK_Tag.stmt_block,head=5};nodes[5]=CK_Node.{kind=CK_Tag.stmt_return,a=6,loc=CK_Loc.{line=10,column=3}};nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3,loc=CK_Loc.{line=10,column=10}};
 if mode==1 {nodes[5].a=0;nodes[2].type=1;}if mode==2 {nodes[5].kind=CK_Tag.stmt_expr;}
 if mode==3 {nodes[5]=CK_Node.{kind=CK_Tag.stmt_var,type=16,a=6,next=7};nodes[7]=CK_Node.{kind=CK_Tag.stmt_return,a=8};nodes[8]=nodes[6];}
 if mode>=4 {
  nodes[2].type=1;nodes[5]=CK_Node.{kind=CK_Tag.stmt_if,a=6,c=7,next=20,loc=CK_Loc.{line=8,column=3}};nodes[6]=CK_Node.{kind=CK_Tag.expr_bool,type=2};nodes[7]=CK_Node.{kind=CK_Tag.stmt_block,head=8};nodes[8]=CK_Node.{kind=CK_Tag.stmt_var,type=11,a=9};nodes[9]=CK_Node.{kind=CK_Tag.expr_or_else,type=11,a=10,b=11};nodes[10]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[11]=CK_Node.{kind=CK_Tag.expr_int,type=11};nodes[20]=CK_Node.{kind=CK_Tag.stmt_return,loc=CK_Loc.{line=10,column=3}};
  if mode==5 {nodes[5].d=12;nodes[12]=CK_Node.{kind=CK_Tag.stmt_block,head=13};nodes[13]=CK_Node.{kind=CK_Tag.stmt_var,type=11,a=14};nodes[14]=nodes[9];nodes[14].a=15;nodes[15]=nodes[10];}
 }
 CK_result_proc(c,2);if mode==0 || mode==5 {#assert state[0].error_count==0 && !state[0].fatal;}
 else {want:="E0907";if mode==3 {want="E0908";}if mode==4 {want="E0909";}#assert state[0].error_count==1 && errors[0].code==want;if mode==4 {#assert errors[0].loc.line==10;}}
}
#forall "R2 handling observes implicit failure before pending argument transfer commits" mode:0..<3 {
 nodes:[24]CK_Node;types:[24]CK_Type;locals:[2]CK_Local;errors:[8]CK_Error;bytes:[512]u8;work:[128]int;state:=[1]CK_State.[CK_State.{used=20,type_count=17}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..],result_work=work[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};
 nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,head=3,b=4};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16};nodes[4]=CK_Node.{kind=CK_Tag.stmt_block,head=5};nodes[5]=CK_Node.{kind=CK_Tag.stmt_var,type=11,a=6,next=12};nodes[6]=CK_Node.{kind=CK_Tag.expr_try,type=11,a=7,propagate_type=16,loc=CK_Loc.{line=20,column=9}};nodes[7]=CK_Node.{kind=CK_Tag.expr_call,type=16};nodes[12]=CK_Node.{kind=CK_Tag.stmt_return,a=13};nodes[13]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};
 if mode==1 {nodes[5].a=8;nodes[8]=CK_Node.{kind=CK_Tag.expr_call,type=11,head=9,proc=14};nodes[14]=CK_Node.{kind=CK_Tag.proc,type=11,head=15};nodes[15]=CK_Node.{kind=CK_Tag.param,type=16,next=16};nodes[16]=CK_Node.{kind=CK_Tag.param,type=11};nodes[9]=nodes[13];nodes[9].next=6;}
 if mode==2 {nodes[2].head=0;nodes[13]=nodes[7];}
 CK_result_proc(c,2);if mode==2 {#assert state[0].error_count==0;}else {#assert state[0].error_count==1 && errors[0].code=="E0907" && errors[0].loc.line==20;}
}
CF_State :: struct {depth:int;loop_scope:int;defer_scope:int;arguments:bool;collected:int;alive:bool=true;}
#forall "R2 mutation handling short circuit reads preserve conditional transfers" op:50..<52 {
 nodes:[16]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;ck:=[1]CK_State.[CK_State.{used=15,type_count=17}];words:[16]int;rs:[1]RF_State;cs:[1]CF_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=2,sum_error=12};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],count=1,state=rs[..]},state=cs[..]};
 #assert RF_init(f.flow) && RF_register(f.flow,0,3,0) && RF_set(f.flow,0,1);
 nodes[5]=CK_Node.{kind=CK_Tag.expr_binary,type=2,op=cast(u32)op,a=6,b=7,loc=CK_Loc.{line=61,column=7}};nodes[6]=CK_Node.{kind=CK_Tag.expr_bool,type=2};
 nodes[7]=CK_Node.{kind=CK_Tag.expr_or_else,type=2,a=8,b=9};nodes[8]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[9]=nodes[6];
 CF_expr(f,5,false);#assert ck[0].error_count==1 && errors[0].code=="E0909" && errors[0].loc.line==61 && ck[0].depth==0;
}
#forall "R2 mutation handling refuses statement work and depth before body effects" depth:bool {
 nodes:[8]CK_Node;types:[16]CK_Type;errors:[4]CK_Error;ck:=[1]CK_State.[CK_State.{used=7,type_count=16}];words:[4]int;rs:[1]RF_State;cs:[1]CF_State;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],state=rs[..]},state=cs[..]};#assert RF_init(f.flow);
 nodes[5]=CK_Node.{kind=CK_Tag.stmt_return,loc=CK_Loc.{line=71,column=9}};
 if depth {ck[0].depth=256;}else {rs[0].work=1048576;}
 CF_stmt(f,5);#assert cs[0].alive;
 if depth {#assert ck[0].depth==256 && ck[0].fatal && ck[0].error_count==1 && errors[0].code=="E0381";}
 else {#assert ck[0].depth==0 && !ck[0].fatal && ck[0].error_count==0 && rs[0].reason==RF_Reason.work;}
}
CF_Context :: struct {c:CK_Context;flow:RF_Context;state:[]CF_State;}
