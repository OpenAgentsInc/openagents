 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],count=1,state=rs[..]},state=cs[..]};
 #assert RF_init(f.flow) && RF_register(f.flow,0,3,0) && RF_set(f.flow,0,1);
 nodes[5]=CK_Node.{kind=CK_Tag.stmt_defer,c=6};nodes[6]=CK_Node.{kind=CK_Tag.stmt_block,head=7};nodes[7]=CK_Node.{kind=CK_Tag.stmt_expr,a=8};nodes[8]=CK_Node.{kind=CK_Tag.expr_or_else,type=11,a=9,b=10};
 nodes[9]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3,loc=CK_Loc.{line=82,column=11}};nodes[10]=CK_Node.{kind=CK_Tag.expr_int,type=11};
 CF_stmt(f,5);#assert ck[0].error_count==1 && errors[0].code=="E0909" && errors[0].loc.line==82;
 #assert cs[0].depth==0 && cs[0].defer_scope==0 && ck[0].depth==0;
}
