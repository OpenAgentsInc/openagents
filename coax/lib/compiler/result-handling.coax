 nodes:[8]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;ck:=[1]CK_State.[CK_State.{used=7,type_count=17}];words:[8]int;rs:[1]RF_State;cs:[1]CF_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],count=1,state=rs[..]},state=cs[..]};
 nodes[3]=CK_Node.{kind=CK_Tag.param,type=16};nodes[5]=CK_Node.{kind=CK_Tag.stmt_var,type=11,a=6};nodes[6]=CK_Node.{kind=CK_Tag.expr_int,type=11};#assert RF_init(f.flow) && RF_register(f.flow,0,3,0) && RF_set(f.flow,0,1);rs[0].work=1048574;
