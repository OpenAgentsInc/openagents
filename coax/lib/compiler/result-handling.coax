#test "R2 handling part02 a terminal conditional disagreement reports the conditional site" {
 nodes:[16]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;ck:=[1]CK_State.[CK_State.{used=15,type_count=17}];words:[16]int;rs:[1]RF_State;cs:[1]CF_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],count=1,state=rs[..]},state=cs[..]};
 #assert RF_init(f.flow) && RF_register(f.flow,0,3,0) && RF_set(f.flow,0,1);nodes[3]=CK_Node.{kind=CK_Tag.param,type=16};nodes[5]=CK_Node.{kind=CK_Tag.stmt_if,a=6,c=7,loc=CK_Loc.{line=91,column=7,offset=9107}};nodes[6]=CK_Node.{kind=CK_Tag.expr_bool,type=2};nodes[7]=CK_Node.{kind=CK_Tag.stmt_block,head=8};nodes[8]=CK_Node.{kind=CK_Tag.stmt_var,type=11,a=9};nodes[9]=CK_Node.{kind=CK_Tag.expr_or_else,type=11,a=10,b=11};nodes[10]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[11]=CK_Node.{kind=CK_Tag.expr_int,type=11};
 CF_stmt(f,5);#assert !ck[0].fatal && ck[0].error_count==1 && errors[0].code=="E0909" && errors[0].loc.line==91 && errors[0].loc.column==7 && errors[0].loc.offset==9107 && ck[0].depth==0;
}
#forall "R2 handling part02 a Result-free switch pays for restoring its continuing state" allowance:7..<9 {
 nodes:[12]CK_Node;types:[18]CK_Type;errors:[4]CK_Error;ck:=[1]CK_State.[CK_State.{used=11,type_count=18}];words:[8]int;rs:[1]RF_State;cs:[1]CF_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};types[17]=CK_Type.{kind=CK_Kind.enum_,name="Only",decl=2,elem=12,size=1,bits=8};nodes[2]=CK_Node.{kind=CK_Tag.enum_,name="Only",type=17,head=3,mark=2};nodes[3]=CK_Node.{kind=CK_Tag.member,name="only",type=17};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],state=rs[..]},state=cs[..]};#assert RF_init(f.flow);rs[0].work=1048576-allowance;
 nodes[5]=CK_Node.{kind=CK_Tag.stmt_switch,a=6,head=7};nodes[6]=CK_Node.{kind=CK_Tag.expr_enum,type=17};nodes[7]=CK_Node.{kind=CK_Tag.switch_case,d=9,b=8};nodes[8]=CK_Node.{kind=CK_Tag.stmt_block};nodes[9]=nodes[6];
 CF_stmt(f,5);#assert CF_ok(f)==(allowance>=8) && !ck[0].fatal && ck[0].error_count==0 && ck[0].depth==0;if allowance==7 {#assert rs[0].reason==RF_Reason.work;}
}
#test "R2 handling part02 harmless range headers do not bypass outer Result capture refusal" {
 nodes:[16]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;ck:=[1]CK_State.[CK_State.{used=15,type_count=17}];words:[24]int;rs:[1]RF_State;cs:[1]CF_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],count=1,state=rs[..]},state=cs[..]};#assert RF_init(f.flow) && RF_register(f.flow,0,3,0) && RF_set(f.flow,0,1);
 nodes[3]=CK_Node.{kind=CK_Tag.param,type=16};nodes[5]=CK_Node.{kind=CK_Tag.stmt_range,a=6,b=7,c=8};nodes[6]=CK_Node.{kind=CK_Tag.expr_int,type=11};nodes[7]=nodes[6];nodes[8]=CK_Node.{kind=CK_Tag.stmt_block,head=9};nodes[9]=CK_Node.{kind=CK_Tag.stmt_expr,a=10};nodes[10]=CK_Node.{kind=CK_Tag.expr_or_else,type=11,a=11,b=12};nodes[11]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3,loc=CK_Loc.{line=93,column=13}};nodes[12]=nodes[6];
 CF_stmt(f,5);#assert !ck[0].fatal && ck[0].error_count==1 && errors[0].code=="E0909" && errors[0].loc.line==93 && errors[0].loc.column==13 && ck[0].depth==0;
}
CF_result :: (c:CK_Context,t:int)->bool {return c.types[t].kind==CK_Kind.result;}
CF_has_results :: (c:CK_Context)->bool {for i:16..<c.state[0].type_count {if CF_result(c,i) {return true;}}return false;}
CF_ok :: (f:CF_Context)->bool {return !f.c.state[0].fatal && f.c.state[0].error_count==0 && f.flow.state[0].reason==RF_Reason.ok;}
// No flow slots means inventory only; allocated slots enable registration.
CF_collect :: (f:CF_Context,id:int,depth:int) {
 if id==0 {return;}n:=f.c.nodes[id];if !CK_enter(f.c,n.loc) {return;}defer CK_leave(f.c);
 if n.kind==CK_Tag.stmt_var && CF_result(f.c,n.type) {if f.flow.count>0 {ignored:=RF_register(f.flow,f.state[0].collected,id,depth);}f.state[0].collected+=1;}
 if n.kind==CK_Tag.stmt_block {at:=n.head;while at!=0 {CF_collect(f,at,depth+1);at=f.c.nodes[at].next;}}
 else if n.kind==CK_Tag.stmt_if {CF_collect(f,n.c,depth);CF_collect(f,n.d,depth);}
 else if n.kind==CK_Tag.stmt_while || n.kind==CK_Tag.stmt_range || n.kind==CK_Tag.stmt_each || n.kind==CK_Tag.stmt_defer {CF_collect(f,n.c,depth);}
 else if n.kind==CK_Tag.stmt_switch {at:=n.head;while at!=0 {CF_collect(f,f.c.nodes[at].b,depth);at=f.c.nodes[at].next;}}
}
CF_exit :: (f:CF_Context,scope:int,loc:CK_Loc) {
 if !CF_ok(f) {return;}if f.state[0].arguments {CK_error(f.c,loc,"E0907","try would abandon a pending Result argument before the call begins","");return;}
 for i:0..<f.flow.count {if RF_scope(f.flow,i)>=scope && RF_get(f.flow,i)==1 {CK_error(f.c,loc,"E0907","a Result remains pending on this exit","");return;}}
}
CF_join :: (f:CF_Context,base:int,loc:CK_Loc) {if CF_ok(f) && !RF_equal(f.flow,base) {if f.flow.state[0].reason==RF_Reason.ok {CK_error(f.c,loc,"E0909","continuing branches disagree about a Result transfer","");}}}
CF_Mode :: enum u8 {read;transfer;statement;}
CF_visit :: (f:CF_Context,id:int,mode:CF_Mode) {if mode==CF_Mode.statement {CF_stmt(f,id);}else {CF_expr(f,id,mode==CF_Mode.transfer);}}
CF_choice :: (f:CF_Context,a:int,b:int,mode:CF_Mode,loc:CK_Loc) {
 base:=RF_save(f.flow);if base<0 {return;}
 CF_visit(f,a,mode);if !CF_ok(f) {return;}left_alive:=f.state[0].alive;left:=RF_save(f.flow);if left<0 {return;}
 ignored:=RF_restore(f.flow,base);f.state[0].alive=true;
 CF_visit(f,b,mode);if !CF_ok(f) {return;}
 if left_alive && f.state[0].alive {CF_join(f,left,loc);}else if left_alive {ignored=RF_restore(f.flow,left);f.state[0].alive=true;}
 ignored=RF_drop(f.flow,base);
}
// Read positions share one nontransfer policy, including builtin arguments.
CF_read :: (f:CF_Context,id:int) {CF_expr(f,id,false);}
CF_expr :: (f:CF_Context,id:int,consume:bool) {
 if id==0 || !CF_ok(f) {return;}e:=f.c.nodes[id];if !RF_tick(f.flow) || !CK_enter(f.c,e.loc) {return;}defer CK_leave(f.c);
 result:=CF_result(f.c,e.type);
 if e.kind==CK_Tag.expr_ident && result {
  at:=RF_find(f.flow,e.borrow_binding);if at<0 {if CF_ok(f) {CK_error(f.c,e.loc,"E0907","this Result has no transferable local obligation","");}return;}
  current:=RF_get(f.flow,at);if current!=1 {CK_error(f.c,e.loc,"E0908","this Result was already transferred or is not initialized","");return;}
  if (f.state[0].defer_scope>0 && RF_scope(f.flow,at)<f.state[0].defer_scope) || (consume && f.state[0].loop_scope>0 && RF_scope(f.flow,at)<f.state[0].loop_scope) {CK_error(f.c,e.loc,"E0909","an outer Result cannot be captured by defer or consumed inside a loop","");return;}
  if !consume {CK_error(f.c,e.loc,"E0907","naming a Result does not handle its error","");return;}ignored:=RF_set(f.flow,at,2);return;
 }
 if e.kind==CK_Tag.expr_try {CF_expr(f,e.a,true);CF_exit(f,0,e.loc);return;}
 if e.kind==CK_Tag.expr_or_else {CF_expr(f,e.a,true);if CF_ok(f) {CF_choice(f,0,e.b,CF_Mode.read,e.loc);}return;}
 if e.kind==CK_Tag.expr_ifx {CF_read(f,e.a);if CF_ok(f) {CF_choice(f,e.b,e.c,ifx consume then CF_Mode.transfer else CF_Mode.read,e.loc);}return;}
 if e.kind==CK_Tag.expr_binary && (e.op==50 || e.op==51) {CF_read(f,e.a);if CF_ok(f) {CF_choice(f,0,e.b,CF_Mode.read,e.loc);}return;}
 if e.kind==CK_Tag.expr_call {
  saved:=f.state[0].arguments;defer f.state[0].arguments=saved;
  // Node zero is the canonical null procedure, with no formal parameters.
  parameter:=f.c.nodes[e.proc].head;at:=e.head;while at!=0 && CF_ok(f) {transfers:=CF_result(f.c,f.c.nodes[parameter].type);if transfers {CF_expr(f,at,true);f.state[0].arguments=true;}else {CF_read(f,at);}at=f.c.nodes[at].next;parameter=f.c.nodes[parameter].next;}
 }else {CF_read(f,e.a);CF_read(f,e.b);CF_read(f,e.c);at:=e.head;while at!=0 && CF_ok(f) {CF_read(f,at);at=f.c.nodes[at].next;}}
 if result && !consume && CF_ok(f) {CK_error(f.c,e.loc,"E0907","a produced Result must be handled or transferred","");}
}
CF_stmt :: (f:CF_Context,id:int) {
 if id==0 || !f.state[0].alive || !CF_ok(f) {return;}n:=f.c.nodes[id];if !RF_tick(f.flow) || !CK_enter(f.c,n.loc) {return;}defer CK_leave(f.c);
 if n.kind==CK_Tag.stmt_block {
  f.state[0].depth+=1;at:=n.head;while at!=0 && f.state[0].alive && CF_ok(f) {CF_stmt(f,at);at=f.c.nodes[at].next;}
  if f.state[0].alive {CF_exit(f,f.state[0].depth,n.loc);}
  for i:0..<f.flow.count {if RF_scope(f.flow,i)==f.state[0].depth {ignored:=RF_set(f.flow,i,0);}}f.state[0].depth-=1;return;
 }
 if n.kind==CK_Tag.stmt_var {CF_expr(f,n.a,CF_result(f.c,n.type));if CF_result(f.c,n.type) && CF_ok(f) {at:=RF_find(f.flow,id);if at>=0 {ignored:=RF_set(f.flow,at,1);}}return;}
 if n.kind==CK_Tag.stmt_assign {CF_read(f,n.c);CF_read(f,n.a);return;}
 if n.kind==CK_Tag.stmt_return {CF_expr(f,n.a,CF_result(f.c,f.c.nodes[n.a].type));CF_exit(f,0,n.loc);f.state[0].alive=false;return;}
 if n.kind==CK_Tag.stmt_expr || n.kind==CK_Tag.stmt_assert {CF_read(f,n.a);return;}
 if n.kind==CK_Tag.stmt_if {CF_read(f,n.a);if CF_ok(f) {join_loc:=n.loc;if n.next!=0 {join_loc=f.c.nodes[n.next].loc;}CF_choice(f,n.c,n.d,CF_Mode.statement,join_loc);}return;}
 if n.kind==CK_Tag.stmt_switch {
  CF_expr(f,n.a,CF_result(f.c,f.c.nodes[n.a].type));if !CF_ok(f) {return;}base:=RF_save(f.flow);joined:= -1;at:=n.head;
  while at!=0 && CF_ok(f) {ignored:=RF_restore(f.flow,base);f.state[0].alive=true;CF_stmt(f,f.c.nodes[at].b);if f.state[0].alive && CF_ok(f) {if joined<0 {joined=RF_save(f.flow);}else {CF_join(f,joined,n.loc);}}at=f.c.nodes[at].next;}
  f.state[0].alive=joined>=0;if joined>=0 {ignored:=RF_restore(f.flow,joined);}ignored:=RF_drop(f.flow,base);return;
 }
 if n.kind==CK_Tag.stmt_while || n.kind==CK_Tag.stmt_range || n.kind==CK_Tag.stmt_each {
  saved:=f.state[0].loop_scope;if n.kind==CK_Tag.stmt_while {f.state[0].loop_scope=f.state[0].depth+1;}CF_read(f,n.a);CF_read(f,n.b);if n.kind==CK_Tag.stmt_while {f.state[0].loop_scope=saved;}
  if !CF_ok(f) {return;}base:=RF_save(f.flow);f.state[0].loop_scope=f.state[0].depth+1;CF_stmt(f,n.c);f.state[0].loop_scope=saved;
  ignored:=RF_restore(f.flow,base);ignored=RF_drop(f.flow,base);f.state[0].alive=true;return;
 }
 if n.kind==CK_Tag.stmt_break || n.kind==CK_Tag.stmt_continue {CF_exit(f,f.state[0].loop_scope,n.loc);f.state[0].alive=false;return;}
 if n.kind==CK_Tag.stmt_defer {saved:=f.state[0].defer_scope;f.state[0].defer_scope=f.state[0].depth+1;CF_stmt(f,n.c);f.state[0].defer_scope=saved;}
}
CK_result_proc :: (c:CK_Context,proc:int) {
 rs:[1]RF_State;state:[1]CF_State;f:=CF_Context.{c=c,flow=RF_Context.{words=c.result_work,state=rs[..]},state=state[..]};p:=c.nodes[proc];at:=p.head;
 while at!=0 {if CF_result(c,c.nodes[at].type) {state[0].collected+=1;}at=c.nodes[at].next;}CF_collect(f,p.b,0);count:=state[0].collected;f.flow.count=count;
 if !RF_init(f.flow) {CK_resource(c,p.loc);return;}state[0].collected=0;at=p.head;
 while at!=0 {if CF_result(c,c.nodes[at].type) {index:=state[0].collected;ignored:=RF_register(f.flow,index,at,0);ignored=RF_set(f.flow,index,1);state[0].collected+=1;}at=c.nodes[at].next;}
 CF_collect(f,p.b,0);CF_stmt(f,p.b);if state[0].alive {CF_exit(f,0,p.loc);}if rs[0].reason!=RF_Reason.ok && c.state[0].error_count==0 {CK_resource(c,p.loc);}
}
CK_results :: (c:CK_Context) {
 if !CF_has_results(c) {return;}
 at:=c.nodes[1].head;while at!=0 && c.state[0].error_count==0 && !c.state[0].fatal {n:=c.nodes[at];if n.kind==CK_Tag.proc && !n.generic && !n.flag2 {CK_result_proc(c,at);}if n.kind==CK_Tag.check {CK_result_proc(c,n.a);}at=n.next;}
 at=c.state[0].instances;while at!=0 && c.state[0].error_count==0 && !c.state[0].fatal {n:=c.nodes[at];if n.kind==CK_Tag.proc && !n.generic && !n.flag2 {CK_result_proc(c,at);}at=n.chain;}
}
