 nodes[2]=CK_Node.{kind=CK_Tag.stmt_block,head=3};nodes[3]=CK_Node.{kind=CK_Tag.stmt_defer,c=4};nodes[4]=CK_Node.{kind=CK_Tag.stmt_block,head=5};nodes[5]=CK_Node.{kind=CK_Tag.stmt_var,type=16,a=6,next=10};nodes[6]=CK_Node.{kind=CK_Tag.expr_sum,type=16,sum_variant=0,a=7};nodes[7]=CK_Node.{kind=CK_Tag.expr_int,type=11};nodes[8]=CK_Node.{kind=CK_Tag.expr_bool,type=2};nodes[9]=nodes[7];nodes[9].value=1;
 nodes[10]=CK_Node.{kind=CK_Tag.stmt_expr,a=11};nodes[11]=CK_Node.{kind=CK_Tag.expr_or_else,type=11,a=12,b=13};nodes[12]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=5};nodes[13]=nodes[7];nodes[14]=CK_Node.{kind=CK_Tag.expr_array,type=17,head=15};nodes[15]=nodes[7];
 if mode==0 {nodes[3].kind=CK_Tag.stmt_while;nodes[3].a=8;}if mode==1 {nodes[3].kind=CK_Tag.stmt_range;nodes[3].a=7;nodes[3].b=9;}if mode==2 {nodes[3].kind=CK_Tag.stmt_each;nodes[3].a=14;}
 CF_collect(f,2,0);#assert CF_ok(f) && cs[0].collected==1 && RF_find(f.flow,5)==0 && RF_scope(f.flow,0)==2 && ck[0].depth==0;
}
