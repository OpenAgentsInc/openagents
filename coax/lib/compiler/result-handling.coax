#test "R2 coverage3 a refused while condition restores its enclosing loop scope" {
 nodes:[12]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;ck:=[1]CK_State.[CK_State.{used=11,type_count=17}];words:[16]int;rs:[1]RF_State;cs:=[1]CF_State.[CF_State.{depth=1,loop_scope=1}];
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=2,sum_error=12};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],count=1,state=rs[..]},state=cs[..]};#assert RF_init(f.flow) && RF_register(f.flow,0,3,0) && RF_set(f.flow,0,1);
 nodes[3]=CK_Node.{kind=CK_Tag.param,type=16};nodes[5]=CK_Node.{kind=CK_Tag.stmt_while,a=6,c=10};nodes[6]=CK_Node.{kind=CK_Tag.expr_or_else,type=2,a=7,b=8};nodes[7]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3,loc=CK_Loc.{line=132,column=11}};nodes[8]=CK_Node.{kind=CK_Tag.expr_bool,type=2};nodes[10]=CK_Node.{kind=CK_Tag.stmt_block};
 CF_stmt(f,5);#assert !ck[0].fatal && ck[0].error_count==1 && errors[0].code=="E0909" && errors[0].loc.line==132 && cs[0].loop_scope==1 && ck[0].depth==0;
}
#forall "R2 coverage4 Result-valued conditionals transfer through expression arms" transfer:bool {
 nodes:[12]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;ck:=[1]CK_State.[CK_State.{used=11,type_count=17}];words:[16]int;rs:[1]RF_State;cs:[1]CF_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],count=1,state=rs[..]},state=cs[..]};#assert RF_init(f.flow) && RF_register(f.flow,0,3,0) && RF_set(f.flow,0,1);
 nodes[3]=CK_Node.{kind=CK_Tag.param,type=16};nodes[5]=CK_Node.{kind=CK_Tag.expr_ifx,type=16,a=6,b=7,c=8};nodes[6]=CK_Node.{kind=CK_Tag.expr_bool,type=2};nodes[7]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3,loc=CK_Loc.{line=141,column=9}};nodes[8]=nodes[7];
 CF_expr(f,5,transfer);if transfer {#assert CF_ok(f) && RF_get(f.flow,0)==2 && rs[0].top==3;}else {#assert !ck[0].fatal && ck[0].error_count==1 && errors[0].code=="E0907" && errors[0].loc.line==141;}#assert ck[0].depth==0;
}
