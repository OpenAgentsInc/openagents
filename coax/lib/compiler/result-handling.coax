 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],count=1,state=rs[..]},state=cs[..]};
 nodes[3]=CK_Node.{kind=CK_Tag.stmt_var,type=16,a=6};nodes[5]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[6]=CK_Node.{kind=CK_Tag.expr_sum,type=16,sum_variant=0,a=7};nodes[7]=CK_Node.{kind=CK_Tag.expr_int,type=11};
 #assert RF_init(f.flow) && RF_register(f.flow,0,3,scope) && RF_set(f.flow,0,1);CF_expr(f,5,true);#assert CF_ok(f) && RF_get(f.flow,0)==2 && ck[0].depth==0;
}
