}
#forall "R2 coverage7 Result phase selection uses only the declared type prefix" mode:0..<5 {
 nodes:[2]CK_Node;types:[18]CK_Type;ck:=[1]CK_State.[CK_State.{used=1,type_count=18}];for i:0..<16 {types[i]=CK_builtin(i);}nodes[1]=CK_Node.{kind=CK_Tag.file};
 types[16]=CK_Type.{kind=CK_Kind.optional,elem=11};types[17]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};
 if mode==0 {ck[0].type_count=16;types[16]=types[17];}if mode==1 {ck[0].type_count=17;}if mode==3 {types[16]=types[17];types[17]=CK_Type.{kind=CK_Kind.optional,elem=11};}if mode==4 {types[17]=CK_Type.{kind=CK_Kind.optional,elem=12};}
 c:=CK_Context.{nodes=nodes[..],types=types[..],state=ck[..]};#assert CF_has_results(c)==(mode==2 || mode==3) && ck[0].error_count==0 && !ck[0].fatal;
}
#forall "R2 coverage8 statement conditionals preserve their continuing Result path" left_returns:bool {
 nodes:[20]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;ck:=[1]CK_State.[CK_State.{used=19,type_count=17}];words:[16]int;rs:[1]RF_State;cs:[1]CF_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=ck[..]};f:=CF_Context.{c=c,flow=RF_Context.{words=words[..],count=1,state=rs[..]},state=cs[..]};#assert RF_init(f.flow) && RF_register(f.flow,0,3,0) && RF_set(f.flow,0,1);
 nodes[3]=CK_Node.{kind=CK_Tag.param,type=16};nodes[5]=CK_Node.{kind=CK_Tag.stmt_if,a=6,c=7,d=8};nodes[6]=CK_Node.{kind=CK_Tag.expr_bool,type=2};nodes[7]=CK_Node.{kind=CK_Tag.stmt_block};nodes[8]=CK_Node.{kind=CK_Tag.stmt_block,head=9};nodes[9]=CK_Node.{kind=CK_Tag.stmt_return,a=10};nodes[10]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[14]=nodes[9];
 if left_returns {nodes[5].c=8;nodes[5].d=7;}
 CF_stmt(f,5);#assert CF_ok(f) && cs[0].alive && RF_get(f.flow,0)==1 && rs[0].top==3;
 CF_stmt(f,14);#assert CF_ok(f) && !cs[0].alive && RF_get(f.flow,0)==2 && ck[0].depth==0;
}
#forall "R2 coverage8 loop and defer inventories register their own Result locals" mode:0..<4 {
 nodes:[24]CK_Node;types:[18]CK_Type;errors:[4]CK_Error;ck:=[1]CK_State.[CK_State.{used=23,type_count=18}];words:[16]int;rs:[1]RF_State;cs:[1]CF_State;
