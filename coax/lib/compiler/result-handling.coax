 nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,head=3,b=4,loc=CK_Loc.{line=90,column=5}};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16};nodes[4]=CK_Node.{kind=CK_Tag.stmt_block,head=5};
 nodes[5]=CK_Node.{kind=CK_Tag.stmt_if,a=6,c=7,d=8};nodes[6]=CK_Node.{kind=CK_Tag.expr_bool,type=2};nodes[7]=CK_Node.{kind=CK_Tag.stmt_block};nodes[8]=nodes[7];
