#test "known bad and pending alternatives survive unknown and later benign alternatives" {
 sources:=[4]RP_Term.[RP_Term.{frame=7,origin=BS_Origin.{kind=BS_LOCAL,root=11,type=3}},RP_Term.{frame=7,origin=BS_Origin.{kind=BS_PARAMETER,root=1,role=BS_DESCRIPTOR,type=3}},RP_Term.{origin=BS_Origin.{kind=BS_STATIC,root=12,type=3}},RP_Term.{frame=7,origin=BS_Origin.{kind=BS_LOCAL,root=99,type=3}}];
 local:=RP_Address.{storage=RP_Term.{frame=7,origin=BS_Origin.{kind=BS_LOCAL,root=21,type=9}},value_type=3};external:=local;external.storage.origin=BS_Origin.{kind=BS_PARAMETER,root=0,role=BS_DESCRIPTOR,type=9,path=BS_Path.{count=1}};external.storage.origin.path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};destinations:=[2]RP_Address.[local,external];out:[2]RP_Obligation;
 r:=RP_check(7,3,sources[..],false,destinations[..],false,out[..]);#assert r.status==RP_Status.ok && !r.facts_complete && !r.relation_complete && r.forbidden && r.obligation_count==1 && r.bad_source==0 && r.bad_destination==1 && out[0].source.origin.root==1;
 r=RP_check(7,3,sources[0..<1],false,destinations[1..<2],false,out[..]);#assert r.status==RP_Status.ok && !r.facts_complete && r.relation_complete && r.forbidden && r.bad_source==0 && r.bad_destination==0;
 r=RP_check(7,3,sources[0..<1],true,destinations[0..<0],false,out[..]);#assert r.status==RP_Status.ok && !r.facts_complete && r.relation_complete && !r.forbidden;
}
#forall "addressed storage is distinct from a descriptor slot and its old pointee" owned_copy:bool,before:bool {
 source:=[1]RP_Term.[RP_Term.{frame=1,origin=BS_Origin.{kind=BS_LOCAL,root=10,type=3}}];address:=RP_Address.{storage=RP_Term.{frame=1,origin=BS_Origin.{kind=BS_PARAMETER,root=0,role=ifx owned_copy then BS_INLINE else BS_DESCRIPTOR,type=9}},value_type=3};address.storage.origin.path.count=2;address.storage.origin.path.steps[0]=BS_Step.{kind=BS_FIELD,index=6};address.storage.origin.path.steps[1]=BS_Step.{kind=ifx before then BS_DEREFERENCE else BS_ELEMENT,index=ifx before then 0 else 4};destinations:=[1]RP_Address.[address];out:[1]RP_Obligation;out[0].source.frame=900;
 r:=RP_check(1,3,source[..],true,destinations[..],true,out[..]);valid:=owned_copy!=before;#assert r.status==(ifx valid then RP_Status.ok else RP_Status.invalid) && r.forbidden==(!owned_copy && before) && r.relation_complete==(!owned_copy && before) && r.obligation_count==0 && out[0].source.frame==900;
}
