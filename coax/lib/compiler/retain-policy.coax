}

#test "the first forbidden witness is source major and never overwritten" {
 sources:=[3]RP_Term.[RP_Term.{origin=BS_Origin.{kind=BS_STATIC,root=1,type=3}},RP_Term.{frame=7,origin=BS_Origin.{kind=BS_LOCAL,root=11,type=3}},RP_Term.{frame=7,origin=BS_Origin.{kind=BS_LOCAL,root=12,type=3}}];
 local:=RP_Address.{storage=RP_Term.{frame=7,origin=BS_Origin.{kind=BS_LOCAL,root=21,type=9}},value_type=3};external:=RP_Address.{storage=RP_Term.{origin=BS_Origin.{kind=BS_STATIC,root=22,type=9}},value_type=3};destinations:=[3]RP_Address.[local,external,external];out:[1]RP_Obligation;
 r:=RP_check(7,3,sources[..],false,destinations[..],false,out[..]);#assert r.status==RP_Status.ok && r.forbidden && r.bad_source==1 && r.bad_destination==1 && !r.facts_complete && !r.relation_complete && r.obligation_count==0;
}

#forall "scalar invocation guards stand alone with empty source and static address" mode:0..<4 {
 frame:=ifx mode==1 then 2147483647 else ifx mode==2 then 2147483648 else 1;key:=ifx mode==1 then 2147483647 else ifx mode==3 then 2147483648 else 1;
 sources:[1]RP_Term;destinations:=[1]RP_Address.[RP_Address.{storage=RP_Term.{origin=BS_Origin.{kind=BS_STATIC,root=1,type=9}},value_type=key}];out:[1]RP_Obligation;out[0].source.frame=900;
 r:=RP_check(frame,key,sources[0..<0],true,destinations[..],true,out[0..<0]);valid:=mode<2;#assert r.status==(ifx valid then RP_Status.ok else RP_Status.invalid) && r.facts_complete==valid && r.relation_complete==valid && !r.forbidden && r.obligation_count==0 && r.bad_source== -1 && r.bad_destination== -1 && out[0].source.frame==900;
}

// Each call classifies one descriptor leaf in one supplied frame namespace.
// A complete empty source is a checked default-empty descriptor, not a zero
// length view whose backing lifetime has disappeared. No strong update occurs.
RP_bounds :: (source_count:int,destination_count:int,output_count:int)->RP_Status #export_c {
 if source_count<0 || source_count>RP_MAX_TERMS || destination_count<0 || destination_count>RP_MAX_TERMS || output_count<0 || output_count>RP_MAX_TERMS {return RP_Status.invalid;}
 if source_count*destination_count>RP_MAX_WORK {return RP_Status.work;}
 return RP_Status.ok;
}

rp_term_valid :: (term:RP_Term,frame:int)->bool {
 if !BS_origin_valid(term.origin) {return false;}
 return ifx term.origin.kind==BS_STATIC then term.frame==0 else term.frame==frame;
}
rp_address_valid :: (address:RP_Address,frame:int,value_type:int)->bool {
 if !rp_term_valid(address.storage,frame) || address.value_type!=value_type {return false;}
 if address.storage.origin.kind==BS_PARAMETER && address.storage.origin.role==BS_DESCRIPTOR {
  for i:0..<address.storage.origin.path.count {if address.storage.origin.path.steps[i].kind==BS_DEREFERENCE {return true;}}
  return false;
 }
 return true;
}
// Preconditions: term/address shape, role and current-frame facts are admitted.
rp_local_source :: (source:RP_Term)->bool {return source.origin.kind==BS_LOCAL || source.origin.role==BS_INLINE;}
rp_external :: (address:RP_Address)->bool {return address.storage.origin.kind==BS_STATIC || address.storage.origin.role==BS_DESCRIPTOR;}

// The per-call frame and value key are already canonical. BS compares the
// potentially differing destination/source projections without C padding.
rp_compare :: (a:RP_Obligation,b:RP_Obligation)->int {
 comparison:=bs_compare(a.destination.storage.origin,b.destination.storage.origin);
 if comparison!=0 {return comparison;}
 return bs_compare(a.source.origin,b.source.origin);
}
// Only private staging is written; exactly -1 means capacity refusal.
rp_insert :: (staging:[]RP_Obligation,used:int,value:RP_Obligation)->int {
 at:=used;
 for i:0..<used {
  comparison:=rp_compare(staging[i],value);
  if comparison<0 {continue;}
  if comparison==0 {return used;}
  at=i;break;
 }
 if used>=RP_MAX_TERMS {return -1;}
 i:=used;while i>at {staging[i]=staging[i-1];i-=1;}
 staging[at]=value;
 return used+1;
}

// Invalid facts are hard refusal, never complete empty facts. Known pairs are
// classified even with unknown alternatives. Pending outlives obligations and
// unsupported same-frame local ordering both keep relation_complete false.
RP_check :: (frame:int,value_type:int,sources:[]RP_Term,source_complete:bool,destinations:[]RP_Address,destination_complete:bool,out:[]RP_Obligation)->RP_Result #export_c {
 bounds:=RP_bounds(sources.count,destinations.count,out.count);
 if bounds==RP_Status.invalid || frame<1 || frame>2147483647 || value_type<1 || value_type>2147483647 || (destination_complete && destinations.count==0) {return RP_Result.{status=RP_Status.invalid};}
 for source:sources {if !rp_term_valid(source,frame) || source.origin.type!=value_type {return RP_Result.{status=RP_Status.invalid};}}
 for address:destinations {if !rp_address_valid(address,frame,value_type) {return RP_Result.{status=RP_Status.invalid};}}
 if bounds!=RP_Status.ok {return RP_Result.{status=RP_Status.work};}
 staging:[64]RP_Obligation;used:=0;
 result:=RP_Result.{facts_complete=source_complete && destination_complete,relation_complete=true};
 for i:0..<sources.count {
  source:=sources[i];
  for j:0..<destinations.count {
   address:=destinations[j];
   if rp_external(address) {
    if rp_local_source(source) {
     result.forbidden=true;
     if result.bad_source<0 {result.bad_source=i;result.bad_destination=j;}
    }else if source.origin.kind!=BS_STATIC {
     result.relation_complete=false;
     pending:=RP_Obligation.{source=source,destination=address};
     inserted:=rp_insert(staging[..],used,pending);
     if inserted== -1 {return RP_Result.{status=RP_Status.capacity};}
     used=inserted;
    }
   }else if rp_local_source(source) {result.relation_complete=false;}
  }
 }
 if used>out.count {return RP_Result.{status=RP_Status.capacity};}
 for i:0..<used {out[i]=staging[i];}
 result.obligation_count=used;
 return result;
}
