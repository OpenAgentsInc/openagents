 r:=RP_check(1,3,sources[0..<0],sc,destinations[..],dc,out[..]);#assert r.status==RP_Status.ok && r.facts_complete==(sc && dc) && r.relation_complete && !r.forbidden && r.obligation_count==0 && r.bad_source== -1 && r.bad_destination== -1 && out[0].source.frame==900;
 r=RP_check(1,3,sources[0..<0],sc,destinations[0..<0],dc,out[..]);#assert r.status==(ifx dc then RP_Status.invalid else RP_Status.ok) && !r.facts_complete && r.relation_complete==!dc && r.obligation_count==0 && !r.forbidden && out[0].source.frame==900;
