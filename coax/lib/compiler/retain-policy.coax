 destinations[2].storage.origin.path.steps[0].index=1;r:=RP_check(7,3,sources[..],false,destinations[..],false,out[..]);#assert r.status==RP_Status.invalid && out[0].source.frame==900;
 destinations[2]=address;sources[42].origin.path.steps[7].kind=BS_FIELD;r=RP_check(7,3,sources[..],false,destinations[..],false,out[..]);#assert r.status==RP_Status.invalid && out[0].source.frame==900;
 sources[42]=source;destinations[2].value_type=4;r=RP_check(7,3,sources[..],false,destinations[..],false,out[..]);#assert r.status==RP_Status.invalid && out[0].source.frame==900;
}
