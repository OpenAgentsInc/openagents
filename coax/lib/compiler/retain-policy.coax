 out[0].source.frame=900;r=RP_check(7,3,sources[0..<43],false,destinations[..],false,out[..]);#assert r.status==RP_Status.work && r.obligation_count==0 && !r.facts_complete && !r.relation_complete && !r.forbidden && r.bad_source== -1 && r.bad_destination== -1 && out[0].source.frame==900;
 sources[42].frame=8;r=RP_check(7,3,sources[0..<43],false,destinations[..],false,out[..]);#assert r.status==RP_Status.invalid && out[0].source.frame==900;
