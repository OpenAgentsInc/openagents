 x:=RP_Address.{storage=RP_Term.{origin=BS_Origin.{kind=BS_STATIC,root=9,type=11}},value_type=3};y:=RP_Address.{storage=RP_Term.{frame=7,origin=BS_Origin.{kind=BS_PARAMETER,root=0,role=BS_DESCRIPTOR,type=9,path=BS_Path.{count=1}}},value_type=3};y.storage.origin.path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};destinations:=[3]RP_Address.[ifx reverse then y else x,ifx reverse then x else y,x];out:[5]RP_Obligation;out[4].source.frame=900;
 r:=RP_check(7,3,sources[..],true,destinations[..],true,out[..]);#assert r.status==RP_Status.ok && r.facts_complete && !r.relation_complete && !r.forbidden && r.obligation_count==4 && r.bad_source== -1 && r.bad_destination== -1 && out[4].source.frame==900;
 for i:0..<4 {#assert out[i].source.frame==7 && out[i].source.origin.root==i%2 && out[i].source.origin.role==BS_DESCRIPTOR && out[i].source.origin.type==3 && out[i].destination.value_type==3;#assert out[i].destination.storage.origin.kind==(ifx i<2 then BS_STATIC else BS_PARAMETER) && out[i].destination.storage.origin.root==(ifx i<2 then 9 else 0) && out[i].destination.storage.frame==(ifx i<2 then 0 else 7);}
 #assert out[2].source.origin.root==out[2].destination.storage.origin.root && r.obligation_count>0;
}
#test "exact64 obligations publish and65 refuse without a partial prefix" {
 sources:[13]RP_Term;for i:0..<13 {sources[i]=RP_Term.{frame=7,origin=BS_Origin.{kind=BS_PARAMETER,root=i,role=BS_DESCRIPTOR,type=3}};}
 destinations:[8]RP_Address;for i:0..<8 {destinations[i]=RP_Address.{storage=RP_Term.{frame=7,origin=BS_Origin.{kind=BS_PARAMETER,root=i,role=BS_DESCRIPTOR,type=9,path=BS_Path.{count=1}}},value_type=3};destinations[i].storage.origin.path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};}
 out:[65]RP_Obligation;for i:0..<65 {out[i].source.frame=900+i;out[i].destination.value_type=700+i;}
 r:=RP_check(7,3,sources[0..<8],true,destinations[..],true,out[0..<64]);#assert r.status==RP_Status.ok && r.obligation_count==64 && !r.relation_complete && out[64].source.frame==964 && out[64].destination.value_type==764;
 for i:0..<64 {#assert out[i].source.origin.root==i%8 && out[i].destination.storage.origin.root==i/8;out[i].source.frame=900+i;out[i].destination.value_type=700+i;}
 r=RP_check(7,3,sources[..],true,destinations[0..<5],true,out[0..<64]);#assert r.status==RP_Status.capacity && !r.facts_complete && !r.relation_complete && !r.forbidden && r.obligation_count==0 && r.bad_source== -1 && r.bad_destination== -1;
 for i:0..<65 {#assert out[i].source.frame==900+i && out[i].destination.value_type==700+i;}
 r=RP_check(7,3,sources[0..<8],true,destinations[..],true,out[0..<63]);#assert r.status==RP_Status.capacity && out[0].source.frame==900 && out[63].source.frame==963;
 r=RP_check(7,3,sources[0..<1],true,destinations[0..<1],true,out[0..<0]);#assert r.status==RP_Status.capacity && out[0].source.frame==900;
 r=RP_check(7,3,sources[0..<0],true,destinations[0..<1],true,out[0..<0]);#assert r.status==RP_Status.ok && r.obligation_count==0 && r.facts_complete && r.relation_complete;
}
