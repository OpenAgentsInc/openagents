 source:RP_Term;source.frame=7;source.origin=BS_Origin.{kind=BS_PARAMETER,root=0,role=BS_DESCRIPTOR,type=3};address:RP_Address;address.storage=source;address.storage.origin.type=9;address.storage.origin.path.count=1;address.storage.origin.path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};address.value_type=3;
 sources:[64]RP_Term;for i:0..<64 {sources[i]=source;}destinations:=[3]RP_Address.[address,address,address];out:[1]RP_Obligation;out[0].source.frame=900;
