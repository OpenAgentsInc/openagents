// Supplied retained-store classification; checked graph integration is separate.
// Valid immutable inputs are disjoint from writable output for this call.
#load "borrow-summary.coax";
#authority;

RP_MAX_TERMS :: BS_MAX_SET;
RP_MAX_WORK :: BS_MAX_WORK;
RP_Status :: enum u8 {ok; invalid; capacity; work;}
RP_Term :: struct {frame:int; origin:BS_Origin;}
RP_Address :: struct {storage:RP_Term; value_type:int;}
RP_Obligation :: struct {source:RP_Term; destination:RP_Address;}
RP_Result :: struct {
 status:RP_Status; facts_complete:bool; relation_complete:bool;
 forbidden:bool; obligation_count:int;
 bad_source:int = -1; bad_destination:int = -1;
}

#test "a callee local cannot be retained in caller addressed storage" {
 source:=[1]RP_Term.[RP_Term.{frame=7,origin=BS_Origin.{kind=BS_LOCAL,root=11,type=3}}];
 address:RP_Address;address.storage.frame=7;address.storage.origin=BS_Origin.{kind=BS_PARAMETER,root=0,role=BS_DESCRIPTOR,type=9};address.value_type=3;
 address.storage.origin.path.count=2;address.storage.origin.path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};address.storage.origin.path.steps[1]=BS_Step.{kind=BS_FIELD,index=2};
 destinations:=[1]RP_Address.[address];out:[1]RP_Obligation;out[0].source.frame=900;
 #assert RP_bounds(1,1,1)==RP_Status.ok;
 r:=RP_check(7,3,source[..],true,destinations[..],true,out[..]);
 #assert r.status==RP_Status.ok && r.forbidden;
 #assert r.facts_complete && r.relation_complete && r.obligation_count==0 && r.bad_source==0 && r.bad_destination==0 && out[0].source.frame==900;
}

#forall "source storage and lifetime decisions remain independent of fact completeness" src:0..<4,dst:0..<4,sc:bool,dc:bool {
 source:RP_Term;source.frame=5;source.origin=BS_Origin.{kind=ifx src==0 then BS_STATIC else ifx src==1 then BS_LOCAL else BS_PARAMETER,root=ifx src<2 then 11 else 2,role=ifx src==2 then BS_INLINE else ifx src==3 then BS_DESCRIPTOR else 0,type=3};if src==0 {source.frame=0;}
 address:RP_Address;address.storage.frame=5;address.storage.origin=BS_Origin.{kind=ifx dst==0 then BS_STATIC else ifx dst==1 then BS_LOCAL else BS_PARAMETER,root=ifx dst<2 then 21 else 2,role=ifx dst==2 then BS_INLINE else ifx dst==3 then BS_DESCRIPTOR else 0,type=9};address.value_type=3;if dst==0 {address.storage.frame=0;}if dst==3 {address.storage.origin.path.count=1;address.storage.origin.path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};}
 sources:=[1]RP_Term.[source];destinations:=[1]RP_Address.[address];out:[2]RP_Obligation;out[0].source.frame=900;out[1].source.frame=901;
 r:=RP_check(5,3,sources[..],sc,destinations[..],dc,out[..]);bad:=(src==1 || src==2) && (dst==0 || dst==3);pending:=src==3 && (dst==0 || dst==3);local_order:=(src==1 || src==2) && (dst==1 || dst==2);
 #assert r.status==RP_Status.ok && r.facts_complete==(sc && dc) && r.relation_complete==(!pending && !local_order) && r.forbidden==bad && r.obligation_count==(ifx pending then 1 else 0) && r.bad_source==(ifx bad then 0 else -1) && r.bad_destination==(ifx bad then 0 else -1);
 if pending {#assert out[0].source.frame==5 && out[0].source.origin.kind==BS_PARAMETER && out[0].source.origin.root==2 && out[0].source.origin.role==BS_DESCRIPTOR && out[0].source.origin.type==3 && out[0].source.origin.path.count==0;#assert out[0].destination.storage.frame==address.storage.frame && out[0].destination.storage.origin.kind==address.storage.origin.kind && out[0].destination.storage.origin.root==2+(ifx dst==0 then 19 else 0) && out[0].destination.storage.origin.role==address.storage.origin.role && out[0].destination.storage.origin.type==9 && out[0].destination.value_type==3 && out[0].destination.storage.origin.path.count==address.storage.origin.path.count;}
 else {#assert out[0].source.frame==900;}#assert out[1].source.frame==901;
}
#forall "scalar span and pair work admission includes exact endpoints" s:0..<5,d:0..<5,o:0..<4 {
 counts:=[5]int.[-1,0,43,64,65];outs:=[4]int.[-1,0,64,65];a:=counts[s];b:=counts[d];c:=outs[o];valid:=a>=0 && a<=64 && b>=0 && b<=64 && c>=0 && c<=64;want:=ifx !valid then RP_Status.invalid else ifx a*b>128 then RP_Status.work else RP_Status.ok;
 #assert RP_bounds(a,b,c)==want;
}
#test "pair work is charged before duplicate elimination at126128129" {
