 frame:=ifx mode==0 then 2147483647 else 1;key:=ifx mode==1 then 2147483647 else 3;source:=RP_Term.{frame=frame,origin=BS_Origin.{kind=BS_PARAMETER,root=63,role=BS_DESCRIPTOR,type=key}};address:=RP_Address.{storage=RP_Term.{frame=frame,origin=BS_Origin.{kind=BS_LOCAL,root=2147483647,type=9}},value_type=key};
 if mode==2 {frame=0;}else if mode==3 {frame=2147483648;}else if mode==4 {key=0;}else if mode==5 {key=2147483648;}else if mode==6 {source.frame=0;}else if mode==7 {source.frame=2;}else if mode==8 {source.origin.type=9;}else if mode==9 {address.storage.frame=0;}else if mode==10 {address.storage.frame=2;}else if mode==11 {address.value_type=9;}else if mode==12 {source.origin.kind=BS_STATIC;source.origin.role=0;source.origin.root=1;}else if mode==13 {address.storage.origin.kind=BS_STATIC;}else if mode==14 {source.origin.root=64;}else if mode==15 {address.storage.origin.type=0;}
 sources:=[1]RP_Term.[source];destinations:=[1]RP_Address.[address];out:[1]RP_Obligation;out[0].source.frame=900;r:=RP_check(frame,key,sources[..],false,destinations[..],false,out[..]);#assert r.status==(ifx mode<2 then RP_Status.ok else RP_Status.invalid) && !r.facts_complete && r.relation_complete==(mode<2) && !r.forbidden && r.obligation_count==0 && r.bad_source== -1 && r.bad_destination== -1 && out[0].source.frame==900;
}
