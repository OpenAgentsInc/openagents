// Realm-script profile, version 1 (coax/script-profile.md). A `#script "name";`
// unit is a realm script: code that someone other than us may write, compiled
// to its own WebAssembly module. Native code finds tokens, resolved calls and
// declared types; this module owns the directive's syntax, the effect bound,
// the handler table and the recursion search.
#authority;
#load "sources.coax";

// `#script "name";` marks its unit a realm script; `#script_api;` marks a unit
// that declares the script API's imports. One directive a unit, at file scope.
// kind 0: neither; 1: a script; 2: the API. error 1: malformed; 2: not at
// file scope; 3: a second directive; 4: the name. A refusal reports its
// directive's offset and no kind.
SP_Script :: struct {kind:u32;error:u32;offset:int;name:string;begin:int;end:int;}
SP_Edge :: struct {from:int;to:int;}

#test "a script directive retains its name and directive span" {
 t:=[4] SU_Token.[SU_Token.{kind=6,text="script",begin=1,end=8},SU_Token.{kind=5,text="patrol-2",begin=9,end=19},SU_Token.{kind=15,begin=19,end=20},SU_Token.{}];
 r:=SP_scan(t[..]);
 #assert r.kind==1 && r.error==0 && r.name=="patrol-2" && r.begin==1 && r.end==20;
 t[0].text="scripts";r=SP_scan(t[..]);#assert r.kind==0 && r.error==0 && r.name=="" && r.begin==0 && r.end==0;
 t[0].text="script";t[0].kind=1;r=SP_scan(t[..]);#assert r.kind==0 && r.error==0;
}
#test "an API directive needs only its terminator" {
 t:=[3] SU_Token.[SU_Token.{kind=6,text="script_api",begin=2,end=13},SU_Token.{kind=15,begin=13,end=14},SU_Token.{}];
 r:=SP_scan(t[..]);#assert r.kind==2 && r.error==0 && r.begin==2 && r.end==14 && r.name=="";
 r=SP_scan(t[0..<1]);#assert r.error==1 && r.offset==2 && r.kind==0;
 t[1].kind=5;r=SP_scan(t[..]);#assert r.error==1 && r.offset==2 && r.kind==0;
 t[1].kind=15;t[0].kind=1;#assert SP_scan(t[..]).kind==0;
}
#forall "script syntax requires a string name and a terminator" kind:0..<17 {
 t:=[4] SU_Token.[SU_Token.{kind=6,text="script",begin=4},SU_Token.{kind=cast(u32)kind,text="a"},SU_Token.{kind=15,end=9},SU_Token.{}];
 r:=SP_scan(t[..]);
 if kind==5 {#assert r.error==0 && r.kind==1 && r.end==9;}else {#assert r.error==1 && r.offset==4 && r.kind==0;}
 t[1].kind=5;t[2].kind=cast(u32)kind;r=SP_scan(t[..]);
 if kind==15 {#assert r.error==0 && r.kind==1;}else {#assert r.error==1 && r.offset==4 && r.kind==0;}
}
#test "one script directive a unit, never truncated" {
 t:=[6] SU_Token.[SU_Token.{kind=6,text="script"},SU_Token.{kind=5,text="a"},SU_Token.{kind=15},SU_Token.{kind=6,text="script",begin=9},SU_Token.{kind=5,text="b"},SU_Token.{kind=15}];
 r:=SP_scan(t[..]);#assert r.error==3 && r.offset==9 && r.kind==0;
 #assert SP_scan(t[0..<3]).error==0;
 #assert SP_scan(t[0..<1]).error==1;#assert SP_scan(t[0..<2]).error==1;
 u:=[5] SU_Token.[SU_Token.{kind=6,text="script_api"},SU_Token.{kind=15},SU_Token.{kind=6,text="script",begin=7},SU_Token.{kind=5,text="b"},SU_Token.{kind=15}];
 r=SP_scan(u[..]);#assert r.error==3 && r.offset==7;
 v:=[5] SU_Token.[SU_Token.{kind=6,text="script"},SU_Token.{kind=5,text="b"},SU_Token.{kind=15},SU_Token.{kind=6,text="script_api",begin=8},SU_Token.{kind=15}];
 r=SP_scan(v[..]);#assert r.error==3 && r.offset==8;
}
#forall "a script directive stands at file scope, after any closed group" open:0..<3 {
 o:=cast(u32)(8+open*2);
 t:=[5] SU_Token.[SU_Token.{kind=o},SU_Token.{kind=6,text="script",begin=2},SU_Token.{kind=5,text="a"},SU_Token.{kind=15},SU_Token.{kind=o+1}];
 r:=SP_scan(t[..]);#assert r.error==2 && r.offset==2 && r.kind==0;
 u:=[5] SU_Token.[SU_Token.{kind=o},SU_Token.{kind=o+1},SU_Token.{kind=6,text="script_api",begin=3},SU_Token.{kind=15,end=15},SU_Token.{}];
 r=SP_scan(u[..]);#assert r.error==0 && r.kind==2 && r.begin==3 && r.end==15;
 u[1].kind=o;r=SP_scan(u[..]);#assert r.error==2 && r.offset==3;
}
#forall "script names are lowercase words, digits and hyphens that start with a letter" c:0..<128 {
 lower:=c>='a' && c<='z';
 first:=[1] u8.[cast(u8)c];rest:=[2] u8.['a',cast(u8)c];
 #assert SP_name_valid(cast(string) first[..])==lower;
 #assert SP_name_valid(cast(string) rest[..])==(lower || (c>='0' && c<='9') || c=='-');
}
#test "script names hold 1 to 48 bytes, and a bad one refuses its directive" {
 long:[49] u8;for i:0..<49 {long[i]='a';}
 #assert !SP_name_valid("");#assert SP_name_valid(cast(string) long[0..<48]);#assert !SP_name_valid(cast(string) long[..]);
 t:=[4] SU_Token.[SU_Token.{kind=6,text="script",begin=5},SU_Token.{kind=5,text="Patrol"},SU_Token.{kind=15},SU_Token.{}];
 r:=SP_scan(t[..]);#assert r.error==4 && r.offset==5 && r.kind==0 && r.name=="";
}

// Effects. The capability bits are effect-contract.coax's: foreign 2, traps 8,
// reads 16, writes 32. A script procedure may read, write and trap. An API
// import must declare its effects within those and `foreign`; a script that
// calls it is charged what it declares, without `foreign`: the API is the one
// native surface a script may reach.
#forall "a script declaration stays within reads, writes and traps" bits:0..<64, high:0..<4 {
 all:=cast(u32)bits | (cast(u32)high<<9);
 #assert SP_within(all)==((all & 1)==0 && (all & 2)==0 && (all & 4)==0 && high==0);
 #assert SP_within(all | 4096)==false && SP_within(all | 2048)==false;
}
#test "the script bound is reads, writes and traps" {
 #assert SP_bound()==56 && SP_within(56) && SP_within(0) && !SP_within(57) && !SP_within(58) && !SP_within(1080);
}
#forall "an API import costs its caller its declared effects without foreign" bits:0..<64, declared:bool {
 all:=cast(u32)bits;r:=SP_import(declared,all);
 inside:=(all & 1)==0 && (all & 4)==0;
 if declared && inside {#assert r==cast(int)(all & 56);}else {#assert r== -1;}
 #assert SP_import(true,all | 512)== -1 && SP_import(true,all | 1024)== -1 && SP_import(true,all | 4096)== -1;
}

// Handlers: the only procedures a script exports. Each takes the thing it is
// called for (u64), a one-element view of that thing's state, then the
// handler's own parameters. Parameter kinds: 1 a thing (u64), 2 f32, 3 s32.
#test "the handler table names seven entry points and their parameters" {
 names:=[7] string.["on_tick","on_enter","on_leave","on_notice","on_hit","on_use","on_timer"];
 for name,i:names {#assert SP_handler(name)==i && SP_handler_name(i)==name;}
 #assert SP_handlers()==7 && SP_handler("on_ticks")== -1 && SP_handler("")== -1 && SP_handler("main")== -1;
 #assert SP_handler_name(-1)=="" && SP_handler_name(7)=="";
 want:=[7] u32.[2,1,1,1,17,1,3];
 for i:0..<7 {
  #assert SP_handler_param(i,0)==(want[i] & 7) && SP_handler_param(i,1)==(want[i]>>3) && SP_handler_param(i,2)==0;
  #assert SP_handler_param(i,-1)==0;
 }
 #assert SP_handler_param(-1,0)==0 && SP_handler_param(7,0)==0;
}

// Placement. unit: 0 a library unit, 1 the script, 2 the API. Verdict 0:
// admitted; 1: a #foreign outside the API; 2: an #export_c outside the script
// or one that is not a handler; 3: a `main`.
#forall "foreign procedures belong to the API and exports are the script's handlers" unit:0..<3, foreign:bool, exported:bool, handler:bool, entry:bool {
 r:=SP_proc(cast(u32)unit,foreign,exported,handler,entry);
 want:=cast(u32)0;
 if entry {want=3;}else if foreign && unit!=2 {want=1;}else if exported && (unit!=1 || !handler) {want=2;}
 #assert r==want;
}

// Recursion. A script's stack has a known bound, so no procedure it reaches
// may call itself, directly or through others.
#test "a cycle reachable from the root is found, and one elsewhere is not" {
 e:=[5] SP_Edge.[SP_Edge.{from=0,to=1},SP_Edge.{from=1,to=2},SP_Edge.{from=2,to=1},SP_Edge.{from=2,to=3},SP_Edge.{from=4,to=4}];
 state:[5] u8;stack:[5] int;cursor:[5] int;
 #assert SP_cycle(5,e[..],0,state[..],stack[..],cursor[..])==1;
 #assert SP_cycle(5,e[..],3,state[..],stack[..],cursor[..])== -1;
 #assert SP_cycle(5,e[..],4,state[..],stack[..],cursor[..])==4;
 #assert SP_cycle(5,e[0..<2],0,state[..],stack[..],cursor[..])== -1;
 #assert SP_cycle(5,e[0..<0],0,state[..],stack[..],cursor[..])== -1;
}
#test "shared callees and repeated edges are not cycles" {
 e:=[6] SP_Edge.[SP_Edge.{from=0,to=1},SP_Edge.{from=0,to=2},SP_Edge.{from=1,to=3},SP_Edge.{from=2,to=3},SP_Edge.{from=0,to=1},SP_Edge.{from=3,to=4}];
 state:[5] u8;stack:[5] int;cursor:[5] int;
 #assert SP_cycle(5,e[..],0,state[..],stack[..],cursor[..])== -1;
 for i:0..<5 {#assert state[i]==2;}
 back:=[7] SP_Edge.[e[0],e[1],e[2],e[3],e[4],e[5],SP_Edge.{from=4,to=0}];
 #assert SP_cycle(5,back[..],0,state[..],stack[..],cursor[..])==0;
 #assert SP_cycle(5,back[..],2,state[..],stack[..],cursor[..])==3;
 low:=[3] SP_Edge.[SP_Edge.{from=1,to=0},SP_Edge.{from=1,to=2},SP_Edge.{from=0,to=0}];
 #assert SP_cycle(3,low[..],1,state[..],stack[..],cursor[..])==0;
}
#test "malformed graphs and short scratch refuse before writes" {
 e:=[1] SP_Edge.[SP_Edge.{from=0,to=1}];state:[3] u8;stack:[3] int;cursor:[3] int;
 for i:0..<3 {state[i]=7;stack[i]=71;cursor[i]=72;}
 for mode:0..<10 {
  n:=2;root:=0;sn:=3;kn:=3;cn:=3;g:=e;
  if mode==0 {n=0;}if mode==1 {root= -1;}if mode==2 {root=2;}if mode==3 {sn=1;}if mode==4 {kn=1;}if mode==5 {cn=1;}
  if mode==6 {g[0].from= -1;}if mode==7 {g[0].from=2;}if mode==8 {g[0].to= -1;}if mode==9 {g[0].to=2;}
  #assert SP_cycle(n,g[..],root,state[0..<sn],stack[0..<kn],cursor[0..<cn])== -2;
  for i:0..<3 {#assert state[i]==7 && stack[i]==71 && cursor[i]==72;}
 }
 #assert SP_cycle(2,e[..],0,state[0..<2],stack[0..<2],cursor[0..<2])== -1;
 #assert SP_cycle(1,e[0..<0],0,state[0..<1],stack[0..<1],cursor[0..<1])== -1;
}

// Implementations follow only after their checks have been written.
SP_name_valid :: (name:string)->bool #export_c #effects(all) {
 if name.count<1 || name.count>48 {return false;}
 for c,i:name {
  lower:=c>='a' && c<='z';
  if !lower && (i==0 || !((c>='0' && c<='9') || c=='-')) {return false;}
 }
 return true;
}
SP_scan :: (tokens:[] SU_Token)->SP_Script #export_c #effects(all) {
 r:SP_Script;depth:=0;
 for t,i:tokens {
  if t.kind==8 || t.kind==10 || t.kind==12 {depth+=1;}else if t.kind==9 || t.kind==11 || t.kind==13 {depth-=1;}
  if t.kind!=6 {continue;}
  api:=t.text=="script_api";
  if !api && t.text!="script" {continue;}
  bad:=SP_Script.{error=1,offset=t.begin};
  if depth!=0 {bad.error=2;return bad;}
  if r.kind!=0 {bad.error=3;return bad;}
  last:=ifx api then i+1 else i+2;
  if last>=tokens.count || tokens[last].kind!=15 {return bad;}
  if !api {
   id:=tokens[i+1];if id.kind!=5 {return bad;}
   if !SP_name_valid(id.text) {bad.error=4;return bad;}
   r.name=id.text;
  }
  r.kind=ifx api then cast(u32)2 else cast(u32)1;r.begin=t.begin;r.end=tokens[last].end;
 }
 return r;
}
SP_BOUND :: 56;
SP_bound :: ()->u32 #export_c #effects(all) {return SP_BOUND;}
SP_within :: (bits:u32)->bool #export_c #effects(all) {return (bits & (cast(u32)4294967295 ^ cast(u32)SP_BOUND))==0;}
SP_import :: (declared:bool,bits:u32)->int #export_c #effects(all) {
 charged:=bits & (cast(u32)4294967295 ^ cast(u32)2);
 if !declared || !SP_within(charged) {return -1;}
 return cast(int)charged;
}
SP_HANDLERS :: [7] string.["on_tick","on_enter","on_leave","on_notice","on_hit","on_use","on_timer"];
// Two parameter kinds a handler, 0 where it takes none.
SP_PARAMS :: [14] u32.[2,0, 1,0, 1,0, 1,0, 1,2, 1,0, 3,0];
SP_handlers :: ()->int #export_c #effects(all) {return SP_HANDLERS.count;}
SP_handler :: (name:string)->int #export_c #effects(all) {
 for known,i:SP_HANDLERS {if known==name {return i;}}
 return -1;
}
SP_handler_name :: (handler:int)->string #export_c #effects(all) {
 if handler<0 || handler>=SP_HANDLERS.count {return "";}
 return SP_HANDLERS[handler];
}
SP_handler_param :: (handler:int,index:int)->u32 #export_c #effects(all) {
 if handler<0 || handler>=SP_HANDLERS.count || index<0 || index>1 {return 0;}
 return SP_PARAMS[handler*2+index];
}
SP_proc :: (unit:u32,foreign:bool,exported:bool,handler:bool,entry:bool)->u32 #export_c #effects(all) {
 if entry {return 3;}
 if foreign && unit!=2 {return 1;}
 if exported && (unit!=1 || !handler) {return 2;}
 return 0;
}
// state: 0 unseen, 1 on the current path, 2 finished. Returns a procedure on
// a cycle the root reaches, -1 when there is none, -2 for a refused graph or
// scratch (each scratch view holds n entries), before any write.
SP_cycle :: (n:int,edges:[] SP_Edge,root:int,state:[] u8,stack:[] int,cursor:[] int)->int #export_c #effects(all) {
 if n<1 || root<0 || root>=n || state.count<n || stack.count<n || cursor.count<n {return -2;}
 for e:edges {if e.from<0 || e.from>=n || e.to<0 || e.to>=n {return -2;}}
 for i:0..<n {state[i]=0;cursor[i]=0;}
 depth:=0;stack[0]=root;state[root]=1;
 while depth>=0 {
  at:=stack[depth];next:= -1;
  while cursor[at]<edges.count && next<0 {
   e:=edges[cursor[at]];cursor[at]+=1;
   if e.from!=at {continue;}
   if state[e.to]==1 {return e.to;}
   if state[e.to]==0 {next=e.to;}
  }
  if next<0 {state[at]=2;depth-=1;}else {state[next]=1;depth+=1;stack[depth]=next;}
 }
 return -1;
}
