// Source-unit syntax and admission. Native code reads files and owns storage.
#authority;
SU_Token :: struct {kind:u32;text:string;begin:int;end:int;}
SU_Load :: struct {path:string;begin:int;end:int;alias:string;alias_begin:int;}
SU_Scan :: struct {count:int;authority:bool;error:u32;offset:int;balanced:bool=true;claims:bool;owner:string;owner_begin:int;owner_end:int;}
// One name in a `#export a, b;` list, with its token and its directive's range.
SU_Export :: struct {name:string;at:int;begin:int;end:int;}
SU_Exports :: struct {count:int;error:u32;offset:int;}
SU_Visit :: struct {index:int= -1;action:u8;}

#test "a top-level load retains its path and source span" {
 t:=[4] SU_Token.[SU_Token.{kind=6,text="load",begin=2,end=7},SU_Token.{kind=5,text="part.coax",begin=8,end=19},SU_Token.{kind=15,begin=19,end=20},SU_Token.{}];
 out:[1] SU_Load;r:=SU_scan(t[..],out[..]);
 #assert r.error==0 && r.count==1 && !r.authority && r.balanced;
 #assert out[0].path=="part.coax" && out[0].begin==2 && out[0].end==20;
}
#test "authority belongs to its source unit, not the loaded unit" {
 t:=[3] SU_Token.[SU_Token.{kind=6,text="authority"},SU_Token.{kind=15},SU_Token.{}];out:[1] SU_Load;
 r:=SU_scan(t[..],out[..]);#assert r.authority && r.count==0 && r.error==0;
 t[0].text="other";#assert !SU_scan(t[..],out[..]).authority;
}
#forall "load syntax requires a string and a terminator" kind:0..<17 {
 t:=[4] SU_Token.[SU_Token.{kind=6,text="load",begin=3},SU_Token.{kind=cast(u32)kind,text="x.coax"},SU_Token.{kind=15},SU_Token.{}];out:[1] SU_Load;
 r:=SU_scan(t[..],out[..]);
 if kind==5 {#assert r.error==0 && r.count==1;}else {#assert r.error==1 && r.offset==3;}
 t[1].kind=5;t[2].kind=cast(u32)kind;r=SU_scan(t[..],out[..]);
 if kind==15 {#assert r.error==0;}else {#assert r.error==1;}
}
#test "truncated directives and exhausted output fail" {
 t:=[3] SU_Token.[SU_Token.{kind=6,text="load"},SU_Token.{kind=5,text="x"},SU_Token.{kind=15}];out:[1] SU_Load;
 #assert SU_scan(t[0..<1],out[..]).error==1;
 #assert SU_scan(t[0..<2],out[..]).error==1;
 #assert SU_scan(t[..],out[0..<0]).error==2;
 #assert SU_scan(t[0..<0],out[..]).error==0;
}
#test "paths cannot be empty or contain a NUL" {
 t:=[3] SU_Token.[SU_Token.{kind=6,text="load"},SU_Token.{kind=5,text=""},SU_Token.{kind=15}];out:[1] SU_Load;
 #assert SU_scan(t[..],out[..]).error==1;t[1].text="x\0.coax";#assert SU_scan(t[..],out[..]).error==1;
 t[1].text="space path.coax";#assert SU_scan(t[..],out[..]).error==0;
}
#forall "load is not an expression or a body directive" open:8..<14 {
 t:=[4] SU_Token.[SU_Token.{kind=cast(u32)open},SU_Token.{kind=6,text="load",begin=9},SU_Token.{kind=5,text="x"},SU_Token.{kind=15}];out:[1] SU_Load;
 // Opening delimiters are 8, 10 and 12. Closing delimiters mark imbalance.
 r:=SU_scan(t[..],out[..]);
 if open==8 || open==10 || open==12 {#assert r.error==1 && r.offset==9;}
 else {#assert !r.balanced;}
}
#test "balanced delimiters and nested authority are not file authority" {
 t:=[8] SU_Token.[SU_Token.{kind=10},SU_Token.{kind=8},SU_Token.{kind=9},SU_Token.{kind=12},SU_Token.{kind=13},SU_Token.{kind=6,text="authority"},SU_Token.{kind=15},SU_Token.{kind=11}];out:[1] SU_Load;
 r:=SU_scan(t[..],out[..]);#assert !r.authority && r.balanced && r.error==0;
 #assert !SU_scan(t[0..<7],out[..]).balanced;
}
#forall "source budget boundaries" units:126..<130, depth:30..<34, extra: -1..<3 {
 #assert SU_admit(units,depth,16777215,extra)==(units<128 && depth<32 && extra>=0 && extra<=1);
}
#test "negative or over-budget graph inputs are refused" {
 #assert SU_admit(0,0,0,0);#assert SU_admit(0,0,0,16777216);
 #assert !SU_admit(-1,0,0,0);#assert !SU_admit(0,-1,0,0);
 #assert !SU_admit(0,0,-1,0);#assert !SU_admit(0,0,16777217,0);
 #assert !SU_admit(0,0,0,16777217);#assert !SU_admit(0,0,0,-1);
}
#test "canonical identity distinguishes active cycles, done diamonds and new units" {
 paths:=[2] string.["root","shared"];states:=[2] u8.[1,2];
 a:=SU_visit(paths[..],states[..],"root");#assert a.action==2 && a.index==0;
 b:=SU_visit(paths[..],states[..],"shared");#assert b.action==1 && b.index==1;
 c:=SU_visit(paths[..],states[..],"new");#assert c.action==0 && c.index== -1;
 #assert SU_visit(paths[..],states[0..<1],"root").action==3;
}

#test "adjacent requests do not skip the next directive" {
 t:=[6] SU_Token.[SU_Token.{kind=6,text="load"},SU_Token.{kind=5,text="a"},SU_Token.{kind=15},SU_Token.{kind=6,text="load"},SU_Token.{kind=5,text="b"},SU_Token.{kind=15}];out:[2] SU_Load;
 r:=SU_scan(t[..],out[..]);#assert r.count==2 && out[1].path=="b";
 #assert SU_scan(t[..],out[0..<1]).error==2;
}
#test "delimiter matching and nesting overflow stay observable" {
 mismatch:=[2] SU_Token.[SU_Token.{kind=8},SU_Token.{kind=11}];out:[1] SU_Load;
 #assert !SU_scan(mismatch[..],out[..]).balanced;
 deep:[258] SU_Token;for i:0..<129 {deep[i].kind=10;deep[129+i].kind=11;}
 #assert !SU_scan(deep[..],out[..]).balanced;
 #assert SU_admit(0,0,16777216,0);
 paths:=[1] string.["x"];states:=[1] u8.[0];
 r:=SU_visit(paths[..],states[..],"x");#assert r.action==3 && r.index==0;
}

// Path imports with aliases: `#load "hud.coax" as hud;` binds the alias to
// the loaded unit's logical module. Module parameters and package search are
// refused explicitly (4 alias syntax, 5 module parameters, 6 package search).
#test "an aliased load keeps its path, alias and full span" {
 t:=[6] SU_Token.[SU_Token.{kind=6,text="load",begin=1,end=6},SU_Token.{kind=5,text="hud.coax",begin=7,end=17},SU_Token.{kind=1,text="as",begin=18,end=20},SU_Token.{kind=1,text="hud",begin=21,end=24},SU_Token.{kind=15,begin=24,end=25},SU_Token.{}];
 out:[1] SU_Load;r:=SU_scan(t[..],out[..]);
 #assert r.error==0 && r.count==1 && out[0].path=="hud.coax" && out[0].alias=="hud" && out[0].alias_begin==21 && out[0].begin==1 && out[0].end==25;
 plain:=[3] SU_Token.[t[0],t[1],SU_Token.{kind=15,end=18}];r=SU_scan(plain[..],out[..]);
 #assert r.error==0 && out[0].alias=="" && out[0].alias_begin==0 && out[0].end==18;
}
#forall "alias syntax: an identifier, then ';'" kind:0..<17 {
 t:=[5] SU_Token.[SU_Token.{kind=6,text="load",begin=2},SU_Token.{kind=5,text="m.coax"},SU_Token.{kind=1,text="as"},SU_Token.{kind=cast(u32)kind,text="m"},SU_Token.{kind=15}];out:[1] SU_Load;
 r:=SU_scan(t[..],out[..]);
 if kind==1 {#assert r.error==0 && r.count==1;}else {#assert r.error==4 && r.offset==2 && r.count==0;}
 t[3].kind=1;t[4].kind=cast(u32)kind;r=SU_scan(t[..],out[..]);
 if kind==15 {#assert r.error==0;}else if kind==8 {#assert r.error==5;}else {#assert r.error==4;}
}
#test "truncated aliases, other words and package paths are refused" {
 t:=[5] SU_Token.[SU_Token.{kind=6,text="load"},SU_Token.{kind=5,text="m.coax"},SU_Token.{kind=1,text="as"},SU_Token.{kind=1,text="m"},SU_Token.{kind=15}];out:[1] SU_Load;
 #assert SU_scan(t[0..<3],out[..]).error==4;#assert SU_scan(t[0..<4],out[..]).error==4;
 t[2].text="is";#assert SU_scan(t[..],out[..]).error==1;t[2].text="as";
 t[1].text="hud";#assert SU_scan(t[..],out[..]).error==6;
 t[1].text="dir/hud.coax";#assert SU_scan(t[..],out[..]).error==0 && out[0].alias=="m";
 t[1].text=".coax";#assert SU_scan(t[..],out[..]).error==6;
 t[1].text="a.coa";#assert SU_scan(t[..],out[..]).error==6;
 t[1].text="hud";t[2].text="x";#assert SU_scan(t[..],out[..]).error==1;
 t[1]=SU_Token.{kind=3,text="7"};t[2].text="as";#assert SU_scan(t[..],out[..]).error==1;
}
#forall "import paths name a .coax file" c:u8 {
 p:=[7] u8.['x','.','c','o','a','x',c];q:=[6] u8.[c,'.','c','o','a','x'];
 #assert !SU_path_file(cast(string) p[..]);#assert SU_path_file(cast(string) p[0..<6]);
 #assert SU_path_file(cast(string) q[..]);#assert !SU_path_file(cast(string) q[1..<6]);
}

// Logical modules (schema 1). `#module "a.b";` claims an authored owner for
// its physical unit; #load members without their own claim share the owner
// of the units that load them. Identity is (module, kind, name), never a
// path, line, flattening ordinal or C spelling.
#test "a top-level module claim retains its ID and directive span" {
 t:=[4] SU_Token.[SU_Token.{kind=6,text="module",begin=1,end=8},SU_Token.{kind=5,text="verse.hud",begin=9,end=20},SU_Token.{kind=15,begin=20,end=21},SU_Token.{}];
 out:[1] SU_Load;r:=SU_scan(t[..],out[..]);
 #assert r.error==0 && r.claims && r.owner=="verse.hud" && r.owner_begin==1 && r.owner_end==21 && r.count==0 && r.balanced;
 t[0].text="modules";r=SU_scan(t[..],out[..]);#assert r.error==0 && !r.claims && r.owner=="";
}
#forall "module syntax requires a valid string ID and a terminator" kind:0..<17 {
 t:=[4] SU_Token.[SU_Token.{kind=6,text="module",begin=4},SU_Token.{kind=cast(u32)kind,text="a.b"},SU_Token.{kind=15},SU_Token.{}];out:[1] SU_Load;
 r:=SU_scan(t[..],out[..]);
 if kind==5 {#assert r.error==0 && r.claims;}else {#assert r.error==3 && r.offset==4 && !r.claims;}
 t[1].kind=5;t[2].kind=cast(u32)kind;r=SU_scan(t[..],out[..]);
 if kind==15 {#assert r.error==0;}else {#assert r.error==3 && !r.claims;}
 t[2].kind=15;t[1].text="A.b";#assert SU_scan(t[..],out[..]).error==3;
}
#test "one claim per unit, at file scope, never truncated" {
 t:=[6] SU_Token.[SU_Token.{kind=6,text="module"},SU_Token.{kind=5,text="a"},SU_Token.{kind=15},SU_Token.{kind=6,text="module",begin=9},SU_Token.{kind=5,text="a"},SU_Token.{kind=15}];out:[1] SU_Load;
 r:=SU_scan(t[..],out[..]);#assert r.error==3 && r.offset==9;
 #assert SU_scan(t[0..<3],out[..]).error==0;
 #assert SU_scan(t[0..<1],out[..]).error==3;#assert SU_scan(t[0..<2],out[..]).error==3;
 nested:=[5] SU_Token.[SU_Token.{kind=10},SU_Token.{kind=6,text="module",begin=2},SU_Token.{kind=5,text="a"},SU_Token.{kind=15},SU_Token.{kind=11}];
 r=SU_scan(nested[..],out[..]);#assert r.error==3 && r.offset==2;
}
#test "a claim and loads share one unit scan" {
 t:=[6] SU_Token.[SU_Token.{kind=6,text="load",begin=0},SU_Token.{kind=5,text="part.coax"},SU_Token.{kind=15,end=5},SU_Token.{kind=6,text="module",begin=6},SU_Token.{kind=5,text="engine.hud"},SU_Token.{kind=15,end=30}];
 out:[1] SU_Load;r:=SU_scan(t[..],out[..]);
 #assert r.error==0 && r.count==1 && r.claims && r.owner=="engine.hud" && r.owner_begin==6 && r.owner_end==30;
}
#forall "module IDs: lowercase dotted segments" c:u8 {
 first:=[1] u8.[c];rest:=[2] u8.['a',c];
 lower:=c>='a' && c<='z';
 #assert SU_module_valid(cast(string) first[..])==lower;
 #assert SU_module_valid(cast(string) rest[..])==(lower || (c>='0' && c<='9') || c=='_');
}
#test "module ID segments, dots and length bounds" {
 #assert !SU_module_valid("");#assert !SU_module_valid(".");#assert !SU_module_valid("a.");
 #assert !SU_module_valid(".a");#assert !SU_module_valid("a..b");#assert !SU_module_valid("a.9b");
 #assert !SU_module_valid("a._b");#assert !SU_module_valid("a b");
 #assert SU_module_valid("a");#assert SU_module_valid("verse.everglade.guard_types");#assert SU_module_valid("x9.y_2.z");
 long:[129] u8;for i:0..<129 {long[i]='a';}
 #assert SU_module_valid(cast(string) long[0..<128]);#assert !SU_module_valid(cast(string) long[..]);
}
#forall "declaration names are identifiers" c:u8 {
 first:=[1] u8.[c];rest:=[2] u8.['_',c];
 alpha:=(c>='a' && c<='z') || (c>='A' && c<='Z') || c=='_';
 #assert SU_ident_valid(cast(string) first[..])==alpha;
 #assert SU_ident_valid(cast(string) rest[..])==(alpha || (c>='0' && c<='9'));
}
#test "identifier length bounds" {
 #assert !SU_ident_valid("");#assert SU_ident_valid("Vec2");#assert !SU_ident_valid("2v");
 long:[256] u8;for i:0..<256 {long[i]='Z';}
 #assert SU_ident_valid(cast(string) long[0..<255]);#assert !SU_ident_valid(cast(string) long[..]);
}
#test "membership: a claim is its own owner; members join their loaders' owners" {
 // -1: no owner yet (or an unowned loader); -2: two different owners.
 #assert SU_owner_join(-1,-1)== -1;#assert SU_owner_join(-1,3)==3;#assert SU_owner_join(3,3)==3;
 #assert SU_owner_join(3,-1)==3;#assert SU_owner_join(3,4)== -2;#assert SU_owner_join(4,3)== -2;
 #assert SU_owner_join(-2,3)== -2;#assert SU_owner_join(-2,-1)== -2;#assert SU_owner_join(0,0)==0;
 #assert SU_owner_join(-1,0)==0;#assert SU_owner_join(0,1)== -2;#assert SU_owner_join(0,-2)==0;
}
#forall "membership never depends on load or traversal order" a:-1..<3, b:-1..<3, c:-1..<3 {
 abc:=SU_owner_join(SU_owner_join(SU_owner_join(-1,a),b),c);
 #assert abc==SU_owner_join(SU_owner_join(SU_owner_join(-1,c),a),b);
 #assert abc==SU_owner_join(SU_owner_join(SU_owner_join(-1,b),c),a);
 #assert abc==SU_owner_join(SU_owner_join(SU_owner_join(-1,c),b),a);
}
#test "two canonical units may not claim one logical module" {
 claims:=[3] string.["","engine.hud","verse.guard"];
 #assert SU_claim_index(claims[..],"verse.guard")==2;#assert SU_claim_index(claims[..],"engine.hud")==1;
 #assert SU_claim_index(claims[..],"engine")== -1;#assert SU_claim_index(claims[..],"")== -1;
 #assert SU_claim_index(claims[0..<0],"engine.hud")== -1;
}
#test "canonical declaration tuples" {
 out:[96] u8;
 n:=SU_decl_id("verse.hud",1,"HudSlot",out[..]);
 #assert n==37 && cast(string) out[0..<n]=="coax.decl.v1:verse.hud:struct:HudSlot";
 n=SU_decl_id("verse.hud",0,"hud_slot",out[..]);#assert cast(string) out[0..<n]=="coax.decl.v1:verse.hud:proc:hud_slot";
 n=SU_decl_id("a",2,"E",out[..]);#assert cast(string) out[0..<n]=="coax.decl.v1:a:enum:E";
 n=SU_decl_id("a",3,"K",out[..]);#assert cast(string) out[0..<n]=="coax.decl.v1:a:const:K";
 #assert SU_decl_id("a",4,"K",out[..])== -1;#assert SU_decl_id("A",3,"K",out[..])== -1;
 #assert SU_decl_id("a",3,"1K",out[..])== -1;#assert SU_decl_id("",3,"K",out[..])== -1;
}
#forall "a tuple fits exactly or is refused" room:20..<24 {
 out:[24] u8;
 // "coax.decl.v1:a:const:K" is 22 bytes.
 n:=SU_decl_id("a",3,"K",out[0..<room]);
 if room>=22 {#assert n==22 && out[21]=='K' && out[14]==':';}else {#assert n== -1;}
}
#forall "kind, name and module each change the ID" k:0..<4, j:0..<4 {
 a:[64] u8;b:[64] u8;
 n:=SU_decl_id("m.x",cast(u8)k,"Name",a[..]);m:=SU_decl_id("m.x",cast(u8)j,"Name",b[..]);
 #assert (cast(string) a[0..<n]==cast(string) b[0..<m])==(k==j);
 m=SU_decl_id("m.y",cast(u8)k,"Name",b[..]);#assert cast(string) a[0..<n]!=cast(string) b[0..<m];
 m=SU_decl_id("m.x",cast(u8)k,"Namf",b[..]);#assert cast(string) a[0..<n]!=cast(string) b[0..<m];
}

// Conservative revisions (schema 1). A revision is SHA-256 over a canonical
// text of lowercase hex digests listed in ascending order, so it never
// depends on paths, load order or traversal. Kind 0 is a module's content
// (its member units' hashes), kind 1 its revision (its content revision, then
// the revisions and unowned unit hashes it depends on).
#forall "a digest is 64 lowercase hex bytes" c:u8 {
 d:[64] u8;for i:0..<64 {d[i]='0';}
 d[17]=c;hex:=(c>='0' && c<='9') || (c>='a' && c<='f');
 #assert SU_digest_valid(cast(string) d[..])==hex;
 #assert !SU_digest_valid(cast(string) d[0..<63]);
}
#test "digest order is bytewise and total" {
 a:[64] u8;b:[64] u8;for i:0..<64 {a[i]='0';b[i]='0';}
 #assert SU_digest_cmp(cast(string) a[..],cast(string) b[..])==0;
 b[63]='1';#assert SU_digest_cmp(cast(string) a[..],cast(string) b[..])== -1;#assert SU_digest_cmp(cast(string) b[..],cast(string) a[..])==1;
 a[0]='f';#assert SU_digest_cmp(cast(string) a[..],cast(string) b[..])==1;
 #assert SU_digest_cmp("ab","abc")== -1;#assert SU_digest_cmp("abc","ab")==1;#assert SU_digest_cmp("","")==0;
}
#test "revision inputs are ascending sets of valid digests" {
 lo:[64] u8;hi:[64] u8;for i:0..<64 {lo[i]='1';hi[i]='e';}
 l:=cast(string) lo[..];h:=cast(string) hi[..];
 up:=[2] string.[l,h];down:=[2] string.[h,l];same:=[2] string.[l,l];bad:=[2] string.[l,"x"];
 #assert SU_digests_sorted(up[..]);#assert !SU_digests_sorted(down[..]);#assert SU_digests_sorted(same[..]);
 #assert !SU_digests_sorted(bad[..]);#assert SU_digests_sorted(up[0..<0]);#assert SU_digests_sorted(down[0..<1]);
 one:=[1] string.["x"];#assert !SU_digests_sorted(one[..]);
}
#test "canonical revision text" {
 a:[64] u8;b:[64] u8;for i:0..<64 {a[i]='a';b[i]='b';}
 own:=[1] string.[cast(string) a[..]];deps:=[1] string.[cast(string) b[..]];out:[256] u8;
 n:=SU_revision_text(1,own[..],deps[..],out[..]);
 // "coax.revision.v1:module\n" (24) + 65 + "-\n" (2) + 65
 #assert n==156;
 t:=cast(string) out[0..<n];
 #assert cast(string) out[0..<24]=="coax.revision.v1:module\n" && out[88]=='\n' && out[89]=='-' && out[90]=='\n' && out[155]=='\n' && out[91]=='b' && out[24]=='a' && out[87]=='a';
 n=SU_revision_text(0,own[..],deps[0..<0],out[..]);
 #assert n==92 && cast(string) out[0..<25]=="coax.revision.v1:content\n" && out[89]=='\n' && out[90]=='-' && out[91]=='\n';
 #assert SU_revision_text(2,own[..],deps[..],out[..])== -1;
 rev:=[2] string.[cast(string) b[..],cast(string) a[..]];
 #assert SU_revision_text(0,rev[..],deps[0..<0],out[..])== -1;
 #assert SU_revision_text(1,own[..],rev[..],out[..])== -1;
 #assert t!=cast(string) out[0..<n];
}
#forall "revision text fits exactly or is refused" room:154..<158 {
 a:[64] u8;for i:0..<64 {a[i]='c';}own:=[1] string.[cast(string) a[..]];deps:=[1] string.[cast(string) a[..]];out:[160] u8;
 n:=SU_revision_text(1,own[..],deps[..],out[0..<room]);
 if room>=156 {#assert n==156 && out[155]=='\n';}else {#assert n== -1;}
}
#test "own and dependency digests are kept apart" {
 a:[64] u8;b:[64] u8;for i:0..<64 {a[i]='a';b[i]='b';}
 both:=[2] string.[cast(string) a[..],cast(string) b[..]];x:[200] u8;y:[200] u8;
 n:=SU_revision_text(1,both[..],both[0..<0],x[..]);m:=SU_revision_text(1,both[0..<1],both[1..<2],y[..]);
 #assert n>0 && m>0 && cast(string) x[0..<n]!=cast(string) y[0..<m];
}

#forall "execution and mutation obligations retain source ownership" authority:bool, entry:bool, mutation:bool {
 #assert SU_check_required(authority,entry,mutation)==(authority || (entry && mutation));
}
SU_check_required :: (authority:bool,entry:bool,mutation:bool)->bool #export_c {return authority || (entry && mutation);}

// Export lists: `#export a, b;` at file scope names declarations its logical
// module makes visible to other modules. Error 1 is syntax, 2 capacity,
// 3 a qualified name (a reexport, which is not supported).
#test "export lists record each name with its token and directive range" {
 t:=[9] SU_Token.[SU_Token.{kind=6,text="export",begin=0,end=7},SU_Token.{kind=1,text="a",begin=8,end=9},SU_Token.{kind=14,begin=9,end=10},
  SU_Token.{kind=1,text="b",begin=11,end=12},SU_Token.{kind=15,begin=12,end=13},
  SU_Token.{kind=6,text="export",begin=14,end=21},SU_Token.{kind=1,text="c",begin=22,end=23},SU_Token.{kind=15,begin=23,end=24},SU_Token.{}];
 out:[3] SU_Export;r:=SU_exports(t[..],out[..]);
 #assert r.error==0 && r.count==3;
 #assert out[0].name=="a" && out[0].at==8 && out[0].begin==0 && out[0].end==13;
 #assert out[1].name=="b" && out[1].at==11 && out[1].begin==0 && out[1].end==13;
 #assert out[2].name=="c" && out[2].at==22 && out[2].begin==14 && out[2].end==24;
}
#test "nested and other directives are not export lists" {
 t:=[8] SU_Token.[SU_Token.{kind=10},SU_Token.{kind=6,text="export",begin=3},SU_Token.{kind=1,text="a"},SU_Token.{kind=15},SU_Token.{kind=11},
  SU_Token.{kind=6,text="export_c"},SU_Token.{kind=1,text="exports"},SU_Token.{}];
 out:[2] SU_Export;r:=SU_exports(t[..],out[..]);#assert r.error==1 && r.offset==3 && r.count==0;
 u:=[6] SU_Token.[SU_Token.{kind=8},SU_Token.{kind=9},SU_Token.{kind=12},SU_Token.{kind=13},SU_Token.{kind=6,text="export_c"},SU_Token.{}];
 r=SU_exports(u[..],out[..]);#assert r.error==0 && r.count==0;
 v:=[7] SU_Token.[SU_Token.{kind=8},SU_Token.{kind=10},SU_Token.{kind=12},SU_Token.{kind=6,text="export",begin=4},SU_Token.{kind=1,text="a"},SU_Token.{kind=15},SU_Token.{}];
 r=SU_exports(v[..],out[..]);#assert r.error==1 && r.offset==4;
}
#forall "only file scope admits an export list" pair:0..<3, inside:bool {
 opens:=[3] u32.[8,10,12];o:=opens[pair];
 t:=[6] SU_Token.[SU_Token.{kind=o},SU_Token.{kind=o+1},SU_Token.{kind=6,text="export",begin=2},SU_Token.{kind=1,text="a"},SU_Token.{kind=15},SU_Token.{}];
 if inside {t[1]=SU_Token.{kind=6,text="export",begin=1};t[2]=SU_Token.{kind=1,text="a"};t[3]=SU_Token.{kind=15};t[4]=SU_Token.{kind=o+1};}
 out:[1] SU_Export;r:=SU_exports(t[..],out[..]);
 if inside {#assert r.error==1 && r.offset==1 && r.count==0;}else {#assert r.error==0 && r.count==1 && out[0].name=="a";}
}
#test "a reexport after a plain name keeps no partial list" {
 t:=[7] SU_Token.[SU_Token.{kind=6,text="export",begin=0},SU_Token.{kind=1,text="a",begin=8},SU_Token.{kind=14},SU_Token.{kind=1,text="m",begin=11},SU_Token.{kind=20},SU_Token.{kind=1,text="b"},SU_Token.{kind=15}];
 out:[2] SU_Export;r:=SU_exports(t[..],out[..]);#assert r.error==3 && r.offset==11 && r.count==0;
 u:=[3] SU_Token.[SU_Token.{kind=6,text="export",begin=0},SU_Token.{kind=1,text="a",begin=8},SU_Token.{kind=15,end=10}];
 r=SU_exports(u[..],out[..]);#assert r.error==0 && r.count==1 && out[0].end==10;
}
#forall "an export list is names separated by commas and ended by ';'" variant:0..<9 {
 // 0 empty, 1 trailing comma, 2 no ';', 3 a string, 4 two names without a comma, 5 at EOF, 6 ok, 7 a.b, 8 capacity
 t:=[6] SU_Token.[SU_Token.{kind=6,text="export",begin=5},SU_Token.{kind=1,text="a",begin=6},SU_Token.{kind=15},SU_Token.{},SU_Token.{},SU_Token.{}];n:=4;
 if variant==0 {t[1]=SU_Token.{kind=15};}
 if variant==1 {t[2]=SU_Token.{kind=14};t[3]=SU_Token.{kind=15};n=5;}
 if variant==2 {t[2]=SU_Token.{kind=1,text="b"};}
 if variant==3 {t[1]=SU_Token.{kind=5,text="a"};}
 if variant==4 {t[2]=SU_Token.{kind=1,text="b"};t[3]=SU_Token.{kind=15};n=5;}
 if variant==5 {n=2;}
 if variant==7 {t[2]=SU_Token.{kind=20,begin=7};t[3]=SU_Token.{kind=1,text="b"};t[4]=SU_Token.{kind=15};n=6;}
 room:=2;if variant==8 {t[2]=SU_Token.{kind=14};t[3]=SU_Token.{kind=1,text="b"};t[4]=SU_Token.{kind=15};n=6;room=1;}
 out:[2] SU_Export;r:=SU_exports(t[0..<n],out[0..<room]);
 if variant==6 {#assert r.error==0 && r.count==1 && out[0].name=="a" && out[0].at==6;}
 else if variant==7 {#assert r.error==3 && r.offset==6;}
 else if variant==8 {#assert r.error==2 && r.offset==5 && r.count==1;}
 else {#assert r.error==1 && r.offset==5 && r.count==0;}
}
// Implementations follow only after their checks have been written.
SU_scan :: (tokens:[] SU_Token,out:[] SU_Load)->SU_Scan #export_c {
 r:SU_Scan;stack:[128] u32;depth:=0;i:=0;
 while i<tokens.count {
  t:=tokens[i];
  if t.kind==6 && t.text=="load" {
   r.offset=t.begin;
   if depth!=0 || i+2>=tokens.count {r.error=1;return r;}
   path:=tokens[i+1];close:=i+2;end:=tokens[close];alias:="";alias_begin:=0;
   if path.kind==5 && end.kind==1 && end.text=="as" {
    if i+4>=tokens.count || tokens[i+3].kind!=1 {r.error=4;return r;}
    close=i+4;end=tokens[close];if end.kind==8 {r.error=5;return r;}if end.kind!=15 {r.error=4;return r;}
    if !SU_path_file(path.text) {r.error=6;return r;}
    alias=tokens[i+3].text;alias_begin=tokens[i+3].begin;
   }
   if path.kind!=5 || end.kind!=15 || path.text.count==0 {r.error=1;return r;}
   for c:path.text {if c==0 {r.error=1;return r;}}
   if r.count>=out.count {r.error=2;return r;}
   // The path, alias and terminator that follow are inert tokens for this scan.
   out[r.count]=SU_Load.{path=path.text,begin=t.begin,end=end.end,alias=alias,alias_begin=alias_begin};r.count+=1;
  }
  if t.kind==6 && t.text=="module" {
   r.offset=t.begin;
   if depth!=0 || r.claims || i+2>=tokens.count {r.error=3;return r;}
   id:=tokens[i+1];end:=tokens[i+2];
   if id.kind!=5 || end.kind!=15 || !SU_module_valid(id.text) {r.error=3;return r;}
   r.claims=true;r.owner=id.text;r.owner_begin=t.begin;r.owner_end=end.end;i+=3;continue;
  }
  if t.kind==6 && t.text=="authority" && depth==0 {r.authority=true;}
  if t.kind==8 || t.kind==10 || t.kind==12 {
   if depth<stack.count {stack[depth]=t.kind;}else {r.balanced=false;}
   depth+=1;
  } else if t.kind==9 || t.kind==11 || t.kind==13 {
   if depth==0 {r.balanced=false;}else {
    depth-=1;if depth<stack.count && stack[depth]+1!=t.kind {r.balanced=false;}
   }
  }
  i+=1;
 }
 if depth!=0 {r.balanced=false;}
 return r;
}
SU_exports :: (tokens:[] SU_Token,out:[] SU_Export)->SU_Exports #export_c {
 r:SU_Exports;depth:=0;i:=0;
 while i<tokens.count {
  t:=tokens[i];
  if t.kind==8 || t.kind==10 || t.kind==12 {depth+=1;}else if t.kind==9 || t.kind==11 || t.kind==13 {depth-=1;}
  if t.kind==6 && t.text=="export" {
   r.offset=t.begin;if depth!=0 {r.error=1;return r;}
   first:=r.count;j:=i+1;
   while true {
    if j+1>=tokens.count || tokens[j].kind!=1 {r.count=first;r.error=1;return r;}
    if tokens[j+1].kind==20 {r.count=first;r.error=3;r.offset=tokens[j].begin;return r;}
    if r.count>=out.count {r.error=2;return r;}
    out[r.count]=SU_Export.{name=tokens[j].text,at=tokens[j].begin,begin=t.begin};r.count+=1;
    if tokens[j+1].kind==15 {break;}
    if tokens[j+1].kind!=14 {r.count=first;r.error=1;return r;}
    j+=2;
   }
   for k:first..<r.count {out[k].end=tokens[j+1].end;}
   i=j+2;continue;
  }
  i+=1;
 }
 return r;
}
SU_admit :: (units:int,depth:int,total:int,bytes:int)->bool #export_c {
 return units>=0 && units<128 && depth>=0 && depth<32 && total>=0 && bytes>=0 && bytes<=16777216-total;
}
SU_visit :: (paths:[] string,states:[] u8,path:string)->SU_Visit #export_c {
 if paths.count!=states.count {return SU_Visit.{action=3};}
 for i:0..<paths.count {
  if paths[i]==path {
   if states[i]==1 {return SU_Visit.{index=i,action=2};}
   if states[i]==2 {return SU_Visit.{index=i,action=1};}
   return SU_Visit.{index=i,action=3};
  }
 }
 return SU_Visit.{};
}
SU_module_valid :: (id:string)->bool #export_c {
 if id.count==0 || id.count>128 {return false;}
 start:=true;
 for c:id {
  if c=='.' {if start {return false;}start=true;continue;}
  lower:=c>='a' && c<='z';
  if start {if !lower {return false;}start=false;continue;}
  if !lower && !(c>='0' && c<='9') && c!='_' {return false;}
 }
 return !start;
}
SU_ident_valid :: (name:string)->bool #export_c {
 if name.count==0 || name.count>255 {return false;}
 for c, i:name {
  alpha:=(c>='a' && c<='z') || (c>='A' && c<='Z') || c=='_';
  if !alpha && (i==0 || !(c>='0' && c<='9')) {return false;}
 }
 return true;
}
SU_path_file :: (path:string)->bool #export_c {
 return path.count>5 && path[path.count-5..<path.count]==".coax";
}
SU_owner_join :: (current:int,reaching:int)->int #export_c {
 if current== -2 || reaching<0 || current==reaching {return current;}
 if current== -1 {return reaching;}
 return -2;
}
SU_claim_index :: (claims:[] string,id:string)->int #export_c {
 for c, i:claims {if c.count!=0 && c==id {return i;}}
 return -1;
}
SU_DECL_PREFIX :: "coax.decl.v1:";
SU_DECL_KINDS :: [4] string.["proc","struct","enum","const"];
SU_decl_id :: (module:string,kind:u8,name:string,out:[] u8)->int #export_c {
 if !SU_module_valid(module) || kind>=4 || !SU_ident_valid(name) {return -1;}
 k:=SU_DECL_KINDS[kind];
 if out.count<SU_DECL_PREFIX.count+module.count+k.count+name.count+2 {return -1;}
 n:=0;
 for c:SU_DECL_PREFIX {out[n]=c;n+=1;}
 for c:module {out[n]=c;n+=1;}
 out[n]=':';n+=1;
 for c:k {out[n]=c;n+=1;}
 out[n]=':';n+=1;
 for c:name {out[n]=c;n+=1;}
 return n;
}
SU_digest_valid :: (d:string)->bool #export_c {
 if d.count!=64 {return false;}
 for c:d {if !((c>='0' && c<='9') || (c>='a' && c<='f')) {return false;}}
 return true;
}
SU_digest_cmp :: (a:string,b:string)->int #export_c {
 for c, i:a {
  if i>=b.count {return 1;}
  if c<b[i] {return -1;}
  if c>b[i] {return 1;}
 }
 if a.count<b.count {return -1;}
 return 0;
}
SU_digests_sorted :: (ds:[] string)->bool #export_c {
 for d, i:ds {
  if !SU_digest_valid(d) {return false;}
  if i>0 && SU_digest_cmp(ds[i-1],d)>0 {return false;}
 }
 return true;
}
SU_REVISION_KINDS :: [2] string.["content","module"];
SU_revision_text :: (kind:u8,own:[] string,deps:[] string,out:[] u8)->int #export_c {
 if kind>=2 || !SU_digests_sorted(own) || !SU_digests_sorted(deps) {return -1;}
 head:="coax.revision.v1:";k:=SU_REVISION_KINDS[kind];
 if out.count<head.count+k.count+1+65*own.count+2+65*deps.count {return -1;}
 n:=0;
 for c:head {out[n]=c;n+=1;}
 for c:k {out[n]=c;n+=1;}
 out[n]='\n';n+=1;
 for d:own {for c:d {out[n]=c;n+=1;}out[n]='\n';n+=1;}
 out[n]='-';out[n+1]='\n';n+=2;
 for d:deps {for c:d {out[n]=c;n+=1;}out[n]='\n';n+=1;}
 return n;
}
