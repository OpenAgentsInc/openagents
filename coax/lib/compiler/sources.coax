// Source-unit syntax and admission. Native code reads files and owns storage.
#authority;
SU_Token :: struct {kind:u32;text:string;begin:int;end:int;}
SU_Load :: struct {path:string;begin:int;end:int;}
SU_Scan :: struct {count:int;authority:bool;error:u32;offset:int;balanced:bool=true;}
SU_Visit :: struct {index:int= -1;action:u8;}

#test "a top-level load retains its path and source span" {
 t:=[4] SU_Token.[SU_Token.{kind=6,text="load",begin=2,end=7},SU_Token.{kind=5,text="part.coax",begin=8,end=19},SU_Token.{kind=15,begin=19,end=20},SU_Token.{}];
 out:[1] SU_Load;r:=SU_scan(t[..],out[..]);
 #assert r.error==0 && r.count==1 && !r.authority && r.balanced;
 #assert out[0].path=="part.coax" && out[0].begin==2 && out[0].end==20;
}
#test "authority belongs to its source unit, not the loaded unit" {
 t:=[3] SU_Token.[SU_Token.{kind=6,text="authority"},SU_Token.{kind=15},SU_Token.{}];out:[1] SU_Load;
 r:=SU_scan(t[..],out[..]);#assert r.authority && r.count==0 && r.error==0;
 t[0].text="other";#assert !SU_scan(t[..],out[..]).authority;
}
#forall "load syntax requires a string and a terminator" kind:0..<17 {
 t:=[4] SU_Token.[SU_Token.{kind=6,text="load",begin=3},SU_Token.{kind=cast(u32)kind,text="x.coax"},SU_Token.{kind=15},SU_Token.{}];out:[1] SU_Load;
 r:=SU_scan(t[..],out[..]);
 if kind==5 {#assert r.error==0 && r.count==1;}else {#assert r.error==1 && r.offset==3;}
 t[1].kind=5;t[2].kind=cast(u32)kind;r=SU_scan(t[..],out[..]);
 if kind==15 {#assert r.error==0;}else {#assert r.error==1;}
}
#test "truncated directives and exhausted output fail" {
 t:=[3] SU_Token.[SU_Token.{kind=6,text="load"},SU_Token.{kind=5,text="x"},SU_Token.{kind=15}];out:[1] SU_Load;
 #assert SU_scan(t[0..<1],out[..]).error==1;
 #assert SU_scan(t[0..<2],out[..]).error==1;
 #assert SU_scan(t[..],out[0..<0]).error==2;
 #assert SU_scan(t[0..<0],out[..]).error==0;
}
#test "paths cannot be empty or contain a NUL" {
 t:=[3] SU_Token.[SU_Token.{kind=6,text="load"},SU_Token.{kind=5,text=""},SU_Token.{kind=15}];out:[1] SU_Load;
 #assert SU_scan(t[..],out[..]).error==1;t[1].text="x\0.coax";#assert SU_scan(t[..],out[..]).error==1;
 t[1].text="space path.coax";#assert SU_scan(t[..],out[..]).error==0;
}
#forall "load is not an expression or a body directive" open:8..<14 {
 t:=[4] SU_Token.[SU_Token.{kind=cast(u32)open},SU_Token.{kind=6,text="load",begin=9},SU_Token.{kind=5,text="x"},SU_Token.{kind=15}];out:[1] SU_Load;
 // Opening delimiters are 8, 10 and 12. Closing delimiters mark imbalance.
 r:=SU_scan(t[..],out[..]);
 if open==8 || open==10 || open==12 {#assert r.error==1 && r.offset==9;}
 else {#assert !r.balanced;}
}
#test "balanced delimiters and nested authority are not file authority" {
 t:=[8] SU_Token.[SU_Token.{kind=10},SU_Token.{kind=8},SU_Token.{kind=9},SU_Token.{kind=12},SU_Token.{kind=13},SU_Token.{kind=6,text="authority"},SU_Token.{kind=15},SU_Token.{kind=11}];out:[1] SU_Load;
 r:=SU_scan(t[..],out[..]);#assert !r.authority && r.balanced && r.error==0;
 #assert !SU_scan(t[0..<7],out[..]).balanced;
}
#forall "source budget boundaries" units:62..<66, depth:30..<34, extra: -1..<3 {
 #assert SU_admit(units,depth,16777215,extra)==(units<64 && depth<32 && extra>=0 && extra<=1);
}
#test "negative or over-budget graph inputs are refused" {
 #assert SU_admit(0,0,0,0);#assert SU_admit(0,0,0,16777216);
 #assert !SU_admit(-1,0,0,0);#assert !SU_admit(0,-1,0,0);
 #assert !SU_admit(0,0,-1,0);#assert !SU_admit(0,0,16777217,0);
 #assert !SU_admit(0,0,0,16777217);#assert !SU_admit(0,0,0,-1);
}
#test "canonical identity distinguishes active cycles, done diamonds and new units" {
 paths:=[2] string.["root","shared"];states:=[2] u8.[1,2];
 a:=SU_visit(paths[..],states[..],"root");#assert a.action==2 && a.index==0;
 b:=SU_visit(paths[..],states[..],"shared");#assert b.action==1 && b.index==1;
 c:=SU_visit(paths[..],states[..],"new");#assert c.action==0 && c.index== -1;
 #assert SU_visit(paths[..],states[0..<1],"root").action==3;
}

#test "adjacent requests do not skip the next directive" {
 t:=[6] SU_Token.[SU_Token.{kind=6,text="load"},SU_Token.{kind=5,text="a"},SU_Token.{kind=15},SU_Token.{kind=6,text="load"},SU_Token.{kind=5,text="b"},SU_Token.{kind=15}];out:[2] SU_Load;
 r:=SU_scan(t[..],out[..]);#assert r.count==2 && out[1].path=="b";
 #assert SU_scan(t[..],out[0..<1]).error==2;
}
#test "delimiter matching and nesting overflow stay observable" {
 mismatch:=[2] SU_Token.[SU_Token.{kind=8},SU_Token.{kind=11}];out:[1] SU_Load;
 #assert !SU_scan(mismatch[..],out[..]).balanced;
 deep:[258] SU_Token;for i:0..<129 {deep[i].kind=10;deep[129+i].kind=11;}
 #assert !SU_scan(deep[..],out[..]).balanced;
 #assert SU_admit(0,0,16777216,0);
 paths:=[1] string.["x"];states:=[1] u8.[0];
 r:=SU_visit(paths[..],states[..],"x");#assert r.action==3 && r.index==0;
}

#forall "execution and mutation obligations retain source ownership" authority:bool, entry:bool, mutation:bool {
 #assert SU_check_required(authority,entry,mutation)==(authority || (entry && mutation));
}
SU_check_required :: (authority:bool,entry:bool,mutation:bool)->bool #export_c {return authority || (entry && mutation);}

// Implementations follow only after their checks have been written.
SU_scan :: (tokens:[] SU_Token,out:[] SU_Load)->SU_Scan #export_c {
 r:SU_Scan;stack:[128] u32;depth:=0;i:=0;
 while i<tokens.count {
  t:=tokens[i];
  if t.kind==6 && t.text=="load" {
   r.offset=t.begin;
   if depth!=0 || i+2>=tokens.count {r.error=1;return r;}
   path:=tokens[i+1];end:=tokens[i+2];
   if path.kind!=5 || end.kind!=15 || path.text.count==0 {r.error=1;return r;}
   for c:path.text {if c==0 {r.error=1;return r;}}
   if r.count>=out.count {r.error=2;return r;}
   out[r.count]=SU_Load.{path=path.text,begin=t.begin,end=end.end};r.count+=1;i+=3;continue;
  }
  if t.kind==6 && t.text=="authority" && depth==0 {r.authority=true;}
  if t.kind==8 || t.kind==10 || t.kind==12 {
   if depth<stack.count {stack[depth]=t.kind;}else {r.balanced=false;}
   depth+=1;
  } else if t.kind==9 || t.kind==11 || t.kind==13 {
   if depth==0 {r.balanced=false;}else {
    depth-=1;if depth<stack.count && stack[depth]+1!=t.kind {r.balanced=false;}
   }
  }
  i+=1;
 }
 if depth!=0 {r.balanced=false;}
 return r;
}
SU_admit :: (units:int,depth:int,total:int,bytes:int)->bool #export_c {
 return units>=0 && units<64 && depth>=0 && depth<32 && total>=0 && bytes>=0 && bytes<=16777216-total;
}
SU_visit :: (paths:[] string,states:[] u8,path:string)->SU_Visit #export_c {
 if paths.count!=states.count {return SU_Visit.{action=3};}
 for i:0..<paths.count {
  if paths[i]==path {
   if states[i]==1 {return SU_Visit.{index=i,action=2};}
   if states[i]==2 {return SU_Visit.{index=i,action=1};}
   return SU_Visit.{index=i,action=3};
  }
 }
 return SU_Visit.{};
}
