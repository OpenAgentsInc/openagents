// Fixed binary64 sin/cos/exp/log for the evaluator and emitted C (#12917).
// Authoritative Coax; bootstrap/strict-math.c is its checked generated seed.
// IEEE round-to-nearest, gradual underflow, no contraction or reassociation.
// f32 intrinsics widen exactly, use these kernels, then round once to f32.
// These are fixed approximations, not correctly rounded transcendentals.
//
// The near-angle kernels and exp/log coefficients derive from fdlibm:
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
// Developed at SunSoft, a Sun Microsystems, Inc. business.
// Permission to use, copy, modify, and distribute this software is freely
// granted, provided that this notice is preserved.
// https://netlib.org/fdlibm/ (k_sin.c, k_cos.c, e_exp.c, e_log.c,
// e_rem_pio2.c's 1584-bit 2/pi table).
// Small-angle reduction follows psionic/lib/strict-math.coax. Large angles
// use an integer product with 2/pi, retaining three 53-bit fractional chunks.

#test "fixed math pins are identical in the evaluator and generated C" {
    #assert SM_sin(4)==-0.7568024953079282;
    #assert SM_cos(4)==-0.65364362086361194;
    #assert SM_exp(1)==2.7182818284590455;
    #assert SM_log(3)==1.0986122886681096;
    #assert SM_log(1.0000000000000002)==2.2204460492503128e-16;
    #assert SM_sin(3.141592653589793)==1.2246467991473532e-16;
    #assert SM_cos(1.5707963267948966)==6.123233995736766e-17;
}
#test "signed zeros and subnormal inputs keep their bits" {
    #assert f64_bits(SM_sin(-0.0))==0x8000000000000000;
    #assert f64_bits(SM_sin(f64_from_bits(1)))==1;
    #assert SM_cos(f64_from_bits(1))==1 && SM_exp(f64_from_bits(1))==1;
    #assert f64_bits(SM_log(1))==0;
    #assert SM_log(f64_from_bits(1))==-744.44007192138122;
}
#test "exp preserves gradual underflow and its finite upper edge" {
    #assert SM_exp(-740)==4.2e-322;
    #assert SM_exp(-745)==f64_from_bits(1);
    #assert SM_exp(-746)==0;
    #assert SM_exp(709.78271289338397)==1.7976931348622732e308;
}
#test "large-angle reduction retains the quadrant through the largest double" {
    // Independently rounded references, with a two-ulp bound for the fixed kernels.
    xs:=[6]f64.[1647099.1,1e20,1e100,1e200,1e300,1.7976931348623157e308];
    ss:=[6]f64.[-0.22716471067627672,-0.6452512852657808,-0.3806377310050287,-0.6439687185395058,-0.8178819121159085,0.004961954789184062];
    cc:=[6]f64.[0.9738563519448664,0.7639704044417283,0.9247242387519338,0.7650518214752429,-0.5753861119575491,-0.9999876894265599];
    for i:0..<6 {
        ds:=cast(int) f64_bits(abs(SM_sin(xs[i])))-cast(int) f64_bits(abs(ss[i]));
        dc:=cast(int) f64_bits(abs(SM_cos(xs[i])))-cast(int) f64_bits(abs(cc[i]));
        #assert ds>=-2 && ds<=2 && dc>=-2 && dc<=2;
        #assert SM_sin(-xs[i])==-SM_sin(xs[i]) && SM_cos(-xs[i])==SM_cos(xs[i]);
    }
}

SM_LIMIT :: 1647099.0;                       // the small-angle reduction limit: n <= 2^20
SM_INVPIO2 :: 6.36619772367581382433e-01;    // 2/pi
SM_PIO2_1 :: 1.57079632673412561417e+00;     // pi/2's first 33 bits
SM_PIO2_2 :: 6.07710050630396597660e-11;     // its next 33
SM_PIO2_3 :: 2.02226624871116645580e-21;     // the 33 after those
SM_PIO2_3T :: 8.47842766036889956997e-32;    // pi/2 minus the three pieces
SM_LN2_HI :: 6.93147180369123816490e-01;     // ln 2's first 32 bits: k ln2_hi is exact
SM_LN2_LO :: 1.90821492927058770002e-10;     // ln 2 - SM_LN2_HI
SM_INVLN2 :: 1.44269504088896338700e+00;     // 1/ln 2
SM_EXP_OVER :: 709.782712893383973096;       // past it, e^x overflows
// Subnormal exp results are scaled in two exact powers of two, below.
SM_MAX :: 1.7976931348623157e308;            // the largest finite double
// fdlibm's polynomial coefficients: sine, cosine, exp and log.
SM_S1 :: -1.66666666666666324348e-01; SM_S2 :: 8.33333333332248946124e-03; SM_S3 :: -1.98412698298579493134e-04;
SM_S4 :: 2.75573137070700676789e-06; SM_S5 :: -2.50507602534068634195e-08; SM_S6 :: 1.58969099521155010221e-10;
SM_C1 :: 4.16666666666666019037e-02; SM_C2 :: -1.38888888888741095749e-03; SM_C3 :: 2.48015872894767294178e-05;
SM_C4 :: -2.75573143513906633035e-07; SM_C5 :: 2.08757232129817482790e-09; SM_C6 :: -1.13596475577881948265e-11;
SM_P1 :: 1.66666666666666019037e-01; SM_P2 :: -2.77777777770155933842e-03; SM_P3 :: 6.61375632143793436117e-05;
SM_P4 :: -1.65339022054652515390e-06; SM_P5 :: 4.13813679705723846039e-08;
SM_LG1 :: 6.666666666666735130e-01; SM_LG2 :: 3.999999999940941908e-01; SM_LG3 :: 2.857142874366239149e-01;
SM_LG4 :: 2.222219843214978396e-01; SM_LG5 :: 1.818357216161805012e-01; SM_LG6 :: 1.531383769920937332e-01;
SM_LG7 :: 1.479819860511658591e-01;


// sin(x + y) for |x + y| <= pi/4, y the tail of x: fdlibm __kernel_sin.
sm_ksin :: (x:f64,y:f64)->f64 {
    z:=x*x;w:=z*z;v:=z*x;
    r:=SM_S2+z*(SM_S3+z*SM_S4)+z*w*(SM_S5+z*SM_S6);
    return x-((z*(0.5*y-v*r)-y)-v*SM_S1);
}
// cos(x + y) for |x + y| <= pi/4: fdlibm __kernel_cos.
sm_kcos :: (x:f64,y:f64)->f64 {
    z:=x*x;w:=z*z;
    r:=z*(SM_C1+z*(SM_C2+z*SM_C3))+w*w*(SM_C4+z*(SM_C5+z*SM_C6));
    hz:=0.5*z;v:=1-hz;
    return v+(((1-v)-hz)+(z*r-x*y));
}
// x = n pi/2 + (y0 + y1), |y0 + y1| <= pi/4 (a hair more), for |x| <= SM_LIMIT.
SmTurn :: struct {n:int;y0:f64;y1:f64;}
sm_small_turn :: (x:f64)->SmTurn {
    n:=floor(x*SM_INVPIO2+0.5);
    r:=x-n*SM_PIO2_1;                                       // exact
    b:=-(n*SM_PIO2_2);s:=r+b;bb:=s-r;e1:=(r-(s-bb))+(b-bb);  // s + e1 = r + b exactly
    tail:=(e1-n*SM_PIO2_3)-n*SM_PIO2_3T;
    y0:=s+tail;
    return SmTurn.{n=cast(int) n,y0=y0,y1=(s-y0)+tail};
}

// floor((2/pi) * 2^1584), big endian in base 2^24 (fdlibm e_rem_pio2.c).
SM_IPIO2 :: [66]u64.[
    0xA2F983,0x6E4E44,0x1529FC,0x2757D1,0xF534DD,0xC0DB62,
    0x95993C,0x439041,0xFE5163,0xABDEBB,0xC561B7,0x246E3A,
    0x424DD2,0xE00649,0x2EEA09,0xD1921C,0xFE1DEB,0x1CB129,
    0xA73EE8,0x8235F5,0x2EBB44,0x84E99C,0x7026B4,0x5F7E41,
    0x3991D6,0x398353,0x39F49C,0x845F8B,0xBDF928,0x3B1FF8,
    0x97FFDE,0x05980F,0xEF2F11,0x8B5A0A,0x6D1F6D,0x367ECF,
    0x27CB09,0xB74F46,0x3F669E,0x5FEA2D,0x7527BA,0xC7EBE5,
    0xF17B3D,0x0739F7,0x8A5292,0xEA6BFB,0x5FB11F,0x8D5D08,
    0x560330,0x46FC7B,0x6BABF0,0xCFBC20,0x9AF436,0x1DA9E3,
    0x91615E,0xE61B08,0x659985,0x5F14A0,0x68408D,0xFFD880,
    0x4D7327,0x310606,0x1556CA,0x73A8C9,0x60E27B,0xC08C6B];
sm_two :: (e:int)->f64 {return f64_from_bits(cast(u64) (e+1023)<<52);}
sm_bit :: (p:[]u64,i:int)->u64 {return (p[i/24]>>(i%24))&1;}
sm_large_turn :: (x:f64)->SmTurn {
    b:=f64_bits(abs(x));m:=(b&0x000fffffffffffff)|0x0010000000000000;
    // Little-endian limbs. Every product, sum and carry fits in 50 bits.
    p:[69]u64;
    for j:0..<3 {
        digit:=(m>>(24*j))&0xffffff;carry:u64=0;
        for i:0..<66 {v:=p[i+j]+SM_IPIO2[65-i]*digit+carry;p[i+j]=v&0xffffff;carry=v>>24;}
        p[66+j]=carry;
    }
    d:=1584+52-(cast(int) (b>>52)-1023);
    n:=cast(int) (sm_bit(p[..],d)+2*sm_bit(p[..],d+1));
    up:=sm_bit(p[..],d-1)==1;
    if up {
        n=(n+1)&3;
        // 1-f in the low d bits, by two's complement before conversion.
        carry:u64=1;
        for i:0..<(d+23)/24 {v:=(p[i]^0xffffff)+carry;p[i]=v&0xffffff;carry=v>>24;}
        if d%24!=0 {p[d/24]&=(cast(u64) 1<<(d%24))-1;}
    }
    top:=d-1;while top>0 && sm_bit(p[..],top)==0 {top-=1;}
    f:[3]f64;
    for j:0..<3 {
        v:u64=0;
        for i:0..<53 {v=(v<<1)|sm_bit(p[..],top-53*j-i);}
        f[j]=f64(v)*sm_two(top-d-52-53*j);
    }
    // Dekker's exact product residual for f[0] * nearest(pi/2).
    a:=f[0];pi2:=1.5707963267948966;c:=134217729.0*a;
    ah:=c-(c-a);al:=a-ah;
    ph:=1.5707963407039642;pl:=-1.3909067675399456e-8;
    r:=a*pi2;
    tail:=((ah*ph-r)+ah*pl+al*ph)+al*pl;
    tail+=a*6.123233995736766e-17+f[1]*pi2+f[2]*pi2;
    y0:=r+tail;y1:=(r-y0)+tail;
    if up {y0=-y0;y1=-y1;}
    if x<0 {n=-n;y0=-y0;y1=-y1;}
    return SmTurn.{n=n,y0=y0,y1=y1};
}
sm_turn :: (x:f64)->SmTurn {
    if abs(x)<=SM_LIMIT {return sm_small_turn(x);}
    return sm_large_turn(x);
}
SM_sin :: (x:f64)->f64 #export_c #effects(all) {
    if abs(x)>SM_MAX || x!=x {return f64_from_bits(0x7ff8000000000000);}
    if abs(x)<0.000000007450580596923828125 {return x;}
    t:=sm_turn(x);q:=t.n&3;
    if q==0 {return sm_ksin(t.y0,t.y1);}
    if q==1 {return sm_kcos(t.y0,t.y1);}
    if q==2 {return -sm_ksin(t.y0,t.y1);}
    return -sm_kcos(t.y0,t.y1);
}
SM_cos :: (x:f64)->f64 #export_c #effects(all) {
    if abs(x)>SM_MAX || x!=x {return f64_from_bits(0x7ff8000000000000);}
    if abs(x)<0.000000007450580596923828125 {return 1;}
    t:=sm_turn(x);q:=t.n&3;
    if q==0 {return sm_kcos(t.y0,t.y1);}
    if q==1 {return -sm_ksin(t.y0,t.y1);}
    if q==2 {return -sm_kcos(t.y0,t.y1);}
    return sm_ksin(t.y0,t.y1);
}
SM_exp :: (x:f64)->f64 #export_c #effects(all) {
    if x!=x {return x;}
    if x>SM_EXP_OVER {return f64_from_bits(0x7ff0000000000000);}
    if x<-745.1332191019412 {return 0;}
    if abs(x)<0.000000000931322574615478515625 {return 1+x;}
    k:=floor(x*SM_INVLN2+0.5);
    hi:=x-k*SM_LN2_HI;lo:=k*SM_LN2_LO;r:=hi-lo;t:=r*r;
    c:=r-t*(SM_P1+t*(SM_P2+t*(SM_P3+t*(SM_P4+t*SM_P5))));
    y:=1-((lo-(r*c)/(2-c))-hi);n:=cast(int) k;
    if n==1024 {return y*2*sm_two(1023);}
    if n < -1022 {return (y*sm_two(n+1000))*sm_two(-1000);}
    return y*sm_two(n);
}

// ln x: x = 2^k m, m in [sqrt(2)/2, sqrt(2)), f = m - 1, s = f/(2 + f), and
// ln m = f - (f^2/2 - s (f^2/2 + R(s^2))) by fdlibm's polynomial R.
SM_log :: (x:f64)->f64 #export_c #effects(all) {
    if x!=x {return x;}
    if x==0 {return f64_from_bits(0xfff0000000000000);}
    if x<0 {return f64_from_bits(0x7ff8000000000000);}
    if x>SM_MAX {return x;}
    bits:=f64_bits(x);e:=cast(int) (bits>>52);
    if e==0 {bits=f64_bits(x*18014398509481984.0);e=cast(int) (bits>>52)-54;}   // a subnormal, times 2^54
    k:=e-1023;
    hx:=cast(int) ((bits>>32)&1048575);                      // the mantissa's top 20 bits
    i:=(hx+614244)&1048576;                                 // 2^20 when m would pass sqrt(2): halve it
    m:=f64_from_bits((cast(u64) (hx+(i^1072693248))<<32)+(bits&4294967295));
    k+=i>>20;
    f:=m-1;dk:=cast(f64) k;
    s:=f/(2+f);z:=s*s;w:=z*z;
    t1:=w*(SM_LG2+w*(SM_LG4+w*SM_LG6));
    t2:=z*(SM_LG1+w*(SM_LG3+w*(SM_LG5+w*SM_LG7)));
    hfsq:=0.5*f*f;
    return dk*SM_LN2_HI-((hfsq-(s*(hfsq+(t2+t1))+dk*SM_LN2_LO))-f);
}
