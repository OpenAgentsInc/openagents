#forall "R2 sum mutation exact zero traversal budget refuses before a valid leaf" budget:0..<2 {
 nodes:[8]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=3,type_count=17}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.enum_,name="Flag",decl=2,elem=12,size=1,alignment=1,bits=8};nodes[2]=CK_Node.{kind=CK_Tag.enum_,name="Flag",head=3,type=16,mark=2};nodes[3]=CK_Node.{kind=CK_Tag.member,name="only",type=16};
 found:=CK_sum_contains_bounded(c,16,true,budget);
 if budget==0 {#assert found && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381";}
 else {#assert !found && !state[0].fatal && state[0].error_count==0;}
}
