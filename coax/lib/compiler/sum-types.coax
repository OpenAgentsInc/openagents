 if nested {#assert t==0 && !state[0].fatal && state[0].error_count==1 && errors[0].code=="E0900" && errors[0].loc.line==9 && errors[0].loc.column==5;}
 else {#assert t>=16 && !state[0].fatal && state[0].error_count==0 && types[t].kind==CK_Kind.result && types[t].elem==11 && types[t].sum_error==16 && types[t].size==24 && types[t].alignment==8 && types[t].sum_payload_offset==8 && types[t].sum_default== -1;}
}
