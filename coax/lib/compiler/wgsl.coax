  #assert wg_mtry("2 19 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 7 2 2 0 2 4 8 8 7 3 8 7 3 2 0 4 4 2 8 12 7 8 4 0 2 4 7 8 8 16 2 40 9 44 2 56 2 60 64 9 10 7 3 2 0 2 4 2 8 12 7 2 12 0 2 12 16 9 13 7 3 2 0 2 4 7 8 16 9 15 9 4 9 3 1 6 6 19 11 14 16 17 18 9 6 11 14 16 17 18 10 13 15 119 1 4 3 40 6 27 42 40 1 16 5 0 0 3 40 7 27 42 40 2 16 5 0 0 3 40 8 27 42 40 3 16 5 0 0 4 31 6 4 19 1 19 1 19 1 29 2 27 41 40 6 0 27 41 42 41 40 6 3 16 5 2 0 1 27 41 41 40 6 5 2 27 41 40 6 7 19 1 27 41 41 40 7 0 2 27 41 40 7 1 19 1 27 41 41 40 8 2 1 29 2 27 42 40 4 16 5 0 0 29 2 27 42 40 5 16 5 0 0 1 1 0 0 1 2 3 4 5","fs pos k1 k2 k3 us is x y z\npos\nk1 0 0\nk2 0 1\nk3 0 2\nus 0 3\nis 0 4\n",out[..])==-1;
  // a local's type past the types
  #assert wg_mtry("2 19 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 7 2 2 0 2 4 8 8 7 3 8 7 3 2 0 4 4 2 8 12 7 8 4 0 2 4 7 8 8 16 2 40 9 44 2 56 2 60 64 9 10 7 3 2 0 2 4 2 8 12 7 2 12 0 2 12 16 9 13 7 3 2 0 2 4 7 8 16 9 15 9 4 9 3 1 6 6 6 11 14 16 17 18 9 6 11 14 16 17 18 19 13 15 119 1 4 3 40 6 27 42 40 1 16 5 0 0 3 40 7 27 42 40 2 16 5 0 0 3 40 8 27 42 40 3 16 5 0 0 4 31 6 4 19 1 19 1 19 1 29 2 27 41 40 6 0 27 41 42 41 40 6 3 16 5 2 0 1 27 41 41 40 6 5 2 27 41 40 6 7 19 1 27 41 41 40 7 0 2 27 41 40 7 1 19 1 27 41 41 40 8 2 1 29 2 27 42 40 4 16 5 0 0 29 2 27 42 40 5 16 5 0 0 1 1 0 0 1 2 3 4 5","fs pos k1 k2 k3 us is x y z\npos\nk1 0 0\nk2 0 1\nk3 0 2\nus 0 3\nis 0 4\n",out[..])==-1;
  // a constructor's type past the types
  #assert wg_mtry("2 19 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 7 2 2 0 2 4 8 8 7 3 8 7 3 2 0 4 4 2 8 12 7 8 4 0 2 4 7 8 8 16 2 40 9 44 2 56 2 60 64 9 10 7 3 2 0 2 4 2 8 12 7 2 12 0 2 12 16 9 13 7 3 2 0 2 4 7 8 16 9 15 9 4 9 3 1 6 6 6 11 14 16 17 18 9 6 11 14 16 17 18 10 13 15 119 1 4 3 40 6 27 42 40 1 16 5 0 0 3 40 7 27 42 40 2 16 5 0 0 3 40 8 27 42 40 3 16 5 0 0 4 31 19 4 19 1 19 1 19 1 29 2 27 41 40 6 0 27 41 42 41 40 6 3 16 5 2 0 1 27 41 41 40 6 5 2 27 41 40 6 7 19 1 27 41 41 40 7 0 2 27 41 40 7 1 19 1 27 41 41 40 8 2 1 29 2 27 42 40 4 16 5 0 0 29 2 27 42 40 5 16 5 0 0 1 1 0 0 1 2 3 4 5","fs pos k1 k2 k3 us is x y z\npos\nk1 0 0\nk2 0 1\nk3 0 2\nus 0 3\nis 0 4\n",out[..])==-1;
  // a resource argument that is not a local
  #assert wg_mtry("2 8 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 2 6 2 6 7 2 6 7 27 1 1 4 31 6 4 19 1 22 1 1 17 1 29 2 32 40 1 16 2 0 16 2 0 16 2 1065353216 2 1 7 1 7 11 1 1 4 27 42 40 0 16 5 0 0 1 1 0 0 1","fs pos u\ng u\npos\nu 0 0\n",out[..])==-4;
  // the count of what is not a local
  #assert wg_mtry("2 8 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 2 6 2 6 7 2 6 7 27 1 1 4 31 6 4 19 1 22 1 1 18 1 29 2 32 41 1 16 2 0 16 2 0 16 2 1065353216 2 1 7 1 7 11 1 1 4 27 42 40 0 16 5 0 0 1 1 0 0 1","fs pos u\ng u\npos\nu 0 0\n",out[..])==-4;
  // no entries
  #assert wg_mtry("2 6 0 1 2 3 4 5 0 0","",out[..])==-1;
  // more entries than it holds
  #assert wg_mtry("2 6 0 1 2 3 4 5 0 65","",out[..])==-3;
  // the most entries, cut
  #assert wg_mtry("2 6 0 1 2 3 4 5 0 64","",out[..])==-1;
  // an entry one past the procedures, its words as many as the types
  #assert wg_mtry("2 7 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 1 0 1 6 1 6 2 1 0 1 0 1 0 0 0 0 0 0","fs pos\npos\n",out[..])==-1;
}
// A module with every word of its work view fill (wg_mtry's are 0).
wg_mfill :: (text:string,names:string,out:[]u8,fill:u32)->int {
  t:[8192] u32;work:[WG_W_WORDS] u32;
  for i:0..<WG_W_WORDS {work[i]=fill;} // mutant: equivalent (a module's output is the same whatever the work view held)
  return WG_module(t[0..<wg_parse(text,t[..])],names,out,work[..]);
}
#test "a module refuses what it cannot write wherever it meets it, whatever the work view held" {
  out:[65536] u8;
  // a zero of a type past the types
  #assert wg_mfill("2 7 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 1 6 1 6 2 6 6 10 1 2 3 40 1 17 7 4 18 1 1 1 0 0","fs pos o\npos\n",out[..],4000000000)==-1;
  // a constructor of a type past the types
  #assert wg_mfill("2 7 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 1 6 1 6 1 6 20 1 1 4 31 7 4 16 2 1065353216 27 41 40 0 1 16 2 0 16 2 1065353216 1 1 0 0","fs pos\npos\n",out[..],4000000000)==-1;
  // a sample of two values, the words after it fields
  #assert wg_mfill("2 7 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 1 6 1 6 1 6 21 1 1 4 31 6 4 33 2 6 2 27 41 40 0 1 16 2 0 16 2 1065353216 1 1 0 0","fs pos\npos\n",out[..],0)==-1;
  // b6: a view of nothing bound, not given a zero
  #assert wg_mfill("2 8 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 1 6 1 6 2 6 7 23 1 1 4 31 6 4 27 42 40 1 16 5 0 0 16 2 0 16 2 0 16 2 1065353216 1 1 0 0","fs pos w\npos\n",out[..],0)==-4;
  // b6: the same, the work view huge
  #assert wg_mfill("2 8 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 1 6 1 6 2 6 7 23 1 1 4 31 6 4 27 42 40 1 16 5 0 0 16 2 0 16 2 0 16 2 1065353216 1 1 0 0","fs pos w\npos\n",out[..],4000000000)==-4;
  // b7: a view of nothing bound, not given a zero
  #assert wg_mfill("2 8 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 2 6 1 6 2 6 7 20 1 1 4 31 6 4 22 1 1 18 1 16 2 0 16 2 0 16 2 1065353216 2 1 7 1 7 11 1 1 4 27 42 40 0 16 5 0 0 1 1 0 0","fs pos w\ng w\npos\n",out[..],0)==-4;
  // b7: the same, the work view huge
  #assert wg_mfill("2 8 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 2 6 1 6 2 6 7 20 1 1 4 31 6 4 22 1 1 18 1 16 2 0 16 2 0 16 2 1065353216 2 1 7 1 7 11 1 1 4 27 42 40 0 16 5 0 0 1 1 0 0","fs pos w\ng w\npos\n",out[..],4000000000)==-4;
  // b8: a view of nothing bound, not given a zero
  #assert wg_mfill("2 8 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 1 6 1 6 2 6 7 20 1 1 4 31 6 4 29 2 32 40 1 16 2 0 16 2 0 16 2 1065353216 1 1 0 0","fs pos w\npos\n",out[..],0)==-4;
  // b8: the same, the work view huge
  #assert wg_mfill("2 8 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 1 6 1 6 2 6 7 20 1 1 4 31 6 4 29 2 32 40 1 16 2 0 16 2 0 16 2 1065353216 1 1 0 0","fs pos w\npos\n",out[..],4000000000)==-4;
  // the count of what is not a local, last in its procedure
  #assert wg_mfill("2 8 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 3 6 2 6 7 2 6 7 20 1 1 4 31 6 4 22 1 1 18 1 16 2 0 16 2 0 16 2 1065353216 2 1 7 1 7 8 1 1 4 22 2 1 18 0 2 1 7 1 7 8 1 1 4 29 2 32 41 0 1 1 0 0 1","fs pos u\nh u\ng u\npos\nu 0 0\n",out[..],0)==-4;
  // a resource argument that is not a local, last in its procedure
  #assert wg_mfill("2 8 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 3 6 2 6 7 2 6 7 20 1 1 4 31 6 4 22 1 1 18 1 16 2 0 16 2 0 16 2 1065353216 2 1 7 1 7 8 1 1 4 22 2 1 17 0 2 1 7 1 7 8 1 1 4 29 2 32 40 0 1 1 0 0 1","fs pos u\nh u\ng u\npos\nu 0 0\n",out[..],0)==-4;
  // an entry called by another: its one variant
  #assert wg_mfill("2 7 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 2 6 1 6 1 6 5 1 1 4 18 0 6 1 6 1 6 8 1 1 4 22 0 1 18 0 2 1 0 0 1 1 0","fs pos\nfs2 pos\npos\n",out[..],0)==444 && cast(string)out[0..<444]=="fn coax_p_fs(p_pos: vec4f) -> vec4f {\n  var l_pos: vec4f = p_pos;\n  return l_pos;\n}\nfn coax_p_fs2(p_pos: vec4f) -> vec4f {\n  var l_pos: vec4f = p_pos;\n  return coax_p_fs(l_pos);\n}\n@fragment\nfn fs(@builtin(position) coax_pos: vec4f) -> @location(0) vec4f {\n  let coax_r = coax_p_fs(coax_pos);\n  return coax_r;\n}\n@fragment\nfn fs2(@builtin(position) coax_pos: vec4f) -> @location(0) vec4f {\n  let coax_r = coax_p_fs2(coax_pos);\n  return coax_r;\n}\n";
  // a view of a local array
  #assert wg_mfill("2 9 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 8 2 4 4 1 6 2 6 7 4 6 7 8 7 42 1 4 3 40 2 17 8 3 42 40 2 16 5 1 0 16 2 1073741824 11 3 2 4 31 6 4 27 42 40 1 16 5 1 0 16 2 0 16 2 0 16 2 1065353216 1 1 0 0 1","fs pos u a v\npos\nu 0 0 uniform 1\n",out[..],0)==453 && cast(string)out[0..<453]=="@group(0) @binding(0) var<uniform> u: array<vec4f, 1>;\nfn coax_at_u(i: i32) -> f32 {\n  return u[i / 4][i % 4];\n}\nfn coax_p_fs(p_pos: vec4f) -> vec4f {\n  var l_pos: vec4f = p_pos;\n  var l_a: array<f32, 4>;\n  l_a = array<f32, 4>();\n  l_a[1i] = 0x1.000000p1f;\n  return vec4f(coax_at_u(i32(1i)), 0.0f, 0.0f, 0x1.000000p0f);\n}\n@fragment\nfn fs(@builtin(position) coax_pos: vec4f) -> @location(0) vec4f {\n  let coax_r = coax_p_fs(coax_pos);\n  return coax_r;\n}\n";
  // a uniform parameter given a local array
  #assert wg_mfill("2 9 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 8 2 4 4 1 6 2 6 7 4 6 7 8 7 42 1 4 3 40 2 17 8 3 42 40 2 16 5 1 0 16 2 1073741824 11 1 2 4 31 6 4 27 42 40 1 16 5 1 0 16 2 0 16 2 0 16 2 1065353216 1 1 0 0 1","fs pos u a v\npos\nu 0 0 uniform 1\n",out[..],0)==442 && cast(string)out[0..<442]=="@group(0) @binding(0) var<uniform> u: array<vec4f, 1>;\nfn coax_at_u(i: i32) -> f32 {\n  return u[i / 4][i % 4];\n}\nfn coax_p_fs(p_pos: vec4f) -> vec4f {\n  var l_pos: vec4f = p_pos;\n  var l_a: array<f32, 4>;\n  l_a = array<f32, 4>();\n  l_a[1i] = 0x1.000000p1f;\n  return vec4f(l_a[1i], 0.0f, 0.0f, 0x1.000000p0f);\n}\n@fragment\nfn fs(@builtin(position) coax_pos: vec4f) -> @location(0) vec4f {\n  let coax_r = coax_p_fs(coax_pos);\n  return coax_r;\n}\n";
  // storage: ints (8 bytes in C, an i32 in WGSL)
  #assert wg_mfill("2 8 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 5 1 6 2 6 7 3 6 7 5 16 1 2 3 40 2 27 42 40 1 16 5 0 0 4 18 0 1 1 0 0 1","fs pos ps x\npos\nps 0 0\n",out[..],0)==-9;
  // storage: an array of structs with a bool
  #assert wg_mfill("2 11 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 7 2 1 0 2 4 8 8 7 2 8 7 1 8 0 16 9 9 1 6 2 6 10 3 6 10 9 16 1 2 3 40 2 27 42 40 1 16 5 0 0 4 18 0 1 1 0 0 1","fs pos ps x\npos\nps 0 0\n",out[..],0)==-9;
  // storage: a vec2 between floats (24 bytes in WGSL)
  #assert wg_mfill("2 10 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 7 2 2 0 2 4 8 7 3 2 0 7 4 2 12 16 9 8 1 6 2 6 9 3 6 9 8 16 1 2 3 40 2 27 42 40 1 16 5 0 0 4 18 0 1 1 0 0 1","fs pos ps x\npos\nps 0 0\n",out[..],0)==-9;
  // a fragment input that is a u32
  #assert wg_mfill("2 8 0 1 2 3 4 5 7 1 2 0 4 7 4 2 0 2 4 2 8 2 12 16 1 7 1 4 1 4 5 1 1 4 17 7 1 1 0 0","fs v\n",out[..],0)==-8;
  // an element of a local the procedure does not have
  #assert wg_mfill("2 9 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 9 2 8 2 4 4 1 6 2 6 7 4 6 7 8 7 42 1 4 3 40 2 17 8 3 42 40 2 16 5 1 0 16 2 1073741824 11 3 2 4 31 6 4 27 42 40 999999 16 5 1 0 16 2 0 16 2 0 16 2 1065353216 1 1 0 0 1","fs pos u a v\npos\nu 0 0 uniform 1\n",out[..],0)==-1;
  t:[8192] u32;work:[WG_W_WORDS] u32;
  // no room for a variant
  #assert WG_module(t[0..<wg_parse(WG_SAMPLE_MOD,t[..])],WG_NAMES_MOD,out[..],work[0..<WG_W_POOL])==-3;
}
