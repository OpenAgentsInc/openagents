  // attributes that are a vector
  #assert wg_mtry("2 7 0 1 2 3 4 5 7 4 2 0 2 4 2 8 2 12 16 1 6 3 4 4 6 3 4 4 6 5 1 1 4 18 2 1 0 0 0 1 2","vs vid iid x\nvid\niid\nx\n",out[..])==-8;
  // a vertex result that is a float
