  #assert wg_mtry("2 9 0 1 2 3 4 5 7 2 2 0 2 4 8 7 4 2 0 2 4 2 8 2 12 16 7 2 6 0 7 8 24 1 8 2 4 4 3 4 4 8 10 1 2 3 40 2 17 8 4 18 2 1 0 0 0 1","vs vid iid o\nvid\niid\n",out[..])==-8;
