am_moe_down_iq4_nb :: (row0:int,rows:int,cols:int,nb:int,n_used:int,w:[]u16,x:[]f32,u_eids:[]u32,u_mask:[]u32,u_slot:[]u32,u_cnt:[]u32,wts:[]f32,cw:[]f32,hist:[]f32,res:[]f32,raw_log:[]f32,out:[]f32) #effects(all) {
    blocks:=cols/32;rw:=blocks*9;ew:=rows*rw;nu:=cast(int)u_cnt[0];
    for dr:0..<4 {
        r:=row0+dr;
        if r<rows {
            h0:=hist[r*3];h1:=hist[r*3+1];h2:=hist[r*3+2];
            for t:0..<nb {
                acc:f32=0.0f32;
                for u:0..<nu {
                    if (u_mask[u]&(cast(u32)1<<cast(u32)t))!=0 {
                        sl:=cast(int)u_slot[u*8+t];
                        acc+=wts[t*n_used+sl]*am_dot_iq4_lane(w,cast(int)u_eids[u]*ew+r*rw,x,(t*n_used+sl)*cols,blocks);
                    }
                }
                raw_log[t*rows+r]=acc;
                cv:=(acc+h0*cw[r*4]+h1*cw[r*4+1]+h2*cw[r*4+2]+acc*cw[r*4+3])*0.4472135954999579f32;
                out[t*rows+r]=res[t*rows+r]+cv;
                h0=h1;h1=h2;h2=acc;
            }
        }
    }
}

am_moe_down_q4s_nb :: (row0:int,rows:int,cols:int,nb:int,n_used:int,qs:[]u32,ds:[]u16,x:[]f32,u_eids:[]u32,u_mask:[]u32,u_slot:[]u32,u_cnt:[]u32,wts:[]f32,cw:[]f32,hist:[]f32,res:[]f32,raw_log:[]f32,out:[]f32) #effects(all) {
