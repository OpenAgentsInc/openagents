am_conv_commit_nb :: (item:int,n_slots:int,n_kv:int,d:int,pos0:int,got:int,conv_all:[]f32,raw_log:[]f32) #effects(all) {
    ch_per:=2*n_kv+2*d;
    il:=item/ch_per;
    if il>=n_slots {return;}
    ch:=item%ch_per;
    cbase:=il*(2*n_kv*4+2*d*3);
    rbase:=il*(8*ch_per);
    if ch<n_kv {
        hb:=cbase+ch*4;
        for t:0..<got {conv_all[hb+(pos0+t)%4]=raw_log[rbase+t*n_kv+ch];}
    } else if ch<2*n_kv {
        c:=ch-n_kv;
        hb:=cbase+n_kv*4+c*4;
        for t:0..<got {conv_all[hb+(pos0+t)%4]=raw_log[rbase+8*n_kv+t*n_kv+c];}
    } else if ch<2*n_kv+d {
        c:=ch-2*n_kv;
        hb:=cbase+2*n_kv*4+c*3;
        h0:=conv_all[hb];h1:=conv_all[hb+1];h2:=conv_all[hb+2];
        for t:0..<got {h0=h1;h1=h2;h2=raw_log[rbase+16*n_kv+t*d+c];}
        conv_all[hb]=h0;conv_all[hb+1]=h1;conv_all[hb+2]=h2;
    } else {
        c:=ch-(2*n_kv+d);
        hb:=cbase+2*n_kv*4+d*3+c*3;
        h0:=conv_all[hb];h1:=conv_all[hb+1];h2:=conv_all[hb+2];
        for t:0..<got {h0=h1;h1=h2;h2=raw_log[rbase+16*n_kv+8*d+t*d+c];}
        conv_all[hb]=h0;conv_all[hb+1]=h1;conv_all[hb+2]=h2;
    }
}

am_dot_q4s_small_nb :: (row:int,rows_per_grp:int,cols:int,nb:int,n_parts:int,eps:f32,qs:[]u32,ds:[]u16,x:[]f32,parts:[]f32,out:[]f32) #effects(all) {
    blocks:=cols/32;
    grp:=row/rows_per_grp;
    rloc:=row%rows_per_grp;
    for t:0..<nb {
        inv:f32=1.0f32;
        if n_parts>0 {
            ss:f32=0.0f32;
            for i:0..<n_parts {ss+=parts[(grp*nb+t)*n_parts+i];}
            inv=1.0f32/sqrt(ss/f32(cols)+eps);
        }
        out[(grp*nb+t)*rows_per_grp+rloc]=am_dot_q4s_lane(qs,ds,row*blocks,x,(grp*nb+t)*cols,blocks)*inv;
    }
}

am_mix_fused_nb :: (mode:int,dim:int,n_blocks:int,nb:int,t_idx:int,eps:f32,blocks_buf:[]f32,cur:[]f32,query:[]f32,q_off:int,aux:[]f32,aux_off:int,out0:[]f32,o0_off:int,out1:[]f32,o1_off:int) #effects(all) {
    n_states:=n_blocks+1;
    cbase:=t_idx*dim;
    inv_sqrt_d:=1.0f32/sqrt(f32(dim));
    scores:[16]f32;invs:[16]f32;wts:[16]f32;
    for s:0..<n_states {
        ss:f32=0.0f32;dt:f32=0.0f32;
        for i:0..<dim {
            v:=ifx s<n_blocks then blocks_buf[(s*nb+t_idx)*dim+i] else cur[cbase+i];
            ss+=v*v;dt+=v*query[q_off+i];
        }
        invs[s]=1.0f32/sqrt(ss/f32(dim)+0.000001f32);
        scores[s]=dt*invs[s]*inv_sqrt_d;
    }
    mx:=scores[0];
    for s:1..<n_states {if scores[s]>mx {mx=scores[s];}} // mutant: equivalent (at scores[s]==mx assigning mx leaves mx unchanged)
    esum:f32=0.0f32;
    for s:0..<n_states {wts[s]=exp(scores[s]-mx);esum+=wts[s];}
    inv_e:=1.0f32/esum;
    s1:f32=0.0f32;s2:f32=0.0f32;
    for i:0..<dim {
        acc:f32=0.0f32;
        for s:0..<n_states {
            v:=ifx s<n_blocks then blocks_buf[(s*nb+t_idx)*dim+i] else cur[cbase+i];
            acc+=(wts[s]*inv_e*invs[s])*v;
        }
        out0[o0_off+i]=acc;
        s1+=acc*acc;
        if mode==1 {av:=aux[aux_off+i];s2+=av*av;}
    }
    if mode==0 {
        inv:=1.0f32/sqrt(s1/f32(dim)+eps);
        for i:0..<dim {out0[o0_off+i]=out0[o0_off+i]*inv*aux[aux_off+i];}
    } else {
        inv1:=1.0f32/sqrt(s1/f32(dim)+0.000001f32);
        inv2:=1.0f32/sqrt(s2/f32(dim)+0.000001f32);
        for i:0..<dim {
            out1[o1_off+i]=out0[o0_off+i]*inv1;
            out1[o1_off+dim+i]=aux[aux_off+i]*inv2;
        }
    }
}

am_ctrl_up_apply_gf_rm_nb :: (dim:int,rank:int,nb:int,row0:int,w_gf:[]u32,w_off:int,gate:[]f32,g_off:int,cur:[]f32,c_off:int,msg:[]f32,m_off:int,w_norm:[]f32,out:[]f32,o_off:int,rms_parts:[]f32,p_base:int,tile:int) #effects(all) {
    n_parts:=(dim+31)/32;
    for t:0..<nb {
        ss:f32=0.0f32;
        for dr:0..<32 {
            row:=row0+dr;
            if row<dim {
                v:=am_ctrl_gf_rm_row(rank,row,w_gf,w_off,gate,g_off+t*rank,cur,c_off+t*dim,msg,m_off+t*dim);
                ss+=v*v;
                out[o_off+t*dim+row]=v*w_norm[row];
            }
        }
        rms_parts[p_base+t*n_parts+tile]=ss;
    }
}

am_dot_q4s_8row_nb :: (row0:int,rows:int,cols:int,nb:int,row_base:int,x_off:int,out_off:int,cap:f32,qs:[]u32,ds:[]u16,x:[]f32,out:[]f32) #effects(all) {
    blocks:=cols/32;
    for dr:0..<8 {
        r:=row0+dr;
        if r<rows {
            for t:0..<nb {
                v:=am_dot_q4s_lane(qs,ds,(row_base+r)*blocks,x,x_off+t*cols,blocks);
                if cap>0.0f32 {v=cap*am_tanh(v/cap);}
                out[out_off+t*rows+r]=v;
            }
        }
    }
}

am_dot_q4s_mma32_nb :: (row0:int,rows:int,cols:int,nb:int,row_base:int,x_off:int,out_off:int,cap:f32,qs:[]u32,ds:[]u16,x:[]f32,out:[]f32) #effects(all) {
    blocks:=cols/32;
    for dr:0..<32 {
        r:=row0+dr;
        if r<rows {
            for t:0..<nb {
                v:=am_dot_q4s_lane(qs,ds,(row_base+r)*blocks,x,x_off+t*cols,blocks);
                if cap>0.0f32 {v=cap*am_tanh(v/cap);}
                out[out_off+t*rows+r]=v;
            }
        }
    }
}

am_dot_q8_mma32_nb :: (row0:int,rows:int,cols:int,nb:int,row_base:int,x_off:int,out_off:int,cap:f32,w:[]u16,x:[]f32,out:[]f32) #effects(all) {
    blocks:=cols/32;
    for dr:0..<32 {
        r:=row0+dr;
        if r<rows {
            rb:=(row_base+r)*blocks;
            for t:0..<nb {
                acc:f32=0.0f32;
                xb:=x_off+t*cols;
                for b:0..<blocks {
                    wb:=(rb+b)*17;
                    d:=am_f16(cast(u32)w[wb]);
                    s:f32=0.0f32;
                    for j:0..<16 {
                        u:=cast(u32)w[wb+1+j];
                        lo:=u&255;hi:=u>>8;
                        q0:=ifx lo>=128 then f32(cast(int)lo-256) else f32(lo);
                        q1:=ifx hi>=128 then f32(cast(int)hi-256) else f32(hi);
                        s+=q0*x[xb+b*32+j*2]+q1*x[xb+b*32+j*2+1];
                    }
                    acc+=d*s;
                }
                if cap>0.0f32 {acc=cap*am_tanh(acc/cap);}
                out[out_off+t*rows+r]=acc;
            }
        }
    }
}

am_moe_down_p1_iq4s_nb :: (u:int,row0:int,rows:int,cols:int,nb:int,n_used:int,qs:[]u32,ds:[]u16,x:[]f32,u_eids:[]u32,u_mask:[]u32,u_slot:[]u32,u_cnt:[]u32,slot_out:[]f32) #effects(all) {
    if u>=cast(int)u_cnt[0] {return;}
    blocks:=cols/32;eb:=cast(int)u_eids[u]*rows*blocks;
    mask:=u_mask[u];
    for t:0..<nb {
        if (mask&(cast(u32)1<<cast(u32)t))!=0 {
            sl:=cast(int)u_slot[u*8+t];
            xb:=(t*n_used+sl)*cols;
            ob:=(t*n_used+sl)*rows;
            for dr:0..<16 {
                r:=row0+dr;
                if r<rows {
                    slot_out[ob+r]=am_dot_iq4s_lane(qs,ds,eb+r*blocks,x,xb,blocks);
                }
            }
        }
    }
}

am_moe_down_p1_q4s_nb :: (u:int,row0:int,rows:int,cols:int,nb:int,n_used:int,qs:[]u32,ds:[]u16,x:[]f32,u_eids:[]u32,u_mask:[]u32,u_slot:[]u32,u_cnt:[]u32,slot_out:[]f32) #effects(all) {
    if u>=cast(int)u_cnt[0] {return;}
    blocks:=cols/32;eb:=cast(int)u_eids[u]*rows*blocks;
    mask:=u_mask[u];
    for t:0..<nb {
        if (mask&(cast(u32)1<<cast(u32)t))!=0 {
            sl:=cast(int)u_slot[u*8+t];
            xb:=(t*n_used+sl)*cols;
            ob:=(t*n_used+sl)*rows;
            for dr:0..<16 {
                r:=row0+dr;
                if r<rows {
                    slot_out[ob+r]=am_dot_q4s_lane(qs,ds,eb+r*blocks,x,xb,blocks);
                }
            }
        }
    }
}

am_dspark_fold_logits_s1 :: (item:int,nv:int,step_idx:int,cap:f32,qs:[]u32,ds:[]u16,latent:[]f32,base:[]f32,fold_b:[]f32,out_m:[]f32,out_i:[]u32,out_s:[]f32) #effects(all) {
    chunk:=(nv+63)/64;
    lo:=item*chunk;
    hi:=lo+chunk;
    if hi>nv {hi=nv;} // mutant: equivalent (at hi==nv assigning nv leaves hi unchanged)
    b_off:=step_idx*nv;
    gm:f32=-1.0e30f32;
    gi:u32=0;
    gs:f32=0.0f32;
    if lo<hi {
        v0:=base[b_off+lo]+fold_b[lo]+am_dot_q4s_lane(qs,ds,lo*8,latent,0,8);
        if cap>0.0f32 {v0=cap*am_tanh(v0/cap);}
        gm=v0;
        gi=cast(u32)lo;
        gs=1.0f32;
        for r:(lo+1)..<hi {
            v:=base[b_off+r]+fold_b[r]+am_dot_q4s_lane(qs,ds,r*8,latent,0,8);
            if cap>0.0f32 {v=cap*am_tanh(v/cap);}
            if v>gm {
                gs=gs*exp(gm-v)+1.0f32;
                gm=v;
                gi=cast(u32)r;
            } else {
                gs+=exp(v-gm);
            }
        }
    }
    out_m[item]=gm;
    out_i[item]=gi;
    out_s[item]=gs;
}

am_ctrl_up_apply_gf_batch :: (dim:int,rank:int,n_tok:int,t0:int,row0:int,w_gf:[]u32,w_off:int,gate:[]f32,g_off:int,cur:[]f32,c_off:int,msg:[]f32,m_off:int,out:[]f32,o_off:int) #effects(all) {
    for m:0..<16 {
        t:=t0+m;
        if t<n_tok {
            am_ctrl_up_apply_gf(dim,rank,row0,w_gf,w_off,gate,g_off+t*rank,cur,c_off+t*dim,msg,m_off+t*dim,out,o_off+t*dim);
        }
    }
}

am_mix_batch_f32 :: (dim:int,n_blocks:int,n_tok:int,q_idx:int,t_idx:int,blocks_buf:[]f32,cur:[]f32,query:[]f32,out:[]f32) #effects(all) {
    n_states:=n_blocks+1;
    qbase:=q_idx*dim;cbase:=t_idx*dim;obase:=(q_idx*n_tok+t_idx)*dim;
    inv_sqrt_d:=1.0f32/sqrt(f32(dim));
    scores:[16]f32;invs:[16]f32;wts:[16]f32;
    for s:0..<n_states {
        ss:f32=0.0f32;dt:f32=0.0f32;
        for i:0..<dim {
            v:=ifx s<n_blocks then blocks_buf[(s*n_tok+t_idx)*dim+i] else cur[cbase+i];
            ss+=v*v;dt+=v*query[qbase+i];
        }
        invs[s]=1.0f32/sqrt(ss/f32(dim)+0.000001f32);
        scores[s]=dt*invs[s]*inv_sqrt_d;
    }
    mx:=scores[0];
    for s:1..<n_states {if scores[s]>mx {mx=scores[s];}} // mutant: equivalent (at scores[s]==mx assigning mx leaves mx unchanged)
    esum:f32=0.0f32;
    for s:0..<n_states {wts[s]=exp(scores[s]-mx);esum+=wts[s];}
    inv_e:=1.0f32/esum;
    for i:0..<dim {
        acc:f32=0.0f32;
        for s:0..<n_states {
            v:=ifx s<n_blocks then blocks_buf[(s*n_tok+t_idx)*dim+i] else cur[cbase+i];
            acc+=(wts[s]*inv_e*invs[s])*v;
        }
        out[obase+i]=acc;
    }
}

am_attn_scores_m4 :: (item:int,dims0:u32,dims1:u32,kv_info:u32,pos0:int,n_tok:int,k_start:int,q:[]f32,r:[]f32,rel_bias:[]f32,sinks:[]f32,k_cache:[]u16,scores:[]u16) #effects(all) {
    n_head:=cast(int)(dims0&255);n_head_kv:=cast(int)((dims0>>8)&255);head_dim:=cast(int)((dims0>>16)&255);n_rel:=cast(int)((dims0>>24)&255);
    extent:=cast(int)(dims1&65535);is_swa:=cast(int)((dims1>>16)&1);swa:=cast(int)((dims1>>17)&32767);
    kv_cap:=cast(int)(kv_info&65535);score_stride:=cast(int)((kv_info>>16)&65535);
    qt:=(n_tok+63)/64;k_split:=item%4;hq:=item/4;h:=hq/qt;t0:=(hq%qt)*64;
    last_t:=ifx t0+63<n_tok then t0+63 else n_tok-1; // mutant: equivalent (at t0+63==n_tok-1 both branches yield n_tok-1)
    kv_h:=h/(n_head/n_head_kv);n_kv_elem:=n_head_kv*head_dim;
    lo_off:=pos0+t0-swa+1-k_start;
    j_lo_tile:=ifx is_swa!=0 && lo_off>=32 then lo_off/32 else 0;
    j_hi_val:=pos0+last_t-k_start;
    if j_hi_val>=0 {
        j_hi_tile:=j_hi_val/32;
        n_valid:=j_hi_tile-j_lo_tile+1;
        scale:=1.0f32/sqrt(f32(head_dim));
        step_k:=(n_valid+3)/4;
        kt_start:=j_lo_tile+k_split*step_k;
        kt_end:=kt_start+step_k;
        if kt_end>j_hi_tile+1 {kt_end=j_hi_tile+1;} // mutant: equivalent (at equality assigning j_hi_tile+1 leaves kt_end unchanged)
        for kt:kt_start..<kt_end {
            j0:=kt*32;
            for dt:0..<64 {
                t:=t0+dt;
                if t<n_tok {
                    p:=pos0+t;sk:=sinks[t*n_head+h];
                    for dj:0..<32 {
                        j:=j0+dj;
                        kp:=k_start+j;
                        if kp<=p && (is_swa==0 || p-kp<swa) {
                            slot:=ifx is_swa!=0 then kp%kv_cap else kp;
                            dot:f32=0.0f32;
                            for d:0..<head_dim {dot+=am_f16(cast(u32)am_to_f16(q[(t*n_head+h)*head_dim+d]))*am_f16(cast(u32)k_cache[slot*n_kv_elem+kv_h*head_dim+d]);}
                            dist:=p-kp;rb:f32=0.0f32;
                            if dist<extent {for m:0..<n_rel {rb+=am_f16(cast(u32)am_to_f16(rel_bias[dist*n_rel+m]))*am_f16(cast(u32)am_to_f16(r[(t*n_head+h)*n_rel+m]));}}
                            scores[(h*n_tok+t)*score_stride+j]=am_to_f16(dot*scale+rb-sk);
                        }
                    }
                }
            }
        }
    }
}

am_attn_values_m4 :: (item:int,dims0:u32,dims1:u32,kv_info:u32,pos0:int,n_tok:int,k_start:int,scores:[]u16,inv_gsum:[]f32,v_cache:[]u16,gate:[]f32,out:[]f32) #effects(all) {
    n_head:=cast(int)(dims0&255);n_head_kv:=cast(int)((dims0>>8)&255);head_dim:=cast(int)((dims0>>16)&255);
    is_swa:=cast(int)((dims1>>16)&1);swa:=cast(int)((dims1>>17)&32767);
    kv_cap:=cast(int)(kv_info&65535);score_stride:=cast(int)((kv_info>>16)&65535);
    qt:=(n_tok+63)/64;per:=qt*2;
    h:=item/per;rem:=item%per;t0:=(rem/2)*64;c0:=(rem%2)*64;
    last_t:=ifx t0+63<n_tok then t0+63 else n_tok-1; // mutant: equivalent (at t0+63==n_tok-1 both branches yield n_tok-1)
    kv_h:=h/(n_head/n_head_kv);n_kv_elem:=n_head_kv*head_dim;
    j_lo:=ifx is_swa!=0 && pos0+t0>=swa then pos0+t0-swa+1-k_start else 0;
    if j_lo<0 {j_lo=0;} // mutant: equivalent (at j_lo==0 assigning 0 leaves j_lo unchanged)
    j_hi:=pos0+last_t-k_start+1;
    for dt:0..<64 {
        t:=t0+dt;
        if t<n_tok {
            ig:=inv_gsum[t*n_head+h];
            for dc:0..<64 {
                c:=c0+dc;
                if c<head_dim {
                    acc:f32=0.0f32;
                    for j:j_lo..<j_hi {
                        kp:=k_start+j;slot:=ifx is_swa!=0 then kp%kv_cap else kp;
                        acc+=am_f16(cast(u32)scores[(h*n_tok+t)*score_stride+j])*am_f16(cast(u32)v_cache[slot*n_kv_elem+kv_h*head_dim+c]);
                    }
                    idx:=(t*n_head+h)*head_dim+c;
                    out[idx]=acc*ig/(1.0f32+exp(-gate[idx]));
                }
            }
        }
    }
}

am_iq4_tile_valid :: (threads:int,tm:int,tn:int)->bool #effects(all) {
    if tm==128 || tm==256 {return am_tile_valid(threads,64,tn);}
    return am_tile_valid(threads,tm,tn);
}
am_matmul_iq4_valid :: (rows:int,cols:int,tokens:int,r0:int,t0:int,tn:int,w:int,x:int,out:int,tg:int)->bool #effects(all) {
    if cols<64 || cols%64!=0 || r0<0 || r0>=rows || t0<0 || t0>=tokens || tg<tn*64 {return false;}
    return w>=rows*((cols/32)*9) && x>=tokens*cols && out>=tokens*rows;
}
am_matmul_iq4 :: (threads:int,tm:int,tn:int,rows:int,cols:int,tokens:int,r0:int,t0:int,w:[]u16,x:[]f32,out:[]f32,tg:[]u16) #effects(all) {
    #assert am_matmul_iq4_valid(rows,cols,tokens,r0,t0,tn,w.count,x.count,out.count,tg.count);
    #assert am_iq4_tile_valid(threads,tm,tn);
    blocks:=cols/32;
    row_words:=blocks*9;
    for at:t0..<t0+tm {
        if at>=tokens {break;}
        for ar:r0..<r0+tn {
            if ar>=rows {break;}
            sum:f64=0;
            for b:0..<blocks {
                base:=ar*row_words+b*9;
                sc:=f64(am_f16(cast(u32)w[base]));
                for k:0..<8 {
                    v:=cast(u32)w[base+1+k];
                    k2:=b*32+2*k;
                    sum+=sc*f64(am_iq4_lut(v&15))*f64(x[at*cols+k2]);
                    sum+=sc*f64(am_iq4_lut((v>>4)&15))*f64(x[at*cols+k2+16]);
                    sum+=sc*f64(am_iq4_lut((v>>8)&15))*f64(x[at*cols+k2+1]);
                    sum+=sc*f64(am_iq4_lut((v>>12)&15))*f64(x[at*cols+k2+17]);
                }
            }
            out[at*rows+ar]=f32(sum);
        }
    }
}
am_bf16_u16 :: (bits:u16)->f32 #effects(all) { return f32_from_bits(cast(u32)bits<<16); }
am_matmul_iq4_bf16 :: (threads:int,tm:int,tn:int,rows:int,cols:int,tokens:int,r0:int,t0:int,w:[]u16,x:[]u16,out:[]f32,tg:[]u16) #effects(all) {
    #assert am_matmul_iq4_valid(rows,cols,tokens,r0,t0,tn,w.count,x.count,out.count,tg.count);
    #assert am_iq4_tile_valid(threads,tm,tn);
    blocks:=cols/32;
    row_words:=blocks*9;
    for at:t0..<t0+tm {
        if at>=tokens {break;}
        for ar:r0..<r0+tn {
            if ar>=rows {break;}
            sum:f64=0;
            for b:0..<blocks {
                base:=ar*row_words+b*9;
                sc:=f64(am_f16(cast(u32)w[base]));
                for k:0..<8 {
                    v:=cast(u32)w[base+1+k];
                    k2:=b*32+2*k;
                    sum+=sc*f64(am_iq4_lut(v&15))*f64(am_bf16_u16(x[at*cols+k2]));
                    sum+=sc*f64(am_iq4_lut((v>>4)&15))*f64(am_bf16_u16(x[at*cols+k2+16]));
                    sum+=sc*f64(am_iq4_lut((v>>8)&15))*f64(am_bf16_u16(x[at*cols+k2+1]));
                    sum+=sc*f64(am_iq4_lut((v>>12)&15))*f64(am_bf16_u16(x[at*cols+k2+17]));
                }
            }
            out[at*rows+ar]=f32(sum);
        }
    }
}

#test "BF16 halves decode exactly" {
    #assert am_bf16(0x40003f80,false)==1 && am_bf16(0x40003f80,true)==2 && am_bf16(0xc0400000,true)==-3;
    #assert am_simd_sum(3.5f32)==3.5f32 && am_simd_sum(-1.25f32)==-1.25f32;
    #assert am_simd_max(3.5f32)==3.5f32 && am_simd_max(-1.25f32)==-1.25f32;
    #assert am_to_f16(1.0f32)==0x3c00 && am_to_f16(-2.0f32)==0xc000 && am_to_f16(0.0f32)==0 && am_to_f16(100000.0f32)==0x7bff;
    #assert am_to_f16(1.0009765625f32)==0x3c01 && am_to_f16(1.0078125f32)==0x3c08 && am_to_f16(-1.5f32)==0xbe00 && am_to_f16(32768.0f32)==0x7800;
    #assert am_to_f16(0.00006103515625f32)==0x0400 && am_to_f16(0.000030517578125f32)==0 && am_to_f16(-0.000030517578125f32)==0x8000;
    #assert am_iq4_tile_valid(128,128,64) && am_iq4_tile_valid(128,256,64) && am_iq4_tile_valid(128,64,64);
    #assert !am_iq4_tile_valid(128,129,64) && !am_iq4_tile_valid(128,257,64) && !am_iq4_tile_valid(128,128,65);
    wq:[36]u16;xq:[64]f32;
    wq[0]=0x3c00;wq[9]=0x4000;wq[18]=0x3800;wq[27]=0x3c00;
    for k:0..<8 {
        wq[1+k]=cast(u16)(0x9a8b+k);
        wq[10+k]=cast(u16)(0x7654+k);
        wq[19+k]=cast(u16)(0xa987+k);
        wq[28+k]=cast(u16)(0x89ab+k);
    }
    for i:0..<64 {xq[i]=f32((i+1)*(i+1))*0.01f32;}
    // Compute exact reference sums for 2 blocks at base=0, x_off=0
    exp_iq4:f32=0.0f32;exp_q4:f32=0.0f32;
    for b:0..<2 {
        sc:=am_f16(cast(u32)wq[b*9]);
        si:f32=0.0f32;sq:f32=0.0f32;
        for k:0..<8 {
            v:=cast(u32)wq[b*9+1+k];
            xb:=b*32;
            n0:=v&15;n1:=(v>>4)&15;n2:=(v>>8)&15;n3:=(v>>12)&15;
            si+=am_iq4_lut(n0)*xq[xb+2*k]+am_iq4_lut(n1)*xq[xb+16+2*k]+am_iq4_lut(n2)*xq[xb+2*k+1]+am_iq4_lut(n3)*xq[xb+16+2*k+1];
            sq+=(f32(n0)-8.0f32)*xq[xb+2*k]+(f32(n1)-8.0f32)*xq[xb+16+2*k]+(f32(n2)-8.0f32)*xq[xb+2*k+1]+(f32(n3)-8.0f32)*xq[xb+16+2*k+1];
        }
        exp_iq4+=sc*si;exp_q4+=sc*sq;
    }
    di:=am_dot_iq4_lane(wq[..],0,xq[..],0,2);
    dq:=am_dot_q4_lane(wq[..],0,xq[..],0,2);
    #assert abs(di-exp_iq4)<0.001f32 && abs(dq-exp_q4)<0.001f32;
    #assert am_dot_iq4_lane(wq[..],0,xq[..],0,0)==0.0f32 && am_dot_q4_lane(wq[..],0,xq[..],0,0)==0.0f32;
    // Exact am_tanh & am_situ_act checks (positive, zero, negative)
    #assert abs(am_tanh(0.0f32))<0.0001f32;
    #assert abs(am_tanh(1.0f32)-0.761594f32)<0.001f32 && abs(am_tanh(-1.0f32)+0.761594f32)<0.001f32;
    #assert abs(am_situ_act(1.5f32,2.0f32,3.0f32,0.0f32)-2.2759f32)<0.01f32;
    #assert abs(am_situ_act(1.5f32,4.0f32,3.0f32,2.0f32)-2.1941f32)<0.01f32;
    #assert abs(am_situ_act(-1.5f32,2.0f32,3.0f32,0.0f32)+0.5078f32)<0.01f32;
    // Exact situ_lane checks
    g_i:=am_dot_iq4_lane(wq[..],0,xq[..],0,1);u_i:=am_dot_iq4_lane(wq[..],9,xq[..],0,1);
    #assert abs(am_dot_iq4_situ_lane(wq[..],0,9,xq[..],0,1,3.0f32,2.0f32)-am_situ_act(g_i,u_i,3.0f32,2.0f32))<0.001f32;
    g_q:=am_dot_q4_lane(wq[..],0,xq[..],0,1);u_q:=am_dot_q4_lane(wq[..],9,xq[..],0,1);
    #assert abs(am_dot_q4_situ_lane(wq[..],0,9,xq[..],0,1,3.0f32,2.0f32)-am_situ_act(g_q,u_q,3.0f32,2.0f32))<0.001f32;
    // Exact moe_lane checks with non-zero row_off=9 and 2 experts
    mids:[2]u32;mwts:[2]f32;
    mids[0]=0;mids[1]=1;mwts[0]=0.5f32;mwts[1]=0.25f32;
    exp_mi:=0.5f32*am_dot_iq4_lane(wq[..],9,xq[..],0,1)+0.25f32*am_dot_iq4_lane(wq[..],27,xq[..],32,1);
    exp_mq:=0.5f32*am_dot_q4_lane(wq[..],9,xq[..],0,1)+0.25f32*am_dot_q4_lane(wq[..],27,xq[..],32,1);
    #assert abs(am_dot_iq4_moe_lane(wq[..],mids[..],mwts[..],xq[..],18,9,32,2)-exp_mi)<0.001f32;
    #assert abs(am_dot_q4_moe_lane(wq[..],mids[..],mwts[..],xq[..],18,9,32,2)-exp_mq)<0.001f32;
    #assert am_dot_iq4_moe_lane(wq[..],mids[..],mwts[..],xq[..],18,9,32,0)==0.0f32;
    #assert am_dot_q4_moe_lane(wq[..],mids[..],mwts[..],xq[..],18,9,32,0)==0.0f32;
    wf:[8]u16;
    wf[0]=0x3c00;wf[1]=0x4000;wf[2]=0xbc00;wf[3]=0x3800;wf[4]=0x4200;wf[5]=0x3c00;wf[6]=0x4000;wf[7]=0xbc00;
    exp_f16:=1.0f32*xq[4]+2.0f32*xq[5]-1.0f32*xq[6]+0.5f32*xq[7];
    #assert abs(am_dot_f16_lane(wf[..],0,xq[..],4,4)-exp_f16)<0.0001f32;
    #assert am_dot_f16_lane(wf[..],4,xq[..],0,0)==0.0f32;
    // 2-row-per-warp write helpers
    out2:[4]f32;out2[0]=99.0f32;out2[1]=99.0f32;out2[2]=99.0f32;out2[3]=99.0f32;
    am_dot_q4_2_write(wq[..],0,9,xq[..],0,1,out2[..],0,1);
    #assert abs(out2[0]-g_q)<0.0001f32 && abs(out2[1]-u_q)<0.0001f32;
    am_dot_iq4_situ_2_write(wq[..],0,9,9,0,xq[..],0,1,3.0f32,2.0f32,out2[..],2,3);
    #assert abs(out2[2]-am_dot_iq4_situ_lane(wq[..],0,9,xq[..],0,1,3.0f32,2.0f32))<0.0001f32;
    #assert abs(out2[3]-am_dot_iq4_situ_lane(wq[..],9,0,xq[..],0,1,3.0f32,2.0f32))<0.0001f32;
    out2[0]=1.0f32;out2[1]=2.0f32;
    am_dot_iq4_moe_2_write(wq[..],mids[..],mwts[..],xq[..],18,0,9,32,2,0,out2[..],0,1);
    exp_m0:=am_dot_iq4_moe_lane(wq[..],mids[..],mwts[..],xq[..],18,0,32,2);
    #assert abs(out2[0]-exp_m0)<0.0001f32 && abs(out2[1]-exp_mi)<0.0001f32;
    am_dot_iq4_moe_2_write(wq[..],mids[..],mwts[..],xq[..],18,0,9,32,2,1,out2[..],0,1);
    #assert abs(out2[0]-2.0f32*exp_m0)<0.0001f32 && abs(out2[1]-2.0f32*exp_mi)<0.0001f32;
}
#test "am_matmul_iq4 decodes IQ4_NL weights and multiplies" {
    exp_lut:=[16]f32.[-127.0f32,-104.0f32,-83.0f32,-65.0f32,-49.0f32,-35.0f32,-22.0f32,-10.0f32,1.0f32,13.0f32,25.0f32,38.0f32,53.0f32,69.0f32,89.0f32,113.0f32];
    for q:0..<16 {#assert am_iq4_lut(cast(u32)q)==exp_lut[q];}
    #assert am_iq4_lut(16)==-127.0f32;
    #assert am_f16(0x3c00)==1.0f32 && am_f16(0xbc00)==-1.0f32 && am_f16(0x0000)==0.0f32 && am_f16(0x0400)==(1.0f32/16384.0f32);
    #assert am_f16(0x0200)==(0.5f32/16384.0f32) && am_f16(0x4400)==4.0f32 && am_f16(0x3600)==0.375f32 && am_f16(0x7c00)==0.0f32 && am_f16(0x3c01)>1.0f32;
    #assert am_matmul_iq4_valid(1,64,1,0,0,64,18,64,1,4096) && !am_matmul_iq4_valid(3,64,3,0,0,64,54,192,8,4096);
    #assert am_matmul_iq4_valid(2,64,2,0,0,64,36,128,4,4096);
    #assert !am_matmul_iq4_valid(0,64,2,0,0,64,36,128,4,4096) && !am_matmul_iq4_valid(2,32,2,0,0,64,36,128,4,4096) && !am_matmul_iq4_valid(2,96,2,0,0,64,72,192,4,4096);
    #assert !am_matmul_iq4_valid(2,64,0,0,0,64,36,128,4,4096) && !am_matmul_iq4_valid(2,64,2,-1,0,64,36,128,4,4096) && !am_matmul_iq4_valid(2,64,2,2,0,64,36,128,4,4096);
    #assert !am_matmul_iq4_valid(2,64,2,0,-1,64,36,128,4,4096) && !am_matmul_iq4_valid(2,64,2,0,2,64,36,128,4,4096) && !am_matmul_iq4_valid(2,64,2,0,0,64,36,128,4,4095);
    #assert !am_matmul_iq4_valid(2,64,2,0,0,64,35,128,4,4096) && !am_matmul_iq4_valid(2,64,2,0,0,64,36,127,4,4096) && !am_matmul_iq4_valid(2,64,2,0,0,64,36,128,3,4096);
    w:[72]u16;x:[256]f32;out:[4]f32;tg:[4096]u16;
    for r:0..<2 {
        for b:0..<4 {
            base:=(r*4+b)*9;
            w[base]=ifx r==0 then 0x3c00 else 0x4000;
            for k:0..<8 {w[base+1+k]=0x9888;}
        }
    }
    for t:0..<2 {for i:0..<128 {x[t*128+i]=f32((t+1)*(i+1));}}
    am_matmul_iq4(128,16,64,2,128,2,0,0,w[..],x[..],out[..],tg[..]);
    #assert out[0]>0 && out[1]==out[0]*2.0f32 && out[2]==out[0]*2.0f32 && out[3]==out[0]*4.0f32;
    #assert out[0]==f32(128*129/2 + 12*(4*(18+20+22+24+26+28+30+32) + 8*(0+32+64+96)));
    #assert am_bf16_u16(0x3f80)==1.0f32 && am_bf16_u16(0xc000)==-2.0f32;
    xb:[256]u16;outb:[4]f32;
    for i:0..<256 {xb[i]=cast(u16)(f32_bits(x[i])>>16);}
    am_matmul_iq4_bf16(128,16,64,2,128,2,0,0,w[..],xb[..],outb[..],tg[..]);
    #assert outb[0]==out[0] && outb[1]==out[1] && outb[2]==out[2] && outb[3]==out[3];
    wb:[4]u32;x2:[8]u16;o2:[4]f32;
    wb[0]=0x40003f80;wb[1]=0x40804040;wb[2]=0x3f804040;wb[3]=0x40004080;
    x2[0]=0x3f80;x2[1]=0x4000;x2[2]=0x4040;x2[3]=0x4080;
    x2[4]=0x4000;x2[5]=0x3f80;x2[6]=0x4080;x2[7]=0x4040;
    am_matmul_bf16_x16(128,16,32,2,4,2,0,0,wb[..],x2[..],o2[..]);
    #assert o2[0]==30.0f32 && o2[1]==25.0f32 && o2[2]==28.0f32 && o2[3]==29.0f32;
}
#test "the simdgroup tile adds a b^T into acc" {
    acc:[2048]f32;a:[2048]f32;b:[1024]f32;out:[2048]f32;
    for ar:0..<64 {for ak:0..<32 {a[ar*32+ak]=f32((ar+2*ak)%5-2);}}
    for ac:0..<32 {for ak:0..<32 {b[ac*32+ak]=f32((3*ak+ac)%7-3);}}
    for ai:0..<2048 {acc[ai]=f32(ai%3);}
    am_sg_mma_64x32x32(acc[..],a[..],b[..]);
    am_sg_mma_64x32x32(acc[..],a[..],b[..]);
    am_sg_spill_64x32(acc[..],out[..]);
    for ar:0..<64 {for ac:0..<32 {
        sum:=0;for ak:0..<32 {sum+=((ar+2*ak)%5-2)*((3*ak+ac)%7-3);}
        #assert out[ar*32+ac]==f32(2*sum+(ar*32+ac)%3) && acc[ar*32+ac]==out[ar*32+ac];
    }}
    am_sg_zero_64x32(acc[..]);
    for ai:0..<2048 {#assert acc[ai]==0.0f32;}
    ah:[2048]u16;bh:[1024]u16;
    for ar:0..<64 {for ak:0..<32 {ah[ar*32+ak]=am_to_f16(f32((ar+ak)%3-1));}}
    for ac:0..<32 {for ak:0..<32 {bh[ac*32+ak]=am_to_f16(f32((ac+ak)%3-1));}}
    am_sg_mma_f16_64x32x32(acc[..],ah[..],bh[..]);
    #assert acc[0]==f32(21) && acc[3*32+5]==f32(-11);
}
#test "the 32 products are added before rounding into acc" {
    acc:[2048]f32;a:[2048]f32;b:[1024]f32;
    for ai:0..<2048 {acc[ai]=1;a[ai]=f32_from_bits(0x33800000);}
    for ai:0..<1024 {b[ai]=1;}
    am_sg_mma_64x32x32(acc[..],a[..],b[..]);
    for ai:0..<2048 {#assert acc[ai]==1+32*f32_from_bits(0x33800000);}
}
#test "the tensor-op tile writes its tokens and rows, clipped to the matrix" {
    // 3 rows by 4 columns, 5 tokens: a 16 by 32 tile at (r0 1, t0 2), clipped.
    w:[6]u32;x:[20]f32;out:[15]f32;
    for ar:0..<3 {for ap:0..<2 {w[ar*2+ap]=(f32_bits(f32(ar+ap))>>16)|((f32_bits(f32(ar-ap))>>16)<<16);}}
    for at:0..<5 {for ac:0..<4 {x[at*4+ac]=f32(at*ac+1);}}
    for ai:0..<15 {out[ai]=-7;}
    am_matmul_bf16(128,16,32,3,4,5,1,2,w[..],x[..],out[..]);
    for at:0..<5 {for ar:0..<3 {
        expected:f32=-7;
        if at>=2 && ar>=1 {
            sum:=0.0;for ap:0..<2 {sum+=f64(x[at*4+2*ap])*f64(ar+ap)+f64(x[at*4+2*ap+1])*f64(ar-ap);}
            expected=f32(sum);
        }
        #assert out[at*3+ar]==expected;
    }}
}
#test "the tensor-op tile rounds once" {
    // 1, then sixteen times 2^-24: the sixteen ulps survive only if added first.
    w:[9]u32;x:[18]f32;out:[1]f32;
    for ap:0..<9 {w[ap]=0x3f803f80;}
    for ac:2..<18 {x[ac]=f32_from_bits(0x33800000);}
    x[0]=1;x[1]=0;
    am_matmul_bf16(64,16,32,1,18,1,0,0,w[..],x[..],out[..]);
    #assert out[0]==1+16*f32_from_bits(0x33800000);
}
#forall "the tensor-op tile checks its shape and views" rows:0..<3, cols:0..<4, tokens:0..<3, r0:-1..<3, t0:-1..<3 {
    w:=rows*(cols/2);x:=tokens*cols;out:=tokens*rows;
    expected:=rows>=1 && cols>=2 && cols%2==0 && tokens>=1 && r0>=0 && r0<rows && t0>=0 && t0<tokens;
    #assert am_matmul_valid(rows,cols,tokens,r0,t0,w,x,out)==expected;
    if expected {
        #assert !am_matmul_valid(rows,cols,tokens,r0,t0,w-1,x,out) && !am_matmul_valid(rows,cols,tokens,r0,t0,w,x-1,out) && !am_matmul_valid(rows,cols,tokens,r0,t0,w,x,out-1);
    }
}
#test "the tensor-op tile refuses shapes past 32-bit extents" {
    #assert !am_matmul_valid(2147483647,2,1,0,0,2147483647,2,2147483647) && !am_matmul_valid(1,2,2147483647,0,0,1,4294967294,2147483647);
    #assert !am_matmul_valid(65536,65536,1,0,0,2147483648,65536,65536) && am_matmul_valid(1,2,1,0,0,1,2,1);
}
#test "the tensor-op tile admits every extent up to 2^31-1 exactly" {
    big:=4294967296;
    // rows*cols, tokens*cols, tokens*rows each at the limit, then one past it.
    #assert am_matmul_valid(1073741823,2,1,0,0,big,big,big) && !am_matmul_valid(1073741824,2,1,0,0,big,big,big);
    #assert am_matmul_valid(1,2,1073741823,0,0,big,big,big) && !am_matmul_valid(1,2,1073741824,0,0,big,big,big);
    #assert am_matmul_valid(4,2,536870911,0,0,big,big,big) && !am_matmul_valid(4,2,536870912,0,0,big,big,big);
}
#forall "tensor-op tiles are 64, 128 or 256 threads, 16, 32 or 64 tokens by 32, 64 or 128 rows" a:0..<9, b:0..<9, c:0..<9 {
    near:=[9]int.[15,16,32,33,63,64,65,128,256];
    threads:=near[a]+(a/8);tm:=near[b];tn:=near[c]; // a 8: 257
    expected:=(threads==64 || threads==128 || threads==256) && (tm==16 || tm==32 || tm==64) && (tn==32 || tn==64 || tn==128);
    #assert am_tile_valid(threads,tm,tn)==expected;
    #assert am_tile_valid(256,64,128) && am_tile_valid(128,16,32) && !am_tile_valid(129,16,32) && !am_tile_valid(128,17,32) && !am_tile_valid(128,16,129);
}
#test "decode norms, dots and ctrl_up primitives match exact math" {
    // am_dot_f16_tg_write: add=0, add=1, eps=0, eps>0 with v=3 (3*3!=3+3)
    wf:[8]u16;xf:[8]f32;of:[4]f32;
    wf[0]=0x3c00;wf[1]=0x4000;wf[2]=0xbc00;wf[3]=0x3800;wf[4]=0x3c00;wf[5]=0x3c00;wf[6]=0x3c00;wf[7]=0x3c00;
    xf[0]=1.0f32;xf[1]=2.0f32;xf[2]=3.0f32;xf[3]=4.0f32;xf[4]=3.0f32;xf[5]=3.0f32;xf[6]=3.0f32;xf[7]=3.0f32;
    am_dot_f16_tg_write(wf[..],0,xf[..],0,4,0,0.0f32,of[..],0);
    #assert abs(of[0]-4.0f32)<0.0001f32;
    am_dot_f16_tg_write(wf[..],0,xf[..],0,4,1,0.0f32,of[..],0);
    #assert abs(of[0]-8.0f32)<0.0001f32;
    am_dot_f16_tg_write(wf[..],4,xf[..],4,4,0,0.0f32,of[..],1);
    #assert abs(of[1]-12.0f32)<0.0001f32;
    am_dot_f16_tg_write(wf[..],4,xf[..],4,4,0,7.0f32,of[..],2);
    #assert abs(of[2]-3.0f32)<0.0001f32;
    // am_rmsnorm_f32: has_w=0 and has_w=1, v=3 (3*3+7=16)
    rx:[8]f32;rw:[8]f32;ro:[8]f32;
    for i:0..<4 {rx[4+i]=3.0f32;rw[2+i]=f32(i+1);}
    am_rmsnorm_f32(4,0,7.0f32,rx[..],4,rw[..],2,ro[..],1);
    #assert abs(ro[1]-0.75f32)<0.0001f32 && abs(ro[4]-0.75f32)<0.0001f32;
    am_rmsnorm_f32(4,1,7.0f32,rx[..],4,rw[..],2,ro[..],1);
    #assert abs(ro[1]-0.75f32)<0.0001f32 && abs(ro[2]-1.5f32)<0.0001f32 && abs(ro[4]-3.0f32)<0.0001f32;
    // am_ctrl_up_apply_f16, am_ctrl_up_apply_gf, am_ctrl_up_apply_gf_norm at dim=65 (64 vs 65, < vs <=)
    wg65:[132]u16;wf65:[132]u16;wgf65:[132]u32;gt:[4]f32;cc65:[67]f32;mm65:[67]f32;co65:[67]f32;wn65:[65]f32;rp:[4]f32;
    for i:0..<132 {wg65[i]=0x3c00;wf65[i]=0x3800;}
    wg65[67]=0x4000;wf65[68]=0xbc00;
    for i:0..<132 {wgf65[i]=cast(u32)wg65[i]|(cast(u32)wf65[i]<<16);}
    gt[1]=1.0f32;gt[2]=0.5f32;
    for i:0..<67 {cc65[i]=2.0f32+f32(i%3);mm65[i]=4.0f32+f32(i%2);co65[i]=-99.0f32;}
    for i:0..<65 {wn65[i]=1.0f32+f32(i%4)*0.25f32;}
    am_ctrl_up_apply_f16(65,2,0,wg65[..],2,wf65[..],2,gt[..],1,cc65[..],1,mm65[..],1,co65[..],1);
    eg0:=3.0f32-am_tanh(0.75f32)*3.0f32+am_tanh(2.0f32)*5.0f32;
    eg1:=4.0f32-am_tanh(0.0f32)*4.0f32+am_tanh(1.5f32)*4.0f32;
    eg64:=4.0f32-am_tanh(0.75f32)*4.0f32+am_tanh(1.5f32)*5.0f32;
    #assert abs(co65[1]-eg0)<0.001f32 && abs(co65[2]-eg1)<0.001f32 && abs(co65[65]+99.0f32)<0.001f32;
    am_ctrl_up_apply_f16(65,2,64,wg65[..],2,wf65[..],2,gt[..],1,cc65[..],1,mm65[..],1,co65[..],1);
    #assert abs(co65[65]-eg64)<0.001f32 && abs(co65[66]+99.0f32)<0.001f32;
    for i:0..<67 {co65[i]=-99.0f32;}
    am_ctrl_up_apply_gf(65,2,0,wgf65[..],2,gt[..],1,cc65[..],1,mm65[..],1,co65[..],1);
    #assert abs(co65[1]-eg0)<0.001f32 && abs(co65[2]-eg1)<0.001f32 && abs(co65[65]+99.0f32)<0.001f32;
    am_ctrl_up_apply_gf(65,2,64,wgf65[..],2,gt[..],1,cc65[..],1,mm65[..],1,co65[..],1);
    #assert abs(co65[65]-eg64)<0.001f32 && abs(co65[66]+99.0f32)<0.001f32;
    for i:0..<67 {co65[i]=-99.0f32;}
    am_ctrl_up_apply_gf_norm(65,2,0,wgf65[..],2,gt[..],1,cc65[..],1,mm65[..],1,wn65[..],co65[..],1,rp[..],2);
    #assert abs(co65[1]-eg0*wn65[0])<0.001f32 && abs(co65[2]-eg1*wn65[1])<0.001f32 && abs(co65[65]+99.0f32)<0.001f32;
    am_ctrl_up_apply_gf_norm(65,2,64,wgf65[..],2,gt[..],1,cc65[..],1,mm65[..],1,wn65[..],co65[..],1,rp[..],3);
    #assert abs(co65[65]-eg64*wn65[64])<0.001f32 && abs(rp[3]-eg64*eg64)<0.01f32 && abs(co65[66]+99.0f32)<0.001f32;
    // am_ctrl_up_apply_gf_rm_norm: row-major [65, 2] at w_off=2 (32 rows/item)
    wgfrm:[132]u32;
    for r:0..<65 {for k:0..<2 {wgfrm[2+r*2+k]=wgf65[2+k*65+r];}}
    for i:0..<67 {co65[i]=-99.0f32;}
    rp[2]=0.0f32;rp[3]=0.0f32;
    am_ctrl_up_apply_gf_rm_norm(65,2,0,wgfrm[..],2,gt[..],1,cc65[..],1,mm65[..],1,wn65[..],co65[..],1,rp[..],2);
    #assert abs(co65[1]-eg0*wn65[0])<0.001f32 && abs(co65[2]-eg1*wn65[1])<0.001f32 && abs(co65[33]+99.0f32)<0.001f32 && rp[2]>50.0f32;
    am_ctrl_up_apply_gf_rm_norm(65,2,64,wgfrm[..],2,gt[..],1,cc65[..],1,mm65[..],1,wn65[..],co65[..],1,rp[..],3);
    #assert abs(co65[65]-eg64*wn65[64])<0.001f32 && abs(rp[3]-eg64*eg64)<0.01f32 && abs(co65[66]+99.0f32)<0.001f32;
    // am_ctrl_up_apply_gf_batch at n_tok=17 (16 vs 17)
    wgf2:[8]u32;gbt:[34]f32;cbt:[36]f32;mbt:[36]f32;obt:[36]f32;
    for i:0..<8 {wgf2[i]=0x38003c00;}
    wgf2[4]=0x38004000;wgf2[5]=0xbc003c00;
    for t:0..<17 {
        gbt[t*2]=1.0f32;gbt[t*2+1]=0.5f32;
        cbt[t*2]=2.0f32;cbt[t*2+1]=3.0f32;
        mbt[t*2]=4.0f32;mbt[t*2+1]=5.0f32;
        obt[t*2]=-77.0f32;obt[t*2+1]=-77.0f32;
    }
    obt[34]=-77.0f32;obt[35]=-77.0f32;
    eb0:=2.0f32-am_tanh(0.75f32)*2.0f32+am_tanh(2.0f32)*4.0f32;
    eb1:=3.0f32-am_tanh(0.0f32)*3.0f32+am_tanh(1.5f32)*5.0f32;
    am_ctrl_up_apply_gf_batch(2,2,17,0,0,wgf2[..],2,gbt[..],0,cbt[..],0,mbt[..],0,obt[..],0);
    #assert abs(obt[0]-eb0)<0.001f32 && abs(obt[31]-eb1)<0.001f32 && abs(obt[32]+77.0f32)<0.001f32;
    am_ctrl_up_apply_gf_batch(2,2,17,16,0,wgf2[..],2,gbt[..],0,cbt[..],0,mbt[..],0,obt[..],0);
    #assert abs(obt[32]-eb0)<0.001f32 && abs(obt[33]-eb1)<0.001f32 && abs(obt[34]+77.0f32)<0.001f32;
    // am_dot_q4_2_write_ex & am_dot_f16_tg_write_rms: n_parts=0, 1, 2
    wqq:[18]u16;xqq:[32]f32;qparts:[4]f32;qout:[2]f32;
    wqq[0]=0x3c00;wqq[9]=0x4000;
    for k:0..<8 {wqq[1+k]=0x9999;wqq[10+k]=0x9999;}
    for i:0..<32 {xqq[i]=1.0f32;}
    qparts[1]=128.0f32;qparts[2]=160.0f32;
    am_dot_q4_2_write_ex(wqq[..],0,9,xqq[..],0,1,qparts[..],1,0,0.0f32,0.0f32,qout[..],0,1);
    #assert abs(qout[0]-32.0f32)<0.01f32 && abs(qout[1]-64.0f32)<0.01f32;
    am_dot_q4_2_write_ex(wqq[..],0,9,xqq[..],0,1,qparts[..],1,1,5.0f32,0.0f32,qout[..],0,1);
    #assert abs(qout[0]-(32.0f32/3.0f32))<0.01f32 && abs(qout[1]-(64.0f32/3.0f32))<0.01f32;
    am_dot_q4_2_write_ex(wqq[..],0,9,xqq[..],0,1,qparts[..],1,2,7.0f32,10.0f32,qout[..],0,1);
    #assert abs(qout[0]-10.0f32*am_tanh(32.0f32/40.0f32))<0.01f32 && abs(qout[1]-10.0f32*am_tanh(64.0f32/40.0f32))<0.01f32;
    qparts[1]=16.0f32;qparts[2]=20.0f32;
    am_dot_f16_tg_write_rms(wf[..],4,xf[..],4,4,qparts[..],1,0,5.0f32,of[..],0);
    #assert abs(of[0]-12.0f32)<0.001f32;
    am_dot_f16_tg_write_rms(wf[..],4,xf[..],4,4,qparts[..],1,1,5.0f32,of[..],1);
    #assert abs(of[1]-4.0f32)<0.001f32;
    am_dot_f16_tg_write_rms(wf[..],4,xf[..],4,4,qparts[..],1,2,7.0f32,of[..],2);
    #assert abs(of[2]-3.0f32)<0.001f32;
    // am_dot_q4_qrgkv: distinct scales per row, n_parts=0, 1, 3, sentinel at ov5[0] (8 vs 9)
    wq5:[90]u16;xkq:[32]f32;xvq:[32]f32;p5:[9]f32;oq5:[2]f32;or5:[2]f32;og5:[2]f32;ok5:[2]f32;ov5:[2]f32;
    r_sc:=[10]u16.[0x3c00,0x4000,0x4200,0x4400,0x4500,0x3800,0x3e00,0x4100,0x4300,0x4480];
    for r:0..<10 {
        wq5[r*9]=r_sc[r];
        for k:0..<8 {wq5[r*9+1+k]=0x9999;}
    }
    for i:0..<32 {xkq[i]=2.0f32;xvq[i]=3.0f32;}
    ov5[0]=-55.0f32;ov5[1]=-55.0f32;
    am_dot_q4_qrgkv(0,2,2,2,32,0,0.0f32,wq5[..],xqq[..],xkq[..],xvq[..],p5[..],oq5[..],or5[..],og5[..],ok5[..],ov5[..]);
    #assert abs(oq5[0]-32.0f32)<0.01f32 && abs(oq5[1]-64.0f32)<0.01f32 && abs(or5[0]-96.0f32)<0.01f32 && abs(or5[1]-128.0f32)<0.01f32;
    #assert abs(og5[0]-160.0f32)<0.01f32 && abs(og5[1]-16.0f32)<0.01f32 && abs(ok5[0]-96.0f32)<0.01f32 && abs(ok5[1]-160.0f32)<0.01f32;
    #assert abs(ov5[0]+55.0f32)<0.01f32;
    am_dot_q4_qrgkv(8,2,2,2,32,0,0.0f32,wq5[..],xqq[..],xkq[..],xvq[..],p5[..],oq5[..],or5[..],og5[..],ok5[..],ov5[..]);
    #assert abs(ov5[0]-336.0f32)<0.01f32 && abs(ov5[1]-432.0f32)<0.01f32;
    p5[0]=128.0f32;p5[1]=256.0f32;p5[2]=512.0f32;
    am_dot_q4_qrgkv(0,2,2,2,32,1,5.0f32,wq5[..],xqq[..],xkq[..],xvq[..],p5[..],oq5[..],or5[..],og5[..],ok5[..],ov5[..]);
    am_dot_q4_qrgkv(8,2,2,2,32,1,5.0f32,wq5[..],xqq[..],xkq[..],xvq[..],p5[..],oq5[..],or5[..],og5[..],ok5[..],ov5[..]);
    #assert abs(oq5[0]-(32.0f32/3.0f32))<0.01f32 && abs(ok5[0]-(96.0f32/sqrt(13.0f32)))<0.01f32 && abs(ov5[0]-(336.0f32/sqrt(21.0f32)))<0.01f32;
    p5[0]=32.0f32;p5[1]=32.0f32;p5[2]=64.0f32;p5[3]=64.0f32;p5[4]=64.0f32;p5[5]=128.0f32;p5[6]=128.0f32;p5[7]=128.0f32;p5[8]=256.0f32;
    am_dot_q4_qrgkv(0,2,2,2,32,3,5.0f32,wq5[..],xqq[..],xkq[..],xvq[..],p5[..],oq5[..],or5[..],og5[..],ok5[..],ov5[..]);
    am_dot_q4_qrgkv(8,2,2,2,32,3,5.0f32,wq5[..],xqq[..],xkq[..],xvq[..],p5[..],oq5[..],or5[..],og5[..],ok5[..],ov5[..]);
    #assert abs(oq5[0]-(32.0f32/3.0f32))<0.01f32 && abs(ok5[0]-(96.0f32/sqrt(13.0f32)))<0.01f32 && abs(ov5[0]-(336.0f32/sqrt(21.0f32)))<0.01f32;
}
#test "decode MoE and post-conv primitives match exact math" {
    // am_post_conv_step & am_dot_q4_conv_2_write with distinct weights/hist
    cwq:[8]f32;chq:[6]f32;crq:[2]f32;coq:[2]f32;wqq:[18]u16;xqq:[64]f32;
    wqq[0]=0x3c00;wqq[9]=0x4000;
    for k:0..<8 {wqq[1+k]=0x9999;wqq[10+k]=0x9999;}
    for i:0..<64 {xqq[i]=1.0f32+f32(i%5)*0.25f32;}
    cwq[0]=0.1f32;cwq[1]=0.2f32;cwq[2]=0.3f32;cwq[3]=0.4f32;
    cwq[4]=0.15f32;cwq[5]=0.25f32;cwq[6]=0.35f32;cwq[7]=0.45f32;
    chq[0]=1.0f32;chq[1]=2.0f32;chq[2]=3.0f32;chq[3]=4.0f32;chq[4]=5.0f32;chq[5]=6.0f32;
    crq[0]=10.0f32;crq[1]=20.0f32;
    v0:=am_dot_q4_lane(wqq[..],0,xqq[..],0,1);v1:=am_dot_q4_lane(wqq[..],9,xqq[..],0,1);
    e0:=(v0+1.0f32*0.1f32+2.0f32*0.2f32+3.0f32*0.3f32+v0*0.4f32)*0.4472135954999579f32;
    e1:=(v1+4.0f32*0.15f32+5.0f32*0.25f32+6.0f32*0.35f32+v1*0.45f32)*0.4472135954999579f32;
    am_dot_q4_conv_2_write(wqq[..],0,9,xqq[..],1,0,cwq[..],chq[..],crq[..],coq[..],0,1);
    #assert abs(coq[0]-e0)<0.001f32 && abs(coq[1]-e1)<0.001f32;
    #assert abs(chq[0]-2.0f32)<0.001f32 && abs(chq[1]-3.0f32)<0.001f32 && abs(chq[2]-v0)<0.001f32;
    #assert abs(chq[3]-5.0f32)<0.001f32 && abs(chq[4]-6.0f32)<0.001f32 && abs(chq[5]-v1)<0.001f32;
    e0b:=(v0+2.0f32*0.1f32+3.0f32*0.2f32+v0*0.3f32+v0*0.4f32)*0.4472135954999579f32;
    e1b:=(v1+5.0f32*0.15f32+6.0f32*0.25f32+v1*0.35f32+v1*0.45f32)*0.4472135954999579f32;
    am_dot_q4_conv_2_write(wqq[..],0,9,xqq[..],1,1,cwq[..],chq[..],crq[..],coq[..],0,1);
    #assert abs(coq[0]-(10.0f32+e0b))<0.001f32 && abs(coq[1]-(20.0f32+e1b))<0.001f32;
    ch1_prev:=chq[5];
    am_dot_q4_conv_2_write(wqq[..],0,0,xqq[..],1,0,cwq[..],chq[..],crq[..],coq[..],0,0);
    #assert abs(chq[5]-ch1_prev)<0.001f32 && abs(chq[1]-v0)<0.001f32 && abs(chq[2]-v0)<0.001f32;
    // am_router_top8: has_bias=0, has_bias=1, tiny wsum clamp
    rlog:[4]f32;rbia:[4]f32;rids:[2]u32;rwts:[2]f32;
    rlog[0]=0.0f32;rlog[1]=2.0f32;rlog[2]=-1.0f32;rlog[3]=1.0f32;
    rbia[0]=5.0f32;rbia[1]=0.0f32;rbia[2]=0.0f32;rbia[3]=0.0f32;
    am_router_top8(4,2,0,8.0f32,rlog[..],rbia[..],rids[..],rwts[..]);
    #assert rids[0]==1 && rids[1]==3 && abs(rwts[0]+rwts[1]-8.0f32)<0.001f32 && rwts[0]>rwts[1];
    am_router_top8(4,2,1,8.0f32,rlog[..],rbia[..],rids[..],rwts[..]);
    #assert rids[0]==0 && rids[1]==1 && abs(rwts[0]+rwts[1]-8.0f32)<0.001f32 && rwts[1]>rwts[0];
    rlog[0]=-50.0f32;rlog[1]=-50.0f32;
    am_router_top8(2,1,0,8.0f32,rlog[..],rbia[..],rids[..],rwts[..]);
    #assert rids[0]==0 && rwts[0]>=0.0f32 && rwts[0]<0.001f32;
    // am_moe_gu_iq4_tg & am_moe_gu_q4_tg: n_ff=9 (8 vs 9), eid=1 in slot 0, n_parts=0, 1, 2
    wgu:[324]u16;xgu:[64]f32;mgu:[20]f32;mids:[2]u32;mwts:[2]f32;mlog:[2]f32;mbia:[2]f32;mparts:[4]f32;
    for r:0..<36 {
        wgu[r*9]=am_to_f16(0.25f32+f32(r)*0.0625f32);
        for k:0..<8 {wgu[r*9+1+k]=cast(u16)(0x89ab+(r*3+k)%7);}
    }
    for i:0..<64 {xgu[i]=0.002f32*f32(i+1)-0.03f32;}
    mlog[0]=0.5f32;mlog[1]=2.0f32;mbia[0]=0.0f32;mbia[1]=0.0f32;
    mparts[0]=128.0f32;mparts[1]=160.0f32;
    for i:0..<20 {mgu[i]=-99.0f32;}
    mids[0]=99;mids[1]=99;mwts[0]=0.0f32;mwts[1]=0.0f32;
    am_moe_gu_iq4_tg(0,0,9,32,2,2,0,1.0f32,3.0f32,0.0f32,0,0.0f32,wgu[..],xgu[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    #assert mids[0]==1 && mids[1]==0 && abs(mwts[0]+mwts[1]-1.0f32)<0.001f32 && mwts[0]>mwts[1];
    #assert abs(mgu[0]-am_dot_iq4_situ_lane(wgu[..],162,243,xgu[..],0,1,3.0f32,0.0f32))<0.001f32;
    #assert abs(mgu[7]-am_dot_iq4_situ_lane(wgu[..],162+7*9,243+7*9,xgu[..],0,1,3.0f32,0.0f32))<0.001f32;
    #assert abs(mgu[8]+99.0f32)<0.001f32;
    mids[0]=77;mwts[0]=0.25f32;
    am_moe_gu_iq4_tg(0,8,9,32,2,2,0,1.0f32,3.0f32,0.0f32,0,0.0f32,wgu[..],xgu[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    #assert mids[0]==77 && abs(mwts[0]-0.25f32)<0.001f32;
    #assert abs(mgu[8]-am_dot_iq4_situ_lane(wgu[..],162+8*9,243+8*9,xgu[..],0,1,3.0f32,0.0f32))<0.001f32 && abs(mgu[9]+99.0f32)<0.001f32;
    am_moe_gu_iq4_tg(1,0,9,32,2,2,0,1.0f32,3.0f32,0.0f32,0,0.0f32,wgu[..],xgu[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    #assert mids[0]==77 && abs(mgu[9]-am_dot_iq4_situ_lane(wgu[..],0,81,xgu[..],0,1,3.0f32,0.0f32))<0.001f32;
    // Deferred rms_parts on am_moe_gu_iq4_tg: n_parts=1 (inv=1/3) and n_parts=2 (inv=1/4)
    am_moe_gu_iq4_tg(0,0,9,32,2,2,0,1.0f32,3.0f32,0.0f32,1,5.0f32,wgu[..],xgu[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    ig0:=am_dot_iq4_lane(wgu[..],162,xgu[..],0,1)/3.0f32;iu0:=am_dot_iq4_lane(wgu[..],243,xgu[..],0,1)/3.0f32;
    #assert abs(mgu[0]-am_situ_act(ig0,iu0,3.0f32,0.0f32))<0.001f32;
    am_moe_gu_iq4_tg(0,0,9,32,2,2,0,1.0f32,3.0f32,0.0f32,2,7.0f32,wgu[..],xgu[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    ig1:=am_dot_iq4_lane(wgu[..],162,xgu[..],0,1)/4.0f32;iu1:=am_dot_iq4_lane(wgu[..],243,xgu[..],0,1)/4.0f32;
    #assert abs(mgu[0]-am_situ_act(ig1,iu1,3.0f32,0.0f32))<0.001f32;
    for i:0..<20 {mgu[i]=-99.0f32;}
    mids[0]=99;mids[1]=99;mwts[0]=0.0f32;mwts[1]=0.0f32;
    am_moe_gu_q4_tg(0,0,9,32,2,2,0,1.0f32,3.0f32,0.0f32,0,0.0f32,wgu[..],xgu[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    #assert mids[0]==1 && mids[1]==0 && abs(mwts[0]+mwts[1]-1.0f32)<0.001f32 && mwts[0]>mwts[1];
    #assert abs(mgu[0]-am_dot_q4_situ_lane(wgu[..],162,243,xgu[..],0,1,3.0f32,0.0f32))<0.001f32;
    #assert abs(mgu[7]-am_dot_q4_situ_lane(wgu[..],162+7*9,243+7*9,xgu[..],0,1,3.0f32,0.0f32))<0.001f32 && abs(mgu[8]+99.0f32)<0.001f32;
    mids[0]=77;mwts[0]=0.25f32;
    am_moe_gu_q4_tg(0,8,9,32,2,2,0,1.0f32,3.0f32,0.0f32,0,0.0f32,wgu[..],xgu[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    #assert mids[0]==77 && abs(mwts[0]-0.25f32)<0.001f32;
    #assert abs(mgu[8]-am_dot_q4_situ_lane(wgu[..],162+8*9,243+8*9,xgu[..],0,1,3.0f32,0.0f32))<0.001f32 && abs(mgu[9]+99.0f32)<0.001f32;
    am_moe_gu_q4_tg(1,0,9,32,2,2,0,1.0f32,3.0f32,0.0f32,0,0.0f32,wgu[..],xgu[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    #assert mids[0]==77 && abs(mgu[9]-am_dot_q4_situ_lane(wgu[..],0,81,xgu[..],0,1,3.0f32,0.0f32))<0.001f32;
    // Deferred rms_parts on am_moe_gu_q4_tg: n_parts=1 (inv=1/3) and n_parts=2 (inv=1/4)
    am_moe_gu_q4_tg(0,0,9,32,2,2,0,1.0f32,3.0f32,0.0f32,1,5.0f32,wgu[..],xgu[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    qg0:=am_dot_q4_lane(wgu[..],162,xgu[..],0,1)/3.0f32;qu0:=am_dot_q4_lane(wgu[..],243,xgu[..],0,1)/3.0f32;
    #assert abs(mgu[0]-am_situ_act(qg0,qu0,3.0f32,0.0f32))<0.001f32;
    am_moe_gu_q4_tg(0,0,9,32,2,2,0,1.0f32,3.0f32,0.0f32,2,7.0f32,wgu[..],xgu[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    qg1:=am_dot_q4_lane(wgu[..],162,xgu[..],0,1)/4.0f32;qu1:=am_dot_q4_lane(wgu[..],243,xgu[..],0,1)/4.0f32;
    #assert abs(mgu[0]-am_situ_act(qg1,qu1,3.0f32,0.0f32))<0.001f32;
    // am_moe_down_iq4_tg & am_moe_down_q4_tg: 8 rows/TG, rows=9 (8 vs 9), eid=1 & 0 (kills ew=rows*rw * -> +)
    md_cw:[40]f32;md_h:[30]f32;md_r:[10]f32;md_o:[10]f32;
    for r:0..<9 {
        md_cw[r*4+0]=0.1f32;md_cw[r*4+1]=0.2f32;md_cw[r*4+2]=0.3f32;md_cw[r*4+3]=0.4f32;
        md_h[r*3+0]=1.0f32+f32(r);md_h[r*3+1]=2.0f32+f32(r);md_h[r*3+2]=3.0f32+f32(r);
        md_r[r]=10.0f32+f32(r);md_o[r]=-88.0f32;
    }
    md_o[9]=-88.0f32;mids[0]=1;mids[1]=0;mwts[0]=0.6f32;mwts[1]=0.4f32;
    am_moe_down_iq4_tg(0,9,32,2,wgu[..],xqq[..],mids[..],mwts[..],md_cw[..],md_h[..],md_r[..],md_o[..]);
    mv0:=am_dot_iq4_moe_lane(wgu[..],mids[..],mwts[..],xqq[..],81,0,32,2);
    mv7:=am_dot_iq4_moe_lane(wgu[..],mids[..],mwts[..],xqq[..],81,63,32,2);
    mv8:=am_dot_iq4_moe_lane(wgu[..],mids[..],mwts[..],xqq[..],81,72,32,2);
    #assert abs(md_o[0]-(10.0f32+(mv0+1.4f32+0.4f32*mv0)*0.4472135954999579f32))<0.01f32;
    #assert abs(md_o[7]-(17.0f32+(mv7+5.6f32+0.4f32*mv7)*0.4472135954999579f32))<0.01f32 && abs(md_o[8]+88.0f32)<0.001f32;
    am_moe_down_iq4_tg(8,9,32,2,wgu[..],xqq[..],mids[..],mwts[..],md_cw[..],md_h[..],md_r[..],md_o[..]);
    #assert abs(md_o[8]-(18.0f32+(mv8+6.2f32+0.4f32*mv8)*0.4472135954999579f32))<0.01f32 && abs(md_o[9]+88.0f32)<0.001f32;
    for r:0..<9 {md_h[r*3+0]=1.0f32+f32(r);md_h[r*3+1]=2.0f32+f32(r);md_h[r*3+2]=3.0f32+f32(r);md_o[r]=-88.0f32;}
    am_moe_down_q4_tg(0,9,32,2,wgu[..],xqq[..],mids[..],mwts[..],md_cw[..],md_h[..],md_r[..],md_o[..]);
    qv0:=am_dot_q4_moe_lane(wgu[..],mids[..],mwts[..],xqq[..],81,0,32,2);
    qv7:=am_dot_q4_moe_lane(wgu[..],mids[..],mwts[..],xqq[..],81,63,32,2);
    qv8:=am_dot_q4_moe_lane(wgu[..],mids[..],mwts[..],xqq[..],81,72,32,2);
    #assert abs(md_o[0]-(10.0f32+(qv0+1.4f32+0.4f32*qv0)*0.4472135954999579f32))<0.01f32;
    #assert abs(md_o[7]-(17.0f32+(qv7+5.6f32+0.4f32*qv7)*0.4472135954999579f32))<0.01f32 && abs(md_o[8]+88.0f32)<0.001f32;
    am_moe_down_q4_tg(8,9,32,2,wgu[..],xqq[..],mids[..],mwts[..],md_cw[..],md_h[..],md_r[..],md_o[..]);
    #assert abs(md_o[8]-(18.0f32+(qv8+6.2f32+0.4f32*qv8)*0.4472135954999579f32))<0.01f32 && abs(md_o[9]+88.0f32)<0.001f32;
}
#test "Q4_B32_SPLIT primitives match exact Q4_0 math" {
    // 16 rows x 2 blocks (cols=64): distinct nibbles in every byte/word and distinct scales per block
    q4w:[288]u16;qs:[128]u32;ds:[32]u16;
    for r:0..<16 {
        for b:0..<2 {
            bi:=r*2+b;
            sc:=am_to_f16(0.5f32+0.25f32*f32((r*3+b)%9));
            ds[bi]=sc;
            q4w[bi*9]=sc;
            for k:0..<4 {
                b0:=cast(u32)((r+b+k*3)%16)|((cast(u32)((r+2*b+k*5+3)%16))<<4);
                b1:=cast(u32)((r+b+k*7+1)%16)|((cast(u32)((r+2*b+k*3+7)%16))<<4);
                b2:=cast(u32)((r+b+k*5+2)%16)|((cast(u32)((r+2*b+k*7+5)%16))<<4);
                b3:=cast(u32)((r+b+k*3+4)%16)|((cast(u32)((r+2*b+k*5+9)%16))<<4);
                qs[bi*4+k]=b0|(b1<<8)|(b2<<16)|(b3<<24);
                q4w[bi*9+1+2*k]=cast(u16)(b0|(b1<<8));
                q4w[bi*9+1+2*k+1]=cast(u16)(b2|(b3<<8));
            }
        }
    }
    xq:[68]f32;xk:[64]f32;xv:[64]f32;
    for i:0..<68 {xq[i]=0.25f32+0.03f32*f32(i+1);}
    for i:0..<64 {xk[i]=0.5f32-0.02f32*f32(i);xv[i]=-0.3f32+0.04f32*f32(i);}
    // Exact equivalence with am_dot_q4_lane (non-zero blk_base=2, x_off=4, blocks=2) + blocks=0
    #assert abs(am_dot_q4s_lane(qs[..],ds[..],2,xq[..],4,2)-am_dot_q4_lane(q4w[..],18,xq[..],4,2))<0.001f32;
    #assert am_dot_q4s_lane(qs[..],ds[..],2,xq[..],4,0)==0.0f32;
    // am_dot_q4s_2_write_ex: n_parts=0, 1, 2, cap=0 & cap>0, r1!=r0 & r1==r0
    parts:[9]f32;out2:[3]f32;
    parts[1]=256.0f32;parts[2]=320.0f32;
    ref0:=am_dot_q4_lane(q4w[..],0,xq[..],4,2);
    ref1:=am_dot_q4_lane(q4w[..],18,xq[..],4,2);
    am_dot_q4s_2_write_ex(qs[..],ds[..],0,2,xq[..],4,2,parts[..],1,0,0.0f32,0.0f32,out2[..],0,1);
    #assert abs(out2[0]-ref0)<0.002f32 && abs(out2[1]-ref1)<0.002f32;
    am_dot_q4s_2_write_ex(qs[..],ds[..],0,2,xq[..],4,2,parts[..],1,1,5.0f32,0.0f32,out2[..],0,1);
    #assert abs(out2[0]-ref0/3.0f32)<0.002f32 && abs(out2[1]-ref1/3.0f32)<0.002f32;
    am_dot_q4s_2_write_ex(qs[..],ds[..],0,2,xq[..],4,2,parts[..],1,2,7.0f32,10.0f32,out2[..],0,1);
    #assert abs(out2[0]-10.0f32*am_tanh((ref0/4.0f32)/10.0f32))<0.005f32 && abs(out2[1]-10.0f32*am_tanh((ref1/4.0f32)/10.0f32))<0.005f32;
    out2[0]=-77.0f32;out2[1]=-77.0f32;
    am_dot_q4s_2_write_ex(qs[..],ds[..],0,2,xq[..],4,2,parts[..],1,0,0.0f32,0.0f32,out2[..],0,0);
    #assert abs(out2[0]-ref0)<0.002f32 && abs(out2[1]+77.0f32)<0.001f32;
    // am_dot_q4s_conv_2_write: add_res=0, 1 and r1==r0
    cw:[8]f32;ch:[6]f32;cr:[2]f32;co:[2]f32;
    cw[0]=0.1f32;cw[1]=0.2f32;cw[2]=0.3f32;cw[3]=0.4f32;
    cw[4]=0.15f32;cw[5]=0.25f32;cw[6]=0.35f32;cw[7]=0.45f32;
    ch[0]=1.0f32;ch[1]=2.0f32;ch[2]=3.0f32;ch[3]=4.0f32;ch[4]=5.0f32;ch[5]=6.0f32;
    cr[0]=10.0f32;cr[1]=20.0f32;
    d0:=am_dot_q4_lane(q4w[..],0,xq[..],0,2);d1:=am_dot_q4_lane(q4w[..],18,xq[..],0,2);
    c0:=(d0+1.4f32+0.4f32*d0)*0.4472135954999579f32;
    c1:=(d1+3.95f32+0.45f32*d1)*0.4472135954999579f32;
    am_dot_q4s_conv_2_write(qs[..],ds[..],0,2,xq[..],2,0,cw[..],ch[..],cr[..],co[..],0,1);
    #assert abs(co[0]-c0)<0.005f32 && abs(co[1]-c1)<0.005f32;
    c0b:=(d0+0.2f32+0.6f32+0.3f32*d0+0.4f32*d0)*0.4472135954999579f32;
    c1b:=(d1+0.75f32+1.5f32+0.35f32*d1+0.45f32*d1)*0.4472135954999579f32;
    am_dot_q4s_conv_2_write(qs[..],ds[..],0,2,xq[..],2,1,cw[..],ch[..],cr[..],co[..],0,1);
    #assert abs(co[0]-(10.0f32+c0b))<0.005f32 && abs(co[1]-(20.0f32+c1b))<0.005f32;
    ch_keep:=ch[5];
    am_dot_q4s_conv_2_write(qs[..],ds[..],0,0,xq[..],2,0,cw[..],ch[..],cr[..],co[..],0,0);
    #assert abs(ch[5]-ch_keep)<0.001f32 && abs(ch[2]-d0)<0.005f32;
    // am_dot_q4s_1row_tg: n_parts=0, 1, 2
    am_dot_q4s_1row_tg(qs[..],ds[..],2,xq[..],4,2,parts[..],1,0,0.0f32,out2[..],2);
    #assert abs(out2[2]-ref1)<0.002f32;
    am_dot_q4s_1row_tg(qs[..],ds[..],2,xq[..],4,2,parts[..],1,1,5.0f32,out2[..],2);
    #assert abs(out2[2]-ref1/3.0f32)<0.002f32;
    am_dot_q4s_1row_tg(qs[..],ds[..],2,xq[..],4,2,parts[..],1,2,7.0f32,out2[..],2);
    #assert abs(out2[2]-ref1/4.0f32)<0.002f32;
    // am_dot_q4s_qrgkv_sdyn: all 8 segments (n_q=2, n_r=2, n_kv=2, n_sinks=2, n_dyn=2 -> 16 rows) with n_parts=0, 1, 3
    oq:[2]f32;or_:[2]f32;og:[2]f32;ok:[2]f32;ov:[2]f32;osk:[2]f32;ody:[4]f32;
    for i:0..<2 {oq[i]=-99.0f32;or_[i]=-99.0f32;og[i]=-99.0f32;ok[i]=-99.0f32;ov[i]=-99.0f32;osk[i]=-99.0f32;}
    for i:0..<4 {ody[i]=-99.0f32;}
    sd0:u32=2|(2<<16);sd1:u32=2|(2<<16);sd2_0:u32=2|(0<<16);
    am_dot_q4s_qrgkv_sdyn(0,sd0,sd1,sd2_0,64,0.0f32,qs[..],ds[..],xq[..],xk[..],xv[..],parts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    #assert abs(oq[0]-am_dot_q4_lane(q4w[..],0,xq[..],0,2))<0.002f32 && abs(or_[1]-am_dot_q4_lane(q4w[..],3*18,xq[..],0,2))<0.002f32;
    #assert abs(og[1]-am_dot_q4_lane(q4w[..],5*18,xq[..],0,2))<0.002f32 && abs(ok[1]-am_dot_q4_lane(q4w[..],7*18,xk[..],0,2))<0.002f32;
    #assert abs(ov[0]+99.0f32)<0.001f32;
    am_dot_q4s_qrgkv_sdyn(8,sd0,sd1,sd2_0,64,0.0f32,qs[..],ds[..],xq[..],xk[..],xv[..],parts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    #assert abs(ov[0]-am_dot_q4_lane(q4w[..],8*18,xv[..],0,2))<0.002f32 && abs(osk[0]-am_dot_q4_lane(q4w[..],10*18,xq[..],0,2))<0.002f32;
    #assert abs(ody[0]-am_dot_q4_lane(q4w[..],12*18,xk[..],0,2))<0.002f32 && abs(ody[3]-am_dot_q4_lane(q4w[..],15*18,xv[..],0,2))<0.002f32;
    // Test n_parts=1 and n_parts=3 with distinct q/k/v sums
    parts[0]=256.0f32;parts[1]=512.0f32;parts[2]=1024.0f32;
    sd2_1:u32=2|(1<<16);
    am_dot_q4s_qrgkv_sdyn(0,sd0,sd1,sd2_1,64,5.0f32,qs[..],ds[..],xq[..],xk[..],xv[..],parts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    am_dot_q4s_qrgkv_sdyn(8,sd0,sd1,sd2_1,64,5.0f32,qs[..],ds[..],xq[..],xk[..],xv[..],parts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    #assert abs(oq[0]-am_dot_q4_lane(q4w[..],0,xq[..],0,2)/3.0f32)<0.002f32;
    #assert abs(ok[0]-am_dot_q4_lane(q4w[..],6*18,xk[..],0,2)/sqrt(13.0f32))<0.002f32;
    #assert abs(ov[0]-am_dot_q4_lane(q4w[..],8*18,xv[..],0,2)/sqrt(21.0f32))<0.002f32;
    #assert abs(osk[1]-am_dot_q4_lane(q4w[..],11*18,xq[..],0,2)/3.0f32)<0.002f32;
    #assert abs(ody[1]-am_dot_q4_lane(q4w[..],13*18,xk[..],0,2)/sqrt(13.0f32))<0.002f32;
    #assert abs(ody[2]-am_dot_q4_lane(q4w[..],14*18,xv[..],0,2)/sqrt(21.0f32))<0.002f32;
    parts[0]=64.0f32;parts[1]=64.0f32;parts[2]=128.0f32;parts[3]=128.0f32;parts[4]=128.0f32;parts[5]=256.0f32;parts[6]=256.0f32;parts[7]=256.0f32;parts[8]=512.0f32;
    sd2_3:u32=2|(3<<16);
    am_dot_q4s_qrgkv_sdyn(0,sd0,sd1,sd2_3,64,5.0f32,qs[..],ds[..],xq[..],xk[..],xv[..],parts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    am_dot_q4s_qrgkv_sdyn(8,sd0,sd1,sd2_3,64,5.0f32,qs[..],ds[..],xq[..],xk[..],xv[..],parts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    #assert abs(oq[0]-am_dot_q4_lane(q4w[..],0,xq[..],0,2)/3.0f32)<0.002f32 && abs(ody[0]-am_dot_q4_lane(q4w[..],12*18,xk[..],0,2)/sqrt(13.0f32))<0.002f32 && abs(ody[3]-am_dot_q4_lane(q4w[..],15*18,xv[..],0,2)/sqrt(21.0f32))<0.002f32;
    // Also test n_dyn=0 (SWA) sentinel on ody[0]
    ody[0]=-88.0f32;
    am_dot_q4s_qrgkv_sdyn(8,sd0,sd1,0,64,0.0f32,qs[..],ds[..],xq[..],xk[..],xv[..],parts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    #assert abs(ody[0]+88.0f32)<0.001f32;
    // am_moe_gu_q4s_tg & am_moe_down_q4s_tg: 2 experts x 2*9 rows x 1 block (36 blocks)
    mqs:[144]u32;mds:[36]u16;mgu:[20]f32;mids:[2]u32;mwts:[2]f32;mlog:[2]f32;mbia:[2]f32;mparts:[4]f32;mx:[64]f32;
    for r:0..<36 {
        mds[r]=am_to_f16(0.25f32+f32(r)*0.0625f32);
        for k:0..<4 {
            v0:=cast(u32)(0x89ab+(r*3+2*k)%7);
            v1:=cast(u32)(0x89ab+(r*3+2*k+1)%7);
            mqs[r*4+k]=v0|(v1<<16);
        }
    }
    for i:0..<64 {mx[i]=0.002f32*f32(i+1)-0.03f32;}
    mlog[0]=0.5f32;mlog[1]=2.0f32;mbia[0]=0.0f32;mbia[1]=0.0f32;
    mparts[0]=128.0f32;mparts[1]=160.0f32;
    for i:0..<20 {mgu[i]=-99.0f32;}
    mids[0]=99;mids[1]=99;mwts[0]=0.0f32;mwts[1]=0.0f32;
    am_moe_gu_q4s_tg(0,0,9,32,2,2,0,1.0f32,3.0f32,0.0f32,0,0.0f32,mqs[..],mds[..],mx[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    #assert mids[0]==1 && mids[1]==0 && abs(mwts[0]+mwts[1]-1.0f32)<0.001f32 && mwts[0]>mwts[1];
    #assert abs(mgu[0]-am_situ_act(am_dot_q4s_lane(mqs[..],mds[..],18,mx[..],0,1),am_dot_q4s_lane(mqs[..],mds[..],27,mx[..],0,1),3.0f32,0.0f32))<0.001f32;
    #assert abs(mgu[7]-am_situ_act(am_dot_q4s_lane(mqs[..],mds[..],25,mx[..],0,1),am_dot_q4s_lane(mqs[..],mds[..],34,mx[..],0,1),3.0f32,0.0f32))<0.001f32 && abs(mgu[8]+99.0f32)<0.001f32;
    mids[0]=77;mwts[0]=0.25f32;
    am_moe_gu_q4s_tg(0,8,9,32,2,2,0,1.0f32,3.0f32,0.0f32,0,0.0f32,mqs[..],mds[..],mx[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    #assert mids[0]==77 && abs(mwts[0]-0.25f32)<0.001f32;
    #assert abs(mgu[8]-am_situ_act(am_dot_q4s_lane(mqs[..],mds[..],26,mx[..],0,1),am_dot_q4s_lane(mqs[..],mds[..],35,mx[..],0,1),3.0f32,0.0f32))<0.001f32 && abs(mgu[9]+99.0f32)<0.001f32;
    am_moe_gu_q4s_tg(1,0,9,32,2,2,0,1.0f32,3.0f32,0.0f32,0,0.0f32,mqs[..],mds[..],mx[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    #assert mids[0]==77 && abs(mgu[9]-am_situ_act(am_dot_q4s_lane(mqs[..],mds[..],0,mx[..],0,1),am_dot_q4s_lane(mqs[..],mds[..],9,mx[..],0,1),3.0f32,0.0f32))<0.001f32;
    am_moe_gu_q4s_tg(0,0,9,32,2,2,0,1.0f32,3.0f32,0.0f32,1,5.0f32,mqs[..],mds[..],mx[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    #assert abs(mgu[0]-am_situ_act(am_dot_q4s_lane(mqs[..],mds[..],18,mx[..],0,1)/3.0f32,am_dot_q4s_lane(mqs[..],mds[..],27,mx[..],0,1)/3.0f32,3.0f32,0.0f32))<0.001f32;
    am_moe_gu_q4s_tg(0,0,9,32,2,2,0,1.0f32,3.0f32,0.0f32,2,7.0f32,mqs[..],mds[..],mx[..],mparts[..],mlog[..],mbia[..],mids[..],mwts[..],mgu[..]);
    #assert abs(mgu[0]-am_situ_act(am_dot_q4s_lane(mqs[..],mds[..],18,mx[..],0,1)/4.0f32,am_dot_q4s_lane(mqs[..],mds[..],27,mx[..],0,1)/4.0f32,3.0f32,0.0f32))<0.001f32;
    md_cw:[40]f32;md_h:[30]f32;md_r:[10]f32;md_o:[10]f32;
    for r:0..<9 {
        md_cw[r*4+0]=0.1f32;md_cw[r*4+1]=0.2f32;md_cw[r*4+2]=0.3f32;md_cw[r*4+3]=0.4f32;
        md_h[r*3+0]=1.0f32+f32(r);md_h[r*3+1]=2.0f32+f32(r);md_h[r*3+2]=3.0f32+f32(r);
        md_r[r]=10.0f32+f32(r);md_o[r]=-88.0f32;
    }
    md_o[9]=-88.0f32;mids[0]=1;mids[1]=0;mwts[0]=0.6f32;mwts[1]=0.4f32;
    am_moe_down_q4s_tg(0,9,32,2,mqs[..],mds[..],xq[..],mids[..],mwts[..],md_cw[..],md_h[..],md_r[..],md_o[..]);
    sv0:=0.6f32*am_dot_q4s_lane(mqs[..],mds[..],9,xq[..],0,1)+0.4f32*am_dot_q4s_lane(mqs[..],mds[..],0,xq[..],32,1);
    sv7:=0.6f32*am_dot_q4s_lane(mqs[..],mds[..],16,xq[..],0,1)+0.4f32*am_dot_q4s_lane(mqs[..],mds[..],7,xq[..],32,1);
    sv8:=0.6f32*am_dot_q4s_lane(mqs[..],mds[..],17,xq[..],0,1)+0.4f32*am_dot_q4s_lane(mqs[..],mds[..],8,xq[..],32,1);
    #assert abs(md_o[0]-(10.0f32+(sv0+1.4f32+0.4f32*sv0)*0.4472135954999579f32))<0.01f32;
    #assert abs(md_o[7]-(17.0f32+(sv7+5.6f32+0.4f32*sv7)*0.4472135954999579f32))<0.01f32 && abs(md_o[8]+88.0f32)<0.001f32;
    am_moe_down_q4s_tg(8,9,32,2,mqs[..],mds[..],xq[..],mids[..],mwts[..],md_cw[..],md_h[..],md_r[..],md_o[..]);
    #assert abs(md_o[8]-(18.0f32+(sv8+6.2f32+0.4f32*sv8)*0.4472135954999579f32))<0.01f32 && abs(md_o[9]+88.0f32)<0.001f32;
}
#test "mix_fused and mix_batch match exact math" {
    blks:[8]f32;curv:[4]f32;qry:[8]f32;auxv:[8]f32;mo0:[8]f32;mo1:[16]f32;
    blks[0]=1.0f32;blks[1]=2.0f32;blks[2]=-1.0f32;blks[3]=0.5f32;
    blks[4]=-0.5f32;blks[5]=1.5f32;blks[6]=2.0f32;blks[7]=1.0f32;
    curv[0]=0.5f32;curv[1]=-1.0f32;curv[2]=1.5f32;curv[3]=2.0f32;
    qry[2]=1.5f32;qry[3]=-0.5f32;qry[4]=2.0f32;qry[5]=1.0f32;
    auxv[2]=2.0f32;auxv[3]=-1.5f32;auxv[4]=3.0f32;auxv[5]=0.5f32;
    // Reference mix calculation
    iv0:=1.0f32/sqrt((1.0f32+4.0f32+1.0f32+0.25f32)/4.0f32+0.000001f32);
    iv1:=1.0f32/sqrt((0.25f32+2.25f32+4.0f32+1.0f32)/4.0f32+0.000001f32);
    iv2:=1.0f32/sqrt((0.25f32+1.0f32+2.25f32+4.0f32)/4.0f32+0.000001f32);
    sc0:=(1.5f32-1.0f32-2.0f32+0.5f32)*iv0*0.5f32;
    sc1:=(-0.75f32-0.75f32+4.0f32+1.0f32)*iv1*0.5f32;
    sc2:=(0.75f32+0.5f32+3.0f32+2.0f32)*iv2*0.5f32;
    mx:=sc2;
    e0:=exp(sc0-mx);e1:=exp(sc1-mx);e2:=exp(sc2-mx);es:=e0+e1+e2;
    w0:=e0/es*iv0;w1:=e1/es*iv1;w2:=e2/es*iv2;
    ref:[4]f32;s1:f32=0.0f32;s2:f32=0.0f32;
    for i:0..<4 {
        ref[i]=w0*blks[i]+w1*blks[4+i]+w2*curv[i];
        s1+=ref[i]*ref[i];s2+=auxv[2+i]*auxv[2+i];
    }
    am_mix_fused(0,4,2,0.5f32,blks[..],curv[..],qry[..],2,auxv[..],2,mo0[..],1,mo1[..],1);
    for i:0..<4 {#assert abs(mo0[1+i]-ref[i])<0.0005f32;}
    am_mix_fused(1,4,2,0.5f32,blks[..],curv[..],qry[..],2,auxv[..],2,mo0[..],1,mo1[..],1);
    inv_m1:=1.0f32/sqrt(s1/4.0f32+0.5f32);
    for i:0..<4 {#assert abs(mo0[1+i]-ref[i]*inv_m1*auxv[2+i])<0.0005f32;}
    am_mix_fused(2,4,2,0.5f32,blks[..],curv[..],qry[..],2,auxv[..],2,mo0[..],1,mo1[..],1);
    inv_1:=1.0f32/sqrt(s1/4.0f32+0.000001f32);inv_2:=1.0f32/sqrt(s2/4.0f32+0.000001f32);
    for i:0..<4 {
        #assert abs(mo1[1+i]-ref[i]*inv_1)<0.0005f32;
        #assert abs(mo1[5+i]-auxv[2+i]*inv_2)<0.0005f32;
    }
    // Huge query with sc0 max (kills mx:=sc[0]->sc[1] and sc[s]-mx->sc[s]+mx) + zero block (kills +1e-6->-)
    zblks:[8]f32;hqry:[4]f32;zaux:[4]f32;
    zblks[0]=2.0f32;zblks[1]=0.0f32;zblks[2]=0.0f32;zblks[3]=0.0f32;
    for i:4..<8 {zblks[i]=0.0f32;}
    for i:0..<4 {zaux[i]=0.0f32;}
    hqry[0]=200.0f32;hqry[1]=0.0f32;hqry[2]=0.0f32;hqry[3]=0.0f32;
    am_mix_fused(2,4,2,0.000001f32,zblks[..],curv[..],hqry[..],0,zaux[..],0,mo0[..],0,mo1[..],0);
    #assert abs(mo0[0]-2.0f32)<0.01f32 && abs(mo1[0]-2.0f32)<0.01f32 && abs(mo1[4])<0.001f32;
    // All-zero states in mode=2 -> s1==0 (kills +0.000001 -> - in inv1)
    zall:[8]f32;zcur:[4]f32;
    am_mix_fused(2,4,2,0.000001f32,zall[..],zcur[..],hqry[..],0,zaux[..],0,mo0[..],0,mo1[..],0);
    #assert abs(mo1[0])<0.001f32 && abs(mo1[4])<0.001f32;
    // am_mix_batch_f32: exact match at q_idx=1, t_idx=1 + huge-query + zero-block
    mb_blks:[16]f32;mb_cur:[8]f32;mb_q:[8]f32;mb_out:[16]f32;
    for i:0..<16 {mb_blks[i]=0.0f32;mb_out[i]=-7.0f32;}
    for i:0..<8 {mb_cur[i]=0.0f32;mb_q[i]=0.0f32;}
    for i:0..<4 {mb_blks[4+i]=blks[i];mb_blks[12+i]=blks[4+i];mb_cur[4+i]=curv[i];mb_q[4+i]=qry[2+i];}
    am_mix_batch_f32(4,2,2,1,1,mb_blks[..],mb_cur[..],mb_q[..],mb_out[..]);
    for i:0..<4 {#assert abs(mb_out[12+i]-ref[i])<0.0005f32;}
    for i:0..<4 {mb_blks[4+i]=zblks[i];mb_blks[12+i]=0.0f32;mb_q[4+i]=hqry[i];}
    am_mix_batch_f32(4,2,2,1,1,mb_blks[..],mb_cur[..],mb_q[..],mb_out[..]);
    #assert abs(mb_out[12]-2.0f32)<0.01f32 && abs(mb_out[13])<0.001f32;
}
#test "conv_kv and decode attention primitives match exact math" {
    // am_conv_kv_both & am_conv_kv_chan: 4-slot circular ring, n_head_kv=2, items 0,1,2,3, has_dyn=0 & 1, clipped & unclipped, zero-tot
    kr:[256]f32;vr:[256]f32;kw:[1024]f32;vw:[1024]f32;dy:[16]f32;kh:[1024]f32;vh:[1024]f32;kc:[512]u16;vc:[512]u16;
    for c:0..<256 {
        kr[c]=0.5f32+f32(c%7)*0.25f32;vr[c]=1.0f32+f32(c%5)*0.2f32;
        kh[c*4+0]=0.9f32;kh[c*4+1]=0.1f32+f32(c%3)*0.1f32;kh[c*4+2]=0.2f32+f32(c%4)*0.1f32;kh[c*4+3]=0.3f32+f32(c%5)*0.1f32;
        vh[c*4+0]=0.8f32;vh[c*4+1]=0.2f32+f32(c%3)*0.1f32;vh[c*4+2]=0.4f32+f32(c%4)*0.1f32;vh[c*4+3]=0.6f32+f32(c%5)*0.1f32;
        kw[c*4+0]=0.1f32;kw[c*4+1]=0.2f32;kw[c*4+2]=0.3f32;kw[c*4+3]=0.4f32;
        vw[c*4+0]=0.15f32;vw[c*4+1]=0.25f32;vw[c*4+2]=0.35f32;vw[c*4+3]=0.45f32;
    }
    for i:0..<16 {dy[i]=ifx i%2==0 then 1.5f32+0.5f32*f32(i) else -(1.0f32+0.5f32*f32(i));}
    // Reference check for item=1 (K, h=1, pos=4 (sw=0, s0=1, s1=2, s2=3), slot_pos=1, has_dyn=0, unclipped)
    ktot:f32=0.0f32;ktmp:[128]f32;
    for j:0..<128 {
        c:=128+j;
        v:=(kr[c]+kh[c*4+1]*0.1f32+kh[c*4+2]*0.2f32+kh[c*4+3]*0.3f32+kr[c]*0.4f32)*0.4472135954999579f32;
        ktmp[j]=v;ktot+=v*v;
    }
    am_conv_kv_both(1,2,256,4,1,0,1000.0f32,0.5f32,kr[..],vr[..],kw[..],vw[..],dy[..],kh[..],vh[..],kc[..],vc[..]);
    #assert abs(kh[128*4+0]-kr[128])<0.001f32 && abs(kh[128*4+2]-0.2f32)<0.001f32 && abs(kh[128*4+3]-0.6f32)<0.001f32;
    #assert abs(am_f16(cast(u32)kc[256+128+0])-ktmp[0])<0.01f32 && abs(am_f16(cast(u32)kc[256+128+127])-ktmp[127])<0.01f32;
    // Reference check for item=1 again at pos=5 (sw=1, s0=2, s1=3, s2=0), has_dyn=1, clipped (threshold=1.5)
    ktot=0.0f32;
    for j:0..<128 {
        c:=128+j;
        acc:=kh[c*4+2]*0.1f32+kh[c*4+3]*0.2f32+kh[c*4+0]*0.3f32+kr[c]*0.4f32+dy[4]*kr[c]+dy[5]*kh[c*4+0]+dy[6]*kh[c*4+3]+dy[7]*kh[c*4+2];
        v:=(kr[c]+acc)*0.3333333333333333f32;
        ktmp[j]=v;ktot+=v*v;
    }
    kfac:=1.5f32/(sqrt(ktot)+0.000001f32);
    am_conv_kv_both(1,2,256,5,0,1,1.5f32,0.5f32,kr[..],vr[..],kw[..],vw[..],dy[..],kh[..],vh[..],kc[..],vc[..]);
    #assert abs(kh[128*4+1]-kr[128])<0.001f32;
    #assert abs(am_f16(cast(u32)kc[128+0])-ktmp[0]*kfac)<0.01f32 && abs(am_f16(cast(u32)kc[128+127])-ktmp[127]*kfac)<0.01f32;
    // Reference check for item=3 (V, h=1, pos=4, slot_pos=1, has_dyn=1, eps=0.5)
    vtot:f32=0.0f32;vtmp:[128]f32;
    for j:0..<128 {
        c:=128+j;
        acc:=vh[c*4+1]*0.15f32+vh[c*4+2]*0.25f32+vh[c*4+3]*0.35f32+vr[c]*0.45f32+dy[12]*vr[c]+dy[13]*vh[c*4+3]+dy[14]*vh[c*4+2]+dy[15]*vh[c*4+1];
        v:=(vr[c]+acc)*0.3333333333333333f32;
        vtmp[j]=v;vtot+=v*v;
    }
    vinv:=1.0f32/sqrt(vtot/128.0f32+0.5f32);
    am_conv_kv_both(3,2,256,4,1,1,1.5f32,0.5f32,kr[..],vr[..],kw[..],vw[..],dy[..],kh[..],vh[..],kc[..],vc[..]);
    #assert abs(am_f16(cast(u32)vc[256+128+0])-vtmp[0]*vinv)<0.01f32 && abs(am_f16(cast(u32)vc[256+128+127])-vtmp[127]*vinv)<0.01f32;
    // item=2 (V, h=0, kills item/n_head_kv -> *) + zero-tot K (kills +1e-6 -> -)
    zkr:[256]f32;zkh:[1024]f32;
    am_conv_kv_both(0,2,256,0,0,0,1.5f32,0.5f32,zkr[..],vr[..],kw[..],vw[..],dy[..],zkh[..],vh[..],kc[..],vc[..]);
    #assert kc[0]==0 && kc[127]==0;
    am_conv_kv_both(2,2,256,0,0,0,1.5f32,0.5f32,kr[..],vr[..],kw[..],vw[..],dy[..],kh[..],vh[..],kc[..],vc[..]);
    #assert am_f16(cast(u32)vc[0])>0.5f32;
    // am_attn_gqa_1pass: n_head=6, n_head_kv=2, head_dim=4, n_rel=2, extent=2, h=3 (kv_h=3/3=1 vs 3/4=0), non-periodic arrays!
    aq:[24]f32;aqs:[24]f32;ar:[12]f32;ars:[12]f32;arb:[4]f32;ask:[6]f32;agt:[24]f32;ao:[24]f32;akc:[32]u16;avc:[32]u16;
    for i:0..<24 {aq[i]=0.2f32+f32(i)*0.07f32;aqs[i]=0.5f32+f32(i%5)*0.4f32;agt[i]=-1.2f32+f32(i)*0.11f32;ao[i]=-9.0f32;}
    for i:0..<12 {ar[i]=0.3f32+f32(i)*0.09f32;ars[i]=0.4f32+f32(i)*0.17f32;}
    ars[8]=4.0f32;ars[9]=1.0f32;
    arb[0]=0.2f32;arb[1]=0.5f32;arb[2]=-0.3f32;arb[3]=0.7f32;
    for i:0..<6 {ask[i]=0.1f32*f32(i+1);}
    for s:0..<4 {for h2:0..<2 {for j:0..<4 {
        akc[(s*2+h2)*4+j]=am_to_f16(0.25f32*f32(s+1)+0.125f32*f32(h2)+0.0625f32*f32(j));
        avc[(s*2+h2)*4+j]=am_to_f16(0.5f32*f32(s+1)-0.25f32*f32(h2)+0.125f32*f32(j));
    }}}
    d0:u32=6|(2<<8)|(4<<16)|(2<<24);
    // Non-SWA, h=3 (kv_h=1), pos=3, has_qs=1, has_rs=0 (separates bits 16 & 17!), unclipped q & r
    d1n:u32=2|(0<<16)|(2<<17);
    ki_qonly:u32=3|(1<<16);
    am_attn_gqa_1pass(3,d0,d1n,ki_qonly,3,100.0f32,100.0f32,0.75f32,aq[..],aqs[..],ar[..],ars[..],arb[..],ask[..],agt[..],akc[..],avc[..],ao[..]);
    rqc:[4]f32;rrc:[2]f32;racc:[4]f32;
    for j:0..<4 {rqc[j]=aq[12+j]*aqs[12+j]*0.75f32;racc[j]=0.0f32;}
    for j:0..<2 {rrc[j]=ar[6+j]*0.75f32;}
    rm:f32=0.0f32;rl:f32=1.0f32;
    for kp:0..<4 {
        kb:=kp*8+4;dt:f32=0.0f32;
        for j:0..<4 {dt+=rqc[j]*am_f16(cast(u32)akc[kb+j]);}
        dist:=3-kp;rb:f32=0.0f32;
        if dist<2 {rb=arb[dist*2]*rrc[0]+arb[dist*2+1]*rrc[1];}
        sc:=dt*0.5f32+rb-ask[3];
        nm:=ifx sc>rm then sc else rm;
        al:=exp(rm-nm);wt:=exp(sc-nm);rm=nm;rl=rl*al+wt;
        for j:0..<4 {racc[j]=racc[j]*al+wt*am_f16(cast(u32)avc[kb+j]);}
    }
    for j:0..<4 {#assert abs(ao[12+j]-(racc[j]/rl)/(1.0f32+exp(-agt[12+j])))<0.001f32;}
    // Non-SWA, h=4, pos=3, has_qs=1, has_rs=1, clipped q & r, q_tau=0.75
    kin:u32=3|(1<<16)|(1<<17);
    am_attn_gqa_1pass(4,d0,d1n,kin,3,0.5f32,0.4f32,0.75f32,aq[..],aqs[..],ar[..],ars[..],arb[..],ask[..],agt[..],akc[..],avc[..],ao[..]);
    rqn:f32=0.0f32;rrn:f32=0.0f32;
    for j:0..<4 {v:=aq[16+j]*aqs[16+j];rqc[j]=v;rqn+=v*v;}
    rqf:=0.5f32/(sqrt(rqn)+0.000001f32)*0.75f32;
    for j:0..<4 {rqc[j]=rqc[j]*rqf;racc[j]=0.0f32;}
    for j:0..<2 {v:=ar[8+j]*ars[8+j];rrc[j]=v;rrn+=v*v;}
    rrf:=0.4f32/(sqrt(rrn)+0.000001f32)*0.75f32;
    for j:0..<2 {rrc[j]=rrc[j]*rrf;}
    rm=0.0f32;rl=1.0f32;
    for kp:0..<4 {
        kb:=kp*8+4;dt:f32=0.0f32;
        for j:0..<4 {dt+=rqc[j]*am_f16(cast(u32)akc[kb+j]);}
        dist:=3-kp;rb:f32=0.0f32;
        if dist<2 {rb=arb[dist*2]*rrc[0]+arb[dist*2+1]*rrc[1];}
        sc:=dt*0.5f32+rb-ask[4];
        nm:=ifx sc>rm then sc else rm;
        al:=exp(rm-nm);wt:=exp(sc-nm);rm=nm;rl=rl*al+wt;
        for j:0..<4 {racc[j]=racc[j]*al+wt*am_f16(cast(u32)avc[kb+j]);}
    }
    for j:0..<4 {#assert abs(ao[16+j]-(racc[j]/rl)/(1.0f32+exp(-agt[16+j])))<0.001f32;}
    // SWA, is_swa=1, swa=2, pos=3, kv_cap=3 (wraps kp=3->slot=0), has_qs=0, has_rs=0, unclipped, q_tau=1.25
    d1s:u32=2|(1<<16)|(2<<17);
    am_attn_gqa_1pass(4,d0,d1s,3,3,100.0f32,100.0f32,1.25f32,aq[..],aqs[..],ar[..],ars[..],arb[..],ask[..],agt[..],akc[..],avc[..],ao[..]);
    for j:0..<4 {rqc[j]=aq[16+j]*1.25f32;racc[j]=0.0f32;}
    for j:0..<2 {rrc[j]=ar[8+j]*1.25f32;}
    rm=0.0f32;rl=1.0f32;
    for kp:2..<4 {
        kb:=(kp%3)*8+4;dt:f32=0.0f32;
        for j:0..<4 {dt+=rqc[j]*am_f16(cast(u32)akc[kb+j]);}
        dist:=3-kp;rb:=arb[dist*2]*rrc[0]+arb[dist*2+1]*rrc[1];
        sc:=dt*0.5f32+rb-ask[4];
        nm:=ifx sc>rm then sc else rm;
        al:=exp(rm-nm);wt:=exp(sc-nm);rm=nm;rl=rl*al+wt;
        for j:0..<4 {racc[j]=racc[j]*al+wt*am_f16(cast(u32)avc[kb+j]);}
    }
    for j:0..<4 {#assert abs(ao[16+j]-(racc[j]/rl)/(1.0f32+exp(-agt[16+j])))<0.001f32;}
    // SWA boundary pos==swa vs pos<swa + tiny q/r < 1e-6 (kills +0.000001 -> - in qf and rf!)
    am_attn_gqa_1pass(4,d0,d1s,3,2,100.0f32,100.0f32,1.0f32,aq[..],aqs[..],ar[..],ars[..],arb[..],ask[..],agt[..],akc[..],avc[..],ao[..]);
    o_pos2:=ao[16];
    d1s3:u32=2|(1<<16)|(3<<17);
    am_attn_gqa_1pass(4,d0,d1s3,3,2,100.0f32,100.0f32,1.0f32,aq[..],aqs[..],ar[..],ars[..],arb[..],ask[..],agt[..],akc[..],avc[..],ao[..]);
    #assert abs(o_pos2-ao[16])>0.01f32;
    taq:[24]f32;tar:[12]f32;
    taq[16]=0.0000005f32;tar[8]=0.0000005f32;
    // With qk_clip=1e-6, q_tau=2e6: +1e-6 gives qf*q = +0.6667 (dot>0, ao>o_zero), -1e-6 gives qf*q = -2.0 (dot<0, ao<o_zero)!
    am_attn_gqa_1pass(4,d0,d1n,3,0,0.000001f32,100.0f32,2000000.0f32,taq[..],aqs[..],tar[..],ars[..],arb[..],ask[..],agt[..],akc[..],avc[..],ao[..]);
    o_tiny_q:=ao[16];
    taq[16]=0.0f32;tar[8]=0.0f32;
    am_attn_gqa_1pass(4,d0,d1n,3,0,100.0f32,100.0f32,1.0f32,taq[..],aqs[..],tar[..],ars[..],arb[..],ask[..],agt[..],akc[..],avc[..],ao[..]);
    o_zero_q:=ao[16];
    #assert o_tiny_q>o_zero_q+0.01f32;
    tar[8]=0.0000005f32;
    am_attn_gqa_1pass(4,d0,d1n,3,0,100.0f32,0.000001f32,2000000.0f32,taq[..],aqs[..],tar[..],ars[..],arb[..],ask[..],agt[..],akc[..],avc[..],ao[..]);
    #assert ao[16]>o_zero_q+0.005f32;
    // am_kv_attn_gqa_1pass: 1 Q head per item (h=3,4,5 -> kv_h=1; h%3==0 writes KV/hist, h%3!=0 does not), has_dyn=0 and 1
    fq:[768]f32;fqs:[768]f32;fgt:[768]f32;fo1:[768]f32;fo2:[768]f32;
    kh2:[1024]f32;vh2:[1024]f32;kc2:[512]u16;vc2:[512]u16;
    for i:0..<768 {fq[i]=0.1f32+f32(i%7)*0.05f32;fqs[i]=1.0f32;fgt[i]=0.2f32;}
    for i:0..<1024 {kh2[i]=kh[i];vh2[i]=vh[i];}
    for i:0..<512 {kc2[i]=kc[i];vc2[i]=vc[i];}
    fd0:u32=6|(2<<8)|(128<<16)|(2<<24);
    fd1:u32=2|(0<<16)|(2<<17);
    fki0:u32=2|(1<<16)|(1<<17);
    am_conv_kv_both(1,2,256,1,1,0,10.0f32,0.5f32,kr[..],vr[..],kw[..],vw[..],dy[..],kh2[..],vh2[..],kc2[..],vc2[..]);
    am_conv_kv_both(3,2,256,1,1,0,10.0f32,0.5f32,kr[..],vr[..],kw[..],vw[..],dy[..],kh2[..],vh2[..],kc2[..],vc2[..]);
    for g:0..<3 {am_attn_gqa_1pass(3+g,fd0,fd1,fki0,1,10.0f32,10.0f32,1.0f32,fq[..],fqs[..],ar[..],ars[..],arb[..],ask[..],fgt[..],kc2[..],vc2[..],fo1[..]);}
    for g:0..<3 {am_kv_attn_gqa_1pass(3+g,fd0,fd1,fki0,1,1,10.0f32,10.0f32,1.0f32,0.5f32,kr[..],vr[..],kw[..],vw[..],dy[..],kh[..],vh[..],fq[..],fqs[..],ar[..],ars[..],arb[..],ask[..],fgt[..],kc[..],vc[..],fo2[..]);}
    #assert abs(fo2[3*128]-fo1[3*128])<0.0005f32 && abs(fo2[4*128]-fo1[4*128])<0.0005f32 && abs(fo2[5*128]-fo1[5*128])<0.0005f32;
    // Verify h=4 (h%3!=0) does NOT overwrite kh[128*4+1] when called with modified kr[128]
    kr_save:=kr[128];kr[128]=-9.0f32;
    am_kv_attn_gqa_1pass(4,fd0,fd1,fki0,1,1,10.0f32,10.0f32,1.0f32,0.5f32,kr[..],vr[..],kw[..],vw[..],dy[..],kh[..],vh[..],fq[..],fqs[..],ar[..],ars[..],arb[..],ask[..],fgt[..],kc[..],vc[..],fo2[..]);
    #assert abs(kh[128*4+1]-kr_save)<0.001f32;
    kr[128]=kr_save;
    fki1:u32=fki0|(1<<18);
    am_conv_kv_both(1,2,256,1,1,1,10.0f32,0.5f32,kr[..],vr[..],kw[..],vw[..],dy[..],kh2[..],vh2[..],kc2[..],vc2[..]);
    am_conv_kv_both(3,2,256,1,1,1,10.0f32,0.5f32,kr[..],vr[..],kw[..],vw[..],dy[..],kh2[..],vh2[..],kc2[..],vc2[..]);
    for g:0..<3 {am_attn_gqa_1pass(3+g,fd0,fd1,fki1,1,10.0f32,10.0f32,1.0f32,fq[..],fqs[..],ar[..],ars[..],arb[..],ask[..],fgt[..],kc2[..],vc2[..],fo1[..]);}
    for g:0..<3 {am_kv_attn_gqa_1pass(3+g,fd0,fd1,fki1,1,1,10.0f32,10.0f32,1.0f32,0.5f32,kr[..],vr[..],kw[..],vw[..],dy[..],kh[..],vh[..],fq[..],fqs[..],ar[..],ars[..],arb[..],ask[..],fgt[..],kc[..],vc[..],fo2[..]);}
    #assert abs(fo2[3*128]-fo1[3*128])<0.0005f32 && abs(fo2[4*128]-fo1[4*128])<0.0005f32 && abs(fo2[5*128]-fo1[5*128])<0.0005f32;
    #assert abs(fo2[3*128]-fo2[5*128])>0.001f32;
}
#test "prefill Metal 4 attention scores and values match exact math" {
    // am_attn_scores_m4: n_head=4, n_head_kv=2, head_dim=4, n_rel=2, extent=2, n_tok=65 (qt=2), kv_cap=16, score_stride=130
    psq:[1040]f32;psr:[520]f32;psrb:[4]f32;pssk:[260]f32;psk:[512]u16;pssc:[33800]u16;
    for t:0..<65 {for h:0..<4 {
        pssk[t*4+h]=0.1f32*f32(h+1)+0.01f32*f32(t%5);
        for d:0..<4 {psq[(t*4+h)*4+d]=0.25f32*f32(d+1)+0.125f32*f32(h)+0.0625f32*f32(t%4);}
        for m:0..<2 {psr[(t*4+h)*2+m]=0.25f32*f32(m+1)+0.125f32*f32(h)+0.0625f32*f32(t%7);}
    }}
    psrb[0]=0.25f32;psrb[1]=0.5f32;psrb[2]=-0.25f32;psrb[3]=0.75f32;
    for s:0..<64 {for kh:0..<2 {for d:0..<4 {
        psk[(s*2+kh)*4+d]=am_to_f16(0.125f32*f32(s%7+1)+0.25f32*f32(kh)+0.0625f32*f32(d));
    }}}
    for i:0..<33800 {pssc[i]=0x7bff;}
    pd0:u32=4|(2<<8)|(4<<16)|(2<<24);
    // SWA: swa=32, pos0=64, k_start=0 -> t0=0: lo_off=33, j_lo_tile=1, last_t=63, j_hi_tile=3, n_valid=3, step_k=1
    pd1s:u32=2|(1<<16)|(32<<17);
    pki:u32=16|(130<<16);
    // k_split=0 FIRST -> kt=1 (j=32..63); verify j=32 excluded, j=33 written, j=64 untouched (32 vs 33) AND t=64 untouched (64 vs 65)!
    am_attn_scores_m4((2*2+0)*4+0,pd0,pd1s,pki,64,65,0,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    #assert pssc[(2*65+0)*130+32]==0x7bff && pssc[(2*65+0)*130+33]!=0x7bff && pssc[(2*65+0)*130+64]==0x7bff;
    #assert pssc[(2*65+64)*130+33]==0x7bff;
    // h=2 (kv_h=1), q_tile=0 (t0=0), k_split=1 -> kt=2 (j=64..95). Verify t=0 (dist=0), t=1 (dist=1, kills r[t*n_head+h] * -> +), t=2 (dist=2) & j=96 sentinel!
    am_attn_scores_m4((2*2+0)*4+1,pd0,pd1s,pki,64,65,0,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    dot0:f32=0.0f32;for d:0..<4 {dot0+=psq[(0*4+2)*4+d]*am_f16(cast(u32)psk[(0*2+1)*4+d]);}
    rb0:=psrb[0]*psr[(0*4+2)*2+0]+psrb[1]*psr[(0*4+2)*2+1];
    #assert abs(am_f16(cast(u32)pssc[(2*65+0)*130+64])-(dot0*0.5f32+rb0-pssk[2]))<0.01f32;
    #assert pssc[(2*65+0)*130+65]==0x7bff && pssc[(2*65+63)*130+96]==0x7bff && pssc[(2*65+64)*130+64]==0x7bff;
    dot1:f32=0.0f32;for d:0..<4 {dot1+=psq[(1*4+2)*4+d]*am_f16(cast(u32)psk[(0*2+1)*4+d]);}
    rb1:=psrb[2]*psr[(1*4+2)*2+0]+psrb[3]*psr[(1*4+2)*2+1];
    #assert abs(am_f16(cast(u32)pssc[(2*65+1)*130+64])-(dot1*0.5f32+rb1-pssk[1*4+2]))<0.01f32;
    dot2:f32=0.0f32;for d:0..<4 {dot2+=psq[(2*4+2)*4+d]*am_f16(cast(u32)psk[(0*2+1)*4+d]);}
    #assert abs(am_f16(cast(u32)pssc[(2*65+2)*130+64])-(dot2*0.5f32-pssk[2*4+2]))<0.01f32;
    // k_split=3 -> kt_start=4 > j_hi_tile=3 -> writes nothing!
    am_attn_scores_m4((2*2+0)*4+3,pd0,pd1s,pki,64,65,0,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    #assert pssc[(2*65+63)*130+127]==0x7bff;
    // h=3, q_tile=1 (t0=64), k_split=1 -> kt=4 (j=128..159)
    am_attn_scores_m4((3*2+1)*4+1,pd0,pd1s,pki,64,65,0,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    dot64:f32=0.0f32;for d:0..<4 {dot64+=psq[(64*4+3)*4+d]*am_f16(cast(u32)psk[(0*2+1)*4+d]);}
    rb64:=psrb[0]*psr[(64*4+3)*2+0]+psrb[1]*psr[(64*4+3)*2+1];
    #assert abs(am_f16(cast(u32)pssc[(3*65+64)*130+128])-(dot64*0.5f32+rb64-pssk[64*4+3]))<0.01f32;
    #assert pssc[(3*65+63)*130+128]==0x7bff;
    // n_tok=64 (kills qt 63->64!), is_swa=0, pos0=64, k_start=1 -> j_hi_val=126 (j_hi_tile=3, n_valid=4, step_k=1) vs +k_start=128 (j_hi_tile=4, n_valid=5, step_k=2 -> overwrites j=32)!
    pd1n1:u32=2|(0<<16)|(1<<17);
    for i:0..<33800 {pssc[i]=0x7bff;}
    am_attn_scores_m4(4,pd0,pd1n1,pki,64,64,1,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    #assert pssc[(1*64+0)*130+0]!=0x7bff && pssc[(1*64+0)*130+32]==0x7bff;
    // Non-SWA n_tok=65, t0=0 (kills dt 64->65 since t=64, j=0 satisfies kp<=p!)
    for i:0..<33800 {pssc[i]=0x7bff;}
    am_attn_scores_m4(0,pd0,pd1n1,pki,0,65,0,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    #assert pssc[(0*65+63)*130+0]!=0x7bff && pssc[(0*65+64)*130+0]==0x7bff;
    // SWA with non-zero k_start=32, pos0=64, swa=32 -> lo_off=1 (j_lo_tile=0 -> writes j=1..31) vs +k_start=65 (j_lo_tile=2 -> skips j=1!)
    for i:0..<260 {pssc[i]=0x7bff;}
    am_attn_scores_m4(0,pd0,pd1s,pki,64,1,32,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    #assert pssc[1]!=0x7bff && pssc[0]==0x7bff;
    // Exact boundary tests for lo_off==32 vs lo_off==31 (kills >= -> >, 1 -> 2, 0 -> 1 in lo_off/j_lo_tile):
    // pos0=63, swa=32, k_start=0 -> lo_off=32 -> j_lo_tile=1; pos0=62 -> lo_off=31 -> j_lo_tile=0 (k_split=0 writes j=31!)
    for i:0..<260 {pssc[i]=0x7bff;}
    am_attn_scores_m4(0,pd0,pd1s,pki,63,1,0,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    #assert pssc[32]!=0x7bff;
    for i:0..<260 {pssc[i]=0x7bff;}
    am_attn_scores_m4(0,pd0,pd1s,pki,62,1,0,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    #assert pssc[31]!=0x7bff;
    // Exact boundary tests for j_hi_val==0 (pos0=5, n_tok=1, k_start=5 -> writes j=0, kills >= -> > and 0 -> 1)
    // and j_hi_val = 31-1=30 vs 31+1=32 (pos0=31, n_tok=1, k_start=1, k_split=1 -> kt=1 skipped unless - became +!)
    for i:0..<260 {pssc[i]=0x7bff;}
    am_attn_scores_m4(0,pd0,pd1n1,pki,5,1,5,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    #assert pssc[0]!=0x7bff;
    for i:0..<260 {pssc[i]=0x7bff;}
    am_attn_scores_m4(1,pd0,pd1n1,pki,31,1,1,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    #assert pssc[30]==0x7bff && pssc[0]==0x7bff;
    // j_hi_val < 0 (pos0=1, n_tok=2, k_start=5) -> writes nothing
    am_attn_scores_m4(0,pd0,pd1n1,pki,1,2,5,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    #assert pssc[0]==0x7bff;
    // Non-SWA exact value check at pos0=2, n_tok=2, k_start=1
    am_attn_scores_m4(0,pd0,pd1n1,pki,2,2,1,psq[..],psr[..],psrb[..],pssk[..],psk[..],pssc[..]);
    dotn:f32=0.0f32;for d:0..<4 {dotn+=psq[d]*am_f16(cast(u32)psk[(1*2+0)*4+d]);}
    rbn:=psrb[2]*psr[0]+psrb[3]*psr[1];
    #assert abs(am_f16(cast(u32)pssc[0])-(dotn*0.5f32+rbn-pssk[0]))<0.01f32;
    // am_attn_values_m4: n_head=4, n_head_kv=2, head_dim=65, n_tok=65 (qt=2, per=4), non-periodic vig!
    vsc:[2080]u16;vig:[260]f32;vvc:[520]u16;vgt:[16900]f32;vout:[16900]f32;
    for i:0..<2080 {vsc[i]=am_to_f16(0.25f32*f32(i%5+1));}
    for i:0..<260 {vig[i]=0.25f32+0.005f32*f32(i);}
    for s:0..<4 {for kh:0..<2 {for c:0..<65 {vvc[(s*2+kh)*65+c]=am_to_f16(0.25f32*f32(s+1)+0.125f32*f32(kh)+0.015625f32*f32(c));}}}
    for i:0..<16900 {vgt[i]=-0.5f32+0.25f32*f32(i%5);vout[i]=-99.0f32;}
    vd0:u32=4|(2<<8)|(65<<16)|(2<<24);
    vki:u32=4|(8<<16);
    vd1s:u32=2|(1<<16)|(2<<17);
    // item = h*4 + rem: h=2, rem=3 (t0=64, c0=64) -> item=11
    am_attn_values_m4(11,vd0,vd1s,vki,0,65,62,vsc[..],vig[..],vvc[..],vgt[..],vout[..]);
    vacc:f32=0.0f32;
    for j:1..<3 {
        slot:=(62+j)%4;
        vacc+=am_f16(cast(u32)vsc[(2*65+64)*8+j])*am_f16(cast(u32)vvc[(slot*2+1)*65+64]);
    }
    vidx:=(64*4+2)*65+64;
    #assert abs(vout[vidx]-vacc*vig[64*4+2]/(1.0f32+exp(-vgt[vidx])))<0.005f32;
    #assert abs(vout[(64*4+2)*65+63]+99.0f32)<0.001f32 && abs(vout[(63*4+2)*65+64]+99.0f32)<0.001f32;
    // item = 2*4 + 2 = 10 -> rem=2 (t0=64, c0=0): kills rem/2 (2->3) AND rem%2 (%->/)!
    am_attn_values_m4(10,vd0,vd1s,vki,0,65,62,vsc[..],vig[..],vvc[..],vgt[..],vout[..]);
    vacc_r2:f32=0.0f32;
    for j:1..<3 {
        slot:=(62+j)%4;
        vacc_r2+=am_f16(cast(u32)vsc[(2*65+64)*8+j])*am_f16(cast(u32)vvc[(slot*2+1)*65+0]);
    }
    vidx_r2:=(64*4+2)*65+0;
    #assert abs(vout[vidx_r2]-vacc_r2*vig[64*4+2]/(1.0f32+exp(-vgt[vidx_r2])))<0.005f32;
    // item = 3*4 + 0 = 12 (t0=0, c0=0, j_lo clamped <0 -> 0)
    am_attn_values_m4(12,vd0,vd1s,vki,2,65,63,vsc[..],vig[..],vvc[..],vgt[..],vout[..]);
    vacc0:f32=0.0f32;
    for j:0..<3 {
        slot:=(63+j)%4;
        vacc0+=am_f16(cast(u32)vsc[(3*65+0)*8+j])*am_f16(cast(u32)vvc[(slot*2+1)*65+0]);
    }
    vidx0:=(0*4+3)*65+0;
    #assert abs(vout[vidx0]-vacc0*vig[3]/(1.0f32+exp(-vgt[vidx0])))<0.005f32;
    #assert abs(vout[(0*4+3)*65+64]+99.0f32)<0.001f32 && abs(vout[(64*4+3)*65+0]+99.0f32)<0.001f32;
    // n_tok=64 (kills qt=(n_tok+63)/64 63->64!): item=2 -> h=1, t0=0, c0=0 (if qt=2, item=2 would be h=0, t0=64!)
    for i:0..<16900 {vout[i]=-99.0f32;}
    am_attn_values_m4(2,vd0,vd1s,vki,2,64,63,vsc[..],vig[..],vvc[..],vgt[..],vout[..]);
    #assert abs(vout[(0*4+1)*65+0]+99.0f32)>1.0f32;
    // Non-SWA (is_swa=0) with swa=1, pos0=2, k_start=0 (kills is_swa &->| AND &&->||!)
    vd1n1:u32=2|(0<<16)|(1<<17);
    am_attn_values_m4(4,vd0,vd1n1,vki,2,2,0,vsc[..],vig[..],vvc[..],vgt[..],vout[..]);
    vaccn:f32=0.0f32;
    for j:0..<4 {vaccn+=am_f16(cast(u32)vsc[(2*2+0)*8+j])*am_f16(cast(u32)vvc[(j*2+1)*65+0]);}
    #assert abs(vout[2*65]-vaccn*vig[2]/(1.0f32+exp(-vgt[2*65])))<0.005f32;
    // SWA pos0==swa (pos0=2, swa=2, k_start=0 -> j_lo=1, j_hi=4) vs pos0<swa (pos0=1, swa=2 -> j_lo=0)
    am_attn_values_m4(4,vd0,vd1s,vki,2,2,0,vsc[..],vig[..],vvc[..],vgt[..],vout[..]);
    vaccs:f32=0.0f32;
    for j:1..<4 {vaccs+=am_f16(cast(u32)vsc[(2*2+0)*8+j])*am_f16(cast(u32)vvc[((j%4)*2+1)*65+0]);}
    #assert abs(vout[2*65]-vaccs*vig[2]/(1.0f32+exp(-vgt[2*65])))<0.005f32;
    am_attn_values_m4(4,vd0,vd1s,vki,1,2,0,vsc[..],vig[..],vvc[..],vgt[..],vout[..]);
    vaccs1:f32=0.0f32;
    for j:0..<3 {vaccs1+=am_f16(cast(u32)vsc[(2*2+0)*8+j])*am_f16(cast(u32)vvc[((j%4)*2+1)*65+0]);}
    #assert abs(vout[2*65]-vaccs1*vig[2]/(1.0f32+exp(-vgt[2*65])))<0.005f32;
}
#test "Sprint 71 tiny-batch speculative verify primitives match exact single-step math" {
    // 1. am_dot_q4s_2_write_nb: nb=2, cap=0 and cap>0, non-zero x_off & out_off
    qs:[160]u32;ds:[40]u16;x2:[96]f32;o2:[20]f32;
    for b:0..<40 {
        ds[b]=ifx b%2==0 then 0x3c00 else 0x3800;
        for k:0..<4 {qs[b*4+k]=cast(u32)(0x9a8b7654+b*13+k*7);}
    }
    for i:0..<96 {x2[i]=0.05f32*f32((i%19)-9)+0.01f32*f32(i/19);}
    for i:0..<20 {o2[i]=-99.0f32;}
    am_dot_q4s_2_write_nb(qs[..],ds[..],1,2,x2[..],4,32,1,2,0.0f32,o2[..],2,5,1,3);
    e00:=am_dot_q4s_lane(qs[..],ds[..],1,x2[..],4,1);
    e01:=am_dot_q4s_lane(qs[..],ds[..],2,x2[..],4,1);
    e10:=am_dot_q4s_lane(qs[..],ds[..],1,x2[..],36,1);
    e11:=am_dot_q4s_lane(qs[..],ds[..],2,x2[..],36,1);
    #assert abs(o2[3]-e00)<0.001f32 && abs(o2[5]-e01)<0.001f32 && abs(o2[8]-e10)<0.001f32 && abs(o2[10]-e11)<0.001f32 && abs(o2[2]+99.0f32)<0.001f32;
    am_dot_q4s_2_write_nb(qs[..],ds[..],1,2,x2[..],4,32,1,2,2.0f32,o2[..],2,5,1,3);
    #assert abs(o2[3]-2.0f32*am_tanh(e00/2.0f32))<0.001f32 && abs(o2[10]-2.0f32*am_tanh(e11/2.0f32))<0.001f32;

    // 2. am_dot_q4s_qrgkv_sdyn_nb: n_q=2,n_r=2,n_kv=2,n_sinks=2,n_dyn=3 (tot=18), nb=2 & nb=3, n_parts=0, 1, 2!
    xq:[96]f32;xk:[96]f32;xv:[96]f32;qparts:[24]f32;
    for i:0..<96 {xq[i]=0.1f32*f32((i%7)+1);xk[i]=-0.08f32*f32((i%5)+1);xv[i]=0.12f32*f32((i%6)+2);}
    for i:0..<24 {qparts[i]=10.0f32+f32(i)*7.0f32;}
    oq:[6]f32;or_:[6]f32;og:[6]f32;ok:[6]f32;ov:[6]f32;osk:[6]f32;ody:[20]f32;
    for i:0..<6 {oq[i]=-99.0f32;og[i]=-99.0f32;ov[i]=-99.0f32;}
    for i:0..<20 {ody[i]=-99.0f32;}
    qd0:u32=2|(2<<16);qd1:u32=2|(2<<16);qd2:u32=3;
    am_dot_q4s_qrgkv_sdyn_nb(0,qd0,qd1,qd2,32,2,0.5f32,qs[..],ds[..],xq[..],xk[..],xv[..],qparts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    #assert abs(og[0]+99.0f32)<0.001f32 && abs(ov[0]+99.0f32)<0.001f32 && abs(oq[0]-am_dot_q4s_lane(qs[..],ds[..],0,xq[..],0,1))<0.001f32;
    am_dot_q4s_qrgkv_sdyn_nb(4,qd0,qd1,qd2,32,2,0.5f32,qs[..],ds[..],xq[..],xk[..],xv[..],qparts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    am_dot_q4s_qrgkv_sdyn_nb(8,qd0,qd1,qd2,32,2,0.5f32,qs[..],ds[..],xq[..],xk[..],xv[..],qparts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    am_dot_q4s_qrgkv_sdyn_nb(12,qd0,qd1,qd2,32,2,0.5f32,qs[..],ds[..],xq[..],xk[..],xv[..],qparts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    am_dot_q4s_qrgkv_sdyn_nb(16,qd0,qd1,qd2,32,2,0.5f32,qs[..],ds[..],xq[..],xk[..],xv[..],qparts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    #assert abs(oq[2]-am_dot_q4s_lane(qs[..],ds[..],0,xq[..],32,1))<0.001f32;
    #assert abs(or_[3]-am_dot_q4s_lane(qs[..],ds[..],3,xq[..],32,1))<0.001f32;
    #assert abs(og[2]-am_dot_q4s_lane(qs[..],ds[..],4,xq[..],32,1))<0.001f32;
    #assert abs(ok[3]-am_dot_q4s_lane(qs[..],ds[..],7,xk[..],32,1))<0.001f32;
    #assert abs(ov[2]-am_dot_q4s_lane(qs[..],ds[..],8,xv[..],32,1))<0.001f32;
    #assert abs(osk[3]-am_dot_q4s_lane(qs[..],ds[..],11,xq[..],32,1))<0.001f32;
    #assert abs(ody[0]-am_dot_q4s_lane(qs[..],ds[..],12,xk[..],0,1))<0.001f32;
    #assert abs(ody[3]-am_dot_q4s_lane(qs[..],ds[..],15,xv[..],0,1))<0.001f32;
    #assert abs(ody[6]-am_dot_q4s_lane(qs[..],ds[..],12,xk[..],32,1))<0.001f32;
    #assert abs(ody[9]-am_dot_q4s_lane(qs[..],ds[..],15,xv[..],32,1))<0.001f32;
    #assert abs(ody[11]-am_dot_q4s_lane(qs[..],ds[..],17,xv[..],32,1))<0.001f32 && abs(ody[12]+99.0f32)<0.001f32;
    // With deferred rms_parts: n_parts=1 (nb=3 kills 2*nb -> 2+nb AND n_parts>0 0->1!) and n_parts=2!
    qd2p1:u32=3|(1<<16);
    am_dot_q4s_qrgkv_sdyn_nb(8,qd0,qd1,qd2p1,32,3,0.5f32,qs[..],ds[..],xq[..],xk[..],xv[..],qparts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);
    iv_p1:=1.0f32/sqrt(qparts[7]/32.0f32+0.5f32);
    #assert abs(ov[2]-am_dot_q4s_lane(qs[..],ds[..],8,xv[..],32,1)*iv_p1)<0.001f32;
    qd2p:u32=3|(2<<16);
    for rb:0..<5 {am_dot_q4s_qrgkv_sdyn_nb(rb*4,qd0,qd1,qd2p,32,2,0.5f32,qs[..],ds[..],xq[..],xk[..],xv[..],qparts[..],oq[..],or_[..],og[..],ok[..],ov[..],osk[..],ody[..]);}
    iq1:=1.0f32/sqrt((qparts[2]+qparts[3])/32.0f32+0.5f32);
    ik1:=1.0f32/sqrt((qparts[6]+qparts[7])/32.0f32+0.5f32);
    iv1:=1.0f32/sqrt((qparts[10]+qparts[11])/32.0f32+0.5f32);
    #assert abs(oq[2]-am_dot_q4s_lane(qs[..],ds[..],0,xq[..],32,1)*iq1)<0.001f32;
    #assert abs(or_[3]-am_dot_q4s_lane(qs[..],ds[..],3,xq[..],32,1)*iq1)<0.001f32;
    #assert abs(og[2]-am_dot_q4s_lane(qs[..],ds[..],4,xq[..],32,1)*iq1)<0.001f32;
    #assert abs(ok[3]-am_dot_q4s_lane(qs[..],ds[..],7,xk[..],32,1)*ik1)<0.001f32;
    #assert abs(ov[2]-am_dot_q4s_lane(qs[..],ds[..],8,xv[..],32,1)*iv1)<0.001f32;
    #assert abs(osk[3]-am_dot_q4s_lane(qs[..],ds[..],11,xq[..],32,1)*iq1)<0.001f32;
    #assert abs(ody[6]-am_dot_q4s_lane(qs[..],ds[..],12,xk[..],32,1)*ik1)<0.001f32;
    #assert abs(ody[11]-am_dot_q4s_lane(qs[..],ds[..],17,xv[..],32,1)*iv1)<0.001f32;

    // 3. am_dot_q4s_conv_nb: read-only hist, raw_log, add_res=0 and 1, r1!=r0 and r1==r0
    cw:[16]f32;ch:[12]f32;cr:[8]f32;cl:[8]f32;co:[8]f32;ch_ref:[12]f32;co_ref:[8]f32;
    for i:0..<16 {cw[i]=0.07f32*f32(i+1);}
    for i:0..<12 {ch[i]=0.2f32*f32(i+1);ch_ref[i]=ch[i];}
    for i:0..<8 {cr[i]=0.3f32*f32(i+1);cl[i]=-99.0f32;co[i]=-99.0f32;}
    am_dot_q4s_conv_nb(qs[..],ds[..],0,1,xq[..],1,4,2,1,cw[..],ch[..],cr[..],cl[..],co[..],1,2);
    #assert abs(ch[3]-ch_ref[3])<0.0001f32 && abs(ch[6]-ch_ref[6])<0.0001f32;
    for t:0..<2 {
        d0:=am_dot_q4s_lane(qs[..],ds[..],0,xq[..],t*32,1);
        d1:=am_dot_q4s_lane(qs[..],ds[..],1,xq[..],t*32,1);
        #assert abs(cl[t*4+1]-d0)<0.001f32 && abs(cl[t*4+2]-d1)<0.001f32;
        co_ref[t*4+1]=cr[t*4+1]+am_post_conv_step(d0,1,cw[..],ch_ref[..]);
        co_ref[t*4+2]=cr[t*4+2]+am_post_conv_step(d1,2,cw[..],ch_ref[..]);
        #assert abs(co[t*4+1]-co_ref[t*4+1])<0.001f32 && abs(co[t*4+2]-co_ref[t*4+2])<0.001f32;
    }
    am_dot_q4s_conv_nb(qs[..],ds[..],0,0,xq[..],1,4,2,0,cw[..],ch[..],cr[..],cl[..],co[..],0,0);
    #assert abs(co[0]-(am_dot_q4s_lane(qs[..],ds[..],0,xq[..],0,1)*(1.0f32+cw[3])+ch[0]*cw[0]+ch[1]*cw[1]+ch[2]*cw[2])*0.4472135954999579f32)<0.001f32;
    #assert abs(co[4]-(am_dot_q4s_lane(qs[..],ds[..],0,xq[..],32,1)*(1.0f32+cw[3])+ch[1]*cw[0]+ch[2]*cw[1]+cl[0]*cw[2])*0.4472135954999579f32)<0.001f32;

    // 4. am_moe_plan_nb + am_moe_gu/down (IQ4, Q4S & IQ4S): nb=2, n_exp=4, n_used=3 sharing expert 0!
    mlog:[8]f32;mbia:[4]f32;mids:[6]u32;mwts:[6]f32;ue:[8]u32;um:[8]u32;us:[64]u32;uc:[4]u32;
    mlog[0]=0.5f32;mlog[1]=1.5f32;mlog[2]=2.5f32;mlog[3]=-2.0f32;
    mlog[4]=2.0f32;mlog[5]=-1.0f32;mlog[6]=1.0f32;mlog[7]=3.0f32;
    mbia[0]=0.0f32;mbia[1]=0.1f32;mbia[2]=0.0f32;mbia[3]=0.0f32;
    for i:0..<8 {um[i]=99;ue[i]=99;}
    am_moe_plan_nb(4,3,2,5,1,1.0f32,mlog[..],mbia[..],mids[..],mwts[..],ue[..],um[..],us[..],uc[..]);
    // tok 0 picks [2, 1, 0]; tok 1 picks [3, 0, 2] -> ascending unique = [0(mask=3,s0=2,s1=1), 1(mask=1,s0=1), 2(mask=3,s0=0,s1=2), 3(mask=2,s1=0)], nu=4, gpe=5 -> uc[1]=20
    #assert uc[0]==4 && uc[1]==20 && uc[2]==1 && uc[3]==1 && ue[0]==0 && ue[1]==1 && ue[2]==2 && ue[3]==3 && um[0]==3 && um[1]==1 && um[2]==3 && um[3]==2;
    #assert us[0*8+0]==2 && us[0*8+1]==1 && us[1*8+0]==1 && us[2*8+0]==0 && us[2*8+1]==2 && us[3*8+1]==0;
    wiq:[648]u16; // 4 experts * 2*9 rows * 9 words = 648
    for i:0..<648 {wiq[i]=ifx i%9==0 then (ifx (i/9)%3==0 then 0x3c00 else (ifx (i/9)%3==1 then 0xbc00 else 0x3800)) else cast(u16)((i*257+19)&0xffff);}
    mqs:[288]u32;mds:[72]u16; // 4 experts * 2*9 rows * 1 block
    for b:0..<72 {
        mds[b]=wiq[b*9];
        for k:0..<4 {mqs[b*4+k]=cast(u32)wiq[b*9+1+2*k]|(cast(u32)wiq[b*9+2+2*k]<<16);}
    }
    // Verify am_dot_iq4s_lane matches am_dot_iq4_lane on multi-block & non-zero x_off!
    #assert abs(am_dot_iq4s_lane(mqs[..],mds[..],1,x2[..],32,2)-am_dot_iq4_lane(wiq[..],9,x2[..],32,2))<0.0001f32;
    // Verify B=1 am_moe_gu_iq4s_tg (n_parts=0, 1, 2; slot==0&&row0==8; cols=64 blocks=2!) and am_moe_down_iq4s_tg!
    xgus:[96]f32;
    for i:0..<96 {xgus[i]=0.004f32*f32((i%11)-3)+0.001f32*f32(i/11);}
    b1gu:[27]f32;b1ids:[3]u32;b1wts:[3]f32;
    for i:0..<27 {b1gu[i]=-99.0f32;}
    b1ids[0]=99;b1wts[0]=0.0f32;
    am_moe_gu_iq4s_tg(0,0,9,32,4,3,1,1.0f32,1.5f32,0.0f32,0,0.5f32,mqs[..],mds[..],xgus[..],qparts[..],mlog[..],mbia[..],b1ids[..],b1wts[..],b1gu[..]);
    #assert b1ids[0]==2 && b1ids[1]==1 && b1ids[2]==0 && abs(b1wts[0]+b1wts[1]+b1wts[2]-1.0f32)<0.001f32 && abs(b1gu[8]+99.0f32)<0.001f32;
    #assert abs(b1gu[0]-am_situ_act(am_dot_iq4s_lane(mqs[..],mds[..],2*18+0,xgus[..],0,1),am_dot_iq4s_lane(mqs[..],mds[..],2*18+9,xgus[..],0,1),1.5f32,0.0f32))<0.0005f32;
    // slot==0, row0==8 (kills && -> || and r<n_ff < -> <= since slot 1 element b1gu[9] must stay -99!) with n_parts=1!
    b1ids[0]=77;
    am_moe_gu_iq4s_tg(0,8,9,32,4,3,1,1.0f32,1.5f32,0.0f32,1,0.5f32,mqs[..],mds[..],xgus[..],qparts[..],mlog[..],mbia[..],b1ids[..],b1wts[..],b1gu[..]);
    b1inv1:=1.0f32/sqrt(qparts[0]/32.0f32+0.5f32);
    #assert b1ids[0]==77 && abs(b1gu[9]+99.0f32)<0.001f32 && abs(b1gu[8]-am_situ_act(am_dot_iq4s_lane(mqs[..],mds[..],2*18+8,xgus[..],0,1)*b1inv1,am_dot_iq4s_lane(mqs[..],mds[..],2*18+17,xgus[..],0,1)*b1inv1,1.5f32,0.0f32))<0.0005f32;
    // n_parts=2 and cols=64 (blocks=2, n_ff=4 -> 2*4*2=16 blocks/exp, 4 exps = 64 blocks <= 72! Kills cols/32, *->+, g*inv, u*inv!)
    b1g2:[12]f32;
    for i:0..<12 {b1g2[i]=-99.0f32;}
    am_moe_gu_iq4s_tg(1,0,4,64,4,3,1,1.0f32,1.5f32,0.0f32,2,4.0f32,mqs[..],mds[..],xgus[..],qparts[..],mlog[..],mbia[..],b1ids[..],b1wts[..],b1g2[..]);
    b1inv2:=1.0f32/sqrt((qparts[0]+qparts[1])/64.0f32+4.0f32);
    #assert abs(b1g2[4]-am_situ_act(am_dot_iq4s_lane(mqs[..],mds[..],1*16+0,xgus[..],0,2)*b1inv2,am_dot_iq4s_lane(mqs[..],mds[..],1*16+8,xgus[..],0,2)*b1inv2,1.5f32,0.0f32))<0.0005f32;

    mgu_iq:[54]f32;mgu_q4:[54]f32;mgu_is:[54]f32;
    for i:0..<54 {mgu_iq[i]=-99.0f32;mgu_q4[i]=-99.0f32;mgu_is[i]=-99.0f32;}
    // Verify u==uc[0] (4) early return leaves mgu untouched, and row0=0 leaves r=8 untouched!
    ue[4]=0;um[4]=3;us[4*8+0]=0;us[4*8+1]=0;
    am_moe_gu_iq4_nb(4,0,9,32,2,3,1.5f32,0.0f32,0,0.5f32,wiq[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_iq[..]);
    am_moe_gu_q4s_nb(4,0,9,32,2,3,1.5f32,0.0f32,0,0.5f32,mqs[..],mds[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_q4[..]);
    am_moe_gu_iq4s_nb(4,0,9,32,2,3,1.5f32,0.0f32,0,0.5f32,mqs[..],mds[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_is[..]);
    #assert abs(mgu_iq[0]+99.0f32)<0.001f32 && abs(mgu_q4[0]+99.0f32)<0.001f32 && abs(mgu_is[0]+99.0f32)<0.001f32;
    // Run u=1 (only t=0, sl=1 -> tok 1 sl=0..2 must remain -99!) and u=3 (only t=1, sl=0 -> tok 0 sl=0 must remain -99!) with n_parts=1!
    am_moe_gu_iq4_nb(1,0,9,32,2,3,1.5f32,0.0f32,1,4.0f32,wiq[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_iq[..]);
    am_moe_gu_q4s_nb(1,0,9,32,2,3,1.5f32,0.0f32,1,4.0f32,mqs[..],mds[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_q4[..]);
    am_moe_gu_iq4s_nb(1,0,9,32,2,3,1.5f32,0.0f32,1,4.0f32,mqs[..],mds[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_is[..]);
    ip1_0:=1.0f32/sqrt(qparts[0]/32.0f32+4.0f32);
    #assert abs(mgu_iq[9]-am_situ_act(am_dot_iq4_lane(wiq[..],1*18*9,xgus[..],0,1)*ip1_0,am_dot_iq4_lane(wiq[..],1*18*9+9*9,xgus[..],0,1)*ip1_0,1.5f32,0.0f32))<0.0005f32;
    #assert abs(mgu_q4[9]-am_situ_act(am_dot_q4s_lane(mqs[..],mds[..],1*18,xgus[..],0,1)*ip1_0,am_dot_q4s_lane(mqs[..],mds[..],1*18+9,xgus[..],0,1)*ip1_0,1.5f32,0.0f32))<0.0005f32;
    #assert abs(mgu_is[9]-mgu_iq[9])<0.0005f32;
    #assert abs(mgu_iq[9+8]+99.0f32)<0.001f32 && abs(mgu_q4[9+8]+99.0f32)<0.001f32 && abs(mgu_is[9+8]+99.0f32)<0.001f32;
    #assert abs(mgu_iq[27]+99.0f32)<0.001f32 && abs(mgu_q4[27]+99.0f32)<0.001f32 && abs(mgu_is[27]+99.0f32)<0.001f32;
    am_moe_gu_iq4_nb(3,0,9,32,2,3,1.5f32,0.0f32,0,0.5f32,wiq[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_iq[..]);
    am_moe_gu_q4s_nb(3,0,9,32,2,3,1.5f32,0.0f32,0,0.5f32,mqs[..],mds[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_q4[..]);
    am_moe_gu_iq4s_nb(3,0,9,32,2,3,1.5f32,0.0f32,0,0.5f32,mqs[..],mds[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_is[..]);
    #assert abs(mgu_iq[0]+99.0f32)<0.001f32 && abs(mgu_q4[0]+99.0f32)<0.001f32 && abs(mgu_is[0]+99.0f32)<0.001f32;
    for u:0..<4 {
        am_moe_gu_iq4_nb(u,0,9,32,2,3,1.5f32,0.0f32,0,0.5f32,wiq[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_iq[..]);
        am_moe_gu_iq4_nb(u,8,9,32,2,3,1.5f32,0.0f32,2,4.0f32,wiq[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_iq[..]);
        am_moe_gu_q4s_nb(u,0,9,32,2,3,1.5f32,0.0f32,0,0.5f32,mqs[..],mds[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_q4[..]);
        am_moe_gu_q4s_nb(u,8,9,32,2,3,1.5f32,0.0f32,2,4.0f32,mqs[..],mds[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_q4[..]);
        am_moe_gu_iq4s_nb(u,0,9,32,2,3,1.5f32,0.0f32,0,0.5f32,mqs[..],mds[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_is[..]);
        am_moe_gu_iq4s_nb(u,8,9,32,2,3,1.5f32,0.0f32,2,4.0f32,mqs[..],mds[..],xgus[..],qparts[..],ue[..],um[..],us[..],uc[..],mgu_is[..]);
    }
    // Check t=0, sl=1 (expert 1, r=0, n_parts=0) AND t=1, sl=0 (expert 3, r=8, n_parts=2 with eps=4.0!)
    iq1_4:=1.0f32/sqrt((qparts[2]+qparts[3])/32.0f32+4.0f32);
    g0_iq:=am_dot_iq4_lane(wiq[..],1*18*9+0*9,xgus[..],0,1);u0_iq:=am_dot_iq4_lane(wiq[..],1*18*9+9*9,xgus[..],0,1);
    #assert abs(mgu_iq[9]-am_situ_act(g0_iq,u0_iq,1.5f32,0.0f32))<0.0005f32 && abs(mgu_is[9]-mgu_iq[9])<0.0005f32;
    g1_iq:=am_dot_iq4_lane(wiq[..],3*18*9+8*9,xgus[..],32,1)*iq1_4;u1_iq:=am_dot_iq4_lane(wiq[..],3*18*9+17*9,xgus[..],32,1)*iq1_4;
    #assert abs(mgu_iq[27+8]-am_situ_act(g1_iq,u1_iq,1.5f32,0.0f32))<0.0005f32 && abs(mgu_is[27+8]-mgu_iq[27+8])<0.0005f32;
    g0_q4:=am_dot_q4s_lane(mqs[..],mds[..],1*18+0,xgus[..],0,1);u0_q4:=am_dot_q4s_lane(mqs[..],mds[..],1*18+9,xgus[..],0,1);
    #assert abs(mgu_q4[9]-am_situ_act(g0_q4,u0_q4,1.5f32,0.0f32))<0.0005f32;
    g1_q4:=am_dot_q4s_lane(mqs[..],mds[..],3*18+8,xgus[..],32,1)*iq1_4;u1_q4:=am_dot_q4s_lane(mqs[..],mds[..],3*18+17,xgus[..],32,1)*iq1_4;
    #assert abs(mgu_q4[27+8]-am_situ_act(g1_q4,u1_q4,1.5f32,0.0f32))<0.0005f32;
    // Down IQ4, Q4S & IQ4S nb (4 rows/TG, rows=9, cols=32, nb=2, n_used=3, non-periodic dcw!)
    dx:[192]f32;dcw:[36]f32;dh:[27]f32;dh_r1:[27]f32;dh_r2:[27]f32;dh_r3:[27]f32;dres:[18]f32;dl1:[18]f32;dl2:[18]f32;dl3:[18]f32;do1:[18]f32;do2:[18]f32;do3:[18]f32;
    for i:0..<192 {dx[i]=0.05f32*f32((i%13)+1);}
    for i:0..<36 {dcw[i]=0.03f32*f32(i+1);}
    for i:0..<27 {dh[i]=0.15f32*f32(i+1);dh_r1[i]=dh[i];dh_r2[i]=dh[i];dh_r3[i]=dh[i];}
    for i:0..<18 {dres[i]=0.3f32*f32(i+1);do1[i]=-99.0f32;do2[i]=-99.0f32;do3[i]=-99.0f32;}
    am_moe_down_iq4_nb(0,9,32,2,3,wiq[..],dx[..],ue[..],um[..],us[..],uc[..],mwts[..],dcw[..],dh[..],dres[..],dl1[..],do1[..]);
    am_moe_down_q4s_nb(0,9,32,2,3,mqs[..],mds[..],dx[..],ue[..],um[..],us[..],uc[..],mwts[..],dcw[..],dh[..],dres[..],dl2[..],do2[..]);
    am_moe_down_iq4s_nb(0,9,32,2,3,mqs[..],mds[..],dx[..],ue[..],um[..],us[..],uc[..],mwts[..],dcw[..],dh[..],dres[..],dl3[..],do3[..]);
    #assert abs(do1[4]+99.0f32)<0.001f32 && abs(do2[4]+99.0f32)<0.001f32 && abs(do3[4]+99.0f32)<0.001f32;
    am_moe_down_iq4_nb(4,9,32,2,3,wiq[..],dx[..],ue[..],um[..],us[..],uc[..],mwts[..],dcw[..],dh[..],dres[..],dl1[..],do1[..]);
    am_moe_down_q4s_nb(4,9,32,2,3,mqs[..],mds[..],dx[..],ue[..],um[..],us[..],uc[..],mwts[..],dcw[..],dh[..],dres[..],dl2[..],do2[..]);
    am_moe_down_iq4s_nb(4,9,32,2,3,mqs[..],mds[..],dx[..],ue[..],um[..],us[..],uc[..],mwts[..],dcw[..],dh[..],dres[..],dl3[..],do3[..]);
    #assert abs(do1[8]+99.0f32)<0.001f32 && abs(do2[8]+99.0f32)<0.001f32 && abs(do3[8]+99.0f32)<0.001f32;
    am_moe_down_iq4_nb(8,9,32,2,3,wiq[..],dx[..],ue[..],um[..],us[..],uc[..],mwts[..],dcw[..],dh[..],dres[..],dl1[..],do1[..]);
    am_moe_down_q4s_nb(8,9,32,2,3,mqs[..],mds[..],dx[..],ue[..],um[..],us[..],uc[..],mwts[..],dcw[..],dh[..],dres[..],dl2[..],do2[..]);
    am_moe_down_iq4s_nb(8,9,32,2,3,mqs[..],mds[..],dx[..],ue[..],um[..],us[..],uc[..],mwts[..],dcw[..],dh[..],dres[..],dl3[..],do3[..]);
    #assert abs(dh[0]-dh_r1[0])<0.0001f32 && abs(dh[24]-dh_r1[24])<0.0001f32;
    tmp_o1:[9]f32;tmp_o2:[9]f32;tmp_o3:[9]f32;
    for t:0..<2 {
        tmp_o3[8]=-99.0f32;
        am_moe_down_iq4_tg(0,9,32,3,wiq[..],dx[t*96..<(t+1)*96],mids[t*3..<(t+1)*3],mwts[t*3..<(t+1)*3],dcw[..],dh_r1[..],dres[t*9..<(t+1)*9],tmp_o1[..]);
        am_moe_down_iq4_tg(8,9,32,3,wiq[..],dx[t*96..<(t+1)*96],mids[t*3..<(t+1)*3],mwts[t*3..<(t+1)*3],dcw[..],dh_r1[..],dres[t*9..<(t+1)*9],tmp_o1[..]);
        am_moe_down_q4s_tg(0,9,32,3,mqs[..],mds[..],dx[t*96..<(t+1)*96],mids[t*3..<(t+1)*3],mwts[t*3..<(t+1)*3],dcw[..],dh_r2[..],dres[t*9..<(t+1)*9],tmp_o2[..]);
        am_moe_down_q4s_tg(8,9,32,3,mqs[..],mds[..],dx[t*96..<(t+1)*96],mids[t*3..<(t+1)*3],mwts[t*3..<(t+1)*3],dcw[..],dh_r2[..],dres[t*9..<(t+1)*9],tmp_o2[..]);
        am_moe_down_iq4s_tg(0,9,32,3,mqs[..],mds[..],dx[t*96..<(t+1)*96],mids[t*3..<(t+1)*3],mwts[t*3..<(t+1)*3],dcw[..],dh_r3[..],dres[t*9..<(t+1)*9],tmp_o3[..]);
        #assert abs(tmp_o3[8]+99.0f32)<0.001f32;
        am_moe_down_iq4s_tg(8,9,32,3,mqs[..],mds[..],dx[t*96..<(t+1)*96],mids[t*3..<(t+1)*3],mwts[t*3..<(t+1)*3],dcw[..],dh_r3[..],dres[t*9..<(t+1)*9],tmp_o3[..]);
        #assert abs(do1[t*9+1]-tmp_o1[1])<0.001f32 && abs(do1[t*9+8]-tmp_o1[8])<0.001f32;
        #assert abs(do2[t*9+1]-tmp_o2[1])<0.001f32 && abs(do2[t*9+8]-tmp_o2[8])<0.001f32;
        #assert abs(do3[t*9+1]-tmp_o3[1])<0.001f32 && abs(do3[t*9+8]-tmp_o3[8])<0.001f32 && abs(tmp_o3[8]-tmp_o1[8])<0.001f32;
        #assert abs(dl1[t*9+8]-dh_r1[8*3+2])<0.001f32 && abs(dl2[t*9+8]-dh_r2[8*3+2])<0.001f32 && abs(dl3[t*9+8]-dh_r3[8*3+2])<0.001f32;
    }

    // 5. am_kv_attn_gqa_1pass_nb: nb=2, qk_clip=0.5f32 (actively clips K!), non-periodic kw/vw/dy, is_swa=1 & 0
    kr:[512]f32;vr:[512]f32;kw:[1024]f32;vw:[1024]f32;dy:[32]f32;kh:[1024]f32;vh:[1024]f32;kh_r:[1024]f32;vh_r:[1024]f32;
    fq:[1536]f32;fqs:[768]f32;fr:[24]f32;frs:[12]f32;frb:[4]f32;fsk:[12]f32;fgt:[1536]f32;
    kc:[1024]u16;vc:[1024]u16;kc_r:[1024]u16;vc_r:[1024]u16;klog:[512]f32;vlog:[512]f32;fo:[1536]f32;fo_r:[1536]f32;tau:[2]f32;
    tau[0]=1.0f32;tau[1]=1.2f32;
    for i:0..<512 {kr[i]=ifx i%2==0 then 0.2f32*f32((i%11)+1) else -0.15f32*f32((i%7)+1);vr[i]=ifx i%3==0 then -0.18f32*f32((i%9)+1) else 0.14f32*f32((i%5)+1);klog[i]=-99.0f32;vlog[i]=-99.0f32;}
    for i:0..<1024 {kw[i]=ifx i%3==0 then 0.35f32 else (ifx i%3==1 then -0.25f32 else 0.15f32+0.02f32*f32(i%13));vw[i]=ifx i%2==0 then 0.25f32 else -0.3f32+0.02f32*f32(i%11);kh[i]=ifx i%5==0 then 0.4f32 else -0.2f32*f32((i%7)+1);vh[i]=ifx i%4==0 then -0.3f32 else 0.2f32*f32((i%9)+1);kh_r[i]=kh[i];vh_r[i]=vh[i];kc[i]=am_to_f16(0.1f32);vc[i]=am_to_f16(0.2f32);kc_r[i]=kc[i];vc_r[i]=vc[i];}
    for i:0..<32 {dy[i]=ifx i<16 then 0.25f32*f32((i%7)+1) else -0.45f32*f32((i%5)+2);}
    for i:0..<1536 {fq[i]=0.06f32*f32((i%13)+1);fgt[i]=0.3f32*f32((i%5)-2);fo[i]=-99.0f32;fo_r[i]=-99.0f32;}
    for i:0..<768 {fqs[i]=1.0f32;}
    for i:0..<24 {fr[i]=0.15f32*f32((i%7)+1);}
    for i:0..<12 {frs[i]=1.0f32;fsk[i]=0.1f32*f32((i%4)+1);}
    frb[0]=0.2f32;frb[1]=-0.1f32;frb[2]=0.3f32;frb[3]=0.05f32;
    ad0:u32=6|(2<<8)|(128<<16)|(2<<24);
    ad1_swa:u32=2|(1<<16)|(2<<17);
    aki_dyn:u32=4|(1<<16)|(1<<17)|(1<<18)|(2<<19);
    // Unclipped (qk_clip=50.0) SWA + has_dyn=1 -> checks exact raw K/V conv weights & dyn offsets!
    for h:0..<6 {
        am_kv_attn_gqa_1pass_nb(h,ad0,ad1_swa,aki_dyn,3,50.0f32,10.0f32,0.5f32,tau[..],kr[..],vr[..],kw[..],vw[..],dy[..],kh[..],vh[..],fq[..],fqs[..],fr[..],frs[..],frb[..],fsk[..],fgt[..],kc[..],vc[..],klog[..],vlog[..],fo[..]);
    }
    #assert abs(kh[128*4+3]-kh_r[128*4+3])<0.0001f32 && abs(vh[128*4+3]-vh_r[128*4+3])<0.0001f32;
    #assert abs(klog[256+128]-kr[256+128])<0.0001f32 && abs(vlog[256+128]-vr[256+128])<0.0001f32;
    for t:0..<2 {
        p:=3+t;
        for h:0..<6 {
            am_kv_attn_gqa_1pass(h,ad0,ad1_swa,aki_dyn,p,p%4,50.0f32,10.0f32,tau[t],0.5f32,kr[t*256..<(t+1)*256],vr[t*256..<(t+1)*256],kw[..],vw[..],dy[t*16..<(t+1)*16],kh_r[..],vh_r[..],fq[t*768..<(t+1)*768],fqs[..],fr[t*12..<(t+1)*12],frs[..],frb[..],fsk[t*6..<(t+1)*6],fgt[t*768..<(t+1)*768],kc_r[..],vc_r[..],fo_r[t*768..<(t+1)*768]);
        }
        sp:=p%4;
        #assert abs(am_f16(cast(u32)kc[sp*256+128+5])-am_f16(cast(u32)kc_r[sp*256+128+5]))<0.001f32;
        #assert abs(am_f16(cast(u32)vc[sp*256+128+5])-am_f16(cast(u32)vc_r[sp*256+128+5]))<0.001f32;
        #assert abs(fo[t*768+3*128]-fo_r[t*768+3*128])<0.001f32 && abs(fo[t*768+4*128]-fo_r[t*768+4*128])<0.001f32;
    }
    // Actively clipped K (qk_clip=0.5) + is_swa=0 with pos0=2, kv_cap=2 (non-SWA writes slot 2,3; if is_swa mutated to 1 it wraps to 0,1!)
    ad1_full:u32=2|(0<<16)|(2<<17);
    aki_nod:u32=2|(1<<16)|(1<<17)|(0<<18)|(2<<19);
    for i:0..<1024 {kh_r[i]=kh[i];vh_r[i]=vh[i];kc[i]=am_to_f16(0.1f32);vc[i]=am_to_f16(0.2f32);kc_r[i]=kc[i];vc_r[i]=vc[i];}
    for h:0..<6 {
        am_kv_attn_gqa_1pass_nb(h,ad0,ad1_full,aki_nod,2,0.5f32,10.0f32,0.5f32,tau[..],kr[..],vr[..],kw[..],vw[..],dy[..],kh[..],vh[..],fq[..],fqs[..],fr[..],frs[..],frb[..],fsk[..],fgt[..],kc[..],vc[..],klog[..],vlog[..],fo[..]);
    }
    for t:0..<2 {
        p:=2+t;
        for h:0..<6 {
            am_kv_attn_gqa_1pass(h,ad0,ad1_full,aki_nod,p,p,0.5f32,10.0f32,tau[t],0.5f32,kr[t*256..<(t+1)*256],vr[t*256..<(t+1)*256],kw[..],vw[..],dy[t*16..<(t+1)*16],kh_r[..],vh_r[..],fq[t*768..<(t+1)*768],fqs[..],fr[t*12..<(t+1)*12],frs[..],frb[..],fsk[t*6..<(t+1)*6],fgt[t*768..<(t+1)*768],kc_r[..],vc_r[..],fo_r[t*768..<(t+1)*768]);
        }
        #assert abs(am_f16(cast(u32)kc[p*256+128+5])-am_f16(cast(u32)kc_r[p*256+128+5]))<0.001f32;
        #assert abs(am_f16(cast(u32)kc[0])-0.1f32)<0.001f32;
        #assert abs(fo[t*768+5*128]-fo_r[t*768+5*128])<0.001f32;
    }
    // Tiny-norm K test (sqrt(kn) < 1e-6 -> kills +0.000001f32 -> -0.000001f32 because denominator flips sign and avoids >1 clamp!)
    zk:[512]f32;zkh:[1024]f32;zk[0]=0.0000005f32;
    am_kv_attn_gqa_1pass_nb(0,ad0,ad1_full,aki_nod,0,0.01f32,10.0f32,0.5f32,tau[..],zk[..],vr[..],kw[..],vw[..],dy[..],zkh[..],vh[..],fq[..],fqs[..],fr[..],frs[..],frb[..],fsk[..],fgt[..],kc[..],vc[..],klog[..],vlog[..],fo[..]);
    #assert am_f16(cast(u32)kc[0])>=-0.0001f32;
    // n_head_kv=1 (kills 2*n_head_kv *->+ since 2*1=2 != 2+1=3!) with has_dyn=1, nb=2
    ad0_1:u32=3|(1<<8)|(128<<16)|(2<<24);
    for i:0..<1024 {kh_r[i]=kh[i];vh_r[i]=vh[i];kc[i]=am_to_f16(0.1f32);vc[i]=am_to_f16(0.2f32);kc_r[i]=kc[i];vc_r[i]=vc[i];}
    am_kv_attn_gqa_1pass_nb(0,ad0_1,ad1_swa,aki_dyn,1,50.0f32,10.0f32,0.5f32,tau[..],kr[..],vr[..],kw[..],vw[..],dy[..],kh[..],vh[..],fq[..],fqs[..],fr[..],frs[..],frb[..],fsk[..],fgt[..],kc[..],vc[..],klog[..],vlog[..],fo[..]);
    for t:0..<2 {
        am_kv_attn_gqa_1pass(0,ad0_1,ad1_swa,aki_dyn,1+t,(1+t)%4,50.0f32,10.0f32,tau[t],0.5f32,kr[t*128..<(t+1)*128],vr[t*128..<(t+1)*128],kw[..],vw[..],dy[t*8..<(t+1)*8],kh_r[..],vh_r[..],fq[t*384..<(t+1)*384],fqs[..],fr[t*6..<(t+1)*6],frs[..],frb[..],fsk[t*3..<(t+1)*3],fgt[t*384..<(t+1)*384],kc_r[..],vc_r[..],fo_r[t*384..<(t+1)*384]);
    }
    #assert abs(am_f16(cast(u32)kc[2*128+5])-am_f16(cast(u32)kc_r[2*128+5]))<0.001f32 && abs(am_f16(cast(u32)vc[2*128+5])-am_f16(cast(u32)vc_r[2*128+5]))<0.001f32;

    // 6. am_conv_commit_nb: n_slots=2, n_kv=3, d=4 (non-2 so 2*3!=2+3!), pos0=3, got=1 & got=2, boundary ch checks!
    // ch_per = 6 + 8 = 14; conv_stride = 2*3*4 + 2*4*3 = 24 + 24 = 48; raw_stride = 8*14 = 112
    ca:[96]f32;rl:[224]f32;
    for i:0..<96 {ca[i]=f32(i+1);}
    for i:0..<224 {rl[i]=200.0f32+f32(i);}
    // First got=1 on slot 1 (items 14..28 including out-of-range 28!) -> checks h1 preserved into hb!
    for ix:14..<29 {am_conv_commit_nb(ix,2,3,4,3,1,ca[..],rl[..]);}
    // Slot 1 cbase=48, rbase=112:
    // K ch=2 (hb=48+8=56): idx 3 = rl[112+2]=314, idx 0 still 57
    #assert ca[56+3]==314.0f32 && ca[56+0]==57.0f32;
    // V ch=0 (c=0, hb=48+12=60): idx 3 = rl[112+24+0]=336; V ch=2 (hb=68): idx 3 = rl[112+24+2]=338
    #assert ca[60+3]==336.0f32 && ca[68+3]==338.0f32;
    // AO c=0 (hb=48+24=72): old [73,74,75] -> shift 1 -> [74, 75, rl[112+48+0]=360]
    #assert ca[72]==74.0f32 && ca[73]==75.0f32 && ca[74]==360.0f32;
    // AO c=3 (hb=48+24+9=81): old [82,83,84] -> [83, 84, rl[112+48+3]=363]
    #assert ca[81]==83.0f32 && ca[82]==84.0f32 && ca[83]==363.0f32;
    // FF c=0 (hb=48+24+12=84): old [85,86,87] -> [86, 87, rl[112+48+32+0]=392]
    #assert ca[84]==86.0f32 && ca[85]==87.0f32 && ca[86]==392.0f32;
    // FF c=3 (hb=93): old [94,95,96] -> [95, 96, rl[112+48+32+3]=395]
    #assert ca[93]==95.0f32 && ca[94]==96.0f32 && ca[95]==395.0f32;
    // Now got=2 on slot 0 (items 0..14) with pos0=3 (wraps 3->0!)
    for ix:0..<14 {am_conv_commit_nb(ix,2,3,4,3,2,ca[..],rl[..]);}
    #assert ca[8+3]==202.0f32 && ca[8+0]==205.0f32 && ca[20+3]==226.0f32 && ca[20+0]==229.0f32;
    #assert ca[24]==27.0f32 && ca[25]==248.0f32 && ca[26]==252.0f32;
    #assert ca[45]==48.0f32 && ca[46]==283.0f32 && ca[47]==287.0f32;

    // 7. am_dot_q4s_small_nb: 2 groups x 3 rows_per_grp = 6 rows, cols=32, nb=2, n_parts=0 and n_parts=2!
    smx:[128]f32;smo:[12]f32;
    for i:0..<128 {smx[i]=0.04f32*f32((i%17)-8)+0.01f32*f32(i/17);}
    for i:0..<12 {smo[i]=-99.0f32;}
    am_dot_q4s_small_nb(5,3,32,2,0,0.5f32,qs[..],ds[..],smx[..],qparts[..],smo[..]);
    // grp=1, rloc=2 -> out[(1*2+0)*3+2]=smo[8], out[(1*2+1)*3+2]=smo[11] using smx[2*32..] and smx[3*32..]
    #assert abs(smo[8]-am_dot_q4s_lane(qs[..],ds[..],5,smx[..],64,1))<0.001f32;
    #assert abs(smo[11]-am_dot_q4s_lane(qs[..],ds[..],5,smx[..],96,1))<0.001f32 && abs(smo[7]+99.0f32)<0.001f32;
    am_dot_q4s_small_nb(5,3,32,2,1,0.5f32,qs[..],ds[..],smx[..],qparts[..],smo[..]);
    #assert abs(smo[8]-am_dot_q4s_lane(qs[..],ds[..],5,smx[..],64,1)*(1.0f32/sqrt(qparts[2]/32.0f32+0.5f32)))<0.001f32;
    am_dot_q4s_small_nb(5,3,32,2,2,0.5f32,qs[..],ds[..],smx[..],qparts[..],smo[..]);
    sm_i0:=1.0f32/sqrt((qparts[4]+qparts[5])/32.0f32+0.5f32);
    sm_i1:=1.0f32/sqrt((qparts[6]+qparts[7])/32.0f32+0.5f32);
    #assert abs(smo[8]-am_dot_q4s_lane(qs[..],ds[..],5,smx[..],64,1)*sm_i0)<0.001f32;
    #assert abs(smo[11]-am_dot_q4s_lane(qs[..],ds[..],5,smx[..],96,1)*sm_i1)<0.001f32;

    // 8. am_mix_fused_nb: mode=0 (mix+rmsnorm) and mode=1 (mix+ctrl_prep), nb=2, t_idx=1, non-zero q_off/aux_off/o0_off/o1_off
    mfb:[16]f32;mfc:[8]f32;mfq:[8]f32;mfa:[8]f32;mfo0:[16]f32;mfo1:[16]f32;
    for i:0..<16 {mfb[i]=0.0f32;mfo0[i]=-88.0f32;mfo1[i]=-88.0f32;}
    for i:0..<8 {mfc[i]=0.0f32;mfq[i]=0.0f32;mfa[i]=0.0f32;}
    // t_idx=1 at dim=4, n_blocks=2, nb=2: s=0 at mfb[4..8], s=1 at mfb[12..16], cur at mfc[4..8]
    mfb[4]=1.0f32;mfb[5]=2.0f32;mfb[6]=-1.0f32;mfb[7]=0.5f32;
    mfb[12]=-0.5f32;mfb[13]=1.5f32;mfb[14]=2.0f32;mfb[15]=1.0f32;
    mfc[4]=0.5f32;mfc[5]=-1.0f32;mfc[6]=1.5f32;mfc[7]=2.0f32;
    mfq[2]=1.5f32;mfq[3]=-0.5f32;mfq[4]=2.0f32;mfq[5]=1.0f32;
    mfa[2]=2.0f32;mfa[3]=-1.5f32;mfa[4]=3.0f32;mfa[5]=0.5f32;
    mf_iv0:=1.0f32/sqrt((1.0f32+4.0f32+1.0f32+0.25f32)/4.0f32+0.000001f32);
    mf_iv1:=1.0f32/sqrt((0.25f32+2.25f32+4.0f32+1.0f32)/4.0f32+0.000001f32);
    mf_iv2:=1.0f32/sqrt((0.25f32+1.0f32+2.25f32+4.0f32)/4.0f32+0.000001f32);
    mf_sc0:=(1.5f32-1.0f32-2.0f32+0.5f32)*mf_iv0*0.5f32;
    mf_sc1:=(-0.75f32-0.75f32+4.0f32+1.0f32)*mf_iv1*0.5f32;
    mf_sc2:=(0.75f32+0.5f32+3.0f32+2.0f32)*mf_iv2*0.5f32;
    mf_e0:=exp(mf_sc0-mf_sc2);mf_e1:=exp(mf_sc1-mf_sc2);mf_es:=mf_e0+mf_e1+1.0f32;
    mf_ref:[4]f32;mf_s1:f32=0.0f32;mf_s2:f32=0.0f32;
    for i:0..<4 {
        mf_ref[i]=(mf_e0/mf_es*mf_iv0)*mfb[4+i]+(mf_e1/mf_es*mf_iv1)*mfb[12+i]+(1.0f32/mf_es*mf_iv2)*mfc[4+i];
        mf_s1+=mf_ref[i]*mf_ref[i];mf_s2+=mfa[2+i]*mfa[2+i];
    }
    am_mix_fused_nb(0,4,2,2,1,0.5f32,mfb[..],mfc[..],mfq[..],2,mfa[..],2,mfo0[..],3,mfo1[..],2);
    mf_i0:=1.0f32/sqrt(mf_s1/4.0f32+0.5f32);
    for i:0..<4 {#assert abs(mfo0[3+i]-mf_ref[i]*mf_i0*mfa[2+i])<0.0005f32;}
    #assert abs(mfo1[2]+88.0f32)<0.001f32;
    am_mix_fused_nb(1,4,2,2,1,0.5f32,mfb[..],mfc[..],mfq[..],2,mfa[..],2,mfo0[..],3,mfo1[..],2);
    mf_i1:=1.0f32/sqrt(mf_s1/4.0f32+0.000001f32);mf_i2:=1.0f32/sqrt(mf_s2/4.0f32+0.000001f32);
    for i:0..<4 {#assert abs(mfo0[3+i]-mf_ref[i])<0.0005f32 && abs(mfo1[2+i]-mf_ref[i]*mf_i1)<0.0005f32 && abs(mfo1[6+i]-mfa[2+i]*mf_i2)<0.0005f32;}
    // Huge query with sc0 max + zero block + zero aux -> kills mx/sc-mx/+1e-6 mutants!
    mfb[4]=2.0f32;mfb[5]=0.0f32;mfb[6]=0.0f32;mfb[7]=0.0f32;
    for i:12..<16 {mfb[i]=0.0f32;}
    mfq[2]=200.0f32;mfq[3]=0.0f32;mfq[4]=0.0f32;mfq[5]=0.0f32;
    for i:2..<6 {mfa[i]=0.0f32;}
    am_mix_fused_nb(1,4,2,2,1,0.000001f32,mfb[..],mfc[..],mfq[..],2,mfa[..],2,mfo0[..],0,mfo1[..],0);
    #assert abs(mfo0[0]-2.0f32)<0.01f32 && abs(mfo1[0]-2.0f32)<0.01f32 && abs(mfo1[4])<0.001f32;
    // All-zero states in mode=1 -> s1==0 (kills +1e-6 -> - in inv1!)
    mfb[4]=0.0f32;for i:4..<8 {mfc[i]=0.0f32;}
    am_mix_fused_nb(1,4,2,2,1,0.000001f32,mfb[..],mfc[..],mfq[..],2,mfa[..],2,mfo0[..],0,mfo1[..],0);
    #assert abs(mfo1[0])<0.001f32 && abs(mfo1[4])<0.001f32;

    // 9. am_ctrl_up_apply_gf_rm_nb: dim=33 (n_parts=2), rank=2, nb=2, non-zero offsets + w_norm + rms_parts!
    crm_w:[70]u32;crm_g:[6]f32;crm_c:[68]f32;crm_m:[68]f32;crm_nw:[33]f32;crm_o:[68]f32;crm_p:[8]f32;
    for r:0..<33 {
        crm_w[2+r*2+0]=0x38003c00;crm_w[2+r*2+1]=0x38003c00;
        crm_nw[r]=0.5f32+0.05f32*f32(r%5);
    }
    crm_w[2+0*2+1]=0x38004000;crm_w[2+32*2+0]=0xbc003c00;
    crm_g[1]=1.0f32;crm_g[2]=0.5f32;crm_g[3]=0.25f32;crm_g[4]=-0.5f32;
    for i:0..<68 {crm_c[i]=2.0f32+f32(i%3);crm_m[i]=4.0f32+f32(i%2);crm_o[i]=-99.0f32;}
    for i:0..<8 {crm_p[i]=-99.0f32;}
    am_ctrl_up_apply_gf_rm_nb(33,2,2,0,crm_w[..],2,crm_g[..],1,crm_c[..],1,crm_m[..],1,crm_nw[..],crm_o[..],1,crm_p[..],2,0);
    cr_e00:=crm_c[1]-am_tanh(0.75f32)*crm_c[1]+am_tanh(2.0f32)*crm_m[1];
    cr_e10:=crm_c[34]-am_tanh(-0.125f32)*crm_c[34]+am_tanh(-0.75f32)*crm_m[34];
    #assert abs(crm_o[1]-cr_e00*crm_nw[0])<0.001f32 && abs(crm_o[34]-cr_e10*crm_nw[0])<0.001f32 && abs(crm_o[33]+99.0f32)<0.001f32;
    #assert crm_p[2]>10.0f32 && crm_p[4]>10.0f32 && abs(crm_p[3]+99.0f32)<0.001f32;
    am_ctrl_up_apply_gf_rm_nb(33,2,2,32,crm_w[..],2,crm_g[..],1,crm_c[..],1,crm_m[..],1,crm_nw[..],crm_o[..],1,crm_p[..],2,1);
    cr_e032:=crm_c[33]-am_tanh(-0.75f32)*crm_c[33]+am_tanh(1.5f32)*crm_m[33];
    cr_e132:=crm_c[66]-am_tanh(-0.5f32)*crm_c[66]+am_tanh(-0.25f32)*crm_m[66];
    #assert abs(crm_o[33]-cr_e032*crm_nw[32])<0.001f32 && abs(crm_o[66]-cr_e132*crm_nw[32])<0.001f32 && abs(crm_o[67]+99.0f32)<0.001f32;
    #assert abs(crm_p[3]-cr_e032*cr_e032)<0.01f32 && abs(crm_p[5]-cr_e132*cr_e132)<0.01f32;
    // dim=32 -> n_parts=(32+31)/32=1 (kills 31->32 where (32+32)/32=2 would write t=1 to index 4 instead of 3!)
    for i:0..<8 {crm_p[i]=-99.0f32;}
    am_ctrl_up_apply_gf_rm_nb(32,2,2,0,crm_w[..],2,crm_g[..],1,crm_c[..],1,crm_m[..],1,crm_nw[..],crm_o[..],1,crm_p[..],2,0);
    #assert crm_p[2]>10.0f32 && crm_p[3]>10.0f32 && abs(crm_p[4]+99.0f32)<0.001f32;

    // 10. am_dot_q4s_8row_nb: rows=9, cols=32, nb=2, row_base=1, x_off=1, out_off=1, cap=0 and cap=2
    q8_qs:[40]u32;q8_ds:[10]u16;q8_x:[65]f32;q8_o:[22]f32;
    for b:0..<10 {
        q8_ds[b]=0x3c00;
        for w:0..<4 {q8_qs[b*4+w]=0x99999999+cast(u32)(b&1)*0x11111111;}
    }
    q8_x[0]=-77.0f32;
    for i:0..<32 {q8_x[1+i]=0.25f32;q8_x[33+i]=0.5f32;}
    for i:0..<22 {q8_o[i]=-88.0f32;}
    am_dot_q4s_8row_nb(0,9,32,2,1,1,1,0.0f32,q8_qs[..],q8_ds[..],q8_x[..],q8_o[..]);
    #assert abs(q8_o[0]+88.0f32)<0.001f32 && abs(q8_o[9]+88.0f32)<0.001f32;
    #assert abs(q8_o[1]-am_dot_q4s_lane(q8_qs[..],q8_ds[..],1,q8_x[..],1,1))<0.001f32;
    #assert abs(q8_o[8]-am_dot_q4s_lane(q8_qs[..],q8_ds[..],8,q8_x[..],1,1))<0.001f32;
    #assert abs(q8_o[10]-am_dot_q4s_lane(q8_qs[..],q8_ds[..],1,q8_x[..],33,1))<0.001f32;
    #assert abs(q8_o[17]-am_dot_q4s_lane(q8_qs[..],q8_ds[..],8,q8_x[..],33,1))<0.001f32;
    am_dot_q4s_8row_nb(8,9,32,2,1,1,1,20.0f32,q8_qs[..],q8_ds[..],q8_x[..],q8_o[..]);
    e8_0:=am_dot_q4s_lane(q8_qs[..],q8_ds[..],9,q8_x[..],1,1);
    e8_1:=am_dot_q4s_lane(q8_qs[..],q8_ds[..],9,q8_x[..],33,1);
    #assert abs(q8_o[9]-20.0f32*am_tanh(e8_0/20.0f32))<0.001f32;
    #assert abs(q8_o[18]-20.0f32*am_tanh(e8_1/20.0f32))<0.001f32 && abs(q8_o[19]+88.0f32)<0.001f32;

    // 11. am_dspark_fold_logits_s1: nv=64 (chunk=1), nv=66 (lo==hi at item=33), nv=130 (chunk=3, lo<hi, equal tie, rising max, falling val, non-zero lo*8, cap=0 and cap=5)
    df_qs:[4160]u32;df_ds:[1040]u16;df_lat:[256]f32;df_base:[260]f32;df_fb:[130]f32;
    df_m:[64]f32;df_i:[64]u32;df_s:[64]f32;
    for i:0..<4160 {df_qs[i]=0x88888888;}
    for i:0..<1040 {df_ds[i]=0x3c00;}
    for i:0..<256 {df_lat[i]=0.0625f32;}
    for i:0..<260 {df_base[i]=0.0f32;}
    for i:0..<130 {df_fb[i]=0.0f32;}
    // Row 0..2 for step_idx=1 (b_off=130): row 0 delta=+16 (9s), row 1 tie, row 2 higher (+20)
    for b:0..<8 {df_ds[b]=0x3c00;for w:0..<4 {df_qs[b*4+w]=0x99999999;}}
    for b:8..<16 {df_ds[b]=0x3c00;for w:0..<4 {df_qs[b*4+w]=0x99999999;}}
    for b:1032..<1040 {df_ds[b]=0x3c00;for w:0..<4 {df_qs[b*4+w]=0x99999999;}}
    df_base[130]=1.0f32;df_fb[0]=0.5f32;
    df_base[131]=1.0f32;df_fb[1]=0.5f32;
    df_base[132]=2.0f32;df_fb[2]=1.0f32;
    am_dspark_fold_logits_s1(0,130,1,0.0f32,df_qs[..],df_ds[..],df_lat[..],df_base[..],df_fb[..],df_m[..],df_i[..],df_s[..]);
    // r=0: 1.5+16=17.5, r=1: 17.5 (tie -> stays 0, gs=2), r=2: 3.0+0=3.0 (falls -> gs=2+exp(3-17.5))
    #assert abs(df_m[0]-17.5f32)<0.01f32 && df_i[0]==0 && abs(df_s[0]-(2.0f32+exp(-14.5f32)))<0.01f32;
    // Rising max: make r=2 strictly larger (cap=5.0)
    df_base[132]=20.0f32;
    am_dspark_fold_logits_s1(0,130,1,5.0f32,df_qs[..],df_ds[..],df_lat[..],df_base[..],df_fb[..],df_m[..],df_i[..],df_s[..]);
    c0:=5.0f32*am_tanh(17.5f32/5.0f32);c2:=5.0f32*am_tanh(21.0f32/5.0f32);
    #assert abs(df_m[0]-c2)<0.001f32 && df_i[0]==2 && abs(df_s[0]-(2.0f32*exp(c0-c2)+1.0f32))<0.005f32;
    // Partial tail item=43 (lo=129, hi=130, non-zero row 129 delta=+16!) & lo==hi item=33 nv=66 & exact nv=64 (chunk=1)
    df_base[130+129]=4.0f32;df_fb[129]=0.25f32;
    am_dspark_fold_logits_s1(43,130,1,0.0f32,df_qs[..],df_ds[..],df_lat[..],df_base[..],df_fb[..],df_m[..],df_i[..],df_s[..]);
    #assert abs(df_m[43]-20.25f32)<0.01f32 && df_i[43]==129 && abs(df_s[43]-1.0f32)<0.001f32;
    am_dspark_fold_logits_s1(33,66,0,0.0f32,df_qs[..],df_ds[..],df_lat[..],df_base[..],df_fb[..],df_m[..],df_i[..],df_s[..]);
    #assert df_m[33]<-1.0e29f32 && df_i[33]==0 && abs(df_s[33])<0.001f32;
    df_base[63]=3.0f32;df_fb[63]=0.5f32;
    am_dspark_fold_logits_s1(63,64,0,0.0f32,df_qs[..],df_ds[..],df_lat[..],df_base[..],df_fb[..],df_m[..],df_i[..],df_s[..]);
    #assert abs(df_m[63]-3.5f32)<0.001f32 && df_i[63]==63 && abs(df_s[63]-1.0f32)<0.001f32;

    // 12. am_dot_q4s_mma32_nb: rows=33, cols=32, nb=2, row_base=1, x_off=1, out_off=1, cap=0 and cap=20
    m32_qs:[136]u32;m32_ds:[34]u16;m32_x:[65]f32;m32_o:[68]f32;
    for b:0..<34 {
        m32_ds[b]=0x3c00;
        for w:0..<4 {m32_qs[b*4+w]=0x99999999+cast(u32)(b&1)*0x11111111;}
    }
    m32_x[0]=-77.0f32;
    for i:0..<32 {m32_x[1+i]=0.25f32;m32_x[33+i]=0.5f32;}
    for i:0..<68 {m32_o[i]=-88.0f32;}
    am_dot_q4s_mma32_nb(0,33,32,2,1,1,1,0.0f32,m32_qs[..],m32_ds[..],m32_x[..],m32_o[..]);
    #assert abs(m32_o[0]+88.0f32)<0.001f32 && abs(m32_o[33]+88.0f32)<0.001f32;
    #assert abs(m32_o[1]-am_dot_q4s_lane(m32_qs[..],m32_ds[..],1,m32_x[..],1,1))<0.001f32;
    #assert abs(m32_o[32]-am_dot_q4s_lane(m32_qs[..],m32_ds[..],32,m32_x[..],1,1))<0.001f32;
    #assert abs(m32_o[34]-am_dot_q4s_lane(m32_qs[..],m32_ds[..],1,m32_x[..],33,1))<0.001f32;
    #assert abs(m32_o[65]-am_dot_q4s_lane(m32_qs[..],m32_ds[..],32,m32_x[..],33,1))<0.001f32;
    am_dot_q4s_mma32_nb(32,33,32,2,1,1,1,20.0f32,m32_qs[..],m32_ds[..],m32_x[..],m32_o[..]);
    e32_0:=am_dot_q4s_lane(m32_qs[..],m32_ds[..],33,m32_x[..],1,1);
    e32_1:=am_dot_q4s_lane(m32_qs[..],m32_ds[..],33,m32_x[..],33,1);
    #assert abs(m32_o[33]-20.0f32*am_tanh(e32_0/20.0f32))<0.001f32;
    #assert abs(m32_o[66]-20.0f32*am_tanh(e32_1/20.0f32))<0.001f32 && abs(m32_o[67]+88.0f32)<0.001f32;

    // 13. am_moe_down_p1_iq4s_nb & am_moe_down_p1_q4s_nb: rows=17, cols=32, nb=2, n_used=2, nu=2 (u=0 shared, u=1 tok 1 only, u=2 OOB)
    dp_qs:[272]u32;dp_ds:[68]u16;dp_x:[128]f32;dp_out:[68]f32;dp_out2:[68]f32;
    dp_ue:[4]u32;dp_um:[4]u32;dp_us:[32]u32;dp_uc:[4]u32;
    for b:0..<68 {
        dp_ds[b]=0x3c00;
        for w:0..<4 {dp_qs[b*4+w]=0x99999999+cast(u32)(b&3)*0x11111111;}
    }
    for i:0..<128 {dp_x[i]=0.1f32*f32((i/32)+1);}
    for i:0..<68 {dp_out[i]=-55.0f32;dp_out2[i]=-55.0f32;}
    dp_uc[0]=2;dp_ue[0]=1;dp_ue[1]=2;dp_ue[2]=0;dp_um[0]=3;dp_um[1]=2;dp_um[2]=3;
    dp_us[0]=0;dp_us[1]=1;dp_us[9]=0;dp_us[10]=1;dp_us[16]=0;dp_us[17]=1;
    // OOB u==2 must not touch slot_out (non-zero mask kills >= -> >!)
    am_moe_down_p1_iq4s_nb(2,0,17,32,2,2,dp_qs[..],dp_ds[..],dp_x[..],dp_ue[..],dp_um[..],dp_us[..],dp_uc[..],dp_out[..]);
    am_moe_down_p1_q4s_nb(2,0,17,32,2,2,dp_qs[..],dp_ds[..],dp_x[..],dp_ue[..],dp_um[..],dp_us[..],dp_uc[..],dp_out2[..]);
    #assert abs(dp_out[0]+55.0f32)<0.001f32 && abs(dp_out2[0]+55.0f32)<0.001f32;
    // u=0 (both tokens, eid=1, row0=0 then row0=16) and u=1 (token 1 only, eid=2, slot 0; dp_us[10]=1 kills 8->9!)
    am_moe_down_p1_iq4s_nb(0,0,17,32,2,2,dp_qs[..],dp_ds[..],dp_x[..],dp_ue[..],dp_um[..],dp_us[..],dp_uc[..],dp_out[..]);
    #assert abs(dp_out[16]+55.0f32)<0.001f32;
    am_moe_down_p1_iq4s_nb(0,16,17,32,2,2,dp_qs[..],dp_ds[..],dp_x[..],dp_ue[..],dp_um[..],dp_us[..],dp_uc[..],dp_out[..]);
    am_moe_down_p1_iq4s_nb(1,0,17,32,2,2,dp_qs[..],dp_ds[..],dp_x[..],dp_ue[..],dp_um[..],dp_us[..],dp_uc[..],dp_out[..]);
    am_moe_down_p1_iq4s_nb(1,16,17,32,2,2,dp_qs[..],dp_ds[..],dp_x[..],dp_ue[..],dp_um[..],dp_us[..],dp_uc[..],dp_out[..]);
    // tok0 slot0 (eid=1) -> ob=0; tok0 slot1 untouched (-55); tok1 slot0 (eid=2) -> ob=34; tok1 slot1 (eid=1) -> ob=51
    #assert abs(dp_out[0]-am_dot_iq4s_lane(dp_qs[..],dp_ds[..],17,dp_x[..],0,1))<0.001f32;
    #assert abs(dp_out[1]-am_dot_iq4s_lane(dp_qs[..],dp_ds[..],18,dp_x[..],0,1))<0.001f32;
    #assert abs(dp_out[16]-am_dot_iq4s_lane(dp_qs[..],dp_ds[..],33,dp_x[..],0,1))<0.001f32;
    #assert abs(dp_out[17]+55.0f32)<0.001f32;
    #assert abs(dp_out[34]-am_dot_iq4s_lane(dp_qs[..],dp_ds[..],34,dp_x[..],64,1))<0.001f32;
    #assert abs(dp_out[50]-am_dot_iq4s_lane(dp_qs[..],dp_ds[..],50,dp_x[..],64,1))<0.001f32;
    #assert abs(dp_out[51]-am_dot_iq4s_lane(dp_qs[..],dp_ds[..],17,dp_x[..],96,1))<0.001f32;
    #assert abs(dp_out[67]-am_dot_iq4s_lane(dp_qs[..],dp_ds[..],33,dp_x[..],96,1))<0.001f32;
    am_moe_down_p1_q4s_nb(0,0,17,32,2,2,dp_qs[..],dp_ds[..],dp_x[..],dp_ue[..],dp_um[..],dp_us[..],dp_uc[..],dp_out2[..]);
    #assert abs(dp_out2[16]+55.0f32)<0.001f32;
    am_moe_down_p1_q4s_nb(0,16,17,32,2,2,dp_qs[..],dp_ds[..],dp_x[..],dp_ue[..],dp_um[..],dp_us[..],dp_uc[..],dp_out2[..]);
    am_moe_down_p1_q4s_nb(1,0,17,32,2,2,dp_qs[..],dp_ds[..],dp_x[..],dp_ue[..],dp_um[..],dp_us[..],dp_uc[..],dp_out2[..]);
    am_moe_down_p1_q4s_nb(1,16,17,32,2,2,dp_qs[..],dp_ds[..],dp_x[..],dp_ue[..],dp_um[..],dp_us[..],dp_uc[..],dp_out2[..]);
    #assert abs(dp_out2[0]-am_dot_q4s_lane(dp_qs[..],dp_ds[..],17,dp_x[..],0,1))<0.001f32;
    #assert abs(dp_out2[1]-am_dot_q4s_lane(dp_qs[..],dp_ds[..],18,dp_x[..],0,1))<0.001f32;
    #assert abs(dp_out2[16]-am_dot_q4s_lane(dp_qs[..],dp_ds[..],33,dp_x[..],0,1))<0.001f32;
    #assert abs(dp_out2[17]+55.0f32)<0.001f32;
    #assert abs(dp_out2[34]-am_dot_q4s_lane(dp_qs[..],dp_ds[..],34,dp_x[..],64,1))<0.001f32;
    #assert abs(dp_out2[50]-am_dot_q4s_lane(dp_qs[..],dp_ds[..],50,dp_x[..],64,1))<0.001f32;
    #assert abs(dp_out2[51]-am_dot_q4s_lane(dp_qs[..],dp_ds[..],17,dp_x[..],96,1))<0.001f32;
    #assert abs(dp_out2[67]-am_dot_q4s_lane(dp_qs[..],dp_ds[..],33,dp_x[..],96,1))<0.001f32;

    // 14. am_dot_q8_mma32_nb: rows=33, cols=64 (2 blocks), nb=2, row_base=1, x_off=1, out_off=1, pos+neg int8, cap=0 and cap=20
    q8m_w:[1156]u16;q8m_x:[129]f32;q8m_o:[68]f32;
    for b:0..<68 {
        q8m_w[b*17]=ifx (b&1)==0 then cast(u16)0x3c00 else cast(u16)0x3800;
        for j:0..<16 {
            lo:=ifx j==0 then cast(u16)128 else ifx j==15 then cast(u16)127 else cast(u16)(1+((j+b)&3));
            hi:=ifx j==0 then cast(u16)255 else ifx j==15 then cast(u16)128 else cast(u16)(254-((j+b)&3));
            q8m_w[b*17+1+j]=lo|(hi<<8);
        }
    }
    q8m_x[0]=-99.0f32;
    for i:0..<64 {q8m_x[1+i]=0.01f32*f32(i+1);q8m_x[65+i]=-0.02f32*f32(i+2);}
    for i:0..<68 {q8m_o[i]=-88.0f32;}
    am_dot_q8_mma32_nb(0,33,64,2,1,1,1,0.0f32,q8m_w[..],q8m_x[..],q8m_o[..]);
    #assert abs(q8m_o[0]+88.0f32)<0.001f32 && abs(q8m_o[33]+88.0f32)<0.001f32;
    // Reference dot for row r=0 (rb=2, blocks 2 & 3) and r=32 (rb=66, blocks 66 & 67):
    q8_ref0:f32=0.0f32;q8_ref1:f32=0.0f32;
    for b:0..<2 {
        gb:=2+b;
        sc:f32=ifx (gb&1)==0 then 1.0f32 else 0.5f32;
        s0:f32=0.0f32;s1:f32=0.0f32;
        for j:0..<16 {
            v0:f32=ifx j==0 then -128.0f32 else ifx j==15 then 127.0f32 else f32(1+((j+gb)&3));
            v1:f32=ifx j==0 then -1.0f32 else ifx j==15 then -128.0f32 else f32(-2-((j+gb)&3));
            s0+=v0*q8m_x[1+b*32+j*2]+v1*q8m_x[1+b*32+j*2+1];
            s1+=v0*q8m_x[65+b*32+j*2]+v1*q8m_x[65+b*32+j*2+1];
        }
        q8_ref0+=sc*s0;q8_ref1+=sc*s1;
    }
    q8_ref31_0:f32=0.0f32;q8_ref31_1:f32=0.0f32;
    for b:0..<2 {
        gb:=64+b;
        sc:f32=ifx (gb&1)==0 then 1.0f32 else 0.5f32;
        s0:f32=0.0f32;s1:f32=0.0f32;
        for j:0..<16 {
            v0:f32=ifx j==0 then -128.0f32 else ifx j==15 then 127.0f32 else f32(1+((j+gb)&3));
            v1:f32=ifx j==0 then -1.0f32 else ifx j==15 then -128.0f32 else f32(-2-((j+gb)&3));
            s0+=v0*q8m_x[1+b*32+j*2]+v1*q8m_x[1+b*32+j*2+1];
            s1+=v0*q8m_x[65+b*32+j*2]+v1*q8m_x[65+b*32+j*2+1];
        }
        q8_ref31_0+=sc*s0;q8_ref31_1+=sc*s1;
    }
    #assert abs(q8m_o[1]-q8_ref0)<0.01f32 && abs(q8m_o[32]-q8_ref31_0)<0.01f32;
    #assert abs(q8m_o[34]-q8_ref1)<0.01f32 && abs(q8m_o[65]-q8_ref31_1)<0.01f32;
    am_dot_q8_mma32_nb(32,33,64,2,1,1,1,20.0f32,q8m_w[..],q8m_x[..],q8m_o[..]);
    #assert abs(q8m_o[33]-20.0f32*am_tanh(q8_ref0/20.0f32))<0.01f32;
    #assert abs(q8m_o[66]-20.0f32*am_tanh(q8_ref1/20.0f32))<0.01f32 && abs(q8m_o[67]+88.0f32)<0.001f32;
}
