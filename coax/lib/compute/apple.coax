// Apple matrix primitives of the Metal compute subset, with their CPU
// meaning. `coax metal-compute` lowers each call in a group kernel's shared
// code to Apple's matrix units; this body is what the call means everywhere
// else (and what the CPU qualification compares against). The device adds
// products in an order the hardware chooses, so a device result is compared
// within a tolerance, never bit for bit. `coax cuda` refuses them.
//
// am_sg_mma_64x32x32 and am_sg_spill_64x32 run on simdgroup matrices in a
// group of 128 threads. acc is a matrix accumulator: 64 rows by 32 columns,
// acc[r*32+c], held by the four simdgroups as 8x8 tiles; only these
// primitives may use it. a (64 rows of 32 k, a[r*32+k]) and b (32 columns
// of 32 k, b[c*32+k]) are threadgroup arrays.
//
// am_matmul_bf16 runs on the Metal 4 tensor ops (MetalPerformancePrimitives
// matmul2d), which use the GPU's neural accelerators where it has them:
// a tile of tm tokens by tn rows of out = x w^T, read straight from device
// views. w holds BF16 pairs (rows by cols/2 u32, low half first), x and out
// are f32 (tokens by cols, tokens by rows).
//
// Checks: coax test coax/lib/compute/apple.coax --library (no main of its own).
#authority;

am_bf16 :: (word:u32,high:bool)->f32 #effects(all) {
    if high {return f32_from_bits((word>>16)<<16);}
    return f32_from_bits(word<<16);
}

// acc[r][c] += sum over k of a[r][k] b[c][k]: the 32 products add in f64 and
// round once into acc.
am_sg_mma_64x32x32 :: (acc:[]f32,a:[]f32,b:[]f32) #effects(all) {
    for ar:0..<64 {
        for ac:0..<32 {
            sum:f64=0;
            for ak:0..<32 {sum+=f64(a[ar*32+ak])*f64(b[ac*32+ak]);}
            acc[ar*32+ac]=f32(f64(acc[ar*32+ac])+sum);
        }
    }
}
// dst = acc, elementwise (the device stores each simdgroup's tiles).
am_sg_spill_64x32 :: (acc:[]f32,dst:[]f32) #effects(all) {
    for ai:0..<2048 {dst[ai]=acc[ai];}
}
// acc = 0, elementwise (the device zeroes each simdgroup's 8x8 tiles).
am_sg_zero_64x32 :: (acc:[]f32) #effects(all) {
    for ai:0..<2048 {acc[ai]=0.0f32;}
}
// FP16-operand simdgroup MMA (acc += a * b^T, a:[2048]u16, b:[1024]u16 held as IEEE 754 binary16).
am_sg_mma_f16_64x32x32 :: (acc:[]f32,a:[]u16,b:[]u16) #effects(all) {
    for ar:0..<64 {
        for ac:0..<32 {
            sum:=0.0f64;
            for ak:0..<32 {sum+=f64(am_f16(cast(u32)a[ar*32+ak]))*f64(am_f16(cast(u32)b[ac*32+ak]));}
            acc[ar*32+ac]=f32(f64(acc[ar*32+ac])+sum);
        }
    }
}

// out[t*rows+r] = sum over k of x[t*cols+k] W[r][k] for t0 <= t < min(t0+tm,
// tokens) and r0 <= r < min(r0+tn, rows). Products of a BF16 weight and an
// f32 activation add in f64 and round once. threads (64, 128 or 256) is the
// group the device spreads the tile over.
am_matmul_valid :: (rows:int,cols:int,tokens:int,r0:int,t0:int,w:int,x:int,out:int)->bool #effects(all) {
    if rows<1 || cols<2 || cols%2!=0 || tokens<1 || r0<0 || r0>=rows || t0<0 || t0>=tokens {return false;}
    if rows>2147483647/cols || tokens>2147483647/cols || tokens>2147483647/rows {return false;}
    return w>=rows*(cols/2) && x>=tokens*cols && out>=tokens*rows;
}
// The tile shapes the device compiles: 64, 128 or 256 threads, 16, 32 or 64
// tokens by 32, 64 or 128 rows (CU_apple_tile admits the same).
am_tile_valid :: (threads:int,tm:int,tn:int)->bool #effects(all) {
    return (threads==64 || threads==128 || threads==256) && (tm==16 || tm==32 || tm==64) && (tn==32 || tn==64 || tn==128);
}
am_matmul_bf16 :: (threads:int,tm:int,tn:int,rows:int,cols:int,tokens:int,r0:int,t0:int,w:[]u32,x:[]f32,out:[]f32) #effects(all) {
    #assert am_matmul_valid(rows,cols,tokens,r0,t0,w.count,x.count,out.count);
    #assert am_tile_valid(threads,tm,tn);
    half:=cols/2;
    for at:t0..<t0+tm {
        if at>=tokens {break;}
        for ar:r0..<r0+tn {
            if ar>=rows {break;}
            sum:f64=0;
            for ap:0..<half {
                word:=w[ar*half+ap];
                sum+=f64(x[at*cols+2*ap])*f64(am_bf16(word,false))+f64(x[at*cols+2*ap+1])*f64(am_bf16(word,true));
            }
            out[at*rows+ar]=f32(sum);
        }
    }
}
am_matmul_bf16_x16 :: (threads:int,tm:int,tn:int,rows:int,cols:int,tokens:int,r0:int,t0:int,w:[]u32,x:[]u16,out:[]f32) #effects(all) {
    #assert am_matmul_valid(rows,cols,tokens,r0,t0,w.count,x.count,out.count);
    #assert am_tile_valid(threads,tm,tn);
    half:=cols/2;
    for at:t0..<t0+tm {
        if at>=tokens {break;}
        for ar:r0..<r0+tn {
            if ar>=rows {break;}
            sum:f64=0;
            for ap:0..<half {
                word:=w[ar*half+ap];
                sum+=f64(am_bf16_u16(x[at*cols+2*ap]))*f64(am_bf16(word,false))+f64(am_bf16_u16(x[at*cols+2*ap+1]))*f64(am_bf16(word,true));
            }
            out[at*rows+ar]=f32(sum);
        }
    }
}
am_iq4_lut :: (q:u32)->f32 #effects(all) {
    t:=[16]f32.[-127.0f32,-104.0f32,-83.0f32,-65.0f32,-49.0f32,-35.0f32,-22.0f32,-10.0f32,1.0f32,13.0f32,25.0f32,38.0f32,53.0f32,69.0f32,89.0f32,113.0f32];
    return t[cast(int)(q&15)];
}
am_f16 :: (h:u32)->f32 #effects(all) {
    sign:=ifx (h&0x8000)!=0 then -1.0f32 else 1.0f32;
    ex:=cast(int)((h>>10)&31);
    mant:=cast(f32)(h&1023);
    if ex==0 {return sign*(mant/1024.0f32)*(1.0f32/16384.0f32);}
    if ex==31 {return 0.0f32;}
    v:=1.0f32+mant/1024.0f32;
    e:=ex-15;
    for _:0..<e {v*=2.0f32;}
    for _:0..<-e {v*=0.5f32;}
    return sign*v;
}
am_simd_sum :: (x:f32)->f32 #effects(all) { return x; }
am_simd_max :: (x:f32)->f32 #effects(all) { return x; }
am_to_f16 :: (x:f32)->u16 #effects(all) {
    b:=f32_bits(x);
    sign:=(b>>16)&0x8000;
    ex:=cast(int)((b>>23)&255)-127;
    m:=b&0x7fffff;
    if ex>15 {return cast(u16)(sign|0x7bff);}
    if ex<-14 {return cast(u16)sign;}
    return cast(u16)(sign|(cast(u32)(ex+15)<<10)|(m>>13));
}

am_dot_iq4_lane :: (w:[]u16,base:int,x:[]f32,x_off:int,blocks:int)->f32 #effects(all) {
    sum:f32=0.0f32;
    for b:0..<blocks {
        at:=base+b*9;
        sc:=am_f16(cast(u32)w[at]);
        xb:=x_off+b*32;
        s:f32=0.0f32;
        for k:0..<8 {
            v:=cast(u32)w[at+1+k];
            s+=am_iq4_lut(v&15)*x[xb+2*k]+am_iq4_lut((v>>4)&15)*x[xb+16+2*k]+am_iq4_lut((v>>8)&15)*x[xb+2*k+1]+am_iq4_lut((v>>12)&15)*x[xb+16+2*k+1];
        }
        sum+=sc*s;
    }
    return sum;
}

am_dot_q4_lane :: (w:[]u16,base:int,x:[]f32,x_off:int,blocks:int)->f32 #effects(all) {
    sum:f32=0.0f32;
    for b:0..<blocks {
        at:=base+b*9;
        sc:=am_f16(cast(u32)w[at]);
        xb:=x_off+b*32;
        s:f32=0.0f32;
        for k:0..<8 {
            v:=cast(u32)w[at+1+k];
            s+=(f32(v&15)-8.0f32)*x[xb+2*k]+(f32((v>>4)&15)-8.0f32)*x[xb+16+2*k]+(f32((v>>8)&15)-8.0f32)*x[xb+2*k+1]+(f32((v>>12)&15)-8.0f32)*x[xb+16+2*k+1];
        }
        sum+=sc*s;
    }
    return sum;
}

am_tanh :: (x:f32)->f32 #effects(all) {
    if x>=0.0f32 { // mutant: equivalent (at x==0 both branches evaluate exp(0)=1 and return 0.0f32)
        e:=exp(-2.0f32*x);
        return (1.0f32-e)/(1.0f32+e);
    }
    e:=exp(2.0f32*x);
    return (e-1.0f32)/(e+1.0f32);
}

am_situ_act :: (g:f32,u:f32,beta:f32,lb:f32)->f32 #effects(all) {
    t:=am_tanh(g/beta);
    sig:=1.0f32/(1.0f32+exp(-g));
    act:=beta*t*sig;
    uv:=ifx lb>0.0f32 then lb*am_tanh(u/lb) else u;
    return act*uv;
}

am_dot_iq4_situ_lane :: (w:[]u16,gb:int,ub:int,x:[]f32,x_off:int,blocks:int,beta:f32,lb:f32)->f32 #effects(all) {
    g:=am_dot_iq4_lane(w,gb,x,x_off,blocks);
    u:=am_dot_iq4_lane(w,ub,x,x_off,blocks);
    return am_situ_act(g,u,beta,lb);
}

am_dot_q4_situ_lane :: (w:[]u16,gb:int,ub:int,x:[]f32,x_off:int,blocks:int,beta:f32,lb:f32)->f32 #effects(all) {
    g:=am_dot_q4_lane(w,gb,x,x_off,blocks);
    u:=am_dot_q4_lane(w,ub,x,x_off,blocks);
    return am_situ_act(g,u,beta,lb);
}

am_dot_iq4_moe_lane :: (w:[]u16,ids:[]u32,wts:[]f32,x:[]f32,exp_words:int,row_off:int,cols:int,n_used:int)->f32 #effects(all) {
    blocks:=cols/32;
    sum:f32=0.0f32;
    for slot:0..<n_used {
        eid:=cast(int)ids[slot];
        sum+=wts[slot]*am_dot_iq4_lane(w,eid*exp_words+row_off,x,slot*cols,blocks);
    }
    return sum;
}

am_dot_q4_moe_lane :: (w:[]u16,ids:[]u32,wts:[]f32,x:[]f32,exp_words:int,row_off:int,cols:int,n_used:int)->f32 #effects(all) {
    blocks:=cols/32;
    sum:f32=0.0f32;
    for slot:0..<n_used {
        eid:=cast(int)ids[slot];
        sum+=wts[slot]*am_dot_q4_lane(w,eid*exp_words+row_off,x,slot*cols,blocks);
    }
    return sum;
}

am_dot_f16_lane :: (w:[]u16,base:int,x:[]f32,x_off:int,cols:int)->f32 #effects(all) {
    sum:f32=0.0f32;
    for c:0..<cols {
        sum+=am_f16(cast(u32)w[base+c])*x[x_off+c];
    }
    return sum;
}

am_dot_q4_2_write :: (w:[]u16,b0:int,b1:int,x:[]f32,x_off:int,blocks:int,out:[]f32,r0:int,r1:int) #effects(all) {
    out[r0]=am_dot_q4_lane(w,b0,x,x_off,blocks);
    out[r1]=am_dot_q4_lane(w,b1,x,x_off,blocks);
}

am_dot_iq4_situ_2_write :: (w:[]u16,gb0:int,ub0:int,gb1:int,ub1:int,x:[]f32,x_off:int,blocks:int,beta:f32,lb:f32,out:[]f32,o0:int,o1:int) #effects(all) {
    out[o0]=am_dot_iq4_situ_lane(w,gb0,ub0,x,x_off,blocks,beta,lb);
    out[o1]=am_dot_iq4_situ_lane(w,gb1,ub1,x,x_off,blocks,beta,lb);
}

am_dot_iq4_moe_2_write :: (w:[]u16,ids:[]u32,wts:[]f32,x:[]f32,exp_words:int,r0_off:int,r1_off:int,cols:int,n_used:int,add:int,out:[]f32,o0:int,o1:int) #effects(all) {
    v0:=am_dot_iq4_moe_lane(w,ids,wts,x,exp_words,r0_off,cols,n_used);
    v1:=am_dot_iq4_moe_lane(w,ids,wts,x,exp_words,r1_off,cols,n_used);
    if add!=0 {out[o0]=out[o0]+v0;out[o1]=out[o1]+v1;} else {out[o0]=v0;out[o1]=v1;}
}

am_iq4_tile_valid :: (threads:int,tm:int,tn:int)->bool #effects(all) {
    if tm==128 || tm==256 {return am_tile_valid(threads,64,tn);}
    return am_tile_valid(threads,tm,tn);
}
am_matmul_iq4_valid :: (rows:int,cols:int,tokens:int,r0:int,t0:int,tn:int,w:int,x:int,out:int,tg:int)->bool #effects(all) {
    if cols<64 || cols%64!=0 || r0<0 || r0>=rows || t0<0 || t0>=tokens || tg<tn*64 {return false;}
    return w>=rows*((cols/32)*9) && x>=tokens*cols && out>=tokens*rows;
}
am_matmul_iq4 :: (threads:int,tm:int,tn:int,rows:int,cols:int,tokens:int,r0:int,t0:int,w:[]u16,x:[]f32,out:[]f32,tg:[]u16) #effects(all) {
    #assert am_matmul_iq4_valid(rows,cols,tokens,r0,t0,tn,w.count,x.count,out.count,tg.count);
    #assert am_iq4_tile_valid(threads,tm,tn);
    blocks:=cols/32;
    row_words:=blocks*9;
    for at:t0..<t0+tm {
        if at>=tokens {break;}
        for ar:r0..<r0+tn {
            if ar>=rows {break;}
            sum:f64=0;
            for b:0..<blocks {
                base:=ar*row_words+b*9;
                sc:=f64(am_f16(cast(u32)w[base]));
                for k:0..<8 {
                    v:=cast(u32)w[base+1+k];
                    k2:=b*32+2*k;
                    sum+=sc*f64(am_iq4_lut(v&15))*f64(x[at*cols+k2]);
                    sum+=sc*f64(am_iq4_lut((v>>4)&15))*f64(x[at*cols+k2+16]);
                    sum+=sc*f64(am_iq4_lut((v>>8)&15))*f64(x[at*cols+k2+1]);
                    sum+=sc*f64(am_iq4_lut((v>>12)&15))*f64(x[at*cols+k2+17]);
                }
            }
            out[at*rows+ar]=f32(sum);
        }
    }
}
am_bf16_u16 :: (bits:u16)->f32 #effects(all) { return f32_from_bits(cast(u32)bits<<16); }
am_matmul_iq4_bf16 :: (threads:int,tm:int,tn:int,rows:int,cols:int,tokens:int,r0:int,t0:int,w:[]u16,x:[]u16,out:[]f32,tg:[]u16) #effects(all) {
    #assert am_matmul_iq4_valid(rows,cols,tokens,r0,t0,tn,w.count,x.count,out.count,tg.count);
    #assert am_iq4_tile_valid(threads,tm,tn);
    blocks:=cols/32;
    row_words:=blocks*9;
    for at:t0..<t0+tm {
        if at>=tokens {break;}
        for ar:r0..<r0+tn {
            if ar>=rows {break;}
            sum:f64=0;
            for b:0..<blocks {
                base:=ar*row_words+b*9;
                sc:=f64(am_f16(cast(u32)w[base]));
                for k:0..<8 {
                    v:=cast(u32)w[base+1+k];
                    k2:=b*32+2*k;
                    sum+=sc*f64(am_iq4_lut(v&15))*f64(am_bf16_u16(x[at*cols+k2]));
                    sum+=sc*f64(am_iq4_lut((v>>4)&15))*f64(am_bf16_u16(x[at*cols+k2+16]));
                    sum+=sc*f64(am_iq4_lut((v>>8)&15))*f64(am_bf16_u16(x[at*cols+k2+1]));
                    sum+=sc*f64(am_iq4_lut((v>>12)&15))*f64(am_bf16_u16(x[at*cols+k2+17]));
                }
            }
            out[at*rows+ar]=f32(sum);
        }
    }
}

#test "BF16 halves decode exactly" {
    #assert am_bf16(0x40003f80,false)==1 && am_bf16(0x40003f80,true)==2 && am_bf16(0xc0400000,true)==-3;
    #assert am_simd_sum(3.5f32)==3.5f32 && am_simd_sum(-1.25f32)==-1.25f32;
    #assert am_simd_max(3.5f32)==3.5f32 && am_simd_max(-1.25f32)==-1.25f32;
    #assert am_to_f16(1.0f32)==0x3c00 && am_to_f16(-2.0f32)==0xc000 && am_to_f16(0.0f32)==0 && am_to_f16(100000.0f32)==0x7bff;
    #assert am_to_f16(1.0009765625f32)==0x3c01 && am_to_f16(1.0078125f32)==0x3c08 && am_to_f16(-1.5f32)==0xbe00 && am_to_f16(32768.0f32)==0x7800;
    #assert am_to_f16(0.00006103515625f32)==0x0400 && am_to_f16(0.000030517578125f32)==0 && am_to_f16(-0.000030517578125f32)==0x8000;
    #assert am_iq4_tile_valid(128,128,64) && am_iq4_tile_valid(128,256,64) && am_iq4_tile_valid(128,64,64);
    #assert !am_iq4_tile_valid(128,129,64) && !am_iq4_tile_valid(128,257,64) && !am_iq4_tile_valid(128,128,65);
    wq:[36]u16;xq:[64]f32;
    wq[0]=0x3c00;wq[9]=0x4000;wq[18]=0x3800;wq[27]=0x3c00;
    for k:0..<8 {
        wq[1+k]=cast(u16)(0x9a8b+k);
        wq[10+k]=cast(u16)(0x7654+k);
        wq[19+k]=cast(u16)(0xa987+k);
        wq[28+k]=cast(u16)(0x89ab+k);
    }
    for i:0..<64 {xq[i]=f32((i+1)*(i+1))*0.01f32;}
    // Compute exact reference sums for 2 blocks at base=0, x_off=0
    exp_iq4:f32=0.0f32;exp_q4:f32=0.0f32;
    for b:0..<2 {
        sc:=am_f16(cast(u32)wq[b*9]);
        si:f32=0.0f32;sq:f32=0.0f32;
        for k:0..<8 {
            v:=cast(u32)wq[b*9+1+k];
            xb:=b*32;
            n0:=v&15;n1:=(v>>4)&15;n2:=(v>>8)&15;n3:=(v>>12)&15;
            si+=am_iq4_lut(n0)*xq[xb+2*k]+am_iq4_lut(n1)*xq[xb+16+2*k]+am_iq4_lut(n2)*xq[xb+2*k+1]+am_iq4_lut(n3)*xq[xb+16+2*k+1];
            sq+=(f32(n0)-8.0f32)*xq[xb+2*k]+(f32(n1)-8.0f32)*xq[xb+16+2*k]+(f32(n2)-8.0f32)*xq[xb+2*k+1]+(f32(n3)-8.0f32)*xq[xb+16+2*k+1];
        }
        exp_iq4+=sc*si;exp_q4+=sc*sq;
    }
    di:=am_dot_iq4_lane(wq[..],0,xq[..],0,2);
    dq:=am_dot_q4_lane(wq[..],0,xq[..],0,2);
    #assert abs(di-exp_iq4)<0.001f32 && abs(dq-exp_q4)<0.001f32;
    #assert am_dot_iq4_lane(wq[..],0,xq[..],0,0)==0.0f32 && am_dot_q4_lane(wq[..],0,xq[..],0,0)==0.0f32;
    // Exact am_tanh & am_situ_act checks (positive, zero, negative)
    #assert abs(am_tanh(0.0f32))<0.0001f32;
    #assert abs(am_tanh(1.0f32)-0.761594f32)<0.001f32 && abs(am_tanh(-1.0f32)+0.761594f32)<0.001f32;
    #assert abs(am_situ_act(1.5f32,2.0f32,3.0f32,0.0f32)-2.2759f32)<0.01f32;
    #assert abs(am_situ_act(1.5f32,4.0f32,3.0f32,2.0f32)-2.1941f32)<0.01f32;
    #assert abs(am_situ_act(-1.5f32,2.0f32,3.0f32,0.0f32)+0.5078f32)<0.01f32;
    // Exact situ_lane checks
    g_i:=am_dot_iq4_lane(wq[..],0,xq[..],0,1);u_i:=am_dot_iq4_lane(wq[..],9,xq[..],0,1);
    #assert abs(am_dot_iq4_situ_lane(wq[..],0,9,xq[..],0,1,3.0f32,2.0f32)-am_situ_act(g_i,u_i,3.0f32,2.0f32))<0.001f32;
    g_q:=am_dot_q4_lane(wq[..],0,xq[..],0,1);u_q:=am_dot_q4_lane(wq[..],9,xq[..],0,1);
    #assert abs(am_dot_q4_situ_lane(wq[..],0,9,xq[..],0,1,3.0f32,2.0f32)-am_situ_act(g_q,u_q,3.0f32,2.0f32))<0.001f32;
    // Exact moe_lane checks with non-zero row_off=9 and 2 experts
    mids:[2]u32;mwts:[2]f32;
    mids[0]=0;mids[1]=1;mwts[0]=0.5f32;mwts[1]=0.25f32;
    exp_mi:=0.5f32*am_dot_iq4_lane(wq[..],9,xq[..],0,1)+0.25f32*am_dot_iq4_lane(wq[..],27,xq[..],32,1);
    exp_mq:=0.5f32*am_dot_q4_lane(wq[..],9,xq[..],0,1)+0.25f32*am_dot_q4_lane(wq[..],27,xq[..],32,1);
    #assert abs(am_dot_iq4_moe_lane(wq[..],mids[..],mwts[..],xq[..],18,9,32,2)-exp_mi)<0.001f32;
    #assert abs(am_dot_q4_moe_lane(wq[..],mids[..],mwts[..],xq[..],18,9,32,2)-exp_mq)<0.001f32;
    #assert am_dot_iq4_moe_lane(wq[..],mids[..],mwts[..],xq[..],18,9,32,0)==0.0f32;
    #assert am_dot_q4_moe_lane(wq[..],mids[..],mwts[..],xq[..],18,9,32,0)==0.0f32;
    wf:[8]u16;
    wf[0]=0x3c00;wf[1]=0x4000;wf[2]=0xbc00;wf[3]=0x3800;wf[4]=0x4200;wf[5]=0x3c00;wf[6]=0x4000;wf[7]=0xbc00;
    exp_f16:=1.0f32*xq[4]+2.0f32*xq[5]-1.0f32*xq[6]+0.5f32*xq[7];
    #assert abs(am_dot_f16_lane(wf[..],0,xq[..],4,4)-exp_f16)<0.0001f32;
    #assert am_dot_f16_lane(wf[..],4,xq[..],0,0)==0.0f32;
    // 2-row-per-warp write helpers
    out2:[4]f32;out2[0]=99.0f32;out2[1]=99.0f32;out2[2]=99.0f32;out2[3]=99.0f32;
    am_dot_q4_2_write(wq[..],0,9,xq[..],0,1,out2[..],0,1);
    #assert abs(out2[0]-g_q)<0.0001f32 && abs(out2[1]-u_q)<0.0001f32;
    am_dot_iq4_situ_2_write(wq[..],0,9,9,0,xq[..],0,1,3.0f32,2.0f32,out2[..],2,3);
    #assert abs(out2[2]-am_dot_iq4_situ_lane(wq[..],0,9,xq[..],0,1,3.0f32,2.0f32))<0.0001f32;
    #assert abs(out2[3]-am_dot_iq4_situ_lane(wq[..],9,0,xq[..],0,1,3.0f32,2.0f32))<0.0001f32;
    out2[0]=1.0f32;out2[1]=2.0f32;
    am_dot_iq4_moe_2_write(wq[..],mids[..],mwts[..],xq[..],18,0,9,32,2,0,out2[..],0,1);
    exp_m0:=am_dot_iq4_moe_lane(wq[..],mids[..],mwts[..],xq[..],18,0,32,2);
    #assert abs(out2[0]-exp_m0)<0.0001f32 && abs(out2[1]-exp_mi)<0.0001f32;
    am_dot_iq4_moe_2_write(wq[..],mids[..],mwts[..],xq[..],18,0,9,32,2,1,out2[..],0,1);
    #assert abs(out2[0]-2.0f32*exp_m0)<0.0001f32 && abs(out2[1]-2.0f32*exp_mi)<0.0001f32;
}
#test "am_matmul_iq4 decodes IQ4_NL weights and multiplies" {
    exp_lut:=[16]f32.[-127.0f32,-104.0f32,-83.0f32,-65.0f32,-49.0f32,-35.0f32,-22.0f32,-10.0f32,1.0f32,13.0f32,25.0f32,38.0f32,53.0f32,69.0f32,89.0f32,113.0f32];
    for q:0..<16 {#assert am_iq4_lut(cast(u32)q)==exp_lut[q];}
    #assert am_iq4_lut(16)==-127.0f32;
    #assert am_f16(0x3c00)==1.0f32 && am_f16(0xbc00)==-1.0f32 && am_f16(0x0000)==0.0f32 && am_f16(0x0400)==(1.0f32/16384.0f32);
    #assert am_f16(0x0200)==(0.5f32/16384.0f32) && am_f16(0x4400)==4.0f32 && am_f16(0x3600)==0.375f32 && am_f16(0x7c00)==0.0f32 && am_f16(0x3c01)>1.0f32;
    #assert am_matmul_iq4_valid(1,64,1,0,0,64,18,64,1,4096) && !am_matmul_iq4_valid(3,64,3,0,0,64,54,192,8,4096);
    #assert am_matmul_iq4_valid(2,64,2,0,0,64,36,128,4,4096);
    #assert !am_matmul_iq4_valid(0,64,2,0,0,64,36,128,4,4096) && !am_matmul_iq4_valid(2,32,2,0,0,64,36,128,4,4096) && !am_matmul_iq4_valid(2,96,2,0,0,64,72,192,4,4096);
    #assert !am_matmul_iq4_valid(2,64,0,0,0,64,36,128,4,4096) && !am_matmul_iq4_valid(2,64,2,-1,0,64,36,128,4,4096) && !am_matmul_iq4_valid(2,64,2,2,0,64,36,128,4,4096);
    #assert !am_matmul_iq4_valid(2,64,2,0,-1,64,36,128,4,4096) && !am_matmul_iq4_valid(2,64,2,0,2,64,36,128,4,4096) && !am_matmul_iq4_valid(2,64,2,0,0,64,36,128,4,4095);
    #assert !am_matmul_iq4_valid(2,64,2,0,0,64,35,128,4,4096) && !am_matmul_iq4_valid(2,64,2,0,0,64,36,127,4,4096) && !am_matmul_iq4_valid(2,64,2,0,0,64,36,128,3,4096);
    w:[72]u16;x:[256]f32;out:[4]f32;tg:[4096]u16;
    for r:0..<2 {
        for b:0..<4 {
            base:=(r*4+b)*9;
            w[base]=ifx r==0 then 0x3c00 else 0x4000;
            for k:0..<8 {w[base+1+k]=0x9888;}
        }
    }
    for t:0..<2 {for i:0..<128 {x[t*128+i]=f32((t+1)*(i+1));}}
    am_matmul_iq4(128,16,64,2,128,2,0,0,w[..],x[..],out[..],tg[..]);
    #assert out[0]>0 && out[1]==out[0]*2.0f32 && out[2]==out[0]*2.0f32 && out[3]==out[0]*4.0f32;
    #assert out[0]==f32(128*129/2 + 12*(4*(18+20+22+24+26+28+30+32) + 8*(0+32+64+96)));
    #assert am_bf16_u16(0x3f80)==1.0f32 && am_bf16_u16(0xc000)==-2.0f32;
    xb:[256]u16;outb:[4]f32;
    for i:0..<256 {xb[i]=cast(u16)(f32_bits(x[i])>>16);}
    am_matmul_iq4_bf16(128,16,64,2,128,2,0,0,w[..],xb[..],outb[..],tg[..]);
    #assert outb[0]==out[0] && outb[1]==out[1] && outb[2]==out[2] && outb[3]==out[3];
    wb:[4]u32;x2:[8]u16;o2:[4]f32;
    wb[0]=0x40003f80;wb[1]=0x40804040;wb[2]=0x3f804040;wb[3]=0x40004080;
    x2[0]=0x3f80;x2[1]=0x4000;x2[2]=0x4040;x2[3]=0x4080;
    x2[4]=0x4000;x2[5]=0x3f80;x2[6]=0x4080;x2[7]=0x4040;
    am_matmul_bf16_x16(128,16,32,2,4,2,0,0,wb[..],x2[..],o2[..]);
    #assert o2[0]==30.0f32 && o2[1]==25.0f32 && o2[2]==28.0f32 && o2[3]==29.0f32;
}
#test "the simdgroup tile adds a b^T into acc" {
    acc:[2048]f32;a:[2048]f32;b:[1024]f32;out:[2048]f32;
    for ar:0..<64 {for ak:0..<32 {a[ar*32+ak]=f32((ar+2*ak)%5-2);}}
    for ac:0..<32 {for ak:0..<32 {b[ac*32+ak]=f32((3*ak+ac)%7-3);}}
    for ai:0..<2048 {acc[ai]=f32(ai%3);}
    am_sg_mma_64x32x32(acc[..],a[..],b[..]);
    am_sg_mma_64x32x32(acc[..],a[..],b[..]);
    am_sg_spill_64x32(acc[..],out[..]);
    for ar:0..<64 {for ac:0..<32 {
        sum:=0;for ak:0..<32 {sum+=((ar+2*ak)%5-2)*((3*ak+ac)%7-3);}
        #assert out[ar*32+ac]==f32(2*sum+(ar*32+ac)%3) && acc[ar*32+ac]==out[ar*32+ac];
    }}
    am_sg_zero_64x32(acc[..]);
    for ai:0..<2048 {#assert acc[ai]==0.0f32;}
    ah:[2048]u16;bh:[1024]u16;
    for ar:0..<64 {for ak:0..<32 {ah[ar*32+ak]=am_to_f16(f32((ar+ak)%3-1));}}
    for ac:0..<32 {for ak:0..<32 {bh[ac*32+ak]=am_to_f16(f32((ac+ak)%3-1));}}
    am_sg_mma_f16_64x32x32(acc[..],ah[..],bh[..]);
    #assert acc[0]==f32(21) && acc[3*32+5]==f32(-11);
}
#test "the 32 products are added before rounding into acc" {
    acc:[2048]f32;a:[2048]f32;b:[1024]f32;
    for ai:0..<2048 {acc[ai]=1;a[ai]=f32_from_bits(0x33800000);}
    for ai:0..<1024 {b[ai]=1;}
    am_sg_mma_64x32x32(acc[..],a[..],b[..]);
    for ai:0..<2048 {#assert acc[ai]==1+32*f32_from_bits(0x33800000);}
}
#test "the tensor-op tile writes its tokens and rows, clipped to the matrix" {
    // 3 rows by 4 columns, 5 tokens: a 16 by 32 tile at (r0 1, t0 2), clipped.
    w:[6]u32;x:[20]f32;out:[15]f32;
    for ar:0..<3 {for ap:0..<2 {w[ar*2+ap]=(f32_bits(f32(ar+ap))>>16)|((f32_bits(f32(ar-ap))>>16)<<16);}}
    for at:0..<5 {for ac:0..<4 {x[at*4+ac]=f32(at*ac+1);}}
    for ai:0..<15 {out[ai]=-7;}
    am_matmul_bf16(128,16,32,3,4,5,1,2,w[..],x[..],out[..]);
    for at:0..<5 {for ar:0..<3 {
        expected:f32=-7;
        if at>=2 && ar>=1 {
            sum:=0.0;for ap:0..<2 {sum+=f64(x[at*4+2*ap])*f64(ar+ap)+f64(x[at*4+2*ap+1])*f64(ar-ap);}
            expected=f32(sum);
        }
        #assert out[at*3+ar]==expected;
    }}
}
#test "the tensor-op tile rounds once" {
    // 1, then sixteen times 2^-24: the sixteen ulps survive only if added first.
    w:[9]u32;x:[18]f32;out:[1]f32;
    for ap:0..<9 {w[ap]=0x3f803f80;}
    for ac:2..<18 {x[ac]=f32_from_bits(0x33800000);}
    x[0]=1;x[1]=0;
    am_matmul_bf16(64,16,32,1,18,1,0,0,w[..],x[..],out[..]);
    #assert out[0]==1+16*f32_from_bits(0x33800000);
}
#forall "the tensor-op tile checks its shape and views" rows:0..<3, cols:0..<4, tokens:0..<3, r0:-1..<3, t0:-1..<3 {
    w:=rows*(cols/2);x:=tokens*cols;out:=tokens*rows;
    expected:=rows>=1 && cols>=2 && cols%2==0 && tokens>=1 && r0>=0 && r0<rows && t0>=0 && t0<tokens;
    #assert am_matmul_valid(rows,cols,tokens,r0,t0,w,x,out)==expected;
    if expected {
        #assert !am_matmul_valid(rows,cols,tokens,r0,t0,w-1,x,out) && !am_matmul_valid(rows,cols,tokens,r0,t0,w,x-1,out) && !am_matmul_valid(rows,cols,tokens,r0,t0,w,x,out-1);
    }
}
#test "the tensor-op tile refuses shapes past 32-bit extents" {
    #assert !am_matmul_valid(2147483647,2,1,0,0,2147483647,2,2147483647) && !am_matmul_valid(1,2,2147483647,0,0,1,4294967294,2147483647);
    #assert !am_matmul_valid(65536,65536,1,0,0,2147483648,65536,65536) && am_matmul_valid(1,2,1,0,0,1,2,1);
}
#test "the tensor-op tile admits every extent up to 2^31-1 exactly" {
    big:=4294967296;
    // rows*cols, tokens*cols, tokens*rows each at the limit, then one past it.
    #assert am_matmul_valid(1073741823,2,1,0,0,big,big,big) && !am_matmul_valid(1073741824,2,1,0,0,big,big,big);
    #assert am_matmul_valid(1,2,1073741823,0,0,big,big,big) && !am_matmul_valid(1,2,1073741824,0,0,big,big,big);
    #assert am_matmul_valid(4,2,536870911,0,0,big,big,big) && !am_matmul_valid(4,2,536870912,0,0,big,big,big);
}
#forall "tensor-op tiles are 64, 128 or 256 threads, 16, 32 or 64 tokens by 32, 64 or 128 rows" a:0..<9, b:0..<9, c:0..<9 {
    near:=[9]int.[15,16,32,33,63,64,65,128,256];
    threads:=near[a]+(a/8);tm:=near[b];tn:=near[c]; // a 8: 257
    expected:=(threads==64 || threads==128 || threads==256) && (tm==16 || tm==32 || tm==64) && (tn==32 || tn==64 || tn==128);
    #assert am_tile_valid(threads,tm,tn)==expected;
    #assert am_tile_valid(256,64,128) && am_tile_valid(128,16,32) && !am_tile_valid(129,16,32) && !am_tile_valid(128,17,32) && !am_tile_valid(128,16,129);
}
