// Apple matrix primitives of the Metal compute subset, with their CPU
// meaning. `coax metal-compute` lowers each call in a group kernel's shared
// code to Apple's matrix units; this body is what the call means everywhere
// else (and what the CPU qualification compares against). The device adds
// products in an order the hardware chooses, so a device result is compared
// within a tolerance, never bit for bit. `coax cuda` refuses them.
//
// am_sg_mma_64x32x32 and am_sg_spill_64x32 run on simdgroup matrices in a
// group of 128 threads. acc is a matrix accumulator: 64 rows by 32 columns,
// acc[r*32+c], held by the four simdgroups as 8x8 tiles; only these
// primitives may use it. a (64 rows of 32 k, a[r*32+k]) and b (32 columns
// of 32 k, b[c*32+k]) are threadgroup arrays.
//
// am_matmul_bf16 runs on the Metal 4 tensor ops (MetalPerformancePrimitives
// matmul2d), which use the GPU's neural accelerators where it has them:
// a tile of tm tokens by tn rows of out = x w^T, read straight from device
// views. w holds BF16 pairs (rows by cols/2 u32, low half first), x and out
// are f32 (tokens by cols, tokens by rows).
//
// Checks: coax test coax/lib/compute/apple.coax --library (no main of its own).
#authority;

am_bf16 :: (word:u32,high:bool)->f32 #effects(all) {
    if high {return f32_from_bits((word>>16)<<16);}
    return f32_from_bits(word<<16);
}

// acc[r][c] += sum over k of a[r][k] b[c][k]: the 32 products add in f64 and
// round once into acc.
am_sg_mma_64x32x32 :: (acc:[]f32,a:[]f32,b:[]f32) #effects(all) {
    for ar:0..<64 {
        for ac:0..<32 {
            sum:f64=0;
            for ak:0..<32 {sum+=f64(a[ar*32+ak])*f64(b[ac*32+ak]);}
            acc[ar*32+ac]=f32(f64(acc[ar*32+ac])+sum);
        }
    }
}
// dst = acc, elementwise (the device stores each simdgroup's tiles).
am_sg_spill_64x32 :: (acc:[]f32,dst:[]f32) #effects(all) {
    for ai:0..<2048 {dst[ai]=acc[ai];}
}
// acc = 0, elementwise (the device zeroes each simdgroup's 8x8 tiles).
am_sg_zero_64x32 :: (acc:[]f32) #effects(all) {
    for ai:0..<2048 {acc[ai]=0.0f32;}
}
// FP16-operand simdgroup MMA (acc += a * b^T, a:[2048]u16, b:[1024]u16 held as IEEE 754 binary16).
am_sg_mma_f16_64x32x32 :: (acc:[]f32,a:[]u16,b:[]u16) #effects(all) {
    for ar:0..<64 {
        for ac:0..<32 {
            sum:=0.0f64;
            for ak:0..<32 {sum+=f64(am_f16(cast(u32)a[ar*32+ak]))*f64(am_f16(cast(u32)b[ac*32+ak]));}
            acc[ar*32+ac]=f32(f64(acc[ar*32+ac])+sum);
        }
    }
}

// out[t*rows+r] = sum over k of x[t*cols+k] W[r][k] for t0 <= t < min(t0+tm,
// tokens) and r0 <= r < min(r0+tn, rows). Products of a BF16 weight and an
// f32 activation add in f64 and round once. threads (64, 128 or 256) is the
// group the device spreads the tile over.
am_matmul_valid :: (rows:int,cols:int,tokens:int,r0:int,t0:int,w:int,x:int,out:int)->bool #effects(all) {
    if rows<1 || cols<2 || cols%2!=0 || tokens<1 || r0<0 || r0>=rows || t0<0 || t0>=tokens {return false;}
    if rows>2147483647/cols || tokens>2147483647/cols || tokens>2147483647/rows {return false;}
    return w>=rows*(cols/2) && x>=tokens*cols && out>=tokens*rows;
}
// The tile shapes the device compiles: 64, 128 or 256 threads, 16, 32 or 64
// tokens by 32, 64 or 128 rows (CU_apple_tile admits the same).
am_tile_valid :: (threads:int,tm:int,tn:int)->bool #effects(all) {
    return (threads==64 || threads==128 || threads==256) && (tm==16 || tm==32 || tm==64) && (tn==32 || tn==64 || tn==128);
}
am_matmul_bf16 :: (threads:int,tm:int,tn:int,rows:int,cols:int,tokens:int,r0:int,t0:int,w:[]u32,x:[]f32,out:[]f32) #effects(all) {
    #assert am_matmul_valid(rows,cols,tokens,r0,t0,w.count,x.count,out.count);
    #assert am_tile_valid(threads,tm,tn);
    half:=cols/2;
    for at:t0..<t0+tm {
        if at>=tokens {break;}
        for ar:r0..<r0+tn {
            if ar>=rows {break;}
            sum:f64=0;
            for ap:0..<half {
                word:=w[ar*half+ap];
                sum+=f64(x[at*cols+2*ap])*f64(am_bf16(word,false))+f64(x[at*cols+2*ap+1])*f64(am_bf16(word,true));
            }
            out[at*rows+ar]=f32(sum);
        }
    }
}
am_matmul_bf16_x16 :: (threads:int,tm:int,tn:int,rows:int,cols:int,tokens:int,r0:int,t0:int,w:[]u32,x:[]u16,out:[]f32) #effects(all) {
    #assert am_matmul_valid(rows,cols,tokens,r0,t0,w.count,x.count,out.count);
    #assert am_tile_valid(threads,tm,tn);
    half:=cols/2;
    for at:t0..<t0+tm {
        if at>=tokens {break;}
        for ar:r0..<r0+tn {
            if ar>=rows {break;}
            sum:f64=0;
            for ap:0..<half {
                word:=w[ar*half+ap];
                sum+=f64(am_bf16_u16(x[at*cols+2*ap]))*f64(am_bf16(word,false))+f64(am_bf16_u16(x[at*cols+2*ap+1]))*f64(am_bf16(word,true));
            }
            out[at*rows+ar]=f32(sum);
        }
    }
}
am_iq4_lut :: (q:u32)->f32 #effects(all) {
    t:=[16]f32.[-127.0f32,-104.0f32,-83.0f32,-65.0f32,-49.0f32,-35.0f32,-22.0f32,-10.0f32,1.0f32,13.0f32,25.0f32,38.0f32,53.0f32,69.0f32,89.0f32,113.0f32];
    return t[cast(int)(q&15)];
}
am_f16 :: (h:u32)->f32 #effects(all) {
    sign:=ifx (h&0x8000)!=0 then -1.0f32 else 1.0f32;
    ex:=cast(int)((h>>10)&31);
    mant:=cast(f32)(h&1023);
    if ex==0 {return sign*(mant/1024.0f32)*(1.0f32/16384.0f32);}
    if ex==31 {return 0.0f32;}
    v:=1.0f32+mant/1024.0f32;
    e:=ex-15;
    for _:0..<e {v*=2.0f32;}
    for _:0..<-e {v*=0.5f32;}
    return sign*v;
}
am_simd_sum :: (x:f32)->f32 #effects(all) { return x; }
am_simd_max :: (x:f32)->f32 #effects(all) { return x; }
am_to_f16 :: (x:f32)->u16 #effects(all) {
    b:=f32_bits(x);
    sign:=(b>>16)&0x8000;
    ex:=cast(int)((b>>23)&255)-127;
    m:=b&0x7fffff;
    if ex>15 {return cast(u16)(sign|0x7bff);}
    if ex<-14 {return cast(u16)sign;}
    return cast(u16)(sign|(cast(u32)(ex+15)<<10)|(m>>13));
}

am_dot_iq4_lane :: (w:[]u16,base:int,x:[]f32,x_off:int,blocks:int)->f32 #effects(all) {
    sum:f32=0.0f32;
    for b:0..<blocks {
        at:=base+b*9;
        sc:=am_f16(cast(u32)w[at]);
        xb:=x_off+b*32;
        s:f32=0.0f32;
        for k:0..<8 {
            v:=cast(u32)w[at+1+k];
            s+=am_iq4_lut(v&15)*x[xb+2*k]+am_iq4_lut((v>>4)&15)*x[xb+16+2*k]+am_iq4_lut((v>>8)&15)*x[xb+2*k+1]+am_iq4_lut((v>>12)&15)*x[xb+16+2*k+1];
        }
        sum+=sc*s;
    }
    return sum;
}

am_dot_q4_lane :: (w:[]u16,base:int,x:[]f32,x_off:int,blocks:int)->f32 #effects(all) {
    sum:f32=0.0f32;
    for b:0..<blocks {
        at:=base+b*9;
        sc:=am_f16(cast(u32)w[at]);
        xb:=x_off+b*32;
        s:f32=0.0f32;
        for k:0..<8 {
            v:=cast(u32)w[at+1+k];
            s+=(f32(v&15)-8.0f32)*x[xb+2*k]+(f32((v>>4)&15)-8.0f32)*x[xb+16+2*k]+(f32((v>>8)&15)-8.0f32)*x[xb+2*k+1]+(f32((v>>12)&15)-8.0f32)*x[xb+16+2*k+1];
        }
        sum+=sc*s;
    }
    return sum;
}

am_tanh :: (x:f32)->f32 #effects(all) {
    if x>=0.0f32 { // mutant: equivalent (at x==0 both branches evaluate exp(0)=1 and return 0.0f32)
        e:=exp(-2.0f32*x);
        return (1.0f32-e)/(1.0f32+e);
    }
    e:=exp(2.0f32*x);
    return (e-1.0f32)/(e+1.0f32);
}

am_situ_act :: (g:f32,u:f32,beta:f32,lb:f32)->f32 #effects(all) {
    t:=am_tanh(g/beta);
    sig:=1.0f32/(1.0f32+exp(-g));
    act:=beta*t*sig;
    uv:=ifx lb>0.0f32 then lb*am_tanh(u/lb) else u;
    return act*uv;
}

am_dot_iq4_situ_lane :: (w:[]u16,gb:int,ub:int,x:[]f32,x_off:int,blocks:int,beta:f32,lb:f32)->f32 #effects(all) {
    g:=am_dot_iq4_lane(w,gb,x,x_off,blocks);
    u:=am_dot_iq4_lane(w,ub,x,x_off,blocks);
    return am_situ_act(g,u,beta,lb);
}

am_dot_q4_situ_lane :: (w:[]u16,gb:int,ub:int,x:[]f32,x_off:int,blocks:int,beta:f32,lb:f32)->f32 #effects(all) {
    g:=am_dot_q4_lane(w,gb,x,x_off,blocks);
    u:=am_dot_q4_lane(w,ub,x,x_off,blocks);
    return am_situ_act(g,u,beta,lb);
}

am_dot_iq4_moe_lane :: (w:[]u16,ids:[]u32,wts:[]f32,x:[]f32,exp_words:int,row_off:int,cols:int,n_used:int)->f32 #effects(all) {
    blocks:=cols/32;
    sum:f32=0.0f32;
    for slot:0..<n_used {
        eid:=cast(int)ids[slot];
        sum+=wts[slot]*am_dot_iq4_lane(w,eid*exp_words+row_off,x,slot*cols,blocks);
    }
    return sum;
}

am_dot_q4_moe_lane :: (w:[]u16,ids:[]u32,wts:[]f32,x:[]f32,exp_words:int,row_off:int,cols:int,n_used:int)->f32 #effects(all) {
    blocks:=cols/32;
    sum:f32=0.0f32;
    for slot:0..<n_used {
        eid:=cast(int)ids[slot];
        sum+=wts[slot]*am_dot_q4_lane(w,eid*exp_words+row_off,x,slot*cols,blocks);
    }
    return sum;
}

am_dot_f16_lane :: (w:[]u16,base:int,x:[]f32,x_off:int,cols:int)->f32 #effects(all) {
    sum:f32=0.0f32;
    for c:0..<cols {
        sum+=am_f16(cast(u32)w[base+c])*x[x_off+c];
    }
    return sum;
}

am_dot_q4_2_write :: (w:[]u16,b0:int,b1:int,x:[]f32,x_off:int,blocks:int,out:[]f32,r0:int,r1:int) #effects(all) {
    out[r0]=am_dot_q4_lane(w,b0,x,x_off,blocks);
    out[r1]=am_dot_q4_lane(w,b1,x,x_off,blocks);
}

am_dot_iq4_situ_2_write :: (w:[]u16,gb0:int,ub0:int,gb1:int,ub1:int,x:[]f32,x_off:int,blocks:int,beta:f32,lb:f32,out:[]f32,o0:int,o1:int) #effects(all) {
    out[o0]=am_dot_iq4_situ_lane(w,gb0,ub0,x,x_off,blocks,beta,lb);
    out[o1]=am_dot_iq4_situ_lane(w,gb1,ub1,x,x_off,blocks,beta,lb);
}

am_dot_iq4_moe_2_write :: (w:[]u16,ids:[]u32,wts:[]f32,x:[]f32,exp_words:int,r0_off:int,r1_off:int,cols:int,n_used:int,add:int,out:[]f32,o0:int,o1:int) #effects(all) {
    v0:=am_dot_iq4_moe_lane(w,ids,wts,x,exp_words,r0_off,cols,n_used);
    v1:=am_dot_iq4_moe_lane(w,ids,wts,x,exp_words,r1_off,cols,n_used);
    if add!=0 {out[o0]=out[o0]+v0;out[o1]=out[o1]+v1;} else {out[o0]=v0;out[o1]=v1;}
}

am_dot_f16_tg_write :: (w:[]u16,base:int,x:[]f32,x_off:int,cols:int,add:int,eps:f32,out:[]f32,out_idx:int) #effects(all) {
    dot:=am_dot_f16_lane(w,base,x,x_off,cols);
    if eps>0.0f32 {
        ss:f32=0.0f32;
        for c:0..<cols {v:=x[x_off+c];ss+=v*v;}
        dot=dot/sqrt(ss/f32(cols)+eps);
    }
    if add!=0 {out[out_idx]=out[out_idx]+dot;} else {out[out_idx]=dot;}
}

am_rmsnorm_f32 :: (dim:int,has_w:int,eps:f32,x:[]f32,x_off:int,w:[]f32,w_off:int,out:[]f32,o_off:int) #effects(all) {
    ss:f32=0.0f32;
    for i:0..<dim {v:=x[x_off+i];ss+=v*v;}
    inv:=1.0f32/sqrt(ss/f32(dim)+eps);
    for i:0..<dim {
        v:=x[x_off+i]*inv;
        out[o_off+i]=ifx has_w!=0 then v*w[w_off+i] else v;
    }
}

am_ctrl_up_apply_f16 :: (dim:int,rank:int,row0:int,w_gain:[]u16,wg_off:int,w_forget:[]u16,wf_off:int,gate:[]f32,g_off:int,cur:[]f32,c_off:int,msg:[]f32,m_off:int,out:[]f32,o_off:int) #effects(all) {
    for t:0..<64 {
        row:=row0+t;
        if row<dim {
            sg:f32=0.0f32;sf:f32=0.0f32;
            for k:0..<rank {
                gv:=gate[g_off+k];
                idx:=k*dim+row;
                sg+=am_f16(cast(u32)w_gain[wg_off+idx])*gv;
                sf+=am_f16(cast(u32)w_forget[wf_off+idx])*gv;
            }
            c:=cur[c_off+row];m:=msg[m_off+row];
            out[o_off+row]=c-am_tanh(sf)*c+am_tanh(sg)*m;
        }
    }
}

am_mix_fused :: (mode:int,dim:int,n_blocks:int,eps:f32,blocks_buf:[]f32,cur:[]f32,query:[]f32,q_off:int,aux:[]f32,aux_off:int,out0:[]f32,o0_off:int,out1:[]f32,o1_off:int) #effects(all) {
    n_states:=n_blocks+1;
    inv_sqrt_d:=1.0f32/sqrt(f32(dim));
    sc:[32]f32;iv:[32]f32;wt:[32]f32;
    for s:0..<n_states {
        ss:f32=0.0f32;dot:f32=0.0f32;
        for i:0..<dim {
            v:=ifx s<n_blocks then blocks_buf[s*dim+i] else cur[i];
            ss+=v*v;dot+=v*query[q_off+i];
        }
        iv[s]=1.0f32/sqrt(ss/f32(dim)+0.000001f32);
        sc[s]=dot*iv[s]*inv_sqrt_d;
    }
    mx:=sc[0];
    for s:1..<n_states {if sc[s]>mx {mx=sc[s];}} // mutant: equivalent (at sc[s]==mx assigning mx=sc[s] leaves mx unchanged)
    esum:f32=0.0f32;
    for s:0..<n_states {wt[s]=exp(sc[s]-mx);esum+=wt[s];}
    inv_e:=1.0f32/esum;
    for s:0..<n_states {wt[s]=wt[s]*inv_e*iv[s];}
    s1:f32=0.0f32;s2:f32=0.0f32;
    for i:0..<dim {
        acc:f32=0.0f32;
        for s:0..<n_states {
            v:=ifx s<n_blocks then blocks_buf[s*dim+i] else cur[i];
            acc+=wt[s]*v;
        }
        out0[o0_off+i]=acc;
        s1+=acc*acc;
        if mode==2 {mv:=aux[aux_off+i];s2+=mv*mv;}
    }
    if mode==1 {
        inv:=1.0f32/sqrt(s1/f32(dim)+eps);
        for i:0..<dim {out0[o0_off+i]=out0[o0_off+i]*inv*aux[aux_off+i];}
    } else if mode==2 {
        inv1:=1.0f32/sqrt(s1/f32(dim)+0.000001f32);
        inv2:=1.0f32/sqrt(s2/f32(dim)+0.000001f32);
        for i:0..<dim {
            out1[o1_off+i]=out0[o0_off+i]*inv1;
            out1[o1_off+dim+i]=aux[aux_off+i]*inv2;
        }
    }
}

am_router_top8 :: (n_exp:int,n_used:int,has_bias:int,scale:f32,logits:[]f32,bias:[]f32,out_ids:[]u32,out_wts:[]f32) #effects(all) {
    probs:[256]f32;scores:[256]f32;
    for e:0..<n_exp {
        p:=1.0f32/(1.0f32+exp(-logits[e]));
        probs[e]=p;
        scores[e]=ifx has_bias!=0 then p+bias[e] else p;
    }
    wsum:f32=0.0f32;
    for k:0..<n_used {
        best:=0;
        for e:1..<n_exp {if scores[e]>scores[best] {best=e;}}
        out_ids[k]=cast(u32)best;
        out_wts[k]=probs[best];
        wsum+=probs[best];
        scores[best]=-3.0e38f32;
    }
    if wsum<0.00006103515625f32 {wsum=0.00006103515625f32;} // mutant: equivalent (at exact floor assigning floor leaves wsum unchanged)
    fac:=scale/wsum;
    for k:0..<n_used {out_wts[k]=out_wts[k]*fac;}
}

am_conv_kv_chan :: (h:int,n_head_kv:int,n_kv_elem:int,pos:int,slot_pos:int,is_v:int,has_dyn:int,threshold:f32,eps:f32,raw:[]f32,w:[]f32,dyn:[]f32,hist:[]f32,cache:[]u16) #effects(all) {
    base:=h*128;dbase:=slot_pos*n_kv_elem+base;
    inv_s:=ifx has_dyn!=0 then 0.3333333333333333f32 else 0.4472135954999579f32;
    db:=(is_v*n_head_kv+h)*4;
    s0:=(pos+1)%4;s1:=(pos+2)%4;s2:=(pos+3)%4;sw:=pos%4;
    tmp:[128]f32;
    tot:f32=0.0f32;
    for j:0..<128 {
        c:=base+j;
        x0:=hist[c*4+s0];x1:=hist[c*4+s1];x2:=hist[c*4+s2];x3:=raw[c];
        hist[c*4+sw]=x3;
        acc:=x0*w[c*4]+x1*w[c*4+1]+x2*w[c*4+2]+x3*w[c*4+3];
        if has_dyn!=0 {acc+=dyn[db]*x3+dyn[db+1]*x2+dyn[db+2]*x1+dyn[db+3]*x0;}
        v:=(x3+acc)*inv_s;
        tmp[j]=v;tot+=v*v;
    }
    if is_v==0 {
        fac:=threshold/(sqrt(tot)+0.000001f32);
        if fac>1.0f32 {fac=1.0f32;} // mutant: equivalent (at fac==1 assigning 1 leaves fac unchanged)
        for j:0..<128 {cache[dbase+j]=am_to_f16(tmp[j]*fac);}
    } else {
        inv:=1.0f32/sqrt(tot/128.0f32+eps);
        for j:0..<128 {cache[dbase+j]=am_to_f16(tmp[j]*inv);}
    }
}

am_conv_kv_both :: (item:int,n_head_kv:int,n_kv_elem:int,pos:int,slot_pos:int,has_dyn:int,threshold:f32,eps:f32,k_raw:[]f32,v_raw:[]f32,kw:[]f32,vw:[]f32,dyn:[]f32,k_hist:[]f32,v_hist:[]f32,k_cache:[]u16,v_cache:[]u16) #effects(all) {
    is_v:=item/n_head_kv;h:=item%n_head_kv;
    if is_v==0 {am_conv_kv_chan(h,n_head_kv,n_kv_elem,pos,slot_pos,0,has_dyn,threshold,eps,k_raw,kw,dyn,k_hist,k_cache);}
    else {am_conv_kv_chan(h,n_head_kv,n_kv_elem,pos,slot_pos,1,has_dyn,threshold,eps,v_raw,vw,dyn,v_hist,v_cache);}
}

am_attn_gqa_1pass :: (h:int,dims0:u32,dims1:u32,kv_info:u32,pos:int,qk_clip:f32,rel_clip:f32,q_tau:f32,q:[]f32,q_scale:[]f32,r:[]f32,r_scale:[]f32,rel_bias:[]f32,sinks:[]f32,gate:[]f32,k_cache:[]u16,v_cache:[]u16,out:[]f32) #effects(all) {
    n_head_kv:=cast(int)((dims0>>8)&255);head_dim:=cast(int)((dims0>>16)&255);n_rel:=cast(int)((dims0>>24)&255);
    extent:=cast(int)(dims1&65535);is_swa:=cast(int)((dims1>>16)&1);swa:=cast(int)((dims1>>17)&32767);
    kv_cap:=cast(int)(kv_info&65535);has_qs:=cast(int)((kv_info>>16)&1);has_rs:=cast(int)((kv_info>>17)&1);
    kv_h:=h/3;n_kv_elem:=n_head_kv*head_dim;scale:=1.0f32/sqrt(f32(head_dim));sk:=sinks[h];
    start:=ifx is_swa!=0 && pos>=swa then pos-swa+1 else 0;
    n_keys:=pos-start+1;
    qc:[128]f32;rc:[32]f32;acc:[128]f32;
    qn:f32=0.0f32;rn:f32=0.0f32;
    for j:0..<head_dim {v:=q[h*head_dim+j];if has_qs!=0 {v=v*q_scale[h*head_dim+j];}qc[j]=v;qn+=v*v;}
    qf:=qk_clip/(sqrt(qn)+0.000001f32);
    if qf>1.0f32 {qf=1.0f32;} // mutant: equivalent (at qf==1 assigning 1 leaves qf unchanged)
    qf=qf*q_tau;
    for j:0..<head_dim {qc[j]=qc[j]*qf;}
    for j:0..<n_rel {v:=r[h*n_rel+j];if has_rs!=0 {v=v*r_scale[h*n_rel+j];}rc[j]=v;rn+=v*v;}
    rf:=rel_clip/(sqrt(rn)+0.000001f32);
    if rf>1.0f32 {rf=1.0f32;} // mutant: equivalent (at rf==1 assigning 1 leaves rf unchanged)
    rf=rf*q_tau;
    for j:0..<n_rel {rc[j]=rc[j]*rf;}
    m:f32=0.0f32;l:f32=1.0f32;
    for ki:0..<n_keys {
        kp:=start+ki;slot:=ifx is_swa!=0 then kp%kv_cap else kp;kb:=slot*n_kv_elem+kv_h*head_dim;
        dot:f32=0.0f32;for j:0..<head_dim {dot+=qc[j]*am_f16(cast(u32)k_cache[kb+j]);}
        dist:=pos-kp;rb:f32=0.0f32;
        if dist<extent {for j:0..<n_rel {rb+=rel_bias[dist*n_rel+j]*rc[j];}}
        sc:=dot*scale+rb-sk;
        nm:=ifx sc>m then sc else m; // mutant: equivalent (at sc==m both branches yield m)
        alpha:=exp(m-nm);wt:=exp(sc-nm);
        m=nm;l=l*alpha+wt;
        for j:0..<head_dim {acc[j]=acc[j]*alpha+wt*am_f16(cast(u32)v_cache[kb+j]);}
    }
    for j:0..<head_dim {out[h*head_dim+j]=(acc[j]/l)/(1.0f32+exp(-gate[h*head_dim+j]));}
}

am_kv_attn_gqa_1pass :: (h:int,dims0:u32,dims1:u32,kv_info:u32,pos:int,slot_pos:int,qk_clip:f32,rel_clip:f32,q_tau:f32,eps:f32,k_raw:[]f32,v_raw:[]f32,kw:[]f32,vw:[]f32,dyn:[]f32,k_hist:[]f32,v_hist:[]f32,q:[]f32,q_scale:[]f32,r:[]f32,r_scale:[]f32,rel_bias:[]f32,sinks:[]f32,gate:[]f32,k_cache:[]u16,v_cache:[]u16,out:[]f32) #effects(all) {
    n_head_kv:=cast(int)((dims0>>8)&255);
    has_dyn:=cast(int)((kv_info>>18)&1);
    n_kv_elem:=n_head_kv*128;
    kv_h:=h/3;
    if h%3==0 {
        am_conv_kv_both(kv_h,n_head_kv,n_kv_elem,pos,slot_pos,has_dyn,qk_clip,eps,k_raw,v_raw,kw,vw,dyn,k_hist,v_hist,k_cache,v_cache);
        am_conv_kv_both(n_head_kv+kv_h,n_head_kv,n_kv_elem,pos,slot_pos,has_dyn,qk_clip,eps,k_raw,v_raw,kw,vw,dyn,k_hist,v_hist,k_cache,v_cache);
    }
    am_attn_gqa_1pass(h,dims0,dims1,kv_info,pos,qk_clip,rel_clip,q_tau,q,q_scale,r,r_scale,rel_bias,sinks,gate,k_cache,v_cache,out);
}

am_post_conv_step :: (v:f32,r:int,cw:[]f32,hist:[]f32)->f32 #effects(all) {
    x0:=hist[r*3];x1:=hist[r*3+1];x2:=hist[r*3+2];
    hist[r*3]=x1;hist[r*3+1]=x2;hist[r*3+2]=v;
    return (v+x0*cw[r*4]+x1*cw[r*4+1]+x2*cw[r*4+2]+v*cw[r*4+3])*0.4472135954999579f32;
}

am_dot_q4_conv_2_write :: (w:[]u16,b0:int,b1:int,x:[]f32,blocks:int,add_res:int,cw:[]f32,hist:[]f32,res:[]f32,out:[]f32,r0:int,r1:int) #effects(all) {
    a0:=am_post_conv_step(am_dot_q4_lane(w,b0,x,0,blocks),r0,cw,hist);
    out[r0]=ifx add_res!=0 then res[r0]+a0 else a0;
    if r1!=r0 {
        a1:=am_post_conv_step(am_dot_q4_lane(w,b1,x,0,blocks),r1,cw,hist);
        out[r1]=ifx add_res!=0 then res[r1]+a1 else a1;
    }
}

am_moe_gu_iq4_tg :: (slot:int,row0:int,n_ff:int,cols:int,n_exp:int,n_used:int,has_bias:int,r_scale:f32,beta:f32,lb:f32,n_parts:int,eps:f32,w:[]u16,x:[]f32,parts:[]f32,logits:[]f32,bias:[]f32,ids:[]u32,wts:[]f32,out:[]f32) #effects(all) {
    tids:[16]u32;twts:[16]f32;
    am_router_top8(n_exp,n_used,has_bias,r_scale,logits,bias,tids[..],twts[..]);
    if slot==0 && row0==0 {for k:0..<n_used {ids[k]=tids[k];wts[k]=twts[k];}}
    inv:f32=1.0f32;
    if n_parts>0 {
        ss:f32=0.0f32;
        for i:0..<n_parts {ss+=parts[i];}
        inv=1.0f32/sqrt(ss/f32(cols)+eps);
    }
    blocks:=cols/32;rw:=blocks*9;eb:=cast(int)tids[slot]*2*n_ff*rw;
    for dr:0..<8 {
        r:=row0+dr;
        if r<n_ff {
            gb:=eb+r*rw;
            g:=am_dot_iq4_lane(w,gb,x,0,blocks)*inv;
            u:=am_dot_iq4_lane(w,gb+n_ff*rw,x,0,blocks)*inv;
            out[slot*n_ff+r]=am_situ_act(g,u,beta,lb);
        }
    }
}

am_moe_gu_q4_tg :: (slot:int,row0:int,n_ff:int,cols:int,n_exp:int,n_used:int,has_bias:int,r_scale:f32,beta:f32,lb:f32,n_parts:int,eps:f32,w:[]u16,x:[]f32,parts:[]f32,logits:[]f32,bias:[]f32,ids:[]u32,wts:[]f32,out:[]f32) #effects(all) {
    tids:[16]u32;twts:[16]f32;
    am_router_top8(n_exp,n_used,has_bias,r_scale,logits,bias,tids[..],twts[..]);
    if slot==0 && row0==0 {for k:0..<n_used {ids[k]=tids[k];wts[k]=twts[k];}}
    inv:f32=1.0f32;
    if n_parts>0 {
        ss:f32=0.0f32;
        for i:0..<n_parts {ss+=parts[i];}
        inv=1.0f32/sqrt(ss/f32(cols)+eps);
    }
    blocks:=cols/32;rw:=blocks*9;eb:=cast(int)tids[slot]*2*n_ff*rw;
    for dr:0..<8 {
        r:=row0+dr;
        if r<n_ff {
            gb:=eb+r*rw;
            g:=am_dot_q4_lane(w,gb,x,0,blocks)*inv;
            u:=am_dot_q4_lane(w,gb+n_ff*rw,x,0,blocks)*inv;
            out[slot*n_ff+r]=am_situ_act(g,u,beta,lb);
        }
    }
}

am_moe_down_iq4_tg :: (row0:int,rows:int,cols:int,n_used:int,w:[]u16,x:[]f32,ids:[]u32,wts:[]f32,cw:[]f32,hist:[]f32,res:[]f32,out:[]f32) #effects(all) {
    rw:=(cols/32)*9;ew:=rows*rw;
    for dr:0..<8 {
        r:=row0+dr;
        if r<rows {
            out[r]=res[r]+am_post_conv_step(am_dot_iq4_moe_lane(w,ids,wts,x,ew,r*rw,cols,n_used),r,cw,hist);
        }
    }
}

am_moe_down_q4_tg :: (row0:int,rows:int,cols:int,n_used:int,w:[]u16,x:[]f32,ids:[]u32,wts:[]f32,cw:[]f32,hist:[]f32,res:[]f32,out:[]f32) #effects(all) {
    rw:=(cols/32)*9;ew:=rows*rw;
    for dr:0..<8 {
        r:=row0+dr;
        if r<rows {
            out[r]=res[r]+am_post_conv_step(am_dot_q4_moe_lane(w,ids,wts,x,ew,r*rw,cols,n_used),r,cw,hist);
        }
    }
}

am_dot_q4_qrgkv :: (row0:int,n_q:int,n_r:int,n_kv:int,cols:int,n_parts:int,eps:f32,w:[]u16,xq:[]f32,xk:[]f32,xv:[]f32,parts:[]f32,oq:[]f32,or_:[]f32,og:[]f32,ok:[]f32,ov:[]f32) #effects(all) {
    blocks:=cols/32;rw:=blocks*9;
    n_qr:=n_q+n_r;n_qrg:=n_qr+n_q;n_qrgk:=n_qrg+n_kv;tot:=n_qrgk+n_kv;
    inv_q:f32=1.0f32;inv_k:f32=1.0f32;inv_v:f32=1.0f32;
    if n_parts>0 {
        sq:f32=0.0f32;sk:f32=0.0f32;sv:f32=0.0f32;
        for i:0..<n_parts {sq+=parts[i];sk+=parts[n_parts+i];sv+=parts[2*n_parts+i];}
        inv_q=1.0f32/sqrt(sq/f32(cols)+eps);
        inv_k=1.0f32/sqrt(sk/f32(cols)+eps);
        inv_v=1.0f32/sqrt(sv/f32(cols)+eps);
    }
    for dr:0..<8 {
        r:=row0+dr;
        if r<n_q {oq[r]=am_dot_q4_lane(w,r*rw,xq,0,blocks)*inv_q;}
        else if r<n_qr {or_[r-n_q]=am_dot_q4_lane(w,r*rw,xq,0,blocks)*inv_q;}
        else if r<n_qrg {og[r-n_qr]=am_dot_q4_lane(w,r*rw,xq,0,blocks)*inv_q;}
        else if r<n_qrgk {ok[r-n_qrg]=am_dot_q4_lane(w,r*rw,xk,0,blocks)*inv_k;}
        else if r<tot {ov[r-n_qrgk]=am_dot_q4_lane(w,r*rw,xv,0,blocks)*inv_v;}
    }
}

am_ctrl_gf_row :: (dim:int,rank:int,row:int,w_gf:[]u32,w_off:int,gate:[]f32,g_off:int,cur:[]f32,c_off:int,msg:[]f32,m_off:int)->f32 #effects(all) {
    sg:f32=0.0f32;sf:f32=0.0f32;
    for k:0..<rank {
        gv:=gate[g_off+k];
        p:=w_gf[w_off+k*dim+row];
        sg+=am_f16(p&0xffff)*gv;
        sf+=am_f16(p>>16)*gv;
    }
    c:=cur[c_off+row];m:=msg[m_off+row];
    return c-am_tanh(sf)*c+am_tanh(sg)*m;
}

am_ctrl_up_apply_gf :: (dim:int,rank:int,row0:int,w_gf:[]u32,w_off:int,gate:[]f32,g_off:int,cur:[]f32,c_off:int,msg:[]f32,m_off:int,out:[]f32,o_off:int) #effects(all) {
    for t:0..<64 {
        row:=row0+t;
        if row<dim {out[o_off+row]=am_ctrl_gf_row(dim,rank,row,w_gf,w_off,gate,g_off,cur,c_off,msg,m_off);}
    }
}

am_ctrl_up_apply_gf_norm :: (dim:int,rank:int,row0:int,w_gf:[]u32,w_off:int,gate:[]f32,g_off:int,cur:[]f32,c_off:int,msg:[]f32,m_off:int,w_norm:[]f32,out:[]f32,o_off:int,rms_parts:[]f32,part_idx:int) #effects(all) {
    ss:f32=0.0f32;
    for t:0..<64 {
        row:=row0+t;
        if row<dim {
            v:=am_ctrl_gf_row(dim,rank,row,w_gf,w_off,gate,g_off,cur,c_off,msg,m_off);
            ss+=v*v;
            out[o_off+row]=v*w_norm[row];
        }
    }
    rms_parts[part_idx]=ss;
}

am_ctrl_gf_rm_row :: (rank:int,row:int,w_gf:[]u32,w_off:int,gate:[]f32,g_off:int,cur:[]f32,c_off:int,msg:[]f32,m_off:int)->f32 #effects(all) {
    sg:f32=0.0f32;sf:f32=0.0f32;
    rb:=w_off+row*rank;
    for k:0..<rank {
        gv:=gate[g_off+k];
        p:=w_gf[rb+k];
        sg+=am_f16(p&0xffff)*gv;
        sf+=am_f16(p>>16)*gv;
    }
    c:=cur[c_off+row];m:=msg[m_off+row];
    return c-am_tanh(sf)*c+am_tanh(sg)*m;
}

am_ctrl_up_apply_gf_rm_norm :: (dim:int,rank:int,row0:int,w_gf:[]u32,w_off:int,gate:[]f32,g_off:int,cur:[]f32,c_off:int,msg:[]f32,m_off:int,w_norm:[]f32,out:[]f32,o_off:int,rms_parts:[]f32,part_idx:int) #effects(all) {
    ss:f32=0.0f32;
    for t:0..<32 {
        row:=row0+t;
        if row<dim {
            v:=am_ctrl_gf_rm_row(rank,row,w_gf,w_off,gate,g_off,cur,c_off,msg,m_off);
            ss+=v*v;
            out[o_off+row]=v*w_norm[row];
        }
    }
    rms_parts[part_idx]=ss;
}

am_dot_q4_2_write_ex :: (w:[]u16,b0:int,b1:int,x:[]f32,x_off:int,blocks:int,parts:[]f32,p_off:int,n_parts:int,eps:f32,cap:f32,out:[]f32,r0:int,r1:int) #effects(all) {
    inv:f32=1.0f32;
    if n_parts>0 {
        ss:f32=0.0f32;
        for i:0..<n_parts {ss+=parts[p_off+i];}
        inv=1.0f32/sqrt(ss/f32(blocks*32)+eps);
    }
    v0:=am_dot_q4_lane(w,b0,x,x_off,blocks)*inv;
    v1:=am_dot_q4_lane(w,b1,x,x_off,blocks)*inv;
    if cap>0.0f32 {
        v0=cap*am_tanh(v0/cap);
        v1=cap*am_tanh(v1/cap);
    }
    out[r0]=v0;
    out[r1]=v1;
}

am_dot_f16_tg_write_rms :: (w:[]u16,base:int,x:[]f32,x_off:int,cols:int,parts:[]f32,p_off:int,n_parts:int,eps:f32,out:[]f32,out_idx:int) #effects(all) {
    inv:f32=1.0f32;
    if n_parts>0 {
        ss:f32=0.0f32;
        for i:0..<n_parts {ss+=parts[p_off+i];}
        inv=1.0f32/sqrt(ss/f32(cols)+eps);
    }
    out[out_idx]=am_dot_f16_lane(w,base,x,x_off,cols)*inv;
}

am_dot_q4s_lane :: (qs:[]u32,ds:[]u16,blk_base:int,x:[]f32,x_off:int,blocks:int)->f32 #effects(all) {
    sum:f32=0.0f32;
    for b:0..<blocks {
        sc:=am_f16(cast(u32)ds[blk_base+b]);
        qb:=(blk_base+b)*4;
        xb:=x_off+b*32;
        s:f32=0.0f32;
        for k:0..<4 {
            v:=qs[qb+k];
            for j:0..<4 {
                sh:=cast(u32)(j*8);
                s+=(f32((v>>sh)&15)-8.0f32)*x[xb+k*4+j]+(f32((v>>(sh+4))&15)-8.0f32)*x[xb+16+k*4+j];
            }
        }
        sum+=sc*s;
    }
    return sum;
}

am_dot_q4s_2_write_ex :: (qs:[]u32,ds:[]u16,b0:int,b1:int,x:[]f32,x_off:int,blocks:int,parts:[]f32,p_off:int,n_parts:int,eps:f32,cap:f32,out:[]f32,r0:int,r1:int) #effects(all) {
    inv:f32=1.0f32;
    if n_parts>0 {
        ss:f32=0.0f32;
        for i:0..<n_parts {ss+=parts[p_off+i];}
        inv=1.0f32/sqrt(ss/f32(blocks*32)+eps);
    }
    v0:=am_dot_q4s_lane(qs,ds,b0,x,x_off,blocks)*inv;
    v1:=am_dot_q4s_lane(qs,ds,b1,x,x_off,blocks)*inv;
    if cap>0.0f32 {
        v0=cap*am_tanh(v0/cap);
        v1=cap*am_tanh(v1/cap);
    }
    out[r0]=v0;
    if r1!=r0 {out[r1]=v1;}
}

am_dot_q4s_conv_2_write :: (qs:[]u32,ds:[]u16,b0:int,b1:int,x:[]f32,blocks:int,add_res:int,cw:[]f32,hist:[]f32,res:[]f32,out:[]f32,r0:int,r1:int) #effects(all) {
    a0:=am_post_conv_step(am_dot_q4s_lane(qs,ds,b0,x,0,blocks),r0,cw,hist);
    out[r0]=ifx add_res!=0 then res[r0]+a0 else a0;
    if r1!=r0 {
        a1:=am_post_conv_step(am_dot_q4s_lane(qs,ds,b1,x,0,blocks),r1,cw,hist);
        out[r1]=ifx add_res!=0 then res[r1]+a1 else a1;
    }
}

am_dot_q4s_1row_tg :: (qs:[]u32,ds:[]u16,blk_base:int,x:[]f32,x_off:int,blocks:int,parts:[]f32,p_off:int,n_parts:int,eps:f32,out:[]f32,out_idx:int) #effects(all) {
    inv:f32=1.0f32;
    if n_parts>0 {
        ss:f32=0.0f32;
        for i:0..<n_parts {ss+=parts[p_off+i];}
        inv=1.0f32/sqrt(ss/f32(blocks*32)+eps);
    }
    out[out_idx]=am_dot_q4s_lane(qs,ds,blk_base,x,x_off,blocks)*inv;
}

am_dot_q4s_qrgkv_sdyn :: (row0:int,dims0:u32,dims1:u32,dims2:u32,cols:int,eps:f32,qs:[]u32,ds:[]u16,xq:[]f32,xk:[]f32,xv:[]f32,parts:[]f32,oq:[]f32,or_:[]f32,og:[]f32,ok:[]f32,ov:[]f32,osinks:[]f32,odyn:[]f32) #effects(all) {
    n_q:=cast(int)(dims0&65535);n_r:=cast(int)((dims0>>16)&65535);
    n_kv:=cast(int)(dims1&65535);n_sinks:=cast(int)((dims1>>16)&65535);
    n_dyn:=cast(int)(dims2&65535);n_parts:=cast(int)((dims2>>16)&65535);
    blocks:=cols/32;
    e1:=n_q+n_r;e2:=e1+n_q;e3:=e2+n_kv;e4:=e3+n_kv;e5:=e4+n_sinks;e6:=e5+n_dyn;tot:=e6+n_dyn;
    inv_q:f32=1.0f32;inv_k:f32=1.0f32;inv_v:f32=1.0f32;
    if n_parts>0 {
        sq:f32=0.0f32;sk:f32=0.0f32;sv:f32=0.0f32;
        for i:0..<n_parts {sq+=parts[i];sk+=parts[n_parts+i];sv+=parts[2*n_parts+i];}
        inv_q=1.0f32/sqrt(sq/f32(cols)+eps);
        inv_k=1.0f32/sqrt(sk/f32(cols)+eps);
        inv_v=1.0f32/sqrt(sv/f32(cols)+eps);
    }
    for dr:0..<8 {
        r:=row0+dr;
        if r<n_q {oq[r]=am_dot_q4s_lane(qs,ds,r*blocks,xq,0,blocks)*inv_q;}
        else if r<e1 {or_[r-n_q]=am_dot_q4s_lane(qs,ds,r*blocks,xq,0,blocks)*inv_q;}
        else if r<e2 {og[r-e1]=am_dot_q4s_lane(qs,ds,r*blocks,xq,0,blocks)*inv_q;}
        else if r<e3 {ok[r-e2]=am_dot_q4s_lane(qs,ds,r*blocks,xk,0,blocks)*inv_k;}
        else if r<e4 {ov[r-e3]=am_dot_q4s_lane(qs,ds,r*blocks,xv,0,blocks)*inv_v;}
        else if r<e5 {osinks[r-e4]=am_dot_q4s_lane(qs,ds,r*blocks,xq,0,blocks)*inv_q;}
        else if r<e6 {odyn[r-e5]=am_dot_q4s_lane(qs,ds,r*blocks,xk,0,blocks)*inv_k;}
        else if r<tot {odyn[r-e5]=am_dot_q4s_lane(qs,ds,r*blocks,xv,0,blocks)*inv_v;}
    }
}

am_moe_gu_q4s_tg :: (slot:int,row0:int,n_ff:int,cols:int,n_exp:int,n_used:int,has_bias:int,r_scale:f32,beta:f32,lb:f32,n_parts:int,eps:f32,qs:[]u32,ds:[]u16,x:[]f32,parts:[]f32,logits:[]f32,bias:[]f32,ids:[]u32,wts:[]f32,out:[]f32) #effects(all) {
    tids:[16]u32;twts:[16]f32;
    am_router_top8(n_exp,n_used,has_bias,r_scale,logits,bias,tids[..],twts[..]);
    if slot==0 && row0==0 {for k:0..<n_used {ids[k]=tids[k];wts[k]=twts[k];}}
    inv:f32=1.0f32;
    if n_parts>0 {
        ss:f32=0.0f32;
        for i:0..<n_parts {ss+=parts[i];}
        inv=1.0f32/sqrt(ss/f32(cols)+eps);
    }
    blocks:=cols/32;eb:=cast(int)tids[slot]*2*n_ff*blocks;
    for dr:0..<8 {
        r:=row0+dr;
        if r<n_ff {
            gb:=eb+r*blocks;
            g:=am_dot_q4s_lane(qs,ds,gb,x,0,blocks)*inv;
            u:=am_dot_q4s_lane(qs,ds,gb+n_ff*blocks,x,0,blocks)*inv;
            out[slot*n_ff+r]=am_situ_act(g,u,beta,lb);
        }
    }
}

am_moe_down_q4s_tg :: (row0:int,rows:int,cols:int,n_used:int,qs:[]u32,ds:[]u16,x:[]f32,ids:[]u32,wts:[]f32,cw:[]f32,hist:[]f32,res:[]f32,out:[]f32) #effects(all) {
    blocks:=cols/32;ew:=rows*blocks;
    for dr:0..<8 {
        r:=row0+dr;
        if r<rows {
            acc:f32=0.0f32;
            for s:0..<n_used {
                acc+=wts[s]*am_dot_q4s_lane(qs,ds,cast(int)ids[s]*ew+r*blocks,x,s*cols,blocks);
            }
            out[r]=res[r]+am_post_conv_step(acc,r,cw,hist);
        }
    }
}

am_dot_iq4s_lane :: (qs:[]u32,ds:[]u16,blk_base:int,x:[]f32,x_off:int,blocks:int)->f32 #effects(all) {
    sum:f32=0.0f32;
    for b:0..<blocks {
        sc:=am_f16(cast(u32)ds[blk_base+b]);
        qb:=(blk_base+b)*4;
        xb:=x_off+b*32;
        s:f32=0.0f32;
        for k:0..<4 {
            v:=qs[qb+k];
            for j:0..<4 {
                sh:=cast(u32)(j*8);
                s+=am_iq4_lut((v>>sh)&15)*x[xb+k*4+j]+am_iq4_lut((v>>(sh+4))&15)*x[xb+16+k*4+j];
            }
        }
        sum+=sc*s;
    }
    return sum;
}

am_moe_gu_iq4s_tg :: (slot:int,row0:int,n_ff:int,cols:int,n_exp:int,n_used:int,has_bias:int,r_scale:f32,beta:f32,lb:f32,n_parts:int,eps:f32,qs:[]u32,ds:[]u16,x:[]f32,parts:[]f32,logits:[]f32,bias:[]f32,ids:[]u32,wts:[]f32,out:[]f32) #effects(all) {
    tids:[16]u32;twts:[16]f32;
    am_router_top8(n_exp,n_used,has_bias,r_scale,logits,bias,tids[..],twts[..]);
    if slot==0 && row0==0 {for k:0..<n_used {ids[k]=tids[k];wts[k]=twts[k];}}
    inv:f32=1.0f32;
    if n_parts>0 {
        ss:f32=0.0f32;
        for i:0..<n_parts {ss+=parts[i];}
        inv=1.0f32/sqrt(ss/f32(cols)+eps);
    }
    blocks:=cols/32;eb:=cast(int)tids[slot]*2*n_ff*blocks;
    for dr:0..<8 {
        r:=row0+dr;
        if r<n_ff {
            gb:=eb+r*blocks;
            g:=am_dot_iq4s_lane(qs,ds,gb,x,0,blocks)*inv;
            u:=am_dot_iq4s_lane(qs,ds,gb+n_ff*blocks,x,0,blocks)*inv;
            out[slot*n_ff+r]=am_situ_act(g,u,beta,lb);
        }
    }
}

am_moe_down_iq4s_tg :: (row0:int,rows:int,cols:int,n_used:int,qs:[]u32,ds:[]u16,x:[]f32,ids:[]u32,wts:[]f32,cw:[]f32,hist:[]f32,res:[]f32,out:[]f32) #effects(all) {
    blocks:=cols/32;ew:=rows*blocks;
    for dr:0..<8 {
        r:=row0+dr;
        if r<rows {
            acc:f32=0.0f32;
            for s:0..<n_used {
                acc+=wts[s]*am_dot_iq4s_lane(qs,ds,cast(int)ids[s]*ew+r*blocks,x,s*cols,blocks);
            }
            out[r]=res[r]+am_post_conv_step(acc,r,cw,hist);
        }
    }
}

am_dot_q4s_2_write_nb :: (qs:[]u32,ds:[]u16,b0:int,b1:int,x:[]f32,x_off:int,x_stride:int,blocks:int,nb:int,cap:f32,out:[]f32,out_off:int,out_stride:int,r0:int,r1:int) #effects(all) {
    for t:0..<nb {
        xo:=x_off+t*x_stride;
        v0:=am_dot_q4s_lane(qs,ds,b0,x,xo,blocks);
        v1:=am_dot_q4s_lane(qs,ds,b1,x,xo,blocks);
        if cap>0.0f32 {
            v0=cap*am_tanh(v0/cap);
            v1=cap*am_tanh(v1/cap);
        }
        oo:=out_off+t*out_stride;
        out[oo+r0]=v0;
        out[oo+r1]=v1;
    }
}

am_dot_q4s_qrgkv_sdyn_nb :: (row0:int,dims0:u32,dims1:u32,dims2:u32,cols:int,nb:int,eps:f32,qs:[]u32,ds:[]u16,xq:[]f32,xk:[]f32,xv:[]f32,parts:[]f32,oq:[]f32,or_:[]f32,og:[]f32,ok:[]f32,ov:[]f32,osinks:[]f32,odyn:[]f32) #effects(all) {
    n_q:=cast(int)(dims0&65535);n_r:=cast(int)((dims0>>16)&65535);
    n_kv:=cast(int)(dims1&65535);n_sinks:=cast(int)((dims1>>16)&65535);
    n_dyn:=cast(int)(dims2&65535);n_parts:=cast(int)((dims2>>16)&65535);
    blocks:=cols/32;
    e1:=n_q+n_r;e2:=e1+n_q;e3:=e2+n_kv;e4:=e3+n_kv;e5:=e4+n_sinks;e6:=e5+n_dyn;tot:=e6+n_dyn;
    for dr:0..<4 {
        r:=row0+dr;
        for t:0..<nb {
            inv_q:f32=1.0f32;inv_k:f32=1.0f32;inv_v:f32=1.0f32;
            if n_parts>0 {
                sq:f32=0.0f32;sk:f32=0.0f32;sv:f32=0.0f32;
                for i:0..<n_parts {
                    sq+=parts[t*n_parts+i];
                    sk+=parts[(nb+t)*n_parts+i];
                    sv+=parts[(2*nb+t)*n_parts+i];
                }
                inv_q=1.0f32/sqrt(sq/f32(cols)+eps);
                inv_k=1.0f32/sqrt(sk/f32(cols)+eps);
                inv_v=1.0f32/sqrt(sv/f32(cols)+eps);
            }
            xo:=t*cols;
            if r<n_q {oq[t*n_q+r]=am_dot_q4s_lane(qs,ds,r*blocks,xq,xo,blocks)*inv_q;}
            else if r<e1 {or_[t*n_r+(r-n_q)]=am_dot_q4s_lane(qs,ds,r*blocks,xq,xo,blocks)*inv_q;}
            else if r<e2 {og[t*n_q+(r-e1)]=am_dot_q4s_lane(qs,ds,r*blocks,xq,xo,blocks)*inv_q;}
            else if r<e3 {ok[t*n_kv+(r-e2)]=am_dot_q4s_lane(qs,ds,r*blocks,xk,xo,blocks)*inv_k;}
            else if r<e4 {ov[t*n_kv+(r-e3)]=am_dot_q4s_lane(qs,ds,r*blocks,xv,xo,blocks)*inv_v;}
            else if r<e5 {osinks[t*n_sinks+(r-e4)]=am_dot_q4s_lane(qs,ds,r*blocks,xq,xo,blocks)*inv_q;}
            else if r<e6 {odyn[t*(2*n_dyn)+(r-e5)]=am_dot_q4s_lane(qs,ds,r*blocks,xk,xo,blocks)*inv_k;}
            else if r<tot {odyn[t*(2*n_dyn)+(r-e5)]=am_dot_q4s_lane(qs,ds,r*blocks,xv,xo,blocks)*inv_v;}
        }
    }
}

am_kv_attn_gqa_1pass_nb :: (h:int,dims0:u32,dims1:u32,kv_info:u32,pos0:int,qk_clip:f32,rel_clip:f32,eps:f32,tau_buf:[]f32,k_raw:[]f32,v_raw:[]f32,kw:[]f32,vw:[]f32,dyn:[]f32,k_hist:[]f32,v_hist:[]f32,q:[]f32,q_scale:[]f32,r:[]f32,r_scale:[]f32,rel_bias:[]f32,sinks:[]f32,gate:[]f32,k_cache:[]u16,v_cache:[]u16,k_raw_log:[]f32,v_raw_log:[]f32,out:[]f32) #effects(all) {
    n_head:=cast(int)(dims0&255);n_head_kv:=cast(int)((dims0>>8)&255);n_rel:=cast(int)((dims0>>24)&255);
    is_swa:=cast(int)((dims1>>16)&1);
    kv_cap:=cast(int)(kv_info&65535);has_dyn:=cast(int)((kv_info>>18)&1);nb:=cast(int)((kv_info>>19)&15);
    n_q:=n_head*128;n_kv:=n_head_kv*128;n_hr:=n_head*n_rel;
    kv_h:=h/3;base:=kv_h*128;
    if h%3==0 {
        kh:[512]f32;vh:[512]f32;
        for i:0..<512 {kh[i]=k_hist[base*4+i];vh[i]=v_hist[base*4+i];}
        inv_s:=ifx has_dyn!=0 then 0.3333333333333333f32 else 0.4472135954999579f32;
        for t:0..<nb {
            p:=pos0+t;
            sp:=ifx is_swa!=0 then p%kv_cap else p;
            dbase:=sp*n_kv+base;
            s0:=(p+1)%4;s1:=(p+2)%4;s2:=(p+3)%4;sw:=p%4;
            dkb:=t*(2*n_head_kv*4)+kv_h*4;
            dvb:=t*(2*n_head_kv*4)+(n_head_kv+kv_h)*4;
            tk:[128]f32;tv:[128]f32;
            kn:f32=0.0f32;vn:f32=0.0f32;
            for j:0..<128 {
                c:=base+j;
                kx3:=k_raw[t*n_kv+c];vx3:=v_raw[t*n_kv+c];
                k_raw_log[t*n_kv+c]=kx3;v_raw_log[t*n_kv+c]=vx3;
                kx0:=kh[j*4+s0];kx1:=kh[j*4+s1];kx2:=kh[j*4+s2];kh[j*4+sw]=kx3;
                vx0:=vh[j*4+s0];vx1:=vh[j*4+s1];vx2:=vh[j*4+s2];vh[j*4+sw]=vx3;
                ka:=kx0*kw[c*4]+kx1*kw[c*4+1]+kx2*kw[c*4+2]+kx3*kw[c*4+3];
                va:=vx0*vw[c*4]+vx1*vw[c*4+1]+vx2*vw[c*4+2]+vx3*vw[c*4+3];
                if has_dyn!=0 {
                    ka+=dyn[dkb]*kx3+dyn[dkb+1]*kx2+dyn[dkb+2]*kx1+dyn[dkb+3]*kx0;
                    va+=dyn[dvb]*vx3+dyn[dvb+1]*vx2+dyn[dvb+2]*vx1+dyn[dvb+3]*vx0;
                }
                kvv:=(kx3+ka)*inv_s;vvv:=(vx3+va)*inv_s;
                tk[j]=kvv;kn+=kvv*kvv;tv[j]=vvv;vn+=vvv*vvv;
            }
            kfac:=qk_clip/(sqrt(kn)+0.000001f32);
            if kfac>1.0f32 {kfac=1.0f32;} // mutant: equivalent (at kfac==1 assigning 1 leaves kfac unchanged)
            vinv:=1.0f32/sqrt(vn/128.0f32+eps);
            for j:0..<128 {k_cache[dbase+j]=am_to_f16(tk[j]*kfac);v_cache[dbase+j]=am_to_f16(tv[j]*vinv);}
        }
    }
    for t:0..<nb {
        am_attn_gqa_1pass(h,dims0,dims1,kv_info,pos0+t,qk_clip,rel_clip,tau_buf[t],q[t*n_q..<(t+1)*n_q],q_scale,r[t*n_hr..<(t+1)*n_hr],r_scale,rel_bias,sinks[t*n_head..<(t+1)*n_head],gate[t*n_q..<(t+1)*n_q],k_cache,v_cache,out[t*n_q..<(t+1)*n_q]);
    }
}

am_dot_q4s_conv_nb :: (qs:[]u32,ds:[]u16,b0:int,b1:int,x:[]f32,blocks:int,rows:int,nb:int,add_res:int,cw:[]f32,hist:[]f32,res:[]f32,raw_log:[]f32,out:[]f32,r0:int,r1:int) #effects(all) {
    cols:=blocks*32;
    u0:=hist[r0*3];u1:=hist[r0*3+1];u2:=hist[r0*3+2];
    v0:=hist[r1*3];v1:=hist[r1*3+1];v2:=hist[r1*3+2];
    for t:0..<nb {
        d0:=am_dot_q4s_lane(qs,ds,b0,x,t*cols,blocks);
        d1:=am_dot_q4s_lane(qs,ds,b1,x,t*cols,blocks);
        raw_log[t*rows+r0]=d0;
        a0:=(d0+u0*cw[r0*4]+u1*cw[r0*4+1]+u2*cw[r0*4+2]+d0*cw[r0*4+3])*0.4472135954999579f32;
        out[t*rows+r0]=ifx add_res!=0 then res[t*rows+r0]+a0 else a0;
        u0=u1;u1=u2;u2=d0;
        if r1!=r0 {
            raw_log[t*rows+r1]=d1;
            a1:=(d1+v0*cw[r1*4]+v1*cw[r1*4+1]+v2*cw[r1*4+2]+d1*cw[r1*4+3])*0.4472135954999579f32;
            out[t*rows+r1]=ifx add_res!=0 then res[t*rows+r1]+a1 else a1;
            v0=v1;v1=v2;v2=d1;
        }
    }
}

am_moe_plan_nb :: (n_exp:int,n_used:int,nb:int,gpe:int,has_bias:int,scale:f32,logits:[]f32,bias:[]f32,ids:[]u32,wts:[]f32,u_eids:[]u32,u_mask:[]u32,u_slot:[]u32,u_cnt:[]u32) #effects(all) {
    for t:0..<nb {
        am_router_top8(n_exp,n_used,has_bias,scale,logits[t*n_exp..<(t+1)*n_exp],bias,ids[t*n_used..<(t+1)*n_used],wts[t*n_used..<(t+1)*n_used]);
    }
    nu:=0;
    for e:0..<n_exp {
        m:u32=0;
        for t:0..<nb {
            for s:0..<n_used {
                if cast(int)ids[t*n_used+s]==e {
                    m=m|(cast(u32)1<<cast(u32)t);
                    u_slot[nu*8+t]=cast(u32)s;
                }
            }
        }
        if m!=0 {
            u_eids[nu]=cast(u32)e;
            u_mask[nu]=m;
            nu+=1;
        }
    }
    u_cnt[0]=cast(u32)nu;
    u_cnt[1]=cast(u32)(nu*gpe);
    u_cnt[2]=1;
    u_cnt[3]=1;
}

am_moe_gu_iq4_nb :: (u:int,row0:int,n_ff:int,cols:int,nb:int,n_used:int,beta:f32,lb:f32,n_parts:int,eps:f32,w:[]u16,x:[]f32,parts:[]f32,u_eids:[]u32,u_mask:[]u32,u_slot:[]u32,u_cnt:[]u32,out:[]f32) #effects(all) {
    if u>=cast(int)u_cnt[0] {return;}
    blocks:=cols/32;rw:=blocks*9;eb:=cast(int)u_eids[u]*2*n_ff*rw;
    mask:=u_mask[u];
    for t:0..<nb {
        if (mask&(cast(u32)1<<cast(u32)t))!=0 {
            inv:f32=1.0f32;
            if n_parts>0 {
                ss:f32=0.0f32;
                for i:0..<n_parts {ss+=parts[t*n_parts+i];}
                inv=1.0f32/sqrt(ss/f32(cols)+eps);
            }
            sl:=cast(int)u_slot[u*8+t];
            for dr:0..<8 {
                r:=row0+dr;
                if r<n_ff {
                    gb:=eb+r*rw;
                    g:=am_dot_iq4_lane(w,gb,x,t*cols,blocks)*inv;
                    up:=am_dot_iq4_lane(w,gb+n_ff*rw,x,t*cols,blocks)*inv;
                    out[(t*n_used+sl)*n_ff+r]=am_situ_act(g,up,beta,lb);
                }
            }
        }
    }
}

am_moe_gu_q4s_nb :: (u:int,row0:int,n_ff:int,cols:int,nb:int,n_used:int,beta:f32,lb:f32,n_parts:int,eps:f32,qs:[]u32,ds:[]u16,x:[]f32,parts:[]f32,u_eids:[]u32,u_mask:[]u32,u_slot:[]u32,u_cnt:[]u32,out:[]f32) #effects(all) {
