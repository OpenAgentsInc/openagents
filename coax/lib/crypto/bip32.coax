// True when the first n bytes of buf are zero and the rest still hold 0xa5.
hdkt_wiped :: (buf: [] u8, n: int) -> bool {
  for i: 0..<buf.count { if buf[i] != (ifx i < n then cast(u8) 0 else cast(u8) 0xa5) { return false; } }
  return true;
}
hdkt_fill :: (buf: [] u8) { for i: 0..<buf.count { buf[i] = 0xa5; } }
// A node from a published text, which must decode.
hdkt_node :: (text: string, node: [] u8) -> [] u8 {
  work: [BIP32_WORK_BYTES] u8;
  #assert bip32_decode_ct(text, work[..], node) == BIP32_NODE_BYTES;
  return node[0..<BIP32_NODE_BYTES];
}
// True when node encodes to text.
hdkt_is :: (node: [] u8, text: string) -> bool {
  work: [BIP32_WORK_BYTES] u8; out: [BIP32_TEXT] u8;
  return bip32_encode_ct(node, work[..], out[..]) == BIP32_TEXT && b58_same(out[..], text);
}
#test "the check helpers" {
  w: [4] u8; w[2] = 0xa5; w[3] = 0xa5;
  #assert hdkt_wiped(w[..], 2) && !hdkt_wiped(w[..], 1) && !hdkt_wiped(w[..], 3);
  w[0] = 1; #assert !hdkt_wiped(w[..], 2);
  hdkt_fill(w[..]); #assert hdkt_wiped(w[..], 0);
  h: [4] u8;
  out := bip32_hex("09afa0f9", h[..]);
  #assert out.count == 4 && out[0] == 0x09 && out[1] == 0xaf && out[2] == 0xa0 && out[3] == 0xf9;
}
#test "fields, versions and key bytes" {
  b: [5] u8;
  hdk_put32(b[..], 1, 0x8899aabb);
  #assert b[0] == 0 && b[1] == 0x88 && b[2] == 0x99 && b[3] == 0xaa && b[4] == 0xbb && hdk_get32(b[..], 1) == 0x8899aabb;
  #assert hdk_kind(BIP32_XPRV) == 1 && hdk_kind(BIP32_TPRV) == 1 && hdk_kind(BIP32_XPUB) == 0 && hdk_kind(BIP32_TPUB) == 0;
  #assert hdk_kind(BIP32_XPRV + 1) == BIP32_BAD_VERSION && hdk_kind(BIP32_TPRV - 1) == BIP32_BAD_VERSION;
  #assert hdk_kind(BIP32_XPUB + 1) == BIP32_BAD_VERSION && hdk_kind(BIP32_TPUB - 1) == BIP32_BAD_VERSION && hdk_kind(0) == BIP32_BAD_VERSION;
  node: [BIP32_NODE_BYTES] u8;
  hdk_put32(node[..], 0, BIP32_XPRV);
  #assert hdk_check(node[..]) == 1;
  node[HDK_KEY] = 1; #assert hdk_check(node[..]) == BIP32_BAD_PREFIX;
  node[HDK_KEY] = 2; #assert hdk_check(node[..]) == BIP32_BAD_PREFIX;
  hdk_put32(node[..], 0, BIP32_TPUB);
  #assert hdk_check(node[..]) == 0;
  node[HDK_KEY] = 3; #assert hdk_check(node[..]) == 0;
  node[HDK_KEY] = 0; #assert hdk_check(node[..]) == BIP32_BAD_PREFIX;
  node[HDK_KEY] = 4; #assert hdk_check(node[..]) == BIP32_BAD_PREFIX;
  node[HDK_KEY] = 1; #assert hdk_check(node[..]) == BIP32_BAD_PREFIX;
  hdk_put32(node[..], 0, 0x0488ade5); #assert hdk_check(node[..]) == BIP32_BAD_VERSION;
  work: [BIP32_WORK_BYTES] u8; hdkt_fill(work[..]); hdk_wipe(work[..]); #assert hdkt_wiped(work[..], BIP32_WORK_BYTES);
}
#test "k*G in constant time, and the keys it refuses" #steps 400000000 {
  key: [32] u8; out: [34] u8; g: [33] u8; kb: [32] u8;
  hdkt_fill(out[..]);
  #assert !hdk_point_ct(key[..], out[..]) && hdkt_wiped(out[..], 0);                       // 0
  #assert !hdk_point_ct(bip32_hex(HDKT_N, kb[..]), out[..]) && hdkt_wiped(out[..], 0);     // n
  #assert hdk_point_ct(bip32_hex(HDKT_N_1, kb[..]), out[..]) && out[0] == 3 && out[33] == 0xa5; // (n - 1)G = -G
  for i: 1..<33 { #assert out[i] == bip32_hex(HDKT_G, g[..])[i]; }
  key[31] = 1;
  #assert bip32_public(key[..], out[..]) && out[0] == 2 && out[1] == 0x79 && out[32] == 0x98;
  #assert !bip32_public(key[0..<31], out[..]) && !bip32_public(key[..], out[0..<32]) && bip32_public(key[..], out[0..<33]);
}
#test "I_L + k mod n, and the two cases BIP-32 skips" {
  il: [32] u8; key: [32] u8; out: [33] u8; n: [32] u8; n1: [32] u8;
  #assert bip32_hex(HDKT_N, n[..]).count > 0; #assert bip32_hex(HDKT_N_1, n1[..]).count > 0;
  hdkt_fill(out[..]);
  key[31] = 1;
  #assert hdk_tweak_ct(n[..], key[..], out[..]) == BIP32_INVALID_KEY && hdkt_wiped(out[..], 0);   // I_L = n
  #assert hdk_tweak_ct(n1[..], key[..], out[..]) == BIP32_INVALID_KEY && hdkt_wiped(out[..], 0);  // (n - 1) + 1 = 0
  #assert hdk_tweak_ct(il[..], il[..], out[..]) == BIP32_INVALID_KEY;                             // 0 + 0: a master I_L of 0
  il[31] = 1;
  #assert hdk_tweak_ct(il[..], key[..], out[..]) == 32 && out[31] == 2 && out[0] == 0 && out[32] == 0xa5;
  key[31] = 2;
  #assert hdk_tweak_ct(n1[..], key[..], out[..]) == 32 && out[31] == 1 && out[0] == 0;          // wraps past n
  zero: [32] u8;
  #assert hdk_tweak_ct(zero[..], n1[..], out[..]) == 32 && out[31] == 0x40 && out[0] == 0xff;   // 0 + (n - 1)
}
#test "I_L*G + K on public data, and the cases it refuses" #steps 400000000 {
  il: [32] u8; g: [33] u8; out: [34] u8; n: [32] u8; n1: [32] u8; bad: [33] u8;
  #assert bip32_hex(HDKT_G, g[..]).count > 0; #assert bip32_hex(HDKT_N, n[..]).count > 0; #assert bip32_hex(HDKT_N_1, n1[..]).count > 0;
  hdkt_fill(out[..]);
  #assert hdk_add_point(n[..], g[..], out[..]) == BIP32_INVALID_KEY && hdkt_wiped(out[..], 0);   // I_L = n
  #assert hdk_add_point(n1[..], g[..], out[..]) == BIP32_INVALID_KEY && hdkt_wiped(out[..], 0);  // (n - 1)G + G is infinity
  bad[0] = 2; bad[32] = 7;                                                                         // x = 7 is not on the curve
  #assert hdk_add_point(il[..], bad[..], out[..]) == BIP32_INVALID_KEY && hdkt_wiped(out[..], 0);
  #assert hdk_add_point(il[..], g[..], out[..]) == 33 && out[0] == 2 && out[1] == 0x79 && out[33] == 0xa5; // 0G + G
  il[31] = 1;
  #assert hdk_add_point(il[..], g[..], out[..]) == 33 && out[0] == 2 && out[1] == 0xc6 && out[32] == 0xe5;  // 2G
}
#test "test vector 1: the master, a hardened child, a normal child, both ways" #steps 1000000000 {
  sb: [16] u8; work: [BIP32_WORK_BYTES] u8; m: [BIP32_NODE_BYTES] u8; a: [BIP32_NODE_BYTES] u8; b: [BIP32_NODE_BYTES + 1] u8;
  fp: [5] u8; p: [BIP32_NODE_BYTES] u8;
  hdkt_fill(work[..]); hdkt_fill(b[..]);
  #assert bip32_master_ct(bip32_hex(HDKT_SEED, sb[..]), false, work[..], m[..]) == BIP32_NODE_BYTES && hdkt_wiped(work[..], BIP32_WORK_BYTES);
  #assert hdkt_is(m[..], HDKT_M) && !hdkt_is(m[..], HDKT_0H);
  #assert bip32_ckd_ct(m[..], BIP32_HARDENED, work[..], a[..]) == BIP32_NODE_BYTES && hdkt_is(a[..], HDKT_0H);
  hdkt_fill(work[..]);
  #assert bip32_ckd_ct(a[..], 1, work[..], b[0..<BIP32_NODE_BYTES]) == BIP32_NODE_BYTES && hdkt_is(b[0..<BIP32_NODE_BYTES], HDKT_0H_1);
  #assert hdkt_wiped(work[..], BIP32_WORK_BYTES) && b[BIP32_NODE_BYTES] == 0xa5;
  // N(m/0H/1), and CKDpub from m/0H's xpub to the same node
  hdkt_fill(work[..]);
  #assert bip32_neuter_ct(b[0..<BIP32_NODE_BYTES], work[..], p[..]) == BIP32_NODE_BYTES && hdkt_is(p[..], HDKT_0H_1_PUB);
  #assert hdkt_wiped(work[..], BIP32_WORK_BYTES);
  hdkt_fill(work[..]);
  #assert bip32_ckd_ct(hdkt_node(HDKT_0H_PUB, p[..]), 1, work[..], p[..]) == BIP32_NODE_BYTES && hdkt_is(p[..], HDKT_0H_1_PUB);
  #assert hdkt_wiped(work[..], BIP32_WORK_BYTES);
  // a public node neuters to itself; the master's fingerprint, from its xprv and its xpub
  #assert bip32_neuter_ct(p[..], work[..], a[..]) == BIP32_NODE_BYTES && hdkt_is(a[..], HDKT_0H_1_PUB);
  hdkt_fill(fp[..]); hdkt_fill(work[..]);
  #assert bip32_fingerprint_ct(m[..], work[..], fp[..]) == 4 && fp[0] == 0x34 && fp[1] == 0x42 && fp[2] == 0x19 && fp[3] == 0x3e && fp[4] == 0xa5;
  #assert hdkt_wiped(work[..], BIP32_WORK_BYTES);
  for i: 0..<4 { fp[i] = 0; }
  #assert bip32_fingerprint_ct(hdkt_node(HDKT_M_PUB, p[..]), work[..], fp[0..<4]) == 4 && fp[0] == 0x34 && fp[3] == 0x3e;
}
#test "the test networks: tprv and tpub" #steps 400000000 {
  sb: [16] u8; work: [BIP32_WORK_BYTES] u8; m: [BIP32_NODE_BYTES] u8; p: [BIP32_NODE_BYTES] u8;
  #assert bip32_master_ct(bip32_hex(HDKT_SEED, sb[..]), true, work[..], m[..]) == BIP32_NODE_BYTES && hdkt_is(m[..], HDKT_M_TPRV);
  #assert bip32_neuter_ct(m[..], work[..], p[..]) == BIP32_NODE_BYTES && hdkt_is(p[..], HDKT_M_TPUB);
  #assert hdk_get32(hdkt_node(HDKT_M_TPUB, p[..]), 0) == BIP32_TPUB && hdk_get32(hdkt_node(HDKT_M_TPRV, p[..]), 0) == BIP32_TPRV;
}
#forall "test vector 5: every invalid extended key refuses, with its code" i: 0..<16 #steps 100000000 {
  work: [BIP32_WORK_BYTES] u8; node: [BIP32_NODE_BYTES] u8;
  hdkt_fill(work[..]); hdkt_fill(node[..]);
  #assert bip32_decode_ct(HDKT_INVALID[i].text, work[..], node[..]) == HDKT_INVALID[i].code;
  #assert hdkt_wiped(work[..], BIP32_WORK_BYTES) && hdkt_wiped(node[..], 0);
}
#test "decoding: every field back, and the text refusals" #steps 400000000 {
  work: [BIP32_WORK_BYTES] u8; node: [BIP32_NODE_BYTES] u8; text: [BIP32_TEXT + 1] u8;
  hdkt_fill(work[..]);
  #assert bip32_decode_ct(HDKT_0H_1, work[..], node[..]) == BIP32_NODE_BYTES && hdkt_wiped(work[..], BIP32_WORK_BYTES);
  #assert hdk_get32(node[..], HDK_VERSION) == BIP32_XPRV && node[HDK_DEPTH] == 2 && hdk_get32(node[..], HDK_PARENT) == 0x5c1bd648;
  #assert hdk_get32(node[..], HDK_INDEX) == 1 && node[HDK_CHAIN] == 0x2a && node[HDK_CHAIN + 31] == 0x19;
  #assert node[HDK_KEY] == 0 && node[HDK_KEY + 1] == 0x3c && node[HDK_KEY + 32] == 0x68;
  #assert hdkt_is(hdkt_node(HDKT_DEPTH_255, node[..]), HDKT_DEPTH_255) && node[HDK_DEPTH] == 255;
  for c: 0..<BIP32_TEXT { text[c] = HDKT_M[c]; }
  text[BIP32_TEXT] = 'z';
  #assert bip32_decode_ct(cast(string) text[0..<110], work[..], node[..]) == BIP32_BAD_TEXT;
  #assert bip32_decode_ct(cast(string) text[..], work[..], node[..]) == BIP32_BAD_TEXT;      // 112 characters
  text[50] = '0';
  #assert bip32_decode_ct(cast(string) text[0..<111], work[..], node[..]) == BIP32_BAD_TEXT;
  text[50] = 'I';
  #assert bip32_decode_ct(cast(string) text[0..<111], work[..], node[..]) == BIP32_BAD_TEXT;
  for c: 0..<BIP32_TEXT { text[c] = 'z'; }                                                    // 58^111 - 1 fits
  #assert bip32_decode_ct(cast(string) text[0..<111], work[..], node[..]) == BIP32_BAD_CHECKSUM;
  text[0] = '1';
  #assert bip32_decode_ct(cast(string) text[0..<111], work[..], node[..]) == BIP32_BAD_CHECKSUM;
  #assert bip32_decode_ct(HDKT_M_SUM0, work[..], node[..]) == BIP32_BAD_CHECKSUM;
  #assert bip32_decode_ct(HDKT_M_PARENT0, work[..], node[..]) == BIP32_BAD_DEPTH;
  hdkt_fill(node[..]); hdkt_fill(work[..]);
  #assert bip32_decode_ct(HDKT_M, work[..], node[0..<77]) == BIP32_CAPACITY && hdkt_wiped(work[..], 0);
  #assert bip32_decode_ct(HDKT_M, work[0..<BIP32_WORK_BYTES - 1], node[..]) == BIP32_CAPACITY && hdkt_wiped(work[..], 0);
  #assert hdkt_wiped(node[..], 0);
}
#test "encoding: refusals, and nothing written past the text" #steps 400000000 {
  work: [BIP32_WORK_BYTES] u8; node: [BIP32_NODE_BYTES] u8; out: [BIP32_TEXT + 1] u8;
  #assert hdkt_node(HDKT_M_PUB, node[..]).count > 0;
  hdkt_fill(out[..]); hdkt_fill(work[..]);
  #assert bip32_encode_ct(node[..], work[..], out[..]) == BIP32_TEXT && out[BIP32_TEXT] == 0xa5 && hdkt_wiped(work[..], BIP32_WORK_BYTES);
  hdkt_fill(out[..]); hdkt_fill(work[..]);
  #assert bip32_encode_ct(node[0..<77], work[..], out[..]) == BIP32_BAD_SIZE;
  #assert bip32_encode_ct(node[..], work[..], out[0..<110]) == BIP32_CAPACITY;
  #assert bip32_encode_ct(node[..], work[0..<BIP32_WORK_BYTES - 1], out[..]) == BIP32_CAPACITY && hdkt_wiped(work[..], 0);
  node[HDK_KEY] = 0;
  #assert bip32_encode_ct(node[..], work[..], out[..]) == BIP32_BAD_PREFIX && hdkt_wiped(work[..], BIP32_WORK_BYTES);
  node[0] = 5;
  #assert bip32_encode_ct(node[..], work[..], out[..]) == BIP32_BAD_VERSION && hdkt_wiped(out[..], 0);
}
#test "children: refusals before the work, and after it" #steps 1000000000 {
  work: [BIP32_WORK_BYTES] u8; node: [BIP32_NODE_BYTES] u8; out: [BIP32_NODE_BYTES] u8; key: [32] u8; n: [32] u8;
  #assert hdkt_node(HDKT_M_PUB, node[..]).count > 0;
  hdkt_fill(work[..]); hdkt_fill(out[..]);
  #assert bip32_ckd_ct(node[0..<77], 0, work[..], out[..]) == BIP32_BAD_SIZE;
  #assert bip32_ckd_ct(node[..], 0, work[..], out[0..<77]) == BIP32_CAPACITY;
  #assert bip32_ckd_ct(node[..], 0, work[0..<BIP32_WORK_BYTES - 1], out[..]) == BIP32_CAPACITY;
  #assert bip32_ckd_ct(node[..], -1, work[..], out[..]) == BIP32_BAD_INDEX;
  #assert bip32_ckd_ct(node[..], 4294967296, work[..], out[..]) == BIP32_BAD_INDEX && hdkt_wiped(work[..], 0);
  #assert bip32_ckd_ct(node[..], 4294967295, work[..], out[..]) == BIP32_NEEDS_PRIVATE && hdkt_wiped(work[..], BIP32_WORK_BYTES);
  #assert bip32_ckd_ct(node[..], BIP32_HARDENED, work[..], out[..]) == BIP32_NEEDS_PRIVATE;
  // past depth 255, and depth 254 to 255
  #assert bip32_ckd_ct(hdkt_node(HDKT_DEPTH_255, node[..]), 0, work[..], out[..]) == BIP32_BAD_DEPTH;
  #assert bip32_ckd_ct(hdkt_node(HDKT_DEPTH_254, node[..]), 0, work[..], out[..]) == BIP32_NODE_BYTES && hdkt_is(out[..], HDKT_DEPTH_255_CHILD);
  hdkt_fill(out[..]);
  node[HDK_KEY] = 4;
  #assert bip32_ckd_ct(node[..], 0, work[..], out[..]) == BIP32_BAD_PREFIX;
  node[0] = 5;
  #assert bip32_ckd_ct(node[..], 0, work[..], out[..]) == BIP32_BAD_VERSION && hdkt_wiped(out[..], 0);
  // a public key off the curve; private keys of 0 and n
  #assert hdkt_node(HDKT_M_PUB, node[..]).count > 0;
  for j: 0..<32 { node[HDK_KEY + 1 + j] = 0; }
  node[HDK_KEY + 32] = 7;                                                                     // x = 7: no point
  #assert bip32_ckd_ct(node[..], 0, work[..], out[..]) == BIP32_INVALID_KEY && hdkt_wiped(out[..], 0);
  hdk_put32(node[..], 0, BIP32_XPRV); node[HDK_KEY] = 0;
  for j: 0..<32 { node[HDK_KEY + 1 + j] = 0; }
  #assert bip32_ckd_ct(node[..], BIP32_HARDENED, work[..], out[..]) == BIP32_INVALID_KEY;
  #assert bip32_hex(HDKT_N, n[..]).count > 0;
  for j: 0..<32 { node[HDK_KEY + 1 + j] = n[j]; }
  #assert bip32_ckd_ct(node[..], 0, work[..], out[..]) == BIP32_INVALID_KEY && hdkt_wiped(out[..], 0) && hdkt_wiped(work[..], BIP32_WORK_BYTES);
  // N() and the fingerprint refuse what the node check refuses
  #assert bip32_neuter_ct(node[..], work[..], out[..]) == BIP32_INVALID_KEY && hdkt_wiped(out[..], 0);
  #assert bip32_fingerprint_ct(node[..], work[..], key[..]) == BIP32_INVALID_KEY;
  node[0] = 5;
  #assert bip32_neuter_ct(node[..], work[..], out[..]) == BIP32_BAD_VERSION && bip32_fingerprint_ct(node[..], work[..], key[..]) == BIP32_BAD_VERSION;
  #assert bip32_neuter_ct(node[0..<77], work[..], out[..]) == BIP32_BAD_SIZE && bip32_fingerprint_ct(node[0..<77], work[..], key[..]) == BIP32_BAD_SIZE;
  hdkt_fill(work[..]);
  #assert bip32_neuter_ct(node[..], work[..], out[0..<77]) == BIP32_CAPACITY && bip32_neuter_ct(node[..], work[0..<BIP32_WORK_BYTES - 1], out[..]) == BIP32_CAPACITY;
  #assert bip32_fingerprint_ct(node[..], work[..], key[0..<3]) == BIP32_CAPACITY && bip32_fingerprint_ct(node[..], work[0..<BIP32_WORK_BYTES - 1], key[..]) == BIP32_CAPACITY;
  #assert hdkt_wiped(work[..], 0) && hdkt_wiped(out[..], 0);
  // the master's refusals
  sb: [65] u8;
  #assert bip32_master_ct(sb[0..<15], false, work[..], out[..]) == BIP32_BAD_SIZE && bip32_master_ct(sb[..], false, work[..], out[..]) == BIP32_BAD_SIZE;
  #assert bip32_master_ct(sb[0..<16], false, work[..], out[0..<77]) == BIP32_CAPACITY;
  #assert bip32_master_ct(sb[0..<16], false, work[0..<BIP32_WORK_BYTES - 1], out[..]) == BIP32_CAPACITY && hdkt_wiped(work[..], 0);
  #assert bip32_master_ct(sb[0..<64], false, work[..], out[..]) == BIP32_NODE_BYTES && hdkt_wiped(work[..], BIP32_WORK_BYTES);
}
#test "a list of indexes, one child at a time" #steps 1000000000 {
  sb: [16] u8; work: [BIP32_WORK_BYTES] u8; m: [BIP32_NODE_BYTES] u8; out: [BIP32_NODE_BYTES] u8;
  path := [2] int.[BIP32_HARDENED, 1];
  #assert bip32_master_ct(bip32_hex(HDKT_SEED, sb[..]), false, work[..], m[..]) == BIP32_NODE_BYTES;
  hdkt_fill(work[..]);
  #assert bip32_descend_ct(m[..], path[..], work[..], out[..]) == BIP32_NODE_BYTES && hdkt_is(out[..], HDKT_0H_1);
  #assert hdkt_wiped(work[..], BIP32_WORK_BYTES);
  #assert bip32_descend_ct(m[..], path[0..<0], work[..], out[..]) == BIP32_NODE_BYTES && hdkt_is(out[..], HDKT_M);
  // the first and last indexes
  ends := [2] int.[0, 4294967295]; one: [BIP32_NODE_BYTES] u8;
  #assert bip32_descend_ct(m[..], ends[0..<1], work[..], out[..]) == BIP32_NODE_BYTES && bip32_ckd_ct(m[..], 0, work[..], one[..]) == BIP32_NODE_BYTES;
  for j: 0..<BIP32_NODE_BYTES { #assert out[j] == one[j]; }
  #assert bip32_descend_ct(m[..], ends[1..<2], work[..], out[..]) == BIP32_NODE_BYTES && bip32_ckd_ct(m[..], 4294967295, work[..], one[..]) == BIP32_NODE_BYTES;
  for j: 0..<BIP32_NODE_BYTES { #assert out[j] == one[j]; }
  // a refusal part way down writes nothing
  hdkt_fill(out[..]);
  pub := [2] int.[1, BIP32_HARDENED];
  #assert bip32_descend_ct(hdkt_node(HDKT_M_PUB, m[..]), pub[..], work[..], out[..]) == BIP32_NEEDS_PRIVATE && hdkt_wiped(out[..], 0);
  bad := [2] int.[0, -1];
  hdkt_fill(work[..]);
  #assert bip32_descend_ct(m[..], bad[..], work[..], out[..]) == BIP32_BAD_INDEX && hdkt_wiped(work[..], 0);
  bad[1] = 4294967296;
  #assert bip32_descend_ct(m[..], bad[..], work[..], out[..]) == BIP32_BAD_INDEX;
  #assert bip32_descend_ct(m[0..<77], path[..], work[..], out[..]) == BIP32_BAD_SIZE;
  #assert bip32_descend_ct(m[..], path[..], work[..], out[0..<77]) == BIP32_CAPACITY;
  #assert bip32_descend_ct(m[..], path[..], work[0..<BIP32_WORK_BYTES - 1], out[..]) == BIP32_CAPACITY && hdkt_wiped(work[..], 0);
  m[0] = 5;
  #assert bip32_descend_ct(m[..], path[0..<0], work[..], out[..]) == BIP32_BAD_VERSION && hdkt_wiped(out[..], 0);
}
#test "the older interface keeps its answers" #steps 1000000000 {
  sb: [16] u8; key: [32] u8; chain: [32] u8; k: [32] u8; c: [32] u8;
  seed := bip32_hex(HDKT_SEED, sb[..]);
  #assert bip32_master(seed, key[..], chain[..]) && key[0] == 0xe8 && key[31] == 0x35 && chain[0] == 0x87 && chain[31] == 0x08;
  #assert !bip32_master(seed[0..<15], k[..], c[..]) && !bip32_master(seed, k[0..<31], c[..]) && !bip32_master(seed, k[..], c[0..<31]);
  #assert bip32_child(key[..], chain[..], BIP32_HARDENED, k[..], c[..]) && k[0] == 0xed && k[31] == 0xea && c[0] == 0x47 && c[31] == 0x41;
  #assert !bip32_child(key[..], chain[..], -1, k[..], c[..]) && !bip32_child(key[..], chain[..], 4294967296, k[..], c[..]);
  #assert !bip32_child(key[0..<31], chain[..], 0, k[..], c[..]) && !bip32_child(key[..], chain[0..<31], 0, k[..], c[..]);
  #assert !bip32_child(key[..], chain[..], 0, k[0..<31], c[..]) && !bip32_child(key[..], chain[..], 0, k[..], c[0..<31]);
  path := [2] int.[BIP32_HARDENED, 1];
  #assert bip32_path(seed, path[..], k[..], c[..]) && k[0] == 0x3c && k[31] == 0x68 && c[0] == 0x2a && c[31] == 0x19;
  bad := [1] int.[-1];
  #assert !bip32_path(seed, bad[..], k[..], c[..]) && k[0] == 0 && k[31] == 0 && c[0] == 0 && c[31] == 0;
  #assert !bip32_path(seed[0..<15], path[0..<0], key[..], chain[..]) && key[0] == 0 && chain[0] == 0;
  #assert !bip32_path(seed, path[..], k[0..<31], c[..]) && !bip32_path(seed, path[..], k[..], c[0..<31]);
  zero: [32] u8;                                                                // a key of 0 is refused now
  #assert !bip32_child(zero[..], chain[..], BIP32_HARDENED, k[..], c[..]);
  node: [BIP32_NODE_BYTES] u8; node[0] = 9; node[77] = 9;
  hdk_split(false, node[..], k[..], c[..]);
  #assert node[0] == 0 && node[77] == 0;
}
