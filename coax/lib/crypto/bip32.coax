// BIP-32 private derivation (hardened and normal children) on the shared
// secp256k1 code, for NIP-06 (docs/web-log-in.md). Keys and chain codes are
// caller-owned 32-byte views; locals holding secrets are zeroed before return.
#load "sha512.coax";
#load "secp_mult_const.coax";
BIP32_HARDENED :: 2147483648;

// The compressed public key (33 bytes) of a private key.
bip32_public :: (key: [] u8, out: [] u8) -> bool #export_c {
  if key.count != 32 || out.count < 33 { return false; }
  k := sc_load(key);
  if !k.ok || sc_is_zero(k.value) { return false; }
  p := smc_multiply(k.value, sg_generator());
  e := sg_encode_public(p.value);
  if !p.ok || !e.ok || e.length != 33 { return false; }
  for i: 0..<33 { out[i] = e.bytes[i]; }
  return true;
}
// The master key and chain code of a seed (16 to 64 bytes).
bip32_master :: (seed: [] u8, key: [] u8, chain: [] u8) -> bool #export_c {
  if seed.count < 16 || seed.count > 64 || key.count != 32 || chain.count != 32 { return false; }
  label := "Bitcoin seed"; lb: [12] u8; i: [64] u8;
  for j: 0..<12 { lb[j] = label[j]; }
  ok := hmac_sha512(lb[..], seed, i[..]);
  if ok { k := sc_load(i[0..<32]); ok = k.ok && !sc_is_zero(k.value); }
  if ok { for j: 0..<32 { key[j] = i[j]; chain[j] = i[32 + j]; } }
  for j: 0..<64 { i[j] = 0; }
  return ok;
}
// The child at index (0 .. 2^32-1; BIP32_HARDENED and up is hardened) of key and chain, into key_out and chain_out.
bip32_child :: (key: [] u8, chain: [] u8, index: int, key_out: [] u8, chain_out: [] u8) -> bool #export_c {
  if key.count != 32 || chain.count != 32 || key_out.count != 32 || chain_out.count != 32 || index < 0 || index > 4294967295 { return false; }
  data: [37] u8; i: [64] u8;
  if index >= BIP32_HARDENED { for j: 0..<32 { data[1 + j] = key[j]; } }
  else if !bip32_public(key, data[0..<33]) { return false; }
  for j: 0..<4 { data[33 + j] = cast(u8) ((index >> (8 * (3 - j))) & 255); }
  ok := hmac_sha512(chain, data[..], i[..]);
  parent := sc_load(key); tweak := sc_load(i[0..<32]);
  ok = ok && parent.ok && tweak.ok;
  child := sc_add(tweak.value, parent.value);
  ok = ok && !sc_is_zero(child);
  if ok { ok = sc_store(child, key_out); for j: 0..<32 { chain_out[j] = i[32 + j]; } }
  for j: 0..<64 { i[j] = 0; }
  for j: 0..<37 { data[j] = 0; }
  return ok;
}
// A path of indexes from a seed's master, into key and chain.
bip32_path :: (seed: [] u8, path: [] int, key: [] u8, chain: [] u8) -> bool #export_c {
  if !bip32_master(seed, key, chain) { return false; }
  k: [32] u8; c: [32] u8;
  for step: path {
    if !bip32_child(key, chain, step, k[..], c[..]) { for j: 0..<32 { key[j] = 0; chain[j] = 0; k[j] = 0; c[j] = 0; } return false; }
    for j: 0..<32 { key[j] = k[j]; chain[j] = c[j]; }
  }
  for j: 0..<32 { k[j] = 0; c[j] = 0; }
  return true;
}
bip32_hex :: (h: string, out: [] u8) -> [] u8 {
  n := h.count / 2;
  for i: 0..<n {
    a := h[2 * i]; b := h[2 * i + 1];
    hi := ifx a <= '9' then a - '0' else a - 'a' + 10; lo := ifx b <= '9' then b - '0' else b - 'a' + 10;
    out[i] = hi * 16 + lo;
  }
  return out[0..<n];
}
