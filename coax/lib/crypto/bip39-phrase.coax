// A 24-word BIP-39 phrase as a person typed it, made normal: lower case, one space between
// words, nothing around them, and only a whole 24-word phrase whose checksum holds. Recovery
// codes are such phrases: the account's (coax/web/api/auth-recover-crypto.coax, #13213) and the
// wallet backup's (coax/lib/nostr/vault-wallet.coax, #13217; NIP-VAULT's recovery method hashes
// exactly these bytes).
//   coax/bin/coax test coax/lib/crypto/bip39-phrase.coax
//   coax/bin/coax mutate coax/lib/crypto/bip39-phrase.coax --root-only
#load "bip39.coax";
#authority;

B39P_WORDS :: 24;
B39P_ENTROPY :: 32;
B39P_LOWER :: "abcdefghijklmnopqrstuvwxyz";

// ---------------------------------------------------------------- for the checks
b39p_text :: (s: string, out: [] u8) -> [] u8 #effects(all) { for i: 0..<s.count { out[i] = s[i]; } return out[0..<s.count]; }
b39p_same :: (a: [] u8, s: string) -> bool #effects(all) {
  if a.count != s.count { return false; }
  for i: 0..<a.count { if a[i] != s[i] { return false; } }
  return true;
}
#test "the checks' helpers" {
  b: [8] u8;
  #assert b39p_same(b39p_text("abc", b[..]), "abc") && !b39p_same(b39p_text("abc", b[..]), "abd") && !b39p_same(b39p_text("abc", b[..]), "ab");
  #assert !b39p_same(b39p_text("abc", b[..]), "abcd") && b39p_same(b39p_text("", b[..]), "") && !b39p_same(b39p_text("abc", b[..]), "xbc");
}
// BIP-39's own test vectors (trezor/python-mnemonic vectors.json).
B39P_SEVEN_F :: "legal winner thank year wave sausage worth useful legal winner thank year wave sausage worth useful legal winner thank year wave sausage worth title";
B39P_ZEROS :: "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon art";
B39P_ONES :: "zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo vote";

#test "typed words are lowered, spaced once, and must be a whole checked phrase" {
  work: [BIP39_WORK_BYTES] u8; out: [BIP39_MAX_TEXT] u8; tb: [400] u8;
  typed := "  Legal WINNER thank year\twave sausage worth useful\n legal winner thank year\r\nwave sausage worth useful legal winner thank year wave sausage worth title  ";
  n := bip39_normal24(b39p_text(typed, tb[..]), work[..], out[..]);
  #assert n == B39P_SEVEN_F.count && b39p_same(out[0..<n], B39P_SEVEN_F);
  n = bip39_normal24(b39p_text(B39P_SEVEN_F, tb[..]), work[..], out[..]);
  #assert n == B39P_SEVEN_F.count && b39p_same(out[0..<n], B39P_SEVEN_F);
  // the letters at both ends of the alphabet, either case
  n = bip39_normal24(b39p_text("ABANDON abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon ART", tb[..]), work[..], out[..]);
  #assert n == B39P_ZEROS.count && b39p_same(out[0..<n], B39P_ZEROS);
  n = bip39_normal24(b39p_text("ZOO zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo VOTE", tb[..]), work[..], out[..]);
  #assert n == B39P_ONES.count && b39p_same(out[0..<n], B39P_ONES);
  // just outside the capitals: not lowered, so not words
  #assert bip39_normal24(b39p_text("@BANDON abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon art", tb[..]), work[..], out[..]) == -1;
  #assert bip39_normal24(b39p_text("[OO zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo vote", tb[..]), work[..], out[..]) == -1;
  // the last word changed: the checksum fails
  bad := "legal winner thank year wave sausage worth useful legal winner thank year wave sausage worth useful legal winner thank year wave sausage worth year";
  #assert bip39_normal24(b39p_text(bad, tb[..]), work[..], out[..]) == -1;
  // twelve words are a phrase, not a recovery code
  twelve := "legal winner thank year wave sausage worth useful legal winner thank yellow";
  #assert bip39_normal24(b39p_text(twelve, tb[..]), work[..], out[..]) == -1;
  #assert bip39_normal24(b39p_text("", tb[..]), work[..], out[..]) == -1;
  #assert bip39_normal24(b39p_text("   ", tb[..]), work[..], out[..]) == -1;
  #assert bip39_normal24(b39p_text("legal, winner", tb[..]), work[..], out[..]) == -1;
  // out holds the phrase exactly, or nothing
  #assert bip39_normal24(b39p_text(typed, tb[..]), work[..], out[0..<B39P_SEVEN_F.count]) == B39P_SEVEN_F.count;
  #assert bip39_normal24(b39p_text(typed, tb[..]), work[..], out[0..<B39P_SEVEN_F.count - 1]) == -1;
  #assert bip39_normal24(b39p_text(typed, tb[..]), work[0..<BIP39_WORK_BYTES - 1], out[..]) == -1;
  #assert bip39_normal24(b39p_text(typed, tb[..]), work[0..<10], out[..]) == -1;
  // longer than any phrase: refused
  long: [440] u8; for i: 0..<440 { long[i] = 'a'; }
  #assert bip39_normal24(long[0..<BIP39_MAX_TEXT], work[..], out[..]) == -1;
  #assert bip39_normal24(long[0..<BIP39_MAX_TEXT + 1], work[..], out[..]) == -1;
  for i: 0..<440 { long[i] = ' '; }
  for i: 0..<23 { long[2 * i] = 'a'; }   // 23 one-letter words, then spaces up to the end
  #assert bip39_normal24(long[0..<2 * BIP39_MAX_TEXT], work[..], out[..]) == -1;
  #assert bip39_normal24(long[0..<2 * BIP39_MAX_TEXT + 1], work[..], out[..]) == -1;
}
#test "a phrase that fills the most a phrase holds, then one word more, is refused" {
  work: [BIP39_WORK_BYTES] u8; out: [BIP39_MAX_TEXT] u8; tb: [400] u8;
  // 106 words "a" and one "aaa": 215 letters and spaces, the most; then " a" needs one more
  n := 0;
  for i: 0..<106 { tb[n] = 'a'; tb[n + 1] = ' '; n += 2; }
  tb[n] = 'a'; tb[n + 1] = 'a'; tb[n + 2] = 'a'; n += 3;
  #assert n == BIP39_MAX_TEXT;
  #assert bip39_normal24(tb[0..<n], work[..], out[..]) == -1;   // 107 words, not 24
  tb[n] = ' '; tb[n + 1] = 'a';
  #assert bip39_normal24(tb[0..<n + 2], work[..], out[..]) == -1;
}
#test "a long run of spaces after whole words still reads" {
  work: [BIP39_WORK_BYTES] u8; out: [BIP39_MAX_TEXT] u8; tb: [430] u8;
  for i: 0..<430 { tb[i] = ' '; }
  for i: 0..<B39P_SEVEN_F.count { tb[i] = B39P_SEVEN_F[i]; }
  #assert bip39_normal24(tb[0..<2 * BIP39_MAX_TEXT], work[..], out[..]) == B39P_SEVEN_F.count;
}
// The normal phrase in out and its length, or -1. work (BIP39_WORK_BYTES) comes back as zeros.
bip39_normal24 :: (typed: [] u8, work: [] u8, out: [] u8) -> int #export_c #effects(all) {
  if work.count < BIP39_WORK_BYTES { return -1; }
  buf: [BIP39_MAX_TEXT] u8;
  n := 0; words := 0; gap := true;   // gap: a space came last (or nothing yet)
  for i: 0..<typed.count {
    c := typed[i];
    if c == ' ' || c == '\t' || c == '\n' || c == '\r' { gap = true; continue; }
    if c >= 'A' && c <= 'Z' { c = B39P_LOWER[cast(int) (c - 'A')]; }
    if gap {
      if words > 0 { if n >= BIP39_MAX_TEXT { return -1; } buf[n] = ' '; n += 1; }
      words += 1; gap = false;
    }
    if n >= BIP39_MAX_TEXT { return -1; }
    buf[n] = c; n += 1;
  }
  if words != B39P_WORDS || n > out.count { return -1; }
  // BIP-39 checks each word and the checksum. The entropy lands in work, which it hands back zeroed.
  if bip39_decode_ct(cast(string) buf[0..<n], work, work[..]) != B39P_ENTROPY { return -1; }
  for i: 0..<n { out[i] = buf[i]; }
  return n;
}
