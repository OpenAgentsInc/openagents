// The i-th word (0..2047), or "".
bip39_word :: (i: int) -> string {
  list := BIP39_ENGLISH;
  if i < 0 || i > 2047 { return ""; }
  at := 0; k := 0;
  while k < i { while list[at] != '\n' { at += 1; } at += 1; k += 1; }
  e := at;
  while list[e] != '\n' { e += 1; }
  return list[at..<e];
}
// A word's index, or -1.
bip39_index :: (w: string) -> int {
  list := BIP39_ENGLISH;
  if w.count < 3 || w.count > 8 { return -1; }
  at := 0; k := 0;
  while at < list.count {
    e := at;
    while list[e] != '\n' { e += 1; }
    if e - at == w.count && list[at..<e] == w { return k; }
    at = e + 1; k += 1;
  }
  return -1;
}
// 16 bytes into 12 words, single spaces, into out; the length, or -1.
bip39_words :: (entropy: [] u8, out: [] u8) -> int #export_c {
  if entropy.count != 16 { return -1; }
  h: [32] u8;
  if sha256_hash_checked(entropy, h[..], false) != SHA_OK { return -1; }
  n := 0;
  for i: 0..<12 {
    // bits 11i .. 11i+10 of entropy || checksum (its first 4 bits)
    v := 0;
    for b: 0..<11 {
      bit := i * 11 + b;
      byte := ifx bit < 128 then entropy[bit / 8] else h[0];
      shift := ifx bit < 128 then 7 - bit % 8 else 7 - (bit - 128);
      v = v * 2 + cast(int) ((byte >> cast(u8) shift) & 1);
    }
    w := bip39_word(v);
    if i > 0 { if n >= out.count { return -1; } out[n] = ' '; n += 1; }
    if n + w.count > out.count { return -1; }
    for c: w { out[n] = c; n += 1; }
  }
  for i: 0..<32 { h[i] = 0; }
  return n;
}
// 12 words (any spacing) back into 16 bytes; false for an unknown word, a wrong count or checksum.
bip39_entropy :: (phrase: string, out: [] u8) -> bool #export_c {
  if out.count < 16 { return false; }
  bits: [17] u8;
  k := 0; at := 0;
  while at < phrase.count {
    while at < phrase.count && phrase[at] == ' ' { at += 1; }
    if at >= phrase.count { break; }
    e := at;
    while e < phrase.count && phrase[e] != ' ' { e += 1; }
    if k >= 12 { return false; }
    v := bip39_index(phrase[at..<e]);
    if v < 0 { return false; }
    for b: 0..<11 {
      bit := k * 11 + b;
      if (v >> (10 - b)) & 1 == 1 { bits[bit / 8] |= cast(u8) (1 << (7 - bit % 8)); }
    }
    k += 1; at = e;
  }
  if k != 12 { return false; }
  h: [32] u8;
  ok := sha256_hash_checked(bits[0..<16], h[..], false) == SHA_OK && (h[0] >> 4) == (bits[16] >> 4);
  if ok { for i: 0..<16 { out[i] = bits[i]; } }
  for i: 0..<17 { bits[i] = 0; }
  for i: 0..<32 { h[i] = 0; }
  return ok;
}
// The 64-byte seed of words (single spaces between them) and a passphrase.
bip39_seed_with :: (phrase: string, passphrase: string, out: [] u8) -> bool {
  if out.count < 64 || phrase.count > 200 || passphrase.count > 200 { return false; }
  p: [200] u8; s: [208] u8;
  n := 0; at := 0;
  while at < phrase.count {
    while at < phrase.count && phrase[at] == ' ' { at += 1; }
    if at >= phrase.count { break; }
    if n > 0 { p[n] = ' '; n += 1; }
    while at < phrase.count && phrase[at] != ' ' { p[n] = phrase[at]; n += 1; at += 1; }
  }
  salt := "mnemonic";
  for i: 0..<8 { s[i] = salt[i]; }
  for i: 0..<passphrase.count { s[8 + i] = passphrase[i]; }
  ok := pbkdf2_hmac_sha512(p[0..<n], s[0..<8 + passphrase.count], 2048, out);
  for i: 0..<200 { p[i] = 0; }
  return ok;
}
// The seed with no passphrase (what NIP-06 and our login use).
bip39_seed :: (phrase: string, out: [] u8) -> bool #export_c { return bip39_seed_with(phrase, "", out); }

#test "the English list is the published one (SHA-256), 2048 words, and its ends" {
  list := BIP39_ENGLISH;
  buf: [13116] u8; h: [32] u8;
  #assert list.count == 13116;
  for i: 0..<list.count { buf[i] = list[i]; }
  #assert sha256_hash_checked(buf[..], h[..], false) == SHA_OK && sha512_hexeq(h[..], BIP39_LIST_SHA256);
  #assert bip39_word(0) == "abandon" && bip39_word(2047) == "zoo" && bip39_word(2048) == "" && bip39_word(-1) == "";
  #assert bip39_index("abandon") == 0 && bip39_index("zoo") == 2047 && bip39_index("zo") == -1 && bip39_index("abandonx") == -1;
}
#test "the official vectors: entropy to words and back" {
  e: [16] u8; out: [200] u8; back: [16] u8;
  e[0] = 0; e[1] = 0; e[2] = 0; e[3] = 0; e[4] = 0; e[5] = 0; e[6] = 0; e[7] = 0; e[8] = 0; e[9] = 0; e[10] = 0; e[11] = 0; e[12] = 0; e[13] = 0; e[14] = 0; e[15] = 0;
  n := bip39_words(e[..], out[..]); #assert n > 0 && cast(string) out[0..<n] == "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about";
  #assert bip39_entropy("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about", back[..]); for i: 0..<16 { #assert back[i] == e[i]; }
  e[0] = 127; e[1] = 127; e[2] = 127; e[3] = 127; e[4] = 127; e[5] = 127; e[6] = 127; e[7] = 127; e[8] = 127; e[9] = 127; e[10] = 127; e[11] = 127; e[12] = 127; e[13] = 127; e[14] = 127; e[15] = 127;
  n = bip39_words(e[..], out[..]); #assert n > 0 && cast(string) out[0..<n] == "legal winner thank year wave sausage worth useful legal winner thank yellow";
  #assert bip39_entropy("legal winner thank year wave sausage worth useful legal winner thank yellow", back[..]); for i: 0..<16 { #assert back[i] == e[i]; }
  e[0] = 128; e[1] = 128; e[2] = 128; e[3] = 128; e[4] = 128; e[5] = 128; e[6] = 128; e[7] = 128; e[8] = 128; e[9] = 128; e[10] = 128; e[11] = 128; e[12] = 128; e[13] = 128; e[14] = 128; e[15] = 128;
  n = bip39_words(e[..], out[..]); #assert n > 0 && cast(string) out[0..<n] == "letter advice cage absurd amount doctor acoustic avoid letter advice cage above";
  #assert bip39_entropy("letter advice cage absurd amount doctor acoustic avoid letter advice cage above", back[..]); for i: 0..<16 { #assert back[i] == e[i]; }
  e[0] = 255; e[1] = 255; e[2] = 255; e[3] = 255; e[4] = 255; e[5] = 255; e[6] = 255; e[7] = 255; e[8] = 255; e[9] = 255; e[10] = 255; e[11] = 255; e[12] = 255; e[13] = 255; e[14] = 255; e[15] = 255;
  n = bip39_words(e[..], out[..]); #assert n > 0 && cast(string) out[0..<n] == "zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo wrong";
  #assert bip39_entropy("zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo wrong", back[..]); for i: 0..<16 { #assert back[i] == e[i]; }
  e[0] = 158; e[1] = 136; e[2] = 93; e[3] = 149; e[4] = 42; e[5] = 211; e[6] = 98; e[7] = 202; e[8] = 235; e[9] = 78; e[10] = 254; e[11] = 52; e[12] = 168; e[13] = 233; e[14] = 27; e[15] = 210;
  n = bip39_words(e[..], out[..]); #assert n > 0 && cast(string) out[0..<n] == "ozone drill grab fiber curtain grace pudding thank cruise elder eight picnic";
  #assert bip39_entropy("ozone drill grab fiber curtain grace pudding thank cruise elder eight picnic", back[..]); for i: 0..<16 { #assert back[i] == e[i]; }
  e[0] = 192; e[1] = 186; e[2] = 90; e[3] = 142; e[4] = 145; e[5] = 65; e[6] = 17; e[7] = 33; e[8] = 15; e[9] = 43; e[10] = 209; e[11] = 49; e[12] = 243; e[13] = 213; e[14] = 224; e[15] = 141;
  n = bip39_words(e[..], out[..]); #assert n > 0 && cast(string) out[0..<n] == "scheme spot photo card baby mountain device kick cradle pact join borrow";
  #assert bip39_entropy("scheme spot photo card baby mountain device kick cradle pact join borrow", back[..]); for i: 0..<16 { #assert back[i] == e[i]; }
  // spacing doesn't matter; a wrong checksum, an unknown word or a count other than 12 does
  #assert bip39_entropy("  abandon abandon abandon abandon abandon abandon  abandon abandon abandon abandon abandon about ", back[..]);
  #assert !bip39_entropy("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon", back[..]);
  #assert !bip39_entropy("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abut", back[..]);
  #assert !bip39_entropy("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about", back[..]);
  #assert !bip39_entropy("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about", back[..]);
  #assert bip39_words(e[0..<15], out[..]) == -1 && bip39_words(e[..], out[0..<10]) == -1 && !bip39_entropy("x", back[0..<15]);
}
