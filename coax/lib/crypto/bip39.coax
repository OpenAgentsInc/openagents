// BIP-39 seed phrases (Bitcoin chapter 31; Nostr chapter 46 uses them for
// NIP-06, and docs/web-log-in.md uses 12 words).
//
// - bip39_encode_ct: 16, 20, 24, 28 or 32 bytes of entropy to 12, 15, 18,
//   21 or 24 English words, with the SHA-256 checksum bits.
// - bip39_decode_ct: the words back to their entropy, checking each word
//   and the checksum.
// - bip39_seed_ct: the 64-byte seed, PBKDF2-HMAC-SHA512 (chapters 7 and 8)
//   of the checked words with the salt "mnemonic" + passphrase, 2048 rounds.
//
// The phrase, the entropy, the passphrase and the seed are secrets
// (chapter 3). Every word lookup reads the whole list, the phrase is split
// into words with masks, and the secret intermediates live in a
// caller-owned work buffer that comes back as zeros. The phrase's length,
// its word count and the result code are public.
//
// BIP-39 normalizes the phrase and the passphrase with Unicode NFKD. This
// code supports ASCII only, where NFKD changes nothing, and refuses any
// byte above 0x7f with BIP39_NOT_ASCII instead of hashing unnormalized
// text. The English list is pinned in coax/tests/vectors/upstream/bip39/
// (trezor/python-mnemonic's english.txt) and checked by its SHA-256 below.
//
// The older bool and -1 procedures at the end (bip39_words,
// bip39_entropy_len, bip39_entropy, bip39_seed_with, bip39_seed) keep their
// signatures for NIP-06, the website log-in and the CLI, and call these.
#load "sha256.coax";
#load "sha512.coax";
#authority;

// book:begin codes
BIP39_LIST_SHA256 :: "2f5eed53a4727b4bf8880d8f3f199efc90e58503646d9ff8eff3a2ed3b24dbda";
BIP39_MAX_PHRASE :: 1024;      // the longest phrase accepted, spaces included
BIP39_MAX_PASSPHRASE :: 1016;  // "mnemonic" + passphrase fits PBKDF2's 1,024-byte salt
BIP39_MAX_TEXT :: 215;         // 24 words of at most 8 letters and 23 spaces
BIP39_SEED_BYTES :: 64;
BIP39_ROUNDS :: 2048;

// Refusals.
BIP39_BAD_SIZE :: -1;          // entropy that isn't 16, 20, 24, 28 or 32 bytes
BIP39_BAD_COUNT :: -2;         // a word count that isn't 12, 15, 18, 21 or 24
BIP39_UNKNOWN_WORD :: -3;      // a word that isn't in the English list
BIP39_BAD_CHECKSUM :: -4;      // checksum bits that don't match the entropy's SHA-256
BIP39_NOT_ASCII :: -5;         // a byte above 0x7f, which would need NFKD
BIP39_CAPACITY :: -6;          // an output or work buffer that is too small
BIP39_TOO_LONG :: -7;          // a phrase or passphrase over its limit
// book:end codes

// The work buffer: one 8-byte slot per word, a flag per word, the bits of
// the entropy and checksum, the entropy's SHA-256, the phrase joined with
// single spaces, and the salt.
B39_SLOTS :: 0;
B39_FLAGS :: 192;
B39_BITS :: 216;
B39_HASH :: 249;
B39_TEXT :: 281;
B39_SALT :: 496;
BIP39_WORK_BYTES :: 1520;
// The 2,048 English words, one per line, byte for byte the pinned english.txt.
