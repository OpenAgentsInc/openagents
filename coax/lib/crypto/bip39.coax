// book:begin table
// The list packed for lookup: word k as a u64 whose
// byte c is its letter c, with zeros after the last letter. Every English
// word has 3 to 8 lowercase letters, so each fits and none packs to 0.
b39_make_table :: () -> [2048] u64 {
  table: [2048] u64;
  list := BIP39_ENGLISH;
  k := 0; c := 0;
  for i: 0..<list.count {
    if list[i] == '\n' { k += 1; c = 0; }
    else { table[k] |= cast(u64) list[i] << cast(u64) (8 * c); c += 1; }
  }
  return table;
}
// book:end table

// ---- secret data: constant time (chapter 3)

// book:begin ct
B39_ALL :: CB_MAX64;                               // all ones (bytes.coax)
// All ones when a == b, else 0, without a branch: x | -x has its top bit
// set exactly when x is not 0.
b39_eq_mask :: (a: u64, b: u64) -> u64 {
  x := a ^ b;
  return value_barrier(sub_wrap((x | sub_wrap(cast(u64) 0, x)) >> 63, 1));
}
// All ones when a < b, for a and b below 2^63.
b39_less_mask :: (a: u64, b: u64) -> u64 {
  return value_barrier(sub_wrap(cast(u64) 0, sub_wrap(a, b) >> 63));
}
// The index of a packed word in the low 11 bits, with bit 11 set when the
// list doesn't hold it. It reads all 2,048 entries whatever the word is.
b39_index_ct :: (word: u64) -> u64 {
  index: u64 = 0; found: u64 = 0;
  for k: 0..<2048 {
    m := b39_eq_mask(word, BIP39_TABLE[k]);
    index |= m & cast(u64) k; found |= m;
  }
  return index | (((found & 1) ^ 1) << 11);
}
// The packed word at an index below 2048, reading all 2,048 entries.
b39_word_ct :: (index: u64) -> u64 {
  word: u64 = 0;
  for k: 0..<2048 { word |= b39_eq_mask(index, cast(u64) k) & BIP39_TABLE[k]; }
  return word;
}
// The number of letters in a packed word: its nonzero bytes.
b39_letters_ct :: (word: u64) -> u64 {
  n: u64 = 0;
  for c: 0..<8 { n = add_wrap(n, (add_wrap((word >> cast(u64) (8 * c)) & 255, 255)) >> 8); }
  return n;
}
// Slot s of work as a packed word, and back.
b39_slot :: (work: [] u8, s: int) -> u64 {
  word: u64 = 0;
  for c: 0..<8 { word |= cast(u64) work[B39_SLOTS + 8 * s + c] << cast(u64) (8 * c); }
  return word;
}
b39_put :: (work: [] u8, s: int, word: u64) {
  for c: 0..<8 { work[B39_SLOTS + 8 * s + c] = cast(u8) ((word >> cast(u64) (8 * c)) & 255); }
}
// book:end ct

// book:begin split
// Splits a phrase at its spaces into work's 24 slots, which must be zero.
// No branch or address depends on the text: every character is offered to
// every column of every slot, and a mask lets one take it. A slot's flag
// marks a word longer than 8 characters or with a character outside
// '!'..'~'; neither can be in the list. Returns the number of words, with
// bit 32 set when some byte is above 0x7f. Both are public from here on.
b39_split :: (phrase: string, work: [] u8) -> u64 {
  words: u64 = 0; high: u64 = 0;
  column: u64;                                    // set at each word's first character
  after_space: u64 = B39_ALL;                       // the text starts after a space
  at: [8] u64;
  for j: 0..<phrase.count {
    c := cast(u64) phrase[j];
    high |= c >> 7;
    letter := b39_eq_mask(c, 32) ^ B39_ALL;         // all ones unless a space
    first := letter & after_space;                  // this character starts a word
    words = add_wrap(words, first & 1);
    column = add_wrap(column, 1) & (first ^ B39_ALL);
    word := sub_wrap(words, 1);                     // the word this character is in
    odd := b39_less_mask(c, 33) | b39_less_mask(126, c) | b39_less_mask(7, column);
    for b: 0..<8 { at[b] = b39_eq_mask(column, cast(u64) b); }
    for s: 0..<24 {
      mine := letter & b39_eq_mask(word, cast(u64) s);
      work[B39_FLAGS + s] |= cast(u8) (odd & mine & 1);
      for b: 0..<8 { work[B39_SLOTS + 8 * s + b] |= cast(u8) (c & mine & at[b]); }
    }
    after_space = letter ^ B39_ALL;
  }
  return words | ((high & 1) << 32);
}
// book:end split

// book:begin join
// Writes the first count slots into work's text with single spaces between
// them and returns its length. Where a word goes depends on the lengths of
// the words before it, so each letter is offered to every position of the
// text and a mask lets one take it.
b39_join :: (work: [] u8, count: int) -> int {
  limit := 9 * count - 1;                           // 8 letters a word and the spaces
  for t: 0..<limit { work[B39_TEXT + t] = 0; }    // mutant: equivalent (the first word's letter always lands at 0)
  at: u64 = 0;
  for s: 0..<count {
    word := b39_slot(work, s);
    if s > 0 { b39_place(work, limit, at, 32); at = add_wrap(at, 1); }
    for c: 0..<8 { b39_place(work, limit, add_wrap(at, cast(u64) c), (word >> cast(u64) (8 * c)) & 255); }
    at = add_wrap(at, b39_letters_ct(word));
  }
  return cast(int) at;
}
b39_place :: (work: [] u8, limit: int, at: u64, value: u64) {
  for t: 0..<limit { work[B39_TEXT + t] |= cast(u8) (value & b39_eq_mask(at, cast(u64) t)); }
}
// book:end join

// book:begin encode
// 16, 20, 24, 28 or 32 bytes of entropy into 12, 15, 18, 21 or 24 words
// with single spaces. Returns the number of characters written, or
// BIP39_BAD_SIZE or BIP39_CAPACITY. work holds the secrets on the way and
// comes back as zeros.
bip39_encode_ct :: (entropy: [] u8, work: [] u8, out: [] u8) -> int #export_c {
  n := entropy.count;
  if n % 4 != 0 || n / 4 < 4 || n / 4 > 8 { return BIP39_BAD_SIZE; }
  if work.count < BIP39_WORK_BYTES { return BIP39_CAPACITY; }
  count := n * 3 / 4;                               // 11 * count = 8 * n + n / 4
  bits := work[B39_BITS..<B39_HASH];               // mutant: equivalent (a longer slice holds the same 33 bytes)
  for i: 0..<n { bits[i] = entropy[i]; }
  #assert sha256_hash_checked(entropy, work[B39_HASH..<B39_TEXT], false) == SHA_OK;  // mutant: equivalent (the hash fills the first 32 bytes of any longer slice)
  bits[n] = work[B39_HASH];                         // its first n / 4 bits are the checksum
  for i: 0..<count {
    v: u64 = 0;                                     // bits 11i to 11i + 10, from the top
    for b: 0..<11 {
      at := 11 * i + b;
      v = (v << 1) | ((cast(u64) bits[at / 8] >> cast(u64) (7 - at % 8)) & 1);
    }
    b39_put(work, i, b39_word_ct(v));
  }
  length := b39_join(work, count);
  result := length;
  if out.count < length { result = BIP39_CAPACITY; }
  else { for i: 0..<length { out[i] = work[B39_TEXT + i]; } }
  for i: 0..<BIP39_WORK_BYTES { work[i] = 0; }
  return result;
}
// book:end encode

// book:begin decode
// Reads a phrase into work: its words in the slots, and their 11-bit
// indexes packed into the bits, entropy first and checksum after. Returns
// the entropy's byte count or a refusal, and leaves work to the caller.
b39_read :: (phrase: string, work: [] u8, room: int) -> int {
  for i: 0..<BIP39_WORK_BYTES { work[i] = 0; }
  if phrase.count > BIP39_MAX_PHRASE { return BIP39_TOO_LONG; }
  split := b39_split(phrase, work);
  if split >> 32 != 0 { return BIP39_NOT_ASCII; }
  count := cast(int) split;
  if count % 3 != 0 || count / 3 < 4 || count / 3 > 8 { return BIP39_BAD_COUNT; }
  n := count * 4 / 3;
  if room < n { return BIP39_CAPACITY; }
  bits := work[B39_BITS..<B39_HASH];               // mutant: equivalent (a longer slice holds the same 33 bytes)
  unknown: u64 = 0;
  for s: 0..<count {
    found := b39_index_ct(b39_slot(work, s));
    unknown |= (found >> 11) | cast(u64) work[B39_FLAGS + s];
    for b: 0..<11 {
      at := 11 * s + b;
      bits[at / 8] |= cast(u8) (((found >> cast(u64) (10 - b)) & 1) << cast(u64) (7 - at % 8));
    }
  }
  #assert sha256_hash_checked(bits[0..<n], work[B39_HASH..<B39_TEXT], false) == SHA_OK;  // mutant: equivalent (the hash fills the first 32 bytes of any longer slice)
  // keep the first count / 3 bits
  keep := cast(u64) ((0xff00 >> (count / 3)) & 0xff);  // mutant: equivalent (0xff01 differs only in bits the shift drops)
  wrong := cast(u64) (work[B39_HASH] ^ bits[n]) & keep;
  if unknown != 0 { return BIP39_UNKNOWN_WORD; }
  if wrong != 0 { return BIP39_BAD_CHECKSUM; }
  return n;
}
// 12, 15, 18, 21 or 24 words, separated by one or more spaces, back into
// their entropy. Returns its byte count (16 to 32) or a refusal, and
// writes out only on success. work comes back as zeros.
bip39_decode_ct :: (phrase: string, work: [] u8, out: [] u8) -> int #export_c {
  if work.count < BIP39_WORK_BYTES { return BIP39_CAPACITY; }
  result := b39_read(phrase, work, out.count);
  if result > 0 { for i: 0..<result { out[i] = work[B39_BITS + i]; } }  // mutant: equivalent (a result is 16 to 32 or negative, never 0 or 1)
  for i: 0..<BIP39_WORK_BYTES { work[i] = 0; }
  return result;
}
// book:end decode

// book:begin seed
// The 64-byte seed of a checked phrase and a passphrase:
// PBKDF2-HMAC-SHA512 of the words joined by single spaces, with the salt
// "mnemonic" + passphrase and 2,048 rounds. Returns 64 or a refusal, and
// writes out only on success. work comes back as zeros.
bip39_seed_ct :: (phrase: string, passphrase: string, work: [] u8, out: [] u8) -> int #export_c {
  return b39_seed(phrase, passphrase, BIP39_ROUNDS, work, out);
}
// The same with any number of rounds, so the checks can run one.
b39_seed :: (phrase: string, passphrase: string, rounds: int, work: [] u8, out: [] u8) -> int {
  if out.count < BIP39_SEED_BYTES || work.count < BIP39_WORK_BYTES { return BIP39_CAPACITY; }
  if passphrase.count > BIP39_MAX_PASSPHRASE { return BIP39_TOO_LONG; }
  high: u64 = 0;
  for i: 0..<passphrase.count { high |= cast(u64) passphrase[i] >> 7; }
  if high != 0 { return BIP39_NOT_ASCII; }
  result := b39_read(phrase, work, 32);            // mutant: equivalent (any room of 32 or more fits the entropy)
  if result > 0 {                                   // mutant: equivalent (a result is 16 to 32 or negative, never 0 or 1)
    length := b39_join(work, result * 3 / 4);
    salt := work[B39_SALT..<B39_SALT + 8 + passphrase.count];
    prefix := "mnemonic";
    for i: 0..<8 { salt[i] = prefix[i]; }
    for i: 0..<passphrase.count { salt[8 + i] = passphrase[i]; }
    #assert pbkdf2_hmac_sha512(work[B39_TEXT..<B39_TEXT + length], salt, rounds, out);
    result = BIP39_SEED_BYTES;
  }
  for i: 0..<BIP39_WORK_BYTES { work[i] = 0; }
  return result;
}
// book:end seed

// ---- the older interface: true or false, or a length or -1

bip39_words :: (entropy: [] u8, out: [] u8) -> int #export_c {
  work: [BIP39_WORK_BYTES] u8;
  r := bip39_encode_ct(entropy, work[..], out);
  return ifx r < 0 then -1 else r;  // mutant: equivalent (r is never 0: a count or a refusal)
}
bip39_entropy_len :: (phrase: string, out: [] u8) -> int #export_c {
  work: [BIP39_WORK_BYTES] u8;
  r := bip39_decode_ct(phrase, work[..], out);
  return ifx r < 0 then -1 else r;  // mutant: equivalent (r is never 0: a count or a refusal)
}
bip39_entropy :: (phrase: string, out: [] u8) -> bool #export_c {
  return bip39_entropy_len(phrase, out) > 0;  // mutant: equivalent (the length is 16 to 32 or -1)
}
// The seed refuses what bip39_decode_ct refuses: an unchecked phrase has no seed here.
bip39_seed_with :: (phrase: string, passphrase: string, out: [] u8) -> bool {
  work: [BIP39_WORK_BYTES] u8;
  return bip39_seed_ct(phrase, passphrase, work[..], out) == BIP39_SEED_BYTES;
}
bip39_seed :: (phrase: string, out: [] u8) -> bool #export_c { return bip39_seed_with(phrase, "", out); }

// ---- public data: variable time

// The i-th word (0..2047), or "". For printing public indexes only.
bip39_word :: (i: int) -> string {
  list := BIP39_ENGLISH;
  if i < 0 || i > 2047 { return ""; }
  at := 0; k := 0;
  while k < i { while list[at] != '\n' { at += 1; } at += 1; k += 1; }
  e := at;
  while list[e] != '\n' { e += 1; }
  return list[at..<e];
}
// A word's index, or -1. It stops at the match: for public words only.
bip39_index :: (w: string) -> int {
  if w.count > 8 { return -1; }                     // the empty word packs to 0, which no entry is
  packed: u64 = 0;
  for c: 0..<w.count { packed |= cast(u64) w[c] << cast(u64) (8 * c); }
  for k: 0..<2048 { if BIP39_TABLE[k] == packed { return k; } }
  return -1;
}

// ---- checks

// Hex to bytes in out (test vectors only).
b39_unhex :: (hex: string, out: [] u8) -> [] u8 {
  for i: 0..<hex.count / 2 { out[i] = cast(u8) (b39_nibble(hex[2 * i]) * 16 + b39_nibble(hex[2 * i + 1])); }
  return out[0..<hex.count / 2];
}
b39_nibble :: (c: u8) -> int { return ifx c >= 'a' then cast(int) (c - 'a') + 10 else cast(int) (c - '0'); }
b39_zero :: (work: [] u8) -> bool {
  for b: work { if b != 0 { return false; } }
  return true;
}
// One vector both ways through the constant-time procedures, with the work
// buffer zero after each call and one character too little room refused.
b39_vector :: (hex: string, words: string) {
  e: [32] u8; out: [BIP39_MAX_TEXT] u8; back: [32] u8; work: [BIP39_WORK_BYTES] u8;
  entropy := b39_unhex(hex, e[..]);
  #assert bip39_encode_ct(entropy, work[..], out[0..<words.count]) == words.count;
  #assert cast(string) out[0..<words.count] == words;
  #assert b39_zero(work[..]);
  #assert bip39_encode_ct(entropy, work[..], out[0..<words.count - 1]) == BIP39_CAPACITY;  // mutant: equivalent (any shorter buffer refuses the same way)
  #assert bip39_decode_ct(words, work[..], back[0..<entropy.count]) == entropy.count;
  #assert cast(string) back[0..<entropy.count] == cast(string) entropy;
  #assert b39_zero(work[..]);
  #assert bip39_decode_ct(words, work[..], back[0..<entropy.count - 1]) == BIP39_CAPACITY;  // mutant: equivalent (any shorter buffer refuses the same way)
}

#test "the English list is the pinned one, and the table is built from it" #steps 100000000 {
  list := BIP39_ENGLISH;
  buf: [13116] u8; h: [32] u8;
  #assert list.count == 13116;
  for i: 0..<list.count { buf[i] = list[i]; }
  #assert sha256_hash_checked(buf[..], h[..], false) == SHA_OK && sha512_hexeq(h[..], BIP39_LIST_SHA256);
  table := b39_make_table();
  for k: 0..<2048 {
    #assert table[k] == BIP39_TABLE[k];
    letters := b39_letters_ct(table[k]);
    #assert letters >= 3 && letters <= 8;
  }
  // the list is sorted, so words that share their first 4 letters would be neighbours; none are
  for k: 1..<2048 { #assert (table[k] & 0xffff_ffff) != (table[k - 1] & 0xffff_ffff); }
  #assert bip39_word(0) == "abandon" && bip39_word(2047) == "zoo" && bip39_word(2048) == "" && bip39_word(-1) == "";
  #assert bip39_index("abandon") == 0 && bip39_index("zoo") == 2047 && bip39_index("zo") == -1;
  #assert bip39_index("abandonx") == -1 && bip39_index("abandonxy") == -1 && bip39_index("") == -1;
}
#forall "the masks: equal and less" a: 0..<20, b: 0..<20 {
  #assert b39_eq_mask(cast(u64) a, cast(u64) b) == (ifx a == b then B39_ALL else 0);
  #assert b39_less_mask(cast(u64) a, cast(u64) b) == (ifx a < b then B39_ALL else 0);
  #assert b39_eq_mask(cast(u64) a << 56, cast(u64) b << 56) == (ifx a == b then B39_ALL else 0);
}
#test "the masks at the top bit" {
  top: u64 = 0x8000_0000_0000_0000;
  #assert b39_eq_mask(top, top) == B39_ALL && b39_eq_mask(top, 0) == 0 && b39_eq_mask(0, top) == 0;
  #assert b39_eq_mask(B39_ALL, B39_ALL) == B39_ALL && b39_eq_mask(B39_ALL, 1) == 0;
}
// Each index (a spread of 64 that sets every bit) to its word and back,
// through the constant-time lookups and the variable-time ones.
#forall "lookups both ways" i: 0..<64 #steps 20000000 {
  k := i * 32 + i % 32;
  word := b39_word_ct(cast(u64) k);
  #assert word == BIP39_TABLE[k] && b39_index_ct(word) == cast(u64) k;
  text: [8] u8; n := cast(int) b39_letters_ct(word);
  for c: 0..<n { text[c] = cast(u8) ((word >> cast(u64) (8 * c)) & 255); }
  #assert bip39_word(k) == cast(string) text[0..<n] && bip39_index(cast(string) text[0..<n]) == k;
}
#test "an unknown word sets bit 11" {
  #assert b39_index_ct(0) == 2048 && b39_index_ct(cast(u64) 'a') == 2048;
  #assert b39_index_ct(BIP39_TABLE[5] | (cast(u64) 'x' << 56)) == 2048;
  #assert b39_word_ct(2048) == 0;
}
#test "splitting: spaces, slots and flags" {
  work: [BIP39_WORK_BYTES] u8;
  #assert b39_split("  zoo   abandon about ", work[..]) == 3;
  #assert b39_slot(work[..], 0) == BIP39_TABLE[2047] && b39_slot(work[..], 1) == BIP39_TABLE[0] && b39_slot(work[..], 2) == BIP39_TABLE[3];
  #assert work[B39_FLAGS] == 0 && work[B39_FLAGS + 1] == 0 && work[B39_FLAGS + 2] == 0 && b39_slot(work[..], 3) == 0;
  for i: 0..<BIP39_WORK_BYTES { work[i] = 0; }
  // 9 letters, a tab, a DEL, a control byte; 8 letters is fine
  odd: [29] u8; text := "abandonxy ab\tc abX Y abstract";
  for i: 0..<29 { odd[i] = text[i]; }
  odd[17] = 0x7f; odd[19] = 1;
  #assert b39_split(cast(string) odd[..], work[..]) == 5;
  #assert work[B39_FLAGS] == 1 && work[B39_FLAGS + 1] == 1 && work[B39_FLAGS + 2] == 1 && work[B39_FLAGS + 3] == 1 && work[B39_FLAGS + 4] == 0;
  #assert b39_slot(work[..], 0) == (BIP39_TABLE[0] | (cast(u64) 'x' << 56)) && b39_slot(work[..], 4) == BIP39_TABLE[7];
  for i: 0..<BIP39_WORK_BYTES { work[i] = 0; }
  #assert b39_split("", work[..]) == 0 && b39_split("    ", work[..]) == 0 && b39_zero(work[..]);
  #assert b39_split("zoo é", work[..]) == (2 | (cast(u64) 1 << 32));
  for i: 0..<BIP39_WORK_BYTES { work[i] = 0; }
  #assert b39_split("~ !", work[..]) == 2 && work[B39_FLAGS] == 0 && work[B39_FLAGS + 1] == 0;
  // a 25th word goes into no slot: the flags and bits after the slots stay zero
  for i: 0..<BIP39_WORK_BYTES { work[i] = 0; }
  #assert b39_split("zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo abstract", work[..]) == 25;
  for i: B39_FLAGS..<B39_TEXT { #assert work[i] == 0; }
}
#test "joining puts each word at its place, and writes no further" {
  work: [BIP39_WORK_BYTES] u8;
  for i: 0..<BIP39_WORK_BYTES { work[i] = 0x5a; }
  b39_put(work[..], 0, BIP39_TABLE[2047]); b39_put(work[..], 1, BIP39_TABLE[7]); b39_put(work[..], 2, BIP39_TABLE[3]);
  n := b39_join(work[..], 3);
  #assert n == 18 && cast(string) work[B39_TEXT..<B39_TEXT + n] == "zoo abstract about";
  for t: n..<26 { #assert work[B39_TEXT + t] == 0; }
  #assert work[B39_TEXT + 26] == 0x5a;
}
#test "the BIP-39 reference vectors, 12, 18 and 24 words" #steps 200000000 {
  b39_vector("00000000000000000000000000000000", "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about");
  b39_vector("7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f", "legal winner thank year wave sausage worth useful legal winner thank yellow");
  b39_vector("ffffffffffffffffffffffffffffffff", "zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo wrong");
  b39_vector("6610b25967cdcca9d59875f5cb50b0ea75433311869e930b", "gravity machine north sort system female filter attitude volume fold club stay feature office ecology stable narrow fog");
  b39_vector("68a79eaca2324873eacc50cb9c6eca8cc68ea5d936f98787c60c7ebc74e6ce7c", "hamster diagram private dutch cause delay private meat slide toddler razor book happy fancy gospel tennis maple dilemma loan word shrug inflict delay length");
  // 15 and 21 words have no reference vector; these come from Python's hashlib and the same list
  b39_vector("000102030405060708090a0b0c0d0e0f10111213", "abandon amount liar amount expire adjust cage candy arch gather drum bullet absurd math exhibit");
  b39_vector("6465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f", "good clinic oil speak note cup random punch hunt logic frame tragic elder robot target august kidney swim butter woman zero");
}
#test "every refusal has its own code, and writes nothing" #steps 200000000 {
  work: [BIP39_WORK_BYTES] u8; out: [32] u8; e: [36] u8; text: [BIP39_MAX_TEXT] u8;
  for i: 0..<32 { out[i] = 7; }
  // entropy sizes
  #assert bip39_encode_ct(e[0..<12], work[..], text[..]) == BIP39_BAD_SIZE && bip39_encode_ct(e[0..<18], work[..], text[..]) == BIP39_BAD_SIZE;
  #assert bip39_encode_ct(e[0..<36], work[..], text[..]) == BIP39_BAD_SIZE && bip39_encode_ct(e[0..<15], work[..], text[..]) == BIP39_BAD_SIZE;
  #assert bip39_encode_ct(e[0..<0], work[..], text[..]) == BIP39_BAD_SIZE && bip39_encode_ct(e[0..<33], work[..], text[..]) == BIP39_BAD_SIZE;
  #assert bip39_encode_ct(e[0..<16], work[0..<BIP39_WORK_BYTES - 1], text[..]) == BIP39_CAPACITY;
  #assert bip39_decode_ct("zoo", work[0..<BIP39_WORK_BYTES - 1], out[..]) == BIP39_CAPACITY;
  // counts: 11, 13, 14 and 25 words, and none
  #assert bip39_decode_ct("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about", work[..], out[..]) == BIP39_BAD_COUNT;
  #assert bip39_decode_ct("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about", work[..], out[..]) == BIP39_BAD_COUNT;
  #assert bip39_decode_ct("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about", work[..], out[..]) == BIP39_BAD_COUNT;
  #assert bip39_decode_ct("zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo vote zoo", work[..], out[..]) == BIP39_BAD_COUNT;
  #assert bip39_decode_ct("zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo", work[..], out[..]) == BIP39_BAD_COUNT;
  #assert bip39_decode_ct("zoo zoo zoo zoo zoo zoo zoo zoo zoo", work[..], out[..]) == BIP39_BAD_COUNT;
  #assert bip39_decode_ct("", work[..], out[..]) == BIP39_BAD_COUNT && bip39_decode_ct("   ", work[..], out[..]) == BIP39_BAD_COUNT;
  // an unknown word, a capital, 9 letters, a tab; then each checksum length
  #assert bip39_decode_ct("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abut", work[..], out[..]) == BIP39_UNKNOWN_WORD;
  #assert bip39_decode_ct("Abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about", work[..], out[..]) == BIP39_UNKNOWN_WORD;
  #assert bip39_decode_ct("abandonxy abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about", work[..], out[..]) == BIP39_UNKNOWN_WORD;
  #assert bip39_decode_ct("abandon\tabandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about", work[..], out[..]) == BIP39_UNKNOWN_WORD;
  #assert bip39_decode_ct("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon", work[..], out[..]) == BIP39_BAD_CHECKSUM;
  // 15 words, 5 checksum bits: exhibit is 636, exist 638
  #assert bip39_decode_ct("abandon amount liar amount expire adjust cage candy arch gather drum bullet absurd math exist", work[..], out[..]) == BIP39_BAD_CHECKSUM;
  // 18 words, 6 bits: agent is 39, agree 40
  #assert bip39_decode_ct("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon agree", work[..], out[..]) == BIP39_BAD_CHECKSUM;
  // 21 words, 7 bits: zero is 2045, zone 2046
  #assert bip39_decode_ct("good clinic oil speak note cup random punch hunt logic frame tragic elder robot target august kidney swim butter woman zone", work[..], out[..]) == BIP39_BAD_CHECKSUM;
  // 24 words, 8 bits: art is 102, arrest 99
  #assert bip39_decode_ct("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon arrest", work[..], out[..]) == BIP39_BAD_CHECKSUM;
  // a byte above 0x7f; a phrase over 1,024 bytes
  #assert bip39_decode_ct("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon aboût", work[..], out[..]) == BIP39_NOT_ASCII;
  long: [1025] u8; for i: 0..<1025 { long[i] = 32; }
  #assert bip39_decode_ct(cast(string) long[..], work[..], out[..]) == BIP39_TOO_LONG;
  #assert bip39_decode_ct(cast(string) long[0..<1024], work[..], out[..]) == BIP39_BAD_COUNT;
  for i: 0..<32 { #assert out[i] == 7; }
  #assert b39_zero(work[..]);
}
#test "the seed refuses before any work, and refuses what decoding refuses" #steps 100000000 {
  work: [BIP39_WORK_BYTES] u8; seed: [65] u8;
  for i: 0..<65 { seed[i] = 7; }
  for i: 0..<BIP39_WORK_BYTES { work[i] = 0x5a; }
  long: [1017] u8; for i: 0..<1017 { long[i] = 'a'; }
  #assert bip39_seed_ct("zoo", "", work[..], seed[0..<63]) == BIP39_CAPACITY;
  #assert bip39_seed_ct("zoo", "", work[0..<BIP39_WORK_BYTES - 1], seed[..]) == BIP39_CAPACITY;
  #assert bip39_seed_ct("zoo", cast(string) long[..], work[..], seed[..]) == BIP39_TOO_LONG;
  #assert bip39_seed_ct("zoo", "café", work[..], seed[..]) == BIP39_NOT_ASCII;
  high := [2] u8.[0x80, 'a'];
  #assert bip39_seed_ct("zoo", cast(string) high[..], work[..], seed[..]) == BIP39_NOT_ASCII;
  for i: 0..<BIP39_WORK_BYTES { #assert work[i] == 0x5a; }
  #assert bip39_seed_ct("zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo", "", work[..], seed[..]) == BIP39_BAD_CHECKSUM;
  #assert b39_zero(work[..]);
  #assert bip39_seed_ct("zoo zoo zoo", "", work[..], seed[..]) == BIP39_BAD_COUNT;
  #assert bip39_seed_ct("zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo zoo", "", work[..], seed[..]) == BIP39_BAD_CHECKSUM;
  #assert bip39_seed_ct("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abut", "", work[..], seed[..]) == BIP39_UNKNOWN_WORD;
  for i: 0..<65 { #assert seed[i] == 7; }
}
// One and two rounds against Python's hashlib: the joined words (one space
// between them however the phrase was typed), the salt, and the limits.
#test "the seed's password and salt, with one and two rounds" #steps 400000000 {
  work: [BIP39_WORK_BYTES] u8; seed: [65] u8;
  for i: 0..<BIP39_WORK_BYTES { work[i] = 0x5a; }
  seed[64] = 7;
  #assert b39_seed("  abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon  about ", "TREZOR", 1, work[..], seed[..]) == 64;
  #assert sha512_hexeq(seed[0..<64], "93b97bc5354ec701eae542a773d5de60660589bf0d9a171061230590acbc1754004a1cd231299f2e3a44ec43472c2b276ae9868caacbc02bcfb662fb3a6f9a46");
  #assert seed[64] == 7 && b39_zero(work[..]);
  #assert b39_seed("hamster diagram private dutch cause delay private meat slide toddler razor book happy fancy gospel tennis maple dilemma loan word shrug inflict delay length", "TREZOR", 2, work[..], seed[0..<64]) == 64;
  #assert sha512_hexeq(seed[0..<64], "2058283e5d8005f3482149148068c5dc7bc3f447019d81f1667ffd85886e64f78e9dfa8ced000d7a93068bb552fae26221a0846ad937a879816278fd4d9df0ec");
  // 24 words of 8 letters each, 215 characters, and a 1,016-byte passphrase
  words := "announce artefact attitude bachelor broccoli business category champion cinnamon congress consider convince cupboard daughter december decorate decrease describe dinosaur disagree discover disorder distance bachelor";
  #assert words.count == BIP39_MAX_TEXT;
  b39_vector("09419c3a8891c63e0909302905e0bd17c35c6f8e29c8392770f99f63ee7ecfe8", words);
  long: [1016] u8; for i: 0..<1016 { long[i] = 'a'; }
  #assert b39_seed(words, cast(string) long[..], 1, work[..], seed[0..<64]) == 64;
  #assert sha512_hexeq(seed[0..<64], "864888e0f2f253ff572ab9f8f3b33bb49ea476acfa0703d1d69d0450293e386527247625b9eed5b4408a7f05288b588f3829cfcaed9baf7b4e7ad289947d0586");
  #assert b39_zero(work[..]);
}
// The full 2,048 rounds once: the first reference vector with TREZOR.
#test "the seed of the first reference vector" #steps 2000000000 {
  seed: [64] u8;
  // through the older interface, which calls bip39_seed_ct
  #assert bip39_seed_with("abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about", "TREZOR", seed[..]);
  #assert sha512_hexeq(seed[..], "c55257c360c07c72029aebc1b53c05ed0362ada38ead3e3e9efa3708e53495531f09a6987599d18264c1e1c92f2cf141630c7a3c4ab7c81b2f001698e7463b04");
}
#test "b39_zero sees a byte at either end" {
  z: [3] u8;
  #assert b39_zero(z[..]) && b39_zero(z[0..<0]);
  z[0] = 1; #assert !b39_zero(z[..]);
  z[0] = 0; z[2] = 1; #assert !b39_zero(z[..]);
}
#test "the older interface keeps its answers" #steps 200000000 {
  e: [16] u8; out: [200] u8; back: [32] u8;
  n := bip39_words(e[..], out[..]);
  #assert n == 93 && bip39_words(e[0..<15], out[..]) == -1 && bip39_words(e[..], out[0..<10]) == -1;
  #assert bip39_entropy_len(cast(string) out[0..<n], back[..]) == 16 && bip39_entropy(cast(string) out[0..<n], back[..]);
  #assert bip39_entropy_len("zoo", back[..]) == -1 && !bip39_entropy("x", back[0..<15]);
  #assert bip39_entropy_len(cast(string) out[0..<n], back[0..<15]) == -1;
  #assert !bip39_seed("x", back[..]);
  #assert !bip39_seed_with(cast(string) out[0..<n], "", back[..]);   // 32 bytes is too small for a seed
}

