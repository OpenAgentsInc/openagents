    "bf61610161629f0203ffff",
    "826161bf61626163ff",
    "bf6346756ef563416d7421ff"];
  for h: inside { #assert cb_reads(h); }
  for h: outside { #assert !cb_reads(h); }
  b: [32] u8;
  #assert cbor_int(b[..], cbor_read(cb_unhex("1b000000e8d4a51000", b[..]))).value == 1000000000000;
  #assert cbor_int(b[..], cbor_read(cb_unhex("3903e7", b[..]))).value == -1000;
  #assert cbor_read(cb_unhex("3bffffffffffffffff", b[..])).arg == 18446744073709551615;
  m := cb_unhex("a26161016162820203", b[..]);
  #assert cbor_int(m, cbor_map_text(m, cbor_read(m), "a")).value == 1 && cbor_map_text(m, cbor_read(m), "b").major == CBOR_ARRAY;
}

// ---- heads
// The head at data[at]: major type, argument and where its payload starts,
// shortest form only. ok false for anything outside the subset or cut.
cbor_head :: (data: [] u8, at: int) -> CborItem #effects(all) {
  if at < 0 || at >= data.count || data.count > CBOR_MAX_BYTES { return CborItem.{}; }
  first := data[at];
  major := cast(int) (first >> 5); info := cast(int) (first & 31);
  if major > CBOR_MAP || info > 27 { return CborItem.{}; }
  width := 0;
  if info == 24 { width = 1; } else if info == 25 { width = 2; } else if info == 26 { width = 4; } else if info == 27 { width = 8; }
  if data.count - at - 1 < width { return CborItem.{}; }
  arg := cast(u64) info;
  if width > 0 {
    arg = 0;
    for i: 0..<width { arg = (arg << 8) | cast(u64) data[at + 1 + i]; }
    // Shortest form: one byte from 24, two from 256, four from 65536, eight from 2^32.
    least := ifx width == 1 then cast(u64) 24 else cast(u64) 1 << cast(u64) (4 * width);
    if arg < least { return CborItem.{}; }
  }
  return CborItem.{major=major,arg=arg,at=at,data=at+1+width,ok=true};
}

// ---- UTF-8
// Well-formed UTF-8 (RFC 3629): no overlong form, no surrogate, nothing
// above U+10FFFF. A lead byte from C2 to F4 starts 2, 3 or 4 bytes; its
// second byte has a narrower range after E0, ED, F0 and F4.
cbor_utf8 :: (text: [] u8) -> bool #effects(all) {
  i := 0;
  while i < text.count {
    c := text[i];
    if c < 0x80 { i += 1; continue; }
    if c < 0xc2 || c > 0xf4 { return false; }
    n := ifx c >= 0xf0 then 3 else ifx c >= 0xe0 then 2 else 1;
    low := ifx c == 0xe0 then cast(u8) 0xa0 else ifx c == 0xf0 then cast(u8) 0x90 else cast(u8) 0x80;
    high := ifx c == 0xed then cast(u8) 0x9f else ifx c == 0xf4 then cast(u8) 0x8f else cast(u8) 0xbf;
    if text.count - i <= n { return false; }
    if text[i + 1] < low || text[i + 1] > high { return false; }
    for k: 2..<n+1 { if text[i + k] < 0x80 || text[i + k] > 0xbf { return false; } }
    i += n + 1;
  }
  return true;
}

// ---- items
// The end of the whole item at data[at], everything nested in it included,
// or -1. No recursion: `left` counts the items still to read, and each one
// takes at least a byte, so the loop ends within the input. Strings must
// fit the input and text must be UTF-8. Keys are not compared here.
cbor_walk :: (data: [] u8, at: int) -> int #effects(all) {
  left: u64 = 1; pos := at;
  while left > 0 {
    head := cbor_head(data, pos);
    if !head.ok { return -1; }
    left -= 1; pos = head.data;
    remaining := cast(u64) (data.count - pos);
    if head.major == CBOR_BYTES || head.major == CBOR_TEXT {
      if head.arg > remaining { return -1; }
      end := pos + cast(int) head.arg;
      if head.major == CBOR_TEXT && !cbor_utf8(data[pos..<end]) { return -1; }
      pos = end;
    } else if head.major == CBOR_ARRAY {
      if head.arg > remaining { return -1; }
      left += head.arg;
    } else if head.major == CBOR_MAP {
      if head.arg > CBOR_MAP_MAX { return -1; }
      left += 2 * head.arg;
    }
  }
  return pos;
}
// True when every map in the well-formed item data[at..<end] has keys
// whose encodings all differ (shortest-form heads make equal keys encode
// equally). It visits every head in order and compares each map's keys.
cbor_unique :: (data: [] u8, at: int, end: int) -> bool #effects(all) {
  pos := at;
  while pos < end {
    head := cbor_head(data, pos);
    pos = head.data;
    if head.major == CBOR_BYTES || head.major == CBOR_TEXT { pos += cast(int) head.arg; }
    if head.major == CBOR_MAP {
      starts: [CBOR_MAP_MAX] int; ends: [CBOR_MAP_MAX] int; key := pos;
      for i: 0..<cast(int) head.arg {
        starts[i] = key; ends[i] = cbor_walk(data, key); key = cbor_walk(data, ends[i]);
        for j: 0..<i {
          if ends[j] - starts[j] == ends[i] - starts[i] {
            same := true;
            for k: 0..<ends[i]-starts[i] { if data[starts[j]+k] != data[starts[i]+k] { same = false; } }
            if same { return false; }
          }
        }
      }
    }
  }
  return true;
}
// One whole item at data[at]: its head, and end past everything in it.
cbor_at :: (data: [] u8, at: int) -> CborItem #effects(all) {
  top := cbor_head(data, at);
  if !top.ok { return CborItem.{}; }
  end := cbor_walk(data, at);
  if end == -1 || !cbor_unique(data, at, end) { return CborItem.{}; }
  top.end = end;
  return top;
}
// The whole input as one item, with nothing after it.
cbor_read :: (data: [] u8) -> CborItem #effects(all) {
  item := cbor_at(data, 0);
  if !item.ok || item.end != data.count { return CborItem.{}; }
  return item;
}
// A byte or text string's payload.
cbor_payload :: (data: [] u8, item: CborItem) -> [] u8 #effects(all) {
  if !item.ok || (item.major != CBOR_BYTES && item.major != CBOR_TEXT) { return data[0..<0]; }
  return data[item.data..<item.data + cast(int) item.arg];
}
// An unsigned or negative integer that fits s64.
cbor_int :: (data: [] u8, item: CborItem) -> CborInt #effects(all) {
  if !item.ok || item.arg > 9223372036854775807 { return CborInt.{}; }
  if item.major == CBOR_UINT { return CborInt.{value=cast(s64) item.arg,ok=true}; }
  if item.major == CBOR_NEGATIVE { return CborInt.{value=-1 - cast(s64) item.arg,ok=true}; }
  return CborInt.{};
}
// The value under an integer key, or ok false. The map came from cbor_at
// or cbor_read, so its keys are unique and its items are whole.
cbor_map_int :: (data: [] u8, map: CborItem, key: s64) -> CborItem #effects(all) {
  if !map.ok || map.major != CBOR_MAP { return CborItem.{}; }
  pos := map.data;
  for i: 0..<cast(int) map.arg {
    k := cbor_at(data, pos);
    value := cbor_at(data, k.end);
    got := cbor_int(data, k);
    if got.ok && got.value == key { return value; }
    pos = value.end;
  }
  return CborItem.{};
}
// The value under a text key, or ok false.
cbor_map_text :: (data: [] u8, map: CborItem, key: string) -> CborItem #effects(all) {
  if !map.ok || map.major != CBOR_MAP { return CborItem.{}; }
  pos := map.data;
  for i: 0..<cast(int) map.arg {
    k := cbor_at(data, pos);
    value := cbor_at(data, k.end);
    if k.major == CBOR_TEXT && cast(string) cbor_payload(data, k) == key { return value; }
    pos = value.end;
  }
  return CborItem.{};
}
