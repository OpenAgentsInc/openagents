// Experimental full-domain fused total field reductions for ECDH.
#load "secp_group32.coax";
#authority;
#test "fused reducers accept full-width and canonical edges" {
  max:Sf32;for i:0..<8 {max.limb[i]=cast(u32)SF32_WORD;}
  #assert sf32_equal(ef_field_add(max,max),sf32_add_total(max,max));
  #assert sf32_equal(ef_field_sqr(max),sf32_mul(max,max));
}
#forall "fused reducers match independent total reducers across limbs" index:0..<8 {
  a:Sf32;b:Sf32;for i:0..<8 {a.limb[i]=cast(u32)(123456789+i*991);b.limb[i]=cast(u32)(345678901+i*313);}
  a.limb[index]=cast(u32)SF32_WORD;b.limb[index]=cast(u32)SF32_WORD;
  #assert sf32_equal(ef_field_add(a,b),sf32_add_total(a,b));
  #assert sf32_equal(ef_field_mul(a,b),sf32_mul(a,b));
}
#test "fused inverse returns zero for zero and inverse for two" {
  zero:Sf32;one:Sf32;one.limb[0]=1;two:Sf32;two.limb[0]=2;
  #assert sf32_equal(ef_inverse(zero),zero);
  #assert sf32_equal(ef_field_mul(two,ef_inverse(two)),one);
}
#forall "fused finish complete-mask selection preserves each limb" index:0..<8,carry:0..<2 {
  f:Sf32Fold;f.value.limb[index]=123456789;f.carry=cast(u64)carry;
  candidate:=sf32_fold_total(f.value,1);want:=ifx carry==1 then candidate.value else f.value;
  #assert sf32_equal(ef_finish(f),want);
}
#test "fused group formulas agree with the checked canonical group kernel" {
  g:=sg32_from_point(sg_generator());zero:=sg32_infinity();
  #assert sg_equal_mask(sg32_to_point(ef_double(g)),sg32_to_point(sg32_double(g)))==CB_MAX64;
  #assert sg_equal_mask(sg32_to_point(ef_add(g,g)),sg32_to_point(sg32_add(g,g)))==CB_MAX64;
  #assert sg_equal_mask(sg32_to_point(ef_add(g,zero)),sg32_to_point(g))==CB_MAX64;
}
#test "fused group addition covers distinct, opposite and infinity points" {
  g:=sg32_from_point(sg_generator());twice:=sg32_double(g);zero:Sf32;negative:=g;negative.y=sf32_sub(zero,g.y);inf:=sg32_infinity();
  #assert sg_equal_mask(sg32_to_point(ef_add(g,twice)),sg32_to_point(sg32_add(g,twice)))==CB_MAX64;
  #assert sg_equal_mask(sg32_to_point(ef_add(g,negative)),sg_infinity())==CB_MAX64;
  #assert sg_equal_mask(sg32_to_point(ef_add(inf,g)),sg32_to_point(g))==CB_MAX64;
}
ef_finish :: (folded:Sf32Fold)->Sf32 #effects(all) {
  candidate:=sf32_fold_total(folded.value,1);defer {secure_zero(candidate.value.limb[..]);#assert crypto_zeroed(candidate.value.limb[..]);}
  mask:=cast,trunc(u32)(cb_mask(folded.carry|candidate.carry));r:Sf32;defer {secure_zero(r.limb[..]);#assert crypto_zeroed(r.limb[..]);}
  r.limb[0]=folded.value.limb[0]^((folded.value.limb[0]^candidate.value.limb[0])&value_barrier(mask));
  r.limb[1]=folded.value.limb[1]^((folded.value.limb[1]^candidate.value.limb[1])&value_barrier(mask));
  r.limb[2]=folded.value.limb[2]^((folded.value.limb[2]^candidate.value.limb[2])&value_barrier(mask));
  r.limb[3]=folded.value.limb[3]^((folded.value.limb[3]^candidate.value.limb[3])&value_barrier(mask));
  r.limb[4]=folded.value.limb[4]^((folded.value.limb[4]^candidate.value.limb[4])&value_barrier(mask));
  r.limb[5]=folded.value.limb[5]^((folded.value.limb[5]^candidate.value.limb[5])&value_barrier(mask));
  r.limb[6]=folded.value.limb[6]^((folded.value.limb[6]^candidate.value.limb[6])&value_barrier(mask));
  r.limb[7]=folded.value.limb[7]^((folded.value.limb[7]^candidate.value.limb[7])&value_barrier(mask));
  return r;
}
ef_field_add :: (a:Sf32,b:Sf32)->Sf32 #effects(all) {
  r:Sf32;defer {secure_zero(r.limb[..]);#assert crypto_zeroed(r.limb[..]);}carry:u64;
  for i:0..<8 {wide:=cast(u64)a.limb[i]+cast(u64)b.limb[i]+carry;r.limb[i]=cast,trunc(u32)(wide);carry=wide>>32;}
  return ef_finish(sf32_fold_total(r,carry));
}
// Same fixed-work wide field as the base-point and self-verification paths.
ef_field_mul :: (a:Sf32,b:Sf32)->Sf32 #effects(all) { return fc_mul32(a,b); }
ef_double :: (p:Sg32)->Sg32 #effects(all) {
  aa:=ef_field_sqr(p.x);defer {secure_zero(aa.limb[..]);#assert crypto_zeroed(aa.limb[..]);}bb:=ef_field_sqr(p.y);defer {secure_zero(bb.limb[..]);#assert crypto_zeroed(bb.limb[..]);}cc:=ef_field_sqr(bb);defer {secure_zero(cc.limb[..]);#assert crypto_zeroed(cc.limb[..]);}
  q:=ef_field_add(p.x,bb);defer {secure_zero(q.limb[..]);#assert crypto_zeroed(q.limb[..]);}dd:=sf32_sub(sf32_sub(ef_field_sqr(q),aa),cc);defer {secure_zero(dd.limb[..]);#assert crypto_zeroed(dd.limb[..]);}dd=ef_field_add(dd,dd);
  ee:=ef_field_add(ef_field_add(aa,aa),aa);defer {secure_zero(ee.limb[..]);#assert crypto_zeroed(ee.limb[..]);}ff:=ef_field_sqr(ee);defer {secure_zero(ff.limb[..]);#assert crypto_zeroed(ff.limb[..]);}
  r:Sg32;defer {secure_zero(r.x.limb[..]);#assert crypto_zeroed(r.x.limb[..]);}defer {secure_zero(r.y.limb[..]);#assert crypto_zeroed(r.y.limb[..]);}defer {secure_zero(r.z.limb[..]);#assert crypto_zeroed(r.z.limb[..]);}r.x=sf32_sub(ff,ef_field_add(dd,dd));
  eightcc:=ef_field_add(cc,cc);defer {secure_zero(eightcc.limb[..]);#assert crypto_zeroed(eightcc.limb[..]);}eightcc=ef_field_add(eightcc,eightcc);eightcc=ef_field_add(eightcc,eightcc);
  r.y=sf32_sub(ef_field_mul(ee,sf32_sub(dd,r.x)),eightcc);
  yz:=ef_field_mul(p.y,p.z);defer {secure_zero(yz.limb[..]);#assert crypto_zeroed(yz.limb[..]);}r.z=ef_field_add(yz,yz);return sg32_canonical_infinity(r);
}
ef_add :: (a:Sg32,b:Sg32)->Sg32 #effects(all) {
  z1z1:=ef_field_sqr(a.z);defer {secure_zero(z1z1.limb[..]);#assert crypto_zeroed(z1z1.limb[..]);}z2z2:=ef_field_sqr(b.z);defer {secure_zero(z2z2.limb[..]);#assert crypto_zeroed(z2z2.limb[..]);}
  u1:=ef_field_mul(a.x,z2z2);defer {secure_zero(u1.limb[..]);#assert crypto_zeroed(u1.limb[..]);}u2:=ef_field_mul(b.x,z1z1);defer {secure_zero(u2.limb[..]);#assert crypto_zeroed(u2.limb[..]);}
  s1:=ef_field_mul(a.y,ef_field_mul(b.z,z2z2));defer {secure_zero(s1.limb[..]);#assert crypto_zeroed(s1.limb[..]);}s2:=ef_field_mul(b.y,ef_field_mul(a.z,z1z1));defer {secure_zero(s2.limb[..]);#assert crypto_zeroed(s2.limb[..]);}
  h:=sf32_sub(u2,u1);defer {secure_zero(h.limb[..]);#assert crypto_zeroed(h.limb[..]);}twoh:=ef_field_add(h,h);defer {secure_zero(twoh.limb[..]);#assert crypto_zeroed(twoh.limb[..]);}ii:=ef_field_sqr(twoh);defer {secure_zero(ii.limb[..]);#assert crypto_zeroed(ii.limb[..]);}jj:=ef_field_mul(h,ii);defer {secure_zero(jj.limb[..]);#assert crypto_zeroed(jj.limb[..]);}
  diff:=sf32_sub(s2,s1);defer {secure_zero(diff.limb[..]);#assert crypto_zeroed(diff.limb[..]);}rr:=ef_field_add(diff,diff);defer {secure_zero(rr.limb[..]);#assert crypto_zeroed(rr.limb[..]);}vv:=ef_field_mul(u1,ii);defer {secure_zero(vv.limb[..]);#assert crypto_zeroed(vv.limb[..]);}
  r:Sg32;defer {secure_zero(r.x.limb[..]);#assert crypto_zeroed(r.x.limb[..]);}defer {secure_zero(r.y.limb[..]);#assert crypto_zeroed(r.y.limb[..]);}defer {secure_zero(r.z.limb[..]);#assert crypto_zeroed(r.z.limb[..]);}r.x=sf32_sub(sf32_sub(ef_field_sqr(rr),jj),ef_field_add(vv,vv));
  t:=ef_field_mul(s1,jj);defer {secure_zero(t.limb[..]);#assert crypto_zeroed(t.limb[..]);}r.y=sf32_sub(ef_field_mul(rr,sf32_sub(vv,r.x)),ef_field_add(t,t));
  zsum:=ef_field_add(a.z,b.z);defer {secure_zero(zsum.limb[..]);#assert crypto_zeroed(zsum.limb[..]);}r.z=ef_field_mul(sf32_sub(sf32_sub(ef_field_sqr(zsum),z1z1),z2z2),h);
  zero:Sf32;same:=sg32_mask_equal(h,zero)&sg32_mask_equal(s1,s2);
  r=sg32_choose(same,ef_double(a),r);
  r=sg32_choose(sg32_mask_equal(a.z,zero),b,r);
  r=sg32_choose(sg32_mask_equal(b.z,zero),a,r);return sg32_canonical_infinity(r);
}
// The immutable public chain is admitted at compile time before any use.
ef_schedule_valid :: (chain:[12]SfChainStep)->bool #effects(all) {
  for i:0..<12 {if !sf_chain_step_valid(chain[i],i) {return false;}}return true;
}
#assert #run ef_schedule_valid(SF_FIELD_CHAIN);
#test "the fixed exponent schedule satisfies every public bound" {#assert ef_schedule_valid(SF_FIELD_CHAIN);}
#forall "schedule validation rejects a bad step at each position" index:0..<12 {
  chain:=SF_FIELD_CHAIN;chain[index].left=index+1;#assert !ef_schedule_valid(chain);
}
// Public fixed exponent schedule inherited from the reviewed field chain.
ef_square_n :: (a:Sf32,count:int)->Sf32 #effects(all) {
  // Private: count is supplied by the validated public exponent schedule.
  r:=a;defer {secure_zero(r.limb[..]);#assert crypto_zeroed(r.limb[..]);}for i:0..<count {r=ef_field_sqr(r);}return r;
}
ef_inverse :: (a:Sf32)->Sf32 #effects(all) {
  cache:[13]Sf32;defer {for i:0..<13 {secure_zero(cache[i].limb[..]);}for item:cache {for word:item.limb {#assert word==0;}}}cache[0]=a;
  for i:0..<12 {
    step:=SF_FIELD_CHAIN[i];
    cache[i+1]=ef_field_mul(ef_square_n(cache[step.left],step.squares),cache[step.right]);
  }
  power9:=ef_field_mul(ef_field_sqr(cache[1]),cache[1]);defer {secure_zero(power9.limb[..]);#assert crypto_zeroed(power9.limb[..]);}
  power45:=ef_field_mul(ef_square_n(power9,2),power9);defer {secure_zero(power45.limb[..]);#assert crypto_zeroed(power45.limb[..]);}
  return ef_field_mul(ef_square_n(cache[12],10),power45);
}

ef_field_sqr :: (a:Sf32) -> Sf32 #effects(all) {return fc_square32(a);}
