// Public BIP-340 verification. Variable-time throughout: never pass secrets.
// Prepared records and mathematical helper results are internal data, NOT
// verified authority. Only the complete byte-view entry performs verification.
// coax test coax/lib/crypto/schnorr.coax --library
#load "secp_fast.coax";
#load "sha256.coax";
#load "../../tests/nostr/schnorr_checks.coax";
#authority;
SV_MAX_MESSAGE :: 1048576;
SV_TAG_HASH :: #run S_hash("BIP0340/challenge");
// SHA-256 after the complete tag-hash || tag-hash block (BIP-340).
// Checked against the ordinary streaming path below; no compile-time hash.
sv_challenge_state :: () -> Sha256Work #effects(all) {
  return Sha256Work.{h=[8] u32.[0x9cecba11,0x23925381,0x11679112,0xd1627e0f,0x97c87550,0x003cc765,0x90f61164,0x33e9b66a],total=64,phase=SHA_ACTIVE};
}
#forall "challenge midstate equals the full tagged hash across padding boundaries" length: 0..<8 {
  sizes := [8] int.[0,1,31,32,55,56,64,129];
  input: [129] u8; key: [32] u8; r: [32] u8;
  for i: 0..<129 { input[i] = cast(u8) i; }
  for i: 0..<32 { key[i] = cast(u8) (i + 32); r[i] = cast(u8) (255 - i); }
  full: [112] u8; tag: [32] u8; digest: [32] u8;
  h := S_hash("BIP0340/challenge");
  #assert sha256_emit(h.words[..], tag[..]) == SHA_OK && sha256_init(full[..]) == SHA_OK;
  #assert sha256_update_checked(full[..], tag[..], false) == SHA_OK;
  #assert sha256_update_checked(full[..], tag[..], false) == SHA_OK;
  expected := sha256_unpack(full[..]); actual := sv_challenge_state();
  #assert expected.total == actual.total && expected.phase == actual.phase && actual.used == 0;
  for i: 0..<8 { #assert expected.h[i] == actual.h[i]; }
  #assert sha256_update_checked(full[..], r[..], false) == SHA_OK;
  #assert sha256_update_checked(full[..], key[..], false) == SHA_OK;
  #assert sha256_update_checked(full[..], input[0..<sizes[length]], false) == SHA_OK;
  #assert sha256_final_checked(full[..], digest[..], false) == SHA_OK;
  got := sv_challenge_vartime(input[0..<sizes[length]], key[..], r[..]);
  #assert got.ok && sc_equal(got.value, sc_reduce_bytes(digest[..]).value);
}
SvPrepared :: struct { s: ScScalar; negative_e: ScScalar; point: SgPoint; r: SecpField; ready: bool; }

sv_lengths_vartime :: (message_count: int,public_count: int,signature_count: int) -> bool #effects(all) {
  return message_count >= 0 && message_count <= SV_MAX_MESSAGE && public_count == 32 && signature_count == 64;
}
// Signature-r || public-key || message is fed as separate borrowed chunks.
// The local state, tag hash and output cannot overlap caller-owned inputs.
sv_challenge_vartime :: (message: [] u8,public_key: [] u8,r: [] u8) -> ScLoad #effects(all) {
  if r.count != 32 || !sv_lengths_vartime(message.count,public_key.count,64) { return ScLoad.{}; }
  out: [32] u8; state: [112] u8;
  status := sha256_pack(sv_challenge_state(),state[..]); if status != SHA_OK { return ScLoad.{}; }
  status = sha256_update_checked(state[..],r,false); if status != SHA_OK { return ScLoad.{}; }
  status = sha256_update_checked(state[..],public_key,false); if status != SHA_OK { return ScLoad.{}; }
  status = sha256_update_checked(state[..],message,false); if status != SHA_OK { return ScLoad.{}; }
  status = sha256_final_checked(state[..],out[..],false); if status != SHA_OK { return ScLoad.{}; }
  return sc_reduce_bytes(out[..]);
}
// ready means preparation succeeded, not that this signature is valid.
sv_prepare_vartime :: (message: [] u8,public_key: [] u8,signature: [] u8) -> SvPrepared #effects(all) {
  result: SvPrepared;
  if !sv_lengths_vartime(message.count,public_key.count,signature.count) { return result; }
  r := sf_load_strict(signature[0..<32]); s := sc_load(signature[32..<64]);
  if !r.ok || !s.ok { return result; }
  point := sg_lift_x_public(public_key); if !point.ok { return result; }
  challenge := sv_challenge_vartime(message,public_key,signature[0..<32]); if !challenge.ok { return result; }
  return SvPrepared.{s=s.value,negative_e=sc_negate(challenge.value),point=point.value,r=r.value,ready=true};
}
sv_prepare_nostr_vartime :: (nostr_id: [] u8,public_key: [] u8,signature: [] u8) -> SvPrepared #effects(all) {
  if nostr_id.count != 32 { return SvPrepared.{}; }
  return sv_prepare_vartime(nostr_id,public_key,signature);
}
// Inputs come from the canonical affine conversion below. Refusals and
// infinity have a nonzero infinity flag, so they cannot pass this comparison.
sv_affine_matches_vartime :: (r: SecpField,affine: SgAffine) -> bool #effects(all) {
  return affine.infinity == 0 && (affine.y.limb[0]&1) == 0 && sf_equal_mask(r,affine.x) == CB_MAX64;
}
// This is only a mathematical equation comparison over internal data. A forged
// prepared record is NOT a verified signature. It stays non-exported.
sv_prepared_matches_vartime :: (prepared: SvPrepared) -> bool #effects(all) {
  if !prepared.ready { return false; }
  // Chapter 77's endomorphism path: the same point as ecmult_vartime.
  result := ecmult_glv_vartime(prepared.s,prepared.point,prepared.negative_e);
  // Group APIs map every refusal to canonical infinity; affine conversion
  // preserves a nonzero infinity flag, which the comparison rejects.
  affine := sg_to_affine(result.value);
  return sv_affine_matches_vartime(prepared.r,affine.value);
}
schnorr_verify_vartime :: (message: [] u8,public_key: [] u8,signature: [] u8) -> bool #export_c #effects(all) {
  if !sv_lengths_vartime(message.count,public_key.count,signature.count) { return false; }
  r := fe_load_vartime(signature[0..<32]); s := sc_load(signature[32..<64]);
  if !r.ok { return false; }
  if !s.ok { return false; }
  point := fg_lift_x_vartime(public_key); if !point.ok { return false; }
  challenge := sv_challenge_vartime(message,public_key,signature[0..<32]);
  return challenge.ok && fg_matches_even_x_vartime(fg_ecmult_vartime(s.value,point.value,sc_negate(challenge.value)),r.value);
}
nostr_verify_vartime :: (nostr_id: [] u8,public_key: [] u8,signature: [] u8) -> bool #export_c #effects(all) {
  if nostr_id.count != 32 { return false; }
  return schnorr_verify_vartime(nostr_id,public_key,signature);
}

// ---- the entry against chapter 23's equation
#forall "the entry decides as the equation on the 26-bit field does" change: 0..<10 #steps 2000000000 #traversal 2000000000 {
  // BIP-340's vector 0 (secret key 3, message zero).
  message: [32] u8;
  key := [32] u8.[249,48,138,1,146,88,195,16,73,52,79,133,248,157,82,41,181,49,200,69,131,111,153,176,134,1,241,19,188,224,54,249];
  sig := [64] u8.[233,7,131,31,128,132,141,16,105,165,55,27,64,36,16,54,75,223,28,95,131,7,176,8,76,85,241,206,45,202,130,21,37,246,106,74,133,234,139,113,228,130,167,79,56,45,44,229,235,238,232,253,178,23,47,71,125,244,144,13,49,5,54,192];
  if change == 1 { message[7] ^= 16; }
  if change == 2 { sig[9] ^= 1; }                                   // another r
  if change == 3 { sig[50] ^= 1; }                                  // another s
  if change == 4 { key[31] ^= 1; }                                  // another key, or none
  if change == 5 { for i: 0..<32 { sig[i] = 255; } }                // r above p
  if change == 6 { for i: 32..<64 { sig[i] = 255; } }               // s above n
  if change == 7 { for i: 0..<32 { key[i] = 255; } }                // x above p
  if change == 8 { for i: 0..<32 { key[i] = 0; } key[31] = 5; }     // x = 5 is no point's x
  if change == 9 { for i: 32..<64 { sig[i] = 0; } }                 // s = 0
  decided := schnorr_verify_vartime(message[..], key[..], sig[..]);
  #assert decided == sv_prepared_matches_vartime(sv_prepare_vartime(message[..], key[..], sig[..]));
  #assert decided == (change == 0) && nostr_verify_vartime(message[..], key[..], sig[..]) == decided;
  #assert !schnorr_verify_vartime(message[..], key[..], sig[0..<63]) && !schnorr_verify_vartime(message[..], key[0..<31], sig[..]);
  #assert !nostr_verify_vartime(message[0..<31], key[..], sig[..]);
}
