// Whether each vector verifies, as the CSV states.
SB_VEC_VALID :: [19] bool.[true, true, true, true, true, false, false, false, false, false,
                           false, false, false, false, false, true, true, true, true];

SbBatch :: struct { keys: [32 * SB_MAX] u8; sigs: [64 * SB_MAX] u8; messages: [8192] u8; lengths: [SB_MAX] int; u: int; used: int; }
sb_hex :: (text: string, out: [] u8) -> int {
  if text.count % 2 != 0 || text.count / 2 > out.count { return -1; }
  for i: 0..<text.count/2 {
    hi := sb_nibble(text[2*i]); lo := sb_nibble(text[2*i+1]);
    if hi < 0 || lo < 0 { return -1; }
    out[i] = cast,trunc(u8) (hi * 16 + lo);
  }
  return text.count / 2;
}
sb_nibble :: (c: u8) -> int {
  if c >= '0' && c <= '9' { return cast(int) (c - '0'); }
  if c >= 'a' && c <= 'f' { return cast(int) (c - 'a') + 10; }
  return -1;
}
// Append vector v to a batch.
sb_add_vector :: (b: [] SbBatch, v: int) -> bool {
  u := b[0].u;
  if u >= SB_MAX { return false; }
  if sb_hex(SB_VEC_KEY[v], b[0].keys[u*32..<u*32+32]) != 32 { return false; }
  if sb_hex(SB_VEC_SIG[v], b[0].sigs[u*64..<u*64+64]) != 64 { return false; }
  n := sb_hex(SB_VEC_MSG[v], b[0].messages[b[0].used..<b[0].messages.count]);
  if n < 0 { return false; }
  b[0].lengths[u] = n; b[0].used += n; b[0].u = u + 1;
  return true;
}
sb_check :: (b: [] SbBatch) -> SbResult {
  u := b[0].u;
  return schnorr_batch_check_vartime(b[0].keys[0..<32*u], b[0].messages[0..<b[0].used], b[0].lengths[0..<u], b[0].sigs[0..<64*u]);
}
sb_single :: (b: [] SbBatch, i: int) -> bool {
  at := 0;
  for j: 0..<i { at += b[0].lengths[j]; }
  return schnorr_verify_vartime(b[0].messages[at..<at+b[0].lengths[i]], b[0].keys[i*32..<i*32+32], b[0].sigs[i*64..<i*64+64]);
}

#test "the valid BIP-340 vectors verify as one batch, and alone as a batch of one" #steps 3000000000 {
  b: [1] SbBatch;
  for v: 0..<19 { if SB_VEC_VALID[v] { #assert sb_add_vector(b[..], v); } }
  #assert b[0].u == 9;
  r := sb_check(b[..]);
  #assert r.ok && r.error == SB_OK && r.index == -1 && r.roots == 18;
  for v: 0..<19 {
    one: [1] SbBatch; #assert sb_add_vector(one[..], v);
    #assert sb_check(one[..]).ok == SB_VEC_VALID[v];
  }
}
#test "each invalid vector refuses the batch it joins, for its reason" #steps 3000000000 {
  want := [19] int.[0, 0, 0, 0, 0, SB_E_KEY, SB_E_SUM, SB_E_SUM, SB_E_SUM, SB_E_R,
                    SB_E_SUM, SB_E_R, SB_E_R, SB_E_S, SB_E_KEY, 0, 0, 0, 0];
  for v: 5..<15 {
    b: [1] SbBatch;
    #assert sb_add_vector(b[..], 1) && sb_add_vector(b[..], v) && sb_add_vector(b[..], 15);
    r := sb_check(b[..]);
    #assert !r.ok && r.error == want[v];
    if want[v] != SB_E_SUM { #assert r.index == 1; } else { #assert r.index == -1; }
  }
}
#test "one changed bit anywhere in one signature refuses the batch" #steps 3000000000 {
  for at: 0..<4 {
    b: [1] SbBatch;
    for v: 0..<5 { #assert sb_add_vector(b[..], v); }
    spot := ifx at < 2 then 64*at + 7 else 64*at + 40;
    b[0].sigs[spot] ^= 4;
    r := sb_check(b[..]);
    #assert !r.ok;
    for i: 0..<5 { #assert sb_single(b[..], i) == (i != at); }
  }
}
#test "without randomizers, two wrong signatures can cancel" #steps 3000000000 {
  b: [1] SbBatch;
  #assert sb_add_vector(b[..], 1) && sb_add_vector(b[..], 2);
  // Add 1 to s_1 and take 1 from s_2: both are now invalid.
  s1 := sc_add(sc_load(b[0].sigs[32..<64]).value, sc_small(1));
  s2 := sc_sub(sc_load(b[0].sigs[96..<128]).value, sc_small(1));
  #assert sc_store(s1, b[0].sigs[32..<64]) && sc_store(s2, b[0].sigs[96..<128]);
  #assert !sb_single(b[..], 0) && !sb_single(b[..], 1);
  ones := [2] ScScalar.[sc_small(1), sc_small(1)];
  #assert sb_verify_with_vartime(b[0].keys[0..<64], b[0].messages[0..<b[0].used], b[0].lengths[0..<2], b[0].sigs[0..<128], ones[..]).ok;
  #assert !sb_check(b[..]).ok;
}
#test "the randomizers: a_1 is 1 and the rest come from ChaCha20" {
  seed: [32] u8;
  for i: 0..<32 { seed[i] = cast,trunc(u8) i; }
  r := sb_randomizers(seed[..], 5);
  #assert r.ok && r.drawn == 4 && sc_equal(r.a[0], sc_small(1));
  block: [64] u8; nonce: [12] u8;
  #assert chacha20_block_checked(seed[..], nonce[..], 0, block[..], false).error == CC_OK;
  #assert sc_equal(r.a[1], sc_load(block[0..<32]).value) && sc_equal(r.a[2], sc_load(block[32..<64]).value);
  #assert chacha20_block_checked(seed[..], nonce[..], 1, block[..], false).error == CC_OK;
  #assert sc_equal(r.a[3], sc_load(block[0..<32]).value) && sc_equal(r.a[4], sc_load(block[32..<64]).value);
  #assert sb_randomizers(seed[..], 0).ok && sb_randomizers(seed[..], 1).drawn == 0;
  #assert !sb_randomizers(seed[0..<31], 2).ok && !sb_randomizers(seed[..], SB_MAX + 1).ok && !sb_randomizers(seed[..], -1).ok;
  out: [32] u8; none: [1] u8;
  #assert sb_seed(none[0..<0], none[0..<0], none[0..<0], out[..]);
  want: [32] u8;
  #assert sha256_hash_checked(none[0..<0], want[..], false) == SHA_OK;
  for i: 0..<32 { #assert out[i] == want[i]; }
  #assert !sb_seed(none[0..<0], none[0..<0], none[0..<0], out[0..<31]);
}
#test "shapes: an empty batch verifies; mismatched inputs refuse" {
  b: [1] SbBatch;
  #assert sb_check(b[..]).ok;
  #assert sb_add_vector(b[..], 1);
  r := schnorr_batch_check_vartime(b[0].keys[0..<31], b[0].messages[0..<32], b[0].lengths[0..<1], b[0].sigs[0..<64]);
  #assert !r.ok && r.error == SB_E_SHAPE;
  #assert !schnorr_batch_verify_vartime(b[0].keys[0..<32], b[0].messages[0..<31], b[0].lengths[0..<1], b[0].sigs[0..<64]);
  #assert !schnorr_batch_verify_vartime(b[0].keys[0..<32], b[0].messages[0..<32], b[0].lengths[0..<1], b[0].sigs[0..<63]);
  bad := [1] int.[-1];
  #assert !schnorr_batch_verify_vartime(b[0].keys[0..<32], b[0].messages[0..<0], bad[..], b[0].sigs[0..<64]);
  short: [1] ScScalar;
  #assert sb_verify_with_vartime(b[0].keys[0..<32], b[0].messages[0..<32], b[0].lengths[0..<1], b[0].sigs[0..<64], short[0..<0]).error == SB_E_SHAPE;
  big: [SB_MAX + 1] int;
  #assert !sb_shape(b[0].keys[0..<0], b[0].messages[0..<0], big[..], b[0].sigs[0..<0]);
  #assert sb_hex("abc", b[0].keys[..]) == -1 && sb_hex("zz", b[0].keys[..]) == -1 && sb_hex("0g", b[0].keys[..]) == -1;
  for e: 0..<6 { #assert sb_error_text(e).count > 0; }
  full: [1] SbBatch; full[0].u = SB_MAX;
  #assert !sb_add_vector(full[..], 1);
}
