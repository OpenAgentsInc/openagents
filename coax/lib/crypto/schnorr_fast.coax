 Sg32.{x=Sf32.{limb=[8]u32.[3799910414,1152236792,1015412638,837129327,157283345,1514560227,2101602966,3616689487]},y=Sf32.{limb=[8]u32.[4137839448,3305430175,3633763237,3930107691,684486127,2206478018,2825679526,1478371442]},z=Sf32.{limb=[8]u32.[1,0,0,0,0,0,0,0]}}
];

sfv_nostr_length :: (count:int)->bool {return count==32;}
nostr_fast_verify_vartime :: (event_id:[]u8,public_key:[]u8,signature:[]u8)->bool #export_c {
  if !sfv_nostr_length(event_id.count) {return false;}return schnorr_fast_verify_vartime(event_id,public_key,signature);
}
