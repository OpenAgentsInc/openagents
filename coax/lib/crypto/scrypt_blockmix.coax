// Experimental bounded RFC 7914 BlockMix. This is not full scrypt.
#load "bytes.coax";
#load "salsa20_8.coax";
#authority;

#test "RFC 7914 section 9 BlockMix r=1" {
  input:=[128]u8.[0xf7,0xce,0x0b,0x65,0x3d,0x2d,0x72,0xa4,0x10,0x8c,0xf5,0xab,0xe9,0x12,0xff,0xdd,0x77,0x76,0x16,0xdb,0xbb,0x27,0xa7,0x0e,0x82,0x04,0xf3,0xae,0x2d,0x0f,0x6f,0xad,0x89,0xf6,0x8f,0x48,0x11,0xd1,0xe8,0x7b,0xcc,0x3b,0xd7,0x40,0x0a,0x9f,0xfd,0x29,0x09,0x4f,0x01,0x84,0x63,0x95,0x74,0xf3,0x9a,0xe5,0xa1,0x31,0x52,0x17,0xbc,0xd7,0x89,0x49,0x91,0x44,0x72,0x13,0xbb,0x22,0x6c,0x25,0xb5,0x4d,0xa8,0x63,0x70,0xfb,0xcd,0x98,0x43,0x80,0x37,0x46,0x66,0xbb,0x8f,0xfc,0xb5,0xbf,0x40,0xc2,0x54,0xb0,0x67,0xd2,0x7c,0x51,0xce,0x4a,0xd5,0xfe,0xd8,0x29,0xc9,0x0b,0x50,0x5a,0x57,0x1b,0x7f,0x4d,0x1c,0xad,0x6a,0x52,0x3c,0xda,0x77,0x0e,0x67,0xbc,0xea,0xaf,0x7e,0x89];
  expected:=[128]u8.[0xa4,0x1f,0x85,0x9c,0x66,0x08,0xcc,0x99,0x3b,0x81,0xca,0xcb,0x02,0x0c,0xef,0x05,0x04,0x4b,0x21,0x81,0xa2,0xfd,0x33,0x7d,0xfd,0x7b,0x1c,0x63,0x96,0x68,0x2f,0x29,0xb4,0x39,0x31,0x68,0xe3,0xc9,0xe6,0xbc,0xfe,0x6b,0xc5,0xb7,0xa0,0x6d,0x96,0xba,0xe4,0x24,0xcc,0x10,0x2c,0x91,0x74,0x5c,0x24,0xad,0x67,0x3d,0xc7,0x61,0x8f,0x81,0x20,0xed,0xc9,0x75,0x32,0x38,0x81,0xa8,0x05,0x40,0xf6,0x4c,0x16,0x2d,0xcd,0x3c,0x21,0x07,0x7c,0xfe,0x5f,0x8d,0x5f,0xe2,0xb1,0xa4,0x16,0x8f,0x95,0x36,0x78,0xb7,0x7d,0x3b,0x3d,0x80,0x3b,0x60,0xe4,0xab,0x92,0x09,0x96,0xe5,0x9b,0x4d,0x53,0xb6,0x5d,0x2a,0x22,0x58,0x77,0xd5,0xed,0xf5,0x84,0x2c,0xb9,0xf1,0x4e,0xef,0xe4,0x25];
  out:[129]u8;out[128]=165;
  #assert scrypt_blockmix(input[..],out[..],1,false);
  for i:0..<128 {#assert out[i]==expected[i];}
  #assert out[128]==165;
  #assert scrypt_blockmix(input[..],out[0..<128],1,false);
}

#test "r=2 permutes even blocks before odd blocks" {
  input:[256]u8;out:[256]u8;for i:0..<256 {input[i]=cast(u8)i;}
  #assert scrypt_blockmix(input[..],out[..],2,false);
  #assert cb_load_le32(out[..],0).value==0x7d7c6aa8;
  #assert cb_load_le32(out[..],64).value==0x0552247d;
  #assert cb_load_le32(out[..],128).value==0x4b94f873;
  #assert cb_load_le32(out[..],192).value==0x5c1818b7;
}

#test "invalid sizes or aliases leave output untouched" {
  input:[1024]u8;out:[1025]u8;for i:0..<1025 {out[i]=165;}
  #assert !scrypt_blockmix(input[..],out[..],0,false);
  #assert !scrypt_blockmix(input[..],out[..],9,false);
  #assert !scrypt_blockmix(input[0..<127],out[..],1,false);
  #assert !scrypt_blockmix(input[0..<129],out[..],1,false);
  #assert !scrypt_blockmix(input[0..<128],out[0..<127],1,false);
  #assert !scrypt_blockmix(input[0..<128],out[..],1,true);
  for x:out {#assert x==165;}
  #assert scrypt_blockmix(input[..],out[..],8,false);
  for i:0..<1024 {#assert out[i]==0;}
  #assert out[1024]==165;
  #assert blockmix_admit(128,CB_MAX_BYTES,1,false);
  #assert !blockmix_admit(128,CB_MAX_BYTES+1,1,false);
  #assert !blockmix_admit(0,0,0,false);
  #assert !blockmix_admit(1152,1152,9,false);
}

// Internal ABI: a checked host adapter must supply valid, nonoverlapping views.
// Temporaries have not yet been proven erased; production secret use is barred.
blockmix_admit :: (input:int,capacity:int,r:int,overlap:bool)->bool {
  if r<1 || r>8 {return false;}
  n:=128*r;
  return input==n && capacity>=n && capacity<=CB_MAX_BYTES && !overlap;
}
scrypt_blockmix :: (input:[]u8,out:[]u8,r:int,overlap:bool)->bool #export_c {
  if !blockmix_admit(input.count,out.count,r,overlap) {return false;}
  n:=128*r;
  x:[16]u32;
  for j:0..<16 {x[j]=cb_load_le32(input,n-64+j*4).value;}
  for i:0..<2*r {
    for j:0..<16 {x[j]^=cb_load_le32(input,i*64+j*4).value;}
    x=salsa20_8_words(x);
    block:=i/2;if i%2==1 {block+=r;}
    for j:0..<16 {stored:=cb_store_le32(out,block*64+j*4,x[j]);}
  }
  return true;
}
