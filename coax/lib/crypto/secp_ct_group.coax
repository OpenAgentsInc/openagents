// 1/a mod n as a^(n-2), four exponent bits at a time. The exponent is
// public, so its digits may choose the table entry and skip a zero digit.
// 1/0 is 0.
cg_scalar_inverse :: (a:ScScalar)->ScScalar #effects(all) {
  table:[16]ScScalar;defer {for i:0..<16 {secure_zero(table[i].limbs[..]);}for e:table {for w:e.limbs {#assert w==0;}}}
  table[1]=sc_normalize(a);for i:2..<16 {table[i]=cg_scalar_mul(table[i-1],table[1]);}
  e:=SC_N_MINUS_TWO;acc:=table[cast(int)((e.limbs[7]>>28)&15)];
  for window:1..<64 {
    at:=63-window;digit:=cast(int)((e.limbs[at/8]>>((at%8)*4))&15);
    for i:0..<4 {acc=cg_scalar_mul(acc,acc);}
    if digit!=0 {acc=cg_scalar_mul(acc,table[digit]);}
  }
  return acc;
}
