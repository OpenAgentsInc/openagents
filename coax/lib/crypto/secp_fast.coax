// a·G + b·P on secp256k1 for verification: Jacobian coordinates on the
// 52-bit-limb field (secp_fe.coax), a doubling and an addition that are not
// complete formulas, the endomorphism split of chapter 77 over a wider
// table for G, and a table for P with one shared denominator. It gives the
// same point as chapter 16's ecmult_vartime and chapter 77's
// ecmult_glv_vartime, which stay as its references.
//
// Every procedure branches and indexes on its inputs. They are for public
// data only: signing, key generation and ECDH keep their fixed-work paths.
// coax test coax/lib/crypto/secp_fast.coax --library
#load "secp_glv.coax";
#load "secp_fe.coax";
#load "secp_scalar_inverse.coax";
#load "secp_fast-checks.coax" #test;
#authority;
// An affine point; never infinity.
Fge :: struct { x: Fe; y: Fe; }
FgeResult :: struct { value: Fge; ok: bool; }
// A Jacobian point (x, y) = (X/Z², Y/Z³). Between operations X has
// magnitude at most 6, Y at most 4 and Z at most 2.
Fgej :: struct { x: Fe; y: Fe; z: Fe; infinity: bool; }
FG_BITS :: 129;
FG_P_WINDOW :: 5;
// A width-w wNAF of a number below 2^128: digit i has weight 2^i.
FgWnaf :: struct { digits: [129] int; }
// One half of a split scalar: the wNAF of its magnitude, and its sign.
FgHalf :: struct { wnaf: FgWnaf; negative: bool; }
// k = r1 + λ·r2 (mod n): each half is a signed integer, mod 2^256.
FgSplit :: struct { r1: Sw; r2: Sw; }
// A nonzero wNAF digit as a table index, (|d| - 1)/2, and its sign.
FgDigit :: struct { index: int; negative: bool; }
#load "secp_fast_table.coax";
// p - n, below 2^129: a signature's r stands for x = r and, when r is below
// this, for x = r + n too.
fg_p_minus_n :: () -> ScScalar #effects(all) { return ScScalar.{limbs=[8] u32.[0x2FC9BAEE,0x402DA172,0x50B75FC4,0x45512319,1,0,0,0]}; }

// ---- the group law
fg_infinity :: () -> Fgej #effects(all) { r: Fgej; r.infinity = true; return r; }
fg_from_affine :: (a: Fge) -> Fgej #effects(all) { return Fgej.{x=a.x,y=a.y,z=fe_one()}; }
// 2a, for the curve y² = x³ + 7 (three multiplications and four squarings).
// With M = 3X² and S = 4XY²: X' = M² - 2S, Y' = M(S - X') - 8Y⁴, Z' = 2YZ.
// No point of this curve has y = 0, so a finite point never doubles to
// infinity. The comments give each value's magnitude.
fg_double :: (a: Fgej) -> Fgej #effects(all) {
  if a.infinity { return a; }
  r: Fgej;
  r.z = fe_scale(fe_mul(a.y, a.z), 2);                         // 2
  m := fe_scale(fe_sqr(a.x), 3);                               // 3X², 3
  m2 := fe_sqr(m);                                             // 9X⁴, 1
  y2 := fe_scale(fe_sqr(a.y), 2);                              // 2Y², 2
  y4 := fe_scale(fe_sqr(y2), 2);                               // 8Y⁴, 2
  half := fe_mul(y2, a.x);                                     // 2XY² = S/2, 1
  r.x = fe_add(fe_negate(fe_scale(half, 4), 4), m2); // mutant: equivalent (a larger multiple of p is the same residue; the sum is M² - 2S, 6)
  rest := fe_add(fe_scale(half, 6), fe_negate(m2, 1)); // mutant: equivalent (a larger multiple of p is the same residue; the sum is S - X', 8)
  r.y = fe_add(fe_mul(m, rest), fe_negate(y4, 2)); // mutant: equivalent (a larger multiple of p is the same residue; the sum is 4)
  return r;
}
// The end of an addition. With u1, s1 the first point's x and y on the
// common denominator, h = u2 - u1 and i = s1 - s2 (h is not zero):
// X' = i² - h³ - 2·u1·h² and Y' = i·(X' - u1·h²) - s1·h³, computed from
// h2 = -h² and h3 = -h³. The result has magnitudes 4 and 2; the caller
// sets Z.
fg_add_finish :: (u1: Fe, s1: Fe, h: Fe, i: Fe) -> Fgej #effects(all) {
  r: Fgej;
  h2 := fe_negate(fe_sqr(h), 1); // mutant: equivalent (a larger multiple of p is the same residue; the sum is -h², 2)
  h3 := fe_mul(h2, h);                                         // -h³, 1
  t := fe_mul(u1, h2);                                         // -u1·h², 1
  r.x = fe_add(fe_add(fe_sqr(i), h3), fe_scale(t, 2));         // 4
  r.y = fe_add(fe_mul(fe_add(t, r.x), i), fe_mul(h3, s1));     // 2
  return r;
}
// a + b for an affine b (eight multiplications and three squarings). Equal
// points double, and opposite points give infinity.
fg_add_affine :: (a: Fgej, b: Fge) -> Fgej #effects(all) {
  if a.infinity { return fg_from_affine(b); }
  z2 := fe_sqr(a.z);
  u2 := fe_mul(b.x, z2);
  s2 := fe_mul(fe_mul(b.y, z2), a.z);
  h := fe_add(fe_negate(a.x, 6), u2); // mutant: equivalent (a larger multiple of p is the same residue; the sum is 8)
  i := fe_add(fe_negate(s2, 1), a.y); // mutant: equivalent (a larger multiple of p is the same residue; the sum is 6)
  if fe_is_zero_vartime(h) {
    if fe_is_zero_vartime(i) { return fg_double(a); }
    return fg_infinity();
  }
  r := fg_add_finish(a.x, a.y, h, i);
  r.z = fe_mul(a.z, h);
  return r;
}
// Full Jacobian addition for batch accumulators whose tables have distinct
// denominators. The public exceptional cases are the same as affine add.
// These fixed negations expose the limb bounds required by the following
// products: product inputs have magnitude 1, Jacobian X has magnitude 6.
fg_negative_product :: (a: Fe) -> Fe #effects(all) { return fe_negate(a, 1); }
fg_negative_x :: (a: Fe) -> Fe #effects(all) { return fe_negate(a, 6); }
fg_generator :: () -> Fge #effects(all) { return fg_g_point(0); }
fg_add_jacobian :: (a: Fgej, b: Fgej) -> Fgej #effects(all) {
  if a.infinity { return b; }
  if b.infinity { return a; }
  z1 := fe_sqr(a.z); z2 := fe_sqr(b.z);
  u1 := fe_mul(a.x, z2); u2 := fe_mul(b.x, z1);
  s1 := fe_mul(a.y, fe_mul(b.z, z2)); s2 := fe_mul(b.y, fe_mul(a.z, z1));
  h := fe_add(fg_negative_product(u1), u2); i := fe_add(fg_negative_product(s2), s1);
  if fe_is_zero_vartime(h) {
    if fe_is_zero_vartime(i) { return fg_double(a); }
    return fg_infinity();
  }
  r := fg_add_finish(u1, s1, h, i); r.z = fe_mul(fe_mul(a.z, b.z), h);
  return r;
}
// The affine point, with both coordinates below p. a must not be infinity.
fg_to_affine_vartime :: (a: Fgej) -> Fge #effects(all) {
  zi := fe_inverse_vartime(a.z); zi2 := fe_sqr(zi);
  return Fge.{x=fe_normalize(fe_mul(a.x, zi2)),y=fe_normalize(fe_mul(fe_mul(a.y, zi2), zi))};
}

// ---- public keys
// The point with this x and an even y (BIP-340's lift_x). ok is false when
// x is not 32 bytes, is p or more, or is no point's x.
fg_lift_x_vartime :: (bytes: [] u8) -> FgeResult #effects(all) {
  x := fe_load_vartime(bytes);
  if !x.ok { return FgeResult.{}; }
  y := fe_sqrt_vartime(fe_add(fe_mul(fe_sqr(x.value), x.value), fe_small(7)));
  if !y.ok { return FgeResult.{}; }
  even := fe_normalize(y.value);
  if fe_is_odd(even) { even = fe_normalize(fe_negate(even, 1)); } // mutant: equivalent (a larger multiple of p is the same residue)
  return FgeResult.{value=Fge.{x=x.value,y=even},ok=true};
}
// A public key in SEC 1 form, as chapter 17's se_decode reads it: 33 bytes
// (02 or 03, then x) or 65 bytes (04, then x and y, both below p, on the
// curve). Anything else refuses.
fg_decode_vartime :: (bytes: [] u8) -> FgeResult #effects(all) {
  if bytes.count == 33 {
    if bytes[0] != 2 && bytes[0] != 3 { return FgeResult.{}; }
    r := fg_lift_x_vartime(bytes[1..<33]);
    if r.ok && bytes[0] == 3 { r.value.y = fe_normalize(fe_negate(r.value.y, 1)); } // mutant: equivalent (a larger multiple of p is the same residue)
    return r;
  }
  if bytes.count != 65 || bytes[0] != 4 { return FgeResult.{}; }
  x := fe_load_vartime(bytes[1..<33]); y := fe_load_vartime(bytes[33..<65]);
  if !x.ok || !y.ok { return FgeResult.{}; } // mutant: equivalent (a refused load is zero, and no point has x = 0 or y = 0)
  if !fe_equal_vartime(fe_sqr(y.value), fe_add(fe_mul(fe_sqr(x.value), x.value), fe_small(7))) { return FgeResult.{}; }
  return FgeResult.{value=Fge.{x=x.value,y=y.value},ok=true};
}

// ---- splitting and recoding
// The short basis of chapter 77's lattice, {a1 + b1·λ, a2 + b2·λ}, as
// integers: a1, -b1 and a2 (b2 = a1). Procedures, not constants, so that
// loading this file spends none of a compile's compile-time steps.
fg_a1 :: () -> Sw #effects(all) { return Sw.{n=[4] u64.[0xE86C90E49284EB15, 0x3086D221A7D46BCD, 0, 0]}; }
fg_a2 :: () -> Sw #effects(all) { return Sw.{n=[4] u64.[0x57C1108D9D44CFD8, 0x14CA50F7A8E2F3F6, 1, 0]}; }
// round(k·g / 2^384): chapter 77's glv_mul_shift_vartime on 64-bit limbs.
fg_mul_shift :: (k: Sw, g: Sw) -> Sw #effects(all) {
  w := sw_mul_wide(k, g); r: Sw; round := w[5] >> 63;
  r.n[0] = add_wrap(w[6], round);
  carry := ifx r.n[0] < round then cast(u64) 1 else 0;
  r.n[1] = add_wrap(w[7], carry);
  r.n[2] = ifx r.n[1] < carry then cast(u64) 1 else 0;
  return r;
}
// k = r1 + λ·r2 (mod n), as chapter 77's glv_split_vartime splits it, with
// each half a signed integer mod 2^256 instead of a residue mod n. With
// the same c1 and c2, r2 = c1·(-b1) - c2·b2 and r1 = k - c1·a1 - c2·a2 hold
// as integers, because a + b·λ = 0 (mod n) for both basis vectors. Both are
// below 2^128 in absolute value, so arithmetic mod 2^256 gives them exactly
// and no product needs a reduction mod n.
fg_split_vartime :: (k: ScScalar) -> FgSplit #effects(all) {
  x := sw_from_scalar(sc_normalize(k));
  c1 := fg_mul_shift(x, sw_from_scalar(GLV_G1)); c2 := fg_mul_shift(x, sw_from_scalar(GLV_G2));
  r2 := sw_sub(sw_mul_low(c1, sw_from_scalar(GLV_MINUS_B1)), sw_mul_low(c2, fg_a1())).value;
  r1 := sw_sub(sw_sub(x, sw_mul_low(c1, fg_a1())).value, sw_mul_low(c2, fg_a2())).value;
  return FgSplit.{r1=r1,r2=r2};
}
// The width-w wNAF of hi·2^64 + lo; w is from 2 to 10. Each nonzero digit is
// odd, below 2^(w-1) in absolute value, and followed by at least w - 1
// zeros. A window is read where the low bit differs from the carry; a
// window of 2^(w-1) or more becomes negative and carries one into the next.
// The number is below 2^128, so a carry lands at bit 128 at the latest.
fg_wnaf_vartime :: (low: u64, high: u64, w: int) -> FgWnaf #effects(all) {
  r: FgWnaf; lo := low; hi := high; carry: u64; bit := 0; mask := (cast(u64) 1 << w) - 1;
  while bit < FG_BITS { // mutant: equivalent (from bit 129 on the number and the carry are zero, so nothing is written)
    if (lo & 1) == carry { lo = (lo >> 1) | (hi << 63); hi = hi >> 1; bit += 1; continue; }
    word := (lo & mask) + carry;
    carry = (word >> (w - 1)) & 1;
    r.digits[bit] = cast(int) word - cast(int) (carry << w);
    lo = (lo >> w) | (hi << (64 - w)); hi = hi >> w; bit += w;
  }
  return r;
}
// One half of a split, as the wNAF of its magnitude and its sign.
fg_half_vartime :: (r: Sw, w: int) -> FgHalf #effects(all) {
  negative := r.n[3] != 0; m := r;     // below 2^128 in absolute value: the top limb is zero or all ones
  if negative { m = sw_sub(Sw.{}, r).value; }
  #assert (m.n[2] | m.n[3]) == 0; // mutant: equivalent (libsecp256k1's bound holds for every split, so the assertion never fails)
  return FgHalf.{wnaf=fg_wnaf_vartime(m.n[0], m.n[1], w),negative=negative};
}
fg_digit :: (digit: int) -> FgDigit #effects(all) {
  if digit < 0 { return FgDigit.{index=(-digit - 1) / 2,negative=true}; }
  return FgDigit.{index=(digit - 1) / 2};
}

// ---- the multiplication
// The table entry for one signed digit d of a half: |d| times the table's
// point, negated when d and the half's sign differ. Its y has magnitude 1.
fg_signed :: (e: Fge, negate: bool) -> Fge #effects(all) {
  if !negate { return e; }
  return Fge.{x=e.x,y=fe_negate(e.y, 1)}; // mutant: equivalent (a larger multiple of p is the same residue)
}
// P's odd multiples P, 3P, ..., 15P with one shared denominator, so that the
// chain adds them with the affine formula. entry[i] is (x·z², y·z³) for
// (2i+1)·P = (x, y): each entry is an affine point of the curve scaled by z,
// y² = x³ + 7·z⁶, which has the same addition and doubling. z2 and z3 are z²
// and z³, and z2b is β·z², for moving G's entries onto that curve.
FgTable :: struct { entry: [8] Fge; z: Fe; z2: Fe; z3: Fe; z2b: Fe; }
// Build the table without a division. 2P = (dx/dz², dy/dz³), so on the curve
// scaled by dz it is the affine point (dx, dy) and P is (x·dz², y·dz³). The
// odd multiples follow by affine additions there, each multiplying Z by its
// h. Scaling entry i by Z7/Zi, the product of the later h, gives every entry
// the last one's Z7; with dz, the shared denominator is z = Z7·dz. P is a
// point of the curve, so no multiple here equals or opposes 2P and no h is 0.
fg_odd_table :: (point: Fge) -> FgTable #effects(all) {
  twice := fg_double(fg_from_affine(point));
  dz2 := fe_sqr(twice.z); step := Fge.{x=twice.x,y=twice.y};
  t: [8] Fgej; h: [8] Fe;
  t[0] = Fgej.{x=fe_mul(point.x, dz2),y=fe_mul(fe_mul(point.y, dz2), twice.z),z=fe_one()};
  for i: 1..<8 {
    h[i] = fe_add(fe_negate(t[i-1].x, 6), fe_mul(step.x, fe_sqr(t[i-1].z))); // mutant: equivalent (a larger multiple of p is the same residue)
    t[i] = fg_add_affine(t[i-1], step);
  }
  r: FgTable; k := fe_one();
  r.entry[7] = Fge.{x=fe_weak(t[7].x),y=fe_weak(t[7].y)};
  for back: 1..<8 {
    i := 7 - back; k = fe_mul(k, h[i + 1]); k2 := fe_sqr(k);                // k = Z7/Zi
    r.entry[i] = Fge.{x=fe_mul(t[i].x, k2),y=fe_mul(fe_mul(t[i].y, k2), k)};
  }
  r.z = fe_mul(t[7].z, twice.z); r.z2 = fe_sqr(r.z); r.z3 = fe_mul(r.z2, r.z); r.z2b = fe_mul(r.z2, fg_beta());
  return r;
}
// G's entry for a digit, on the table's curve: (x·z², y·z³), or
// (x·β·z², y·z³) for the λ half.
fg_g_entry :: (table: [] FgTable, digit: int, negative: bool, lambda: bool) -> Fge #effects(all) {
  d := fg_digit(digit); g := fg_g_point(d.index);
  e := Fge.{x=fe_mul(g.x, ifx lambda then table[0].z2b else table[0].z2),y=fe_mul(g.y, table[0].z3)};
  return fg_signed(e, d.negative != negative);
}
// Add G directly with the table's denominator. Combining a.z and table.z
// before squaring saves a product compared with separately scaling both
// affine G coordinates (gej_add_zinv_var's shared-denominator idea).
fg_add_generator :: (a: Fgej, table: [] FgTable, digit: int, negative: bool, lambda: bool) -> Fgej #effects(all) {
  if a.infinity { return fg_from_affine(fg_g_entry(table, digit, negative, lambda)); }
  d := fg_digit(digit); g := fg_signed(fg_g_point(d.index), d.negative != negative);
  az := fe_mul(a.z, table[0].z); az2 := fe_sqr(az);
  xscale := az2;
  if lambda { xscale = fe_mul(xscale, fg_beta()); }
  u2 := fe_mul(g.x, xscale); s2 := fe_mul(fe_mul(g.y, az2), az);
  h := fe_add(fg_negative_x(a.x), u2); i := fe_add(fg_negative_product(s2), a.y);
  if fe_is_zero_vartime(h) {
    if fe_is_zero_vartime(i) { return fg_double(a); }
    return fg_infinity();
  }
  r := fg_add_finish(a.x, a.y, h, i); r.z = fe_mul(a.z, h); return r;
}
// P's entry for a digit: λ·(x, y) = (β·x, y) on the scaled curve too.
fg_p_entry :: (table: [] FgTable, digit: int, negative: bool, lambda: bool) -> Fge #effects(all) {
  d := fg_digit(digit); e := table[0].entry[d.index];
  if lambda { e.x = fe_mul(e.x, fg_beta()); }
  return fg_signed(e, d.negative != negative);
}
// The sum of four terms on one chain of doublings (Strauss): g1 over G,
// g2 over λG, p1 over the table's point and p2 over λ times it. The chain
// runs on the table's curve, and the last step returns to secp256k1:
// (X, Y, Z) there is (X, Y, Z·z) here. Doubling infinity, before the first
// digit, costs nothing.
fg_strauss_vartime :: (g1: FgHalf, g2: FgHalf, p1: FgHalf, p2: FgHalf, table: [] FgTable) -> Fgej #effects(all) {
  r := fg_infinity();
  for round: 0..<FG_BITS {
    bit := FG_BITS - 1 - round;
    r = fg_double(r);
    if g1.wnaf.digits[bit] != 0 { r = fg_add_generator(r, table, g1.wnaf.digits[bit], g1.negative, false); }
    if g2.wnaf.digits[bit] != 0 { r = fg_add_generator(r, table, g2.wnaf.digits[bit], g2.negative, true); }
    if p1.wnaf.digits[bit] != 0 { r = fg_add_affine(r, fg_p_entry(table, p1.wnaf.digits[bit], p1.negative, false)); }
    if p2.wnaf.digits[bit] != 0 { r = fg_add_affine(r, fg_p_entry(table, p2.wnaf.digits[bit], p2.negative, true)); }
  }
  if !r.infinity { r.z = fe_mul(r.z, table[0].z); }
  return r;
}
// a·G + b·P for a point P of the curve. Both scalars split as chapter 77
// splits them, a = a1 + λ·a2 and b = b1 + λ·b2 with halves below 2^128.
// G's halves use the width-8 table of affine points, and
// λ·(x, y) = (β·x, y) gives the other two tables.
fg_ecmult_vartime :: (a: ScScalar, point: Fge, b: ScScalar) -> Fgej #effects(all) {
  sa := fg_split_vartime(a); sb := fg_split_vartime(b);
  table: [1] FgTable; table[0] = fg_odd_table(point);
  return fg_strauss_vartime(fg_half_vartime(sa.r1, FG_G_WINDOW), fg_half_vartime(sa.r2, FG_G_WINDOW),
                            fg_half_vartime(sb.r1, FG_P_WINDOW), fg_half_vartime(sb.r2, FG_P_WINDOW), table[..]);
}

// Public adapters preserve chapter 15's checked point contract. Conversion
// keeps projective coordinates; only the input needs one affine inverse.
fg_from_field_vartime :: (a: SecpField) -> Fe #effects(all) {
  bytes: [32] u8; stored := sf_store(a, bytes[..]);
  return fe_load_vartime(bytes[..]).value;
}
fg_to_field_vartime :: (a: Fe) -> SecpField #effects(all) {
  bytes: [32] u8; stored := fe_store(a, bytes[..]);
  return sf_load(bytes[..]).value;
}
fg_to_point_vartime :: (a: Fgej) -> SgPoint #effects(all) {
  if a.infinity { return sg_infinity(); }
  return SgPoint.{x=fg_to_field_vartime(a.x),y=fg_to_field_vartime(a.y),z=fg_to_field_vartime(a.z)};
}
fg_ecmult_point_vartime :: (a: ScScalar, point: SgPoint, b: ScScalar) -> SgResult #effects(all) {
  if sg_valid_mask(point) != CB_MAX64 { return SgResult.{value=sg_infinity()}; }
  fast := Fgej.{x=fg_from_field_vartime(point.x),y=fg_from_field_vartime(point.y),z=fg_from_field_vartime(point.z)};
  if fe_is_zero_vartime(fast.z) {
    return SgResult.{value=fg_to_point_vartime(fg_ecmult_vartime(a, fg_generator(), ScScalar.{})),ok=true};
  }
  return SgResult.{value=fg_to_point_vartime(fg_ecmult_vartime(a, fg_to_affine_vartime(fast), b)),ok=true};
}

// ---- what the verifiers ask of the result
// Whether x(R) mod n = r, for an r from 1 to n - 1, without the division:
// x(R) = X/Z², so the test is X = x·Z² for x = r and, when r + n is below
// p, for x = r + n. Infinity matches nothing.
fg_x_matches_scalar_vartime :: (point: Fgej, r: ScScalar) -> bool #effects(all) {
  if point.infinity { return false; }
  bytes: [32] u8;
  if !sc_store(r, bytes[..]) { return false; }
  x := fe_load_vartime(bytes[..]).value;                       // r < n < p
  z2 := fe_sqr(point.z);
  if fe_equal_vartime(point.x, fe_mul(x, z2)) { return true; }
  below := false;
  for i: 0..<8 {
    at := 7 - i;
    if r.limbs[at] < fg_p_minus_n().limbs[at] { below = true; break; }
    if r.limbs[at] > fg_p_minus_n().limbs[at] { break; }
  }
  if !below { return false; }
  return fe_equal_vartime(point.x, fe_mul(fe_add(x, fg_order()), z2));
}
// Whether R is finite with an even y and x(R) = x, for an x below p
// (BIP-340's last three checks).
fg_matches_even_x_vartime :: (point: Fgej, x: Fe) -> bool #effects(all) {
  if point.infinity { return false; }
  affine := fg_to_affine_vartime(point);
  return !fe_is_odd(affine.y) && fe_equal_vartime(affine.x, x);
}
