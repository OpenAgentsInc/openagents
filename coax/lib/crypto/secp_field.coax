// secp256k1 field representation, p = 2^256 - 2^32 - 977.
// Ten little-endian u64 limbs: nine 26-bit limbs and one 22-bit limb.
// Runtime inputs admit each digit <=8 times its mask. Operations return
// canonical magnitude1 values. No variable-time optimization, secret-taint
// enforcement or target constant-time guarantee is claimed here.
#load "bytes.coax";
#authority;
SF_MASK26 :: cast(u64) 67108863;
SF_MASK22 :: cast(u64) 4194303;
SF_MAGNITUDE :: 8;
SecpField :: struct { limb: [10] u64; }
SecpFieldResult :: struct { value: SecpField; ok: bool; }
// Explicit, always-present debug representation: conditional fields are not
// implemented. This validation is diagnostic instrumentation, not a secret API.
SecpFieldDebug :: struct { value: SecpField; magnitude: int; normalized: bool; }
SF_P :: [10] u64.[67107887, 67108799, 67108863, 67108863, 67108863,
  67108863, 67108863, 67108863, 67108863, 4194303];
SfMulBounds :: struct { facts: [27] u64; ok: bool; }
// Inclusive declared budgets. The verification note names every fact slot.
SF_MUL_LIMITS :: [27] u64.[536870911, 33554431, 134217727, 134217727,
  4503599627370495, 72057594037927935, 1073741823, 72057594037927935,
  35184372088831, 8388607, 137438953471, 2048, 137438953471, 4,
  127, 137438953471, 2048, 137438953471, 2048, 134217727, 1,
  134217726, 134217726, 8, 1073741823, 2048, 1073741823];
SF_MUL_BOUNDS :: #run sf_mul_bounds(8);
#assert SF_MUL_BOUNDS.ok;
SfChainStep :: struct { left: int; squares: int; right: int; }
SfChainState :: struct { value: [13] SecpField; }
SfExponent :: struct { word: [8] u32; }
SfExponentState :: struct { value: [13] SfExponent; }
// State0 is a. The public chain ends at a^((2^223-1)*2^23 +2^22-1).
SF_FIELD_CHAIN :: [12] SfChainStep.[
  SfChainStep.{left = 0, squares = 1, right = 0},
  SfChainStep.{left = 1, squares = 1, right = 0},
  SfChainStep.{left = 2, squares = 3, right = 2},
  SfChainStep.{left = 3, squares = 3, right = 2},
  SfChainStep.{left = 4, squares = 2, right = 1},
  SfChainStep.{left = 5, squares = 11, right = 5},
  SfChainStep.{left = 6, squares = 22, right = 6},
  SfChainStep.{left = 7, squares = 44, right = 7},
  SfChainStep.{left = 8, squares = 88, right = 8},
  SfChainStep.{left = 9, squares = 44, right = 7},
  SfChainStep.{left = 10, squares = 3, right = 2},
  SfChainStep.{left = 11, squares = 23, right = 6}];
SF_FIELD_EXPONENT_PREFIX :: #run sf_exponent_prefix();
SF_INVERSE_EXPONENT :: #run sf_exponent_inverse();
SF_SQRT_EXPONENT :: #run sf_exponent_sqrt();
#assert #run sf_exponent_matches(SF_INVERSE_EXPONENT, false);
#assert #run sf_exponent_matches(SF_SQRT_EXPONENT, true);

#forall "bound certificate covers the actual schedule at every admitted magnitude" magnitude: 1..<9 {
  b := sf_mul_bounds(magnitude);
  #assert b.ok;
  m := cast(u64) magnitude;
  #assert b.facts[0] == m * 67108864 - 1 && b.facts[1] == m * 4194304 - 1;
  #assert b.facts[2] == 67108863 + (m - 1) * 977 && b.facts[3] == 67108863 + (m - 1) * 64;
  expected := [23] u64.[4503599493152769, 45035994931527690, 671088640,
    45035995602616330, 17592848744449, 4194463, 69927435246, 2048,
    69927437294, 4, 79, 65632468014, 977, 4362154255, 65, 67113984,
    1, 67109840, 67108927, 0, 671088630, 1042, 268447680];
  expected[19] = m;
  for i: 4..<27 { #assert b.facts[i] == expected[i - 4]; }
}
#forall "budget admission rejects each real exceeding fact without overflow" index: 0..<27 {
  b: SfMulBounds; b.facts = SF_MUL_LIMITS;
  #assert sf_mul_budget(b);
  b.facts[index] += 1; #assert !sf_mul_budget(b);
}
#test "inductive carry budgets compare facts rather than assume them" {
  b: SfMulBounds; b.facts = SF_MUL_LIMITS;
  b.facts[6] = 0; b.facts[24] = 1; #assert !sf_mul_budget(b);
  b.facts[24] = 0; #assert sf_mul_budget(b);
  b.facts[11] = 0; b.facts[25] = 1; #assert !sf_mul_budget(b);
  b.facts[25] = 0; #assert sf_mul_budget(b);
}

#test "bound arithmetic refuses true u64 overflow and accepts its exact boundary" {
  #assert sf_bound_product_ok(CB_MAX64, 1) && sf_bound_product_ok(0, CB_MAX64);
  #assert sf_bound_product_ok(CB_MAX64, 0) && !sf_bound_product_ok(CB_MAX64, 2);
  #assert !sf_bound_product_ok(4294967296, 4294967296);
  #assert sf_bound_sum_ok(CB_MAX64, 0) && !sf_bound_sum_ok(CB_MAX64, 1);
  #assert sf_bound_sum_ok(CB_MAX64 - 1, 1);
  #assert sf_bound_product(7, 9) == 63 && sf_bound_sum(7, 9) == 16;
  #assert !sf_mul_bounds(0).ok && !sf_mul_bounds(9).ok;
  #assert !sf_mul_bounds(-9223372036854775808).ok && !sf_mul_bounds(9223372036854775807).ok;
  bad := sf_mul_bounds(9); for i: 0..<27 { #assert bad.facts[i] == 0; }
}
#test "multiplication and square known residues" {
  zero: SecpField; one: SecpField; one.limb[0] = 1;
  two: SecpField; two.limb[0] = 2; four: SecpField; four.limb[0] = 4;
  #assert sf_equal_mask(sf_multiply(zero, two), zero) == CB_MAX64;
  #assert sf_equal_mask(sf_multiply(two, one), two) == CB_MAX64;
  #assert sf_equal_mask(sf_square(two), four) == CB_MAX64;
  #assert sf_equal_mask(sf_square(sf_negate(one)), one) == CB_MAX64;
  #assert sf_equal_mask(sf_multiply(sf_negate(two), two), sf_negate(four)) == CB_MAX64;
  c: SecpField; c.limb[0] = 977; c.limb[1] = 64;
  // This product's second fold equals2^256 and exercises the final carry1.
  #assert sf_equal_mask(sf_multiply(sf_negate(one), sf_negate(c)), c) == CB_MAX64;
}
#forall "radix carry preserves each public span and every single carry edge" length: 1..<33, at: 0..<32 {
  digits: [33] u64;
  digits[at] = 67108864;
  #assert sf_radix_carry(digits[0..<length]);
  for i: 0..<33 {
    want: u64;
    if at < length - 1 {
      if i == at + 1 { want = 1; }
    } else { if i == at { want = 67108864; } }
    #assert digits[i] == want;
  }
}
#test "radix carry refuses empty or excessive public views without mutation" {
  digits: [33] u64;
  digits[0] = 67108864;
  #assert !sf_radix_carry(digits[..]) && !sf_radix_carry(digits[0..<0]);
  #assert digits[0] == 67108864;
}
#forall "every radix bit squares and multiplies by its additive inverse" bit: 0..<256 {
  a: SecpField; one: SecpField; one.limb[0] = 1;
  a.limb[bit / 26] = cast(u64) 1 << (bit % 26);
  #assert sf_equal_mask(sf_multiply(a, one), a) == CB_MAX64;
  square := sf_square(a);
  #assert sf_equal_mask(sf_multiply(a, sf_negate(a)), sf_negate(square)) == CB_MAX64;
  #assert sf_debug_valid(sf_debug_normalize(SecpFieldDebug.{value = square, magnitude = 1, normalized = true}));
}
#forall "magnitude8 products agree with an independent small polynomial" magnitude: 1..<9 {
  a: SecpField; expected: SecpField;
  for i: 0..<9 { a.limb[i] = cast(u64) magnitude * SF_MASK26; }
  a.limb[9] = cast(u64) magnitude * SF_MASK22;
  // a reduces to m*(2^32+976). Square its three-term polynomial directly.
  m := cast(u64) magnitude;
  expected.limb[0] = m * m * 976 * 976;
  expected.limb[1] = m * m * 2 * 976 * 64;
  expected.limb[2] = m * m * 64 * 64;
  #assert sf_equal_mask(sf_square(a), sf_normalize(expected)) == CB_MAX64;
}

#test "zero one p-minus-one and maximum256 load modulo p" {
  bytes: [32] u8; zero: SecpField;
  #assert sf_load(bytes[..]).ok && sf_equal_mask(sf_load(bytes[..]).value, zero) == CB_MAX64;
  bytes[31] = 1; one := sf_load(bytes[..]).value;
  #assert one.limb[0] == 1 && sf_store(one, bytes[..]);
  for i: 0..<31 { #assert bytes[i] == 0; }
  #assert bytes[31] == 1;
  p: SecpField; p.limb = SF_P;
  #assert sf_equal_mask(sf_normalize(p), zero) == CB_MAX64;
  minus := sf_negate(one); #assert sf_store(minus, bytes[..]);
  for i: 0..<27 { #assert bytes[i] == 255; }
  #assert bytes[27] == 254 && bytes[28] == 255 && bytes[29] == 255 && bytes[30] == 252 && bytes[31] == 46;
  #assert sf_load_strict(bytes[..]).ok;
  bytes[31] = 47; #assert !sf_load_strict(bytes[..]).ok;
  #assert sf_equal_mask(sf_load_strict(bytes[..]).value, zero) == CB_MAX64;
  for i: 0..<32 { bytes[i] = 255; }
  maximum := sf_load(bytes[..]); #assert maximum.ok;
  #assert maximum.value.limb[0] == 976 && maximum.value.limb[1] == 64;
  for i: 2..<10 { #assert maximum.value.limb[i] == 0; }
  #assert !sf_load_strict(bytes[..]).ok;
  for i: 0..<10 { #assert sf_load_strict(bytes[..]).value.limb[i] == 0; }
}
#forall "every limb-boundary bit round-trips and cancels under addition" bit: 0..<256 {
  a: SecpField; zero: SecpField; bytes: [32] u8;
  a.limb[bit / 26] = cast(u64) 1 << (bit % 26);
  #assert sf_store(a, bytes[..]) && sf_load_strict(bytes[..]).ok;
  #assert sf_equal_mask(sf_load(bytes[..]).value, a) == CB_MAX64;
  #assert sf_equal_mask(a, zero) == 0 && sf_equal_mask(zero, a) == 0;
  #assert sf_equal_mask(sf_add(a, sf_negate(a)), zero) == CB_MAX64;
  #assert sf_equal_mask(sf_subtract(a, a), zero) == CB_MAX64;
  #assert bytes[31 - bit / 8] == cast(u8) (cast(u64) 1 << (bit % 8));
}
#test "canonical arithmetic crosses p without checked underflow" {
  zero: SecpField; one: SecpField; one.limb[0] = 1;
  two: SecpField; two.limb[0] = 2;
  #assert sf_equal_mask(sf_add(one, one), two) == CB_MAX64;
  #assert sf_equal_mask(sf_negate(zero), zero) == CB_MAX64;
  #assert sf_equal_mask(sf_add(sf_negate(one), one), zero) == CB_MAX64;
  #assert sf_equal_mask(sf_add(sf_negate(one), sf_negate(one)), sf_negate(two)) == CB_MAX64;
  #assert sf_equal_mask(sf_subtract(zero, one), sf_negate(one)) == CB_MAX64;
}
#forall "all admitted magnitudes fold to the same independently small residue" magnitude: 1..<9 {
  a: SecpField; expected: SecpField;
  for i: 0..<9 { a.limb[i] = cast(u64) magnitude * SF_MASK26; }
  a.limb[9] = cast(u64) magnitude * SF_MASK22;
  expected.limb[0] = cast(u64) magnitude * 976;
  expected.limb[1] = cast(u64) magnitude * 64;
  #assert sf_equal_mask(sf_normalize(a), expected) == CB_MAX64;
  #assert sf_equal_mask(sf_add(a, a), sf_add(expected, expected)) == CB_MAX64;
  d: SecpFieldDebug; d.value = a; d.magnitude = magnitude;
  normalized := sf_debug_normalize(d);
  #assert normalized.magnitude == 1 && normalized.normalized && sf_debug_valid(normalized);
  #assert sf_equal_mask(normalized.value, expected) == CB_MAX64;
  sum := sf_debug_add(d, d); negative := sf_debug_negate(d);
  #assert sum.magnitude == 1 && sum.normalized && sf_equal_mask(sum.value, sf_add(expected, expected)) == CB_MAX64;
  #assert negative.magnitude == 1 && negative.normalized && sf_equal_mask(negative.value, sf_negate(expected)) == CB_MAX64;
}
#forall "diagnostic bounds reject an actual limb-bound violation" index: 0..<10, magnitude: 1..<9 {
  d: SecpFieldDebug; d.magnitude = magnitude;
  limit := cast(u64) magnitude * (ifx index == 9 then SF_MASK22 else SF_MASK26);
  d.value.limb[index] = limit; #assert sf_debug_valid(d);
  d.value.limb[index] = limit + 1; #assert !sf_debug_valid(d);
}
#test "normalized debug metadata and public wire lengths are checked" {
  d: SecpFieldDebug; #assert !sf_debug_valid(d);
  d.magnitude = -1; #assert !sf_debug_valid(d);
  d.magnitude = 9; #assert !sf_debug_valid(d);
  d.magnitude = 1; d.normalized = true; #assert sf_debug_valid(d);
  d.value.limb = SF_P; d.value.limb[0] -= 1; #assert sf_debug_valid(d);
  d.value.limb = SF_P; #assert !sf_debug_valid(d);
  d.normalized = false; #assert sf_debug_valid(d);
  d.magnitude = 2; d.normalized = true; #assert !sf_debug_valid(d);
  bytes: [33] u8; for i: 0..<33 { bytes[i] = 165; } before := bytes; a: SecpField;
  #assert !sf_load(bytes[..]).ok && !sf_load(bytes[0..<31]).ok && !sf_load(bytes[0..<0]).ok;
  #assert !sf_load_strict(bytes[..]).ok;
  #assert !sf_store(a, bytes[..]) && !sf_store(a, bytes[0..<31]);
  for i: 0..<33 { #assert bytes[i] == before[i]; }
}

// Internal fixed-length carry pass. Each caller supplies its own ten limbs.
sf_carry :: (digits: [] u64) -> u64 {
  #assert digits.count == 10;
  for i: 0..<9 {
    carry := digits[i] >> 26;
    digits[i] &= SF_MASK26;
    digits[i + 1] += carry;
  }
  carry := digits[9] >> 22;
  digits[9] &= SF_MASK22;
  return carry;
}
sf_normalize :: (value: SecpField) -> SecpField #export_c {
  r := value;
  // Initial carry <=7. Low folding additions <=7*977 and 7*64; all
  // accumulators are <2^30. The next top carry <=1. If it is1, the masked
  // top digit is0, so the final pass cannot overflow bit256 again.
  carry := sf_carry(r.limb[..]);
  r.limb[0] += carry * 977; r.limb[1] += carry * 64;
  carry = sf_carry(r.limb[..]);
  r.limb[0] += carry * 977; r.limb[1] += carry * 64;
  carry = sf_carry(r.limb[..]);
  #assert carry == 0; // proven for admitted magnitude<=8; not a secret decision
  // Now r<2^256. Adding c=2^32+977 overflows exactly when r>=p;
  // the low256 bits are then r-p. Select without a secret comparison.
  candidate := r;
  candidate.limb[0] += 977; candidate.limb[1] += 64;
  choose := cb_mask(sf_carry(candidate.limb[..]));
  for i: 0..<10 { r.limb[i] = cb_ct_select64(choose, candidate.limb[i], r.limb[i]); }
  return r;
}
sf_load :: (bytes: [] u8) -> SecpFieldResult #export_c {
  r: SecpFieldResult;
  if bytes.count != 32 { return r; }
  for i: 0..<32 {
    at := i * 8; digit := at / 26; shift := at % 26;
    value := cast(u64) bytes[31 - i];
    r.value.limb[digit] |= (value << shift) & SF_MASK26;
    // A non-spilling byte contributes zero. The last byte's next digit wraps
    // to0, also with a zero contribution; every address depends only on i.
    r.value.limb[(digit + 1) % 10] |= value >> (26 - shift);
  }
  r.value = sf_normalize(r.value); r.ok = true; return r;
}
sf_store :: (value: SecpField, bytes: [] u8) -> bool #export_c {
  if bytes.count != 32 { return false; }
  r := sf_normalize(value);
  for i: 0..<32 {
    at := i * 8; digit := at / 26; shift := at % 26;
    word := r.limb[digit] >> shift;
    // Unneeded next-digit bits lie above bit7 and are removed below.
    word |= r.limb[(digit + 1) % 10] << (26 - shift);
    bytes[31 - i] = cast(u8) (word & 255);
  }
  return true;
}
sf_load_strict :: (bytes: [] u8) -> SecpFieldResult #export_c {
  r := sf_load(bytes);
  if !r.ok { return r; }
  canonical: [32] u8;
  stored := sf_store(r.value, canonical[..]);
  same := cb_ct_equal(bytes, canonical[..]);
  r.ok = same == CB_MAX64;
  for i: 0..<10 { r.value.limb[i] &= same; }
  return r;
}
sf_add :: (a: SecpField, b: SecpField) -> SecpField #export_c {
  x := sf_normalize(a); y := sf_normalize(b);
  for i: 0..<10 { x.limb[i] += y.limb[i]; }
  return sf_normalize(x);
}
sf_negate :: (a: SecpField) -> SecpField #export_c {
  x := sf_normalize(a);
  // Each 2*p digit >= every canonical input digit. No unsigned borrow
  // or wrapping arithmetic is needed; this represents2p-x before reduction.
  for i: 0..<10 { x.limb[i] = SF_P[i] + SF_P[i] - x.limb[i]; }
  return sf_normalize(x);
}
sf_subtract :: (a: SecpField, b: SecpField) -> SecpField #export_c { return sf_add(a, sf_negate(b)); }
sf_equal_mask :: (a: SecpField, b: SecpField) -> u64 #export_c {
  x := sf_normalize(a); y := sf_normalize(b); diff: u64;
  for i: 0..<10 { diff |= x.limb[i] ^ y.limb[i]; }
  // diff<=2^26-1, hence diff+mask<2^27 and bit26 means nonzero.
  return cb_mask(((diff + SF_MASK26) >> 26) ^ 1);
}
sf_debug_valid :: (d: SecpFieldDebug) -> bool #export_c {
  if d.magnitude < 1 || d.magnitude > SF_MAGNITUDE { return false; }
  for i: 0..<10 {
    mask := ifx i == 9 then SF_MASK22 else SF_MASK26;
    if d.value.limb[i] > cast(u64) d.magnitude * mask { return false; }
  }
  if d.normalized {
    if d.magnitude != 1 { return false; }
    candidate := d.value;
    candidate.limb[0] += 977; candidate.limb[1] += 64;
    return sf_carry(candidate.limb[..]) == 0;
  }
  return true;
}
sf_debug_normalize :: (d: SecpFieldDebug) -> SecpFieldDebug #export_c {
  #assert sf_debug_valid(d);
  r := d; r.value = sf_normalize(d.value); r.magnitude = 1; r.normalized = true; return r;
}
sf_debug_add :: (a: SecpFieldDebug, b: SecpFieldDebug) -> SecpFieldDebug #export_c {
  x := sf_debug_normalize(a); y := sf_debug_normalize(b);
  x.value = sf_add(x.value, y.value); return x;
}
sf_debug_negate :: (a: SecpFieldDebug) -> SecpFieldDebug #export_c {
  x := sf_debug_normalize(a); x.value = sf_negate(x.value); return x;
}

// Bound helpers execute on public compile-time metadata, never on secrets.
sf_bound_product_ok :: (a: u64, b: u64) -> bool { return b == 0 || a <= CB_MAX64 / b; }
sf_bound_sum_ok :: (a: u64, b: u64) -> bool { return a <= CB_MAX64 - b; }
sf_bound_product :: (a: u64, b: u64) -> u64 { #assert sf_bound_product_ok(a, b); return a * b; }
sf_bound_sum :: (a: u64, b: u64) -> u64 { #assert sf_bound_sum_ok(a, b); return a + b; }
sf_mul_budget :: (bounds: SfMulBounds) -> bool {
  for i: 0..<27 { if bounds.facts[i] > SF_MUL_LIMITS[i] { return false; } }
  if bounds.facts[24] > bounds.facts[6] { return false; }
  if bounds.facts[25] > bounds.facts[11] { return false; }
  return true;
}
sf_mul_bounds :: (magnitude: int) -> SfMulBounds {
  r: SfMulBounds;
  if magnitude < 1 || magnitude > 8 { return r; }
  m := cast(u64) magnitude;
  // The admitted input normalization schedule has at most m-1 initial carry.
  r.facts[0] = sf_bound_sum(sf_bound_product(m, SF_MASK26), m - 1);
  r.facts[1] = sf_bound_sum(sf_bound_product(m, SF_MASK22), m - 1);
  r.facts[2] = sf_bound_sum(SF_MASK26, sf_bound_product(m - 1, 977));
  r.facts[3] = sf_bound_sum(SF_MASK26, sf_bound_product(m - 1, 64));
  // Canonical operands: at most ten products per convolution coefficient.
  r.facts[4] = sf_bound_product(SF_MASK26, SF_MASK26);
  r.facts[5] = sf_bound_product(r.facts[4], 10);
  r.facts[6] = sf_bound_product(SF_MASK26 + 1, 10);
  r.facts[7] = sf_bound_sum(r.facts[5], r.facts[6]);
  r.facts[8] = sf_bound_sum(sf_bound_product(SF_MASK22, SF_MASK22), r.facts[6]);
  // p19 comes only from carrying p18; p18's own product uses two22-bit digits.
  r.facts[9] = sf_bound_sum(SF_MASK26 >> 22, (r.facts[8] >> 26) << 4);
  // Every other q digit <=MASK26. Even the conservative q9 bound is smaller.
  r.facts[10] = sf_bound_sum(SF_MASK26, sf_bound_sum(sf_bound_product(SF_MASK26, 977), sf_bound_product(SF_MASK26, 64)));
  r.facts[11] = 2048;
  r.facts[12] = sf_bound_sum(r.facts[10], r.facts[11]);
  r.facts[26] = sf_bound_sum(sf_bound_product(r.facts[9], 64), r.facts[11]);
  r.facts[13] = r.facts[26] >> 26;
  r.facts[14] = sf_bound_sum(SF_MASK26 >> 22, r.facts[13] << 4);
  r.facts[15] = sf_bound_sum(SF_MASK26, sf_bound_product(SF_MASK26, 977));
  r.facts[16] = r.facts[15] >> 26;
  r.facts[17] = sf_bound_sum(sf_bound_sum(SF_MASK26, sf_bound_sum(sf_bound_product(r.facts[14], 977), sf_bound_product(SF_MASK26, 64))), r.facts[16]);
  r.facts[18] = r.facts[17] >> 26;
  r.facts[19] = sf_bound_sum(SF_MASK26, sf_bound_sum(sf_bound_product(r.facts[14], 64), r.facts[18]));
  r.facts[20] = r.facts[19] >> 26;
  // All subsequent carries, including bit256, are <=1. Folding that carry
  // leaves magnitude<=2 for the already-proved normalization schedule.
  r.facts[21] = sf_bound_sum(SF_MASK26, 977);
  r.facts[22] = sf_bound_sum(SF_MASK26, 64);
  r.facts[23] = m;
  r.facts[24] = r.facts[7] >> 26;
  r.facts[25] = r.facts[12] >> 26;
  r.ok = sf_mul_budget(r); return r;
}
// Carry every lower digit into its successor. The caller's proven bounds
// admit every addition; the final digit retains its full carry. Counts/public
// indices are the only choices, with no validation branch on secret digits.
sf_radix_carry :: (digits: [] u64) -> bool {
  if digits.count < 1 || digits.count > 32 { return false; }
  for i: 0..<digits.count - 1 {
    digits[i + 1] += digits[i] >> 26;
    digits[i] &= SF_MASK26;
  }
  return true;
}
sf_multiply :: (a: SecpField, b: SecpField) -> SecpField #export_c {
  x := sf_normalize(a); y := sf_normalize(b); product: [20] u64;
  for i: 0..<10 { for j: 0..<10 { product[i + j] += x.limb[i] * y.limb[j]; } }
  #assert sf_radix_carry(product[..]);
  // Split at bit256 and fold the high part by c=2^32+977.
  r: SecpField; fold: [12] u64;
  for i: 0..<10 { fold[i] = product[i]; }
  fold[9] &= SF_MASK22;
  for i: 0..<10 {
    q := (product[i + 9] >> 22) | ((product[i + 10] & SF_MASK22) << 4);
    fold[i] += q * 977; fold[i + 1] += q * 64;
  }
  #assert sf_radix_carry(fold[..]);
  for i: 0..<10 { r.limb[i] = fold[i]; }
  r.limb[9] &= SF_MASK22;
  q0 := (fold[9] >> 22) | ((fold[10] & SF_MASK22) << 4);
  q1 := (fold[10] >> 22) | (fold[11] << 4);
  r.limb[0] += q0 * 977;
  r.limb[1] += q1 * 977 + q0 * 64;
  r.limb[2] += q1 * 64;
  carry := sf_carry(r.limb[..]);
  r.limb[0] += carry * 977; r.limb[1] += carry * 64;
  return sf_normalize(r);
}
sf_square :: (a: SecpField) -> SecpField #export_c { return sf_multiply(a, a); }

#test "the public chain proves both full256-bit exponents" {
  prefix := sf_exponent_prefix();
  for i: 0..<13 { for j: 0..<8 { #assert prefix.value[i].word[j] == SF_FIELD_EXPONENT_PREFIX.value[i].word[j]; } }
  #assert sf_exponent_matches(sf_exponent_inverse(), false);
  #assert sf_exponent_matches(sf_exponent_sqrt(), true);
}
#forall "exponent addition propagates a carry through every word boundary" boundary: 1..<8 {
  a: SfExponent; one: SfExponent; one.word[0] = 1;
  for i: 0..<boundary { a.word[i] = 4294967295; }
  result := sf_exponent_step(a, 0, one);
  for i: 0..<8 { #assert result.word[i] == (ifx i == boundary then cast(u32) 1 else cast(u32) 0); }
}
#forall "every exponent byte participates in its certificate" root_mode: bool, at: 0..<32 {
  exponent := ifx root_mode then SF_SQRT_EXPONENT else SF_INVERSE_EXPONENT;
  exponent.word[at / 4] ^= cast(u32) 1 << ((at % 4) * 8);
  #assert !sf_exponent_matches(exponent, root_mode);
}
#forall "square counts are public bounded metadata" count: -1..<258 {
  #assert sf_square_count_valid(count) == (count >= 0 && count <= 256);
}
#forall "chain dependencies refer only to preceding public states" index: -1..<13, left: -1..<14, right: -1..<14 {
  step := SfChainStep.{left = left, squares = 1, right = right};
  expected := index >= 0 && index < 12 && left >= 0 && left <= index && right >= 0 && right <= index;
  #assert sf_chain_step_valid(step, index) == expected;
}
#test "chain square metadata accepts exact bounds and refuses the outside" {
  step := SfChainStep.{left = 0, squares = 0, right = 0};
  #assert sf_chain_step_valid(step, 0);
  step.squares = 256; #assert sf_chain_step_valid(step, 0);
  step.squares = -1; #assert !sf_chain_step_valid(step, 0);
  step.squares = 257; #assert !sf_chain_step_valid(step, 0);
}
#test "public zero square count preserves the supplied value" {
  a: SecpField; a.limb[0] = 2;
  #assert sf_equal_mask(sf_square_n(a, 0), a) == CB_MAX64;
}
#test "inverse two and the explicit public-input alias agree" {
  a: SecpField; a.limb[0] = 2; one: SecpField; one.limb[0] = 1;
  result := sf_inverse(a); #assert result.ok;
  #assert sf_equal_mask(sf_multiply(a, result.value), one) == CB_MAX64;
  public_result := sf_inverse_vartime(a);
  #assert public_result.ok && sf_equal_mask(public_result.value, result.value) == CB_MAX64;
}
#test "zero inverse refuses after the full chain including its noncanonical alias" {
  zero: SecpField; p: SecpField; p.limb = SF_P;
  result := sf_inverse(zero); alias := sf_inverse(p);
  #assert !result.ok && !alias.ok;
  #assert sf_equal_mask(result.value, zero) == CB_MAX64 && sf_equal_mask(alias.value, zero) == CB_MAX64;
}
#test "square roots have canonical even parity" {
  two: SecpField; two.limb[0] = 2; four: SecpField; four.limb[0] = 4;
  three: SecpField; three.limb[0] = 3; nine: SecpField; nine.limb[0] = 9;
  a := sf_sqrt(four); b := sf_sqrt(nine);
  #assert a.ok && b.ok;
  #assert sf_equal_mask(a.value, two) == CB_MAX64;
  #assert sf_equal_mask(b.value, sf_negate(three)) == CB_MAX64;
}
#test "zero is a square root and a nonresidue releases no candidate" {
  zero: SecpField; one: SecpField; one.limb[0] = 1; three: SecpField; three.limb[0] = 3;
  a := sf_sqrt(zero); b := sf_sqrt(three); c := sf_sqrt(one);
  #assert a.ok && !b.ok && c.ok;
  #assert sf_equal_mask(a.value, zero) == CB_MAX64 && sf_equal_mask(b.value, zero) == CB_MAX64;
  #assert sf_equal_mask(c.value, sf_negate(one)) == CB_MAX64;
}

sf_square_count_valid :: (count: int) -> bool { return count >= 0 && count <= 256; }
sf_chain_step_valid :: (step: SfChainStep, index: int) -> bool {
  return index >= 0 && index < 12 && step.left >= 0 && step.left <= index && step.right >= 0 && step.right <= index && sf_square_count_valid(step.squares);
}
sf_square_n :: (a: SecpField, count: int) -> SecpField {
  #assert sf_square_count_valid(count);
  r := a; for i: 0..<count { r = sf_square(r); } return r;
}
sf_chain_prefix :: (a: SecpField) -> SfChainState {
  cache: SfChainState; cache.value[0] = sf_normalize(a);
  for i: 0..<12 {
    step := SF_FIELD_CHAIN[i];
    #assert sf_chain_step_valid(step, i);
    cache.value[i + 1] = sf_multiply(sf_square_n(cache.value[step.left], step.squares), cache.value[step.right]);
  }
  return cache;
}
sf_inverse :: (a: SecpField) -> SecpFieldResult #export_c {
  cache := sf_chain_prefix(a);
  power9 := sf_multiply(sf_square(cache.value[1]), cache.value[1]);
  power45 := sf_multiply(sf_square_n(power9, 2), power9);
  r: SecpFieldResult;
  r.value = sf_multiply(sf_square_n(cache.value[12], 10), power45);
  zero: SecpField;
  // The positive exponent already produces zero for zero input. No
  // redundant clearing pass is needed to guarantee a zero refusal value.
  valid := CB_MAX64 ^ sf_equal_mask(r.value, zero);
  r.ok = valid == CB_MAX64; return r;
}
// Explicitly public-input entry point. It currently shares the fixed chain;
// no variable-time optimization or secret-taint enforcement is claimed.
sf_inverse_vartime :: (a: SecpField) -> SecpFieldResult #export_c { return sf_inverse(a); }
sf_sqrt :: (a: SecpField) -> SecpFieldResult #export_c {
  cache := sf_chain_prefix(a);
  root := sf_square_n(sf_multiply(sf_square_n(cache.value[12], 6), cache.value[1]), 2);
  valid := sf_equal_mask(sf_square(root), cache.value[0]);
  negative := sf_negate(root); odd := cb_mask(root.limb[0] & 1);
  r: SecpFieldResult;
  for i: 0..<10 { r.value.limb[i] = cb_ct_select64(odd, negative.limb[i], root.limb[i]) & valid; }
  r.ok = valid == CB_MAX64; return r;
}

// Compile-time exponent arithmetic, not field or secret arithmetic. Shifts
// and addition are exact over all256 bits and refuse overflow explicitly.
sf_exponent_step :: (a: SfExponent, squares: int, b: SfExponent) -> SfExponent {
  #assert sf_square_count_valid(squares);
  r := a;
  for i: 0..<squares {
    carry: u64;
    for j: 0..<8 {
      word := cast(u64) r.word[j] * 2 + carry;
      r.word[j] = cast(u32) (word & 4294967295); carry = word >> 32;
    }
    #assert carry == 0;
  }
  carry: u64;
  for j: 0..<8 {
    word := cast(u64) r.word[j] + cast(u64) b.word[j] + carry;
    r.word[j] = cast(u32) (word & 4294967295); carry = word >> 32;
  }
  #assert carry == 0; return r;
}
sf_exponent_prefix :: () -> SfExponentState {
  cache: SfExponentState; cache.value[0].word[0] = 1;
  for i: 0..<12 {
    step := SF_FIELD_CHAIN[i];
    #assert sf_chain_step_valid(step, i);
    cache.value[i + 1] = sf_exponent_step(cache.value[step.left], step.squares, cache.value[step.right]);
  }
  return cache;
}
sf_exponent_inverse :: () -> SfExponent {
  cache := SF_FIELD_EXPONENT_PREFIX;
  power9 := sf_exponent_step(cache.value[1], 1, cache.value[1]);
  power45 := sf_exponent_step(power9, 2, power9);
  return sf_exponent_step(cache.value[12], 10, power45);
}
sf_exponent_sqrt :: () -> SfExponent {
  cache := SF_FIELD_EXPONENT_PREFIX; zero: SfExponent;
  return sf_exponent_step(sf_exponent_step(cache.value[12], 6, cache.value[1]), 2, zero);
}
sf_exponent_matches :: (exponent: SfExponent, root_mode: bool) -> bool {
  expected: [8] u32; for i: 1..<8 { expected[i] = 4294967295; }
  if root_mode { expected[0] = 0xBFFFFF0C; expected[7] = 0x3FFFFFFF; }
  else { expected[0] = 0xFFFFFC2D; expected[1] = 0xFFFFFFFE; }
  for i: 0..<8 { if exponent.word[i] != expected[i] { return false; } }
  return true;
}
