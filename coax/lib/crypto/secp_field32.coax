// Candidate canonical 8x32 arithmetic for fixed-work variable-base multiplication.
// This remains experimental pending independent arithmetic and target review.
#load "bytes.coax";
#authority;
Sf32 :: struct { limb: [8] u32; }
Sf32Fold :: struct { value: Sf32; carry: u64; }
SF32_WORD :: 4294967295;
SF32_P :: Sf32.{limb=[8]u32.[4294966319,4294967294,4294967295,4294967295,4294967295,4294967295,4294967295,4294967295]};

#test "canonical edge values obey secp256k1 field arithmetic" {
  zero: Sf32; one: Sf32; one.limb[0]=1;
  minus_one:=SF32_P; minus_one.limb[0]-=1;
  minus_two:=SF32_P; minus_two.limb[0]-=2;
  #assert sf32_equal(sf32_add(minus_one,one),zero);
  #assert sf32_equal(sf32_add(minus_one,minus_one),minus_two);
  #assert sf32_equal(sf32_sub(zero,one),minus_one);
  #assert sf32_equal(sf32_sub(one,one),zero);
  #assert sf32_equal(sf32_mul(minus_one,minus_one),one);
  #assert sf32_equal(sf32_mul(zero,minus_one),zero);
}
#test "fixed full-width product fixtures cross the prime boundary" {
  a:=Sf32.{limb=[8]u32.[4294967295,4294967295,4294967295,4294967295,0,0,0,0]};
  want:=Sf32.{limb=[8]u32.[1,0,0,0,4294967294,4294967295,4294967295,4294967295]};
  #assert sf32_equal(sf32_mul(a,a),want);
  b:=Sf32.{limb=[8]u32.[12345,0,0,0,0,0,0,2147483648]};
  c:=Sf32.{limb=[8]u32.[98765,0,0,0,0,0,1,0]};
  expected:=Sf32.{limb=[8]u32.[1267500139,49382,0,0,0,2147483648,2147496481,2147483648]};
  #assert sf32_equal(sf32_mul(b,c),expected);
}
#test "multiplication folds a carry from the first high reduction" {
  a:=Sf32.{limb=[8]u32.[4294966319,4294967294,4294967295,4294967295,4294967294,4294967295,4294967295,4294967295]};
  expected:Sf32;expected.limb[0]=977;expected.limb[1]=1;
  #assert sf32_equal(sf32_mul(a,a),expected);
}
#forall "equality notices each canonical limb" limb:0..<8 {
  zero:Sf32;different:Sf32;different.limb[limb]=1;
  #assert sf32_equal(zero,zero) && !sf32_equal(zero,different) && !sf32_equal(different,zero);
}
#forall "small operands match ordinary add subtract and product" a: 0..<16, b: 0..<16 {
  x:Sf32; y:Sf32; x.limb[0]=cast(u32)a; y.limb[0]=cast(u32)b;
  sum:=sf32_add(x,y); product:=sf32_mul(x,y);
  #assert sum.limb[0] == cast(u32)(a+b) && product.limb[0] == cast(u32)(a*b);
  #assert sf32_equal(sf32_add(sf32_sub(x,y),y),x);
}

sf32_equal :: (a:Sf32,b:Sf32)->bool {
  difference:u64; for i:0..<8 {difference |= cast(u64)(a.limb[i] ^ b.limb[i]);} return difference == 0;
}
sf32_fold_top :: (input:Sf32,top:u64)->Sf32Fold {
  r:Sf32Fold; carry:=mul_wrap(top,977);
  for i:0..<8 {
    // i is public; only limb1 receives the 2^32 part of top.
    extra:=ifx i==1 then top else cast(u64)0;
    wide:=cast(u64)input.limb[i]+carry+extra;
    r.value.limb[i]=cast(u32)(wide&SF32_WORD); carry=wide>>32;
  }
  r.carry=carry;return r;
}
sf32_canonical :: (input:Sf32)->Sf32 {
  folded:=sf32_fold_top(input,1);mask:=cast(u32)(cb_mask(folded.carry)&SF32_WORD);r:Sf32;
  for i:0..<8 {r.limb[i]=cb_ct_select32(mask,folded.value.limb[i],input.limb[i]);}
  return r;
}
sf32_add :: (a:Sf32,b:Sf32)->Sf32 {
  r:Sf32;carry:u64;
  for i:0..<8 {wide:=cast(u64)a.limb[i]+cast(u64)b.limb[i]+carry;r.limb[i]=cast(u32)(wide&SF32_WORD);carry=wide>>32;}
  // Canonical a,b < p imply a+b < 2p. If the sum carries bit256,
  // its low part is < 2^256-2*(2^32+977), so one fold cannot carry.
  folded:=sf32_fold_top(r,carry);
  #assert folded.carry==0; return sf32_canonical(folded.value);
}
sf32_sub :: (a:Sf32,b:Sf32)->Sf32 {
  r:Sf32;borrow:u64;
  for i:0..<8 {wide:=(cast(u64)1<<32)+cast(u64)a.limb[i]-cast(u64)b.limb[i]-borrow;r.limb[i]=cast(u32)(wide&SF32_WORD);borrow=1-(wide>>32);}
  mask:=cast(u32)(cb_mask(borrow)&SF32_WORD);carry:u64;
  for i:0..<8 {wide:=cast(u64)r.limb[i]+cast(u64)(SF32_P.limb[i]&mask)+carry;r.limb[i]=cast(u32)(wide&SF32_WORD);carry=wide>>32;}
  return r;
}
sf32_mul :: (a:Sf32,b:Sf32)->Sf32 {
  product:[16]u32;
  for i:0..<8 {
    carry:u64;
    for j:0..<8 {wide:=mul_wrap(cast(u64)a.limb[i],cast(u64)b.limb[j])+cast(u64)product[i+j]+carry;product[i+j]=cast(u32)(wide&SF32_WORD);carry=wide>>32;}
    product[i+8]=cast(u32)carry;
  }
  r:Sf32;carry:u64;previous:u64;
  for i:0..<8 {
    high:=cast(u64)product[i+8];wide:=cast(u64)product[i]+mul_wrap(high,977)+previous+carry;
    r.limb[i]=cast(u32)(wide&SF32_WORD);carry=wide>>32;previous=high;
  }
  top:=previous+carry;folded:=sf32_fold_top(r,top);folded=sf32_fold_top(folded.value,folded.carry);
  #assert folded.carry==0;return sf32_canonical(folded.value);
}
