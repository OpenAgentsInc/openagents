// Page profile: 128 canonical Jacobian entries, 30720 bytes on LP64/Wasm.
// Both generation and evaluation are Coax. No runtime table construction.
#load "secp_mult_base.coax";
#assert size_of(SgPoint) == 240;
#assert 7*37 >= 256 && 7*37 <= 288;
#assert 128*size_of(SgPoint) <= 32768;
#authority;
#test "web comb profile remains seven teeth at spacing37" {
  #assert smb_web_width() == 7 && smb_web_spacing() == 37;
}
#test "web table storage adapter preserves the active prefix" {
  table := smb_web_table(2,1);
  #assert sg_equal_mask(table[0],sg_infinity()) == CB_MAX64;
  #assert sg_equal_mask(table[1],sg_generator()) == CB_MAX64;
  #assert sg_equal_mask(table[2],sg_double_valid(sg_generator())) == CB_MAX64;
  #assert table[4].x.limb[0] == 0 && table[127].z.limb[0] == 0;
}
#test "web compiled table drives the complete online path" {
  #assert sg_equal_mask(smb_multiply_web(sc_small(1)),sg_generator()) == CB_MAX64;
}
// Private PUBLIC-generation helper: width1..7 and spacing1..64. Small
// configurations exercise its storage/Coax generator adapter in checks;
// the actual fixed7/37 table is independently compared entry by entry.
smb_web_table :: (width: int,spacing: int) -> [128] SgPoint #effects(all) {
  table: [128] SgPoint;
  #assert smb_generate(table[0..<1 << width],width,spacing);
  return table;
}
SMB_WEB_TABLE :: #run smb_web_table(7,37);
smb_web_width :: () -> int #effects(all) { return 7; }
smb_web_spacing :: () -> int #effects(all) { return 37; }
// k*G for a secret k: the fixed-work 5x52 comb of secp_ct_group.coax
// (#13454). The seven-tooth comb below remains its reference.
smb_multiply_web :: (scalar: ScScalar) -> SgPoint #export_c #effects(all) {
  return sg32_to_point(cg_to_sg32(cg_comb(scalar)));
}
#forall "the 5x52 comb equals the seven-tooth comb" seed: 0..<6 #steps 2000000000 {
  k: ScScalar; for i: 0..<8 { k.limbs[i] = cast,trunc(u32)(mul_wrap(cast(u64)(seed*8+i+1),2654435761)); }
  if seed == 0 { k = SC_N; } if seed == 1 { k = sc_sub(SC_N,sc_small(1)); }
  #assert sg_equal_mask(smb_multiply_web(k),smb_multiply_web_comb(k)) == CB_MAX64;
}
smb_multiply_web_comb :: (scalar: ScScalar) -> SgPoint #effects(all) {
  // Current mutable-view ABI requires a local copy of the immutable table.
  // This scratch copy contains public points and is part of the stack budget.
  table := SMB_WEB_TABLE;
  return smb_comb(scalar,table[..],smb_web_width(),smb_web_spacing());
}
