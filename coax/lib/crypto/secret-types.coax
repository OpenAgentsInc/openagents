// Representation-only projection of the real parser's indexed nodes. The
// native bridge asserts used tag/operator IDs against the actual frontend.
ScNode :: struct {kind:u32;unit:int;line:int;column:int;name:string;a:int;b:int;c:int;d:int;head:int;next:int;op:u32;flag:bool;flag2:bool;}
ScType :: struct {unit:int;procedure:string;procedure_line:int;name:string;line:int;role:string;type:string;}
ScPath :: struct {value:string;}
ScResult :: struct {error:u32;unit:int;line:int;column:int;reached:int;visits:int;return_mask:u64;}
