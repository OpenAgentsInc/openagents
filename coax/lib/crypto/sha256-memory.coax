// Address-observation bridge only. The core owns lifecycle and refusal policy.
#load "sha256.coax";
sha256_update :: (state: [] u8,input: [] u8) -> u32 #export_c {return sha256_update_checked(state,input,bytes_overlap(state,input));}
sha256_final :: (state: [] u8,out: [] u8) -> u32 #export_c {return sha256_final_checked(state,out,bytes_overlap(state,out));}
sha256_hash :: (input: [] u8,out: [] u8) -> u32 #export_c {return sha256_hash_checked(input,out,bytes_overlap(input,out));}
sha256_tagged :: (tag: string,input: [] u8,out: [] u8) -> u32 #export_c {return sha256_tagged_checked(tag,input,out,bytes_overlap(tag,out)||bytes_overlap(input,out));}
sha256_bip340 :: (tag: int,input: [] u8,out: [] u8) -> u32 #export_c {return sha256_bip340_checked(tag,input,out,bytes_overlap(input,out));}
