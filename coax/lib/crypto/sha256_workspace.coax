// Experimental streaming SHA-256 with explicit state and message schedule in
// caller-owned storage. Scalar/compiler copies remain outside erasure claims.
#load "sha256.coax";
#authority;
#test "owned SHA-256 published and streaming vectors" {
  work:[1]ShaOwned;out:[33]u8;out[32]=165;
  #assert so_init(work[..]);#assert so_finish(work[..],out[..],false);
  expected:=[32]u8.[0xe3,0xb0,0xc4,0x42,0x98,0xfc,0x1c,0x14,0x9a,0xfb,0xf4,0xc8,0x99,0x6f,0xb9,0x24,0x27,0xae,0x41,0xe4,0x64,0x9b,0x93,0x4c,0xa4,0x95,0x99,0x1b,0x78,0x52,0xb8,0x55];
  for i:0..<32 {#assert out[i]==expected[i];}#assert out[32]==165;
  a:=[1]u8.[97];bc:=[2]u8.[98,99];
  #assert so_init(work[..]) && so_update(work[..],a[..],false) && so_update(work[..],bc[..],false) && so_finish(work[..],out[..],false);
  abc:=[32]u8.[0xba,0x78,0x16,0xbf,0x8f,0x01,0xcf,0xea,0x41,0x41,0x40,0xde,0x5d,0xae,0x22,0x23,0xb0,0x03,0x61,0xa3,0x96,0x17,0x7a,0x9c,0xb4,0x10,0xff,0x61,0xf2,0x00,0x15,0xad];
  for i:0..<32 {#assert out[i]==abc[i];}#assert work[0].used==0;
}
#test "owned SHA agrees at block and padding boundaries" {
  input:[129]u8;reference:[32]u8;out:[32]u8;work:[1]ShaOwned;for i:0..<129 {input[i]=cast(u8)i;}
  for n:[10]int.[0,1,55,56,63,64,65,119,120,129] {
    #assert sha256_hash_checked(input[0..<n],reference[..],false)==SHA_OK;
    #assert so_init(work[..]) && so_update(work[..],input[0..<n],false) && so_finish(work[..],out[..],false);
    for i:0..<32 {#assert out[i]==reference[i];}
  }
}
#test "owned SHA admission is before writes and final is one-shot" {
  work:[1]ShaOwned;input:[1]u8;out:[32]u8;for i:0..<32 {out[i]=165;}
  #assert !so_init(work[0..<0]);#assert !so_update(work[..],input[..],false);#assert !so_finish(work[..],out[..],false);
  #assert so_init(work[..]);#assert !so_update(work[..],input[..],true);
  #assert !so_finish(work[..],out[0..<31],false) && !so_finish(work[..],out[..],true);
  for v:out {#assert v==165;}#assert so_finish(work[..],out[..],false);
  #assert work[0].used==0;#assert !so_update(work[..],input[..],false) && !so_finish(work[..],out[..],false);
}
#test "owned SHA public length and corrupted metadata boundaries" {
  work:[1]ShaOwned;input:[1]u8;out:[32]u8;reference:[32]u8;packed:[112]u8;
  #assert so_init(work[..]);#assert so_update(work[..],input[0..<0],true);
  block:[64]u8;#assert so_update(work[..],block[..],false);#assert so_update(work[..],input[0..<0],false);#assert so_finish(work[..],out[..],false);
  #assert so_init(work[..]);
  work[0].used=-1;#assert !so_update(work[..],input[..],false) && !so_finish(work[..],out[..],false);
  work[0].used=64;#assert !so_update(work[..],input[..],false) && !so_finish(work[..],out[..],false);
  work[0].used=0;work[0].total=1;#assert !so_update(work[..],input[..],false) && !so_finish(work[..],out[..],false);
  work[0].used=0;work[0].total=SHA_MAX_TOTAL+1;#assert !so_update(work[..],input[..],false) && !so_finish(work[..],out[..],false);
  #assert so_init(work[..]);work[0].total=SHA_MAX_TOTAL;work[0].used=63;
  legacy:Sha256Work;legacy.phase=SHA_ACTIVE;legacy.h=SHA_IV.words;legacy.total=SHA_MAX_TOTAL;legacy.used=63;
  #assert sha256_pack(legacy,packed[..])==SHA_OK && sha256_final_checked(packed[..],reference[..],false)==SHA_OK;
  #assert !so_update(work[..],input[..],false);#assert so_finish(work[..],out[..],false);
  for i:0..<32 {#assert out[i]==reference[i];}
}
ShaOwned :: struct {h:[8]u32;block:[64]u8;schedule:[64]u32;total:u64;used:int;phase:u32;}
so_compress :: (work:[]ShaOwned) {
  k:=[64] u32.[
    0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
    0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2];
  // Big-endian words read by index, so the block bound is checked on every byte.
  for i:0..<16 {b:=i*4;work[0].schedule[i]=(cast(u32)work[0].block[b]<<24)|(cast(u32)work[0].block[b+1]<<16)|(cast(u32)work[0].block[b+2]<<8)|cast(u32)work[0].block[b+3];}
  for i:16..<64 {
    x:=work[0].schedule[i-15];y:=work[0].schedule[i-2];
    s0:=S_rotr(x,7)^S_rotr(x,18)^(x>>3);s1:=S_rotr(y,17)^S_rotr(y,19)^(y>>10);
    work[0].schedule[i]=S_sum4(work[0].schedule[i-16],s0,work[0].schedule[i-7],s1);
  }
  a:=work[0].h[0];b:=work[0].h[1];c:=work[0].h[2];d:=work[0].h[3];e:=work[0].h[4];f:=work[0].h[5];g:=work[0].h[6];z:=work[0].h[7];
  for i:0..<64 {
    s1:=S_rotr(e,6)^S_rotr(e,11)^S_rotr(e,25);choose:=(e&f)^((e^4294967295)&g);
    t1:=S_sum5(z,s1,choose,k[i],work[0].schedule[i]);s0:=S_rotr(a,2)^S_rotr(a,13)^S_rotr(a,22);majority:=(a&b)^(a&c)^(b&c);
    t2:=S_sum2(s0,majority);
    z=g;g=f;f=e;e=S_sum2(d,t1);d=c;c=b;b=a;a=S_sum2(t1,t2);
  }
  work[0].h[0]=S_sum2(work[0].h[0],a);work[0].h[1]=S_sum2(work[0].h[1],b);work[0].h[2]=S_sum2(work[0].h[2],c);work[0].h[3]=S_sum2(work[0].h[3],d);
  work[0].h[4]=S_sum2(work[0].h[4],e);work[0].h[5]=S_sum2(work[0].h[5],f);work[0].h[6]=S_sum2(work[0].h[6],g);work[0].h[7]=S_sum2(work[0].h[7],z);
}
// Internal ABI: valid stable disjoint views and truthful alias facts required.
so_init :: (work:[]ShaOwned)->bool #export_c {
  if work.count!=1 {return false;}work[0]=ShaOwned.{};
  for i:0..<8 {work[0].h[i]=SHA_IV.words[i];}work[0].phase=SHA_ACTIVE;return true;
}
so_update :: (work:[]ShaOwned,input:[]u8,overlap:bool)->bool #export_c {
  if work.count!=1 || work[0].phase!=SHA_ACTIVE || !sha256_input_ok(input.count) || (input.count>0 && overlap) {return false;}
  if work[0].used<0 || sha256_update_limit(work[0].total,input.count)!=SHA_OK || cast(u64)work[0].used!=work[0].total%64 {return false;}
  // used is below 64 here (checked above, reset at 64); &63 keeps its value
  // and states that bound for the block index.
  for byte:input {work[0].block[work[0].used&63]=byte;work[0].used+=1;
    if work[0].used==64 {so_compress(work);work[0].used=0;}}
  work[0].total+=cast(u64)input.count;return true;
}
// Compresses a full block and clears it for the length block that follows.
so_compress_clear :: (work:[]ShaOwned) {so_compress(work);for i:0..<64 {work[0].block[i]=0;}}
so_finish :: (work:[]ShaOwned,out:[]u8,overlap:bool)->bool #export_c {
  if work.count!=1 || work[0].phase!=SHA_ACTIVE || overlap || !cb_span(out.count,0,32) {return false;}
  if work[0].used<0 || work[0].total>SHA_MAX_TOTAL || cast(u64)work[0].used!=work[0].total%64 {return false;}
  for i:0..<64 {if i>=work[0].used {work[0].block[i]=ifx i==work[0].used then 128 else 0;}}
  if work[0].used>=56 {so_compress_clear(work);}
  bits:=work[0].total*8;for i:0..<8 {work[0].block[56+i]=cast(u8)((bits>>((7-i)*8))&255);}
  so_compress(work);work[0].used=0;work[0].phase=SHA_FINAL;
  return sha256_emit(work[0].h[..],out)==SHA_OK;
}
