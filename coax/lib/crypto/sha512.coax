// SHA-512 (FIPS 180-4) over caller-owned bytes: a streaming hash over a
// 208-byte state you own, and the one-shot calls BIP-39 and BIP-32 use,
// HMAC-SHA512 (RFC 2104) and PBKDF2-HMAC-SHA512 (RFC 8018). The compression
// function, padding and constants are in sha512-kernel.coax (Bitcoin From
// Scratch, chapter 7). Secrets in locals are zeroed before return, on success
// and on refusal; no side-channel assurance is implied.
#load "bytes.coax";
#load "sha512-kernel.coax";
#authority;
// book:begin state
SHA512_OK :: cast(u32) 0;
SHA512_BAD_STATE :: cast(u32) 1;
SHA512_BAD_INPUT :: cast(u32) 2;
SHA512_BAD_OUTPUT :: cast(u32) 3;
SHA512_PHASE :: cast(u32) 4;
SHA512_ALIAS :: cast(u32) 5;
SHA512_LENGTH :: cast(u32) 6;
SHA512_STATE_BYTES :: 208;
// The state counts bytes in a u64, so one stream hashes at most 2^64 - 1
// bytes. Their bit length still fits the 128-bit length field.
SHA512_MAX_TOTAL :: cast(u64) 18446744073709551615;
SHA512_MAX :: 1048576;     // bytes one call takes
SHA512_ACTIVE :: cast(u32) 1;
SHA512_FINAL :: cast(u32) 2;
Sha512Info :: struct { error: u32; phase: u32; total: u64; buffered: u32; }
// The state is: "S512", version 1, the phase (1 active, 2 final), 0, the
// number of buffered bytes (0 to 127), the total byte count (big-endian u64),
// the eight hash words (big-endian) and the 128-byte partial block.
sha512_header :: (state: [] u8) -> Sha512Info {
  bad := Sha512Info.{error = SHA512_BAD_STATE};
  if state.count != SHA512_STATE_BYTES { return bad; }
  if state[0] != 'S' || state[1] != '5' || state[2] != '1' || state[3] != '2' || state[4] != 1 || state[6] != 0 { return bad; }
  phase := cast(u32) state[5]; used := cast(u32) state[7]; total := sha512_get64(state, 8);
  if phase != SHA512_ACTIVE && phase != SHA512_FINAL { return bad; }
  // An active state buffers exactly total mod 128 bytes; a final one none.
  if phase == SHA512_ACTIVE && cast(u64) used != total % 128 { return bad; }
  if phase == SHA512_FINAL && used != 0 { return bad; }
  return Sha512Info.{phase = phase, total = total, buffered = used};
}
// book:end state

// Big-endian 64-bit words at a position the caller has already checked.
sha512_get64 :: (data: [] u8, at: int) -> u64 {
  x: u64 = 0;
  for j: 0..<8 { x = x | (cast(u64) data[at + j] << ((7 - j) * 8)); }
  return x;
}
sha512_put64 :: (out: [] u8, at: int, x: u64) {
  for j: 0..<8 { out[at + j] = cast,trunc(u8) (x >> ((7 - j) * 8)); }
}
sha512_state_size :: () -> int #export_c { return SHA512_STATE_BYTES; }
sha512_input_ok :: (n: int) -> bool { return n >= 0 && n <= SHA512_MAX; }
sha512_request :: (input: int, output: int, overlap: bool) -> u32 {
  if !sha512_input_ok(input) { return SHA512_BAD_INPUT; }
  if !cb_span(output, 0, 64) { return SHA512_BAD_OUTPUT; }
  if overlap { return SHA512_ALIAS; }
  return SHA512_OK;
}
sha512_update_limit :: (total: u64, count: int) -> u32 #export_c {
  if !sha512_input_ok(count) { return SHA512_BAD_INPUT; }
  if cast(u64) count > SHA512_MAX_TOTAL - total { return SHA512_LENGTH; }
  return SHA512_OK;
}
// Compress the state's full partial block into its hash words.
sha512_absorb :: (state: [] u8) {
  h: [8] u64; w: [80] u64;
  for i: 0..<8 { h[i] = sha512_get64(state, 16 + i * 8); }
  S512_compress(h[..], state, 80, w[..]);
  for i: 0..<8 { sha512_put64(state, 16 + i * 8, h[i]); }
  for i: 0..<8 { h[i] = 0; } // mutant: equivalent (erases a dead local; no result reads it)
}
sha512_init :: (state: [] u8) -> u32 #export_c {
  if state.count != SHA512_STATE_BYTES { return SHA512_BAD_STATE; }
  state[0] = 'S'; state[1] = '5'; state[2] = '1'; state[3] = '2';
  state[4] = 1; state[5] = cast(u8) SHA512_ACTIVE; state[6] = 0; state[7] = 0;
  sha512_put64(state, 8, 0);
  iv := S512_IV;
  for i: 0..<8 { sha512_put64(state, 16 + i * 8, iv[i]); }
  for i: 80..<208 { state[i] = 0; }
  return SHA512_OK;
}
sha512_info :: (state: [] u8) -> Sha512Info #export_c { return sha512_header(state); }

// book:begin stream
// Append input to the stream. Every check comes first, so a refusal leaves
// the state unchanged.
sha512_update_checked :: (state: [] u8, input: [] u8, overlap: bool) -> u32 {
  info := sha512_header(state);
  if info.error != SHA512_OK { return info.error; }
  if info.phase != SHA512_ACTIVE { return SHA512_PHASE; }
  status := sha512_update_limit(info.total, input.count);
  if status != SHA512_OK { return status; }
  if input.count > 0 && overlap { return SHA512_ALIAS; }
  used := cast(int) info.buffered;
  for byte: input {
    state[80 + used] = byte; used += 1;
    if used == 128 { sha512_absorb(state); used = 0; }
  }
  state[7] = cast(u8) used;
  sha512_put64(state, 8, info.total + cast(u64) input.count);
  return SHA512_OK;
}
// Pad, compress the last one or two blocks and write the 64-byte digest.
// The final state keeps the hash words and erases the partial block, so a
// second call writes the same digest.
sha512_final_checked :: (state: [] u8, out: [] u8, overlap: bool) -> u32 {
  info := sha512_header(state);
  if info.error != SHA512_OK { return info.error; }
  if !cb_span(out.count, 0, 64) { return SHA512_BAD_OUTPUT; }
  if overlap { return SHA512_ALIAS; }
  h: [8] u64; w: [80] u64;
  for i: 0..<8 { h[i] = sha512_get64(state, 16 + i * 8); }
  if info.phase == SHA512_ACTIVE {
    S512_finish(h[..], state[80..<208], cast(int) info.buffered, info.total, w[..]);
    for i: 0..<8 { sha512_put64(state, 16 + i * 8, h[i]); }
    state[5] = cast(u8) SHA512_FINAL; state[7] = 0;
  }
  for i: 0..<8 { sha512_put64(out, i * 8, h[i]); }
  for i: 0..<8 { h[i] = 0; } // mutant: equivalent (erases a dead local; no result reads it)
  return SHA512_OK;
}
// book:end stream

sha512_hash_checked :: (input: [] u8, out: [] u8, overlap: bool) -> u32 {
  status := sha512_request(input.count, out.count, overlap);
  if status != SHA512_OK { return status; }
  state: [208] u8;
  status = sha512_init(state[..]);
  if status == SHA512_OK { status = sha512_update_checked(state[..], input, false); }
  if status == SHA512_OK { status = sha512_final_checked(state[..], out, false); }
  for i: 0..<208 { state[i] = 0; } // mutant: equivalent (erases a dead local; no result reads it)
  return status;
}

// The digest of two inputs one after the other (HMAC's key pad, then its
// message) into out[0..<64]. It reads every input byte before it writes out,
// so out may be one of the inputs (PBKDF2 hashes U into U).
sha512_two_ok :: (a: int, b: int, out: int) -> bool { return out >= 64 && a >= 0 && b >= 0 && b <= SHA512_MAX - a; }
sha512_two :: (a: [] u8, b: [] u8, out: [] u8) -> bool #export_c {
  if !sha512_two_ok(a.count, b.count, out.count) { return false; }
  h := S512_IV; w: [80] u64;
  block: [128] u8; used := 0;
  total := a.count + b.count;
  for i: 0..<total {
    block[used] = ifx i < a.count then a[i] else b[i - a.count];
    used += 1;
    if used == 128 { S512_compress(h[..], block[..], 0, w[..]); used = 0; }
  }
  S512_finish(h[..], block[..], used, cast(u64) total, w[..]);
  for i: 0..<8 { sha512_put64(out, i * 8, h[i]); }
  for i: 0..<8 { h[i] = 0; } // mutant: equivalent (erases a dead local; no result reads it)
  return true;
}
sha512 :: (input: [] u8, out: [] u8) -> bool #export_c { none: [1] u8; return sha512_two(input, none[0..<0], out); }
// HMAC-SHA512(key, msg) into out[0..<64]. out may be msg.
hmac_sha512_ok :: (key: int, msg: int, out: int) -> bool { return out >= 64 && key >= 0 && key <= SHA512_MAX && msg >= 0 && msg <= SHA512_MAX - 128; }
hmac_sha512 :: (key: [] u8, msg: [] u8, out: [] u8) -> bool #export_c {
  if !hmac_sha512_ok(key.count, msg.count, out.count) { return false; }
  // A key longer than a block is hashed first (RFC 2104).
  k: [128] u8;
  if key.count > 128 { if !sha512(key, k[..]) { return false; } } // mutant: equivalent (hmac_sha512_ok bounds the key, so sha512 never refuses it)
  else { for i: 0..<key.count { k[i] = key[i]; } }
  pad: [128] u8; inner: [64] u8;
  for i: 0..<128 { pad[i] = k[i] ^ 0x36; }
  ok := sha512_two(pad[..], msg, inner[..]);
  for i: 0..<128 { pad[i] = k[i] ^ 0x5c; }
  ok = ok && sha512_two(pad[..], inner[..], out);
  for i: 0..<128 { k[i] = 0; } // mutant: equivalent (erases a dead local; no result reads it)
  for i: 0..<128 { pad[i] = 0; } // mutant: equivalent (erases a dead local; no result reads it)
  for i: 0..<64 { inner[i] = 0; } // mutant: equivalent (erases a dead local; no result reads it)
  return ok;
}
// PBKDF2-HMAC-SHA512 (RFC 8018), one 64-byte block: what BIP-39 asks (dkLen 64).
pbkdf2_hmac_sha512_ok :: (password: int, salt: int, rounds: int, out: int) -> bool {
  return out >= 64 && rounds >= 1 && password >= 0 && password <= SHA512_MAX && salt >= 0 && salt <= 1024;
}
pbkdf2_hmac_sha512 :: (password: [] u8, salt: [] u8, rounds: int, out: [] u8) -> bool #export_c {
  if !pbkdf2_hmac_sha512_ok(password.count, salt.count, rounds, out.count) { return false; }
  s: [1028] u8;
  for i: 0..<salt.count { s[i] = salt[i]; }
  s[salt.count + 3] = 1;   // INT(1), big-endian
  u: [64] u8; t: [64] u8;
  ok := hmac_sha512(password, s[0..<salt.count + 4], u[..]);
  for i: 0..<64 { t[i] = u[i]; }
  r := 1;
  while ok && r < rounds {
    ok = hmac_sha512(password, u[..], u[..]);
    for i: 0..<64 { t[i] ^= u[i]; }
    r += 1;
  }
  for i: 0..<64 { if ok { out[i] = t[i]; } }
  for i: 0..<64 { u[i] = 0; } // mutant: equivalent (erases a dead local; no result reads it)
  for i: 0..<64 { t[i] = 0; } // mutant: equivalent (erases a dead local; no result reads it)
  for i: 0..<1028 { s[i] = 0; } // mutant: equivalent (erases a dead local; no result reads it)
  return ok;
}

// A string's bytes in buf (tests and callers holding text).
sha512_bytes :: (t: string, buf: [] u8) -> [] u8 {
  n := ifx t.count < buf.count then t.count else buf.count; // mutant: equivalent (at equal counts both arms are the same)
  for i: 0..<n { buf[i] = t[i]; }
  return buf[0..<n];
}
sha512_hexeq :: (got: [] u8, want: string) -> bool {
  digits := "0123456789abcdef";
  if want.count != got.count * 2 { return false; }
  for i: 0..<got.count { if digits[cast(int) (got[i] >> 4)] != want[2 * i] || digits[cast(int) (got[i] & 15)] != want[2 * i + 1] { return false; } }
  return true;
}

#test "SHA-512: the FIPS 180-4 examples (empty, abc, the 896-bit message) and a long message" {
  out: [64] u8; b1: [256] u8; b2: [256] u8;
  #assert sha512(sha512_bytes("", b1[..]), out[..]) && sha512_hexeq(out[..], "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e");
  #assert sha512(sha512_bytes("abc", b1[..]), out[..]) && sha512_hexeq(out[..], "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
  #assert sha512(sha512_bytes("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu", b1[..]), out[..]) && sha512_hexeq(out[..], "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909");
  // 111, 112 and 128 bytes: the padding's edges
  a: [1000] u8; for i: 0..<1000 { a[i] = 'a'; }
  #assert sha512(a[0..<111], out[..]) && sha512_hexeq(out[..], "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2");
  #assert sha512(a[0..<112], out[..]) && sha512_hexeq(out[..], "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca");
  #assert sha512(a[0..<128], out[..]) && sha512_hexeq(out[..], "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321");
  #assert sha512(a[..], out[..]) && sha512_hexeq(out[..], "67ba5535a46e3f86dbfbed8cbbaf0125c76ed549ff8b0b9e03e0c88cf90fa634fa7b12b47d77b694de488ace8d9a65967dc96df599727d3292a8d9d447709c97");
  #assert !sha512(a[..], out[0..<63]);
}
#test "HMAC-SHA512: RFC 4231 cases 1, 2, 6 and 7" {
  out: [64] u8; b1: [256] u8; b2: [256] u8;
  k1: [20] u8; for i: 0..<20 { k1[i] = 0x0b; }
  #assert hmac_sha512(k1[..], sha512_bytes("Hi There", b1[..]), out[..]) && sha512_hexeq(out[..], "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854");
  #assert hmac_sha512(sha512_bytes("Jefe", b1[..]), sha512_bytes("what do ya want for nothing?", b2[..]), out[..]) && sha512_hexeq(out[..], "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737");
  k6: [131] u8; for i: 0..<131 { k6[i] = 0xaa; }
  #assert hmac_sha512(k6[..], sha512_bytes("Test Using Larger Than Block-Size Key - Hash Key First", b1[..]), out[..]) && sha512_hexeq(out[..], "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598");
  #assert hmac_sha512(k6[..], sha512_bytes("This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.", b1[..]), out[..]) && sha512_hexeq(out[..], "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58");
}
#test "PBKDF2-HMAC-SHA512: one and two rounds, and refusals" {
  out: [64] u8; b1: [256] u8; b2: [256] u8;
  #assert pbkdf2_hmac_sha512(sha512_bytes("password", b1[..]), sha512_bytes("salt", b2[..]), 1, out[..]) && sha512_hexeq(out[..], "867f70cf1ade02cff3752599a3a53dc4af34c7a669815ae5d513554e1c8cf252c02d470a285a0501bad999bfe943c08f050235d7d68b1da55e63f73b60a57fce");
  #assert pbkdf2_hmac_sha512(sha512_bytes("password", b1[..]), sha512_bytes("salt", b2[..]), 2, out[..]) && sha512_hexeq(out[..], "e1d9c16aa681708a45f5c7c4e215ceb66e011a2e9f0040713f18aefdb866d53cf76cab2868a39b9f7840edce4fef5a82be67335c77a6068e04112754f27ccf4e");
  #assert !pbkdf2_hmac_sha512(sha512_bytes("password", b1[..]), sha512_bytes("salt", b2[..]), 0, out[..]) && !pbkdf2_hmac_sha512(sha512_bytes("p", b1[..]), sha512_bytes("s", b2[..]), 1, out[0..<10]);
}
#test "sha512_two hashes its parts as one input" {
  out: [64] u8; b1: [256] u8; b2: [256] u8;
  #assert sha512_two(sha512_bytes("ab", b1[..]), sha512_bytes("c", b2[..]), out[..]) && sha512_hexeq(out[..], "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
  #assert sha512_hexeq(out[0..<1], "dd") && !sha512_hexeq(out[0..<1], "d");
}
#test "the stream: empty and abc, and a second final writes the same digest" {
  s: [208] u8; out: [72] u8;
  for i: 0..<72 { out[i] = 165; }
  #assert sha512_state_size() == 208 && sha512_init(s[..]) == SHA512_OK;
  #assert sha512_final_checked(s[..], out[..], false) == SHA512_OK;
  #assert sha512_hexeq(out[0..<64], "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e") && out[64] == 165;
  abc := [3] u8.[97, 98, 99];
  #assert sha512_init(s[..]) == SHA512_OK && sha512_update_checked(s[..], abc[..], false) == SHA512_OK;
  #assert sha512_info(s[..]).total == 3 && sha512_info(s[..]).buffered == 3 && sha512_info(s[..]).phase == SHA512_ACTIVE;
  #assert sha512_final_checked(s[..], out[..], false) == SHA512_OK;
  #assert sha512_hexeq(out[0..<64], "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
  // The final state holds no input bytes.
  for i: 80..<208 { #assert s[i] == 0; }
  old := s;
  #assert sha512_final_checked(s[..], out[..], false) == SHA512_OK;
  for i: 0..<208 { #assert s[i] == old[i]; }
  #assert sha512_hexeq(out[0..<64], "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
  #assert sha512_info(s[..]).phase == SHA512_FINAL && sha512_info(s[..]).buffered == 0;
}
#forall "stream chunk partitions agree with the one-shot kernel" which: 0..<14, chunk_index: 0..<3 {
  lengths := [14] int.[0, 1, 111, 112, 113, 127, 128, 129, 239, 240, 255, 256, 257, 300];
  chunks := [3] int.[1, 7, 128]; n := lengths[which]; chunk := chunks[chunk_index];
  input: [300] u8; for i: 0..<300 { input[i] = cast(u8) ((i * 13 + 5) % 256); }
  s: [208] u8; out: [64] u8;
  #assert sha512_init(s[..]) == SHA512_OK;
  at := 0;
  while at < n {
    take := ifx n - at < chunk then n - at else chunk;
    #assert sha512_update_checked(s[..], input[at..<at + take], false) == SHA512_OK;
    at += take;
  }
  #assert sha512_info(s[..]).total == cast(u64) n && sha512_info(s[..]).buffered == cast(u32) (n % 128);
  #assert sha512_final_checked(s[..], out[..], false) == SHA512_OK;
  reference := S512_hash(input[0..<n]);
  for i: 0..<8 { #assert cb_load_be64(out[..], i * 8).value == reference.words[i]; }
}
#test "refusals leave the state and the output unchanged" {
  s: [209] u8; input := [1] u8.[7]; out: [65] u8;
  for i: 0..<209 { s[i] = 165; }
  for i: 0..<65 { out[i] = 165; }
  #assert sha512_info(s[0..<208]).error == SHA512_BAD_STATE;
  #assert sha512_init(s[0..<207]) == SHA512_BAD_STATE && sha512_init(s[..]) == SHA512_BAD_STATE;
  #assert sha512_update_checked(s[0..<208], input[..], false) == SHA512_BAD_STATE;
  #assert sha512_final_checked(s[0..<208], out[..], false) == SHA512_BAD_STATE;
  for i: 0..<209 { #assert s[i] == 165; }
  #assert sha512_init(s[0..<208]) == SHA512_OK; before := s;
  #assert sha512_update_checked(s[0..<208], input[..], true) == SHA512_ALIAS;
  #assert sha512_final_checked(s[0..<208], out[0..<63], false) == SHA512_BAD_OUTPUT;
  #assert sha512_final_checked(s[0..<208], out[..], true) == SHA512_ALIAS;
  #assert sha512_update_checked(s[0..<208], input[0..<0], true) == SHA512_OK;
  for i: 0..<209 { #assert s[i] == before[i]; }
  for i: 0..<65 { #assert out[i] == 165; }
  #assert sha512_final_checked(s[0..<208], out[..], false) == SHA512_OK && out[64] == 165;
  #assert sha512_update_checked(s[0..<208], input[..], false) == SHA512_PHASE;
  #assert sha512_hash_checked(input[..], out[..], true) == SHA512_ALIAS;
  #assert sha512_hash_checked(input[..], out[0..<63], false) == SHA512_BAD_OUTPUT;
}
#forall "every header byte is validated" field: 0..<8 {
  s: [208] u8; input := [1] u8.[1];
  #assert sha512_init(s[..]) == SHA512_OK;
  s[field] ^= 255; before := s;
  #assert sha512_info(s[..]).error == SHA512_BAD_STATE;
  #assert sha512_update_checked(s[..], input[..], false) == SHA512_BAD_STATE;
  for i: 0..<208 { #assert s[i] == before[i]; }
}
#test "the byte counter's limit and a 128-bit length, without a huge input" {
  s: [208] u8; input := [1] u8.[1]; out: [64] u8;
  #assert sha512_init(s[..]) == SHA512_OK;
  #assert cb_store_be64(s[..], 8, SHA512_MAX_TOTAL); s[7] = 127; before := s;
  #assert sha512_update_checked(s[..], input[..], false) == SHA512_LENGTH;
  for i: 0..<208 { #assert s[i] == before[i]; }
  #assert sha512_update_checked(s[..], input[0..<0], false) == SHA512_OK;
  // A state that claims 2^64 - 1 bytes finalizes with the length 2^67 - 8
  // bits: high word 7, low word 0xfffffffffffffff8.
  #assert sha512_init(s[..]) == SHA512_OK;
  #assert cb_store_be64(s[..], 8, SHA512_MAX_TOTAL); s[7] = 127;
  #assert sha512_final_checked(s[..], out[..], false) == SHA512_OK;
  #assert sha512_update_limit(SHA512_MAX_TOTAL - 1, 1) == SHA512_OK && sha512_update_limit(SHA512_MAX_TOTAL - 1, 2) == SHA512_LENGTH;
  #assert sha512_update_limit(0, -1) == SHA512_BAD_INPUT && sha512_update_limit(0, 1048577) == SHA512_BAD_INPUT;
  #assert sha512_request(-1, 64, false) == SHA512_BAD_INPUT && sha512_request(0, 63, false) == SHA512_BAD_OUTPUT;
  #assert sha512_request(0, 64, true) == SHA512_ALIAS && sha512_request(0, 64, false) == SHA512_OK;
}
#test "HMAC and PBKDF2 refuse negative and oversized counts" {
  out: [64] u8; b1: [16] u8;
  k := sha512_bytes("key", b1[..]);
  #assert hmac_sha512(k, k, out[..]) && !hmac_sha512(k, k, out[0..<63]);
  #assert !sha512_two(k, k, out[0..<63]);
  big: [1028] u8;
  #assert !pbkdf2_hmac_sha512(k, big[0..<1025], 1, out[..]) && pbkdf2_hmac_sha512(k, big[0..<1024], 1, out[..]);
}
#test "boundaries of the one-shot calls, on counts" {
  #assert sha512_update_limit(0, 1048576) == SHA512_OK && sha512_input_ok(1048576) && !sha512_input_ok(1048577);
  #assert sha512_two_ok(0, 0, 64) && !sha512_two_ok(0, 0, 63) && !sha512_two_ok(-1, 0, 64) && !sha512_two_ok(0, -1, 64);
  #assert sha512_two_ok(1048576, 0, 64) && !sha512_two_ok(1048577, 0, 64) && sha512_two_ok(1048575, 1, 64) && !sha512_two_ok(1048575, 2, 64);
  #assert sha512_two_ok(0, 1048576, 64) && !sha512_two_ok(0, 1048577, 64) && !sha512_two_ok(1, 1048576, 64);
  #assert hmac_sha512_ok(0, 0, 64) && !hmac_sha512_ok(0, 0, 63) && !hmac_sha512_ok(-1, 0, 64) && !hmac_sha512_ok(0, -1, 64);
  #assert hmac_sha512_ok(1048576, 0, 64) && !hmac_sha512_ok(1048577, 0, 64) && hmac_sha512_ok(0, 1048448, 64) && !hmac_sha512_ok(0, 1048449, 64);
  #assert pbkdf2_hmac_sha512_ok(0, 0, 1, 64) && !pbkdf2_hmac_sha512_ok(0, 0, 0, 64) && !pbkdf2_hmac_sha512_ok(0, 0, 1, 63);
  #assert !pbkdf2_hmac_sha512_ok(-1, 0, 1, 64) && !pbkdf2_hmac_sha512_ok(0, -1, 1, 64) && pbkdf2_hmac_sha512_ok(1048576, 1024, 1, 64);
  #assert !pbkdf2_hmac_sha512_ok(1048577, 0, 1, 64) && !pbkdf2_hmac_sha512_ok(0, 1025, 1, 64);
}
#test "HMAC-SHA512 at the block-size key boundary, and PBKDF2 with three rounds" {
  // Expected values computed outside Coax, with Python's hmac and hashlib.
  out: [64] u8; b1: [16] u8; b2: [16] u8; key: [129] u8;
  for i: 0..<129 { key[i] = cast(u8) i; }
  msg := sha512_bytes("abc", b1[..]);
  #assert hmac_sha512(key[0..<128], msg, out[..]) && sha512_hexeq(out[..], "b63d28cd593ad7e8f0e3168367471441d9668b5fb970a620994e8e1c7b02d0d2b17f55eb1bf5916465ae8bfcafad706e29cbe258ac4a2d4014190ec0b3abe827");
  #assert hmac_sha512(key[..], msg, out[..]) && sha512_hexeq(out[..], "767a0a8da500b0f4b08ac06b7535b29cb7f4449beee8e8094e8cb6e8fa7c51049f9964e868da0504100c0ffb79a8f6542d8ed75b096472bd667ece4522d8cd3f");
  #assert pbkdf2_hmac_sha512(sha512_bytes("password", b1[..]), sha512_bytes("salt", b2[..]), 3, out[..]) && sha512_hexeq(out[..], "b6b07cb2cebf4ad84468391a543824fccffe0e0769dbe6bddf10a65673c4b648e612d44918f9ce9a19a1294cf5140628084ba994c3b21a4ef4741220b811c633");
}
#test "the one-shot stream call, and init over a used state" {
  abc := [3] u8.[97, 98, 99]; out: [64] u8;
  #assert sha512_hash_checked(abc[..], out[..], false) == SHA512_OK;
  #assert sha512_hexeq(out[..], "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
  s: [208] u8; for i: 0..<208 { s[i] = 0xa5; }
  #assert sha512_init(s[..]) == SHA512_OK && sha512_info(s[..]).total == 0;
  for i: 8..<16 { #assert s[i] == 0; }
  for i: 80..<208 { #assert s[i] == 0; }
}
#test "the hex comparison checks every nibble" {
  got := [2] u8.[0xdd, 0x1a];
  #assert sha512_hexeq(got[..], "dd1a");
  #assert !sha512_hexeq(got[..], "cd1a") && !sha512_hexeq(got[..], "dc1a") && !sha512_hexeq(got[..], "dd0a") && !sha512_hexeq(got[..], "dd1b");
}
