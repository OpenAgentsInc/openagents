// SHA-512 (FIPS 180-4), HMAC-SHA512 (RFC 2104) and PBKDF2-HMAC-SHA512 (RFC 8018)
// over caller-owned bytes, for BIP-39 seeds and BIP-32 derivation (docs/web-log-in.md).
// One-shot calls: the inputs here are short (keys, chain codes, a phrase).
// Secrets in locals are zeroed before return; no side-channel assurance is implied.
#authority;
SHA512_K :: [80]u64.[0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc, 0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118, 0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2, 0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694, 0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65, 0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5, 0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4, 0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70, 0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df, 0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b, 0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30, 0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8, 0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8, 0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3, 0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec, 0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b, 0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178, 0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b, 0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c, 0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817];
SHA512_IV :: [8]u64.[0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1, 0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179];
SHA512_MAX :: 1048576;     // bytes one call hashes

sha512_rotr :: (x: u64, n: u64) -> u64 { return rotr(x, n); }
sha512_block :: (h: [] u64, b: [] u8) {
  w: [80] u64;
  for t: 0..<16 {
    x: u64 = 0;
    for j: 0..<8 { x = (x << 8) | cast(u64) b[t * 8 + j]; }
    w[t] = x;
  }
  for t: 16..<80 {
    s0 := sha512_rotr(w[t - 15], 1) ^ sha512_rotr(w[t - 15], 8) ^ (w[t - 15] >> 7);
    s1 := sha512_rotr(w[t - 2], 19) ^ sha512_rotr(w[t - 2], 61) ^ (w[t - 2] >> 6);
    w[t] = add_wrap(add_wrap(w[t - 16], s0), add_wrap(w[t - 7], s1));
  }
  k := SHA512_K;
  a := h[0]; bb := h[1]; c := h[2]; d := h[3]; e := h[4]; f := h[5]; g := h[6]; hh := h[7];
  for t: 0..<80 {
    t1 := add_wrap(add_wrap(add_wrap(hh, sha512_rotr(e, 14) ^ sha512_rotr(e, 18) ^ sha512_rotr(e, 41)), add_wrap((e & f) ^ ((e ^ 0xffffffffffffffff) & g), k[t])), w[t]);
    t2 := add_wrap(sha512_rotr(a, 28) ^ sha512_rotr(a, 34) ^ sha512_rotr(a, 39), (a & bb) ^ (a & c) ^ (bb & c));
    hh = g; g = f; f = e; e = add_wrap(d, t1); d = c; c = bb; bb = a; a = add_wrap(t1, t2);
  }
  h[0] = add_wrap(h[0], a); h[1] = add_wrap(h[1], bb); h[2] = add_wrap(h[2], c); h[3] = add_wrap(h[3], d);
  h[4] = add_wrap(h[4], e); h[5] = add_wrap(h[5], f); h[6] = add_wrap(h[6], g); h[7] = add_wrap(h[7], hh);
  for t: 0..<80 { w[t] = 0; }
}
// The digest of two inputs one after the other (HMAC's key pad, then its message) into out[0..<64].
sha512_two :: (a: [] u8, b: [] u8, out: [] u8) -> bool #export_c {
  if out.count < 64 || a.count < 0 || b.count < 0 || a.count + b.count > SHA512_MAX { return false; }
  h: [8] u64 = SHA512_IV;
  block: [128] u8; used := 0;
  total := a.count + b.count;
  for i: 0..<total {
    block[used] = ifx i < a.count then a[i] else b[i - a.count];
    used += 1;
    if used == 128 { sha512_block(h[..], block[..]); used = 0; }
  }
  block[used] = 0x80; used += 1;
  if used > 112 { for i: used..<128 { block[i] = 0; } sha512_block(h[..], block[..]); used = 0; }
  for i: used..<120 { block[i] = 0; }
  bits := cast(u64) total * 8;
  for i: 0..<8 { block[120 + i] = cast(u8) ((bits >> cast(u64) ((7 - i) * 8)) & 255); }
  sha512_block(h[..], block[..]);
  for i: 0..<8 { for j: 0..<8 { out[i * 8 + j] = cast(u8) ((h[i] >> cast(u64) ((7 - j) * 8)) & 255); } }
  for i: 0..<128 { block[i] = 0; }
  for i: 0..<8 { h[i] = 0; }
  return true;
}
sha512 :: (input: [] u8, out: [] u8) -> bool #export_c { none: [1] u8; return sha512_two(input, none[0..<0], out); }
// HMAC-SHA512(key, msg) into out[0..<64].
hmac_sha512 :: (key: [] u8, msg: [] u8, out: [] u8) -> bool #export_c {
  if out.count < 64 || msg.count > SHA512_MAX - 128 { return false; }
  k: [128] u8;
  if key.count > 128 { if !sha512(key, k[..]) { return false; } }
  else { for i: 0..<key.count { k[i] = key[i]; } }
  pad: [128] u8; inner: [64] u8;
  for i: 0..<128 { pad[i] = k[i] ^ 0x36; }
  ok := sha512_two(pad[..], msg, inner[..]);
  for i: 0..<128 { pad[i] = k[i] ^ 0x5c; }
  ok = ok && sha512_two(pad[..], inner[..], out);
  for i: 0..<128 { k[i] = 0; pad[i] = 0; }
  for i: 0..<64 { inner[i] = 0; }
  return ok;
}
// PBKDF2-HMAC-SHA512 (RFC 8018), one 64-byte block: what BIP-39 asks (dkLen 64).
pbkdf2_hmac_sha512 :: (password: [] u8, salt: [] u8, rounds: int, out: [] u8) -> bool #export_c {
  if out.count < 64 || rounds < 1 || salt.count > 1024 { return false; }
  s: [1028] u8;
  for i: 0..<salt.count { s[i] = salt[i]; }
  s[salt.count + 3] = 1;   // INT(1), big-endian
  u: [64] u8; t: [64] u8;
  if !hmac_sha512(password, s[0..<salt.count + 4], u[..]) { return false; }
  for i: 0..<64 { t[i] = u[i]; }
  for r: 1..<rounds {
    if !hmac_sha512(password, u[..], u[..]) { return false; }
    for i: 0..<64 { t[i] ^= u[i]; }
  }
  for i: 0..<64 { out[i] = t[i]; u[i] = 0; t[i] = 0; }
  return true;
}

// A string's bytes in buf (tests and callers holding text).
sha512_bytes :: (t: string, buf: [] u8) -> [] u8 {
  n := ifx t.count < buf.count then t.count else buf.count;
  for i: 0..<n { buf[i] = t[i]; }
  return buf[0..<n];
}
sha512_hexeq :: (got: [] u8, want: string) -> bool {
  digits := "0123456789abcdef";
  if want.count != got.count * 2 { return false; }
  for i: 0..<got.count { if digits[cast(int) (got[i] >> 4)] != want[2 * i] || digits[cast(int) (got[i] & 15)] != want[2 * i + 1] { return false; } }
  return true;
}

#test "SHA-512: the FIPS 180-4 examples (empty, abc, the 896-bit message) and a long message" {
  out: [64] u8; b1: [256] u8; b2: [256] u8;
  #assert sha512(sha512_bytes("", b1[..]), out[..]) && sha512_hexeq(out[..], "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e");
  #assert sha512(sha512_bytes("abc", b1[..]), out[..]) && sha512_hexeq(out[..], "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
  #assert sha512(sha512_bytes("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu", b1[..]), out[..]) && sha512_hexeq(out[..], "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909");
  // 111, 112 and 128 bytes: the padding's edges
  a: [1000] u8; for i: 0..<1000 { a[i] = 'a'; }
  #assert sha512(a[0..<111], out[..]) && sha512_hexeq(out[..], "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2");
  #assert sha512(a[0..<112], out[..]) && sha512_hexeq(out[..], "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca");
  #assert sha512(a[0..<128], out[..]) && sha512_hexeq(out[..], "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321");
  #assert sha512(a[..], out[..]) && sha512_hexeq(out[..], "67ba5535a46e3f86dbfbed8cbbaf0125c76ed549ff8b0b9e03e0c88cf90fa634fa7b12b47d77b694de488ace8d9a65967dc96df599727d3292a8d9d447709c97");
  #assert !sha512(a[..], out[0..<63]);
}
#test "HMAC-SHA512: RFC 4231 cases 1, 2, 6 and 7" {
  out: [64] u8; b1: [256] u8; b2: [256] u8;
  k1: [20] u8; for i: 0..<20 { k1[i] = 0x0b; }
  #assert hmac_sha512(k1[..], sha512_bytes("Hi There", b1[..]), out[..]) && sha512_hexeq(out[..], "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854");
  #assert hmac_sha512(sha512_bytes("Jefe", b1[..]), sha512_bytes("what do ya want for nothing?", b2[..]), out[..]) && sha512_hexeq(out[..], "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737");
  k6: [131] u8; for i: 0..<131 { k6[i] = 0xaa; }
  #assert hmac_sha512(k6[..], sha512_bytes("Test Using Larger Than Block-Size Key - Hash Key First", b1[..]), out[..]) && sha512_hexeq(out[..], "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598");
  #assert hmac_sha512(k6[..], sha512_bytes("This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.", b1[..]), out[..]) && sha512_hexeq(out[..], "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58");
}
#test "PBKDF2-HMAC-SHA512: one and two rounds, and refusals" {
  out: [64] u8; b1: [256] u8; b2: [256] u8;
  #assert pbkdf2_hmac_sha512(sha512_bytes("password", b1[..]), sha512_bytes("salt", b2[..]), 1, out[..]) && sha512_hexeq(out[..], "867f70cf1ade02cff3752599a3a53dc4af34c7a669815ae5d513554e1c8cf252c02d470a285a0501bad999bfe943c08f050235d7d68b1da55e63f73b60a57fce");
  #assert pbkdf2_hmac_sha512(sha512_bytes("password", b1[..]), sha512_bytes("salt", b2[..]), 2, out[..]) && sha512_hexeq(out[..], "e1d9c16aa681708a45f5c7c4e215ceb66e011a2e9f0040713f18aefdb866d53cf76cab2868a39b9f7840edce4fef5a82be67335c77a6068e04112754f27ccf4e");
  #assert !pbkdf2_hmac_sha512(sha512_bytes("password", b1[..]), sha512_bytes("salt", b2[..]), 0, out[..]) && !pbkdf2_hmac_sha512(sha512_bytes("p", b1[..]), sha512_bytes("s", b2[..]), 1, out[0..<10]);
}
#test "sha512_two hashes its parts as one input" {
  out: [64] u8; b1: [256] u8; b2: [256] u8;
  #assert sha512_two(sha512_bytes("ab", b1[..]), sha512_bytes("c", b2[..]), out[..]) && sha512_hexeq(out[..], "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
  #assert sha512_hexeq(out[0..<1], "dd") && !sha512_hexeq(out[0..<1], "d");
}
