// The gateways' one shape (docs/coder/microcoder.md, row 1): a request
// every provider is translated from, the events every provider's stream is
// read into, and a Gateway that names where a request goes and which wire
// it speaks. Cut from the old crates/inference Open Responses types to what
// Microcoder and /chat use.
//
//   GwRequest  { model, system, messages[], schema, effort, max_tokens, stream }
//   GwEvent    = text_delta | reasoning_delta | done(usage) | refused(status, reason)
//   GwUsage    { input_tokens, output_tokens, cached_tokens, reasoning_tokens, cost_msats }
//   Gateway    { name, url, key_env, key_header, scheme, wire }
//
// A Gateway's translate and parse are chosen by its wire (gw_translate,
// gw_parse, gw_parse_whole): Open Responses and the Gemini stream's parser
// live here, Chat Completions in chat.coax, the Gemini request in
// gemini.coax, Anthropic's Messages in anthropic.coax.
// GwCall runs one request through the streaming curl transport
// (transport.coax) and the SSE reader (sse.coax) and hands back GwEvents as
// they arrive, without blocking, for a frame loop or a plan to poll.
//
// The key never passes through here: the transport has curl read it from
// the environment. Nothing in a GwEvent is the key or the prompt.

#load "transport.coax";
#load "../agent/claude/fields.coax";

GW_WIRE_RESPONSES :: 1;          // Open Responses: POST /v1/responses (Vercel AI Gateway, OpenRouter, psionic)
GW_WIRE_CHAT :: 2;               // Chat Completions (chat.coax)
GW_WIRE_GEMINI :: 3;             // Gemini native streamGenerateContent?alt=sse (the Gemini API, Vertex)
GW_WIRE_ANTHROPIC :: 4;          // Anthropic Messages

GW_EV_TEXT :: 1;                 // text: a piece of the answer
GW_EV_REASONING :: 2;            // text: a piece of the model's reasoning, never the answer
GW_EV_DONE :: 3;                 // usage; reason "stop" or "length"
GW_EV_REFUSED :: 4;              // status (HTTP; 0 inside a 200 stream or with no response) and reason

GwUsage :: struct {
  ok: bool;                      // the provider reported usage
  input_tokens: int;
  output_tokens: int;            // reasoning included, as providers bill it
  cached_tokens: int;
  reasoning_tokens: int;
  cache_write_tokens: int;       // input written to the cache (Anthropic), counted in input_tokens
  card_usd_micros: int = -1;     // the rates card's price for it (rates.coax gw_price), -1 until priced or when the card has no row
  cost_msats: int;               // the card's price in millisatoshis, when a bitcoin price is given; 0 otherwise
  cost_usd_micros: int = -1;     // what the provider itself says it charged (OpenRouter's usage.cost), -1 when it says nothing
}

GwEvent :: struct {
  kind: int;
  text: string;                  // a delta's text; on done, the upstream provider that served it when the gateway names one
  usage: GwUsage;
  status: int;
  reason: string;
}

GwMessage :: struct {
  role: string;                  // "user" or "assistant"
  text: string;
}

GwRequest :: struct {
  model: string;
  system: string;                // "" for none
  messages: [] GwMessage;
  schema: string;                // a JSON Schema object for strict structured output, "" for plain text
  schema_name: string = "reply";
  effort: string;                // "low" | "medium" | "high", "" to leave it to the provider
  max_tokens: int;               // 0 to leave it to the provider
  stream: bool = true;
}

Gateway :: struct {
  name: string;                  // "vertex", "gemini", "openrouter" ...
  url: string;                   // the full endpoint
  key_env: string;               // the variable curl reads the key from; "" for a keyless door
  key_value: string;             // a key minted at run time (Vertex's hourly token): set in curl's environment only
  key_header: string = "Authorization";
  scheme: string = "Bearer";     // "" sends the key alone in key_header
  wire: int;
  flags: int;                    // the wire's dialect: GW_CHAT_* for Chat Completions
}

// What a stream's parser carries between events (Chat Completions says how
// it finished in one chunk and its usage in a later one, then [DONE]).
GW_FIN_NONE :: 0;
GW_FIN_STOP :: 1;
GW_FIN_LENGTH :: 2;
GW_FIN_TOOLS :: 3;
GW_FIN_FILTER :: 4;
GW_FIN_UNKNOWN :: 5;             // a finish this parser doesn't know

GwParse :: struct {
  finish: int;
  usage: GwUsage;
  provider: [48] u8; np: int;    // OpenRouter's provider field, copied from the first chunk that has one
  // Anthropic: usage comes in message_start and message_delta, apart
  in_raw: int; in_ok: bool;      // input_tokens, without the cache
  cache_read: int; cache_write: int;
  out: int; out_ok: bool;        // (stop_reason goes in finish)
}

// A provider-reported cost in dollars as millionths, or -1 when absent.
gw_cost_micros :: (obj: string, path: string) -> int {
  c := cl_num(obj, path);
  if !c.ok || c.value < 0.0 { return -1; }
  return cast(int) (c.value * 1000000.0 + 0.5);
}

gw_client :: (g: Gateway) -> GwClient {
  return GwClient.{url = g.url, key_env = g.key_env, key_value = g.key_value, key_header = g.key_header, scheme = g.scheme};
}

// An environment variable's value, copied into out ("" when unset or too long).
gw_env :: (name: string, out: [] u8) -> string {
  for ch: name { k := cxproc_getenv_push(cast(int) ch); }
  n := cxproc_getenv();
  if n <= 0 || n > out.count { return ""; }
  for i: 0..<n { out[i] = cast(u8) cxproc_getenv_byte(i); }
  return cast(string) out[0..<n];
}

// Runs args (args[0] found on PATH) and returns the first line it prints,
// copied into out, or "" when it fails, prints nothing or outlives
// timeout_ms. Its stderr is dropped: a credential helper's message never
// reaches a log through here.
gw_run_line :: (args: [] string, out: [] u8, timeout_ms: int) -> string {
  h := cxproc_new();
  if h < 0 { return ""; }
  ok := true;
  for a: args { ok = ok && gw_arg(h, a); }
  if !ok || cxproc_spawn(h) != 0 { x := cxproc_release(h); return ""; }
  x := cxproc_close_stdin(h);
  n := cxproc_read_line(h, timeout_ms);
  k := 0;
  if n > 0 && n <= out.count { for i: 0..<n { out[i] = cast(u8) cxproc_line_byte(h, i); } k = n; }
  status := cxproc_wait(h, 2000);
  y := cxproc_release(h);
  if status != 0 { return ""; }
  return cast(string) out[0..<k];
}

// ---------------------------------------------------------------- translate

// The request body for g's wire, written into out; "" with why[0] set when
// it can't be written (out too small, a schema that isn't JSON, a wire whose
// translator hasn't landed).
gw_translate :: (g: Gateway, req: GwRequest, out: [] u8, why: [] string) -> string {
  if req.model.count == 0 { why[0] = "no model"; return ""; }
  if req.schema.count > 0 && !json_valid(req.schema) { why[0] = "the schema is not JSON"; return ""; }
  n := -1;
  if g.wire == GW_WIRE_RESPONSES { n = gw_responses_body(req, out); }
  else if g.wire == GW_WIRE_CHAT { n = gw_chat_body(req, g.flags, out); }
  else if g.wire == GW_WIRE_GEMINI { n = gw_gemini_body(req, g.flags, out); }
  else if g.wire == GW_WIRE_ANTHROPIC { n = gw_anthropic_body(req, out); }
  else { why[0] = "this gateway's wire has no translator yet"; return ""; }
  if n < 0 { why[0] = "the request does not fit its buffer"; return ""; }
  return cast(string) out[0..<n];
}

// Open Responses: instructions, input messages, max_output_tokens,
// reasoning.effort, and text.format json_schema (strict) for a schema.
gw_responses_body :: (req: GwRequest, out: [] u8) -> int {
  n := json_raw(out, 0, "{\"model\":");
  n = json_write_string(out, n, req.model);
  n = json_raw(out, n, ifx req.stream then ",\"stream\":true,\"store\":false" else ",\"stream\":false,\"store\":false");
  if req.system.count > 0 { n = json_raw(out, n, ",\"instructions\":"); n = json_write_string(out, n, req.system); }
  n = json_raw(out, n, ",\"input\":[");
  for m, i: req.messages {
    if i > 0 { n = json_raw(out, n, ","); }
    n = json_raw(out, n, "{\"role\":");
    n = json_write_string(out, n, ifx m.role == "assistant" then "assistant" else "user");
    n = json_raw(out, n, ",\"content\":");
    n = json_write_string(out, n, m.text);
    n = json_raw(out, n, "}");
  }
  n = json_raw(out, n, "]");
  if req.max_tokens > 0 { n = json_raw(out, n, ",\"max_output_tokens\":"); n = json_write_int(out, n, req.max_tokens); }
  if req.effort.count > 0 { n = json_raw(out, n, ",\"reasoning\":{\"effort\":"); n = json_write_string(out, n, req.effort); n = json_raw(out, n, "}"); }
  if req.schema.count > 0 {
    n = json_raw(out, n, ",\"text\":{\"format\":{\"type\":\"json_schema\",\"name\":");
    n = json_write_string(out, n, req.schema_name);
    n = json_raw(out, n, ",\"strict\":true,\"schema\":");
    n = json_raw(out, n, req.schema);
    n = json_raw(out, n, "}}");
  }
  return json_raw(out, n, "}");
}

// ---------------------------------------------------------------- parse

gw_blank :: (s: string) -> bool {
  for c: s { if c != ' ' && c != '\t' && c != '\r' { return false; } }
  return true;
}

gw_put :: (out: [] GwEvent, n: int, e: GwEvent) -> int {
  if n >= out.count { return n; }
  out[n] = e;
  return n + 1;
}

// One dispatched SSE event (its name and data) as GwEvents into out; how
// many. Strings borrow data and ar. ps carries what the wire needs between
// events (start each stream with a cleared one).
gw_parse :: (wire: int, ps: [] GwParse, ar: [] ClArena, name: string, data: string, out: [] GwEvent) -> int {
  if wire == GW_WIRE_RESPONSES { return gw_parse_responses(ar, name, data, out); }
  if wire == GW_WIRE_GEMINI { return gw_parse_gemini(ar, data, out); }
  if wire == GW_WIRE_CHAT { return gw_chat_chunk(ps, ar, data, out); }
  if wire == GW_WIRE_ANTHROPIC { return gw_anthropic_chunk(ps, ar, data, out); }
  return 0;
}

// The stream ended without its wire's own last word: what it adds (a Chat
// Completions stream that said how it finished but sent no [DONE] is done).
gw_parse_end :: (wire: int, ps: [] GwParse, out: [] GwEvent) -> int {
  if wire == GW_WIRE_CHAT { return gw_chat_end(ps, out); }
  return 0;
}

// A whole (unstreamed) response body as GwEvents: its text, its reasoning,
// then done or refused.
gw_parse_whole :: (wire: int, ar: [] ClArena, body: string, out: [] GwEvent) -> int {
  if !json_valid(body) { return gw_put(out, 0, GwEvent.{kind = GW_EV_REFUSED, status = 200, reason = "the response is not JSON"}); }
  if wire == GW_WIRE_CHAT { return gw_chat_whole(ar, body, out); }
  if wire == GW_WIRE_GEMINI { return gw_parse_gemini(ar, body, out); }
  if wire == GW_WIRE_RESPONSES { return gw_responses_whole(ar, body, out); }
  if wire == GW_WIRE_ANTHROPIC { return gw_anthropic_whole(ar, body, out); }
  return 0;
}

// Open Responses. The type is the data's "type" (OpenRouter sends no event
// lines), else the event name. OpenAI's reasoning_text and the reasoning
// summary read as reasoning.
gw_parse_responses :: (ar: [] ClArena, name: string, data: string, out: [] GwEvent) -> int {
  ty := cl_str(ar, data, "type");
  if ty.count == 0 { ty = name; }
  if ty == "response.output_text.delta" {
    d := cl_str(ar, data, "delta");
    if d.count == 0 { return 0; }
    return gw_put(out, 0, GwEvent.{kind = GW_EV_TEXT, text = d});
  }
  if ty == "response.reasoning.delta" || ty == "response.reasoning_text.delta" || ty == "response.reasoning_summary_text.delta" {
    d := cl_str(ar, data, "delta");
    if d.count == 0 { return 0; }
    return gw_put(out, 0, GwEvent.{kind = GW_EV_REASONING, text = d});
  }
  if ty == "response.completed" {
    return gw_put(out, 0, GwEvent.{kind = GW_EV_DONE, usage = gw_responses_usage(data), reason = "stop"});
  }
  if ty == "response.incomplete" {
    why := cl_str(ar, data, "response.incomplete_details.reason");
    if why == "max_output_tokens" || why.count == 0 { why = "length"; }
    return gw_put(out, 0, GwEvent.{kind = GW_EV_DONE, usage = gw_responses_usage(data), reason = why});
  }
  if ty == "response.failed" {
    why := cl_str(ar, data, "response.error.message");
    if why.count == 0 { why = cl_str(ar, data, "response.error.code"); }
    if why.count == 0 { why = "the response failed"; }
    return gw_put(out, 0, GwEvent.{kind = GW_EV_REFUSED, reason = why});
  }
  if ty == "error" {
    why := cl_str(ar, data, "error.message");
    if why.count == 0 { why = cl_str(ar, data, "message"); }
    if why.count == 0 { why = cl_str(ar, data, "code"); }
    if why.count == 0 { why = "the stream reported an error"; }
    return gw_put(out, 0, GwEvent.{kind = GW_EV_REFUSED, reason = why});
  }
  if ty == "response.refusal.done" {
    why := cl_str(ar, data, "refusal");
    if why.count == 0 { why = "the model refused"; }
    return gw_put(out, 0, GwEvent.{kind = GW_EV_REFUSED, reason = why});
  }
  return 0;
}

gw_responses_usage :: (data: string) -> GwUsage { return gw_responses_usage_of(cl_raw(data, "response.usage")); }

gw_responses_usage_of :: (usage: string) -> GwUsage {
  u: GwUsage;
  if usage.count == 0 { return u; }
  i := cl_int(usage, "input_tokens");
  o := cl_int(usage, "output_tokens");
  if !i.ok || !o.ok { return u; }
  u = GwUsage.{ok = true, input_tokens = i.value, output_tokens = o.value, cost_usd_micros = gw_cost_micros(usage, "cost")};
  c := cl_int(usage, "input_tokens_details.cached_tokens");
  if c.ok { u.cached_tokens = c.value; }
  r := cl_int(usage, "output_tokens_details.reasoning_tokens");
  if r.ok { u.reasoning_tokens = r.value; }
  return u;
}

// A whole Open Responses response object: its message text and reasoning
// text in order, then done (incomplete: cut for length) or refused (failed).
gw_responses_whole :: (ar: [] ClArena, body: string, out: [] GwEvent) -> int {
  n := 0;
  status := cl_str(ar, body, "status");
  if status == "failed" {
    why := cl_str(ar, body, "error.message");
    if why.count == 0 { why = "the response failed"; }
    return gw_put(out, 0, GwEvent.{kind = GW_EV_REFUSED, status = 200, reason = why});
  }
  items := cl_raw(body, "output");
  for i: 0..<cl_count(items) {
    item := cl_json(items, cl_item(items, i));
    ty := cl_str(ar, item, "type");
    parts := cl_raw(item, "content");
    for k: 0..<cl_count(parts) {
      part := cl_json(parts, cl_item(parts, k));
      pt := cl_str(ar, part, "type");
      t := cl_str(ar, part, "text");
      if t.count == 0 { continue; }
      if ty == "message" && pt == "output_text" { n = gw_put(out, n, GwEvent.{kind = GW_EV_TEXT, text = t}); }
      else if ty == "message" && pt == "refusal" { return gw_put(out, n, GwEvent.{kind = GW_EV_REFUSED, status = 200, reason = cl_str(ar, part, "refusal")}); }
      else if ty == "reasoning" { n = gw_put(out, n, GwEvent.{kind = GW_EV_REASONING, text = t}); }
    }
  }
  return gw_put(out, n, GwEvent.{kind = GW_EV_DONE, usage = gw_responses_usage_of(cl_raw(body, "usage")), reason = ifx status == "incomplete" then "length" else "stop"});
}

// Gemini's native stream (the Gemini API and Vertex): each chunk's parts
// are text, or reasoning when marked thought; finishReason STOP or
// MAX_TOKENS ends it, any other (SAFETY, RECITATION ...) refuses; a chunk
// with an error, or a blocked prompt, refuses.
gw_parse_gemini :: (ar: [] ClArena, data: string, out: [] GwEvent) -> int {
  n := 0;
  err := cl_at(data, "error");
  if err.ok && !cl_is_null(data, err) {
    why := cl_str(ar, data, "error.message");
    if why.count == 0 { why = "the stream reported an error"; }
    code := cl_int(data, "error.code");
    return gw_put(out, 0, GwEvent.{kind = GW_EV_REFUSED, status = ifx code.ok then code.value else 0, reason = why});
  }
  parts := cl_raw(data, "candidates.0.content.parts");
  for i: 0..<cl_count(parts) {
    p := cl_json(parts, cl_item(parts, i));
    t := cl_str(ar, p, "text");
    if t.count == 0 { continue; }
    th := cl_bool(p, "thought");
    n = gw_put(out, n, GwEvent.{kind = ifx th.ok && th.value then GW_EV_REASONING else GW_EV_TEXT, text = t});
  }
  fin := cl_str(ar, data, "candidates.0.finishReason");
  if fin.count == 0 {
    block := cl_str(ar, data, "promptFeedback.blockReason");
    if block.count > 0 { n = gw_put(out, n, GwEvent.{kind = GW_EV_REFUSED, reason = block}); }
    return n;
  }
  if fin == "STOP" || fin == "MAX_TOKENS" {
    return gw_put(out, n, GwEvent.{kind = GW_EV_DONE, usage = gw_gemini_usage(data), reason = ifx fin == "STOP" then "stop" else "length"});
  }
  return gw_put(out, n, GwEvent.{kind = GW_EV_REFUSED, reason = fin});
}

gw_gemini_usage :: (data: string) -> GwUsage {
  u: GwUsage;
  i := cl_int(data, "usageMetadata.promptTokenCount");
  o := cl_int(data, "usageMetadata.candidatesTokenCount");
  if !i.ok { return u; }
  u = GwUsage.{ok = true, input_tokens = i.value, output_tokens = ifx o.ok then o.value else 0, cost_usd_micros = -1};
  t := cl_int(data, "usageMetadata.thoughtsTokenCount");
  if t.ok { u.reasoning_tokens = t.value; u.output_tokens += t.value; }
  c := cl_int(data, "usageMetadata.cachedContentTokenCount");
  if c.ok { u.cached_tokens = c.value; }
  return u;
}

// A non-200 response as a refusal: the provider's message when its body has
// one (OpenAI's and Gemini's {"error": {"message"}}, Gemini's [{"error":
// ...}], Baseten's {"error": "..."}, {"message": "..."}), else "" (status
// says enough).
gw_refusal :: (ar: [] ClArena, status: int, body: string) -> GwEvent {
  why := "";
  if json_valid(body) {
    why = cl_str(ar, body, "error.message");
    if why.count == 0 { why = cl_str(ar, body, "0.error.message"); }
    if why.count == 0 { why = cl_str(ar, body, "error"); }
    if why.count == 0 { why = cl_str(ar, body, "message"); }
  }
  return GwEvent.{kind = GW_EV_REFUSED, status = status, reason = why};
}

// ---------------------------------------------------------------- one call

// One request in flight. gw_call_poll hands back what has arrived as
// GwEvents; the stream always ends in exactly one done or refused (a
// transport failure, a non-200 status or a stream cut short reads as
// refused). first says whether any text or reasoning came before that: a
// plan may fall back to another gateway only while it is false.
GwCall :: struct {
  wire: int;
  st: [1] GwStream;
  sse: [1] GwSse;
  ar: [1] ClArena;
  line: [] u8;
  errbody: [] u8; nerr: int;
  first: bool;                   // a delta has been handed back
  finished: bool;                // done or refused has been handed back
  started_ms: int;
  ps: [1] GwParse;
  seen: bool;                    // a body line that isn't blank has come
  whole: bool;                   // the body is one JSON document, not an event stream
  wbuf: [] u8; nw: int;          // that document (the SSE data buffer, unused then)
  wfull: bool;
}

GwCallBuffers :: struct {
  line: [65536] u8;
  name: [128] u8;
  data: [262144] u8;
  arena: [262144] u8;
  errbody: [8192] u8;
}

gw_call_init :: (call: [] GwCall, b: [] GwCallBuffers) {
  call[0] = GwCall.{line = b[0].line[..], errbody = b[0].errbody[..], wbuf = b[0].data[..]};
  call[0].ar[0] = ClArena.{buf = b[0].arena[..]};
  gw_sse_init(call[0].sse[..], b[0].name[..], b[0].data[..]);
}

// Sends body to g. What went wrong before anything was sent, or "".
gw_call_start :: (call: [] GwCall, g: Gateway, body: string, headers: [] string) -> string {
  call[0].wire = g.wire; call[0].nerr = 0; call[0].first = false; call[0].finished = false;
  call[0].ps[0] = GwParse.{}; call[0].whole = false; call[0].seen = false; call[0].nw = 0; call[0].wfull = false;
  gw_sse_clear(call[0].sse[..]);
  call[0].started_ms = cxproc_now_ms();
  why := gw_start(gw_client(g), body, headers, call[0].st[..]);
  if why.count > 0 { call[0].finished = true; }
  return why;
}

// The events that have arrived, into out (at most out.count; give it 8 or
// more): 0 when nothing new has. Strings stay valid until the next poll.
gw_call_poll :: (call: [] GwCall, out: [] GwEvent) -> int {
  if call[0].finished { return 0; }
  call[0].ar[0].at = 0; call[0].ar[0].full = false;
  st := call[0].st[..];
  for guard: 0..<400 {
    r := gw_poll(st, call[0].line);
    if r.kind == GW_IDLE { return 0; }
    if r.kind == GW_END { return gw_call_end(call, out); }
    if st[0].status != 200 {
      if call[0].nerr > 0 && call[0].nerr < call[0].errbody.count { call[0].errbody[call[0].nerr] = '\n'; call[0].nerr += 1; }
      for c: r.text { if call[0].nerr < call[0].errbody.count { call[0].errbody[call[0].nerr] = c; call[0].nerr += 1; } }
      continue;
    }
    // A body that opens with a JSON document is a whole response (stream:
    // false, or a provider that answers so): collect it, parse it at the end.
    if !call[0].seen && !gw_blank(r.text) {
      call[0].seen = true;
      call[0].whole = r.text[0] == '{' || r.text[0] == '[';
    }
    if call[0].whole {
      if call[0].nw > 0 && call[0].nw < call[0].wbuf.count { call[0].wbuf[call[0].nw] = '\n'; call[0].nw += 1; }
      for c: r.text { if call[0].nw < call[0].wbuf.count { call[0].wbuf[call[0].nw] = c; call[0].nw += 1; } else { call[0].wfull = true; } }
      continue;
    }
    ev := gw_sse_line(call[0].sse[..], r.text);
    if !ev.ready { continue; }
    if ev.truncated {
      call[0].finished = true; gw_close(st);
      return gw_put(out, 0, GwEvent.{kind = GW_EV_REFUSED, status = 200, reason = "a stream event did not fit its buffer"});
    }
    n := gw_parse(call[0].wire, call[0].ps[..], call[0].ar[..], ev.name, ev.data, out);
    if n == 0 { continue; }
    for i: 0..<n {
      k := out[i].kind;
      if k == GW_EV_TEXT || k == GW_EV_REASONING { call[0].first = true; }
      if k == GW_EV_DONE || k == GW_EV_REFUSED {
        call[0].finished = true; gw_close(st);
        if k == GW_EV_REFUSED && out[i].status == 0 { out[i].status = 200; }
        return i + 1;
      }
    }
    return n;
  }
  return 0;
}

gw_call_end :: (call: [] GwCall, out: [] GwEvent) -> int {
  st := call[0].st[..];
  call[0].finished = true;
  e: GwEvent;
  if st[0].status == 200 && call[0].whole {
    gw_close(st);
    if call[0].wfull { return gw_put(out, 0, GwEvent.{kind = GW_EV_REFUSED, status = 200, reason = "the response does not fit its buffer"}); }
    n := gw_parse_whole(call[0].wire, call[0].ar[..], cast(string) call[0].wbuf[0..<call[0].nw], out);
    for i: 0..<n { if out[i].kind == GW_EV_TEXT || out[i].kind == GW_EV_REASONING { call[0].first = true; } }
    return n;
  }
  if st[0].status == 200 && st[0].exit == 0 {
    n := gw_parse_end(call[0].wire, call[0].ps[..], out);
    if n > 0 { gw_close(st); return n; }
  }
  if st[0].status == 0 {
    e = GwEvent.{kind = GW_EV_REFUSED, reason = ifx gw_unreachable(st) then "the server is unreachable" else ifx st[0].exit == 28 then "the request timed out" else "the request failed before any response"};
  } else if st[0].status != 200 {
    e = gw_refusal(call[0].ar[..], st[0].status, cast(string) call[0].errbody[0..<call[0].nerr]);
  } else {
    e = GwEvent.{kind = GW_EV_REFUSED, status = 200, reason = ifx st[0].exit == 28 then "the request timed out mid-stream" else "the stream ended before the response finished"};
  }
  gw_close(st);
  return gw_put(out, 0, e);
}

// Stops the call (curl goes, closing the connection). Hands back nothing more.
gw_call_close :: (call: [] GwCall) { gw_close(call[0].st[..]); call[0].finished = true; }

// ---------------------------------------------------------------- checks

#load "chat.coax";
#load "gemini.coax";
#load "anthropic.coax";
#load "fixtures.coax";

GwReplay :: struct {
  text: [4096] u8; nt: int;
  reasoning: [8192] u8; nr: int;
  deltas: int; thoughts: int;
  done: int; refused: int;
  done_at_end: bool;             // done was the last event
  usage: GwUsage;
  reason: string;
  provider: [48] u8; npr: int;
}

// Recorded lines through the SSE reader and the wire's parser, as a call would.
gw_replay :: (wire: int, lines: [] string, r: [] GwReplay) {
  s: [1] GwSse; name: [128] u8; data: [65536] u8;
  arena: [65536] u8; ar: [1] ClArena;
  ar[0] = ClArena.{buf = arena[..]};
  gw_sse_init(s[..], name[..], data[..]);
  ev: [8] GwEvent; ps: [1] GwParse;
  for l: lines {
    e := gw_sse_line(s[..], l);
    if !e.ready { continue; }
    #assert !e.truncated;
    ar[0].at = 0;
    n := gw_parse(wire, ps[..], ar[..], e.name, e.data, ev[..]);
    gw_replay_take(r, ev[..], n);
  }
  n := gw_parse_end(wire, ps[..], ev[..]);
  gw_replay_take(r, ev[..], n);
}

gw_replay_take :: (r: [] GwReplay, ev: [] GwEvent, n: int) {
    for i: 0..<n {
      x := ev[i];
      r[0].done_at_end = false;
      if x.kind == GW_EV_TEXT { r[0].deltas += 1; for c: x.text { r[0].text[r[0].nt] = c; r[0].nt += 1; } }
      if x.kind == GW_EV_REASONING { r[0].thoughts += 1; for c: x.text { r[0].reasoning[r[0].nr] = c; r[0].nr += 1; } }
      if x.kind == GW_EV_DONE {
        r[0].done += 1; r[0].usage = x.usage; r[0].reason = x.reason; r[0].done_at_end = true;
        r[0].npr = 0; for c: x.text { if r[0].npr < r[0].provider.count { r[0].provider[r[0].npr] = c; r[0].npr += 1; } }
      }
      if x.kind == GW_EV_REFUSED { r[0].refused += 1; r[0].reason = x.reason; }
    }
}

gw_replay_text :: (r: [] GwReplay) -> string { return cast(string) r[0].text[0..<r[0].nt]; }
gw_replay_provider :: (r: [] GwReplay) -> string { return cast(string) r[0].provider[0..<r[0].npr]; }

#test "the recorded Vercel AI Gateway stream for google/gemini-3.8-flash replays into text deltas and one done" {
  r: [1] GwReplay; fx := GW_FX_GOOGLE_GEMINI_3_8_FLASH;
  gw_replay(GW_WIRE_RESPONSES, fx[..], r[..]);
  #assert gw_replay_text(r[..]) == "One\nTwo\nThree\nFour\nFive";
  #assert r[0].deltas == 2;   // three delta events; the last is empty and hands back nothing
  #assert r[0].thoughts == 0;
  #assert r[0].done == 1;
  #assert r[0].refused == 0;
  #assert r[0].done_at_end;
  #assert r[0].reason == "stop" && r[0].usage.ok && r[0].usage.input_tokens == 25 && r[0].usage.output_tokens == 130;
  #assert r[0].usage.reasoning_tokens == 121 && r[0].usage.cached_tokens == 0;
}

#test "the recorded OpenRouter stream, with no event lines, reads by the data's type" {
  r: [1] GwReplay; fx := GW_FX_OPENROUTER_GEMINI_3_8_FLASH;
  gw_replay(GW_WIRE_RESPONSES, fx[..], r[..]);
  #assert gw_replay_text(r[..]) == "One\nTwo\nThree\nFour\nFive";
  #assert r[0].deltas == 2 && r[0].done == 1 && r[0].refused == 0 && r[0].done_at_end;
  #assert r[0].usage.ok && r[0].usage.input_tokens == 25 && r[0].usage.output_tokens == 130 && r[0].usage.reasoning_tokens == 121;
  #assert r[0].usage.cost_usd_micros == 506;     // usage.cost 0.00050625 dollars
}

#test "the recorded Z.ai glm-5.3-flash stream: 34 reasoning deltas, none of them in the answer" {
  r: [1] GwReplay; fx := GW_FX_ZAI_GLM_5_3_FLASH;
  gw_replay(GW_WIRE_RESPONSES, fx[..], r[..]);
  #assert r[0].thoughts == 34 && r[0].nr > 0;
  #assert gw_replay_text(r[..]) == "one\ntwo\nthree\nfour\nfive";
  #assert r[0].deltas == 9 && r[0].done == 1 && r[0].done_at_end && r[0].usage.ok;
}

#test "the recorded Vertex streamGenerateContent stream replays through the Gemini wire" {
  r: [1] GwReplay; fx := GW_FX_VERTEX_GEMINI_3_8_FLASH;
  gw_replay(GW_WIRE_GEMINI, fx[..], r[..]);
  #assert gw_replay_text(r[..]) == "One\nTwo\nThree\nFour\nFive";
  #assert r[0].deltas == 2 && r[0].thoughts == 0 && r[0].done == 1 && r[0].done_at_end && r[0].reason == "stop";
  #assert r[0].usage.ok && r[0].usage.input_tokens == 15 && r[0].usage.output_tokens == 9;
}

#test "Gemini: thoughts are reasoning, MAX_TOKENS is a done cut for length, SAFETY and errors refuse" {
  arena: [4096] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = arena[..]};
  ev: [8] GwEvent; ps: [1] GwParse;
  n := gw_parse(GW_WIRE_GEMINI, ps[..], ar[..], "message", "{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"hmm\",\"thought\":true},{\"text\":\"Hi\"}]},\"finishReason\":\"MAX_TOKENS\"}],\"usageMetadata\":{\"promptTokenCount\":3,\"candidatesTokenCount\":1,\"thoughtsTokenCount\":4,\"cachedContentTokenCount\":2}}", ev[..]);
  #assert n == 3 && ev[0].kind == GW_EV_REASONING && ev[0].text == "hmm" && ev[1].kind == GW_EV_TEXT && ev[1].text == "Hi";
  #assert ev[2].kind == GW_EV_DONE && ev[2].reason == "length" && ev[2].usage.output_tokens == 5 && ev[2].usage.reasoning_tokens == 4 && ev[2].usage.cached_tokens == 2;
  n = gw_parse(GW_WIRE_GEMINI, ps[..], ar[..], "message", "{\"candidates\":[{\"finishReason\":\"SAFETY\"}]}", ev[..]);
  #assert n == 1 && ev[0].kind == GW_EV_REFUSED && ev[0].reason == "SAFETY";
  n = gw_parse(GW_WIRE_GEMINI, ps[..], ar[..], "message", "{\"promptFeedback\":{\"blockReason\":\"PROHIBITED_CONTENT\"}}", ev[..]);
  #assert n == 1 && ev[0].kind == GW_EV_REFUSED && ev[0].reason == "PROHIBITED_CONTENT";
  n = gw_parse(GW_WIRE_GEMINI, ps[..], ar[..], "message", "{\"error\":{\"code\":429,\"message\":\"Resource exhausted\"}}", ev[..]);
  #assert n == 1 && ev[0].kind == GW_EV_REFUSED && ev[0].status == 429 && ev[0].reason == "Resource exhausted";
}

#test "Responses: incomplete is a done cut for length; failed, error and refusal refuse; unknown types are ignored" {
  arena: [4096] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = arena[..]};
  ev: [8] GwEvent; ps: [1] GwParse;
  n := gw_parse(GW_WIRE_RESPONSES, ps[..], ar[..], "response.incomplete", "{\"type\":\"response.incomplete\",\"response\":{\"incomplete_details\":{\"reason\":\"max_output_tokens\"},\"usage\":{\"input_tokens\":5,\"output_tokens\":9}}}", ev[..]);
  #assert n == 1 && ev[0].kind == GW_EV_DONE && ev[0].reason == "length" && ev[0].usage.output_tokens == 9;
  n = gw_parse(GW_WIRE_RESPONSES, ps[..], ar[..], "response.failed", "{\"type\":\"response.failed\",\"response\":{\"error\":{\"code\":\"server_error\",\"message\":\"upstream \\\"busy\\\"\"}}}", ev[..]);
  #assert n == 1 && ev[0].kind == GW_EV_REFUSED && ev[0].reason == "upstream \"busy\"";
  n = gw_parse(GW_WIRE_RESPONSES, ps[..], ar[..], "error", "{\"type\":\"error\",\"code\":\"rate_limited\",\"message\":\"slow down\"}", ev[..]);
  #assert n == 1 && ev[0].kind == GW_EV_REFUSED && ev[0].reason == "slow down";
  n = gw_parse(GW_WIRE_RESPONSES, ps[..], ar[..], "message", "{\"type\":\"response.refusal.done\",\"refusal\":\"I can't help with that.\"}", ev[..]);
  #assert n == 1 && ev[0].kind == GW_EV_REFUSED && ev[0].reason == "I can't help with that.";
  n = gw_parse(GW_WIRE_RESPONSES, ps[..], ar[..], "response.output_item.added", "{\"type\":\"response.output_item.added\"}", ev[..]);
  #assert n == 0;
  n = gw_parse(GW_WIRE_RESPONSES, ps[..], ar[..], "message", "{\"type\":\"response.output_text.delta\",\"delta\":\"\"}", ev[..]);
  #assert n == 0;
}

#test "a refused HTTP response reads the provider's message in its own shape" {
  arena: [4096] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = arena[..]};
  e := gw_refusal(ar[..], 401, "{\"error\":{\"message\":\"Incorrect API key provided\",\"type\":\"invalid_request_error\"}}");
  #assert e.kind == GW_EV_REFUSED && e.status == 401 && e.reason == "Incorrect API key provided";
  e = gw_refusal(ar[..], 429, "[{\"error\":{\"code\":429,\"message\":\"Quota exceeded\",\"status\":\"RESOURCE_EXHAUSTED\"}}]");
  #assert e.status == 429 && e.reason == "Quota exceeded";
  e = gw_refusal(ar[..], 402, "{\"error\":\"insufficient credits\"}");
  #assert e.reason == "insufficient credits";
  e = gw_refusal(ar[..], 502, "<html>Bad gateway</html>");
  #assert e.status == 502 && e.reason == "";
}

#test "an Open Responses body: instructions, input, budget, effort and a strict schema" {
  out: [2048] u8; why: [1] string;
  msgs: [2] GwMessage;
  msgs[0] = GwMessage.{role = "user", text = "say \"hi\""};
  msgs[1] = GwMessage.{role = "assistant", text = "hi"};
  g := Gateway.{name = "vercel", url = "https://ai-gateway.vercel.sh/v1/responses", key_env = "AI_GATEWAY_API_KEY", wire = GW_WIRE_RESPONSES};
  req := GwRequest.{model = "google/gemini-3.8-flash", system = "You are terse.", messages = msgs[..], max_tokens = 64, effort = "low", schema = "{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"],\"additionalProperties\":false}"};
  body := gw_translate(g, req, out[..], why[..]);
  #assert body == "{\"model\":\"google/gemini-3.8-flash\",\"stream\":true,\"store\":false,\"instructions\":\"You are terse.\",\"input\":[{\"role\":\"user\",\"content\":\"say \\\"hi\\\"\"},{\"role\":\"assistant\",\"content\":\"hi\"}],\"max_output_tokens\":64,\"reasoning\":{\"effort\":\"low\"},\"text\":{\"format\":{\"type\":\"json_schema\",\"name\":\"reply\",\"strict\":true,\"schema\":{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"],\"additionalProperties\":false}}}}";
  #assert json_valid(body);
  // a schema that isn't JSON, a buffer too small, a wire without a translator
  bad := req; bad.schema = "{nope";
  #assert gw_translate(g, bad, out[..], why[..]) == "" && why[0] == "the schema is not JSON";
  tiny: [16] u8;
  #assert gw_translate(g, req, tiny[..], why[..]) == "" && why[0] == "the request does not fit its buffer";
  none := g; none.wire = 9;
  #assert gw_translate(none, req, out[..], why[..]) == "" && why[0] == "this gateway's wire has no translator yet";
}

#test "the client carries the gateway's key variable and header, never a key" {
  g := Gateway.{name = "gemini", url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:streamGenerateContent?alt=sse", key_env = "GEMINI_API_KEY", key_header = "x-goog-api-key", scheme = "", wire = GW_WIRE_GEMINI};
  c := gw_client(g);
  #assert c.key_env == "GEMINI_API_KEY" && c.key_header == "x-goog-api-key" && c.scheme == "" && c.key_value == "";
}
