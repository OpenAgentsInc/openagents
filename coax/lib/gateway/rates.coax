// The rates card (docs/coder/microcoder.md, "Rates"): what each (gateway,
// model) costs per million tokens, in one table, and the cost of one
// answer from its usage. Cut from the old crates/inference meter/card.rs
// (RateRow, price_listed) and the adapters' default_models rows; margins,
// promotions and dated changes stay with the hosted gateway (gw-hosted).
//
// Prices are millionths of a US dollar per million tokens, as the old card
// kept them. Cached input and cache writes default to the input price.
// gw_price fills a done event's usage: card_usd_micros always (-1 for a
// model the card doesn't list), cost_msats too when the caller gives a
// bitcoin price (whole dollars per BTC). The plan (plan.coax) prices every
// attempt's log row and done event this way.

#load "card.coax";      // the table and its arithmetic, which loads nothing (an owner without the gateway loads only it)
#load "gateway.coax";

// What usage cost at rate, micro-USD, rounded to the nearest. Cached input
// and cache writes are parts of input_tokens (GwUsage counts them in).
gw_cost :: (rate: GwRate, u: GwUsage) -> int {
  if !u.ok { return 0; }
  return gw_card_cost(rate, u.input_tokens, u.cached_tokens, u.cache_write_tokens, u.output_tokens);
}

// micro-USD as millisatoshis at usd_per_btc (0: unknown, gives 0).
gw_msats :: (micros: int, usd_per_btc: int) -> int {
  if usd_per_btc <= 0 || micros <= 0 { return 0; }
  // msats = micros / 1e6 USD * 1e11 msats per BTC / usd_per_btc
  return gw_round_div(micros * 100000, usd_per_btc);
}

// usage with its price from the card: card_usd_micros (-1 when the model
// isn't on it, 0 with no usage) and cost_msats at usd_per_btc.
gw_price :: (gateway: string, model: string, u: GwUsage, usd_per_btc: int) -> GwUsage {
  p := u;
  f := gw_rate(gateway, model);
  if !f.ok { p.card_usd_micros = -1; p.cost_msats = 0; return p; }
  p.card_usd_micros = gw_cost(f.rate, u);
  p.cost_msats = gw_msats(p.card_usd_micros, usd_per_btc);
  return p;
}

// ---------------------------------------------------------------- checks

#test "one row per gateway and model, and every gateway's flash model is on the card" {
  rows := GW_RATES;
  for a, i: rows { for b, j: rows { if i < j { #assert !(a.gateway == b.gateway && a.model == b.model); } } }
  #assert gw_rate("vertex", "google/gemini-3.8-flash").ok && gw_rate("gemini", "gemini-3.8-flash").ok && gw_rate("openrouter", "google/gemini-3.8-flash").ok;
  #assert gw_rate("vercel", "google/gemini-3.8-flash").ok && gw_rate("zai", "glm-5.3-flash").ok && gw_rate("anthropic", "claude-haiku-4-5").ok;
  #assert !gw_rate("openai", "gpt-5.4-mini").ok && !gw_rate("vertex", "zai/glm-5.3-flash").ok;
}

#test "a cost: plain, cached and written input, and output, at the row's prices" {
  f := gw_rate("vercel", "google/gemini-3.8-flash");
  // the recorded Vercel stream's usage: 25 in, 130 out (the old card's derivation)
  #assert gw_cost(f.rate, GwUsage.{ok = true, input_tokens = 25, output_tokens = 130}) == 506;
  // a million in with 400k cached, a million out
  #assert gw_cost(f.rate, GwUsage.{ok = true, input_tokens = 1000000, cached_tokens = 400000, output_tokens = 1000000}) == 450000 + 30000 + 3750000;
  h := gw_rate("anthropic", "claude-haiku-4-5");
  #assert gw_cost(h.rate, GwUsage.{ok = true, input_tokens = 1000000, cached_tokens = 500000, cache_write_tokens = 200000, output_tokens = 0}) == 300000 + 50000 + 250000;
  #assert gw_cost(h.rate, GwUsage.{}) == 0;
  // cached more than input is held to input
  #assert gw_cost(f.rate, GwUsage.{ok = true, input_tokens = 10, cached_tokens = 50}) == 1;
}

#test "Gemini 4 Carbon's recorded streams are priced from the card: text, reasoning counted as output, and both endpoints" {
  r: [1] GwReplay; fx := GW_FX_VERTEX_GEMINI_4_CARBON;
  gw_replay(GW_WIRE_GEMINI, fx[..], r[..]);
  #assert gw_replay_text(r[..]) == "One\nTwo\nThree\nFour\nFive" && r[0].done == 1;
  #assert r[0].usage.ok && r[0].usage.input_tokens == 61 && r[0].usage.output_tokens == 13 && r[0].usage.reasoning_tokens == 0;
  // 61 in at $4.00 and 13 out at $20.00 a million: 244 + 260 micro-USD
  #assert gw_price("vertex", "gemini-4-carbon", r[0].usage, 100000).card_usd_micros == 504;
  h: [1] GwReplay; hx := GW_FX_VERTEX_GEMINI_4_CARBON_HIGH;
  gw_replay(GW_WIRE_GEMINI, hx[..], h[..]);
  #assert gw_replay_text(h[..]) == "One\nTwo\nThree\nFour\nFive" && h[0].done == 1;
  // thinking high: 256 reasoning tokens, billed as output beside the 13 of the answer
  #assert h[0].usage.reasoning_tokens == 256 && h[0].usage.output_tokens == 269;
  #assert gw_price("vertex", "gemini-4-carbon", h[0].usage, 100000).card_usd_micros == 244 + 5380;
  o: [1] GwReplay; ox := GW_FX_VERTEX_OPENAI_GEMINI_4_CARBON;
  gw_replay(GW_WIRE_CHAT, ox[..], o[..]);
  #assert gw_replay_text(o[..]) == "One\nTwo\nThree\nFour\nFive" && o[0].done == 1 && o[0].usage.ok;
  #assert gw_price("vertex", "google/gemini-4-carbon", o[0].usage, 100000).card_usd_micros == gw_price("vertex", "gemini-4-carbon", o[0].usage, 100000).card_usd_micros;
  // cached input at its own price: a million in, all cached, is $0.20
  #assert gw_cost(gw_rate("gemini", "gemini-4-carbon").rate, GwUsage.{ok = true, input_tokens = 1000000, cached_tokens = 1000000}) == 200000;
}

#test "a price on usage: the card's micros, msats at a bitcoin price, -1 off the card" {
  u := GwUsage.{ok = true, input_tokens = 25, output_tokens = 130};
  p := gw_price("vercel", "google/gemini-3.8-flash", u, 100000);
  #assert p.card_usd_micros == 506 && p.cost_msats == 506 && p.input_tokens == 25;
  #assert gw_price("vercel", "google/gemini-3.8-flash", u, 0).cost_msats == 0;
  #assert gw_price("openai", "gpt-5.4-mini", u, 100000).card_usd_micros == -1;
  #assert gw_msats(1000000, 50000) == 2000000;   // a dollar at $50k is 2,000 sats
}
