// The gateway transport against a local server (smoke.sh runs it): a
// streamed answer must hand back its text deltas while the response is
// still coming, the key must reach the server in its header and nowhere
// else, and a 401 must come back as one refused event.

#import "Basic";
#load "plan.coax";

KEY_ENV :: "GW_SMOKE_KEY";

smoke_stream :: (url: string) -> bool {
  b: [1] GwCallBuffers; call: [1] GwCall;
  gw_call_init(call[..], b[..]);
  g := Gateway.{name = "local", url = url, key_env = KEY_ENV, wire = GW_WIRE_RESPONSES};
  out: [1024] u8; why: [1] string;
  msgs: [1] GwMessage; msgs[0] = GwMessage.{role = "user", text = "count"};
  body := gw_translate(g, GwRequest.{model = "local", messages = msgs[..]}, out[..], why[..]);
  none: [1] string;
  e := gw_call_start(call[..], g, body, none[0..<0]);
  if e.count > 0 { print("start: %\n", e); return false; }
  t0 := cxproc_now_ms(); first_ms := -1; end_ms := -1;
  text: [256] u8; nt := 0; done := false; leak := false;
  ev: [8] GwEvent;
  while !call[0].finished {
    n := gw_call_poll(call[..], ev[..]);
    for i: 0..<n {
      x := ev[i];
      if x.kind == GW_EV_TEXT {
        if first_ms < 0 { first_ms = cxproc_now_ms() - t0; }
        for c: x.text { if nt < text.count { text[nt] = c; nt += 1; } }
      }
      if x.kind == GW_EV_DONE { done = x.usage.input_tokens == 7; end_ms = cxproc_now_ms() - t0; }
      if x.kind == GW_EV_REFUSED { print("refused: % %\n", x.status, x.reason); end_ms = cxproc_now_ms() - t0; }
    }
  }
  got := cast(string) text[0..<nt];
  print("stream: first delta at %ms, done at %ms, text %\n", first_ms, end_ms, got);
  ok := done && got == "One\nTwo\nkey_ok,args_clean,body_ok";
  ok = ok && first_ms >= 0 && end_ms - first_ms >= 500;   // three 400 ms gaps: the first delta came well before the end
  return ok;
}

smoke_refuse :: (url: string) -> bool {
  b: [1] GwCallBuffers; call: [1] GwCall;
  gw_call_init(call[..], b[..]);
  g := Gateway.{name = "local", url = url, key_env = KEY_ENV, wire = GW_WIRE_RESPONSES};
  none: [1] string;
  e := gw_call_start(call[..], g, "{\"model\":\"local\"}", none[0..<0]);
  if e.count > 0 { print("start: %\n", e); return false; }
  ev: [8] GwEvent; got: GwEvent; count := 0; 
  while !call[0].finished {
    n := gw_call_poll(call[..], ev[..]);
    for i: 0..<n { got = ev[i]; count += 1; }
  }
  print("refuse: % events, status %, reason %, first %\n", count, got.status, got.reason, call[0].first);
  return count == 1 && got.kind == GW_EV_REFUSED && got.status == 401 && got.reason == "bad key" && !call[0].first;
}

smoke_whole :: (url: string) -> bool {
  b: [1] GwCallBuffers; call: [1] GwCall;
  gw_call_init(call[..], b[..]);
  g := Gateway.{name = "local", url = url, key_env = KEY_ENV, wire = GW_WIRE_CHAT};
  none: [1] string;
  e := gw_call_start(call[..], g, "{\"model\":\"local\",\"stream\":false}", none[0..<0]);
  if e.count > 0 { print("start: %\n", e); return false; }
  ev: [8] GwEvent; text := ""; done := false;
  while !call[0].finished {
    n := gw_call_poll(call[..], ev[..]);
    for i: 0..<n {
      if ev[i].kind == GW_EV_TEXT { text = ev[i].text; }
      if ev[i].kind == GW_EV_DONE { done = ev[i].usage.input_tokens == 5; }
      if ev[i].kind == GW_EV_REFUSED { print("whole refused: %\n", ev[i].reason); }
    }
    if n > 0 && text.count > 0 { print("whole: text %, done %\n", text, done); }
  }
  return text == "Four" && done;
}

smoke_unreachable :: () -> bool {
  b: [1] GwCallBuffers; call: [1] GwCall;
  gw_call_init(call[..], b[..]);
  g := Gateway.{name = "nowhere", url = "http://127.0.0.1:9/v1/responses", key_env = KEY_ENV, wire = GW_WIRE_RESPONSES};
  none: [1] string;
  e := gw_call_start(call[..], g, "{\"model\":\"local\"}", none[0..<0]);
  if e.count > 0 { print("start: %\n", e); return false; }
  ev: [8] GwEvent; got: GwEvent;
  while !call[0].finished {
    n := gw_call_poll(call[..], ev[..]);
    for i: 0..<n { got = ev[i]; }
  }
  print("unreachable: status %, reason %\n", got.status, got.reason);
  return got.kind == GW_EV_REFUSED && got.status == 0 && got.reason == "the server is unreachable";
}

PROMPT :: "zebra-prompt-text-that-must-never-be-logged";

plan_run :: (p: [] GwPlan, bench: [] GwBench, text: [] u8, nt: [] int) -> GwEvent {
  msgs: [1] GwMessage; msgs[0] = GwMessage.{role = "user", text = PROMPT};
  gw_plan_start(p, bench, GwRequest.{model = "unset", messages = msgs[..]});
  ev: [8] GwEvent; last: GwEvent;
  while !p[0].over {
    n := gw_plan_poll(p, bench, ev[..]);
    for i: 0..<n {
      if ev[i].kind == GW_EV_TEXT { for c: ev[i].text { if nt[0] < text.count { text[nt[0]] = c; nt[0] += 1; } } }
      else { last = ev[i]; }
    }
  }
  lb: [512] u8;
  for i: 0..<p[0].nlog { print("plan log: %\n", gw_attempt_line(p[0].log[i], lb[..])); }
  return last;
}

smoke_plans :: (base: string, refuse: string, cut: string) -> bool {
  none: [1] string;
  bench: [1] GwBench;
  b: [1] GwPlanBuffers; p: [1] GwPlan;
  gw_plan_init(p[..], b[..]);
  x := gw_plan_add(p[..], Gateway.{name = "first", url = refuse, key_env = KEY_ENV, wire = GW_WIRE_RESPONSES}, "m1", none[0..<0]);
  x = gw_plan_add(p[..], Gateway.{name = "second", url = base, key_env = KEY_ENV, wire = GW_WIRE_RESPONSES}, "m2", none[0..<0]);
  text: [256] u8; nt: [1] int;
  last := plan_run(p[..], bench[..], text[..], nt[..]);
  ok := last.kind == GW_EV_DONE && p[0].nlog == 2 && p[0].log[0].outcome == GW_OUT_BENCHED && p[0].log[0].status == 401 && p[0].log[1].outcome == GW_OUT_DONE;
  ok = ok && gw_benched(bench[..], "first") && nt[0] > 0;
  print("plan: refused first attempt fell through: %\n", ok);
  // again: the benched gateway is skipped
  nt[0] = 0;
  last = plan_run(p[..], bench[..], text[..], nt[..]);
  ok2 := last.kind == GW_EV_DONE && p[0].log[0].outcome == GW_OUT_SKIPPED && p[0].log[1].outcome == GW_OUT_DONE;
  print("plan: benched gateway skipped: %\n", ok2);
  // a failure after the first token ends the call: no retry
  c: [1] GwPlan; cb: [1] GwPlanBuffers; fresh: [1] GwBench;
  gw_plan_init(c[..], cb[..]);
  x = gw_plan_add(c[..], Gateway.{name = "cutter", url = cut, key_env = KEY_ENV, wire = GW_WIRE_RESPONSES}, "m1", none[0..<0]);
  x = gw_plan_add(c[..], Gateway.{name = "second", url = base, key_env = KEY_ENV, wire = GW_WIRE_RESPONSES}, "m2", none[0..<0]);
  nt[0] = 0;
  last = plan_run(c[..], fresh[..], text[..], nt[..]);
  got := cast(string) text[0..<nt[0]];
  ok3 := last.kind == GW_EV_REFUSED && got == "Half" && c[0].nlog == 1 && c[0].log[0].outcome == GW_OUT_CUT;
  print("plan: cut after the first token, no retry: % (%)\n", ok3, got);
  return ok && ok2 && ok3;
}

main :: () {
  for ch: "GW_SMOKE_URL" { k := cxproc_getenv_push(cast(int) ch); }
  n := cxproc_getenv();
  url: [256] u8;
  if n <= 0 || n > url.count { print("set GW_SMOKE_URL\n"); return; }
  for i: 0..<n { url[i] = cast(u8) cxproc_getenv_byte(i); }
  base := cast(string) url[0..<n];
  ok := smoke_stream(base);
  ru: [300] u8;
  for i: 0..<n { ru[i] = url[i]; }
  for c, i: "refuse" { ru[n + i] = c; }
  ok = smoke_refuse(cast(string) ru[0..<n + 6]) && ok;
  wu: [300] u8;
  for i: 0..<n { wu[i] = url[i]; }
  for c, i: "whole" { wu[n + i] = c; }
  ok = smoke_whole(cast(string) wu[0..<n + 5]) && ok;
  ok = smoke_unreachable() && ok;
  cu: [300] u8;
  for i: 0..<n { cu[i] = url[i]; }
  for c, i: "cut" { cu[n + i] = c; }
  ok = smoke_plans(base, cast(string) ru[0..<n + 6], cast(string) cu[0..<n + 3]) && ok;
  print("smoke: %\n", ifx ok then "ok" else "FAILED");
}
