// Server-sent events, read a line at a time (the WHATWG event-stream rules,
// as the old crates/inference sse.rs reads them): "field: value" lines, one
// space after the colon dropped; data lines join with a newline; a line
// starting with a colon is a comment; a blank line dispatches the event
// when it has data; id and retry are read and ignored; a field with no
// colon has an empty value. Nothing allocates: the event's name and data
// live in the caller's buffers and stay valid until the next line.
// Part of the gateways (docs/coder/microcoder.md, row 1).

GwSse :: struct {
  name: [] u8; nn: int;          // the event field ("" is "message")
  data: [] u8; nd: int;
  has_data: bool;
  overflow: bool;                // the event did not fit its buffers (dispatched truncated, flagged)
  spent: bool;                   // the last line dispatched: clear before the next
}

GwSseEvent :: struct {
  ready: bool;                   // an event was dispatched by this line
  name: string;
  data: string;
  truncated: bool;
}

#test "SSE frames preserve joined data lines and reject header injection or clipping" {
 b:[256]u8;s:[1]GwSse;name:[32]u8;data:[64]u8;
 n:=gw_sse_frame("12","turn","a\nb\n",b[..]);
 #assert n>0 && cast(string)b[0..<n]=="id: 12\nevent: turn\ndata: a\ndata: b\ndata: \n\n";
 gw_sse_init(s[..],name[..],data[..]);from:=0;last:=GwSseEvent.{};
 for i:0..<n {if b[i]=='\n' {e:=gw_sse_line(s[..],cast(string)b[from..<i]);if e.ready {last=e;}from=i+1;}}
 #assert last.ready && last.name=="turn" && last.data=="a\nb\n" && !last.truncated;
 #assert gw_sse_frame("","","",b[..])==21;
 #assert gw_sse_frame("12","turn","x",b[0..<2])<0;
 for bad:[3]string.["x\ny","x\ry","x\0y"] {#assert gw_sse_frame(bad,"turn","x",b[..])<0 && gw_sse_frame("1",bad,"x",b[..])<0;}
 #assert gw_sse_frame("1","turn","x\ry",b[..])<0;
 control:[3]u8;control[0]='x';control[1]=1;control[2]='y';
 #assert gw_sse_frame("1","turn","x\0y",b[..])<0 && gw_sse_frame("1","turn",cast(string)control[..],b[..])>0;
}
// The writer and parser share the same bounded append primitive. LF-separated
// data round trips including a final empty line; CR is refused, not normalized.
gw_sse_frame :: (id:string,name:string,data:string,out:[]u8)->int {
 for header:[2]string.[id,name] {for c:header {if c=='\r' || c=='\n' || c==0 {return -1;}}}
 for c:data {if c=='\r' || c==0 {return -1;}}
 // After the first append n is -1 or at least 4; testing >0 or >=1 is equivalent.
 n:=gw_sse_append(out,0,"id: ");if n>=0 {n=gw_sse_append(out,n,id);}if n>=0 {n=gw_sse_append(out,n,"\nevent: ");}if n>=0 {n=gw_sse_append(out,n,name);}if n>=0 {n=gw_sse_append(out,n,"\n");} // mutant: equivalent (the nonnegative offset is already at least 4)
 from:=0;for i:0..<data.count+1 {if i==data.count || data[i]=='\n' {
  if n>=0 {n=gw_sse_append(out,n,"data: ");}if n>=0 {n=gw_sse_append(out,n,cast(string)data[from..<i]);}if n>=0 {n=gw_sse_append(out,n,"\n");}from=i+1; // mutant: equivalent (the same -1 or at-least-4 offset invariant)
 }}
 if n>=0 {n=gw_sse_append(out,n,"\n");}return n; // mutant: equivalent (the same -1 or at-least-4 offset invariant)
}

gw_sse_init :: (s: [] GwSse, name_buf: [] u8, data_buf: [] u8) {
  s[0] = GwSse.{name = name_buf, data = data_buf};
}

gw_sse_clear :: (s: [] GwSse) { s[0].nn = 0; s[0].nd = 0; s[0].has_data = false; s[0].overflow = false; s[0].spent = false; }

gw_sse_append :: (buf: [] u8, at: int, text: string) -> int {
  k := at;
  for c: text { if k >= buf.count { return -1; } buf[k] = c; k += 1; }
  return k;
}

// One line, without its line ending (a trailing \r is dropped here too).
gw_sse_line :: (s: [] GwSse, raw: string) -> GwSseEvent {
  if s[0].spent { gw_sse_clear(s); }
  line := raw;
  if line.count > 0 && line[line.count - 1] == '\r' { line = cast(string) line[0..<line.count - 1]; }
  if line.count == 0 {
    if !s[0].has_data { gw_sse_clear(s); return GwSseEvent.{}; }
    s[0].spent = true;
    ev := GwSseEvent.{ready = true, truncated = s[0].overflow};
    ev.name = ifx s[0].nn > 0 then cast(string) s[0].name[0..<s[0].nn] else "message";
    ev.data = cast(string) s[0].data[0..<s[0].nd];
    return ev;
  }
  if line[0] == ':' { return GwSseEvent.{}; } // mutant: equivalent (':' -> ';' is equivalent because ':' gives field "" and ';' gives field[0]==';', neither matching "data" or "event")
  colon := -1;
  for i: 0..<line.count { if line[i] == ':' { colon = i; break; } } // mutant: equivalent (line 77 already returned when line[0] == ':', so i == 0 never matches)
  field := line; value := "";
  if colon >= 0 { // mutant: equivalent (line 77 already returned when line[0] == ':', so colon is -1 or >= 1, never 0)
    field = cast(string) line[0..<colon];
    v := colon + 1;
    if v < line.count && line[v] == ' ' { v += 1; }
    value = cast(string) line[v..<line.count];
  }
  if field == "data" {
    at := s[0].nd;
    if s[0].has_data { at = gw_sse_append(s[0].data, at, "\n"); }
    if at >= 0 { at = gw_sse_append(s[0].data, at, value); }
    if at < 0 { s[0].overflow = true; } else { s[0].nd = at; }
    s[0].has_data = true;
  } else if field == "event" {
    n := gw_sse_append(s[0].name, 0, value);
    if n < 0 { s[0].overflow = true; } else { s[0].nn = n; }
  }
  return GwSseEvent.{};
}

#test "an event stream: named events, joined data lines, comments, the blank line dispatching" {
  s: [1] GwSse; name: [64] u8; data: [256] u8;
  gw_sse_init(s[..], name[..], data[..]);
  e := gw_sse_line(s[..], ": keep-alive");
  #assert !e.ready;
  e = gw_sse_line(s[..], "event: response.output_text.delta");
  e = gw_sse_line(s[..], "data: {\"delta\":\"Hel\"}\r");
  #assert !e.ready;
  e = gw_sse_line(s[..], "");
  #assert e.ready && e.name == "response.output_text.delta" && e.data == "{\"delta\":\"Hel\"}";
  // the name does not carry over; two data lines join; no space after the colon is kept as is
  e = gw_sse_line(s[..], "data:one");
  e = gw_sse_line(s[..], "data:  two");
  e = gw_sse_line(s[..], "id: 7");
  e = gw_sse_line(s[..], "");
  #assert e.ready && e.name == "message" && e.data == "one\n two";
  // a blank line with no data dispatches nothing; a field with no colon is empty
  e = gw_sse_line(s[..], "event: lonely");
  e = gw_sse_line(s[..], "");
  #assert !e.ready;
  e = gw_sse_line(s[..], "data");
  e = gw_sse_line(s[..], "");
  #assert e.ready && !e.truncated && e.data == "" && e.name == "message";
  // one-byte comment, one-byte event name, colon at end of line, standalone CR dispatch, empty event name resets to message
  e = gw_sse_line(s[..], ":");
  #assert !e.ready;
  e = gw_sse_line(s[..], "event: x");
  e = gw_sse_line(s[..], "data:");
  e = gw_sse_line(s[..], "\r");
  #assert e.ready && !e.truncated && e.name == "x" && e.data == "";
  e = gw_sse_line(s[..], "event: prev");
  e = gw_sse_line(s[..], "event:");
  e = gw_sse_line(s[..], "data: ok");
  e = gw_sse_line(s[..], "");
  #assert e.ready && !e.truncated && e.name == "message" && e.data == "ok";
}

#test "an event too large for its buffer is flagged, and the next one reads whole" {
  s: [1] GwSse; name: [8] u8; data: [8] u8;
  gw_sse_init(s[..], name[..], data[..]);
  e := gw_sse_line(s[..], "data: 0123456789");
  e = gw_sse_line(s[..], "");
  #assert e.ready && e.truncated;
  e = gw_sse_line(s[..], "event: 0123456789");
  e = gw_sse_line(s[..], "data: 1");
  e = gw_sse_line(s[..], "");
  #assert e.ready && e.truncated && e.name == "message" && e.data == "1";
  e = gw_sse_line(s[..], "event: ok");
  e = gw_sse_line(s[..], "data: 42");
  e = gw_sse_line(s[..], "");
  #assert e.ready && !e.truncated && e.name == "ok" && e.data == "42";
}
