// tool.sh: tls
// gbench-run: Pure Coax gBench Runner, Inkling Variant Comparator & #authority Hillclimber.
//
// Bundled beside tbench-run, lean-run, and ple-run inside OpenAgents.app/Contents/Resources/gbench-run.
//
// Verbs:
//   gbench-run doctor [--json]
//   gbench-run suites [--json]
//   gbench-run variants [--json]
//   gbench-run compare [--profile oa-template-smoke|oa-perf-quick|oa-perf-agentic|oa-local-fast|oa-local-core]
//                      [--evals s1,s2] [--limit N] [--arm-a V] [--arm-b V]
//                      [--thinking] [--thinking-a 0|1] [--thinking-b 0|1]
//                      [--effort-a E] [--effort-b E] [--max-output-tokens N]
//                      [--allow-local-golden-exec] [--endpoint-a URL] [--endpoint-b URL] [--out FILE]
//   gbench-run hillclimb [--profile ...] [--evals ...] [--limit N]
//                        [--champion POLICY_OR_V] [--challenger POLICY_OR_V] [--propose]
//                        [--allow-local-golden-exec]
//   gbench-run status [--json]
//   gbench-run stop
//
//   coax/web/tool.sh coder/tui/gbench-run.coax doctor --json
#import "Basic";
#load "../sys/tool.coax";
#load "../sys/args.coax";
#load "gbench_host.coax";

gbc_usage :: () -> int #effects(all) {
  print("gbench-run — OpenAgents Coax gBench Runner, Inkling Variant Comparator & Hillclimber\n\n");
  print("Usage:\n");
  print("  gbench-run doctor [--json]\n");
  print("  gbench-run suites [--json]\n");
  print("  gbench-run variants [--json]\n");
  print("  gbench-run compare [--profile oa-template-smoke|oa-perf-quick|oa-perf-agentic|oa-local-fast|oa-local-core]\n");
  print("                     [--evals s1,s2] [--limit N] [--arm-a VARIANT] [--arm-b VARIANT]\n");
  print("                     [--thinking] [--thinking-a 0|1] [--thinking-b 0|1]\n");
  print("                     [--effort-a E] [--effort-b E] [--max-output-tokens N]\n");
  print("                     [--allow-local-golden-exec] [--endpoint-a URL] [--endpoint-b URL] [--out FILE]\n");
  print("  gbench-run hillclimb [--profile ...] [--evals ...] [--limit N]\n");
  print("                       [--champion POLICY_OR_V] [--challenger POLICY_OR_V] [--propose]\n");
  print("                       [--allow-local-golden-exec]\n");
  print("  gbench-run status [--json]\n");
  print("  gbench-run stop\n");
  return 0;
}

gbc_cmd_doctor :: (a: [] Args) -> int #effects(all) {
  env: [1] GbEnv;
  gbr_discover(env[..]);
  doc: [1] GbDoctor;
  gbr_doctor_to_wire(env[..], doc[..]);
  if args_has(a, "--json") {
    buf: [4096] u8;
    n := gbw_doctor_write(doc[..], buf[..]);
    if n <= 0 { tool_errln("gbench-run doctor: JSON encode failed"); return 1; }
    print("%\n", cast(string) buf[0..<n]);
    return ifx doc[0].ok then 0 else 1;
  }
  print("OpenAgents gBench Doctor\n");
  print("  venv:      % (gbench % · Python %)\n", ifx doc[0].venv_ok then "OK" else "MISSING",
    cast(string) doc[0].gbench_version[0..<doc[0].gbench_version_n],
    cast(string) doc[0].python_version[0..<doc[0].python_version_n]);
  print("  psionic:   % (%)\n", ifx doc[0].psionic_ok then "OK" else "MISSING",
    cast(string) env[0].psionic_bin[0..<env[0].psionic_bin_n]);
  print("  llama.cpp: % (%)\n", ifx doc[0].llama_ok then "OK" else "MISSING",
    cast(string) env[0].llama_bin[0..<env[0].llama_bin_n]);
  print("  flawed:    % (%)\n", ifx env[0].flawed_ok then "OK" else "MISSING",
    cast(string) env[0].flawed_bin[0..<env[0].flawed_bin_n]);
  print("  vertex:    %\n", ifx env[0].vertex_ok then "OK (Gemini 4 Neon family & Flawed Cloud ready)" else "not configured ($0 local mode)");
  print("  tokenizer: % (%)\n", ifx doc[0].tokenizer_ok then "OK" else "MISSING",
    cast(string) env[0].tokenizer_dir[0..<env[0].tokenizer_dir_n]);
  print("  variants:  % Inkling checkpoint(s) installed in ~/.openagents/models\n", doc[0].variants_installed);
  print("  bwrap:     %\n", ifx doc[0].bwrap_ok then "OK (Linux sandboxed coding enabled)" else "not installed (macOS; Linux-only for Tier F)");
  print("  docker:    %\n", ifx doc[0].docker_ok then "OK" else "not running");
  print("  keys:      GEMINI_API_KEY=% · HF_TOKEN=%\n",
    ifx doc[0].gemini_key_set then "set" else "unset ($0 local mode)",
    ifx doc[0].hf_token_set then "set" else "unset");
  return ifx doc[0].ok then 0 else 1;
}

gbc_cmd_suites :: (a: [] Args) -> int #effects(all) {
  if args_has(a, "--json") {
    buf: [32768] u8;
    o: [1] Jo; jo_start(o[..], buf[..]);
    jo_obj(o[..]);
    jo_key(o[..], "profiles"); jo_arr(o[..]);
    for pid: 0..<GB_PROF_COUNT {
      info := gb_profile_info(pid);
      jo_obj(o[..]);
      jo_key(o[..], "slug"); jo_str(o[..], info.slug);
      jo_key(o[..], "title"); jo_str(o[..], info.title);
      jo_key(o[..], "pillar"); jo_str(o[..], gb_kind_name(info.kind));
      jo_key(o[..], "count"); jo_int(o[..], info.count);
      jo_key(o[..], "requires_linux_bwrap"); jo_bool(o[..], info.requires_linux_bwrap);
      jo_key(o[..], "default_limit"); jo_int(o[..], info.default_limit);
      jo_key(o[..], "default_max_output_tokens"); jo_int(o[..], info.default_max_output_tokens);
      jo_key(o[..], "items"); jo_arr(o[..]);
      for i: 0..<info.count {
        nm := gb_profile_item(pid, i);
        jo_obj(o[..]);
        jo_key(o[..], "id"); jo_str(o[..], nm);
        gate := ifx info.kind == GB_KIND_GOLDEN then gb_admit_distill_suite("golden") else gb_admit_distill_suite(nm);
        jo_key(o[..], "distill_allowed"); jo_bool(o[..], gate == GB_DISTILL_ADMIT);
        jo_end(o[..]);
      }
      jo_end(o[..]);
      jo_end(o[..]);
    }
    jo_end(o[..]);
    jo_end(o[..]);
    if o[0].bad { tool_errln("gbench-run suites: JSON overflow"); return 1; }
    print("%\n", jo_text(o[..]));
    return 0;
  }
  print("OpenAgents gBench Profiles:\n");
  for pid: 0..<GB_PROF_COUNT {
    info := gb_profile_info(pid);
    print("  %  [%]  % item(s)  — %\n", info.slug, gb_kind_name(info.kind), info.count, info.title);
  }
  return 0;
}

gbc_cmd_variants :: (a: [] Args) -> int #effects(all) {
  env: [1] GbEnv;
  gbr_discover(env[..]);
  if args_has(a, "--json") {
    buf: [16384] u8;
    o: [1] Jo; jo_start(o[..], buf[..]);
    jo_obj(o[..]);
    jo_key(o[..], "variants"); jo_arr(o[..]);
    for vid: 0..<GB_VAR_COUNT {
      v := gb_variant_info(vid);
      jo_obj(o[..]);
      jo_key(o[..], "slug"); jo_str(o[..], v.slug);
      jo_key(o[..], "label"); jo_str(o[..], v.label);
      jo_key(o[..], "backend"); jo_str(o[..], v.backend);
      jo_key(o[..], "model_id"); jo_str(o[..], v.model_id);
      jo_key(o[..], "quant"); jo_str(o[..], v.quant);
      jo_key(o[..], "has_lora"); jo_bool(o[..], v.rel_lora.count > 0);
      jo_key(o[..], "installed"); jo_bool(o[..], env[0].variant_ready[vid]);
      jo_key(o[..], "min_ram_gb"); jo_int(o[..], v.min_ram_gb);
      jo_end(o[..]);
    }
    jo_end(o[..]);
    jo_end(o[..]);
    if o[0].bad { tool_errln("gbench-run variants: JSON overflow"); return 1; }
    print("%\n", jo_text(o[..]));
    return 0;
  }
  print("Inkling, Gemini 4 Neon & Flawed Harness Variants:\n");
  for vid: 0..<GB_VAR_COUNT {
    v := gb_variant_info(vid);
    print("  [%]  %  (% · %)  — %\n", ifx env[0].variant_ready[vid] then "READY" else "-----", v.slug, v.backend, v.quant, v.label);
  }
  return 0;
}

gbc_parse_tri :: (s: string, fallback: int) -> int #effects(all) {
  if s == "1" || s == "true" || s == "on" { return 1; }
  if s == "0" || s == "false" || s == "off" { return 0; }
  return fallback;
}

gbc_count_ledger_rounds :: (ledger_path: string) -> int #effects(all) {
  buf: [131072] u8;
  n := fs_read(ledger_path, buf[..]);
  if n <= 0 { return 0; }
  lines := 0;
  for i: 0..<n { if buf[i] == '\n' { lines += 1; } }
  return lines;
}

gbc_cmd_compare :: (a: [] Args, default_profile: string) -> int #effects(all) {
  env: [1] GbEnv;
  gbr_discover(env[..]);
  if !env[0].venv_ok {
    tool_errln("gbench-run compare: ~/.openagents/gbench/venv not ready — run `gbench-run doctor`");
    return 1;
  }

  profile := args_value(a, "--profile", default_profile);
  evals_csv := args_value(a, "--evals", "");
  limit_n := gbr_parse_uint(args_value(a, "--limit", ""));
  arm_a_spec := args_value(a, "--arm-a", "inkling-2-mini");
  arm_b_spec := args_value(a, "--arm-b", "inkling-2-mini-uncensored-lora");
  ep_a := args_value(a, "--endpoint-a", "");
  ep_b := args_value(a, "--endpoint-b", "");
  out_file := args_value(a, "--out", "");
  eff_all := args_value(a, "--effort", "");
  eff_a := args_value(a, "--effort-a", eff_all);
  eff_b := args_value(a, "--effort-b", eff_all);
  mot := gbr_parse_uint(args_value(a, "--max-output-tokens", ""));
  th_def := ifx args_has(a, "--thinking") then 1 else -1;
  th_a := gbc_parse_tri(args_value(a, "--thinking-a", ""), th_def);
  th_b := gbc_parse_tri(args_value(a, "--thinking-b", ""), th_def);
  allow_exec := args_has(a, "--allow-local-golden-exec");

  w: [1] GbRunWork;
  if !gbr_resolve_policy(env[..], arm_a_spec, th_a, eff_a, mot, w[0].pol_a[..]) {
    tool_err("gbench-run compare: unknown --arm-a: "); tool_errln(arm_a_spec);
    return 2;
  }
  if !gbr_resolve_policy(env[..], arm_b_spec, th_b, eff_b, mot, w[0].pol_b[..]) {
    tool_err("gbench-run compare: unknown --arm-b: "); tool_errln(arm_b_spec);
    return 2;
  }

  rid_b: [64] u8;
  run_id := gbr_make_run_id("gb", rid_b[..]);
  rd1: [FS_PATH_MAX] u8; rd2: [FS_PATH_MAX] u8;
  home := cast(string) env[0].home[0..<env[0].home_n];
  runs_root := fs_join(home, ".openagents/gbench/runs", rd1[..]);
  run_dir := fs_join(runs_root, run_id, rd2[..]);

  if !gbr_run_compare(env[..], w[..], run_id, run_dir, profile, evals_csv, limit_n, allow_exec, ep_a, ep_b, out_file) {
    tool_errln("gbench-run compare: execution or serialization failed");
    return 1;
  }

  sa := w[0].sum_a[0];
  sb := w[0].sum_b[0];
  sc_a := cast(string) sa.scaffold_id[0..<sa.scaffold_id_n];
  sc_b := cast(string) sb.scaffold_id[0..<sb.scaffold_id_n];
  print("gBench Compare Complete (% · % · scaffold %)\n", run_id, profile,
    ifx gb_scaffolds_match(sc_a, sc_b) then sc_a else "UNLOCKED");
  print("  Arm A (%): score % bps (%/% graded), TTFT %us, TPOT %us, % tok/s*0.1, wall %ms\n",
    cast(string) sa.id[0..<sa.id_n], sa.score_bps, sa.passed, sa.graded, sa.ttft_p50_us, sa.tpot_p50_us, sa.tok_per_s_x10, sa.total_wall_ms);
  print("  Arm B (%): score % bps (%/% graded), TTFT %us, TPOT %us, % tok/s*0.1, wall %ms\n",
    cast(string) sb.id[0..<sb.id_n], sb.score_bps, sb.passed, sb.graded, sb.ttft_p50_us, sb.tpot_p50_us, sb.tok_per_s_x10, sb.total_wall_ms);
  print("  Saved: ~/.openagents/gym/last-gbench.json & %/compare.json\n", run_dir);
  return 0;
}

gbc_cmd_hillclimb :: (a: [] Args) -> int #effects(all) {
  env: [1] GbEnv;
  gbr_discover(env[..]);
  if !env[0].venv_ok {
    tool_errln("gbench-run hillclimb: ~/.openagents/gbench/venv not ready");
    return 1;
  }

  profile := args_value(a, "--profile", "oa-local-fast");
  evals_csv := args_value(a, "--evals", "");
  limit_n := gbr_parse_uint(args_value(a, "--limit", "10"));
  champ_spec := args_value(a, "--champion", "");
  cand_spec := args_value(a, "--challenger", "");
  propose := args_has(a, "--propose") || cand_spec.count == 0;
  allow_exec := args_has(a, "--allow-local-golden-exec");
  mot := gbr_parse_uint(args_value(a, "--max-output-tokens", "2048"));
  round_ov := gbr_parse_uint(args_value(a, "--round", ""));
  th_def := ifx args_has(a, "--thinking") then 1 else -1;
  eff_a := args_value(a, "--effort-a", "");
  eff_b := args_value(a, "--effort-b", "");

  home := cast(string) env[0].home[0..<env[0].home_n];
  hd_b: [FS_PATH_MAX] u8; cp_b: [FS_PATH_MAX] u8; lp_b: [FS_PATH_MAX] u8; dd_b: [FS_PATH_MAX] u8;
  hc_dir := fs_join(home, ".openagents/gbench/hillclimb", hd_b[..]);
  _ = fs_mkdir_all(hc_dir);
  champ_path := fs_join(hc_dir, "champion.json", cp_b[..]);
  ledger_path := fs_join(hc_dir, "ledger.jsonl", lp_b[..]);
  distill_dir := fs_join(home, ".openagents/gbench/distill", dd_b[..]);

  round_num := ifx round_ov > 0 then round_ov else gbc_count_ledger_rounds(ledger_path) + 1;

  w: [1] GbRunWork;
  // Resolve champion: explicit --champion -> existing champion.json -> baseline inkling-2-mini
  if champ_spec.count > 0 {
    if !gbr_resolve_policy(env[..], champ_spec, th_def, eff_a, mot, w[0].pol_a[..]) {
      tool_errln("gbench-run hillclimb: invalid --champion");
      return 2;
    }
  } else if fs_kind(champ_path) == FS_FILE {
    cbuf: [16384] u8;
    cn := fs_read(champ_path, cbuf[..]);
    if cn <= 0 || !gbw_policy_parse(cast(string) cbuf[0..<cn], w[0].pol_a[..]) {
      _ = gbr_resolve_policy(env[..], "inkling-2-mini", ifx th_def == 1 then 1 else 0, ifx eff_a.count > 0 then eff_a else "0.7", mot, w[0].pol_a[..]);
    } else {
      if th_def == 1 { w[0].pol_a[0].thinking = true; }
      if eff_a.count > 0 { w[0].pol_a[0].effort_n = gbw_put(w[0].pol_a[0].effort[..], eff_a); }
      if mot > 0 && args_value(a, "--max-output-tokens", "").count > 0 { w[0].pol_a[0].max_output_tokens = mot; }
      gbw_policy_hash(w[0].pol_a[..]);
    }
  } else {
    _ = gbr_resolve_policy(env[..], "inkling-2-mini", ifx th_def == 1 then 1 else 0, ifx eff_a.count > 0 then eff_a else "0.7", mot, w[0].pol_a[..]);
    pbuf: [4096] u8;
    pn := gbw_policy_write(w[0].pol_a[..], pbuf[..]);
    if pn > 0 { _ = fs_write(champ_path, cast(string) pbuf[0..<pn]); }
  }

  note_b: [160] u8;
  note_n := 0;
  if propose {
    note_n = gb_propose_challenger(w[0].pol_a[..], round_num, w[0].pol_b[..], note_b[..]);
  } else {
    if !gbr_resolve_policy(env[..], cand_spec, ifx w[0].pol_a[0].thinking then 1 else 0, eff_b, w[0].pol_a[0].max_output_tokens, w[0].pol_b[..]) {
      tool_errln("gbench-run hillclimb: invalid --challenger");
      return 2;
    }
    note_n = gbw_put(note_b[..], "explicit challenger policy");
  }

  rid_b: [64] u8;
  run_id := gbr_make_run_id("gb-hc", rid_b[..]);
  rd1: [FS_PATH_MAX] u8; rd2: [FS_PATH_MAX] u8;
  runs_root := fs_join(home, ".openagents/gbench/runs", rd1[..]);
  run_dir := fs_join(runs_root, run_id, rd2[..]);

  if !gbr_run_compare(env[..], w[..], run_id, run_dir, profile, evals_csv, limit_n, allow_exec, "", "", "") {
    tool_errln("gbench-run hillclimb: two-arm evaluation failed");
    return 1;
  }

  sa := w[0].sum_a[0];
  sb := w[0].sum_b[0];
  sc_a := cast(string) sa.scaffold_id[0..<sa.scaffold_id_n];
  sc_b := cast(string) sb.scaffold_id[0..<sb.scaffold_id_n];
  golden_reg := (sa.golden_applicable > 0 && sb.golden_passed < sa.golden_passed) || sb.token_leaks > 0;

  gate := gb_admit_hillclimb(GbHillclimbEval.{
    scaffolds_match = gb_scaffolds_match(sc_a, sc_b),
    atif_verified = sb.atif_all_verified,
    golden_regressed = golden_reg,
    cand_harness_errors = sb.infra_errors,
    graded_total = sb.graded,
    champ_score_bps = sa.score_bps,
    cand_score_bps = sb.score_bps,
    champ_ttft_us = sa.ttft_p50_us,
    cand_ttft_us = sb.ttft_p50_us,
    champ_tpot_us = sa.tpot_p50_us,
    cand_tpot_us = sb.tpot_p50_us,
    cand_cv_bps = sb.cv_bps,
    max_cv_bps = 1000,
    cand_cost_micros = 0,
    max_cost_micros = 0,
  });

  // License-gated & Ch 247 redacted distillation of passing challenger trajectories
  distilled := gb_distill_atif(w[0].rows_b[..], w[0].n_b, distill_dir, run_id);

  // Promote champion.json ONLY when #authority gate == GB_GATE_PROMOTED
  if gate == GB_GATE_PROMOTED {
    pbuf: [4096] u8;
    pn := gbw_policy_write(w[0].pol_b[..], pbuf[..]);
    if pn > 0 { _ = fs_write(champ_path, cast(string) pbuf[0..<pn]); }
  }

  // Append round to immutable ledger.jsonl
  ts_b: [40] u8;
  ts := gbr_iso_now(ts_b[..]);
  hc: [1] GbHillclimbRound;
  hc[0].round_num = round_num;
  hc[0].timestamp_n = gbw_put(hc[0].timestamp[..], ts);
  hc[0].profile_n = gbw_put(hc[0].profile[..], profile);
  hc[0].champion_id_n = gbw_put(hc[0].champion_id[..], cast(string) w[0].pol_a[0].id[0..<w[0].pol_a[0].id_n]);
  hc[0].champion_sha_n = gbw_put(hc[0].champion_sha[..], cast(string) w[0].pol_a[0].manifest_sha[0..<w[0].pol_a[0].manifest_sha_n]);
  hc[0].challenger_id_n = gbw_put(hc[0].challenger_id[..], cast(string) w[0].pol_b[0].id[0..<w[0].pol_b[0].id_n]);
  hc[0].challenger_sha_n = gbw_put(hc[0].challenger_sha[..], cast(string) w[0].pol_b[0].manifest_sha[0..<w[0].pol_b[0].manifest_sha_n]);
  hc[0].mutation_note_n = gbw_put(hc[0].mutation_note[..], cast(string) note_b[0..<note_n]);
  hc[0].scaffold_id_n = gbw_put(hc[0].scaffold_id[..], sc_b);
  hc[0].graded_total = sb.graded;
  hc[0].champ_score_bps = sa.score_bps;
  hc[0].cand_score_bps = sb.score_bps;
  hc[0].champ_ttft_us = sa.ttft_p50_us;
  hc[0].cand_ttft_us = sb.ttft_p50_us;
  hc[0].champ_tpot_us = sa.tpot_p50_us;
  hc[0].cand_tpot_us = sb.tpot_p50_us;
  hc[0].cand_harness_errors = sb.infra_errors;
  hc[0].gate_code = gate;
  hc[0].distilled_atif = distilled;
  hc[0].run_dir_n = gbw_put(hc[0].run_dir[..], run_dir);

  lbuf: [4096] u8;
  ln := gbw_hillclimb_write(hc[..], lbuf[..]);
  if ln > 0 && ln + 1 < lbuf.count {
    lbuf[ln] = 10;
    _ = fs_append(ledger_path, cast(string) lbuf[0..<ln + 1]);
  }

  print("gBench Hillclimb Round %: % (%)\n", round_num, gb_gate_status(gate), gb_gate_reason(gate));
  print("  Champion  (%): % bps (TPOT %us, TTFT %us)\n", cast(string) hc[0].champion_id[0..<hc[0].champion_id_n], sa.score_bps, sa.tpot_p50_us, sa.ttft_p50_us);
  print("  Challenger(%): % bps (TPOT %us, TTFT %us)\n", cast(string) hc[0].challenger_id[0..<hc[0].challenger_id_n], sb.score_bps, sb.tpot_p50_us, sb.ttft_p50_us);
  print("  Distilled ATIF (license-gated): % · Ledger: %\n", distilled, ledger_path);
  return 0;
}

gbc_cmd_status :: (a: [] Args) -> int #effects(all) {
  env: [1] GbEnv;
  gbr_discover(env[..]);
  home := cast(string) env[0].home[0..<env[0].home_n];
  p1: [FS_PATH_MAX] u8; p2: [FS_PATH_MAX] u8;
  last_path := fs_join(home, ".openagents/gym/last-gbench.json", p1[..]);
  led_path := fs_join(home, ".openagents/gbench/hillclimb/ledger.jsonl", p2[..]);
  has_last := fs_kind(last_path) == FS_FILE;
  rounds := gbc_count_ledger_rounds(led_path);
  if args_has(a, "--json") {
    buf: [2048] u8;
    o: [1] Jo; jo_start(o[..], buf[..]);
    jo_obj(o[..]);
    jo_key(o[..], "has_last_compare"); jo_bool(o[..], has_last);
    jo_key(o[..], "last_compare_path"); jo_str(o[..], last_path);
    jo_key(o[..], "hillclimb_rounds"); jo_int(o[..], rounds);
    jo_key(o[..], "ledger_path"); jo_str(o[..], led_path);
    jo_end(o[..]);
    print("%\n", jo_text(o[..]));
    return 0;
  }
  print("gBench Status: last-gbench.json=% · hillclimb rounds=%\n",
    ifx has_last then "present" else "none", rounds);
  return 0;
}

gbc_cmd_stop :: () -> int #effects(all) {
  env: [1] GbEnv;
  gbr_discover(env[..]);
  home := cast(string) env[0].home[0..<env[0].home_n];
  p1: [FS_PATH_MAX] u8;
  ppath := fs_join(home, ".openagents/gbench/active.pid", p1[..]);
  pb: [64] u8;
  pn := fs_read(ppath, pb[..]);
  if pn > 0 {
    pid_s := gbr_trim(cast(string) pb[0..<pn]);
    if pid_s.count > 0 {
      argv := [3] string.["/bin/kill", "-TERM", pid_s];
      ob: [64] u8; eb: [64] u8;
      _ = proc_run(argv[..], 2000, ob[..], eb[..]);
    }
    _ = fs_remove(ppath);
  }
  print("gBench active server stop signaled.\n");
  return 0;
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  _ = args_load(a[..]);
  verb := args_at(a[..], 0);
  if verb.count == 0 || verb == "--help" || verb == "-h" || verb == "help" {
    return gbc_usage();
  }
  if verb == "doctor" { return gbc_cmd_doctor(a[..]); }
  if verb == "suites" || verb == "profiles" { return gbc_cmd_suites(a[..]); }
  if verb == "variants" { return gbc_cmd_variants(a[..]); }
  if verb == "compare" || verb == "run" { return gbc_cmd_compare(a[..], "oa-template-smoke"); }
  if verb == "golden" { return gbc_cmd_compare(a[..], "oa-template-smoke"); }
  if verb == "perf" { return gbc_cmd_compare(a[..], "oa-perf-quick"); }
  if verb == "eval" { return gbc_cmd_compare(a[..], "oa-local-fast"); }
  if verb == "hillclimb" { return gbc_cmd_hillclimb(a[..]); }
  if verb == "status" { return gbc_cmd_status(a[..]); }
  if verb == "stop" { return gbc_cmd_stop(); }
  tool_err("gbench-run: unknown verb: "); tool_errln(verb);
  return 2;
}
