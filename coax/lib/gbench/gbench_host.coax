// OS / Subprocess Host Orchestration for gbench-run (discovery, server lifecycle, gbench exec).
// Pure data shapes, policy gates, and parsing helpers live in coax/lib/gbench/runner.coax.
#load "runner.coax";

gbr_iso_now :: (out: [] u8) -> string #effects(all) {
  argv := [3] string.["/bin/date", "-u", "+%Y-%m-%dT%H:%M:%SZ"];
  ob: [64] u8; eb: [64] u8;
  r := proc_run(argv[..], 3000, ob[..], eb[..]);
  if r.started == 0 && r.status == 0 && r.out_n > 0 {
    t := gbr_trim(cast(string) ob[0..<r.out_n]);
    if t.count >= 19 {
      n := gbw_put(out, t);
      return cast(string) out[0..<n];
    }
  }
  n := gbw_put(out, "2026-11-24T00:00:00Z");
  return cast(string) out[0..<n];
}

gbr_make_run_id :: (pfx: string, out: [] u8) -> string #effects(all) {
  argv := [3] string.["/bin/date", "-u", "+%Y%m%d-%H%M%S"];
  ob: [64] u8; eb: [64] u8;
  r := proc_run(argv[..], 3000, ob[..], eb[..]);
  n := gbr_cat(out, 0, pfx);
  n = gbr_cat(out, n, "-");
  if r.started == 0 && r.status == 0 && r.out_n > 0 {
    n = gbr_cat(out, n, gbr_trim(cast(string) ob[0..<r.out_n]));
  } else {
    tb: [32] u8;
    n = gbr_cat(out, n, gbr_int_str(proc_now_ms(), tb[..]));
  }
  return cast(string) out[0..<n];
}

// Discover host gBench venv, Psionic Metal, llama-server, Inkling HF tokenizer, bwrap, Docker, and installed variants.
gbr_discover :: (e: [] GbEnv) #effects(all) {
  e[0] = GbEnv.{};
  hb: [512] u8;
  hs := proc_getenv("HOME", hb[..]);
  e[0].home_n = gbw_put(e[0].home[..], hs);
  home := cast(string) e[0].home[0..<e[0].home_n];

  sn := cxproc_self_path(e[0].self_path[..]);
  if sn > 0 {
    e[0].self_path_n = sn;
    sd := fs_dir(cast(string) e[0].self_path[0..<sn]);
    e[0].self_dir_n = gbw_put(e[0].self_dir[..], sd);
  }
  cb: [1024] u8;
  cs := fs_cwd(cb[..]);
  e[0].cwd_n = gbw_put(e[0].cwd[..], cs);

  self_dir := cast(string) e[0].self_dir[0..<e[0].self_dir_n];
  cwd := cast(string) e[0].cwd[0..<e[0].cwd_n];

  // 1. Managed gbench venv (~/.openagents/gbench/venv)
  {
    p0: [FS_PATH_MAX] u8; p1: [FS_PATH_MAX] u8;
    py := fs_join(home, ".openagents/gbench/venv/bin/python", p0[..]);
    gb := fs_join(home, ".openagents/gbench/venv/bin/gbench", p1[..]);
    e[0].venv_py_n = gbw_put(e[0].venv_py[..], py);
    e[0].gbench_bin_n = gbw_put(e[0].gbench_bin[..], gb);
    if fs_kind(py) == FS_FILE && fs_kind(gb) == FS_FILE {
      ob: [256] u8; eb: [256] u8;
      av1 := [2] string.[gb, "--version"];
      r1 := proc_run(av1[..], 8000, ob[..], eb[..]);
      if r1.started == 0 && r1.status == 0 {
        e[0].venv_ok = true;
        ver := gbr_trim(cast(string) ob[0..<r1.out_n]);
        if gbr_starts(ver, "gbench ") { ver = ver[7..<ver.count]; }
        e[0].gbench_ver_n = gbw_put(e[0].gbench_ver[..], ver);
      }
      av2 := [2] string.[py, "--version"];
      r2 := proc_run(av2[..], 5000, ob[..], eb[..]);
      if r2.started == 0 && r2.status == 0 {
        pv := gbr_trim(cast(string) ob[0..<r2.out_n]);
        if gbr_starts(pv, "Python ") { pv = pv[7..<pv.count]; }
        e[0].python_ver_n = gbw_put(e[0].python_ver[..], pv);
      }
    }
  }

  // 2. Psionic Metal (prefer sibling beside self -> cwd psionic/build -> ~/.openagents/bin -> OpenAgents.app)
  {
    b0: [FS_PATH_MAX] u8; m0: [FS_PATH_MAX] u8;
    b1: [FS_PATH_MAX] u8; m1: [FS_PATH_MAX] u8;
    b2: [FS_PATH_MAX] u8; m2: [FS_PATH_MAX] u8;
    ps_b := ifx self_dir.count > 0 then fs_join(self_dir, "psionic-inkling-serve", b1[..]) else "";
    ps_m := ifx self_dir.count > 0 then fs_join(self_dir, "inkling-kernels.metal", m1[..]) else "";
    pc_b := ifx cwd.count > 0 then fs_join(cwd, "psionic/build/psionic-inkling-serve", b0[..]) else "";
    pc_m := ifx cwd.count > 0 then fs_join(cwd, "psionic/build/inkling-kernels.metal", m0[..]) else "";
    ph_b := fs_join(home, ".openagents/bin/psionic-inkling-serve", b2[..]);
    ph_m := fs_join(home, ".openagents/bin/inkling-kernels.metal", m2[..]);
    pa_b := "/Applications/OpenAgents.app/Contents/Resources/psionic-inkling-serve";
    pa_m := "/Applications/OpenAgents.app/Contents/Resources/inkling-kernels.metal";
    if ps_b.count > 0 && fs_kind(ps_b) == FS_FILE && fs_kind(ps_m) == FS_FILE {
      e[0].psionic_bin_n = gbw_put(e[0].psionic_bin[..], ps_b);
      e[0].psionic_metal_n = gbw_put(e[0].psionic_metal[..], ps_m);
      e[0].psionic_ok = true;
    } else if pc_b.count > 0 && fs_kind(pc_b) == FS_FILE && fs_kind(pc_m) == FS_FILE {
      e[0].psionic_bin_n = gbw_put(e[0].psionic_bin[..], pc_b);
      e[0].psionic_metal_n = gbw_put(e[0].psionic_metal[..], pc_m);
      e[0].psionic_ok = true;
    } else if fs_kind(ph_b) == FS_FILE && fs_kind(ph_m) == FS_FILE {
      e[0].psionic_bin_n = gbw_put(e[0].psionic_bin[..], ph_b);
      e[0].psionic_metal_n = gbw_put(e[0].psionic_metal[..], ph_m);
      e[0].psionic_ok = true;
    } else if fs_kind(pa_b) == FS_FILE && fs_kind(pa_m) == FS_FILE {
      e[0].psionic_bin_n = gbw_put(e[0].psionic_bin[..], pa_b);
      e[0].psionic_metal_n = gbw_put(e[0].psionic_metal[..], pa_m);
      e[0].psionic_ok = true;
    }
  }

  // 3. llama-server comparator
  {
    l0: [FS_PATH_MAX] u8;
    p0 := fs_join(home, ".openagents/bin/llama-server", l0[..]);
    cands := [3] string.[p0, "/opt/homebrew/bin/llama-server", "/usr/local/bin/llama-server"];
    lf := fs_first_file(cands[..]);
    if lf.count > 0 {
      e[0].llama_bin_n = gbw_put(e[0].llama_bin[..], lf);
      e[0].llama_ok = true;
    }
  }

  // 3b. OpenAgents Core worker binary (OA_WORKER_BIN / FLAWED_WORKER_BIN -> sibling -> hashed tool.sh build -> cwd app -> ~/.openagents/bin -> /Applications)
  {
    f0: [FS_PATH_MAX] u8; f1: [FS_PATH_MAX] u8; f2: [FS_PATH_MAX] u8; f3: [FS_PATH_MAX] u8;
    f_env := proc_getenv("OA_WORKER_BIN", f0[..]);
    if f_env.count == 0 { f_env = proc_getenv("FLAWED_WORKER_BIN", f0[..]); }
    f_sib := ifx self_dir.count > 0 then fs_join(self_dir, "oa-worker", f1[..]) else "";
    f_cwd := ifx cwd.count > 0 then fs_join(cwd, "apps/openagents-desktop/build/OpenAgents.app/Contents/Resources/oa-worker", f2[..]) else "";
    f_hom := fs_join(home, ".openagents/bin/oa-worker", f3[..]);
    f_app := "/Applications/OpenAgents.app/Contents/Resources/oa-worker";
    if f_env.count > 0 && fs_kind(f_env) == FS_FILE {
      e[0].flawed_bin_n = gbw_put(e[0].flawed_bin[..], f_env);
      e[0].flawed_ok = true;
    } else if f_sib.count > 0 && fs_kind(f_sib) == FS_FILE {
      e[0].flawed_bin_n = gbw_put(e[0].flawed_bin[..], f_sib);
      e[0].flawed_ok = true;
    } else {
      // When running via coax/web/tool.sh, pick up sibling coax/web/build/tools/oa-worker-<64hex>
      found_hash := false;
      if self_dir.count > 0 {
        fl: [1] FsList;
        fn := fs_list(self_dir, fl[..]);
        for i: 0..<fn {
          nm := fs_entry(fl[..], i);
          if gbr_starts(nm, "oa-worker-") && nm.count == 74 && !gbr_ends(nm, ".c") && !gbr_ends(nm, ".o") {
            fhb: [FS_PATH_MAX] u8;
            cand := fs_join(self_dir, nm, fhb[..]);
            if fs_kind(cand) == FS_FILE {
              e[0].flawed_bin_n = gbw_put(e[0].flawed_bin[..], cand);
              e[0].flawed_ok = true;
              found_hash = true;
              break;
            }
          }
        }
      }
      if !found_hash {
        cands := [3] string.[f_cwd, f_hom, f_app];
        ff := fs_first_file(cands[..]);
        if ff.count > 0 {
          e[0].flawed_bin_n = gbw_put(e[0].flawed_bin[..], ff);
          e[0].flawed_ok = true;
        }
      }
    }
  }

  // 3c. Cloud Vertex AI / Gemini API credential discovery (for Gemini 4 Neon family & Flawed Cloud)
  {
    v0: [FS_PATH_MAX] u8; v1: [FS_PATH_MAX] u8; v2: [FS_PATH_MAX] u8;
    sa1 := fs_join(home, "work/.secrets/vertex-sa-inference.json", v0[..]);
    sa2 := fs_join(home, ".openagents/coder/vertex-sa.json", v1[..]);
    envf := fs_join(home, ".openagents/coder/antigravity.env", v2[..]);
    e[0].vertex_ok = proc_has_env("GOOGLE_APPLICATION_CREDENTIALS")
      || proc_has_env("GEMINI_API_KEY")
      || proc_has_env("GOOGLE_API_KEY")
      || proc_has_env("OPENROUTER_API_KEY")
      || fs_kind(sa1) == FS_FILE
      || fs_kind(sa2) == FS_FILE
      || fs_kind(envf) == FS_FILE;
  }

  // 4. Inkling offline HuggingFace tokenizer bundle
  {
    td: [FS_PATH_MAX] u8; tj: [FS_PATH_MAX] u8;
    dir := fs_join(home, ".openagents/models/inkling-2-mini/hf-tokenizer", td[..]);
    e[0].tokenizer_dir_n = gbw_put(e[0].tokenizer_dir[..], dir);
    tok_f := fs_join(dir, "tokenizer.json", tj[..]);
    e[0].tokenizer_ok = fs_kind(tok_f) == FS_FILE;
  }

  // 5. Installed Inkling, Neon, and Flawed Harness variants
  {
    mr: [FS_PATH_MAX] u8;
    mroot := fs_join(home, ".openagents/models", mr[..]);
    for vid: 0..<GB_VAR_COUNT {
      v := gb_variant_info(vid);
      ok := false;
      if gb_variant_is_cloud(v.backend) {
        ok = e[0].flawed_ok && e[0].vertex_ok;
      } else {
        gp: [FS_PATH_MAX] u8;
        gpath := fs_join(mroot, v.rel_gguf, gp[..]);
        ok = fs_kind(gpath) == FS_FILE;
        if ok && v.rel_lora.count > 0 {
          lp: [FS_PATH_MAX] u8;
          lpath := fs_join(mroot, v.rel_lora, lp[..]);
          ok = fs_kind(lpath) == FS_FILE;
        }
        if v.backend == "psionic-metal" { ok = ok && e[0].psionic_ok; }
        else if v.backend == "llamacpp-metal" { ok = ok && e[0].llama_ok; }
        else if v.backend == "flawed-local" { ok = ok && e[0].flawed_ok && e[0].psionic_ok; }
      }
      e[0].variant_ready[vid] = ok;
      if ok && v.backend == "psionic-metal" { e[0].variants_installed += 1; }
    }
  }

  // 6. Optional Linux bwrap, Docker, API keys
  {
    ob: [128] u8; eb: [128] u8;
    av_bw := [2] string.["bwrap", "--version"];
    rbw := proc_run(av_bw[..], 2000, ob[..], eb[..]);
    e[0].bwrap_ok = rbw.started == 0 && rbw.status == 0;
    av_dk := [2] string.["docker", "info"];
    rdk := proc_run(av_dk[..], 3000, ob[..], eb[..]);
    e[0].docker_ok = rdk.started == 0 && rdk.status == 0;
  }
  e[0].gemini_key_set = proc_has_env("GEMINI_API_KEY");
  e[0].hf_token_set = proc_has_env("HF_TOKEN");
}

gbr_doctor_to_wire :: (e: [] GbEnv, out: [] GbDoctor) #effects(all) {
  out[0] = GbDoctor.{
    ok = gbr_doctor_ok(e[0].venv_ok, e[0].psionic_ok, e[0].llama_ok, e[0].variants_installed, e[0].flawed_ok, e[0].vertex_ok),
    venv_ok = e[0].venv_ok,
    psionic_ok = e[0].psionic_ok,
    llama_ok = e[0].llama_ok,
    tokenizer_ok = e[0].tokenizer_ok,
    bwrap_ok = e[0].bwrap_ok,
    docker_ok = e[0].docker_ok,
    gemini_key_set = e[0].gemini_key_set,
    hf_token_set = e[0].hf_token_set,
    variants_installed = e[0].variants_installed,
  };
  out[0].gbench_version_n = gbw_put(out[0].gbench_version[..], cast(string) e[0].gbench_ver[0..<e[0].gbench_ver_n]);
  out[0].python_version_n = gbw_put(out[0].python_version[..], cast(string) e[0].python_ver[0..<e[0].python_ver_n]);
}

// Resolve a policy from a file path, variant slug, or hillclimb preset ID.
gbr_resolve_policy :: (e: [] GbEnv, spec: string, thinking_override: int, effort_override: string, max_out_override: int, out: [] GbPolicy) -> bool #effects(all) {
  buf: [16384] u8;
  if spec.count > 0 && fs_kind(spec) == FS_FILE {
    n := fs_read(spec, buf[..]);
    if n > 0 && gbw_policy_parse(cast(string) buf[0..<n], out) {
      if thinking_override == 1 { out[0].thinking = true; }
      else if thinking_override == 0 { out[0].thinking = false; }
      if effort_override.count > 0 { out[0].effort_n = gbw_put(out[0].effort[..], effort_override); }
      if max_out_override > 0 { out[0].max_output_tokens = max_out_override; }
      gbw_policy_hash(out);
      return true;
    }
  }
  out[0] = GbPolicy.{};
  vid := gb_variant_by_slug(spec);
  if vid >= 0 {
    v := gb_variant_info(vid);
    out[0].id_n = gbw_put(out[0].id[..], v.slug);
    out[0].label_n = gbw_put(out[0].label[..], v.label);
    out[0].variant_n = gbw_put(out[0].variant[..], v.slug);
    out[0].backend_n = gbw_put(out[0].backend[..], v.backend);
    out[0].model_id_n = gbw_put(out[0].model_id[..], v.model_id);
    def_eff := gbr_default_effort(v.backend);
    out[0].effort_n = gbw_put(out[0].effort[..], ifx effort_override.count > 0 then effort_override else def_eff);
    out[0].thinking = thinking_override == 1;
    out[0].temp_milli = -1;
    out[0].max_output_tokens = ifx max_out_override > 0 then max_out_override else 2048;
    out[0].ctx_tokens = gbr_default_ctx_tokens(v.backend);
    out[0].spec_lookup = false;
    if v.rel_lora.count > 0 {
      home := cast(string) e[0].home[0..<e[0].home_n];
      mr: [FS_PATH_MAX] u8; lp: [FS_PATH_MAX] u8;
      mroot := fs_join(home, ".openagents/models", mr[..]);
      lpath := fs_join(mroot, v.rel_lora, lp[..]);
      out[0].lora_path_n = gbw_put(out[0].lora_path[..], lpath);
    }
    gbw_policy_hash(out);
    return true;
  }
  return false;
}

gbr_poll_rss_mb :: (pid: int) -> int #effects(all) {
  if pid <= 0 { return 0; }
  pb: [32] u8;
  argv := [5] string.["/bin/ps", "-o", "rss=", "-p", gbr_int_str(pid, pb[..])];
  ob: [64] u8; eb: [64] u8;
  r := proc_run(argv[..], 3000, ob[..], eb[..]);
  if r.started != 0 || r.status != 0 || r.out_n <= 0 { return 0; }
  kib := gbr_parse_uint(cast(string) ob[0..<r.out_n]);
  return kib / 1024;
}

gbr_wait_health :: (hw: [] HttpWork, port: int, timeout_ms: int) -> bool #effects(all) {
  ub: [128] u8; pb: [16] u8;
  un := gbr_cat(ub[..], 0, "http://127.0.0.1:");
  un = gbr_cat(ub[..], un, gbr_int_str(port, pb[..]));
  un = gbr_cat(ub[..], un, "/health");
  url := cast(string) ub[0..<un];
  body: [2048] u8;
  hdrs: [1] string;
  deadline := proc_now_ms() + timeout_ms;
  while proc_now_ms() < deadline {
    hr := http_do(hw, "GET", url, hdrs[0..<0], "", 1000, 0, body[..]);
    if hr.error == HTTP_OK && hr.code == 200 { return true; }
    proc_sleep(150);
  }
  return false;
}

gbr_live_emit :: (e: [] GbEnv, kind: string, side: string, arm_id: string, item_id: string, idx: int, total: int, status: string, score_bps: int, wall_ms: int, note: string) #effects(all) {
  home := cast(string) e[0].home[0..<e[0].home_n];
  if home.count == 0 { return; }
  dp: [FS_PATH_MAX] u8; fp: [FS_PATH_MAX] u8;
  gdir := fs_join(home, ".openagents/gbench", dp[..]);
  _ = fs_mkdir_all(gdir);
  lpath := fs_join(gdir, "live-status.jsonl", fp[..]);
  buf: [2048] u8;
  o: [1] Jo; jo_start(o[..], buf[..]);
  jo_obj(o[..]);
  jo_key(o[..], "kind"); jo_str(o[..], kind);
  jo_key(o[..], "side"); jo_str(o[..], side);
  jo_key(o[..], "arm_id"); jo_str(o[..], arm_id);
  jo_key(o[..], "item_id"); jo_str(o[..], item_id);
  jo_key(o[..], "idx"); jo_int(o[..], idx);
  jo_key(o[..], "total"); jo_int(o[..], total);
  jo_key(o[..], "status"); jo_str(o[..], status);
  jo_key(o[..], "score_bps"); jo_int(o[..], score_bps);
  jo_key(o[..], "wall_ms"); jo_int(o[..], wall_ms);
  jo_key(o[..], "note"); jo_str(o[..], note);
  jo_end(o[..]);
  if !o[0].bad && o[0].n + 1 < buf.count {
    buf[o[0].n] = 10;
    _ = fs_append(lpath, cast(string) buf[0..<o[0].n + 1]);
  }
}

gbr_write_pid :: (e: [] GbEnv, pid: int) #effects(all) {
  home := cast(string) e[0].home[0..<e[0].home_n];
  if home.count == 0 { return; }
  dp: [FS_PATH_MAX] u8; fp: [FS_PATH_MAX] u8; pb: [32] u8;
  gdir := fs_join(home, ".openagents/gbench", dp[..]);
  _ = fs_mkdir_all(gdir);
  ppath := fs_join(gdir, "active.pid", fp[..]);
  if pid <= 0 {
    _ = fs_remove(ppath);
  } else {
    _ = fs_write(ppath, gbr_int_str(pid, pb[..]));
  }
}

// Start the local inference server or Flawed Agent bridge for one arm and return endpoint length in `endpoint_out`.
gbr_server_start :: (
  e: [] GbEnv,
  hw: [] HttpWork,
  pol: [] GbPolicy,
  port: int,
  custom_endpoint: string,
  handle_out: [] int,
  aux_handle_out: [] int,
  boot_ms_out: [] int,
  rss_mb_out: [] int,
  endpoint_out: [] u8
) -> int #effects(all) {
  handle_out[0] = -1;
  aux_handle_out[0] = -1;
  boot_ms_out[0] = 0;
  rss_mb_out[0] = 0;

  if custom_endpoint.count > 0 {
    return gbw_put(endpoint_out, custom_endpoint);
  }
  backend := cast(string) pol[0].backend[0..<pol[0].backend_n];
  var_slug := cast(string) pol[0].variant[0..<pol[0].variant_n];
  vid := gb_variant_by_slug(var_slug);
  if vid < 0 { return -1; }
  v := gb_variant_info(vid);
  is_cloud := gb_variant_is_cloud(backend);

  home := cast(string) e[0].home[0..<e[0].home_n];
  mr: [FS_PATH_MAX] u8; gp: [FS_PATH_MAX] u8; lp: [FS_PATH_MAX] u8;
  mroot := fs_join(home, ".openagents/models", mr[..]);
  gpath := "";
  lpath := "";
  if !is_cloud {
    gpath = fs_join(mroot, v.rel_gguf, gp[..]);
    if fs_kind(gpath) != FS_FILE { return -1; }
    if pol[0].lora_path_n > 0 {
      lpath = cast(string) pol[0].lora_path[0..<pol[0].lora_path_n];
    } else if v.rel_lora.count > 0 {
      lpath = fs_join(mroot, v.rel_lora, lp[..]);
    }
    if lpath.count > 0 && fs_kind(lpath) != FS_FILE { return -1; }
  }

  ps_b: [16] u8; cs_b: [16] u8;
  port_s := gbr_int_str(port, ps_b[..]);
  ctx_s := gbr_int_str(ifx pol[0].ctx_tokens > 0 then pol[0].ctx_tokens else 32768, cs_b[..]);
  mid_s := cast(string) pol[0].model_id[0..<pol[0].model_id_n];
  upstream_s := gb_variant_upstream_model(vid);
  eff_s := cast(string) pol[0].effort[0..<pol[0].effort_n];
  think_s := ifx pol[0].thinking then "1" else "0";

  t0 := proc_now_ms();
  h_aux := -1;

  // For flawed-local: boot upstream psionic-inkling-serve on port+1 first, then wrap with flawedworker --serve --mode harness on port.
  if backend == "flawed-local" {
    if !e[0].flawed_ok || !e[0].psionic_ok { return -1; }
    aux_port := port + 1;
    aps_b: [16] u8;
    aux_port_s := gbr_int_str(aux_port, aps_b[..]);
    h_aux = proc_new();
    if h_aux < 0 { return -1; }
    aok := proc_arg(h_aux, cast(string) e[0].psionic_bin[0..<e[0].psionic_bin_n])
      && proc_arg(h_aux, "--model") && proc_arg(h_aux, gpath)
      && proc_arg(h_aux, "--kernels") && proc_arg(h_aux, cast(string) e[0].psionic_metal[0..<e[0].psionic_metal_n])
      && proc_arg(h_aux, "--model-id") && proc_arg(h_aux, upstream_s)
      && proc_arg(h_aux, "--port") && proc_arg(h_aux, aux_port_s)
      && proc_arg(h_aux, "--ctx") && proc_arg(h_aux, ctx_s);
    if aok && lpath.count > 0 {
      aok = proc_arg(h_aux, "--lora") && proc_arg(h_aux, lpath);
    }
    if aok && eff_s.count > 0 {
      ev: [64] u8; en := gbr_cat(ev[..], 0, "INK_DEFAULT_EFFORT=");
      en = gbr_cat(ev[..], en, eff_s);
      _ = proc_env(h_aux, cast(string) ev[0..<en]);
    }
    if aok && pol[0].spec_lookup {
      _ = proc_env(h_aux, "INK_SPEC_LOOKUP=1");
    }
    _ = proc_quiet(h_aux);
    _ = proc_gentle(h_aux);
    if !aok || proc_start(h_aux) != 0 {
      _ = proc_release(h_aux);
      return -1;
    }
    if !gbr_wait_health(hw, aux_port, 90000) {
      _ = proc_kill(h_aux, PROC_SIGTERM);
      if proc_wait(h_aux, 3000) < 0 { _ = proc_kill(h_aux, PROC_SIGKILL); _ = proc_wait(h_aux, 2000); }
      _ = proc_release(h_aux);
      return -1;
    }
    rss_mb_out[0] = gbr_poll_rss_mb(proc_pid(h_aux));
  }

  h := proc_new();
  if h < 0 {
    if h_aux >= 0 { gbr_server_stop(e, h_aux, -1, rss_mb_out); }
    return -1;
  }
  ok := false;
  if backend == "psionic-metal" {
    if !e[0].psionic_ok { _ = proc_release(h); return -1; }
    ok = proc_arg(h, cast(string) e[0].psionic_bin[0..<e[0].psionic_bin_n])
      && proc_arg(h, "--model") && proc_arg(h, gpath)
      && proc_arg(h, "--kernels") && proc_arg(h, cast(string) e[0].psionic_metal[0..<e[0].psionic_metal_n])
      && proc_arg(h, "--model-id") && proc_arg(h, mid_s)
      && proc_arg(h, "--port") && proc_arg(h, port_s)
      && proc_arg(h, "--ctx") && proc_arg(h, ctx_s);
    if ok && lpath.count > 0 {
      ok = proc_arg(h, "--lora") && proc_arg(h, lpath);
    }
    if ok && eff_s.count > 0 {
      ev: [64] u8; en := gbr_cat(ev[..], 0, "INK_DEFAULT_EFFORT=");
      en = gbr_cat(ev[..], en, eff_s);
      _ = proc_env(h, cast(string) ev[0..<en]);
    }
    if ok && pol[0].spec_lookup {
      _ = proc_env(h, "INK_SPEC_LOOKUP=1");
    }
  } else if backend == "llamacpp-metal" {
    if !e[0].llama_ok { _ = proc_release(h); return -1; }
    ok = proc_arg(h, cast(string) e[0].llama_bin[0..<e[0].llama_bin_n])
      && proc_arg(h, "-m") && proc_arg(h, gpath)
      && proc_arg(h, "--alias") && proc_arg(h, mid_s)
      && proc_arg(h, "--host") && proc_arg(h, "127.0.0.1")
      && proc_arg(h, "--port") && proc_arg(h, port_s)
      && proc_arg(h, "-c") && proc_arg(h, ctx_s)
      && proc_arg(h, "-ngl") && proc_arg(h, "99")
      && proc_arg(h, "--jinja");
    if ok && lpath.count > 0 {
      ok = proc_arg(h, "--lora") && proc_arg(h, lpath);
    }
  } else if backend == "vertex-bridge" || backend == "flawed-cloud" || backend == "flawed-local" {
    if !e[0].flawed_ok {
      _ = proc_release(h);
      if h_aux >= 0 { gbr_server_stop(e, h_aux, -1, rss_mb_out); }
      return -1;
    }
    mode_s := ifx backend == "vertex-bridge" then "raw" else "harness";
    ok = proc_arg(h, cast(string) e[0].flawed_bin[0..<e[0].flawed_bin_n])
      && proc_arg(h, "--serve")
      && proc_arg(h, "--port") && proc_arg(h, port_s)
      && proc_arg(h, "--model") && proc_arg(h, mid_s)
      && proc_arg(h, "--upstream-model") && proc_arg(h, upstream_s)
      && proc_arg(h, "--mode") && proc_arg(h, mode_s)
      && proc_arg(h, "--thinking") && proc_arg(h, think_s);
    if ok && eff_s.count > 0 {
      ok = proc_arg(h, "--effort") && proc_arg(h, eff_s);
    }
    if ok {
      _ = proc_env(h, "FLAWED_PERMISSION_MODE=allow_all");
      if backend == "flawed-local" {
        _ = proc_env(h, "FLAWED_BACKEND=local");
        bu: [128] u8; aps_b: [16] u8;
        bn := gbr_cat(bu[..], 0, "PSIONIC_BASE_URL=http://127.0.0.1:");
        bn = gbr_cat(bu[..], bn, gbr_int_str(port + 1, aps_b[..]));
        _ = proc_env(h, cast(string) bu[0..<bn]);
        bm: [128] u8;
        mn := gbr_cat(bm[..], 0, "PSIONIC_MODEL=");
        mn = gbr_cat(bm[..], mn, upstream_s);
        _ = proc_env(h, cast(string) bm[0..<mn]);
        bc: [64] u8;
        cn := gbr_cat(bc[..], 0, "PSIONIC_CTX=");
        cn = gbr_cat(bc[..], cn, ctx_s);
        _ = proc_env(h, cast(string) bc[0..<cn]);
      } else {
        _ = proc_env(h, "FLAWED_BACKEND=auto");
      }
    }
  } else {
    _ = proc_release(h);
    if h_aux >= 0 { gbr_server_stop(e, h_aux, -1, rss_mb_out); }
    return -1;
  }

  _ = proc_quiet(h);
  _ = proc_gentle(h);
  if !ok || proc_start(h) != 0 {
    _ = proc_release(h);
    if h_aux >= 0 { gbr_server_stop(e, h_aux, -1, rss_mb_out); }
    return -1;
  }
  pid := proc_pid(h);
  gbr_write_pid(e, pid);

  if !gbr_wait_health(hw, port, 90000) {
    _ = proc_kill(h, PROC_SIGTERM);
    if proc_wait(h, 3000) < 0 { _ = proc_kill(h, PROC_SIGKILL); _ = proc_wait(h, 2000); }
    _ = proc_release(h);
    if h_aux >= 0 { gbr_server_stop(e, h_aux, -1, rss_mb_out); }
    gbr_write_pid(e, 0);
    return -1;
  }
  boot_ms_out[0] = proc_now_ms() - t0;
  prss := gbr_poll_rss_mb(pid);
  if prss > rss_mb_out[0] { rss_mb_out[0] = prss; }
  handle_out[0] = h;
  aux_handle_out[0] = h_aux;

  un := gbr_cat(endpoint_out, 0, "http://127.0.0.1:");
  un = gbr_cat(endpoint_out, un, port_s);
  un = gbr_cat(endpoint_out, un, "/v1");
  return un;
}

gbr_server_stop :: (e: [] GbEnv, h: int, aux_h: int, rss_out: [] int) #effects(all) {
  if h >= 0 {
    pid := proc_pid(h);
    if pid > 0 {
      rss := gbr_poll_rss_mb(pid);
      if rss > rss_out[0] { rss_out[0] = rss; }
    }
    _ = proc_kill(h, PROC_SIGTERM);
    if proc_wait(h, 3000) < 0 { _ = proc_kill(h, PROC_SIGKILL); _ = proc_wait(h, 2000); }
    _ = proc_release(h);
  }
  if aux_h >= 0 {
    apid := proc_pid(aux_h);
    if apid > 0 {
      arss := gbr_poll_rss_mb(apid);
      if arss > rss_out[0] { rss_out[0] = arss; }
    }
    _ = proc_kill(aux_h, PROC_SIGTERM);
    if proc_wait(aux_h, 3000) < 0 { _ = proc_kill(aux_h, PROC_SIGKILL); _ = proc_wait(aux_h, 2000); }
    _ = proc_release(aux_h);
  }
  gbr_write_pid(e, 0);
}

// Find the timestamped child run directory inside `results_root` created by `gbench`.
gbr_find_latest_subdir :: (results_root: string, out: [] u8) -> int #effects(all) {
  fl: [1] FsList;
  n := fs_list(results_root, fl[..]);
  if n <= 0 { return 0; }
  best_i := -1;
  for i: 0..<n {
    nm := fs_entry(fl[..], i);
    if nm.count == 0 || nm[0] == '.' { continue; }
    pb: [FS_PATH_MAX] u8;
    full := fs_join(results_root, nm, pb[..]);
    if fs_kind(full) != FS_DIR { continue; }
    if best_i < 0 || gbr_str_gt(nm, fs_entry(fl[..], best_i)) { best_i = i; }
  }
  if best_i < 0 { return 0; }
  joined := fs_join(results_root, fs_entry(fl[..], best_i), out);
  return joined.count;
}

// Read scaffold_id and subject_id from gBench metadata.json conditions[0].
gbr_read_contract :: (run_subdir: string, work: [] GbRunWork, scaffold_out: [] u8, scaffold_n_out: [] int, subject_out: [] u8, subject_n_out: [] int) #effects(all) {
  scaffold_n_out[0] = 0;
  subject_n_out[0] = 0;
  mp: [FS_PATH_MAX] u8;
  mpath := fs_join(run_subdir, "metadata.json", mp[..]);
  mn := fs_read(mpath, work[0].json_buf[..]);
  if mn <= 0 { return; }
  jd: [1] Jv;
  if !jv_parse(jd[..], cast(string) work[0].json_buf[0..<mn], work[0].nodes[..]) { return; }
  d := jd[0];
  conds := jv_get(d, 0, "conditions");
  if jv_kind(d, conds) != JV_ARRAY || jv_len(d, conds) == 0 { return; }
  c0 := jv_at(d, conds, 0);
  sc := jv_get(d, c0, "scaffold");
  sb := jv_get(d, c0, "subject");
  if jv_kind(d, sc) == JV_OBJECT {
    sn := jv_str(d, jv_get(d, sc, "scaffold_id"), scaffold_out);
    if sn > 0 { scaffold_n_out[0] = sn; }
  }
  if jv_kind(d, sb) == JV_OBJECT {
    un := jv_str(d, jv_get(d, sb, "subject_id"), subject_out);
    if un > 0 { subject_n_out[0] = un; }
  }
}

// Execute gBench for one arm on a profile (golden, perf, or eval) and populate `rows` + `sum_out`.
gbr_run_arm :: (
  e: [] GbEnv,
  work: [] GbRunWork,
  pol: [] GbPolicy,
  side: string,
  run_id: string,
  timestamp: string,
  arm_dir: string,
  prof_id: int,
  custom_evals_csv: string,
  eval_limit: int,
  allow_local_golden_exec: bool,
  port: int,
  custom_endpoint: string,
  rows: [] GbItemRecord,
  n_rows_out: [] int,
  sum_out: [] GbArmSummary
) -> bool #effects(all) {
  n_rows_out[0] = 0;
  if !e[0].venv_ok { return false; }

  _ = fs_mkdir_all(arm_dir);
  res_p: [FS_PATH_MAX] u8; atif_d: [FS_PATH_MAX] u8;
  results_root := fs_join(arm_dir, "gbench-out", res_p[..]);
  atif_dir := fs_join(arm_dir, "atif", atif_d[..]);
  _ = fs_mkdir_all(results_root);
  _ = fs_mkdir_all(atif_dir);

  arm_id := cast(string) pol[0].id[0..<pol[0].id_n];
  mid_s := cast(string) pol[0].model_id[0..<pol[0].model_id_n];
  pinfo := gb_profile_info(prof_id);

  gbr_live_emit(e, "arm_start", side, arm_id, pinfo.slug, 0, pinfo.count, "STARTING", 0, 0, "booting model server");

  sh: [1] int; ah: [1] int; boot_ms: [1] int; rss_mb: [1] int;
  ep_b: [256] u8;
  ep_n := gbr_server_start(e, work[0].hw[..], pol, port, custom_endpoint, sh[..], ah[..], boot_ms[..], rss_mb[..], ep_b[..]);
  if ep_n <= 0 {
    gbr_live_emit(e, "arm_error", side, arm_id, pinfo.slug, 0, pinfo.count, "INFRA_ERROR", 0, 0, "model server failed to start");
    return false;
  }
  endpoint := cast(string) ep_b[0..<ep_n];
  gbr_live_emit(e, "arm_ready", side, arm_id, pinfo.slug, 0, pinfo.count, "RUNNING", 0, boot_ms[0], endpoint);

  // Build out-of-process gbench command
  home := cast(string) e[0].home[0..<e[0].home_n];
  hf_d: [FS_PATH_MAX] u8; tmp_d: [FS_PATH_MAX] u8;
  hf_dir := fs_join(home, ".openagents/gbench/cache/hf", hf_d[..]);
  tmp_dir := fs_join(home, ".openagents/gbench/tmp", tmp_d[..]);
  _ = fs_mkdir_all(hf_dir);
  _ = fs_mkdir_all(tmp_dir);

  gh := proc_new();
  if gh < 0 {
    gbr_server_stop(e, sh[0], ah[0], rss_mb[..]);
    return false;
  }
  ok := proc_arg(gh, cast(string) e[0].gbench_bin[0..<e[0].gbench_bin_n]);
  if pinfo.kind == GB_KIND_GOLDEN {
    ok = ok && proc_arg(gh, "--golden-only")
      && proc_arg(gh, "--eval-concurrency") && proc_arg(gh, "1");
    if pol[0].thinking { ok = ok && proc_arg(gh, "--eval-thinking"); }
    if allow_local_golden_exec && !e[0].bwrap_ok {
      _ = proc_env(gh, "GBENCH_SANDBOX=none");
    }
  } else if pinfo.kind == GB_KIND_PERF {
    if prof_id == GB_PROF_PERF_QUICK {
      ok = ok && proc_arg(gh, "--personal") && proc_arg(gh, "--text-only")
        && proc_arg(gh, "--input-lengths") && proc_arg(gh, "256")
        && proc_arg(gh, "--output-lengths") && proc_arg(gh, "128");
    } else {
      ok = ok && proc_arg(gh, "--serving-only") && proc_arg(gh, "--text-only")
        && proc_arg(gh, "--no-stress-test")
        && proc_arg(gh, "--batch-sizes") && proc_arg(gh, "1")
        && proc_arg(gh, "--campaign") && proc_arg(gh, "agentic")
        && proc_arg(gh, "--num-iterations") && proc_arg(gh, "2")
        && proc_arg(gh, "--warmup-iterations") && proc_arg(gh, "1");
    }
  } else {
    mot_b: [16] u8;
    mot := ifx pol[0].max_output_tokens > 0 then pol[0].max_output_tokens else pinfo.default_max_output_tokens;
    ok = ok && proc_arg(gh, "--evals-only")
      && proc_arg(gh, "--eval-concurrency") && proc_arg(gh, "1")
      && proc_arg(gh, "--max-output-tokens") && proc_arg(gh, gbr_int_str(mot, mot_b[..]))
      && proc_arg(gh, "--evals");
    if custom_evals_csv.count > 0 {
      pos := 0;
      while pos < custom_evals_csv.count {
        end := pos;
        while end < custom_evals_csv.count && custom_evals_csv[end] != ',' { end += 1; }
        tok := gbr_trim(custom_evals_csv[pos..<end]);
        if tok.count > 0 { ok = ok && proc_arg(gh, tok); }
        pos = end + 1;
      }
    } else {
      for i: 0..<pinfo.count {
        ok = ok && proc_arg(gh, gb_profile_item(prof_id, i));
      }
    }
    lim := ifx eval_limit > 0 then eval_limit else pinfo.default_limit;
    if lim > 0 {
      lb: [16] u8;
      ok = ok && proc_arg(gh, "--eval-limit") && proc_arg(gh, gbr_int_str(lim, lb[..]));
    }
    if pol[0].thinking { ok = ok && proc_arg(gh, "--eval-thinking"); }
    if pol[0].temp_milli >= 0 {
      tb: [32] u8;
      whole := pol[0].temp_milli / 1000;
      frac := pol[0].temp_milli % 1000;
      wb: [16] u8; fb: [16] u8;
      tn := gbr_cat(tb[..], 0, gbr_int_str(whole, wb[..]));
      tn = gbr_cat(tb[..], tn, ".");
      if frac < 100 { tn = gbr_cat(tb[..], tn, "0"); }
      if frac < 10 { tn = gbr_cat(tb[..], tn, "0"); }
      tn = gbr_cat(tb[..], tn, gbr_int_str(frac, fb[..]));
      ok = ok && proc_arg(gh, "--temperature") && proc_arg(gh, cast(string) tb[0..<tn]);
    }
  }

  ok = ok && proc_arg(gh, "--remote-endpoint") && proc_arg(gh, endpoint)
    && proc_arg(gh, "--models") && proc_arg(gh, mid_s)
    && proc_arg(gh, "--results-dir") && proc_arg(gh, results_root);
  if e[0].tokenizer_ok {
    ok = ok && proc_arg(gh, "--tokenizer") && proc_arg(gh, cast(string) e[0].tokenizer_dir[0..<e[0].tokenizer_dir_n]);
  }

  // Env isolation for HF cache + tmp
  {
    ehf: [600] u8; n1 := gbr_cat(ehf[..], 0, "HF_HOME="); n1 = gbr_cat(ehf[..], n1, hf_dir);
    _ = proc_env(gh, cast(string) ehf[0..<n1]);
    etm: [600] u8; n2 := gbr_cat(etm[..], 0, "TMPDIR="); n2 = gbr_cat(etm[..], n2, tmp_dir);
    _ = proc_env(gh, cast(string) etm[0..<n2]);
  }

  _ = proc_err_to_out(gh);
  _ = proc_gentle(gh);
  log_p: [FS_PATH_MAX] u8;
  log_path := fs_join(arm_dir, "gbench.log", log_p[..]);
  _ = fs_write(log_path, "");

  t_start := proc_now_ms();
  g_exit := GB_EXIT_HARNESS_ERR;
  if ok && proc_start(gh) == 0 {
    // Drain merged stdout+stderr lines into arm_dir/gbench.log while waiting up to 30 minutes
    lb: [2048] u8;
    deadline := proc_now_ms() + 1800000;
    while proc_now_ms() < deadline {
      ln := proc_line(gh, 2000, lb[..]);
      if ln > 0 {
        if ln + 1 <= lb.count {
          lb[ln] = 10;
          _ = fs_append(log_path, cast(string) lb[0..<ln + 1]);
        }
        continue;
      }
      if ln == PROC_TOO_LONG { continue; }
      st := proc_wait(gh, 100);
      if st >= 0 { g_exit = st; break; }
    }
    if g_exit == GB_EXIT_HARNESS_ERR {
      st := proc_wait(gh, 2000);
      if st >= 0 { g_exit = st; }
      else { _ = proc_kill(gh, PROC_SIGKILL); _ = proc_wait(gh, 3000); }
    }
  }
  _ = proc_release(gh);
  wall_ms := proc_now_ms() - t_start;
  gbr_server_stop(e, sh[0], ah[0], rss_mb[..]);

  // Locate gBench timestamped output directory and ingest artifacts
  sub_b: [FS_PATH_MAX] u8;
  sub_n := gbr_find_latest_subdir(results_root, sub_b[..]);
  if sub_n <= 0 {
    gbr_live_emit(e, "arm_error", side, arm_id, pinfo.slug, 0, pinfo.count, "INFRA_ERROR", 0, wall_ms, "no gbench output directory found");
    return false;
  }
  run_sub := cast(string) sub_b[0..<sub_n];

  sc_b: [48] u8; sc_n: [1] int;
  sb_b: [48] u8; sb_n: [1] int;
  gbr_read_contract(run_sub, work, sc_b[..], sc_n[..], sb_b[..], sb_n[..]);
  sc_s := cast(string) sc_b[0..<sc_n[0]];
  sb_s := cast(string) sb_b[0..<sb_n[0]];

  if pinfo.kind == GB_KIND_GOLDEN {
    sp: [FS_PATH_MAX] u8;
    spath := fs_join(run_sub, "summary.json", sp[..]);
    sn := fs_read(spath, work[0].json_buf[..]);
    if sn > 0 {
      jd: [1] Jv;
      if jv_parse(jd[..], cast(string) work[0].json_buf[0..<sn], work[0].nodes[..]) {
        d := jd[0];
        models := jv_get(d, 0, "models");
        if jv_kind(d, models) == JV_ARRAY && jv_len(d, models) > 0 {
          m0 := jv_at(d, models, 0);
          trs := jv_get(d, m0, "task_results");
          nt := jv_len(d, trs);
          for i: 0..<nt {
            if n_rows_out[0] >= GB_MAX_ITEMS { break; }
            tr := jv_at(d, trs, i);
            rec: [1] GbItemRecord;
            rec[0].item_id_n = jv_str(d, jv_get(d, tr, "task_id"), rec[0].item_id[..]);
            if rec[0].item_id_n <= 0 { continue; }
            rec[0].pillar_n = gbw_put(rec[0].pillar[..], "golden");
            cn := jv_str(d, jv_get(d, tr, "category"), rec[0].category[..]);
            rec[0].category_n = ifx cn > 0 then cn else 0;
            rec[0].arm_n = gbw_put(rec[0].arm[..], arm_id);
            stb: [32] u8; stn := jv_str(d, jv_get(d, tr, "status"), stb[..]);
            sts := ifx stn > 0 then cast(string) stb[0..<stn] else "failed";
            if sts == "not_applicable" {
              rec[0].status_code = GB_STATUS_NA;
              rec[0].graded = 0; rec[0].passed_count = 0; rec[0].score_bps = 0;
            } else if sts == "passed" {
              rec[0].status_code = GB_STATUS_PASS;
              rec[0].graded = 1; rec[0].passed_count = 1; rec[0].score_bps = 10000;
            } else if sts == "error" {
              rec[0].status_code = GB_STATUS_INFRA;
              rec[0].graded = 0; rec[0].passed_count = 0; rec[0].harness_errors = 1; rec[0].score_bps = 0;
            } else {
              rec[0].status_code = GB_STATUS_FAIL;
              rec[0].graded = 1; rec[0].passed_count = 0; rec[0].score_bps = 0;
            }
            rec[0].wall_ms = ifx nt > 0 then wall_ms / nt else wall_ms;
            rec[0].scaffold_id_n = gbw_put(rec[0].scaffold_id[..], sc_s);
            rec[0].subject_id_n = gbw_put(rec[0].subject_id[..], sb_s);
            rec[0].leaderboard_comparable = !(allow_local_golden_exec && !e[0].bwrap_ok);
            rec[0].distill_allowed = gb_admit_distill_suite("golden") == GB_DISTILL_ADMIT;
            dtn := jv_str(d, jv_get(d, tr, "details"), rec[0].detail[..]);
            rec[0].detail_n = ifx dtn > 0 then dtn else 0;

            // Export verified ATIF-v1.8 for this golden case
            resp_b: [8192] u8;
            rn := jv_str(d, jv_get(d, tr, "response_text"), resp_b[..]);
            resp_s := ifx rn > 0 then cast(string) resp_b[0..<rn] else cast(string) rec[0].detail[0..<rec[0].detail_n];
            tid_s := cast(string) rec[0].item_id[0..<rec[0].item_id_n];
            afn: [128] u8; afnn := gbr_cat(afn[..], 0, tid_s); afnn = gbr_cat(afn[..], afnn, ".atif.jsonl");
            apb: [FS_PATH_MAX] u8;
            apath := fs_join(atif_dir, cast(string) afn[0..<afnn], apb[..]);
            if gb_atif_write_item(work[0].atif_w[..], apath, run_id, tid_s, mid_s, timestamp, tid_s, resp_s, "", sc_s, rec[0].status_code == GB_STATUS_PASS, rec[0].score_bps, rec[0].atif_digest[..]) {
              rec[0].atif_verified = true;
              rec[0].atif_digest_n = 64;
              rec[0].atif_path_n = gbw_put(rec[0].atif_path[..], apath);
            }
            rows[n_rows_out[0]] = rec[0];
            n_rows_out[0] += 1;
            gbr_live_emit(e, "item_done", side, arm_id, tid_s, n_rows_out[0], nt, gb_status_label(rec[0].status_code), rec[0].score_bps, rec[0].wall_ms, cast(string) rec[0].detail[0..<rec[0].detail_n]);
          }
        }
      }
    }
  } else if pinfo.kind == GB_KIND_PERF {
    sp: [FS_PATH_MAX] u8;
    spath := fs_join(run_sub, "summary.json", sp[..]);
    sn := fs_read(spath, work[0].json_buf[..]);
    if sn > 0 {
      jd: [1] Jv;
      if jv_parse(jd[..], cast(string) work[0].json_buf[0..<sn], work[0].nodes[..]) {
        d := jd[0];
        models := jv_get(d, 0, "models");
        if jv_kind(d, models) == JV_ARRAY && jv_len(d, models) > 0 {
          m0 := jv_at(d, models, 0);
          rec: [1] GbItemRecord;
          iid := ifx prof_id == GB_PROF_PERF_QUICK then "serving_quick" else "serving_agentic";
          rec[0].item_id_n = gbw_put(rec[0].item_id[..], iid);
          rec[0].pillar_n = gbw_put(rec[0].pillar[..], "perf");
          rec[0].category_n = gbw_put(rec[0].category[..], "serving");
          rec[0].arm_n = gbw_put(rec[0].arm[..], arm_id);
          rec[0].ttft_us = gbr_parse_scaled(jv_raw(d, jv_get(d, m0, "ttft_p50_ms")), 3);
          rec[0].tpot_us = gbr_parse_scaled(jv_raw(d, jv_get(d, m0, "tpot_p50_ms")), 3);
          rec[0].itl_p99_us = gbr_parse_scaled(jv_raw(d, jv_get(d, m0, "itl_p99_ms")), 3);
          tps := gbr_parse_scaled(jv_raw(d, jv_get(d, m0, "output_throughput_mean")), 1);
          if tps == 0 && rec[0].tpot_us > 0 { tps = 10000000 / rec[0].tpot_us; }
          rec[0].tok_per_s_x10 = tps;
          rec[0].cv_bps = gbr_parse_scaled(jv_raw(d, jv_get(d, m0, "output_throughput_cv_percent")), 2);
          ttft_n := jv_int(d, jv_get(d, m0, "ttft_n"), 0);
          rec[0].graded = ifx ttft_n > 0 then ttft_n else 1;
          rec[0].passed_count = ifx g_exit == GB_EXIT_OK && ttft_n > 0 then rec[0].graded else 0;
          rec[0].status_code = ifx g_exit == GB_EXIT_OK && ttft_n > 0 then GB_STATUS_PASS else GB_STATUS_FAIL;
          rec[0].score_bps = ifx rec[0].status_code == GB_STATUS_PASS then 10000 else 0;
          rec[0].wall_ms = wall_ms;
          rec[0].scaffold_id_n = gbw_put(rec[0].scaffold_id[..], sc_s);
          rec[0].subject_id_n = gbw_put(rec[0].subject_id[..], sb_s);
          rec[0].leaderboard_comparable = true;
          rec[0].distill_allowed = false;

          dt_b: [160] u8; t1: [16] u8; t2: [16] u8; t3: [16] u8;
          dn := gbr_cat(dt_b[..], 0, "TTFT P50 ");
          dn = gbr_cat(dt_b[..], dn, gbr_int_str(rec[0].ttft_us / 1000, t1[..]));
          dn = gbr_cat(dt_b[..], dn, "ms · TPOT P50 ");
          dn = gbr_cat(dt_b[..], dn, gbr_int_str(rec[0].tpot_us / 1000, t2[..]));
          dn = gbr_cat(dt_b[..], dn, "ms · ");
          dn = gbr_cat(dt_b[..], dn, gbr_int_str(rec[0].tok_per_s_x10 / 10, t3[..]));
          dn = gbr_cat(dt_b[..], dn, " tok/s");
          rec[0].detail_n = gbw_put(rec[0].detail[..], cast(string) dt_b[0..<dn]);

          apb: [FS_PATH_MAX] u8;
          apath := fs_join(atif_dir, "serving_perf.atif.jsonl", apb[..]);
          if gb_atif_write_item(work[0].atif_w[..], apath, run_id, iid, mid_s, timestamp, iid, cast(string) rec[0].detail[0..<rec[0].detail_n], "", sc_s, rec[0].status_code == GB_STATUS_PASS, rec[0].score_bps, rec[0].atif_digest[..]) {
            rec[0].atif_verified = true;
            rec[0].atif_digest_n = 64;
            rec[0].atif_path_n = gbw_put(rec[0].atif_path[..], apath);
          }
          rows[0] = rec[0];
          n_rows_out[0] = 1;
          gbr_live_emit(e, "item_done", side, arm_id, iid, 1, 1, gb_status_label(rec[0].status_code), rec[0].score_bps, wall_ms, cast(string) rec[0].detail[0..<rec[0].detail_n]);
        }
      }
    }
  } else {
    // Eval pillar: scan every eval_*.json file inside run_sub/evals (or run_sub directly)
    ed_b: [FS_PATH_MAX] u8;
    eval_dir := fs_join(run_sub, "evals", ed_b[..]);
    if fs_kind(eval_dir) != FS_DIR { eval_dir = run_sub; }
    fl: [1] FsList;
    fn := fs_list(eval_dir, fl[..]);
    for i: 0..<fn {
      if n_rows_out[0] >= GB_MAX_ITEMS { break; }
      nm := fs_entry(fl[..], i);
      if !gbr_starts(nm, "eval_") || !gbr_ends(nm, ".json") { continue; }
      fp_b: [FS_PATH_MAX] u8;
      fpath := fs_join(eval_dir, nm, fp_b[..]);
      en := fs_read(fpath, work[0].json_buf[..]);
      if en <= 0 { continue; }
      jd: [1] Jv;
      if !jv_parse(jd[..], cast(string) work[0].json_buf[0..<en], work[0].nodes[..]) { continue; }
      d := jd[0];
      rec: [1] GbItemRecord;
      rec[0].item_id_n = jv_str(d, jv_get(d, 0, "eval_name"), rec[0].item_id[..]);
      if rec[0].item_id_n <= 0 { continue; }
      sid_s := cast(string) rec[0].item_id[0..<rec[0].item_id_n];
      rec[0].pillar_n = gbw_put(rec[0].pillar[..], "eval");
      rec[0].category_n = gbw_put(rec[0].category[..], "eval");
      rec[0].arm_n = gbw_put(rec[0].arm[..], arm_id);
      tot_q := jv_int(d, jv_get(d, 0, "total_questions"), 0);
      cor_q := jv_int(d, jv_get(d, 0, "correct_answers"), 0);
      fail_req := jv_int(d, jv_get(d, 0, "failed_requests"), 0);
      acc_bps := gbr_parse_scaled(jv_raw(d, jv_get(d, 0, "accuracy")), 2);
      if acc_bps == 0 && tot_q > 0 && cor_q > 0 { acc_bps = gb_rate_bps(cor_q, tot_q); }
      if cor_q == 0 && acc_bps > 0 && tot_q > 0 {
        cor_q = (acc_bps * tot_q + 5000) / 10000;
        if cor_q > tot_q { cor_q = tot_q; }
      }
      rec[0].graded = tot_q;
      rec[0].passed_count = cor_q;
      rec[0].score_bps = ifx acc_bps <= 10000 then acc_bps else 10000;
      rec[0].harness_errors = fail_req;
      rec[0].wall_ms = gbr_parse_scaled(jv_raw(d, jv_get(d, 0, "duration_s")), 3);
      dtok := jv_get(d, 0, "decode_tok_s");
      if jv_kind(d, dtok) == JV_OBJECT {
        rec[0].tok_per_s_x10 = gbr_parse_scaled(jv_raw(d, jv_get(d, dtok, "observed_median")), 1);
      }
      if rec[0].tok_per_s_x10 > 0 {
        rec[0].tpot_us = 10000000 / rec[0].tok_per_s_x10;
      }
      scn := jv_str(d, jv_get(d, 0, "scaffold_id"), rec[0].scaffold_id[..]);
      if scn > 0 { rec[0].scaffold_id_n = scn; }
      else { rec[0].scaffold_id_n = gbw_put(rec[0].scaffold_id[..], sc_s); }
      sun := jv_str(d, jv_get(d, 0, "subject_id"), rec[0].subject_id[..]);
      if sun > 0 { rec[0].subject_id_n = sun; }
      else { rec[0].subject_id_n = gbw_put(rec[0].subject_id[..], sb_s); }

      stb: [32] u8; stn := jv_str(d, jv_get(d, 0, "status"), stb[..]);
      sts := ifx stn > 0 then cast(string) stb[0..<stn] else "failed";
      rec[0].status_code = gb_classify_outcome(GbSuiteOutcomeInput.{
        applicable = tot_q,
        passed = ifx sts == "success" && cor_q > 0 then tot_q else cor_q,
        harness_errors = fail_req,
        withheld = sts == "withheld",
        infra_required = sts == "infra_required" || sts == "error",
        exit_code = ifx sts == "success" then GB_EXIT_OK else GB_EXIT_CAPABILITY_FAIL,
      });
      rec[0].leaderboard_comparable = jv_bool(d, jv_get(d, 0, "leaderboard_comparable"));
      rec[0].distill_allowed = gb_admit_distill_suite(sid_s) == GB_DISTILL_ADMIT;

      // Summary detail line
      dt_b: [160] u8; n1: [16] u8; n2: [16] u8; n3: [16] u8;
      dn := gbr_cat(dt_b[..], 0, gbr_int_str(cor_q, n1[..]));
      dn = gbr_cat(dt_b[..], dn, "/");
      dn = gbr_cat(dt_b[..], dn, gbr_int_str(tot_q, n2[..]));
      dn = gbr_cat(dt_b[..], dn, " (");
      dn = gbr_cat(dt_b[..], dn, gbr_int_str(rec[0].score_bps / 100, n3[..]));
      dn = gbr_cat(dt_b[..], dn, "%)");
      rec[0].detail_n = gbw_put(rec[0].detail[..], cast(string) dt_b[0..<dn]);

      // Export verified ATIF-v1.8 from sample_traces[] (or fallback summary item)
      afn: [128] u8; afnn := gbr_cat(afn[..], 0, sid_s); afnn = gbr_cat(afn[..], afnn, ".atif.jsonl");
      apb: [FS_PATH_MAX] u8;
      apath := fs_join(atif_dir, cast(string) afn[0..<afnn], apb[..]);
      tr_node := jv_get(d, 0, "sample_traces");
      sc_item := cast(string) rec[0].scaffold_id[0..<rec[0].scaffold_id_n];
      atif_ok := false;
      if jv_kind(d, tr_node) == JV_ARRAY && jv_len(d, tr_node) > 0 {
        atif_ok = gb_atif_export_eval_traces(work[0].atif_w[..], d, tr_node, apath, run_id, sid_s, mid_s, timestamp, sc_item, rec[0].atif_digest[..]);
      }
      if !atif_ok {
        atif_ok = gb_atif_write_item(work[0].atif_w[..], apath, run_id, sid_s, mid_s, timestamp, sid_s, cast(string) rec[0].detail[0..<rec[0].detail_n], "", sc_item, rec[0].status_code == GB_STATUS_PASS, rec[0].score_bps, rec[0].atif_digest[..]);
      }
      if atif_ok {
        rec[0].atif_verified = true;
        rec[0].atif_digest_n = 64;
        rec[0].atif_path_n = gbw_put(rec[0].atif_path[..], apath);
      }

      rows[n_rows_out[0]] = rec[0];
      n_rows_out[0] += 1;
      gbr_live_emit(e, "item_done", side, arm_id, sid_s, n_rows_out[0], pinfo.count, gb_status_label(rec[0].status_code), rec[0].score_bps, rec[0].wall_ms, cast(string) rec[0].detail[0..<rec[0].detail_n]);
    }
  }

  gb_summarize_arm(pol, rows, n_rows_out[0], boot_ms[0], rss_mb[0], sum_out);
  gbr_live_emit(e, "arm_done", side, arm_id, pinfo.slug, n_rows_out[0], n_rows_out[0], "DONE", sum_out[0].score_bps, sum_out[0].total_wall_ms, cast(string) sum_out[0].scaffold_id[0..<sum_out[0].scaffold_id_n]);
  return n_rows_out[0] > 0;
}

// Run full sequential Arm A vs Arm B comparison, verify scaffold lock, and persist last-gbench.json.
gbr_run_compare :: (
  e: [] GbEnv,
  work: [] GbRunWork,
  run_id: string,
  run_dir: string,
  profile_slug: string,
  custom_evals_csv: string,
  eval_limit: int,
  allow_local_golden_exec: bool,
  ep_a: string,
  ep_b: string,
  out_file: string
) -> bool #effects(all) {
  prof_id := gb_profile_by_slug(profile_slug);
  if prof_id < 0 { return false; }
  pinfo := gb_profile_info(prof_id);
  ts_b: [40] u8;
  ts := gbr_iso_now(ts_b[..]);

  _ = fs_mkdir_all(run_dir);
  // Clear live-status.jsonl for this fresh run
  {
    home := cast(string) e[0].home[0..<e[0].home_n];
    dp: [FS_PATH_MAX] u8; fp: [FS_PATH_MAX] u8;
    gdir := fs_join(home, ".openagents/gbench", dp[..]);
    _ = fs_mkdir_all(gdir);
    _ = fs_write(fs_join(gdir, "live-status.jsonl", fp[..]), "");
  }

  da: [FS_PATH_MAX] u8; db: [FS_PATH_MAX] u8;
  dir_a := fs_join(run_dir, "arm-a", da[..]);
  dir_b := fs_join(run_dir, "arm-b", db[..]);
  na: [1] int; nb: [1] int;

  ok_a := gbr_run_arm(e, work, work[0].pol_a[..], "a", run_id, ts, dir_a, prof_id, custom_evals_csv, eval_limit, allow_local_golden_exec, 18891, ep_a, work[0].rows_a[..], na[..], work[0].sum_a[..]);
  work[0].n_a = na[0];
  // Sequential execution: reuse port 18891 after Arm A cleanly shuts down so gBench pins
  // an identical serving_environment.endpoint and identical scaffold_id across Arm A & Arm B.
  ok_b := gbr_run_arm(e, work, work[0].pol_b[..], "b", run_id, ts, dir_b, prof_id, custom_evals_csv, eval_limit, allow_local_golden_exec, 18891, ep_b, work[0].rows_b[..], nb[..], work[0].sum_b[..]);
  work[0].n_b = nb[0];
  if !ok_a && !ok_b { return false; }

  sc_a := cast(string) work[0].sum_a[0].scaffold_id[0..<work[0].sum_a[0].scaffold_id_n];
  sc_b := cast(string) work[0].sum_b[0].scaffold_id[0..<work[0].sum_b[0].scaffold_id_n];
  locked := gb_scaffolds_match(sc_a, sc_b);

  wn := gbw_compare_write(
    run_id, ts, pinfo.slug, gb_kind_name(pinfo.kind), locked,
    work[0].sum_a[..], work[0].rows_a[..], work[0].n_a,
    work[0].sum_b[..], work[0].rows_b[..], work[0].n_b,
    work[0].out_buf[..]
  );
  if wn <= 0 { return false; }
  doc := cast(string) work[0].out_buf[0..<wn];

  // Persist to run_dir/compare.json, ~/.openagents/gym/last-gbench.json, and optional --out
  cp: [FS_PATH_MAX] u8;
  _ = fs_write(fs_join(run_dir, "compare.json", cp[..]), doc);
  home := cast(string) e[0].home[0..<e[0].home_n];
  gd: [FS_PATH_MAX] u8; gp: [FS_PATH_MAX] u8;
  gym_dir := fs_join(home, ".openagents/gym", gd[..]);
  _ = fs_mkdir_all(gym_dir);
  _ = fs_write(fs_join(gym_dir, "last-gbench.json", gp[..]), doc);
  if out_file.count > 0 { _ = fs_write(out_file, doc); }
  gbr_live_emit(e, "compare_done", "both", "", pinfo.slug, work[0].n_a, work[0].n_b, ifx locked then "LOCKED" else "UNLOCKED", work[0].sum_a[0].score_bps, work[0].sum_a[0].total_wall_ms + work[0].sum_b[0].total_wall_ms, run_dir);
  return true;
}

