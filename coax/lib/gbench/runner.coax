// Pure Coax gBench Runner, Local Inkling Server Lifecycle & Hillclimbing Orchestrator.
//
// Owns:
//   - Host discovery (`doctor`): managed ~/.openagents/gbench/venv, gbench CLI, Python 3.12,
//     Psionic Metal (psionic-inkling-serve + inkling-kernels.metal), llama-server,
//     Inkling HF tokenizer, bwrap, Docker, GEMINI_API_KEY, HF_TOKEN, and installed variants.
//   - Managed venv & HF tokenizer provisioning (`install`).
//   - Sequential local model server lifecycle (Psionic Metal w/ optional --lora, --model-id,
//     INK_DEFAULT_EFFORT, INK_SPEC_LOOKUP; llama-server comparator) with /health polling,
//     boot_ms, and RSS sampling.
//   - Out-of-process gBench execution (Golden Set, Serving Perf, Evaluation Suites) rooted
//     under ~/.openagents/gbench/{runs,cache,tmp} with live status JSONL streaming.
//   - Exact ingestion of gBench metadata.json, summary.json, performance/*.json, eval_*.json
//     into registered wire shapes (proto/coder/gbench-gym-v1.json) + verified ATIF-v1.8 logs.
//   - Side-by-side comparison persistence (~/.openagents/gym/last-gbench.json) and
//     #authority hillclimbing ledger (~/.openagents/gbench/hillclimb/{champion.json,ledger.jsonl}).
//
//   coax/bin/coax test coax/lib/gbench/runner.coax --library
#load "../sys/fs.coax";
#load "../sys/proc.coax";
#load "../net/http.coax";
#load "suites.coax";
#load "atif.coax";
#load "hillclimb.coax";

cxproc_self_path :: (out: [] u8) -> int #foreign #effects(all);

GbEnv :: struct {
  home: [512] u8; home_n: int;
  self_path: [1024] u8; self_path_n: int;
  self_dir: [1024] u8; self_dir_n: int;
  cwd: [1024] u8; cwd_n: int;
  venv_py: [512] u8; venv_py_n: int;
  gbench_bin: [512] u8; gbench_bin_n: int;
  venv_ok: bool;
  gbench_ver: [32] u8; gbench_ver_n: int;
  python_ver: [32] u8; python_ver_n: int;
  psionic_bin: [512] u8; psionic_bin_n: int;
  psionic_metal: [512] u8; psionic_metal_n: int;
  psionic_ok: bool;
  llama_bin: [512] u8; llama_bin_n: int;
  llama_ok: bool;
  flawed_bin: [512] u8; flawed_bin_n: int;
  flawed_ok: bool;
  vertex_ok: bool;
  tokenizer_dir: [512] u8; tokenizer_dir_n: int;
  tokenizer_ok: bool;
  bwrap_ok: bool;
  docker_ok: bool;
  gemini_key_set: bool;
  hf_token_set: bool;
  variants_installed: int;
  variant_ready: [GB_VAR_COUNT] bool;
}

GbRunWork :: struct {
  hw: [1] HttpWork;
  atif_w: [1] GbAtifWork;
  pol_a: [1] GbPolicy;
  pol_b: [1] GbPolicy;
  sum_a: [1] GbArmSummary;
  sum_b: [1] GbArmSummary;
  rows_a: [GB_MAX_ITEMS] GbItemRecord; n_a: int;
  rows_b: [GB_MAX_ITEMS] GbItemRecord; n_b: int;
  json_buf: [2097152] u8;
  out_buf: [524288] u8;
  nodes: [65536] JvNode;
}

gbr_cat :: (dst: [] u8, at: int, s: string) -> int #effects(all) {
  n := at;
  for c: s { if n < dst.count { dst[n] = c; n += 1; } }
  return n;
}

gbr_int_str :: (v: int, out: [] u8) -> string #effects(all) {
  o: [1] Jo; jo_start(o[..], out); jo_int(o[..], v);
  return jo_text(o[..]);
}

gbr_trim :: (s: string) -> string #effects(all) {
  lo := 0;
  hi := s.count;
  while lo < hi && (s[lo] == ' ' || s[lo] == '\n' || s[lo] == '\r' || s[lo] == '\t') { lo += 1; }
  while hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\n' || s[hi - 1] == '\r' || s[hi - 1] == '\t') { hi -= 1; }
  return s[lo..<hi];
}

gbr_starts :: (s: string, pfx: string) -> bool #effects(all) {
  if pfx.count > s.count { return false; }
  for i: 0..<pfx.count { if s[i] != pfx[i] { return false; } }
  return true;
}

gbr_ends :: (s: string, sfx: string) -> bool #effects(all) {
  if sfx.count > s.count { return false; }
  off := s.count - sfx.count;
  for i: 0..<sfx.count { if s[off + i] != sfx[i] { return false; } }
  return true;
}

gbr_parse_uint :: (raw: string) -> int #effects(all) {
  s := gbr_trim(raw);
  if s.count == 0 { return 0; }
  v := 0;
  for c: s {
    if c < '0' || c > '9' { break; }
    v = v * 10 + cast(int) (c - '0');
  }
  return v;
}

// Parse a non-negative decimal number string (e.g. "300.9016") scaled by 10^decimals (e.g. decimals=3 -> 300901).
// Returns 0 on empty/non-numeric/negative strings.
gbr_parse_scaled :: (raw: string, decimals: int) -> int #effects(all) {
  s := gbr_trim(raw);
  if s.count == 0 || s[0] == '-' { return 0; }
  whole := 0;
  frac := 0;
  fd := 0;
  seen_dot := false;
  seen_digit := false;
  for c: s {
    if c >= '0' && c <= '9' {
      d := cast(int) (c - '0');
      seen_digit = true;
      if !seen_dot {
        if whole < 1000000000 { whole = whole * 10 + d; }
      } else if fd < decimals {
        frac = frac * 10 + d;
        fd += 1;
      }
    } else if c == '.' && !seen_dot {
      seen_dot = true;
    } else {
      break;
    }
  }
  if !seen_digit { return 0; }
  scale := 1;
  for _: 0..<decimals { scale *= 10; }
  while fd < decimals { frac *= 10; fd += 1; }
  return whole * scale + frac;
}

gbr_str_gt :: (a: string, b: string) -> bool #effects(reads, traps) {
  m := ifx a.count < b.count then a.count else b.count;
  for i: 0..<m {
    if a[i] != b[i] { return a[i] > b[i]; }
  }
  return a.count > b.count;
}


gbr_doctor_ok :: (venv_ok: bool, psionic_ok: bool, llama_ok: bool, variants_installed: int, flawed_ok: bool, vertex_ok: bool) -> bool #effects() {
  if !venv_ok { return false; }
  if (psionic_ok || llama_ok) && variants_installed > 0 { return true; }
  return flawed_ok && vertex_ok;
}

gbr_default_effort :: (backend: string) -> string #effects(reads, traps) {
  return ifx gb_variant_is_cloud(backend) then "low" else "0.7";
}

gbr_default_ctx_tokens :: (backend: string) -> int #effects(reads, traps) {
  return ifx gb_variant_is_cloud(backend) then 1048576 else 32768;
}

#test "gbench runner: scaled decimal parsing, string helpers, doctor readiness, and variant defaults" {
  #assert gbr_parse_scaled("300.90166", 3) == 300901;
  #assert gbr_parse_scaled("12.3749", 3) == 12374;
  #assert gbr_parse_scaled("92.85", 2) == 9285;
  #assert gbr_parse_scaled("100.0", 2) == 10000;
  #assert gbr_parse_scaled("56.7", 1) == 567;
  #assert gbr_parse_scaled("0", 3) == 0;
  #assert gbr_parse_scaled("-1.5", 2) == 0;
  #assert gbr_parse_scaled("", 2) == 0;
  #assert gbr_starts("eval_gsm8k.json", "eval_");
  #assert gbr_ends("eval_gsm8k.json", ".json");
  #assert !gbr_ends("eval_gsm8k.txt", ".json");
  #assert gbr_doctor_ok(true, true, false, 1, false, false);
  #assert gbr_doctor_ok(true, false, true, 1, false, false);
  #assert !gbr_doctor_ok(true, true, true, 0, false, false);
  #assert !gbr_doctor_ok(true, false, false, 3, false, false);
  #assert !gbr_doctor_ok(false, true, true, 3, true, true);
  #assert gbr_doctor_ok(true, false, false, 0, true, true);
  #assert !gbr_doctor_ok(true, false, false, 0, true, false);
  #assert !gbr_doctor_ok(true, false, false, 0, false, true);
  #assert gbr_default_effort("vertex-bridge") == "low";
  #assert gbr_default_effort("flawed-cloud") == "low";
  #assert gbr_default_effort("psionic-metal") == "0.7";
  #assert gbr_default_ctx_tokens("vertex-bridge") == 1048576;
  #assert gbr_default_ctx_tokens("flawed-cloud") == 1048576;
  #assert gbr_default_ctx_tokens("flawed-local") == 32768;
}
