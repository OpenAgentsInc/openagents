    slug = "llamacpp-inkling-uncensored-q4k",
    label = "Inkling 2 Mini · llama.cpp Uncensored AD-Q4_K",
    backend = "llamacpp-metal",
    model_id = "inkling-2-mini-uncensored-q4k",
    rel_gguf = "inkling-2-mini-uncensored-q4k/Inkling-2-Mini-Uncensored-AD-Q4_K.gguf",
    rel_lora = "",
    quant = "AD-Q4_K",
    min_ram_gb = 24,
