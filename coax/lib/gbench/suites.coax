gb_variant_by_slug :: (slug: string) -> int {
  if slug == "inkling-2-mini" || slug == "psionic" || slug == "base" { return GB_VAR_INKLING_BASE; }
  if slug == "inkling-2-mini-uncensored-lora" || slug == "lora" || slug == "uncensored-lora" { return GB_VAR_INKLING_LORA; }
  if slug == "inkling-2-mini-uncensored-maple" || slug == "maple" || slug == "uncensored-maple" { return GB_VAR_INKLING_MAPLE; }
  if slug == "inkling-2-mini-uncensored-q4k" || slug == "q4k" || slug == "uncensored-q4k" { return GB_VAR_INKLING_Q4K; }
  if slug == "inkling-2-mini-uncensored-iq3s" || slug == "iq3s" { return GB_VAR_INKLING_IQ3S; }
  if slug == "inkling-2-mini-uncensored-iq2m" || slug == "iq2m" { return GB_VAR_INKLING_IQ2M; }
  if slug == "inkling-2-mini-abliterated-mix16g" || slug == "mix16g" { return GB_VAR_INKLING_MIX16G; }
  if slug == "inkling-2-mini-abliterated-mix12g" || slug == "mix12g" { return GB_VAR_INKLING_MIX12G; }
  if slug == "llamacpp-inkling-2-mini" || slug == "llamacpp" || slug == "llama" { return GB_VAR_LLAMACPP_BASE; }
  if slug == "llamacpp-inkling-uncensored-q4k" || slug == "llama-q4k" { return GB_VAR_LLAMACPP_Q4K; }
  if slug == "gemini-4-neon" || slug == "neon" { return GB_VAR_GEMINI_NEON; }
  if slug == "gemini-4-carbon" || slug == "carbon" { return GB_VAR_GEMINI_CARBON; }
  if slug == "gemini-4-hydrogen" || slug == "hydrogen" { return GB_VAR_GEMINI_HYDROGEN; }
  if slug == "gemini-4-argon" || slug == "argon" { return GB_VAR_GEMINI_ARGON; }
  if slug == "flawed-inkling-2-mini" || slug == "flawed-inkling" || slug == "flawed:inkling-2-mini" { return GB_VAR_FLAWED_INKLING_BASE; }
  if slug == "flawed-inkling-uncensored-lora" || slug == "flawed-lora" || slug == "flawed:inkling-2-mini-uncensored-lora" { return GB_VAR_FLAWED_INKLING_LORA; }
  if slug == "flawed-inkling-uncensored-maple" || slug == "flawed-maple" || slug == "flawed:inkling-2-mini-uncensored-maple" { return GB_VAR_FLAWED_INKLING_MAPLE; }
  if slug == "flawed-inkling-uncensored-q4k" || slug == "flawed-q4k" || slug == "flawed:inkling-2-mini-uncensored-q4k" { return GB_VAR_FLAWED_INKLING_Q4K; }
  if slug == "flawed-gemini-4-neon" || slug == "flawed-neon" || slug == "flawed:gemini-4-neon" { return GB_VAR_FLAWED_GEMINI_NEON; }
  if slug == "flawed-gemini-4-carbon" || slug == "flawed-carbon" || slug == "flawed:gemini-4-carbon" { return GB_VAR_FLAWED_GEMINI_CARBON; }
  if slug == "flawed-gemini-4-hydrogen" || slug == "flawed-hydrogen" || slug == "flawed:gemini-4-hydrogen" { return GB_VAR_FLAWED_GEMINI_HYDROGEN; }
  if slug == "flawed-gemini-4-argon" || slug == "flawed-argon" || slug == "flawed:gemini-4-argon" { return GB_VAR_FLAWED_GEMINI_ARGON; }
  return -1;
}

#test "gbench suites: curated profiles, suite IDs, and Inkling/Neon/Flawed variant catalog" {
  #assert gb_profile_by_slug("oa-template-smoke") == GB_PROF_TEMPLATE_SMOKE;
  #assert gb_profile_by_slug("oa-perf-quick") == GB_PROF_PERF_QUICK;
  #assert gb_profile_by_slug("oa-perf-agentic") == GB_PROF_PERF_AGENTIC;
  #assert gb_profile_by_slug("oa-local-fast") == GB_PROF_LOCAL_FAST;
  #assert gb_profile_by_slug("oa-local-core") == GB_PROF_LOCAL_CORE;
  #assert gb_profile_by_slug("oa-coding-linux") == GB_PROF_CODING_LINUX;
  #assert gb_profile_by_slug("nope") == -1;

  for pid: 0..<GB_PROF_COUNT {
    info := gb_profile_info(pid);
    #assert gb_valid_slug(info.slug);
    #assert info.count > 0;
    for i: 0..<info.count {
      item := gb_profile_item(pid, i);
      #assert gb_valid_suite_id(item);
    }
  }
  #assert gb_profile_info(GB_PROF_LOCAL_CORE).count == 16;
  #assert gb_profile_info(GB_PROF_TEMPLATE_SMOKE).count == 16;

  expected_ram := [GB_VAR_COUNT] int.[32, 32, 24, 16, 12, 24, 16, 32, 24, 0, 0, 0, 0, 32, 32, 24, 0, 0, 0, 0, 32, 32];
  for vid: 0..<GB_VAR_COUNT {
    v := gb_variant_info(vid);
    #assert v.id == vid;
    #assert v.min_ram_gb == expected_ram[vid];
    #assert gb_valid_slug(v.slug);
    #assert gb_valid_slug(v.model_id);
    #assert gb_variant_by_slug(v.slug) == vid;
    if gb_variant_is_cloud(v.backend) {
      #assert v.rel_gguf.count == 0;
    } else {
      #assert v.rel_gguf.count > 0;
    }
  }
  #assert gb_variant_info(GB_VAR_INKLING_LORA).rel_lora.count > 0;
  #assert gb_variant_info(GB_VAR_INKLING_MAPLE).rel_lora.count > 0;
  #assert gb_variant_info(GB_VAR_FLAWED_INKLING_MAPLE).rel_lora.count > 0;
  #assert gb_variant_info(GB_VAR_INKLING_BASE).rel_lora.count == 0;
  #assert gb_variant_by_slug("maple") == GB_VAR_INKLING_MAPLE;
  #assert gb_variant_by_slug("uncensored-maple") == GB_VAR_INKLING_MAPLE;
  #assert gb_variant_by_slug("flawed-maple") == GB_VAR_FLAWED_INKLING_MAPLE;
  #assert gb_variant_by_slug("flawed:inkling-2-mini-uncensored-maple") == GB_VAR_FLAWED_INKLING_MAPLE;
  #assert gb_variant_by_slug("neon") == GB_VAR_GEMINI_NEON;
  #assert gb_variant_by_slug("carbon") == GB_VAR_GEMINI_CARBON;
  #assert gb_variant_by_slug("hydrogen") == GB_VAR_GEMINI_HYDROGEN;
  #assert gb_variant_by_slug("argon") == GB_VAR_GEMINI_ARGON;
  #assert gb_variant_by_slug("flawed-neon") == GB_VAR_FLAWED_GEMINI_NEON;
  #assert gb_variant_by_slug("flawed-lora") == GB_VAR_FLAWED_INKLING_LORA;
  #assert gb_variant_upstream_model(GB_VAR_INKLING_BASE) == "inkling-2-mini";
  #assert gb_variant_upstream_model(GB_VAR_INKLING_MAPLE) == "inkling-2-mini-uncensored-maple";
  #assert gb_variant_upstream_model(GB_VAR_FLAWED_INKLING_BASE) == "inkling-2-mini";
  #assert gb_variant_upstream_model(GB_VAR_FLAWED_INKLING_LORA) == "inkling-2-mini-uncensored-lora";
  #assert gb_variant_upstream_model(GB_VAR_FLAWED_INKLING_MAPLE) == "inkling-2-mini-uncensored-maple";
  #assert gb_variant_upstream_model(GB_VAR_FLAWED_INKLING_Q4K) == "inkling-2-mini-uncensored-q4k";
  #assert gb_variant_upstream_model(GB_VAR_FLAWED_GEMINI_NEON) == "gemini-4-neon";
  #assert gb_variant_upstream_model(GB_VAR_FLAWED_GEMINI_CARBON) == "gemini-4-carbon";
  #assert gb_variant_upstream_model(GB_VAR_FLAWED_GEMINI_HYDROGEN) == "gemini-4-hydrogen";
  #assert gb_variant_upstream_model(GB_VAR_FLAWED_GEMINI_ARGON) == "gemini-4-argon";
  #assert gb_variant_by_slug("unknown") == -1;
}
