// Shared raw IEEE-754 admission. Inspect words before floating arithmetic.
#authority;
#forall "F64 finite admission depends only on the complete eleven-bit exponent" exponent:0..<2048,negative:bool {
  for fraction:[3]u64.[0,1,0x000fffffffffffff] {
    word:=(cast(u64)exponent<<52)|fraction;if negative {word|=0x8000000000000000;}
    #assert ieee_f64_finite(word)==(exponent!=2047);
  }
}
ieee_f64_finite :: (word:u64)->bool #effects(all) {return (word&0x7ff0000000000000)!=0x7ff0000000000000;}
