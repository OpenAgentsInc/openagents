INF_DYNAMIC :: [275] u8.[120,218,61,146,201,149,5,49,8,3,83,33,53,192,236,249,223,71,184,61,223,103,189,210,130,137,89,244,120,54,159,232,147,108,125,234,180,77,232,164,81,167,31,21,158,185,42,139,26,245,98,111,77,9,10,201,51,113,184,252,200,84,134,187,71,100,53,171,5,137,149,198,128,6,150,75,217,226,148,251,202,104,85,35,7,168,3,77,45,77,82,27,186,56,255,158,252,179,20,203,57,41,14,26,141,51,76,211,117,42,236,201,160,186,249,169,197,145,30,180,212,50,232,184,227,121,6,210,126,150,137,6,173,193,160,129,21,48,5,138,80,224,147,69,246,108,254,134,41,91,45,141,10,45,181,99,75,94,207,125,122,45,213,9,34,113,208,192,66,75,108,1,195,244,79,70,24,246,229,199,22,103,105,216,118,215,144,142,231,185,239,155,236,142,129,11,128,198,244,155,22,5,158,236,151,159,234,246,188,119,186,107,24,72,215,19,143,48,6,44,113,76,249,122,242,155,22,5,152,42,158,12,170,216,252,48,253,191,57,205,183,198,206,191,158,251,118,12,20,21,187,61,65,123,211,110,1,219,143,113,101,52,12,195,205,223,223,205,203,230,15,125,198,233,48];
// The text the vectors were made from (python's zlib, levels 0 and 9, fixed and default strategy).
inf_text :: (i: int) -> u8 { return ifx i % 29 != 0 then cast(u8) (97 + ((i * i) / 7 + i / 13) % 11) else 32; }
inf_same :: (out: []u8, n: int, want: int) -> bool {
  if n != want { return false; }
  for i: 0..<n { if out[i] != inf_text(i) { return false; } }
  return true;
}
#test "zlib streams of stored, fixed and dynamic blocks" {
  out: [700] u8; stored := INF_STORED; fixed := INF_FIXED; dynamic := INF_DYNAMIC;
  #assert inf_same(out[..], zlib_inflate(stored[..], out[..]), 40);
  #assert inf_same(out[..], zlib_inflate(fixed[..], out[..]), 60);
  #assert inf_same(out[..], zlib_inflate(dynamic[..], out[..]), 600);
}
