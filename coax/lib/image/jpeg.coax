// A frame of three components (ids 1, 2, 3; tables 0, 1, 1) with every table set, for scan headers.
jpg_framed :: (b: []u8) -> JpgState {
  f := [15] u8.[8,0,13,0,21,3,1,34,0,2,17,1,3,17,1]; // mutant: equivalent (a scan header needs only the ids and tables)
  ss: [1] JpgState; ss[0].src = f[..];
  ss[0].nc = jpg_sof(ss[..], 0, f.count) + 3;
  for t: 0..<8 { ss[0].huff[t].set = true; }
  for t: 0..<4 { ss[0].qset[t] = true; }
  ss[0].src = b;
  return ss[0];
}
