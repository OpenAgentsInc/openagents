#test "YCbCr to RGB over every Cb and Cr" {
  h: u64 = 17; out: [4] u8;
  for cb: 0..<256 {
    for cr: 0..<256 {
      jpg_rgb(out[..], 0, 128, cb, cr);
      for x: out { h = (h * 31 + cast(u64) x) % 4294967291; }
    }
  }
  #assert h == 556072718;
}
#test "rounding down, the range limit, a k-bit difference" {
  #assert jpg_floor(-1, 1) == -1 && jpg_floor(-3, 2) == -1 && jpg_floor(5, 1) == 2 && jpg_floor(-262144, 18) == -1 && jpg_floor(262143, 18) == 0;
  #assert jpg_limit(-128) == 0 && jpg_limit(127) == 255 && jpg_limit(0) == 128 && jpg_limit(128) == 255 && jpg_limit(511) == 255;
  #assert jpg_limit(512) == 0 && jpg_limit(895) == 0 && jpg_limit(-129) == 0 && jpg_limit(1024) == 128 && jpg_limit(-1025) == 127;
  #assert jpg_extend(0, 1) == -1 && jpg_extend(1, 1) == 1 && jpg_extend(3, 3) == -4 && jpg_extend(4, 3) == 4 && jpg_extend(0, 0) == 0;
  #assert jpg_clamp(-1) == 0 && jpg_clamp(256) == 255 && jpg_clamp(7) == 7;
}
