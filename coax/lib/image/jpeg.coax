jpg_sof_of :: (b: []u8) -> JpgState { ss: [1] JpgState; ss[0].src = b; ss[0].nc = jpg_sof(ss[..], 0, b.count); return ss[0]; }
#test "frame headers: sampling, planes, and what is refused" {
  { b := [15] u8.[8,0,13,0,21,3,1,34,0,2,17,1,3,17,1]; s := jpg_sof_of(b[..]);
    #assert s.frame && s.w == 21 && s.h == 13 && s.hmax == 2 && s.vmax == 2 && s.mcux == 2 && s.mcuy == 1 && s.work == 768;
    #assert s.comps[0].id == 1 && s.comps[0].dw == 21 && s.comps[0].dh == 13 && s.comps[0].pw == 32 && s.comps[0].ph == 16 && s.comps[0].plane == 0;
    #assert s.comps[1].dw == 11 && s.comps[1].dh == 7 && s.comps[1].pw == 16 && s.comps[1].ph == 8 && s.comps[1].plane == 512 && s.comps[1].tq == 1 && s.comps[2].plane == 640; }
  { b := [15] u8.[8,0,9,0,17,3,1,33,0,2,17,1,3,17,1]; s := jpg_sof_of(b[..]);
    #assert s.frame && s.mcux == 2 && s.mcuy == 2 && s.comps[1].dw == 9 && s.comps[1].dh == 9 && s.comps[1].pw == 16 && s.comps[1].ph == 16 && s.work == 1024; }
  { b := [9] u8.[8,0,1,0,1,1,1,17,3]; s := jpg_sof_of(b[..]); #assert s.frame && s.w == 1 && s.h == 1 && s.comps[0].tq == 3 && s.work == 64; }
  { b := [6] u8.[8,0,1,0,1,0]; #assert jpg_sof_of(b[..]).nc == JPG_UNSUPPORTED; }
  { b := [5] u8.[8,0,1,0,1]; #assert jpg_sof_of(b[..]).nc == JPG_BAD; }
  { b := [9] u8.[12,0,1,0,1,1,1,17,0]; #assert jpg_sof_of(b[..]).nc == JPG_UNSUPPORTED; }
  { b := [9] u8.[8,0,0,0,1,1,1,17,0]; #assert jpg_sof_of(b[..]).nc == JPG_UNSUPPORTED; }
  { b := [9] u8.[8,0,1,0,0,1,1,17,0]; #assert jpg_sof_of(b[..]).nc == JPG_UNSUPPORTED; }
  { b := [9] u8.[8,0,1,0,1,1,1,1,0]; #assert jpg_sof_of(b[..]).nc == JPG_UNSUPPORTED; }
  { b := [9] u8.[8,0,1,0,1,1,1,49,0]; #assert jpg_sof_of(b[..]).nc == JPG_UNSUPPORTED; }
