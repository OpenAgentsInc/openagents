// Baseline JPEG (ITU-T T.81, sequential Huffman, 8 bits) to RGBA8, for the textures a realm's
// pack holds (verse/gpu, the scene host). It decodes as libjpeg-turbo does by default, which is
// what the browser and PIL use: the integer IDCT (jidctint.c), "fancy" triangle upsampling of
// 2x1 and 2x2 chroma (jdsample.c), and the fixed-point YCbCr conversion (jdcolor.c). One or
// three components (gray, or YCbCr as JFIF has it), sampling factors 1 or 2, restart intervals,
// one or more scans. Progressive, lossless, arithmetic-coded and 12-bit files are refused, and
// so are four components. The caller gives the buffers (jpg_info says how large); nothing is
// allocated. Inside the coded data it is as lenient as libjpeg-turbo's jdhuff.c, so a damaged
// file looks as it does in the browser: a code the table lacks is 0, a run past the 63rd
// coefficient lands on it, and once the data runs out (or meets a marker early) that MCU reads
// zeros and the scan's later MCUs are flat (their coefficients all 0) until a restart marker.
// A malformed header is refused, and so is an interval whose restart marker is missing while
// data remains (libjpeg resyncs there).
#authority;
JPG_OK :: 0;
JPG_NOT :: 1;           // not a JPEG
JPG_UNSUPPORTED :: 2;   // a JPEG this decoder does not take
JPG_BAD :: 3;           // malformed
JPG_SMALL :: 4;         // the caller's buffers are too small
JPG_MAX :: 16384;       // the largest width or height taken
// A component: its sampling factors, tables, DC prediction, and the plane its samples go to
// (pw by ph bytes, at `plane` in the work buffer); dw by dh of them are the image's.
JpgComp :: struct { id: int; h: int; v: int; tq: int; td: int; ta: int; pred: int; plane: int; pw: int; ph: int; dw: int; dh: int; }
// A Huffman table (T.81 F.2.2.3): codes of each length, their values, and the decoding limits.
JpgHuff :: struct { count: [17] int; vals: [256] int; mincode: [17] int; maxcode: [17] int; valptr: [17] int; set: bool; }
JpgState :: struct {
  src: []u8; at: int; bits: int; n: int; stuck: bool;   // the entropy reader; stuck at a marker or the end
  dry: bool;                                          // a bit was wanted past that (libjpeg's insufficient_data)
  q: [256] int; qset: [4] bool;                       // four quantization tables, in zigzag order
  huff: [8] JpgHuff;                                  // DC tables 0..3, then AC tables 0..3
  w: int; h: int; nc: int; comps: [3] JpgComp; hmax: int; vmax: int; mcux: int; mcuy: int;
  restart: int; frame: bool; scanned: int; seen: [3] bool; work: int;
}
// What jpg_decode needs: work bytes (the components' planes), and w*h*4 out.
JpgInfo :: struct { status: int; w: int; h: int; channels: int; work: int; }
// The natural (row by row) place of each coefficient in zigzag order.
JPG_ZZ :: [64] int.[0,1,8,16,9,2,3,10,17,24,32,25,18,11,4,5,12,19,26,33,40,48,41,34,27,20,13,6,7,14,21,28,35,42,49,56,57,50,43,36,29,22,15,23,30,37,44,51,58,59,52,45,38,31,39,46,53,60,61,54,47,55,62,63];

jpg_be16 :: (b: []u8, at: int) -> int { return (cast(int) b[at] << 8) | cast(int) b[at + 1]; }
// x >> k rounded down for any sign: 2^48 is a multiple of 2^k (k <= 18) and larger than any |x| here.
jpg_floor :: (x: int, k: int) -> int { return ((x + 281474976710656) >> k) - (281474976710656 >> k); } // mutant: equivalent (the second 2^48 plus one shifts the same)
jpg_clamp :: (x: int) -> int { return ifx x < 0 then 0 else (ifx x > 255 then 255 else x); } // mutant: equivalent (0 and 255 are their own clamps)
// A sample from the IDCT's output, as libjpeg's range-limit table makes it (jdmaster.c): the
// value masked to 10 bits; -128..127 offset by 128, above that 255, below it 0, and far enough
// out (a damaged file's) wrapped around, as libjpeg's mask wraps it.
jpg_limit :: (x: int) -> int {
  v := ((x % 1024) + 1024) % 1024;
  if v < 128 { return v + 128; }
  if v < 512 { return 255; }
  if v < 896 { return 0; } // mutant: equivalent (896 gives 0 either way)
  return v - 896;
}

// ---- the entropy-coded data
// The next byte of a scan's data: a stuffed 0xFF 0x00 is 0xFF; a marker, or the end, gives zeros.
jpg_byte :: (s: []JpgState) -> int {
  if s[0].stuck || s[0].at >= s[0].src.count { s[0].stuck = true; return 0; }
  b := cast(int) s[0].src[s[0].at];
  if b != 255 { s[0].at += 1; return b; }
  if s[0].at + 1 < s[0].src.count && s[0].src[s[0].at + 1] == 0 { s[0].at += 2; return 255; }
  s[0].stuck = true;
  return 0;
}
jpg_bit :: (s: []JpgState) -> int {
  if s[0].n == 0 { s[0].bits = jpg_byte(s); s[0].n = 8; if s[0].stuck { s[0].dry = true; } }
  s[0].n -= 1;
  return (s[0].bits >> s[0].n) & 1;
}
jpg_receive :: (s: []JpgState, k: int) -> int {
  v := 0;
  for i: 0..<k { v = (v << 1) | jpg_bit(s); }
  return v;
}
// A k-bit difference (T.81 F.2.2.1, EXTEND).
jpg_extend :: (v: int, k: int) -> int {
  if k == 0 { return 0; }
  return ifx v < (1 << (k - 1)) then v - (1 << k) + 1 else v;
}
// A value of table t; 0 for a code it does not have, after 17 bits (jdhuff.c's jpeg_huff_decode).
jpg_huff :: (s: []JpgState, t: int) -> int {
  code := jpg_bit(s);
  for l: 1..<17 {
    if code <= s[0].huff[t].maxcode[l] { return s[0].huff[t].vals[s[0].huff[t].valptr[l] + code - s[0].huff[t].mincode[l]]; }
    code = (code << 1) | jpg_bit(s);
  }
  return 0;
}

// ---- the inverse DCT (libjpeg's jpeg_idct_islow: 13 fractional bits, 2 more kept between passes)
JPG_FIX :: [12] int.[2446, 3196, 4433, 6270, 7373, 9633, 12299, 15137, 16069, 16819, 20995, 25172];
// One column or row of eight (at `at`, `step` apart) in place; the result scaled down by `shift`.
jpg_idct8 :: (b: []int, at: int, step: int, shift: int) {
  f := JPG_FIX;
  i0 := b[at]; i1 := b[at + step]; i2 := b[at + 2 * step]; i3 := b[at + 3 * step];
  i4 := b[at + 4 * step]; i5 := b[at + 5 * step]; i6 := b[at + 6 * step]; i7 := b[at + 7 * step];
  // even part
  z1 := (i2 + i6) * f[2];
  t2 := z1 - i6 * f[7];
  t3 := z1 + i2 * f[3];
  t0 := (i0 + i4) << 13;
  t1 := (i0 - i4) << 13;
  t10 := t0 + t3; t13 := t0 - t3; t11 := t1 + t2; t12 := t1 - t2;
  // odd part
  y1 := i7 + i1; y2 := i5 + i3; y3 := i7 + i3; y4 := i5 + i1;
  y5 := (y3 + y4) * f[5];
  o0 := i7 * f[0]; o1 := i5 * f[9]; o2 := i3 * f[11]; o3 := i1 * f[6];
  y1 = -y1 * f[4]; y2 = -y2 * f[10]; y3 = -y3 * f[8] + y5; y4 = -y4 * f[1] + y5;
  o0 += y1 + y3; o1 += y2 + y4; o2 += y2 + y3; o3 += y1 + y4;
  r := 1 << (shift - 1);
  b[at] = jpg_floor(t10 + o3 + r, shift); b[at + 7 * step] = jpg_floor(t10 - o3 + r, shift);
  b[at + step] = jpg_floor(t11 + o2 + r, shift); b[at + 6 * step] = jpg_floor(t11 - o2 + r, shift);
  b[at + 2 * step] = jpg_floor(t12 + o1 + r, shift); b[at + 5 * step] = jpg_floor(t12 - o1 + r, shift);
  b[at + 3 * step] = jpg_floor(t13 + o0 + r, shift); b[at + 4 * step] = jpg_floor(t13 - o0 + r, shift);
}
// A block's coefficients (natural order, dequantized) to samples: columns, then rows.
jpg_idct :: (b: []int) {
  for c: 0..<8 { jpg_idct8(b, c, 8, 11); }
  for r: 0..<8 { jpg_idct8(b, r * 8, 1, 18); }
}

// ---- a block, an MCU, a scan
// A block of component c: decoded, dequantized, transformed and written to its plane at block
// (bx, by); with flat, not decoded (its coefficients all 0: every sample 128).
jpg_block :: (s: []JpgState, work: []u8, c: int, bx: int, by: int, flat: bool) {
  coef: [64] int;
  if !flat { jpg_coefs(s, c, coef[..]); }
  jpg_idct(coef[..]);
  p := s[0].comps[c];
  for y: 0..<8 {
    for x: 0..<8 { work[p.plane + (by * 8 + y) * p.pw + bx * 8 + x] = cast(u8) jpg_limit(coef[y * 8 + x]); }
  }
}
// A block's coefficients, natural order, dequantized.
jpg_coefs :: (s: []JpgState, c: int, coef: []int) {
  q := s[0].comps[c].tq * 64;
  t := jpg_huff(s, s[0].comps[c].td);
  s[0].comps[c].pred += jpg_extend(jpg_receive(s, t), t);
  coef[0] = s[0].comps[c].pred * s[0].q[q];
  k := 1;
  while k < 64 {
    rs := jpg_huff(s, 4 + s[0].comps[c].ta);
    r := rs >> 4; size := rs & 15;
    if size == 0 {
      if r != 15 { break; }
      k += 16;
      continue;
    }
    // past the last coefficient it is the last (jpeg_natural_order's 16 extra entries are 63)
    k += r;
    z := ifx k > 63 then 63 else k; // mutant: equivalent (63 is 63 either way)
    coef[JPG_ZZ[z]] = jpg_extend(jpg_receive(s, size), size) * s[0].q[q + z];
    k += 1;
  }
}
// After a restart interval: the bits left dropped, the RSTn marker taken (the data comes back),
// the predictions reset. Data where the marker should be is refused (libjpeg would resync).
jpg_restart :: (s: []JpgState) -> bool {
  s[0].n = 0;
  for i: 0..<3 { s[0].comps[i].pred = 0; }
  at := s[0].at;
  if at + 1 >= s[0].src.count { return true; } // mutant: equivalent (a marker as the last two bytes reads zeros taken or not)
  m := cast(int) s[0].src[at + 1];
  if s[0].src[at] != 255 { return false; }
  if m >= 208 && m <= 215 {
    s[0].at = at + 2; s[0].stuck = false; s[0].dry = false;
    return true;
  }
  // at another marker (or the end, above): the next MCU reads zeros, and those after it are flat
  return m != 0;
}
// A scan of the components listed (by index) in `of`, from s.at; it ends at the marker after it.
jpg_scan :: (s: []JpgState, work: []u8, of: []int) -> bool {
  s[0].n = 0; s[0].stuck = false; s[0].dry = false;
  // one component alone is its blocks in rows; several are MCUs of each one's h by v blocks
  one := of.count == 1;
  across := ifx one then (s[0].comps[of[0]].dw + 7) / 8 else s[0].mcux;
  down := ifx one then (s[0].comps[of[0]].dh + 7) / 8 else s[0].mcuy;
  left := s[0].restart;
  for my: 0..<down {
    for mx: 0..<across {
      if s[0].restart > 0 {
        if left == 0 { if !jpg_restart(s) { return false; } left = s[0].restart; }
        left -= 1;
      }
      // out of data before this MCU: it is not decoded (jdhuff.c's decode_mcu)
      flat := s[0].dry;
      for c: of {
        p := s[0].comps[c];
        nh := ifx one then 1 else p.h; nv := ifx one then 1 else p.v;
        for v: 0..<nv {
          for h: 0..<nh { jpg_block(s, work, c, mx * nh + h, my * nv + v, flat); }
        }
      }
    }
  }
  // past what is left of the data (and any restart markers) to the next marker
  while s[0].at + 1 < s[0].src.count && (s[0].src[s[0].at] != 255 || s[0].src[s[0].at + 1] == 0 || (s[0].src[s[0].at + 1] >= 208 && s[0].src[s[0].at + 1] <= 215)) { // mutant: equivalent (the walk ends at a byte that is not a marker, wherever it is)
    s[0].at += 1;
  }
  return true;
}

// ---- the markers
// A DQT segment's tables (8- or 16-bit values), from d to end.
jpg_dqt :: (s: []JpgState, d: int, end: int) -> bool {
  at := d;
  while at < end {
    pq := cast(int) s[0].src[at] >> 4; tq := cast(int) s[0].src[at] & 15;
    if pq > 1 || tq > 3 || at + 1 + 64 * (pq + 1) > end { return false; }
    for k: 0..<64 { s[0].q[tq * 64 + k] = ifx pq == 0 then cast(int) s[0].src[at + 1 + k] else jpg_be16(s[0].src, at + 1 + 2 * k); }
    s[0].qset[tq] = true;
    at += 1 + 64 * (pq + 1);
  }
  return true;
}
// A DHT segment's tables, from d to end.
jpg_dht :: (s: []JpgState, d: int, end: int) -> bool {
  at := d;
  while at < end {
    tc := cast(int) s[0].src[at] >> 4; th := cast(int) s[0].src[at] & 15;
    if tc > 1 || th > 3 || at + 17 > end { return false; }
    t := tc * 4 + th;
    total := 0;
    for l: 1..<17 { s[0].huff[t].count[l] = cast(int) s[0].src[at + l]; total += s[0].huff[t].count[l]; }
    if total > 256 || at + 17 + total > end { return false; }
    for i: 0..<total {
      s[0].huff[t].vals[i] = cast(int) s[0].src[at + 17 + i];
      // a DC value is a bit count (jdhuff.c refuses one past 15)
      if tc == 0 && s[0].huff[t].vals[i] > 15 { return false; }
    }
    // canonical codes (T.81 C.2): each length's run, then one more bit
    code := 0; k := 0;
    for l: 1..<17 {
      n := s[0].huff[t].count[l];
      s[0].huff[t].valptr[l] = k; s[0].huff[t].mincode[l] = code;
      code += n; k += n;
      // as jdhuff.c: no code of all ones (T.81 C.2), nor more codes than the length has
      if code >= (1 << l) { return false; }
      s[0].huff[t].maxcode[l] = ifx n > 0 then code - 1 else -1;
      code = code << 1;
    }
    s[0].huff[t].set = true;
    at += 17 + total;
  }
  return true;
}
// A baseline or extended frame header: the size, the components and their planes.
jpg_sof :: (s: []JpgState, d: int, size: int) -> int {
  if s[0].frame || size < 6 { return JPG_BAD; }
  if s[0].src[d] != 8 { return JPG_UNSUPPORTED; }
  s[0].h = jpg_be16(s[0].src, d + 1); s[0].w = jpg_be16(s[0].src, d + 3);
  nc := cast(int) s[0].src[d + 5];
  if nc != 1 && nc != 3 { return JPG_UNSUPPORTED; }
  if size != 6 + 3 * nc { return JPG_BAD; }
  if s[0].w < 1 || s[0].h < 1 || s[0].w > JPG_MAX || s[0].h > JPG_MAX { return JPG_UNSUPPORTED; }
  s[0].nc = nc;
  for i: 0..<nc {
    c := d + 6 + 3 * i;
    p: JpgComp;
    p.id = cast(int) s[0].src[c]; p.h = cast(int) s[0].src[c + 1] >> 4; p.v = cast(int) s[0].src[c + 1] & 15; p.tq = cast(int) s[0].src[c + 2];
    if p.h < 1 || p.h > 2 || p.v < 1 || p.v > 2 || p.tq > 3 { return JPG_UNSUPPORTED; }
    if p.h > s[0].hmax { s[0].hmax = p.h; } // mutant: equivalent (an equal factor is the same largest)
    if p.v > s[0].vmax { s[0].vmax = p.v; } // mutant: equivalent (an equal factor is the same largest)
    s[0].comps[i] = p;
  }
  // what the upsampling takes: each component full size, half across, or half both ways
  s[0].mcux = (s[0].w + 8 * s[0].hmax - 1) / (8 * s[0].hmax); s[0].mcuy = (s[0].h + 8 * s[0].vmax - 1) / (8 * s[0].vmax);
  at := 0;
  for i: 0..<nc {
    fx := s[0].hmax / s[0].comps[i].h; fy := s[0].vmax / s[0].comps[i].v;
    if fy > fx { return JPG_UNSUPPORTED; }
    s[0].comps[i].dw = (s[0].w * s[0].comps[i].h + s[0].hmax - 1) / s[0].hmax;
    s[0].comps[i].dh = (s[0].h * s[0].comps[i].v + s[0].vmax - 1) / s[0].vmax;
    s[0].comps[i].pw = s[0].mcux * s[0].comps[i].h * 8; s[0].comps[i].ph = s[0].mcuy * s[0].comps[i].v * 8;
    s[0].comps[i].plane = at; at += s[0].comps[i].pw * s[0].comps[i].ph;
  }
  s[0].work = at; s[0].frame = true;
  return JPG_OK;
}
// A scan header: which components, with which tables; their indices into `of`. 0, or why not.
jpg_sos :: (s: []JpgState, d: int, size: int, of: []int) -> int {
  if !s[0].frame || size < 6 { return JPG_BAD; } // mutant: equivalent (with no frame no component matches; a short header fails its size)
  ns := cast(int) s[0].src[d];
  if ns < 1 || ns > s[0].nc || size != 4 + 2 * ns { return JPG_BAD; }
  for i: 0..<ns {
    id := cast(int) s[0].src[d + 1 + 2 * i]; t := cast(int) s[0].src[d + 2 + 2 * i];
    c := -1;
    for k: 0..<s[0].nc { if s[0].comps[k].id == id { c = k; } }
    if c < 0 || (t >> 4) > 3 || (t & 15) > 3 { return JPG_BAD; }
    s[0].comps[c].td = t >> 4; s[0].comps[c].ta = t & 15;
    if !s[0].huff[t >> 4].set || !s[0].huff[4 + (t & 15)].set || !s[0].qset[s[0].comps[c].tq] { return JPG_BAD; }
    of[i] = c;
    if !s[0].seen[c] { s[0].seen[c] = true; s[0].scanned += 1; }
  }
  // a sequential scan: spectral selection 0 to 63, no successive approximation
  e := d + 1 + 2 * ns;
  if s[0].src[e] != 0 || s[0].src[e + 1] != 63 || s[0].src[e + 2] != 0 { return JPG_BAD; }
  return JPG_OK;
}
// The markers from SOI on: up to the first scan when `work` is empty (jpg_info), else every
// scan decoded into work, to EOI. JPG_OK, or why not.
jpg_walk :: (s: []JpgState, work: []u8) -> int {
  src := s[0].src;
  if src.count < 4 || src[0] != 255 || src[1] != 216 { return JPG_NOT; }
  s[0].at = 2;
  while true {
    at := s[0].at;
    // fill bytes (0xFF) before a marker are allowed
    while at < src.count && src[at] == 255 && at + 1 < src.count && src[at + 1] == 255 { at += 1; }
    // the end, with or without EOI: every component must have been in a scan
    if at + 1 >= src.count || src[at] != 255 || src[at + 1] == 217 { return ifx s[0].frame && s[0].scanned == s[0].nc then JPG_OK else JPG_BAD; }
    m := cast(int) src[at + 1];
    // no segment: TEM and the reserved codes, a restart marker outside a scan, a second SOI; and
    // JPG and DAC (arithmetic coding's tables), which a Huffman file has no use for
    if m < 192 || (m >= 208 && m <= 216) || m == 200 || m == 204 { return JPG_BAD; } // mutant: equivalent (EOI, 217, ended the walk above)
    if at + 4 > src.count { return JPG_BAD; }
    size := jpg_be16(src, at + 2);
    if size < 2 || at + 2 + size > src.count { return JPG_BAD; }
    d := at + 4; end := at + 2 + size; n := size - 2;
    s[0].at = end;
    if m == 192 || m == 193 {
      st := jpg_sof(s, d, n);
      if st != JPG_OK { return st; }
    } else if (m >= 194 && m <= 207 && m != 196) { return JPG_UNSUPPORTED; } // mutant: equivalent (208 was refused above)
    else if m == 196 { if !jpg_dht(s, d, end) { return JPG_BAD; } }
    else if m == 219 { if !jpg_dqt(s, d, end) { return JPG_BAD; } }
    else if m == 221 { if n != 2 { return JPG_BAD; } s[0].restart = jpg_be16(src, d); }
    else if m == 218 {
      of: [3] int;
      st := jpg_sos(s, d, n, of[..]);
      if st != JPG_OK { return st; }
      if work.count == 0 { return JPG_OK; }
      if !jpg_scan(s, work, of[0..<cast(int) src[d]]) { return JPG_BAD; }
    }
    // APPn, COM and other segments are passed over
  }
  return JPG_BAD; // mutant: equivalent (the loop above only returns)
}
jpg_info :: (src: []u8) -> JpgInfo {
  ss: [1] JpgState; ss[0].src = src; none: [1] u8;
  r: JpgInfo;
  r.status = jpg_walk(ss[..], none[0..<0]);
  if r.status != JPG_OK { return r; }
  r.w = ss[0].w; r.h = ss[0].h; r.channels = ss[0].nc; r.work = ss[0].work;
  return r;
}

// ---- upsampling and colour
// Component c's sample for pixel (x, y), upsampled as libjpeg-turbo's fancy upsamplers do: a
// triangle filter, 3/4 the nearer sample and 1/4 the next, edges repeated (h2v1 and h2v2).
jpg_sample :: (s: []JpgState, work: []u8, c: int, x: int, y: int) -> int {
  p := s[0].comps[c];
  fx := s[0].hmax / p.h; fy := s[0].vmax / p.v;
  if fx == 1 { return cast(int) work[p.plane + y * p.pw + x]; }
  i := x / 2; j := y / fy;
  ni := ifx (x & 1) == 0 then i - 1 else i + 1;
  if ni < 0 { ni = 0; } // mutant: equivalent (0 is 0)
  if ni >= p.dw { ni = p.dw - 1; }
  if fy == 1 {
    row := p.plane + j * p.pw;
    return (3 * cast(int) work[row + i] + cast(int) work[row + ni] + ifx (x & 1) == 0 then 1 else 2) >> 2;
  }
  nj := ifx (y & 1) == 0 then j - 1 else j + 1;
  if nj < 0 { nj = 0; } // mutant: equivalent (0 is 0)
  if nj >= p.dh { nj = p.dh - 1; }
  a := p.plane + j * p.pw; b := p.plane + nj * p.pw;
  near := 3 * cast(int) work[a + i] + cast(int) work[b + i];
  far := 3 * cast(int) work[a + ni] + cast(int) work[b + ni];
  return (3 * near + far + ifx (x & 1) == 0 then 8 else 7) >> 4;
}
// YCbCr to RGB (jdcolor.c: 16 fractional bits, rounded as its tables are).
jpg_rgb :: (out: []u8, o: int, y: int, cb: int, cr: int) {
  out[o] = cast(u8) jpg_clamp(y + jpg_floor(91881 * (cr - 128) + 32768, 16)); // mutant: equivalent (a constant one off rounds every 8-bit input the same)
  out[o + 1] = cast(u8) jpg_clamp(y + jpg_floor(-22554 * (cb - 128) + 32768 - 46802 * (cr - 128), 16)); // mutant: equivalent (a constant one off rounds every 8-bit input the same)
  out[o + 2] = cast(u8) jpg_clamp(y + jpg_floor(116130 * (cb - 128) + 32768, 16)); // mutant: equivalent (a constant one off rounds every 8-bit input the same)
  out[o + 3] = 255;
}
// The image as RGBA8 into out (w*h*4 bytes), work at least jpg_info's: JPG_OK or why not.
jpg_decode :: (src: []u8, work: []u8, out: []u8) -> int {
  r := jpg_info(src);
  if r.status != JPG_OK { return r.status; }
  if work.count < r.work || out.count < r.w * r.h * 4 { return JPG_SMALL; }
  ss: [1] JpgState; ss[0].src = src; s := ss[..];
  st := jpg_walk(s, work[0..<r.work]);
  if st != JPG_OK { return st; }
  for y: 0..<r.h {
    for x: 0..<r.w {
      o := (y * r.w + x) * 4;
      l := jpg_sample(s, work, 0, x, y);
      if r.channels == 1 { out[o] = cast(u8) l; out[o + 1] = cast(u8) l; out[o + 2] = cast(u8) l; out[o + 3] = 255; }
      else { jpg_rgb(out, o, l, jpg_sample(s, work, 1, x, y), jpg_sample(s, work, 2, x, y)); }
    }
  }
  return JPG_OK;
}

// ---- checks
JpgCase :: struct { w: int; h: int; ch: int; digest: u64; }
JpgBad :: struct { base: int; a: int; b: int; at: int; n: int; status: int; }
jpg_digest :: (b: []u8) -> u64 {
  h: u64 = 17;
  for x: b { h = (h * 31 + cast(u64) x) % 4294967291; }
  return h;
}
// A file decoded: what jpg_info says, jpg_decode's answers with one byte less of work and of
// out, its answer with enough, and the digest of the RGBA it gives.
JpgRun :: struct { info: JpgInfo; short_work: int; short_out: int; status: int; digest: u64; }
jpg_run :: (src: []u8, c: JpgCase) -> JpgRun {
  work: [2048] u8; out: [8192] u8; p: JpgRun;
  p.info = jpg_info(src);
  n := c.w * c.h * 4;
  p.short_work = jpg_decode(src, work[0..<p.info.work - 1], out[..]); // mutant: equivalent (any shorter buffer is too small)
  p.short_out = jpg_decode(src, work[..], out[0..<n - 1]); // mutant: equivalent (any shorter buffer is too small)
  p.status = jpg_decode(src, work[0..<p.info.work], out[0..<n]);
  p.digest = jpg_digest(out[0..<n]);
  return p;
}
// A refused file: base's bytes a..<b replaced by the patch's n from at, into dst; its length.
jpg_splice :: (dst: []u8, base: []u8, d: JpgBad, patch: []u8) -> int {
  k := 0;
  for i: 0..<d.a { dst[k] = base[i]; k += 1; }
  for i: 0..<d.n { dst[k] = patch[d.at + i]; k += 1; }
  for i: d.b..<base.count { dst[k] = base[i]; k += 1; }
  return k;
}
#test "gray, 4:2:0, 4:2:2, 4:4:4 and 4:4:0-chroma files, restarts, several scans, 16-bit tables and damaged data decode as libjpeg-turbo does" {
  k := JPG_CASES;
  f0 := JPG_C420; f1 := JPG_C444; f2 := JPG_C422; f3 := JPG_GRAY; f4 := JPG_RST; f5 := JPG_OPT; f6 := JPG_Q16; f7 := JPG_SCANS; f8 := JPG_NOISE; f9 := JPG_NOISE444; f10 := JPG_WIDE; f11 := JPG_FILL; f12 := JPG_NOEOI; f13 := JPG_CUT; f14 := JPG_RST_CUT; f15 := JPG_BAD_CODE; f16 := JPG_PAST_63; f17 := JPG_DC_12; f18 := JPG_EDGE; f19 := JPG_ZRL; f20 := JPG_RST9; f21 := JPG_RST_SHORT; f22 := JPG_RST_TALL; f23 := JPG_RST_ONE_LEFT; f24 := JPG_CUT_EOI; f25 := JPG_CUT_FF; f26 := JPG_TALL; f27 := JPG_TRAIL; f28 := JPG_SCANS_SHORT; f29 := JPG_C211; f30 := JPG_TAIL_FF; f31 := JPG_TAIL_COM; f32 := JPG_CUT_FF00; f33 := JPG_TRAIL3; f34 := JPG_PROGRESSIVE; f35 := JPG_CMYK; f36 := JPG_H1V2; f37 := JPG_DHT_TOO_MANY;
  files := [38] []u8.[f0[..], f1[..], f2[..], f3[..], f4[..], f5[..], f6[..], f7[..], f8[..], f9[..], f10[..], f11[..], f12[..], f13[..], f14[..], f15[..], f16[..], f17[..], f18[..], f19[..], f20[..], f21[..], f22[..], f23[..], f24[..], f25[..], f26[..], f27[..], f28[..], f29[..], f30[..], f31[..], f32[..], f33[..], f34[..], f35[..], f36[..], f37[..]];
  for i: 0..<34 {
    c := k[i]; r := jpg_run(files[i], c);
    #assert r.info.status == JPG_OK && r.info.w == c.w && r.info.h == c.h && r.info.channels == c.ch;
    #assert r.short_work == JPG_SMALL && r.short_out == JPG_SMALL && r.status == JPG_OK && r.digest == c.digest;
  }
}
#test "what is not a JPEG, not one taken, or malformed" {
  bad := JPG_REFUSED; patch := JPG_PATCH;
  f0 := JPG_C420; f1 := JPG_C444; f2 := JPG_C422; f3 := JPG_GRAY; f4 := JPG_RST; f5 := JPG_OPT; f6 := JPG_Q16; f7 := JPG_SCANS; f8 := JPG_NOISE; f9 := JPG_NOISE444; f10 := JPG_WIDE; f11 := JPG_FILL; f12 := JPG_NOEOI; f13 := JPG_CUT; f14 := JPG_RST_CUT; f15 := JPG_BAD_CODE; f16 := JPG_PAST_63; f17 := JPG_DC_12; f18 := JPG_EDGE; f19 := JPG_ZRL; f20 := JPG_RST9; f21 := JPG_RST_SHORT; f22 := JPG_RST_TALL; f23 := JPG_RST_ONE_LEFT; f24 := JPG_CUT_EOI; f25 := JPG_CUT_FF; f26 := JPG_TALL; f27 := JPG_TRAIL; f28 := JPG_SCANS_SHORT; f29 := JPG_C211; f30 := JPG_TAIL_FF; f31 := JPG_TAIL_COM; f32 := JPG_CUT_FF00; f33 := JPG_TRAIL3; f34 := JPG_PROGRESSIVE; f35 := JPG_CMYK; f36 := JPG_H1V2; f37 := JPG_DHT_TOO_MANY;
  files := [38] []u8.[f0[..], f1[..], f2[..], f3[..], f4[..], f5[..], f6[..], f7[..], f8[..], f9[..], f10[..], f11[..], f12[..], f13[..], f14[..], f15[..], f16[..], f17[..], f18[..], f19[..], f20[..], f21[..], f22[..], f23[..], f24[..], f25[..], f26[..], f27[..], f28[..], f29[..], f30[..], f31[..], f32[..], f33[..], f34[..], f35[..], f36[..], f37[..]];
  for d: bad {
    buf: [2048] u8; work: [2048] u8; out: [4096] u8;
    n := jpg_splice(buf[..], files[d.base], d, patch[..]);
    #assert jpg_decode(buf[0..<n], work[..], out[..]) == d.status;
    // jpg_info reads to the first scan, so what is wrong after it is jpg_decode's to find
    info := jpg_info(buf[0..<n]);
    #assert info.status == d.status || info.status == JPG_OK;
  }
}
