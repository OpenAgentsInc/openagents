PNG_BAD_H16384 :: [66] u8.[137,80,78,71,13,10,26,10,0,0,0,13,73,72,68,82,0,0,0,1,0,0,64,0,8,2,0,0,0,31,32,245,2,0,0,0,9,73,68,65,84,120,156,99,0,0,0,1,0,1,94,255,125,249,0,0,0,0,73,69,78,68,174,66,96,130];
PNG_BAD_H16385 :: [66] u8.[137,80,78,71,13,10,26,10,0,0,0,13,73,72,68,82,0,0,0,1,0,0,64,1,8,2,0,0,0,212,124,38,167,0,0,0,9,73,68,65,84,120,156,99,0,0,0,1,0,1,94,255,125,249,0,0,0,0,73,69,78,68,174,66,96,130];
png_digest :: (b: []u8) -> u64 {
  h: u64 = 17;
  for x: b { h = (h * 31 + cast(u64) x) % 4294967291; }
  return h;
}
// A file decoded: what png_info says, png_decode's answers with one byte less of work and of
// out, its answer with enough, and the digest of the RGBA it gives.
PngRun :: struct { info: PngInfo; short_work: int; short_out: int; status: int; digest: u64; }
png_run :: (src: []u8, c: PngCase) -> PngRun {
  work: [512] u8; out: [256] u8; p: PngRun;
  p.info = png_info(src);
  n := c.w * c.h * 4;
  p.short_work = png_decode(src, work[0..<p.info.work - 1], out[..]); // mutant: equivalent (any shorter buffer is too small)
  p.short_out = png_decode(src, work[..], out[0..<n - 1]); // mutant: equivalent (any shorter buffer is too small)
  p.status = png_decode(src, work[0..<p.info.work], out[0..<n]);
  p.digest = png_digest(out[0..<n]);
  return p;
}
#test "PNGs of each colour type and every filter, on random and on regular pixels" {
  k := PNG_CASES;
  n3 := PNG_NOISE3; n4 := PNG_NOISE4; n1 := PNG_NOISE1; one := PNG_ONE; rgb := PNG_RGB; rgba := PNG_RGBA; gray := PNG_GRAY; graya := PNG_GRAYA; flat := PNG_FLAT;
  files := [9] []u8.[n3[..], n4[..], n1[..], one[..], rgb[..], rgba[..], gray[..], graya[..], flat[..]];
  for i: 0..<9 {
    c := k[i]; p := png_run(files[i], c); r := p.info;
    #assert r.status == PNG_OK && r.w == c.w && r.h == c.h && r.channels == c.ch && r.work == r.idat + c.h * (1 + c.w * c.ch);
    #assert p.short_work == PNG_SMALL && p.short_out == PNG_SMALL && p.status == PNG_OK && p.digest == c.digest;
  }
}
png_refused :: (src: []u8) -> int { work: [512] u8; out: [64] u8; return png_decode(src, work[..], out[..]); }
#test "what is not a PNG, not one taken, or malformed" {
  { b := PNG_BAD_SIGNATURE; #assert png_refused(b[..]) == PNG_NOT && png_refused(b[0..<7]) == PNG_NOT; }
  { b := PNG_BAD_FIRST_BYTE; #assert png_refused(b[..]) == PNG_NOT; }
  { b := PNG_BAD_SIG_ONLY; #assert png_refused(b[..]) == PNG_BAD; }
  { b := PNG_BAD_INTERLACED; #assert png_refused(b[..]) == PNG_UNSUPPORTED; }
  { b := PNG_BAD_DEPTH16; #assert png_refused(b[..]) == PNG_UNSUPPORTED; }
  { b := PNG_BAD_PALETTE; #assert png_refused(b[..]) == PNG_UNSUPPORTED; }
  { b := PNG_BAD_COMPRESSION; #assert png_refused(b[..]) == PNG_UNSUPPORTED; }
  { b := PNG_BAD_FILTER_METHOD; #assert png_refused(b[..]) == PNG_UNSUPPORTED; }
  { b := PNG_BAD_ZERO_WIDE; #assert png_refused(b[..]) == PNG_UNSUPPORTED; }
  { b := PNG_BAD_CRITICAL; #assert png_refused(b[..]) == PNG_UNSUPPORTED; }
  { b := PNG_BAD_BAD_CRC; #assert png_refused(b[..]) == PNG_BAD; }
  { b := PNG_BAD_CUT; #assert png_refused(b[..]) == PNG_BAD; }
  { b := PNG_BAD_HUGE_SIZE; #assert png_refused(b[..]) == PNG_BAD; }
  { b := PNG_BAD_NO_IDAT; #assert png_refused(b[..]) == PNG_BAD && png_info(b[..]).status == PNG_BAD; }
  { b := PNG_BAD_NO_IEND; #assert png_refused(b[..]) == PNG_BAD; }
  { b := PNG_BAD_FILTER5; #assert png_refused(b[..]) == PNG_BAD; }
  { b := PNG_BAD_SHORT_DATA; #assert png_refused(b[..]) == PNG_BAD; }
  { b := PNG_BAD_LONG_DATA; #assert png_refused(b[..]) == PNG_BAD; }
  { b := PNG_BAD_NOT_IHDR; #assert png_refused(b[..]) == PNG_BAD; }
  { b := PNG_BAD_IHDR_SHORT; #assert png_refused(b[..]) == PNG_BAD; }
  // the largest width and height are taken (the buffers are then too small), one more is not
  { b := PNG_BAD_W16384; #assert png_info(b[..]).status == PNG_OK && png_refused(b[..]) == PNG_SMALL; }
  { b := PNG_BAD_H16384; #assert png_info(b[..]).status == PNG_OK && png_refused(b[..]) == PNG_SMALL; }
  { b := PNG_BAD_W16385; #assert png_refused(b[..]) == PNG_UNSUPPORTED; }
  { b := PNG_BAD_H16385; #assert png_refused(b[..]) == PNG_UNSUPPORTED; }
}
#test "Paeth's ties go to the left, then above; CRC-32" {
  #assert png_pred(4, 5, 5, 5) == 5 && png_pred(4, 1, 9, 1) == 9 && png_pred(4, 9, 1, 1) == 9 && png_pred(4, 3, 7, 10) == 3;
  #assert png_pred(4, 2, 6, 4) == 4 && png_pred(4, 0, 3, 2) == 0 && png_pred(4, 0, 3, 1) == 3 && png_pred(4, 6, 2, 9) == 2;
  #assert png_pred(4, 7, 7, 3) == 7 && png_pred(4, 5, 1, 4) == 1 && png_pred(4, 1, 5, 4) == 1 && png_pred(4, 4, 8, 2) == 8;
  #assert png_pred(3, 255, 255, 0) == 255 && png_pred(1, 3, 4, 5) == 3 && png_pred(2, 3, 4, 5) == 4;
  b := [9] u8.[73, 72, 68, 82, 0, 0, 0, 1, 0];
  #assert png_crc(b[..]) == 2254025085;
}
