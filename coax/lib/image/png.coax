// PNG (ISO/IEC 15948) to RGBA8, for the textures a realm's pack holds (verse/gpu, the scene
// host): 8 bits a channel, gray, gray and alpha, RGB or RGBA, not interlaced; every chunk's CRC
// checked, ancillary chunks passed over, an unknown critical one refused. The caller gives the
// buffers (png_info says how large); nothing is allocated. Colour chunks (gAMA, iCCP) are not
// applied: the pack's images carry none.
#authority;
#load "inflate.coax";
PNG_OK :: 0;
PNG_NOT :: 1;           // not a PNG
PNG_UNSUPPORTED :: 2;   // a PNG this decoder does not take
PNG_BAD :: 3;           // malformed
PNG_SMALL :: 4;         // the caller's buffers are too small
PNG_MAX :: 16384;       // the largest width or height taken
// What png_decode needs: work bytes (the image data, then it inflated), and w*h*4 out.
PngInfo :: struct { status: int; w: int; h: int; channels: int; work: int; idat: int; }

png_be :: (b: []u8, at: int) -> int {
  return (cast(int) b[at] << 24) | (cast(int) b[at + 1] << 16) | (cast(int) b[at + 2] << 8) | cast(int) b[at + 3];
}
// CRC-32 (ISO 3309), as zlib's crc32.
png_crc :: (b: []u8) -> int {
  c: u32 = 4294967295;
  for x: b {
    c = c ^ cast(u32) x;
    for k: 0..<8 { c = ifx (c & 1) != 0 then (c >> 1) ^ 3988292384 else c >> 1; }
  }
  return cast(int) (c ^ 4294967295);
}
// The chunks, checked; with copy, the image data gathered into work.
png_walk :: (src: []u8, work: []u8, copy: bool) -> PngInfo {
  r: PngInfo; r.status = PNG_NOT;
  sig := [8] u8.[137, 80, 78, 71, 13, 10, 26, 10];
  if src.count < 8 { return r; }
  for i: 0..<8 { if src[i] != sig[i] { return r; } }
  r.status = PNG_BAD;
  at := 8; seen := false;
  while true {
    if at + 12 > src.count { return r; }
    size := png_be(src, at);
    if size > src.count - at - 12 { return r; }
    kind := cast(string) src[at + 4..<at + 8];
    if png_crc(src[at + 4..<at + 8 + size]) != png_be(src, at + 8 + size) { return r; }
    d := at + 8;
    if !seen {
      if kind != "IHDR" || size != 13 { return r; }
      seen = true;
      r.w = png_be(src, d); r.h = png_be(src, d + 4);
      ct := cast(int) src[d + 9];
      r.channels = ifx ct == 0 then 1 else (ifx ct == 2 then 3 else (ifx ct == 4 then 2 else (ifx ct == 6 then 4 else 0)));
      if r.w < 1 || r.h < 1 || r.w > PNG_MAX || r.h > PNG_MAX || src[d + 8] != 8 || r.channels == 0 || src[d + 10] != 0 || src[d + 11] != 0 || src[d + 12] != 0 {
        r.status = PNG_UNSUPPORTED; return r;
      }
    } else if kind == "IDAT" {
      if copy { for i: 0..<size { work[r.idat + i] = src[d + i]; } }
      r.idat += size;
    } else if kind == "IEND" {
      if r.idat == 0 { return r; }
      r.status = PNG_OK;
      r.work = r.idat + r.h * (1 + r.w * r.channels);
      return r;
    } else if (src[at + 4] & 32) == 0 { r.status = PNG_UNSUPPORTED; return r; }
    at += 12 + size;
  }
  return r; // mutant: equivalent (the loop above only returns)
}
png_info :: (src: []u8) -> PngInfo { none: [1] u8; return png_walk(src, none[0..<0], false); } // mutant: equivalent (without copy the view is not read)
png_abs :: (x: int) -> int { return ifx x < 0 then -x else x; } // mutant: equivalent (0 and -0 are one int)
// A filter's prediction from the byte to the left, the one above and the one above-left.
png_pred :: (f: int, a: int, b: int, c: int) -> int {
  if f == 1 { return a; }
  if f == 2 { return b; }
  if f == 3 { return (a + b) / 2; }
  p := a + b - c;
  pa := png_abs(p - a); pb := png_abs(p - b); pc := png_abs(p - c);
  if pa <= pb && pa <= pc { return a; } // mutant: equivalent (pa < pb: a tie of pa and pb with a != b puts c midway, so pc is 0 and c is taken either way)
  if pb <= pc { return b; }
  return c;
}
// The image as RGBA8 into out (w*h*4 bytes), work at least png_info's: PNG_OK or why not.
png_decode :: (src: []u8, work: []u8, out: []u8) -> int {
  r := png_info(src);
  if r.status != PNG_OK { return r.status; }
  if work.count < r.work || out.count < r.w * r.h * 4 { return PNG_SMALL; }
  _ := png_walk(src, work, true);
  st := r.w * r.channels; ch := r.channels;
  if zlib_inflate(work[0..<r.idat], work[r.idat..<r.work]) != r.h * (st + 1) { return PNG_BAD; }
  for y: 0..<r.h {
    row := r.idat + y * (st + 1);
    f := cast(int) work[row];
    if f > 4 { return PNG_BAD; }
    for i: 0..<st {
      a := ifx i >= ch then cast(int) work[row + 1 + i - ch] else 0;
      b := ifx y > 0 then cast(int) work[row - st + i] else 0;
      c := ifx i >= ch && y > 0 then cast(int) work[row - st + i - ch] else 0;
      p := ifx f == 0 then 0 else png_pred(f, a, b, c);
      work[row + 1 + i] = cast(u8) ((cast(int) work[row + 1 + i] + p) & 255);
    }
    for x: 0..<r.w {
      s := row + 1 + x * ch; o := (y * r.w + x) * 4;
      for k: 0..<3 { out[o + k] = work[s + ifx ch >= 3 then k else 0]; }
      out[o + 3] = ifx ch == 2 || ch == 4 then work[s + ch - 1] else 255;
    }
  }
  return PNG_OK;
}

PngCase :: struct { w: int; h: int; ch: int; digest: u64; }
