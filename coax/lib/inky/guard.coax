// Inky stateless per-turn guardrails (docs/coder/inky-spec.md §8).
// Replaces Microcoder's sticky state.notes + MkLocalGuard with exact, per-call
// native <|content_tool_error|> short-circuiting and clean step-budget wrap-up.
//
// Checks: coax/bin/coax test coax/lib/inky/guard.coax --library
// Mutate: coax/bin/coax mutate coax/lib/inky/guard.coax --root-only

#load "protocol.coax";
#authority;

IK_GUARD_SLOTS :: 64;
IK_MAX_STEPS_INTERACTIVE :: 30;
IK_MAX_STEPS_GOAL :: 60;

IkGuardEntry :: struct {
  kind: int;
  sig: u64;
  step: int;
  count: int;
  passed_check: bool;
}

IkGuard :: struct {
  entries: [IK_GUARD_SLOTS] IkGuardEntry;
  n: int;
  max_steps: int;
  files_edited: int;
  last_check_exit: int;
  has_check: bool;
  fail_edit_sig: u64;
  fail_edit_streak: int;
  zero_grep_streak: int;
  dup_blocks: int;
}

ik_guard_init :: (g: [] IkGuard, max_steps: int) #effects(all) {
  g[0] = IkGuard.{max_steps = ifx max_steps < 1 then IK_MAX_STEPS_INTERACTIVE else max_steps};
}

// Overflow-safe dual 32-bit FNV-1a signature over (kind, canon) combined into u64.
ik_guard_sig :: (kind: int, canon: string) -> u64 #effects(all) {
  h1: u64 = 2166136261 ^ cast(u64) kind;
  h2: u64 = 3735928559 ^ cast(u64) (kind + 17);
  for c: canon {
    b := cast(u64) c;
    h1 = ((h1 ^ b) * 16777619) & 0xFFFFFFFF;
    h2 = ((h2 ^ (b + 31)) * 16777619) & 0xFFFFFFFF;
  }
  return (h1 << 32) | h2;
}

// Clears the read/search/check cache on any workspace mutation so fresh reads and checks run.
ik_guard_mutated :: (g: [] IkGuard, is_file_edit: bool) #effects(all) {
  g[0].n = 0;
  g[0].fail_edit_sig = 0;
  g[0].fail_edit_streak = 0;
  g[0].zero_grep_streak = 0;
  g[0].dup_blocks = 0;
  if is_file_edit { g[0].files_edited += 1; }
}

ik_guard_find :: (g: [] IkGuard, kind: int, sig: u64) -> int #effects(all) {
  for i: 0..<g[0].n {
    if g[0].entries[i].kind == kind && g[0].entries[i].sig == sig { return i; }
  }
  return -1;
}

// Checks a read-only tool call (read_file, grep, list_dir, outline).
// Allows 1st and 2nd identical calls; short-circuits 3rd+ call with prior step > 0.
ik_guard_check_read :: (g: [] IkGuard, kind: int, canon: string, step: int) -> int #effects(all) {
  if kind != IK_TK_READ && kind != IK_TK_GREP && kind != IK_TK_LIST && kind != IK_TK_OUTLINE { return 0; }
  sig := ik_guard_sig(kind, canon);
  idx := ik_guard_find(g, kind, sig);
  if idx >= 0 {
    if g[0].entries[idx].count >= 2 { return g[0].entries[idx].step; }
    g[0].entries[idx].count += 1;
    return 0;
  }
  if g[0].n < IK_GUARD_SLOTS {
    g[0].entries[g[0].n] = IkGuardEntry.{kind = kind, sig = sig, step = step, count = 1};
    g[0].n += 1;
  }
  return 0;
}

// Checks a command call before execution.
// Short-circuits a duplicate passing check command (returns prior step > 0).
ik_guard_check_cmd :: (g: [] IkGuard, canon: string, is_check: bool) -> int #effects(all) {
  if !is_check { return 0; }
  sig := ik_guard_sig(IK_TK_CMD, canon);
  idx := ik_guard_find(g, IK_TK_CMD, sig);
  if idx >= 0 && g[0].entries[idx].passed_check { return g[0].entries[idx].step; }
  return 0;
}

// Records a completed command outcome.
ik_guard_record_cmd :: (g: [] IkGuard, canon: string, is_check: bool, exit_code: int, step: int) #effects(all) {
  if !is_check { return; }
  g[0].has_check = true;
  g[0].last_check_exit = exit_code;
  if exit_code != 0 { return; }
  sig := ik_guard_sig(IK_TK_CMD, canon);
  idx := ik_guard_find(g, IK_TK_CMD, sig);
  if idx >= 0 {
    g[0].entries[idx].step = step;
    return;
  }
  if g[0].n < IK_GUARD_SLOTS {
    g[0].entries[g[0].n] = IkGuardEntry.{kind = IK_TK_CMD, sig = sig, step = step, passed_check = true};
    g[0].n += 1;
  }
}

// Soft wrap-up warning fires once at step == max_steps - 2.
ik_guard_warn_budget :: (step: int, max_steps: int) -> bool #effects(all) {
  return max_steps >= 3 && step == max_steps - 2;
}

// Exploration nudge fires at steps 8 and 14 when no file edits have been made yet,
// preventing unbounded read/search spirals on complex multi-file coding tasks.
ik_guard_nudge_explore :: (step: int, files_edited: int) -> bool #effects(all) {
  return files_edited == 0 && (step == 8 || step == 14);
}

// Normalizes a read-only shell command for near-duplicate detection: trims leading/trailing
// whitespace, collapses runs of ASCII whitespace into one space, and drops simple quotes so
// `sed -n '1,60p' a.coax` and `sed -n  1,60p a.coax` produce the same canonical signature.
ik_guard_canon_cmd :: (cmd: string, out: [] u8) -> int #effects(all) {
  n := 0;
  in_ws: bool;
  for c: cmd {
    if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
      in_ws = true;
      continue;
    }
    if c == '\'' || c == '"' { continue; }
    if in_ws && n > 0 {
      if n >= out.count { break; }
      out[n] = ' ';
      n += 1;
    }
    in_ws = false;
    if n >= out.count { break; }
    out[n] = c;
    n += 1;
  }
  return n;
}

// Checks a read-only inspection/search shell command (cat/sed/grep/ls/find/head/tail/git log).
// Allows 1st and 2nd equivalent calls; short-circuits 3rd+ call with prior step > 0 until mutation.
ik_guard_check_read_cmd :: (g: [] IkGuard, cmd: string, is_readonly_cmd: bool, step: int) -> int #effects(all) {
  if !is_readonly_cmd { return 0; }
  cb: [512] u8;
  cn := ik_guard_canon_cmd(cmd, cb[..]);
  if cn == 0 { return 0; }
  sig := ik_guard_sig(IK_TK_CMD, cast(string) cb[0..<cn]);
  idx := ik_guard_find(g, IK_TK_CMD, sig);
  if idx >= 0 {
    if g[0].entries[idx].passed_check { return 0; }
    if g[0].entries[idx].count >= 2 { return g[0].entries[idx].step; }
    g[0].entries[idx].count += 1;
    return 0;
  }
  if g[0].n < IK_GUARD_SLOTS {
    g[0].entries[g[0].n] = IkGuardEntry.{kind = IK_TK_CMD, sig = sig, step = step, count = 1};
    g[0].n += 1;
  }
  return 0;
}

// Tracks consecutive failed edit_file calls on the same path (§9.3 #4).
// Returns the updated consecutive failure streak (>= 2 triggers a targeted re-read hint).
ik_guard_record_edit_fail :: (g: [] IkGuard, path: string) -> int #effects(all) {
  sig := ik_guard_sig(IK_TK_EDIT, path);
  if g[0].fail_edit_sig == sig {
    g[0].fail_edit_streak += 1;
  } else {
    g[0].fail_edit_sig = sig;
    g[0].fail_edit_streak = 1;
  }
  return g[0].fail_edit_streak;
}

// Tracks consecutive zero-match grep calls (§9.3 #4).
// Resets on any match; returns updated streak (>= 4 nudges toward list_dir / read_file).
ik_guard_record_grep :: (g: [] IkGuard, had_matches: bool) -> int #effects(all) {
  if had_matches {
    g[0].zero_grep_streak = 0;
    return 0;
  }
  g[0].zero_grep_streak += 1;
  return g[0].zero_grep_streak;
}

ik_guard_has_sub :: (hay: string, needle: string) -> bool #effects(all) {
  if needle.count == 0 || needle.count > hay.count { return false; }
  for i: 0..<hay.count - needle.count + 1 {
    ok := true;
    for k: 0..<needle.count {
      if hay[i + k] != needle[k] { ok = false; break; }
    }
    if ok { return true; }
  }
  return false;
}

// Detects shell-based workspace file edits (sed -i, perl -i, python open+write/write_text,
// or cat << heredoc redirected to a workspace file) so run_command redirects to edit_file (§9.2 #2).
// Commands targeting /tmp/ are always allowed.
ik_guard_is_shell_edit :: (cmd: string) -> bool #effects(all) {
  if ik_guard_has_sub(cmd, "/tmp/") { return false; }
  if ik_guard_has_sub(cmd, "sed -i") || ik_guard_has_sub(cmd, "perl -i") { return true; }
  if ik_guard_has_sub(cmd, "python") && (ik_guard_has_sub(cmd, "write_text(") || (ik_guard_has_sub(cmd, "open(") && ik_guard_has_sub(cmd, ".write("))) { return true; }
  if ik_guard_has_sub(cmd, "cat <<") && ik_guard_has_sub(cmd, " > ") { return true; }
  return false;
}

// Tracks consecutive duplicate-guard short-circuits; reset on any real tool execution.
ik_guard_note_block :: (g: [] IkGuard) -> int #effects(all) {
  g[0].dup_blocks += 1;
  return g[0].dup_blocks;
}

ik_guard_note_progress :: (g: [] IkGuard) #effects(all) {
  g[0].dup_blocks = 0;
}

// Final closing call disables tools at step >= max_steps so the model summarizes cleanly.
ik_guard_disable_tools :: (step: int, max_steps: int) -> bool #effects(all) {
  return step >= max_steps;
}

// Hard runtime cutoff: refuse executing further tool calls once step >= max_steps or after
// 3 consecutive duplicate-guard blocks without progress (prevents [step 80/30] spirals).
ik_guard_tools_exhausted :: (step: int, max_steps: int, dup_blocks: int) -> bool #effects(all) {
  return step >= max_steps || dup_blocks >= 3;
}

// ---------------------------------------------------------------- checks

#test "inky guard: duplicate reads allow 1st and 2nd call, block 3rd, and reset after mutation" {
  g: [1] IkGuard;
  ik_guard_init(g[..], 0);
  #assert g[0].max_steps == IK_MAX_STEPS_INTERACTIVE && g[0].n == 0 && g[0].files_edited == 0;
  ik_guard_init(g[..], 1);
  #assert g[0].max_steps == 1;
  ik_guard_init(g[..], 10);
  #assert g[0].max_steps == 10;
  // Exact golden signature pins both 32-bit FNV-1a lanes:
  // kind=1 ("a"): h1 = ((2166136261^1)^97)*16777619 & 0xffffffff = 0xe70c2dc7
  //               h2 = ((3735928559^18)^128)*16777619 & 0xffffffff = 0x159c039b
  #assert ik_guard_sig(IK_TK_READ, "a") == (cast(u64) 0xe50c2abf << 32) | cast(u64) 0x0882dec7;
  #assert ik_guard_sig(IK_TK_READ, "ab") != ik_guard_sig(IK_TK_READ, "ba");
  // Non-read kinds are ignored by check_read:
  #assert ik_guard_check_read(g[..], IK_TK_CMD, "ls", 1) == 0 && g[0].n == 0;
  // Same read_file: 1st & 2nd allowed, 3rd blocked with step 1:
  #assert ik_guard_check_read(g[..], IK_TK_READ, "a.coax:1-200", 1) == 0 && g[0].n == 1 && g[0].entries[0].count == 1;
  #assert ik_guard_check_read(g[..], IK_TK_READ, "a.coax:1-200", 2) == 0 && g[0].n == 1 && g[0].entries[0].count == 2;
  #assert ik_guard_check_read(g[..], IK_TK_READ, "a.coax:1-200", 3) == 1;
  // Different kind or different args are distinct:
  #assert ik_guard_check_read(g[..], IK_TK_GREP, "a.coax:1-200", 4) == 0 && g[0].n == 2;
  #assert ik_guard_check_read(g[..], IK_TK_LIST, ".", 5) == 0 && g[0].n == 3;
  #assert ik_guard_check_read(g[..], IK_TK_OUTLINE, "a.coax|", 5) == 0 && g[0].n == 4;
  #assert ik_guard_check_read(g[..], IK_TK_OUTLINE, "a.coax|", 6) == 0 && g[0].entries[3].count == 2;
  #assert ik_guard_check_read(g[..], IK_TK_OUTLINE, "a.coax|", 7) == 5;
  #assert ik_guard_sig(IK_TK_READ, "x") != ik_guard_sig(IK_TK_GREP, "x");
  #assert ik_guard_sig(IK_TK_READ, "x") != ik_guard_sig(IK_TK_READ, "y");
  // Mutation resets cache and increments files_edited when is_file_edit=true:
  ik_guard_mutated(g[..], false);
  #assert g[0].n == 0 && g[0].files_edited == 0;
  #assert ik_guard_check_read(g[..], IK_TK_READ, "a.coax:1-200", 6) == 0;
  ik_guard_mutated(g[..], true);
  #assert g[0].n == 0 && g[0].files_edited == 1;
}

#test "inky guard: duplicate passing check command short-circuits until mutation; failed checks rerun" {
  g: [1] IkGuard;
  ik_guard_init(g[..], 20);
  // Non-check command never intercepted or recorded:
  #assert ik_guard_check_cmd(g[..], "ls", false) == 0;
  ik_guard_record_cmd(g[..], "ls", false, 0, 1);
  #assert !g[0].has_check && g[0].n == 0;
  // Failing check is recorded in status, but does NOT block re-running:
  ik_guard_record_cmd(g[..], "coax test a.coax", true, 1, 2);
  #assert g[0].has_check && g[0].last_check_exit == 1 && g[0].n == 0;
  #assert ik_guard_check_cmd(g[..], "coax test a.coax", true) == 0;
  // Passing check records and blocks 2nd identical run with step 3:
  ik_guard_record_cmd(g[..], "coax test a.coax", true, 0, 3);
  #assert g[0].last_check_exit == 0 && g[0].n == 1;
  #assert ik_guard_check_cmd(g[..], "coax test a.coax", true) == 3;
  // Recording again updates step without duplicating entry:
  ik_guard_record_cmd(g[..], "coax test a.coax", true, 0, 5);
  #assert g[0].n == 1 && ik_guard_check_cmd(g[..], "coax test a.coax", true) == 5;
  // Different check command still allowed:
  #assert ik_guard_check_cmd(g[..], "coax test b.coax", true) == 0;
  // Mutation clears passing check cache:
  ik_guard_mutated(g[..], true);
  #assert ik_guard_check_cmd(g[..], "coax test a.coax", true) == 0;
}

#test "inky guard: capacity boundary and step budget thresholds" {
  g: [1] IkGuard;
  ik_guard_init(g[..], 30);
  buf: [8] u8;
  for i: 0..<IK_GUARD_SLOTS + 2 {
    k := json_write_int(buf[..], 0, i);
    #assert ik_guard_check_read(g[..], IK_TK_READ, cast(string) buf[0..<k], i + 1) == 0;
  }
  #assert g[0].n == IK_GUARD_SLOTS;
  // Also fill check command at full capacity safely (no overflow):
  ik_guard_record_cmd(g[..], "check_full", true, 0, 99);
  #assert g[0].n == IK_GUARD_SLOTS;
  // Step budget thresholds:
  #assert !ik_guard_warn_budget(0, 2) && !ik_guard_warn_budget(1, 2);
  #assert ik_guard_warn_budget(1, 3) && !ik_guard_warn_budget(2, 3);
  #assert ik_guard_warn_budget(28, 30) && !ik_guard_warn_budget(27, 30) && !ik_guard_warn_budget(29, 30);
  #assert !ik_guard_disable_tools(29, 30) && ik_guard_disable_tools(30, 30) && ik_guard_disable_tools(31, 30);
  // Exploration nudge thresholds:
  #assert !ik_guard_nudge_explore(7, 0) && ik_guard_nudge_explore(8, 0) && !ik_guard_nudge_explore(9, 0);
  #assert !ik_guard_nudge_explore(13, 0) && ik_guard_nudge_explore(14, 0) && !ik_guard_nudge_explore(15, 0);
  #assert !ik_guard_nudge_explore(8, 1) && !ik_guard_nudge_explore(14, 1);

  // Near-duplicate read-only shell command canonicalization & blocking:
  cb1: [64] u8; cb2: [64] u8; tiny: [4] u8;
  n1 := ik_guard_canon_cmd("  sed -n '1,60p'\tloop.coax \r\n", cb1[..]);
  n2 := ik_guard_canon_cmd("sed -n \"1,60p\"   loop.coax", cb2[..]);
  #assert cast(string) cb1[0..<n1] == "sed -n 1,60p loop.coax" && cast(string) cb2[0..<n2] == "sed -n 1,60p loop.coax";
  #assert ik_guard_canon_cmd("a b", cb1[..]) == 3 && cast(string) cb1[0..<3] == "a b";
  #assert ik_guard_canon_cmd("   \t\n ", cb1[..]) == 0;
  #assert ik_guard_canon_cmd("ab cd", tiny[..]) == 4 && cast(string) tiny[..] == "ab c";
  #assert ik_guard_canon_cmd("abc d", tiny[..]) == 4 && cast(string) tiny[..] == "abc ";
  #assert ik_guard_canon_cmd("abcd e", tiny[..]) == 4 && cast(string) tiny[..] == "abcd";
  g2: [1] IkGuard;
  ik_guard_init(g2[..], 30);
  // Non-readonly or blank commands never intercepted:
  #assert ik_guard_check_read_cmd(g2[..], "cat a.coax", false, 1) == 0 && g2[0].n == 0;
  #assert ik_guard_check_read_cmd(g2[..], "   ", true, 1) == 0 && g2[0].n == 0;
  // 1st and 2nd equivalent shell reads allowed, 3rd blocked with step 2:
  #assert ik_guard_check_read_cmd(g2[..], "sed -n '1,60p' a.coax", true, 2) == 0 && g2[0].n == 1 && g2[0].entries[0].count == 1;
  #assert g2[0].entries[0].sig == ik_guard_sig(IK_TK_CMD, "sed -n 1,60p a.coax");
  #assert ik_guard_check_read_cmd(g2[..], "sed -n  1,60p   a.coax", true, 3) == 0 && g2[0].n == 1 && g2[0].entries[0].count == 2;
  #assert ik_guard_check_read_cmd(g2[..], "sed -n \"1,60p\" a.coax", true, 4) == 2;
  // Passing check command entry is not treated as read_cmd dup:
  ik_guard_record_cmd(g2[..], "check_cmd", true, 0, 5);
  #assert ik_guard_check_read_cmd(g2[..], "check_cmd", true, 6) == 0;
  // Full table never overflows:
  g3: [1] IkGuard;
  ik_guard_init(g3[..], 30);
  for k: 0..<IK_GUARD_SLOTS + 2 {
    kb: [8] u8; kn := json_write_int(kb[..], 0, k);
    #assert ik_guard_check_read_cmd(g3[..], cast(string) kb[0..<kn], true, k + 1) == 0;
  }
  #assert g3[0].n == IK_GUARD_SLOTS;

  // Consecutive failed-edit & zero-match grep spiral guards + mutation reset:
  g4: [1] IkGuard;
  ik_guard_init(g4[..], 30);
  #assert ik_guard_record_edit_fail(g4[..], "a.coax") == 1 && g4[0].fail_edit_streak == 1;
  #assert ik_guard_record_edit_fail(g4[..], "a.coax") == 2 && g4[0].fail_edit_streak == 2;
  #assert ik_guard_record_edit_fail(g4[..], "b.coax") == 1 && g4[0].fail_edit_streak == 1 && g4[0].fail_edit_sig == ik_guard_sig(IK_TK_EDIT, "b.coax");
  #assert ik_guard_record_grep(g4[..], false) == 1 && ik_guard_record_grep(g4[..], false) == 2;
  #assert ik_guard_record_grep(g4[..], true) == 0 && g4[0].zero_grep_streak == 0;
  #assert ik_guard_record_grep(g4[..], false) == 1;
  ik_guard_mutated(g4[..], true);
  #assert g4[0].fail_edit_sig == 0 && g4[0].fail_edit_streak == 0 && g4[0].zero_grep_streak == 0;
  // After mutation reset, same path starts fresh at 1:
  #assert ik_guard_record_edit_fail(g4[..], "b.coax") == 1;

  // Substring helper & shell-edit detector:
  #assert !ik_guard_has_sub("abc", "") && !ik_guard_has_sub("ab", "abc");
  #assert ik_guard_has_sub("abc", "abc") && ik_guard_has_sub("xxab", "ab") && !ik_guard_has_sub("xxac", "ab");
  #assert !ik_guard_has_sub("xbc", "abc") && !ik_guard_has_sub("axb", "bc");
  #assert ik_guard_is_shell_edit("sed -i '' 's/a/b/' foo.coax");
  #assert ik_guard_is_shell_edit("perl -i -pe 's/a/b/' foo.coax");
  #assert ik_guard_is_shell_edit("python3 -c \"Path('a.py').write_text('x')\"");
  #assert ik_guard_is_shell_edit("python3 - <<'EOF'\nopen('a.py','w').write('x')\nEOF");
  #assert ik_guard_is_shell_edit("cat << 'EOF' > foo.coax\nhi\nEOF");
  #assert !ik_guard_is_shell_edit("sed -i '' 's/a/b/' /tmp/scratch.txt");
  #assert !ik_guard_is_shell_edit("python3 -m pytest tests/");
  #assert !ik_guard_is_shell_edit("python3 -c \"print(open('a.py').read())\"");
  #assert !ik_guard_is_shell_edit("cat << 'EOF'\nhello\nEOF");
  #assert !ik_guard_is_shell_edit("echo ok > /tmp/out.txt");
  #assert !ik_guard_is_shell_edit("coax test a.coax");

  // Consecutive duplicate-block streak & hard tool-exhaustion cutoff:
  g5: [1] IkGuard;
  ik_guard_init(g5[..], 30);
  #assert g5[0].dup_blocks == 0;
  #assert ik_guard_note_block(g5[..]) == 1 && ik_guard_note_block(g5[..]) == 2 && !ik_guard_tools_exhausted(29, 30, g5[0].dup_blocks);
  #assert ik_guard_note_block(g5[..]) == 3 && ik_guard_tools_exhausted(1, 30, g5[0].dup_blocks);
  ik_guard_note_progress(g5[..]);
  #assert g5[0].dup_blocks == 0 && !ik_guard_tools_exhausted(29, 30, 0) && ik_guard_tools_exhausted(30, 30, 0);
  #assert ik_guard_note_block(g5[..]) == 1;
  ik_guard_mutated(g5[..], false);
  #assert g5[0].dup_blocks == 0;
}
