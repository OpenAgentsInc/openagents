// Inky pure native Inkling 2.0 loop state machine (docs/coder/inky-spec.md §4, §7, §8).
// Completely I/O-free: consumes GwEvents, assembles parallel tool calls via GwToolStep,
// streams <|content_text|> and <|content_thinking|> directly, drives 2-stage compaction,
// and coordinates step budgets & steers cleanly.
//
// Checks: coax/bin/coax test coax/lib/inky/loop.coax --library

#load "compact.coax";
#load "guard.coax";
#load "../gateway/psionic.coax";

IK_PH_IDLE :: 0;
IK_PH_MODEL :: 1;
IK_PH_STREAM :: 2;
IK_PH_TOOLS :: 3;
IK_PH_ENDED :: 4;

IK_END_NONE :: 0;
IK_END_FINISHED :: 1;
IK_END_STOPPED :: 2;
IK_END_FAILED :: 3;
IK_END_NO_CAPACITY :: 4;
IK_END_BUDGET :: 5;

IK_THINK_CAP :: 32768;
IK_REPLY_CAP :: 65536;
IK_MAX_TOKENS_STEP :: 8192;

ik_ending_name :: (e: int) -> string {
  if e == IK_END_FINISHED { return "finished"; }
  if e == IK_END_STOPPED { return "stopped"; }
  if e == IK_END_NO_CAPACITY { return "no_capacity"; }
  if e == IK_END_BUDGET { return "budget"; }
  return "failed";
}

IkLoop :: struct {
  phase: int;
  step: int;
  max_ctx: int;
  profile: [32] u8; nprofile: int;
  system: [IK_PROMPT_MAX] u8; nsystem: int;
  guard: [1] IkGuard;
  tstep: [1] GwToolStep;
  reply: [IK_REPLY_CAP] u8; nreply: int;
  think: [IK_THINK_CAP + 64] u8; nthink: int;
  think_cut: bool;
  thought_emitted: bool;
  final_text: [IK_REPLY_CAP] u8; nfinal: int;
  ending: int;
  tool_idx: int;
  refused: bool;
  refuse_status: int;
  refuse_reason: [512] u8; nrefuse: int;
  done_reason: [32] u8; ndone: int;
  last_usage: GwUsage;
  obs_input_tokens: int;
  hybrid_exec: bool;
  adaptive_effort: bool;
  max_tokens_step: int;
  max_thinking_tokens: int;
  require_exit_verify: bool;
  edited_since_check: bool;
  exit_verify_nudged: bool;
  retried_ctx: bool;
  retried_stream: bool;
  retried_length: bool;
  retrying_same_step: bool;
}

IkFeedRes :: struct {
  emit_thought: bool;
  thought_delta: string;
  emit_reply: bool;
  reply_delta: string;
}

ik_loop_copy :: (dst: [] u8, src: string) -> int {
  n := ifx src.count < dst.count then src.count else dst.count;
  for i: 0..<n { dst[i] = src[i]; }
  return n;
}

ik_loop_system :: (l: [] IkLoop) -> string { return cast(string) l[0].system[0..<l[0].nsystem]; }
ik_loop_profile :: (l: [] IkLoop) -> string { return cast(string) l[0].profile[0..<l[0].nprofile]; }
ik_loop_think :: (l: [] IkLoop) -> string { return cast(string) l[0].think[0..<l[0].nthink]; }
ik_loop_reply :: (l: [] IkLoop) -> string { return cast(string) l[0].reply[0..<l[0].nreply]; }
ik_loop_final :: (l: [] IkLoop) -> string { return cast(string) l[0].final_text[0..<l[0].nfinal]; }
ik_loop_refuse_reason :: (l: [] IkLoop) -> string { return cast(string) l[0].refuse_reason[0..<l[0].nrefuse]; }

ik_loop_end :: (l: [] IkLoop, ending: int, text: string) -> int {
  l[0].ending = ending;
  l[0].nfinal = ik_loop_copy(l[0].final_text[..], text);
  l[0].phase = IK_PH_ENDED;
  return IK_PH_ENDED;
}

ik_loop_begin :: (l: [] IkLoop, h: [] IkHistory, tmp: [] IkHistory, system: string, profile: string, max_steps: int, max_ctx: int, task: string) -> bool {
  l[0] = IkLoop.{
    phase = IK_PH_MODEL,
    max_ctx = ifx max_ctx > 1024 then max_ctx else IK_DEFAULT_CTX,
  };
  l[0].nsystem = ik_loop_copy(l[0].system[..], system);
  l[0].nprofile = ik_loop_copy(l[0].profile[..], ifx profile.count > 0 then profile else "danger-full-access");
  ik_guard_init(l[0].guard[..], max_steps);

  need := ik_compact_needed(h, l[0].nsystem, l[0].max_ctx);
  if need >= 1 { _ = ik_compact_stage1(h, tmp); }
  if ik_compact_needed(h, l[0].nsystem, l[0].max_ctx) >= 2 { _ = ik_compact_stage2(h, tmp); }

  _ = ik_hist_begin_turn(h);
  if !ik_hist_user(h, task) {
    _ = ik_compact_stage2(h, tmp);
    if !ik_hist_user(h, task) {
      _ = ik_loop_end(l, IK_END_FAILED, "task exceeds conversation history capacity");
      return false;
    }
  }
  return true;
}

// Prepares the next Chat Completions request body into out_body; returns body slice or "" on error.
ik_loop_prepare_req :: (l: [] IkLoop, h: [] IkHistory, tmp: [] IkHistory, g: Gateway, model: string, effort: string, det_mode: bool, out_body: [] u8, out_why: [] string) -> string {
  if l[0].phase != IK_PH_MODEL { out_why[0] = "loop not ready for model request"; return ""; }
  if !l[0].retrying_same_step {
    l[0].step += 1;
  }
  l[0].retrying_same_step = false;

  need := ik_compact_needed_obs(h, l[0].nsystem, l[0].max_ctx, l[0].obs_input_tokens);
  if need >= 1 {
    if ik_compact_stage1(h, tmp) { l[0].obs_input_tokens = 0; }
  }
  if ik_compact_needed_obs(h, l[0].nsystem, l[0].max_ctx, l[0].obs_input_tokens) >= 2 {
    if ik_compact_stage2(h, tmp) { l[0].obs_input_tokens = 0; }
  }

  msgs: [IK_MAX_MSGS] GwMessage;
  gcalls: [IK_MAX_CALLS] GwToolCall;
  nm := ik_hist_messages(h, msgs[..], gcalls[..]);
  if nm <= 0 { out_why[0] = "empty conversation history"; return ""; }

  disable_tools := ik_guard_disable_tools(l[0].step, l[0].guard[0].max_steps);
  tbuf: [6144] u8;
  tools := ik_prompt_tools_for_mode(ik_loop_profile(l), disable_tools, l[0].hybrid_exec, tbuf[..]);

  // Adaptive effort scheduling (Level 1): during pure early discovery (steps 1..3 before any edit)
  // or final summary after a passing check, trim thinking overhead when effort == "medium".
  eff := effort;
  if l[0].adaptive_effort && effort == "medium" {
    if (l[0].step <= 3 && l[0].guard[0].files_edited == 0) ||
       (l[0].guard[0].has_check && l[0].guard[0].last_check_exit == 0 && l[0].guard[0].files_edited > 0) {
      eff = "low";
    }
  }
  max_tok := ifx l[0].max_tokens_step > 0 then l[0].max_tokens_step else IK_MAX_TOKENS_STEP;

  req := GwRequest.{
    model = model,
    system = ik_loop_system(l),
    messages = msgs[0..<nm],
    effort = eff,
    max_tokens = max_tok,
    max_thinking_tokens = l[0].max_thinking_tokens,
    stream = true,
    tools = tools,
    has_temp = true,
    temperature = ifx det_mode then 0.0 else 0.6,
    top_p = ifx det_mode then 1.0 else 0.95,
    top_k = ifx det_mode then 0 else 40,
    has_seed = det_mode,
    seed = 0,
  };
  body := gw_translate(g, req, out_body, out_why);
  if body.count == 0 {
    // If request overflowed buffer, try Stage 2 compaction once before giving up.
    if ik_compact_stage2(h, tmp) {
      nm = ik_hist_messages(h, msgs[..], gcalls[..]);
      if nm > 0 {
        req.messages = msgs[0..<nm];
        body = gw_translate(g, req, out_body, out_why);
      }
    }
    if body.count == 0 { return ""; }
  }

  gwt_step_begin(l[0].tstep[..]);
  l[0].nreply = 0;
  l[0].nthink = 0;
  l[0].think_cut = false;
  l[0].thought_emitted = false;
  l[0].refused = false;
  l[0].refuse_status = 0;
  l[0].nrefuse = 0;
  l[0].ndone = 0;
  l[0].last_usage = GwUsage.{};
  l[0].tool_idx = 0;
  l[0].phase = IK_PH_STREAM;
  return body;
}

// Appends one streamed reasoning delta to l[0].think (UTF-8 safe, capped at 32 KB) and returns
// the slice of bytes just appended so callers can emit thinking tokens immediately as they arrive.
ik_loop_append_think :: (l: [] IkLoop, text: string) -> string {
  if l[0].think_cut || text.count == 0 { return ""; }
  start := l[0].nthink;
  if l[0].nthink + text.count <= IK_THINK_CAP {
    for c: text { l[0].think[l[0].nthink] = c; l[0].nthink += 1; }
    return cast(string) l[0].think[start..<l[0].nthink];
  }
  room := IK_THINK_CAP - l[0].nthink;
  while room != 0 && text[room] >= 128 && text[room] < 192 { room -= 1; }
  for i: 0..<room { l[0].think[l[0].nthink] = text[i]; l[0].nthink += 1; }
  note := "\n[thinking truncated at 32 KB]";
  for c: note { l[0].think[l[0].nthink] = c; l[0].nthink += 1; }
  l[0].think_cut = true;
  return cast(string) l[0].think[start..<l[0].nthink];
}

// Consumes one GwEvent during IK_PH_STREAM; returns what UI deltas should be emitted now.
ik_loop_event :: (l: [] IkLoop, ev: GwEvent) -> IkFeedRes {
  res: IkFeedRes;
  if l[0].phase != IK_PH_STREAM { return res; }
  _ = gwt_step_feed(l[0].tstep[..], ev);
  if ev.kind == GW_EV_REASONING {
    delta := ik_loop_append_think(l, ev.text);
    if delta.count > 0 {
      res.emit_thought = true;
      res.thought_delta = delta;
    }
    return res;
  }
  if ev.kind == GW_EV_TEXT {
    for c: ev.text {
      if l[0].nreply < IK_REPLY_CAP { l[0].reply[l[0].nreply] = c; l[0].nreply += 1; }
    }
    if ev.text.count > 0 {
      res.emit_reply = true;
      res.reply_delta = ev.text;
    }
    return res;
  }
  if ev.kind == GW_EV_DONE {
    l[0].last_usage = ev.usage;
    if ev.usage.input_tokens > 0 { l[0].obs_input_tokens = ev.usage.input_tokens; }
    l[0].ndone = ik_loop_copy(l[0].done_reason[..], ev.reason);
    return res;
  }
  if ev.kind == GW_EV_REFUSED {
    l[0].refused = true;
    l[0].refuse_status = ev.status;
    l[0].nrefuse = ik_loop_copy(l[0].refuse_reason[..], ev.reason);
    return res;
  }
  return res;
}

// Seals the finished model stream and transitions to IK_PH_TOOLS, IK_PH_MODEL (retry/steer), or IK_PH_ENDED.
ik_loop_stream_end :: (l: [] IkLoop, h: [] IkHistory, tmp: [] IkHistory, transport_ok: bool, has_steers: bool) -> int {
  if l[0].phase != IK_PH_STREAM { return l[0].phase; }
  if l[0].refused {
    why := ik_loop_refuse_reason(l);
    if gw_too_long(l[0].refuse_status, why) && !l[0].retried_ctx {
      _ = ik_compact_stage1(h, tmp);
      if ik_compact_stage2(h, tmp) {
        l[0].retried_ctx = true;
        l[0].retrying_same_step = true;
        l[0].phase = IK_PH_MODEL;
        return IK_PH_MODEL;
      }
    }
    if l[0].refuse_status == 0 || l[0].refuse_status == 503 {
      return ik_loop_end(l, IK_END_NO_CAPACITY, ifx why.count > 0 then why else "local model server unavailable");
    }
    return ik_loop_end(l, IK_END_FAILED, ifx why.count > 0 then why else "model request refused");
  }

  sealed := gwt_step_end(l[0].tstep[..], transport_ok);
  if !sealed {
    // Allow partial text reply on clean length cut with 0 tool calls.
    done_r := cast(string) l[0].done_reason[0..<l[0].ndone];
    if transport_ok && done_r == "length" && l[0].tstep[0].n == 0 && l[0].nreply > 0 {
      none: [1] GwToolCall;
      _ = ik_hist_assistant(h, l[0].step, ik_loop_reply(l), ik_loop_think(l), none[0..<0]);
      if has_steers { l[0].phase = IK_PH_MODEL; return IK_PH_MODEL; }
      return ik_loop_end(l, IK_END_FINISHED, ik_loop_reply(l));
    }
    if !l[0].retried_stream {
      l[0].retried_stream = true;
      l[0].retrying_same_step = true;
      l[0].phase = IK_PH_MODEL;
      return IK_PH_MODEL;
    }
    return ik_loop_end(l, IK_END_FAILED, "incomplete or malformed model tool stream");
  }

  l[0].retried_ctx = false;
  l[0].retried_stream = false;

  // Handle degenerate length cut with 0 text and 0 tool calls (thinking exhausted max_tokens).
  // Allow at most ONE same-step retry via retried_length so it can never loop infinitely.
  done_r := cast(string) l[0].done_reason[0..<l[0].ndone];
  if l[0].tstep[0].n == 0 && l[0].nreply == 0 && done_r == "length" {
    if !l[0].retried_length {
      l[0].retried_length = true;
      l[0].retrying_same_step = true;
      l[0].phase = IK_PH_MODEL;
      return IK_PH_MODEL;
    }
    return ik_loop_end(l, IK_END_FAILED, "model exhausted output token budget during thinking without a reply");
  }
  l[0].retried_length = false;

  // Record assistant message with exact interleaved reasoning_content & tool_calls.
  calls: [IK_STEP_CALLS] GwToolCall;
  nc := l[0].tstep[0].n;
  for i: 0..<nc { calls[i] = gwt_step_call(l[0].tstep[..], i); }
  if !ik_hist_assistant(h, l[0].step, ik_loop_reply(l), ik_loop_think(l), calls[0..<nc]) {
    _ = ik_compact_stage2(h, tmp);
    if !ik_hist_assistant(h, l[0].step, ik_loop_reply(l), ik_loop_think(l), calls[0..<nc]) {
      return ik_loop_end(l, IK_END_FAILED, "conversation history full");
    }
  }

  if nc > 0 {
    if ik_guard_tools_exhausted(l[0].step, l[0].guard[0].max_steps, l[0].guard[0].dup_blocks) {
      if l[0].nreply > 0 { return ik_loop_end(l, IK_END_FINISHED, ik_loop_reply(l)); }
      if l[0].step >= l[0].guard[0].max_steps {
        return ik_loop_end(l, IK_END_BUDGET, "step budget reached; model emitted tool calls after tools were disabled");
      }
      return ik_loop_end(l, IK_END_FAILED, "stopped repeated duplicate tool calls without progress");
    }
    l[0].tool_idx = 0;
    l[0].phase = IK_PH_TOOLS;
    return IK_PH_TOOLS;
  }

  // Zero tool calls: natural finish (unless user steers are waiting or edited files lack a verification check).
  if has_steers {
    l[0].phase = IK_PH_MODEL;
    return IK_PH_MODEL;
  }
  if l[0].require_exit_verify && l[0].edited_since_check && !l[0].exit_verify_nudged && l[0].step + 1 < l[0].guard[0].max_steps {
    if ik_hist_steer(h, "Before finishing: you modified files without running a verification check since your last edit. Run the relevant build or test command and report its real result.") {
      l[0].exit_verify_nudged = true;
      l[0].phase = IK_PH_MODEL;
      return IK_PH_MODEL;
    }
  }
  if l[0].nreply == 0 {
    return ik_loop_end(l, IK_END_FAILED, "model ended the turn without a reply");
  }
  return ik_loop_end(l, IK_END_FINISHED, ik_loop_reply(l));
}

ik_loop_next_tool :: (l: [] IkLoop) -> GwToolCall {
  if l[0].phase != IK_PH_TOOLS || l[0].tool_idx >= l[0].tstep[0].n { return GwToolCall.{}; }
  return gwt_step_call(l[0].tstep[..], l[0].tool_idx);
}

// Records the current pending tool's result into history and advances to the next tool or model step.
ik_loop_tool_done :: (l: [] IkLoop, h: [] IkHistory, tmp: [] IkHistory, tool_kind: int, path_summary: string, exit_code: int, output: string, is_error: bool) -> int {
  if l[0].phase != IK_PH_TOOLS { return l[0].phase; }
  tc := gwt_step_call(l[0].tstep[..], l[0].tool_idx);
  is_last := l[0].tool_idx + 1 >= l[0].tstep[0].n;

  // Soft wrap-up notice (step == max_steps - 2), exploration nudge (steps 8, 14 with 0 edits),
  // or cache-safe step-budget awareness once past the halfway mark (docs/coder/inky-avenues-from-other-projects.md).
  final_out := output;
  wbuf: [24576] u8;
  if is_last && ik_guard_warn_budget(l[0].step, l[0].guard[0].max_steps) {
    n := ik_fmt_put(wbuf[..], 0, output);
    n = ik_fmt_put(wbuf[..], n, "\n[Step budget nearly reached: synthesize your findings and answer the user now.]");
    final_out = cast(string) wbuf[0..<n];
  } else if is_last && ik_guard_nudge_explore(l[0].step, l[0].guard[0].files_edited) {
    n := ik_fmt_put(wbuf[..], 0, output);
    n = ik_fmt_put(wbuf[..], n, "\n[Note: you have spent several steps exploring without making edits. State a brief 2-line plan (1: exact file + symbol to edit; 2: single verification command) and apply your targeted edit_file change now; otherwise answer directly.]");
    final_out = cast(string) wbuf[0..<n];
  } else if is_last && l[0].guard[0].max_steps >= 6 && l[0].step >= l[0].guard[0].max_steps / 2 {
    n := ik_fmt_put(wbuf[..], 0, output);
    n = ik_fmt_put(wbuf[..], n, "\n[step ");
    n = ik_fmt_int(wbuf[..], n, l[0].step);
    n = ik_fmt_byte(wbuf[..], n, '/');
    n = ik_fmt_int(wbuf[..], n, l[0].guard[0].max_steps);
    n = ik_fmt_byte(wbuf[..], n, ']');
    final_out = cast(string) wbuf[0..<n];
  }
  if !is_error && (tool_kind == IK_TK_EDIT || tool_kind == IK_TK_WRITE) {
    l[0].edited_since_check = true;
  }

  if !ik_hist_tool(h, l[0].step, tc.call_id, tc.name, tool_kind, path_summary, exit_code, final_out, is_error) {
    _ = ik_compact_stage1(h, tmp);
    if !ik_hist_tool(h, l[0].step, tc.call_id, tc.name, tool_kind, path_summary, exit_code, final_out, is_error) {
      return ik_loop_end(l, IK_END_FAILED, "conversation history full while recording tool result");
    }
  }

  l[0].tool_idx += 1;
  if l[0].tool_idx >= l[0].tstep[0].n {
    l[0].phase = IK_PH_MODEL;
  }
  return l[0].phase;
}

ik_loop_stop :: (l: [] IkLoop) -> int {
  return ik_loop_end(l, IK_END_STOPPED, "stopped");
}

// ---------------------------------------------------------------- checks

#test "inky loop: direct greeting finishes in 1 call with 0 tools and streams text directly" {
  l: [1] IkLoop; h: [1] IkHistory; tmp: [1] IkHistory;
  ik_hist_init(h[..]);
  #assert ik_loop_begin(l[..], h[..], tmp[..], "sys", "workspace-write", 30, 32768, "Hello!");
  ub: [128] u8; g := gw_psionic_native("http://127.0.0.1:18795", ub[..]);
  body_buf: [16384] u8; why: [1] string;
  body := ik_loop_prepare_req(l[..], h[..], tmp[..], g, "inkling-2-mini", "medium", false, body_buf[..], why[..]);
  #assert body.count > 0 && l[0].phase == IK_PH_STREAM && l[0].step == 1;

  f1 := ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = "Plain greeting, "});
  #assert f1.emit_thought && f1.thought_delta == "Plain greeting, " && !f1.emit_reply;
  f1b := ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = "answer directly."});
  #assert f1b.emit_thought && f1b.thought_delta == "answer directly." && !f1b.emit_reply;
  #assert ik_loop_think(l[..]) == "Plain greeting, answer directly.";
  f2 := ik_loop_event(l[..], GwEvent.{kind = GW_EV_TEXT, text = "Hello! "});
  #assert !f2.emit_thought && f2.emit_reply && f2.reply_delta == "Hello! ";
  f3 := ik_loop_event(l[..], GwEvent.{kind = GW_EV_TEXT, text = "How can I help?"});
  #assert !f3.emit_thought && f3.emit_reply && f3.reply_delta == "How can I help?";
  f4 := ik_loop_event(l[..], GwEvent.{kind = GW_EV_DONE, reason = "stop"});
  #assert !f4.emit_thought && !f4.emit_reply;
  #assert ik_loop_stream_end(l[..], h[..], tmp[..], true, false) == IK_PH_ENDED;
  #assert l[0].ending == IK_END_FINISHED && ik_loop_final(l[..]) == "Hello! How can I help?";
  #assert h[0].n == 2;
}

#test "inky loop: parallel tool calls, error recovery, soft wrap-up, and tool-disabled closing step" {
  l: [1] IkLoop; h: [1] IkHistory; tmp: [1] IkHistory;
  ik_hist_init(h[..]);
  // max_steps = 3 -> step 1 warns at step == max_steps - 2 (step 1), step 3 disables tools!
  #assert ik_loop_begin(l[..], h[..], tmp[..], "sys", "workspace-write", 3, 32768, "Inspect files");
  ub: [128] u8; g := gw_psionic_native("http://127.0.0.1:18795", ub[..]);
  body_buf: [32768] u8; why: [1] string;

  // Step 1: parallel 2 tool calls (also verify max_thinking_tokens wire propagation)
  l[0].max_thinking_tokens = 2048;
  b1 := ik_loop_prepare_req(l[..], h[..], tmp[..], g, "inkling-2-mini", "medium", true, body_buf[..], why[..]);
  #assert b1.count > 0 && cl_raw(b1, "tools").count > 10 && cl_raw(b1, "temperature") == "0.00" && cl_int(b1, "seed").value == 0 && cl_int(b1, "max_thinking_tokens").value == 2048;
  ft := ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = "Read both."});
  #assert ft.emit_thought && ft.thought_delta == "Read both.";
  f := ik_loop_event(l[..], GwEvent.{kind = GW_EV_TOOL, status = 0, call_id = "c1", text = "read_file", reason = "{\"path\":\"a.coax\"}"});
  #assert !f.emit_thought;
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_TOOL, status = 1, call_id = "c2", text = "read_file", reason = "{\"path\":\"b.coax\"}"});
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_DONE, reason = "tool_calls"});
  #assert ik_loop_stream_end(l[..], h[..], tmp[..], true, false) == IK_PH_TOOLS;

  tc0 := ik_loop_next_tool(l[..]);
  #assert tc0.call_id == "c1" && tc0.name == "read_file";
  #assert ik_loop_tool_done(l[..], h[..], tmp[..], IK_TK_READ, "a.coax", 1, "ENOENT", true) == IK_PH_TOOLS;
  tc1 := ik_loop_next_tool(l[..]);
  #assert tc1.call_id == "c2";
  #assert ik_loop_tool_done(l[..], h[..], tmp[..], IK_TK_READ, "b.coax", 0, "1\tok\n", false) == IK_PH_MODEL;
  // Soft wrap-up notice appended on final tool of step 1 (max_steps - 2 == 1):
  last_out := ik_hist_str(h[..], h[0].msgs[h[0].n - 1].text);
  #assert ik_prompt_has_ci(last_out, "Step budget nearly reached");

  // Step 2: one more tool call
  b2 := ik_loop_prepare_req(l[..], h[..], tmp[..], g, "inkling-2-mini", "medium", true, body_buf[..], why[..]);
  #assert b2.count > 0 && cl_raw(b2, "messages.3.is_error") == "true";
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_TOOL, status = 0, call_id = "c3", text = "list_dir", reason = "{}"});
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_DONE, reason = "tool_calls"});
  #assert ik_loop_stream_end(l[..], h[..], tmp[..], true, false) == IK_PH_TOOLS;
  #assert ik_loop_tool_done(l[..], h[..], tmp[..], IK_TK_LIST, ".", 0, "b.coax\n", false) == IK_PH_MODEL;

  // Step 3 (step == max_steps): tools MUST be disabled in request!
  b3 := ik_loop_prepare_req(l[..], h[..], tmp[..], g, "inkling-2-mini", "medium", true, body_buf[..], why[..]);
  #assert b3.count > 0 && cl_raw(b3, "tools").count == 0;
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_TEXT, text = "Summary: b.coax ok."});
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_DONE, reason = "stop"});
  #assert ik_loop_stream_end(l[..], h[..], tmp[..], true, false) == IK_PH_ENDED;
  #assert l[0].ending == IK_END_FINISHED && ik_loop_final(l[..]) == "Summary: b.coax ok.";
}

#test "inky loop: context_length_exceeded triggers Stage 2 compaction and automatic retry" {
  l: [1] IkLoop; h: [1] IkHistory; tmp: [1] IkHistory;
  ik_hist_init(h[..]);
  none: [1] GwToolCall;
  for t: 0..<4 {
    _ = ik_hist_begin_turn(h[..]);
    #assert ik_hist_user(h[..], "earlier question");
    #assert ik_hist_assistant(h[..], 1, "earlier answer", "", none[0..<0]);
  }
  #assert ik_loop_begin(l[..], h[..], tmp[..], "sys", "workspace-write", 30, 32768, "new question");
  ub: [128] u8; g := gw_psionic_native("http://127.0.0.1:18795", ub[..]);
  body_buf: [16384] u8; why: [1] string;
  #assert ik_loop_prepare_req(l[..], h[..], tmp[..], g, "inkling-2-mini", "medium", false, body_buf[..], why[..]).count > 0;
  before_n := h[0].n;
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_REFUSED, status = 400, reason = "context_length_exceeded"});
  #assert l[0].refuse_status == 400;
  // Should compact via Stage 2 and transition back to IK_PH_MODEL on same step!
  #assert ik_loop_stream_end(l[..], h[..], tmp[..], false, false) == IK_PH_MODEL;
  #assert h[0].n < before_n && l[0].retried_ctx && l[0].retrying_same_step;
}

#test "inky loop: reasoning deltas stream live with UTF-8-safe 32 KB truncation" {
  l: [1] IkLoop;
  // Ignored outside IK_PH_STREAM
  l[0].phase = IK_PH_MODEL;
  #assert !ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = "nope"}).emit_thought;

  // Empty and 1-byte reasoning deltas
  l[0].phase = IK_PH_STREAM;
  #assert !ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = ""}).emit_thought;
  f_one := ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = "a"});
  #assert f_one.emit_thought && f_one.thought_delta == "a";

  // Exact fit at IK_THINK_CAP does not truncate
  l[0].nthink = IK_THINK_CAP - 3;
  f_exact := ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = "abc"});
  #assert f_exact.emit_thought && f_exact.thought_delta == "abc" && !l[0].think_cut && l[0].nthink == IK_THINK_CAP;

  // Overflow with ASCII boundary (0x7F = 127) copies remaining room + note once, then suppresses further deltas
  l[0].nthink = IK_THINK_CAP - 2;
  l[0].think_cut = false;
  asc_cut := [4] u8.['x', 'y', 0x7F, 'z'];
  f_asc := ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = cast(string) asc_cut[..]});
  #assert f_asc.emit_thought && f_asc.thought_delta == "xy\n[thinking truncated at 32 KB]" && l[0].think_cut;
  f_after := ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = "more"});
  #assert !f_after.emit_thought && f_after.thought_delta == "";

  // Overflow where room lands on 0xC0 (192, first non-continuation byte) keeps preceding bytes intact
  l[0].nthink = IK_THINK_CAP - 2;
  l[0].think_cut = false;
  lead_cut := [4] u8.['a', 'b', 0xC0, 0xA9];
  f_lead := ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = cast(string) lead_cut[..]});
  #assert f_lead.emit_thought && f_lead.thought_delta == "ab\n[thinking truncated at 32 KB]" && l[0].think_cut;

  // Overflow where room lands inside a 3-byte UTF-8 char (continuation bytes 0x80 and 0xBF) backs up cleanly
  l[0].nthink = IK_THINK_CAP - 2;
  l[0].think_cut = false;
  mid_cut := [4] u8.['x', 0xE2, 0x80, 0xBF];
  f_mid := ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = cast(string) mid_cut[..]});
  #assert f_mid.emit_thought && f_mid.thought_delta == "x\n[thinking truncated at 32 KB]" && l[0].think_cut;

  // Overflow where room lands on 0xBF (191) and backs up to 0 copies 0 prefix bytes + note
  l[0].nthink = IK_THINK_CAP - 1;
  l[0].think_cut = false;
  zero_cut := [2] u8.[0xC2, 0xBF];
  f_zero := ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = cast(string) zero_cut[..]});
  #assert f_zero.emit_thought && f_zero.thought_delta == "\n[thinking truncated at 32 KB]" && l[0].think_cut;

  // Overflow where room == 0 with leading continuation byte (0x80) stops at 0 without underflow
  l[0].nthink = IK_THINK_CAP;
  l[0].think_cut = false;
  cont_zero := [1] u8.[0x80];
  f_full := ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = cast(string) cont_zero[..]});
  #assert f_full.emit_thought && f_full.thought_delta == "\n[thinking truncated at 32 KB]" && l[0].think_cut;

  // Empty vs 1-byte text delta and reply capacity boundary
  #assert !ik_loop_event(l[..], GwEvent.{kind = GW_EV_TEXT, text = ""}).emit_reply;
  l[0].nreply = IK_REPLY_CAP - 1;
  ft1 := ik_loop_event(l[..], GwEvent.{kind = GW_EV_TEXT, text = "z"});
  #assert ft1.emit_reply && ft1.reply_delta == "z" && l[0].nreply == IK_REPLY_CAP && l[0].reply[IK_REPLY_CAP - 1] == 'z';
  ft2 := ik_loop_event(l[..], GwEvent.{kind = GW_EV_TEXT, text = "q"});
  #assert ft2.emit_reply && l[0].nreply == IK_REPLY_CAP;

  // DONE updates last_usage, obs_input_tokens only when > 0, and done_reason
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_DONE, reason = "stop", usage = GwUsage.{input_tokens = 1, output_tokens = 2}});
  #assert l[0].last_usage.output_tokens == 2 && l[0].obs_input_tokens == 1 && cast(string) l[0].done_reason[0..<l[0].ndone] == "stop";
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_DONE, reason = "length", usage = GwUsage.{input_tokens = 0, output_tokens = 0}});
  #assert l[0].obs_input_tokens == 1 && cast(string) l[0].done_reason[0..<l[0].ndone] == "length";
}

#test "inky loop: empty length-cut retries once then fails, hard-stops tools past max_steps/dup_blocks, and rejects silent empty done" {
  l: [1] IkLoop; h: [1] IkHistory; tmp: [1] IkHistory;
  ik_hist_init(h[..]);
  #assert ik_loop_begin(l[..], h[..], tmp[..], "sys", "workspace-write", 2, 32768, "Do task");
  ub: [128] u8; g := gw_psionic_native("http://127.0.0.1:18795", ub[..]);
  body_buf: [16384] u8; why: [1] string;

  // 1st empty length cut retries once on same step; 2nd consecutive empty length cut fails cleanly (never loops infinitely).
  #assert ik_loop_prepare_req(l[..], h[..], tmp[..], g, "inkling-2-mini", "medium", true, body_buf[..], why[..]).count > 0;
  #assert l[0].step == 1;
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = "long thought..."});
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_DONE, reason = "length"});
  #assert ik_loop_stream_end(l[..], h[..], tmp[..], true, false) == IK_PH_MODEL && l[0].retried_length && l[0].retrying_same_step;
  #assert ik_loop_prepare_req(l[..], h[..], tmp[..], g, "inkling-2-mini", "medium", true, body_buf[..], why[..]).count > 0;
  #assert l[0].step == 1;
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_REASONING, text = "still thinking..."});
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_DONE, reason = "length"});
  #assert ik_loop_stream_end(l[..], h[..], tmp[..], true, false) == IK_PH_ENDED && l[0].ending == IK_END_FAILED;

  // Tool calls emitted at step >= max_steps end immediately with IK_END_BUDGET (never spin to step 80/30).
  ik_hist_init(h[..]);
  #assert ik_loop_begin(l[..], h[..], tmp[..], "sys", "workspace-write", 1, 32768, "Do task");
  #assert ik_loop_prepare_req(l[..], h[..], tmp[..], g, "inkling-2-mini", "medium", true, body_buf[..], why[..]).count > 0;
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_TOOL, status = 0, call_id = "c1", text = "run_command", reason = "{\"command\":\"ls\"}"});
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_DONE, reason = "tool_calls"});
  #assert ik_loop_stream_end(l[..], h[..], tmp[..], true, false) == IK_PH_ENDED && l[0].ending == IK_END_BUDGET;

  // 3 consecutive dup_blocks stop repeated duplicate tool calls cleanly.
  ik_hist_init(h[..]);
  #assert ik_loop_begin(l[..], h[..], tmp[..], "sys", "workspace-write", 10, 32768, "Do task");
  #assert ik_loop_prepare_req(l[..], h[..], tmp[..], g, "inkling-2-mini", "medium", true, body_buf[..], why[..]).count > 0;
  l[0].guard[0].dup_blocks = 3;
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_TOOL, status = 0, call_id = "c2", text = "run_command", reason = "{\"command\":\"ls\"}"});
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_DONE, reason = "tool_calls"});
  #assert ik_loop_stream_end(l[..], h[..], tmp[..], true, false) == IK_PH_ENDED && l[0].ending == IK_END_FAILED;

  // Silent empty 0-tool finish returns IK_END_FAILED instead of silent IK_END_FINISHED.
  ik_hist_init(h[..]);
  #assert ik_loop_begin(l[..], h[..], tmp[..], "sys", "workspace-write", 10, 32768, "Do task");
  #assert ik_loop_prepare_req(l[..], h[..], tmp[..], g, "inkling-2-mini", "medium", true, body_buf[..], why[..]).count > 0;
  _ = ik_loop_event(l[..], GwEvent.{kind = GW_EV_DONE, reason = "stop"});
  #assert ik_loop_stream_end(l[..], h[..], tmp[..], true, false) == IK_PH_ENDED && l[0].ending == IK_END_FAILED;
}
