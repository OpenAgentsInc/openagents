// Inky system prompt & native tool catalog (docs/coder/inky-spec.md §5–§6).
// Enforces a lean, zero-contradiction system prompt (<= 600 base tokens) and
// resolves user/workspace instruction conflicts in code before rendering.
// Internal codename "Inky" is NEVER exposed in the user-facing prompt persona.
//
// Checks: coax/bin/coax test coax/lib/inky/prompt.coax --library

#load "format.coax";

IK_PROMPT_MAX :: 8192;
IK_INSTR_CAP :: 2048;

// Default stock ~/.openagents/instructions.md template (coax/lib/agent/user-instructions.coax).
// Kept here as a pure constant so prompt.coax stays I/O-free and resolves the
// auto-commit vs no-unrequested-commit conflict cleanly in code.
IK_STOCK_UINSTR :: "When you work in a git repository:\n- When you have finished a change and its checks pass, commit it: only the files you changed, with a message that says what changed and why.\n- Then push the commit to its branch's upstream. If the push is refused because the remote moved, fetch, rebase onto it, run the checks again and push again. Never force-push and never skip the repository's hooks.\n- Don't leave finished work uncommitted or unpushed, unless the person asked you not to commit or push, or the repository's own instructions say otherwise.\n";

// Compact OpenAI Chat Completions tools array for Inky's 7 orthogonal native tools (~550 tokens).
IK_TOOLS_JSON :: "[{\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"description\":\"Read numbered lines from a file inside the workspace (or a saved command spill file). Default up to 200 lines / 16 KB from start_line.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Relative or workspace path\"},\"start_line\":{\"type\":\"integer\",\"description\":\"1-based start line (default 1)\"},\"end_line\":{\"type\":\"integer\",\"description\":\"1-based inclusive end line (optional)\"}},\"required\":[\"path\"]}}},{\"type\":\"function\",\"function\":{\"name\":\"edit_file\",\"description\":\"Replace exact text in an existing workspace file. Read the file first.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"old_string\":{\"type\":\"string\",\"description\":\"Exact non-empty text to find\"},\"new_string\":{\"type\":\"string\",\"description\":\"Replacement text\"},\"replace_all\":{\"type\":\"boolean\",\"description\":\"Replace every occurrence (default false)\"}},\"required\":[\"path\",\"old_string\",\"new_string\"]}}},{\"type\":\"function\",\"function\":{\"name\":\"write_file\",\"description\":\"Create a new workspace file (and parent directories) or overwrite an entire file.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"path\",\"content\"]}}},{\"type\":\"function\",\"function\":{\"name\":\"grep\",\"description\":\"Search workspace files for a regex or literal pattern. Returns PATH:LINE:text matches (never scans .git).\",\"parameters\":{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\"},\"path\":{\"type\":\"string\",\"description\":\"Subpath to search (default .)\"},\"glob\":{\"type\":\"string\",\"description\":\"Filename glob filter, e.g. *.coax\"},\"fixed_strings\":{\"type\":\"boolean\",\"description\":\"Treat pattern as literal text\"},\"max_results\":{\"type\":\"integer\",\"description\":\"Max matches (default 50, max 200)\"}},\"required\":[\"pattern\"]}}},{\"type\":\"function\",\"function\":{\"name\":\"list_dir\",\"description\":\"List directory entries inside the workspace cleanly (skips .git).\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Directory path (default .)\"},\"depth\":{\"type\":\"integer\",\"description\":\"Depth 1-3 (default 1)\"}},\"required\":[]}}},{\"type\":\"function\",\"function\":{\"name\":\"run_command\",\"description\":\"Run a shell command in the workspace (/bin/sh -c). Prefer read_file/grep/list_dir for inspection; use run_command for builds, tests, git, or scripts.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\"},\"timeout_seconds\":{\"type\":\"integer\",\"description\":\"Timeout 1-300s (default 120)\"}},\"required\":[\"command\"]}}},{\"type\":\"function\",\"function\":{\"name\":\"update_todos\",\"description\":\"Update the live checklist on multi-step tasks.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"todos\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"status\":{\"type\":\"string\",\"enum\":[\"pending\",\"in_progress\",\"completed\"]}},\"required\":[\"id\",\"content\",\"status\"]}}},\"required\":[\"todos\"]}}}]";

// Read-only toolset when sandbox profile == "read-only".
IK_TOOLS_READONLY_JSON :: "[{\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"description\":\"Read numbered lines from a file inside the workspace. Default up to 200 lines / 16 KB from start_line.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"start_line\":{\"type\":\"integer\"},\"end_line\":{\"type\":\"integer\"}},\"required\":[\"path\"]}}},{\"type\":\"function\",\"function\":{\"name\":\"grep\",\"description\":\"Search workspace files for a regex or literal pattern. Returns PATH:LINE:text matches.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"},\"glob\":{\"type\":\"string\"},\"fixed_strings\":{\"type\":\"boolean\"},\"max_results\":{\"type\":\"integer\"}},\"required\":[\"pattern\"]}}},{\"type\":\"function\",\"function\":{\"name\":\"list_dir\",\"description\":\"List directory entries inside the workspace cleanly (skips .git).\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"depth\":{\"type\":\"integer\"}},\"required\":[]}}},{\"type\":\"function\",\"function\":{\"name\":\"update_todos\",\"description\":\"Update the live checklist on multi-step tasks.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"todos\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"status\":{\"type\":\"string\",\"enum\":[\"pending\",\"in_progress\",\"completed\"]}},\"required\":[\"id\",\"content\",\"status\"]}}},\"required\":[\"todos\"]}}}]";

ik_prompt_tools_for :: (profile: string, tools_disabled: bool) -> string {
  if tools_disabled { return ""; }
  if profile == "read-only" { return IK_TOOLS_READONLY_JSON; }
  return IK_TOOLS_JSON;
}

ik_prompt_has_ci :: (hay: string, needle: string) -> bool {
  if needle.count == 0 || needle.count > hay.count { return false; }
  for i: 0..<hay.count - needle.count + 1 {
    ok := true;
    for k: 0..<needle.count {
      a := hay[i + k]; if a >= 'A' && a <= 'Z' { a += 32; }
      b := needle[k]; if b >= 'A' && b <= 'Z' { b += 32; }
      if a != b { ok = false; break; }
    }
    if ok { return true; }
  }
  return false;
}

ik_prompt_blank :: (s: string) -> bool {
  for c: s { if c != ' ' && c != '\n' && c != '\r' && c != '\t' { return false; } }
  return true;
}

ik_prompt_utf8_cut :: (s: string, limit: int) -> int {
  if limit <= 0 { return 0; }
  if limit >= s.count { return s.count; }
  n := limit;
  while n > 0 && (s[n] & 0xC0) == 0x80 { n -= 1; }
  return n;
}

ik_prompt_is_goal :: (task: string) -> bool {
  return ik_prompt_has_ci(task, "<goal_objective>");
}

// Whether raw user instructions match the stock auto-commit default (ignoring trailing whitespace).
ik_prompt_is_stock_uinstr :: (raw: string) -> bool {
  a := ik_fmt_trim_ws(raw);
  b := ik_fmt_trim_ws(IK_STOCK_UINSTR);
  return a == b;
}

// Builds Inky's zero-contradiction system prompt into out; returns byte count.
// Static rules precede per-workspace Environment metadata so cross-worktree/cross-chat
// sessions share the longest possible KV cache prefix and Workspace stays in the SWA recency window.
ik_prompt_build :: (os_name: string, cwd: string, git_info: string, user_instr: string, workspace_instr: string, is_goal: bool, out: [] u8) -> int {
  has_custom_user := !ik_prompt_blank(user_instr) && !ik_prompt_is_stock_uinstr(user_instr);
  user_mentions_git := has_custom_user && (ik_prompt_has_ci(user_instr, "commit") || ik_prompt_has_ci(user_instr, "push"));

  n := ik_fmt_put(out, 0, "You are OpenAgents, a local coding assistant running in the user's workspace.\n\nHow to work:\n");
  n = ik_fmt_put(out, n, "- For plain questions or conversation, answer directly without calling tools.\n");
  n = ik_fmt_put(out, n, "- To inspect files or search the repo, prefer `list_dir`, `grep`, and `read_file` over `run_command`.\n");
  n = ik_fmt_put(out, n, "- Before editing a file, read the relevant lines with `read_file`. Use `edit_file` for targeted changes and `write_file` for new files.\n");
  n = ik_fmt_put(out, n, "- After making code changes, run the relevant test or check command once with `run_command` to verify before answering.\n");
  n = ik_fmt_put(out, n, "- Stay inside the workspace directory below. Refuse destructive or out-of-workspace file operations unless explicitly authorized.\n");
  if !user_mentions_git {
    n = ik_fmt_put(out, n, "- Never run `git commit` or `git push` unless the user explicitly asks you to in their message.\n");
  }
  n = ik_fmt_put(out, n, "- Keep final replies clear, concise, and grounded in what you actually observed. Never guess file paths, symbols, or command outputs.\n");

  if has_custom_user {
    take := ik_prompt_utf8_cut(user_instr, IK_INSTR_CAP);
    n = ik_fmt_put(out, n, "\nUser instructions:\n");
    n = ik_fmt_put(out, n, cast(string) user_instr[0..<take]);
    if take < user_instr.count { n = ik_fmt_put(out, n, "\n[... user instructions truncated ...]\n"); }
    else if take > 0 && user_instr[take - 1] != '\n' { n = ik_fmt_byte(out, n, '\n'); }
  }

  if !ik_prompt_blank(workspace_instr) {
    take := ik_prompt_utf8_cut(workspace_instr, IK_INSTR_CAP);
    n = ik_fmt_put(out, n, "\nWorkspace instructions:\n");
    n = ik_fmt_put(out, n, cast(string) workspace_instr[0..<take]);
    if take < workspace_instr.count { n = ik_fmt_put(out, n, "\n[... workspace instructions truncated ...]\n"); }
    else if take > 0 && workspace_instr[take - 1] != '\n' { n = ik_fmt_byte(out, n, '\n'); }
  }

  if is_goal {
    n = ik_fmt_put(out, n, "\nGoal mode:\n");
    n = ik_fmt_put(out, n, "- Work systematically until the `<goal_objective>` acceptance criteria are verified by real tool output.\n");
    n = ik_fmt_put(out, n, "- Only end your final reply with `[GOAL_COMPLETE]` when every requirement is verified.\n");
    n = ik_fmt_put(out, n, "- If genuinely blocked after exhausting alternatives, end with `[GOAL_BLOCKED]` and state the concrete blocker.\n");
  }

  n = ik_fmt_put(out, n, "\nEnvironment:\n- OS: ");
  n = ik_fmt_put(out, n, ifx os_name.count > 0 then os_name else "macOS");
  n = ik_fmt_put(out, n, "\n- Workspace: ");
  n = ik_fmt_put(out, n, ifx cwd.count > 0 then cwd else ".");
  n = ik_fmt_put(out, n, "\n- Git repo: ");
  n = ik_fmt_put(out, n, ifx git_info.count > 0 then git_info else "unknown");
  n = ik_fmt_byte(out, n, '\n');

  return n;
}

// ---------------------------------------------------------------- checks

#test "inky prompt: base prompt is <= 2.2 KB, never exposes codename, and resolves stock git conflict" {
  out: [IK_PROMPT_MAX] u8;
  n := ik_prompt_build("macOS", "/work/repo", "yes (branch main)", IK_STOCK_UINSTR, "", false, out[..]);
  p := cast(string) out[0..<n];
  #assert n > 500 && n < 2200;
  #assert !ik_prompt_has_ci(p, "inky");
  #assert !ik_prompt_has_ci(p, "GOAL_COMPLETE");
  // Stock auto-commit instruction is suppressed so no contradiction with "Never run git commit":
  #assert !ik_prompt_has_ci(p, "Don't leave finished work uncommitted");
  #assert ik_prompt_has_ci(p, "Never run `git commit` or `git push`");

  // Custom user instructions mentioning commit suppress the conflicting base bullet:
  n2 := ik_prompt_build("Linux", "/work/repo", "yes", "Always commit with signoff.", "Use tabs.", true, out[..]);
  p2 := cast(string) out[0..<n2];
  #assert !ik_prompt_has_ci(p2, "Never run `git commit` or `git push`");
  #assert ik_prompt_has_ci(p2, "Always commit with signoff.");
  #assert ik_prompt_has_ci(p2, "Use tabs.");
  #assert ik_prompt_has_ci(p2, "[GOAL_COMPLETE]");

  // Cross-worktree KV prefix stability: different workspaces/branches share the entire
  // static persona + How to work prefix (Environment sits at the end for SWA recency).
  out_a: [IK_PROMPT_MAX] u8;
  out_b: [IK_PROMPT_MAX] u8;
  na := ik_prompt_build("macOS", "/work/wt-alpha", "yes (branch feat-a)", "", "", false, out_a[..]);
  nb := ik_prompt_build("macOS", "/work/wt-beta", "yes (branch feat-b)", "", "", false, out_b[..]);
  shared := 0;
  lim := ifx na < nb then na else nb;
  while shared < lim && out_a[shared] == out_b[shared] { shared += 1; }
  #assert shared > 750;
}

#test "inky prompt: native tool declarations are valid JSON arrays with expected tool counts" {
  #assert json_valid(IK_TOOLS_JSON) && cl_count(IK_TOOLS_JSON) == 7;
  #assert json_valid(IK_TOOLS_READONLY_JSON) && cl_count(IK_TOOLS_READONLY_JSON) == 4;
  #assert ik_prompt_tools_for("workspace-write", false) == IK_TOOLS_JSON;
  #assert ik_prompt_tools_for("read-only", false) == IK_TOOLS_READONLY_JSON;
  #assert ik_prompt_tools_for("workspace-write", true) == "";
  #assert ik_prompt_is_goal("Please finish <goal_objective>fix bug</goal_objective>");
  #assert !ik_prompt_is_goal("Hello, how is it going?");
}
