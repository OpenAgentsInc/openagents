// lean-run: OpenAgents Desktop Lean 4 & Riemann Hypothesis Gym CLI (Epic #13943, #13944, #13945;
// docs/lean/spec.md, docs/lean/riemann-hypothesis-workbench-spec.md).
//
// Bundled beside ple-run and oasim in OpenAgents.app/Contents/Resources/lean-run so both users
// and agents (Microcoder / Claude) can invoke real Lean 4 kernel verification, steer Gym -> Lean,
// emit OA-SHOW verification cards, and drive the 175,187-module Riemann Hypothesis index.
//
// Verbs:
//   lean-run doctor [--json]
//   lean-run verify FILE TARGET [--statement SIG] [--card OUT.jpg] [--json]
//   lean-run sample [--out DIR]
//   lean-run gym [--view tour|atlas|math|inspect|trust|prover] [--module MOD] [--decl DECL]
//                [--tour-step N] [--search QUERY] [--math-tab strip|robin|primes]
//                [--file PATH] [--line N] [--no-open] [--wait S]
//   lean-run card --out FILE.jpg [--fail]
//   lean-run help
//
//   coax/web/tool.sh coder/tui/lean-run.coax doctor --json
#import "Basic";
#load "../sys/tool.coax";
#load "rh-index.coax";
#load "gym.coax";
#load "host.coax";
#load "atif.coax";
#load "audit.coax";
#load "lean-run-mcp.coax";

cxproc_self_path :: (out: [] u8) -> int #foreign #effects(all);
cxterm_write :: (s: [] u8) -> int #foreign #effects(all);
cxterm_byte :: (timeout_ms: int) -> int #foreign #effects(all);

LR_GYM_WAIT_S :: 15;

lr_int_str :: (v: int, out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out); jo_int(o[..], v);
  return jo_text(o[..]);
}

lr_usage :: () -> int {
  print("lean-run — OpenAgents Lean 4 & Riemann Hypothesis Gym CLI\n\n");
  print("Usage:\n");
  print("  lean-run doctor [--json]\n");
  print("  lean-run verify FILE TARGET [--statement SIG] [--card OUT.jpg] [--json]\n");
  print("  lean-run atif-export --file FILE --target TARGET [--statement SIG] [--run ID]\n");
  print("                       [--task ID] [--model M] [--prompt P] [--out-dir DIR] [--json]\n");
  print("  lean-run goal FILE LINE COL [--json]\n");
  print("  lean-run try FILE LINE COL TACTIC [--json]\n");
  print("  lean-run hover FILE LINE COL [--json]\n");
  print("  lean-run diagnostics FILE [--json]\n");
  print("  lean-run search FILE LINE COL --tactics \"rfl,simp,omega\" [--json]\n");
  print("  lean-run bench start|status|stop [--suite NAME] [--run-dir DIR] [--solutions-dir DIR] [--json]\n");
  print("  lean-run host status|stop|serve\n");
  print("  lean-run mcp\n");
  print("  lean-run sample [--out DIR]\n");
  print("  lean-run gym [--view tour|atlas|math|inspect|trust|prover] [--module MOD]\n");
  print("               [--decl DECL] [--tour-step N] [--search Q] [--math-tab strip|robin|primes]\n");
  print("               [--no-open] [--wait S]\n");
  print("  lean-run card --out FILE.jpg [--fail]\n");
  print("  lean-run rh fetch [--dest DIR]\n");
  print("  lean-run rh index [--corpus DIR] [--out DIR] [--json]\n");
  print("  lean-run rh search QUERY [--limit N] [--decls] [--json]\n");
  print("  lean-run rh path MODULE [--json]\n");
  print("  lean-run rh cone MODULE [--limit N] [--json]\n");
  print("  lean-run rh module MODULE [--lines N] [--json]\n");
  print("  lean-run rh simplify MODULE_OR_FILE DECL CANDIDATE.lean [--out-patch F] [--allow-same-len] [--json]\n");
  print("  lean-run rh audit [--tier-c] [--file F --target T --statement S] [--remote-manifest F] [--json]\n");
  return 0;
}

lr_cmd_doctor :: (a: [] Args, home: string) -> int {
  doc: [1] LwDoctor;
  lv_doctor(home, doc[..]);
  if args_has(a, "--json") {
    buf: [8192] u8;
    n := lw_doctor_write(doc[..], buf[..]);
    if n <= 0 { tool_errln("lean-run doctor: failed to format JSON"); return 1; }
    print("%\n", cast(string) buf[0..<n]);
    return 0;
  }
  print("OpenAgents Lean 4 Doctor\n");
  print("  elan:   %\n", ifx doc[0].elan_found then cast(string) doc[0].elan_path[0..<doc[0].elan_path_n] else "not found");
  print("  lean:   %\n", ifx doc[0].lean_found then cast(string) doc[0].lean_version[0..<doc[0].lean_version_n] else "not found");
  print("  lake:   %\n", ifx doc[0].lake_found then cast(string) doc[0].lake_version[0..<doc[0].lake_version_n] else "not found");
  print("  RH corpus: %\n", ifx doc[0].rh_corpus_present then "present (~/.openagents/lean/corpora/riemann-hypothesis)" else "absent (run `lean-run rh fetch`)");
  print("  RH index:  % (% modules)\n", ifx doc[0].rh_index_present then "ready" else "not built", doc[0].rh_modules);
  print("  status: %\n", cast(string) doc[0].note[0..<doc[0].note_n]);
  return 0;
}

lr_cmd_verify :: (a: [] Args, home: string) -> int {
  file := args_at(a, 1);
  target := args_at(a, 2);
  if file.count == 0 || target.count == 0 {
    tool_errln("usage: lean-run verify FILE TARGET [--statement SIG] [--card OUT.jpg] [--json]");
    return 2;
  }
  stmt := args_value(a, "--statement", "");
  card := args_value(a, "--card", "");
  ver: [1] LwVerify;
  lv_verify_file(home, file, target, stmt, ver[..]);

  if card.count > 0 {
    _ = lv_render_card_jpg(ver[0].verified, card);
  }
  if args_has(a, "--json") {
    buf: [8192] u8;
    n := lw_verify_write(ver[..], buf[..]);
    if n <= 0 { tool_errln("lean-run verify: failed to format JSON"); return 1; }
    print("%\n", cast(string) buf[0..<n]);
    return ifx ver[0].verified then 0 else 1;
  }
  print("Lean 4 Verification: % (%)\n", ifx ver[0].verified then "VERIFIED" else "REJECTED", cast(string) ver[0].verdict[0..<ver[0].verdict_n]);
  print("  file:    %\n", cast(string) ver[0].file[0..<ver[0].file_n]);
  print("  target:  %\n", cast(string) ver[0].target[0..<ver[0].target_n]);
  print("  sha256:  %\n", cast(string) ver[0].file_sha256[0..<ver[0].file_sha256_n]);
  print("  time:    % ms (exit %)\n", ver[0].elapsed_ms, ver[0].exit_code);
  print("  axioms:  ");
  if ver[0].axiom_count == 0 { print("(none)"); }
  for i: 0..<ver[0].axiom_count {
    if i > 0 { print(", "); }
    print("%", cast(string) ver[0].axioms[i][0..<ver[0].axioms_n[i]]);
  }
  print("\n  message: %\n", cast(string) ver[0].message[0..<ver[0].message_n]);
  if card.count > 0 {
    print("OA-SHOW: %\n", card);
    print("OA-SHOW-CAPTION: Lean 4 %: % (%)\n", ifx ver[0].verified then "VERIFIED" else "REJECTED", target, cast(string) ver[0].verdict[0..<ver[0].verdict_n]);
    print("OA-SHOW-OPEN: %\n", file);
  }
  return ifx ver[0].verified then 0 else 1;
}

lr_cmd_sample :: (a: [] Args, home: string) -> int {
  out_dir := args_value(a, "--out", "");
  db: [FS_PATH_MAX] u8;
  if out_dir.count == 0 {
    out_dir = fs_join(home, ".openagents/lean/samples/add_zero_right", db[..]);
  }
  if !fs_mkdir_all(out_dir) {
    tool_errln("lean-run sample: could not create sample directory");
    return 1;
  }
  p0: [FS_PATH_MAX] u8; p1: [FS_PATH_MAX] u8; p2: [FS_PATH_MAX] u8;
  f_lake := fs_join(out_dir, "lakefile.toml", p0[..]);
  f_tc := fs_join(out_dir, "lean-toolchain", p1[..]);
  f_src := fs_join(out_dir, "AddZeroRight.lean", p2[..]);
  ok := fs_write(f_lake, "name = \"add_zero_right\"\ndefaultTargets = [\"AddZeroRight\"]\n\n[[lean_lib]]\nname = \"AddZeroRight\"\n")
    && fs_write(f_tc, "leanprover/lean4:v4.33.1\n")
    && fs_write(f_src, "theorem add_zero_right (n : Nat) : n + 0 = n := by\n  rfl\n\ntheorem add_comm_nat (a b : Nat) : a + b = b + a := by\n  induction b with\n  | zero => rw [Nat.add_zero, Nat.zero_add]\n  | succ k ih => rw [Nat.add_succ, Nat.succ_add, ih]\n");
  if !ok {
    tool_errln("lean-run sample: could not write sample files");
    return 1;
  }
  print("Wrote Lean 4 sample project to %\n", out_dir);
  print("Verify with: lean-run verify % add_zero_right\n", f_src);
  return 0;
}

lr_cmd_gym :: (a: [] Args, home: string) -> int {
  db: [FS_PATH_MAX] u8;
  dir := fs_join(home, ".openagents/lean", db[..]);
  if !fs_mkdir_all(dir) { tool_errln("lean-run gym: could not create ~/.openagents/lean"); return 1; }

  req: [1] LwGymReq;
  ib: [64] u8; nb: [32] u8;
  id_n := lv_cat(ib[..], 0, "lean-run-");
  id_n = lv_cat(ib[..], id_n, lr_int_str(cxproc_wall_us(), nb[..]));
  id := cast(string) ib[0..<id_n];

  req[0].id_n = lw_put(req[0].id[..], id);
  req[0].open = !args_has(a, "--no-open");
  req[0].view_n = lw_put(req[0].view[..], args_value(a, "--view", ""));
  req[0].mod_name_n = lw_put(req[0].mod_name[..], args_value(a, "--module", ""));
  req[0].decl_n = lw_put(req[0].decl[..], args_value(a, "--decl", ""));
  req[0].search_n = lw_put(req[0].search[..], args_value(a, "--search", ""));
  req[0].math_tab_n = lw_put(req[0].math_tab[..], args_value(a, "--math-tab", ""));
  req[0].file_n = lw_put(req[0].file[..], args_value(a, "--file", ""));
  ts := args_whole(args_value(a, "--tour-step", ""));
  if ts > 0 { req[0].tour_step = ts; }
  ln := args_whole(args_value(a, "--line", ""));
  if ln > 0 { req[0].line = ln; }

  rb: [8192] u8;
  rn := lw_gym_req_write(req[..], rb[..]);
  if rn <= 0 { tool_errln("lean-run gym: failed to serialize request"); return 2; }

  // Validate through dc_lean_gym_plan before sending to the app
  pb: [8192] u8;
  plan := dc_lean_gym_plan(cast(string) rb[0..<rn], pb[..]);
  if plan.count >= 12 && cast(string) plan[0..<12] == "{\"ok\":false," {
    tool_err("lean-run gym: invalid request: "); tool_errln(plan);
    return 2;
  }

  qp_b: [FS_PATH_MAX] u8; tp_b: [FS_PATH_MAX] u8; sp_b: [FS_PATH_MAX] u8;
  qp := fs_join(dir, "gym-request.json", qp_b[..]);
  tp := fs_join(dir, "gym-request.json.tmp", tp_b[..]);
  sp := fs_join(dir, "gym-state.json", sp_b[..]);
  if !fs_write(tp, cast(string) rb[0..<rn]) || !fs_rename(tp, qp) {
    tool_errln("lean-run gym: could not write ~/.openagents/lean/gym-request.json");
    return 1;
  }

  wait_s := args_whole(args_value(a, "--wait", ""));
  if wait_s <= 0 { wait_s = LR_GYM_WAIT_S; }
  until := proc_now_ms() + wait_s * 1000;
  while proc_now_ms() < until {
    proc_sleep(200);
    st_b: [16384] u8;
    sn := fs_read(sp, st_b[..]);
    if sn <= 0 { continue; }
    st: [1] LwGymState;
    if !lw_gym_state_read(cast(string) st_b[0..<sn], st[..]) { continue; }
    if cast(string) st[0].id[0..<st[0].id_n] != id { continue; }
    if args_has(a, "--json") {
      print("%\n", cast(string) st_b[0..<sn]);
      return ifx st[0].ok then 0 else 1;
    }
    if !st[0].ok {
      tool_err("lean-run gym refused: "); tool_errln(cast(string) st[0].error[0..<st[0].error_n]);
      return 1;
    }
    print("Lean Gym view: % | RH loaded: % (% modules, % theorems) | module: % | tour step: %\n",
      cast(string) st[0].view[0..<st[0].view_n],
      ifx st[0].rh_loaded then "yes" else "no",
      st[0].rh_modules, st[0].rh_theorems,
      cast(string) st[0].mod_name[0..<st[0].mod_name_n],
      st[0].tour_step);
    return 0;
  }
  tool_errln("lean-run gym: timed out waiting for OpenAgents Desktop (is it running with Experimental features on?)");
  return 1;
}

lr_cmd_card :: (a: [] Args) -> int {
  out := args_value(a, "--out", "");
  if out.count == 0 { tool_errln("usage: lean-run card --out FILE.jpg [--fail]"); return 2; }
  ok := !args_has(a, "--fail");
  if !lv_render_card_jpg(ok, out) { tool_errln("lean-run card: failed to render JPEG"); return 1; }
  print("OA-SHOW: %\n", out);
  print("OA-SHOW-CAPTION: Lean 4 %\n", ifx ok then "VERIFIED" else "REJECTED");
  return 0;
}

lr_rh_corpus_dir :: (a: [] Args, home: string, out: [] u8) -> string {
  given := args_value(a, "--corpus", "");
  if given.count > 0 { return cast(string) out[0..<lw_put(out, given)]; }
  return fs_join(home, ".openagents/lean/corpora/riemann-hypothesis", out);
}

lr_rh_index_dir :: (a: [] Args, home: string, out: [] u8) -> string {
  given := args_value(a, "--out", "");
  if given.count > 0 { return cast(string) out[0..<lw_put(out, given)]; }
  return fs_join(home, ".openagents/lean/index", out);
}

lr_rh_load :: (w: [] RhIndexWork, home: string) -> bool {
  ib: [FS_PATH_MAX] u8; bp: [FS_PATH_MAX] u8;
  idx_dir := fs_join(home, ".openagents/lean/index", ib[..]);
  return rhi_load_bin(w, fs_join(idx_dir, "rh-modules.bin", bp[..]));
}

lr_cmd_rh :: (a: [] Args, home: string) -> int {
  sub := args_at(a, 1);
  if sub.count == 0 || sub == "help" { return lr_usage(); }

  if sub == "fetch" {
    db: [FS_PATH_MAX] u8;
    dest := args_value(a, "--dest", "");
    if dest.count == 0 { dest = fs_join(home, ".openagents/lean/corpora/riemann-hypothesis", db[..]); }
    mb: [FS_PATH_MAX] u8;
    if fs_kind(fs_join(dest, "src/Main.lean", mb[..])) == FS_FILE {
      print("RH corpus already present at %\n", dest);
      return 0;
    }
    _ = fs_mkdir_all(fs_dir(dest));
    h := proc_new();
    _ = proc_arg(h, "git"); _ = proc_arg(h, "clone"); _ = proc_arg(h, "--depth=1");
    _ = proc_arg(h, "https://github.com/leanprover-community/riemann-hypothesis.git");
    _ = proc_arg(h, dest);
    _ = proc_err_ours(h);
    if proc_start(h) != 0 { _ = proc_release(h); tool_errln("lean-run rh fetch: failed to start git"); return 1; }
    st := proc_wait(h, 600000);
    _ = proc_release(h);
    if st != 0 { tool_errln("lean-run rh fetch: git clone failed"); return 1; }
    print("Cloned Riemann Hypothesis corpus into %\n", dest);
    return 0;
  }

  if sub == "simplify" {
    mod_f := args_at(a, 2);
    decl := args_at(a, 3);
    cand := args_at(a, 4);
    if mod_f.count == 0 || decl.count == 0 || cand.count == 0 {
      tool_errln("usage: lean-run rh simplify MODULE_OR_FILE DECL CANDIDATE.lean [--out-patch FILE] [--allow-same-len] [--json]");
      return 2;
    }
    return la_rh_simplify(home, mod_f, decl, cand, args_value(a, "--out-patch", ""), args_has(a, "--allow-same-len"), args_has(a, "--json"));
  }

  if sub == "audit" && args_has(a, "--tier-c") {
    return la_tier_c_audit(
      home,
      args_value(a, "--file", ""),
      args_value(a, "--target", ""),
      args_value(a, "--statement", ""),
      args_value(a, "--remote-manifest", ""),
      args_has(a, "--json")
    );
  }

  w: [1] RhIndexWork;

  if sub == "index" {
    cb: [FS_PATH_MAX] u8; ob: [FS_PATH_MAX] u8;
    corp := lr_rh_corpus_dir(a, home, cb[..]);
    outd := lr_rh_index_dir(a, home, ob[..]);
    man: [1] LwRhIndex;
    if !rhi_build(w[..], corp, outd, man[..]) {
      tool_errln("lean-run rh index: indexing failed (is corpus fetched at ~/.openagents/lean/corpora/riemann-hypothesis?)");
      return 1;
    }
    if args_has(a, "--json") {
      jb: [4096] u8; jn := lw_rh_index_write(man[..], jb[..]);
      print("%\n", cast(string) jb[0..<jn]);
      return 0;
    }
    print("Indexed Riemann Hypothesis corpus in % ms\n", man[0].elapsed_ms);
    print("  corpus:    % (commit %, %)\n", cast(string) man[0].corpus_path[0..<man[0].corpus_path_n], cast(string) man[0].corpus_commit[0..<man[0].corpus_commit_n], cast(string) man[0].lean_toolchain[0..<man[0].lean_toolchain_n]);
    print("  modules:   %  |  edges: %  |  max depth from Main: %\n", man[0].modules, man[0].edges, man[0].max_depth);
    print("  theorems:  %  |  defs: %  |  lines: %  |  bytes: %\n", man[0].theorems, man[0].defs, man[0].lines, man[0].bytes);
    print("  clusters:  %  |  metaprog files: %\n", w[0].n_clusters, man[0].metaprog_files);
    print("  index dir: %\n", outd);
    return 0;
  }

  if !lr_rh_load(w[..], home) {
    tool_errln("lean-run rh: binary index not found — run `lean-run rh index` first");
    return 1;
  }

  if sub == "search" {
    q := args_at(a, 2);
    if q.count == 0 { tool_errln("usage: lean-run rh search QUERY [--limit N] [--decls] [--json]"); return 2; }
    limit := args_whole(args_value(a, "--limit", ""));
    if limit <= 0 || limit > 200 { limit = 25; }
    want_json := args_has(a, "--json");
    t0 := proc_now_ms();
    found := 0;
    if args_has(a, "--decls") {
      // Stream rh-decls.tsv (1M+ declarations)
      ib: [FS_PATH_MAX] u8; dp: [FS_PATH_MAX] u8;
      dpath := fs_join(fs_join(home, ".openagents/lean/index", ib[..]), "rh-decls.tsv", dp[..]);
      o: [1] Jo; if want_json { jo_start(o[..], w[0].iobuf[..]); jo_obj(o[..]); jo_key(o[..], "query"); jo_str(o[..], q); jo_key(o[..], "hits"); jo_arr(o[..]); }
      off := 0; carry: [1024] u8; cn := 0;
      while found < limit {
        got := fs_read_at(dpath, off, w[0].fbuf[..]);
        if got <= 0 { break; }
        off += got;
        st := 0;
        for i: 0..<got {
          if w[0].fbuf[i] == '\n' {
            line := "";
            if cn > 0 {
              take := i - st; if cn + take > 1024 { take = 1024 - cn; }
              for k: 0..<take { carry[cn + k] = w[0].fbuf[st + k]; }
              line = cast(string) carry[0..<cn + take]; cn = 0;
            } else { line = cast(string) w[0].fbuf[st..<i]; }
            st = i + 1;
            if rh_contains_ci(line, q) {
              // parse mod_id\tline\tkind\tname
              t1 := 0; while t1 < line.count && line[t1] != '\t' { t1 += 1; }
              t2 := t1 + 1; while t2 < line.count && line[t2] != '\t' { t2 += 1; }
              t3 := t2 + 1; while t3 < line.count && line[t3] != '\t' { t3 += 1; }
              if t3 < line.count {
                mid := args_whole(cast(string) line[0..<t1]);
                lno := args_whole(cast(string) line[t1 + 1..<t2]);
                kd := cast(string) line[t2 + 1..<t3];
                dn := cast(string) line[t3 + 1..<line.count];
                if rh_contains_ci(dn, q) && mid >= 0 && mid < w[0].n_mods {
                  mname := rhi_mod_name(w[..], mid);
                  if want_json {
                    jo_obj(o[..]); jo_key(o[..], "decl"); jo_str(o[..], dn); jo_key(o[..], "kind"); jo_str(o[..], kd);
                    jo_key(o[..], "module"); jo_str(o[..], mname); jo_key(o[..], "line"); jo_int(o[..], lno);
                    jo_key(o[..], "depth"); jo_int(o[..], cast(int) w[0].m_depth[mid]); jo_end(o[..]);
                  } else {
                    print("[%] %  (%:% | depth %)\n", kd, dn, mname, lno, cast(int) w[0].m_depth[mid]);
                  }
                  found += 1;
                  if found >= limit { break; }
                }
              }
            }
          }
        }
        if st < got && found < limit {
          rem := got - st; if cn + rem > 1024 { rem = 1024 - cn; }
          for k: 0..<rem { carry[cn + k] = w[0].fbuf[st + k]; } cn += rem;
        }
        if got < RH_IO_CHUNK { break; }
      }
      dt := proc_now_ms() - t0;
      if want_json { jo_end(o[..]); jo_key(o[..], "count"); jo_int(o[..], found); jo_key(o[..], "elapsed_ms"); jo_int(o[..], dt); jo_end(o[..]); print("%\n", jo_text(o[..])); }
      else { print("(% declaration matches in % ms)\n", found, dt); }
      return 0;
    }

    o: [1] Jo; if want_json { jo_start(o[..], w[0].iobuf[..]); jo_obj(o[..]); jo_key(o[..], "query"); jo_str(o[..], q); jo_key(o[..], "hits"); jo_arr(o[..]); }
    for id: 0..<w[0].n_mods {
      nm := rhi_mod_name(w[..], id);
      if !rh_contains_ci(nm, q) { continue; }
      if want_json {
        jo_obj(o[..]);
        jo_key(o[..], "module"); jo_str(o[..], nm);
        jo_key(o[..], "lib"); jo_str(o[..], RH_LIB_NAMES[cast(int) w[0].m_lib[id]]);
        jo_key(o[..], "depth"); jo_int(o[..], cast(int) w[0].m_depth[id]);
        jo_key(o[..], "lines"); jo_int(o[..], cast(int) w[0].m_lines[id]);
        jo_key(o[..], "theorems"); jo_int(o[..], cast(int) w[0].m_theorems[id]);
        jo_key(o[..], "defs"); jo_int(o[..], cast(int) w[0].m_defs[id]);
        jo_key(o[..], "indeg"); jo_int(o[..], cast(int) w[0].m_indeg[id]);
        jo_end(o[..]);
      } else {
        print("%  [% | depth % | % lines | % thms | % in]\n", nm, RH_LIB_NAMES[cast(int) w[0].m_lib[id]], cast(int) w[0].m_depth[id], cast(int) w[0].m_lines[id], cast(int) w[0].m_theorems[id], cast(int) w[0].m_indeg[id]);
      }
      found += 1;
      if found >= limit { break; }
    }
    dt := proc_now_ms() - t0;
    if want_json { jo_end(o[..]); jo_key(o[..], "count"); jo_int(o[..], found); jo_key(o[..], "elapsed_ms"); jo_int(o[..], dt); jo_end(o[..]); print("%\n", jo_text(o[..])); }
    else { print("(% module matches in % ms)\n", found, dt); }
    return 0;
  }

  if sub == "path" {
    mod_q := args_at(a, 2);
    id := rhi_ht_find(w[..], mod_q);
    if id < 0 {
      // Allow prefix match for cluster/directory names (e.g. Formalism.BehrendSets)
      best_d := 999999;
      for i: 0..<w[0].n_mods {
        nm := rhi_mod_name(w[..], i);
        if rh_starts(nm, mod_q) && w[0].m_depth[i] != RH_NO_ID && cast(int) w[0].m_depth[i] < best_d {
          best_d = cast(int) w[0].m_depth[i]; id = i;
        }
      }
    }
    if id < 0 { tool_err("lean-run rh path: module not found: "); tool_errln(mod_q); return 1; }
    want_json := args_has(a, "--json");
    o: [1] Jo; if want_json { jo_start(o[..], w[0].iobuf[..]); jo_obj(o[..]); jo_key(o[..], "start"); jo_str(o[..], rhi_mod_name(w[..], id)); jo_key(o[..], "hops"); jo_arr(o[..]); }
    cur := id;
    hops := 0;
    while cur >= 0 && cur < w[0].n_mods && hops < 256 {
      nm := rhi_mod_name(w[..], cur);
      if want_json {
        jo_obj(o[..]);
        jo_key(o[..], "module"); jo_str(o[..], nm);
        jo_key(o[..], "lib"); jo_str(o[..], RH_LIB_NAMES[cast(int) w[0].m_lib[cur]]);
        jo_key(o[..], "depth"); jo_int(o[..], cast(int) w[0].m_depth[cur]);
        jo_key(o[..], "lines"); jo_int(o[..], cast(int) w[0].m_lines[cur]);
        jo_key(o[..], "theorems"); jo_int(o[..], cast(int) w[0].m_theorems[cur]);
        jo_end(o[..]);
      } else {
        print("  [d=%] %  (% lines, % thms)\n", cast(int) w[0].m_depth[cur], nm, cast(int) w[0].m_lines[cur], cast(int) w[0].m_theorems[cur]);
      }
      hops += 1;
      if cur == w[0].main_id || w[0].m_parent[cur] == RH_NO_ID { break; }
      cur = cast(int) w[0].m_parent[cur];
    }
    if want_json { jo_end(o[..]); jo_key(o[..], "length"); jo_int(o[..], hops); jo_end(o[..]); print("%\n", jo_text(o[..])); }
    return 0;
  }

  if sub == "cone" || sub == "module" {
    mod_q := args_at(a, 2);
    id := rhi_ht_find(w[..], mod_q);
    if id < 0 { tool_err("lean-run rh: module not found: "); tool_errln(mod_q); return 1; }
    limit := args_whole(args_value(a, "--limit", ""));
    if limit <= 0 || limit > 100 { limit = 32; }
    want_json := args_has(a, "--json");
    e0 := cast(int) w[0].fwd_off[id]; e1 := cast(int) w[0].fwd_off[id + 1];
    r0 := cast(int) w[0].rev_off[id]; r1 := cast(int) w[0].rev_off[id + 1];

    if want_json {
      o: [1] Jo; jo_start(o[..], w[0].iobuf[..]); jo_obj(o[..]);
      jo_key(o[..], "module"); jo_str(o[..], rhi_mod_name(w[..], id));
      jo_key(o[..], "lib"); jo_str(o[..], RH_LIB_NAMES[cast(int) w[0].m_lib[id]]);
      jo_key(o[..], "depth"); jo_int(o[..], cast(int) w[0].m_depth[id]);
      jo_key(o[..], "lines"); jo_int(o[..], cast(int) w[0].m_lines[id]);
      jo_key(o[..], "bytes"); jo_int(o[..], cast(int) w[0].m_bytes[id]);
      jo_key(o[..], "theorems"); jo_int(o[..], cast(int) w[0].m_theorems[id]);
      jo_key(o[..], "defs"); jo_int(o[..], cast(int) w[0].m_defs[id]);
      jo_key(o[..], "metaprog"); jo_bool(o[..], (w[0].m_flags[id] & cast(u32) RH_FLAG_METAPROG) != 0);
      jo_key(o[..], "imports_total"); jo_int(o[..], e1 - e0);
      jo_key(o[..], "imported_by_total"); jo_int(o[..], r1 - r0);
      jo_key(o[..], "imports"); jo_arr(o[..]);
      n_up := 0;
      for e: e0..<e1 { if n_up >= limit { break; } jo_str(o[..], rhi_mod_name(w[..], cast(int) w[0].fwd_dst[e])); n_up += 1; }
      jo_end(o[..]);
      jo_key(o[..], "imported_by"); jo_arr(o[..]);
      n_dn := 0;
      for e: r0..<r1 { if n_dn >= limit { break; } jo_str(o[..], rhi_mod_name(w[..], cast(int) w[0].rev_dst[e])); n_dn += 1; }
      jo_end(o[..]);
      jo_key(o[..], "path_to_main"); jo_arr(o[..]);
      cur := id; hops := 0;
      while cur >= 0 && cur < w[0].n_mods && hops < 64 {
        jo_str(o[..], rhi_mod_name(w[..], cur)); hops += 1;
        if cur == w[0].main_id || w[0].m_parent[cur] == RH_NO_ID { break; }
        cur = cast(int) w[0].m_parent[cur];
      }
      jo_end(o[..]);
      if sub == "module" {
        cb: [FS_PATH_MAX] u8; sb: [FS_PATH_MAX] u8; fp: [FS_PATH_MAX] u8;
        corp := lr_rh_corpus_dir(a, home, cb[..]);
        fpath := rhi_mod_path(w[..], fs_join(corp, "src", sb[..]), id, fp[..]);
        sn := fs_read_at(fpath, 0, w[0].fbuf[0..<65536]);
        jo_key(o[..], "source_path"); jo_str(o[..], fpath);
        jo_key(o[..], "source"); jo_str(o[..], ifx sn > 0 then cast(string) w[0].fbuf[0..<sn] else "");
      }
      jo_end(o[..]);
      print("%\n", jo_text(o[..]));
      return 0;
    }

    print("Module: % [%]\n", rhi_mod_name(w[..], id), RH_LIB_NAMES[cast(int) w[0].m_lib[id]]);
    print("  depth from Main: % | % lines | % theorems | % defs\n", cast(int) w[0].m_depth[id], cast(int) w[0].m_lines[id], cast(int) w[0].m_theorems[id], cast(int) w[0].m_defs[id]);
    print("  imports (% total):\n", e1 - e0);
    for e: e0..<e1 { if e - e0 >= limit { break; } print("    -> %\n", rhi_mod_name(w[..], cast(int) w[0].fwd_dst[e])); }
    print("  imported by (% total):\n", r1 - r0);
    for e: r0..<r1 { if e - r0 >= limit { break; } print("    <- %\n", rhi_mod_name(w[..], cast(int) w[0].rev_dst[e])); }
    return 0;
  }

  if sub == "audit" {
    cb: [FS_PATH_MAX] u8; corp := lr_rh_corpus_dir(a, home, cb[..]);
    files := [5] string.["src/Main.lean", "src/Statements.lean", "src/Challenge.lean", "lakefile.toml", "lean-toolchain"];
    want_json := args_has(a, "--json");
    reachable := 0;
    for id: 0..<w[0].n_mods {
      if w[0].m_depth[id] != RH_NO_ID { reachable += 1; }
    }
    if want_json {
      ob: [FS_PATH_MAX] u8;
      has_tier_b := fs_exists(fs_join(corp, ".lake/build/lib/lean/Main.olean", ob[..]));
      o: [1] Jo; jo_start(o[..], w[0].iobuf[..]); jo_obj(o[..]);
      jo_key(o[..], "modules"); jo_int(o[..], w[0].n_mods);
      jo_key(o[..], "reachable_from_main"); jo_int(o[..], reachable);
      jo_key(o[..], "metaprog_count"); jo_int(o[..], w[0].total_metaprog);
      jo_key(o[..], "tier_b_olean_cache"); jo_bool(o[..], has_tier_b);
      jo_key(o[..], "tier_b_note"); jo_str(o[..], "Tier B Interactive Cache (cached .olean Infoview — NOT independent kernel verification)");
      // Real Tier C receipt strictly bound to verified 64-hex SHA-256 kernel output (never fabricated)
      tc_pb: [FS_PATH_MAX] u8; tc_buf: [4096] u8; tc_ver: [1] LwVerify;
      tc_p := fs_join(home, ".openagents/lean/provenance/tier-c-latest.json", tc_pb[..]);
      tc_n := fs_read(tc_p, tc_buf[..]);
      tc_ok := tc_n > 0 && lw_verify_read(cast(string) tc_buf[0..<tc_n], tc_ver[..]) && tc_ver[0].verified && tc_ver[0].file_sha256_n == 64;
      jo_key(o[..], "tier_c_receipt");
      if tc_ok {
        jo_obj(o[..]);
        jo_key(o[..], "verified"); jo_bool(o[..], true);
        jo_key(o[..], "target"); jo_str(o[..], cast(string) tc_ver[0].target[0..<tc_ver[0].target_n]);
        jo_key(o[..], "kernel"); jo_str(o[..], cast(string) tc_ver[0].kernel[0..<tc_ver[0].kernel_n]);
        jo_key(o[..], "toolchain"); jo_str(o[..], cast(string) tc_ver[0].toolchain[0..<tc_ver[0].toolchain_n]);
        jo_key(o[..], "elapsed_ms"); jo_int(o[..], tc_ver[0].elapsed_ms);
        jo_key(o[..], "file_sha256"); jo_str(o[..], cast(string) tc_ver[0].file_sha256[0..<64]);
        jo_end(o[..]);
      } else {
        jo_null(o[..]);
      }
      jo_key(o[..], "metaprog_modules"); jo_arr(o[..]);
      for id: 0..<w[0].n_mods {
        if (w[0].m_flags[id] & cast(u32) RH_FLAG_METAPROG) != 0 { jo_str(o[..], rhi_mod_name(w[..], id)); }
      }
      jo_end(o[..]);
      jo_key(o[..], "digests"); jo_arr(o[..]);
      for f: files {
        fp: [FS_PATH_MAX] u8; hx: [64] u8;
        p := fs_join(corp, f, fp[..]);
        hn := lv_sha256_file(p, hx[..]);
        jo_obj(o[..]); jo_key(o[..], "file"); jo_str(o[..], f); jo_key(o[..], "sha256"); jo_str(o[..], cast(string) hx[0..<hn]); jo_end(o[..]);
      }
      jo_end(o[..]); jo_end(o[..]);
      print("%\n", jo_text(o[..]));
      return 0;
    }
    print("Riemann Hypothesis Proof Provenance & Metaprogramming Audit\n");
    print("  indexed modules: % | reachable from Main: % | metaprogramming sites: %\n", w[0].n_mods, reachable, w[0].total_metaprog);
    for id: 0..<w[0].n_mods {
      if (w[0].m_flags[id] & cast(u32) RH_FLAG_METAPROG) != 0 { print("    [metaprog] %\n", rhi_mod_name(w[..], id)); }
    }
    print("  file SHA-256 digests:\n");
    for f: files {
      fp: [FS_PATH_MAX] u8; hx: [64] u8;
      hn := lv_sha256_file(fs_join(corp, f, fp[..]), hx[..]);
      print("    %  %\n", cast(string) hx[0..<hn], f);
    }
    return 0;
  }

  tool_err("lean-run rh: unknown subcommand: "); tool_errln(sub);
  return 2;
}

lr_self_exe :: (out: [] u8) -> string #effects(all) {
  n := cxproc_self_path(out);
  return ifx n > 0 && n <= out.count then cast(string) out[0..<n] else "";
}

lr_parse_int :: (s: string, fallback: int) -> int {
  if s.count == 0 { return fallback; }
  v := 0;
  for c: s {
    if c < '0' || c > '9' { return fallback; }
    v = v * 10 + cast(int) (c - '0');
  }
  return v;
}

lr_cmd_lsp_op :: (op: string, a: [] Args, home: string) -> int #effects(all) {
  file := args_at(a, 1);
  if file.count == 0 {
    tool_err("usage: lean-run "); tool_err(op);
    if op == "diagnostics" { tool_errln(" FILE [--json]"); }
    else if op == "try" { tool_errln(" FILE LINE COL TACTIC [--json]"); }
    else { tool_errln(" FILE LINE COL [--json]"); }
    return 2;
  }
  line_1 := lr_parse_int(args_at(a, 2), 1);
  col_1 := lr_parse_int(args_at(a, 3), 1);
  tactic := args_at(a, 4);
  if op == "try" && tactic.count == 0 {
    tool_errln("usage: lean-run try FILE LINE COL TACTIC [--json]");
    return 2;
  }
  req_b: [8192] u8; o: [1] Jo; jo_start(o[..], req_b[..]);
  jo_obj(o[..]);
  jo_key(o[..], "op"); jo_str(o[..], op);
  jo_key(o[..], "file"); jo_str(o[..], file);
  jo_key(o[..], "line"); jo_int(o[..], line_1);
  jo_key(o[..], "col"); jo_int(o[..], col_1);
  if tactic.count > 0 { jo_key(o[..], "tactic"); jo_str(o[..], tactic); }
  jo_end(o[..]);

  sb: [FS_PATH_MAX] u8;
  self := lr_self_exe(sb[..]);
  rep: [131072] u8;
  rn := lh_client_call(home, self, jo_text(o[..]), true, rep[..]);
  if rn <= 0 {
    tool_errln("lean-run: could not reach oa-leanhost daemon");
    return 1;
  }
  print("%\n", cast(string) rep[0..<rn]);
  return 0;
}

lr_cmd_host :: (a: [] Args, home: string) -> int #effects(all) {
  sub := args_at(a, 1);
  if sub == "serve" { return lh_serve_daemon(home); }
  sb: [FS_PATH_MAX] u8;
  self := lr_self_exe(sb[..]);
  rep: [16384] u8;
  if sub == "stop" {
    rn := lh_client_call(home, self, "{\"op\":\"stop\"}", false, rep[..]);
    if rn > 0 { print("%\n", cast(string) rep[0..<rn]); return 0; }
    print("{\"ok\":true,\"running\":false,\"note\":\"oa-leanhost was not running\"}\n");
    return 0;
  }
  rn := lh_client_call(home, self, "{\"op\":\"status\"}", false, rep[..]);
  if rn > 0 { print("%\n", cast(string) rep[0..<rn]); return 0; }
  print("{\"ok\":true,\"running\":false}\n");
  return 0;
}

lr_cmd_mcp :: () -> int #effects(all) {
  sb: [FS_PATH_MAX] u8;
  self := lr_self_exe(sb[..]);
  return lm_main(ifx self.count > 0 then self else "lean-run");
}

LrAtifWork :: struct {
  src: [32768] u8;
  log_b: [65536] u8;
  doc_b: [65536] u8;
  man_b: [4096] u8;
  w32_b: [16384] u8;
  out_b: [8192] u8;
  ax_b: [512] u8;
  shx: [64] u8;
  ahx: [64] u8;
}

lr_cmd_atif_export :: (a: [] Args, home: string) -> int #effects(all) {
  file := args_value(a, "--file", "");
  if file.count == 0 { file = args_at(a, 1); }
  target := args_value(a, "--target", "");
  if target.count == 0 { target = args_at(a, 2); }
  if file.count == 0 || target.count == 0 {
    tool_errln("usage: lean-run atif-export --file FILE --target TARGET [--statement SIG] [--run ID] [--task ID] [--model M] [--prompt P] [--out-dir DIR] [--json]");
    return 2;
  }
  stmt := args_value(a, "--statement", "");
  run_id := args_value(a, "--run", "");
  rb: [64] u8;
  if run_id.count == 0 {
    ro: [1] Jo; jo_start(ro[..], rb[..]);
    jo_put(ro[..], "lean-"); jo_int(ro[..], proc_now_ms());
    run_id = jo_text(ro[..]);
  }
  task_id := args_value(a, "--task", target);
  model := args_value(a, "--model", "local-model");
  prompt := args_value(a, "--prompt", "");
  out_dir := args_value(a, "--out-dir", "");
  db0: [FS_PATH_MAX] u8; db1: [FS_PATH_MAX] u8;
  if out_dir.count == 0 {
    runs_dir := fs_join(home, ".openagents/lean/runs", db0[..]);
    out_dir = fs_join(runs_dir, run_id, db1[..]);
  }

  ver: [1] LwVerify;
  lv_verify_file(home, file, target, stmt, ver[..]);

  w: [1] LrAtifWork;
  sn := fs_read(file, w[0].src[..]);
  src_s := ifx sn > 0 then cast(string) w[0].src[0..<sn] else "";

  ao: [1] Jo; jo_start(ao[..], w[0].ax_b[..]);
  for i: 0..<ver[0].axiom_count {
    if i > 0 { jo_put(ao[..], ","); }
    jo_put(ao[..], cast(string) ver[0].axioms[i][0..<ver[0].axioms_n[i]]);
  }
  ax_csv := jo_text(ao[..]);
  verdict_s := cast(string) ver[0].verdict[0..<ver[0].verdict_n];
  sha_s := cast(string) ver[0].file_sha256[0..<ver[0].file_sha256_n];
  msg_s := cast(string) ver[0].message[0..<ver[0].message_n];

  inp := LaTrajectoryInput.{
    run_id = run_id,
    task_id = task_id,
    model_name = model,
    prompt = ifx prompt.count > 0 then prompt else target,
    proof_text = src_s,
    file_path = file,
    target = target,
    verified = ver[0].verified,
    verdict = verdict_s,
    axioms_csv = ax_csv,
    file_sha256 = sha_s,
    kernel_ms = ver[0].elapsed_ms,
    created_at = "2026-11-21T20:00:00Z",
  };

  if !fs_mkdir_all(out_dir) {
    tool_errln("lean-run atif-export: failed to create output directory");
    return 1;
  }
  ln := la_write_atif_log(inp, w[0].log_b[..]);
  if ln <= 0 { tool_errln("lean-run atif-export: failed to build ATIF-v1.8 log"); return 1; }
  log_s := cast(string) w[0].log_b[0..<ln];
  mn := la_build_manifest(inp, log_s, w[0].man_b[..], w[0].shx[..], w[0].ahx[..]);
  if mn <= 0 { tool_errln("lean-run atif-export: failed ATIF-v1.8 self-verification"); return 1; }
  shx_s := cast(string) w[0].shx[..];
  ahx_s := cast(string) w[0].ahx[..];
  dn := la_write_atif_doc(inp, shx_s, w[0].doc_b[..]);
  if dn <= 0 { tool_errln("lean-run atif-export: failed to build trajectory.atif.json"); return 1; }

  p0: [FS_PATH_MAX] u8; p1: [FS_PATH_MAX] u8; p2: [FS_PATH_MAX] u8; p3: [FS_PATH_MAX] u8;
  f_jsonl := fs_join(out_dir, "trajectory.atif.jsonl", p0[..]);
  f_doc := fs_join(out_dir, "trajectory.atif.json", p1[..]);
  f_man := fs_join(out_dir, "manifest.atif.json", p2[..]);
  f_w32 := fs_join(out_dir, "psionic-w32.jsonl", p3[..]);

  ok_w := fs_write(f_jsonl, log_s)
    && fs_write(f_doc, cast(string) w[0].doc_b[0..<dn])
    && fs_write(f_man, cast(string) w[0].man_b[0..<mn]);
  if !ok_w { tool_errln("lean-run atif-export: failed to write ATIF files"); return 1; }

  w32_exported := false;
  wn := la_write_psionic_w32(inp, ahx_s, shx_s, w[0].w32_b[..]);
  if wn > 0 && wn + 1 <= w[0].w32_b.count {
    w[0].w32_b[wn] = '\n';
    w32_exported = fs_write(f_w32, cast(string) w[0].w32_b[0..<wn + 1]);
  }

  if args_has(a, "--json") {
    o: [1] Jo; jo_start(o[..], w[0].out_b[..]);
    jo_obj(o[..]);
    jo_key(o[..], "verified"); jo_bool(o[..], ver[0].verified);
    jo_key(o[..], "verdict"); jo_str(o[..], verdict_s);
    jo_key(o[..], "statement_match"); jo_bool(o[..], ver[0].statement_match);
    jo_key(o[..], "target"); jo_str(o[..], target);
    jo_key(o[..], "file_sha256"); jo_str(o[..], sha_s);
    jo_key(o[..], "elapsed_ms"); jo_int(o[..], ver[0].elapsed_ms);
    jo_key(o[..], "exit_code"); jo_int(o[..], ver[0].exit_code);
    jo_key(o[..], "axioms"); jo_arr(o[..]);
    for i: 0..<ver[0].axiom_count { jo_str(o[..], cast(string) ver[0].axioms[i][0..<ver[0].axioms_n[i]]); }
    jo_end(o[..]);
    jo_key(o[..], "message"); jo_str(o[..], msg_s);
    jo_key(o[..], "out_dir"); jo_str(o[..], out_dir);
    jo_key(o[..], "atif_json"); jo_str(o[..], f_doc);
    jo_key(o[..], "atif_jsonl"); jo_str(o[..], f_jsonl);
    jo_key(o[..], "manifest_json"); jo_str(o[..], f_man);
    jo_key(o[..], "steps_digest"); jo_str(o[..], shx_s);
    jo_key(o[..], "artifact_sha256"); jo_str(o[..], ahx_s);
    jo_key(o[..], "w32_exported"); jo_bool(o[..], w32_exported);
    jo_key(o[..], "w32_jsonl"); jo_str(o[..], ifx w32_exported then f_w32 else "");
    jo_end(o[..]);
    print("%\n", jo_text(o[..]));
  } else {
    print("ATIF-v1.8 Export: % (% | % ms)\n", ifx ver[0].verified then "VERIFIED" else "REJECTED", verdict_s, ver[0].elapsed_ms);
    print("  trajectory.atif.json:  %\n", f_doc);
    print("  trajectory.atif.jsonl: %\n", f_jsonl);
    print("  manifest.atif.json:    %\n", f_man);
    print("  steps_digest:          %\n", shx_s);
    print("  psionic-w32.jsonl:     %\n", ifx w32_exported then f_w32 else "(not exported — unverified)");
  }
  return ifx ver[0].verified then 0 else 1;
}

lr_cmd_bench :: (a: [] Args, home: string) -> int #effects(all) {
  sub := args_at(a, 1);
  if sub == "start" {
    suite := args_value(a, "--suite", "lean-core-smoke");
    rdir := args_value(a, "--run-dir", "");
    sdir := args_value(a, "--solutions-dir", "");
    sb: [FS_PATH_MAX] u8;
    self := lr_self_exe(sb[..]);
    if self.count == 0 { tool_errln("lean-run bench start: cannot determine self executable path"); return 1; }
    return la_bench_start(home, self, suite, rdir, sdir, args_has(a, "--json"));
  }
  if sub == "worker" {
    suite := args_value(a, "--suite", "lean-core-smoke");
    rdir := args_value(a, "--run-dir", "");
    rid := args_value(a, "--run-id", "bench-worker");
    sdir := args_value(a, "--solutions-dir", "");
    if rdir.count == 0 { return 2; }
    return la_bench_worker(home, suite, rdir, rid, sdir);
  }
  if sub == "status" {
    return la_bench_status(home, args_value(a, "--run-dir", ""), args_has(a, "--json"));
  }
  if sub == "stop" {
    return la_bench_stop(home, args_value(a, "--run-dir", ""), args_has(a, "--json"));
  }
  tool_errln("usage: lean-run bench start|status|stop [--suite NAME] [--run-dir DIR] [--solutions-dir DIR] [--json]");
  return 2;
}

lr_cmd_search :: (a: [] Args, home: string) -> int #effects(all) {
  file := args_at(a, 1);
  if file.count == 0 {
    tool_errln("usage: lean-run search FILE LINE COL [--tactics \"rfl,simp,omega\"] [--json]");
    return 2;
  }
  line_1 := lr_parse_int(args_at(a, 2), 1);
  col_1 := lr_parse_int(args_at(a, 3), 1);
  tacs := args_value(a, "--tactics", "rfl,simp,omega");
  sb: [FS_PATH_MAX] u8;
  self := lr_self_exe(sb[..]);
  return la_branch_search(home, self, file, line_1, col_1, tacs, args_has(a, "--json"));
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args; _ = args_load(a[..]);
  verb := args_at(a[..], 0);
  if verb.count == 0 || verb == "help" || verb == "--help" || verb == "-h" { return lr_usage(); }
  hb: [FS_PATH_MAX] u8;
  home := proc_getenv("HOME", hb[..]);
  if verb == "doctor" { return lr_cmd_doctor(a[..], home); }
  if verb == "verify" { return lr_cmd_verify(a[..], home); }
  if verb == "atif-export" { return lr_cmd_atif_export(a[..], home); }
  if verb == "goal" || verb == "try" || verb == "hover" || verb == "diagnostics" { return lr_cmd_lsp_op(verb, a[..], home); }
  if verb == "search" { return lr_cmd_search(a[..], home); }
  if verb == "bench" { return lr_cmd_bench(a[..], home); }
  if verb == "host" { return lr_cmd_host(a[..], home); }
  if verb == "mcp" { return lr_cmd_mcp(); }
  if verb == "sample" { return lr_cmd_sample(a[..], home); }
  if verb == "gym" { return lr_cmd_gym(a[..], home); }
  if verb == "card" { return lr_cmd_card(a[..]); }
  if verb == "rh" { return lr_cmd_rh(a[..], home); }
  tool_err("lean-run: unknown verb: "); tool_errln(verb);
  return 2;
}
