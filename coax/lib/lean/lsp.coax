// Pure Coax Lean 4 Language Server Protocol (LSP) JSON-RPC 2.0 framer & codec
// (Epic #13943, #13947; docs/lean/spec.md §3).
//
// Zero external dependencies; strictly deterministic Content-Length framing,
// request/notification builders, and $/lean/fileProgress, $/lean/plainGoal,
// textDocument/hover, and publishDiagnostics decoders.
//
//   coax/bin/coax test coax/lib/lean/lsp.coax --library
#load "../json/json.coax";
#load "goal.coax";

LLSP_FRAME_MORE :: 0;
LLSP_FRAME_OK :: 1;
LLSP_FRAME_BAD :: -1;

LlspFrame :: struct {
  status: int;       // LLSP_FRAME_*
  body_from: int;
  body_to: int;
  consumed: int;     // bytes to drop from the front of the receive buffer
}

LlspDiag :: struct {
  line: int;
  col: int;
  severity: int;     // 1=error, 2=warning, 3=info, 4=hint
  msg: [256] u8; msg_n: int;
}

// Writes "Content-Length: N\r\n\r\n<body>" into out; returns bytes written or -1 if too small.
llsp_frame_write :: (body: string, out: [] u8) -> int {
  hdr: [64] u8;
  ho: [1] Jo; jo_start(ho[..], hdr[..]);
  jo_put(ho[..], "Content-Length: ");
  jo_int(ho[..], body.count);
  jo_put(ho[..], "\r\n\r\n");
  hs := jo_text(ho[..]);
  total := hs.count + body.count;
  if total > out.count { return -1; }
  for i: 0..<hs.count { out[i] = hs[i]; }
  for i: 0..<body.count { out[hs.count + i] = body[i]; }
  return total;
}

llsp_ascii_lower :: (c: u8) -> u8 {
  return ifx c >= 'A' && c <= 'Z' then c + 32 else c;
}

llsp_hdr_eq_ci :: (s: string, want: string) -> bool {
  if s.count != want.count { return false; }
  for i: 0..<s.count { if llsp_ascii_lower(s[i]) != llsp_ascii_lower(want[i]) { return false; } }
  return true;
}

// Parses one Content-Length framed JSON-RPC message from buf[0..<n].
llsp_frame_parse :: (buf: [] u8, n: int) -> LlspFrame {
  r := LlspFrame.{status = LLSP_FRAME_MORE};
  // Find "\r\n\r\n"
  hdr_end := -1;
  i := 0;
  while i + 3 < n {
    if buf[i] == '\r' && buf[i + 1] == '\n' && buf[i + 2] == '\r' && buf[i + 3] == '\n' {
      hdr_end = i;
      break;
    }
    i += 1;
  }
  if hdr_end < 0 {
    if n > 8192 { r.status = LLSP_FRAME_BAD; }
    return r;
  }
  // Scan header lines for Content-Length
  clen := -1;
  lp := 0;
  while lp < hdr_end {
    le := lp;
    while le < hdr_end && !(buf[le] == '\r' && le + 1 < hdr_end && buf[le + 1] == '\n') { le += 1; }
    colon := -1;
    for k: lp..<le { if buf[k] == ':' { colon = k; break; } }
    if colon > lp {
      key := lg_trim(cast(string) buf[lp..<colon]);
      if llsp_hdr_eq_ci(key, "content-length") {
        val := lg_trim(cast(string) buf[colon + 1..<le]);
        if val.count == 0 { r.status = LLSP_FRAME_BAD; return r; }
        v := 0;
        for c: val {
          if c < '0' || c > '9' { r.status = LLSP_FRAME_BAD; return r; }
          v = v * 10 + cast(int) (c - '0');
          if v > 67108864 { r.status = LLSP_FRAME_BAD; return r; }
        }
        clen = v;
      }
    }
    lp = le + 2;
  }
  if clen < 0 { r.status = LLSP_FRAME_BAD; return r; }
  body_start := hdr_end + 4;
  if body_start + clen > n { return r; }
  r.status = LLSP_FRAME_OK;
  r.body_from = body_start;
  r.body_to = body_start + clen;
  r.consumed = body_start + clen;
  return r;
}

// Converts an absolute filesystem path to a file:// URI.
llsp_file_uri :: (path: string, out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out);
  if lg_starts(path, "file://") {
    jo_put(o[..], path);
    return jo_text(o[..]);
  }
  jo_put(o[..], "file://");
  if path.count > 0 && path[0] != '/' { jo_put(o[..], "/"); }
  for c: path {
    if c == ' ' { jo_put(o[..], "%20"); }
    else { b: [1] u8; b[0] = c; jo_put(o[..], cast(string) b[..]); }
  }
  return jo_text(o[..]);
}

llsp_req_initialize :: (id: int, root_uri: string, out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out);
  jo_obj(o[..]);
  jo_key(o[..], "jsonrpc"); jo_str(o[..], "2.0");
  jo_key(o[..], "id"); jo_int(o[..], id);
  jo_key(o[..], "method"); jo_str(o[..], "initialize");
  jo_key(o[..], "params"); jo_obj(o[..]);
  jo_key(o[..], "processId"); jo_null(o[..]);
  jo_key(o[..], "rootUri");
  if root_uri.count > 0 { jo_str(o[..], root_uri); } else { jo_null(o[..]); }
  jo_key(o[..], "capabilities"); jo_obj(o[..]); jo_end(o[..]);
  jo_end(o[..]);
  jo_end(o[..]);
  return jo_text(o[..]);
}

llsp_notif_initialized :: (out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}");
  return jo_text(o[..]);
}

llsp_notif_did_open :: (uri: string, version: int, text: string, out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out);
  jo_obj(o[..]);
  jo_key(o[..], "jsonrpc"); jo_str(o[..], "2.0");
  jo_key(o[..], "method"); jo_str(o[..], "textDocument/didOpen");
  jo_key(o[..], "params"); jo_obj(o[..]);
  jo_key(o[..], "textDocument"); jo_obj(o[..]);
  jo_key(o[..], "uri"); jo_str(o[..], uri);
  jo_key(o[..], "languageId"); jo_str(o[..], "lean4");
  jo_key(o[..], "version"); jo_int(o[..], version);
  jo_key(o[..], "text"); jo_str(o[..], text);
  jo_end(o[..]);
  jo_end(o[..]);
  jo_end(o[..]);
  return jo_text(o[..]);
}

llsp_notif_did_change :: (uri: string, version: int, text: string, out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out);
  jo_obj(o[..]);
  jo_key(o[..], "jsonrpc"); jo_str(o[..], "2.0");
  jo_key(o[..], "method"); jo_str(o[..], "textDocument/didChange");
  jo_key(o[..], "params"); jo_obj(o[..]);
  jo_key(o[..], "textDocument"); jo_obj(o[..]);
  jo_key(o[..], "uri"); jo_str(o[..], uri);
  jo_key(o[..], "version"); jo_int(o[..], version);
  jo_end(o[..]);
  jo_key(o[..], "contentChanges"); jo_arr(o[..]);
  jo_obj(o[..]);
  jo_key(o[..], "text"); jo_str(o[..], text);
  jo_end(o[..]);
  jo_end(o[..]);
  jo_end(o[..]);
  jo_end(o[..]);
  return jo_text(o[..]);
}

// line_0 and col_0 are 0-based LSP positions.
llsp_req_pos :: (id: int, method: string, uri: string, line_0: int, col_0: int, out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out);
  jo_obj(o[..]);
  jo_key(o[..], "jsonrpc"); jo_str(o[..], "2.0");
  jo_key(o[..], "id"); jo_int(o[..], id);
  jo_key(o[..], "method"); jo_str(o[..], method);
  jo_key(o[..], "params"); jo_obj(o[..]);
  jo_key(o[..], "textDocument"); jo_obj(o[..]);
  jo_key(o[..], "uri"); jo_str(o[..], uri);
  jo_end(o[..]);
  jo_key(o[..], "position"); jo_obj(o[..]);
  jo_key(o[..], "line"); jo_int(o[..], ifx line_0 < 0 then 0 else line_0);
  jo_key(o[..], "character"); jo_int(o[..], ifx col_0 < 0 then 0 else col_0);
  jo_end(o[..]);
  jo_end(o[..]);
  jo_end(o[..]);
  return jo_text(o[..]);
}

// Inserts `tactic` at 1-based (line, col) in `src` (in-memory overlay for `lean-run try`),
// writing the modified file text into `out` and returning its byte count (or -1 on overflow).
llsp_inject_tactic :: (src: string, line_1: int, col_1: int, tactic: string, out: [] u8) -> int {
  cur_l := 1;
  pos := 0;
  while pos < src.count && cur_l < line_1 {
    if src[pos] == '\n' { cur_l += 1; }
    pos += 1;
  }
  // Advance to col_1 (1-based) or end of line
  c_adv := 1;
  while pos < src.count && src[pos] != '\n' && c_adv < col_1 {
    pos += 1;
    c_adv += 1;
  }
  // Compute line indentation for clean newline after tactic
  line_start := pos;
  while line_start > 0 && src[line_start - 1] != '\n' { line_start -= 1; }
  indent_end := line_start;
  while indent_end < src.count && (src[indent_end] == ' ' || src[indent_end] == '\t') { indent_end += 1; }
  indent := cast(string) src[line_start..<indent_end];

  n := 0;
  for i: 0..<pos { if n >= out.count { return -1; } out[n] = src[i]; n += 1; }
  for c: tactic { if n >= out.count { return -1; } out[n] = c; n += 1; }
  if pos < src.count && src[pos] != '\n' {
    if n >= out.count { return -1; }
    out[n] = '\n'; n += 1;
    for c: indent { if n >= out.count { return -1; } out[n] = c; n += 1; }
  }
  for i: pos..<src.count { if n >= out.count { return -1; } out[n] = src[i]; n += 1; }
  return n;
}

// Checks if an LSP JSON message is `$/lean/fileProgress` with empty `processing: []` for `want_uri`.
llsp_is_progress_done :: (msg: string, want_uri: string) -> bool {
  nodes: [4096] JvNode; d: [1] Jv;
  if !jv_parse(d[..], msg, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return false; }
  mb: [64] u8; mn := jv_str(d[0], jv_get(d[0], 0, "method"), mb[..]);
  if mn <= 0 || cast(string) mb[0..<mn] != "$/lean/fileProgress" { return false; }
  params := jv_get(d[0], 0, "params");
  if params < 0 { return false; }
  td := jv_get(d[0], params, "textDocument");
  ub: [1024] u8; un := jv_str(d[0], jv_get(d[0], td, "uri"), ub[..]);
  if want_uri.count > 0 && (un <= 0 || cast(string) ub[0..<un] != want_uri) { return false; }
  proc := jv_get(d[0], params, "processing");
  return proc >= 0 && jv_kind(d[0], proc) == JV_ARRAY && d[0].nodes[proc].count == 0;
}

// Extracts structured LgState from a `$/lean/plainGoal` JSON-RPC response body.
llsp_decode_plain_goal :: (msg: string, out: [] LgState) -> bool {
  out[0] = LgState.{};
  nodes: [4096] JvNode; d: [1] Jv;
  if !jv_parse(d[..], msg, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return false; }
  res := jv_get(d[0], 0, "result");
  if res < 0 || jv_kind(d[0], res) == JV_NULL {
    out[0].summary_n = lg_put(out[0].summary[..], "No tactic goal at cursor");
    return true;
  }
  if jv_kind(d[0], res) != JV_OBJECT { return false; }
  rb: [8192] u8; rn := jv_str(d[0], jv_get(d[0], res, "rendered"), rb[..]);
  rendered := ifx rn > 0 then cast(string) rb[0..<rn] else "";

  gbufs: [LG_MAX_GOALS] [2048] u8;
  gstrs: [LG_MAX_GOALS] string;
  gn := 0;
  ga := jv_get(d[0], res, "goals");
  if ga >= 0 && jv_kind(d[0], ga) == JV_ARRAY {
    e := d[0].nodes[ga].first;
    while e != -1 && gn < LG_MAX_GOALS {
      l := jv_str(d[0], e, gbufs[gn][..]);
      if l > 0 { gstrs[gn] = cast(string) gbufs[gn][0..<l]; gn += 1; }
      e = d[0].nodes[e].next;
    }
  }
  lg_parse_goals(gstrs[0..<gn], rendered, out);
  return true;
}

// Extracts markdown hover text from a `textDocument/hover` JSON-RPC response body.
llsp_decode_hover :: (msg: string, out: [] u8) -> int {
  nodes: [4096] JvNode; d: [1] Jv;
  if !jv_parse(d[..], msg, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return 0; }
  res := jv_get(d[0], 0, "result");
  if res < 0 || jv_kind(d[0], res) != JV_OBJECT { return 0; }
  c := jv_get(d[0], res, "contents");
  if c < 0 { return 0; }
  if jv_kind(d[0], c) == JV_STRING {
    n := jv_str(d[0], c, out);
    return ifx n > 0 then n else 0;
  }
  if jv_kind(d[0], c) == JV_OBJECT {
    n := jv_str(d[0], jv_get(d[0], c, "value"), out);
    return ifx n > 0 then n else 0;
  }
  return 0;
}

// Extracts diagnostics from `textDocument/publishDiagnostics` into `out`; returns count (-1 if not that method).
llsp_decode_diags :: (msg: string, want_uri: string, out: [] LlspDiag) -> int {
  nodes: [4096] JvNode; d: [1] Jv;
  if !jv_parse(d[..], msg, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return -1; }
  mb: [64] u8; mn := jv_str(d[0], jv_get(d[0], 0, "method"), mb[..]);
  if mn <= 0 || cast(string) mb[0..<mn] != "textDocument/publishDiagnostics" { return -1; }
  params := jv_get(d[0], 0, "params");
  if params < 0 { return -1; }
  ub: [1024] u8; un := jv_str(d[0], jv_get(d[0], params, "uri"), ub[..]);
  if want_uri.count > 0 && (un <= 0 || cast(string) ub[0..<un] != want_uri) { return -1; }
  arr := jv_get(d[0], params, "diagnostics");
  if arr < 0 || jv_kind(d[0], arr) != JV_ARRAY { return 0; }
  cnt := 0;
  e := d[0].nodes[arr].first;
  while e != -1 && cnt < out.count {
    out[cnt] = LlspDiag.{};
    rng := jv_get(d[0], e, "range");
    st := ifx rng >= 0 then jv_get(d[0], rng, "start") else -1;
    out[cnt].line = ifx st >= 0 then jv_int(d[0], jv_get(d[0], st, "line"), 0) + 1 else 1;
    out[cnt].col = ifx st >= 0 then jv_int(d[0], jv_get(d[0], st, "character"), 0) + 1 else 1;
    out[cnt].severity = jv_int(d[0], jv_get(d[0], e, "severity"), 1);
    l := jv_str(d[0], jv_get(d[0], e, "message"), out[cnt].msg[..]);
    out[cnt].msg_n = ifx l > 0 then l else 0;
    cnt += 1;
    e = d[0].nodes[e].next;
  }
  return cnt;
}

#test "lean lsp: Content-Length framing, coalesced messages, progress, plainGoal, hover, and tactic overlay" {
  fbuf: [512] u8;
  body1 := "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"goals\":[\"case zero\\na : Nat\\n\\u22a2 a + 0 = 0 + a\"],\"rendered\":\"```lean\\ncase zero\\na : Nat\\n\\u22a2 a + 0 = 0 + a\\n```\"}}";
  n1 := llsp_frame_write(body1, fbuf[..]);
  #assert n1 > body1.count;
  // Partial buffer waits for more bytes
  p0 := llsp_frame_parse(fbuf[..], n1 - 5);
  #assert p0.status == LLSP_FRAME_MORE;
  // Complete buffer parses cleanly
  p1 := llsp_frame_parse(fbuf[..], n1);
  #assert p1.status == LLSP_FRAME_OK && p1.consumed == n1;
  got := cast(string) fbuf[p1.body_from..<p1.body_to];
  #assert got == body1;

  // Decode plainGoal
  st: [1] LgState;
  #assert llsp_decode_plain_goal(got, st[..]) && st[0].goal_count == 1;
  #assert cast(string) st[0].goals[0].target[0..<st[0].goals[0].target_n] == "a + 0 = 0 + a";

  // Progress done vs in-progress
  prog_busy := "{\"jsonrpc\":\"2.0\",\"method\":\"$/lean/fileProgress\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.lean\"},\"processing\":[{\"kind\":1}]}}";
  prog_done := "{\"jsonrpc\":\"2.0\",\"method\":\"$/lean/fileProgress\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.lean\"},\"processing\":[]}}";
  #assert !llsp_is_progress_done(prog_busy, "file:///a.lean") && llsp_is_progress_done(prog_done, "file:///a.lean");

  // Hover decode
  hmsg := "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"`rw` rewrites goals\"}}}";
  hb: [256] u8;
  hn := llsp_decode_hover(hmsg, hb[..]);
  #assert cast(string) hb[0..<hn] == "`rw` rewrites goals";

  // Diagnostics decode
  dmsg := "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"file:///a.lean\",\"diagnostics\":[{\"range\":{\"start\":{\"line\":4,\"character\":2}},\"severity\":1,\"message\":\"unsolved goals\"}]}}";
  diags: [4] LlspDiag;
  dn := llsp_decode_diags(dmsg, "file:///a.lean", diags[..]);
  #assert dn == 1 && diags[0].line == 5 && diags[0].col == 3 && cast(string) diags[0].msg[0..<diags[0].msg_n] == "unsolved goals";

  // In-memory tactic injection preserves surrounding text
  orig := "theorem t (n : Nat) : n + 0 = n := by\n  sorry\n";
  inj: [256] u8;
  in_n := llsp_inject_tactic(orig, 2, 3, "rfl", inj[..]);
  #assert in_n > orig.count && lg_contains(cast(string) inj[0..<in_n], "  rfl\n  sorry");

  // Request / notification builders & file URI encoding
  ub: [256] u8;
  #assert llsp_file_uri("/tmp/my file.lean", ub[..]) == "file:///tmp/my%20file.lean";
  jb: [1024] u8;
  #assert lg_contains(llsp_req_initialize(1, "file:///tmp", jb[..]), "\"method\":\"initialize\"");
  #assert lg_contains(llsp_notif_initialized(jb[..]), "\"method\":\"initialized\"");
  #assert lg_contains(llsp_notif_did_open("file:///a.lean", 1, "def x := 1", jb[..]), "\"languageId\":\"lean4\"");
  #assert lg_contains(llsp_notif_did_change("file:///a.lean", 2, "def x := 2", jb[..]), "\"version\":2");
  #assert lg_contains(llsp_req_pos(7, "$/lean/plainGoal", "file:///a.lean", 3, 4, jb[..]), "\"line\":3");
}
