// Messages and TLVs (Bitcoin chapter 104): BOLT 1's message framing with
// its "it's OK to be odd" rule, BigSize, TLV streams, the truncated
// integers, and the setup and control messages init, error, warning, ping
// and pong, with BOLT 9's feature bits.
//
// Everything here is pure encoding: no socket and no peer state. The Noise
// transport of chapter 105 carries these messages, and chapter 109's
// channel state machine acts on them. Readers copy nothing: a read message
// is positions into the caller's bytes, as in chapters 34 and 65.
//
// Lightning messages are public once decrypted by the transport, so every
// procedure runs in variable time and its name ends in _vartime (chapter 3).
#load "../crypto/bytes.coax";
#load "../crypto/secp_encode.coax";
#load "../../tests/lightning/bolt1_vectors.coax";
#authority;

// book:begin codes
LN_OK :: 0;
LN_TRUNCATED :: 1;     // the bytes end inside a field: "unexpected EOF"
LN_NOT_MINIMAL :: 2;   // a BigSize or truncated integer longer than it needs
LN_ORDER :: 3;         // TLV types not strictly increasing, a repeat included
LN_UNKNOWN_EVEN :: 4;  // an even type or feature bit the reader does not know
LN_BAD_LENGTH :: 5;    // a known TLV record whose length its type does not allow
LN_BAD_VALUE :: 6;     // a value its type refuses: a point off the curve, say
LN_CAPACITY :: 7;      // the caller's buffer is too small
LN_TOO_LARGE :: 8;     // a message above 65,535 bytes

LN_MAX_MESSAGE :: 65535;  // BOLT 8's 2-byte length
LN_TYPE :: 2;             // the big-endian message type

LN_WARNING :: 1;
LN_INIT :: 16;
LN_ERROR :: 17;
LN_PING :: 18;
LN_PONG :: 19;
LN_PONG_LIMIT :: 65532;   // a ping asking for this many pong bytes or more gets no reply
// book:end codes

// ---- big-endian fields
ln_u16 :: (b: [] u8, at: int) -> int #effects(all) { return (cast(int) b[at] << 8) | cast(int) b[at + 1]; }
ln_put16 :: (out: [] u8, at: int, v: int) #effects(all) { out[at] = cast(u8) ((v >> 8) & 255); out[at + 1] = cast(u8) (v & 255); }

// book:begin bigsize
// BigSize is Bitcoin's CompactSize (chapter 34) in big-endian: one byte
// below 0xfd, else 0xfd, 0xfe or 0xff and then 2, 4 or 8 bytes. Every value
// has one encoding, the shortest, and a reader refuses any other.
LnBigSize :: struct { code: int; value: u64; next: int; }
bigsize_read_vartime :: (b: [] u8, at: int) -> LnBigSize #effects(all) {
  if at >= b.count { return LnBigSize.{code = LN_TRUNCATED, next = at}; }
  first := b[at];
  if first < 0xfd { return LnBigSize.{value = cast(u64) first, next = at + 1}; }
  width := ifx first == 0xfd then 2 else ifx first == 0xfe then 4 else 8;
  if width > b.count - at - 1 { return LnBigSize.{code = LN_TRUNCATED, next = at}; }
  value: u64 = 0;
  for i: 0..<width { value = (value << 8) | cast(u64) b[at + 1 + i]; }
  least: u64 = ifx width == 2 then 0xfd else ifx width == 4 then 0x10000 else 0x100000000;
  if value < least { return LnBigSize.{code = LN_NOT_MINIMAL, next = at}; }
  return LnBigSize.{value = value, next = at + 1 + width};
}
bigsize_size :: (value: u64) -> int #effects(all) {
  if value < 0xfd { return 1; }
  if value < 0x10000 { return 3; }
  if value < 0x100000000 { return 5; }
  return 9;
}
// Writes value at out[at] and returns where writing goes on, or -1.
bigsize_write_vartime :: (out: [] u8, at: int, value: u64) -> int #effects(all) {
  size := bigsize_size(value);
  if at < 0 || size > out.count - at { return -1; }
  if size == 1 { out[at] = cast(u8) value; return at + 1; }
  out[at] = cast(u8) (ifx size == 3 then 0xfd else ifx size == 5 then 0xfe else 0xff);
  for i: 0..<size - 1 { out[at + size - 1 - i] = cast(u8) ((value >> cast(u64) (8 * i)) & 255); }
  return at + size;
}
// book:end bigsize

// book:begin tlv
// One record of a TLV stream: type, length, then the value at
// b[start..<start+length]. A stream is records in strictly increasing type
// order until the bytes end. Pass the previous record's type; first is true
// for the first record.
LnRecord :: struct { code: int; type: u64; start: int; length: int; next: int; }
tlv_next_vartime :: (b: [] u8, at: int, previous: u64, first: bool) -> LnRecord #effects(all) {
  t := bigsize_read_vartime(b, at);
  if t.code != LN_OK { return LnRecord.{code = t.code, next = at}; }
  if !first && t.value <= previous { return LnRecord.{code = LN_ORDER, type = t.value, next = at}; }
  l := bigsize_read_vartime(b, t.next);
  if l.code != LN_OK { return LnRecord.{code = l.code, type = t.value, next = at}; }
  if l.value > cast(u64) (b.count - l.next) { return LnRecord.{code = LN_TRUNCATED, type = t.value, next = at}; }
  n := cast(int) l.value;
  return LnRecord.{type = t.value, start = l.next, length = n, next = l.next + n};
}
// "It's OK to be odd": a reader that does not know a type skips an odd
// one and refuses an even one. The same rule covers message types and
// feature bits.
ln_unknown_vartime :: (type: u64) -> int #effects(all) { return ifx type % 2 == 0 then LN_UNKNOWN_EVEN else LN_OK; }
// A whole stream whose known types are listed, in any order. It checks the
// framing and the odd rule only; the caller reads each known value.
tlv_check_vartime :: (b: [] u8, known: [] u64) -> int #effects(all) {
  at := 0; previous: u64 = 0; first := true; // mutant: equivalent (the first record never reads previous, and every later one reads the type set before it)
  while at < b.count {
    r := tlv_next_vartime(b, at, previous, first);
    if r.code != LN_OK { return r.code; }
    found := false; for k: known { if k == r.type { found = true; } }
    if !found && ln_unknown_vartime(r.type) != LN_OK { return LN_UNKNOWN_EVEN; }
    previous = r.type; first = false; at = r.next;
  }
  return LN_OK;
}
// Writes one record and returns where writing goes on, or -1.
tlv_write_vartime :: (out: [] u8, at: int, type: u64, value: [] u8) -> int #effects(all) {
  w := bigsize_write_vartime(out, at, type);
  if w < 0 { return -1; } // mutant: equivalent (bigsize_write returns -1 or a position of at least 1, so w < 0, w <= 0 and w < 1 agree)
  w = bigsize_write_vartime(out, w, cast(u64) value.count);
  if w < 0 || value.count > out.count - w { return -1; } // mutant: equivalent (w is -1 or at least 2 here, so w < 0, w <= 0 and w < 1 agree)
  for i: 0..<value.count { out[w + i] = value[i]; }
  return w + value.count;
}
// book:end tlv

// book:begin truncated
// tu16, tu32 and tu64: the last value of a record may drop its leading
// zero bytes, and must. Zero is no bytes at all.
LnInt :: struct { code: int; value: u64; }
tu_read_vartime :: (value: [] u8, width: int) -> LnInt #effects(all) {
  if value.count > width { return LnInt.{code = LN_BAD_LENGTH}; }
  if value.count > 0 && value[0] == 0 { return LnInt.{code = LN_NOT_MINIMAL}; }
  v: u64 = 0;
  for i: 0..<value.count { v = (v << 8) | cast(u64) value[i]; }
  return LnInt.{value = v};
}
tu_size :: (v: u64) -> int #effects(all) { n := 0; while n < 8 && (v >> cast(u64) (8 * n)) != 0 { n += 1; } return n; }
tu_write_vartime :: (out: [] u8, at: int, v: u64) -> int #effects(all) {
  n := tu_size(v);
  if at < 0 || n > out.count - at { return -1; }
  for i: 0..<n { out[at + n - 1 - i] = cast(u8) ((v >> cast(u64) (8 * i)) & 255); }
  return at + n;
}
// book:end truncated

// book:begin message
// A message is a 2-byte big-endian type, then its payload. The receiver
// ignores an unknown odd type and closes the connection on an unknown
// even one.
LnMessage :: struct { code: int; type: int; payload: int; }
ln_message_read_vartime :: (m: [] u8) -> LnMessage #effects(all) {
  if m.count > LN_MAX_MESSAGE { return LnMessage.{code = LN_TOO_LARGE}; }
  if m.count < LN_TYPE { return LnMessage.{code = LN_TRUNCATED}; }
  return LnMessage.{type = ln_u16(m, 0), payload = LN_TYPE};
}
ln_known_vartime :: (type: int) -> bool #effects(all) {
  return type == LN_WARNING || type == LN_INIT || type == LN_ERROR || type == LN_PING || type == LN_PONG;
}
// What a receiver does with a message's type: LN_OK to read it, LN_OK with
// ignore true to drop it, or LN_UNKNOWN_EVEN to close the connection.
LnDispatch :: struct { code: int; ignore: bool; }
ln_dispatch_vartime :: (type: int) -> LnDispatch #effects(all) {
  if ln_known_vartime(type) { return LnDispatch.{}; }
  if type % 2 == 1 { return LnDispatch.{ignore = true}; }
  return LnDispatch.{code = LN_UNKNOWN_EVEN};
}
// book:end message

// book:begin features
// BOLT 9's feature bits, numbered from the least significant bit of the
// last byte. Each feature is a pair: the even bit says "required", the
// odd bit "supported".
LN_FEATURES :: [26] string.["option_data_loss_protect", "", "option_upfront_shutdown_script",
  "gossip_queries", "var_onion_optin", "gossip_queries_ex", "option_static_remotekey",
  "payment_secret", "basic_mpp", "option_support_large_channel", "", "option_anchors",
  "option_route_blinding", "option_shutdown_anysegwit", "option_dual_fund", "", "",
  "option_quiesce", "option_attribution_data", "option_onion_messages", "zero_fee_commitments",
  "option_provide_storage", "option_channel_type", "option_scid_alias",
  "option_payment_metadata", "option_zeroconf"];
LN_FEATURES_MORE :: [4] string.["option_simple_close", "option_splice", "", "option_onion_messages_only_channels"];
ln_feature_name :: (bit: int) -> string #effects(all) {
  pair := bit / 2;
  if pair < 26 { return LN_FEATURES[pair]; }
  if pair >= 30 && pair < 34 { return LN_FEATURES_MORE[pair - 30]; }
  return "";
}
ln_feature_set :: (f: [] u8, bit: int) -> bool #effects(all) {
  if bit < 0 || bit / 8 >= f.count { return false; }
  return (f[f.count - 1 - bit / 8] >> cast(u8) (bit % 8)) & 1 == 1;
}
// Sets bit in f, a big-endian bitmap of f.count bytes; false if it does
// not fit.
ln_feature_put :: (f: [] u8, bit: int) -> bool #effects(all) {
  if bit < 0 || bit / 8 >= f.count { return false; }
  f[f.count - 1 - bit / 8] |= cast(u8) (1 << (bit % 8));
  return true;
}
// The bytes a bitmap needs: up to its highest set bit, no leading zeros.
ln_feature_bytes :: (f: [] u8) -> int #effects(all) {
  for i: 0..<f.count { if f[i] != 0 { return f.count - i; } }
  return 0;
}
// The first set bit, from bit 0, that the reader cannot accept: an even
// bit of a feature it does not know. -1 when every bit is acceptable.
ln_feature_refuse_vartime :: (f: [] u8, known: [] int) -> int #effects(all) {
  for bit: 0..<f.count * 8 { // mutant: equivalent (ln_feature_set is false for every bit past f.count * 8)
    if ln_feature_set(f, bit) && bit % 2 == 0 {
      found := false; for k: known { if k / 2 == bit / 2 { found = true; } }
      if !found { return bit; }
    }
  }
  return -1;
}
// book:end features

// book:begin init
// init: globalfeatures and features, each a u16 length and bytes, then
// init_tlvs: networks (type 1, chain hashes) and remote_addr (type 3).
// The two bitmaps are ORed into one, aligned at their last bytes.
LN_INIT_NETWORKS :: 1;
LN_INIT_REMOTE_ADDR :: 3;
LnInit :: struct {
  code: int;
  global: int; global_n: int; features: int; features_n: int;
  networks: int; networks_n: int;       // networks_n chain hashes of 32 bytes
  remote_addr: int; remote_addr_n: int; // -1 when absent
  ignored: int;                         // unknown odd records skipped
}
ln_init_read_vartime :: (m: [] u8) -> LnInit #effects(all) {
  r := LnInit.{networks = -1, remote_addr = -1};
  h := ln_message_read_vartime(m);
  if h.code != LN_OK { r.code = h.code; return r; }
  if h.type != LN_INIT { r.code = LN_BAD_VALUE; return r; }
  at := LN_TYPE;
  if m.count - at < 2 { r.code = LN_TRUNCATED; return r; } // mutant: equivalent (for < and <=, or 2 and 3: a 4-byte init has no features length, so the next check refuses it with the same code)
  r.global_n = ln_u16(m, at); r.global = at + 2; at = r.global + r.global_n;
  if at + 2 > m.count { r.code = LN_TRUNCATED; return r; }
  r.features_n = ln_u16(m, at); r.features = at + 2; at = r.features + r.features_n;
  if at > m.count { r.code = LN_TRUNCATED; return r; }
  tlvs := m[at..<m.count]; p := 0; previous: u64 = 0; first := true; // mutant: equivalent (for previous: the first record never reads it)
  while p < tlvs.count {
    rec := tlv_next_vartime(tlvs, p, previous, first);
    if rec.code != LN_OK { r.code = rec.code; return r; }
    if rec.type == LN_INIT_NETWORKS {
      if rec.length % 32 != 0 { r.code = LN_BAD_LENGTH; return r; }
      r.networks = at + rec.start; r.networks_n = rec.length / 32;
    } else if rec.type == LN_INIT_REMOTE_ADDR {
      r.remote_addr = at + rec.start; r.remote_addr_n = rec.length;
    } else {
      if ln_unknown_vartime(rec.type) != LN_OK { r.code = LN_UNKNOWN_EVEN; return r; }
      r.ignored += 1;
    }
    previous = rec.type; first = false; p = rec.next;
  }
  return r;
}
// The combined bitmap: globalfeatures ORed into features, right-aligned,
// written to out[0..<n]; returns n, or -1 when out is too small.
ln_init_features_vartime :: (m: [] u8, r: LnInit, out: [] u8) -> int #effects(all) {
  n := ifx r.global_n > r.features_n then r.global_n else r.features_n; // mutant: equivalent (> or >=: at equal lengths both pick the same n)
  if n > out.count { return -1; }
  for i: 0..<n { out[i] = 0; }
  for i: 0..<r.global_n { out[n - r.global_n + i] |= m[r.global + i]; }
  for i: 0..<r.features_n { out[n - r.features_n + i] |= m[r.features + i]; }
  return n;
}
// An init with empty globalfeatures, the given features, and networks
// when chains is not empty. Returns the length, or -1.
ln_init_write_vartime :: (features: [] u8, chains: [] u8, out: [] u8) -> int #effects(all) {
  if chains.count % 32 != 0 || out.count < 6 + features.count { return -1; }
  ln_put16(out, 0, LN_INIT); ln_put16(out, 2, 0); ln_put16(out, 4, features.count);
  for i: 0..<features.count { out[6 + i] = features[i]; }
  w := 6 + features.count;
  if chains.count > 0 { w = tlv_write_vartime(out, w, LN_INIT_NETWORKS, chains); } // mutant: equivalent (for > 1: chains.count is a multiple of 32 here)
  if w > LN_MAX_MESSAGE { return -1; }
  return w;
}
// book:end init

// book:begin error
// error (17) and warning (1): a channel_id, all zeros for every channel,
// then a u16 length and that much data, which should be printable ASCII.
LnError :: struct { code: int; type: int; channel: int; all: bool; data: int; data_n: int; printable: bool; }
ln_error_read_vartime :: (m: [] u8) -> LnError #effects(all) {
  h := ln_message_read_vartime(m);
  if h.code != LN_OK { return LnError.{code = h.code}; }
  if h.type != LN_ERROR && h.type != LN_WARNING { return LnError.{code = LN_BAD_VALUE, type = h.type}; }
  if m.count < LN_TYPE + 34 { return LnError.{code = LN_TRUNCATED, type = h.type}; }
  r := LnError.{type = h.type, channel = LN_TYPE, all = true, data = LN_TYPE + 34, printable = true};
  for i: 0..<32 { if m[LN_TYPE + i] != 0 { r.all = false; } }
  r.data_n = ln_u16(m, LN_TYPE + 32);
  if r.data_n > m.count - r.data { return LnError.{code = LN_TRUNCATED, type = h.type}; }
  for i: 0..<r.data_n { c := m[r.data + i]; if c < 32 || c > 126 { r.printable = false; } }
  return r;
}
ln_error_write_vartime :: (type: int, channel: [32] u8, text: string, out: [] u8) -> int #effects(all) {
  n := LN_TYPE + 34 + text.count;
  if (type != LN_ERROR && type != LN_WARNING) || n > out.count || n > LN_MAX_MESSAGE { return -1; }
  ln_put16(out, 0, type);
  for i: 0..<32 { out[2 + i] = channel[i]; }
  ln_put16(out, 34, text.count);
  for i: 0..<text.count { out[36 + i] = text[i]; }
  return n;
}
// book:end error

// book:begin ping
// ping (18): num_pong_bytes, then byteslen bytes to ignore. pong (19):
// byteslen bytes to ignore. Both pads should be zeros, never secrets.
LnPing :: struct { code: int; type: int; pong_bytes: int; ignored_n: int; }
ln_ping_read_vartime :: (m: [] u8) -> LnPing #effects(all) {
  h := ln_message_read_vartime(m);
  if h.code != LN_OK { return LnPing.{code = h.code}; }
  if h.type != LN_PING && h.type != LN_PONG { return LnPing.{code = LN_BAD_VALUE, type = h.type}; }
  at := LN_TYPE; r := LnPing.{type = h.type, pong_bytes = -1};
  if h.type == LN_PING {
    if m.count < at + 2 { return LnPing.{code = LN_TRUNCATED, type = h.type}; } // mutant: equivalent (for < and <=, or 2 and 3: a 4-byte ping has no byteslen, so the next check refuses it with the same code and type)
    r.pong_bytes = ln_u16(m, at); at += 2;
  }
  if m.count < at + 2 { return LnPing.{code = LN_TRUNCATED, type = h.type}; }
  r.ignored_n = ln_u16(m, at);
  if r.ignored_n > m.count - at - 2 { return LnPing.{code = LN_TRUNCATED, type = h.type}; }
  return r;
}
ln_ping_write_vartime :: (pong_bytes: int, ignored: int, out: [] u8) -> int #effects(all) {
  n := LN_TYPE + 4 + ignored;
  if pong_bytes < 0 || pong_bytes > 65535 || ignored < 0 || n > out.count || n > LN_MAX_MESSAGE { return -1; }
  ln_put16(out, 0, LN_PING); ln_put16(out, 2, pong_bytes); ln_put16(out, 4, ignored);
  for i: 0..<ignored { out[6 + i] = 0; }
  return n;
}
// The reply to a ping: a pong of num_pong_bytes zeros, or nothing (0)
// when the ping asked for 65,532 bytes or more. Returns the length, or -1.
ln_pong_reply_vartime :: (ping: LnPing, out: [] u8) -> int #effects(all) {
  if ping.code != LN_OK || ping.type != LN_PING { return -1; }
  if ping.pong_bytes >= LN_PONG_LIMIT { return 0; }
  n := LN_TYPE + 2 + ping.pong_bytes;
  if n > out.count { return -1; }
  ln_put16(out, 0, LN_PONG); ln_put16(out, 2, ping.pong_bytes);
  for i: 0..<ping.pong_bytes { out[4 + i] = 0; }
  return n;
}
// book:end ping

// ---- checks
ln_nibble :: (c: u8) -> int #effects(all) {
  if c >= 'a' { return cast(int) (c - 'a') + 10; }
  if c >= 'A' { return cast(int) (c - 'A') + 10; }
  return cast(int) (c - '0');
}
ln_unhex :: (text: string, out: [] u8) -> [] u8 #effects(all) {
  for i: 0..<text.count / 2 { out[i] = cast(u8) (ln_nibble(text[2 * i]) * 16 + ln_nibble(text[2 * i + 1])); }
  return out[0..<text.count / 2];
}
ln_hex_is :: (a: [] u8, text: string) -> bool #effects(all) {
  if a.count * 2 != text.count { return false; }
  for i: 0..<a.count { if cast(int) a[i] != ln_nibble(text[2 * i]) * 16 + ln_nibble(text[2 * i + 1]) { return false; } }
  return true;
}

// BOLT 1's two test namespaces. n1: 1 tu64 amount, 2 short_channel_id,
// 3 point and two u64, 254 u16. n2: 0 tu64 amount, 11 tu32 cltv_expiry.
// One decoded n1 or n2 stream: which records appeared and their values.
LnTestStream :: struct {
  code: int;
  seen: [4] bool;  // n1: tlv1..tlv4; n2: tlv1, tlv2
  amount: u64; scid: u64; node_id: int; amount_1: u64; amount_2: u64; cltv: u64;
}
ln_test_decode_vartime :: (b: [] u8, space: int) -> LnTestStream #effects(all) {
  s: LnTestStream; at := 0; previous: u64 = 0; first := true; // mutant: equivalent (for previous: the first record never reads it)
  while at < b.count {
    r := tlv_next_vartime(b, at, previous, first);
    if r.code != LN_OK { s.code = r.code; return s; }
    v := b[r.start..<r.next];
    slot := -1; // mutant: equivalent (both namespace branches below assign slot)
    if space == 1 {
      slot = ifx r.type == 1 then 0 else ifx r.type == 2 then 1 else ifx r.type == 3 then 2 else ifx r.type == 254 then 3 else -1;
    } else {
      slot = ifx r.type == 0 then 0 else ifx r.type == 11 then 1 else -1;
    }
    if slot < 0 {
      if ln_unknown_vartime(r.type) != LN_OK { s.code = LN_UNKNOWN_EVEN; return s; }
    } else if space == 1 && slot == 1 {
      if v.count != 8 { s.code = LN_BAD_LENGTH; return s; }
      s.scid = cb_load_be64(v, 0).value;
    } else if space == 1 && slot == 2 {
      if v.count != 49 { s.code = LN_BAD_LENGTH; return s; }
      if !se_decode(v[0..<33]).ok { s.code = LN_BAD_VALUE; return s; }
      s.node_id = r.start; s.amount_1 = cb_load_be64(v, 33).value; s.amount_2 = cb_load_be64(v, 41).value;
    } else if space == 1 && slot == 3 {
      if v.count != 2 { s.code = LN_BAD_LENGTH; return s; }
      s.cltv = cast(u64) ln_u16(v, 0);
    } else {
      t := tu_read_vartime(v, ifx space == 2 && slot == 1 then 4 else 8);
      if t.code != LN_OK { s.code = t.code; return s; }
      if slot == 0 { s.amount = t.value; } else { s.cltv = t.value; }
    }
    if slot >= 0 { s.seen[slot] = true; }
    previous = r.type; first = false; at = r.next;
  }
  return s;
}

#test "BigSize: BOLT 1's decoding and encoding vectors" {
  b: [16] u8; out: [16] u8;
  for row: LN_BIGSIZE {
    got := bigsize_read_vartime(ln_unhex(row.bytes, b[..]), 0);
    if row.error.count > 0 { #assert got.code != LN_OK && got.next == 0; }
    else { #assert got.code == LN_OK && got.value == row.value && got.next == row.bytes.count / 2; }
  }
  for row: LN_BIGSIZE {
    if row.error.count == 0 && row.encode {
      n := bigsize_write_vartime(out[..], 0, row.value);
      #assert n == bigsize_size(row.value) && ln_hex_is(out[0..<n], row.bytes);
    }
  }
  #assert bigsize_write_vartime(out[0..<2], 0, 0xfd) == -1 && bigsize_write_vartime(out[..], 16, 0) == -1;
}
#test "BigSize codes: not minimal and truncated" {
  b: [16] u8;
  #assert bigsize_read_vartime(ln_unhex("fd00fc", b[..]), 0).code == LN_NOT_MINIMAL;
  #assert bigsize_read_vartime(ln_unhex("fe0000ffff", b[..]), 0).code == LN_NOT_MINIMAL;
  #assert bigsize_read_vartime(ln_unhex("ff00000000ffffffff", b[..]), 0).code == LN_NOT_MINIMAL;
  #assert bigsize_read_vartime(ln_unhex("fd00", b[..]), 0).code == LN_TRUNCATED;
  #assert bigsize_read_vartime(b[0..<0], 0).code == LN_TRUNCATED;
  #assert bigsize_size(0xfc) == 1 && bigsize_size(0xfd) == 3 && bigsize_size(0xffff) == 3 && bigsize_size(0x10000) == 5;
  #assert bigsize_size(0xffffffff) == 5 && bigsize_size(0x100000000) == 9;
}
#test "TLV: every BOLT 1 stream vector in its namespaces" {
  b: [400] u8;
  for row: LN_TLV {
    stream := ln_unhex(row.stream, b[..]);
    for ns: 1..<3 {
      if row.space == 0 || row.space == ns {
        got := ln_test_decode_vartime(stream, ns);
        #assert (got.code == LN_OK) == row.ok;
      }
    }
  }
}
#test "TLV: the n1 values BOLT 1 lists" {
  b: [400] u8;
  for row: LN_TLV {
    if row.ok && row.space == 1 {
      stream := ln_unhex(row.stream, b[..]);
      got := ln_test_decode_vartime(stream, 1);
      #assert got.code == LN_OK && got.seen[row.record - 1];
      if row.record == 1 { #assert got.amount == row.amount; }
      if row.record == 2 { #assert got.scid == row.scid; }
      if row.record == 3 { #assert ln_hex_is(stream[got.node_id..<got.node_id + 33], row.node_id) && got.amount_1 == row.amount && got.amount_2 == row.amount_2; }
      if row.record == 4 { #assert got.cltv == row.cltv; }
    }
  }
}
#test "TLV codes: order, unknown even, length and value" {
  b: [64] u8;
  #assert ln_test_decode_vartime(ln_unhex("02080000000000000226010129", b[..]), 1).code == LN_ORDER;
  #assert ln_test_decode_vartime(ln_unhex("1f001f012a", b[..]), 1).code == LN_ORDER;
  #assert ln_test_decode_vartime(ln_unhex("1200", b[..]), 1).code == LN_UNKNOWN_EVEN;
  #assert ln_test_decode_vartime(ln_unhex("010100", b[..]), 1).code == LN_NOT_MINIMAL;
  #assert ln_test_decode_vartime(ln_unhex("0209010101010101010101", b[..]), 1).code == LN_BAD_LENGTH;
  #assert ln_test_decode_vartime(ln_unhex("0ffd", b[..]), 1).code == LN_TRUNCATED;
  #assert ln_test_decode_vartime(ln_unhex("0ffd2602", b[..]), 1).code == LN_TRUNCATED;
  known := [2] u64.[2, 4];
  #assert tlv_check_vartime(ln_unhex("0200040021ff", b[..]), known[..]) == LN_TRUNCATED;
  #assert tlv_check_vartime(ln_unhex("02000400210100", b[..]), known[..]) == LN_OK;
  #assert tlv_check_vartime(ln_unhex("0200060021", b[..]), known[..]) == LN_UNKNOWN_EVEN;
}
#test "tlv_write and tu64 round-trip" {
  out: [32] u8; v := [3] u8.[1, 2, 3];
  n := tlv_write_vartime(out[..], 0, 0x10000, v[..]);
  #assert n == 9 && ln_hex_is(out[0..<n], "fe0001000003010203");
  r := tlv_next_vartime(out[0..<n], 0, 0, true);
  #assert r.code == LN_OK && r.type == 0x10000 && r.length == 3 && r.next == 9;
  #assert tlv_write_vartime(out[0..<8], 0, 0x10000, v[..]) == -1;
  for x: [5] u64.[0, 1, 255, 256, 0xffffffffffffffff] {
    m := tu_write_vartime(out[..], 0, x);
    t := tu_read_vartime(out[0..<m], 8);
    #assert m == tu_size(x) && t.code == LN_OK && t.value == x;
  }
  #assert tu_read_vartime(out[0..<5], 4).code == LN_BAD_LENGTH;
}
#test "messages: BOLT 1's init extension vectors" {
  b: [64] u8;
  for row: LN_INIT_ROWS {
    got := ln_init_read_vartime(ln_unhex(row.message, b[..]));
    #assert (got.code == LN_OK) == row.ok;
  }
  got := ln_init_read_vartime(ln_unhex("001000000000c9012acb0104", b[..]));
  #assert got.ignored == 2 && got.networks == -1;
  #assert ln_init_read_vartime(ln_unhex("00100000000001", b[..])).code == LN_TRUNCATED;
  #assert ln_init_read_vartime(ln_unhex("001000000000ca012a", b[..])).code == LN_UNKNOWN_EVEN;
  #assert ln_init_read_vartime(ln_unhex("001000000000c90101c90102", b[..])).code == LN_ORDER;
  #assert ln_init_read_vartime(ln_unhex("0010000100", b[..])).code == LN_TRUNCATED;
  #assert ln_init_read_vartime(ln_unhex("0011", b[..])).code == LN_BAD_VALUE;
  #assert ln_init_read_vartime(ln_unhex("00", b[..])).code == LN_TRUNCATED;
}
#test "init: features combine, and an unknown even bit refuses" {
  f: [8] u8; chains: [64] u8; out: [128] u8; m: [128] u8;
  #assert ln_feature_put(f[..], 9) && ln_feature_put(f[..], 14) && !ln_feature_put(f[..], 64);
  n := ln_init_write_vartime(f[8 - ln_feature_bytes(f[..])..<8], chains[..], out[..]);
  #assert n == 6 + 2 + 2 + 64;
  r := ln_init_read_vartime(out[0..<n]);
  #assert r.code == LN_OK && r.networks_n == 2 && r.features_n == 2;
  c := ln_init_features_vartime(out[0..<n], r, m[..]);
  #assert c == 2 && ln_feature_set(m[0..<c], 9) && ln_feature_set(m[0..<c], 14) && !ln_feature_set(m[0..<c], 8);
  known := [2] int.[8, 14];
  #assert ln_feature_refuse_vartime(m[0..<c], known[..]) == -1;
  odd := [1] int.[9];
  #assert ln_feature_refuse_vartime(m[0..<c], odd[..]) == 14;
  // Global bits are ORed into features: bit 1 from globalfeatures.
  g: [16] u8;
  r = ln_init_read_vartime(ln_unhex("00100001020002", g[..]));
  #assert r.code == LN_TRUNCATED;
  r = ln_init_read_vartime(ln_unhex("0010000102000101", g[..]));
  #assert r.code == LN_OK;
  c = ln_init_features_vartime(ln_unhex("0010000102000101", g[..]), r, m[..]);
  #assert c == 1 && m[0] == 3;
  #assert ln_init_read_vartime(ln_unhex("001000000000010100", g[..])).code == LN_BAD_LENGTH;
  #assert ln_feature_name(8) == "var_onion_optin" && ln_feature_name(63) == "option_splice" && ln_feature_name(2) == "";
}
#test "messages: dispatch by the odd rule" {
  #assert ln_dispatch_vartime(LN_PING).code == LN_OK && !ln_dispatch_vartime(LN_PING).ignore;
  #assert ln_dispatch_vartime(32769).ignore && ln_dispatch_vartime(32768).code == LN_UNKNOWN_EVEN;
  big: [65536] u8;
  #assert ln_message_read_vartime(big[..]).code == LN_TOO_LARGE && ln_message_read_vartime(big[0..<65535]).code == LN_OK;
}
#test "error, warning, ping and pong" {
  out: [70000] u8; ch: [32] u8;
  n := ln_error_write_vartime(LN_ERROR, ch, "bad", out[..]);
  e := ln_error_read_vartime(out[0..<n]);
  #assert n == 39 && e.code == LN_OK && e.all && e.data_n == 3 && e.printable && out[e.data] == 'b';
  ch[31] = 1; out[37] = 7;
  n = ln_error_write_vartime(LN_WARNING, ch, "x", out[..]); out[36] = 7;
  e = ln_error_read_vartime(out[0..<n]);
  #assert e.code == LN_OK && e.type == LN_WARNING && !e.all && !e.printable;
  #assert ln_error_read_vartime(out[0..<n - 1]).code == LN_TRUNCATED;
  #assert ln_error_write_vartime(LN_PING, ch, "x", out[..]) == -1;
  n = ln_ping_write_vartime(65531, 4, out[..]);
  p := ln_ping_read_vartime(out[0..<n]);
  #assert n == 10 && p.code == LN_OK && p.pong_bytes == 65531 && p.ignored_n == 4;
  reply: [65540] u8;
  m := ln_pong_reply_vartime(p, reply[..]);
  q := ln_ping_read_vartime(reply[0..<m]);
  #assert m == 65535 && q.code == LN_OK && q.type == LN_PONG && q.ignored_n == 65531;
  n = ln_ping_write_vartime(65532, 0, out[..]);
  #assert ln_pong_reply_vartime(ln_ping_read_vartime(out[0..<n]), reply[..]) == 0;
  #assert ln_ping_read_vartime(out[0..<5]).code == LN_TRUNCATED;
  #assert ln_ping_write_vartime(0, 65530, out[..]) == -1;
}
#test "BigSize, TLV and truncated integers: exact fits, the odd rule and the n2 namespace" {
  b: [64] u8; out: [16] u8; v := [3] u8.[1, 2, 3];
  #assert bigsize_write_vartime(out[0..<3], 0, 0xfd) == 3 && out[0] == 0xfd && out[1] == 0 && out[2] == 0xfd;
  #assert tlv_write_vartime(out[0..<5], 0, 1, v[..]) == 5 && ln_hex_is(out[0..<5], "0103010203");
  #assert tlv_write_vartime(out[0..<4], 0, 1, v[..]) == -1 && tlv_write_vartime(out[0..<0], 0, 1, v[0..<0]) == -1;
  #assert tlv_write_vartime(out[0..<2], 0, 1, v[0..<0]) == 2;
  #assert tu_write_vartime(out[0..<2], 0, 0x100) == 2 && out[0] == 1 && out[1] == 0;
  #assert tu_write_vartime(out[0..<4], 3, 0x100) == -1 && tu_write_vartime(out[..], -1, 1) == -1;
  // A length of 2 with one byte left is truncated.
  r := tlv_next_vartime(ln_unhex("010200", b[..]), 0, 0, true);
  #assert r.code == LN_TRUNCATED && r.type == 1 && r.next == 0;
  #assert ln_unknown_vartime(0) == LN_UNKNOWN_EVEN && ln_unknown_vartime(2) == LN_UNKNOWN_EVEN && ln_unknown_vartime(3) == LN_OK;
  // Type 0 may come first, and each type must be above the one before.
  known := [3] u64.[0, 1, 2];
  #assert tlv_check_vartime(ln_unhex("0000", b[..]), known[..]) == LN_OK;
  #assert tlv_check_vartime(ln_unhex("00000100", b[..]), known[..]) == LN_OK;
  #assert tlv_check_vartime(ln_unhex("02000100", b[..]), known[..]) == LN_ORDER;
  #assert tlv_check_vartime(ln_unhex("01000100", b[..]), known[..]) == LN_ORDER;
  // BOLT 1's n2: type 0 is a tu64 amount_msat, type 11 a tu32 cltv_expiry.
  s := ln_test_decode_vartime(ln_unhex("0000", b[..]), 2);
  #assert s.code == LN_OK && s.seen[0] && !s.seen[1] && s.amount == 0;
  s = ln_test_decode_vartime(ln_unhex("000101", b[..]), 2);
  #assert s.code == LN_OK && s.seen[0] && !s.seen[1] && s.amount == 1 && s.cltv == 0;
  s = ln_test_decode_vartime(ln_unhex("00050100000000", b[..]), 2);
  #assert s.code == LN_OK && s.amount == 4294967296;
  s = ln_test_decode_vartime(ln_unhex("0b0401000000", b[..]), 2);
  #assert s.code == LN_OK && s.seen[1] && !s.seen[0] && !s.seen[2] && s.cltv == 16777216 && s.amount == 0;
  s = ln_test_decode_vartime(ln_unhex("0001010b0102", b[..]), 2);
  #assert s.code == LN_OK && s.amount == 1 && s.cltv == 2;
  #assert ln_test_decode_vartime(ln_unhex("0b050100000000", b[..]), 2).code == LN_BAD_LENGTH;
  #assert ln_test_decode_vartime(ln_unhex("0b020001", b[..]), 2).code == LN_NOT_MINIMAL;
  // n1's exact refusals: tlv3 short, tlv3's node_id off the curve, tlv4 short.
  #assert ln_test_decode_vartime(ln_unhex("0321023da092f6980e58d2c037173180e9a465476026ee50f96695963e8efe436f54eb", b[..]), 1).code == LN_BAD_LENGTH;
  #assert ln_test_decode_vartime(ln_unhex("0331043da092f6980e58d2c037173180e9a465476026ee50f96695963e8efe436f54eb00000000000000010000000000000002", b[..]), 1).code == LN_BAD_VALUE;
  #assert ln_test_decode_vartime(ln_unhex("fd00fe00", b[..]), 1).code == LN_BAD_LENGTH;
  #assert ln_test_decode_vartime(ln_unhex("0109ffffffffffffffffff", b[..]), 1).code == LN_BAD_LENGTH;
}
#test "messages and init: the known types, exact refusals, and where each field sits" {
  b: [64] u8; out: [128] u8; m: [8] u8;
  h := ln_message_read_vartime(ln_unhex("00120000", b[..]));
  #assert h.code == LN_OK && h.type == LN_PING && h.payload == 2;
  for t: [5] int.[1, 16, 17, 18, 19] { d := ln_dispatch_vartime(t); #assert d.code == LN_OK && !d.ignore; }
  #assert ln_dispatch_vartime(3).ignore && ln_dispatch_vartime(20).code == LN_UNKNOWN_EVEN;
  #assert ln_init_read_vartime(ln_unhex("001000", b[..])).code == LN_TRUNCATED;
  #assert ln_init_read_vartime(ln_unhex("0010", b[..])).code == LN_TRUNCATED;
  r := ln_init_read_vartime(ln_unhex("001000000000", b[..]));
  #assert r.code == LN_OK && r.networks == -1 && r.remote_addr == -1 && r.networks_n == 0 && r.ignored == 0;
  // A first record of type 0 is an unknown even type, not out of order.
  #assert ln_init_read_vartime(ln_unhex("0010000000000000", b[..])).code == LN_UNKNOWN_EVEN;
  // remote_addr (type 3) starts after the type, both lengths and its own type and length.
  r = ln_init_read_vartime(ln_unhex("001000000000030401020304", b[..]));
  #assert r.code == LN_OK && r.remote_addr == 8 && r.remote_addr_n == 4 && r.ignored == 0 && r.networks == -1;
  chains: [32] u8; chains[0] = 0x6f; f := [1] u8.[2];
  n := ln_init_write_vartime(f[..], chains[..], out[..]);
  r = ln_init_read_vartime(out[0..<n]);
  #assert n == 6 + 1 + 2 + 32 && r.code == LN_OK && r.networks == 9 && r.networks_n == 1 && out[r.networks] == 0x6f;
  // Two-byte globalfeatures 0103 ORed into features 04, then globalfeatures 01 into features 0408.
  r = ln_init_read_vartime(ln_unhex("001000020103000104", b[..]));
  #assert r.code == LN_OK && r.global_n == 2 && r.features_n == 1;
  c := ln_init_features_vartime(ln_unhex("001000020103000104", b[..]), r, m[0..<2]);
  #assert c == 2 && m[0] == 1 && m[1] == 7;
  #assert ln_init_features_vartime(ln_unhex("001000020103000104", b[..]), r, m[0..<1]) == -1;
  r = ln_init_read_vartime(ln_unhex("001000010100020408", b[..]));
  c = ln_init_features_vartime(ln_unhex("001000010100020408", b[..]), r, m[0..<2]);
  #assert r.code == LN_OK && c == 2 && m[0] == 4 && m[1] == 9;
  // The writer: globalfeatures length zero, an exact fit, and no networks record without chains.
  for i: 0..<128 { out[i] = 0xff; }
  #assert ln_init_write_vartime(f[..], chains[0..<0], out[0..<7]) == 7;
  #assert out[0] == 0 && out[1] == 16 && out[2] == 0 && out[3] == 0 && out[4] == 0 && out[5] == 1 && out[6] == 2;
  #assert ln_init_write_vartime(f[..], chains[0..<0], out[0..<6]) == -1;
  #assert ln_init_write_vartime(f[..], chains[0..<31], out[..]) == -1;
  // 65,535 bytes is the largest message: 6 + 1013 + a networks record of 4 + 64,512.
  big: [70000] u8; many: [64512] u8; feats: [1014] u8;
  #assert ln_init_write_vartime(feats[0..<1013], many[..], big[..]) == 65535;
  #assert ln_init_write_vartime(feats[..], many[..], big[..]) == -1;
}
#test "error, warning, ping and pong: exact sizes, refusals and zeroed pads" {
  out: [70000] u8; ch: [32] u8; text: [65500] u8; m: [8] u8;
  n := ln_error_write_vartime(LN_ERROR, ch, "", out[0..<36]);
  e := ln_error_read_vartime(out[0..<n]);
  #assert n == 36 && e.code == LN_OK && e.channel == 2 && e.data == 36 && e.data_n == 0 && e.all && e.printable;
  #assert ln_error_write_vartime(LN_ERROR, ch, "", out[0..<35]) == -1;
  #assert ln_error_read_vartime(out[0..<35]).code == LN_TRUNCATED;
  #assert ln_error_write_vartime(LN_ERROR, ch, "a", out[0..<37]) == 37;
  // A channel_id whose first byte is set is one channel, not all of them.
  ch[0] = 5;
  n = ln_error_write_vartime(LN_ERROR, ch, "a", out[..]);
  e = ln_error_read_vartime(out[0..<n]);
  #assert out[2] == 5 && e.code == LN_OK && !e.all;
  // 300 bytes of data: the length's high byte is not part of the channel_id.
  ch[0] = 0;
  n = ln_error_write_vartime(LN_ERROR, ch, cast(string) text[0..<300], out[..]);
  e = ln_error_read_vartime(out[0..<n]);
  #assert e.code == LN_OK && e.all && e.data_n == 300 && out[34] == 1;
  // Printable ASCII is 32 to 126.
  edge := [2] u8.[' ', '~']; del := [1] u8.[127];
  n = ln_error_write_vartime(LN_WARNING, ch, cast(string) edge[..], out[..]);
  #assert ln_error_read_vartime(out[0..<n]).printable;
  n = ln_error_write_vartime(LN_WARNING, ch, cast(string) del[..], out[..]);
  #assert !ln_error_read_vartime(out[0..<n]).printable;
  // A ping is not an error, and an error is not a ping.
  n = ln_ping_write_vartime(0, 0, out[..]);
  #assert n == 6 && ln_error_read_vartime(out[0..<n]).code == LN_BAD_VALUE;
  n = ln_error_write_vartime(LN_ERROR, ch, "", out[..]);
  #assert ln_ping_read_vartime(out[0..<n]).code == LN_BAD_VALUE;
  for i: 0..<65500 { text[i] = 'a'; }
  #assert ln_error_write_vartime(LN_ERROR, ch, cast(string) text[0..<65499], out[..]) == 65535;
  #assert ln_error_write_vartime(LN_ERROR, ch, cast(string) text[..], out[..]) == -1;
  // ping: the pad is zeros, written into exactly 6 + byteslen bytes.
  for i: 0..<16 { out[i] = 0xff; }
  #assert ln_ping_write_vartime(0, 2, out[0..<8]) == 8 && out[6] == 0 && out[7] == 0 && out[8] == 0xff;
  #assert out[0] == 0 && out[1] == 18 && out[2] == 0 && out[3] == 0 && out[4] == 0 && out[5] == 2;
  #assert ln_ping_write_vartime(0, 2, out[0..<7]) == -1;
  #assert ln_ping_write_vartime(-1, 0, out[..]) == -1 && ln_ping_write_vartime(65536, 0, out[..]) == -1 && ln_ping_write_vartime(0, -1, out[..]) == -1;
  #assert ln_ping_write_vartime(65535, 0, out[..]) == 6 && ln_ping_write_vartime(0, 65529, out[..]) == 65535 && ln_ping_write_vartime(0, 65530, out[..]) == -1;
  #assert ln_ping_read_vartime(ln_unhex("0012", m[..])).code == LN_TRUNCATED;
  #assert ln_ping_read_vartime(ln_unhex("001200000001", m[..])).code == LN_TRUNCATED;
  p := ln_ping_read_vartime(ln_unhex("00120000000100", m[..]));
  #assert p.code == LN_OK && p.pong_bytes == 0 && p.ignored_n == 1;
  q := ln_ping_read_vartime(ln_unhex("00130000", m[..]));
  #assert q.code == LN_OK && q.type == LN_PONG && q.pong_bytes == -1 && q.ignored_n == 0;
  // pong: num_pong_bytes zeros, into exactly 4 + that many bytes; no reply to a pong or a bad ping.
  reply: [16] u8; for i: 0..<16 { reply[i] = 0xff; }
  p = ln_ping_read_vartime(ln_unhex("001200030000", m[..]));
  #assert ln_pong_reply_vartime(p, reply[0..<7]) == 7;
  #assert reply[0] == 0 && reply[1] == 19 && reply[2] == 0 && reply[3] == 3 && reply[4] == 0 && reply[5] == 0 && reply[6] == 0 && reply[7] == 0xff;
  #assert ln_pong_reply_vartime(p, reply[0..<6]) == -1;
  #assert ln_pong_reply_vartime(q, reply[..]) == -1 && ln_pong_reply_vartime(ln_ping_read_vartime(ln_unhex("0012", m[..])), reply[..]) == -1;
}
#test "feature bits at the byte edges, their names, and the hex helpers" {
  f: [8] u8; t: [8] u8; none: [1] int; low := [1] int.[0];
  #assert ln_feature_put(f[..], 0) && f[7] == 1 && ln_feature_set(f[..], 0);
  #assert ln_feature_put(f[..], 16) && f[5] == 1 && ln_feature_set(f[..], 16) && !ln_feature_set(f[..], 8);
  #assert !ln_feature_set(f[..], 64) && !ln_feature_set(f[..], -1);
  one := [2] u8.[1, 0];
  #assert ln_feature_bytes(one[..]) == 2 && ln_feature_bytes(t[..]) == 0 && ln_feature_bytes(f[..]) == 3;
  #assert ln_feature_refuse_vartime(f[..], none[0..<0]) == 0 && ln_feature_refuse_vartime(f[..], low[..]) == 16;
  #assert ln_feature_name(0) == "option_data_loss_protect" && ln_feature_name(51) == "option_zeroconf";
  #assert ln_feature_name(52) == "" && ln_feature_name(56) == "" && ln_feature_name(60) == "option_simple_close";
  #assert ln_feature_name(67) == "option_onion_messages_only_channels" && ln_feature_name(68) == "";
  #assert ln_unhex("ABCDEF", t[..]).count == 3 && t[0] == 0xab && t[1] == 0xcd && t[2] == 0xef;
  #assert ln_hex_is(t[0..<1], "ab") && ln_hex_is(t[0..<1], "AB") && !ln_hex_is(t[0..<1], "ab00") && !ln_hex_is(t[0..<1], "ac");
  #assert !ln_hex_is(one[..], "0000") && !ln_hex_is(one[..], "00");
}
