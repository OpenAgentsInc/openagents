  #assert invoice_put_bytes_vartime(w[..], INV_S, secret[..]) == INV_OK && invoice_put_bytes_vartime(w[..], INV_P, hash[..]) == INV_OK;
  #assert invoice_put_bytes_vartime(w[..], INV_D, inv_text("1 cup coffee", t[..])) == INV_OK;
  #assert invoice_put_number_vartime(w[..], INV_X, 60) == INV_OK && invoice_put_features_vartime(w[..], f[..]) == INV_OK;
  #assert inv_signed_is(w[..], INVOICE_ROWS[1].text);
  dh: [32] u8; pkh: [20] u8; hops: [2] InvHop;
