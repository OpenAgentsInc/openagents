  #assert ln_unhex("04b61f7dc1ea0dc99424464cc4064dc564d91e89", pkh[..]).count > 0;
  #assert ln_unhex("029e03a901b85534ff1e92c43c74431f7ce72046060fcf7a95c37e148f78c77255", hops[0].pubkey[..]).count > 0;
  #assert ln_unhex("039e03a901b85534ff1e92c43c74431f7ce72046060fcf7a95c37e148f78c77255", hops[1].pubkey[..]).count > 0;
  hops[0].scid = 0x0102030405060708; hops[0].fee_base = 1; hops[0].fee_ppm = 20; hops[0].cltv = 3;
  hops[1].scid = 0x030405060708090a; hops[1].fee_base = 2; hops[1].fee_ppm = 30; hops[1].cltv = 4;
  #assert invoice_begin_vartime(w[..], INV_MAINNET, true, 2000000000, 1496314658) == INV_OK;
  #assert invoice_put_bytes_vartime(w[..], INV_S, secret[..]) == INV_OK && invoice_put_bytes_vartime(w[..], INV_P, hash[..]) == INV_OK;
  #assert invoice_put_bytes_vartime(w[..], INV_H, dh[..]) == INV_OK && invoice_put_fallback_vartime(w[..], 17, pkh[..]) == INV_OK;
  #assert invoice_put_route_vartime(w[..], hops[..]) == INV_OK && invoice_put_features_vartime(w[..], f[..]) == INV_OK;
  #assert inv_signed_is(w[..], INVOICE_ROWS[5].text);
}
#test "an n field: verified with a low s, refused with a high one" #steps 4000000000 {
  w: [1] InvoiceWriter; inv: [1] Invoice; key: [32] u8; hash: [32] u8; out: [5000] u8;
  payee := inv_public(ln_unhex(INVOICE_KEY, key[..]));
  #assert invoice_begin_vartime(w[..], INV_REGTEST, true, 1, 1700000000) == INV_OK;
  #assert invoice_put_bytes_vartime(w[..], INV_P, hash[..]) == INV_OK && invoice_put_bytes_vartime(w[..], INV_S, key[..]) == INV_OK;
  #assert invoice_put_bytes_vartime(w[..], INV_D, hash[0..<0]) == INV_OK && invoice_put_bytes_vartime(w[..], INV_N, payee[..]) == INV_OK;
  t := invoice_sign_vartime(w[..], key[..], out[..]);
  #assert t.code == INV_OK && cast(string) out[0..<10] == "lnbcrt10p1";
  #assert invoice_decode_vartime(cast(string) out[0..<t.length], inv[..]) == INV_OK && inv[0].has_n && inv[0].amount_msat == 1;
  // Replace s with n - s: the same signature with a high s.
  sig: [65] u8; for i: 0..<64 { sig[i] = inv[0].signature[i]; } sig[64] = cast(u8) inv[0].recovery;
  borrow := 0;
  for k: 0..<32 {
    v := cast(int) ER_N[31 - k] - cast(int) sig[63 - k] - borrow;
    borrow = ifx v < 0 then 1 else 0; sig[63 - k] = cast(u8) (v + 256 * borrow);
  }
  words: [104] u8; n := inv_unpack(sig[..], words[..]);
  for i: 0..<104 { w[0].words[w[0].n + i] = words[i]; }
  e := b32_encode(cast(string) w[0].hrp[0..<w[0].hrp_n], cast(string) w[0].words[0..<w[0].n + 104], false, out[..], true, false, B32_BECH32);
  #assert e.error == NC_OK && invoice_decode_vartime(cast(string) out[0..<e.written], inv[..]) == INV_BAD_SIGNATURE;
}
#test "amounts: the shortest text, and the human-readable part read back" {
  w: [1] InvoiceWriter; t: [32] u8;
  msat := [7] u64.[1, 10, 1000, 100000, 250000000, 100000000000, 2100000000000000000];
  text := [7] string.["lnbc10p", "lnbc100p", "lnbc10n", "lnbc1u", "lnbc2500u", "lnbc1", "lnbc21000000"];
  for i: 0..<7 {
    #assert invoice_begin_vartime(w[..], INV_MAINNET, true, msat[i], 0) == INV_OK;
    #assert cast(string) w[0].hrp[0..<w[0].hrp_n] == text[i];
    a := inv_hrp_vartime(w[0].hrp[0..<w[0].hrp_n]);
    #assert a.code == INV_OK && a.has && a.msat == msat[i] && a.network == INV_MAINNET;
  }
  #assert invoice_begin_vartime(w[..], INV_SIGNET, false, 0, 0) == INV_OK && cast(string) w[0].hrp[0..<w[0].hrp_n] == "lntbs";
  #assert inv_hrp_vartime(inv_text("lntbs", t[..])).network == INV_SIGNET && inv_hrp_vartime(inv_text("lnbcrt", t[..])).network == INV_REGTEST;
  #assert inv_hrp_vartime(inv_text("lnxy", t[..])).code == INV_BAD_PREFIX && inv_hrp_vartime(inv_text("bc", t[..])).code == INV_BAD_PREFIX;
  #assert inv_hrp_vartime(inv_text("lnbc25mm", t[..])).code == INV_BAD_AMOUNT && inv_hrp_vartime(inv_text("lnbc11p", t[..])).code == INV_BAD_AMOUNT;
  #assert inv_hrp_vartime(inv_text("lnbc99999999999999999999", t[..])).code == INV_BAD_AMOUNT;
  #assert inv_hrp_vartime(inv_text("lnbc184467441", t[..])).code == INV_BAD_AMOUNT;
  #assert invoice_begin_vartime(w[..], 5, false, 0, 0) == INV_BAD_PREFIX && invoice_begin_vartime(w[..], 1, false, 0, cast(u64) 1 << 35) == INV_BAD_LENGTH;
}
#test "words and bytes, and UTF-8" {
  b := [3] u8.[0xff, 0x00, 0x81]; words: [5] u8; back: [4] u8; t: [32] u8;
  n := inv_unpack(b[..], words[..]);
  #assert n == 5 && words[0] == 31 && words[1] == 28 && words[3] == 8 && words[4] == 2;
  #assert inv_pack(words[0..<n], back[..]) == 4 && back[0] == 0xff && back[2] == 0x81 && back[3] == 0;
  #assert inv_number(words[0..<2]) == 31 * 32 + 28;
  #assert inv_utf8_vartime(inv_text("ナンセンス 1杯", t[..])) && inv_utf8_vartime(t[0..<0]);
  bad := [5] string.["c0af", "eda080", "f4908080", "e383", "80"];
  for s: bad { #assert !inv_utf8_vartime(ln_unhex(s, t[..])); }
  good := [3] string.["c2a9", "f09f9880", "efbfbd"];
  for s: good { #assert inv_utf8_vartime(ln_unhex(s, t[..])); }
}
#test "refusals: fields that break their type's rules" #steps 4000000000 {
  w: [1] InvoiceWriter; inv: [1] Invoice; key: [32] u8; z: [32] u8; out: [5000] u8; x: [2] u8;
  #assert ln_unhex(INVOICE_KEY, key[..]).count > 0;
  codes: [8] int;
  for c: 0..<8 {
    #assert invoice_begin_vartime(w[..], INV_MAINNET, false, 0, 1) == INV_OK;
    #assert invoice_put_bytes_vartime(w[..], INV_P, z[..]) == INV_OK && invoice_put_bytes_vartime(w[..], INV_S, z[..]) == INV_OK;
    if c != 1 { #assert invoice_put_bytes_vartime(w[..], INV_D, inv_text("x", x[..])) == INV_OK; }
    zero_first := [2] u8.[0, 1]; long: [13] u8; long[0] = 1; f: [3] u8; ff := [1] u8.[0xff];
    if c == 0 { #assert invoice_put_bytes_vartime(w[..], INV_H, z[..]) == INV_OK; }                 // d and h
    if c == 2 { #assert invoice_put_words_vartime(w[..], INV_X, zero_first[..]) == INV_OK; }       // x with a zero word
    if c == 3 { #assert invoice_put_words_vartime(w[..], INV_C, long[..]) == INV_OK; }             // c above 64 bits
    if c == 4 { #assert invoice_put_fallback_vartime(w[..], 0, z[0..<21]) == INV_OK; }             // v0 of 21 bytes
    if c == 5 { #assert invoice_put_bytes_vartime(w[..], INV_R, out[0..<50]) == INV_OK; }            // a 50-byte hop
    if c == 6 { #assert ln_feature_put(f[..], 16) && invoice_put_features_vartime(w[..], f[..]) == INV_OK; }  // basic_mpp alone
    if c == 7 { #assert invoice_put_bytes_vartime(w[..], INV_M, z[0..<1]) == INV_OK; }
    if c == 7 { #assert invoice_put_bytes_vartime(w[..], INV_D, ff[..]) == INV_OK; }               // not UTF-8
    t := invoice_sign_vartime(w[..], key[..], out[..]);
    #assert t.code == INV_OK;
    codes[c] = invoice_decode_vartime(cast(string) out[0..<t.length], inv[..]);
  }
  #assert codes[0] == INV_REQUIRED && codes[1] == INV_REQUIRED && codes[2] == INV_NOT_MINIMAL && codes[3] == INV_BAD_LENGTH;
  #assert codes[4] == INV_BAD_FALLBACK && codes[5] == INV_BAD_ROUTE && codes[6] == INV_BAD_FEATURES && codes[7] == INV_BAD_UTF8;
  #assert invoice_begin_vartime(w[..], INV_MAINNET, false, 0, 1) == INV_OK && invoice_put_fallback_vartime(w[..], 19, z[..]) == INV_BAD_FALLBACK;
  #assert invoice_begin_vartime(w[..], INV_MAINNET, false, 0, 1) == INV_OK && invoice_put_route_vartime(w[..], inv[0].hops[0..<0]) == INV_BAD_ROUTE;
  #assert invoice_begin_vartime(w[..], INV_MAINNET, false, 0, 1) == INV_OK && invoice_put_words_vartime(w[..], 32, z[..]) == INV_BAD_LENGTH;
  #assert invoice_sign_vartime(w[..], key[..], out[..]).code == INV_BAD_LENGTH;
  #assert invoice_begin_vartime(w[..], INV_MAINNET, false, 0, 1) == INV_OK && invoice_sign_vartime(w[..], key[..], out[0..<10]).code == INV_CAPACITY;
  #assert invoice_decode_vartime(cast(string) out[0..<0], inv[..]) == INV_BAD_BECH32;
}
