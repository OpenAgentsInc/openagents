// The local CLI reports' goldens (compliance plan step C7, GitHub #13250): proto/coder/local-inventory-v1.json
// holds the agents and models inventories and proto/coder/dictation-v1.json dictation's event lines,
// each as the CLI printed it. For each body this check
//   - holds its keys to the json_names of its message in proto/descriptors/cli-local.pb (an
//     inventory has each field once, in field order; an event line has only keys its message names);
//   - reads it through the codec (inventory-wire.coax, dictation-wire.coax) and writes it again
//     from what was read, for the same bytes.
// It never writes a body to compare with itself: every body here came from a run of the CLI.
//
//   coax/web/tool.sh coax/lib/local/local-goldens.coax proto/coder/local-inventory-v1.json
//   coax/web/tool.sh coax/lib/local/local-goldens.coax proto/coder/dictation-v1.json
#import "Basic";
#load "inventory-wire.coax";
#load "dictation-wire.coax";
#load "../proto/importer.coax";
#load "../proto/golden-keys.coax";
#load "../sys/tool.coax";
#load "../sys/args.coax";
#load "../sys/fs.coax";

LG_DESCRIPTOR :: "proto/descriptors/cli-local.pb";
LG_BODY :: 65536;
LG_N :: 4;
LG_KINDS :: [LG_N] string.["agents", "models", "dictation", "stream"];
LG_MESSAGES :: [LG_N] string.[".openagents.cli.local.v1.Agents", ".openagents.cli.local.v1.Models",
                              ".openagents.cli.dictation.v1.Event", ".openagents.cli.dictation.v1.StreamEvent"];

LgWork :: struct {
  nodes: [16384] JvNode; body_nodes: [4096] JvNode; name: [256] u8; kind: [64] u8; body: [LG_BODY] u8; back: [LG_BODY] u8;
  agents: [INV_AGENTS_MOST] InvAgent; models: [INV_MODELS_MOST] InvModel; line: [1] DwLine;
}
// A body read through its codec and written again from what was read: the text, or "" when the
// codec refuses it.
lg_rewrite :: (kind: string, body: string, w: [] LgWork) -> string {
  o: [1] Jo; jo_start(o[..], w[0].back[..]);
  if kind == "agents" {
    r := inv_read_agents(body, w[0].body_nodes[..], w[0].agents[..]);
    if !r.read || r.ok != r.complete { return ""; }
    inv_agents_open(o[..], r.complete);
    for i: 0..<r.n {
      if !w[0].agents[i].running || w[0].agents[i].attached { return ""; }
      inv_agents_row(o[..], inv_agent_engine(w[0].agents[..], i), inv_agent_name(w[0].agents[..], i), w[0].agents[i].pid, w[0].agents[i].parent);
    }
    return inv_agents_close(o[..]);
  }
  if kind == "models" {
    r := inv_read_models(body, w[0].body_nodes[..], w[0].models[..]);
    if !r.read { return ""; }
    inv_models_open(o[..], r.ok);
    for i: 0..<r.n {
      m := w[0].models[..];
      if m[i].loaded { return ""; }
      inv_models_row(o[..], inv_model_id(m, i), inv_model_kind(m, i), inv_model_name(m, i), inv_model_revision(m, i), inv_model_path(m, i), m[i].present, m[i].bytes, m[i].verified);
    }
    return inv_models_close(o[..]);
  }
  if !dw_read(body, w[0].body_nodes[..], w[0].line[..]) || w[0].line[0].cut || w[0].line[0].stream != (kind == "stream") { return ""; }
  return dw_write(dw_view(w[0].line[..]), w[0].back[..]);
}
lg_message :: (kind: string) -> string {
  kinds := LG_KINDS; messages := LG_MESSAGES;
  for k: 0..<LG_N { if kinds[k] == kind { return messages[k]; } }
  return "";
}
// A body's faults against the descriptor and the codec: "" when it holds.
lg_body :: (st: [] D_State, kind: string, body: string, w: [] LgWork) -> string {
  inventory := kind == "agents" || kind == "models";
  why := pk_text_keys(st, lg_message(kind), body, inventory, false, w[0].body_nodes[..]);
  if why != "" { return why; }
  if lg_rewrite(kind, body, w) != body { return "read through the codec and written back, it is not the same bytes"; }
  return "";
}
lg_check :: (text: string, st: [] D_State, w: [] LgWork) -> int {
  j: [1] Jv;
  if !jv_parse(j[..], text, w[0].nodes[..]) || jv_kind(j[0], 0) != JV_OBJECT { print("FAIL  cannot parse the fixture\n"); return 1; }
  d := j[0];
  goldens := jv_get(d, 0, "goldens");
  if jv_kind(d, goldens) != JV_ARRAY || jv_len(d, goldens) == 0 { print("FAIL  no goldens\n"); return 1; }
  bad := 0;
  for i: 0..<jv_len(d, goldens) {
    item := jv_at(d, goldens, i);
    name := cast(string) w[0].name[0..<jv_str(d, jv_get(d, item, "name"), w[0].name[..])];
    kind := cast(string) w[0].kind[0..<jv_str(d, jv_get(d, item, "kind"), w[0].kind[..])];
    bn := jv_str(d, jv_get(d, item, "body"), w[0].body[..]);
    if bn <= 0 || lg_message(kind) == "" { print("FAIL  % : no body, or no kind %\n", name, kind); bad += 1; continue; }
    why := lg_body(st, kind, cast(string) w[0].body[0..<bn], w);
    if why != "" { print("FAIL  % (%): %\n", name, kind, why); bad += 1; } else { print("ok    % (%)\n", name, kind); }
  }
  print("%\n", ifx bad == 0 then "local goldens hold" else "local goldens fail");
  return ifx bad == 0 then 0 else 1;
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  loaded := args_load(args[..]);
  if !loaded || args_count(args[..]) < 1 { tool_errln("usage: local-goldens FIXTURE.json"); return 2; }
  pb: [65536] u8;
  pn := fs_read(LG_DESCRIPTOR, pb[..]);
  if pn <= 0 { tool_errln("local-goldens: cannot read the descriptor"); return 2; }
  g: [1] PkDescriptor;
  err := pk_load(g[..], cast(string) pb[0..<pn]);
  if err != "" { print("FAIL  descriptor: %\n", err); return 1; }
  st := g[0].state[..];
  w: [1] LgWork;
  // the checks bite: a key the message lacks, a member missing, members out of order, a spaced
  // body, an agent that is attached, a stream line under the final-only schema's kind, a type the
  // schema lacks, members in another order
  if lg_body(st, "agents", "{\"schema\":\"openagents.coder.agents.v1\",\"ok\":true,\"complete\":true,\"scope\":\"local_running_processes\",\"agent\":[]}", w[..]) == "" ||
     lg_body(st, "agents", "{\"schema\":\"openagents.coder.agents.v1\",\"ok\":true,\"complete\":true,\"agents\":[]}", w[..]) == "" ||
     lg_body(st, "agents", "{\"schema\":\"openagents.coder.agents.v1\",\"complete\":true,\"ok\":true,\"scope\":\"local_running_processes\",\"agents\":[]}", w[..]) == "" ||
     lg_body(st, "agents", "{\"schema\": \"openagents.coder.agents.v1\",\"ok\":true,\"complete\":true,\"scope\":\"local_running_processes\",\"agents\":[]}", w[..]) == "" ||
     lg_body(st, "agents", "{\"schema\":\"openagents.coder.agents.v1\",\"ok\":true,\"complete\":true,\"scope\":\"local_running_processes\",\"agents\":[{\"engine\":\"codex\",\"name\":\"Codex\",\"pid\":4,\"parent_pid\":1,\"state\":\"running\",\"attached\":true}]}", w[..]) == "" ||
     lg_body(st, "agents", "{\"schema\":\"openagents.coder.agents.v1\",\"ok\":true,\"complete\":true,\"scope\":\"local_running_processes\",\"agents\":[{\"engine\":\"codex\",\"name\":\"Codex\",\"pid\":4,\"parent_pid\":1,\"state\":\"running\",\"attached\":false}]}", w[..]) != "" ||
     lg_body(st, "models", "{\"schema\":\"openagents.models.v1\",\"ok\":true,\"models\":[{\"id\":\"parakeet\",\"kind\":\"audio\",\"name\":\"P\",\"revision\":\"5\",\"path\":\"/p\",\"present\":true,\"bytes\":1,\"verified\":false}]}", w[..]) == "" ||
     lg_body(st, "models", "{\"schema\":\"openagents.models.v1\",\"ok\":true,\"models\":[{\"id\":\"parakeet\",\"kind\":\"audio\",\"name\":\"P\",\"revision\":\"5\",\"path\":\"/p\",\"present\":true,\"bytes\":1,\"verified\":false,\"loaded\":false}]}", w[..]) != "" ||
     lg_body(st, "dictation", "{\"schema\":\"openagents.dictation.stream.v1\",\"type\":\"cancelled\",\"event\":4,\"ticket\":1,\"sequence\":7,\"samples\":17920,\"profile\":\"p\",\"model\":\"m\",\"revision\":\"r\",\"capture\":\"fixture\",\"exit\":130}", w[..]) == "" ||
     lg_body(st, "stream", "{\"schema\":\"openagents.dictation.stream.v1\",\"type\":\"cancelled\",\"event\":4,\"ticket\":1,\"sequence\":7,\"samples\":17920,\"profile\":\"p\",\"model\":\"m\",\"revision\":\"r\",\"capture\":\"fixture\",\"exit\":130}", w[..]) != "" ||
     lg_body(st, "stream", "{\"schema\":\"openagents.dictation.stream.v1\",\"type\":\"cancelled\",\"ticket\":1,\"event\":4,\"sequence\":7,\"samples\":17920,\"profile\":\"p\",\"model\":\"m\",\"revision\":\"r\",\"capture\":\"fixture\",\"exit\":130}", w[..]) == "" ||
     lg_body(st, "dictation", "{\"schema\":\"openagents.dictation.v1\",\"type\":\"partial\",\"text\":\"x\"}", w[..]) == "" ||
     lg_body(st, "dictation", "{\"schema\":\"openagents.dictation.v1\",\"type\":\"status\",\"state\":\"ready\",\"words\":\"x\"}", w[..]) == "" ||
     lg_body(st, "dictation", "{\"schema\":\"openagents.dictation.v1\",\"type\":\"status\",\"state\":\"ready\"}", w[..]) != "" {
    print("FAIL  the check takes a body it should refuse, or refuses one it should take\n"); return 1;
  }
  buf: [262144] u8;
  n := fs_read(args_at(args[..], 0), buf[..]);
  if n <= 0 { tool_errln("local-goldens: cannot read the fixture"); return 2; }
  return lg_check(cast(string) buf[0..<n], st, w[..]);
}
