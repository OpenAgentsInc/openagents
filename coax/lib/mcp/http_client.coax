  n := mcp_client_write_simple_req(c[0].core[..], "prompts/list", cursor, id_out[..], c[0].req_buf[..]);
  if n < 0 { return MCP_HC_ERR_BUF; }
  rc := mcp_hc_post_rpc(c, "prompts/list", "", "", cast(string) c[0].req_buf[0..<n], id_out[0]);
  if rc != MCP_HC_OK { return rc; }
