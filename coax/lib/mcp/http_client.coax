mcp_hc_ping :: (c: [] McpHttpClient) -> int {
  id_out: [1] int;
  n := mcp_client_write_ping(c[0].core[..], id_out[..], c[0].req_buf[..]);
  if n < 0 { return MCP_HC_ERR_BUF; }
  rc := mcp_hc_post_rpc(c, "ping", "", "", cast(string) c[0].req_buf[0..<n], id_out[0]);
  if rc != MCP_HC_OK { return rc; }
  if c[0].last_event.kind == MCP_CLI_EV_RESPONSE_OK { return MCP_HC_OK; }
  return MCP_HC_ERR_PROTO;
}

// Terminates a stateful 2025-11-25 session via HTTP DELETE (best-effort).
mcp_hc_close :: (c: [] McpHttpClient) {
  if c[0].get_h >= 0 {
    mcp_hc_sock_close(c[0].tls, c[0].get_h);
    c[0].get_h = -1;
  }
  if c[0].connected && c[0].session_len > 0 {
    hn := mcp_hc_append_common_headers(c, c[0].aux_hdr_buf[..], 0, "", "", true, true);
    if hn >= 0 {
      wn := mcp_http_write_req("DELETE", mcp_hc_target(c), mcp_hc_host_hdr(c), cast(string) c[0].aux_hdr_buf[0..<hn], "", c[0].aux_wire_buf[..]);
      if wn > 0 {
        h := mcp_hc_sock_open(c, 3000);
        if h >= 0 {
          _ = mcp_hc_sock_send_all(c[0].tls, h, cast(string) c[0].aux_wire_buf[0..<wn], 3000);
          _ = mcp_hc_sock_read_some(c[0].tls, h, c[0].aux_read_buf[..], 1000);
          mcp_hc_sock_close(c[0].tls, h);
        }
      }
    }
  }
  c[0].connected = false;
}
