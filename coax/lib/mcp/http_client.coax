  if c[0].last_event.kind == MCP_CLI_EV_RESPONSE_OK { return MCP_HC_OK; }
  return MCP_HC_ERR_PROTO;
}

mcp_hc_resources_read :: (c: [] McpHttpClient, uri: string) -> int {
  id_out: [1] int;
  n := mcp_client_write_resources_read(c[0].core[..], uri, "", "", id_out[..], c[0].req_buf[..]);
  if n < 0 { return MCP_HC_ERR_BUF; }
  rc := mcp_hc_post_rpc(c, "resources/read", uri, "", cast(string) c[0].req_buf[0..<n], id_out[0]);
  if rc != MCP_HC_OK { return rc; }
  if c[0].last_event.kind == MCP_CLI_EV_RESPONSE_OK { return MCP_HC_OK; }
  return MCP_HC_ERR_PROTO;
}

mcp_hc_prompts_list :: (c: [] McpHttpClient, cursor: string) -> int {
