// MCP protocol revision constants, dual-era version classification/negotiation
// (2025-11-25 stateful initialize vs 2026-07-28 stateless per-request metadata),
// and _meta / extension identifier naming rules. Pure #authority module.
#authority;

MCP_LATEST :: "2026-07-28";
MCP_LATEST_WITH_INITIALIZE :: "2025-11-25";

MCP_V_2026_07_28 :: "2026-07-28";
MCP_V_2025_11_25 :: "2025-11-25";
MCP_V_2025_06_18 :: "2025-06-18";
MCP_V_2025_03_26 :: "2025-03-26";
MCP_V_2024_11_05 :: "2024-11-05";

// Reserved 2026-07-28 _meta keys (per-request metadata).
MCP_META_PROTOCOL_VERSION :: "io.modelcontextprotocol/protocolVersion";
MCP_META_CLIENT_CAPABILITIES :: "io.modelcontextprotocol/clientCapabilities";
MCP_META_CLIENT_INFO :: "io.modelcontextprotocol/clientInfo";
MCP_META_SERVER_INFO :: "io.modelcontextprotocol/serverInfo";
MCP_META_LOG_LEVEL :: "io.modelcontextprotocol/logLevel";
MCP_META_SUBSCRIPTION_ID :: "io.modelcontextprotocol/subscriptionId";

MCP_META_KEY_MAX :: 256;

#test "version constants, format validation, and known revisions are exact" {
  #assert MCP_LATEST == "2026-07-28";
  #assert MCP_LATEST_WITH_INITIALIZE == "2025-11-25";
  #assert mcp_version_known(MCP_V_2024_11_05);
  #assert mcp_version_known(MCP_V_2025_03_26);
  #assert mcp_version_known(MCP_V_2025_06_18);
  #assert mcp_version_known(MCP_V_2025_11_25);
  #assert mcp_version_known(MCP_V_2026_07_28);
  #assert !mcp_version_known("2026-01-01") && !mcp_version_known("") && !mcp_version_known("draft");

  // Format check: exact YYYY-MM-DD with valid month 01..12 and day 01..31.
  #assert mcp_version_format_ok("2026-07-28");
  #assert mcp_version_format_ok("0000-01-01");
  #assert mcp_version_format_ok("9999-12-31");
  bad := [15] string.[
    "", "2026-7-28", "2026-07-280", "2026/07/28", "2026-07/28",
    "a026-07-28", "202a-07-28", "2026-00-15", "2026-13-15", "2026-07-00", "2026-07-32",
    "2026-0a-01", "2026-01-0a", "2026-1a-01", "2026-01-3a"
  ];
  for s: bad { #assert !mcp_version_format_ok(s); }
}

#test "dual-era version comparison and capability gates distinguish 2025 vs 2026" {
  #assert mcp_version_cmp("1999-12-31", "2024-11-05") == -1;
  #assert mcp_version_cmp("3000-01-01", "2026-07-28") == 1;
  #assert mcp_version_cmp("2024-11-05", "2025-03-26") == -1;
  #assert mcp_version_cmp("2025-11-25", "2025-11-25") == 0;
  #assert mcp_version_cmp("2026-07-28", "2025-11-25") == 1;
  #assert mcp_version_cmp("bad", "2026-07-28") == -2;
  #assert mcp_version_cmp("2026-07-28", "bad") == -2;

  #assert mcp_version_has_initialize("2024-11-05");
  #assert mcp_version_has_initialize("2025-03-26");
  #assert mcp_version_has_initialize("2025-06-18");
  #assert mcp_version_has_initialize("2025-11-25");
  #assert mcp_version_has_initialize("2026-07-27");
  #assert !mcp_version_has_initialize("2026-07-28");
  #assert !mcp_version_has_initialize("2027-01-01");
  #assert !mcp_version_has_initialize("bad");

  #assert !mcp_version_is_modern("2025-11-25");
  #assert !mcp_version_is_modern("2026-07-27");
  #assert mcp_version_is_modern("2026-07-28");
  #assert mcp_version_is_modern("2027-01-01");
  #assert !mcp_version_is_modern("bad");

  #assert !mcp_version_requires_header("2024-11-05");
  #assert !mcp_version_requires_header("2025-03-26");
  #assert !mcp_version_requires_header("2025-06-17");
  #assert mcp_version_requires_header("2025-06-18");
  #assert mcp_version_requires_header("2025-11-25");
  #assert mcp_version_requires_header("2026-07-28");
  #assert !mcp_version_requires_header("bad");
}

#test "legacy initialize negotiation clamps 2026 down to highest initialize version" {
  dual := [3] string.["2026-07-28", "2025-11-25", "2025-06-18"];
  #assert mcp_version_negotiate_legacy("2025-06-18", dual[..]) == "2025-06-18";
  #assert mcp_version_negotiate_legacy("2025-11-25", dual[..]) == "2025-11-25";
  // Requesting 2026-07-28 over initialize MUST NOT return 2026-07-28.
  #assert mcp_version_negotiate_legacy("2026-07-28", dual[..]) == "2025-11-25";
  #assert mcp_version_negotiate_legacy("1999-01-01", dual[..]) == "2025-11-25";
  #assert mcp_version_negotiate_legacy("bad", dual[..]) == "2025-11-25";

  // Unsorted supported list still selects the highest legacy version.
  unsorted := [3] string.["2024-11-05", "2025-11-25", "2025-06-18"];
  #assert mcp_version_negotiate_legacy("2099-01-01", unsorted[..]) == "2025-11-25";

  // Modern-only server cannot negotiate legacy initialize.
  modern_only := [1] string.["2026-07-28"];
  #assert mcp_version_negotiate_legacy("2025-11-25", modern_only[..]) == "";
  #assert mcp_version_negotiate_legacy("2026-07-28", modern_only[..]) == "";

  // Modern negotiation requires exact supported modern version.
  #assert mcp_version_negotiate_modern("2026-07-28", dual[..]);
  #assert !mcp_version_negotiate_modern("2025-11-25", dual[..]);
  #assert !mcp_version_negotiate_modern("2027-01-01", dual[..]);
  #assert !mcp_version_negotiate_modern("bad", dual[..]);
}

#test "meta keys and extension identifiers obey MCP prefix/name grammar" {
  good_meta := [7] string.[
    "progressToken",
    "a",
    "a1",
    "a.b_c-d9",
    MCP_META_PROTOCOL_VERSION,
    "io.modelcontextprotocol/ui",
    "com.example-1.sub/my_ext.v2-beta"
  ];
  for k: good_meta { #assert mcp_meta_key_ok(k); }

  #assert !mcp_meta_prefix_ok("");
  #assert !mcp_extension_id_ok("progressToken");
  #assert mcp_extension_id_ok("io.modelcontextprotocol/tasks");
  #assert mcp_extension_id_ok("io.modelcontextprotocol/ui");
  #assert mcp_extension_id_ok("a/b");
  #assert mcp_extension_id_ok("a.b/c");

  bad_meta := [22] string.[
    "",
    "/",
    "//a",
    "/name",
    "prefix/",
    "a/b/c",
    "-name",
    "name-",
    "_name",
    "name_",
    ".name",
    "name.",
    "a!b",
    "ab!c",
    "1label/name",
    "label-/name",
    "-label/name",
    "a..b/name",
    ".a/name",
    "a./name",
    "a_b/name",
    "io.mcp/bad name"
  ];
  for k: bad_meta {
    #assert !mcp_meta_key_ok(k);
    #assert !mcp_extension_id_ok(k);
  }

  // Exact MCP_META_KEY_MAX ceiling.
  max_key: [MCP_META_KEY_MAX + 1] u8;
  for i: 0..<max_key.count { max_key[i] = 'a'; }
  #assert mcp_meta_key_ok(cast(string) max_key[0..<MCP_META_KEY_MAX]);
  #assert !mcp_meta_key_ok(cast(string) max_key[..]);
}

#forall "ASCII helpers match exact byte ranges" b: 0..<256 {
  c := cast(u8) b;
  is_d := b >= 48 && b <= 57;
  is_a := (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
  #assert mcp_ver_digit(c) == is_d;
  #assert mcp_ver_alpha(c) == is_a;
  #assert mcp_ver_alnum(c) == (is_a || is_d);
}

mcp_ver_digit :: (c: u8) -> bool #effects(all) { return c >= '0' && c <= '9'; }
mcp_ver_alpha :: (c: u8) -> bool #effects(all) { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'); }
mcp_ver_alnum :: (c: u8) -> bool #effects(all) { return mcp_ver_alpha(c) || mcp_ver_digit(c); }

mcp_version_format_ok :: (v: string) -> bool #effects(all) {
  if v.count != 10 { return false; }
  if v[4] != '-' || v[7] != '-' { return false; }
  for i: 0..<10 {
    if i == 4 || i == 7 { continue; }
    if !mcp_ver_digit(v[i]) { return false; }
  }
  month := (cast(int) (v[5] - '0')) * 10 + cast(int) (v[6] - '0');
  day := (cast(int) (v[8] - '0')) * 10 + cast(int) (v[9] - '0');
  if month < 1 || month > 12 { return false; }
  if day < 1 || day > 31 { return false; }
  return true;
}

mcp_version_known :: (v: string) -> bool #effects(all) {
  return v == MCP_V_2026_07_28 || v == MCP_V_2025_11_25 || v == MCP_V_2025_06_18 || v == MCP_V_2025_03_26 || v == MCP_V_2024_11_05;
}

// Lexicographic comparison of valid YYYY-MM-DD versions. Returns -1, 0, 1, or -2 if either is malformed.
mcp_version_cmp :: (a: string, b: string) -> int #effects(all) {
  if !mcp_version_format_ok(a) || !mcp_version_format_ok(b) { return -2; }
  for i: 0..<10 {
    if a[i] < b[i] { return -1; }
    if a[i] > b[i] { return 1; }
  }
  return 0;
}

mcp_version_has_initialize :: (v: string) -> bool #effects(all) {
  c := mcp_version_cmp(v, MCP_V_2026_07_28);
  return c == -1;
}

mcp_version_is_modern :: (v: string) -> bool #effects(all) {
  c := mcp_version_cmp(v, MCP_V_2026_07_28);
  return c == 0 || c == 1;
}

mcp_version_requires_header :: (v: string) -> bool #effects(all) {
  c := mcp_version_cmp(v, MCP_V_2025_06_18);
  return c == 0 || c == 1;
}

// Legacy initialize version negotiation: returns requested if it is a supported
// initialize-era version, else the highest supported initialize-era version, or "".
mcp_version_negotiate_legacy :: (requested: string, supported: [] string) -> string #effects(all) {
  best := "";
  for v: supported {
    if !mcp_version_has_initialize(v) { continue; }
    if v == requested { return v; }
    if best.count == 0 || mcp_version_cmp(v, best) == 1 { best = v; }
  }
  return best;
}

// Modern stateless negotiation: requested must be a supported modern (>= 2026-07-28) version.
mcp_version_negotiate_modern :: (requested: string, supported: [] string) -> bool #effects(all) {
  if !mcp_version_is_modern(requested) { return false; }
  for v: supported {
    if v == requested { return true; }
  }
  return false;
}

mcp_meta_label_ok :: (s: string) -> bool #effects(all) {
  if s.count == 0 { return false; }
  if !mcp_ver_alpha(s[0]) { return false; }
  if !mcp_ver_alnum(s[s.count - 1]) { return false; }
  for i: 1..<s.count - 1 {
    c := s[i];
    if !mcp_ver_alnum(c) && c != '-' { return false; }
  }
  return true;
}

mcp_meta_prefix_ok :: (p: string) -> bool #effects(all) {
  if p.count == 0 { return false; }
  start := 0;
  for i: 0..<p.count { // mutant: equivalent (i=0 -> i=1: if p[0]=='.', mcp_meta_label_ok rejects non-alpha p[0] anyway)
    if p[i] == '.' {
      if !mcp_meta_label_ok(p[start..<i]) { return false; }
      start = i + 1;
    }
  }
  return mcp_meta_label_ok(p[start..<p.count]);
}

mcp_meta_name_ok :: (name: string) -> bool #effects(all) {
  if name.count == 0 { return false; }
  if !mcp_ver_alnum(name[0]) || !mcp_ver_alnum(name[name.count - 1]) { return false; }
  for i: 1..<name.count - 1 {
    c := name[i];
    if !mcp_ver_alnum(c) && c != '-' && c != '_' && c != '.' { return false; }
  }
  return true;
}

// Validates MCP _meta key grammar: optional dot-separated prefix + '/' + name.
mcp_meta_key_ok :: (key: string) -> bool #effects(all) {
  if key.count == 0 || key.count > MCP_META_KEY_MAX { return false; }
  slash := 0;
  for i: 1..<key.count {
    if key[i] == '/' { slash = i; break; }
  }
  if slash == 0 { return mcp_meta_name_ok(key); }
  return mcp_meta_prefix_ok(key[0..<slash]) && mcp_meta_name_ok(key[slash + 1..<key.count]);
}

// Extension identifiers MUST follow _meta key rules with a mandatory prefix.
mcp_extension_id_ok :: (id: string) -> bool #effects(all) {
  if !mcp_meta_key_ok(id) { return false; }
  for c: id { if c == '/' { return true; } }
  return false;
}
