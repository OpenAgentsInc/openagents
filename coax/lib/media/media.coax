// Pictures, clips and decks of pages, in headless Chrome: shots (media_shot),
// clips (media_record, media_encode) and PDF slide decks (dk_*). One file so
// the CLI stays inside the compiler's 128-unit budget for one program.
// A picture of a page: one headless Chrome tab (coax/lib/net/cdp.coax) set to
// a size, sent to a URL, given time to draw, and captured as a PNG. No
// window opens and nothing takes focus. The callers are coax/web/shot.coax
// (`coax/web/tool.sh shot`) and the CLI's `openagents labs shot`.
//   c: [1] Cdp; cdp_launch(c[..], 1440, 900, "coax-shot-");
//   o: MediaShotOptions; o.wait = 4000;
//   s := media_shot(c[..], url, "out.png", ArgsSize.{ok = true, w = 1440, h = 900}, o, value[..], build[..]);
// It waits o.wait ms of real time (the pages animate in), runs o.script once
// and keeps what it returns in value (a string as it is, anything else as
// compact JSON), then captures. o.dark asks the page for its dark theme
// (prefers-color-scheme: dark). The page's build (the hashed Wasm name of a
// Coaxial page, or "") goes in build.
#load "../net/cdp.coax";
#load "../../../apps/openagents-web/font.coax";

MEDIA_PNG :: 25165824;   // the largest screenshot, 24 MiB

MediaShotOptions :: struct { wait: int = 4000; script: string; dark: bool; }
// status 0 when the PNG was written, 1 when Chrome failed (cdp_error says
// why), 2 for a URL too long, 3 when the file could not be written.
// value_n: bytes of the script's value (-1 when none).
MediaShot :: struct { status: int; value_n: int = -1; build_n: int; }

// The page's built program, from its script tag: "newland.1f7cafcf955e" for
// "/build/newland.1f7cafcf955e.wasm"; "" when it names none.
MEDIA_BUILD_JS :: "(() => { const s = document.querySelector('script[data-wasm]'); const w = s && s.dataset.wasm || ''; return w.replace(/^.*\\//, '').replace(/\\.wasm$/, ''); })()";

media_size :: (c: [] Cdp, wh: ArgsSize) -> bool {
  params: [512] u8; o: [1] Jo;
  jo_start(o[..], params[..]);
  jo_obj(o[..]); jo_key(o[..], "width"); jo_int(o[..], wh.w); jo_key(o[..], "height"); jo_int(o[..], wh.h);
  jo_key(o[..], "deviceScaleFactor"); jo_int(o[..], 1); jo_key(o[..], "mobile"); jo_bool(o[..], wh.w < 600); jo_end(o[..]);
  return cdp_call(c, "Emulation.setDeviceMetricsOverride", jo_text(o[..]), CDP_CALL_MS) >= 0;
}
// prefers-color-scheme for the pages that follow: dark, or the browser's own.
media_scheme :: (c: [] Cdp, dark: bool) -> bool {
  return cdp_call(c, "Emulation.setEmulatedMedia",
                  ifx dark then "{\"features\":[{\"name\":\"prefers-color-scheme\",\"value\":\"dark\"}]}"
                  else "{\"features\":[{\"name\":\"prefers-color-scheme\",\"value\":\"\"}]}", CDP_CALL_MS) >= 0;
}
// A script's value as text into out: a string as it is, anything else as
// compact JSON. Its length, or -1.
media_value :: (c: [] Cdp, script: string, out: [] u8) -> int {
  v := cdp_evaluate(c, script);
  if v < 0 { return -1; }
  d := cdp_doc(c);
  if jv_kind(d, v) == JV_STRING { return jv_str(d, v, out); }
  w: [1] Jo; jo_start(w[..], out); jv_write(d, v, w[..]);
  return ifx w[0].bad then -1 else jo_text(w[..]).count;
}

media_shot :: (c: [] Cdp, url: string, out: string, wh: ArgsSize, o: MediaShotOptions, value: [] u8, build: [] u8) -> MediaShot {
  s: MediaShot;
  if !media_size(c, wh) || !media_scheme(c, o.dark) { s.status = 1; return s; }
  params: [8192] u8; j: [1] Jo;
  jo_start(j[..], params[..]); jo_obj(j[..]); jo_key(j[..], "url"); jo_str(j[..], url); jo_end(j[..]);
  if j[0].bad { s.status = 2; return s; }
  if cdp_call(c, "Page.navigate", jo_text(j[..]), CDP_CALL_MS) < 0 { s.status = 1; return s; }
  proc_sleep(o.wait);
  if o.script.count > 0 {
    s.value_n = media_value(c, o.script, value);
    proc_sleep(500);
  }
  bn := media_value(c, MEDIA_BUILD_JS, build);
  s.build_n = ifx bn > 0 then bn else 0;
  png: [MEDIA_PNG] u8;
  n := cdp_screenshot(c, png[..]);
  if n < 0 { s.status = 1; return s; }
  if !fs_write(out, cast(string) png[0..<n]) { s.status = 3; return s; }
  return s;
}

// ---- clips ----------------------------------------------------------------------

// A clip of a page: headless Chrome in clip mode (host.js), where every frame
// is one fixed step of game time, so a slow machine never makes it stutter
// and the same staged moment gives the same frames. Each frame is captured
// as a PNG; media_encode joins them into an MP4 with ffmpeg. Nothing opens
// on screen and no sound plays. The callers are coax/web/clip.coax
// (`coax/web/tool.sh clip`) and the CLI's `openagents labs clip`.
// A page stages its own moments from its URL (?stage=NAME): see
// docs/verse/clips.md.

// Loads the page in clip mode, waits until it draws, runs the script and the
// skip, and writes each frame as a PNG. "" when it worked, else what failed.
media_record :: (c: [] Cdp, url: string, wh: ArgsSize, seconds: f64, fps: f64, fr: string, skip: f64, script: string, frames: string) -> string {
  params: [8192] u8; o: [1] Jo;
  if !media_size(c, wh) { return cdp_error(c); }
  if cdp_call(c, "Emulation.setFocusEmulationEnabled", "{\"enabled\":true}", CDP_CALL_MS) < 0 { return cdp_error(c); }
  if cdp_call(c, "Runtime.enable", "", CDP_CALL_MS) < 0 { return cdp_error(c); }
  // Page.enable comes before the scripts: without it they do not run on the next document.
  if cdp_call(c, "Page.enable", "", CDP_CALL_MS) < 0 { return cdp_error(c); }
  if cdp_call(c, "Page.addScriptToEvaluateOnNewDocument", "{\"source\":\"globalThis.coaxialClip = true\"}", CDP_CALL_MS) < 0 { return cdp_error(c); }
  // a clip never counts as a visit
  if cdp_call(c, "Page.addScriptToEvaluateOnNewDocument", "{\"source\":\"Object.defineProperty(Navigator.prototype, 'sendBeacon', { value: () => false })\"}", CDP_CALL_MS) < 0 { return cdp_error(c); }
  jo_start(o[..], params[..]); jo_obj(o[..]); jo_key(o[..], "url"); jo_str(o[..], url); jo_end(o[..]);
  if o[0].bad { return "the URL is too long"; }
  if cdp_call(c, "Page.navigate", jo_text(o[..]), CDP_CALL_MS) < 0 { return cdp_error(c); }
  // Ready when a step draws and the loading card is gone. Until then each step is a
  // thousandth of a millisecond of game time, so loading never eats the lead-up.
  up := false;
  for i: 0..<600 {
    proc_sleep(100);
    v := cdp_evaluate(c, "typeof coaxialClipStep === 'function' ? coaxialClipStep(1, 1e6).then(d => d && !document.getElementById('coaxial-load')) : false");
    if jv_kind(cdp_doc(c), v) == JV_TRUE { up = true; break; }
  }
  if !up { return "the page never finished loading (no WebGPU, or the engine failed)"; }
  if script.count > 0 { v := cdp_evaluate(c, script); }
  expr: [128] u8;
  left := clip_round(skip * fps);
  while left > 0 {
    k := ifx left < 30 then left else 30;
    v := cdp_evaluate(c, clip_step(k, fr, expr[..]));
    left -= 30;
  }
  total := clip_round(seconds * fps);
  one := clip_step(1, fr, expr[..]);
  png: [MEDIA_PNG] u8; name: [16] u8; path: [4200] u8;
  for i: 0..<total {
    v := cdp_evaluate(c, one);
    n := cdp_screenshot(c, png[..]);
    if n < 0 { return cdp_error(c); }
    if !fs_write(fs_join(frames, clip_frame_name(i, name[..]), path[..]), cast(string) png[0..<n]) { return "could not write a frame"; }
  }
  return "";
}

#test "rounding, numbers and frame names as clip.ts made them" {
  #assert clip_round(1.5 * 30.0) == 45 && clip_round(2.5) == 3 && clip_round(-2.5) == -2 && clip_round(0.49) == 0 && clip_round(0.0) == 0;
  #assert clip_round(3.0 * 30.0) == 90 && clip_round(6.0 * 30.0) == 180;
  name: [16] u8;
  #assert clip_frame_name(0, name[..]) == "f00000.png" && clip_frame_name(1234, name[..]) == "f01234.png" && clip_frame_name(123456, name[..]) == "f123456.png";
  e: [128] u8;
  #assert clip_step(30, "30", e[..]) == "coaxialClipStep(30, 30)" && clip_step(1, "24", e[..]) == "coaxialClipStep(1, 24)";
}
// Math.round: halves go up.
clip_round :: (x: f64) -> int { return int(floor(x + 0.5)); }
clip_frame_name :: (i: int, out: [] u8) -> string {
  digits: [16] u8;
  k := ws_digits(digits[..], 0, i);
  n := ws_put(out, 0, "f");
  for z: k..<5 { n = ws_put(out, n, "0"); }
  n = ws_put(out, n, cast(string) digits[0..<k]);
  n = ws_put(out, n, ".png");
  return cast(string) out[0..<n];
}
clip_step :: (k: int, fps: string, out: [] u8) -> string {
  n := ws_put(out, 0, "coaxialClipStep(");
  n = ws_digits(out, n, k);
  n = ws_put(out, n, ", ");
  n = ws_put(out, n, fps);
  n = ws_put(out, n, ")");
  return cast(string) out[0..<n];
}

// The frames in dir (f00000.png, ...) at fps_text a second as an H.264 MP4
// at out, by ffmpeg (the program named, or "ffmpeg"). "" when it worked,
// else ffmpeg's words, into err.
media_encode :: (ffmpeg: string, frames: string, fps_text: string, out: string, err: [] u8) -> string {
  pattern: [4200] u8;
  argv := [17] string.[ifx ffmpeg.count > 0 then ffmpeg else "ffmpeg", "-v", "error", "-y", "-framerate", fps_text, "-i", fs_join(frames, "f%05d.png", pattern[..]),
                       "-c:v", "libx264", "-pix_fmt", "yuv420p", "-crf", "18", "-movflags", "+faststart", out];
  so: [4096] u8;
  enc := proc_run(argv[..], -1, so[..], err);
  if enc.started != 0 { return "ffmpeg was not found"; }
  if enc.status != 0 { return ifx enc.err_n > 0 then cast(string) err[0..<enc.err_n] else "ffmpeg failed"; }
  return "";
}

// ---- decks ------------------------------------------------------------------------

// A PDF slide deck in the Grid style of openagents.com from a deck file. The
// callers are coax/web/deck.coax (`coax/web/tool.sh deck DECK.deck OUT.pdf
// [--fresh]`) and the CLI's `openagents labs deck`.
// Titles and labels are set in Filament, the site's stroke font, drawn as
// vector strokes; body text is Helvetica with the site's widths. A scene is a
// live page (a realm, the homepage, any URL) taken in headless Chrome at the
// size of the place it fills. Images, big numbers and box diagrams fill the
// other cells. The deck file format is in docs/web/decks.md.
// Scenes are kept in DECK.captures/ beside the deck file and reused while the
// scene line is the same; --fresh takes every scene again. Nothing opens on
// screen and no sound plays.

// font.coax draws into a page's vertex buffer and loads with the page's own
// stroke quad (lit) and helpers; these are the changelog page's. The deck
// draws its glyphs as PDF strokes and never calls it, but font.coax's
// checks do.
VERTEX_FLOATS :: 12;
lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count || light <= 0.002 { return false; }
  dx := bx - ax; dy := by - ay; length := sqrt(dx * dx + dy * dy); if length <= 0 { return false; }
  ux := dx / length; uy := dy / length; nx := -uy; ny := ux; r := glow + core;
  a := [6] f32.[-r, length + r, length + r, -r, length + r, -r]; c := [6] f32.[-r, -r, r, -r, r, r];
  for q: 0..<6 {
    o := (at + q) * VERTEX_FLOATS;
    out[o] = ax + ux * a[q] + nx * c[q]; out[o + 1] = ay + uy * a[q] + ny * c[q]; out[o + 2] = a[q]; out[o + 3] = c[q];
    out[o + 4] = length; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow; out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
  }
  return true;
}
dk_hi :: (a: f32, b: f32) -> f32 { return ifx a > b then a else b; }
dk_lo :: (a: f32, b: f32) -> f32 { return ifx a < b then a else b; }
dk_imax :: (a: int, b: int) -> int { return ifx a > b then a else b; }
dk_imin :: (a: int, b: int) -> int { return ifx a < b then a else b; }

// ---------------------------------------------------------------- the page

DK_PAGE_W :: 960.0;   // points: 16:9
DK_PAGE_H :: 540.0;
DK_GAP :: 0.5; DK_SPACE :: 1.2;   // Filament's letter gap and space, in cap heights (as on the site)
DK_CELL_GAP :: 12.0;
DK_HEAD :: 20.0;               // a cell's label bar

// The Grid palette (apps/openagents-web/realmlist.coax inks, on its near-black ground).
DkRgb :: struct { r: f32; g: f32; b: f32; }
DK_BG :: DkRgb.{r = 0.024, g = 0.026, b = 0.031};
DK_GRID_LINE :: DkRgb.{r = 0.07, g = 0.075, b = 0.085};
DK_PANEL :: DkRgb.{r = 0.035, g = 0.039, b = 0.046};
DK_EDGE :: DkRgb.{r = 0.14, g = 0.15, b = 0.17};
DK_CORNER :: DkRgb.{r = 0.5, g = 0.53, b = 0.58};
DK_TEXT :: DkRgb.{r = 0.84, g = 0.84, b = 0.86};
DK_DIM :: DkRgb.{r = 0.45, g = 0.46, b = 0.5};
DK_FAINT :: DkRgb.{r = 0.26, g = 0.27, b = 0.3};
DK_ACCENT :: DkRgb.{r = 0.5, g = 0.82, b = 1.0};

// ---------------------------------------------------------------- the deck file

DK_MAX_SRC :: 1048576;
DK_MAX_SLIDES :: 96; DK_MAX_CELLS :: 768; DK_MAX_LINES :: 2048; DK_MAX_NODES :: 1024; DK_MAX_EDGES :: 1024; DK_MAX_ASSETS :: 800;
DK_CK_SCENE :: 1; DK_CK_IMAGE :: 2; DK_CK_TEXT :: 3; DK_CK_STAT :: 4; DK_CK_DIAGRAM :: 5;
DK_AK_SCENE :: 1; DK_AK_IMAGE :: 2;
DK_SCENE_WAIT :: 6000;

DkSpan :: struct { at: int; n: int; }
DkSlide :: struct { kicker: DkSpan; title: DkSpan; subtitle: DkSpan; cols: int; rows: int; back: int; first: int; count: int; }
DkCell :: struct { kind: int; src: DkSpan; label: DkSpan; caption: DkSpan; asset: int; l0: int; l1: int; n0: int; n1: int; e0: int; e1: int; }
DkLine :: struct { bullet: bool; text: DkSpan; }
DkNode :: struct { id: DkSpan; col: int; row: int; text: DkSpan; }
DkEdge :: struct { a: DkSpan; b: DkSpan; text: DkSpan; }
// A picture on a page: a scene to take, or an image file. w, h: the points it fills.
DkAsset :: struct { kind: int; src: DkSpan; wait: int; js: DkSpan; w: f32; h: f32; vw: int; vh: int;
                  path: [1024] u8; path_n: int; px: int; py: int; comps: int; obj: int; }

DkDeck :: struct {
  src: [DK_MAX_SRC] u8; n: int;
  name: DkSpan; base: DkSpan;
  slides: [DK_MAX_SLIDES] DkSlide; slide_n: int;
  cells: [DK_MAX_CELLS] DkCell; cell_n: int;
  lines: [DK_MAX_LINES] DkLine; line_n: int;
  nodes: [DK_MAX_NODES] DkNode; node_n: int;
  edges: [DK_MAX_EDGES] DkEdge; edge_n: int;
  assets: [DK_MAX_ASSETS] DkAsset; asset_n: int;
  err: [600] u8; err_n: int;
  loud: bool = true;              // dk_pictures names each picture it takes on stderr
  taken: int; kept: int;          // pictures taken, and kept from before, by dk_pictures
}

dk_sp :: (d: [] DkDeck, s: DkSpan) -> string { return cast(string) d[0].src[s.at..<s.at + s.n]; }
dk_no_span :: () -> DkSpan { return DkSpan.{at = 0, n = 0}; }

dk_is_space :: (c: u8) -> bool { return c == ' ' || c == '\t' || c == '\r'; }
// s without its spaces at both ends, as a span of the deck's source from at.
dk_trim :: (d: [] DkDeck, s: DkSpan) -> DkSpan {
  a := s.at; b := s.at + s.n;
  while a < b && dk_is_space(d[0].src[a]) { a += 1; }
  while b > a && dk_is_space(d[0].src[b - 1]) { b -= 1; }
  return DkSpan.{at = a, n = b - a};
}
// The first word of s and what follows it (trimmed).
DkSplit :: struct { head: DkSpan; rest: DkSpan; }
dk_split_word :: (d: [] DkDeck, s: DkSpan) -> DkSplit {
  t := dk_trim(d, s); i := t.at; e := t.at + t.n;
  while i < e && !dk_is_space(d[0].src[i]) { i += 1; }
  return DkSplit.{head = DkSpan.{at = t.at, n = i - t.at}, rest = dk_trim(d, DkSpan.{at = i, n = e - i})};
}
// s cut at the first '|': the part before (trimmed) and after.
dk_split_bar :: (d: [] DkDeck, s: DkSpan) -> DkSplit {
  i := s.at; e := s.at + s.n;
  while i < e && d[0].src[i] != '|' { i += 1; }
  if i >= e { return DkSplit.{head = dk_trim(d, s), rest = DkSpan.{at = e, n = 0}}; }
  return DkSplit.{head = dk_trim(d, DkSpan.{at = s.at, n = i - s.at}), rest = DkSpan.{at = i + 1, n = e - i - 1}};
}
// A whole number, or -1.
dk_whole :: (text: string) -> int {
  if text.count == 0 || text.count > 9 { return -1; }
  v := 0;
  for c: text { if c < '0' || c > '9' { return -1; } v = v * 10 + cast(int) (c - '0'); }
  return v;
}

dk_fail :: (d: [] DkDeck, line: int, what: string) -> bool {
  m := "line "; n := 0;
  for c: m { d[0].err[n] = c; n += 1; }
  t: [12] u8; k := 0; v := line;
  if v == 0 { t[0] = '0'; k = 1; }
  while v > 0 { t[k] = cast(u8) ('0' + v % 10); v /= 10; k += 1; }
  for j: 0..<k { d[0].err[n] = t[k - 1 - j]; n += 1; }
  d[0].err[n] = ':'; d[0].err[n + 1] = ' '; n += 2;
  for c: what { if n < d[0].err.count { d[0].err[n] = c; n += 1; } }
  d[0].err_n = n;
  return false;
}
dk_deck_error :: (d: [] DkDeck) -> string { return cast(string) d[0].err[0..<d[0].err_n]; }

// A new scene or image: src then options (wait=MS) up to the first '|'.
dk_add_asset :: (d: [] DkDeck, kind: int, s: DkSpan) -> int {
  if d[0].asset_n >= DK_MAX_ASSETS { return -1; }
  k := d[0].asset_n; d[0].asset_n += 1;
  w := dk_split_word(d, s);
  d[0].assets[k].kind = kind; d[0].assets[k].src = w.head; d[0].assets[k].wait = DK_SCENE_WAIT;
  d[0].assets[k].js = dk_no_span(); d[0].assets[k].obj = 0; d[0].assets[k].path_n = 0;
  o := w.rest;
  while o.n > 0 {
    x := dk_split_word(d, o);
    t := dk_sp(d, x.head);
    if t.count > 5 && t[0..<5] == "wait=" { v := dk_whole(t[5..<t.count]); if v < 0 { return -2; } d[0].assets[k].wait = v; }
    else { return -3; }
    o = x.rest;
  }
  return k;
}

dk_parse :: (d: [] DkDeck) -> bool {
  d[0].slide_n = 0; d[0].cell_n = 0; d[0].line_n = 0; d[0].node_n = 0; d[0].edge_n = 0; d[0].asset_n = 0;
  d[0].name = dk_no_span(); d[0].base = dk_no_span();
  i := 0; line := 0;
  while i < d[0].n {
    j := i; while j < d[0].n && d[0].src[j] != '\n' { j += 1; }
    line += 1;
    raw := DkSpan.{at = i, n = j - i}; i = j + 1;
    t := dk_trim(d, raw);
    if t.n == 0 || d[0].src[t.at] == '#' { continue; }
    indented := dk_is_space(d[0].src[raw.at]);
    w := dk_split_word(d, t); word := dk_sp(d, w.head);
    s := d[0].slide_n - 1;
    if indented {
      if s < 0 || d[0].slides[s].count == 0 { return dk_fail(d, line, "an indented line belongs to a text or diagram cell"); }
      ci := d[0].cell_n - 1; c := d[0].cells[ci];
      if c.kind == DK_CK_TEXT {
        if d[0].line_n >= DK_MAX_LINES { return dk_fail(d, line, "too many text lines"); }
        bullet := t.n >= 2 && d[0].src[t.at] == '-' && dk_is_space(d[0].src[t.at + 1]);
        text := ifx bullet then dk_trim(d, DkSpan.{at = t.at + 2, n = t.n - 2}) else t;
        d[0].lines[d[0].line_n] = DkLine.{bullet = bullet, text = text}; d[0].line_n += 1; d[0].cells[ci].l1 = d[0].line_n;
        continue;
      }
      if c.kind == DK_CK_DIAGRAM && word == "node" {
        a := dk_split_word(d, w.rest); b := dk_split_word(d, a.rest); r := dk_split_word(d, b.rest);
        col := dk_whole(dk_sp(d, b.head)); row := dk_whole(dk_sp(d, r.head));
        if a.head.n == 0 || col < 0 || row < 0 || col > 12 || row > 12 { return dk_fail(d, line, "node is: node ID COLUMN ROW TEXT"); }
        if d[0].node_n >= DK_MAX_NODES { return dk_fail(d, line, "too many nodes"); }
        d[0].nodes[d[0].node_n] = DkNode.{id = a.head, col = col, row = row, text = ifx r.rest.n > 0 then r.rest else a.head};
        d[0].node_n += 1; d[0].cells[ci].n1 = d[0].node_n;
        continue;
      }
      if c.kind == DK_CK_DIAGRAM && word == "edge" {
        a := dk_split_word(d, w.rest); b := dk_split_word(d, a.rest);
        if a.head.n == 0 || b.head.n == 0 { return dk_fail(d, line, "edge is: edge FROM TO [TEXT]"); }
        if d[0].edge_n >= DK_MAX_EDGES { return dk_fail(d, line, "too many edges"); }
        d[0].edges[d[0].edge_n] = DkEdge.{a = a.head, b = b.head, text = b.rest}; d[0].edge_n += 1; d[0].cells[ci].e1 = d[0].edge_n;
        continue;
      }
      return dk_fail(d, line, "an indented line belongs to a text or diagram cell (a diagram takes node and edge)");
    }
    if word == "deck" { d[0].name = w.rest; continue; }
    if word == "base" { d[0].base = w.rest; continue; }
    if word == "slide" {
      if d[0].slide_n >= DK_MAX_SLIDES { return dk_fail(d, line, "too many slides"); }
      d[0].slides[d[0].slide_n] = DkSlide.{kicker = dk_no_span(), title = dk_no_span(), subtitle = dk_no_span(), cols = 1, rows = 1, back = -1, first = d[0].cell_n, count = 0};
      d[0].slide_n += 1;
      continue;
    }
    if s < 0 { return dk_fail(d, line, "start a slide first (a line with: slide)"); }
    sl := d[0].slides[s];
    if word == "kicker" { d[0].slides[s].kicker = w.rest; continue; }
    if word == "title" { d[0].slides[s].title = w.rest; continue; }
    if word == "subtitle" { d[0].slides[s].subtitle = w.rest; continue; }
    if word == "grid" {
      g := dk_sp(d, w.rest); x := 0;
      while x < g.count && g[x] != 'x' { x += 1; }
      cols := ifx x < g.count then dk_whole(g[0..<x]) else -1;
      rows := ifx x < g.count then dk_whole(g[x + 1..<g.count]) else -1;
      if cols < 1 || rows < 1 || cols > 8 || rows > 8 { return dk_fail(d, line, "grid is COLUMNSxROWS, each 1 to 8, like 3x2"); }
      d[0].slides[s].cols = cols; d[0].slides[s].rows = rows;
      continue;
    }
    if word == "background" {
      k := dk_add_asset(d, DK_AK_SCENE, w.rest);
      if k < 0 { return dk_fail(d, line, "background is: background URL [wait=MS]"); }
      d[0].slides[s].back = k;
      continue;
    }
    if word == "eval" {
      k := d[0].asset_n - 1;
      if k < 0 || d[0].assets[k].kind != DK_AK_SCENE { return dk_fail(d, line, "eval follows a scene or background"); }
      d[0].assets[k].js = w.rest;
      continue;
    }
    kind := 0;
    if word == "scene" { kind = DK_CK_SCENE; } else if word == "image" { kind = DK_CK_IMAGE; }
    else if word == "text" { kind = DK_CK_TEXT; } else if word == "stat" { kind = DK_CK_STAT; } else if word == "diagram" { kind = DK_CK_DIAGRAM; }
    if kind == 0 { return dk_fail(d, line, "a line starts with deck, base, slide, kicker, title, subtitle, grid, background, scene, image, text, stat, diagram or eval"); }
    if d[0].cell_n >= DK_MAX_CELLS { return dk_fail(d, line, "too many cells"); }
    if sl.count >= sl.cols * sl.rows { return dk_fail(d, line, "more cells than the grid has (set grid first)"); }
    p1 := dk_split_bar(d, w.rest); p2 := dk_split_bar(d, p1.rest); p3 := dk_split_bar(d, p2.rest);
    c: DkCell;
    c.kind = kind; c.src = p1.head; c.label = p2.head; c.caption = p3.head; c.asset = -1;
    c.l0 = d[0].line_n; c.l1 = d[0].line_n; c.n0 = d[0].node_n; c.n1 = d[0].node_n; c.e0 = d[0].edge_n; c.e1 = d[0].edge_n;
    if kind == DK_CK_SCENE || kind == DK_CK_IMAGE {
      k := dk_add_asset(d, ifx kind == DK_CK_SCENE then DK_AK_SCENE else DK_AK_IMAGE, p1.head);
      if k == -2 { return dk_fail(d, line, "wait= takes milliseconds"); }
      if k < 0 { return dk_fail(d, line, "a scene is: scene URL [wait=MS] | LABEL | CAPTION"); }
      c.asset = k;
    }
    if kind == DK_CK_STAT && c.src.n == 0 { return dk_fail(d, line, "a stat is: stat VALUE | LABEL | CAPTION"); }
    d[0].cells[d[0].cell_n] = c; d[0].cell_n += 1; d[0].slides[s].count += 1;
  }
  if d[0].slide_n == 0 { return dk_fail(d, line, "a deck has at least one slide"); }
  return true;
}

// ---------------------------------------------------------------- layout

DkBox :: struct { x: f32; y: f32; w: f32; h: f32; }
// The body of a slide with cells, under its header.
DK_BODY :: DkBox.{x = 24, y = 104, w = 912, h = 402};
dk_cell_box :: (sl: DkSlide, k: int) -> DkBox {
  c := k % sl.cols; r := k / sl.cols;
  w := (DK_BODY.w - DK_CELL_GAP * cast(f32) (sl.cols - 1)) / cast(f32) sl.cols;
  h := (DK_BODY.h - DK_CELL_GAP * cast(f32) (sl.rows - 1)) / cast(f32) sl.rows;
  return DkBox.{x = DK_BODY.x + cast(f32) c * (w + DK_CELL_GAP), y = DK_BODY.y + cast(f32) r * (h + DK_CELL_GAP), w = w, h = h};
}
// What a cell's picture fills: under its label bar, inset.
dk_inside :: (b: DkBox) -> DkBox { return DkBox.{x = b.x + 8, y = b.y + DK_HEAD + 4, w = b.w - 16, h = b.h - DK_HEAD - 12}; }

// A scene is taken at its place's shape, about 1000 pixels tall.
dk_viewport :: (w: f32, h: f32) -> ArgsSize {
  a := w / h; vh := 1000.0f32; vw := vh * a;
  if vw > 2200 { vw = 2200; vh = vw / a; }
  return ArgsSize.{w = cast(int) floor(vw + 0.5), h = cast(int) floor(vh + 0.5), ok = true};
}

#test "deck pieces" {
  #assert dk_whole("42") == 42 && dk_whole("") == -1 && dk_whole("4x") == -1;
  b := dk_cell_box(DkSlide.{cols = 3, rows = 2}, 4);
  #assert b.x > 330 && b.x < 340 && b.y > 310;
  v := dk_viewport(1600, 900);
  #assert v.w == 1778 && v.h == 1000;
  v = dk_viewport(4000, 1000);
  #assert v.w == 2200 && v.h == 550;
}

// ---------------------------------------------------------------- PDF bytes

DK_PDF_MAX :: 100663296;   // 96 MiB
DkPdf :: struct { b: [DK_PDF_MAX] u8; n: int; bad: bool; off: [4096] int; }
DkCs :: struct { b: [4194304] u8; n: int; bad: bool; }

dk_put :: (o: [] DkCs, s: string) {
  if o[0].n + s.count > o[0].b.count { o[0].bad = true; return; }
  for k: 0..<s.count { o[0].b[o[0].n + k] = s[k]; }
  o[0].n += s.count;
}
dk_put_int :: (o: [] DkCs, v: int) {
  if v < 0 { dk_put(o, "-"); dk_put_int(o, -v); return; }
  d: [20] u8; n := 0; x := v;
  if x == 0 { d[0] = '0'; n = 1; }
  while x > 0 { d[n] = cast(u8) ('0' + x % 10); x /= 10; n += 1; }
  r: [20] u8; for k: 0..<n { r[k] = d[n - 1 - k]; }
  dk_put(o, cast(string) r[0..<n]);
}
// A number with at most two decimals into out: its length.
dk_num :: (v: f32, out: [] u8) -> int {
  h := cast(int) floor(v * 100 + 0.5); n := 0;
  if h < 0 { out[0] = '-'; n = 1; h = -h; }
  w := h / 100; d: [20] u8; k := 0;
  if w == 0 { d[0] = '0'; k = 1; }
  while w > 0 { d[k] = cast(u8) ('0' + w % 10); w /= 10; k += 1; }
  for j: 0..<k { out[n] = d[k - 1 - j]; n += 1; }
  f := h % 100;
  if f != 0 {
    out[n] = '.'; out[n + 1] = cast(u8) ('0' + f / 10); n += 2;
    if f % 10 != 0 { out[n] = cast(u8) ('0' + f % 10); n += 1; }
  }
  return n;
}
// A number with at most two decimals, then a space.
dk_put_num :: (o: [] DkCs, v: f32) {
  t: [32] u8; n := dk_num(v, t[..]);
  dk_put(o, cast(string) t[0..<n]); dk_put(o, " ");
}
dk_cs_text :: (o: [] DkCs) -> string { return cast(string) o[0].b[0..<o[0].n]; }

#test "numbers in a content stream" {
  t: [32] u8;
  #assert cast(string) t[0..<dk_num(12.5, t[..])] == "12.5" && cast(string) t[0..<dk_num(-0.25, t[..])] == "-0.25";
  #assert cast(string) t[0..<dk_num(3, t[..])] == "3" && cast(string) t[0..<dk_num(0.004, t[..])] == "0" && cast(string) t[0..<dk_num(960.05, t[..])] == "960.05";
}

dk_pb :: (p: [] DkPdf, s: string) {
  if p[0].n + s.count > p[0].b.count { p[0].bad = true; return; }
  for k: 0..<s.count { p[0].b[p[0].n + k] = s[k]; }
  p[0].n += s.count;
}
dk_pint :: (p: [] DkPdf, v: int) {
  if v < 0 { dk_pb(p, "-"); dk_pint(p, -v); return; }
  d: [20] u8; n := 0; x := v;
  if x == 0 { d[0] = '0'; n = 1; }
  while x > 0 { d[n] = cast(u8) ('0' + x % 10); x /= 10; n += 1; }
  r: [20] u8; for k: 0..<n { r[k] = d[n - 1 - k]; }
  dk_pb(p, cast(string) r[0..<n]);
}
// Two digits at least: 3 is 03.
dk_two :: (v: int, out: [] u8, at: int) -> int {
  n := at;
  if v < 10 { out[n] = '0'; n += 1; }
  d: [20] u8; k := 0; x := v;
  if x == 0 { d[0] = '0'; k = 1; }
  while x > 0 { d[k] = cast(u8) ('0' + x % 10); x /= 10; k += 1; }
  for j: 0..<k { out[n] = d[k - 1 - j]; n += 1; }
  return n;
}
dk_pobj :: (p: [] DkPdf, k: int) { p[0].off[k] = p[0].n; dk_pint(p, k); dk_pb(p, " 0 obj\n"); }

// ---------------------------------------------------------------- drawing

DK_Y :: (y: f32) -> f32 { return DK_PAGE_H - y; }   // the deck lays out top down; PDF counts up
dk_fill :: (o: [] DkCs, c: DkRgb) { dk_put_num(o, c.r); dk_put_num(o, c.g); dk_put_num(o, c.b); dk_put(o, "rg\n"); }
dk_stroke :: (o: [] DkCs, c: DkRgb, w: f32) { dk_put_num(o, c.r); dk_put_num(o, c.g); dk_put_num(o, c.b); dk_put(o, "RG "); dk_put_num(o, w); dk_put(o, "w\n"); }
dk_rect :: (o: [] DkCs, b: DkBox, op: string) { dk_put_num(o, b.x); dk_put_num(o, DK_Y(b.y + b.h)); dk_put_num(o, b.w); dk_put_num(o, b.h); dk_put(o, "re "); dk_put(o, op); dk_put(o, "\n"); }
dk_move :: (o: [] DkCs, x: f32, y: f32) { dk_put_num(o, x); dk_put_num(o, DK_Y(y)); dk_put(o, "m "); }
dk_to :: (o: [] DkCs, x: f32, y: f32) { dk_put_num(o, x); dk_put_num(o, DK_Y(y)); dk_put(o, "l "); }
dk_seg :: (o: [] DkCs, ax: f32, ay: f32, bx: f32, by: f32) { dk_move(o, ax, ay); dk_to(o, bx, by); dk_put(o, "S\n"); }

// Filament: each glyph's polylines as strokes, the baseline's left end at x, base.
dk_fil_width :: (text: string, cap: f32) -> f32 { return measure(text, DK_GAP, DK_SPACE, false) * cap; }
dk_fil :: (o: [] DkCs, text: string, x: f32, base: f32, cap: f32, c: DkRgb) {
  dk_stroke(o, c, dk_hi(0.35, cap * 0.075));
  points: [FONT_MAX_POINTS * 2] u8;
  unit := cap / 12; pen := x; i := 0; after := false;
  while i < text.count {
    d := decode(text, i); i += d.len;
    k := font_fold(d.code);
    if k == ' ' { pen += DK_SPACE * cap; after = false; continue; }
    if k < 32 { continue; }
    if after { pen += DK_GAP * cap; }
    n := glyph(k, points[..]); down := false;
    for p: 0..<n {
      if points[p * 2] == FONT_BREAK { down = false; continue; }
      px := pen + cast(f32) points[p * 2] * unit;
      py := base - (cast(f32) points[p * 2 + 1] - 2) * unit;
      if !down { dk_move(o, px, py); down = true; } else { dk_to(o, px, py); }
      // a dot is one point: draw it as a stroke that ends where it starts
      if p + 1 >= n || points[(p + 1) * 2] == FONT_BREAK { dk_to(o, px + 0.01, py); }
    }
    if n > 0 { dk_put(o, "S\n"); }
    pen += glyph_width(k) * cap;
    after = true;
  }
}
// The largest cap up to most at which text fits in width.
dk_fil_fit :: (text: string, most: f32, width: f32) -> f32 {
  w := dk_fil_width(text, most);
  return ifx w <= width || w <= 0 then most else most * width / w;
}

// Helvetica, as the site sets small text (font.coax SANS_WIDTH), in WinAnsi.
dk_ansi :: (code: u32) -> int {
  if code >= 32 && code <= 126 { return cast(int) code; }
  if code == 183 { return 183; } if code == 8211 { return 150; } if code == 8212 { return 151; }
  if code == 8216 { return 145; } if code == 8217 { return 146; } if code == 8220 { return 147; }
  if code == 8221 { return 148; } if code == 8226 { return 149; } if code == 8230 { return 133; }
  if code == 215 { return 215; }
  return '?';
}
dk_h_em :: (code: u32) -> int {
  k := sans_index(code);
  if k < 0 || dk_ansi(code) == '?' { return 556; }
  return cast(int) SANS_WIDTH[k];
}
dk_h_width :: (text: string, size: f32) -> f32 {
  w := 0; i := 0;
  while i < text.count { d := decode(text, i); i += d.len; if d.code >= 32 { w += dk_h_em(d.code); } }
  return cast(f32) w * size / 1000;
}
dk_sans :: (o: [] DkCs, text: string, x: f32, base: f32, size: f32, c: DkRgb) {
  dk_fill(o, c); dk_put(o, "BT /F1 "); dk_put_num(o, size); dk_put(o, "Tf "); dk_put_num(o, x); dk_put_num(o, DK_Y(base)); dk_put(o, "Td (");
  i := 0;
  while i < text.count {
    d := decode(text, i); i += d.len;
    if d.code < 32 { continue; }
    a := dk_ansi(d.code);
    if a == '(' || a == ')' || a == '\\' { e: [2] u8; e[0] = '\\'; e[1] = cast(u8) a; dk_put(o, cast(string) e[..]); }
    else if a < 128 { e: [1] u8; e[0] = cast(u8) a; dk_put(o, cast(string) e[..]); }
    else { e: [4] u8; e[0] = '\\'; e[1] = cast(u8) ('0' + a / 64); e[2] = cast(u8) ('0' + (a / 8) % 8); e[3] = cast(u8) ('0' + a % 8); dk_put(o, cast(string) e[..]); }
  }
  dk_put(o, ") Tj ET\n");
}
// The end of the line of text that starts at from, wrapped to width at spaces;
// next[0] gets where the next line starts.
dk_sans_wrap :: (text: string, from: int, width: f32, size: f32, next: [] int) -> int {
  i := from; last := -1; w := 0.0f32;
  while i < text.count {
    d := decode(text, i);
    if d.code == ' ' { last = i; }
    w += cast(f32) dk_h_em(d.code) * size / 1000;
    if w > width && i > from {
      if last > from { e := last; n := last; while n < text.count && text[n] == ' ' { n += 1; } next[0] = n; return e; }
      next[0] = i; return i;
    }
    i += d.len;
  }
  next[0] = text.count; return text.count;
}
// Wrapped text from x, top; its lines' count (drawn only when draw).
dk_sans_block :: (o: [] DkCs, text: string, x: f32, top: f32, width: f32, size: f32, lead: f32, c: DkRgb, draw: bool) -> int {
  from := 0; lines := 0; next: [1] int;
  while from < text.count {
    e := dk_sans_wrap(text, from, width, size, next[..]);
    if draw { dk_sans(o, text[from..<e], x, top + size * 0.8 + cast(f32) lines * lead, size, c); }
    lines += 1;
    if next[0] <= from { break; }
    from = next[0];
  }
  return ifx lines == 0 then 1 else lines;
}

#test "Helvetica widths and wrapping" {
  #assert dk_h_width("Wi", 10) == (944 + 222) * 10 / 1000.0;
  next: [1] int;
  e := dk_sans_wrap("one two three", 0, dk_h_width("one two", 10) + 0.5, 10, next[..]);
  #assert e == 7 && next[0] == 8;
  #assert dk_ansi(8212) == 151 && dk_ansi('A') == 65 && dk_ansi(20013) == '?';
}

// The ground: near black with the faint iso grid of the homepage.
dk_ground :: (o: [] DkCs) {
  dk_fill(o, DK_BG); dk_rect(o, DkBox.{x = 0, y = 0, w = DK_PAGE_W, h = DK_PAGE_H}, "f");
  dk_stroke(o, DK_GRID_LINE, 0.4);
  slope := 0.5774f32; run := DK_PAGE_H / slope;   // 30 degrees, as the Grid's floor
  k := 0;
  while k < 64 {
    x := -run + cast(f32) k * 48;
    dk_move(o, x, 0); dk_to(o, x + run, DK_PAGE_H); dk_put(o, "S\n");
    dk_move(o, x + run, 0); dk_to(o, x, DK_PAGE_H); dk_put(o, "S\n");
    k += 1;
  }
}
// A panel: a darker plate, a thin edge and the site's corner marks.
dk_panel :: (o: [] DkCs, b: DkBox) {
  dk_fill(o, DK_PANEL); dk_rect(o, b, "f");
  dk_stroke(o, DK_EDGE, 0.6); dk_rect(o, b, "S");
  dk_stroke(o, DK_CORNER, 1.1);
  m := 10.0f32;
  dk_move(o, b.x, b.y + m); dk_to(o, b.x, b.y); dk_to(o, b.x + m, b.y); dk_put(o, "S\n");
  dk_move(o, b.x + b.w - m, b.y + b.h); dk_to(o, b.x + b.w, b.y + b.h); dk_to(o, b.x + b.w, b.y + b.h - m); dk_put(o, "S\n");
}
// "— LABEL" in the accent, the caption on the right, and a rule under.
dk_label_bar :: (o: [] DkCs, b: DkBox, label: string, caption: string) {
  x := b.x + 10;
  if label.count > 0 {
    cap := 5.2f32;
    dk_stroke(o, DK_ACCENT, 0.9); dk_seg(o, x, b.y + 11, x + 5, b.y + 11);
    room := b.w - 34 - ifx caption.count > 0 then dk_h_width(caption, 7) + 10 else 0;
    dk_fil(o, label, x + 9, b.y + 11 + cap / 2, dk_fil_fit(label, cap, room), DK_ACCENT);
  }
  if caption.count > 0 { w := dk_h_width(caption, 7); dk_sans(o, caption, b.x + b.w - 10 - w, b.y + 13.5, 7, DK_DIM); }
  dk_stroke(o, DK_EDGE, 0.5); dk_seg(o, b.x + 8, b.y + DK_HEAD, b.x + b.w - 8, b.y + DK_HEAD);
}
dk_image :: (o: [] DkCs, a: DkAsset, b: DkBox) {
  dk_put(o, "q "); dk_put_num(o, b.w); dk_put(o, "0 0 "); dk_put_num(o, b.h); dk_put_num(o, b.x); dk_put_num(o, DK_Y(b.y + b.h)); dk_put(o, "cm /I");
  dk_put_int(o, a.obj); dk_put(o, " Do Q\n");
}
// An image's place inside b, its shape kept, centred.
dk_contain :: (a: DkAsset, b: DkBox) -> DkBox {
  if a.px <= 0 || a.py <= 0 { return b; }
  r := cast(f32) a.px / cast(f32) a.py;
  if r > b.w / b.h { h := b.w / r; return DkBox.{x = b.x, y = b.y + (b.h - h) / 2, w = b.w, h = h}; }
  w := b.h * r; return DkBox.{x = b.x + (b.w - w) / 2, y = b.y, w = w, h = b.h};
}

// Where the line from a box's centre toward (dx, dy) leaves the box.
dk_leave :: (cx: f32, cy: f32, hw: f32, hh: f32, dx: f32, dy: f32) -> f32 {
  ax := ifx dx < 0 then -dx else dx; ay := ifx dy < 0 then -dy else dy;
  tx := ifx ax > 0.0001 then hw / ax else 1000000.0f32;
  ty := ifx ay > 0.0001 then hh / ay else 1000000.0f32;
  return dk_lo(tx, ty);
}
#test "a line leaves a box at its edge" {
  #assert dk_leave(0, 0, 10, 5, 1, 0) == 10 && dk_leave(0, 0, 10, 5, 0, -1) == 5 && dk_leave(0, 0, 10, 5, 2, 2) == 2.5;
}

dk_diagram :: (o: [] DkCs, d: [] DkDeck, c: DkCell, b: DkBox) {
  cols := 1; rows := 1;
  for k: c.n0..<c.n1 { n := d[0].nodes[k]; if n.col + 1 > cols { cols = n.col + 1; } if n.row + 1 > rows { rows = n.row + 1; } }
  sw := b.w / cast(f32) cols; sh := b.h / cast(f32) rows;
  bw := dk_lo(sw * 0.74, 190); bh := dk_lo(sh * 0.52, 46);
  // edges first, under the boxes
  for k: c.e0..<c.e1 {
    e := d[0].edges[k]; a := -1; z := -1;
    for m: c.n0..<c.n1 { if dk_sp(d, d[0].nodes[m].id) == dk_sp(d, e.a) { a = m; } if dk_sp(d, d[0].nodes[m].id) == dk_sp(d, e.b) { z = m; } }
    if a < 0 || z < 0 { continue; }
    ax := b.x + (cast(f32) d[0].nodes[a].col + 0.5) * sw; ay := b.y + (cast(f32) d[0].nodes[a].row + 0.5) * sh;
    zx := b.x + (cast(f32) d[0].nodes[z].col + 0.5) * sw; zy := b.y + (cast(f32) d[0].nodes[z].row + 0.5) * sh;
    dx := zx - ax; dy := zy - ay; dist := sqrt(dx * dx + dy * dy);
    if dist < 1 { continue; }
    t0 := dk_leave(ax, ay, bw / 2 + 3, bh / 2 + 3, dx, dy); t1 := dk_leave(zx, zy, bw / 2 + 3, bh / 2 + 3, -dx, -dy);
    sx := ax + dx * t0; sy := ay + dy * t0; ex := zx - dx * t1; ey := zy - dy * t1;
    dk_stroke(o, DK_DIM, 0.8); dk_seg(o, sx, sy, ex, ey);
    ux := dx / dist; uy := dy / dist; h := 6.0f32;
    dk_fill(o, DK_ACCENT);
    dk_move(o, ex, ey); dk_to(o, ex - ux * h - uy * h * 0.55, ey - uy * h + ux * h * 0.55);
    dk_to(o, ex - ux * h + uy * h * 0.55, ey - uy * h - ux * h * 0.55); dk_put(o, "f\n");
    if e.text.n > 0 {
      t := dk_sp(d, e.text); w := dk_h_width(t, 7); mx := (sx + ex) / 2; my := (sy + ey) / 2;
      dk_fill(o, DK_PANEL); dk_rect(o, DkBox.{x = mx - w / 2 - 3, y = my - 6, w = w + 6, h = 10}, "f");
      dk_sans(o, t, mx - w / 2, my + 2.5, 7, DK_DIM);
    }
  }
  for k: c.n0..<c.n1 {
    n := d[0].nodes[k];
    cx := b.x + (cast(f32) n.col + 0.5) * sw; cy := b.y + (cast(f32) n.row + 0.5) * sh;
    nb := DkBox.{x = cx - bw / 2, y = cy - bh / 2, w = bw, h = bh};
    dk_fill(o, DK_PANEL); dk_rect(o, nb, "f");
    dk_stroke(o, DkRgb.{r = 0.32, g = 0.5, b = 0.62}, 0.8); dk_rect(o, nb, "S");
    dk_stroke(o, DK_CORNER, 1.0);
    dk_move(o, nb.x, nb.y + 6); dk_to(o, nb.x, nb.y); dk_to(o, nb.x + 6, nb.y); dk_put(o, "S\n");
    t := dk_sp(d, n.text); cap := dk_fil_fit(t, dk_lo(7, bh * 0.2), bw - 14);
    dk_fil(o, t, cx - dk_fil_width(t, cap) / 2, cy + cap / 2, cap, DK_TEXT);
  }
}

dk_text_cell :: (o: [] DkCs, d: [] DkDeck, c: DkCell, b: DkBox) {
  size := 14.0f32;
  // the largest size from 14 down whose lines fit
  while size > 7 {
    need := 0.0f32;
    for k: c.l0..<c.l1 {
      l := d[0].lines[k]; ind := ifx l.bullet then 14.0f32 else 0;
      n := dk_sans_block(o, dk_sp(d, l.text), b.x + ind, 0, b.w - ind, size, size * 1.35, DK_TEXT, false);
      need += cast(f32) n * size * 1.35 + size * 0.55;
    }
    if need <= b.h { break; }
    size -= 0.5;
  }
  top := b.y + 2;
  for k: c.l0..<c.l1 {
    l := d[0].lines[k];
    if l.bullet {
      dk_fill(o, DK_ACCENT); dk_rect(o, DkBox.{x = b.x + 1, y = top + size * 0.3, w = 3.2, h = 3.2}, "f");
      n := dk_sans_block(o, dk_sp(d, l.text), b.x + 14, top, b.w - 14, size, size * 1.35, DK_TEXT, true);
      top += cast(f32) n * size * 1.35 + size * 0.55;
    } else {
      n := dk_sans_block(o, dk_sp(d, l.text), b.x, top, b.w, size, size * 1.35, DK_DIM, true);
      top += cast(f32) n * size * 1.35 + size * 0.55;
    }
  }
}

dk_stat_cell :: (o: [] DkCs, d: [] DkDeck, c: DkCell, b: DkBox) {
  v := dk_sp(d, c.src);
  cap := dk_fil_fit(v, dk_lo(b.h * 0.3, 110), b.w * 0.8);
  w := dk_fil_width(v, cap); x := b.x + (b.w - w) / 2;
  base := b.y + b.h * 0.5 + cap / 2;
  dk_fil(o, v, x, base, cap, DK_TEXT);
  dk_stroke(o, DK_ACCENT, 1.2); dk_seg(o, b.x + b.w / 2 - 15, base + cap * 0.22 + 4, b.x + b.w / 2 + 15, base + cap * 0.22 + 4);
}

// One slide's content stream.
dk_slide :: (o: [] DkCs, d: [] DkDeck, s: int) {
  sl := d[0].slides[s];
  dk_ground(o);
  if sl.back >= 0 {
    a := d[0].assets[sl.back];
    dk_image(o, a, DkBox.{x = 0, y = 0, w = DK_PAGE_W, h = DK_PAGE_H});
    dk_put(o, "q /D gs "); dk_fill(o, DK_BG); dk_rect(o, DkBox.{x = 0, y = 0, w = DK_PAGE_W, h = DK_PAGE_H}, "f"); dk_put(o, "Q\n");
    dk_put(o, "q /D gs "); dk_fill(o, DK_BG); dk_rect(o, DkBox.{x = 0, y = 0, w = DK_PAGE_W * 0.62, h = DK_PAGE_H}, "f"); dk_put(o, "Q\n");
  }
  kicker := dk_sp(d, sl.kicker); title := dk_sp(d, sl.title); subtitle := dk_sp(d, sl.subtitle);
  if sl.count == 0 {
    // a title slide: kicker, a rule, the title large, the subtitle under
    x := 72.0f32;
    dk_kicker_at(o, kicker, x, 214, 6);
    dk_stroke(o, DK_ACCENT, 1.2); dk_seg(o, x, 226, x + 36, 226);
    cap := dk_fil_fit(title, 46, DK_PAGE_W - 2 * x);
    dk_fil(o, title, x, 248 + cap, cap, DK_TEXT);
    if subtitle.count > 0 { n := dk_sans_block(o, subtitle, x, 270 + cap, 560, 15, 21, DK_DIM, true); }
  } else {
    head := DkBox.{x = 24, y = 20, w = 912, h = 72};
    dk_panel(o, head);
    dk_kicker_at(o, kicker, 40, 42, 4.6);
    cap := dk_fil_fit(title, 22, 600);
    dk_fil(o, title, 40, 76, cap, DK_TEXT);
    if subtitle.count > 0 {
      x := 40 + dk_fil_width(title, cap) + 18;
      sc := dk_fil_fit(subtitle, 5.4, 936 - 20 - x);
      dk_fil(o, subtitle, x, 76 - (cap - sc) * 0.1, sc, DK_TEXT);
    }
    for k: 0..<sl.count {
      c := d[0].cells[sl.first + k];
      b := dk_cell_box(sl, k);
      dk_panel(o, b);
      dk_label_bar(o, b, dk_sp(d, c.label), dk_sp(d, c.caption));
      inner := dk_inside(b);
      if c.kind == DK_CK_SCENE { a := d[0].assets[c.asset]; dk_image(o, a, inner); dk_stroke(o, DK_EDGE, 0.5); dk_rect(o, inner, "S"); }
      if c.kind == DK_CK_IMAGE { a := d[0].assets[c.asset]; dk_image(o, a, dk_contain(a, inner)); }
      if c.kind == DK_CK_TEXT { dk_text_cell(o, d, c, DkBox.{x = inner.x + 4, y = inner.y + 4, w = inner.w - 8, h = inner.h - 6}); }
      if c.kind == DK_CK_STAT { dk_stat_cell(o, d, c, inner); }
      if c.kind == DK_CK_DIAGRAM { dk_diagram(o, d, c, inner); }
    }
  }
  // the footer: the deck's name and the page
  name := dk_sp(d, d[0].name);
  if name.count > 0 { dk_fil(o, name, 28, DK_PAGE_H - 13, 4.2, DK_FAINT); }
  pg: [48] u8; pn := dk_two(s + 1, pg[..], 0);
  pg[pn] = ' '; pg[pn + 1] = '/'; pg[pn + 2] = ' '; pn = dk_two(d[0].slide_n, pg[..], pn + 3);
  t := cast(string) pg[0..<pn];
  dk_fil(o, t, DK_PAGE_W - 28 - dk_fil_width(t, 4.2), DK_PAGE_H - 13, 4.2, DK_FAINT);
}
// "OPENAGENTS / VERSE": the last part in the accent, as the site's breadcrumbs.
dk_kicker_at :: (o: [] DkCs, text: string, x: f32, base: f32, cap: f32) {
  if text.count == 0 { return; }
  cut := -1;
  for i: 0..<text.count { if text[i] == '/' { cut = i; } }
  if cut < 0 { dk_fil(o, text, x, base, cap, DK_ACCENT); return; }
  head := text[0..<cut + 1];
  dk_fil(o, head, x, base, cap, DK_DIM);
  w := dk_fil_width(head, cap) + DK_SPACE * cap;
  rest := text[cut + 1..<text.count];
  k := 0; while k < rest.count && rest[k] == ' ' { k += 1; }
  dk_fil(o, rest[k..<rest.count], x + w, base, cap, DK_ACCENT);
}

// ---------------------------------------------------------------- pictures

DK_JPEG_MAX :: 25165824;
DkPic :: struct { b: [DK_JPEG_MAX] u8; n: int; }

// A JPEG's size and colour channels from its frame header; false if it isn't one.
DkJpeg :: struct { w: int; h: int; comps: int; ok: bool; }
dk_jpeg_info :: (b: [] u8) -> DkJpeg {
  out := DkJpeg.{w = 0, h = 0, comps = 0, ok = false};
  if b.count < 4 || b[0] != 0xFF || b[1] != 0xD8 { return out; }
  i := 2;
  while i + 9 < b.count {
    if b[i] != 0xFF { return out; }
    m := cast(int) b[i + 1];
    if m == 0xFF { i += 1; continue; }
    seglen := cast(int) b[i + 2] * 256 + cast(int) b[i + 3];
    if m >= 0xC0 && m <= 0xCF && m != 0xC4 && m != 0xC8 && m != 0xCC {
      out.h = cast(int) b[i + 5] * 256 + cast(int) b[i + 6];
      out.w = cast(int) b[i + 7] * 256 + cast(int) b[i + 8];
      out.comps = cast(int) b[i + 9];
      out.ok = out.w > 0 && out.h > 0 && (out.comps == 1 || out.comps == 3);
      return out;
    }
    if seglen < 2 { return out; }
    i += 2 + seglen;
  }
  return out;
}
#test "a JPEG frame header" {
  b := [16] u8.[0xFF, 0xD8, 0xFF, 0xE0, 0x00, 0x04, 0x00, 0x00, 0xFF, 0xC0, 0x00, 0x0B, 0x08, 0x02, 0x1C, 0x03];
  j := dk_jpeg_info(b[..]);
  #assert !j.ok;   // cut off before its channels
  c := [20] u8.[0xFF, 0xD8, 0xFF, 0xE0, 0x00, 0x04, 0x00, 0x00, 0xFF, 0xC0, 0x00, 0x0B, 0x08, 0x02, 0x1C, 0x07, 0x80, 0x03, 0x01, 0x22];
  j = dk_jpeg_info(c[..]);
  #assert j.ok && j.w == 1920 && j.h == 540 && j.comps == 3;
}
// A PNG's size from its header, or 0 x 0.
dk_png_size :: (b: [] u8) -> ArgsSize {
  if b.count < 24 || b[0] != 0x89 || b[1] != 'P' || b[2] != 'N' || b[3] != 'G' { return ArgsSize.{w = 0, h = 0, ok = false}; }
  w := cast(int) b[16] * 16777216 + cast(int) b[17] * 65536 + cast(int) b[18] * 256 + cast(int) b[19];
  h := cast(int) b[20] * 16777216 + cast(int) b[21] * 65536 + cast(int) b[22] * 256 + cast(int) b[23];
  return ArgsSize.{w = w, h = h, ok = w > 0 && h > 0};
}

dk_fnv :: (h: u64, s: string) -> u64 {
  x := h;
  for c: s { x = mul_wrap(x ^ cast(u64) c, 1099511628211); }
  return x;
}
dk_hex16 :: (v: u64, out: [] u8) -> string {
  digits := "0123456789abcdef";
  for i: 0..<16 { out[i] = digits[cast(int) ((v >> cast(u64) (60 - 4 * i)) & 15)]; }
  return cast(string) out[0..<16];
}
dk_set_path :: (a: [] DkAsset, k: int, p: string) {
  n := 0;
  for c: p { if n < a[k].path.count { a[k].path[n] = c; n += 1; } }
  a[k].path_n = n;
}
dk_asset_path :: (d: [] DkDeck, k: int) -> string { return cast(string) d[0].assets[k].path[0..<d[0].assets[k].path_n]; }

// The full URL of a scene: a path joins the deck's base (openagents.com when there's none).
dk_scene_url :: (d: [] DkDeck, a: DkAsset, out: [] u8) -> string {
  src := dk_sp(d, a.src); n := 0;
  if !(src.count > 4 && src[0..<4] == "http") {
    base := ifx d[0].base.n > 0 then dk_sp(d, d[0].base) else "https://openagents.com";
    for c: base { if n < out.count { out[n] = c; n += 1; } }
    if n > 0 && out[n - 1] == '/' && src.count > 0 && src[0] == '/' { n -= 1; }
  }
  for c: src { if n < out.count { out[n] = c; n += 1; } }
  return cast(string) out[0..<n];
}

DkChrome :: struct { c: [1] Cdp; up: bool; }
dk_chrome :: (ch: [] DkChrome) -> bool {
  if ch[0].up { return true; }
  if !cdp_launch(ch[0].c[..], 1600, 1000, "coax-deck-") { tool_err("deck: "); tool_errln(cdp_error(ch[0].c[..])); return false; }
  ch[0].up = true;
  return true;
}
// Takes url at w x h as a JPEG into out, after wait ms and the script js.
dk_take :: (ch: [] DkChrome, url: string, w: int, h: int, wait: int, js: string, pic: [] DkPic, out: string) -> bool {
  if !dk_chrome(ch) { return false; }
  c := ch[0].c[..];
  params: [8192] u8; o: [1] Jo;
  jo_start(o[..], params[..]);
  jo_obj(o[..]); jo_key(o[..], "width"); jo_int(o[..], w); jo_key(o[..], "height"); jo_int(o[..], h);
  jo_key(o[..], "deviceScaleFactor"); jo_int(o[..], 1); jo_key(o[..], "mobile"); jo_bool(o[..], false); jo_end(o[..]);
  if cdp_call(c, "Emulation.setDeviceMetricsOverride", jo_text(o[..]), CDP_CALL_MS) < 0 { return dk_took(c); }
  jo_start(o[..], params[..]); jo_obj(o[..]); jo_key(o[..], "url"); jo_str(o[..], url); jo_end(o[..]);
  if o[0].bad { tool_errln("deck: a scene's URL is too long"); return false; }
  if cdp_call(c, "Page.navigate", jo_text(o[..]), CDP_CALL_MS) < 0 { return dk_took(c); }
  proc_sleep(wait);
  if js.count > 0 { v := cdp_evaluate(c, js); proc_sleep(500); }
  r := cdp_call(c, "Page.captureScreenshot", "{\"format\":\"jpeg\",\"quality\":90}", CDP_CALL_MS);
  dd := cdp_doc(c); data := jv_get(dd, r, "data");
  if jv_kind(dd, data) != JV_STRING { return dk_took(c); }
  n := b64_decode(jv_raw(dd, data), pic[0].b[..]);
  if n < 0 { tool_errln("deck: a scene's picture doesn't fit"); return false; }
  if !fs_write(out, cast(string) pic[0].b[0..<n]) { tool_err("deck: could not write "); tool_errln(out); return false; }
  return true;
}
dk_took :: (c: [] Cdp) -> bool { tool_err("deck: "); tool_errln(cdp_error(c)); return false; }

// Every scene taken (or kept from before) and every image read, sizes known.
dk_pictures :: (d: [] DkDeck, dir: string, spec_dir: string, fresh: bool, ch: [] DkChrome, pic: [] DkPic) -> bool {
  taken := 0; kept := 0;
  for k: 0..<d[0].asset_n {
    a := d[0].assets[k];
    nb: [1100] u8; ub: [4096] u8; hb: [16] u8;
    if a.kind == DK_AK_SCENE {
      v := dk_viewport(a.w, a.h); d[0].assets[k].vw = v.w; d[0].assets[k].vh = v.h; a.vw = v.w; a.vh = v.h;
      url := dk_scene_url(d, a, ub[..]);
      h := dk_fnv(14695981039346656037, url);
      kb: [64] u8; kn := dk_two(a.vw, kb[..], 0); kb[kn] = 'x'; kn = dk_two(a.vh, kb[..], kn + 1); kb[kn] = ' '; kn = dk_two(a.wait, kb[..], kn + 1);
      h = dk_fnv(h, cast(string) kb[0..<kn]); h = dk_fnv(h, dk_sp(d, a.js));
      name: [32] u8; nn := 0;
      for c: dk_hex16(h, hb[..]) { name[nn] = c; nn += 1; }
      for c: ".jpg" { name[nn] = c; nn += 1; }
      p := fs_join(dir, cast(string) name[0..<nn], nb[..]);
      dk_set_path(d[0].assets[..], k, p);
      if fresh || !fs_exists(p) {
        if d[0].loud { sz: [48] u8; zn := dk_two(a.vw, sz[..], 0); sz[zn] = 'x'; zn = dk_two(a.vh, sz[..], zn + 1); tool_err("  scene "); tool_err(url); tool_err("  "); tool_errln(cast(string) sz[0..<zn]); }
        if !dk_take(ch, url, a.vw, a.vh, a.wait, dk_sp(d, a.js), pic, p) { return false; }
        taken += 1;
      } else { kept += 1; }
    } else {
      src := dk_sp(d, a.src);
      p := ifx src.count > 0 && src[0] == '/' then src else fs_join(spec_dir, src, nb[..]);
      if !fs_exists(p) { tool_err("deck: no image at "); tool_errln(p); return false; }
      dk_set_path(d[0].assets[..], k, p);
      if p.count > 4 && (p[p.count - 4..<p.count] == ".png" || p[p.count - 4..<p.count] == ".PNG") {
        n := fs_read(p, pic[0].b[..]);
        s := dk_png_size(pic[0].b[0..<dk_imax(0, n)]);
        if !s.ok { tool_err("deck: not a PNG: "); tool_errln(p); return false; }
        h := dk_fnv(dk_fnv(14695981039346656037, p), cast(string) pic[0].b[0..<dk_imin(n, 4096)]);
        name: [32] u8; nn := 0;
        for c: dk_hex16(h, hb[..]) { name[nn] = c; nn += 1; }
        for c: ".jpg" { name[nn] = c; nn += 1; }
        q := fs_join(dir, cast(string) name[0..<nn], nb[..]);
        if fresh || !fs_exists(q) {
          // a PNG becomes a JPEG the way a scene does: Chrome shows it at its size
          url: [1200] u8; un := 0;
          for c: "file://" { url[un] = c; un += 1; }
          for c: p { if un < url.count { url[un] = c; un += 1; } }
          w := s.w; hh := s.h;
          if w > 3000 { hh = hh * 3000 / w; w = 3000; }
          if d[0].loud { tool_err("  image "); tool_err(p); tool_errln(" (from PNG)"); }
          if !dk_take(ch, cast(string) url[0..<un], w, hh, 800, "document.body.style.margin='0';document.querySelector('img').style.cssText='width:100vw;height:100vh;display:block';1", pic, q) { return false; }
          taken += 1;
        } else { kept += 1; }
        dk_set_path(d[0].assets[..], k, q);
      }
    }
    n := fs_read(dk_asset_path(d, k), pic[0].b[..]);
    j := dk_jpeg_info(pic[0].b[0..<dk_imax(0, n)]);
    if n <= 0 || !j.ok { tool_err("deck: not a JPEG or PNG: "); tool_errln(dk_asset_path(d, k)); return false; }
    d[0].assets[k].px = j.w; d[0].assets[k].py = j.h; d[0].assets[k].comps = j.comps;
  }
  d[0].taken = taken; d[0].kept = kept;
  return true;
}

// ---------------------------------------------------------------- the file

dk_write_pdf :: (d: [] DkDeck, out: string, pic: [] DkPic, p: [] DkPdf, o: [] DkCs) -> bool {
  p[0].n = 0; p[0].bad = false;
  dk_pb(p, "%PDF-1.4\n"); hb := [6] u8.[0x25, 0xE2, 0xE3, 0xCF, 0xD3, 0x0A]; dk_pb(p, cast(string) hb[..]);
  // 1 catalog, 2 pages, 3 Helvetica, 4 the dimming state; then images, then a page and its stream per slide
  next := 5;
  for k: 0..<d[0].asset_n {
    same := -1;
    for m: 0..<k { if dk_asset_path(d, m) == dk_asset_path(d, k) { same = m; } }
    if same >= 0 { d[0].assets[k].obj = d[0].assets[same].obj; continue; }
    d[0].assets[k].obj = next; next += 1;
  }
  first_page := next;
  dk_pobj(p, 1); dk_pb(p, "<< /Type /Catalog /Pages 2 0 R >>\nendobj\n");
  dk_pobj(p, 2); dk_pb(p, "<< /Type /Pages /Count "); dk_pint(p, d[0].slide_n); dk_pb(p, " /Kids [");
  for s: 0..<d[0].slide_n { dk_pint(p, first_page + 2 * s); dk_pb(p, " 0 R "); }
  dk_pb(p, "] >>\nendobj\n");
  dk_pobj(p, 3); dk_pb(p, "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>\nendobj\n");
  dk_pobj(p, 4); dk_pb(p, "<< /Type /ExtGState /ca 0.62 /CA 0.62 >>\nendobj\n");
  for k: 0..<d[0].asset_n {
    a := d[0].assets[k];
    if a.obj < 5 || p[0].off[a.obj] > 0 { continue; }
    n := fs_read(dk_asset_path(d, k), pic[0].b[..]);
    if n <= 0 { tool_err("deck: could not read "); tool_errln(dk_asset_path(d, k)); return false; }
    dk_pobj(p, a.obj);
    dk_pb(p, "<< /Type /XObject /Subtype /Image /Width "); dk_pint(p, a.px); dk_pb(p, " /Height "); dk_pint(p, a.py);
    dk_pb(p, ifx a.comps == 1 then " /ColorSpace /DeviceGray" else " /ColorSpace /DeviceRGB");
    dk_pb(p, " /BitsPerComponent 8 /Filter /DCTDecode /Length "); dk_pint(p, n); dk_pb(p, " >>\nstream\n");
    dk_pb(p, cast(string) pic[0].b[0..<n]); dk_pb(p, "\nendstream\nendobj\n");
  }
  for s: 0..<d[0].slide_n {
    o[0].n = 0; o[0].bad = false;
    dk_put(o, "1 J 1 j\n");
    dk_slide(o, d, s);
    if o[0].bad { tool_errln("deck: a slide's drawing is too large"); return false; }
    pg := first_page + 2 * s;
    dk_pobj(p, pg);
    dk_pb(p, "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 960 540] /Resources << /Font << /F1 3 0 R >> /ExtGState << /D 4 0 R >> /XObject <<");
    for k: 0..<d[0].asset_n {
      a := d[0].assets[k]; used := false;
      if d[0].slides[s].back == k { used = true; }
      for c: 0..<d[0].slides[s].count { if d[0].cells[d[0].slides[s].first + c].asset == k { used = true; } }
      if used { dk_pb(p, " /I"); dk_pint(p, a.obj); dk_pb(p, " "); dk_pint(p, a.obj); dk_pb(p, " 0 R"); }
    }
    dk_pb(p, " >> >> /Contents "); dk_pint(p, pg + 1); dk_pb(p, " 0 R >>\nendobj\n");
    dk_pobj(p, pg + 1); dk_pb(p, "<< /Length "); dk_pint(p, o[0].n); dk_pb(p, " >>\nstream\n"); dk_pb(p, dk_cs_text(o)); dk_pb(p, "\nendstream\nendobj\n");
  }
  total := first_page + 2 * d[0].slide_n;
  x := p[0].n;
  dk_pb(p, "xref\n0 "); dk_pint(p, total); dk_pb(p, "\n0000000000 65535 f \n");
  for k: 1..<total {
    v := p[0].off[k]; t: [10] u8;
    for i: 0..<10 { t[9 - i] = cast(u8) ('0' + v % 10); v /= 10; }
    dk_pb(p, cast(string) t[..]); dk_pb(p, " 00000 n \n");
  }
  dk_pb(p, "trailer\n<< /Size "); dk_pint(p, total); dk_pb(p, " /Root 1 0 R >>\nstartxref\n"); dk_pint(p, x); dk_pb(p, "\n%%EOF\n");
  if p[0].bad { tool_errln("deck: the PDF is larger than 96 MiB"); return false; }
  if !fs_write(out, cast(string) p[0].b[0..<p[0].n]) { tool_err("deck: could not write "); tool_errln(out); return false; }
  return true;
}

// Each picture's place, in points: what dk_pictures takes it at.
dk_place :: (d: [] DkDeck) {
  for s: 0..<d[0].slide_n {
    sl := d[0].slides[s];
    if sl.back >= 0 { d[0].assets[sl.back].w = DK_PAGE_W; d[0].assets[sl.back].h = DK_PAGE_H; }
    for k: 0..<sl.count {
      c := d[0].cells[sl.first + k];
      if c.asset >= 0 { b := dk_inside(dk_cell_box(sl, k)); d[0].assets[c.asset].w = b.w; d[0].assets[c.asset].h = b.h; }
    }
  }
}
// The captures folder: DECK.captures beside the deck file.
dk_captures :: (spec: string, out: [] u8) -> string {
  dn := 0;
  stem := ifx spec.count > 5 && spec[spec.count - 5..<spec.count] == ".deck" then spec[0..<spec.count - 5] else spec;
  for c: stem { if dn < out.count { out[dn] = c; dn += 1; } }
  for c: ".captures" { if dn < out.count { out[dn] = c; dn += 1; } }
  return cast(string) out[0..<dn];
}
