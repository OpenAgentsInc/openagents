// A seat's bodies on the wire, one codec (compliance plan step E11, GitHub #13250;
// proto/openagents/verse/seat/v1alpha1/seat.proto, profile api-routes): what coax/web/api/seats.c
// reads and answers, and what it sends the runner that holds a hosted seat's page.
//   POST /api/playtest/seats             seatw_open_body -> a Grant (seatw_read_grant)
//   GET  /api/playtest/seats             SeatsReply (seatw_read_seats)
//   POST /api/playtest/seats/<id>/keep   {"kept":true}
//   POST /api/playtest/seats/<id>/close  {"closed":true}
//   the API to the runner                /seat/open  {"seat":GRANT,"origin":"..."}
//                                        /seat/act   {"id": 7, "action": {...}}
//                                        /seat/close {"id":7}
//   the runner to a seat's own process   its first line, {"origin":"...","slug":"...","player":{...}}
// The server builds a Grant and a SeatsReply in SQL and answers jsonb's text: keys by length, then
// by bytes, with ", " and ": " between items. The writers here give those bytes; what seats.c
// writes itself is compact. proto/verse/realm-seat-v1alpha1.json holds the bytes, checked through
// this file by coax/web/api/seat-wire-goldens.coax and on a running API and a running runner by
// coax/web/api/test_room.py. seats.c calls the writers through coax/web/api/seat-wire.coax, and the
// runner (coax/web/agent/seat-runner.c) the readers through coax/web/agent/seat-runner-wire.coax. A
// writer returns the body's length, or -1 when it does not fit or a value is not one it writes;
// a reader refuses a body whole when a member is missing or of another kind.
//   coax/bin/coax test coax/lib/media/realm_seat_wire.coax --library
#load "../json/json.coax";

SEATW_SLUG :: 48;      // a made realm's slug, ^[a-z0-9-]{1,48}$ (seats.c)
SEATW_PID :: 64;       // a player's id
SEATW_KEY :: 200;      // a player's key (the server's are 20 to 128 bytes)
SEATW_ORIGIN :: 256;   // the site a hosted seat's page loads from
SEATW_MOST :: 9007199254740991;   // an id or a time in milliseconds, at most

seatw_slug_ok :: (s: string) -> bool {
  if s.count < 1 || s.count > SEATW_SLUG { return false; }
  for c: s { if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') { return false; } }
  return true;
}
seatw_digits :: (s: string) -> bool {
  if s.count < 1 || s.count > 20 { return false; }
  for c: s { if c < '0' || c > '9' { return false; } }
  return true;
}
seatw_len :: (o: [] Jo) -> int { return ifx o[0].bad then -1 else o[0].n; }
// A whole number member from 0 to SEATW_MOST, or -1.
seatw_whole :: (j: Jv, at: int, key: string) -> int {
  v := jv_int(j, jv_get(j, at, key), -1);
  return ifx v < 0 || v > SEATW_MOST then -1 else v;
}
// A true or false member: 1 or 0, or -1 for anything else.
seatw_flag :: (j: Jv, at: int, key: string) -> int {
  k := jv_kind(j, jv_get(j, at, key));
  return ifx k == JV_TRUE then 1 else ifx k == JV_FALSE then 0 else -1;
}

// ---- POST /api/playtest/seats: the request

// {"slug":"village-green"}, or for a seat the runner holds {"slug":"village-green","hosted":true}.
seatw_open_body :: (slug: string, hosted: bool, out: [] u8) -> int {
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], "{\"slug\":"); jo_quoted(o[..], slug);
  jo_put(o[..], ifx hosted then ",\"hosted\":true}" else "}");
  return seatw_len(o[..]);
}
// What an open body asks: ok false when it is no object or its slug is not a made realm's address;
// hosted only when it is exactly true (anything else is a seat the caller holds, as the server reads it).
SeatwOpen :: struct { ok: bool; hosted: bool; slug: [SEATW_SLUG] u8; slug_n: int; }
seatw_open_slug :: (r: [] SeatwOpen) -> string { return cast(string) r[0].slug[0..<r[0].slug_n]; }
seatw_read_open :: (body: string, r: [] SeatwOpen) -> bool {
  r[0] = SeatwOpen.{};
  nodes: [64] JvNode; d: [1] Jv;
  if !jv_parse(d[..], body, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return false; }
  n := jv_str(d[0], jv_get(d[0], 0, "slug"), r[0].slug[..]);
  if n < 0 || !seatw_slug_ok(cast(string) r[0].slug[0..<n]) { return false; }
  r[0].slug_n = n; r[0].hosted = seatw_flag(d[0], 0, "hosted") == 1; r[0].ok = true;
  return true;
}

// ---- the grant

// key_n 0: no key (a hosted seat's stays with the runner).
SeatwGrant :: struct {
  id: int; until: int; hosted: bool;
  slug: [SEATW_SLUG] u8; slug_n: int; pid: [SEATW_PID] u8; pid_n: int; key: [SEATW_KEY] u8; key_n: int;
}
seatw_grant_slug :: (g: [] SeatwGrant) -> string { return cast(string) g[0].slug[0..<g[0].slug_n]; }
seatw_grant_pid :: (g: [] SeatwGrant) -> string { return cast(string) g[0].pid[0..<g[0].pid_n]; }
seatw_grant_key :: (g: [] SeatwGrant) -> string { return cast(string) g[0].key[0..<g[0].key_n]; }
// A grant from its values: false when one does not fit or is not a grant's.
seatw_grant_of :: (g: [] SeatwGrant, id: int, slug: string, until: int, hosted: bool, pid: string, key: string) -> bool {
  g[0] = SeatwGrant.{};
  if id < 1 || id > SEATW_MOST || until < 0 || until > SEATW_MOST || !seatw_slug_ok(slug) { return false; }
  if pid.count < 1 || pid.count > SEATW_PID || key.count > SEATW_KEY { return false; }
  for i: 0..<slug.count { g[0].slug[i] = slug[i]; } g[0].slug_n = slug.count;
  for i: 0..<pid.count { g[0].pid[i] = pid[i]; } g[0].pid_n = pid.count;
  for i: 0..<key.count { g[0].key[i] = key[i]; } g[0].key_n = key.count;
  g[0].id = id; g[0].until = until; g[0].hosted = hosted;
  return true;
}
// {"id": 7, "slug": "g", "until": 9, "hosted": false, "player": {"id": "p-1a", "key": "K"}}; with
// no key the player is {"id": "p-1a"}.
seatw_grant_json :: (g: [] SeatwGrant, out: [] u8) -> int {
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], "{\"id\": "); jo_int(o[..], g[0].id);
  jo_put(o[..], ", \"slug\": "); jo_quoted(o[..], seatw_grant_slug(g));
  jo_put(o[..], ", \"until\": "); jo_int(o[..], g[0].until);
  jo_put(o[..], ifx g[0].hosted then ", \"hosted\": true" else ", \"hosted\": false");
  jo_put(o[..], ", \"player\": {\"id\": "); jo_quoted(o[..], seatw_grant_pid(g));
  if g[0].key_n > 0 { jo_put(o[..], ", \"key\": "); jo_quoted(o[..], seatw_grant_key(g)); }
  jo_put(o[..], "}}");
  return seatw_len(o[..]);
}
// {}: what a hosted seat's caller is answered when its grant could not be shown without its key.
seatw_grant_none :: (out: [] u8) -> int { o: [1] Jo; jo_start(o[..], out); jo_put(o[..], "{}"); return seatw_len(o[..]); }
// The grant in the object at `at`.
seatw_grant_at :: (j: Jv, at: int, g: [] SeatwGrant) -> bool {
  g[0] = SeatwGrant.{};
  if jv_kind(j, at) != JV_OBJECT { return false; }
  p := jv_get(j, at, "player");
  id := seatw_whole(j, at, "id"); until := seatw_whole(j, at, "until"); hosted := seatw_flag(j, at, "hosted");
  sn := jv_str(j, jv_get(j, at, "slug"), g[0].slug[..]);
  pn := jv_str(j, jv_get(j, p, "id"), g[0].pid[..]);
  kn := 0;
  if jv_get(j, p, "key") >= 0 { kn = jv_str(j, jv_get(j, p, "key"), g[0].key[..]); }
  if jv_kind(j, p) != JV_OBJECT || id < 1 || until < 0 || hosted < 0 || sn < 0 || pn < 1 || kn < 0 { g[0] = SeatwGrant.{}; return false; }
  if !seatw_slug_ok(cast(string) g[0].slug[0..<sn]) { g[0] = SeatwGrant.{}; return false; }
  g[0].id = id; g[0].until = until; g[0].hosted = hosted == 1; g[0].slug_n = sn; g[0].pid_n = pn; g[0].key_n = kn;
  return true;
}
seatw_read_grant :: (body: string, g: [] SeatwGrant) -> bool {
  g[0] = SeatwGrant.{};
  nodes: [64] JvNode; d: [1] Jv;
  if !jv_parse(d[..], body, nodes[..]) { return false; }
  return seatw_grant_at(d[0], 0, g);
}

// ---- GET /api/playtest/seats

SeatwSeat :: struct { id: int; hosted: bool; kept_ms: int; opened_ms: int; slug: [SEATW_SLUG] u8; slug_n: int; }
seatw_seat_slug :: (s: [] SeatwSeat) -> string { return cast(string) s[0].slug[0..<s[0].slug_n]; }
seatw_seat_of :: (id: int, slug: string, hosted: bool, kept_ms: int, opened_ms: int) -> SeatwSeat {
  s: SeatwSeat;
  if !seatw_slug_ok(slug) { return s; }
  for i: 0..<slug.count { s.slug[i] = slug[i]; } s.slug_n = slug.count;
  s.id = id; s.hosted = hosted; s.kept_ms = kept_ms; s.opened_ms = opened_ms;
  return s;
}
// {"seats": [{"id": 7, "slug": "g", "hosted": false, "kept_ms": 2, "opened_ms": 1}]}; none is {"seats": []}.
seatw_seats_json :: (rows: [] SeatwSeat, out: [] u8) -> int {
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], "{\"seats\": [");
  for i: 0..<rows.count {
    s := rows[i..<i + 1];
    if i > 0 { jo_put(o[..], ", "); }
    jo_put(o[..], "{\"id\": "); jo_int(o[..], s[0].id);
    jo_put(o[..], ", \"slug\": "); jo_quoted(o[..], seatw_seat_slug(s));
    jo_put(o[..], ifx s[0].hosted then ", \"hosted\": true" else ", \"hosted\": false");
    jo_put(o[..], ", \"kept_ms\": "); jo_int(o[..], s[0].kept_ms);
    jo_put(o[..], ", \"opened_ms\": "); jo_int(o[..], s[0].opened_ms);
    jo_put(o[..], "}");
  }
  jo_put(o[..], "]}");
  return seatw_len(o[..]);
}
// The seats of a SeatsReply into rows: how many, or -1 when the body isn't one or they don't fit.
seatw_read_seats :: (body: string, rows: [] SeatwSeat) -> int {
  nodes: [512] JvNode; d: [1] Jv;
  if !jv_parse(d[..], body, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return -1; }
  j := d[0];
  list := jv_get(j, 0, "seats");
  if jv_kind(j, list) != JV_ARRAY || jv_len(j, list) > rows.count { return -1; }
  for i: 0..<jv_len(j, list) {
    e := jv_at(j, list, i);
    s: [1] SeatwSeat;
    s[0].id = seatw_whole(j, e, "id"); s[0].kept_ms = seatw_whole(j, e, "kept_ms"); s[0].opened_ms = seatw_whole(j, e, "opened_ms");
    hosted := seatw_flag(j, e, "hosted");
    s[0].slug_n = jv_str(j, jv_get(j, e, "slug"), s[0].slug[..]);
    if jv_kind(j, e) != JV_OBJECT || s[0].id < 1 || s[0].kept_ms < 0 || s[0].opened_ms < 0 || hosted < 0 || s[0].slug_n < 0 { return -1; }
    if !seatw_slug_ok(seatw_seat_slug(s[..])) { return -1; }
    s[0].hosted = hosted == 1;
    rows[i] = s[0];
  }
  return jv_len(j, list);
}

// ---- keep and close

// {"kept":true}
seatw_kept :: (out: [] u8) -> int { o: [1] Jo; jo_start(o[..], out); jo_put(o[..], "{\"kept\":true}"); return seatw_len(o[..]); }
// {"closed":true}
seatw_closed :: (out: [] u8) -> int { o: [1] Jo; jo_start(o[..], out); jo_put(o[..], "{\"closed\":true}"); return seatw_len(o[..]); }
// Whether a body is an object whose member `key` is true.
seatw_read_done :: (body: string, key: string) -> bool {
  nodes: [16] JvNode; d: [1] Jv;
  return jv_parse(d[..], body, nodes[..]) && jv_kind(d[0], 0) == JV_OBJECT && seatw_flag(d[0], 0, key) == 1;
}
seatw_read_kept :: (body: string) -> bool { return seatw_read_done(body, "kept"); }
seatw_read_closed :: (body: string) -> bool { return seatw_read_done(body, "closed"); }

// ---- the API to the runner

// {"seat":GRANT,"origin":"https://openagents.com"}: seat is the grant as SQL wrote it (an object,
// carried as it came), origin the site the seat's page loads from.
seatw_runner_open :: (seat: string, origin: string, out: [] u8) -> int {
  if seat.count < 2 || seat[0] != '{' || seat[seat.count - 1] != '}' { return -1; }
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], "{\"seat\":"); jo_put(o[..], seat);
  jo_put(o[..], ",\"origin\":"); jo_quoted(o[..], origin); jo_put(o[..], "}");
  return seatw_len(o[..]);
}
// A runner's open body read: the grant into g and the origin into origin; the origin's length, or
// -1 when the body isn't one.
seatw_read_runner_open :: (body: string, g: [] SeatwGrant, origin: [] u8) -> int {
  g[0] = SeatwGrant.{};
  nodes: [64] JvNode; d: [1] Jv;
  if !jv_parse(d[..], body, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return -1; }
  n := jv_str(d[0], jv_get(d[0], 0, "origin"), origin);
  if n < 1 || !seatw_grant_at(d[0], jv_get(d[0], 0, "seat"), g) { g[0] = SeatwGrant.{}; return -1; }
  return n;
}
// {"id":7}: id is the seat's id in digits, as the route's path carried it.
seatw_runner_close :: (id: string, out: [] u8) -> int {
  if !seatw_digits(id) { return -1; }
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], "{\"id\":"); jo_put(o[..], id); jo_put(o[..], "}");
  return seatw_len(o[..]);
}
// The seat's id in a {"id":7} body, or -1.
seatw_read_id :: (body: string) -> int {
  nodes: [16] JvNode; d: [1] Jv;
  if !jv_parse(d[..], body, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return -1; }
  id := seatw_whole(d[0], 0, "id");
  return ifx id < 1 then -1 else id;
}

// {"id": 7, "action": {"op": "look", "turn": 90}}: the seat's id and one action, as SQL writes
// them (jsonb's text); the action is an object carried as it came.
seatw_runner_act :: (id: int, action: string, out: [] u8) -> int {
  if id < 1 || id > SEATW_MOST || action.count < 2 || action[0] != '{' || action[action.count - 1] != '}' { return -1; }
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], "{\"id\": "); jo_int(o[..], id); jo_put(o[..], ", \"action\": "); jo_put(o[..], action); jo_put(o[..], "}");
  return seatw_len(o[..]);
}
// The action of a runner's act body into out, as it came: its length, or -1 when the body is no
// object, its action is not one, or it does not fit.
seatw_read_runner_action :: (body: string, out: [] u8) -> int {
  nodes: [4096] JvNode; d: [1] Jv;
  if !jv_parse(d[..], body, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return -1; }
  a := jv_get(d[0], 0, "action");
  if jv_kind(d[0], a) != JV_OBJECT { return -1; }
  raw := jv_raw(d[0], a);
  if raw.count > out.count { return -1; }
  for i: 0..<raw.count { out[i] = raw[i]; }
  return raw.count;
}

// ---- the runner to a seat's own process (oa-seat, coax/web/agent/seat.coax)

// The first line on its stdin: {"origin":"https://openagents.com","slug":"g","player":{"id": "p-1", "key": "K"}}
// (the player as the grant spelled it). -1 for a grant with no key: there is no seat to start.
seatw_start_line :: (g: [] SeatwGrant, origin: string, out: [] u8) -> int {
  if g[0].key_n == 0 || g[0].pid_n == 0 || g[0].slug_n == 0 || origin.count == 0 { return -1; }
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], "{\"origin\":"); jo_quoted(o[..], origin);
  jo_put(o[..], ",\"slug\":"); jo_quoted(o[..], seatw_grant_slug(g));
  jo_put(o[..], ",\"player\":{\"id\": "); jo_quoted(o[..], seatw_grant_pid(g));
  jo_put(o[..], ", \"key\": "); jo_quoted(o[..], seatw_grant_key(g)); jo_put(o[..], "}}");
  return seatw_len(o[..]);
}
// A first line read. phone: a phone-sized page, only when it is exactly true (the runner never
// says so; a seat started by hand may).
SeatwStart :: struct {
  phone: bool; origin: [SEATW_ORIGIN] u8; origin_n: int; slug: [64] u8; slug_n: int;
  pid: [SEATW_PID] u8; pid_n: int; key: [SEATW_KEY] u8; key_n: int;
}
seatw_start_origin :: (s: [] SeatwStart) -> string { return cast(string) s[0].origin[0..<s[0].origin_n]; }
seatw_start_slug :: (s: [] SeatwStart) -> string { return cast(string) s[0].slug[0..<s[0].slug_n]; }
seatw_start_pid :: (s: [] SeatwStart) -> string { return cast(string) s[0].pid[0..<s[0].pid_n]; }
seatw_start_key :: (s: [] SeatwStart) -> string { return cast(string) s[0].key[0..<s[0].key_n]; }
// False when the line is no object or its origin, slug or the player's id or key is missing, empty
// or too long.
seatw_read_start :: (line: string, s: [] SeatwStart) -> bool {
  s[0] = SeatwStart.{};
  nodes: [64] JvNode; d: [1] Jv;
  if !jv_parse(d[..], line, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return false; }
  p := jv_get(d[0], 0, "player");
  on := jv_str(d[0], jv_get(d[0], 0, "origin"), s[0].origin[..]);
  sn := jv_str(d[0], jv_get(d[0], 0, "slug"), s[0].slug[..]);
  pn := jv_str(d[0], jv_get(d[0], p, "id"), s[0].pid[..]);
  kn := jv_str(d[0], jv_get(d[0], p, "key"), s[0].key[..]);
  if on < 1 || sn < 1 || pn < 1 || kn < 1 { s[0] = SeatwStart.{}; return false; }
  s[0].origin_n = on; s[0].slug_n = sn; s[0].pid_n = pn; s[0].key_n = kn;
  s[0].phone = seatw_flag(d[0], 0, "phone") == 1;
  return true;
}

// ---- what a seat answers

// Whether a line a seat answered is an object whose `ok` is true (the runner's check before it
// passes the line on; the whole observation is seatw_read_obs's, below).
seatw_answer_ok :: (line: string) -> bool {
  nodes: [1024] JvNode; d: [1] Jv;
  return jv_parse(d[..], line, nodes[..]) && jv_kind(d[0], 0) == JV_OBJECT && seatw_flag(d[0], 0, "ok") == 1;
}

// ---- one action: what POST /api/playtest/seats/<id>/act carries, and a line to a seat's own process

SEATW_OP :: 16; SEATW_NUM :: 24; SEATW_TO :: 64; SEATW_WORDS :: 1600; SEATW_TOOL :: 16;
SEATW_OUT :: 256; SEATW_SHOT :: 1100; SEATW_TOKEN :: 64;

// A decimal number's text ("-4.5", "12"; "3e1" is refused): its value, ok false when it isn't one.
SeatwDec :: struct { v: f32; ok: bool; }
seatw_dec_of :: (s: string) -> SeatwDec {
  if s.count == 0 || s.count > SEATW_NUM { return SeatwDec.{}; }
  i := 0; neg := false;
  if s[0] == '-' { neg = true; i = 1; }
  if i >= s.count { return SeatwDec.{}; }
  v: f32 = 0; digits := 0;
  while i < s.count && s[i] >= '0' && s[i] <= '9' { v = v * 10 + cast(f32) (s[i] - '0'); i += 1; digits += 1; }
  if i < s.count && s[i] == '.' {
    i += 1; k: f32 = 0.1;
    while i < s.count && s[i] >= '0' && s[i] <= '9' { v += k * cast(f32) (s[i] - '0'); k /= 10; i += 1; digits += 1; }
  }
  if i != s.count || digits == 0 { return SeatwDec.{}; }
  return SeatwDec.{v = ifx neg then -v else v, ok = true};
}
// s into dst: its length, or -1 when it does not fit.
seatw_set :: (dst: [] u8, s: string) -> int {
  if s.count > dst.count { return -1; }
  for i: 0..<s.count { dst[i] = s[i]; }
  return s.count;
}
// One action. A member with length 0 is left out. The numbers (turn and pitch in degrees, x and z in
// metres, max in seconds) are kept as their JSON text, so what was typed is what is sent. token is a
// local seat's (`openagents realm play` to its holder); .../act's body has none.
//   see            {"op":"see"}
//   look           {"op":"look","turn":-90,"pitch":20}                    either or both
//   go             {"op":"go","to":"Old Mott","max":20} or {"op":"go","x":4.5,"z":-2}
//   say            {"op":"say","words":"..."}
//   use, jump      {"op":"use","tool":"build","thing":"barrel"}           tool: jump, map or build
//   bye            {"op":"bye"}
//   shot           {"op":"shot","out":"/abs/file.png"}
// Any action but shot may carry "shot":"/abs/file.png", a picture of the view after it.
SeatwAction :: struct {
  op: [SEATW_OP] u8; op_n: int;
  token: [SEATW_TOKEN] u8; token_n: int;
  turn: [SEATW_NUM] u8; turn_n: int; pitch: [SEATW_NUM] u8; pitch_n: int;
  x: [SEATW_NUM] u8; x_n: int; z: [SEATW_NUM] u8; z_n: int; max: [SEATW_NUM] u8; max_n: int;
  to: [SEATW_TO] u8; to_n: int; words: [SEATW_WORDS] u8; words_n: int;
  tool: [SEATW_TOOL] u8; tool_n: int; thing: [SEATW_TOOL] u8; thing_n: int;
  out: [SEATW_OUT] u8; out_n: int; shot: [SEATW_SHOT] u8; shot_n: int;
}
seatw_action_op :: (a: [] SeatwAction) -> string { return cast(string) a[0].op[0..<a[0].op_n]; }
seatw_action_turn :: (a: [] SeatwAction) -> SeatwDec { return seatw_dec_of(cast(string) a[0].turn[0..<a[0].turn_n]); }
seatw_action_pitch :: (a: [] SeatwAction) -> SeatwDec { return seatw_dec_of(cast(string) a[0].pitch[0..<a[0].pitch_n]); }
seatw_action_x :: (a: [] SeatwAction) -> SeatwDec { return seatw_dec_of(cast(string) a[0].x[0..<a[0].x_n]); }
seatw_action_z :: (a: [] SeatwAction) -> SeatwDec { return seatw_dec_of(cast(string) a[0].z[0..<a[0].z_n]); }
seatw_action_max :: (a: [] SeatwAction) -> SeatwDec { return seatw_dec_of(cast(string) a[0].max[0..<a[0].max_n]); }
seatw_action_to :: (a: [] SeatwAction) -> string { return cast(string) a[0].to[0..<a[0].to_n]; }
seatw_action_words :: (a: [] SeatwAction) -> string { return cast(string) a[0].words[0..<a[0].words_n]; }
seatw_action_tool :: (a: [] SeatwAction) -> string { return cast(string) a[0].tool[0..<a[0].tool_n]; }
seatw_action_thing :: (a: [] SeatwAction) -> string { return cast(string) a[0].thing[0..<a[0].thing_n]; }
seatw_action_out :: (a: [] SeatwAction) -> string { return cast(string) a[0].out[0..<a[0].out_n]; }
seatw_action_shot :: (a: [] SeatwAction) -> string { return cast(string) a[0].shot[0..<a[0].shot_n]; }
seatw_action_num :: (o: [] Jo, key: string, text: string) -> bool {
  if text.count == 0 { return true; }
  if !seatw_dec_of(text).ok { return false; }
  jo_put(o, ",\""); jo_put(o, key); jo_put(o, "\":"); jo_put(o, text);
  return true;
}
seatw_action_str :: (o: [] Jo, key: string, text: string) {
  if text.count == 0 { return; }
  jo_put(o, ",\""); jo_put(o, key); jo_put(o, "\":"); jo_quoted(o, text);
}
// The action's bytes: -1 when it has no op, a member did not fit when it was set (length -1), a
// number is not a decimal, or it does not fit out.
seatw_action_json :: (a: [] SeatwAction, out: [] u8) -> int {
  v := a[0];
  if v.op_n < 1 || v.token_n < 0 || v.turn_n < 0 || v.pitch_n < 0 || v.x_n < 0 || v.z_n < 0 || v.max_n < 0 || v.to_n < 0
     || v.words_n < 0 || v.tool_n < 0 || v.thing_n < 0 || v.out_n < 0 || v.shot_n < 0 { return -1; }
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], "{");
  if v.token_n > 0 { jo_put(o[..], "\"token\":"); jo_quoted(o[..], cast(string) a[0].token[0..<v.token_n]); jo_put(o[..], ","); }
  jo_put(o[..], "\"op\":"); jo_quoted(o[..], seatw_action_op(a));
  ok := seatw_action_num(o[..], "turn", cast(string) a[0].turn[0..<v.turn_n]) && seatw_action_num(o[..], "pitch", cast(string) a[0].pitch[0..<v.pitch_n])
     && seatw_action_num(o[..], "x", cast(string) a[0].x[0..<v.x_n]) && seatw_action_num(o[..], "z", cast(string) a[0].z[0..<v.z_n]);
  seatw_action_str(o[..], "to", seatw_action_to(a));
  ok = ok && seatw_action_num(o[..], "max", cast(string) a[0].max[0..<v.max_n]);
  seatw_action_str(o[..], "words", seatw_action_words(a)); seatw_action_str(o[..], "tool", seatw_action_tool(a));
  seatw_action_str(o[..], "thing", seatw_action_thing(a)); seatw_action_str(o[..], "out", seatw_action_out(a));
  seatw_action_str(o[..], "shot", seatw_action_shot(a));
  jo_put(o[..], "}");
  return ifx ok then seatw_len(o[..]) else -1;
}
seatw_action_take :: (j: Jv, key: string, dst: [] u8) -> int { n := jv_str(j, jv_get(j, 0, key), dst); return ifx n > 0 then n else 0; }
seatw_action_take_num :: (j: Jv, key: string, dst: [] u8) -> int {
  at := jv_get(j, 0, key);
  if jv_kind(j, at) != JV_NUMBER || !seatw_dec_of(jv_raw(j, at)).ok { return 0; }
  return seatw_set(dst, jv_raw(j, at));
}
// An action read, in any member order and spacing (the server's is jsonb's): false when the line is
// no object. A member of another kind, a number that is no decimal ("4" in quotes, 3e1) or a string
// too long for its place reads as left out, as a seat has always taken it.
seatw_read_action :: (line: string, a: [] SeatwAction) -> bool {
  a[0] = SeatwAction.{};
  nodes: [64] JvNode; d: [1] Jv;
  if !jv_parse(d[..], line, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return false; }
  j := d[0];
  a[0].op_n = seatw_action_take(j, "op", a[0].op[..]); a[0].token_n = seatw_action_take(j, "token", a[0].token[..]);
  a[0].turn_n = seatw_action_take_num(j, "turn", a[0].turn[..]); a[0].pitch_n = seatw_action_take_num(j, "pitch", a[0].pitch[..]);
  a[0].x_n = seatw_action_take_num(j, "x", a[0].x[..]); a[0].z_n = seatw_action_take_num(j, "z", a[0].z[..]);
  a[0].max_n = seatw_action_take_num(j, "max", a[0].max[..]);
  a[0].to_n = seatw_action_take(j, "to", a[0].to[..]); a[0].words_n = seatw_action_take(j, "words", a[0].words[..]);
  a[0].tool_n = seatw_action_take(j, "tool", a[0].tool[..]); a[0].thing_n = seatw_action_take(j, "thing", a[0].thing[..]);
  a[0].out_n = seatw_action_take(j, "out", a[0].out[..]); a[0].shot_n = seatw_action_take(j, "shot", a[0].shot[..]);
  return true;
}

// ---- one observation: what a seat answers an action with, a JSON line

SEATW_NEAR :: 16; SEATW_RESULT :: 200; SEATW_ANSWER :: 1200; SEATW_NAME :: 32; SEATW_ROLE :: 48; SEATW_REALM :: 80;
SEATW_CAM_NAMES :: [4] string.["third", "first", "top", "side"];
SEATW_KIND_NAMES :: [9] string.["tree", "rock", "prop", "building", "house", "dwelling", "lantern", "placed", "centre"];
SEATW_TOOL_NAMES :: [6] string.["build", "fly", "jump", "map", "talk", "voice"];
SEATW_PERSON :: -1;   // a near thing's kind when it is a character

// One thing near: a character (kind SEATW_PERSON, id "character:<index>", with its name and role when
// the realm's spec names it) or an entity (kind an index of SEATW_KIND_NAMES, id "entity:<index>"); d
// metres away and bearing degrees off the seat's facing, each to one decimal place.
SeatwNear :: struct { kind: int; index: int; named: bool; name: [SEATW_NAME] u8; name_n: int; role: [SEATW_ROLE] u8; role_n: int; d: f32; bearing: f32; }
// {"op":"go","ok":true,"result":"reached","realm":"village-green","at":[2.8,3.1],"facing":43.9,
//  "pitch":-10.0,"camera":"third","tools":["jump","talk"],"talking":"Maple","answer":"Fresh loaves!",
//  "others":0,"agents":0,"near":[{"kind":"character","id":"character:0","name":"Maple","role":"baker",
//  "d":1.0,"bearing":0.0},{"kind":"house","id":"entity:1","d":3.0,"bearing":90.0}]}
// pitch only in a first-person camera; camera -1 writes "unknown"; tools a bit for each of
// SEATW_TOOL_NAMES; talking and answer null when their length is 0; near nearest first.
SeatwObs :: struct {
  op: [SEATW_OP] u8; op_n: int; ok: bool;
  result: [SEATW_RESULT] u8; result_n: int; realm: [SEATW_REALM] u8; realm_n: int;
  x: f32; z: f32; facing: f32; has_pitch: bool; pitch: f32; camera: int; tools: int;
  talking: [SEATW_ROLE] u8; talking_n: int; answer: [SEATW_ANSWER] u8; answer_n: int;
  others: int; agents: int;
  near: [SEATW_NEAR] SeatwNear; near_n: int;
}
seatw_obs_op :: (b: [] SeatwObs) -> string { return cast(string) b[0].op[0..<b[0].op_n]; }
seatw_obs_result :: (b: [] SeatwObs) -> string { return cast(string) b[0].result[0..<b[0].result_n]; }
seatw_obs_realm :: (b: [] SeatwObs) -> string { return cast(string) b[0].realm[0..<b[0].realm_n]; }
seatw_obs_talking :: (b: [] SeatwObs) -> string { return cast(string) b[0].talking[0..<b[0].talking_n]; }
seatw_obs_answer :: (b: [] SeatwObs) -> string { return cast(string) b[0].answer[0..<b[0].answer_n]; }
seatw_obs_camera :: (b: [] SeatwObs) -> string { return ifx b[0].camera >= 0 && b[0].camera < 4 then SEATW_CAM_NAMES[b[0].camera] else "unknown"; }
seatw_near_name :: (b: [] SeatwObs, i: int) -> string { return cast(string) b[0].near[i].name[0..<b[0].near[i].name_n]; }
seatw_near_role :: (b: [] SeatwObs, i: int) -> string { return cast(string) b[0].near[i].role[0..<b[0].near[i].role_n]; }
seatw_near_kind :: (b: [] SeatwObs, i: int) -> string {
  k := b[0].near[i].kind;
  return ifx k == SEATW_PERSON then "character" else ifx k >= 0 && k < SEATW_KIND_NAMES.count then SEATW_KIND_NAMES[k] else "";
}
// One decimal place: 3.14 is "3.1", -0.04 is "0.0".
seatw_dec :: (o: [] Jo, v: f32) {
  t := cast(int) (v * 10 + (ifx v < 0 then -0.5f32 else 0.5f32));
  if t < 0 { jo_put(o, "-"); t = -t; }
  jo_int(o, t / 10); jo_put(o, "."); jo_int(o, t % 10);
}
// A near thing's id, "character:0" or "entity:12", into out: its text.
seatw_near_id :: (b: [] SeatwObs, i: int, out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], ifx b[0].near[i].kind == SEATW_PERSON then "character:" else "entity:"); jo_int(o[..], b[0].near[i].index);
  return ifx o[0].bad then "" else cast(string) out[0..<o[0].n];
}
// The observation's bytes: -1 when it has no op, a near thing's kind is none, or it does not fit out.
seatw_obs_json :: (b: [] SeatwObs, out: [] u8) -> int {
  if b[0].op_n < 1 || b[0].near_n < 0 || b[0].near_n > SEATW_NEAR || b[0].others < 0 || b[0].agents < 0 { return -1; }
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], "{\"op\":"); jo_quoted(o[..], seatw_obs_op(b)); jo_put(o[..], ",\"ok\":"); jo_put(o[..], ifx b[0].ok then "true" else "false");
  jo_put(o[..], ",\"result\":"); jo_quoted(o[..], seatw_obs_result(b));
  jo_put(o[..], ",\"realm\":"); jo_quoted(o[..], seatw_obs_realm(b));
  jo_put(o[..], ",\"at\":["); seatw_dec(o[..], b[0].x); jo_put(o[..], ","); seatw_dec(o[..], b[0].z); jo_put(o[..], "],\"facing\":"); seatw_dec(o[..], b[0].facing);
  if b[0].has_pitch { jo_put(o[..], ",\"pitch\":"); seatw_dec(o[..], b[0].pitch); }
  jo_put(o[..], ",\"camera\":\""); jo_put(o[..], seatw_obs_camera(b)); jo_put(o[..], "\"");
  jo_put(o[..], ",\"tools\":["); first := true;
  for t: 0..<SEATW_TOOL_NAMES.count { if (b[0].tools & (1 << t)) != 0 { if !first { jo_put(o[..], ","); } jo_put(o[..], "\""); jo_put(o[..], SEATW_TOOL_NAMES[t]); jo_put(o[..], "\""); first = false; } }
  jo_put(o[..], "],\"talking\":"); if b[0].talking_n > 0 { jo_quoted(o[..], seatw_obs_talking(b)); } else { jo_put(o[..], "null"); }
  jo_put(o[..], ",\"answer\":"); if b[0].answer_n > 0 { jo_quoted(o[..], seatw_obs_answer(b)); } else { jo_put(o[..], "null"); }
  jo_put(o[..], ",\"others\":"); jo_int(o[..], b[0].others); jo_put(o[..], ",\"agents\":"); jo_int(o[..], b[0].agents);
  jo_put(o[..], ",\"near\":[");
  for i: 0..<b[0].near_n {
    e := b[0].near[i];
    kind := seatw_near_kind(b, i);
    if kind == "" || e.index < 0 { return -1; }
    if i > 0 { jo_put(o[..], ","); }
    jo_put(o[..], "{\"kind\":\""); jo_put(o[..], kind); jo_put(o[..], "\",\"id\":\"");
    jo_put(o[..], ifx e.kind == SEATW_PERSON then "character:" else "entity:"); jo_int(o[..], e.index); jo_put(o[..], "\"");
    if e.kind == SEATW_PERSON && e.named { jo_put(o[..], ",\"name\":"); jo_quoted(o[..], seatw_near_name(b, i)); jo_put(o[..], ",\"role\":"); jo_quoted(o[..], seatw_near_role(b, i)); }
    jo_put(o[..], ",\"d\":"); seatw_dec(o[..], e.d); jo_put(o[..], ",\"bearing\":"); seatw_dec(o[..], e.bearing); jo_put(o[..], "}");
  }
  jo_put(o[..], "]}");
  return seatw_len(o[..]);
}
// A decimal member's value; ok false when it is missing or no decimal number.
seatw_obs_num :: (j: Jv, at: int) -> SeatwDec { return ifx jv_kind(j, at) == JV_NUMBER then seatw_dec_of(jv_raw(j, at)) else SeatwDec.{}; }
// A string member that may be null: its length (0 for null), or -1 for another kind or one too long.
seatw_obs_text :: (j: Jv, at: int, dst: [] u8) -> int {
  if jv_kind(j, at) == JV_NULL { return 0; }
  return jv_str(j, at, dst);
}
// The index after PREFIX in "PREFIX<digits>", or -1.
seatw_id_index :: (id: string, prefix: string) -> int {
  if id.count <= prefix.count || id.count > prefix.count + 6 || id[0..<prefix.count] != prefix { return -1; }
  v := 0;
  for i: prefix.count..<id.count { if id[i] < '0' || id[i] > '9' { return -1; } v = v * 10 + cast(int) (id[i] - '0'); }
  return v;
}
// An observation read: false, with b cleared, when the line is no object or a member is missing or
// of another kind (a kind or a tool this file does not name, an id that is not its kind's). others
// and agents may be left out (0): a seat older than the realm's room does not say them.
seatw_read_obs :: (line: string, b: [] SeatwObs) -> bool {
  b[0] = SeatwObs.{};
  if seatw_read_obs_at(line, b) { return true; }
  b[0] = SeatwObs.{};
  return false;
}
seatw_read_obs_at :: (line: string, b: [] SeatwObs) -> bool {
  nodes: [1024] JvNode; d: [1] Jv;
  if !jv_parse(d[..], line, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return false; }
  j := d[0];
  b[0].op_n = jv_str(j, jv_get(j, 0, "op"), b[0].op[..]);
  okf := seatw_flag(j, 0, "ok");
  b[0].result_n = jv_str(j, jv_get(j, 0, "result"), b[0].result[..]);
  b[0].realm_n = jv_str(j, jv_get(j, 0, "realm"), b[0].realm[..]);
  if b[0].op_n < 1 || okf < 0 || b[0].result_n < 0 || b[0].realm_n < 0 { return false; }
  b[0].ok = okf == 1;
  at := jv_get(j, 0, "at");
  if jv_kind(j, at) != JV_ARRAY || jv_len(j, at) != 2 { return false; }
  x := seatw_obs_num(j, jv_at(j, at, 0)); z := seatw_obs_num(j, jv_at(j, at, 1)); f := seatw_obs_num(j, jv_get(j, 0, "facing"));
  if !x.ok || !z.ok || !f.ok { return false; }
  b[0].x = x.v; b[0].z = z.v; b[0].facing = f.v;
  pa := jv_get(j, 0, "pitch");
  if pa >= 0 { p := seatw_obs_num(j, pa); if !p.ok { return false; } b[0].has_pitch = true; b[0].pitch = p.v; }
  cb: [16] u8; cn := jv_str(j, jv_get(j, 0, "camera"), cb[..]);
  if cn < 1 { return false; }
  b[0].camera = -1;
  for c: 0..<SEATW_CAM_NAMES.count { if cast(string) cb[0..<cn] == SEATW_CAM_NAMES[c] { b[0].camera = c; } }
  if b[0].camera < 0 && cast(string) cb[0..<cn] != "unknown" { return false; }
  tools := jv_get(j, 0, "tools");
  if jv_kind(j, tools) != JV_ARRAY { return false; }
  for i: 0..<jv_len(j, tools) {
    tb: [16] u8; tn := jv_str(j, jv_at(j, tools, i), tb[..]); bit := 0;
    for t: 0..<SEATW_TOOL_NAMES.count { if tn > 0 && cast(string) tb[0..<tn] == SEATW_TOOL_NAMES[t] { bit = 1 << t; } }
    if bit == 0 { return false; }
    b[0].tools = b[0].tools | bit;
  }
  b[0].talking_n = seatw_obs_text(j, jv_get(j, 0, "talking"), b[0].talking[..]);
  b[0].answer_n = seatw_obs_text(j, jv_get(j, 0, "answer"), b[0].answer[..]);
  if b[0].talking_n < 0 || b[0].answer_n < 0 { return false; }
  if jv_get(j, 0, "others") >= 0 { b[0].others = seatw_whole(j, 0, "others"); }
  if jv_get(j, 0, "agents") >= 0 { b[0].agents = seatw_whole(j, 0, "agents"); }
  if b[0].others < 0 || b[0].agents < 0 { return false; }
  near := jv_get(j, 0, "near");
  if jv_kind(j, near) != JV_ARRAY || jv_len(j, near) > SEATW_NEAR { return false; }
  for i: 0..<jv_len(j, near) {
    e := jv_at(j, near, i);
    if jv_kind(j, e) != JV_OBJECT { return false; }
    kb: [16] u8; kn := jv_str(j, jv_get(j, e, "kind"), kb[..]); ib: [24] u8; idn := jv_str(j, jv_get(j, e, "id"), ib[..]);
    if kn < 1 || idn < 1 { return false; }
    kind := cast(string) kb[0..<kn]; k := -2;
    if kind == "character" { k = SEATW_PERSON; }
    for q: 0..<SEATW_KIND_NAMES.count { if kind == SEATW_KIND_NAMES[q] { k = q; } }
    index := seatw_id_index(cast(string) ib[0..<idn], ifx k == SEATW_PERSON then "character:" else "entity:");
    dd := seatw_obs_num(j, jv_get(j, e, "d")); br := seatw_obs_num(j, jv_get(j, e, "bearing"));
    if k == -2 || index < 0 || !dd.ok || !br.ok { return false; }
    b[0].near[i].kind = k; b[0].near[i].index = index; b[0].near[i].d = dd.v; b[0].near[i].bearing = br.v;
    if jv_get(j, e, "name") >= 0 || jv_get(j, e, "role") >= 0 {
      nn := jv_str(j, jv_get(j, e, "name"), b[0].near[i].name[..]); rn := jv_str(j, jv_get(j, e, "role"), b[0].near[i].role[..]);
      if k != SEATW_PERSON || nn < 0 || rn < 0 { return false; }
      b[0].near[i].named = true; b[0].near[i].name_n = nn; b[0].near[i].role_n = rn;
    }
  }
  b[0].near_n = jv_len(j, near);
  return true;
}

#test "the open body, and what the server reads in one" {
  b: [128] u8; r: [1] SeatwOpen;
  n := seatw_open_body("village-green", false, b[..]);
  #assert cast(string) b[0..<n] == "{\"slug\":\"village-green\"}";
  #assert seatw_read_open(cast(string) b[0..<n], r[..]) && r[0].ok && seatw_open_slug(r[..]) == "village-green" && !r[0].hosted;
  n = seatw_open_body("village-green", true, b[..]);
  #assert cast(string) b[0..<n] == "{\"slug\":\"village-green\",\"hosted\":true}" && seatw_open_body("village-green", true, b[0..<n - 1]) == -1;
  #assert seatw_read_open(cast(string) b[0..<n], r[..]) && r[0].hosted;
  n = seatw_open_body("a\"b", false, b[..]);
  #assert cast(string) b[0..<n] == "{\"slug\":\"a\\\"b\"}";
  #assert seatw_read_open("{\"slug\":\"g\",\"hosted\":\"true\"}", r[..]) && !r[0].hosted && seatw_read_open("{\"slug\":\"g\",\"hosted\":1}", r[..]) && !r[0].hosted;
  #assert seatw_read_open("{\"slug\":\"g\",\"hosted\":false}", r[..]) && !r[0].hosted;
  #assert !seatw_read_open("{\"slug\":\"Bad Slug\"}", r[..]) && !r[0].ok && r[0].slug_n == 0;
  #assert !seatw_read_open("{\"slug\":7}", r[..]) && !seatw_read_open("{}", r[..]) && !seatw_read_open("[]", r[..]) && !seatw_read_open("", r[..]) && !seatw_read_open("{\"slug\":\"\"}", r[..]);
  #assert seatw_slug_ok("a") && seatw_slug_ok("a-0-z9") && !seatw_slug_ok("") && !seatw_slug_ok("A") && !seatw_slug_ok("a_b") && !seatw_slug_ok("a b") && !seatw_slug_ok("a{") && !seatw_slug_ok("a/") && !seatw_slug_ok("a`") && !seatw_slug_ok("a:");
  #assert seatw_slug_ok("123456789012345678901234567890123456789012345678") && !seatw_slug_ok("1234567890123456789012345678901234567890123456789");
}
#test "a grant as jsonb spells it, with its key and without" {
  b: [512] u8; g: [1] SeatwGrant; h: [1] SeatwGrant;
  #assert seatw_grant_of(g[..], 7, "seat-green", 1762190600123, false, "p-1a2b", "k0123456789abcdefghij");
  n := seatw_grant_json(g[..], b[..]);
  want := "{\"id\": 7, \"slug\": \"seat-green\", \"until\": 1762190600123, \"hosted\": false, \"player\": {\"id\": \"p-1a2b\", \"key\": \"k0123456789abcdefghij\"}}";
  #assert cast(string) b[0..<n] == want && seatw_grant_json(g[..], b[0..<n - 1]) == -1;
  #assert seatw_read_grant(want, h[..]) && h[0].id == 7 && h[0].until == 1762190600123 && !h[0].hosted;
  #assert seatw_grant_slug(h[..]) == "seat-green" && seatw_grant_pid(h[..]) == "p-1a2b" && seatw_grant_key(h[..]) == "k0123456789abcdefghij";
  #assert seatw_grant_of(g[..], 8, "g", 0, true, "p-1", "");
  n = seatw_grant_json(g[..], b[..]);
  want = "{\"id\": 8, \"slug\": \"g\", \"until\": 0, \"hosted\": true, \"player\": {\"id\": \"p-1\"}}";
  #assert cast(string) b[0..<n] == want;
  #assert seatw_read_grant(want, h[..]) && h[0].id == 8 && h[0].hosted && h[0].key_n == 0 && h[0].until == 0;
  n = seatw_grant_none(b[..]);
  #assert cast(string) b[0..<n] == "{}" && seatw_grant_none(b[0..<1]) == -1 && !seatw_read_grant("{}", h[..]);
  // compact, and in another order, it reads the same
  #assert seatw_read_grant("{\"player\":{\"key\":\"k\",\"id\":\"p-2\"},\"hosted\":false,\"until\":5,\"slug\":\"s\",\"id\":9}", h[..]) && h[0].id == 9 && seatw_grant_key(h[..]) == "k" && h[0].until == 5;
  #assert !seatw_grant_of(g[..], 0, "g", 0, true, "p-1", "") && g[0].slug_n == 0 && !seatw_grant_of(g[..], 1, "G", 0, true, "p-1", "");
  #assert !seatw_grant_of(g[..], 1, "g", -1, true, "p-1", "") && !seatw_grant_of(g[..], 1, "g", 0, true, "", "");
  #assert seatw_grant_of(g[..], SEATW_MOST, "g", SEATW_MOST, true, "p-1", "") && !seatw_grant_of(g[..], SEATW_MOST + 1, "g", 0, true, "p-1", "") && !seatw_grant_of(g[..], 1, "g", SEATW_MOST + 1, true, "p-1", "");
}
#test "a grant with a member missing or of another kind is refused whole" {
  h: [1] SeatwGrant;
  #assert !seatw_read_grant("{\"error\":\"no such realm\"}", h[..]) && h[0].id == 0 && !seatw_read_grant("nope", h[..]) && !seatw_read_grant("[]", h[..]) && !seatw_read_grant("", h[..]);
  #assert !seatw_read_grant("{\"id\": 0, \"slug\": \"g\", \"until\": 0, \"hosted\": true, \"player\": {\"id\": \"p-1\"}}", h[..]);
  #assert !seatw_read_grant("{\"id\": \"7\", \"slug\": \"g\", \"until\": 0, \"hosted\": true, \"player\": {\"id\": \"p-1\"}}", h[..]);
  #assert !seatw_read_grant("{\"id\": 7, \"until\": 0, \"hosted\": true, \"player\": {\"id\": \"p-1\"}}", h[..]);
  #assert !seatw_read_grant("{\"id\": 7, \"slug\": \"G\", \"until\": 0, \"hosted\": true, \"player\": {\"id\": \"p-1\"}}", h[..]);
  #assert !seatw_read_grant("{\"id\": 7, \"slug\": \"g\", \"hosted\": true, \"player\": {\"id\": \"p-1\"}}", h[..]);
  #assert !seatw_read_grant("{\"id\": 7, \"slug\": \"g\", \"until\": -1, \"hosted\": true, \"player\": {\"id\": \"p-1\"}}", h[..]);
  #assert !seatw_read_grant("{\"id\": 7, \"slug\": \"g\", \"until\": 0, \"player\": {\"id\": \"p-1\"}}", h[..]);
  #assert !seatw_read_grant("{\"id\": 7, \"slug\": \"g\", \"until\": 0, \"hosted\": 1, \"player\": {\"id\": \"p-1\"}}", h[..]);
  #assert !seatw_read_grant("{\"id\": 7, \"slug\": \"g\", \"until\": 0, \"hosted\": true}", h[..]);
  #assert !seatw_read_grant("{\"id\": 7, \"slug\": \"g\", \"until\": 0, \"hosted\": true, \"player\": \"p-1\"}", h[..]);
  #assert !seatw_read_grant("{\"id\": 7, \"slug\": \"g\", \"until\": 0, \"hosted\": true, \"player\": {}}", h[..]);
  #assert !seatw_read_grant("{\"id\": 7, \"slug\": \"g\", \"until\": 0, \"hosted\": true, \"player\": {\"id\": \"\"}}", h[..]);
  #assert !seatw_read_grant("{\"id\": 7, \"slug\": \"g\", \"until\": 0, \"hosted\": true, \"player\": {\"id\": \"p-1\", \"key\": 5}}", h[..]) && h[0].pid_n == 0 && h[0].slug_n == 0;
  #assert seatw_read_grant("{\"id\": 1, \"slug\": \"g\", \"until\": 0, \"hosted\": true, \"player\": {\"id\": \"p\", \"key\": \"\"}}", h[..]) && h[0].key_n == 0 && h[0].id == 1;
}
#test "the account's seats, newest first, and none" {
  b: [512] u8; rows: [3] SeatwSeat; back: [3] SeatwSeat;
  rows[0] = seatw_seat_of(9, "seat-mine", true, 1762190000456, 1762190000123);
  rows[1] = seatw_seat_of(7, "g", false, 2, 1);
  n := seatw_seats_json(rows[0..<2], b[..]);
  want := "{\"seats\": [{\"id\": 9, \"slug\": \"seat-mine\", \"hosted\": true, \"kept_ms\": 1762190000456, \"opened_ms\": 1762190000123}, {\"id\": 7, \"slug\": \"g\", \"hosted\": false, \"kept_ms\": 2, \"opened_ms\": 1}]}";
  #assert cast(string) b[0..<n] == want && seatw_seats_json(rows[0..<2], b[0..<n - 1]) == -1;
  #assert seatw_read_seats(want, back[..]) == 2 && back[0].id == 9 && back[0].hosted && back[0].kept_ms == 1762190000456 && back[0].opened_ms == 1762190000123;
  #assert seatw_seat_slug(back[0..<1]) == "seat-mine" && back[1].id == 7 && !back[1].hosted && back[1].kept_ms == 2 && back[1].opened_ms == 1 && seatw_seat_slug(back[1..<2]) == "g";
  n = seatw_seats_json(rows[0..<0], b[..]);
  #assert cast(string) b[0..<n] == "{\"seats\": []}" && seatw_read_seats("{\"seats\": []}", back[..]) == 0;
  #assert seatw_read_seats(want, back[0..<1]) == -1 && seatw_read_seats(want, back[0..<2]) == 2;
  #assert seatw_read_seats("{\"seats\": {}}", back[..]) == -1 && seatw_read_seats("{}", back[..]) == -1 && seatw_read_seats("[]", back[..]) == -1 && seatw_read_seats("", back[..]) == -1;
  #assert seatw_read_seats("{\"seats\": [7]}", back[..]) == -1;
  #assert seatw_read_seats("{\"seats\": [{\"id\": 0, \"slug\": \"g\", \"hosted\": false, \"kept_ms\": 2, \"opened_ms\": 1}]}", back[..]) == -1;
  #assert seatw_read_seats("{\"seats\": [{\"id\": 7, \"slug\": \"G\", \"hosted\": false, \"kept_ms\": 2, \"opened_ms\": 1}]}", back[..]) == -1;
  #assert seatw_read_seats("{\"seats\": [{\"id\": 7, \"hosted\": false, \"kept_ms\": 2, \"opened_ms\": 1}]}", back[..]) == -1;
  #assert seatw_read_seats("{\"seats\": [{\"id\": 7, \"slug\": \"g\", \"kept_ms\": 2, \"opened_ms\": 1}]}", back[..]) == -1;
  #assert seatw_read_seats("{\"seats\": [{\"id\": 7, \"slug\": \"g\", \"hosted\": false, \"opened_ms\": 1}]}", back[..]) == -1;
  #assert seatw_read_seats("{\"seats\": [{\"id\": 7, \"slug\": \"g\", \"hosted\": false, \"kept_ms\": 2}]}", back[..]) == -1;
  #assert seatw_read_seats("{\"seats\": [{\"id\": 7, \"slug\": \"g\", \"hosted\": false, \"kept_ms\": 0, \"opened_ms\": 0}]}", back[..]) == 1 && back[0].kept_ms == 0;
  bad := seatw_seat_of(1, "Bad", false, 0, 0);
  #assert bad.slug_n == 0 && bad.id == 0;
}
#test "kept and closed" {
  b: [32] u8;
  n := seatw_kept(b[..]);
  #assert cast(string) b[0..<n] == "{\"kept\":true}" && seatw_kept(b[0..<n - 1]) == -1 && seatw_read_kept("{\"kept\":true}") && !seatw_read_closed("{\"kept\":true}");
  n = seatw_closed(b[..]);
  #assert cast(string) b[0..<n] == "{\"closed\":true}" && seatw_closed(b[0..<n - 1]) == -1 && seatw_read_closed("{\"closed\":true}") && !seatw_read_kept("{\"closed\":true}");
  #assert !seatw_read_kept("{\"kept\":false}") && !seatw_read_kept("{\"kept\":1}") && !seatw_read_kept("[true]") && !seatw_read_kept("") && !seatw_read_kept("{\"error\":\"no such open seat\"}");
}
#test "what the API sends the runner: the grant as it came with the origin, and a seat's id" {
  b: [512] u8; g: [1] SeatwGrant; ob: [SEATW_ORIGIN] u8;
  seat := "{\"id\": 7, \"slug\": \"seat-green\", \"until\": 1762190600123, \"hosted\": true, \"player\": {\"id\": \"p-1a2b\", \"key\": \"k0123456789abcdefghij\"}}";
  n := seatw_runner_open(seat, "https://openagents.com", b[..]);
  want := "{\"seat\":{\"id\": 7, \"slug\": \"seat-green\", \"until\": 1762190600123, \"hosted\": true, \"player\": {\"id\": \"p-1a2b\", \"key\": \"k0123456789abcdefghij\"}},\"origin\":\"https://openagents.com\"}";
  #assert cast(string) b[0..<n] == want && seatw_runner_open(seat, "https://openagents.com", b[0..<n - 1]) == -1;
  on := seatw_read_runner_open(want, g[..], ob[..]);
  #assert on == 22 && cast(string) ob[0..<on] == "https://openagents.com" && g[0].id == 7 && g[0].hosted && seatw_grant_key(g[..]) == "k0123456789abcdefghij" && seatw_grant_slug(g[..]) == "seat-green";
  #assert seatw_runner_open("", "o", b[..]) == -1 && seatw_runner_open("}", "o", b[..]) == -1 && seatw_runner_open("[]", "o", b[..]) == -1 && seatw_runner_open("{\"id\": 7", "o", b[..]) == -1 && seatw_runner_open("x}", "o", b[..]) == -1;
  #assert seatw_read_runner_open("{\"seat\":{\"id\": 7},\"origin\":\"https://a.b\"}", g[..], ob[..]) == -1 && g[0].id == 0;
  #assert seatw_read_runner_open("{\"seat\":", g[..], ob[..]) == -1 && seatw_read_runner_open("[]", g[..], ob[..]) == -1;
  #assert seatw_read_runner_open("{\"seat\":{\"id\": 7, \"slug\": \"g\", \"until\": 0, \"hosted\": true, \"player\": {\"id\": \"p-1\"}}}", g[..], ob[..]) == -1 && g[0].id == 0;
  #assert seatw_read_runner_open("{\"seat\":{\"id\": 7, \"slug\": \"g\", \"until\": 0, \"hosted\": true, \"player\": {\"id\": \"p-1\"}},\"origin\":\"\"}", g[..], ob[..]) == -1 && g[0].id == 0;
  n = seatw_runner_close("7", b[..]);
  #assert cast(string) b[0..<n] == "{\"id\":7}" && seatw_runner_close("7", b[0..<n - 1]) == -1 && seatw_read_id("{\"id\":7}") == 7;
  n = seatw_runner_close("12345678901234567890", b[..]);
  #assert cast(string) b[0..<n] == "{\"id\":12345678901234567890}" && seatw_runner_close("123456789012345678901", b[..]) == -1;
  #assert seatw_runner_close("", b[..]) == -1 && seatw_runner_close("7a", b[..]) == -1 && seatw_runner_close("-7", b[..]) == -1 && seatw_runner_close("/", b[..]) == -1 && seatw_runner_close(":", b[..]) == -1;
  #assert seatw_read_id("{\"id\":0}") == -1 && seatw_read_id("{\"id\":\"7\"}") == -1 && seatw_read_id("{}") == -1 && seatw_read_id("[7]") == -1 && seatw_read_id("") == -1 && seatw_read_id("{\"id\": 42}") == 42;
}
#test "an action handed to the runner: the seat's id and the action as it came" {
  b: [256] u8; a: [64] u8;
  n := seatw_runner_act(13, "{\"op\": \"look\", \"turn\": 90}", b[..]);
  want := "{\"id\": 13, \"action\": {\"op\": \"look\", \"turn\": 90}}";
  #assert cast(string) b[0..<n] == want && seatw_runner_act(13, "{\"op\": \"look\", \"turn\": 90}", b[0..<n - 1]) == -1;
  #assert seatw_read_id(want) == 13;
  an := seatw_read_runner_action(want, a[..]);
  #assert cast(string) a[0..<an] == "{\"op\": \"look\", \"turn\": 90}" && seatw_read_runner_action(want, a[0..<an - 1]) == -1 && seatw_read_runner_action(want, a[0..<an]) == an;
  an = seatw_read_runner_action("{\"action\":{},\"id\":1}", a[..]);
  #assert an == 2 && cast(string) a[0..<an] == "{}";
  #assert seatw_read_runner_action("{\"id\": 1, \"action\": [1]}", a[..]) == -1 && seatw_read_runner_action("{\"id\": 1, \"action\": \"look\"}", a[..]) == -1;
  #assert seatw_read_runner_action("{\"id\": 1}", a[..]) == -1 && seatw_read_runner_action("[]", a[..]) == -1 && seatw_read_runner_action("", a[..]) == -1 && seatw_read_runner_action("{\"id\": 1, \"action\": {", a[..]) == -1;
  #assert seatw_runner_act(0, "{}", b[..]) == -1 && seatw_runner_act(1, "", b[..]) == -1 && seatw_runner_act(1, "}", b[..]) == -1 && seatw_runner_act(1, "[]", b[..]) == -1 && seatw_runner_act(1, "{]", b[..]) == -1 && seatw_runner_act(1, "x}", b[..]) == -1;
  n = seatw_runner_act(1, "{}", b[..]);
  #assert cast(string) b[0..<n] == "{\"id\": 1, \"action\": {}}" && seatw_runner_act(SEATW_MOST, "{}", b[..]) > 0 && seatw_runner_act(SEATW_MOST + 1, "{}", b[..]) == -1;
}
#test "a seat's first line: the origin, the slug and the player as the grant spelled it" {
  b: [512] u8; g: [1] SeatwGrant; s: [1] SeatwStart;
  #assert seatw_grant_of(g[..], 7, "seat-green", 9, true, "p-1a2b", "k0123456789abcdefghij");
  n := seatw_start_line(g[..], "https://openagents.com", b[..]);
  want := "{\"origin\":\"https://openagents.com\",\"slug\":\"seat-green\",\"player\":{\"id\": \"p-1a2b\", \"key\": \"k0123456789abcdefghij\"}}";
  #assert cast(string) b[0..<n] == want && seatw_start_line(g[..], "https://openagents.com", b[0..<n - 1]) == -1 && seatw_start_line(g[..], "", b[..]) == -1;
  #assert seatw_read_start(want, s[..]) && seatw_start_origin(s[..]) == "https://openagents.com" && seatw_start_slug(s[..]) == "seat-green";
  #assert seatw_start_pid(s[..]) == "p-1a2b" && seatw_start_key(s[..]) == "k0123456789abcdefghij" && !s[0].phone;
  #assert seatw_grant_of(g[..], 7, "seat-green", 9, true, "p-1a2b", "") && seatw_start_line(g[..], "https://openagents.com", b[..]) == -1;
  none: [1] SeatwGrant;
  #assert seatw_start_line(none[..], "https://openagents.com", b[..]) == -1;
  // a seat started by hand: the player in another order, and a phone-sized page
  #assert seatw_read_start("{\"origin\":\"http://127.0.0.1:8800\",\"slug\":\"g\",\"player\":{\"key\":\"k\",\"id\":\"p-1\"},\"phone\":true}", s[..]) && s[0].phone && seatw_start_key(s[..]) == "k";
  #assert seatw_read_start("{\"origin\":\"o\",\"slug\":\"g\",\"player\":{\"key\":\"k\",\"id\":\"p\"},\"phone\":\"true\"}", s[..]) && !s[0].phone;
  #assert !seatw_read_start("{\"slug\":\"g\",\"player\":{\"key\":\"k\",\"id\":\"p\"}}", s[..]) && s[0].slug_n == 0 && s[0].key_n == 0;
  #assert !seatw_read_start("{\"origin\":\"o\",\"player\":{\"key\":\"k\",\"id\":\"p\"}}", s[..]) && !seatw_read_start("{\"origin\":\"o\",\"slug\":\"g\"}", s[..]);
  #assert !seatw_read_start("{\"origin\":\"o\",\"slug\":\"g\",\"player\":{\"id\":\"p\"}}", s[..]) && !seatw_read_start("{\"origin\":\"o\",\"slug\":\"g\",\"player\":{\"key\":\"k\"}}", s[..]);
  #assert !seatw_read_start("{\"origin\":\"\",\"slug\":\"g\",\"player\":{\"key\":\"k\",\"id\":\"p\"}}", s[..]) && !seatw_read_start("{\"origin\":\"o\",\"slug\":\"\",\"player\":{\"key\":\"k\",\"id\":\"p\"}}", s[..]);
  #assert !seatw_read_start("{\"origin\":\"o\",\"slug\":\"g\",\"player\":{\"key\":\"\",\"id\":\"p\"}}", s[..]) && !seatw_read_start("{\"origin\":\"o\",\"slug\":\"g\",\"player\":{\"key\":\"k\",\"id\":\"\"}}", s[..]);
  #assert !seatw_read_start("[]", s[..]) && !seatw_read_start("", s[..]);
}
#test "whether a seat's answer says ok" {
  #assert seatw_answer_ok("{\"op\":\"open\",\"ok\":true,\"result\":\"seated\"}") && seatw_answer_ok("{\"op\": \"open\", \"ok\": true}");
  #assert !seatw_answer_ok("{\"op\":\"open\",\"ok\":false,\"result\":\"no browser\"}") && !seatw_answer_ok("{\"op\":\"open\"}") && !seatw_answer_ok("{\"ok\":\"true\"}");
  #assert !seatw_answer_ok("[true]") && !seatw_answer_ok("") && !seatw_answer_ok("{\"ok\":true");
}
