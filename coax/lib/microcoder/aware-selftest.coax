// The native check of Microcoder's compiler questions, hash-tied edits, working memory and
// finish rule (aware.coax; GitHub #13444, #13445). `coax test` cannot reach these effects, so
// this program does: a scratch Coax repository in a temporary folder, the real compiler, the
// real run (run.coax: its plan, its journal, its tools) and a scripted model. No model is
// called: each step's reply is a recorded HTTP response the gateway replays (GW_REPLAY).
//   coax/web/tool.sh coax/lib/microcoder/aware-selftest.coax [--coax PATH]
// It starts itself again with GW_REPLAY set, runs four runs there, and prints
// "aware selftest: ok". Run it from the checkout's root (the compiler is coax/bin/coax there).
//
//   A  no mode: the request, the state and a view are the old ones; a finish is not held
//   B  both modes, seeded: every question, questions the compiler can't answer, a stale edit,
//      applied edits with their hash and check, a declaration replaced by name, repeat reads,
//      notes, a finish refused and then accepted, the journal, the report
//   C  the memory alone, on B's folder: what an earlier run read, a check that passed before an
//      edit, two refusals and then a finish that stands with the check unproven
//   D  the compiler alone, with no compiler: no answer, and the run goes on
#import "Basic";
#load "../sys/tool.coax";
#load "run.coax";

AS_SHAPES :: "// shapes\nShape :: struct { w: int; h: int; }\nUNIT :: 1;\narea :: (s: Shape) -> int { return s.w * s.h; }\n#test \"area of a unit square\" { #assert area(Shape.{w = UNIT, h = UNIT}) == 1; }\n";
AS_AREA :: "area :: (s: Shape) -> int { return s.w * s.h; }\n";
AS_CLOCK :: "cx_now :: () -> int #foreign #effects(foreign, clock);\nstamp :: () -> int { return cx_now() + 1; }\n";
AS_EDGE :: "edge :: (s: Shape) -> int {\n  return 2 * (s.w + s.h) + area(s) * 0;\n}\n";
AS_PART_HEAD :: "// a part: it names Shape and area but loads nothing, so it checks only inside main.coax\n";
AS_PART_TAIL :: "flat :: (s: Shape) -> bool {\n  return s.h == 0;\n}\n";
AS_MAIN :: "#load \"shapes.coax\";\n#load \"clock.coax\";\n#load \"part.coax\";\ntotal :: (a: Shape, b: Shape) -> int { return area(a) + area(b); }\ntimed :: (a: Shape) -> int { return area(a) + stamp(); }\nrun :: () -> int { return total(Shape.{w = 1, h = 2}, Shape.{w = 3, h = 4}) + edge(Shape.{w = 1, h = 1}); }\n";
AS_BAD :: "#load \"shapes.coax\";\nwrong :: (s: Shape) -> int { x: string = area(s); return x; }\n";
AS_TAGGED :: "safe :: (a: int, b: int) -> int { return add_checked(a, b) or_else 0; }\n";
AS_TEST :: "grep -q 'return s.h \\* s.w' shapes.coax && echo 'test ok'\n";
AS_SHAPES_DONE :: "// shapes and sizes\nShape :: struct { w: int; h: int; }\nUNIT :: 1;\narea :: (s: Shape) -> int {\n  return s.h * s.w;\n}\n#test \"area of a unit square\" { #assert area(Shape.{w = UNIT, h = UNIT}) == 1; }\n";

AS_TASK_A :: "Read the first line of shapes.coax. The check is `sh test.sh`.";
AS_TASK_B :: "Make area multiply h by w in shapes.coax. The check is `sh test.sh`: it must pass.";
AS_TASK_C :: "Say again that these are shapes. The check is `sh test.sh`.";

AS_DONE :: "{\"rationale\":\"done\",\"notes\":[],\"edits\":[],\"questions\":[],\"commands\":[],\"view\":[],\"finished\":true,\"reply\":\"done\",\"ask\":\"none\"}";

AsMem :: struct {
  run: [1] McRun; sb: [1] McStateBuffers; lb: [1] McLoopBuffers;
  plan: [1] GwPlan; pb: [1] GwPlanBuffers; bench: [1] GwBench;
  aw: [1] McAware;
  state: [MC_PROMPT_BYTES] u8; arena: [262144] u8;
  reply: [16384] u8; http: [32768] u8; line: [8192] u8;
  journal: [4194304] u8;
  none: [1] string;
  pass: int; fail: int; replies: int;
  asks: int; ask_ok: int;        // "ask: ..." command events of the run, and those with exit 0
}

as_check :: (m: [] AsMem, ok: bool, what: string, got: string) {
  if ok { m[0].pass += 1; print("  ok   %\n", what); return; }
  m[0].fail += 1;
  print("  FAIL %\n       got: %\n", what, got);
}
as_has :: (s: string, part: string) -> bool { return ps_find(s, part) >= 0; }

// The next recorded response: action as the model's whole reply.
as_reply :: (m: [] AsMem, dir: string, action: string) -> bool {
  m[0].replies += 1;
  b := m[0].http[..];
  n := json_raw(b, 0, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n\r\ndata: {\"choices\":[{\"delta\":{\"content\":");
  n = json_write_string(b, n, action); n = json_raw(b, n, "}}]}\n\ndata: {\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n");
  nb: [32] u8; k := rp_put_int(nb[..], 0, m[0].replies); k = rp_put(nb[..], k, ".http");
  pb: [FS_PATH_MAX] u8;
  return n > 0 && fs_write(fs_join(dir, cast(string) nb[0..<k], pb[..]), cast(string) b[0..<n]);
}

// A run of task through the plan to its end: the ending, or -1 when it did not end.
as_drive :: (m: [] AsMem, journal: [] JfWriter, cwd: string, seed: bool) -> int {
  gw_plan_init(m[0].plan[..], m[0].pb[..]); m[0].plan[0].journal = journal;
  g := Gateway.{name = "fixture", url = "http://127.0.0.1:1/v1/chat/completions", wire = GW_WIRE_CHAT};
  none: [1] string;
  if !gw_plan_add(m[0].plan[..], g, "fixture-model", m[0].none[0..<0]) { return -1; }
  r := m[0].run[..];
  r[0].profile = "danger-full-access"; r[0].seed = seed; r[0].gated = false; r[0].asking = false;
  m[0].asks = 0; m[0].ask_ok = 0;
  mc_run_start(r, m[0].plan[..], m[0].bench[..], cwd, "low");
  ev: [32] McRunEvent;
  for guard: 0..<200000 {
    n := mc_run_poll(r, ev[..]);
    for i: 0..<n {
      if ev[i].kind == MR_COMMAND && ev[i].text.count > 5 && cast(string) ev[i].text[0..<5] == "ask: " { m[0].asks += 1; if ev[i].exit == 0 { m[0].ask_ok += 1; } }
      if ev[i].kind == MR_ENDED { return ev[i].ending; }
    }
    x := cxproc_sleep_ms(2);
  }
  return -1;
}

// The run's state, and one field of result k of action i in it ("" when there is none).
as_state :: (m: [] AsMem) -> string { return mc_state_json(m[0].run[0].l[0].st[..], m[0].state[..]); }
as_field :: (m: [] AsMem, j: string, i: int, k: int, name: string) -> string {
  pb: [128] u8;
  n := rp_put(pb[..], 0, "actions."); n = rp_put_int(pb[..], n, i); n = rp_put(pb[..], n, ".results."); n = rp_put_int(pb[..], n, k);
  n = rp_put(pb[..], n, "."); n = rp_put(pb[..], n, name);
  ar: [1] ClArena; ar[0] = ClArena.{buf = m[0].arena[..]};
  return cl_str(ar[..], j, cast(string) pb[0..<n]);
}
as_exit :: (j: string, i: int, k: int) -> int {
  pb: [128] u8;
  n := rp_put(pb[..], 0, "actions."); n = rp_put_int(pb[..], n, i); n = rp_put(pb[..], n, ".results."); n = rp_put_int(pb[..], n, k); n = rp_put(pb[..], n, ".exit");
  v := cl_int(j, cast(string) pb[0..<n]);
  return ifx v.ok then v.value else -99;
}
as_str :: (m: [] AsMem, j: string, path: string) -> string { ar: [1] ClArena; ar[0] = ClArena.{buf = m[0].arena[..]}; return cl_str(ar[..], j, path); }
as_file :: (m: [] AsMem, cwd: string, name: string) -> string {
  pb: [FS_PATH_MAX] u8;
  n := fs_read(fs_join(cwd, name, pb[..]), m[0].line[..]);
  return cast(string) m[0].line[0..<ifx n < 0 then 0 else n];
}
// A command in the scratch folder, for the fixture.
as_sh :: (cwd: string, cmd: string) -> bool {
  o: [1] McOutput;
  return mc_run_command(cwd, cmd, 60, o[..]).exit == 0;
}

// A new run in m: mc_init, then the modes. What mc_aw_start says.
as_begin :: (m: [] AsMem, task: string, intel: bool, memory: bool, coax: string, mem: string, cwd: string) -> string {
  mc_init(m[0].run[0].l[..], m[0].sb[..], m[0].lb[..], "{\"os\":\"Linux\"}", task, "{\"local_work\":0.9}", 0.9);
  if !intel && !memory { m[0].run[0].aw = m[0].aw[0..<0]; return ""; }
  why := mc_aw_start(m[0].aw[..], m[0].run[0].l[..], m[0].lb[..], intel, memory, coax, mem, cwd, "danger-full-access");
  m[0].run[0].aw = ifx why.count == 0 then m[0].aw[..] else m[0].aw[0..<0];
  return why;
}

as_child :: (dir: string, coax: string) -> int {
  mb: [1] AsMem; m := mb[..];
  wb: [FS_PATH_MAX] u8; rb: [FS_PATH_MAX] u8; eb: [FS_PATH_MAX] u8; ob: [FS_PATH_MAX] u8; pb: [FS_PATH_MAX] u8; jb: [FS_PATH_MAX] u8; cb: [FS_PATH_MAX] u8;
  made := fs_mkdir(fs_join(dir, "ws", pb[..])) && fs_mkdir(fs_join(dir, "replies", pb[..])) && fs_mkdir(fs_join(dir, "other", pb[..]));
  cwd := fs_realpath(fs_join(dir, "ws", pb[..]), wb[..]);
  replies := fs_join(dir, "replies", rb[..]); mem := fs_join(dir, "mem", eb[..]); other := fs_realpath(fs_join(dir, "other", pb[..]), ob[..]);
  if !made || cwd.count == 0 || other.count == 0 { tool_errln("aware selftest: no scratch folder"); return 1; }
  part: [1024] u8; np := rp_put(part[..], 0, AS_PART_HEAD); np = rp_put(part[..], np, AS_EDGE); np = rp_put(part[..], np, AS_PART_TAIL);
  ok := fs_write(fs_join(cwd, "shapes.coax", pb[..]), AS_SHAPES) && fs_write(fs_join(cwd, "clock.coax", pb[..]), AS_CLOCK) && fs_write(fs_join(cwd, "part.coax", pb[..]), cast(string) part[0..<np]);
  ok = ok && fs_write(fs_join(cwd, "main.coax", pb[..]), AS_MAIN) && fs_write(fs_join(cwd, "bad.coax", pb[..]), AS_BAD) && fs_write(fs_join(cwd, "tagged.coax", pb[..]), AS_TAGGED) && fs_write(fs_join(cwd, "test.sh", pb[..]), AS_TEST);
  ok = ok && as_sh(cwd, "git init -q && git add -A && git -c user.email=t@example.com -c user.name=t commit -qm fixture");
  if !ok { tool_errln("aware selftest: could not write the fixture"); return 1; }
  print("aware selftest: workspace %, compiler %\n", cwd, coax);
  journal: [1] JfWriter;
  if !jf_open(journal[..], fs_join(dir, "live.ajr", jb[..])) { tool_errln("aware selftest: no journal"); return 1; }
  defer jf_close(journal[..]);
  // the hashes the scripted model names: the file's as a view gives it, a declaration's as show gives it
  h1: [IX_HASH] u8; h2: [IX_HASH] u8; h3: [IX_HASH] u8;
  hs := ix_hash12(ix_hash(AS_SHAPES, h1[..])); ha := ix_hash12(ix_hash(AS_AREA, h2[..])); he := ix_hash12(ix_hash(AS_EDGE, h3[..]));
  b := m[0].reply[..];

  // ---- A: no mode
  ok = as_reply(m, replies, "{\"rationale\":\"look\",\"notes\":[\"a note\"],\"edits\":[],\"questions\":[\"defines area\"],\"commands\":[],\"view\":[\"shapes.coax:1-1\",\"shapes.coax:1-1\"],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}");
  ok = ok && as_reply(m, replies, AS_DONE) && jf_context(journal[..], "run A");
  why := as_begin(m, AS_TASK_A, false, false, coax, mem, cwd);
  req := mc_request(m[0].run[0].l[..]);
  as_check(m, ok && why == "" && req.system == MC_SYSTEM && req.schema == MC_SCHEMA && m[0].run[0].aw.count == 0, "A: with no mode the run has no McAware and sends MC_SYSTEM and MC_SCHEMA", req.schema);
  ending := as_drive(m, journal[..], cwd, false);
  j := as_state(m);
  as_check(m, ending == MC_END_FINISHED && !as_has(j, "\"memory\"") && !as_has(j, "file hash") && !as_has(j, "already read") && !as_has(j, "ask: ") && !as_has(j, "note: "), "A: the state has no memory key, no hash, no repeat line, and the reply's questions and notes are not run", j);
  as_check(m, as_field(m, j, 0, 0, "content") == "     1\t// shapes\n[lines 1-1 of 5; next: view shapes.coax:2-301]" && as_field(m, j, 0, 1, "content") == as_field(m, j, 0, 0, "content"), "A: a view, and the same view again, are the tools' text and nothing else", as_field(m, j, 0, 1, "content"));
  as_check(m, m[0].run[0].l[0].steps == 2 && m[0].run[0].l[0].finish_refused == 0 && !fs_exists(mem), "A: the finish is taken though the task's check never ran, and no memory folder is made", j);

  // ---- B: both modes, seeded
  ok = as_reply(m, replies, "{\"rationale\":\"ask the compiler\",\"notes\":[],\"edits\":[],\"questions\":[\"defines area\",\"defines nosuch\",\"uses area\",\"exports shapes.coax\",\"show area\",\"check bad.coax\",\"check part.coax\",\"explain E0325\",\"vocab rp_put\",\"effects main.coax timed\",\"depends main.coax\",\"defines safe\",\"where is area\",\"check ../x.coax\"],\"commands\":[\"sh test.sh\"],\"view\":[\"shapes.coax:1-3\"],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}");
  ok = ok && as_reply(m, replies, "{\"rationale\":\"a stale edit\",\"notes\":[\"shapes.coax:4-4 area multiplies w by h\",\"a guess with no file\"],\"edits\":[{\"path\":\"shapes.coax\",\"old\":\"return s.w * s.h;\",\"new\":\"return s.h * s.w;\",\"seen\":\"000000000000\",\"name\":\"\"}],\"questions\":[],\"commands\":[],\"view\":[\"shapes.coax:2-3\"],\"finished\":true,\"reply\":\"done\",\"ask\":\"none\"}");
  n := json_raw(b, 0, "{\"rationale\":\"fix\",\"notes\":[],\"edits\":[{\"path\":\"shapes.coax\",\"old\":\"// shapes\",\"new\":\"// shapes and sizes\",\"seen\":\""); n = json_raw(b, n, hs);
  n = json_raw(b, n, "\",\"name\":\"\"},{\"path\":\"shapes.coax\",\"old\":\"\",\"new\":\"area :: (s: Shape) -> int {\\n  return s.h * s.w;\\n}\",\"seen\":\""); n = json_raw(b, n, ha);
  n = json_raw(b, n, "\",\"name\":\"area\"},{\"path\":\"part.coax\",\"old\":\"\",\"new\":\"edge :: (s: Shape) -> int {\\n  return 0;\\n}\",\"seen\":\"000000000000\",\"name\":\"edge\"},{\"path\":\"part.coax\",\"old\":\"\",\"new\":\"edge :: (s: Shape) -> int {\\n  return 2 * (s.w + s.h);\\n}\",\"seen\":\""); n = json_raw(b, n, he);
  n = json_raw(b, n, "\",\"name\":\"edge\"}],\"questions\":[\"check shapes.coax\"],\"commands\":[],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}");
  ok = ok && n > 0 && as_reply(m, replies, cast(string) b[0..<n]);
  ok = ok && as_reply(m, replies, AS_DONE);
  ok = ok && as_reply(m, replies, "{\"rationale\":\"break the clock, run the check\",\"notes\":[],\"edits\":[{\"path\":\"clock.coax\",\"old\":\"return cx_now() + 1;\",\"new\":\"return \\\"now\\\";\",\"seen\":\"\",\"name\":\"\"}],\"questions\":[],\"commands\":[\"sh test.sh\"],\"view\":[\"shapes.coax:4-6\"],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}");
  ok = ok && as_reply(m, replies, "{\"rationale\":\"done\",\"notes\":[\"sh test.sh passes\"],\"edits\":[],\"questions\":[],\"commands\":[],\"view\":[],\"finished\":true,\"reply\":\"area is h * w; sh test.sh passes\",\"ask\":\"none\"}");
  ok = ok && jf_context(journal[..], "run B");
  why = as_begin(m, AS_TASK_B, true, true, coax, mem, cwd);
  req = mc_request(m[0].run[0].l[..]);
  as_check(m, ok && why == "" && req.schema == MC_SCHEMA_AWARE && as_has(req.system, "The Coax compiler answers questions") && as_has(req.system, "You have a working memory.") && cast(string) req.system[0..<MC_SYSTEM.count] == MC_SYSTEM, "B: both modes set up: the schema and the system prompt gain their parts", why);
  as_check(m, as_has(req.messages[0].text, "\"actions\":[],\"memory\":{\"findings\":\"\",\"changed\":\"\",\"open\":\"\"},\"notes\":\"\"}"), "B: the first state has the memory key, empty, after actions and before notes", req.messages[0].text);
  ending = as_drive(m, journal[..], cwd, true);
  j = as_state(m);
  l := m[0].run[0].l[..]; aw := m[0].aw[..];
  as_check(m, ending == MC_END_FINISHED && l[0].reply == "area is h * w; sh test.sh passes" && l[0].steps == 6 && json_valid(j), "B: the run ends with the finish given after the check passed", j);
  // the seeded step (action 0): the files the task names, each with the file's hash
  v := as_field(m, j, 0, 0, "content");
  hl: [64] u8; nh := rp_put(hl[..], 0, "\n[file hash "); nh = rp_put(hl[..], nh, hs); nh = rp_put(hl[..], nh, "]");
  as_check(m, as_field(m, j, 0, 0, "view") == "shapes.coax" && as_has(v, "     4\tarea :: (s: Shape) -> int { return s.w * s.h; }\n") && as_has(v, cast(string) hl[0..<nh]) && v.count > nh && cast(string) v[v.count - nh..<v.count] == cast(string) hl[0..<nh] && !as_has(v, "already read"), "B: the seeded view of a file ends with the file's hash, the first 12 hex digits of its SHA-256", v);
  // action 1: the questions, then the command, then the view
  v = as_field(m, j, 1, 0, "output");
  as_check(m, as_field(m, j, 1, 0, "command") == "ask: defines area" && as_exit(j, 1, 0) == 0 && as_has(v, "proc area  shapes.coax:4-4  exported  file "), "defines: kind, file, lines and the file's hash, as a result named ask:", v);
  v = as_field(m, j, 1, 1, "output");
  as_check(m, as_exit(j, 1, 1) == 0 && v == "none: no .coax file under the root names it\n", "defines of a name nothing declares: answered, none", v);
  v = as_field(m, j, 1, 2, "output");
  as_check(m, as_exit(j, 1, 2) == 0 && as_has(v, "main.coax:4:") && as_has(v, "  in proc total") && as_has(v, "shapes.coax:5:41  in #test \"area of a unit square\"") && as_has(v, "[1 files that name it were not checked"), "uses: each place with what it is written in, and the files not checked counted", v);
  v = as_field(m, j, 1, 3, "output");
  as_check(m, as_exit(j, 1, 3) == 0 && as_has(v, "struct Shape  shapes.coax:2-2") && as_has(v, "const UNIT  shapes.coax:3-3"), "exports: what a file declares", v);
  v = as_field(m, j, 1, 4, "output");
  sl: [400] u8; ns := rp_put(sl[..], 0, "[already read at step 1: these lines have not changed since]\nshapes.coax:4-4  proc area  hash "); ns = rp_put(sl[..], ns, ha); ns = rp_put(sl[..], ns, "  file hash "); ns = rp_put(sl[..], ns, hs);
  ns = rp_put(sl[..], ns, "\n     4\tarea :: (s: Shape) -> int { return s.w * s.h; }\n");
  as_check(m, as_exit(j, 1, 4) == 0 && v == cast(string) sl[0..<ns], "show: one declaration numbered, its hash and the file's; the seeded step had read the lines, and it says so", v);
  v = as_field(m, j, 1, 5, "output");
  as_check(m, as_exit(j, 1, 5) == 0 && as_has(v, "check: 2 diagnostics\n") && as_has(v, "E0325") && as_has(v, "'x' is string but is initialized with int"), "check: a file's diagnostics", v);
  v = as_field(m, j, 1, 6, "output");
  as_check(m, as_exit(j, 1, 6) == 0 && v == "check (through main.coax, which loads it): clean\n", "check of a part goes through the file that loads it", v);
  v = as_field(m, j, 1, 7, "output");
  as_check(m, as_exit(j, 1, 7) == 0 && as_has(v, "E0325") && as_has(v, "initializer"), "explain: what a code means", v);
  v = as_field(m, j, 1, 8, "output");
  as_check(m, as_field(m, j, 1, 8, "command") == "ask: vocab rp_put" && ((as_exit(j, 1, 8) == 0 && as_has(v, "rp_put")) || (as_exit(j, 1, 8) == 1 && as_has(v, "no answer: the compiler could not answer vocab rp_put: ") && as_has(v, "Use git grep and view for this."))), "vocab: what a name is (outside an openagents checkout the compiler has no answer, and the result says so)", v);
  vocab_no := ifx as_exit(j, 1, 8) == 1 then 1 else 0;
  v = as_field(m, j, 1, 9, "output");
  as_check(m, as_exit(j, 1, 9) == 0 && as_has(v, "timed: foreign_call at clock.coax:1:1 by timed -> stamp (clock.coax:2) -> cx_now (clock.coax:1)\n"), "effects: a procedure's effect and the path that reaches it", v);
  v = as_field(m, j, 1, 10, "output");
  as_check(m, as_exit(j, 1, 10) == 0 && as_has(v, "area") && as_has(v, "shapes.coax") && as_has(v, "stamp"), "depends: the declarations a file uses from other files", v);
  v = as_field(m, j, 1, 11, "output");
  as_check(m, as_exit(j, 1, 11) == 1 && as_has(v, "no answer: the compiler could not answer defines safe: E0911") && as_has(v, ". Use git grep and view for this."), "a question the compiler can't answer (a program with a tagged value): exit 1, no answer, why, and what to use", v);
  v = as_field(m, j, 1, 12, "output");
  as_check(m, as_exit(j, 1, 12) == 2 && as_has(v, "not a question (no such question): where is area. The questions are: defines NAME, uses NAME [FILE]"), "a line that is no question: exit 2 and the forms", v);
  v = as_field(m, j, 1, 13, "output");
  as_check(m, as_exit(j, 1, 13) == 1 && v == "not asked: the path leaves the working directory: ../x.coax", "a question about a file outside the working directory is not asked", v);
  as_check(m, as_field(m, j, 1, 14, "command") == "sh test.sh" && as_exit(j, 1, 14) == 1, "the step's command runs after its questions (the task's check, failing)", as_field(m, j, 1, 14, "command"));
  v = as_field(m, j, 1, 15, "content");
  as_check(m, as_field(m, j, 1, 15, "view") == "shapes.coax:1-3" && as_has(v, "[already read at step 1: these lines have not changed since]\n     1\t// shapes\n") && as_has(v, cast(string) hl[0..<nh]), "a view of lines the seeded step read starts with the line of a repeat read, and ends with the hash", v);
  // action 2: the notes, a stale edit, a repeat read
  as_check(m, as_field(m, j, 2, 0, "command") == "note: shapes.coax:4-4 area multiplies w by h" && as_field(m, j, 2, 0, "output") == "noted F0, about shapes.coax:4-4" && as_field(m, j, 2, 1, "output") == "noted F1" && as_exit(j, 2, 1) == 0, "notes are findings: one about lines of a file, one with no source", as_field(m, j, 2, 0, "output"));
  v = as_field(m, j, 2, 2, "failed");
  st: [200] u8; nst := rp_put(st[..], 0, "stale: the file is not what you read: its hash is "); nst = rp_put(st[..], nst, hs); nst = rp_put(st[..], nst, " now, not 000000000000. Nothing was written.");
  as_check(m, as_field(m, j, 2, 2, "edit") == "shapes.coax" && as_has(v, cast(string) st[0..<nst]) && as_has(as_field(m, j, 2, 2, "nearest"), "     4\tarea :: (s: Shape) -> int { return s.w * s.h; }\n"), "an edit that names a hash the file does not have is refused as stale, with the hash now and the nearest lines", v);
  as_check(m, as_has(as_field(m, j, 2, 3, "content"), "[already read at step 1: these lines have not changed since]\n     2\tShape :: struct"), "a second repeat read names the step of the first read", as_field(m, j, 2, 3, "content"));
  // action 3: an exact edit by the file's hash, a declaration by name, a stale one, a part's
  v = as_field(m, j, 3, 0, "now");
  as_check(m, as_field(m, j, 3, 0, "applied") == "" && as_has(j, "{\"edit\":\"shapes.coax\",\"applied\":true,\"lines\":\"1-3\",\"now\":\"     1\\t// shapes and sizes\\n") && as_has(v, "\n[file hash ") && !as_has(v, "check"), "an exact edit that names the file's hash is applied; its result gives the new hash, and the check waits for the file's last edit of the step", v);
  v = as_field(m, j, 3, 1, "now");
  as_check(m, as_has(v, "replaced proc area: lines 4-6  hash ") && as_has(v, "\n     5\t  return s.h * s.w;\n     6\t}\n[file hash ") && as_has(v, "]\ncheck: clean\n"), "a declaration replaced by name and the hash show gave: its new lines and hash, the file's hash, and the check", v);
  v = as_field(m, j, 3, 2, "failed");
  se: [200] u8; nse := rp_put(se[..], 0, "stale: edge is not what you read: its hash is "); nse = rp_put(se[..], nse, he); nse = rp_put(se[..], nse, " now (the file's is ");
  as_check(m, as_has(v, cast(string) se[0..<nse]) && as_has(v, "Nothing was written.") && as_has(as_field(m, j, 3, 2, "nearest"), "     3\t  return 2 * (s.w + s.h) + area(s) * 0;\n"), "a declaration replace with a hash that is not the text's is refused as stale, with the lines as they are", v);
  v = as_field(m, j, 3, 3, "now");
  as_check(m, as_has(v, "replaced proc edge: lines 2-4  hash ") && as_has(v, "check (through main.coax, which loads it): clean\n") && as_has(as_file(m, cwd, "part.coax"), "\n  return 2 * (s.w + s.h);\n}\nflat"), "a part's declaration is replaced and checked through its loader", v);
  as_check(m, as_field(m, j, 3, 4, "command") == "ask: check shapes.coax" && as_field(m, j, 3, 4, "output") == "check: clean\n", "a check question in the same step sees the step's edits", as_field(m, j, 3, 4, "output"));
  as_check(m, as_file(m, cwd, "shapes.coax") == AS_SHAPES_DONE, "the edits are in the file, and the stale ones are not", as_file(m, cwd, "shapes.coax"));
  // action 4: the finish refused; action 5: a breaking edit, the check, a view; action 6: the finish accepted
  notes := as_str(m, j, "notes");
  as_check(m, notes == "finished was refused (1 of at most 2 refusals): a check the task names has not passed on the files as they are now.\nOpen:\ncheck sh test.sh: check's latest run failed: sh test.sh\nRun it again and finish when it passes. If it can't pass, say why in reply.\n" && l[0].finish_refused == 1, "a finish while the task's check fails is refused with what is open; the next one, after the check passed, is accepted", notes);
  v = as_field(m, j, 5, 0, "now");
  as_check(m, as_has(v, "[file hash ") && as_has(v, "\ncheck: ") && as_has(v, "error E0") && as_has(v, "clock.coax:2:"), "an edit that breaks the type check is written and comes back with the diagnostic", v);
  as_check(m, as_field(m, j, 5, 1, "command") == "sh test.sh" && as_exit(j, 5, 1) == 0 && as_has(as_field(m, j, 5, 2, "content"), "     4\tarea :: (s: Shape) -> int {\n") && !as_has(as_field(m, j, 5, 2, "content"), "already read"), "the check passes after the edits; lines an edit wrote read as new", as_field(m, j, 5, 2, "content"));
  as_check(m, as_field(m, j, 6, 0, "output") == "noted F2" && cl_count(cl_raw(j, "actions")) == 7, "the finishing step's note is kept", as_field(m, j, 6, 0, "output"));
  // as_str gives each answer in one arena, so each is looked at before the next is asked
  mem_ok := as_str(m, j, "memory.findings") == "Findings (current):\nF1 guess: a guess with no file []\n";
  mch := as_str(m, j, "memory.changed");
  mem_ok = mem_ok && as_has(mch, "Changes:\nC0 shapes.coax 1-1 ") && as_has(mch, "\nC1 shapes.coax 4-6 ") && as_has(mch, "\nC2 part.coax 3-3 ") && as_has(mch, "\nC3 clock.coax 2-2 ");
  mem_ok = mem_ok && as_str(m, j, "memory.open") == "";
  as_check(m, mem_ok, "the last state's memory: the finding whose file changed has left, every edit is listed, nothing is open", cl_raw(j, "memory"));
  as_check(m, cast(string) j[j.count - 10..<j.count] != "" && ps_find(j, "\"memory\":{") > ps_find(j, "\"actions\":[") && ps_find(j, "\"notes\":\"finished was refused") > ps_find(j, "\"memory\":{"), "the memory key stands after actions and before notes", "");
  rep: [4096] u8;
  line := mc_aw_report(aw, l, rep[..]);
  want: [512] u8; nw := rp_put(want[..], 0, "{\"kind\":\"aware\",\"intel\":{\"asked\":13,\"unanswered\":"); nw = rp_put_int(want[..], nw, 1 + vocab_no);
  nw = rp_put(want[..], nw, ",\"stale_edits\":2,\"defines\":3,\"uses\":1,\"exports\":1,\"show\":1,\"check\":3,\"explain\":1,\"vocab\":1,\"effects\":1,\"depends\":1},\"memory\":{\"dir\":");
  as_check(m, as_has(line, cast(string) want[0..<nw]) && as_has(line, "\"reads\":6,\"repeat_reads\":3,\"notes\":3,\"finishes_refused\":1,\"checks\":1,\"runs\":2,\"changes\":4,\"unproven\":[]}}") && json_valid(line), "the report: questions asked and not answered, stale edits, each question's count, reads and repeats, notes, refusals, and nothing unproven", line);
  print("%\n", line);
  as_check(m, m[0].asks == 15 && m[0].ask_ok == 12 - vocab_no, "each question is given out as a command event named ask:, with its exit (15 asked in all, 3 or 4 of them with no answer)", "");
  // the journal: questions are reads (view intents), edits and commands are effects
  nb := fs_read(fs_join(dir, "live.ajr", jb[..]), m[0].journal[..]);
  rec: AfState; at := 0; views := 0; effects := 0; context := 0; good := nb > 0;
  while good && at < nb {
    x := aj_read(rec.chain, m[0].journal[at..<nb]);
    if !x.ok { good = false; break; }
    if x.kind == AjKind.context { context += 1; views = 0; effects = 0; }
    if x.kind == AjKind.view_intent { views += 1; }
    if x.kind == AjKind.command_intent { effects += 1; }
    move := af_recover(rec, m[0].journal[at..<at + x.consumed]);
    if !move.ok { good = false; break; }
    rec = move.state; at += x.consumed;
  }
  as_check(m, good && context == 2 && views == 20 && effects == 8, "the journal of run B: 20 reads (5 views, 15 questions) and 8 effects (6 edits, 2 commands)", "");

  // ---- C: the memory alone, on B's folder
  ok = as_reply(m, replies, "{\"rationale\":\"look\",\"notes\":[],\"edits\":[],\"commands\":[],\"view\":[\"shapes.coax:4-6\"],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}");
  ok = ok && as_reply(m, replies, "{\"rationale\":\"edit\",\"notes\":[],\"edits\":[{\"path\":\"shapes.coax\",\"old\":\"// shapes and sizes\",\"new\":\"// shapes, again\"}],\"commands\":[],\"view\":[],\"finished\":true,\"reply\":\"one\",\"ask\":\"none\"}");
  done_c := "{\"rationale\":\"done\",\"notes\":[],\"edits\":[],\"commands\":[],\"view\":[],\"finished\":true,\"reply\":\"three\",\"ask\":\"none\"}";
  ok = ok && as_reply(m, replies, done_c) && as_reply(m, replies, done_c) && as_reply(m, replies, done_c) && jf_context(journal[..], "run C");
  why = as_begin(m, AS_TASK_C, false, true, coax, mem, cwd);
  req = mc_request(m[0].run[0].l[..]);
  as_check(m, ok && why == "" && as_has(req.system, "You have a working memory.") && !as_has(req.system, "The Coax compiler") && as_has(req.schema, "\"notes\"") && !as_has(req.schema, "questions") && !as_has(req.schema, "seen"), "C: the memory alone: its section and its member, and none of the compiler's", why);
  as_check(m, as_has(req.messages[0].text, "\"memory\":{\"findings\":\"Findings (current):\\nF1 guess: a guess with no file []\\nF2 guess: sh test.sh passes []\\n\",\"changed\":\"Changes:\\nC0 shapes.coax 1-1 "), "C: a memory opened again shows what the earlier run left, in the first state", req.messages[0].text);
  ending = as_drive(m, journal[..], cwd, false);
  j = as_state(m);
  v = as_field(m, j, 0, 0, "content");
  as_check(m, as_has(j, "{\"edit\":\"shapes.coax\",\"applied\":true") && !as_has(j, "file hash") && as_has(v, "[already read in an earlier run: these lines have not changed since]\n     4\tarea :: (s: Shape) -> int {\n"), "C: an edit is the plain one with no hash; lines the earlier run read are a repeat, and the view says so", v);
  notes = as_str(m, j, "notes");
  as_check(m, as_has(notes, "finished was refused (1 of at most 2 refusals)") && as_has(notes, "check sh test.sh: check passed before the tree changed; run it again: sh test.sh\n") && as_has(notes, "finished was refused (2 of at most 2 refusals)"), "C: a check that passed before an edit is open again, and the finish is refused twice", notes);
  as_check(m, ending == MC_END_FINISHED && l[0].reply == "three" && l[0].finish_refused == 2 && l[0].steps == 5, "C: after two refusals the finish stands", j);
  line = mc_aw_report(aw, l, rep[..]);
  as_check(m, as_has(line, "\"reads\":1,\"repeat_reads\":1,\"notes\":0,\"finishes_refused\":2,") && as_has(line, "\"unproven\":[\"check sh test.sh: check passed before the tree changed; run it again: sh test.sh\"]}}") && !as_has(line, "\"intel\""), "C: the report says what was unproven", line);
  print("%\n", line);
  why = as_begin(m, AS_TASK_C, false, true, coax, mem, other);
  as_check(m, why == "that memory is of another folder: give another session or memory_dir" && m[0].run[0].aw.count == 0 && !m[0].run[0].l[0].memory, "C: a memory of another folder is refused, and the run has no mode", why);
  why = as_begin(m, AS_TASK_C, false, true, coax, "", cwd);
  as_check(m, why == "the memory has no folder: give memory_dir, or a session", "C: the memory needs a folder", why);

  // ---- D: the compiler alone, and no compiler
  ok = as_reply(m, replies, "{\"rationale\":\"ask\",\"edits\":[{\"path\":\"shapes.coax\",\"old\":\"\",\"new\":\"area :: () {}\",\"seen\":\"000000000000\",\"name\":\"area\"},{\"path\":\"note.txt\",\"old\":\"\",\"new\":\"a note\\n\",\"seen\":\"\",\"name\":\"\"}],\"questions\":[\"defines area\"],\"commands\":[],\"view\":[\"note.txt\"],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}");
  ok = ok && as_reply(m, replies, "{\"rationale\":\"done\",\"edits\":[],\"questions\":[],\"commands\":[],\"view\":[],\"finished\":true,\"reply\":\"done\",\"ask\":\"none\"}") && jf_context(journal[..], "run D");
  why = as_begin(m, AS_TASK_C, true, false, "/nonexistent/coax", mem, cwd);
  ending = as_drive(m, journal[..], cwd, false);
  j = as_state(m);
  as_check(m, ok && why == "" && ending == MC_END_FINISHED && l[0].steps == 2 && !as_has(j, "\"memory\""), "D: the compiler alone: no memory key, and a finish is not held though the task's check is open", j);
  as_check(m, as_has(as_field(m, j, 0, 0, "failed"), "no Coax compiler answers here, so a declaration can't be replaced by name") && as_field(m, j, 0, 2, "output") == "no answer: the compiler could not answer defines area: no Coax compiler answers here. Use git grep and view for this." && as_exit(j, 0, 2) == 1, "D: with no compiler a question has no answer and says why, and a replace by name fails with words", as_field(m, j, 0, 2, "output"));
  v = as_field(m, j, 0, 3, "content");
  as_check(m, as_has(as_field(m, j, 0, 1, "now"), "     1\ta note\n[file hash ") && !as_has(as_field(m, j, 0, 1, "now"), "check") && as_has(v, "     1\ta note\n[file hash ") && !as_has(v, "already read") && as_file(m, cwd, "shapes.coax") == "// shapes, again\nShape :: struct { w: int; h: int; }\nUNIT :: 1;\narea :: (s: Shape) -> int {\n  return s.h * s.w;\n}\n#test \"area of a unit square\" { #assert area(Shape.{w = UNIT, h = UNIT}) == 1; }\n", "D: a new file is written with its hash and no check, and a view has the hash and no repeat line", v);
  line = mc_aw_report(aw, l, rep[..]);
  as_check(m, line == "{\"kind\":\"aware\",\"intel\":{\"asked\":1,\"unanswered\":1,\"stale_edits\":0,\"defines\":1,\"uses\":0,\"exports\":0,\"show\":0,\"check\":0,\"explain\":0,\"vocab\":0,\"effects\":0,\"depends\":0}}", "D: the report has the compiler's part only", line);

  // ---- E: the run may not weaken what checks it: a command deletes a #test in a file the run never viewed (its baseline is git's)
  ok = as_reply(m, replies, "{\"rationale\":\"tidy\",\"notes\":[],\"edits\":[],\"questions\":[],\"commands\":[\"sed -i '/#test/d' shapes.coax\"],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}");
  ok = ok && as_reply(m, replies, "{\"rationale\":\"done\",\"notes\":[],\"edits\":[],\"questions\":[],\"commands\":[],\"view\":[],\"finished\":true,\"reply\":\"one\",\"ask\":\"none\"}");
  ok = ok && as_reply(m, replies, "{\"rationale\":\"done\",\"notes\":[],\"edits\":[],\"questions\":[],\"commands\":[],\"view\":[],\"finished\":true,\"reply\":\"two\",\"ask\":\"none\"}");
  ok = ok && as_reply(m, replies, "{\"rationale\":\"done\",\"notes\":[],\"edits\":[],\"questions\":[],\"commands\":[],\"view\":[],\"finished\":true,\"reply\":\"three\",\"ask\":\"none\"}") && jf_context(journal[..], "run E");
  why = as_begin(m, "Tidy shapes.coax.", false, true, coax, mem, cwd);
  ending = as_drive(m, journal[..], cwd, false);
  j = as_state(m);
  notes = as_str(m, j, "notes");
  as_check(m, ok && why == "" && as_has(notes, "finished was refused (1 of at most 2 refusals): the run weakened what checks it") && as_has(notes, "file shapes.coax: fewer checks (#test, #forall) than when the run started; put them back: 1 then, 0 now\n") && as_has(notes, "finished was refused (2 of at most 2 refusals)") && as_has(notes, "so that a person can decide."), "E: a run that deletes a #test with a shell command is refused the finish, with the file and its checks then and now", notes);
  line = mc_aw_report(aw, l, rep[..]);
  as_check(m, ending == MC_END_FINISHED && l[0].reply == "three" && l[0].finish_refused == 2 && as_has(line, "\"unproven\":[") && as_has(line, "\"file shapes.coax: fewer checks (#test, #forall) than when the run started; put them back: 1 then, 0 now\"]}}"), "E: after two refusals the finish stands, and the report's unproven names the weakened file for a person", line);

  // ---- F: a run that reads for 12 steps and changes nothing is told once to make its first edit
  ok = true;
  for i: 0..<13 { ok = ok && as_reply(m, replies, "{\"rationale\":\"read\",\"notes\":[],\"edits\":[],\"questions\":[],\"commands\":[],\"view\":[\"shapes.coax\"],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}"); }
  ok = ok && as_reply(m, replies, "{\"rationale\":\"done\",\"notes\":[],\"edits\":[],\"questions\":[],\"commands\":[],\"view\":[],\"finished\":true,\"reply\":\"read\",\"ask\":\"none\"}") && jf_context(journal[..], "run F");
  fb: [FS_PATH_MAX] u8; memf := fs_join(dir, "mem-f", fb[..]);
  why = as_begin(m, "Read shapes.coax.", false, true, coax, memf, cwd);
  ending = as_drive(m, journal[..], cwd, false);
  notes = as_str(m, as_state(m), "notes");
  first := ps_find(notes, "You have taken 12 steps and changed nothing.");
  as_check(m, ok && why == "" && ending == MC_END_FINISHED && first >= 0 && ps_find(cast(string) notes[first + 10..<notes.count], "You have taken 12 steps") < 0 && aw[0].nudged, "F: twelve steps with no change bring one note to make the first edit", notes);

  // ---- G: two edits of one file in one action both name the hash read before the action; an 8-digit hash is too short
  gtext := "alpha\nbeta\ngamma\n";
  gp: [FS_PATH_MAX] u8; ok = fs_write(fs_join(cwd, "g.txt", gp[..]), gtext);
  ghb: [IX_HASH] u8; gh := ix_hash12(ix_hash(gtext, ghb[..]));
  gb: [2048] u8;
  gn := json_raw(gb[..], 0, "{\"rationale\":\"two edits\",\"notes\":[],\"edits\":[{\"path\":\"g.txt\",\"old\":\"alpha\",\"new\":\"ALPHA\",\"seen\":\""); gn = json_raw(gb[..], gn, gh);
  gn = json_raw(gb[..], gn, "\",\"name\":\"\"},{\"path\":\"g.txt\",\"old\":\"gamma\",\"new\":\"GAMMA\",\"seen\":\""); gn = json_raw(gb[..], gn, gh);
  gn = json_raw(gb[..], gn, "\",\"name\":\"\"},{\"path\":\"g.txt\",\"old\":\"beta\",\"new\":\"BETA\",\"seen\":\""); gn = json_raw(gb[..], gn, cast(string) gh[0..<8]);
  gn = json_raw(gb[..], gn, "\",\"name\":\"\"}],\"questions\":[],\"commands\":[],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}");
  ok = ok && gn > 0 && as_reply(m, replies, cast(string) gb[0..<gn]);
  ok = ok && as_reply(m, replies, AS_DONE) && jf_context(journal[..], "run G");
  why = as_begin(m, "Capitalise g.txt.", true, false, coax, mem, cwd);
  ending = as_drive(m, journal[..], cwd, false);
  j = as_state(m);
  g3 := as_field(m, j, 0, 2, "failed");
  as_check(m, ok && why == "" && ending == MC_END_FINISHED && as_file(m, cwd, "g.txt") == "ALPHA\nbeta\nGAMMA\n" && aw[0].stale_edits == 1, "G: a second edit of a file in the same action, naming the hash read before it, applies", as_file(m, cwd, "g.txt"));
  as_check(m, as_has(g3, "too short: seen needs the hash's first 12 hex digits"), "G: a hash of 8 digits is refused as too short, with the hash to give", g3);

  print("aware selftest: % passed, % failed\n", m[0].pass, m[0].fail);
  if m[0].fail == 0 { print("aware selftest: ok\n"); return 0; }
  return 1;
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  if !args_load(args[..]) { return 2; }
  if args[0].n == 3 && args_at(args[..], 0) == "--child" { return as_child(args_at(args[..], 1), args_at(args[..], 2)); }
  cb: [FS_PATH_MAX] u8;
  coax := fs_realpath("coax/bin/coax", cb[..]);
  if args[0].n == 2 && args_at(args[..], 0) == "--coax" { coax = args_at(args[..], 1); }
  if coax.count == 0 { tool_errln("aware selftest: no compiler: run it from the checkout's root, or pass --coax PATH"); return 1; }
  tb: [1024] u8; dir := fs_temp("mc-aware-", tb[..]);
  if dir.count == 0 { tool_errln("aware selftest: no temporary folder"); return 1; }
  defer { gone := fs_remove(dir); }
  sb: [FS_PATH_MAX] u8; self := tool_self(sb[..]);
  h := cxproc_new();
  if h < 0 { return 1; }
  env: [1300] u8; n := json_raw(env[..], 0, "GW_REPLAY="); n = json_raw(env[..], n, dir); n = json_raw(env[..], n, "/replies");
  ok := n > 0 && mc_proc_arg(h, CL_FIELD_ARG, self) && mc_proc_arg(h, CL_FIELD_ARG, "--child") && mc_proc_arg(h, CL_FIELD_ARG, dir) && mc_proc_arg(h, CL_FIELD_ARG, coax) && mc_proc_arg(h, CL_FIELD_ENV, cast(string) env[0..<n]);
  if !ok || cxproc_spawn(h) != 0 { x := cxproc_release(h); tool_errln("aware selftest: could not start itself"); return 1; }
  closed := cxproc_close_stdin(h);
  line: [65536] u8;
  while true {
    k := cxproc_read_line(h, 600000);
    if k == CL_EOF { break; }
    if k < 0 { continue; }
    m := ifx k < line.count then k else line.count;
    for i: 0..<m { line[i] = cast(u8) cxproc_line_byte(h, i); }
    print("%\n", cast(string) line[0..<m]);
  }
  status := cxproc_wait(h, 5000);
  err: [8192] u8; ne := cxproc_stderr_count(h);
  if ne > err.count { ne = err.count; }
  for i: 0..<ne { err[i] = cast(u8) cxproc_stderr_byte(h, i); }
  if status != 0 { tool_errln(cast(string) err[0..<ne]); }
  released := cxproc_release(h);
  return status;
}
