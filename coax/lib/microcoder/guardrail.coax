// Defense-in-depth shell guardrail for shared primary git checkouts (GitHub #13758).
// When cwd is inside a primary git checkout (.git is a directory, not a worktree .git file),
// blocks destructive working-tree mutations that clobber concurrent chats:
//   - git stash (except read-only git stash list / git stash show)
//   - git pull ... --autostash
//   - git reset --hard
//   - git checkout -- .
//   - git restore .

#load "../sys/fs.coax";

MC_GUARD_MSG :: "blocked: destructive git working-tree command is not allowed in a shared primary checkout (.git directory). Create or switch to an isolated git worktree/branch instead (GitHub #13758).";

// Returns true when cwd (or an ancestor directory) has a .git directory (primary checkout),
// and false when .git is a file (linked worktree) or cwd is not in a git repo.
mc_is_primary_checkout :: (cwd: string) -> bool #effects(all) {
  if cwd.count == 0 { return false; }
  cur := cwd;
  pb: [1024] u8;
  for _: 0..<64 {
    dot := fs_join(cur, ".git", pb[..]);
    if dot.count > 0 {
      k := fs_kind(dot);
      if k == FS_DIR { return true; }
      if k == FS_FILE { return false; }
    }
    // Walk up one parent directory
    n := cur.count;
    while n > 1 && cur[n - 1] == '/' { n -= 1; }
    slash := -1;
    for i: 0..<n { if cur[i] == '/' { slash = i; } }
    if slash <= 0 { return false; }
    cur = cast(string) cur[0..<slash];
  }
  return false;
}

mc_guard_ws :: (c: u8) -> bool {
  return c == ' ' || c == '\t' || c == '\r';
}

mc_guard_sep :: (c: u8) -> bool {
  return c == ';' || c == '\n' || c == '|' || c == '&';
}

// Reads the next whitespace-delimited token from s starting at *pos, stopping at shell separators.
// Strips simple single/double quotes around the token.
mc_guard_tok :: (s: string, pos: [] int, buf: [] u8) -> string {
  i := pos[0];
  while i < s.count && mc_guard_ws(s[i]) { i += 1; }
  if i >= s.count || mc_guard_sep(s[i]) { pos[0] = i; return ""; }
  n := 0;
  q: u8 = 0;
  while i < s.count {
    c := s[i];
    if q == 0 {
      if mc_guard_ws(c) || mc_guard_sep(c) { break; }
      if c == '\'' || c == '"' { q = c; i += 1; continue; }
    } else {
      if c == q { q = 0; i += 1; continue; }
    }
    if n < buf.count { buf[n] = c; n += 1; }
    i += 1;
  }
  pos[0] = i;
  return cast(string) buf[0..<n];
}

// Checks a single shell command segment (between ;, &&, ||, |, newline) for destructive git mutations.
mc_guard_segment :: (s: string, pos: [] int) -> bool {
  tb: [128] u8;
  // Skip leading env assignments (FOO=bar) and wrappers like env/command/sudo
  cmd := "";
  for _: 0..<32 {
    t := mc_guard_tok(s, pos, tb[..]);
    if t.count == 0 { return false; }
    // Check if env var assignment VAR=val
    has_eq := false;
    for j: 0..<t.count {
      if t[j] == '=' && j > 0 { has_eq = true; break; }
    }
    if has_eq { continue; }
    if t == "env" || t == "command" || t == "sudo" { continue; }
    cmd = t;
    break;
  }
  // Match "git" or path ending in "/git"
  is_git := cmd == "git";
  if !is_git && cmd.count >= 4 {
    if cmd[cmd.count - 4] == '/' && cmd[cmd.count - 3] == 'g' && cmd[cmd.count - 2] == 'i' && cmd[cmd.count - 1] == 't' {
      is_git = true;
    }
  }
  if !is_git { return false; }

  // Parse git global options until subcommand
  sub := "";
  sub_buf: [64] u8;
  for _: 0..<32 {
    t := mc_guard_tok(s, pos, tb[..]);
    if t.count == 0 { return false; }
    if t == "-C" || t == "-c" || t == "--git-dir" || t == "--work-tree" || t == "--namespace" {
      // Skip option argument
      _ = mc_guard_tok(s, pos, tb[..]);
      continue;
    }
    if t.count > 0 && t[0] == '-' { continue; }
    n := t.count;
    if n > sub_buf.count { n = sub_buf.count; }
    for j: 0..<n { sub_buf[j] = t[j]; }
    sub = cast(string) sub_buf[0..<n];
    break;
  }
  if sub.count == 0 { return false; }

  if sub == "stash" {
    // Allow read-only `git stash list` and `git stash show`
    arg := mc_guard_tok(s, pos, tb[..]);
    if arg == "list" || arg == "show" { return false; }
    return true;
  }

  if sub == "pull" {
    for _: 0..<64 {
      arg := mc_guard_tok(s, pos, tb[..]);
      if arg.count == 0 { break; }
      if arg == "--autostash" { return true; }
    }
    return false;
  }

  if sub == "reset" {
    for _: 0..<64 {
      arg := mc_guard_tok(s, pos, tb[..]);
      if arg.count == 0 { break; }
      if arg == "--hard" { return true; }
    }
    return false;
  }

  if sub == "checkout" {
    saw_dashdash := false;
    for _: 0..<64 {
      arg := mc_guard_tok(s, pos, tb[..]);
      if arg.count == 0 { break; }
      if arg == "--" { saw_dashdash = true; continue; }
      if saw_dashdash && (arg == "." || arg == "./") { return true; }
    }
    return false;
  }

  if sub == "restore" {
    for _: 0..<64 {
      arg := mc_guard_tok(s, pos, tb[..]);
      if arg.count == 0 { break; }
      if arg == "--" { continue; }
      if arg.count > 0 && arg[0] == '-' { continue; }
      if arg == "." || arg == "./" { return true; }
    }
    return false;
  }

  return false;
}

// Returns true if command contains a destructive git working-tree mutation.
mc_command_is_destructive_git :: (command: string) -> bool {
  pos := [1] int.[0];
  while pos[0] < command.count {
    if mc_guard_segment(command, pos[..]) { return true; }
    // Advance past remaining tokens in this segment to the next separator
    while pos[0] < command.count && !mc_guard_sep(command[pos[0]]) { pos[0] += 1; }
    while pos[0] < command.count && mc_guard_sep(command[pos[0]]) { pos[0] += 1; }
  }
  return false;
}

// Returns the guardrail error message if command is blocked in cwd, or "" if allowed.
mc_guard_command :: (cwd: string, command: string) -> string #effects(all) {
  if !mc_command_is_destructive_git(command) { return ""; }
  if !mc_is_primary_checkout(cwd) { return ""; }
  return MC_GUARD_MSG;
}

#test "guardrail detects destructive git commands" {
  #assert mc_command_is_destructive_git("git stash");
  #assert mc_command_is_destructive_git("git stash push -m wip");
  #assert mc_command_is_destructive_git("git stash pop");
  #assert mc_command_is_destructive_git("git stash drop");
  #assert mc_command_is_destructive_git("git stash clear");
  #assert mc_command_is_destructive_git("git -C /tmp/repo stash");
  #assert mc_command_is_destructive_git("git pull --rebase --autostash");
  #assert mc_command_is_destructive_git("git pull --autostash origin main");
  #assert mc_command_is_destructive_git("git reset --hard");
  #assert mc_command_is_destructive_git("git reset --hard HEAD~1");
  #assert mc_command_is_destructive_git("git checkout -- .");
  #assert mc_command_is_destructive_git("git checkout -- ./");
  #assert mc_command_is_destructive_git("git restore .");
  #assert mc_command_is_destructive_git("git restore --worktree .");
  #assert mc_command_is_destructive_git("git restore -- .");
  #assert mc_command_is_destructive_git("echo hi && git stash");
  #assert mc_command_is_destructive_git("git status; git reset --hard");
  #assert mc_command_is_destructive_git("/usr/bin/git stash");
}

#test "guardrail allows safe git commands" {
  #assert !mc_command_is_destructive_git("git status");
  #assert !mc_command_is_destructive_git("git diff");
  #assert !mc_command_is_destructive_git("git stash list");
  #assert !mc_command_is_destructive_git("git stash show");
  #assert !mc_command_is_destructive_git("git stash show -p");
  #assert !mc_command_is_destructive_git("git pull --rebase");
  #assert !mc_command_is_destructive_git("git pull origin main");
  #assert !mc_command_is_destructive_git("git reset --soft HEAD~1");
  #assert !mc_command_is_destructive_git("git reset HEAD file.txt");
  #assert !mc_command_is_destructive_git("git checkout -b feat/foo");
  #assert !mc_command_is_destructive_git("git checkout -- path/to/file.swift");
  #assert !mc_command_is_destructive_git("git restore path/to/file.swift");
  #assert !mc_command_is_destructive_git("echo git stash");
}
