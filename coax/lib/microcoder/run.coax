// A Microcoder run for a frame loop (docs/coder/microcoder.md, "What the
// Lab shows"): the loop, a plan and the tools behind one poll, which hands
// back what a transcript draws: each step's attempt (gateway, model,
// status), its commands with exit codes and output, the reply as it streams
// (the next_action's "reply" text, read out of the JSON while it arrives),
// and the ending. mc_run_stop is STOP: curl goes and the run ends stopped.
//
// Infrastructure only: the Mac app's Lab and /chat call this when the
// owner asks for the wiring. Model calls never block a poll, and neither do
// commands (GitHub #13750): a poll starts a step's command, each later poll
// reads what it printed so far, and the poll that sees it end records it and
// goes on (30 s each at most, or the owner's command_seconds). So the owner
// reads its input while a command runs, and mc_run_stop kills a running
// command's process group at once.
//
// Checks: coax test coax/lib/microcoder/run.coax --library (no main of its own).

#load "tools.coax";
#load "instructions.coax";
#load "../agent/user-instructions.coax";
#load "image.coax";
#load "aware.coax";
#load "steer.coax";
#load "../gateway/plan.coax";

// ---------------------------------------------------------------- the reply as it streams

// Reads a next_action object byte by byte and hands out its top-level
// "reply" string's text as it arrives, decoded (escapes, \u with surrogate
// pairs). Other fields, nested values and keys are skipped.
McReplyStream :: struct {
  depth: int;
  in_str: bool; esc: bool;
  hex: int; nhex: int;           // a \uXXXX being read (nhex digits so far), -1 when none
  high: int;                     // a high surrogate waiting for its low half
  key: [8] u8; nk: int; key_long: bool;   // the key being read at depth 1
  is_key: bool;                  // the string being read is a key
  want_value: bool;              // after "key": at depth 1
  in_reply: bool;                // inside the reply value's string
  reply_key: bool;               // the last key was "reply"
}

mc_rs_reset :: (rs: [] McReplyStream) { rs[0] = McReplyStream.{nhex = -1}; }

mc_rs_put :: (out: [] u8, n: int, c: u8) -> int {
  if n < 0 || n >= out.count { return n; }
  out[n] = c;
  return n + 1;
}

// Feeds text; the reply's new bytes go to out; how many.
mc_rs_feed :: (rs: [] McReplyStream, text: string, out: [] u8) -> int {
  n := 0;
  for c: text {
    if rs[0].in_str {
      if rs[0].nhex >= 0 {
        d := json_hex(c);
        if d < 0 { rs[0].nhex = -1; continue; }
        rs[0].hex = rs[0].hex * 16 + d; rs[0].nhex += 1;
        if rs[0].nhex < 4 { continue; }
        cp := rs[0].hex; rs[0].nhex = -1;
        if cp >= 0xD800 && cp < 0xDC00 { rs[0].high = cp; continue; }
        if cp >= 0xDC00 && cp < 0xE000 && rs[0].high > 0 { cp = 0x10000 + ((rs[0].high - 0xD800) << 10) + (cp - 0xDC00); }
        rs[0].high = 0;
        if rs[0].in_reply { m := json_put_cp(out, n, cp); if m > 0 { n = m; } }
        continue;
      }
      if rs[0].esc {
        rs[0].esc = false;
        if c == 'u' { rs[0].nhex = 0; rs[0].hex = 0; continue; }
        e := c;
        if c == 'n' { e = 10; } else if c == 't' { e = 9; } else if c == 'r' { e = 13; } else if c == 'b' { e = 8; } else if c == 'f' { e = 12; }
        if rs[0].in_reply { n = mc_rs_put(out, n, e); }
        else if rs[0].is_key { if rs[0].nk < 8 { rs[0].key[rs[0].nk] = e; rs[0].nk += 1; } else { rs[0].key_long = true; } }
        continue;
      }
      if c == '\\' { rs[0].esc = true; continue; }
      if c == '"' {
        rs[0].in_str = false;
        if rs[0].is_key {
          rs[0].is_key = false;
          rs[0].reply_key = !rs[0].key_long && cast(string) rs[0].key[0..<rs[0].nk] == "reply";
        }
        rs[0].in_reply = false;
        continue;
      }
      if rs[0].in_reply { n = mc_rs_put(out, n, c); }
      else if rs[0].is_key { if rs[0].nk < 8 { rs[0].key[rs[0].nk] = c; rs[0].nk += 1; } else { rs[0].key_long = true; } }
      continue;
    }
    if c == '"' {
      rs[0].in_str = true;
      if rs[0].depth == 1 && !rs[0].want_value { rs[0].is_key = true; rs[0].nk = 0; rs[0].key_long = false; }
      else if rs[0].depth == 1 && rs[0].want_value { rs[0].in_reply = rs[0].reply_key; rs[0].want_value = false; }
      continue;
    }
    if c == ':' && rs[0].depth == 1 { rs[0].want_value = true; continue; }
    if c == ',' && rs[0].depth == 1 { rs[0].want_value = false; rs[0].reply_key = false; continue; }
    if c == '{' || c == '[' { if rs[0].depth == 1 && rs[0].want_value { rs[0].want_value = false; } rs[0].depth += 1; continue; }
    if c == '}' || c == ']' { rs[0].depth -= 1; continue; }
    if rs[0].depth == 1 && rs[0].want_value && c != ' ' && c != '\n' && c != '\t' && c != '\r' { rs[0].want_value = false; }
  }
  return n;
}

// ---------------------------------------------------------------- the run

MR_ATTEMPT :: 1;                 // log: an attempt of this step ended (gateway, model, status ...)
MR_REPLY :: 2;                   // text: more of the reply
MR_COMMAND :: 3;                 // text: the command; exit, timed_out, output
MR_VIEW :: 4;                    // text: the path; found
MR_STEP :: 5;                    // a step ended; step: its number
MR_ENDED :: 6;                   // ending (MC_END_*), text: the reply (finished, asked) or why (no_capacity)
MR_ASK :: 7;                     // text: a command waiting for mc_run_answer (a gated run)
MR_THOUGHT :: 9;                 // text: streamed reasoning delta for the current step (GitHub #13671)
MR_DELEGATE :: 8;                // text: the step's delegated tasks as JSON ([{"level":L,"task":T}]), waiting for mc_run_delegated
MR_STOP_AGENT :: 10;             // agent: the number of a sub-agent the step stops (a delegate with resume and stop, GitHub #13766); nothing waits on it
MR_TODOS :: 11;                  // text: the step's todo list as JSON ([{"id":I,"content":C,"status":S}])

McRunEvent :: struct {
  kind: int;
  ticket:int;
  text: string;
  log: GwAttemptLog;
  exit: int;
  timed_out: bool;
  found: bool;
  output: string;
  step: int;
  ending: int;
  agent: int;                    // MR_STOP_AGENT: the sub-agent's number
}

// Owner-owned state for dual-plan hybrid step routing (inkling-neon / hybrid-neon), driven by
// mcworker.coax between steps via McRun.defer_call so McRun stays lean for callers like engine.coax.
McHybrid :: struct {
  use_cloud: bool;
  escalated: bool;
  free_finish: bool;
  local_finish_tried: bool;
  local_steps: int;
  local_max: int;
  local_ms: int;
  began_ms: int;
  local_fails: int;
  had_edit: bool;
  step_had_edit: bool;
  step_failed: bool;
  step_views: int;
  step_cmds: int;
  cloud_cost_micros: int;
  last_cloud_micros: int;
  cloud_budget_micros: int;
  cloud_capped: bool;
}

MC_THINK :: 32768;               // the most bytes of one step's thinking a run hands out; past it the thought is cut and says so
MC_THINK_CUT :: "\n[The thinking is cut at 32,768 bytes.]";
McRun :: struct {
  l: [1] McLoop;
  p: [] GwPlan;
  bench: [] GwBench;
  cwd: string;
  effort: string;
  rs: [1] McReplyStream;
  calling: bool;
  logged: int;                   // plan log entries handed out this step
  ended: bool;
  profile:string="danger-full-access";
  ceiling:int=3;
  journal: [] JfWriter;
  deadline: int;
  unbounded: bool;               // the owner gave this run no budget: no model call, command, view or time limit ends it (GitHub #13667)
  effects: int;                  // commands and edits run (native-profile.coax NP_EFFECTS a run)
  reads: int;                    // files viewed, counted apart (NP_READS a run)
  refused: string;               // which limit refused the last effect, "" when it was not a limit
  gated: bool;                   // each command waits for mc_run_answer: the host's hooks and approvals decide
  ask_ticket:int;
  asking: bool; ask_i: int;      // the pending action's command waiting for an answer
  edits_free: bool;              // a gated run whose edits are not refused: its owner gates commands only to show each as it starts
  delegating: bool;              // asking, for the step's sub-agents' results (mc_run_delegated), not for a command
  delegated: bool;               // this step's sub-agents have answered
  command_seconds: int;          // a command's time limit; 0 is MC_COMMAND_SECONDS (an unattended owner gives more, and tells the model in the facts)
  seed: bool;                    // before the first call, look up what the task names (mc_run_seed)
  call_due: bool;                // first call deferred to the next poll (mc_run_prepare)
  seeded: bool;
  rbuf: [4096] u8;               // this poll's reply bytes
  think: [MC_THINK + 64] u8; nthink: int; think_cut: bool;   // the step's thinking so far, and whether it ran past the buffer
  obuf: [131072] u8; nob: int;   // this poll's command outputs: the tools reuse their buffer per command
  tb: [1] McToolBuffers;
  start: [64] u8; nstart: int;   // a journaled run's first commit (git rev-parse HEAD), for the commits a failed ending lists
  work: [8192] u8;               // a failed ending's text: why, the commits made, the files left (tools.coax mc_work_list)
  // Long outputs saved whole (GitHub #13325): the folder the host gives ("" for none: outputs are then
  // only cut), each command's file in it named run-step-result.txt, and the buffer a file is written from.
  spill_dir: string;
  spill_ready: bool;
  runs: int;
  spill_buf: [262144] u8;
  spill_path: [4096] u8;
  shaped: [MC_SPILL_SHOW + 4096] u8;
  // The compiler's answers and the working memory (aware.coax; GitHub #13444, #13445): the owner's
  // storage, set up with mc_aw_start after mc_init. Empty: the run has neither, and is as it was.
  aw: [] McAware;
  // Multimodal image attachments (from user message paths and image `view` calls).
  img: [1] McImageStore;
  // What the person sends while the turn runs (steer.coax; GitHub #13715): the owner's storage.
  // Empty: the run takes no steers, and is as it was.
  steers: [] McSteers;
  // The command running across polls (GitHub #13750): mc_run_one starts it, each poll reads it
  // (mc_run_cmd_poll), and what follows it once it ends is cmd_then at cmd_i.
  cmd: [1] McCommandProc;
  cmd_on: bool;
  cmd_text: string;              // the command: a pending action's, or cmd_seed
  cmd_seed: [256] u8;            // a seeded step's lookup command
  cmd_sp: string;                // where its whole output goes when long ("" for nowhere)
  cmd_began: int;
  cmd_then: int;                 // MC_THEN_*
  cmd_i: int;                    // its place: the step's command, or the seeded step's code name
  seed_begun: bool;              // the seeded step has begun in the state
  // Cache-adaptive compaction: consecutive paid cloud attempts with <25% prompt cache hits.
  // Local psionic servers (which keep 70-99% Metal/CUDA KV cache) and cached cloud endpoints stay at 0.
  low_cache_calls: int;
  // When true, the run sets call_due between steps instead of firing mc_run_call inline, letting
  // a dual-plan owner (mcworker.coax inkling-neon) swap r.p cleanly before the next model call.
  defer_call: bool;
}
MC_THEN_STEP :: 0;               // the step's next command, then its views (mc_run_commands_from)
MC_THEN_ANSWER :: 1;             // a gated run's next ask, then the views (mc_run_answered)
MC_THEN_SEED :: 2;               // the seeded step's next lookup, then the first call (mc_run_seed_names)

// The step a result recorded now belongs to: the open one, or the one about to open.
mc_run_step :: (r: [] McRun) -> int { return ifx r[0].l[0].st[0].open >= 0 then r[0].l[0].st[0].steps else r[0].l[0].st[0].steps + 1; }
// What is left of the run's time, for a compiler question.
mc_run_left :: (r: [] McRun) -> int { return r[0].deadline - cxproc_now_ms(); }

// Scans text for image file paths (including macOS screenshot paths with spaces
// and U+202F) and attaches any readable images to the run's multimodal prompt.
mc_run_attach_images_in :: (r: [] McRun, text: string) {
  scan: [1] McImageScan;
  mc_image_scan(text, scan[..]);
  for i: 0..<scan[0].n {
    // Paths explicitly referenced/pasted by the user are allowed even outside cwd.
    res := mc_image_attach(r[0].img[..], r[0].cwd, scan[0].paths[i], "danger-full-access");
    if res.ok {
      r[0].l[0].images = r[0].img[0].images[0..<r[0].img[0].n];
    }
  }
}

mc_run_attach_task_images :: (r: [] McRun) {
  mc_image_store_reset(r[0].img[..]);
  r[0].l[0].images = r[0].img[0].images[0..<0];
  mc_run_attach_images_in(r, r[0].l[0].st[0].task);
}

// A view for this run: image files are attached as multimodal parts; text files use
// mc_view_lines, or, with a mode on, aware.coax's mc_aw_view.
mc_run_view :: (r: [] McRun, entry: string, room: int) -> McViewResult {
  spec := mc_view_spec(entry);
  if mc_is_image_path(spec.path) {
    res := mc_image_attach(r[0].img[..], r[0].cwd, spec.path, r[0].profile);
    if res.ok {
      r[0].l[0].images = r[0].img[0].images[0..<r[0].img[0].n];
      note := mc_image_view_note(spec.path, res, r[0].shaped[..]);
      return McViewResult.{found = true, content = note};
    }
    return McViewResult.{found = false, content = res.why};
  }
  is_local_gw := r[0].p.count > 0 && r[0].p[0].n > 0 && r[0].p[0].attempts[0].gateway.name == "psionic";
  lim := ifx !is_local_gw && r[0].low_cache_calls >= 1 && room > 8192 then 8192 else room;
  if r[0].aw.count == 0 { return mc_view_lines(r[0].cwd, entry, r[0].profile, r[0].spill_dir, lim, r[0].tb[..]); }
  return mc_aw_view(r[0].aw, entry, r[0].spill_dir, lim, mc_run_step(r), r[0].tb[..]);
}

// Where this command's whole output goes, if it is long: spill_dir/RUN-STEP-K.txt (K its place among the
// step's results); "" when the run has no spill folder or it can't be made.
mc_run_spill_path :: (r: [] McRun) -> string {
  if r[0].spill_dir.count == 0 { return ""; }
  if !r[0].spill_ready { r[0].spill_ready = fs_mkdir(r[0].spill_dir); if !r[0].spill_ready { return ""; } }
  b := r[0].spill_path[..];
  n := mc_put(b, 0, r[0].spill_dir); n = mc_put(b, n, "/"); n = mc_put_int(b, n, r[0].runs); n = mc_put(b, n, "-");
  n = mc_put_int(b, n, r[0].l[0].st[0].steps); n = mc_put(b, n, "-"); n = mc_put_int(b, n, r[0].l[0].st[0].open_cmds + 1); n = mc_put(b, n, ".txt");
  if n >= b.count { return ""; }
  return cast(string) b[0..<n];
}

// A command's output kept for this poll's events (cut to what is left).
mc_run_keep :: (r: [] McRun, s: string) -> string {
  at := r[0].nob;
  n := s.count;
  if n > r[0].obuf.count - at { n = r[0].obuf.count - at; }
  for i: 0..<n { r[0].obuf[at + i] = s[i]; }
  r[0].nob = at + n;
  return cast(string) r[0].obuf[at..<at + n];
}

// A journaled run's time budget: 15 minutes, as long as an unattended task gets (GitHub #13231:
// at 5 minutes Argon's run of a five-file change ended mid-task as "run budget exhausted").
MC_RUN_MS :: 900000;

// Loads the person's own instructions (~/.openagents/instructions.md, or the file
// OPENAGENTS_USER_INSTRUCTIONS_PATH names: coax/lib/agent/user-instructions.coax, GitHub #13808)
// and the workspace's (AGENTS.md / agents.md, with CLAUDE.md / claude.md fallback, from cwd's repo
// hierarchy) and appends them to l's system prompt, each under its own header.
mc_run_load_instructions :: (l: [] McLoop, b: [] McLoopBuffers, cwd: string) -> bool {
  return mc_run_load_instructions_from(l, b, cwd, "");
}
MC_COAX_CUE :: "\n\nCoax syntax cue: no let/const/fn/default-args/multi-return (locals: x := val; fs_read returns bytes); tests use #test \"name\" { #assert ...; } (never #check/package); #test runs pure code at compile time (no fs/proc calls; for heavy crypto #test add #run_steps 200000; or #steps N in the file, not only CLI flags); put #import \"Basic\"; only in the entry file; ranges 0..<n; slices a[..].";
MC_SAFETY_TAIL :: "\n\nCRITICAL OVERRIDE (supersedes any commit/push instructions above): NEVER run git commit or git push unless the user's task message itself explicitly asks you to commit or push. Once edits are verified and checks pass, finish immediately with finished:true.";

// The same with the user instructions read from user_path ("" for this process's file). They go
// first and have their own budget (UINSTR_MAX_BYTES), so a large AGENTS.md never crowds them out;
// the workspace's get what is left of the system prompt's buffer, up to MC_INSTR_MAX_BYTES.
mc_run_load_instructions_from :: (l: [] McLoop, b: [] McLoopBuffers, cwd: string, user_path: string) -> bool {
  ub: [UINSTR_BLOCK_BYTES] u8;
  user := uinstr_load(user_path, "\n\n", ub[..]);
  ok := mc_instructions(l, b, user);
  if cwd.count == 0 { return ok; }
  room := b[0].system.count - l[0].system.count;
  if room > MC_INSTR_MAX_BYTES { room = MC_INSTR_MAX_BYTES; }
  if room <= MC_INSTR_HEADER.count + 64 { return false; }
  ib: [MC_INSTR_MAX_BYTES] u8;
  text := mc_instructions_load(cwd, ib[0..<room]);
  if text.count > 0 { ok = mc_instructions(l, b, text) && ok; }
  // Append the tiny Coax syntax cue only inside Coax repositories (zero overhead elsewhere).
  cpb: [FS_PATH_MAX] u8;
  spec := fs_join(cwd, "coax/spec.md", cpb[..]);
  if spec.count > 0 && fs_exists(spec) {
    _ = mc_instructions(l, b, MC_COAX_CUE);
  }
  _ = mc_instructions(l, b, MC_SAFETY_TAIL);
  return ok;
}

// Sets up a run of the loop in r.l (mc_init) through plan p without firing the first model call
// yet: the next poll fires it when call_due is true. Callers that both start and poll a run in
// the same procedure (the Lab's lab_pump) use this so mc_run_call's retained stores are not
// carried twice into the caller's summary (checker 256-store limit, #13791, #13779).
mc_run_prepare :: (r: [] McRun, p: [] GwPlan, bench: [] GwBench, cwd: string, effort: string) {
  if r[0].cmd_on { mc_cmd_stop(r[0].cmd[..]); x := mc_cmd_result(r[0].cmd[..], r[0].tb[0].out[..]); r[0].cmd_on = false; }
  r[0].p = p; r[0].bench = bench; r[0].cwd = cwd; r[0].effort = effort; r[0].ended = false;
  r[0].journal=p[0].journal;r[0].deadline=0;now:=cxproc_now_ms();if now>=0 && now<=9223372036854475807 {r[0].deadline=now+MC_RUN_MS;}r[0].effects=0;r[0].reads=0;r[0].refused="";
  r[0].seeded = false;
  r[0].call_due = !r[0].seed;
  r[0].nstart = 0;
  r[0].low_cache_calls = 0;
  r[0].runs += 1;
  if r[0].journal.count > 0 { r[0].nstart = mc_git_head(cwd, r[0].profile, r[0].tb[0].out[..], r[0].start[..]).count; }
  mc_run_attach_task_images(r);
  mc_window(r[0].l[..], mc_plan_window(p));       // the state's budgets from the model's window (GitHub #13730)
}

// Starts a run of the loop already set up in r.l (mc_init) through plan p
// (gw_plan_add its attempts first); effort "" leaves it to the provider.
mc_run_start :: (r: [] McRun, p: [] GwPlan, bench: [] GwBench, cwd: string, effort: string) {
  mc_run_prepare(r, p, bench, cwd, effort);
  if r[0].call_due { r[0].call_due = false; mc_run_call(r); }       // a seeded run's first poll looks things up, then calls
}

// The smallest context window of the plan's attempts, in tokens (gateway card.coax gw_window): a
// request goes to each in turn, so it must fit each. 0 when any attempt's model is unknown: the
// state then keeps its constant budgets.
mc_plan_window :: (p: [] GwPlan) -> int {
  w := 0;
  for i: 0..<p[0].n {
    t := gw_window(p[0].attempts[i].model);
    // Local 32K servers (llama-server/psionic) average ~3.5 B/tok on code and keep full Metal/CUDA KV
    // cache; mc_budget's pessimistic 2.25 B/tok + 16 KB memory reserve would otherwise thrash compaction
    // at ~11K tokens every 3 steps. Use 57344 effective window (~24K tokens peak, <32K) while mc_too_long guards overflow.
    if p[0].attempts[i].gateway.name == "psionic" && (t <= 0 || t == 32768) { t = 57344; }
    if t <= 0 { return 0; }
    if w == 0 || t < w { w = t; }
  }
  return w;
}

// The seeded first step (GitHub #13325; loop.coax mc_seed_scan): before the first call, the
// files the task mentions that exist under the working directory are viewed (the first
// MC_SEED_FILES of them, anchored around the first mentioned code name when the file is large),
// and each code name it mentions is looked up (git grep, its first 6 lines; in a git checkout only).
// Workspace instruction files (AGENTS.md/CLAUDE.md) are skipped because mc_run_load_instructions
// already puts them in the system prompt.
MC_SEED_FILES :: 4;
MC_SEED_GREP_MAX :: 4;           // cap step-0 symbol greps so multi-symbol prompts stay lean
MC_SEED_BUDGET :: 8192;          // step-0 budget so up to 4 anchored target snippets fit cleanly
MC_SEED_SHARE_MAX :: 3200;       // bytes per seeded file, at most
MC_SEED_ANCHOR_MIN :: 80;        // files longer than this center their seed view on a matched task symbol
MC_LOW_CACHE_LOG :: 10240;       // when paid cloud cache hits stay <25%, compact steps older than latest 2 past this log size
MC_LOW_CACHE_HEAVY :: 28672;     // past this log size on low-cache paid cloud, keep only the latest step verbatim
MC_LOW_CACHE_KEEP :: 4096;       // target recent bytes when compacting older steps on low-cache paid cloud gateways

mc_seed_is_instr :: (p: string) -> bool {
  base := fs_base(p);
  return base == "AGENTS.md" || base == "agents.md" || base == "CLAUDE.md" || base == "claude.md";
}

mc_seed_is_skip :: (p: string) -> bool {
  if mc_seed_is_instr(p) { return true; }
  if p.count >= 9 && cast(string) p[0..<9] == "coax/bin/" { return true; }
  if mc_cmd_ends(p, ".png") || mc_cmd_ends(p, ".jpg") || mc_cmd_ends(p, ".jpeg") || mc_cmd_ends(p, ".gif") || mc_cmd_ends(p, ".webp") || mc_cmd_ends(p, ".pdf") || mc_cmd_ends(p, ".o") || mc_cmd_ends(p, ".a") || mc_cmd_ends(p, ".so") || mc_cmd_ends(p, ".dylib") || mc_cmd_ends(p, ".gguf") || mc_cmd_ends(p, ".bin") || mc_cmd_ends(p, ".zip") || mc_cmd_ends(p, ".gz") { return true; }
  return false;
}

mc_seed_is_guard_macro :: (nm: string) -> bool {
  return nm == "__APPLE__" || nm == "__linux__" || nm == "_WIN32" || nm == "__unix__" || nm == "__MACH__";
}

mc_seed_find_word :: (text: string, nm: string) -> int {
  if nm.count < 3 || nm.count > text.count { return -1; }
  i := 0;
  while i + nm.count <= text.count {
    if text[i] == nm[0] && cast(string) text[i..<i + nm.count] == nm {
      left_ok := i == 0 || !mc_seed_word_ch(text[i - 1]);
      right_ok := i + nm.count == text.count || !mc_seed_word_ch(text[i + nm.count]);
      if left_ok && right_ok { return i; }
    }
    i += 1;
  }
  return -1;
}

// First 1-based line in text where a code name in names[0..<nn] appears as a word, or 0 when none.
// Follows prompt symbol order and prefers non-macro symbols past line 15 so a top-of-file #ifdef
// (e.g. __APPLE__) does not mask the target function later in the file.
mc_seed_anchor_line :: (text: string, names: [] string, nn: int) -> int {
  if nn <= 0 || text.count == 0 { return 0; }
  fallback := 0;
  for k: 0..<nn {
    nm := names[k];
    if mc_seed_is_guard_macro(nm) { continue; }
    at := mc_seed_find_word(text, nm);
    if at >= 0 {
      line := mc_line_at(text, at);
      if line > 15 { return line; }
      if fallback == 0 { fallback = line; }
    }
  }
  for k: 0..<nn {
    nm := names[k];
    if !mc_seed_is_guard_macro(nm) { continue; }
    at := mc_seed_find_word(text, nm);
    if at >= 0 {
      line := mc_line_at(text, at);
      if line > 15 { return line; }
      if fallback == 0 { fallback = line; }
    }
  }
  return fallback;
}
mc_seed_word_ch :: (c: u8) -> bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

// Formats a ranged view entry "p:A-B" into out when a file is >MC_SEED_ANCHOR_MIN lines and contains
// one of the task's code names at line L; otherwise returns p unchanged.
mc_seed_entry :: (p: string, text: string, names: [] string, nn: int, out: [] u8) -> string {
  lines := rp_lines(text);
  if lines <= MC_SEED_ANCHOR_MIN { return p; }
  at := mc_seed_anchor_line(text, names, nn);
  if at <= 15 { return p; }
  from := at - 15;
  to := at + 50;
  if to > lines { to = lines; }
  n := mc_put(out, 0, p);
  n = mc_put(out, n, ":");
  n = mc_put_int(out, n, from);
  n = mc_put(out, n, "-");
  n = mc_put_int(out, n, to);
  if n >= out.count { return p; }
  return cast(string) out[0..<n];
}

MC_HYBRID_LOCAL_DEFAULT_STEPS :: 3;
MC_HYBRID_LOCAL_DEFAULT_MS :: 70000;

mc_hybrid_init :: (h: [] McHybrid, max_steps: int, max_ms: int, free_finish: bool, now_ms: int) {
  h[0] = McHybrid.{
    local_max = ifx max_steps > 0 then max_steps else MC_HYBRID_LOCAL_DEFAULT_STEPS,
    local_ms = ifx max_ms > 0 then max_ms else MC_HYBRID_LOCAL_DEFAULT_MS,
    free_finish = free_finish,
    began_ms = now_ms,
  };
}

// Whether an escalated hybrid run can hand the final closing summary turn back to free local Inkling.
mc_hybrid_ready_finish :: (l: [] McLoop, h: [] McHybrid) -> bool {
  if !h[0].escalated || !h[0].free_finish || h[0].local_finish_tried { return false; }
  if h[0].step_failed || h[0].step_views > 0 { return false; }
  verified := l[0].check[0].state == MC_CHECK_PASSED || (h[0].had_edit && h[0].step_cmds > 0);
  if !verified { return false; }
  if l[0].st[0].nmem > 0 && ps_count(cast(string) l[0].st[0].mem[0..<l[0].st[0].nmem], "\"open\":\"\"") == 0 { return false; }
  return true;
}

// Decides whether the next model call runs on cloud (returns true) or free local (returns false).
// Called only by a dual-plan owner (mcworker.coax) before firing a deferred step call.
mc_hybrid_select :: (l: [] McLoop, h: [] McHybrid, now_ms: int) -> bool {
  if !h[0].escalated {
    if h[0].step_failed { h[0].local_fails += 1; }
    else if h[0].local_steps > 0 { h[0].local_fails = 0; }
    over_steps := h[0].local_steps >= h[0].local_max;
    over_time := h[0].local_steps >= 1 && h[0].local_ms > 0 && now_ms - h[0].began_ms >= h[0].local_ms;
    bad_local := l[0].bad >= 1;
    failed_local := h[0].step_failed && h[0].local_fails >= 2;
    if over_steps || over_time || bad_local || failed_local {
      h[0].escalated = true;
      h[0].use_cloud = true;
      l[0].bad = 0;
      if l[0].st[0].nlog > 24576 && l[0].st[0].nacts > 2 {
        mc_compact_keep_steps(l[0].st[..], 10240, 2);
      }
      mc_note(l[0].st[..], "Escalated from local scout to frontier model. Use the files/errors already gathered above without re-reading unchanged lines, apply the remaining surgical fix, verify, and finish promptly.");
    } else {
      h[0].use_cloud = false;
      h[0].local_steps += 1;
    }
  } else if mc_hybrid_ready_finish(l, h) {
    h[0].local_finish_tried = true;
    h[0].use_cloud = false;
    // Compact older history to keep the local closing turn tiny (~3K tokens, 3-6s) and focused on emitting finished:true.
    if l[0].st[0].nacts > 1 { mc_compact_keep_steps(l[0].st[..], 2048, 1); }
    mc_note(l[0].st[..], "ALL REQUIRED VERIFICATION CHECKS ALREADY PASSED. Do NOT call any tools (edits=[], commands=[], view=[]). Emit finished:true with a concise 1-sentence summary reply NOW.");
  } else if h[0].cloud_budget_micros > 0 && (h[0].cloud_cost_micros >= h[0].cloud_budget_micros * 75 / 100 || h[0].cloud_cost_micros + (ifx h[0].last_cloud_micros > 45000 then h[0].last_cloud_micros else 45000) >= h[0].cloud_budget_micros * 95 / 100) {
    h[0].use_cloud = false;
    if !h[0].cloud_capped {
      h[0].cloud_capped = true;
      mc_note(l[0].st[..], "Cloud budget reserve reached ($0 local mode). If edits and verification checks already passed above, emit finished:true immediately with no tools; otherwise finish the smallest remaining fix and verify.");
    }
  } else {
    h[0].use_cloud = true;
  }
  h[0].step_had_edit = false;
  h[0].step_failed = false;
  h[0].step_views = 0;
  h[0].step_cmds = 0;
  return h[0].use_cloud;
}

// Records observed cache hit rate for cache-adaptive compaction on paid cloud gateways.
mc_run_note_cache :: (r: [] McRun, lg: GwAttemptLog) {
  if lg.outcome != GW_OUT_DONE || lg.gateway == "psionic" { return; }
  if lg.input_tokens < 2048 { return; }
  cached := ifx (lg.usage.observed & 4) != 0 then lg.usage.cached_tokens else 0;
  if cached * 4 < lg.input_tokens { r[0].low_cache_calls += 1; }
  else { r[0].low_cache_calls = 0; }
}

mc_run_seed :: (r: [] McRun, out: [] McRunEvent) -> int {
  r[0].seeded = true; r[0].nob = 0;
  l := r[0].l[..]; k := 0;
  s: [1] McSeed; mc_seed_scan(l[0].st[0].task, s[..]);
  pb: [FS_PATH_MAX] u8; eb: [FS_PATH_MAX + 32] u8; viewed := 0; begun := false;
  // the files that exist share the seed budget, less room for the code names' lines
  files := 0;
  for i: 0..<s[0].np {
    p := s[0].paths[i];
    if mc_seed_is_skip(p) { continue; }
    full := fs_join(r[0].cwd, p, pb[..]);
    if files < MC_SEED_FILES && full.count > 0 && fs_kind(full) == FS_FILE { files += 1; }
  }
  share := ifx files > 0 then (MC_SEED_BUDGET - 768 * s[0].nn) / files else 0;
  if share < 1600 { share = 1600; }
  if share > MC_SEED_SHARE_MAX { share = MC_SEED_SHARE_MAX; }
  for i: 0..<s[0].np {
    if viewed >= MC_SEED_FILES { break; }
    p := s[0].paths[i];
    if mc_seed_is_skip(p) { continue; }
    full := fs_join(r[0].cwd, p, pb[..]);
    if full.count == 0 || fs_kind(full) != FS_FILE { continue; }
    entry := p;
    if s[0].nn > 0 {
      nread := fs_read_at(full, 0, r[0].tb[0].src[..]);
      if nread > 0 { entry = mc_seed_entry(p, cast(string) r[0].tb[0].src[0..<nread], s[0].names[..], s[0].nn, eb[..]); }
    }
    if !mc_run_intent(r, AjKind.view_intent, entry) { return mc_run_failed(r, out, k); }
    room := ifx begun then mc_result_room(l[0].st[..], entry) else MC_SEED_BUDGET - 96;
    if room > share { room = share; }
    v := mc_run_view(r, entry, room);
    if r[0].journal.count>0 && (!jf_output(r[0].journal,v.content) || !jf_result(r[0].journal,ifx v.found then "found=true" else "found=false")) {return mc_run_failed(r,out,k);}
    if !v.found || v.content == MC_VIEW_BINARY { continue; }
    if !begun { mc_action_begin(l[0].st[..], MC_SEED_RATIONALE); begun = true; }
    mc_view(l, entry, true, v.content);
    k = mc_run_put(out, k, McRunEvent.{kind = MR_VIEW, text = mc_run_keep(r, entry), found = true});
    viewed += 1;
  }
  r[0].seed_begun = begun;
  return mc_run_seed_names(r, out, k, 0);
}
// The seeded step's code names from the from'th on, each looked up by a command; a command that
// runs on past this poll comes back here when it ends (MC_THEN_SEED). Then the first call.
mc_run_seed_names :: (r: [] McRun, out: [] McRunEvent, k0: int, from: int) -> int {
  l := r[0].l[..]; k := k0;
  s: [1] McSeed; mc_seed_scan(l[0].st[0].task, s[..]);
  pb: [FS_PATH_MAX] u8;
  git := fs_join(r[0].cwd, ".git", pb[..]);
  if git.count > 0 && fs_exists(git) {
    lim_n := ifx s[0].nn < MC_SEED_GREP_MAX then s[0].nn else MC_SEED_GREP_MAX;
    for i: from..<lim_n {
      cb := r[0].cmd_seed[..];
      n := json_raw(cb, 0, "git grep -n -w -F -e "); n = json_raw(cb, n, s[0].names[i]); n = json_raw(cb, n, " | head -n 6");
      if n < 0 { continue; }
      if !r[0].seed_begun { mc_action_begin(l[0].st[..], MC_SEED_RATIONALE); r[0].seed_begun = true; }
      r[0].cmd_then = MC_THEN_SEED; r[0].cmd_i = i;
      k = mc_run_one(r, out, k, cast(string) cb[0..<n]);
      if r[0].ended || r[0].cmd_on { return k; }
    }
  }
  if r[0].seed_begun { mc_action_end(l[0].st[..]); r[0].seed_begun = false; }
  if r[0].defer_call { r[0].call_due = true; } else { mc_run_call(r); }
  return k;
}

mc_run_call :: (r: [] McRun) {
  if r[0].journal.count>0 && !r[0].unbounded && !np_budget(true,r[0].l[0].steps,cxproc_now_ms(),r[0].deadline) {
    r[0].l[0].ending=MC_END_FAILED;r[0].l[0].why=mc_run_limit(MC_LIMIT_CALL,r[0].l[0].steps,cxproc_now_ms(),r[0].deadline);return;
  }
  mc_run_drain(r, "");
  is_local_gw := r[0].p.count > 0 && r[0].p[0].n > 0 && r[0].p[0].attempts[0].gateway.name == "psionic";
  // Cache-adaptive rolling compaction: ONLY for paid cloud gateways delivering <25% prompt cache hits
  // (never for local psionic, which preserves full Metal/CUDA KV cache!).
  // Keep 2 recent steps verbatim up to 28 KB so multi-file context is preserved without re-reads.
  if !is_local_gw && r[0].low_cache_calls >= 1 {
    if r[0].l[0].st[0].nlog > MC_LOW_CACHE_HEAVY && r[0].l[0].st[0].nacts >= 2 {
      mc_compact_keep_steps(r[0].l[0].st[..], MC_LOW_CACHE_KEEP, 1);
    } else if r[0].l[0].st[0].nlog > MC_LOW_CACHE_LOG && r[0].l[0].st[0].nacts > 2 {
      mc_compact_keep_steps(r[0].l[0].st[..], MC_LOW_CACHE_KEEP, 2);
    }
  }
  if r[0].aw.count > 0 && r[0].aw[0].memory { mc_aw_render(r[0].aw, r[0].l[..]); x := mc_aw_nudge(r[0].aw, r[0].l[..]); }     // the state's memory key, as the store is now; a long read with no edit is told to edit
  req := mc_request(r[0].l[..]);
  if r[0].effort.count > 0 { req.effort = r[0].effort; }
  if is_local_gw && req.max_tokens == 0 { req.max_tokens = 4096; }
  mc_rs_reset(r[0].rs[..]);
  r[0].nthink = 0; r[0].think_cut = false;
  r[0].logged = 0;
  gw_plan_start(r[0].p, r[0].bench, req);
  r[0].calling = true;
}

mc_run_put :: (out: [] McRunEvent, n: int, e: McRunEvent) -> int {
  if n >= out.count { return n; }
  out[n] = e;
  return n + 1;
}

mc_run_logs :: (r: [] McRun, out: [] McRunEvent, k: int) -> int {
  n := k;
  while r[0].logged < r[0].p[0].nlog && n < out.count {
    lg := r[0].p[0].log[r[0].logged];
    mc_run_note_cache(r, lg);
    n = mc_run_put(out, n, McRunEvent.{kind = MR_ATTEMPT, log = lg});
    r[0].logged += 1;
  }
  return n;
}

mc_run_end :: (r: [] McRun, out: [] McRunEvent, k: int) -> int {
  r[0].ended = true;
  l := r[0].l[..];
  if r[0].aw.count > 0 { mc_aw_close(r[0].aw); }      // what the memory still has open, for the run's report
  if r[0].journal.count>0 && !r[0].journal[0].flow.chain.failed && r[0].journal[0].flow.phase!=AfPhase.closed {
    if !jf_stop(r[0].journal,mc_ending_name(l[0].ending)) {l[0].ending=MC_END_FAILED;l[0].why="durable stop failed; inspect the journal before retrying";}
  }
  // A journaled run that ends failed (a limit, or the journal) lists what it leaves (GitHub #13351).
  if l[0].ending == MC_END_FAILED && r[0].journal.count > 0 {
    l[0].why = mc_work_list(r[0].cwd, cast(string) r[0].start[0..<r[0].nstart], r[0].profile, r[0].tb[0].out[..], l[0].why, r[0].work[..]);
  }
  text := ifx l[0].ending == MC_END_NO_CAPACITY || l[0].ending==MC_END_FAILED then l[0].why else l[0].reply;
  return mc_run_put(out, k, McRunEvent.{kind = MR_ENDED, ending = l[0].ending, text = text});
}

// What happened since the last poll (give out 16 or more). Model calls
// never block; a step's commands run here when the step asks for them.
mc_run_poll :: (r: [] McRun, out: [] McRunEvent) -> int {
  h := mc_run_hear(r, out);
  return ifx h.tools then mc_run_aware(r, out, h.k) else h.k;
}
// mc_run_poll for a run without a mode (no aware.coax state: the Lab's, agent/engine/microcoder.coax).
// The same poll; only its steps are mc_run_plain's, so the units that run plain Microcoder (the
// desktop chat) do not carry aware.coax's retained stores into every caller's summary, which took
// dsk_frame past the checker's 256 (#13588).
mc_run_poll_plain :: (r: [] McRun, out: [] McRunEvent) -> int {
  h := mc_run_hear(r, out);
  return ifx h.tools then mc_run_plain(r, out, h.k) else h.k;
}
// What a poll heard: k events given out, and whether a step's tools wait to run (mc_run_aware).
McHeard :: struct { k: int; tools: bool; }
mc_run_hear :: (r: [] McRun, out: [] McRunEvent) -> McHeard {
  if r[0].ended || r[0].asking { return McHeard.{}; }
  if r[0].cmd_on { return McHeard.{k = mc_run_cmd_poll(r, out)}; }
  if r[0].l[0].ending==MC_END_FAILED {return McHeard.{k = mc_run_end(r,out,0)};}
  if r[0].seed && !r[0].seeded { return McHeard.{k = mc_run_seed(r, out)}; }
  if r[0].call_due { r[0].call_due = false; mc_run_call(r); return McHeard.{}; }
  if r[0].journal.count>0 && !r[0].unbounded && cxproc_now_ms()>=r[0].deadline {gw_plan_stop(r[0].p);r[0].refused="time limit reached: a run has 15 minutes";return McHeard.{k = mc_run_failed(r,out,0)};}
  ev: [8] GwEvent;
  n := gw_plan_poll(r[0].p, r[0].bench, ev[..]);
  if r[0].journal.count>0 && r[0].journal[0].flow.chain.failed {return McHeard.{k = mc_run_failed(r,out,0)};}
  return mc_run_heard(r, out, ev[0..<n]);
}
// The model's events since the last poll: the reply as it streams, the plan's log, and, when a
// reply is whole, the finish, the next call, or the step's tools waiting.
mc_run_heard :: (r: [] McRun, out: [] McRunEvent, ev: [] GwEvent) -> McHeard {
  l := r[0].l[..];
  k := 0;
  status := MC_WAIT;
  rn := 0; rb := r[0].rbuf[..];
  tn := 0;
  for e: ev {
    if e.kind == GW_EV_TEXT { rn += mc_rs_feed(r[0].rs[..], e.text, rb[rn..<rb.count]); }
    // Stream each step's reasoning tokens immediately as they arrive (capped at MC_THINK bytes/step, UTF-8 safe).
    if e.kind == GW_EV_REASONING {
      room := MC_THINK - r[0].nthink;
      if room > 0 {
        take := ifx e.text.count <= room then e.text.count else room;
        while take > 0 && take < e.text.count && e.text[take] >= 128 && e.text[take] < 192 { take -= 1; }
        for bi: 0..<take { if tn < r[0].think.count { r[0].think[tn] = e.text[bi]; tn += 1; } }
        r[0].nthink += take;
      }
      if e.text.count > room && !r[0].think_cut {
        r[0].nthink = MC_THINK;
        r[0].think_cut = true;
        for cc: MC_THINK_CUT { if tn < r[0].think.count { r[0].think[tn] = cc; tn += 1; } }
      }
    }
    status = mc_feed(l, e);
  }
  if tn > 0 { k = mc_run_put(out, k, McRunEvent.{kind = MR_THOUGHT, text = cast(string) r[0].think[0..<tn]}); }
  if rn > 0 { k = mc_run_put(out, k, McRunEvent.{kind = MR_REPLY, text = cast(string) rb[0..<rn]}); }
  k = mc_run_logs(r, out, k);
  if l[0].todos_dirty {
    l[0].todos_dirty = false;
    k = mc_run_put(out, k, McRunEvent.{kind = MR_TODOS, text = cast(string) l[0].todos[0..<l[0].ntodos]});
  }
  if status == MC_WAIT { return McHeard.{k = k}; }
  r[0].calling = false;
  r[0].nthink = 0; r[0].think_cut = false;
  r[0].nob = 0;
  r[0].delegated = false;
  if status == MC_FINISH { return McHeard.{k = mc_run_finish(r, out, k)}; }
  if status != MC_TOOLS { return McHeard.{k = mc_run_next(r, out, k, status)}; }
  return McHeard.{k = k, tools = true};
}
// A step's tools. With a mode on (aware.coax) a step runs in this order: its notes (what the last
// results taught, recorded against the files as they are before this step changes them), its
// edits, its compiler questions (so a check FILE sees the edits), its commands, its views. With
// none it is mc_run_plain's.
mc_run_aware :: (r: [] McRun, out: [] McRunEvent, k0: int) -> int {
  if r[0].aw.count == 0 { return mc_run_plain(r, out, k0); }
  a := mc_pending(r[0].l[..]); k := k0;
  mc_run_notes(r);
  for i: 0..<a.ne { k = mc_run_edit_aware(r, out, k, i); if r[0].ended { return k; } }
  for i: 0..<a.nq { k = mc_run_question(r, out, k, a.questions[i]); if r[0].ended { return k; } }
  return mc_run_commands(r, out, k);
}
// A step's tools with no mode: its edits, its commands, its views.
mc_run_plain :: (r: [] McRun, out: [] McRunEvent, k0: int) -> int {
  a := mc_pending(r[0].l[..]); k := k0;
  for i: 0..<a.ne { k = mc_run_edit(r, out, k, a.edits[i]); if r[0].ended { return k; } }
  return mc_run_commands(r, out, k);
}
// The step's commands, after its edits: on a gated run the first waits for an answer
// (mc_run_answer); then its views and the next call (mc_run_after).
mc_run_commands :: (r: [] McRun, out: [] McRunEvent, k0: int) -> int {
  a := mc_pending(r[0].l[..]); k := k0;
  if r[0].l[0].agents && a.nd > 0 && !r[0].delegated { return mc_run_delegate(r, out, k); }
  if r[0].gated && a.nc > 0 {
    r[0].ask_i = 0;
    return mc_run_ask(r,out,k,a.commands[0]);
  }
  return mc_run_commands_from(r, out, k, 0);
}
// The step's commands from the from'th on, then its views. A command that runs on past this poll
// comes back here when it ends (MC_THEN_STEP).
mc_run_commands_from :: (r: [] McRun, out: [] McRunEvent, k0: int, from: int) -> int {
  a := mc_pending(r[0].l[..]); k := k0;
  for i: from..<a.nc {
    r[0].cmd_then = MC_THEN_STEP; r[0].cmd_i = i;
    k = mc_run_one(r, out, k, a.commands[i]);
    if r[0].ended || r[0].cmd_on { return k; }
  }
  return mc_run_after(r, out, k);
}

// A run for the poll's checks, as mc_run_start leaves one but with no clock and no call out: the
// loop on TASK, calling, on a plan with no attempts (its next poll is refused).
McRunFixture :: struct { r: [1] McRun; sb: [1] McStateBuffers; lb: [1] McLoopBuffers; p: [1] GwPlan; }
mc_run_fixture :: (f: [] McRunFixture, task: string) {
  mc_init(f[0].r[0].l[..], f[0].sb[..], f[0].lb[..], "{}", task, "{}", 1.0);
  f[0].r[0].p = f[0].p[..]; f[0].r[0].calling = true;
}
MC_RUN_HI_A :: "{\"rationale\":\"greet\",\"edits\":[],\"commands\":[],\"view\":[],\"finished\":true,\"reply\":\"H";
MC_RUN_HI_B :: "ello there.\",\"ask\":\"none\"}";
MC_RUN_FIX :: "{\"rationale\":\"fix\",\"edits\":[{\"path\":\"a.txt\",\"old\":\"helo\",\"new\":\"hello\"}],\"commands\":[\"true\",\"false\"],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}";
MC_RUN_ONE :: "{\"rationale\":\"look\",\"edits\":[],\"commands\":[\"true\"],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}";
MC_RUN_EDIT :: "{\"rationale\":\"fix\",\"edits\":[{\"path\":\"a.txt\",\"old\":\"helo\",\"new\":\"hello\"}],\"commands\":[],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}";

#test "a poll gives nothing once a run has ended or waits on an answer, ends a failed one, and ends a run its plan refuses" {
  for plain: [2] bool.[false, true] {
    f: [1] McRunFixture; out: [16] McRunEvent;
    mc_run_fixture(f[..], "say hi");
    r := f[0].r[..];
    r[0].asking = true;
    #assert (ifx plain then mc_run_poll_plain(r, out[..]) else mc_run_poll(r, out[..])) == 0 && !r[0].ended;
    r[0].asking = false; r[0].ended = true;
    #assert (ifx plain then mc_run_poll_plain(r, out[..]) else mc_run_poll(r, out[..])) == 0;
    r[0].ended = false; r[0].seed = true; r[0].seeded = true;     // a seeded run past its lookups polls as any
    n := ifx plain then mc_run_poll_plain(r, out[..]) else mc_run_poll(r, out[..]);     // the plan has no attempts: refused, the run ends with no capacity
    #assert n == 2 && out[0].kind == MR_STEP && out[1].kind == MR_ENDED && out[1].ending == MC_END_NO_CAPACITY;
    #assert r[0].ended && !r[0].calling && mc_run_poll(r, out[..]) == 0;
    g: [1] McRunFixture; mc_run_fixture(g[..], "say hi");
    g[0].r[0].l[0].ending = MC_END_FAILED; g[0].r[0].l[0].why = "a limit";
    n = ifx plain then mc_run_poll_plain(g[0].r[..], out[..]) else mc_run_poll(g[0].r[..], out[..]);
    #assert n == 1 && g[0].r[0].ended && out[0].kind == MR_ENDED && out[0].ending == MC_END_FAILED && out[0].text == "a limit";
  }
}

#test "a step's thinking streams immediately as reasoning deltas arrive, ahead of the reply" {
  f: [1] McRunFixture; out: [16] McRunEvent;
  mc_run_fixture(f[..], "say hi");
  r := f[0].r[..];
  t := [2] GwEvent.[GwEvent.{kind = GW_EV_REASONING, text = "First, "}, GwEvent.{kind = GW_EV_REASONING, text = "greet."}];
  h := mc_run_heard(r, out[..], t[..]);     // reasoning chunks stream out immediately
  #assert h.k == 1 && out[0].kind == MR_THOUGHT && out[0].text == "First, greet." && r[0].nthink == 13 && r[0].calling;
  a := [2] GwEvent.[GwEvent.{kind = GW_EV_REASONING, text = " Then stop."}, GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_HI_A}];
  h = mc_run_heard(r, out[..], a[..]);     // trailing reasoning delta goes out ahead of the reply's first delta
  #assert h.k == 2 && out[0].kind == MR_THOUGHT && out[0].text == " Then stop." && out[1].kind == MR_REPLY && out[1].text == "H";
  b := [2] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_HI_B}, GwEvent.{kind = GW_EV_DONE, reason = "stop"}];
  h = mc_run_heard(r, out[..], b[..]);     // no thinking in this poll: no thought, step resets nthink
  #assert h.k == 3 && out[0].kind == MR_REPLY && out[2].kind == MR_ENDED && r[0].nthink == 0;
}
#test "a reply streams out as its events come, the plan's log with it, and a finished one ends the run" {
  f: [1] McRunFixture; out: [16] McRunEvent;
  mc_run_fixture(f[..], "say hi");
  r := f[0].r[..];
  none: [1] GwEvent;
  h := mc_run_heard(r, out[..], none[0..<0]);     // nothing yet: nothing given out, still calling
  #assert h.k == 0 && !h.tools && r[0].calling;
  r[0].p[0].nlog = 1; r[0].p[0].log[0].gateway = "fixture";
  h = mc_run_heard(r, out[..], none[0..<0]);     // an attempt the plan logged
  #assert h.k == 1 && !h.tools && out[0].kind == MR_ATTEMPT && out[0].log.gateway == "fixture" && r[0].logged == 1;
  a := [1] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_HI_A}];
  h = mc_run_heard(r, out[..], a[..]);     // the reply's first letter
  #assert h.k == 1 && !h.tools && out[0].kind == MR_REPLY && out[0].text == "H" && r[0].calling;
  b := [2] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_HI_B}, GwEvent.{kind = GW_EV_DONE, reason = "stop"}];
  r[0].nob = 3;
  h = mc_run_heard(r, out[..], b[..]);     // the rest, then done: the run ends with the reply
  #assert h.k == 3 && !h.tools && out[0].kind == MR_REPLY && out[0].text == "ello there." && out[1].kind == MR_STEP && out[1].step == 1;
  #assert out[2].kind == MR_ENDED && out[2].ending == MC_END_FINISHED && out[2].text == "Hello there." && r[0].ended && !r[0].calling && r[0].nob == 0;
}

#test "steers: one held mid-turn joins the state before the next call, and a finish with one held goes on" {
  f: [1] McRunFixture; out: [16] McRunEvent; st: [1] McSteers;
  mc_run_fixture(f[..], "look");
  r := f[0].r[..]; r[0].steers = st[..];
  ev := [2] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_EDIT}, GwEvent.{kind = GW_EV_DONE, reason = "stop"}];
  r[0].gated = true;     // the edit is refused, so the step makes no change: then the next call
  h := mc_run_heard(r, out[..], ev[..]);
  #assert h.tools;
  #assert mc_steer_add(st[..], "s1", "use b.txt instead") == "";
  n := mc_run_plain(r, out[..], h.k);
  #assert n == 2 && out[1].kind == MR_STEP && r[0].calling && !r[0].ended;
  // the steer is a step of its own, after the edit's step, and the owner hears it was drained
  #assert st[0].n == 0 && st[0].nd == 1 && st[0].done[0].step == 2 && mc_steer_done_id(st[..], 0) == "s1";
  pb: [MC_PROMPT_BYTES] u8; b1: [4096] u8; b2: [4096] u8; j := mc_state_json(r[0].l[0].st[..], pb[..]);
  #assert mc_test_str(j, "actions.1.results.0.user", b1[..]) == "use b.txt instead" && mc_test_str(j, "actions.1.rationale", b2[..]) == MC_USER_RATIONALE;
  // the model finishes while another steer is held: the turn goes on, its reply kept with the steer
  #assert mc_steer_add(st[..], "s2", "and say bye") == "";
  done := [2] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_HI_A}, GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_HI_B}];
  h = mc_run_heard(r, out[..], done[..]);
  fin := [1] GwEvent.[GwEvent.{kind = GW_EV_DONE, reason = "stop"}];
  h = mc_run_heard(r, out[..], fin[..]);
  #assert !r[0].ended && r[0].calling && r[0].l[0].ending == MC_END_NONE && st[0].nd == 2;
  for i: 0..<h.k { #assert out[i].kind != MR_ENDED; }
  j = mc_state_json(r[0].l[0].st[..], pb[..]);
  last := r[0].l[0].st[0].steps - 1;
  kb: [64] u8; key := json_raw(kb[..], 0, "actions."); key = json_write_int(kb[..], key, last); key = json_raw(kb[..], key, ".results.0");
  one := cl_raw(j, cast(string) kb[0..<key]);
  #assert mc_test_str(one, "user", b1[..]) == "and say bye" && mc_test_str(one, "your_reply", b2[..]) == "Hello there.";
  // with none held, the next finish ends the turn
  h = mc_run_heard(r, out[..], done[..]); h = mc_run_heard(r, out[..], fin[..]);
  #assert r[0].ended && out[h.k - 1].kind == MR_ENDED && out[h.k - 1].ending == MC_END_FINISHED;
}
mc_test_str :: (j: string, key: string, b: [] u8) -> string { ar := [1] ClArena.[ClArena.{buf = b}]; return cl_str(ar[..], j, key); }

#test "a deferred call (call_due) fires on the next poll" {
  f: [1] McRunFixture; pb: [1] GwPlanBuffers; bench: [1] GwBench; out: [16] McRunEvent;
  mc_run_fixture(f[..], "hi");
  gw_plan_init(f[0].p[..], pb[..]);
  f[0].r[0].bench = bench[..];
  f[0].r[0].calling = false; f[0].r[0].call_due = true;
  #assert mc_run_poll_plain(f[0].r[..], out[..]) == 0;
  #assert !f[0].r[0].call_due && f[0].r[0].calling;
}

#test "a gated step's edit is refused for a command, and its first command waits for an answer" {
  for plain: [2] bool.[false, true] {
    f: [1] McRunFixture; out: [16] McRunEvent;
    mc_run_fixture(f[..], "fix a.txt");
    r := f[0].r[..]; r[0].gated = true; r[0].ask_i = 5;
    ev := [2] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_FIX}, GwEvent.{kind = GW_EV_DONE, reason = "stop"}];
    h := mc_run_heard(r, out[..], ev[..]);
    #assert h.tools && h.k == 0 && !r[0].calling;
    n := ifx plain then mc_run_plain(r, out[..], h.k) else mc_run_aware(r, out[..], h.k);     // no mode: the plain step
    #assert n == 2 && out[0].kind == MR_COMMAND && out[0].text == "edit a.txt" && out[0].exit == 126;
    #assert out[1].kind == MR_ASK && out[1].text == "true" && out[1].ticket == 1;
    #assert r[0].asking && r[0].ask_i == 0 && !r[0].calling && !r[0].ended && r[0].nob > 0;
    #assert mc_run_poll(r, out[..]) == 0 && mc_run_poll_plain(r, out[..]) == 0;     // asking: the poll waits for the answer
  }
}

#test "a step's one command waits on a gated run, a refused one ends the run, and a gated step with none goes on" {
  for c: 0..<3 {
    f: [1] McRunFixture; out: [16] McRunEvent;
    mc_run_fixture(f[..], "look");
    r := f[0].r[..]; r[0].gated = c != 1; r[0].ceiling = ifx c == 1 then 0 else 3;
    ev := [2] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = ifx c == 2 then MC_RUN_EDIT else MC_RUN_ONE}, GwEvent.{kind = GW_EV_DONE, reason = "stop"}];
    h := mc_run_heard(r, out[..], ev[..]);
    #assert h.tools;
    n := mc_run_plain(r, out[..], h.k);
    if c == 0 { #assert n == 1 && out[0].kind == MR_ASK && out[0].text == "true" && r[0].asking && !r[0].ended; }
    if c == 1 { #assert n == 1 && out[0].kind == MR_ENDED && out[0].ending == MC_END_FAILED && r[0].ended && !r[0].asking; }   // the effect ceiling refuses commands
    if c == 2 { #assert n == 2 && out[0].exit == 126 && out[1].kind == MR_STEP && !r[0].asking && !r[0].ended && r[0].calling; }   // the edit refused, then the next call
  }
}

MC_RUN_TWO :: "{\"rationale\":\"look\",\"edits\":[],\"commands\":[\"echo one\",\"echo two; exit 3\"],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}";
// A fixture's step of MC_RUN_TWO with command i running, as mc_run_one leaves it, its process
// already ended (a check can't start one; tools_smoke.coax runs real ones): exit, what it printed,
// and whether a stop killed it.
mc_test_running :: (f: [] McRunFixture, gated: bool, after: int, i: int, exit: int, printed: string, stopped: bool) {
  mc_run_fixture(f, "look");
  r := f[0].r[..]; r[0].gated = gated;
  out: [16] McRunEvent;
  ev := [2] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_TWO}, GwEvent.{kind = GW_EV_DONE, reason = "stop"}];
  h := mc_run_heard(r, out[..], ev[..]);
  #assert h.tools;
  a := mc_pending(r[0].l[..]);
  o := r[0].tb[0].out[..]; mc_output_reset(o); mc_cmd_say(o, printed);
  r[0].cmd[0] = McCommandProc.{h = -1, exit = exit, done = true, stopped = stopped};
  r[0].cmd_on = true; r[0].cmd_then = after; r[0].cmd_i = i; r[0].cmd_text = a.commands[i];
  if after == MC_THEN_ANSWER { r[0].ask_ticket = 1; r[0].ask_i = i; }
}
#test "a poll while a command runs reads only the command; once it has ended it is recorded and the step goes on (GitHub #13750)" {
  f: [1] McRunFixture; out: [16] McRunEvent;
  mc_test_running(f[..], false, MC_THEN_STEP, 1, 3, "two\n", false);
  r := f[0].r[..];
  // the plan has no attempts: a poll that called it would end the run with no capacity
  n := mc_run_poll(r, out[..]);
  #assert n == 2 && !r[0].cmd_on && !r[0].ended && r[0].calling;
  #assert out[0].kind == MR_COMMAND && out[0].text == "echo two; exit 3" && out[0].exit == 3 && out[0].output == "two\n" && !out[0].timed_out;
  #assert out[1].kind == MR_STEP;
  b: [4096] u8; pb: [MC_PROMPT_BYTES] u8; j := mc_state_json(r[0].l[0].st[..], pb[..]);
  #assert mc_test_str(j, "actions.0.results.0.command", b[..]) == "echo two; exit 3";
}
#test "a gated run asks nothing while its allowed command runs, and asks for the next once it has ended (GitHub #13750)" {
  f: [1] McRunFixture; out: [16] McRunEvent;
  mc_test_running(f[..], true, MC_THEN_ANSWER, 0, 0, "one\n", false);
  r := f[0].r[..];
  #assert !r[0].asking && mc_run_answer_owned(r, 1, true, "", out[..]) == 0 && r[0].cmd_on;     // an answer while it runs changes nothing
  n := mc_run_poll(r, out[..]);
  #assert n == 2 && out[0].kind == MR_COMMAND && out[0].text == "echo one" && out[0].exit == 0;
  #assert out[1].kind == MR_ASK && out[1].text == "echo two; exit 3" && out[1].ticket == 2 && r[0].asking && r[0].ask_i == 1 && !r[0].cmd_on;
}
#test "a stop while a command runs records it as stopped, starts no other, and ends the run stopped (GitHub #13750)" {
  for gated: [2] bool.[false, true] {
    f: [1] McRunFixture; out: [16] McRunEvent;
    mc_test_running(f[..], gated, ifx gated then MC_THEN_ANSWER else MC_THEN_STEP, 0, -1, "begun\n", true);
    r := f[0].r[..];
    o := r[0].tb[0].out[..];
    n := mc_run_stop(r, out[..]);
    #assert n == 2 && !r[0].cmd_on && r[0].ended && !r[0].asking;
    #assert out[0].kind == MR_COMMAND && out[0].text == "echo one" && out[0].exit == -1 && !out[0].timed_out && out[0].output == "begun\n\n[stopped]";
    #assert out[1].kind == MR_ENDED && out[1].ending == MC_END_STOPPED;
    #assert mc_run_poll(r, out[..]) == 0;
  }
}

// The live journal owns every effect ticket. Any uncertain completion ends
// the run; a later call never silently retries the pending operation.
// A view inside the workspace changes nothing, so views spend a budget of their own (NP_READS)
// and commands and edits keep theirs (NP_EFFECTS): GitHub #13325.
mc_run_intent :: (r:[]McRun,kind:AjKind,target:string)->bool {
  r[0].refused="";
  view:=kind==AjKind.view_intent;
  if !np_tool_admit(r[0].ceiling,kind==AjKind.command_intent) {r[0].refused="this run may not run commands: its effect ceiling is frozen below them";return false;}
  if r[0].journal.count==0 {return true;}
  now:=cxproc_now_ms();
  within:=r[0].unbounded || ifx view then np_read_budget(r[0].reads,now,r[0].deadline) else np_budget(false,r[0].effects,now,r[0].deadline);
  if !within || !r[0].unbounded && r[0].deadline-now<1000 {
    r[0].refused=mc_run_limit(ifx view then MC_LIMIT_READ else MC_LIMIT_EFFECT,ifx view then r[0].reads else r[0].effects,now,r[0].deadline-1000);
    return false;
  }
  if !jf_intent(r[0].journal,kind,mc_journal_clip(target,AJ_PAYLOAD)) {return false;}
  if view {r[0].reads+=1;} else {r[0].effects+=1;}
  return true;
}

// Single-frame journal records (decision, command_intent, view_intent) carry at most AJ_PAYLOAD bytes;
// clip metadata to fit instead of failing the run when a command exceeds the frame limit.
mc_journal_clip :: (s: string, most: int) -> string {
  if most <= 0 { return ""; }
  if s.count <= most { return s; }
  n := most;
  while n > 0 && (cast(u8) s[n] & 0xc0) == 0x80 { n -= 1; }
  return cast(string) s[0..<n];
}

// Which limit a refused call, command or view ran into, for the ending: the count's own
// (model calls, commands and edits, views) or the run's time.
MC_LIMIT_CALL :: 0; MC_LIMIT_EFFECT :: 1; MC_LIMIT_READ :: 2;
mc_run_limit :: (what:int,used:int,now:int,deadline:int)->string {
  if what==MC_LIMIT_CALL && used>=NP_MODEL_CALLS {return "model call limit reached: a run has 64 model calls";}
  if what==MC_LIMIT_EFFECT && used>=NP_EFFECTS {return "command limit reached: a run has 128 commands and edits";}
  if what==MC_LIMIT_READ && used>=NP_READS {return "read limit reached: a run has 512 file views";}
  if now>=deadline {return "time limit reached: a run has 15 minutes";}
  return "run budget refused";
}
#test "an ending names the limit that was hit: model calls, commands, views or time" {
  #assert mc_run_limit(MC_LIMIT_CALL,64,0,10)=="model call limit reached: a run has 64 model calls" && mc_run_limit(MC_LIMIT_CALL,63,10,10)=="time limit reached: a run has 15 minutes";
  #assert mc_run_limit(MC_LIMIT_EFFECT,128,0,10)=="command limit reached: a run has 128 commands and edits" && mc_run_limit(MC_LIMIT_EFFECT,127,11,10)=="time limit reached: a run has 15 minutes";
  #assert mc_run_limit(MC_LIMIT_READ,512,0,10)=="read limit reached: a run has 512 file views" && mc_run_limit(MC_LIMIT_READ,128,0,10)=="run budget refused";
  #assert mc_run_limit(MC_LIMIT_READ,511,9,10)=="run budget refused" && mc_run_limit(MC_LIMIT_READ,0,10,10)=="time limit reached: a run has 15 minutes";
  #assert MC_RUN_MS==900000 && NP_MODEL_CALLS==64 && NP_EFFECTS==128 && NP_READS==512;     // the numbers the messages give
}
// A run that fails on a limit says which; any other refusal (the journal) keeps the warning
// that an effect may be outstanding.
mc_run_failed :: (r:[]McRun,out:[]McRunEvent,k:int)->int {
  r[0].l[0].ending=MC_END_FAILED;
  r[0].l[0].why=ifx r[0].refused.count>0 then r[0].refused else "the journal refused; an outstanding effect may have happened; inspect before retrying";
  r[0].refused="";
  r[0].asking=false;return mc_run_end(r,out,k);
}

// One command started (GitHub #13750): its intent journaled, its process spawned, and what it
// has printed read without waiting. When it has ended already it is recorded and given out here;
// else cmd_on is set, and a later poll (mc_run_cmd_poll) records it and goes on with cmd_then.
// Detects when a model puts "view PATH[:A-B]" in commands[] instead of view[]: running /usr/bin/view
// launches interactive vim and hangs until the 120 s timeout. Returns the trimmed single path/range
// argument when safe to satisfy via mc_run_view directly, or "" otherwise.
mc_cmd_view_arg :: (cmd: string) -> string {
  i := 0;
  while i < cmd.count && (cmd[i] == ' ' || cmd[i] == 9) { i += 1; }
  if i + 5 > cmd.count || cast(string) cmd[i..<i + 5] != "view " { return ""; }
  i += 5;
  while i < cmd.count && (cmd[i] == ' ' || cmd[i] == 9) { i += 1; }
  e := cmd.count;
  while e > i && (cmd[e - 1] == ' ' || cmd[e - 1] == 9 || cmd[e - 1] == 10 || cmd[e - 1] == 13) { e -= 1; }
  if e <= i || cmd[i] == '-' { return ""; }
  for j: i..<e {
    c := cmd[j];
    if c == ' ' || c == 9 || c == 10 || c == ';' || c == '&' || c == '|' || c == '<' || c == '>' || c == '$' || c == '`' || c == '\'' || c == '"' { return ""; }
  }
  return cast(string) cmd[i..<e];
}

mc_run_one :: (r: [] McRun, out: [] McRunEvent, k: int, command: string) -> int {
  varg := mc_cmd_view_arg(command);
  if varg.count > 0 {
    if !mc_run_intent(r, AjKind.view_intent, varg) { return mc_run_failed(r, out, k); }
    room := mc_result_room(r[0].l[0].st[..], command);
    if room < MC_VIEW_MIN { room = MC_VIEW_MIN; }
    v := mc_view_lines(r[0].cwd, varg, r[0].profile, r[0].spill_dir, room, r[0].tb[..]);
    if r[0].journal.count > 0 && (!jf_output(r[0].journal, v.content) || !jf_result(r[0].journal, ifx v.found then "found=true" else "found=false")) { return mc_run_failed(r, out, k); }
    mc_command(r[0].l[..], command, ifx v.found then 0 else 1, false, v.content);
    return mc_run_put(out, k, McRunEvent.{kind = MR_COMMAND, text = command, exit = ifx v.found then 0 else 1, timed_out = false, output = mc_run_keep(r, v.content)});
  }
  if !mc_run_intent(r,AjKind.command_intent,command) {return mc_run_failed(r,out,k);}
  seconds:=ifx r[0].command_seconds>0 then r[0].command_seconds else MC_COMMAND_SECONDS;
  if r[0].journal.count>0 && !r[0].unbounded {left:=(r[0].deadline-cxproc_now_ms())/1000;if left<seconds {seconds=left;}if seconds<1 {r[0].refused="time limit reached: a run has 15 minutes";return mc_run_failed(r,out,k);}}
  o := r[0].tb[0].out[..];
  sp := mc_run_spill_path(r);
  o[0].spill = sp; o[0].all = ifx sp.count > 0 then r[0].spill_buf[..] else r[0].spill_buf[0..<0];
  r[0].cmd_text = command; r[0].cmd_sp = sp; r[0].cmd_began = cxproc_now_ms();
  mc_cmd_start(r[0].cmd[..], r[0].cwd, command, seconds, o, r[0].profile);
  r[0].cmd_on = true;
  return mc_run_cmd_read(r, out, k);
}

// The running command's output so far, read without waiting; recorded when it has ended.
mc_run_cmd_read :: (r: [] McRun, out: [] McRunEvent, k: int) -> int {
  if !mc_cmd_step(r[0].cmd[..], r[0].tb[0].out[..], 0) { return k; }
  return mc_run_cmd_done(r, out, k);
}

// A poll while a command runs: it is read, and once it has ended, what follows it runs.
mc_run_cmd_poll :: (r: [] McRun, out: [] McRunEvent) -> int {
  r[0].nob = 0;
  k := mc_run_cmd_read(r, out, 0);
  if r[0].cmd_on || r[0].ended { return k; }
  if r[0].cmd_then == MC_THEN_SEED { return mc_run_seed_names(r, out, k, r[0].cmd_i + 1); }
  if r[0].cmd_then == MC_THEN_ANSWER { return mc_run_answered(r, out, k); }
  return mc_run_commands_from(r, out, k, r[0].cmd_i + 1);
}

// The ended command recorded: journaled, put in the state, given out.
mc_run_cmd_done :: (r: [] McRun, out: [] McRunEvent, k: int) -> int {
  r[0].cmd_on = false;
  o := r[0].tb[0].out[..];
  res := mc_cmd_result(r[0].cmd[..], o);
  stopped := r[0].cmd[0].stopped;
  command := r[0].cmd_text; sp := r[0].cmd_sp;
  // a long output keeps its head and tail in the state, and goes whole to its file, which the cut line names
  shown := res.output;
  show := mc_result_room(r[0].l[0].st[..], command) - 512;
  if show > MC_SPILL_SHOW { show = MC_SPILL_SHOW; }
  // Passing test/check suites (exit 0) often dump thousands of "ok #test" lines; keep summary head/tail
  // in the prompt (1,200 B) and spill the full log to disk. Passing read-only search/listing outputs
  // keep 2,400 B (head/tail + spill path). Failing checks always keep full diagnostics.
  cmd_kind := mc_cmd_kind(command);
  if res.exit == 0 && !res.timed_out {
    if (cmd_kind & MC_CMD_CHECK) != 0 && show > 1200 { show = 1200; }
    else if cmd_kind == 0 && mc_cmd_is_search(command) && show > 2400 { show = 2400; }
  }
  if sp.count > 0 && o[0].esc > show && mc_output_spill(o) { shown = mc_output_shown(o, show, sp, r[0].shaped[..]); }
  o[0].spill = ""; o[0].all = r[0].spill_buf[0..<0];
  metadata:[128]u8;m:=json_raw(metadata[..],0,"exit=");m=json_write_int(metadata[..],m,res.exit);
  m=json_raw(metadata[..],m,ifx res.timed_out then " timed_out=true" else " timed_out=false");
  if stopped { m=json_raw(metadata[..],m," stopped=true"); }
  if r[0].journal.count>0 && (!jf_output(r[0].journal,res.output) || !jf_result(r[0].journal,cast(string)metadata[0..<m])) {return mc_run_failed(r,out,k);}
  mc_command(r[0].l[..], command, res.exit, res.timed_out, shown);
  text := ifx r[0].cmd_then == MC_THEN_SEED then mc_run_keep(r, command) else command;     // the next lookup reuses cmd_seed
  k2 := mc_run_put(out, k, McRunEvent.{kind = MR_COMMAND, text = text, exit = res.exit, timed_out = res.timed_out, output = mc_run_keep(r, res.output)});
  // the memory keeps the run (the output as the tools kept it), as a run of the task's check when it is one
  if !stopped && r[0].aw.count > 0 && r[0].aw[0].memory { mc_aw_ran(r[0].aw, command, res.exit, res.timed_out, cxproc_now_ms() - r[0].cmd_began, res.output); }
  return k2;
}

// The step's notes (a run with the memory): each a finding in the store, and a result of the
// step that says which ("noted F3"), or that it was not recorded.
mc_run_notes :: (r: [] McRun) {
  l := r[0].l[..]; a := mc_pending(l);
  if !r[0].aw[0].memory { return; }
  for i: 0..<a.nn {
    d := mc_aw_note(r[0].aw, a.notes[i]);
    lb: [200] u8; n := json_raw(lb[..], 0, "note: "); n = json_raw(lb[..], n, mc_aw_cut(a.notes[i], 120));
    mc_action_command(l[0].st[..], ifx n < 0 then "note" else cast(string) lb[0..<n], d.exit, false, mc_aw_text(r[0].aw, d));
  }
}

// One compiler question (a run with intel): asked, its answer recorded as a command's result
// named "ask: QUESTION" (exit 0 answered, 1 no answer, 2 no question) and given out as one. It
// is a read: journaled and counted as a view is.
MC_ASK_HELD :: "[not asked: this step's results reached their 32 KB; ask it in a later step]";
mc_run_question :: (r: [] McRun, out: [] McRunEvent, k: int, q: string) -> int {
  l := r[0].l[..];
  lb: [1100] u8; n := json_raw(lb[..], 0, "ask: "); n = json_raw(lb[..], n, mc_aw_cut(q, 1000));
  label := ifx n < 0 then "ask" else cast(string) lb[0..<n];
  room := mc_result_room(l[0].st[..], label);
  if room < MC_VIEW_MIN {
    mc_action_command(l[0].st[..], label, 1, false, MC_ASK_HELD);
    return mc_run_put(out, k, McRunEvent.{kind = MR_COMMAND, text = mc_run_keep(r, label), exit = 1, output = MC_ASK_HELD});
  }
  if !mc_run_intent(r, AjKind.view_intent, label) { return mc_run_failed(r, out, k); }
  d := mc_aw_ask(r[0].aw, q, mc_run_left(r), room - 64, mc_run_step(r));
  text := mc_aw_text(r[0].aw, d);
  if r[0].journal.count > 0 && (!jf_output(r[0].journal, text) || !jf_result(r[0].journal, ifx d.exit == 0 then "found=true" else "found=false")) { return mc_run_failed(r, out, k); }
  mc_action_command(l[0].st[..], label, d.exit, false, text);
  return mc_run_put(out, k, McRunEvent.{kind = MR_COMMAND, text = mc_run_keep(r, label), exit = d.exit, output = mc_run_keep(r, text)});
}

// Edit i of the pending action in a run with a mode (aware.coax mc_aw_edit): tied to the hash
// the model read, by name or exact, with the file's new hash and its check after it. Given out
// and journaled as mc_run_edit's. A .coax file edited more than once in the step is checked
// after the last of its edits.
mc_run_edit_aware :: (r: [] McRun, out: [] McRunEvent, k: int, i: int) -> int {
  a := mc_pending(r[0].l[..]); e := a.edits[i];
  if r[0].gated && !r[0].edits_free { return mc_run_edit(r, out, k, e); }
  tb: [1100] u8; tn := json_raw(tb[..], 0, "edit "); tn = json_raw(tb[..], tn, e.path);
  label := ifx tn < 0 then "edit" else cast(string) tb[0..<tn];
  if !mc_run_intent(r, AjKind.command_intent, label) { return mc_run_failed(r, out, k); }
  later := false;
  for j: i + 1..<a.ne { if a.edits[j].path == e.path { later = true; } }
  x := mc_aw_edit(r[0].aw, e, !later, mc_run_left(r), mc_run_step(r), r[0].tb[..]);
  why := mc_aw_edit_why(r[0].aw, x);
  if r[0].journal.count > 0 && (!jf_output(r[0].journal, ifx x.ok then "applied" else why) || !jf_result(r[0].journal, ifx x.ok then "exit=0 timed_out=false" else "exit=1 timed_out=false")) { return mc_run_failed(r, out, k); }
  mc_edited_shown(r[0].l[..], e.path, x.ok, why, x.from, x.to, mc_aw_edit_shown(r[0].aw, x));
  rp := ifx r[0].tb[0].replay_n > 0 then cast(string) r[0].tb[0].replay[0..<r[0].tb[0].replay_n] else "";
  db: [4224] u8;
  ev_out := mc_edit_event_output(db[..], x.ok, x.from, e.old, e.text, why, rp);
  return mc_run_put(out, k, McRunEvent.{kind = MR_COMMAND, text = mc_run_keep(r, label), exit = ifx x.ok then 0 else 1, output = mc_run_keep(r, ev_out)});
}

// The model says finished, in a run with the memory (MC_FINISH): its notes are kept, the store
// looks at the files again, and the finish rule answers. While a check the task names has not
// passed on the files as they are, the finish is refused with what is open, MC_FINISH_REFUSALS
// times at most; then it stands, and the run's report says what was open (mc_aw_close).
mc_run_finish :: (r: [] McRun, out: [] McRunEvent, k: int) -> int {
  l := r[0].l[..];
  status := MC_ENDED;
  if r[0].aw.count == 0 || !r[0].aw[0].memory { status = mc_finish_accept(l); }
  else {
    mc_run_notes(r);
    open := mc_aw_open(r[0].aw);
    if open.count == 0 { status = mc_finish_accept(l); }
    else { status = mc_finish_refuse(l, mc_aw_refusal(r[0].aw, l[0].finish_refused, open)); }
  }
  return mc_run_next(r, out, k, status);
}

// One exact edit, applied and given out as a command row ("edit PATH", exit 0 or 1, the
// result as output). A gated run's changes wait for approval, which edits have no way to ask
// for: there the model is told to make the change with a command.
mc_diff_lines :: (s: string) -> int {
  if s.count == 0 { return 0; }
  n := 0;
  for c: s { if c == '\n' { n += 1; } }
  return ifx s[s.count - 1] != '\n' then n + 1 else n;
}
mc_diff_put_lines :: (out: [] u8, at: int, mark: u8, s: string) -> int {
  n := at; i := 0;
  while i < s.count {
    j := i; while j < s.count && s[j] != '\n' { j += 1; }
    if n + 2 > out.count { break; }
    out[n] = mark; n += 1;
    for p: i..<j {
      if n + 2 > out.count { break; }
      out[n] = s[p]; n += 1;
    }
    if n < out.count { out[n] = '\n'; n += 1; }
    i = ifx j < s.count then j + 1 else j;
  }
  return n;
}
mc_edit_diff :: (out: [] u8, from: int, old: string, text: string) -> int {
  on := mc_diff_lines(old); nn := mc_diff_lines(text);
  if on == 0 && nn == 0 { return 0; }
  start := ifx from > 0 then from else 1;
  n := json_raw(out, 0, "@@ -");
  n = json_write_int(out, n, start);
  n = json_raw(out, n, ",");
  n = json_write_int(out, n, on);
  n = json_raw(out, n, " +");
  n = json_write_int(out, n, start);
  n = json_raw(out, n, ",");
  n = json_write_int(out, n, nn);
  n = json_raw(out, n, " @@\n");
  if n < 0 { return 0; }
  n = mc_diff_put_lines(out, n, '-', old);
  n = mc_diff_put_lines(out, n, '+', text);
  return n;
}
// Format an edit's event output: unified diff + optional Ch 234 replay-verification receipt
// ("\ [E] replay verified · sha256:...") so app_is_diff and +/- stats stay intact while Desktop
// renders the compact replay-verification pill (#13924).
mc_edit_event_output :: (db: [] u8, ok: bool, from: int, old: string, text: string, why: string, replay: string) -> string {
  if ok {
    dn := mc_edit_diff(db, from, old, text);
    if dn > 0 {
      if replay.count > 0 && dn + replay.count + 4 <= db.count {
        dn = mc_put(db, dn, "\\ ");
        dn = mc_put(db, dn, replay);
        dn = mc_put(db, dn, "\n");
      }
      return cast(string) db[0..<dn];
    }
    if replay.count > 0 {
      n := mc_put(db, 0, "applied\n");
      n = mc_put(db, n, replay);
      return cast(string) db[0..<n];
    }
    return "applied";
  }
  if replay.count > 0 && why.count + replay.count + 2 <= db.count {
    n := mc_put(db, 0, why);
    n = mc_put(db, n, "\n");
    n = mc_put(db, n, replay);
    return cast(string) db[0..<n];
  }
  return why;
}
mc_run_edit :: (r: [] McRun, out: [] McRunEvent, k: int, e: McEdit) -> int {
  tb: [1100] u8; tn := json_raw(tb[..], 0, "edit "); tn = json_raw(tb[..], tn, e.path);
  label := ifx tn < 0 then "edit" else cast(string) tb[0..<tn];
  if r[0].gated && !r[0].edits_free {
    why := "each change in this run waits for approval: make this one with a command";
    mc_edited(r[0].l[..], e.path, false, why);
    return mc_run_put(out, k, McRunEvent.{kind = MR_COMMAND, text = mc_run_keep(r, label), exit = 126, output = mc_run_keep(r, why)});
  }
  if !mc_run_intent(r, AjKind.command_intent, label) { return mc_run_failed(r, out, k); }
  res := mc_edit_file(r[0].cwd, e, r[0].profile, r[0].tb[..]);
  if r[0].journal.count > 0 && (!jf_output(r[0].journal, ifx res.ok then "applied" else res.why) || !jf_result(r[0].journal, ifx res.ok then "exit=0 timed_out=false" else "exit=1 timed_out=false")) { return mc_run_failed(r, out, k); }
  mc_edited_shown(r[0].l[..], e.path, res.ok, res.why, res.from, res.to, res.shown);
  db: [4224] u8;
  ev_out := mc_edit_event_output(db[..], res.ok, res.from, e.old, e.text, res.why, res.replay);
  return mc_run_put(out, k, McRunEvent.{kind = MR_COMMAND, text = mc_run_keep(r, label), exit = ifx res.ok then 0 else 1, output = mc_run_keep(r, ev_out)});
}

// After the step's commands: its views, then the next call or the end.
mc_run_after :: (r: [] McRun, out: [] McRunEvent, k0: int) -> int {
  l := r[0].l[..]; a := mc_pending(l); k := k0;
  for i: 0..<a.nv {
    // a view the step's budget has no room for is held back, unread, and its result says so (GitHub #13325)
    room := mc_result_room(l[0].st[..], a.view[i]);
    if room < MC_VIEW_MIN { mc_file_held(l[0].st[..], a.view[i]); k = mc_run_put(out, k, McRunEvent.{kind = MR_VIEW, text = a.view[i], found = false}); continue; }
    if !mc_run_intent(r,AjKind.view_intent,a.view[i]) {return mc_run_failed(r,out,k);}
    v := mc_run_view(r, a.view[i], room);
    if r[0].journal.count>0 && (!jf_output(r[0].journal,v.content) || !jf_result(r[0].journal,ifx v.found then "found=true" else "found=false")) {return mc_run_failed(r,out,k);}
    mc_view(l, a.view[i], v.found, v.content);
    k = mc_run_put(out, k, McRunEvent.{kind = MR_VIEW, text = a.view[i], found = v.found});
  }
  return mc_run_next(r, out, k, mc_tools_done(l));
}

mc_run_next :: (r: [] McRun, out: [] McRunEvent, k0: int, status: int) -> int {
  k := mc_run_put(out, k0, McRunEvent.{kind = MR_STEP, step = r[0].l[0].steps});
  if status == MC_ENDED && !mc_run_steered_on(r) { return mc_run_end(r, out, k); }
  if r[0].defer_call { r[0].call_due = true; } else { mc_run_call(r); }
  return k;
}

// Steers (steer.coax): each held one becomes a step of the state before the next request, and
// moves to done for the owner to report. reply is the reply the model had just finished with
// ("" mid-turn), kept in the first steer's step.
mc_run_drain :: (r: [] McRun, reply: string) {
  if r[0].steers.count == 0 { return; }
  first := true;
  while r[0].steers[0].n > 0 && r[0].steers[0].nd < MC_STEERS {
    stext := mc_steer_text(r[0].steers, 0);
    mc_run_attach_images_in(r, stext);
    mc_action_user(r[0].l[0].st[..], stext, ifx first then reply else "");
    first = false;
    if !mc_steer_take(r[0].steers, r[0].l[0].st[0].steps) { break; }
  }
}
// A turn that would end with steers held goes on: finished, asked or idle, it is open again and
// its next request carries them (with the reply it finished with). True when it goes on.
mc_run_steered_on :: (r: [] McRun) -> bool {
  l := r[0].l[..];
  if r[0].steers.count == 0 || r[0].steers[0].n == 0 || r[0].steers[0].nd >= MC_STEERS { return false; }
  if l[0].ending != MC_END_FINISHED && l[0].ending != MC_END_ASKED && l[0].ending != MC_END_IDLE { return false; }
  reply := l[0].reply;
  l[0].ending = MC_END_NONE; l[0].idle = 0; mc_stall_reset(l);
  mc_run_drain(r, reply);
  l[0].reply = "";
  return true;
}

// A gated run's answer for the command in its MR_ASK: allowed, it runs; refused,
// the model sees why. Then the next command's MR_ASK, or the step goes on.
mc_run_answer :: (r: [] McRun, allow: bool, why: string, out: [] McRunEvent) -> int {
  if r[0].ended || !r[0].asking || r[0].delegating { return 0; }
  r[0].nob = 0;
  l := r[0].l[..]; a := mc_pending(l); i := r[0].ask_i;
  k := 0;
  if r[0].journal.count>0 {
    b:[AJ_PAYLOAD]u8;
    n:=json_raw(b[..],0,ifx allow then "allow " else "refuse ");
    why_clip:=mc_journal_clip(why,1024);
    room:=AJ_PAYLOAD-n-8-why_clip.count;
    n=json_raw(b[..],n,mc_journal_clip(a.commands[i],room));
    n=json_raw(b[..],n," reason=");
    n=json_raw(b[..],n,why_clip);
    if n<0 || !jf_decision(r[0].journal,cast(string)b[0..<n]) {return mc_run_failed(r,out,0);}
  }
  if allow {
    // while it runs the run asks nothing, so a poll reads it; an answer then changes nothing
    r[0].asking = false; r[0].cmd_then = MC_THEN_ANSWER; r[0].cmd_i = i;
    k = mc_run_one(r, out, k, a.commands[i]);
    if r[0].ended || r[0].cmd_on { return k; }
  }
  else {
    mc_action_refused(l[0].st[..], a.commands[i], why);
    k = mc_run_put(out, k, McRunEvent.{kind = MR_COMMAND, text = a.commands[i], exit = 126, output = mc_run_keep(r, why)});
  }
  return mc_run_answered(r, out, k);
}
// After a gated run's command (run or refused): the next command's MR_ASK, or the step's views.
mc_run_answered :: (r: [] McRun, out: [] McRunEvent, k: int) -> int {
  a := mc_pending(r[0].l[..]);
  r[0].ask_i += 1;
  if r[0].ask_i < a.nc { return mc_run_ask(r,out,k,a.commands[r[0].ask_i]); }
  r[0].asking = false;
  return mc_run_after(r, out, k);
}

// Sub-agents (GitHub #13655). A step's delegated tasks go to the run's owner, which runs them
// (each a run of its own, at the same time) and answers once with every result. The run waits
// as it does for a gated command's answer. A sub-agent is the owner's run with a journal of
// its own, so the tasks are not effects of this one.
MC_DELEGATE_LABEL :: 300;        // bytes of a task in its result's name
mc_run_delegate_label :: (d: McDelegate, out: [] u8) -> string {
  n := json_raw(out, 0, "agent "); n = json_raw(out, n, d.level); n = json_raw(out, n, ": ");
  n = json_raw(out, n, ifx d.task.count > MC_DELEGATE_LABEL then cast(string) d.task[0..<MC_DELEGATE_LABEL] else d.task);
  return ifx n < 0 then "agent" else cast(string) out[0..<n];
}
mc_run_delegate :: (r: [] McRun, out: [] McRunEvent, k0: int) -> int {
  if r[0].ask_ticket == 9223372036854775807 { return mc_run_failed(r, out, k0); }
  a := mc_pending(r[0].l[..]); k := k0;
  b: [32768] u8; n := json_raw(b[..], 0, "["); asked := 0;
  for i: 0..<a.nd {
    // a stop goes to the owner at once, as a line of its own; nothing waits on it (GitHub #13766)
    if a.delegates[i].stop { k = mc_run_put(out, k, McRunEvent.{kind = MR_STOP_AGENT, agent = a.delegates[i].resume}); continue; }
    n = json_raw(b[..], n, ifx asked > 0 then ",{\"level\":" else "{\"level\":"); n = json_write_string(b[..], n, a.delegates[i].level);
    n = json_raw(b[..], n, ",\"task\":"); n = json_write_string(b[..], n, a.delegates[i].task);
    if a.delegates[i].resume > 0 { n = json_raw(b[..], n, ",\"resume\":"); n = json_write_int(b[..], n, a.delegates[i].resume); }
    n = json_raw(b[..], n, "}");
    asked += 1;
  }
  n = json_raw(b[..], n, "]");
  // a reply the loop takes is shorter than b, so this does not happen; it stays as the guard for a larger reply
  if n < 0 { r[0].refused = "the delegated tasks are longer than 32 KB together"; return mc_run_failed(r, out, k); } // mutant: equivalent
  if asked == 0 {
    // only stops: their results now, and the step goes on
    mc_run_delegated_record(r, "[]");
    r[0].delegated = true;
    return mc_run_commands(r, out, k);
  }
  r[0].ask_ticket += 1; r[0].asking = true; r[0].delegating = true;
  return mc_run_put(out, k, McRunEvent.{kind = MR_DELEGATE, ticket = r[0].ask_ticket, text = mc_run_keep(r, cast(string) b[0..<n])});
}
// The owner's answer to MR_DELEGATE: results is a JSON list with one {"exit":N,"output":TEXT}
// for each task it was handed, in order (exit 0: the sub-agent finished, and output is its reply;
// else output says why it did not, or that it is still running, GitHub #13766). Each is recorded
// as a result of the step named "agent LEVEL: TASK"; a task with no result is recorded as not
// run, and a stop as "agent N: stop". Then the step goes on: its commands and views. An answer for
// another ticket changes nothing.
mc_run_delegated :: (r: [] McRun, ticket: int, results: string, out: [] McRunEvent) -> int {
  if r[0].ended || !r[0].asking || !r[0].delegating || ticket <= 0 || ticket != r[0].ask_ticket { return 0; }
  r[0].nob = 0;
  mc_run_delegated_record(r, results);
  r[0].delegating = false; r[0].delegated = true; r[0].asking = false;
  return mc_run_commands(r, out, 0);
}
mc_run_delegated_record :: (r: [] McRun, results: string) {
  l := r[0].l[..]; a := mc_pending(l);
  have := ifx results.count > 1 && results[0] == '[' && json_valid(results) then cl_count(results) else 0;
  lb: [MC_DELEGATE_LABEL + 32] u8;
  q := 0;
  for i: 0..<a.nd {
    if a.delegates[i].stop {
      sn := json_raw(lb[..], 0, "agent "); sn = json_write_int(lb[..], sn, a.delegates[i].resume); sn = json_raw(lb[..], sn, ": stop");
      mc_action_command(l[0].st[..], ifx sn < 0 then "agent: stop" else cast(string) lb[0..<sn], 0, false, "Its owner was told to stop it. A sub-agent that had already ended is left as it was.");
      continue;
    }
    ar: [1] ClArena; ar[0] = ClArena.{buf = r[0].spill_buf[..]};
    label := mc_run_delegate_label(a.delegates[i], lb[..]);
    at := q; q += 1;
    if at >= have { mc_action_command(l[0].st[..], label, 1, false, "the sub-agent did not run"); continue; }
    one := cl_json(results, cl_item(results, at));
    exit := cl_int(one, "exit"); v := cl_at(one, "output"); text := cl_text(ar[..], one, v);
    code := ifx exit.ok then exit.value else 1;
    if text.count == 0 && ar[0].full && v.ok {
      // past the buffer a reply is read back in: it is saved as the JSON string it came as
      raw := cast(string) one[v.from..<v.to]; sp := mc_run_spill_path(r);
      if sp.count > 0 && fs_write(sp, raw) { mc_action_reply(l[0].st[..], label, code, mc_reply_raw_note(raw.count, sp, r[0].obuf[..])); }
      else { mc_action_reply(l[0].st[..], label, code, "[the sub-agent's reply was too long to read back here, and could not be saved]"); }
      continue;
    }
    if text.count == 0 { mc_action_command(l[0].st[..], label, code, false, "the sub-agent gave no reply"); continue; }
    mc_action_reply(l[0].st[..], label, code, mc_run_reply_shown(r, label, text));
  }
}

// A sub-agent's reply as the state holds it (GitHub #13325's spill, for replies): whole whenever it fits
// the step's room. It is also saved whole to its own file, which its last line names, so the reply can
// be read again after the step is compacted. A reply past the room keeps its head and tail, and the
// line between them names the file and the lines left out.
mc_run_reply_shown :: (r: [] McRun, label: string, text: string) -> string {
  sp := mc_run_spill_path(r);
  saved := sp.count > 0 && fs_write(sp, text);
  room := mc_result_room(r[0].l[0].st[..], label);
  return mc_reply_shown(text, room, ifx saved then sp else "", r[0].obuf[..]);
}
mc_reply_shown :: (text: string, room: int, path: string, out: [] u8) -> string {
  ends := mc_line_ends(text); if text.count > 0 && text[text.count - 1] != '\n' { ends += 1; }
  // whole, with the line naming its file
  n := mc_put(out, 0, text);
  if path.count > 0 { n = mc_put(out, n, ifx text.count > 0 && text[text.count - 1] != '\n' then "\n[saved whole: " else "[saved whole: "); n = mc_put(out, n, path); n = mc_put(out, n, "]"); }
  if text.count + path.count + 32 <= out.count && mc_escaped_size(cast(string) out[0..<n]) <= room { return cast(string) out[0..<n]; }
  if path.count == 0 { return text; }     // nowhere to save it: the state keeps what fits, and says what it held back
  half := (room - 320 - 2 * path.count) / 2;
  if half < 0 { half = 0; }
  if 2 * half + 4096 > out.count { half = (out.count - 4096) / 2; }
  h := mc_fit_head(text, half);
  t := mc_fit_tail(cast(string) text[h..<text.count], half) + h;
  first := mc_line_ends(cast(string) text[0..<h]) + 1;
  last := mc_line_ends(cast(string) text[0..<t]) + 1;
  if last < first { last = first; }
  n = mc_put(out, 0, cast(string) text[0..<h]);
  if h > 0 && text[h - 1] != '\n' { n = mc_put(out, n, "\n"); }
  n = mc_put(out, n, "[... "); n = mc_put_int(out, n, t - h); n = mc_put(out, n, " bytes of the reply (lines "); n = mc_put_int(out, n, first); n = mc_put(out, n, "-");
  n = mc_put_int(out, n, last); n = mc_put(out, n, ") left out here: this step's results have 32 KB. The whole reply, "); n = mc_put_int(out, n, ends);
  n = mc_put(out, n, " lines, is saved: view "); n = mc_put(out, n, path); n = mc_put(out, n, ":"); n = mc_put_int(out, n, first); n = mc_put(out, n, "-");
  n = mc_put_int(out, n, ifx last < first + MC_VIEW_LINES - 1 then last else first + MC_VIEW_LINES - 1); n = mc_put(out, n, " to read them]\n");
  n = mc_put(out, n, cast(string) text[t..<text.count]);
  return cast(string) out[0..<n];
}
mc_reply_raw_note :: (bytes: int, path: string, out: [] u8) -> string {
  n := mc_put(out, 0, "[the sub-agent's reply, "); n = mc_put_int(out, n, bytes); n = mc_put(out, n, " bytes, is too long to show here. It is saved whole, as a JSON string: view ");
  n = mc_put(out, n, path); n = mc_put(out, n, ":1-"); n = mc_put_int(out, n, MC_VIEW_LINES); n = mc_put(out, n, "]");
  return cast(string) out[0..<n];
}
#test "a sub-agent's reply is whole when it fits, names its saved file, and past the room keeps head and tail with the file's lines" {
  out: [131072] u8;
  #assert mc_reply_shown("two files", 32000, "/s/1-2-1.txt", out[..]) == "two files\n[saved whole: /s/1-2-1.txt]";
  #assert mc_reply_shown("two files", 32000, "", out[..]) == "two files";
  big: [20000] u8; for k: 0..<20000 { big[k] = ifx k % 100 == 99 then '\n' else ifx k < 100 then 'H' else ifx k >= 19900 then 'T' else 'm'; }
  text := cast(string) big[..];
  #assert mc_reply_shown(text, 32000, "/s/x.txt", out[..]).count == 20000 + "[saved whole: /s/x.txt]".count;
  cut := mc_reply_shown(text, 4000, "/s/x.txt", out[..]);
  #assert cut.count < 4000 && cut[0] == 'H' && cut[cut.count - 2] == 'T' && mc_escaped_size(cut) <= 4000;
  saw := false; for k: 0..<cut.count - 8 { if cut[k] == '/' && cut[k + 1] == 's' && cut[k + 2] == '/' && cut[k + 3] == 'x' { saw = true; } }
  #assert saw;
}

// STOP: the running call's curl goes, or the running command's process group is killed (its
// row given out and journaled as stopped), and the run ends stopped.
mc_run_stop :: (r: [] McRun, out: [] McRunEvent) -> int {
  if r[0].ended { return 0; }
  k := 0;
  if r[0].cmd_on {
    mc_cmd_stop(r[0].cmd[..]); r[0].nob = 0;
    k = mc_run_cmd_done(r, out, 0);
    if r[0].ended { return k; }      // the journal refused its result: the run has failed
  }
  r[0].asking = false; r[0].delegating = false;
  gw_plan_stop(r[0].p);
  mc_stop(r[0].l[..]);
  k = mc_run_logs(r, out, k);
  return mc_run_end(r, out, k);
}

// ---------------------------------------------------------------- checks

#test "the reply streams out of a next_action as it arrives, in any split, decoded" {
  whole := "{\"rationale\":\"a \\\"reply\\\" here is not it\",\"commands\":[\"echo {\\\"reply\\\":1}\"],\"view\":[],\"finished\":true,\"reply\":\"2 + 2 = 4.\\nCaf\\u00e9 \\ud83d\\ude00 \\\"ok\\\"\",\"ask\":\"none\"}";
  want := "2 + 2 = 4.\nCafé 😀 \"ok\"";
  for size: 1..<12 {
    rs: [1] McReplyStream; mc_rs_reset(rs[..]);
    got: [256] u8; ng := 0;
    at := 0;
    while at < whole.count {
      e := ifx at + size < whole.count then at + size else whole.count;
      ng += mc_rs_feed(rs[..], cast(string) whole[at..<e], got[ng..<got.count]);
      at = e;
    }
    #assert cast(string) got[0..<ng] == want;
  }
}

#test "no reply text comes from other fields, nested objects or a reply-like key" {
  rs: [1] McReplyStream; mc_rs_reset(rs[..]);
  got: [256] u8;
  n := mc_rs_feed(rs[..], "{\"replying\":\"no\",\"x\":{\"reply\":\"nested\"},\"reply\":\"\",\"ask\":\"question\"}", got[..]);
  #assert n == 0;
  mc_rs_reset(rs[..]);
  n = mc_rs_feed(rs[..], "{\"reply\" : \"spaced\"}", got[..]);
  #assert cast(string) got[0..<n] == "spaced";
}

#test "each command's output in a poll keeps its own bytes, cut when the poll's buffer is full" {
  r: [1] McRun;
  tool: [8] u8;
  tool[0] = 'o'; tool[1] = 'n'; tool[2] = 'e';
  first := mc_run_keep(r[..], cast(string) tool[0..<3]);
  tool[0] = 't'; tool[1] = 'w'; tool[2] = 'o';      // the tools' buffer, reused by the next command
  second := mc_run_keep(r[..], cast(string) tool[0..<3]);
  #assert first == "one" && second == "two";
  r[0].nob = r[0].obuf.count - 2;
  #assert mc_run_keep(r[..], "abc") == "ab" && mc_run_keep(r[..], "d") == "";
}

// Tickets never reset between turns in this worker. A late answer cannot
// authorize a different command or the next turn's proposal.
mc_run_ask :: (r:[]McRun,out:[]McRunEvent,k:int,command:string)->int {
  if r[0].ask_ticket==9223372036854775807 {return mc_run_failed(r,out,k);}
  r[0].ask_ticket+=1;r[0].asking=true;
  if r[0].journal.count>0 {
    b:[AJ_PAYLOAD]u8;
    n:=json_raw(b[..],0,"proposal=");n=json_write_int(b[..],n,r[0].ask_ticket);n=json_raw(b[..],n," command=");
    n=json_raw(b[..],n,mc_journal_clip(command,AJ_PAYLOAD-n));
    if n<0 || !jf_decision(r[0].journal,cast(string)b[0..<n]) {return mc_run_failed(r,out,k);}
  }
  return mc_run_put(out,k,McRunEvent.{kind=MR_ASK,ticket=r[0].ask_ticket,text=command});
}
mc_run_answer_owned :: (r:[]McRun,ticket:int,allow:bool,why:string,out:[]McRunEvent)->int {
  if ticket<=0 || ticket!=r[0].ask_ticket {return 0;}
  return mc_run_answer(r,allow,why,out);
}
#test "stale approval answers leave the current proposal untouched" {
  r:[1]McRun;r[0].asking=true;r[0].ask_ticket=3;out:[16]McRunEvent;
  #assert mc_run_answer_owned(r[..],2,true,"",out[..])==0;
  #assert mc_run_answer_owned(r[..],0,true,"",out[..])==0;
  #assert mc_run_answer_owned(r[..],4,true,"",out[..])==0;
  #assert r[0].asking && r[0].ask_ticket==3 && !r[0].ended;
}

MC_RUN_SPLIT_BARE :: "{\"rationale\":\"split\",\"delegate\":[{\"level\":\"hydrogen\",\"task\":\"count the files\"},{\"level\":\"carbon\",\"task\":\"find the bug\",\"resume\":1}],\"edits\":[],\"commands\":[],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}";
MC_RUN_SPLIT :: "{\"rationale\":\"split\",\"delegate\":[{\"level\":\"hydrogen\",\"task\":\"count the files\"},{\"level\":\"carbon\",\"task\":\"find the bug\",\"resume\":1}],\"edits\":[],\"commands\":[\"true\"],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}";
#test "a step's delegated tasks fail the run when no ticket is left" {
  f: [1] McRunFixture; out: [16] McRunEvent;
  mc_run_fixture(f[..], "do two things");
  r := f[0].r[..]; r[0].l[0].agents = true; r[0].ask_ticket = 9223372036854775807;
  ev := [2] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_SPLIT_BARE}, GwEvent.{kind = GW_EV_DONE, reason = "stop"}];
  h := mc_run_heard(r, out[..], ev[..]);
  n := mc_run_plain(r, out[..], h.k);
  #assert n > 0 && r[0].ended && !r[0].delegating && r[0].l[0].ending == MC_END_FAILED && r[0].ask_ticket == 9223372036854775807;
}
#test "a step's delegated tasks wait for the owner's results, which become the step's results; then its commands run" {
  for gated: [2] bool.[false, true] {
    f: [1] McRunFixture; out: [16] McRunEvent;
    mc_run_fixture(f[..], "do two things");
    r := f[0].r[..]; r[0].gated = gated; r[0].l[0].agents = true;
    ev := [2] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = ifx gated then MC_RUN_SPLIT else MC_RUN_SPLIT_BARE}, GwEvent.{kind = GW_EV_DONE, reason = "stop"}];
    h := mc_run_heard(r, out[..], ev[..]);
    #assert h.tools && mc_pending(r[0].l[..]).nd == 2;
    n := mc_run_plain(r, out[..], h.k);
    #assert n == 1 && out[0].kind == MR_DELEGATE && out[0].ticket == 1 && r[0].asking && r[0].delegating && !r[0].ended;
    #assert out[0].text == "[{\"level\":\"hydrogen\",\"task\":\"count the files\"},{\"level\":\"carbon\",\"task\":\"find the bug\",\"resume\":1}]";
    #assert mc_run_poll(r, out[..]) == 0;                                         // waiting
    #assert mc_run_answer(r, true, "", out[..]) == 0 && r[0].delegating;          // a command's answer is not the results
    #assert mc_run_delegated(r, 2, "[]", out[..]) == 0 && r[0].delegating;        // another ticket
    n = mc_run_delegated(r, 1, "[{\"exit\":0,\"output\":\"12 files\"}]", out[..]);
    #assert !r[0].delegating && r[0].delegated && !r[0].ended;
    if !gated {     // the step has ended (a gated one is open until its command is answered): its results are in the state
      state := mc_state_json(r[0].l[0].st[..], r[0].l[0].prompt);
      #assert ps_count(state, "agent hydrogen: count the files") == 1 && ps_count(state, "12 files") == 1 && ps_count(state, "agent carbon: find the bug") == 1 && ps_count(state, "the sub-agent did not run") == 1;
    }
    if gated { #assert n == 1 && out[0].kind == MR_ASK && out[0].text == "true" && out[0].ticket == 2 && r[0].asking; }
    else { #assert n == 1 && out[0].kind == MR_STEP && !r[0].asking && r[0].calling; }     // no commands (a check cannot run one): the next call
  }
}

MC_RUN_STOP_ONE :: "{\"rationale\":\"enough\",\"delegate\":[{\"level\":\"carbon\",\"task\":\"\",\"resume\":2,\"stop\":true}],\"edits\":[],\"commands\":[],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}";
MC_RUN_STOP_AND_WAIT :: "{\"rationale\":\"one more\",\"delegate\":[{\"level\":\"carbon\",\"task\":\"\",\"resume\":2,\"stop\":true},{\"level\":\"hydrogen\",\"task\":\"keep going\",\"resume\":1}],\"edits\":[],\"commands\":[],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}";
#test "a step that only stops a sub-agent tells its owner and goes on, with nothing to wait for" {
  f: [1] McRunFixture; out: [16] McRunEvent;
  mc_run_fixture(f[..], "two things");
  r := f[0].r[..]; r[0].l[0].agents = true;
  ev := [2] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_STOP_ONE}, GwEvent.{kind = GW_EV_DONE, reason = "stop"}];
  h := mc_run_heard(r, out[..], ev[..]);
  #assert h.tools && mc_pending(r[0].l[..]).nd == 1 && mc_pending(r[0].l[..]).delegates[0].stop;
  n := mc_run_plain(r, out[..], h.k);
  #assert n == 2 && out[0].kind == MR_STOP_AGENT && out[0].agent == 2 && out[1].kind == MR_STEP;
  #assert !r[0].delegating && !r[0].asking && r[0].ask_ticket == 0;
  state := mc_state_json(r[0].l[0].st[..], r[0].l[0].prompt);
  #assert ps_count(state, "agent 2: stop") == 1 && ps_count(state, "told to stop it") == 1;
}
#test "a stop and a wait in one step: the stop goes at once, the wait is the delegate line, and its result lands in order" {
  f: [1] McRunFixture; out: [16] McRunEvent;
  mc_run_fixture(f[..], "two things");
  r := f[0].r[..]; r[0].l[0].agents = true;
  ev := [2] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_STOP_AND_WAIT}, GwEvent.{kind = GW_EV_DONE, reason = "stop"}];
  h := mc_run_heard(r, out[..], ev[..]);
  n := mc_run_plain(r, out[..], h.k);
  #assert n == 2 && out[0].kind == MR_STOP_AGENT && out[0].agent == 2 && out[1].kind == MR_DELEGATE && out[1].ticket == 1;
  #assert out[1].text == "[{\"level\":\"hydrogen\",\"task\":\"keep going\",\"resume\":1}]";
  #assert r[0].delegating;
  n = mc_run_delegated(r, 1, "[{\"exit\":0,\"output\":\"all six found\"}]", out[..]);
  #assert !r[0].delegating && r[0].delegated;
  state := mc_state_json(r[0].l[0].st[..], r[0].l[0].prompt);
  #assert ps_count(state, "agent 2: stop") == 1 && ps_count(state, "agent hydrogen: keep going") == 1 && ps_count(state, "all six found") == 1 && ps_count(state, "did not run") == 0;
}

MC_RUN_NOTE :: "{\"rationale\":\"steer it\",\"delegate\":[{\"level\":\"carbon\",\"task\":\"Check the b fixtures too\",\"resume\":2}],\"edits\":[],\"commands\":[],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}";
#test "a note for a running sub-agent goes in the delegate line with its number, for the owner to send it as a steer" {
  f: [1] McRunFixture; out: [16] McRunEvent;
  mc_run_fixture(f[..], "two things");
  r := f[0].r[..]; r[0].l[0].agents = true;
  ev := [2] GwEvent.[GwEvent.{kind = GW_EV_TEXT, text = MC_RUN_NOTE}, GwEvent.{kind = GW_EV_DONE, reason = "stop"}];
  h := mc_run_heard(r, out[..], ev[..]);
  n := mc_run_plain(r, out[..], h.k);
  // the note is the task, the number its resume (GitHub #13776); the run waits on that sub-agent
  #assert n == 1 && out[0].kind == MR_DELEGATE && out[0].text == "[{\"level\":\"carbon\",\"task\":\"Check the b fixtures too\",\"resume\":2}]" && r[0].delegating;
  n = mc_run_delegated(r, out[0].ticket, "[{\"exit\":0,\"output\":\"b fixtures checked\"}]", out[..]);
  #assert !r[0].delegating && r[0].delegated;
  state := mc_state_json(r[0].l[0].st[..], r[0].l[0].prompt);
  #assert ps_count(state, "agent carbon: Check the b fixtures too") == 1 && ps_count(state, "b fixtures checked") == 1;
  // the run is told a running sub-agent takes the note
  #assert ps_count(MC_AGENTS, "the note reaches it as more input between its steps") == 1;
}

#test "attached images propagate into mc_request and format a descriptive view note" {
  f: [1] McRunFixture;
  mc_run_fixture(f[..], "describe the screenshot");
  r := f[0].r[..];
  r[0].img[0].images[0] = GwImage.{media_type = "image/png", data = "iVBORw0KGgo="};
  r[0].img[0].n = 1;
  r[0].l[0].images = r[0].img[0].images[0..<1];
  req := mc_request(r[0].l[..]);
  #assert req.messages.count == 1 && req.messages[0].images.count == 1;
  #assert req.messages[0].images[0].media_type == "image/png" && req.messages[0].images[0].data == "iVBORw0KGgo=";
  note_buf: [256] u8;
  note := mc_image_view_note("/Users/me/Desktop/Screenshot 2026.png", McImageLoad.{ok = true, media_type = "image/png", raw_bytes = 1024, b64 = "iVBORw0KGgo="}, note_buf[..]);
  #assert ps_count(note, "[image attached:") == 1 && ps_count(note, "image/png") == 1;
}

#test "mc_journal_clip keeps journal metadata within AJ_PAYLOAD on UTF-8 boundaries" {
  #assert mc_journal_clip("abc", 10) == "abc";
  #assert mc_journal_clip("abc", 3) == "abc";
  #assert mc_journal_clip("abc", 2) == "ab";
  #assert mc_journal_clip("abc", 0) == "";
  #assert mc_journal_clip("abc", -5) == "";
  // Multi-byte UTF-8: em-dash (3 bytes: e2 80 94) after 'a' must not split mid-codepoint.
  u := [5] u8.[97, 0xe2, 0x80, 0x94, 98];
  us := cast(string) u[..];
  #assert mc_journal_clip(us, 2) == "a";
  #assert mc_journal_clip(us, 3) == "a";
  #assert mc_journal_clip(us, 4).count == 4;
  // Commands longer than 8192 and AJ_PAYLOAD clip cleanly to AJ_PAYLOAD.
  cb: [AJ_PAYLOAD + 1024] u8;
  i := 0; while i < cb.count { cb[i] = 120; i += 1; }
  long_cmd := cast(string) cb[..];
  #assert mc_journal_clip(long_cmd, AJ_PAYLOAD).count == AJ_PAYLOAD;
  // Non-journaled gated ask still delivers the full command text.
  r: [1] McRun; sb: [1] McStateBuffers; lb: [1] McLoopBuffers;
  mc_init(r[0].l[..], sb[..], lb[..], "t", "long command", "{}", 0.9);
  r[0].gated = true;
  out: [8] McRunEvent;
  k := mc_run_ask(r[..], out[..], 0, long_cmd);
  #assert !r[0].ended && r[0].asking && k == 1 && out[0].kind == MR_ASK && out[0].text.count == long_cmd.count;
}

#test "smart step-0 seeding skips instruction/binary files and centers large files on matching task symbols" {
  #assert mc_seed_is_instr("AGENTS.md") && mc_seed_is_instr("sub/CLAUDE.md") && mc_seed_is_instr("agents.md") && !mc_seed_is_instr("loop.coax");
  #assert mc_seed_is_skip("coax/bin/coax") && mc_seed_is_skip("shot.png") && mc_seed_is_skip("model.gguf") && !mc_seed_is_skip("apps/host.c");
  // Build a 120-line file with __APPLE__ at line 5 and target_fn at line 95
  buf: [4096] u8; n := 0;
  for line: 1..<121 {
    if line == 5 { n = mc_put(buf[..], n, "#ifdef __APPLE__\n"); }
    else if line == 95 { n = mc_put(buf[..], n, "target_fn :: () -> int { return 1; }\n"); }
    else { n = mc_put(buf[..], n, "// filler line\n"); }
  }
  text := cast(string) buf[0..<n];
  names := [3] string.["__APPLE__", "missing_sym", "target_fn"];
  #assert mc_seed_anchor_line(text, names[..], 3) == 95;
  eb: [128] u8;
  #assert mc_seed_entry("big.coax", text, names[..], 3, eb[..]) == "big.coax:80-120";
  // Small file (<= MC_SEED_ANCHOR_MIN) stays unranged
  #assert mc_seed_entry("small.coax", "a\nb\ntarget_fn\n", names[..], 3, eb[..]) == "small.coax";
}

#test "cache-adaptive compaction tracks low-cache paid cloud attempts without touching local psionic or cached cloud" {
  f: [1] McRunFixture;
  mc_run_fixture(f[..], "fix it");
  r := f[0].r[..];
  // Local psionic never triggers low_cache_calls (keeps full Metal/CUDA KV cache)
  mc_run_note_cache(r, GwAttemptLog.{gateway = "psionic", outcome = GW_OUT_DONE, input_tokens = 12000, usage = GwUsage.{observed = 7, input_tokens = 12000, cached_tokens = 0}});
  #assert r[0].low_cache_calls == 0;
  // Paid cloud with <25% cache hit increments low_cache_calls
  mc_run_note_cache(r, GwAttemptLog.{gateway = "vertex", outcome = GW_OUT_DONE, input_tokens = 12000, usage = GwUsage.{observed = 3, input_tokens = 12000, cached_tokens = 0}});
  #assert r[0].low_cache_calls == 1;
  // Paid cloud with >=25% cache hit resets low_cache_calls to 0
  mc_run_note_cache(r, GwAttemptLog.{gateway = "vertex", outcome = GW_OUT_DONE, input_tokens = 12000, usage = GwUsage.{observed = 7, input_tokens = 12000, cached_tokens = 6000}});
  #assert r[0].low_cache_calls == 0;
  // mc_compact_keep_steps preserves at least the latest 2 closed steps verbatim even when each exceeds keep_bytes
  big: [5000] u8; for i: 0..<big.count { big[i] = 'a'; }
  for k: 0..<3 { mc_action_begin(r[0].l[0].st[..], "view"); mc_file(r[0].l[0].st[..], "f.coax", true, cast(string) big[..]); mc_action_end(r[0].l[0].st[..]); }
  #assert r[0].l[0].st[0].nacts == 3;
  mc_compact_keep_steps(r[0].l[0].st[..], 1024, 2);
  #assert r[0].l[0].st[0].nacts == 2 && r[0].l[0].st[0].nearly == 1;
  // Calling again with only 2 closed steps leaves both untouched
  mc_compact_keep_steps(r[0].l[0].st[..], 1024, 2);
  #assert r[0].l[0].st[0].nacts == 2 && r[0].l[0].st[0].nearly == 1;
}

#test "view shell command interceptor catches vim hangs and rejects multi-arg or piped commands" {
  #assert mc_cmd_view_arg("view apps/todos.coax:110-170") == "apps/todos.coax:110-170";
  #assert mc_cmd_view_arg("  view a.c  ") == "a.c";
  #assert mc_cmd_view_arg("view -R a.c") == "";
  #assert mc_cmd_view_arg("view a.c b.c") == "";
  #assert mc_cmd_view_arg("view a.c | head") == "";
  #assert mc_cmd_view_arg("git status") == "";
}

#test "dual-plan hybrid routing starts local, escalates on step/time/repeated-failure, routes verified closing turn and budget-capped steps to free local" {
  f: [1] McRunFixture; hy: [1] McHybrid;
  mc_run_fixture(f[..], "fix the bug");
  l := f[0].r[0].l[..];
  mc_hybrid_init(hy[..], 2, 60000, true, 1000);
  // Step 1 and 2 stay local (a single failed step does not prematurely escalate)
  #assert !mc_hybrid_select(l, hy[..], 5000) && !hy[0].escalated && hy[0].local_steps == 1;
  hy[0].step_failed = true;
  #assert !mc_hybrid_select(l, hy[..], 10000) && !hy[0].escalated && hy[0].local_steps == 2 && hy[0].local_fails == 1;
  // Step 3 hits step cap -> escalates to Neon
  #assert mc_hybrid_select(l, hy[..], 15000) && hy[0].escalated && hy[0].use_cloud;
  // Once a check passes with no failure and no views -> closing step routes back to free local once
  l[0].check[0].state = MC_CHECK_PASSED;
  #assert !mc_hybrid_select(l, hy[..], 20000) && hy[0].local_finish_tried && !hy[0].use_cloud;
  // If local didn't finish, subsequent step falls back to Neon
  #assert mc_hybrid_select(l, hy[..], 25000) && hy[0].use_cloud;
  // Budget-aware cloud fallback: hitting 75% of cloud_budget_micros routes to free local ($0)
  hy[0].cloud_budget_micros = 200000;
  hy[0].cloud_cost_micros = 152000;
  #assert !mc_hybrid_select(l, hy[..], 26000) && !hy[0].use_cloud && hy[0].cloud_capped;
  // Early escalation on 2 consecutive failed local steps
  mc_hybrid_init(hy[..], 4, 90000, true, 1000);
  #assert !mc_hybrid_select(l, hy[..], 2000) && !hy[0].escalated;
  hy[0].step_failed = true;
  #assert !mc_hybrid_select(l, hy[..], 3000) && !hy[0].escalated && hy[0].local_fails == 1;
  hy[0].step_failed = true;
  #assert mc_hybrid_select(l, hy[..], 4000) && hy[0].escalated && hy[0].use_cloud;
}

#test "mc_run_steered_on reopens finished, asked, and idle turns, resets idle/stall/reply, and enforces MC_STEERS (#13978)" {
  f: [1] McRunFixture; st: [1] McSteers;
  mc_run_fixture(f[..], "look");
  r := f[0].r[..]; l := r[0].l[..];
  // No steers slice attached -> false
  l[0].ending = MC_END_FINISHED;
  #assert !mc_run_steered_on(r);
  // Attached but empty -> false
  r[0].steers = st[..];
  #assert !mc_run_steered_on(r);
  // Non-reopenable ending (stopped) -> false even with a pending steer
  #assert mc_steer_add(st[..], "s1", "keep going") == "";
  l[0].ending = MC_END_STOPPED;
  #assert !mc_run_steered_on(r) && st[0].n == 1;
  // Reopens MC_END_FINISHED and resets ending, idle, stall streak, and reply
  l[0].ending = MC_END_FINISHED; l[0].idle = 2; l[0].stall[0].count = 4; l[0].reply = "prior";
  #assert mc_run_steered_on(r);
  #assert l[0].ending == MC_END_NONE && l[0].idle == 0 && mc_stall_count(l) == 0 && l[0].reply == "";
  // Reopens MC_END_ASKED and MC_END_IDLE
  #assert mc_steer_add(st[..], "s2", "answer") == "";
  l[0].ending = MC_END_ASKED;
  #assert mc_run_steered_on(r) && l[0].ending == MC_END_NONE;
  #assert mc_steer_add(st[..], "s3", "retry") == "";
  l[0].ending = MC_END_IDLE;
  #assert mc_run_steered_on(r) && l[0].ending == MC_END_NONE;
  // Exact MC_STEERS cap refuses further steering
  #assert mc_steer_add(st[..], "s4", "capped") == "";
  st[0].nd = MC_STEERS;
  l[0].ending = MC_END_FINISHED;
  #assert !mc_run_steered_on(r) && st[0].n == 1;
}
