// A Microcoder run for a frame loop (docs/coder/microcoder.md, "What the
// Lab shows"): the loop, a plan and the tools behind one poll, which hands
// back what a transcript draws: each step's attempt (gateway, model,
// status), its commands with exit codes and output, the reply as it streams
// (the next_action's "reply" text, read out of the JSON while it arrives),
// and the ending. mc_run_stop is STOP: curl goes and the run ends stopped.
//
// Infrastructure only: the Mac app's Lab and /chat call this when the
// owner asks for the wiring. Model calls never block a poll; a step's
// commands run inside the poll that starts them (30 s each at most, or the owner's
// command_seconds).
//
// Checks: coax test coax/lib/microcoder/run.coax --library (no main of its own).

#load "tools.coax";
#load "../gateway/plan.coax";

// ---------------------------------------------------------------- the reply as it streams

// Reads a next_action object byte by byte and hands out its top-level
// "reply" string's text as it arrives, decoded (escapes, \u with surrogate
// pairs). Other fields, nested values and keys are skipped.
McReplyStream :: struct {
  depth: int;
  in_str: bool; esc: bool;
  hex: int; nhex: int;           // a \uXXXX being read (nhex digits so far), -1 when none
  high: int;                     // a high surrogate waiting for its low half
  key: [8] u8; nk: int; key_long: bool;   // the key being read at depth 1
  is_key: bool;                  // the string being read is a key
  want_value: bool;              // after "key": at depth 1
  in_reply: bool;                // inside the reply value's string
  reply_key: bool;               // the last key was "reply"
}

mc_rs_reset :: (rs: [] McReplyStream) { rs[0] = McReplyStream.{nhex = -1}; }

mc_rs_put :: (out: [] u8, n: int, c: u8) -> int {
  if n < 0 || n >= out.count { return n; }
  out[n] = c;
  return n + 1;
}

// Feeds text; the reply's new bytes go to out; how many.
mc_rs_feed :: (rs: [] McReplyStream, text: string, out: [] u8) -> int {
  n := 0;
  for c: text {
    if rs[0].in_str {
      if rs[0].nhex >= 0 {
        d := json_hex(c);
        if d < 0 { rs[0].nhex = -1; continue; }
        rs[0].hex = rs[0].hex * 16 + d; rs[0].nhex += 1;
        if rs[0].nhex < 4 { continue; }
        cp := rs[0].hex; rs[0].nhex = -1;
        if cp >= 0xD800 && cp < 0xDC00 { rs[0].high = cp; continue; }
        if cp >= 0xDC00 && cp < 0xE000 && rs[0].high > 0 { cp = 0x10000 + ((rs[0].high - 0xD800) << 10) + (cp - 0xDC00); }
        rs[0].high = 0;
        if rs[0].in_reply { m := json_put_cp(out, n, cp); if m > 0 { n = m; } }
        continue;
      }
      if rs[0].esc {
        rs[0].esc = false;
        if c == 'u' { rs[0].nhex = 0; rs[0].hex = 0; continue; }
        e := c;
        if c == 'n' { e = 10; } else if c == 't' { e = 9; } else if c == 'r' { e = 13; } else if c == 'b' { e = 8; } else if c == 'f' { e = 12; }
        if rs[0].in_reply { n = mc_rs_put(out, n, e); }
        else if rs[0].is_key { if rs[0].nk < 8 { rs[0].key[rs[0].nk] = e; rs[0].nk += 1; } else { rs[0].key_long = true; } }
        continue;
      }
      if c == '\\' { rs[0].esc = true; continue; }
      if c == '"' {
        rs[0].in_str = false;
        if rs[0].is_key {
          rs[0].is_key = false;
          rs[0].reply_key = !rs[0].key_long && cast(string) rs[0].key[0..<rs[0].nk] == "reply";
        }
        rs[0].in_reply = false;
        continue;
      }
      if rs[0].in_reply { n = mc_rs_put(out, n, c); }
      else if rs[0].is_key { if rs[0].nk < 8 { rs[0].key[rs[0].nk] = c; rs[0].nk += 1; } else { rs[0].key_long = true; } }
      continue;
    }
    if c == '"' {
      rs[0].in_str = true;
      if rs[0].depth == 1 && !rs[0].want_value { rs[0].is_key = true; rs[0].nk = 0; rs[0].key_long = false; }
      else if rs[0].depth == 1 && rs[0].want_value { rs[0].in_reply = rs[0].reply_key; rs[0].want_value = false; }
      continue;
    }
    if c == ':' && rs[0].depth == 1 { rs[0].want_value = true; continue; }
    if c == ',' && rs[0].depth == 1 { rs[0].want_value = false; rs[0].reply_key = false; continue; }
    if c == '{' || c == '[' { if rs[0].depth == 1 && rs[0].want_value { rs[0].want_value = false; } rs[0].depth += 1; continue; }
    if c == '}' || c == ']' { rs[0].depth -= 1; continue; }
    if rs[0].depth == 1 && rs[0].want_value && c != ' ' && c != '\n' && c != '\t' && c != '\r' { rs[0].want_value = false; }
  }
  return n;
}

// ---------------------------------------------------------------- the run

MR_ATTEMPT :: 1;                 // log: an attempt of this step ended (gateway, model, status ...)
MR_REPLY :: 2;                   // text: more of the reply
MR_COMMAND :: 3;                 // text: the command; exit, timed_out, output
MR_VIEW :: 4;                    // text: the path; found
MR_STEP :: 5;                    // a step ended; step: its number
MR_ENDED :: 6;                   // ending (MC_END_*), text: the reply (finished, asked) or why (no_capacity)
MR_ASK :: 7;                     // text: a command waiting for mc_run_answer (a gated run)

McRunEvent :: struct {
  kind: int;
  ticket:int;
  text: string;
  log: GwAttemptLog;
  exit: int;
  timed_out: bool;
  found: bool;
  output: string;
  step: int;
  ending: int;
}

McRun :: struct {
  l: [1] McLoop;
  p: [] GwPlan;
  bench: [] GwBench;
  cwd: string;
  effort: string;
  rs: [1] McReplyStream;
  calling: bool;
  logged: int;                   // plan log entries handed out this step
  ended: bool;
  profile:string="danger-full-access";
  ceiling:int=3;
  journal: [] JfWriter;
  deadline: int;
  effects: int;                  // commands and edits run (native-profile.coax NP_EFFECTS a run)
  reads: int;                    // files viewed, counted apart (NP_READS a run)
  refused: string;               // which limit refused the last effect, "" when it was not a limit
  gated: bool;                   // each command waits for mc_run_answer: the host's hooks and approvals decide
  ask_ticket:int;
  asking: bool; ask_i: int;      // the pending action's command waiting for an answer
  command_seconds: int;          // a command's time limit; 0 is MC_COMMAND_SECONDS (an unattended owner gives more, and tells the model in the facts)
  sp: [] GwPlan;                 // the run's own plan; p is the plan of the call that is out
  fp: [] GwPlan;                 // the fast model's plan, for the calls the loop lets go there (mc_next_fast); none: one model
  seed: bool;                    // before the first call, look up what the task names (mc_run_seed)
  seeded: bool;
  rbuf: [4096] u8;               // this poll's reply bytes
  obuf: [131072] u8; nob: int;   // this poll's command outputs: the tools reuse their buffer per command
  tb: [1] McToolBuffers;
}

// A command's output kept for this poll's events (cut to what is left).
mc_run_keep :: (r: [] McRun, s: string) -> string {
  at := r[0].nob;
  n := s.count;
  if n > r[0].obuf.count - at { n = r[0].obuf.count - at; }
  for i: 0..<n { r[0].obuf[at + i] = s[i]; }
  r[0].nob = at + n;
  return cast(string) r[0].obuf[at..<at + n];
}

// A journaled run's time budget: 15 minutes, as long as an unattended task gets (GitHub #13231:
// at 5 minutes Argon's run of a five-file change ended mid-task as "run budget exhausted").
MC_RUN_MS :: 900000;

// Starts a run of the loop already set up in r.l (mc_init) through plan p
// (gw_plan_add its attempts first); effort "" leaves it to the provider.
mc_run_start :: (r: [] McRun, p: [] GwPlan, bench: [] GwBench, cwd: string, effort: string) {
  r[0].p = p; r[0].sp = p; r[0].bench = bench; r[0].cwd = cwd; r[0].effort = effort; r[0].ended = false;
  r[0].journal=p[0].journal;r[0].deadline=0;now:=cxproc_now_ms();if now>=0 && now<=9223372036854475807 {r[0].deadline=now+MC_RUN_MS;}r[0].effects=0;r[0].reads=0;r[0].refused="";
  r[0].seeded = false;
  if !r[0].seed { mc_run_call(r); }       // a seeded run's first poll looks things up, then calls
}

// The seeded first step (GitHub #13325; loop.coax mc_seed_scan): before the first call, the
// files the task mentions that exist under the working directory are viewed (the first
// MC_SEED_FILES of them, each as any view: 64 KB at most, no binary), and each code name it
// mentions is looked up (git grep, its first 8 lines; in a git checkout only). They are one
// step in the state, given out and journaled like any step's views and commands. A task that
// names nothing found leaves no step. Then the first call goes out.
MC_SEED_FILES :: 4;
mc_run_seed :: (r: [] McRun, out: [] McRunEvent) -> int {
  r[0].seeded = true; r[0].nob = 0;
  l := r[0].l[..]; k := 0;
  s: [1] McSeed; mc_seed_scan(l[0].st[0].task, s[..]);
  pb: [FS_PATH_MAX] u8; viewed := 0; begun := false;
  for i: 0..<s[0].np {
    if viewed >= MC_SEED_FILES { break; }
    p := s[0].paths[i];
    full := fs_join(r[0].cwd, p, pb[..]);
    if full.count == 0 || fs_kind(full) != FS_FILE { continue; }
    if !mc_run_intent(r, AjKind.view_intent, p) { return mc_run_failed(r, out, k); }
    v := mc_view_file_profile(r[0].cwd, p, r[0].tb[0].view[..], r[0].profile);
    if r[0].journal.count>0 && (!jf_output(r[0].journal,v.content) || !jf_result(r[0].journal,ifx v.found then "found=true" else "found=false")) {return mc_run_failed(r,out,k);}
    if !v.found || v.content == MC_VIEW_BINARY { continue; }
    if !begun { mc_action_begin(l[0].st[..], MC_SEED_RATIONALE); begun = true; }
    mc_view(l, p, true, v.content);
    k = mc_run_put(out, k, McRunEvent.{kind = MR_VIEW, text = p, found = true});
    viewed += 1;
  }
  git := fs_join(r[0].cwd, ".git", pb[..]);
  if git.count > 0 && fs_exists(git) {
    for i: 0..<s[0].nn {
      cb: [256] u8;
      n := json_raw(cb[..], 0, "git grep -n -w -F -e "); n = json_raw(cb[..], n, s[0].names[i]); n = json_raw(cb[..], n, " | head -n 8");
      if n < 0 { continue; }
      if !begun { mc_action_begin(l[0].st[..], MC_SEED_RATIONALE); begun = true; }
      k = mc_run_one(r, out, k, mc_run_keep(r, cast(string) cb[0..<n]));
      if r[0].ended { return k; }
    }
  }
  if begun { mc_action_end(l[0].st[..]); }
  mc_run_call(r);
  return k;
}

mc_run_call :: (r: [] McRun) {
  if r[0].journal.count>0 && !np_budget(true,r[0].l[0].steps,cxproc_now_ms(),r[0].deadline) {
    r[0].l[0].ending=MC_END_FAILED;r[0].l[0].why=mc_run_limit(MC_LIMIT_CALL,r[0].l[0].steps,cxproc_now_ms(),r[0].deadline);return;
  }
  req := mc_request(r[0].l[..]);
  if r[0].effort.count > 0 { req.effort = r[0].effort; }
  mc_rs_reset(r[0].rs[..]);
  r[0].p = ifx r[0].fp.count > 0 && mc_next_fast(r[0].l[..]) then r[0].fp else r[0].sp;
  r[0].logged = 0;
  gw_plan_start(r[0].p, r[0].bench, req);
  r[0].calling = true;
}

mc_run_put :: (out: [] McRunEvent, n: int, e: McRunEvent) -> int {
  if n >= out.count { return n; }
  out[n] = e;
  return n + 1;
}

mc_run_logs :: (r: [] McRun, out: [] McRunEvent, k: int) -> int {
  n := k;
  while r[0].logged < r[0].p[0].nlog && n < out.count {
    n = mc_run_put(out, n, McRunEvent.{kind = MR_ATTEMPT, log = r[0].p[0].log[r[0].logged]});
    r[0].logged += 1;
  }
  return n;
}

mc_run_end :: (r: [] McRun, out: [] McRunEvent, k: int) -> int {
  r[0].ended = true;
  l := r[0].l[..];
  if r[0].journal.count>0 && !r[0].journal[0].flow.chain.failed && r[0].journal[0].flow.phase!=AfPhase.closed {
    if !jf_stop(r[0].journal,mc_ending_name(l[0].ending)) {l[0].ending=MC_END_FAILED;l[0].why="durable stop failed; inspect the journal before retrying";}
  }
  text := ifx l[0].ending == MC_END_NO_CAPACITY || l[0].ending==MC_END_FAILED then l[0].why else l[0].reply;
  return mc_run_put(out, k, McRunEvent.{kind = MR_ENDED, ending = l[0].ending, text = text});
}

// What happened since the last poll (give out 16 or more). Model calls
// never block; a step's commands run here when the step asks for them.
mc_run_poll :: (r: [] McRun, out: [] McRunEvent) -> int {
  if r[0].ended || r[0].asking { return 0; }
  if r[0].l[0].ending==MC_END_FAILED {return mc_run_end(r,out,0);}
  if r[0].seed && !r[0].seeded { return mc_run_seed(r, out); }
  if r[0].journal.count>0 && cxproc_now_ms()>=r[0].deadline {gw_plan_stop(r[0].p);r[0].refused="time limit reached: a run has 15 minutes";return mc_run_failed(r,out,0);}
  l := r[0].l[..];
  k := 0;
  ev: [8] GwEvent;
  n := gw_plan_poll(r[0].p, r[0].bench, ev[..]);
  if r[0].journal.count>0 && r[0].journal[0].flow.chain.failed {return mc_run_failed(r,out,0);}
  status := MC_WAIT;
  rn := 0;
  for i: 0..<n {
    if ev[i].kind == GW_EV_TEXT { rn += mc_rs_feed(r[0].rs[..], ev[i].text, r[0].rbuf[rn..<r[0].rbuf.count]); }
    status = mc_feed(l, ev[i]);
  }
  if rn > 0 { k = mc_run_put(out, k, McRunEvent.{kind = MR_REPLY, text = cast(string) r[0].rbuf[0..<rn]}); }
  k = mc_run_logs(r, out, k);
  if status == MC_WAIT { return k; }
  r[0].calling = false;
  r[0].nob = 0;
  if status == MC_TOOLS {
    a := mc_pending(l);
    for i: 0..<a.ne { k = mc_run_edit(r, out, k, a.edits[i]); if r[0].ended { return k; } }
    if r[0].gated && a.nc > 0 {
      r[0].ask_i = 0;
      return mc_run_ask(r,out,k,a.commands[0]);
    }
    for i: 0..<a.nc { k = mc_run_one(r, out, k, a.commands[i]);if r[0].ended {return k;} }
    return mc_run_after(r, out, k);
  }
  return mc_run_next(r, out, k, status);
}

// The live journal owns every effect ticket. Any uncertain completion ends
// the run; a later call never silently retries the pending operation.
// A view inside the workspace changes nothing, so views spend a budget of their own (NP_READS)
// and commands and edits keep theirs (NP_EFFECTS): GitHub #13325.
mc_run_intent :: (r:[]McRun,kind:AjKind,target:string)->bool {
  r[0].refused="";
  view:=kind==AjKind.view_intent;
  if !np_tool_admit(r[0].ceiling,kind==AjKind.command_intent) {r[0].refused="this run may not run commands: its effect ceiling is frozen below them";return false;}
  if r[0].journal.count==0 {return true;}
  now:=cxproc_now_ms();
  within:=ifx view then np_read_budget(r[0].reads,now,r[0].deadline) else np_budget(false,r[0].effects,now,r[0].deadline);
  if !within || r[0].deadline-now<1000 {
    r[0].refused=mc_run_limit(ifx view then MC_LIMIT_READ else MC_LIMIT_EFFECT,ifx view then r[0].reads else r[0].effects,now,r[0].deadline-1000);
    return false;
  }
  if !jf_intent(r[0].journal,kind,target) {return false;}
  if view {r[0].reads+=1;} else {r[0].effects+=1;}
  return true;
}

// Which limit a refused call, command or view ran into, for the ending: the count's own
// (model calls, commands and edits, views) or the run's time.
MC_LIMIT_CALL :: 0; MC_LIMIT_EFFECT :: 1; MC_LIMIT_READ :: 2;
mc_run_limit :: (what:int,used:int,now:int,deadline:int)->string {
  if what==MC_LIMIT_CALL && used>=NP_MODEL_CALLS {return "model call limit reached: a run has 64 model calls";}
  if what==MC_LIMIT_EFFECT && used>=NP_EFFECTS {return "command limit reached: a run has 128 commands and edits";}
  if what==MC_LIMIT_READ && used>=NP_READS {return "read limit reached: a run has 512 file views";}
  if now>=deadline {return "time limit reached: a run has 15 minutes";}
  return "run budget refused";
}
#test "an ending names the limit that was hit: model calls, commands, views or time" {
  #assert mc_run_limit(MC_LIMIT_CALL,64,0,10)=="model call limit reached: a run has 64 model calls" && mc_run_limit(MC_LIMIT_CALL,63,10,10)=="time limit reached: a run has 15 minutes";
  #assert mc_run_limit(MC_LIMIT_EFFECT,128,0,10)=="command limit reached: a run has 128 commands and edits" && mc_run_limit(MC_LIMIT_EFFECT,127,11,10)=="time limit reached: a run has 15 minutes";
  #assert mc_run_limit(MC_LIMIT_READ,512,0,10)=="read limit reached: a run has 512 file views" && mc_run_limit(MC_LIMIT_READ,128,0,10)=="run budget refused";
  #assert mc_run_limit(MC_LIMIT_READ,511,9,10)=="run budget refused" && mc_run_limit(MC_LIMIT_READ,0,10,10)=="time limit reached: a run has 15 minutes";
  #assert MC_RUN_MS==900000 && NP_MODEL_CALLS==64 && NP_EFFECTS==128 && NP_READS==512;     // the numbers the messages give
}
// A run that fails on a limit says which; any other refusal (the journal) keeps the warning
// that an effect may be outstanding.
mc_run_failed :: (r:[]McRun,out:[]McRunEvent,k:int)->int {
  r[0].l[0].ending=MC_END_FAILED;
  r[0].l[0].why=ifx r[0].refused.count>0 then r[0].refused else "the journal refused; an outstanding effect may have happened; inspect before retrying";
  r[0].refused="";
  r[0].asking=false;return mc_run_end(r,out,k);
}

// One command run, its result recorded and given out.
mc_run_one :: (r: [] McRun, out: [] McRunEvent, k: int, command: string) -> int {
  if !mc_run_intent(r,AjKind.command_intent,command) {return mc_run_failed(r,out,k);}
  seconds:=ifx r[0].command_seconds>0 then r[0].command_seconds else MC_COMMAND_SECONDS;
  if r[0].journal.count>0 {left:=(r[0].deadline-cxproc_now_ms())/1000;if left<seconds {seconds=left;}if seconds<1 {r[0].refused="time limit reached: a run has 15 minutes";return mc_run_failed(r,out,k);}}
  res := mc_run_command_profile(r[0].cwd, command, seconds, r[0].tb[0].out[..],r[0].profile);
  metadata:[128]u8;m:=json_raw(metadata[..],0,"exit=");m=json_write_int(metadata[..],m,res.exit);
  m=json_raw(metadata[..],m,ifx res.timed_out then " timed_out=true" else " timed_out=false");
  if r[0].journal.count>0 && (!jf_output(r[0].journal,res.output) || !jf_result(r[0].journal,cast(string)metadata[0..<m])) {return mc_run_failed(r,out,k);}
  mc_command(r[0].l[..], command, res.exit, res.timed_out, res.output);
  return mc_run_put(out, k, McRunEvent.{kind = MR_COMMAND, text = command, exit = res.exit, timed_out = res.timed_out, output = mc_run_keep(r, res.output)});
}

// One exact edit, applied and given out as a command row ("edit PATH", exit 0 or 1, the
// result as output). A gated run's changes wait for approval, which edits have no way to ask
// for: there the model is told to make the change with a command.
mc_run_edit :: (r: [] McRun, out: [] McRunEvent, k: int, e: McEdit) -> int {
  tb: [1100] u8; tn := json_raw(tb[..], 0, "edit "); tn = json_raw(tb[..], tn, e.path);
  label := ifx tn < 0 then "edit" else cast(string) tb[0..<tn];
  if r[0].gated {
    why := "each change in this run waits for approval: make this one with a command";
    mc_edited(r[0].l[..], e.path, false, why);
    return mc_run_put(out, k, McRunEvent.{kind = MR_COMMAND, text = mc_run_keep(r, label), exit = 126, output = mc_run_keep(r, why)});
  }
  if !mc_run_intent(r, AjKind.command_intent, label) { return mc_run_failed(r, out, k); }
  res := mc_edit_file(r[0].cwd, e, r[0].profile, r[0].tb[..]);
  if r[0].journal.count > 0 && (!jf_output(r[0].journal, ifx res.ok then "applied" else res.why) || !jf_result(r[0].journal, ifx res.ok then "exit=0 timed_out=false" else "exit=1 timed_out=false")) { return mc_run_failed(r, out, k); }
  mc_edited(r[0].l[..], e.path, res.ok, res.why);
  return mc_run_put(out, k, McRunEvent.{kind = MR_COMMAND, text = mc_run_keep(r, label), exit = ifx res.ok then 0 else 1, output = mc_run_keep(r, ifx res.ok then "applied" else res.why)});
}

// After the step's commands: its views, then the next call or the end.
mc_run_after :: (r: [] McRun, out: [] McRunEvent, k0: int) -> int {
  l := r[0].l[..]; a := mc_pending(l); k := k0;
  for i: 0..<a.nv {
    if !mc_run_intent(r,AjKind.view_intent,a.view[i]) {return mc_run_failed(r,out,k);}
    v := mc_view_file_profile(r[0].cwd, a.view[i], r[0].tb[0].view[..],r[0].profile);
    if r[0].journal.count>0 && (!jf_output(r[0].journal,v.content) || !jf_result(r[0].journal,ifx v.found then "found=true" else "found=false")) {return mc_run_failed(r,out,k);}
    mc_view(l, a.view[i], v.found, v.content);
    k = mc_run_put(out, k, McRunEvent.{kind = MR_VIEW, text = a.view[i], found = v.found});
  }
  return mc_run_next(r, out, k, mc_tools_done(l));
}

mc_run_next :: (r: [] McRun, out: [] McRunEvent, k0: int, status: int) -> int {
  k := mc_run_put(out, k0, McRunEvent.{kind = MR_STEP, step = r[0].l[0].steps});
  if status == MC_ENDED { return mc_run_end(r, out, k); }
  mc_run_call(r);
  return k;
}

// A gated run's answer for the command in its MR_ASK: allowed, it runs; refused,
// the model sees why. Then the next command's MR_ASK, or the step goes on.
mc_run_answer :: (r: [] McRun, allow: bool, why: string, out: [] McRunEvent) -> int {
  if r[0].ended || !r[0].asking { return 0; }
  r[0].nob = 0;
  l := r[0].l[..]; a := mc_pending(l); i := r[0].ask_i;
  k := 0;
  if r[0].journal.count>0 {
    b:[8192]u8;n:=json_raw(b[..],0,ifx allow then "allow " else "refuse ");n=json_raw(b[..],n,a.commands[i]);n=json_raw(b[..],n," reason=");n=json_raw(b[..],n,why);
    if n<0 || !jf_decision(r[0].journal,cast(string)b[0..<n]) {return mc_run_failed(r,out,0);}
  }
  if allow { k = mc_run_one(r, out, k, a.commands[i]);if r[0].ended {return k;} }
  else {
    mc_action_refused(l[0].st[..], a.commands[i], why);
    k = mc_run_put(out, k, McRunEvent.{kind = MR_COMMAND, text = a.commands[i], exit = 126, output = mc_run_keep(r, why)});
  }
  r[0].ask_i = i + 1;
  if r[0].ask_i < a.nc { return mc_run_ask(r,out,k,a.commands[r[0].ask_i]); }
  r[0].asking = false;
  return mc_run_after(r, out, k);
}

// STOP: the running call's curl goes and the run ends stopped.
mc_run_stop :: (r: [] McRun, out: [] McRunEvent) -> int {
  if r[0].ended { return 0; }
  r[0].asking = false;
  gw_plan_stop(r[0].p);
  mc_stop(r[0].l[..]);
  k := mc_run_logs(r, out, 0);
  return mc_run_end(r, out, k);
}

// ---------------------------------------------------------------- checks

#test "the reply streams out of a next_action as it arrives, in any split, decoded" {
  whole := "{\"rationale\":\"a \\\"reply\\\" here is not it\",\"commands\":[\"echo {\\\"reply\\\":1}\"],\"view\":[],\"finished\":true,\"reply\":\"2 + 2 = 4.\\nCaf\\u00e9 \\ud83d\\ude00 \\\"ok\\\"\",\"ask\":\"none\"}";
  want := "2 + 2 = 4.\nCafé 😀 \"ok\"";
  for size: 1..<12 {
    rs: [1] McReplyStream; mc_rs_reset(rs[..]);
    got: [256] u8; ng := 0;
    at := 0;
    while at < whole.count {
      e := ifx at + size < whole.count then at + size else whole.count;
      ng += mc_rs_feed(rs[..], cast(string) whole[at..<e], got[ng..<got.count]);
      at = e;
    }
    #assert cast(string) got[0..<ng] == want;
  }
}

#test "no reply text comes from other fields, nested objects or a reply-like key" {
  rs: [1] McReplyStream; mc_rs_reset(rs[..]);
  got: [256] u8;
  n := mc_rs_feed(rs[..], "{\"replying\":\"no\",\"x\":{\"reply\":\"nested\"},\"reply\":\"\",\"ask\":\"question\"}", got[..]);
  #assert n == 0;
  mc_rs_reset(rs[..]);
  n = mc_rs_feed(rs[..], "{\"reply\" : \"spaced\"}", got[..]);
  #assert cast(string) got[0..<n] == "spaced";
}

#test "each command's output in a poll keeps its own bytes, cut when the poll's buffer is full" {
  r: [1] McRun;
  tool: [8] u8;
  tool[0] = 'o'; tool[1] = 'n'; tool[2] = 'e';
  first := mc_run_keep(r[..], cast(string) tool[0..<3]);
  tool[0] = 't'; tool[1] = 'w'; tool[2] = 'o';      // the tools' buffer, reused by the next command
  second := mc_run_keep(r[..], cast(string) tool[0..<3]);
  #assert first == "one" && second == "two";
  r[0].nob = r[0].obuf.count - 2;
  #assert mc_run_keep(r[..], "abc") == "ab" && mc_run_keep(r[..], "d") == "";
}

// Tickets never reset between turns in this worker. A late answer cannot
// authorize a different command or the next turn's proposal.
mc_run_ask :: (r:[]McRun,out:[]McRunEvent,k:int,command:string)->int {
  if r[0].ask_ticket==9223372036854775807 {return mc_run_failed(r,out,k);}
  r[0].ask_ticket+=1;r[0].asking=true;
  b:[8192]u8;n:=json_raw(b[..],0,"proposal=");n=json_write_int(b[..],n,r[0].ask_ticket);n=json_raw(b[..],n," command=");n=json_raw(b[..],n,command);
  if r[0].journal.count>0 && (n<0 || !jf_decision(r[0].journal,cast(string)b[0..<n])) {return mc_run_failed(r,out,k);}
  return mc_run_put(out,k,McRunEvent.{kind=MR_ASK,ticket=r[0].ask_ticket,text=command});
}
mc_run_answer_owned :: (r:[]McRun,ticket:int,allow:bool,why:string,out:[]McRunEvent)->int {
  if ticket<=0 || ticket!=r[0].ask_ticket {return 0;}
  return mc_run_answer(r,allow,why,out);
}
#test "stale approval answers leave the current proposal untouched" {
  r:[1]McRun;r[0].asking=true;r[0].ask_ticket=3;out:[16]McRunEvent;
  #assert mc_run_answer_owned(r[..],2,true,"",out[..])==0;
  #assert mc_run_answer_owned(r[..],0,true,"",out[..])==0;
  #assert mc_run_answer_owned(r[..],4,true,"",out[..])==0;
  #assert r[0].asking && r[0].ask_ticket==3 && !r[0].ended;
}
