// The tools against a real folder (tools_smoke.sh makes it): a command's
// output, a command past its timeout killed and recorded, views inside and
// outside the working directory, exact edits, and a loop step's tools recorded in state.

#import "Basic";
#load "tools.coax";

main :: () {
  dirb: [512] u8;
  dir := gw_env("MC_SMOKE_DIR", dirb[..]);
  b: [1] McToolBuffers;
  r := mc_run_command(dir, "ls *.swift | wc -l | tr -d ' '", 30, b[0].out[..]);
  print("count: exit % timed_out % output [%]\n", r.exit, r.timed_out, r.output);
  ok := r.exit == 0 && !r.timed_out && r.output == "3\n";
  t0 := cxproc_now_ms();
  r = mc_run_command(dir, "echo started; sleep 20; echo never", 1, b[0].out[..]);
  ms := cxproc_now_ms() - t0;
  print("timeout: exit % timed_out % after %ms output [%]\n", r.exit, r.timed_out, ms, r.output);
  ok = ok && r.timed_out && r.exit == -1 && ms < 4000 && r.output == "started\n\n[killed after 1 s]";
  r = mc_run_command(dir, "echo out; echo err 1>&2; exit 3", 30, b[0].out[..]);
  print("fail: exit % output [%]\n", r.exit, r.output);
  ok = ok && r.exit == 3 && r.output == "out\nerr\n";
  v := mc_view_file(dir, "a.swift", b[0].view[..]);
  print("view: found % [%]\n", v.found, v.content);
  ok = ok && v.found && v.content == "print(\"a\")";
  v = mc_view_file(dir, "../outside.txt", b[0].view[..]);
  ok = ok && !v.found;
  v = mc_view_file(dir, "missing.swift", b[0].view[..]);
  ok = ok && !v.found;
  // a step's tools into the loop's state
  sb: [1] McStateBuffers; lb: [1] McLoopBuffers; l: [1] McLoop;
  mc_init(l[..], sb[..], lb[..], "{}", "how many Swift files are in this folder", "{\"local_work\":0.9}", 0.9);
  x := mc_request(l[..]);
  s := mc_take(l[..], "{\"rationale\":\"count\",\"commands\":[\"ls *.swift | wc -l | tr -d ' '\"],\"view\":[\"b.swift\"],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}");
  ok = ok && s == MC_TOOLS && mc_run_tools(l[..], dir, b[..]) == MC_AGAIN;
  j := mc_state_json(l[0].st[..], lb[0].prompt[..]);
  ab: [256] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  ok = ok && cl_str(ar[..], j, "actions.0.results.0.output") == "3\n" && cl_str(ar[..], j, "actions.0.results.1.content") == "print(\"b\")";
  // exact edits: one place changed, a new file written, and the refusals
  e := mc_edit_file(dir, McEdit.{path = "a.swift", old = "\"a\"", text = "\"a2\""}, "danger-full-access", b[..]);
  v = mc_view_file(dir, "a.swift", b[0].view[..]);
  print("edit: ok % why [%] now [%]\n", e.ok, e.why, v.content);
  ok = ok && e.ok && v.content == "print(\"a2\")";
  e = mc_edit_file(dir, McEdit.{path = "sub/new.txt", old = "", text = "x"}, "danger-full-access", b[..]);
  ok = ok && !e.ok && e.why == "could not write the file: does its folder exist?";
  e = mc_edit_file(dir, McEdit.{path = "notes.txt", old = "", text = "one\none\n"}, "danger-full-access", b[..]);
  ok = ok && e.ok;
  e = mc_edit_file(dir, McEdit.{path = "notes.txt", old = "one", text = "two"}, "danger-full-access", b[..]);
  ok = ok && !e.ok && e.why == "the old text is in the file more than once: include more of the lines around it so it is unique";
  e = mc_edit_file(dir, McEdit.{path = "notes.txt", old = "three", text = "two"}, "danger-full-access", b[..]);
  ok = ok && !e.ok && e.why == "the old text is not in the file: copy it exactly, with its whitespace, from a view or the file";
  e = mc_edit_file(dir, McEdit.{path = "nope.txt", old = "a", text = "b"}, "danger-full-access", b[..]);
  ok = ok && !e.ok && e.why == "no such file (an empty old writes a new one)";
  // a view of a file over 64 KB says where it was cut
  r = mc_run_command(dir, "head -c 70000 /dev/zero | tr '\\0' 'x' > long.txt", 30, b[0].out[..]);
  v = mc_view_file(dir, "long.txt", b[0].view[..]);
  print("cut view: % bytes, ends [%]\n", v.content.count, cast(string) v.content[v.content.count - 40..<v.content.count]);
  ok = ok && v.found && v.content.count <= MC_VIEW_BYTES && cast(string) v.content[v.content.count - 30..<v.content.count] == "with a command such as sed -n]";
  // an edit in a step: recorded before the step's commands, which see it
  x = mc_request(l[..]);
  s = mc_take(l[..], "{\"rationale\":\"fix\",\"edits\":[{\"path\":\"b.swift\",\"old\":\"b\",\"new\":\"b2\"}],\"commands\":[\"cat b.swift\"],\"view\":[],\"finished\":false,\"reply\":\"\",\"ask\":\"none\"}");
  ok = ok && s == MC_TOOLS && mc_run_tools(l[..], dir, b[..]) == MC_AGAIN;
  j = mc_state_json(l[0].st[..], lb[0].prompt[..]);
  ar[0].at = 0;
  ok = ok && cl_bool(j, "actions.1.results.0.applied").value && cl_str(ar[..], j, "actions.1.results.1.output") == "print(\"b2\")\n";
  // what a failed run leaves (GitHub #13351): the commits since its start head, and the files left
  g := "git -c user.name=smoke -c user.email=smoke@example.invalid";
  gb: [512] u8; gn := 0;
  gn = json_raw(gb[..], 0, "git init -q . && git add -A && "); gn = json_raw(gb[..], gn, g); gn = json_raw(gb[..], gn, " commit -qm start");
  r = mc_run_command(dir, cast(string) gb[0..<gn], 30, b[0].out[..]);
  hb: [64] u8;
  head := mc_git_head(dir, "danger-full-access", b[0].out[..], hb[..]);
  gn = json_raw(gb[..], 0, "echo one > c.swift && "); gn = json_raw(gb[..], gn, g); gn = json_raw(gb[..], gn, " commit -qam 'Run commit one' && echo two > new.txt");
  r = mc_run_command(dir, cast(string) gb[0..<gn], 30, b[0].out[..]);
  wb: [8192] u8;
  w := mc_work_list(dir, head, "danger-full-access", b[0].out[..], "command limit reached", wb[..]);
  print("work list (start %):\n%\n", head, w);
  ok = ok && head.count == 40 && ps_count(w, "command limit reached\nCommits this run made (git log):\n") == 1 && ps_count(w, " Run commit one\n") == 1 && ps_count(w, " start") == 0;
  ok = ok && ps_count(w, "Files left changed or untracked (git status --short):\n?? new.txt") == 1;
  // outside a git checkout: the reason alone
  ok = ok && mc_git_head("/", "danger-full-access", b[0].out[..], hb[..]) == "" && mc_work_list("/", "", "danger-full-access", b[0].out[..], "time limit reached", wb[..]) == "time limit reached";
  print("smoke: %\n", ifx ok then "ok" else "FAILED");
}
