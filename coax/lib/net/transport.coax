// The byte-stream effects every native network client shares, declared once
// so that relay_conn.coax and http.coax load into one program:
// coax/platform/socket-native.c (TCP) and coax/platform/tls-native.c (TLS,
// verifying the chain and the host name; no switch to skip it). Their
// contracts are in socket-native.h and tls-native.h. Link both, with the
// flags from coax/platform/tls-env.sh.
#load "socket_foreign.coax";
cxtls_host_push :: (byte: int) -> int #foreign;
cxtls_connect :: (port: int, timeout_ms: int) -> int #foreign;
cxtls_write :: (h: int, byte: int) -> int #foreign;
cxtls_flush :: (h: int, timeout_ms: int) -> int #foreign;
cxtls_read :: (h: int, timeout_ms: int) -> int #foreign;
cxtls_byte :: (h: int, i: int) -> int #foreign;
cxtls_close :: (h: int) -> int #foreign;
