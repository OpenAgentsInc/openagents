// RFC 6455 WebSocket server half over caller-owned byte buffers: admit a
// client's opening request (GET, HTTP/1.1, Upgrade, Connection, version 13,
// a 16-byte base64 key), write the 101 response with Sec-WebSocket-Accept,
// read masked client frames, unmask them, and write unmasked server frames.
// A plain GET that asks for application/nostr+json is reported as a NIP-11
// request so the relay can answer it over HTTP. Message assembly, UTF-8,
// close codes and refusal codes are ws.coax's (ws_take, ws_close_code,
// ws_error_code), shared with the client. No I/O, no extensions, no
// subprotocols: a request offering them is still admitted and they are not
// selected. ws:// only; TLS is the transport's business.
#load "ws.coax";
#authority;

// Request results.
WSS_OK :: 0; WSS_MORE :: 1; WSS_TOO_BIG :: 2; WSS_METHOD :: 3; WSS_HEADER :: 4;
WSS_UPGRADE :: 5; WSS_CONNECTION :: 6; WSS_VERSION :: 7; WSS_KEY :: 8; WSS_NIP11 :: 9;
WssHello :: struct { status: int; consumed: int; key_from: int; key_to: int; }

#test "the RFC 6455 sample request is admitted and answered" {
  req := "GET /chat HTTP/1.1\r\nHost: server.example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nOrigin: http://example.com\r\nSec-WebSocket-Version: 13\r\n\r\nxy";
  h := wss_request(req);
  #assert h.status == WSS_OK && h.consumed == req.count - 2;
  #assert req[h.key_from..<h.key_to] == "dGhlIHNhbXBsZSBub25jZQ==";
  out: [256] u8;
  n := wss_accept_write(req[h.key_from..<h.key_to], out[..]);
  #assert n > 0 && cast(string) out[0..<n] == "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n";
  #assert wss_accept_write(req[h.key_from..<h.key_to], out[0..<n - 1]) == -1 && wss_accept_write(req[h.key_from..<h.key_to], out[0..<n]) == n;
  #assert wss_accept_write("", out[..]) == -1;
  // names and tokens fold case; Connection may be a list; extensions are ignored
  h = wss_request("GET / HTTP/1.1\r\nupgrade: WebSocket\r\nCONNECTION: keep-alive, Upgrade\r\nsec-websocket-key:  dGhlIHNhbXBsZSBub25jZQ== \r\nsec-websocket-version: 13\r\nSec-WebSocket-Extensions: permessage-deflate\r\n\r\n");
  #assert h.status == WSS_OK && h.key_to - h.key_from == 24;
}
#test "requests that are not WebSocket upgrades" {
  k := "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n";
  #assert wss_request("GET / HTTP/1.1\r\nHost: h").status == WSS_MORE && wss_request("").status == WSS_MORE;
  #assert wss_request("POST / HTTP/1.1\r\n\r\n").status == WSS_METHOD && wss_request("GET / HTTP/1.0\r\n\r\n").status == WSS_METHOD;
  #assert wss_request("GET /HTTP/1.1\r\n\r\n").status == WSS_METHOD && wss_request("GET x HTTP/1.1\r\n\r\n").status == WSS_METHOD;
  #assert wss_request("GET / HTTP/1.1 \r\n\r\n").status == WSS_METHOD && wss_request("GET  HTTP/1.1\r\n\r\n").status == WSS_METHOD;
  #assert wss_request("GET / HTTP/1.1\r\nnocolon\r\n\r\n").status == WSS_HEADER && wss_request("GET / HTTP/1.1\r\n: v\r\n\r\n").status == WSS_HEADER;
  #assert wss_request("GET / HTTP/1.1\r\nX: a\nb\r\n\r\n").status == WSS_HEADER;
  #assert wss_request("GET / HTTP/1.1\r\nHost: h\r\n\r\n").status == WSS_UPGRADE;
  #assert wss_request("GET / HTTP/1.1\r\nUpgrade: websockets\r\nConnection: Upgrade\r\n\r\n").status == WSS_UPGRADE;
  #assert wss_request("GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: close\r\n\r\n").status == WSS_CONNECTION;
  #assert wss_request("GET / HTTP/1.1\r\nUpgrade: websocket\r\n\r\n").status == WSS_CONNECTION;
  #assert wss_request("GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n").status == WSS_VERSION;
  #assert wss_request("GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 8\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n").status == WSS_VERSION;
  #assert wss_request("GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\n\r\n").status == WSS_KEY;
  #assert wss_request("GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ=\r\n\r\n").status == WSS_KEY;
  #assert wss_request("GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n").status == WSS_KEY;
  #assert wss_request("GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ!=\r\n\r\n").status == WSS_KEY;
  #assert wss_request("GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ=x\r\n\r\n").status == WSS_KEY;
  #assert k.count > 0;
}
#test "a NIP-11 request is a plain GET asking for application/nostr+json" {
  #assert wss_request("GET / HTTP/1.1\r\nHost: h\r\nAccept: application/nostr+json\r\n\r\n").status == WSS_NIP11;
  #assert wss_request("GET / HTTP/1.1\r\nAccept: text/html, Application/Nostr+JSON;q=0.9\r\n\r\n").status == WSS_NIP11;
  #assert wss_request("GET / HTTP/1.1\r\nAccept: text/html\r\n\r\n").status == WSS_UPGRADE;
  #assert wss_request("GET / HTTP/1.1\r\nAccept: application/nostr+jsonx\r\n\r\n").status == WSS_UPGRADE;
  // an upgrade wins over Accept
  #assert wss_request("GET / HTTP/1.1\r\nAccept: application/nostr+json\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n").status == WSS_OK;
  #assert wss_media("application/nostr+json") && wss_media(" application/nostr+json ; q=1") && !wss_media("application/json") && !wss_media("");
  #assert wss_media("a/b,application/nostr+json") && !wss_media("a/b;application/nostr+json");
}
#test "the request head limit is exact" {
  pre := "GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nX: ";
  b: [WS_HELLO_MAX + 8] u8;
  for i: 0..<pre.count { b[i] = pre[i]; }
  for i: pre.count..<WS_HELLO_MAX - 4 { b[i] = 'a'; }
  tail := "\r\n\r\n";
  for i: 0..<4 { b[WS_HELLO_MAX - 4 + i] = tail[i]; }
  #assert wss_request(cast(string) b[0..<WS_HELLO_MAX]).status == WSS_OK;
  b[WS_HELLO_MAX - 4] = 'a';
  for i: 0..<4 { b[WS_HELLO_MAX - 3 + i] = tail[i]; }
  #assert wss_request(cast(string) b[0..<WS_HELLO_MAX + 1]).status == WSS_TOO_BIG;
  #assert wss_request(cast(string) b[0..<WS_HELLO_MAX - 1]).status == WSS_MORE;
  #assert wss_request(cast(string) b[0..<WS_HELLO_MAX]).status == WSS_TOO_BIG;
}
#test "HTTP responses carry an exact length" {
  out: [256] u8;
  n := wss_http_write("200 OK", "application/nostr+json", "{}", out[..]);
  #assert n > 0 && cast(string) out[0..<n] == "HTTP/1.1 200 OK\r\nContent-Type: application/nostr+json\r\nContent-Length: 2\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Allow-Headers: *\r\nAccess-Control-Allow-Methods: GET\r\nConnection: close\r\n\r\n{}";
  #assert wss_http_write("200 OK", "application/nostr+json", "{}", out[0..<n - 1]) == -1 && wss_http_write("200 OK", "application/nostr+json", "{}", out[0..<n]) == n;
  m := wss_http_write("400 Bad Request", "text/plain", "", out[..]);
  #assert m > 0 && cast(string) out[0..<37] == "HTTP/1.1 400 Bad Request\r\nContent-Typ";
}

#test "request line, key and header details" {
  xp: [2048] u8;
  tail := " HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n";
  b: [512] u8;
  heads := [9] string.["GET /", "GET /!~", "GET / a", "GET /a b", "GET /a%01", "GET /a%7f", "GET /a%80", "GET /%1f", "GET /a\tb"];
  want := [9] int.[WSS_OK, WSS_OK, WSS_METHOD, WSS_METHOD, WSS_METHOD, WSS_METHOD, WSS_METHOD, WSS_METHOD, WSS_METHOD];
  for k: 0..<9 {
    h := wx(heads[k], xp[0..<256]);
    for i: 0..<h.count { b[i] = h[i]; }
    for i: 0..<tail.count { b[h.count + i] = tail[i]; }
    #assert wss_request(cast(string) b[0..<h.count + tail.count]).status == want[k];
  }
  #assert wss_cr("ab\rc") == 2 && wss_cr("\r") == 0 && wss_cr("ab") == 2;
  // no space after the colon, a tab before the key, a colon in a value, a leading colon
  r := wss_request("GET / HTTP/1.1\r\nupgrade:websocket\r\nconnection:upgrade\r\nsec-websocket-version:13\r\nsec-websocket-key:dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n");
  #assert r.status == WSS_OK && r.key_to - r.key_from == 24;
  r = wss_request("GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key:\t dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n");
  #assert r.status == WSS_OK;
  #assert wss_request("GET / HTTP/1.1\r\nAccept: application/nostr+json, a:b\r\n\r\n").status == WSS_NIP11;
  #assert wss_request("GET / HTTP/1.1\r\n:a: b\r\n\r\n").status == WSS_HEADER && wss_request("GET / HTTP/1.1\r\n\r\n").consumed == 18;
  keys := [6] string.["!GhlIHNhbXBsZSBub25jZQ==", "dGhlIHNhbXBsZSBub25jZ!==", "AZaz09+/AAAAAAAAAAAAAA==", "AAAAAAAAAAAAAAAAAAAAAA=a", "@[`{.:,*AAAAAAAAAAAAAA==", "AAAAAAAAAAAAAAAAAAAAA==="];
  ok := [6] bool.[false, false, true, false, false, false];
  for k: 0..<6 { #assert wss_key_ok(keys[k]) == ok[k]; }
  inside := "AZaz09+/MNmn"; outside := "@[`{/:,*.-_=";
  for c: inside { #assert wss_key_char(c); }
  for i: 0..<outside.count { #assert wss_key_char(outside[i]) == (i == 4); }
  #assert wss_media(",application/nostr+json");
}

wss_key_char :: (c: u8) -> bool {
  return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '+' || c == '/';
}
// A Sec-WebSocket-Key value: base64 of 16 bytes, so 22 symbols and "==".
wss_key_ok :: (k: string) -> bool {
  if k.count != 24 || k[22] != '=' || k[23] != '=' { return false; }
  for i: 0..<22 { if !wss_key_char(k[i]) { return false; } }
  return true;
}
// An Accept value names application/nostr+json among its media ranges.
wss_media :: (value: string) -> bool {
  from := 0;
  for i: 0..<value.count + 1 {
    if i == value.count || value[i] == ',' {
      item := value[from..<i];
      semi := item.count;
      for c, k: item { if c == ';' && semi == item.count { semi = k; } }
      if ws_ieq(ws_trim(item[0..<semi]), "application/nostr+json") { return true; }
      from = i + 1;
    }
  }
  return false;
}
// The offset of the first CR (a complete head always has one).
wss_cr :: (s: string) -> int {
  for c, i: s { if c == '\r' { return i; } }
  return s.count;
}
// Admits a client's request head from the bytes read so far. consumed is the
// head's length on WSS_OK and WSS_NIP11; key_from..<key_to is the key.
wss_request :: (bytes: string) -> WssHello #export_c {
  h: WssHello; h.status = WSS_MORE;
  end := ws_find_end(bytes);
  if end == 0 {
    if bytes.count >= WS_HELLO_MAX { h.status = WSS_TOO_BIG; }
    return h;
  }
  if end > WS_HELLO_MAX { h.status = WSS_TOO_BIG; return h; }
  head := bytes[0..<end];
  line_end := wss_cr(head);
  line := head[0..<line_end];
  // "GET " target " HTTP/1.1", the target starting with "/" and holding no space
  if line.count < 14 || !ws_starts(line, "GET /") || line[line.count - 9..<line.count] != " HTTP/1.1" {
    h.status = WSS_METHOD; return h;
  }
  for c: line[5..<line.count - 9] { if c <= ' ' || c >= cast(u8) 127 { h.status = WSS_METHOD; return h; } }
  upgrade := false; connection := false; version := false; keys := 0; nip11 := false;
  at := line_end + 2;
  while true {
    e := at;
    while head[e] != '\r' { e += 1; }
    if e == at { break; }
    hl := head[at..<e];
    colon := -1;
    for c, i: hl {
      if !ws_header_char(c) { h.status = WSS_HEADER; return h; }
      if c == ':' && colon < 0 { colon = i; }
    }
    if colon < 1 { h.status = WSS_HEADER; return h; }
    name := hl[0..<colon]; value := ws_trim(hl[colon + 1..<hl.count]);
    if ws_ieq(name, "upgrade") { upgrade = ws_ieq(value, "websocket"); }
    if ws_ieq(name, "connection") { connection = ws_has_token(value, "upgrade"); }
    if ws_ieq(name, "sec-websocket-version") { version = value == "13"; }
    if ws_ieq(name, "accept") && wss_media(value) { nip11 = true; }
    if ws_ieq(name, "sec-websocket-key") {
      keys += 1;
      // the value's offsets in bytes: value is a view of head
      v := at + colon + 1;
      while head[v] == ' ' || head[v] == '\t' { v += 1; }
      h.key_from = v; h.key_to = v + value.count;
    }
    at = e + 2;
  }
  h.consumed = end;
  if !upgrade {
    h.status = ifx nip11 then WSS_NIP11 else WSS_UPGRADE;
    return h;
  }
  if !connection { h.status = WSS_CONNECTION; return h; }
  if !version { h.status = WSS_VERSION; return h; }
  if keys != 1 || !wss_key_ok(bytes[h.key_from..<h.key_to]) { h.status = WSS_KEY; return h; }
  h.status = WSS_OK;
  return h;
}
// The 101 response for key into out; its length or -1.
wss_accept_write :: (key: string, out: [] u8) -> int {
  accept: [28] u8;
  if !ws_accept_of(key, accept[..]) { return -1; }
  n := ws_put(out, 0, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ");
  n = ws_put(out, n, cast(string) accept[..]);
  return ws_put(out, n, "\r\n\r\n");
}
// A complete HTTP/1.1 response that closes the connection (NIP-11 or a refusal).
wss_http_write :: (status: string, content_type: string, body: string, out: [] u8) -> int {
  n := ws_put(out, 0, "HTTP/1.1 ");
  n = ws_put(out, n, status);
  n = ws_put(out, n, "\r\nContent-Type: ");
  n = ws_put(out, n, content_type);
  n = ws_put(out, n, "\r\nContent-Length: ");
  n = ws_digits(out, n, body.count);
  n = ws_put(out, n, "\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Allow-Headers: *\r\nAccess-Control-Allow-Methods: GET\r\nConnection: close\r\n\r\n");
  return ws_put(out, n, body);
}

// ---- frames ---------------------------------------------------------------

#test "client frames must be masked; the RFC 6455 masked Hello unmasks" {
  xp: [1024] u8; out: [16] u8;
  hello := wx("%81%85%37%fa%21%3d%7f%9f%4d%51%58", xp[0..<256]);
  f := wss_frame_read(hello, 100);
  #assert f.status == WS_FRAME_OK && f.fin && f.op == WS_OP_TEXT && f.header == 6 && f.length == 5 && f.total == 11;
  #assert wss_unmask(hello, f, out[..]) == 5 && cast(string) out[0..<5] == "Hello";
  #assert wss_unmask(hello, f, out[0..<4]) == -1;
  #assert wss_frame_read(wx("%81%05Hello", xp[256..<512]), 100).status == WS_FRAME_MASKED;
  #assert wss_frame_read(hello[0..<5], 100).status == WS_FRAME_MORE && wss_frame_read(hello[0..<10], 100).status == WS_FRAME_MORE;
  #assert wss_frame_read(hello, 4).status == WS_FRAME_TOO_BIG && wss_frame_read(hello, 5).status == WS_FRAME_OK;
  #assert wss_frame_read(wx("%c1%85", xp[512..<768]), 100).status == WS_FRAME_RSV && wss_frame_read(wx("%83%80", xp[768..<1024]), 100).status == WS_FRAME_OPCODE;
}
#test "masked lengths in each form" {
  b: [70000] u8; out: [70000] u8;
  b[0] = 0x82; b[1] = 0x80 + 126; b[2] = 0; b[3] = 126; b[4] = 1; b[5] = 2; b[6] = 3; b[7] = 4;
  for i: 0..<126 { b[8 + i] = cast,trunc(u8) (i ^ (i % 4 + 1)); }
  f := wss_frame_read(cast(string) b[0..<134], 1000);
  #assert f.status == WS_FRAME_OK && f.header == 8 && f.length == 126 && f.total == 134;
  #assert wss_unmask(cast(string) b[0..<134], f, out[..]) == 126 && out[0] == 0 && out[125] == 125;
  #assert wss_frame_read(cast(string) b[0..<7], 1000).status == WS_FRAME_MORE;
  b[1] = 0x80 + 127; for i: 2..<10 { b[i] = 0; } b[7] = 1;
  f = wss_frame_read(cast(string) b[0..<14], 1 << 20);
  #assert f.status == WS_FRAME_MORE && f.header == 14 && f.length == 65536;
  #assert wss_frame_read(cast(string) b[0..<9], 1 << 20).header == 0 && wss_frame_read(cast(string) b[0..<10], 1 << 20).total == 65550;
  b[1] = 0x80 + 1; b[2] = 9; b[3] = 0; b[4] = 0; b[5] = 0; b[6] = 'x' ^ 9;
  f = wss_frame_read(cast(string) b[0..<7], 10);
  #assert f.status == WS_FRAME_OK && wss_unmask(cast(string) b[0..<7], f, out[..]) == 1 && out[0] == 'x';
  b[0] = 0x89; b[1] = 0x80 + 126; #assert wss_frame_read(cast(string) b[0..<8], 1000).status == WS_FRAME_CONTROL;
  b[0] = 0x81; b[1] = 0x80 + 126; b[2] = 0; b[3] = 5; #assert wss_frame_read(cast(string) b[0..<8], 1000).status == WS_FRAME_LENGTH;
}
#test "server frames are unmasked with minimal lengths" {
  out: [70000] u8; p126: [126] u8; p65536: [65536] u8;
  n := wss_frame_write(WS_OP_TEXT, "Hello", out[..]);
  #assert n == 7 && out[0] == 0x81 && out[1] == 5 && out[2] == 'H' && out[6] == 'o';
  #assert ws_frame_read(cast(string) out[0..<n], 100).status == WS_FRAME_OK;
  n = wss_frame_write(WS_OP_BINARY, cast(string) p126[0..<125], out[..]);
  #assert n == 127 && out[1] == 125;
  n = wss_frame_write(WS_OP_BINARY, cast(string) p126[..], out[..]);
  #assert n == 130 && out[1] == 126 && out[2] == 0 && out[3] == 126;
  n = wss_frame_write(WS_OP_BINARY, cast(string) p65536[0..<65535], out[..]);
  #assert n == 65539 && out[1] == 126 && out[2] == 255 && out[3] == 255;
  n = wss_frame_write(WS_OP_BINARY, cast(string) p65536[..], out[..]);
  #assert n == 65546 && out[1] == 127 && out[7] == 1 && out[8] == 0 && out[9] == 0 && out[6] == 0;
  #assert wss_frame_write(WS_OP_TEXT, "Hello", out[0..<6]) == -1 && wss_frame_write(WS_OP_TEXT, "Hello", out[0..<7]) == 7;
  #assert wss_frame_write(3, "", out[..]) == -1 && wss_frame_write(WS_OP_PING, cast(string) p126[..], out[..]) == -1;
  #assert wss_frame_write(WS_OP_PONG, cast(string) p126[0..<125], out[..]) == 127;
  #assert wss_close_write(1000, out[..]) == 4 && out[0] == 0x88 && out[1] == 2 && out[2] == 3 && out[3] == 0xe8;
  #assert wss_close_write(1009, out[..]) == 4 && out[3] == 0xf1 && wss_close_write(1005, out[..]) == -1 && wss_close_write(1000, out[0..<3]) == -1;
}

#test "client frame header edges" {
  b: [200] u8; out: [8] u8;
  b[0] = 0x01; b[1] = 0x81; b[6] = 'a';
  f := wss_frame_read(cast(string) b[0..<7], 10);
  #assert f.status == WS_FRAME_OK && !f.fin && wss_unmask(cast(string) b[0..<7], f, out[0..<1]) == 1;
  b[0] = 0x08; b[1] = 0x80; #assert wss_frame_read(cast(string) b[0..<6], 10).status == WS_FRAME_CONTROL;
  b[0] = 0x89; b[1] = 0x80 + 125; #assert wss_frame_read(cast(string) b[0..<131], 200).status == WS_FRAME_OK;
  b[0] = 0x82; b[1] = 0x80 + 126; b[2] = 0; b[3] = 126;
  f = wss_frame_read(cast(string) b[0..<4], 1000);
  #assert f.status == WS_FRAME_MORE && f.length == 126 && f.header == 8;
  b[2] = 1; b[3] = 0; #assert wss_frame_read(cast(string) b[0..<4], 1000).length == 256;
  b[1] = 0x80 + 127; for i: 2..<10 { b[i] = 0; }
  b[2] = 0x80; #assert wss_frame_read(cast(string) b[0..<10], 1 << 62).status == WS_FRAME_LENGTH;
  b[2] = 1; #assert wss_frame_read(cast(string) b[0..<10], 1 << 62).status == WS_FRAME_TOO_BIG;
  b[2] = 0; b[3] = 1; #assert wss_frame_read(cast(string) b[0..<10], 1 << 62).status == WS_FRAME_TOO_BIG;
  b[3] = 0; b[4] = 1; f = wss_frame_read(cast(string) b[0..<10], 1 << 62);
  #assert f.status == WS_FRAME_MORE && f.length == 1 << 40;
  b[4] = 0; b[8] = 255; b[9] = 255; #assert wss_frame_read(cast(string) b[0..<10], 1 << 62).status == WS_FRAME_LENGTH;
  big: [70000] u8; p: [65536] u8; big[2] = 0xff;
  #assert wss_frame_write(WS_OP_BINARY, cast(string) p[..], big[..]) == 65546 && big[2] == 0;
  p126: [126] u8;
  #assert wss_frame_write(WS_OP_CLOSE, cast(string) p126[..], big[..]) == -1 && wss_frame_write(WS_OP_CLOSE, cast(string) p126[0..<125], big[..]) == 127;
}

// Reads one client frame's header. Client frames must be masked (RFC 6455
// section 5.1); on WS_FRAME_OK the masked payload is bytes[header..<total]
// with the key at bytes[header - 4..<header]. limit caps one frame's payload.
wss_frame_read :: (bytes: string, limit: int) -> WsFrame {
  f: WsFrame; f.status = WS_FRAME_MORE;
  if bytes.count < 2 { return f; }
  b0 := cast(int) bytes[0]; b1 := cast(int) bytes[1];
  f.fin = (b0 & 128) != 0; f.op = b0 & 15;
  if (b0 & 112) != 0 { f.status = WS_FRAME_RSV; return f; }
  if !ws_op_ok(f.op) { f.status = WS_FRAME_OPCODE; return f; }
  if (b1 & 128) == 0 { f.status = WS_FRAME_MASKED; return f; }
  n := b1 & 127; header := 6;
  if f.op >= 8 && (!f.fin || n > 125) { f.status = WS_FRAME_CONTROL; return f; }
  if n == 126 {
    header = 8;
    if bytes.count < 4 { return f; }
    n = (cast(int) bytes[2] << 8) | cast(int) bytes[3];
    if n < 126 { f.status = WS_FRAME_LENGTH; return f; }
  } else if n == 127 {
    header = 14;
    if bytes.count < 10 { return f; }
    if (bytes[2] & 128) != 0 { f.status = WS_FRAME_LENGTH; return f; }
    for i: 2..<4 { if bytes[i] != 0 { f.status = WS_FRAME_TOO_BIG; return f; } }
    n = 0;
    for i: 4..<10 { n = (n << 8) | cast(int) bytes[i]; }
    if n < 65536 { f.status = WS_FRAME_LENGTH; return f; }
  }
  if n > limit { f.status = WS_FRAME_TOO_BIG; return f; }
  f.header = header; f.length = n; f.total = header + n;
  if bytes.count < f.total { return f; }
  f.status = WS_FRAME_OK;
  return f;
}
// The admitted frame's payload unmasked into out: its length, or -1.
wss_unmask :: (bytes: string, f: WsFrame, out: [] u8) -> int {
  if out.count < f.length { return -1; }
  k := f.header - 4;
  for i: 0..<f.length { out[i] = bytes[f.header + i] ^ bytes[k + i % 4]; }
  return f.length;
}
// One unmasked, final server frame into out; its length, or -1.
wss_frame_write :: (op: int, payload: string, out: [] u8) -> int {
  if !ws_op_ok(op) { return -1; }
  if op >= 8 && payload.count > 125 { return -1; }
  n := payload.count;
  header := 2;
  if n > 65535 { header = 10; } else if n > 125 { header = 4; }
  if out.count < header + n { return -1; }
  out[0] = cast(u8) (op + 128);
  if n > 65535 {
    out[1] = 127;
    for i: 0..<8 { out[2 + i] = cast,trunc(u8) (n >> ((7 - i) * 8)); }
  } else if n > 125 {
    out[1] = 126; out[2] = cast,trunc(u8) (n >> 8); out[3] = cast,trunc(u8) n;
  } else {
    out[1] = cast(u8) n;
  }
  for i: 0..<n { out[header + i] = payload[i]; }
  return header + n;
}
wss_close_write :: (code: int, out: [] u8) -> int {
  if !ws_close_code_ok(code) { return -1; }
  body := [2] u8.[cast,trunc(u8) (code >> 8), cast,trunc(u8) code];
  return wss_frame_write(WS_OP_CLOSE, cast(string) body[..], out);
}
