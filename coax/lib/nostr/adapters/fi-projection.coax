// Bounded FI assertion projection. Consistency is not JWS verification,
// issuer trust, subject/owner admission, possession, or session authority.
// Input bytes are borrowed and must stay live and unchanged during use.
#load "fi-proto-import.coax";
#load "../block/fi-compact.coax";
#load "../block/fi-claims-parse.coax";
#load "../block/fi-protected.coax";
#load "../hex.coax";
#load "../../../tests/nostr/proto_wire_F.coax";
#authority;
FpaAssertion :: struct {original:[]u8;consistent:bool;}
fpa_bytes :: (a:[]u8,b:[]u8)->bool {
 if a.count!=b.count {return false;}for i:0..<a.count {if a[i]!=b[i] {return false;}}return true;
}
fpa_claim_text :: (text:FiClaimText,actual:string)->bool {copy:=text;return cast(string)copy.bytes[0..<copy.count]==actual;}
// Return the original audience's JSON form, after the claims parser has checked
// its member uniqueness and shape. This preserves a singleton array vs string.
fpa_audience_form :: (raw:string)->int {
 j:[1]Json;json_start(j[..],raw);if json_next(j[..])!=JSON_OBJECT {return 0;}
 name:[128]u8;token:=json_next(j[..]);
 while token==JSON_STRING {
  n:=json_unescape(json_text(j[..]),name[..]);if n<0 {return 0;}
  is_aud:=cast(string)name[0..<n]=="aud";token=json_next(j[..]);
  if is_aud {if token==JSON_STRING {return 1;}if token==JSON_ARRAY {return 2;}return 0;}
  if !json_skip(j[..]) {return 0;}
  token=json_next(j[..]);
 }
 return 0;
}
fpa_audience :: (aud:F_Audience,claims:FiClaimsProjection,form:int)->bool {
 if claims.audience_count<1 {return false;}
 if claims.audience_count>16 {return false;}
 checked:=F_Audience_decode(aud.wire);if aud.error!=0 {return false;}if checked.error!=0 {return false;}
 choice:=F_Audience_case_form(checked);if !choice.present {return false;}if cast(int)choice.value!=form {return false;}
 copy:=claims;
 if form==1 {one:=F_Audience_get_single(checked);return claims.audience_count==1 && fpa_claim_text(copy.audiences[0],one.value);}
 // A valid oneof choice other than the single-string case is the list case.
 many:=F_Audience_get_multiple(checked);iterator:=F_AudienceList_iter_values(many.value);index:=0;
 while iterator.has_value {
  if index>=claims.audience_count {return false;}
  if !fpa_claim_text(copy.audiences[index],iterator.value) {return false;}
  index+=1;iterator=F_AudienceList_next_values(iterator);
 }
 // The generated parent decode validates the complete list; stable wire makes
 // the nested iterator's exhaustion and error state deterministic.
 return index==claims.audience_count;
}
fpa_number :: (n:F_JsonNumber,expected:int)->bool {
 checked:=F_JsonNumber_decode(n.wire);if n.error!=0 {return false;}if checked.error!=0 {return false;}
 text:=F_JsonNumber_get_decimal(checked);parsed:=json_int(text.value);return parsed.ok && parsed.value==expected;
}
fpa_key :: (projected:[]u8,hex:FiClaimText)->bool {
 copy:=hex;decoded:[32]u8;result:=hex_decode_checked(cast(string)copy.bytes[0..<copy.count],decoded[..],false);
 return result.error==NC_OK && result.written==32 && fpa_bytes(projected,decoded[..]);
}
fpa_claims :: (projected:F_AssertionClaims,claims:FiClaimsProjection,form:int)->bool {
 if projected.error!=0 {return false;}
 if !claims.ok {return false;}
 // The generated decoder requires and recursively validates singular fields.
 checked:=F_AssertionClaims_decode(projected.wire);if checked.error!=0 {return false;}
 iss:=F_AssertionClaims_get_issuer(checked);sub:=F_AssertionClaims_get_subject(checked);key:=F_AssertionClaims_get_nostr_pubkey(checked);
 if !fpa_claim_text(claims.issuer,iss.value) || !fpa_claim_text(claims.subject,sub.value) || !fpa_key(key.value,claims.key) {return false;}
 aud:=F_AssertionClaims_get_audience(checked);iat:=F_AssertionClaims_get_issued_at(checked);expires:=F_AssertionClaims_get_expires_at(checked);
 if !fpa_audience(aud.value,claims,form) || !fpa_number(iat.value,claims.iat) || !fpa_number(expires.value,claims.exp) {return false;}
 nbf:=F_AssertionClaims_get_not_before(checked);owner:=F_AssertionClaims_get_owner_pubkey(checked);client:=F_AssertionClaims_get_client_id(checked);
 if nbf.present!=claims.has_nbf || owner.present!=claims.has_owner || client.present!=claims.has_client {return false;}
 if nbf.present && !fpa_number(nbf.value,claims.nbf) {return false;}
 if owner.present && !fpa_key(owner.value,claims.owner) {return false;}
 if client.present && !fpa_claim_text(claims.client,client.value) {return false;}
 return true;
}
fpa_read :: (wire:[]u8)->FpaAssertion #export_c {
 assertion:=F_Assertion_decode(wire);if assertion.error!=0 {return FpaAssertion.{};}
 original:=F_Assertion_get_original_compact_jws(assertion);header:=F_Assertion_get_protected_header(assertion);projected:=F_Assertion_get_claims(assertion);
 token:=cast(string)original.value;parts:=fi_compact_parse(token);if !parts.ok {return FpaAssertion.{};}
 header_bytes:[4096]u8;payload_bytes:[65536]u8;
 a:=fi_b64url_decode(token[0..<parts.protected_end],header_bytes[..]);b:=fi_b64url_decode(token[parts.payload_start..<parts.signing_end],payload_bytes[..]);
 if a.error!=NC_OK {return FpaAssertion.{};}
 if b.error!=NC_OK {return FpaAssertion.{};}
 header_original:=F_JsonObject_get_utf8(header.value);payload_original:=F_AssertionClaims_get_original(projected.value);body:=F_JsonObject_get_utf8(payload_original.value);
 if !fpa_bytes(header_original.value,header_bytes[0..<a.written]) {return FpaAssertion.{};}
 if !fpa_bytes(body.value,payload_bytes[0..<b.written]) {return FpaAssertion.{};}
 protected:=fi_protected_parse(cast(string)header_bytes[0..<a.written]);claims:=fi_claims_parse(cast(string)payload_bytes[0..<b.written],"");
 form:=fpa_audience_form(cast(string)payload_bytes[0..<b.written]);
 if !protected.ok || !fpa_claims(projected.value,claims,form) {return FpaAssertion.{};}
 return FpaAssertion.{original=original.value,consistent=true};
}

