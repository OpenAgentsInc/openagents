#test "FI audience shape and byte comparisons are explicit" {
 a:=[3]u8.[1,2,3];b:=[3]u8.[1,2,3];
 #assert fpa_bytes(a[..],b[..]) && !fpa_bytes(a[..],b[0..<2]);
 for i:0..<3 {b[i]^=1;#assert !fpa_bytes(a[..],b[..]);b[i]^=1;}
 #assert fpa_audience_form("{\"aud\":\"x\"}")==1;
 #assert fpa_audience_form("{\"aud\":[\"x\"]}")==2;
 #assert fpa_audience_form("{\"aud\":null}")==0 && fpa_audience_form("{}")==0;
}

