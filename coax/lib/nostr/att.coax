  #assert at_endpoint_read(AT_K3,at_case(tg[..],AT_EP_TAGS,"\"]]","\"]] x"),text).code==AtCode.tags;
}
#test "a key twice, a field of the wrong type and a broken text refuse" {
  c:[4096]u8;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"reference\":\"r\"","\"reference\":\"r\",\"reference\":\"r\""),AT_X).code==AtCode.image;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"image\":{","\"image\":{\"digest\":\"sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\","),AT_X).code==AtCode.image;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"support\":\"STABLE\"","\"support\":\"STABLE\",\"support\":\"STABLE\""),AT_X).code==AtCode.platform;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"workload\":\"vault\"","\"workload\":7"),AT_X).code==AtCode.workload;
  t7:[1024]u8;
  #assert at_release_read(AT_K1,at_case(t7[..],AT_RELEASE_TAGS,"[\"w\",\"vault\"]","[\"w\",\"7\"]"),at_case(c[..],AT_RELEASE,"\"workload\":\"vault\"","\"workload\":7"),AT_X).code==AtCode.workload;
  #assert at_head_read(AT_K1,at_case(t7[..],AT_HEAD_TAGS,"[\"d\",\"vault\"]","[\"d\",\"7\"]"),at_case(c[..],AT_HEAD,"\"workload\":\"vault\"","\"workload\":7")).code==AtCode.workload;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"support\":\"STABLE\"","\"support\":\"STABLE\",\"x\":\"y\""),AT_X).code==AtCode.platform;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"changes\":\"c\",","\"changes\":\"c\",,"),AT_X).code==AtCode.json;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"retire_at\":null","\"retire_at\":null,\"retire_at\":null")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"retire_at\":null","\"x\":1,\"retire_at\":null")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"emergency\":null","\"emergency\":{\"reason\":\"a\",\"reason\":\"a\",\"release\":\"97263cdd56d438b8a5a2719dab4cc41d62ea7135522c8a838ebf5e82060d504a\"}")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"emergency\":null","\"emergency\":{\"reason\":7,\"release\":\"97263cdd56d438b8a5a2719dab4cc41d62ea7135522c8a838ebf5e82060d504a\"}")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"workload\":\"vault\"","\"workload\":7")).code==AtCode.workload;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"generation\":7,","\"generation\":7,,")).code==AtCode.json;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"generation\":7","\"generation\":7,\"meta\":{\"a\":[1]}")).code==AtCode.ok;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"generation\":7","\"generation\":7,\"meta\":1")).code==AtCode.field;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"generation\":7","\"generation\":7,\"meta\":{\"a\":}")).code!=AtCode.ok;
  tb:[2048]u8;eb:[4096]u8;text:=at_endpoint_test(eb[..],at_token_test(tb[..],AT_CLAIMS));
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"format\":\"pki\"","\"format\":\"pki\",\"format\":\"pki\"")).code==AtCode.evidence;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"format\":\"pki\"","\"format\":\"pki\",\"x\":\"y\"")).code==AtCode.evidence;
  t64:[1024]u8;
  #assert at_endpoint_read(AT_K3,at_case(t64[..],AT_EP_TAGS,"[\"e\",\"97263cdd56d438b8a5a2719dab4cc41d62ea7135522c8a838ebf5e82060d504a\"]","[\"e\",\"1111111111111111111111111111111111111111111111111111111111111111\"]"),at_case(c[..],text,"\"release\":\"97263cdd56d438b8a5a2719dab4cc41d62ea7135522c8a838ebf5e82060d504a\"","\"release\":1111111111111111111111111111111111111111111111111111111111111111")).code==AtCode.release;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"release\":\"97263cdd56d438b8a5a2719dab4cc41d62ea7135522c8a838ebf5e82060d504a\"","\"release\":1111111111111111111111111111111111111111111111111111111111111111")).code==AtCode.release;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"hpke\":null","\"hpke\":null,\"meta\":{\"a\":[1]}")).code==AtCode.ok;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"hpke\":null","\"hpke\":null,\"meta\":1")).code==AtCode.field;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"hpke\":null,","\"hpke\":null,,")).code==AtCode.json;
}
#test "token shapes: digits, dots, empty parts, a payload that does not fit" {
  r:=at_release_read(AT_K1,AT_RELEASE_TAGS,AT_RELEASE,AT_X);h:=at_head_read(AT_K1,AT_HEAD_TAGS,AT_HEAD);eb:[8192]u8;
  toks:=[7]string.["!a.eyJhIjoxfQ.c",".eyJhIjoxfQ.c","a.eyJhIjoxfQ.",".a.eyJhIjoxfQ.c","a.eyJhIjoxfQ.c.","a.eyJhIjoxfQ.c!","Z-_z9.eyJhIjoxfQ.Z-_z9"];
  want:=[7]AtCode.[AtCode.token,AtCode.token,AtCode.token,AtCode.token,AtCode.token,AtCode.token,AtCode.issuer];
  for i:0..<7 {e:=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],toks[i]));#assert e.code==AtCode.ok && at_verify(AT_RID,r,AT_K1,h,0,e,AT_T0).code==want[i];}
  out:[4]u8;
  #assert at_payload("a.eyJhIjoxfQ.c",out[..])=="";
  big:[8]u8;#assert at_payload("a.eyJhIjoxfQ.c",big[..])=="{\"a\":1}";
  #assert at_payload("a.YQ.c",out[0..<1])=="a" && at_payload("a.YWI.c",out[0..<1])=="" && at_payload("a.YWI.c",out[0..<2])=="ab";
}
#test "submods: only container.image_digest and confidential_space.support_attributes count" {
  r:=at_release_read(AT_K1,AT_RELEASE_TAGS,AT_RELEASE,AT_X);h:=at_head_read(AT_K1,AT_HEAD_TAGS,AT_HEAD);
  c:[2048]u8;tb:[2048]u8;eb:[4096]u8;
  sub:="\"submods\":{\"confidential_space\":{\"support_attributes\":[\"LATEST\",\"STABLE\",\"USABLE\"]},\"container\":{\"image_digest\":\"sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}}";
  into:=[9]string.[
    "\"submods\":{\"confidential_space\":{\"support_attributes\":[\"STABLE\"]},\"container\":{\"image_digest\":\"sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"z\":\"bad\"}}",
    "\"submods\":{\"confidential_space\":{\"image_digest\":\"sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"support_attributes\":[\"STABLE\"]},\"container\":{}}",
    "\"submods\":{\"confidential_space\":{\"a\":1,\"support_attributes\":[\"STABLE\"]},\"container\":{\"image_digest\":\"sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}}",
    "\"submods\":{\"confidential_space\":{\"support_attributes\":[\"STABLE\",1]},\"container\":{\"image_digest\":\"sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}}",
    "\"submods\":{\"confidential_space\":{\"support_attributes\":[\"STABLE\"]},\"container\":1}",
    "\"submods\":1",
    "\"submods\":{\"confidential_space\":{\"support_attributes\":[\"STABLE\"]},\"container\":{\"image_digest\":7}}",
    "\"submods\":{\"confidential_space\":{\"support_attributes\":[\"STABLE\"]},\"container\":{\"image_digest\":\"sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"},\"gce\":{\"a\":[1,{}]}}",
    "\"submods\":{\"container\":{\"support_attributes\":[\"STABLE\"],\"image_digest\":\"sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}}"];
  want:=[9]AtCode.[AtCode.ok,AtCode.measurement,AtCode.ok,AtCode.token,AtCode.measurement,AtCode.support,AtCode.measurement,AtCode.ok,AtCode.support];
  for i:0..<9 {
    e:=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],at_token_test(tb[..],at_case(c[..],AT_CLAIMS,sub,into[i]))));
    #assert e.code==AtCode.ok && at_verify(AT_RID,r,AT_K1,h,0,e,AT_T0).code==want[i];
  }
  e:=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],at_token_test(tb[..],at_case(c[..],AT_CLAIMS,"\"aud\":","\"a\":[1,,],\"aud\":"))));
  #assert at_verify(AT_RID,r,AT_K1,h,0,e,AT_T0).code==AtCode.token;
  e=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],at_token_test(tb[..],at_case(c[..],AT_CLAIMS,"\"container\":{","\"container\":{\"a\":[1,,],"))));
  #assert at_verify(AT_RID,r,AT_K1,h,0,e,AT_T0).code==AtCode.token;
  e=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],at_token_test(tb[..],at_case(c[..],AT_CLAIMS,"\"eat_nonce\":[","\"eat_nonce\":[[1,,],"))));
  #assert at_verify(AT_RID,r,AT_K1,h,0,e,AT_T0).code==AtCode.token;
}

// ---- small readers
at_hex64 :: (s:string)->bool {
  if s.count!=64 {return false;}
  for c:s {if !((c>='0' && c<='9') || (c>='a' && c<='f')) {return false;}}
  return true;
}
at_slug :: (s:string)->bool {
  if s.count==0 || s.count>64 {return false;}
  for c:s {if !((c>='a' && c<='z') || (c>='0' && c<='9') || c=='-') {return false;}}
  return true;
}
at_image_digest :: (s:string)->bool {return s.count==71 && s[0..<7]=="sha256:" && at_hex64(s[7..<71]);}
at_uint :: (j:[]Json,t:int)->int {
  if t!=JSON_NUMBER {return -1;}v:=json_int(json_text(j));if !v.ok || v.value<0 {return -1;}return v.value;
}
// The tags named name: how many, the first one's first value, and whether
// any of them has value as its first value. Every tag must be an array of
// strings; values are read raw (unescaped hex and slugs).
at_tag :: (tags:string,name:string,value:string)->AtTag {
  r:AtTag;j:[1]Json;json_start(j[..],tags);if json_next(j[..])!=JSON_ARRAY {return r;}
  t:=json_next(j[..]);
  while t==JSON_ARRAY {
    v:=json_next(j[..]);at:=0;mine:bool;
    while v==JSON_STRING {
      if at==0 {mine=json_text(j[..])==name;if mine {r.count+=1;}}
      if at==1 && mine {
        if r.count==1 {r.first=json_text(j[..]);}
        if json_text(j[..])==value {r.has=true;}
      }
      at+=1;v=json_next(j[..]);
    }
    if v!=JSON_ARRAY_END {return AtTag.{};}
    t=json_next(j[..]);
  }
  r.ok=t==JSON_ARRAY_END && json_next(j[..])==JSON_END;return r;
}
// requires must be [] for every version this reader knows.
at_requires_empty :: (j:[]Json,t:int)->bool {return t==JSON_ARRAY && json_next(j)==JSON_ARRAY_END;}

// ---- the release, kind 3202
at_release_field :: (key:string)->int {
  names:=[16]string.["v","requires","workload","publisher","image","platforms","measurements","gpu","models","components","source","rebuilds","transparency","changes","published_at","meta"];
  for i:0..<16 {if json_is(key,names[i]) {return i;}}return -1;
}
at_image :: (j:[]Json,r:[]AtRelease)->bool {
  seen:=0;
  while true {
    t:=json_next(j);if t==JSON_OBJECT_END {break;}
    key:=json_text(j);t=json_next(j);
    bit:int;
    if json_is(key,"digest") {bit=1;if t!=JSON_STRING || !at_image_digest(json_text(j)) {return false;}r[0].image=json_text(j);}
    else if json_is(key,"reference") {bit=2;if t!=JSON_STRING {return false;}}
    else {return false;}
    if (seen&bit)!=0 {return false;}seen|=bit;
  }
  return seen==3;
}
// Exactly one platform, gcp-confidential-space, with hwmodel and support.
// Other kinds (tdx, sev-snp, apple-app-attest) are not built here.
at_platforms :: (j:[]Json,r:[]AtRelease)->bool {
  count:=0;v:=json_next(j);
  while v!=JSON_ARRAY_END {
    if v!=JSON_OBJECT {return false;}
    seen:=0;
    while true {
      t:=json_next(j);if t==JSON_OBJECT_END {break;}
      key:=json_text(j);t=json_next(j);if t!=JSON_STRING {return false;}
      bit:int;
      if json_is(key,"kind") {bit=1;if !json_is(json_text(j),"gcp-confidential-space") {return false;}}
      else if json_is(key,"hwmodel") {bit=2;r[0].hwmodel=json_text(j);}
      else if json_is(key,"support") {bit=4;r[0].support=json_text(j);}
      else {return false;}
      if (seen&bit)!=0 {return false;}seen|=bit;
    }
    if seen!=7 {return false;}
    count+=1;v=json_next(j);
  }
  return count==1;
}
// book:begin release
// signer is the verified event's pubkey, tags its tag array, content its
// unescaped content, digest the lowercase SHA-256 of content.
at_release_read :: (signer:string,tags:string,content:string,digest:string)->AtRelease {
  r:=[1]AtRelease.[AtRelease.{}];
  tt:=at_tag(tags,"t","");x:=at_tag(tags,"x","");w:=at_tag(tags,"w","");
  if !tt.ok || tt.count!=1 || x.count!=1 || w.count!=1 {return AtRelease.{code=AtCode.tags};}
  if tt.first!="oa:att-release:v1" {return AtRelease.{code=AtCode.marker};}
  if !at_hex64(digest) || x.first!=digest {return AtRelease.{code=AtCode.digest};}
  j:[1]Json;json_start(j[..],content);if json_next(j[..])!=JSON_OBJECT {return AtRelease.{code=AtCode.json};}
  seen:=0;
  while true {
    t:=json_next(j[..]);if t==JSON_OBJECT_END {break;}if t!=JSON_STRING {return AtRelease.{code=AtCode.json};}
    f:=at_release_field(json_text(j[..]));t=json_next(j[..]);
    if f==-1 || (seen&(1<<f))!=0 {return AtRelease.{code=AtCode.field};}seen|=1<<f;
    if f==0 {if t!=JSON_STRING || !json_is(json_text(j[..]),"openagents.att-release.v1") {return AtRelease.{code=AtCode.version};}}
    else if f==1 {if !at_requires_empty(j[..],t) {return AtRelease.{code=AtCode.version};}}
    else if f==2 {if t!=JSON_STRING || !at_slug(json_text(j[..])) {return AtRelease.{code=AtCode.workload};}r[0].workload=json_text(j[..]);}
    else if f==3 {if t!=JSON_STRING || json_text(j[..])!=signer {return AtRelease.{code=AtCode.publisher};}r[0].publisher=signer;}
    else if f==4 {if t!=JSON_OBJECT || !at_image(j[..],r[..]) {return AtRelease.{code=AtCode.image};}}
    else if f==5 {if t!=JSON_ARRAY || !at_platforms(j[..],r[..]) {return AtRelease.{code=AtCode.platform};}}
    else if f==7 {if t!=JSON_NULL {return AtRelease.{code=AtCode.gpu};}}   // GPU evidence is not built
    else if f==13 {if t!=JSON_STRING {return AtRelease.{code=AtCode.field};}}
    else if f==14 {r[0].published_at=at_uint(j[..],t);if r[0].published_at<0 {return AtRelease.{code=AtCode.times};}}
    else if f==10 || f==15 {if t!=JSON_OBJECT || !json_skip(j[..]) {return AtRelease.{code=AtCode.field};}}
    else {if t!=JSON_ARRAY || !json_skip(j[..]) {return AtRelease.{code=AtCode.field};}}
  }
  if json_next(j[..])!=JSON_END {return AtRelease.{code=AtCode.json};}
  if (seen&32767)!=32767 {return AtRelease.{code=AtCode.field};}
  if w.first!=r[0].workload {return AtRelease.{code=AtCode.workload};}
  return r[0];
}
// book:end release

// ---- the release head, kind 30202
at_head_field :: (key:string)->int {
  names:=[8]string.["v","requires","workload","generation","notice_seconds","admitted","emergency","meta"];
  for i:0..<8 {if json_is(key,names[i]) {return i;}}return -1;
}
at_admit :: (j:[]Json,h:[]AtHead)->bool {
  v:=json_next(j);
  while v!=JSON_ARRAY_END {
    if v!=JSON_OBJECT || h[0].count==AT_ADMITTED {return false;}
    a:AtAdmit;seen:=0;
    while true {
      t:=json_next(j);if t==JSON_OBJECT_END {break;}
      key:=json_text(j);t=json_next(j);bit:int;
      if json_is(key,"release") {bit=1;if t!=JSON_STRING || !at_hex64(json_text(j)) {return false;}a.release=json_text(j);}
      else if json_is(key,"effective_at") {bit=2;a.effective_at=at_uint(j,t);if a.effective_at<0 {return false;}}
      else if json_is(key,"retire_at") {bit=4;if t!=JSON_NULL {a.retire_at=at_uint(j,t);if a.retire_at<0 {return false;}}}
      else {return false;}
      if (seen&bit)!=0 {return false;}seen|=bit;
    }
    if seen!=7 {return false;}
    h[0].admitted[h[0].count]=a;h[0].count+=1;v=json_next(j);
  }
  return true;
}
// null, or {release, reason} with a nonempty reason.
at_emergency :: (j:[]Json,t:int,h:[]AtHead)->bool {
  if t==JSON_NULL {return true;}
  if t!=JSON_OBJECT {return false;}
  seen:=0;
  while true {
    k:=json_next(j);if k==JSON_OBJECT_END {break;}
    key:=json_text(j);k=json_next(j);bit:int;
    if json_is(key,"release") {bit=1;if k!=JSON_STRING || !at_hex64(json_text(j)) {return false;}h[0].emergency=json_text(j);}
    else if json_is(key,"reason") {bit=2;if k!=JSON_STRING || json_text(j).count==0 {return false;}}
    else {return false;}
    if (seen&bit)!=0 {return false;}seen|=bit;
  }
  return seen==3;
}
// book:begin head
at_head_read :: (signer:string,tags:string,content:string)->AtHead {
  h:=[1]AtHead.[AtHead.{}];
  d:=at_tag(tags,"d","");tt:=at_tag(tags,"t","");
  if !d.ok || d.count!=1 || tt.count!=1 {return AtHead.{code=AtCode.tags};}
  if tt.first!="oa:att-head:v1" {return AtHead.{code=AtCode.marker};}
  j:[1]Json;json_start(j[..],content);if json_next(j[..])!=JSON_OBJECT {return AtHead.{code=AtCode.json};}
  seen:=0;
  while true {
    t:=json_next(j[..]);if t==JSON_OBJECT_END {break;}if t!=JSON_STRING {return AtHead.{code=AtCode.json};}
    f:=at_head_field(json_text(j[..]));t=json_next(j[..]);
    if f==-1 || (seen&(1<<f))!=0 {return AtHead.{code=AtCode.field};}seen|=1<<f;
    if f==0 {if t!=JSON_STRING || !json_is(json_text(j[..]),"openagents.att-head.v1") {return AtHead.{code=AtCode.version};}}
    else if f==1 {if !at_requires_empty(j[..],t) {return AtHead.{code=AtCode.version};}}
    else if f==2 {if t!=JSON_STRING || !at_slug(json_text(j[..])) {return AtHead.{code=AtCode.workload};}h[0].workload=json_text(j[..]);}
    else if f==3 {h[0].generation=at_uint(j[..],t);if h[0].generation<0 {return AtHead.{code=AtCode.times};}}
    else if f==4 {h[0].notice=at_uint(j[..],t);if h[0].notice<0 {return AtHead.{code=AtCode.times};}}
    else if f==5 {if t!=JSON_ARRAY || !at_admit(j[..],h[..]) {return AtHead.{code=AtCode.head};}}
    else if f==6 {if !at_emergency(j[..],t,h[..]) {return AtHead.{code=AtCode.head};}}
    else {if t!=JSON_OBJECT || !json_skip(j[..]) {return AtHead.{code=AtCode.field};}}
  }
  if json_next(j[..])!=JSON_END {return AtHead.{code=AtCode.json};}
  if (seen&127)!=127 {return AtHead.{code=AtCode.field};}
  if d.first!=h[0].workload {return AtHead.{code=AtCode.workload};}
  for i:0..<h[0].count {if !at_tag(tags,"e",h[0].admitted[i].release).has {return AtHead.{code=AtCode.tags};}}
  return h[0];
}
// book:end head
// book:begin admitted
// NIP-ATT: admitted at now when listed, effective_at <= now, retire_at
// null or later than now, and effective_at at least the notice delay after
// the release's published_at (one day for the head's emergency release).
at_admitted :: (h:AtHead,release:string,published_at:int,now:int)->AtCode {
  for i:0..<h.count {
    a:=h.admitted[i];
    if a.release==release {
      if a.effective_at>now {return AtCode.early;}
      if a.retire_at>=0 && a.retire_at<=now {return AtCode.retired;}
      notice:=ifx h.emergency==release then AT_EMERGENCY else h.notice;
      if a.effective_at<published_at+notice {return AtCode.notice;}
      return AtCode.ok;
    }
  }
  return AtCode.listed;
}
// held is the highest generation this reader has seen for the workload.
at_generation :: (h:AtHead,held:int)->AtCode {return ifx h.generation<held then AtCode.generation else AtCode.ok;}
// book:end admitted

// ---- the endpoint, kind 30203
// book:begin binding
// SHA-256("openagents.att.v1" || 0 || endpoint (32 bytes) || release id
// (32 bytes)), as 64 lowercase hex digits. hpke is null here, so it adds no
// bytes.
at_binding :: (endpoint:string,release:string,out:[]u8)->bool {
  if !at_hex64(endpoint) || !at_hex64(release) {return false;}
  msg:[82]u8;for i:0..<AT_DOMAIN.count {msg[i]=AT_DOMAIN[i];}   // msg[17] stays 0
  for i:0..<32 {msg[18+i]=cast(u8)(at_nibble(endpoint[2*i])*16+at_nibble(endpoint[2*i+1]));msg[50+i]=cast(u8)(at_nibble(release[2*i])*16+at_nibble(release[2*i+1]));}
  digest:[32]u8;status:=sha256_hash_checked(msg[..],digest[..],false);
  hex:="0123456789abcdef";
  for i:0..<32 {out[2*i]=hex[cast(int)digest[i]>>4];out[2*i+1]=hex[cast(int)digest[i]&15];}
  return status==SHA_OK;
}
// book:end binding
at_nibble :: (c:u8)->int {return ifx c>='a' then cast(int)(c-'a')+10 else cast(int)(c-'0');}
at_endpoint_field :: (key:string)->int {
  names:=[11]string.["v","requires","release","endpoint","hpke","binding","evidence","operator","issued_at","valid_until","meta"];
  for i:0..<11 {if json_is(key,names[i]) {return i;}}return -1;
}
// Exactly one evidence entry: a Confidential Space PKI token. Raw TDX and
// SEV-SNP quotes, App Attest and NVIDIA evidence are not built: refused.
at_evidence :: (j:[]Json,e:[]AtEndpoint)->bool {
  count:=0;v:=json_next(j);
  while v!=JSON_ARRAY_END {
    if v!=JSON_OBJECT {return false;}
    seen:=0;
    while true {
      t:=json_next(j);if t==JSON_OBJECT_END {break;}
      key:=json_text(j);t=json_next(j);if t!=JSON_STRING {return false;}bit:int;
      if json_is(key,"kind") {bit=1;if !json_is(json_text(j),AT_TOKEN_KIND) {return false;}}
      else if json_is(key,"format") {bit=2;if !json_is(json_text(j),"pki") {return false;}}
      else if json_is(key,"token") {bit=4;e[0].token=json_text(j);}
      else {return false;}
      if (seen&bit)!=0 {return false;}seen|=bit;
    }
    if seen!=7 {return false;}
    count+=1;v=json_next(j);
  }
  return count==1;
}
// book:begin endpoint
at_endpoint_read :: (signer:string,tags:string,content:string)->AtEndpoint {
  e:=[1]AtEndpoint.[AtEndpoint.{}];
  d:=at_tag(tags,"d","");tt:=at_tag(tags,"t","");a:=at_tag(tags,"a","");et:=at_tag(tags,"e","");x:=at_tag(tags,"expiration","");
  if !d.ok || d.count!=1 || !at_hex64(d.first) || tt.count!=1 || a.count!=1 || et.count!=1 || x.count!=1 {return AtEndpoint.{code=AtCode.tags};}
  if tt.first!="oa:att-endpoint:v1" {return AtEndpoint.{code=AtCode.marker};}
  j:[1]Json;json_start(j[..],content);if json_next(j[..])!=JSON_OBJECT {return AtEndpoint.{code=AtCode.json};}
  seen:=0;
  while true {
    t:=json_next(j[..]);if t==JSON_OBJECT_END {break;}if t!=JSON_STRING {return AtEndpoint.{code=AtCode.json};}
    f:=at_endpoint_field(json_text(j[..]));t=json_next(j[..]);
    if f==-1 || (seen&(1<<f))!=0 {return AtEndpoint.{code=AtCode.field};}seen|=1<<f;
    if f==0 {if t!=JSON_STRING || !json_is(json_text(j[..]),"openagents.att-endpoint.v1") {return AtEndpoint.{code=AtCode.version};}}
    else if f==1 {if !at_requires_empty(j[..],t) {return AtEndpoint.{code=AtCode.version};}}
    else if f==2 {if t!=JSON_STRING || !at_hex64(json_text(j[..])) {return AtEndpoint.{code=AtCode.release};}e[0].release=json_text(j[..]);}
    else if f==3 {if t!=JSON_STRING || json_text(j[..])!=signer {return AtEndpoint.{code=AtCode.endpoint};}e[0].endpoint=signer;}
    else if f==4 {if t!=JSON_NULL {return AtEndpoint.{code=AtCode.hpke};}}   // HPKE carriage is not built
    else if f==5 {if t!=JSON_STRING || !at_hex64(json_text(j[..])) {return AtEndpoint.{code=AtCode.binding};}e[0].binding=json_text(j[..]);}
    else if f==6 {if t!=JSON_ARRAY || !at_evidence(j[..],e[..]) {return AtEndpoint.{code=AtCode.evidence};}}
    else if f==7 {if t!=JSON_STRING || !at_hex64(json_text(j[..])) {return AtEndpoint.{code=AtCode.field};}}
    else if f==8 {e[0].issued_at=at_uint(j[..],t);if e[0].issued_at<0 {return AtEndpoint.{code=AtCode.times};}}
    else if f==9 {e[0].valid_until=at_uint(j[..],t);if e[0].valid_until<0 {return AtEndpoint.{code=AtCode.times};}}
    else {if t!=JSON_OBJECT || !json_skip(j[..]) {return AtEndpoint.{code=AtCode.field};}}
  }
  if json_next(j[..])!=JSON_END {return AtEndpoint.{code=AtCode.json};}
  if (seen&1023)!=1023 {return AtEndpoint.{code=AtCode.field};}
  if et.first!=e[0].release {return AtEndpoint.{code=AtCode.release};}
  if e[0].valid_until<e[0].issued_at || e[0].valid_until>e[0].issued_at+AT_MAX_WINDOW {return AtEndpoint.{code=AtCode.window};}
  expiry:=json_int(x.first);if !expiry.ok || expiry.value!=e[0].valid_until {return AtEndpoint.{code=AtCode.tags};}
  e[0].head=a.first;
  return e[0];
}
// book:end endpoint

// ---- the Confidential Space token's claims (signature not checked)
// A base64url digit's value, or -1.
at_b64v :: (c:u8)->int {
  if c>='A' && c<='Z' {return cast(int)(c-'A');}
  if c>='a' && c<='z' {return cast(int)(c-'a')+26;}
  if c>='0' && c<='9' {return cast(int)(c-'0')+52;}
  if c=='-' {return 62;}
  if c=='_' {return 63;}
  return -1;
}
// The middle part of header.payload.signature, base64url without padding,
// decoded into out; "" when the token is not three nonempty parts of
// base64url digits or the payload does not fit.
at_payload :: (token:string,out:[]u8)->string {
  dots:=0;first:int;second:int;
  for i:0..<token.count {
    c:=token[i];
    if c=='.' {dots+=1;if dots==1 {first=i;}if dots==2 {second=i;}}
    else if at_b64v(c)<0 {return "";}
  }
  if dots!=2 || first==0 || second==token.count-1 {return "";}
  acc:int;bits:=0;n:=0;
  for c:token[first+1..<second] {
    acc=(acc*64+at_b64v(c))&4095;bits+=6;
    if bits>=8 {
      bits-=8;
      if n>=out.count {return "";}
      out[n]=cast(u8)(acc>>bits);n+=1;acc&=(1<<bits)-1;
    }
  }
  return cast(string)out[0..<n];
}
AtClaims :: struct {ok:bool;iss:bool;aud:bool;exp:int=-1;hwmodel:string;dbg:bool;image:string;stable:bool;nonce:bool;}
// submods: container.image_digest and confidential_space.support_attributes.
// A refused text stops at the next key; the caller's end check refuses it.
at_submods :: (j:[]Json,c:[]AtClaims) {
  while true {
    t:=json_next(j);if t!=JSON_STRING {return;}
    key:=json_text(j);t=json_next(j);
    container:=json_is(key,"container");
    if (container || json_is(key,"confidential_space")) && t==JSON_OBJECT {
      while true {
        k:=json_next(j);if k!=JSON_STRING {break;}
        inner:=json_text(j);k=json_next(j);
        if container && json_is(inner,"image_digest") && k==JSON_STRING {c[0].image=json_text(j);}
        else if !container && json_is(inner,"support_attributes") && k==JSON_ARRAY {
          v:=json_next(j);while v==JSON_STRING {if json_is(json_text(j),"STABLE") {c[0].stable=true;}v=json_next(j);}
          if v!=JSON_ARRAY_END {return;}
        }
        else {skipped:=json_skip(j);}
      }
    }
    else {skipped:=json_skip(j);}
  }
}
// book:begin claims
// The claims a client compares with the release. Unknown claims are
// skipped: a JWT carries many, and only these decide.
at_claims :: (payload:string,binding:string)->AtClaims {
  c:=[1]AtClaims.[AtClaims.{}];j:[1]Json;json_start(j[..],payload);
  if json_next(j[..])!=JSON_OBJECT {return AtClaims.{};}
  while true {
    t:=json_next(j[..]);if t==JSON_OBJECT_END {break;}if t!=JSON_STRING {return AtClaims.{};}
    key:=json_text(j[..]);t=json_next(j[..]);
    if json_is(key,"iss") {c[0].iss=t==JSON_STRING && json_is(json_text(j[..]),AT_ISSUER);}
    else if json_is(key,"aud") {c[0].aud=t==JSON_STRING && json_is(json_text(j[..]),AT_AUDIENCE);}
    else if json_is(key,"exp") {c[0].exp=at_uint(j[..],t);}
    else if json_is(key,"hwmodel") {if t==JSON_STRING {c[0].hwmodel=json_text(j[..]);}}
    else if json_is(key,"dbgstat") {c[0].dbg=t==JSON_STRING && json_is(json_text(j[..]),"disabled-since-boot");}
    else if json_is(key,"eat_nonce") {
      if t==JSON_STRING {c[0].nonce=json_text(j[..])==binding;}
      else if t==JSON_ARRAY {
        v:=json_next(j[..]);
        while v!=JSON_ARRAY_END {if v==JSON_STRING && json_text(j[..])==binding {c[0].nonce=true;}if !json_skip(j[..]) {return AtClaims.{};}v=json_next(j[..]);}
      }
      else if !json_skip(j[..]) {return AtClaims.{};}
    }
    else if json_is(key,"submods") && t==JSON_OBJECT {at_submods(j[..],c[..]);}
    else if !json_skip(j[..]) {return AtClaims.{};}
  }
  if json_next(j[..])!=JSON_END {return AtClaims.{};}
  c[0].ok=true;return c[0];
}
// book:end claims
// book:begin verify
// NIP-ATT client verification, steps 1, 2, 4, 5 and 6, for verified events:
// release (its id and reading), head (its signer and reading, and the
// highest generation held), endpoint (its reading; its signer is checked by
// at_endpoint_read), at the reader's clock now. Step 3, the token's
// signature to Google's root, is not built, so the level is open.
at_verify :: (release_id:string,r:AtRelease,head_signer:string,h:AtHead,held:int,e:AtEndpoint,now:int)->AtVerdict {
  if e.code!=AtCode.ok {return AtVerdict.{code=e.code};}
  if r.code!=AtCode.ok {return AtVerdict.{code=r.code};}
  if h.code!=AtCode.ok {return AtVerdict.{code=h.code};}
  if head_signer!=r.publisher {return AtVerdict.{code=AtCode.head};}
  if h.workload!=r.workload {return AtVerdict.{code=AtCode.workload};}
  address:[160]u8;n:=json_raw(address[..],0,"30202:");n=json_raw(address[..],n,r.publisher);n=json_raw(address[..],n,":");n=json_raw(address[..],n,r.workload);
  if e.head!=cast(string)address[0..<n] {return AtVerdict.{code=AtCode.head};}
  if e.release!=release_id {return AtVerdict.{code=AtCode.release};}
  code:=at_generation(h,held);if code!=AtCode.ok {return AtVerdict.{code=code};}
  code=at_admitted(h,release_id,r.published_at,now);if code!=AtCode.ok {return AtVerdict.{code=code};}
  if now>e.valid_until {return AtVerdict.{code=AtCode.expired};}
  bound:[64]u8;
  if !at_binding(e.endpoint,e.release,bound[..]) || e.binding!=cast(string)bound[..] {return AtVerdict.{code=AtCode.binding};}
  buf:[AT_PAYLOAD]u8;payload:=at_payload(e.token,buf[..]);
  c:=at_claims(payload,e.binding);
  if !c.ok {return AtVerdict.{code=AtCode.token};}
  if !c.iss {return AtVerdict.{code=AtCode.issuer};}
  if !c.aud {return AtVerdict.{code=AtCode.audience};}
  if !c.dbg {return AtVerdict.{code=AtCode.debug};}
  if c.hwmodel!=r.hwmodel {return AtVerdict.{code=AtCode.hwmodel};}
  if !c.stable || r.support!="STABLE" {return AtVerdict.{code=AtCode.support};}
  if c.image!=r.image {return AtVerdict.{code=AtCode.measurement};}
  if !c.nonce {return AtVerdict.{code=AtCode.nonce};}
  if c.exp<e.valid_until {return AtVerdict.{code=AtCode.window};}
  return AtVerdict.{code=AtCode.ok,level=AtLevel.open};
}
// Whether data whose policy requires level required may go to this
// endpoint. Never falls back to a lower level.
at_may_send :: (v:AtVerdict,required:AtLevel)->bool {
  return v.code==AtCode.ok && cast(int)v.level>=cast(int)required;
}
// book:end verify
