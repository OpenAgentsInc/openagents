// Chapter 83: NIP-ATT, the client side of an attested workload. It reads a
// release (3202), a release head (30202) and an attested endpoint (30203),
// decides whether the release is admitted at the reader's clock (listed,
// effective, not retired, past its notice delay, head not rolled back),
// recomputes the endpoint's binding, and checks the claims of a Google
// Confidential Space token against the release: image digest, hardware
// model, STABLE support, debugging disabled, issuer, audience, the binding
// as an eat_nonce, and the times.
//
// Not built: verifying the token's RS256 signature and certificate chain to
// Google's attestation root (NIP-ATT client step 3), raw TDX quotes, SEV-SNP
// reports, NVIDIA evidence, App Attest, HPKE keys, transparency entries,
// rebuild statements, personal approval sets and sealed jobs. Because step
// 3 is missing, an endpoint whose every claim matches still gets level open:
// the claims are read, not proven. A caller that needs tee or tee-cloud is
// refused by at_may_send.
//
// The caller verifies each event's id and signature first (event.coax) and
// passes its signer, tags and unescaped content; release digests are the
// lowercase SHA-256 of the content, computed by the caller.
#load "json.coax";
#load "base64.coax";
#load "../crypto/sha256.coax";
#authority;

AtCode :: enum u8 {ok;json;version;field;tags;marker;digest;workload;publisher;image;platform;gpu;times;head;generation;listed;early;retired;notice;release;endpoint;hpke;binding;evidence;token;issuer;audience;measurement;hwmodel;support;debug;nonce;expired;window;}
AtLevel :: enum u8 {open;hardened;tee;tee_cloud;}
AtRelease :: struct {code:AtCode;workload:string;publisher:string;image:string;hwmodel:string;support:string;published_at:int;}
AtAdmit :: struct {release:string;effective_at:int;retire_at:int=-1;}
AT_ADMITTED :: 8;
AtHead :: struct {code:AtCode;workload:string;generation:int;notice:int;count:int;admitted:[AT_ADMITTED]AtAdmit;emergency:string;}
AtEndpoint :: struct {code:AtCode;release:string;endpoint:string;binding:string;token:string;issued_at:int;valid_until:int;head:string;}
AtVerdict :: struct {code:AtCode;level:AtLevel;}
AtTag :: struct {ok:bool;count:int;first:string;has:bool;}

AT_MAX_WINDOW :: 3600;
AT_PAYLOAD :: 4096;             // decoded token claims, bytes at most          // valid_until - issued_at at most
AT_EMERGENCY :: 86400;          // the shortest notice for a head's emergency release
AT_ISSUER :: "https://confidentialcomputing.googleapis.com";
AT_AUDIENCE :: "openagents.att.v1";
AT_DOMAIN :: "openagents.att.v1";   // the binding's prefix, then one zero byte
AT_TOKEN_KIND :: "gcp-confidential-space-token";

#load "../../tests/nostr/att_fixtures.coax";

#test "the release reads: workload, publisher, image, platform, published_at" {
  r:=at_release_read(AT_K1,AT_RELEASE_TAGS,AT_RELEASE,AT_X);
  #assert r.code==AtCode.ok && r.workload=="vault" && r.publisher==AT_K1 && r.image==AT_IMAGE;
  #assert r.hwmodel=="GCP_INTEL_TDX" && r.support=="STABLE" && r.published_at==1791300000;
  c:[2048]u8;
  #assert at_release_read(AT_K3,AT_RELEASE_TAGS,AT_RELEASE,AT_X).code==AtCode.publisher;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,AT_RELEASE,AT_BINDING).code==AtCode.digest;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,AT_RELEASE,"11").code==AtCode.digest;
  #assert at_release_read(AT_K1,at_case(c[..],AT_RELEASE_TAGS,"oa:att-release:v1","oa:att-release:v2"),AT_RELEASE,AT_X).code==AtCode.marker;
  #assert at_release_read(AT_K1,at_case(c[..],AT_RELEASE_TAGS,"[\"w\",\"vault\"]","[\"w\",\"other\"]"),AT_RELEASE,AT_X).code==AtCode.workload;
  #assert at_release_read(AT_K1,at_case(c[..],AT_RELEASE_TAGS,",[\"w\",\"vault\"]",""),AT_RELEASE,AT_X).code==AtCode.tags;
  #assert at_release_read(AT_K1,at_case(c[..],AT_RELEASE_TAGS,"[\"t\",","[\"t\",\"oa:att-release:v1\"],[\"t\","),AT_RELEASE,AT_X).code==AtCode.tags;
  #assert at_release_read(AT_K1,"{}",AT_RELEASE,AT_X).code==AtCode.tags;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"release.v1","release.v2"),AT_X).code==AtCode.version;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"requires\":[]","\"requires\":[\"x\"]"),AT_X).code==AtCode.version;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"gpu\":null","\"gpu\":{}"),AT_X).code==AtCode.gpu;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"gpu\":null","\"gpx\":null"),AT_X).code==AtCode.field;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"gpu\":null,",""),AT_X).code==AtCode.field;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"gpu\":null","\"gpu\":null,\"gpu\":null"),AT_X).code==AtCode.field;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"gpu\":null","\"gpu\":null,\"meta\":{\"a\":1}"),AT_X).code==AtCode.ok;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"sha256:0123","\"sha257:0123"),AT_X).code==AtCode.image;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"cdef\",\"reference\"","cdeF\",\"reference\""),AT_X).code==AtCode.image;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"reference\":\"r\"","\"other\":\"r\""),AT_X).code==AtCode.image;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"reference\":\"r\"","\"reference\":1"),AT_X).code==AtCode.image;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,",\"reference\":\"r\"",""),AT_X).code==AtCode.image;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"image\":{","\"image\":[{"),AT_X).code!=AtCode.ok;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"kind\":\"gcp-confidential-space\"","\"kind\":\"tdx\""),AT_X).code==AtCode.platform;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"support\":\"STABLE\"","\"support\":\"EXPERIMENTAL\""),AT_X).code==AtCode.ok;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,",\"support\":\"STABLE\"",""),AT_X).code==AtCode.platform;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"support\":\"STABLE\"","\"support\":\"STABLE\",\"x\":1"),AT_X).code==AtCode.platform;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"hwmodel\":\"GCP_INTEL_TDX\"","\"hwmodel\":7"),AT_X).code==AtCode.platform;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"platforms\":[{","\"platforms\":[{\"hwmodel\":\"A\",\"kind\":\"gcp-confidential-space\",\"support\":\"STABLE\"},{"),AT_X).code==AtCode.platform;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"platforms\":[{\"hwmodel\":\"GCP_INTEL_TDX\",\"kind\":\"gcp-confidential-space\",\"support\":\"STABLE\"}]","\"platforms\":[]"),AT_X).code==AtCode.platform;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"platforms\":[{","\"platforms\":[1,{"),AT_X).code==AtCode.platform;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"published_at\":1791300000","\"published_at\":-1"),AT_X).code==AtCode.times;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"published_at\":1791300000","\"published_at\":\"1\""),AT_X).code==AtCode.times;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"workload\":\"vault\"","\"workload\":\"Vault\""),AT_X).code==AtCode.workload;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"workload\":\"vault\"","\"workload\":\"\""),AT_X).code==AtCode.workload;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"changes\":\"c\"","\"changes\":1"),AT_X).code==AtCode.field;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"models\":[]","\"models\":{}"),AT_X).code==AtCode.field;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"source\":{\"commit\":\"0\"}","\"source\":[]"),AT_X).code==AtCode.field;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"models\":[]","\"models\":[{\"id\":\"m\"}]"),AT_X).code==AtCode.ok;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"}","} x"),AT_X).code==AtCode.json;
  #assert at_release_read(AT_K1,AT_RELEASE_TAGS,"[]",AT_X).code==AtCode.json;
}
#test "the head reads: generation, notice, the admitted list and an emergency" {
  h:=at_head_read(AT_K1,AT_HEAD_TAGS,AT_HEAD);
  #assert h.code==AtCode.ok && h.workload=="vault" && h.generation==7 && h.notice==604800 && h.count==1;
  #assert h.admitted[0].release==AT_RID && h.admitted[0].effective_at==1791904800 && h.admitted[0].retire_at==-1 && h.emergency=="";
  c:[2048]u8;t:[1024]u8;
  e:=at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"emergency\":null","\"emergency\":{\"reason\":\"fix\",\"release\":\"97263cdd56d438b8a5a2719dab4cc41d62ea7135522c8a838ebf5e82060d504a\"}"));
  #assert e.code==AtCode.ok && e.emergency==AT_RID;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"emergency\":null","\"emergency\":{\"release\":\"97263cdd56d438b8a5a2719dab4cc41d62ea7135522c8a838ebf5e82060d504a\"}")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"emergency\":null","\"emergency\":{\"reason\":\"\",\"release\":\"97263cdd56d438b8a5a2719dab4cc41d62ea7135522c8a838ebf5e82060d504a\"}")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"emergency\":null","\"emergency\":{\"reason\":\"a\",\"release\":\"x\"}")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"emergency\":null","\"emergency\":{\"reason\":\"a\",\"release\":\"97263cdd56d438b8a5a2719dab4cc41d62ea7135522c8a838ebf5e82060d504a\",\"x\":1}")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"emergency\":null","\"emergency\":1")).code==AtCode.head;
  r:=at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"retire_at\":null","\"retire_at\":1792000000"));
  #assert r.code==AtCode.ok && r.admitted[0].retire_at==1792000000;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"retire_at\":null","\"retire_at\":-5")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,",\"retire_at\":null","")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"effective_at\":1791904800,","")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"effective_at\":1791904800","\"effective_at\":-1")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"effective_at\":1791904800","\"effective_at\":1,\"x\":2")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"release\":\"97263","\"release\":\"X7263")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"admitted\":[{","\"admitted\":[1,{")).code==AtCode.head;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"admitted\":[","\"admitted\":{\"a\":")).code!=AtCode.ok;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"generation\":7","\"generation\":-7")).code==AtCode.times;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"notice_seconds\":604800","\"notice_seconds\":true")).code==AtCode.times;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"notice_seconds\":604800,","")).code==AtCode.field;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"workload\":\"vault\"","\"workload\":\"other\"")).code==AtCode.workload;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"workload\":\"vault\"","\"workload\":\"a b\"")).code==AtCode.workload;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"head.v1","head.v0")).code==AtCode.version;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"requires\":[]","\"requires\":{}")).code==AtCode.version;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"generation\":7","\"generation\":7,\"x\":1")).code==AtCode.field;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"generation\":7","\"generation\":7,\"generation\":7")).code==AtCode.field;
  #assert at_head_read(AT_K1,at_case(t[..],AT_HEAD_TAGS,"oa:att-head:v1","oa:att-head:v2"),AT_HEAD).code==AtCode.marker;
  #assert at_head_read(AT_K1,at_case(t[..],AT_HEAD_TAGS,"[\"d\",\"vault\"]","[\"d\",\"other\"]"),AT_HEAD).code==AtCode.workload;
  #assert at_head_read(AT_K1,at_case(t[..],AT_HEAD_TAGS,",[\"e\",\"97263cdd56d438b8a5a2719dab4cc41d62ea7135522c8a838ebf5e82060d504a\"]",""),AT_HEAD).code==AtCode.tags;
  #assert at_head_read(AT_K1,at_case(t[..],AT_HEAD_TAGS,"[\"e\",\"97263","[\"e\",\"07263"),AT_HEAD).code==AtCode.tags;
  #assert at_head_read(AT_K1,at_case(t[..],AT_HEAD_TAGS,"[\"d\",\"vault\"],",""),AT_HEAD).code==AtCode.tags;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,"{} x").code==AtCode.json;
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,"7").code==AtCode.json;
  // nine admitted releases are over the reader's bound
  big:[4096]u8;n:=json_raw(big[..],0,"{\"admitted\":[");
  for i:0..<9 {if i>0 {n=json_raw(big[..],n,",");}n=json_raw(big[..],n,"{\"effective_at\":1,\"release\":\"97263cdd56d438b8a5a2719dab4cc41d62ea7135522c8a838ebf5e82060d504a\",\"retire_at\":null}");}
  n=json_raw(big[..],n,"],\"emergency\":null,\"generation\":7,\"notice_seconds\":604800,\"requires\":[],\"v\":\"openagents.att-head.v1\",\"workload\":\"vault\"}");
  #assert at_head_read(AT_K1,AT_HEAD_TAGS,cast(string)big[0..<n]).code==AtCode.head;
}
#test "admission: listed, effective, not retired, past the notice delay" {
  h:=at_head_read(AT_K1,AT_HEAD_TAGS,AT_HEAD);published:=1791300000;
  #assert at_admitted(h,AT_RID,published,1791904800)==AtCode.ok;
  #assert at_admitted(h,AT_RID,published,1791904799)==AtCode.early;
  #assert at_admitted(h,AT_BINDING,published,AT_T0)==AtCode.listed;
  #assert at_admitted(h,AT_RID,published+1,AT_T0)==AtCode.notice;
  h.admitted[0].retire_at=AT_T0;#assert at_admitted(h,AT_RID,published,AT_T0)==AtCode.retired;
  #assert at_admitted(h,AT_RID,published,AT_T0-1)==AtCode.ok;
  h.admitted[0].retire_at=-1;
  // an emergency release needs one day of notice, not the head's seven
  late:=1791904800-86400;
  #assert at_admitted(h,AT_RID,late,AT_T0)==AtCode.notice;
  h.emergency=AT_RID;
  #assert at_admitted(h,AT_RID,late,AT_T0)==AtCode.ok && at_admitted(h,AT_RID,late+1,AT_T0)==AtCode.notice;
  h.emergency=AT_BINDING;#assert at_admitted(h,AT_RID,late,AT_T0)==AtCode.notice;
  // a second entry is searched too
  h.count=2;h.admitted[1]=h.admitted[0];h.admitted[0].release=AT_BINDING;
  #assert at_admitted(h,AT_RID,published,AT_T0)==AtCode.ok;
  h.count=1;#assert at_admitted(h,AT_RID,published,AT_T0)==AtCode.listed;
  #assert at_generation(h,7)==AtCode.ok && at_generation(h,6)==AtCode.ok && at_generation(h,8)==AtCode.generation;
}
#test "the binding is SHA-256 of the domain, the endpoint key and the release id" {
  out:[64]u8;
  #assert at_binding(AT_K3,AT_RID,out[..]) && cast(string)out[..]==AT_BINDING;
  #assert at_binding(AT_K1,AT_RID,out[..]) && cast(string)out[..]!=AT_BINDING;
  #assert !at_binding(AT_K3[0..<62],AT_RID,out[..]) && !at_binding(AT_K3,"zz",out[..]);
}
#test "the endpoint reads; its key is its signer and its window is an hour" {
  tb:[2048]u8;eb:[4096]u8;c:[4096]u8;t:[1024]u8;tok:=at_token_test(tb[..],AT_CLAIMS);text:=at_endpoint_test(eb[..],tok);
  e:=at_endpoint_read(AT_K3,AT_EP_TAGS,text);
  #assert e.code==AtCode.ok && e.release==AT_RID && e.endpoint==AT_K3 && e.binding==AT_BINDING && e.token==tok;
  #assert e.issued_at==1791999940 && e.valid_until==1792003540 && e.head=="30202:79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798:vault";
  #assert at_endpoint_read(AT_K1,AT_EP_TAGS,text).code==AtCode.endpoint;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"hpke\":null","\"hpke\":\"AAAA\"")).code==AtCode.hpke;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"valid_until\":1792003540","\"valid_until\":1792003541")).code==AtCode.window;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"valid_until\":1792003540","\"valid_until\":1791999939")).code==AtCode.window;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"valid_until\":1792003540","\"valid_until\":1791999940")).code==AtCode.tags;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"issued_at\":1791999940","\"issued_at\":-1")).code==AtCode.times;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"binding\":\"5312","\"binding\":\"X312")).code==AtCode.binding;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"release\":\"97263","\"release\":\"X7263")).code==AtCode.release;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"operator\":\"79be","\"operator\":\"X9be")).code==AtCode.field;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"kind\":\"gcp-confidential-space-token\"","\"kind\":\"tdx-quote\"")).code==AtCode.evidence;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"format\":\"pki\"","\"format\":\"raw\"")).code==AtCode.evidence;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"format\":\"pki\",","")).code==AtCode.evidence;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"format\":\"pki\"","\"format\":\"pki\",\"x\":1")).code==AtCode.evidence;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"token\":\"","\"token\":1,\"t\":\"")).code==AtCode.evidence;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"evidence\":[{","\"evidence\":[{\"format\":\"pki\",\"kind\":\"gcp-confidential-space-token\",\"token\":\"a\"},{")).code==AtCode.evidence;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"evidence\":[{","\"evidence\":[1,{")).code==AtCode.evidence;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"endpoint.v1","endpoint.v9")).code==AtCode.version;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"requires\":[]","\"requires\":[1]")).code==AtCode.version;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"hpke\":null,","")).code==AtCode.field;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"hpke\":null","\"hpke\":null,\"hpkf\":null")).code==AtCode.field;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"\"hpke\":null","\"hpke\":null,\"hpke\":null")).code==AtCode.field;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,at_case(c[..],text,"}]","}] ]")).code==AtCode.json;
  #assert at_endpoint_read(AT_K3,AT_EP_TAGS,"\"x\"").code==AtCode.json;
  #assert at_endpoint_read(AT_K3,at_case(t[..],AT_EP_TAGS,"oa:att-endpoint:v1","oa:att-endpoint:v0"),text).code==AtCode.marker;
  #assert at_endpoint_read(AT_K3,at_case(t[..],AT_EP_TAGS,"[\"e\",\"97263","[\"e\",\"07263"),text).code==AtCode.release;
  #assert at_endpoint_read(AT_K3,at_case(t[..],AT_EP_TAGS,"[\"d\",\"aaaa","[\"d\",\"Aaaa"),text).code==AtCode.tags;
  #assert at_endpoint_read(AT_K3,at_case(t[..],AT_EP_TAGS,"[\"d\",\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"],",""),text).code==AtCode.tags;
  #assert at_endpoint_read(AT_K3,at_case(t[..],AT_EP_TAGS,",[\"expiration\",\"1792003540\"]",""),text).code==AtCode.tags;
  #assert at_endpoint_read(AT_K3,at_case(t[..],AT_EP_TAGS,"[\"expiration\",\"1792003540\"]","[\"expiration\",\"1792003541\"]"),text).code==AtCode.tags;
  #assert at_endpoint_read(AT_K3,at_case(t[..],AT_EP_TAGS,"[\"a\",","[\"b\","),text).code==AtCode.tags;
}
#test "a matching endpoint passes every check and still gets level open" {
