  #assert at_may_send(v,AtLevel.open) && !at_may_send(v,AtLevel.hardened) && !at_may_send(v,AtLevel.tee) && !at_may_send(v,AtLevel.tee_cloud);
  #assert !at_may_send(AtVerdict.{code=AtCode.digest},AtLevel.open);
  #assert at_may_send(AtVerdict.{level=AtLevel.tee},AtLevel.hardened) && at_may_send(AtVerdict.{level=AtLevel.tee},AtLevel.tee) && !at_may_send(AtVerdict.{level=AtLevel.tee},AtLevel.tee_cloud);
}
#test "the chain: head signer, workload, address, release, generation, admission, times" {
  r:=at_release_read(AT_K1,AT_RELEASE_TAGS,AT_RELEASE,AT_X);h:=at_head_read(AT_K1,AT_HEAD_TAGS,AT_HEAD);
  tb:[2048]u8;eb:[4096]u8;e:=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],at_token_test(tb[..],AT_CLAIMS)));
  #assert at_verify(AT_RID,r,AT_K1,h,7,e,AT_T0).code==AtCode.ok;
  #assert at_verify(AT_RID,r,AT_K3,h,0,e,AT_T0).code==AtCode.head;
  #assert at_verify(AT_RID,r,AT_K1,h,8,e,AT_T0).code==AtCode.generation;
  #assert at_verify(AT_BINDING,r,AT_K1,h,0,e,AT_T0).code==AtCode.release;
  #assert at_verify(AT_RID,r,AT_K1,h,0,e,AT_T0+3540).code==AtCode.ok;
  #assert at_verify(AT_RID,r,AT_K1,h,0,e,AT_T0+3541).code==AtCode.expired;
  #assert at_verify(AT_RID,r,AT_K1,h,0,e,1791904799).code==AtCode.early;
  x:=r;x.code=AtCode.image;#assert at_verify(AT_RID,x,AT_K1,h,0,e,AT_T0).code==AtCode.image;
  x=r;x.workload="other";#assert at_verify(AT_RID,x,AT_K1,h,0,e,AT_T0).code==AtCode.workload;
  g:=h;g.code=AtCode.json;#assert at_verify(AT_RID,r,AT_K1,g,0,e,AT_T0).code==AtCode.json;
  f:=e;f.code=AtCode.hpke;#assert at_verify(AT_RID,r,AT_K1,h,0,f,AT_T0).code==AtCode.hpke;
  f=e;f.head="30202:79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798:other";#assert at_verify(AT_RID,r,AT_K1,h,0,f,AT_T0).code==AtCode.head;
  f=e;f.binding=AT_X;#assert at_verify(AT_RID,r,AT_K1,h,0,f,AT_T0).code==AtCode.binding;
  f=e;f.endpoint=AT_K1;#assert at_verify(AT_RID,r,AT_K1,h,0,f,AT_T0).code==AtCode.binding;
}
#test "the token's claims must match the release, the binding and the window" {
  r:=at_release_read(AT_K1,AT_RELEASE_TAGS,AT_RELEASE,AT_X);h:=at_head_read(AT_K1,AT_HEAD_TAGS,AT_HEAD);
  c:[2048]u8;tb:[2048]u8;eb:[4096]u8;
  cases:=[19]string.["\"aud\":\"openagents.att.v1\"","\"dbgstat\":\"disabled-since-boot\"","5312236c","\"exp\":1792003600","\"GCP_INTEL_TDX\"",
    "\"iss\":\"https://confidentialcomputing.googleapis.com\"","\"STABLE\"","\"image_digest\":\"sha256:0123","\"submods\":{",
    "\"eat_nonce\":[\"5312236c3e5543abaa57fae6c8e37fcad8e22b9965e06311b9c1de1b6fd74035\"]","\"exp\":1792003600","\"container\":{\"image_digest\":\"sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}",
    "\"support_attributes\":[\"LATEST\",\"STABLE\",\"USABLE\"]","\"aud\":\"openagents.att.v1\"","\"iss\":\"https://confidentialcomputing.googleapis.com\"","\"hwmodel\":\"GCP_INTEL_TDX\"","\"dbgstat\":\"disabled-since-boot\"","\"swname\"","\"exp\":1792003600"];
  into:=[19]string.["\"aud\":\"other\"","\"dbgstat\":\"enabled\"","6312236c","\"exp\":1792003539","\"GCP_AMD_SEV\"",
    "\"iss\":\"https://example.com\"","\"EXPERIMENTAL\"","\"image_digest\":\"sha256:1123","\"submods\":{\"x\":[1,{\"a\":2}],",
    "\"eat_nonce\":\"5312236c3e5543abaa57fae6c8e37fcad8e22b9965e06311b9c1de1b6fd74035\"","\"exp\":\"1792003600\"","\"container\":{}",
    "\"support_attributes\":\"STABLE\"","\"aud\":1","\"iss\":1","\"hwmodel\":1","\"dbgstat\":1","\"swname2\"","\"exp\":1792003540"];
  want:=[19]AtCode.[AtCode.audience,AtCode.debug,AtCode.nonce,AtCode.window,AtCode.hwmodel,
    AtCode.issuer,AtCode.support,AtCode.measurement,AtCode.ok,
    AtCode.ok,AtCode.window,AtCode.measurement,
    AtCode.support,AtCode.audience,AtCode.issuer,AtCode.hwmodel,AtCode.debug,AtCode.ok,AtCode.ok];
  for i:0..<19 {
    e:=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],at_token_test(tb[..],at_case(c[..],AT_CLAIMS,cases[i],into[i]))));
    #assert e.code==AtCode.ok;
    #assert at_verify(AT_RID,r,AT_K1,h,0,e,AT_T0).code==want[i];
  }
  // a release that is not STABLE fails even with a STABLE token
  x:=r;x.support="EXPERIMENTAL";
  e:=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],at_token_test(tb[..],AT_CLAIMS)));
  #assert at_verify(AT_RID,x,AT_K1,h,0,e,AT_T0).code==AtCode.support;
  x=r;x.hwmodel="GCP_AMD_SEV";#assert at_verify(AT_RID,x,AT_K1,h,0,e,AT_T0).code==AtCode.hwmodel;
  // token shape: three parts, base64url, a JSON object
  bad:=[6]string.["a.b","eyJ9.e30.c","a.e30.c.d","a.!!!!.c","a..c","a.eyJhIjoxfQ.c"];
  wantb:=[6]AtCode.[AtCode.token,AtCode.issuer,AtCode.token,AtCode.token,AtCode.token,AtCode.issuer];
  for i:0..<6 {
    e2:=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],bad[i]));
    #assert e2.code==AtCode.ok && at_verify(AT_RID,r,AT_K1,h,0,e2,AT_T0).code==wantb[i];
  }
  e3:=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],at_token_test(tb[..],"[1]")));
  #assert at_verify(AT_RID,r,AT_K1,h,0,e3,AT_T0).code==AtCode.token;
  e3=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],at_token_test(tb[..],"{\"a\":1} 2")));
  #assert at_verify(AT_RID,r,AT_K1,h,0,e3,AT_T0).code==AtCode.token;
  e3=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],at_token_test(tb[..],at_case(c[..],AT_CLAIMS,"\"eat_nonce\":[\"5312236c3e5543abaa57fae6c8e37fcad8e22b9965e06311b9c1de1b6fd74035\"]","\"eat_nonce\":[1,\"5312236c3e5543abaa57fae6c8e37fcad8e22b9965e06311b9c1de1b6fd74035\"]"))));
  #assert at_verify(AT_RID,r,AT_K1,h,0,e3,AT_T0).code==AtCode.ok;
  e3=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],at_token_test(tb[..],at_case(c[..],AT_CLAIMS,"\"eat_nonce\":[\"5312236c3e5543abaa57fae6c8e37fcad8e22b9965e06311b9c1de1b6fd74035\"]","\"eat_nonce\":7"))));
  #assert at_verify(AT_RID,r,AT_K1,h,0,e3,AT_T0).code==AtCode.nonce;
}

#test "hex keys, slugs and image digests are exact" {
  #assert at_hex64(AT_K1) && at_hex64("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef");
  bad:=[7]u8.['F','g','/',':','`','@','G'];
  for c:bad {x:[64]u8;for i:0..<64 {x[i]=AT_K1[i];}x[63]=c;#assert !at_hex64(cast(string)x[..]);}
  #assert !at_hex64(AT_K1[0..<63]) && !at_hex64("");
  #assert at_slug("vault") && at_slug("a-z09") && at_slug("z") && at_slug("0123456789012345678901234567890123456789012345678901234567890123");
  #assert !at_slug("01234567890123456789012345678901234567890123456789012345678901234") && !at_slug("");
  badslug:=[8]string.["{","`","/",":","A","_"," ","a.b"];
  for s:badslug {#assert !at_slug(s);}
  #assert at_image_digest(AT_IMAGE) && !at_image_digest(AT_IMAGE[0..<70]) && !at_image_digest("sha256:") && !at_image_digest("sha512:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef");
}
#forall "a base64url digit's value is its place in the alphabet" c:0..<256 {
  alphabet:="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
  want:=-1;for i:0..<64 {if alphabet[i]==cast(u8)c {want=i;}}
  #assert at_b64v(cast(u8)c)==want;
}
#test "zero is a value: published_at, generation, notice, effective_at, retire_at, issued_at, valid_until" {
  c:[4096]u8;t:[1024]u8;
  z:=at_release_read(AT_K1,AT_RELEASE_TAGS,at_case(c[..],AT_RELEASE,"\"published_at\":1791300000","\"published_at\":0"),AT_X);#assert z.code==AtCode.ok && z.published_at==0;
  h:=at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"generation\":7","\"generation\":0"));#assert h.code==AtCode.ok && h.generation==0;
  h=at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"notice_seconds\":604800","\"notice_seconds\":0"));#assert h.code==AtCode.ok && h.notice==0;
  h=at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"effective_at\":1791904800","\"effective_at\":0"));#assert h.code==AtCode.ok && h.admitted[0].effective_at==0;
  h=at_head_read(AT_K1,AT_HEAD_TAGS,at_case(c[..],AT_HEAD,"\"retire_at\":null","\"retire_at\":0"));#assert h.code==AtCode.ok && h.admitted[0].retire_at==0;
  #assert at_admitted(h,AT_RID,1791300000,AT_T0)==AtCode.retired;
  tb:[2048]u8;eb:[4096]u8;text:=at_endpoint_test(eb[..],at_token_test(tb[..],AT_CLAIMS));
  zero:=at_case(t[..],AT_EP_TAGS,"1792003540","0");
  u:[4096]u8;z1:=at_case(c[..],text,"\"issued_at\":1791999940","\"issued_at\":0");
  e:=at_endpoint_read(AT_K3,zero,at_case(u[..],z1,"\"valid_until\":1792003540","\"valid_until\":0"));
  #assert e.code==AtCode.ok && e.issued_at==0 && e.valid_until==0;
  #assert at_uint_test("0")==0 && at_uint_test("-1")==-1 && at_uint_test("1.5")==-1 && at_uint_test("\"1\"")==-1 && at_uint_test("12")==12;
}
