  #assert !at_tag("[[\"t\",\"a\"]] x","t","").ok && !at_tag("[1]","t","").ok && !at_tag("[[\"t\",1]]","t","").ok && !at_tag("{}","t","").ok;
  two:=at_tag("[[\"e\",\"a\"],[\"x\",\"b\"],[\"e\",\"c\"]]","e","c");#assert two.ok && two.count==2 && two.first=="a" && two.has;
  #assert at_release_read(AT_K1,"[[\"t\",\"oa:att-release:v1\"],[\"x\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"w\",\"vault\"]] x",AT_RELEASE,AT_X).code==AtCode.tags;
  #assert at_head_read(AT_K1,"[[\"d\",\"vault\"],[\"t\",\"oa:att-head:v1\"],[\"e\",\"97263cdd56d438b8a5a2719dab4cc41d62ea7135522c8a838ebf5e82060d504a\"]] x",AT_HEAD).code==AtCode.tags;
