#test "IANA and explicit mesh boundary oracle 0" {
 a0:=[4]u8.[0,0,0,0];
 #assert !fi_address_allowed(a0[..],1);
 #assert !fi_address_allowed(a0[..],2);
 a1:=[4]u8.[0,255,255,255];
 #assert !fi_address_allowed(a1[..],1);
 #assert !fi_address_allowed(a1[..],2);
 a2:=[4]u8.[1,0,0,0];
 #assert fi_address_allowed(a2[..],1);
 #assert !fi_address_allowed(a2[..],2);
 a3:=[4]u8.[0,0,0,1];
 #assert !fi_address_allowed(a3[..],1);
 #assert !fi_address_allowed(a3[..],2);
 a4:=[4]u8.[10,0,0,0];
 #assert !fi_address_allowed(a4[..],1);
 #assert fi_address_allowed(a4[..],2);
 a5:=[4]u8.[10,255,255,255];
 #assert !fi_address_allowed(a5[..],1);
 #assert fi_address_allowed(a5[..],2);
 a6:=[4]u8.[9,255,255,255];
 #assert fi_address_allowed(a6[..],1);
 #assert !fi_address_allowed(a6[..],2);
 a7:=[4]u8.[11,0,0,0];
 #assert fi_address_allowed(a7[..],1);
 #assert !fi_address_allowed(a7[..],2);
 a8:=[4]u8.[100,64,0,0];
 #assert !fi_address_allowed(a8[..],1);
 #assert fi_address_allowed(a8[..],2);
 a9:=[4]u8.[100,127,255,255];
 #assert !fi_address_allowed(a9[..],1);
 #assert fi_address_allowed(a9[..],2);
 a10:=[4]u8.[100,63,255,255];
 #assert fi_address_allowed(a10[..],1);
 #assert !fi_address_allowed(a10[..],2);
 a11:=[4]u8.[100,128,0,0];
 #assert fi_address_allowed(a11[..],1);
 #assert !fi_address_allowed(a11[..],2);
}

