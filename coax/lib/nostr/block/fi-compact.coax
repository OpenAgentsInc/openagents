// Original-byte compact JWS framing only. This is not an assertion verifier.
#load "fi-base64url.coax";
#authority;
FiDots :: struct {ok:bool;first:int;second:int;}
FiCompact :: struct {ok:bool;protected_end:int;payload_start:int;signing_end:int;signature_start:int;signature_size:int;}
#test "compact framing keeps exact original signing input" {
 token:[348]u8;token[0]='e';token[1]='w';token[2]='.';token[3]='e';token[4]='w';token[5]='.';
 for i:6..<348 {token[i]='A';}
 result:=fi_compact_parse(cast(string)token[..]);
 #assert result.ok && result.protected_end==2 && result.payload_start==3 && result.signing_end==5 && result.signature_start==6 && result.signature_size==256;
 #assert cast(string)token[0..<result.signing_end]=="ew.ew";
}
#test "compact framing refuses malformed segments before parsing claims" {
 token:[348]u8;token[0]='e';token[1]='w';token[2]='.';token[3]='e';token[4]='w';token[5]='.';for i:6..<348 {token[i]='A';}
 #assert fi_compact_parse(cast(string)token[..]).ok;
 token[0]='.';#assert !fi_compact_parse(cast(string)token[..]).ok;token[0]='e';
 token[2]='A';#assert !fi_compact_parse(cast(string)token[..]).ok;token[2]='.';
 token[3]='.';#assert !fi_compact_parse(cast(string)token[..]).ok;token[3]='e';
 token[6]='.';#assert !fi_compact_parse(cast(string)token[..]).ok;token[6]='A';
 token[347]='B';#assert !fi_compact_parse(cast(string)token[..]).ok;token[347]='A';
 #assert !fi_compact_parse(cast(string)token[0..<347]).ok;
 #assert !fi_compact_parse("a.b.c").ok && !fi_compact_parse("").ok;
}
#test "framing metadata covers inclusive bounds and both delimiters" {
 #assert fi_compact_size_ok(1) && fi_compact_size_ok(FI_B64URL_MAX);
 #assert !fi_compact_size_ok(0) && !fi_compact_size_ok(FI_B64URL_MAX+1);
 #assert fi_compact_positions(1,3,5) && !fi_compact_positions(0,3,5);
 #assert !fi_compact_positions(1,2,5) && !fi_compact_positions(1,3,4);
 #assert fi_compact_signature_size(256) && fi_compact_signature_size(512);
 #assert !fi_compact_signature_size(255) && !fi_compact_signature_size(513);
 dots:=fi_compact_dots("A.A.B");#assert dots.ok && dots.first==1 && dots.second==3;
 #assert !fi_compact_dots("A.A.B.C").ok && !fi_compact_dots("ABC").ok;
 #assert fi_compact_encoded("ew","ew") && !fi_compact_encoded("A","ew") && !fi_compact_encoded("ew","A");
 #assert !fi_compact_encoded("","ew") && !fi_compact_encoded("ew","");
 dots=fi_compact_dots(".A.B");#assert dots.ok && dots.first==0 && dots.second==2;
}
fi_compact_size_ok :: (n:int)->bool {return n>=1 && n<=FI_B64URL_MAX;}
fi_compact_positions :: (first:int,second:int,n:int)->bool {
 return first>0 && second>first+1 && second<n-1;
}
fi_compact_signature_size :: (size:int)->bool {return size>=256 && size<=512;}
fi_compact_encoded :: (header:string,payload:string)->bool {
 return fi_b64url_decode_size_checked(header,true)>0 && fi_b64url_decode_size_checked(payload,true)>0;
}
fi_compact_dots :: (token:string)->FiDots {
 first:=-1;second:=-1;
 for i:0..<token.count {
  if token[i]=='.' {
   if first==-1 {first=i;}else if second==-1 {second=i;}else {return FiDots.{};}
  }
 }
 return FiDots.{ok=second!=-1,first=first,second=second};
}
fi_compact_parse :: (token:string)->FiCompact {
 result:FiCompact;
 if !fi_compact_size_ok(token.count) {return result;}
 dots:=fi_compact_dots(token);if !dots.ok {return result;}
 first:=dots.first;second:=dots.second;
 if !fi_compact_positions(first,second,token.count) {return result;}
 header:=token[0..<first];payload:=token[first+1..<second];signature:=token[second+1..<token.count];
 if !fi_compact_encoded(header,payload) {return result;}
 size:=fi_b64url_decode_size_checked(signature,true);
 if !fi_compact_signature_size(size) {return result;}
 result.ok=true;result.protected_end=first;result.payload_start=first+1;result.signing_end=second;result.signature_start=second+1;result.signature_size=size;
 return result;
}
