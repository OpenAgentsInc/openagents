// Public signature check only. No FI claims, possession or network authority.
#load "fi-compact.coax";
#load "fi-protected.coax";
#load "../../crypto/rsa_verify.coax";
#authority;
FiSignatureCheck :: struct {verified:bool;header:FiProtected;}
#test "independent signed compact JWS verifies original bytes" {
 token_text:="eyJhbGciOiJSUzI1NiIsInR5cCI6Im5pcC1maStqd3QiLCJraWQiOiJ0ZXN0LWtleSJ9.eyJzdWIiOiJmaXh0dXJlIiwiaWF0IjoxNzAwMDAwMDAwfQ.CXbfHP_sZFGpFYxN_rq_fFgxmzQvAbtz74-BBEC7iP_Nk6WAYkHAdUbvxfLw2o8IRTo96aJQLmy531SiHzUFAuBJgulaiLXiL_G3h2oJk47Wyf8dBqT0A1-E4bGJj1A1Q3D_l68rW02Hd3rj6Djl4P7ZhDXB7bPWTQHqnGmxgEn-gqmt8k1PcEvCjt2WbTiq8dBUyr6Ka4vTRZ8P6EmeHXYboRMcQeK2-I7LhsHoLgXsliSS82upveJPmTuJ2-k-ZQ66LTUZoLjcpC2QbWAzY9h4EOjcy6qMPzwqerIEBVqcNKzskS6TwAec9CBog4QzSIl4UM4c3ClDhB6wnKLTwg";
 token:[458]u8;for i:0..<token.count {token[i]=token_text[i];}
 modulus:=[256]u8.[187,235,103,45,200,60,224,174,82,183,155,72,111,244,156,66,196,112,134,38,206,148,197,28,25,87,203,63,158,63,117,68,147,120,165,135,238,97,30,55,105,50,207,126,1,134,104,131,192,163,212,30,219,107,150,63,0,60,236,35,106,201,223,2,225,234,224,10,31,61,232,200,80,202,51,185,240,121,154,162,115,71,17,221,242,245,13,244,247,39,74,28,134,13,40,135,86,235,155,142,11,160,94,14,25,211,136,239,140,141,182,128,80,230,150,202,239,111,39,154,239,255,104,233,10,106,172,9,148,31,66,95,87,145,106,220,190,165,102,210,106,123,23,144,230,162,89,36,96,244,17,178,173,216,111,12,217,228,26,152,241,75,65,202,241,193,9,238,246,20,233,242,12,123,169,211,188,226,167,187,148,196,161,48,164,15,231,249,101,185,63,206,82,165,21,134,192,51,134,228,5,215,114,173,26,155,11,80,192,95,61,182,96,85,135,70,136,115,17,108,166,252,96,120,26,84,199,152,143,242,185,147,70,217,196,232,219,134,159,59,223,247,60,110,202,117,206,63,36,212,74,167,148,59,239,43];
 result:=fi_jws_signature(token[..],modulus[..]);
 #assert result.verified && result.header.ok && result.header.typ==1;
 #assert cast(string)result.header.kid[0..<result.header.kid_count]=="test-key";
}
#test "invalid compact and malformed keys do not verify" {
 token:=[5]u8.['a','.','b','.','c'];modulus:[256]u8;modulus[0]=128;modulus[255]=1;
 #assert !fi_jws_signature(token[..],modulus[..]).verified;
 #assert !fi_jws_signature(token[..],modulus[0..<255]).verified;
}
#test "changed signed payload is not accepted" {
 token_text:="eyJhbGciOiJSUzI1NiIsInR5cCI6Im5pcC1maStqd3QiLCJraWQiOiJ0ZXN0LWtleSJ9.eyJzdWIiOiJmaXh0dXJlIiwiaWF0IjoxNzAwMDAwMDAwfQ.CXbfHP_sZFGpFYxN_rq_fFgxmzQvAbtz74-BBEC7iP_Nk6WAYkHAdUbvxfLw2o8IRTo96aJQLmy531SiHzUFAuBJgulaiLXiL_G3h2oJk47Wyf8dBqT0A1-E4bGJj1A1Q3D_l68rW02Hd3rj6Djl4P7ZhDXB7bPWTQHqnGmxgEn-gqmt8k1PcEvCjt2WbTiq8dBUyr6Ka4vTRZ8P6EmeHXYboRMcQeK2-I7LhsHoLgXsliSS82upveJPmTuJ2-k-ZQ66LTUZoLjcpC2QbWAzY9h4EOjcy6qMPzwqerIEBVqcNKzskS6TwAec9CBog4QzSIl4UM4c3ClDhB6wnKLTwg";token:[458]u8;for i:0..<token.count {token[i]=token_text[i];}
 modulus:=[256]u8.[187,235,103,45,200,60,224,174,82,183,155,72,111,244,156,66,196,112,134,38,206,148,197,28,25,87,203,63,158,63,117,68,147,120,165,135,238,97,30,55,105,50,207,126,1,134,104,131,192,163,212,30,219,107,150,63,0,60,236,35,106,201,223,2,225,234,224,10,31,61,232,200,80,202,51,185,240,121,154,162,115,71,17,221,242,245,13,244,247,39,74,28,134,13,40,135,86,235,155,142,11,160,94,14,25,211,136,239,140,141,182,128,80,230,150,202,239,111,39,154,239,255,104,233,10,106,172,9,148,31,66,95,87,145,106,220,190,165,102,210,106,123,23,144,230,162,89,36,96,244,17,178,173,216,111,12,217,228,26,152,241,75,65,202,241,193,9,238,246,20,233,242,12,123,169,211,188,226,167,187,148,196,161,48,164,15,231,249,101,185,63,206,82,165,21,134,192,51,134,228,5,215,114,173,26,155,11,80,192,95,61,182,96,85,135,70,136,115,17,108,166,252,96,120,26,84,199,152,143,242,185,147,70,217,196,232,219,134,159,59,223,247,60,110,202,117,206,63,36,212,74,167,148,59,239,43];token[69]='A';
 #assert !fi_jws_signature(token[..],modulus[..]).verified;
}
#test "oversized protected header and malformed header refuse before signature" {
 text:=".e30.";token:[3079]u8;for i:0..<token.count {token[i]=text[i];}
 modulus:[256]u8;modulus[0]=128;modulus[255]=1;
 #assert !fi_jws_signature(token[..],modulus[..]).verified;
}
#test "decoder status and expected signature width must both match" {
 #assert fi_jws_decoded_ok(NC_OK,256,256);
 #assert !fi_jws_decoded_ok(NC_INVALID,256,256);
 #assert !fi_jws_decoded_ok(NC_OK,255,256);
}
fi_jws_decoded_ok :: (error:u32,written:int,expected:int)->bool {
 return error==NC_OK && written==expected;
}
fi_jws_signature :: (token:[]u8,modulus:[]u8)->FiSignatureCheck #export_c {
 text:=cast(string)token;parts:=fi_compact_parse(text);if !parts.ok {return FiSignatureCheck.{};}
 header_bytes:[2048]u8;
 header:=fi_b64url_decode(text[0..<parts.protected_end],header_bytes[..]);
 if header.error!=NC_OK {return FiSignatureCheck.{};}
 projection:=fi_protected_parse(cast(string)header_bytes[0..<header.written]);
 if !projection.ok {return FiSignatureCheck.{};}
 signature:[512]u8;
 decoded:=fi_b64url_decode(text[parts.signature_start..<text.count],signature[..]);
 if !fi_jws_decoded_ok(decoded.error,decoded.written,parts.signature_size) {return FiSignatureCheck.{};}
 if !rsa_verify_sha256(modulus,signature[0..<decoded.written],token[0..<parts.signing_end]) {return FiSignatureCheck.{};}
 return FiSignatureCheck.{verified=true,header=projection};
}
