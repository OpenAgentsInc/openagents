 names:=[3]string.["https://issuer.test","https://other.test","https://third.test"];owners:=[2]string.["human","person"];clients:=[2]string.["service","worker"];
 c:=FiCommunity.{host="relay.test",audience="wss://relay.test",issuers=names[0..<2]};p:FiIssuer;p.issuer="https://issuer.test";p.jwks_uri="https://keys.test";p.transport=1;p.token_class=2;p.maximum_age=10;p.skew=1;p.connection_lifetime=10;p.refresh=1;p.hard_deadline=30;p.marker_name="kind";p.owner_values=owners[..];p.client_values=clients[..];p.noncollision=true;
 p.refresh=0;
 result:=fi_policy_encoding(c,p); #assert !result.ok && result.count==0;
}
#test "policy writer and bytewise ordering boundaries" {
 w:[1]FiPolicyEncoding;w[0].ok=true;fi_policy_u16(w[..],0);fi_policy_u16(w[..],65535);fi_policy_u64(w[..],1);
 #assert w[0].ok && w[0].count==12 && w[0].bytes[0]==0 && w[0].bytes[1]==0 && w[0].bytes[2]==255 && w[0].bytes[3]==255 && w[0].bytes[11]==1;
 w[0].ok=true;fi_policy_u16(w[..],-1);#assert !w[0].ok;w[0].ok=true;fi_policy_u16(w[..],65536);#assert !w[0].ok;
 w[0].ok=true;fi_policy_u64(w[..],-1);#assert !w[0].ok;
 w[0].ok=true;w[0].count=65535;fi_policy_byte(w[..],7);#assert w[0].ok && w[0].count==65536 && w[0].bytes[65535]==7;
 fi_policy_byte(w[..],8);#assert !w[0].ok;w[0].ok=true;w[0].count=-1;fi_policy_byte(w[..],1);#assert !w[0].ok;
 #assert fi_policy_before("a","b") && fi_policy_before("a","aa") && !fi_policy_before("a","a") && !fi_policy_before("b","a");
 #assert !fi_policy_before("aa","a") && fi_policy_before("ab","ac") && !fi_policy_before("ac","ab");
 w[0].ok=true;w[0].count=0;fi_policy_u64(w[..],72623859790382856);#assert w[0].count==8;
 for i:0..<8 {#assert w[0].bytes[i]==cast(u8)(i+1);}
 values:=[17]string.["p","o","n","m","l","k","j","i","h","g","f","e","d","c","b","a","q"];
 w[0].ok=true;w[0].count=0;fi_policy_set(w[..],values[0..<16]);#assert w[0].ok && w[0].bytes[0]==16 && w[0].count==49 && w[0].bytes[3]=='a' && w[0].bytes[48]=='p';
 w[0].ok=true;fi_policy_set(w[..],values[..]);#assert !w[0].ok;
 w[0].ok=true;fi_policy_set(w[0..<0],values[..]);#assert w[0].ok;
}
// Byte writers operate only on owned local storage. They grant no authority.
fi_policy_byte :: (out:[]FiPolicyEncoding,value:u8) {
 if out.count!=1 {return;}if !out[0].ok || out[0].count<0 || out[0].count>=65536 {out[0].ok=false;return;}
 out[0].bytes[out[0].count]=value;out[0].count+=1;
}
fi_policy_u16 :: (out:[]FiPolicyEncoding,value:int) {
 if value<0 || value>65535 {if out.count==1 {out[0].ok=false;}return;}
 fi_policy_byte(out,cast(u8)((value>>8)&255));fi_policy_byte(out,cast(u8)(value&255));
}
fi_policy_u64 :: (out:[]FiPolicyEncoding,value:int) {
 if value<0 {if out.count==1 {out[0].ok=false;}return;}
 for i:0..<8 {fi_policy_byte(out,cast(u8)((value>>((7-i)*8))&255));}
}
fi_policy_string :: (out:[]FiPolicyEncoding,value:string) {
 fi_policy_u16(out,value.count);for b:value {fi_policy_byte(out,b);}
}
fi_policy_before :: (a:string,b:string)->bool {
 for i:0..<a.count {if i>=b.count {return false;}if a[i]<b[i] {return true;}if a[i]>b[i] {return false;}}
 return a.count<b.count;
}
fi_policy_set :: (out:[]FiPolicyEncoding,values:[]string) {
 if values.count>16 {if out.count==1 {out[0].ok=false;}return;}
 fi_policy_byte(out,cast(u8)values.count);order:[16]int;for i:0..<values.count {order[i]=i+1;}
 for i:0..<values.count {for j:i+1..<values.count {if fi_policy_before(values[order[j]-1],values[order[i]-1]) {tmp:=order[i];order[i]=order[j];order[j]=tmp;}}}
 for i:0..<values.count {fi_policy_string(out,values[order[i]-1]);}
}
fi_policy_encoding :: (community:FiCommunity,issuer:FiIssuer)->FiPolicyEncoding #export_c {
 bad:FiPolicyEncoding;cs:=[1]FiCommunity.[community];ps:=[1]FiIssuer.[issuer];
 selected:=fi_select(cs[..],ps[..],community.host,issuer.issuer);if selected.status!=FI_CANDIDATE {return bad;}
 out:[1]FiPolicyEncoding;out[0].ok=true;
 fi_policy_string(out[..],"openagents.fi-config-encoding.v1");
 fi_policy_string(out[..],community.host);fi_policy_string(out[..],community.audience);fi_policy_set(out[..],community.issuers);
 fi_policy_string(out[..],issuer.issuer);fi_policy_string(out[..],issuer.jwks_uri);fi_policy_u64(out[..],issuer.transport);fi_policy_u64(out[..],issuer.token_class);
 fi_policy_u64(out[..],issuer.maximum_age);fi_policy_u64(out[..],issuer.skew);fi_policy_u64(out[..],issuer.connection_lifetime);fi_policy_u64(out[..],issuer.refresh);fi_policy_u64(out[..],issuer.hard_deadline);
 fi_policy_string(out[..],issuer.marker_name);fi_policy_set(out[..],issuer.owner_values);fi_policy_set(out[..],issuer.client_values);
 fi_policy_byte(out[..],ifx issuer.allow_client then 1 else 0);fi_policy_byte(out[..],ifx issuer.noncollision then 1 else 0);
 if !out[0].ok {return bad;}return out[0];
}
