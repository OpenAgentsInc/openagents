// Canonical configuration bytes only. This is not AssertionPolicyId: compiled
// verifier/adapter identity and enforced provider/build binding are absent.
#load "fi-policy.coax";
#authority;
FiPolicyEncoding :: struct {ok:bool;count:int;bytes:[65536]u8;}
#test "selected policy encodes identically under set reordering" {
 names:=[2]string.["https://issuer.test","https://other.test"];owners:=[2]string.["human","person"];clients:=[2]string.["service","worker"];
 c:=FiCommunity.{host="relay.test",audience="wss://relay.test",issuers=names[..]};p:FiIssuer;p.issuer=names[0];p.jwks_uri="https://keys.test";p.transport=1;p.token_class=2;p.maximum_age=10;p.skew=1;p.connection_lifetime=10;p.refresh=1;p.hard_deadline=30;p.marker_name="kind";p.owner_values=owners[..];p.client_values=clients[..];p.allow_client=true;p.noncollision=true;
 a:=fi_policy_encoding(c,p);#assert a.ok && a.count>0;
 names[0]="https://other.test";names[1]="https://issuer.test";owners[0]="person";owners[1]="human";clients[0]="worker";clients[1]="service";
 b:=fi_policy_encoding(c,p);#assert b.ok && cast(string)a.bytes[0..<a.count]==cast(string)b.bytes[0..<b.count];
}
#test "selected configuration changes alter bytes and invalid configuration refuses" {
 names:=[1]string.["https://issuer.test"];c:=FiCommunity.{host="relay.test",audience="wss://relay.test",issuers=names[..]};p:FiIssuer;p.issuer=names[0];p.jwks_uri="https://keys.test";p.transport=1;p.token_class=1;p.maximum_age=10;p.connection_lifetime=10;p.refresh=1;p.hard_deadline=30;
 a:=fi_policy_encoding(c,p);#assert a.ok;
 p.maximum_age=11;b:=fi_policy_encoding(c,p);#assert b.ok && cast(string)a.bytes[0..<a.count]!=cast(string)b.bytes[0..<b.count];p.maximum_age=10;
 p.jwks_uri="https://other.test";b=fi_policy_encoding(c,p);#assert b.ok && cast(string)a.bytes[0..<a.count]!=cast(string)b.bytes[0..<b.count];p.jwks_uri="https://keys.test";
 names[0]="https://other.test";#assert !fi_policy_encoding(c,p).ok;names[0]="https://issuer.test";
 p.refresh=0;#assert !fi_policy_encoding(c,p).ok;
}
