's Coax files\\n\",\"sig\":\"234d64e3badc1d4092b169e6d82c8eb20788bc69133ea47f0e1f52cbe11e21607d3a4397e6f40ee3edb8cafad196a9162e5c66fd496179c0cefe90fa9ad483fc\"}]\n[\"EVENT\",\"issues\",{\"id\":\"963ba9fc751a7e575ad782f6635f6bcafca01bd3b5567d4990f3b95e6385cecb\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217781,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r1a-identities\"],[\"subject\",\"R1a: declaration identities, targets, spans and namespaces\"],[\"t\",\"r1\"],[\"t\",\"compiler\"],[\"size\",\"L\"],[\"parent\",\"d98bd18d14eb90c38974a688a4d41d3917764e2a8a69fd5082dca321a24681cb\"],[\"blocked-by\",\"c296d48f949f9decc5f96333e8d34b113ff066c08a40fbb51af21223c00fdaff\"],[\"alt\",\"A task in the Coax project: R1a: declaration identities, targets, spans and namespaces\"]],\"content\":\"Declaration and content identities, explicit target descriptions, original spans, basic namespaces and minimal inspectable procedure lowering, pinned with differential fixtures and independent oracles.\\n\\nRoadmap: coax/ROADMAP.md.\\n\\n## Acceptance\\n\\n- Differential fixtures pass against independent oracles\\n\",\"sig\":\"8bab69236bbf7c8d14d5bcec42aa03b53cfd6deef7b26520af517ecebf6cecc3a15bfd8c0804ea121846bf89ddc11cd036abbbd35aa9de38809023b26659279e\"}]\n[\"EVENT\",\"issues\",{\"id\":\"f53502bac1b51795d1e3c859655a73d663418b065082d9881662add29ce18c6e\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217780,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r0-authoring-corpus\"],[\"subject\",\"A frozen authoring-task corpus for agents\"],[\"t\",\"r0\"],[\"t\",\"agents\"],[\"size\",\"S\"],[\"parent\",\"6f40bdaaf4012eddd207f37bd5269b7300cb47d982738a2981433b500ffc8f35\"],[\"blocked-by\",\"3c97013cfd742dccd08ffc61f5ef2987590d2bcf3d27a35a3fb228ca00303f57\"],[\"alt\",\"A task in the Coax project: A frozen authoring-task corpus for agents\"]],\"content\":\"Change a kernel, add a field, repair a type error, update a protocol adapter; pinned revisions, tools and budgets; measure accepted completion, repair iterations and edit-to-result time.\\n\\nRoadmap: coax/ROADMAP.md.\\n\\n## Acceptance\\n\\n- Four tasks pinned with oracles agents can't edit\\n- A first run's numbers recorded\\n\",\"sig\":\"874fddab8d55bfbfe89884de740a663f3bcfc078fe3d4e09460ef285711159b3796166124ef077779914cec3948a8af05326531c0290858ad9aa1452f1086dc9\"}]\n[\"EVENT\",\"issues\",{\"id\":\"3c97013cfd742dccd08ffc61f5ef2987590d2bcf3d27a35a3fb228ca00303f57\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217779,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r0-evidence-record\"],[\"subject\",\"One versioned evidence record for checks and mutation\"],[\"t\",\"r0\"],[\"t\",\"tooling\"],[\"size\",\"S\"],[\"parent\",\"6f40bdaaf4012eddd207f37bd5269b7300cb47d982738a2981433b500ffc8f35\"],[\"alt\",\"A task in the Coax project: One versioned evidence record for checks and mutation\"]],\"content\":\"Every claim bound to source, compiler, target, profile, selection and budgets, with outcomes passed, counterexample, inconclusive, infrastructure error and not checked.\\n\\nRoadmap: coax/ROADMAP.md.\\n\\n## Acceptance\\n\\n- coax test and coax mutate write the record\\n- Missing execution is never a pass\\n\",\"sig\":\"5dae280d55d41d05a9ee2d4aaf72438b4f273107b2eebf09deff9d48407adc5afde273600bec5396f8901e4c5a6a99ac693c74fc50945390804dcb5d16d79c32\"}]\n[\"EVENT\",\"issues\",{\"id\":\"ccba52ff7f1b14e8beb1f74deef63ab443c5dfe4fd80deab1369bc5cb45b8446\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217778,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r0-native-check-exe\"],[\"subject\",\"Run eligible checks on emitted native code\"],[\"t\",\"r0\"],[\"t\",\"testing\"],[\"size\",\"M\"],[\"parent\",\"6f40bdaaf4012eddd207f37bd5269b7300cb47d982738a2981433b500ffc8f35\"],[\"blocked-by\",\"c296d48f949f9decc5f96333e8d34b113ff066c08a40fbb51af21223c00fdaff\"],[\"alt\",\"A task in the Coax project: Run eligible checks on emitted native code\"]],\"content\":\"An optional native check executable runs pinned inputs through the evaluator and the emitted unoptimized and optimized procedures and compares values, traps and buffer writes.\\n\\nRoadmap: coax/ROADMAP.md.\\n\\n## Acceptance\\n\\n- Seeded evaluator/emitter defects are caught\\n- Mismatches minimised and kept as regressions\\n\",\"sig\":\"b77b26f1ef3eb1ddce4a6769b637e906bda7339d6fe13bee9cd2a82bb289234c4ae24a111cca27965022b00710a402c427ae5d7b3c956c051b93a894f746d8de\"}]\n[\"EVENT\",\"issues\",{\"id\":\"c296d48f949f9decc5f96333e8d34b113ff066c08a40fbb51af21223c00fdaff\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217777,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r0-semantic-profiles\"],[\"subject\",\"Pin semantic profiles: checked, wrapping and optimization kept apart\"],[\"t\",\"r0\"],[\"t\",\"semantics\"],[\"size\",\"M\"],[\"parent\",\"6f40bdaaf4012eddd207f37bd5269b7300cb47d982738a2981433b500ffc8f35\"],[\"alt\",\"A task in the Coax project: Pin semantic profiles: checked, wrapping and optimization kept apart\"]],\"content\":\"A versioned design and migration for checked arithmetic with explicit wrapping, profile metadata in artifacts and cache keys, and same-profile unoptimized/optimized conformance vectors (overflow, casts, shifts, division edges, evaluation order, cleanup, f32 literal rounding).\\n\\nRoadmap: coax/ROADMAP.md.\\n\\n## Acceptance\\n\\n- Profiles recorded in artifact metadata\\n- Conformance vectors pass in both optimization levels\\n\",\"sig\":\"1afa3ba3ebcad504c9b5ce89fd60f3e9bd521fac6c97a710f8a138992d154c4406db05756ecb587817282d7351dc1445064548939cf57d2e49bb346b1c941ad5\"}]\n[\"EVENT\",\"issues\",{\"id\":\"9d2e29f53d1ab109714ebaa9f38cf47c8fcbd14c51218099511930f244ecfa54\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217776,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r0-independent-review\"],[\"subject\",\"Independently enforced review of invariants, oracles and gates\"],[\"t\",\"r0\"],[\"t\",\"policy\"],[\"size\",\"M\"],[\"parent\",\"6f40bdaaf4012eddd207f37bd5269b7300cb47d982738a2981433b500ffc8f35\"],[\"alt\",\"A task in the Coax project: Independently enforced review of invariants, oracles and gates\"]],\"content\":\"Define who reviews changes to invariants, oracles and verification policy, enforced outside the compiler on owned infrastructure, including moves into unmarked helpers.\\n\\nRoadmap: coax/ROADMAP.md.\\n\\n## Acceptance\\n\\n- The policy is written and enforced by a check outside the compiler\\n- A change that weakens a check and its code together is refused without review\\n\",\"sig\":\"e25651e71dd2b5f7c8f9f59d9026905346439a36f1fb8351ab91d8c73f930ddf3a109a094497b7ce09f9dcc38f762c54b24dbc4f43911c644242fba324b36a31\"}]\n[\"EVENT\",\"issues\",{\"id\":\"d3838817c77b34f32eb9006479c4cebb108e1c73a327b8d602da0ba436e8ded2\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217775,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r0-loop-attribution\"],[\"subject\",\"Attribute the whole clean and warm development loop\"],[\"t\",\"r0\"],[\"t\",\"perf\"],[\"t\",\"tooling\"],[\"size\",\"M\"],[\"parent\",\"6f40bdaaf4012eddd207f37bd5269b7300cb47d982738a2981433b500ffc8f35\"],[\"alt\",\"A task in the Coax project: Attribute the whole clean and warm development loop\"]],\"content\":\"Load/parse/check, compile-time work, generation, C compilation, link, assets, launch and GPU preparation; generated C size and peak compiler memory.\\n\\nRoadmap: coax/ROADMAP.md.\\n\\n## Acceptance\\n\\n- A report attributes every stage for clean and warm builds\\n- The largest bottleneck is named with its numbers\\n\",\"sig\":\"780618ba35fc5ecced1d348ba57fe3276de240a8556159a64fcbb8277ae4655dc83bce53c0f3b2fd8dc0c891551e8dba71db4fcb19851466932035f8684abfc4\"}]\n[\"EVENT\",\"issues\",{\"id\":\"57b3bc4877bf63ea786de351f3616835ffce903546500fda8bdeefc38457fc5f\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217774,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r0-device-tail-budgets\"],[\"subject\",\"Physical-device and frame-tail budgets\"],[\"t\",\"r0\"],[\"t\",\"perf\"],[\"t\",\"ios\"],[\"size\",\"M\"],[\"parent\",\"6f40bdaaf4012eddd207f37bd5269b7300cb47d982738a2981433b500ffc8f35\"],[\"alt\",\"A task in the Coax project: Physical-device and frame-tail budgets\"]],\"content\":\"Agree a frame-tail budget, then measure the Coax kernels on a named phone: CPU time, tails, copies, allocations and GPU upload, with raw results and dispersion retained.\\n\\nRoadmap: coax/ROADMAP.md.\\n\\n## Acceptance\\n\\n- A tail budget is written down before optimizing\\n- Device runs retained with dispersion; the owner's device step is in NEEDS_OWNER.md\\n\",\"sig\":\"664d8ce0dddb13cfd271d78893ebefcaff4ec60db5bf8714b0df4e266903d87b36fe1c7a8993dc779b83e70eca161072911973f5fc2144ebde09d20902c29ff6\"}]\n[\"EVENT\",\"issues\",{\"id\":\"7c2f5867576bf90374a3264acbea6039e72d660b8eeb8e8d676d8ca584d9b5c6\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217773,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30