(Coaxial is the wasm32 probe).\\n\",\"sig\":\"893211397b2b5dcdc81d94fe5be7db4a1f12276cf7478b3001919d752e67194a44afb99e20ba8a648405a5e7555a6474eedab708b7a60e2bb7fc3602b3793ef5\"}]\n[\"EVENT\",\"issues\",{\"id\":\"a9896a04fd5c4adb8f4e3697e37f59328f0ce7c5db0b5944f68185f4fa6623d2\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217764,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r7\"],[\"subject\",\"R7: workspaces, plugins and tooling\"],[\"t\",\"milestone\"],[\"parent\",\"65b710d3add3022d9f4b77e793da9ea1432710c33a0119b4d212cba956fee94b\"],[\"alt\",\"A milestone in the Coax project: R7: workspaces, plugins and tooling\"]],\"content\":\"R7a: formatting, evidence, typed queries and revision-bound fixes early, on current APIs. R7b: workspaces, typed plugins and build programming.\\n\",\"sig\":\"b7ccdfda3de31da53dd0207abf61d84c6ec5cb18c7828f6a042994c911667c7ad3c2e10a9d74a8814040f5ec4e4832ee4126baa9ddb33ebc63a91fd7713554e8\"}]\n[\"EVENT\",\"issues\",{\"id\":\"1ca0f77a097e3a712ed32ce996a2d73c0535b0da6a6923ad1a7b2311eeb29a34\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217763,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r6\"],[\"subject\",\"R6: hygienic typed code and data transformations\"],[\"t\",\"milestone\"],[\"parent\",\"65b710d3add3022d9f4b77e793da9ea1