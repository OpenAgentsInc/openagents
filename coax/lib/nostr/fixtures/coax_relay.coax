,\"8ee9d948eb3062e4ecb6755c77113f4926f306216c14b8230c686dcad6c1cbc4\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"Points: affine and Jacobian add, double and mixed add\"],[\"t\",\"crypto\"],[\"t\",\"secp256k1\"],[\"size\",\"L\"],[\"parent\",\"415aa469756162d066415e784a66144b7217e3c58a11390b85bf34eeec6f3c82\"],[\"blocked-by\",\"6076dbf88d4749a010d74767f252f2849d1aa17a304e4a0ee486b566bc0bb142\"],[\"blocked-by\",\"dd902da03d8d43e06d3f88e7d043e42449957f077f825693fc9e6022a43c9d07\"],[\"alt\",\"Revision of an issue: Points: affine and Jacobian add, double and mixed add\"]],\"content\":\"coax/lib/crypto/secp_group.coax: infinity handling, gej_double, gej_add_ge (mixed), gej_add, ge_set_gej, set_xo (lift x with even y, BIP-340), is_valid_xo, and constant-time table selection ge_table_select.\\n\\n## Acceptance\\n\\n- Generator multiples 1..1000 match the harness\\n- Doubling/adding at infinity and P + (−P) correct\\n- coax mutate: no surviving mutants\\n\\n## Files\\n\\n- `coax/lib/crypto/secp_group.coax`\\n\",\"sig\":\"c016dd58bcca9dae662e9a791e5376cd957278aec0ffdef946867941b4f7756e0e744ba45fdb5a6b3423dd03f3a3333b0ad2e27985126b19a135b04570428b46\"}]\n[\"EVENT\",\"comments\",{\"id\":\"9cf9ceae0301427349f25c0c3ae957f83f79b5ac353fe3593feb90d5569e113c\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215583,\"kind\":1111,\"tags\":[[\"E\",\"dd902da03d8d43e06d3f88e7d043e42449957f077f825693fc9e6022a43c9d07\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"dd902da03d8d43e06d3f88e7d043e42449957f077f825693fc9e6022a43c9d07\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"Scalars mod n in 8×32 limbs\"],[\"t\",\"crypto\"],[\"t\",\"secp256k1\"],[\"size\",\"M\"],[\"parent\",\"2a737385f645eff09bfab959a061fb5f9df78d4cc003826519c97795b58f7a48\"],[\"blocked-by\",\"993ff555b07d19c09c6be7bb909c88dca8843b422aba400720be87c0c34add90\"],[\"blocked-by\",\"22654f5df98515a5756053a6420ec5b184e004f565d8873bf0af1af77650e27f\"],[\"alt\",\"Revision of an issue: Scalars mod n in 8×32 limbs\"]],\"content\":\"coax/lib/crypto/secp_scalar.coax: set_b32 with overflow flag, get_b32, add, mul, negate, inverse, is_zero, constant-time cond_negate, and bit/window extraction for multiplication.\\n\\n## Acceptance\\n\\n- Edge values (0, 1, n−1, n, 2^256−1) and 1,000,000 random ops match the libsecp harness\\n- coax mutate: no surviving mutants\\n\\n## Files\\n\\n- `coax/lib/crypto/secp_scalar.coax`\\n\",\"sig\":\"ae26f84ddb9c42fdf9d9be3aa0595025de703ab93e2b92c5770ce2b61c511e87363c348f2f4170ce8ee4496344cbed4cfd76b57f490b37f5d76a5928be6a7efb\"}]\n[\"EVENT\",\"comments\",{\"id\":\"98056f5dfac54c82a57ce02735efff6b5916c1b09c9b4da801bed78108429e1c\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215582,\"kind\":1111,\"tags\":[[\"E\",\"6076dbf88d4749a010d74767f252f2849d1aa17a304e4a0ee486b566bc0bb142\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"6076dbf88d4749a010d74767f252f2849d1aa17a304e4a0ee486b566bc0bb142\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"Field inversion and square root with fixed addition chains\"],[\"t\",\"crypto\"],[\"t\",\"secp256k1\"],[\"size\",\"M\"],[\"parent\",\"2a737385f645eff09bfab959a061fb5f9df78d4cc003826519c97795b58f7a48\"],[\"blocked-by\",\"51cbe7195c3e7e749848e46be30d7dae6742aba1341095259a9432ac2b88fcef\"],[\"alt\",\"Revision of an issue: Field inversion and square root with fixed addition chains\"]],\"content\":\"inv (a^(p−2)) and sqrt (a^((p+1)/4), returning whether a root exists), constant time, plus inv_vartime for public inputs (may initially call inv).\\n\\n## Acceptance\\n\\n- a·inv(a) = 1 for 100,000 random a; sqrt(a²) = ±a; non-residues refused\\n- Matches libsecp harness on edge values\\n\\n## Files\\n\\n- `coax/lib/crypto/secp_field.coax`\\n\",\"sig\":\"bf3ecf2edb6e7dc313bc88f27d11806ffbb51437d1fa7211c759eef901c3683bbfafe3c92943fa918b216f18c8a45fd857a6d7c5b4226c2923bf882541c0ba9a\"}]\n[\"EVENT\",\"comments\",{\"id\":\"d553c3c559a516d8854c8404dee41d3ad71eb0e81965c4c3d84e77b21a29ee24\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215581,\"kind\":1111,\"tags\":[[\"E\",\"51cbe7195c3e7e749848e46be30d7dae6742aba1341095259a9432ac2b88fcef\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"51cbe7195c3e7e749848e46be30d7dae6742aba1341095259a9432ac2b88fcef\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"Field multiply and square with compile-time bound proofs\"],[\"t\",\"crypto\"],[\"t\",\"secp256k1\"],[\"size\",\"L\"],[\"parent\",\"2a737385f645eff09bfab959a061fb5f9df78d4cc003826519c97795b58f7a48\"],[\"blocked-by\",\"56843d95f261f9667c2fa8429ec068370cbddac6b448bd2e28bca78dda7725c7\"],[\"blocked-by\",\"22654f5df98515a5756053a6420ec5b184e004f565d8873bf0af1af77650e27f\"],[\"alt\",\"Revision of an issue: Field multiply and square with compile-time bound proofs\"]],\"content\":\"mul and sqr with reduction by 2^256 ≡ 2^32 + 977; #run/#assert prove the largest accumulator stays below 2^64 for inputs of magnitude ≤ 8.\\n\\n## Acceptance\\n\\n- The bound #assert fails to compile if the admitted magnitude is raised to 9 (documented negative check)\\n- 1,000,000 random products match a native libsecp256k1 harness\\n- coax mutate: no surviving mutants\\n\\n## Files\\n\\n- `coax/lib/crypto/secp_field.coax`\\n\",\"sig\":\"c1a79c8b24c75fc57c192eb91452670ae4ee6d11c0a142ed545681f64014c83a4aa8de7d41eeb10b73af2dfbb81ff8197112f4910c6b1f05005cbc14900bc99d\"}]\n[\"EVENT\",\"comments\",{\"id\":\"85c48e4bc435fbf5f1b4209032cf3625b56cad73f9b66a7429a34c2a60c35008\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215580,\"kind\":1111,\"tags\":[[\"E\",\"22654f5df98515a5756053a6420ec5b184e004f565d8873bf0af1af77650e27f\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"22654f5df98515a5756053a6420ec5b184e004f565d8873bf0af1af77650e27f\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"A differential harness against libsecp256k1\"],[\"t\",\"crypto\"],[\"t\",\"tests\"],[\"t\",\"tools\"],[\"size\",\"M\"],[\"parent\",\"2a737385f645eff09bfab959a061fb5f9df78d4cc003826519c97795b58f7a48\"],[\"alt\",\"Revision of an issue: A differential harness against libsecp256k1\"]],\"content\":\"tools/coax-nostr/fuzz/: fetch libsecp256k1 at a pinned tag (verify tarball hash), build it with the harness only, expose field/scalar/point/schnorr/ecdh comparisons to C drivers that call our modules. Never vendored into the tree.\\n\\n## Acceptance\\n\\n- `tools/coax-nostr/fuzz/run.sh field 60` runs 60 s with no disagreement on a correct build and finds a planted bug\\n- Tarball hash pinned and checked\\n\\n## Files\\n\\n- `tools/coax-nostr/fuzz/`\\n\",\"sig\":\"b990a18dc2b08819af749d4a9be08f82aecc8ecfca6d43b4f7e9bd679809a493a5062d5f276d76b73b24a11c8fba35a66f668fcc50e668d500747c56b32af27b\"}]\n[\"EVENT\",\"comments\",{\"id\":\"db3a1668c39cd6ef78ffc6d20ce9bbf3b6fb3a4d835beb96814dbcd05ffc5539\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215579,\"kind\":1111,\"tags\":[[\"E\",\"56843d95f261f9667c2fa8429ec068370cbddac6b448bd2e28bca78dda7725c7\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"56843d95f261f9667c2fa8429ec068370cbddac6b448bd2e28bca78dda7725c7\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"Field elements in 10×26 limbs: load, store, normalize, add, negate\"],[\"t\",\"crypto\"],[\"t\",\"secp256k1\"],[\"size\",\"M\"],[\"parent\",\"2a737385f645eff09bfab959a061fb5f9df78d4cc003826519c97795b58f7a48\"],[\"blocked-by\",\"993ff555b07d19c09c6be7bb909c88dca8843b422aba400720be87c0c34add90\"],[\"alt\",\"Revision of an issue: Field elements in 10×26 limbs: load, store, normalize, add, negate\"]],\"content\":\"coax/lib/crypto/secp_field.coax: the representation, set_b32 (refusing ≥ p where asked), get_b32, normalize (constant time), add, negate with magnitude parameter, mul_int, is_zero, equal. Debug magnitude/normalized tracking.\\n\\n## Acceptance\\n\\n- #test round-trips for 0, 1, p−1, 2^256−1 mod p and limb-boundary values\\n- Magnitude violations trap in debug builds (negative tests)\\n\\n## Files\\n\\n- `coax/lib/crypto/secp_field.coax`\\n\",\"sig\":\"4d7fb0f3541ff4b907cb65d3b992c1a44324480076a897982a682f8b586574696d8c30a8d79dad55fca8ec37b2e2580af4b7994d0cf4f9c514772b06cf6b4ec0\"}]\n[\"EVENT\",\"comments\",{\"id\":\"565ab834c561d3e62d7445412a327ab8e84bd93081f9adde3edd175a50171b64\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215578,\"kind\":1111,\"tags\":[[\"E\",\"5c3ad1344c774e75a2dda906d5631c31c8993d0a47493bdd44f3c3c2bc60cfdf\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"5c3ad1344c774e75a2dda906d5631c31c8993d0a47493bdd44f3c3c2bc60cfdf\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"Bounded hex and base64 codecs\"],[\"t\",\"nostr\"],[\"size\",\"S\"],[\"parent\",\"351453fe6079dc23cec9f2ee0c28604295624d7a68a042753a1d52718ac24ac7\"],[\"alt\",\"Revision of an issue: Bounded hex and base64 codecs\"]],\"content\":\"coax/lib/nostr/hex.coax and base64.coax (standard alphabet, with padding, as NIP-44 uses): encode and strict decode into caller buffers; refuse bad characters, bad padding and overflow.\\n\\n## Acceptance\\n\\n- RFC 4648 §10 vectors pass\\n- Every invalid NIP-44 base64 case is refused\\n- coax mutate: no surviving mutants\\n\\n## Files\\n\\n- `coax/lib/nostr/hex.coax`\\n- `coax/lib/nostr/base64.coax`\\n\",\"sig\":\"027882d32a0ab28163fa22bc4dfe18419ba56983a5310d68d060fb94862b3e1f5b2b8448c2c8f31f478bba3e183bd7a9356d1280d5899c234434ce50cb152158\"}]\n[\"EVENT\",\"comme