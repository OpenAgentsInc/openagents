"],[\"subject\",\"R4: generics and foundational libraries\"],[\"t\",\"milestone\"],[\"parent\",\"65b710d3add3022d9f4b77e793da9ea1432710c33a0119b4d212cba956fee94b\"],[\"alt\",\"A milestone in the Coax project: R4: generics and foundational libraries\"]],\"content\":\"R4a first: generic copyable values and non-owning operations over fixed storage; owning libraries wait for R3b.\\n\",\"sig\":\"b0ee6579d627a42bc0378752a84ffc9694770da9f04d06a8045f86aff1d610c00fc5db3ea932b11fe829614d245df67bdebc779fe2a1b02c19c2f2733201dfd3\"}]\n[\"EVENT\",\"issues\",{\"id\":\"27ad3acadab3d706b6accf79869f8d2eea208d65e92768a7782aaa8eadba8b4a\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217760,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r3\"],[\"subject\",\"R3: ownership and allocation policies\"],[\"t\",\"milestone\"],[\"parent\",\"65b710d3add3022d9f4b77e793da9ea1432710c33a0119b4d212cba956fee94b\"],[\"alt\",\"A milestone in the Coax project: R3: ownership and allocation policies\"]],\"content\":\"R3a started (E0383 rejects simple returns of borrows into local arrays). Then typed transfer, deferred destruction and owning storage (R3b).\\n\",\"sig\":\"da99295c82306a234048bd64efe6273b5bde11071fe254691fe9cbf34aa00ce0950df624be7485b786098a1ef577b40ee13b2b540c32d630b0a333c87ecfa73e\"}]\n[\"EVENT\",\"issues\",{\"id\":\"08f57f4e5b411eee3cea11793e980103f99b6afb6d2afc45211d9b93046e855c\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217759,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r2\"],[\"subject\",\"R2: fallible application code\"],[\"t\",\"milestone\"],[\"parent\",\"65b710d3add3022d9f4b77e793da9ea1432710c33a0119b4d212cba956fee94b\"],[\"alt\",\"A milestone in the Coax project: R2: fallible application code\"]],\"content\":\"R2a first: tagged results and optionals, exhaustive switching, propagation and cleanup; a shared asynchronous host contract with R3.\\n\",\"sig\":\"80f789ba864788eab96e34d50c5c47dccc57273d6f6715408bfa92e48d9bcda888dfa68a95b0dcd23b5097f1025d10037934970a9d88cf809c8a31fe253cd160\"}]\n[\"EVENT\",\"issues\",{\"id\":\"d98bd18d14eb90c38974a688a4d41d3917764e2a8a69fd5082dca321a24681cb\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217758,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r1\"],[\"subject\",\"R1: the compiler substrate\"],[\"t\",\"milestone\"],[\"parent\",\"65b710d3add3022d9f4b77e793da9ea1432710c33a0119b4d212cba956fee94b\"],[\"alt\",\"A milestone in the Coax project: R1: the compiler substrate\"]],\"content\":\"R1a first: declaration and content identities, explicit targets, original spans, basic namespaces and inspectable procedure lowering, pinned by differential fixtures. R1b scheduling and configuration follow.\\n\",\"sig\":\"1a560c7638033263f4a9dba46819b8c4ee52aa9c0c781efc45b43b22942b2f03882e0b03d3f195e4f4740499201e56e10c10ac9ba3d70b30a761e63ebde1838e\"}]\n[\"EVENT\",\"issues\",{\"id\":\"6f40bdaaf4012eddd207f37bd5269b7300cb47d982738a2981433b500ffc8f35\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217757,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"r0\"],[\"subject\",\"R0: the adoption gate\"],[\"t\",\"milestone\"],[\"parent\",\"65b710d3add3022d9f4b77e793da9ea1432710c33a0119b4d212cba956fee94b\"],[\"alt\",\"A milestone in the Coax project: R0: the adoption gate\"]],\"content\":\"Real engine kernels and the whole development loop measured against frozen references, original-source debugging, one release/status source and an independently enforced review gate. Exit: reproducible kernel and whole-loop reports, no unexpected output or allocation regressions, usable native debugging, a versioned baseline.\\n\",\"sig\":\"88843fc009e27f4875945dcea85547361dfc6121b080767a0985620054d6402c56665fd86852aef113a44a7de8275aab9c67a78e218636baff0cd54d50d1fb6d\"}]\n[\"EVENT\",\"issues\",{\"id\":\"65b710d3add3022d9f4b77e793da9ea1432710c33a0119b4d212cba956fee94b\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217756,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"coax-roadmap\"],[\"subject\",\"Coax: the language and its toolchain, R0 to R12\"],[\"t\",\"initiative\"],[\"t\",\"coax\"],[\"t\",\"compiler\"],[\"t\",\"roadmap\"],[\"alt\",\"A initiative in the Coax project: Coax: the language and its toolchain, R0 to R12\"]],\"content\":\"The main Coax roadmap: what gets built in what order so OpenAgents and Metareal can express computation, data, protocols, tools and build policy in Coax, with costs and ownership visible. Milestones have dependencies and exit evidence, not dates.\\n\\nSpecification: `coax/ROADMAP.md` in the openagents repository.\\n\",\"sig\":\"41c13192d37decdfa94975c811c8717a4c5376bfdcaa907ca23fe042fd5403c31967efb382d972f1e8eac372359d602e23e700a2d7153f6b5709ba27d28b5457\"}]\n[\"EVENT\",\"issues\",{\"id\":\"c96951910dfb701627c5e9888c5265343c262f128b2471853a440fd3dc487aee\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793217553,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"project-page-verify\"],[\"subject\",\"The live project page verifies every event in Coax\"],[\"t\",\"web\"],[\"t\",\"crypto\"],[\"t\",\"nostr\"],[\"size\",\"M\"],[\"parent\",\"56535bb0d3eb500391d723bb4693a660cdcbe8c97c07a5f7a91a2b2900987376\"],[\"blocked-by\",\"c29a2169fbe2992a82613bd23599354fa629e325e7131fb5f7d79974aabdd0c2\"],[\"blocked-by\",\"41bdfb8f0861f587a6f0b7b8aa9e47b854da9dde7e1d659913eb0ac28e94926c\"],[\"blocked-by\",\"7cdf2fe4a30442eba7a02e6eeafe44f90b64e24eb7fd9e231280d1f11b34e753\"],[\"alt\",\"A task in the Coax project: The live project page verifies every event in Coax\"]],\"content\":\"Once Schnorr verification lands, the live page checks every event's id and signature in Coax before folding it (≤ 4 ms of verification per frame, the rest queued), and stops relying on the relay's check.\\n\\n## Acceptance\\n\\n- Unverified events never appear; a count of rows still checking is shown\\n- A forged event injected through a test relay is refused and counted\\n\\n## Files\\n\\n- `apps/openagents-web/project.coax`\\n\",\"sig\":\"9c6965c8415e2401c7d56e4bc52a6726e5fe181da33f277d5ece61986ab4066c9596c706311052963ae4cc0b7df35e6b9827bade51eb5263f428eeae52c1c764\"}]\n[\"EVENT\",\"issues\",{\"id\":\"73ce5c1cdf68fecacb68149159896ca1d245fe253597cde984cc61a0310aa7c4\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793216655,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"phone-sign-in-e2e\"],[\"subject\",\"End to end: sign in to openagents.com with the phone\"],[\"t\",\"mobile\"],[\"t\",\"web\"],[\"t\",\"auth\"],[\"size\",\"M\"],[\"parent\",\"968040980c4cc123132f11495fc8b6279fadc183015b1b17bf2026b1e02f89e9\"],[\"blocked-by\",\"a1d85392c1cdcda73b83d8c22b82c959267620ea119aac3408b4e077dc0b13d1\"],[\"blocked-by\",\"c8ddf047e6f45e3cb209922826bd0a56284dbb200afff3c52b33cf566b927490\"],[\"alt\",\"A task in the Coax project: End to end: sign in to openagents.com with the phone\"]],\"content\":\"The deliverable test: the iOS simulator scans the QR shown by the page (fixture image of the live page's code), approves, and the page reaches the signed-in state with the server session bound to the phone's pubkey. Device run is an owner step in NEEDS_OWNER.md.\\n\\n## Acceptance\\n\\n- Simulator plus headless page run passes against a local relay and server\\n- Staging run passes against relay.openagents.com\\n- Device step recorded for the owner\\n\",\"sig\":\"798b3f7f9fb4908ec4c33f6bba6548b70d8cb2373b45a8910bffee413dca162dea2c9568235039962ad33893e88c4fecb9e41cc1a6f3ac6e04916060edfbea63\"}]\n[\"EVENT\",\"issues\",{\"id\":\"c8ddf047e6f45e3cb209922826bd0a56284dbb200afff3c52b33cf566b927490\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793216654,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"web-sign-in-page\"],[\"subject\",\"openagents.com/signin: the QR and the signed-in state\"],[\"t\",\"web\"],[\"t\",\"auth\"],[\"size\",\"M\"],[\"parent\",\"968040980c4cc123132f11495fc8b6279fadc183015b1b17bf2026b1e02f89e9\"],[\"blocked-by\",\"cf3977ddddce49a1b04ca39289cb829a8f039848cd5c7961c961107f0935e4aa\"],[\"blocked-by\",\"503d16e4b775432544983bc1ce6da378ed209075fd3faf24d4e5384f28a1a3b8\"],[\"blocked-by\",\"0af19f0b640e3bfc544a89722f0f5af6d9601dd5d2ebadbd28fccc54f8d7eac9\"],[\"alt\",\"A task in the Coax project: openagents.com/signin: the QR and the signed-in state\"]],\"content\":\"A Coaxial page draws the QR (HUD, Filament), waits for the phone, then asks it to sign the NIP-98 event and posts it to /auth/nostr. Shows who is signed in (npub, short) and sign out. Plain text in the hidden main for agents.\\n\\n## Acceptance\\n\\n- check-visuals passes; real-Chrome screenshots of waiting and signed-in states\\n- The page never holds the user's secret key\\n\",\"sig\":\"5b603985504ec1ebb75d0270a79aa7a147f9225168b4fd2bdd2eafa0144841b12a5929c2661cb0204990969eef79c10320eac684116099be0e8d0f63711f97d9\"}]\n[\"EVENT\",\"issues\",{\"id\":\"0af19f0b640e3bfc544a89722f0f5af6d9601dd5d2ebadbd28fccc54f8d7eac9\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793216653,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"server-nip98-session\"],[\"subject\",\"The server verifies NIP-98 HTTP auth and issues a session\"],[\"t\",\"server\"],[\"t\",\"auth\"],[\"size\",\"M\"],[\"parent\",\"968040980c4cc123132f11495fc8b6279fadc183015b1b17bf2026b1e02f89e9\"],[\"blocked-by\",\"41bdfb8f0861f587a6f0b7b8aa9e47b854da9dde7e1d659913eb0ac28e94926c\"],[\"blocked-by\",\"7cdf2fe4a30442eba7a02e6eeafe44f90b64e24eb7fd9e231280d1f11b34e753\"],[\"alt\",\"A task in the Coax project: The server verifies NIP-98 HTTP auth and issues a session\"]],\"content\":\"A native Coax server route POST /auth/nostr takes a NIP-98 kind 27235 event (url, method, payload hash, created_at within 60 s, unused id), verifies it with the Coax verifier, and sets an HttpOnly, Secure, SameSite=Strict session cookie bound to the pubkey. Admin pubkeys come from config. No WorkOS.\\n\\n## Acceptance\\n\\n- Tests: valid event accepted; wrong url, method, stale time, replayed id and bad signature refused\\n- The cookie carries no key material and expires\\n\",\"sig\":\"47cbb327115594270fe4fc23eeb044cf69ce3b729b75a687529d431e486816ffc590e28ce438d525507acfd8ab4f4af4d0c5c99b06949d434f312393c33b8712\"}]\n[\"EVENT\",\"issues\",{\"id\":\"a1d85392c1cdcda73b83d8c22b82c959267620ea119aac3408b4e077dc0b13d1\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793216652,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"ios-scan-to-sign-in\"],[\"subject\",\"Scan a sign-in code with the phone and approve\"],[\"t\",\"mobile\"],[\"t\",\"ios\"],[\"t\",\"nip46\"],[\"size\",\"M\"],[\"parent\",\"968040980c4cc123132f11495fc8b6279fadc183015b1b17bf2026b1e02f89e9\"],[\"blocked-by\",\"bde19af6ec5d47fc841159be677d94f04b1002c837df352b2b949e15f1ffb99e\"],[\"blocked-by\",\"bc0bce463e952c08fc1ee63adca4818d6a1ca4666d9c3d38f4957bd2dfe4f192\"],[\"blocked-by\",\"503d16e4b775432544983bc1ce6da378ed209075fd3faf24d4e5384f28a1a3b8\"],[\"alt\",\"A task in the Coax project: Scan a sign-in code with the phone and approve\"]],\"content\":\"The app's QR scanner recognises nostrconnect:// codes, shows the site and what it asks for in an approval sheet, and on approval runs the NIP-46 signer for that session; the session shows in Settings and can be ended there.\\n\\n## Acceptance\\n\\n- Simulator UI test: a fixture QR image opens the approval sheet; approve connects to a local relay\\n- Ending the session in Settings makes later requests fail\\n\",\"sig\":\"474225ac1552a88ccae0568a36bc74bd0fd11440cd1b41ebe0f9a8a3b8ecb339f1fddc4952ea2f91a64d3289720e4de98071af989b8334a4937137a53c750b1c\"}]\n[\"EVENT\",\"issues\",{\"id\":\"503d16e4b775432544983bc1ce6da378ed209075fd3faf24d4e5384f28a1a3b8\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793216651,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"coax-qr-encoder\"],[\"subject\",\"QR code encoder in Coax\"],[\"t\",\"web\"],[\"t\",\"qr\"],[\"size\",\"M\"],[\"parent\",\"968040980c4cc123132f11495fc8b6279fadc183015b1b17bf2026b1e02f89e9\"],[\"alt\",\"A task in the Coax project: QR code encoder in Coax\"]],\"content\":\"Byte mode, error correction M, versions 1 to 15, mask selection by the standard penalty rules; output a module grid the page draws as HUD strokes or quads.\\n\\n## Acceptance\\n\\n- Matches a reference encoder's module grids for 20 fixed strings including a 300-byte nostrconnect URI\\n- A phone camera (the iOS scanner test) decodes a rendered code\\n\",\"sig\":\"d0b430cbca4531d421d604bb77f30b661699038cc645b58d02b4f09e14cc685315adadf69bc07cbb71cc667af64d2d0e351aa9290874a545eda4f406196118be\"}]\n[\"EVENT\",\"issues\",{\"id\":\"cf3977ddddce49a1b04ca39289cb829a8f039848cd5c7961c961107f0935e4aa\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793216650,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"nip46-client-page\"],[\"subject\",\"NIP-46 client in the page\"],[\"t\",\"nip46\"],[\"t\",\"web\"],[\"size\",\"M\"],[\"parent\",\"968040980c4cc123132f11495fc8b6279fadc183015b1b17bf2026b1e02f89e9\"],[\"blocked-by\",\"bde19af6ec5d47fc841159be677d94f04b1002c837df352b2b949e15f1ffb99e\"],[\"blocked-by\",\"4cca7f4d3f587b3796ead071adb8ce12e2673e186e7dcc8e25e2037f573289ea\"],[\"alt\",\"A task in the Coax project: NIP-46 client in the page\"]],\"content\":\"The page side of Nostr Connect: an ephemeral client key, the nostrconnect:// URI (relay, secret, perms, name, url), waiting for the signer's connect, then get_public_key and sign_event requests over the page's relay client.\\n\\n## Acceptance\\n\\n- Native test: the page client and the Coax signer complete connect and a sign_event over an in-memory relay\\n- The client key is ephemeral and wiped at sign-out\\n\",\"sig\":\"bfea045f3de2a249b3bf75948173da805504f1b785f1342ab3cbc6a30be827fe15e7bb7346b2b0068365a807d727481a208c00b0ac64844d688f6902cb3cf09d\"}]\n[\"EVENT\",\"issues\",{\"id\":\"bde19af6ec5d47fc841159be677d94f04b1002c837df352b2b949e15f1ffb99e\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793216649,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"nip46-signer\"],[\"subject\",\"NIP-46 remote signer (bunker side) in Coax\"],[\"t\",\"nip46\"],[\"t\",\"crypto\"],[\"t\",\"mobile\"],[\"size\",\"L\"],[\"parent\",\"968040980c4cc123132f11495fc8b6279fadc183015b1b17bf2026b1e02f89e9\"],[\"blocked-by\",\"48783672d1a1652b41951c641f8331bcd3c574549b481196abb3251529dfb167\"],[\"blocked-by\",\"7cdf2fe4a30442eba7a02e6eeafe44f90b64e24eb7fd9e231280d1f11b34e753\"],[\"blocked-by\",\"7de9620d9706743839185d429a0bdd1b25cd768c2d97d5f60025a697fda7475d\"],[\"alt\",\"A task in the Coax project: NIP-46 remote signer (bunker side) in Coax\"]],\"content\":\"Kind 24133 requests and responses encrypted with NIP-44 between the client's key and the signer's key; methods connect (with the secret from the QR), get_public_key, sign_event, ping, nip44_encrypt/decrypt. Every sign_event needs the user's approval unless the session granted that kind. Shared Coax module, used by the phone.\\n\\n## Acceptance\\n\\n- Round trips against the NIP-46 examples and a nostr-effect NIP-46 client in a native test\\n- A wrong or reused connect secret is refused\\n- Requests outside the granted permissions are refused\\n\",\"sig\":\"aee34c6bf59f13f2d164be67165fecf92c7bcad4b888f80a691011a9fb7bdc4d4c91c06b6c1f1bb0f0667afc4854ec0f229e4a29f5ea7f1f1475ee6a7f9373ac\"}]\n[\"EVENT\",\"issues\",{\"id\":\"bc0bce463e952c08fc1ee63adca4818d6a1ca4666d9c3d38f4957bd2dfe4f192\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793216648,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"ios-key-custody\"],[\"subject\",\"The phone holds the user's Nostr key in the Keychain\"],[\"t\",\"mobile\"],[\"t\",\"ios\"],[\"t\",\"keys\"],[\"size\",\"M\"],[\"parent\",\"968040980c4cc123132f11495fc8b6279fadc183015b1b17bf2026b1e02f89e9\"],[\"blocked-by\",\"a812bca96c91845e93b0908ca34b456ba0750da412501313b6c0358d2228a191\"],[\"alt\",\"A task in the Coax project: The phone holds the user's Nostr key in the Keychain\"]],\"content\":\"Create or import a key (nsec) on the phone; store it in the Keychain, this device only, unlocked by Face ID or passcode for each signature; never synced, logged or sent. Export only on an explicit owner action. Signing goes through the Coax library with the key wiped after use.\\n\\n## Acceptance\\n\\n- A UI test creates a key, signs an event and verifies it with the Coax verifier\\n- The Keychain item is ThisDeviceOnly with user presence required\\n- No key bytes in logs (test greps the simulator log)\\n\\n## Files\\n\\n- `apps/openagents-ios/OpenAgents/`\\n\",\"sig\":\"8ceb1c07f923fc508b1ba42f32f879c4ff063bbb80919ee39d4ed20fea4fd4aa821110c2589dffa45804feaa3b486f67de3b2a393016e1f9b777a070d4c59185\"}]\n[\"EVENT\",\"issues\",{\"id\":\"a812bca96c91845e93b0908ca34b456ba0750da412501313b6c0358d2228a191\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793216647,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"ios-coax-nostr-native\"],[\"subject\",\"The Coax Nostr library runs on iOS against the same vectors\"],[\"t\",\"mobile\"],[\"t\",\"ios\"],[\"t\",\"crypto\"],[\"size\",\"M\"],[\"parent\",\"968040980c4cc123132f11495fc8b6279fadc183015b1b17bf2026b1e02f89e9\"],[\"blocked-by\",\"51f416c58a9c0b1b034d374a7fec805de9d9864211814cd792831113ab0f53a8\"],[\"blocked-by\",\"48783672d1a1652b41951c641f8331bcd3c574549b481196abb3251529dfb167\"],[\"blocked-by\",\"7cdf2fe4a30442eba7a02e6eeafe44f90b64e24eb7fd9e231280d1f11b34e753\"],[\"alt\",\"A task in the Coax project: The Coax Nostr library runs on iOS against the same vectors\"]],\"content\":\"Build the Coax Nostr modules (hashes, secp256k1, Schnorr, ECDH, NIP-44, events, bech32) as C for iOS arm64 and the simulator through the app's Generated/ build step, and run the shared vector files in the iOS test target. Report sign and verify times on a device.\\n\\n## Acceptance\\n\\n- BIP-340, NIP-44 and event vectors pass in the iOS simulator test target\\n- The same vector files the wasm and native builds use, byte for byte\\n- Sign and verify timings recorded in a note (simulator; device when the owner runs it)\\n\\n## Files\\n\\n- `apps/openagents-ios/project.yml`\\n- `apps/openagents-ios/Tests/`\\n\",\"sig\":\"ebb4b8ba2f36312a52c19e8875dc9e239a74c0ff407a6942f8f30e8fb439b8170c698a93871198fd84ff813d511dd7c160f38cd2bddc08ebda163e97a68173f8\"}]\n[\"EVENT\",\"issues\",{\"id\":\"968040980c4cc123132f11495fc8b6279fadc183015b1b17bf2026b1e02f89e9\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793216646,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"m9-phone-sign-in\"],[\"subject\",\"Sign in to the website with your phone\"],[\"t\",\"milestone\"],[\"parent\",\"72f75267f47e6638ec4eb026ddaf506a8efc543f08c80f53997b5813d29399bd\"],[\"alt\",\"A milestone in the Coax project: Sign in to the website with your phone\"]],\"content\":\"The deliverable: open openagents.com/signin, scan its QR code with the OpenAgents mobile app, approve, and the website is signed in as your Nostr key. The key never leaves the phone. NIP-46 (Nostr Connect) between page and phone over relay.openagents.com, NIP-98 HTTP auth to the server, no WorkOS. The same Coax Nostr library runs on the phone (compiled to C), in the page (wasm) and on the server (native).\\n\",\"sig\":\"f91c78da79c7ac6218983307bffafdae4bc3b5539ff241199769e547849f92d8e8db462bd019fef8657cd7c3d4768b93417e33f4321211916505e0a9dc17b358\"}]\n[\"EVENT\",\"issues\",{\"id\":\"cf0533bafc8ef564549aa2cd792fb3d93db97e5c0631c3800c89c662a3253a0b\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214884,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"secp-glv\"],[\"subject\",\"GLV endomorphism for faster verification\"],[\"t\",\"crypto\"],[\"t\",\"secp256k1\"],[\"t\",\"performance\"],[\"size\",\"M\"],[\"reward\",\"6000\",\"sat\"],[\"parent\",\"56535bb0d3eb500391d723bb4693a660cdcbe8c97c07a5f7a91a2b2900987376\"],[\"blocked-by\",\"c29a2169fbe2992a82613bd23599354fa629e325e7131fb5f7d79974aabdd0c2\"],[\"alt\",\"A task in the Coax project: GLV endomorphism for faster verification\"]],\"content\":\"Split scalars with the secp256k1 endomorphism in ecmult_vartime; measure verify on the live project page.\\n\\n## Acceptance\\n\\n- Differential fuzz 1 hour clean\\n- Verify at least 1.3× faster in wasm32 (bench)\\n\\n## Files\\n\\n- `coax/lib/crypto/secp_mult.coax`\\n\",\"sig\":\"7170a94db0dbbe585c3df7771439d69ff8b976658b50203d3ea9e9e162a3ff77db32f853b32d592508b81d8159d6b03167c7c390bd01cbdbbf7922d3715dc2e6\"}]\n[\"EVENT\",\"issues\",{\"id\":\"43563f5c9dbec79366f79a97141cb22c4561f83944616eab350e3996dfb14cc5\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214883,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"claim-from-page\"],[\"subject\",\"Claim a task from the page with a signed event\"],[\"t\",\"web\"],[\"t\",\"projects\"],[\"t\",\"nostr\"],[\"size\",\"M\"],[\"reward\",\"6000\",\"sat\"],[\"parent\",\"56535bb0d3eb500391d723bb4693a660cdcbe8c97c07a5f7a91a2b2900987376\"],[\"blocked-by\",\"c29a2169fbe2992a82613bd23599354fa629e325e7131fb5f7d79974aabdd0c2\"],[\"blocked-by\",\"fd709fde9a20e47041f0fa1f491257a7c4bf832c527d10ac97a5149f7b2bfe13\"],[\"alt\",\"A task in the Coax project: Claim a task from the page with a signed event\"]],\"content\":\"A signed-in visitor (local key or NIP-07) claims an OPEN task: the page builds the claim request, signs it, sends it to the coordinator endpoint and shows the lease.\\n\\n## Acceptance\\n\\n- A claim made in the page appears on another browser within 5 s\\n- The claim is refused cleanly when another claim holds the task\\n\\n## Files\\n\\n- `apps/openagents-web/`\\n\",\"sig\":\"b9f3bfd913cffa76eda9b4d4d37ffed3ff8972ecdf017002b8f3195ce2ab78e8bfc38d8786d49a77ae2142a72dd798648668e4f76174cc83256af983d89ade24\"}]\n[\"EVENT\",\"issues\",{\"id\":\"c29a2169fbe2992a82613bd23599354fa629e325e7131fb5f7d79974aabdd0c2\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214882,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"project-page-live\"],[\"subject\",\"/project/coax reads its project, tasks and order from the relay\"],[\"t\",\"web\"],[\"t\",\"projects\"],[\"size\",\"L\"],[\"reward\",\"15000\",\"sat\"],[\"parent\",\"56535bb0d3eb500391d723bb4693a660cdcbe8c97c07a5f7a91a2b2900987376\"],[\"blocked-by\",\"4cca7f4d3f587b3796ead071adb8ce12e2673e186e7dcc8e25e2037f573289ea\"],[\"blocked-by\",\"ce0b851defc71422aea5845628d6f47c59b681505f712be0abf4766360a4c761\"],[\"alt\",\"A task in the Coax project: /project/coax reads its project, tasks and order from the relay\"]],\"content\":\"The real project page subscribes to the project, its tasks and the order record, verifies incrementally (≤ 4 ms per frame), and draws the queue from verified events only; the demo page keeps baked data.\\n\\n## Acceptance\\n\\n- Moving a task in the order record and republishing reorders the live page without a deploy\\n- Unverified events never appear; a count of rows still checking is shown\\n\\n## Files\\n\\n- `apps/openagents-web/project.coax`\\n- `apps/openagents-web/project/coax/`\\n\",\"sig\":\"0b3640a99e30e075d9540bab0c4031c335fa46fa42228c32199e4f2e614a713e4d7f3e10a05e04a30c55b503939941300ce5937eb132d4193a997b1fb7125e1b\"}]\n[\"EVENT\",\"issues\",{\"id\":\"ce0b851defc71422aea5845628d6f47c59b681505f712be0abf4766360a4c761\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214881,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"publish-project-events\"],[\"subject\",\"Publish the Coax project and its tasks as Nostr events\"],[\"t\",\"nostr\"],[\"t\",\"projects\"],[\"size\",\"M\"],[\"reward\",\"6000\",\"sat\"],[\"parent\",\"56535bb0d3eb500391d723bb4693a660cdcbe8c97c07a5f7a91a2b2900987376\"],[\"blocked-by\",\"5d1af539c7ef817a326f1ff314008ae905c72700d07d924d5cece537cdcb92dd\"],[\"alt\",\"A task in the Coax project: Publish the Coax project and its tasks as Nostr events\"]],\"content\":\"Use coax-nostr publish to sign the kind 30621 project (with path and contributions tags per docs/protocol/2026-10-28-projects.md), its work items from this file, and the queue order record, with the project key.\\n\\n## Acceptance\\n\\n- Events fetched back from relay.openagents.com verify and match this file\\n- Re-publishing is idempotent (same d tags replace)\\n\\n## Files\\n\\n- `tools/coax-nostr/`\\n- `apps/openagents-web/project/coax/work/`\\n\",\"sig\":\"0cb1f9859722bf1e664a02879c809d0e3d20c5ad95218177b4a13d528cc1e35ca4299d000cb5769e792eb44201ad4059fa922aa42c194694042808cddffc763f\"}]\n[\"EVENT\",\"issues\",{\"id\":\"97b87d0491b6420da9185339e5705d2478124c6d588de6b13d6af23507a60ca7\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214880,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"invariant-coax-only\"],[\"subject\",\"INVARIANTS: Coaxial pages draw and compute everything in Coax\"],[\"t\",\"policy\"],[\"t\",\"web\"],[\"size\",\"S\"],[\"reward\",\"2000\",\"sat\"],[\"parent\",\"6c0d25259ca6ef6ff8b2ff046edc5a0b95713d6a9dfabfabe916a0ab8aca35ea\"],[\"blocked-by\",\"4a73354378a9e7058ca56491bb7de0bed6ea1d80d8be1f82c92b94e10d882bb3\"],[\"blocked-by\",\"51e676b7869c773966ca2761abb58dd2548847d72869e035fae8a55075b6a630\"],[\"blocked-by\",\"5d1af539c7ef817a326f1ff314008ae905c72700d07d924d5cece537cdcb92dd\"],[\"alt\",\"A task in the Coax project: INVARIANTS: Coaxial pages draw and compute everything in Coax\"]],\"content\":\"Change the INVARIANTS rule as coax/nostr.md §5 says, extend check-visuals.sh to refuse any page script besides host.js and any WebCrypto use, delete coax/web/unlock/, remove bun from deploy.\\n\\n## Acceptance\\n\\n- check-visuals.sh passes on all pages and fails on a planted extra script\\n- coax/web/unlock/ is gone\\n\\n## Files\\n\\n- `INVARIANTS.md`\\n- `coax/web/check-visuals.sh`\\n- `coax/web/unlock/`\\n\",\"sig\":\"07695ed947f3ede018d349acba6c1c17e213a1b705378d8a3997a1263c6a4d612bbedd09396a14dfa910e89905bf76f8f320c4b2f46cd32e299a474e28b3cee8\"}]\n[\"EVENT\",\"issues\",{\"id\":\"5d1af539c7ef817a326f1ff314008ae905c72700d07d924d5cece537cdcb92dd\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214879,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"coax-nostr-cli\"],[\"subject\",\"coax-nostr: a native CLI for keygen, seal, gate, publish and verify\"],[\"t\",\"tools\"],[\"t\",\"nostr\"],[\"size\",\"L\"],[\"reward\",\"15000\",\"sat\"],[\"parent\",\"6c0d25259ca6ef6ff8b2ff046edc5a0b95713d6a9dfabfabe916a0ab8aca35ea\"],[\"blocked-by\",\"ef5aa35ce36cfdd1bf6ed0c89e20ebaa292e896adedf1fb553e03c4f6204a432\"],[\"blocked-by\",\"fdce7d97951b382e2d14adec11c47a90ddfad1987a5c19d9cfef0619d30f637f\"],[\"blocked-by\",\"7de9620d9706743839185d429a0bdd1b25cd768c2d97d5f60025a697fda7475d\"],[\"alt\",\"A task in the Coax project: coax-nostr: a native CLI for keygen, seal, gate, publish and verify\"]],\"content\":\"tools/coax-nostr/: a native program built from the same modules: keygen, seal deck.md --author --to, gate (writes unlock entries for deploy.sh), publish (sign and send events to a relay with AUTH, using a small native socket), verify, fetch.\\n\\n## Acceptance\\n\\n- deploy.sh runs the gate step with coax-nostr and no bun\\n- Re-sealing the deck with coax-nostr opens on staging\\n\\n## Files\\n\\n- `tools/coax-nostr/`\\n- `coax/web/deploy.sh`\\n\",\"sig\":\"e7fe7c1e620b63027d0d970f9fe58b4b93b8267599bb3ed450df0e00ec4a47a0d8827518e432f684a7ad877bc2b0badd8fb0a44c6d7d9ecc7710f0d598fc0663\"}]\n[\"EVENT\",\"issues\",{\"id\":\"51e676b7869c773966ca2761abb58dd2548847d72869e035fae8a55075b6a630\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214878,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"unlock-gate-coax\"],[\"subject\",\"The phrase gate in Coax, without AES\"],[\"t\",\"web\"],[\"t\",\"crypto\"],[\"size\",\"M\"],[\"reward\",\"6000\",\"sat\"],[\"parent\",\"6c0d25259ca6ef6ff8b2ff046edc5a0b95713d6a9dfabfabe916a0ab8aca35ea\"],[\"blocked-by\",\"4747fbcbf213e5c9af2f8f7d793a9b19f3b0d9ef23259ea776670da780296456\"],[\"blocked-by\",\"5fc9d914022e871930f5eaacbb29f1615373f22063c0dc14c89c0f0e09f2cde8\"],[\"blocked-by\",\"f20e2fcf01473864c4e6a74bda37893d2c7b3705e68e00b759902cb0395b28f9\"],[\"alt\",\"A task in the Coax project: The phrase gate in Coax, without AES\"]],\"content\":\"Replace gate.ts: salted SHA-256 check, PBKDF2 (210,000 rounds) to a ChaCha20 key and an HMAC key, encrypt-then-MAC pointer (coax/nostr.md §10.3), all in Coax; the terminal raises the check.\\n\\n## Acceptance\\n\\n- A refused phrase and the real phrase behave as today on staging with gate.ts removed\\n- No WebCrypto call remains in the page (grep check in check-visuals.sh)\\n\\n## Files\\n\\n- `apps/openagents-web/`\\n- `coax/web/unlock/gate.ts`\\n\",\"sig\":\"7d3951e45d91507fc9168a16ecbd83f9ad5688d57049be3db82b4516cd632856d763016175991e19fcc3f66db4cc19b52e2c3c068119b0a857b20642b56606f0\"}]\n[\"EVENT\",\"issues\",{\"id\":\"4a73354378a9e7058ca56491bb7de0bed6ea1d80d8be1f82c92b94e10d882bb3\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214877,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"unlock-opener-coax\"],[\"subject\",\"Open the hidden deck in Coax\"],[\"t\",\"web\"],[\"t\",\"nostr\"],[\"size\",\"M\"],[\"reward\",\"6000\",\"sat\"],[\"parent\",\"6c0d25259ca6ef6ff8b2ff046edc5a0b95713d6a9dfabfabe916a0ab8aca35ea\"],[\"blocked-by\",\"4cca7f4d3f587b3796ead071adb8ce12e2673e186e7dcc8e25e2037f573289ea\"],[\"blocked-by\",\"ef5aa35ce36cfdd1bf6ed0c89e20ebaa292e896adedf1fb553e03c4f6204a432\"],[\"blocked-by\",\"fdce7d97951b382e2d14adec11c47a90ddfad1987a5c19d9cfef0619d30f637f\"],[\"alt\",\"A task in the Coax project: Open the hidden deck in Coax\"]],\"content\":\"Replace coax/web/unlock/page.ts: fetch the wrap through relay.coax with AUTH as the recipient, unwrap with nip59.coax, check the envelope, hand slides to ui.coax.\\n\\n## Acceptance\\n\\n- The real phrase opens the deck on staging with page.ts removed\\n- Wrong key shows the key-wrong state\\n\\n## Files\\n\\n- `apps/openagents-web/`\\n- `coax/web/unlock/`\\n\",\"sig\":\"7e729e69d4b6d230cbd7d9c7485e618534d2e9ed3297575179ca6fd6031f148f03a58d39d9921bf45fc091140567d514a6c892ba632fbf89670c9cf98df61663\"}]\n[\"EVENT\",\"issues\",{\"id\":\"4cca7f4d3f587b3796ead071adb8ce12e2673e186e7dcc8e25e2037f573289ea\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214876,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"relay-in-page\"],[\"subject\",\"The page subscribes to relay.openagents.com with AUTH\"],[\"t\",\"web\"],[\"t\",\"nostr\"],[\"size\",\"M\"],[\"reward\",\"6000\",\"sat\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"blocked-by\",\"7de9620d9706743839185d429a0bdd1b25cd768c2d97d5f60025a697fda7475d\"],[\"blocked-by\",\"47b1de82fd67af95ad4ce28f2164dc8812c48fd30ae27cec4b49f99aa824c2e0\"],[\"blocked-by\",\"d0d77f68357bf14ddf77a52687a8305cbeff29d616c315d021290f7bede0bac2\"],[\"blocked-by\",\"fd709fde9a20e47041f0fa1f491257a7c4bf832c527d10ac97a5149f7b2bfe13\"],[\"alt\",\"A task in the Coax project: The page subscribes to relay.openagents.com with AUTH\"]],\"content\":\"Wire host pipes and relay.coax into a probe page: connect, answer AUTH with a test key, subscribe to a known filter, draw verified event count and refusals.\\n\\n## Acceptance\\n\\n- Probe on staging shows the expected count from relay.openagents.com\\n- A REQ is never sent before AUTH completes (asserted from the outbox log)\\n\\n## Files\\n\\n- `apps/openagents-web/`\\n\",\"sig\":\"b90d14d84c6c4c392b854ac6a9f7133b5599f09faac16ddd04b2903c4229a3081a0ddb54523a57628da6960913b150614e469387193a60f1ea174f2475795eff\"}]\n[\"EVENT\",\"issues\",{\"id\":\"fd709fde9a20e47041f0fa1f491257a7c4bf832c527d10ac97a5149f7b2bfe13\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214875,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"nostr-keys\"],[\"subject\",\"Key slots, storage records and the NIP-07 adapter\"],[\"t\",\"nostr\"],[\"t\",\"web\"],[\"size\",\"M\"],[\"reward\",\"6000\",\"sat\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"blocked-by\",\"44fe38068474bb38e4943023b7752418e8ab8eab89edea791e9702883ce9aa1b\"],[\"blocked-by\",\"8ccd826b7e26625fa02fdef67065f80e033e23d28fa419e7e8c9680c57cd2e5c\"],[\"blocked-by\",\"51f416c58a9c0b1b034d374a7fec805de9d9864211814cd792831113ab0f53a8\"],[\"alt\",\"A task in the Coax project: Key slots, storage records and the NIP-07 adapter\"]],\"content\":\"coax/lib/nostr/keys.coax: SecretSlot with forget(), import from nsec or hex, the stored record format, and the signer interface the page calls (local slot or NIP-07 through host imports: pubkey, sign, nip44 decrypt).\\n\\n## Acceptance\\n\\n- A pasted key survives reload via storage; forget() zeroes the slot and deletes the record\\n- With a NIP-07 extension present, signing goes through it (manual check recorded)\\n\\n## Files\\n\\n- `coax/lib/nostr/keys.coax`\\n- `coax/web/host.js`\\n\",\"sig\":\"bc49e95efb10e5214ca53f77d459b36402164b46a5087809373fc57493c63710dc574f7e29e18f6a51300d04f3bdbea6dff8e70d8993bd0d02adc133159e95e8\"}]\n[\"EVENT\",\"issues\",{\"id\":\"7de9620d9706743839185d429a0bdd1b25cd768c2d97d5f60025a697fda7475d\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214874,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"nostr-relay-state-machine\"],[\"subject\",\"The relay client state machine\"],[\"t\",\"nostr\"],[\"size\",\"L\"],[\"reward\",\"15000\",\"sat\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"blocked-by\",\"7cdf2fe4a30442eba7a02e6eeafe44f90b64e24eb7fd9e231280d1f11b34e753\"],[\"blocked-by\",\"941365238306bf0600e998a145f98b31010de2ce773b52cfee524c115b88b9e2\"],[\"blocked-by\",\"f4268f9b58bbf38358880298462c5958b0cbb59dfefca02ecb6c5303e40d3fc2\"],[\"alt\",\"A task in the Coax project: The relay client state machine\"]],\"content\":\"coax/lib/nostr/relay.coax per coax/nostr.md §8: connection states, backoff, subscriptions, EOSE, CLOSED reasons, OK handling, duplicate suppression, verification before delivery, AUTH-before-REQ queueing.\\n\\n## Acceptance\\n\\n- #test drives it with scripted relay transcripts: auth-required, CLOSED auth-required then success, duplicate events, bad signatures dropped and counted, backoff timing\\n- No I/O inside the module (it compiles without the host)\\n\\n## Files\\n\\n- `coax/lib/nostr/relay.coax`\\n\",\"sig\":\"44e829a21f1d2b09d5c243ee0104984d98d2c46e801bf06eed8c1f842d4939130a201fb061663ab74bb54a287f2959d3cc8904aefa52ae8543c6241bd0515f3b\"}]\n[\"EVENT\",\"issues\",{\"id\":\"f4268f9b58bbf38358880298462c5958b0cbb59dfefca02ecb6c5303e40d3fc2\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214873,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"nostr-nip42\"],[\"subject\",\"NIP-42 AUTH events\"],[\"t\",\"nostr\"],[\"size\",\"S\"],[\"reward\",\"2000\",\"sat\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"blocked-by\",\"7cdf2fe4a30442eba7a02e6eeafe44f90b64e24eb7fd9e231280d1f11b34e753\"],[\"blocked-by\",\"51f416c58a9c0b1b034d374a7fec805de9d9864211814cd792831113ab0f53a8\"],[\"alt\",\"A task in the Coax project: NIP-42 AUTH events\"]],\"content\":\"coax/lib/nostr/nip42.coax: build the kind 22242 event for (challenge, relay URL) and sign it locally or hand it to the NIP-07 signer.\\n\\n## Acceptance\\n\\n- Events verify in nostr-effect and match its Nip42 builder's tags\\n\\n## Files\\n\\n- `coax/lib/nostr/nip42.coax`\\n\",\"sig\":\"e066f6fe9a6aabc5744bf71f0967cbb770ffc0d88df523d5b96daea046e146f8e7602fd9287ed440cbc4a291c465f5391798be99de38d43454076720c7b7ad67\"}]\n[\"EVENT\",\"issues\",{\"id\":\"44fe38068474bb38e4943023b7752418e8ab8eab89edea791e9702883ce9aa1b\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214872,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"host-storage-pipe\"],[\"subject\",\"Host import: IndexedDB bytes\"],[\"t\",\"web\"],[\"t\",\"host\"],[\"size\",\"S\"],[\"reward\",\"2000\",\"sat\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"alt\",\"A task in the Coax project: Host import: IndexedDB bytes\"]],\"content\":\"store_put/get/delete over one IndexedDB object store per origin; results via the inbox; private browsing failure reported, not thrown.\\n\\n## Acceptance\\n\\n- Put, reload, get returns the same bytes in a probe page\\n- Works when IndexedDB is unavailable (reports unavailable)\\n\\n## Files\\n\\n- `coax/web/host.js`\\n\",\"sig\":\"7f70dcb47e4dc066756461204a6fdf24281071ba36c2caadcefcbd84723f11bdbd7f485fbeff1e1dd44a41c675edd97262718413571a07dfabf15af5ff13ae66\"}]\n[\"EVENT\",\"issues\",{\"id\":\"47b1de82fd67af95ad4ce28f2164dc8812c48fd30ae27cec4b49f99aa824c2e0\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214871,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"host-socket-pipe\"],[\"subject\",\"Host import: a WebSocket byte pipe\"],[\"t\",\"web\"],[\"t\",\"host\"],[\"size\",\"M\"],[\"reward\",\"6000\",\"sat\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"alt\",\"A task in the Coax project: Host import: a WebSocket byte pipe\"]],\"content\":\"socket_open(url), socket_send(id, ptr, len), socket_close(id); open/frame/close/error delivered through the inbox as new message kinds; at most 4 sockets; text frames only.\\n\\n## Acceptance\\n\\n- A probe page connects to relay.openagents.com, sends a REQ and draws the frame count\\n- Closing and errors arrive as inbox messages (#test with a fake inbox)\\n\\n## Files\\n\\n- `coax/web/host.js`\\n- `apps/openagents-web/ui.coax`\\n\",\"sig\":\"04f465ac47ad60e6d3f8c4573576376f03e4a2f02bd48c25cb83bdb775464ebe620f5bd2de840896300c231f47bdc21d365d2b7b26e1349078b399e6faf73121\"}]\n[\"EVENT\",\"issues\",{\"id\":\"d0d77f68357bf14ddf77a52687a8305cbeff29d616c315d021290f7bede0bac2\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214870,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"host-random-import\"],[\"subject\",\"Host import: random bytes\"],[\"t\",\"web\"],[\"t\",\"host\"],[\"size\",\"S\"],[\"reward\",\"2000\",\"sat\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"alt\",\"A task in the Coax project: Host import: random bytes\"]],\"content\":\"coax/web/host.js: `random(ptr, len)` from crypto.getRandomValues (chunked at 65,536 bytes); a page without it refuses to run crypto.\\n\\n## Acceptance\\n\\n- A probe page draws 64 random hex characters that change per load\\n- check-visuals.sh passes\\n\\n## Files\\n\\n- `coax/web/host.js`\\n\",\"sig\":\"f69de9c939ca9193b7e15f887db231393790e0fbd309b5922e38ebf60098261c748cb8c48ea81d0182f6a389ada0cd51a39fbee9b9cac4d7578cc4898b421e41\"}]\n[\"EVENT\",\"issues\",{\"id\":\"8ccd826b7e26625fa02fdef67065f80e033e23d28fa419e7e8c9680c57cd2e5c\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214869,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"nostr-bech32\"],[\"subject\",\"bech32 and NIP-19 entities\"],[\"t\",\"nostr\"],[\"size\",\"M\"],[\"reward\",\"6000\",\"sat\"],[\"parent\",\"abf5ecb9864de2dd92cf46a47832768354bf2a3a49178ab240fdfb6d49a14844\"],[\"blocked-by\",\"5c3ad1344c774e75a2dda906d5631c31c8993d0a47493bdd44f3c3c2bc60cfdf\"],[\"alt\",\"A task in the Coax project: bech32 and NIP-19 entities\"]],\"content\":\"coax/lib/nostr/bech32.coax: BIP-173 bech32 encode/decode with NIP-19 length limits; npub/nsec/note and nprofile/nevent/naddr TLV; unknown TLV types ignored; nsec decodes into a SecretSlot.\\n\\n## Acceptance\\n\\n- BIP-173 valid and invalid vectors pass\\n- NIP-19 examples round-trip; nostr-effect Nip19 agrees on 10,000 random entities\\n\\n## Files\\n\\n- `coax/lib/nostr/bech32.coax`\\n\",\"sig\":\"72491994b2244ff59a0e2cb4d0cc367b1caad7db455abfa835b196377d8e027ad1a5867f9050d4f6573b3686be778c38d72a773f308d76c554f764df478509f0\"}]\n[\"EVENT\",\"issues\",{\"id\":\"941365238306bf0600e998a145f98b31010de2ce773b52cfee524c115b88b9e2\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214868,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"nostr-filter\"],[\"subject\",\"REQ filters: build and match locally\"],[\"t\",\"nostr\"],[\"size\",\"S\"],[\"reward\",\"2000\",\"sat\"],[\"parent\",\"abf5ecb9864de2dd92cf46a47832768354bf2a3a49178ab240fdfb6d49a14844\"],[\"blocked-by\",\"7cdf2fe4a30442eba7a02e6eeafe44f90b64e24eb7fd9e231280d1f11b34e753\"],[\"alt\",\"A task in the Coax project: REQ filters: build and match locally\"]],\"content\":\"coax/lib/nostr/filter.coax: ids, authors, kinds, #<tag>, since, until, limit; serialize to JSON and match an event locally (to drop events a relay shouldn't have sent).\\n\\n## Acceptance\\n\\n- #test matrix of filter × event matches NIP-01 semantics\\n\\n## Files\\n\\n- `coax/lib/nostr/filter.coax`\\n\",\"sig\":\"8eb54cb07ea08263dcf83c15ed2b1d7d562bde53991d26a61e06e52219d75a928f6b2dbc97dfffa629c6e98e3cb23f1d6dcb8348dfd252a83acb6af3c4ee6f25\"}]\n[\"EVENT\",\"issues\",{\"id\":\"78f3558f1975babb59910e79b424de75f48dd60a8154557f6531729820acb088\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214867,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:openagents\",\"wss://relay.openagents.com\"],[\"a\",\"30621:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575:coax\",\"wss://relay.openagents.com\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"slug\",\"open-sealed-deck-native\"],[\"subject\",\"Open today's sealed deck natively with the Coax stack\"],[\"t\",\"nostr\"],[\"t\",\"tests\"],[\"size\",\"S\"],[\"reward\",\"2000\",\"sat\"],[\"parent\",\"ca06a75181b2db380cb5e9a2522c0910d784670c1c2ce0f5f245e9be5e3793b9\"],[\"blocked-by\",\"ef5aa35ce36cfdd1bf6ed0c89e20ebaa292e896adedf1fb553e03c4f6204a432\"],[\"blocked-by\",\"fdce7d97951b382e2d14adec11c47a90ddfad1987a5c19d9cfef0619d30f637f\"],[\"alt\",\"A task in the Coax project: Open today's sealed deck natively with the Coax stack\"]],\"content\":\"A native test that fetches the sealed test deck's wrap fixture (checked in from the scratch e2e, test deck only), unwraps it with the recipient test key, checks the 3188 envelope digest and prints the slide titles.\\n\\n## Acceptance\\n\\n- Prints the two test-deck slide titles; digest matches\\n\\n## Files\\n\\n- `tools/coax-nostr/tests/`\\n\",\"sig\":\"12c733c90cdb5cf443c3052ea3792167605e9e196fa7c4386ab08752a656169e78c793a7510396ddd5c5b202a6d19754f90e6690fdeabea3d2007146a4b088ae\"}]\n[\"EVENT\",\"issues\",{\"id\":\"fdce7d97951b382e2d14adec11c47a90ddfad1987a5c19d9cfef0619d30f637f\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793214866,\"kind\":1621,\"tags\":[[\"a\",\"30617:9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a