,\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"Host import: random bytes\"],[\"t\",\"web\"],[\"t\",\"host\"],[\"size\",\"S\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"alt\",\"Revision of an issue: Host import: random bytes\"]],\"content\":\"coax/web/host.js: `random(ptr, len)` from crypto.getRandomValues (chunked at 65,536 bytes); a page without it refuses to run crypto.\\n\\n## Acceptance\\n\\n- A probe page draws 64 random hex characters that change per load\\n- check-visuals.sh passes\\n\\n## Files\\n\\n- `coax/web/host.js`\\n\",\"sig\":\"045220a51eeccad7bbe2a136efba2dca854111089d86c1b47f56b59f888d65eae59a296bc93a395895d8a4880dd21e023dc72a4843a8e9f67b4a43ab918c1b4b\"}]\n[\"EVENT\",\"comments\",{\"id\":\"e0d00321e99bb22cf150d446786653e3b42007fd82e93b0fd5085aebab5644ae\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215601,\"kind\":1111,\"tags\":[[\"E\",\"8ccd826b7e26625fa02fdef67065f80e033e23d28fa419e7e8c9680c57cd2e5c\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"8ccd826b7e26625fa02fdef67065f80e033e23d28fa419e7e8c9680c57cd2e5c\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"bech32 and NIP-19 entities\"],[\"t\",\"nostr\"],[\"size\",\"M\"],[\"parent\",\"abf5ecb9864de2dd92cf46a47832768354bf2a3a49178ab240fdfb6d49a14844\"],[\"blocked-by\",\"5c3ad1344c774e75a2dda906d5631c31c8993d0a47493bdd44f3c3c2bc60c