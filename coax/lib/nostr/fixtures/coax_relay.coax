08a0614a344d851d98731575\"],[\"e\",\"cf0533bafc8ef564549aa2cd792fb3d93db97e5c0631c3800c89c662a3253a0b\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"GLV endomorphism for faster verification\"],[\"t\",\"crypto\"],[\"t\",\"secp256k1\"],[\"t\",\"performance\"],[\"size\",\"M\"],[\"parent\",\"56535bb0d3eb500391d723bb4693a660cdcbe8c97c07a5f7a91a2b2900987376\"],[\"blocked-by\",\"c29a2169fbe2992a82613bd23599354fa629e325e7131fb5f7d79974aabdd0c2\"],[\"alt\",\"Revision of an issue: GLV endomorphism for faster verification\"]],\"content\":\"Split scalars with the secp256k1 endomorphism in ecmult_vartime; measure verify on the live project page.\\n\\n## Acceptance\\n\\n- Differential fuzz 1 hour clean\\n- Verify at least 1.3× faster in wasm32 (bench)\\n\\n## Files\\n\\n- `coax/lib/crypto/secp_mult.coax`\\n\",\"sig\":\"383a41fe775759cf3aade78b304215a764c784aa9b2ef313cbf40a2c19dd788d0b5c7302120db26ea45662879ae75f57827eff49074bd938ca08c0f3d7fab66a\"}]\n[\"EVENT\",\"comments\",{\"id\":\"bce5b2fa3319fc5f0dbe4adb51b896807082dec6594592e58ae74b967c79ed29\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215615,\"kind\":1111,\"tags\":[[\"E\",\"43563f5c9dbec79366f79a97141cb22c4561f83944616eab350e3996dfb14cc5\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"43563f5c9dbec79366f79a97141cb22c4561f83944616eab350e3996dfb14cc5\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"Claim a task from the page with a signed event\"],[\"t\",\"web\"],[\"t\",\"projects\"],[\"t\",\"nostr\"],[\"size\",\"M\"],[\"parent\",\"56535bb0d3eb500391d723bb4693a660cdcbe8c97c07a5f7a91a2b2900987376\"],[\"blocked-by\",\"c29a2169fbe2992a82613bd23599354fa629e325e7131fb5f7d79974aabdd0c2\"],[\"blocked-by\",\"fd709fde9a20e47041f0fa1f491257a7c4bf832c527d10ac97a5149f7b2bfe13\"],[\"alt\",\"Revision of an issue: Claim a task from the page with a signed event\"]],\"content\":\"A signed-in visitor (local key or NIP-07) claims an OPEN task: the page builds the claim request, signs it, sends it to the coordinator endpoint and shows the lease.\\n\\n## Acceptance\\n\\n- A claim made in the page appears on another browser within 5 s\\n- The claim is refused cleanly when another claim holds the task\\n\\n## Files\\n\\n- `apps/openagents-web/`\\n\",\"sig\":\"40727d2083f668e2a933e2c913ae914dd5a1e96243d3925c4886a4fc2ea3f07935951dd7fc2c6558681f2fe48b8bedcfe202311e06c5bfb8854af08c084ef54d\"}]\n[\"EVENT\",\"comments\",{\"id\":\"e0c9b1d2357766e08ede3a7676dfac6f095ac54fb7e8b9c7f3e46e2f4a0c2d18\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215614,\"kind\":1111,\"tags\":[[\"E\",\"c29a2169fbe2992a82613bd23599354fa629e325e7131fb5f7d79974aabdd0c2\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"c29a2169fbe2992a82613bd23599354fa629e325e7131fb5f7d79974aabdd0c2\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"/project/coax reads its project, tasks and order from the relay\"],[\"t\",\"web\"],[\"t\",\"projects\"],[\"size\",\"L\"],[\"parent\",\"56535bb0d3eb500391d723bb4693a660cdcbe8c97c07a5f7a91a2b2900987376\"],[\"blocked-by\",\"4cca7f4d3f587b3796ead071adb8ce12e2673e186e7dcc8e25e2037f573289ea\"],[\"blocked-by\",\"ce0b851defc71422aea5845628d6f47c59b681505f712be0abf4766360a4c761\"],[\"alt\",\"Revision of an issue: /project/coax reads its project, tasks and order from the relay\"]],\"content\":\"The real project page subscribes to the project, its tasks and the order record, verifies incrementally (≤ 4 ms per frame), and draws the queue from verified events only; the demo page keeps baked data.\\n\\n## Acceptance\\n\\n- Moving a task in the order record and republishing reorders the live page without a deploy\\n- Unverified events never appear; a count of rows still checking is shown\\n\\n## Files\\n\\n- `apps/openagents-web/project.coax`\\n- `apps/openagents-web/project/coax/`\\n\",\"sig\":\"a30bc8ca016c1c9a70edbdb6b1da5a3c5ada974282662f02717661dd19f5bd3d321cbd8205cf57fbf7ef0554dc7a7cd3f74d494131f6b2e4a32f2c69137a65e7\"}]\n[\"EVENT\",\"comments\",{\"id\":\"d0f51cd97238bd96ffef849332f20200c8593ce57996b37d5fb61a021207ee40\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215613,\"kind\":1111,\"tags\":[[\"E\",\"ce0b851defc71422aea5845628d6f47c59b681505f712be0abf4766360a4c761\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"ce0b851defc71422aea5845628d6f47c59b681505f712be0abf4766360a4c761\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"Publish the Coax project and its tasks as Nostr events\"],[\"t\",\"nostr\"],[\"t\",\"projects\"],[\"size\",\"M\"],[\"parent\",\"56535bb0d3eb500391d723bb4693a660cdcbe8c97c07a5f7a91a2b2900987376\"],[\"blocked-by\",\"5d1af539c7ef817a326f1ff314008ae905c72700d07d924d5cece537cdcb92dd\"],[\"alt\",\"Revision of an issue: Publish the Coax project and its tasks as Nostr events\"]],\"content\":\"Use coax-nostr publish to sign the kind 30621 project (with path and contributions tags per docs/protocol/2026-10-28-projects.md), its work items from this file, and the queue order record, with the project key.\\n\\n## Acceptance\\n\\n- Events fetched back from relay.openagents.com verify and match this file\\n- Re-publishing is idempotent (same d tags replace)\\n\\n## Files\\n\\n- `tools/coax-nostr/`\\n- `apps/openagents-web/project/coax/work/`\\n\",\"sig\":\"cdc2626a3bbe9bffa34fb8cd20678c1fb96ba54d51eadcc7f8cee8f040a4985b1c28a5e14a7e43b4066efec55f3de8fff1dd6fa96f325a2fa11fd8af7ff56f05\"}]\n[\"EVENT\",\"comments\",{\"id\":\"f517111addb64423e34057a8e77f0ee7c61da4fde2d902b40616726a3180f825\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215612,\"kind\":1111,\"tags\":[[\"E\",\"97b87d0491b6420da9185339e5705d2478124c6d588de6b13d6af23507a60ca7\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"97b87d0491b6420da9185339e5705d2478124c6d588de6b13d6af23507a60ca7\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"INVARIANTS: Coaxial pages draw and compute everything in Coax\"],[\"t\",\"policy\"],[\"t\",\"web\"],[\"size\",\"S\"],[\"parent\",\"6c0d25259ca6ef6ff8b2ff046edc5a0b95713d6a9dfabfabe916a0ab8aca35ea\"],[\"blocked-by\",\"4a73354378a9e7058ca56491bb7de0bed6ea1d80d8be1f82c92b94e10d882bb3\"],[\"blocked-by\",\"51e676b7869c773966ca2761abb58dd2548847d72869e035fae8a55075b6a630\"],[\"blocked-by\",\"5d1af539c7ef817a326f1ff314008ae905c72700d07d924d5cece537cdcb92dd\"],[\"alt\",\"Revision of an issue: INVARIANTS: Coaxial pages draw and compute everything in Coax\"]],\"content\":\"Change the INVARIANTS rule as coax/nostr.md §5 says, extend check-visuals.sh to refuse any page script besides host.js and any WebCrypto use, delete coax/web/unlock/, remove bun from deploy.\\n\\n## Acceptance\\n\\n- check-visuals.sh passes on all pages and fails on a planted extra script\\n- coax/web/unlock/ is gone\\n\\n## Files\\n\\n- `INVARIANTS.md`\\n- `coax/web/check-visuals.sh`\\n- `coax/web/unlock/`\\n\",\"sig\":\"09e39c5919b05453b6912702fd6a483382a304425fd9cff6ebc89a5641b5028695dfc7c0d795dafc23d536e2827fc9ee60f0aeb0c9330d94b9a205ddc0c8d2b4\"}]\n[\"EVENT\",\"comments\",{\"id\":\"540383506eef56bea6a9634361a47c7d5f59f963910a2314a957dc91d195f3a7\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215611,\"kind\":1111,\"tags\":[[\"E\",\"5d1af539c7ef817a326f1ff314008ae905c72700d07d924d5cece537cdcb92dd\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"5d1af539c7ef817a326f1ff314008ae905c72700d07d924d5cece537cdcb92dd\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"coax-nostr: a native CLI for keygen, seal, gate, publish and verify\"],[\"t\",\"tools\"],[\"t\",\"nostr\"],[\"size\",\"L\"],[\"parent\",\"6c0d25259ca6ef6ff8b2ff046edc5a0b95713d6a9dfabfabe916a0ab8aca35ea\"],[\"blocked-by\",\"ef5aa35ce36cfdd1bf6ed0c89e20ebaa292e896adedf1fb553e03c4f6204a432\"],[\"blocked-by\",\"fdce7d97951b382e2d14adec11c47a90ddfad1987a5c19d9cfef0619d30f637f\"],[\"blocked-by\",\"7de9620d9706743839185d429a0bdd1b25cd768c2d97d5f60025a697fda7475d\"],[\"alt\",\"Revision of an issue: coax-nostr: a native CLI for keygen, seal, gate, publish and verify\"]],\"content\":\"tools/coax-nostr/: a native program built from the same modules: keygen, seal deck.md --author --to, gate (writes unlock entries for deploy.sh), publish (sign and send events to a relay with AUTH, using a small native socket), verify, fetch.\\n\\n## Acceptance\\n\\n- deploy.sh runs the gate step with coax-nostr and no bun\\n- Re-sealing the deck with coax-nostr opens on staging\\n\\n## Files\\n\\n- `tools/coax-nostr/`\\n- `coax/web/deploy.sh`\\n\",\"sig\":\"c87c31a46a23b94181272d27bf7cd78922356ce89424c07fedca820900aba3a3a21ceddba9ca234805aec5d456d1e2241540124a4ff5318872d7fdd96c21e061\"}]\n[\"EVENT\",\"comments\",{\"id\":\"5305745c72bde9fffdc371e76f0bef27cf1f2f973e8a87e557c15a7e44af9c74\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215610,\"kind\":1111,\"tags\":[[\"E\",\"51e676b7869c773966ca2761abb58dd2548847d72869e035fae8a55075b6a630\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"51e676b7869c773966ca2761abb58dd2548847d72869e035fae8a55075b6a630\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"The phrase gate in Coax, without AES\"],[\"t\",\"web\"],[\"t\",\"crypto\"],[\"size\",\"M\"],[\"parent\",\"6c0d25259ca6ef6ff8b2ff046edc5a0b95713d6a9dfabfabe916a0ab8aca35ea\"],[\"blocked-by\",\"4747fbcbf213e5c9af2f8f7d793a9b19f3b0d9ef23259ea776670da780296456\"],[\"blocked-by\",\"5fc9d914022e871930f5eaacbb29f1615373f22063c0dc14c89c0f0e09f2cde8\"],[\"blocked-by\",\"f20e2fcf01473864c4e6a74bda37893d2c7b3705e68e00b759902cb0395b28f9\"],[\"alt\",\"Revision of an issue: The phrase gate in Coax, without AES\"]],\"content\":\"Replace gate.ts: salted SHA-256 check, PBKDF2 (210,000 rounds) to a ChaCha20 key and an HMAC key, encrypt-then-MAC pointer (coax/nostr.md §10.3), all in Coax; the terminal raises the check.\\n\\n## Acceptance\\n\\n- A refused phrase and the real phrase behave as today on staging with gate.ts removed\\n- No WebCrypto call remains in the page (grep check in check-visuals.sh)\\n\\n## Files\\n\\n- `apps/openagents-web/`\\n- `coax/web/unlock/gate.ts`\\n\",\"sig\":\"8c3bfc6ac01f72204d8f353c6825cbc95db7e570e67425285de0b6e27ee69722999493f1b5f9b8ed667f584a527504c7e904ee762c1bddce5bca35b9a5dba372\"}]\n[\"EVENT\",\"comments\",{\"id\":\"b56181935b829c0945c7e81f78b109102f3ccce9fb257c0c835e0c4ba3bd84a4\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215609,\"kind\":1111,\"tags\":[[\"E\",\"4a73354378a9e7058ca56491bb7de0bed6ea1d80d8be1f82c92b94e10d882bb3\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"4a73354378a9e7058ca56491bb7de0bed6ea1d80d8be1f82c92b94e10d882bb3\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"Open the hidden deck in Coax\"],[\"t\",\"web\"],[\"t\",\"nostr\"],[\"size\",\"M\"],[\"parent\",\"6c0d25259ca6ef6ff8b2ff046edc5a0b95713d6a9dfabfabe916a0ab8aca35ea\"],[\"blocked-by\",\"4cca7f4d3f587b3796ead071adb8ce12e2673e186e7dcc8e25e2037f573289ea\"],[\"blocked-by\",\"ef5aa35ce36cfdd1bf6ed0c89e20ebaa292e896adedf1fb553e03c4f6204a432\"],[\"blocked-by\",\"fdce7d97951b382e2d14adec11c47a90ddfad1987a5c19d9cfef0619d30f637f\"],[\"alt\",\"Revision of an issue: Open the hidden deck in Coax\"]],\"content\":\"Replace coax/web/unlock/page.ts: fetch the wrap through relay.coax with AUTH as the recipient, unwrap with nip59.coax, check the envelope, hand slides to ui.coax.\\n\\n## Acceptance\\n\\n- The real phrase opens the deck on staging with page.ts removed\\n- Wrong key shows the key-wrong state\\n\\n## Files\\n\\n- `apps/openagents-web/`\\n- `coax/web/unlock/`\\n\",\"sig\":\"34671ea73d3af087f511658fbb1cadf782c79d9d870c74804c9d39fee7fce90c69af9b54c3b5195257ed9de9d5911109b05262d0469b9151dcdf87dabd6d5a82\"}]\n[\"EVENT\",\"comments\",{\"id\":\"5b0878314e9f02435a64a29825b347e2308295aa38839bb9f9116359398ad948\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215608,\"kind\":1111,\"tags\":[[\"E\",\"4cca7f4d3f587b3796ead071adb8ce12e2673e186e7dcc8e25e2037f573289ea\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"4cca7f4d3f587b3796ead071adb8ce12e2673e186e7dcc8e25e2037f573289ea\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"The page subscribes to relay.openagents.com with AUTH\"],[\"t\",\"web\"],[\"t\",\"nostr\"],[\"size\",\"M\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"blocked-by\",\"7de9620d9706743839185d429a0bdd1b25cd768c2d97d5f60025a697fda7475d\"],[\"blocked-by\",\"47b1de82fd67af95ad4ce28f2164dc8812c48fd30ae27cec4b49f99aa824c2e0\"],[\"blocked-by\",\"d0d77f68357bf14ddf77a52687a8305cbeff29d616c315d021290f7bede0bac2\"],[\"blocked-by\",\"fd709fde9a20e47041f0fa1f491257a7c4bf832c527d10ac97a5149f7b2bfe13\"],[\"alt\",\"Revision of an issue: The page subscribes to relay.openagents.com with AUTH\"]],\"content\":\"Wire host pipes and relay.coax into a probe page: connect, answer AUTH with a test key, subscribe to a known filter, draw verified event count and refusals.\\n\\n## Acceptance\\n\\n- Probe on staging shows the expected count from relay.openagents.com\\n- A REQ is never sent before AUTH completes (asserted from the outbox log)\\n\\n## Files\\n\\n- `apps/openagents-web/`\\n\",\"sig\":\"db6e4659de2bf96b3ce349de07e4e2c6ebfed46057ff60a06618678c962b4a4f0627f159350b7a8a5c32cf0bba7b6e9a9f8728dac68966d791a6073d28131eed\"}]\n[\"EVENT\",\"comments\",{\"id\":\"6a31ddc25648b5e17041db3c01f11c926686813c0248404e62136a94e8a9bb55\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215607,\"kind\":1111,\"tags\":[[\"E\",\"fd709fde9a20e47041f0fa1f491257a7c4bf832c527d10ac97a5149f7b2bfe13\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"fd709fde9a20e47041f0fa1f491257a7c4bf832c527d10ac97a5149f7b2bfe13\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"Key slots, storage records and the NIP-07 adapter\"],[\"t\",\"nostr\"],[\"t\",\"web\"],[\"size\",\"M\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"blocked-by\",\"44fe38068474bb38e4943023b7752418e8ab8eab89edea791e9702883ce9aa1b\"],[\"blocked-by\",\"8ccd826b7e26625fa02fdef67065f80e033e23d28fa419e7e8c9680c57cd2e5c\"],[\"blocked-by\",\"51f416c58a9c0b1b034d374a7fec805de9d9864211814cd792831113ab0f53a8\"],[\"alt\",\"Revision of an issue: Key slots, storage records and the NIP-07 adapter\"]],\"content\":\"coax/lib/nostr/keys.coax: SecretSlot with forget(), import from nsec or hex, the stored record format, and the signer interface the page calls (local slot or NIP-07 through host imports: pubkey, sign, nip44 decrypt).\\n\\n## Acceptance\\n\\n- A pasted key survives reload via storage; forget() zeroes the slot and deletes the record\\n- With a NIP-07 extension present, signing goes through it (manual check recorded)\\n\\n## Files\\n\\n- `coax/lib/nostr/keys.coax`\\n- `coax/web/host.js`\\n\",\"sig\":\"9ee21dcd870d1a765ffc5893fe5a7b32402725073b18be46ffc094271c7539862a183185b9ce9a8b6e01be9d3471140f64e3f63f6bc2518449110734fb73c24c\"}]\n[\"EVENT\",\"comments\",{\"id\":\"64bc1f204e9a4cc09685c1acfecf84ee24d6f81f9eacb31f3827f53cef1a9a6d\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215606,\"kind\":1111,\"tags\":[[\"E\",\"7de9620d9706743839185d429a0bdd1b25cd768c2d97d5f60025a697fda7475d\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"7de9620d9706743839185d429a0bdd1b25cd768c2d97d5f60025a697fda7475d\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"The relay client state machine\"],[\"t\",\"nostr\"],[\"size\",\"L\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"blocked-by\",\"7cdf2fe4a30442eba7a02e6eeafe44f90b64e24eb7fd9e231280d1f11b34e753\"],[\"blocked-by\",\"941365238306bf0600e998a145f98b31010de2ce773b52cfee524c115b88b9e2\"],[\"blocked-by\",\"f4268f9b58bbf38358880298462c5958b0cbb59dfefca02ecb6c5303e40d3fc2\"],[\"alt\",\"Revision of an issue: The relay client state machine\"]],\"content\":\"coax/lib/nostr/relay.coax per coax/nostr.md §8: connection states, backoff, subscriptions, EOSE, CLOSED reasons, OK handling, duplicate suppression, verification before delivery, AUTH-before-REQ queueing.\\n\\n## Acceptance\\n\\n- #test drives it with scripted relay transcripts: auth-required, CLOSED auth-required then success, duplicate events, bad signatures dropped and counted, backoff timing\\n- No I/O inside the module (it compiles without the host)\\n\\n## Files\\n\\n- `coax/lib/nostr/relay.coax`\\n\",\"sig\":\"fc47fc6f63f25f368dcc73bf65f2f292aca6a60f016591e6eead9c7f19a0f64629224388617818191a453216501bdd1b0c3572da3d59ab9fe0c1660d0b95b4e7\"}]\n[\"EVENT\",\"comments\",{\"id\":\"4c09269db14493502a61cfb92eaecea84a8d6fece7e6d4f851504de7688cb657\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215605,\"kind\":1111,\"tags\":[[\"E\",\"f4268f9b58bbf38358880298462c5958b0cbb59dfefca02ecb6c5303e40d3fc2\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"f4268f9b58bbf38358880298462c5958b0cbb59dfefca02ecb6c5303e40d3fc2\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"NIP-42 AUTH events\"],[\"t\",\"nostr\"],[\"size\",\"S\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"blocked-by\",\"7cdf2fe4a30442eba7a02e6eeafe44f90b64e24eb7fd9e231280d1f11b34e753\"],[\"blocked-by\",\"51f416c58a9c0b1b034d374a7fec805de9d9864211814cd792831113ab0f53a8\"],[\"alt\",\"Revision of an issue: NIP-42 AUTH events\"]],\"content\":\"coax/lib/nostr/nip42.coax: build the kind 22242 event for (challenge, relay URL) and sign it locally or hand it to the NIP-07 signer.\\n\\n## Acceptance\\n\\n- Events verify in nostr-effect and match its Nip42 builder's tags\\n\\n## Files\\n\\n- `coax/lib/nostr/nip42.coax`\\n\",\"sig\":\"8b0e86affcd1e28284b19cc3c5ce5702eb2cb55739fbcdcad562fe11a83e18ad3d186fc353bd3f9ba6845cfb1e23f59682477413bc370e92b570aebda09ab980\"}]\n[\"EVENT\",\"comments\",{\"id\":\"de8739ee61619049486b6ec5691da5a373d32c36bb60a5cc23ff594d63da83dd\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215604,\"kind\":1111,\"tags\":[[\"E\",\"44fe38068474bb38e4943023b7752418e8ab8eab89edea791e9702883ce9aa1b\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"K\",\"1621\"],[\"P\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"e\",\"44fe38068474bb38e4943023b7752418e8ab8eab89edea791e9702883ce9aa1b\",\"wss://relay.openagents.com\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"k\",\"1621\"],[\"p\",\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\"],[\"revision\",\"openagents.issue-revision.v1\"],[\"subject\",\"Host import: IndexedDB bytes\"],[\"t\",\"web\"],[\"t\",\"host\"],[\"size\",\"S\"],[\"parent\",\"4d8f39528a7967fc4cd9697e8d3bef293df9111b75f09bb4318587e0c83bbe71\"],[\"alt\",\"Revision of an issue: Host import: IndexedDB bytes\"]],\"content\":\"store_put/get/delete over one IndexedDB object store per origin; results via the inbox; private browsing failure reported, not thrown.\\n\\n## Acceptance\\n\\n- Put, reload, get returns the same bytes in a probe page\\n- Works when IndexedDB is unavailable (reports unavailable)\\n\\n## Files\\n\\n- `coax/web/host.js`\\n\",\"sig\":\"3113f48a57601bf0d2d1bea913f72931aabcb4607e458d4da92f1482e343caea9423f0d95df6f830cff47d10962566c6b26a5f8e912ba50a8b85e8822a1f4898\"}]\n[\"EVENT\",\"comments\",{\"id\":\"7ac9e0c15427a580a16dfbfc72d6273e78544f76193d0bd6b285ae76b017bce1\",\"pubkey\":\"9ef92e341b43ebc5617a75cf7eca7e2e30fae41e08a0614a344d851d98731575\",\"created_at\":1793215603,\"kind\":1111,\"tags\":[[\"E\",\"47b1de82fd