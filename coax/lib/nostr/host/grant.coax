// HOST access: bind a projected grant (openagents.host.v1.Access.grant) to
// the original host-signed, device-encrypted envelope ri was read from
// (Access.authorization, the exact event JSON). NIP-HOST "Grants, epochs, and
// revocation"; envelope: nips/openagents/contracts.md "Private artifact
// envelope".
//
// A plaintext or projection supplied beside an envelope is not evidence that
// the envelope produced ri, so this does the whole path itself: the original
// event's id and BIP-340 signature; kind 3188 for exactly this device (one p,
// one h mailbox, t oa:artifact:v1); NIP-44 v2 decryption with the device key
// and the signer's key; the artifact envelope (schema
// openagents.host-grant.v1, inline JCS bytes matching digest and size); the
// grant body (closed fields, canonical rights, three distinct keys, the
// signer as host, this device, the mailbox as grant id, a lifetime of at most
// 30 days); then every projected field against the decrypted one, rights in
// order. A scoped grant (requires openagents.workspace-scope.v1, or a scope
// field) is refused as unsupported here.
//
// HG_OK means only that the projection is exactly what this host signed for
// this device. It is not identity, freshness, revocation, rights or any
// authority: the host's current record decides those. Nothing decoded (an
// owner string, a flag) is ever trusted for more.
//
// work holds the decrypted envelope and is zeroed on every admitted return;
// the conversation key is a zeroed local. Plain stores, as in nip44-key.coax.
#load "../adapters/host-proto-import.coax";
#load "../nip44-key.coax";
#load "../event.coax";
#load "../../crypto/schnorr_fast.coax";
#load "../envelope.coax";
#load "../../../tests/nostr/host_grant_keys.coax";
#authority;

HG_OK :: cast(u32)0;
HG_INPUT :: cast(u32)1;       // a key or work view is not admitted
HG_WIRE :: cast(u32)2;        // the Access does not decode, or lacks its grant or original
HG_EVENT :: cast(u32)3;       // the original is not a NIP-01 event with its own id
HG_SIGNATURE :: cast(u32)4;
HG_ARTIFACT :: cast(u32)5;    // not a 3188 private artifact for exactly this device
HG_KEY :: cast(u32)6;         // the device secret is refused
HG_DECRYPT :: cast(u32)7;     // the content does not decrypt for this device
HG_ENVELOPE :: cast(u32)8;    // not an artifact envelope of a host grant, or its digest/size differ
HG_SCOPED :: cast(u32)9;      // a workspace-scoped grant: not supported by this adapter
HG_GRANT :: cast(u32)10;      // the grant body is malformed or breaks a NIP-HOST rule
HG_ISSUER :: cast(u32)11;     // host is not the signer, device not this device, or id not the mailbox
HG_PROJECTION :: cast(u32)12; // a projected field differs from the signed grant

HG_SCHEMA :: "openagents.host-grant.v1";
HG_SCOPE_FEATURE :: "openagents.workspace-scope.v1";
HG_MAX_LIFETIME :: 2592000;
HG_REGION :: 131072;
HG_WORK :: 5*HG_REGION;
HG_MAX_SAFE :: 9007199254740991;

HostGrant :: struct {
  error:u32=HG_INPUT; original:string;   // the exact authorization JSON, borrowed from the Access wire
  epoch:int; issued_at:int; expires_at:int; rights:int;
}

#test "status values are the host ABI" {
  #assert HG_OK==0 && HG_WIRE==2 && HG_SCOPED==9 && HG_PROJECTION==12 && HG_WORK==655360;
}
#forall "rights are nonempty, known, duplicate-free and in NIP-HOST order" a:0..<8,b:0..<8 {
  names:=[8]string.["observe","operate","terminal","review","access_read","access_admin","world","other"];
  #assert hg_right(names[a])==(ifx a<7 then a else -1);
  // A two-right list is canonical exactly when both are known and strictly ascending.
  last:=-1;ok:=true;
  for r:[2]int.[a,b] {k:=hg_right(names[r]);if k<0 || k<=last {ok=false;}last=k;}
  #assert ok==(a<7 && b<7 && a<b);
}
#test "keys and ids are lowercase 64-hex" {
  #assert hg_hex64("79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798");
  #assert !hg_hex64("79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798");
  #assert !hg_hex64("79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f8179");
  #assert !hg_hex64("79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798a");
  #assert !hg_hex64("79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f8179g");
  #assert !hg_hex64("79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f8179:") && hg_hex64("9999999999999999999999999999999999999999999999999999999999999999");
}
#test "grant numbers are nonnegative safe decimal integers without leading zeros" {
  #assert hg_number("0")==0 && hg_number("9")==9 && hg_number("1790086400")==1790086400 && hg_number("9007199254740991")==9007199254740991;
  #assert hg_number("")==-1 && hg_number("-1")==-1 && hg_number("01")==-1 && hg_number("1:")==-1 && hg_number("1.5")==-1;
  #assert hg_number("12345678901234567")==-1 && hg_number("1234567890123456")==1234567890123456;
  t:[8]u8;#assert hg_text("ab",t[..])=="ab";
}
#test "the artifact tags name exactly one recipient and one mailbox" {
  dev:=HG_DEVICE_HEX;mail:[64]u8;
  #assert hg_tags("[[\"p\",\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\"],[\"h\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"t\",\"oa:artifact:v1\"]]",dev,mail[..]);
  #assert cast(string)mail[..]=="1111111111111111111111111111111111111111111111111111111111111111";
  #assert !hg_tags("[[\"h\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"t\",\"oa:artifact:v1\"]]",dev,mail[..]);
  #assert !hg_tags("[[\"p\",\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\"],[\"p\",\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\"],[\"h\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"t\",\"oa:artifact:v1\"]]",dev,mail[..]);
  #assert !hg_tags("[[\"p\",\"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798\"],[\"h\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"t\",\"oa:artifact:v1\"]]",dev,mail[..]);
  #assert !hg_tags("[[\"p\",\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\"],[\"t\",\"oa:artifact:v1\"]]",dev,mail[..]);
  #assert !hg_tags("[[\"p\",\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\"],[\"h\",\"11\"],[\"t\",\"oa:artifact:v1\"]]",dev,mail[..]);
  #assert !hg_tags("[[\"p\",\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\"],[\"h\",\"1111111111111111111111111111111111111111111111111111111111111111\"]]",dev,mail[..]);
  #assert !hg_tags("[[\"p\",\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\"],[\"h\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"t\",\"oa:other\"]]",dev,mail[..]);
}
#test "the signed grant body and its projection are compared field by field" {
  // NIP-HOST's fixture grant, signed by host G for device 3, mailbox 11..11.
  w:[4096]u8;g:=hgk_grant(-1,w[..]);
  host:=HG_HOST_HEX;dev:=HG_DEVICE_HEX;mail:=HG_MAILBOX_HEX;
  r:=hg_body(HG_FIXTURE_GRANT,g,host,dev,mail);
  #assert r.error==HG_OK && r.epoch==0 && r.issued_at==1790000000 && r.expires_at==1790086400 && r.rights==4;
  for i:0..<HG_BAD_GRANTS.count {#assert hg_body(HG_BAD_GRANTS[i],g,host,dev,mail).error==HG_BAD_GRANT_CODES[i];}
  for change:0..<HG_PROJECTION_COUNT {
    v:[4096]u8;p:=hgk_grant(change,v[..]);
    #assert p.error==0 && hg_body(HG_FIXTURE_GRANT,p,host,dev,mail).error==HG_PROJECTION;
  }
  bad:H_Grant;bad.error=1;#assert hg_body(HG_FIXTURE_GRANT,bad,host,dev,mail).error==HG_PROJECTION;
  #assert hg_body(HG_FIXTURE_GRANT,g,dev,dev,mail).error==HG_ISSUER;
  #assert hg_body(HG_FIXTURE_GRANT,g,host,host,mail).error==HG_ISSUER;
  #assert hg_body(HG_FIXTURE_GRANT,g,host,dev,"2222222222222222222222222222222222222222222222222222222222222222").error==HG_ISSUER;
}
#test "access views and wires are admitted before any work" {
  dev:=HG_DEVICE_SECRET;x:=HG_DEVICE_X;work:[HG_WORK]u8;work[0]=7;empty:=HG_EMPTY_WIRE;
  #assert host_access_bind_checked(empty[0..<0],dev[0..<31],x[..],work[..],false).error==HG_INPUT;
  #assert host_access_bind_checked(empty[0..<0],dev[..],x[0..<31],work[..],false).error==HG_INPUT;
  #assert host_access_bind_checked(empty[0..<0],dev[..],x[..],work[0..<HG_WORK-1],false).error==HG_INPUT;
  #assert host_access_bind_checked(empty[0..<0],dev[..],x[..],work[..],true).error==HG_INPUT;
  #assert work[0]==7;
  // An Access with no grant and no original, and bytes that are no Access.
  #assert host_access_bind_checked(empty[0..<0],dev[..],x[..],work[..],false).error==HG_WIRE && work[0]==0;
  junk:=[3]u8.[0xff,0xff,0xff];#assert host_access_bind_checked(junk[..],dev[..],x[..],work[..],false).error==HG_WIRE;
}

#test "an independently sealed grant opens to its projection and keeps the exact original" {
  work:[HG_WORK]u8;work[9]=1;r:=hgk_open(HG_ORIGINAL_OK,-1,false,false,work[..]);
  #assert r.error==HG_OK && r.original==HG_ORIGINAL_OK && r.rights==4 && r.expires_at==1790086400 && hgk_zero(work[..]);
}
#test "opening refuses a changed projection" {work:[HG_WORK]u8;#assert hgk_open(HG_ORIGINAL_OK,4,false,false,work[..]).error==HG_PROJECTION;}
#test "opening refuses a substituted plaintext" {work:[HG_WORK]u8;#assert hgk_open(HG_ORIGINAL_OTHER_ENVELOPE,-1,false,false,work[..]).error==HG_PROJECTION;}
#test "opening refuses another device's artifact" {work:[HG_WORK]u8;#assert hgk_open(HG_ORIGINAL_FOR_OTHER,-1,false,false,work[..]).error==HG_ARTIFACT;}
#test "opening refuses an envelope encrypted to another key" {work:[HG_WORK]u8;work[3]=1;#assert hgk_open(HG_ORIGINAL_WRONG_KEY_P,-1,false,false,work[..]).error==HG_DECRYPT && hgk_zero(work[..]);}
#test "opening refuses a grant signed by someone other than its host" {work:[HG_WORK]u8;#assert hgk_open(HG_ORIGINAL_NOT_HOST,-1,true,false,work[..]).error==HG_ISSUER;}
#test "opening refuses a mailbox that is not the grant id" {work:[HG_WORK]u8;#assert hgk_open(HG_ORIGINAL_MAILBOX,-1,false,false,work[..]).error==HG_ISSUER;}
#test "opening refuses a scoped grant as unsupported" {work:[HG_WORK]u8;#assert hgk_open(HG_ORIGINAL_SCOPED,-1,false,false,work[..]).error==HG_SCOPED;}
#test "opening refuses a wrong digest" {work:[HG_WORK]u8;#assert hgk_open(HG_ORIGINAL_DIGEST,-1,false,false,work[..]).error==HG_ENVELOPE;}
#test "opening refuses another schema" {work:[HG_WORK]u8;#assert hgk_open(HG_ORIGINAL_SCHEMA,-1,false,false,work[..]).error==HG_ENVELOPE;}
#test "opening refuses another kind" {work:[HG_WORK]u8;#assert hgk_open(HG_ORIGINAL_KIND1,-1,false,false,work[..]).error==HG_ARTIFACT;}
#test "the bind refuses an absent original, a non-event and an out-of-range signature" {
  dev:=HG_DEVICE_SECRET;x:=HG_DEVICE_X;work:[HG_WORK]u8;
  n:=HG_ACCESS_NO_GRANT;#assert host_access_bind_checked(n[..],dev[..],x[..],work[..],false).error==HG_WIRE;
  a:=HG_ACCESS_NO_AUTH;#assert host_access_bind_checked(a[..],dev[..],x[..],work[..],false).error==HG_WIRE;
  b:=HG_ACCESS_EMPTY_JSON;#assert host_access_bind_checked(b[..],dev[..],x[..],work[..],false).error==HG_WIRE;
}
#test "the bind refuses a non-event and an out-of-range signature" {
  dev:=HG_DEVICE_SECRET;x:=HG_DEVICE_X;work:[HG_WORK]u8;
  c:=HG_ACCESS_BAD_EVENT;#assert host_access_bind_checked(c[..],dev[..],x[..],work[..],false).error==HG_EVENT;
  d:=HG_ACCESS_BAD_S;#assert host_access_bind_checked(d[..],dev[..],x[..],work[..],false).error==HG_SIGNATURE;
}
#test "tags fail closed on shapes the reader would not produce" {
  dev:=HG_DEVICE_HEX;mail:[64]u8;
  #assert !hg_tags("{}",dev,mail[..]) && !hg_tags("[[\"p\",1]]",dev,mail[..]) && !hg_tags("[\"p\"]",dev,mail[..]);
  long:[310]u8;head:="[[\"p\",\"";for i:0..<head.count {long[i]=head[i];}
  for i:head.count..<306 {long[i]='a';}long[306]='"';long[307]=']';long[308]=']';
  #assert !hg_tags(cast(string)long[0..<309],dev,mail[..]);
  // A longer name that starts with p is not a p tag.
  #assert hg_tags("[[\"\"],[\"x\",\"p\"],[\"px\",\"0\"],[\"p\",\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\"],[\"h\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"t\",\"oa:artifact:v1\"]]",dev,mail[..]);
}
#test "relays, the largest safe number, and a nonzero epoch" {
  r:[257]u8;for i:0..<257 {r[i]='r';}
  #assert !hg_relay_ok("") && hg_relay_ok("w") && hg_relay_ok(cast(string)r[0..<256]) && !hg_relay_ok(cast(string)r[..]);
  #assert hg_number("9007199254740992")==-1;
  w:[4096]u8;g:=hgk_grant(8,w[..]);
  e:=hg_body(HG_GRANT_EPOCH1,g,HG_HOST_HEX,HG_DEVICE_HEX,HG_MAILBOX_HEX);#assert e.error==HG_OK && e.epoch==1;
}
hg_zero :: (b:[]u8) {for i:0..<b.count {b[i]=0;}}
hg_right :: (name:string)->int {
  names:=[7]string.["observe","operate","terminal","review","access_read","access_admin","world"];
  for i:0..<7 {if name==names[i] {return i;}}
  return -1;
}
hg_hex64 :: (s:string)->bool {
  if s.count!=64 {return false;}
  for c:s {if !((c>='0' && c<='9') || (c>='a' && c<='f')) {return false;}}
  return true;
}
// Exactly one ["p", device], one ["h", <64-hex>] (copied to mailbox) and a ["t","oa:artifact:v1"].
hg_tags :: (tags:string,device_hex:string,mailbox:[]u8)->bool {
  // A tag string longer than 256 decoded bytes fails closed.
  decoded:[256]u8;j:[1]Json;json_start(j[..],tags);
  if json_next(j[..])!=JSON_ARRAY {return false;}
  ps:=0;hs:=0;topic:=false;
  t:=json_next(j[..]);
  while t==JSON_ARRAY {
    k:=0;name:u8;v:=json_next(j[..]);
    while v==JSON_STRING {
      n:=json_unescape(json_text(j[..]),decoded[..]);if n<0 {return false;}
      if k==0 && n==1 {name=decoded[0];}
      if k==1 {
        value:=cast(string)decoded[0..<n];
        if name=='p' {ps+=1;if value!=device_hex {return false;}}
        if name=='h' {hs+=1;if !hg_hex64(value) {return false;}for i:0..<64 {mailbox[i]=decoded[i];}}
        if name=='t' && value=="oa:artifact:v1" {topic=true;}
      }
      k+=1;v=json_next(j[..]);
    }
    if v!=JSON_ARRAY_END {return false;}
    t=json_next(j[..]);
  }
  return t==JSON_ARRAY_END && ps==1 && hs==1 && topic;
}
hg_text :: (raw:string,out:[]u8)->string {
  n:=json_unescape(raw,out);if n<0 {return "";}return cast(string)out[0..<n]; // mutant: equivalent (n<=0 and n<1 also give "" exactly when n is 0)
}
// A grant field against its projection. Every signed string is nonempty, so
// an absent projected field ("") never matches; proto3 writes no zero
// scalar, so an absent number reads as 0.
hg_same :: (signed:string,projected:H__pb_String)->bool {
  return projected.value==signed && projected.error==0;
}
hg_u64 :: (signed:int,projected:H__pb_U64)->bool {
  return projected.value==cast(u64)signed && projected.error==0;
}
hg_relay_ok :: (relay:string)->bool {return relay.count>0 && relay.count<=256;}
hg_number :: (raw:string)->int {
  // JCS has admitted a safe integer token; only nonnegative digits pass here.
  if raw.count==0 || raw.count>16 {return -1;} // mutant: equivalent (17 digits fit int and exceed HG_MAX_SAFE below)
  v:=0;for c:raw {if c<'0' || c>'9' {return -1;}v=v*10+cast(int)(c-'0');}
  if raw.count>1 && raw[0]=='0' {return -1;}
  if v>HG_MAX_SAFE {return -1;}
  return v;
}
HG_FIELDS :: [13]string.["v","requires","grant","host","owner","device","relay","rights","epoch","origin","issued_at","expires_at","scope"];
hg_field :: (name:string)->int {for i:0..<13 {if name==HG_FIELDS[i] {return i;}}return -1;}

// The grant body (inline JSON, already JCS-admitted: no duplicate keys)
// against the projection, the signer, this device and the mailbox.
hg_body :: (body:string,projected:H_Grant,signer_hex:string,device_hex:string,mailbox:string)->HostGrant {
  r:HostGrant;r.error=HG_GRANT;
  if projected.error!=0 {r.error=HG_PROJECTION;return r;}
  d:[1024]u8;j:[1]Json;json_start(j[..],body);
  if json_next(j[..])!=JSON_OBJECT {return r;}
  seen:=0;host:[64]u8;owner:[64]u8;device:[64]u8;
  mismatch:=false;issuer:=false;
  while true {
    t:=json_next(j[..]);if t==JSON_OBJECT_END {break;}
    if t!=JSON_STRING {return r;}
    f:=hg_field(hg_text(json_text(j[..]),d[..]));
    if f<0 {return r;}
    if f==12 {r.error=HG_SCOPED;return r;}
    seen|=1<<f;t=json_next(j[..]);raw:=json_text(j[..]);
    if f==1 {
      if t!=JSON_ARRAY {return r;}
      v:=json_next(j[..]);
      if v==JSON_STRING {if hg_text(json_text(j[..]),d[..])==HG_SCOPE_FEATURE {r.error=HG_SCOPED;}return r;}
      if v!=JSON_ARRAY_END {return r;}
    } else if f==7 {
      if t!=JSON_ARRAY {return r;}
      ri:=H_Grant_iter_rights(projected);last:=-1;
      v:=json_next(j[..]);
      while v==JSON_STRING {
        name:=hg_text(json_text(j[..]),d[..]);k:=hg_right(name);
        if k<0 || k<=last {return r;}
        last=k;r.rights+=1;
        if !ri.has_value || ri.value!=name {mismatch=true;}
        else {ri=H_Grant_next_rights(ri);}
        v=json_next(j[..]);
      }
      if v!=JSON_ARRAY_END || r.rights==0 {return r;}
      if ri.has_value {mismatch=true;}
    } else if f==9 {
      if t!=JSON_OBJECT {return r;}
      o:=H_Grant_get_origin(projected); // absent: its fields read "" and never match
      inner:=0;
      while true {
        u:=json_next(j[..]);if u==JSON_OBJECT_END {break;}
        key:=hg_text(json_text(j[..]),d[..]);which:=ifx key=="kind" then 1 else ifx key=="id" then 2 else ifx key=="issuer" then 4 else 0;
        if which==0 || json_next(j[..])!=JSON_STRING {return r;}
        inner|=which;value:=hg_text(json_text(j[..]),d[..]);
        if which==1 && value!="invitation" && value!="approval" {return r;}
        if which!=1 && !hg_hex64(value) {return r;}
        projected_value:=ifx which==1 then H_GrantOrigin_get_kind(o.value) else ifx which==2 then H_GrantOrigin_get_id(o.value) else H_GrantOrigin_get_issuer(o.value);
        if !hg_same(value,projected_value) {mismatch=true;}
      }
      if inner!=7 {return r;}
    } else if f==8 || f==10 || f==11 {
      if t!=JSON_NUMBER {return r;}
      n:=hg_number(raw);if n<0 {return r;}
      if f==8 {r.epoch=n;if !hg_u64(n,H_Grant_get_epoch(projected)) {mismatch=true;}}
      if f==10 {r.issued_at=n;if !hg_u64(n,H_Grant_get_issued_at(projected)) {mismatch=true;}}
      if f==11 {r.expires_at=n;if !hg_u64(n,H_Grant_get_expires_at(projected)) {mismatch=true;}}
    } else {
      if t!=JSON_STRING {return r;}
      value:=hg_text(raw,d[..]);
      if f==0 {if value!=HG_SCHEMA {return r;}}
      else if f==6 {
        if !hg_relay_ok(value) {return r;}
        if !hg_same(value,H_Grant_get_relay(projected)) {mismatch=true;}
      } else {
        if !hg_hex64(value) {return r;}
        if f==2 {if value!=mailbox {issuer=true;}if !hg_same(value,H_Grant_get_id(projected)) {mismatch=true;}}
        if f==3 {for i:0..<64 {host[i]=value[i];}if value!=signer_hex {issuer=true;}if !hg_same(value,H_Grant_get_host(projected)) {mismatch=true;}}
        if f==4 {for i:0..<64 {owner[i]=value[i];}if !hg_same(value,H_Grant_get_owner(projected)) {mismatch=true;}}
        if f==5 {for i:0..<64 {device[i]=value[i];}if value!=device_hex {issuer=true;}if !hg_same(value,H_Grant_get_device(projected)) {mismatch=true;}}
      }
    }
  }
  if seen!=4095 {return r;}
  if cast(string)host[..]==cast(string)owner[..] || cast(string)owner[..]==cast(string)device[..] || cast(string)host[..]==cast(string)device[..] {return r;}
  if r.expires_at<=r.issued_at || r.expires_at-r.issued_at>HG_MAX_LIFETIME {return r;}
  if issuer {r.error=HG_ISSUER;return r;}
  if mismatch {r.error=HG_PROJECTION;return r;}
  r.error=HG_OK;return r;
}
hg_done :: (r:HostGrant,error:u32,work:[]u8)->HostGrant {
  hg_zero(work[0..<HG_WORK]);
  if error!=HG_OK {fail:HostGrant;fail.error=error;return fail;}
  return r;
}

// Binds Access.grant to Access.authorization for the device whose secret
// and x-only public key are given. On HG_OK, original is the exact signed
// envelope (borrowed from access_wire) to retain beside the projection.
// overlap is the host's truthful fact that any two views share memory.
host_access_bind_checked :: (access_wire:[]u8,device_secret:[]u8,device_x:[]u8,work:[]u8,overlap:bool)->HostGrant #export_c {
  r:HostGrant;
  if device_secret.count!=32 || device_x.count!=32 || work.count<HG_WORK || overlap {return r;}
  access:=H_Access_decode(access_wire);
  if access.error!=0 {return hg_done(r,HG_WIRE,work);}
  g:=H_Access_get_grant(access);
  if !g.present || g.error!=0 {return hg_done(r,HG_WIRE,work);}
  // An absent authorization reads as an empty SignedEvent: its json is absent too.
  original:=H_SignedEvent_get_json(H_Access_get_authorization(access).value);
  if original.error!=0 || !original.present {return hg_done(r,HG_WIRE,work);}
  text:=original.value;
  // The regions are each at least twice what their user needs.
  pre:=work[0..<HG_REGION]; // mutant: equivalent (a 1-byte shift of a region bound is never reached)
  e:=nostr_event_read(text,pre,false);
  if e.error!=NE_OK {return hg_done(r,HG_EVENT,work);}
  if !nostr_fast_verify_vartime(e.id[..],e.public_key[..],e.signature[..]) {return hg_done(r,HG_SIGNATURE,work);}
  ck:[32]u8;ew:[1]EcdhScratch;peer:=e.public_key;
  c:=nip44_conversation_key_from_keys_checked(device_secret,peer[..],ew[..],ck[..],false);
  if c!=NIP44_OK {return hg_done(r,ifx c==NIP44_SECRET then HG_KEY else HG_DECRYPT,work);}
  result:=hg_open(text,e,g.value,ck[..],device_x,work);
  hg_zero(ck[..]); // mutant: equivalent (wipes a local no output reads)
  return result;
}
// After the signature and the ECDH conversation key (device secret, signer):
// recipient, decryption, envelope and grant. Split out so checks reach it
// within a check budget (ECDH alone is about one); host_access_bind_checked
// is the only caller outside checks.
hg_open :: (text:string,e:NostrEvent,g:H_Grant,ck:[]u8,device_x:[]u8,work:[]u8)->HostGrant {
  r:HostGrant;
  // 32 bytes always fit 64 without overlap: hex encoding cannot refuse here.
  dev:[64]u8;signer:[64]u8;mail:[64]u8;
  peer:=e.public_key;
  hd:=hex_encode_checked(cast(string)device_x,dev[..],false);hs:=hex_encode_checked(cast(string)peer[..],signer[..],false);
  if e.kind!=3188 || !hg_tags(text[e.tags_from..<e.tags_to],cast(string)dev[..],mail[..]) {return hg_done(r,HG_ARTIFACT,work);}
  // The reader admitted content as JSON of at most 65536 bytes: it unescapes into the 131072-byte scratch.
  scratch:=work[4*HG_REGION..<5*HG_REGION]; // mutant: equivalent (see the region note above)
  n:=json_unescape(text[e.content_from..<e.content_to],scratch);
  body:=work[HG_REGION..<2*HG_REGION];nwork:=work[2*HG_REGION..<4*HG_REGION]; // mutant: equivalent (see the region note above)
  d:=nip44_decrypt_checked(NIP44_COMPAT,ck,cast(string)scratch[0..<n],nwork,body,false);
  if d.error!=NIP44_OK {return hg_done(r,HG_DECRYPT,work);}
  envelope:=cast(string)body[0..<d.written];
  info:=envelope_check_body_checked(envelope,HG_SCHEMA,scratch,false);
  if info.error!=AE_OK {return hg_done(r,HG_ENVELOPE,work);}
  b:=hg_body(envelope[info.inline_from..<info.inline_to],g,cast(string)signer[..],cast(string)dev[..],cast(string)mail[..]);
  if b.error!=HG_OK {return hg_done(r,b.error,work);}
  b.original=text;return hg_done(b,HG_OK,work);
}
