#test "bounded starts raise the input and string limits" {
  long: [JSON_MAX_STRING + 3] u8;
  for i: 0..<long.count { long[i] = 'a'; }
  long[0] = '"'; long[JSON_MAX_STRING + 2] = '"';
  j: [1] Json;
  json_start(j[..], cast(string) long[..]); #assert json_next(j[..]) == JSON_ERROR;
  json_start_bounded(j[..], cast(string) long[..], JSON_MAX_INPUT, JSON_MAX_STRING + 1); #assert json_next(j[..]) == JSON_STRING;
  json_start_bounded(j[..], "[1]", 2, 8); #assert json_next(j[..]) == JSON_ERROR;
}

#test "integers within 2^53, and nothing else" {
  #assert json_int("9007199254740992").ok && json_int("-9007199254740992").value == -9007199254740992;
  #assert !json_int("9007199254740993").ok && !json_int("12345678901234567").ok;
  #assert json_int("0").ok && json_int("-0").value == 0 && !json_int("01").ok && !json_int("1.0").ok && !json_int("1e3").ok && !json_int("").ok && !json_int("-").ok;
  #assert json_int("1761686400").value == 1761686400;
}

#test "the writer escapes as NIP-01 does, appends, and refuses what doesn't fit" {
  out: [64] u8;
  ctl: [1] u8; ctl[0] = 1;
  n := json_raw(out[..], 0, "[");
  n = json_write_string(out[..], n, "a\"b\\c\nd\te\r\\u");
  #assert n > 0;
  n = json_raw(out[..], n, ",");
  n = json_write_string(out[..], n, cast(string) ctl[..]);
  n = json_raw(out[..], n, ",");
  n = json_write_int(out[..], n, -1761686400);
  n = json_raw(out[..], n, "]");
  #assert cast(string) out[0..<n] == "[\"a\\\"b\\\\c\\nd\\te\\r\\\\u\",\"\\u0001\",-1761686400]";
  #assert json_valid(cast(string) out[0..<n]);
  small: [4] u8;
  #assert json_write_string(small[..], 0, "abc") == -1 && json_write_int(small[..], json_raw(small[..], 0, "abcde"), 1) == -1;
  #assert json_write_string(small[..], 0, "ab") == 4 && json_write_int(small[..], 0, 1234) == 4 && json_write_int(small[..], 0, 12345) == -1;
}

#test "reused parser state is reset and refusal ranges remain observable" {
  j:[1]Json;j[0].text="old";j[0].at=8;j[0].depth=9;j[0].want=JW_DONE;j[0].tok=JSON_ERROR;j[0].from=8;j[0].to=9;j[0].key=true;j[0].error_at=7;
  json_start(j[..],"null");
  #assert j[0].text=="null" && j[0].at==0 && j[0].depth==0 && j[0].want==JW_VALUE;
  #assert j[0].tok==JSON_END && j[0].from==0 && j[0].to==0 && !j[0].key && j[0].error_at == -1;
  #assert json_next(j[..])==JSON_NULL && json_text(j[..])=="null";
  #assert json_next(j[..])==JSON_END;
  j[0].key=true;j[0].from=4;j[0].to=7;
  #assert json_refuse(j[..],2)==JSON_ERROR;
  #assert j[0].tok==JSON_ERROR && j[0].error_at==2 && j[0].from==2 && j[0].to==2 && !j[0].key;
  #assert json_next(j[..])==JSON_ERROR;
}
#test "original input budget is inclusive without parsing a megabyte" {
  input:[JSON_MAX_INPUT+1]u8;j:[1]Json;
  json_start(j[..],cast(string)input[0..<JSON_MAX_INPUT]);#assert j[0].tok==JSON_END && j[0].error_at == -1;
  json_start(j[..],cast(string)input[..]);#assert j[0].tok==JSON_ERROR && j[0].error_at==0;
}
#forall "hex and decimal classification on every byte" value:0..<256 {
  b:=cast(u8)value;
  if value>=48 && value<=57 {#assert json_hex(b)==value-48;}
  else if value>=65 && value<=70 {#assert json_hex(b)==value-55;}
  else if value>=97 && value<=102 {#assert json_hex(b)==value-87;}
  else {#assert json_hex(b) == -1;}
  #assert json_digit(b)==(value>=48 && value<=57);
}
#test "token ranges, whitespace, scalar skip and malformed containers" {
  j:[1]Json;json_start(j[..],"\t\r\n false");
  #assert json_next(j[..])==JSON_FALSE && j[0].from==4 && j[0].to==9 && json_skip(j[..]);
  json_start(j[..],"[true,null]");#assert json_next(j[..])==JSON_ARRAY;
  #assert json_next(j[..])==JSON_TRUE && j[0].from==1 && j[0].to==5 && json_skip(j[..]);
  #assert json_next(j[..])==JSON_NULL && json_skip(j[..]);
  #assert json_next(j[..])==JSON_ARRAY_END && j[0].from==10 && j[0].to==11;
  json_start(j[..],"{\"x\":{");#assert json_next(j[..])==JSON_OBJECT && !json_skip(j[..]);
  json_start(j[..],"[");#assert json_next(j[..])==JSON_ARRAY && !json_skip(j[..]);
  json_start(j[..],"{\"x\\u00g0\":1}");#assert json_next(j[..])==JSON_OBJECT && json_next(j[..])==JSON_ERROR;
  for raw:[8]string.["[}","{]","\"abc\\", "\"\\u0000", "-", "1.", "1e+", "1e-"] {#assert !json_valid(raw);}
  json_start(j[..],"nall");#assert json_next(j[..])==JSON_ERROR && j[0].error_at==1;
  json_start(j[..],"xrue");#assert json_word(j[..],"true",JSON_TRUE)==JSON_ERROR && j[0].error_at==0;
  json_start(j[..],"truX");#assert json_next(j[..])==JSON_ERROR && j[0].error_at==3;
  json_start(j[..],"tru");#assert json_next(j[..])==JSON_ERROR && j[0].error_at==0;
  json_start(j[..],"{\"x\":1}");#assert json_next(j[..])==JSON_OBJECT;#assert json_skip(j[..]) && j[0].from==6 && j[0].to==7;
}
