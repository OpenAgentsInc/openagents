  #assert json_write_string(out[0..<5],0,cast(string)input[..]) == -1;
  #assert json_write_string(out[0..<7],0,cast(string)input[..]) == -1;
  #assert json_write_int(out[..],0,0)==1 && out[0]=='0';
}

