  b[0]=240;  b[1]=128;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=240;  b[1]=143;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=240;  b[1]=144;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==4;
  b[0]=240;  b[1]=191;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==4;
  b[0]=240;  b[1]=192;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=244;  b[1]=127;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=244;  b[1]=128;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==4;
  b[0]=244;  b[1]=143;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==4;
  b[0]=244;  b[1]=144;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=244;  b[1]=191;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=244;  b[1]=192;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=245;  b[1]=127;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=245;  b[1]=128;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=245;  b[1]=143;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=245;  b[1]=144;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=245;  b[1]=191;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=245;  b[1]=192;  b[2]=128;  b[3]=128;#assert json_utf8(cast(string)b[0..<4],0)==0;
  b[0]=0;b[1]=194;b[2]=128;#assert json_utf8(cast(string)b[0..<3],1)==2;
}

#test "minimal numbers and parser failure metadata remain exact" {
  #assert json_valid("1e1") && json_valid("1e+1") && json_valid("1e-1") && !json_valid("1e");
  #assert json_int("-0").ok && json_int("-0").value==0;
  j:[1]Json;json_start(j[..],"\"bad");#assert json_value(j[..])==JSON_ERROR && j[0].want==JW_VALUE;
  json_start(j[..],"{\"bad");#assert json_next(j[..])==JSON_OBJECT;
  #assert json_next(j[..])==JSON_ERROR && !j[0].key && j[0].want==JW_KEY_OR_CLOSE;
  json_start(j[..],"{\"x\":null}");#assert json_next(j[..])==JSON_OBJECT;
  #assert json_next(j[..])==JSON_STRING && j[0].want==JW_COLON;
  #assert json_next(j[..])==JSON_NULL && j[0].want==JW_NEXT;
  json_start(j[..],"[}");#assert json_next(j[..])==JSON_ARRAY && json_next(j[..])==JSON_ERROR && j[0].depth==1;
  json_start(j[..],"{]");#assert json_next(j[..])==JSON_OBJECT && json_next(j[..])==JSON_ERROR && j[0].depth==1;
  json_start(j[..],"[1}");#assert json_next(j[..])==JSON_ARRAY && json_next(j[..])==JSON_NUMBER && json_next(j[..])==JSON_ERROR && j[0].depth==1;
  json_start(j[..],"{\"x\":1]");#assert json_next(j[..])==JSON_OBJECT && json_next(j[..])==JSON_STRING && json_next(j[..])==JSON_NUMBER && json_next(j[..])==JSON_ERROR && j[0].depth==1;
  out:[8]u8;
  #assert json_unescape("\\uDC00",out[..]) == -1;
  #assert json_unescape("\\uDBFF\\uDC00a",out[..])==5 && out[4]==97;
  #assert json_unescape("\\uDFFF",out[..]) == -1;
  #assert json_unescape("\\u0000",out[..])==1 && out[0]==0;
  ctl:=[1]u8.[1];
  #assert json_write_string(out[0..<7],0,cast(string)ctl[..]) == -1;
  #assert json_write_string(out[0..<8],0,cast(string)ctl[..])==8;
  #assert json_write_string(out[0..<6],0,cast(string)ctl[..]) == -1;
}
#test "raw string budget includes a nonzero opening offset" {
  buf:[65540]u8;for i:0..<buf.count {buf[i]=97;}
  buf[0]='[';buf[1]='"';buf[65538]='"';buf[65539]=']';
  #assert json_valid(cast(string)buf[..]);
}

#test "truncated strings refuse at the original byte and control writes stay bounded" {
  j:[1]Json;json_start(j[..],"\"\\\"");#assert json_next(j[..])==JSON_ERROR && j[0].error_at==3;
  json_start(j[..],"\"\\u0000");#assert json_next(j[..])==JSON_ERROR && j[0].error_at==7;
  #assert !json_valid("\"\\ug000\"") && !json_valid("{\"x\":]");
  out:[8]u8;#assert json_unescape("\\u0080a",out[0..<1]) == -1;
  ctl:=[1]u8.[1];
  #assert json_write_string(out[0..<3],0,cast(string)ctl[..]) == -1;
  #assert json_write_string(out[0..<4],0,cast(string)ctl[..]) == -1;
  for i:0..<8 {out[i]=255;}
  #assert json_write_string(out[0..<7],0,cast(string)ctl[..]) == -1;
  #assert out[5]=='0' && out[6]=='1' && out[7]==255;
}

#test "short Unicode escapes and paired low surrogates cannot bypass admission" {
  j:[1]Json;json_start(j[..],"\"\\u000");
  #assert json_next(j[..])==JSON_ERROR && j[0].error_at==1;
  out:[8]u8;#assert json_unescape("\\uDC00\\uDC00",out[..]) == -1;
}
