// MKT orders under the LAB profile: one negotiation from request for quote
// to paid, as a state machine under the caller's clock.
// NIP-MKT "Terms and records", "Negotiation and admission" and "Fixed-price
// Bitcoin settlement"; NIP-LAB "Delivery and independent verification",
// "Buyer review" and "Final acceptance and amounts due".
//
// One MktMarket is one negotiation: one buyer, one provider, one offering.
// Each step takes the verified signer of the record's private envelope and
// the host's receipt time, checks it, and changes the market only when it
// returns MKT_OK. A refusal leaves every field as it was.
//
//   mkt_rfq      buyer asks, against a fresh offering from this provider
//   mkt_quote    provider quotes exact terms within the RFQ's price limit
//   mkt_order    buyer orders a quote that exists, is unexpired and unused
//   mkt_ack      provider confirms by order_confirm_by, or refuses
//   mkt_submit   the worker named in the terms delivers submission zero
//   mkt_verify   the reviewer named in the terms records the verdict
//   mkt_accept   buyer accepts a passed, timely submission: amount due is
//                exactly price_msat
//   mkt_instruct provider's earned-price invoice: exactly the amount due,
//                one obligation per order
//   mkt_attempt  buyer records a payment attempt before any wallet call
//   mkt_result   buyer's wallet observation; confirmed needs a Lightning
//                preimage that hashes to the invoice's payment hash
//
// Money: an order only for a quote that exists and has not expired; payment
// only after acceptance, never more or less than the accepted price; one
// earned-price obligation; no attempt while another is pending or unknown,
// none after a confirmed payment.
//
// It trusts the caller for what it does not see: the 3188 envelopes are
// opened and their signers verified, records are schema-checked, digests are
// of the exact JCS bytes, the invoice's BOLT11 signature, network and payment
// hash were decoded by the payment host (only the amount in the
// human-readable part is read here, through x402_bolt11_msat, mainnet only).
//
// Not here: per-issuer seq/prev chains and equivocation, rework, rejections,
// disputes, resolvers, cancellation, refunds, replacement invoices, payee
// payment_received, close, and every on-chain or other rail.
//   coax/bin/coax test coax/lib/nostr/mkt/order.coax --library
#load "../../../lib/x402/settle.coax";
#load "../../kept.coax";
#load "../../../tests/nostr/mkt_order_fixtures.coax";
#authority;

// book:begin codes
MKT_OK :: 0;
MKT_MALFORMED :: 1;            // bad deadlines, amounts or fields
MKT_NOT_ADMITTED :: 2;         // the signer does not hold this record's role
MKT_IDENTITY :: 3;             // identity_mismatch: another provider, terms digest or quote
MKT_STALE :: 4;                // an expired offering, a late quote, an expired invoice
MKT_CONFLICT :: 5;             // the step is not open in this state
MKT_LIMIT :: 6;                // no room for another quote
MKT_UNSUPPORTED :: 7;          // unsupported_profile: payment profile, network or rail
MKT_QUOTE_EXPIRED :: 8;
MKT_QUOTE_CONSUMED :: 9;
MKT_CONFIRMATION_EXPIRED :: 10;
MKT_PRICE_EXCEEDED :: 11;
MKT_UNAVAILABLE :: 12;         // content_unavailable: no such quote
MKT_IDEMPOTENCY :: 13;         // idempotency_conflict: same ID, other bytes
MKT_NOT_ACCEPTED :: 14;        // no valid acceptance (or instruction) to pay against
MKT_AMOUNT :: 15;              // not exactly the accepted price
MKT_PROOF :: 16;               // the preimage does not hash to the payment hash
MKT_PAID :: 17;                // the obligation is already paid
MKT_PENDING :: 18;             // an earlier attempt is pending or unknown
MKT_LATE :: 19;                // delivery received after delivery_due_at
MKT_UNVERIFIED :: 20;          // the reviewer's verdict is not passed
// book:end codes

// book:begin states
MKT_OPEN :: 0; MKT_ASKED :: 1; MKT_ORDERED :: 2; MKT_CONFIRMED :: 3;   // negotiation
MKT_FREE :: 1; MKT_LIGHTNING :: 2;               // payment profiles, as bits
MKT_BITCOIN :: 1; MKT_TESTNET :: 2; MKT_REGTEST :: 4;   // networks, as bits; 0 is null
MKT_PASSED :: 0; MKT_FAILED :: 1; MKT_UNVERIFIABLE :: 2; MKT_NOT_RUN :: 3;  // verdicts
MKT_NONE :: 0; MKT_PAY_PENDING :: 1; MKT_PAY_UNKNOWN :: 2; MKT_PAY_FAILED :: 3; MKT_PAY_CONFIRMED :: 4;
MKT_RAIL_LIGHTNING :: 0; MKT_RAIL_ONCHAIN :: 1; MKT_RAIL_ZAP :: 2;   // any other value is another rail
// book:end states

// book:begin record
// The market keeps its own copy of every string it stores. A string
// argument only borrows the caller's bytes, and a caller may read the next
// record into the same buffer; a stored borrow would then change a quote's
// terms, the order, or the invoice's payment hash after the step checked
// them. A Kept(9) (coax/lib/kept.coax) holds MKT_TEXT bytes: a 64-hex ID
// or key or a "sha256:" digest. kept72 of a longer string is refused
// (n = -1), and no step stores that.
MKT_TEXT :: 72;
MktOffering :: struct {provider:string;valid_until:int;profiles:int;networks:int;}
MktTerms :: struct {
  quote_id:Kept(9);digest:Kept(9);worker:Kept(9);reviewer:Kept(9);
  price_msat:int;fee_limit_msat:int;profile:int;network:int;
  quote_expires_at:int;order_confirm_by:int;delivery_due_at:int;
  review_due_at:int;payment_due_at:int;retain_until:int;
  consumed:bool;                     // a buyer's order has named it
}
MktMarket :: struct {
  market:string;buyer:string;provider:string;offering:MktOffering;
  stage:int;price_limit:int;response_due_at:int;
  quotes:int;order:int=-1;order_id:Kept(9);     // order indexes the quotes
  submitted:bool;submitted_at:int;verdict:int=-1;
  accepted:bool;amount_due:int=-1;
  obligation:Kept(9);amount_msat:int;payment_hash:Kept(9);expires_at:int;
  attempts:int;payment:int;paid_msat:int;
}
MktProof :: struct {rail:int;state:int;amount_msat:int;preimage:string;}
// book:end record

// book:begin negotiate
mkt_bit :: (x:int)->bool {return x==1 || x==2 || x==4;}

mkt_rfq :: (m:[]MktMarket,o:MktOffering,signer:string,price_limit:int,response_due_at:int,retain_until:int,now:int)->int {
  if signer!=m[0].buyer {return MKT_NOT_ADMITTED;}
  if m[0].stage!=MKT_OPEN {return MKT_CONFLICT;}
  if o.provider!=m[0].provider {return MKT_IDENTITY;}
  if now>=o.valid_until {return MKT_STALE;}
  if price_limit<0 || response_due_at<=now || retain_until<=response_due_at {return MKT_MALFORMED;}
  m[0].offering=o;m[0].offering.provider=m[0].provider;m[0].price_limit=price_limit;m[0].response_due_at=response_due_at;m[0].stage=MKT_ASKED;
  return MKT_OK;
}

mkt_quote :: (m:[]MktMarket,q:[]MktTerms,t:MktTerms,signer:string,now:int)->int {
  if signer!=m[0].provider {return MKT_NOT_ADMITTED;}
  if m[0].stage!=MKT_ASKED {return MKT_CONFLICT;}
  if now>m[0].response_due_at {return MKT_STALE;}
  if t.quote_id.n<=0 || t.digest.n<=0 || t.worker.n<=0 || t.reviewer.n<=0 {return MKT_MALFORMED;}   // empty, or too long to keep
  for i:0..<m[0].quotes {
    if kept_same(q[i].quote_id,t.quote_id) {return ifx kept_same(q[i].digest,t.digest) then MKT_OK else MKT_IDEMPOTENCY;}
  }
  if t.quote_expires_at<=now || t.order_confirm_by<t.quote_expires_at || t.delivery_due_at<=t.order_confirm_by
     || t.review_due_at<=t.delivery_due_at || t.payment_due_at<=t.review_due_at || t.retain_until<=t.payment_due_at {return MKT_MALFORMED;}
  if kept_is(t.reviewer,m[0].provider) || kept_same(t.reviewer,t.worker) {return MKT_MALFORMED;}
  if (t.profile!=MKT_FREE && t.profile!=MKT_LIGHTNING) || (m[0].offering.profiles&t.profile)==0 {return MKT_UNSUPPORTED;}
  if t.profile==MKT_FREE {
    if t.price_msat!=0 || t.fee_limit_msat!=0 || t.network!=0 {return MKT_MALFORMED;}
  } else {
    if t.price_msat<=0 || t.fee_limit_msat<0 {return MKT_MALFORMED;}
    if !mkt_bit(t.network) || (m[0].offering.networks&t.network)==0 {return MKT_UNSUPPORTED;}
  }
  if t.price_msat>m[0].price_limit {return MKT_PRICE_EXCEEDED;}
  if m[0].quotes>=q.count {return MKT_LIMIT;}
  q[m[0].quotes]=t;q[m[0].quotes].consumed=false;m[0].quotes+=1;
  return MKT_OK;
}

// The award: the buyer orders exactly one quote's terms.
mkt_order :: (m:[]MktMarket,q:[]MktTerms,signer:string,quote_id:string,terms_digest:string,order_id:string,now:int)->int {
  if signer!=m[0].buyer {return MKT_NOT_ADMITTED;}
  if m[0].stage!=MKT_ASKED {return MKT_CONFLICT;}
  if order_id.count>MKT_TEXT {return MKT_MALFORMED;}
  for i:0..<m[0].quotes {
    if kept_is(q[i].quote_id,quote_id) {
      if !kept_is(q[i].digest,terms_digest) {return MKT_IDENTITY;}
      if q[i].consumed {return MKT_QUOTE_CONSUMED;}
      if now>q[i].quote_expires_at {return MKT_QUOTE_EXPIRED;}
      q[i].consumed=true;m[0].order=i;m[0].order_id=kept72(order_id);m[0].stage=MKT_ORDERED;
      return MKT_OK;
    }
  }
  return MKT_UNAVAILABLE;
}

// The provider confirms (or refuses) the order. A refusal frees the
// negotiation for another order; the refused quote stays consumed.
mkt_ack :: (m:[]MktMarket,q:[]MktTerms,signer:string,confirm:bool,now:int)->int {
  if signer!=m[0].provider {return MKT_NOT_ADMITTED;}
  if m[0].stage!=MKT_ORDERED {return MKT_CONFLICT;}
  if !confirm {m[0].stage=MKT_ASKED;m[0].order=-1;m[0].order_id=kept72("");return MKT_OK;}
  if now>q[m[0].order].order_confirm_by {return MKT_CONFIRMATION_EXPIRED;}
  m[0].stage=MKT_CONFIRMED;
  return MKT_OK;
}
// book:end negotiate

// book:begin deliver
// Submission zero from the worker the confirmed terms name; any other key
// refuses, the provider's included.
mkt_submit :: (m:[]MktMarket,q:[]MktTerms,signer:string,now:int)->int {
  if m[0].stage!=MKT_CONFIRMED {return MKT_CONFLICT;}
  if !kept_is(q[m[0].order].worker,signer) {return MKT_NOT_ADMITTED;}
  if m[0].submitted {return MKT_CONFLICT;}
  m[0].submitted=true;m[0].submitted_at=now;
  return MKT_OK;
}

mkt_verify :: (m:[]MktMarket,q:[]MktTerms,signer:string,verdict:int)->int {
  if m[0].stage!=MKT_CONFIRMED || !m[0].submitted {return MKT_CONFLICT;}
  if !kept_is(q[m[0].order].reviewer,signer) {return MKT_NOT_ADMITTED;}
  if verdict<MKT_PASSED || verdict>MKT_NOT_RUN {return MKT_MALFORMED;}
  if m[0].verdict!=-1 {return MKT_CONFLICT;}
  m[0].verdict=verdict;
  return MKT_OK;
}

// The buyer's acceptance with its delivery receipt: received_at is when it
// fetched the submission. Accepted means the amount due is the price.
mkt_accept :: (m:[]MktMarket,q:[]MktTerms,signer:string,received_at:int,now:int)->int {
  if signer!=m[0].buyer {return MKT_NOT_ADMITTED;}
  if m[0].stage!=MKT_CONFIRMED || !m[0].submitted || m[0].accepted {return MKT_CONFLICT;}
  if received_at<m[0].submitted_at || received_at>now {return MKT_MALFORMED;}
  if m[0].verdict!=MKT_PASSED {return MKT_UNVERIFIED;}
  if received_at>q[m[0].order].delivery_due_at {return MKT_LATE;}
  m[0].accepted=true;m[0].amount_due=q[m[0].order].price_msat;
  return MKT_OK;
}
// book:end deliver

// book:begin settle
// The provider's payment instruction for the earned price.
mkt_instruct :: (m:[]MktMarket,q:[]MktTerms,signer:string,obligation:string,amount_msat:int,invoice:string,payment_hash:string,expires_at:int,now:int)->int {
  if signer!=m[0].provider {return MKT_NOT_ADMITTED;}
  if m[0].stage!=MKT_CONFIRMED {return MKT_CONFLICT;}
  t:=q[m[0].order];
  if t.profile!=MKT_LIGHTNING || t.network!=MKT_BITCOIN {return MKT_UNSUPPORTED;}
  if !m[0].accepted {return MKT_NOT_ACCEPTED;}
  if m[0].obligation.n!=0 {return MKT_CONFLICT;}   // one earned-price obligation per order
  if amount_msat!=m[0].amount_due || x402_bolt11_msat(invoice)!=amount_msat {return MKT_AMOUNT;}
  if !x402_is_hex64(payment_hash) || obligation=="" || obligation.count>MKT_TEXT {return MKT_MALFORMED;}
  if expires_at<=now {return MKT_STALE;}
  m[0].obligation=kept72(obligation);m[0].amount_msat=amount_msat;m[0].payment_hash=kept72(payment_hash);m[0].expires_at=expires_at;
  return MKT_OK;
}

// The buyer persists attempt number n before it calls its wallet.
mkt_attempt :: (m:[]MktMarket,q:[]MktTerms,signer:string,n:int,fee_limit_msat:int,now:int)->int {
  if signer!=m[0].buyer {return MKT_NOT_ADMITTED;}
  if m[0].obligation.n==0 {return MKT_NOT_ACCEPTED;}
  if m[0].payment==MKT_PAY_CONFIRMED {return MKT_PAID;}
  if m[0].payment==MKT_PAY_PENDING || m[0].payment==MKT_PAY_UNKNOWN {return MKT_PENDING;}
  if n!=m[0].attempts+1 || fee_limit_msat!=q[m[0].order].fee_limit_msat {return MKT_MALFORMED;}
  if now>=m[0].expires_at {return MKT_STALE;}
  m[0].attempts=n;m[0].payment=MKT_PAY_PENDING;
  return MKT_OK;
}

// The buyer's wallet observation of the pending attempt. Only a Lightning
// proof settles: the exact amount and a preimage of the payment hash.
mkt_result :: (m:[]MktMarket,signer:string,p:MktProof)->int {
  if signer!=m[0].buyer {return MKT_NOT_ADMITTED;}
  if m[0].payment==MKT_PAY_CONFIRMED {return MKT_PAID;}
  if m[0].payment!=MKT_PAY_PENDING && m[0].payment!=MKT_PAY_UNKNOWN {return MKT_CONFLICT;}
  if p.rail!=MKT_RAIL_LIGHTNING {return MKT_UNSUPPORTED;}
  if p.state==MKT_PAY_UNKNOWN || p.state==MKT_PAY_FAILED {m[0].payment=p.state;return MKT_OK;}
  if p.state!=MKT_PAY_CONFIRMED {return MKT_MALFORMED;}
  if p.amount_msat!=m[0].amount_msat {return MKT_AMOUNT;}
  h:[MKT_TEXT]u8;k:=kept_bytes(m[0].payment_hash,h[..]);
  if !x402_preimage_matches(p.preimage,cast(string)h[0..<k]) {return MKT_PROOF;}
  m[0].payment=MKT_PAY_CONFIRMED;m[0].paid_msat=p.amount_msat;
  return MKT_OK;
}
// book:end settle

// ---- checks

#test "codes and states are distinct" {
  #assert MKT_OK==0 && MKT_MALFORMED==1 && MKT_NOT_ADMITTED==2 && MKT_IDENTITY==3 && MKT_STALE==4 && MKT_CONFLICT==5;
  #assert MKT_LIMIT==6 && MKT_UNSUPPORTED==7 && MKT_QUOTE_EXPIRED==8 && MKT_QUOTE_CONSUMED==9 && MKT_CONFIRMATION_EXPIRED==10;
  #assert MKT_PRICE_EXCEEDED==11 && MKT_UNAVAILABLE==12 && MKT_IDEMPOTENCY==13 && MKT_NOT_ACCEPTED==14 && MKT_AMOUNT==15;
  #assert MKT_PROOF==16 && MKT_PAID==17 && MKT_PENDING==18 && MKT_LATE==19 && MKT_UNVERIFIED==20;
  #assert MKT_OPEN==0 && MKT_ASKED==1 && MKT_ORDERED==2 && MKT_CONFIRMED==3 && MKT_FREE==1 && MKT_LIGHTNING==2;
  #assert MKT_BITCOIN==1 && MKT_TESTNET==2 && MKT_REGTEST==4 && MKT_PASSED==0 && MKT_FAILED==1 && MKT_UNVERIFIABLE==2 && MKT_NOT_RUN==3;
  #assert MKT_NONE==0 && MKT_PAY_PENDING==1 && MKT_PAY_UNKNOWN==2 && MKT_PAY_FAILED==3 && MKT_PAY_CONFIRMED==4;
  #assert MKT_RAIL_LIGHTNING==0 && MKT_RAIL_ONCHAIN==1 && MKT_RAIL_ZAP==2;
  m:MktMarket;#assert m.order==-1 && m.verdict==-1 && m.amount_due==-1 && m.payment==MKT_NONE;
}
#forall "a network is one of three bits" x:-1..<9 {#assert mkt_bit(x)==(x==1 || x==2 || x==4);}
#test "one job from request to paid, in msats" {
  m:[1]MktMarket;q:[4]MktTerms;mk_instructed(m[..],q[..]);
  #assert m[0].stage==MKT_CONFIRMED && m[0].order==0 && kept_is(m[0].order_id,"order-1") && q[0].consumed;
  #assert m[0].submitted_at==MK_T0+950 && m[0].verdict==MKT_PASSED && m[0].accepted && m[0].amount_due==50000;
  #assert kept_is(m[0].obligation,"ob-1") && m[0].amount_msat==50000 && kept_is(m[0].payment_hash,X402_FIX_HASH) && m[0].expires_at==MK_T0+5000;
  #assert mkt_attempt(m[..],q[..],MK_BUYER,1,1000,MK_T0+1500)==MKT_OK && m[0].attempts==1 && m[0].payment==MKT_PAY_PENDING;
  #assert mkt_result(m[..],MK_BUYER,mk_proof(MKT_RAIL_LIGHTNING,MKT_PAY_CONFIRMED,50000,X402_FIX_PREIMAGE))==MKT_OK;
  #assert m[0].payment==MKT_PAY_CONFIRMED && m[0].paid_msat==50000;
  // No double payment: neither another attempt nor another result.
  #assert mkt_attempt(m[..],q[..],MK_BUYER,2,1000,MK_T0+1600)==MKT_PAID;
  #assert mkt_result(m[..],MK_BUYER,mk_proof(MKT_RAIL_LIGHTNING,MKT_PAY_CONFIRMED,50000,X402_FIX_PREIMAGE))==MKT_PAID;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-2",50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1600)==MKT_CONFLICT;
  #assert m[0].attempts==1 && m[0].paid_msat==50000;
}
#test "the market keeps its own copy of every string it stores" {
  m:[1]MktMarket;q:[2]MktTerms;d:[72]u8;w:[73]u8;
  // The caller reads each record into d and w and reuses them.
  m[0]=mk_market();o:=mk_offering();o.provider=mk_put(d[..],MK_PROVIDER);
  #assert mkt_rfq(m[..],o,MK_BUYER,60000,MK_T0+300,MK_T0+40*86400,MK_T0)==MKT_OK;
  t:=mk_terms("A",50000);t.digest=kept72(mk_put(d[..],MK_DIGEST));t.worker=kept72(mk_put(d[..],MK_WORKER));
  #assert mkt_quote(m[..],q[..],t,MK_PROVIDER,MK_T0+100)==MKT_OK;
  #assert mkt_order(m[..],q[..],MK_BUYER,mk_put(d[..],"A"),MK_DIGEST,mk_put(w[..],"order-1"),MK_T0+300)==MKT_OK;
  x:=mk_put(d[..],MK_OTHER);x=mk_put(w[..],"order-2");
  #assert m[0].offering.provider==MK_PROVIDER && kept_is(m[0].order_id,"order-1") && kept_is(q[0].worker,MK_WORKER) && kept_is(q[0].digest,MK_DIGEST);
  #assert mkt_ack(m[..],q[..],MK_PROVIDER,true,MK_T0+350)==MKT_OK && mkt_submit(m[..],q[..],MK_WORKER,MK_T0+950)==MKT_OK;
  #assert mkt_verify(m[..],q[..],MK_REVIEWER,MKT_PASSED)==MKT_OK && mkt_accept(m[..],q[..],MK_BUYER,MK_T0+1000,MK_T0+1300)==MKT_OK;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,mk_put(w[..],"ob-1"),50000,X402_FIX_INVOICE,mk_put(d[..],X402_FIX_HASH),MK_T0+5000,MK_T0+1400)==MKT_OK;
  x=mk_put(w[..],"ob-2");x=mk_put(d[..],MK_ZERO);
  #assert kept_is(m[0].obligation,"ob-1") && kept_is(m[0].payment_hash,X402_FIX_HASH);
  out:[73]u8;
  #assert kept_bytes(m[0].payment_hash,out[..])==64 && cast(string)out[0..<64]==X402_FIX_HASH && kept_bytes(m[0].payment_hash,out[0..<63])==-1;
  // The proof is checked against the hash the provider sent, not the buffer's.
  #assert mkt_attempt(m[..],q[..],MK_BUYER,1,1000,MK_T0+1500)==MKT_OK;
  #assert mkt_result(m[..],MK_BUYER,mk_proof(MKT_RAIL_LIGHTNING,MKT_PAY_CONFIRMED,50000,X402_FIX_PREIMAGE))==MKT_OK && m[0].paid_msat==50000;
  // 72 bytes is the longest kept; 73 refuses as malformed.
  for k:0..<73 {w[k]='a';}
  long:=cast(string)w[..];most:=cast(string)w[0..<72];
  #assert kept72(long).n==-1 && kept72(most).n==72 && kept_bytes(kept72(most),out[0..<72])==72 && kept_bytes(kept72(most),out[0..<71])==-1;
  n:[1]MktMarket;mk_quoted(n[..],q[..]);
  // So does an empty ID, digest or key.
  for f:0..<8 {
    v:=kept72(ifx f<4 then long else "");
    b:=mk_terms("B",50000);if f%4==0 {b.quote_id=v;}if f%4==1 {b.digest=v;}if f%4==2 {b.worker=v;}if f%4==3 {b.reviewer=v;}
    #assert mkt_quote(n[..],q[..],b,MK_PROVIDER,MK_T0+100)==MKT_MALFORMED;
  }
  // One byte to 72 bytes are kept.
  b:=mk_terms("B",50000);b.quote_id=kept72(most);b.digest=kept72("d");b.worker=kept72("w");b.reviewer=kept72("r");
  #assert mkt_quote(n[..],q[..],b,MK_PROVIDER,MK_T0+100)==MKT_OK && n[0].quotes==2;
  #assert mkt_order(n[..],q[..],MK_BUYER,"A",MK_DIGEST,long,MK_T0+300)==MKT_MALFORMED && n[0].stage==MKT_ASKED;
  #assert mkt_order(n[..],q[..],MK_BUYER,long,MK_DIGEST,"order-1",MK_T0+300)==MKT_UNAVAILABLE;
  #assert mkt_order(n[..],q[..],MK_BUYER,"A",MK_DIGEST,most,MK_T0+300)==MKT_OK && kept_is(n[0].order_id,most);
  #assert mkt_ack(n[..],q[..],MK_PROVIDER,true,MK_T0+350)==MKT_OK && mkt_submit(n[..],q[..],MK_WORKER,MK_T0+950)==MKT_OK;
  #assert mkt_verify(n[..],q[..],MK_REVIEWER,MKT_PASSED)==MKT_OK && mkt_accept(n[..],q[..],MK_BUYER,MK_T0+1000,MK_T0+1300)==MKT_OK;
  #assert mkt_instruct(n[..],q[..],MK_PROVIDER,long,50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_MALFORMED && n[0].obligation.n==0;
  #assert mkt_instruct(n[..],q[..],MK_PROVIDER,most,50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_OK && kept_is(n[0].obligation,most);
}
#test "rfq: the buyer, once, against a fresh offering from this provider" {
  m:=[1]MktMarket.[mk_market()];o:=mk_offering();
  #assert mkt_rfq(m[..],o,MK_PROVIDER,60000,MK_T0+300,MK_T0+400,MK_T0)==MKT_NOT_ADMITTED;
  x:=o;x.provider=MK_OTHER;
  #assert mkt_rfq(m[..],x,MK_BUYER,60000,MK_T0+300,MK_T0+400,MK_T0)==MKT_IDENTITY;
  #assert mkt_rfq(m[..],o,MK_BUYER,60000,MK_T0+300,MK_T0+400,MK_T0+86400)==MKT_STALE;
  #assert mkt_rfq(m[..],o,MK_BUYER,-1,MK_T0+300,MK_T0+400,MK_T0)==MKT_MALFORMED;
  #assert mkt_rfq(m[..],o,MK_BUYER,60000,MK_T0,MK_T0+400,MK_T0)==MKT_MALFORMED;
  #assert mkt_rfq(m[..],o,MK_BUYER,60000,MK_T0+300,MK_T0+300,MK_T0)==MKT_MALFORMED;
  #assert mk_same(m[0],mk_market());
  #assert mkt_rfq(m[..],o,MK_BUYER,0,MK_T0+86400,MK_T0+86401,MK_T0+86399)==MKT_OK;
  #assert m[0].stage==MKT_ASKED && m[0].price_limit==0 && m[0].response_due_at==MK_T0+86400 && m[0].offering.valid_until==MK_T0+86400;
  #assert mkt_rfq(m[..],o,MK_BUYER,0,MK_T0+86500,MK_T0+86600,MK_T0+86399)==MKT_CONFLICT;
}
#test "quote: the provider, by the response deadline, within the limit" {
  m:[1]MktMarket;q:[2]MktTerms;mk_quoted(m[..],q[..]);
  #assert m[0].quotes==1 && kept_is(q[0].quote_id,"A") && q[0].price_msat==50000 && !q[0].consumed;
  b:=m[0];
  #assert mkt_quote(m[..],q[..],mk_terms("B",50000),MK_BUYER,MK_T0+100)==MKT_NOT_ADMITTED;
  #assert mkt_quote(m[..],q[..],mk_terms("B",50000),MK_PROVIDER,MK_T0+301)==MKT_STALE;
  #assert mkt_quote(m[..],q[..],mk_terms("B",60001),MK_PROVIDER,MK_T0+100)==MKT_PRICE_EXCEEDED;
  #assert mk_same(m[0],b);
  // A retransmission is accepted without change; other bytes under its ID are not.
  #assert mkt_quote(m[..],q[..],mk_terms("A",50000),MK_PROVIDER,MK_T0+300)==MKT_OK && m[0].quotes==1;
  y:=mk_terms("A",40000);y.digest=kept72(MK_DIGEST_B);
  #assert mkt_quote(m[..],q[..],y,MK_PROVIDER,MK_T0+100)==MKT_IDEMPOTENCY && q[0].price_msat==50000;
  c:=mk_terms("B",60000);c.digest=kept72(MK_DIGEST_B);c.consumed=true;
  #assert mkt_quote(m[..],q[..],c,MK_PROVIDER,MK_T0+300)==MKT_OK && m[0].quotes==2 && !q[1].consumed && q[1].price_msat==60000;
  #assert mkt_quote(m[..],q[..],mk_terms("C",1),MK_PROVIDER,MK_T0+100)==MKT_LIMIT && m[0].quotes==2;
  // The retransmission of the second quote is found after the first.
  #assert mkt_quote(m[..],q[..],c,MK_PROVIDER,MK_T0+100)==MKT_OK;
  // No quote before an RFQ.
  n:=[1]MktMarket.[mk_market()];
  #assert mkt_quote(n[..],q[..],mk_terms("A",1),MK_PROVIDER,MK_T0)==MKT_CONFLICT;
}
#test "quote: every deadline in order, each boundary" {
  m:[1]MktMarket;q:[8]MktTerms;mk_quoted(m[..],q[..]);
  bad:[7]MktTerms;for i:0..<7 {bad[i]=mk_terms("D",50000);}
  bad[0].quote_expires_at=MK_T0+100;
  bad[1].order_confirm_by=MK_T0+599;
  bad[2].delivery_due_at=MK_T0+900;
  bad[3].review_due_at=MK_T0+3600;
  bad[4].payment_due_at=MK_T0+7200;
  bad[5].retain_until=MK_T0+86400;
  bad[6].reviewer=kept72(MK_WORKER);
  for i:0..<7 {#assert mkt_quote(m[..],q[..],bad[i],MK_PROVIDER,MK_T0+100)==MKT_MALFORMED;}
  r:=mk_terms("D",50000);r.reviewer=kept72(MK_PROVIDER);
  #assert mkt_quote(m[..],q[..],r,MK_PROVIDER,MK_T0+100)==MKT_MALFORMED && m[0].quotes==1;
  // Each one second later is admitted.
  e:=mk_terms("E",50000);e.quote_expires_at=MK_T0+101;e.order_confirm_by=MK_T0+101;e.delivery_due_at=MK_T0+102;
  e.review_due_at=MK_T0+103;e.payment_due_at=MK_T0+104;e.retain_until=MK_T0+105;
  #assert mkt_quote(m[..],q[..],e,MK_PROVIDER,MK_T0+100)==MKT_OK && m[0].quotes==2;
}
#test "quote: payment profiles and networks the offering supports" {
  m:[1]MktMarket;q:[8]MktTerms;mk_quoted(m[..],q[..]);
  f:=mk_terms("F",0);f.profile=MKT_FREE;f.fee_limit_msat=0;f.network=0;
  #assert mkt_quote(m[..],q[..],f,MK_PROVIDER,MK_T0+100)==MKT_OK && m[0].quotes==2;
  g:=f;g.quote_id=kept72("G");g.price_msat=1;#assert mkt_quote(m[..],q[..],g,MK_PROVIDER,MK_T0+100)==MKT_MALFORMED;
  g=f;g.quote_id=kept72("G");g.fee_limit_msat=1;#assert mkt_quote(m[..],q[..],g,MK_PROVIDER,MK_T0+100)==MKT_MALFORMED;
  g=f;g.quote_id=kept72("G");g.network=MKT_BITCOIN;#assert mkt_quote(m[..],q[..],g,MK_PROVIDER,MK_T0+100)==MKT_MALFORMED;
  l:=mk_terms("L",0);#assert mkt_quote(m[..],q[..],l,MK_PROVIDER,MK_T0+100)==MKT_MALFORMED;
  l=mk_terms("L",1);l.fee_limit_msat=-1;#assert mkt_quote(m[..],q[..],l,MK_PROVIDER,MK_T0+100)==MKT_MALFORMED;
  l=mk_terms("L",1);l.fee_limit_msat=0;#assert mkt_quote(m[..],q[..],l,MK_PROVIDER,MK_T0+100)==MKT_OK;
  for p:[4]int.[0,3,4,8] {l=mk_terms("P",1);l.profile=p;#assert mkt_quote(m[..],q[..],l,MK_PROVIDER,MK_T0+100)==MKT_UNSUPPORTED;}
  for n:[5]int.[0,MKT_TESTNET,MKT_REGTEST,3,8] {l=mk_terms("N",1);l.network=n;#assert mkt_quote(m[..],q[..],l,MK_PROVIDER,MK_T0+100)==MKT_UNSUPPORTED;}
  #assert m[0].quotes==3;
  // An offering without Lightning, or without the free profile.
  m[0].offering.profiles=MKT_FREE;
  #assert mkt_quote(m[..],q[..],mk_terms("Q",1),MK_PROVIDER,MK_T0+100)==MKT_UNSUPPORTED;
  m[0].offering.profiles=MKT_LIGHTNING;f.quote_id=kept72("R");
  #assert mkt_quote(m[..],q[..],f,MK_PROVIDER,MK_T0+100)==MKT_UNSUPPORTED;
  m[0].offering.networks=MKT_BITCOIN|MKT_REGTEST;l=mk_terms("S",1);l.network=MKT_REGTEST;
  #assert mkt_quote(m[..],q[..],l,MK_PROVIDER,MK_T0+100)==MKT_OK && m[0].quotes==4;
}
#test "order: only a quote that exists, is unexpired and unused, with its exact terms" {
  m:[1]MktMarket;q:[2]MktTerms;mk_quoted(m[..],q[..]);b:=m[0];
  #assert mkt_order(m[..],q[..],MK_PROVIDER,"A",MK_DIGEST,"order-1",MK_T0+300)==MKT_NOT_ADMITTED;
  #assert mkt_order(m[..],q[..],MK_BUYER,"Z",MK_DIGEST,"order-1",MK_T0+300)==MKT_UNAVAILABLE;
  #assert mkt_order(m[..],q[..],MK_BUYER,"A",MK_DIGEST_B,"order-1",MK_T0+300)==MKT_IDENTITY;
  #assert mkt_order(m[..],q[..],MK_BUYER,"A",MK_DIGEST,"order-1",MK_T0+601)==MKT_QUOTE_EXPIRED;
  #assert mk_same(m[0],b) && !q[0].consumed;
  #assert mkt_order(m[..],q[..],MK_BUYER,"A",MK_DIGEST,"order-1",MK_T0+600)==MKT_OK;
  #assert m[0].stage==MKT_ORDERED && m[0].order==0 && kept_is(m[0].order_id,"order-1") && q[0].consumed;
  #assert mkt_order(m[..],q[..],MK_BUYER,"A",MK_DIGEST,"order-2",MK_T0+600)==MKT_CONFLICT;
  // The provider refuses: the negotiation is open again, the quote is spent.
  #assert mkt_ack(m[..],q[..],MK_PROVIDER,false,MK_T0+601)==MKT_OK;
  #assert m[0].stage==MKT_ASKED && m[0].order==-1 && m[0].order_id.n==0;
  #assert mkt_order(m[..],q[..],MK_BUYER,"A",MK_DIGEST,"order-2",MK_T0+500)==MKT_QUOTE_CONSUMED;
  // The second quote, found after the first.
  c:=mk_terms("B",55000);c.digest=kept72(MK_DIGEST_B);#assert mkt_quote(m[..],q[..],c,MK_PROVIDER,MK_T0+200)==MKT_OK;
  #assert mkt_order(m[..],q[..],MK_BUYER,"B",MK_DIGEST_B,"order-2",MK_T0+500)==MKT_OK && m[0].order==1;
}
#test "ack: the provider confirms by order_confirm_by" {
  m:[1]MktMarket;q:[2]MktTerms;mk_quoted(m[..],q[..]);
  #assert mkt_ack(m[..],q[..],MK_PROVIDER,true,MK_T0+300)==MKT_CONFLICT;
  #assert mkt_order(m[..],q[..],MK_BUYER,"A",MK_DIGEST,"order-1",MK_T0+300)==MKT_OK;
  #assert mkt_ack(m[..],q[..],MK_BUYER,true,MK_T0+300)==MKT_NOT_ADMITTED;
  #assert mkt_ack(m[..],q[..],MK_PROVIDER,true,MK_T0+901)==MKT_CONFIRMATION_EXPIRED && m[0].stage==MKT_ORDERED;
  #assert mkt_ack(m[..],q[..],MK_PROVIDER,true,MK_T0+900)==MKT_OK && m[0].stage==MKT_CONFIRMED;
  #assert mkt_ack(m[..],q[..],MK_PROVIDER,true,MK_T0+900)==MKT_CONFLICT;
  #assert mkt_ack(m[..],q[..],MK_PROVIDER,false,MK_T0+900)==MKT_CONFLICT && m[0].order==0;
}
#test "submit: only the worker in the terms, once, after confirmation" {
  m:[1]MktMarket;q:[2]MktTerms;mk_quoted(m[..],q[..]);
  #assert mkt_submit(m[..],q[..],MK_WORKER,MK_T0+950)==MKT_CONFLICT;
  #assert mkt_order(m[..],q[..],MK_BUYER,"A",MK_DIGEST,"order-1",MK_T0+300)==MKT_OK;
  #assert mkt_submit(m[..],q[..],MK_WORKER,MK_T0+950)==MKT_CONFLICT;
  #assert mkt_ack(m[..],q[..],MK_PROVIDER,true,MK_T0+350)==MKT_OK;
  #assert mkt_submit(m[..],q[..],MK_OTHER,MK_T0+950)==MKT_NOT_ADMITTED;
  #assert mkt_submit(m[..],q[..],MK_PROVIDER,MK_T0+950)==MKT_NOT_ADMITTED;
  #assert !m[0].submitted;
  #assert mkt_submit(m[..],q[..],MK_WORKER,MK_T0+950)==MKT_OK && m[0].submitted && m[0].submitted_at==MK_T0+950;
  #assert mkt_submit(m[..],q[..],MK_WORKER,MK_T0+960)==MKT_CONFLICT && m[0].submitted_at==MK_T0+950;
}
#test "verify: only the reviewer, a known verdict, once" {
  m:[1]MktMarket;q:[2]MktTerms;mk_confirmed(m[..],q[..]);
  #assert mkt_verify(m[..],q[..],MK_REVIEWER,MKT_PASSED)==MKT_CONFLICT;
  #assert mkt_submit(m[..],q[..],MK_WORKER,MK_T0+950)==MKT_OK;
  #assert mkt_verify(m[..],q[..],MK_BUYER,MKT_PASSED)==MKT_NOT_ADMITTED;
  #assert mkt_verify(m[..],q[..],MK_REVIEWER,-1)==MKT_MALFORMED && mkt_verify(m[..],q[..],MK_REVIEWER,4)==MKT_MALFORMED;
  #assert m[0].verdict==-1;
  #assert mkt_verify(m[..],q[..],MK_REVIEWER,MKT_NOT_RUN)==MKT_OK && m[0].verdict==MKT_NOT_RUN;
  #assert mkt_verify(m[..],q[..],MK_REVIEWER,MKT_PASSED)==MKT_CONFLICT && m[0].verdict==MKT_NOT_RUN;
  // Before confirmation, even with a submission on file.
  n:[1]MktMarket;mk_quoted(n[..],q[..]);n[0].submitted=true;n[0].order=0;
  #assert mkt_verify(n[..],q[..],MK_REVIEWER,MKT_PASSED)==MKT_CONFLICT;
}
#test "accept: passed, received in time, exactly the price" {
  m:[1]MktMarket;q:[2]MktTerms;mk_confirmed(m[..],q[..]);
  #assert mkt_accept(m[..],q[..],MK_BUYER,MK_T0+1000,MK_T0+1300)==MKT_CONFLICT;
  #assert mkt_submit(m[..],q[..],MK_WORKER,MK_T0+950)==MKT_OK;
  #assert mkt_accept(m[..],q[..],MK_BUYER,MK_T0+1000,MK_T0+1300)==MKT_UNVERIFIED;
  for v:[3]int.[MKT_FAILED,MKT_UNVERIFIABLE,MKT_NOT_RUN] {
    m[0].verdict=v;#assert mkt_accept(m[..],q[..],MK_BUYER,MK_T0+1000,MK_T0+1300)==MKT_UNVERIFIED;
  }
  m[0].verdict=-1;
  #assert mkt_verify(m[..],q[..],MK_REVIEWER,MKT_PASSED)==MKT_OK;
  #assert mkt_accept(m[..],q[..],MK_PROVIDER,MK_T0+1000,MK_T0+1300)==MKT_NOT_ADMITTED;
  #assert mkt_accept(m[..],q[..],MK_WORKER,MK_T0+1000,MK_T0+1300)==MKT_NOT_ADMITTED;
  #assert mkt_accept(m[..],q[..],MK_BUYER,MK_T0+949,MK_T0+1300)==MKT_MALFORMED;
  #assert mkt_accept(m[..],q[..],MK_BUYER,MK_T0+1301,MK_T0+1300)==MKT_MALFORMED;
  #assert mkt_accept(m[..],q[..],MK_BUYER,MK_T0+3601,MK_T0+4000)==MKT_LATE;
  #assert !m[0].accepted && m[0].amount_due==-1;
  #assert mkt_accept(m[..],q[..],MK_BUYER,MK_T0+3600,MK_T0+3600)==MKT_OK && m[0].accepted && m[0].amount_due==50000;
  #assert mkt_accept(m[..],q[..],MK_BUYER,MK_T0+3600,MK_T0+3600)==MKT_CONFLICT;
  n:[1]MktMarket;mk_confirmed(n[..],q[..]);
  #assert mkt_submit(n[..],q[..],MK_WORKER,MK_T0+950)==MKT_OK && mkt_verify(n[..],q[..],MK_REVIEWER,MKT_PASSED)==MKT_OK;
  #assert mkt_accept(n[..],q[..],MK_BUYER,MK_T0+950,MK_T0+950)==MKT_OK;
  // Before confirmation nothing can be accepted.
  o:[1]MktMarket;mk_quoted(o[..],q[..]);o[0].submitted=true;o[0].verdict=MKT_PASSED;o[0].order=0;
  #assert mkt_accept(o[..],q[..],MK_BUYER,MK_T0,MK_T0)==MKT_CONFLICT;
}
#test "instruct: after acceptance, exactly the price, one obligation" {
  m:[1]MktMarket;q:[2]MktTerms;mk_confirmed(m[..],q[..]);
  #assert mkt_submit(m[..],q[..],MK_WORKER,MK_T0+950)==MKT_OK && mkt_verify(m[..],q[..],MK_REVIEWER,MKT_PASSED)==MKT_OK;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-1",50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1000)==MKT_NOT_ACCEPTED;
  #assert mkt_accept(m[..],q[..],MK_BUYER,MK_T0+1000,MK_T0+1300)==MKT_OK;
  b:=m[0];
  #assert mkt_instruct(m[..],q[..],MK_BUYER,"ob-1",50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_NOT_ADMITTED;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-1",60000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_AMOUNT;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-1",49999,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_AMOUNT;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-1",50000,"lnbc600n1p4wfve5",X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_AMOUNT;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-1",50000,"lnbc1p4wfve5",X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_AMOUNT;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-1",50000,X402_FIX_INVOICE,"ae21",MK_T0+5000,MK_T0+1400)==MKT_MALFORMED;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"",50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_MALFORMED;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-1",50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+1400,MK_T0+1400)==MKT_STALE;
  #assert mk_same(m[0],b);
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-1",50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+1401,MK_T0+1400)==MKT_OK;
  #assert kept_is(m[0].obligation,"ob-1") && m[0].expires_at==MK_T0+1401;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-1",50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_CONFLICT;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-2",50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_CONFLICT;
  #assert m[0].expires_at==MK_T0+1401;
  // A free order pays nothing; a testnet order's invoice is not read here.
  q[0].profile=MKT_FREE;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-3",50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_UNSUPPORTED;
  q[0].profile=MKT_LIGHTNING;q[0].network=MKT_TESTNET;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-3",50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_UNSUPPORTED;
  q[0].network=MKT_BITCOIN;
  n:[1]MktMarket;mk_quoted(n[..],q[..]);n[0].order=0;n[0].accepted=true;n[0].amount_due=50000;
  #assert mkt_instruct(n[..],q[..],MK_PROVIDER,"ob-1",50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_CONFLICT;
}
#test "attempt: persisted before the wallet, one at a time" {
  m:[1]MktMarket;q:[2]MktTerms;mk_accepted(m[..],q[..]);
  #assert mkt_attempt(m[..],q[..],MK_BUYER,1,1000,MK_T0+1500)==MKT_NOT_ACCEPTED;
  #assert mkt_instruct(m[..],q[..],MK_PROVIDER,"ob-1",50000,X402_FIX_INVOICE,X402_FIX_HASH,MK_T0+5000,MK_T0+1400)==MKT_OK;
  #assert mkt_attempt(m[..],q[..],MK_PROVIDER,1,1000,MK_T0+1500)==MKT_NOT_ADMITTED;
  #assert mkt_attempt(m[..],q[..],MK_BUYER,0,1000,MK_T0+1500)==MKT_MALFORMED;
  #assert mkt_attempt(m[..],q[..],MK_BUYER,2,1000,MK_T0+1500)==MKT_MALFORMED;
  #assert mkt_attempt(m[..],q[..],MK_BUYER,1,1001,MK_T0+1500)==MKT_MALFORMED;
  #assert mkt_attempt(m[..],q[..],MK_BUYER,1,999,MK_T0+1500)==MKT_MALFORMED;
  #assert mkt_attempt(m[..],q[..],MK_BUYER,1,1000,MK_T0+5000)==MKT_STALE;
  #assert m[0].attempts==0 && m[0].payment==MKT_NONE;
  #assert mkt_attempt(m[..],q[..],MK_BUYER,1,1000,MK_T0+4999)==MKT_OK && m[0].payment==MKT_PAY_PENDING;
  #assert mkt_attempt(m[..],q[..],MK_BUYER,2,1000,MK_T0+4999)==MKT_PENDING;
  // An unknown outcome keeps the reservation: still no second attempt.
  #assert mkt_result(m[..],MK_BUYER,mk_proof(MKT_RAIL_LIGHTNING,MKT_PAY_UNKNOWN,0,""))==MKT_OK && m[0].payment==MKT_PAY_UNKNOWN;
  #assert mkt_attempt(m[..],q[..],MK_BUYER,2,1000,MK_T0+4999)==MKT_PENDING;
  // A failed outcome lets attempt 2 start.
  #assert mkt_result(m[..],MK_BUYER,mk_proof(MKT_RAIL_LIGHTNING,MKT_PAY_FAILED,0,""))==MKT_OK && m[0].payment==MKT_PAY_FAILED;
  #assert mkt_result(m[..],MK_BUYER,mk_proof(MKT_RAIL_LIGHTNING,MKT_PAY_FAILED,0,""))==MKT_CONFLICT;
  #assert mkt_attempt(m[..],q[..],MK_BUYER,2,1000,MK_T0+4999)==MKT_OK && m[0].attempts==2;
}
#test "result: only a Lightning proof of the exact amount settles" {
  m:[1]MktMarket;q:[2]MktTerms;mk_instructed(m[..],q[..]);
  ok:=mk_proof(MKT_RAIL_LIGHTNING,MKT_PAY_CONFIRMED,50000,X402_FIX_PREIMAGE);
  #assert mkt_result(m[..],MK_BUYER,ok)==MKT_CONFLICT;
  #assert mkt_attempt(m[..],q[..],MK_BUYER,1,1000,MK_T0+1500)==MKT_OK;
  #assert mkt_result(m[..],MK_PROVIDER,ok)==MKT_NOT_ADMITTED;
  for r:[3]int.[MKT_RAIL_ONCHAIN,MKT_RAIL_ZAP,3] {
    x:=ok;x.rail=r;#assert mkt_result(m[..],MK_BUYER,x)==MKT_UNSUPPORTED;
  }
  for st:[3]int.[MKT_NONE,MKT_PAY_PENDING,5] {x:=ok;x.state=st;#assert mkt_result(m[..],MK_BUYER,x)==MKT_MALFORMED;}
  x:=ok;x.amount_msat=50001;#assert mkt_result(m[..],MK_BUYER,x)==MKT_AMOUNT;
  x=ok;x.amount_msat=49999;#assert mkt_result(m[..],MK_BUYER,x)==MKT_AMOUNT;
  x=ok;x.preimage=MK_ZERO;#assert mkt_result(m[..],MK_BUYER,x)==MKT_PROOF;
  x=ok;x.preimage="";#assert mkt_result(m[..],MK_BUYER,x)==MKT_PROOF;
  #assert m[0].payment==MKT_PAY_PENDING && m[0].paid_msat==0;
  // After unknown, conclusive evidence may still settle it.
  #assert mkt_result(m[..],MK_BUYER,mk_proof(MKT_RAIL_LIGHTNING,MKT_PAY_UNKNOWN,0,""))==MKT_OK;
  #assert mkt_result(m[..],MK_BUYER,ok)==MKT_OK && m[0].payment==MKT_PAY_CONFIRMED && m[0].paid_msat==50000;
  #assert mkt_result(m[..],MK_BUYER,mk_proof(MKT_RAIL_LIGHTNING,MKT_PAY_FAILED,0,""))==MKT_PAID && m[0].payment==MKT_PAY_CONFIRMED;
}
