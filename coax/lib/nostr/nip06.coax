// NIP-06: the Nostr key of BIP-39 words at m/44'/1237'/0'/0/0 (no passphrase),
// and its npub. The words account on /login uses it (docs/web-log-in.md).
#load "../crypto/bip39.coax";
#load "../crypto/bip32.coax";
#load "nip19-core.coax";
NIP06_PATH :: [5] int.[2147483692, 2147484885, 2147483648, 0, 0];   // 44', 1237', 0', 0, 0

// The NIP-06 private key of 12, 15, 18, 21 or 24 BIP-39 words; false, with
// key zeroed, for an unknown word, another count or a wrong checksum.
nip06_key :: (phrase: string, key: [] u8) -> bool #export_c {
  if key.count != 32 { return false; }
  seed: [64] u8; chain: [32] u8; e: [32] u8; path := NIP06_PATH;
  ok := bip39_entropy(phrase, e[..]) && bip39_seed(phrase, seed[..]) && bip32_path(seed[..], path[..], key, chain[..]);
  if !ok { for i: 0..<32 { key[i] = 0; } }
  for i: 0..<64 { seed[i] = 0; }
  for i: 0..<32 { chain[i] = 0; e[i] = 0; }
  return ok;
}
// The npub of a private key into out; its length, or -1.
nip06_npub :: (key: [] u8, out: [] u8) -> int #export_c {
  pub: [33] u8;
  if !bip32_public(key, pub[..]) { return -1; }
  r := nip19_encode_checked(N19_NPUB, cast(string) pub[1..<33], out, false);
  return ifx r.error == NC_OK then r.written else -1;
}


#test "nip06_key refuses what bip39_entropy refuses, and zeroes the key" #steps 1000000000 {
  key: [32] u8;
  for i: 0..<32 { key[i] = 7; }
  #assert !nip06_key("leader monkey parrot ring guide accident before fence cannon height naive beauty", key[..]);
  for i: 0..<32 { #assert key[i] == 0; }
  for i: 0..<32 { key[i] = 7; }
  #assert !nip06_key("leader monkey parrot ring guide accident before fence cannon height naive", key[..]);
  #assert key[0] == 0 && key[31] == 0;
  #assert !nip06_key("leader monkey parrot ring guide accident before fence cannon height naive xyzzy", key[..]);
  #assert !nip06_key("", key[..]);
  // a good phrase still gives the NIP-06 vector 1 key
  #assert nip06_key("leader monkey parrot ring guide accident before fence cannon height naive bean", key[..]);
  #assert key[0] == 0x7f && key[1] == 0x7f && key[2] == 0xf0 && key[31] == 0x9a;
}
