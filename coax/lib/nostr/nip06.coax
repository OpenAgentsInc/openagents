// NIP-06: the Nostr key of BIP-39 words at m/44'/1237'/0'/0/0 (no passphrase),
// and its npub. The words account on /login uses it (docs/web-log-in.md).
#load "../crypto/bip39.coax";
#load "../crypto/bip32.coax";
#load "nip19-core.coax";
NIP06_PATH :: [5] int.[2147483692, 2147484885, 2147483648, 0, 0];   // 44', 1237', 0', 0, 0

// The NIP-06 private key of a phrase (any word count; the caller checks the checksum).
nip06_key :: (phrase: string, key: [] u8) -> bool #export_c {
  if key.count != 32 { return false; }
  seed: [64] u8; chain: [32] u8; path := NIP06_PATH;
  ok := bip39_seed(phrase, seed[..]) && bip32_path(seed[..], path[..], key, chain[..]);
  for i: 0..<64 { seed[i] = 0; }
  for i: 0..<32 { chain[i] = 0; }
  return ok;
}
// The npub of a private key into out; its length, or -1.
nip06_npub :: (key: [] u8, out: [] u8) -> int #export_c {
  pub: [33] u8;
  if !bip32_public(key, pub[..]) { return -1; }
  r := nip19_encode_checked(N19_NPUB, cast(string) pub[1..<33], out, false);
  return ifx r.error == NC_OK then r.written else -1;
}

