  alice:=n59_alice();bob:=n59_bob();me:=N59_BOB_PUB;fresh:=n59_fresh(2);work:[NIP59_WORK]u8;wrap:[NIP59_REGION]u8;out:[NIP59_REGION]u8;
  w:=nip59_wrap_checked(alice[..],me[..],N59_NOW,1,N17_BOB_P,"gm",NIP59_WRAP_KIND,fresh[..],work[..],wrap[..],false);
  #assert w.error==NIP59_OK;
  m:=nip17_open(bob[..],me[..],cast(string)wrap[0..<w.written],work[..],out[..]);
  #assert m.error==N17_KIND;for b:out {#assert b==0;}
}
#test "send: Alice to Bob is two wraps, Bob's then her own, of one rumor" #steps 3000000000 {
  alice:=n59_alice();bob:=n59_bob();a:=N59_ALICE_PUB;b:=N59_BOB_PUB;
  lists:[2]NostrEvent;lists[0]=n17_list(b,10050,N17_TWO);lists[1]=n17_list(a,10050,N17_TWO);
  p:=nip17_plan(a[..],b[..],lists[..]);#assert p.error==N17_OK;
  fresh:[2]Nip59Fresh;fresh[0]=n59_fresh(1)[0];fresh[1]=n59_fresh(2)[0];
  work:[NIP59_WORK]u8;out:[8192]u8;
  s:=nip17_send(alice[..],p,N59_NOW,14,"[[\"subject\",\"x\"]]","hi",fresh[..],work[..],out[..],false);
  #assert s.error==N17_OK && s.wraps==2 && s.who== -1 && s.at[0]==0 && s.at[1]==s.n[0] && s.n[0]>1000 && s.n[1]==s.n[0];
  #assert fresh[0].wrap_key[0]==0 && fresh[1].wrap_key[0]==0;
  scratch:[NIP59_REGION]u8;w1:=nostr_event_read(cast(string)out[s.at[1]..<s.at[1]+s.n[1]],scratch[..],false);
  #assert w1.error==NE_OK && w1.kind==1059 && n59_addressed(cast(string)out[s.at[1]+w1.tags_from..<s.at[1]+w1.tags_to],a[..]);
  rumor:[NIP59_REGION]u8;
  m:=nip17_open(bob[..],b[..],cast(string)out[0..<s.n[0]],work[..],rumor[..]);
  #assert m.error==N17_OK && m.members==2 && n59_same32(m.rumor_id[..],s.rumor_id[..]) && m.subject_n==1;
  // Out holds only the first wrap: the second refuses as output, naming Alice, and out is cleared.
  fresh[0]=n59_fresh(1)[0];fresh[1]=n59_fresh(2)[0];
  s=nip17_send(alice[..],p,N59_NOW,14,"[]","hi",fresh[..],work[..],out[0..<s.n[0]],false);
  #assert s.error==N17_OUTPUT && s.wrap_error==NIP59_OUTPUT && s.who==1 && s.wraps==0;for x:out[0..<1000] {#assert x==0;}
  fresh[0]=n59_fresh(1)[0];fresh[1]=n59_fresh(2)[0];
  s=nip17_send(alice[..],p,N59_NOW,14,"[]","hi",fresh[..],work[..],out[..],true);
  #assert s.error==N17_WRAP && s.wrap_error==NIP59_ALIAS && s.who==0 && fresh[1].wrap_key[0]==0;
}
N17_BOB_P :: "[[\"p\",\"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659\"]]";

// ---- the implementation

// book:begin relays
// A participant's kind 10050 relays. e is the newest list found for owner,
// or an unparsed NostrEvent when none was found.
n17_relays :: (e:NostrEvent,owner:[]u8)->N17Relays {
  r:N17Relays;j:[1]Json;
  if !nt_start(j[..],e) {return r;}
  if e.kind!=N17_RELAY_LIST {return n17_list_fail(r,N17_LIST,0);}
  signer:=e.public_key;
  if !n17_same(signer[..],owner) {return n17_list_fail(r,N17_LIST_AUTHOR,0);}
  k:=0;t:=json_next(j[..]);
  while t!=JSON_ARRAY_END {
    if t!=JSON_ARRAY {return n17_list_fail(r,N17_LIST,k);}
    depth:=j[0].depth;t=json_next(j[..]);
    named:=t==JSON_STRING && json_is(json_text(j[..]),"relay");
    if named {
      t=json_next(j[..]);
      if t!=JSON_STRING {return n17_list_fail(r,N17_LIST,k);}
      url:[N17_URL_MOST]u8;n:=json_unescape(json_text(j[..]),url[..]);
      if n== -1 || !relay_uri(cast(string)url[0..<n]).ok {return n17_list_fail(r,N17_LIST,k);}
      at:=r.count;
      for i:0..<r.count {if n17_url(r,i,cast(string)url[0..<n]) {at=i;}}
      if at==N17_RELAYS_MOST {return n17_list_fail(r,N17_LIST,k);}
      if at==r.count {for i:0..<n {r.url[at*N17_URL_MOST+i]=url[i];}r.url_n[at]=n;r.count+=1;}
    }
    // The rest of the tag, whatever it holds.
    while j[0].depth>=depth {if json_next(j[..])==JSON_ERROR {return n17_list_fail(r,N17_LIST,k);}}
    k+=1;t=json_next(j[..]);
  }
  if r.count==0 {return n17_list_fail(r,N17_NO_LIST,0);}
  return n17_list_fail(r,N17_OK,0);
}
// book:end relays
n17_list_fail :: (r:N17Relays,error:int,tag:int)->N17Relays {x:=r;x.error=error;x.tag=tag;return x;}

// book:begin plan
// Who gets a wrap and which relays it goes to. recipients is N 32-byte keys;
// lists holds N+1 kind 10050 events: the recipients' in order, then the
// sender's. Any participant without a usable list refuses the whole plan.
nip17_plan :: (sender_x:[]u8,recipients:[]u8,lists:[]NostrEvent)->N17Plan {
  p:N17Plan;n:=recipients.count/32;
  if sender_x.count!=32 || recipients.count%32!=0 || lists.count!=n+1 {return p;}
  p.error=N17_MEMBERS;
  if n==0 || n>N17_MOST {return p;}
  for i:0..<n {
    for c:0..<32 {p.pub[i*32+c]=recipients[i*32+c];}
    if n17_same(recipients[i*32..<i*32+32],sender_x) {p.who=i;return p;}
    for k:0..<i {if n17_same(recipients[i*32..<i*32+32],recipients[k*32..<k*32+32]) {p.who=i;return p;}}
  }
  for c:0..<32 {p.pub[n*32+c]=sender_x[c];}
  p.recipients=n;
  for i:0..<n+1 {
    p.relays[i]=n17_relays(lists[i],p.pub[i*32..<i*32+32]);
    if p.relays[i].error!=N17_OK {p.error=p.relays[i].error;p.who=i;return p;}
  }
  p.error=N17_OK;return p;
}
// book:end plan

// The first value of the first tag named name, decoded into out: its length,
// N17_ABSENT, or N17_BAD.
n17_value :: (e:NostrEvent,name:string,out:[]u8)->int {
  j:[1]Json;if !nt_start(j[..],e) {return N17_BAD;}
  t:=json_next(j[..]);
  while t!=JSON_ARRAY_END {
    if t!=JSON_ARRAY {return N17_BAD;}
    depth:=j[0].depth;t=json_next(j[..]);
    if t==JSON_STRING && json_is(json_text(j[..]),name) {
      if json_next(j[..])!=JSON_STRING {return N17_BAD;}
      n:=json_unescape(json_text(j[..]),out);
      if n<0 {return N17_BAD;}
      return n;
    }
    while j[0].depth>=depth {if json_next(j[..])==JSON_ERROR {return N17_BAD;}}
    t=json_next(j[..]);
  }
  return N17_ABSENT;
}
// A kind 15's file tags: a type, the aes-gcm algorithm, a key, a nonce and
// the encrypted file's SHA-256 as lowercase hex.
n17_file :: (e:NostrEvent)->bool {
  v:[N17_VALUE_MOST]u8;x:[32]u8;
  if n17_value(e,"file-type",v[..])<=0 {return false;}
  n:=n17_value(e,"encryption-algorithm",v[..]);
  if n!=7 || cast(string)v[0..<7]!="aes-gcm" {return false;}
  if n17_value(e,"decryption-key",v[..])<=0 || n17_value(e,"decryption-nonce",v[..])<=0 {return false;}
  n=n17_value(e,"x",v[..]);
  return n==64 && ne_lower_hex(cast(string)v[0..<64],x[..]);
}
// The caller's own tags for a message: one JSON array that reads, written
// "[]" when empty, with no p tag (the plan names the room), and a kind 15's
// file tags.
n17_extra :: (tags:string,kind:int)->int {
  if tags.count<2 || tags[0]!='[' || tags[tags.count-1]!=']' {return N17_TAGS;}
  e:=nt_event(tags);
  i:=0;t:=nostr_tag(e,0);
  while t.error!=NT_INDEX {
    if t.error!=NT_OK || t.type==NT_P {return N17_TAGS;}
    i+=1;t=nostr_tag(e,i);
  }
  if i==0 && tags!="[]" {return N17_TAGS;}
  if kind==N17_FILE_KIND && !n17_file(e) {return N17_FILE;}
  return N17_OK;
}
// The rumor's tags: ["p", recipient] for each recipient in plan order, then
// the caller's. Returns the length, or -1 when out is too small.
n17_rumor_tags :: (plan:N17Plan,extra:string,out:[]u8)->int {
  p:=plan;n:=json_raw(out,0,"[");
  for i:0..<p.recipients {
    hex:[64]u8;h:=hex_encode_checked(cast(string)p.pub[i*32..<i*32+32],hex[..],false);
    if i>0 {n=json_raw(out,n,",");}
    n=json_raw(out,n,"[\"p\",\"");n=json_raw(out,n,cast(string)hex[0..<h.written]);n=json_raw(out,n,"\"]");
  }
  if extra!="[]" {n=json_raw(out,n,",");n=json_raw(out,n,extra[1..<extra.count-1]);}
  return json_raw(out,n,"]");
}

n17_sent :: (s:N17Sent,error:int,who:int,fresh:[]Nip59Fresh)->N17Sent {
  clean:Nip59Fresh;for i:0..<fresh.count {fresh[i]=clean;}
  r:N17Sent;r.error=error;r.who=who;r.wrap_error=s.wrap_error;return r;
}

// book:begin send
// Seals and wraps one kind 14 or 15 message from sender to every participant
// of plan: wrap i is for participant i, the last for the sender. fresh holds
// one record of host entropy per wrap; every admitted return zeroes all of
// it, and a refusal after the first wrap also zeroes out. tags are the
// caller's own (subject, e for a reply, kind 15's file tags); the p tags
// come from the plan.
nip17_send :: (sender:[]u8,given:N17Plan,now:int,kind:int,tags:string,content:string,fresh:[]Nip59Fresh,work:[]u8,out:[]u8,overlap:bool)->N17Sent {
  s:N17Sent;plan:=given;
  if sender.count!=32 || fresh.count!=plan.recipients+1 {return s;}
  if plan.error!=N17_OK {return n17_sent(s,plan.error,plan.who,fresh);}
  if kind!=N17_CHAT && kind!=N17_FILE_KIND {return n17_sent(s,N17_KIND,-1,fresh);}
  e:=n17_extra(tags,kind);
  if e!=N17_OK {return n17_sent(s,e,-1,fresh);}
  rtags:[N17_TAGS_MOST]u8;t:=n17_rumor_tags(plan,tags,rtags[..]);
  if t== -1 {return n17_sent(s,N17_TAGS,-1,fresh);}
  // The sender's copy must be addressed to the key that signs the seals.
  sender_index:=plan.recipients;
  me:[33]u8;
  if !bip32_public(sender,me[..]) {s.wrap_error=NIP59_KEY;return n17_sent(s,N17_WRAP,sender_index,fresh);}
  if !n17_same(me[1..<33],plan.pub[sender_index*32..<sender_index*32+32]) {return n17_sent(s,N17_MEMBERS,sender_index,fresh);}
  at:=0;
  for i:0..<plan.recipients+1 {
    w:=nip59_wrap_checked(sender,plan.pub[i*32..<i*32+32],now,kind,cast(string)rtags[0..<t],content,NIP59_WRAP_KIND,
                          fresh[i..<i+1],work,out[at..<out.count],overlap);
    if w.error!=NIP59_OK {
      n59_zero(out);s.wrap_error=w.error;
      return n17_sent(s,ifx w.error==NIP59_OUTPUT then N17_OUTPUT else N17_WRAP,i,fresh);
    }
    s.at[i]=at;s.n[i]=w.written;s.rumor_id=w.rumor_id;at+=w.written;
  }
  s.wraps=plan.recipients+1;s.error=N17_OK;return s;
}
// book:end send

// book:begin room
// The room id: SHA-256 of the count members' keys (32 bytes each, in keys)
// sorted ascending. The same set in any order gives the same id.
n17_room :: (keys:[]u8,count:int)->[32]u8 {
  sorted:[(N17_MOST+1)*32]u8;id:[32]u8;
  for i:0..<count*32 {sorted[i]=keys[i];}
  for i:1..<count {
    k:=i;
    while k>0 && n17_less_at(sorted[..],k,k-1) {
      for c:0..<32 {b:=sorted[k*32+c];sorted[k*32+c]=sorted[(k-1)*32+c];sorted[(k-1)*32+c]=b;}
      k-=1;
    }
  }
  if sha256_hash_checked(sorted[0..<count*32],id[..],false)!=SHA_OK {zero:[32]u8;return zero;}
  return id;
}
// book:end room
// Whether 32-byte key i of keys sorts before key k.
n17_less_at :: (keys:[]u8,i:int,k:int)->bool {
  for c:0..<32 {
    if keys[i*32+c]<keys[k*32+c] {return true;}
    if keys[i*32+c]>keys[k*32+c] {return false;}
  }
  return false;
}
// Whether a and b are the same bytes, count included.
n17_same :: (a:[]u8,b:[]u8)->bool {
  if a.count!=b.count {return false;}
  for i:0..<a.count {if a[i]!=b[i] {return false;}}
  return true;
}

// book:begin read
// An opened rumor read as a NIP-17 message for the reader me. rumor is the
// JSON that nip59_unwrap_checked wrote, and o its result.
n17_read :: (o:Nip59Opened,rumor:string,me:[]u8)->N17Message {
  m:N17Message;
  if me.count!=32 {return m;}
  if o.kind!=N17_CHAT && o.kind!=N17_FILE_KIND {m.error=N17_KIND;return m;}
  e:NostrEvent;e.error=NE_OK;e.original=rumor;e.tags_from=o.tags_from;e.tags_to=o.tags_to;
  m.members=1;for c:0..<32 {m.member[c]=o.author[c];}
  i:=0;t:=nostr_tag(e,0);
  while t.error!=NT_INDEX {
    if t.error!=NT_OK {m.error=N17_TAGS;return m;}
    if t.type==NT_P {
      known:=false;
      for k:0..<m.members {if n17_same(m.member[k*32..<k*32+32],t.pubkey[..]) {known=true;}}
      if !known {
        if m.members==N17_MOST+1 {m.error=N17_MEMBERS;return m;}
        for c:0..<32 {m.member[m.members*32+c]=t.pubkey[c];}
        m.members+=1;
      }
    }
    if t.type==NT_E && !m.has_reply {m.has_reply=true;m.reply=t.id;}
    i+=1;t=nostr_tag(e,i);
  }
  m.subject_n=n17_value(e,"subject",m.subject[..]);
  if m.subject_n==N17_BAD {m.error=N17_TAGS;return m;}
  if o.kind==N17_FILE_KIND && !n17_file(e) {m.error=N17_FILE;return m;}
  member:=false;
  for k:0..<m.members {if n17_same(m.member[k*32..<k*32+32],me) {member=true;}}
  if !member {m.error=N17_NOT_MEMBER;return m;}
  m.room=n17_room(m.member[..],m.members);
  m.written=o.written;m.author=o.author;m.rumor_id=o.rumor_id;m.kind=o.kind;m.created_at=o.created_at;
  m.content_from=o.content_from;m.content_to=o.content_to;m.error=N17_OK;
  return m;
}
// book:end read

// Opens a gift wrap as a NIP-17 message for recipient (secret, x-only key).
// out receives the rumor JSON, cleared on any refusal.
nip17_open :: (recipient:[]u8,recipient_x:[]u8,wrap:string,work:[]u8,out:[]u8)->N17Message {
  o:=nip59_unwrap_checked(recipient,recipient_x,wrap,work,out,false);
  if o.error!=NIP59_OK {m:N17Message;m.error=N17_WRAP;m.wrap_error=o.error;return m;}
  m:=n17_read(o,cast(string)out[0..<o.written],recipient_x);
  if m.error!=N17_OK {n59_zero(out);}
  return m;
}

// book:begin order
// The indexes of the opened messages in room, oldest first; equal times by
// rumor id. Returns their count, or -1 when order is too small.
nip17_order :: (m:[]N17Message,room:[]u8,order:[]int)->int {
  n:=0;
  for i:0..<m.count {
    if m[i].error!=N17_OK || !n17_same(m[i].room[..],room) {continue;}
    if n==order.count {return -1;}
    k:=n;order[n]=i;n+=1;
    while k>0 && n17_before(m[order[k]],m[order[k-1]]) {x:=order[k];order[k]=order[k-1];order[k-1]=x;k-=1;}
  }
  return n;
}
// book:end order
n17_before :: (a:N17Message,b:N17Message)->bool {
  if a.created_at<b.created_at {return true;}
  if a.created_at>b.created_at {return false;}
  ids:[64]u8;for c:0..<32 {ids[c]=a.rumor_id[c];ids[32+c]=b.rumor_id[c];}
  return n17_less_at(ids[..],0,1);
}
// The message in order whose subject names the room now: the newest one
// with a subject tag, or -1.
nip17_subject :: (m:[]N17Message,order:[]int)->int {
  for k:0..<order.count {i:=order[order.count-1-k];if m[i].subject_n>=0 {return i;}}
  return -1;
}
