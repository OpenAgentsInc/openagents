  m:=nip17_open(bob[..],me[..],cast(string)wrap[..],work[..],out[..]);
  #assert m.error==N17_OK && m.kind==14 && m.members==2 && n59_same32(m.author[..],alice[..]);
  #assert cast(string)out[m.content_from..<m.content_to]=="Bob: the decision job is ready." && m.written>0;
  keys:[64]u8;for i:0..<32 {keys[i]=me[i];keys[32+i]=alice[i];}
  room:=n17_room(keys[..],2);#assert n59_same32(m.room[..],room[..]);
}
