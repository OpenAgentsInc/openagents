  clean=(work[0].sign[0].check[0].affine[0].finite==0) && clean;
  clean=(work[0].sign[0].check[0].affine[0].even==0) && clean;
  clean=crypto_zeroed(work[0].sign[0].message[..]) && clean;
  clean=crypto_zeroed(work[0].pub[..]) && clean;
  clean=crypto_zeroed(work[0].id[..]) && clean;
  clean=crypto_zeroed(work[0].sig[..]) && clean;
  return clean;
}
