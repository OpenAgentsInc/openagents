  clean=crypto_zeroed(work[0].sign[0].prep[0].point[0].inverse.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].prep[0].point[0].z2.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].prep[0].point[0].z3.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].prep[0].point[0].x.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].prep[0].point[0].y.limb[..]) && clean;
  clean=(work[0].sign[0].prep[0].point[0].finite==0) && clean;
  clean=(work[0].sign[0].prep[0].point[0].odd==0) && clean;
  clean=crypto_zeroed(work[0].sign[0].prep[0].public_key[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].prep[0].normalized[..]) && clean;
  clean=(work[0].sign[0].prep[0].valid==0) && clean;
  clean=crypto_zeroed(work[0].sign[0].nonce[0].hash_work[0].sha[0].h[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].nonce[0].hash_work[0].sha[0].block[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].nonce[0].hash_work[0].sha[0].schedule[..]) && clean;
  clean=(work[0].sign[0].nonce[0].hash_work[0].sha[0].total==0) && clean;
  clean=(work[0].sign[0].nonce[0].hash_work[0].sha[0].used==0) && clean;
  clean=(work[0].sign[0].nonce[0].hash_work[0].sha[0].phase==0) && clean;
  clean=crypto_zeroed(work[0].sign[0].nonce[0].hash_work[0].tag[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].nonce[0].hash_work[0].digest[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].nonce[0].hash_work[0].t[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].nonce[0].point[0].projective.x.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].nonce[0].point[0].projective.y.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].nonce[0].point[0].projective.z.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].nonce[0].point[0].inverse.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].nonce[0].point[0].z2.limb[..]) && clean;
