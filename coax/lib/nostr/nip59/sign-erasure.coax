  secure_zero(work[0].sign[0].check[0].affine[0].x.limb[..]);
  work[0].sign[0].check[0].affine[0].finite=0;
  work[0].sign[0].check[0].affine[0].even=0;
  secure_zero(work[0].sign[0].message[..]);
  secure_zero(work[0].pub[..]);
  secure_zero(work[0].id[..]);
  secure_zero(work[0].sig[..]);
}
