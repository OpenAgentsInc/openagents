  if field==52 {work[0].sign[0].math[0].valid=1;}
  if field==53 {work[0].sign[0].challenge[31]=1;}
  if field==54 {work[0].sign[0].sig[63]=1;}
  if field==55 {work[0].sign[0].check[0].stage=1;}
  if field==56 {work[0].sign[0].check[0].bound=1;}
  if field==57 {work[0].sign[0].check[0].key[31]=1;}
  if field==58 {work[0].sign[0].check[0].candidate[63]=1;}
  if field==59 {work[0].sign[0].check[0].peer.x.limb[9]=1;}
  if field==60 {work[0].sign[0].check[0].peer.y.limb[9]=1;}
  if field==61 {work[0].sign[0].check[0].peer.z.limb[9]=1;}
  if field==62 {work[0].sign[0].check[0].tag[31]=1;}
  if field==63 {work[0].sign[0].check[0].sha[0].h[7]=1;}
  if field==64 {work[0].sign[0].check[0].sha[0].block[63]=1;}
  if field==65 {work[0].sign[0].check[0].sha[0].schedule[63]=1;}
  if field==66 {work[0].sign[0].check[0].sha[0].total=1;}
  if field==67 {work[0].sign[0].check[0].sha[0].used=1;}
  if field==68 {work[0].sign[0].check[0].sha[0].phase=1;}
  if field==69 {work[0].sign[0].check[0].digest[31]=1;}
  if field==70 {work[0].sign[0].check[0].r[0].value.limb[7]=1;}
  if field==71 {work[0].sign[0].check[0].r[0].below=1;}
  if field==72 {work[0].sign[0].check[0].s[0].value.limbs[7]=1;}
  if field==73 {work[0].sign[0].check[0].s[0].below=1;}
  if field==74 {work[0].sign[0].check[0].negative_e.limbs[7]=1;}
  if field==75 {work[0].sign[0].check[0].sg.x.limb[7]=1;}
  if field==76 {work[0].sign[0].check[0].sg.y.limb[7]=1;}
  if field==77 {work[0].sign[0].check[0].sg.z.limb[7]=1;}
  if field==78 {work[0].sign[0].check[0].ep.x.limb[7]=1;}
  if field==79 {work[0].sign[0].check[0].ep.y.limb[7]=1;}
  if field==80 {work[0].sign[0].check[0].ep.z.limb[7]=1;}
  if field==81 {work[0].sign[0].check[0].sum.x.limb[7]=1;}
  if field==82 {work[0].sign[0].check[0].sum.y.limb[7]=1;}
  if field==83 {work[0].sign[0].check[0].sum.z.limb[7]=1;}
  if field==84 {work[0].sign[0].check[0].affine[0].x.limb[7]=1;}
  if field==85 {work[0].sign[0].check[0].affine[0].finite=1;}
  if field==86 {work[0].sign[0].check[0].affine[0].even=1;}
  if field==87 {work[0].sign[0].message[31]=1;}
  if field==88 {work[0].pub[31]=1;}
  if field==89 {work[0].id[31]=1;}
  if field==90 {work[0].sig[63]=1;}
  #assert !n59_sign_zeroed(work[..]);n59_erase_sign(work[..]);#assert n59_sign_zeroed(work[..]);
}
n59_sign_zeroed :: (work:[]NostrSignWork)->bool #effects(all) {
  clean:=true;
  clean=(work[0].stage==0) && clean;
  clean=(work[0].sign[0].stage==0) && clean;
  clean=crypto_zeroed(work[0].sign[0].prep[0].key[0].raw.limbs[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].prep[0].key[0].safe.limbs[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].prep[0].key[0].wide[..]) && clean;
  clean=(work[0].sign[0].prep[0].key[0].valid==0) && clean;
  clean=crypto_zeroed(work[0].sign[0].prep[0].point[0].projective.x.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].prep[0].point[0].projective.y.limb[..]) && clean;
