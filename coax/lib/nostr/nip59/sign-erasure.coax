  clean=crypto_zeroed(work[0].sign[0].math[0].adjusted_nonce.limbs[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].math[0].result.limbs[..]) && clean;
  clean=(work[0].sign[0].math[0].valid==0) && clean;
  clean=crypto_zeroed(work[0].sign[0].challenge[..]) && clean;
