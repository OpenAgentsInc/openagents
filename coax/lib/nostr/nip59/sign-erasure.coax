// Explicit named signing workspace cleanup for NIP-59 ownership. Numeric
// arrays use observable erasure; public stage/validity counters reset to zero.
#load "../event_sign.coax";
#authority;

#forall "every signing workspace field is erased on retirement" field:0..<91 {
  work:[1]NostrSignWork;#assert n59_sign_zeroed(work[..]);
  if field==0 {work[0].stage=1;}
  if field==1 {work[0].sign[0].stage=1;}
  if field==2 {work[0].sign[0].prep[0].key[0].raw.limbs[7]=1;}
  if field==3 {work[0].sign[0].prep[0].key[0].safe.limbs[7]=1;}
  if field==4 {work[0].sign[0].prep[0].key[0].wide[8]=1;}
  if field==5 {work[0].sign[0].prep[0].key[0].valid=1;}
  if field==6 {work[0].sign[0].prep[0].point[0].projective.x.limb[7]=1;}
  if field==7 {work[0].sign[0].prep[0].point[0].projective.y.limb[7]=1;}
  if field==8 {work[0].sign[0].prep[0].point[0].projective.z.limb[7]=1;}
  if field==9 {work[0].sign[0].prep[0].point[0].inverse.limb[7]=1;}
  if field==10 {work[0].sign[0].prep[0].point[0].z2.limb[7]=1;}
  if field==11 {work[0].sign[0].prep[0].point[0].z3.limb[7]=1;}
  if field==12 {work[0].sign[0].prep[0].point[0].x.limb[7]=1;}
  if field==13 {work[0].sign[0].prep[0].point[0].y.limb[7]=1;}
  if field==14 {work[0].sign[0].prep[0].point[0].finite=1;}
  if field==15 {work[0].sign[0].prep[0].point[0].odd=1;}
  if field==16 {work[0].sign[0].prep[0].public_key[31]=1;}
  if field==17 {work[0].sign[0].prep[0].normalized[31]=1;}
  if field==18 {work[0].sign[0].prep[0].valid=1;}
  if field==19 {work[0].sign[0].nonce[0].hash_work[0].sha[0].h[7]=1;}
  if field==20 {work[0].sign[0].nonce[0].hash_work[0].sha[0].block[63]=1;}
  if field==21 {work[0].sign[0].nonce[0].hash_work[0].sha[0].schedule[63]=1;}
  if field==22 {work[0].sign[0].nonce[0].hash_work[0].sha[0].total=1;}
  if field==23 {work[0].sign[0].nonce[0].hash_work[0].sha[0].used=1;}
  if field==24 {work[0].sign[0].nonce[0].hash_work[0].sha[0].phase=1;}
  if field==25 {work[0].sign[0].nonce[0].hash_work[0].tag[31]=1;}
  if field==26 {work[0].sign[0].nonce[0].hash_work[0].digest[31]=1;}
  if field==27 {work[0].sign[0].nonce[0].hash_work[0].t[31]=1;}
  if field==28 {work[0].sign[0].nonce[0].point[0].projective.x.limb[7]=1;}
  if field==29 {work[0].sign[0].nonce[0].point[0].projective.y.limb[7]=1;}
  if field==30 {work[0].sign[0].nonce[0].point[0].projective.z.limb[7]=1;}
  if field==31 {work[0].sign[0].nonce[0].point[0].inverse.limb[7]=1;}
  if field==32 {work[0].sign[0].nonce[0].point[0].z2.limb[7]=1;}
  if field==33 {work[0].sign[0].nonce[0].point[0].z3.limb[7]=1;}
  if field==34 {work[0].sign[0].nonce[0].point[0].x.limb[7]=1;}
  if field==35 {work[0].sign[0].nonce[0].point[0].y.limb[7]=1;}
  if field==36 {work[0].sign[0].nonce[0].point[0].finite=1;}
  if field==37 {work[0].sign[0].nonce[0].point[0].odd=1;}
  if field==38 {work[0].sign[0].nonce[0].hash[31]=1;}
  if field==39 {work[0].sign[0].nonce[0].safe.limbs[7]=1;}
  if field==40 {work[0].sign[0].nonce[0].r[31]=1;}
  if field==41 {work[0].sign[0].nonce[0].nonce_valid=1;}
  if field==42 {work[0].sign[0].nonce[0].valid=1;}
  if field==43 {work[0].sign[0].math[0].key[0].raw.limbs[7]=1;}
  if field==44 {work[0].sign[0].math[0].key[0].safe.limbs[7]=1;}
  if field==45 {work[0].sign[0].math[0].key[0].wide[8]=1;}
  if field==46 {work[0].sign[0].math[0].key[0].valid=1;}
