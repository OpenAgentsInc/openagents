  clean=(work[0].sign[0].nonce[0].point[0].finite==0) && clean;
  clean=(work[0].sign[0].nonce[0].point[0].odd==0) && clean;
  clean=crypto_zeroed(work[0].sign[0].nonce[0].hash[..]) && clean;
