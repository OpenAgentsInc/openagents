  clean=crypto_zeroed(work[0].sign[0].check[0].sg.y.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].sg.z.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].ep.x.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].ep.y.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].ep.z.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].sum.x.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].sum.y.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].sum.z.limb[..]) && clean;
