  clean=crypto_zeroed(work[0].sign[0].check[0].peer.z.limb[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].tag[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].sha[0].h[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].sha[0].block[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].sha[0].schedule[..]) && clean;
  clean=(work[0].sign[0].check[0].sha[0].total==0) && clean;
  clean=(work[0].sign[0].check[0].sha[0].used==0) && clean;
  clean=(work[0].sign[0].check[0].sha[0].phase==0) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].digest[..]) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].r[0].value.limb[..]) && clean;
  clean=(work[0].sign[0].check[0].r[0].below==0) && clean;
  clean=crypto_zeroed(work[0].sign[0].check[0].s[0].value.limbs[..]) && clean;
  clean=(work[0].sign[0].check[0].s[0].below==0) && clean;
