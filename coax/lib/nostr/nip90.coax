#test "millisats: decimal digits up to 21 million bitcoin" {
  #assert n90_msats("0")==0 && n90_msats("1")==1 && n90_msats("9")==9 && n90_msats("10000")==10000;
  #assert n90_msats("2100000000000000000")==N90_MAX_MSATS && n90_msats("2100000000000000001")== -1 && n90_msats("2099999999999999999")==N90_MAX_MSATS-1;
  #assert n90_msats("")== -1 && n90_msats("00")== -1 && n90_msats("01")== -1 && n90_msats("-1")== -1 && n90_msats("1a")== -1;
  #assert n90_msats("/")== -1 && n90_msats(":")== -1 && n90_msats("99999999999999999999")== -1 && n90_msats(" 1")== -1;
}
#test "invoice amounts: currency, digits and multiplier" {
  #assert n90_invoice("lnbc50n1pxyz")==5000 && n90_invoice("lnbc2500u1qq")==250000000 && n90_invoice("lnbc1m1q")==100000000 && n90_invoice("lnbc9n1q")==900;
  #assert n90_invoice("lnbc10p1q")==1 && n90_invoice("lnbc20p1q")==2 && n90_invoice("lnbc1p1q")== -5 && n90_invoice("lnbc15p1q")== -5;
  #assert n90_invoice("lnbc31qq")==300000000000 && n90_invoice("lntb50n1q")==5000 && n90_invoice("lntbs50n1q")==5000 && n90_invoice("lnbcrt50n1q")==5000;
  // The separator: the last 1, not the first byte.
  #assert n90_invoice("nope")== -1 && n90_invoice("")== -1 && n90_invoice("1abc")== -1 && n90_invoice("lnbc50n")== -1 && n90_invoice("lnbc50n1")==5000;
  #assert n90_invoice("x1q")== -2 && n90_invoice("51q")== -3 && n90_invoice("lnbc1q")== -2 && n90_invoice("lnbcn1q")== -2 && n90_invoice("lnbc50x1q")== -2 && n90_invoice("lnbc5/n1q")== -2 && n90_invoice("lnbc5:n1q")== -2;
  #assert n90_invoice("lnltc50n1q")== -3 && n90_invoice("xlnbc50n1q")== -3 && n90_invoice("LNBC50N1Q")== -2 && n90_invoice("21qq")== -3 && n90_invoice("lnbcr50n1q")== -3;
  #assert n90_invoice("lnbc050n1q")== -4 && n90_invoice("lnbc0n1q")== -4 && n90_invoice("lnbc01q")== -4;
  // The largest amount for each multiplier, and one more.
  #assert n90_invoice("lnbc210000001qq")==N90_MAX_MSATS && n90_invoice("lnbc210000011qq")== -6 && n90_invoice("lnbc210000021qq")== -6 && n90_invoice("lnbc2099999911qq")== -6;
  #assert n90_invoice("lnbc21000000000m1q")==N90_MAX_MSATS && n90_invoice("lnbc21000000001m1q")== -6;
  #assert n90_invoice("lnbc21000000000000u1q")==N90_MAX_MSATS && n90_invoice("lnbc21000000000001u1q")== -6;
  #assert n90_invoice("lnbc21000000000000000n1q")==N90_MAX_MSATS && n90_invoice("lnbc21000000000000001n1q")== -6;
  #assert n90_invoice("lnbc2100000000000000000p1q")==210000000000000000 && n90_invoice("lnbc2100000000000000001p1q")== -6 && n90_invoice("lnbc2099999999999999990p1q")==209999999999999999;
}
