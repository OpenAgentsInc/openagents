  r:=n90_request(e);
  #assert r.error==N90_OK && r.at== -1 && r.kind==5050 && r.ni==1 && r.inputs[0].type==N90_TEXT && n32_is(r.inputs[0].data,"What is the capital of France?");
  #assert r.inputs[0].relay.n==0 && r.inputs[0].marker.n==0 && r.np==1 && n32_is(r.params[0].key,"model") && n32_is(r.params[0].value,"LLaMA-2");
  #assert n32_is(r.output,"text/plain") && r.bid==10000 && r.relays==1 && r.nproviders==1 && r.providers[0][0]==0x22 && r.providers[0][31]==0x22 && !r.encrypted;
  // Every input type; an event input with a relay and a marker.
