  #assert r.error==N90_OK && r.kind==5000 && r.ni==4 && r.inputs[0].type==N90_URL && r.inputs[1].type==N90_EVENT_ID && r.inputs[2].type==N90_JOB && r.inputs[3].type==N90_TEXT;
  #assert r.inputs[1].id[0]==0xaa && r.inputs[2].id[31]==0xbb && n32_is(r.inputs[1].relay,"wss://r.example") && n32_is(r.inputs[1].marker,"source");
  #assert r.inputs[3].relay.n==0 && n32_is(r.inputs[3].marker,"prompt") && r.relays==2 && r.bid== -1 && r.np==0 && r.output.n==0 && r.nproviders==0;
  #assert n90_request(n32_event(5999,"[]")).error==N90_OK;
}
#test "request refusals" {
  #assert n90_request(n32_event(4999,"[]")).error==N90_KIND && n90_request(n32_event(6000,"[]")).error==N90_KIND && n90_request(n32_event(7000,"[]")).at== -1;
  none:NostrEvent;#assert n90_request(none).error==N90_EVENT;
  r:=n90_request(n32_event(5050,"[[\"t\",\"x\"],[\"i\",\"x\",\"file\"]]"));#assert r.error==N90_INPUT && r.at==1;
  #assert n90_request(n32_event(5050,"[[\"i\",\"x\"]]")).error==N90_INPUT;
  #assert n90_request(n32_event(5050,"[[\"i\",\"aaaa\",\"event\"]]")).error==N90_INPUT && n90_request(n32_event(5050,"[[\"i\",\"aaaa\",\"job\"]]")).error==N90_INPUT;
  #assert n90_request(n32_event(5050,"[[\"i\",\"x\",\"text\",\"https://r.example\"]]")).error==N90_INPUT;
  #assert n90_request(n32_event(5050,"[[\"i\",\"x\",\"text\",\"wss://r\"]]")).error==N90_OK && n90_request(n32_event(5050,"[[\"i\",\"x\",\"text\",\"x\"]]")).error==N90_INPUT;
  long:[700]u8;n:=json_raw(long[..],0,"[[\"i\",\"x\",\"text\",\"wss://");for i:0..<257 {long[n+i]='x';}n+=257;n=json_raw(long[..],n,"\"]]");
  #assert n90_request(n32_event(5050,cast(string)long[0..<n])).error==N90_INPUT;
  n=json_raw(long[..],0,"[[\"i\",\"x\",\"text\",\"\",\"");for i:0..<257 {long[n+i]='x';}n+=257;n=json_raw(long[..],n,"\"]]");
  #assert n90_request(n32_event(5050,cast(string)long[0..<n])).error==N90_INPUT;
  n=json_raw(long[..],0,"[[\"i\",\"");for i:0..<257 {long[n+i]='x';}n+=257;n=json_raw(long[..],n,"\",\"text\"]]");
  r=n90_request(n32_event(5050,cast(string)long[0..<n]));#assert r.error==N90_LIMIT && r.at==0;
  #assert n90_request(n32_event(5050,"[[\"t\",1]]")).error==N90_EVENT && n90_request(n32_event(5050,"[[\"t\"],[]]")).at==1;
  many:[1024]u8;m:=json_raw(many[..],0,"[[\"t\",\"x\"]");
  for k:0..<8 {m=json_raw(many[..],m,",[\"i\",\"x\",\"text\"]");}
  full:=json_raw(many[..],m,"]");#assert n90_request(n32_event(5050,cast(string)many[0..<full])).ni==8;
  m=json_raw(many[..],m,",[\"i\",\"x\",\"text\"]]");r=n90_request(n32_event(5050,cast(string)many[0..<m]));#assert r.error==N90_LIMIT && r.at==9 && r.ni==8;
  m=json_raw(many[..],0,"[");
  for k:0..<8 {m=json_raw(many[..],m,"[\"param\",\"k\",\"v\"],");}
  full=json_raw(many[..],m,"[\"t\"]]");#assert n90_request(n32_event(5050,cast(string)many[0..<full])).np==8;
  m=json_raw(many[..],m,"[\"param\",\"k\",\"v\"]]");r=n90_request(n32_event(5050,cast(string)many[0..<m]));#assert r.error==N90_LIMIT && r.at==8 && r.np==8;
  r=n90_request(n32_event(5050,"[[\"param\",\"k\"]]"));#assert r.error==N90_PARAM && r.at==0;
  #assert n90_request(n32_event(5050,"[[\"param\",\"\",\"v\"]]")).error==N90_PARAM;
  r=n90_request(n32_event(5050,"[[\"param\",\"k\",\"\"]]"));#assert r.error==N90_OK && r.np==1 && r.params[0].value.n==0;
  r=n90_request(n32_event(5050,"[[\"output\",\"\"]]"));#assert r.error==N90_TAG && r.at==0;
  r=n90_request(n32_event(5050,"[[\"output\",\"a\"],[\"output\",\"b\"]]"));#assert r.error==N90_TAG && r.at==1;
  r=n90_request(n32_event(5050,"[[\"bid\",\"5\"],[\"bid\",\"5\"]]"));#assert r.error==N90_BID && r.at==1;
  r=n90_request(n32_event(5050,"[[\"bid\",\"0\"],[\"bid\",\"5\"]]"));#assert r.error==N90_BID && r.at==1;
  #assert n90_request(n32_event(5050,"[[\"bid\",\"abc\"]]")).error==N90_BID && n90_request(n32_event(5050,"[[\"bid\"]]")).error==N90_BID;
  #assert n90_request(n32_event(5050,"[[\"bid\",\"0\"]]")).bid==0;
  r=n90_request(n32_event(5050,"[[\"t\"],[\"p\",\"22\"]]"));#assert r.error==N90_TAG && r.at==1;
  m=json_raw(many[..],0,"[");
  for k:0..<4 {m=json_raw(many[..],m,"[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"],");}
  full=json_raw(many[..],m,"[\"t\"]]");#assert n90_request(n32_event(5050,cast(string)many[0..<full])).nproviders==4;
  m=json_raw(many[..],m,"[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"]]");
  r=n90_request(n32_event(5050,cast(string)many[0..<m]));#assert r.error==N90_LIMIT && r.at==4;
}
#test "encrypted requests: one provider, no clear inputs, never NIP-04" {
  b:[4096]u8;
  e:=n90_t_event(0x11,1000,5050,"[[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"],[\"encrypted\"]]","AgcHBwcH",b[..]);
  r:=n90_request(e);#assert r.error==N90_OK && r.encrypted && r.nproviders==1;
  e=n90_t_event(0x11,1000,5050,"[[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"],[\"encrypted\"]]","zooMmtdlrlTCiIbfLqTqYrpCbTWrcVkP7RdcqCuM8TQ=?iv=obLD1OX2BxgpOktcbX6PkA==",b[..]);
  r=n90_request(e);#assert r.error==N90_NIP04 && r.at== -1;
  r=n90_request(n32_event(5050,"[[\"encrypted\"]]"));#assert r.error==N90_ENCRYPTED && r.at== -1;
  #assert n90_request(n32_event(5050,"[[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"],[\"p\",\"3333333333333333333333333333333333333333333333333333333333333333\"],[\"encrypted\"]]")).error==N90_ENCRYPTED;
  #assert n90_request(n32_event(5050,"[[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"],[\"encrypted\"],[\"i\",\"x\",\"text\"]]")).error==N90_ENCRYPTED;
  #assert n90_request(n32_event(5050,"[[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"],[\"encrypted\"],[\"param\",\"k\",\"v\"]]")).error==N90_ENCRYPTED;
  // Without the encrypted tag a ? in the content is just content.
  e=n90_t_event(0x11,1000,5050,"[]","why?",b[..]);#assert n90_request(e).error==N90_OK;
}
#test "NIP-90's encrypted params example reads as a tag list" {
  plain:="[[\"i\",\"what is the capital of France? \",\"text\"],[\"param\",\"model\",\"LLaMA-2\"],[\"param\",\"max_tokens\",\"512\"],[\"param\",\"temperature\",\"0.5\"],[\"param\",\"top-k\",\"50\"],[\"param\",\"top-p\",\"0.7\"],[\"param\",\"frequency_penalty\",\"1\"]]";
  r:=n90_request(n32_event(5050,plain));
  #assert r.error==N90_OK && r.ni==1 && r.np==6 && n32_is(r.params[5].key,"frequency_penalty") && n32_is(r.params[1].value,"512");
  // The same list sealed with NIP-44 and opened by the provider.
  sealed:[4096]u8;sn:=n90_t_seal(0x5a,plain,sealed[..]);
  b:[8192]u8;e:=n90_t_event(0x11,1000,5050,"[[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"],[\"bid\",\"9\"],[\"encrypted\"]]",cast(string)sealed[0..<sn],b[..]);
  outer:=n90_request(e);#assert outer.error==N90_OK && outer.encrypted && outer.ni==0;
  ck:=n90_t_key(0x5a);work:[8192]u8;out:[4096]u8;
  o:=n90_private(e,outer,ck[..],work[..],out[..]);
  #assert o.error==N90_OK && o.encrypted && o.ni==1 && o.np==6 && o.bid==9 && o.nproviders==1 && n32_is(o.params[0].value,"LLaMA-2") && n32_is(o.inputs[0].data,"what is the capital of France? ");
  wrong:=n90_t_key(0x5b);o=n90_private(e,outer,wrong[..],work[..],out[..]);#assert o.error==N90_DECRYPT && o.at== -1;
  clear:=n90_request(n32_event(5050,"[[\"t\"]]"));o=n90_private(e,clear,ck[..],work[..],out[..]);#assert o.error==N90_ENCRYPTED && o.at== -1;
  bad:N90Request;bad.encrypted=true;#assert n90_private(e,bad,ck[..],work[..],out[..]).error==N90_ENCRYPTED;
  // The inner list must itself read, and not be encrypted again.
  sn=n90_t_seal(0x5a,"[[\"i\",\"x\",\"file\"]]",sealed[..]);
  e=n90_t_event(0x11,1000,5050,"[[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"],[\"encrypted\"]]",cast(string)sealed[0..<sn],b[..]);
  o=n90_private(e,n90_request(e),ck[..],work[..],out[..]);#assert o.error==N90_INPUT && o.at==0;
  sn=n90_t_seal(0x5a,"[[\"encrypted\"],[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"]]",sealed[..]);
  e=n90_t_event(0x11,1000,5050,"[[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"],[\"encrypted\"]]",cast(string)sealed[0..<sn],b[..]);
  o=n90_private(e,n90_request(e),ck[..],work[..],out[..]);#assert o.error==N90_ENCRYPTED && o.at== -1;
}
#test "results and feedback: e, p, amount, status, request" {
  r:=n90_reply(n32_event(6050,"[[\"request\",\"{}\"],[\"e\",\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"wss://r.example\"],[\"i\",\"x\",\"text\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"amount\",\"5000\",\"lnbc50n1pxyz\"]]"));
  #assert r.error==N90_OK && r.at== -1 && r.kind==6050 && r.status== -1 && r.request[0]==0xaa && r.customer[31]==0x11 && r.amount==5000 && r.request_tag==0 && !r.encrypted;
  #assert cast(string)r.bolt11[0..<r.bolt11_n]=="lnbc50n1pxyz";
  f:=n90_reply(n32_event(7000,"[[\"status\",\"partial\",\"half done\"],[\"e\",\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"encrypted\"]]"));
  #assert f.error==N90_OK && f.kind==7000 && f.status==N90_PARTIAL && n32_is(f.extra,"half done") && f.amount== -1 && f.bolt11_n==0 && f.request_tag== -1 && f.encrypted;
  for k:0..<5 {
    buf:[512]u8;n:=json_raw(buf[..],0,"[[\"e\",\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"status\",\"");
    n=json_raw(buf[..],n,N90_STATUS_NAMES[k]);n=json_raw(buf[..],n,"\"],[\"amount\",\"0\"]]");
    s:=n90_reply(n32_event(7000,cast(string)buf[0..<n]));#assert s.error==N90_OK && s.status==k && s.amount==0 && s.extra.n==0;
  }
  #assert n90_reply(n32_event(6000,"[[\"request\",\"\"],[\"e\",\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"]]")).error==N90_OK;
  #assert n90_reply(n32_event(6999,"[[\"request\",\"\"],[\"e\",\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"]]")).error==N90_OK;
}
#test "reply refusals" {
  E:="[\"e\",\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"]";P:="[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"]";
  #assert n90_reply(n32_event(5999,"[]")).error==N90_KIND && n90_reply(n32_event(7001,"[]")).error==N90_KIND && n90_reply(n32_event(5050,"[]")).at== -1;
  none:NostrEvent;#assert n90_reply(none).error==N90_EVENT;
  b:[1600]u8;
  r:=n90_reply(n32_event_in(7000,"[[\"status\",\"error\"],[\"e\",\"aaaa\"]]",b[..]));#assert r.error==N90_TAG && r.at==1;
  t:=json_raw(b[..],0,"[[\"status\",\"error\"],");t=json_raw(b[..],t,E);t=json_raw(b[..],t,",");t=json_raw(b[..],t,E);t=json_raw(b[..],t,"]");
  r=n90_reply(n32_event(7000,cast(string)b[0..<t]));#assert r.error==N90_TAG && r.at==2;
  t=json_raw(b[..],0,"[[\"status\",\"error\"],");t=json_raw(b[..],t,E);t=json_raw(b[..],t,",");t=json_raw(b[..],t,P);t=json_raw(b[..],t,",");t=json_raw(b[..],t,P);t=json_raw(b[..],t,"]");
  r=n90_reply(n32_event(7000,cast(string)b[0..<t]));#assert r.error==N90_TAG && r.at==3;
  r=n90_reply(n32_event(7000,"[[\"status\",\"error\"],[\"p\",\"11\"]]"));#assert r.error==N90_TAG && r.at==1;
  r=n90_reply(n32_event(7000,"[[\"status\",\"error\"],[\"amount\",\"x\"]]"));#assert r.error==N90_AMOUNT && r.at==1;
  r=n90_reply(n32_event(7000,"[[\"amount\",\"0\"],[\"amount\",\"5\"]]"));#assert r.error==N90_AMOUNT && r.at==1;
  t=json_raw(b[..],0,"[[\"amount\",\"5\",\"lnbc");for i:0..<1021 {b[t+i]='q';}t+=1021;t=json_raw(b[..],t,"\"]]");
  r=n90_reply(n32_event(7000,cast(string)b[0..<t]));#assert r.error==N90_LIMIT && r.at==0;
  t=json_raw(b[..],0,"[");t=json_raw(b[..],t,E);t=json_raw(b[..],t,",");t=json_raw(b[..],t,P);t=json_raw(b[..],t,",[\"amount\",\"5\",\"lnbc");for i:0..<1020 {b[t+i]='q';}t+=1020;t=json_raw(b[..],t,"\"],[\"status\",\"error\"]]");
  r=n90_reply(n32_event(7000,cast(string)b[0..<t]));#assert r.error==N90_OK && r.bolt11_n==1024;
  r=n90_reply(n32_event(7000,"[[\"t\"],[\"status\",\"done\"]]"));#assert r.error==N90_STATUS && r.at==1;
  r=n90_reply(n32_event(7000,"[[\"status\",\"payment-required\"],[\"status\",\"error\"]]"));#assert r.error==N90_STATUS && r.at==1;
  r=n90_reply(n32_event(6050,"[[\"status\",\"success\"]]"));#assert r.error==N90_STATUS && r.at==0;
  t=json_raw(b[..],0,"[");t=json_raw(b[..],t,E);t=json_raw(b[..],t,",");t=json_raw(b[..],t,P);t=json_raw(b[..],t,"]");
  r=n90_reply(n32_event(7000,cast(string)b[0..<t]));#assert r.error==N90_STATUS && r.at== -1;
  r=n90_reply(n32_event(6050,cast(string)b[0..<t]));#assert r.error==N90_REQUEST && r.at== -1;
  r=n90_reply(n32_event(6050,"[[\"request\",\"{}\"],[\"request\",\"{}\"]]"));#assert r.error==N90_REQUEST && r.at==1;
  r=n90_reply(n32_event(7000,"[[\"status\",\"error\"]]"));#assert r.error==N90_NO_E && r.at== -1;
  r=n90_reply(n32_event(7000,"[[\"amount\",1]]"));#assert r.error==N90_EVENT && r.at==0;
  t=json_raw(b[..],0,"[[\"status\",\"error\"],");t=json_raw(b[..],t,E);t=json_raw(b[..],t,"]");
  r=n90_reply(n32_event(7000,cast(string)b[0..<t]));#assert r.error==N90_P && r.at== -1;
  #assert n90_reply(n32_event(7000,"[[\"t\",1]]")).error==N90_EVENT && n90_reply(n32_event(7000,"[[\"t\"],[]]")).at==1;
  t=json_raw(b[..],0,"[[\"t\"],[\"status\",\"");for i:0..<257 {b[t+i]='x';}t+=257;t=json_raw(b[..],t,"\"]]");
  r=n90_reply(n32_event(7000,cast(string)b[0..<t]));#assert r.error==N90_LIMIT && r.at==1;
}

// The request the checks answer and replies to it written by n90_reply_tags.
#test "matching: kind + 1000, e, p and the embedded request" #steps 200000000 {
  rb:[4096]u8;req:=n90_t_event(0x11,1000,5050,N90_T_REQ_TAGS,"",rb[..]);
  ob:[4096]u8;other:=n90_t_event(0x11,1001,5050,N90_T_REQ_TAGS,"",ob[..]);
  tb:[8192]u8;n:=n90_reply_tags(req,-1,"","wss://relay.example.com",5000,"lnbc50n1pxyz",tb[..]);#assert n>0;
  eb:[8192]u8;res:=n90_t_event(0x22,1010,6050,cast(string)tb[0..<n],"Paris",eb[..]);#assert res.error==NE_OK;
  work:[16384]u8;
  #assert n90_match(req,res,work[..])==N90_OK;
  // The same tags under kind 6051, and against a request of another kind.
  wb:[8192]u8;w:=n90_t_event(0x22,1010,6051,cast(string)tb[0..<n],"Paris",wb[..]);#assert n90_match(req,w,work[..])==N90_KIND;
  #assert n90_match(n32_event(4999,"[]"),res,work[..])==N90_KIND && n90_match(n32_event(6000,"[]"),res,work[..])==N90_KIND;
  // A result for another request.
  #assert n90_match(other,res,work[..])==N90_E;
  // Feedback is matched by e and p alone.
  fb:[4096]u8;m:=n90_reply_tags(req,N90_PROCESSING,"","",-1,"",fb[..]);
  feb:[4096]u8;f:=n90_t_event(0x22,1005,7000,cast(string)fb[0..<m],"",feb[..]);#assert n90_match(req,f,work[..])==N90_OK;
  #assert n90_match(other,f,work[..])==N90_E;
  // Hand-written tags: the right e with another customer, the embedded
  // request swapped for another, not an event, too long for work.
  ih:[64]u8;id:=req.id;h:=hex_encode_checked(cast(string)id[..],ih[..],false);
  t:[8192]u8;k:=json_raw(t[..],0,"[[\"request\",");k=json_write_string(t[..],k,req.original);k=json_raw(t[..],k,"],[\"e\",\"");
  k=json_raw(t[..],k,cast(string)ih[..]);k=json_raw(t[..],k,"\"],[\"p\",\"3333333333333333333333333333333333333333333333333333333333333333\"]]");
  pb:[8192]u8;p:=n90_t_event(0x22,1010,6050,cast(string)t[0..<k],"Paris",pb[..]);#assert n90_match(req,p,work[..])==N90_P;
  k=json_raw(t[..],0,"[[\"request\",");k=json_write_string(t[..],k,other.original);k=json_raw(t[..],k,"],[\"e\",\"");
  k=json_raw(t[..],k,cast(string)ih[..]);k=json_raw(t[..],k,"\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"]]");
  sb:[8192]u8;s:=n90_t_event(0x22,1010,6050,cast(string)t[0..<k],"Paris",sb[..]);#assert n90_match(req,s,work[..])==N90_REQUEST;
  k=json_raw(t[..],0,"[[\"request\",\"\"],[\"e\",\"");
  k=json_raw(t[..],k,cast(string)ih[..]);k=json_raw(t[..],k,"\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"]]");
  s=n90_t_event(0x22,1010,6050,cast(string)t[0..<k],"Paris",sb[..]);#assert n90_match(req,s,work[..])==N90_REQUEST;
  L:=req.original.count;#assert n90_match(req,res,work[0..<2*L])==N90_OK && n90_match(req,res,work[0..<2*L-2])==N90_LIMIT;
  // The embedded request with one byte changed no longer hashes to its id.
  copy:[4096]u8;for i:0..<req.original.count {copy[i]=req.original[i];}
  // created_at 1000 becomes 1001.
  #assert cast(string)copy[162..<166]=="1000";copy[165]='1';
  k=json_raw(t[..],0,"[[\"request\",");k=json_write_string(t[..],k,cast(string)copy[0..<req.original.count]);k=json_raw(t[..],k,"],[\"e\",\"");
  k=json_raw(t[..],k,cast(string)ih[..]);k=json_raw(t[..],k,"\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"]]");
  s=n90_t_event(0x22,1010,6050,cast(string)t[0..<k],"Paris",sb[..]);#assert n90_match(req,s,work[..])==N90_REQUEST;
  // A reply that doesn't read.
  #assert n90_match(req,n32_event(7000,"[]"),work[..])==N90_NO_E;
  // Feedback naming events of the kinds around the request range.
  kinds:=[4]int.[4999,5000,5999,6000];want:=[4]int.[N90_KIND,N90_OK,N90_OK,N90_KIND];
  for q:0..<4 {
    qb:[1024]u8;qe:=n90_t_event(0x11,1000,kinds[q],"[]","",qb[..]);
    qh:[64]u8;qid:=qe.id;g:=hex_encode_checked(cast(string)qid[..],qh[..],false);
    k=json_raw(t[..],0,"[[\"status\",\"processing\"],[\"e\",\"");k=json_raw(t[..],k,cast(string)qh[..]);
    k=json_raw(t[..],k,"\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"]]");
    fq:=n32_event(7000,cast(string)t[0..<k]);#assert n90_match(qe,fq,work[..])==want[q];
  }
}
#test "price: invoice equal to the amount, bid as the ceiling" {
  p:=n90_price(10000,5000,"lnbc50n1pxyz");#assert p.error==N90_OK && p.msats==5000;
  #assert n90_price(10000,5000,"").error==N90_OK && n90_price(5000,5000,"").error==N90_OK && n90_price(4999,5000,"").error==N90_OVER_BID;
  #assert n90_price(10000,5000,"lnbc51n1pxyz").error==N90_INVOICE && n90_price(10000,5000,"lnbc1pxyz").error==N90_INVOICE;
  #assert n90_price(-1,0,"").error==N90_OK && n90_price(-1,1,"").error==N90_NO_BID && n90_price(0,1,"").error==N90_OVER_BID && n90_price(0,0,"").msats==0;
  #assert n90_price(10000,-1,"").error==N90_AMOUNT && n90_price(10000,0,"lnbc1pxyz").error==N90_INVOICE && n90_price(10000,5,"x").error==N90_INVOICE;
}
#test "the customer's job: payment, work, result, and the clock" #steps 200000000 {
  rb:[4096]u8;req:=n90_t_event(0x11,1000,5050,N90_T_REQ_TAGS,"",rb[..]);
  work:[16384]u8;
  j:=n90_job(req,60);
  #assert j.state==N90_SENT && j.error==N90_OK && j.sent==1000 && j.deadline==1060 && j.bid==10000 && j.updated==1000 && !j.has_provider && j.owed== -1 && j.status== -1;
  bad:=n90_job(n32_event(1,"[]"),60);#assert bad.state==N90_FAILED && bad.error==N90_KIND;
  #assert n90_tick(j,1060).state==N90_SENT && n90_tick(j,1061).state==N90_EXPIRED;
  tb:[8192]u8;eb:[8192]u8;
  // payment-required for 5000 msats at 1005.
  n:=n90_reply_tags(req,N90_PAYMENT_REQUIRED,"","",5000,"lnbc50n1pxyz",tb[..]);
  pay:=n90_t_event(0x22,1005,7000,cast(string)tb[0..<n],"",eb[..]);
  s:=n90_step(j,req,pay,1005,work[..]);
  #assert s.state==N90_PAY && s.error==N90_OK && s.owed==5000 && s.has_provider && s.provider[0]==0x22 && s.updated==1005 && s.status==N90_PAYMENT_REQUIRED;
  #assert n90_step(j,req,pay,1004,work[..]).error==N90_TIME;
  // processing at 1007, then a stale processing made at 1004.
  b2:[8192]u8;t2:[4096]u8;n=n90_reply_tags(req,N90_PROCESSING,"","",-1,"",t2[..]);
  work1:=n90_t_event(0x22,1007,7000,cast(string)t2[0..<n],"",b2[..]);
  s2:=n90_step(s,req,work1,1007,work[..]);#assert s2.state==N90_WORKING && s2.owed==5000 && s2.status==N90_PROCESSING && s2.updated==1007 && s2.error==N90_OK;
  b3:[8192]u8;old:=n90_t_event(0x22,1004,7000,cast(string)t2[0..<n],"",b3[..]);
  st:=n90_step(s2,req,old,1008,work[..]);#assert st.error==N90_STALE && st.state==N90_WORKING && st.updated==1007;
  same:=n90_t_event(0x22,1007,7000,cast(string)t2[0..<n],"",b3[..]);#assert n90_step(s2,req,same,1008,work[..]).error==N90_OK;
  // Another provider's feedback once 0x22 answered.
  b4:[8192]u8;intruder:=n90_t_event(0x33,1008,7000,cast(string)t2[0..<n],"",b4[..]);
  #assert n90_step(s2,req,intruder,1008,work[..]).error==N90_PROVIDER && n90_step(j,req,intruder,1008,work[..]).error==N90_OK;
  // The result at 1010 closes the job; nothing is taken after it.
  b5:[8192]u8;t5:[8192]u8;n=n90_reply_tags(req,-1,"","wss://relay.example.com",5000,"lnbc50n1pxyz",t5[..]);
  res:=n90_t_event(0x22,1010,6050,cast(string)t5[0..<n],"Paris",b5[..]);
  d:=n90_step(s2,req,res,1010,work[..]);#assert d.state==N90_DONE && d.error==N90_OK && d.owed==5000 && ns_equal32(d.result,res.id) && d.updated==1007 && d.status==N90_PROCESSING;
  #assert n90_step(d,req,work1,1011,work[..]).error==N90_CLOSED && n90_tick(d,5000).state==N90_DONE;
  // A result made before the last feedback is still final.
  b6:[8192]u8;early:=n90_t_event(0x22,1006,6050,cast(string)t5[0..<n],"Paris",b6[..]);#assert n90_step(s2,req,early,1011,work[..]).state==N90_DONE;
  // Past the deadline the job has expired.
  late:=n90_step(s,req,res,1061,work[..]);#assert late.state==N90_EXPIRED && late.error==N90_CLOSED;
  #assert n90_step(s,req,res,1060,work[..]).state==N90_DONE;
  // A result for the request before any feedback, made at the request's second.
  b7:[8192]u8;first:=n90_t_event(0x22,1000,6050,cast(string)t5[0..<n],"Paris",b7[..]);
  #assert n90_step(j,req,first,1000,work[..]).state==N90_DONE && n90_step(j,req,first,999,work[..]).error==N90_TIME;
  b8:[8192]u8;before:=n90_t_event(0x22,999,6050,cast(string)t5[0..<n],"Paris",b8[..]);#assert n90_step(j,req,before,1000,work[..]).error==N90_TIME;
  // A reply that doesn't match.
  ob:[4096]u8;other:=n90_t_event(0x11,1001,5050,N90_T_REQ_TAGS,"",ob[..]);
  #assert n90_step(j,req,res,1010,work[..]).state==N90_DONE && n90_step(j,other,res,1010,work[..]).error==N90_E;
}
#test "the customer's job: amounts it refuses" #steps 200000000 {
  rb:[4096]u8;req:=n90_t_event(0x11,1000,5050,N90_T_REQ_TAGS,"",rb[..]);
  work:[16384]u8;j:=n90_job(req,60);tb:[4096]u8;eb:[8192]u8;
  // payment-required without an amount.
  n:=n90_reply_tags(req,N90_PAYMENT_REQUIRED,"","",-1,"",tb[..]);
  e:=n90_t_event(0x22,1005,7000,cast(string)tb[0..<n],"",eb[..]);s:=n90_step(j,req,e,1005,work[..]);
  #assert s.error==N90_AMOUNT && s.state==N90_SENT && !s.has_provider;
  // Over the bid: too dear, and closed.
  n=n90_reply_tags(req,N90_PAYMENT_REQUIRED,"","",20000,"",tb[..]);
  e=n90_t_event(0x22,1005,7000,cast(string)tb[0..<n],"",eb[..]);s=n90_step(j,req,e,1005,work[..]);
  #assert s.state==N90_TOO_DEAR && s.error==N90_OVER_BID && s.owed== -1 && n90_step(s,req,e,1006,work[..]).error==N90_CLOSED;
  n=n90_reply_tags(req,N90_PAYMENT_REQUIRED,"","",10000,"",tb[..]);
  e=n90_t_event(0x22,1005,7000,cast(string)tb[0..<n],"",eb[..]);#assert n90_step(j,req,e,1005,work[..]).state==N90_PAY;
  n=n90_reply_tags(req,N90_PAYMENT_REQUIRED,"","",0,"",tb[..]);
  e=n90_t_event(0x22,1005,7000,cast(string)tb[0..<n],"",eb[..]);s=n90_step(j,req,e,1005,work[..]);#assert s.state==N90_PAY && s.owed==0 && s.error==N90_OK;
  // An invoice for another amount: refused, the job stays open.
  ih:[64]u8;id:=req.id;h:=hex_encode_checked(cast(string)id[..],ih[..],false);
  t:[1024]u8;k:=json_raw(t[..],0,"[[\"status\",\"payment-required\"],[\"amount\",\"5000\",\"lnbc100n1pxyz\"],[\"e\",\"");
  k=json_raw(t[..],k,cast(string)ih[..]);k=json_raw(t[..],k,"\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"]]");
  e=n90_t_event(0x22,1005,7000,cast(string)t[0..<k],"",eb[..]);s=n90_step(j,req,e,1005,work[..]);
  #assert s.error==N90_INVOICE && s.state==N90_SENT && !s.has_provider;
  // error, success and partial.
  n=n90_reply_tags(req,N90_ERROR,"out of memory","",-1,"",tb[..]);
  e=n90_t_event(0x22,1005,7000,cast(string)tb[0..<n],"",eb[..]);s=n90_step(j,req,e,1005,work[..]);#assert s.state==N90_FAILED && s.status==N90_ERROR;
  n=n90_reply_tags(req,N90_SUCCESS,"","",-1,"",tb[..]);
  e=n90_t_event(0x22,1005,7000,cast(string)tb[0..<n],"",eb[..]);s=n90_step(j,req,e,1005,work[..]);#assert s.state==N90_WORKING && s.status==N90_SUCCESS;
  n=n90_reply_tags(req,N90_PARTIAL,"","",0,"",tb[..]);
  e=n90_t_event(0x22,1005,7000,cast(string)tb[0..<n],"Par",eb[..]);s=n90_step(j,req,e,1005,work[..]);#assert s.state==N90_WORKING && s.status==N90_PARTIAL && s.owed==0;
  // A request without a bid pays nothing automatically.
  nb:[4096]u8;free:=n90_t_event(0x11,1000,5050,"[[\"i\",\"x\",\"text\"]]","",nb[..]);fj:=n90_job(free,60);
  n=n90_reply_tags(free,N90_PAYMENT_REQUIRED,"","",1,"",tb[..]);
  e=n90_t_event(0x22,1005,7000,cast(string)tb[0..<n],"",eb[..]);s=n90_step(fj,free,e,1005,work[..]);#assert s.state==N90_TOO_DEAR && s.error==N90_NO_BID;
}
#test "writers: the request's tags" {
  out:[1024]u8;
  in:=[1]N90In.[N90In.{data="What is the capital of France?",type=N90_TEXT}];
  pr:=[1]N90Pair.[N90Pair.{key="model",value="LLaMA-2"}];
  relays:=[1]string.["wss://relay.example.com"];
  pk:=[1][32]u8.[n90_t_key(0x22)];
  n:=n90_request_tags(in[..],pr[..],"text/plain",10000,relays[..],pk[..],false,out[..]);
  #assert n>0 && cast(string)out[0..<n]==N90_T_REQ_TAGS;
  #assert n90_request_tags(in[..],pr[..],"text/plain",10000,relays[..],pk[..],false,out[0..<n])==n && n90_request_tags(in[..],pr[..],"text/plain",10000,relays[..],pk[..],false,out[0..<n-1])== -N90_OUTPUT;
  n0:[1]N90In;p0:[1]N90Pair;r0:[1]string;k0:[1][32]u8;
  n=n90_request_tags(n0[0..<0],p0[0..<0],"",-1,r0[0..<0],k0[0..<0],false,out[..]);#assert n==2 && cast(string)out[0..<n]=="[]";
  n=n90_request_tags(n0[0..<0],p0[0..<0],"",0,r0[0..<0],pk[..],true,out[..]);
  #assert cast(string)out[0..<n]=="[[\"bid\",\"0\"],[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"],[\"encrypted\"]]";
  n=n90_request_tags(n0[0..<0],p0[0..<0],"",N90_MAX_MSATS,r0[0..<0],k0[0..<0],false,out[..]);#assert cast(string)out[0..<n]=="[[\"bid\",\"2100000000000000000\"]]";
  #assert n90_request_tags(n0[0..<0],p0[0..<0],"",N90_MAX_MSATS+1,r0[0..<0],k0[0..<0],false,out[..])== -N90_BID && n90_request_tags(n0[0..<0],p0[0..<0],"",-2,r0[0..<0],k0[0..<0],false,out[..])== -N90_BID;
  two:=[2]string.["wss://a","wss://b"];
  n=n90_request_tags(n0[0..<0],p0[0..<0],"",-1,two[..],k0[0..<0],false,out[..]);#assert cast(string)out[0..<n]=="[[\"relays\",\"wss://a\",\"wss://b\"]]";
  ev:=[3]N90In.[N90In.{data="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",type=N90_EVENT_ID,relay="wss://r",marker="source"},
                N90In.{data="https://x/a",type=N90_URL},N90In.{data="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",type=N90_JOB,marker="m"}];
  n=n90_request_tags(ev[..],p0[0..<0],"",-1,r0[0..<0],k0[0..<0],false,out[..]);
  #assert cast(string)out[0..<n]=="[[\"i\",\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"event\",\"wss://r\",\"source\"],[\"i\",\"https://x/a\",\"url\"],[\"i\",\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"job\",\"\",\"m\"]]";
  #assert n90_request(n32_event(5050,cast(string)out[0..<n])).ni==3;
  bad:=[1]N90In.[N90In.{data="x",type=4}];#assert n90_request_tags(bad[..],p0[0..<0],"",-1,r0[0..<0],k0[0..<0],false,out[..])== -N90_INPUT;
  bad[0].type= -1;#assert n90_request_tags(bad[..],p0[0..<0],"",-1,r0[0..<0],k0[0..<0],false,out[..])== -N90_INPUT;
  bad[0].type=N90_EVENT_ID;#assert n90_request_tags(bad[..],p0[0..<0],"",-1,r0[0..<0],k0[0..<0],false,out[..])== -N90_INPUT;
  bad[0].type=N90_JOB;#assert n90_request_tags(bad[..],p0[0..<0],"",-1,r0[0..<0],k0[0..<0],false,out[..])== -N90_INPUT;
  bad[0].type=N90_TEXT;bad[0].relay="https://r";#assert n90_request_tags(bad[..],p0[0..<0],"",-1,r0[0..<0],k0[0..<0],false,out[..])== -N90_INPUT;
  bad[0].relay="x";#assert n90_request_tags(bad[..],p0[0..<0],"",-1,r0[0..<0],k0[0..<0],false,out[..])== -N90_INPUT;
  bad[0].relay="ws://r";n=n90_request_tags(bad[..],p0[0..<0],"",-1,r0[0..<0],k0[0..<0],false,out[..]);#assert cast(string)out[0..<n]=="[[\"i\",\"x\",\"text\",\"ws://r\"]]";
  n=n90_request_tags(n0[0..<0],p0[0..<0],"x",-1,r0[0..<0],k0[0..<0],false,out[..]);#assert cast(string)out[0..<n]=="[[\"output\",\"x\"]]";
  nokey:=[1]N90Pair.[N90Pair.{value="v"}];#assert n90_request_tags(n0[0..<0],nokey[..],"",-1,r0[0..<0],k0[0..<0],false,out[..])== -N90_PARAM;
}
#test "writers: results and feedback" {
  rb:[4096]u8;req:=n90_t_event(0x11,1000,5050,N90_T_REQ_TAGS,"",rb[..]);
  ih:[64]u8;id:=req.id;h:=hex_encode_checked(cast(string)id[..],ih[..],false);
  out:[8192]u8;want:[8192]u8;
  n:=n90_reply_tags(req,N90_PAYMENT_REQUIRED,"","",5000,"lnbc50n1pxyz",out[..]);
  w:=json_raw(want[..],0,"[[\"status\",\"payment-required\"],[\"e\",\"");w=json_raw(want[..],w,cast(string)ih[..]);
  w=json_raw(want[..],w,"\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"amount\",\"5000\",\"lnbc50n1pxyz\"]]");
  #assert n==w && cast(string)out[0..<n]==cast(string)want[0..<w];
  n=n90_reply_tags(req,N90_ERROR,"bad input","wss://r",-1,"",out[..]);
  w=json_raw(want[..],0,"[[\"status\",\"error\",\"bad input\"],[\"e\",\"");w=json_raw(want[..],w,cast(string)ih[..]);
  w=json_raw(want[..],w,"\",\"wss://r\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"]]");
  #assert cast(string)out[0..<n]==cast(string)want[0..<w];
  n=n90_reply_tags(req,-1,"","wss://relay.example.com",5000,"",out[..]);
  w=json_raw(want[..],0,"[[\"request\",");w=json_write_string(want[..],w,req.original);w=json_raw(want[..],w,"],[\"e\",\"");w=json_raw(want[..],w,cast(string)ih[..]);
  w=json_raw(want[..],w,"\",\"wss://relay.example.com\"],[\"i\",\"What is the capital of France?\",\"text\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"amount\",\"5000\"]]");
  #assert cast(string)out[0..<n]==cast(string)want[0..<w];
  #assert n90_reply_tags(req,-1,"","wss://relay.example.com",5000,"",out[0..<n])==n && n90_reply_tags(req,-1,"","wss://relay.example.com",5000,"",out[0..<n-1])== -N90_OUTPUT;
  // An encrypted request's result: encrypted, and no inputs.
  eb:[4096]u8;enc:=n90_t_event(0x11,1000,5050,"[[\"p\",\"2222222222222222222222222222222222222222222222222222222222222222\"],[\"encrypted\"]]","AgcH",eb[..]);
  eid:=enc.id;h=hex_encode_checked(cast(string)eid[..],ih[..],false);
  n=n90_reply_tags(enc,-1,"","",-1,"",out[..]);
  w=json_raw(want[..],0,"[[\"request\",");w=json_write_string(want[..],w,enc.original);w=json_raw(want[..],w,"],[\"e\",\"");w=json_raw(want[..],w,cast(string)ih[..]);
  w=json_raw(want[..],w,"\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"],[\"encrypted\"]]");
  #assert cast(string)out[0..<n]==cast(string)want[0..<w];
  n=n90_reply_tags(enc,N90_PAYMENT_REQUIRED,"x","",-1,"",out[..]);
  w=json_raw(want[..],0,"[[\"status\",\"payment-required\",\"x\"],[\"e\",\"");w=json_raw(want[..],w,cast(string)ih[..]);
  w=json_raw(want[..],w,"\"],[\"p\",\"1111111111111111111111111111111111111111111111111111111111111111\"]]");
  #assert cast(string)out[0..<n]==cast(string)want[0..<w];
  // Refusals.
  #assert n90_reply_tags(n32_event(1,"[]"),-1,"","",-1,"",out[..])== -N90_KIND;
  #assert n90_reply_tags(req,5,"","",-1,"",out[..])== -N90_STATUS && n90_reply_tags(req,-2,"","",-1,"",out[..])== -N90_STATUS && n90_reply_tags(req,N90_PARTIAL,"","",-1,"",out[..])>0;
  #assert n90_reply_tags(req,0,"","https://r",-1,"",out[..])== -N90_TAG && n90_reply_tags(req,0,"","x",-1,"",out[..])== -N90_TAG && n90_reply_tags(req,0,"","",5,"x",out[..])== -N90_INVOICE;
  #assert n90_reply_tags(req,0,"","",-2,"",out[..])== -N90_AMOUNT && n90_reply_tags(req,0,"","",N90_MAX_MSATS+1,"",out[..])== -N90_AMOUNT && n90_reply_tags(req,0,"","",N90_MAX_MSATS,"",out[..])>0;
  #assert n90_reply_tags(req,0,"","",5000,"lnbc100n1q",out[..])== -N90_INVOICE && n90_reply_tags(req,0,"","",-1,"lnbc50n1q",out[..])== -N90_INVOICE;
  #assert n90_write_amount(out[..],7,-1,"x")==7;
}
