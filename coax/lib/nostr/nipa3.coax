// NIP-A3 payment targets: a kind 10133 event lists where its signer can be
// paid, one ["payto", type, address] tag per target. This file reads the
// list and decides which targets a client may offer as a way to pay.
//
// The repository's rule is Bitcoin-only money, so only two types are acted
// on: bitcoin (an on-chain address) and lightning (a Lightning address).
// Every other target is kept, with a status that says why it is never
// offered: a known type that is not Bitcoin (ethereum, nano, paypal, ...),
// a Bitcoin type this reader does not build (bip352 silent payments and
// bip353 DNS names), or a type nobody listed.
//
// A bitcoin target must be a mainnet address whose checksum holds:
// - segwit (BIP-173 and BIP-350): hrp "bc", witness version 0 with Bech32
//   and a 20- or 32-byte program, version 1 with Bech32m and a 32-byte
//   program (Taproot). Versions 1 to 16 with other lengths are valid
//   addresses with no output type defined yet: they are decoded and refused
//   (A3_FUTURE), because coins sent there are not yet protected by any rule.
// - base58check: version byte 0x00 (P2PKH) or 0x05 (P2SH), the first four
//   bytes of SHA-256(SHA-256(version and hash)) as the checksum.
// A program of the wrong length refuses with A3_LENGTH, a wrong checksum
// with A3_CHECKSUM. Testnet and regtest addresses decode and refuse
// (A3_NETWORK).
//
// A lightning target must be name@domain (LUD-16): the name in a-z, 0-9,
// "-", "_" and ".", the domain two or more labels of a-z, 0-9 and "-".
// Nothing here resolves the domain or fetches the LNURL-pay endpoint.
//
// The list is a statement by its signer. The caller verifies the event's
// id and signature, and the person paying confirms the address before any
// payment: this reader only refuses what must never be offered.
//
// Zap splits (NIP-57 appendix G) share one amount between recipients by
// weight. a3_weights reads the weight strings and a3_split divides a whole
// number of millisatoshis so that the shares sum exactly to the total.
#load "nip32.coax";
#load "bech32-core.coax";
#load "../crypto/sha256.coax";
#authority;

A3_OK :: 0; A3_EVENT :: 1; A3_KIND :: 2; A3_SHAPE :: 3; A3_NOT_BITCOIN :: 4;
A3_UNKNOWN :: 5; A3_NOT_BUILT :: 6; A3_CHECKSUM :: 7; A3_ADDRESS :: 8;
A3_NETWORK :: 9; A3_FUTURE :: 10; A3_LIMIT :: 11; A3_WEIGHT :: 12;
A3_ZERO :: 13; A3_AMOUNT :: 14; A3_LENGTH :: 15;
A3_LIST_KIND :: 10133;
A3_MAX :: 16;                              // targets read from one event, recipients in one split
A3_MAX_WEIGHT :: 1000000;
A3_MAX_MSAT :: 2100000000000000000;        // 21 million bitcoin in millisatoshis
A3_BECH32M :: 0x2bc830a3;                  // BIP-350's final constant; Bech32's is 1

// What a target's address is.
A3_NONE :: 0; A3_P2PKH :: 1; A3_P2SH :: 2; A3_P2WPKH :: 3; A3_P2WSH :: 4;
A3_P2TR :: 5; A3_SEGWIT_FUTURE :: 6; A3_LN_ADDRESS :: 7;

// book:begin types
// The types NIP-A3 lists as commonly used, sorted by what this reader does.
A3_ACTED :: [2] string.["bitcoin", "lightning"];
A3_BITCOIN_UNBUILT :: [2] string.["bip352", "bip353"];
A3_NOT_BITCOIN_TYPES :: [12] string.["bitcoincash", "cashme", "ethereum", "litecoin",
  "monero", "nano", "paypal", "revolut", "solana", "tron", "venmo", "zcash"];
// book:end types

// book:begin record
A3Target :: struct {
  status:int=A3_SHAPE; at:int;             // at: its tag's index
  type:N32Text; address:N32Text;           // as written
  form:int;                                // A3_P2PKH ... A3_LN_ADDRESS
  version:int; program:[40]u8; n:int;      // the witness version and program, or the base58 hash
}
A3List :: struct {status:int=A3_EVENT; at:int=-1; count:int; payable:int; t:[A3_MAX]A3Target;}
// book:end record

// ---- test helpers
a3_text :: (s:string)->N32Text {t:N32Text;for i:0..<s.count {t.b[i]=s[i];}t.n=s.count;return t;}
a3_try :: (type:string,address:string)->A3Target {return a3_target(a3_text(type),a3_text(address));}
a3_hex_is :: (b:[]u8,hex:string)->bool {
  if b.count*2!=hex.count {return false;}
  d:="0123456789abcdef";
  for i:0..<b.count {if d[b[i]>>4]!=hex[2*i] || d[b[i]&15]!=hex[2*i+1] {return false;}}
  return true;
}
a3_program_is :: (t:A3Target,hex:string)->bool {c:=t;return a3_hex_is(c.program[0..<c.n],hex);}
a3_w3 :: (a:string,b:string,c:string,out:[]int)->int {t:=[3]string.[a,b,c];return a3_weights(t[..],out);}
a3_s3 :: (total:int,a:int,b:int,c:int,out:[]int)->int {w:=[3]int.[a,b,c];return a3_split(total,w[..],out);}

#test "NIP-A3's example: the bitcoin target is offered, nano and unknowntype are not" {
  e:=n32_event(10133,"[[\"payto\",\"bitcoin\",\"bc1qxq66e0t8d7ugdecwnmv58e90tpry23nc84pg9k\"],[\"payto\",\"nano\",\"nano_1dctqbmqxfppo9pswbm6kg9d4s4mbraqn8i4m7ob9gnzz91aurmuho48jx3c\"],[\"payto\",\"unknowntype\",\"l7tbta5b9xze6ckkfc99uohzxd009b0r\"]]");
  l:=a3_list(e);
  #assert l.status==A3_OK && l.count==3 && l.payable==1 && l.at== -1;
  #assert l.t[0].status==A3_OK && l.t[0].form==A3_P2WPKH && l.t[0].version==0 && a3_program_is(l.t[0],"3035acbd676fb886e70e9ed943e4af5846454678");
  #assert l.t[1].status==A3_NOT_BITCOIN && l.t[1].at==1 && n32_is(l.t[1].type,"nano");
  #assert l.t[2].status==A3_UNKNOWN && l.t[2].at==2 && n32_is(l.t[2].address,"l7tbta5b9xze6ckkfc99uohzxd009b0r");
  u:[128]u8;n:=a3_pay_uri(l.t[0],u[..]);
  #assert n>0 && cast(string)u[0..<n]=="bitcoin:bc1qxq66e0t8d7ugdecwnmv58e90tpry23nc84pg9k";
  #assert a3_pay_uri(l.t[1],u[..])== -1 && a3_pay_uri(l.t[2],u[..])== -1;
}
#test "BIP-350's valid segwit addresses decode; only mainnet v0 and v1 Taproot are offered" {
  t:=a3_try("bitcoin","BC1QW508D6QEJXTDG4Y5R3ZARVARY0C5XW7KV8F3T4");
  #assert t.status==A3_OK && t.form==A3_P2WPKH && a3_program_is(t,"751e76e8199196d454941c45d1b3a323f1433bd6");
  t=a3_try("bitcoin","bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0");
  #assert t.status==A3_OK && t.form==A3_P2TR && t.version==1 && a3_program_is(t,"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798");
  t=a3_try("bitcoin","BC1SW50QGDZ25J");
  #assert t.status==A3_FUTURE && t.form==A3_SEGWIT_FUTURE && t.version==16 && a3_program_is(t,"751e");
  t=a3_try("bitcoin","bc1zw508d6qejxtdg4y5r3zarvaryvaxxpcs");
  #assert t.status==A3_FUTURE && t.version==2 && a3_program_is(t,"751e76e8199196d454941c45d1b3a323");
  t=a3_try("bitcoin","bc1pw508d6qejxtdg4y5r3zarvary0c5xw7kw508d6qejxtdg4y5r3zarvary0c5xw7kt5nd6y");
  #assert t.status==A3_FUTURE && t.version==1 && t.n==40;
  t=a3_try("bitcoin","tb1qrp33g0q5c5txsp9arysrx4k6zdkfs4nce4xj0gdcccefvpysxf3q0sl5k7");
  #assert t.status==A3_NETWORK && t.form==A3_P2WSH && a3_program_is(t,"1863143c14c5166804bd19203356da136c985678cd4d27a1b8c6329604903262");
  t=a3_try("bitcoin","tb1pqqqqp399et2xygdj5xreqhjjvcmzhxw4aywxecjdzew6hylgvsesf3hn0c");
  #assert t.status==A3_NETWORK && t.form==A3_P2TR;
  u:[128]u8;#assert a3_pay_uri(a3_try("bitcoin","BC1SW50QGDZ25J"),u[..])== -1;
  n:=a3_pay_uri(a3_try("bitcoin","BC1QW508D6QEJXTDG4Y5R3ZARVARY0C5XW7KV8F3T4"),u[..]);
  #assert cast(string)u[0..<n]=="bitcoin:bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4";
}
#test "BIP-350's invalid segwit addresses refuse" {
  #assert a3_try("bitcoin","tc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vq5zuyut").status==A3_ADDRESS;
  wrong:=[5]string.["bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqh2y7hd",
    "tb1z0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqglt7rf",
    "BC1S0XLXVLHEMJA6C4DQV22UAPCTQUPFHLXM9H8Z3K2E72Q4K9HCZ7VQ54WELL",
    "bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kemeawh",
    "tb1q0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vq24jc47"];
  for s:wrong {#assert a3_try("bitcoin",s).status==A3_CHECKSUM;}
  short:=[3]string.["bc1pw5dgrnzv",
    "bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7v8n0nx0muaewav253zgeav",
    "BC1QR508D6QEJXTDG4Y5R3ZARVARYV98GJ9P"];
  for s:short {#assert a3_try("bitcoin",s).status==A3_LENGTH;}
  bad:=[5]string.["bc1p38j9r5y49hruaue7wxjce0updqjuyyx0kh56v8s25huc6995vvpql3jow4",
    "BC130XLXVLHEMJA6C4DQV22UAPCTQUPFHLXM9H8Z3K2E72Q4K9HCZ7VQ7ZWS8R",
    "tb1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vq47Zagq",
    "bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7v07qwwzcrf",
    "tb1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vpggkg4j"];
  for s:bad {#assert a3_try("bitcoin",s).status==A3_ADDRESS;}
  #assert a3_try("bitcoin","bc1gmk9yu").status==A3_ADDRESS;
}
#test "segwit edges: length, characters, separator, regtest" {
  #assert a3_segwit("bc1 w508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4").status==A3_ADDRESS;
  del:[42]u8;n:=json_raw(del[..],0,"bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4");del[41]=127;
  #assert a3_segwit(cast(string)del[..]).status==A3_ADDRESS;
  #assert a3_segwit("qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4").status==A3_ADDRESS && a3_segwit("1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4").status==A3_ADDRESS;
  #assert a3_segwit("bc1qqqqq").status==A3_ADDRESS && a3_segwit("bc1").status==A3_ADDRESS;
  long:[91]u8;n=json_raw(long[..],0,"bc1");for i:n..<91 {long[i]='q';}
  #assert a3_segwit(cast(string)long[0..<91]).status==A3_ADDRESS;
  // A Bech32 v0 address with hrp bcrt: regtest, refused for the network.
  t:=a3_segwit("bcrt1qw508d6qejxtdg4y5r3zarvary0c5xw7kygt080");
  #assert t.status==A3_NETWORK && t.form==A3_P2WPKH;
  #assert a3_segwit("bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t5").status==A3_CHECKSUM;
  #assert a3_segwit("bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3tb").status==A3_ADDRESS;
  #assert a3_segwit(cast(string)long[0..<90]).status==A3_CHECKSUM;           // 90 characters is the limit
  #assert a3_segwit("bc1q9zpgru").status==A3_LENGTH;                          // a version and no program
  #assert a3_segwit("bc1pqypqxpq9pd6k8c").status==A3_FUTURE && a3_program_is(a3_segwit("bc1pqypqxpq9pd6k8c"),"0102030405");
  #assert a3_segwit("bc1pqypqxpq9q7aqsy2").status==A3_ADDRESS;               // 5 bits of zero padding
  #assert a3_segwit("bcrt1qw508d6qejxtdg4y5r3zarvary0c5xw7kygt080").status==A3_NETWORK && a3_segwit("bcx1qw508d6qejxtdg4y5r3zarvary0c5xw7kygt080").status==A3_ADDRESS;
  #assert a3_segwit("tbx1qw508d6qejxtdg4y5r3zarvary0c5xw7kygt080").status==A3_ADDRESS;
  // One letter's case flipped: A, Z, a and z.
  flips:=[4]string.["BC1QW508D6QEJXTDG4Y5R3ZaRVARY0C5XW7KV8F3T4", "BC1QW508D6QEJXTDG4Y5R3zARVARY0C5XW7KV8F3T4",
    "bc1p0xlxvlhemja6c4dqv22uApctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0", "bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcZ7vqzk5jj0"];
  for s:flips {#assert a3_segwit(s).status==A3_ADDRESS;}
  #assert a3_segwit("Bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4").status==A3_ADDRESS && a3_segwit("bc").status==A3_ADDRESS;
  #assert a3_starts_ci("bC1x","bc1") && !a3_starts_ci("b","bc") && !a3_starts_ci("bd","bc") && a3_is_ci("BC","bc") && !a3_is_ci("bcrt","bc");
}
#test "helpers and edges that the vectors do not reach" {
  b:=[2]u8.[0x12,0x34];
  #assert a3_hex_is(b[..],"1234") && !a3_hex_is(b[..],"123") && !a3_hex_is(b[..],"0234") && !a3_hex_is(b[..],"1334") && !a3_hex_is(b[..],"1235");
  t:=a3_try("bitcoin","bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0");
  #assert n32_is(t.type,"bitcoin") && n32_is(t.address,"bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0");
  u:[128]u8;n:=a3_pay_uri(a3_try("bitcoin","BC1P0XLXVLHEMJA6C4DQV22UAPCTQUPFHLXM9H8Z3K2E72Q4K9HCZ7VQZK5JJ0"),u[..]);
  #assert cast(string)u[0..<n]=="bitcoin:bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0";
  // Base58: all ones, a wrong first checksum byte, and version 0x30 (Litecoin).
  #assert a3_try("bitcoin","11111111111111111111111111").status==A3_ADDRESS;
  #assert a3_try("bitcoin","1BvBMSEYstWetqTFn5Au4m4GFg7xJbrUeN").status==A3_CHECKSUM;
  #assert a3_try("bitcoin","LW98ceYNxYki9e9QxDACLn82TtVEPm4qmy").status==A3_ADDRESS;
  // Lightning: every boundary character of the name and the domain.
  #assert a3_try("lightning","z09-_.@z09-.example").status==A3_OK && a3_try("lightning","a@b.c").status==A3_OK;
  edge:=[8]string.["{@example.com", "/@example.com", ":@example.com", "`@example.com",
    "a@{.com", "a@/.com", "a@:.com", "a@`.com"];
  for s:edge {#assert a3_try("lightning",s).status==A3_ADDRESS;}
  #assert a3_ldh('a') && a3_ldh('z') && a3_ldh('0') && a3_ldh('9') && a3_ldh('-') && !a3_ldh('{') && !a3_ldh('`') && !a3_ldh('/') && !a3_ldh(':') && !a3_ldh('A');
  // Weights and splits at their bounds.
  one:=[1]string.["9"];w:[16]int;#assert a3_weights(one[..],w[..])==A3_OK && w[0]==9;
  sixteen:[16]string;for i:0..<16 {sixteen[i]="19";}
  #assert a3_weights(sixteen[..],w[..])==A3_OK && w[15]==19;
  #assert a3_w3("1:","1","1",w[..])==A3_WEIGHT && a3_w3("1","1","/",w[..])==A3_WEIGHT && a3_w3("0","","9",w[..])==A3_OK;
  s:[16]int;solo:=[1]int.[3];#assert a3_split(10,solo[..],s[..])==A3_OK && s[0]==10;
}
#test "base58check: P2PKH and P2SH offered, testnet, checksum and shape refused" {
  t:=a3_try("bitcoin","1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2");
  #assert t.status==A3_OK && t.form==A3_P2PKH && a3_program_is(t,"77bff20c60e522dfaa3350c39b030a5d004e839a");
  t=a3_try("bitcoin","3J98t1WpEZ73CNmQviecrnyiWrnqRhWNLy");
  #assert t.status==A3_OK && t.form==A3_P2SH && a3_program_is(t,"b472a266d0bd89c13706a4132ccfb16f7c3b9fcb");
  u:[128]u8;n:=a3_pay_uri(t,u[..]);#assert cast(string)u[0..<n]=="bitcoin:3J98t1WpEZ73CNmQviecrnyiWrnqRhWNLy";
  #assert a3_try("bitcoin","1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN3").status==A3_CHECKSUM;
  t=a3_try("bitcoin","mipcBbFg9gMiCh81Kj8tqqdgoZub1ZJRfn");#assert t.status==A3_NETWORK && t.form==A3_P2PKH;
  #assert a3_try("bitcoin","2MzQwSSnBHWHqSAqtTVQ6v47XtaisrJa1Vc").status==A3_NETWORK;
  #assert a3_try("bitcoin","1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN0").status==A3_ADDRESS;   // 0 is not base58
  #assert a3_try("bitcoin","1BvBMSEYstWetqTFn5Au4m4GFg7").status==A3_ADDRESS;
  #assert a3_try("bitcoin","11BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2").status==A3_ADDRESS; // a leading 1 too many
  #assert a3_try("bitcoin","zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz").status==A3_ADDRESS;   // over 25 bytes
  #assert a3_try("bitcoin","").status==A3_SHAPE;
}
#test "lightning addresses" {
  t:=a3_try("lightning","alice@example.com");#assert t.status==A3_OK && t.form==A3_LN_ADDRESS;
  u:[128]u8;n:=a3_pay_uri(t,u[..]);#assert cast(string)u[0..<n]=="lightning:alice@example.com";
  #assert a3_pay_uri(t,u[0..<26])== -1 && a3_pay_uri(t,u[0..<27])==27;
  #assert a3_try("lightning","a.b-c_9@pay.sub-1.example.org").status==A3_OK;
  bad:=[12]string.["alice","@example.com","alice@","alice@example","Alice@example.com","alice@Example.com",
    "al ice@example.com","alice@example..com","alice@.example.com","alice@example.com.","a@b@example.com","lnurl1dp68gurn8ghj7"];
  for s:bad {#assert a3_try("lightning",s).status==A3_ADDRESS;}
}
#test "types: not Bitcoin, not built, unknown, malformed" {
  for s:A3_NOT_BITCOIN_TYPES {#assert a3_try(s,"x").status==A3_NOT_BITCOIN;}
  #assert a3_try("bip352","sp1qq").status==A3_NOT_BUILT && a3_try("bip353","alice@example.com").status==A3_NOT_BUILT;
  #assert a3_try("unknowntype","x").status==A3_UNKNOWN && a3_try("spark","x").status==A3_UNKNOWN;
  #assert a3_try("Bitcoin","1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2").status==A3_SHAPE;
  #assert a3_try("","x").status==A3_SHAPE && a3_try("nano","").status==A3_SHAPE && a3_try("bit coin","x").status==A3_SHAPE;
  #assert a3_try("bip-353","x").status==A3_UNKNOWN && a3_try("x9","x").status==A3_UNKNOWN;
  #assert a3_type_ok("az09-") && !a3_type_ok("a/") && !a3_type_ok("a:") && !a3_type_ok("`") && !a3_type_ok("{");
}
#test "the list: kind, tag shapes, limits, other tags ignored" {
  #assert a3_list(n32_event(1,"[[\"payto\",\"bitcoin\",\"1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2\"]]")).status==A3_KIND;
  none:NostrEvent;#assert a3_list(none).status==A3_EVENT;
  l:=a3_list(n32_event(10133,"[[\"t\",\"x\"],[\"payto\",\"bitcoin\"],[\"payto\",\"lightning\",\"bob@example.com\",\"extra\"]]"));
  #assert l.status==A3_OK && l.count==2 && l.payable==1 && l.t[0].status==A3_SHAPE && l.t[0].at==1 && l.t[1].status==A3_OK && l.t[1].at==2;
  #assert a3_list(n32_event(10133,"[]")).count==0 && a3_list(n32_event(10133,"[]")).status==A3_OK;
  b:=n32_event(10133,"[]");b.original="[[\"t\"],[\"payto\",1]]";b.tags_from=0;b.tags_to=b.original.count;
  l=a3_list(b);#assert l.status==A3_EVENT && l.at==1;
  many:[2048]u8;n:=json_raw(many[..],0,"[");
  for i:0..<A3_MAX+1 {if i>0 {n=json_raw(many[..],n,",");}n=json_raw(many[..],n,"[\"payto\",\"nano\",\"x\"]");}
  n=json_raw(many[..],n,"]");
  l=a3_list(n32_event(10133,cast(string)many[0..<n]));#assert l.status==A3_LIMIT && l.at==A3_MAX && l.count==A3_MAX;
  long:[400]u8;n=json_raw(long[..],0,"[[\"payto\",\"nano\",\"");for i:0..<257 {long[n+i]='x';}n+=257;n=json_raw(long[..],n,"\"]]");
  l=a3_list(n32_event(10133,cast(string)long[0..<n]));#assert l.status==A3_OK && l.count==1 && l.t[0].status==A3_LIMIT;
}

#test "weights: NIP-57 appendix G's example, absent weights, refusals" {
  w:[3]int;
  #assert a3_w3("1","1","2",w[..])==A3_OK && w[0]==1 && w[1]==1 && w[2]==2;
  #assert a3_w3("","","",w[..])==A3_OK && w[0]==1 && w[1]==1 && w[2]==1;
  #assert a3_w3("3","","5",w[..])==A3_OK && w[0]==3 && w[1]==0 && w[2]==5;
  #assert a3_w3("0","0","0",w[..])==A3_ZERO && a3_w3("0","","",w[..])==A3_ZERO;
  #assert a3_w3("-1","1","1",w[..])==A3_WEIGHT && a3_w3("1.5","1","1",w[..])==A3_WEIGHT;
  #assert a3_w3("01","1","1",w[..])==A3_WEIGHT && a3_w3("+1","1","1",w[..])==A3_WEIGHT && a3_w3("1 ","1","1",w[..])==A3_WEIGHT;
  #assert a3_w3("1000000","1","1",w[..])==A3_OK && a3_w3("1000001","1","1",w[..])==A3_WEIGHT;
  #assert a3_w3("99999999999999999999","1","1",w[..])==A3_WEIGHT;
  #assert a3_w3("1","1","1",w[0..<2])==A3_LIMIT;
  e:=[1]string.["1"];#assert a3_weights(e[0..<0],w[..])==A3_LIMIT;
  big:[17]string;wide:[17]int;#assert a3_weights(big[..],wide[..])==A3_LIMIT;
}
#test "split 1000 sats over 1:2:3 and NIP-57's 1:1:2" {
  s:[3]int;
  #assert a3_s3(1000000,1,2,3,s[..])==A3_OK && s[0]==166667 && s[1]==333333 && s[2]==500000;
  #assert a3_s3(1000000,1,1,2,s[..])==A3_OK && s[0]==250000 && s[1]==250000 && s[2]==500000;
  #assert a3_s3(7,1,1,1,s[..])==A3_OK && s[0]==3 && s[1]==2 && s[2]==2;
  #assert a3_s3(10,0,1,1,s[..])==A3_OK && s[0]==0 && s[1]==5 && s[2]==5;
  #assert a3_s3(5,2,1,2,s[..])==A3_OK && s[0]==2 && s[1]==1 && s[2]==2;
  #assert a3_s3(1,1,1,1,s[..])==A3_OK && s[0]==1 && s[1]==0 && s[2]==0;
  #assert a3_s3(2,1,3,3,s[..])==A3_OK && s[0]==0 && s[1]==1 && s[2]==1;
  #assert a3_s3(A3_MAX_MSAT,1000000,999999,1,s[..])==A3_OK && s[0]+s[1]+s[2]==A3_MAX_MSAT && s[2]==1050000000000;
}
#test "split refusals" {
  s:[3]int;
  #assert a3_s3(0,1,1,1,s[..])==A3_AMOUNT && a3_s3(-5,1,1,1,s[..])==A3_AMOUNT && a3_s3(A3_MAX_MSAT+1,1,1,1,s[..])==A3_AMOUNT;
  #assert a3_s3(10,0,0,0,s[..])==A3_ZERO && a3_s3(10,1,-1,1,s[..])==A3_WEIGHT && a3_s3(10,1,1000001,1,s[..])==A3_WEIGHT;
  #assert a3_s3(10,1,1,1,s[0..<2])==A3_LIMIT;
  e:=[1]int.[1];#assert a3_split(10,e[0..<0],s[..])==A3_LIMIT;
  big:[17]int;out:[17]int;for i:0..<17 {big[i]=1;}#assert a3_split(10,big[..],out[..])==A3_LIMIT;
  #assert a3_split(10,big[0..<16],out[..])==A3_OK && out[0]==1 && out[9]==1 && out[10]==0 && out[15]==0;
}
#forall "shares sum to the total and differ from the exact share by under 1 msat" total:1..<40, a:0..<4, b:0..<4 {
  w:=[3]int.[a,b,1];s:[3]int;
  #assert a3_split(total,w[..],s[..])==A3_OK;
  sum:=a+b+1;
  #assert s[0]+s[1]+s[2]==total;
  for i:0..<3 {
    // |s[i] - total*w[i]/sum| < 1, in whole numbers.
    d:=s[i]*sum-total*w[i];
    #assert d> -sum && d<sum;
  }
}

// ---- reading

a3_is_in :: (list:[]string,s:string)->bool {for x:list {if x==s {return true;}}return false;}
a3_fail :: (t:A3Target,status:int)->A3Target {r:=t;r.status=status;return r;}
// A NIP-A3 type: lowercase ASCII letters, digits and "-".
a3_type_ok :: (s:string)->bool {
  if s.count==0 {return false;}
  for c:s {if !((c>='a' && c<='z') || (c>='0' && c<='9') || c=='-') {return false;}}
  return true;
}

// book:begin target
// One payto target: its type sorted, and a bitcoin or lightning address
// checked. Only status A3_OK may be offered as a way to pay.
a3_target :: (type:N32Text,address:N32Text)->A3Target {
  t:A3Target;t.type=type;t.address=address;
  ty:=cast(string)t.type.b[0..<t.type.n];ad:=cast(string)t.address.b[0..<t.address.n];
  if !a3_type_ok(ty) || ad.count==0 {return t;}
  nb:=A3_NOT_BITCOIN_TYPES;ub:=A3_BITCOIN_UNBUILT;
  if a3_is_in(nb[..],ty) {return a3_fail(t,A3_NOT_BITCOIN);}
  if a3_is_in(ub[..],ty) {return a3_fail(t,A3_NOT_BUILT);}
  if ty=="lightning" {return a3_lightning(t,ad);}
  if ty!="bitcoin" {return a3_fail(t,A3_UNKNOWN);}
  a:A3Target;
  if a3_starts_ci(ad,"bc1") || a3_starts_ci(ad,"tb1") || a3_starts_ci(ad,"bcrt1") {a=a3_segwit(ad);}
  else {a=a3_base58(ad);}
  a.type=t.type;a.address=t.address;return a;
}
// book:end target

// book:begin list
// The payto tags of a kind 10133 event, in tag order. A bad target is kept
// with its status; only an unreadable event, the wrong kind or more than
// A3_MAX targets refuses the list.
a3_list :: (e:NostrEvent)->A3List {
  r:A3List;if e.error!=NE_OK {return r;}
  if e.kind!=A3_LIST_KIND {r.status=A3_KIND;return r;}
  i:=0;
  while true {
    g:=n32_tag(e,i);
    if g.error==NT_INDEX {break;}
    if g.error!=NT_OK && g.error!=NT_LIMIT {r.at=i;return r;}
    if n32_is(g.v[0],"payto") {
      if r.count==A3_MAX {r.status=A3_LIMIT;r.at=i;return r;}
      t:A3Target;
      if g.error==NT_LIMIT {t.status=A3_LIMIT;}
      else if g.values>=3 {t=a3_target(g.v[1],g.v[2]);}
      t.at=i;r.t[r.count]=t;r.count+=1;
      if t.status==A3_OK {r.payable+=1;}
    }
    i+=1;
  }
  r.status=A3_OK;return r;
}
// book:end list

// book:begin uri
// The URI a client may offer as a payment link: bitcoin:<address> (bech32
// in lower case) or lightning:<address>. -1 when the target must not be
// offered or out is too small; nothing is written then.
a3_pay_uri :: (t:A3Target,out:[]u8)->int {
  if t.status!=A3_OK {return -1;}
  scheme:=ifx t.form==A3_LN_ADDRESS then "lightning:" else "bitcoin:";
  c:=t;ad:=cast(string)c.address.b[0..<c.address.n];
  if scheme.count+ad.count>out.count {return -1;}
  for i:0..<scheme.count {out[i]=scheme[i];}
  lower:=t.form>A3_P2SH;                   // segwit; a Lightning address is lower case already
  for i:0..<ad.count {out[scheme.count+i]=ifx lower then b32_lower(ad[i]) else ad[i];}
  return scheme.count+ad.count;
}
// book:end uri

a3_is_ci :: (s:string,p:string)->bool {return s.count==p.count && a3_starts_ci(s,p);}
a3_starts_ci :: (s:string,p:string)->bool {
  if s.count<p.count {return false;}
  for i:0..<p.count {if b32_lower(s[i])!=p[i] {return false;}}
  return true;
}

// book:begin segwit
// A segwit address (BIP-173, BIP-350). The checksum residue is 1 for
// Bech32 and A3_BECH32M for Bech32m; version 0 needs the first, versions 1
// to 16 the second. Program, version and form are filled in before the
// network is checked, so a testnet address reports what it holds.
a3_segwit :: (s:string)->A3Target {
  t:A3Target;t.status=A3_ADDRESS;
  if s.count>90 {return t;}
  sep:=s.count;upper:=false;lower:=false;   // no 1: the whole string is the hrp
  for i:0..<s.count {
    c:=s[i];
    if c=='1' {sep=i;}
    if b32_lower(c)!=c {upper=true;}        // A to Z
    if b32_lower(c^32)==c {lower=true;}     // a to z: its upper case lowers back to it
  }
  hrp:=s[0..<sep];net:=A3_OK;
  if !a3_is_ci(hrp,"bc") {
    if !a3_is_ci(hrp,"tb") && !a3_is_ci(hrp,"bcrt") {return t;}
    net=A3_NETWORK;
  }
  if upper && lower {return t;}
  words:[90]u8;n:=s.count-sep-1;
  if n<7 {return t;}                        // a version word and six checksum words
  state:=b32_prefix(hrp);
  for i:0..<n {
    d:=b32_digit(b32_lower(s[sep+1+i]));
    if d<0 {return t;}
    words[i]=cast(u8)d;state=b32_step(state,words[i]);
  }
  if state!=1 && state!=A3_BECH32M {return a3_fail(t,A3_CHECKSUM);}
  if words[0]>16 {return t;}
  t.version=cast(int)words[0];
  // Five bits per word into bytes; at most 4 bits of zero padding remain.
  acc:u32;bits:=0;
  for i:1..<n-6 {
    acc=((acc<<5)|cast(u32)words[i])&0xfff;bits+=5;
    if bits>=8 {bits-=8;if t.n==40 {return a3_fail(t,A3_LENGTH);}t.program[t.n]=cast(u8)((acc>>bits)&255);t.n+=1;}
  }
  if bits>4 || (acc&cast(u32)((1<<bits)-1))!=0 {return t;}
  if t.n<2 || (t.version==0 && t.n!=20 && t.n!=32) {return a3_fail(t,A3_LENGTH);}
  if (t.version==0)!=(state==1) {return a3_fail(t,A3_CHECKSUM);}
  t.form=ifx t.version==0 && t.n==20 then A3_P2WPKH else ifx t.version==0 then A3_P2WSH
    else ifx t.version==1 && t.n==32 then A3_P2TR else A3_SEGWIT_FUTURE;
  if net!=A3_OK {return a3_fail(t,net);}
  return a3_fail(t,ifx t.form==A3_SEGWIT_FUTURE then A3_FUTURE else A3_OK);
}
// book:end segwit

// book:begin base58
// A base58check address: 25 bytes, version, 20-byte hash and checksum,
// with one leading "1" per leading zero byte.
A3_BASE58 :: "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
a3_base58 :: (s:string)->A3Target {
  t:A3Target;t.status=A3_ADDRESS;
  b:[25]u8;
  for c:s {
    d:=-1;for k:0..<58 {if A3_BASE58[k]==c {d=k;}}
    if d<0 {return t;}
    carry:=d;
    for k:0..<25 {carry+=cast(int)b[24-k]*58;b[24-k]=cast(u8)(carry&255);carry=carry>>8;}
    if carry!=0 {return t;}                  // over 25 bytes
  }
  ones:=0;while ones<s.count && s[ones]=='1' {ones+=1;}
  zeros:=0;while zeros<25 && b[zeros]==0 {zeros+=1;}
  if ones!=zeros {return t;}
  h:[32]u8;h2:[32]u8;
  if sha256_hash_checked(b[0..<21],h[..],false)!=SHA_OK {return t;}
  if sha256_hash_checked(h[..],h2[..],false)!=SHA_OK {return t;}
  for k:0..<4 {if h2[k]!=b[21+k] {return a3_fail(t,A3_CHECKSUM);}}
  for k:1..<21 {t.program[t.n]=b[k];t.n+=1;}
  v:=b[0];
  if v==0x00 || v==0x6f {t.form=A3_P2PKH;}
  else if v==0x05 || v==0xc4 {t.form=A3_P2SH;}
  else {return t;}
  return a3_fail(t,ifx v==0x00 || v==0x05 then A3_OK else A3_NETWORK);
}
// book:end base58

// A Lightning address (LUD-16): name@domain. A second @ fails the domain's
// characters.
a3_lightning :: (t:A3Target,s:string)->A3Target {
  r:=t;r.status=A3_ADDRESS;
  in_name:=true;named:=false;               // reading the name; the name has a character
  dot:=false;empty:=true;                   // the domain has a dot; its last label is empty
  for c:s {
    if in_name {
      if c=='@' {if !named {return r;}in_name=false;continue;}
      if !(a3_ldh(c) || c=='_' || c=='.') {return r;}
      named=true;continue;
    }
    if c=='.' {if empty {return r;}dot=true;empty=true;continue;}
    if !a3_ldh(c) {return r;}
    empty=false;
  }
  if empty || !dot {return r;}              // also when no @ was read: the domain is empty
  r.form=A3_LN_ADDRESS;r.status=A3_OK;return r;
}
// A lower-case letter, a digit or "-".
a3_ldh :: (c:u8)->bool {return (c>='a' && c<='z') || (c>='0' && c<='9') || c=='-';}

// ---- zap splits

// book:begin weights
// NIP-57 appendix G's weights, one string per zap tag ("" when the tag has
// no weight). No weights at all: equal shares. Some weights: a tag without
// one gets 0. A weight is a whole number 0 to A3_MAX_WEIGHT written without
// a sign or leading zeros.
a3_weights :: (texts:[]string,out:[]int)->int {
  if texts.count<1 || texts.count>A3_MAX || out.count<texts.count {return A3_LIMIT;}
  any:=false;for s:texts {if s.count>0 {any=true;}}
  positive:=false;
  for i:0..<texts.count {
    s:=texts[i];w:=0;
    if !any {w=1;}
    else if s.count>0 {
      if s[0]=='0' && s.count>1 {return A3_WEIGHT;}
      for c:s {
        if c<'0' || c>'9' {return A3_WEIGHT;}
        w=w*10+cast(int)(c-'0');
        if w>A3_MAX_WEIGHT {return A3_WEIGHT;}
      }
    }
    out[i]=w;if w>0 {positive=true;}
  }
  if !positive {return A3_ZERO;}
  return A3_OK;
}
// book:end weights

// book:begin split
// total millisatoshis shared by weight. Each share is the exact share
// total·w/W rounded down; the msat left over (fewer than the number of
// recipients) go one each to the largest remainders total·w mod W, the
// earlier tag first on a tie. Computed as q·w + r·w/W with q, r = total
// divided by W, so nothing overflows 64 bits.
a3_split :: (total:int,weights:[]int,out:[]int)->int {
  n:=weights.count;
  if n<1 || n>A3_MAX || out.count<n {return A3_LIMIT;}
  if total<1 || total>A3_MAX_MSAT {return A3_AMOUNT;}
  sum:=0;
  for w:weights {if w<0 || w>A3_MAX_WEIGHT {return A3_WEIGHT;}sum+=w;}
  if sum==0 {return A3_ZERO;}
  q:=total/sum;r:=total%sum;
  rest:[A3_MAX]int;given:[A3_MAX]bool;left:=total;
  for i:0..<n {
    out[i]=q*weights[i]+r*weights[i]/sum;rest[i]=r*weights[i]%sum;left-=out[i];
  }
  while left>0 {
    best:=-1;
    for i:0..<n {if !given[i] && (best<0 || rest[i]>rest[best]) {best=i;}}
    given[best]=true;out[best]+=1;left-=1;
  }
  return A3_OK;
}
// book:end split
