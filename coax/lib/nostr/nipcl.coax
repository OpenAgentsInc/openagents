// Block's NIP-CL, channel identity and discovery, on top of NIP-29 groups
// (nip29.coax). A channel is a NIP-29 group with a type, up to 8 labels, the
// key that created it and the time it was created. The relay keeps those
// four facts beside the group's state and writes them on every 39000 it
// signs, in this order before any other t or P tag:
//
//   ["t", <type>], ["t", <label>]..., ["P", <creator>], and on 39000
//   ["created_at", <unix seconds>]
//
// This file decides four things:
//
// - cl_labels: whether a 9007 (create) or 9002 (edit) carries a valid label
//   set: 1 to 64 bytes from a-z 0-9 . : -, never a type name, at most 8
//   distinct, and ["t", ""] (clear) never beside a label. A repeat counts once.
// - cl_admit: a 9007 or 9002 checked for labels and channel type, then
//   admitted through g29_admit; the creator and the creation time come from
//   the relay's own record (its clock, now), never from a client tag.
// - cl_oldest: the one channel every reader picks among several that share
//   a creator and label: lowest created_at tag, then lowest channel id; a
//   channel without created_at ranks after every channel with one.
// - cl_listed and cl_notice: whether a read that does not name a channel
//   sees it. Only the frozen legacy types stream, forum, dm and workflow are
//   listed; system channels only for a filter on 39000-39003 with #t system
//   or any #P; a filter that names the channel (#h, or #d on 39000-39003)
//   reads it under the ordinary rule: a member, or an open channel.
//
// This relay's policy, where NIP-CL leaves it open: a 9007 without a
// channel_type tag creates a stream; a dm channel is always private; a
// system channel is private unless ["visibility", "open"].
#load "nip29.coax";
#load "../../tests/nostr/nipcl_fixtures.coax";
#authority;

CL_OK :: 0; CL_SHAPE :: 1; CL_LABEL :: 2; CL_RESERVED :: 3; CL_TOO_MANY :: 4;
CL_MIXED :: 5; CL_TYPE :: 6; CL_GROUP :: 7; CL_SIGNER :: 8; CL_KIND :: 9;
CL_MAX_LABELS :: 8; CL_MAX_LABEL :: 64;
CL_KEEP :: 0; CL_SET :: 1; CL_CLEAR :: 2;
// book:begin types
CL_TYPES :: [5]string.["stream","forum","dm","workflow","system"];
CL_LEGACY :: 4;   // the first four: the types every client knew before NIP-CL
// book:end types

// book:begin state
// What the relay records for a channel beside its NIP-29 state, and what a
// client reads back from a 39000 it signed. has_* false means unknown.
ClChannel :: struct {
  status:int=CL_OK; id:G29Name;
  has_type:bool; type:G29Name;
  labels:[CL_MAX_LABELS]G29Name; labels_n:int;
  has_creator:bool; creator:[32]u8;
  has_created:bool; created:int;
}
ClLabels :: struct {status:int=CL_OK; mode:int=CL_KEEP; labels:[CL_MAX_LABELS]G29Name; n:int;}
// book:end state

cl_fail :: (l:ClLabels,status:int)->ClLabels {r:=l;r.status=status;return r;}
cl_type_index :: (t:G29Name)->int {for i:0..<CL_TYPES.count {if g29_is(t,CL_TYPES[i]) {return i;}}return -1;}

// book:begin one-label
// One label value: 1 to 64 bytes from a-z, 0-9, '.', ':' and '-', and no type name.
cl_label :: (t:G29Name)->int {
  c:=t;if c.n<1 || c.n>CL_MAX_LABEL {return CL_LABEL;}
  for i:0..<c.n {
    b:=c.b[i];
    ok:=(b>='a' && b<='z') || (b>='0' && b<=':') || b=='.' || b=='-';   // ':' follows '9'
    if !ok {return CL_LABEL;}
  }
  if cl_type_index(t)>=0 {return CL_RESERVED;}
  return CL_OK;
}
// book:end one-label

// book:begin label-set
// The t tags of a create or edit command: keep (no t tag), clear (only
// ["t", ""]) or set (the distinct labels in order). Any fault refuses the
// whole event.
cl_labels :: (e:NostrEvent)->ClLabels {
  l:ClLabels;k:=0;cleared:=false;
  while true {
    t:=g29_tag(e,k);k+=1;
    if t.error==NT_INDEX {break;}
    if t.error!=NT_OK {return cl_fail(l,CL_SHAPE);}
    if !g29_tag_is(t,0,"t") {continue;}
    if t.values<2 || t.v[1].n>CL_MAX_LABEL {return cl_fail(l,CL_LABEL);}
    v:=g29_text(cast(string)t.v[1].b[0..<t.v[1].n]);
    if v.n==0 {cleared=true;continue;}
    s:=cl_label(v);if s!=CL_OK {return cl_fail(l,s);}
    seen:=false;for i:0..<l.n {if g29_same(l.labels[i],v) {seen=true;}}
    if seen {continue;}
    if l.n==CL_MAX_LABELS {return cl_fail(l,CL_TOO_MANY);}
    l.labels[l.n]=v;l.n+=1;
  }
  if cleared && l.n>0 {return cl_fail(l,CL_MIXED);}
  if cleared {l.mode=CL_CLEAR;} else if l.n>0 {l.mode=CL_SET;}
  return l;
}
// book:end label-set

// The value of the first tag named name, or "" when there is none.
cl_value :: (e:NostrEvent,name:string)->G29Name {
  k:=0;none:G29Name;
  while true {
    t:=g29_tag(e,k);k+=1;
    if t.error!=NT_OK {return none;}
    if g29_tag_is(t,0,name) && t.values>=2 && t.v[1].n<=G29_MAX_NAME {return g29_text(cast(string)t.v[1].b[0..<t.v[1].n]);}
  }
  return none;
}

// book:begin admit
// A verified 9007 or 9002 for the channel c[0] and group g[0]: labels and
// type checked first, then NIP-29's decision. CL_GROUP: g29_admit refused,
// with its code in g29[0]. Other kinds go to g29_admit unchanged.
cl_admit :: (g:[]G29Group,c:[]ClChannel,e:NostrEvent,relay:[32]u8,now:int,g29:[]int)->int {
  g29[0]=G29_OK;
  if e.kind!=G29_CREATE_GROUP && e.kind!=G29_EDIT_METADATA {
    g29[0]=g29_admit(g,e,relay);return ifx g29[0]==G29_OK then CL_OK else CL_GROUP;
  }
  if e.error!=NE_OK || !e.verified {g29[0]=G29_EVENT;return CL_GROUP;}
  l:=cl_labels(e);if l.status!=CL_OK {return l.status;}
  type:=g29_text("stream");
  if e.kind==G29_CREATE_GROUP {
    given:=cl_value(e,"channel_type");
    if given.n>0 {type=given;}
    if cl_type_index(type)<0 {return CL_TYPE;}
  }
  g29[0]=g29_admit(g,e,relay);
  if g29[0]!=G29_OK {return CL_GROUP;}
  if e.kind==G29_CREATE_GROUP {
    fresh:ClChannel;c[0]=fresh;
    c[0].id=g[0].id;c[0].has_type=true;c[0].type=type;
    c[0].has_creator=true;c[0].creator=e.public_key;c[0].has_created=true;c[0].created=now;
    open:=g29_is(cl_value(e,"visibility"),"open");
    if g29_is(type,"dm") || (g29_is(type,"system") && !open) {g[0].is_private=true;g[0].hidden=true;}
  }
  if l.mode!=CL_KEEP {c[0].labels=l.labels;c[0].labels_n=l.n;}
  return CL_OK;
}
// book:end admit

// book:begin write
// The 39000 tags the relay signs: NIP-29's metadata, then the identity tags.
cl_write_metadata :: (g:G29Group,c:ClChannel,out:[]u8)->int {
  n:=g29_write_metadata(g,out)-1;   // drop its closing ]; -1 stays a failure
  n=json_raw(out,n,",[\"t\",");n=g29_put_name(out,n,c.type);n=json_raw(out,n,"]");
  for i:0..<c.labels_n {n=json_raw(out,n,",[\"t\",");n=g29_put_name(out,n,c.labels[i]);n=json_raw(out,n,"]");}
  n=json_raw(out,n,",[\"P\",");n=g29_put_key(out,n,c.creator);n=json_raw(out,n,"]");
  digits:[20]u8;d:=0;v:=c.created;
  while true {digits[19-d]=cast(u8)('0'+v%10);d+=1;v/=10;if v==0 {break;}}
  n=json_raw(out,n,",[\"created_at\",\"");n=json_raw(out,n,cast(string)digits[20-d..<20]);
  return json_raw(out,n,"\"]]");
}
// book:end write

// A decimal string with no sign, no leading zero and at most 18 digits.
cl_decimal :: (v:N32Text,out:[]int)->bool {
  c:=v;if c.n<1 || c.n>18 || (c.b[0]=='0' && c.n>1) {return false;}
  x:=0;for i:0..<c.n {if c.b[i]<'0' || c.b[i]>'9' {return false;}x=x*10+cast(int)(c.b[i]-'0');}
  out[0]=x;return true;
}
// book:begin read
// A channel-state event read back by a client. It must be a 39000 to 39002
// signed by the relay's key. A missing tag stays unknown; a malformed one
// refuses.
cl_read :: (e:NostrEvent,relay:[32]u8)->ClChannel {
  c:ClChannel;
  if e.error!=NE_OK || !e.verified {c.status=CL_SHAPE;return c;}
  if e.kind<G29_METADATA || e.kind>G29_MEMBERS {c.status=CL_KIND;return c;}
  if !ns_equal32(e.public_key,relay) {c.status=CL_SIGNER;return c;}
  k:=0;
  while true {
    t:=g29_tag(e,k);k+=1;
    if t.error==NT_INDEX {return c;}
    if t.error!=NT_OK {c.status=CL_SHAPE;return c;}
    // A valueless P or created_at fails its own reading below.
    if (g29_tag_is(t,0,"d") || g29_tag_is(t,0,"t")) && t.values<2 {c.status=CL_SHAPE;return c;}
    one:[1]G29Name;
    if g29_tag_is(t,0,"d") {if g29_name(t.v[1],one[..])!=G29_OK {c.status=CL_SHAPE;return c;}c.id=one[0];}
    else if g29_tag_is(t,0,"t") {
      if g29_name(t.v[1],one[..])!=G29_OK {c.status=CL_SHAPE;return c;}
      if !c.has_type {c.type=one[0];c.has_type=true;}
      else {if c.labels_n==CL_MAX_LABELS {c.status=CL_TOO_MANY;return c;}c.labels[c.labels_n]=one[0];c.labels_n+=1;}
    }
    else if g29_tag_is(t,0,"P") {if !g29_key(t.v[1],c.creator[..]) {c.status=CL_SHAPE;return c;}c.has_creator=true;}
    else if g29_tag_is(t,0,"created_at") && e.kind==G29_METADATA {
      x:[1]int;if !cl_decimal(t.v[1],x[..]) {c.status=CL_SHAPE;return c;}
      c.created=x[0];c.has_created=true;
    }
  }
  return c;
}
// book:end read

// Is a's channel id before b's, compared bytewise as strings?
cl_id_before :: (a:G29Name,b:G29Name)->bool {
  // Bytes past a name's length are zero, so a prefix sorts first.
  x:=a;y:=b;
  for i:0..<G29_MAX_NAME {if x.b[i]<y.b[i] {return true;}if x.b[i]>y.b[i] {return false;}}
  return x.n<y.n;
}
// book:begin oldest
// Does a rank before b? Lower created_at first; a known time before an
// unknown one; then the lower channel id.
cl_before :: (a:ClChannel,b:ClChannel)->bool {
  if a.has_created!=b.has_created {return a.has_created;}
  if a.has_created {if a.created<b.created {return true;}if a.created>b.created {return false;}}
  return cl_id_before(a.id,b.id);
}
// The index of the oldest channel, or -1 for none.
cl_oldest :: (cs:[]ClChannel)->int {
  best:= -1;
  for i:0..<cs.count {if best<0 || cl_before(cs[i],cs[best]) {best=i;}}
  return best;
}
// book:end oldest

// book:begin listed
// A read filter, as far as NIP-CL's visibility rule needs it.
ClFilter :: struct {
  names:bool;           // #h has the channel id, or #d with kinds all in 39000-39003
  state_only:bool;      // every kind in the filter is 39000-39003
  t:[CL_MAX_LABELS]G29Name; t_n:int;
  has_P:bool;
}
cl_has_t :: (f:ClFilter,s:string)->bool {for i:0..<f.t_n {if g29_is(f.t[i],s) {return true;}}return false;}
// Does this filter return the channel to a reader? member: the reader is
// in the channel's member list. Matching the filter's own tags is NIP-01's.
cl_listed :: (g:G29Group,c:ClChannel,f:ClFilter,member:bool)->bool {
  readable:=member || !g.is_private;
  if f.names {return readable;}
  i:=cl_type_index(c.type);
  if i>=0 && i<CL_LEGACY {return readable;}
  if g29_is(c.type,"system") && f.state_only && (cl_has_t(f,"system") || f.has_P) {return readable;}
  return false;
}
// Does a 44100 or 44101 notice reach a filter? has_type false: a notice
// stored before the rule, which is about a legacy type.
cl_notice :: (has_type:bool,type:G29Name,f:ClFilter)->bool {
  if !has_type {
    if f.t_n==0 {return true;}
    for i:0..<CL_LEGACY {if cl_has_t(f,CL_TYPES[i]) {return true;}}
    return false;
  }
  if f.t_n>0 {c:=type;return cl_has_t(f,cast(string)c.b[0..<c.n]);}
  i:=cl_type_index(type);return i>=0 && i<CL_LEGACY;
}
// book:end listed

// ---- checks (helpers in coax/tests/nostr/nipcl_fixtures.coax)
#test "labels: valid, reserved, too many, mixed, repeated" {
  tb:[512]u8;
  #assert cl_label(g29_text("agent-config"))==CL_OK && cl_label(g29_text("a.b:c-9"))==CL_OK && cl_label(g29_text("z"))==CL_OK;
  #assert cl_label(g29_text(""))==CL_LABEL && cl_label(g29_text("Agent"))==CL_LABEL && cl_label(g29_text("a b"))==CL_LABEL;
  #assert cl_label(g29_text("a_b"))==CL_LABEL && cl_label(g29_text("a/b"))==CL_LABEL && cl_label(g29_text("a;"))==CL_LABEL;
  #assert cl_label(g29_text("`"))==CL_LABEL && cl_label(g29_text("{"))==CL_LABEL && cl_label(g29_text("/"))==CL_LABEL && cl_label(g29_text("@"))==CL_LABEL;
  #assert cl_label(g29_text("9"))==CL_OK && cl_label(g29_text("0"))==CL_OK && cl_label(g29_text("a"))==CL_OK && cl_label(g29_text(":"))==CL_OK;
  for s:CL_TYPES {#assert cl_label(g29_text(s))==CL_RESERVED;}
  #assert cl_label(g29_text("streams"))==CL_OK && cl_label(clf_long(64))==CL_OK && cl_label(clf_long(65))==CL_LABEL;
  l:=cl_labels(nt_event("[[\"h\",\"x\"]]"));#assert l.status==CL_OK && l.mode==CL_KEEP && l.n==0;
  l=cl_labels(nt_event("[[\"t\",\"workspace\"],[\"t\",\"notes\"],[\"t\",\"workspace\"]]"));
  #assert l.status==CL_OK && l.mode==CL_SET && l.n==2 && g29_is(l.labels[0],"workspace") && g29_is(l.labels[1],"notes");
  l=cl_labels(nt_event("[[\"t\",\"\"],[\"t\",\"\"]]"));#assert l.status==CL_OK && l.mode==CL_CLEAR && l.n==0;
  #assert cl_labels(nt_event("[[\"t\",\"\"],[\"t\",\"notes\"]]")).status==CL_MIXED && cl_labels(nt_event("[[\"t\",\"notes\"],[\"t\",\"\"]]")).status==CL_MIXED;
  #assert cl_labels(nt_event("[[\"t\",\"dm\"]]")).status==CL_RESERVED && cl_labels(nt_event("[[\"t\",\"Notes\"]]")).status==CL_LABEL;
  #assert cl_labels(nt_event("[[\"t\"]]")).status==CL_LABEL && cl_labels(nt_event("[[\"t\",1]]")).status==CL_SHAPE;
  eight:="[[\"t\",\"a\"],[\"t\",\"b\"],[\"t\",\"c\"],[\"t\",\"d\"],[\"t\",\"e\"],[\"t\",\"f\"],[\"t\",\"g\"],[\"t\",\"h\"],[\"t\",\"a\"]]";
  l=cl_labels(nt_event(eight));#assert l.status==CL_OK && l.n==8 && g29_is(l.labels[7],"h");
  #assert cl_labels(nt_event("[[\"t\",\"a\"],[\"t\",\"b\"],[\"t\",\"c\"],[\"t\",\"d\"],[\"t\",\"e\"],[\"t\",\"f\"],[\"t\",\"g\"],[\"t\",\"h\"],[\"t\",\"i\"]]")).status==CL_TOO_MANY;
  #assert cl_labels(clf_tag_event("t",65,tb[..])).status==CL_LABEL && cl_labels(clf_tag_event("t",64,tb[..])).status==CL_OK;
}
#test "create and edit: type, creator, time, labels kept, set and cleared" {
  g:[1]G29Group;c:[1]ClChannel;n:[1]int;
  #assert clf_do(g[..],c[..],9007,0xaa,0x01,"[[\"h\",\"cfg\"],[\"channel_type\",\"system\"],[\"t\",\"agent-config\"]]",n[..])==CL_OK;
  #assert g29_is(c[0].type,"system") && c[0].has_creator && c[0].creator[0]==0xaa && c[0].created==CLF_NOW && c[0].labels_n==1;
  #assert g[0].is_private && g[0].hidden && g29_is(c[0].id,"cfg") && c[0].has_type && c[0].has_created;
  #assert clf_do(g[..],c[..],9002,0xaa,0x02,"[[\"h\",\"cfg\"],[\"name\",\"Config\"]]",n[..])==CL_OK && c[0].labels_n==1 && c[0].creator[0]==0xaa;
  #assert clf_do(g[..],c[..],9002,0xaa,0x03,"[[\"h\",\"cfg\"],[\"t\",\"x\"],[\"t\",\"y\"]]",n[..])==CL_OK && c[0].labels_n==2 && g29_is(c[0].labels[1],"y");
  #assert clf_do(g[..],c[..],9002,0xaa,0x04,"[[\"h\",\"cfg\"],[\"t\",\"\"]]",n[..])==CL_OK && c[0].labels_n==0;
  // Only an owner or admin edits: NIP-29 refuses the member's edit, labels untouched.
  #assert clf_do(g[..],c[..],9000,0xaa,0x05,"[[\"h\",\"cfg\"],[\"p\",\"^b\"]]",n[..])==CL_OK;
  #assert clf_do(g[..],c[..],9002,0xbb,0x06,"[[\"h\",\"cfg\"],[\"t\",\"z\"]]",n[..])==CL_GROUP && n[0]==G29_NOT_ALLOWED && c[0].labels_n==0;
  n[0]=99;#assert clf_do(g[..],c[..],9002,0xaa,0x07,"[[\"h\",\"cfg\"],[\"t\",\"stream\"]]",n[..])==CL_RESERVED && n[0]==G29_OK;
  #assert clf_do(g[..],c[..],9,0xbb,0x08,"[[\"h\",\"cfg\"]]",n[..])==CL_OK && n[0]==G29_OK;
  #assert clf_do(g[..],c[..],9,0xcc,0x09,"[[\"h\",\"cfg\"]]",n[..])==CL_OK && clf_do(g[..],c[..],9,0xcc,0x0a,"[[\"h\",\"nope\"]]",n[..])==CL_GROUP && n[0]==G29_NO_GROUP;
  // A second create, or a create of an unknown type, refuses; the record stands.
  #assert clf_do(g[..],c[..],9007,0xbb,0x0b,"[[\"h\",\"cfg\"]]",n[..])==CL_GROUP && n[0]==G29_EXISTS && c[0].creator[0]==0xaa;
  h:[1]G29Group;d:[1]ClChannel;
  #assert clf_do(h[..],d[..],9007,0xaa,0x0c,"[[\"h\",\"x\"],[\"channel_type\",\"x\"]]",n[..])==CL_TYPE;
  d[0].labels_n=3;
  #assert clf_do(h[..],d[..],9007,0xaa,0x0c,"[[\"h\",\"x\"],[\"channel_type\",\"chat\"]]",n[..])==CL_TYPE && !h[0].exists;
  #assert clf_do(h[..],d[..],9007,0xaa,0x0d,"[[\"h\",\"x\"],[\"t\",\"a b\"]]",n[..])==CL_LABEL && !h[0].exists;
  #assert clf_do(h[..],d[..],9007,0xaa,0x0e,"[[\"h\",\"x\"]]",n[..])==CL_OK && g29_is(d[0].type,"stream") && d[0].labels_n==0 && !h[0].is_private && !h[0].hidden;
  #assert clf_do(h[..],d[..],9007,0xaa,0x0f,"[[\"h\",\"y\"],[\"channel_type\",\"forum\"]]",n[..])==CL_GROUP;
  for i:0..<5 {
    k:[1]G29Group;m:[1]ClChannel;tags:[128]u8;tn:=json_raw(tags[..],0,"[[\"h\",\"q\"],[\"channel_type\",\"");tn=json_raw(tags[..],tn,CL_TYPES[i]);tn=json_raw(tags[..],tn,"\"]]");
    #assert clf_do(k[..],m[..],9007,0xaa,0x10,cast(string)tags[0..<tn],n[..])==CL_OK && g29_is(m[0].type,CL_TYPES[i]);
    #assert k[0].is_private==(i>=2 && i!=3) && k[0].hidden==k[0].is_private;
  }
  s:[1]G29Group;t:[1]ClChannel;
  #assert clf_do(s[..],t[..],9007,0xaa,0x11,"[[\"h\",\"s\"],[\"channel_type\",\"system\"],[\"visibility\",\"open\"]]",n[..])==CL_OK && !s[0].is_private;
  u:[1]G29Group;v:[1]ClChannel;
  #assert clf_do(u[..],v[..],9007,0xaa,0x12,"[[\"h\",\"s\"],[\"channel_type\",\"system\"],[\"visibility\",\"closed\"]]",n[..])==CL_OK && u[0].is_private;
  tb:[512]u8;w:[1]G29Group;x:[1]ClChannel;buf:[512]u8;e:=g29_ev(9007,0xaa,0x13,"[[\"h\",\"w\"]]",buf[..]);e.verified=false;
  #assert cl_admit(w[..],x[..],e,g29_k(G29_T_RELAY),CLF_NOW,n[..])==CL_GROUP && n[0]==G29_EVENT && !w[0].exists;
  e.verified=true;e.error=NE_ID;#assert cl_admit(w[..],x[..],e,g29_k(G29_T_RELAY),CLF_NOW,n[..])==CL_GROUP && n[0]==G29_EVENT;
  #assert clf_do(w[..],x[..],9007,0xaa,0x14,"[[\"h\",\"w\"],[\"t\",1]]",n[..])==CL_SHAPE;
  #assert cl_value(nt_event("[[\"a\"],[\"channel_type\"],[\"channel_type\",\"dm\"]]"),"channel_type").n==2 && cl_value(nt_event("[1]"),"x").n==0;
  #assert cl_value(clf_tag_event("channel_type",65,tb[..]),"channel_type").n==0 && cl_value(clf_tag_event("channel_type",64,tb[..]),"channel_type").n==64;
}
#test "the 39000 the relay signs, read back" {
  g:[1]G29Group;c:[1]ClChannel;n:[1]int;out:[1024]u8;
  #assert clf_do(g[..],c[..],9007,0xaa,0x01,"[[\"h\",\"cfg\"],[\"channel_type\",\"system\"],[\"t\",\"agent-config\"],[\"t\",\"v2\"]]",n[..])==CL_OK;
  #assert g29_out_is(cl_write_metadata(g[0],c[0],out[..]),out[..],CLF_CFG_TAGS);
  c[0].created=0;#assert g29_out_is(cl_write_metadata(g[0],c[0],out[..]),out[..],"[[\"d\",\"cfg\"],[\"private\"],[\"hidden\"],[\"t\",\"system\"],[\"t\",\"agent-config\"],[\"t\",\"v2\"],[\"P\",\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"],[\"created_at\",\"0\"]]");
  small:[8]u8;#assert cl_write_metadata(g[0],c[0],small[..])== -1;
  r:=clf_read(39000,0xee,CLF_CFG_TAGS);
  #assert r.status==CL_OK && g29_is(r.id,"cfg") && g29_is(r.type,"system") && r.labels_n==2 && g29_is(r.labels[0],"agent-config") && r.creator[0]==0xaa && r.has_creator && r.created==CLF_NOW && r.has_created;
  // An older event without the tags: everything unknown.
  r=clf_read(39000,0xee,"[[\"d\",\"cfg\"],[\"name\",\"x\"]]");#assert r.status==CL_OK && !r.has_type && !r.has_creator && !r.has_created && r.labels_n==0;
  // created_at is read on 39000 only; P and t on 39000 to 39002.
  r=clf_read(39002,0xee,"[[\"d\",\"c\"],[\"t\",\"dm\"],[\"P\",\"^a\"],[\"created_at\",\"5\"]]");#assert r.status==CL_OK && r.has_type && r.has_creator && !r.has_created;
  #assert clf_read(39001,0xee,"[[\"d\",\"c\"]]").status==CL_OK && clf_read(39003,0xee,"[[\"d\",\"c\"]]").status==CL_KIND && clf_read(38999,0xee,"[]").status==CL_KIND;
  #assert clf_read(39000,0xdd,"[[\"d\",\"c\"]]").status==CL_SIGNER;
  #assert clf_read(39000,0xee,"[[\"P\",\"<creator public key>\"]]").status==CL_SHAPE && clf_read(39000,0xee,"[[\"created_at\",\"01\"]]").status==CL_SHAPE;
  #assert clf_read(39000,0xee,"[[\"created_at\",\"1x\"]]").status==CL_SHAPE && clf_read(39000,0xee,"[[\"created_at\",\"\"]]").status==CL_SHAPE;
  #assert clf_read(39000,0xee,"[[\"created_at\",\"1234567890123456789\"]]").status==CL_SHAPE && clf_read(39000,0xee,"[[\"created_at\",\"123456789012345678\"]]").created==123456789012345678;
  r=clf_read(39000,0xee,"[[\"created_at\",\"0\"]]");#assert r.status==CL_OK && r.has_created && r.created==0;
  r=clf_read(39000,0xee,"[[\"created_at\",\"7\"]]");#assert r.status==CL_OK && r.created==7;
  #assert clf_read(39000,0xee,"[[\"created_at\",\"/\"]]").status==CL_SHAPE && clf_read(39000,0xee,"[[\"created_at\",\":\"]]").status==CL_SHAPE;
  #assert clf_read(39000,0xee,"[[\"d\"]]").status==CL_SHAPE && clf_read(39000,0xee,"[[\"d\",\"^dx\"]]").status==CL_SHAPE && clf_read(39000,0xee,"[[\"t\",\"^dx\"]]").status==CL_SHAPE;
  #assert clf_read(39000,0xee,"[[\"t\",\"a\"],[\"t\",\"b\"],[\"t\",\"c\"],[\"t\",\"d\"],[\"t\",\"e\"],[\"t\",\"f\"],[\"t\",\"g\"],[\"t\",\"h\"],[\"t\",\"i\"]]").labels_n==8;
  #assert clf_read(39000,0xee,"[[\"t\",\"a\"],[\"t\",\"b\"],[\"t\",\"c\"],[\"t\",\"d\"],[\"t\",\"e\"],[\"t\",\"f\"],[\"t\",\"g\"],[\"t\",\"h\"],[\"t\",\"i\"],[\"t\",\"j\"]]").status==CL_TOO_MANY;
  #assert clf_read(39000,0xee,"[[\"x\",1]]").status==CL_SHAPE && clf_read(39000,0xee,"[[\"t\"]]").status==CL_SHAPE && clf_read(39000,0xee,"[[\"P\"]]").status==CL_SHAPE;
  #assert clf_read(39000,0xee,"[[\"created_at\"]]").status==CL_SHAPE && clf_read(39000,0xee,"[[\"hidden\"]]").status==CL_OK;
  buf:[256]u8;e:=g29_ev(39000,0xee,0x01,"[]",buf[..]);e.verified=false;#assert cl_read(e,g29_k(0xee)).status==CL_SHAPE;
  e.verified=true;e.error=NE_ID;#assert cl_read(e,g29_k(0xee)).status==CL_SHAPE;
}
#test "the oldest channel: time, then id; unknown time last" {
  cs:=[4]ClChannel.[clf_ch("b",true,200),clf_ch("c",true,100),clf_ch("a",true,100),clf_ch("0",false,0)];
  #assert cl_oldest(cs[..])==2 && cl_oldest(cs[0..<2])==1 && cl_oldest(cs[3..<4])==0 && cl_oldest(cs[0..<0])== -1;
  #assert cl_before(cs[1],cs[3]) && !cl_before(cs[3],cs[1]) && cl_before(cs[2],cs[1]) && !cl_before(cs[1],cs[2]) && !cl_before(cs[0],cs[1]);
  #assert cl_before(clf_ch("a",false,9),clf_ch("b",false,0)) && !cl_before(clf_ch("b",false,0),clf_ch("a",false,9));
  #assert cl_before(clf_ch("b",true,1),clf_ch("a",true,2)) && !cl_before(clf_ch("a",true,2),clf_ch("b",true,1)) && cl_before(clf_ch("a",true,2),clf_ch("b",true,2));
  #assert cl_id_before(g29_text("ab"),g29_text("abc")) && !cl_id_before(g29_text("abc"),g29_text("ab")) && !cl_id_before(g29_text("a"),g29_text("a"));
  #assert cl_id_before(g29_text("9b"),g29_text("a")) && !cl_id_before(g29_text("b"),g29_text("ab"));
  // Two equal ones: the first stays.
  two:=[2]ClChannel.[clf_ch("a",true,5),clf_ch("a",true,5)];#assert cl_oldest(two[..])==0;
}
#test "listed: legacy types, the system opt-in, naming, notices" {
  open:G29Group;closed:G29Group;closed.is_private=true;
  stream:=clf_ch("s",true,1);stream.type=g29_text("stream");
  sys:=clf_ch("y",true,1);sys.type=g29_text("system");
  later:=clf_ch("z",true,1);later.type=g29_text("canvas");
  dm:=clf_ch("d",true,1);dm.type=g29_text("dm");
  plain:ClFilter;plain.state_only=true;
  #assert cl_listed(open,stream,plain,false) && !cl_listed(closed,stream,plain,false) && cl_listed(closed,stream,plain,true);
  #assert !cl_listed(closed,dm,plain,false) && cl_listed(closed,dm,plain,true);
  #assert !cl_listed(open,sys,plain,true) && !cl_listed(open,later,plain,true);
  ask:=plain;ask.t[0]=g29_text("system");ask.t_n=1;
  #assert cl_listed(open,sys,ask,false) && !cl_listed(closed,sys,ask,false) && cl_listed(closed,sys,ask,true) && !cl_listed(open,later,ask,true);
  byp:=plain;byp.has_P=true;#assert cl_listed(open,sys,byp,false) && !cl_listed(open,later,byp,true);
  msgs:=ask;msgs.state_only=false;#assert !cl_listed(open,sys,msgs,true);
  msgs.has_P=true;msgs.t_n=0;#assert !cl_listed(open,sys,msgs,true);
  label:=plain;label.t[0]=g29_text("agent-config");label.t_n=1;#assert !cl_listed(open,sys,label,true);
  named:ClFilter;named.names=true;
  #assert cl_listed(open,sys,named,false) && cl_listed(open,later,named,false) && !cl_listed(closed,later,named,false) && cl_listed(closed,later,named,true);
  for i:0..<4 {ch:=clf_ch("l",true,1);ch.type=g29_text(CL_TYPES[i]);#assert cl_listed(open,ch,plain,false);}
  // Notices: #t picks types; no #t means legacy only; untyped notices are legacy.
  none:ClFilter;#assert cl_notice(true,g29_text("stream"),none) && cl_notice(true,g29_text("workflow"),none) && !cl_notice(true,g29_text("system"),none) && !cl_notice(true,g29_text("canvas"),none);
  #assert cl_notice(false,g29_text(""),none) && cl_notice(false,g29_text(""),ask)==false;
  #assert cl_notice(true,g29_text("system"),ask) && !cl_notice(true,g29_text("stream"),ask);
  dmf:ClFilter;dmf.t[0]=g29_text("system");dmf.t[1]=g29_text("dm");dmf.t_n=2;#assert cl_notice(false,g29_text(""),dmf) && cl_notice(true,g29_text("dm"),dmf);
  for i:0..<4 {f:ClFilter;f.t[0]=g29_text(CL_TYPES[i]);f.t_n=1;#assert cl_notice(false,g29_text(""),f);}
  #assert cl_has_t(dmf,"dm") && !cl_has_t(dmf,"forum");
}
