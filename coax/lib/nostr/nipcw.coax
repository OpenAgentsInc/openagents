// Block's NIP-CW, channel and thread windows: pages of one channel's
// messages in the total order created_at descending, then id ascending
// (bytewise), with a composite (created_at, id) cursor that is exact when
// many messages share one second.
//
// - cw_tags and cw_ingest: an event is a reply only when it carries an e
//   tag marked "reply". Its depth is its parent's depth + 1 (at most 100);
//   the parent must be stored in the same channel, and a root-marked e tag
//   must name the parent's root. ["broadcast", "1"] puts a depth-1 reply on
//   the channel timeline too. Kinds 39005 to 39007 are the relay's own and
//   refuse at ingest.
// - cw_check: a request names exactly one channel, sends until and
//   before_id together or not at all, and a malformed cursor refuses rather
//   than becoming a head request. Channel mode clamps limit to 1..200
//   (default 50); thread mode refuses outside 1..200, depth_limit outside
//   1..100 (default 100), and kinds other than 1 to 4 of 9, 40002, 45001,
//   45003.
// - cw_window: for a reader who can read the channel, the rows (top-level
//   rows in channel mode: depth 0, depth unknown, or a broadcast depth-1
//   reply; one root's replies to depth_limit in thread mode), not deleted
//   and of the asked kinds, after the cursor; limit + 1 are probed after
//   every predicate, so has_more is exact and the extra row never shows.
//   next_cursor is the last row of the page when has_more, else none. A
//   reader who cannot read the channel, or a thread whose root is missing,
//   gets no rows and no bounds: no window was served.
// - cw_aux: the reactions (7), deletions (5, 9005) and edits (40003) whose
//   e tag names a returned row, then the deletions of those.
// - cw_view: what a client may show from a channel-mode response. Without
//   exactly one valid 39006 bound to the cursor it sent, the response is not
//   a page: never an empty channel. Only a served head page with no rows and
//   has_more false shows the channel as empty.
//
// Not built here: the 39005 summaries' counts, the 39007 request binding
// hash, the legacy oldest-first thread path, signing the overlays (the
// relay's key) and summary recovery after deletion.
#load "nip29.coax";
#load "../../tests/nostr/nipcw_fixtures.coax";
#authority;

CW_OK :: 0; CW_EVENT :: 1; CW_SHAPE :: 2; CW_PARENT :: 3; CW_DEPTH :: 4; CW_ROOT :: 5;
CW_RELAY_ONLY :: 6; CW_FULL :: 7; CW_CHANNELS :: 8; CW_CURSOR :: 9; CW_LIMIT :: 10;
CW_KINDS :: 11; CW_ROOTS :: 12;
CW_MAX_DEPTH :: 100; CW_MAX_LIMIT :: 200; CW_DEFAULT_LIMIT :: 50;
CW_UNKNOWN :: -1;   // the depth of a row stored before the relay classified rows
CW_THREAD_KINDS :: [4]int.[9,40002,45001,45003];
// What a client shows from a channel-mode response.
CW_VIEW_PAGE :: 0; CW_VIEW_EMPTY :: 1; CW_VIEW_NONE :: 2; CW_VIEW_DISCARD :: 3;

// book:begin row
// One stored channel event, as the window reads it.
CwRow :: struct {
  created_at:int; id:[32]u8; kind:int;
  depth:int; broadcast:bool; deleted:bool;
  parent:[32]u8; root:[32]u8;     // for a reply: its parent and its thread's root
}
// book:end row
CwTags :: struct {status:int=CW_OK; reply:bool; parent:[32]u8; has_root:bool; root:[32]u8; broadcast:bool;}

// book:begin classify
// An event's thread tags: the reply-marked e tag (at most one), the
// root-marked one, and ["broadcast", "1"] exactly.
cw_tags :: (e:NostrEvent)->CwTags {
  r:CwTags;k:=0;
  while true {
    t:=nostr_tag(e,k);g:=g29_tag(e,k);k+=1;
    if t.error==NT_INDEX {return r;}
    if t.error!=NT_OK {r.status=CW_SHAPE;return r;}
    if t.type==NT_E && t.marker==NT_MARK_REPLY {
      if r.reply {r.status=CW_SHAPE;return r;}
      r.reply=true;r.parent=t.id;
    }
    if t.type==NT_E && t.marker==NT_MARK_ROOT {r.has_root=true;r.root=t.id;}
    if g29_tag_is(g,0,"broadcast") && g.values==2 && g29_tag_is(g,1,"1") {r.broadcast=true;}
  }
  return r;
}
// book:end classify

cw_find :: (rows:[]CwRow,n:int,id:[32]u8)->int {
  for i:0..<n {if ns_equal32(rows[i].id,id) {return i;}}
  return -1;
}
// book:begin ingest
// Store one verified event of the channel in rows[0..<n[0]].
cw_ingest :: (rows:[]CwRow,n:[]int,e:NostrEvent)->int {
  if e.error!=NE_OK || !e.verified {return CW_EVENT;}
  if e.kind>=39005 && e.kind<=39007 {return CW_RELAY_ONLY;}
  t:=cw_tags(e);if t.status!=CW_OK {return t.status;}
  r:CwRow;r.created_at=e.created_at;r.id=e.id;r.kind=e.kind;r.broadcast=t.broadcast;
  if t.reply {
    p:=cw_find(rows,n[0],t.parent);if p<0 {return CW_PARENT;}
    r.depth=rows[p].depth+1;
    if r.depth>CW_MAX_DEPTH {return CW_DEPTH;}
    r.parent=t.parent;r.root=ifx rows[p].depth==0 then rows[p].id else rows[p].root;
    if t.has_root && !ns_equal32(t.root,r.root) {return CW_ROOT;}
  }
  if n[0]==rows.count {return CW_FULL;}
  rows[n[0]]=r;n[0]+=1;return CW_OK;
}
// book:end ingest
// A deletion the channel admitted: the row leaves every window.
cw_delete :: (rows:[]CwRow,n:int,id:[32]u8)->bool {
  i:=cw_find(rows,n,id);if i<0 {return false;}
  rows[i].deleted=true;return true;
}

// book:begin request
CwRequest :: struct {
  thread:bool;                          // thread_window: true, else top_level: true
  channels:int;                         // values in #h
  roots:int; root:[32]u8;               // values in #e (thread mode)
  has_limit:bool; limit:int;
  has_depth:bool; depth_limit:int;
  kinds:[4]int; kinds_n:int;
  has_until:bool; until:int;
  has_before:bool; before:string;       // 64 hex digits as sent
}
CwPage :: struct {
  status:int=CW_OK; served:bool;
  limit:int; clamped:bool;              // clamped: channel mode moved limit into 1..200
  depth_limit:int; kinds:[4]int; kinds_n:int;
  head:bool; at:int; after:[32]u8;      // the request cursor
  n:int; has_more:bool; next_at:int; next_id:[32]u8;
}
// book:end request
cw_refuse :: (p:CwPage,status:int)->CwPage {r:=p;r.status=status;return r;}
cw_nibble :: (c:u8)->int {
  if c>='0' && c<='9' {return cast(int)(c-'0');}
  if c>='a' && c<='f' {return cast(int)(c-'a')+10;}
  if c>='A' && c<='F' {return cast(int)(c-'A')+10;}
  return -1;
}
// book:begin check
cw_check :: (r:CwRequest)->CwPage {
  p:CwPage;p.head=true;
  if r.channels!=1 {return cw_refuse(p,CW_CHANNELS);}
  if r.has_until!=r.has_before {return cw_refuse(p,CW_CURSOR);}
  if r.has_until {
    if r.until<0 || r.before.count!=64 {return cw_refuse(p,CW_CURSOR);}
    for i:0..<32 {
      hi:=cw_nibble(r.before[2*i]);lo:=cw_nibble(r.before[2*i+1]);
      if hi<0 || lo<0 {return cw_refuse(p,CW_CURSOR);}
      p.after[i]=cast(u8)(hi*16+lo);
    }
    p.head=false;p.at=r.until;
  }
  p.limit=ifx r.has_limit then r.limit else CW_DEFAULT_LIMIT;
  if !r.thread {
    if p.limit<1 {p.limit=1;p.clamped=true;}
    if p.limit>CW_MAX_LIMIT {p.limit=CW_MAX_LIMIT;p.clamped=true;}
    p.kinds=r.kinds;p.kinds_n=r.kinds_n;return p;
  }
  if r.roots!=1 {return cw_refuse(p,CW_ROOTS);}
  if p.limit<1 || p.limit>CW_MAX_LIMIT {return cw_refuse(p,CW_LIMIT);}
  p.depth_limit=ifx r.has_depth then r.depth_limit else CW_MAX_DEPTH;
  if p.depth_limit<1 || p.depth_limit>CW_MAX_DEPTH {return cw_refuse(p,CW_LIMIT);}
  if r.kinds_n<1 || r.kinds_n>4 {return cw_refuse(p,CW_KINDS);}
  // Sorted and distinct: walk the four allowed kinds in order.
  for k:CW_THREAD_KINDS {
    asked:=false;for i:0..<r.kinds_n {if r.kinds[i]==k {asked=true;}}
    if asked {p.kinds[p.kinds_n]=k;p.kinds_n+=1;}
  }
  for i:0..<r.kinds_n {if !cw_kind_in(CW_THREAD_KINDS,4,r.kinds[i]) {return cw_refuse(p,CW_KINDS);}}
  return p;
}
// book:end check
cw_kind_in :: (ks:[4]int,n:int,k:int)->bool {for i:0..<n {if ks[i]==k {return true;}}return false;}

// book:begin order
// Is id a before id b, bytewise?
cw_id_less :: (a:[32]u8,b:[32]u8)->bool {
  for i:0..<32 {if a[i]<b[i] {return true;}if a[i]>b[i] {return false;}}
  return false;
}
// Does row r come after the position (at, id) in created_at DESC, id ASC?
cw_after :: (r:CwRow,at:int,id:[32]u8)->bool {
  if r.created_at<at {return true;}
  if r.created_at>at {return false;}
  return cw_id_less(id,r.id);
}
// Does a come before b in the window's order?
cw_first :: (a:CwRow,b:CwRow)->bool {return cw_after(b,a.created_at,a.id);}
// book:end order

// book:begin eligible
// Is the row one this window may return?
cw_eligible :: (r:CwRow,q:CwRequest,p:CwPage)->bool {
  if r.deleted {return false;}
  if p.kinds_n>0 && !cw_kind_in(p.kinds,p.kinds_n,r.kind) {return false;}
  if q.thread {return r.depth>=1 && r.depth<=p.depth_limit && ns_equal32(r.root,q.root);}
  return r.depth<=0 || (r.depth==1 && r.broadcast);
}
// book:end eligible

// book:begin window
// The page for request q against the channel's rows[0..<n]: row indexes in
// out. readable: the reader may read the channel (a member, or it is open).
cw_window :: (rows:[]CwRow,n:int,q:CwRequest,readable:bool,out:[]int)->CwPage {
  p:=cw_check(q);if p.status!=CW_OK || !readable {return p;}
  if q.thread {
    root:=cw_find(rows,n,q.root);
    if root<0 || rows[root].depth!=0 || !cw_kind_in(CW_THREAD_KINDS,4,rows[root].kind) {return p;}
  }
  p.served=true;
  at:=p.at;id:=p.after;
  k:=0;
  while true {
    best:= -1;
    for i:0..<n {
      if !cw_eligible(rows[i],q,p) {continue;}
      if !p.head || k>0 {if !cw_after(rows[i],at,id) {continue;}}
      if best<0 || cw_first(rows[i],rows[best]) {best=i;}
    }
    if best<0 {break;}
    if k==p.limit {p.has_more=true;p.next_at=at;p.next_id=id;break;}
    out[k]=best;p.n=k+1;at=rows[best].created_at;id=rows[best].id;k+=1;
  }
  return p;
}
// book:end window

// book:begin aux
// Auxiliary events: one per stored reaction, deletion or edit, with the id
// its e tag names.
CwAux :: struct {id:[32]u8; kind:int; target:[32]u8;}
cw_aux_kind :: (k:int)->bool {return k==7 || k==5 || k==9005 || k==40003;}
cw_is_delete :: (k:int)->bool {return k==5 || k==9005;}
// Hop 1: aux events naming a returned row; hop 2: deletions naming a hop-1
// event. Indexes into aux in out; the count. An event names one target, a
// row or a hop-1 event, so it appears at most once.
cw_aux :: (rows:[]CwRow,page:[]int,aux:[]CwAux,out:[]int)->int {
  m:=0;
  for i:0..<aux.count {
    if !cw_aux_kind(aux[i].kind) {continue;}
    for r:page {if ns_equal32(aux[i].target,rows[r].id) {out[m]=i;m+=1;break;}}
  }
  hop1:=m;
  for i:0..<aux.count {
    if !cw_is_delete(aux[i].kind) {continue;}
    for j:0..<hop1 {if ns_equal32(aux[i].target,aux[out[j]].id) {out[m]=i;m+=1;break;}}
  }
  return m;
}
// book:end aux

// book:begin bounds
// The 39006 d tag: "<channel>:head" or "<channel>:<created_at>:<id hex>".
cw_put_int :: (out:[]u8,at:int,v:int)->int {
  digits:[20]u8;d:=0;x:=v;
  while true {digits[19-d]=cast(u8)('0'+x%10);d+=1;x/=10;if x==0 {break;}}
  return json_raw(out,at,cast(string)digits[20-d..<20]);
}
cw_put_hex :: (out:[]u8,at:int,id:[32]u8)->int {
  hex:[64]u8;d:="0123456789abcdef";
  for i:0..<32 {hex[2*i]=d[id[i]>>4];hex[2*i+1]=d[id[i]&15];}
  return json_raw(out,at,cast(string)hex[..]);
}
cw_bounds_d :: (channel:string,p:CwPage,out:[]u8)->int {
  n:=json_raw(out,0,channel);n=json_raw(out,n,":");
  if p.head {return json_raw(out,n,"head");}
  n=cw_put_int(out,n,p.at);n=json_raw(out,n,":");return cw_put_hex(out,n,p.after);
}
// The 39006 content: has_more and next_cursor, null exactly when has_more is false.
cw_bounds_content :: (p:CwPage,out:[]u8)->int {
  if !p.has_more {return json_raw(out,0,"{\"has_more\":false,\"next_cursor\":null}");}
  n:=json_raw(out,0,"{\"has_more\":true,\"next_cursor\":{\"created_at\":");n=cw_put_int(out,n,p.next_at);
  n=json_raw(out,n,",\"id\":\"");n=cw_put_hex(out,n,p.next_id);return json_raw(out,n,"\"}}");
}
// book:end bounds

// book:begin view
// A 39006 as a client reads it: the d tag and the content's two fields.
CwBounds :: struct {ok:bool; d:string; has_more:bool; next:bool; next_at:int; next_id:[32]u8;}
// Read a 39006's content strictly: an object with has_more (a boolean) and
// next_cursor (null, or an object with an integer created_at and a 64-hex
// id); unknown fields are skipped.
cw_read_bounds :: (d:string,content:string)->CwBounds {
  b:CwBounds;b.d=d;j:[1]Json;json_start(j[..],content);
  if json_next(j[..])!=JSON_OBJECT {return b;}
  seen:=0;tok:=json_next(j[..]);
  while tok==JSON_STRING {
    key:=json_text(j[..]);v:=json_next(j[..]);
    if json_is(key,"has_more") {
      if v!=JSON_TRUE && v!=JSON_FALSE {return b;}
      b.has_more=v==JSON_TRUE;seen|=1;
    } else if json_is(key,"next_cursor") {
      seen|=2;
      if v==JSON_OBJECT {
        b.next=true;have:=0;f:=json_next(j[..]);
        while f==JSON_STRING {
          name:=json_text(j[..]);x:=json_next(j[..]);
          if json_is(name,"created_at") {
            if x!=JSON_NUMBER {return b;}
            i:=json_int(json_text(j[..]));if !i.ok || i.value<0 {return b;}
            b.next_at=i.value;have|=1;
          } else if json_is(name,"id") {
            hex:[64]u8;if x!=JSON_STRING || json_unescape(json_text(j[..]),hex[..])!=64 || !ne_lower_hex(cast(string)hex[..],b.next_id[..]) {return b;}
            have|=2;
          } else if !json_skip(j[..]) {return b;}
          f=json_next(j[..]);
        }
        if f!=JSON_OBJECT_END || have!=3 {return b;}
      } else if v!=JSON_NULL {return b;}
    } else if !json_skip(j[..]) {return b;}
    tok=json_next(j[..]);
  }
  b.ok=tok==JSON_OBJECT_END && json_next(j[..])==JSON_END && seen==3 && b.has_more==b.next;
  return b;
}
// What a client shows: bounds holds the 39006 overlays the response carried,
// sent is the d tag the request's cursor binds, rows the rows it carried.
cw_view :: (bounds:[]CwBounds,sent:string,head:bool,rows:int)->int {
  if bounds.count==0 {return CW_VIEW_NONE;}
  if bounds.count>1 || !bounds[0].ok || bounds[0].d!=sent {return CW_VIEW_DISCARD;}
  if head && rows==0 && !bounds[0].has_more {return CW_VIEW_EMPTY;}
  return CW_VIEW_PAGE;
}
// book:end view

// ---- checks (helpers in coax/tests/nostr/nipcw_fixtures.coax)
#test "classification: reply markers, root agreement, broadcast, depth" {
  rows:[8]CwRow;n:[1]int;
  #assert cwf_add(rows[..],n[..],9,0x01,100,"[[\"h\",\"c\"]]")==CW_OK && rows[0].depth==0;
  // A root-only, positional or mention e tag is not a reply.
  #assert cwf_add(rows[..],n[..],9,0x02,100,"[[\"e\",\"^1\",\"\",\"root\"],[\"e\",\"^1\"],[\"e\",\"^1\",\"\",\"mention\"]]")==CW_OK && rows[1].depth==0;
  #assert cwf_add(rows[..],n[..],9,0x03,101,"[[\"e\",\"^1\",\"\",\"reply\"],[\"broadcast\",\"1\"]]")==CW_OK && rows[2].depth==1 && rows[2].broadcast && rows[2].root[0]==1;
  #assert cwf_add(rows[..],n[..],9,0x04,102,"[[\"e\",\"^1\",\"\",\"root\"],[\"e\",\"^3\",\"\",\"reply\"]]")==CW_OK && rows[3].depth==2 && rows[3].root[0]==1 && rows[3].parent[0]==3;
  #assert cwf_add(rows[..],n[..],9,0x05,102,"[[\"e\",\"^2\",\"\",\"root\"],[\"e\",\"^3\",\"\",\"reply\"]]")==CW_ROOT;
  #assert cwf_add(rows[..],n[..],9,0x05,102,"[[\"e\",\"^9\",\"\",\"reply\"]]")==CW_PARENT;
  #assert cwf_add(rows[..],n[..],9,0x05,102,"[[\"e\",\"^1\",\"\",\"reply\"],[\"e\",\"^2\",\"\",\"reply\"]]")==CW_SHAPE;
  #assert cwf_add(rows[..],n[..],9,0x05,102,"[[\"e\",\"^Z\",\"\",\"reply\"]]")==CW_SHAPE;
  #assert cwf_add(rows[..],n[..],9,0x05,102,"[[\"e\",\"^1\",\"\",\"reply\"],[\"broadcast\",\"1\",\"x\"]]")==CW_OK && !rows[4].broadcast;
  #assert cwf_add(rows[..],n[..],9,0x06,102,"[[\"e\",\"^1\",\"\",\"reply\"],[\"broadcast\",\"0\"]]")==CW_OK && !rows[5].broadcast;
  #assert cwf_add(rows[..],n[..],9,0x07,102,"[[\"e\",\"^1\",\"\",\"reply\"],[\"broadcasts\",\"1\"]]")==CW_OK && !rows[6].broadcast && n[0]==7;
  for kind:39005..<39008 {#assert cwf_add(rows[..],n[..],kind,0x08,1,"[]")==CW_RELAY_ONLY;}
  #assert cwf_add(rows[..],n[..],39004,0x08,1,"[]")==CW_OK && cwf_add(rows[..],n[..],39008,0x09,1,"[]")==CW_FULL && n[0]==8;
  buf:[256]u8;e:=g29_ev(9,0xaa,0x0a,"[]",buf[..]);e.verified=false;#assert cw_ingest(rows[..],n[..],e)==CW_EVENT;
  e.verified=true;e.error=NE_ID;#assert cw_ingest(rows[..],n[..],e)==CW_EVENT;
  t:=cw_tags(nt_event("[[\"t\",\"x\"],[\"broadcast\",\"1\"]]"));#assert t.status==CW_OK && !t.reply && t.broadcast && !t.has_root;
  #assert cw_tags(nt_event("[[\"e\",\"^1\"]]")).status==CW_SHAPE;
  #assert cw_tags(g29_ev(1,1,1,"[[\"e\",\"^1\",\"\",\"root\"]]",buf[..])).has_root;
}
#test "depth stops at 100" {
  rows:[102]CwRow;n:[1]int;tags:[256]u8;
  #assert cwf_add(rows[..],n[..],9,0x00,1,"[]")==CW_OK;
  for i:1..<101 {#assert cwf_reply(rows[..],n[..],cast(u8)i,cast(u8)(i-1),tags[..])==CW_OK;}
  #assert rows[100].depth==100 && rows[100].root[0]==0 && cwf_reply(rows[..],n[..],101,100,tags[..])==CW_DEPTH;
}
#test "requests: one channel, both cursor parts, grammar, limits, kinds" {
  q:CwRequest;q.channels=1;
  p:=cw_check(q);#assert p.status==CW_OK && p.head && p.limit==50 && p.kinds_n==0;
  q.channels=0;#assert cw_check(q).status==CW_CHANNELS;q.channels=2;#assert cw_check(q).status==CW_CHANNELS;q.channels=1;
  q.has_until=true;q.until=5;#assert cw_check(q).status==CW_CURSOR;
  q.has_until=false;q.has_before=true;q.before=CWF_ID3;#assert cw_check(q).status==CW_CURSOR;
  q.has_until=true;p=cw_check(q);#assert p.status==CW_OK && !p.head && p.at==5 && p.after[0]==0x33 && p.after[31]==0x33;
  q.before="ABCDEFabcdef0123456789000000000000000000000000000000000000000000";p=cw_check(q);#assert p.status==CW_OK && p.after[0]==0xab && p.after[1]==0xcd && p.after[2]==0xef && p.after[3]==0xab && p.after[6]==0x01 && p.after[10]==0x89;
  q.before="g333333333333333333333333333333333333333333333333333333333333333";#assert cw_check(q).status==CW_CURSOR;
  q.before="333333333333333333333333333333333333333333333333333333333333333G";#assert cw_check(q).status==CW_CURSOR;
  q.before="33333333333333333333333333333333333333333333333333333333333333";#assert cw_check(q).status==CW_CURSOR;
  q.before=CWF_ID3;q.until= -1;#assert cw_check(q).status==CW_CURSOR;q.until=0;#assert cw_check(q).status==CW_OK;
  for c:":/@G`g" {s:[64]u8;for i:0..<64 {s[i]='3';}s[5]=c;q.before=cast(string)s[..];#assert cw_check(q).status==CW_CURSOR;}
  q.has_until=false;q.has_before=false;
  q.has_limit=true;q.limit=0;p=cw_check(q);#assert p.limit==1 && p.clamped;q.limit=201;p=cw_check(q);#assert p.limit==200 && p.clamped;
  q.limit=200;p=cw_check(q);#assert p.limit==200 && !p.clamped;q.limit=1;p=cw_check(q);#assert p.limit==1 && !p.clamped;q.limit=2;#assert cw_check(q).limit==2;
  q.limit= -5;#assert cw_check(q).limit==1;
  q.kinds[0]=1;q.kinds_n=1;#assert cw_check(q).kinds_n==1;
  // Thread mode refuses where channel mode clamps.
  t:CwRequest;t.thread=true;t.channels=1;t.roots=1;t.kinds[0]=40002;t.kinds[1]=9;t.kinds[2]=9;t.kinds_n=3;
  p=cw_check(t);#assert p.status==CW_OK && p.limit==50 && p.depth_limit==100 && p.kinds_n==2 && p.kinds[0]==9 && p.kinds[1]==40002;
  t.roots=0;#assert cw_check(t).status==CW_ROOTS;t.roots=2;#assert cw_check(t).status==CW_ROOTS;t.roots=1;
  t.has_limit=true;t.limit=0;#assert cw_check(t).status==CW_LIMIT;t.limit=201;#assert cw_check(t).status==CW_LIMIT;t.limit=200;#assert cw_check(t).status==CW_OK;t.limit=1;#assert cw_check(t).status==CW_OK;
  t.has_depth=true;t.depth_limit=0;#assert cw_check(t).status==CW_LIMIT;t.depth_limit=101;#assert cw_check(t).status==CW_LIMIT;
  t.depth_limit=100;#assert cw_check(t).status==CW_OK;t.depth_limit=1;#assert cw_check(t).depth_limit==1;
  t.kinds[3]=1;t.kinds_n=4;#assert cw_check(t).status==CW_KINDS;t.kinds_n=0;#assert cw_check(t).status==CW_KINDS;
  t.kinds[0]=45001;t.kinds[1]=45003;t.kinds[2]=40002;t.kinds[3]=9;t.kinds_n=4;p=cw_check(t);#assert p.status==CW_OK && p.kinds_n==4 && p.kinds[3]==45003;
  t.kinds_n=5;#assert cw_check(t).status==CW_KINDS;
  t.kinds[0]=1;t.kinds_n=1;#assert cw_check(t).status==CW_KINDS;
  #assert cw_nibble('0')==0 && cw_nibble('9')==9 && cw_nibble('a')==10 && cw_nibble('f')==15 && cw_nibble('A')==10 && cw_nibble('F')==15;
  #assert cw_nibble('/')== -1 && cw_nibble(':')== -1 && cw_nibble('`')== -1 && cw_nibble('g')== -1 && cw_nibble('@')== -1 && cw_nibble('G')== -1;
}
#test "channel windows: same-second order, exact has_more, cursor, deletes" {
  rows:[16]CwRow;n:=cwf_channel(rows[..]);out:[8]int;
  q:CwRequest;q.channels=1;q.has_limit=true;q.limit=2;
  p:=cw_window(rows[..],n,q,true,out[..]);
  // 300:0x05, then the two at 200 by id (0x02 before 0x04)...
  #assert p.served && p.n==2 && rows[out[0]].id[0]==0x05 && rows[out[1]].id[0]==0x02 && p.has_more && p.next_at==200 && p.next_id[0]==0x02;
  q.has_until=true;q.until=200;q.has_before=true;q.before=CWF_ID2;
  p=cw_window(rows[..],n,q,true,out[..]);
  // ...0x04 at 200 and the broadcast reply 0x07 at 150; 0x06 (not broadcast) never shows.
  #assert p.n==2 && rows[out[0]].id[0]==0x04 && rows[out[1]].id[0]==0x07 && p.has_more && p.next_at==150 && p.next_id[0]==0x07;
  q.until=150;q.before=CWF_ID7;p=cw_window(rows[..],n,q,true,out[..]);
  // An exact final page: 0x01 and the unknown-depth 0x08; has_more false.
  #assert p.n==2 && rows[out[0]].id[0]==0x01 && rows[out[1]].id[0]==0x08 && !p.has_more && p.next_at==0;
  q.until=100;q.before=CWF_ID8;p=cw_window(rows[..],n,q,true,out[..]);#assert p.served && p.n==0 && !p.has_more;
  // A deletion takes the row out, and the probe counts only eligible rows.
  #assert cw_delete(rows[..],n,cwf_id(0x08)) && !cw_delete(rows[..],n,cwf_id(0x77));
  q.until=150;q.before=CWF_ID7;p=cw_window(rows[..],n,q,true,out[..]);#assert p.n==1 && rows[out[0]].id[0]==0x01 && !p.has_more;
  q.limit=1;p=cw_window(rows[..],n,q,true,out[..]);#assert p.n==1 && !p.has_more;
  // Kinds restrict rows.
  q.has_until=false;q.has_before=false;q.limit=50;q.kinds[0]=40002;q.kinds_n=1;p=cw_window(rows[..],n,q,true,out[..]);
  #assert p.n==1 && rows[out[0]].id[0]==0x04;
  // Not readable or malformed: nothing served.
  q.kinds_n=0;p=cw_window(rows[..],n,q,false,out[..]);#assert !p.served && p.n==0 && p.status==CW_OK;
  q.channels=2;p=cw_window(rows[..],n,q,true,out[..]);#assert !p.served && p.status==CW_CHANNELS;
  // An empty channel is a served window with has_more false.
  q.channels=1;p=cw_window(rows[0..<0],0,q,true,out[..]);#assert p.served && p.n==0 && !p.has_more;
  #assert cw_id_less(cwf_id(1),cwf_id(2)) && !cw_id_less(cwf_id(2),cwf_id(1)) && !cw_id_less(cwf_id(2),cwf_id(2));
  a:=cwf_id(1);a[31]=2;#assert cw_id_less(cwf_id(1),a) && !cw_id_less(a,cwf_id(1));
  a=cwf_id(1);a[0]=2;#assert cw_id_less(cwf_id(1),a) && !cw_id_less(a,cwf_id(1));
}
#test "thread windows: one root's replies, depth limit, missing root" {
  rows:[16]CwRow;n:=cwf_channel(rows[..]);out:[8]int;
  q:CwRequest;q.thread=true;q.channels=1;q.roots=1;q.root=cwf_id(0x02);q.kinds[0]=9;q.kinds_n=1;
  p:=cw_window(rows[..],n,q,true,out[..]);
  #assert p.served && p.n==3 && rows[out[0]].id[0]==0x09 && rows[out[1]].id[0]==0x06 && rows[out[2]].id[0]==0x07 && !p.has_more;
  q.has_depth=true;q.depth_limit=1;p=cw_window(rows[..],n,q,true,out[..]);#assert p.n==2 && rows[out[0]].id[0]==0x06;
  q.has_limit=true;q.limit=1;p=cw_window(rows[..],n,q,true,out[..]);#assert p.n==1 && p.has_more && p.next_at==150 && p.next_id[0]==0x06;
  // A reply as the root, an unsupported root kind, or a missing root: no window.
  q.root=cwf_id(0x06);#assert !cw_window(rows[..],n,q,true,out[..]).served;
  q.root=cwf_id(0x0a);#assert !cw_window(rows[..],n,q,true,out[..]).served;
  q.root=cwf_id(0x55);#assert !cw_window(rows[..],n,q,true,out[..]).served;
  q.root=cwf_id(0x04);p=cw_window(rows[..],n,q,true,out[..]);#assert p.served && p.n==0;
  q.root=cwf_id(0x02);#assert !cw_window(rows[..],n,q,false,out[..]).served;
  r:CwRow;r.depth=1;r.kind=9;#assert !cw_eligible(r,q,cw_check(q));
  q.root=cwf_id(0x01);p=cw_window(rows[..],n,q,true,out[..]);#assert p.served && p.n==0;
  #assert cw_delete(rows[..],n,cwf_id(0x01)) && rows[0].deleted;
}
#test "aux closure: two hops, once each" {
  rows:[16]CwRow;n:=cwf_channel(rows[..]);page:=[2]int.[0,1];out:[8]int;
  aux:=[7]CwAux.[cwf_aux(0x30,7,0x01),cwf_aux(0x31,5,0x30),cwf_aux(0x32,40003,0x02),cwf_aux(0x33,1,0x01),
                 cwf_aux(0x34,9005,0x31),cwf_aux(0x35,9005,0x01),cwf_aux(0x36,7,0x09)];
  m:=cw_aux(rows[..],page[..],aux[..],out[..]);
  #assert m==4 && out[0]==0 && out[1]==2 && out[2]==5 && out[3]==1;
  two:=[2]CwAux.[cwf_aux(0x31,5,0x30),cwf_aux(0x30,7,0x01)];
  m=cw_aux(rows[..],page[..],two[..],out[..]);#assert m==2 && out[0]==1 && out[1]==0;
  #assert cw_aux_kind(7) && cw_aux_kind(5) && cw_aux_kind(9005) && cw_aux_kind(40003) && !cw_aux_kind(1) && !cw_aux_kind(9);
  #assert cw_is_delete(5) && cw_is_delete(9005) && !cw_is_delete(7) && !cw_is_delete(40003);
}
#test "bounds: d tag and content, read back by the client" {
  out:[256]u8;p:CwPage;p.head=true;
  #assert g29_out_is(cw_bounds_d("c",p,out[..]),out[..],"c:head");
  #assert g29_out_is(cw_bounds_content(p,out[..]),out[..],"{\"has_more\":false,\"next_cursor\":null}");
  p.head=false;p.at=200;p.after=cwf_id(0x02);p.has_more=true;p.next_at=150;p.next_id=cwf_id(0x07);
  #assert g29_out_is(cw_bounds_d("c",p,out[..]),out[..],"c:200:0202020202020202020202020202020202020202020202020202020202020202");
  n:=cw_bounds_content(p,out[..]);
  #assert g29_out_is(n,out[..],"{\"has_more\":true,\"next_cursor\":{\"created_at\":150,\"id\":\"0707070707070707070707070707070707070707070707070707070707070707\"}}");
  b:=cw_read_bounds("c:200",cast(string)out[0..<n]);#assert b.ok && b.has_more && b.next && b.next_at==150 && b.next_id[0]==7;
  p.next_at=0;#assert g29_out_is(cw_put_int(out[..],0,0),out[..],"0") && g29_out_is(cw_put_int(out[..],0,1751500123),out[..],"1751500123");
  #assert cw_read_bounds("d","{\"has_more\":false,\"next_cursor\":null,\"oldest_retained\":[1,2]}").ok;
  #assert cw_read_bounds("d","{\"next_cursor\":null,\"has_more\":false}").ok;
  #assert !cw_read_bounds("d","{\"has_more\":true,\"next_cursor\":null}").ok && !cw_read_bounds("d","{\"has_more\":false}").ok && !cw_read_bounds("d","{\"next_cursor\":null}").ok;
  #assert !cw_read_bounds("d","{\"has_more\":false,\"next_cursor\":{\"created_at\":1,\"id\":\"0707070707070707070707070707070707070707070707070707070707070707\"}}").ok;
  #assert !cw_read_bounds("d","{\"has_more\":1,\"next_cursor\":null}").ok && !cw_read_bounds("d","not json").ok && !cw_read_bounds("d","[]").ok;
  #assert !cw_read_bounds("d","{\"has_more\":false,\"next_cursor\":null} x").ok && !cw_read_bounds("d","{\"has_more\":false,\"next_cursor\":3}").ok;
  #assert !cw_read_bounds("d","{\"has_more\":true,\"next_cursor\":{\"created_at\":1}}").ok && !cw_read_bounds("d","{\"has_more\":true,\"next_cursor\":{\"id\":\"0707070707070707070707070707070707070707070707070707070707070707\"}}").ok;
  #assert !cw_read_bounds("d","{\"has_more\":true,\"next_cursor\":{\"created_at\":\"1\",\"id\":\"0707070707070707070707070707070707070707070707070707070707070707\"}}").ok;
  #assert !cw_read_bounds("d","{\"has_more\":true,\"next_cursor\":{\"created_at\":-1,\"id\":\"0707070707070707070707070707070707070707070707070707070707070707\"}}").ok;
  #assert !cw_read_bounds("d","{\"has_more\":true,\"next_cursor\":{\"created_at\":1.5,\"id\":\"0707070707070707070707070707070707070707070707070707070707070707\"}}").ok;
  #assert !cw_read_bounds("d","{\"has_more\":true,\"next_cursor\":{\"created_at\":1,\"id\":\"07\"}}").ok && !cw_read_bounds("d","{\"has_more\":true,\"next_cursor\":{\"created_at\":1,\"id\":7}}").ok;
  #assert !cw_read_bounds("d","{\"has_more\":true,\"next_cursor\":{\"created_at\":1,\"id\":\"0707070707070707070707070707070707070707070707070707070707070707\",\"x\":}}").ok;
  #assert cw_read_bounds("d","{\"has_more\":true,\"next_cursor\":{\"created_at\":0,\"x\":[],\"id\":\"0707070707070707070707070707070707070707070707070707070707070707\"}}").ok;
  #assert !cw_read_bounds("d","{\"has_more\":true,\"next_cursor\":{\"created_at\":1,\"id\":\"0707070707070707070707070707070707070707070707070707070707070707\"},\"x\":}").ok;
  #assert !cw_read_bounds("d","{\"has_more\":true,\"next_cursor\":{\"created_at\":1,\"id\":\"0707070707070707070707070707070707070707070707070707070707070707\"]}").ok;
  small:[4]u8;#assert cw_bounds_d("chan",p,small[..])== -1 && cw_bounds_content(p,small[..])== -1;
}
#test "views: a missing page is never an empty channel" {
  ok:=cw_read_bounds("c:head","{\"has_more\":false,\"next_cursor\":null}");
  more:=cw_read_bounds("c:head","{\"has_more\":true,\"next_cursor\":{\"created_at\":1,\"id\":\"0707070707070707070707070707070707070707070707070707070707070707\"}}");
  one:=[1]CwBounds.[ok];two:=[2]CwBounds.[ok,ok];none:=two[0..<0];m:=[1]CwBounds.[more];
  #assert cw_view(none[..],"c:head",true,0)==CW_VIEW_NONE && cw_view(none[..],"c:head",true,5)==CW_VIEW_NONE;
  #assert cw_view(one[..],"c:head",true,0)==CW_VIEW_EMPTY && cw_view(one[..],"c:head",true,1)==CW_VIEW_PAGE;
  #assert cw_view(one[..],"c:head",false,0)==CW_VIEW_PAGE && cw_view(m[..],"c:head",true,0)==CW_VIEW_PAGE;
  #assert cw_view(two[..],"c:head",true,0)==CW_VIEW_DISCARD && cw_view(one[..],"c:1:x",true,0)==CW_VIEW_DISCARD;
  bad:=[1]CwBounds.[cw_read_bounds("c:head","{}")];#assert cw_view(bad[..],"c:head",true,0)==CW_VIEW_DISCARD;
}
