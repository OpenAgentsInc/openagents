  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"timelock\":null","\"timelock\":{\"before\":1}")).code==KyCode.timelock;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"timelock\":null","\"timelock\":{\"older\":1,\"after\":1}")).code==KyCode.timelock;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"timelock\":null","\"timelock\":{}")).code==KyCode.timelock;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"timelock\":null","\"timelock\":7")).code==KyCode.timelock;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,",\"timelock\":null","")).code==KyCode.paths;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"paths\":[{","\"paths\":[{\"keys\":[{\"digest\":\"sha256:e3eec4f661f9d78168e754fde3953f71edc101ee4133224a0640e76a67c34856\",\"media_type\":\"a\",\"size\":1}],\"name\":\"primary\",\"threshold\":1,\"timelock\":{\"older\":9}},{")).code==KyCode.paths;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"paths\":[{","\"paths\":[{\"keys\":[{\"digest\":\"sha256:e3eec4f661f9d78168e754fde3953f71edc101ee4133224a0640e76a67c34856\",\"media_type\":\"a\",\"size\":1}],\"name\":\"r\",\"threshold\":1,\"timelock\":{\"older\":9}},{")).npaths==2;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"paths\":[{","\"paths\":[{\"keys\":[{\"digest\":\"sha256:e3eec4f661f9d78168e754fde3953f71edc101ee4133224a0640e76a67c34856\",\"media_type\":\"a\",\"size\":1}],\"name\":\"r\",\"threshold\":1,\"timelock\":null},{")).code==KyCode.primary;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"paths\":[{","\"paths\":[{\"keys\":[{\"digest\":\"sha256:e3eec4f661f9d78168e754fde3953f71edc101ee4133224a0640e76a67c34856\",\"media_type\":\"a\",\"size\":1}],\"name\":\"r\",\"threshold\":2,\"timelock\":null},{")).code==KyCode.threshold;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"paths\":[{","\"paths\":[],\"x\":[{")).code==KyCode.field;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"paths\":[{","\"paths\":[],\"meta\":[{")).code!=KyCode.ok;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"enrollments\":[{","\"enrollments\":[1,{")).code==KyCode.enrollment;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"recipients\":[\"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798\",","\"recipients\":[1,")).code==KyCode.recipient;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"starts_at\":1793100000","\"starts_at\":1824636000")).code==KyCode.times;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"starts_at\":1793100000","\"starts_at\":1824635999")).code==KyCode.ok;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"starts_at\":1793100000","\"starts_at\":-1")).code==KyCode.times;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"starts_at\":1793100000","\"starts_at\":0")).code==KyCode.ok;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"{\"descriptor\"","{1:2,\"descriptor\"")).code==KyCode.json;
  #assert ky_primary(w)==0;
  // one enrollment, one recipient
  c3:[4096]u8;
  #assert ky_wallet_read(ky_case(c3[..],ky_case(c[..],KY_WALLET,"\"enrollments\":[{\"digest\":\"sha256:e3eec4f661f9d78168e754fde3953f71edc101ee4133224a0640e76a67c34856\",\"media_type\":\"application/json\",\"schema\":\"openagents.keys-enrollment.v1\",\"size\":803},","\"enrollments\":["),"{\"digest\":\"sha256:1e1959c86c68ae20c27fdb36082562b0f754a47e6c4fa8f5f6db1924985283b5\",\"media_type\":\"application/json\",\"schema\":\"openagents.keys-enrollment.v1\",\"size\":803},","")).nenroll==1;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798\",\"c6047f9441ed7d6d3045406e95c07cd85c778e4b8cef3ca7abac09b95c709ee5\",","")).nrecip==1;
  pp:=w;pp.npaths=2;pp.paths[1]=w.paths[0];#assert ky_primary(pp)==0;   // the first path with no timelock
  pp.npaths=1;pp.paths[0].older=9;#assert ky_primary(pp)==0;   // none: 0
  #assert ky_find(w,ky_bytes(KY_HOLDER))==-1 && ky_find(w,w.enrollments[2])==2;
  // KY_PATHS paths read; one more refuses
  many:[2048]u8;m:=json_raw(many[..],0,"\"paths\":[");
  for k:0..<KY_PATHS {
    if k==KY_PATHS-1 {big:=ky_wallet_read(ky_case(c[..],KY_WALLET,"\"paths\":[",cast(string)many[0..<m]));#assert big.code==KyCode.ok && big.npaths==KY_PATHS;}
    m=json_raw(many[..],m,"{\"keys\":[{\"digest\":\"sha256:e3eec4f661f9d78168e754fde3953f71edc101ee4133224a0640e76a67c34856\",\"media_type\":\"a\",\"size\":1}],\"name\":\"r");
    many[m]=cast(u8)('a'+k);m+=1;
    m=json_raw(many[..],m,"\",\"threshold\":1,\"timelock\":{\"older\":9}},");
  }
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"paths\":[",cast(string)many[0..<m])).code==KyCode.paths;
}

