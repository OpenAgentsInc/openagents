  d:=ky_independence_read(KY_AGENT1,KY_IND1);
  #assert d.code==KyCode.ok && d.agent==KY_AGENT1 && d.op=="keyco-llc";
  #assert ky_independence_read(KY_AGENT2,KY_IND1).code==KyCode.enrollment;
  c:[1024]u8;
  #assert ky_independence_read(KY_AGENT1,"[]").code==KyCode.json;
  #assert ky_independence_read(KY_AGENT1,"{\"v\":\"openagents.keys-independence.v1\"").code==KyCode.json;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"{\"aff","{1:2,\"aff")).code==KyCode.json;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"v1\"}","v1\"}x")).code==KyCode.json;
