  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,",\"v\":\"openagents.keys-independence.v1\"","")).code==KyCode.field;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"requires\":[]","\"requires\":[1]")).code==KyCode.version;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"requires\":[]","\"requires\":[],\"meta\":{}")).code==KyCode.ok;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"requires\":[]","\"requires\":[],\"meta\":[]")).code==KyCode.field;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"requires\":[]","\"requires\":[],\"x\":[]")).code==KyCode.field;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"requires\":[]","\"requires\":[],\"requires\":[]")).code==KyCode.field;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"requires\":[],","")).code==KyCode.field;
  #assert ky_independence_read("c6","{\"agent\":\"c6\"}").code==KyCode.enrollment;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"agent\":\"c6047f9441ed7d6d3045406e95c07cd85c778e4b8cef3ca7abac09b95c709ee5\"","\"agent\":1")).code==KyCode.enrollment;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"operator\":\"keyco-llc\"","\"operator\":\"\"")).code==KyCode.operator;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"operator\":\"keyco-llc\"","\"operator\":1")).code==KyCode.operator;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"jurisdiction\":[\"CH\"]","\"jurisdiction\":\"CH\"")).code==KyCode.field;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"affiliations\":[]","\"affiliations\":{}")).code==KyCode.field;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"insurance\":null","\"insurance\":\"policy-1\"")).code==KyCode.ok;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"insurance\":null","\"insurance\":1")).code==KyCode.field;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"observed_at\":1793000000","\"observed_at\":-1")).code==KyCode.times;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"observed_at\":1793000000","\"observed_at\":0")).code==KyCode.ok;
  #assert ky_independence_read(KY_AGENT1,ky_case(c[..],KY_IND1,"\"custody\":{","\"custody\":[{")).code!=KyCode.ok;
