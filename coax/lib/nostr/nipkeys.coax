#test "admission: the descriptor recomputed, enrollments bound, composition holds" #steps 600000000 {
  w:=ky_wallet_read(KY_WALLET);p:=ky_parties();
  a:=ky_admit(w,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0);
  #assert a.code==KyCode.ok && !a.proven;
  d:[4096]u8;n:=ky_descriptor(w,p.e[..],d[..]);
  #assert n==w.descriptor.count && cast(string)d[0..<n]==w.descriptor;
  #assert ky_descriptor(w,p.e[..],d[0..<n-1])==-1;
  #assert ky_descriptor(w,p.e[..],d[0..<n])==n;
  #assert ky_descriptor(w,p.e[..],d[0..<10])==-1;
  ex:=p;ex.e[1].xpub="é";#assert ky_descriptor(w,ex.e[..],d[..])==-1;   // outside BIP-380's input set: no checksum
  pb:[3]u8;#assert ky_put(pb[..],0,"abc")==3 && ky_put(pb[0..<2],0,"abc")==-1 && ky_put(pb[..],1,"ab")==3 && ky_put(pb[..],-1,"")==-1;
  e0:=p;e0.e[0].wallet=KY_HOLDER;#assert ky_admit(w,e0.e[..],e0.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.enrollment;
  // one non-holder agent with two keys (the first and second)
  dh:=w;dh.holder=KY_AGENT2;da:=p;da.e[1].agent=KY_AGENT0;da.ind[1].agent=KY_AGENT0;
  #assert ky_admit(dh,da.e[..],da.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.enrollment;
  // layout: an enrollment twice in a path, and one in none
  lt:=w;lt.paths[0].count=4;lt.paths[0].keys[3]=w.enrollments[0];#assert ky_layout(lt)==KyCode.enrollment;
  lt=w;lt.paths[0].count=2;lt.paths[0].keys[0]=w.enrollments[1];lt.paths[0].keys[1]=w.enrollments[2];lt.paths[0].threshold=1;#assert ky_layout(lt)==KyCode.enrollment;
  #assert ky_admit(w,ex.e[..],ex.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.descriptor;
  // a mainnet wallet whose keys are xpubs
  mnx:=w;mnx.network="mainnet";xk:=p;for i:0..<3 {xk.e[i].key=KY_BIP32_M0H;}
  #assert ky_admit(mnx,xk.e[..],xk.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.ok;
  #assert ky_admit(w,xk.e[..],xk.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.network;
  // tr( is a family this build doesn't build; anything else is unknown
  fam:=w;fam.descriptor="tr(x";#assert ky_admit(fam,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.not_built;
  fam.descriptor="tr(";#assert ky_admit(fam,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.family;
  fam.descriptor="wsh(";#assert ky_admit(fam,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.descriptor;
  fam.descriptor="wsh";#assert ky_admit(fam,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.family;
  // the wallet's own code, enrollment and declaration codes
  bad:=w;bad.code=KyCode.json;#assert ky_admit(bad,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.json;
  #assert ky_admit(w,p.e[0..<2],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.enrollment;
  #assert ky_admit(w,p.e[..],p.ind[0..<2],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.enrollment;
  q:=p;q.e[1].code=KyCode.xpub;#assert ky_admit(w,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.xpub;
  q=p;q.ind[2].code=KyCode.operator;#assert ky_admit(w,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.operator;
  // order, wallet, independence binding
  q=p;q.e[0]=p.e[1];q.e[1]=p.e[0];q.ind[0]=p.ind[1];q.ind[1]=p.ind[0];
  #assert ky_admit(w,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.enrollment;
  q=p;q.e[2].wallet=KY_HOLDER;#assert ky_admit(w,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.enrollment;
  q=p;q.ind[1]=p.ind[2];#assert ky_admit(w,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.enrollment;
  q=p;q.ind[1].agent=KY_AGENT2;#assert ky_admit(w,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.enrollment;
  q=p;q.e[2].agent=KY_AGENT1;q.ind[2].agent=KY_AGENT1;#assert ky_admit(w,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.enrollment;
  q=p;q.e[1].agent=KY_HOLDER;q.ind[1].agent=KY_HOLDER;#assert ky_admit(w,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.sovereign;
  // expiry, recipients, network
  #assert ky_admit(w,p.e[..],p.ind[..],true,KY_MIN_LOCK,1795000000,KY_H0).code==KyCode.ok;
  #assert ky_admit(w,p.e[..],p.ind[..],true,KY_MIN_LOCK,1795000001,KY_H0).code==KyCode.times;
  nr:=w;nr.recipients[1]=nr.recipients[0];#assert ky_admit(nr,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.recipient;
  nr=w;nr.nrecip=2;#assert ky_admit(nr,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.recipient;
  mn:=w;mn.network="mainnet";#assert ky_admit(mn,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.network;
  mn.network="testnet4";#assert ky_admit(mn,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.ok;
  // layout, family, descriptor
  ly:=w;ly.paths[0].count=2;#assert ky_admit(ly,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.enrollment;
  ly=w;ly.paths[0].keys[1]=ly.paths[0].keys[0];#assert ky_admit(ly,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.enrollment;
  ly=w;ly.paths[0].keys[1][0]^=1;#assert ky_admit(ly,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.enrollment;
  fm:=w;fm.descriptor="tr(x)";#assert ky_admit(fm,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.not_built;
  fm.descriptor="sh(x)";#assert ky_admit(fm,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.family;
  fm.descriptor="tr(";#assert ky_admit(fm,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.family;
  fm.descriptor="tr";#assert ky_admit(fm,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.family;
  fm.descriptor="wsh";#assert ky_admit(fm,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.family;
  fm.descriptor="wsh(";#assert ky_admit(fm,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.descriptor;
  th:=w;th.paths[0].threshold=3;#assert ky_admit(th,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.descriptor;
  // composition: two keys under one operator meet the threshold
  q=p;q.ind[2].op="keyco-llc";#assert ky_admit(w,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.operator;
  q=p;q.ind[2].op="alice-agent";#assert ky_admit(w,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.sovereign;
  #assert ky_admit(w,q.e[..],q.ind[..],false,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.operator;
}

#test "composition rules over paths: operators, the holder, recovery timelocks, attested-only paths" #steps 600000000 {
  w:=ky_wallet_read(KY_WALLET);p:=ky_parties();
  #assert ky_compose(w,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.ok;
  #assert ky_operator(w,p.e[..],p.ind[..],1)=="keyco-llc" && ky_operator(w,p.e[..],p.ind[..],0)=="alice-agent";
  #assert ky_holder(w,p.e[..])==0;
  nh:=w;nh.holder=KY_WALLET_ID;#assert ky_holder(nh,p.e[..])==-1;
  // the holder's second key takes the holder's first operator
  q:=p;q.e[2].agent=KY_HOLDER;
  #assert ky_operator(w,q.e[..],q.ind[..],2)=="alice-agent";
  #assert ky_compose(w,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.sovereign;
  #assert ky_compose(w,q.e[..],q.ind[..],false,KY_MIN_LOCK,KY_H0)==KyCode.operator;
  t3:=w;t3.paths[0].threshold=3;#assert ky_compose(t3,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.ok;
  // a holder that enrolls no key: no group is the holder's
  #assert ky_operator(nh,p.e[..],p.ind[..],0)=="alice-agent";
  q=p;q.ind[1].op="x";q.ind[2].op="x";#assert ky_compose(nh,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.operator;
  // a recovery path: alice alone after 4320 blocks; keyco and enclave are primary
  r:=w;r.npaths=2;
  r.paths[0].count=2;r.paths[0].keys[0]=w.enrollments[1];r.paths[0].keys[1]=w.enrollments[2];
  r.paths[1]=w.paths[0];r.paths[1].name="recovery";r.paths[1].threshold=1;r.paths[1].count=1;r.paths[1].keys[0]=w.enrollments[0];r.paths[1].older=4320;
  #assert ky_compose(r,p.e[..],p.ind[..],false,KY_MIN_LOCK,KY_H0)==KyCode.operator;   // alice alone meets 1
  r.paths[1].threshold=2;r.paths[1].count=2;r.paths[1].keys[1]=w.enrollments[1];
  #assert ky_compose(r,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.ok;
  r.paths[1].older=4319;#assert ky_compose(r,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.recovery;
  #assert ky_compose(r,p.e[..],p.ind[..],true,144,KY_H0)==KyCode.ok;
  r.paths[1].older=0;r.paths[1].after=KY_H0+4320;#assert ky_compose(r,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.ok;
  r.paths[1].after=KY_H0+4319;#assert ky_compose(r,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.recovery;
  r.paths[1].after=1;#assert ky_compose(r,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.recovery;
  r.paths[1].after=0;r.paths[1].older=1;#assert ky_compose(r,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.recovery;r.paths[1].older=0;r.paths[1].after=1;
  // a recovery path that needs the attested co-signer
  r.paths[1].after=0;r.paths[1].older=4320;r.paths[1].keys[1]=w.enrollments[2];
  #assert ky_compose(r,p.e[..],p.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.attested_only;
  q=p;q.e[2].attested=false;#assert ky_compose(r,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.ok;
  // the attested key on the primary path is fine
  pr:=w;q=p;q.e[1].attested=true;#assert ky_compose(pr,q.e[..],q.ind[..],true,KY_MIN_LOCK,KY_H0)==KyCode.ok;
}

#test "a primary path and a recovery path: the miniscript descriptor matches Python's" #steps 600000000 {
  w:=ky_wallet_read(KY_WALLET);p:=ky_parties();
  r:=w;r.npaths=2;
  r.enrollments[0]=w.enrollments[1];r.enrollments[1]=w.enrollments[2];r.enrollments[2]=w.enrollments[0];
  e:[3]KyEnrollment;e[0]=p.e[1];e[1]=p.e[2];e[2]=p.e[0];
  r.paths[0].count=2;r.paths[0].keys[0]=w.enrollments[1];r.paths[0].keys[1]=w.enrollments[2];
  r.paths[1]=w.paths[0];r.paths[1].name="recovery";r.paths[1].threshold=1;r.paths[1].count=1;r.paths[1].keys[0]=w.enrollments[0];r.paths[1].older=4320;
  d:[4096]u8;n:=ky_descriptor(r,e[..],d[..]);
  #assert n>0 && cast(string)d[0..<n]==KY_DESC2;
  #assert ky_layout(r)==KyCode.ok;
  // the primary path second in the list
  s:=r;s.paths[0]=r.paths[1];s.paths[1]=r.paths[0];
  n=ky_descriptor(s,e[..],d[..]);#assert n>0 && cast(string)d[0..<n]==KY_DESC2;
  #assert ky_layout(s)==KyCode.ok;
  // after instead of older
  r.paths[1].older=0;r.paths[1].after=905000;n=ky_descriptor(r,e[..],d[..]);
  #assert n>0 && ky_contains(cast(string)d[0..<n],"/*),and_v(v:after(905000),multi(1,[78c16713/");
  o1:=r;o1.paths[1].older=1;o1.paths[1].after=0;n=ky_descriptor(o1,e[..],d[..]);
  #assert n>0 && ky_contains(cast(string)d[0..<n],"/*),and_v(v:older(1),multi(1,[78c16713/");
  // recovery keys first in enrollment order
  lo:=r;lo.enrollments=w.enrollments;#assert ky_layout(lo)==KyCode.key_order;
  lo.enrollments[0]=w.enrollments[1];lo.enrollments[1]=w.enrollments[0];#assert ky_layout(lo)==KyCode.key_order;
  // three paths: not built
  three:=r;three.npaths=3;three.paths[1].after=0;three.paths[1].older=4320;
  three.paths[0].count=1;three.paths[0].threshold=1;
  three.paths[2]=three.paths[1];three.paths[2].name="later";three.paths[2].keys[0]=w.enrollments[2];
  #assert ky_layout(three)==KyCode.ok && ky_descriptor(three,e[..],d[..])==-1;
  ind:[3]KyIndependence;ind[0]=p.ind[1];ind[1]=p.ind[2];ind[2]=p.ind[0];
  #assert ky_admit(three,e[..],ind[..],true,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.not_built;
  two:=r;two.paths[1].after=0;two.paths[1].older=4320;
  #assert ky_admit(two,e[..],ind[..],false,KY_MIN_LOCK,KY_T0,KY_H0).code==KyCode.descriptor;   // the descriptor is the one-path text
}

#test "rule 4: a weakening successor needs a primary quorum's approvals" {
  w:=ky_wallet_read(KY_WALLET);p:=ky_parties();
  pd:=ky_bytes(KY_WALLET_DIGEST);
  n:=w;n.revision=1;n.has_previous=true;n.previous=pd;
  #assert !ky_weakens(w,p.e[..],n,p.e[..]);
  none:[1]string;
  #assert ky_successor(w,pd,p.e[..],n,p.e[..],none[0..<0])==KyCode.ok;
  x:=n;x.revision=2;#assert ky_successor(w,pd,p.e[..],x,p.e[..],none[0..<0])==KyCode.revision;
  x=n;x.has_previous=false;#assert ky_successor(w,pd,p.e[..],x,p.e[..],none[0..<0])==KyCode.revision;
  x=n;x.previous[0]^=1;#assert ky_successor(w,pd,p.e[..],x,p.e[..],none[0..<0])==KyCode.revision;
  x=n;x.wallet=KY_HOLDER;#assert ky_successor(w,pd,p.e[..],x,p.e[..],none[0..<0])==KyCode.revision;
  // a lower threshold
  low:=n;low.paths[0].threshold=1;
  #assert ky_weakens(w,p.e[..],low,p.e[..]);
  #assert ky_successor(w,pd,p.e[..],low,p.e[..],none[0..<0])==KyCode.approval;
  one:=[1]string.[KY_AGENT1];two:=[2]string.[KY_AGENT1,KY_AGENT2];dup:=[2]string.[KY_AGENT1,KY_AGENT1];
  #assert ky_successor(w,pd,p.e[..],low,p.e[..],one[..])==KyCode.approval;
  #assert ky_successor(w,pd,p.e[..],low,p.e[..],dup[..])==KyCode.approval;
  #assert ky_successor(w,pd,p.e[..],low,p.e[..],two[..])==KyCode.ok;
  first:=[2]string.[KY_AGENT0,KY_AGENT1];#assert ky_successor(w,pd,p.e[..],low,p.e[..],first[..])==KyCode.ok;
  hi:=n;hi.paths[0].threshold=3;#assert !ky_weakens(w,p.e[..],hi,p.e[..]);
  // a removed key agent, a removed or renamed path, a shorter or dropped timelock
  q:=p;q.e[2].agent=KY_WALLET_ID;#assert ky_weakens(w,p.e[..],n,q.e[..]);
  q=p;q.e[0].agent=KY_WALLET_ID;#assert ky_weakens(w,p.e[..],n,q.e[..]);
  rn:=n;rn.paths[0].name="main";#assert ky_weakens(w,p.e[..],rn,p.e[..]);
  r:=w;r.npaths=2;r.paths[1]=w.paths[0];r.paths[1].name="recovery";r.paths[1].older=5000;
  r2:=r;#assert !ky_weakens(r,p.e[..],r2,p.e[..]);
  r2.paths[1].older=4999;#assert ky_weakens(r,p.e[..],r2,p.e[..]);
  r2.paths[1].older=5001;#assert !ky_weakens(r,p.e[..],r2,p.e[..]);
  r2=r;r2.paths[1].older=0;r2.paths[1].after=1;#assert ky_weakens(r,p.e[..],r2,p.e[..]);
  r2=r;r2.npaths=1;#assert ky_weakens(r,p.e[..],r2,p.e[..]);
  a:=r;a.paths[1].older=0;a.paths[1].after=900000;
  a2:=a;a2.paths[1].after=899999;#assert ky_weakens(a,p.e[..],a2,p.e[..]);
  a2.paths[1].after=900001;#assert !ky_weakens(a,p.e[..],a2,p.e[..]);
  // a recovery path turned primary-like (no timelock)
  a2=a;a2.paths[0].older=1;a2.paths[1].after=0;
  #assert ky_weakens(a,p.e[..],a2,p.e[..]);
}

#test "PSBT v0: the unsigned transaction, witness UTXOs, refusals" {
  b:[512]u8;ps:=ky_unhex(KY_PSBT,b[..]);
  t:=ky_psbt_read(ps);
  #assert t.code==KyCode.ok && t.nin==2 && t.nout==2;
  #assert t.in_value[0]==60000 && t.in_value[1]==40000 && t.out_value[0]==70000 && t.out_value[1]==29000;
  #assert t.out_script[0].n==22 && t.out_script[0].b[2]==1 && t.in_script[1].n==34 && t.in_script[1].b[1]==0x20;
  c:[512]u8;
  for k:0..<ps.count {c[k]=ps[k];}
  #assert ky_psbt_read(c[0..<5]).code==KyCode.psbt;
  #assert ky_psbt_read(c[0..<ps.count-1]).code==KyCode.psbt;
  c[ps.count]=0;#assert ky_psbt_read(c[0..<ps.count+1]).code==KyCode.psbt;
  for i:0..<5 {c[i]^=1;#assert ky_psbt_read(c[0..<ps.count]).code==KyCode.psbt;c[i]^=1;}
  // scriptSig not empty: input 0's length byte at 5+4+4+36
  c[49]=1;#assert ky_psbt_read(c[0..<ps.count]).code==KyCode.psbt;c[49]=0;
  // output 0's script, first byte (5+3 to the tx, +4+1+82+1 to output 0, +8 value, +1 length)
  #assert c[104]==22 && c[105]==0;
  c[105]=0x51;#assert ky_psbt_read(c[0..<ps.count]).out_script[0].b[0]==0x51;c[105]=0;
  // a 0xfe size, or an over-long 0xfd form, as the tx key's length
  c[5]=0xfe;#assert ky_psbt_read(c[0..<ps.count]).code==KyCode.psbt;c[5]=1;
  #assert !ky_var(ps,-1).ok && !ky_var(ps,ps.count).ok && ky_var(ps,0).ok;
  v:=[3]u8.[0xfd,0xfd,0x00];#assert ky_var(v[..],0).next==3 && ky_var(v[..],0).value==253;
  v[1]=0xfc;#assert !ky_var(v[..],0).ok;
  #assert !ky_var(v[0..<2],0).ok;
  v[0]=0xfc;#assert ky_var(v[..],0).value==252 && ky_var(v[..],0).next==1;
  v[0]=0xff;#assert !ky_var(v[..],0).ok;
  b7:[7]u8;tv:[1]int;ts:[1]KyScript;#assert ky_txout(b7[..],0,7,tv[..],ts[..])==-1;   // shorter than a value and a size
  b9:[9]u8;b9[0]=5;#assert ky_txout(b9[..],0,9,tv[..],ts[..])==9 && tv[0]==5 && ts[0].n==0;
  b9[0]=0;#assert ky_txout(b9[..],0,9,tv[..],ts[..])==9 && tv[0]==0;   // a zero value is an output
  mx:=[8]u8.[0x00,0x40,0x07,0x5a,0xf0,0x75,0x07,0x00];for k:0..<8 {b9[k]=mx[k];}#assert ky_txout(b9[..],0,9,tv[..],ts[..])==9 && tv[0]==KY_MAX_SAT;
  b9[0]=1;#assert ky_txout(b9[..],0,9,tv[..],ts[..])==-1;   // KY_MAX_SAT + 1
  b9[0]=0;b9[7]=0x80;#assert ky_txout(b9[..],0,9,tv[..],ts[..])==-1;   // negative as a signed 64-bit value
  b9[7]=0;b9[8]=0xff;#assert ky_txout(b9[..],0,9,tv[..],ts[..])==-1;   // a malformed script size
  b73:[73]u8;b73[8]=KY_SCRIPT;b73[9]=0x51;#assert ky_txout(b73[..],0,73,tv[..],ts[..])==73 && ts[0].n==KY_SCRIPT && ts[0].b[0]==0x51;
  #assert ky_txout(b73[..],0,72,tv[..],ts[..])==-1;   // the script runs past end
  bs:[10]u8;bs[8]=5;#assert ky_txout(bs[..],0,10,tv[..],ts[..])==-1;
  // a key length with no key after it
  kl:=[6]u8.['p','s','b','t',0xff,1];#assert ky_psbt_read(kl[..]).code==KyCode.psbt;
  // output 0's script longer than KY_SCRIPT: refused before output 1 is read
  c[104]=65;#assert ky_psbt_read(c[0..<ps.count]).code==KyCode.psbt;c[104]=22;
  v=[3]u8.[0xfd,0x00,0x01];#assert ky_var(v[..],0).value==256;
  v[0]=0xfe;#assert !ky_var(v[..],0).ok;
  #assert ky_psbt_read(ps[0..<4]).code==KyCode.psbt && ky_at(ps,ps.count)==-1 && ky_at(ps,0)=='p';
  #assert ky_le(ps,0,4)==0x74627370;
  // the global version key: 0 is v0, 2 is v2 (not built)
  n:=0;g:[600]u8;
  for k:0..<5 {g[n]=ps[k];n+=1;}
  ver:=[7]u8.[1,0xfb,4,0,0,0,0];
  for k:0..<7 {g[n]=ver[k];n+=1;}
  for k:5..<ps.count {g[n]=ps[k];n+=1;}
  #assert ky_psbt_read(g[0..<n]).code==KyCode.ok;
  g[8]=2;#assert ky_psbt_read(g[0..<n]).code==KyCode.not_built;
  g[8]=0;g[7]=3;#assert ky_psbt_read(g[0..<n]).code!=KyCode.ok;
  // a duplicate unsigned tx: the tx key twice
  m:=0;
  for k:0..<5 {g[m]=ps[k];m+=1;}
  for r:0..<2 {for k:5..<5+3+166 {g[m]=ps[k];m+=1;}}
  for k:5+3+166..<ps.count {g[m]=ps[k];m+=1;}
  #assert ky_psbt_read(g[0..<m]).code==KyCode.psbt;
  // an input map with no witness UTXO: its key type changed to 0x07
  for k:0..<ps.count {c[k]=ps[k];}
  at:=5+3+166+1+1;   // after the global map's 0x00: input 0's key length, key type
  #assert c[at-1]==1 && c[at]==1;
  c[at]=7;#assert ky_psbt_read(c[0..<ps.count]).code==KyCode.inputs;
  c[at]=1;
  // a witness UTXO that is a byte short of its stated length
  c[at+1]=42;#assert ky_psbt_read(c[0..<ps.count]).code==KyCode.psbt;c[at+1]=43;
  // KY_IO inputs and outputs read; none, or one more, refuses
  big:[2048]u8;
  full:=ky_psbt_read(ky_build_psbt(big[..],KY_IO,KY_IO));
  #assert full.code==KyCode.ok && full.nin==KY_IO && full.nout==KY_IO && full.in_value[KY_IO-1]==1 && full.out_value[KY_IO-1]==1;
  #assert ky_psbt_read(ky_build_psbt(big[..],1,1)).code==KyCode.ok;
  #assert ky_psbt_read(ky_build_psbt(big[..],KY_IO+1,1)).code==KyCode.psbt;
  #assert ky_psbt_read(ky_build_psbt(big[..],1,KY_IO+1)).code==KyCode.psbt;
  #assert ky_psbt_read(ky_build_psbt(big[..],1,0)).code==KyCode.psbt;
  #assert ky_psbt_read(ky_build_psbt(big[..],0,1)).code==KyCode.psbt;
  // an input map with its witness UTXO twice
  w1:=ky_build_psbt(big[..],1,1);dw:[256]u8;dn:=0;
  for k:0..<69 {dw[dn]=w1[k];dn+=1;}
  for r:0..<2 {for k:69..<81 {dw[dn]=w1[k];dn+=1;}}
  for k:81..<w1.count {dw[dn]=w1[k];dn+=1;}
  #assert w1[69]==1 && w1[70]==1 && w1[81]==0 && ky_psbt_read(dw[0..<dn]).code==KyCode.psbt;
  // other global keys: a one-byte key that isn't the version, and a longer version-typed key, are ignored
  one:=ky_build_psbt(big[..],1,1);x:[256]u8;
  extra:=[7]u8.[1,0x02,4,2,0,0,0];
  for k:0..<5 {x[k]=one[k];}
  for k:0..<7 {x[5+k]=extra[k];}
  for k:5..<one.count {x[7+k]=one[k];}
  #assert ky_psbt_read(x[0..<one.count+7]).code==KyCode.ok;
  x[5]=2;x[6]=0xfb;x[7]=0;x[8]=3;x[9]=2;x[10]=0;x[11]=0;   // key fb 00, value 02 00 00
  #assert ky_psbt_read(x[0..<one.count+7]).code==KyCode.ok;
  x[5]=1;x[6]=0xfb;x[7]=4;x[8]=2;#assert ky_psbt_read(x[0..<one.count+7]).code==KyCode.not_built;
  // a version value that isn't four bytes is no version this reader knows
  x[5]=1;x[6]=0xfb;x[7]=1;x[8]=0;x[9]=1;x[10]=2;x[11]=0;#assert ky_psbt_read(x[0..<one.count+7]).code==KyCode.not_built;
}

#test "the signer recomputes every output and the fee, and derives change" #steps 200000000 {
  w:=ky_wallet_read(KY_WALLET);p:=ky_parties();wd:=ky_bytes(KY_WALLET_DIGEST);
  b:[512]u8;ps:=ky_unhex(KY_PSBT,b[..]);
  r:=ky_request_read(KY_REQUEST);sc:=ky_fixture_scripts();
  #assert r.code==KyCode.ok && r.nout==2 && r.fee==1000 && r.out[1].change && !r.out[0].change && r.out[0].amount==70000;
  #assert ky_sign_check(w,wd,sc,r,ps,1000,KY_T0)==KyCode.ok;
  #assert ky_sign_check(w,wd,sc,r,ps,999,KY_T0)==KyCode.ceiling;
  #assert ky_sign_check(w,wd,sc,r,ps,1000,1793199999)==KyCode.ok;
  #assert ky_sign_check(w,wd,sc,r,ps,1000,1793200000)==KyCode.deadline;
  ex:=w;ex.expires_at=KY_T0+1;#assert ky_sign_check(ex,wd,sc,r,ps,1000,KY_T0)==KyCode.ok;
  ex.expires_at=KY_T0;#assert ky_sign_check(ex,wd,sc,r,ps,1000,KY_T0)==KyCode.times;
  od:=wd;od[0]^=1;#assert ky_sign_check(w,od,sc,r,ps,1000,KY_T0)==KyCode.wallet;
  #assert ky_sign_check(w,wd,sc,r,ps[0..<ps.count-1],1000,KY_T0)==KyCode.psbt;
  bad:=r;bad.code=KyCode.json;#assert ky_sign_check(w,wd,sc,bad,ps,1000,KY_T0)==KyCode.json;
  // the PSBT pays someone the request doesn't name: every signer refuses
  e2:[512]u8;evil:=ky_unhex(KY_PSBT_EVIL,e2[..]);
  re:=ky_request_read(KY_REQUEST_EVIL);
  #assert ky_sign_check(w,wd,sc,re,evil,1000,KY_T0)==KyCode.outputs;
  // stated amounts, addresses, change flags and fee that differ
  c:[2048]u8;
  #assert ky_sign_check(w,wd,sc,ky_request_read(ky_case(c[..],KY_REQUEST,"\"amount_sat\":70000","\"amount_sat\":70001")),ps,9000,KY_T0)==KyCode.amount;
  #assert ky_sign_check(w,wd,sc,ky_request_read(ky_case(c[..],KY_REQUEST,"\"fee_sat\":1000","\"fee_sat\":999")),ps,9000,KY_T0)==KyCode.fee;
  #assert ky_sign_check(w,wd,sc,ky_request_read(ky_case(c[..],KY_REQUEST,"\"fee_sat\":1000","\"fee_sat\":1001")),ps,9000,KY_T0)==KyCode.fee;
  #assert ky_sign_check(w,wd,sc,ky_request_read(ky_case(c[..],KY_REQUEST,"\"change\":false","\"change\":true")),ps,9000,KY_T0)==KyCode.change;
  #assert ky_sign_check(w,wd,sc,ky_request_read(ky_case(c[..],KY_REQUEST,KY_PAY,KY_RECEIVE0)),ps,9000,KY_T0)==KyCode.outputs;
  #assert ky_sign_check(w,wd,sc,ky_request_read(ky_case(c[..],KY_REQUEST,KY_PAY,"bc1qqypqxpq9qcrsszg2pvxq6rs0zqg3yyc5r7fxez")),ps,9000,KY_T0)==KyCode.address;
  #assert ky_sign_check(w,wd,sc,ky_request_read(ky_case(c[..],KY_REQUEST,",{\"address\":\"tb1qzzx",",{\"amount_sat\":1,\"address\":\"tb1qzzx")),ps,9000,KY_T0)==KyCode.outputs;
  // change to an address the descriptor can't derive within the gap
  #assert ky_is_ours(sc,ky_address(w,KY_CHANGE0),1) && !ky_is_ours(sc,ky_address(w,KY_CHANGE0),0) && ky_is_ours(sc,ky_address(w,KY_CHANGE0),-1);
  #assert ky_is_ours(sc,ky_address(w,KY_RECEIVE0),0) && !ky_is_ours(sc,ky_address(w,KY_RECEIVE0),1);
  #assert !ky_is_ours(sc,ky_address(w,KY_PAY),-1);
  #assert ky_same(sc.s[KY_GAP],ky_address(w,KY_CHANGE0)) && ky_same(sc.s[0],ky_address(w,KY_RECEIVE0));
  #assert !ky_same(sc.s[1],sc.s[0]);
  short:=sc.s[0];short.n=33;#assert !ky_same(short,sc.s[0]);
  b0:=sc.s[0];b0.b[0]=0x51;#assert !ky_same(b0,sc.s[0]);
  emp:KyScripts;emp.s[0]=sc.s[0];emp.s[0].n=0;#assert !ky_is_ours(emp,KyScript.{},-1);
  emp.s[0].n=1;emp.s[0].b[0]=7;#assert ky_is_ours(emp,emp.s[0],-1);   // a one-byte script is a script
  // a valid PSBT the request doesn't name
  bp:[256]u8;#assert ky_sign_check(w,wd,sc,r,ky_build_psbt(bp[..],1,1),1000,KY_T0)==KyCode.psbt;
  // a two-path wallet's spends are not built
  two:=w;two.npaths=2;#assert ky_sign_check(two,wd,sc,r,ps,1000,KY_T0)==KyCode.not_built;
  // an input that isn't the wallet's: the PSBT signed by a request that names it
  ib:[512]u8;for k:0..<ps.count {ib[k]=ps[k];}
  ib[ps.count-4]^=1;                         // the last byte of input 1's script
  d:[32]u8;#assert sha256_hash_checked(ib[0..<ps.count],d[..],false)==SHA_OK;
  h:[64]u8;
  ri:=ky_request_read(ky_case(c[..],KY_REQUEST,"4d98f570ee1e7e274be0736b532e9978fcd92f86743a514ac9a4c480a3ca0812",ky_hexs(d[..],h[..])));
  #assert ky_sign_check(w,wd,sc,ri,ib[0..<ps.count],1000,KY_T0)==KyCode.inputs;
  // an input on the change branch is the wallet's too
  ch:=ky_spk(KY_SPK[KY_GAP]);for k:0..<34 {ib[ps.count-37+k]=ch.b[k];}
  #assert sha256_hash_checked(ib[0..<ps.count],d[..],false)==SHA_OK;
  rc:=ky_request_read(ky_case(c[..],KY_REQUEST,"4d98f570ee1e7e274be0736b532e9978fcd92f86743a514ac9a4c480a3ca0812",ky_hexs(d[..],h[..])));
  #assert ky_sign_check(w,wd,sc,rc,ib[0..<ps.count],1000,KY_T0)==KyCode.ok;
  for k:0..<34 {ib[ps.count-37+k]=ps[ps.count-37+k];}
  ib[ps.count-4]^=1;
  ib[ps.count-4]^=1;ib[12]=0;    // no inputs: a malformed PSBT the request names
  #assert sha256_hash_checked(ib[0..<ps.count],d[..],false)==SHA_OK;
  rm:=ky_request_read(ky_case(c[..],KY_REQUEST,"4d98f570ee1e7e274be0736b532e9978fcd92f86743a514ac9a4c480a3ca0812",ky_hexs(d[..],h[..])));
  #assert ky_sign_check(w,wd,sc,rm,ib[0..<ps.count],1000,KY_T0)==KyCode.psbt;
}

#test "the sign request reads" #steps 600000000 {
  c:[2048]u8;
  rq:=ky_request_read(KY_REQUEST);
  #assert rq.code==KyCode.ok && rq.requester==KY_HOLDER && rq.deadline==1793200000 && rq.fee==1000;
  #assert rq.nonce=="9999999999999999999999999999999999999999999999999999999999999999";
  #assert rq.psbt=="sha256:4d98f570ee1e7e274be0736b532e9978fcd92f86743a514ac9a4c480a3ca0812";
  #assert rq.wallet=="sha256:2bebe1f646fa7a160964bdb94cb7832807bfebc457c8ace2de61947587186323";
  #assert rq.nout==2 && rq.out[1].address==KY_CHANGE0 && rq.out[1].amount==29000 && rq.out[1].change && !rq.out[0].change;
  #assert ky_request_read("[]").code==KyCode.json;
  #assert ky_request_read("{\"v\":\"openagents.keys-sign-request.v1\"").code==KyCode.json;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"{\"action\"","{1:2,\"action\"")).code==KyCode.json;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"size\":2081}}","\"size\":2081}}x")).code==KyCode.json;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"sign-request.v1","sign-request.v2")).code==KyCode.version;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"v\":\"openagents.keys-sign-request.v1\"","\"v\":1")).code==KyCode.version;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"v\":\"openagents.keys-sign-request.v1\",","")).code==KyCode.field;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"requires\":[]","\"requires\":[1]")).code==KyCode.version;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"requires\":[]","\"requires\":[],\"meta\":{}")).code==KyCode.ok;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"requires\":[]","\"requires\":[],\"meta\":null")).code==KyCode.ok;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"requires\":[]","\"requires\":[],\"meta\":[]")).code==KyCode.field;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"requires\":[]","\"requires\":[],\"x\":1")).code==KyCode.field;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"requires\":[]","\"requires\":[],\"requires\":[]")).code==KyCode.field;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"requires\":[],","")).code==KyCode.field;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"action\":null","\"action\":{\"a\":1}")).code==KyCode.ok;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"action\":null","\"action\":1")).code==KyCode.field;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"treasury\":null","\"treasury\":[]")).code==KyCode.field;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"wallet\":{\"digest\":\"sha256:2b","\"wallet\":{\"digest\":\"sha256:2")).code==KyCode.wallet;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"wallet\":{","\"wallet\":1,\"z\":{")).code==KyCode.wallet;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"psbt\":{\"digest\":\"sha256:4d","\"psbt\":{\"digest\":\"sha256:4")).code==KyCode.psbt;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"psbt\":{","\"psbt\":1,\"z\":{")).code==KyCode.psbt;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"requester\":\"79be","\"requester\":\"79bz")).code==KyCode.field;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"requester\":\"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798\"","\"requester\":1")).code==KyCode.field;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"outputs\":[{","\"outputs\":{\"a\":{")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"outputs\":[{","\"outputs\":[1,{")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"outputs\":[{","\"outputs\":[],\"x\":[{")).code==KyCode.field;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"amount_sat\":70000","\"amount_sat\":0")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"amount_sat\":70000","\"amount_sat\":1")).code==KyCode.ok;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"amount_sat\":70000","\"amount_sat\":2100000000000000")).code==KyCode.ok;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"amount_sat\":70000","\"amount_sat\":2100000000000001")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"amount_sat\":70000,","")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"amount_sat\":70000,","\"amount_sat\":70000,\"amount_sat\":70000,")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"amount_sat\":70000,","\"amount_sat\":70000,\"memo\":1,")).code==KyCode.outputs;
  // a bad value that is an array: the output refuses where it stands
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"amount_sat\":70000","\"amount_sat\":[]")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"address\":\"tb1qqypqxpq9qcrsszg2pvxq6rs0zqg3yyc5r7fxez\"","\"address\":[]")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"change\":false}","\"change\":[]}")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"change\":false}","\"change\":false,\"x\":[]}")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"change\":false}","\"change\":false,\"change\":[]}")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,",\"change\":false}","}")).code==KyCode.outputs;
  r1:=ky_request_read(ky_case(c[..],KY_REQUEST,",{\"address\":\"tb1qzzxa9gpdee47e9k7wp8h8ql9h8y5aray38h6z2unnhjhw74jqz0sr0utuy\",\"amount_sat\":29000,\"change\":true}",""));
  #assert r1.code==KyCode.ok && r1.nout==1;
  // KY_IO outputs read; one more refuses
  mo:[2048]u8;mc:[4096]u8;mm:=json_raw(mo[..],0,"\"outputs\":[");
  for k:0..<KY_IO-1 {
    if k==KY_IO-2 {#assert ky_request_read(ky_case(mc[..],KY_REQUEST,"\"outputs\":[",cast(string)mo[0..<mm])).nout==KY_IO;}
    mm=json_raw(mo[..],mm,"{\"address\":\"tb1qqypqxpq9qcrsszg2pvxq6rs0zqg3yyc5r7fxez\",\"amount_sat\":1,\"change\":false},");
  }
  #assert ky_request_read(ky_case(mc[..],KY_REQUEST,"\"outputs\":[",cast(string)mo[0..<mm])).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"{\"address\":\"tb1qqyp","{1:2,\"address\":\"tb1qqyp")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"address\":\"tb1qqypqxpq9qcrsszg2pvxq6rs0zqg3yyc5r7fxez\"","\"address\":1")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"change\":false","\"change\":0")).code==KyCode.outputs;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"fee_sat\":1000","\"fee_sat\":-1")).code==KyCode.fee;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"fee_sat\":1000","\"fee_sat\":0")).code==KyCode.ok;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"fee_sat\":1000","\"fee_sat\":2100000000000000")).code==KyCode.ok;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"fee_sat\":1000","\"fee_sat\":2100000000000001")).code==KyCode.fee;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"purpose\":\"payment\"","\"purpose\":\"Payment\"")).code==KyCode.field;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"purpose\":\"payment\"","\"purpose\":1")).code==KyCode.field;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"purpose\":\"payment\"","\"purpose\":\"hot-topup\"")).code==KyCode.ok;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"nonce\":\"99","\"nonce\":\"9")).code==KyCode.nonce;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"nonce\":\"9999999999999999999999999999999999999999999999999999999999999999\"","\"nonce\":9")).code==KyCode.nonce;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"deadline\":1793200000","\"deadline\":-1")).code==KyCode.deadline;
  #assert ky_request_read(ky_case(c[..],KY_REQUEST,"\"deadline\":1793200000","\"deadline\":0")).code==KyCode.ok;
  #assert at_slug_ky("hot-topup") && at_slug_ky("a0") && !at_slug_ky("") && !at_slug_ky("a_b") && !at_slug_ky("a/") && !at_slug_ky("a:") && !at_slug_ky("a`") && !at_slug_ky("a{");
  #assert at_slug_ky("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") && !at_slug_ky("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
  #assert at_slug_ky("z9") && !at_slug_ky("A");
}

#test "addresses on the wallet's network" {
  w:=ky_wallet_read(KY_WALLET);
  s:=ky_address(w,KY_PAY);#assert s.n==22 && s.b[0]==0 && s.b[1]==20 && s.b[2]==1 && s.b[21]==20;
  #assert ky_address(w,"TB1QQYPQXPQ9QCRSSZG2PVXQ6RS0ZQG3YYC5R7FXEZ").n==22;
  #assert ky_address(w,"bc1qqypqxpq9qcrsszg2pvxq6rs0zqg3yyc5r7fxez").n==0;
  #assert ky_address(w,"bcrt1qqypqxpq9qcrsszg2pvxq6rs0zqg3yyc5r7fxez").n==0;
  #assert a3_segwit("bcrt1qqypqxpq9qcrsszg2pvxq6rs0zqg3yyc5phstwt").status==A3_NETWORK;   // regtest: valid, not this network
  #assert ky_address(w,"bcrt1qqypqxpq9qcrsszg2pvxq6rs0zqg3yyc5phstwt").n==0;
  #assert ky_address(w,"tb1").n==0 && ky_address(w,"tb1qqypqxpq9qcrsszg2pvxq6rs0zqg3yyc5r7fxey").n==0;
  m:=w;m.network="mainnet";
  #assert ky_address(m,KY_PAY).n==0 && ky_address(m,"bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4").n==22;
  #assert ky_address(m,"1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2").n==0;
  // Taproot: version 1 is OP_1 (0x51)
  tr:=ky_address(m,"bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0");
  #assert tr.n==34 && tr.b[0]==0x51 && tr.b[1]==32;
}

#test "idempotency: an exact retry returns the retained outcome; a changed request with a used nonce refuses" {
  l:=[1]KyLedger.[KyLedger.{}];
  r:=ky_request_read(KY_REQUEST);re:=ky_request_read(KY_REQUEST_EVIL);
  x:=ky_consume(l[..],KY_AGENT1,r,KyCode.ok);#assert x.code==KyCode.ok && !x.retry && l[0].count==1;
  x=ky_consume(l[..],KY_AGENT1,r,KyCode.fee);#assert x.code==KyCode.ok && x.retry && l[0].count==1;
  x=ky_consume(l[..],KY_AGENT2,r,KyCode.ok);#assert !x.retry && l[0].count==2;
  c:[2048]u8;
  ch:=ky_request_read(ky_case(c[..],KY_REQUEST,"\"fee_sat\":1000","\"fee_sat\":1100"));
  x=ky_consume(l[..],KY_AGENT1,ch,KyCode.ok);#assert x.code==KyCode.nonce && !x.retry && l[0].count==2;
  d0:=r;d0.digest[0]^=1;x=ky_consume(l[..],KY_AGENT1,d0,KyCode.ok);#assert x.code==KyCode.nonce && !x.retry;
  last:=ky_request_read(ky_case(c[..],KY_REQUEST,"\"deadline\":1793200000","\"deadline\":1793200001"));
  x=ky_consume(l[..],KY_AGENT1,last,KyCode.ok);#assert x.code==KyCode.nonce;
  x=ky_consume(l[..],KY_AGENT1,re,KyCode.outputs);#assert x.code==KyCode.outputs && !x.retry && l[0].count==3;
  x=ky_consume(l[..],KY_AGENT1,re,KyCode.ok);#assert x.code==KyCode.outputs && x.retry;
  other:=r;other.requester=KY_AGENT2;
  x=ky_consume(l[..],KY_AGENT1,other,KyCode.ok);#assert !x.retry && l[0].count==4;
  full:=[1]KyLedger.[KyLedger.{}];full[0].count=KY_LEDGER-1;
  x=ky_consume(full[..],KY_AGENT1,r,KyCode.ok);#assert x.code==KyCode.ok && full[0].count==KY_LEDGER;
  x=ky_consume(full[..],KY_AGENT1,re,KyCode.ok);#assert x.code==KyCode.nonce && full[0].count==KY_LEDGER;
}

#test "timelocks, retired wallets, compromised agents, the co-signer's delay, the hot ceiling" {
  p:KyPath;p.older=4320;
  #assert ky_path_open(p,100,100+4319)==KyCode.ok && ky_path_open(p,100,100+4318)==KyCode.locked;
  p.older=0;p.after=905000;
  #assert ky_path_open(p,0,905000)==KyCode.ok && ky_path_open(p,0,904999)==KyCode.locked;
  p.after=0;#assert ky_path_open(p,5,0)==KyCode.ok;
  p.older=1;#assert ky_path_open(p,KY_H0+1,KY_H0)==KyCode.locked && ky_path_open(p,KY_H0,KY_H0)==KyCode.ok;
  p.older=0;p.after=1;#assert ky_path_open(p,0,0)==KyCode.locked && ky_path_open(p,0,1)==KyCode.ok;p.after=0;
  d:=ky_bytes(KY_WALLET_DIGEST);sweeps:=[1]string.["sha256:2bebe1f646fa7a160964bdb94cb7832807bfebc457c8ace2de61947587186323"];
  none:[1]string;
  #assert ky_retired(false,d,none[0..<0])==KyCode.ok && ky_retired(true,d,sweeps[..])==KyCode.ok && ky_retired(true,d,none[0..<0])==KyCode.retired;
  o:=d;o[3]^=1;#assert ky_retired(true,o,sweeps[..])==KyCode.retired;
  q:KyPath;q.count=3;q.threshold=2;
  #assert ky_sweep_signer(q,1,true)==KyCode.compromised && ky_sweep_signer(q,1,false)==KyCode.ok && ky_sweep_signer(q,2,true)==KyCode.ok;
  #assert ky_delay(1000000,1000000,86400,0,0,false)==KyCode.ok && ky_delay(1000001,1000000,86400,0,86399,false)==KyCode.delay;
  #assert ky_delay(1000001,1000000,86400,0,86400,false)==KyCode.ok && ky_delay(1000001,1000000,86400,0,86400,true)==KyCode.delay;
  #assert ky_delay(5,1000000,86400,0,0,true)==KyCode.ok;
  #assert ky_topup(0,1000,1000000)==KyCode.ok && ky_topup(1,1000,1000000)==KyCode.hot && ky_topup(0,1001,1000000)==KyCode.hot;
  #assert ky_topup(-1,0,1000000)==KyCode.hot && ky_topup(0,-1,1000000)==KyCode.hot && ky_topup(0,0,0)==KyCode.ok;
  #assert ky_topup(0,2100000000000000,2100000000000000000)==KyCode.ok && ky_topup(0,2100000000000001,9000000000000000000)==KyCode.hot;
}

#test "a failed read's record carries only its code" {
  #assert ky_wfail(KyCode.json).code==KyCode.json && ky_wfail(KyCode.json).npaths==0;
  #assert ky_efail(KyCode.xpub).code==KyCode.xpub && ky_ifail(KyCode.operator).code==KyCode.operator && ky_rfail(KyCode.fee).code==KyCode.fee;
}

#test "BIP-32 public derivation to P2WSH scripts matches Python" #steps 800000000 {
  w:=ky_wallet_read(KY_WALLET);p:=ky_parties();
  b:[3]KyExtKey;for i:0..<3 {b[i]=ky_branch1(i);}
  #assert ky_same(ky_script(w,b[..],0),ky_spk(KY_SPK[2]));    // sorted: enclave 0396.., alice 0399.., keyco 03c6..
  e:[3]KyExtKey;#assert ky_script(w,e[..],0).n==0;
  one:=w;one.nenroll=1;one.paths[0].threshold=1;one.paths[0].count=1;
  sc:=ky_scripts(one,p.e[0..<1]);
  for i:0..<4 {#assert ky_same(sc.s[i],ky_spk(KY_SPK1[i]));}
}

#test "BIP-32 vector 1: the public child of m/0H at index 1" #steps 900000000 {
  p:=ky_ext_key(KY_BIP32_M0H);
  #assert p.ok && p.version==KY_XPUB;
  c:=ky_child(p,1);
  #assert c.ok && a3_hex_is(c.key[..],"03501e454bf00751f24b1b489aa925215d66af2234e3891c3b21a52bedb3cd711c");
  #assert c.version==KY_XPUB;
  k1:=ky_child(p,0x01000000);k0:=ky_child(p,0);same:=true;for k:0..<33 {if k1.key[k]!=k0.key[k] {same=false;}}
  #assert k1.ok && k0.ok && !same;   // the index's top byte counts
  k2:=ky_child(p,256);same=true;for k:0..<33 {if k2.key[k]!=k0.key[k] {same=false;}}
  #assert k2.ok && !same;   // and its second-lowest
  #assert !ky_child(p,BIP32_HARDENED).ok && !ky_child(p,-1).ok && !ky_child(KyExtKey.{},0).ok;
  #assert ky_child(p,BIP32_HARDENED-1).ok;
  off:=p;for k:1..<33 {off.key[k]=0;}#assert !ky_child(off,1).ok;   // x = 0 is not on the curve
  #assert !ky_ext_key(KY_BIP32_BAD).ok;                       // one character changed: checksum
  #assert !ky_ext_key("0pub68Gmy5EdvgibQVfPdqkBBCHxA5htiqg55crXYuXoQRKfDBFA1WEjWgP6LHhwBZeNK1VTsfTFUHCdrfp1bgwQ9xv5ski8PX9rL2dZXvgGDnw").ok;
  #assert !ky_ext_key("xpub").ok && !ky_ext_key(KY_ZZZ).ok;
  #assert ky_ext_key(KY_BIP32_M0H[0..<100]).ok==false && ky_ext_key(KY_BIP32_XPRV).ok==false;
  #assert !ky_ext_key("xpub68Gmy5EdvgibQVfPdqkBBCHxA5htiqg55crXYuXoQRKfDBFA1WEjWgP6LHhwBZeNK1VTsfTFUHCdrfp1bgwQ9xv5ski8PX9rL2dZXvhkD5H").ok;   // checksum byte 0
  xc:[128]u8;#assert !ky_ext_key(ky_case(xc[..],KY_BIP32_M0H,"A1W","A0W")).ok;   // 0 is not base58, though it would decode as 1
  #assert !ky_ext_key("").ok;
  // m/0H re-encoded (Python): the key's prefix byte 04, and the xprv version on its public key
  #assert !ky_ext_key("xpub68Gmy5EdvgibQVfPdqkBBCHxA5htiqg55crXYuXoQRKfDBFA1WEjWgP6LKegMo6QASAh1V2xNrpdozQnWoZ7ofkxfPnEdfqkKgdx2UeV3g6").ok;
  #assert !ky_ext_key("xprv9uHRZZhk6KAJC1avXpDAp4MDc3sQKNxDiPvvkX8Br5ngLNv1TxvUxt4cV6Zf6PVmuH3TyDLKoXTBFEGDi2SrQ7KvMkPkYCLoQAkKmqjFUY5").ok;
  #assert ky_ext_key(ky_origin(KY_XPUB0)).version==KY_TPUB;
}
