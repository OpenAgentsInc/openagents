// Chapter 104: NIP-KEYS, a network of keys. Collaborative custody of
// on-chain bitcoin: a wallet whose coins move only when enough independent
// key agents sign. This file is the pure-contract layer (NIP-KEYS
// implementation step 1) and the signer's PSBT recomputation (part of step 2):
//
// - the BIP-380 descriptor checksum;
// - closed readers for the wallet, enrollment, independence and
//   sign-request bodies;
// - BIP-32 xpub/tpub decoding and public child derivation;
// - admission: the descriptor recomputed from paths and enrollments
//   (wsh(sortedmulti) for one path, wsh(or_d(multi, and_v(v:older|after,
//   multi))) for a primary path and one recovery path), and composition
//   rules 1 to 4;
// - the signer's checks before it signs: the request's wallet and PSBT
//   digests, every input the wallet's, every output and the fee recomputed
//   from the PSBT v0 bytes, change derived from the descriptor, the fee
//   ceiling, nonce idempotency, recovery timelocks, retired wallets,
//   compromised agents in a sweep, the attested co-signer's large-spend
//   delay and the hot-balance ceiling.
//
// Not built: producing any signature (ECDSA with BIP-143 sighashes for wsh,
// Schnorr with BIP-341 sighashes for tr), BIP-322 possession proofs (read,
// never verified: ky_admit reports proven=false), PSBT v2, Taproot tr()
// descriptors, miniscript script compilation for wallets with a recovery
// path (their descriptors are recomputed, their spends refuse not_built),
// receipt, liveness, rotation and agency-terms bodies, the 3188 transport,
// and anything on signet. MuSig2 and FROST are out of scope in NIP-KEYS v1
// and refuse as an unknown family.
//
// The caller verifies each 3188 artifact's signature and recipients first
// and passes the signer and the decrypted body.
#load "json.coax";
#load "nipa3.coax";
#load "../crypto/sha256.coax";
#load "../crypto/bip32.coax";
#load "../crypto/secp_mult.coax";
#authority;

KyCode :: enum u8 {ok;json;version;field;wallet;holder;revision;network;descriptor;checksum;family;paths;threshold;timelock;primary;enrollment;key_order;xpub;recipient;times;attestation;operator;sovereign;recovery;attested_only;weakening;approval;psbt;inputs;outputs;amount;address;change;fee;ceiling;nonce;deadline;locked;retired;compromised;delay;hot;not_built;}

KY_PATHS :: 8;             // spending paths in one wallet
KY_KEYS :: 16;             // enrollments in one wallet, keys in one path
KY_IO :: 16;               // inputs or outputs in one PSBT
KY_SCRIPT :: 64;           // the longest scriptPubKey read
KY_GAP :: 2;               // receive and change indexes the signer derives
KY_MIN_LOCK :: 4320;       // composition rule 3: about 30 days of blocks
KY_LEDGER :: 32;           // retained receipts in one signer's ledger
KY_MAX_SAT :: 2100000000000000;
KY_TPUB :: 0x043587cf;     // testnet4 and signet extended public keys
KY_XPUB :: 0x0488b21e;     // mainnet

KyPath :: struct {name:string;threshold:int;count:int;keys:[KY_KEYS][32]u8;older:int;after:int;}
KyWallet :: struct {
  code:KyCode;wallet:string;holder:string;revision:int;previous:[32]u8;has_previous:bool;network:string;descriptor:string;
  npaths:int;paths:[KY_PATHS]KyPath;nenroll:int;enrollments:[KY_KEYS][32]u8;nrecip:int;recipients:[KY_KEYS][32]u8;
  starts_at:int;expires_at:int;
}
KyEnrollment :: struct {code:KyCode;digest:[32]u8;agent:string;wallet:string;xpub:string;key:string;attested:bool;independence:string;expires_at:int;}
KyIndependence :: struct {code:KyCode;digest:[32]u8;agent:string;op:string;}
KyStated :: struct {address:string;amount:int;change:bool;}
KyRequest :: struct {code:KyCode;digest:[32]u8;wallet:string;requester:string;psbt:string;nout:int;out:[KY_IO]KyStated;fee:int;nonce:string;deadline:int;}
KyScript :: struct {n:int;b:[KY_SCRIPT]u8;}
KyPsbt :: struct {code:KyCode;nin:int;nout:int;in_value:[KY_IO]int;in_script:[KY_IO]KyScript;out_value:[KY_IO]int;out_script:[KY_IO]KyScript;}
KyExtKey :: struct {ok:bool;version:int;chain:[32]u8;key:[33]u8;}
KyAdmit :: struct {code:KyCode;proven:bool;}
KyEntry :: struct {agent:string;requester:string;nonce:string;digest:[32]u8;code:KyCode;}
KyLedger :: struct {count:int;e:[KY_LEDGER]KyEntry;}
KyRetry :: struct {code:KyCode;retry:bool;}

#load "../../tests/nostr/keys_fixtures.coax";

// ---- the BIP-380 descriptor checksum
// book:begin checksum
KY_INPUT :: "0123456789()[],'/*abcdefgh@:$%{}IJKLMNOPQRSTUVWXYZ&+-.;<=>?!^_|~ijklmnopqrstuvwxyzABCDEFGH`#\"\\ ";
KY_CHECK :: "qpzry9x8gf2tvdw0s3jn54khce6mua7l";
KY_GEN :: [5] u64.[0xf5dee51989, 0xa9fdca3312, 0x1bab10e32d, 0x3706b1677a, 0x644d626ffd];
ky_polymod :: (c:u64,v:u64)->u64 {
  top:=c>>35;r:=((c&0x7ffffffff)<<5)^v;
  for i:0..<KY_GEN.count {if ((top>>cast(u64)i)&1)!=0 {r^=KY_GEN[i];}}
  return r;
}
// The eight checksum characters of a descriptor without its "#...", into
// out; false on a character outside BIP-380's input set.
ky_checksum :: (s:string,out:[]u8)->bool {
  c:u64=1;cls:u64=0;count:=0;
  for ch:s {
    pos:=-1;for k:0..<KY_INPUT.count {if KY_INPUT[k]==ch {pos=k;}}
    if pos<0 {return false;}
    c=ky_polymod(c,cast(u64)(pos&31));cls=cls*3+cast(u64)(pos>>5);count+=1;
    if count==3 {c=ky_polymod(c,cls);cls=0;count=0;}
  }
  if count>0 {c=ky_polymod(c,cls);}
  for k:0..<8 {c=ky_polymod(c,0);}
  c^=1;
  for j:0..<8 {out[j]=KY_CHECK[cast(int)((c>>cast(u64)(5*(7-j)))&31)];}
  return true;
}
// book:end checksum
// A descriptor "body#checksum" whose checksum is right.
ky_checksum_ok :: (d:string)->bool {
  if d.count<10 || d[d.count-9]!='#' {return false;}
  cs:[8]u8;if !ky_checksum(d[0..<d.count-9],cs[..]) {return false;}
  for k:0..<8 {if cs[k]!=d[d.count-8+k] {return false;}}
  return true;
}

#test "BIP-380: raw(deadbeef) has checksum 89f8spxm; the wallets' checksums match Python" {
  cs:[8]u8;
  #assert ky_checksum("raw(deadbeef)",cs[..]) && cast(string)cs[..]=="89f8spxm";
  #assert ky_checksum_ok("raw(deadbeef)#89f8spxm");
  #assert !ky_checksum_ok("raw(deadbeef)#89f8spxn") && !ky_checksum_ok("raw(deadbeef)#99f8spxm");
  q:[10]u8;q[0]='a';q[1]='#';#assert ky_checksum("a",q[2..<10]) && ky_checksum_ok(cast(string)q[..]);   // the shortest body
  #assert ky_checksum("",q[2..<10]) && !ky_checksum_ok(cast(string)q[1..<10]);   // an empty body is no descriptor
  #assert !ky_checksum_ok("raw(deadbeef)x89f8spxm");
  #assert !ky_checksum_ok("#89f8spxm");
  #assert !ky_checksum_ok("raw(deadbeee)#89f8spxm");
  #assert !ky_checksum("raw(é)",cs[..]) && !ky_checksum_ok("raw(é)#89f8spxm");
  #assert ky_checksum_ok(KY_DESC2);
  #assert ky_checksum("wsh(multi(1,A,BC))",cs[..]) && cast(string)cs[..]=="c9c7qek3";
}

// ---- small readers
ky_hex64 :: (s:string)->bool {
  if s.count!=64 {return false;}
  for c:s {if !((c>='0' && c<='9') || (c>='a' && c<='f')) {return false;}}
  return true;
}
ky_uint :: (j:[]Json,t:int)->int {
  if t!=JSON_NUMBER {return -1;}v:=json_int(json_text(j));if !v.ok || v.value<0 {return -1;}return v.value;
}
ky_requires_empty :: (j:[]Json,t:int)->bool {return t==JSON_ARRAY && json_next(j)==JSON_ARRAY_END;}
ky_field :: (key:string,names:[]string)->int {for i:0..<names.count {if json_is(key,names[i]) {return i;}}return -1;}
ky_digest_is :: (ref:string,d:[32]u8)->bool {
  if ref.count!=71 {return false;}
  hx:="0123456789abcdef";
  for i:0..<32 {if ref[7+2*i]!=hx[cast(int)(d[i]>>4)] || ref[8+2*i]!=hx[cast(int)(d[i]&15)] {return false;}}
  return true;
}
// The SHA-256 of a string's bytes, fed 64 at a time.
// 64 lowercase hex characters (checked by the caller) into 32 bytes.
ky_bytes :: (h:string)->[32]u8 {
  r:[32]u8;
  for i:0..<32 {r[i]=cast(u8)(ky_nibble(h[2*i])*16+ky_nibble(h[2*i+1]));}
  return r;
}
ky_nibble :: (c:u8)->int {return ifx c>='a' then cast(int)(c-'a')+10 else cast(int)(c-'0');}
ky_eq32 :: (a:[32]u8,b:[32]u8)->bool {for k:0..<32 {if a[k]!=b[k] {return false;}}return true;}
ky_sha :: (s:string,out:[]u8)->bool {
  state:[112]u8;chunk:[64]u8;
  #assert sha256_init(state[..])==SHA_OK;
  n:=0;
  for c:s {
    chunk[n]=c;n+=1;
    if n==chunk.count {#assert sha256_update_checked(state[..],chunk[..],false)==SHA_OK;n=0;}
  }
  #assert sha256_update_checked(state[..],chunk[0..<n],false)==SHA_OK;
  return sha256_final_checked(state[..],out,false)==SHA_OK;
}
// An ArtifactRef object (the opening brace read): its digest, or "" when it
// isn't one. size and media_type are required; schema, event and sources
// are allowed and not interpreted here.
ky_ref :: (j:[]Json)->string {
  names:=[6]string.["digest","size","media_type","schema","event","sources"];
  seen:=0;digest:string;
  while true {
    t:=json_next(j);if t==JSON_OBJECT_END {break;}if t!=JSON_STRING {return "";}
    f:=ky_field(json_text(j),names[..]);t=json_next(j);
    if f<0 || (seen&(1<<f))!=0 {return "";}seen|=1<<f;
    if f==0 {d:=json_text(j);if t!=JSON_STRING || d.count!=71 || d[0..<7]!="sha256:" || !ky_hex64(d[7..<71]) {return "";}digest=d;}
    else if f==1 {if ky_uint(j,t)<0 {return "";}}
    else if f==2 || f==3 {if t!=JSON_STRING {return "";}}
    else if f==4 {if t!=JSON_OBJECT || !json_skip(j) {return "";}}
    else {if t!=JSON_ARRAY || !json_skip(j) {return "";}}
  }
  if (seen&7)!=7 {return "";}
  return digest;
}
// A list of ArtifactRefs into out as digest bytes; the count, or -1.
ky_refs :: (j:[]Json,t:int,out:[][32]u8)->int {
  if t!=JSON_ARRAY {return -1;}
  n:=0;v:=json_next(j);
  while v!=JSON_ARRAY_END {
    if v!=JSON_OBJECT || n==out.count {return -1;}
    d:=ky_ref(j);if d.count==0 {return -1;}
    out[n]=ky_bytes(d[7..<71]);n+=1;v=json_next(j);
  }
  return n;
}
// A list of 64-hex public keys into out; the count, or -1.
ky_keys :: (j:[]Json,t:int,out:[][32]u8)->int {
  if t!=JSON_ARRAY {return -1;}
  n:=0;v:=json_next(j);
  while v!=JSON_ARRAY_END {
    if v!=JSON_STRING || n==out.count || !ky_hex64(json_text(j)) {return -1;}
    out[n]=ky_bytes(json_text(j));n+=1;v=json_next(j);
  }
  return n;
}

// ---- the wallet
// book:begin path
// One spending path: name, threshold, keys (enrollment ArtifactRefs) and
// timelock (null, {older: blocks} or {after: height}).
ky_path :: (j:[]Json,p:[]KyPath)->KyCode {
  names:=[4]string.["name","threshold","keys","timelock"];
  seen:=0;
  while true {
    t:=json_next(j);if t==JSON_OBJECT_END {break;}if t!=JSON_STRING {return KyCode.paths;}
    f:=ky_field(json_text(j),names[..]);t=json_next(j);
    if f<0 || (seen&(1<<f))!=0 {return KyCode.paths;}seen|=1<<f;
    if f==0 {if t!=JSON_STRING || json_text(j).count==0 {return KyCode.paths;}p[0].name=json_text(j);}
    else if f==1 {p[0].threshold=ky_uint(j,t);}
    else if f==2 {p[0].count=ky_refs(j,t,p[0].keys[..]);if p[0].count<1 {return KyCode.paths;}}
    else if t!=JSON_NULL {
      if t!=JSON_OBJECT || json_next(j)!=JSON_STRING {return KyCode.timelock;}
      older:=json_is(json_text(j),"older");
      if !older && !json_is(json_text(j),"after") {return KyCode.timelock;}
      v:=ky_uint(j,json_next(j));
      if v<1 || json_next(j)!=JSON_OBJECT_END {return KyCode.timelock;}
      if older {p[0].older=v;} else {p[0].after=v;}
    }
  }
  if seen!=15 {return KyCode.paths;}
  if p[0].threshold<1 || p[0].threshold>p[0].count {return KyCode.threshold;}
  return KyCode.ok;
}
// book:end path
KY_WALLET_FIELDS :: [14] string.["v","requires","meta","wallet","holder","revision","previous","network","descriptor","paths","enrollments","recipients","starts_at","expires_at"];
// book:begin wallet
ky_wallet_read :: (content:string)->KyWallet {
  w:=[1]KyWallet.[KyWallet.{}];names:=KY_WALLET_FIELDS;
  j:[1]Json;json_start(j[..],content);if json_next(j[..])!=JSON_OBJECT {return ky_wfail(KyCode.json);}
  seen:=0;
  while true {
    t:=json_next(j[..]);if t==JSON_OBJECT_END {break;}if t!=JSON_STRING {return ky_wfail(KyCode.json);}
    f:=ky_field(json_text(j[..]),names[..]);t=json_next(j[..]);
    if f<0 || (seen&(1<<f))!=0 {return ky_wfail(KyCode.field);}seen|=1<<f;
    s:=json_text(j[..]);
    if f==0 {if t!=JSON_STRING || !json_is(s,"openagents.keys-wallet.v1") {return ky_wfail(KyCode.version);}}
    else if f==1 {if !ky_requires_empty(j[..],t) {return ky_wfail(KyCode.version);}}
    else if f==2 {if t!=JSON_OBJECT || !json_skip(j[..]) {return ky_wfail(KyCode.field);}}
    else if f==3 {if t!=JSON_STRING || !ky_hex64(s) {return ky_wfail(KyCode.wallet);}w[0].wallet=s;}
    else if f==4 {if t!=JSON_STRING || !ky_hex64(s) {return ky_wfail(KyCode.holder);}w[0].holder=s;}
    else if f==5 {w[0].revision=ky_uint(j[..],t);if w[0].revision<0 {return ky_wfail(KyCode.revision);}}
    else if f==6 {
      if t==JSON_OBJECT {d:=ky_ref(j[..]);if d.count==0 {return ky_wfail(KyCode.revision);}w[0].previous=ky_bytes(d[7..<71]);w[0].has_previous=true;}
      else if t!=JSON_NULL {return ky_wfail(KyCode.revision);}
    }
    else if f==7 {
      if t!=JSON_STRING || !(json_is(s,"mainnet") || json_is(s,"testnet4") || json_is(s,"signet")) {return ky_wfail(KyCode.network);}
      w[0].network=s;
    }
    else if f==8 {if t!=JSON_STRING || !ky_checksum_ok(s) {return ky_wfail(KyCode.checksum);}w[0].descriptor=s;}
    else if f==9 {
      if t!=JSON_ARRAY {return ky_wfail(KyCode.paths);}
      v:=json_next(j[..]);
      while v!=JSON_ARRAY_END {
        if w[0].npaths==KY_PATHS {return ky_wfail(KyCode.paths);}   // a non-object never reads as a path
        c:=ky_path(j[..],w[0].paths[w[0].npaths..<w[0].npaths+1]);
        if c!=KyCode.ok {return KyWallet.{code=c};}
        w[0].npaths+=1;v=json_next(j[..]);
      }
    }
    else if f==10 {w[0].nenroll=ky_refs(j[..],t,w[0].enrollments[..]);if w[0].nenroll<1 {return ky_wfail(KyCode.enrollment);}}
    else if f==11 {w[0].nrecip=ky_keys(j[..],t,w[0].recipients[..]);if w[0].nrecip<1 {return ky_wfail(KyCode.recipient);}}
    else if f==12 {w[0].starts_at=ky_uint(j[..],t);}
    else {w[0].expires_at=ky_uint(j[..],t);}
  }
  if json_next(j[..])!=JSON_END {return ky_wfail(KyCode.json);}
  if (seen|4)!=16383 {return ky_wfail(KyCode.field);}
  if (w[0].revision==0)==w[0].has_previous {return ky_wfail(KyCode.revision);}
  if w[0].starts_at<0 || w[0].expires_at<=w[0].starts_at {return ky_wfail(KyCode.times);}
  if w[0].npaths<1 {return ky_wfail(KyCode.paths);}
  primary:=0;
  for i:0..<w[0].npaths {
    if w[0].paths[i].older==0 && w[0].paths[i].after==0 {primary+=1;}
    for k:0..<i {if w[0].paths[k].name==w[0].paths[i].name {return ky_wfail(KyCode.paths);}}
  }
  if primary!=1 {return ky_wfail(KyCode.primary);}
  return w[0];
}
// book:end wallet
// The primary path's index (the one with no timelock).
ky_primary :: (w:KyWallet)->int {
  for i:0..<w.npaths {if w.paths[i].older==0 && w.paths[i].after==0 {return i;}}
  return 0;
}

// ---- extended public keys
KY_B58 :: "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
// book:begin xpub
// A base58check extended public key: 78 bytes, version, depth, parent
// fingerprint, child number, chain code and a compressed public key.
ky_ext_key :: (s:string)->KyExtKey {
  r:KyExtKey;b:[82]u8;
  for c:s {
    d:=-1;for k:0..<58 {if KY_B58[k]==c {d=k;}}
    if d<0 {return r;}
    carry:=d;
    for k:0..<82 {carry+=cast(int)b[81-k]*58;b[81-k]=cast(u8)(carry&255);carry=carry>>8;}
    if carry!=0 {return r;}
  }
  h:[32]u8;h2:[32]u8;
  if sha256_hash_checked(b[0..<78],h[..],false)!=SHA_OK || sha256_hash_checked(h[..],h2[..],false)!=SHA_OK {return r;}
  for k:0..<4 {if h2[k]!=b[78+k] {return r;}}
  r.version=(cast(int)b[0]<<24)|(cast(int)b[1]<<16)|(cast(int)b[2]<<8)|cast(int)b[3];
  for k:0..<32 {r.chain[k]=b[13+k];}
  for k:0..<33 {r.key[k]=b[45+k];}
  r.ok=(r.version==KY_TPUB || r.version==KY_XPUB) && (r.key[0]==2 || r.key[0]==3);   // the point is decoded when used
  return r;
}
// The public child at a normal index: K + IL·G, chain code IR.
ky_child :: (parent:KyExtKey,index:int)->KyExtKey {
  r:KyExtKey;p:=parent;
  if !p.ok || index<0 || index>=BIP32_HARDENED {return r;}
  data:[37]u8;i:[64]u8;
  for k:0..<33 {data[k]=p.key[k];}
  for k:0..<4 {data[33+k]=cast(u8)((index>>(8*(3-k)))&255);}
  if !hmac_sha512(p.chain[..],data[..],i[..]) {return r;}
  il:=sc_load(i[0..<32]);a:=sg_decode_public(p.key[..]);
  if !il.ok || !a.ok {return r;}                          // IL >= n, or a key off the curve
  s:=ecmult_vartime(il.value,a.value,sc_small(1));        // IL·G + K: public data, variable time
  e:=sg_encode_public(s.value);
  if e.length!=33 {return r;}                             // infinity encodes as one byte
  for k:0..<33 {r.key[k]=e.bytes[k];}
  for k:0..<32 {r.chain[k]=i[32+k];}
  r.version=p.version;r.ok=true;return r;
}
// book:end xpub
// s[i], or 0 past the end.
ky_ch :: (s:string,i:int)->u8 {return ifx i<s.count then s[i] else 0;}
// An enrollment's xpub field: "[" 8 lowercase hex, then "/" and indexes
// with an optional h or ', "]", then the extended key. The key part, or "".
ky_origin :: (s:string)->string {
  if ky_ch(s,0)!='[' || ky_ch(s,9)!='/' {return "";}
  for k:1..<9 {c:=ky_ch(s,k);if !((c>='0' && c<='9') || (c>='a' && c<='f')) {return "";}}
  i:=10;
  while true {
    n:=0;while i<s.count && s[i]>='0' && s[i]<='9' && n<11 {i+=1;n+=1;}
    if n==0 || n==11 || i==s.count {return "";}
    if s[i]=='h' || s[i]=='\'' {i+=1;}
    if i==s.count {return "";}
    if s[i]==']' {return s[i+1..<s.count];}
    if s[i]!='/' {return "";}
    i+=1;
  }
  return "";
}

#test "an origin: fingerprint, indexes, closing bracket" {
  #assert ky_origin("[78c16713/48h/1h/0h/2h]tpubX")=="tpubX";
  #assert ky_origin("[78c16713/48'/1]tpubX")=="tpubX";
  #assert ky_origin("[78c16713/0]x")=="x";
  #assert ky_origin("[78c16713]tpubX")=="" && ky_origin("(78c16713/0]tpubX")=="";
  #assert ky_origin("[78C16713/0]tpubX")=="" && ky_origin("[78c1671g/0]tpubX")=="" && ky_origin("[78c1671/0]]tpubX")=="";
  #assert ky_origin("[78c16713/]tpubX")=="" && ky_origin("[78c16713/0")=="" && ky_origin("[78c16713/0h")=="";
  #assert ky_origin("[78c16713/0x]tpubX")=="" && ky_origin("[78c16713/12345678901]tpubX")=="";
  #assert ky_origin("[78c16713/1234567890]X")=="X" && ky_origin("[78c16713/0/")=="";
  #assert ky_origin("[78c1671:/0]x")=="" && ky_origin("[78c1671`/0]x")=="" && ky_origin("[78c1671//0]x")=="";
  #assert ky_origin("[0123abcd/0]x")=="x" && ky_origin("[456789ef/0]x")=="x";
  #assert ky_origin("[78c16713/4:]x")=="" && ky_origin("[78c16713/123456789012]X")=="";
  #assert ky_origin("[78c16713")=="" && ky_origin("")=="" && ky_ch("ab",1)=='b' && ky_ch("ab",2)==0;
  #assert ky_origin("[g8c16713/0]x")=="";
}

// ---- enrollment and independence
KY_ENR_FIELDS :: [12] string.["v","requires","meta","agent","wallet","xpub","possession","class","attestation","signing_policy","independence","expires_at"];
// book:begin enrollment
ky_enrollment_read :: (signer:string,content:string)->KyEnrollment {
  e:KyEnrollment;cls:string;att:=false;names:=KY_ENR_FIELDS;
  if !ky_sha(content,e.digest[..]) {return ky_efail(KyCode.json);}
  j:[1]Json;json_start(j[..],content);if json_next(j[..])!=JSON_OBJECT {return ky_efail(KyCode.json);}
  seen:=0;
  while true {
    t:=json_next(j[..]);if t==JSON_OBJECT_END {break;}if t!=JSON_STRING {return ky_efail(KyCode.json);}
    f:=ky_field(json_text(j[..]),names[..]);t=json_next(j[..]);
    if f<0 || (seen&(1<<f))!=0 {return ky_efail(KyCode.field);}seen|=1<<f;
    s:=json_text(j[..]);
    if f==0 {if t!=JSON_STRING || !json_is(s,"openagents.keys-enrollment.v1") {return ky_efail(KyCode.version);}}
    else if f==1 {if !ky_requires_empty(j[..],t) {return ky_efail(KyCode.version);}}
    else if f==2 {if t!=JSON_OBJECT || !json_skip(j[..]) {return ky_efail(KyCode.field);}}
    else if f==3 {if t!=JSON_STRING || s!=signer || !ky_hex64(s) {return ky_efail(KyCode.enrollment);}e.agent=s;}
    else if f==4 {if t!=JSON_STRING || !ky_hex64(s) {return ky_efail(KyCode.wallet);}e.wallet=s;}
    else if f==5 {
      if t!=JSON_STRING {return ky_efail(KyCode.xpub);}
      e.key=ky_origin(s);if !ky_ext_key(e.key).ok {return ky_efail(KyCode.xpub);}e.xpub=s;
    }
    else if f==6 {if t!=JSON_STRING || s.count==0 {return ky_efail(KyCode.field);}}   // BIP-322: read, not verified
    else if f==7 {
      if t!=JSON_STRING || !(json_is(s,"software") || json_is(s,"hardware") || json_is(s,"attested") || json_is(s,"institutional")) {return ky_efail(KyCode.field);}
      cls=s;
    }
    else if f==8 {
      if t==JSON_OBJECT {if ky_ref(j[..]).count==0 {return ky_efail(KyCode.attestation);}att=true;}
      else if t!=JSON_NULL {return ky_efail(KyCode.attestation);}
    }
    else if f==9 {if t!=JSON_OBJECT || ky_ref(j[..]).count==0 {return ky_efail(KyCode.field);}}
    else if f==10 {if t!=JSON_OBJECT {return ky_efail(KyCode.field);}e.independence=ky_ref(j[..]);if e.independence.count==0 {return ky_efail(KyCode.field);}}
    else {e.expires_at=ky_uint(j[..],t);if e.expires_at<0 {return ky_efail(KyCode.times);}}
  }
  if json_next(j[..])!=JSON_END {return ky_efail(KyCode.json);}
  if (seen|4)!=4095 {return ky_efail(KyCode.field);}
  e.attested=json_is(cls,"attested");
  if e.attested!=att {return ky_efail(KyCode.attestation);}
  return e;
}
// book:end enrollment
KY_IND_FIELDS :: [10] string.["v","requires","meta","agent","operator","jurisdiction","custody","affiliations","insurance","observed_at"];
ky_independence_read :: (signer:string,content:string)->KyIndependence {
  r:KyIndependence;names:=KY_IND_FIELDS;
  if !ky_sha(content,r.digest[..]) {return ky_ifail(KyCode.json);}
  j:[1]Json;json_start(j[..],content);if json_next(j[..])!=JSON_OBJECT {return ky_ifail(KyCode.json);}
  seen:=0;
  while true {
    t:=json_next(j[..]);if t==JSON_OBJECT_END {break;}if t!=JSON_STRING {return ky_ifail(KyCode.json);}
    f:=ky_field(json_text(j[..]),names[..]);t=json_next(j[..]);
    if f<0 || (seen&(1<<f))!=0 {return ky_ifail(KyCode.field);}seen|=1<<f;
    s:=json_text(j[..]);
    if f==0 {if t!=JSON_STRING || !json_is(s,"openagents.keys-independence.v1") {return ky_ifail(KyCode.version);}}
    else if f==1 {if !ky_requires_empty(j[..],t) {return ky_ifail(KyCode.version);}}
    else if f==3 {if t!=JSON_STRING || s!=signer || !ky_hex64(s) {return ky_ifail(KyCode.enrollment);}r.agent=s;}
    else if f==4 {if t!=JSON_STRING || s.count==0 {return ky_ifail(KyCode.operator);}r.op=s;}
    else if f==5 || f==7 {if t!=JSON_ARRAY || !json_skip(j[..]) {return ky_ifail(KyCode.field);}}
    else if f==8 {if t!=JSON_NULL && t!=JSON_STRING {return ky_ifail(KyCode.field);}}
    else if f==9 {if ky_uint(j[..],t)<0 {return ky_ifail(KyCode.times);}}
    else {if t!=JSON_OBJECT || !json_skip(j[..]) {return ky_ifail(KyCode.field);}}
  }
  if json_next(j[..])!=JSON_END {return ky_ifail(KyCode.json);}
  if (seen|4)!=1023 {return ky_ifail(KyCode.field);}
  return r;
}

// ---- admission
// The enrollment index a path key names, or -1.
ky_find :: (w:KyWallet,ref:[32]u8)->int {for i:0..<w.nenroll {if ky_eq32(w.enrollments[i],ref) {return i;}}return -1;}
// The keys of a path in enrollment order, each with "/<0;1>/*", after
// prefix; the new length, or -1 when out is full.
ky_put :: (out:[]u8,at:int,s:string)->int {
  if at<0 || at+s.count>out.count {return -1;}
  for k:0..<s.count {out[at+k]=s[k];}
  return at+s.count;
}
ky_put_int :: (out:[]u8,at:int,v:int)->int {
  d:[20]u8;n:=0;x:=v;
  while true {d[n]=cast(u8)('0'+x%10);n+=1;x/=10;if x==0 {break;}}
  a:=at;for k:0..<n {a=ky_put(out,a,cast(string)d[n-1-k..<n-k]);}
  return a;
}
ky_multi :: (out:[]u8,at:int,name:string,w:KyWallet,e:[]KyEnrollment,p:KyPath)->int {
  a:=ky_put(out,at,name);a=ky_put(out,a,"(");a=ky_put_int(out,a,p.threshold);
  for i:0..<w.nenroll {
    for k:0..<p.count {if ky_eq32(p.keys[k],w.enrollments[i]) {a=ky_put(out,a,",");a=ky_put(out,a,e[i].xpub);a=ky_put(out,a,"/<0;1>/*");}}
  }
  return ky_put(out,a,")");
}
// book:begin descriptor
// The descriptor the paths and enrollments describe, with its checksum,
// into out; its length, or -1. One path: wsh(sortedmulti(...)). A primary
// path and one timelocked path: wsh(or_d(multi(primary),
// and_v(v:older(n)|v:after(h),multi(recovery)))). Every enrollment is in
// exactly one path, and every primary key precedes every recovery key.
ky_descriptor :: (w:KyWallet,e:[]KyEnrollment,out:[]u8)->int {
  if w.npaths>2 {return -1;}
  p:=ky_primary(w);a:int;
  if w.npaths==1 {
    a=ky_put(out,0,"wsh(");a=ky_multi(out,a,"sortedmulti",w,e,w.paths[0]);a=ky_put(out,a,")");
  } else {
    r:=w.paths[1-p];
    a=ky_put(out,0,"wsh(or_d(");a=ky_multi(out,a,"multi",w,e,w.paths[p]);
    a=ky_put(out,a,ifx r.older>0 then ",and_v(v:older(" else ",and_v(v:after(");
    a=ky_put_int(out,a,r.older+r.after);a=ky_put(out,a,"),");
    a=ky_multi(out,a,"multi",w,e,r);a=ky_put(out,a,")))");
  }
  if a==-1 || a+9>out.count {return -1;}
  if !ky_checksum(cast(string)out[0..<a],out[a+1..<a+9]) {return -1;}
  out[a]='#';return a+9;
}
// book:end descriptor
// Every enrollment in exactly one path's keys, each path key an enrollment,
// and (two paths) primary keys first.
ky_layout :: (w:KyWallet)->KyCode {
  owner:[KY_KEYS]int;for i:0..<w.nenroll {owner[i]=-1;}
  for p:0..<w.npaths {
    for k:0..<w.paths[p].count {
      i:=ky_find(w,w.paths[p].keys[k]);
      if i<0 || owner[i]>=0 {return KyCode.enrollment;}
      owner[i]=p;
    }
  }
  for i:0..<w.nenroll {if owner[i]<0 {return KyCode.enrollment;}}
  p:=ky_primary(w);
  for i:1..<w.nenroll {if owner[i]==p && owner[i-1]!=p {return KyCode.key_order;}}
  return KyCode.ok;
}
// Composition rules 1 to 3 over every path. The holder's keys are one
// operator: they take the operator of the holder's first enrollment.
// book:begin compose
ky_operator :: (w:KyWallet,e:[]KyEnrollment,ind:[]KyIndependence,i:int)->string {
  if e[i].agent!=w.holder {return ind[i].op;}
  for k:0..<w.nenroll {if e[k].agent==w.holder {return ind[k].op;}}
  return "";
}
ky_compose :: (w:KyWallet,e:[]KyEnrollment,ind:[]KyIndependence,sov:bool,min_lock:int,height:int)->KyCode {
  pi:=ky_primary(w);
  for p:0..<w.npaths {
    path:=w.paths[p];plain:=0;
    for a:0..<path.count {
      ia:=ky_find(w,path.keys[a]);same:=0;
      for b:0..<path.count {if ky_operator(w,e,ind,ky_find(w,path.keys[b]))==ky_operator(w,e,ind,ia) {same+=1;}}
      if same>=path.threshold {               // rule 1, and rule 2 when it is the holder's group
        h:=ky_holder(w,e);held:=h>=0 && ky_operator(w,e,ind,ia)==ky_operator(w,e,ind,h);
        return ifx sov && p==pi && held then KyCode.sovereign else KyCode.operator;
      }
      if !e[ia].attested {plain+=1;}
    }
    if p!=pi {                                // rule 3
      if path.older>0 && path.older<min_lock {return KyCode.recovery;}
      if path.after>0 && path.after<height+min_lock {return KyCode.recovery;}
      if plain<path.threshold {return KyCode.attested_only;}
    }
  }
  return KyCode.ok;
}
// book:end compose
ky_holder :: (w:KyWallet,e:[]KyEnrollment)->int {for k:0..<w.nenroll {if e[k].agent==w.holder {return k;}}return -1;}
ky_recipient :: (w:KyWallet,key:string)->bool {b:=ky_bytes(key);for i:0..<w.nrecip {if ky_eq32(w.recipients[i],b) {return true;}}return false;}
// book:begin admit
// Admission of one wallet revision at now (unix seconds) and height (the
// chain tip). e and ind are the enrollments in the wallet's order and each
// one's independence declaration. sov: the holder is a NIP-SOV agent.
// min_lock: the holder policy's shortest recovery timelock (KY_MIN_LOCK
// unless the policy says otherwise). proven stays false: possession proofs
// (BIP-322) are read and not verified in this build.
ky_admit :: (w:KyWallet,e:[]KyEnrollment,ind:[]KyIndependence,sov:bool,min_lock:int,now:int,height:int)->KyAdmit {
  r:KyAdmit;r.code=w.code;
  if w.code!=KyCode.ok {return r;}
  r.code=KyCode.enrollment;
  if e.count!=w.nenroll || ind.count!=w.nenroll {return r;}
  version:=ifx json_is(w.network,"mainnet") then KY_XPUB else KY_TPUB;
  for i:0..<w.nenroll {
    r.code=e[i].code;if r.code!=KyCode.ok {return r;}
    r.code=ind[i].code;if r.code!=KyCode.ok {return r;}
    r.code=KyCode.enrollment;
    if !ky_eq32(w.enrollments[i],e[i].digest) || e[i].wallet!=w.wallet {return r;}
    if !ky_digest_is(e[i].independence,ind[i].digest) || ind[i].agent!=e[i].agent {return r;}
    for k:0..<i {if e[k].agent==e[i].agent && e[k].agent!=w.holder {return r;}}
    r.code=KyCode.times;if now>e[i].expires_at {return r;}
    r.code=KyCode.recipient;if !ky_recipient(w,e[i].agent) {return r;}
    r.code=KyCode.network;if ky_ext_key(e[i].key).version!=version {return r;}
  }
  r.code=ky_layout(w);if r.code!=KyCode.ok {return r;}
  r.code=KyCode.family;
  if w.descriptor.count<4 || (w.descriptor[0..<4]!="wsh(") {
    if w.descriptor.count>3 && w.descriptor[0..<3]=="tr(" {r.code=KyCode.not_built;}
    return r;
  }
  if w.npaths>2 {r.code=KyCode.not_built;return r;}
  d:[4096]u8;n:=ky_descriptor(w,e,d[..]);
  r.code=KyCode.descriptor;if n==-1 || cast(string)d[0..<n]!=w.descriptor {return r;}
  r.code=ky_compose(w,e,ind,sov,min_lock,height);
  return r;
}
// book:end admit

// Composition rule 4: does next weaken prev? A lower threshold or shorter
// timelock on a path of the same name, a removed path, or a removed key
// agent.
ky_weakens :: (prev:KyWallet,pe:[]KyEnrollment,next:KyWallet,ne:[]KyEnrollment)->bool {
  for p:0..<prev.npaths {
    a:=prev.paths[p];found:=false;
    for q:0..<next.npaths {
      b:=next.paths[q];
      if b.name==a.name {
        found=true;
        if b.threshold<a.threshold || b.older<a.older || b.after<a.after {return true;}
        if (b.older==0 && b.after==0)!=(a.older==0 && a.after==0) {return true;}
      }
    }
    if !found {return true;}
  }
  for i:0..<prev.nenroll {
    kept:=false;for k:0..<next.nenroll {if ne[k].agent==pe[i].agent {kept=true;}}
    if !kept {return true;}
  }
  return false;
}
// A successor: revision + 1, previous = prev's digest, the same wallet
// lineage, and, when it weakens prev, POL approvals of its exact bytes from
// a primary quorum of prev. approved: the agents whose approvals the caller
// verified.
ky_successor :: (prev:KyWallet,prev_digest:[32]u8,pe:[]KyEnrollment,next:KyWallet,ne:[]KyEnrollment,approved:[]string)->KyCode {
  if next.wallet!=prev.wallet || next.revision!=prev.revision+1 || !next.has_previous || !ky_eq32(next.previous,prev_digest) {return KyCode.revision;}
  if !ky_weakens(prev,pe,next,ne) {return KyCode.ok;}
  p:=prev.paths[ky_primary(prev)];yes:=0;
  for k:0..<p.count {
    agent:=pe[ky_find(prev,p.keys[k])].agent;
    for a:approved {if a==agent {yes+=1;break;}}
  }
  return ifx yes>=p.threshold then KyCode.ok else KyCode.approval;
}

// ---- the sign request
KY_REQ_FIELDS :: [13] string.["v","requires","meta","wallet","requester","psbt","outputs","fee_sat","purpose","action","treasury","nonce","deadline"];
KY_OUT_FIELDS :: [3] string.["address","amount_sat","change"];
ky_stated :: (j:[]Json,s:[]KyStated)->bool {
  seen:=0;names:=KY_OUT_FIELDS;
  t:=json_next(j);
  while t==JSON_STRING {
    f:=ky_field(json_text(j),names[..]);t=json_next(j);
    if f<0 || (seen&(1<<f))!=0 {return false;}seen|=1<<f;
    if f==0 {if t!=JSON_STRING {return false;}s[0].address=json_text(j);}
    else if f==1 {s[0].amount=ky_uint(j,t);if s[0].amount<1 || s[0].amount>KY_MAX_SAT {return false;}}
    else {if t!=JSON_TRUE && t!=JSON_FALSE {return false;}s[0].change=t==JSON_TRUE;}
    t=json_next(j);
  }
  return t==JSON_OBJECT_END && seen==7;
}
// book:begin request
ky_request_read :: (content:string)->KyRequest {
  r:=[1]KyRequest.[KyRequest.{}];names:=KY_REQ_FIELDS;
  if !ky_sha(content,r[0].digest[..]) {return ky_rfail(KyCode.json);}
  j:[1]Json;json_start(j[..],content);if json_next(j[..])!=JSON_OBJECT {return ky_rfail(KyCode.json);}
  seen:=0;
  while true {
    t:=json_next(j[..]);if t==JSON_OBJECT_END {break;}if t!=JSON_STRING {return ky_rfail(KyCode.json);}
    f:=ky_field(json_text(j[..]),names[..]);t=json_next(j[..]);
    if f<0 || (seen&(1<<f))!=0 {return ky_rfail(KyCode.field);}seen|=1<<f;
    s:=json_text(j[..]);
    if f==0 {if t!=JSON_STRING || !json_is(s,"openagents.keys-sign-request.v1") {return ky_rfail(KyCode.version);}}
    else if f==1 {if !ky_requires_empty(j[..],t) {return ky_rfail(KyCode.version);}}
    else if f==3 {if t!=JSON_OBJECT {return ky_rfail(KyCode.wallet);}r[0].wallet=ky_ref(j[..]);if r[0].wallet.count==0 {return ky_rfail(KyCode.wallet);}}
    else if f==4 {if t!=JSON_STRING || !ky_hex64(s) {return ky_rfail(KyCode.field);}r[0].requester=s;}
    else if f==5 {if t!=JSON_OBJECT {return ky_rfail(KyCode.psbt);}r[0].psbt=ky_ref(j[..]);if r[0].psbt.count==0 {return ky_rfail(KyCode.psbt);}}
    else if f==6 {
      if t!=JSON_ARRAY {return ky_rfail(KyCode.outputs);}
      v:=json_next(j[..]);
      while v!=JSON_ARRAY_END {
        n:=r[0].nout;
        if n==KY_IO || !ky_stated(j[..],r[0].out[n..<n+1]) {return ky_rfail(KyCode.outputs);}   // a non-object never reads as one
        r[0].nout+=1;v=json_next(j[..]);
      }
    }
    else if f==7 {r[0].fee=ky_uint(j[..],t);if r[0].fee<0 || r[0].fee>KY_MAX_SAT {return ky_rfail(KyCode.fee);}}
    else if f==8 {if t!=JSON_STRING || !at_slug_ky(s) {return ky_rfail(KyCode.field);}}
    else if f==9 || f==10 || f==2 {if t!=JSON_NULL && (t!=JSON_OBJECT || !json_skip(j[..])) {return ky_rfail(KyCode.field);}}
    else if f==11 {if t!=JSON_STRING || !ky_hex64(s) {return ky_rfail(KyCode.nonce);}r[0].nonce=s;}
    else {r[0].deadline=ky_uint(j[..],t);if r[0].deadline<0 {return ky_rfail(KyCode.deadline);}}
  }
  if json_next(j[..])!=JSON_END {return ky_rfail(KyCode.json);}
  if (seen|4)!=8191 {return ky_rfail(KyCode.field);}
  if r[0].nout<1 {return ky_rfail(KyCode.outputs);}
  return r[0];
}
// book:end request
at_slug_ky :: (s:string)->bool {
  if s.count==0 || s.count>64 {return false;}
  for c:s {if !((c>='a' && c<='z') || (c>='0' && c<='9') || c=='-') {return false;}}
  return true;
}

// ---- PSBT v0
// A compact size at b[at]: its value and the next position (ok false, value
// 0, when malformed). Only the one- and three-byte forms; nothing this
// reader needs is larger.
KyVar :: struct {ok:bool;value:int;next:int;}
ky_var :: (b:[]u8,at:int)->KyVar {
  if at<0 || at>=b.count {return KyVar.{};}
  if b[at]<0xfd {return KyVar.{ok=true,value=cast(int)b[at],next=at+1};}
  if b[at]>0xfd || at+3>b.count {return KyVar.{};}
  v:=cast(int)b[at+1]|(cast(int)b[at+2]<<8);
  if v<0xfd {return KyVar.{};}
  return KyVar.{ok=true,value=v,next=at+3};
}
ky_le :: (b:[]u8,at:int,n:int)->int {v:=0;for k:0..<n {v|=cast(int)b[at+k]<<(8*k);}return v;}
// value (8 bytes little-endian) then a script; the next position, or -1.
ky_txout :: (b:[]u8,at:int,end:int,value:[]int,s:[]KyScript)->int {
  if at+9>end {return -1;}
  value[0]=ky_le(b,at,8);
  if value[0]<0 || value[0]>KY_MAX_SAT {return -1;}
  v:=ky_var(b,at+8);
  if !v.ok || v.value>KY_SCRIPT || v.next+v.value>end {return -1;}
  s[0].n=v.value;for k:0..<v.value {s[0].b[k]=b[v.next+k];}
  return v.next+v.value;
}
// One key-value map. The callback-free reader returns, for the one-byte
// keys of types 0 and 1 (the global map's unsigned transaction, an input's
// witness UTXO), whether each is there and where its value starts; whether
// either repeats; the version (key 0xfb); and the map's end (after 0x00)
// when it is well formed; all zero when it isn't.
KyMap :: struct {ok:bool;end:int;found:[2]bool;at:[2]int;n:[2]int;dup:bool;other:int;}
ky_map :: (b:[]u8,at:int)->KyMap {
  r:KyMap;i:=at;
  while true {
    k:=ky_var(b,i);if !k.ok {return KyMap.{};}
    if k.value==0 {r.ok=true;r.end=k.next;return r;}
    if k.next>=b.count {return KyMap.{};}     // the key's type byte, then ky_var bounds the rest
    kt:=b[k.next];
    v:=ky_var(b,k.next+k.value);if !v.ok {return KyMap.{};}    // a value past the end leaves no terminator
    if k.value==1 && kt<2 {x:=cast(int)kt;r.dup=r.dup || r.found[x];r.found[x]=true;r.at[x]=v.next;r.n[x]=v.value;}
    else if k.value==1 && kt==0xfb {r.other=ifx v.value==4 then ky_le(b,v.next,4) else -1;}
    i=v.next+v.value;
  }
  return r;
}
KY_MAGIC :: [5]u8.['p','s','b','t',0xff];
// b[i], or -1 past the end.
ky_at :: (b:[]u8,i:int)->int {return ifx i<b.count then cast(int)b[i] else -1;}
// book:begin psbt
ky_psbt_read :: (b:[]u8)->KyPsbt {
  r:=[1]KyPsbt.[KyPsbt.{}];bad:=KyPsbt.{code=KyCode.psbt};
  for k:0..<KY_MAGIC.count {if ky_at(b,k)!=cast(int)KY_MAGIC[k] {return bad;}}
  g:=ky_map(b,5);
  if !g.found[0] || g.dup {return bad;}
  if g.other!=0 {return KyPsbt.{code=KyCode.not_built};}       // PSBT v2 (BIP-370)
  // The unsigned transaction: version, inputs with empty scriptSigs, outputs, locktime.
  t:=g.at[0];end:=t+g.n[0];
  ni:=ky_var(b,t+4);
  if ni.value<1 || ni.value>KY_IO {return bad;}   // a malformed size reads as 0
  i:=ni.next;
  for k:0..<ni.value {
    if ky_at(b,i+36)!=0 {return bad;}                      // past the end, the outputs fail to read
    i+=41;
  }
  no:=ky_var(b,i);
  if no.value<1 || no.value>KY_IO {return bad;}
  i=no.next;
  for k:0..<no.value {i=ky_txout(b,i,end,r[0].out_value[k..<k+1],r[0].out_script[k..<k+1]);if i==-1 {return bad;}}
  if i+4!=end {return bad;}
  r[0].nin=ni.value;r[0].nout=no.value;
  // One map per input with its witness UTXO, then one per output.
  at:=g.end;
  for k:0..<r[0].nin {
    m:=ky_map(b,at);
    if !m.ok || m.dup {return bad;}
    if !m.found[1] {return KyPsbt.{code=KyCode.inputs};}
    u:=m.at[1];e:=u+m.n[1];if ky_txout(b,u,e,r[0].in_value[k..<k+1],r[0].in_script[k..<k+1])!=e {return bad;}
    at=m.end;
  }
  for k:0..<r[0].nout {m:=ky_map(b,at);if !m.ok {return bad;}at=m.end;}
  if at!=b.count {return bad;}
  return r[0];
}
// book:end psbt

// ---- the wallet's scripts
// book:begin scripts
// The P2WSH scriptPubKey of a one-path wallet at one index, from each
// key's branch key (account/0 for receive, account/1 for change):
// 0x00 0x20 SHA-256(k <sorted child keys> n CHECKMULTISIG).
ky_script :: (w:KyWallet,branch:[]KyExtKey,index:int)->KyScript {
  r:KyScript;p:=w.paths[0];keys:[KY_KEYS][33]u8;
  for i:0..<w.nenroll {
    c:=ky_child(branch[i],index);
    if !c.ok {return r;}
    // insertion sort, lexicographic on the 33 bytes
    at:=i;
    while at>0 && ky_less(c.key,keys[at-1]) {keys[at]=keys[at-1];at-=1;}
    keys[at]=c.key;
  }
  ws:[3+34*KY_KEYS]u8;
  ws[0]=cast(u8)(0x50+p.threshold);n:=1;
  for i:0..<w.nenroll {ws[n]=0x21;for k:0..<33 {ws[n+1+k]=keys[i][k];}n+=34;}
  ws[n]=cast(u8)(0x50+w.nenroll);ws[n+1]=0xae;n+=2;
  r.b[1]=0x20;                                            // r.b[0] is OP_0
  h:[32]u8;#assert sha256_hash_checked(ws[0..<n],h[..],false)==SHA_OK;
  for k:0..<32 {r.b[2+k]=h[k];}
  r.n=34;return r;
}
// book:end scripts
ky_less :: (a:[33]u8,b:[33]u8)->bool {for k:0..<33 {if a[k]<b[k] {return true;}if a[k]>b[k] {return false;}}return false;}
ky_same :: (a:KyScript,b:KyScript)->bool {
  if a.n!=b.n {return false;}
  for k:0..<a.n {if a.b[k]!=b.b[k] {return false;}}
  return true;
}
KyScripts :: struct {s:[2*KY_GAP]KyScript;}
// Every receive and change script below KY_GAP, deriving each branch key once.
ky_scripts :: (w:KyWallet,e:[]KyEnrollment)->KyScripts {
  r:KyScripts;b:[KY_KEYS]KyExtKey;
  for br:0..<2 {
    for i:0..<w.nenroll {b[i]=ky_child(ky_ext_key(e[i].key),br);}
    for i:0..<KY_GAP {r.s[br*KY_GAP+i]=ky_script(w,b[0..<w.nenroll],i);}
  }
  return r;
}
// Is s a wallet script on branch br (or either, br = -1)?
ky_is_ours :: (all:KyScripts,s:KyScript,br:int)->bool {
  for k:0..<2*KY_GAP {if (br<0 || k/KY_GAP==br) && all.s[k].n>0 && ky_same(all.s[k],s) {return true;}}
  return false;
}
// The scriptPubKey a stated address pays: a segwit address on the wallet's
// network (bc for mainnet, tb otherwise), version byte then the program.
ky_address :: (w:KyWallet,address:string)->KyScript {
  r:KyScript;t:=a3_segwit(address);
  mainnet:=json_is(w.network,"mainnet");
  if !a3_starts_ci(address,ifx mainnet then "bc1" else "tb1") {return r;}
  if t.status!=(ifx mainnet then A3_OK else A3_NETWORK) {return r;}
  r.b[0]=cast(u8)(ifx t.version==0 then 0 else 0x50+t.version);r.b[1]=cast(u8)t.n;
  for k:0..<t.n {r.b[2+k]=t.program[k];}
  r.n=t.n+2;return r;
}

// book:begin sign
// The signer's checks before it signs one request. wallet_digest is the
// admitted wallet revision's digest, all its scripts (ky_scripts, derived
// once at admission), psbt the bytes the request names, ceiling the
// signing policy's fee ceiling in satoshis.
ky_sign_check :: (w:KyWallet,wallet_digest:[32]u8,all:KyScripts,r:KyRequest,psbt:[]u8,ceiling:int,now:int)->KyCode {
  if r.code!=KyCode.ok {return r.code;}
  if !ky_digest_is(r.wallet,wallet_digest) {return KyCode.wallet;}
  if now>=r.deadline {return KyCode.deadline;}
  if now>=w.expires_at {return KyCode.times;}
  d:[32]u8;
  #assert sha256_hash_checked(psbt,d[..],false)==SHA_OK;
  if !ky_digest_is(r.psbt,d) {return KyCode.psbt;}
  t:=ky_psbt_read(psbt);
  if t.code!=KyCode.ok {return t.code;}
  if w.npaths!=1 {return KyCode.not_built;}               // miniscript spends
  sum_in:=0;
  for k:0..<t.nin {
    if !ky_is_ours(all,t.in_script[k],-1) {return KyCode.inputs;}
    sum_in+=t.in_value[k];
  }
  if r.nout!=t.nout {return KyCode.outputs;}
  sum_out:=0;
  for k:0..<t.nout {
    s:=ky_address(w,r.out[k].address);
    if s.n==0 {return KyCode.address;}
    if !ky_same(s,t.out_script[k]) {return KyCode.outputs;}
    if r.out[k].amount!=t.out_value[k] {return KyCode.amount;}
    if r.out[k].change && !ky_is_ours(all,s,1) {return KyCode.change;}
    sum_out+=t.out_value[k];
  }
  if sum_in-sum_out!=r.fee {return KyCode.fee;}             // the request's fee is never negative
  if r.fee>ceiling {return KyCode.ceiling;}
  return KyCode.ok;
}
// book:end sign

ky_wfail :: (c:KyCode)->KyWallet {r:KyWallet;r.code=c;return r;}
ky_efail :: (c:KyCode)->KyEnrollment {r:KyEnrollment;r.code=c;return r;}
ky_ifail :: (c:KyCode)->KyIndependence {r:KyIndependence;r.code=c;return r;}
ky_rfail :: (c:KyCode)->KyRequest {r:KyRequest;r.code=c;return r;}
// ---- idempotency, timelocks, rotation, the co-signer's delay, the hot ceiling
// book:begin ledger
// (agent, requester, nonce) with the request digest. A new triple is
// recorded with its outcome before any partial signature leaves; an exact
// retry returns the retained outcome; a changed request with a used nonce
// refuses. A full ledger refuses new requests.
ky_consume :: (l:[]KyLedger,agent:string,r:KyRequest,code:KyCode)->KyRetry {
  for i:0..<l[0].count {
    x:=l[0].e[i];
    if x.agent==agent && x.requester==r.requester && x.nonce==r.nonce {
      for k:0..<32 {if x.digest[k]!=r.digest[k] {return KyRetry.{code=KyCode.nonce};}}
      return KyRetry.{code=x.code,retry=true};
    }
  }
  if l[0].count==KY_LEDGER {return KyRetry.{code=KyCode.nonce};}
  l[0].e[l[0].count]=KyEntry.{agent=agent,requester=r.requester,nonce=r.nonce,digest=r.digest,code=code};
  l[0].count+=1;
  return KyRetry.{code=code};
}
// book:end ledger
// A timelocked path is spendable for a coin confirmed at conf_height when
// the tip is height: older(n) needs n confirmations, after(h) needs h.
ky_path_open :: (p:KyPath,conf_height:int,height:int)->KyCode {
  if p.older>0 && height-conf_height+1<p.older {return KyCode.locked;}
  if height<p.after {return KyCode.locked;}                 // after 0: every tip is past it
  return KyCode.ok;
}
// A retired wallet's signers sign only its rotation's sweeps.
ky_retired :: (retired:bool,request_digest:[32]u8,sweeps:[]string)->KyCode {
  if !retired {return KyCode.ok;}
  for s:sweeps {if ky_digest_is(s,request_digest) {return KyCode.ok;}}
  return KyCode.retired;
}
// A compromised signer is left out of a sweep when the others can meet the
// threshold without the compromised keys.
ky_sweep_signer :: (p:KyPath,compromised:int,signer_compromised:bool)->KyCode {
  if signer_compromised && p.count-compromised>=p.threshold {return KyCode.compromised;}
  return KyCode.ok;
}
// The attested co-signer: a spend above delay_above signs no earlier than
// delay seconds after receipt, and any primary refusal meanwhile cancels it.
ky_delay :: (amount:int,delay_above:int,delay:int,received_at:int,now:int,refused:bool)->KyCode {
  if amount<=delay_above {return KyCode.ok;}
  if refused || now<received_at+delay {return KyCode.delay;}
  return KyCode.ok;
}
// A hot-topup may not raise the hot Lightning balance above its ceiling.
ky_topup :: (hot_msat:int,amount_sat:int,ceiling_msat:int)->KyCode {
  if amount_sat<0 || amount_sat>KY_MAX_SAT || hot_msat<0 || hot_msat+amount_sat*1000>ceiling_msat {return KyCode.hot;}
  return KyCode.ok;
}

// ---- checks
#test "small readers: hex, digests, SHA-256 in 64-byte chunks" {
  c:[256]u8;
  #assert ky_hex64(KY_HOLDER) && !ky_hex64(KY_HOLDER[0..<63]) && !ky_hex64("");
  #assert !ky_hex64(ky_case(c[..],KY_HOLDER,"79be","79Be"));
  #assert !ky_hex64(ky_case(c[..],KY_HOLDER,"79be","79bg"));
  #assert !ky_hex64(ky_case(c[..],KY_HOLDER,"79be","79b/"));
  #assert !ky_hex64(ky_case(c[..],KY_HOLDER,"79be","79b:"));
  #assert !ky_hex64(ky_case(c[..],KY_HOLDER,"79be","79b`"));
  #assert ky_hex64(ky_case(c[..],KY_HOLDER,"79be","09af"));
  b:=ky_bytes(KY_HOLDER);
  #assert b[0]==0x79 && b[1]==0xbe && b[31]==0x98 && b[30]==0x17;
  d:[32]u8;
  #assert ky_sha("abc",d[..]) && a3_hex_is(d[..],"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
  #assert ky_sha(KY_WALLET,d[..]) && a3_hex_is(d[..],KY_WALLET_DIGEST);
  #assert ky_sha("",d[..]) && a3_hex_is(d[..],"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
  #assert ky_sha("0123456789012345678901234567890123456789012345678901234567890123",d[..]);
  #assert a3_hex_is(d[..],"9674d9e078535b7cec43284387a6ee39956188e735a85452b0050b55341cda56");
  #assert ky_sha("0123456789012345678901234567890123456789012345678901234567890123x",d[..]);
  #assert a3_hex_is(d[..],"23975c6df71a336f019e2a2b8b55f6046e62ab77c6aa9ace2bad65b94d54e44a");
  short:[31]u8;#assert !ky_sha("abc",short[..]);
  w:=ky_bytes(KY_WALLET_DIGEST);
  ref:="sha256:2bebe1f646fa7a160964bdb94cb7832807bfebc457c8ace2de61947587186323";
  #assert ky_digest_is(ref,w) && !ky_digest_is(ref[0..<70],w);
  #assert !ky_digest_is(ky_case(c[..],ref,"2beb","3beb"),w);
  #assert !ky_digest_is(ky_case(c[..],ref,"2beb","2ceb"),w);
  #assert !ky_digest_is(ky_case(c[..],ref,"6323","6322"),w);
  #assert !ky_digest_is(ky_case(c[..],ref,"6323","6333"),w);
  #assert ky_eq32(w,w) && !ky_eq32(w,b);
  v:=w;v[31]^=1;#assert !ky_eq32(w,v);
  #assert ky_nibble('0')==0 && ky_nibble('9')==9 && ky_nibble('a')==10 && ky_nibble('f')==15;
  // key order: the first differing byte decides, from byte 0; equal keys are not less
  ka:[33]u8;kb:[33]u8;ka[0]=2;kb[0]=3;ka[1]=0xff;
  #assert ky_less(ka,kb) && !ky_less(kb,ka) && !ky_less(ka,ka);
  kb[0]=2;#assert !ky_less(ka,kb) && ky_less(kb,ka);
  ka[1]=0;ka[32]=1;#assert !ky_less(ka,kb) && ky_less(kb,ka);
}

#test "ArtifactRefs and key lists" {
  c:[512]u8;
  R:="[{\"digest\":\"sha256:abababababababababababababababababababababababababababababababab\",\"media_type\":\"a\",\"size\":1}]";
  out:[2][32]u8;j:[1]Json;
  json_start(j[..],R);#assert ky_refs(j[..],json_next(j[..]),out[..])==1 && out[0][0]==0xab;
  json_start(j[..],"[]");#assert ky_refs(j[..],json_next(j[..]),out[..])==0;
  json_start(j[..],"{}");#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],"[1]");#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  one:[1][32]u8;
  json_start(j[..],ky_case(c[..],R,"}]","},{\"digest\":\"sha256:abababababababababababababababababababababababababababababababab\",\"media_type\":\"a\",\"size\":1}]"));
  #assert ky_refs(j[..],json_next(j[..]),one[..])==-1;
  json_start(j[..],ky_case(c[..],R,"}]","},{\"digest\":\"sha256:abababababababababababababababababababababababababababababababab\",\"media_type\":\"a\",\"size\":1}]"));
  #assert ky_refs(j[..],json_next(j[..]),out[..])==2;
  json_start(j[..],ky_case(c[..],R,",\"size\":1",""));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"\"media_type\":\"a\",",""));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"\"digest\":\"sha256:abababababababababababababababababababababababababababababababab\",",""));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"\"size\":1","\"size\":-1"));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"\"size\":1","\"size\":0"));#assert ky_refs(j[..],json_next(j[..]),out[..])==1;
  json_start(j[..],ky_case(c[..],R,"\"media_type\":\"a\"","\"media_type\":1"));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"\"size\":1","\"size\":1,\"schema\":\"s\""));#assert ky_refs(j[..],json_next(j[..]),out[..])==1;
  json_start(j[..],ky_case(c[..],R,"\"size\":1","\"size\":1,\"schema\":2"));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"\"size\":1","\"size\":1,\"event\":{\"id\":1}"));#assert ky_refs(j[..],json_next(j[..]),out[..])==1;
  json_start(j[..],ky_case(c[..],R,"\"size\":1","\"size\":1,\"event\":[]"));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"\"size\":1","\"size\":1,\"sources\":[{\"url\":\"u\"}]"));#assert ky_refs(j[..],json_next(j[..]),out[..])==1;
  json_start(j[..],ky_case(c[..],R,"\"size\":1","\"size\":1,\"sources\":{}"));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"\"size\":1","\"size\":1,\"size\":1"));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"\"size\":1","\"size\":1,\"other\":1"));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"sha256:abab","sha257:abab"));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"sha256:abab","sha256:Abab"));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"sha256:abab","sha256:aba"));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],ky_case(c[..],R,"\"digest\":\"sha256:abababababababababababababababababababababababababababababababab\"","\"digest\":7"));#assert ky_refs(j[..],json_next(j[..]),out[..])==-1;
  K:="[\"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798\",\"c6047f9441ed7d6d3045406e95c07cd85c778e4b8cef3ca7abac09b95c709ee5\"]";
  json_start(j[..],K);#assert ky_keys(j[..],json_next(j[..]),out[..])==2 && out[1][0]==0xc6;
  json_start(j[..],K);#assert ky_keys(j[..],json_next(j[..]),one[..])==-1;
  json_start(j[..],"{}");#assert ky_keys(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],"[1]");#assert ky_keys(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],"[\"79\"]");#assert ky_keys(j[..],json_next(j[..]),out[..])==-1;
  json_start(j[..],"[]");#assert ky_keys(j[..],json_next(j[..]),out[..])==0;
  json_start(j[..],"[]");#assert ky_requires_empty(j[..],json_next(j[..]));
  json_start(j[..],"[1]");#assert !ky_requires_empty(j[..],json_next(j[..]));
  json_start(j[..],"{}");#assert !ky_requires_empty(j[..],json_next(j[..]));
  json_start(j[..],"5");#assert ky_uint(j[..],json_next(j[..]))==5;
  json_start(j[..],"0");#assert ky_uint(j[..],json_next(j[..]))==0;
  json_start(j[..],"-1");#assert ky_uint(j[..],json_next(j[..]))==-1;
  json_start(j[..],"1.5");#assert ky_uint(j[..],json_next(j[..]))==-1;
  json_start(j[..],"\"5\"");#assert ky_uint(j[..],json_next(j[..]))==-1;
  names:=[2]string.["a","b"];
  #assert ky_field("a",names[..])==0 && ky_field("b",names[..])==1 && ky_field("c",names[..])==-1;
}

#test "the wallet reads: lineage, network, descriptor, one primary path, times" #steps 600000000 {
  w:=ky_wallet_read(KY_WALLET);
  #assert w.code==KyCode.ok && w.wallet==KY_WALLET_ID && w.holder==KY_HOLDER && w.revision==0 && !w.has_previous;
  #assert w.network=="signet" && w.npaths==1 && w.nenroll==3 && w.nrecip==3 && w.starts_at==1793100000 && w.expires_at==1824636000;
  #assert w.paths[0].name=="primary" && w.paths[0].threshold==2 && w.paths[0].count==3 && w.paths[0].older==0 && w.paths[0].after==0;
  #assert ky_eq32(w.paths[0].keys[2],w.enrollments[2]) && w.recipients[1][0]==0xc6;
  c:[4096]u8;
  #assert ky_wallet_read("[]").code==KyCode.json;
  #assert ky_wallet_read("{\"v\":\"openagents.keys-wallet.v1\"").code==KyCode.json;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"}","} ")).code==KyCode.ok;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"wallet\":\"7777777777777777777777777777777777777777777777777777777777777777\"}","\"wallet\":\"7777777777777777777777777777777777777777777777777777777777777777\"}1")).code==KyCode.json;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"keys-wallet.v1","keys-wallet.v2")).code==KyCode.version;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"v\":\"openagents.keys-wallet.v1\",","")).code==KyCode.field;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"v\":\"openagents.keys-wallet.v1\"","\"v\":1")).code==KyCode.version;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"requires\":[]","\"requires\":[\"x\"]")).code==KyCode.version;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"requires\":[]","\"requires\":[],\"meta\":{\"a\":1}")).code==KyCode.ok;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"requires\":[]","\"requires\":[],\"meta\":[]")).code==KyCode.field;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"requires\":[]","\"requires\":[],\"other\":1")).code==KyCode.field;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"requires\":[]","\"requires\":[],\"requires\":[]")).code==KyCode.field;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"requires\":[],","")).code==KyCode.field;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,",\"wallet\":\"7777777777777777777777777777777777777777777777777777777777777777\"","")).code==KyCode.field;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"wallet\":\"7777777777777777777777777777777777777777777777777777777777777777\"","\"wallet\":\"77\"")).code==KyCode.wallet;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"wallet\":\"7777777777777777777777777777777777777777777777777777777777777777\"","\"wallet\":7")).code==KyCode.wallet;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"holder\":\"79be","\"holder\":\"79bx")).code==KyCode.holder;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"holder\":\"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798\"","\"holder\":1")).code==KyCode.holder;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"revision\":0","\"revision\":-1")).code==KyCode.revision;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"revision\":0","\"revision\":1")).code==KyCode.revision;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"previous\":null","\"previous\":7")).code==KyCode.revision;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"previous\":null","\"previous\":{}")).code==KyCode.revision;
  P:="\"previous\":{\"digest\":\"sha256:abababababababababababababababababababababababababababababababab\",\"media_type\":\"a\",\"size\":1}";
