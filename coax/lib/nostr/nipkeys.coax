  #assert ky_enrollment_read(KY_AGENT2,ky_case(c[..],KY_ENR2,"\"signing_policy\":{\"digest\":\"sha256:cd","\"signing_policy\":{\"digest\":\"sha256:c")).code==KyCode.field;
  #assert ky_enrollment_read(KY_AGENT2,ky_case(c[..],KY_ENR2,"\"signing_policy\":{","\"signing_policy\":7,\"q\":{")).code==KyCode.field;
  #assert ky_enrollment_read(KY_AGENT2,ky_case(c[..],KY_ENR2,"\"independence\":{\"digest\":\"sha256:33","\"independence\":{\"digest\":\"sha256:3")).code==KyCode.field;
  #assert ky_enrollment_read(KY_AGENT2,ky_case(c[..],KY_ENR2,"\"independence\":{","\"independence\":7,\"q\":{")).code==KyCode.field;
