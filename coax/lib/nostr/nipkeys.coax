  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"paths\":[{","\"paths\":[{\"keys\":[{\"digest\":\"sha256:e3eec4f661f9d78168e754fde3953f71edc101ee4133224a0640e76a67c34856\",\"media_type\":\"a\",\"size\":1}],\"name\":\"r\",\"threshold\":1,\"timelock\":{\"older\":9}},{")).paths[0].older==9;
  #assert ky_wallet_read(ky_case(c[..],KY_WALLET,"\"timelock\":null","\"timelock\":{\"older\":0}")).code==KyCode.timelock;
