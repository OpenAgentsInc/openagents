// Chapter 104: NIP-KEYS signatures. A key agent that accepted a signing
// request (nipkeys.coax's ky_sign_check) records the outcome in its ledger,
// then signs every input of the PSBT: it finds the input's script among
// the wallet's, takes its witness script (derived from the enrollments'
// xpubs once, at admission: ky_witnesses), derives its child private key
// from its account key, computes the BIP-143 SIGHASH_ALL digest and signs
// it with RFC 6979 ECDSA, low-S. It returns the partial signatures and the
// PSBT with them (BIP-174 PSBT_IN_PARTIAL_SIG), for its receipt. The
// coordinator combines a threshold of partial signatures into the final
// transaction.
//
// The account key and every child key are secrets: they live in the
// caller's workspace, which is cleared on every return, and decide no
// branch or index. Their public points come from the fixed-base comb k*G
// (chapter 10).
#load "nipkeys.coax";
#load "../bitcoin/sighash.coax";
#load "../../tests/nostr/keys_sign_fixtures.coax";
#load "../../tests/nostr/keys_sign_support.coax";
#authority;

KY_WS :: 3+34*KY_KEYS;
KyPartial :: struct {pub:[33]u8;n:int;sig:[73]u8;}            // DER, then the hash type byte
KySigned :: struct {code:KyCode;retry:bool;nin:int;psbt:[32]u8;p:[KY_IO]KyPartial;}   // psbt: the signed PSBT's digest
// The witness script at each of ky_scripts' slots (branch*KY_GAP + index).
KyWitnesses :: struct {n:[2*KY_GAP]int;ws:[2*KY_GAP][KY_WS]u8;}
KySignWork :: struct {k1:[32]u8;c1:[32]u8;k2:[32]u8;c2:[32]u8;data:[37]u8;i:[64]u8;key:[1]SignScalar;point:[1]SignPoint;pub:[33]u8;sig:[64]u8;ec:[1]EcdsaWork;}

// ---- checks
// Cheapest first: the checks run in this order for every mutant until one
// fails, and the xpub derivation is the slowest, so it comes last.
#test "the sighashes are Python's, and slots are found" {
  b:[512]u8;ps:=ky_unhex(KY_PSBT,b[..]);t:=ky_psbt_read(ps);u:=ky_unsigned(ps);tx:=bt_tx_read(u);x:=ks_witnesses();
  for k:0..<2 {
    #assert ky_slot(ky_fixture_scripts(),t.in_script[k])==k;
    h:[32]u8;#assert bt_sighash_v0(u,tx,k,x.ws[k][0..<x.n[k]],t.in_value[k],BT_ALL,h[..]) && bt_hex_is(h[..],KY_SIGHASH[k]);
  }
  #assert ky_slot(ky_fixture_scripts(),t.out_script[1])==2 && ky_slot(ky_fixture_scripts(),t.out_script[0])==-1;
}
#test "an account key that isn't the enrollment's refuses, and nothing is signed" #steps 1000000000 {
  s:=ks_sign(1,KY_PSBT,KY_REQUEST,0);#assert s.code==KyCode.xpub && s.nin==0 && !s.retry;   // alice's key as keyco
  w:=ky_wallet_read(KY_WALLET);p:=ky_parties();wd:=ky_bytes(KY_WALLET_DIGEST);sc:=ky_fixture_scripts();x:=ks_witnesses();
  b:[512]u8;ps:=ky_unhex(KY_PSBT,b[..]);r:=ky_request_read(KY_REQUEST);
  l:[1]KyLedger;acct:[64]u8;ks_account(1,acct[..]);acct[32]^=1;work:[1]KySignWork;   // keyco's key, a changed chain code
  #assert ky_sign(w,wd,sc,x,p.e[..],1,r,ps,1000,KY_T0,l[..],acct[..],work[..]).code==KyCode.xpub;
  acct[32]^=1;
  #assert ky_sign(w,wd,sc,x,p.e[..],1,r,ps,1000,KY_T0,l[..],acct[0..<63],work[..]).code==KyCode.xpub;
  #assert ky_sign(w,wd,sc,x,p.e[..],3,r,ps,1000,KY_T0,l[..],acct[..],work[..]).code==KyCode.xpub;
  #assert ky_sign(w,wd,sc,x,p.e[..],-1,r,ps,1000,KY_T0,l[..],acct[..],work[..]).code==KyCode.xpub;
  two:[2]KySignWork;#assert ky_sign(w,wd,sc,x,p.e[..],1,r,ps,1000,KY_T0,l[..],acct[..],two[..]).code==KyCode.xpub;
  zero:[64]u8;#assert ky_sign(w,wd,sc,x,p.e[..],1,r,ps,1000,KY_T0,l[..],zero[..],work[..]).code==KyCode.xpub;
  // n - k has keyco's x and the other parity: only the first byte differs.
  neg:=acct;nk:=sc_negate(sc_load(acct[0..<32]).value);#assert ss_write(nk,neg[0..<32]);
  #assert ky_sign(w,wd,sc,x,p.e[..],1,r,ps,1000,KY_T0,l[..],neg[..],work[..]).code==KyCode.xpub;
  #assert l[0].count==0;
}
#test "each signer's PSBT carries its partial signatures, as Python's" #steps 2000000000 {
  b:[512]u8;ps:=ky_unhex(KY_PSBT,b[..]);
  for a:0..<3 {
    s:=ks_signed(a);out:[1024]u8;for i:0..<1024 {out[i]=255;}
    n:=ky_psbt_signed(ps,s,out[..]);#assert n>0 && bt_hex_is(out[0..<n],KY_PSBT_SIGNED[a]);
    #assert ky_psbt_read(out[0..<n]).code==KyCode.ok && ky_psbt_signed(ps,s,out[0..<n-1])==-1 && ky_psbt_signed(ps,s,out[0..<n])==n;
  }
  out:[1024]u8;none:KySigned;none.code=KyCode.outputs;#assert ky_psbt_signed(ps,none,out[..])==-1;
  bad:=ks_signed(0);bad.nin=1;#assert ky_psbt_signed(ps,bad,out[..])==-1;
  #assert ky_psbt_signed(ps[0..<ps.count-1],ks_signed(0),out[..])==-1;
  empty:KySigned;empty.code=KyCode.ok;#assert ky_psbt_signed(ps[0..<ps.count-1],empty,out[..])==-1;   // a broken PSBT reads 0 inputs
}
#test "two of three combine into the final transaction; one is not enough" #steps 2000000000 {
  w:=ky_wallet_read(KY_WALLET);b:[512]u8;ps:=ky_unhex(KY_PSBT,b[..]);sc:=ky_fixture_scripts();x:=ks_witnesses();
  s:[3]KySigned;for a:0..<3 {s[a]=ks_signed(a);}
  out:[2048]u8;
  for i:0..<out.count {out[i]=255;}
  n:=ky_combine(w,sc,x,ps,s[0..<2],out[..]);#assert n>0 && bt_hex_is(out[0..<n],KY_FINAL_TX);
  two:=[2]KySigned.[s[1],s[0]];#assert ky_combine(w,sc,x,ps,two[..],out[..])==n && bt_hex_is(out[0..<n],KY_FINAL_TX);
  t3:=ky_combine(w,sc,x,ps,s[..],out[..]);#assert t3>n-4 && t3<n+4 && out[4]==0;   // two of the three in each input, in key order: a third signature would add 72 bytes
  m:=ky_combine(w,sc,x,ps,s[1..<3],out[..]);#assert m>0 && out[m-1]==0 && out[4]==0 && out[5]==1;   // keyco and the enclave
  #assert ky_combine(w,sc,x,ps,s[0..<1],out[..])==-1 && ky_combine(w,sc,x,ps,s[0..<0],out[..])==-1;
  twice:=[2]KySigned.[s[0],s[0]];#assert ky_combine(w,sc,x,ps,twice[..],out[..])==-1;
  #assert ky_combine(w,sc,x,ps,s[0..<2],out[0..<n-1])==-1 && ky_combine(w,sc,x,ps,s[0..<2],out[0..<n])==n;
  refused:=s[1];refused.code=KyCode.outputs;one:=[2]KySigned.[s[0],refused];#assert ky_combine(w,sc,x,ps,one[..],out[..])==-1;
  // Signatures for another PSBT are not combined into this one.
  other:=s[1];other.psbt[31]^=1;one=[2]KySigned.[s[0],other];#assert ky_combine(w,sc,x,ps,one[..],out[..])==-1;
  // A key that differs from keyco's in its first byte only is not keyco's.
  other=s[1];other.p[0].pub[0]^=1;one=[2]KySigned.[s[0],other];#assert ky_combine(w,sc,x,ps,one[..],out[..])==-1;
  evil:[512]u8;#assert ky_combine(w,sc,x,ky_unhex(KY_PSBT_EVIL,evil[..]),s[0..<2],out[..])==-1;
  #assert ky_combine(w,sc,x,ps[0..<ps.count-1],s[0..<2],out[..])==-1;
  far:=sc;far.s[0]=ky_spk(KY_SPK[3]);#assert ky_combine(w,far,x,ps,s[0..<2],out[..])==-1;
}
#test "a PSBT whose outputs differ from its request gets no signature from anyone" #steps 1000000000 {
  for a:0..<3 {s:=ks_sign(a,KY_PSBT_EVIL,KY_REQUEST,a);#assert s.code==KyCode.psbt && s.nin==0;}
  for a:0..<3 {s:=ks_sign(a,KY_PSBT_EVIL,KY_REQUEST_EVIL,a);#assert s.code==KyCode.outputs && s.nin==0;}
}
#test "each agent signs both inputs, equal to libsecp256k1's signatures" #steps 2000000000 {
  for a:0..<3 {
    s:=ks_sign(a,KY_PSBT,KY_REQUEST,a);
    #assert s.code==KyCode.ok && !s.retry && s.nin==2;
    for k:0..<2 {
      #assert bt_hex_is(s.p[k].pub[..],KY_CHILD_PUB[2*a+k]) && bt_hex_is(s.p[k].sig[0..<s.p[k].n],KY_PARTIAL[2*a+k]);
    }
    f:=ks_signed(a);#assert bt_same(s.psbt[..],f.psbt[..]);   // the PSBT's digest: the later checks use ks_signed for these results
  }
}
#test "child private keys: BIP-32 vector 1 and the treasury's" #steps 1000000000 {
  // BIP-32 test vector 1: m/0H's key and chain code, then m/0H/1.
  k:[32]u8;c:[32]u8;k2:[32]u8;c2:[32]u8;work:[1]KySignWork;
  bt_set("edb2e14f9ee77d26dd93b4ecede8d16ed408ce149b6cd80b0715a2d911a0afea",k[..]);
  bt_set("47fdacbd0f1097043b78c63c20c34ef4ed9a111d980047ad16282c7ae6236141",c[..]);
  #assert ky_child_priv(k[..],c[..],1,k2[..],c2[..],work[..]);
  #assert bt_hex_is(k2[..],"3c6cb8d0f6a264c91ea8b5030fadaa8e538b020f0a387421a12de9319dc93368");
  #assert bt_hex_is(c2[..],"2a7857631386ba23dacac34180dd1983734e444fdbf774041578e9b6adb37c19");
  #assert ky_pub(k2[..],work[..]) && bt_hex_is(work[0].pub[..],"03501e454bf00751f24b1b489aa925215d66af2234e3891c3b21a52bedb3cd711c");
  // Every byte of the index counts: m/0H/16909060 (0x01020304), from Python.
  #assert ky_child_priv(k[..],c[..],0x01020304,k2[..],c2[..],work[..]);
  #assert bt_hex_is(k2[..],"01e3f6f4c2db7eb438ef9dd2d91e2ad8b29d89d2a1a0a2d9f6f8272851f62aee");
  #assert bt_hex_is(c2[..],"2277dc5dd0760811fd9a9456accc7ae20b5267ca037f7323a275a151287b52b0");
  // Each slot's key is in that slot's witness script: receive 0, 1 and change 0, 1.
  ka:[64]u8;ks_account(1,ka[..]);                                  // keyco's
  for slot:0..<4 {
    #assert ky_slot_key(ka[..],slot,work[..]) && ky_pub(work[0].k2[..],work[..]);
    found:=false;for j:0..<3 {found=found || bt_hex_is(work[0].pub[..],KY_WITNESS[slot][4+68*j..<70+68*j]);}
    #assert found;
  }
  // The treasury: each agent's receive-1 key's public key is in Python's witness script.
  for a:0..<3 {
    acct:[64]u8;ks_account(a,acct[..]);
    #assert ky_child_priv(acct[0..<32],acct[32..<64],0,k[..],c[..],work[..]) && ky_child_priv(k[..],c[..],1,k2[..],c2[..],work[..]);
    #assert ky_pub(k2[..],work[..]);
    ok:=false;for j:0..<3 {ok=ok || bt_hex_is(work[0].pub[..],KY_WITNESS[1][4+68*j..<70+68*j]);}
    #assert ok;
  }
  zero:[32]u8;#assert !ky_pub(zero[..],work[..]) && !ky_child_priv(zero[..],c[..],1,k2[..],c2[..],work[..]);
  // A tweak IL of n or more refuses (BIP-32): out of reach of a real
  // HMAC, so the scalar step is checked on its own.
  il:[32]u8;for i:0..<32 {il[i]=255;}#assert !ky_add_tweak(k[..],il[..],k2[..]);
  #assert ky_add_tweak(k[..],zero[..],k2[..]) && bt_same(k[..],k2[..]);
  bt_set("fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364140",il[..]);k[31]=1;for i:0..<31 {k[i]=0;}
  #assert !ky_add_tweak(k[..],il[..],k2[..]);                       // the child would be zero
}
#test "an input whose witness script doesn't hash to its program refuses" #steps 1000000000 {
  w:=ky_wallet_read(KY_WALLET);p:=ky_parties();wd:=ky_bytes(KY_WALLET_DIGEST);sc:=ky_fixture_scripts();
  b:[512]u8;ps:=ky_unhex(KY_PSBT,b[..]);r:=ky_request_read(KY_REQUEST);
  l:[1]KyLedger;acct:[64]u8;ks_account(0,acct[..]);work:[1]KySignWork;
  x:=ks_witnesses();x.ws[1][40]^=1;
  s:=ky_sign(w,wd,sc,x,p.e[..],0,r,ps,1000,KY_T0,l[..],acct[..],work[..]);
  #assert s.code==KyCode.inputs && !s.retry && s.nin==0 && work[0].k2[0]==0 && work[0].sig[0]==0;
  out:[2048]u8;s2:[2]KySigned;s2[0]=ks_signed(0);s2[1]=ks_signed(1);
  #assert ky_combine(w,sc,x,ps,s2[..],out[..])==-1;
}
#test "an exact retry signs the same bytes; a changed request with its nonce refuses" #steps 2000000000 {
  w:=ky_wallet_read(KY_WALLET);p:=ky_parties();wd:=ky_bytes(KY_WALLET_DIGEST);sc:=ky_fixture_scripts();x:=ks_witnesses();
  b:[512]u8;ps:=ky_unhex(KY_PSBT,b[..]);r:=ky_request_read(KY_REQUEST);
  l:[1]KyLedger;acct:[64]u8;ks_account(1,acct[..]);work:[1]KySignWork;
  first:=ky_sign(w,wd,sc,x,p.e[..],1,r,ps,1000,KY_T0,l[..],acct[..],work[..]);
  again:=ky_sign(w,wd,sc,x,p.e[..],1,r,ps,1000,KY_T0,l[..],acct[..],work[..]);
  #assert first.code==KyCode.ok && !first.retry && again.code==KyCode.ok && again.retry && l[0].count==1;
  left:=0;for i:0..<32 {left+=cast(int)work[0].k2[i]+cast(int)work[0].k1[i]+cast(int)work[0].c2[i]+cast(int)work[0].ec[0].hk[i];}
  for i:0..<64 {left+=cast(int)work[0].i[i]+cast(int)work[0].sig[i];}
  #assert left==0;
  for k:0..<2 {#assert bt_same(first.p[k].sig[0..<first.p[k].n],again.p[k].sig[0..<again.p[k].n]);}
  r2:=r;r2.digest[0]^=1;
  #assert ky_sign(w,wd,sc,x,p.e[..],1,r2,ps,1000,KY_T0,l[..],acct[..],work[..]).code==KyCode.nonce;
  // A refusal is recorded too, and its retry returns the refusal.
  r3:=r;r3.nonce="bb";
  c:=ky_sign(w,wd,sc,x,p.e[..],1,r3,ps,999,KY_T0,l[..],acct[..],work[..]);#assert c.code==KyCode.ceiling && !c.retry && l[0].count==2;
  c=ky_sign(w,wd,sc,x,p.e[..],1,r3,ps,999,KY_T0,l[..],acct[..],work[..]);#assert c.code==KyCode.ceiling && c.retry && c.nin==0;
  #assert work[0].k2[0]==0 && work[0].k1[5]==0 && work[0].c2[9]==0 && work[0].i[3]==0 && work[0].data[1]==0 && work[0].sig[0]==0 && work[0].ec[0].hk[0]==0;
}
#test "the witness scripts from the xpubs are Python's" #steps 1500000000 {
  w:=ky_wallet_read(KY_WALLET);p:=ky_parties();
  x:=ky_witnesses(w,p.e[..]);
  for k:0..<4 {#assert x.n[k]==105 && bt_hex_is(x.ws[k][0..<x.n[k]],KY_WITNESS[k]);}
  // A branch key that didn't derive (an unreadable xpub: ok is false) leaves no script.
  none:[KY_KEYS]KyExtKey;out:[KY_WS]u8;#assert ky_witness(w,none[..],0,out[..])==-1 && ky_witness(w,none[..],1,out[..])==-1;
}
// book:begin witness
// The witness script k <sorted child keys at index i> n CHECKMULTISIG of a
// one-path wallet, from the enrollments' branch keys b (each xpub's child
// at the branch), into out; its length, or -1 when a key doesn't derive.
ky_witness :: (w:KyWallet,b:[]KyExtKey,i:int,out:[]u8)->int {
  keys:[KY_KEYS][33]u8;
  for j:0..<w.nenroll {
    c:=ky_child(b[j],i);
    if !c.ok {return -1;}
    at:=j;
    while at>0 && ky_less(c.key,keys[at-1]) {keys[at]=keys[at-1];at-=1;}
    keys[at]=c.key;
  }
  out[0]=cast(u8)(0x50+w.paths[0].threshold);n:=1;
  for j:0..<w.nenroll {out[n]=0x21;for k:0..<33 {out[n+1+k]=keys[j][k];}n+=34;}
  out[n]=cast(u8)(0x50+w.nenroll);out[n+1]=0xae;
  return n+2;
}
// Every slot's witness script, derived once at admission: each xpub read
// once, each branch key derived once.
ky_witnesses :: (w:KyWallet,e:[]KyEnrollment)->KyWitnesses {
  r:KyWitnesses;b:[2][KY_KEYS]KyExtKey;
  for j:0..<w.nenroll {x:=ky_ext_key(e[j].key);b[0][j]=ky_child(x,0);b[1][j]=ky_child(x,1);}
  for k:0..<2*KY_GAP {r.n[k]=ky_witness(w,b[k/KY_GAP][..],k%KY_GAP,r.ws[k][..]);}
  return r;
}
// book:end witness
// Where a script sits among the wallet's: branch*KY_GAP + index, or -1.
ky_slot :: (all:KyScripts,s:KyScript)->int {
  for k:0..<2*KY_GAP {if ky_same(all.s[k],s) {return k;}}
  return -1;
}
// Is s the P2WSH scriptPubKey of witness script ws (0x00 0x20 SHA-256(ws))?
ky_ws_is :: (ws:[]u8,s:KyScript)->bool {
  r:KyScript;r.n=34;r.b[1]=0x20;h:[32]u8;bt_sha(ws,h[..]);
  for k:0..<32 {r.b[2+k]=h[k];}
  return ky_same(r,s);
}
// The unsigned transaction inside a PSBT v0 that ky_psbt_read accepted.
ky_unsigned :: (psbt:[]u8)->[]u8 {g:=ky_map(psbt,KY_MAGIC.count);return psbt[g.at[0]..<g.at[0]+g.n[0]];}

// ---- private derivation (secrets)
// The compressed public key of key, by the comb, into work.pub; false for
// a key outside [1, n-1]. The point is public.
ky_pub :: (key:[]u8,work:[]KySignWork)->bool {
  #assert ss_key(key,work[0].key[..],false) && sp_base(work[0].key[0].safe,work[0].point[..]) && sp_x(work[0].point[..],work[0].pub[1..<33]);
  work[0].pub[0]=cast(u8)(2+(work[0].point[0].odd&1));
  return ec_declassify(work[0].key[0].valid);
}
// parent + IL into child; false when IL >= n or the child is zero (BIP-32's
// invalid children; whether a key is valid is public).
ky_add_tweak :: (parent:[]u8,il:[]u8,child:[]u8)->bool {
  t:=sc_load(il);c:=sc_add(t.value,sc_load(parent).value);
  #assert ss_write(c,child);
  return t.ok && ec_declassify(ec_nonzero(c));
}
// book:begin child
// BIP-32 CKDpriv at a normal index: HMAC-SHA512(chain, serP(kG) || index),
// child key IL + k, chain code IR.
ky_child_priv :: (key:[]u8,chain:[]u8,index:int,key_out:[]u8,chain_out:[]u8,work:[]KySignWork)->bool {
  if !ky_pub(key,work) {return false;}
  for k:0..<33 {work[0].data[k]=work[0].pub[k];}
  for k:0..<4 {work[0].data[33+k]=cast(u8)((index>>(8*(3-k)))&255);}
  #assert hmac_sha512(chain,work[0].data[..],work[0].i[..]);
  for k:0..<32 {chain_out[k]=work[0].i[32+k];}
  return ky_add_tweak(key,work[0].i[0..<32],key_out);
}
// book:end child
// The child key at a slot (branch slot/KY_GAP, index slot%KY_GAP) of an
// account (key || chain code), into work.k2.
ky_slot_key :: (account:[]u8,slot:int,work:[]KySignWork)->bool {
  return ky_child_priv(account[0..<32],account[32..<64],slot/KY_GAP,work[0].k1[..],work[0].c1[..],work) &&
    ky_child_priv(work[0].k1[..],work[0].c1[..],slot%KY_GAP,work[0].k2[..],work[0].c2[..],work);
}
ky_sign_clear :: (work:[]KySignWork) {fresh:KySignWork;work[0]=fresh;}
ky_refusal :: (work:[]KySignWork,code:KyCode,retry:bool)->KySigned {ky_sign_clear(work);return KySigned.{code=code,retry=retry};}
// Does account (key || chain code) belong to enrollment me? Its public key
// and chain code are the enrollment xpub's (both public).
ky_account_is :: (e:[]KyEnrollment,me:int,account:[]u8,work:[]KySignWork)->bool {
  if me<0 || me>=e.count || account.count!=64 || work.count!=1 || !ky_pub(account[0..<32],work) {return false;}
  x:=ky_ext_key(e[me].key);
  for k:0..<33 {if work[0].pub[k]!=x.key[k] {return false;}}
  for k:0..<32 {if account[32+k]!=x.chain[k] {return false;}}
  return true;
}

// book:begin ky_sign
// One key agent's answer to one request: the checks (ky_sign_check), the
// account key against its enrollment me, the outcome recorded in the
// ledger before any signature exists, then one SIGHASH_ALL ECDSA signature
// per input. An exact retry signs again, to the same bytes (RFC 6979).
// account is the agent's account private key and chain code (64 bytes);
// wit the wallet's witness scripts (ky_witnesses).
ky_sign :: (w:KyWallet,wallet_digest:[32]u8,all:KyScripts,wit:KyWitnesses,e:[]KyEnrollment,me:int,r:KyRequest,psbt:[]u8,ceiling:int,now:int,l:[]KyLedger,account:[]u8,work:[]KySignWork)->KySigned {
  code:=ky_sign_check(w,wallet_digest,all,r,psbt,ceiling,now);
  if !ky_account_is(e,me,account,work) {return ky_refusal(work,KyCode.xpub,false);}
  c:=ky_consume(l,e[me].agent,r,code);
  if c.code!=KyCode.ok {return ky_refusal(work,c.code,c.retry);}
  t:=ky_psbt_read(psbt);u:=ky_unsigned(psbt);tx:=bt_tx_read(u);x:=wit;
  out:=[1]KySigned.[KySigned.{code=KyCode.ok,retry=c.retry,nin=t.nin}];
  bt_sha(psbt,out[0].psbt[..]);
  for k:0..<t.nin {
    slot:=ky_slot(all,t.in_script[k]);         // ky_sign_check found every input among them
    ws:=x.ws[slot][0..<x.n[slot]];h:[32]u8;
    if !ky_ws_is(ws,t.in_script[k]) {return ky_refusal(work,KyCode.inputs,false);}
    #assert bt_sighash_v0(u,tx,k,ws,t.in_value[k],BT_ALL,h[..]);
    #assert ky_slot_key(account,slot,work);
    #assert ecdsa_sign(work[0].k2[..],h[..],work[0].ec[..],work[0].sig[..],false) && ky_pub(work[0].k2[..],work);
    d:=ecdsa_der(work[0].sig[..],out[0].p[k].sig[..]);
    out[0].p[k].sig[d]=cast(u8)BT_ALL;out[0].p[k].n=d+1;out[0].p[k].pub=work[0].pub;
  }
  ky_sign_clear(work);
  return out[0];
}
// book:end ky_sign

// book:begin partial
// The PSBT with one signer's partial signatures: each input map gets
// PSBT_IN_PARTIAL_SIG (key 0x02 || public key, value the signature) before
// its terminator. Into out; the length, or -1 (an unsigned result, a count
// that isn't the PSBT's, or out too short).
ky_psbt_signed :: (psbt:[]u8,sp:KySigned,out:[]u8)->int {
  s:=sp;t:=ky_psbt_read(psbt);
  if s.code!=KyCode.ok || t.code!=KyCode.ok || s.nin!=t.nin {return -1;}
  need:=psbt.count;for k:0..<t.nin {need+=36+s.p[k].n;}
  if out.count<need {return -1;}
  g:=ky_map(psbt,KY_MAGIC.count);
  n:=bt_put(out,0,psbt[0..<g.end]);at:=g.end;
  for k:0..<t.nin {
    m:=ky_map(psbt,at);
    n=bt_put(out,n,psbt[at..<m.end-1]);
    out[n]=34;out[n+1]=0x02;n=bt_put(out,n+2,s.p[k].pub[..]);
    out[n]=cast(u8)s.p[k].n;n=bt_put(out,n+1,s.p[k].sig[0..<s.p[k].n]);
    out[n]=0;n+=1;at=m.end;                              // the map's terminator
  }
  return bt_put(out,n,psbt[at..<psbt.count]);
}
// book:end partial

// book:begin combine
// The coordinator: the final transaction from the signers' results for
// this PSBT (matched by digest), with the wallet's scripts and witness
// scripts. Each input's witness is 0, then a threshold of signatures in
// the witness script's key order, then the witness script. Into out; the
// length, or -1 when an input has fewer than a threshold of signatures.
ky_combine :: (w:KyWallet,all:KyScripts,wit:KyWitnesses,psbt:[]u8,s:[]KySigned,out:[]u8)->int {
  t:=ky_psbt_read(psbt);x:=wit;
  if t.code!=KyCode.ok {return -1;}
  d:[32]u8;bt_sha(psbt,d[..]);u:=ky_unsigned(psbt);
  buf:[2048]u8;wn:=0;need:=w.paths[0].threshold;
  for k:0..<t.nin {
    slot:=ky_slot(all,t.in_script[k]);if slot<0 {return -1;}
    ws:=x.ws[slot][0..<x.n[slot]];
    if !ky_ws_is(ws,t.in_script[k]) {return -1;}
    buf[wn]=cast(u8)(need+2);wn+=2;got:=0;               // the item count, then an empty item (buf is zeroed)
    for j:0..<w.nenroll {
      used:=false;
      for xi:0..<s.count {
        y:=s[xi];same:=y.code==KyCode.ok && ky_eq32(y.psbt,d) && got<need && !used;
        for b:0..<33 {same=same && y.p[k].pub[b]==ws[2+34*j+b];}
        if same {buf[wn]=cast(u8)y.p[k].n;wn=bt_put(buf[..],wn+1,y.p[k].sig[0..<y.p[k].n]);got+=1;used=true;}
      }
    }
    if got<need {return -1;}
    buf[wn]=cast(u8)ws.count;wn=bt_put(buf[..],wn+1,ws);
  }
  if out.count<u.count+2+wn {return -1;}
  m:=bt_put(out,0,u[0..<4]);out[m]=0;out[m+1]=1;
  m=bt_put(out,m+2,u[4..<u.count-4]);m=bt_put(out,m,buf[0..<wn]);
  return bt_put(out,m,u[u.count-4..<u.count]);
}
// book:end combine
