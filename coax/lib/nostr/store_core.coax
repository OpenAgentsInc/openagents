// The in-memory verified event store's decisions (nostr-event-store #8eb5,
// R1 part; verified-ID dedup #f539): admission of verified events, one
// lowest exact original per event id, NIP-01 replaceable (0, 3, 10000-19999)
// and addressable (30000-39999 by d tag) replacement with the same-second
// lowest-id rule, NIP-40 expiration, fixed record and byte bounds, and the
// newest-first query order. It loads neither event.coax nor the verifier:
// the caller passes the verification result (`verified`) and the fields it
// read, as relay_server's rs_admit_verified does. Matching a filter is the
// caller's (store.coax with filter.coax's nf_match). Nothing here is durable:
// a restart forgets every event; there is no NIP-09 deletion or tombstone,
// and no trusted recovery (#966b).
//
// The type and constant names are the relay's store interface (rsd_, from
// coax/tests/nostr/relay_store_double.coax), so the relay swaps its test
// double for this store by changing one #load.
#load "store_policy.coax";
#load "store_dedup_policy.coax";
#authority;

RSD_MAX :: 2048; RSD_ARENA :: 4194304;
// Results, numerically the relay's RS_ACCEPT, RS_DUP, RS_SUPERSEDED,
// RS_BAD_EVENT, RS_BAD_SIG and RS_FULL (store.coax checks they agree).
NSS_ACCEPT :: 0; NSS_DUP :: 1; NSS_SUPERSEDED :: 2; NSS_BAD :: 3; NSS_UNVERIFIED :: 5; NSS_FULL :: 11;
// One stored event. from/to is its exact original in the arena, tags_from/
// tags_to its tags array inside the arena. A record that is not live was
// replaced; it is kept only so its id still answers "duplicate" until the
// next compaction.
RsdRec :: struct {
  live: bool; id: [32] u8; author: [32] u8; kind: int; created: int; expiry: int;
  d: [256] u8; d_n: int; from: int; to: int; tags_from: int; tags_to: int;
}
// The caller owns arena and recs (the relay sizes them RSD_ARENA and RSD_MAX).
// n records are in use and used arena bytes; live and bytes count the live
// records and their originals (what the bounds charge); now is the latest
// query time seen, used to drop expired regular events at compaction.
//
// ids and addrs (#12631, optional) are the admission lookups: open-addressed
// tables of record index + 1 (0 an empty slot), as long as each other and
// longer than recs. ids
// holds, for every id among the records, the latest record with that id;
// addrs, for every address (kind and author, and d when addressable) of a
// replaceable or addressable record, the latest record at it. Records are
// only appended and retired, never revived, so the latest is the only one
// that can be live, which is all admission asks (ns_store_plan). Without
// them (empty, or not longer than recs) admission scans every record, as it
// always did; the decisions are the same either way. probes counts the
// slots the lookups read, for the checks.
RsdStore :: struct { n: int; used: int; live: int; bytes: int; now: int; arena: [] u8; recs: [] RsdRec; ids: [] int; addrs: [] int; probes: int; }
NsRoom :: struct { ok: bool; keep: int; }
// An admission decided but not yet applied: the result, what it writes
// (nothing, an append retiring record at when at >= 0, or an in-place
// rewrite of record at).
NS_W_NONE :: 0; NS_W_APPEND :: 1; NS_W_INPLACE :: 2;
NsPlan :: struct { result: int; write: int; at: int = -1; }

// ---- test helpers ------------------------------------------------------------
nss_t_rec :: (id: u8, kind: int, created: int) -> RsdRec {
  c: RsdRec; c.id[0] = id; c.kind = kind; c.created = created; c.expiry = -1; return c;
}

#test "admits verified events, refuses unverified and malformed ones" {
  arena: [64] u8; recs: [4] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 10);
  #assert ns_store_admit(s[..], c, "ab", false) == NSS_UNVERIFIED && s[0].n == 0 && s[0].used == 0;
  #assert ns_store_admit(s[..], c, "", true) == NSS_BAD && s[0].n == 0;
  c.tags_to = 3; #assert ns_store_admit(s[..], c, "ab", true) == NSS_BAD;
  c.tags_from = 3; #assert ns_store_admit(s[..], c, "abc", true) == NSS_ACCEPT; c.id[0] = 2;
  c.tags_from = -1; c.tags_to = 0; #assert ns_store_admit(s[..], c, "ab", true) == NSS_BAD;
  c.tags_from = 2; c.tags_to = 1; #assert ns_store_admit(s[..], c, "ab", true) == NSS_BAD;
  c.tags_from = 0; c.tags_to = 0; c.d_n = -1; #assert ns_store_admit(s[..], c, "ab", true) == NSS_BAD;
  c.d_n = 257; #assert ns_store_admit(s[..], c, "ab", true) == NSS_BAD;
  c.d_n = 256; #assert ns_store_admit(s[..], c, "ab", true) == NSS_ACCEPT;
  #assert s[0].n == 2 && s[0].live == 2 && s[0].bytes == 5 && s[0].used == 5;
  #assert rsd_text(s[..], 0) == "abc" && rsd_text(s[..], 1) == "ab";
  #assert s[0].recs[0].tags_from == 3 && s[0].recs[0].tags_to == 3 && s[0].recs[1].from == 3 && s[0].recs[1].to == 5;
  #assert s[0].recs[0].live && s[0].recs[0].kind == 1 && s[0].recs[0].created == 10;
}
#test "tag spans are stored relative to the arena" {
  arena: [64] u8; recs: [4] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 10); #assert ns_store_admit(s[..], c, "xyz", true) == NSS_ACCEPT;
  c.id[0] = 2; c.tags_from = 1; c.tags_to = 3; #assert ns_store_admit(s[..], c, "abcd", true) == NSS_ACCEPT;
  #assert s[0].recs[1].tags_from == 4 && s[0].recs[1].tags_to == 6;
  #assert cast(string) arena[s[0].recs[1].tags_from..<s[0].recs[1].tags_to] == "bc";
}
#test "ephemeral events are accepted and never stored" {
  arena: [8] u8; recs: [1] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 20000, 1); #assert ns_store_admit(s[..], c, "abcdefghijk", true) == NSS_ACCEPT && s[0].n == 0 && s[0].used == 0;
  c.kind = 29999; #assert ns_store_admit(s[..], c, "a", true) == NSS_ACCEPT && s[0].n == 0;
  c.kind = 30000; #assert ns_store_admit(s[..], c, "a", true) == NSS_ACCEPT && s[0].n == 1;
}
#test "a duplicate id is not charged and keeps the lowest exact original" {
  arena: [16] u8; recs: [4] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 10);
  #assert ns_store_admit(s[..], c, "bb", true) == NSS_ACCEPT;
  // a higher representation changes nothing
  #assert ns_store_admit(s[..], c, "bc", true) == NSS_DUP && rsd_text(s[..], 0) == "bb" && s[0].n == 1 && s[0].used == 2;
  #assert ns_store_admit(s[..], c, "bb", true) == NSS_DUP && s[0].used == 2 && s[0].live == 1;
  // a lower one of the same or shorter length is written in place
  c.tags_from = 1; c.tags_to = 1;
  #assert ns_store_admit(s[..], c, "a", true) == NSS_DUP && rsd_text(s[..], 0) == "a";
  #assert s[0].n == 1 && s[0].live == 1 && s[0].bytes == 1 && s[0].used == 2 && s[0].recs[0].tags_from == 1;
  // a longer lower one is appended and the old record retired
  c.id[0] = 2; c.tags_from = 0; c.tags_to = 0; #assert ns_store_admit(s[..], c, "zzz", true) == NSS_ACCEPT && s[0].used == 5;
  c.tags_from = 1; c.tags_to = 3; #assert ns_store_admit(s[..], c, "yyyy", true) == NSS_DUP;
  #assert s[0].n == 3 && s[0].live == 2 && s[0].bytes == 5 && s[0].used == 9 && !s[0].recs[1].live && s[0].recs[2].live;
  #assert rsd_text(s[..], 2) == "yyyy" && s[0].recs[2].tags_from == 6 && s[0].recs[2].tags_to == 8;
  // the retired copy still answers duplicate
  c.tags_from = 0; c.tags_to = 0; #assert ns_store_admit(s[..], c, "zzz", true) == NSS_DUP && rsd_text(s[..], 2) == "yyyy";
  #assert ns_store_admit(s[..], c, "yyyx", true) == NSS_DUP && rsd_text(s[..], 2) == "yyyx" && s[0].n == 3;
}
#test "a longer lower original that does not fit keeps the old one" {
  arena: [6] u8; recs: [4] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 10); #assert ns_store_admit(s[..], c, "zz", true) == NSS_ACCEPT;
  c.id[0] = 2; #assert ns_store_admit(s[..], c, "yy", true) == NSS_ACCEPT;
  c.id[0] = 1; #assert ns_store_admit(s[..], c, "aaaaa", true) == NSS_DUP;
  #assert rsd_text(s[..], 0) == "zz" && s[0].n == 2 && s[0].live == 2 && s[0].bytes == 4 && s[0].used == 4 && arena[4] == 0;
  // exactly fitting succeeds
  #assert ns_store_admit(s[..], c, "aa", true) == NSS_DUP && rsd_text(s[..], 0) == "aa";
  #assert ns_store_admit(s[..], c, "a", true) == NSS_DUP && s[0].bytes == 3;
  c.id[0] = 3; #assert ns_store_admit(s[..], c, "qq", true) == NSS_ACCEPT && s[0].used == 6;
}
#test "a full record table refuses a new id but takes its duplicates" {
  arena: [16] u8; recs: [2] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 10); #assert ns_store_admit(s[..], c, "b", true) == NSS_ACCEPT;
  c.id[0] = 2; #assert ns_store_admit(s[..], c, "b", true) == NSS_ACCEPT;
  c.id[0] = 3; #assert ns_store_admit(s[..], c, "b", true) == NSS_FULL && s[0].n == 2 && s[0].used == 2;
  c.id[0] = 2; #assert ns_store_admit(s[..], c, "a", true) == NSS_DUP && rsd_text(s[..], 1) == "a";
  // longer and lower, but no free record: the old one stays
  #assert ns_store_admit(s[..], c, "Aa", true) == NSS_DUP && rsd_text(s[..], 1) == "a" && s[0].live == 2;
}
#test "a full arena refuses at the exact boundary" {
  arena: [5] u8; recs: [4] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 10); #assert ns_store_admit(s[..], c, "abc", true) == NSS_ACCEPT;
  c.id[0] = 2; #assert ns_store_admit(s[..], c, "abc", true) == NSS_FULL && s[0].n == 1 && s[0].used == 3;
  #assert ns_store_admit(s[..], c, "ab", true) == NSS_ACCEPT && s[0].used == 5 && s[0].bytes == 5;
}
#test "replaceable events: newest wins, the same second goes to the lowest id" {
  arena: [64] u8; recs: [8] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(5, 0, 10);
  #assert ns_store_admit(s[..], c, "a", true) == NSS_ACCEPT;
  c.id[0] = 6; #assert ns_store_admit(s[..], c, "b", true) == NSS_SUPERSEDED && s[0].n == 1;
  c.id[0] = 4; #assert ns_store_admit(s[..], c, "c", true) == NSS_ACCEPT && !s[0].recs[0].live && s[0].recs[1].live;
  #assert s[0].live == 1 && s[0].bytes == 1 && s[0].used == 2;
  c.created = 9; c.id[0] = 3; #assert ns_store_admit(s[..], c, "d", true) == NSS_SUPERSEDED;
  // a replaced event sent again is a duplicate while its record is kept
  c.id[0] = 5; #assert ns_store_admit(s[..], c, "a", true) == NSS_DUP && s[0].n == 2;
  c.created = 11; c.id[0] = 9; #assert ns_store_admit(s[..], c, "e", true) == NSS_ACCEPT && !s[0].recs[1].live && s[0].live == 1;
  // another author, another kind, a regular kind: separate addresses
  c.author[0] = 1; c.id[0] = 10; c.created = 1; #assert ns_store_admit(s[..], c, "f", true) == NSS_ACCEPT && s[0].live == 2;
  c.kind = 3; c.id[0] = 11; #assert ns_store_admit(s[..], c, "g", true) == NSS_ACCEPT && s[0].live == 3;
  c.kind = 1; c.id[0] = 12; c.created = 0; #assert ns_store_admit(s[..], c, "h", true) == NSS_ACCEPT;
  c.id[0] = 13; #assert ns_store_admit(s[..], c, "i", true) == NSS_ACCEPT && s[0].live == 5;
  c.kind = 10000; c.id[0] = 14; #assert ns_store_admit(s[..], c, "j", true) == NSS_ACCEPT;
  c.id[0] = 15; c.created = 1; #assert ns_store_admit(s[..], c, "k", true) == NSS_ACCEPT && s[0].live == 6;
  c.kind = 19999; c.id[0] = 16; #assert ns_store_admit(s[..], c, "l", true) == NSS_ACCEPT && s[0].live == 7;
}
#test "the tie rule compares the whole id" {
  arena: [64] u8; recs: [8] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(5, 3, 10); c.id[31] = 2;
  #assert ns_store_admit(s[..], c, "a", true) == NSS_ACCEPT;
  c.id[31] = 3; #assert ns_store_admit(s[..], c, "b", true) == NSS_SUPERSEDED;
  c.id[31] = 1; c.d[0] = 'q'; c.d_n = 1; #assert ns_store_admit(s[..], c, "c", true) == NSS_ACCEPT && s[0].live == 1 && s[0].recs[1].live;
  c.author[31] = 1; c.id[31] = 0; #assert ns_store_admit(s[..], c, "d", true) == NSS_ACCEPT && s[0].live == 2;
}
#test "addressable events are replaced per author, kind and d tag" {
  arena: [64] u8; recs: [8] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(7, 30617, 20); c.d[0] = 'a'; c.d_n = 1;
  #assert ns_store_admit(s[..], c, "a", true) == NSS_ACCEPT;
  c.d[0] = 'b'; c.id[0] = 8; #assert ns_store_admit(s[..], c, "b", true) == NSS_ACCEPT && s[0].live == 2;
  c.d_n = 0; c.id[0] = 9; #assert ns_store_admit(s[..], c, "c", true) == NSS_ACCEPT && s[0].live == 3;
  c.d[0] = 'a'; c.d_n = 1; c.id[0] = 6; c.created = 21; #assert ns_store_admit(s[..], c, "d", true) == NSS_ACCEPT;
  #assert !s[0].recs[0].live && s[0].recs[1].live && s[0].recs[2].live && s[0].live == 3;
  // a longer d with the same first byte is another address
  c.d[1] = 'x'; c.d_n = 2; c.id[0] = 1; c.created = 0; #assert ns_store_admit(s[..], c, "e", true) == NSS_ACCEPT && s[0].live == 4;
  c.d_n = 0; c.id[0] = 2; c.created = 0; #assert ns_store_admit(s[..], c, "f", true) == NSS_SUPERSEDED;
  c.kind = 39999; #assert ns_store_admit(s[..], c, "f", true) == NSS_ACCEPT;
  c.kind = 30617; c.d[0] = 'b'; c.d_n = 1; c.id[0] = 3; c.created = 20; #assert ns_store_admit(s[..], c, "g", true) == NSS_ACCEPT && !s[0].recs[1].live;
}
#test "a replacement that does not fit keeps the current version" {
  arena: [3] u8; recs: [4] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(5, 0, 10); #assert ns_store_admit(s[..], c, "ab", true) == NSS_ACCEPT;
  c.created = 11; c.id[0] = 6; #assert ns_store_admit(s[..], c, "ab", true) == NSS_FULL;
  #assert s[0].recs[0].live && s[0].live == 1 && s[0].n == 1 && rsd_text(s[..], 0) == "ab";
}
#test "compaction drops replaced records and keeps order and spans" {
  arena: [8] u8; recs: [3] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 10); c.tags_from = 1; c.tags_to = 2; #assert ns_store_admit(s[..], c, "ab", true) == NSS_ACCEPT;
  r := nss_t_rec(5, 0, 10); #assert ns_store_admit(s[..], r, "cd", true) == NSS_ACCEPT;
  r.id[0] = 4; r.tags_from = 1; r.tags_to = 2; #assert ns_store_admit(s[..], r, "ef", true) == NSS_ACCEPT && s[0].n == 3 && s[0].live == 2;
  c.id[0] = 2; #assert ns_store_admit(s[..], c, "gh", true) == NSS_ACCEPT;
  #assert s[0].n == 3 && s[0].used == 6 && s[0].live == 3 && s[0].bytes == 6;
  #assert rsd_text(s[..], 0) == "ab" && rsd_text(s[..], 1) == "ef" && rsd_text(s[..], 2) == "gh";
  #assert s[0].recs[0].tags_from == 1 && s[0].recs[1].tags_from == 3 && s[0].recs[1].tags_to == 4 && s[0].recs[2].tags_from == 5;
  #assert s[0].recs[1].id[0] == 4 && s[0].recs[2].id[0] == 2 && s[0].recs[0].live && s[0].recs[1].live && s[0].recs[2].live;
  // the retired id is forgotten: re-sent, it is superseded instead
  r.id[0] = 5; #assert ns_store_admit(s[..], r, "cd", true) == NSS_SUPERSEDED;
}
#test "a duplicate dropped as expired at compaction is not revived" {
  arena: [8] u8; recs: [1] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 1); c.expiry = 5; #assert ns_store_admit(s[..], c, "zz", true) == NSS_ACCEPT;
  #assert ns_store_seen(s[..], 5) && !ns_store_seen(s[..], 5) && !ns_store_seen(s[..], 4) && s[0].now == 5;
  #assert ns_store_admit(s[..], c, "aaa", true) == NSS_DUP && s[0].n == 0 && s[0].live == 0 && s[0].bytes == 0;
}
#test "an expired regular event after the first is dropped and its bytes freed" {
  arena: [6] u8; recs: [2] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 1); #assert ns_store_admit(s[..], c, "ab", true) == NSS_ACCEPT;
  c.id[0] = 2; c.expiry = 5; #assert ns_store_admit(s[..], c, "cd", true) == NSS_ACCEPT;
  #assert ns_store_seen(s[..], 5);
  c.id[0] = 3; c.expiry = -1; #assert ns_store_admit(s[..], c, "efgh", true) == NSS_ACCEPT;
  #assert s[0].n == 2 && s[0].live == 2 && s[0].bytes == 6 && s[0].used == 6 && rsd_text(s[..], 1) == "efgh";
}
#test "an in-place lower original after the first record keeps its spans" {
  arena: [8] u8; recs: [2] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 1); #assert ns_store_admit(s[..], c, "x", true) == NSS_ACCEPT;
  c.id[0] = 2; #assert ns_store_admit(s[..], c, "zz", true) == NSS_ACCEPT;
  c.tags_from = 1; c.tags_to = 2; #assert ns_store_admit(s[..], c, "ab", true) == NSS_DUP;
  #assert rsd_text(s[..], 1) == "ab" && s[0].recs[1].tags_from == 2 && s[0].recs[1].tags_to == 3 && s[0].bytes == 3;
}
#test "a longer lower original of the first record moves it" {
  arena: [8] u8; recs: [2] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 1); #assert ns_store_admit(s[..], c, "b", true) == NSS_ACCEPT;
  #assert ns_store_admit(s[..], c, "ab", true) == NSS_DUP && s[0].n == 2 && rsd_text(s[..], 1) == "ab" && !s[0].recs[0].live;
}
#test "compaction drops expired regular events but keeps expired replaceable heads" {
  arena: [8] u8; recs: [3] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 10); c.expiry = 50; #assert ns_store_admit(s[..], c, "ab", true) == NSS_ACCEPT;
  r := nss_t_rec(5, 0, 10); r.expiry = 50; #assert ns_store_admit(s[..], r, "cd", true) == NSS_ACCEPT;
  c.id[0] = 2; c.expiry = -1; #assert ns_store_admit(s[..], c, "ef", true) == NSS_ACCEPT;
  #assert ns_store_seen(s[..], 49);
  c.id[0] = 3; #assert ns_store_admit(s[..], c, "gh", true) == NSS_FULL && s[0].n == 3;
  #assert ns_store_seen(s[..], 50) && !ns_store_seen(s[..], 7) && s[0].now == 50;
  #assert ns_store_admit(s[..], c, "gh", true) == NSS_ACCEPT && s[0].n == 3 && s[0].live == 3 && s[0].bytes == 6;
  #assert rsd_text(s[..], 0) == "cd" && rsd_text(s[..], 1) == "ef" && rsd_text(s[..], 2) == "gh";
  // the expired head still blocks an older version
  r.id[0] = 6; r.created = 9; r.expiry = -1; #assert ns_store_admit(s[..], r, "x", true) == NSS_SUPERSEDED;
  #assert !ns_store_visible(s[..], 0, 50) && ns_store_visible(s[..], 0, 49) && ns_store_visible(s[..], 1, 50);
}
#test "compaction finds a duplicate's new place" {
  arena: [8] u8; recs: [3] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  r := nss_t_rec(5, 0, 10); #assert ns_store_admit(s[..], r, "ab", true) == NSS_ACCEPT;
  r.id[0] = 4; #assert ns_store_admit(s[..], r, "cd", true) == NSS_ACCEPT;
  c := nss_t_rec(1, 1, 10); #assert ns_store_admit(s[..], c, "zz", true) == NSS_ACCEPT && s[0].n == 3;
  #assert ns_store_admit(s[..], c, "yyy", true) == NSS_DUP;
  #assert s[0].n == 3 && s[0].live == 2 && rsd_text(s[..], 0) == "cd" && !s[0].recs[1].live && rsd_text(s[..], 2) == "yyy";
  #assert s[0].bytes == 5 && s[0].used == 7;
  // after compaction a new event takes the replaced head's place
  r.id[0] = 3; r.created = 11; #assert ns_store_admit(s[..], r, "e", true) == NSS_ACCEPT;
  #assert s[0].n == 3 && !s[0].recs[0].live && s[0].live == 2;
}
#test "compaction moves a replacement's head to its new index" {
  arena: [6] u8; recs: [3] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 0, 10); #assert ns_store_admit(s[..], c, "ab", true) == NSS_ACCEPT;
  c.id[0] = 2; c.created = 11; #assert ns_store_admit(s[..], c, "cd", true) == NSS_ACCEPT;
  x := nss_t_rec(9, 1, 1); #assert ns_store_admit(s[..], x, "e", true) == NSS_ACCEPT;
  c.id[0] = 3; c.created = 12; #assert ns_store_admit(s[..], c, "fg", true) == NSS_ACCEPT;
  #assert s[0].n == 3 && s[0].live == 2 && !s[0].recs[0].live && s[0].recs[1].live && s[0].recs[2].live;
  #assert rsd_text(s[..], 1) == "e" && rsd_text(s[..], 2) == "fg" && s[0].used == 5 && s[0].bytes == 3;
}
#test "visibility: live and not expired at the exact second" {
  arena: [8] u8; recs: [3] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 10); c.expiry = 5; #assert ns_store_admit(s[..], c, "a", true) == NSS_ACCEPT;
  #assert ns_store_visible(s[..], 0, 4) && !ns_store_visible(s[..], 0, 5);
  r := nss_t_rec(5, 0, 10); #assert ns_store_admit(s[..], r, "b", true) == NSS_ACCEPT;
  r.id[0] = 4; #assert ns_store_admit(s[..], r, "c", true) == NSS_ACCEPT;
  #assert !ns_store_visible(s[..], 1, 0) && ns_store_visible(s[..], 2, 9223372036854775807);
}
#test "a plan says what it will write and writes nothing itself" {
  arena: [16] u8; recs: [4] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(1, 1, 10);
  p := ns_store_plan(s[..], c, "bb", true);
  #assert p.result == NSS_ACCEPT && p.write == NS_W_APPEND && p.at == -1 && s[0].n == 0 && s[0].used == 0;
  #assert ns_store_apply(s[..], p, c, "bb") == NSS_ACCEPT && s[0].n == 1;
  p = ns_store_plan(s[..], c, "a", true); #assert p.result == NSS_DUP && p.write == NS_W_INPLACE && p.at == 0 && rsd_text(s[..], 0) == "bb";
  p = ns_store_plan(s[..], c, "ab", true); #assert p.write == NS_W_INPLACE && p.at == 0;
  p = ns_store_plan(s[..], c, "abc", true); #assert p.result == NSS_DUP && p.write == NS_W_APPEND && p.at == 0 && s[0].n == 1;
  p = ns_store_plan(s[..], c, "bc", true); #assert p.result == NSS_DUP && p.write == NS_W_NONE;
  p = ns_store_plan(s[..], c, "bb", false); #assert p.result == NSS_UNVERIFIED && p.write == NS_W_NONE;
  p = ns_store_plan(s[..], c, "", true); #assert p.result == NSS_BAD && p.write == NS_W_NONE;
  e := nss_t_rec(2, 20001, 1); p = ns_store_plan(s[..], e, "x", true); #assert p.result == NSS_ACCEPT && p.write == NS_W_NONE;
  #assert ns_store_apply(s[..], p, e, "x") == NSS_ACCEPT && s[0].n == 1;
  r := nss_t_rec(5, 0, 10); #assert ns_store_admit(s[..], r, "r", true) == NSS_ACCEPT;
  r.id[0] = 4; p = ns_store_plan(s[..], r, "q", true); #assert p.result == NSS_ACCEPT && p.write == NS_W_APPEND && p.at == 1;
  r.id[0] = 6; p = ns_store_plan(s[..], r, "q", true); #assert p.result == NSS_SUPERSEDED && p.write == NS_W_NONE;
  #assert s[0].n == 2 && s[0].used == 3 && s[0].live == 2;
}
#test "query order: newest first, then lowest id, cut at the limit" {
  arena: [16] u8; recs: [8] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  c := nss_t_rec(3, 1, 10); #assert ns_store_admit(s[..], c, "a", true) == NSS_ACCEPT;
  c.id[0] = 1; c.created = 5; #assert ns_store_admit(s[..], c, "b", true) == NSS_ACCEPT;
  c.id[0] = 2; c.created = 10; #assert ns_store_admit(s[..], c, "c", true) == NSS_ACCEPT;
  c.id[0] = 4; c.created = 12; #assert ns_store_admit(s[..], c, "d", true) == NSS_ACCEPT;
  out: [8] int; n := 0;
  for i: 0..<4 { n = ns_store_insert(s[..], i, n, 8, out[..]); }
  #assert n == 4 && out[0] == 3 && out[1] == 2 && out[2] == 0 && out[3] == 1;
  n = 0; for i: 0..<4 { n = ns_store_insert(s[..], i, n, 2, out[..]); }
  #assert n == 2 && out[0] == 3 && out[1] == 2 && out[2] == 0;
  n = 0; for i: 0..<4 { n = ns_store_insert(s[..], i, n, 3, out[0..<2]); }
  #assert n == 2 && out[0] == 3 && out[1] == 2;
  n = 0; for i: 0..<4 { n = ns_store_insert(s[..], i, n, 0, out[..]); }
  #assert n == 0;
  n = 0; for i: 0..<4 { n = ns_store_insert(s[..], 3 - i, n, 3, out[..]); }
  #assert n == 3 && out[0] == 3 && out[1] == 2 && out[2] == 0;
  out[2] = 99; n = 0; for i: 0..<4 { n = ns_store_insert(s[..], 3 - i, n, 2, out[..]); }
  #assert n == 2 && out[0] == 3 && out[1] == 2 && out[2] == 99;
  n = 0; for i: 0..<4 { n = ns_store_insert(s[..], 3 - i, n, 3, out[0..<2]); }
  #assert n == 2 && out[0] == 3 && out[1] == 2 && out[2] == 99;
  n = 0; for i: 0..<4 { n = ns_store_insert(s[..], 3 - i, n, -1, out[..]); }
  #assert n == 0;
}

// ---- the admission lookups (#12631) --------------------------------------------
#test "the lookup hashes: an id's first seven bytes; an address's kind, author and (addressable only) d" {
  id: [32] u8; id[0] = 1; id[6] = 2; id[7] = 99; id[31] = 7;
  #assert ns_id_hash(id) == 281474976710658;
  for k: 0..<32 { id[k] = 255; }
  #assert ns_id_hash(id) == 72057594037927935;
  // Python: h = kind; h = (h*257 + b) % (2**31-1) over the author, then (h*257 + b + 1) % P over d
  author: [32] u8; author[0] = 1; author[31] = 2; d: [256] u8; d[0] = 'a'; d[1] = 'b';
  #assert ns_address_hash(30023, author, d, 2) == 738669570;
  #assert ns_address_hash(0, author, d, 2) == 1413567272 && ns_address_hash(0, author, d, 0) == 1413567272;
  for k: 0..<32 { author[k] = 255; } d[0] = 255; d[1] = 255; d[2] = 255;
  #assert ns_address_hash(65535, author, d, 3) == 314152622 && ns_address_hash(39999, author, d, 3) == 946229052;
}
// A store over arena and recs with lookups of the given lengths.
NssT :: struct { arena: [64] u8; recs: [6] RsdRec; ids: [7] int; addrs: [7] int; s: [1] RsdStore; }
nss_t_store :: (t: [] NssT, ids: int, addrs: int) -> [] RsdStore {
  t[0].s[0] = RsdStore.{arena = t[0].arena[..], recs = t[0].recs[..], ids = t[0].ids[0..<ids], addrs = t[0].addrs[0..<addrs]};
  return t[0].s[..];
}
#test "the lookups: each slot read counted, collisions probe on, the last slot wraps to the first" {
  t: [1] NssT; s := nss_t_store(t[..], 7, 7);
  #assert ns_indexed(s);
  // kind 0 by author 1 and by author 4 hash to address slot 3 (mod 7)
  c1 := nss_t_rec(0, 0, 10); c1.id[6] = 1; c1.author[0] = 1;
  #assert ns_store_admit(s, c1, "x", true) == NSS_ACCEPT && s[0].probes == 4 && t[0].ids[1] == 1 && t[0].addrs[3] == 1;
  c2 := nss_t_rec(0, 0, 10); c2.id[6] = 2; c2.author[0] = 4;
  #assert ns_store_admit(s, c2, "x", true) == NSS_ACCEPT && s[0].probes == 10 && t[0].ids[2] == 2 && t[0].addrs[4] == 2;
  // id 9 hashes to slot 2 (taken: on to 3); its address is c2's (slot 3, then 4)
  c3 := c2; c3.id[6] = 9; c3.created = 11;
  #assert ns_store_admit(s, c3, "x", true) == NSS_ACCEPT && s[0].probes == 18;
  #assert t[0].ids[3] == 3 && t[0].addrs[3] == 1 && t[0].addrs[4] == 3 && !s[0].recs[1].live && s[0].recs[2].live;
  // an older version at c3's address: superseded, found through slot 4
  c4 := c2; c4.id[6] = 3; c4.created = 9;
  #assert ns_store_plan(s, c4, "x", true).result == NSS_SUPERSEDED && s[0].probes == 22;
  // slot 6, then a collision there wraps to slot 0
  c5 := nss_t_rec(0, 1, 10); c5.id[6] = 6;
  #assert ns_store_admit(s, c5, "x", true) == NSS_ACCEPT && s[0].probes == 24 && t[0].ids[6] == 4;
  c6 := nss_t_rec(0, 1, 10); c6.id[6] = 13;
  #assert ns_store_admit(s, c6, "x", true) == NSS_ACCEPT && s[0].probes == 28 && t[0].ids[0] == 5;
  // the same event again: found at slot 0 after slot 6, a duplicate
  #assert ns_store_plan(s, c6, "x", true).result == NSS_DUP && s[0].probes == 30;
  // c2 again: its id is known, its record retired: a duplicate
  #assert ns_store_plan(s, c2, "x", true).result == NSS_DUP;
}
#test "without both lookups longer than recs, admission scans" {
  t: [1] NssT;
  for n: [3] int.[6, 7, 5] {
    s := nss_t_store(t[..], n, ifx n == 7 then 6 else n);
    #assert !ns_indexed(s);
    c := nss_t_rec(1, 0, 10);
    #assert ns_store_admit(s, c, "x", true) == NSS_ACCEPT && ns_store_admit(s, c, "x", true) == NSS_DUP && s[0].probes == 0;
    for k: 0..<7 { #assert t[0].ids[k] == 0 && t[0].addrs[k] == 0; }
  }
  s := nss_t_store(t[..], 7, 7);
  #assert ns_indexed(s) && ns_store_admit(s, nss_t_rec(1, 1, 10), "x", true) == NSS_ACCEPT && s[0].probes == 2;
  // a compaction without lookups leaves the (absent) tables alone
  u: [1] NssT; v := nss_t_store(u[..], 0, 0);
  for k: 0..<6 { #assert ns_store_admit(v, nss_t_rec(cast(u8) (k + 1), 1, 10), "x", true) == NSS_ACCEPT; }
  #assert ns_store_admit(v, nss_t_rec(9, 1, 11), "x", true) == NSS_FULL && v[0].n == 6 && v[0].probes == 0;
}
#test "the random check's events: the fields each id carries" {
  // Python, the same rule: sums of each field times (v + 1) over v 0 to 63
  s: [7] int;
  for v: 0..<64 {
    c := nss_t_of(v); w := v + 1;
    #assert c.id[0] == cast(u8) v;
    s[0] += c.kind * w; s[1] += c.created * w; s[2] += cast(int) c.id[6] * w; s[3] += cast(int) c.author[0] * w;
    s[4] += cast(int) c.d[0] * w; s[5] += c.d_n * w; s[6] += c.expiry * w;
  }
  #assert s[0] == 15854272 && s[1] == 29360 && s[2] == 2058 && s[3] == 1104 && s[4] == 51512 && s[5] == 528 && s[6] == 1787;
}
#test "the lookups find record 0: a duplicate, a retired id, a head" {
  t: [1] NssT; s := nss_t_store(t[..], 7, 7);
  c := nss_t_rec(1, 0, 10); #assert ns_store_admit(s, c, "x", true) == NSS_ACCEPT;
  p := ns_store_plan(s, c, "w", true); #assert p.result == NSS_DUP && p.write == NS_W_INPLACE && p.at == 0;
  n := c; n.id[0] = 0; n.created = 11;
  p = ns_store_plan(s, n, "y", true); #assert p.result == NSS_ACCEPT && p.write == NS_W_APPEND && p.at == 0;
  #assert ns_store_apply(s, p, n, "y") == NSS_ACCEPT && !s[0].recs[0].live;
  p = ns_store_plan(s, c, "w", true); #assert p.result == NSS_DUP && p.write == NS_W_NONE;
}
// A larger store for the random check: arena and record table both fill.
NssR :: struct { arena: [36] u8; recs: [16] RsdRec; ids: [17] int; addrs: [17] int; s: [1] RsdStore; }
nss_t_big :: (t: [] NssR, indexed: bool) -> [] RsdStore {
  n := ifx indexed then 17 else 0;
  t[0].s[0] = RsdStore.{arena = t[0].arena[..], recs = t[0].recs[..], ids = t[0].ids[0..<n], addrs = t[0].addrs[0..<n]};
  return t[0].s[..];
}
// The fields an id carries (the same id always carries the same event).
nss_t_of :: (v: int) -> RsdRec {
  kinds := [4] int.[1, 0, 30023, 3];
  c := nss_t_rec(cast(u8) v, kinds[v % 4], 10 + v % 5 + v / 16);
  c.id[6] = cast(u8) (v % 3); c.author[0] = cast(u8) ((v / 4) % 2);
  if c.kind == 30023 { c.d[0] = cast(u8) ('a' + (v / 8) % 2); c.d_n = 1; }
  if c.kind == 1 && v % 3 != 1 { c.expiry = 8 + v % 8; }
  return c;
}
#test "the lookups decide exactly as the scan: random admissions, replacements, expiry and compactions" #steps 400000000 {
  ta: [1] NssR; a := nss_t_big(ta[..], true);
  tb: [1] NssR; b := nss_t_big(tb[..], false);
  texts := [5] string.["a", "bb", "ab", "ccc", "b"];
  seed := 12631; seen := 0;
  for step: 0..<3000 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    x := seed >> 8;
    if x % 11 == 0 { t := step / 150 + x / 11 % 3; #assert ns_store_seen(a, t) == ns_store_seen(b, t); continue; }
    c := nss_t_of(x % 64);
    text := texts[(x / 64) % 5];
    ok := (x / 320) % 50 != 0;
    pa := ns_store_plan(a, c, text, ok); pb := ns_store_plan(b, c, text, ok);
    #assert pa.result == pb.result && pa.write == pb.write && pa.at == pb.at;
    #assert ns_store_apply(a, pa, c, text) == ns_store_apply(b, pb, c, text);
    #assert a[0].n == b[0].n && a[0].used == b[0].used && a[0].live == b[0].live && a[0].bytes == b[0].bytes;
    for i: 0..<a[0].n {
      #assert a[0].recs[i].live == b[0].recs[i].live && a[0].recs[i].id[0] == b[0].recs[i].id[0] && rsd_text(a, i) == rsd_text(b, i);
      // every record's id finds the latest record with it
      j := ns_find_id(a, a[0].recs[i].id);
      #assert j >= i && a[0].recs[j].id[0] == a[0].recs[i].id[0];
    }
    if pa.write != NS_W_NONE { seen += 1; }
  }
  #assert seen > 150 && a[0].probes > 3000 && b[0].probes == 0 && b[0].ids.count == 0 && b[0].addrs.count == 0;
}

rsd_text :: (s: [] RsdStore, i: int) -> string { return cast(string) s[0].arena[s[0].recs[i].from..<s[0].recs[i].to]; }
ns_store_same_address :: (a: RsdRec, b: RsdRec) -> bool {
  if a.kind != b.kind || !ns_equal32(a.author, b.author) { return false; }
  if ns_class(a.kind) != NS_ADDRESSABLE { return true; }
  if a.d_n != b.d_n { return false; }
  for k: 0..<a.d_n { if a.d[k] != b.d[k] { return false; } }
  return true;
}
// Newest first, then lowest id (NIP-01).
ns_store_newer :: (a: RsdRec, b: RsdRec) -> bool { return a.created > b.created || (a.created == b.created && ns_before(a.id, b.id)); }
// Records the latest query time; expired regular events go at compaction.
ns_store_seen :: (s: [] RsdStore, now: int) -> bool { if now > s[0].now { s[0].now = now; return true; } return false; }
ns_store_visible :: (s: [] RsdStore, i: int, now: int) -> bool { return s[0].recs[i].live && !ns_expired(s[0].recs[i].expiry, now); }
// Moves every kept record's original down to close the gaps, in index order
// (which is arena order: a record's bytes never move up). Replaced records
// and expired regular events are dropped. keep is a record index; the
// result is its new index, or -1 when it was dropped.
ns_store_compact :: (s: [] RsdStore, keep: int) -> int {
  j := 0; at := 0; moved := -1;
  for i: 0..<s[0].n {
    r := s[0].recs[i];
    if !r.live || (ns_class(r.kind) == NS_ORDINARY && ns_expired(r.expiry, s[0].now)) {
      if r.live { s[0].live -= 1; s[0].bytes -= r.to - r.from; }
      continue;
    }
    shift := r.from - at;
    for k: r.from..<r.to { s[0].arena[k - shift] = s[0].arena[k]; }
    r.from -= shift; r.to -= shift; r.tags_from -= shift; r.tags_to -= shift;
    s[0].recs[j] = r;
    if i == keep { moved = j; }
    at = r.to; j += 1;
  }
  s[0].n = j; s[0].used = at;
  ns_store_reindex(s);
  return moved;
}
// Room for one more record of need bytes, compacting when the table or the
// arena is full; keep is tracked through the compaction.
ns_store_room :: (s: [] RsdStore, need: int, keep: int) -> NsRoom {
  if s[0].n < s[0].recs.count && need <= s[0].arena.count - s[0].used { return NsRoom.{ok = true, keep = keep}; }
  k := ns_store_compact(s, keep);
  return NsRoom.{ok = s[0].n < s[0].recs.count && need <= s[0].arena.count - s[0].used, keep = k};
}
// Appends c with original text as a live record at index n.
ns_store_append :: (s: [] RsdStore, c: RsdRec, text: string) {
  from := s[0].used;
  for i: 0..<text.count { s[0].arena[from + i] = text[i]; }
  r := c; r.live = true; r.from = from; r.to = from + text.count;
  r.tags_from = from + c.tags_from; r.tags_to = from + c.tags_to;
  s[0].recs[s[0].n] = r; s[0].n += 1; s[0].used += text.count; s[0].live += 1; s[0].bytes += text.count;
  if ns_indexed(s) { ns_note(s, s[0].n - 1); }
}
// Retires live record i.
ns_store_retire :: (s: [] RsdStore, i: int) {
  s[0].recs[i].live = false; s[0].live -= 1; s[0].bytes -= s[0].recs[i].to - s[0].recs[i].from;
}
// The same verified id again: keep the lowest exact original (#f539). A
// lower one no longer than the stored one is written over it; a longer one
// is appended (from c: the same id carries the same fields) and the old
// record retired, or refused (the old one kept) when it does not fit.
// Neither charges another record. Record i is live. Always NSS_DUP.
ns_store_duplicate :: (s: [] RsdStore, i: int, text: string) -> NsPlan {
  if !ns_original_before(text, rsd_text(s, i)) { return NsPlan.{result = NSS_DUP}; }
  if text.count <= s[0].recs[i].to - s[0].recs[i].from { return NsPlan.{result = NSS_DUP, write = NS_W_INPLACE, at = i}; }
  room := ns_store_room(s, text.count, i);
  if !room.ok || room.keep < 0 { return NsPlan.{result = NSS_DUP}; }
  return NsPlan.{result = NSS_DUP, write = NS_W_APPEND, at = room.keep};
}
// ---- the admission lookups (RsdStore's ids and addrs, #12631) ----------------
NS_HASH_P :: 2147483647;   // 2^31 - 1, a prime: h * 257 + 256 stays below 2^40
// Whether s has both lookups, as long as each other and longer than recs
// (so a free slot always remains).
ns_indexed :: (s: [] RsdStore) -> bool { return s[0].ids.count > s[0].recs.count && s[0].addrs.count == s[0].ids.count; }
// An id's hash: its first seven bytes (an id is a SHA-256 digest).
ns_id_hash :: (id: [32] u8) -> int {
  h := 0;
  for k: 0..<7 { h = h * 256 + cast(int) id[k]; }
  return h;
}
// An address's hash over what ns_store_same_address compares: kind and
// author, and d when the kind is addressable. kind is 0 to 65535.
ns_address_hash :: (kind: int, author: [32] u8, d: [256] u8, d_n: int) -> int {
  h := kind;
  for k: 0..<32 { h = (h * 257 + cast(int) author[k]) % NS_HASH_P; }
  if ns_class(kind) == NS_ADDRESSABLE { for k: 0..<d_n { h = (h * 257 + cast(int) d[k] + 1) % NS_HASH_P; } }
  return h;
}
// The ids slot holding the latest record with id, or the empty slot where
// it would go (linear probing; nothing is ever removed but by a rebuild).
ns_id_slot :: (s: [] RsdStore, id: [32] u8) -> int {
  at := ns_id_hash(id) % s[0].ids.count;
  s[0].probes += 1;
  while s[0].ids[at] != 0 && !ns_equal32(s[0].recs[s[0].ids[at] - 1].id, id) {
    at = (at + 1) % s[0].ids.count; s[0].probes += 1;
  }
  return at;
}
// The addrs slot holding the latest record at c's address, or the empty one.
ns_address_slot :: (s: [] RsdStore, c: RsdRec) -> int {
  at := ns_address_hash(c.kind, c.author, c.d, c.d_n) % s[0].addrs.count;
  s[0].probes += 1;
  while s[0].addrs[at] != 0 && !ns_store_same_address(s[0].recs[s[0].addrs[at] - 1], c) {
    at = (at + 1) % s[0].addrs.count; s[0].probes += 1;
  }
  return at;
}
// The latest record with id, or at c's address: its index, or -1.
ns_find_id :: (s: [] RsdStore, id: [32] u8) -> int { return s[0].ids[ns_id_slot(s, id)] - 1; }
ns_find_address :: (s: [] RsdStore, c: RsdRec) -> int { return s[0].addrs[ns_address_slot(s, c)] - 1; }
// Notes record i as the latest with its id, and at its address when its
// kind has one.
ns_note :: (s: [] RsdStore, i: int) {
  r := s[0].recs[i];
  s[0].ids[ns_id_slot(s, r.id)] = i + 1;
  if ns_class(r.kind) != NS_ORDINARY { s[0].addrs[ns_address_slot(s, r)] = i + 1; }
}
// Rebuilds both lookups over the records, in index order (after a
// compaction renumbered them).
ns_store_reindex :: (s: [] RsdStore) {
  if !ns_indexed(s) { return; }
  for k: 0..<s[0].ids.count { s[0].ids[k] = 0; s[0].addrs[k] = 0; }
  for i: 0..<s[0].n { ns_note(s, i); }
}

// Decides one event's admission without storing it. verified is the
// caller's signature check over this exact text (id recomputed from it,
// signature checked against it); c holds the fields read from it, with
// tags_from/tags_to relative to text. Ephemeral kinds are accepted and not
// stored. Deciding may compact s, which changes indexes but not what the
// store holds. A plan that writes (write != NS_W_NONE) puts text in the
// store when applied: that is what a durable log records, before applying.
ns_store_plan :: (s: [] RsdStore, c: RsdRec, text: string, verified: bool) -> NsPlan {
  if !verified { return NsPlan.{result = NSS_UNVERIFIED}; }
  if text.count < 1 || c.d_n < 0 || c.d_n > 256 || c.tags_from < 0 || c.tags_from > c.tags_to || c.tags_to > text.count { return NsPlan.{result = NSS_BAD}; }
  class := ns_class(c.kind);
  if class == NS_EPHEMERAL { return NsPlan.{result = NSS_ACCEPT}; }
  known := false; head := -1;
  if ns_indexed(s) {
    // the latest record with this id is the only one that can be live, and
    // the latest at this address the only live head (RsdStore)
    i := ns_find_id(s, c.id);
    if i >= 0 && s[0].recs[i].live { return ns_store_duplicate(s, i, text); }
    known = i >= 0;
    a := ifx class != NS_ORDINARY then ns_find_address(s, c) else -1;
    if a >= 0 && s[0].recs[a].live { head = a; }
  } else {
    for i: 0..<s[0].n {
      if ns_equal32(s[0].recs[i].id, c.id) {
        if s[0].recs[i].live { return ns_store_duplicate(s, i, text); }
        known = true; continue;
      }
      if class != NS_ORDINARY && s[0].recs[i].live && ns_store_same_address(s[0].recs[i], c) { head = i; }
    }
  }
  if known { return NsPlan.{result = NSS_DUP}; }
  if head >= 0 && !ns_store_newer(c, s[0].recs[head]) { return NsPlan.{result = NSS_SUPERSEDED}; }
  room := ns_store_room(s, text.count, head);
  if !room.ok { return NsPlan.{result = NSS_FULL}; }
  return NsPlan.{result = NSS_ACCEPT, write = NS_W_APPEND, at = room.keep};
}
// Carries out p, the plan ns_store_plan just made for c and text on this
// store (nothing may change the store in between): the result.
ns_store_apply :: (s: [] RsdStore, p: NsPlan, c: RsdRec, text: string) -> int {
  if p.write == NS_W_INPLACE {
    r := s[0].recs[p.at];
    for k: 0..<text.count { s[0].arena[r.from + k] = text[k]; }
    s[0].bytes -= r.to - r.from - text.count;
    s[0].recs[p.at].to = r.from + text.count;
    s[0].recs[p.at].tags_from = r.from + c.tags_from; s[0].recs[p.at].tags_to = r.from + c.tags_to;
  }
  if p.write == NS_W_APPEND {
    ns_store_append(s, c, text);
    if p.at >= 0 { ns_store_retire(s, p.at); }
  }
  return p.result;
}
// Decides and applies one admission (an in-memory store with no log).
ns_store_admit :: (s: [] RsdStore, c: RsdRec, text: string, verified: bool) -> int {
  return ns_store_apply(s, ns_store_plan(s, c, text, verified), c, text);
}
// Puts record i into out[0..<n], kept newest first, then lowest id, and at
// most limit long (and at most out.count): the new length.
ns_store_insert :: (s: [] RsdStore, i: int, n: int, limit: int, out: [] int) -> int {
  at := n;
  while at > 0 && ns_store_newer(s[0].recs[i], s[0].recs[out[at - 1]]) { at -= 1; }
  if at >= limit || at >= out.count { return n; }
  full := n >= limit || n >= out.count;
  k := n; if full { k = n - 1; }
  while k > at { out[k] = out[k - 1]; k -= 1; }
  out[at] = i;
  if full { return n; }
  return n + 1;
}
