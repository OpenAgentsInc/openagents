// The verified store with its append-only file (nostr-event-store #8eb5).
// rsd_admit_saved decides an admission (store_core's ns_store_plan), writes
// the original to the file and syncs it when the decision stores bytes, and
// only then applies it, so the file holds everything the store holds. A
// failed write applies nothing and answers RS_FULL ("error: ..."). On start,
// rsd_replay reads the file, re-reads and re-verifies every original exactly
// as live admission does (except that an event expired since it was stored
// is kept, store_file.coax), re-admits it, and cuts a torn or bad tail off
// the file. The framing and replay rules are store_file.coax's (#authority);
// this file is the glue to the C effects in coax/platform/store-file-native.c
// (the host calls cxstore_set_path first, and holds an exclusive lock on the
// file). Not trusted recovery (#966b): an older copy of the file replays as
// a valid, older store.
#load "store.coax";
#load "store_file.coax";

cxstore_load :: () -> int #foreign;
cxstore_byte :: (i: int) -> int #foreign;
cxstore_put :: (b: int) -> int #foreign;
cxstore_commit :: () -> int #foreign;
cxstore_truncate :: (n: int) -> int #foreign;

RsdReplay :: struct { ok: bool; frames: int; stored: int; refused: int; kept: int; cut: bool; }

#test "the file's reasons are the relay's" {
  #assert NSF_RS_ACCEPT == RS_ACCEPT && NSF_RS_EXPIRED == RS_EXPIRED;
}
#test "replay reads like admission, but keeps events expired since" {
  scratch: [4096] u8;
  #assert rsd_replay_read(RST_EXPIRED, 1000, scratch[..]).reason == RS_ACCEPT;
  #assert rsd_replay_read(RST_EXPIRED, 1000, scratch[..]).expiration == 1000;
  #assert rsd_replay_read(RST_PLAIN, 1000, scratch[..]).reason == RS_ACCEPT;
  #assert rsd_replay_read(RST_FUTURE, 1000, scratch[..]).reason == RS_TIME;
  #assert rsd_replay_read(RST_AUTH, 1000, scratch[..]).reason == RS_AUTH_KIND;
  #assert rsd_replay_read("{}", 1000, scratch[..]).reason == RS_BAD_EVENT;
}
#test "a saved admission frames exactly the original" {
  out: [16] u8;
  #assert rsd_frame("abc", out[..]) == 7 && out[3] == 3 && cast(string) out[4..<7] == "abc";
  #assert rsd_frame("", out[..]) == -1 && rsd_frame("abcdefghijklm", out[..]) == -1;
}

// Reads text as admission does, at time now, mapping its reason by replay's
// rule. The caller still verifies the signature.
rsd_replay_read :: (text: string, now: int, scratch: [] u8) -> RsAdmit {
  r := rs_admit_read(text, now, false, false, scratch);
  r.reason = ns_file_replay_reason(r.reason);
  return r;
}
// text's frame (header and bytes) in out: its length, or -1.
rsd_frame :: (text: string, out: [] u8) -> int {
  if out.count < 4 + text.count || !ns_file_header(text.count, out[0..<4]) { return -1; }
  for i: 0..<text.count { out[4 + i] = text[i]; }
  return 4 + text.count;
}
// Appends text's frame to the file and syncs it: whether it is there.
rsd_save :: (text: string) -> bool {
  head: [4] u8;
  if !ns_file_header(text.count, head[..]) { return false; }
  for i: 0..<4 { if cxstore_put(cast(int) head[i]) != 0 { return false; } }
  for i: 0..<text.count { if cxstore_put(cast(int) text[i]) != 0 { return false; } }
  return cxstore_commit() == 0;
}
// rsd_admit, saving what it stores to the file before storing it.
rsd_admit_saved :: (s: [] RsdStore, r: RsAdmit, text: string) -> int {
  c := rsd_rec(r);
  p := ns_store_plan(s, c, text, rsd_verified(r, text));
  if p.write != NS_W_NONE && !rsd_save(text) { return RS_FULL; }
  return ns_store_apply(s, p, c, text);
}
// Rebuilds s from the file at time now. text holds one original
// (NS_FRAME_MAX_ORIGINAL bytes); scratch is the verifier's (the relay's
// 262144). ok is false when the file cannot be read or cut.
rsd_replay :: (s: [] RsdStore, now: int, text: [] u8, scratch: [] u8) -> RsdReplay {
  out: RsdReplay;
  total := cxstore_load();
  if total < 0 { return out; }
  at := 0;
  while true {
    head: [4] u8; k := 0;
    while k < 4 && at + k < total { head[k] = cast(u8) cxstore_byte(at + k); k += 1; }
    f := ns_file_next(head[0..<k], at, total);
    if f.status == NSF_END { break; }
    if f.status != NSF_OK || f.to - f.from > text.count {
      out.cut = true;
      if cxstore_truncate(at) != 0 { return out; }
      break;
    }
    for i: f.from..<f.to { text[i - f.from] = cast(u8) cxstore_byte(i); }
    t := cast(string) text[0..<f.to - f.from];
    out.frames += 1;
    r := rsd_replay_read(t, now, scratch);
    if r.reason == RS_ACCEPT { r = rs_admit_verified(r, nostr_event_verify_vartime(t, scratch, false)); }
    reason := r.reason;
    if reason == RS_ACCEPT { reason = rsd_admit(s, r, t); }
    if reason == RS_ACCEPT { out.stored += 1; }
    else if reason == RS_DUP || reason == RS_SUPERSEDED { out.kept += 1; }
    else { out.refused += 1; }
    at = f.to;
  }
  out.ok = true;
  return out;
}
