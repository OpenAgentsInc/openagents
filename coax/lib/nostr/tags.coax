// NIP-01's standard tags read from a parsed event: e (an event), p (a
// pubkey), a (a replaceable or addressable event's address) and d (the
// address identifier). A typed tag is a reading of the signed tags, not
// evidence that the referenced event, pubkey or relay exists or is trusted.
#load "event.coax";
#load "store_policy.coax";
#authority;

NT_OK :: 0; NT_EVENT :: 1; NT_INDEX :: 2; NT_SHAPE :: 3; NT_HEX :: 4;
NT_RELAY :: 5; NT_ADDRESS :: 6; NT_LIMIT :: 7;
NT_OTHER :: 0; NT_E :: 1; NT_P :: 2; NT_A :: 3; NT_D :: 4;
// NIP-10 markers an e tag may carry in its fourth position.
NT_MARK_NONE :: 0; NT_MARK_ROOT :: 1; NT_MARK_REPLY :: 2; NT_MARK_MENTION :: 3;
NT_MAX_VALUE :: 256;

NostrTag :: struct {
  error:int=NT_SHAPE; type:int; values:int;
  id:[32]u8;                         // e: the event
  pubkey:[32]u8;                     // p: the user; a: the address's author
  has_author:bool; author:[32]u8;    // e: the referenced event's author
  marker:int;                        // e: NIP-10 marker
  has_relay:bool; relay:[NT_MAX_VALUE]u8; relay_n:int;
  address_kind:int;                  // a: the address's kind
  d:[NT_MAX_VALUE]u8; d_n:int;       // a and d: the identifier, decoded
}

#load "../../tests/nostr/tags_fixtures.coax";

#test "the captured project event's a and d tags read as an address" {
  e:=ne_parse(NT_PROJECT_EVENT);#assert e.error==NE_OK && e.tags==NT_PROJECT_TAGS;
  d:=nostr_tag_d(e);#assert d.error==NT_OK && d.type==NT_D && cast(string)d.d[0..<d.d_n]=="coax";
  a:=nostr_tag(e,1);#assert a.error==NT_OK && a.type==NT_A && a.address_kind==30621 && a.pubkey[0]==0x9e && a.pubkey[31]==0x75;
  #assert cast(string)a.d[0..<a.d_n]=="coax" && a.has_relay && cast(string)a.relay[0..<a.relay_n]=="wss://relay.openagents.com";
  other:=nostr_tag(e,2);#assert other.error==NT_OK && other.type==NT_OTHER && other.values==3;
  #assert nostr_tag(e,e.tags).error==NT_INDEX && nostr_tag(e,-1).error==NT_INDEX;
}
#test "e tags: id, optional relay, optional author or NIP-10 marker" {
  e:=nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"wss://nostr.example.com\"]]");
  t:=nostr_tag(e,0);#assert t.error==NT_OK && t.type==NT_E && t.id[0]==0x5c && t.id[31]==0x36 && t.has_relay && !t.has_author && t.values==3;
  e=nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\"]]");
  t=nostr_tag(e,0);#assert t.error==NT_OK && !t.has_relay && t.relay_n==0;
  e=nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"\",\"f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca\"]]");
  t=nostr_tag(e,0);#assert t.error==NT_OK && !t.has_relay && t.has_author && t.author[0]==0xf7 && t.marker==NT_MARK_NONE;
  e=nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"\",\"reply\",\"f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca\"]]");
  t=nostr_tag(e,0);#assert t.error==NT_OK && t.marker==NT_MARK_REPLY && t.has_author && t.author[31]==0xca;
  e=nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"\",\"root\"]]");
  t=nostr_tag(e,0);#assert t.error==NT_OK && t.marker==NT_MARK_ROOT && !t.has_author;
  e=nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"\",\"mention\",\"\"]]");
  t=nostr_tag(e,0);#assert t.error==NT_OK && t.marker==NT_MARK_MENTION && !t.has_author;
  e=nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"\",\"\"]]");
  t=nostr_tag(e,0);#assert t.error==NT_OK && !t.has_author;
  #assert nostr_tag(nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"\",\"quote\"]]"),0).error==NT_HEX;
  #assert nostr_tag(nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"\",\"reply\",\"x\"]]"),0).error==NT_HEX;
  #assert nostr_tag(nt_event("[[\"e\",\"5C83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\"]]"),0).error==NT_HEX;
  #assert nostr_tag(nt_event("[[\"e\",\"5c83\"]]"),0).error==NT_HEX && nostr_tag(nt_event("[[\"e\"]]"),0).error==NT_SHAPE;
  #assert nostr_tag(nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"https://x\"]]"),0).error==NT_RELAY;
  #assert nostr_tag(nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"x\"]]"),0).error==NT_RELAY;
  t=nostr_tag(nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"\",\"root\",\"f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca\"]]"),0);#assert t.error==NT_OK && t.marker==NT_MARK_ROOT && t.has_author && t.author[0]==0xf7;
  t=nostr_tag(nt_event("[[\"d\",\"x\",\"not a relay\"]]"),0);#assert t.error==NT_OK && t.type==NT_D && !t.has_relay && t.values==3 && cast(string)t.d[0..<t.d_n]=="x";
  #assert nostr_tag(nt_event("[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"\",\"x\"]]"),0).error==NT_HEX;
  t=nostr_tag(nt_event("[[\"p\",\"f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca\",\"\",\"name\",\"y\"]]"),0);#assert t.error==NT_OK && t.values==5 && !t.has_author;
}
#test "p tags: pubkey and optional relay; later values are other NIPs'" {
  e:=nt_event("[[\"p\",\"f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca\"],[\"p\",\"f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca\",\"ws://r.example\",\"petname\"]]");
  t:=nostr_tag(e,0);#assert t.error==NT_OK && t.type==NT_P && t.pubkey[0]==0xf7 && !t.has_relay;
  t=nostr_tag(e,1);#assert t.error==NT_OK && t.has_relay && cast(string)t.relay[0..<t.relay_n]=="ws://r.example" && t.values==4;
  #assert nostr_tag(nt_event("[[\"p\",\"\"]]"),0).error==NT_HEX && nostr_tag(nt_event("[[\"p\"]]"),0).error==NT_SHAPE;
  #assert nostr_tag(nt_event("[[\"p\",\"f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca\",\"wss:/\"]]"),0).error==NT_RELAY;
  #assert nostr_tag(nt_event("[[\"p\",\"f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca\",\"wss://\"]]"),0).error==NT_RELAY;
}
#test "a tags: addressable needs kind 30000..39999, replaceable an empty identifier" {
  pk:="f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca";
  t:=nt_address("30023:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:abcd");
  #assert t.error==NT_OK && t.address_kind==30023 && cast(string)t.d[0..<t.d_n]=="abcd" && t.pubkey[0]==0xf7;
  t=nt_address("30023:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:a:b:");
  #assert t.error==NT_OK && cast(string)t.d[0..<t.d_n]=="a:b:";
  #assert nt_address("30023:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:").error==NT_OK;
  t=nt_address("10002:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:");#assert t.error==NT_OK && t.address_kind==10002 && t.d_n==0;
  #assert nt_address("0:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:").error==NT_OK;
  #assert nt_address("3:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:").error==NT_OK;
  #assert nt_address("10002:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:x").error==NT_ADDRESS;
  #assert nt_address("10002:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca").error==NT_ADDRESS;
  #assert nt_address("1:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:").error==NT_ADDRESS;
  #assert nt_address("20000:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:").error==NT_ADDRESS;
  #assert nt_address("030023:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:x").error==NT_LIMIT;
  #assert nt_address("70000:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:x").error==NT_ADDRESS;
  #assert nt_address("123456:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:x").error==NT_LIMIT;
  #assert nt_address("100000:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:x").error==NT_LIMIT;
  #assert nt_address(":f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:x").error==NT_ADDRESS;
  #assert nt_address("3a023:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:x").error==NT_ADDRESS;
  #assert nt_address("30023:F7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:x").error==NT_HEX;
  #assert nt_address("30023:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9c:x").error==NT_ADDRESS;
  #assert nt_address("30023").error==NT_ADDRESS && nt_address("").error==NT_ADDRESS;
  t=nt_address("39999:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:x");#assert t.error==NT_OK && t.address_kind==39999;
  #assert nt_address("03:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:").error==NT_ADDRESS && nt_address("99999:f7234bd4c1394dda46d09f35bd384dd30cc552ad5541990f98844fb06676e9ca:x").error==NT_ADDRESS;
  #assert pk.count==64;
}
#test "d lookup: the first d tag, empty when absent or valueless" {
  d:=nostr_tag_d(nt_event("[[\"t\",\"x\"],[\"d\",\"first\"],[\"d\",\"second\"]]"));#assert d.error==NT_OK && cast(string)d.d[0..<d.d_n]=="first";
  d=nostr_tag_d(nt_event("[[\"t\",\"x\"]]"));#assert d.error==NT_OK && d.d_n==0 && d.type==NT_D;
  d=nostr_tag_d(nt_event("[[\"d\"]]"));#assert d.error==NT_OK && d.d_n==0;
  d=nostr_tag_d(nt_event("[[\"d\",\"caf\\u00e9\"]]"));#assert d.error==NT_OK && d.d_n==5 && d.d[4]==0xa9;
  d=nostr_tag_d(nt_event("[]"));#assert d.error==NT_OK && d.d_n==0;
  e:NostrEvent;#assert nostr_tag_d(e).error==NT_EVENT && nostr_tag(e,0).error==NT_EVENT;
}
#test "values over the bound and forged spans refuse" {
  long:[300]u8;n:=json_raw(long[..],0,"[[\"d\",\"");for i:0..<257 {long[n+i]='x';}n+=257;n=json_raw(long[..],n,"\"]]");
  #assert nostr_tag_d(nt_event(cast(string)long[0..<n])).error==NT_LIMIT;
  n=json_raw(long[..],0,"[[\"d\",\"");for i:0..<256 {long[n+i]='x';}n+=256;n=json_raw(long[..],n,"\"]]");
  #assert nostr_tag_d(nt_event(cast(string)long[0..<n])).d_n==256;
  // A name over the bound is no standard name; its values still count.
  n=json_raw(long[..],0,"[[\"");for i:0..<257 {long[n+i]='x';}n+=257;n=json_raw(long[..],n,"\",\"v\"]]");
  t:=nostr_tag(nt_event(cast(string)long[0..<n]),0);#assert t.error==NT_OK && t.type==NT_OTHER && t.values==2;
  // Unread values may be over the bound: another tag's values, and a standard tag's past the fifth.
  n=json_raw(long[..],0,"[[\"t\",\"");for i:0..<257 {long[n+i]='x';}n+=257;n=json_raw(long[..],n,"\"]]");
  t=nostr_tag(nt_event(cast(string)long[0..<n]),0);#assert t.error==NT_OK && t.type==NT_OTHER && t.values==2;
  six:[400]u8;n=json_raw(six[..],0,"[[\"e\",\"5c83da77af1dec6d7289834998ad7aafbd9e2191396d75ec3cc27f5a77226f36\",\"\",\"root\",\"\",\"");for i:0..<257 {six[n+i]='x';}n+=257;n=json_raw(six[..],n,"\"]]");
  t=nostr_tag(nt_event(cast(string)six[0..<n]),0);#assert t.error==NT_OK && t.type==NT_E && t.values==6;
  e:=nt_event("[[\"d\",\"x\"]]");e.tags_to=e.original.count+1;#assert nostr_tag(e,0).error==NT_EVENT && nostr_tag_d(e).error==NT_EVENT;
  e=nt_event("[[\"d\",\"x\"]]");e.tags_from= -1;#assert nostr_tag(e,0).error==NT_EVENT;
  e=nt_event("[[\"d\",\"x\"]]");e.tags_from=3;e.tags_to=2;#assert nostr_tag(e,0).error==NT_EVENT;
  j:[1]Json;#assert !nt_start(j[..],e) && nt_start(j[..],nt_event("[]"));
  e=nt_event("[[\"d\",\"x\"]]");e.error=NE_ID;#assert nostr_tag(e,0).error==NT_EVENT;
  e=nt_event("[[\"d\",\"x\"]]");e.original="[[1]]";e.tags_from=0;e.tags_to=5;#assert nostr_tag(e,0).error==NT_EVENT && nostr_tag_d(e).error==NT_EVENT;
  e.original="{}";e.tags_to=2;#assert nostr_tag(e,0).error==NT_EVENT && nostr_tag_d(e).error==NT_EVENT;
  e.original="[1]";e.tags_to=3;#assert nostr_tag_d(e).error==NT_EVENT && nostr_tag(e,0).error==NT_EVENT;
  e.original="[[]]";e.tags_to=4;#assert nostr_tag(e,0).error==NT_SHAPE && nostr_tag(e,0).values==0;
}
#forall "relay URLs need a ws:// or wss:// scheme and a host" c:0..<256 {
  buf:[7]u8;buf[0]='w';buf[1]='s';buf[2]=':';buf[3]='/';buf[4]='/';buf[5]=cast(u8)c;buf[6]='x';
  #assert nt_relay_ok(cast(string)buf[..]);#assert nt_relay_ok(cast(string)buf[0..<6]);
  buf[0]=cast(u8)c;#assert nt_relay_ok(cast(string)buf[..])==(c=='w');
  #assert !nt_relay_ok(cast(string)buf[0..<5]);
}
#test "relay scheme and host checks" {
  #assert nt_relay_ok("wss://a") && nt_relay_ok("ws://a") && !nt_relay_ok("ws://") && !nt_relay_ok("wss://");
  #assert !nt_relay_ok("wsx://a") && !nt_relay_ok("ws:/a") && !nt_relay_ok("wss:/a") && !nt_relay_ok("wss:a") && !nt_relay_ok("w");
  #assert !nt_relay_ok("xs://a") && !nt_relay_ok("wx://a") && !nt_relay_ok("ws;//a") && !nt_relay_ok("ws:x/a") && !nt_relay_ok("wssx//a");
}

// A parsed event with only these tags, for checks.
nt_event :: (tags:string)->NostrEvent {
  e:NostrEvent;e.error=NE_OK;e.original=tags;e.tags_to=tags.count;return e;
}
// An a tag's value checked through the full tag path.
nt_address :: (value:string)->NostrTag {
  buf:[512]u8;n:=json_raw(buf[..],0,"[[\"a\",");n=json_write_string(buf[..],n,value);n=json_raw(buf[..],n,"]]");
  return nostr_tag(nt_event(cast(string)buf[0..<n]),0);
}
nt_fail :: (t:NostrTag,error:int)->NostrTag {r:=t;r.error=error;return r;}
nt_relay_ok :: (s:string)->bool {
  if s.count>=6 && s[0..<5]=="ws://" {return true;}
  return s.count>=7 && s[0..<6]=="wss://";
}
nt_marker :: (s:string)->int {
  if s=="root" {return NT_MARK_ROOT;}if s=="reply" {return NT_MARK_REPLY;}if s=="mention" {return NT_MARK_MENTION;}
  return NT_MARK_NONE;
}
// The address "kind:pubkey:d" with the kind's replacement rule. A sixth
// digit is over the bound (NT_LIMIT); a kind over 65535 has no replaceable
// or addressable class.
nt_read_address :: (t:NostrTag,s:string)->NostrTag {
  r:=t;i:=0;kind:=0;
  while i<s.count && s[i]>='0' && s[i]<='9' {
    if i==5 {return nt_fail(r,NT_LIMIT);}
    kind=kind*10+cast(int)(s[i]-'0');i+=1;
  }
  if i==0 || i>=s.count || s[i]!=':' || (s[0]=='0' && i>1) {return nt_fail(r,NT_ADDRESS);}
  if s.count<i+66 || s[i+65]!=':' {return nt_fail(r,NT_ADDRESS);}
  if !ne_lower_hex(s[i+1..<i+65],r.pubkey[..]) {return nt_fail(r,NT_HEX);}
  rest:=s[i+66..<s.count];class:=ns_class(kind);
  if class!=NS_ADDRESSABLE && (class!=NS_REPLACEABLE || rest.count!=0) {return nt_fail(r,NT_ADDRESS);}
  r.address_kind=kind;for k:0..<rest.count {r.d[k]=rest[k];}r.d_n=rest.count;return r;
}
// The event's tag array, or false when the record or its span is forged.
nt_start :: (j:[]Json,e:NostrEvent)->bool {
  if e.error!=NE_OK || e.tags_from<0 || e.tags_to>e.original.count || e.tags_to-e.tags_from<2 {return false;}
  json_start(j,e.original[e.tags_from..<e.tags_to]);return json_next(j)==JSON_ARRAY;
}
// The index'th tag, read and checked when it is a standard one. Other tags
// report their value count only. Values past those NIP-01 names are kept
// in the signed tags for other NIPs and not checked here.
nostr_tag :: (e:NostrEvent,index:int)->NostrTag #export_c {
  t:NostrTag;j:[1]Json;if !nt_start(j[..],e) {return nt_fail(t,NT_EVENT);}
  k:=0;tok:=json_next(j[..]);
  while tok==JSON_ARRAY && k<index {skipped:=json_skip(j[..]);k+=1;tok=json_next(j[..]);}
  if index<0 || tok==JSON_ARRAY_END {return nt_fail(t,NT_INDEX);}
  if tok!=JSON_ARRAY {return nt_fail(t,NT_EVENT);}
  buf:[NT_MAX_VALUE]u8;
  v:=json_next(j[..]);
  while v!=JSON_ARRAY_END {
    if v!=JSON_STRING {return nt_fail(t,NT_EVENT);}
    at:=t.values;t.values+=1;
    // Only the name and a standard tag's first five values are read; a long
    // name is no standard one, and other values stay unread in the original.
    if at>0 && (t.type==NT_OTHER || at>4) {v=json_next(j[..]);continue;}
    n:=json_unescape(json_text(j[..]),buf[..]);
    if n== -1 && at==0 {v=json_next(j[..]);continue;}
    if n<0 {return nt_fail(t,NT_LIMIT);}
    s:=cast(string)buf[0..<n];
    if at==0 {t.type=ifx s=="e" then NT_E else ifx s=="p" then NT_P else ifx s=="a" then NT_A else ifx s=="d" then NT_D else NT_OTHER;}
    else if at==1 && t.type==NT_E {if !ne_lower_hex(s,t.id[..]) {return nt_fail(t,NT_HEX);}}
    else if at==1 && t.type==NT_P {if !ne_lower_hex(s,t.pubkey[..]) {return nt_fail(t,NT_HEX);}}
    else if at==1 && t.type==NT_A {t=nt_read_address(t,s);if t.error!=NT_SHAPE {return t;}}
    else if at==1 && t.type==NT_D {for c:0..<n {t.d[c]=buf[c];}t.d_n=n;}
    else if at==2 && t.type!=NT_D && t.type!=NT_OTHER && n>0 {
      if !nt_relay_ok(s) {return nt_fail(t,NT_RELAY);}
      t.has_relay=true;for c:0..<n {t.relay[c]=buf[c];}t.relay_n=n;
    }
    else if at==3 && t.type==NT_E && n>0 {
      t.marker=nt_marker(s);
      if t.marker==NT_MARK_NONE {if !ne_lower_hex(s,t.author[..]) {return nt_fail(t,NT_HEX);}t.has_author=true;}
    }
    else if at==4 && t.marker!=NT_MARK_NONE && n>0 {
      if !ne_lower_hex(s,t.author[..]) {return nt_fail(t,NT_HEX);}t.has_author=true;
    }
    v=json_next(j[..]);
  }
  if t.type!=NT_OTHER && t.type!=NT_D && t.values<2 {return nt_fail(t,NT_SHAPE);}
  if t.values==0 {return nt_fail(t,NT_SHAPE);}
  return nt_fail(t,NT_OK);
}
// The first d tag's value: the identifier of an addressable event. Absent or
// valueless reads as the empty identifier, as relays index it.
nostr_tag_d :: (e:NostrEvent)->NostrTag #export_c {
  t:NostrTag;t.type=NT_D;j:[1]Json;if !nt_start(j[..],e) {return nt_fail(t,NT_EVENT);}
  k:=0;tok:=json_next(j[..]);
  while tok==JSON_ARRAY {
    r:=nostr_tag(e,k);if r.error==NT_EVENT || r.type==NT_D {return r;}
    skipped:=json_skip(j[..]);k+=1;tok=json_next(j[..]);
  }
  if tok!=JSON_ARRAY_END {return nt_fail(t,NT_EVENT);}
  return nt_fail(t,NT_OK);
}
