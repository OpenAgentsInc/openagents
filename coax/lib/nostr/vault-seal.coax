// NIP-VAULT tier user, the writer: a key slot and an object, byte for byte
// the forms vault.coax reads (nostr/nips/openagents/NIP-VAULT.md). The caller
// brings every random value (ids, nonces, keys), so the same inputs always
// give the same bytes and the checks compare against two independent
// writers: the Python reference (coax/tests/nostr/att_vault_reference.py)
// and the earlier Rust implementation's vectors.
//
//   vt_slot_seal    the VMK under one method's secret: HKDF-SHA256(ikm = secret, salt = the slot
//                   id's 32 bytes, info = "openagents.vault.v1/slot" 0 method), then AES-256-GCM
//                   with the slot's own JCS bytes (without nonce and vmk) as associated data
//   vt_object_seal  plain under a DEK in aes-256-gcm-chunked-v1, and the DEK in one user wrap
//                   under K_user_wrap (from the VMK), both bound to the core's digest
//
// Each returns the bytes written, or -1. Nothing is returned that the reader
// would refuse: the writer reads its own output back and opens it before it
// answers, and wipes out on any refusal. Key material is zero again on return.
//   coax/bin/coax test coax/lib/nostr/vault-seal.coax
//   coax/bin/coax mutate coax/lib/nostr/vault-seal.coax --root-only
#load "vault.coax";
#authority;

VT_SLOT_MAX :: 4096;     // a slot's text at most (a 1023-byte credential id is 1364 base64 characters)
VtSealWork :: struct {kdf:[1]VtKdf;kwrap:[32]u8;check:[32]u8;}

#test "the writer makes the Python reference's device slot, byte for byte" #steps 600000000 {
  secret:[32]u8;vt_hex_test(VT_DEVICE_SECRET,secret[..]);vmk:[32]u8;vt_hex_test(VT_VMK,vmk[..]);
  nonce:[12]u8;#assert vt_b64("BICpPS6bCUuJ4I4B",nonce[..],12);out:[VT_SLOT_MAX]u8;
  n:=vt_slot_seal(out[..],"5c47c764253f5fd269cb586c0e991ee13446b06736998e4e528d004794700028","00349a998651e23109043a3dd8c99cff6ba08661cd1d5fd1c01115b8af9fc19d",
    "device","{\"key_ref\":\"openagents-vault-test\",\"platform\":\"linux\"}","This laptop (test)",1791995000,secret[..],vmk[..],nonce[..]);
  #assert n==VT_SLOT_DEVICE.count && cast(string)out[0..<n]==VT_SLOT_DEVICE;
}
#test "the writer makes the Rust implementation's slots, byte for byte: passkey-prf, recovery, device, nostr" #steps 900000000 {
  vmk:[32]u8;vt_hex_test(VT_RUST_VMK,vmk[..]);nonce:[12]u8;for i:0..<12 {nonce[i]=13;}out:[VT_SLOT_MAX]u8;
  V:="1111111111111111111111111111111111111111111111111111111111111111";S:="4444444444444444444444444444444444444444444444444444444444444444";
  methods:=[4]string.["passkey-prf","recovery","device","nostr"];
  params:=[4]string.["{\"credential_id\":\"Y3JlZGVudGlhbC0x\",\"prf_salt\":\"UVFRUVFRUVFRUVFRUVFRUVFRUVFRUVFRUVFRUVFRUVE=\",\"rp_id\":\"openagents.com\"}",
    "{\"log_n\":16,\"salt\":\"MzMzMzMzMzMzMzMzMzMzMw==\"}","{\"key_ref\":\"com.openagents.vault.device\",\"platform\":\"ios\"}",
    "{\"pubkey\":\"abababababababababababababababababababababababababababababababab\",\"sealed\":\"AnNlYWxlZA==\"}"];
  secrets:=[4]string.[VT_RUST_SECRET_PRF,VT_RUST_SECRET_RECOVERY,VT_RUST_SECRET_DEVICE,VT_RUST_SECRET_NOSTR];
  want:=[4]string.[VT_RUST_SLOT_PRF,VT_RUST_SLOT_RECOVERY,VT_RUST_SLOT_DEVICE,VT_RUST_SLOT_NOSTR];
  for i:0..<4 {
    secret:[32]u8;vt_hex_test(secrets[i],secret[..]);
    n:=vt_slot_seal(out[..],V,S,methods[i],params[i],"Vector",1760000000,secret[..],vmk[..],nonce[..]);
    #assert n==want[i].count && cast(string)out[0..<n]==want[i];
  }
}
#test "a slot the reader would refuse is never written, and out is wiped" #steps 900000000 {
  secret:[33]u8;vmk:[33]u8;nonce:[13]u8;for i:0..<33 {secret[i]=cast(u8)(i+1);vmk[i]=cast(u8)(200-i);}out:[VT_SLOT_MAX]u8;
  V:="1111111111111111111111111111111111111111111111111111111111111111";S:="4444444444444444444444444444444444444444444444444444444444444444";
  P:="{\"log_n\":17,\"salt\":\"MzMzMzMzMzMzMzMzMzMzMw==\"}";
  good:=vt_slot_seal(out[..],V,S,"recovery",P,"Recovery code",5,secret[0..<32],vmk[0..<32],nonce[0..<12]);
  #assert good>0;got:[32]u8;
  #assert vt_slot_open(cast(string)out[0..<good],secret[0..<32],got[..])==VtCode.ok;for i:0..<32 {#assert got[i]==vmk[i];}
  // exactly enough room, and one byte less
  #assert vt_slot_seal(out[0..<good],V,S,"recovery",P,"Recovery code",5,secret[0..<32],vmk[0..<32],nonce[0..<12])==good;
  for i:0..<VT_SLOT_MAX {out[i]=7;}
  #assert vt_slot_seal(out[0..<good-1],V,S,"recovery",P,"Recovery code",5,secret[0..<32],vmk[0..<32],nonce[0..<12])==-1;
  for i:0..<good-1 {#assert out[i]==0;}
  #assert out[good-1]==7;
  // sizes of the secret, the VMK and the nonce
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"Recovery code",5,secret[0..<31],vmk[0..<32],nonce[0..<12])==-1;
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"Recovery code",5,secret[..],vmk[0..<32],nonce[0..<12])>0;
  // a method secret of 1024 bytes is the longest the reader takes
  long:[1025]u8;for i:0..<1025 {long[i]=cast(u8)(i%250+1);}
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"Recovery code",5,long[0..<1024],vmk[0..<32],nonce[0..<12])>0;
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"Recovery code",5,long[..],vmk[0..<32],nonce[0..<12])==-1;
  // params past the room for a slot's associated data
  wide:[2200]u8;wn:=json_raw(wide[..],0,"{\"key_ref\":\"");for i:0..<2100 {wide[wn]='k';wn+=1;}wn=json_raw(wide[..],wn,"\",\"platform\":\"ios\"}");
  #assert vt_slot_seal(out[..],V,S,"device",cast(string)wide[0..<wn],"Phone",5,secret[0..<32],vmk[0..<32],nonce[0..<12])==-1;
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"Recovery code",5,secret[0..<32],vmk[0..<31],nonce[0..<12])==-1;
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"Recovery code",5,secret[0..<32],vmk[..],nonce[0..<12])==-1;
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"Recovery code",5,secret[0..<32],vmk[0..<32],nonce[0..<11])==-1;
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"Recovery code",5,secret[0..<32],vmk[0..<32],nonce[..])==-1;
  // what the reader refuses: ids, the method, its params, the label, the time
  #assert vt_slot_seal(out[..],"X",S,"recovery",P,"Recovery code",5,secret[0..<32],vmk[0..<32],nonce[0..<12])==-1;
  #assert vt_slot_seal(out[..],V,"4444","recovery",P,"Recovery code",5,secret[0..<32],vmk[0..<32],nonce[0..<12])==-1;
  #assert vt_slot_seal(out[..],V,S,"pairing","{\"expires_at\":9}","Recovery code",5,secret[0..<32],vmk[0..<32],nonce[0..<12])==-1;
  #assert vt_slot_seal(out[..],V,S,"recovery","{\"log_n\":15,\"salt\":\"MzMzMzMzMzMzMzMzMzMzMw==\"}","Recovery code",5,secret[0..<32],vmk[0..<32],nonce[0..<12])==-1;
  #assert vt_slot_seal(out[..],V,S,"recovery","{ \"log_n\":17,\"salt\":\"MzMzMzMzMzMzMzMzMzMzMw==\"}","Recovery code",5,secret[0..<32],vmk[0..<32],nonce[0..<12])==-1;
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"a\"b",5,secret[0..<32],vmk[0..<32],nonce[0..<12])==-1;
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"",5,secret[0..<32],vmk[0..<32],nonce[0..<12])>0;
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"Recovery code",-1,secret[0..<32],vmk[0..<32],nonce[0..<12])==-1;
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"Recovery code",0,secret[0..<32],vmk[0..<32],nonce[0..<12])>0;
  for i:0..<16 {#assert out[i]!=0;}
  #assert vt_slot_seal(out[..],V,S,"recovery",P,"a\\b",5,secret[0..<32],vmk[0..<32],nonce[0..<12])==-1;
  for i:0..<VT_SLOT_MAX {#assert out[i]==0;}
}
#test "base64 at a place in a buffer: the next place, or -1 when it doesn't fit or there is no place" {
  out:[8]u8;x:=[3]u8.[1,2,255];
  #assert vt_put_b64(out[0..<4],0,x[..])==4 && cast(string)out[0..<4]=="AQL/" && vt_put_b64(out[0..<3],0,x[..])==-1;
  #assert vt_put_b64(out[0..<5],1,x[..])==5 && cast(string)out[1..<5]=="AQL/" && vt_put_b64(out[0..<4],1,x[..])==-1;
  #assert vt_put_b64(out[..],-1,x[..])==-1 && vt_put_b64(out[..],0,x[0..<0])==0 && vt_put_b64(out[..],8,x[0..<0])==8 && vt_put_b64(out[..],0,x[0..<1])==4 && cast(string)out[0..<4]=="AQ==";
}
#test "a slot id or a method that isn't one is refused before anything is derived" #steps 600000000 {
  secret:[32]u8;vmk:[32]u8;nonce:[12]u8;for i:0..<32 {secret[i]=cast(u8)(i+1);}out:[VT_SLOT_MAX]u8;
  V:="1111111111111111111111111111111111111111111111111111111111111111";S:="4444444444444444444444444444444444444444444444444444444444444444";
  P:="{\"key_ref\":\"k\",\"platform\":\"ios\"}";
  #assert vt_slot_seal(out[..],V,S,"device",P,"Phone",5,secret[..],vmk[..],nonce[..])>0;
  #assert vt_slot_seal(out[..],V,"444444444444444444444444444444444444444444444444444444444444444444","device",P,"Phone",5,secret[..],vmk[..],nonce[..])==-1;
  #assert vt_slot_seal(out[..],V,S,"a-method-name-that-is-longer-than-any-method-the-reader-knows","{}","Phone",5,secret[..],vmk[..],nonce[..])==-1;
  #assert vt_slot_seal(out[..],V,S,"",P,"Phone",5,secret[..],vmk[..],nonce[..])==-1;
}
#test "the writer makes the Python reference's object, byte for byte, and the reader opens it" #steps 1200000000 {
  b:[1024]u8;blob:=vt_blob_test(VT_SMALL,b[..]);u8b:[1024]u8;o:=vt_object_read_t(u8b[..],blob);#assert o.code==VtCode.ok;
  vmk:[32]u8;vt_hex_test(VT_VMK,vmk[..]);dek:[32]u8;vt_hex_test(VT_DEK,dek[..]);wn:[12]u8;#assert vt_b64(o.wraps[0].nonce,wn[..],12);
  plain:="Test data only: 21000 sat.";pb:[32]u8;out:[1024]u8;prefix:=o.prefix;
  for i:0..<1024 {out[i]=7;}   // whatever was in out before, every byte of the object is written
  n:=vt_object_seal(out[..],o.vault,o.object,1791997000,1024,prefix[..],vmk[..],dek[..],wn[..],vt_u8(plain,pb[..]));
  #assert n==blob.count && cast(string)out[0..<n]==blob;
  // room for the header's core and not its wraps; room for the header and not the chunk
  #assert o.body==12+516;
  for room:[5]int.[0,11,12,300,o.body-1] {#assert vt_object_seal(out[0..<room],o.vault,o.object,1791997000,1024,prefix[..],vmk[..],dek[..],wn[..],vt_u8(plain,pb[..]))==-1;}
  #assert vt_object_seal(out[0..<o.body],o.vault,o.object,1791997000,1024,prefix[..],vmk[..],dek[..],wn[..],vt_u8(plain,pb[..]))==-1;
  // exactly enough room, and one byte less
  #assert vt_object_seal(out[0..<n],o.vault,o.object,1791997000,1024,prefix[..],vmk[..],dek[..],wn[..],vt_u8(plain,pb[..]))==n;
  for i:0..<1024 {out[i]=7;}
  #assert vt_object_seal(out[0..<n-1],o.vault,o.object,1791997000,1024,prefix[..],vmk[..],dek[..],wn[..],vt_u8(plain,pb[..]))==-1;
  for i:0..<n-1 {#assert out[i]==0;}
  #assert out[n-1]==7;
}
#test "objects: empty, one chunk, exactly one chunk, two chunks; sizes and ids the reader refuses" #steps 2000000000 {
  V:="1111111111111111111111111111111111111111111111111111111111111111";O:="2222222222222222222222222222222222222222222222222222222222222222";
  S:="4444444444444444444444444444444444444444444444444444444444444444";
  vmk:[33]u8;dek:[33]u8;secret:[32]u8;wn:[13]u8;prefix:[8]u8;plain:[2100]u8;
  for i:0..<33 {vmk[i]=cast(u8)(3*i+1);dek[i]=cast(u8)(5*i+2);}
  for i:0..<32 {secret[i]=cast(u8)(7*i+3);}
  for i:0..<2100 {plain[i]=cast(u8)(i%251);}
  slot:[VT_SLOT_MAX]u8;sn:=vt_slot_seal(slot[..],V,S,"device","{\"key_ref\":\"k\",\"platform\":\"ios\"}","Phone",9,secret[..],vmk[0..<32],wn[0..<12]);#assert sn>0;
  out:[4096]u8;back:[2100]u8;
  for size:[6]int.[0,1,1023,1024,1025,2048] {
    n:=vt_object_seal(out[..],V,O,9,1024,prefix[0..<7],vmk[0..<32],dek[0..<32],wn[0..<12],plain[0..<size]);
    chunks:=ifx size==0 then 1 else (size+1023)/1024;
    #assert n>0;o:=vt_object_read(out[0..<n]);#assert o.code==VtCode.ok && o.chunks==chunks && o.count==1 && n==o.body+size+16*chunks;
    r:=vt_open(out[0..<n],cast(string)slot[0..<sn],secret[..],back[..]);
    #assert r.code==VtCode.ok && r.written==size;
    for i:0..<size {#assert back[i]==plain[i];}
  }
  #assert vt_object_seal(out[..],V,O,9,1023,prefix[0..<7],vmk[0..<32],dek[0..<32],wn[0..<12],plain[0..<5])==-1;
  #assert vt_object_seal(out[..],V,O,9,1048576,prefix[0..<7],vmk[0..<32],dek[0..<32],wn[0..<12],plain[0..<5])>0;
  #assert vt_object_seal(out[..],V,O,9,1048577,prefix[0..<7],vmk[0..<32],dek[0..<32],wn[0..<12],plain[0..<5])==-1;
  #assert vt_object_seal(out[..],V,O,-1,1024,prefix[0..<7],vmk[0..<32],dek[0..<32],wn[0..<12],plain[0..<5])==-1;
  #assert vt_object_seal(out[..],V,O,0,1024,prefix[0..<7],vmk[0..<32],dek[0..<32],wn[0..<12],plain[0..<5])>0;
  #assert vt_object_seal(out[..],"x",O,9,1024,prefix[0..<7],vmk[0..<32],dek[0..<32],wn[0..<12],plain[0..<5])==-1;
  #assert vt_object_seal(out[..],V,"x",9,1024,prefix[0..<7],vmk[0..<32],dek[0..<32],wn[0..<12],plain[0..<5])==-1;
  #assert vt_object_seal(out[..],V,O,9,1024,prefix[0..<6],vmk[0..<32],dek[0..<32],wn[0..<12],plain[0..<5])==-1;
  #assert vt_object_seal(out[..],V,O,9,1024,prefix[..],vmk[0..<32],dek[0..<32],wn[0..<12],plain[0..<5])==-1;
  #assert vt_object_seal(out[..],V,O,9,1024,prefix[0..<7],vmk[0..<31],dek[0..<32],wn[0..<12],plain[0..<5])==-1;
  #assert vt_object_seal(out[..],V,O,9,1024,prefix[0..<7],vmk[..],dek[0..<32],wn[0..<12],plain[0..<5])==-1;
  #assert vt_object_seal(out[..],V,O,9,1024,prefix[0..<7],vmk[0..<32],dek[0..<31],wn[0..<12],plain[0..<5])==-1;
  #assert vt_object_seal(out[..],V,O,9,1024,prefix[0..<7],vmk[0..<32],dek[..],wn[0..<12],plain[0..<5])==-1;
  #assert vt_object_seal(out[..],V,O,9,1024,prefix[0..<7],vmk[0..<32],dek[0..<32],wn[0..<11],plain[0..<5])==-1;
  #assert vt_object_seal(out[..],V,O,9,1024,prefix[0..<7],vmk[0..<32],dek[0..<32],wn[..],plain[0..<5])==-1;
  for i:0..<4096 {#assert out[i]==0;}
  // another vault's slot opens nothing of this object; another VMK's wrap is not this one's
  W:="1111111111111111111111111111111111111111111111111111111111111112";
  n:=vt_object_seal(out[..],W,O,9,1024,prefix[0..<7],vmk[0..<32],dek[0..<32],wn[0..<12],plain[0..<5]);
  #assert vt_open(out[0..<n],cast(string)slot[0..<sn],secret[..],back[..]).code==VtCode.vault;
  n=vt_object_seal(out[..],V,O,9,1024,prefix[0..<7],dek[0..<32],dek[0..<32],wn[0..<12],plain[0..<5]);
  #assert vt_open(out[0..<n],cast(string)slot[0..<sn],secret[..],back[..]).code==VtCode.wrap;
}
#test "the writer's key material is zero again on every return" #steps 900000000 {
  V:="1111111111111111111111111111111111111111111111111111111111111111";O:="2222222222222222222222222222222222222222222222222222222222222222";
  S:="4444444444444444444444444444444444444444444444444444444444444444";
  vmk:[32]u8;dek:[32]u8;secret:[32]u8;wn:[12]u8;prefix:[7]u8;plain:[5]u8;for i:0..<32 {vmk[i]=cast(u8)(i+1);dek[i]=cast(u8)(i+9);secret[i]=cast(u8)(i+40);}
  out:[VT_SLOT_MAX]u8;w:[1]VtSealWork;
  #assert vt_slot_seal_work(out[..],V,S,"device","{\"key_ref\":\"k\",\"platform\":\"ios\"}","Phone",9,secret[..],vmk[..],wn[..],w[..])>0 && vt_seal_zero_test(w[0]);
  #assert vt_slot_seal_work(out[..],V,S,"device","{\"key_ref\":\"\",\"platform\":\"ios\"}","Phone",9,secret[..],vmk[..],wn[..],w[..])==-1 && vt_seal_zero_test(w[0]);
  #assert vt_slot_seal_work(out[..],V,S,"device","{\"key_ref\":\"k\",\"platform\":\"ios\"}","Phone",9,secret[..],vmk[..],wn[0..<11],w[..])==-1 && vt_seal_zero_test(w[0]);
  #assert vt_slot_seal_work(out[..],V,S,"device","{\"key_ref\":\"k\",\"platform\":\"ios\"}","Phone",9,secret[..],vmk[0..<31],wn[..],w[..])==-1 && vt_seal_zero_test(w[0]);
  #assert vt_object_seal_work(out[..],V,O,9,1024,prefix[..],vmk[..],dek[..],wn[0..<11],plain[..],w[..])==-1 && vt_seal_zero_test(w[0]);
  #assert vt_object_seal_work(out[..],V,O,9,1024,prefix[..],vmk[..],dek[..],wn[..],plain[..],w[..])>0 && vt_seal_zero_test(w[0]);
  #assert vt_object_seal_work(out[0..<40],V,O,9,1024,prefix[..],vmk[..],dek[..],wn[..],plain[..],w[..])==-1 && vt_seal_zero_test(w[0]);
  w[0].check[3]=1;#assert !vt_seal_zero_test(w[0]);w[0].check[3]=0;w[0].kwrap[31]=1;#assert !vt_seal_zero_test(w[0]);w[0].kwrap[31]=0;
  w[0].kdf[0].key[0]=1;#assert !vt_seal_zero_test(w[0]);
}
vt_seal_zero_test :: (w:VtSealWork)->bool #effects(all) {a:=w.kwrap;b:=w.check;k:=w.kdf;return vt_zero_test(a[..]) && vt_zero_test(b[..]) && vt_kdf_zero_test(k[0]);}

// ---- small writers
// Base64 of b at out[at..]: the next position, or -1 (and -1 stays -1 down a chain of calls).
vt_put_b64 :: (out:[]u8,at:int,b:[]u8)->int #effects(all) {
  size:=base64_encode_size(b.count);
  if at<0 || at+size>out.count {return -1;}
  return at+base64_encode_checked(cast(string)b,out[at..<at+size],false).written;
}
vt_wipe :: (out:[]u8)->int #effects(all) {for i:0..<out.count {out[i]=0;}return -1;}

// ---- a slot
vt_slot_seal :: (out:[]u8,vault:string,slot:string,method:string,params:string,label:string,created_at:int,secret:[]u8,vmk:[]u8,nonce:[]u8)->int #effects(all) {
  w:[1]VtSealWork;return vt_slot_seal_work(out,vault,slot,method,params,label,created_at,secret,vmk,nonce,w[..]);
}
vt_slot_seal_work :: (out:[]u8,vault:string,slot:string,method:string,params:string,label:string,created_at:int,secret:[]u8,vmk:[]u8,nonce:[]u8,w:[]VtSealWork)->int #effects(all) {
  // The slot id and the method are read here; every other value is the reader's to refuse below.
  if !vt_hex64(slot) || vt_method(method)<0 {return vt_wipe(out);}
  // The associated data: the slot without nonce and vmk, in canonical order.
  aad:[VT_AAD_MAX]u8;a:=json_raw(aad[..],0,"{\"created_at\":");a=json_write_int(aad[..],a,created_at);
  a=json_raw(aad[..],a,",\"label\":\"");a=json_raw(aad[..],a,label);a=json_raw(aad[..],a,"\",\"method\":\"");a=json_raw(aad[..],a,method);
  head:=a;   // nonce goes here, after method
  a=json_raw(aad[..],a,"\",\"params\":");a=json_raw(aad[..],a,params);a=json_raw(aad[..],a,",\"requires\":[],\"slot\":\"");a=json_raw(aad[..],a,slot);
  a=json_raw(aad[..],a,"\",\"v\":\"");a=json_raw(aad[..],a,VT_SLOT_V);a=json_raw(aad[..],a,"\",\"vault\":\"");a=json_raw(aad[..],a,vault);a=json_raw(aad[..],a,"\"}");
  if a==-1 {return vt_wipe(out);}
  salt:[32]u8;vt_bytes(slot,salt[..]);
  info:[64]u8;n:=json_raw(info[..],0,"openagents.vault.v1/slot");n=json_raw(info[..],n+1,method);   // info[24] stays 0
  sealed:[48]u8;
  ok:=hkdf_extract_checked(salt[..],secret,w[0].kdf[0].prk[..],false)==SHA_OK && hkdf_expand_checked(w[0].kdf[0].prk[..],info[0..<n],w[0].kdf[0].key[..],32,false)==SHA_OK
    && aes256_gcm_seal(w[0].kdf[0].key[..],nonce,aad[0..<a],vmk,sealed[..])==48;
  w[0].kdf[0]=VtKdf.{};
  if !ok {return vt_wipe(out);}
  // The slot: the same bytes with "nonce" after "method" and "vmk" last.
  o:=json_raw(out,0,cast(string)aad[0..<head]);o=json_raw(out,o,"\",\"nonce\":\"");o=vt_put_b64(out,o,nonce);
  o=json_raw(out,o,cast(string)aad[head..<a-1]);o=json_raw(out,o,",\"vmk\":\"");o=vt_put_b64(out,o,sealed[..]);o=json_raw(out,o,"\"}");
  if o==-1 {return vt_wipe(out);}
  // Read it back as the reader will: it is a slot the reader takes, and this secret opens it.
  good:=vt_slot_open_work(cast(string)out[0..<o],secret,w[0].check[..],w[0].kdf[..])==VtCode.ok;
  w[0]=VtSealWork.{};
  if !good {return vt_wipe(out);}
  return o;
}

// ---- an object
vt_object_seal :: (out:[]u8,vault:string,object:string,created_at:int,chunk_bytes:int,prefix:[]u8,vmk:[]u8,dek:[]u8,wrap_nonce:[]u8,plain:[]u8)->int #effects(all) {
  w:[1]VtSealWork;return vt_object_seal_work(out,vault,object,created_at,chunk_bytes,prefix,vmk,dek,wrap_nonce,plain,w[..]);
}
vt_object_seal_work :: (out:[]u8,vault:string,object:string,created_at:int,chunk_bytes:int,prefix:[]u8,vmk:[]u8,dek:[]u8,wrap_nonce:[]u8,plain:[]u8,w:[]VtSealWork)->int #effects(all) {
  if vmk.count!=32 || dek.count!=32 || wrap_nonce.count!=12 || prefix.count!=7 || chunk_bytes<1024 || created_at<0
    || !vt_hex64(vault) || !vt_hex64(object) {return vt_wipe(out);}
  chunks:=ifx plain.count==0 then 1 else (plain.count+chunk_bytes-1)/chunk_bytes;
  // The header: {"core":{...},"requires":[],"v":...,"wraps":[{dek,key,mode,nonce}]}, canonical.
  h:=json_raw(out,12,"{\"core\":");core:=h;
  h=json_raw(out,h,"{\"content\":{\"alg\":\"aes-256-gcm-chunked-v1\",\"chunk_bytes\":");h=json_write_int(out,h,chunk_bytes);
  h=json_raw(out,h,",\"chunks\":");h=json_write_int(out,h,chunks);h=json_raw(out,h,",\"nonce_prefix\":\"");h=vt_put_b64(out,h,prefix);
  h=json_raw(out,h,"\"},\"created_at\":");h=json_write_int(out,h,created_at);h=json_raw(out,h,",\"object\":\"");h=json_raw(out,h,object);
  h=json_raw(out,h,"\",\"tier\":\"user\",\"vault\":\"");h=json_raw(out,h,vault);h=json_raw(out,h,"\"}");
  if h==-1 {return vt_wipe(out);}
  digest:[32]u8;if sha256_hash_checked(out[core..<h],digest[..],false)!=SHA_OK {return vt_wipe(out);}
  id:[32]u8;sealed:[48]u8;
  wad:[62]u8;n:=json_raw(wad[..],0,"openagents.vault.v1/wrap-user");for i:0..<32 {wad[n+1+i]=digest[i];}
  ok:=vt_user_keys_work(vmk,w[0].kwrap[..],id[..],w[0].kdf[..]) && aes256_gcm_seal(w[0].kwrap[..],wrap_nonce,wad[..],dek,sealed[..])==48;
  w[0]=VtSealWork.{};
  if !ok {return vt_wipe(out);}
  h=json_raw(out,h,",\"requires\":[],\"v\":\"");h=json_raw(out,h,VT_OBJECT_V);h=json_raw(out,h,"\",\"wraps\":[{\"dek\":\"");h=vt_put_b64(out,h,sealed[..]);
  h=json_raw(out,h,"\",\"key\":\"");h=json_raw(out,h,cast(string)id[..]);h=json_raw(out,h,"\",\"mode\":\"user\",\"nonce\":\"");h=vt_put_b64(out,h,wrap_nonce);
  h=json_raw(out,h,"\"}]}");
  if h==-1 {return vt_wipe(out);}
  for k:0..<8 {out[k]=VT_MAGIC[k];}
  for k:0..<4 {out[8+k]=cast(u8)(((h-12)>>(8*(3-k)))&255);}
  // The chunks, each under the DEK with its own nonce, bound to the core's digest.
  cad:[58]u8;n=json_raw(cad[..],0,"openagents.vault.v1/chunk");for i:0..<32 {cad[n+1+i]=digest[i];}
  at:=h;from:=0;p7:[7]u8;for k:0..<7 {p7[k]=prefix[k];}
  for i:0..<chunks {
    last:=i==chunks-1;size:=ifx last then plain.count-from else chunk_bytes;
    if at+size+16>out.count {return vt_wipe(out);}
    nonce:[12]u8;vt_chunk_nonce(p7,i,last,nonce[..]);
    if aes256_gcm_seal(dek,nonce[..],cad[..],plain[from..<from+size],out[at..<at+size+16])!=size+16 {return vt_wipe(out);}
    at+=size+16;from+=size;
  }
  if vt_object_read(out[0..<at]).code!=VtCode.ok {return vt_wipe(out);}
  return at;
}
