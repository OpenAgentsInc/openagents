// Git remote URL normalization and Project-to-workspace auto-matching.
// Canonical form is lowercase "host/owner/repo" (or "host/group/.../repo"),
// with SSH/HTTPS/HTTP/trailing-slash/trailing-.git differences erased.
// Plain "owner/repo" shorthand defaults to "github.com/owner/repo".
#authority;

PRM_MAX :: 256;

prm_lower :: (c: u8) -> u8 #effects(all) {
  return ifx c >= 'A' && c <= 'Z' then cast(u8) (c + 32) else c;
}

prm_ws :: (c: u8) -> bool #effects(all) {
  return c == ' ' || c == '\t' || c == '\r' || c == '\n';
}

prm_host_char :: (c: u8) -> bool #effects(all) {
  return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '-';
}

prm_seg_char :: (c: u8) -> bool #effects(all) {
  return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '-' || c == '_';
}

prm_find_first :: (s: string, ch: u8) -> int #effects(all) {
  for i: 0..<s.count { if s[i] == ch { return i; } }
  return -1;
}

prm_find_last :: (s: string, ch: u8) -> int #effects(all) {
  found := -1;
  for i: 0..<s.count { if s[i] == ch { found = i; } }
  return found;
}

prm_prefix_ci :: (s: string, p: string) -> bool #effects(all) {
  if s.count <= p.count { return false; }
  for i: 0..<p.count {
    if prm_lower(s[i]) != p[i] { return false; }
  }
  return true;
}

prm_suffix_git :: (s: string) -> bool #effects(all) {
  if s.count <= 4 { return false; }
  n := s.count;
  return s[n - 4] == '.' && prm_lower(s[n - 3]) == 'g' && prm_lower(s[n - 2]) == 'i' && prm_lower(s[n - 1]) == 't';
}

prm_host_valid :: (host: string) -> bool #effects(all) {
  has_dot := false;
  prev_dot := true;
  for i: 0..<host.count {
    c := prm_lower(host[i]);
    if !prm_host_char(c) { return false; }
    if c == '.' {
      if prev_dot || i + 1 == host.count { return false; }
      has_dot = true;
      prev_dot = true;
    } else {
      if c == '-' && (prev_dot || i + 1 == host.count || host[i + 1] == '.') { return false; }
      prev_dot = false;
    }
  }
  return has_dot;
}

prm_path_valid :: (path: string) -> bool #effects(all) {
  if path.count < 3 { return false; }
  segs := 0;
  start := 0;
  i := 0;
  while i <= path.count {
    if i == path.count || path[i] == '/' {
      seg_len := i - start;
      if seg_len < 1 { return false; }
      if seg_len == 1 && path[start] == '.' { return false; }
      if seg_len == 2 && path[start] == '.' && path[start + 1] == '.' { return false; }
      segs += 1;
      start = i + 1;
    } else {
      if !prm_seg_char(prm_lower(path[i])) { return false; }
    }
    i += 1;
  }
  return segs >= 2;
}

prm_user_valid :: (user: string) -> bool #effects(all) {
  if user.count < 1 { return false; }
  for c: user {
    if !prm_seg_char(prm_lower(c)) && c != ':' { return false; }
  }
  return true;
}

// Normalize a git remote URL or "owner/repo" shorthand into canonical lowercase
// "host/owner/repo" in `out`. Returns written length (>0) or -1 if invalid.
pr_repo_normalize :: (raw: string, out: [] u8) -> int #effects(all) {
  a := 0;
  b := raw.count;
  while a < b && prm_ws(raw[a]) { a += 1; }
  while b > a && prm_ws(raw[b - 1]) { b -= 1; }
  if b <= a || b - a > PRM_MAX { return -1; } // mutant: equivalent (at b==a, empty s has colon=-1, slash=-1 and returns -1)
  s := cast(string) raw[a..<b];
  host := "";
  path := "";
  has_scheme := false;
  if prm_prefix_ci(s, "https://") { s = cast(string) s[8..<s.count]; has_scheme = true; }
  else if prm_prefix_ci(s, "http://") { s = cast(string) s[7..<s.count]; has_scheme = true; }
  else if prm_prefix_ci(s, "ssh://") { s = cast(string) s[6..<s.count]; has_scheme = true; }
  else if prm_prefix_ci(s, "git://") { s = cast(string) s[6..<s.count]; has_scheme = true; }

  if has_scheme {
    slash := prm_find_first(s, '/');
    if slash < 1 { return -1; } // mutant: equivalent (slash 1..2 leaves host<3 bytes, refused by prm_host_valid)
    auth := cast(string) s[0..<slash];
    path = cast(string) s[slash + 1..<s.count];
    at := prm_find_last(auth, '@');
    if at > 0 { // mutant: equivalent (at==0 fails prm_user_valid("") or leaves '@' refused by prm_host_valid)
      if !prm_user_valid(cast(string) auth[0..<at]) { return -1; }
      auth = cast(string) auth[at + 1..<auth.count];
    }
    colon := prm_find_first(auth, ':');
    if colon > 0 { // mutant: equivalent (colon 0..1 leaves host<2 bytes or ':' refused by prm_host_valid)
      port := cast(string) auth[colon + 1..<auth.count];
      if port.count < 1 || port.count > 5 { return -1; }
      for c: port { if c < '0' || c > '9' { return -1; } }
      auth = cast(string) auth[0..<colon];
    }
    host = auth;
  } else {
    colon := prm_find_first(s, ':');
    slash := prm_find_first(s, '/');
    if colon >= 3 && colon < slash { // mutant: equivalent (s[colon]==':' != '/'==s[slash], so colon!=slash)
      auth := cast(string) s[0..<colon];
      path = cast(string) s[colon + 1..<s.count];
      at := prm_find_last(auth, '@');
      if at > 0 { // mutant: equivalent (at==0 fails prm_user_valid("") or leaves '@' refused by prm_host_valid)
        if !prm_user_valid(cast(string) auth[0..<at]) { return -1; }
        auth = cast(string) auth[at + 1..<auth.count];
      }
      host = auth;
    } else if slash >= 1 {
      first := cast(string) s[0..<slash];
      if prm_find_first(first, '.') >= 0 {
        host = first;
        path = cast(string) s[slash + 1..<s.count];
      } else {
        host = "github.com";
        path = s;
      }
    } else {
      return -1;
    }
  }

  while path.count > 1 && path[path.count - 1] == '/' { // mutant: equivalent (path.count<3 is refused by prm_path_valid)
    path = cast(string) path[0..<path.count - 1];
  }
  if prm_suffix_git(path) {
    path = cast(string) path[0..<path.count - 4];
  }
  if !prm_host_valid(host) || !prm_path_valid(path) { return -1; }
  total := host.count + 1 + path.count;
  if total > out.count { return -1; }
  n := 0;
  for c: host { out[n] = prm_lower(c); n += 1; }
  out[n] = '/'; n += 1;
  for c: path { out[n] = prm_lower(c); n += 1; }
  return n;
}

// Exact canonical repository equality across SSH, HTTPS, HTTP, case, and .git forms.
pr_repo_match :: (a: string, b: string) -> bool #effects(all) {
  ba: [PRM_MAX + 16] u8;
  bb: [PRM_MAX + 16] u8;
  na := pr_repo_normalize(a, ba[..]);
  nb := pr_repo_normalize(b, bb[..]);
  if na == -1 || na != nb { return false; }
  return cast(string) ba[0..<na] == cast(string) bb[0..<nb];
}

// Compact display label: "owner/repo" for github.com, else "host/owner/repo".
pr_repo_short :: (raw: string, out: [] u8) -> int #effects(all) {
  buf: [PRM_MAX + 16] u8;
  n := pr_repo_normalize(raw, buf[..]);
  if n == -1 { return -1; }
  canon := cast(string) buf[0..<n];
  gh := "github.com/";
  if cast(string) canon[0..<gh.count] == gh {
    canon = cast(string) canon[gh.count..<canon.count];
  }
  if canon.count > out.count { return -1; }
  for i: 0..<canon.count { out[i] = canon[i]; }
  return canon.count;
}

#test "git remote helpers cover exact find, prefix, suffix, and user boundaries" {
  #assert prm_find_first("ab/c", '/') == 2 && prm_find_first("/ab", '/') == 0 && prm_find_first("abc", '/') == -1;
  #assert prm_find_last("a@b@c", '@') == 3 && prm_find_last("@a", '@') == 0 && prm_find_last("abc", '@') == -1;
  #assert prm_prefix_ci("HTTP://x", "http://") && !prm_prefix_ci("http://", "http://") && !prm_prefix_ci("http:/", "http://");
  #assert prm_suffix_git("a.git") && prm_suffix_git("a.GIT") && !prm_suffix_git(".git") && !prm_suffix_git("a.gi");
  #assert !prm_suffix_git("a.gix") && !prm_suffix_git("a.gxt") && !prm_suffix_git("a.xit") && !prm_suffix_git("axgit");
  #assert prm_user_valid("u") && prm_user_valid("u:p") && !prm_user_valid("") && !prm_user_valid("u?p");
}

#test "git remote normalization matches SSH, HTTPS, HTTP, git, shorthand, case and .git suffix" {
  b: [280] u8;
  n := pr_repo_normalize("git@github.com:OpenAgentsInc/openagents.git", b[..]);
  #assert n > 0 && cast(string) b[0..<n] == "github.com/openagentsinc/openagents";
  #assert pr_repo_match("git@github.com:OpenAgentsInc/openagents.git", "https://github.com/openagentsinc/openagents");
  #assert pr_repo_match("https://GITHUB.COM/OpenAgentsInc/openagents.GIT/", "OpenAgentsInc/openagents");
  #assert pr_repo_match("ssh://u@github.com:22/OpenAgentsInc/openagents.git", "http://github.com/OpenAgentsInc/openagents");
  #assert pr_repo_match("git://github.com:9418/OpenAgentsInc/openagents.git", "github.com/OpenAgentsInc/openagents");
  #assert pr_repo_match(" https://user:tok@github.com/OpenAgentsInc/openagents.git \r\n\t", "github.com/openagentsinc/openagents");
  #assert pr_repo_match("git@gitlab.com:team/sub-group/repo_1.git", "https://gitlab.com/TEAM/sub-group/repo_1");
  #assert pr_repo_normalize("a.b/c/d.gi", b[..]) == 10 && cast(string) b[0..<10] == "a.b/c/d.gi";
  #assert pr_repo_normalize("a.b/c/d.gix", b[..]) == 11 && cast(string) b[0..<11] == "a.b/c/d.gix";
  #assert pr_repo_normalize("a.b/c/d.gxt", b[..]) == 11 && cast(string) b[0..<11] == "a.b/c/d.gxt";
  #assert pr_repo_normalize("a.b/c/d.xit", b[..]) == 11 && cast(string) b[0..<11] == "a.b/c/d.xit";
  #assert pr_repo_normalize("a.b/c/dxgit", b[..]) == 11 && cast(string) b[0..<11] == "a.b/c/dxgit";
  #assert pr_repo_normalize("a.b/c/.x", b[..]) == 8 && cast(string) b[0..<8] == "a.b/c/.x";
  #assert pr_repo_normalize("a.b/c/x.", b[..]) == 8 && cast(string) b[0..<8] == "a.b/c/x.";
  #assert pr_repo_normalize("a.b/c/..x", b[..]) == 9 && cast(string) b[0..<9] == "a.b/c/..x";
  #assert pr_repo_normalize("a/b", b[..]) == 14 && cast(string) b[0..<14] == "github.com/a/b";
  #assert pr_repo_normalize("  a/b  ", b[..]) == 14 && cast(string) b[0..<14] == "github.com/a/b";
  #assert pr_repo_normalize("u@a.b:c/d", b[..]) == 7 && cast(string) b[0..<7] == "a.b/c/d";
  #assert pr_repo_normalize("AZaz/Z09", b[..]) == 19 && cast(string) b[0..<19] == "github.com/azaz/z09";
  #assert pr_repo_normalize("\ra/b\r", b[..]) == 14 && cast(string) b[0..<14] == "github.com/a/b";
  #assert pr_repo_normalize("http://a.b:8/c/d", b[..]) == 7;
  #assert pr_repo_normalize("http://a.b:65535/c/d", b[..]) == 7;
  #assert pr_repo_normalize("http://a.b:9/c/d", b[..]) == 7;
  #assert pr_repo_normalize("http://a.b:0/c/d", b[..]) == 7;
  #assert !pr_repo_match("OpenAgentsInc/openagents", "OpenAgentsInc/other");
  #assert !pr_repo_match("git@gitlab.com:a/b", "git@github.com:a/b");
  #assert !pr_repo_match("", "OpenAgentsInc/openagents");
  #assert !pr_repo_match("OpenAgentsInc/openagents", "not-a-repo");
  #assert !pr_repo_match("", "");
}

#test "short display name strips github.com prefix and keeps non-GitHub hosts" {
  b: [280] u8;
  n := pr_repo_short("git@github.com:OpenAgentsInc/openagents.git", b[..]);
  #assert n > 0 && cast(string) b[0..<n] == "openagentsinc/openagents";
  n = pr_repo_short("https://gitlab.com/Team/App.git", b[..]);
  #assert n > 0 && cast(string) b[0..<n] == "gitlab.com/team/app";
  #assert pr_repo_short("bad", b[..]) < 0;
  #assert pr_repo_short("OpenAgentsInc/openagents", b[0..<4]) < 0;
  #assert pr_repo_short("a/b", b[0..<3]) == 3 && cast(string) b[0..<3] == "a/b";
}

#test "malformed, traversal, query, oversized, and truncated remotes are refused" {
  b: [280] u8;
  #assert pr_repo_normalize("", b[..]) < 0;
  #assert pr_repo_normalize("  ab  ", b[..]) < 0;
  #assert pr_repo_normalize("   \t\r\n ", b[..]) < 0;
  #assert pr_repo_normalize("onlyone", b[..]) < 0;
  #assert pr_repo_normalize("https://", b[..]) < 0;
  #assert pr_repo_normalize("http://", b[..]) < 0;
  #assert pr_repo_normalize("ssh://", b[..]) < 0;
  #assert pr_repo_normalize("git://", b[..]) < 0;
  #assert pr_repo_normalize("xttp://a.b/c/d", b[..]) < 0;
  #assert pr_repo_normalize("https://a/b/c", b[..]) < 0;
  #assert pr_repo_normalize("https://a.b/c", b[..]) < 0;
  #assert pr_repo_normalize("https://a.b/c/", b[..]) < 0;
  #assert pr_repo_normalize("https://a.b/c/d", b[..]) == 7;
  #assert pr_repo_normalize("https://a.b//", b[..]) < 0;
  #assert pr_repo_normalize("https://a.b///", b[..]) < 0;
  #assert pr_repo_normalize("https://:80/c/d", b[..]) < 0;
  #assert pr_repo_normalize("https://@a.b/c/d", b[..]) < 0;
  #assert pr_repo_normalize("https://u?x@a.b/c/d", b[..]) < 0;
  #assert pr_repo_normalize("@a.b:c/d", b[..]) < 0;
  #assert pr_repo_normalize("u?x@a.b:c/d", b[..]) < 0;
  #assert pr_repo_normalize(":a/b", b[..]) < 0;
  #assert pr_repo_normalize("ab:c/d", b[..]) < 0;
  #assert pr_repo_normalize("/a/b", b[..]) < 0;
  #assert pr_repo_normalize("a.b/c:d", b[..]) < 0;
  #assert pr_repo_normalize("a.b:c/d:e", b[..]) < 0;
  #assert pr_repo_normalize("a.b:cd", b[..]) < 0;
  #assert pr_repo_normalize("a.b/c/d/..", b[..]) < 0;
  #assert pr_repo_normalize("a.b/c/.", b[..]) < 0;
  #assert pr_repo_normalize("a.b//c", b[..]) < 0;
  #assert pr_repo_normalize("a.b/c/d?x=1", b[..]) < 0;
  #assert pr_repo_normalize("a.b/c/d#frag", b[..]) < 0;
  #assert pr_repo_normalize("a.b/c/d\\e", b[..]) < 0;
  #assert pr_repo_normalize("a.b/c d/e", b[..]) < 0;
  #assert pr_repo_normalize("https://github.com:/a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://github.com:abc/a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://github.com:123456/a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://github.com:8:/a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://github.com:8//a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://-bad.com/a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://bad-.com/a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://a.b-/a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://a.-b/a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://a.b./a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://bad..com/a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://nodot/a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://.a/a/b", b[..]) < 0;
  #assert pr_repo_normalize(".a/b", b[..]) < 0;
  #assert pr_repo_normalize("https:///a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://a.b", b[..]) < 0;
  #assert pr_repo_normalize("https://a_b.com/a/b", b[..]) < 0;
  #assert pr_repo_normalize("https://a.b/a/b", b[0..<6]) < 0;
  #assert pr_repo_normalize("https://a.b/a/b", b[0..<7]) == 7;
  #assert pr_repo_normalize("a.b:c/d", b[..]) == 7 && cast(string) b[0..<7] == "a.b/c/d";
  #assert pr_repo_normalize("https://a.b/a/b.git", b[..]) == 7;
  #assert pr_repo_normalize("https://a.b/a/.git", b[..]) < 0;
  #assert pr_repo_normalize("https://a.b/.git", b[..]) < 0;
  #assert pr_repo_normalize("a/[b", b[..]) < 0;
  padded: [PRM_MAX + 2] u8;
  padded[0] = ' ';
  for i: 1..<PRM_MAX + 1 { padded[i] = 'a'; }
  padded[3] = '.'; padded[6] = '/'; padded[11] = '/';
  padded[PRM_MAX + 1] = ' ';
  #assert pr_repo_normalize(cast(string) padded[..], b[..]) == PRM_MAX;
  long: [PRM_MAX + 1] u8;
  for i: 0..<long.count { long[i] = 'a'; }
  long[2] = '.'; long[5] = '/'; long[10] = '/';
  #assert pr_repo_normalize(cast(string) long[0..<PRM_MAX], b[..]) == PRM_MAX;
  #assert pr_repo_normalize(cast(string) long[..], b[..]) < 0;
}

#forall "ASCII classification functions match exact ranges" ch: u8 {
  #assert prm_lower(ch) == (ifx ch >= 'A' && ch <= 'Z' then cast(u8) (ch + 32) else ch);
  #assert prm_ws(ch) == (ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n');
  #assert prm_seg_char(ch) == ((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '.' || ch == '-' || ch == '_');
  #assert prm_host_char(ch) == ((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '.' || ch == '-');
}
