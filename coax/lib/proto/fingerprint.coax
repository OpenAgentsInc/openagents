  input:=[1] u8.[0];out:[64] u8;
  #assert S_hex(S_hash(cast(string)input[..]),out[..]);
  #assert cast(string)out[..]=="6e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d";
}
