// Indexed repos, an answer's text (docs/repos/2026-11-11-indexed-repos.md,
// GitHub #13326): matching a glob and mending UTF-8; numbering and cutting lines, and the
// small writers repo.coax builds answers with, are lines.coax. No effects and no decisions
// about what a request may name: those are rules.coax.
//   coax/bin/coax test coax/lib/repo/text.coax

#load "rules.coax";
#load "lines.coax";

// Whether path matches glob. * is any run inside one part, ? one byte of a part, ** any run across parts.
// A glob with no / is matched against the path's last part, so "*.coax" finds files at any depth.
rp_glob :: (glob: string, path: string) -> bool {
  has_slash := false;
  for c: glob { if c == '/' { has_slash = true; } }
  if has_slash { return rp_glob_at(glob, 0, path, 0, 0); }
  last := 0;
  for i: 0..<path.count { if path[i] == '/' { last = i + 1; } }
  return rp_glob_at(glob, 0, path, last, 0);
}
rp_glob_at :: (g: string, gi0: int, p: string, pi0: int, depth: int) -> bool {
  if depth > 64 { return false; }
  gi := gi0; pi := pi0;
  while gi < g.count {
    c := g[gi];
    if c == '*' {
      deep := gi + 1 < g.count && g[gi + 1] == '*';
      next := ifx deep then gi + 2 else gi + 1;
      if deep && next < g.count && g[next] == '/' { next += 1; }   // "**/" also matches nothing
      k := pi;
      while true {
        if rp_glob_at(g, next, p, k, depth + 1) { return true; }
        if k >= p.count || (!deep && p[k] == '/') { return false; }
        k += 1;
      }
    }
    if pi >= p.count { return false; }
    if c == '?' { if p[pi] == '/' { return false; } }
    else if c != p[pi] { return false; }
    gi += 1; pi += 1;
  }
  return pi == p.count;
}

#test "a glob matches by parts: * inside one, ** across them, and a bare one against the last part" {
  #assert rp_glob("*.coax", "coax/web/drive.coax") && rp_glob("*.coax", "top.coax") && !rp_glob("*.coax", "a/b.coaxial");
  #assert rp_glob("coax/*/host.js", "coax/web/host.js") && !rp_glob("coax/*/host.js", "coax/web/x/host.js");
  #assert rp_glob("coax/**/host.js", "coax/web/x/host.js") && rp_glob("coax/**/host.js", "coax/host.js") && rp_glob("**", "a/b/c");
  #assert rp_glob("docs/**", "docs/a/b.md") && !rp_glob("docs/**", "doc/a") && rp_glob("a?c", "abc") && !rp_glob("a?c", "a/c") && !rp_glob("a?c", "ac");
  #assert rp_glob("README.md", "sub/README.md") && rp_glob("sub/README.md", "sub/README.md") && !rp_glob("sub/README.md", "README.md");
}

#forall "a glob with no special byte matches only itself" i: 0..<6 {
  names := [6] string.["a", "a/b", "docs/x.md", "x.y.z", "deep/er/path/file", "q"];
  for j: 0..<6 { #assert rp_glob(names[i], names[j]) == (i == j) || (names[i] == "a" && names[j] == "a") || (names[i] == "q" && names[j] == "q"); }
}

// Makes text valid UTF-8 in place: each byte that doesn't start a whole, well-formed character
// (RFC 3629: no overlongs, surrogates or values above U+10FFFF, ws_utf8's rules) becomes '?'.
// An answer is JSON on the wire (coax/lib/repo/wire.coax), whose strings must be UTF-8, and a
// file in a repository may be Latin-1 or cut mid-character.
rp_utf8_mend :: (text: [] u8) -> int {
  mended := 0; i := 0;
  while i < text.count {
    c := text[i];
    if c < 0x80 { i += 1; continue; }
    need := 0; low: u8 = 0x80; high: u8 = 0xbf;
    if c >= 0xc2 && c <= 0xdf { need = 1; }
    else if c >= 0xe0 && c <= 0xef { need = 2; if c == 0xe0 { low = 0xa0; } if c == 0xed { high = 0x9f; } }
    else if c >= 0xf0 && c <= 0xf4 { need = 3; if c == 0xf0 { low = 0x90; } if c == 0xf4 { high = 0x8f; } }
    whole := need > 0 && i + need < text.count && text[i + 1] >= low && text[i + 1] <= high;
    for k: 2..<need + 1 { if whole && (text[i + k] < 0x80 || text[i + k] > 0xbf) { whole = false; } }
    if whole { i += need + 1; continue; }
    text[i] = '?'; mended += 1; i += 1;
  }
  return mended;
}

#test "text is mended to UTF-8 a byte at a time, and good text is left alone" {
  good := [11] u8.['a', 0xc3, 0xa9, 0xe2, 0x82, 0xac, 0xf0, 0x9f, 0x98, 0x80, 'z'];
  #assert rp_utf8_mend(good[..]) == 0 && good[1] == 0xc3 && good[9] == 0x80;
  bad := [9] u8.[0xff, 'a', 0xc3, 'b', 0xe0, 0x80, 0x80, 0xed, 0xa0];
  #assert rp_utf8_mend(bad[..]) == 7;
  #assert bad[0] == '?' && bad[1] == 'a' && bad[2] == '?' && bad[3] == 'b' && bad[4] == '?' && bad[5] == '?' && bad[6] == '?' && bad[7] == '?' && bad[8] == '?';
  cut := [3] u8.['x', 0xe2, 0x82];
  #assert rp_utf8_mend(cut[..]) == 2 && cut[0] == 'x' && cut[1] == '?' && cut[2] == '?';
  top := [5] u8.[0xf4, 0x90, 0x80, 0x80, 0xc0];
  #assert rp_utf8_mend(top[..]) == 5;
  edge := [4] u8.[0xf4, 0x8f, 0xbf, 0xbf];
  #assert rp_utf8_mend(edge[..]) == 0;
}
