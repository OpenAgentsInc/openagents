  #assert rlm_test_eval(mem[..], r[..], "", "x = 7\nprint(x // 2, x % 3, -x // 2, 10 - 2 * 3)", none) == "3 1 -4 4\n";
  #assert rlm_test_eval(mem[..], r[..], "abcdef", "print(len(context), context[1:3], context[-2:], context[:2] + '|')", none) == "6 bc ef ab|\n";
  #assert rlm_test_eval(mem[..], r[..], "", "n = 3\nprint(f'n={n} twice={n * 2} {{x}} {\"q\"}')", none) == "n=3 twice=6 {x} q\n";
  #assert rlm_test_eval(mem[..], r[..], "", "a = [1, 2, 3]\na.append(4)\nb = [x * x for x in a if x % 2 == 0]\nprint(b, sum(a), max(a), min(a), len(a))", none) == "[4, 16] 10 4 1 4\n";
  #assert rlm_test_eval(mem[..], r[..], "", "d = {}\nfor w in 'b a b c b a'.split():\n    d[w] = d.get(w, 0) + 1\nprint(d, max(d, key=d.get), sorted(d, key=d.get, reverse=True))", none) == "{'b': 3, 'a': 2, 'c': 1} b ['b', 'a', 'c']\n";
  #assert rlm_test_eval(mem[..], r[..], "", "t = 0\ni = 0\nwhile True:\n    i += 1\n    if i > 10:\n        break\n    if i % 2:\n        continue\n    t += i\nprint(t)", none) == "30\n";
  #assert rlm_test_eval(mem[..], r[..], "", "for i, w in enumerate(['x', 'y']):\n    print(i, w)\nfor k, v in {'a': 1}.items(): print(k, v)", none) == "0 x\n1 y\na 1\n";
  #assert rlm_test_eval(mem[..], r[..], "", "s = '  Hello, World  '\nprint(s.strip().lower().replace('world', 'there'), '|'.join(['a', 'b']), s.count('l'), s.find('W'))", none) == "hello, there a|b 3 9\n";
  #assert rlm_test_eval(mem[..], r[..], "", "a, b = 1, 2\nprint(b, a, 'yes' if a < b else 'no', not a, 3 in [1, 3], 'z' not in 'abc')", none) == "2 1 yes False True True\n";
  #assert rlm_test_eval(mem[..], r[..], "", "import re\nprint(re.search('\\\\d+', 'ab12'), re.search('^x', 'ab'), int(' -42 '), str(5) + '!', repr('a\\'b'))", none) == "True None -42 5! 'a\\'b'\n";
  #assert rlm_test_eval(mem[..], r[..], "", "x = [3, 1, 2]\nx.sort()\ny = x[:]\ny[0] = 9\nprint(x, y, x == [1, 2, 3], [1, [2]] == [1, [2]])", none) == "[1, 2, 3] [9, 2, 3] True True\n";
  #assert rlm_test_eval(mem[..], r[..], "", "total = 0\nfor i in range(1, 10, 3):\n    total += i\nprint(total, list(range(3)), len(range(0, 10, 4)))", none) == "12 [0, 1, 2] 3\n";
}

#test "the environment's context helpers: lines, chunks at line ends, grep, files and doc" {
  mem: [1] RlmTestMem; r: [1] Rs; none := mem[0].none[0..<0];
  ctx := "alpha 1\nbeta 22\ngamma 3\ndelta 44\n";
  #assert rlm_test_eval(mem[..], r[..], ctx, "print(len(context.splitlines()), grep('\\\\d\\\\d$', context))", none) == "4 ['beta 22', 'delta 44']\n";
  // pieces of at most 18 bytes, cut after a newline in their second half
  #assert rlm_test_eval(mem[..], r[..], ctx, "print(chunk(context, 18))", none) == "['alpha 1\\nbeta 22\\n', 'gamma 3\\ndelta 44\\n']\n";
  #assert rlm_test_eval(mem[..], r[..], ctx, "print(len(chunk(context, 5)), ''.join(chunk(context, 5)) == context)", none) == "8 True\n";
  #assert rlm_test_eval(mem[..], r[..], ctx, "print(SHOW_VARS())", none) == "['context']\n";
}

#test "the environment refuses what it does not have, and every failure is a message, not a trap" {
  mem: [1] RlmTestMem; r: [1] Rs; none := mem[0].none[0..<0];
  #assert rlm_test_eval(mem[..], r[..], "", "print(nope)", none) == "Error: line 1: name 'nope' is not defined";
  #assert rlm_test_eval(mem[..], r[..], "", "x = [1]\nprint(x[5])", none) == "Error: line 2: list index out of range";
  #assert rlm_test_eval(mem[..], r[..], "", "print(1 // 0)", none) == "Error: line 1: division by zero";
  #assert rlm_test_eval(mem[..], r[..], "", "def f():\n    pass", none) == "Error: line 1: 'def' is not supported in this REPL: write the steps inline with loops";
  #assert rlm_test_eval(mem[..], r[..], "", "f = open('/etc/passwd')", none) == "Error: line 1: open() is not available: the context is in `context` (and doc(path) for a file of it)";
  #assert rlm_test_eval(mem[..], r[..], "", "x = 3000000000 * 3000000000", none) == "Error: line 1: an integer is too large";
  #assert rlm_test_eval(mem[..], r[..], "", "while True:\n    pass", none) == "Error: line 1: the step limit (the block ran too long; is a loop endless?)";
  #assert rlm_test_eval(mem[..], r[..], "abc", "context = 'x'", none) == "Error: line 1: 'context' is read-only: copy it into a variable of your own";
  #assert rlm_test_eval(mem[..], r[..], "", "x = 1.5", none) == "Error: line 1: floats are not supported: use integers (/ and // both floor)";
  #assert rlm_test_eval(mem[..], r[..], "", "if True:\nprint(1)", none) == "Error: line 2: expected an indented block";
  #assert rlm_test_eval(mem[..], r[..], "", "print('a' + 1)", none) == "Error: line 1: unsupported operand types: str and int";
  #assert rlm_test_eval(mem[..], r[..], "", "s = 'x' * 300000", none) == "Error: the memory limit (the run's arena is full)";
}

#test "a sub-model call suspends the block; it runs again with the answers, and what it did before the call is not done twice" {
  mem: [1] RlmTestMem; r: [1] Rs;
  subs := [4] string.["ONE", "TWO", "A", "B"];
  src := "log = []\nlog.append('start')\nx = llm_query('first')\nlog.append(x)\ny = llm_query_batched(['p', 'q'])\nprint(log, y, llm_query('last'))";
  #assert rlm_test_eval(mem[..], r[..], "", src, subs[..]) == "['start', 'ONE'] ['TWO', 'A'] B\n";
  st := mem[0].st[..];
  #assert st[0].sub_calls == 4 && st[0].reruns == 3 && st[0].model[0].nsub == 4;
  // the memo is the block's: a later block asks again
  #assert r[0].nmemo == 0 && st[0].top_c == 0;
}

#test "a run: the root looks, then chunks the context, asks the sub-model per chunk in one batch and ends with FINAL" {
  mb: [1] RlmTestMem; rb: [1] Rs; mem := mb[..]; r := rb[..]; st := mem[0].st[..];
  roots := [2] string.[
    "Let me look.\n```repl\nprint(len(context), context[:12])\n```",
    "Now each chunk.\n```repl\nparts = chunk(context, 16)\nans = llm_query_batched([f'count apples: {p}' for p in parts])\ntotal = sum([int(a) for a in ans])\nFINAL(f'{total} apples')\n```"];
  subs := [5] string.["1", "1", "1", "0", "0"];   // five chunks: one line each
  rlm_test_run(r, mem, RlmLimits.{}, roots[..], subs[..]);
  rlm_set_context(r, "apple pear\napple fig\nkiwi apple\nplum plum\nfig fig\n");
  rlm_run(r, st, "How many apples?");
  #assert st[0].answer == "3 apples" && st[0].stop == RLM_OK && st[0].failed == "";
  #assert st[0].root_calls == 2 && st[0].sub_calls == 5 && st[0].turns == 2 && st[0].deepest == 0;
  // the second turn saw the first's output
  #assert rs_find_sub(st[0].msgs[2].text, "REPL output:\n50 apple pear\na\n", 0) == 0;
  #assert rs_count_sub(st[0].msgs[2].text, "Turn 2/20:") == 1;
  // priced on the card: the sub prompts "count apples: " plus their chunk, one-byte answers, on Flash
  #assert st[0].sub_usd_micros > 0 && st[0].root_usd_micros > 0 && st[0].spent.usd_micros == st[0].sub_usd_micros + st[0].root_usd_micros;
  #assert st[0].spent.calls == 7 && st[0].in_tokens == st[0].root_in + st[0].sub_in;
  #assert rs_find_sub(cast(string) st[0].trace[0..<st[0].ntr], "--- final ---\n3 apples", 0) > 0;
}

#test "a final answer outside code: FINAL(...) and FINAL_VAR(name), and a reply with neither gets a note" {
  mb: [1] RlmTestMem; rb: [1] Rs; mem := mb[..]; r := rb[..]; st := mem[0].st[..];
  roots := [3] string.["```repl\nbest = 'forty-two'\n```", "I am thinking.", "The answer is ready.\nFINAL_VAR(best)"];
  rlm_test_run(r, mem, RlmLimits.{}, roots[..], mem[0].none[0..<0]);
  rlm_set_context(r, "x");
  rlm_run(r, st, "What?");
  #assert st[0].answer == "forty-two" && st[0].root_calls == 3;
  #assert rs_find_sub(st[0].msgs[4].text, "There is no ```repl block in your answer.", 0) == 0;
  roots2 := [2] string.["```repl\nprint(context)\n```", "FINAL(\"it is x\")"];
  rlm_test_run(r, mem, RlmLimits.{}, roots2[..], mem[0].none[0..<0]);
  rlm_set_context(r, "x");
  rlm_run(r, st, "What?");
  #assert st[0].answer == "it is x";
}

#test "out of turns: one closing call gives the answer" {
  mb: [1] RlmTestMem; rb: [1] Rs; mem := mb[..]; r := rb[..]; st := mem[0].st[..];
  roots := [3] string.["```repl\nprint(1)\n```", "```repl\nprint(2)\n```", "FINAL(my best guess)"];
  rlm_test_run(r, mem, RlmLimits.{max_turns = 2}, roots[..], mem[0].none[0..<0]);
  rlm_set_context(r, "x");
  rlm_run(r, st, "What?");
  #assert st[0].answer == "my best guess" && st[0].root_calls == 3 && st[0].turns == 2;
  #assert rs_find_sub(st[0].msgs[st[0].nm - 1].text, "You are out of turns.", 0) == 0;
}

#test "limits: calls, cost and time stop the run, and the block that hit one says which" {
  mb: [1] RlmTestMem; rb: [1] Rs; mem := mb[..]; r := rb[..]; st := mem[0].st[..];
  roots := [2] string.["```repl\na = llm_query('one')\nb = llm_query('two')\nFINAL(a + b)\n```", "FINAL(never)"];
  subs := [2] string.["1", "2"];
  // two calls allowed: the root's and one sub-call
  rlm_test_run(r, mem, RlmLimits.{max_calls = 2}, roots[..], subs[..]);
  rlm_set_context(r, "x");
  rlm_run(r, st, "Sum?");
  #assert st[0].answer == "" && st[0].stop == RLM_STOP_CALLS && st[0].sub_calls == 1 && st[0].root_calls == 1;
  #assert rs_find_sub(cast(string) st[0].trace[0..<st[0].ntr], "Error: line 2: the sub-call was refused: the call limit was reached", 0) > 0;
  // a cost cap below the second root call's floor
  rlm_test_run(r, mem, RlmLimits.{max_usd_micros = 5000}, roots[..], subs[..]);
  rlm_set_context(r, "x");
  rlm_run(r, st, "Sum?");
  #assert st[0].answer == "12" && st[0].stop == RLM_OK;
  rlm_test_run(r, mem, RlmLimits.{max_usd_micros = 10}, roots[..], subs[..]);
  rlm_set_context(r, "x");
  rlm_run(r, st, "Sum?");
  #assert st[0].answer == "" && st[0].stop == RLM_STOP_COST && st[0].root_calls == 0 && st[0].spent.calls == 0;
  // time: each scripted call takes a second; two seconds allowed
  rlm_test_run(r, mem, RlmLimits.{max_ms = 2000}, roots[..], subs[..]);
  rlm_set_context(r, "x");
  rlm_run(r, st, "Sum?");
  #assert st[0].stop == RLM_STOP_TIME && st[0].spent.calls == 2 && st[0].answer == "";
}

#test "recursion: at depth 2 rlm_query runs a child RLM in its own frame; at depth 1 it is a plain sub-call" {
  mb: [1] RlmTestMem; rb: [1] Rs; mem := mb[..]; r := rb[..]; st := mem[0].st[..];
  // the child's turn is a root-model call too: it comes from the root list, in order
  roots := [3] string.[
    "```repl\nsecret = 'parent only'\na = rlm_query('data: 5 apples')\nFINAL(a)\n```",
    "```repl\nprint(context)\n```",
    "```repl\nFINAL(context[6:14] + ' ' + str(SHOW_VARS()))\n```"];
  rlm_test_run(r, mem, RlmLimits.{max_depth = 2}, roots[..], mem[0].none[0..<0]);
  rlm_set_context(r, "x");
  rlm_run(r, st, "How many?");
  #assert st[0].answer == "5 apples ['context']" && st[0].child_runs == 1 && st[0].deepest == 1 && st[0].root_calls == 3 && st[0].sub_calls == 0;
  #assert r[0].frame == 0 && st[0].nlev == 0 && st[0].top_c == 0;
  // the root's own variables are back after the child
  #assert rs_find(r, "secret") >= 0;
  // the child's use is its own, the root level's its own, and they add up; its turns are indented in the trace
  #assert st[0].nkids == 1 && st[0].kids[0].turns == 2 && st[0].kids[0].ending == "final" && st[0].kids[0].use.calls == 2 && st[0].d0.calls == 1;
  #assert st[0].d0.input + st[0].kids[0].use.input == st[0].in_tokens && st[0].d0.usd_micros + st[0].kids[0].use.usd_micros == st[0].spent.usd_micros;
  #assert rs_find_sub(cast(string) st[0].trace[0..<st[0].ntr], "\n    === depth 1 turn 1 ===\n    ```repl\n    print(context)\n", 0) > 0;
  subs := [1] string.["plain answer"];
  roots1 := [1] string.["```repl\nFINAL(rlm_query('data'))\n```"];
  rlm_test_run(r, mem, RlmLimits.{max_depth = 1}, roots1[..], subs[..]);
  rlm_set_context(r, "x");
  rlm_run(r, st, "How many?");
  #assert st[0].answer == "plain answer" && st[0].child_runs == 0 && st[0].sub_calls == 1;
}

#test "the model's answer: repl and python blocks in order, other fences skipped; FINAL at a line start" {
  t := "Plan.\n```text\nnot code\n```\n```repl\na = 1\n```\nthen\n```python\nb = 2\n```";
  #assert rlm_block(t, 0).found && rlm_block(t, 0).code == "a = 1\n" && rlm_block(t, 1).code == "b = 2\n" && !rlm_block(t, 2).found;
  #assert !rlm_block("```repl\nno close", 0).found;
  #assert rlm_final("Done.\nFINAL(The answer is (b).)").inner == "The answer is (b)." && rlm_final("  FINAL_VAR(x)").kind == 2;
  #assert rlm_final("I will call FINAL(x) later").kind == 0 && rlm_final("**FINAL(\"q\")**").inner == "q";
}

#test "a root reply the provider refuses is retried with a note, up to three in a row" {
  mb: [1] RlmTestMem; rb: [1] Rs; mem := mb[..]; r := rb[..]; st := mem[0].st[..];
  roots := [3] string.["```repl\nx = 6 * 7\n```", "!refused MALFORMED_FUNCTION_CALL", "FINAL_VAR(x)"];
  rlm_test_run(r, mem, RlmLimits.{}, roots[..], mem[0].none[0..<0]);
  rlm_set_context(r, "x");
  rlm_run(r, st, "What?");
  #assert st[0].answer == "42" && st[0].root_calls == 3 && st[0].failed == "";
  #assert rs_find_sub(st[0].msgs[3].text, "Your last reply could not be read (MALFORMED_FUNCTION_CALL).", 0) == 0;
  roots3 := [4] string.["!refused a", "!refused b", "!refused c", "FINAL(never)"];
  rlm_test_run(r, mem, RlmLimits.{}, roots3[..], mem[0].none[0..<0]);
  rlm_set_context(r, "x");
  rlm_run(r, st, "What?");
  #assert st[0].answer == "" && st[0].root_calls == 3 && st[0].failed == "c";
}

// Runs src as one block with the code environment on, serving its effects from answers in
// order (the caller's fake workspace): what it printed (or "Error: ..."), and each request with
// its zero bytes as '|' in reqs.
RlmFxTest :: struct { reqs: [16] string; n: int; buf: [4096] u8; nb: int; }
rlm_test_fx :: (mem: [] RlmTestMem, r: [] Rs, src: string, answers: [] string, t: [] RlmFxTest) -> string {
  rlm_test_run(r, mem, RlmLimits.{max_steps = 200000}, mem[0].none[0..<0], mem[0].none[0..<0]);
  r[0].env_on = true;
  st := mem[0].st[..];
  st[0].spent = RlmSpent.{};
  x := rlm_push_level(st, "", rs_nil(), 0, 0);
  v := st[0].levels[0..<1];
  v[0].reply = rs_cat(r, rs_cat(r, "```repl\n", src), "\n```");
  v[0].phase = L_BLOCK;
  t[0].n = 0; t[0].nb = 0;
  while !(v[0].phase == L_BLOCK && v[0].k > 0) && v[0].phase != L_CALL && v[0].phase != L_END {
    q := rlm_fx_waiting(r, st);
    if q.count == 0 { rlm_step(r, st); continue; }
    at := t[0].nb;
    for c: q { t[0].buf[t[0].nb] = ifx c == 0 then '|' else c; t[0].nb += 1; }
    t[0].reqs[t[0].n] = cast(string) t[0].buf[at..<t[0].nb];
    rlm_fx_answer(r, st, answers[t[0].n], false);
    t[0].n += 1;
  }
  st[0].nlev = 0;
  if rs_bad(r) { return rs_cat(r, "Error: ", r[0].err); }
  return cast(string) r[0].out[0..<r[0].no];
}

#test "an effect suspends the block as a sub-call does; each is done once, in order, and later passes take it from the memo" {
  mb: [1] RlmTestMem; rb: [1] Rs; t: [1] RlmFxTest; mem := mb[..]; r := rb[..];
  answers := [5] string.["x = 1\n", "     1\ty = 1\n", "2 0\nboom\n", "a.txt\nsub/b.txt\n", "1"];
  src := "log = ['start']\nt = read('a.txt')\nlog.append(t)\nnow = edit('a.txt', 'x', 'y')\nd = sh('make check', seconds=5)\nprint(log, now, d['exit'], d['out'], d['timed_out'], files(), count_lines('a.txt'))";
  out := rlm_test_fx(mem, r, src, answers[..], t[..]);
  #assert out == "['start', 'x = 1\\n']      1\ty = 1\n 2 boom\n False ['a.txt', 'sub/b.txt'] 1\n";
  #assert t[0].n == 5 && mem[0].st[0].reruns == 5;
  #assert t[0].reqs[0] == "read|a.txt" && t[0].reqs[1] == "edit|a.txt|x|y" && t[0].reqs[2] == "sh|make check|5" && t[0].reqs[3] == "files|" && t[0].reqs[4] == "count_lines|a.txt";
  // defaults, keywords, and a timed-out command
  answers2 := [3] string.["a.c:3:foo()\nb.c:9:foo(1)\n", "-1 1\nstarted\n", "     4\tnew\n"];
  out = rlm_test_fx(mem, r, "m = search('foo(', limit=5)\nd = sh('sleep 9')\nprint(len(m), m[1], d['exit'], d['timed_out'], replace_lines('a.c', 4, 4, 'new'))", answers2[..], t[..]);
  #assert out == "2 b.c:9:foo(1) -1 True      4\tnew\n\n" && t[0].reqs[0] == "search|foo(||5|0" && t[0].reqs[1] == "sh|sleep 9|120" && t[0].reqs[2] == "replace_lines|a.c|4|4|new";
  out = rlm_test_fx(mem, r, "print(search('a.b', 'src/', regex=True), write('n.txt', 'hi'), lines('a.c', 2, 3))", answers2[..], t[..]);
  #assert t[0].reqs[0] == "search|a.b|src/|40|1" && t[0].reqs[1] == "write|n.txt|hi" && t[0].reqs[2] == "lines|a.c|2|3";
}

#test "the code environment's functions: wrong arguments are refused before any effect, and without a workspace each one fails" {
  mb: [1] RlmTestMem; rb: [1] Rs; t: [1] RlmFxTest; mem := mb[..]; r := rb[..]; none := mem[0].none[0..<0];
  #assert rlm_test_fx(mem, r, "lines('a.c')", none, t[..]) == "Error: line 1: lines() needs its argument a" && t[0].n == 0;
  #assert rlm_test_fx(mem, r, "search('x', bogus=1)", none, t[..]) == "Error: line 1: search() has no argument bogus";
  #assert rlm_test_fx(mem, r, "read(3)", none, t[..]) == "Error: line 1: read needs a str";
  #assert rlm_test_fx(mem, r, "read('a', 'b')", none, t[..]) == "Error: line 1: read() takes at most one argument";
  #assert rlm_test_fx(mem, r, "edit('a', 'x', new='y', old='z')", none, t[..]) == "Error: line 1: edit() got two values for old";
  #assert rlm_test_fx(mem, r, "f = open('a')", none, t[..]) == "Error: line 1: open() is not available: use read(path), lines(path, a, b) and write(path, text)";
  // a failed effect (the server's refusal) ends the block with its text
  mem[0].st[0].nlev = 0;
  #assert rlm_test_eval(mem, r, "", "print(read('a'))", none) == "Error: line 1: name 'read' is not defined";
  rlm_test_run(r, mem, RlmLimits.{max_steps = 200000}, none, none);
  r[0].env_on = true;
  rlm_test_block(r, mem[0].st[..], "print('before')\nx = read('a')");
  #assert rs_bad(r) && r[0].err == "line 2: this run has no workspace: files, read, edit and sh are not available";
}
