// Admission for the synchronous bounded-file adapter. No OS effects or retries.
#authority;
FR_PATH_MAX :: 4096;
FR_CAP_MAX :: 2147483646;
FrOp :: enum u32 {none=0;open=1;stat=2;read=3;close=4;}
FrFault :: enum u32 {none=0;invalid_path=1;wrong_kind=2;capacity=3;descriptor=4;posix=5;}
FrDetail :: struct {domain:u32;code:int;operation:FrOp;}
FrDecision :: struct {fault:FrFault;value:int;error:FrDetail;}
FrWindow :: struct {decision:FrDecision;probe:bool;offset:int;count:int;}

#forall "file paths reject empty NUL and overlong bytes before acquisition" mode:0..<6 {
 path:[4097]u8;for i:0..<path.count {path[i]=97;}size:=1;
 if mode==0 {size=0;}if mode==2 {size=4096;}if mode==3 {size=4097;}if mode==4 {path[0]=0;}if mode==5 {size=3;path[2]=0;}
 d:=fr_path_policy(cast(string)path[0..<size]);valid:=mode==1 || mode==2;
 #assert (d.fault==FrFault.none)==valid && d.value==0;
 if !valid {#assert d.fault==FrFault.invalid_path && d.error.domain==2 && d.error.code==1 && d.error.operation==FrOp.open;}
}
#forall "file extent admission requires one report slot and a bounded nonnegative output" mode:0..<7 {
 caps:=[7]int.[0,1,2147483646,-1,2147483647,0,0];reports:=[7]int.[1,2,1,1,1,0,-1];d:=fr_extent_policy(caps[mode],reports[mode]);
 #assert (d.fault==FrFault.none)==(mode<3);if mode<3 {#assert d.value==0;}
 if mode>=3 {#assert d.fault==FrFault.descriptor && d.error.domain==2 && d.error.code==4 && d.error.operation==FrOp.open;}
}
#forall "file open and close preserve exact captured errors without negation" mode:0..<6 {
 raw:=[6]int.[0,7,2147483647,2147483648,-5,-9223372036854775807-1];d:=fr_open_policy(raw[mode]);
 if mode<3 {#assert d.fault==FrFault.none && d.value==raw[mode];}
 if mode==3 {#assert d.fault==FrFault.descriptor && d.error.domain==2 && d.error.code==4 && d.error.operation==FrOp.open;}
 if mode>3 {#assert d.fault==FrFault.posix && d.error.domain==1 && d.error.code==raw[mode] && d.error.operation==FrOp.open;}
 c:=fr_close_policy(raw[mode]);
 if mode==0 {#assert c.fault==FrFault.none && c.value==0;}
 if mode>0 && mode<4 {#assert c.fault==FrFault.descriptor && c.error.operation==FrOp.close && c.error.domain==2 && c.error.code==4;}
 if mode>3 {#assert c.fault==FrFault.posix && c.error.domain==1 && c.error.code==raw[mode] && c.error.operation==FrOp.close;}
}
#forall "file stat policy classifies raw mode in Coax and preserves stat errors" mode:0..<10 {
 modes:=[10]int.[32768,33188,16877,0,-1,4294967296,32768,32768,4294967295,32769];sizes:=[10]int.[0,11,0,0,0,0,-1,0,0,0];raw:=ifx mode==7 then -9 else 0;
 d:=fr_stat_policy(raw,modes[mode],sizes[mode]);
 if mode<2 || mode==9 {#assert d.fault==FrFault.none && d.value==0;}
 if mode==2 || mode==3 || mode==8 {#assert d.fault==FrFault.wrong_kind && d.error.domain==2 && d.error.code==2 && d.error.operation==FrOp.stat;}
 if mode>=4 && mode<7 {#assert d.fault==FrFault.descriptor && d.error.domain==2 && d.error.code==4 && d.error.operation==FrOp.stat;}
 if mode==7 {#assert d.fault==FrFault.posix && d.error.domain==1 && d.error.code==-9 && d.error.operation==FrOp.stat;}
 #assert fr_stat_policy(1,32768,0).fault==FrFault.descriptor;
}
#forall "file read windows separate a full output from one owned probe byte" mode:0..<9 {
 used:=[9]int.[0,3,11,0,-1,12,0,0,0];caps:=[9]int.[11,11,11,0,11,11,2147483647,2147483646,-1];w:=fr_window_policy(used[mode],caps[mode]);
 if mode<4 {#assert w.decision.fault==FrFault.none && w.probe==(mode>=2);#assert w.offset==(ifx mode==1 then 3 else 0) && w.count==(ifx mode==0 then 11 else ifx mode==1 then 8 else 1);}
 else if mode==7 {#assert w.decision.fault==FrFault.none && !w.probe && w.offset==0 && w.count==2147483646;}
 else {#assert w.decision.fault==FrFault.descriptor && w.decision.error.domain==2 && w.decision.error.code==4 && w.decision.error.operation==FrOp.read;}
}
#forall "file read counts and exact-fit lookahead have explicit error precedence" mode:0..<12 {
 raw:=[12]int.[0,3,4,-5,0,1,0,0,0,0,0,0];asked:=[12]int.[3,3,3,3,1,1,0,2147483647,2,2147483646,-1,1];probe:=mode==4 || mode==5 || mode==8;d:=fr_read_policy(raw[mode],asked[mode],probe);
 if mode==0 || mode==1 || mode==4 || mode==9 || mode==11 {#assert d.fault==FrFault.none && d.value==raw[mode];}
 if mode==2 || mode==6 || mode==7 || mode==8 || mode==10 {#assert d.fault==FrFault.descriptor && d.error.domain==2 && d.error.code==4 && d.error.operation==FrOp.read;}
 if mode==3 {#assert d.fault==FrFault.posix && d.error.domain==1 && d.error.code==-5 && d.error.operation==FrOp.read;}
 if mode==5 {#assert d.fault==FrFault.capacity && d.error.domain==2 && d.error.code==3 && d.error.operation==FrOp.read;}
}

fr_good :: (value:int)->FrDecision {return FrDecision.{value=value};}
fr_problem :: (fault:FrFault,operation:FrOp)->FrDecision {return FrDecision.{fault=fault,error=FrDetail.{domain=2,code=cast(int)fault,operation=operation}};}
fr_os_error :: (raw:int,operation:FrOp)->FrDecision {return FrDecision.{fault=FrFault.posix,error=FrDetail.{domain=1,code=raw,operation=operation}};}
fr_path_policy :: (path:string)->FrDecision #export_c {
 if path.count<1 || path.count>FR_PATH_MAX {return fr_problem(FrFault.invalid_path,FrOp.open);}
 for byte:path {if byte==0 {return fr_problem(FrFault.invalid_path,FrOp.open);}}
 return fr_good(0);
}
fr_extent_policy :: (capacity:int,reports:int)->FrDecision {
 if capacity<0 || capacity>FR_CAP_MAX || reports<1 {return fr_problem(FrFault.descriptor,FrOp.open);}return fr_good(0);
}
fr_open_policy :: (raw:int)->FrDecision {
 if raw<0 {return fr_os_error(raw,FrOp.open);}if raw>2147483647 {return fr_problem(FrFault.descriptor,FrOp.open);}return fr_good(raw);
}
fr_stat_policy :: (raw:int,mode:int,size:int)->FrDecision {
 if raw<0 {return fr_os_error(raw,FrOp.stat);}
 if raw!=0 || mode<0 || mode>4294967295 || size<0 {return fr_problem(FrFault.descriptor,FrOp.stat);}
 if (mode&61440)!=32768 {return fr_problem(FrFault.wrong_kind,FrOp.stat);}return fr_good(0);
}
fr_window_policy :: (used:int,capacity:int)->FrWindow {
 if used<0 || capacity<0 || used>capacity || capacity>FR_CAP_MAX {return FrWindow.{decision=fr_problem(FrFault.descriptor,FrOp.read)};}
 if used==capacity {return FrWindow.{probe=true,count=1};}return FrWindow.{offset=used,count=capacity-used};
}
fr_read_policy :: (raw:int,requested:int,probe:bool)->FrDecision {
 if requested<1 || requested>FR_CAP_MAX || (probe && requested!=1) {return fr_problem(FrFault.descriptor,FrOp.read);}
 if raw<0 {return fr_os_error(raw,FrOp.read);}if raw>requested {return fr_problem(FrFault.descriptor,FrOp.read);}
 if probe && raw!=0 {return fr_problem(FrFault.capacity,FrOp.read);}return fr_good(raw);
}
fr_close_policy :: (raw:int)->FrDecision {
 if raw<0 {return fr_os_error(raw,FrOp.close);}if raw!=0 {return fr_problem(FrFault.descriptor,FrOp.close);}return fr_good(0);
}
