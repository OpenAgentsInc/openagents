// Shared native qualification effects, extracted from Psionic's construction gate.
// Callers supply a trusted Coax source and exported zero-argument int check entry.
#load "tool.coax";
#load "fs.coax";
#load "proc.coax";
#test "SDK flag words copy into argv and refuse quoted or overflowing output atomically" {
 a:[1]Args;#assert args_add(a[..],"cc") && nc_flags(a[..]," -I/sdk\t-latk\r\n-pthread ") && a[0].n==4 && a[0].v[1]=="-I/sdk" && a[0].v[2]=="-latk" && a[0].v[3]=="-pthread";
 #assert nc_flags(a[..],"head") && a[0].v[4]=="head";
 before:=a[0].n;used:=a[0].used;#assert !nc_flags(a[..],"-O1 '-I/path with space'") && a[0].n==before && a[0].used==used;
 #assert !nc_flags(a[..],"-O1 \"-I/path\"") && a[0].n==before && a[0].used==used;
 #assert !nc_flags(a[..],"-O1 -I/path\\name") && a[0].n==before && a[0].used==used;
 while a[0].n<ARGS_MAX {#assert args_add(a[..],"x");}#assert !nc_flags(a[..],"-O2") && a[0].n==ARGS_MAX && !a[0].full;
}
// pkg-config output in the native SDKs uses plain whitespace-separated words.
// No shell is involved; refuse quoting rather than silently changing an argv.
nc_flags :: (args:[]Args,text:string)->bool {
 old_n:=args[0].n;old_used:=args[0].used;old_full:=args[0].full;from:=0;ok:=true;
 for c,i:text {
  if c=='\'' || c=='"' || c=='\\' {ok=false;break;}
  if c==' ' || c=='\n' || c=='\t' || c=='\r' {
   if i>from && !args_add(args,cast(string)text[from..<i]) {
    ok=false; // mutant: equivalent (without this assignment the final retry is a superset of the refused token, with unchanged capacity, so args_add must refuse again)
    break;
   }
   from=i+1;
  }
 }
 if ok && from<text.count {ok=args_add(args,cast(string)text[from..<text.count]);}
 if !ok {args[0].n=old_n;args[0].used=old_used;args[0].full=old_full;}return ok;
}
nc_run :: (args:[]string,seconds:int,out:[]u8)->int {
  err:[65536]u8;r:=proc_run(args,seconds*1000,out,err[..]);
  if r.started!=0 || r.status!=0 || r.timed_out || r.cut {print("native check failed: executable %, started %, status %, timed out %, cut %, output % bytes\n",args[0],r.started,r.status,r.timed_out,r.cut,r.out_n);tool_errln(cast(string)err[0..<r.err_n]);tool_errln(cast(string)out[0..<r.out_n]);return -1;}
  return r.out_n;
}
nc_qualify :: (source:string,entry:string)->int {
  return nc_qualify_main(source,entry,false);
}
// Large native app states use the existing fork/thread suite driver, whose
// owned large stack keeps one failed case from hiding the remaining cases.
nc_suite :: (source:string)->int {return nc_qualify_main(source,"",true);}
// A large app suite can qualify each compiler mode in a separate bounded job.
nc_suite_mode :: (source:string,mode:int)->int {
 if mode<0 || mode>1 {return 2;}return nc_qualify_modes(source,"",true,mode,mode+1,300);
}
nc_qualify_main :: (source:string,entry:string,suite:bool)->int {
 return nc_qualify_modes(source,entry,suite,0,2,120);
}
nc_qualify_modes :: (source:string,entry:string,suite:bool,first:int,last:int,compile_seconds:int)->int {
  path:[1024]u8;dir:=fs_temp("coax-native-check-",path[..]);#assert dir.count>0;
  cb:[1024]u8;exe:[1024]u8;cpath:=fs_join(dir,"check.c",cb[..]);binary:=fs_join(dir,"check",exe[..]);out:[16777216]u8;
  for mode:first..<last {
    args:=[5]string.["coax/bin/coax","c",source,"--library","--release"];
    n:=nc_run(args[0..<4+mode],120,out[..]);if n<0 {return 1;}
    #assert fs_write(cpath,cast(string)out[0..<n]);
    if !suite {#assert fs_append(cpath,"\nint main(void) { return (int)") && fs_append(cpath,entry) && fs_append(cpath,"(); }\n");}
    for sanitized:0..<2 {
      flags:[14]string;count:=0;for arg:[6]string.["cc","-std=c11",ifx mode==0 then "-O0" else "-O2","-ffp-contract=off","-fno-fast-math",cpath] {flags[count]=arg;count+=1;}
      if suite {flags[count]="coax/web/native-check.c";count+=1;flags[count]="-pthread";count+=1;}
      for arg:[4]string.["-lm","-o",binary,"-g"] {flags[count]=arg;count+=1;}
      if sanitized==1 {flags[count]="-fsanitize=address,undefined";count+=1;flags[count]="-fno-omit-frame-pointer";count+=1;}
      if nc_run(flags[0..<count],compile_seconds,out[..])<0 {return 1;}
      run:=[1]string.[binary];if nc_run(run[..],60,out[..])<0 {return 1;}
      print("native: mode %, sanitizers %: passed\n",mode,sanitized);
    }
  }
  #assert fs_remove(dir);return 0;
}
// Exact evaluator transcript in both modes; the runner strips one trailing LF.
nc_transcript :: (source:string,fixture:string)->int {
  expected:[65536]u8;out:[65536]u8;k:=fs_read(fixture,expected[..]);#assert k>0;
  for mode:0..<2 {
    command:=[4]string.["coax/bin/coax","run",source,"--release"];
    n:=nc_run(command[0..<3+mode],120,out[..]);
    if n<0 || k!=n+1 || expected[k-1]!='\n' || cast(string)out[0..<n]!=cast(string)expected[0..<k-1] {tool_errln("example transcript differs");return 1;}
    print("example transcript: %, release %: passed\n",source,mode);
  }
  return 0;
}
