// The process effects every child-process user shares (coax/platform/process-native.c):
// declared once here, loaded by coax/lib/sys/proc.coax and by the agent SDKs'
// transport (coax/lib/agent/claude/transport.coax), so a program may use both.
cxproc_new :: () -> int #foreign #effects(all);
cxproc_push :: (h: int, field: int, byte: int) -> int #foreign #effects(all);
cxproc_end :: (h: int, field: int) -> int #foreign #effects(all);
cxproc_spawn :: (h: int) -> int #foreign #effects(all);
cxproc_read_line :: (h: int, timeout_ms: int) -> int #foreign #effects(all);
cxproc_line_byte :: (h: int, i: int) -> int #foreign #effects(all);
cxproc_write :: (h: int, byte: int) -> int #foreign #effects(all);
cxproc_flush :: (h: int) -> int #foreign #effects(all);
cxproc_close_stdin :: (h: int) -> int #foreign #effects(all);
cxproc_kill :: (h: int, sig: int) -> int #foreign #effects(all);
cxproc_wait :: (h: int, timeout_ms: int) -> int #foreign #effects(all);
cxproc_pid :: (h: int) -> int #foreign #effects(all);
cxproc_stderr_count :: (h: int) -> int #foreign #effects(all);
cxproc_stderr_byte :: (h: int, i: int) -> int #foreign #effects(all);
cxproc_release :: (h: int) -> int #foreign #effects(all);
cxproc_now_ms :: () -> int #foreign #effects(all);
cxproc_getenv_push :: (byte: int) -> int #foreign #effects(all);
cxproc_getenv :: () -> int #foreign #effects(all);
cxproc_getenv_byte :: (i: int) -> int #foreign #effects(all);
