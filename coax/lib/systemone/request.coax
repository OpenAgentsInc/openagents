// The System One request body: {model, service_tier, state, questions}, the
// wire format Baseten's decision models (mammoth-1, elephant-1), Jev, Clef
// and our gateway share. Written into a caller's buffer; nothing allocates.
//
//   b: [1] SoBody;
//   so_begin(b[..], buf[..], SO_ELEPHANT, "default");
//   so_state_text(b[..], "I was charged twice ...");
//   so_noul(b[..], "refund", "Is the customer asking for a refund?");
//   body := so_finish(b[..]);       // "" when it failed; b[0].problem says why
//
// Calls go in that order: begin, one state, questions, finish. A call out
// of order, a value that doesn't fit or a question the API would refuse
// fails the body, and every later call does nothing.

#load "../nostr/json.coax";

SO_BASETEN_URL :: "https://inference.baseten.co/v1/systemone";
SO_BASETEN_KEY_ENV :: "BASETEN_API_KEY";
SO_ELEPHANT :: "decision-models/baseten-elephant-9b-latest";   // elephant-1, 9B
SO_MAMMOTH :: "decision-models/baseten-mammoth-27b-latest";    // mammoth-1, 27B
SO_CONTEXT_TOKENS :: 16384;      // both models refuse a longer request

SO_MAX_QUESTIONS :: 64;
SO_MAX_OPTIONS :: 255;           // a choice question's options
SO_MIN_LEVELS :: 2;              // a score question's ordered levels
SO_MAX_LEVELS :: 10;

SoKind :: enum u8 { none; choice; noul; score; }

SoBody :: struct {
  buf: [] u8;
  at: int = -1;                  // -1 once the body failed
  stage: int;                    // 1 begun, 2 state written, 3 finished
  problem: string;
  questions: int;
  names: [SO_MAX_QUESTIONS] string;    // borrowed from the caller
  kinds: [SO_MAX_QUESTIONS] SoKind;
  options: [SO_MAX_QUESTIONS] int;     // a choice's options, a score's levels
}

so_fail :: (b: [] SoBody, problem: string) {
  if b[0].at >= 0 { b[0].problem = problem; }
  b[0].at = -1;
}

so_put :: (b: [] SoBody, raw: string) {
  if b[0].at < 0 { return; }
  b[0].at = json_raw(b[0].buf, b[0].at, raw);
  if b[0].at < 0 { b[0].problem = "the request does not fit its buffer"; }
}

so_put_string :: (b: [] SoBody, s: string) {
  if b[0].at < 0 { return; }
  b[0].at = json_write_string(b[0].buf, b[0].at, s);
  if b[0].at < 0 { b[0].problem = "the request does not fit its buffer"; }
}

so_begin :: (b: [] SoBody, buf: [] u8, model: string, service_tier: string) {
  b[0].buf = buf; b[0].at = 0; b[0].stage = 1; b[0].problem = ""; b[0].questions = 0;
  if model.count == 0 { so_fail(b, "no model"); return; }
  so_put(b, "{\"model\":"); so_put_string(b, model);
  if service_tier.count > 0 { so_put(b, ",\"service_tier\":"); so_put_string(b, service_tier); }
}

so_state_open :: (b: [] SoBody) -> bool {
  if b[0].stage != 1 { so_fail(b, "the state comes once, after so_begin"); return false; }
  b[0].stage = 2;
  so_put(b, ",\"state\":");
  return b[0].at >= 0;
}

// Plain text as the state.
so_state_text :: (b: [] SoBody, text: string) {
  if !so_state_open(b) { return; }
  so_put_string(b, text);
  so_put(b, ",\"questions\":{");
}

// A JSON value as the state: an object, an array, or {"messages": [...]}
// for a conversation (images go in its content parts as image_url).
so_state_json :: (b: [] SoBody, json: string) {
  if !so_state_open(b) { return; }
  if !json_valid(json) { so_fail(b, "the state is not valid JSON"); return; }
  so_put(b, json);
  so_put(b, ",\"questions\":{");
}

so_question :: (b: [] SoBody, name: string, kind: SoKind, options: int, instructions: string) -> bool {
  if b[0].at < 0 { return false; }
  if b[0].stage != 2 { so_fail(b, "questions come after the state"); return false; }
  if name.count == 0 { so_fail(b, "a question has no name"); return false; }
  if b[0].questions == SO_MAX_QUESTIONS { so_fail(b, "too many questions"); return false; }
  for i: 0..<b[0].questions { if b[0].names[i] == name { so_fail(b, "two questions share a name"); return false; } }
  k := b[0].questions;
  b[0].names[k] = name; b[0].kinds[k] = kind; b[0].options[k] = options;
  b[0].questions += 1;
  if k > 0 { so_put(b, ","); }
  so_put_string(b, name);
  so_put(b, ifx kind == SoKind.choice then ":{\"type\":\"choice\",\"instructions\":"
            else ifx kind == SoKind.noul then ":{\"type\":\"noul\",\"instructions\":"
            else ":{\"type\":\"score\",\"instructions\":");
  so_put_string(b, instructions);
  return b[0].at >= 0;
}

// Pick one of options: keys[i] is what the answer names, labels[i] says
// what it means to the model.
so_choice :: (b: [] SoBody, name: string, instructions: string, keys: [] string, labels: [] string) {
  if keys.count != labels.count { so_fail(b, "a choice needs one label per key"); return; }
  if keys.count < 1 || keys.count > SO_MAX_OPTIONS { so_fail(b, "a choice takes 1 to 255 options"); return; }
  for i: 0..<keys.count {
    if keys[i].count == 0 { so_fail(b, "a choice option has no key"); return; }
    for j: 0..<i { if keys[j] == keys[i] { so_fail(b, "two choice options share a key"); return; } }
  }
  if !so_question(b, name, SoKind.choice, keys.count, instructions) { return; }
  so_put(b, ",\"criteria\":{");
  for i: 0..<keys.count {
    if i > 0 { so_put(b, ","); }
    so_put_string(b, keys[i]); so_put(b, ":"); so_put_string(b, labels[i]);
  }
  so_put(b, "}}");
}

// A yes/no question; the answer is P(yes).
so_noul :: (b: [] SoBody, name: string, instructions: string) {
  if !so_question(b, name, SoKind.noul, 0, instructions) { return; }
  so_put(b, "}");
}

// Ordered levels, lowest first; the answer is the expected level, 0-based.
so_score :: (b: [] SoBody, name: string, instructions: string, levels: [] string) {
  if levels.count < SO_MIN_LEVELS || levels.count > SO_MAX_LEVELS { so_fail(b, "a score takes 2 to 10 levels"); return; }
  if !so_question(b, name, SoKind.score, levels.count, instructions) { return; }
  so_put(b, ",\"criteria\":[");
  for i: 0..<levels.count {
    if i > 0 { so_put(b, ","); }
    so_put_string(b, levels[i]);
  }
  so_put(b, "]}");
}

// The finished body, or "" (b[0].problem says why).
so_finish :: (b: [] SoBody) -> string {
  if b[0].at < 0 { return ""; }
  if b[0].stage != 2 { so_fail(b, "no state"); return ""; }
  if b[0].questions == 0 { so_fail(b, "no questions"); return ""; }
  so_put(b, "}}");
  if b[0].at < 0 { return ""; }
  b[0].stage = 3;
  return cast(string) b[0].buf[0..<b[0].at];
}

// ---- checks

SO_TEST_BODY :: "{\"model\":\"decision-models/baseten-elephant-9b-latest\",\"service_tier\":\"default\",\"state\":\"I was charged twice for my subscription. Please refund the duplicate charge.\",\"questions\":{\"route\":{\"type\":\"choice\",\"instructions\":\"Which team should handle this request?\",\"criteria\":{\"billing\":\"Billing, payments, and refunds\",\"technical_support\":\"Technical troubleshooting\"}},\"refund\":{\"type\":\"noul\",\"instructions\":\"Is the customer asking for a refund?\"},\"urgency\":{\"type\":\"score\",\"instructions\":\"How urgent is the request?\",\"criteria\":[\"Routine request\",\"Needs attention today\",\"Immediate emergency\"]}}}";

so_test_ticket :: (b: [] SoBody, buf: [] u8) -> string {
  so_begin(b, buf, SO_ELEPHANT, "default");
  so_state_text(b, "I was charged twice for my subscription. Please refund the duplicate charge.");
  keys: [2] string; keys[0] = "billing"; keys[1] = "technical_support";
  labels: [2] string; labels[0] = "Billing, payments, and refunds"; labels[1] = "Technical troubleshooting";
  so_choice(b, "route", "Which team should handle this request?", keys[..], labels[..]);
  so_noul(b, "refund", "Is the customer asking for a refund?");
  levels: [3] string; levels[0] = "Routine request"; levels[1] = "Needs attention today"; levels[2] = "Immediate emergency";
  so_score(b, "urgency", "How urgent is the request?", levels[..]);
  return so_finish(b);
}

#test "the support-ticket example body, byte for byte" {
  buf: [2048] u8; b: [1] SoBody;
  body := so_test_ticket(b[..], buf[..]);
  #assert body == SO_TEST_BODY && json_valid(body) && b[0].questions == 3;
  #assert b[0].kinds[0] == SoKind.choice && b[0].options[0] == 2 && b[0].kinds[2] == SoKind.score && b[0].options[2] == 3;
}

#test "a JSON state goes in as it is; text is escaped; no tier, no key" {
  buf: [512] u8; b: [1] SoBody;
  so_begin(b[..], buf[..], SO_MAMMOTH, "");
  so_state_json(b[..], "{\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}");
  so_noul(b[..], "q\"1", "line\none");
  body := so_finish(b[..]);
  #assert body == "{\"model\":\"decision-models/baseten-mammoth-27b-latest\",\"state\":{\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]},\"questions\":{\"q\\\"1\":{\"type\":\"noul\",\"instructions\":\"line\\none\"}}}";
}

#test "refusals: order, shapes, duplicates, an overfull buffer" {
  buf: [512] u8; b: [1] SoBody;
  so_begin(b[..], buf[..], SO_ELEPHANT, "");
  so_noul(b[..], "early", "?");
  #assert so_finish(b[..]) == "" && b[0].problem == "questions come after the state";
  so_begin(b[..], buf[..], SO_ELEPHANT, "");
  so_state_json(b[..], "{bad");
  #assert so_finish(b[..]) == "" && b[0].problem == "the state is not valid JSON";
  so_begin(b[..], buf[..], SO_ELEPHANT, "");
  so_state_text(b[..], "x");
  #assert so_finish(b[..]) == "" && b[0].problem == "no questions";
  so_begin(b[..], buf[..], SO_ELEPHANT, "");
  so_state_text(b[..], "x");
  one: [1] string; one[0] = "only";
  so_score(b[..], "s", "?", one[..]);
  #assert so_finish(b[..]) == "" && b[0].problem == "a score takes 2 to 10 levels";
  so_begin(b[..], buf[..], SO_ELEPHANT, "");
  so_state_text(b[..], "x");
  so_noul(b[..], "a", "?"); so_noul(b[..], "a", "?");
  #assert so_finish(b[..]) == "" && b[0].problem == "two questions share a name";
  so_begin(b[..], buf[..], SO_ELEPHANT, "");
  so_state_text(b[..], "x");
  twice: [2] string; twice[0] = "k"; twice[1] = "k";
  so_choice(b[..], "c", "?", twice[..], twice[..]);
  #assert so_finish(b[..]) == "" && b[0].problem == "two choice options share a key";
  small: [40] u8;
  so_begin(b[..], small[..], SO_ELEPHANT, "");
  so_state_text(b[..], "x");
  #assert so_finish(b[..]) == "" && b[0].problem == "the request does not fit its buffer";
}
