TbSuiteInfo :: struct {
  id: int;
  slug: string;
  title: string;
  dataset: string;
  count: int;
}

tb_suite_info :: (id: int) -> TbSuiteInfo {
  if id == TB_SUITE_SMOKE {
    return TbSuiteInfo.{id = TB_SUITE_SMOKE, slug = "tb2-smoke", title = "Terminal-Bench 2.0 — Smoke (3 Tasks)", dataset = "terminal-bench@2.0", count = 3};
  }
  if id == TB_SUITE_CROSS {
    return TbSuiteInfo.{id = TB_SUITE_CROSS, slug = "tb2-cross-section", title = "Terminal-Bench 2.0 — Cross-Section (12 Tasks)", dataset = "terminal-bench@2.0", count = 12};
  }
  if id == TB_SUITE_TB2_FULL {
    return TbSuiteInfo.{id = TB_SUITE_TB2_FULL, slug = "tb2-full", title = "Terminal-Bench 2.0 — Full Official Suite (89 Tasks)", dataset = "terminal-bench@2.0", count = 89};
  }
  if id == TB_SUITE_TB21_OOS {
    return TbSuiteInfo.{id = TB_SUITE_TB21_OOS, slug = "tb21-oos", title = "Terminal-Bench 2.1 — Full + OOS Split (89 Tasks)", dataset = "terminal-bench@2.1", count = 89};
  }
  if id == TB_SUITE_TB4_FULL {
    return TbSuiteInfo.{id = TB_SUITE_TB4_FULL, slug = "tb4-full", title = "Terminal-Bench 4.0 — Full Official Suite (66 Tasks)", dataset = "terminal-bench@4.0", count = 66};
  }
  return TbSuiteInfo.{id = TB_SUITE_TB41_FULL, slug = "tb41-full", title = "Terminal-Bench 4.1 — Full Official Suite (66 Tasks)", dataset = "terminal-bench@4.1", count = 66};
}

tb_suite_by_slug :: (slug: string) -> int {
  if slug == "tb2-smoke" || slug == "smoke" { return TB_SUITE_SMOKE; }
  if slug == "tb2-cross-section" || slug == "cross-section" || slug == "cross" { return TB_SUITE_CROSS; }
  if slug == "tb2-full" || slug == "tb2" || slug == "full" { return TB_SUITE_TB2_FULL; }
  if slug == "tb21-oos" || slug == "tb21" { return TB_SUITE_TB21_OOS; }
  if slug == "tb4-full" || slug == "tb4" { return TB_SUITE_TB4_FULL; }
  if slug == "tb41-full" || slug == "tb41" || slug == "tb4.1" { return TB_SUITE_TB41_FULL; }
  return -1;
}

tb_suite_task :: (suite_id: int, idx: int) -> string {
  if idx < 0 { return ""; }
  if suite_id == TB_SUITE_SMOKE && idx < 3 { return TB2_SMOKE_TASKS[idx]; }
  if suite_id == TB_SUITE_CROSS && idx < 12 { return TB2_CROSS_TASKS[idx]; }
  if (suite_id == TB_SUITE_TB2_FULL || suite_id == TB_SUITE_TB21_OOS) && idx < 89 { return TB2_FULL_TASKS[idx]; }
  if (suite_id == TB_SUITE_TB4_FULL || suite_id == TB_SUITE_TB41_FULL) && idx < 66 { return TB4_FULL_TASKS[idx]; }
  return "";
}

// Deterministic train / held-out partition by task index within a suite:
//   - tb2-smoke: 2 train (idx 0,1), 1 held-out (idx 2: regex-log)
//   - tb2-cross-section: 8 train, 4 held-out (idx % 3 == 2)
//   - tb2-full: 60 train, 29 held-out (idx % 3 == 2)
//   - tb21-oos: 24 dev/train (idx < 24), 65 held-out (idx >= 24)
//   - tb4-full: 44 train, 22 held-out (idx % 3 == 2)
tb_suite_partition :: (suite_id: int, idx: int) -> int {
  if suite_id == TB_SUITE_TB21_OOS {
    return ifx idx < 24 then TB_PART_TRAIN else TB_PART_HELDOUT;
  }
  return ifx (idx % 3) == 2 then TB_PART_HELDOUT else TB_PART_TRAIN;
}

tb_partition_name :: (part: int) -> string {
  return ifx part == TB_PART_HELDOUT then "heldout" else "train";
}

#test "tbench suites: official task counts, valid IDs, and train/held-out splits (#13951)" {
  #assert tb_suite_by_slug("tb2-smoke") == TB_SUITE_SMOKE;
  #assert tb_suite_by_slug("tb2-cross-section") == TB_SUITE_CROSS;
  #assert tb_suite_by_slug("tb2-full") == TB_SUITE_TB2_FULL;
  #assert tb_suite_by_slug("tb21-oos") == TB_SUITE_TB21_OOS;
  #assert tb_suite_by_slug("tb4-full") == TB_SUITE_TB4_FULL;
  #assert tb_suite_by_slug("tb41-full") == TB_SUITE_TB41_FULL;
  #assert tb_suite_by_slug("tb4.1") == TB_SUITE_TB41_FULL;
  #assert tb_suite_by_slug("nope") == -1;

  for sid: 0..<TB_SUITE_COUNT {
    info := tb_suite_info(sid);
    #assert info.id == sid;
    #assert tb_valid_dataset(info.dataset);
    #assert tb_valid_slug(info.slug);
    tr := 0; ho := 0;
    for i: 0..<info.count {
      t := tb_suite_task(sid, i);
      #assert tb_valid_task_id(t);
      if tb_suite_partition(sid, i) == TB_PART_TRAIN { tr += 1; } else { ho += 1; }
    }
    #assert tr > 0 && ho > 0 && tr + ho == info.count;
    #assert tb_suite_task(sid, -1) == "";
    #assert tb_suite_task(sid, info.count) == "";
  }
  #assert tb_suite_task(99, 0) == "";
  #assert tb_suite_info(TB_SUITE_TB2_FULL).count == 89;
  #assert tb_suite_info(TB_SUITE_TB4_FULL).count == 66 && tb_suite_info(TB_SUITE_TB4_FULL).slug == "tb4-full";
  #assert tb_suite_info(TB_SUITE_TB41_FULL).count == 66 && tb_suite_info(TB_SUITE_TB41_FULL).slug == "tb41-full";
  #assert tb_suite_task(TB_SUITE_SMOKE, 0) == "fix-git";
  #assert tb_suite_partition(TB_SUITE_SMOKE, 2) == TB_PART_HELDOUT;
}
