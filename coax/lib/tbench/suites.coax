// Official Terminal-Bench Suite Registry & Deterministic Train/Held-Out Partitions
// (Epic #13950, Phase 1 #13951, Phase 3 #13953).
//
// Carries the exact official task lists for:
//   - tb2-smoke         (3 tasks: 2 train, 1 held-out)
//   - tb2-cross-section (12 tasks: 8 train, 4 held-out)
//   - tb2-full          (89 official Terminal-Bench 2.0 tasks: 60 train, 29 held-out)
//   - tb21-oos          (89 official Terminal-Bench 2.1 tasks: 24 dev, 65 held-out)
//   - tb4-full          (66 official Terminal-Bench 4.0 tasks: 44 train, 22 held-out)
//   - tb41-full         (66 official Terminal-Bench 4.1 tasks: 44 train, 22 held-out)
//
//   coax/bin/coax test coax/lib/tbench/suites.coax --library
#load "policy.coax";

TB_PART_TRAIN :: 0;
TB_PART_HELDOUT :: 1;

TB_SUITE_SMOKE :: 0;
TB_SUITE_CROSS :: 1;
TB_SUITE_TB2_FULL :: 2;
TB_SUITE_TB21_OOS :: 3;
TB_SUITE_TB4_FULL :: 4;
TB_SUITE_TB41_FULL :: 5;
TB_SUITE_COUNT :: 6;

TB2_SMOKE_TASKS :: [3] string.[
  "fix-git",
  "log-summary-date-ranges",
  "regex-log",
];

