// Golden byte checker for Terminal-Bench Gym & Hillclimbing wire shapes
// (proto/coder/tbench-gym-v1.json; Epic #13950, #13951, #13953).
// Reads every golden record in the profile through coax/lib/tbench/wire.coax,
// re-serializes it byte-for-byte, and verifies every malformed record in "refused" is rejected.
//
//   coax/web/tool.sh coax/lib/tbench/wire-checks.coax proto/coder/tbench-gym-v1.json
#import "Basic";
#load "wire.coax";
#load "../sys/tool.coax";
#load "../sys/args.coax";
#load "../sys/fs.coax";

TbwcWork :: struct {
  file: [1048576] u8;
  nodes: [32768] JvNode;
  cnodes: [8192] JvNode;
  line: [32768] u8;
  back: [32768] u8;
  kind: [64] u8;
  pol: [1] TbPolicy;
  tr: [1] TbTrialRecord;
  cmp: [1] TbCompareDoc;
  hc: [1] TbHillclimbRound;
  checked: int;
  failed: int;
}

tbwc_roundtrip :: (w: [] TbwcWork, kind: string, line: string) -> bool #effects(all) {
  k := -1;
  if kind == TB_SCHEMA_POLICY {
    if !tbw_policy_parse(line, w[0].pol[..]) { return false; }
    k = tbw_policy_write(w[0].pol[..], w[0].back[..]);
  } else if kind == TB_SCHEMA_TRIAL {
    if !tbw_trial_parse(line, w[0].tr[..]) { return false; }
    k = tbw_trial_write(w[0].tr[..], w[0].back[..]);
  } else if kind == TB_SCHEMA_COMPARE {
    if !tbw_compare_parse(line, w[0].cmp[..], w[0].cnodes[..]) { return false; }
    k = tbw_compare_write(
      cast(string) w[0].cmp[0].run_id[0..<w[0].cmp[0].run_id_n],
      cast(string) w[0].cmp[0].timestamp[0..<w[0].cmp[0].timestamp_n],
      cast(string) w[0].cmp[0].suite[0..<w[0].cmp[0].suite_n],
      cast(string) w[0].cmp[0].dataset[0..<w[0].cmp[0].dataset_n],
      w[0].cmp[0].arm_a[..], w[0].cmp[0].rows_a[..], w[0].cmp[0].n_a,
      w[0].cmp[0].arm_b[..], w[0].cmp[0].rows_b[..], w[0].cmp[0].n_b,
      w[0].back[..]
    );
  } else if kind == TB_SCHEMA_HILLCLIMB {
    if !tbw_hillclimb_parse(line, w[0].hc[..]) { return false; }
    k = tbw_hillclimb_write(w[0].hc[..], w[0].back[..]);
  } else {
    return false;
  }
  return k == line.count && cast(string) w[0].back[0..<k] == line;
}

tbwc_accepts_any :: (w: [] TbwcWork, line: string) -> bool #effects(all) {
  return tbw_policy_parse(line, w[0].pol[..])
    || tbw_trial_parse(line, w[0].tr[..])
    || tbw_compare_parse(line, w[0].cmp[..], w[0].cnodes[..])
    || tbw_hillclimb_parse(line, w[0].hc[..]);
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args; _ = args_load(args[..]);
  path := args_at(args[..], 0);
  if path.count == 0 { path = "proto/coder/tbench-gym-v1.json"; }
  w: [1] TbwcWork;
  n := fs_read(path, w[0].file[..]);
  if n <= 0 { tool_errln("tbench wire-checks: cannot read profile"); return 1; }
  jd: [1] Jv;
  if !jv_parse(jd[..], cast(string) w[0].file[0..<n], w[0].nodes[..]) {
    tool_errln("tbench wire-checks: profile is not valid JSON");
    return 1;
  }
  d := jd[0];
  goldens := jv_get(d, 0, "goldens");
  seen := [4] bool.[false, false, false, false];
  schemas := [4] string.[TB_SCHEMA_POLICY, TB_SCHEMA_TRIAL, TB_SCHEMA_COMPARE, TB_SCHEMA_HILLCLIMB];
  for i: 0..<jv_len(d, goldens) {
    e := jv_at(d, goldens, i);
    kn := jv_str(d, jv_get(d, e, "schema"), w[0].kind[..]);
    ln := jv_str(d, jv_get(d, e, "line"), w[0].line[..]);
    if kn <= 0 || ln <= 0 { w[0].failed += 1; continue; }
    kind := cast(string) w[0].kind[0..<kn];
    line := cast(string) w[0].line[0..<ln];
    w[0].checked += 1;
    if !tbwc_roundtrip(w[..], kind, line) {
      tool_err("tbench wire-checks: roundtrip mismatch for "); tool_errln(kind);
      w[0].failed += 1;
    } else {
      for s: 0..<4 { if schemas[s] == kind { seen[s] = true; } }
    }
  }
  for s: 0..<4 {
    if !seen[s] {
      tool_err("tbench wire-checks: missing golden for "); tool_errln(schemas[s]);
      w[0].failed += 1;
    }
  }
  refused := jv_get(d, 0, "refused");
  for i: 0..<jv_len(d, refused) {
    ln := jv_str(d, jv_at(d, refused, i), w[0].line[..]);
    if ln < 0 { continue; }
    w[0].checked += 1;
    if tbwc_accepts_any(w[..], cast(string) w[0].line[0..<ln]) {
      tool_errln("tbench wire-checks: malformed record unexpectedly accepted");
      w[0].failed += 1;
    }
  }
  if w[0].failed > 0 { return 1; }
  print("tbench wire-checks: ok (% vectors)\n", w[0].checked);
  return 0;
}
