// Base64 (RFC 4648, standard alphabet, padded) for Coax tools: DevTools
// screenshots, data URLs, API bodies. Into a caller's buffer; nothing
// allocates. Decoding takes what browsers and servers send: padding may be
// missing, and ASCII whitespace is skipped. (coax/lib/nostr/base64.coax is
// the strict, canonical-only codec the Nostr modules need.)
#authority;

B64_CHARS :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

#test "RFC 4648 vectors, both ways" {
  plain := [7] string.["", "f", "fo", "foo", "foob", "fooba", "foobar"];
  codes := [7] string.["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy"];
  for i: 0..<7 {
    out: [16] u8; back: [8] u8;
    n := b64_encode(plain[i], out[..]);
    #assert n == codes[i].count && cast(string) out[0..<n] == codes[i] && b64_encoded_size(plain[i].count) == n;
    k := b64_decode(codes[i], back[..]);
    #assert k == plain[i].count && cast(string) back[0..<k] == plain[i];
  }
  out: [4] u8;
  #assert b64_encode("foob", out[..]) == -1 && b64_decode("Zm9vYg==", out[0..<1]) == -1;
}
#test "decoding: unpadded, whitespace, every byte, refusals" {
  out: [8] u8;
  #assert b64_decode("Zm8", out[..]) == 2 && b64_decode("Zg", out[..]) == 1 && b64_decode("Zm9v\nYmFy\r\n", out[..]) == 6;
  #assert b64_decode("Z", out[..]) == -1 && b64_decode("Zm9v!", out[..]) == -1 && b64_decode("Zg=a", out[..]) == -1;
  #assert b64_decode("=", out[..]) == -1 && b64_decode("Zg===", out[..]) == -1 && b64_decode("-_", out[..]) == -1;
  #assert b64_decode("Zg==Zg==", out[..]) == -1 && b64_decode(" ", out[..]) == 0;
  #assert b64_decoded_max(0) == 0 && b64_decoded_max(4) == 3 && b64_decoded_max(5) == 6;
  all: [256] u8; text: [344] u8; back: [256] u8;
  for i: 0..<256 { all[i] = cast(u8) i; }
  n := b64_encode(cast(string) all[..], text[..]);
  #assert n == 344 && b64_decode(cast(string) text[0..<n], back[..]) == 256;
  for i: 0..<256 { #assert back[i] == cast(u8) i; }
  #assert b64_value('A') == 0 && b64_value('/') == 63 && b64_value('+') == 62 && b64_value('a') == 26 && b64_value('9') == 61 && b64_value('-') == -1;
}
b64_encoded_size :: (n: int) -> int { return (n + 2) / 3 * 4; }
// At most how many bytes text of n characters decodes to.
b64_decoded_max :: (n: int) -> int { return (n + 3) / 4 * 3; }
// input as padded base64 into out: the length, or -1 when out is too small.
b64_encode :: (input: string, out: [] u8) -> int {
  needed := b64_encoded_size(input.count);
  if out.count < needed { return -1; }
  at := 0; w := 0;
  while at < input.count {
    word := cast(u32) input[at] << 16;
    if at + 1 < input.count { word = word | (cast(u32) input[at + 1] << 8); }
    if at + 2 < input.count { word = word | cast(u32) input[at + 2]; }
    out[w] = B64_CHARS[word >> 18]; out[w + 1] = B64_CHARS[(word >> 12) & 63];
    out[w + 2] = ifx at + 1 < input.count then B64_CHARS[(word >> 6) & 63] else '=';
    out[w + 3] = ifx at + 2 < input.count then B64_CHARS[word & 63] else '=';
    at += 3; w += 4;
  }
  return needed;
}
b64_value :: (c: u8) -> int {
  if c >= 'A' && c <= 'Z' { return cast(int) (c - 'A'); }
  if c >= 'a' && c <= 'z' { return cast(int) (c - 'a') + 26; }
  if c >= '0' && c <= '9' { return cast(int) (c - '0') + 52; }
  if c == '+' { return 62; }
  if c == '/' { return 63; }
  return -1;
}
// text decoded into out: the length, or -1 when it is not base64 or out is
// too small. Whitespace is skipped; padding is optional but only at the end.
b64_decode :: (text: string, out: [] u8) -> int {
  acc: u32 = 0; bits := 0; n := 0; pad := 0; chars := 0;
  for c: text {
    if c == ' ' || c == '\n' || c == '\r' || c == '\t' { continue; }
    if c == '=' { pad += 1; continue; }
    if pad > 0 { return -1; }
    v := b64_value(c);
    if v < 0 { return -1; }
    chars += 1;
    acc = ((acc << 6) | cast(u32) v) & 0xffffff;
    bits += 6;
    if bits >= 8 {
      bits -= 8;
      if n >= out.count { return -1; }
      out[n] = cast,trunc(u8) (acc >> cast(u32) bits); n += 1;
    }
  }
  tail := chars % 4;
  if tail == 1 || pad > 2 || (pad > 0 && (chars + pad) % 4 != 0) { return -1; }
  return n;
}
