// CSV (RFC 4180) for game data tables: records, fields with quotes, and plain decimal numbers.
// Everything borrows the caller's text; nothing allocates. A quoted field comes back without its
// outer quotes, its doubled quotes ("") still doubled (`csv_unquote` writes the plain text into a
// buffer when a reader needs it). A record may run over several lines inside quotes.
// metaverse-engine/import/unreal/files.coax `uf_field` reads tables with no quoting; this one is
// for tables that quote (Splice Bots' items.csv and robots.csv carry quoted notes).
//   coax/bin/coax test coax/lib/text/csv.coax

// A record: its text (without the line end) and where the next one starts.
CsvRecord :: struct { text: string; next: int; }
// The record starting at byte `at` of `t`. A newline inside quotes stays in the record. A UTF-8
// byte order mark at the very start is skipped; a trailing \r is dropped.
csv_record :: (t: string, at: int) -> CsvRecord {
  from := ifx at == 0 && t.count >= 3 && t[0] == 0xEF && t[1] == 0xBB && t[2] == 0xBF then 3 else at;
  e := from; quoted := false;
  while e < t.count {
    c := t[e];
    if c == '"' { quoted = !quoted; }
    else if c == '\n' && !quoted { break; }
    e += 1;
  }
  end := ifx e > from && t[e - 1] == '\r' then e - 1 else e;
  return CsvRecord.{text = t[from..<end], next = e + 1};
}

// The k-th field of a record (0 first), or "" past the last. `quoted` is true when it was quoted.
CsvField :: struct { text: string; quoted: bool; found: bool; }
csv_field :: (record: string, k: int) -> CsvField {
  i := 0; at := 0;
  while at <= record.count {
    // one field from `at`
    quoted := at < record.count && record[at] == '"';
    e := at; from := at; to := at;
    if quoted {
      e = at + 1;
      while e < record.count {
        if record[e] == '"' {
          if e + 1 < record.count && record[e + 1] == '"' { e += 2; continue; }
          break;
        }
        e += 1;
      }
      from = at + 1; to = ifx e < record.count then e else record.count;
      e = to + 1;   // past the closing quote
      while e < record.count && record[e] != ',' { e += 1; }   // anything after it up to the comma is dropped
    } else {
      while e < record.count && record[e] != ',' { e += 1; }
      to = e;
    }
    if i == k { return CsvField.{text = record[from..<to], quoted = quoted, found = true}; }
    i += 1; at = e + 1;
  }
  return CsvField.{};
}
// The k-th field's text: csv_field(record, k).text.
csv_at :: (record: string, k: int) -> string { return csv_field(record, k).text; }
// How many fields a record has (an empty record has one, empty).
csv_count :: (record: string) -> int {
  n := 0;
  while csv_field(record, n).found { n += 1; }
  return n;
}
// A quoted field's text with each "" written as ", into out. The written text, or "" if out is too small.
csv_unquote :: (field: string, out: [] u8) -> string {
  n := 0; k := 0;
  while k < field.count {
    if n >= out.count { return ""; }
    out[n] = field[k]; n += 1;
    k += ifx field[k] == '"' && k + 1 < field.count && field[k + 1] == '"' then 2 else 1;
  }
  return cast(string) out[0..<n];
}
// The column of a header record named `name`, or -1.
csv_column :: (header: string, name: string) -> int {
  k := 0;
  while true {
    f := csv_field(header, k);
    if !f.found { return -1; }
    if f.text == name { return k; }
    k += 1;
  }
  return -1;
}

// A plain decimal: optional sign, digits, an optional point and digits, an optional exponent.
// Surrounding spaces are allowed. ok is false for an empty or malformed field.
CsvNumber :: struct { ok: bool; v: f64; }
csv_number :: (s: string) -> CsvNumber {
  a := 0; b := s.count;
  while a < b && (s[a] == ' ' || s[a] == '\t') { a += 1; }
  while b > a && (s[b - 1] == ' ' || s[b - 1] == '\t') { b -= 1; }
  if a == b { return CsvNumber.{}; }
  neg := false;
  if s[a] == '-' || s[a] == '+' { neg = s[a] == '-'; a += 1; }
  mant := 0; scale := 0; digits := 0; point := false;
  while a < b {
    c := s[a];
    if c >= '0' && c <= '9' {
      if mant < 100000000000000000 { mant = mant * 10 + cast(int) (c - '0'); if point { scale += 1; } }
      else if !point { scale -= 1; }
      digits += 1;
    } else if c == '.' && !point { point = true; }
    else { break; }
    a += 1;
  }
  if digits == 0 { return CsvNumber.{}; }
  if a < b && (s[a] == 'e' || s[a] == 'E') {
    a += 1; eneg := false;
    if a < b && (s[a] == '-' || s[a] == '+') { eneg = s[a] == '-'; a += 1; }
    ex := 0; ed := 0;
    while a < b && s[a] >= '0' && s[a] <= '9' { if ex < 1000 { ex = ex * 10 + cast(int) (s[a] - '0'); } ed += 1; a += 1; }
    if ed == 0 { return CsvNumber.{}; }
    scale -= ifx eneg then -ex else ex;
  }
  if a != b { return CsvNumber.{}; }
  // An integer mantissa and one division (or product) by an exact power of ten: correctly rounded
  // while both are exact (mantissa under 2^53, the power at most 10^22).
  v := cast(f64) mant;
  p := 1.0; k := ifx scale < 0 then -scale else scale;
  while k > 0 { p *= 10.0; k -= 1; }
  v = ifx scale >= 0 then v / p else v * p;
  return CsvNumber.{ok = true, v = ifx neg then -v else v};
}

#test "records: line ends, a byte order mark, a newline inside quotes" {
  b: [32] u8; body := "a,b\r\nc,\"x\ny\"\nlast";
  b[0] = 0xEF; b[1] = 0xBB; b[2] = 0xBF; for c, i: body { b[3 + i] = c; }
  t := cast(string) b[0..<3 + body.count];
  r := csv_record(t, 0);
  #assert r.text == "a,b";
  r = csv_record(t, r.next);
  #assert r.text == "c,\"x\ny\"" && csv_at(r.text, 1) == "x\ny";
  r = csv_record(t, r.next);
  #assert r.text == "last" && r.next == t.count + 1;
}
#test "fields: plain, empty, quoted with commas and doubled quotes, past the end" {
  rec := "ITEM_A,NAME,,\"one, \"\"two\"\"\",9";
  #assert csv_at(rec, 0) == "ITEM_A" && csv_at(rec, 1) == "NAME" && csv_at(rec, 2) == "";
  f := csv_field(rec, 3);
  #assert f.quoted && f.found && f.text == "one, \"\"two\"\"";
  out: [32] u8;
  #assert csv_unquote(f.text, out[..]) == "one, \"two\"";
  #assert csv_at(rec, 4) == "9" && !csv_field(rec, 5).found && csv_count(rec) == 5;
  #assert csv_count("") == 1 && csv_count("a,") == 2 && csv_at("a,", 1) == "";
  #assert csv_column("item_id,name,stack_size", "stack_size") == 2 && csv_column("a,b", "c") == -1;
  small: [3] u8;
  #assert csv_unquote("abcd", small[..]) == "";
}
#test "numbers: integers, decimals, signs, exponents, refusals" {
  #assert csv_number("64").ok && csv_number("64").v == 64.0;
  #assert csv_number("7.5").v == 7.5 && csv_number(" 1.4 ").v == 1.4 && csv_number("-0.4").v == -0.4;
  #assert csv_number("+3").v == 3.0 && csv_number("1e3").v == 1000.0 && csv_number("2.5E-1").v == 0.25;
  #assert csv_number(".5").v == 0.5 && csv_number("5.").v == 5.0;
  #assert !csv_number("").ok && !csv_number(" ").ok && !csv_number("a").ok && !csv_number("1.2.3").ok;
  #assert !csv_number("1e").ok && !csv_number("-").ok && !csv_number("5 / 18").ok;
}
