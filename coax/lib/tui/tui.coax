// A small terminal UI kit for inline shells (Coder book, Part VI): bytes out
// with escape sequences, UTF-8 and display widths, a key decoder with
// bracketed paste, a multi-line composer, and an inline live region that is
// redrawn at the bottom while finished text goes into the terminal's own
// scrollback above it. No platform code: the program brings the terminal
// (coax/platform/tool-native.c's cxterm_*), so all of this is testable.
// Markdown is read by the one parser every surface shares
// (components/core/markdown.coax, GitHub #13153): what a line is and where
// its spans are come from there; this file writes them as a terminal's
// style sequences.

#load "../../../components/core/markdown.coax";
#load "../../../components/core/edit.coax";         // the composer's text: the one edit buffer
#load "../../../components/backend/terminal.coax";   // a styled line is painted as a display list and written by the terminal backend

// ---------------------------------------------------------------- output

// theme: TUI_THEME_DARK (the default), TUI_THEME_LIGHT for a light
// background, or TUI_THEME_NONE for no colors (NO_COLOR): bold, italic and
// underline only.
TuiOut :: struct { b: [] u8; n: int; theme: int; }
TUI_THEME_DARK :: 0; TUI_THEME_LIGHT :: 1; TUI_THEME_NONE :: 2;
TUI_THEMES :: [3] string.["dark", "light", "none"];

tui_byte :: (o: [] TuiOut, c: int) { if o[0].n < o[0].b.count { o[0].b[o[0].n] = cast,trunc(u8) c; o[0].n += 1; } }
tui_put :: (o: [] TuiOut, s: string) { for c: s { tui_byte(o, cast(int) c); } }
tui_int :: (o: [] TuiOut, v: int) {
  if v < 0 { tui_byte(o, '-'); tui_int(o, -v); return; }
  d: [24] u8; k := 0; x := v;
  if x == 0 { d[0] = '0'; k = 1; }
  while x > 0 { d[k] = cast,trunc(u8) ('0' + x % 10); x = x / 10; k += 1; }
  for i: 0..<k { tui_byte(o, cast(int) d[k - 1 - i]); }
}
// ESC [ s: a control sequence.
tui_csi :: (o: [] TuiOut, s: string) { tui_byte(o, 27); tui_byte(o, '['); tui_put(o, s); }
tui_csi_n :: (o: [] TuiOut, n: int, final: string) { tui_byte(o, 27); tui_byte(o, '['); tui_int(o, n); tui_put(o, final); }
tui_text :: (o: [] TuiOut) -> string { return cast(string) o[0].b[0..<o[0].n]; }

// Styles: the Coder ladder, four intensities of white, and two signal colors.
TUI_PLAIN :: 0; TUI_BRIGHT :: 1; TUI_DIM :: 2; TUI_FAINT :: 3; TUI_RED :: 4; TUI_GREEN :: 5; TUI_AMBER :: 6;

// How a style looks: a face (components/skin/terminal.coax's attribute bits)
// and a colour (an alpha of 0 is the terminal's own). The style sequences are
// written by components/backend/terminal.coax (term_sgr, term_row), never here.
TuiLook :: struct { face: int; fg: Rgba; }
tui_rgb :: (r: int, g: int, b: int) -> Rgba { return rgba(cast(f32) r / 255.0, cast(f32) g / 255.0, cast(f32) b / 255.0, 1); }
tui_own :: () -> Rgba { return rgba(0, 0, 0, 0); }
tui_look :: (face: int, fg: Rgba) -> TuiLook { return TuiLook.{face = face, fg = fg}; }

// A rung of the ladder in a theme. Coder Noir (the desktop app's dark theme):
// text #ededed, muted #818181, faint #656565, danger #ff4d42, success
// #9fd08a, warning #e6c15c; a light background darkens them; none leaves bold.
tui_ladder_look :: (theme: int, s: int) -> TuiLook {
  if s == TUI_PLAIN { return tui_look(TERM_FACE_PLAIN, tui_own()); }
  if theme == TUI_THEME_NONE { return tui_look(ifx s == TUI_BRIGHT || s == TUI_RED then TERM_FACE_BOLD else TERM_FACE_PLAIN, tui_own()); }
  light := theme == TUI_THEME_LIGHT;
  if s == TUI_BRIGHT { return tui_look(TERM_FACE_BOLD, ifx light then tui_rgb(20, 20, 20) else tui_rgb(237, 237, 237)); }
  if s == TUI_DIM { return tui_look(TERM_FACE_PLAIN, ifx light then tui_rgb(95, 95, 95) else tui_rgb(129, 129, 129)); }
  if s == TUI_FAINT { return tui_look(TERM_FACE_PLAIN, ifx light then tui_rgb(150, 150, 150) else tui_rgb(101, 101, 101)); }
  if s == TUI_RED { return tui_look(TERM_FACE_PLAIN, ifx light then tui_rgb(190, 40, 40) else tui_rgb(255, 77, 66)); }
  if s == TUI_GREEN { return tui_look(TERM_FACE_PLAIN, ifx light then tui_rgb(30, 130, 60) else tui_rgb(159, 208, 138)); }
  if s == TUI_AMBER { return tui_look(TERM_FACE_PLAIN, ifx light then tui_rgb(150, 100, 0) else tui_rgb(230, 193, 92)); }
  return tui_look(TERM_FACE_PLAIN, tui_own());
}

// A look's style sequence into o.
tui_sgr :: (o: [] TuiOut, look: TuiLook) {
  b: [64] u8;
  k := term_sgr(b[..], 0, look.face, look.fg, tui_own());
  tui_put(o, cast(string) b[0..<k]);
}
tui_style :: (o: [] TuiOut, s: int) { tui_sgr(o, tui_ladder_look(o[0].theme, s)); }

// ---------------------------------------------------------------- painting

// A styled line is painted, not written: its runs are the component system's
// display list in cells (components/paint/list.coax: a text run, a box for a
// background), drawn into a row of cells and written with its style sequences
// by components/backend/terminal.coax (term_draw, term_row). A line of any
// length is painted a window of TUI_PAINT_COLS columns at a time.
TUI_PAINT_COLS :: 256;
TUI_PAINT_PRIMS :: 96;
TUI_PAINT_POOL :: 8192;
TuiPaint :: struct {
  o: [] TuiOut;
  list: [TUI_PAINT_PRIMS] Prim; n: int;
  col: int; base: int;           // the line's columns so far, and where the window starts
  limit: int;                    // the columns the line may take (0: any); what is past it is cut
  pool: [TUI_PAINT_POOL] u8; np: int;   // the window's text, copied: a run's text may live only in its caller
}

tui_paint :: (p: [] TuiPaint, o: [] TuiOut, limit: int) { p[0].o = o; p[0].n = 0; p[0].np = 0; p[0].col = 0; p[0].base = 0; p[0].limit = limit; }

// The window's runs into o, through the terminal backend.
tui_paint_flush :: (p: [] TuiPaint) {
  if p[0].n > 0 {
    cells: [TUI_PAINT_COLS] TermCell;
    g := term_grid(cells[..], TUI_PAINT_COLS, 1);
    term_draw(g, p[0].list[0..<p[0].n], 0, 0);
    b: [8192] u8;
    k := term_row(g, 0, b[..]);
    tui_put(p[0].o, cast(string) b[0..<k]);
  }
  p[0].n = 0; p[0].np = 0; p[0].base = p[0].col;
}

// A run of text in a look, on a background (an alpha of 0: none).
tui_paint_text :: (p: [] TuiPaint, look: TuiLook, bg: Rgba, text: string) {
  at := 0;
  for guard: 0..<text.count + 1 {
    if at >= text.count { return; }
    room := TUI_PAINT_COLS - (p[0].col - p[0].base);
    cap := ifx p[0].limit > 0 then p[0].limit - p[0].col else room;
    if cap <= 0 { return; }
    if room <= 0 || p[0].n + 2 > TUI_PAINT_PRIMS || p[0].np >= TUI_PAINT_POOL { tui_paint_flush(p); continue; }
    piece := cast(string) text[at..<text.count];
    if piece.count > TUI_PAINT_POOL - p[0].np { piece = cast(string) piece[0..<TUI_PAINT_POOL - p[0].np]; }
    first := p[0].col == p[0].base;      // nothing before it in the window's row
    take := term_text_fit(piece, ifx cap < room then cap else room, first);
    if take == 0 {
      if p[0].limit > 0 && cap <= room { return; }       // what is left is past the limit
      if p[0].col > p[0].base { tui_paint_flush(p); continue; }
      take = cluster_len(piece, 0);
    }
    for k: 0..<take { p[0].pool[p[0].np + k] = piece[k]; }
    seg := cast(string) p[0].pool[p[0].np..<p[0].np + take];
    p[0].np += take;
    w := term_text_cells(seg, first);
    x := cast(f32) (p[0].col - p[0].base);
    if bg.a > 0 { p[0].n = prim_fill(p[0].list[..], p[0].n, x, 0, cast(f32) w, 1, 0, bg); }
    p[0].n = prim_text(p[0].list[..], p[0].n, x, 0, cast(f32) w, 1, look.face, look.fg, seg);
    p[0].col += w; at += take;
  }
}
tui_paint_spaces :: (p: [] TuiPaint, look: TuiLook, bg: Rgba, count: int) {
  sp := "                                                                ";
  left := count;
  while left > 0 { k := ifx left < sp.count then left else sp.count; tui_paint_text(p, look, bg, cast(string) sp[0..<k]); left -= k; }
}

// The theme a name means, or -1.
tui_theme_of :: (name: string) -> int {
  themes := TUI_THEMES;
  for t, i: themes { if t == name { return i; } }
  return -1;
}

// ---------------------------------------------------------------- UTF-8 and widths

TuiRune :: struct { cp: int; len: int; }

// The code point at s[i]; a bad byte reads as U+FFFD of length 1.
tui_rune :: (s: string, i: int) -> TuiRune {
  c := cast(int) s[i];
  if c < 0x80 { return TuiRune.{cp = c, len = 1}; }
  k := 0; cp := 0;
  if c >= 0xf0 && c < 0xf8 { k = 4; cp = c & 7; }
  else if c >= 0xe0 { k = 3; cp = c & 15; }
  else if c >= 0xc0 { k = 2; cp = c & 31; }
  if k == 0 || i + k > s.count { return TuiRune.{cp = 0xfffd, len = 1}; }
  for j: 1..<k {
    d := cast(int) s[i + j];
    if (d & 0xc0) != 0x80 { return TuiRune.{cp = 0xfffd, len = 1}; }
    cp = (cp << 6) | (d & 63);
  }
  return TuiRune.{cp = cp, len = k};
}

// Columns a code point takes: 0 for combining marks and joiners, 2 for wide
// East Asian and emoji ranges, 1 otherwise. A short table, not full UAX #11.
tui_width :: (cp: int) -> int {
  if cp < 32 || cp == 127 { return 0; }
  if (cp >= 0x300 && cp <= 0x36f) || (cp >= 0x200b && cp <= 0x200f) || (cp >= 0xfe00 && cp <= 0xfe0f) || (cp >= 0x1f3fb && cp <= 0x1f3ff) { return 0; }
  if (cp >= 0x1100 && cp <= 0x115f) || (cp >= 0x2e80 && cp <= 0xa4cf) || (cp >= 0xac00 && cp <= 0xd7a3) || (cp >= 0xf900 && cp <= 0xfaff) { return 2; }
  if (cp >= 0xfe30 && cp <= 0xfe4f) || (cp >= 0xff00 && cp <= 0xff60) || (cp >= 0xffe0 && cp <= 0xffe6) { return 2; }
  if (cp >= 0x1f300 && cp <= 0x1f64f) || (cp >= 0x1f900 && cp <= 0x1faff) || (cp >= 0x20000 && cp <= 0x3fffd) { return 2; }
  return 1;
}

// The length of an escape sequence (ESC [ ... final) at s[i], or 0. Text
// may carry style sequences; they take no columns and are never split.
tui_esc_len :: (s: string, i: int) -> int {
  if s[i] != 27 || i + 1 >= s.count || s[i + 1] != '[' { return 0; }
  j := i + 2;
  while j < s.count && (s[j] < 0x40 || s[j] > 0x7e) { j += 1; }
  return ifx j < s.count then j + 1 - i else s.count - i;
}

tui_text_width :: (s: string) -> int {
  w := 0; i := 0;
  while i < s.count {
    e := tui_esc_len(s, i);
    if e > 0 { i += e; continue; }
    r := tui_rune(s, i); w += tui_width(r.cp); i += r.len;
  }
  return w;
}

// The longest prefix of s that fits in cols columns, in bytes.
tui_fit :: (s: string, cols: int) -> int {
  w := 0; i := 0;
  while i < s.count {
    e := tui_esc_len(s, i);
    if e > 0 { i += e; continue; }
    r := tui_rune(s, i);
    cw := tui_width(r.cp);
    if w + cw > cols { break; }
    w += cw; i += r.len;
  }
  return i;
}

// ---------------------------------------------------------------- keys

TUI_K_NONE :: 0; TUI_K_CHAR :: 1; TUI_K_ENTER :: 2; TUI_K_NEWLINE :: 3; TUI_K_BACKSPACE :: 4; TUI_K_DELETE :: 5;
TUI_K_LEFT :: 6; TUI_K_RIGHT :: 7; TUI_K_UP :: 8; TUI_K_DOWN :: 9; TUI_K_HOME :: 10; TUI_K_END :: 11;
TUI_K_CTRL_C :: 12; TUI_K_CTRL_D :: 13; TUI_K_KILL_LINE :: 14; TUI_K_KILL_END :: 15; TUI_K_KILL_WORD :: 16;
TUI_K_ESC :: 17; TUI_K_WORD_LEFT :: 18; TUI_K_WORD_RIGHT :: 19; TUI_K_TAB :: 20; TUI_K_CLEAR :: 21; TUI_K_PASTE :: 22; TUI_K_BACKTAB :: 23;
// Another control key (cp: its byte, 0 for Ctrl-Space), Undo (Ctrl-Z or Ctrl-_), and the
// terminal's focus reports (CSI I and CSI O, sent while focus reporting, CSI ? 1004 h, is on).
TUI_K_CTRL_KEY :: 24; TUI_K_UNDO :: 25; TUI_K_FOCUS_IN :: 26; TUI_K_FOCUS_OUT :: 27;

// A key; for TUI_K_CHAR, cp; for TUI_K_PASTE, text (into the decoder's paste buffer).
TuiKey :: struct { kind: int; cp: int; text: string; }
TuiKeyRead :: struct { key: TuiKey; used: int; }   // used 0: need more bytes

TuiKeys :: struct {
  pasting: bool;
  paste: [65536] u8; np: int;
}

tui_named :: (kind: int, used: int) -> TuiKeyRead { return TuiKeyRead.{key = TuiKey.{kind = kind}, used = used}; }

// The key a control byte stands for, taking `used` bytes; used 0 when the
// byte is not one of them.
tui_ctrl :: (c: int, used: int) -> TuiKeyRead {
  if c == 13 { return tui_named(TUI_K_ENTER, used); }
  if c == 10 { return tui_named(TUI_K_NEWLINE, used); }        // Ctrl-J
  if c == 127 || c == 8 { return tui_named(TUI_K_BACKSPACE, used); }
  if c == 9 { return tui_named(TUI_K_TAB, used); }
  if c == 1 { return tui_named(TUI_K_HOME, used); }            // Ctrl-A
  if c == 5 { return tui_named(TUI_K_END, used); }             // Ctrl-E
  if c == 2 { return tui_named(TUI_K_LEFT, used); }            // Ctrl-B
  if c == 6 { return tui_named(TUI_K_RIGHT, used); }           // Ctrl-F
  if c == 3 { return tui_named(TUI_K_CTRL_C, used); }
  if c == 4 { return tui_named(TUI_K_CTRL_D, used); }
  if c == 21 { return tui_named(TUI_K_KILL_LINE, used); }      // Ctrl-U
  if c == 11 { return tui_named(TUI_K_KILL_END, used); }       // Ctrl-K
  if c == 23 { return tui_named(TUI_K_KILL_WORD, used); }      // Ctrl-W
  if c == 12 { return tui_named(TUI_K_CLEAR, used); }          // Ctrl-L
  if c == 16 { return tui_named(TUI_K_UP, used); }             // Ctrl-P
  if c == 14 { return tui_named(TUI_K_DOWN, used); }           // Ctrl-N
  if c == 26 || c == 31 { return tui_named(TUI_K_UNDO, used); } // Ctrl-Z, Ctrl-_ (Ctrl-/ in most terminals)
  if c >= 0 && c < 32 && c != 27 { return TuiKeyRead.{key = TuiKey.{kind = TUI_K_CTRL_KEY, cp = c}, used = used}; }   // Ctrl-Space is 0
  return tui_named(TUI_K_NONE, 0);
}

// Keyboard protocol on: with the kitty protocol's "disambiguate" flag the
// terminal reports Shift-Enter, Ctrl-letters and Esc as CSI ... u, so
// Shift-Enter differs from Enter. Terminals without it ignore the request.
TUI_KEYS_ON :: ">1u";     // for tui_csi
TUI_KEYS_OFF :: "<u";

// The leading number of a CSI parameter field, or -1.
tui_csi_num :: (p: string, at: int) -> int {
  v := -1; i := at;
  while i < p.count && p[i] >= '0' && p[i] <= '9' { v = ifx v < 0 then 0 else v; v = v * 10 + cast(int) (p[i] - '0'); i += 1; }
  return v;
}

// A kitty CSI-u key: "code" or "code;mods" (mods 1 + shift 1, alt 2, ctrl 4).
tui_csi_u :: (p: string, used: int) -> TuiKeyRead {
  cp := tui_csi_num(p, 0);
  semi := 0; while semi < p.count && p[semi] != ';' && p[semi] != ':' { semi += 1; }
  while semi < p.count && p[semi] != ';' { semi += 1; }       // skip alternate codes after ':'
  mods := ifx semi < p.count then tui_csi_num(p, semi + 1) - 1 else 0;
  if mods < 0 { mods = 0; }
  shift := (mods & 1) != 0; alt := (mods & 2) != 0; ctrl := (mods & 4) != 0;
  if cp == 13 { return tui_named(ifx shift || alt || ctrl then TUI_K_NEWLINE else TUI_K_ENTER, used); }
  if cp == 27 { return tui_named(TUI_K_ESC, used); }
  if cp == 9 { return tui_named(ifx shift then TUI_K_BACKTAB else TUI_K_TAB, used); }
  if cp == 127 || cp == 8 { return tui_named(ifx alt || ctrl then TUI_K_KILL_WORD else TUI_K_BACKSPACE, used); }
  if ctrl && cp >= 'a' && cp <= 'z' { r := tui_ctrl(cp - 'a' + 1, used); if r.used > 0 { return r; } return tui_named(TUI_K_NONE, used); }
  if ctrl && !alt && cp == ' ' { return tui_ctrl(0, used); }
  if ctrl && !alt && (cp == '/' || cp == '_') { return tui_named(TUI_K_UNDO, used); }
  if alt && cp == 'b' { return tui_named(TUI_K_WORD_LEFT, used); }
  if alt && cp == 'f' { return tui_named(TUI_K_WORD_RIGHT, used); }
  if cp >= 32 && !ctrl && !alt { return TuiKeyRead.{key = TuiKey.{kind = TUI_K_CHAR, cp = cp}, used = used}; }
  return tui_named(TUI_K_NONE, used);
}

// Decodes one key from b[at..]. With more false, a lone ESC is the Esc key
// (the caller waited and nothing followed); with more true, an unfinished
// sequence asks for more bytes (used 0).
tui_key :: (k: [] TuiKeys, b: string, at: int, more: bool) -> TuiKeyRead {
  if at >= b.count { return tui_named(TUI_K_NONE, 0); }
  if k[0].pasting {
    // inside bracketed paste: everything up to ESC [ 2 0 1 ~ is text
    i := at;
    while i < b.count {
      if b[i] == 27 {
        if i + 6 > b.count { if more { break; } }
        else if cast(string) b[i + 1..<i + 6] == "[201~" {
          k[0].pasting = false;
          t := cast(string) k[0].paste[0..<k[0].np]; k[0].np = 0;
          return TuiKeyRead.{key = TuiKey.{kind = TUI_K_PASTE, text = t}, used = i + 6 - at};
        }
      }
      c := b[i];
      if c == 13 { c = 10; }
      if k[0].np < k[0].paste.count { k[0].paste[k[0].np] = c; k[0].np += 1; }
      i += 1;
    }
    return TuiKeyRead.{key = TuiKey.{kind = TUI_K_NONE}, used = i - at};
  }
  c := cast(int) b[at];
  ctl := tui_ctrl(c, 1);
  if ctl.used > 0 { return ctl; }
  if c == 27 {
    if at + 1 >= b.count { return ifx more then tui_named(TUI_K_NONE, 0) else tui_named(TUI_K_ESC, 1); }
    n := cast(int) b[at + 1];
    if n == 13 { return tui_named(TUI_K_NEWLINE, 2); }       // Alt-Enter
    if n == 127 { return tui_named(TUI_K_KILL_WORD, 2); }    // Alt-Backspace
    if n == 'b' { return tui_named(TUI_K_WORD_LEFT, 2); }
    if n == 'f' { return tui_named(TUI_K_WORD_RIGHT, 2); }
    if n == 'O' {                                            // SS3: arrows in application mode
      if at + 2 >= b.count { return ifx more then tui_named(TUI_K_NONE, 0) else tui_named(TUI_K_ESC, 1); }
      f := cast(int) b[at + 2];
      if f == 'A' { return tui_named(TUI_K_UP, 3); } if f == 'B' { return tui_named(TUI_K_DOWN, 3); }
      if f == 'C' { return tui_named(TUI_K_RIGHT, 3); } if f == 'D' { return tui_named(TUI_K_LEFT, 3); }
      if f == 'H' { return tui_named(TUI_K_HOME, 3); } if f == 'F' { return tui_named(TUI_K_END, 3); }
      return tui_named(TUI_K_NONE, 3);
    }
    if n != '[' { return tui_named(TUI_K_ESC, 1); }
    // CSI: parameters, then a final byte in @..~
    i := at + 2;
    while i < b.count && (b[i] < 0x40 || b[i] > 0x7e) { i += 1; }
    if i >= b.count { return ifx more then tui_named(TUI_K_NONE, 0) else tui_named(TUI_K_ESC, 1); }
    p := cast(string) b[at + 2..<i];
    f := cast(int) b[i];
    used := i + 1 - at;
    if f == '~' {
      if p == "27;2;13" || p == "27;3;13" || p == "27;5;13" { return tui_named(TUI_K_NEWLINE, used); }   // xterm modifyOtherKeys
      if p == "200" { k[0].pasting = true; k[0].np = 0; return tui_named(TUI_K_NONE, used); }
      if p == "3" { return tui_named(TUI_K_DELETE, used); }
      if p == "1" || p == "7" { return tui_named(TUI_K_HOME, used); }
      if p == "4" || p == "8" { return tui_named(TUI_K_END, used); }
      return tui_named(TUI_K_NONE, used);
    }
    if f == 'u' { return tui_csi_u(p, used); }
    alt := p == "1;3" || p == "1;5";
    if f == 'A' { return tui_named(TUI_K_UP, used); }
    if f == 'B' { return tui_named(TUI_K_DOWN, used); }
    if f == 'C' { return tui_named(ifx alt then TUI_K_WORD_RIGHT else TUI_K_RIGHT, used); }
    if f == 'D' { return tui_named(ifx alt then TUI_K_WORD_LEFT else TUI_K_LEFT, used); }
    if f == 'H' { return tui_named(TUI_K_HOME, used); }
    if f == 'F' { return tui_named(TUI_K_END, used); }
    if f == 'Z' { return tui_named(TUI_K_BACKTAB, used); }   // Shift-Tab
    if p == "" && f == 'I' { return tui_named(TUI_K_FOCUS_IN, used); }
    if p == "" && f == 'O' { return tui_named(TUI_K_FOCUS_OUT, used); }
    return tui_named(TUI_K_NONE, used);
  }
  if c < 32 { return tui_named(TUI_K_NONE, 1); }
  // a UTF-8 character; wait for the rest of it
  ulen := 1;
  if c >= 0xf0 { ulen = 4; } else if c >= 0xe0 { ulen = 3; } else if c >= 0xc0 { ulen = 2; }
  if at + ulen > b.count { return ifx more then tui_named(TUI_K_NONE, 0) else tui_named(TUI_K_NONE, b.count - at); }
  r := tui_rune(b, at);
  return TuiKeyRead.{key = TuiKey.{kind = TUI_K_CHAR, cp = r.cp}, used = r.len};
}

// ---------------------------------------------------------------- the composer

// The composer's text, its cursor and its undo are the one edit buffer
// (components/core/edit.coax), the chat composer's too: a key moves a
// grapheme or a UAX #29 word, and Undo takes back typed bursts, a paste or a
// dictated insertion as the chat's composer does. What is the terminal's
// own stays here: the key bindings (readline's), the sent-message history
// Up and Down walk, and columns. There is no selection: the anchor follows
// the caret.
TUI_EDIT_BYTES :: EB_TEXT;
TUI_HISTORY :: 64;
TUI_HISTORY_BYTES :: 4096;

TuiEditor :: struct {
  eb: [1] EditBuf;               // the text; eb[0].caret is the cursor, a byte offset on a grapheme boundary
  hist: [TUI_HISTORY] [TUI_HISTORY_BYTES] u8; hlen: [TUI_HISTORY] int;
  nh: int;                       // entries held (newest at (top - 1) mod TUI_HISTORY)
  top: int;
  browse: int;                   // 0: editing; k: showing the k-th newest entry
  gen: int;                      // counts every change of the text or the cursor, and every key
}

tui_ed_text :: (e: [] TuiEditor) -> string { return eb_text(e[0].eb[..]); }
tui_ed_n :: (e: [] TuiEditor) -> int { return e[0].eb[0].n; }
tui_ed_cur :: (e: [] TuiEditor) -> int { return e[0].eb[0].caret; }
// Puts the cursor at byte at (held to the text).
tui_ed_move :: (e: [] TuiEditor, at: int) { eb_move_to(e[0].eb[..], at); e[0].gen += 1; }

// The text as a new document (as much of s as fits), the cursor at its end.
tui_ed_set :: (e: [] TuiEditor, s: string) { eb_set(e[0].eb[..], s); e[0].gen += 1; }

tui_ed_clear :: (e: [] TuiEditor) { eb_clear(e[0].eb[..]); e[0].browse = 0; e[0].gen += 1; }

// Types s at the cursor; nothing changes when it does not fit.
tui_ed_insert :: (e: [] TuiEditor, s: string) {
  at := e[0].eb[0].caret;
  if s.count == 0 || !eb_fits(e[0].eb[..], at, at, s) { return; }
  if eb_replace(e[0].eb[..], at, at, s) { e[0].gen += 1; }
}

// Inserts s at the cursor as its own undo step (a paste, a dictation);
// false, and nothing changed, when it does not fit.
tui_ed_insert_undoable :: (e: [] TuiEditor, s: string) -> bool {
  if !eb_paste(e[0].eb[..], s) { return false; }
  e[0].gen += 1;
  return true;
}

// Takes back the last undo step; false when there is none.
tui_ed_undo :: (e: [] TuiEditor) -> bool {
  if !eb_undo(e[0].eb[..]) { return false; }
  e[0].gen += 1;
  return true;
}

tui_ed_insert_cp :: (e: [] TuiEditor, cp: int) {
  b: [4] u8; k := 0;
  if cp < 0x80 { b[0] = cast,trunc(u8) cp; k = 1; }
  else if cp < 0x800 { b[0] = cast,trunc(u8) (0xc0 | (cp >> 6)); b[1] = cast,trunc(u8) (0x80 | (cp & 63)); k = 2; }
  else if cp < 0x10000 { b[0] = cast,trunc(u8) (0xe0 | (cp >> 12)); b[1] = cast,trunc(u8) (0x80 | ((cp >> 6) & 63)); b[2] = cast,trunc(u8) (0x80 | (cp & 63)); k = 3; }
  else { b[0] = cast,trunc(u8) (0xf0 | (cp >> 18)); b[1] = cast,trunc(u8) (0x80 | ((cp >> 12) & 63)); b[2] = cast,trunc(u8) (0x80 | ((cp >> 6) & 63)); b[3] = cast,trunc(u8) (0x80 | (cp & 63)); k = 4; }
  tui_ed_insert(e, cast(string) b[0..<k]);
}

// Deletes bytes [from, to); the cursor keeps its place in what stays.
tui_ed_delete :: (e: [] TuiEditor, from: int, to: int) {
  if from >= to { return; }
  cur := e[0].eb[0].caret; d := to - from;
  if !eb_replace(e[0].eb[..], from, to, "") { return; }
  keep := ifx cur >= to then cur - d else ifx cur > from then from else cur;
  if keep != from { eb_move_to(e[0].eb[..], keep); }
  e[0].gen += 1;
}
// Deletes from the cursor to at, either side of it.
tui_ed_delete_to :: (e: [] TuiEditor, at: int) {
  cur := e[0].eb[0].caret;
  if at < cur { tui_ed_delete(e, at, cur); } else { tui_ed_delete(e, cur, at); }
}

tui_ed_prev :: (e: [] TuiEditor, at: int) -> int { return eb_prev_boundary(e[0].eb[..], at); }
tui_ed_next :: (e: [] TuiEditor, at: int) -> int { return eb_next_boundary(e[0].eb[..], at); }
tui_ed_line_start :: (e: [] TuiEditor, at: int) -> int { return eb_line_start(e[0].eb[..], at); }
tui_ed_line_end :: (e: [] TuiEditor, at: int) -> int { return eb_line_stop(e[0].eb[..], at); }

// Columns from the start of the line to at.
tui_ed_col :: (e: [] TuiEditor, at: int) -> int { s := tui_ed_line_start(e, at); return tui_text_width(cast(string) e[0].eb[0].text[s..<at]); }
// The offset in the line starting at s whose column is nearest col, not past it.
tui_ed_at_col :: (e: [] TuiEditor, s: int, col: int) -> int {
  end := tui_ed_line_end(e, s);
  return s + tui_fit(cast(string) e[0].eb[0].text[s..<end], col);
}

tui_ed_remember :: (e: [] TuiEditor, s: string) {
  if s.count == 0 { return; }
  slot := e[0].top % TUI_HISTORY;
  n := ifx s.count < TUI_HISTORY_BYTES then s.count else TUI_HISTORY_BYTES;
  for i: 0..<n { e[0].hist[slot][i] = s[i]; }
  e[0].hlen[slot] = n;
  e[0].top += 1;
  if e[0].nh < TUI_HISTORY { e[0].nh += 1; }
  e[0].browse = 0;
}

tui_ed_show_history :: (e: [] TuiEditor, k: int) {
  if k <= 0 { e[0].browse = 0; tui_ed_set(e, ""); return; }
  slot := (e[0].top - k) % TUI_HISTORY;
  if slot < 0 { slot += TUI_HISTORY; }
  tui_ed_set(e, cast(string) e[0].hist[slot][0..<e[0].hlen[slot]]);
  e[0].browse = k;
}

TUI_ED_KEPT :: 0; TUI_ED_SUBMIT :: 1; TUI_ED_IGNORED :: 2;

// Applies an editing key; TUI_ED_SUBMIT when Enter asks to send the text.
tui_ed_key :: (e: [] TuiEditor, k: TuiKey) -> int {
  kd := k.kind;
  if kd == TUI_K_UNDO { return ifx tui_ed_undo(e) then TUI_ED_KEPT else TUI_ED_IGNORED; }
  e[0].gen += 1;          // any other key may move the cursor
  b := e[0].eb[..]; cur := b[0].caret;
  if kd == TUI_K_CHAR { tui_ed_insert_cp(e, k.cp); return TUI_ED_KEPT; }
  if kd == TUI_K_PASTE { x := tui_ed_insert_undoable(e, k.text); return TUI_ED_KEPT; }
  if kd == TUI_K_NEWLINE { tui_ed_insert(e, "\n"); return TUI_ED_KEPT; }
  if kd == TUI_K_ENTER {
    // a line ending in a backslash continues instead of sending
    if cur > 0 && cur == b[0].n && b[0].text[cur - 1] == '\\' { x := eb_replace(b, cur - 1, cur, "\n"); return TUI_ED_KEPT; }
    return TUI_ED_SUBMIT;
  }
  if kd == TUI_K_BACKSPACE { tui_ed_delete_to(e, eb_prev_boundary(b, cur)); return TUI_ED_KEPT; }
  if kd == TUI_K_DELETE { tui_ed_delete_to(e, eb_next_boundary(b, cur)); return TUI_ED_KEPT; }
  if kd == TUI_K_LEFT { eb_move_to(b, eb_prev_boundary(b, cur)); return TUI_ED_KEPT; }
  if kd == TUI_K_RIGHT { eb_move_to(b, eb_next_boundary(b, cur)); return TUI_ED_KEPT; }
  if kd == TUI_K_WORD_LEFT { eb_move_to(b, eb_prev_word(b, cur)); return TUI_ED_KEPT; }
  if kd == TUI_K_WORD_RIGHT { eb_move_to(b, eb_next_word(b, cur)); return TUI_ED_KEPT; }
  if kd == TUI_K_HOME { eb_move_to(b, eb_line_start(b, cur)); return TUI_ED_KEPT; }
  if kd == TUI_K_END { eb_move_to(b, eb_line_stop(b, cur)); return TUI_ED_KEPT; }
  if kd == TUI_K_KILL_LINE { tui_ed_delete_to(e, eb_line_start(b, cur)); return TUI_ED_KEPT; }
  if kd == TUI_K_KILL_END { tui_ed_delete_to(e, eb_line_stop(b, cur)); return TUI_ED_KEPT; }
  if kd == TUI_K_KILL_WORD { tui_ed_delete_to(e, eb_prev_word(b, cur)); return TUI_ED_KEPT; }
  if kd == TUI_K_UP || kd == TUI_K_DOWN {
    s := eb_line_start(b, cur);
    multi := false; for i: 0..<b[0].n { if b[0].text[i] == 10 { multi = true; } }
    if multi && kd == TUI_K_UP && s > 0 { col := tui_ed_col(e, cur); eb_move_to(b, tui_ed_at_col(e, eb_line_start(b, s - 1), col)); return TUI_ED_KEPT; }
    en := eb_line_stop(b, cur);
    if multi && kd == TUI_K_DOWN && en < b[0].n { col := tui_ed_col(e, cur); eb_move_to(b, tui_ed_at_col(e, en + 1, col)); return TUI_ED_KEPT; }
    if multi && e[0].browse == 0 { return TUI_ED_KEPT; }
    // history
    if kd == TUI_K_UP && e[0].browse < e[0].nh { tui_ed_show_history(e, e[0].browse + 1); }
    else if kd == TUI_K_DOWN && e[0].browse > 0 { tui_ed_show_history(e, e[0].browse - 1); }
    return TUI_ED_KEPT;
  }
  return TUI_ED_IGNORED;
}

// ---------------------------------------------------------------- layout

TUI_MAX_ROWS :: 256;
TUI_ROW_BYTES :: 1024;

// Lines of styled text for the live region, each already fitted to the width.
TuiRows :: struct {
  text: [TUI_MAX_ROWS] [TUI_ROW_BYTES] u8; len: [TUI_MAX_ROWS] int; style: [TUI_MAX_ROWS] int;
  n: int;
  cur_row: int; cur_col: int;    // where the cursor goes, -1 to hide it
  pad_at: int;                   // a pinned region's blank rows go before this row
}

tui_rows_reset :: (r: [] TuiRows) { r[0].n = 0; r[0].cur_row = -1; r[0].cur_col = 0; r[0].pad_at = 0; }

tui_rows_add :: (r: [] TuiRows, style: int, s: string) -> int {
  if r[0].n >= TUI_MAX_ROWS { return -1; }
  k := r[0].n;
  n := ifx s.count < TUI_ROW_BYTES then s.count else TUI_ROW_BYTES;
  for i: 0..<n { r[0].text[k][i] = s[i]; }
  r[0].len[k] = n; r[0].style[k] = style;
  r[0].n += 1;
  return k;
}

tui_rows_append :: (r: [] TuiRows, k: int, s: string) {
  if k < 0 { return; }
  for c: s { if r[0].len[k] < TUI_ROW_BYTES { r[0].text[k][r[0].len[k]] = c; r[0].len[k] += 1; } }
}

// The last style sequence in s ("" when none), to restart a wrapped span.
tui_last_esc :: (s: string) -> string {
  last := ""; i := 0;
  while i < s.count {
    e := tui_esc_len(s, i);
    if e > 0 { last = cast(string) s[i..<i + e]; i += e; } else { i += 1; }
  }
  return last;
}

// Adds text wrapped to cols columns after a first-line prefix and a
// continuation prefix of the same width; returns the rows added.
tui_rows_wrap :: (r: [] TuiRows, style: int, first: string, cont: string, s: string, cols: int) -> int {
  room := cols - tui_text_width(first);
  if room < 4 { room = 4; }
  added := 0; at := 0;
  for guard: 0..<TUI_MAX_ROWS {
    nl := at; while nl < s.count && s[nl] != 10 { nl += 1; }
    line := cast(string) s[at..<nl];
    pos := 0;
    for g2: 0..<TUI_MAX_ROWS {
      take := tui_fit(cast(string) line[pos..<line.count], room);
      if take == 0 && pos < line.count { take = tui_rune(line, pos).len; }
      // break at the last space when the line goes on
      if pos + take < line.count {
        sp := pos + take; while sp > pos && line[sp - 1] != ' ' { sp -= 1; }
        if sp > pos { take = sp - pos; }
      }
      k := tui_rows_add(r, style, ifx added == 0 then first else cont);
      if pos > 0 { tui_rows_append(r, k, tui_last_esc(cast(string) line[0..<pos])); }   // the style a span had where it wrapped
      tui_rows_append(r, k, cast(string) line[pos..<pos + take]);
      added += 1; pos += take;
      if pos >= line.count { break; }
    }
    if nl >= s.count { break; }
    at = nl + 1;
  }
  return added;
}

// Lays the composer out under a prompt, wrapped to cols, at most max_rows
// tall (scrolled to keep the cursor in view), and places the cursor.
tui_rows_editor :: (r: [] TuiRows, e: [] TuiEditor, prompt: string, cont: string, cols: int, max_rows: int, style: int) {
  room := cols - tui_text_width(prompt);
  if room < 4 { room = 4; }
  // rows of (start, end) offsets, and which holds the cursor
  starts: [TUI_MAX_ROWS] int; ends: [TUI_MAX_ROWS] int; nrow := 0;
  crow := 0; ccol := 0;
  text := tui_ed_text(e);
  at := 0;
  for guard: 0..<TUI_MAX_ROWS {
    nl := at; while nl < text.count && text[nl] != 10 { nl += 1; }
    pos := at;
    for g2: 0..<TUI_MAX_ROWS {
      take := tui_fit(cast(string) text[pos..<nl], room);
      if take == 0 && pos < nl { take = tui_rune(text, pos).len; }
      if nrow < TUI_MAX_ROWS { starts[nrow] = pos; ends[nrow] = pos + take; }
      last := pos + take >= nl;
      cur := tui_ed_cur(e);
      if cur >= pos && (cur < pos + take || (last && cur <= nl)) {
        crow = nrow; ccol = tui_text_width(cast(string) text[pos..<cur]);
        if ccol >= room { crow = nrow + 1; ccol = 0; }   // the cursor sits past a full row
      }
      nrow += 1; pos += take;
      if last { if ccol == 0 && crow == nrow && nrow < TUI_MAX_ROWS { starts[nrow] = nl; ends[nrow] = nl; nrow += 1; } break; }
    }
    if nl >= text.count { break; }
    at = nl + 1;
  }
  if nrow > TUI_MAX_ROWS { nrow = TUI_MAX_ROWS; }
  first := 0;
  mr := ifx max_rows < 1 then 1 else max_rows;
  if crow >= mr { first = crow - mr + 1; }
  last := first + mr; if last > nrow { last = nrow; }
  for i: first..<last {
    k := tui_rows_add(r, style, ifx i == 0 then prompt else cont);
    tui_rows_append(r, k, cast(string) text[starts[i]..<ends[i]]);
    if i == crow { r[0].cur_row = k; r[0].cur_col = tui_text_width(ifx i == 0 then prompt else cont) + ccol; }
  }
}

// ---------------------------------------------------------------- the live region

// The rows drawn at the bottom of the terminal last time, and the cursor's
// row within them, so the next draw can come back to their top.
// floor keeps the region's bottom on the screen's last row: when the
// region gets shorter without text committed above it, blank rows above the
// region take up the difference. rows is the screen height (0: not pinned).
// The drawn rows' widths (split, pad and w: the rows before the blank rows,
// the blank rows, then every row's width without them) and the cursor's
// column let a width change count the rows the terminal reflowed them into.
TuiLive :: struct {
  drawn: int; at: int; hidden: bool; floor: int; rows: int; cols: int;
  split: int; pad: int; nw: int; w: [TUI_MAX_ROWS] int; ccol: int;
}

// Pins the live region to the bottom of a screen of `rows` rows: scrolls what
// is on the screen into the scrollback and starts the region at the top of the
// emptied screen, filled down to the last row.
tui_live_pin :: (o: [] TuiOut, lv: [] TuiLive, rows: int) {
  for i: 0..<rows { tui_put(o, "\n"); }
  if rows > 1 { tui_csi_n(o, rows - 1, "A"); }
  tui_byte(o, 13);
  lv[0].drawn = 0; lv[0].at = 0; lv[0].rows = rows; lv[0].floor = rows;
}

// The screen width, so committed lines that wrap are counted as the rows
// they take (0: count each line as one row).
tui_live_width :: (lv: [] TuiLive, cols: int) { lv[0].cols = cols; }

// After the screen was cleared with the cursor at its top-left.
tui_live_cleared :: (lv: [] TuiLive) { lv[0].drawn = 0; lv[0].at = 0; lv[0].floor = lv[0].rows; }

// A new screen height; the region stays pinned on its next draw.
tui_live_resize :: (lv: [] TuiLive, rows: int) {
  if lv[0].rows == 0 { return; }
  lv[0].rows = rows;
  if lv[0].floor > rows { lv[0].floor = rows; }
}

// The width of the region's row i as drawn (a blank row's is 0).
tui_live_row_w :: (lv: [] TuiLive, i: int) -> int {
  sp := lv[0].split; pd := lv[0].pad;
  j := ifx i < sp then i else ifx i < sp + pd then -1 else i - pd;
  return ifx j >= 0 && j < lv[0].nw then lv[0].w[j] else 0;
}

// The rows drawn row i of the region takes on the screen now. A terminal
// that reflows (Ghostty, iTerm2, kitty, Terminal.app, tmux) wraps a row wider
// than a narrowed screen onto more rows: a row of w columns on a screen of
// cols takes ceil(w / cols) rows, at least one.
tui_live_row_tall :: (lv: [] TuiLive, i: int) -> int {
  w := tui_live_row_w(lv, i); c := lv[0].cols;
  return ifx c > 0 && w > c then (w + c - 1) / c else 1;
}

// The rows from the region's top to the cursor's row: the rows above the
// cursor's, as reflowed, and the rows the cursor's own line wrapped onto
// before the cursor's cell.
tui_live_above :: (lv: [] TuiLive) -> int {
  up := 0;
  for i: 0..<lv[0].at { up += tui_live_row_tall(lv, i); }
  c := lv[0].cols;
  if c > 0 && lv[0].ccol >= c { up += lv[0].ccol / c; }
  return up;
}

// The rows the whole region takes on the screen now.
tui_live_tall :: (lv: [] TuiLive) -> int {
  t := 0;
  for i: 0..<lv[0].drawn { t += tui_live_row_tall(lv, i); }
  return t;
}

// Moves to the top of the live region and erases it and everything below.
// After a width change the region's rows may have been reflowed onto more
// rows: the move counts them, so no wrapped piece of an old row stays above
// the new region, and a pinned region's floor grows to the rows they took, so
// the new region still ends on the screen's last row.
tui_live_erase :: (o: [] TuiOut, lv: [] TuiLive) {
  if lv[0].drawn > 0 {
    up := tui_live_above(lv);
    if up > 0 { tui_csi_n(o, up, "A"); }
    tui_byte(o, 13); tui_csi(o, "J");
    if lv[0].rows > 0 {
      t := tui_live_tall(lv); if t > lv[0].rows { t = lv[0].rows; }
      if lv[0].floor < t { lv[0].floor = t; }
    }
  }
  lv[0].drawn = 0; lv[0].at = 0; lv[0].nw = 0; lv[0].split = 0; lv[0].pad = 0; lv[0].ccol = 0;
}

// Draws rows as the live region; the cursor ends where the rows place it.
tui_live_draw :: (o: [] TuiOut, lv: [] TuiLive, r: [] TuiRows) {
  tui_csi(o, "?25l");
  tui_live_erase(o, lv);
  low := lv[0].floor;
  pad := ifx lv[0].rows > 0 && low > r[0].n then low - r[0].n else 0;
  // Rows before pad_at sit right under the scrollback (a reply as it
  // streams); the blank rows, then the rest, fill down to the last row.
  split := r[0].pad_at; if split < 0 { split = 0; } if split > r[0].n { split = r[0].n; }
  line := 0;
  for i: 0..<r[0].n + pad {
    if line > 0 { tui_put(o, "\r\n"); }
    line += 1;
    if i >= split && i < split + pad { tui_csi(o, "K"); continue; }
    j := ifx i < split then i else i - pad;
    tui_style(o, r[0].style[j]);
    tui_put(o, cast(string) r[0].text[j][0..<r[0].len[j]]);
    tui_style(o, TUI_PLAIN);
    tui_csi(o, "K");
  }
  lv[0].drawn = pad + r[0].n;
  lv[0].floor = ifx lv[0].rows > 0 then pad + r[0].n else 0;
  lv[0].at = ifx lv[0].drawn > 0 then lv[0].drawn - 1 else 0;
  lv[0].split = split; lv[0].pad = pad; lv[0].nw = r[0].n;
  for j: 0..<r[0].n { lv[0].w[j] = tui_text_width(cast(string) r[0].text[j][0..<r[0].len[j]]); }
  // the cursor's cell: after the last row's text (its last column when the text fills the row)
  last_w := tui_live_row_w(lv, lv[0].at);
  lv[0].ccol = ifx lv[0].cols > 0 && last_w >= lv[0].cols then lv[0].cols - 1 else last_w;
  if r[0].cur_row >= 0 && r[0].cur_row < r[0].n {
    screen := ifx r[0].cur_row < split then r[0].cur_row else r[0].cur_row + pad;
    up := lv[0].drawn - 1 - screen;
    if up > 0 { tui_csi_n(o, up, "A"); }
    tui_byte(o, 13);
    if r[0].cur_col > 0 { tui_csi_n(o, r[0].cur_col, "C"); }
    lv[0].at = screen;
    lv[0].ccol = ifx lv[0].cols > 0 && r[0].cur_col >= lv[0].cols then lv[0].cols - 1 else r[0].cur_col;
    tui_csi(o, "?25h");
  }
}

// Writes finished text into the scrollback above the live region: erase the
// region, write the text and a line end; the caller draws the region again.
tui_live_commit :: (o: [] TuiOut, lv: [] TuiLive, style: int, s: string) {
  // The committed lines move the region down by the rows they take, counting
  // wrapped lines when the width is known; the blank rows they fill no longer
  // need padding. The region counts the rows the terminal holds it on now,
  // more than it drew after a narrowing reflow.
  tall := tui_live_tall(lv); if lv[0].rows > 0 && tall > lv[0].rows { tall = lv[0].rows; }
  high := ifx tall > lv[0].floor then tall else lv[0].floor;
  lines := 0; at := 0;
  for i: 0..<s.count + 1 {
    if i == s.count || s[i] == 10 {
      w := tui_text_width(cast(string) s[at..<i]);
      lines += ifx lv[0].cols > 0 && w > lv[0].cols then (w + lv[0].cols - 1) / lv[0].cols else 1;
      at = i + 1;
    }
  }
  lv[0].floor = ifx lv[0].rows > 0 && high > lines then high - lines else 0;
  if lv[0].drawn > 0 { erase_floor := lv[0].floor; tui_live_erase(o, lv); lv[0].floor = erase_floor; }
  tui_style(o, style);
  for c: s { if c == 10 { tui_style(o, TUI_PLAIN); tui_put(o, "\r\n"); tui_style(o, style); } else { tui_byte(o, cast(int) c); } }
  tui_style(o, TUI_PLAIN);
  tui_put(o, "\r\n");
}

// ---------------------------------------------------------------- syntax highlighting

// Code colors on a dark terminal, a line at a time. Coax (and Jai, which it
// follows) gets the full treatment: keywords, #directives, types, the names
// a declaration defines, calls, CONSTANTS, numbers, strings and comments,
// nested /* */ comments carried across lines. Other languages get strings,
// numbers, comments and a shared keyword list. A diff's row paints the line
// on its background (bg; an alpha of 0 for none).
TUI_LANG_PLAIN :: 0; TUI_LANG_COAX :: 1; TUI_LANG_C :: 2; TUI_LANG_HASH :: 3;

TuiHl :: struct { comment: int; }   // open /* */ depth

TUI_HL_TEXT :: 0; TUI_HL_KEYWORD :: 1; TUI_HL_DIRECTIVE :: 2; TUI_HL_TYPE :: 3; TUI_HL_DEF :: 4; TUI_HL_CALL :: 5;
TUI_HL_CONST :: 6; TUI_HL_NUMBER :: 7; TUI_HL_STRING :: 8; TUI_HL_COMMENT :: 9; TUI_HL_PUNCT :: 10;

// A token kind's look in a theme: Coder Noir's syntax colours, a light
// background's, or none's bold keywords and italic comments.
tui_hl_look :: (theme: int, kind: int) -> TuiLook {
  if theme == TUI_THEME_NONE {
    return tui_look(ifx kind == TUI_HL_KEYWORD || kind == TUI_HL_DEF then TERM_FACE_BOLD else ifx kind == TUI_HL_COMMENT then TERM_FACE_ITALIC else TERM_FACE_PLAIN, tui_own());
  }
  if theme == TUI_THEME_LIGHT {
    if kind == TUI_HL_KEYWORD { return tui_look(TERM_FACE_PLAIN, tui_rgb(166, 38, 164)); }
    if kind == TUI_HL_DIRECTIVE || kind == TUI_HL_CONST || kind == TUI_HL_NUMBER { return tui_look(TERM_FACE_PLAIN, tui_rgb(152, 104, 1)); }
    if kind == TUI_HL_TYPE { return tui_look(TERM_FACE_PLAIN, tui_rgb(1, 132, 188)); }
    if kind == TUI_HL_DEF { return tui_look(TERM_FACE_BOLD, tui_rgb(64, 120, 242)); }
    if kind == TUI_HL_CALL { return tui_look(TERM_FACE_PLAIN, tui_rgb(64, 120, 242)); }
    if kind == TUI_HL_STRING { return tui_look(TERM_FACE_PLAIN, tui_rgb(80, 161, 79)); }
    if kind == TUI_HL_COMMENT { return tui_look(TERM_FACE_ITALIC, tui_rgb(140, 141, 147)); }
    return tui_look(TERM_FACE_PLAIN, tui_rgb(56, 58, 66));
  }
  if kind == TUI_HL_KEYWORD { return tui_look(TERM_FACE_PLAIN, tui_rgb(208, 147, 208)); }
  if kind == TUI_HL_DIRECTIVE { return tui_look(TERM_FACE_BOLD, tui_rgb(230, 193, 92)); }   // bold: a number shares the color
  if kind == TUI_HL_TYPE { return tui_look(TERM_FACE_PLAIN, tui_rgb(116, 207, 209)); }
  if kind == TUI_HL_DEF { return tui_look(TERM_FACE_BOLD, tui_rgb(127, 178, 232)); }
  if kind == TUI_HL_CALL { return tui_look(TERM_FACE_PLAIN, tui_rgb(127, 178, 232)); }
  if kind == TUI_HL_CONST || kind == TUI_HL_NUMBER { return tui_look(TERM_FACE_PLAIN, tui_rgb(230, 193, 92)); }
  if kind == TUI_HL_STRING { return tui_look(TERM_FACE_PLAIN, tui_rgb(159, 208, 138)); }
  if kind == TUI_HL_COMMENT { return tui_look(TERM_FACE_ITALIC, tui_rgb(129, 129, 129)); }
  if kind == TUI_HL_PUNCT { return tui_look(TERM_FACE_PLAIN, tui_rgb(201, 201, 201)); }
  return tui_look(TERM_FACE_PLAIN, tui_rgb(237, 237, 237));
}

// The language a fence tag or a file name means.
tui_hl_lang :: (name: string) -> int {
  dot := name.count; while dot > 0 && name[dot - 1] != '.' && name[dot - 1] != '/' { dot -= 1; }
  ext := ifx dot > 0 && name[dot - 1] == '.' then cast(string) name[dot..<name.count] else name;
  if ext == "coax" || ext == "jai" { return TUI_LANG_COAX; }
  words1 := [24] string.["c", "h", "cc", "cpp", "rs", "rust", "js", "ts", "tsx", "jsx", "javascript", "typescript", "go", "swift", "java", "kt", "zig", "json", "css", "wgsl", "glsl", "metal", "cu", "proto"];
  for e: words1  { if ext == e { return TUI_LANG_C; } }
  words2 := [12] string.["py", "python", "sh", "bash", "zsh", "shell", "console", "rb", "ruby", "yaml", "yml", "toml"];
  for e: words2  { if ext == e { return TUI_LANG_HASH; } }
  return TUI_LANG_PLAIN;
}

tui_hl_ident_char :: (c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c >= 0x80; }

tui_hl_coax_keyword :: (w: string) -> bool {
  words3 := [32] string.["struct", "union", "enum", "enum_flags", "if", "else", "ifx", "then", "while", "for", "break", "continue",
                 "return", "defer", "switch", "case", "using", "cast", "xx", "inline", "no_inline", "remove", "it", "it_index",
                 "size_of", "type_of", "type_info", "push_context", "or_else", "try", "operator", "trunc"];
  for k: words3  { if w == k { return true; } }
  return false;
}

tui_hl_coax_type :: (w: string) -> bool {
  words4 := [20] string.["int", "u8", "u16", "u32", "u64", "s8", "s16", "s32", "s64", "f32", "f64", "float", "float32", "float64",
                 "bool", "string", "void", "Type", "Any", "Code"];
  for k: words4  { if w == k { return true; } }
  return false;
}

tui_hl_other_keyword :: (w: string) -> bool {
  words5 := [79] string.["fn", "let", "mut", "pub", "use", "mod", "impl", "struct", "enum", "trait", "match", "if", "else", "for",
                 "while", "loop", "return", "break", "continue", "const", "static", "def", "class", "import", "from", "as",
                 "in", "not", "and", "or", "is", "lambda", "with", "yield", "async", "await", "function", "var", "new",
                 "this", "self", "export", "default", "type", "interface", "package", "func", "defer", "select", "case",
                 "switch", "try", "catch", "finally", "throw", "raise", "except", "pass", "then", "fi", "do", "done",
                 "esac", "local", "elif", "unsafe", "where", "extern", "typedef", "sizeof", "void", "true", "false",
                 "null", "nil", "None", "True", "False", "undefined"];
  for k: words5  { if w == k { return true; } }
  return false;
}

tui_hl_all_caps :: (w: string) -> bool {
  letters := 0;
  for c: w { if c >= 'a' && c <= 'z' { return false; } if c >= 'A' && c <= 'Z' { letters += 1; } }
  return letters >= 2;
}

// The token at line[i]: its kind and where it ends.
TuiHlToken :: struct { kind: int; end: int; }
tui_hl_token :: (st: [] TuiHl, lang: int, line: string, i: int) -> TuiHlToken {
    c := line[i];
    kind := TUI_HL_TEXT; e := i + 1;
    if lang == TUI_LANG_PLAIN { kind = TUI_HL_TEXT; e = line.count; }
    else if st[0].comment > 0 {
      // inside /* */ (nested in Coax)
      e = i;
      while e < line.count && st[0].comment > 0 {
        if e + 1 < line.count && line[e] == '*' && line[e + 1] == '/' { st[0].comment -= 1; e += 2; }
        else if lang == TUI_LANG_COAX && e + 1 < line.count && line[e] == '/' && line[e + 1] == '*' { st[0].comment += 1; e += 2; }
        else { e += 1; }
      }
      kind = TUI_HL_COMMENT;
    }
    else if lang != TUI_LANG_HASH && c == '/' && i + 1 < line.count && line[i + 1] == '/' { kind = TUI_HL_COMMENT; e = line.count; }
    else if lang == TUI_LANG_HASH && c == '#' && (i == 0 || line[i - 1] == ' ' || line[i - 1] == 9) { kind = TUI_HL_COMMENT; e = line.count; }
    else if lang != TUI_LANG_HASH && c == '/' && i + 1 < line.count && line[i + 1] == '*' { st[0].comment = 1; kind = TUI_HL_COMMENT; e = i + 2; }
    else if c == '"' || c == '\'' || (c == '`' && lang != TUI_LANG_COAX) {
      e = i + 1;
      while e < line.count && line[e] != c { if line[e] == '\\' { e += 1; } e += 1; }
      if e < line.count { e += 1; } if e > line.count { e = line.count; }
      kind = TUI_HL_STRING;
    }
    else if c >= '0' && c <= '9' {
      e = i + 1; while e < line.count && (tui_hl_ident_char(line[e]) || (line[e] == '.' && e + 1 < line.count && line[e + 1] >= '0' && line[e + 1] <= '9')) { e += 1; }
      kind = TUI_HL_NUMBER;
    }
    else if c == '#' && lang != TUI_LANG_HASH && i + 1 < line.count && tui_hl_ident_char(line[i + 1]) {
      e = i + 1; while e < line.count && tui_hl_ident_char(line[e]) { e += 1; }
      kind = TUI_HL_DIRECTIVE;
    }
    else if tui_hl_ident_char(c) {
      e = i + 1; while e < line.count && tui_hl_ident_char(line[e]) { e += 1; }
      w := cast(string) line[i..<e];
      n := e; while n < line.count && line[n] == ' ' { n += 1; }
      declares := n + 1 < line.count && line[n] == ':' && line[n + 1] == ':';
      calls := n < line.count && line[n] == '(';
      if lang == TUI_LANG_COAX {
        if tui_hl_coax_keyword(w) { kind = TUI_HL_KEYWORD; }
        else if w == "true" || w == "false" || w == "null" { kind = TUI_HL_CONST; }
        else if tui_hl_coax_type(w) { kind = TUI_HL_TYPE; }
        else if tui_hl_all_caps(w) { kind = TUI_HL_CONST; }
        else if c >= 'A' && c <= 'Z' { kind = TUI_HL_TYPE; }
        else if declares { kind = TUI_HL_DEF; }
        else if calls { kind = TUI_HL_CALL; }
      } else {
        if tui_hl_other_keyword(w) { kind = TUI_HL_KEYWORD; }
        else if tui_hl_all_caps(w) { kind = TUI_HL_CONST; }
        else if calls { kind = TUI_HL_CALL; }
        else if c >= 'A' && c <= 'Z' { kind = TUI_HL_TYPE; }
      }
    }
    else if c == ':' || c == '-' && i + 1 < line.count && line[i + 1] == '>' || c == '=' || c == ';' || c == ',' || c == '{' || c == '}' || c == '(' || c == ')' || c == '[' || c == ']' {
      kind = TUI_HL_PUNCT;
    }
    if e <= i { e = i + 1; }
    return TuiHlToken.{kind = kind, end = e};
}

// One line of code painted on a background, its runs of one kind together.
tui_hl_paint :: (p: [] TuiPaint, st: [] TuiHl, lang: int, line: string, bg_in: Rgba) {
  theme := p[0].o[0].theme;
  bg := ifx theme == TUI_THEME_NONE then tui_own() else bg_in;
  cur := -1; from := 0; i := 0;
  for guard: 0..<line.count + 1 {
    if i >= line.count { break; }
    t := tui_hl_token(st, lang, line, i);
    if t.kind != cur {
      if cur >= 0 { tui_paint_text(p, tui_hl_look(theme, cur), bg, cast(string) line[from..<i]); }
      cur = t.kind; from = i;
    }
    i = t.end;
  }
  if cur >= 0 { tui_paint_text(p, tui_hl_look(theme, cur), bg, cast(string) line[from..<line.count]); }
}

// One line of code into o.
tui_hl_line :: (st: [] TuiHl, lang: int, line: string, o: [] TuiOut, bg: Rgba) {
  p_b: [1] TuiPaint; p := p_b[..]; tui_paint(p, o, 0);
  tui_hl_paint(p, st, lang, line, bg);
  tui_paint_flush(p);
}

// ---------------------------------------------------------------- markdown

// Markdown for a terminal, a line at a time so a streaming reply renders as
// it arrives: headings, emphasis, inline code, code blocks, lists, quotes,
// links, strikethrough and rules become styles and glyphs; anything it does
// not know stays as written. The state carries what spans lines (a code
// block). The output holds style sequences; tui_text_width skips them.
TuiMd :: struct { in_code: bool; fence: u8; lang: int; hl: TuiHl; }

TUI_MD_BOLD :: 1; TUI_MD_ITALIC :: 2; TUI_MD_CODE :: 4; TUI_MD_STRIKE :: 8; TUI_MD_LINK :: 16; TUI_MD_DIM :: 32; TUI_MD_HEAD :: 64;

// The look of a set of flags in a theme. A later colour wins over an
// earlier one, as it did when these were style sequences: code's or dim's,
// then a link's, then a heading's.
tui_md_look :: (theme: int, f: int) -> TuiLook {
  face := TERM_FACE_PLAIN; fg := tui_own();
  light := theme == TUI_THEME_LIGHT; none := theme == TUI_THEME_NONE;
  if (f & TUI_MD_HEAD) != 0 { face = face | TERM_FACE_BOLD; if light { fg = tui_rgb(20, 20, 20); } else if !none { fg = tui_rgb(237, 237, 237); } }
  if (f & TUI_MD_BOLD) != 0 { face = face | TERM_FACE_BOLD; }
  if (f & TUI_MD_ITALIC) != 0 { face = face | TERM_FACE_ITALIC; }
  if (f & TUI_MD_STRIKE) != 0 { face = face | TERM_FACE_STRIKE; }
  if (f & TUI_MD_LINK) != 0 { face = face | TERM_FACE_UNDERLINE; if light { fg = tui_rgb(64, 120, 242); } else if !none { fg = tui_rgb(127, 178, 232); } }
  if (f & TUI_MD_CODE) != 0 { if light { fg = tui_rgb(152, 104, 1); } else if !none { fg = tui_rgb(116, 207, 209); } }
  else if (f & TUI_MD_DIM) != 0 { if light { fg = tui_rgb(95, 95, 95); } else if !none { fg = tui_rgb(129, 129, 129); } }
  return tui_look(face, fg);
}
tui_md_text :: (p: [] TuiPaint, f: int, text: string) { tui_paint_text(p, tui_md_look(p[0].o[0].theme, f), tui_own(), text); }

// The flags a run of the parsed line draws with, over the line's base flags.
tui_md_flags :: (r: MdRun, base: int) -> int {
  f := base;
  if r.style == MD_BOLD || (r.marks & MD_STRONG) != 0 { f = f | TUI_MD_BOLD; }
  if r.style == MD_CODE { f = f | TUI_MD_CODE; }
  if (r.marks & MD_ITALIC) != 0 { f = f | TUI_MD_ITALIC; }
  if (r.marks & MD_STRIKE) != 0 { f = f | TUI_MD_STRIKE; }
  if (r.marks & MD_LINK) != 0 { f = f | TUI_MD_LINK; }
  return f;
}

// Styled runs (components/core/markdown.coax) painted under the base flags;
// a link's target follows it, faint, unless it is the link's own text or a
// place on the page. The runs' text must outlive the next flush.
tui_md_runs_paint :: (p: [] TuiPaint, doc: [] MdDoc, text: string, runs: [] MdRun, base: int) {
  for k: 0..<runs.count {
    r := runs[k];
    shown := cast(string) text[r.from..<r.to];
    tui_md_text(p, tui_md_flags(r, base), shown);
    if (r.marks & MD_LINK) != 0 {
      url := md_link(doc, r);
      if url != shown && url.count > 0 && url[0] != '#' {
        tui_md_text(p, base | TUI_MD_DIM, " ("); tui_md_text(p, base | TUI_MD_DIM, url); tui_md_text(p, base | TUI_MD_DIM, ")");
      }
    }
  }
}
// The columns those runs take.
tui_md_runs_width :: (doc: [] MdDoc, text: string, runs: [] MdRun) -> int {
  w := 0;
  for k: 0..<runs.count {
    r := runs[k];
    shown := cast(string) text[r.from..<r.to];
    w += tui_text_width(shown);
    if (r.marks & MD_LINK) != 0 {
      url := md_link(doc, r);
      if url != shown && url.count > 0 && url[0] != '#' { w += tui_text_width(url) + 3; }
    }
  }
  return w;
}
// Styled runs written into o.
tui_md_runs :: (o: [] TuiOut, doc: [] MdDoc, text: string, runs: [] MdRun, base: int) {
  p_b: [1] TuiPaint; p := p_b[..]; tui_paint(p, o, 0);
  tui_md_runs_paint(p, doc, text, runs, base);
  tui_paint_flush(p);
}

// Inline spans of s under the base flags, painted (and flushed: the spans
// live in this call). The spans are read by the one Markdown parser
// (md_inline_text: a finished line).
tui_md_inline :: (p: [] TuiPaint, s: string, base: int) {
  doc_b: [1] MdDoc = ---; doc := doc_b[..];
  md_inline_text(doc, s);
  tui_md_runs_paint(p, doc, md_str(doc, 0, doc[0].n), doc[0].runs[0..<doc[0].nr], base);
  tui_paint_flush(p);
}

// Leading spaces of s.
tui_md_indent :: (s: string) -> int { n := 0; while n < s.count && s[n] == ' ' { n += 1; } return n; }

// Renders one line into o. False when the line shows nothing (a code fence).
tui_md_line :: (st: [] TuiMd, line: string, o: [] TuiOut, cols: int) -> bool {
  p_b: [1] TuiPaint; p := p_b[..]; tui_paint(p, o, 0);
  shows := tui_md_line_paint(p, st, line, cols);
  tui_paint_flush(p);
  return shows;
}
tui_md_line_paint :: (p: [] TuiPaint, st: [] TuiMd, line: string, cols: int) -> bool {
  ind := tui_md_indent(line);
  rest := cast(string) line[ind..<line.count];
  fence := md_fence_char(rest);
  if fence != 0 {
    if !st[0].in_code {
      st[0].in_code = true; st[0].fence = fence; st[0].hl.comment = 0;
      tag := cast(string) rest[3..<rest.count];
      while tag.count > 0 && tag[0] == ' ' { tag = cast(string) tag[1..<tag.count]; }
      t := 0; while t < tag.count && tag[t] != ' ' && tag[t] != '{' { t += 1; }
      st[0].lang = tui_hl_lang(cast(string) tag[0..<t]);
      return false;
    }
    if fence == st[0].fence { st[0].in_code = false; return false; }
  }
  plain := tui_md_look(p[0].o[0].theme, 0);
  if st[0].in_code {
    if st[0].lang == TUI_LANG_PLAIN { tui_md_text(p, TUI_MD_CODE, line); }
    else { hl_b: [1] TuiHl; hl_b[0] = st[0].hl; tui_hl_paint(p, hl_b[..], st[0].lang, line, tui_own()); st[0].hl = hl_b[0]; }
    return true;
  }
  // What a line is, is the one Markdown parser's to say (components/core/markdown.coax).
  // headings
  h := md_heading(rest);
  if h > 0 {
    tui_md_inline(p, cast(string) rest[h..<rest.count], TUI_MD_HEAD);
    return true;
  }
  // a rule: three or more of - * _ and nothing else
  if md_rule(rest) {
    w := ifx cols > 4 && cols < 200 then cols else 40;
    for i: 0..<w { tui_md_text(p, TUI_MD_DIM, "─"); }
    return true;
  }
  // a quote
  q := md_quote_at(rest);
  if q >= 0 {
    tui_paint_spaces(p, plain, tui_own(), ind);
    tui_md_text(p, TUI_MD_DIM, "│ ");
    tui_md_inline(p, cast(string) rest[q..<rest.count], TUI_MD_DIM | TUI_MD_ITALIC);
    return true;
  }
  // list items: - * + become a bullet, or a box when the item is a task; numbers stay
  if md_bullet(rest) > 0 {
    tui_paint_spaces(p, plain, tui_own(), ind);
    body := cast(string) rest[2..<rest.count];
    task := md_task(body);
    if task != MD_TASK_NONE {
      tui_md_text(p, 0, ifx task == MD_TASK_DONE then "☑ " else "☐ ");
      tui_md_inline(p, cast(string) body[4..<body.count], 0);
      return true;
    }
    tui_md_text(p, 0, ifx ind >= 2 then "◦ " else "• ");
    tui_md_inline(p, body, 0);
    return true;
  }
  // table separator rows are drawn faint
  if rest.count >= 3 && rest[0] == '|' {
    al: [MD_TABLE_COLS] int;
    if md_delim(rest, al[..]) > 0 { tui_md_text(p, TUI_MD_DIM, line); return true; }
  }
  tui_paint_spaces(p, plain, tui_own(), ind);
  tui_md_inline(p, rest, 0);
  return true;
}

// ---------------------------------------------------------------- tables

// A Markdown table needs every row before a column's width is known, so a
// caller holds the rows (tui_md_is_row) and passes them here together. It
// draws a box with a bold header row, each column as wide as its widest
// cell and aligned as the separator row says. A table wider than cols
// becomes one block a row: the first cell, then "header: value" lines. Output lines are separated by newlines.
TUI_MD_TCOLS :: 12; TUI_MD_TROWS :: 64;

tui_md_is_row :: (line: string) -> bool {
  i := tui_md_indent(line);
  return i < line.count && line[i] == '|';
}

// The delimiter row: every cell dashes, with colons for alignment (md_delim).
tui_md_is_sep :: (line: string) -> bool { al: [MD_TABLE_COLS] int; return md_delim(line, al[..]) > 0; }

tui_md_dashes :: (p: [] TuiPaint, glyph: string, w: int) { for i: 0..<w { tui_md_text(p, TUI_MD_DIM, glyph); } }

tui_md_edge :: (p: [] TuiPaint, w: [] int, ncols: int, left: string, mid: string, right: string) {
  tui_md_text(p, TUI_MD_DIM, left);
  for c: 0..<ncols { tui_md_dashes(p, "─", w[c] + 2); tui_md_text(p, TUI_MD_DIM, ifx c + 1 < ncols then mid else right); }
  tui_md_newline(p);
}
// Ends a row of a multi-row painting: what is painted goes out, then a newline.
tui_md_newline :: (p: [] TuiPaint) { tui_paint_flush(p); tui_byte(p[0].o, 10); p[0].col = 0; p[0].base = 0; }

tui_md_table :: (text: string, o: [] TuiOut, cols: int) {
  // the one Markdown parser reads the rows (GFM, as the chat reads them: a
  // header row, a delimiter row with as many columns, then the body)
  doc_b: [1] MdDoc = ---; doc := doc_b[..];
  doc[0].n = 0; doc[0].nb = 0; doc[0].nr = 0; doc[0].ni = 0; doc[0].nlink = 0;
  blocks := md_parse(doc, text, 0);
  if blocks != 1 || doc[0].blocks[0].kind != MB_TABLE {
    // rows with no delimiter row are not a table: each is a line
    st_b: [1] TuiMd; at := 0;
    while at < text.count {
      e := at; while e < text.count && text[e] != 10 { e += 1; }
      if e > at { if tui_md_line(st_b[..], cast(string) text[at..<e], o, cols) { tui_byte(o, 10); } }
      at = e + 1;
    }
    return;
  }
  p_b: [1] TuiPaint; p := p_b[..]; tui_paint(p, o, 0);
  plain := tui_md_look(o[0].theme, 0);
  dcols := doc[0].blocks[0].cols; i0 := doc[0].blocks[0].item0;
  ncols := ifx dcols > TUI_MD_TCOLS then TUI_MD_TCOLS else dcols;
  nrows := md_table_rows(doc, 0);
  if nrows > TUI_MD_TROWS { nrows = TUI_MD_TROWS; }
  // alignment as the delimiter row says: 0 left, 1 right, 2 center
  align: [12] int;
  for c: 0..<TUI_MD_TCOLS { align[c] = 0; }
  for c: 0..<ncols { a := doc[0].items[i0 + c].number; align[c] = ifx a == MA_RIGHT then 1 else ifx a == MA_CENTER then 2 else 0; }
  // every cell's width
  cw: [768] int; has: [768] bool;
  for r: 0..<nrows {
    for c: 0..<TUI_MD_TCOLS {
      k := r * TUI_MD_TCOLS + c;
      cw[k] = 0; has[k] = false;
      if c < ncols && doc[0].items[i0 + r * dcols + c].n > 0 {
        item := i0 + r * dcols + c;
        cw[k] = tui_md_runs_width(doc, md_item_text(doc, item), md_item_runs(doc, item));
        has[k] = true;
      }
    }
  }
  w: [12] int;
  for c: 0..<ncols { w[c] = 1; for r: 0..<nrows { if cw[r * TUI_MD_TCOLS + c] > w[c] { w[c] = cw[r * TUI_MD_TCOLS + c]; } } }
  total := 1; for c: 0..<ncols { total += w[c] + 3; }
  if total <= cols {
    tui_md_edge(p, w[..], ncols, "┌", "┬", "┐");
    for r: 0..<nrows {
      for c: 0..<ncols {
        k := r * TUI_MD_TCOLS + c;
        tui_md_text(p, TUI_MD_DIM, ifx c == 0 then "│ " else " │ ");
        pad := w[c] - cw[k];
        before := ifx align[c] == 1 then pad else ifx align[c] == 2 then pad / 2 else 0;
        tui_paint_spaces(p, plain, tui_own(), before);
        if has[k] { item := i0 + r * dcols + c; tui_md_runs_paint(p, doc, md_item_text(doc, item), md_item_runs(doc, item), ifx r == 0 then TUI_MD_BOLD else 0); }
        tui_paint_spaces(p, plain, tui_own(), pad - before);
      }
      tui_md_text(p, TUI_MD_DIM, " │"); tui_md_newline(p);
      if r == 0 && nrows > 1 { tui_md_edge(p, w[..], ncols, "├", "┼", "┤"); }
    }
    tui_md_edge(p, w[..], ncols, "└", "┴", "┘");
    return;
  }
  // too wide: a block a row
  for r: 1..<nrows {
    k0 := r * TUI_MD_TCOLS;
    if has[k0] { tui_md_runs_paint(p, doc, md_item_text(doc, i0 + r * dcols), md_item_runs(doc, i0 + r * dcols), 0); }
    tui_md_newline(p);
    for c: 1..<ncols {
      k := k0 + c;
      if !has[k] { continue; }
      tui_paint_spaces(p, plain, tui_own(), 2);
      if has[c] { tui_md_runs_paint(p, doc, md_item_text(doc, i0 + c), md_item_runs(doc, i0 + c), TUI_MD_BOLD); }   // the header's label, as it reads in the header row
      tui_md_text(p, TUI_MD_DIM, ": ");
      item := i0 + r * dcols + c;
      tui_md_runs_paint(p, doc, md_item_text(doc, item), md_item_runs(doc, item), 0);
      tui_md_newline(p);
    }
  }
}

// ---------------------------------------------------------------- checks

// Test bytes: ` is ESC and | is Ctrl-C, since Coax strings have no \e.
tui_tb :: (s: string, out: [] u8) -> string {
  for i: 0..<s.count { c := s[i]; if c == '`' { c = 27; } else if c == '|' { c = 3; } out[i] = c; }
  return cast(string) out[0..<s.count];
}

#test "UTF-8 runes and widths: ASCII, accents, CJK, emoji, combining marks" {
  s := "aé中😀";
  r := tui_rune(s, 0); #assert r.cp == 'a' && r.len == 1;
  r = tui_rune(s, 1); #assert r.cp == 0xe9 && r.len == 2;
  r = tui_rune(s, 3); #assert r.cp == 0x4e2d && r.len == 3;
  r = tui_rune(s, 6); #assert r.cp == 0x1f600 && r.len == 4;
  #assert tui_text_width(s) == 6;
  #assert tui_text_width("é") == 1 || tui_text_width("é") == 2;
  #assert tui_fit("中中中", 5) == 6 && tui_fit("abc", 2) == 2;
  bad_b: [1] u8; bad := bad_b[..]; bad[0] = 0xff; #assert tui_rune(cast(string) bad[..], 0).cp == 0xfffd;
}

#test "keys: control bytes, CSI and SS3 arrows, Alt-Enter, kitty Shift-Enter, Shift-Tab, UTF-8" {
  tb1: [64] u8; tb2: [64] u8; tb3: [64] u8; tb4: [64] u8; tb5: [64] u8; tb6: [64] u8; tb7: [64] u8; tb8: [64] u8; tb9: [64] u8; tb10: [64] u8; tb11: [64] u8;
  k_b: [1] TuiKeys; k := k_b[..];
  #assert tui_key(k, "\r", 0, false).key.kind == TUI_K_ENTER;
  #assert tui_key(k, tui_tb("|", tb1[..]), 0, false).key.kind == TUI_K_CTRL_C;
  #assert tui_key(k, tui_tb("`[A", tb2[..]), 0, false).key.kind == TUI_K_UP && tui_key(k, tui_tb("`[A", tb3[..]), 0, false).used == 3;
  #assert tui_key(k, tui_tb("`OD", tb4[..]), 0, false).key.kind == TUI_K_LEFT;
  #assert tui_key(k, tui_tb("`[1;3C", tb5[..]), 0, false).key.kind == TUI_K_WORD_RIGHT;
  #assert tui_key(k, tui_tb("`\r", tb6[..]), 0, false).key.kind == TUI_K_NEWLINE;
  #assert tui_key(k, tui_tb("`[13;2u", tb7[..]), 0, false).key.kind == TUI_K_NEWLINE;
  // the kitty protocol: Enter, Esc, Ctrl-C and a shifted letter as CSI u
  ku: [16] u8;
  #assert tui_key(k, tui_tb("`[13u", ku[..]), 0, false).key.kind == TUI_K_ENTER;
  #assert tui_key(k, tui_tb("`[27u", ku[..]), 0, false).key.kind == TUI_K_ESC;
  #assert tui_key(k, tui_tb("`[99;5u", ku[..]), 0, false).key.kind == TUI_K_CTRL_C;
  #assert tui_key(k, tui_tb("`[127;3u", ku[..]), 0, false).key.kind == TUI_K_KILL_WORD;
  sh := tui_key(k, tui_tb("`[65;2u", ku[..]), 0, false); #assert sh.key.kind == TUI_K_CHAR && sh.key.cp == 'A' && sh.used == 7;
  #assert tui_key(k, tui_tb("`[27;2;13~", ku[..]), 0, false).key.kind == TUI_K_NEWLINE;
  // Shift-Tab: legacy CSI Z and kitty 9;2u; plain Tab stays Tab
  #assert tui_key(k, tui_tb("`[Z", ku[..]), 0, false).key.kind == TUI_K_BACKTAB;
  #assert tui_key(k, tui_tb("`[9;2u", ku[..]), 0, false).key.kind == TUI_K_BACKTAB;
  #assert tui_key(k, tui_tb("`[9u", ku[..]), 0, false).key.kind == TUI_K_TAB;
  #assert tui_key(k, tui_tb("`[3~", tb8[..]), 0, false).key.kind == TUI_K_DELETE;
  #assert tui_key(k, tui_tb("`", tb9[..]), 0, false).key.kind == TUI_K_ESC;
  #assert tui_key(k, tui_tb("`", tb10[..]), 0, true).used == 0;
  #assert tui_key(k, tui_tb("`[1;", tb11[..]), 0, true).used == 0;
  r := tui_key(k, "é", 0, false); #assert r.key.kind == TUI_K_CHAR && r.key.cp == 0xe9 && r.used == 2;
  half := "é"; #assert tui_key(k, cast(string) half[0..<1], 0, true).used == 0;
}

#test "keys: Ctrl-Space and other free control keys, Undo, focus reports" {
  k_b: [1] TuiKeys; k := k_b[..]; b: [1] u8; ku: [16] u8;
  for c: 0..<32 {
    b[0] = cast,trunc(u8) c;
    r := tui_key(k, cast(string) b[..], 0, false);
    #assert r.used == 1;
    free := c == 0 || c == 7 || c == 15 || c == 17 || c == 18 || c == 19 || c == 20 || c == 22 || c == 24 || c == 25 || c == 28 || c == 29 || c == 30;
    #assert (r.key.kind == TUI_K_CTRL_KEY) == free;
    if free { #assert r.key.cp == c; }
    #assert (r.key.kind == TUI_K_UNDO) == (c == 26 || c == 31);
  }
  sp := tui_key(k, tui_tb("`[32;5u", ku[..]), 0, false); #assert sp.key.kind == TUI_K_CTRL_KEY && sp.key.cp == 0 && sp.used == 7;
  g := tui_key(k, tui_tb("`[103;5u", ku[..]), 0, false); #assert g.key.kind == TUI_K_CTRL_KEY && g.key.cp == 7;
  #assert tui_key(k, tui_tb("`[32;7u", ku[..]), 0, false).key.kind == TUI_K_NONE;      // Ctrl-Alt-Space is not Ctrl-Space
  #assert tui_key(k, tui_tb("`[32u", ku[..]), 0, false).key.cp == ' ';
  #assert tui_key(k, tui_tb("`[122;5u", ku[..]), 0, false).key.kind == TUI_K_UNDO;
  #assert tui_key(k, tui_tb("`[47;5u", ku[..]), 0, false).key.kind == TUI_K_UNDO && tui_key(k, tui_tb("`[95;5u", ku[..]), 0, false).key.kind == TUI_K_UNDO;
  #assert tui_key(k, tui_tb("`[47;7u", ku[..]), 0, false).key.kind == TUI_K_NONE;
  #assert tui_key(k, tui_tb("`[I", ku[..]), 0, false).key.kind == TUI_K_FOCUS_IN && tui_key(k, tui_tb("`[O", ku[..]), 0, false).key.kind == TUI_K_FOCUS_OUT;
  #assert tui_key(k, tui_tb("`[1O", ku[..]), 0, false).key.kind == TUI_K_NONE && tui_key(k, tui_tb("`OI", ku[..]), 0, false).key.kind == TUI_K_NONE;
}

#test "the composer: Undo takes back a paste or a dictated insertion, then typed bursts, as the chat's composer does" {
  e_b: [1] TuiEditor; e := e_b[..];
  tui_ed_set(e, "ab"); x := tui_ed_key(e, TuiKey.{kind = TUI_K_LEFT});
  #assert tui_ed_key(e, TuiKey.{kind = TUI_K_UNDO}) == TUI_ED_IGNORED && tui_ed_text(e) == "ab";   // a new document has nothing to undo
  #assert tui_ed_insert_undoable(e, "x\ny") && tui_ed_text(e) == "ax\nyb" && tui_ed_cur(e) == 4;
  #assert tui_ed_key(e, TuiKey.{kind = TUI_K_UNDO}) == TUI_ED_KEPT && tui_ed_text(e) == "ab" && tui_ed_cur(e) == 1;
  #assert !tui_ed_undo(e) && tui_ed_text(e) == "ab";
  // a cursor move after it does not lose it; typed text after it is a step of its own
  #assert tui_ed_insert_undoable(e, "z"); x = tui_ed_key(e, TuiKey.{kind = TUI_K_RIGHT});
  #assert tui_ed_undo(e) && tui_ed_text(e) == "ab";
  #assert tui_ed_insert_undoable(e, "q"); x = tui_ed_key(e, TuiKey.{kind = TUI_K_CHAR, cp = 'r'}); x = tui_ed_key(e, TuiKey.{kind = TUI_K_CHAR, cp = 's'});
  #assert tui_ed_text(e) == "aqrsb" && tui_ed_undo(e) && tui_ed_text(e) == "aqb" && tui_ed_undo(e) && tui_ed_text(e) == "ab";
  #assert tui_ed_insert_undoable(e, "s"); tui_ed_clear(e); #assert !tui_ed_undo(e) && tui_ed_n(e) == 0;
  // nothing, or too much, changes nothing
  g := e[0].gen; #assert !tui_ed_insert_undoable(e, "") && e[0].gen == g && !eb_can_undo(e[0].eb[..]);
  big: [TUI_EDIT_BYTES] u8; for i: 0..<big.count { big[i] = 'a'; }
  tui_ed_set(e, cast(string) big[0..<TUI_EDIT_BYTES - 1]); g = e[0].gen;
  #assert !tui_ed_insert_undoable(e, "bc") && tui_ed_n(e) == TUI_EDIT_BYTES - 1 && e[0].gen == g;
  #assert tui_ed_insert_undoable(e, "b") && tui_ed_n(e) == TUI_EDIT_BYTES && tui_ed_undo(e) && tui_ed_n(e) == TUI_EDIT_BYTES - 1;
}

#test "bracketed paste arrives as one key, newlines kept, even split across reads" {
  tb12: [64] u8; tb13: [64] u8; tb14: [64] u8;
  k_b: [1] TuiKeys; k := k_b[..];
  s := tui_tb("`[200~line one\rline two`[201~x", tb12[..]);
  r := tui_key(k, s, 0, false); #assert r.key.kind == TUI_K_NONE && k[0].pasting;
  at := r.used;
  r = tui_key(k, s, at, false); #assert r.key.kind == TUI_K_PASTE && r.key.text == "line one\nline two";
  at += r.used;
  #assert tui_key(k, s, at, false).key.cp == 'x';
  // split: the end marker arrives in two pieces
  k2_b: [1] TuiKeys; k2 := k2_b[..];
  a := tui_tb("`[200~ab`[2", tb13[..]);
  r = tui_key(k2, a, 0, true); r = tui_key(k2, a, r.used, true);
  #assert r.key.kind == TUI_K_NONE && r.used == 2;
  r = tui_key(k2, tui_tb("`[201~", tb14[..]), 0, true); #assert r.key.kind == TUI_K_PASTE && r.key.text == "ab";
}

#test "the composer: insert, move, delete words, continue with a backslash, submit" {
  e_b: [1] TuiEditor; e := e_b[..];
  for c: "hello world" { x := tui_ed_key(e, TuiKey.{kind = TUI_K_CHAR, cp = cast(int) c}); }
  #assert tui_ed_text(e) == "hello world" && tui_ed_cur(e) == 11;
  x := tui_ed_key(e, TuiKey.{kind = TUI_K_KILL_WORD}); #assert tui_ed_text(e) == "hello ";
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_HOME}); #assert tui_ed_cur(e) == 0;
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_CHAR, cp = 0xe9}); #assert tui_ed_text(e) == "éhello " && tui_ed_cur(e) == 2;
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_LEFT}); #assert tui_ed_cur(e) == 0;
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_DELETE}); #assert tui_ed_text(e) == "hello ";
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_END});
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_CHAR, cp = '\\'});
  #assert tui_ed_key(e, TuiKey.{kind = TUI_K_ENTER}) == TUI_ED_KEPT && tui_ed_text(e) == "hello \n";
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_CHAR, cp = 'x'});
  #assert tui_ed_key(e, TuiKey.{kind = TUI_K_ENTER}) == TUI_ED_SUBMIT;
  // words are the chat composer's (UAX #29): punctuation stops a word move and Ctrl-W; a grapheme moves whole
  tui_ed_set(e, "rm -rf /tmp/a.b é");
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_LEFT}); #assert tui_ed_cur(e) == 16;
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_WORD_LEFT}); #assert tui_ed_cur(e) == 12;
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_KILL_WORD}); #assert tui_ed_text(e) == "rm -rf /tmpa.b é" && tui_ed_cur(e) == 11;
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_WORD_RIGHT}); #assert tui_ed_cur(e) == 14;
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_UNDO}); #assert tui_ed_text(e) == "rm -rf /tmp/a.b é";
}

#test "history: Up and Down walk sent entries newest first and back to empty" {
  e_b: [1] TuiEditor; e := e_b[..];
  tui_ed_remember(e, "first"); tui_ed_remember(e, "second");
  x := tui_ed_key(e, TuiKey.{kind = TUI_K_UP}); #assert tui_ed_text(e) == "second";
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_UP}); #assert tui_ed_text(e) == "first";
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_UP}); #assert tui_ed_text(e) == "first";
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_DOWN}); #assert tui_ed_text(e) == "second";
  x = tui_ed_key(e, TuiKey.{kind = TUI_K_DOWN}); #assert tui_ed_text(e) == "";
}

#test "wrapping breaks at spaces, and the composer places the cursor" {
  r_b: [1] TuiRows; r := r_b[..]; tui_rows_reset(r);
  n := tui_rows_wrap(r, TUI_PLAIN, "● ", "  ", "one two three four", 10);
  #assert n == 3 && cast(string) r[0].text[0][0..<r[0].len[0]] == "● one two ";
  e_b: [1] TuiEditor; e := e_b[..]; tui_ed_set(e, "abcdefgh\nxy");
  tui_rows_reset(r);
  tui_rows_editor(r, e, "› ", "  ", 6, 10, TUI_PLAIN);
  #assert r[0].n == 3 && cast(string) r[0].text[1][0..<r[0].len[1]] == "  efgh";
  #assert r[0].cur_row == 2 && r[0].cur_col == 4;
  tui_ed_move(e, 4); tui_rows_reset(r); tui_rows_editor(r, e, "› ", "  ", 6, 10, TUI_PLAIN);
  #assert r[0].cur_row == 1 && r[0].cur_col == 2;
  // a full row puts the cursor on a fresh row below it
  tui_ed_set(e, "abcd"); tui_rows_reset(r); tui_rows_editor(r, e, "› ", "  ", 6, 10, TUI_PLAIN);
  #assert r[0].n == 2 && r[0].cur_row == 1 && r[0].cur_col == 2;
}

#test "the live region returns to its top, erases, redraws, and commits above itself" {
  ob: [4096] u8; o_b: [1] TuiOut; o := o_b[..]; o[0].b = ob[..];
  lv_b: [1] TuiLive; lv := lv_b[..];
  r_b: [1] TuiRows; r := r_b[..]; tui_rows_reset(r);
  k := tui_rows_add(r, TUI_PLAIN, "status"); k = tui_rows_add(r, TUI_PLAIN, "› hi");
  r[0].cur_row = 1; r[0].cur_col = 4;
  tui_live_draw(o, lv, r);
  #assert lv[0].drawn == 2 && lv[0].at == 1;
  o[0].n = 0;
  tui_live_commit(o, lv, TUI_PLAIN, "done");
  t := tui_text(o);
  #assert t.count > 6 && t[0] == 27 && t[1] == '[' && t[2] == '1' && t[3] == 'A';
  #assert lv[0].drawn == 0;
}

#test "a pinned region keeps its bottom on the last row as it shrinks and commits" {
  ob: [8192] u8; o_b: [1] TuiOut; o := o_b[..]; o[0].b = ob[..];
  lv_b: [1] TuiLive; lv := lv_b[..];
  r_b: [1] TuiRows; r := r_b[..];
  tui_live_pin(o, lv, 10);
  #assert lv[0].floor == 10 && lv[0].drawn == 0;
  tui_live_commit(o, lv, TUI_PLAIN, "banner\nhelp");          // two lines fill two blank rows
  #assert lv[0].floor == 8;
  tui_live_width(lv, 4);
  tui_live_commit(o, lv, TUI_PLAIN, "abcdefghi");                // nine columns on a four-column screen: three rows
  #assert lv[0].floor == 5;
  tui_live_width(lv, 0); lv[0].floor = 8;
  tui_rows_reset(r); k := tui_rows_add(r, TUI_PLAIN, "status"); k = tui_rows_add(r, TUI_PLAIN, "› ");
  r[0].cur_row = 1; r[0].cur_col = 2;
  tui_live_draw(o, lv, r);
  #assert lv[0].drawn == 8 && lv[0].at == 7;                  // six blank rows, then the two rows
  tui_rows_reset(r); k = tui_rows_add(r, TUI_PLAIN, "› ");
  r[0].cur_row = 0; r[0].cur_col = 2;
  tui_live_draw(o, lv, r);                                     // shorter: one more blank row
  #assert lv[0].drawn == 8 && lv[0].at == 7;
  for i: 0..<9 { tui_live_commit(o, lv, TUI_PLAIN, "line"); tui_live_draw(o, lv, r); }
  #assert lv[0].floor == 1 && lv[0].drawn == 1;               // the screen is full; no padding left
  tui_live_resize(lv, 4);
  #assert lv[0].rows == 4 && lv[0].floor == 1;
  // rows before pad_at go above the blank rows
  pin_b: [1] TuiLive; tui_live_pin(o, pin_b[..], 6);
  tui_rows_reset(r); k = tui_rows_add(r, TUI_PLAIN, "● partial"); r[0].pad_at = 1;
  k = tui_rows_add(r, TUI_PLAIN, "› "); r[0].cur_row = 1; r[0].cur_col = 2;
  o[0].n = 0; tui_live_draw(o, pin_b[..], r);
  t := tui_text(o);
  #assert pin_b[0].drawn == 6 && pin_b[0].at == 5;
  pw := "● partial"; cw := "› ";
  first := 0; while first + pw.count <= t.count && cast(string) t[first..<first + pw.count] != pw { first += 1; }
  last := 0; while last + cw.count <= t.count && cast(string) t[last..<last + cw.count] != cw { last += 1; }
  #assert first + pw.count <= t.count && last + cw.count <= t.count && first < last;
  unpinned_b: [1] TuiLive; tui_live_draw(o, unpinned_b[..], r);
  #assert unpinned_b[0].drawn == 2 && unpinned_b[0].floor == 0;
}

#test "a narrowed screen: the region erases the rows the terminal reflowed it onto and still ends on the last row" {
  ob: [8192] u8; o_b: [1] TuiOut; o := o_b[..]; o[0].b = ob[..];
  lv_b: [1] TuiLive; lv := lv_b[..];
  r_b: [1] TuiRows; r := r_b[..];
  tui_live_pin(o, lv, 10); tui_live_width(lv, 40);
  lv[0].floor = 5;                                              // a long session: the transcript fills the rows above
  wide: [39] u8; for i: 0..<39 { wide[i] = '='; }
  w := cast(string) wide[..];
  tui_rows_reset(r);
  k := tui_rows_add(r, TUI_PLAIN, w);                           // the Working row, flush to the right edge
  k = tui_rows_add(r, TUI_PLAIN, w);                            // a rule
  k = tui_rows_add(r, TUI_PLAIN, "› "); r[0].cur_row = 2; r[0].cur_col = 2;
  k = tui_rows_add(r, TUI_PLAIN, w); k = tui_rows_add(r, TUI_PLAIN, w);
  tui_live_draw(o, lv, r);
  #assert lv[0].drawn == 5 && lv[0].at == 2 && tui_live_above(lv) == 2 && tui_live_tall(lv) == 5;
  // 40 columns to 20: the terminal wraps each 39-column row onto two
  tui_live_width(lv, 20);
  #assert tui_live_above(lv) == 4 && tui_live_tall(lv) == 9;
  o[0].n = 0;
  tui_live_draw(o, lv, r);
  t := tui_text(o);
  eb: [64] u8; e_b: [1] TuiOut; e := e_b[..]; e[0].b = eb[..];
  tui_csi(e, "?25l"); tui_csi_n(e, 4, "A"); tui_byte(e, 13); tui_csi(e, "J");
  up := tui_text(e);
  #assert t.count > up.count && cast(string) t[0..<up.count] == up;   // up to the reflowed top, not the drawn one
  #assert lv[0].drawn == 9 && lv[0].at == 6;                    // four blank rows above: the bottom stays on the last row
  // and back to 40: rows drawn at 20 columns take one row each again
  tui_live_width(lv, 40);
  #assert tui_live_above(lv) == 6 && tui_live_tall(lv) == 9;
  // a commit after a narrowing reflow counts the reflowed rows too
  tui_live_width(lv, 10);
  o[0].n = 0; tui_live_commit(o, lv, TUI_PLAIN, "done");
  #assert lv[0].floor == 9 && lv[0].drawn == 0;                 // ten rows of region less the committed line
  // the cursor's own row: past a narrowed width its cell is on a later row
  c_b: [1] TuiLive; c := c_b[..]; tui_live_width(c, 40);
  tui_rows_reset(r); k = tui_rows_add(r, TUI_PLAIN, "› abcdefghijklmnopqrstuvwxyz"); r[0].cur_row = 0; r[0].cur_col = 28;
  o[0].n = 0; tui_live_draw(o, c, r);
  tui_live_width(c, 10);
  #assert tui_live_above(c) == 2;
}

// Renders md lines and strips the style sequences, for checks.
tui_md_plain :: (st: [] TuiMd, line: string, out: [] u8) -> string {
  ob: [4096] u8; o_b: [1] TuiOut; o := o_b[..]; o[0].b = ob[..];
  if !tui_md_line(st, line, o, 10) { return "<skip>"; }
  t := tui_text(o); n := 0; i := 0;
  while i < t.count { e := tui_esc_len(t, i); if e > 0 { i += e; continue; } out[n] = t[i]; n += 1; i += 1; }
  return cast(string) out[0..<n];
}

#test "markdown: emphasis, code, links, lists, headings, quotes, fences and rules" {
  st_b: [1] TuiMd; st := st_b[..]; b: [512] u8;
  #assert tui_md_plain(st, "**Bash**: run `ls -la` now", b[..]) == "Bash: run ls -la now";
  #assert tui_md_plain(st, "an *italic* and _this_ but not snake_case_name or 2*3*4", b[..]) == "an italic and this but not snake_case_name or 2*3*4";
  #assert tui_md_plain(st, "**unclosed bold", b[..]) == "**unclosed bold";
  #assert tui_md_plain(st, "- **Read / Write**: files", b[..]) == "• Read / Write: files";
  #assert tui_md_plain(st, "  * nested", b[..]) == "  ◦ nested";
  #assert tui_md_plain(st, "- [x] done", b[..]) == "☑ done";
  #assert tui_md_plain(st, "1. first", b[..]) == "1. first";
  #assert tui_md_plain(st, "## Core (ready now)", b[..]) == "Core (ready now)";
  #assert tui_md_plain(st, "> quoted", b[..]) == "│ quoted";
  #assert tui_md_plain(st, "see [the docs](https://x.y/z) and [x](#a)", b[..]) == "see the docs (https://x.y/z) and x";
  #assert tui_md_plain(st, "~~gone~~ \\*star\\*", b[..]) == "gone *star*";
  #assert tui_md_plain(st, "---", b[..]) == "──────────";
  #assert tui_md_plain(st, "```coax", b[..]) == "<skip>" && st[0].in_code;
  #assert tui_md_plain(st, "x := **y**;", b[..]) == "x := **y**;";
  #assert tui_md_plain(st, "```", b[..]) == "<skip>" && !st[0].in_code;
  ob: [256] u8; o_b: [1] TuiOut; o := o_b[..]; o[0].b = ob[..];
  ok := tui_md_line(st, "**b** `c`", o, 10);
  #assert tui_text_width(tui_text(o)) == 3 && tui_fit(tui_text(o), 1) > 1;
}

// The kinds a highlighted line shows, one letter per byte, for checks.
tui_hl_kinds :: (st: [] TuiHl, lang: int, line: string, out: [] u8) -> string {
  names := "tkdyfcCnsm,";      // text keyword directive type def call CONST (same color as numbers) number string comment punct
  n := 0; i := 0;
  while i < line.count {
    t := tui_hl_token(st, lang, line, i);
    for k: i..<t.end { out[n] = names[t.kind]; n += 1; }
    i = t.end;
  }
  return cast(string) out[0..<n];
}

#test "highlighting: Coax declarations, keywords, types, directives, strings, numbers and comments" {
  st_b: [1] TuiHl; st := st_b[..]; b: [256] u8;
  k := tui_hl_kinds(st, TUI_LANG_COAX, "foo :: (a: int)", b[..]);
  #assert k == "ffft,,t,t,tyyy,";
  k = tui_hl_kinds(st, TUI_LANG_COAX, "#load \"x\";", b[..]);
  #assert k == "dddddtsss,";
  k = tui_hl_kinds(st, TUI_LANG_COAX, "if MAX_N > 10 { f(x); }", b[..]);
  #assert k == "kktCCCCCtttnnt,tc,t,,t,";
  k = tui_hl_kinds(st, TUI_LANG_COAX, "x := 1; // done", b[..]);
  #assert k == "tt,,tn,tmmmmmmm";
  k = tui_hl_kinds(st, TUI_LANG_COAX, "a /* open", b[..]);
  #assert st[0].comment == 1 && k == "ttmmmmmmm";
  k = tui_hl_kinds(st, TUI_LANG_COAX, "still */ b", b[..]);
  #assert st[0].comment == 0 && k == "mmmmmmmmtt";
  k = tui_hl_kinds(st, TUI_LANG_COAX, "App :: struct", b[..]);
  #assert k == "yyyt,,tkkkkkk";
  k = tui_hl_kinds(st, TUI_LANG_HASH, "x = 1  # note", b[..]);
  #assert k == "tt,tnttmmmmmm";
  #assert tui_hl_lang("lib/tui/tui.coax") == TUI_LANG_COAX && tui_hl_lang("jai") == TUI_LANG_COAX && tui_hl_lang("rs") == TUI_LANG_C && tui_hl_lang("") == TUI_LANG_PLAIN;
}

#test "themes: light darkens the ladder, none leaves only bold" {
  ob: [256] u8; o_b: [1] TuiOut; o := o_b[..]; o[0].b = ob[..];
  tui_style(o, TUI_BRIGHT); #assert ob[0] == 27 && cast(string) ob[1..<o[0].n] == "[0;1;38;2;237;237;237m";
  o[0].n = 0; o[0].theme = TUI_THEME_LIGHT; tui_style(o, TUI_BRIGHT); #assert cast(string) ob[1..<o[0].n] == "[0;1;38;2;20;20;20m";
  o[0].n = 0; o[0].theme = TUI_THEME_NONE; tui_style(o, TUI_DIM); #assert cast(string) ob[1..<o[0].n] == "[0m";
  hl: [1] TuiHl; o[0].n = 0; tui_hl_line(hl[..], TUI_LANG_COAX, "\"s\"", o, tui_rgb(1, 2, 3)); #assert tui_text(o) == "\"s\"";   // none: no colours, no background, so no style at all
  #assert tui_theme_of("light") == TUI_THEME_LIGHT && tui_theme_of("blue") == -1;
}

#test "markdown tables: a box sized to the cells, aligned, and blocks when too wide" {
  t := "| Where | Files | What |\n| --- | ---: | :-: |\n| coax/web | 55 | goldens |\n| verse | 2 | `a\\|b` |\n";
  b: [8192] u8; o_b: [1] TuiOut; o := o_b[..]; o[0].b = b[..]; o[0].theme = TUI_THEME_NONE;
  tui_md_table(t, o, 80);
  pb: [8192] u8; pn := 0; i := 0; out := tui_text(o);
  while i < out.count { e := tui_esc_len(out, i); if e > 0 { i += e; continue; } pb[pn] = out[i]; pn += 1; i += 1; }
  plain := cast(string) pb[0..<pn];
  #assert plain == "┌──────────┬───────┬─────────┐\n│ Where    │ Files │  What   │\n├──────────┼───────┼─────────┤\n│ coax/web │    55 │ goldens │\n│ verse    │     2 │   a|b   │\n└──────────┴───────┴─────────┘\n";
  o[0].n = 0;
  tui_md_table(t, o, 20);
  pn = 0; i = 0; out = tui_text(o);
  while i < out.count { e := tui_esc_len(out, i); if e > 0 { i += e; continue; } pb[pn] = out[i]; pn += 1; i += 1; }
  #assert cast(string) pb[0..<pn] == "coax/web\n  Files: 55\n  What: goldens\nverse\n  Files: 2\n  What: a|b\n";
  #assert tui_md_is_row("  | a |") && !tui_md_is_row("a | b") && tui_md_is_sep("|---|:--:|") && !tui_md_is_sep("| a |");
}
