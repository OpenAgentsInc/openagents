wos_c_build_pipes_authorize :: (
  base_url: string, provider: string, user_id: string, org_id: string, return_to: string,
  url_out: [] u8, body_out: [] u8, url_n: [] int, body_n: [] int,
) -> bool #export_c #effects(all) {
  if !wos_pipes_provider_ok(provider) || user_id.count == 0 { return false; }
  scratch: [4096] u8;
  r := wos_pipes_authorize_data_integration(
    base_url,
    WosP_PipesAuthorizeDataIntegration.{
      slug = provider, user_id = user_id, organization_id = org_id, return_to = return_to,
    },
    scratch[..],
  );
  return wos_c_export_req(r, scratch[..], url_out, body_out, url_n, body_n);
}

