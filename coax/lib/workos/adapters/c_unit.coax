  return wos_c_export_req(r, scratch[..], url_out, empty[0..<0], url_n, bn[..]);
}

wos_c_build_list_connections :: (base_url: string, domain: string, url_out: [] u8, url_n: [] int) -> bool #export_c #effects(all) {
