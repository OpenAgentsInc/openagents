wos_c_is_github_provider :: (p: string) -> bool #effects(all) {
  return p == "GithubOAuth" || p == "GitHubOAuth" || p == "github" || p == "GitHub" || p == "github_oauth";
}

// Parse GET /user_management/users/{id}/identities JSON array and extract the GitHub OAuth idp_id.
// Returns bytes written (>0) into id_out, or -1 if absent/invalid.
wos_c_parse_github_idp_id :: (raw: string, id_out: [] u8) -> int #export_c #effects(all) {
  if raw.count < 2 || raw.count > 65536 || id_out.count < 1 { return -1; }
  d: [1] Jv; nodes: [1024] JvNode;
  if !jv_parse(d[..], raw, nodes[..]) { return -1; }
  v := d[0];
  arr := 0;
  if jv_kind(v, 0) == JV_OBJECT { arr = jv_get(v, 0, "data"); }
  if arr < 0 || jv_kind(v, arr) != JV_ARRAY { return -1; }
  cnt := jv_len(v, arr);
  for i: 0..<cnt {
    item := jv_at(v, arr, i);
    if jv_kind(v, item) != JV_OBJECT { continue; }
    pbuf: [48] u8;
    pn := wpw_string(v, jv_get(v, item, "provider"), pbuf[..]);
    if pn < 1 || !wos_c_is_github_provider(cast(string) pbuf[0..<pn]) { continue; }
    idn := wpw_string(v, jv_get(v, item, "idp_id"), id_out);
    if idn > 0 { return idn; }
  }
  return -1;
}

