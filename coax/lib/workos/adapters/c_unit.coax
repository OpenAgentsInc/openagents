}

wos_c_export_req :: (r: WosReq, scratch: [] u8, url_out: [] u8, body_out: [] u8, url_n: [] int, body_n: [] int) -> bool #effects(all) {
  url_n[0] = 0; body_n[0] = 0;
  if r.error != WOS_GEN_OK { return false; }
  u := wos_req_url(r, scratch);
  if u.count > url_out.count { return false; }
  for i: 0..<u.count { url_out[i] = u[i]; }
  url_n[0] = u.count;
  if r.has_body {
    b := wos_req_body(r, scratch);
    if b.count > body_out.count { return false; }
    for i: 0..<b.count { body_out[i] = b[i]; }
    body_n[0] = b.count;
  }
  return true;
}

#test "server C ABI unit builds Magic Auth, OAuth/PKCE, org selection, Events, Connections, and lifecycle requests cleanly" {
  ub: [512] u8; bb: [1024] u8; un: [1] int; bn: [1] int;
  #assert wos_c_build_magic_auth("", "a@b.co", ub[..], bb[..], un[..], bn[..]);
  #assert cast(string) ub[0..<un[0]] == "https://api.workos.com/user_management/magic_auth";
  #assert wos_c_build_auth_code("", "client_01", "", "c1", "v1", "1.1.1.1", "OA", ub[..], bb[..], un[..], bn[..]);
  #assert wos_c_build_revoke_session("", "sess_1", ub[..], bb[..], un[..], bn[..]);
  #assert wos_c_build_update_user_ext_id("", "user_1", "acct_1", ub[..], bb[..], un[..], bn[..]);
  #assert wos_c_build_delete_user("", "user_1", ub[..], un[..]);
  #assert !wos_c_build_delete_user("", "..", ub[..], un[..]);
  #assert wos_c_build_list_events("", "user.created,user.updated", "evt_1", 100, ub[..], un[..]);
  #assert wos_c_build_list_connections("", "acme.com", ub[..], un[..]);
  #assert wos_c_build_auth_password("", "client_01", "sk_1", "a@b.co", "secret123", "1.1.1.1", "OA", "rad_1", ub[..], bb[..], un[..], bn[..]);
  #assert cast(string) ub[0..<un[0]] == "https://api.workos.com/user_management/authenticate";
  #assert wos_c_build_create_user_password("", "a@b.co", "secret123", "1.1.1.1", "OA", ub[..], bb[..], un[..], bn[..]);
  #assert cast(string) ub[0..<un[0]] == "https://api.workos.com/user_management/users";
  #assert wos_c_build_password_reset("", "a@b.co", ub[..], bb[..], un[..], bn[..]);
  #assert cast(string) ub[0..<un[0]] == "https://api.workos.com/user_management/password_reset";
  #assert wos_c_build_password_reset_confirm("", "tok_1", "newsecret123", ub[..], bb[..], un[..], bn[..]);
  #assert cast(string) ub[0..<un[0]] == "https://api.workos.com/user_management/password_reset/confirm";
  #assert wos_c_build_auth_email_verify("", "client_01", "sk_1", "pat_1", "123456", "1.1.1.1", "OA", ub[..], bb[..], un[..], bn[..]);
  #assert cast(string) ub[0..<un[0]] == "https://api.workos.com/user_management/authenticate";
  #assert wos_c_build_get_user_identities("", "user_1", ub[..], un[..]);
  #assert cast(string) ub[0..<un[0]] == "https://api.workos.com/user_management/users/user_1/identities";
  #assert !wos_c_build_get_user_identities("", "", ub[..], un[..]) && !wos_c_build_get_user_identities("", "..", ub[..], un[..]);
  idb: [64] u8;
  idn := wos_c_parse_github_idp_id("[{\"idp_id\":\"9988\",\"type\":\"OAuth\",\"provider\":\"GoogleOAuth\"},{\"idp_id\":\"583231\",\"type\":\"OAuth\",\"provider\":\"GithubOAuth\"}]", idb[..]);
  #assert idn == 6 && cast(string) idb[0..<idn] == "583231";
  idn = wos_c_parse_github_idp_id("{\"data\":[{\"idp_id\":\"42\",\"provider\":\"GitHubOAuth\"}]}", idb[..]);
  #assert idn == 2 && cast(string) idb[0..<idn] == "42";
  #assert wos_c_parse_github_idp_id("[{\"idp_id\":\"9988\",\"provider\":\"GoogleOAuth\"}]", idb[..]) == -1;
  #assert wos_c_parse_github_idp_id("not-json", idb[..]) == -1;
}
