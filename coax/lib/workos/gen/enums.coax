// OpenAPI enum: ConnectionActivatedDataStatus
WOS_E_CONNECTION_ACTIVATED_DATA_STATUS_UNKNOWN :: 0;
WOS_E_CONNECTION_ACTIVATED_DATA_STATUS_LINKED :: 1;
WOS_E_CONNECTION_ACTIVATED_DATA_STATUS_UNLINKED :: 2;
wos_e_connection_activated_data_status_parse :: (s: string) -> u32 #effects(all) {
  if s == "linked" { return WOS_E_CONNECTION_ACTIVATED_DATA_STATUS_LINKED; }
  if s == "unlinked" { return WOS_E_CONNECTION_ACTIVATED_DATA_STATUS_UNLINKED; }
  return WOS_E_CONNECTION_ACTIVATED_DATA_STATUS_UNKNOWN;
}
wos_e_connection_activated_data_status_str :: (v: u32) -> string #effects(all) {
  if v == WOS_E_CONNECTION_ACTIVATED_DATA_STATUS_LINKED { return "linked"; }
  if v == WOS_E_CONNECTION_ACTIVATED_DATA_STATUS_UNLINKED { return "unlinked"; }
  return "";
}

