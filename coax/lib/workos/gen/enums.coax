// OpenAPI enum: UpdateWebhookEndpointStatus
WOS_E_UPDATE_WEBHOOK_ENDPOINT_STATUS_UNKNOWN :: 0;
WOS_E_UPDATE_WEBHOOK_ENDPOINT_STATUS_ENABLED :: 1;
WOS_E_UPDATE_WEBHOOK_ENDPOINT_STATUS_DISABLED :: 2;
wos_e_update_webhook_endpoint_status_parse :: (s: string) -> u32 #effects(all) {
  if s == "enabled" { return WOS_E_UPDATE_WEBHOOK_ENDPOINT_STATUS_ENABLED; }
  if s == "disabled" { return WOS_E_UPDATE_WEBHOOK_ENDPOINT_STATUS_DISABLED; }
  return WOS_E_UPDATE_WEBHOOK_ENDPOINT_STATUS_UNKNOWN;
}
wos_e_update_webhook_endpoint_status_str :: (v: u32) -> string #effects(all) {
  if v == WOS_E_UPDATE_WEBHOOK_ENDPOINT_STATUS_ENABLED { return "enabled"; }
  if v == WOS_E_UPDATE_WEBHOOK_ENDPOINT_STATUS_DISABLED { return "disabled"; }
  return "";
}

