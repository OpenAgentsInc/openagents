  if s == "validating" { return WOS_E_CONNECTION_DEACTIVATED_DATA_STATE_VALIDATING; }
  if s == "inactive" { return WOS_E_CONNECTION_DEACTIVATED_DATA_STATE_INACTIVE; }
  if s == "deleting" { return WOS_E_CONNECTION_DEACTIVATED_DATA_STATE_DELETING; }
  return WOS_E_CONNECTION_DEACTIVATED_DATA_STATE_UNKNOWN;
}
wos_e_connection_deactivated_data_state_str :: (v: u32) -> string #effects(all) {
  if v == WOS_E_CONNECTION_DEACTIVATED_DATA_STATE_DRAFT { return "draft"; }
