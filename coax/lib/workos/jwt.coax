// WorkOS RS256 access-token JWT & JWKS verification (matching
// workos-rust/src/helpers/session.rs and authkit-session/AuthKitCore.ts).
//
// Security invariants enforced here (#authority):
//  1. Duplicate JSON keys are rejected in both JWT header and payload.
//  2. Only alg="RS256" with a non-empty kid is accepted.
//  3. JWKS must contain a unique matching kid with kty="RSA", e="AQAB" (65537),
//     alg absent or "RS256", use absent or "sig", and key_ops (if present)
//     containing "verify".
//  4. RS256 signature is verified BEFORE evaluating exp so WOS_JWT_EXPIRED
//     (needs_refresh) is only ever returned for genuinely signed tokens.
//  5. Mandatory human-session token-confusion guard: sid non-empty, auth_time
//     present, sub_profile absent or "user", and sub_type absent (rejects
//     WorkOS widget and agent tokens signed by the same environment JWKS).
#load "../crypto/rsa_verify.coax";
#load "../encoding/fi-base64url.coax";
#load "../json/json.coax";
#authority;

WOS_JWT_MAX_LEN :: 8192;
WOS_JWT_MAX_PART :: 4096;
WOS_JWT_MAX_NODES :: 256;
WOS_JWKS_MAX_NODES :: 512;
WOS_JWT_CLAIM_STR :: 256;

WOS_JWT_OK :: 0;
WOS_JWT_EXPIRED :: 1;        // signature & all invariants passed, but now_sec >= exp (trigger refresh)
WOS_JWT_MALFORMED :: 2;
WOS_JWT_DUP_KEY :: 3;
WOS_JWT_BAD_ALG :: 4;
WOS_JWT_KID_UNKNOWN :: 5;    // caller may force-refresh JWKS once and retry
WOS_JWT_BAD_KEY :: 6;
WOS_JWT_BAD_SIG :: 7;
WOS_JWT_NOT_YET_VALID :: 8;
WOS_JWT_BAD_ISSUER :: 9;
WOS_JWT_TOKEN_CONFUSION :: 10;
WOS_JWT_BAD_CLAIMS :: 11;

WosJwtClaims :: struct {
  error: u32;
  sub: [WOS_JWT_CLAIM_STR] u8; sub_n: int;
  sid: [WOS_JWT_CLAIM_STR] u8; sid_n: int;
  org_id: [WOS_JWT_CLAIM_STR] u8; org_id_n: int;
  role: [WOS_JWT_CLAIM_STR] u8; role_n: int;
  iss: [WOS_JWT_CLAIM_STR] u8; iss_n: int;
  exp: int;
  nbf: int; has_nbf: bool;
  auth_time: int;
}

