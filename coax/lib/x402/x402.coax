// x402 v2 over HTTP, the client's half (nips/openagents/NIP-X402.md): the
// three headers are base64 of JSON. PAYMENT-REQUIRED carries the terms
// (x402_read_required), PAYMENT-SIGNATURE the retry's proof
// (x402_signature), PAYMENT-RESPONSE the settlement (x402_read_response).
// Only what our route sells is taken: version 2, scheme exact, Bitcoin
// mainnet Lightning (lnbtc:000000000019d6689c085ae165831e93) with a bolt11
// invoice, an amount as a positive decimal msat string, and the receiver
// profile openagents:spark-receiver:1. Anything else is refused, never
// guessed. The accepted terms go back byte for byte, as the server sent
// them. Nothing allocates: callers hand in buffers. The Lab uses it
// (apps/openagents-desktop/zeron/microcoder.coax).
#load "../nostr/json.coax";

X402_MAINNET :: "lnbtc:000000000019d6689c085ae165831e93";
X402_SPARK_PROFILE :: "openagents:spark-receiver:1";
X402_MAX_MSAT :: 2_100_000_000_000_000_000;

X402Offer :: struct {
  msat: int;                          // the amount, in millisatoshis
  timeout_s: int;                     // maxTimeoutSeconds
  invoice: [1400] u8; ni: int;        // the bolt11 invoice to pay
  hash: [64] u8; nh: int;             // its payment hash, hex
  accepted: [4096] u8; na: int;       // the accepts entry, exactly as it came
}

// ---- base64, the standard alphabet with padding (what the headers use)
X402_B64 :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

x402_b64_value :: (c: u8) -> int {
  if c >= 'A' && c <= 'Z' { return cast(int) (c - 'A'); }
  if c >= 'a' && c <= 'z' { return cast(int) (c - 'a') + 26; }
  if c >= '0' && c <= '9' { return cast(int) (c - '0') + 52; }
  if c == '+' { return 62; }
  if c == '/' { return 63; }
  return -1;
}

// in as base64 into out: its length, or -1 when it doesn't fit.
x402_b64_encode :: (in: string, out: [] u8) -> int {
  a := X402_B64;
  n := 0; i := 0;
  if (in.count + 2) / 3 * 4 > out.count { return -1; }
  while i + 2 < in.count {
    v := (cast(int) in[i] << 16) | (cast(int) in[i + 1] << 8) | cast(int) in[i + 2];
    out[n] = a[(v >> 18) & 63]; out[n + 1] = a[(v >> 12) & 63]; out[n + 2] = a[(v >> 6) & 63]; out[n + 3] = a[v & 63];
    n += 4; i += 3;
  }
  left := in.count - i;
  if left == 1 {
    v := cast(int) in[i] << 16;
    out[n] = a[(v >> 18) & 63]; out[n + 1] = a[(v >> 12) & 63]; out[n + 2] = '='; out[n + 3] = '='; n += 4;
  } else if left == 2 {
    v := (cast(int) in[i] << 16) | (cast(int) in[i + 1] << 8);
    out[n] = a[(v >> 18) & 63]; out[n + 1] = a[(v >> 12) & 63]; out[n + 2] = a[(v >> 6) & 63]; out[n + 3] = '='; n += 4;
  }
  return n;
}

// base64 text into out: the bytes' count, or -1 when it isn't base64 (padding
// required, nothing after it) or doesn't fit.
x402_b64_decode :: (in: string, out: [] u8) -> int {
  if in.count % 4 != 0 { return -1; }
  n := 0; i := 0;
  while i < in.count {
    a := x402_b64_value(in[i]); b := x402_b64_value(in[i + 1]);
    pad3 := in[i + 2] == '='; pad4 := in[i + 3] == '=';
    c := ifx pad3 then 0 else x402_b64_value(in[i + 2]);
    d := ifx pad4 then 0 else x402_b64_value(in[i + 3]);
    last := i + 4 == in.count;
    if a < 0 || b < 0 || c < 0 || d < 0 || (pad3 && !pad4) || ((pad3 || pad4) && !last) { return -1; }
    v := (a << 18) | (b << 12) | (c << 6) | d;
    k := ifx pad3 then 1 else ifx pad4 then 2 else 3;
    if n + k > out.count { return -1; }
    out[n] = cast(u8) ((v >> 16) & 255);
    if k > 1 { out[n + 1] = cast(u8) ((v >> 8) & 255); }
    if k > 2 { out[n + 2] = cast(u8) (v & 255); }
    n += k; i += 4;
  }
  return n;
}

// A decimal msat string: its value, or -1 (empty, a sign, a leading zero, not digits, too large).
x402_msat :: (s: string) -> int {
  if s.count == 0 || s.count > 19 || s[0] == '0' { return -1; }
  v := 0;
  for c: s {
    if c < '0' || c > '9' { return -1; }
    d := cast(int) (c - '0');
    if v > (X402_MAX_MSAT - d) / 10 { return -1; }
    v = v * 10 + d;
  }
  return v;
}

x402_is_hex64 :: (s: string) -> bool {
  if s.count != 64 { return false; }
  for c: s { if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) { return false; } }
  return true;
}

// The string value just read, unescaped into out (plain ASCII expected): its length, or -1.
x402_take :: (j: [] Json, out: [] u8) -> int {
  if j[0].tok != JSON_STRING { return -1; }
  return json_unescape(json_text(j), out);
}

// Reads one accepts entry (its '{' was just read) into o. "" or why not.
x402_entry :: (j: [] Json, o: [] X402Offer) -> string {
  start := j[0].from;
  scheme_ok := false; network_ok := false; asset_ok := false; profile_ok := false; method_ok := true; flow_ok := false;
  o[0].msat = -1; o[0].timeout_s = 0; o[0].ni = 0; o[0].nh = 0;
  v: [1400] u8;
  while true {
    t := json_next(j);
    if t == JSON_OBJECT_END { break; }
    if t != JSON_STRING || !j[0].key { return "the terms are not JSON"; }
    k := json_text(j);
    t = json_next(j);
    if k == "scheme" { n := x402_take(j, v[..]); scheme_ok = n > 0 && cast(string) v[0..<n] == "exact"; }
    else if k == "network" { n := x402_take(j, v[..]); network_ok = n > 0 && cast(string) v[0..<n] == X402_MAINNET; }
    else if k == "asset" { n := x402_take(j, v[..]); asset_ok = n > 0 && cast(string) v[0..<n] == "BTC"; }
    else if k == "amount" { n := x402_take(j, v[..]); o[0].msat = ifx n > 0 then x402_msat(cast(string) v[0..<n]) else -1; }
    else if k == "maxTimeoutSeconds" { if t != JSON_NUMBER { return "maxTimeoutSeconds is not a number"; } x := json_int(json_text(j)); o[0].timeout_s = ifx x.ok then x.value else 0; }
    else if k == "extra" {
      if t != JSON_OBJECT { return "extra is not an object"; }
      while true {
        u := json_next(j);
        if u == JSON_OBJECT_END { break; }
        if u != JSON_STRING || !j[0].key { return "the terms are not JSON"; }
        e := json_text(j);
        u = json_next(j);
        if e == "invoice" { n := x402_take(j, o[0].invoice[..]); o[0].ni = ifx n > 0 then n else 0; }
        else if e == "paymentHash" { n := x402_take(j, v[..]); if n == 64 { for i: 0..<64 { o[0].hash[i] = v[i]; } o[0].nh = 64; } }
        else if e == "receiverProfile" { n := x402_take(j, v[..]); profile_ok = n > 0 && cast(string) v[0..<n] == X402_SPARK_PROFILE; }
        else if e == "method" { n := x402_take(j, v[..]); method_ok = n > 0 && cast(string) v[0..<n] == "bolt11"; }
        else if e == "paymentFlow" { n := x402_take(j, v[..]); flow_ok = n > 0 && cast(string) v[0..<n] == "upfront"; }
        else if !json_skip(j) { return "the terms are not JSON"; }
      }
    }
    else if !json_skip(j) { return "the terms are not JSON"; }
    if j[0].tok == JSON_ERROR { return "the terms are not JSON"; }
  }
  end := j[0].to;
  if !scheme_ok { return "not the exact scheme"; }
  if !network_ok { return "not Bitcoin mainnet Lightning"; }
  if !asset_ok || !method_ok { return "not a bolt11 payment in BTC"; }
  if !flow_ok { return "not an upfront payment"; }
  if !profile_ok { return "not a receiver profile this client takes"; }
  if o[0].msat <= 0 { return "the amount is not a msat string"; }
  inv := cast(string) o[0].invoice[0..<o[0].ni];
  if o[0].ni < 8 || inv[0..<4] != "lnbc" { return "no mainnet invoice"; }
  if o[0].nh != 64 || !x402_is_hex64(cast(string) o[0].hash[0..<64]) { return "no payment hash"; }
  if end - start > o[0].accepted.count { return "the terms are too long"; }
  for i: start..<end { o[0].accepted[i - start] = j[0].text[i]; }
  o[0].na = end - start;
  return "";
}

// A PAYMENT-REQUIRED header (or a 402 body, the same JSON) into o: "" or why
// not. scratch holds the decoded JSON while it is read.
x402_read_required :: (header: string, o: [] X402Offer, scratch: [] u8) -> string {
  o[0].na = 0;
  text := header;
  a := 0; b := header.count;
  while a < b && header[a] <= 32 { a += 1; }
  while b > a && header[b - 1] <= 32 { b -= 1; }
  if b > a && header[a] != '{' {
    n := x402_b64_decode(header[a..<b], scratch);
    if n < 0 { return "PAYMENT-REQUIRED is not base64"; }
    text = cast(string) scratch[0..<n];
  } else { text = header[a..<b]; }
  j: [1] Json;
  json_start(j[..], text);
  if json_next(j[..]) != JSON_OBJECT { return "PAYMENT-REQUIRED is not a JSON object"; }
  version := 0; got := false;
  while true {
    t := json_next(j[..]);
    if t == JSON_OBJECT_END { break; }
    if t != JSON_STRING || !j[0].key { return "PAYMENT-REQUIRED is not JSON"; }
    k := json_text(j[..]);
    t = json_next(j[..]);
    if k == "x402Version" { x := json_int(json_text(j[..])); version = ifx t == JSON_NUMBER && x.ok then x.value else 0; }
    else if k == "accepts" {
      if t != JSON_ARRAY { return "accepts is not a list"; }
      while true {
        u := json_next(j[..]);
        if u == JSON_ARRAY_END { break; }
        if u != JSON_OBJECT { return "an accepts entry is not an object"; }
        if got { if !json_skip(j[..]) { return "PAYMENT-REQUIRED is not JSON"; } continue; }   // one option per challenge: the first
        why := x402_entry(j[..], o);
        if why.count > 0 { return why; }
        got = true;
      }
    }
    else if !json_skip(j[..]) { return "PAYMENT-REQUIRED is not JSON"; }
  }
  if json_next(j[..]) != JSON_END { return "PAYMENT-REQUIRED is not JSON"; }
  if version != 2 { return "not x402 version 2"; }
  if !got { return "no terms to pay"; }
  return "";
}

// The PAYMENT-SIGNATURE for o: base64 of {"x402Version":2,"accepted":<as
// sent>,"payload":{"paymentHash":...,"preimage":...}} into out, the preimage
// left out when the payer's wallet gave none (preimage ""). Its length, or -1.
x402_signature :: (o: [] X402Offer, preimage: string, out: [] u8) -> int {
  if o[0].na == 0 || o[0].nh != 64 { return -1; }
  if preimage.count > 0 && !x402_is_hex64(preimage) { return -1; }
  j: [5000] u8;
  n := json_raw(j[..], 0, "{\"x402Version\":2,\"accepted\":");
  n = json_raw(j[..], n, cast(string) o[0].accepted[0..<o[0].na]);
  n = json_raw(j[..], n, ",\"payload\":{\"paymentHash\":");
  n = json_write_string(j[..], n, cast(string) o[0].hash[0..<64]);
  if preimage.count > 0 { n = json_raw(j[..], n, ",\"preimage\":"); n = json_write_string(j[..], n, preimage); }
  n = json_raw(j[..], n, "}}");
  if n < 0 { return -1; }
  return x402_b64_encode(cast(string) j[0..<n], out);
}

// A PAYMENT-RESPONSE: whether it says success for o's payment hash.
x402_read_response :: (header: string, o: [] X402Offer, scratch: [] u8) -> bool {
  n := x402_b64_decode(header, scratch);
  if n < 0 { return false; }
  j: [1] Json;
  json_start(j[..], cast(string) scratch[0..<n]);
  if json_next(j[..]) != JSON_OBJECT { return false; }
  ok := false; same := false;
  v: [128] u8;
  while true {
    t := json_next(j[..]);
    if t == JSON_OBJECT_END { break; }
    if t != JSON_STRING || !j[0].key { return false; }
    k := json_text(j[..]);
    t = json_next(j[..]);
    if k == "success" { ok = t == JSON_TRUE; }
    else if k == "transaction" { m := x402_take(j[..], v[..]); same = m == 64 && o[0].nh == 64 && cast(string) v[0..<64] == cast(string) o[0].hash[0..<64]; }
    else if !json_skip(j[..]) { return false; }
  }
  return ok && same && json_next(j[..]) == JSON_END;
}

// ---- checks

X402_TEST_INVOICE :: "lnbc500n1p4wfve5pp57aglnny6x6dmfavycacm5pkc2uawryjn8te7y5wt02qcpsja0svs";
X402_TEST_HASH :: "f751f9cc9a369bb4f584c771ba06d8573ae192533af3e251cb7a8180c25d7c19";
X402_TEST_TERMS :: "{\"scheme\":\"exact\",\"network\":\"lnbtc:000000000019d6689c085ae165831e93\",\"amount\":\"50000\",\"asset\":\"BTC\",\"payTo\":\"02ab\",\"maxTimeoutSeconds\":600,\"extra\":{\"method\":\"bolt11\",\"paymentFlow\":\"upfront\",\"receiverProfile\":\"openagents:spark-receiver:1\",\"invoice\":\"lnbc500n1p4wfve5pp57aglnny6x6dmfavycacm5pkc2uawryjn8te7y5wt02qcpsja0svs\",\"paymentHash\":\"f751f9cc9a369bb4f584c771ba06d8573ae192533af3e251cb7a8180c25d7c19\",\"requestDigest\":\"00\"}}";

x402_test_required :: (terms: string, version: string, out: [] u8) -> string {
  n := json_raw(out, 0, "{\"x402Version\":");
  n = json_raw(out, n, version);
  n = json_raw(out, n, ",\"error\":\"payment required\",\"resource\":{\"url\":\"https://openagents.com/api/v1/inference/credit\"},\"accepts\":[");
  n = json_raw(out, n, terms);
  n = json_raw(out, n, "]}");
  return cast(string) out[0..<n];
}

// The terms with one piece replaced.
x402_test_swap :: (from: string, to: string, out: [] u8) -> string {
  t := X402_TEST_TERMS; n := 0; i := 0;
  while i < t.count {
    if i + from.count <= t.count && t[i..<i + from.count] == from { n = json_raw(out, n, to); i += from.count; }
    else { out[n] = t[i]; n += 1; i += 1; }
  }
  return cast(string) out[0..<n];
}

#test "base64: RFC 4648 vectors both ways; bad text and padding refuse" {
  plain := [7] string.["", "f", "fo", "foo", "foob", "fooba", "foobar"];
  codes := [7] string.["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy"];
  for i: 0..<7 {
    e: [16] u8; d: [16] u8;
    n := x402_b64_encode(plain[i], e[..]);
    #assert n == codes[i].count && cast(string) e[0..<n] == codes[i];
    m := x402_b64_decode(codes[i], d[..]);
    #assert m == plain[i].count && cast(string) d[0..<m] == plain[i];
  }
  d: [16] u8;
  bad := [7] string.["Zg", "Zg=", "Z=g=", "Zg==Zg==", "Zm9v!A==", "-_==", "Zm9vYmFy\n"];
  for s: bad { #assert x402_b64_decode(s, d[..]) == -1; }
  e: [3] u8;
  #assert x402_b64_encode("f", e[..]) == -1 && x402_b64_decode("Zm9v", d[0..<2]) == -1;
}

#test "msat strings: positive decimals only" {
  #assert x402_msat("1000") == 1000 && x402_msat("50000") == 50000 && x402_msat("1") == 1;
  #assert x402_msat("") == -1 && x402_msat("0") == -1 && x402_msat("050") == -1 && x402_msat("-5") == -1;
  #assert x402_msat("5.0") == -1 && x402_msat("1e3") == -1 && x402_msat("99999999999999999999") == -1;
  #assert x402_msat("2100000000000000000") == X402_MAX_MSAT && x402_msat("2100000000000000001") == -1;
}

#test "a challenge: the terms, the invoice and hash read; the accepted entry kept byte for byte" {
  j: [6000] u8; e: [9000] u8; s: [6000] u8;
  req := x402_test_required(X402_TEST_TERMS, "2", j[..]);
  o: [1] X402Offer;
  #assert x402_read_required(req, o[..], s[..]).count == 0;
  #assert o[0].msat == 50000 && o[0].timeout_s == 600;
  #assert cast(string) o[0].invoice[0..<o[0].ni] == X402_TEST_INVOICE && cast(string) o[0].hash[0..<64] == X402_TEST_HASH;
  #assert cast(string) o[0].accepted[0..<o[0].na] == X402_TEST_TERMS;
  n := x402_b64_encode(req, e[..]);
  o2: [1] X402Offer;
  #assert x402_read_required(cast(string) e[0..<n], o2[..], s[..]).count == 0 && o2[0].msat == 50000;   // the header form
}

#test "a challenge with other terms refuses, naming why" {
  j: [6000] u8; t: [6000] u8; s: [6000] u8; o: [1] X402Offer;
  #assert x402_read_required(x402_test_required(X402_TEST_TERMS, "1", j[..]), o[..], s[..]) == "not x402 version 2";
  #assert x402_read_required(x402_test_required(x402_test_swap("\"exact\"", "\"upto\"", t[..]), "2", j[..]), o[..], s[..]) == "not the exact scheme";
  #assert x402_read_required(x402_test_required(x402_test_swap("lnbtc:000000000019d6689c085ae165831e93", "lnbtc:000000000933ea01ad0ee984209779ba", t[..]), "2", j[..]), o[..], s[..]) == "not Bitcoin mainnet Lightning";
  #assert x402_read_required(x402_test_required(x402_test_swap("\"BTC\"", "\"USDC\"", t[..]), "2", j[..]), o[..], s[..]) == "not a bolt11 payment in BTC";
  #assert x402_read_required(x402_test_required(x402_test_swap("\"50000\"", "50000", t[..]), "2", j[..]), o[..], s[..]) == "the amount is not a msat string";
  #assert x402_read_required(x402_test_required(x402_test_swap("\"50000\"", "\"50.5\"", t[..]), "2", j[..]), o[..], s[..]) == "the amount is not a msat string";
  #assert x402_read_required(x402_test_required(x402_test_swap("openagents:spark-receiver:1", "other:1", t[..]), "2", j[..]), o[..], s[..]) == "not a receiver profile this client takes";
  #assert x402_read_required(x402_test_required(x402_test_swap("\"lnbc500n1", "\"lntb500n1", t[..]), "2", j[..]), o[..], s[..]) == "no mainnet invoice";
  #assert x402_read_required(x402_test_required(x402_test_swap("\"upfront\"", "\"deferred\"", t[..]), "2", j[..]), o[..], s[..]) == "not an upfront payment";
  #assert x402_read_required(x402_test_required(x402_test_swap(X402_TEST_HASH, "f751", t[..]), "2", j[..]), o[..], s[..]) == "no payment hash";
  #assert x402_read_required(x402_test_required("", "2", j[..]), o[..], s[..]) == "no terms to pay";
  #assert x402_read_required("!!!!", o[..], s[..]) == "PAYMENT-REQUIRED is not base64";
  #assert x402_read_required("{\"x402Version\":2,\"accepts\":[", o[..], s[..]).count > 0;
  #assert o[0].na == 0;
}

#test "the retry's PAYMENT-SIGNATURE: the accepted terms as sent, the hash, and the preimage when there is one" {
  j: [6000] u8; s: [6000] u8; sig: [8000] u8; back: [6000] u8; o: [1] X402Offer;
  #assert x402_read_required(x402_test_required(X402_TEST_TERMS, "2", j[..]), o[..], s[..]).count == 0;
  n := x402_signature(o[..], "", sig[..]);
  m := x402_b64_decode(cast(string) sig[0..<n], back[..]);
  want: [6000] u8;
  w := json_raw(want[..], 0, "{\"x402Version\":2,\"accepted\":");
  w = json_raw(want[..], w, X402_TEST_TERMS);
  w = json_raw(want[..], w, ",\"payload\":{\"paymentHash\":\"f751f9cc9a369bb4f584c771ba06d8573ae192533af3e251cb7a8180c25d7c19\"}}");
  #assert n > 0 && cast(string) back[0..<m] == cast(string) want[0..<w];
  pre := "11111111111111111111111111111111111111111111111111111111111111aa";
  n = x402_signature(o[..], pre, sig[..]);
  m = x402_b64_decode(cast(string) sig[0..<n], back[..]);
  #assert json_valid(cast(string) back[0..<m]) && json_has_text(cast(string) back[0..<m], "\"preimage\":\"11111111111111111111111111111111111111111111111111111111111111aa\"");
  #assert x402_signature(o[..], "abc", sig[..]) == -1;
  o[0].na = 0;
  #assert x402_signature(o[..], "", sig[..]) == -1;
}

#test "PAYMENT-RESPONSE: success for this payment hash only" {
  j: [6000] u8; s: [6000] u8; r: [600] u8; o: [1] X402Offer;
  #assert x402_read_required(x402_test_required(X402_TEST_TERMS, "2", j[..]), o[..], s[..]).count == 0;
  n := x402_b64_encode("{\"success\":true,\"transaction\":\"f751f9cc9a369bb4f584c771ba06d8573ae192533af3e251cb7a8180c25d7c19\",\"network\":\"lnbtc:000000000019d6689c085ae165831e93\"}", r[..]);
  #assert x402_read_response(cast(string) r[0..<n], o[..], s[..]);
  n = x402_b64_encode("{\"success\":false,\"transaction\":\"f751f9cc9a369bb4f584c771ba06d8573ae192533af3e251cb7a8180c25d7c19\"}", r[..]);
  #assert !x402_read_response(cast(string) r[0..<n], o[..], s[..]);
  n = x402_b64_encode("{\"success\":true,\"transaction\":\"0051f9cc9a369bb4f584c771ba06d8573ae192533af3e251cb7a8180c25d7c19\"}", r[..]);
  #assert !x402_read_response(cast(string) r[0..<n], o[..], s[..]);
  #assert !x402_read_response("e30", o[..], s[..]);
}

json_has_text :: (text: string, part: string) -> bool {
  if part.count > text.count { return false; }
  for i: 0..<(text.count - part.count + 1) { if text[i..<i + part.count] == part { return true; } }
  return false;
}
