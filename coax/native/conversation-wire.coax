// Public presentation references. Parsing one never grants access or starts an
// agent. Original domain IDs/ownership remain with their existing contracts.
#load "../lib/json/shape.coax";
#load "../lib/net/relay_uri.coax";
NCV_SCHEMA :: "coax.native.conversation.v1alpha1";
NCV_KINDS :: [7]string.["account-v1","account-v2","environment","project","world","nip17","nip29"];
NcvRef :: struct {ok:bool;kind:int;id:[256]u8;ni:int;scope:[256]u8;ns:int;}
#test "conversation references retain kind scope and original IDs in pinned bytes" {
 b:[1024]u8;q:[1]NcvRef;
 for kind:NCV_KINDS {scope:=ifx kind=="nip29" then "wss://relay.openagents.com" else "account-or-host";n:=ncv_write(kind,"original-id",scope,b[..]);#assert n>0 && ncv_read(cast(string)b[0..<n],q[..]) && cast(string)q[0].id[0..<q[0].ni]=="original-id";}
 n:=ncv_write("account-v2","thread_123","acct_example",b[..]);#assert cast(string)b[0..<n]=="{\"schema\":\"coax.native.conversation.v1alpha1\",\"kind\":\"account-v2\",\"id\":\"thread_123\",\"scope\":\"acct_example\"}";
 #assert ncv_write("unknown","id","scope",b[..])<0 && ncv_write("nip29","id","ws://a.example",b[..])<0;
 #assert ncv_write("account-v1","","scope",b[..])<0 && ncv_write("world","id","",b[..])<0 && ncv_write("project","id","scope",b[0..<1])<0;
 #assert !ncv_read("{}",q[..]) && !ncv_read("{\"kind\":\"account-v2\",\"id\":\"a\",\"scope\":\"b\",\"schema\":\"coax.native.conversation.v1alpha1\",\"account\":\"other\"}",q[..]);
}
#test "conversation references admit one-byte IDs and scopes, reset refused records and bound complete input" {
 b:[4097]u8;q:[1]NcvRef;n:=ncv_write("account-v2","a","b",b[..]);
 #assert n>0 && ncv_read(cast(string)b[0..<n],q[..]) && q[0].ok && q[0].ni==1 && q[0].ns==1;
 #assert !ncv_read(cast(string)b[0..<n],q[0..<0]);
 #assert !ncv_read("{",q[..]) && !q[0].ok && q[0].kind==0 && q[0].ni==0 && q[0].ns==0;
 for i:n..<4097 {b[i]=' ';}
 #assert ncv_read(cast(string)b[0..<4096],q[..]) && q[0].ok && !ncv_read(cast(string)b[..],q[..]);
 #assert !ncv_read("{\"schema\":\"wrong\",\"kind\":\"account-v2\",\"id\":\"a\",\"scope\":\"b\"}",q[..]);
 #assert !ncv_read("{\"schema\":\"coax.native.conversation.v1alpha1\",\"kind\":\"account-v2\",\"scope\":\"b\"}",q[..]);
}
ncv_kind :: (s:string)->int #effects(all) {for value,i:NCV_KINDS {if value==s {return i+1;}}return 0;}
ncv_read :: (raw:string,q:[]NcvRef)->bool #effects(all) {
 if q.count!=1 {return false;}q[0]=NcvRef.{};d:[1]Jv;nodes:[12]JvNode;if raw.count>4096 || !jv_parse(d[..],raw,nodes[..]) {return false;}v:=d[0];fields:=[4]string.["schema","kind","id","scope"];
 if !js_fields(v,0,fields[..]) || jv_len(v,0)!=4 {return false;} // mutant: equivalent (|| -> && still refuses extra/duplicate full records; every missing required field is rejected below)
 if jv_raw(v,jv_get(v,0,"schema"))!=NCV_SCHEMA {return false;}
 q[0].kind=ncv_kind(jv_raw(v,jv_get(v,0,"kind")));q[0].ni=js_string(v,jv_get(v,0,"id"),q[0].id[..]);q[0].ns=js_string(v,jv_get(v,0,"scope"),q[0].scope[..]);
 if q[0].kind==0 || q[0].ni<1 || q[0].ns<1 {return false;}
 if q[0].kind==7 {r:=relay_uri(cast(string)q[0].scope[0..<q[0].ns]);if !r.ok || !r.tls {return false;}}
 q[0].ok=true;return true;
}
ncv_write :: (kind:string,id:string,scope:string,out:[]u8)->int #effects(all) {
 o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],NCV_SCHEMA);jo_key(o[..],"kind");jo_str(o[..],kind);jo_key(o[..],"id");jo_str(o[..],id);jo_key(o[..],"scope");jo_str(o[..],scope);jo_end(o[..]);q:[1]NcvRef;return ifx !o[0].bad && ncv_read(jo_text(o[..]),q[..]) then o[0].n else -1;
}
