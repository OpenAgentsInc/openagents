  opened:=ifx i==0 then cj_open(j[..],buf[..],0,owner) else cj_open_v2(j[..],buf[..],0,owner,scope);
  if opened.status!=CJO_NEW || cj_relay(j[..],buf[..],"wss://r1.example")!=0 || j[0].len!=decoded.written || cast(string)buf[0..<j[0].len]!=cast(string)expected[0..<decoded.written] {return 1;}
  opened=ifx i==0 then cj_open(k[..],expected[..],decoded.written,owner) else cj_open_v2(k[..],expected[..],decoded.written,owner,scope);
  if opened.status!=CJO_DONE || !cj_same(j[..],k[..]) {return 1;}
  n=fs_read(profiles[i],raw[..]);d:[1]Jv;nodes:[128]JvNode;if n<0 || !jv_parse(d[..],cast(string)raw[0..<n],nodes[..]) {return 1;}
  v:=d[0];if js_number(v,jv_get(v,0,"header_bytes"))!=(ifx i==0 then CJ_HEADER else CJ_V2_HEADER) || js_number(v,jv_get(v,0,"record_body_max"))!=(ifx i==0 then CJ_RECORD_MOST else CJ_V2_RECORD) || js_number(v,jv_get(v,0,"record_length_bytes"))!=cj_width(j[..]) {return 1;}
 }
