 n=nsr_write("store","snapshot",op,id,"ok",7,0,"",out[..]);if n<0 || !nms_fixture("proto/coax-native/fixtures/nostr-result-v1alpha1.json",cast(string)out[0..<n]) {return 1;}
 rows:[1]MsIndexRow;for c,i:op {rows[0].id[i]=c;}for c,i:id {rows[0].author[i]=c;}rows[0].kind=1059;rows[0].created=1700000000;rows[0].pending=18446744073709551615;rows[0].accepted=9007199254740993;rows[0].refused=2;
 n=ms_index_write(7,0,true,rows[..],out[..]);if n<0 || !nms_fixture("proto/coax-native/fixtures/nostr-index-v1alpha1.json",cast(string)out[0..<n]) {return 1;}
