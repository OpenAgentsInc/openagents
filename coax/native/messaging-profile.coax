  } else if i==1 {statuses:=jv_get(d[0],0,"statuses");if jv_len(d[0],statuses)!=NS_STATUSES.count {return 1;}for name,k:NS_STATUSES {if jv_raw(d[0],jv_at(d[0],statuses,k))!=name {return 1;}}}
 }
