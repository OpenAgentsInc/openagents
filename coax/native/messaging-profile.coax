  if i==6 && js_number(d[0],jv_get(d[0],limits,"records_per_namespace"))!=NSO_RECORDS {return 1;}
  if i==7 && (js_number(d[0],jv_get(d[0],0,"operation"))!=NRS_OP || js_number(d[0],jv_get(d[0],limits,"frame_bytes"))!=NRS_FRAME || js_number(d[0],jv_get(d[0],limits,"wire_bytes"))!=NRS_WIRE || js_number(d[0],jv_get(d[0],limits,"slots"))!=NRR_SLOTS) {return 1;}
