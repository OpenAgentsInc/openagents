#test "complete seal verifies all inboxes before creating every peer and sender copy" #steps 1800000000 {
 id:="79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798";p:="{\"schema\":\"coax.native.nostr-seal.v1alpha1\",\"created_at\":1730000000,\"participants\":[\"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659\"],\"content\":\"private complete message\",\"subject\":\"\",\"reply\":\"\"}";
 q:[1]NscRequest;b:[400000]u8;n:=nsc_request("seal",id,id,p,b[..]);#assert n>0 && nsc_read(cast(string)b[0..<n],q[..]);heads:[1]NsmHeads;#assert nsm_head_put(heads[..],0,NMS_INBOX_PEER) && nsm_head_put(heads[..],1,NMS_INBOX_SELF);
 key:[32]u8;key[31]=1;fresh:[2]Nip59Fresh;fresh[0]=n59_fresh(1)[0];fresh[1]=n59_fresh(2)[0];out:[NSM_BYTES]u8;f:=NsFacts.{live=true,human=true,matched=true,approved=true,source=NS_LINKED,provider=NS_DEVICE};
 r:=nsm_seal(q[..],f,key[..],fresh[..],heads[..],1730000000,out[..]);#assert r.status==0 && r.cacheable && crypto_zeroed(key[..]) && fresh[0].wrap_key[31]==0 && fresh[1].wrap_key[31]==0;
 send:[1]NsmSend;#assert nsm_send_read(cast(string)out[0..<r.n],send[..]) && send[0].n==2 && send[0].heads_n==2;
 work:[NIP59_WORK]u8;rumor:[65536]u8;bob:=n59_bob();bob_pub:[32]u8;#assert ne_lower_hex(NMS_LIST_PUB,bob_pub[..]);opened:=nip17_open(bob[..],bob_pub[..],nsm_send_event(send[..],0),work[..],rumor[..]);#assert opened.error==N17_OK && opened.kind==14;first:=opened.rumor_id;
 key[31]=1;me:[32]u8;#assert ne_lower_hex(id,me[..]);opened=nip17_open(key[..],me[..],nsm_send_event(send[..],1),work[..],rumor[..]);#assert opened.error==N17_OK && n17_same(first[..],opened.rumor_id[..]);
 // Actual account journal staging binds every frozen inbox ID and commits
 // two complete originals and their exact targets in one revision.
 document:[1048576]u8;arena:[1048576]u8;recs:[512]RsdRec;state:[1]Nms;j:[1]Cj;scope:[32]u8;#assert nms_scope("send-fixture",id,scope[..]);opened_j:=cj_open_v2(j[..],document[..],0,me,scope);#assert opened_j.status==CJO_NEW;relay:=cj_relay(j[..],document[..],"wss://relay.openagents.com");none:[1][32]u8;
 originals:=[2]string.[NMS_INBOX_PEER,NMS_INBOX_SELF];for raw:originals {scratch:[65536]u8;e:=nostr_event_read(raw,scratch[..],false);#assert cj_deliver(j[..],document[..],0,relay,e.created_at,e.id,e.public_key,raw,none[0..<0])>=0;}
 #assert nms_mount(state[..],document[..],j[0].len,"send-fixture",id,0,false,arena[..],recs[..],1730000000)==0;before:=state[0].j[0].len;mf:=MsFacts.{authorized=true,matched=true};receipt:[2048]u8;
 saved:=send[0].heads[0][0];send[0].heads[0][0]=ifx saved=='0' then '1' else '0';failed:=nsm_stage(state[..],document[..],send[..],mf,NS_LINKED,false,1730000000,receipt[..]);#assert failed.status==9 && state[0].j[0].len==before;send[0].heads[0][0]=saved;
 staged:=nsm_stage(state[..],document[..],send[..],mf,NS_LINKED,false,1730000000,receipt[..]);manifest:[1]NsmSealed;#assert staged.status==0 && staged.changed && staged.revision==1 && nsm_sealed_read(cast(string)receipt[0..<staged.payload_n],manifest[..]) && manifest[0].n==2;
 #assert nms_mount(state[..],document[..],staged.length,"send-fixture",id,1,false,arena[..],recs[..],1730000000)==0 && state[0].j[0].pubs==2 && state[0].j[0].pub[0].pending==1 && state[0].j[0].pub[1].pending==1;
 recovered:[65536]u8;nr:=nms_original(state[..],document[..],cast(string)manifest[0].self[..],recovered[..]);#assert nr>0 && cast(string)recovered[0..<nr]==nsm_send_event(send[..],1);
 // A missing or wrong sender inbox refuses before any partial ciphertext.
 heads[0].lens[1]=0;fresh[0]=n59_fresh(3)[0];fresh[1]=n59_fresh(4)[0];r=nsm_seal(q[..],f,key[..],fresh[..],heads[..],1730000000,out[..]);#assert r.status==2 && crypto_zeroed(out[..]) && crypto_zeroed(key[..]);
}
