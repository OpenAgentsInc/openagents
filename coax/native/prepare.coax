// Assemble generated resources from their canonical shared sources. The only
// persistent config is the platform's property-list format.
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
tool_main :: () -> int #export_c #effects(all) {
  a:[1]Args; if !args_load(a[..]) { return 2; }
  names:=[13]string.["apps/openagents-desktop/extras/index.html","apps/openagents-desktop/home/host.js","coax/web/dom-host.js","coax/web/shell.js","components/zeron/fonts/Geist.ttf","components/zeron/fonts/Geist-Medium.ttf","components/zeron/fonts/Geist-SemiBold.ttf","components/zeron/fonts/GeistMono.ttf","apps/openagents-desktop/extras/host.js","coax/native/starter/viewport.js","coax/native/starter/runtime.js","coax/web/tree-commands.js","coax/web/tree-commands.js"];
  targets:=[13]string.["index.html","native.js","coaxial/dom-host.js","coaxial/shell.js","build/zeron/Geist.ttf","build/zeron/Geist-Medium.ttf","build/zeron/Geist-SemiBold.ttf","build/zeron/GeistMono.ttf","extras.js","viewport.js","runtime.js","tree-commands.js","coaxial/tree-commands.js"];
  data:[2097152]u8; path:[4096]u8;
  ok:=fs_mkdir("apps/openagents-desktop/build/Starter/coaxial");ok=fs_mkdir("apps/openagents-desktop/build/Starter/build/zeron");
  for i:0..<13 {n:=fs_read(names[i],data[..]);if n<0 || !fs_write(fs_join("apps/openagents-desktop/build/Starter",targets[i],path[..]),cast(string)data[0..<n]) {return 1;}}
  return 0;
}
