// Fingerprint the actual installed contract sources, not the updateable app.
#load "../lib/crypto/sha256-kernel.coax";
#load "../lib/json/json.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/tool.coax";
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args; if !args_load(a[..]) || args_count(a[..]) < 2 { return 2; }
  data: [2097152] u8; encoded: [16384] u8; hex: [64] u8; o:[1]Jo; jo_start(o[..],encoded[..]); jo_arr(o[..]);
  for i:1..<args_count(a[..]) {
    file:=args_at(a[..],i); n:=fs_read(file,data[..]); if n<0 { tool_errln(file); return 1; }
    if !S_hex(S_hash(cast(string)data[0..<n]),hex[..]) { return 1; }
    jo_arr(o[..]);jo_str(o[..],file);jo_str(o[..],cast(string)hex[..]);jo_end(o[..]);
  }
  jo_end(o[..]); if o[0].bad || !S_hex(S_hash(jo_text(o[..])),hex[..]) { return 1; }
  if !fs_write(args_at(a[..],0),cast(string)hex[..]) { return 1; } return 0;
}
