// Thin Apple shader SDK driver. Realm algorithms and shader entry points were
// generated by Coax on a build host; no world assets enter the native bundle.
#load "../../lib/json/json.coax";
#load "../../lib/sys/tool.coax";
#load "../../lib/sys/fs.coax";
#load "../../lib/sys/proc.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {tool_errln("apple iphonesimulator|iphoneos");return 2;}sdk:=args_at(a[..],0);if sdk!="iphoneos" && sdk!="iphonesimulator" {return 2;}
 root:="apps/openagents-ios/Generated/WorldShaders";if !fs_mkdir(root) {return 1;}
 out:[65536]u8;err:[65536]u8;
 for realm:[4]string.["splice-bots","everglade","everglade2","myrealm"] {
  paths:[5][4096]u8;src:=fs_join("apps/openagents-ios/Generated/Worlds",realm,paths[0][..]);from:=fs_join(src,"shaders",paths[1][..]);to:=fs_join(root,realm,paths[2][..]);if !fs_remove(to) || !fs_mkdir(to) {return 1;}
  list:[1]FsList;if fs_list(from,list[..])<0 {return 1;}
  for i:0..<list[0].n {name:=fs_entry(list[..],i);source:=fs_join(from,name,paths[3][..]);
   if name.count>6 && name[name.count-6..<name.count]==".metal" {
    output:[512]u8;o:[1]Jo;jo_start(o[..],output[..]);jo_put(o[..],name[0..<name.count-6]);jo_put(o[..],".metallib");dest:=fs_join(to,jo_text(o[..]),paths[4][..]);args:=[10]string.["xcrun","-sdk",sdk,"metal","-w","-fno-fast-math",source,"-o",dest,ifx sdk=="iphoneos" then "-mios-version-min=18.0" else "-mios-simulator-version-min=18.0"];
    r:=proc_run(args[..],120000,out[..],err[..]);if r.started!=0 || r.status!=0 || r.timed_out {tool_errln(cast(string)err[0..<r.err_n]);return 1;}
    if name=="bg.metal" {data:[1048576]u8;n:=fs_read(source,data[..]);if n<0 || !fs_write(fs_join(to,name,paths[4][..]),cast(string)data[0..<n]) {return 1;}}
   } else {data:[32768]u8;n:=fs_read(source,data[..]);if n<0 || !fs_write(fs_join(to,name,paths[4][..]),cast(string)data[0..<n]) {return 1;}}
  }
  dest:=fs_join(to,"page-host.metallib",paths[4][..]);glue:=[10]string.["xcrun","-sdk",sdk,"metal","-w","-fno-fast-math","metaverse-engine/host/apple/PageHost.metal","-o",dest,ifx sdk=="iphoneos" then "-mios-version-min=18.0" else "-mios-simulator-version-min=18.0"];
  r:=proc_run(glue[..],120000,out[..],err[..]);if r.started!=0 || r.status!=0 || r.timed_out {tool_errln(cast(string)err[0..<r.err_n]);return 1;}
 }
 return 0;
}
