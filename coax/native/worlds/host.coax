// The installed native world's codec and admission exports, generated as one unit.
#load "assets-wire.coax";
#load "policy.coax";
#load "profiles.coax";
#load "../../lib/sys/openagents-paths.coax";
#test "world chrome is one small floating menu with lifecycle actions" {
 c:=nwh_chrome(false,false,false);
 #assert c.side==44 && c.icon==18 && c.inset==8 && c.menu=="World menu" && c.leave=="Close world";
 #assert !c.show_editor && !c.show_retry;
 #assert nwh_chrome(true,true,false).show_editor && !nwh_chrome(true,true,false).show_retry;
 #assert !nwh_chrome(true,false,false).show_editor;
 #assert nwh_chrome(false,false,true).show_retry && !nwh_chrome(false,true,true).show_editor;
 #assert !nwh_chrome(true,true,true).show_retry;
}
// Coax owns the native world's small chrome recipe. UIKit projects the menu
// and performs navigation/editor lifecycle effects; this is no editing grant.
NwhChrome :: struct {menu:string;leave:string;editor:string;retry:string;side:f32;icon:f32;inset:f32;show_editor:bool;show_retry:bool;}
nwh_chrome :: (ready:bool,editable:bool,failed:bool)->NwhChrome #export_c #effects(all) {
 return NwhChrome.{menu="World menu",leave="Close world",editor="World editor",retry="Retry loading",side=44,icon=18,inset=8,show_editor=ready && editable,show_retry=failed && !ready};
}
#test "the native SDK uses the shared OpenAgents path in its platform-writable home" {
 b:[512]u8;n:=nwh_path("/container/Library/Application Support","worlds",b[..]);
 #assert n>0 && cast(string)b[0..<n]=="/container/Library/Application Support/.openagents/worlds";
}
nwh_path :: (home:string,leaf:string,out:[]u8)->int #export_c #effects(all) {
 return oa_path(home,leaf,out).count;
}

NwhModelAction :: struct {title:string;symbol:string;key:int;url:string;}
#test "model viewer menu is the shared camera controls and a labelled license" {
 #assert nwh_model_action(0).key==49 && nwh_model_action(1).key==50 && nwh_model_action(2).key==51 && nwh_model_action(3).key==110 && nwh_model_action(4).key==114;
 #assert nwh_model_action(5).title=="License" && nwh_model_action(5).url=="https://creativecommons.org/licenses/by-nc-sa/4.0/" && nwh_model_action(-1).title=="" && nwh_model_action(6).title=="Close" && nwh_model_action(7).title=="";
}
nwh_model_action :: (index:int)->NwhModelAction #export_c #effects(all) {
 if index==0 {return NwhModelAction.{title="Front",symbol="viewfinder",key=49};}
 if index==1 {return NwhModelAction.{title="Side",symbol="cube",key=50};}
 if index==2 {return NwhModelAction.{title="Top",symbol="square.stack.3d.up",key=51};}
 if index==3 {return NwhModelAction.{title="Normals",symbol="circle.lefthalf.filled",key=110};}
 if index==4 {return NwhModelAction.{title="Reset",symbol="arrow.counterclockwise",key=114};}
 if index==5 {return NwhModelAction.{title="License",symbol="info.circle",url="https://creativecommons.org/licenses/by-nc-sa/4.0/"};}
 if index==6 {return NwhModelAction.{title="Close",symbol="xmark"};}
 return NwhModelAction.{};
}

#test "shared loading text stays concise across worlds and model viewers" {#assert nwh_loading(0)=="Loading…" && nwh_loading(1)=="Downloading…" && nwh_loading(2)=="Opening…";}
nwh_loading :: (stage:int)->string #export_c #effects(all) {return ifx stage==1 then "Downloading…" else ifx stage==2 then "Opening…" else "Loading…";}
