// Compile times of the biggest apps against coax/perf/baseline.json.
// Runs `coax check APP --timings-json FILE` for each app the baseline names,
// with an empty library-check cache ($COAX_CHECK_CACHE) so every run does the
// same work, and prints each phase's time beside the baseline's. A phase that
// grew by more than a quarter and at least half a second is a regression;
// any regression makes the exit status 1.
//   coax/web/tool.sh coax/perf/compile-times.coax                 (from the repo root)
//   coax/web/tool.sh coax/perf/compile-times.coax --app apps/openagents-cli/main.coax
//   coax/web/tool.sh coax/perf/compile-times.coax --write         (record a new baseline)
//   --coax PATH   the compiler to time (default coax/bin/coax)
//   --warm        keep the user's check cache (default: an empty one)
//   --no-edit     skip the warm edit: after Everglade's run, CT_EDIT_FILE edited,
//                 Everglade checked again with that cache, the file put back (#12647)
//   --note TEXT   with --write: a note kept in the baseline (say how busy the machine was)
// Wall times depend on the machine and its load: compare runs on the
// machine the baseline names, and rerun a phase that looks slower.
#import "Basic";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/proc.coax";
#load "../lib/json/json.coax";

CT_BASELINE :: "coax/perf/baseline.json";
CT_APP_MAX :: 8;
CT_APPS :: [4] string.["apps/openagents-web/everglade.coax", "apps/openagents-web/newland.coax", "apps/openagents-web/myrealm.coax", "apps/openagents-cli/main.coax"];
// The phases in pipeline order, the parts of check after it (indented in the
// table), and total. Names match the --timings report's seconds and detail_seconds.
CT_N :: 17;
CT_PHASES :: [CT_N] string.["load", "lex", "imports", "libraries", "parse", "check", "check.storage", "check.checker", "check.mutation_lowering", "check.effects", "check.transfer", "evaluate", "authority", "emit", "native_compile", "link", "total"];
CT_REPORT :: 8388608;
CT_NODES :: 65536;
// A regression: more than a quarter slower and at least this many milliseconds.
CT_FLOOR_MS :: 500;

// The warm edit (#12647): after Everglade's run fills the cache, this one
// small edit to a realm file, checked again with that cache. The file is put
// back straight after.
CT_EDIT_APP :: "apps/openagents-web/everglade.coax";
CT_EDIT_FILE :: "verse/everglade/folk.coax";
CT_EDIT_FROM :: "FOLK_LOOK :: 7.0;";
CT_EDIT_TO :: "FOLK_LOOK :: 7.5;";
CT_EDIT_NAME :: "verse/everglade/folk.coax: FOLK_LOOK :: 7.0 -> 7.5, checked with the cache the cold run filled";
CT_EDIT_MAX :: 1048576;

// One app's times in milliseconds (-1: the phase did not run), and how many
// #authority checks were reused one at a time and run (-1: not reported).
CtTimes :: struct { ms: [CT_N] int; exit_status: int = -1; ok: bool; reused: int = -1; run: int = -1; }

#test "an edit replaces the one place its text is, and nothing else" {
  out: [64] u8;
  #assert ct_edit("a :: 1;\nb :: 2;\n", "a :: 1;", "a :: 3;", out[..]) == "a :: 3;\nb :: 2;\n";
  #assert ct_edit("a :: 1;", "c :: 1;", "x", out[..]) == "";
  #assert ct_edit("a a", "a", "b", out[..]) == "";
  #assert ct_edit("aaaa", "a", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", out[..]) == "";
}
// text with its one occurrence of from replaced by to, in out; "" when from
// is not in text exactly once, or the result doesn't fit.
ct_edit :: (text: string, from: string, to: string, out: [] u8) -> string {
  at := -1; seen := 0;
  for i: 0..<text.count - from.count + 1 {
    if text[i..<i + from.count] == from { if seen == 0 { at = i; } seen += 1; }
  }
  if seen != 1 || text.count - from.count + to.count > out.count { return ""; }
  n := 0;
  for c: text[0..<at] { out[n] = c; n += 1; }
  for c: to { out[n] = c; n += 1; }
  for c: text[at + from.count..<text.count] { out[n] = c; n += 1; }
  return cast(string) out[0..<n];
}

#test "seconds to whole milliseconds" {
  #assert ct_ms("0.43260429099999997") == 433 && ct_ms("4.1999999999999999e-08") == 0 && ct_ms("712.5") == 712500 && ct_ms("x") == -1 && ct_ms("") == -1;
}
// A JSON number of seconds as whole milliseconds, or -1.
ct_ms :: (raw: string) -> int {
  if raw.count == 0 { return -1; }
  n := args_number(raw);
  // Under a microsecond the report writes an exponent args_number refuses (4.2e-08).
  if !n.ok { for i: 0..<raw.count - 1 { if raw[i] == 'e' && raw[i + 1] == '-' && raw[0] != '-' { return 0; } } }
  if !n.ok || n.value < 0.0 { return -1; }
  return cast(int) (n.value * 1000.0 + 0.5);
}
#test "a regression is a quarter slower and at least the floor" {
  #assert ct_regressed(10000, 13000) && !ct_regressed(10000, 12000) && !ct_regressed(400, 800) && ct_regressed(400, 1000);
  #assert !ct_regressed(-1, 5000) && !ct_regressed(5000, -1) && !ct_regressed(5000, 1000);
}
ct_regressed :: (base: int, now: int) -> bool {
  if base < 0 || now < 0 { return false; }
  return now - base >= CT_FLOOR_MS && now * 4 > base * 5;
}
#test "read a timing report" {
  nodes: [64] JvNode; d: [1] Jv;
  t := "{\"exit_status\":0,\"seconds\":{\"load\":0.0471,\"check\":2.5,\"total\":3.25},\"detail_seconds\":{\"check.checker\":2.4}}";
  #assert jv_parse(d[..], t, nodes[..]);
  r := ct_read_report(d[0], 0);
  #assert r.ok && r.exit_status == 0 && r.ms[0] == 47 && r.ms[1] == -1 && r.ms[5] == 2500 && r.ms[7] == 2400 && r.ms[CT_N - 1] == 3250;
  #assert r.reused == -1 && r.run == -1;
}
#test "read the checks a report reused and ran, from a report or a baseline entry" {
  nodes: [64] JvNode; d: [1] Jv;
  t := "{\"exit_status\":0,\"check_reuse\":{\"reused\":271,\"run\":31},\"seconds\":{\"total\":3.25}}";
  #assert jv_parse(d[..], t, nodes[..]);
  r := ct_read_report(d[0], 0);
  #assert r.ok && r.reused == 271 && r.run == 31;
  e: [1] Jv;
  u := "{\"exit_status\":0,\"checks_reused\":5,\"checks_run\":2,\"ms\":{\"total\":3}}";
  #assert jv_parse(e[..], u, nodes[..]);
  b := ct_read_report(e[0], 0);
  #assert b.ok && b.reused == 5 && b.run == 2 && b.ms[CT_N - 1] == 3;
}
// Times from a --timings report (seconds and detail_seconds) or a baseline
// entry (ms) at node at.
ct_read_report :: (d: Jv, at: int) -> CtTimes {
  r: CtTimes;
  for i: 0..<CT_N { r.ms[i] = -1; }
  r.exit_status = jv_int(d, jv_get(d, at, "exit_status"), -1);
  reuse := jv_get(d, at, "check_reuse");
  if reuse >= 0 { r.reused = jv_int(d, jv_get(d, reuse, "reused"), -1); r.run = jv_int(d, jv_get(d, reuse, "run"), -1); }
  else { r.reused = jv_int(d, jv_get(d, at, "checks_reused"), -1); r.run = jv_int(d, jv_get(d, at, "checks_run"), -1); }
  ms := jv_get(d, at, "ms");
  if ms >= 0 {
    for p, i: CT_PHASES { r.ms[i] = jv_int(d, jv_get(d, ms, p), -1); }
    r.ok = true; return r;
  }
  secs := jv_get(d, at, "seconds"); detail := jv_get(d, at, "detail_seconds");
  if secs < 0 { return r; }
  for p, i: CT_PHASES {
    v := jv_get(d, secs, p);
    if v < 0 { v = jv_get(d, detail, p); }
    if v >= 0 { r.ms[i] = ct_ms(jv_raw(d, v)); }
  }
  r.ok = true;
  return r;
}
ct_indent :: (phase: string) -> bool { return phase.count > 6 && phase[0..<6] == "check."; }

// Runs coax check on app with --timings-json into dir/report.json and a
// library-check cache in dir/cache (unless warm). Its times, ok false when
// the compiler could not run or wrote no report.
ct_measure :: (coax: string, app: string, dir: string, warm: bool) -> CtTimes {
  r: CtTimes;
  pb: [4096] u8; report := fs_join(dir, "report.json", pb[..]);
  cb: [4096] u8; cache := fs_join(dir, "cache", cb[..]);
  eb: [4200] u8; en := 0;
  for c: "COAX_CHECK_CACHE=" { eb[en] = c; en += 1; }
  for c: cache { eb[en] = c; en += 1; }
  h := proc_new();
  if h < 0 { return r; }
  ok := proc_arg(h, coax) && proc_arg(h, "check") && proc_arg(h, app) && proc_arg(h, "--timings-json") && proc_arg(h, report);
  if !warm { ok = ok && proc_env(h, cast(string) eb[0..<en]); }
  if !ok || proc_start(h) != 0 { done := proc_release(h); return r; }
  line: [65536] u8;
  while true {
    n := proc_line(h, -1, line[..]);
    if n == PROC_EOF || n == PROC_ERROR || n == PROC_TIMEOUT { break; }
  }
  status := proc_wait(h, -1);
  done := proc_release(h);
  text: [CT_REPORT] u8;
  k := fs_read(report, text[..]);
  if k < 0 { return r; }
  nodes: [CT_NODES] JvNode; d: [1] Jv;
  if !jv_parse(d[..], cast(string) text[0..<k], nodes[..]) { return r; }
  r = ct_read_report(d[0], 0);
  if r.exit_status < 0 { r.exit_status = status; }
  return r;
}

ct_seconds :: (ms: int, out: [] u8) -> string {
  if ms < 0 { return "-"; }
  n := 0; whole := ms / 1000; frac := ms % 1000;
  digits: [24] u8; k := 0;
  while true { digits[k] = cast(u8) ('0' + whole % 10); k += 1; whole /= 10; if whole == 0 { break; } }
  for i: 0..<k { out[n] = digits[k - 1 - i]; n += 1; }
  out[n] = '.'; n += 1;
  out[n] = cast(u8) ('0' + frac / 100); out[n + 1] = cast(u8) ('0' + frac / 10 % 10); out[n + 2] = cast(u8) ('0' + frac % 10); n += 3;
  return cast(string) out[0..<n];
}
ct_pad :: (n: int) { for j: 0..<n { print(" "); } }
// Prints one app's table and returns how many phases regressed.
ct_compare :: (app: string, base: CtTimes, now: CtTimes) -> int {
  bad := 0;
  print("% (exit ", app); print("%, baseline exit ", now.exit_status); print("%)\n", base.exit_status);
  print("  phase"); ct_pad(21); print("   baseline s       now s\n");
  for p, i: CT_PHASES {
    if base.ms[i] < 0 && now.ms[i] < 0 { continue; }
    b: [32] u8; c: [32] u8;
    indent := ifx ct_indent(p) then 4 else 2;
    ct_pad(indent); print("%", p); ct_pad(28 - indent - p.count);
    bs := ct_seconds(base.ms[i], b[..]); ns := ct_seconds(now.ms[i], c[..]);
    ct_pad(12 - bs.count); print("%", bs); ct_pad(12 - ns.count); print("%", ns);
    if ct_regressed(base.ms[i], now.ms[i]) { print("  SLOWER"); bad += 1; }
    print("\n");
  }
  if now.reused > 0 || base.reused > 0 { print("  checks reused, run: baseline %, ", base.reused); print("%; ", base.run); print("now %, ", now.reused); print("%\n", now.run); }
  return bad;
}

// A baseline entry for app (its warm-edit row when edit), or ok false.
ct_baseline_for :: (d: Jv, app: string, edit: bool) -> CtTimes {
  none: CtTimes;
  apps := jv_get(d, 0, "apps");
  for i: 0..<jv_len(d, apps) {
    e := jv_at(d, apps, i);
    pb: [4096] u8; n := jv_str(d, jv_get(d, e, "path"), pb[..]);
    if n >= 0 && cast(string) pb[0..<n] == app && (jv_get(d, e, "warm_edit") >= 0) == edit { return ct_read_report(d, e); }
  }
  return none;
}

// Measures the warm edit in work, whose cache the cold run of CT_EDIT_APP
// filled: edits CT_EDIT_FILE, checks the app again, and puts the file back.
ct_warm_edit :: (coax: string, work: string) -> CtTimes {
  none: CtTimes;
  was: [CT_EDIT_MAX] u8;
  n := fs_read(CT_EDIT_FILE, was[..]);
  if n < 0 || n == CT_EDIT_MAX { print("% : cannot read it for the warm edit\n", CT_EDIT_FILE); return none; }
  old := cast(string) was[0..<n];
  eb: [CT_EDIT_MAX] u8;
  edited := ct_edit(old, CT_EDIT_FROM, CT_EDIT_TO, eb[..]);
  if edited.count == 0 { print("% : '%' is not in it exactly once\n", CT_EDIT_FILE, CT_EDIT_FROM); return none; }
  if !fs_write(CT_EDIT_FILE, edited) { print("% : cannot write the warm edit\n", CT_EDIT_FILE); return none; }
  r := ct_measure(coax, CT_EDIT_APP, work, false);
  if !fs_write(CT_EDIT_FILE, old) { print("% : COULD NOT PUT IT BACK; restore it with git checkout\n", CT_EDIT_FILE); r.ok = false; }
  return r;
}

ct_line :: (argv: [] string, out: [] u8) -> string {
  err: [4096] u8;
  r := proc_run(argv, 10000, out, err[..]);
  if r.started != 0 || r.status != 0 { return ""; }
  return cast(string) out[0..<r.out_n];
}

ct_write :: (apps: [] string, times: [] CtTimes, edits: [] bool, count: int, compiler: string, note: string) -> bool {
  buf: [65536] u8; o: [1] Jo;
  jo_start(o[..], buf[..]);
  cb: [256] u8; mb: [256] u8; db: [64] u8;
  argv_commit := [4] string.["git", "rev-parse", "--short=10", "HEAD"];
  argv_cpu := [3] string.["sysctl", "-n", "machdep.cpu.brand_string"];
  argv_date := [2] string.["date", "+%Y-%m-%d"];
  argv_load := [3] string.["sysctl", "-n", "vm.loadavg"]; lb: [256] u8;
  jo_obj(o[..]);
  jo_key(o[..], "schema_version"); jo_int(o[..], 1);
  jo_key(o[..], "how"); jo_str(o[..], "coax/web/tool.sh coax/perf/compile-times.coax --write: coax check APP --timings-json with an empty check cache; a warm_edit row: the same check after that edit, with the cache the cold run filled; whole milliseconds");
  jo_key(o[..], "compiler"); jo_str(o[..], compiler);
  jo_key(o[..], "commit"); jo_str(o[..], ct_line(argv_commit[..], cb[..]));
  jo_key(o[..], "machine"); jo_str(o[..], ct_line(argv_cpu[..], mb[..]));
  jo_key(o[..], "date"); jo_str(o[..], ct_line(argv_date[..], db[..]));
  jo_key(o[..], "load_average_after"); jo_str(o[..], ct_line(argv_load[..], lb[..]));
  if note.count > 0 { jo_key(o[..], "note"); jo_str(o[..], note); }
  jo_key(o[..], "apps"); jo_arr(o[..]);
  for i: 0..<count {
    jo_obj(o[..]);
    jo_key(o[..], "path"); jo_str(o[..], apps[i]);
    if edits[i] { jo_key(o[..], "warm_edit"); jo_str(o[..], CT_EDIT_NAME); }
    jo_key(o[..], "exit_status"); jo_int(o[..], times[i].exit_status);
    if times[i].reused >= 0 { jo_key(o[..], "checks_reused"); jo_int(o[..], times[i].reused); jo_key(o[..], "checks_run"); jo_int(o[..], times[i].run); }
    jo_key(o[..], "ms"); jo_obj(o[..]);
    for p, k: CT_PHASES { if times[i].ms[k] >= 0 { jo_key(o[..], p); jo_int(o[..], times[i].ms[k]); } }
    jo_end(o[..]);
    jo_end(o[..]);
  }
  jo_end(o[..]);
  jo_end(o[..]);
  if o[0].bad { return false; }
  return fs_write(CT_BASELINE, jo_text(o[..])) && fs_append(CT_BASELINE, "\n");
}

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("compile-times: arguments too long"); return 2; }
  coax := args_value(a[..], "--coax", "coax/bin/coax");
  write := args_has(a[..], "--write"); warm := args_has(a[..], "--warm");
  apps: [CT_APP_MAX] string; count := 0;
  for i: 0..<args_count(a[..]) {
    if args_at(a[..], i) == "--app" && i + 1 < args_count(a[..]) && count < CT_APP_MAX { apps[count] = args_at(a[..], i + 1); count += 1; }
  }
  if count == 0 { for p: CT_APPS { apps[count] = p; count += 1; } }
  base_text: [1048576] u8;
  bn := fs_read(CT_BASELINE, base_text[..]);
  if bn < 0 && !write { tool_errln("compile-times: no coax/perf/baseline.json here (run from the repo root, or record one with --write)"); return 2; }
  nodes: [8192] JvNode; d: [1] Jv;
  have_base := bn >= 0 && jv_parse(d[..], cast(string) base_text[0..<ifx bn < 0 then 0 else bn], nodes[..]);
  if bn >= 0 && !have_base { tool_errln("compile-times: coax/perf/baseline.json is not JSON"); return 2; }
  tb: [4096] u8;
  dir := fs_temp("coax-compile-times-", tb[..]);
  if dir.count == 0 { tool_errln("compile-times: cannot make a temporary directory"); return 2; }
  // Each app's row, and after the cold Everglade run (unless --warm or
  // --no-edit) its warm-edit row.
  rows: [CT_APP_MAX + 1] string; times: [CT_APP_MAX + 1] CtTimes; edits: [CT_APP_MAX + 1] bool;
  rn := 0;
  compiler := "";
  bad := 0; failed := 0;
  for i: 0..<count {
    sub: [4096] u8; nb: [16] u8; nb[0] = cast(u8) ('0' + i);
    work := fs_join(dir, cast(string) nb[0..<1], sub[..]);
    if !fs_mkdir(work) { tool_errln("compile-times: cannot make a temporary directory"); failed += 1; continue; }
    for pass: 0..<2 {
      edit := pass == 1;
      if edit && (warm || args_has(a[..], "--no-edit") || apps[i] != CT_EDIT_APP) { break; }
      t := ifx edit then ct_warm_edit(coax, work) else ct_measure(coax, apps[i], work, warm);
      if !t.ok { print("% : the compiler wrote no timing report (is % built?)\n", apps[i], coax); failed += 1; break; }
      rows[rn] = apps[i]; times[rn] = t; edits[rn] = edit; rn += 1;
      base: CtTimes;
      if have_base { base = ct_baseline_for(d[0], apps[i], edit); }
      if !base.ok { for k: 0..<CT_N { base.ms[k] = -1; } }
      if edit { print("warm edit: %\n", CT_EDIT_NAME); }
      bad += ct_compare(apps[i], base, t);
      if !base.ok && !write { print("  (no baseline for this row)\n"); }
    }
    cleaned := fs_remove(work);
  }
  removed := fs_remove(dir);
  if write {
    // The compiler's version, from its own report.
    vb: [256] u8;
    argv_version := [2] string.[coax, "version"];
    compiler = ct_line(argv_version[..], vb[..]);
    if failed > 0 { tool_errln("compile-times: not writing a baseline: an app's run failed"); return 1; }
    if !ct_write(rows[..], times[..], edits[..], rn, compiler, args_value(a[..], "--note", "")) { tool_errln("compile-times: cannot write coax/perf/baseline.json"); return 2; }
    print("compile-times: wrote % with % row(s)\n", CT_BASELINE, rn);
    return 0;
  }
  print("compile-times: % app(s), % phase(s) slower than the baseline, % run(s) failed\n", count, bad, failed);
  return ifx bad == 0 && failed == 0 then 0 else 1;
}
