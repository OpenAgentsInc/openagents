// The Coax relay, R1 (relay-server-r1, coax/nostr.md section 17): a ws://
// Nostr relay for 127.0.0.1 or a tailnet address. relay-host.c parses the
// flags, allocates the store's arrays at the size ry_store_events,
// ry_store_arena and ry_store_tags give, and runs ry_main on a large stack;
// socket-server-native.c moves bytes.
// The chain: socket -> ws_server.coax (RFC 6455 server half) ->
// message_server.coax (NIP-01 frames) -> relay_server.coax (admission,
// REQ rules, subscriptions, NIP-11, NIP-40, replacement) -> the store.
//
// STORE: the verified store (coax/lib/nostr/store_saved.coax, #8eb5), with
// chapter 36's indexes beside it (relay_store.coax): REQ reads one index per
// filter instead of scanning every record. NIP-09 and NIP-62 (chapter 39,
// store_delete.coax): a stored kind 5 or kind 62 (naming this relay's URL,
// the one NIP-42 answers name, or ALL_RELAYS) retires what it covers, and a
// covered event is refused "blocked:"; a restart rebuilds the tombstones
// from the requests in the --store file. With
// --store FILE every stored original is appended to FILE and synced before
// it is stored, and a restart replays FILE, verifying every event again
// (event_verify_fast.coax's ne_signed_fast over admission's read, as a live
// EVENT is checked; 50,000 events in about 20 s at build.sh's -O2).
// Without --store the store is in memory only. --store-capacity EVENTS
// sizes the store (relay_route.coax's rr_capacity: 2,048 records and 4 MiB
// without it, chapter 35's size; 128 to 1,048,576 records at 2 KiB each);
// a --store file larger than the store refuses to start, unchanged. A crash's partial last write
// is cut on restart; other damage to FILE stops the relay before it listens
// (store_recover.coax, #966b). Not trusted freshness: an older copy of FILE
// replays as an older store. TLS: with --tls-cert and
// --tls-key the host makes every connection TLS (tls-native.c's server mode,
// under socket-server-native.c), so this file reads and writes the same
// plaintext bytes; only the default relay URL's scheme (wss://) and the
// check that --url agrees with it change here.
//
// Rate limits (chapter 44, relay_rate.coax): EVENTs and REQs per connection
// a minute, and EVENTs per key a minute across connections (--rate, else
// the Rust relay's 120, 120 and 60). An EVENT is charged once its signature
// holds; a refusal is OK false "rate-limited: ...", a REQ's CLOSED. The
// served NIP-11 document carries the same three limits (rt_nip11).
//
// NIP-70 (chapter 42, nip70.coax): an event with the "-" tag is accepted
// only on a connection authenticated as its author (checked after the
// signature and the rate limit); a repost embedding one is refused.
//
// NIP-13 (chapter 56, nip13.coax): with --pow BITS (default 0, off) an
// EVENT needs that many leading zero bits in its id and a nonce tag
// committing to at least as many, checked before the signature; the NIP-11
// document then says min_pow_difficulty.
//
// NIP-50 (chapter 41, nip50.coax through relay_store.coax): a REQ filter
// may carry "search" (rd_req); it is answered best match first by n50_scan
// over the store, and a live event reaches a search subscription only when
// its content holds every term (rd_sub_matches). Ciphertext kinds (4, 1059,
// 21059) never match a search.
//
// NIP-77 (chapter 43, nip77.coax): NEG-OPEN, NEG-MSG and NEG-CLOSE. Each
// connection holds up to RR_NEG_SESSIONS syncs (relay_route.coax's rr_neg_*,
// which also states the limits); each message is answered by neg_reconcile
// over the store's items matching the session's filter at that moment
// (rd_neg_items), with RR_NEG_FRAME as the relay's frame limit. Over
// RR_NEG_MAX items, too many syncs, a client message over RR_NEG_IN bytes or
// RR_NEG_IDLE_S seconds without a message: NEG-ERR, and the session is gone.
//
// Routing (which reply goes to which connection and subscription) is
// relay_route.coax's (#authority); this file moves bytes and calls it.
// NIP-42: every WebSocket gets a challenge after the 101 (nip42_issue, 32
// host-random bytes as hex, bound to the connection's generation); AUTH is
// checked by nip42_admit against the relay URL (--url, or ws://ADDRESS:PORT)
// and its admitted keys are kept per connection; EVENT needs one
// (relay_route.coax states the policy). Names here are ry_ because
// nip42.coax loads the client relay.coax, whose names are rl_.
#import "Basic";
#load "../lib/nostr/relay_store.coax";
#load "../lib/nostr/nip42-event.coax";
#load "../lib/nostr/relay_route.coax";
#load "../lib/nostr/relay_rate.coax";
#load "../lib/nostr/nip70.coax";
#load "../lib/nostr/nip13.coax";
// message_server.coax's frames agree with message.coax's (#6015).
#load "../lib/nostr/message_agree.coax";

// relay_route.coax's mirrored codes are its sources' codes.
#assert RR_MS_OK == MS_OK && RR_MS_VERB == MS_VERB && RR_MS_SUB == MS_SUB && RR_MS_TOO_MANY == MS_TOO_MANY;
#assert RR_MS_EVENT == MS_EVENT && RR_MS_REQ == MS_REQ && RR_MS_CLOSE == MS_CLOSE && RR_MS_AUTH == MS_AUTH && RR_MS_COUNT == MS_COUNT;
#assert RR_RS_ACCEPT == RS_ACCEPT && RR_RS_BAD_EVENT == RS_BAD_EVENT && RR_RS_BAD_ID == RS_BAD_ID && RR_RS_SUBID == RS_SUBID;
#assert RR_RS_FILTER == RS_FILTER && RR_RS_FILTERS == RS_FILTERS && RR_RS_FRAME == RS_FRAME && RR_RS_VERB == RS_VERB && RR_RS_BINARY == RS_BINARY && RR_RS_COUNT == RS_COUNT;
#assert RR_WSS_OK == WSS_OK && RR_WSS_MORE == WSS_MORE && RR_WSS_NIP11 == WSS_NIP11;
#assert RR_WS_FRAME_OK == WS_FRAME_OK && RR_WS_FRAME_MORE == WS_FRAME_MORE && RR_WS_FRAME_TOO_BIG == WS_FRAME_TOO_BIG && RR_WS_OP_TEXT == WS_OP_TEXT;
#assert RR_WS_EV_PART == WS_EV_PART && RR_WS_EV_MESSAGE == WS_EV_MESSAGE && RR_WS_EV_PING == WS_EV_PING && RR_WS_EV_PONG == WS_EV_PONG && RR_WS_EV_CLOSE == WS_EV_CLOSE;
#assert RR_WS_CLOSE_NORMAL == WS_CLOSE_NORMAL && RR_WS_CLOSE_PROTOCOL == WS_CLOSE_PROTOCOL && RR_WS_CLOSE_TOO_BIG == WS_CLOSE_TOO_BIG;
#assert RR_N42_OK == N42_OK && RR_N42_STALE == N42_STALE && RR_N42_NO_CHALLENGE == N42_NO_CHALLENGE && RR_N42_EVENT == N42_EVENT;
#assert RR_N42_KIND == N42_KIND && RR_N42_TIME == N42_TIME && RR_N42_TAGS == N42_TAGS && RR_N42_RELAY == N42_RELAY && RR_N42_CHALLENGE == N42_CHALLENGE;
#assert RR_NSD_DELETED == NSD_DELETED && RR_NSD_NO_ROOM == NSD_NO_ROOM;
#assert RR_N77_OK == N77_OK && RR_N77_VERB == N77_VERB && RR_N77_SUB == N77_SUB && RR_N77_FRAME == N77_FRAME;
#assert RR_N77_OPEN == N77_OPEN && RR_N77_MSG == N77_MSG && RR_N77_CLOSE == N77_CLOSE && RR_N77_ERR == N77_ERR;
#assert RR_NEG_FRAME >= NEG_FRAME_MIN && 2 * (RR_NEG_FRAME + RY_NEG_SLACK) + 2 * 256 + 32 <= RY_OUT - 14;
#assert RR_NEG_IN * 2 == JSON_MAX_STRING && RR_NEG_FRAME * 2 <= JSON_MAX_STRING;
#assert RY_SENT <= 2032;

cxsrv_listen :: (port: int) -> int #foreign;
cxsrv_bound_port :: () -> int #foreign;
cxsrv_poll :: (timeout_ms: int) -> int #foreign;
cxsrv_accept :: () -> int #foreign;
cxsrv_read :: (h: int) -> int #foreign;
cxsrv_byte :: (h: int, i: int) -> int #foreign;
cxsrv_write :: (h: int, byte: int) -> int #foreign;
cxsrv_flush :: (h: int, timeout_ms: int) -> int #foreign;
cxsrv_close :: (h: int) -> int #foreign;
cxsrv_now_s :: () -> int #foreign;
ry_host_port :: () -> int #foreign;
ry_host_url_count :: () -> int #foreign;
ry_host_url_byte :: (i: int) -> int #foreign;
ry_host_address_count :: () -> int #foreign;
ry_host_address_byte :: (i: int) -> int #foreign;
ry_host_random :: () -> int #foreign;
ry_host_store :: () -> int #foreign;
ry_host_tls :: () -> int #foreign;
ry_host_rate :: (i: int) -> int #foreign;
ry_host_pow :: () -> int #foreign;

// RY_IN holds one partial frame (at most RS_MAX_MESSAGE + 14 bytes) plus one
// transport read (socket-server-native.h's CXSRV_MAX_IN, 65536), so a client
// that pipelines a full-size frame and the next one is never cut off.
RY_CONNS :: 16; RY_IN :: RS_MAX_MESSAGE + 14 + 65536; RY_OUT :: 140000; RY_IO_MS :: 2000;
RY_SENT :: 2032;   // 16 filters x 127 events
// Room past the frame limit for the one range neg_reconcile writes before it
// cuts (16 fingerprints with their bounds, or an IdList of 31 ids).
RY_NEG_SLACK :: 4096;

RyConn :: struct {
  h: int = -1; ws: bool; gen: int;
  since: int;   // accepted, or the last complete frame taken (rr_deadline)
  n42: [1] Nip42; auth: [1] RrAuth;
  rt: [1] RtConn;                 // this connection's EVENT and REQ windows
  inb: [RY_IN] u8; used: int;
  rd: [1] WsReader;
  msg: [RS_MAX_MESSAGE] u8;
  subs: [RS_MAX_SUBS] RsSub;
  neg: [RR_NEG_SESSIONS] RrNeg;   // NIP-77 syncs
}
RyWork :: struct {
  frame: [RS_MAX_MESSAGE] u8;     // one unmasked frame payload
  out: [RY_OUT] u8;               // one outgoing frame
  body: [RY_OUT] u8;              // one outgoing message
  scratch: [262144] u8;           // the event id preimage
  count: [1] N45Work;             // one COUNT's filters and marks
  search: [1] RdSearch;           // one search's terms, scores and decoded content
  sent: [RY_SENT] int;
  n42: [1] Nip42;                 // the relay URL, copied into each connection
  gen: int;                       // the last connection generation
  rate: RtConfig;                 // --rate, or relay_rate.coax's defaults
  pow: int;                       // --pow: the NIP-13 difficulty an EVENT needs, 0 off
  keys: [1] RtKeys;               // the per-key EVENT windows
  nip11: [4096] u8; nip11_n: int; // RR_NIP11 with the rate limits (rt_nip11)
  neg_items: [RR_NEG_MAX] NegItem; // one sync's items (rd_neg_items)
  neg_in: [RR_NEG_IN] u8;          // one NEG-OPEN or NEG-MSG message, decoded
  neg_out: [RR_NEG_FRAME + RY_NEG_SLACK] u8;  // the relay's answer
}

ry_send_raw :: (c: [] RyConn, bytes: string) -> bool {
  for b: bytes { if cxsrv_write(c[0].h, cast(int) b) != 0 { return false; } }
  return cxsrv_flush(c[0].h, RY_IO_MS) == 0;
}
ry_send :: (c: [] RyConn, w: [] RyWork, op: int, payload: string) -> bool {
  n := wss_frame_write(op, payload, w[0].out[..]);
  return n > 0 && ry_send_raw(c, cast(string) w[0].out[0..<n]);
}
ry_text :: (c: [] RyConn, w: [] RyWork, n: int) -> bool {
  if n < 0 { return false; }
  return ry_send(c, w, WS_OP_TEXT, cast(string) w[0].body[0..<n]);
}
ry_shut :: (c: [] RyConn) {
  if c[0].h >= 0 { r := cxsrv_close(c[0].h); }
  c[0].h = -1; c[0].ws = false; c[0].used = 0; c[0].rd[0] = WsReader.{};
  rr_auth_reset(c[0].auth[..]); c[0].rt[0] = RtConn.{}; rr_neg_reset(c[0].neg[..]);
  for i: 0..<RS_MAX_SUBS { c[0].subs[i].live = false; }
}
ry_close :: (c: [] RyConn, w: [] RyWork, code: int) {
  n := wss_close_write(code, w[0].out[..]);
  if n > 0 { ok := ry_send_raw(c, cast(string) w[0].out[0..<n]); }
  ry_shut(c);
}
ry_notice :: (c: [] RyConn, w: [] RyWork, reason: int) -> bool {
  return ry_text(c, w, ms_write_notice(rs_prefix(reason), rs_text(reason), w[0].body[..]));
}
ry_closed :: (c: [] RyConn, w: [] RyWork, sub: string, reason: int) -> bool {
  return ry_text(c, w, ms_write_closed(sub, rs_prefix(reason), rs_text(reason), w[0].body[..]));
}

// A new event goes to every matching live subscription on every connection.
ry_fanout :: (conns: [] RyConn, w: [] RyWork, e: NostrEvent) {
  for i: 0..<conns.count {
    for k: 0..<RS_MAX_SUBS {
      if !rr_deliver(conns[i].h >= 0, conns[i].ws, rd_sub_matches(conns[i].subs[..], k, e, w[0].search[..])) { continue; }
      sid := conns[i].subs[k].id;
      n := ms_write_event(cast(string) sid[0..<conns[i].subs[k].id_n], e.original, w[0].body[..]);
      if !ry_text(conns[i..<i + 1], w, n) { ry_shut(conns[i..<i + 1]); break; }
    }
  }
}
ry_event :: (conns: [] RyConn, at: int, w: [] RyWork, store: [] RdStore, text: string, m: MsMsg) {
  c := conns[at..<at + 1];
  event := text[m.event_from..<m.event_to];
  r := rs_admit_read(event, cxsrv_now_s(), rr_writes_need_auth(true), rr_authed(c[0].auth[..]), w[0].scratch[..]);
  if r.reason == RS_BAD_EVENT { ok := ry_notice(c, w, RS_BAD_EVENT); return; }
  id := r.e.id;
  if r.reason == RS_ACCEPT && w[0].pow > 0 {
    a := nip13_admit(event, w[0].pow, w[0].scratch[..], false);
    if a.error != N13_OK { ry_ok_reason(c, w, id[..], cast(string) w[0].out[0..<nip13_reason(a, w[0].out[..])]); return; }
  }
  if r.reason == RS_ACCEPT { r = rs_admit_verified(r, ne_signed_fast(r.e)); }
  if r.reason == RS_ACCEPT {
    key := r.e.public_key;
    rt := rt_event(c[0].rt[..], w[0].keys[..], w[0].rate, key[..], cxsrv_now_s());
    if rt != RT_OK { ok := ry_text(c, w, ms_write_ok(id[..], false, rt_prefix(rt), rt_text(rt), w[0].body[..])); return; }
    p := nip70_admit(event, true, c[0].auth[..], w[0].scratch[..]);
    if p.decision != N70_ACCEPT { ok := ry_text(c, w, ms_write_ok(id[..], false, nip70_prefix(p.decision), nip70_text(p.decision), w[0].body[..])); return; }
  }
  reason := r.reason;
  if reason == RS_ACCEPT {
    reason = rd_admit(store, r, event);
  }
  prefix := ifx rr_store_extra(reason) then rr_store_prefix(reason) else rs_prefix(reason);
  why := ifx rr_store_extra(reason) then rr_store_text(reason) else rs_text(reason);
  ok := ry_text(c, w, ms_write_ok(id[..], rs_accepted(reason), prefix, why, w[0].body[..]));
  if rr_fanout(reason) { ry_fanout(conns, w, r.e); }
}
// OK false with reason, "prefix: text" (nip13_reason's form).
ry_ok_reason :: (c: [] RyConn, w: [] RyWork, id: [] u8, reason: string) {
  k := 0; while k + 1 < reason.count && !(reason[k] == ':' && reason[k + 1] == ' ') { k += 1; }
  ok := ry_text(c, w, ms_write_ok(id, false, reason[0..<k], reason[k + 2..<reason.count], w[0].body[..]));
}
ry_req :: (c: [] RyConn, w: [] RyWork, store: [] RdStore, text: string, m: MsMsg) {
  mm := m;
  sub := cast(string) mm.sub[0..<mm.sub_n];
  rt := rt_req(c[0].rt[..], w[0].rate, cxsrv_now_s());
  if rt != RT_OK { ok := ry_text(c, w, ms_write_closed(sub, rt_prefix(rt), rt_text(rt), w[0].body[..])); return; }
  v := rr_req_filters(m.filters);
  if v == RS_ACCEPT { v = rd_req(m, text, w[0].search[..]); }
  if v != RS_ACCEPT { ok := ry_closed(c, w, sub, v); return; }
  slot := rs_sub_open(c[0].subs[..], m, text, RS_MAX_SUBS);
  if slot < 0 { ok := ry_closed(c, w, sub, -slot); return; }
  now := cxsrv_now_s(); sent := 0;
  for k: 0..<m.filters {
    idx: [RS_MAX_LIMIT] int;
    n := rd_req_filter(store, text, m, k, now, w[0].search[..], idx[..]);
    for q: 0..<n {
      t := rr_take(w[0].sent[..], sent, idx[q]);
      if t == -1 { continue; }
      if t < 0 { break; }
      sent = t;
      if !ry_text(c, w, ms_write_event(sub, rsd_text(rd_store(store), idx[q]), w[0].body[..])) { return; }
    }
  }
  ok := ry_text(c, w, ms_write_eose(sub, w[0].body[..]));
}
// COUNT (NIP-45, chapter 40): charged as a REQ, then nip45.coax's
// n45_answer over the store's index: the exact count of distinct visible
// matches, CLOSED or NOTICE when refused.
ry_count :: (c: [] RyConn, w: [] RyWork, store: [] RdStore, text: string, m: MsMsg) {
  if m.has_sub {
    mm := m;
    rt := rt_req(c[0].rt[..], w[0].rate, cxsrv_now_s());
    if rt != RT_OK { ok := ry_text(c, w, ms_write_closed(cast(string) mm.sub[0..<mm.sub_n], rt_prefix(rt), rt_text(rt), w[0].body[..])); return; }
  }
  ok := ry_text(c, w, rd_count(store, text, cxsrv_now_s(), w[0].count[..], w[0].body[..]));
}
// AUTH: the event's id first (for the OK), then nip42_admit (the signature
// and nip42.coax's check), then relay_route.coax keeps the key and names
// the answer. Nothing here reaches the store or the fan-out.
ry_auth :: (c: [] RyConn, w: [] RyWork, obj: string) {
  e := nostr_event_read(obj, w[0].scratch[..], false);
  id := e.id;
  if e.error == NE_ID { ok := ry_text(c, w, ms_write_ok(id[..], false, rs_prefix(RS_BAD_ID), rs_text(RS_BAD_ID), w[0].body[..])); return; }
  if e.error != NE_OK { ok := ry_notice(c, w, RS_BAD_EVENT); return; }
  a := nip42_admit(c[0].n42[..], c[0].gen, cxsrv_now_s(), obj, w[0].scratch[..], false);
  key := a.public_key;
  k := rr_auth(c[0].auth[..], a.error, key[..]);
  ok := ry_text(c, w, ms_write_ok(id[..], k == RR_A_OK, rr_auth_prefix(k), rr_auth_text(k), w[0].body[..]));
}
// NEG-ERR for session sub (NIP-77), with the record limit when there is one.
ry_neg_err :: (c: [] RyConn, w: [] RyWork, sub: string, reason: int) {
  n := n77_write_err(w[0].body[..], sub, cast(string) w[0].out[0..<ry_reason(w, rr_neg_prefix(reason), rr_neg_text(reason))]);
  if n > 0 && rr_neg_records(reason) >= 0 {
    n -= 1; n = json_raw(w[0].body[..], n, ",");
    digits: [20] u8; d := 0; p := rr_neg_records(reason);
    while d == 0 || p > 0 { digits[d] = cast(u8) ('0' + p % 10); p /= 10; d += 1; }
    while d > 0 && n >= 0 && n < w[0].body.count { d -= 1; w[0].body[n] = digits[d]; n += 1; }
    n = json_raw(w[0].body[..], n, "]");
  }
  ok := ry_text(c, w, n);
}
// "prefix: text" into w.out: its length.
ry_reason :: (w: [] RyWork, prefix: string, text: string) -> int {
  n := json_raw(w[0].out[..], 0, prefix); n = json_raw(w[0].out[..], n, ": ");
  return json_raw(w[0].out[..], n, text);
}
// Ends session k with NEG-ERR reason.
ry_neg_fail :: (c: [] RyConn, w: [] RyWork, k: int, reason: int) {
  sub := c[0].neg[k].sub;
  c[0].neg[k].live = false;
  ry_neg_err(c, w, cast(string) sub[0..<c[0].neg[k].sub_n], reason);
}
// Answers session k's message (msg_n bytes in w.neg_in) over the store's
// items matching its filter now; NEG-ERR ends the session on a refusal.
ry_neg_answer :: (c: [] RyConn, w: [] RyWork, store: [] RdStore, k: int, msg_n: int) {
  now := cxsrv_now_s();
  filter := c[0].neg[k].filter;
  n := rd_neg_items(store, cast(string) filter[0..<c[0].neg[k].filter_n], now, w[0].neg_items[..]);
  e := rr_neg_items(n);
  if e != RR_NE_OK { ry_neg_fail(c, w, k, e); return; }
  neg: [1] Neg;
  m := -1;
  if neg_init(neg[..], w[0].neg_items[0..<n], false, RR_NEG_FRAME) == NEG_OK {
    m = neg_reconcile(neg[..], cast(string) w[0].neg_in[0..<msg_n], w[0].neg_out[..]);
  }
  if m < 0 { ry_neg_fail(c, w, k, RR_NE_NEG); return; }
  rr_neg_touch(c[0].neg[..], k, now);
  sub := c[0].neg[k].sub;
  ok := ry_text(c, w, n77_write_msg(w[0].body[..], cast(string) sub[0..<c[0].neg[k].sub_n], cast(string) w[0].neg_out[0..<m]));
}
// A frame ms_read didn't know: NIP-77's, or a NOTICE.
ry_neg :: (c: [] RyConn, w: [] RyWork, store: [] RdStore, text: string) {
  f := n77_read(text, w[0].neg_in[..], RR_NEG_IN);
  r := rr_neg_route(f.error, f.verb, f.sub_n);
  sub := cast(string) f.sub[0..<f.sub_n];
  if r.action == RR_NOTICE { ok := ry_notice(c, w, r.reason); return; }
  if r.action == RR_NEG_ERR { closed := rr_neg_close(c[0].neg[..], sub); ry_neg_err(c, w, sub, r.reason); return; }
  if r.action == RR_NEG_CLOSE { closed := rr_neg_close(c[0].neg[..], sub); return; }
  if r.action == RR_NEG_MSG {
    k := rr_neg_find(c[0].neg[..], sub);
    if k < 0 { ry_neg_err(c, w, sub, RR_NE_UNKNOWN); return; }
    ry_neg_answer(c, w, store, k, f.msg_n);
    return;
  }
  rt := rt_req(c[0].rt[..], w[0].rate, cxsrv_now_s());
  if rt != RT_OK {
    closed := rr_neg_close(c[0].neg[..], sub);
    ok := ry_text(c, w, n77_write_err(w[0].body[..], sub, cast(string) w[0].out[0..<ry_reason(w, rt_prefix(rt), rt_text(rt))]));
    return;
  }
  k := rr_neg_open(c[0].neg[..], sub, text[f.filter_from..<f.filter_to], cxsrv_now_s());
  if k < 0 { ry_neg_err(c, w, sub, -k); return; }
  ry_neg_answer(c, w, store, k, f.msg_n);
}
ry_message :: (conns: [] RyConn, at: int, w: [] RyWork, store: [] RdStore, text: string) {
  c := conns[at..<at + 1];
  m := ms_read(text);
  sub := m.sub;
  r := rr_message(m.error, m.type, m.has_sub);
  if r.action == RR_NOTICE && r.reason == RR_RS_VERB { ry_neg(c, w, store, text); return; }
  if r.action == RR_NOTICE { ok := ry_notice(c, w, r.reason); return; }
  if r.action == RR_CLOSED { ok := ry_closed(c, w, cast(string) sub[0..<m.sub_n], r.reason); return; }
  if r.action == RR_EVENT { ry_event(conns, at, w, store, text, m); return; }
  if r.action == RR_REQ { ry_req(c, w, store, text, m); return; }
  if r.action == RR_COUNT { ry_count(c, w, store, text, m); return; }
  if r.action == RR_CLOSE { closed := rs_sub_close(c[0].subs[..], cast(string) sub[0..<m.sub_n]); return; }
  ry_auth(c, w, text[m.event_from..<m.event_to]);
}
// Drops the first n buffered bytes.
ry_consume :: (c: [] RyConn, n: int) {
  for i: n..<c[0].used { c[0].inb[i - n] = c[0].inb[i]; }
  c[0].used -= n;
}
// A fresh challenge for this connection's generation, from host entropy.
ry_challenge :: (c: [] RyConn, w: [] RyWork) -> bool {
  b: [RR_CHALLENGE_BYTES] u8;
  for i: 0..<RR_CHALLENGE_BYTES {
    v := ry_host_random();
    if v < 0 || v > 255 { return false; }
    b[i] = cast(u8) v;
  }
  hex: [64] u8;
  if rr_challenge(b[..], hex[..]) < 0 { return false; }
  c[0].n42[0] = w[0].n42[0];
  f := nip42_issue(c[0].n42[..], c[0].gen, cast(string) hex[..], w[0].body[..]);
  if f.error != N42_OK { return false; }
  return ry_text(c, w, f.written);
}
ry_http :: (c: [] RyConn, w: [] RyWork) {
  h := wss_request(cast(string) c[0].inb[0..<c[0].used]);
  a := rr_http(h.status);
  if a == RR_H_WAIT { return; }
  if a == RR_H_UPGRADE {
    key := cast(string) c[0].inb[h.key_from..<h.key_to];
    n := wss_accept_write(key, w[0].out[..]);
    if n < 0 || !ry_send_raw(c, cast(string) w[0].out[0..<n]) { ry_shut(c); return; }
    ry_consume(c, h.consumed); c[0].ws = true; c[0].since = cxsrv_now_s();
    if !ry_challenge(c, w) { ry_close(c, w, WS_CLOSE_GOING_AWAY); }
    return;
  }
  n := ifx a == RR_H_NIP11 then wss_http_write("200 OK", "application/nostr+json", cast(string) w[0].nip11[0..<w[0].nip11_n], w[0].out[..])
    else wss_http_write("400 Bad Request", "text/plain", "This is a Nostr relay: connect with a WebSocket, or ask for application/nostr+json.", w[0].out[..]);
  if n > 0 { ok := ry_send_raw(c, cast(string) w[0].out[0..<n]); }
  ry_shut(c);
}
ry_frames :: (conns: [] RyConn, at: int, w: [] RyWork, store: [] RdStore) {
  c := conns[at..<at + 1];
  while c[0].h >= 0 && c[0].used > 0 {
    f := wss_frame_read(cast(string) c[0].inb[0..<c[0].used], RS_MAX_MESSAGE);
    fr := rr_frame_read(f.status);
    if fr.action == RR_F_WAIT { return; }
    if fr.action == RR_F_CLOSE { ry_close(c, w, fr.code); return; }
    n := wss_unmask(cast(string) c[0].inb[0..<c[0].used], f, w[0].frame[..]);
    payload := cast(string) w[0].frame[0..<n];
    ev := ws_take(c[0].rd[..], f, payload, c[0].msg[..]);
    ry_consume(c, f.total); c[0].since = cxsrv_now_s();
    d := rr_frame_event(ev, c[0].rd[0].op);
    if d.action == RR_F_TEXT { ry_message(conns, at, w, store, cast(string) c[0].msg[0..<c[0].rd[0].used]); }
    else if d.action == RR_F_BINARY { ok := ry_notice(c, w, RS_BINARY); }
    else if d.action == RR_F_PONG { if !ry_send(c, w, WS_OP_PONG, payload) { ry_shut(c); return; } }
    else if d.action == RR_F_CLOSE { ry_close(c, w, d.code); return; }
    else if d.action == RR_F_ERROR { ry_close(c, w, ws_error_code(ev)); return; }
  }
}
ry_serve :: (conns: [] RyConn, w: [] RyWork, store: [] RdStore) {
  while true {
    r := cxsrv_poll(1000);
    while true {
      h := cxsrv_accept();
      if h <= 0 { break; }
      handles: [RY_CONNS] int;
      for i: 0..<conns.count { handles[i] = conns[i].h; }
      slot := rr_free_slot(handles[0..<conns.count]);
      if slot < 0 { x := cxsrv_close(h); continue; }
      w[0].gen = rr_next_gen(w[0].gen);
      conns[slot].h = h; conns[slot].ws = false; conns[slot].used = 0; conns[slot].rd[0] = WsReader.{};
      conns[slot].gen = w[0].gen; rr_auth_reset(conns[slot].auth[..]); conns[slot].since = cxsrv_now_s();
      conns[slot].rt[0] = RtConn.{}; rr_neg_reset(conns[slot].neg[..]);
    }
    now := cxsrv_now_s();
    for i: 0..<conns.count {
      if conns[i].h < 0 { continue; }
      c := conns[i..<i + 1];
      t := rr_deadline(c[0].ws, c[0].used, c[0].since, now);
      if t == RR_T_DROP { ry_shut(c); continue; }
      if t == RR_T_CLOSE { ry_close(c, w, RR_CLOSE_SLOW); continue; }
      idle := rr_neg_idle(c[0].neg[..], now);
      while idle >= 0 && c[0].h >= 0 { ry_neg_fail(c, w, idle, RR_NE_IDLE); idle = rr_neg_idle(c[0].neg[..], now); }
      if c[0].h < 0 { continue; }
      n := cxsrv_read(c[0].h);
      if n == 0 { continue; }
      if n < 0 { ry_shut(c); continue; }
      if c[0].used + n > RY_IN { ry_close(c, w, WS_CLOSE_TOO_BIG); continue; }
      for k: 0..<n { c[0].inb[c[0].used + k] = cast(u8) cxsrv_byte(c[0].h, k); }
      c[0].used += n;
      if !c[0].ws { ry_http(c, w); }
      if c[0].h >= 0 && c[0].ws { ry_frames(conns, i, w, store); }
    }
  }
}
// True when url's scheme is wss (any case), the scheme a TLS relay's URL must have.
ry_url_wss :: (url: string) -> bool {
  if url.count < 6 { return false; }
  want := "wss://";
  for i: 0..<6 {
    b := url[i];
    if b >= 'A' && b <= 'Z' { b = b + 32; }
    if b != want[i] { return false; }
  }
  return true;
}
// The relay URL NIP-42 answers must name: --url, or ws://ADDRESS:PORT
// (wss:// with TLS). A TLS relay refuses a --url that is not wss://, and a
// plain one a --url that is.
ry_url :: (port: int, out: [] u8) -> int {
  k := 0;
  tls := ry_host_tls() == 1;
  if ry_host_url_count() > 0 {
    if ry_host_url_count() > out.count { return -1; }
    for i: 0..<ry_host_url_count() { out[i] = cast(u8) ry_host_url_byte(i); }
    if ry_url_wss(cast(string) out[0..<ry_host_url_count()]) != tls { return -1; }
    return ry_host_url_count();
  }
  pre := ifx tls then "wss://" else "ws://";
  if pre.count + ry_host_address_count() + 7 > out.count { return -1; }
  for i: 0..<pre.count { out[k] = pre[i]; k += 1; }
  for i: 0..<ry_host_address_count() { out[k] = cast(u8) ry_host_address_byte(i); k += 1; }
  out[k] = ':'; k += 1;
  digits: [6] u8; d := 0; p := port;
  while d == 0 || p > 0 { digits[d] = cast(u8) ('0' + p % 10); p /= 10; d += 1; }
  while d > 0 { d -= 1; out[k] = digits[d]; k += 1; }
  return k;
}
// --rate's limits, or relay_rate.coax's defaults (the Rust relay's).
ry_rate :: () -> RtConfig {
  if ry_host_rate(0) < 0 { return rt_default(); }
  return RtConfig.{events = ry_host_rate(0), reqs = ry_host_rate(1), key_events = ry_host_rate(2)};
}
#assert RR_CAP_DEFAULT == RSD_MAX && RR_CAP_DEFAULT * RR_ARENA_PER == RSD_ARENA && RR_CAP_MIN * RR_ARENA_PER >= NS_FRAME_MAX_ORIGINAL;
// The store's records for --store-capacity's value (-1 when absent), or -1
// after saying why it is refused.
ry_store_events :: (flag: int) -> int #export_c {
  n := rr_capacity(flag);
  if n < 0 { print("relay: --store-capacity takes % to % events\n", RR_CAP_MIN, RR_CAP_MAX); }
  return n;
}
// The store's arena bytes, and its tag-index entries, for events records.
ry_store_arena :: (events: int) -> int #export_c { return rr_arena(events); }
ry_store_tags :: (events: int) -> int #export_c { return events * RS_MAX_TAGS; }
main :: () { print("relay: start the relay with the host that coax/relay/build.sh builds\n"); }
// The relay, over the store's arrays, which the host allocated zeroed at
// ry_store_events records (count_out and count_seen: one COUNT's slots).
ry_main :: (arena: [] u8, recs: [] RsdRec, by_id: [] int, by_ak: [] int, by_time: [] int, tag_key: [] int, tag_rec: [] int, count_out: [] int, count_seen: [] u8) #export_c {
  if cxsrv_listen(ry_host_port()) != 0 { print("relay: cannot listen\n"); return; }
  conns: [RY_CONNS] RyConn;
  w: [1] RyWork;
  url: [512] u8; u := ry_url(cxsrv_bound_port(), url[..]);
  if u < 0 || nip42_init(w[0].n42[..], cast(string) url[0..<u]) != N42_OK {
    print("relay: NIP-42 needs a ws:// (wss:// with TLS) relay URL without brackets: pass --url\n"); return;
  }
  tombs: [RD_TOMBS] NsdTomb; work: [RD_WORK] NsdTomb;
  store: [1] RdStore;
  rd_init(store[..], arena, recs, by_id, by_ak, by_time, tag_key, tag_rec, tombs[..], work[..], cast(string) url[0..<u], ry_host_store() == 1);
  w[0].count[0].big_out = count_out; w[0].count[0].big_seen = count_seen;
  if ry_host_store() == 1 {
    text: [NS_FRAME_MAX_ORIGINAL] u8;
    rp := rd_replay(store[..], cxsrv_now_s(), text[..], w[0].scratch[..]);
    if rp.refused { print("relay: refusing to start: the --store file is damaged at byte % (reason %); it was not changed\n", rp.at, rp.reason); return; }
    if !rp.ok { print("relay: cannot open, lock or read the --store file\n"); return; }
    print("relay: replayed % saved events: % stored, % duplicates or replaced%\n", rp.frames, rp.stored, rp.kept, ifx rp.cut then ", a partial last write cut" else "");
  }
  w[0].rate = ry_rate();
  base: [4096] u8;
  b := rt_nip11(RR_NIP11, w[0].rate, base[..]);
  if b < 0 { print("relay: --rate needs three limits from 1 to %\n", RT_LIMIT_MAX); return; }
  w[0].pow = rr_pow(ry_host_pow());
  if w[0].pow < 0 { print("relay: --pow needs 0 to % bits\n", RR_POW_MAX); return; }
  w[0].nip11_n = rr_nip11_pow(cast(string) base[0..<b], w[0].pow, w[0].nip11[..]);
  if w[0].nip11_n < 0 { print("relay: the NIP-11 document does not fit\n"); return; }
  print("relay: listening on port %\n", cxsrv_bound_port());
  ry_serve(conns[..], w[..], store[..]);
}
