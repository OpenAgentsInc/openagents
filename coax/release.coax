#test "the authored catalogue passes its validation model" {
  rows:=CATALOGUE;#assert RM_catalogue_valid(rows[..],IMPLEMENTATION_VERSION,STATUS_SCHEMA_VERSION);
}
emit_json_string :: (s:string) {
  print("\"");
  for i:0..<s.count {
    if s[i]=='"' {print("\\\"");}
    else if s[i]=='\\' {print("\\\\");}
    else {print("%",s[i..<i+1]);}
  }
  print("\"");
}
emit_md :: (s:string) {
  for i:0..<s.count {if s[i]=='|' {print("\\|");} else {print("%",s[i..<i+1]);}}
}
emit_json :: (rows:[]ReleaseFeature) {
  print("{\"schema_version\":%,\"implementation_version\":\"%\",\"compiler\":\"coax0\",\"features\":[",STATUS_SCHEMA_VERSION,IMPLEMENTATION_VERSION);
  for r,i:rows {
    if i>0 {print(",");}
    print("{\"id\":");emit_json_string(r.id);print(",\"section\":");emit_json_string(r.section);
    print(",\"name\":");emit_json_string(r.name);print(",\"meaning\":");emit_json_string(r.meaning);
    print(",\"status\":");emit_json_string(r.status);print(",\"introduced\":");
    if r.introduced=="" {print("null");} else {emit_json_string(r.introduced);}
    print("}");
  }
  print("]}\n");
}
emit_tables :: (rows:[]ReleaseFeature) {
  sections:=[7]string.["Keywords","Directives","Intrinsics","Conversions","Literals","Types","Capabilities"];
  for section:sections {
    print("\n## %\n\n| Name | Meaning | Status | Introduced |\n| --- | --- | --- | --- |\n",section);
    for r:rows {
      if r.section==section {
        print("| ");emit_md(r.name);print(" | ");emit_md(r.meaning);print(" | % | ",r.status);
        if r.introduced=="" {print("—");} else {print("%",r.introduced);}
        print(" |\n");
      }
    }
  }
}
emit_document :: (rows:[]ReleaseFeature,book:bool) {
  if book {print("# Appendix A. Keywords, directives, types and current status\n\n");}
  else {print("# Coax release and implementation status\n\n");}
  print("<!-- Generated from coax/release.coax; do not edit this snapshot. -->\n");
  print("Current compiler: **coax0 %**. Status inventory schema: **%**.\n\n",IMPLEMENTATION_VERSION,STATUS_SCHEMA_VERSION);
  print("`works` means the bounded feature is implemented; `partial` records its limits.\n`reserved` is recognized and refused; `designed` is planned syntax. A status claim\nis reviewed metadata, not a proof, permission or complete target-support claim.\n\n");
  print("Introduced is the historical implementation version when recorded; — means\nunrecorded or unimplemented. It is independent of this release and inventory\nschema. Keep signed protocol/schema identities in their own version domains.\n");
  emit_tables(rows);
  print("\nAnnotations such as `@range` and `@unit` are lexed but not accepted yet.\nThe accepted grammar and focused implementation tests remain separate evidence\nfor these reviewed status claims.\n");
}
main :: () {
  rows:=CATALOGUE;#assert RM_catalogue_valid(rows[..],IMPLEMENTATION_VERSION,STATUS_SCHEMA_VERSION);
  print("@@coax-file coax/src/release.h\n#pragma once\n// Generated from coax/release.coax; do not edit.\n");
  print("static constexpr char COAX_RELEASE_VERSION[] = \"coax0 %\";\n",IMPLEMENTATION_VERSION);
  print("static constexpr char COAX_RELEASE_STATUS_JSON[] = R\"COAX_RELEASE(");emit_json(rows[..]);print(")COAX_RELEASE\";\n");
  print("static constexpr char COAX_RELEASE_STATUS_MARKDOWN[] = R\"COAX_RELEASE(");emit_document(rows[..],false);print(")COAX_RELEASE\";\n@@coax-end\n");
  print("@@coax-file coax/release-status.json\n");emit_json(rows[..]);print("@@coax-end\n");
  print("@@coax-file coax/STATUS.md\n");emit_document(rows[..],false);print("@@coax-end\n");
  print("@@coax-file coax/book/appendix-a-keywords.md\n");emit_document(rows[..],true);print("@@coax-end\n");
  print("@@coax-file coax/generated/current.md\nCurrent compiler: **coax0 %**. Status inventory schema: **%**.\n@@coax-end\n",IMPLEMENTATION_VERSION,STATUS_SCHEMA_VERSION);
  print("@@coax-file coax/generated/version-example.md\n```bash\n$ coax/bin/coax version\ncoax0 %\n```\n@@coax-end\n",IMPLEMENTATION_VERSION);
}
