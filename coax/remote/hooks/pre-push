#!/usr/bin/env bash
# Firm reason: 5 (a thin wrapper: git-lfs's pre-push, then the Coax pre-push check through
# coax/web/tool.sh; every rule lives in coax/web/prepush.coax).
# Installed once per clone: git config core.hooksPath coax/remote/hooks
# (docs/metaverse/green-main-pipeline.md, "The pre-push check", #13265).
# Emergency bypass, logged in ~/.openagents/prepush-bypass.log: OA_PREPUSH_BYPASS="why" git push ...
# prepush.coax exits 3 to refuse; any other failure (it couldn't build or run) lets the push go
# with a warning, so a broken tool never stops every agent.
refs="$(cat)"
if command -v git-lfs > /dev/null 2>&1; then
  printf '%s' "${refs:+$refs$'\n'}" | git lfs pre-push "$@" || exit $?
fi
[[ -x coax/web/tool.sh ]] || { echo "prepush: no coax/web/tool.sh in this checkout (a sparse one); no check" >&2; exit 0; }
# The compiler agent-reference and wgsl run with: this tree's own coax/bin/coax only when it was
# built from this tree's compiler sources (its provenance.record names this tree's fingerprint,
# coax/provenance.sh, and the binary's own hash), else the build this machine keeps for that
# fingerprint, else the newest kept one. A fresh worktree has no coax/bin/coax until
# coax/build.sh; one copied from another checkout can be days old, and an old compiler writes
# other shaders, so the wgsl check refused current ones (61 on 2026-11-14, #13571).
if [[ -z "${COAX:-}" ]]; then
  cache="${COAX_RELEASE_CACHE:-$HOME/.cache/coax-release}"
  fp="$(coax/provenance.sh fingerprint "$PWD" 2> /dev/null)"
  own=""
  if [[ -n "$fp" && -x coax/bin/coax && -f coax/bin/provenance.record ]]; then
    { IFS= read -r schema; IFS= read -r input; IFS= read -r binary; } < coax/bin/provenance.record
    if [[ "${schema:-}" == coax-provenance-v1 && "${input:-}" == "$fp" ]] \
      && [[ "$(shasum -a 256 < coax/bin/coax 2> /dev/null | cut -d ' ' -f 1)" == "${binary:-}" ]]; then own=1; fi
  fi
  if [[ -n "$own" ]]; then export COAX="$PWD/coax/bin/coax" OA_PREPUSH_COAX_EXACT=1
  elif [[ -n "$fp" && -x "$cache/$fp/coax" ]]; then export COAX="$cache/$fp/coax" OA_PREPUSH_COAX_EXACT=1
  else
    newest="$(ls -t "$cache"/*/coax 2> /dev/null | head -n 1)"
    if [[ -n "$newest" ]]; then export COAX="$newest"
    elif [[ -x coax/bin/coax ]]; then export COAX="$PWD/coax/bin/coax"; fi
  fi
  [[ -z "$own" && -x coax/bin/coax ]] && export OA_PREPUSH_COAX_OWN_STALE=1
fi
[[ -x "${COAX:-coax/bin/coax}" ]] || { echo "prepush: no Coax compiler (run coax/build.sh); no check" >&2; exit 0; }
limit=(); ! command -v timeout > /dev/null 2>&1 || limit=(timeout 300)
# shellcheck disable=SC2086 # the refs are words: LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA per line
"${limit[@]}" coax/web/tool.sh prepush --remote "$1" -- $refs >&2
status=$?
[[ $status != 3 ]] || exit 1
[[ $status == 0 ]] || echo "prepush: WARNING: the check could not run (status $status); the push goes on unchecked" >&2
exit 0
