// Add explicit broad contracts to legacy authority/export/foreign procedures.
// Existing bounds stay intact. Run once with --write; without it, report only.
// tool.sh: stack-gib 1
#import "Basic";
#load "../lib/compiler/lexer.coax";
#load "../lib/compiler/effect-contract.coax";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/proc.coax";

#test "migration follows tokens, preserves explicit contracts and ignores strings and nested checks" {
  positions:[16]int;
  #assert ea_plan("#authority; f :: () {} g :: () #effects(reads) {} main :: () {}",positions[..])==1;
  #assert ea_plan("f :: () #export_c {} host :: () #foreign; leaf :: () {}",positions[..])==2;
  #assert ea_plan("text :: \"#authority f :: () #foreign;\"; #test \"x\" {x:=1;} f :: () {}",positions[..])==0;
  #assert ea_plan("#authority; f :: ($T:copyable,x:$T) -> [2] $T {return [2] $T.[x,x];}",positions[..])==1;
  #assert ea_plan("#authority; f :: () #pure {}",positions[..])==0;
  #assert ea_plan("#authority; f :: () {",positions[..])== -1;
}
ea_plan :: (text:string,positions:[]int)->int {
  decoded:[2097152]u8;message:[64]u8;state:=[1]LX_State.[LX_begin(text.count)];authority:=false;
  while true {
    item:=LX_next(text,state[..],decoded[..],message[..]);
    if item.diagnostic.code!="" {return -1;}
    if item.token.kind==LX_Kind.k_eof {break;}
    if item.token.kind==LX_Kind.k_directive && text[item.token.text_begin..<item.token.text_end]=="authority" {authority=true;}
  }
  state[0]=LX_begin(text.count);before:LX_Token;previous:LX_Token;
  braces:=0;parentheses:=0;brackets:=0;header:=false;declared:=false;foreign:=false;exported:=false;entry:=false;count:=0;
  while true {
    item:=LX_next(text,state[..],decoded[..],message[..]);if item.diagnostic.code!="" {return -1;}
    token:=item.token;kind:=token.kind;if kind==LX_Kind.k_eof {break;}
    if !header && braces==0 && kind==LX_Kind.k_lparen && previous.kind==LX_Kind.k_coloncolon && before.kind==LX_Kind.k_ident {
      header=true;parentheses=1;brackets=0;declared=false;foreign=false;exported=false;entry=text[before.text_begin..<before.text_end]=="main";
    } else if header {
      if kind==LX_Kind.k_lparen {parentheses+=1;}if kind==LX_Kind.k_rparen {parentheses-=1;}
      if kind==LX_Kind.k_lbracket {brackets+=1;}if kind==LX_Kind.k_rbracket {brackets-=1;}
      if kind==LX_Kind.k_directive {
        word:=text[token.text_begin..<token.text_end];
        if word=="foreign" {foreign=true;}if word=="export_c" {exported=true;}
        if word=="effects" || word=="pure" {declared=true;}
      }
      if parentheses==0 && brackets==0 && (kind==LX_Kind.k_lbrace || kind==LX_Kind.k_semicolon) {
        if !declared && EC_required(true,authority,exported,foreign,entry) {
          if count>=positions.count {return -1;}positions[count]=token.loc.offset;count+=1;
        }
        header=false;
      }
    }
    if kind==LX_Kind.k_lbrace {braces+=1;}if kind==LX_Kind.k_rbrace {braces-=1;}
    if braces<0 {return -1;}before=previous;previous=token;
  }
  if braces!=0 || header {return -1;}return count;
}
ea_contains :: (s:string,part:string)->bool {
  for i:0..<s.count-part.count+1 {same:=true;for j:0..<part.count {if s[i+j]!=part[j] {same=false;break;}}if same {return true;}}
  return false;
}
ea_file :: (path:string,write:bool)->int {
  input:[2097152]u8;n:=fs_read(path,input[..]);if n<0 || n==input.count {tool_errln(path);return -1;}
  text:=cast(string)input[0..<n];positions:[20000]int;changes:=ea_plan(text,positions[..]);if changes<=0 {return 0;}
  output:[3145728]u8;at:=0;next:=0;
  for i:0..<text.count {
    if next<changes && positions[next]==i {
      insertion:=ifx text[i]==';' then " #effects(all)" else ifx i>0 && (text[i-1]==' ' || text[i-1]==10 || text[i-1]==9) then "#effects(all) " else " #effects(all) ";
      for ch:insertion {output[at]=ch;at+=1;}next+=1;
    }
    output[at]=text[i];at+=1;
  }
  if write && !fs_write(path,cast(string)output[0..<at]) {return -1;}
  print("% %\n",changes,path);return changes;
}
tool_main :: ()->int #export_c #effects(all) {
  args:[1]Args;if !args_load(args[..]) {return 2;}
  write:=args_count(args[..])==1 && args_at(args[..],0)=="--write";
  if args_count(args[..])>0 && !write {tool_errln("usage: annotate-effects.coax [--write]");return 2;}
  command:=[7]string.["git","ls-files","--cached","--others","--exclude-standard","--","*.coax"];
  paths:[2097152]u8;errors:[4096]u8;r:=proc_run(command[..],120000,paths[..],errors[..]);
  if r.status!=0 || r.cut || r.timed_out {tool_errln(cast(string)errors[0..<r.err_n]);return 2;}
  start:=0;total:=0;files:=0;
  for i:0..<r.out_n {
    if paths[i]!=10 {continue;}path:=cast(string)paths[start..<i];start=i+1;
    // Verification packages retain the exact old source and its hashes.
    if (path.count>=5 && path[0..<5]=="docs/") || ea_contains(path,"/inputs/") || ea_contains(path,"/archive/") {continue;}
    if ea_contains(path,"/fail/") || ea_contains(path,"/invalid/") || ea_contains(path,"/negative/") {continue;}
    changed:=ea_file(path,write);if changed<0 {return 1;}if changed>0 {files+=1;total+=changed;}
  }
  print("effects migration: % procedures in % files%\n",total,files,ifx write then " written" else " (dry run)");
  return 0;
}
