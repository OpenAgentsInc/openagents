// WebAuthn, COSE and RS256 against published samples (webauthn_vectors.coax,
// generated by make_webauthn_vectors.py from pinned files):
//   - every registration and authentication pair of the W3C WebAuthn Level 3
//     "Test Vectors" section;
//   - py_webauthn's real browser responses (EC2, RSA and OKP credentials);
//   - Wycheproof's rsa_signature_2048_sha256 cases with e = 65537, through
//     rsa_verify_sha256 (RS256 is PKCS#1 v1.5 with SHA-256).
// Run natively with
//
//   coax/bin/coax test coax/tests/auth/webauthn_vectors_test.coax
#load "../../lib/crypto/webauthn.coax";
#load "webauthn_vectors.coax";

wv_hex :: (text: string, out: [] u8) -> [] u8 { return cb_unhex(text, out); }

#test "W3C WebAuthn test vectors: every registration and assertion" #steps 4000000000000 {
  for c: WA_SPEC {
    att: [8192] u8; cd: [1024] u8; ch: [128] u8; key: [600] u8; ad: [2048] u8; sig: [600] u8;
    a := wv_hex(c.attestation, att[..]);
    r := webauthn_register(a, wv_hex(c.reg_client, cd[..]), wv_hex(c.reg_challenge, ch[..]), "https://example.org", "example.org", false);
    if r.error != c.reg_expect { print("% registration: expected % got %\n", c.name, c.reg_expect, r.error); }
    #assert r.error == c.reg_expect;
    // Whatever the attestation format, the authenticatorData inside parses
    // and holds the credential key the generator found.
    map := cbor_read(a);
    auth := cbor_map_text(a, map, "authData");
    data := cbor_payload(a, auth);
    parsed := wa_auth_data(data, "example.org", true, false);
    k := wv_hex(c.key, key[..]);
    #assert parsed.error == WA_OK && parsed.key_count == k.count;
    for i: 0..<k.count { #assert data[parsed.key_at + i] == k[i]; }
    if r.error == WA_OK { #assert a[r.key_at] == k[0] && r.key_count == k.count && r.alg == COSE_ES256; }
    got := webauthn_assert(wv_hex(c.auth_data, ad[..]), wv_hex(c.get_client, cd[..]), wv_hex(c.signature, sig[..]), k,
                           wv_hex(c.get_challenge, ch[..]), "https://example.org", "example.org", false, 0, c.be);
    if got.error != c.auth_expect { print("% assertion: expected % got %\n", c.name, c.auth_expect, got.error); }
    #assert got.error == c.auth_expect;
  }
}
#test "py_webauthn: real registrations and assertions" #steps 400000000000 {
  for c: WA_PYW_REG {
    att: [2048] u8; cd: [1024] u8; ch: [64] u8;
    r := webauthn_register(wv_hex(c.attestation, att[..]), wv_hex(c.client, cd[..]), wv_hex(c.challenge, ch[..]), c.origin, c.rp, false);
    if r.error != c.expect { print("%: expected % got %\n", c.name, c.expect, r.error); }
    #assert r.error == c.expect;
    if r.error == WA_OK { #assert r.id_count == 64 && r.alg == COSE_ES256 && r.count == 23 && r.aaguid[0] == 0 && r.aaguid[15] == 0; }
  }
  for c: WA_PYW_GET {
    key: [600] u8; ad: [256] u8; cd: [1024] u8; sig: [600] u8; ch: [64] u8;
    r := webauthn_assert(wv_hex(c.auth_data, ad[..]), wv_hex(c.client, cd[..]), wv_hex(c.signature, sig[..]), wv_hex(c.key, key[..]),
                         wv_hex(c.challenge, ch[..]), "http://localhost:5000", "localhost", c.uv, c.stored, c.be);
    if r.error != c.expect { print("%: expected % got %\n", c.name, c.expect, r.error); }
    #assert r.error == c.expect;
  }
  // The EC2 sample's count goes 77 to 78; the RSA one 0 to 1 with UV.
  #assert WA_PYW_GET[0].stored == 77 && WA_PYW_GET[1].uv;
}
#test "Wycheproof rsa_signature_2048_sha256 (e = 65537): all cases" #steps 4000000000000 {
  valid := 0;
  for c: WA_RSA_CASES {
    n: [512] u8; msg: [1024] u8; sig: [600] u8;
    got := rsa_verify_sha256(wv_hex(WA_RSA_KEYS[c.key], n[..]), wv_hex(c.sig, sig[..]), wv_hex(c.msg, msg[..]));
    if got != c.valid { print("tcId % expected % got %: %\n", c.id, c.valid, got, c.comment); }
    #assert got == c.valid;
    if got { valid += 1; }
  }
  #assert valid > 0;
}
