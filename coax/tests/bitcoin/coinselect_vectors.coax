// waste_test: two coins, 1 and 2 bitcoin, with their fees and long-term
// fees, against a target; the change parameters and the waste.
CsWaste :: struct { name: string; target: int; inputs: int; fees: int; long_term_fees: int;
                    min_viable_change: int; change_cost: int; change_fee: int; waste: int; }
CS_WASTE :: [11] CsWaste.[
  CsWaste.{name="Waste with change is the change cost and difference between fee and long term fee", target=200000000, inputs=300000000, fees=200, long_term_fees=120, min_viable_change=300, change_cost=125, change_fee=30, waste=205},
  CsWaste.{name="With long term fee greater than fee, waste should be less than when long term fee is less than fee", target=200000000, inputs=300000000, fees=200, long_term_fees=280, min_viable_change=300, change_cost=125, change_fee=30, waste=45},
  CsWaste.{name="Waste without change is the excess and difference between fee and long term fee", target=299999720, inputs=300000000, fees=200, long_term_fees=120, min_viable_change=300, change_cost=125, change_fee=30, waste=160},
  CsWaste.{name="Waste without change is the excess and difference between fee and long term fee", target=299999720, inputs=300000000, fees=200, long_term_fees=280, min_viable_change=300, change_cost=125, change_fee=30, waste=0},
  CsWaste.{name="Waste with change and fee == long term fee is just cost of change", target=200000000, inputs=300000000, fees=200, long_term_fees=200, min_viable_change=300, change_cost=125, change_fee=30, waste=125},
  CsWaste.{name="Waste without change and fee == long term fee is just the excess", target=299999720, inputs=300000000, fees=200, long_term_fees=200, min_viable_change=300, change_cost=125, change_fee=30, waste=80},
  CsWaste.{name="Waste is 0 when fee == long_term_fee, no change, and no excess", target=299999800, inputs=300000000, fees=200, long_term_fees=200, min_viable_change=300, change_cost=125, change_fee=30, waste=0},
  CsWaste.{name="Waste is 0 when (fee - long_term_fee) == (-cost_of_change), and no excess", target=200000000, inputs=300000000, fees=200, long_term_fees=280, min_viable_change=300, change_cost=80, change_fee=30, waste=0},
  CsWaste.{name="Waste is 0 when (fee - long_term_fee) == (-excess), no change cost", target=299999720, inputs=300000000, fees=200, long_term_fees=280, min_viable_change=300, change_cost=125, change_fee=30, waste=0},
  CsWaste.{name="Negative waste when the long term fee is greater than the current fee and the selected value == target", target=299999800, inputs=300000000, fees=200, long_term_fees=280, min_viable_change=300, change_cost=125, change_fee=30, waste=-80},
  CsWaste.{name="Negative waste when the long term fee is greater than the current fee and change_cost < - (inputs * (fee - long_term_fee))", target=200000000, inputs=300000000, fees=200, long_term_fees=380, min_viable_change=300, change_cost=125, change_fee=30, waste=-55},
];
