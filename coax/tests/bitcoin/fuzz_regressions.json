{
  "schema": "coax.fuzz-regressions.v1",
  "about": "Inputs fuzz.py found, or that pin down a fix it led to. fuzz.py replays every one in both builds and the reference before it fuzzes; each must give expected.",
  "cases": [
    {
      "target": "p2p_version",
      "input": "80110100090400000000000080b41d6700000000010000000000000000000000000000000000ffff000000000000010000000000000000000000000000000000ffff0000000000000807060504030201102f5361746f7368693a33322e302e302f40d10c00ff",
      "expected": 104,
      "why": "found 2026-11-03 in the first 500-input run: Core reads the relay flag as a bool, so 0xff is true; the harness compared it as a byte and reported an accepted input that did not write back"
    },
    {
      "target": "p2p_version",
      "input": "80110100090400000000000080b41d6700000000010000000000000000000000000000000000ffff000000000000010000000000000000000000000000000000ffff0000000000000807060504030201ff0000",
      "expected": 6,
      "why": "found 2026-11-03 in the first 2,000-input run (rebuilt here from a fixed version message): a CompactSize 0xff with 2 of its 8 bytes; Core throws, and p2p.py read it as 0 and accepted"
    },
    {
      "target": "p2p_version",
      "input": "80110100090400000000000080b41d6700000000010000000000000000000000000000000000ffff000000000000010000000000000000000000000000000000ffff0000000000000807060504030201ff000000000000",
      "expected": 6,
      "why": "found in the same run: the same short read with 6 of 8 bytes"
    },
    {
      "target": "p2p_version",
      "input": "80110100090400000000000080b41d6700000000010000000000000000000000000000000000ffff000000000000010000000000000000000000000000000000ffff0000000000000807060504030201fd05006162636465",
      "expected": 6,
      "why": "added with the fix: a non-canonical CompactSize for the user agent, which Core refuses"
    },
    {
      "target": "p2p_version",
      "input": "",
      "expected": 6,
      "why": "added with the fix: a 257-byte user agent, one past MAX_SUBVERSION_LENGTH"
    },
    {
      "target": "p2p_version",
      "input": "",
      "expected": 102,
      "why": "added with the fix: a 256-byte user agent, the longest Core takes"
    }
  ]
}
