// Thin native oracle ABI; policy and transition logic remain in the libraries.
#run_steps 250000000;
#load "../../lib/bitcoin/lightchain.coax";
#load "../../lib/bitcoin/coins.coax";
LcNative :: struct {
  tree: [1] BlockTree; links: [128] BiLink; entries: [128] BiEntry;
  slots: [256] int; chain: [128] int; path: [128] int;
  ins: [8192] TxIn; outs: [8192] TxOut; items: [8192] TxItem;
  ids: [4096] u8; wids: [4096] u8; merkle: [4096] u8;
}
lc_native_size :: () -> int #export_c { return size_of(LcNative); }
lc_native_headers :: (d: [] LcNative, raw: [] u8) -> int #export_c {
  if raw.count % 80 != 0 { return -1; }
  if !bi_init(d[0].tree[..], CHAIN_REGTEST_PARAMS, d[0].links[..], d[0].entries[..], d[0].slots[..], d[0].chain[..]) { return -1; }
  for i: 0..<raw.count / 80 {
    r := bi_accept_header_vartime(d[0].tree[..], raw[80*i..<80*i+80], 2000000000);
    if r.code != BI_OK { return r.code; }
  }
  return d[0].tree[0].count;
}
lc_native_reorg :: (d: [] LcNative, table: [] u8, used: int, target: int, indices: [] int, raw: [] u8, offsets: [] int, stage: [] u8, batch: [] u8, small: int) -> LcResult #export_c {
  blocks: [128] LcBlock;
  if indices.count > blocks.count || offsets.count != indices.count + 1 { return LcResult.{code=LC_CONTEXT}; }
  for i: 0..<indices.count {
    if offsets[i] < 0 || offsets[i+1] < offsets[i] || offsets[i+1] > raw.count { return LcResult.{code=LC_CONTEXT}; }
    blocks[i] = LcBlock.{index=indices[i], bytes=raw[offsets[i]..<offsets[i+1]]};
  }
  w := LcWork.{ins=d[0].ins[..], outs=d[0].outs[..], items=d[0].items[..], ids=d[0].ids[..], wids=d[0].wids[..], merkle=d[0].merkle[..], path=d[0].path[..]};
  if small == 1 { w.ids = d[0].ids[0..<0]; }
  if small == 2 { w.path = d[0].path[0..<0]; }
  return lc_reorg_vartime(d[0].tree[..], table, used, target, blocks[0..<indices.count], stage, batch, w);
}
lc_native_status :: (d: [] LcNative, i: int) -> int #export_c { return cast(int) d[0].entries[i].status; }
lc_native_frame :: (batch: [] u8, seq: u64, frame: [] u8) -> int #export_c {
  if kv_batch_check_vartime(batch).code != KV_OK || frame.count < batch.count + 8 { return -1; }
  for i: 0..<batch.count { frame[8+i] = batch[i]; }
  kv_seal_vartime(frame, batch.count, seq, 0); return batch.count + 8;
}
lc_native_open :: (file: [] u8, table: [] u8) -> KvOpen #export_c { return kv_open_vartime(file, table); }
lc_native_muhash :: (table: [] u8, used: int, out: [] u8) -> int #export_c {
  m := muhash_new(); at := 0; record: [10100] u8;
  while at < used {
    e := kv_entry_vartime(table, used, at); at = e.next;
    if e.key[0] != 'C' { continue; }
    if e.key.count != 37 || e.value.count < 13 { return -1; }
    c := Coin.{value=kv_get64(e.value, 0), height=kv_get32(e.value, 8), coinbase=e.value[12] != 0};
    n := coin_txout_ser_vartime(e.key[1..<33], kv_get32(e.key, 33), c, e.value[13..<e.value.count], record[..]);
    if n < 0 { return -1; }
    m = muhash_insert_vartime(m, record[0..<n]);
  }
  return muhash_finalize_vartime(m, out);
}
