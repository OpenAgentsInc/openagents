// Independent mined fixtures are generated by lightchain.py. These helpers
// supply bounded caller-owned storage; no header or transition is bypassed.
#load "lightchain_vectors.coax";
LcRaw :: struct { bytes: [1024] u8; n: int; }
LcDemo :: struct {
  tree: [1] BlockTree; links: [128] BiLink; entries: [128] BiEntry;
  slots: [256] int; chain: [128] int; path: [128] int;
  live: [65536] u8; stage: [65536] u8; batch: [131072] u8; used: int;
  ins: [32] TxIn; outs: [32] TxOut; items: [32] TxItem;
  ids: [1024] u8; wids: [1024] u8; merkle: [1024] u8;
  raw: [6] LcRaw;
}
lc_demo_work :: (d: [] LcDemo) -> LcWork {
  return LcWork.{ins=d[0].ins[..], outs=d[0].outs[..], items=d[0].items[..],
    ids=d[0].ids[..], wids=d[0].wids[..], merkle=d[0].merkle[..], path=d[0].path[..]};
}
lc_demo_publish :: (d: [] LcDemo, r: LcResult) {
  #assert r.code == LC_OK;
  for k: 0..<r.used { d[0].live[k] = d[0].stage[k]; }
  d[0].used = r.used;
}
lc_demo_tree :: (d: [] LcDemo) {
  #assert bi_init(d[0].tree[..], CHAIN_REGTEST_PARAMS, d[0].links[..], d[0].entries[..], d[0].slots[..], d[0].chain[..]);
  raw: [1024] u8;
  for text: LC_PREFIX {
    b := tx_unhex(text, raw[..]);
    #assert bi_accept_header_vartime(d[0].tree[..], b[0..<80], 2000000000).code == BI_OK;
  }
  for k: 0..<6 {
    d[0].raw[k].n = LC_BRANCH[k].count / 2;
    b := tx_unhex(LC_BRANCH[k], d[0].raw[k].bytes[..]);
    #assert bi_accept_header_vartime(d[0].tree[..], b[0..<80], 2000000000).code == BI_OK;
  }
  genesis := d[0].entries[0].hash;
  lc_demo_publish(d, lc_init_vartime(5, genesis[..], d[0].live[..], 0, d[0].stage[..], d[0].batch[..]));
}
lc_demo_minimal :: (d: [] LcDemo) {
  #assert bi_init(d[0].tree[..], CHAIN_REGTEST_PARAMS, d[0].links[..], d[0].entries[..], d[0].slots[..], d[0].chain[..]);
  raw: [1024] u8;
  for k: 0..<2 {
    b := tx_unhex(LC_PREFIX[k], raw[..]);
    #assert bi_accept_header_vartime(d[0].tree[..], b[0..<80], 2000000000).code == BI_OK;
  }
  genesis := d[0].entries[0].hash;
  lc_demo_publish(d, lc_init_vartime(5, genesis[..], d[0].live[..], 0, d[0].stage[..], d[0].batch[..]));
}
lc_demo_setup :: (d: [] LcDemo) {
  lc_demo_tree(d); raw: [1024] u8;
  for k: 1..<LC_PREFIX.count {
    b := tx_unhex(LC_PREFIX[k], raw[..]); blocks := [1] LcBlock.[LcBlock.{index=k, bytes=b}];
    r := lc_reorg_vartime(d[0].tree[..], d[0].live[..], d[0].used, k, blocks[..], d[0].stage[..], d[0].batch[..], lc_demo_work(d));
    lc_demo_publish(d, r);
  }
}
lc_demo_branch :: (d: [] LcDemo, first: int, count: int, blocks: [] LcBlock) {
  for k: 0..<count {
    n := first + k;
    blocks[k] = LcBlock.{index=101+n, bytes=d[0].raw[n].bytes[0..<d[0].raw[n].n]};
  }
}
lc_demo_to_a :: (d: [] LcDemo) {
  blocks: [2] LcBlock; lc_demo_branch(d, 0, 2, blocks[..]);
  r := lc_reorg_vartime(d[0].tree[..], d[0].live[..], d[0].used, 102, blocks[..], d[0].stage[..], d[0].batch[..], lc_demo_work(d));
  #assert r.connected == 2 && r.disconnected == 0;
  lc_demo_publish(d, r);
}

// A narrow unit boundary: forged receipts below test each consistency check
// separately. The main qualification trace above always admits real headers.
lc_demo_connect :: (d: [] LcDemo, block: LcBlock, w: LcWork, capacity: int) -> LcResult {
  c: [1] LcCursor; batch := d[0].batch[0..<capacity];
  #assert lc_begin_vartime(d[0].live[..], d[0].used, d[0].stage[..], batch, c[..]);
  code := lc_connect_stage_vartime(d[0].tree[..], d[0].stage[..], c[..], batch, block, w);
  if code != LC_OK { return LcResult.{code=code}; }
  return LcResult.{used=c[0].used, n=c[0].n, connected=1};
}
lc_demo_rehash :: (d: [] LcDemo, b: [] u8) {
  k := merkle_block_ids_vartime(b, false, d[0].ins[..], d[0].outs[..], d[0].items[..], d[0].ids[..], d[0].wids[..]);
  #assert k.code == MERKLE_OK;
  root: [32] u8;
  #assert merkle_root_vartime(d[0].ids[0..<32*k.count], d[0].merkle[..], root[..]).code == MERKLE_OK;
  for i: 0..<32 { b[36+i] = root[i]; }
  #assert pow_block_hash_vartime(b[0..<80], d[0].entries[1].hash[..]) == POW_OK;
}
lc_demo_coins_are :: (d: [] LcDemo, expected: string) -> bool {
  state: [SHA_STATE_BYTES] u8; first: [32] u8; hash: [32] u8; length: [4] u8;
  #assert sha256_init(state[..]) == SHA_OK;
  at := 0;
  while at < d[0].used {
    e := kv_entry_vartime(d[0].live[..], d[0].used, at); at = e.next;
    if e.key[0] == 'C' {
      kv_put32(length[..], 0, e.value.count);
      #assert sha256_update_checked(state[..], length[..], false) == SHA_OK;
      #assert sha256_update_checked(state[..], e.key[1..<37], false) == SHA_OK;
      #assert sha256_update_checked(state[..], e.value, false) == SHA_OK;
    }
    if e.key[0] == 'H' {
      index := bi_find(d[0].tree[..], e.key[1..<33]);
      #assert index >= 0 && e.value.count == 80;
      bytes := ifx index < 101 then LC_PREFIX[index].count / 2 else LC_BRANCH[index-101].count / 2;
      // Every fixture transaction is legacy, so its full serialized size has
      // weight four times its bytes. This does not reuse the transition sum.
      #assert kv_get32(e.value, 76) == 4 * bytes;
    }
  }
  #assert sha256_final_checked(state[..], first[..], false) == SHA_OK;
  #assert sha256_hash_checked(first[..], hash[..], false) == SHA_OK;
  return bh_hex_equal(hash[..], expected);
}
