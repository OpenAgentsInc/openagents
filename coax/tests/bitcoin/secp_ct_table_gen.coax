// Prints coax/lib/crypto/secp_ct_table.coax: the comb table that the
// fixed-work base multiplication (secp_ct_group.coax) reads for k·G when k
// is secret (issue #13454). The points come from chapter 15's group law on
// the 26-bit field (secp_group.coax), not from the code that uses the
// table; secp_ct_group.coax's checks compare the table's sums with that
// group law again.
//
//   coax/web/tool.sh coax/tests/bitcoin/secp_ct_table_gen.coax > coax/lib/crypto/secp_ct_table.coax
#run_steps 250000000;
#load "../../lib/crypto/secp_group.coax";
#import "Basic";

BLOCKS :: 8;
TEETH :: 4;
SPACING :: 8;

row :: (f: SecpField) {
  b: [32] u8; #assert sf_store(f, b[..]);
  for i: 0..<4 { print("%,", cb_load_be64(b[..], 24 - i * 8).value); }
}
tool_main :: () -> int #export_c #effects(all) {
  print("// Generated by coax/tests/bitcoin/secp_ct_table_gen.coax. Do not edit.\n");
  print("CG_BLOCKS :: %;\nCG_TEETH :: %;\nCG_SPACING :: %;\n", BLOCKS, TEETH, SPACING);
  print("// Block b, entry d: the sum of 2^(32b + 8t)·G over the bits t of d, in\n");
  print("// affine coordinates, eight words for each point, x then y. Entry 0 of\n");
  print("// each block is infinity and is stored as zeros; its index marks it.\n");
  print("CG_COMB_WORDS :: [%] u64.[\n", BLOCKS * 16 * 8);
  for block: 0..<BLOCKS {
    basis: [4] SgPoint;
    point := sg_generator();
    for i: 0..<block * 32 { point = sg_double_valid(point); }
    for tooth: 0..<TEETH {
      basis[tooth] = point;
      for i: 0..<SPACING { point = sg_double_valid(point); }
    }
    for entry: 0..<16 {
      print("    ");
      if entry == 0 { for i: 0..<8 { print("0,"); } }
      else {
        sum := sg_infinity(); first := true;
        for tooth: 0..<TEETH {
          if ((entry >> tooth) & 1) == 1 {
            if first { sum = basis[tooth]; first = false; } else { sum = sg_add_valid(sum, basis[tooth]); }
          }
        }
        a := sg_to_affine_valid(sum);
        row(a.x); row(a.y);
      }
      print("\n");
    }
  }
  print("  ];\n");
  return 0;
}
