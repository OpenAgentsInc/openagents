// Prints coax/lib/crypto/secp_fast_table.coax: the odd multiples of G that
// secp_fast.coax adds during verification, and two constants. The points
// come from chapter 15's group law on the 26-bit field (secp_group.coax),
// not from the code that uses the table; secp_fast-checks.coax recomputes
// them the other way.
//
//   coax/bin/coax run coax/tests/bitcoin/secp_fast_table_gen.coax --release > coax/lib/crypto/secp_fast_table.coax
#run_steps 250000000;
#load "../../lib/crypto/secp_glv.coax";
#load "../../lib/crypto/secp_fe.coax";
#import "Basic";

WINDOW :: 8;
ENTRIES :: 64;   // 2^(WINDOW-2)

limbs :: (f: SecpField) -> Fe {
  b: [32] u8;
  #assert sf_store(f, b[..]);
  r := fe_load_vartime(b[..]);
  #assert r.ok;
  return r.value;
}
show :: (f: Fe) { print("Fe.{n=[5] u64.[%,%,%,%,%]}", f.n[0], f.n[1], f.n[2], f.n[3], f.n[4]); }
row :: (f: Fe) { print("%,%,%,%,%,", f.n[0], f.n[1], f.n[2], f.n[3], f.n[4]); }
main :: () {
  print("// Generated by coax/tests/bitcoin/secp_fast_table_gen.coax. Do not edit.\n");
  print("FG_G_WINDOW :: %;\nFG_G_ENTRIES :: %;\n", WINDOW, ENTRIES);
  print("// The cube root of 1 with λ·(x, y) = (β·x, y), and the group order n as a field value.\n");
  print("fg_beta :: () -> Fe #effects(all) { return "); show(limbs(GLV_BETA)); print("; }\n");
  nb: [32] u8; n: SecpField;
  for i: 0..<8 { #assert cb_store_be32(nb[..], 28 - 4*i, SC_N.limbs[i]); }
  print("fg_order :: () -> Fe #effects(all) { return "); show(limbs(sf_load(nb[..]).value)); print("; }\n");
  print("// (2·index + 1)·G in affine coordinates, for a width-% wNAF: ten limbs for\n", WINDOW);
  print("// each point, x then y. The limbs are a literal in the procedure, not a\n");
  print("// constant, so a compile that loads this file spends none of its\n");
  print("// compile-time steps on them; the C compiler turns the literal into read-only\n");
  print("// data.\n");
  print("fg_g_point :: (index: int) -> Fge #effects(all) {\n  t := [%] u64.[\n", ENTRIES * 10);
  point := sg_generator(); twice := sg_double_valid(point);
  for i: 0..<ENTRIES {
    a := sg_to_affine_valid(point);
    print("    "); row(limbs(a.x)); row(limbs(a.y)); print("\n");
    point = sg_add_valid(point, twice);
  }
  print("  ];\n  at := index * 10;\n");
  print("  return Fge.{x=Fe.{n=[5] u64.[t[at], t[at+1], t[at+2], t[at+3], t[at+4]]},y=Fe.{n=[5] u64.[t[at+5], t[at+6], t[at+7], t[at+8], t[at+9]]}};\n}\n");
}
