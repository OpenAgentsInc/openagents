// One authoring schedule for the public and fixed-work 5x52 field columns.
// Both variants are generated here: no copied arithmetic kernel to drift.
// coax/web/tool.sh coax/tests/bitcoin/secp_fe_columns_gen.coax > coax/lib/crypto/secp_fe_columns.coax
#load "../../lib/sys/tool.coax";
fgenc_expression :: (text:string,mac:string,fields:bool) {
  for c,i:text {if c=='@' {print("%",mac);}else if c=='$' {if fields {print(".n");}}else {print("%",text[i..<i+1]);}}
}
fgenc_write :: (name:string,mac:string,columns:[]string,numeric:bool,unary:bool) {
  print("% :: (a:%",name,ifx numeric then "[]const u64" else "Fe");
  if !unary {print(",b:%",ifx numeric then "[]const u64" else "Fe");}
  if numeric {print(",out:[]u64) #inline #effects(all) {\n");print("  #assert a.count==5;");if !unary {print(" #assert b.count==5;");}print(" #assert out.count==18;\n");}
  else {print(") -> Fe #inline #effects(all) {\n");}
  if unary {for i:0..<4 {print("  a%:=a",i);if !numeric {print(".n");}print("[%]<<1;\n",i);}}
  if !numeric {print("  t:[9]CoaxU64Product;\n");}
  for column,i:columns {if numeric {print("  c%:=",i);}else {print("  t[%]=",i);}fgenc_expression(column,mac,!numeric);print(";\n");}
  if numeric {for i:0..<9 {print("  out[%]=c%.lo;out[%]=c%.hi;\n",2*i,i,2*i+1,i);}}
  else {print("  return fe_reduce_public_vartime(t);\n");}
  print("}\n");
}
fgenc_reduce :: (name:string,mac:string) {
  print("% :: (t:[9]CoaxU64Product) -> Fe #inline #effects(all) {",name);
  fgenc_expression("\n  c0:=@(t[0],t[5].lo & FE_M52,FE_R);\n  c1:=@(t[1],(t[6].lo & FE_M52)+fw_shr52(t[5]).lo,FE_R);\n  c2:=@(t[2],(t[7].lo & FE_M52)+fw_shr52(t[6]).lo,FE_R);\n  c3:=@(t[3],(t[8].lo & FE_M52)+fw_shr52(t[7]).lo,FE_R);\n  c4:=@(t[4],fw_shr52(t[8]).lo,FE_R);\n  f:=mul_wide((c4.lo>>48)|(c4.hi<<16),FE_R1);\n  f.hi=add_wrap(f.hi,mul_wrap(c4.hi>>48,FE_R1));\n  r0:=(c0.lo & FE_M52)+(f.lo & FE_M52);\n  r1:=(c1.lo & FE_M52)+fw_shr52(c0).lo+fw_shr52(f).lo;\n  r2:=(c2.lo & FE_M52)+fw_shr52(c1).lo;\n  r3:=(c3.lo & FE_M52)+fw_shr52(c2).lo;\n  r4:=(c4.lo & FE_M48)+fw_shr52(c3).lo;\n  return Fe.{n=[5]u64.[(r0 & FE_M52)+(r4>>48)*FE_R1,(r1 & FE_M52)+(r0>>52),\n    (r2 & FE_M52)+(r1>>52),(r3 & FE_M52)+(r2>>52),(r4 & FE_M48)+(r3>>52)]};",mac,false);
  print("\n}\n");
}
tool_main :: () -> int #export_c #effects(all) {
  product:=[9]string.[
    "mul_wide(a$[0],b$[0])",
    "@(mul_wide(a$[0],b$[1]),a$[1],b$[0])",
    "@(@(mul_wide(a$[0],b$[2]),a$[1],b$[1]),a$[2],b$[0])",
    "@(@(@(mul_wide(a$[0],b$[3]),a$[1],b$[2]),a$[2],b$[1]),a$[3],b$[0])",
    "@(@(@(@(mul_wide(a$[0],b$[4]),a$[1],b$[3]),a$[2],b$[2]),a$[3],b$[1]),a$[4],b$[0])",
    "@(@(@(mul_wide(a$[1],b$[4]),a$[2],b$[3]),a$[3],b$[2]),a$[4],b$[1])",
    "@(@(mul_wide(a$[2],b$[4]),a$[3],b$[3]),a$[4],b$[2])",
    "@(mul_wide(a$[3],b$[4]),a$[4],b$[3])",
    "mul_wide(a$[4],b$[4])"];
  square:=[9]string.[
    "mul_wide(a$[0],a$[0])","mul_wide(a0,a$[1])",
    "@(mul_wide(a0,a$[2]),a$[1],a$[1])",
    "@(mul_wide(a0,a$[3]),a1,a$[2])",
    "@(@(mul_wide(a0,a$[4]),a1,a$[3]),a$[2],a$[2])",
    "@(mul_wide(a1,a$[4]),a2,a$[3])",
    "@(mul_wide(a2,a$[4]),a$[3],a$[3])",
    "mul_wide(a3,a$[4])","mul_wide(a$[4],a$[4])"];
  print("// Generated by coax/tests/bitcoin/secp_fe_columns_gen.coax. Do not edit.\n");
  print("// One schedule, statically specialized carries: secret callers never reach _vartime.\n");
  fgenc_write("fe_columns","fw_mac",product[..],true,false);
  fgenc_write("fe_mul","fw_mac_vartime",product[..],false,false);
  fgenc_write("fe_square_columns","fw_mac",square[..],true,true);
  fgenc_write("fe_sqr","fw_mac_vartime",square[..],false,true);
  fgenc_reduce("fe_reduce_value","fw_mac");
  fgenc_reduce("fe_reduce_public_vartime","fw_mac_vartime");
  return 0;
}
