// Thin caller-owned oracle ABI. All decisions are made by the libraries.
#run_steps 250000000;
#load "../../lib/bitcoin/txindex.coax";
#load "../../lib/bitcoin/txindex-files.coax";
#load "lightchain-native.coax";
TxiNative :: struct { base: [1] LcNative; ids: [32768] u8; wids: [32768] u8; merkle: [32768] u8; }
txi_native_size :: () -> int #export_c { return size_of(TxiNative); }
txi_native_headers :: (d: [] TxiNative, raw: [] u8) -> int #export_c { return lc_native_headers(d[0].base[..],raw); }
txi_native_reorg :: (d: [] TxiNative, table: [] u8, used: int, indices: [] int, raw: [] u8, offsets: [] int, positions: [] int, stage: [] u8, batch: [] u8) -> LcResult #export_c {
  blocks: [128] LcBlock; locs: [128] TxiLoc;
  if indices.count < 1 || indices.count > 128 || offsets.count != indices.count+1 || positions.count != indices.count { return LcResult.{code=LC_CONTEXT}; }
  for i: 0..<indices.count {
    if offsets[i] < 0 || offsets[i+1] < offsets[i] || offsets[i+1] > raw.count { return LcResult.{code=LC_CONTEXT}; }
    blocks[i] = LcBlock.{index=indices[i],bytes=raw[offsets[i]..<offsets[i+1]]}; locs[i] = TxiLoc.{file=0,pos=positions[i]};
  }
  w := LcWork.{ins=d[0].base[0].ins[..],outs=d[0].base[0].outs[..],items=d[0].base[0].items[..],ids=d[0].ids[..],wids=d[0].wids[..],merkle=d[0].merkle[..],path=d[0].base[0].path[..]};
  return txi_reorg_vartime(d[0].base[0].tree[..],table,used,indices[indices.count-1],blocks[0..<indices.count],locs[0..<indices.count],stage,batch,w);
}
txi_native_check :: (d: [] TxiNative, hit: TxiHit, id: [] u8, header: [] u8, raw: [] u8) -> int #export_c {
  return txi_check_tx_vartime(hit,id,header,raw,d[0].base[0].ins[..],d[0].base[0].outs[..],d[0].base[0].items[..]);
}
