// Iteration image only, never publication: the trusted compiler emits the
// complete authored module, then the host C/C++ compilers link the driver.
#import "Basic";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/proc.coax";

bg_run :: (args:[]string,out:[]u8)->int {
  err:[65536]u8;r:=proc_run(args,600000,out,err[..]);
  if r.started!=0||r.status!=0||r.cut||r.timed_out {tool_errln(cast(string)err[0..<r.err_n]);tool_errln("graphics iteration build failed or exceeded its ten-minute step bound");return -1;}
  return r.out_n;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..])||args_count(a[..])!=2 {tool_errln("usage: build-graphics.coax TRUSTED_COMPILER ABS_OUT");return 2;}
  compiler:=args_at(a[..],0);dir:=args_at(a[..],1);if !fs_mkdir(dir){return 1;}p:[4][4096]u8;
  header:=fs_join(dir,"proto_importer.h",p[0][..]);code:=fs_join(dir,"proto_importer.c",p[1][..]);object:=fs_join(dir,"proto_importer.o",p[2][..]);out:[8388608]u8;
  gen:=[6]string.[compiler,"c","coax/lib/compiler/compiler.coax","--library","--header",header];
  n:=bg_run(gen[..],out[..]);if n<0||!fs_write(code,cast(string)out[0..<n]){return 1;}
  runtime:=fs_join(dir,"proto_runtime.inc",p[3][..]);if !fs_write(runtime,""){return 1;}
  names:=[4]string.["PROTO_CORE_SOURCE","PROTO_MEMORY_SOURCE","PROTO_IMPORTER_SOURCE","PROTO_FINGERPRINT_SOURCE"];
  for i:0..<4 {
    if !fs_append(runtime,"static constexpr char ")||!fs_append(runtime,names[i])||!fs_append(runtime,"[] = R\"COAX_DATA("){return 1;}
    files:=[5]string.["coax/lib/proto/wire.coax","coax/lib/proto/memory.coax","coax/lib/proto/importer.coax","coax/lib/crypto/sha256-kernel.coax","coax/lib/proto/fingerprint.coax"];
    for k:i..<(ifx i==3 then 5 else i+1) {n=fs_read(files[k],out[..]);if n<0||!fs_append(runtime,cast(string)out[0..<n]){return 1;}}
    if !fs_append(runtime,")COAX_DATA\";\n"){return 1;}
  }
  cc:=[8]string.["cc","-std=c11","-O1","-g","-c",code,"-o",object];if bg_run(cc[..],out[..])<0{return 1;}
  image_path:[4096]u8;image:=fs_join(dir,"coax",image_path[..]);
  cxx:=[13]string.["c++","-std=c++20","-O2","-g","-Wall","-Wextra","-Wno-missing-field-initializers","-I",dir,"-o",image,"coax/src/main.cpp",object];
  if bg_run(cxx[..],out[..])<0{return 1;}print("Iteration compiler (not a published release): %\n",image);return 0;
}
