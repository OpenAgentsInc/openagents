// By-value aggregate arguments (#13609). The evaluator passes a struct or
// array argument without copying it when nothing can tell. Each scene here is
// a way a program could tell: its answer is what a copy at the call gives,
// and tests/eval-lend.coax holds the evaluator (checks and #run), with the
// sharing on, off and checked, to the answers native code prints.
#import "Basic";

In :: struct { a: int; v: [3] int; }
Choice :: union { empty; num: int; rec: In; }
Rec :: struct { x: int; in: In; rows: [2] In; tag: int?; pick: Choice; }
World :: struct { r: [2] Rec; n: int; }
Pair :: struct { a: Rec; b: Rec; }
Span :: struct { w: [] int; }

mk :: (seed: int) -> Rec {
  r := Rec.{pick = Choice.{empty}};
  r.x = seed;
  r.in.a = seed + 1;
  for i: 0..<3 { r.in.v[i] = seed + 10 + i; r.rows[0].v[i] = seed + 20 + i; r.rows[1].v[i] = seed + 30 + i; }
  r.rows[0].a = seed + 2;
  r.rows[1].a = seed + 3;
  if seed % 2 == 1 { r.tag = some(seed * 3); r.pick = Choice.{num = seed * 5}; }
  else { r.pick = Choice.{rec = In.{a = seed, v = [3] int.[seed, seed + 1, seed + 2]}}; }
  return r;
}
digest_in :: (i: In) -> int { return i.a * 7 + i.v[0] * 11 + i.v[1] * 13 + i.v[2] * 17; }
tag_of :: (r: Rec) -> int { switch r.tag { case none { return -1; } case some(v) { return v; } } }
pick_of :: (r: Rec) -> int {
  switch r.pick { case empty { return -2; } case num(n) { return n; } case rec(i) { return digest_in(i); } }
}
digest :: (r: Rec) -> int {
  return r.x * 3 + digest_in(r.in) * 5 + digest_in(r.rows[0]) * 19 + digest_in(r.rows[1]) * 23 + tag_of(r) * 29 + pick_of(r) * 31;
}

// 1. The callee copies its parameter and writes the copy, whole, a field and an element.
bump_copy :: (r: Rec) -> int {
  me := r;
  me.x += 100; me.in.v[1] += 100; me.rows[1].a = 7; me.tag = some(9); me.pick = Choice.{empty};
  whole := r; whole = mk(40);
  return (digest(me) - digest(r)) * 2 + whole.x - r.x;
}
s_copy :: () -> int { a := mk(1); before := digest(a); d := bump_copy(a); #assert digest(a) == before; return d + digest(a); }

// 2. A nested field and an element as the argument.
s_nested :: () -> int {
  w := World.{r = [2] Rec.[mk(4), mk(5)]}; k := 1;
  t := digest(w.r[k]) + digest_in(w.r[k].in) * 2 + digest_in(w.r[k].rows[k]) * 3 + tag_of(w.r[1 - k]);
  w.r[k].in.a += 1;
  return t + digest_in(w.r[k].in);
}

// 3. The same storage passed twice, once behind a writable view: the callee writes it and reads its copy.
poke_then_read :: (all: [] Rec, one: Rec) -> int { all[0].x = 900; all[0].in.v[2] = 901; all[0].tag = some(902); return one.x * 1000 + one.in.v[2] + tag_of(one); }
turn :: (out: [] int, src: [3] int) -> int { for i: 0..<3 { out[i] = src[2 - i] * 2; } return out[0] * 100 + out[1] * 10 + out[2]; }
via_carrier :: (s: Span, src: [3] int) -> int { s.w[0] = 70; s.w[2] = 72; return src[0] + src[1] + src[2]; }
poke_below :: (all: [] Rec) { all[0].rows[1].v[1] = 444; }
read_after :: (all: [] Rec, one: Rec) -> int { poke_below(all); return digest_in(one.rows[1]) - digest_in(all[0].rows[1]); }
s_alias :: () -> int {
  a := [1] Rec.[mk(3)];
  t := poke_then_read(a[..], a[0]);
  v := [3] int.[1, 2, 3];
  t = t * 1000 + turn(v[..], v);
  u := [3] int.[4, 5, 6];
  t = t * 100 + via_carrier(Span.{w = u[..]}, u);
  return t * 7 + read_after(a[..], a[0]);
}

// 4. A later argument's call writes what an earlier argument was read from.
bump :: (all: [] Rec) -> int { all[0].x += 50; return 1; }
two :: (one: Rec, n: int) -> int { return one.x * 10 + n; }
two_back :: (n: int, one: Rec) -> int { return one.x * 10 + n; }
three :: (first: Rec, n: int, last: Rec) -> int { return first.x * 10000 + last.x * 10 + n; }
at_bumped :: (all: [] Rec) -> int { all[0].x += 7; return 0; }
s_order :: () -> int {
  a := [1] Rec.[mk(4)];
  t := two(a[0], bump(a[..]));              // 4 at the call's first argument, 54 after
  t = t * 1000 + two_back(bump(a[..]), a[0]);  // 104 by the time it is read
  t = t * 100000 + three(a[0], bump(a[..]), a[0]);
  return t * 1000 + two(a[at_bumped(a[..])], 5);
}

// 5. The callee borrows its parameter: a read-only view of it, used and passed down.
sum3 :: (v: [] const int) -> int { t := 0; for x: v { t += x; } return t; }
by_slice :: (v: [3] int) -> int { return sum3(v[..]) + sum3(v[1..<3]); }
keep :: (r: Rec) -> int { ro: [] const int = r.in.v[..]; rows: [] const In = r.rows[..]; return ro[0] + ro[2] + rows[1].a; }
s_borrow :: () -> int { a := mk(6); t := by_slice(a.in.v) + keep(a); a.in.v[0] = 0; return t * 100 + by_slice(a.in.v) + keep(a); }

// 6. Recursion: the parameter goes down the calls, and the caller writes the original between them.
deep :: (r: Rec, n: int) -> int { if n == 0 { return r.x; } me := r; me.x += 1; return deep(me, n - 1) + deep(r, n - 1) * 2 + r.x; }
down :: (r: Rec, n: int) -> int { if n == 0 { return digest(r); } return down(r, n - 1) + 1; }
up :: (all: [] Rec, n: int) -> int { before := down(all[0], n); all[0].x += 1000; after := down(all[0], n); return after - before; }
s_recursion :: () -> int {
  a := mk(2); t := 0;
  for i: 0..<3 { t += deep(a, 4); a.x += 10; a.in.v[0] += 1; }
  b := [1] Rec.[a];
  return t * 10000 + up(b[..], 5);
}

// 7. A transaction in the callee, kept and rolled back, with the same record passed twice.
tx_plain :: (r: Rec, again: Rec, fail: bool) -> int? #effects(reads, writes, traps) {
  acc: [2] int;
  #transaction { acc[0] = r.x; acc[1] = again.in.a; if fail { return null; } }
  return some(acc[0] * 100 + acc[1]);
}
tx_out :: (r: Rec, out: [] Rec, fail: bool) -> int? #effects(reads, writes, traps) {
  #transaction { out[0].x = r.x + 1; out[0].in.a = r.in.a + 1; if fail { return null; } }
  return some(out[0].x * 100 + r.x);
}
s_transaction :: () -> int {
  a := [1] Rec.[mk(8)];
  t := tx_plain(a[0], a[0], false) or_else -1;
  t = t * 10 + (tx_plain(a[0], a[0], true) or_else -1);
  t = t * 10000 + (tx_out(a[0], a[..], true) or_else -1) + a[0].x;
  return t * 10000 + (tx_out(a[0], a[..], false) or_else -1) + a[0].x;
}

// 8. Deferred statements in the callee read the parameter last.
deferred :: (r: Rec) -> int { t := 0; me := r; { defer { t += r.x; } me.x = 500; t += me.x; } return t * 10 + r.x; }
s_defer :: () -> int { a := mk(9); t := 0; { defer { a.x = 0; } t = deferred(a); } return t * 10 + a.x; }

// 9. A constant, a part of one, a call's result and a part of one as the argument.
K :: #run mk(11);
s_values :: () -> int {
  return digest(K) + digest_in(K.rows[1]) * 2 + digest(mk(6)) * 3 + digest_in(mk(6).in) * 5 + digest_in(mk(7).rows[1]) * 7 + tag_of(K);
}

// 10. The parameter returned, and kept twice in a returned record: each is its own copy.
ident :: (r: Rec) -> Rec { return r; }
pair :: (r: Rec) -> Pair { return Pair.{a = r, b = r}; }
inner :: (r: Rec) -> In { return r.rows[1]; }
s_returned :: () -> int {
  a := mk(7);
  b := ident(a); b.x = 70;
  p := pair(a); p.a.x = 71; p.b.in.v[0] = 72;
  i := inner(a); i.a = 73;
  a.x = 74;
  q := pair(a); a.x = 75;
  return a.x + b.x * 2 + p.a.x * 3 + p.b.x * 5 + p.b.in.v[0] * 7 + p.a.in.v[0] * 11 + i.a * 13 + a.rows[1].a * 17 + q.a.x * 19 + q.b.x * 23;
}

// 11. Iterating the parameter, the same record as two arguments, and a parameter passed on.
total :: (v: [3] int) -> int { t := 0; for x, i: v { t += x * (i + 1); } return t; }
rows :: (r: Rec) -> int { t := 0; for row: r.rows { t += digest_in(row); } return t; }
same :: (a: Rec, b: Rec) -> bool { return digest(a) == digest(b) && a.x == b.x; }
pass_on :: (r: Rec, n: int) -> int { return digest(r) + total(r.in.v) * n + rows(r); }
s_reads :: () -> int {
  a := mk(12); w := World.{r = [2] Rec.[a, mk(13)]};
  t := total(a.in.v) + rows(a) * 2 + pass_on(a, 3);
  if same(a, a) { t += 1000000; }
  if same(a, w.r[0]) { t += 2000000; }
  w.r[0].x += 1;
  if same(a, w.r[0]) { t += 4000000; }
  return t;
}

// 12. A later argument that calls: a callee handed no writable view cannot write the earlier
// argument, and one whose own argument is such a call can.
twice :: (n: int) -> int { return n * 2; }
s_later :: () -> int {
  a := [1] Rec.[mk(4)];
  t := two(a[0], total(a[0].in.v));
  t = t * 1000 + two(a[0], twice(bump(a[..])));
  t = t * 1000 + two(a[0], twice(digest(a[0]) % 7));
  return t * 1000 + three(a[0], twice(total(a[0].in.v)) + bump(a[..]), a[0]) % 1000;
}

// 13. A whole array, large enough that the evaluator would rather not copy it, read by one
// callee and behind a writable view in another. (A copy of at most eight values is always made.)
flip :: (out: [] int, src: [12] int) -> int {
  for i: 0..<12 { out[i] = src[11 - i] * 2; }
  t := 0;
  for i: 0..<12 { t = t * 3 + out[i]; }
  return t;
}
wide :: (v: [12] int) -> int { t := 0; for x, i: v { t += x * (i + 1); } return t; }
s_wide :: () -> int {
  v: [12] int;
  for i: 0..<12 { v[i] = i + 1; }
  a := wide(v);
  b := flip(v[..], v);
  return a * 100000000 + b + wide(v);
}

// Each answer is what native code prints (main, below), written out, so a check
// cannot agree with a wrong evaluator: once from the check and once from #run.
R_COPY :: #run s_copy();
R_NESTED :: #run s_nested();
R_ALIAS :: #run s_alias();
R_ORDER :: #run s_order();
R_BORROW :: #run s_borrow();
R_RECURSION :: #run s_recursion();
R_TRANSACTION :: #run s_transaction();
R_DEFER :: #run s_defer();
R_VALUES :: #run s_values();
R_RETURNED :: #run s_returned();
R_READS :: #run s_reads();
R_LATER :: #run s_later();
R_WIDE :: #run s_wide();

#test "the callee writes a copy of its parameter" { #assert s_copy() == 65933 && R_COPY == 65933; }
#test "a nested field and an element as the argument" { #assert s_nested() == 68150 && R_NESTED == 68150; }
#test "the argument's storage behind a writable view" { #assert s_alias() == 2117244175 && R_ALIAS == 2117244175; }
#test "a later argument's call writes an earlier argument" { #assert s_order() == 4205141542615 && R_ORDER == 4205141542615; }
#test "the callee borrows its parameter" { #assert s_borrow() == 12997 && R_BORROW == 12997; }
#test "recursion and a caller that writes between calls" { #assert s_recursion() == 47823000 && R_RECURSION == 47823000; }
#test "a transaction in the callee" { #assert s_transaction() == 808900070917 && R_TRANSACTION == 808900070917; }
#test "deferred statements read the parameter" { #assert s_defer() == 50990 && R_DEFER == 50990; }
#test "a constant and a call's result as the argument" { #assert s_values() == 313776 && R_VALUES == 313776; }
#test "the parameter returned and kept" { #assert s_returned() == 5381 && R_RETURNED == 5381; }
#test "the parameter iterated, passed twice and passed on" { #assert s_reads() == 3105858 && R_READS == 3105858; }
#test "a later argument that calls" { #assert s_later() == 132042542225 && R_LATER == 132042542225; }
#test "a whole array read and behind a writable view" { #assert s_wide() == 65006112300 && R_WIDE == 65006112300; }

main :: () {
  // What the evaluator worked out while compiling, then the same from native code.
  print("copy % %\n", R_COPY, s_copy());
  print("nested % %\n", R_NESTED, s_nested());
  print("alias % %\n", R_ALIAS, s_alias());
  print("order % %\n", R_ORDER, s_order());
  print("borrow % %\n", R_BORROW, s_borrow());
  print("recursion % %\n", R_RECURSION, s_recursion());
  print("transaction % %\n", R_TRANSACTION, s_transaction());
  print("defer % %\n", R_DEFER, s_defer());
  print("values % %\n", R_VALUES, s_values());
  print("returned % %\n", R_RETURNED, s_returned());
  print("reads % %\n", R_READS, s_reads());
  print("later % %\n", R_LATER, s_later());
  print("wide % %\n", R_WIDE, s_wide());
}
