// Native integration assertions use the actual room, combat and ledger entry points.
// tool.sh: stack-gib 1
#run_steps 250000000;   // secp256k1's tables: the seat ticket's v5 check (aethyr/session/seat-ticket.coax, #13260)
#import "Basic";
#load "../web/room/room.coax";
native_seat_lifetime :: () #effects(all) {
  v:[1]RmServer;k:=rc_test_room(v[..],"pair-e2-handles",2,false);r:=v[0].eg[k].relay;
  old:=eg_seat_ref(v[..],k,SeatId.{value=0});
  #assert handle_present(old) && eg_seat_ref_live(v[..],k,old);
  eg_rejoin(v[..],r,0,SeatId.{value=0});
  #assert eg_seat_ref(v[..],k,SeatId.{value=0})==old;
  eg_left(v[..],r,SeatId.{value=0});eg_join(v[..],r,0,SeatId.{value=0});
  fresh:=eg_seat_ref(v[..],k,SeatId.{value=0});
  #assert fresh!=old && handle_slot(fresh)==handle_slot(old);
  switch eg_seat_get(v[..],k,old) {case none {} case some(wrong) {#assert false;}}
  switch eg_seat_get(v[..],k,fresh) {case none {#assert false;} case some(current) {#assert current[0].live;}}
  #assert rm_eg_seat_owner(v[..],k,SeatId.{value=0})==fresh.value;
  #assert !handle_present(eg_seat_ref(v[..],-1,SeatId.{value=0})) && !handle_present(eg_seat_ref(v[..],EG_ROOMS,SeatId.{value=0}));
  #assert !handle_present(eg_seat_ref(v[..],k,SeatId.{value= -1})) && !handle_present(eg_seat_ref(v[..],k,SeatId.{value=EG_SEATS}));
  #assert !handle_present(eg_seat_ref(v[..],k,SeatId.{value=2}));
  #assert !eg_seat_ref_live(v[..],-1,fresh) && !eg_seat_ref_live(v[..],EG_ROOMS,fresh);
  #assert !eg_seat_ref_live(v[..],k,Handle(EvergladeSeat).{}) && !eg_seat_ref_live(v[..],k,Handle(EvergladeSeat).{value=4294967312});
}
native_fire_rollback :: () #effects(all) {
  r:[1]EgBattle;egb_start(r[..],9);egb_join(r[..],0,0,0,0,1);egb_join(r[..],1,3,0,0,1);
  first:=EGB_SEAT;second:=EGB_SEAT+1;hp0:=r[0].b[0].c[first].hp;hp1:=r[0].b[0].c[second].hp;
  random:=r[0].b[0].dice[0].state;events:=r[0].b[0].book[0].seq;
  hits:=[3]EgbDamage.[EgbDamage.{who=first,by=first,amount=3},EgbDamage.{who=second,by=first,amount=4},EgbDamage.{who= -1,amount=5}];
  switch egb_damage_many(r[0].b[..],hits[..]) {case none {} case some(wrong) {#assert false;}}
  #assert r[0].b[0].c[first].hp==hp0 && r[0].b[0].c[second].hp==hp1;
  #assert r[0].b[0].dice[0].state==random && r[0].b[0].book[0].seq==events;
  switch egb_damage_many(r[0].b[..],hits[0..<2]) {case none {#assert false;} case some(applied) {#assert applied;}}
  #assert r[0].b[0].c[first].hp==hp0-3 && r[0].b[0].c[second].hp==hp1-4;
}
tool_main :: ()->int #export_c #effects(all) {native_seat_lifetime();native_fire_rollback();print("native Everglade safety: 2 passed\n");return 0;}
