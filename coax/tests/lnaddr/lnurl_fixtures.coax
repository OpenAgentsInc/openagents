// An invoice signed with INVOICE_KEY: payment hash 07..07, secret 09..09,
// the description hash dh (or a plain description "x" when plain), expiry
// seconds, stamped at. Its length in out.
lu_t_invoice :: (network: int, msat: int, at: int, expiry: int, dh: [] u8, plain: bool, out: [] u8) -> int {
  w: [1] InvoiceWriter; key: [32] u8; ph: [32] u8; secret: [32] u8;
  for i: 0..<32 { ph[i] = 7; secret[i] = 9; }
  _ = invoice_begin_vartime(w[..], network, msat > 0, cast(u64) msat, cast(u64) at);
  _ = invoice_put_bytes_vartime(w[..], INV_P, ph[..]);
  _ = invoice_put_bytes_vartime(w[..], INV_S, secret[..]);
  if plain { d := [1] u8.['x']; _ = invoice_put_bytes_vartime(w[..], INV_D, d[..]); }
  else { _ = invoice_put_bytes_vartime(w[..], INV_H, dh); }
  _ = invoice_put_number_vartime(w[..], INV_X, cast(u64) expiry);
  t := invoice_sign_vartime(w[..], ln_unhex(INVOICE_KEY, key[..]), out);
  return t.length;
}
// The zap request fixture with one signature digit changed.
lu_t_zap_bad_sig :: (out: [] u8) -> string {
  for i: 0..<N57_T_REQUEST.count { out[i] = N57_T_REQUEST[i]; }
  k := N57_T_REQUEST.count - 3;
  out[k] = ifx out[k] == '8' then cast(u8) '9' else cast(u8) '8';
  return cast(string) out[0..<N57_T_REQUEST.count];
}
// An upstream payRequest from parts: {"tag":"payRequest" then a, b, c and d, then }.
LU_T_CB :: ",\"callback\":\"https://x.example.com/cb\"";
LU_T_META :: ",\"metadata\":\"[[\\\"text/plain\\\",\\\"hi\\\"]]\"";
LU_T_RANGE :: ",\"minSendable\":1000,\"maxSendable\":5000";
LU_T_DIGITS64 :: "1111111111111111111111111111111111111111111111111111111111111111";
lu_t_up :: (a: string, b: string, c: string, d: string, out: [] u8) -> string {
  n := json_raw(out, 0, "{\"tag\":\"payRequest\""); n = json_raw(out, n, a); n = json_raw(out, n, b);
  n = json_raw(out, n, c); n = json_raw(out, n, d); n = json_raw(out, n, "}");
  return cast(string) out[0..<n];
}
