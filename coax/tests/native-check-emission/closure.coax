#import "Basic";
// These checks precede the procedures they exercise.
#test "exact scalar values and caller-owned buffer" {
  #assert multiply(6, 7) == 42;
  #assert ratio(7.0, 2.0) == 3.5;
  values := [4]int.[91, 0, 0, 92];
  write_with_defer(values[1..<3]);
  #assert values[0] == 91;
  #assert values[1] == 5;
  #assert values[2] == 8;
  #assert values[3] == 92;
}
#test "defer cleanup order and loop exits" {
  values := [1]int.[3];
  cleanup_order(values[..]);
  #assert values[0] == 321;
  #assert loop_sum() == 10;
}

multiply :: (a: int, b: int) -> int { return a * b; }
ratio :: (a: f64, b: f64) -> f64 { return a / b; }
write_with_defer :: (out: []int) {
  defer out[0] += 1;
  out[0] = 4;
  out[1] = 8;
}
cleanup_order :: (out: []int) {
  defer out[0] = out[0] * 10 + 1;
  defer out[0] = out[0] * 10 + 2;
}
loop_sum :: () -> int {
  total := 0;
  for i: 0..<6 {
    defer total += 1;
    if i == 1 { continue; }
    if i == 4 { break; }
    total += i;
  }
  return total;
}

unrelated_foreign :: () -> int #foreign;
unrelated_effect :: () { print("this effect is outside the check closure"); }
main :: () { unrelated_effect(); value := unrelated_foreign(); }
