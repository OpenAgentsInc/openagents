// Exactly one original case; native ABI2 arity limit is separate from product size.
#forall "native singleton arity 64"
  b00: 0..<1,
  b01: 0..<1,
  b02: 0..<1,
  b03: 0..<1,
  b04: 0..<1,
  b05: 0..<1,
  b06: 0..<1,
  b07: 0..<1,
  b08: 0..<1,
  b09: 0..<1,
  b10: 0..<1,
  b11: 0..<1,
  b12: 0..<1,
  b13: 0..<1,
  b14: 0..<1,
  b15: 0..<1,
  b16: 0..<1,
  b17: 0..<1,
  b18: 0..<1,
  b19: 0..<1,
  b20: 0..<1,
  b21: 0..<1,
  b22: 0..<1,
  b23: 0..<1,
  b24: 0..<1,
  b25: 0..<1,
  b26: 0..<1,
  b27: 0..<1,
  b28: 0..<1,
  b29: 0..<1,
  b30: 0..<1,
  b31: 0..<1,
  b32: 0..<1,
  b33: 0..<1,
  b34: 0..<1,
  b35: 0..<1,
  b36: 0..<1,
  b37: 0..<1,
  b38: 0..<1,
  b39: 0..<1,
  b40: 0..<1,
  b41: 0..<1,
  b42: 0..<1,
  b43: 0..<1,
  b44: 0..<1,
  b45: 0..<1,
  b46: 0..<1,
  b47: 0..<1,
  b48: 0..<1,
  b49: 0..<1,
  b50: 0..<1,
  b51: 0..<1,
  b52: 0..<1,
  b53: 0..<1,
  b54: 0..<1,
  b55: 0..<1,
  b56: 0..<1,
  b57: 0..<1,
  b58: 0..<1,
  b59: 0..<1,
  b60: 0..<1,
  b61: 0..<1,
  b62: 0..<1,
  b63: 0..<1 {
  #assert b00 == 0 && b63 == 0;
}
