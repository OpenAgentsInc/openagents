#import "Basic";
#forall "original parameterized closure" value: -1..<2 { #assert same(value) == value; }
same :: (value: $T) -> T { return value; }
unrelated_foreign :: () -> int #foreign;
Unrelated :: struct { value: int = unrelated_foreign(); }
main :: () { item := Unrelated.{}; print("unrelated product %", item.value); }
