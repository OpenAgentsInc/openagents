#test "ordered destination values writes and whole-buffer guards" {
  counter := [3]int.[81,0,82];
  output := [4]int.[91,4,7,92];
  result := ordered_work(counter[1..<2],output[1..<3]);
  #assert result == 275;
  #assert output[0] == 91 && output[1] == 521 && output[2] == 7 && output[3] == 92;
  #assert counter[0] == 81 && counter[1] == 2 && counter[2] == 82;
}
next :: (counter:[]int) -> int { value:=counter[0]; counter[0]+=1; return value; }
ordered_work :: (counter:[]int,output:[]int) -> int {
  defer output[0]=output[0]*10+1;
  defer output[0]=output[0]*10+2;
  output[next(counter)]+=next(counter);
  return output[0]+output[1]*10+counter[0]*100;
}
