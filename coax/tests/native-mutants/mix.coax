// coax mutate --native against the evaluator (tests/native-mutants.coax).
// Kills by assertion, trap, ticks and refusal; survivors; a marked
// equivalent; and a #forall of 65 bindings, which the native check binary
// can't hold, so the mutants it reaches are judged whole only by the evaluator.
#import "Basic";
#authority;

clamp :: (x: int, lo: int, hi: int) -> int #effects(all) {
  if x < lo { return lo; } // mutant: equivalent
  if x > hi { return hi; }
  return x;
}
sum_to :: (n: int) -> int #effects(all) {
  s := 0;
  i := 0;
  while i < n { s += i; i += 1; }
  return s;
}
both :: (a: bool, b: bool) -> bool #effects(all) { return a && b; }
either :: (a: bool, b: bool) -> bool #effects(all) {
  if a || b { return true; } else if a { return false; }
  return false;
}
pick :: (v: [] int, i: int) -> int #effects(all) { return v[i] * 2 + 1; }
loud :: (x: int) -> int #effects(all) {
  if x > 100 { print("large\n"); }
  return x;
}
half :: (x: int) -> int #effects(all) { return x / 2; }
rest :: (x: int) -> int #effects(all) {
  if x > 3 { return x - 1; }
  return x;
}
shifted :: (x: u32, n: int) -> u32 #effects(all) { return (x << n) | 1; }

#test "clamp holds its ends" { #assert clamp(5, 0, 10) == 5 && clamp(-1, 0, 10) == 0 && clamp(11, 0, 10) == 10; }
#test "sum_to adds the numbers below n" { #assert sum_to(5) == 10 && sum_to(0) == 0; }
#forall "both is conjunction" a: bool, b: bool { #assert both(a, b) == (a && b); }
#test "either is true for one true side" { #assert either(true, false) && either(false, true) && !either(false, false); }
#test "pick reads and scales" { xs := [3] int.[1, 2, 3]; #assert pick(xs[..], 1) == 5 && pick(xs[..], 2) == 7; }
#test "loud is quiet for a small value" { #assert loud(3) == 3; }
#forall "half rounds down" x: 0..<4 { #assert half(x) * 2 <= x && half(x) * 2 + 1 >= x; }
// Sixty-five bindings are more than the native check binary holds: this check is the evaluator's.
#forall "half of nothing, with more bindings than native code takes" b00: 0..<1, b01: 0..<1, b02: 0..<1, b03: 0..<1, b04: 0..<1, b05: 0..<1, b06: 0..<1, b07: 0..<1, b08: 0..<1, b09: 0..<1, b10: 0..<1, b11: 0..<1, b12: 0..<1, b13: 0..<1, b14: 0..<1, b15: 0..<1, b16: 0..<1, b17: 0..<1, b18: 0..<1, b19: 0..<1, b20: 0..<1, b21: 0..<1, b22: 0..<1, b23: 0..<1, b24: 0..<1, b25: 0..<1, b26: 0..<1, b27: 0..<1, b28: 0..<1, b29: 0..<1, b30: 0..<1, b31: 0..<1, b32: 0..<1, b33: 0..<1, b34: 0..<1, b35: 0..<1, b36: 0..<1, b37: 0..<1, b38: 0..<1, b39: 0..<1, b40: 0..<1, b41: 0..<1, b42: 0..<1, b43: 0..<1, b44: 0..<1, b45: 0..<1, b46: 0..<1, b47: 0..<1, b48: 0..<1, b49: 0..<1, b50: 0..<1, b51: 0..<1, b52: 0..<1, b53: 0..<1, b54: 0..<1, b55: 0..<1, b56: 0..<1, b57: 0..<1, b58: 0..<1, b59: 0..<1, b60: 0..<1, b61: 0..<1, b62: 0..<1, b63: 0..<1, b64: 0..<1 {
  #assert half(b00 + b01 + b02 + b03 + b04 + b05 + b06 + b07 + b08 + b09 + b10 + b11 + b12 + b13 + b14 + b15 + b16 + b17 + b18 + b19 + b20 + b21 + b22 + b23 + b24 + b25 + b26 + b27 + b28 + b29 + b30 + b31 + b32 + b33 + b34 + b35 + b36 + b37 + b38 + b39 + b40 + b41 + b42 + b43 + b44 + b45 + b46 + b47 + b48 + b49 + b50 + b51 + b52 + b53 + b54 + b55 + b56 + b57 + b58 + b59 + b60 + b61 + b62 + b63 + b64) == 0 && rest(b00) == 0;
}
#test "rest keeps a small value and shortens a large one" { #assert rest(1) == 1 && rest(9) == 8; }
#test "shifted moves and marks" { #assert shifted(1, 3) == 9 && shifted(2, 0) == 3; }
main :: () { }
