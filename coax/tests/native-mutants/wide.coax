// A #forall of 65 bindings: more than the native check binary holds, so
// coax mutate --native has no check to emit and says so (tests/native-mutants.coax).
#import "Basic";
next :: (x: int) -> int #effects(all) { return x + 1; }
#forall "sixty-five bindings" b00: 0..<1, b01: 0..<1, b02: 0..<1, b03: 0..<1, b04: 0..<1, b05: 0..<1, b06: 0..<1, b07: 0..<1, b08: 0..<1, b09: 0..<1, b10: 0..<1, b11: 0..<1, b12: 0..<1, b13: 0..<1, b14: 0..<1, b15: 0..<1, b16: 0..<1, b17: 0..<1, b18: 0..<1, b19: 0..<1, b20: 0..<1, b21: 0..<1, b22: 0..<1, b23: 0..<1, b24: 0..<1, b25: 0..<1, b26: 0..<1, b27: 0..<1, b28: 0..<1, b29: 0..<1, b30: 0..<1, b31: 0..<1, b32: 0..<1, b33: 0..<1, b34: 0..<1, b35: 0..<1, b36: 0..<1, b37: 0..<1, b38: 0..<1, b39: 0..<1, b40: 0..<1, b41: 0..<1, b42: 0..<1, b43: 0..<1, b44: 0..<1, b45: 0..<1, b46: 0..<1, b47: 0..<1, b48: 0..<1, b49: 0..<1, b50: 0..<1, b51: 0..<1, b52: 0..<1, b53: 0..<1, b54: 0..<1, b55: 0..<1, b56: 0..<1, b57: 0..<1, b58: 0..<1, b59: 0..<1, b60: 0..<1, b61: 0..<1, b62: 0..<1, b63: 0..<1, b64: 0..<1 {
  #assert next(b00 + b01 + b02 + b03 + b04 + b05 + b06 + b07 + b08 + b09 + b10 + b11 + b12 + b13 + b14 + b15 + b16 + b17 + b18 + b19 + b20 + b21 + b22 + b23 + b24 + b25 + b26 + b27 + b28 + b29 + b30 + b31 + b32 + b33 + b34 + b35 + b36 + b37 + b38 + b39 + b40 + b41 + b42 + b43 + b44 + b45 + b46 + b47 + b48 + b49 + b50 + b51 + b52 + b53 + b54 + b55 + b56 + b57 + b58 + b59 + b60 + b61 + b62 + b63 + b64) == 1;
}
