// Test helpers for coax/lib/nostr/agent/definition.coax: payloads built
// from one spec with one field's text replaced. Kept apart so root-only
// mutation of the library mutates the reader, not these builders.
AT_ID :: "4f1c6c3a2b0e5d7f8a9b0c1d2e3f405162738495a6b7c8d9e0f1a2b3c4d5e6f7";
AT_SPEC :: "{\"name\":\"Triage\",\"description\":\"Sorts new issues\",\"instructions\":\"Label each new issue.\",\"runtime\":\"codex\",\"model\":null,\"access\":\"read_only\"}";
at_payload :: (spec:string,out:[]u8)->string {
  n:=json_raw(out,0,"{\"schema\":\"openagents.agent.definition.v1\",\"definition\":{\"id\":\"");
  n=json_raw(out,n,AT_ID);n=json_raw(out,n,"\",\"revision\":3,\"spec\":");n=json_raw(out,n,spec);
  n=json_raw(out,n,",\"deleted\":false}}");return cast(string)out[0..<n];
}
at_read :: (payload:string)->AgentDefinition {
  store:[4096]u8;a:=[1]AgText.[AgText.{buf=store[..]}];return agent_read(payload,a[..]);
}
// The spec with one field's text replaced: old must occur once.
at_spec :: (old:string,new:string,out:[]u8)->string {
  s:=AT_SPEC;at:=-1;
  for i:0..<s.count-old.count+1 {if at<0 && s[i..<i+old.count]==old {at=i;}}
  n:=json_raw(out,0,s[0..<at]);n=json_raw(out,n,new);n=json_raw(out,n,s[at+old.count..<s.count]);
  return cast(string)out[0..<n];
}
at_field :: (old:string,new:string)->u32 {
  sb:[1024]u8;pb:[2048]u8;return at_read(at_payload(at_spec(old,new,sb[..]),pb[..])).error;
}
at_spec_read :: (spec:string)->AgentDefinition {pb:[2048]u8;return at_read(at_payload(spec,pb[..]));}

at_build :: (n:int,big:[]u8)->string {
  m:=json_raw(big,0,"{\"name\":\"T\",\"description\":\"\",\"instructions\":\"");
  for i:0..<n {big[m+i]='i';}m+=n;
  m=json_raw(big,m,"\",\"runtime\":\"r\",\"model\":null,\"access\":\"read_only\"}");return cast(string)big[0..<m];
}
at_fb :: (list:string)->u32 {
  s:[1024]u8;n:=json_raw(s[..],0,"{\"name\":\"T\",\"description\":\"\",\"instructions\":\"x\",\"runtime\":\"codex\",\"model\":null,\"access\":\"read_only\",\"fallbacks\":");
  n=json_raw(s[..],n,list);n=json_raw(s[..],n,"}");return at_spec_read(cast(string)s[0..<n]).error;
}
at_au :: (obj:string)->u32 {
  s:[1024]u8;n:=json_raw(s[..],0,"{\"name\":\"T\",\"description\":\"\",\"instructions\":\"x\",\"runtime\":\"codex\",\"model\":null,\"access\":\"read_only\",\"autonomy\":");
  n=json_raw(s[..],n,obj);n=json_raw(s[..],n,"}");return at_spec_read(cast(string)s[0..<n]).error;
}
AT_DEF :: "{\"id\":\"4f1c6c3a2b0e5d7f8a9b0c1d2e3f405162738495a6b7c8d9e0f1a2b3c4d5e6f7\",\"revision\":1,\"spec\":{\"name\":\"T\",\"description\":\"\",\"instructions\":\"x\",\"runtime\":\"r\",\"model\":null,\"access\":\"read_only\"},\"deleted\":false}";
AT_FORK :: ",\"forked_from\":{\"published\":\"4f1c6c3a2b0e5d7f8a9b0c1d2e3f405162738495a6b7c8d9e0f1a2b3c4d5e6f7\",\"revision\":1}";
AT_DUP :: [5]string.[",\"id\":\"4f1c6c3a2b0e5d7f8a9b0c1d2e3f405162738495a6b7c8d9e0f1a2b3c4d5e6f7\"}",",\"revision\":1}",",\"spec\":{\"name\":\"T\",\"description\":\"\",\"instructions\":\"x\",\"runtime\":\"r\",\"model\":null,\"access\":\"read_only\"}}",",\"deleted\":false}",",\"ids\":\"x\"}"];
// head, then AT_DEF (whole, or without its closing brace and then mid), then tail.
at_join :: (head:string,whole:bool,mid:string,tail:string,q:[]u8)->string {
  n:=json_raw(q,0,head);
  n=json_raw(q,n,ifx whole then AT_DEF else AT_DEF[0..<AT_DEF.count-1]);
  n=json_raw(q,n,mid);n=json_raw(q,n,tail);return cast(string)q[0..<n];
}
AT_HEAD :: "{\"schema\":\"openagents.agent.definition.v1\",\"definition\":";
