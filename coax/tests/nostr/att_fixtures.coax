at_endpoint_test :: (out:[]u8,token:string)->string {
  n:=json_raw(out,0,"{\"binding\":\"");n=json_raw(out,n,AT_BINDING);n=json_raw(out,n,"\",\"endpoint\":\"");n=json_raw(out,n,AT_K3);
  n=json_raw(out,n,"\",\"evidence\":[{\"format\":\"pki\",\"kind\":\"gcp-confidential-space-token\",\"token\":\"");n=json_raw(out,n,token);
  n=json_raw(out,n,"\"}],\"hpke\":null,\"issued_at\":1791999940,\"operator\":\"");n=json_raw(out,n,AT_K1);
  n=json_raw(out,n,"\",\"release\":\"");n=json_raw(out,n,AT_RID);n=json_raw(out,n,"\",\"requires\":[],\"v\":\"openagents.att-endpoint.v1\",\"valid_until\":1792003540}");
  return cast(string)out[0..<n];
}
at_good_test :: ()->AtVerdict {
  r:=at_release_read(AT_K1,AT_RELEASE_TAGS,AT_RELEASE,AT_X);h:=at_head_read(AT_K1,AT_HEAD_TAGS,AT_HEAD);
  tb:[2048]u8;eb:[4096]u8;e:=at_endpoint_read(AT_K3,AT_EP_TAGS,at_endpoint_test(eb[..],at_token_test(tb[..],AT_CLAIMS)));
  return at_verify(AT_RID,r,AT_K1,h,0,e,AT_T0);
}

at_uint_test :: (text:string)->int {j:[1]Json;json_start(j[..],text);t:=json_next(j[..]);return at_uint(j[..],t);}
