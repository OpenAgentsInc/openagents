// A copy of text with the first occurrence of from replaced by to.
at_case :: (out:[]u8,text:string,from:string,to:string)->string {
  at:=-1;i:=0;while at<0 && i+from.count<=text.count {if text[i..<i+from.count]==from {at=i;}i+=1;}
  #assert at>=0;
  n:=json_raw(out,0,text[0..<at]);n=json_raw(out,n,to);n=json_raw(out,n,text[at+from.count..<text.count]);
  return cast(string)out[0..<n];
}
// The claims of a test token: header and signature parts are not read.
at_token_test :: (out:[]u8,claims:string)->string {
  b:[2048]u8;r:=base64_encode_checked(claims,b[..],false);
  n:=json_raw(out,0,"eyJhbGciOiJSUzI1NiJ9.");
  for i:0..<r.written {c:=b[i];if c=='=' {break;}out[n]=ifx c=='+' then cast(u8)'-' else ifx c=='/' then cast(u8)'_' else c;n+=1;}
  n=json_raw(out,n,".c2ln");return cast(string)out[0..<n];
}
