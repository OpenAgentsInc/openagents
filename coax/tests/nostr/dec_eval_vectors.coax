  "{\n  \"state\": {\n    \"task\": \"Add retry with backoff to the HTTP client.\",\n    \"a\": {\"summary\": \"Wraps every call in a loop with a fixed 1 s sleep, 3 tries.\", \"tests_added\": 0},\n    \"b\": {\"summary\": \"Adds exponential backoff with jitter for 5xx and timeouts only, 4 tries, and tests.\", \"tests_added\": 3}\n  },\n  \"questions\": {\n    \"better\": {\n      \"type\": \"choice\",\n      \"instructions\": {\n        \"question\": \"Which patch better does the task?\",\n        \"compare\": [\"a\", \"b\"],\n        \"focus\": [\"correctness for non-retryable errors\", \"test coverage\"]\n      },\n      \"criteria\": {\"a\": \"Patch a is better.\", \"b\": \"Patch b is better.\", \"tie\": \"Neither is clearly better.\"}\n    }\n  }\n}\n",
  "{\n  \"state\": \"INVOICE #4471\\nAcme Tooling GmbH\\nBill to: Northwind Ltd\\nPO: NW-2291\\nTotal due: EUR 1,240.00 by 2026-10-15\",\n  \"questions\": {\n    \"currency\": {\n      \"type\": \"choice\",\n      \"instructions\": {\n        \"field\": {\"name\": \"total_due\", \"meaning\": \"The amount the buyer owes on this invoice, after tax.\", \"where\": \"Usually the last money line.\"},\n        \"question\": \"Which currency is the field in?\"\n      },\n      \"criteria\": {\"EUR\": \"Euro\", \"USD\": \"US dollar\", \"GBP\": \"Pound sterling\", \"other\": \"Any other currency, or none is shown.\"}\n    },\n    \"present\": {\n      \"type\": \"noul\",\n      \"instructions\": {\n        \"field\": {\"name\": \"total_due\", \"meaning\": \"The amount the buyer owes on this invoice, after tax.\", \"where\": \"Usually the last money line.\"},\n        \"question\": \"Does the invoice state the field explicitly?\"\n      }\n    },\n    \"has_po\": {\n      \"type\": \"noul\",\n      \"instructions\": {\n        \"field\": {\"name\": \"purchase_order\", \"meaning\": \"The buyer's purchase-order reference.\", \"where\": \"Near the bill-to block.\"},\n        \"question\": \"Does the invoice state the field explicitly?\"\n      }\n    }\n  }\n}\n",
  "{\n  \"state\": {\n    \"channel\": \"support email\",\n    \"message\": \"I was charged twice for my March invoice. Please send the extra $49 back to my card.\",\n    \"account\": {\"plan\": \"team\", \"seats\": 12}\n  },\n  \"questions\": {\n    \"queue\": {\n      \"type\": \"choice\",\n      \"instructions\": \"Which queue should handle this message?\",\n      \"criteria\": {\n        \"billing\": {\n          \"what\": \"Charges, invoices, refunds, and payment methods.\",\n          \"not_for\": \"Questions about plan features or seat limits.\",\n          \"examples\": [\"I was billed twice\", \"Update my card\"]\n        },\n        \"technical\": {\n          \"what\": \"Something in the product is broken or behaves unexpectedly.\",\n          \"not_for\": \"Money questions, even when a bug caused them.\",\n          \"examples\": [\"The export button does nothing\", \"Login loops\"]\n        },\n        \"sales\": {\n          \"what\": \"Buying more, upgrading, or pricing for a new purchase.\",\n          \"not_for\": \"Disputes about money already paid.\",\n          \"examples\": [\"Can we add 20 seats?\", \"Do you have an annual plan?\"]\n        }\n      }\n    }\n  }\n}\n",
  "{\n  \"state\": \"Checkout has returned HTTP 500 for every user in the EU region for twenty minutes. Retries fail.\",\n  \"questions\": {\n    \"severity\": {\n      \"type\": \"score\",\n      \"instructions\": \"How severe is this incident?\",\n      \"criteria\": [\n        {\"summary\": \"Cosmetic\", \"signals\": [\"typo\", \"misaligned layout\", \"no user blocked\"]},\n        {\"summary\": \"Degraded\", \"signals\": [\"slow responses\", \"a workaround exists\"]},\n        {\"summary\": \"Major\", \"signals\": [\"one feature fails for many users\", \"no workaround\"]},\n        {\"summary\": \"Critical\", \"signals\": [\"revenue path down\", \"a whole region affected\", \"data at risk\"]}\n      ]\n    }\n  }\n}\n",
  "{\n  \"state\": \"cargo test ran 3 tests: 3 passed, 0 failed.\",\n  \"questions\": {\n    \"passed\": {\"type\": \"noul\", \"instructions\": \"Did every test pass?\"},\n    \"next\": {\n      \"type\": \"choice\",\n      \"instructions\": \"What should happen next?\",\n      \"criteria\": {\"ship\": \"Merge the change.\", \"fix\": \"Change the code first.\"}\n    },\n    \"risk\": {\n      \"type\": \"score\",\n      \"instructions\": \"How risky is merging now?\",\n      \"criteria\": [\"No risk.\", \"Some risk.\", \"High risk.\"]\n    }\n  }\n}\n",
  "{\n  \"state\": {\"message\": \"Why was I charged $49 on March 3rd? I don't recognize it.\"},\n  \"questions\": {\n    \"refund\": {\n      \"type\": \"noul\",\n      \"instructions\": \"Does the customer ask for money back?\",\n      \"criteria\": {\n        \"true\": {\n          \"what\": \"The message asks for a refund, credit, or reversal of a charge.\",\n          \"examples\": [\"Please refund the duplicate charge\", \"Credit my account\"]\n        },\n        \"false\": {\n          \"what\": \"The message asks for anything else, including an explanation of a charge.\",\n          \"examples\": [\"Why was I charged $49?\", \"Send me the invoice PDF\"]\n        }\n      }\n    }\n  }\n}\n",
