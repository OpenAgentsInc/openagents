// Test-only access to the experimental fused arithmetic.
#load "../../lib/crypto/ecdh_fast.coax";
ef_test_add :: (a:Sf32,b:Sf32)->Sf32 #export_c {return ef_field_add(a,b);}
ef_test_mul :: (a:Sf32,b:Sf32)->Sf32 #export_c {return ef_field_mul(a,b);}
ef_test_inverse :: (a:Sf32)->Sf32 #export_c {return ef_inverse(a);}
