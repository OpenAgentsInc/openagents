// Complete conformance checks retained after imported shared checks.
#test "canonical preimage and computed ID use exact decoded fields" {
  out:[1024]u8;e:=nostr_event_read(NE_FIXTURE,out[..],false);
  #assert e.error==NE_OK && !e.verified && e.written==NE_PREIMAGE.count;
  #assert cast(string)out[0..<e.written]==NE_PREIMAGE && e.original==NE_FIXTURE;
  #assert e.kind==1 && e.created_at==0 && e.tags==3;
  h:[64]u8;r:=hex_encode_checked(cast(string)e.computed_id[..],h[..],false);
  #assert r.error==NC_OK && cast(string)h[..]==NE_FIXTURE_ID;
  decoded:[64]u8;count:=json_unescape(e.original[e.content_from..<e.content_to],decoded[..]);
  expected:=[16]u8.[97,34,92,10,13,9,8,12,0,195,169,240,159,152,128,47];
  #assert count==16;for i:0..<16 {#assert decoded[i]==expected[i];}
  bad:=nostr_event_verify_vartime(NE_FIXTURE,out[..],false);
  #assert bad.error==NE_SIGNATURE && !bad.verified && bad.written==0;
  #assert nostr_event_read(NE_FIXTURE,out[0..<1],false).error==NE_OUTPUT;
}

#forall "required shapes and decoded duplicate keys refuse" i:0..<NE_BAD_EVENTS.count {
  e:=ne_parse(NE_BAD_EVENTS[i]);#assert e.error==NE_BAD_ERRORS[i] && !e.verified && e.written==0;
}

#test "unknown fields and wire spellings are retained without entering the ID" {
  out:[1024]u8;e:=nostr_event_read(NE_UNKNOWN,out[..],false);
  #assert e.error==NE_OK && e.original==NE_UNKNOWN && e.written==NE_PREIMAGE.count;
  #assert cast(string)out[0..<e.written]==NE_PREIMAGE && !e.verified;
  wrong:=ne_parse(NE_FIXTURE);wrong.id[0]^=1;#assert !ne_same_id(wrong);
}

#test "empty content and tag list serialize while malformed internal text refuses" {
  out:[1024]u8;e:=nostr_event_read(NE_EMPTY,out[..],false);
  #assert e.error==NE_OK && e.written==NE_EMPTY_PREIMAGE.count && e.tags==0 && e.kind==0;
  #assert cast(string)out[0..<e.written]==NE_EMPTY_PREIMAGE;
  broken:NostrEvent;broken.original="[]\\ud800";broken.tags_to=2;broken.content_from=2;broken.content_to=8;
  #assert ne_serialize(broken,out[..])<0;
}

#test "nonzero safe timestamp is hashed and wrong advertised ID is refused" {
  out:[1024]u8;e:=nostr_event_read(NE_MAXIMUM,out[..],false);
  #assert e.error==NE_OK && e.created_at==JA_SAFE && e.kind==65535;
  #assert e.written==NE_MAXIMUM_PREIMAGE.count && cast(string)out[0..<e.written]==NE_MAXIMUM_PREIMAGE;
  bad:=nostr_event_read(NE_WRONG_ID,out[..],false);
  #assert bad.error==NE_ID && !bad.verified && bad.written==0;
}
