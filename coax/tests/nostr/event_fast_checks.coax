// Focused checks run early; the complete imported graph and conformance checks remain loaded.
#load "event_fixtures.coax";

#test "field names decode escapes and remain exact" {
  names:=[7]string.["id","pubkey","created_at","kind","tags","content","sig"];
  for i:0..<7 {#assert ne_field(names[i])==i+1;}
  #assert ne_field("\\u0069d")==1 && ne_field("Id")==0 && ne_field("unknown")==0 && ne_field("")==0;
}

#test "strict event hex narrows the generic codec" {
  out:[2]u8;
  #assert ne_lower_hex("01af",out[..]) && out[0]==1 && out[1]==175;
  #assert !ne_lower_hex("01AF",out[..]) && !ne_lower_hex("01ag",out[..]);
  #assert !ne_lower_hex("01",out[..]) && !ne_lower_hex("01afff",out[..]);
}

#forall "the additional hex admission excludes exactly uppercase A through F" c:0..<256,place:0..<2 {
  raw:=[2]u8.[48,48];raw[place]=cast(u8)c;out:[1]u8;
  allowed:=(c>=48 && c<=57) || (c>=97 && c<=102);
  #assert ne_lower_hex(cast(string)raw[..],out[..])==allowed;
}

#test "tag shape, empty positions and exact bounded cardinalities" {
  j:[1]Json;
  json_start(j[..],"[[],[\"x\",\"a\"]]");#assert json_next(j[..])!=JSON_ERROR;
  tags:=ne_tags(j[..]);#assert tags.ok && tags.count==2 && tags.from==0 && tags.to==14;
  json_start(j[..],"{}");#assert json_next(j[..])!=JSON_ERROR;#assert !ne_tags(j[..]).ok;
  json_start(j[..],"[\"x\"]");#assert json_next(j[..])!=JSON_ERROR;#assert !ne_tags(j[..]).ok;
  json_start(j[..],"[[1]]");#assert json_next(j[..])!=JSON_ERROR;#assert !ne_tags(j[..]).ok;
  json_start(j[..],NE_MANY_TAGS);#assert json_next(j[..])!=JSON_ERROR;#assert ne_tags(j[..]).ok;
  json_start(j[..],NE_TOO_MANY_TAGS);#assert json_next(j[..])!=JSON_ERROR;#assert !ne_tags(j[..]).ok;
  json_start(j[..],"[[\"a\",\"b\",\"c\",\"d\",\"e\",\"f\",\"g\",\"h\",\"i\",\"j\",\"k\",\"l\",\"m\",\"n\",\"o\",\"p\"]]");#assert json_next(j[..])!=JSON_ERROR;#assert ne_tags(j[..]).ok;
  json_start(j[..],"[[\"a\",\"b\",\"c\",\"d\",\"e\",\"f\",\"g\",\"h\",\"i\",\"j\",\"k\",\"l\",\"m\",\"n\",\"o\",\"p\",\"q\"]]");#assert json_next(j[..])!=JSON_ERROR;#assert !ne_tags(j[..]).ok;
}

#test "serializer preserves order and uses the shared exact JSON writer" {
  out:[128]u8;decoded:[128]u8;
  n:=ne_write_tags("[[],[\"a\",\"\\u00e9\"],[\"a\",\"/\\n\"]]",out[..],0,decoded[..]);
  #assert n==27 && cast(string)out[0..<n]=="[[],[\"a\",\"é\"],[\"a\",\"/\\n\"]]";
  #assert ne_write_tags("{}",out[..],0,decoded[..])==-1;
  #assert ne_write_tags("[1]",out[..],0,decoded[..])==-1;
  #assert ne_write_tags("[[1]]",out[..],0,decoded[..])==-1;
  #assert ne_write_tags("[[\"abc\"]]",out[..],0,decoded[0..<1])==-1;
  #assert ne_write_tags("[[\"abc\"]]",out[0..<1],0,decoded[..])==-1;
  empty:=ne_write_tags("[[\"\"]]",out[..],0,decoded[..]);
  #assert empty==6 && cast(string)out[0..<empty]=="[[\"\"]]";
  empty=ne_write_tags("[[\"\",\"x\",\"\"]]",out[..],0,decoded[..]);
  #assert empty==13 && cast(string)out[0..<empty]=="[[\"\",\"x\",\"\"]]";
}

#test "no metadata record itself grants verification or freshness" {
  e:NostrEvent;e.error=NE_OK;e.written=7;
  #assert !e.verified;
  valid:=ne_verified(e,true);#assert valid.verified && valid.error==NE_OK && valid.written==7;
  invalid:=ne_verified(e,false);#assert !invalid.verified && invalid.error==NE_SIGNATURE && invalid.written==0;
  #assert ne_same_id(e);e.id[31]=1;#assert !ne_same_id(e);
}

#test "entry refusal precedes output access and never grants verification" {
  out:[1]u8;out[0]=77;
  #assert nostr_event_read("{}",out[..],true).error==NE_ALIAS;
  #assert nostr_event_read("{",out[..],false).error==NE_JSON;
  #assert nostr_event_read("{",out[..],false).admission==JA_JSON;
  #assert nostr_event_read("{\"x\":1,\"x\":2}",out[..],false).admission==JA_DUPLICATE;
  #assert nostr_event_read("{}",out[..],false).error==NE_SHAPE;
  #assert nostr_event_verify_vartime("{}",out[..],false).error==NE_SHAPE;
  #assert out[0]==77;
}

#test "truthful view metadata enforces the independent inclusive budgets" {
  #assert NE_MAX_INPUT==ja_policy(0).input;
  #assert ne_io(0,0,false)==NE_OK && ne_io(NE_MAX_INPUT,NE_MAX_OUTPUT,false)==NE_OK;
  #assert ne_io(-1,0,false)==NE_LIMIT && ne_io(NE_MAX_INPUT+1,0,false)==NE_LIMIT;
  #assert ne_io(0,-1,false)==NE_OUTPUT && ne_io(0,NE_MAX_OUTPUT+1,false)==NE_OUTPUT;
  #assert ne_io(-1,-1,true)==NE_ALIAS;
}

#forall "every ID byte participates in exact equality" i:0..<32 {
  e:NostrEvent;e.id[i]=1;#assert !ne_same_id(e);
  e.computed_id[i]=1;#assert ne_same_id(e);
}

#test "hash outcome composition uses real success and refusal statuses" {
  input:=[1]u8.[1];digest:[32]u8;e:NostrEvent;e.error=NE_OK;
  status:=sha256_hash_checked(input[..],digest[..],false);
  #assert status==SHA_OK && ne_hashed(e,status).error==NE_OK;
  status=sha256_hash_checked(input[..],digest[0..<31],false);
  #assert status==SHA_BAD_OUTPUT && ne_hashed(e,status).error==NE_OUTPUT;
  status=sha256_hash_checked(input[..],digest[..],true);
  #assert status==SHA_ALIAS && ne_hashed(e,status).error==NE_OUTPUT;
}

#test "codec outcomes start a healthy or sticky-failed writer" {
  out:[8]u8;
  good:=hex_encode_checked("abc",out[..],false);
  #assert good.error==NC_OK && ne_writer_start(good.error)==0;
  short:=hex_encode_checked("abc",out[0..<1],false);
  #assert short.error==NC_CAPACITY && ne_writer_start(short.error)==NE_WRITE_FAILED;
  alias:=hex_encode_checked("abc",out[..],true);
  #assert alias.error==NC_ALIAS && ne_writer_start(alias.error)==NE_WRITE_FAILED;
  #assert json_raw(out[..],ne_writer_start(short.error),"x")==NE_WRITE_FAILED;
}

#test "complete read smoke retains exact bytes before shared conformance checks" {
  out:[1024]u8;e:=nostr_event_read(NE_FIXTURE,out[..],false);
  #assert e.error==NE_OK && !e.verified && e.written==NE_PREIMAGE.count;
  #assert cast(string)out[0..<e.written]==NE_PREIMAGE && e.original==NE_FIXTURE;
  e=nostr_event_read(NE_UNKNOWN,out[..],false);
  #assert e.error==NE_OK && e.tags==3 && cast(string)out[0..<e.written]==NE_PREIMAGE;
}
