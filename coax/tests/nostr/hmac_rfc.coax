// RFC 4231 SHA-256 cases1-7. Source: tests/vectors/upstream/rfc/rfc4231.txt.
// Expected values are published data; case5 specifies only the first16 bytes.
#test "RFC4231 SHA256 case1" {
  key:=[20]u8.[11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11];
  message:=[8]u8.[72,105,32,84,104,101,114,101];
  expected:=[32]u8.[176,52,76,97,216,219,56,83,92,168,175,206,175,11,241,43,136,29,194,0,201,131,61,167,38,233,55,108,46,50,207,247];
  out:[40]u8;for i:0..<40 {out[i]=165;}
  #assert hmac_sha256_checked(key[..],message[..],out[..],false)==SHA_OK;
  for i:0..<32 {#assert out[i]==expected[i];}
  for i:32..<40 {#assert out[i]==165;}
}
