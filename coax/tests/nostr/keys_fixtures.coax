ky_spk :: (h:string)->KyScript {r:KyScript;for i:0..<h.count/2 {r.b[i]=cast(u8)(ky_nib(h[2*i])*16+ky_nib(h[2*i+1]));}r.n=h.count/2;return r;}
ky_fixture_scripts :: ()->KyScripts {r:KyScripts;for i:0..<4 {r.s[i]=ky_spk(KY_SPK[i]);}return r;}
// Each agent's change branch key (account/1): chain code, then public key (Python).
KY_BRANCH1 :: [6] string.["2dc6ab75d1dc53af9902d97cecbc33ec9f2d6dd48c9747b74e1bf0a204f46774","02390e0f6e7e9434464e61770bd5c4ea6980e4d3c430db0e35f6d529b4504d10cb",
  "ad3318df3e73bc6320fdfbdd64ef483d277bece749ede75634e1b50020922598","036c4d421dfebc2601605be9b860d5b31cece3cebef763bfeec717b411d7da6b9f",
