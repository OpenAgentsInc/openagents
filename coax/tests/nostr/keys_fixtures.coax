KY_SPK :: [4] string.["0020187ef2ba1a2f4237094fa0f25106d3af890c8b8e7170d4f78ac27b3e776d2f6f","0020555087554c5b26875af655966e01efc934bb760f4fc951f585f1f39f9f0f7b87","0020108dd2a02dce6bec96de704f7383e5b9c94e8fa489efa12b939de5777ab2009f","002010709ca9f91bc4f8294ba4e9c08b459d79e4f3a07ea21d104e3b3a8849f857b0"];
