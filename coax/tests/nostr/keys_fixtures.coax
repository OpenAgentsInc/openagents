// The three enrollments and declarations, read.
KyParties :: struct {e:[3]KyEnrollment;ind:[3]KyIndependence;}
ky_parties :: ()->KyParties {
  r:KyParties;
  r.e[0]=ky_enrollment_read(KY_AGENT0,KY_ENR0);r.e[1]=ky_enrollment_read(KY_AGENT1,KY_ENR1);r.e[2]=ky_enrollment_read(KY_AGENT2,KY_ENR2);
  r.ind[0]=ky_independence_read(KY_AGENT0,KY_IND0);r.ind[1]=ky_independence_read(KY_AGENT1,KY_IND1);r.ind[2]=ky_independence_read(KY_AGENT2,KY_IND2);
  return r;
}
ky_hexs :: (d:[]u8,out:[]u8)->string {
  hx:="0123456789abcdef";
  for i:0..<d.count {out[2*i]=hx[cast(int)(d[i]>>4)];out[2*i+1]=hx[cast(int)(d[i]&15)];}
  return cast(string)out[0..<2*d.count];
}
ky_contains :: (s:string,part:string)->bool {for i:0..<s.count-part.count+1 {if s[i..<i+part.count]==part {return true;}}return false;}
// The wallet's scripts at receive 0, 1 and change 0, 1 (Python), and a
// one-key wallet's (alice alone, 1-of-1).
KY_SPK :: [4] string.["0020187ef2ba1a2f4237094fa0f25106d3af890c8b8e7170d4f78ac27b3e776d2f6f","0020555087554c5b26875af655966e01efc934bb760f4fc951f585f1f39f9f0f7b87","0020108dd2a02dce6bec96de704f7383e5b9c94e8fa489efa12b939de5777ab2009f","002010709ca9f91bc4f8294ba4e9c08b459d79e4f3a07ea21d104e3b3a8849f857b0"];
