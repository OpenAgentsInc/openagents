ky_branch1 :: (i:int)->KyExtKey {
  r:KyExtKey;c:=KY_BRANCH1[2*i];k:=KY_BRANCH1[2*i+1];
  for j:0..<32 {r.chain[j]=cast(u8)(ky_nib(c[2*j])*16+ky_nib(c[2*j+1]));}
  for j:0..<33 {r.key[j]=cast(u8)(ky_nib(k[2*j])*16+ky_nib(k[2*j+1]));}
  r.version=KY_TPUB;r.ok=true;return r;
}
