// Boundaries of fields introduced by the MP Project profile itself.
#test "MP project scalar wire, uniqueness, UTF-8 and exact byte caps" {
 nums:=[5]u8.[2,3,4,6,7];caps:=[5]int.[1024,256,2048,256,256];bytes:[2052]u8;
 for i:0..<5 {
  for k:0..<bytes.count {bytes[k]=97;}bytes[0]=nums[i]*8+2;bytes[1]=128;bytes[2]=cast(u8)(caps[i]/128);
  #assert MP_Project__check(bytes[0..<caps[i]+3],0,1,false,false).error==0;
  bytes[1]=129;#assert MP_Project__check(bytes[0..<caps[i]+4],0,1,false,false).error==MP__pb_LIMIT;
  bytes[0]=nums[i]*8;bytes[1]=0;#assert MP_Project__check(bytes[0..<2],0,1,false,false).error==MP__pb_WIRE;
  bytes[0]=nums[i]*8+2;bytes[1]=1;bytes[2]=255;#assert MP_Project__check(bytes[0..<3],0,1,false,false).error==MP__pb_UTF8;
  bytes[1]=0;bytes[2]=bytes[0];bytes[3]=0;#assert MP_Project__check(bytes[0..<4],0,2,false,false).error==MP__pb_DUPLICATE;
 }
}
#test "MP project member cap and child fields" {
 members:[325]u8;for i:0..<65 {k:=i*5;members[k]=42;members[k+1]=3;members[k+2]=10;members[k+3]=1;members[k+4]=120;}
 #assert MP_Project__check(members[0..<320],0,128,false,false).error==0;
 #assert MP_Project__check(members[..],0,130,false,false).error==MP__pb_LIMIT;
 empty:[1]u8;#assert MP_RepositoryMember_decode(empty[0..<0]).error==MP__pb_REQUIRED;
 malformed:=[3]u8.[10,1,255];#assert MP_RepositoryMember_decode(malformed[..]).error==MP__pb_UTF8;
 duplicate:=[6]u8.[10,1,120,10,1,121];#assert MP_RepositoryMember_decode(duplicate[..]).error==MP__pb_DUPLICATE;
 wrong:=[2]u8.[8,0];#assert MP_RepositoryMember_decode(wrong[..]).error==MP__pb_WIRE;
}
