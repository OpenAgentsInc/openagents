  for j:0..<32 {#assert ab[j]==ba[j] && ab[j]==ck[j];}
  #assert nip44_encrypt_work_size(NIP44_COMPAT,1)==133 && nip44_payload_size(NIP44_COMPAT,1)==132;
  ework:[133]u8;sealed:[132]u8;
  e:=nip44_encrypt_checked(NIP44_COMPAT,ab[..],nonce[..],plain[..],ework[..],sealed[..],false);
  #assert e.error==NIP44_OK && e.written==132;
  for j:0..<132 {#assert sealed[j]==payload[j];}
  dwork:[133]u8;back:[2]u8;back[1]=165;
  d:=nip44_decrypt_checked(NIP44_COMPAT,ba[..],cast(string)payload[..],dwork[..],back[..],false);
  #assert d.error==NIP44_OK && d.written==1 && back[1]==165;
  for j:0..<1 {#assert back[j]==plain[j];}
}
