// Long-message and extended-prefix boundary fixtures for nip44.coax. Kept
// out of nip44.coax's own check graph so its mutation gate stays fast:
//   coax/bin/coax test coax/tests/nostr/nip44_long.coax --library --steps 4000000000
// Sources: encrypt_decrypt_long_msg (tests/vectors/upstream/nip44/nip44.vectors.json)
// and the pinned NIP's extended-length table (tests/vectors/upstream/nips/44.md,
// indexed in tests/vectors/derived/catalog.json "nip44_extended").
#load "../../lib/nostr/nip44.coax";
LONG_WORK :: 163917;
LONG_CHARS :: 109324;
long_case :: (profile:u32,ck:[]u8,nonce:[]u8,pattern:[]u8,repeat:int,plain_sha:[]u8,payload_sha:[]u8)->u32 {
  n:=pattern.count*repeat;
  plain:[65537]u8;for i:0..<n {plain[i]=pattern[i%pattern.count];}
  digest:[32]u8;
  if sha256_hash_checked(plain[0..<n],digest[..],false)!=SHA_OK {return 100;}
  if cb_ct_equal(digest[..],plain_sha)!=CB_MAX64 {return 101;}
  work:[LONG_WORK]u8;for i:0..<LONG_WORK {work[i]=165;}
  out:[LONG_CHARS]u8;
  r:=nip44_encrypt_checked(profile,ck,nonce,plain[0..<n],work[..],out[..],false);
  if r.error!=NIP44_OK {return r.error;}
  if r.written!=nip44_payload_size(profile,n) {return 102;}
  if sha256_hash_checked(out[0..<r.written],digest[..],false)!=SHA_OK {return 103;}
  if cb_ct_equal(digest[..],payload_sha)!=CB_MAX64 {return 104;}
  dwork:[LONG_WORK+8]u8;back:[65537]u8;
  d:=nip44_decrypt_checked(profile,ck,cast(string)out[0..<r.written],dwork[..],back[..],false);
  if d.error!=NIP44_OK {return d.error;}
  if d.written!=n || cb_ct_equal(back[0..<n],plain[0..<n])!=CB_MAX64 {return 105;}
  return 0;
}

#test "NIP-44 encrypt_decrypt_long_msg upstream row 0 (65535 bytes)" {
  ck:=[32]u8.[143,194,98,9,156,224,208,187,155,137,186,192,91,185,224,79,155,192,9,10,204,24,31,239,104,64,204,238,71,3,113,237];nonce:=[32]u8.[50,107,203,44,148,60,214,187,113,117,136,201,229,167,231,56,237,246,237,20,236,95,83,68,202,166,239,86,240,185,207,247];pattern:=[1]u8.[120];
  ps:=[32]u8.[9,171,116,149,211,230,26,118,240,222,177,44,176,48,111,6,150,203,177,127,252,18,19,19,104,199,169,57,241,47,86,211];ys:=[32]u8.[144,113,68,146,34,95,171,160,99,16,191,242,242,73,235,220,42,94,96,157,101,166,41,241,200,127,45,79,252,85,51,10];
  #assert long_case(NIP44_COMPAT,ck[..],nonce[..],pattern[..],65535,ps[..],ys[..])==0;
  #assert long_case(NIP44_EXTENDED,ck[..],nonce[..],pattern[..],65535,ps[..],ys[..])==0;
}
