// Fixtures for nip54.coax's checks: the ranges of n54_class written out a
// second time, and a walker that checks each range's ends and the code
// points just outside it. They live here so that mutation of nip54.coax
// changes the library, not the checks.
// The ranges of n54_class, written out again: each one's ends are in its
// class and the code points just outside are in another.
N54_SPACES :: [20]int.[0x09,0x0D, 0x20,0x20, 0x85,0x85, 0xA0,0xA0, 0x1680,0x1680, 0x2000,0x200A, 0x2028,0x2029, 0x202F,0x202F, 0x205F,0x205F, 0x3000,0x3000];
N54_DROPS :: [58]int.[0x00,0x08, 0x0E,0x1F, 0x21,0x2C, 0x2E,0x2F, 0x3A,0x40, 0x5B,0x60, 0x7B,0x84, 0x86,0x9F, 0xA1,0xA9, 0xAB,0xB1,
  0xB4,0xB4, 0xB6,0xB8, 0xBB,0xBB, 0xBF,0xBF, 0xD7,0xD7, 0xF7,0xF7, 0x200B,0x2027, 0x202A,0x202E, 0x2030,0x205E, 0x2190,0x2BFF,
  0x3001,0x3003, 0x3008,0x3011, 0x3014,0x301F, 0xFE00,0xFE0F, 0xFF01,0xFF0F, 0xFF1A,0xFF20, 0xFF3B,0xFF40, 0xFF5B,0xFF65, 0x1F000,0x1FAFF];
n54_edges :: (r:[]int,class:int) {
  i:=0;
  while i<r.count {
    #assert n54_class(r[i])==class && n54_class(r[i+1])==class;
    if r[i]>0 {o:=n54_class(r[i]-1);#assert o!=class && o>=N54_KEEP && o<=N54_DROP;}
    o:=n54_class(r[i+1]+1);#assert o!=class && o>=N54_KEEP && o<=N54_DROP;
    i+=2;
  }
}
