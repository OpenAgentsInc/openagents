N57_T_NOAMT :: "{\"id\":\"61e36b86ab996118288edc243e7d6442ececda822502d3a416cb6fc776f20bfb\",\"pubkey\":\"dd308afec5777e13121fa72b9cc1b7cc0139715309b086c960e18fd969774eb8\",\"created_at\":1761686520,\"kind\":9734,\"tags\":[[\"relays\",\"wss://relay.example.com\"],[\"p\",\"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659\"]],\"content\":\"\",\"sig\":\"2fa31e413278a5b3569fb0659143cecaadfbcfc63c569fe1705d497feaabe10cbf0b5219b0a14ef32845830576515bd0fe23075b509a31f95fef81e77dd62818\"}";
N57_T_CAROL :: "{\"id\":\"32f13958f0b8e6118316165a7760a6727019afd303d02830b5c8e7ddc5cc5492\",\"pubkey\":\"dd308afec5777e13121fa72b9cc1b7cc0139715309b086c960e18fd969774eb8\",\"created_at\":1761686580,\"kind\":9734,\"tags\":[[\"relays\",\"wss://relay.example.com\"],[\"amount\",\"30000\"],[\"lnurl\",\"lnurl1dp68gurn8ghj77npwpejuetcv9khqmr99e3k7mf09emk2mrv944kummhdchkcmn4wfk8qtmzda3qcm6szy\"],[\"p\",\"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659\"],[\"e\",\"0d139a55394917832d2a910655312ec8362a01ef3a194c0243ecf679b96beb72\"],[\"k\",\"9041\"]],\"content\":\"\",\"sig\":\"4ddae85e1ad38af7ad590f6e44f45e937631b095f33e592661049c75a682e4772c3bcd530402e82aacb393ffc829886a935ec5729fead817b00003c12fcd72f4\"}";
// The tags t with one more tag at the end.
n57_plus :: (t:string,tag:string,out:[]u8)->string {
  n:=json_raw(out,0,t[0..<t.count-1]);n=json_raw(out,n,",");n=json_raw(out,n,tag);n=json_raw(out,n,"]");
  return cast(string)out[0..<n];
}

