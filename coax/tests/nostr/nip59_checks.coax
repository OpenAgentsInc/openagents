// NIP-59 end to end: every layer with real x-only ECDH, NIP-44 v2 and BIP-340
// signatures. Wraps made by nostr-effect (nip59_vectors.coax, from
// nip59_fixtures.ts) open or refuse here; wraps made here open in nostr-effect
// through nip59_interop.ts. Each wrap or unwrap costs about a billion
// interpreter steps:
//   coax/bin/coax test coax/tests/nostr/nip59_checks.coax --steps 4000000000 --run-steps 250000000
#load "../../lib/nostr/nip59.coax";

main :: () {}

// Unwrapping wraps made by nostr-effect, the library the hidden-deck sealer
// uses (coax/web/unlock/lib.ts), generated by nip59_fixtures.ts.
#test "an independent gift wrap opens to its rumor, author and id" {
  wrap:=N59_TS_WRAP;rumor:=N59_TS_RUMOR;
  work:[NIP59_WORK]u8;out:[NIP59_REGION]u8;
  o:=n59_open(cast(string)wrap[..],work[..],out[..]);
  #assert o.error==NIP59_OK && o.written==rumor.count && cast(string)out[0..<o.written]==cast(string)rumor[..];
  for i:0..<32 {#assert o.author[i]==N59_ALICE_PUB[i] && o.rumor_id[i]==N59_TS_RUMOR_ID[i];}
  #assert o.kind==14 && o.created_at==N59_TS_RUMOR_AT && o.tags==1;
  #assert cast(string)out[o.content_from..<o.content_to]=="Bob: the decision job is ready.";
  for b:work {#assert b==0;}
}
#test "the hidden test deck's wrap opens, and its artifact envelope decrypts" {
  wrap:=N59_TS_DECK;work:[NIP59_WORK]u8;out:[NIP59_REGION]u8;
  o:=n59_open(cast(string)wrap[..],work[..],out[..]);
  #assert o.error==NIP59_OK && o.kind==3188 && o.tags==3;
  for i:0..<32 {#assert o.author[i]==N59_ALICE_PUB[i];}
  bob:=n59_bob();ck:[32]u8;ew:[1]EcdhScratch;pub:=N59_ALICE_PUB;
  #assert nip44_conversation_key_from_keys_checked(bob[..],pub[..],ew[..],ck[..],false)==NIP44_OK;
  dw:[2*NIP59_REGION]u8;plain:[NIP59_REGION]u8;
  d:=nip44_decrypt_checked(NIP44_COMPAT,ck[..],cast(string)out[o.content_from..<o.content_to],dw[..],plain[..],false);
  #assert d.error==NIP44_OK && cast(string)plain[0..<40]=="{\"v\":\"openagents.artifact-envelope.v1\",\"";
}
#test "a changed outer signature, id or kind refuses before decrypting" {
  wrap:=N59_TS_WRAP;work:[NIP59_WORK]u8;out:[NIP59_REGION]u8;
  e:=ne_parse(cast(string)wrap[..]);#assert e.error==NE_OK;
  // The sig is the last field: flip one of its hex digits.
  s:=wrap.count-10;wrap[s]=ifx wrap[s]=='0' then '1' else '0';
  #assert n59_open(cast(string)wrap[..],work[..],out[..]).error==NIP59_WRAP_SIGNATURE;
  for b:out {#assert b==0;} for b:work {#assert b==0;}
  wrap=N59_TS_WRAP;c:=e.content_from+3;wrap[c]=ifx wrap[c]=='A' then 'B' else 'A';
  #assert n59_open(cast(string)wrap[..],work[..],out[..]).error==NIP59_WRAP;
  #assert n59_open(N59_TS_KIND1060,work[..],out[..]).error==NIP59_WRAP;
  #assert n59_open("{}",work[..],out[..]).error==NIP59_WRAP;
}
#test "a wrap not addressed to this key refuses as NIP59_RECIPIENT" {
  work:[NIP59_WORK]u8;out:[NIP59_REGION]u8;
  #assert n59_open(N59_TS_NO_P,work[..],out[..]).error==NIP59_RECIPIENT;
  #assert n59_open(N59_TS_OTHER_P,work[..],out[..]).error==NIP59_RECIPIENT;
  for b:out {#assert b==0;}
}
#test "a wrap for another key that names this one does not decrypt" {
  work:[NIP59_WORK]u8;out:[NIP59_REGION]u8;
  #assert n59_open(N59_TS_FOR_CAROL,work[..],out[..]).error==NIP59_WRAP_PAYLOAD;
  for b:out {#assert b==0;} for b:work {#assert b==0;}
}
#test "a bad seal signature, kind or tags refuses" {
  work:[NIP59_WORK]u8;out:[NIP59_REGION]u8;
  #assert n59_open(N59_TS_BAD_SEAL_SIG,work[..],out[..]).error==NIP59_SEAL_SIGNATURE;
  #assert n59_open(N59_TS_SEAL_KIND,work[..],out[..]).error==NIP59_SEAL;
  #assert n59_open(N59_TS_SEAL_TAGS,work[..],out[..]).error==NIP59_SEAL;
  #assert n59_open(N59_TS_SEAL_ID,work[..],out[..]).error==NIP59_SEAL;
  for b:out {#assert b==0;} for b:work {#assert b==0;}
}
#test "a rumor that is signed, has a wrong id or another author refuses" {
  work:[NIP59_WORK]u8;out:[NIP59_REGION]u8;
  #assert n59_open(N59_TS_RUMOR_SIGNED,work[..],out[..]).error==NIP59_RUMOR;
  #assert n59_open(N59_TS_RUMOR_ID_BAD,work[..],out[..]).error==NIP59_RUMOR;
  #assert n59_open(N59_TS_IMPERSONATED,work[..],out[..]).error==NIP59_IDENTITY;
  for b:out {#assert b==0;} for b:work {#assert b==0;}
}
#test "a key that cannot be a secret refuses only after the wrap checks out" {
  me:=N59_BOB_PUB;wrap:=N59_TS_WRAP;work:[NIP59_WORK]u8;out:[NIP59_REGION]u8;zero:[32]u8;
  #assert nip59_unwrap_checked(zero[..],me[..],cast(string)wrap[..],work[..],out[..],false).error==NIP59_KEY;
  for b:work {#assert b==0;}
}
#test "a rumor too short for its decrypted size refuses as NIP59_OUTPUT and clears out" {
  bob:=n59_bob();me:=N59_BOB_PUB;wrap:=N59_TS_WRAP;work:[NIP59_WORK]u8;out:[NIP59_REGION]u8;
  for i:0..<out.count {out[i]=7;}
  short:=N59_TS_RUMOR.count-1;
  #assert nip59_unwrap_checked(bob[..],me[..],cast(string)wrap[..],work[..],out[0..<short],false).error==NIP59_OUTPUT;
  for i:0..<out.count {#assert out[i]==ifx i<short then cast(u8)0 else cast(u8)7;} for b:work {#assert b==0;}
}

// Wrapping in Coax, then unwrapping in Coax. nip59_interop.ts opens what
// nip59_dump.coax prints with nostr-effect, the other direction.
#test "a Coax gift wrap round-trips, with fresh times inside the window and all secrets cleared" {
  out:[NIP59_REGION]u8;work:[NIP59_WORK]u8;fresh:=n59_fresh(1);
  w:=n59_wrap_text(fresh[..],"Bob: the decision job is ready.",work[..],out[..]);
  #assert w.error==NIP59_OK && w.written>0;
  for b:work {#assert b==0;} for i:0..<32 {#assert fresh[0].wrap_key[i]==0 && fresh[0].seal_aux[i]==0 && fresh[0].wrap_nonce[i]==0;}
  #assert fresh[0].seal_back==0 && fresh[0].wrap_back==0;
  #assert w.seal_at==N59_NOW-1001 && w.wrap_at==N59_NOW-(1000000%NIP59_WINDOW);
  e:=ne_parse(cast(string)out[0..<w.written]);#assert e.error==NE_OK && e.kind==NIP59_WRAP_KIND && e.created_at==w.wrap_at && e.tags==1;
  same:=true;for i:0..<32 {if e.public_key[i]!=N59_ALICE_PUB[i] {same=false;}}#assert !same;
  plain:[NIP59_REGION]u8;
  o:=n59_open(cast(string)out[0..<w.written],work[..],plain[..]);
  #assert o.error==NIP59_OK && o.kind==14 && o.created_at==N59_NOW && o.tags==1;
  for i:0..<32 {#assert o.author[i]==N59_ALICE_PUB[i] && o.rumor_id[i]==w.rumor_id[i] && o.wrap_key[i]==e.public_key[i];}
  #assert cast(string)plain[o.content_from..<o.content_to]=="Bob: the decision job is ready.";
  for b:work {#assert b==0;}
}
#test "two wraps from different fresh entropy share nothing public but the recipient" {
  a:[NIP59_REGION]u8;b:[NIP59_REGION]u8;work:[NIP59_WORK]u8;
  f1:=n59_fresh(1);f2:=n59_fresh(2);wa:=n59_wrap_text(f1[..],"same",work[..],a[..]);wb:=n59_wrap_text(f2[..],"same",work[..],b[..]);
  #assert wa.error==NIP59_OK && wb.error==NIP59_OK;
  ea:=ne_parse(cast(string)a[0..<wa.written]);eb:=ne_parse(cast(string)b[0..<wb.written]);
  same_key:=true;same_id:=true;for i:0..<32 {if ea.public_key[i]!=eb.public_key[i] {same_key=false;}if ea.id[i]!=eb.id[i] {same_id=false;}}
  #assert !same_key && !same_id && ea.created_at!=eb.created_at;
  #assert cast(string)a[ea.content_from..<ea.content_to]!=cast(string)b[eb.content_from..<eb.content_to];
}
#test "the largest rumor wraps and opens; one byte more refuses before anything is written" {
  big:[NIP59_MAX_RUMOR]u8;for i:0..<big.count {big[i]=cast(u8)('a'+i%26);}
  // The rumor's JSON around a content of n bytes is N59_RUMOR_FIXED bytes.
  n:=NIP59_MAX_RUMOR-N59_RUMOR_FIXED;
  out:[NIP59_REGION]u8;work:[NIP59_WORK]u8;
  f3:=n59_fresh(3);w:=n59_wrap_text(f3[..],cast(string)big[0..<n],work[..],out[..]);
  #assert w.error==NIP59_OK;
  plain:[NIP59_REGION]u8;o:=n59_open(cast(string)out[0..<w.written],work[..],plain[..]);
  #assert o.error==NIP59_OK && o.written==NIP59_MAX_RUMOR && o.content_to-o.content_from==n;
  for i:0..<out.count {out[i]=7;} for i:0..<64 {work[i]=7;}
  fresh:=n59_fresh(3);
  w=n59_wrap_text(fresh[..],cast(string)big[0..<n+1],work[..],out[..]);
  #assert w.error==NIP59_CAPACITY && w.written==0;
  for b:out {#assert b==0;} for b:work {#assert b==0;} for i:0..<32 {#assert fresh[0].wrap_key[i]==0;}
}
#test "bad keys and a reused author key refuse, clearing work, out and fresh" {
  alice:=n59_alice();bob:=N59_BOB_PUB;work:[NIP59_WORK]u8;out:[NIP59_REGION]u8;zero:[32]u8;
  fresh:=n59_fresh(1);for i:0..<64 {work[i]=7;out[i]=7;}
  #assert nip59_wrap_checked(zero[..],bob[..],N59_NOW,14,"[]","x",NIP59_WRAP_KIND,fresh[..],work[..],out[..],false).error==NIP59_KEY;
  for i:0..<64 {#assert work[i]==0 && out[i]==0;} for i:0..<32 {#assert fresh[0].wrap_key[i]==0;}
  fresh=n59_fresh(1);
  #assert nip59_wrap_checked(alice[..],zero[..],N59_NOW,14,"[]","x",NIP59_WRAP_KIND,fresh[..],work[..],out[..],false).error==NIP59_KEY;
  fresh=n59_fresh(1);fresh[0].wrap_key=zero;
  #assert nip59_wrap_checked(alice[..],bob[..],N59_NOW,14,"[]","x",NIP59_WRAP_KIND,fresh[..],work[..],out[..],false).error==NIP59_FRESH;
  fresh=n59_fresh(1);fresh[0].wrap_key=alice;for i:0..<64 {out[i]=7;}
  #assert nip59_wrap_checked(alice[..],bob[..],N59_NOW,14,"[]","x",NIP59_WRAP_KIND,fresh[..],work[..],out[..],false).error==NIP59_FRESH;
  for b:out {#assert b==0;} for b:work {#assert b==0;} for i:0..<32 {#assert fresh[0].wrap_key[i]==0;}
  fresh=n59_fresh(1);
  #assert nip59_wrap_checked(alice[..],bob[..],N59_NOW,14,"[]","x",NIP59_WRAP_KIND,fresh[..],work[..],out[0..<200],false).error==NIP59_OUTPUT;
  for b:out {#assert b==0;}
}
#test "an ephemeral wrap is kind 21059 and opens the same way" {
  alice:=n59_alice();bob:=N59_BOB_PUB;fresh:=n59_fresh(4);work:[NIP59_WORK]u8;out:[NIP59_REGION]u8;
  w:=nip59_wrap_checked(alice[..],bob[..],N59_NOW,14,"[]","now",NIP59_EPHEMERAL_KIND,fresh[..],work[..],out[..],false);
  #assert w.error==NIP59_OK && ne_parse(cast(string)out[0..<w.written]).kind==NIP59_EPHEMERAL_KIND;
  plain:[NIP59_REGION]u8;#assert n59_open(cast(string)out[0..<w.written],work[..],plain[..]).error==NIP59_OK;
}

