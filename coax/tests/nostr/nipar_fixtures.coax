// Helpers for nipar.coax's checks. They live here so that mutation of the
// library changes the library, not the checks. Events are built in the
// caller's buffer out; ^x in tags stands for 64 copies of x (g29_ev).
ARF_D :: "04737c81-e5e8-4412-bb47-f446813cfeba";
ARF_D2 :: "11111111-2222-4333-8444-555555555555";
ARF_H1 :: "9b353519-f4fe-4757-aef4-bec6cc0ae54c";
ARF_H2 :: "17cfe3ca-b3d0-4a76-a2a4-4eaf0d3a4109";
arf_v :: (s:string)->N32Text {t:N32Text;for i:0..<s.count {t.b[i]=s[i];}t.n=s.count;return t;}
// The tags of a revision of d with op in h, prev ^p (none when p is 0),
// type, a title unless op is delete (or title when given), then extra.
arf_tags :: (d:string,op:string,h:string,p:u8,type:string,title:string,extra:string,out:[]u8)->string {
  n:=json_raw(out,0,"[[\"ar\",\"1\"],[\"d\",\"");n=json_raw(out,n,d);n=json_raw(out,n,"\"],[\"h\",\"");n=json_raw(out,n,h);
  n=json_raw(out,n,"\"],[\"type\",\"");n=json_raw(out,n,type);n=json_raw(out,n,"\"]");
  if op!="delete" {n=json_raw(out,n,",[\"title\",\"");n=json_raw(out,n,ifx title.count>0 then title else "Fix it");n=json_raw(out,n,"\"]");}
  n=json_raw(out,n,",[\"op\",\"");n=json_raw(out,n,op);n=json_raw(out,n,"\"]");
  if p!=0 {n=json_raw(out,n,",[\"prev\",\"^");out[n]=p;n+=1;n=json_raw(out,n,"\"]");}
  n=json_raw(out,n,extra);n=json_raw(out,n,"]");return cast(string)out[0..<n];
}
arf_make :: (d:string,op:string,h:string,p:u8,id:u8,type:string,title:string,extra:string,out:[]u8)->NostrEvent {
  t:[16384]u8;s:=arf_tags(d,op,h,p,type,title,extra,t[..]);
  e:=g29_ev(AR_KIND_ARTIFACT,0xa1,id,s,out);e.content_from=0;e.content_to=0;return e;
}
arf_ev :: (op:string,h:string,p:u8,id:u8,extra:string,out:[]u8)->NostrEvent {return arf_make(ARF_D,op,h,p,id,"buzz.task","",extra,out);}
arf_ev_d :: (op:string,h:string,p:u8,id:u8,extra:string,out:[]u8)->NostrEvent {return arf_make(ARF_D2,op,h,p,id,"buzz.task","",extra,out);}
arf_ev_type :: (op:string,h:string,p:u8,id:u8,type:string,out:[]u8)->NostrEvent {return arf_make(ARF_D,op,h,p,id,type,"","",out);}
arf_ev_title :: (title:string,out:[]u8)->NostrEvent {return arf_make(ARF_D,"create",ARF_H1,0,0x01,"buzz.task",title,"",out);}
// A create carrying k client tags after its six envelope tags.
arf_many :: (k:int,out:[]u8)->NostrEvent {
  extra:[8192]u8;n:=0;for i:0..<k {n=json_raw(extra[..],n,",[\"x\",\"y\"]");}
  return arf_make(ARF_D,"create",ARF_H1,0,0x01,"buzz.task","",cast(string)extra[0..<n],out);
}
// An update whose prev is the id of all bytes p, with id bytes all id.
arf_ev_n :: (p:u8,id:u8,out:[]u8)->NostrEvent {
  hex:="0123456789abcdef";x:[2]u8;x[0]=hex[p>>4];x[1]=hex[p&15];
  extra:[128]u8;n:=json_raw(extra[..],0,",[\"prev\",\"");for i:0..<32 {n=json_raw(extra[..],n,cast(string)x[..]);}n=json_raw(extra[..],n,"\"]");
  // arf_tags writes no prev for p=0; the prev comes in extra instead.
  return arf_make(ARF_D,"update",ARF_H1,0,id,"buzz.task","",cast(string)extra[0..<n],out);
}
arf_env :: (op:string,h:string,p:u8,extra:string)->ArEnvelope {b:[4096]u8;return ar_envelope(arf_ev(op,h,p,0x01,extra,b[..]));}
arf_raw :: (tags:string)->ArEnvelope {b:[4096]u8;e:=g29_ev(AR_KIND_ARTIFACT,0xa1,0x01,tags,b[..]);e.content_from=0;e.content_to=0;return ar_envelope(e);}
arf_one :: (h:string)->[1]ArText {return [1]ArText.[ar_text(arf_v(h))];}
arf_both :: ()->[2]ArText {return [2]ArText.[ar_text(arf_v(ARF_H1)),ar_text(arf_v(ARF_H2))];}
