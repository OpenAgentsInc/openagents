// Helpers for niper.coax's checks. They live here so that mutation of the
// library changes the library, not the checks. Events are built in the
// caller's buffer out; ^x in tags stands for 64 copies of x (g29_ev).
#load "artifacts_vectors.coax";
#load "niper_envelope_fixtures.coax" #test;
ERF_PENDING :: "{\"status\":\"pending\",\"note\":\"x\"}";
erf_c :: (s:string)->ErContent {return er_content(s);}
