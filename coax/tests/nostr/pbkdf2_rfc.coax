// RFC7914 section11 first row, plus independent low-round boundary fixtures.
#test "PBKDF2 independent fixture 0" {
 password:=[6]u8.[112,97,115,115,119,100];salt:=[4]u8.[115,97,108,116];expected:=[64]u8.[85,172,4,110,86,227,8,159,236,22,145,194,37,68,182,5,249,65,133,33,109,222,4,101,230,139,157,87,194,13,172,188,73,202,156,204,241,121,182,69,153,22,100,179,157,119,239,49,124,113,184,69,177,227,11,213,9,17,32,65,211,161,151,131];state:[832]u8;out:[256]u8;
 #assert pb_init_checked(state[..],password[..],salt[..],1,64,false)==0;
 progress:=pb_step_checked(state[..],1);#assert progress.error==0 && progress.completed==1 && progress.phase==PB_ACTIVE;
 progress=pb_step_checked(state[..],16);#assert progress.error==0 && progress.phase==PB_DONE;
 #assert pb_result_checked(state[..],out[..],false)==0;
 for i:0..<64 {#assert out[i]==expected[i];}
 for i:640..<832 {#assert state[i]==0;}
}
#test "PBKDF2 independent fixture 1" {
 password:=[8]u8.[112,97,115,115,119,111,114,100];salt:=[4]u8.[115,97,108,116];expected:=[32]u8.[174,77,12,149,175,107,70,211,45,10,223,249,40,240,109,208,42,48,63,142,243,194,81,223,214,226,216,90,149,71,76,67];state:[832]u8;out:[256]u8;
 #assert pb_init_checked(state[..],password[..],salt[..],2,32,false)==0;
 progress:=pb_step_checked(state[..],16);#assert progress.error==0 && progress.phase==PB_DONE;
 #assert pb_result_checked(state[..],out[..],false)==0;
 for i:0..<32 {#assert out[i]==expected[i];}
}
#test "PBKDF2 independent fixture 2" {
 password:[1]u8;salt:[1]u8;expected:=[33]u8.[179,114,121,100,84,211,122,192,66,161,149,182,46,235,124,254,211,141,221,146,247,87,226,254,224,66,16,223,3,172,29,46,96];state:[832]u8;out:[256]u8;
 #assert pb_init_checked(state[..],password[0..<0],salt[0..<0],3,33,false)==0;
 progress:=pb_step_checked(state[..],16);#assert progress.error==0 && progress.phase==PB_DONE;
 #assert pb_result_checked(state[..],out[..],false)==0;
 for i:0..<33 {#assert out[i]==expected[i];}
}
