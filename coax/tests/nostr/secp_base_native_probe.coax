// Public interpreter-cost probe ONLY; the real #run build remains required.
#load "../../lib/crypto/secp_mult_base.coax";
#test "public native comb generator cost probe" {
  table: [256] SgPoint;
  #assert smb_generate(table[..],8,32);
  #assert sg_equal_mask(table[0],sg_infinity()) == CB_MAX64;
  #assert sg_equal_mask(table[1],sg_generator()) == CB_MAX64;
}
