#forall "write propagation preserves aliases and treats variable-time operators conservatively" op:23..<34,rhs_secret:0..<2,old_secret:0..<2 {
 f:=SC_fixture();values:[32]u64;memory:=[1]AgMemory.[AgMemory.{used=2}];memory[0].taint[2]=ifx rhs_secret==1 then 4 else 0;
 env:[1]AgEnv;state:[1]ScAudit;AG_bind(env[..],"x",AgValue.{type=-1,mask=cast(u64)old_secret,known=true,lo=2,hi=2},state[..],5);
 rhs:=AgValue.{type=-1,mask=ifx rhs_secret==1 then cast(u64)2 else cast(u64)0,region=2,literal=7,known=true,lo=3,hi=3};f.nodes[7]=ScNode.{kind=20,name="x"};
 AG_write(f.nodes[..],values[..],f.roots[..],f.types[0..<1],7,rhs,cast(u32)op,env[..],memory[..],state[..]);want:=cast(u32)0;
 if op>=24 && op<=28 {if rhs_secret==1 || old_secret==1 {want=SC_UNSUPPORTED;}}if op==32 || op==33 {if rhs_secret==1 {want=SC_SHIFT;}}
 #assert state[0].error==want;result:=env[0].bindings[0].value;
 if want==0 {#assert result.mask==(cast(u64)(ifx rhs_secret==1 then 6 else 0)|cast(u64)(ifx op==23 then 0 else old_secret)) && result.type==-1 && result.region==0 && result.literal==0;}
}
#forall "checked compound arithmetic rejects secret origins in indexed storage" op:23..<29,old_secret:0..<2,rhs_secret:0..<2 {
 f:=AG_fixture();memory:=[1]AgMemory.[AgMemory.{used=1}];memory[0].taint[1]=cast(u64)old_secret;env:[1]AgEnv;state:[1]ScAudit;
 AG_bind(env[..],"x",AgValue.{type=8,region=1},state[..],5);
 AG_write(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,AgValue.{type= -1,mask=cast(u64)rhs_secret},cast(u32)op,env[..],memory[..],state[..]);
 #assert state[0].error==cast(u32)(ifx op>=24 && (old_secret==1 || rhs_secret==1) then SC_UNSUPPORTED else 0);
}
#test "aggregate writes update a shared region and invalidate public constructor metadata" {
 f:=AG_fixture();memory:=[1]AgMemory.[AgMemory.{used=2}];memory[0].taint[1]=1;memory[0].taint[2]=4;env:[1]AgEnv;state:[1]ScAudit;
 AG_bind(env[..],"x",AgValue.{type=8,region=1},state[..],5);AG_write(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,AgValue.{mask=2,type=-1,region=2},23,env[..],memory[..],state[..]);
 #assert state[0].error==0 && memory[0].taint[1]==7 && memory[0].dirty[1];
 state[0]=ScAudit.{};env[0].bindings[0].value.region=0;AG_write(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,AG_number(0),23,env[..],memory[..],state[..]);#assert state[0].error==SC_UNSUPPORTED;
 state[0]=ScAudit.{};env[0].bindings[0].name="other";AG_write(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,AG_number(0),23,env[..],memory[..],state[..]);#assert state[0].error==SC_CALL;
}
#forall "public interval operations preserve uncertain endpoints and result types" op:34..<52,unknown:0..<3 {
 memory:[1]AgMemory;state:[1]ScAudit;a:=AgValue.{type=-4,lo=1,hi=3,known=true};b:=AgValue.{type=-1,lo=2,hi=4,known=true};if unknown==1 {a.known=false;}if unknown==2 {b.known=false;}
 r:=AG_binary(a,b,cast(u32)op,memory[..],state[..],1);#assert r.mask==0 && r.type==(ifx op>=44 then -3 else -1);
 if op>=44 {#assert r.known && r.lo==(ifx unknown==0 && op>=50 then 1 else 0) && r.hi==1;}else if unknown!=0 {#assert !r.known;}
 if unknown==0 {if op==34 {#assert r.known && r.lo==3 && r.hi==7;}if op==35 {#assert !r.known;}if op==36 {#assert r.known && r.lo==2 && r.hi==12;}if op==37 {#assert r.known && r.lo==0 && r.hi==1;}if op==38 {#assert r.known && r.lo==0 && r.hi==3;}}
}
#forall "uncertain public comparisons stay conservative when only one operand is a singleton" op:44..<50,side:0..<2 {
 memory:[1]AgMemory;state:[1]ScAudit;a:=AgValue.{type=-1,lo=1,hi=3,known=true};b:=AG_number(2);if side==1 {a=AG_number(2);b=AgValue.{type=-1,lo=1,hi=3,known=true};}
 r:=AG_binary(a,b,cast(u32)op,memory[..],state[..],1);#assert r.known && r.lo==0 && r.hi==1;
}
#forall "literal typing is canonical and bounded at the exact public-number edge" kind:16..<19,extra:0..<2 {
 f:=SC_fixture();values:[32]u64;f.nodes[7]=ScNode.{kind=cast(u32)kind};values[7]=4096+cast(u64)extra;memory:[1]AgMemory;state:[1]ScAudit;env:[1]AgEnv;
 r:=AG_expr(f.nodes[..],values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);
 if kind==16 {#assert state[0].error==0 && r.type==-4 && r.known==(extra==0);if extra==0 {#assert r.lo==4096 && r.hi==4096;}}
 else {#assert state[0].error==cast(u32)(ifx kind==18 then SC_GRAPH else SC_UNSUPPORTED);}
}
#forall "field reads reset stale aggregate metadata and consult only clean source literal ranges" dirty:0..<2,region:0..<2 {
 f:=AG_fixture();f.nodes[9].a=3;f.nodes[7]=ScNode.{kind=25,a=14,name="words"};f.nodes[16]=ScNode.{kind=28,d=12,head=17};f.nodes[17]=ScNode.{kind=71,name="words",a=18};f.nodes[18]=ScNode.{kind=16};f.values[18]=7;
 memory:=[1]AgMemory.[AgMemory.{used=1}];memory[0].dirty[1]=dirty==1;env:[1]AgEnv;state:[1]ScAudit;AG_bind(env[..],"x",AgValue.{type=8,region=region,literal=16,known=true,lo=99,hi=99,extent=4,view=true},state[..],5);
 r:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert state[0].error==0 && r.type==-1 && r.region==region && r.mask==0 && r.literal==0 && !r.view && r.extent==0 && r.known==(region==0 || dirty==0);
 if r.known {#assert r.lo==7 && r.hi==7;}
}

#test "primitive copies clear region metadata and signed-secret refusal has no invented source index" {
