 f:=SC_fixture();values:[32]u64;f.nodes[6]=ScNode.{kind=45,a=7,c=8};f.nodes[7]=ScNode.{kind=18};f.nodes[8]=ScNode.{kind=40};env:=[1]AgEnv.[AgEnv.{procedure=2}];memory:[1]AgMemory;state:[1]ScAudit;
 r:=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<1],4,env[..],memory[..],state[..],0);#assert state[0].error==0 && !r.returned;
 values[7]=1;f.nodes[8].kind=16;state[0]=ScAudit.{};r=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<1],4,env[..],memory[..],state[..],0);#assert state[0].error==SC_UNSUPPORTED && state[0].where==8;
}
#test "default local initialization is actually the public zero value" {
 f:=SC_fixture();values:[32]u64;f.nodes[6]=ScNode.{kind=42,name="z",line=2,d=3};f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="u64"};env:=[1]AgEnv.[AgEnv.{procedure=2}];memory:[1]AgMemory;state:[1]ScAudit;
 r:=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<2],4,env[..],memory[..],state[..],0);#assert state[0].error==0 && env[0].count==1 && env[0].bindings[0].value.known && env[0].bindings[0].value.lo==0 && env[0].bindings[0].value.hi==0;
}
#test "scalar loop backedges are marked before an earlier condition is analyzed" {
 f:=SC_fixture();values:[32]u64;f.nodes[6]=ScNode.{kind=47,name="i",a=16,b=17,c=18};f.nodes[16]=ScNode.{kind=16};f.nodes[17]=ScNode.{kind=16};values[17]=2;f.nodes[18]=ScNode.{kind=40,head=19};f.nodes[19]=ScNode.{kind=45,a=20,c=21,next=22};f.nodes[20]=ScNode.{kind=23,a=23,b=16,op=44};f.nodes[21]=ScNode.{kind=40};f.nodes[22]=ScNode.{kind=43,c=23,a=24,op=23};f.nodes[23]=ScNode.{kind=20,name="r"};f.nodes[24]=ScNode.{kind=20,name="x"};
 f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"};env:=[1]AgEnv.[AgEnv.{procedure=2}];memory:[1]AgMemory;state:[1]ScAudit;AG_bind(env[..],"x",AgValue.{type=-1,mask=1},state[..],5);AG_bind(env[..],"r",AG_number(0),state[..],5);
 r:=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<2],4,env[..],memory[..],state[..],0);#assert state[0].error==SC_BRANCH;
}
#test "a nil else arm never consumes a phantom source-node visit" {
 f:=SC_fixture();f.nodes[8]=ScNode.{kind=45,c=4};f.nodes[6]=ScNode.{kind=43,c=7};env:[1]AgEnv;memory:[1]AgMemory;state:[1]ScAudit;AG_bind(env[..],"x",AG_number(0),state[..],5);state[0].visits=AG_visit_limit()-4;
 AG_loop_marks(f.nodes[..],8,env[..],memory[..],state[..],1,0);#assert state[0].error==0 && state[0].visits==AG_visit_limit();
}
#forall "else-arm loop marking has an independent recursion boundary" extra:0..<2 {
 f:=SC_fixture();f.nodes[8]=ScNode.{kind=45,c=9,d=4};f.nodes[9]=ScNode.{kind=40};f.nodes[6]=ScNode.{kind=43,c=7};env:[1]AgEnv;memory:[1]AgMemory;state:[1]ScAudit;AG_bind(env[..],"x",AG_number(0),state[..],5);
 AG_loop_marks(f.nodes[..],8,env[..],memory[..],state[..],1,13+extra);#assert state[0].error==cast(u32)(ifx extra==0 then 0 else SC_LIMIT);
}
#test "top-level loop premarking keeps the full supported source depth" {
 f:=SC_fixture();nodes:[100]ScNode;values:[100]u64;for i:0..<32 {nodes[i]=f.nodes[i];}nodes[6]=ScNode.{kind=47,name="i",a=16,b=17,c=18};nodes[16]=ScNode.{kind=16};nodes[17]=ScNode.{kind=16};values[17]=1;nodes[18]=ScNode.{kind=40};nodes[7]=ScNode.{kind=18};values[7]=1;nodes[14]=ScNode.{kind=20,name="x"};
 parent:=18;for i:0..<7 {branch:=32+i*2;child:=branch+1;nodes[parent].head=branch;nodes[branch]=ScNode.{kind=45,a=7,c=child};nodes[child]=ScNode.{kind=40};parent=child;}nodes[parent].head=46;nodes[46]=ScNode.{kind=43,c=14,a=16,op=23};
 types:=[1]ScType.[ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"}];env:=[1]AgEnv.[AgEnv.{procedure=2}];memory:[1]AgMemory;state:[1]ScAudit;AG_bind(env[..],"x",AgValue.{type=-1,mask=1},state[..],5);
 r:=AG_block(nodes[..],values[..],f.roots[..],types[..],4,env[..],memory[..],state[..],0);#assert state[0].error==0;
}
#forall "loop interval hulls cannot shrink away a possible secret-control arm" empty:0..<2 {
 f:=SC_fixture();values:[32]u64;f.nodes[6]=ScNode.{kind=47,name="i",a=16,b=17,c=18};f.nodes[16]=ScNode.{kind=16};f.nodes[17]=ScNode.{kind=16};values[17]=ifx empty==1 then 0 else 2;f.nodes[18]=ScNode.{kind=40,head=19};f.nodes[19]=ScNode.{kind=45,a=20,c=22,d=23};f.nodes[20]=ScNode.{kind=23,a=21,b=16,op=44};f.nodes[21]=ScNode.{kind=20,name="i"};f.nodes[22]=ScNode.{kind=40};f.nodes[23]=ScNode.{kind=40,head=24};f.nodes[24]=ScNode.{kind=45,a=25,c=26};f.nodes[25]=ScNode.{kind=23,a=14,b=16,op=44};f.nodes[14]=ScNode.{kind=20,name="x"};f.nodes[26]=ScNode.{kind=40};
 f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"};env:=[1]AgEnv.[AgEnv.{procedure=2}];memory:[1]AgMemory;state:[1]ScAudit;AG_bind(env[..],"x",AgValue.{type=-1,mask=1},state[..],5);
 r:=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<2],4,env[..],memory[..],state[..],0);#assert state[0].error==SC_UNSUPPORTED;
}
#test "a divisor interval containing zero cannot become an exact public remainder range" {
 memory:[1]AgMemory;state:[1]ScAudit;r:=AG_binary(AG_number(3),AgValue.{type=-1,known=true,lo=0,hi=1},38,memory[..],state[..],1);#assert !r.known;
}
#test "nonliteral field anchors are graph errors rather than fabricated public bounds" {
 f:=AG_fixture();f.nodes[16]=ScNode.{kind=16};state:[1]ScAudit;r:=AG_literal_field(f.nodes[..],f.values[..],16,f.nodes[9],state[..],0);#assert !r.known && state[0].error==SC_GRAPH && state[0].where==16;
}
#test "a user struct field named count is data rather than array extent metadata" {
 f:=AG_fixture();f.nodes[9].name="count";f.nodes[9].a=3;f.nodes[7]=ScNode.{kind=25,a=14,name="count"};memory:=[1]AgMemory.[AgMemory.{used=1}];memory[0].taint[1]=1;env:[1]AgEnv;state:[1]ScAudit;AG_bind(env[..],"x",AgValue.{type=8,region=1},state[..],5);
 r:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert state[0].error==0 && r.type==-1 && r.mask==1 && !r.known;
}
#forall "constructor type admission distinguishes public signed metadata from secret signed data" secret:0..<2 {
 f:=AG_fixture();f.nodes[3].name="int";f.nodes[9].a=3;f.nodes[16]=ScNode.{kind=28,d=12,head=17};f.nodes[17]=ScNode.{kind=71,name="words",a=18};f.nodes[18]=ScNode.{kind=20,name="value"};env:[1]AgEnv;memory:[1]AgMemory;state:[1]ScAudit;AG_bind(env[..],"value",AgValue.{type=-4,mask=cast(u64)secret},state[..],5);
 r:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],16,env[..],memory[..],state[..],0);#assert state[0].error==cast(u32)(ifx secret==0 then 0 else SC_TYPE);
}
#test "nested constructor type checks start at the root rather than consuming a phantom level" {
 f:=AG_fixture();for i:0..<7 {f.nodes[16+i]=ScNode.{kind=29,d=32+i,head=17+i};f.nodes[32+i]=ScNode.{kind=2,a=39,b=ifx i==6 then 3 else 33+i};}f.nodes[23]=ScNode.{kind=16};f.nodes[39]=ScNode.{kind=16};f.values[39]=1;
 env:[1]AgEnv;memory:[1]AgMemory;state:[1]ScAudit;r:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],16,env[..],memory[..],state[..],0);#assert state[0].error==0 && r.type==32 && r.extent==1;
}
#test "write targets retain the complete supported public index-expression budget" {
 f:=AG_fixture();nodes:[100]ScNode;values:[100]u64;for i:0..<64 {nodes[i]=f.nodes[i];values[i]=f.values[i];}nodes[7].b=32;
 for i:0..<14 {nodes[32+i]=ScNode.{kind=23,a=33+i,b=15,op=34};}nodes[46]=ScNode.{kind=16};env:[1]AgEnv;memory:=[1]AgMemory.[AgMemory.{used=1}];state:[1]ScAudit;AG_bind(env[..],"x",AgValue.{type=8,region=1},state[..],5);
 AG_write(nodes[..],values[..],f.roots[..],f.types[0..<1],7,AG_number(0),23,env[..],memory[..],state[..]);#assert state[0].error==0 && memory[0].dirty[1];
}
