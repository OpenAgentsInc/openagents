 state[0]=ScAudit.{};#assert AG_length(f.nodes[..],f.values[..],-1,state[..])==0 && state[0].error==SC_TYPE && state[0].where==0;
 f.nodes[16]=ScNode.{kind=20};state[0]=ScAudit.{};#assert AG_type(f.nodes[..],f.roots[..],16,state[..])==0 && state[0].error==SC_TYPE && state[0].where==16;
 state[0]=ScAudit.{};f.nodes[16]=ScNode.{kind=1,name="Unknown"};#assert AG_type(f.nodes[..],f.roots[..],16,state[..])==0 && state[0].error==SC_TYPE && state[0].where==16;
}
