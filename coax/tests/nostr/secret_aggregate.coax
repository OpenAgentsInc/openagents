 if variant>=11 && variant<=17 {f.nodes[7]=ScNode.{kind=27,a=13};
  if variant==12 {f.nodes[7].b=15;f.nodes[7].c=16;f.nodes[16]=ScNode.{kind=16};f.values[16]=1;}
  if variant==13 {f.nodes[7].b=17;f.nodes[17]=ScNode.{kind=26,a=13,b=15};want=SC_INDEX;mask=0;}
  if variant==14 {f.nodes[7].c=17;f.nodes[17]=ScNode.{kind=26,a=13,b=15};want=SC_INDEX;mask=0;}
  if variant==15 {f.nodes[7].b=15;f.values[15]=3;want=SC_UNSUPPORTED;mask=0;}
  if variant==16 {f.nodes[7].c=15;f.values[15]=3;want=SC_UNSUPPORTED;mask=0;}
  if variant==17 {env[0].bindings[0].value.region=0;want=SC_UNSUPPORTED;mask=0;}
 }
 if variant==18 {f.nodes[7]=ScNode.{kind=28,d=12};mask=0;}
 if variant==19 {f.nodes[7]=ScNode.{kind=28,d=12,head=16};f.nodes[16]=ScNode.{kind=71,name="words",a=17};f.nodes[17]=ScNode.{kind=26,a=13,b=15};}
 if variant==20 {f.nodes[7]=ScNode.{kind=29,d=10,head=16};f.nodes[16]=ScNode.{kind=26,a=13,b=15,next=17};f.nodes[17]=ScNode.{kind=16};}
 if variant==21 {f.nodes[7]=ScNode.{kind=22,a=15,op=52};mask=0;}
 if variant==22 {f.nodes[7]=ScNode.{kind=22,a=14,op=52};}
 if variant==23 {f.nodes[7]=ScNode.{kind=22,a=15,op=35};mask=0;}
 if variant==24 {f.nodes[7]=ScNode.{kind=21,name="value_barrier",head=14};}
 r:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],id,env[..],memory[..],state[..],0);#assert state[0].error==want && AG_origin(r,memory[..])==mask;
 if variant==6 {#assert !r.known && r.type==-5;}if variant==7 {#assert r.known && r.lo==255 && r.hi==255;}
 if variant==9 {#assert r.known && r.lo==2 && r.hi==2 && r.type==-4;}
 if variant==11 || variant==12 {#assert r.view && r.region==1 && r.extent==(ifx variant==11 then 2 else 1);}
 if variant==18 {#assert r.literal==7 && r.type==8;}if variant==20 {#assert r.literal==7 && r.type==10 && r.extent==2;}
 if variant==21 {#assert r.known && r.lo==1 && r.hi==1 && r.type==-3;}if variant==23 {#assert !r.known;}
}
