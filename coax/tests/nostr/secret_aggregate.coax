 if variant==5 {type=0;want=0;}if variant==6 {type=-1;want=0;}if variant==7 {f.nodes[10].kind=3;want=0;}if variant==8 {f.nodes[11].kind=20;want=0;}
 state:[1]ScAudit;#assert AG_length(f.nodes[..],f.values[..],type,state[..])==want;#assert state[0].error==cast(u32)(ifx want==0 then SC_TYPE else 0);
}
