 if variant==1 {a.lo=0;a.hi=6;}if variant==2 {a.known=false;}if variant==3 {b.known=false;}
 r:=AG_union(a,b,memory[..]);#assert r.mask==7 && r.region==0 && r.literal==0 && r.type==-1 && r.known==(variant<2);
 if variant<2 {#assert r.lo==(ifx variant==0 then 1 else 0) && r.hi==(ifx variant==0 then 5 else 6);}
}
#test "authored guard records merge origins by actual node and remain bounded" {
