 if variant==1 {type=16;f.nodes[16]=ScNode.{kind=3,b=3};depth=0;}
 if variant==2 {type=8;f.nodes[9].a=3;}
 result:=AG_valid_type(f.nodes[..],f.values[..],f.roots[..],type,true,state[..],depth);
 if variant!=1 {#assert result==(extra==0);}else {#assert result;}
}
