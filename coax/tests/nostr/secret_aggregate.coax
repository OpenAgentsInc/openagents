 f.nodes[8].next=16;f.nodes[16]=f.nodes[8];f.nodes[16].next=0;#assert AG_struct(f.nodes[..],f.roots[..],"Pair",state[..])==0 && state[0].error==SC_GRAPH;
 state[0]=ScAudit.{visits=AG_visit_limit()};#assert AG_struct(f.nodes[..],f.roots[..],"Pair",state[..])==0 && state[0].error==SC_LIMIT;
 state[0]=ScAudit.{visits=AG_visit_limit()};#assert AG_decl(f.nodes[..],f.roots[..],"candidate",state[..])==0 && state[0].error==SC_LIMIT;
 f.nodes[16]=ScNode.{kind=65,name="candidate"};state[0]=ScAudit.{};#assert AG_decl(f.nodes[..],f.roots[..],"candidate",state[..])==0 && state[0].error==SC_GRAPH;
 state[0]=ScAudit.{visits=AG_visit_limit()};#assert AG_field(f.nodes[..],8,"words",state[..])==0 && state[0].error==SC_LIMIT;
