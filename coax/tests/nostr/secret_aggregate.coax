#forall "struct admission counts actual fields and bounds recursive types" extra:0..<2 {
 f:=AG_fixture();nodes:[100]ScNode;values:[100]u64;for i:0..<64 {nodes[i]=f.nodes[i];values[i]=f.values[i];}
 nodes[8].head=16;for i:0..<64+extra {nodes[16+i]=ScNode.{kind=69,name="word",a=3,next=ifx i==63+extra then 0 else 17+i};}
 state:[1]ScAudit;#assert AG_valid_type(nodes[..],values[..],f.roots[..],8,true,state[..],0)==(extra==0);
 state[0]=ScAudit.{visits=AG_visit_limit()};#assert !AG_valid_type(nodes[..],values[..],f.roots[..],8,true,state[..],0) && state[0].error==SC_LIMIT;
}
#forall "nested type edges keep their complete recursion budget" variant:0..<3,extra:0..<2 {
