 f:=AG_fixture();f.nodes[6]=ScNode.{kind=47,name="i",a=16,b=17,c=18};f.nodes[16]=ScNode.{kind=16};f.nodes[17]=ScNode.{kind=16};f.values[17]=ifx variant==1 then 0 else 2;f.nodes[18]=ScNode.{kind=40};
 f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"};env:=[1]AgEnv.[AgEnv.{procedure=2}];state:[1]ScAudit;memory:=[1]AgMemory.[AgMemory.{used=1}];AG_bind(env[..],"x",AgValue.{type=-1,mask=1},state[..],5);AG_bind(env[..],"a",AgValue.{type=10,region=1,extent=2},state[..],5);
