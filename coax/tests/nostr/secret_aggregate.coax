// New-profile checks live separately from unsigned-scalar-source-v1.
#test "public interval construction does not classify data as secret" {
 v:=AG_number(7);#assert v.known && v.lo==7 && v.hi==7 && v.type==-4 && v.mask==0;
}
#test "run expressions require compiler provenance and retain no guessed facts" {
 f:=SC_fixture();values:[32]u64;f.nodes[7]=ScNode.{kind=24};memory:[1]AgMemory;state:[1]ScAudit;env:[1]AgEnv;
 r:=AG_expr(f.nodes[..],values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert state[0].error==SC_UNSUPPORTED && r.mask==0 && !r.known;
 state[0]=ScAudit.{};memory[0].compiled_runs=true;r=AG_expr(f.nodes[..],values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert state[0].error==0 && r.mask==0 && r.type==0 && r.region==0 && !r.known;
}
#test "unattested source graphs refuse run expressions" {
 f:=SC_fixture();values:[32]u64;f.nodes[7]=ScNode.{kind=24};memory:[1]AgMemory;
 plain:=AG_check(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..]);#assert plain.error==SC_UNSUPPORTED;
 compiled:=AG_check_compiled(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..]);#assert compiled.error==0 && compiled.return_mask==0;
}

#test "aggregate storage and source metadata use real typed identities" {
 f:=SC_fixture();values:[32]u64;state:[1]ScAudit;memory:[1]AgMemory;env:[1]AgEnv;
 #assert AG_struct(f.nodes[..],f.roots[..],"missing",state[..])==0;
 #assert AG_type(f.nodes[..],f.roots[..],3,state[..])==-1;
 #assert AG_match(f.nodes[..],values[..],f.roots[..],3,"u64",state[..],0);
 #assert AG_resolved(f.nodes[..],values[..],f.roots[..],f.types[0..<1],f.nodes[2],f.nodes[5],"parameter",state[..])==-1;
 a:=AG_new(f.nodes[..],values[..],f.roots[..],AgValue.{mask=1},3,memory[..],state[..]);AG_bind(env[..],"x",a,state[..],5);
 #assert AG_slot(env[..],"x")==0 && AG_origin(a,memory[..])==1;
 b:=AG_union(a,AG_number(3),memory[..]);#assert b.mask==1;
 AG_guard(f.nodes[..],memory[..],state[..],6,1);#assert memory[0].guard_count==1;
 f.nodes[8]=ScNode.{kind=66,name="Pair",head=9};f.nodes[2].next=8;f.nodes[9]=ScNode.{kind=69,name="word",a=3};
 #assert AG_struct(f.nodes[..],f.roots[..],"Pair",state[..])==8 && AG_field(f.nodes[..],8,"word",state[..])==9;
 f.nodes[10]=ScNode.{kind=2,a=11,b=3};f.nodes[11]=ScNode.{kind=16};values[11]=8;
 #assert AG_length(f.nodes[..],values[..],10,state[..])==8 && AG_element(f.nodes[..],f.roots[..],10,state[..])==-1;
 #assert AG_valid_type(f.nodes[..],values[..],f.roots[..],10,true,state[..],0);
}

#test "new aggregate entry exercises the actual source dataflow walk" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;r:=AG_check(f.nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..]);#assert r.error==0 && r.return_mask==1;
}
#test "aggregate helper paths execute before native source integration" {
 f:=SC_fixture();values:[32]u64;state:[1]ScAudit;memory:[1]AgMemory;env:[1]AgEnv;
 sum:=AG_binary(AG_number(2),AG_number(3),34,memory[..],state[..],7);#assert sum.known && sum.lo==5 && sum.hi==5;
 f.nodes[8]=ScNode.{kind=28,head=9};f.nodes[9]=ScNode.{kind=71,name="word",a=10};f.nodes[10]=ScNode.{kind=16};values[10]=7;
 field:=AG_literal_field(f.nodes[..],values[..],8,ScNode.{name="word"},state[..],0);#assert field.known && field.lo==7;
 AG_bind(env[..],"x",AgValue.{type=-1,mask=1},state[..],5);f.nodes[7]=ScNode.{kind=21,name="value_barrier",head=11};f.nodes[11]=ScNode.{kind=20,name="x"};
 call:=AG_call(f.nodes[..],values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert call.mask==1 && state[0].error==0;
 AG_write(f.nodes[..],values[..],f.roots[..],f.types[0..<1],11,AG_number(0),23,env[..],memory[..],state[..]);#assert env[0].bindings[0].value.mask==0;
 f.nodes[12]=ScNode.{kind=40,head=13};f.nodes[13]=ScNode.{kind=43,c=11};AG_loop_marks(f.nodes[..],12,env[..],memory[..],state[..],1,0);#assert env[0].bindings[0].value.mask==1;
 #assert AG_parameter_name(f.types[0..<1],f.nodes[2],f.nodes[5])=="u64";
}
#test "completed by-value procedure summaries reuse only exact normalized inputs" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;args:=[1]AgValue.[AgValue.{mask=4}];
 first:=AG_procedure(f.nodes[..],values[..],f.roots[..],f.types[0..<1],2,args[..],memory[..],state[..]);start:=state[0].visits;
 second:=AG_procedure(f.nodes[..],values[..],f.roots[..],f.types[0..<1],2,args[..],memory[..],state[..]);
 #assert state[0].error==0 && first.mask==4 && second.mask==4 && memory[0].memo_count==1 && state[0].visits-start<start;
 #assert memory[0].memo[0].procedure==2 && memory[0].memo[0].count==1 && memory[0].memo[0].args[0].mask==4 && memory[0].memo[0].args[0].type==-1;
 #assert memory[0].memo[0].result.mask==4 && memory[0].memo[0].result.region==0 && memory[0].memo[0].closure==1 && memory[0].memo[0].height==1;
 args[0].mask=8;third:=AG_procedure(f.nodes[..],values[..],f.roots[..],f.types[0..<1],2,args[..],memory[..],state[..]);
 #assert third.mask==8 && memory[0].memo_count==2;
 #assert !AG_memo_equal(AgValue.{type=-5},AgValue.{type=-1}) && !AG_memo_equal(AgValue.{known=true,hi=1},AgValue.{known=true,hi=2});
}
#test "memo values snapshot only stable normalized facts" {
 a:=AgValue.{mask=1,type=-2,literal=3,lo=4,hi=5,known=true,region=6,extent=7,view=true};b:=AG_memo_value(a);
 #assert b.mask==1 && b.type==-2 && b.literal==3 && b.lo==4 && b.hi==5 && b.known && b.extent==7 && b.region==0 && !b.view;
}
#forall "summary keys distinguish every retained public and origin fact" variant:0..<8 {
 a:=AgValue.{mask=1,type=-1,literal=2,lo=3,hi=4,known=true,extent=5};b:=a;
 if variant==1 {b.mask=2;}if variant==2 {b.type=-2;}if variant==3 {b.literal=3;}if variant==4 {b.lo=2;}if variant==5 {b.hi=5;}if variant==6 {b.known=false;}if variant==7 {b.extent=6;}
 #assert AG_memo_equal(a,b)==(variant==0);
}
#test "nested summaries propagate closure and maximum depth" {
 memory:[1]AgMemory;memory[0].scope[0]=1;memory[0].height[0]=1;AG_memo_scope(memory[..],1,6,3);
 #assert memory[0].scope[0]==7 && memory[0].height[0]==4;AG_memo_scope(memory[..],1,8,1);
 #assert memory[0].scope[0]==15 && memory[0].height[0]==4;AG_memo_scope(memory[..],1,16,4);#assert memory[0].scope[0]==31 && memory[0].height[0]==5;
}
#test "a reusable nested summary propagates its closure and depth" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;args:=[1]AgValue.[AgValue.{mask=4}];
 state[0].depth=1;state[0].count=1;state[0].stack[0]=8;state[0].seen[0]=8;memory[0].scope[0]=1;memory[0].height[0]=1;
 memory[0].memo_count=1;memory[0].memo[0].procedure=2;memory[0].memo[0].count=1;memory[0].memo[0].args[0]=AgValue.{type=-1,mask=4};memory[0].memo[0].result=AgValue.{type=-1,mask=9};memory[0].memo[0].closure=6;memory[0].memo[0].height=2;
 r:=AG_procedure(f.nodes[..],values[..],f.roots[..],f.types[0..<1],2,args[..],memory[..],state[..]);#assert state[0].error==0 && r.mask==9 && memory[0].scope[0]==7 && memory[0].height[0]==3;
}
#test "a top-level summary does not invent an ancestor" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;args:=[1]AgValue.[AgValue.{mask=4}];
 memory[0].memo_count=1;memory[0].memo[0].procedure=2;memory[0].memo[0].count=1;memory[0].memo[0].args[0]=AgValue.{type=-1,mask=4};memory[0].memo[0].result=AgValue.{type=-1,mask=9};memory[0].memo[0].closure=1;memory[0].memo[0].height=1;
 r:=AG_procedure(f.nodes[..],values[..],f.roots[..],f.types[0..<1],2,args[..],memory[..],state[..]);#assert state[0].error==0 && r.mask==9;
}
#test "memo saturation and view inputs fall back to direct analysis" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;args:=[1]AgValue.[AgValue.{mask=4,view=true}];
 memory[0].memo_count=1;memory[0].memo[0].procedure=2;memory[0].memo[0].count=1;memory[0].memo[0].args[0]=AgValue.{type=-1,mask=4};memory[0].memo[0].result=AgValue.{type=-1,mask=9};memory[0].memo[0].closure=1;memory[0].memo[0].height=1;
 r:=AG_procedure(f.nodes[..],values[..],f.roots[..],f.types[0..<1],2,args[..],memory[..],state[..]);#assert state[0].error==0 && r.mask==4 && memory[0].memo_count==1;
 state[0]=ScAudit.{};memory[0]=AgMemory.{memo_count=128};args[0].view=false;r=AG_procedure(f.nodes[..],values[..],f.roots[..],f.types[0..<1],2,args[..],memory[..],state[..]);#assert state[0].error==0 && r.mask==4 && memory[0].memo_count==128;
}
#test "direct completed calls propagate a new seen bit to their parent" {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;args:=[1]AgValue.[AgValue.{mask=4}];
 state[0].depth=1;state[0].count=1;state[0].stack[0]=8;state[0].seen[0]=8;memory[0].scope[0]=1;memory[0].height[0]=1;
 r:=AG_procedure(f.nodes[..],values[..],f.roots[..],f.types[0..<1],2,args[..],memory[..],state[..]);#assert state[0].error==0 && r.mask==4 && memory[0].scope[0]==3 && memory[0].height[0]==2 && memory[0].memo[0].closure==2;
}
#forall "summary candidate identity and the exact depth boundary are checked" variant:0..<3 {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;args:=[1]AgValue.[AgValue.{mask=4}];
 level:=ifx variant==2 then 14 else 0;state[0].depth=level;state[0].count=level;for i:0..<level {state[0].stack[i]=8+i;state[0].seen[i]=8+i;}
 memory[0].memo_count=1;memory[0].memo[0].procedure=ifx variant==0 then 3 else 2;memory[0].memo[0].count=ifx variant==1 then 2 else 1;memory[0].memo[0].args[0]=AgValue.{type=-1,mask=4};memory[0].memo[0].result=AgValue.{type=-1,mask=9};memory[0].memo[0].closure=0;memory[0].memo[0].height=2;
 r:=AG_procedure(f.nodes[..],values[..],f.roots[..],f.types[0..<1],2,args[..],memory[..],state[..]);#assert state[0].error==0 && r.mask==cast(u64)(ifx variant==2 then 9 else 4);
}
#forall "cached closure falls back for an active ancestor or depth limit" variant:0..<3 {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;args:=[1]AgValue.[AgValue.{mask=4}];
 level:=ifx variant==1 then 15 else 1;state[0].depth=level;state[0].count=level;
 for i:0..<level {state[0].stack[i]=8+i;state[0].seen[i]=8+i;}
 if variant==0 {state[0].count=2;state[0].seen[1]=9;state[0].stack[0]=9;}
 memory[0].memo_count=1;memory[0].memo[0].procedure=2;memory[0].memo[0].count=1;memory[0].memo[0].args[0]=AgValue.{type=-1,mask=4};
 memory[0].memo[0].closure=ifx variant==0 then cast(u64)2 else ifx variant==2 then cast(u64)1 else cast(u64)0;memory[0].memo[0].height=ifx variant==1 then 2 else 1;
 r:=AG_procedure(f.nodes[..],values[..],f.roots[..],f.types[0..<1],2,args[..],memory[..],state[..]);
 #assert state[0].error==0 && r.mask==4 && state[0].depth==level;
}
AgFixture :: struct {nodes:[64]ScNode;values:[64]u64;roots:[1]int;types:[8]ScType;}
AG_fixture :: ()->AgFixture {
 f:AgFixture;base:=SC_fixture();for node,index:base.nodes {f.nodes[index]=node;}f.roots=base.roots;f.types[0]=base.types[0];
 f.nodes[2].next=8;f.nodes[5].a=12;f.types[0].type="Pair";
 f.nodes[8]=ScNode.{kind=66,name="Pair",head=9};f.nodes[9]=ScNode.{kind=69,name="words",a=10};f.nodes[10]=ScNode.{kind=2,a=11,b=3};f.nodes[11]=ScNode.{kind=16};f.values[11]=2;f.nodes[12]=ScNode.{kind=1,name="Pair"};
 f.nodes[7]=ScNode.{kind=26,a=13,b=15};f.nodes[13]=ScNode.{kind=25,name="words",a=14};f.nodes[14]=ScNode.{kind=20,name="x"};f.nodes[15]=ScNode.{kind=16};return f;
}
AG_fixture_check :: (input:AgFixture)->ScResult {f:=input;memory:[1]AgMemory;return AG_check(f.nodes[..],f.values[..],f.roots[..],f.types[..],"candidate",memory[..]);}
#forall "array and field traversal preserve secret origins and reject secret or out-of-range indices" variant:0..<10 {
 f:=AG_fixture();want:=cast(u32)0;
 if variant==1 {f.nodes[15]=f.nodes[7];f.nodes[15].b=16;f.nodes[16]=ScNode.{kind=16};want=SC_INDEX;}
 if variant==2 {f.values[15]=2;want=SC_LIMIT;}
 if variant==3 {f.nodes[13].name="missing";want=SC_TYPE;}
 if variant==4 {f.nodes[7]=ScNode.{kind=31,a=16,b=17,c=18};f.nodes[16]=ScNode.{kind=23,a=19,b=20,op=44};f.nodes[19]=ScNode.{kind=26,a=13,b=15};f.nodes[20]=ScNode.{kind=16};f.nodes[17]=ScNode.{kind=16};f.nodes[18]=ScNode.{kind=16};want=SC_BRANCH;}
 if variant==5 {f.nodes[10].kind=4;want=SC_TYPE;}
 if variant==6 {f.nodes[3].name="f64";want=SC_TYPE;}
 if variant==7 {f.values[11]=0;want=SC_TYPE;}
 if variant==8 {f.values[11]=1025;want=SC_TYPE;}
 if variant==9 {f.nodes[9].a=12;want=SC_TYPE;}
 r:=AG_fixture_check(f);#assert r.error==want;if want==0 {#assert r.return_mask==1;}
}
#test "typed fixed arrays and known-origin views use source metadata rather than a declared flow proof" {
 f:=AG_fixture();state:[1]ScAudit;
 #assert AG_match(f.nodes[..],f.values[..],f.roots[..],10,"[2] u64",state[..],0);
 #assert !AG_match(f.nodes[..],f.values[..],f.roots[..],10,"[3] u64",state[..],0);
 f.nodes[16]=ScNode.{kind=3,b=3};#assert AG_match(f.nodes[..],f.values[..],f.roots[..],16,"[] u64",state[..],0);
 memory:[1]AgMemory;a:=AG_new(f.nodes[..],f.values[..],f.roots[..],AgValue.{mask=1},10,memory[..],state[..]);a.view=true;
 b:=AG_new(f.nodes[..],f.values[..],f.roots[..],a,16,memory[..],state[..]);#assert b.region==a.region && b.view && b.extent==2 && AG_origin(b,memory[..])==1;
 memory[0].taint[a.region]|=2;#assert AG_origin(b,memory[..])==3;
}
#test "aggregate copies cannot regain stale literal field bounds" {
 f:=AG_fixture();state:[1]ScAudit;memory:[1]AgMemory;
 original:=AG_new(f.nodes[..],f.values[..],f.roots[..],AgValue.{literal=17},12,memory[..],state[..]);
 clean:=AG_new(f.nodes[..],f.values[..],f.roots[..],original,12,memory[..],state[..]);
 #assert clean.literal==17 && clean.region!=original.region;
 memory[0].dirty[original.region]=true;
 changed:=AG_new(f.nodes[..],f.values[..],f.roots[..],original,12,memory[..],state[..]);
 #assert changed.literal==0 && !changed.known && changed.region!=original.region && state[0].error==0;
}
#test "aggregate identity casts refuse instead of discarding region provenance" {
 f:=AG_fixture();state:[1]ScAudit;memory:[1]AgMemory;env:[1]AgEnv;
 f.nodes[16]=ScNode.{kind=30,a=17,d=12};f.nodes[17]=ScNode.{kind=20,name="p"};
 value:=AG_new(f.nodes[..],f.values[..],f.roots[..],AgValue.{literal=18},12,memory[..],state[..]);
 memory[0].dirty[value.region]=true;AG_bind(env[..],"p",value,state[..],17);
 ignored:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[..],16,env[..],memory[..],state[..],0);
 #assert state[0].error==SC_UNSUPPORTED;
}
#forall "byte arithmetic bounds do not ignore release wrapping" variant:0..<4 {
 memory:[1]AgMemory;state:[1]ScAudit;a:=AG_number(ifx variant==0 then 254 else 255);a.type=ifx variant==3 then -4 else -5;b:=AG_number(ifx variant==2 then 2 else 1);b.type=a.type;
 r:=AG_binary(a,b,ifx variant==2 then 36 else 34,memory[..],state[..],1);
 #assert state[0].error==0 && r.known==(variant==0 || variant==3);if variant==0 || variant==3 {#assert r.lo==(ifx variant==0 then 255 else 256) && r.hi==r.lo;}
}
#forall "possibly empty public ranges refuse without guessing a loop result" end_value:1..<3 {
 f:=SC_fixture();values:[32]u64;f.nodes[6]=ScNode.{kind=47,name="i",a=16,b=17,c=18};f.nodes[16]=ScNode.{kind=20,name="start"};f.nodes[17]=ScNode.{kind=16};values[17]=cast(u64)end_value;f.nodes[18]=ScNode.{kind=40};
 f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"};env:=[1]AgEnv.[AgEnv.{procedure=2}];memory:[1]AgMemory;state:[1]ScAudit;AG_bind(env[..],"start",AgValue.{type=-4,known=true,lo=0,hi=1},state[..],5);
 r:=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<2],4,env[..],memory[..],state[..],0);#assert state[0].error==cast(u32)(ifx end_value==1 then SC_UNSUPPORTED else 0);
}
#forall "known public loops carry aggregate origins and refuse secret bounds or indices" variant:0..<9 {
 f:=AG_fixture();f.nodes[6]=ScNode.{kind=42,name="r",line=2,d=12,next=16};f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="r",line=2,role="local",type="Pair"};
 f.nodes[16]=ScNode.{kind=47,name="i",a=17,b=18,c=19,next=28};f.nodes[17]=ScNode.{kind=16};f.nodes[18]=ScNode.{kind=16};f.values[18]=2;f.nodes[19]=ScNode.{kind=40,head=20};
 f.nodes[20]=ScNode.{kind=43,c=21,a=25,op=23};f.nodes[21]=ScNode.{kind=26,a=22,b=24};f.nodes[22]=ScNode.{kind=25,name="words",a=23};f.nodes[23]=ScNode.{kind=20,name="r"};f.nodes[24]=ScNode.{kind=20,name="i"};
 f.nodes[25]=ScNode.{kind=26,a=26,b=24};f.nodes[26]=ScNode.{kind=25,name="words",a=27};f.nodes[27]=ScNode.{kind=20,name="x"};f.nodes[28]=ScNode.{kind=44,a=29};f.nodes[29]=ScNode.{kind=26,a=30,b=32};f.nodes[30]=ScNode.{kind=25,name="words",a=31};f.nodes[31]=ScNode.{kind=20,name="r"};f.nodes[32]=ScNode.{kind=16};
 want:=cast(u32)0;if variant==1 {f.nodes[16].b=7;want=SC_BRANCH;}if variant==2 {f.nodes[21].b=7;want=SC_INDEX;}if variant==3 {f.values[18]=4097;want=SC_LIMIT;}if variant==4 {f.nodes[20]=ScNode.{kind=44,a=7};want=SC_UNSUPPORTED;}if variant==5 {f.nodes[20].c=24;f.nodes[20].a=7;want=SC_BRANCH;}if variant==6 {f.nodes[20].c=24;f.nodes[20].a=17;want=SC_UNSUPPORTED;}
 if variant==7 {f.values[18]=0;want=SC_UNSUPPORTED;}if variant==8 {f.values[18]=1;}
 f.types[2]=ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"};memory:[1]AgMemory;r:=AG_check(f.nodes[..],f.values[..],f.roots[..],f.types[0..<3],"candidate",memory[..]);#assert r.error==want;if want==0 {#assert r.return_mask==1;}
}
#forall "new-profile public comparisons retain independent interval endpoints" op:34..<52,a:0..<4,b:0..<4 {
 memory:[1]AgMemory;state:[1]ScAudit;r:=AG_binary(AG_number(a),AG_number(b),cast(u32)op,memory[..],state[..],7);
 if op==34 {#assert r.known && r.lo==a+b && r.hi==a+b;}
 if op==35 {#assert r.known==(a>=b);if a>=b {#assert r.lo==a-b && r.hi==a-b;}}
 if op==36 {#assert r.known && r.lo==a*b && r.hi==a*b;}
 if op==37 {#assert r.known==(b>0);if b>0 {#assert r.lo==a/b && r.hi==a/b;}}
 if op==38 {#assert r.known==(b>0);if b>0 {#assert r.lo==0 && r.hi==b-1;}}
 if op>=44 {want:=false;if op==44 {want=a==b;}if op==45 {want=a!=b;}if op==46 {want=a<b;}if op==47 {want=a<=b;}if op==48 {want=a>b;}if op==49 {want=a>=b;}if op==50 {want=a!=0 && b!=0;}if op==51 {want=a!=0 || b!=0;}#assert r.known && r.lo==cast(int)(ifx want then 1 else 0) && r.hi==r.lo;}
}

#test "view containers never invent an alias for their nested elements" {
 f:=AG_fixture();f.nodes[16]=ScNode.{kind=3,b=3};f.nodes[10].b=16;state:[1]ScAudit;#assert !AG_valid_type(f.nodes[..],f.values[..],f.roots[..],10,false,state[..],0);
 f.nodes[10].b=3;state[0]=ScAudit.{};#assert AG_valid_type(f.nodes[..],f.values[..],f.roots[..],16,true,state[..],0);#assert !AG_valid_type(f.nodes[..],f.values[..],f.roots[..],16,true,state[..],1);
}

#forall "primitive identity and unsupported negative tags cannot bypass type admission" tag:-6..<1 {
 f:=SC_fixture();state:[1]ScAudit;got:=AG_type(f.nodes[..],f.roots[..],tag,state[..]);
 if tag>=-5 && tag<0 {#assert got==tag && state[0].error==0 && AG_primitive(AG_primitive_name(tag))==tag;}else {#assert got==0 && state[0].error==SC_TYPE && state[0].where==0;}
}
#test "aggregate budget refusal and previous errors preserve their diagnostics" {
 state:=[1]ScAudit.[ScAudit.{visits=AG_visit_limit()-1}];#assert AG_tick(state[..],7) && state[0].visits==AG_visit_limit() && state[0].error==0;
 #assert !AG_tick(state[..],8) && state[0].error==SC_LIMIT && state[0].where==8;
 state[0]=ScAudit.{error=SC_CALL,where=9};#assert !AG_tick(state[..],1) && state[0].error==SC_CALL && state[0].where==9;
}
