 f.nodes[6]=ScNode.{kind=45,a=7,c=8,d=11};f.nodes[7]=ScNode.{kind=18};values[7]=cast(u64)condition;
 f.nodes[8]=ScNode.{kind=40,head=9};f.nodes[9]=ScNode.{kind=42,name="z",line=2,d=3,next=14};f.nodes[14]=ScNode.{kind=44,a=10};f.nodes[10]=ScNode.{kind=20,name="x"};
 f.nodes[11]=ScNode.{kind=40,head=12};f.nodes[12]=ScNode.{kind=44,a=13};f.nodes[13]=ScNode.{kind=16};f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="u64"};
 r:=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<2],4,env[..],memory[..],state[..],0);#assert state[0].error==0 && r.returned && AG_origin(r.value,memory[..])==cast(u64)condition && env[0].count==1;
}
#forall "block budgets and unsupported statement diagnostics retain their owning node" variant:0..<11 {
 f:=SC_fixture();values:[32]u64;memory:[1]AgMemory;state:[1]ScAudit;env:=[1]AgEnv.[AgEnv.{procedure=2}];AG_bind(env[..],"x",AgValue.{type=-1,mask=1},state[..],5);depth:=0;id:=4;want:=cast(u32)0;where:=0;
 if variant==1 {depth=16;want=SC_LIMIT;where=4;}if variant==2 {state[0].visits=AG_visit_limit();want=SC_LIMIT;where=4;}if variant==3 {state[0].visits=AG_visit_limit()-1;want=SC_LIMIT;where=6;}
 if variant==4 {id=7;want=SC_UNSUPPORTED;where=7;}if variant==5 {f.nodes[6].next=8;f.nodes[8]=ScNode.{kind=44,a=7};want=SC_UNSUPPORTED;where=8;}
 if variant==6 {f.nodes[6].kind=41;want=SC_UNSUPPORTED;where=6;}if variant==7 {f.nodes[6]=ScNode.{kind=42,name="z",flag=true};want=SC_UNSUPPORTED;where=6;}
 if variant==8 || variant==9 {f.nodes[6]=ScNode.{kind=45,a=7};env[0].bindings[0].value.mask=0;env[0].bindings[0].value.type=-3;if variant==9 {env[0].bindings[0].value.known=true;env[0].bindings[0].value.hi=1;}want=SC_UNSUPPORTED;where=6;}
 if variant==10 {depth=15;}
 r:=AG_block(f.nodes[..],values[..],f.roots[..],f.types[0..<1],id,env[..],memory[..],state[..],depth);#assert state[0].error==want && state[0].where==where;if want==0 {#assert r.returned && r.value.mask==1;}
}
