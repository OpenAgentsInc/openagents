 f:=SC_fixture();f.nodes[6]=ScNode.{kind=43,c=7};f.nodes[7]=ScNode.{kind=20,name="x"};id:=4;depth:=14+extra;
 if kind!=0 {f.nodes[8]=ScNode.{kind=cast(u32)(ifx kind==1 then 47 else 45),c=4};id=8;depth=13+extra;}
 if kind==2 {f.nodes[8].d=9;f.nodes[9]=ScNode.{kind=40,head=10};f.nodes[10]=ScNode.{kind=43,c=11};f.nodes[11]=ScNode.{kind=20,name="y"};}
 memory:[1]AgMemory;state:[1]ScAudit;env:[1]AgEnv;AG_bind(env[..],"x",AgValue.{type=-1,mask=1,known=true},state[..],5);AG_bind(env[..],"y",AgValue.{type=-1,mask=2,known=true},state[..],5);
 AG_loop_marks(f.nodes[..],id,env[..],memory[..],state[..],4,depth);#assert state[0].error==cast(u32)(ifx extra==0 then 0 else SC_LIMIT);
 if extra==0 {#assert env[0].bindings[0].value.mask==5 && !env[0].bindings[0].value.known;if kind==2 {#assert env[0].bindings[1].value.mask==6 && !env[0].bindings[1].value.known;}}
}
