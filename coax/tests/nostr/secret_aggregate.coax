 r:=AG_new(f.nodes[..],f.values[..],f.roots[..],AgValue.{mask=1,type=8,region=1,view=true},3,memory[..],state[..]);#assert r.mask==3 && r.type==-1 && r.region==0 && !r.view;
 state[0]=ScAudit.{};r=AG_new(f.nodes[..],f.values[..],f.roots[..],AgValue.{mask=1},-4,memory[..],state[..]);#assert state[0].error==SC_TYPE && state[0].where==0;
}
#forall "public block conditions select only their actual branch and restore local scope" condition:0..<2 {
