 value:=AgValue.{mask=1,type=8,literal=24,lo=2,hi=3,known=true,region=1,extent=4,view=true};copy:=AG_new(f.nodes[..],f.values[..],f.roots[..],value,8,memory[..],state[..]);
 #assert copy.mask==3 && copy.type==8 && copy.literal==24 && copy.lo==2 && copy.hi==3 && copy.known && copy.region==2 && !copy.view && memory[0].taint[2]==3;
 f.nodes[16]=ScNode.{kind=3,b=3};view:=AG_new(f.nodes[..],f.values[..],f.roots[..],value,16,memory[..],state[..]);#assert view.region==1 && view.extent==4 && view.view && view.mask==3;
 state[0]=ScAudit.{};bad:=AG_new(f.nodes[..],f.values[..],f.roots[..],AgValue.{},16,memory[..],state[..]);#assert state[0].error==SC_UNSUPPORTED && bad.region==0;
 state[0]=ScAudit.{};memory[0].used=AG_region_limit()-1;bad=AG_new(f.nodes[..],f.values[..],f.roots[..],AgValue.{},8,memory[..],state[..]);#assert state[0].error==SC_LIMIT && bad.region==0;
}
