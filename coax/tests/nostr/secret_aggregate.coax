#forall "aggregate expression edges preserve the exact nesting limit" variant:0..<10,extra:0..<2 {
 f:=SC_fixture();nodes:[100]ScNode;values:[100]u64;for i:0..<32 {nodes[i]=f.nodes[i];}
 length:=14+extra;for i:0..<length {nodes[32+i]=ScNode.{kind=22,a=33+i,op=52};}nodes[32+length]=ScNode.{kind=18};
 nodes[9]=ScNode.{kind=18};nodes[10]=ScNode.{kind=18};
 if variant==0 {nodes[2].next=8;nodes[8]=ScNode.{kind=65,name="K",a=32};nodes[7]=ScNode.{kind=20,name="K"};}
 else if variant==1 {nodes[7]=ScNode.{kind=22,a=32,op=52};}
 else if variant==2 {nodes[7]=ScNode.{kind=23,a=32,b=9,op=39};}
 else if variant==3 {nodes[7]=ScNode.{kind=23,a=9,b=32,op=39};}
 else if variant==4 {nodes[7]=ScNode.{kind=30,a=32,d=3};}
 else if variant==5 {nodes[7]=ScNode.{kind=31,a=32,b=9,c=10};}
 else if variant==6 {nodes[7]=ScNode.{kind=31,a=9,b=32,c=10};}
 else if variant==7 {nodes[7]=ScNode.{kind=31,a=9,b=10,c=32};}
 else if variant==8 {nodes[7]=ScNode.{kind=26,a=9,b=32};}
 else {nodes[7]=ScNode.{kind=21,name="value_barrier",head=32};}
 state:[1]ScAudit;env:[1]AgEnv;memory:[1]AgMemory;value:=AG_expr(nodes[..],values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);
 #assert value.mask==0 && state[0].error==cast(u32)(ifx extra==1 then SC_LIMIT else ifx variant==8 then SC_TYPE else 0);
}
#forall "aggregate procedure expression roots retain the whole local nesting budget" variant:0..<6 {
 f:=SC_fixture();nodes:[100]ScNode;values:[100]u64;for i:0..<32 {nodes[i]=f.nodes[i];}nodes[3].name="bool";f.types[0].type="bool";
 for i:0..<15 {nodes[32+i]=ScNode.{kind=22,a=33+i,op=52};}nodes[47]=ScNode.{kind=20,name="x"};
 types:=[2]ScType.[f.types[0],ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="bool"}];
 if variant==0 {nodes[6].a=32;}
 else if variant==1 {nodes[6]=ScNode.{kind=42,name="z",line=2,a=32,next=8};nodes[8]=ScNode.{kind=44,a=9};nodes[9]=ScNode.{kind=20,name="z"};}
 else if variant==2 {nodes[6]=ScNode.{kind=42,name="z",line=2,next=8};nodes[8]=ScNode.{kind=43,c=9,a=32,op=23,next=10};nodes[9]=ScNode.{kind=20,name="z"};nodes[10]=ScNode.{kind=44,a=9};}
 else if variant==5 {nodes[6]=ScNode.{kind=52,a=32,next=8};nodes[8]=ScNode.{kind=44,a=7};}
 else {nodes[6]=ScNode.{kind=cast(u32)(42+variant),a=32};}
 memory:[1]AgMemory;r:=AG_check(nodes[..],values[..],f.roots[..],types[..],"candidate",memory[..]);#assert r.error==cast(u32)(ifx variant<3 then 0 else ifx variant==5 then AG_GUARDS else SC_BRANCH);
 if variant<3 {#assert r.return_mask==1;}
}
