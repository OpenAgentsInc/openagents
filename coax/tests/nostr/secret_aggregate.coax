 state:[1]ScAudit;r:=AG_literal_field(f.nodes[..],f.values[..],16,f.nodes[9],state[..],5+extra);#assert state[0].error==cast(u32)(ifx extra==0 then 0 else SC_LIMIT);if extra==0 {#assert r.known && r.lo==4096 && r.hi==4096;}
