 f:=AG_fixture();nodes:[100]ScNode;values:[100]u64;for i:0..<64 {nodes[i]=f.nodes[i];values[i]=f.values[i];}nodes[7]=ScNode.{kind=27,a=17,c=32};nodes[17]=ScNode.{kind=20,name="a"};nodes[15]=ScNode.{kind=16};
 for i:0..<14+extra {nodes[32+i]=ScNode.{kind=23,a=33+i,b=15,op=34};}nodes[46+extra]=ScNode.{kind=16};values[46+extra]=1;
 memory:=[1]AgMemory.[AgMemory.{used=1}];state:[1]ScAudit;env:[1]AgEnv;AG_bind(env[..],"a",AgValue.{type=10,region=1,extent=2},state[..],5);
 r:=AG_expr(nodes[..],values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert state[0].error==cast(u32)(ifx extra==0 then 0 else SC_LIMIT);
}
#forall "slice guards admit equality and reject empty backing extents" variant:0..<3 {
 f:=AG_fixture();f.nodes[7]=ScNode.{kind=27,a=17,b=15,c=18};f.nodes[17]=ScNode.{kind=20,name="a"};f.nodes[18]=ScNode.{kind=16};f.values[15]=1;f.values[18]=1;
 memory:=[1]AgMemory.[AgMemory.{used=1}];state:[1]ScAudit;env:[1]AgEnv;AG_bind(env[..],"a",AgValue.{type=10,region=1,extent=ifx variant==2 then 0 else ifx variant==1 then 1 else 2},state[..],5);
 r:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert state[0].error==cast(u32)(ifx variant==2 then SC_TYPE else 0);if variant<2 {#assert r.view && r.extent==0;}
}
#forall "cast snapshots do not retain an alias and zero remains an exact byte value" variant:0..<3 {
 f:=SC_fixture();values:[32]u64;f.nodes[7]=ScNode.{kind=30,a=8,d=9,flag=true};f.nodes[8]=ScNode.{kind=20,name="x"};f.nodes[9]=ScNode.{kind=1,name=ifx variant==2 then "u64" else "u8"};
 memory:=[1]AgMemory.[AgMemory.{used=1}];memory[0].taint[1]=2;state:[1]ScAudit;env:[1]AgEnv;AG_bind(env[..],"x",AgValue.{type=-1,region=1,mask=1,known=true,lo=ifx variant==2 then 256 else 0,hi=ifx variant==2 then 256 else 0},state[..],5);
 r:=AG_expr(f.nodes[..],values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert state[0].error==0 && r.mask==3 && r.region==0 && r.known;
}
#forall "secret checked casts refuse even when hidden behind a tainted region" secret:0..<2,trunc:0..<2 {
 f:=SC_fixture();values:[32]u64;f.nodes[7]=ScNode.{kind=30,a=8,d=9,flag=trunc==1};f.nodes[8]=ScNode.{kind=20,name="x"};f.nodes[9]=ScNode.{kind=1,name="u8"};
 memory:=[1]AgMemory.[AgMemory.{used=1}];memory[0].taint[1]=cast(u64)secret;state:[1]ScAudit;env:[1]AgEnv;
 AG_bind(env[..],"x",AgValue.{type= -1,region=1},state[..],5);
 r:=AG_expr(f.nodes[..],values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);
 #assert state[0].error==cast(u32)(ifx secret==1 && trunc==0 then SC_UNSUPPORTED else 0);
 if state[0].error==0 {#assert r.mask==cast(u64)secret && r.region==0;}
}
#test "source field snapshots materialize all origins even before later region writes" {
 f:=AG_fixture();f.nodes[9].a=3;f.nodes[7]=ScNode.{kind=25,a=14,name="words"};memory:=[1]AgMemory.[AgMemory.{used=1}];memory[0].taint[1]=2;state:[1]ScAudit;env:[1]AgEnv;AG_bind(env[..],"x",AgValue.{type=8,mask=1,region=1},state[..],5);
 r:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert r.mask==3 && r.region==1 && state[0].error==0;
}
#forall "compound element writes enforce variable-time exclusions without a scalar-assignment fallback" op:27..<34,rhs_secret:0..<2 {
 f:=AG_fixture();memory:=[1]AgMemory.[AgMemory.{used=1}];state:[1]ScAudit;env:[1]AgEnv;AG_bind(env[..],"x",AgValue.{type=8,region=1},state[..],5);memory[0].taint[1]=ifx rhs_secret==1 then 0 else 1;
 rhs:=AgValue.{type=-1,mask=cast(u64)rhs_secret};AG_write(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,rhs,cast(u32)op,env[..],memory[..],state[..]);want:=cast(u32)0;if op==27 || op==28 {want=SC_UNSUPPORTED;}if (op==32 || op==33)&&rhs_secret==1 {want=SC_SHIFT;}
 #assert state[0].error==want;
}
