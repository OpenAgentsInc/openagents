 f:=AG_fixture();f.nodes[16]=ScNode.{kind=3,b=3};f.nodes[7]=ScNode.{kind=20,name="v"};memory:=[1]AgMemory.[AgMemory.{used=1}];state:[1]ScAudit;env:[1]AgEnv;AG_bind(env[..],"v",AgValue.{type=16,view=true,region=1,extent=2},state[..],5);
 AG_write(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,AG_number(0),23,env[..],memory[..],state[..]);#assert state[0].error==SC_UNSUPPORTED;
 f.nodes[7].name="K";f.nodes[8].next=17;f.nodes[17]=ScNode.{kind=65,name="K",a=18};f.nodes[18]=ScNode.{kind=16};state[0]=ScAudit.{};
 AG_write(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,AG_number(0),23,env[..],memory[..],state[..]);#assert state[0].error==SC_CALL && state[0].where==7;
 state[0]=ScAudit.{};f.nodes[7].name="v";env[0].bindings[0].value=AgValue.{type=-1};AG_write(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,AG_number(1),23,env[..],memory[..],state[..]);#assert env[0].bindings[0].value.type==-1;
}
#test "public literal field traversal uses the complete source-type depth budget" {
 f:=AG_fixture();f.nodes[9].a=3;for i:0..<6 {f.nodes[20+i]=ScNode.{kind=29,head=21+i,d=32+i};f.nodes[32+i]=ScNode.{kind=2,a=38,b=ifx i==5 then 12 else 33+i};}f.nodes[38]=ScNode.{kind=16};f.values[38]=1;
 f.nodes[26]=ScNode.{kind=28,d=12,head=27};f.nodes[27]=ScNode.{kind=71,name="words",a=28};f.nodes[28]=ScNode.{kind=16};f.values[28]=7;f.nodes[7]=ScNode.{kind=25,a=14,name="words"};
 memory:[1]AgMemory;env:[1]AgEnv;state:[1]ScAudit;#assert AG_valid_type(f.nodes[..],f.values[..],f.roots[..],32,false,state[..],0);
 AG_bind(env[..],"x",AgValue.{type=8,literal=20},state[..],5);r:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert state[0].error==0 && r.known && r.lo==7 && r.hi==7;
}
