#forall "comparison interval hulls match enumeration at touching and singleton boundaries" op:44..<52,left:0..<6,right:0..<6 {
 lows:=[6]int.[0,0,0,1,1,2];highs:=[6]int.[0,1,2,1,2,2];a:=AgValue.{type=-1,known=true,lo=lows[left],hi=highs[left]};b:=AgValue.{type=-1,known=true,lo=lows[right],hi=highs[right]};lo:=1;hi:=0;
 for x:a.lo..<a.hi+1 {for y:b.lo..<b.hi+1 {v:=false;if op==44 {v=x==y;}if op==45 {v=x!=y;}if op==46 {v=x<y;}if op==47 {v=x<=y;}if op==48 {v=x>y;}if op==49 {v=x>=y;}if op==50 {v=x!=0 && y!=0;}if op==51 {v=x!=0 || y!=0;}if v {hi=1;}else {lo=0;}}}
 memory:[1]AgMemory;state:[1]ScAudit;r:=AG_binary(a,b,cast(u32)op,memory[..],state[..],1);#assert r.known && r.lo==lo && r.hi==hi;
}
#test "oversized decimal metadata fails with an explicit limit diagnostic" {
 f:=AG_fixture();state:[1]ScAudit;#assert !AG_match(f.nodes[..],f.values[..],f.roots[..],10,"[1025]u64",state[..],0) && state[0].error==SC_LIMIT && state[0].where==0;
}
#test "array-type refusal never reports success after an invalid canonical reference or extent" {
 f:=AG_fixture();state:[1]ScAudit;#assert !AG_valid_type(f.nodes[..],f.values[..],f.roots[..],0,true,state[..],0);
 state[0]=ScAudit.{};f.values[11]=0;#assert !AG_valid_type(f.nodes[..],f.values[..],f.roots[..],10,true,state[..],0);
}
#forall "top-level view type recursion still charges its element depth" extra:0..<2 {
 f:=AG_fixture();f.nodes[16]=ScNode.{kind=3,b=17};for i:0..<6+extra {f.nodes[17+i]=ScNode.{kind=2,a=11,b=ifx i==5+extra then 3 else 18+i};}
 state:[1]ScAudit;#assert AG_valid_type(f.nodes[..],f.values[..],f.roots[..],16,true,state[..],0)==(extra==0);
}
#test "schema-kind projection guards refuse invalid field and constructor lists" {
 f:=AG_fixture();f.nodes[9].kind=70;state:[1]ScAudit;#assert AG_field(f.nodes[..],8,"words",state[..])==0 && state[0].error==SC_TYPE && state[0].where==9;
 state[0]=ScAudit.{};#assert !AG_valid_type(f.nodes[..],f.values[..],f.roots[..],8,true,state[..],0);
 f=AG_fixture();f.nodes[16]=ScNode.{kind=28,d=12,head=17};f.nodes[17]=ScNode.{kind=70,name="words",a=18};f.nodes[18]=ScNode.{kind=16};state[0]=ScAudit.{};
 r:=AG_literal_field(f.nodes[..],f.values[..],16,f.nodes[9],state[..],0);#assert !r.known && state[0].error==SC_GRAPH;
 state[0]=ScAudit.{};memory:[1]AgMemory;env:[1]AgEnv;r=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],16,env[..],memory[..],state[..],0);#assert state[0].error==SC_GRAPH;
}
#test "failed target and metadata lookups retain a nil source handle" {
 f:=AG_fixture();state:=[1]ScAudit.[ScAudit.{visits=AG_visit_limit()}];#assert AG_target_root(f.nodes[..],7,state[..])==0 && state[0].error==SC_LIMIT;
 state[0]=ScAudit.{};#assert AG_resolved(f.nodes[..],f.values[..],f.roots[..],f.types[0..<0],f.nodes[2],f.nodes[5],"parameter",state[..])==0 && state[0].where==0;
 state[0]=ScAudit.{};f.types[0].type="Unknown";#assert AG_resolved(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],f.nodes[2],f.nodes[5],"parameter",state[..])==0 && state[0].where==0;
}
#test "literal field joins discard a known range when any element is unknown" {
 f:=AG_fixture();f.nodes[9].a=3;f.nodes[16]=ScNode.{kind=29,head=17};f.nodes[17]=ScNode.{kind=28,d=12,head=18,next=20};f.nodes[18]=ScNode.{kind=71,name="words",a=19};f.nodes[19]=ScNode.{kind=16};f.values[19]=7;f.nodes[20]=ScNode.{kind=28,d=12,head=21};f.nodes[21]=ScNode.{kind=71,name="words",a=22};f.nodes[22]=ScNode.{kind=20};state:[1]ScAudit;
 r:=AG_literal_field(f.nodes[..],f.values[..],16,f.nodes[9],state[..],0);#assert !r.known;
}
#forall "a top-level procedure body keeps its complete lexical depth budget" extra:0..<2 {
 f:=SC_fixture();nodes:[100]ScNode;values:[100]u64;for i:0..<32 {nodes[i]=f.nodes[i];}nodes[7]=ScNode.{kind=18};values[7]=1;nodes[14]=ScNode.{kind=20,name="x"};
 parent:=4;for i:0..<15+extra {branch:=32+i*2;child:=branch+1;nodes[parent].head=branch;nodes[branch]=ScNode.{kind=45,a=7,c=child};nodes[child]=ScNode.{kind=40};parent=child;}
 nodes[parent].head=64;nodes[64]=ScNode.{kind=44,a=14};state:[1]ScAudit;memory:[1]AgMemory;args:=[1]AgValue.[AgValue.{mask=1}];r:=AG_procedure(nodes[..],values[..],f.roots[..],f.types[0..<1],2,args[..],memory[..],state[..]);#assert state[0].error==cast(u32)(ifx extra==0 then 0 else SC_LIMIT);if extra==0 {#assert r.mask==1;}
}
#forall "public loop bound expressions start with the full expression budget" side:0..<2 {
 f:=SC_fixture();nodes:[100]ScNode;values:[100]u64;for i:0..<32 {nodes[i]=f.nodes[i];}nodes[6]=ScNode.{kind=47,name="i",a=16,b=17,c=18};nodes[16]=ScNode.{kind=16};nodes[17]=ScNode.{kind=16};nodes[18]=ScNode.{kind=40};
 for i:0..<15 {nodes[32+i]=ScNode.{kind=23,a=33+i,b=16,op=34};}nodes[47]=ScNode.{kind=16};if side==0 {nodes[6].a=32;values[17]=1;}else {nodes[6].b=32;values[47]=1;}
 types:=[1]ScType.[ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"}];env:=[1]AgEnv.[AgEnv.{procedure=2}];state:[1]ScAudit;memory:[1]AgMemory;r:=AG_block(nodes[..],values[..],f.roots[..],types[..],4,env[..],memory[..],state[..],0);#assert state[0].error==0;
}
#forall "aggregate backedge origins do not invent a first-parameter bit or skip the first region" origin:0..<2 {
 f:=AG_fixture();f.nodes[6]=ScNode.{kind=47,name="i",a=16,b=17,c=18};f.nodes[16]=ScNode.{kind=16};f.nodes[17]=ScNode.{kind=16};f.values[17]=1;f.nodes[18]=ScNode.{kind=40};f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="i",role="loop",type="int"};
 memory:=[1]AgMemory.[AgMemory.{used=1}];env:=[1]AgEnv.[AgEnv.{procedure=2}];state:[1]ScAudit;AG_bind(env[..],"a",AgValue.{type=10,region=1,extent=2},state[..],5);AG_bind(env[..],"x",AgValue.{type=-1,mask=cast(u64)origin*2},state[..],5);
 r:=AG_block(f.nodes[..],f.values[..],f.roots[..],f.types[0..<2],4,env[..],memory[..],state[..],0);#assert state[0].error==0 && memory[0].taint[1]==cast(u64)origin*2 && memory[0].dirty[1];
}
#forall "public conditional expressions never guess an unknown condition" variant:0..<4 {
 f:=SC_fixture();values:[32]u64;f.nodes[7]=ScNode.{kind=31,a=8,b=9,c=10};f.nodes[8]=ScNode.{kind=20,name="c"};f.nodes[9]=ScNode.{kind=20,name="x"};f.nodes[10]=ScNode.{kind=16};memory:=[1]AgMemory.[AgMemory.{used=1}];memory[0].taint[1]=1;env:[1]AgEnv;state:[1]ScAudit;
 cond:=AgValue.{type=-3};if variant==1 {cond.known=true;cond.lo=1;cond.hi=1;}if variant==2 {cond.known=true;}if variant==3 {cond.known=true;cond.hi=1;}
 AG_bind(env[..],"c",cond,state[..],5);AG_bind(env[..],"x",AgValue.{type=-1,region=1,literal=16},state[..],5);
 r:=AG_expr(f.nodes[..],values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert state[0].error==0 && AG_origin(r,memory[..])==cast(u64)(ifx variant==2 then 0 else 1);
 if variant==0 || variant==3 {#assert r.region==0 && r.literal==0 && !r.known;}if variant==1 {#assert r.region==1;}if variant==2 {#assert r.known && r.lo==0 && r.hi==0;}
}
#forall "borrowed count metadata is public and one element is an admitted extent" extra:0..<2 {
 f:=AG_fixture();f.nodes[16]=ScNode.{kind=3,b=3};f.nodes[7]=ScNode.{kind=25,a=17,name="count"};f.nodes[17]=ScNode.{kind=20,name="v"};memory:=[1]AgMemory.[AgMemory.{used=1}];memory[0].taint[1]=1;env:[1]AgEnv;state:[1]ScAudit;
 AG_bind(env[..],"v",AgValue.{type=16,region=1,view=true,extent=1-extra},state[..],5);r:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert state[0].error==cast(u32)(ifx extra==0 then 0 else SC_TYPE);if extra==0 {#assert r.mask==0 && r.region==0 && r.type==-4 && r.known && r.lo==1 && r.hi==1;}
}
#forall "field and constructor expression recursion is bounded independently" variant:0..<3,extra:0..<2 {
 f:=AG_fixture();f.nodes[16]=ScNode.{kind=28,d=12,head=17};f.nodes[17]=ScNode.{kind=71,name="words",a=18};f.nodes[18]=ScNode.{kind=18};
 if variant==1 {f.nodes[16]=ScNode.{kind=29,d=10,head=18};}if variant==2 {f.nodes[16]=ScNode.{kind=25,a=18,name="words"};f.nodes[18]=ScNode.{kind=28,d=12};}
 memory:[1]AgMemory;env:[1]AgEnv;state:[1]ScAudit;r:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],16,env[..],memory[..],state[..],14+extra);#assert state[0].error==cast(u32)(ifx extra==0 then 0 else SC_LIMIT);
}
#test "nested source type identity uses its entire supported depth at parameters and locals" {
 f:=SC_fixture();nodes:[100]ScNode;values:[100]u64;for i:0..<32 {nodes[i]=f.nodes[i];}for i:0..<7 {nodes[32+i]=ScNode.{kind=2,a=39,b=ifx i==6 then 3 else 33+i};}nodes[39]=ScNode.{kind=16};values[39]=1;nodes[5].a=32;nodes[2].a=32;
 f.types[0].type="[1] [1] [1] [1] [1] [1] [1] u64";state:[1]ScAudit;
 #assert AG_resolved(nodes[..],values[..],f.roots[..],f.types[0..<1],nodes[2],nodes[5],"parameter",state[..])==32;
 memory:[1]AgMemory;r:=AG_check(nodes[..],values[..],f.roots[..],f.types[0..<1],"candidate",memory[..]);#assert r.error==0 && r.return_mask==1;
}
#forall "array admission includes the smallest extent and rejects nested view fields uniformly" variant:0..<2 {
 f:=AG_fixture();state:[1]ScAudit;f.values[11]=1;if variant==1 {f.nodes[9].a=16;f.nodes[16]=ScNode.{kind=3,b=3};}
 #assert AG_valid_type(f.nodes[..],f.values[..],f.roots[..],ifx variant==0 then 10 else 8,true,state[..],0)==(variant==0);
}
#forall "borrowed and indexed values preserve snapshot origins and clear only descriptor metadata" slice:0..<2 {
 f:=AG_fixture();f.nodes[7]=ScNode.{kind=ifx slice==0 then 26 else 27,a=17,b=15};f.nodes[17]=ScNode.{kind=20,name="a"};f.values[15]=1;
 if slice==1 {f.nodes[7].c=18;f.nodes[18]=ScNode.{kind=16};f.values[18]=2;}
 memory:=[1]AgMemory.[AgMemory.{used=1}];memory[0].taint[1]=2;state:[1]ScAudit;env:[1]AgEnv;AG_bind(env[..],"a",AgValue.{type=10,mask=1,region=1,literal=16,extent=2,view=true,known=true,lo=3,hi=4},state[..],5);
 r:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],0);#assert state[0].error==0 && r.mask==3 && r.region==1 && !r.known;
 if slice==0 {#assert r.type==-1 && r.extent==0 && !r.view;}else {#assert r.type==10 && r.extent==1 && r.view && r.literal==0;}
}
#forall "slice base evaluation keeps its complete expression budget" extra:0..<2 {
 f:=AG_fixture();f.nodes[7]=ScNode.{kind=27,a=17};f.nodes[17]=ScNode.{kind=20,name="a"};memory:=[1]AgMemory.[AgMemory.{used=1}];state:[1]ScAudit;env:[1]AgEnv;AG_bind(env[..],"a",AgValue.{type=10,region=1,extent=2},state[..],5);
 r:=AG_expr(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],7,env[..],memory[..],state[..],14+extra);#assert state[0].error==cast(u32)(ifx extra==0 then 0 else SC_LIMIT);
}
