 AG_guard(f.nodes[..],memory[..],state[..],6,1);AG_guard(f.nodes[..],memory[..],state[..],6,2);
 #assert memory[0].guard_count==1 && memory[0].guards[0].node==6 && memory[0].guards[0].unit==2 && memory[0].guards[0].line==8 && memory[0].guards[0].column==9 && memory[0].guards[0].mask==3 && memory[0].guards[0].kind==1;
 AG_guard(f.nodes[..],memory[..],state[..],7,4);#assert memory[0].guard_count==2 && memory[0].guards[1].node==7;
 memory[0].guard_count=255;AG_guard(f.nodes[..],memory[..],state[..],8,8);#assert memory[0].guard_count==256 && memory[0].guards[255].node==8;
 AG_guard(f.nodes[..],memory[..],state[..],9,16);#assert memory[0].guard_count==256 && state[0].error==SC_LIMIT;
}
