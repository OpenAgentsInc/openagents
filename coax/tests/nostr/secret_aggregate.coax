}
#test "local environment binding capacity keeps names and distinct origins" {
 env:[1]AgEnv;state:[1]ScAudit;AG_bind(env[..],"x",AgValue.{mask=4,type=-1},state[..],7);#assert env[0].count==1 && env[0].bindings[0].name=="x" && env[0].bindings[0].value.mask==4;
