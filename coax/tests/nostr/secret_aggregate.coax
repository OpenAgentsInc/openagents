 f.nodes[16]=ScNode.{kind=3,b=3};f.types[0].type="[] u64";#assert AG_resolved(f.nodes[..],f.values[..],f.roots[..],f.types[0..<1],f.nodes[2],f.nodes[5],"parameter",state[..])==16;
