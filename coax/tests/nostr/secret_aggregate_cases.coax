// Same source-language negative families exercise the separate aggregate walker.
AG_test_check :: (nodes:[]ScNode,roots:[]int,types:[]ScType,entry:string)->ScResult {
 values:[128]u64;for node,index:nodes {if node.kind==18 {values[index]=1;}}memory:[1]AgMemory;return AG_check(nodes,values[0..<nodes.count],roots,types,entry,memory[..]);
}
#test "immutable graph lookups reuse exact names and preserve duplicate refusal" {
 f:=AG_fixture();state:[1]ScAudit;
 first:=AG_decl(f.nodes[..],f.roots[..],"candidate",state[..]);visits:=state[0].visits;
 #assert first==2 && AG_decl(f.nodes[..],f.roots[..],"candidate",state[..])==first;
 #assert state[0].visits-visits<visits && state[0].error==0;
 structure:=AG_struct(f.nodes[..],f.roots[..],"Pair",state[..]);
 #assert structure==8 && AG_struct(f.nodes[..],f.roots[..],"Pair",state[..])==structure;
 #assert AG_decl(f.nodes[..],f.roots[..],"absent",state[..])==0 && AG_decl(f.nodes[..],f.roots[..],"absent",state[..])==0;
 duplicate:=f;duplicate.nodes[8].next=16;duplicate.nodes[16]=ScNode.{kind=64,name="candidate"};state[0]=ScAudit.{};
 #assert AG_decl(duplicate.nodes[..],duplicate.roots[..],"candidate",state[..])==0 && state[0].error==SC_GRAPH;
 duplicate=f;duplicate.nodes[8].next=16;duplicate.nodes[16]=ScNode.{kind=66,name="Pair"};state[0]=ScAudit.{};
 #assert AG_struct(duplicate.nodes[..],duplicate.roots[..],"Pair",state[..])==0 && state[0].error==SC_GRAPH;
 state[0]=ScAudit.{lookup_count=128};
 #assert AG_decl(f.nodes[..],f.roots[..],"candidate",state[..])==2 && state[0].lookup_count==128 && state[0].error==0;
 state[0]=ScAudit.{};AG_lookup_save(state[..],"candidate",2,8);
 #assert AG_decl(f.nodes[..],f.roots[..],"candidate",state[..])==2;
}
#test "cached missing names and lookup kinds retain their distinct identities" {
 f:=AG_fixture();state:[1]ScAudit;#assert AG_lookup_cached(state[..],"x",1)== -1;
 AG_lookup_save(state[..],"missing",1,0);#assert state[0].lookup_count==1;visits:=state[0].visits;#assert AG_decl(f.nodes[..],f.roots[..],"missing",state[..])==0 && state[0].visits==visits+1;
 AG_lookup_save(state[..],"Pair",1,42);#assert AG_struct(f.nodes[..],f.roots[..],"Pair",state[..])==8;
 AG_lookup_save(state[..],"alias",2,8);#assert AG_struct(f.nodes[..],f.roots[..],"alias",state[..])==8;
 before:=state[0].lookup_count;state[0].error=SC_GRAPH;AG_lookup_save(state[..],"x",1,2);#assert state[0].lookup_count==before;
 state[0]=ScAudit.{visits=262144,lookup_count=1};#assert AG_decl(f.nodes[..],f.roots[..],"candidate",state[..])==0 && state[0].error==SC_LIMIT;
 state[0]=ScAudit.{visits=262144,lookup_count=1};#assert AG_struct(f.nodes[..],f.roots[..],"Pair",state[..])==0 && state[0].error==SC_LIMIT;
 state[0]=ScAudit.{visits=262144,lookup_count=1};#assert AG_lookup_cached(state[..],"x",1)== -1 && state[0].error==SC_LIMIT && state[0].where==0;
 state[0]=ScAudit.{};AG_lookup_save(state[..],"missing",2,0);visits=state[0].visits;#assert AG_struct(f.nodes[..],f.roots[..],"missing",state[..])==0 && state[0].visits==visits+1;
 state[0]=ScAudit.{};#assert AG_struct(f.nodes[..],f.roots[..],"Pair",state[..])==8 && state[0].lookup_count==1 && state[0].lookups[0].kind==2;
}
#test "aggregate profile: actual parameter classification is all-secret and resolved types are required" {
 f:=SC_fixture();r:=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");
 #assert r.error==0 && r.return_mask==1 && r.reached==1 && r.visits>0;
 #assert AG_test_check(f.nodes[..],f.roots[..],f.types[0..<0],"candidate").error==SC_TYPE;
 f.types[1]=f.types[0];#assert AG_test_check(f.nodes[..],f.roots[..],f.types[0..<2],"candidate").error==SC_TYPE;
 f.types[0].type="int";#assert AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate").error==SC_TYPE;
 #assert AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"missing").error==SC_ENTRY;
}
#forall "aggregate profile: conditional and memory origins are inspected rather than spelled-text guesses" variant:0..<10 {
 f:=SC_fixture();f.nodes[8]=ScNode.{kind=20,name="x"};f.nodes[9]=ScNode.{kind=16};f.nodes[10]=ScNode.{kind=16};want:=cast(u32)SC_BRANCH;
 if variant==0 {f.nodes[7]=ScNode.{kind=31,a=8,b=9,c=10};}
 else if variant==1 {f.nodes[7]=ScNode.{kind=31,a=8,b=9,c=10};f.nodes[8].kind=18;f.nodes[9]=ScNode.{kind=20,name="x"};want=SC_OK;}
 else if variant==2 || variant==3 {f.nodes[7]=ScNode.{kind=23,a=8,b=9,op=ifx variant==2 then 50 else 51};}
 else if variant==4 {f.nodes[7]=ScNode.{kind=26,a=8,b=8};want=SC_INDEX;}
 else if variant==5 {f.nodes[7]=ScNode.{kind=26,a=8,b=9};want=SC_TYPE;}
 else if variant==6 {f.nodes[7]=ScNode.{kind=23,a=9,b=8,op=42};want=SC_SHIFT;}
 else if variant==7 {f.nodes[7]=ScNode.{kind=23,a=8,b=9,op=37};want=SC_UNSUPPORTED;}
 else if variant==8 {f.nodes[6]=ScNode.{kind=45,a=8};}
 else {f.nodes[7]=ScNode.{kind=24};want=SC_UNSUPPORTED;}
 result:=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert result.error==want;if variant==1 {#assert result.return_mask==1;}
}
#forall "aggregate profile: builtin calls retain origin masks and reject secret rotate counts" variant:0..<6 {
 f:=SC_fixture();f.nodes[7]=ScNode.{kind=21,name="value_barrier",head=8};f.nodes[8]=ScNode.{kind=20,name="x"};want:=cast(u32)SC_OK;
 if variant==1 {f.nodes[7].head=0;want=SC_CALL;}
 if variant>=2 {f.nodes[7].name="add_wrap";f.nodes[8].next=9;f.nodes[9]=ScNode.{kind=16};}
 if variant==3 {f.nodes[7].name="mul_wrap";f.nodes[9]=ScNode.{kind=20,name="x"};}
 if variant==4 {f.nodes[7].name="rotl";f.nodes[9]=ScNode.{kind=20,name="x"};want=SC_SHIFT;}
 if variant==5 {f.nodes[7].name="rotr";}
 r:=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==want;if want==0 {#assert r.return_mask==1;}
}
#forall "aggregate profile: callee bodies are reached transitively and cannot hide foreign or variable-time code" variant:0..<5 {
 f:=SC_fixture();f.nodes[2].next=9;f.nodes[7]=ScNode.{kind=21,name="helper",head=8};f.nodes[8]=ScNode.{kind=20,name="x"};
 f.nodes[9]=ScNode.{kind=64,name="helper",line=2,a=3,b=10,head=11};f.nodes[10]=ScNode.{kind=40,head=12};f.nodes[11]=ScNode.{kind=68,name="y",line=2,a=3};
 f.nodes[12]=ScNode.{kind=44,a=13};f.nodes[13]=ScNode.{kind=20,name="y"};f.types[1]=ScType.{procedure="helper",procedure_line=2,name="y",line=2,role="parameter",type="u64"};want:=cast(u32)SC_OK;
 if variant==1 {f.nodes[7].name="helper_vartime";f.nodes[9].name="helper_vartime";want=SC_VARTIME;}
 if variant==2 {f.nodes[9].flag2=true;want=SC_CALL;}
 if variant==3 {f.nodes[13]=ScNode.{kind=21,name="candidate",head=14};f.nodes[14]=ScNode.{kind=20,name="y"};want=SC_RECURSION;}
 if variant==4 {f.nodes[7].name="unknown";want=SC_CALL;}
 r:=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<2],"candidate");#assert r.error==want;if want==0 {#assert r.reached==2 && r.return_mask==1;}
}
#forall "aggregate profile: assignment flow distinguishes replacement from compound updates" variant:0..<4 {
 f:=SC_fixture();f.nodes[6]=ScNode.{kind=42,name="z",line=2,a=7,next=8};f.nodes[8]=ScNode.{kind=43,c=9,a=10,op=23,next=11};
 f.nodes[9]=ScNode.{kind=20,name="z"};f.nodes[10]=ScNode.{kind=16};f.nodes[11]=ScNode.{kind=44,a=12};f.nodes[12]=ScNode.{kind=20,name="z"};
 f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="u64"};want:=cast(u32)0;
 if variant==1 {f.nodes[8].op=24;}
 if variant==2 {f.nodes[8].op=32;f.nodes[10]=ScNode.{kind=20,name="x"};want=SC_SHIFT;}
 if variant==3 {f.nodes[6].flag=true;want=SC_UNSUPPORTED;}
 r:=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<2],"candidate");#assert r.error==want;if want==0 {#assert r.return_mask==cast(u64)variant;}
}
#test "aggregate profile: malformed graphs and finite budgets refuse before unsafe traversal" {
 f:=SC_fixture();f.nodes[7].a=32;#assert AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate").error==SC_GRAPH;
 f=SC_fixture();f.nodes[0].kind=1;#assert !SC_shape(f.nodes[..],f.roots[..],f.types[0..<1]);
 f=SC_fixture();f.roots[0]=32;#assert !SC_shape(f.nodes[..],f.roots[..],f.types[0..<1]);
 s:=[1]ScAudit.[ScAudit.{visits=65536}];#assert !SC_tick(s[..],1) && s[0].error==SC_LIMIT;
 s[0]=ScAudit.{error=SC_BRANCH};#assert !SC_tick(s[..],1) && s[0].error==SC_BRANCH;
 f=SC_fixture();s[0]=ScAudit.{depth=16};args:=[1]u64.[1];#assert SC_procedure(f.nodes[..],f.roots[..],f.types[0..<1],2,args[..],s[..])==0 && s[0].error==SC_LIMIT;
 #assert !SC_ref(-1,32) && SC_ref(31,32) && !SC_ref(32,32);
}
#forall "aggregate profile: every graph reference and source owner is range checked independently" variant:0..<12 {
 f:=SC_fixture();
 if variant==0 {f.nodes[2].unit=-1;}else if variant==1 {f.nodes[2].unit=1;}
 else if variant==2 {f.nodes[1].a=-1;}else if variant==3 {f.nodes[1].b=32;}
 else if variant==4 {f.nodes[1].c=-1;}else if variant==5 {f.nodes[1].d=32;}
 else if variant==6 {f.nodes[1].head=-1;}else if variant==7 {f.nodes[1].next=32;}
 else if variant==8 {f.roots[0]=0;}else if variant==9 {f.nodes[1].kind=64;}
 else if variant==10 {f.types[0].unit=-1;}else {f.types[0].unit=1;}
 #assert !SC_shape(f.nodes[..],f.roots[..],f.types[0..<1]);
 r:=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==SC_GRAPH && r.unit==-1;
}
#test "aggregate profile: local bindings cannot shadow or overrun and carry separate origin bits" {
 env:[1]ScEnv;state:[1]ScAudit;SC_bind(env[..],"x",4,state[..],7);#assert env[0].count==1 && env[0].bindings[0].mask==4;
 SC_bind(env[..],"x",8,state[..],8);#assert state[0].error==SC_UNSUPPORTED && state[0].where==8;
 state[0]=ScAudit.{};env[0]=ScEnv.{count=64};SC_bind(env[..],"new",1,state[..],9);#assert state[0].error==SC_UNSUPPORTED && state[0].where==9;
 f:=SC_fixture();f.nodes[5].next=8;f.nodes[8]=ScNode.{kind=68,name="y",line=1,a=3,next=9};f.nodes[9]=ScNode.{kind=68,name="z",line=1,a=3};
 f.nodes[7].name="z";f.types[1]=f.types[0];f.types[1].name="y";f.types[2]=f.types[0];f.types[2].name="z";
 r:=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<3],"candidate");#assert r.error==0 && r.return_mask==4;
 f.nodes[7]=ScNode.{kind=23,a=10,b=11,op=39};f.nodes[10]=ScNode.{kind=20,name="x"};f.nodes[11]=ScNode.{kind=20,name="y"};
 r=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<3],"candidate");#assert r.error==0 && r.return_mask==3;
}
#forall "aggregate profile: expression operators preserve origins or report the unsupported operation" op:33..<54 {
 f:=SC_fixture();f.nodes[5].next=8;f.nodes[8]=ScNode.{kind=68,name="y",line=1,a=3};f.types[1]=f.types[0];f.types[1].name="y";
 f.nodes[7]=ScNode.{kind=23,a=9,b=10,op=cast(u32)op};f.nodes[9]=ScNode.{kind=20,name="x"};f.nodes[10]=ScNode.{kind=20,name="y"};
 expected:=cast(u32)SC_OK;if op<34 || op>51 || op==37 || op==38 {expected=SC_UNSUPPORTED;}
 else if op==42 || op==43 {expected=SC_SHIFT;}else if op==50 || op==51 {expected=SC_BRANCH;}
 r:=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<2],"candidate");#assert r.error==expected;if expected==0 {#assert r.return_mask==3;}
}
#forall "aggregate profile: unary and cast subsets are explicit" variant:0..<7 {
 f:=SC_fixture();f.nodes[8]=ScNode.{kind=20,name="x"};want:=cast(u32)0;
 if variant<4 {ops:=[4]u32.[34,35,52,36];f.nodes[7]=ScNode.{kind=22,a=8,op=ops[variant]};if variant==0 || variant==3 {want=SC_UNSUPPORTED;}}
 else {f.nodes[7]=ScNode.{kind=30,a=8,d=3,flag=true};if variant==4 {f.nodes[7].flag=false;want=SC_UNSUPPORTED;}if variant==5 {f.nodes[7].d=0;want=SC_TYPE;}}
 r:=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==want;if want==0 {#assert r.return_mask==1;}
}
#test "aggregate profile: global constants are public but unresolved values and ambiguous names refuse" {
 f:=SC_fixture();f.nodes[2].next=8;f.nodes[8]=ScNode.{kind=65,name="K",a=9};f.nodes[9]=ScNode.{kind=16};f.nodes[7].name="K";
 r:=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==0 && r.return_mask==0;
 f.nodes[7].name="candidate";state:[1]ScAudit;env:[1]ScEnv;
 #assert SC_expression(f.nodes[..],f.roots[..],f.types[0..<1],7,env[..],state[..],0)==0 && state[0].error==SC_CALL;
 f.nodes[8].name="candidate";state[0]=ScAudit.{};#assert SC_decl(f.nodes[..],f.roots[..],"candidate",state[..])==0 && state[0].error==SC_GRAPH;
 r=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==SC_GRAPH && r.unit==-1;
 f=SC_fixture();f.nodes[2].head=0;r=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<0],"candidate");#assert r.error==SC_ENTRY && r.unit==-1;
 f.nodes[2].kind=65;r=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<0],"candidate");#assert r.error==SC_ENTRY && r.unit==-1;
 f.nodes[2].head=5;r=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==SC_ENTRY && r.unit==-1;
}
#test "aggregate profile: public short circuit and asymmetric builtin arguments retain the right origin" {
 f:=SC_fixture();f.nodes[7]=ScNode.{kind=23,op=51,a=8,b=9};f.nodes[8]=ScNode.{kind=18};f.nodes[9]=ScNode.{kind=20,name="x"};
 r:=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==0 && r.return_mask==1;
 f.nodes[7]=ScNode.{kind=21,name="add_wrap",head=8};f.nodes[8]=ScNode.{kind=16,next=9};
 r=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==0 && r.return_mask==1;
 nodes:[2]ScNode;nodes[1]=ScNode.{kind=16};state:[1]ScAudit;env:[1]ScEnv;roots:=[1]int.[0];types:[1]ScType;
 #assert SC_expression(nodes[..],roots[..],types[0..<0],1,env[..],state[..],0)==0 && state[0].error==0;
}
#test "aggregate profile: eight independent secret parameters fit and the ninth refuses" {
 f:=SC_fixture();names:=[9]string.["a","b","c","d","e","f","g","h","i"];types:[9]ScType;
 f.nodes[2].head=16;for i:0..<9 {f.nodes[16+i]=ScNode.{kind=68,name=names[i],line=1,a=3,next=ifx i==8 then 0 else 17+i};types[i]=f.types[0];types[i].name=names[i];}
 f.nodes[23].next=0;f.nodes[7].name="h";
 r:=AG_test_check(f.nodes[..],f.roots[..],types[0..<8],"candidate");#assert r.error==0 && r.return_mask==128;
 state:[1]ScAudit;args:=[8]u64.[1,2,3,4,5,6,7,8];#assert SC_procedure(f.nodes[..],f.roots[..],types[0..<8],2,args[..],state[..])==8 && state[0].error==0;
 f.nodes[23].next=24;r=AG_test_check(f.nodes[..],f.roots[..],types[..],"candidate");#assert r.error==SC_LIMIT;
}
#test "aggregate profile: default scalar initialization is public and missing local type data refuses" {
 f:=SC_fixture();f.nodes[6]=ScNode.{kind=42,name="z",line=2,next=8};f.nodes[8]=ScNode.{kind=44,a=9};f.nodes[9]=ScNode.{kind=20,name="z"};
 types:=[2]ScType.[f.types[0],ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="u64"}];
 r:=AG_test_check(f.nodes[..],f.roots[..],types[..],"candidate");#assert r.error==0 && r.return_mask==0;
 r=AG_test_check(f.nodes[..],f.roots[..],types[0..<1],"candidate");#assert r.error==SC_TYPE;
}
#forall "aggregate profile: all compound assignments classify their operand origins" op:22..<35 {
 f:=SC_fixture();f.nodes[5].next=13;f.nodes[13]=ScNode.{kind=68,name="y",line=1,a=3};
 f.nodes[6]=ScNode.{kind=42,name="z",line=2,a=7,next=8};f.nodes[8]=ScNode.{kind=43,c=9,a=10,op=cast(u32)op,next=11};
 f.nodes[9]=ScNode.{kind=20,name="z"};f.nodes[10]=ScNode.{kind=20,name="y"};f.nodes[11]=ScNode.{kind=44,a=12};f.nodes[12]=ScNode.{kind=20,name="z"};
 types:=[3]ScType.[f.types[0],f.types[0],ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="u64"}];types[1].name="y";
 expected:=cast(u32)0;if op<23 || op>33 || op==27 || op==28 {expected=SC_UNSUPPORTED;}else if op==32 || op==33 {expected=SC_SHIFT;}
 r:=AG_test_check(f.nodes[..],f.roots[..],types[..],"candidate");#assert r.error==expected;if expected==0 {#assert r.return_mask==cast(u64)(ifx op==23 then 2 else 3);}
}
#forall "aggregate profile: public compound operands do not become secret shifts but still retain secret dividends" op:27..<34 {
 f:=SC_fixture();f.nodes[6]=ScNode.{kind=42,name="z",line=2,a=7,next=8};f.nodes[8]=ScNode.{kind=43,c=9,a=10,op=cast(u32)op,next=11};f.nodes[9]=ScNode.{kind=20,name="z"};
 f.nodes[10]=ScNode.{kind=16};f.nodes[11]=ScNode.{kind=44,a=12};f.nodes[12]=ScNode.{kind=20,name="z"};
 types:=[2]ScType.[f.types[0],ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="u64"}];
 r:=AG_test_check(f.nodes[..],f.roots[..],types[..],"candidate");#assert r.error==cast(u32)(ifx op==27 || op==28 then SC_UNSUPPORTED else 0);
}
#forall "aggregate profile: procedure expression roots start at depth zero for every statement" variant:0..<5 {
 f:=SC_fixture();nodes:[100]ScNode;for i:0..<32 {nodes[i]=f.nodes[i];}nodes[3].name="bool";f.types[0].type="bool";
 for i:0..<15 {nodes[32+i]=ScNode.{kind=22,a=33+i,op=52};}nodes[47]=ScNode.{kind=20,name="x"};
 types:=[2]ScType.[f.types[0],ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="bool"}];
 if variant==0 {nodes[6].a=32;}
 else if variant==1 {nodes[6]=ScNode.{kind=42,name="z",line=2,a=32,next=8};nodes[8]=ScNode.{kind=44,a=9};nodes[9]=ScNode.{kind=20,name="z"};}
 else if variant==2 {nodes[6]=ScNode.{kind=42,name="z",line=2,next=8};nodes[8]=ScNode.{kind=43,c=9,a=32,op=23,next=10};nodes[9]=ScNode.{kind=20,name="z"};nodes[10]=ScNode.{kind=44,a=9};}
 else {nodes[6]=ScNode.{kind=cast(u32)(42+variant),a=32};}
 r:=AG_test_check(nodes[..],f.roots[..],types[..],"candidate");#assert r.error==cast(u32)(ifx variant<3 then SC_OK else SC_BRANCH);
 if variant<3 {#assert r.return_mask==1;}
}
#test "aggregate profile: assignment to the first parameter binding remains a valid replacement" {
 f:=SC_fixture();f.nodes[6]=ScNode.{kind=43,c=7,a=8,op=23,next=9};f.nodes[8]=ScNode.{kind=16};f.nodes[9]=ScNode.{kind=44,a=7};
 r:=AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==0 && r.return_mask==0;
}
#forall "aggregate profile: public statement conditions are unsupported rather than secret branches" kind:45..<47 {
 f:=SC_fixture();f.nodes[6]=ScNode.{kind=cast(u32)kind,a=7};f.nodes[7]=ScNode.{kind=18};
 #assert AG_test_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate").error==SC_UNSUPPORTED;
}
