checked_add :: (x:u64)->u64 #export_c {return x+1;}
checked_sub :: (x:u64)->u64 #export_c {return x-1;}
checked_mul :: (x:u64)->u64 #export_c {return x*2;}
checked_neg :: (x:u64)->u64 #export_c {return cast,trunc(u64)(-cast,trunc(int)x);}
compound :: (x:u64)->u64 #export_c {y:=x;y+=1;return y;}
array_compound :: (a:[1]u64,x:u64)->u64 #export_c {y:=a;y[0]+=x;return y[0];}
secret_shift :: (x:u64)->u64 #export_c {return 1<<x;}
secret_div :: (x:u64)->u64 #export_c {return 1/x;}
wrapping_add :: (x:u64)->u64 #export_c {return add_wrap(x,1);}
