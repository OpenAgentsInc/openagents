// Large profile only: public fields inside secret views.
// candidate :: (k:u64,w:[]W)->u64 with W :: struct {stage:int;val:u64;count:u64;inner:[1]I;}
// and I :: struct {used:int;data:u64;}. k and w are secret; W.stage, W.count and
// I.used are named public. Graphs are built inside the checks.
AgFieldFrame :: struct {nodes:[120]ScNode;values:[120]u64;types:[7]ScType;roots:[1]int;}
// 0: if w[0].stage==0 {return 1;} return 2;            public branch, accepted
// 1: the same without public fields                     secret int in the view type
// 2: x:=w[0]; w[0]=x; then the branch                   a whole-element write taints stage
// 3: w[0].val=k; then the branch                        another field leaves stage public
// 4: w[0].inner[0].data=k; if w[0].inner[0].used==0     nested public field, accepted
// 5: w[0].count=k; if w[0].count==0                     a secret written into a public field
// 6: for i:0..<2 {t:=ifx w[0].count==0 then k else k; w[0].count=k;}  the back edge reaches the read
// 7: the same loop writing 5                            stays public, accepted
// 8: x:=w[0]; if x.stage==0                             a copy has no public fields
// 9-13: unknown field, aggregate field, duplicate, unknown struct, wrong label kind
// 14: a read-only view refuses w[0].stage=1; 15: public fields need the view profile
// 16: clear(w,k) with clear :: (w:[]W,v:u64) {w[0].val=v;return;}, then the branch: accepted
// 17: clear writes w[0].count=v, then if w[0].count==0: the callee's write reaches the field
// 18: an expression statement that is not a call
// 19: case 0 with the view as the first parameter
// 20: w[0].count=k; for i:0..<2 {w[0].count=k;} return 0;   an already tainted field is a fixed point
// 21: an unknown statement kind
// 22: clear(w,e) where e nests fourteen shifts of k: the deepest operand sits at the expression limit
// 23: case 6 with count named first, so its shadow is the first one
#forall "named public fields stay public inside secret views until a secret reaches them" variant:0..<24 {
 f:AgFieldFrame;f.roots[0]=1;f.nodes[1]=ScNode.{kind=74,head=2};
 f.nodes[2]=ScNode.{kind=64,name="candidate",line=1,a=61,b=4,head=5,next=50};f.nodes[4]=ScNode.{kind=40,head=90};
 f.nodes[5]=ScNode.{kind=68,name="k",line=1,a=61,next=6};f.nodes[6]=ScNode.{kind=68,name="w",line=1,a=7};f.nodes[7]=ScNode.{kind=3,b=65};
 f.nodes[50]=ScNode.{kind=66,name="W",head=51,next=55};f.nodes[51]=ScNode.{kind=69,name="stage",a=60,next=52};f.nodes[52]=ScNode.{kind=69,name="val",a=61,next=53};
 f.nodes[53]=ScNode.{kind=69,name="count",a=61,next=54};f.nodes[54]=ScNode.{kind=69,name="inner",a=62};
 f.nodes[55]=ScNode.{kind=66,name="I",head=56};f.nodes[56]=ScNode.{kind=69,name="used",a=60,next=57};f.nodes[57]=ScNode.{kind=69,name="data",a=61};
 f.nodes[60]=ScNode.{kind=1,name="int"};f.nodes[61]=ScNode.{kind=1,name="u64"};f.nodes[62]=ScNode.{kind=2,a=63,b=64};f.nodes[63]=ScNode.{kind=16};f.values[63]=1;
 f.nodes[64]=ScNode.{kind=1,name="I"};f.nodes[65]=ScNode.{kind=1,name="W"};
 f.types[0]=ScType.{procedure="candidate",procedure_line=1,name="k",line=1,role="parameter",type="u64"};
 f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="w",line=1,role="parameter",type="[] W"};
 f.types[2]=ScType.{procedure="candidate",procedure_line=1,name="x",line=2,role="local",type="W"};
 f.types[3]=ScType.{procedure="candidate",procedure_line=1,name="t",line=3,role="local",type="u64"};
 f.types[4]=ScType.{procedure="candidate",procedure_line=1,name="i",line=3,role="loop",type="int"};
 f.nodes[70]=ScNode.{kind=20,name="w"};f.nodes[71]=ScNode.{kind=16};f.nodes[72]=ScNode.{kind=26,a=70,b=71};
 f.nodes[73]=ScNode.{kind=25,a=72,name="stage"};f.nodes[74]=ScNode.{kind=25,a=72,name="count"};f.nodes[75]=ScNode.{kind=25,a=72,name="val"};
 f.nodes[76]=ScNode.{kind=25,a=72,name="inner"};f.nodes[77]=ScNode.{kind=26,a=76,b=71};f.nodes[78]=ScNode.{kind=25,a=77,name="used"};f.nodes[79]=ScNode.{kind=25,a=77,name="data"};
 f.nodes[80]=ScNode.{kind=20,name="k"};f.nodes[81]=ScNode.{kind=16};f.values[81]=1;f.nodes[82]=ScNode.{kind=16};f.values[82]=2;f.nodes[83]=ScNode.{kind=16};f.values[83]=5;
 f.nodes[90]=ScNode.{kind=45,a=91,c=92,next=94};f.nodes[91]=ScNode.{kind=23,a=73,b=71,op=44};f.nodes[92]=ScNode.{kind=40,head=93};f.nodes[93]=ScNode.{kind=44,a=81};f.nodes[94]=ScNode.{kind=44,a=82};
 f.nodes[13]=ScNode.{kind=20,name="x"};
 f.nodes[2].next=30;f.nodes[30]=ScNode.{kind=64,name="clear",line=5,b=31,head=32,next=50};f.nodes[32]=ScNode.{kind=68,name="w",line=5,a=7,next=33};f.nodes[33]=ScNode.{kind=68,name="v",line=5,a=61};
 f.nodes[31]=ScNode.{kind=40,head=34};f.nodes[34]=ScNode.{kind=43,c=ifx variant==17 then 74 else 75,a=35,op=23,next=36};f.nodes[35]=ScNode.{kind=20,name="v"};f.nodes[36]=ScNode.{kind=44};
 f.types[5]=ScType.{procedure="clear",procedure_line=5,name="w",line=5,role="parameter",type="[] W"};f.types[6]=ScType.{procedure="clear",procedure_line=5,name="v",line=5,role="parameter",type="u64"};
 if variant>=16 {f.nodes[4].head=37;f.nodes[37]=ScNode.{kind=41,a=ifx variant==18 then 80 else 38,next=90};f.nodes[38]=ScNode.{kind=21,name="clear",head=39};f.nodes[39]=ScNode.{kind=20,name="w",next=40};f.nodes[40]=ScNode.{kind=20,name="k"};}
 if variant==17 {f.nodes[91].a=74;}
 if variant==19 {f.nodes[2].head=6;f.nodes[6].next=5;f.nodes[5].next=0;}
 if variant==20 {f.nodes[4].head=11;f.nodes[11]=ScNode.{kind=43,c=74,a=80,op=23,next=20};f.nodes[20]=ScNode.{kind=47,name="i",line=3,a=71,b=82,c=21,next=24};f.nodes[21]=ScNode.{kind=40,head=23};
  f.nodes[23]=ScNode.{kind=43,c=74,a=80,op=23};f.nodes[24]=ScNode.{kind=44,a=71};}
 if variant==21 {f.nodes[4].head=37;f.nodes[37]=ScNode.{kind=50,next=90};}
 if variant==22 {f.nodes[40]=ScNode.{kind=23,a=100,b=71,op=43};for d:0..<13 {f.nodes[100+d]=ScNode.{kind=23,a=101+d,b=71,op=43};}f.nodes[113]=ScNode.{kind=20,name="k"};}
 if variant==23 {f.nodes[4].head=20;f.nodes[20]=ScNode.{kind=47,name="i",line=3,a=71,b=82,c=21,next=24};f.nodes[21]=ScNode.{kind=40,head=22};
  f.nodes[22]=ScNode.{kind=42,name="t",line=3,a=25,next=23};f.nodes[25]=ScNode.{kind=31,a=26,b=80,c=80};f.nodes[26]=ScNode.{kind=23,a=74,b=71,op=44};
  f.nodes[23]=ScNode.{kind=43,c=74,a=80,op=23};f.nodes[24]=ScNode.{kind=44,a=71};}
 if variant==2 {f.nodes[4].head=10;f.nodes[10]=ScNode.{kind=42,name="x",line=2,a=72,next=11};f.nodes[11]=ScNode.{kind=43,c=72,a=13,op=23,next=90};}
 if variant==3 || variant==4 || variant==5 || variant==14 {f.nodes[4].head=11;f.nodes[11]=ScNode.{kind=43,c=ifx variant==3 then 75 else ifx variant==4 then 79 else ifx variant==5 then 74 else 73,a=ifx variant==14 then 81 else 80,op=23,next=90};}
 if variant==4 {f.nodes[91].a=78;}if variant==5 {f.nodes[91].a=74;}
 if variant==6 || variant==7 {f.nodes[4].head=20;f.nodes[20]=ScNode.{kind=47,name="i",line=3,a=71,b=82,c=21,next=24};f.nodes[21]=ScNode.{kind=40,head=22};
  f.nodes[22]=ScNode.{kind=42,name="t",line=3,a=25,next=23};f.nodes[25]=ScNode.{kind=31,a=26,b=80,c=80};f.nodes[26]=ScNode.{kind=23,a=74,b=71,op=44};
  f.nodes[23]=ScNode.{kind=43,c=74,a=ifx variant==6 then 80 else 83,op=23};f.nodes[24]=ScNode.{kind=44,a=71};}
 if variant==8 {f.nodes[4].head=10;f.nodes[10]=ScNode.{kind=42,name="x",line=2,a=72,next=90};f.nodes[27]=ScNode.{kind=25,a=13,name="stage"};f.nodes[91].a=27;}
 labels:[6]AgLabel;labels[0]=AgLabel.{name="k",type="u64"};labels[1]=AgLabel.{name="w",type="[] W",extent=1,access=ifx variant==14 then 1 else 2};
 if variant==19 {labels[1]=labels[0];labels[0]=AgLabel.{name="w",type="[] W",extent=1,access=2};}
 labels[2]=AgLabel.{name="stage",type="W",access=3};labels[3]=AgLabel.{name="count",type="W",access=3};labels[4]=AgLabel.{name="used",type="I",access=3};count:=5;
 if variant==1 {count=2;}if variant==9 {labels[4].name="nope";}if variant==10 {labels[4]=AgLabel.{name="inner",type="W",access=3};}
 if variant==11 {labels[5]=AgLabel.{name="stage",type="W",access=3};count=6;}
 if variant==23 {labels[2]=AgLabel.{name="count",type="W",access=3};labels[3]=AgLabel.{name="stage",type="W",access=3};}if variant==12 {labels[4].type="Z";}if variant==13 {labels[4].access=2;}
 memory:[1]AgMemory;r:ScResult;
 if variant==15 {r=AG_check_classified(f.nodes[..],f.values[..],f.roots[..],f.types[..],"candidate",memory[..],3,labels[0..<count],false);}
 else {r=AG_check_public_views(f.nodes[..],f.values[..],f.roots[..],f.types[..],"candidate",memory[..],3,labels[0..<count],false);}
 want:=cast(u32)0;
 if variant==1 || (variant>=9 && variant<=13) {want=SC_TYPE;}if variant==2 || variant==5 || variant==6 || variant==8 || variant==17 || variant==23 {want=SC_BRANCH;}
 if variant==14 || variant==18 || variant==21 {want=SC_UNSUPPORTED;}if variant==15 {want=SC_ENTRY;}
 #assert r.error==want;if want==0 {#assert r.return_mask==0;}if variant>=9 && variant<=13 {#assert r.unit== -1;}
}
// candidate :: (k:u64,w:[]C)->u64 {for i:0..<2 {w[0].c8=w[0].c7;...;w[0].c2=w[0].c1;w[0].c1=k;}return 0;}
// with C :: struct {c1..c8:u64} all public. Each pass carries k one field further,
// so seven fields settle on the eighth pass and eight fail closed.
#forall "public-field fixed points take one pass per hop and stop at eight" fields:7..<9 {
 nodes:[100]ScNode;values:[100]u64;roots:=[1]int.[1];types:[3]ScType;
 nodes[1]=ScNode.{kind=74,head=2};nodes[2]=ScNode.{kind=64,name="candidate",line=1,a=61,b=4,head=5,next=50};nodes[4]=ScNode.{kind=40,head=20};
 nodes[5]=ScNode.{kind=68,name="k",line=1,a=61,next=6};nodes[6]=ScNode.{kind=68,name="w",line=1,a=7};nodes[7]=ScNode.{kind=3,b=65};nodes[61]=ScNode.{kind=1,name="u64"};nodes[65]=ScNode.{kind=1,name="C"};
 nodes[50]=ScNode.{kind=66,name="C",head=51};names:=[8]string.["c1","c2","c3","c4","c5","c6","c7","c8"];
 for i:0..<8 {nodes[51+i]=ScNode.{kind=69,name=names[i],a=61,next=ifx i==7 then 0 else 52+i};nodes[81+i]=ScNode.{kind=25,a=72,name=names[i]};}
 nodes[70]=ScNode.{kind=20,name="w"};nodes[71]=ScNode.{kind=16};nodes[72]=ScNode.{kind=26,a=70,b=71};nodes[79]=ScNode.{kind=20,name="k"};nodes[73]=ScNode.{kind=16};values[73]=2;
 nodes[20]=ScNode.{kind=47,name="i",line=3,a=71,b=73,c=21,next=24};nodes[21]=ScNode.{kind=40,head=30+fields};nodes[24]=ScNode.{kind=44,a=71};
 for i:2..<9 {nodes[30+i]=ScNode.{kind=43,c=80+i,a=79+i,op=23,next=29+i};}nodes[31]=ScNode.{kind=43,c=81,a=79,op=23};
 types[0]=ScType.{procedure="candidate",procedure_line=1,name="k",line=1,role="parameter",type="u64"};
 types[1]=ScType.{procedure="candidate",procedure_line=1,name="w",line=1,role="parameter",type="[] C"};types[2]=ScType.{procedure="candidate",procedure_line=1,name="i",line=3,role="loop",type="int"};
 labels:[10]AgLabel;labels[0]=AgLabel.{name="k",type="u64"};labels[1]=AgLabel.{name="w",type="[] C",extent=1,access=2};for i:0..<fields {labels[2+i]=AgLabel.{name=names[i],type="C",access=3};}
 memory:[1]AgMemory;r:=AG_check_public_views(nodes[..],values[..],roots[..],types[..],"candidate",memory[..],3,labels[0..<2+fields],false);
 if fields==7 {#assert r.error==0 && r.return_mask==0;}else {#assert r.error==SC_LIMIT;}
}
