 nodes[45]=ScNode.{kind=64,name="agg_declassify",line=9,a=65,b=46,head=47,next=50};nodes[46]=ScNode.{kind=40,head=48};nodes[47]=ScNode.{kind=68,name="v",line=9,a=61};
 nodes[48]=ScNode.{kind=42,name="r",line=10,d=65,next=49};nodes[49]=ScNode.{kind=44,a=39};nodes[39]=ScNode.{kind=20,name="r"};
 nodes[50]=ScNode.{kind=66,name="W",head=51};nodes[51]=ScNode.{kind=69,name="valid",a=61,next=52};nodes[52]=ScNode.{kind=69,name="pk",a=66};
