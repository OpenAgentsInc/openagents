 nodes[90]=ScNode.{kind=45,a=91,c=92,next=94};nodes[92]=ScNode.{kind=40,head=93};nodes[93]=ScNode.{kind=44,a=81};nodes[94]=ScNode.{kind=44,a=82};
 nodes[91]=ScNode.{kind=21,name=okname,head=85};
