// candidate :: (k:u64,v:[]u8,p:u64,w:[]W)->u64 with W :: struct {stage:int;val:u64;}, W.stage public,
// v a 4-byte view, k and w secret, p public, and C :: #run make() with make :: ()->W.
// 0: s:u64; for b:v {s=s^cast(u64)b;} return s;     for-each over a public view
// 1: case 0 with v secret                            the item carries the view's taint
// 2: case 0 directly inside an unresolved arm       analyzed there too
// 3: case 0 with the item typed u32                  the item's type must match the element
// 4: if p==0 {w[0].val=k;} if w[0].stage==0 {return 1;} return 2;   an arm writes a region
// 5: case 4 branching on w[0].val                    the arm's write taints the region
// 6: return C.val;                                   an attested run constant is public and typed
// 7: case 6 without attested runs                    run expressions refuse
// 8: if p==0 {v[0]=cast,trunc(u8)k;} then the stage branch, v writable: an arm writes the first region
// 9: return C2; with C2 :: #run 7                    a non-call run constant is public
// 10: return C3; with C3 :: #run noop() and noop void  has no type and refuses
// 11: case 0 over a one-byte view; 12: for x:w {}      aggregate items refuse
// 13: for b:v {t:=b;} if v[0]==0 {return 1;} return 2;   a read-only loop leaves v public
// 14: case 0 with v writable, then the same branch on v[0]   a writing loop taints v with k and w
// 19: case 14 with v read-only                       a read-only view cannot change, so it stays public
// 15: for b:v {return cast(u64)b;} return 0;          a read-only loop may return
// 16: s:u64; for b:v {s=s^cast(u64)b;return s;} return 0;   a writing loop may not
// 17: case 13 over v[..] nested fifteen times, then return 0   the collection may reach the expression limit
// 18: unclassified, k only: a:[4]u8; for b:a {return cast(u64)b;} return 0;   bodies are not read-only there
// (15 runs with v secret, so the loop's possible return reaches the result.)
#forall "for-each loops, arm region writes and run constants" variant:0..<20 {
 nodes:[120]ScNode;values:[120]u64;roots:=[1]int.[1];types:[8]ScType;
 nodes[1]=ScNode.{kind=74,head=2};nodes[2]=ScNode.{kind=64,name="candidate",line=1,a=61,b=4,head=5,next=50};nodes[4]=ScNode.{kind=40,head=10};
 nodes[5]=ScNode.{kind=68,name="k",line=1,a=61,next=6};nodes[6]=ScNode.{kind=68,name="v",line=1,a=8,next=7};nodes[7]=ScNode.{kind=68,name="p",line=1,a=61,next=9};
 nodes[8]=ScNode.{kind=3,b=64};nodes[9]=ScNode.{kind=68,name="w",line=1,a=3};nodes[3]=ScNode.{kind=3,b=65};
 nodes[50]=ScNode.{kind=66,name="W",head=51,next=55};nodes[51]=ScNode.{kind=69,name="stage",a=60,next=52};nodes[52]=ScNode.{kind=69,name="val",a=61};
 nodes[55]=ScNode.{kind=64,name="make",line=7,a=65,b=56,next=58};nodes[56]=ScNode.{kind=40,head=57};nodes[57]=ScNode.{kind=44,a=59};nodes[59]=ScNode.{kind=28,d=65};
 nodes[58]=ScNode.{kind=65,name="C",a=40};nodes[40]=ScNode.{kind=24,a=41};nodes[41]=ScNode.{kind=21,name="make"};
 nodes[60]=ScNode.{kind=1,name="int"};nodes[61]=ScNode.{kind=1,name="u64"};nodes[64]=ScNode.{kind=1,name="u8"};nodes[65]=ScNode.{kind=1,name="W"};
