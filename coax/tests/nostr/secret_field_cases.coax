 types[2]=ScType.{procedure=okname,procedure_line=5,name="v",line=5,role="parameter",type="u64"};types[3]=ScType.{procedure="pub_declassify",procedure_line=7,name="b",line=7,role="parameter",type="[] u8"};
 types[4]=ScType.{procedure="agg_declassify",procedure_line=9,name="v",line=9,role="parameter",type="u64"};types[5]=ScType.{procedure="agg_declassify",procedure_line=9,name="r",line=10,role="local",type="W"};
