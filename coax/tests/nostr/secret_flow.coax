// Abstract policy checks; the operator tool only accepts real frontend nodes.
ScFixture :: struct {nodes:[32]ScNode;roots:[1]int;types:[4]ScType;}
SC_fixture :: ()->ScFixture {
 f:ScFixture;f.roots[0]=1;
 f.nodes[1]=ScNode.{kind=74,head=2};
 f.nodes[2]=ScNode.{kind=64,name="candidate",line=1,a=3,b=4,head=5};
 f.nodes[3]=ScNode.{kind=1,name="u64"};f.nodes[4]=ScNode.{kind=40,head=6};
 f.nodes[5]=ScNode.{kind=68,name="x",line=1,a=3};
 f.nodes[6]=ScNode.{kind=44,a=7};f.nodes[7]=ScNode.{kind=20,name="x"};
 f.types[0]=ScType.{procedure="candidate",procedure_line=1,name="x",line=1,role="parameter",type="u64"};return f;
}
#test "actual parameter classification is all-secret and resolved types are required" {
 f:=SC_fixture();r:=SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");
 #assert r.error==0 && r.return_mask==1 && r.reached==1 && r.visits>0;
 #assert SC_check(f.nodes[..],f.roots[..],f.types[0..<0],"candidate").error==SC_TYPE;
 f.types[1]=f.types[0];#assert SC_check(f.nodes[..],f.roots[..],f.types[0..<2],"candidate").error==SC_TYPE;
 f.types[0].type="int";#assert SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate").error==SC_TYPE;
 #assert SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"missing").error==SC_ENTRY;
}
#forall "conditional and memory origins are inspected rather than spelled-text guesses" variant:0..<10 {
 f:=SC_fixture();f.nodes[8]=ScNode.{kind=20,name="x"};f.nodes[9]=ScNode.{kind=16};f.nodes[10]=ScNode.{kind=16};want:=cast(u32)SC_BRANCH;
 if variant==0 {f.nodes[7]=ScNode.{kind=31,a=8,b=9,c=10};}
 else if variant==1 {f.nodes[7]=ScNode.{kind=31,a=8,b=9,c=10};f.nodes[8].kind=18;f.nodes[9]=ScNode.{kind=20,name="x"};want=SC_OK;}
 else if variant==2 || variant==3 {f.nodes[7]=ScNode.{kind=23,a=8,b=9,op=ifx variant==2 then 50 else 51};}
 else if variant==4 {f.nodes[7]=ScNode.{kind=26,a=8,b=8};want=SC_INDEX;}
 else if variant==5 {f.nodes[7]=ScNode.{kind=26,a=8,b=9};want=SC_UNSUPPORTED;}
 else if variant==6 {f.nodes[7]=ScNode.{kind=23,a=9,b=8,op=42};want=SC_SHIFT;}
 else if variant==7 {f.nodes[7]=ScNode.{kind=23,a=8,b=9,op=37};want=SC_UNSUPPORTED;}
 else if variant==8 {f.nodes[6]=ScNode.{kind=45,a=8};}
 else {f.nodes[7]=ScNode.{kind=24};want=SC_UNSUPPORTED;}
 result:=SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert result.error==want;if variant==1 {#assert result.return_mask==1;}
}
#forall "builtin calls retain origin masks and reject secret rotate counts" variant:0..<6 {
 f:=SC_fixture();f.nodes[7]=ScNode.{kind=21,name="value_barrier",head=8};f.nodes[8]=ScNode.{kind=20,name="x"};want:=cast(u32)SC_OK;
 if variant==1 {f.nodes[7].head=0;want=SC_CALL;}
 if variant>=2 {f.nodes[7].name="add_wrap";f.nodes[8].next=9;f.nodes[9]=ScNode.{kind=16};}
 if variant==3 {f.nodes[7].name="mul_wrap";f.nodes[9]=ScNode.{kind=20,name="x"};}
 if variant==4 {f.nodes[7].name="rotl";f.nodes[9]=ScNode.{kind=20,name="x"};want=SC_SHIFT;}
 if variant==5 {f.nodes[7].name="rotr";}
 r:=SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==want;if want==0 {#assert r.return_mask==1;}
}
#forall "callee bodies are reached transitively and cannot hide foreign or variable-time code" variant:0..<5 {
 f:=SC_fixture();f.nodes[2].next=9;f.nodes[7]=ScNode.{kind=21,name="helper",head=8};f.nodes[8]=ScNode.{kind=20,name="x"};
 f.nodes[9]=ScNode.{kind=64,name="helper",line=2,a=3,b=10,head=11};f.nodes[10]=ScNode.{kind=40,head=12};f.nodes[11]=ScNode.{kind=68,name="y",line=2,a=3};
 f.nodes[12]=ScNode.{kind=44,a=13};f.nodes[13]=ScNode.{kind=20,name="y"};f.types[1]=ScType.{procedure="helper",procedure_line=2,name="y",line=2,role="parameter",type="u64"};want:=cast(u32)SC_OK;
 if variant==1 {f.nodes[7].name="helper_vartime";f.nodes[9].name="helper_vartime";want=SC_VARTIME;}
 if variant==2 {f.nodes[9].flag2=true;want=SC_CALL;}
 if variant==3 {f.nodes[13]=ScNode.{kind=21,name="candidate",head=14};f.nodes[14]=ScNode.{kind=20,name="y"};want=SC_RECURSION;}
 if variant==4 {f.nodes[7].name="unknown";want=SC_CALL;}
 r:=SC_check(f.nodes[..],f.roots[..],f.types[0..<2],"candidate");#assert r.error==want;if want==0 {#assert r.reached==2 && r.return_mask==1;}
}
#forall "assignment flow distinguishes replacement from compound updates" variant:0..<4 {
 f:=SC_fixture();f.nodes[6]=ScNode.{kind=42,name="z",line=2,a=7,next=8};f.nodes[8]=ScNode.{kind=43,c=9,a=10,op=23,next=11};
 f.nodes[9]=ScNode.{kind=20,name="z"};f.nodes[10]=ScNode.{kind=16};f.nodes[11]=ScNode.{kind=44,a=12};f.nodes[12]=ScNode.{kind=20,name="z"};
 f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="u64"};want:=cast(u32)0;
 if variant==1 {f.nodes[8].op=24;}
 if variant==2 {f.nodes[8].op=32;f.nodes[10]=ScNode.{kind=20,name="x"};want=SC_SHIFT;}
 if variant==3 {f.nodes[6].flag=true;want=SC_UNSUPPORTED;}
 r:=SC_check(f.nodes[..],f.roots[..],f.types[0..<2],"candidate");#assert r.error==want;if want==0 {#assert r.return_mask==cast(u64)variant;}
}
#test "malformed graphs and finite budgets refuse before unsafe traversal" {
 f:=SC_fixture();f.nodes[7].a=32;#assert SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate").error==SC_GRAPH;
 f=SC_fixture();f.nodes[0].kind=1;#assert !SC_shape(f.nodes[..],f.roots[..],f.types[0..<1]);
 f=SC_fixture();f.roots[0]=32;#assert !SC_shape(f.nodes[..],f.roots[..],f.types[0..<1]);
 s:=[1]ScAudit.[ScAudit.{visits=65536}];#assert !SC_tick(s[..],1) && s[0].error==SC_LIMIT;
 s[0]=ScAudit.{error=SC_BRANCH};#assert !SC_tick(s[..],1) && s[0].error==SC_BRANCH;
 f=SC_fixture();s[0]=ScAudit.{depth=16};args:=[1]u64.[1];#assert SC_procedure(f.nodes[..],f.roots[..],f.types[0..<1],2,args[..],s[..])==0 && s[0].error==SC_LIMIT;
 #assert !SC_ref(-1,32) && SC_ref(31,32) && !SC_ref(32,32);
}
#test "fingerprints have nonuniform digits and closure rejects equal duplicate tables" {
 digest:[32]u8;for i:0..<32 {digest[i]=cast(u8)i;}
 #assert SC_identity("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",digest[..]);
 paths:=[2]ScPath.[ScPath.{value="same"},ScPath.{value="same"}];#assert !SC_closure(paths[..],paths[..]);
 one:=[1]ScPath.[ScPath.{value="a"}];#assert SC_closure(one[..],one[..]);
 many:[17]ScPath;for i:0..<17 {many[i].value="a";}#assert !SC_closure(many[..],many[..]);
 #assert SC_vartime("_vartime");lengths:=[1]int.[65537];#assert !SC_inputs(lengths[..],0);
}
#forall "graph cardinalities have independent metadata bounds" nodes:1..<4,units:0..<18,types:-1..<2 {
 #assert SC_counts(nodes,units,types)==(nodes>=2 && units>=1 && units<=16 && types>=0);
}
#test "full graph and type cardinalities include their boundary" {
 #assert SC_counts(16384,16,4096) && !SC_counts(16385,16,4096) && !SC_counts(16384,16,4097);
 f:=SC_fixture();f.nodes[1].head=0;#assert SC_shape(f.nodes[0..<2],f.roots[..],f.types[0..<0]);
 #assert !SC_shape(f.nodes[0..<1],f.roots[..],f.types[0..<0]);
}
#forall "every graph reference and source owner is range checked independently" variant:0..<12 {
 f:=SC_fixture();
 if variant==0 {f.nodes[2].unit=-1;}else if variant==1 {f.nodes[2].unit=1;}
 else if variant==2 {f.nodes[1].a=-1;}else if variant==3 {f.nodes[1].b=32;}
 else if variant==4 {f.nodes[1].c=-1;}else if variant==5 {f.nodes[1].d=32;}
 else if variant==6 {f.nodes[1].head=-1;}else if variant==7 {f.nodes[1].next=32;}
 else if variant==8 {f.roots[0]=0;}else if variant==9 {f.nodes[1].kind=64;}
 else if variant==10 {f.types[0].unit=-1;}else {f.types[0].unit=1;}
 #assert !SC_shape(f.nodes[..],f.roots[..],f.types[0..<1]);
 r:=SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==SC_GRAPH && r.unit==-1;
}
#test "root ownership is distinct from ordinary node source bounds" {
 nodes:=[3]ScNode.[ScNode.{},ScNode.{kind=74,unit=1},ScNode.{kind=74,unit=0}];roots:=[2]int.[1,2];types:[1]ScType;
 #assert !SC_shape(nodes[..],roots[..],types[0..<0]);
}
#test "first diagnostic and exact visit boundary survive helper calls" {
 state:[1]ScAudit;SC_fail(state[..],SC_BRANCH,7);#assert state[0].error==SC_BRANCH && state[0].where==7;
 SC_fail(state[..],SC_CALL,8);#assert state[0].error==SC_BRANCH && state[0].where==7;
 state[0]=ScAudit.{};#assert SC_tick(state[..],2) && state[0].visits==1;
 state[0].visits=65535;#assert SC_tick(state[..],2) && state[0].visits==65536;
 #assert !SC_tick(state[..],9) && state[0].error==SC_LIMIT && state[0].where==9;
}
#forall "resolved binding identities match every source coordinate and role" variant:0..<8 {
 f:=SC_fixture();
 if variant==0 {f.types[0].unit=1;}else if variant==1 {f.types[0].procedure="other";}
 else if variant==2 {f.types[0].procedure_line=2;}else if variant==3 {f.types[0].name="other";}
 else if variant==4 {f.types[0].line=2;}else if variant==5 {f.types[0].role="local";}
 else if variant==6 {f.types[0].type="int";}
 #assert SC_resolved(f.types[0..<1],f.nodes[2],f.nodes[5],"parameter")== (variant==7);
}
#test "local bindings cannot shadow or overrun and carry separate origin bits" {
 env:[1]ScEnv;state:[1]ScAudit;SC_bind(env[..],"x",4,state[..],7);#assert env[0].count==1 && env[0].bindings[0].mask==4;
 SC_bind(env[..],"x",8,state[..],8);#assert state[0].error==SC_UNSUPPORTED && state[0].where==8;
 state[0]=ScAudit.{};env[0]=ScEnv.{count=64};SC_bind(env[..],"new",1,state[..],9);#assert state[0].error==SC_UNSUPPORTED && state[0].where==9;
 f:=SC_fixture();f.nodes[5].next=8;f.nodes[8]=ScNode.{kind=68,name="y",line=1,a=3,next=9};f.nodes[9]=ScNode.{kind=68,name="z",line=1,a=3};
 f.nodes[7].name="z";f.types[1]=f.types[0];f.types[1].name="y";f.types[2]=f.types[0];f.types[2].name="z";
 r:=SC_check(f.nodes[..],f.roots[..],f.types[0..<3],"candidate");#assert r.error==0 && r.return_mask==4;
 f.nodes[7]=ScNode.{kind=23,a=10,b=11,op=39};f.nodes[10]=ScNode.{kind=20,name="x"};f.nodes[11]=ScNode.{kind=20,name="y"};
 r=SC_check(f.nodes[..],f.roots[..],f.types[0..<3],"candidate");#assert r.error==0 && r.return_mask==3;
}
#forall "expression operators preserve origins or report the unsupported operation" op:33..<54 {
 f:=SC_fixture();f.nodes[5].next=8;f.nodes[8]=ScNode.{kind=68,name="y",line=1,a=3};f.types[1]=f.types[0];f.types[1].name="y";
 f.nodes[7]=ScNode.{kind=23,a=9,b=10,op=cast(u32)op};f.nodes[9]=ScNode.{kind=20,name="x"};f.nodes[10]=ScNode.{kind=20,name="y"};
 expected:=cast(u32)SC_OK;if op<34 || op>51 || op==37 || op==38 {expected=SC_UNSUPPORTED;}
 else if op==42 || op==43 {expected=SC_SHIFT;}else if op==50 || op==51 {expected=SC_BRANCH;}
 r:=SC_check(f.nodes[..],f.roots[..],f.types[0..<2],"candidate");#assert r.error==expected;if expected==0 {#assert r.return_mask==3;}
}
#forall "unary and cast subsets are explicit" variant:0..<7 {
 f:=SC_fixture();f.nodes[8]=ScNode.{kind=20,name="x"};want:=cast(u32)0;
 if variant<4 {ops:=[4]u32.[34,35,52,36];f.nodes[7]=ScNode.{kind=22,a=8,op=ops[variant]};if variant==3 {want=SC_UNSUPPORTED;}}
 else {f.nodes[7]=ScNode.{kind=30,a=8,d=3,flag=true};if variant==4 {f.nodes[7].flag=false;want=SC_UNSUPPORTED;}if variant==5 {f.nodes[7].d=0;want=SC_UNSUPPORTED;}}
 r:=SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==want;if want==0 {#assert r.return_mask==1;}
}
#test "global constants are public but unresolved values and ambiguous names refuse" {
 f:=SC_fixture();f.nodes[2].next=8;f.nodes[8]=ScNode.{kind=65,name="K",a=9};f.nodes[9]=ScNode.{kind=16};f.nodes[7].name="K";
 r:=SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==0 && r.return_mask==0;
 f.nodes[7].name="candidate";state:[1]ScAudit;env:[1]ScEnv;
 #assert SC_expression(f.nodes[..],f.roots[..],f.types[0..<1],7,env[..],state[..],0)==0 && state[0].error==SC_CALL;
 f.nodes[8].name="candidate";state[0]=ScAudit.{};#assert SC_decl(f.nodes[..],f.roots[..],"candidate",state[..])==0 && state[0].error==SC_GRAPH;
 r=SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==SC_GRAPH && r.unit==-1;
 f=SC_fixture();f.nodes[2].head=0;r=SC_check(f.nodes[..],f.roots[..],f.types[0..<0],"candidate");#assert r.error==SC_ENTRY && r.unit==-1;
 f.nodes[2].kind=65;r=SC_check(f.nodes[..],f.roots[..],f.types[0..<0],"candidate");#assert r.error==SC_ENTRY && r.unit==-1;
 f.nodes[2].head=5;r=SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==SC_ENTRY && r.unit==-1;
}
#test "closure checks do not rely on a later duplicate masking the first mismatch" {
 a:=[2]ScPath.[ScPath.{value="a"},ScPath.{value="b"}];b:=a;b[0].value="c";#assert !SC_closure(a[..],b[..]);
 names:=[17]string.["a","b","c","d","e","f","g","h","i","j","k","l","m","n","o","p","q"];all:[17]ScPath;
 for i:0..<17 {all[i].value=names[i];}#assert SC_closure(all[0..<16],all[0..<16]) && !SC_closure(all[..],all[..]);
}
#test "type nodes preserve nil and kind independently from spelling" {
 nodes:[4]ScNode;nodes[1]=ScNode.{kind=1,name="u64"};#assert SC_type_node(nodes[..],1) && !SC_type_node(nodes[..],0);
 nodes[1].kind=74;#assert !SC_type_node(nodes[..],1);nodes[1].kind=1;nodes[1].name="int";#assert !SC_type_node(nodes[..],1);
}
#forall "component refusal outputs do not contain guessed function or origin identities" variant:0..<10 {
 f:=SC_fixture();state:[1]ScAudit;env:[1]ScEnv;want:=cast(u32)SC_UNSUPPORTED;
 if variant==0 {state[0].error=SC_BRANCH;want=SC_BRANCH;}
 else if variant==1 {f.nodes[7]=ScNode.{kind=22,a=8,op=36};}
 else if variant==2 {f.nodes[7]=ScNode.{kind=21,name="value_barrier"};want=SC_CALL;}
 else if variant==3 {f.nodes[7]=ScNode.{kind=21,name="add_wrap",head=8};f.nodes[8]=ScNode.{kind=16};want=SC_CALL;}
 else if variant==4 {f.nodes[7]=ScNode.{kind=21,name="missing"};want=SC_CALL;}
 else if variant==5 {f.nodes[7]=ScNode.{kind=20,name="missing"};want=SC_CALL;}
 else if variant==6 {f.nodes[7]=ScNode.{kind=21,name="safe_vartime"};want=SC_VARTIME;}
 else if variant==7 {f.nodes[7]=ScNode.{kind=29};}
 else if variant==8 {f.nodes[7]=ScNode.{kind=16};want=SC_LIMIT;}
 else {f.nodes[7]=ScNode.{kind=21,name="value_barrier",head=8};f.nodes[8]=ScNode.{kind=16};f.nodes[5].name="value_barrier";SC_bind(env[..],"value_barrier",1,state[..],5);want=SC_CALL;}
 value:=SC_expression(f.nodes[..],f.roots[..],f.types[0..<1],7,env[..],state[..],ifx variant==8 then 64 else 0);
 #assert value==0 && state[0].error==want;
}
#test "errors already present do not invent declaration or procedure handles" {
 f:=SC_fixture();state:=[1]ScAudit.[ScAudit.{error=SC_BRANCH}];args:=[1]u64.[1];
 #assert SC_decl(f.nodes[..],f.roots[..],"candidate",state[..])==0 && state[0].error==SC_BRANCH;
 #assert SC_procedure(f.nodes[..],f.roots[..],f.types[0..<1],2,args[..],state[..])==0 && state[0].error==SC_BRANCH;
}
#forall "procedure refusals return no origin and preserve the owning diagnostic" variant:0..<8 {
 f:=SC_fixture();state:[1]ScAudit;args:=[9]u64.[1,1,1,1,1,1,1,1,1];want:=cast(u32)SC_CALL;count:=1;
 if variant==0 {f.nodes[2].kind=65;}else if variant==1 {f.nodes[2].flag2=true;}
 else if variant==2 {f.nodes[4].kind=16;}else if variant==3 {f.nodes[5].kind=69;}
 else if variant==4 {count=0;}else if variant==5 {count=9;want=SC_LIMIT;}
 else if variant==6 {f.nodes[2].name="candidate_vartime";want=SC_VARTIME;}
 else {f.nodes[4].head=0;want=SC_UNSUPPORTED;}
 value:=SC_procedure(f.nodes[..],f.roots[..],f.types[0..<1],2,args[0..<count],state[..]);
 #assert value==0 && state[0].error==want;
}
#test "successful scopes restore call depth and repeat callees do not consume records" {
 f:=SC_fixture();state:[1]ScAudit;args:=[1]u64.[4];
 #assert SC_procedure(f.nodes[..],f.roots[..],f.types[0..<1],2,args[..],state[..])==4 && state[0].error==0 && state[0].depth==0;
 #assert SC_procedure(f.nodes[..],f.roots[..],f.types[0..<1],2,args[..],state[..])==4 && state[0].count==1 && state[0].depth==0;
 state[0]=ScAudit.{count=64};#assert SC_procedure(f.nodes[..],f.roots[..],f.types[0..<1],2,args[..],state[..])==0 && state[0].error==SC_LIMIT;
}
#test "public short circuit and asymmetric builtin arguments retain the right origin" {
 f:=SC_fixture();f.nodes[7]=ScNode.{kind=23,op=51,a=8,b=9};f.nodes[8]=ScNode.{kind=18};f.nodes[9]=ScNode.{kind=20,name="x"};
 r:=SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==0 && r.return_mask==1;
 f.nodes[7]=ScNode.{kind=21,name="add_wrap",head=8};f.nodes[8]=ScNode.{kind=16,next=9};
 r=SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==0 && r.return_mask==1;
 nodes:[2]ScNode;nodes[1]=ScNode.{kind=16};state:[1]ScAudit;env:[1]ScEnv;roots:=[1]int.[0];types:[1]ScType;
 #assert SC_expression(nodes[..],roots[..],types[0..<0],1,env[..],state[..],0)==0 && state[0].error==0;
}
#test "argument capacity and call shadowing refuse before origin lookup" {
 f:=SC_fixture();f.nodes[7]=ScNode.{kind=21,name="value_barrier",head=8};
 for i:8..<17 {f.nodes[i]=ScNode.{kind=16,next=ifx i==16 then 0 else i+1};}
 state:[1]ScAudit;env:[1]ScEnv;
 #assert SC_expression(f.nodes[..],f.roots[..],f.types[0..<1],7,env[..],state[..],0)==0 && state[0].error==SC_LIMIT;
 f=SC_fixture();f.nodes[7]=ScNode.{kind=21,name="value_barrier",head=8};f.nodes[8]=ScNode.{kind=29};state[0]=ScAudit.{};
 #assert SC_expression(f.nodes[..],f.roots[..],f.types[0..<1],7,env[..],state[..],0)==0 && state[0].error==SC_UNSUPPORTED;
 f=SC_fixture();f.nodes[7]=ScNode.{kind=31,a=8,b=9,c=10};f.nodes[8]=ScNode.{kind=20,name="x"};state[0]=ScAudit.{};SC_bind(env[..],"x",1,state[..],5);
 #assert SC_expression(f.nodes[..],f.roots[..],f.types[0..<1],7,env[..],state[..],0)==0 && state[0].error==SC_BRANCH;
 f.nodes[7]=ScNode.{kind=26,b=8};state[0]=ScAudit.{};
 #assert SC_expression(f.nodes[..],f.roots[..],f.types[0..<1],7,env[..],state[..],0)==0 && state[0].error==SC_INDEX;
}
#test "recursive calls and exhausted parameter or statement visits return no origin" {
 f:=SC_fixture();state:=[1]ScAudit.[ScAudit.{depth=1}];state[0].stack[0]=2;args:=[1]u64.[1];
 #assert SC_procedure(f.nodes[..],f.roots[..],f.types[0..<1],2,args[..],state[..])==0 && state[0].error==SC_RECURSION;
 for visits:65534..<65536 {
  state[0]=ScAudit.{visits=visits};#assert SC_procedure(f.nodes[..],f.roots[..],f.types[0..<1],2,args[..],state[..])==0 && state[0].error==SC_LIMIT;
 }
}
#test "eight independent secret parameters fit and the ninth refuses" {
 f:=SC_fixture();names:=[9]string.["a","b","c","d","e","f","g","h","i"];types:[9]ScType;
 f.nodes[2].head=16;for i:0..<9 {f.nodes[16+i]=ScNode.{kind=68,name=names[i],line=1,a=3,next=ifx i==8 then 0 else 17+i};types[i]=f.types[0];types[i].name=names[i];}
 f.nodes[23].next=0;f.nodes[7].name="h";
 r:=SC_check(f.nodes[..],f.roots[..],types[0..<8],"candidate");#assert r.error==0 && r.return_mask==128;
 state:[1]ScAudit;args:=[8]u64.[1,2,3,4,5,6,7,8];#assert SC_procedure(f.nodes[..],f.roots[..],types[0..<8],2,args[..],state[..])==8 && state[0].error==0;
 f.nodes[23].next=24;r=SC_check(f.nodes[..],f.roots[..],types[..],"candidate");#assert r.error==SC_LIMIT;
}
#forall "statement refusals retain their own location rather than a missing-return fallback" variant:0..<8 {
 f:=SC_fixture();f.nodes[6]=ScNode.{kind=42,name="z",line=2,a=7,next=8};f.nodes[8]=ScNode.{kind=44,a=9};f.nodes[9]=ScNode.{kind=20,name="z"};
 types:=[2]ScType.[f.types[0],ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="u64"}];where:=6;want:=cast(u32)SC_UNSUPPORTED;
 if variant==0 {f.nodes[6].flag=true;}
 else if variant==1 {types[1].type="int";want=SC_TYPE;}
 else if variant==2 {f.nodes[6]=ScNode.{kind=43,c=9,a=7,op=22};}
 else if variant==3 {f.nodes[6]=ScNode.{kind=43,c=9,a=7,op=23};f.nodes[9].kind=26;}
 else if variant==4 {f.nodes[6]=ScNode.{kind=43,c=9,a=7,op=23};f.nodes[9].name="missing";want=SC_CALL;}
 else if variant==5 {f.nodes[6]=ScNode.{kind=44,a=7,next=8};f.nodes[8]=ScNode.{kind=42,name="z",line=2};where=8;}
 else if variant==6 {f.nodes[6]=ScNode.{kind=47,a=7};}
 else {f.nodes[6]=ScNode.{kind=46,a=7};want=SC_BRANCH;}
 state:[1]ScAudit;args:=[1]u64.[1];value:=SC_procedure(f.nodes[..],f.roots[..],types[..],2,args[..],state[..]);
 #assert state[0].error==want && state[0].where==where;
}
#test "default scalar initialization is public and missing local type data refuses" {
 f:=SC_fixture();f.nodes[6]=ScNode.{kind=42,name="z",line=2,next=8};f.nodes[8]=ScNode.{kind=44,a=9};f.nodes[9]=ScNode.{kind=20,name="z"};
 types:=[2]ScType.[f.types[0],ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="u64"}];
 r:=SC_check(f.nodes[..],f.roots[..],types[..],"candidate");#assert r.error==0 && r.return_mask==0;
 r=SC_check(f.nodes[..],f.roots[..],types[0..<1],"candidate");#assert r.error==SC_TYPE;
}
#forall "all compound assignments classify their operand origins" op:22..<35 {
 f:=SC_fixture();f.nodes[5].next=13;f.nodes[13]=ScNode.{kind=68,name="y",line=1,a=3};
 f.nodes[6]=ScNode.{kind=42,name="z",line=2,a=7,next=8};f.nodes[8]=ScNode.{kind=43,c=9,a=10,op=cast(u32)op,next=11};
 f.nodes[9]=ScNode.{kind=20,name="z"};f.nodes[10]=ScNode.{kind=20,name="y"};f.nodes[11]=ScNode.{kind=44,a=12};f.nodes[12]=ScNode.{kind=20,name="z"};
 types:=[3]ScType.[f.types[0],f.types[0],ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="u64"}];types[1].name="y";
 expected:=cast(u32)0;if op<23 || op>33 || op==27 || op==28 {expected=SC_UNSUPPORTED;}else if op==32 || op==33 {expected=SC_SHIFT;}
 r:=SC_check(f.nodes[..],f.roots[..],types[..],"candidate");#assert r.error==expected;if expected==0 {#assert r.return_mask==cast(u64)(ifx op==23 then 2 else 3);}
}
#forall "public compound operands do not become secret shifts but still retain secret dividends" op:27..<34 {
 f:=SC_fixture();f.nodes[6]=ScNode.{kind=42,name="z",line=2,a=7,next=8};f.nodes[8]=ScNode.{kind=43,c=9,a=10,op=cast(u32)op,next=11};f.nodes[9]=ScNode.{kind=20,name="z"};
 f.nodes[10]=ScNode.{kind=16};f.nodes[11]=ScNode.{kind=44,a=12};f.nodes[12]=ScNode.{kind=20,name="z"};
 types:=[2]ScType.[f.types[0],ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="u64"}];
 r:=SC_check(f.nodes[..],f.roots[..],types[..],"candidate");#assert r.error==cast(u32)(ifx op==27 || op==28 then SC_UNSUPPORTED else 0);
}
#forall "each expression edge keeps its own recursion budget" variant:0..<10,extra:0..<2 {
 f:=SC_fixture();nodes:[100]ScNode;for i:0..<32 {nodes[i]=f.nodes[i];}
 length:=14+extra;for i:0..<length {nodes[32+i]=ScNode.{kind=22,a=33+i,op=52};}nodes[32+length]=ScNode.{kind=16};
 nodes[9]=ScNode.{kind=18};nodes[10]=ScNode.{kind=18};
 if variant==0 {nodes[2].next=8;nodes[8]=ScNode.{kind=65,name="K",a=32};nodes[7]=ScNode.{kind=20,name="K"};}
 else if variant==1 {nodes[7]=ScNode.{kind=22,a=32,op=52};}
 else if variant==2 {nodes[7]=ScNode.{kind=23,a=32,b=9,op=39};}
 else if variant==3 {nodes[7]=ScNode.{kind=23,a=9,b=32,op=39};}
 else if variant==4 {nodes[7]=ScNode.{kind=30,a=32,d=3,flag=true};}
 else if variant==5 {nodes[7]=ScNode.{kind=31,a=32,b=9,c=10};}
 else if variant==6 {nodes[7]=ScNode.{kind=31,a=9,b=32,c=10};}
 else if variant==7 {nodes[7]=ScNode.{kind=31,a=9,b=10,c=32};}
 else if variant==8 {nodes[7]=ScNode.{kind=26,b=32};}
 else {nodes[7]=ScNode.{kind=21,name="value_barrier",head=32};}
 state:[1]ScAudit;env:[1]ScEnv;value:=SC_expression(nodes[..],f.roots[..],f.types[0..<1],7,env[..],state[..],0);
 expected:=ifx extra==1 then SC_LIMIT else ifx variant==8 then SC_UNSUPPORTED else SC_OK;
 #assert value==0 && state[0].error==cast(u32)expected;
}
#forall "procedure expression roots start at depth zero for every statement" variant:0..<5 {
 f:=SC_fixture();nodes:[100]ScNode;for i:0..<32 {nodes[i]=f.nodes[i];}nodes[3].name="bool";f.types[0].type="bool";
 for i:0..<15 {nodes[32+i]=ScNode.{kind=22,a=33+i,op=52};}nodes[47]=ScNode.{kind=20,name="x"};
 types:=[2]ScType.[f.types[0],ScType.{procedure="candidate",procedure_line=1,name="z",line=2,role="local",type="bool"}];
 if variant==0 {nodes[6].a=32;}
 else if variant==1 {nodes[6]=ScNode.{kind=42,name="z",line=2,a=32,next=8};nodes[8]=ScNode.{kind=44,a=9};nodes[9]=ScNode.{kind=20,name="z"};}
 else if variant==2 {nodes[6]=ScNode.{kind=42,name="z",line=2,next=8};nodes[8]=ScNode.{kind=43,c=9,a=32,op=23,next=10};nodes[9]=ScNode.{kind=20,name="z"};nodes[10]=ScNode.{kind=44,a=9};}
 else {nodes[6]=ScNode.{kind=cast(u32)(42+variant),a=32};}
 r:=SC_check(nodes[..],f.roots[..],types[..],"candidate");#assert r.error==cast(u32)(ifx variant<3 then SC_OK else SC_BRANCH);
 if variant<3 {#assert r.return_mask==1;}
}
#test "a real procedure name cannot bypass a scalar binding in the same environment" {
 f:=SC_fixture();f.nodes[7]=ScNode.{kind=21,name="candidate",head=8};f.nodes[8]=ScNode.{kind=16};
 env:=[1]ScEnv.[ScEnv.{count=1}];env[0].bindings[0]=ScBinding.{name="candidate",mask=1};state:[1]ScAudit;
 #assert SC_expression(f.nodes[..],f.roots[..],f.types[0..<1],7,env[..],state[..],0)==0 && state[0].error==SC_CALL;
}
#test "assignment to the first parameter binding remains a valid replacement" {
 f:=SC_fixture();f.nodes[6]=ScNode.{kind=43,c=7,a=8,op=23,next=9};f.nodes[8]=ScNode.{kind=16};f.nodes[9]=ScNode.{kind=44,a=7};
 r:=SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate");#assert r.error==0 && r.return_mask==0;
}
#forall "public statement conditions are unsupported rather than secret branches" kind:45..<47 {
 f:=SC_fixture();f.nodes[6]=ScNode.{kind=cast(u32)kind,a=7};f.nodes[7]=ScNode.{kind=18};
 #assert SC_check(f.nodes[..],f.roots[..],f.types[0..<1],"candidate").error==SC_UNSUPPORTED;
}
