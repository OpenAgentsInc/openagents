// Large profile only: source-shaped graphs for the unsigned range rules.
// candidate :: (x:u64,p:u64)->u64, with x secret and p public, a u64 local c
// (line 2) and a loop index i (line 3). Graphs are built inside the checks.
AgRangeFrame :: struct {nodes:[48]ScNode;values:[48]u64;types:[4]ScType;roots:[1]int;}
// Loop cases: statement 6 is "c:u64;" (or "c:=start;"), then
// "for i:0..<4 {c=<update>;}" and "return c;". Node 30 is x>>63 and 33 is x>>32.
// 0: carry c=((x>>32)+(x>>32)+c)>>32 needs a second pass with c in [0,1].
// 1: c=(c+(x>>63))&7 converges on the fourth pass; 2: &15 would need a fifth.
// 3: a growing sum c=c+(x>>63) never converges and refuses with type ranges.
// 4, 5: x itself is carried after "x=x>>63;": x=(x+x)&7 converges, x=x+1 grows.
// 6: the carry loop entered with c:=x>>32 still fits; 7: entered with c:=x it can overflow.
#forall "loop ranges stand only as inductive invariants found within four passes" variant:0..<8 {
 update:=ifx variant>=6 then 0 else variant;start:=ifx variant==6 then 33 else ifx variant==7 then 31 else 0;
 f:AgRangeFrame;f.roots[0]=1;f.nodes[1]=ScNode.{kind=74,head=2};
 f.nodes[2]=ScNode.{kind=64,name="candidate",line=1,a=3,b=4,head=5};f.nodes[3]=ScNode.{kind=1,name="u64"};f.nodes[4]=ScNode.{kind=40,head=6};
 f.nodes[5]=ScNode.{kind=68,name="x",line=1,a=3,next=40};f.nodes[40]=ScNode.{kind=68,name="p",line=1,a=3};f.nodes[41]=ScNode.{kind=1,name="u32"};
 f.types[0]=ScType.{procedure="candidate",procedure_line=1,name="x",line=1,role="parameter",type="u64"};
 f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="p",line=1,role="parameter",type="u64"};
 f.types[2]=ScType.{procedure="candidate",procedure_line=1,name="c",line=2,role="local",type="u64"};
 f.types[3]=ScType.{procedure="candidate",procedure_line=1,name="i",line=3,role="loop",type="int"};f.nodes[6]=ScNode.{kind=42,name="c",line=2,a=start,next=7};
 f.nodes[7]=ScNode.{kind=47,name="i",line=3,a=8,b=9,c=10,next=12};f.nodes[8]=ScNode.{kind=16};f.nodes[9]=ScNode.{kind=16};f.values[9]=4;
 f.nodes[10]=ScNode.{kind=40,head=11};f.nodes[11]=ScNode.{kind=43,c=13,a=20,op=23};f.nodes[12]=ScNode.{kind=44,a=14};f.nodes[13]=ScNode.{kind=20,name="c"};f.nodes[14]=ScNode.{kind=20,name="c"};
 f.nodes[30]=ScNode.{kind=23,a=31,b=32,op=43};f.nodes[31]=ScNode.{kind=20,name="x"};f.nodes[32]=ScNode.{kind=16};f.values[32]=63;
 f.nodes[33]=ScNode.{kind=23,a=34,b=35,op=43};f.nodes[34]=ScNode.{kind=20,name="x"};f.nodes[35]=ScNode.{kind=16};f.values[35]=32;
 f.nodes[21]=ScNode.{kind=20,name="c"};f.nodes[24]=ScNode.{kind=16};
 if update==0 {f.nodes[20]=ScNode.{kind=23,a=22,b=21,op=34};f.nodes[22]=ScNode.{kind=23,a=33,b=33,op=34};f.nodes[23]=ScNode.{kind=16};f.nodes[25]=ScNode.{kind=23,a=20,b=24,op=43};f.values[24]=32;f.nodes[11].a=25;}
 else if update<=2 {f.nodes[22]=ScNode.{kind=23,a=21,b=30,op=34};f.nodes[20]=ScNode.{kind=23,a=22,b=24,op=39};f.values[24]=ifx update==1 then 7 else 15;}
 else if update==3 {f.nodes[20]=ScNode.{kind=23,a=21,b=30,op=34};}
 // update 4 and 5 carry x itself, after "x=x>>63;": x=(x+x)&7 converges, x=x+1 grows.
 else {f.nodes[6]=ScNode.{kind=43,c=36,a=30,op=23,next=7};f.nodes[36]=ScNode.{kind=20,name="x"};f.nodes[13]=ScNode.{kind=20,name="x"};f.nodes[14]=ScNode.{kind=20,name="x"};f.nodes[21]=ScNode.{kind=20,name="x"};
  if update==4 {f.nodes[22]=ScNode.{kind=23,a=21,b=21,op=34};f.nodes[20]=ScNode.{kind=23,a=22,b=24,op=39};f.values[24]=7;}
  else {f.nodes[20]=ScNode.{kind=23,a=21,b=24,op=34};f.values[24]=1;}}
 memory:[1]AgMemory;labels:=[2]AgLabel.[AgLabel.{name="x",type="u64"},AgLabel.{name="p",type="u64"}];
 r:=AG_check_classified(f.nodes[..],f.values[..],f.roots[..],f.types[..],"candidate",memory[..],1,labels[..],false);
 accepted:=variant==0 || variant==1 || variant==4 || variant==6;
 if accepted {#assert r.error==0 && r.return_mask==1;}else {#assert r.error==SC_UNSUPPORTED;}
}
// Expression cases: "return <node 10>;" with helper nodes 30 x>>63, 33 x>>32, 36 p==0.
#forall "expression ranges come from literals, bindings, casts and public choices" shape:0..<17 {
 f:AgRangeFrame;f.roots[0]=1;f.nodes[1]=ScNode.{kind=74,head=2};
 f.nodes[2]=ScNode.{kind=64,name="candidate",line=1,a=3,b=4,head=5};f.nodes[3]=ScNode.{kind=1,name="u64"};f.nodes[4]=ScNode.{kind=40,head=6};
 f.nodes[5]=ScNode.{kind=68,name="x",line=1,a=3,next=40};f.nodes[40]=ScNode.{kind=68,name="p",line=1,a=3};f.nodes[41]=ScNode.{kind=1,name="u32"};
 f.types[0]=ScType.{procedure="candidate",procedure_line=1,name="x",line=1,role="parameter",type="u64"};
 f.types[1]=ScType.{procedure="candidate",procedure_line=1,name="p",line=1,role="parameter",type="u64"};
 f.types[2]=ScType.{procedure="candidate",procedure_line=1,name="c",line=2,role="local",type="u64"};
 f.types[3]=ScType.{procedure="candidate",procedure_line=1,name="i",line=3,role="loop",type="int"};f.nodes[6]=ScNode.{kind=44,a=10};
 f.nodes[30]=ScNode.{kind=23,a=31,b=32,op=43};f.nodes[31]=ScNode.{kind=20,name="x"};f.nodes[32]=ScNode.{kind=16};f.values[32]=63;
 f.nodes[33]=ScNode.{kind=23,a=34,b=35,op=43};f.nodes[34]=ScNode.{kind=20,name="x"};f.nodes[35]=ScNode.{kind=16};f.values[35]=32;
 f.nodes[36]=ScNode.{kind=23,a=37,b=38,op=44};f.nodes[37]=ScNode.{kind=20,name="p"};f.nodes[38]=ScNode.{kind=16};
 f.nodes[11]=ScNode.{kind=16};f.nodes[12]=ScNode.{kind=16};
 // (x>>63)+5, and x+5.
 if shape==0 {f.nodes[10]=ScNode.{kind=23,a=30,b=11,op=34};f.values[11]=5;}
 if shape==1 {f.nodes[10]=ScNode.{kind=23,a=31,b=11,op=34};f.values[11]=5;}
 // c:=x>>32; return c+c;   and c:u64; return c+(x>>63);
 if shape==2 || shape==3 {f.nodes[6]=ScNode.{kind=42,name="c",line=2,a=ifx shape==2 then 33 else 0,next=7};f.nodes[7]=ScNode.{kind=44,a=10};f.nodes[13]=ScNode.{kind=20,name="c"};
  f.nodes[10]=ScNode.{kind=23,a=13,b=ifx shape==2 then 13 else 30,op=34};}
 // cast(u64)(cast(u32)(x>>32))+(x>>63), with the inner cast checked or truncating, and x truncated.
 if shape>=4 && shape<=6 {f.nodes[14]=ScNode.{kind=30,a=ifx shape==6 then 31 else 33,d=41,flag=shape!=4};f.nodes[15]=ScNode.{kind=30,a=14,d=3};f.nodes[10]=ScNode.{kind=23,a=15,b=30,op=34};}
 // (ifx p==0 then (x>>63)+4 else (x>>63)+6)-4, and the same with +2 in the first arm.
 if shape==7 || shape==8 {f.nodes[16]=ScNode.{kind=31,a=36,b=17,c=18};f.nodes[17]=ScNode.{kind=23,a=30,b=11,op=34};f.values[11]=ifx shape==7 then 4 else 2;
  f.nodes[18]=ScNode.{kind=23,a=30,b=12,op=34};f.values[12]=6;f.nodes[19]=ScNode.{kind=16};f.values[19]=4;f.nodes[10]=ScNode.{kind=23,a=16,b=19,op=35};}
 // (ifx p==0 then x>>63 else x>>62)+(x>>63): the union keeps hi 3.
 if shape==9 {f.nodes[16]=ScNode.{kind=31,a=36,b=30,c=20};f.nodes[20]=ScNode.{kind=23,a=31,b=21,op=43};f.nodes[21]=ScNode.{kind=16};f.values[21]=62;f.nodes[10]=ScNode.{kind=23,a=16,b=30,op=34};}
 // (1<<35)-cast(u64)(cast,trunc(u32)(x>>24)): truncation must drop the [0,2^40) range.
 if shape==10 {f.nodes[22]=ScNode.{kind=23,a=31,b=23,op=43};f.nodes[23]=ScNode.{kind=16};f.values[23]=24;f.nodes[14]=ScNode.{kind=30,a=22,d=41,flag=true};f.nodes[15]=ScNode.{kind=30,a=14,d=3};
  f.nodes[24]=ScNode.{kind=30,a=25,d=3};f.nodes[25]=ScNode.{kind=16};f.values[25]=1;f.nodes[26]=ScNode.{kind=23,a=24,b=27,op=42};f.nodes[27]=ScNode.{kind=16};f.values[27]=35;f.nodes[10]=ScNode.{kind=23,a=26,b=15,op=35};}
 // c:u64; return (c+(x>>63))-c;   and c:u64; return (c+(x>>63))-1;  c starts as exactly 0.
 if shape==11 || shape==12 {f.nodes[6]=ScNode.{kind=42,name="c",line=2,next=7};f.nodes[7]=ScNode.{kind=44,a=10};f.nodes[13]=ScNode.{kind=20,name="c"};f.values[11]=1;
  f.nodes[17]=ScNode.{kind=23,a=13,b=30,op=34};f.nodes[10]=ScNode.{kind=23,a=17,b=ifx shape==11 then 13 else 11,op=35};}
 // mul_wrap(x>>32,x>>32)+(x>>63) cannot wrap; mul_wrap(x>>31,x>>32) can.
 // add_wrap(x>>63,x>>63)+(x>>63) cannot wrap; add_wrap(x>>0,x>>63) can.
 if shape>=13 {f.nodes[10]=ScNode.{kind=23,a=16,b=30,op=34};f.nodes[16]=ScNode.{kind=21,name=ifx shape<=14 then "mul_wrap" else "add_wrap",head=17};
  f.nodes[17]=ScNode.{kind=23,a=31,b=19,op=43,next=18};f.nodes[19]=ScNode.{kind=16};f.values[19]=ifx shape==13 then 32 else ifx shape==14 then 31 else ifx shape==15 then 63 else 0;
  f.nodes[18]=ScNode.{kind=23,a=31,b=20,op=43};f.nodes[20]=ScNode.{kind=16};f.values[20]=ifx shape<=14 then 32 else 63;}
 memory:[1]AgMemory;labels:=[2]AgLabel.[AgLabel.{name="x",type="u64"},AgLabel.{name="p",type="u64"}];
 r:=AG_check_classified(f.nodes[..],f.values[..],f.roots[..],f.types[..],"candidate",memory[..],1,labels[..],false);
 refused:=shape==1 || shape==8 || shape==12 || shape==14 || shape==16;
 if refused {#assert r.error==SC_UNSUPPORTED;}else {#assert r.error==0 && r.return_mask==1;}
}
