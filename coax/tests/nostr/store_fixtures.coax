// One signed event in three exact encodings, for the store's checks
// (store_verified_checks.coax, store_file_main.coax). The event is
// store_admit.coax's NS_VALID_TEST (BIP-340 test key). SVC_REORDERED has its
// fields in another order and SVC_ESCAPED writes "h" as \u0068: one id and
// signature. SVC_REORDERED has the lowest bytes, then SVC_ESCAPED, then
// NS_VALID_TEST.
#load "../../lib/nostr/store_admit.coax";
SVC_REORDERED :: "{\"id\":\"b0fefc732064caade01b2cb9c7a954848860a91d2d40b6673960c96128fe004f\",\"sig\":\"92f72cb720a448d2ffd93220af78149293a81406c9f19c813e90d51388861d92ced3eae53e3c8e87f2770506fa5110c8dd692a673c4e2ad25481b92abc2a77b1\",\"content\":\"hello\",\"tags\":[],\"kind\":1,\"created_at\":0,\"pubkey\":\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\"}";
SVC_ESCAPED :: "{\"pubkey\":\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\",\"created_at\":0,\"kind\":1,\"tags\":[],\"content\":\"\\u0068ello\",\"id\":\"b0fefc732064caade01b2cb9c7a954848860a91d2d40b6673960c96128fe004f\",\"sig\":\"92f72cb720a448d2ffd93220af78149293a81406c9f19c813e90d51388861d92ced3eae53e3c8e87f2770506fa5110c8dd692a673c4e2ad25481b92abc2a77b1\"}";
