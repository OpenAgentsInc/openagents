// The store with real BIP-340 verification (nostr-event-store #8eb5, #f539).
// A fast verification costs about 19M interpreter steps and the relay's
// nostr_event_verify_vartime about 76M, so run these with a larger budget:
//   coax test coax/tests/nostr/store_verified_checks.coax --steps 400000000
// The signed event is store_admit.coax's NS_VALID_TEST (BIP-340 test key).
// SVC_REORDERED is the same event with its fields in another order and
// SVC_ESCAPED the same with "h" written as h: one id and signature,
// three exact originals. SVC_REORDERED has the lowest bytes, then
// SVC_ESCAPED, then NS_VALID_TEST. Generated by hand from NS_VALID_TEST.
#load "../../lib/nostr/store.coax";
#load "../../lib/nostr/store_admit.coax";

main :: () {}

SVC_REORDERED :: "{\"id\":\"b0fefc732064caade01b2cb9c7a954848860a91d2d40b6673960c96128fe004f\",\"sig\":\"92f72cb720a448d2ffd93220af78149293a81406c9f19c813e90d51388861d92ced3eae53e3c8e87f2770506fa5110c8dd692a673c4e2ad25481b92abc2a77b1\",\"content\":\"hello\",\"tags\":[],\"kind\":1,\"created_at\":0,\"pubkey\":\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\"}";
SVC_ESCAPED :: "{\"pubkey\":\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\",\"created_at\":0,\"kind\":1,\"tags\":[],\"content\":\"\\u0068ello\",\"id\":\"b0fefc732064caade01b2cb9c7a954848860a91d2d40b6673960c96128fe004f\",\"sig\":\"92f72cb720a448d2ffd93220af78149293a81406c9f19c813e90d51388861d92ced3eae53e3c8e87f2770506fa5110c8dd692a673c4e2ad25481b92abc2a77b1\"}";

// The relay's path, with the fast verifier in place of the relay's slower
// one: read with the id check, verify the signature, admit the result.
svc_admit :: (s: [] RsdStore, text: string) -> int {
  scratch: [4096] u8; vs: [4096] u8;
  r := rs_admit_read(text, 1000, false, false, scratch[..]);
  if r.reason != RS_ACCEPT { return r.reason; }
  v := nostr_event_read(text, vs[..], false);
  if v.error == NE_OK { v = ne_verified(v, nostr_fast_verify_vartime(v.id[..], v.public_key[..], v.signature[..])); }
  r = rs_admit_verified(r, v);
  if r.reason != RS_ACCEPT { return r.reason; }
  return rsd_admit(s, r, text);
}
#test "three encodings of one signed event read as the same id" {
  a: [4096] u8; b: [4096] u8; c: [4096] u8;
  ea := nostr_event_read(NS_VALID_TEST, a[..], false); eb := nostr_event_read(SVC_REORDERED, b[..], false); ec := nostr_event_read(SVC_ESCAPED, c[..], false);
  #assert ea.error == NE_OK && eb.error == NE_OK && ec.error == NE_OK;
  ia := ea.id; ib := eb.id; ic := ec.id;
  #assert cast(string) ia[..] == cast(string) ib[..] && cast(string) ia[..] == cast(string) ic[..];
  #assert ns_original_before(SVC_REORDERED, SVC_ESCAPED) && ns_original_before(SVC_ESCAPED, NS_VALID_TEST);
}
#test "verified duplicates converge on the lowest original: original, then escaped" {
  arena: [4096] u8; recs: [4] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  #assert svc_admit(s[..], NS_VALID_TEST) == RS_ACCEPT;
  #assert svc_admit(s[..], SVC_ESCAPED) == RS_DUP;
  #assert s[0].live == 1 && s[0].bytes == SVC_ESCAPED.count && rsd_text(s[..], s[0].n - 1) == SVC_ESCAPED;
  f: NostrFilter; idx: [4] int;
  #assert rsd_query(s[..], f, 1000, idx[..]) == 1 && rsd_text(s[..], idx[0]) == SVC_ESCAPED;
}
#test "verified duplicates converge on the lowest original: reordered first" {
  arena: [4096] u8; recs: [4] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  #assert svc_admit(s[..], SVC_REORDERED) == RS_ACCEPT;
  #assert svc_admit(s[..], SVC_ESCAPED) == RS_DUP;
  #assert s[0].n == 1 && s[0].live == 1 && s[0].bytes == SVC_REORDERED.count && rsd_text(s[..], 0) == SVC_REORDERED;
}
#test "verified duplicates converge on the lowest original: escaped, then reordered" {
  arena: [4096] u8; recs: [4] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  #assert svc_admit(s[..], SVC_ESCAPED) == RS_ACCEPT;
  #assert svc_admit(s[..], SVC_REORDERED) == RS_DUP;
  #assert s[0].n == 1 && s[0].live == 1 && s[0].bytes == SVC_REORDERED.count && rsd_text(s[..], 0) == SVC_REORDERED;
}
#test "a forged signature or a wrong signer never reaches the store" {
  arena: [4096] u8; recs: [4] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  raw: [1024] u8; for i: 0..<NS_VALID_TEST.count { raw[i] = NS_VALID_TEST[i]; } raw[NS_VALID_TEST.count - 3] = '0';
  #assert svc_admit(s[..], cast(string) raw[0..<NS_VALID_TEST.count]) == RS_BAD_SIG && s[0].n == 0 && s[0].used == 0;
  #assert svc_admit(s[..], NS_WRONG_SIGNER_TEST) == RS_BAD_SIG && s[0].n == 0 && s[0].used == 0;
}
#test "the relay's own verifier admits through the store" {
  arena: [4096] u8; recs: [4] RsdRec; s: [1] RsdStore; s[0].arena = arena[..]; s[0].recs = recs[..];
  scratch: [4096] u8;
  r := rs_admit_read(SVC_REORDERED, 1000, false, false, scratch[..]);
  r = rs_admit_verified(r, nostr_event_verify_vartime(SVC_REORDERED, scratch[..], false));
  #assert r.reason == RS_ACCEPT && rsd_admit(s[..], r, SVC_REORDERED) == RS_ACCEPT && s[0].n == 1;
  // the same verified result does not admit other bytes
  #assert rsd_admit(s[..], r, NS_VALID_TEST) == RS_BAD_SIG && s[0].n == 1;
}
