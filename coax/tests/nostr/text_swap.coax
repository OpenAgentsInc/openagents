// Test helpers for checks that edit one JSON fixture: ts_swap replaces the
// first occurrence of from (which must occur) and ts_fill writes n copies of
// a byte. They live here so that mutation runs on the files that load them
// mutate only the code under test.
ts_swap :: (text:string,from:string,to:string,out:[]u8)->string {
  at:=-1;
  for i:0..<text.count-from.count+1 {if text[i..<i+from.count]==from {at=i;break;}}
  #assert at>=0;
  n:=0;
  for i:0..<at {out[n]=text[i];n+=1;}
  for c:to {out[n]=c;n+=1;}
  for i:at+from.count..<text.count {out[n]=text[i];n+=1;}
  return cast(string)out[0..<n];
}
ts_fill :: (c:u8,n:int,out:[]u8)->string {for i:0..<n {out[i]=c;}return cast(string)out[0..<n];}
// "prefix" + n copies of c + "suffix" into out.
ts_wrap :: (prefix:string,c:u8,n:int,suffix:string,out:[]u8)->string {
  k:=0;
  for x:prefix {out[k]=x;k+=1;}
  for i:0..<n {out[k]=c;k+=1;}
  for x:suffix {out[k]=x;k+=1;}
  return cast(string)out[0..<k];
}
// s at out[k], and where it ends.
ts_put :: (s:string,out:[]u8,k:int)->int {n:=k;for c:s {out[n]=c;n+=1;}return n;}
// i (0 to 999) in decimal at out[k], and where it ends.
ts_num :: (i:int,out:[]u8,k:int)->int {
  n:=k;
  if i>=100 {out[n]=cast(u8)('0'+i/100);n+=1;}
  if i>=10 {out[n]=cast(u8)('0'+(i/10)%10);n+=1;}
  out[n]=cast(u8)('0'+i%10);return n+1;
}
