// 2n hex digits into n bytes.
vt_hex_test :: (text:string,out:[]u8) {
  for i:0..<text.count/2 {out[i]=cast(u8)(vt_digit_test(text[2*i])*16+vt_digit_test(text[2*i+1]));}
}
vt_digit_test :: (c:u8)->int {return ifx c>='a' then cast(int)(c-'a')+10 else cast(int)(c-'0');}
// A base64 blob decoded into out, as the string a reader takes.
vt_blob_test :: (b64:string,out:[]u8)->string {r:=base64_decode_checked(b64,out,false);#assert r.error==NC_OK;return cast(string)out[0..<r.written];}
// A copy of text with the first occurrence of from replaced by to.
vt_case :: (out:[]u8,text:string,from:string,to:string)->string {
  at:=-1;i:=0;while at<0 && i+from.count<=text.count {if text[i..<i+from.count]==from {at=i;}i+=1;}
  #assert at>=0;
  n:=json_raw(out,0,text[0..<at]);n=json_raw(out,n,to);n=json_raw(out,n,text[at+from.count..<text.count]);
  return cast(string)out[0..<n];
}
// magic || be32(header.count) || header || body.
vt_rebuild :: (header:string,body:string,out:[]u8)->string {
  n:=json_raw(out,0,"OAVAULT1");
  for k:0..<4 {out[n+k]=cast(u8)((header.count>>(8*(3-k)))&255);}
  n=json_raw(out,n+4,header);n=json_raw(out,n,body);return cast(string)out[0..<n];
}
// A copy of text with byte i exclusive-ored with x.
vt_flip :: (text:string,i:int,x:u8,out:[]u8)->string {for k:0..<text.count {out[k]=text[k];}out[i]^=x;return cast(string)out[0..<text.count];}
// The reader takes bytes: text copied into buf, read from there.
vt_u8 :: (text:string,buf:[]u8)->[]u8 {for k:0..<text.count {buf[k]=text[k];}return buf[0..<text.count];}
vt_object_read_t :: (buf:[]u8,text:string)->VtObject {return vt_object_read(vt_u8(text,buf));}
vt_open_t :: (buf:[]u8,text:string,slot:string,secret:[]u8,out:[]u8)->VtResult {return vt_open(vt_u8(text,buf),slot,secret,out);}
// text with its last byte (the closing brace) replaced by tail.
vt_append :: (out:[]u8,text:string,tail:string)->string {
  n:=json_raw(out,0,text[0..<text.count-1]);n=json_raw(out,n,tail);return cast(string)out[0..<n];
}
// Whether every byte of the key material is zero again.
vt_zero_test :: (b:[]u8)->bool {for x:b {if x!=0 {return false;}}return true;}
vt_kdf_zero_test :: (k:VtKdf)->bool {p:=k.prk;q:=k.key;return vt_zero_test(p[..]) && vt_zero_test(q[..]);}
vt_work_zero_test :: (w:VtWork)->bool {
  a:=w.vmk;b:=w.kwrap;c:=w.dek;return vt_kdf_zero_test(w.kdf[0]) && vt_zero_test(a[..]) && vt_zero_test(b[..]) && vt_zero_test(c[..]);
}
vt_plain_zero_test :: (p:VtPlain)->bool {a:=p.work;b:=p.plain;return vt_zero_test(a[..]) && vt_zero_test(b[..]);}

