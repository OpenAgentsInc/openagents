#import "Basic";

#test "secure erase changes the selected storage and preserves its guards" {
  bytes := [4]u8.[11,22,33,44];
  alias := bytes[..];
  secure_zero(bytes[1..<3]);
  #assert alias[0] == 11 && alias[1] == 0 && alias[2] == 0 && alias[3] == 44;
  secure_zero(bytes[0..<0]);
  #assert bytes[0] == 11;
  words := [2]u64.[18446744073709551615,77];
  secure_zero(words[..]);
  #assert words[0] == 0 && words[1] == 0;
}

erase_before_return :: (bytes: []u8) -> int {
  defer secure_zero(bytes);
  bytes[0] = 91;
  return 7;
}

#test "deferred erasure runs before return" {
  bytes := [2]u8.[1,2];
  #assert erase_before_return(bytes[..]) == 7;
  #assert bytes[0] == 0 && bytes[1] == 0;
}

main :: () {
  bytes := [4]u8.[11,22,33,44];
  secure_zero(bytes[1..<3]);
  print("%, %, %, %\n", bytes[0], bytes[1], bytes[2], bytes[3]);
  result := erase_before_return(bytes[..]);
  print("result %; erased %, %, %, %\n", result, bytes[0], bytes[1], bytes[2], bytes[3]);
}
