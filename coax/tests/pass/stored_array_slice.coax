#import "Basic";
// A fixed array returned by value and stored into a caller's field is copied
// there, so slicing the field borrows the caller's storage, not the helper's
// array literal (#12676).
pick :: (f: [] int) -> [2] [] int { return [2] [] int.[f[0..<1], f[1..<3]]; }
Box :: struct { f: [3] int; a: [2] [] int; }
fill :: (x: [] Box) { x[0].a = pick(x[0].f[..]); }
views :: (x: [] Box) -> [] [] int { fill(x); return x[0].a[..]; }
// The same store made directly, with no helper.
copied :: (x: [] Box) -> [] [] int {
  r := [2] [] int.[x[0].f[2..<3], x[0].f[0..<2]];
  x[0].a = r;
  return x[0].a[..];
}
main :: () {
  b: [1] Box; b[0].f = [3] int.[4, 5, 6];
  v := views(b[..]);
  print("% % %\n", v.count, v[0][0], v[1][1]);
  w := copied(b[..]);
  print("% % %\n", w[0][0], w[1][0], w[1].count);
}
