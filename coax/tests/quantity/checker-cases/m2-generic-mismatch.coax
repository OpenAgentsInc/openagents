Speed :: struct @unit(mass=0,length=1,time=-1,angle=0,numerator=1,denominator=1) {}
OtherMetre :: struct @unit(mass=0,length=1,time=0,angle=0,numerator=1,denominator=1) {}
Count :: struct @unit(mass=0,length=0,time=0,angle=0,numerator=1,denominator=1) {}
scale :: (s:$R:numeric,x:u.Quantity(UnitQuotient(u.Metre,u.Second),$R))->u.Quantity(UnitQuotient(u.Metre,u.Second),$R) {return s*x;} wrong :: (x:u.Quantity(UnitQuotient(u.Metre,u.Radian),f32)) {v:=scale(2,x);}
