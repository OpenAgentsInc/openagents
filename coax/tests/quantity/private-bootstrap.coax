#import "Basic";
#load "../../lib/quantity.coax" as units;

main :: () {
    distance: units.Quantity(units.Metre,f64) = units.Quantity.{value=3};
    doubled := distance*2.0f64;
    half_metres := convert_unit(units.HalfMetre,doubled);
    print("private quantity: % half-metres\n",half_metres.value);
}
