#import "Basic";
#load "shapes.coax" as shapes;

// main prints area(); the word Shape here is a comment.
total :: (all: [3] shapes.Shape) -> s32 {
  sum: s32 = 0;
  for s: all {
    a := shapes.area(s);
    sum += a;
  }
  return sum;
}

main :: () {
  all: [3] shapes.Shape;
  print("area % of Shape\n", total(all));
  print("% corners\n", shapes.corners(all[..]));
}

#test "total adds the areas" {
  all: [3] shapes.Shape;
  all[1].size = 4;
  #assert total(all) == 24;
}
