// Focused R2 borrow and lookup semantic oracles. Tooling-only; not compiler input.
#load "../lib/compiler/checker.coax";
#authority;

#test "R2 B2 indexed addressed-storage queries retain valid kind3 rows" {
 nodes:[12]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=11,type_count=17}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;scratch:[1280]int;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=scratch[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};path:=BS_Path.{count=1};path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};out:[64]BS_Origin;
 first:=CB_query(b,3,3,path,out[..]);#assert !state[0].fatal && state[0].error_count==0 && first.count==1 && !first.incomplete && out[0].kind==BS_PARAMETER && out[0].root==0 && bs_path_equal(out[0].path,path);
 b.query_index=CB_index_begin(b);again:=CB_query(b,3,3,path,out[..]);#assert !state[0].fatal && state[0].error_count==0 && again.count==1 && !again.incomplete && out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].type==12 && bs_path_equal(out[0].path,path) && work[0].queries==1;
}

#forall "R2 focused borrow container syntax preserves optional identity and rejects Result storage" shape:0..<3,result:bool {
 nodes:[20]CK_Node;types:[32]CK_Type;locals:[4]CK_Local;errors:[8]CK_Error;bytes:[1024]u8;state:=[1]CK_State.[CK_State.{used=19,type_count=17,generic=2}];for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.param,name="$N",decl=2,bits=1,length=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,name="bound"};nodes[3]=CK_Node.{kind=CK_Tag.expr_int,value=2};nodes[5]=CK_Node.{kind=CK_Tag.type_view,b=6,loc=CK_Loc.{line=901,column=7}};nodes[6]=CK_Node.{kind=CK_Tag.type_optional,b=7};nodes[7]=CK_Node.{kind=CK_Tag.type_named,name="int"};
 if shape!=0 {nodes[5].kind=CK_Tag.type_array;nodes[5].a=3;}if shape==2 {nodes[3]=CK_Node.{kind=CK_Tag.type_param,name="N"};}
 if result {nodes[6]=CK_Node.{kind=CK_Tag.type_named,name="Result",head=7};nodes[7].next=8;nodes[8]=CK_Node.{kind=CK_Tag.type_named,name="u8"};}
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};expected:=0;if !result {expected=CK_sum_type(c,CK_Kind.optional,11,0,CK_Loc.{});}got:=0;if result {nodes[9]=CK_Node.{kind=CK_Tag.stmt_var,name="invalid",d=5,a=10};nodes[10]=CK_Node.{kind=CK_Tag.expr_int,value=7};CK_stmt(c,9);}else {got=CK_resolve(c,5,CK_Access.value);}
 #assert !state[0].fatal;if result {#assert state[0].error_count==1 && errors[0].code=="E0900" && errors[0].loc.line==901;}
 else {#assert state[0].error_count==0 && got>=16 && types[got].elem==expected && types[got].kind==(ifx shape==0 then CK_Kind.view else CK_Kind.array);if shape!=0 {#assert types[got].length==2;}}
}
#test "R2 focused borrow nominal union syntax refuses written type arguments" {
 nodes:[12]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;bytes:[512]u8;state:=[1]CK_State.[CK_State.{used=11,type_count=17}];for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.union_,decl=2};nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.union_,name="Choice",type=16};nodes[5]=CK_Node.{kind=CK_Tag.type_named,name="Choice",head=6,loc=CK_Loc.{line=902,column=7}};nodes[6]=CK_Node.{kind=CK_Tag.type_named,name="int"};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],bytes=bytes[..],state=state[..]};ignored:=CK_resolve(c,5,CK_Access.view);#assert !state[0].fatal && state[0].error_count==1 && errors[0].code=="E0803" && errors[0].loc.line==902;
}
#forall "R2 focused borrow exhaustive return flow requires every actual switch arm" shape:0..<3 {
 nodes:[12]CK_Node;types:[16]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=11,type_count=16}];nodes[2]=CK_Node.{kind=CK_Tag.stmt_switch};if shape!=0 {nodes[2].head=3;nodes[3]=CK_Node.{kind=CK_Tag.switch_case,b=5,next=4};nodes[4]=CK_Node.{kind=CK_Tag.switch_case,b=7};nodes[5]=CK_Node.{kind=CK_Tag.stmt_block,head=6};nodes[6]=CK_Node.{kind=CK_Tag.stmt_return};nodes[7]=CK_Node.{kind=CK_Tag.stmt_block};if shape==2 {nodes[7].head=8;nodes[8]=CK_Node.{kind=CK_Tag.stmt_return};}}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};#assert CK_always_returns(c,2)==(shape==2) && !state[0].fatal && state[0].error_count==0 && state[0].depth==0;
}
#test "R2 focused borrow cloned sum syntax keeps its active tag and payload" {
 nodes:[32]CK_Node;types:[20]CK_Type;locals:[2]CK_Local;errors:[8]CK_Error;bytes:[1024]u8;state:=[1]CK_State.[CK_State.{used=12,type_count=17}];for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.union_,name="Choice",decl=2,size=16,alignment=8,sum_payload_offset=8,sum_default= -1};nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.union_,name="Choice",type=16,head=3,mark=2};nodes[3]=CK_Node.{kind=CK_Tag.variant,name="item",type=11};nodes[10]=CK_Node.{kind=CK_Tag.expr_sum,name="item",type=16,a=11,d=12,sum_variant=0};nodes[11]=CK_Node.{kind=CK_Tag.expr_int,type=11,value=7};nodes[12]=CK_Node.{kind=CK_Tag.type_named,name="Choice"};c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};copy:=CK_clone(c,10);#assert CK_value(c,copy,CK_Hint.{})==16 && !state[0].fatal && state[0].error_count==0 && nodes[copy].kind==CK_Tag.expr_sum && nodes[copy].sum_variant==0 && nodes[nodes[copy].a].value==7 && nodes[nodes[copy].a].type==11;
}
#forall "R2 focused borrow cloned null is retyped by each optional context" boolean:bool {
 nodes:[12]CK_Node;types:[19]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=3,type_count=19}];for i:0..<16 {types[i]=CK_builtin(i);}types[17]=CK_Type.{kind=CK_Kind.optional,elem=11,sum_default=0};types[18]=CK_Type.{kind=CK_Kind.optional,elem=2,sum_default=0};nodes[3]=CK_Node.{kind=CK_Tag.expr_null,type=17,sum_variant=0};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};copy:=CK_clone(c,3);want:=ifx boolean then 18 else 17;#assert CK_value(c,copy,CK_Hint.{type=want})==want && !state[0].fatal && state[0].error_count==0 && nodes[copy].kind==CK_Tag.expr_null && nodes[copy].sum_variant==0;
}
#test "R2 focused borrow conflicting union diagnostics name the actual declaration kind" {
 nodes:[8]CK_Node;types:[16]CK_Type;errors:[4]CK_Error;bytes:[512]u8;state:=[1]CK_State.[CK_State.{used=2,type_count=16}];nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.union_,name="int",loc=CK_Loc.{line=903,column=1}};c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],bytes=bytes[..],state=state[..]};CK_global_names(c);#assert !state[0].fatal && state[0].error_count==1 && errors[0].code=="E0372" && errors[0].loc.line==903 && errors[0].message=="union 'int' conflicts with another declaration or a built-in name";
}
#forall "R2 focused borrow checked constructors re-admit payloads in a new generic context" nominal:bool,generated:bool {
 nodes:[40]CK_Node;types:[24]CK_Type;locals:[2]CK_Local;errors:[8]CK_Error;bytes:[1024]u8;state:=[1]CK_State.[CK_State.{used=13,type_count=18,local_count=1,generic=3}];for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.optional,elem=11,size=16,alignment=8,sum_payload_offset=8,sum_default=0};types[17]=CK_Type.{kind=CK_Kind.param,name="$T",decl=3,elem=6};nodes[3]=CK_Node.{kind=CK_Tag.proc,name="instance"};nodes[8]=CK_Node.{kind=CK_Tag.param,name="x",type=6};locals[0]=CK_Local.{name="x",type=6,decl=8,immutable="parameter"};nodes[10]=CK_Node.{kind=CK_Tag.expr_sum,name="some",type=16,a=11,d=12,sum_variant=1};nodes[11]=CK_Node.{kind=CK_Tag.expr_ident,name="x",type=11,loc=CK_Loc.{line=904,column=9}};nodes[12]=CK_Node.{kind=CK_Tag.type_optional,b=13};nodes[13]=CK_Node.{kind=CK_Tag.type_param,name="T"};
 if nominal {types[16]=CK_Type.{kind=CK_Kind.union_,name="Choice",decl=2,size=16,alignment=8,sum_payload_offset=8,sum_default= -1};nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.union_,name="Choice",type=16,head=5,mark=2};nodes[5]=CK_Node.{kind=CK_Tag.variant,name="item",type=11};nodes[10].name="item";nodes[10].sum_variant=0;nodes[12]=CK_Node.{kind=CK_Tag.type_named,name="Choice"};}
 if generated {nodes[10].mark=1;}c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};expected:=0;if !nominal {expected=CK_sum_type(c,CK_Kind.optional,6,0,CK_Loc.{});}copy:=CK_clone(c,10);got:=CK_value(c,copy,CK_Hint.{});#assert !state[0].fatal;
 if nominal {#assert state[0].error_count==1 && errors[0].code=="E0901" && errors[0].loc.line==904;}
 else {#assert state[0].error_count==0 && got==expected && types[got].kind==CK_Kind.optional && types[got].elem==6 && nodes[nodes[copy].a].type==6;}
}
