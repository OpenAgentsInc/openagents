#import "Basic";

#test "case-local indices stay inside their scope" {
  #assert indexed_pick(Pick.{at=1}) == 40;
  #assert indexed_pick(Pick.{skip}) == 0;
}

Pick :: union { at:int; skip; }
indexed_pick :: (pick:Pick)->int {
  values := [2]int.[10,20];
  total := 0;
  for i:0..<2 {
    switch pick {
      case at(index) { total += values[index]; }
      case skip {}
    }
  }
  return total;
}
main :: () { print("%\n",indexed_pick(Pick.{at=1})); }
