// Focused checked-graph origin oracles. These helpers' failure sentinels are
// consumed by their callers before a fatal barrier; no failed private workspace
// or published-origin value is inspected after rejection.
#load "../lib/compiler/checker.coax";
#authority;

#forall "origin variant metadata admits exact payloads and rejects each broken component" mode:0..<11 {
 nodes:[12]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=11,type_count=20}];work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=811,column=7,offset=81107}}];
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.union_,decl=2};nodes[2]=CK_Node.{kind=CK_Tag.union_,head=3};nodes[3]=CK_Node.{kind=CK_Tag.variant,value=0,type=12,next=4};nodes[4]=CK_Node.{kind=CK_Tag.variant,value=1,type=3};
 ordinal:=0;expected:=12;valid:=mode<2 || mode>=8;
 if mode==1 {ordinal=1;expected=3;}if mode==2 {types[16].kind=CK_Kind.struct_;}if mode==3 {nodes[3].kind=CK_Tag.field;}if mode==4 {nodes[3].value=1;}if mode==5 {nodes[3].type=20;}if mode==6 {nodes[3].type=0;}if mode==7 {nodes[2].head=0;nodes[0]=CK_Node.{kind=CK_Tag.variant,type=12};}
 if mode==8 {types[16]=CK_Type.{kind=CK_Kind.result,elem=3,sum_error=12};expected=3;}
 if mode==9 {types[16]=CK_Type.{kind=CK_Kind.result,elem=3,sum_error=12};ordinal=1;expected=12;}
 if mode==10 {types[16]=CK_Type.{kind=CK_Kind.optional,elem=3};expected=1;}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};got:=CB_variant(b,16,ordinal);
 if valid {#assert got==expected && !state[0].fatal && state[0].error_count==0;}
 else {#assert got==0 && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==811 && errors[0].loc.column==7;}
}

#forall "origin leaf count follows payload cardinality including unit and overflow" mode:0..<9 {
 nodes:[12]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=11,type_count=20}];work:[1]CB_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=1,sum_error=3};types[17]=CK_Type.{kind=CK_Kind.array,elem=3,length=64};
 input:=16;expected:=1;
 if mode==1 {types[16].elem=17;expected=128;}if mode==2 {input=17;expected=64;}if mode==3 {types[17].length=65;input=17;expected=128;}if mode==4 {types[17].length=0;input=17;expected=0;}
 if mode==5 {input=20;}if mode==6 {types[16].elem=3;types[16].sum_error=20;}if mode==7 {types[16].kind=CK_Kind.string_;}if mode==8 {types[16].kind=CK_Kind.param;}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};got:=CB_leaf_count(b,input);
 if mode<5 {#assert got==expected && !state[0].fatal && state[0].error_count==0;}
 else {#assert got==0 && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381";}
}

#forall "origin discovery charges the sum payload's exact aggregate depth" mutable:bool,too_deep:bool {
 nodes:[8]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=7,type_count=19}];work:[1]CB_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.optional,elem=17};types[17]=CK_Type.{kind=CK_Kind.array,elem=ifx mutable then 18 else 3,length=1};types[18]=CK_Type.{kind=CK_Kind.view,elem=3};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};got:=CB_discover(b,16,ifx too_deep then 255 else 254,mutable);
 if too_deep {#assert !got && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381";}else {#assert got && !state[0].fatal && state[0].error_count==0;}
}
#forall "origin discovery never presents a rejected sum payload as a found descriptor" invalid_payload:bool {
 nodes:[8]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=7,type_count=18}];work:[1]CB_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.optional,elem=ifx invalid_payload then 18 else 17};types[17]=CK_Type.{kind=CK_Kind.array,elem=18,length=1};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};#assert !CB_discover(b,16,0,false) && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381";
}

#forall "origin unit payloads are empty only under their exact active variant path" mode:0..<4 {
 nodes:[12]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=11,type_count=17}];work:[1]CB_State;out:[64]BS_Origin;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.result,elem=1,sum_error=3};nodes[4]=CK_Node.{kind=CK_Tag.expr_sum,type=16,sum_variant=0,loc=CK_Loc.{line=821,column=9}};
 path:=BS_Path.{count=1};path.steps[0]=BS_Step.{kind=BS_VARIANT,index=0};
 if mode==1 {path.count=2;path.steps[1]=BS_Step.{kind=BS_FIELD,index=0};}if mode==2 {nodes[4].sum_variant= -1;}if mode==3 {types[16].elem=17;}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};got:=CB_expr(b,4,path,false,out[..]);
 if mode==0 {#assert got.count==0 && !got.incomplete && !state[0].fatal && state[0].error_count==0;}
 else {#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==821;}
}
#forall "origin try selects Result ok zero and optional some one from its static payload" optional:bool {
 nodes:[12]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=11,type_count=17}];work:[1]CB_State;out:[64]BS_Origin;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=ifx optional then CK_Kind.optional else CK_Kind.result,elem=3,sum_error=3};nodes[4]=CK_Node.{kind=CK_Tag.expr_try,type=3,a=5};nodes[5]=CK_Node.{kind=CK_Tag.expr_sum,type=16,sum_variant=ifx optional then 1 else 0,a=6};nodes[6]=CK_Node.{kind=CK_Tag.expr_string,type=3};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};got:=CB_expr(b,4,BS_Path.{},false,out[..]);
 #assert !state[0].fatal && state[0].error_count==0 && got.count==1 && !got.incomplete && out[0].kind==BS_STATIC && out[0].root==6 && out[0].type==12 && out[0].path.count==0;
}

#test "origin leaf count preserves the independently admitted 256-aggregate owned payload" {
 nodes:[8]CK_Node;types:[276]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=7,type_count=273}];work:[1]CB_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.optional,elem=17};
 for i:17..<273 {types[i]=CK_Type.{kind=CK_Kind.array,elem=ifx i==272 then 12 else i+1,length=1};}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};
 #assert CB_leaf_count(b,16)==0 && !state[0].fatal && state[0].error_count==0;
}

#forall "origin try carries exactly the selected caller parameter descriptor" optional:bool {
 nodes:[12]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=11,type_count=17}];work:[1]CB_State;queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;out:[64]BS_Origin;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=ifx optional then CK_Kind.optional else CK_Kind.result,elem=3,sum_error=3};
 nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=3,borrow_owner=2};nodes[4]=CK_Node.{kind=CK_Tag.expr_try,type=3,a=5};nodes[5]=CK_Node.{kind=CK_Tag.expr_sum,type=16,sum_variant=ifx optional then 1 else 0,a=6};nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=3,borrow_binding=3};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],queries=queries[..],origins=origins[..]};got:=CB_expr(b,4,BS_Path.{},false,out[..]);
 #assert !state[0].fatal && state[0].error_count==0 && got.count==1 && !got.incomplete && out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].role==BS_DESCRIPTOR && out[0].type==12 && out[0].path.count==0;
 #assert work[0].queries==1 && work[0].origins==1 && queries[0].status==2 && queries[0].count==1;
}

#forall "origin optional propagation cannot invent a borrow on either selected edge" selected:0..<2 {
 nodes:[16]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=17}];work:[1]CB_State;queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;out:[64]BS_Origin;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.optional,elem=3};
 // Equivalent checked return edges to: consume `try input`, then return none.
 // Both exits are none. Selecting some therefore has no backing origin.
 nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,head=3,b=4,borrow_returns=5};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};nodes[4]=CK_Node.{kind=CK_Tag.stmt_block,head=9};nodes[9]=CK_Node.{kind=CK_Tag.stmt_var,type=3,a=5,next=7,borrow_owner=2};
 nodes[5]=CK_Node.{kind=CK_Tag.expr_try,type=3,a=6,propagate_type=16,borrow_next=7,loc=CK_Loc.{line=831,column=9}};nodes[6]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};nodes[7]=CK_Node.{kind=CK_Tag.stmt_return,a=8};nodes[8]=CK_Node.{kind=CK_Tag.expr_null,type=16,sum_variant=0};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],queries=queries[..],origins=origins[..]};path:=BS_Path.{count=1};path.steps[0]=BS_Step.{kind=BS_VARIANT,index=selected};got:=CB_query(b,1,2,path,out[..]);
 #assert !state[0].fatal && state[0].error_count==0 && got.count==0 && !got.incomplete;
 #assert work[0].queries==1 && work[0].origins==0 && queries[0].kind==1 && queries[0].status==2 && queries[0].count==0;
}

#forall "origin write-only requests admit only indirect formal storage" mode:0..<3 {
 nodes:[12]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=11,type_count=17}];work:[1]CB_State;queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;out:[64]BS_Origin;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,head=3,b=4};nodes[3]=CK_Node.{kind=ifx mode==0 then CK_Tag.stmt_var else CK_Tag.param,type=16,borrow_owner=2,loc=CK_Loc.{line=841,column=7}};nodes[4]=CK_Node.{kind=CK_Tag.stmt_block};
 path:BS_Path;if mode!=1 {path.count=1;path.steps[0]=BS_Step.{kind=BS_DEREFERENCE};}c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],queries=queries[..],origins=origins[..]};got:=CB_query(b,5,3,path,out[..]);
 if mode==2 {#assert !state[0].fatal && state[0].error_count==0 && got.count==0 && !got.incomplete && work[0].queries==1 && work[0].origins==0 && queries[0].status==2;}
 else {#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==841 && errors[0].loc.column==7;}
}

#test "origin A1 owned-slot storage ignores every descriptor assignment into it" {
 nodes:[16]CK_Node;types:[16]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=16}];work:[1]CB_State;queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;out:[64]BS_Origin;
 for i:0..<16 {types[i]=CK_builtin(i);}nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,b=4};nodes[4]=CK_Node.{kind=CK_Tag.stmt_block,head=3};nodes[3]=CK_Node.{kind=CK_Tag.stmt_var,type=3,a=6,next=5,borrow_owner=2,borrow_writes=5};nodes[5]=CK_Node.{kind=CK_Tag.stmt_assign,a=7,c=8,borrow_owner=2};nodes[6]=CK_Node.{kind=CK_Tag.expr_string,type=3};nodes[7]=CK_Node.{kind=CK_Tag.expr_string,type=3};nodes[8]=CK_Node.{kind=CK_Tag.expr_ident,type=3,borrow_binding=3};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],queries=queries[..],origins=origins[..]};got:=CB_query(b,3,3,BS_Path.{},out[..]);
 #assert !state[0].fatal && state[0].error_count==0 && got.count==1 && !got.incomplete && out[0].kind==BS_LOCAL && out[0].root==3 && out[0].type==12 && out[0].path.count==0;
 #assert work[0].queries==1 && work[0].origins==1 && queries[0].kind==3 && queries[0].status==2 && queries[0].count==1;
}

#test "origin raw-to-class publication retains bounded two-field lookup admission" {
 nodes:[64]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=63,type_count=18}];work:[1]CB_State;queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;out:[64]BS_Origin;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.struct_,decl=10};types[17]=CK_Type.{kind=CK_Kind.struct_,decl=12};nodes[10]=CK_Node.{kind=CK_Tag.struct_,type=16,head=11};nodes[11]=CK_Node.{kind=CK_Tag.field,type=17};nodes[12]=CK_Node.{kind=CK_Tag.struct_,type=17,head=13};nodes[13]=CK_Node.{kind=CK_Tag.field,type=3};
 nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1,b=4};nodes[3]=CK_Node.{kind=CK_Tag.stmt_var,type=16,a=20,borrow_owner=2};nodes[4]=CK_Node.{kind=CK_Tag.stmt_block,head=3};nodes[20]=CK_Node.{kind=CK_Tag.expr_struct,type=16,head=21};nodes[21]=CK_Node.{kind=CK_Tag.field_init,field_index=0,a=22};nodes[22]=CK_Node.{kind=CK_Tag.expr_struct,type=17,head=23};nodes[23]=CK_Node.{kind=CK_Tag.field_init,field_index=0,a=24};nodes[24]=CK_Node.{kind=CK_Tag.expr_string,type=3};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],queries=queries[..],origins=origins[..],retain_fields=true};path:=BS_Path.{count=2};for i:0..<2 {path.steps[i]=BS_Step.{kind=BS_FIELD,index=0};}
 // Each layout also has a second admitted field block. Resolving its last
 // field after the raw query makes block zero a non-head row in both chains.
 nodes[11].next=25;nodes[13].next=33;for i:25..<33 {nodes[i]=CK_Node.{kind=CK_Tag.field,type=12,next=ifx i==32 then 0 else i+1};}for i:33..<41 {nodes[i]=CK_Node.{kind=CK_Tag.field,type=12,next=ifx i==40 then 0 else i+1};}
 raw:=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && state[0].error_count==0 && raw.count==1 && !raw.incomplete && out[0].kind==BS_STATIC && out[0].root==24;
 #assert CB_field(b,16,8)==32 && !state[0].fatal;#assert CB_field(b,17,8)==40 && !state[0].fatal;
 b.retain_classes=true;warm:=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && warm.count==1 && !warm.incomplete && out[0].kind==BS_STATIC && out[0].root==1;
 // A predeclared five work units per lookup leaves320 for64 calls. The
 // successful raw-to-class route must retain its already validated fields;
 // repeated cold scans of both two-row chains exceed that allowance.
 work[0].work=1048256;
 for i:0..<64 {got:=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && state[0].error_count==0 && got.count==1 && !got.incomplete && out[0].kind==BS_STATIC && out[0].root==1 && out[0].type==12;}
 #assert work[0].work<=1048576;
}
