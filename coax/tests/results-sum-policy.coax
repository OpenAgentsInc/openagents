 found:=CK_sum_scan(c,16,0,1048576);#assert found==(depth==256) && state[0].fatal==(depth==256) && state[0].error_count==(ifx depth==256 then 1 else 0);
 if depth==256 {#assert errors[0].code=="E0381";}
}
