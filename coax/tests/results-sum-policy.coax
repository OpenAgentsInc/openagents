 if mode==1 {nodes[3].kind=CK_Tag.expr_ident;nodes[3].type=0;nodes[3].name="missing";}
 #assert CK_null_comparison(c,2)==0 && !state[0].fatal && state[0].error_count==1 && errors[0].code==(ifx mode==1 then "E0306" else "E0910");
}
#forall "R2 sum audit switch rejects unknown cases and checks actual branch bodies" bad_body:bool {
 nodes:[16]CK_Node;types:[24]CK_Type;locals:[2]CK_Local;errors:[4]CK_Error;bytes:[1024]u8;state:=[1]CK_State.[CK_State.{used=12,type_count=17,current=2,local_count=1}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.union_,decl=3};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=1};nodes[3]=CK_Node.{kind=CK_Tag.union_,head=4,mark=2,type=16};nodes[4]=CK_Node.{kind=CK_Tag.variant,name="done",type=1};locals[0]=CK_Local.{name="arg",type=16,decl=5};nodes[5]=CK_Node.{kind=CK_Tag.param,type=16};nodes[6]=CK_Node.{kind=CK_Tag.stmt_switch,a=7,head=8};nodes[7]=CK_Node.{kind=CK_Tag.expr_ident,name="arg"};nodes[8]=CK_Node.{kind=CK_Tag.switch_case,name="missing",b=9};nodes[9]=CK_Node.{kind=CK_Tag.stmt_block,head=10};nodes[10]=CK_Node.{kind=CK_Tag.stmt_expr,a=11};nodes[11]=CK_Node.{kind=CK_Tag.expr_ident,name="absent"};
 if bad_body {nodes[8].name="done";}
 CK_switch(c,6);#assert !state[0].fatal && state[0].error_count==1 && state[0].local_count==1 && errors[0].code==(ifx bad_body then "E0306" else "E0904");
}
#forall "R2 sum audit direct Result syntax refuses arity and non-type arguments" mode:0..<4 {
 nodes:[12]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;bytes:[1024]u8;state:=[1]CK_State.[CK_State.{used=6,type_count=16}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 nodes[1]=CK_Node.{kind=CK_Tag.file};nodes[2]=CK_Node.{kind=CK_Tag.type_named,name="Result",head=3};nodes[3]=CK_Node.{kind=CK_Tag.type_named,name="int",next=4};nodes[4]=CK_Node.{kind=CK_Tag.type_named,name="u8"};
 if mode==0 {nodes[2].head=0;}if mode==1 {nodes[3].next=0;}if mode==2 {nodes[4].next=5;nodes[5]=CK_Node.{kind=CK_Tag.type_named,name="u8"};}if mode==3 {nodes[3].kind=CK_Tag.expr_int;}
 #assert CK_result_syntax(c,2)==0 && !state[0].fatal && state[0].error_count==1 && errors[0].code=="E0900";
}
#test "R2 sum audit sixty four unit alternatives retain every discriminator" {
 nodes:[72]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;bytes:[2048]u8;state:=[1]CK_State.[CK_State.{used=70,type_count=17}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.union_,name="Many",decl=2};nodes[2]=CK_Node.{kind=CK_Tag.union_,name="Many",type=16,head=3};
 for i:0..<64 {nodes[3+i]=CK_Node.{kind=CK_Tag.variant,name=CK_join2(c,"v",CK_count(c,i)),next=4+i};}nodes[66].next=0;
 CK_union_layout(c,2);#assert !state[0].fatal && state[0].error_count==0 && nodes[2].mark==2 && state[0].depth==0 && types[16].size==4 && types[16].alignment==4 && types[16].bits==32 && types[16].sum_payload_offset==0;
 for i:0..<64 {#assert nodes[3+i].type==1 && nodes[3+i].value==cast(u64)i;}
}
#test "R2 sum audit union payload may contain an optional but cannot contain Result" {
 nodes:[12]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;bytes:[1024]u8;state:=[1]CK_State.[CK_State.{used=6,type_count=17}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.union_,name="Reply",decl=2};nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.union_,name="Reply",type=16,head=3};nodes[3]=CK_Node.{kind=CK_Tag.variant,name="item",a=4};nodes[4]=CK_Node.{kind=CK_Tag.type_optional,b=5};nodes[5]=CK_Node.{kind=CK_Tag.type_named,name="int"};
 CK_union_layout(c,2);#assert !state[0].fatal && state[0].error_count==0 && nodes[2].mark==2 && nodes[3].type==17 && types[17].kind==CK_Kind.optional && types[16].size==24 && types[16].alignment==8 && types[16].sum_payload_offset==8;
}
#forall "R2 sum audit direct none construction requires its actual optional context" context:bool {
 nodes:[8]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;bytes:[512]u8;state:=[1]CK_State.[CK_State.{used=3,type_count=17}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.optional,elem=11};nodes[2]=CK_Node.{kind=CK_Tag.expr_null};hint:=CK_Hint.{};if context {hint.type=16;}
 t:=CK_sum_expression(c,2,hint);#assert !state[0].fatal && state[0].error_count==(ifx context then 0 else 1);
 if context {#assert t==16 && nodes[2].sum_variant==0;}else {#assert t==0 && errors[0].code=="E0910";}
}
