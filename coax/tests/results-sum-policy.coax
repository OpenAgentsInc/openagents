#forall "R2 sum audit exact direct sum metadata and invalid payload ordinals" mode:0..<4 {
 nodes:[8]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;bytes:[1024]u8;state:=[1]CK_State.[CK_State.{used=3,type_count=16}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 kind:=CK_Kind.optional;error:=0;if mode==1 {kind=CK_Kind.result;error=12;}
 t:=CK_sum_type(c,kind,11,error,CK_Loc.{});
 #assert t==16 && !state[0].fatal && state[0].error_count==0 && state[0].type_count==17;
 #assert types[t].bits==32 && types[t].elem==11 && types[t].sum_error==error && types[t].sum_payload_offset==8 && types[t].size==16 && types[t].alignment==8;
 #assert types[t].sum_default==(ifx mode==1 then -1 else 0);
 #assert CK_sum_type(c,kind,11,error,CK_Loc.{})==t && state[0].type_count==17;
 if mode==1 {#assert types[t].name=="Result(int, u8)" && CK_sum_payload(c,t,0)==11 && CK_sum_payload(c,t,1)==12;}
 else {#assert types[t].name=="int?" && CK_sum_payload(c,t,0)==1 && CK_sum_payload(c,t,1)==11;}
 #assert CK_sum_payload(c,t,-1)==0 && CK_sum_payload(c,t,2)==0 && CK_sum_payload(c,11,0)==0;
}
