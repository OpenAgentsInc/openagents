 if mode==0 {#assert !CK_sum_scan(c,16,3,1);}
 else {types[16].kind=CK_Kind.result;types[16].sum_error=12;types[16].sum_default= -1;if mode==2 {types[18].kind=CK_Kind.union_;nodes[2].kind=CK_Tag.union_;nodes[3].kind=CK_Tag.variant;nodes[4].kind=CK_Tag.variant;}#assert CK_sum_scan(c,18,0,1048576);}
