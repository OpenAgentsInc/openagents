// Focused R2 policy oracles. Kept outside the compiler's production graph.
#load "../lib/compiler/checker.coax";

#forall "R2 sum audit Result type syntax admits exactly six raw type node tags" tag:0..<9 {
 #assert CK_sum_type_tag(cast(u32)tag)==(tag>=1 && tag<=6);
}
#forall "R2 sum audit propagation admission checks context family and nominal error identity" mode:0..<7 {
 current:=2;kind:=CK_Kind.result;error:=12;out_kind:=CK_Kind.result;out_error:=12;
 if mode==0 {current=0;}if mode==1 {current=1;}if mode==3 {out_error=13;}
 if mode==4 {kind=CK_Kind.optional;out_kind=CK_Kind.optional;error=0;out_error=0;}
 if mode==5 {kind=CK_Kind.optional;}if mode==6 {out_kind=CK_Kind.optional;}
 #assert CK_sum_can_propagate(current,kind,error,out_kind,out_error)==(mode==1 || mode==2 || mode==4);
}

#forall "R2 sum audit a scan unit is charged only before its admitted endpoint" limit:-1..<3 {
 nodes:[8]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=1,type_count=16}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};budget:=[1]CK_SumBudget.[CK_SumBudget.{limit=limit}];
 if limit>0 {for i:0..<limit {#assert CK_sum_tick(c,budget[..]) && budget[0].used==i+1 && !state[0].fatal;}}
 #assert !CK_sum_tick(c,budget[..]) && budget[0].used==(ifx limit>0 then limit else 0) && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381";
}

#forall "R2 sum audit refuses preexisting failure without traversing" mode:0..<4 {
 nodes:[8]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=3,type_count=17}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};t:=16;
 if mode==0 {t=11;}if mode==1 {state[0].fatal=true;}if mode==2 {state[0].error_count=1;errors[0].code="original";}
 found:=CK_sum_scan(c,t,0,1048576);
 #assert found==(mode==3) && state[0].fatal==(mode==1) && state[0].error_count==(ifx mode==2 then 1 else 0);
 if mode==2 {#assert errors[0].code=="original";}
}
#forall "R2 sum audit views have no inline storage while defaults skip present optionals" mode:0..<3 {
 nodes:[16]CK_Node;types:[24]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=6,type_count=20}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.result,elem=11,sum_error=12};types[17]=CK_Type.{kind=CK_Kind.view,elem=16};
 types[18]=CK_Type.{kind=CK_Kind.optional,elem=11,sum_default=0};types[19]=CK_Type.{kind=CK_Kind.struct_,decl=2};
 nodes[2]=CK_Node.{kind=CK_Tag.struct_,head=3};nodes[3]=CK_Node.{kind=CK_Tag.field,type=18,next=4};nodes[4]=CK_Node.{kind=CK_Tag.field,type=11};
 if mode==0 {#assert !CK_inline_sum(c,17);}
 if mode==1 {#assert CK_defaultable(c,19);}
 if mode==2 {#assert CK_sum_scan(c,17,1,1048576);}
 #assert !state[0].fatal && state[0].error_count==0;
}
#forall "R2 sum audit self reference uses the initially visited root" budget:2..<5 {
 nodes:[8]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=3,type_count=17}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 types[16]=CK_Type.{kind=CK_Kind.struct_,decl=2};nodes[2]=CK_Node.{kind=CK_Tag.struct_,head=3};nodes[3]=CK_Node.{kind=CK_Tag.field,type=16};
 found:=CK_sum_scan(c,16,0,budget);
 // Enter the record, visit its field, probe the root, then leave: four units.
 #assert found==(budget<4) && state[0].fatal==(budget<4) && state[0].error_count==(ifx budget<4 then 1 else 0);
 if budget<4 {#assert errors[0].code=="E0381";}
}
#forall "R2 sum audit exhausted ancestor probes retain a conservative result" budget:33927..<33929 {
 nodes:[8]CK_Node;types:[274]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=6,type_count=274}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 for i:17..<272 {types[i]=CK_Type.{kind=CK_Kind.view,elem=i+1,size=16,alignment=8};}types[271].elem=11;
 types[16]=CK_Type.{kind=CK_Kind.struct_,decl=2};nodes[2]=CK_Node.{kind=CK_Tag.struct_,type=16,head=3};nodes[3]=CK_Node.{kind=CK_Tag.field,type=17,next=4};nodes[4]=CK_Node.{kind=CK_Tag.field,type=272};
 types[272]=CK_Type.{kind=CK_Kind.view,elem=273};types[273]=CK_Type.{kind=CK_Kind.struct_,decl=5};nodes[5]=CK_Node.{kind=CK_Tag.struct_,type=273,head=6};nodes[6]=CK_Node.{kind=CK_Tag.field,type=272};
 // The chain and 256-entry memo consume 33927 units before the two
 // uncached ancestor comparisons. Neither exhausted comparison is empty.
 #assert CK_sum_scan(c,16,0,budget) && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381";
}
#forall "R2 sum audit traversal stack admits 256 entries and refuses a 257th" depth:254..<257 {
