// R2 check-first regression: literal expectation predates implementation.
Error :: struct {domain:u32;code:int;operation:u32;}
make :: (ok:bool)->Result(int,Error) {
  if ok {return Result(int,Error).{ok=7};}
  return Result(int,Error).{err=Error.{domain=9,code=-41,operation=2}};
}

Other :: struct {domain:u32;code:int;operation:u32;}
bad :: ()->Result(int,Other) {
  // DIAGNOSTIC
  value:=try make(false);
  return Result(int,Other).{ok=value};
}
main :: () {}
