// R2 check-first regression: literal expectation predates implementation.
Error :: struct {domain:u32;code:int;operation:u32;}
make :: (ok:bool)->Result(int,Error) {
  if ok {return Result(int,Error).{ok=7};}
  return Result(int,Error).{err=Error.{domain=9,code=-41,operation=2}};
}

identity :: (r:$T)->$T {return r;}
consume :: (r:Result(int,Error))->int {return r or_else -1;}
branch :: (flag:bool)->int {
  pending:=make(flag);
  if flag {return consume(pending);}
  else {switch pending {case ok(v) {return v;}case err(e) {return e.code;}}}
}
#test "bindings and generic passthrough transfer one handling obligation" {
  original:=make(true);next:=original;
  #assert consume(identity(next))==7;
  #assert branch(true)==7 && branch(false)==-41;
}
// The native entry executes the same independent literal assertions.
main :: () {
  original:=make(true);next:=original;
  #assert consume(identity(next))==7;
  #assert branch(true)==7 && branch(false)==-41;
}
