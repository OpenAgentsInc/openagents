SPN_Record :: struct {lead:u8;point:Point3(SPN_World,u.Metre,f32);vector:Vector3(SPN_World,u.Metre,f64);points:[2]Point3(SPN_World,u.Metre,f64);tail:u16;}
SPN_record :: (r:SPN_Record)->SPN_Record #export_c {return r;}
SPN_mutate32 :: (points:[]Point3(SPN_World,u.Metre,f32))->Vector3(SPN_World,u.Metre,f32) {points[0].x=101;points[0].y=202;points[0].z=303;return SPN_vector32(2,3,4);}
SPN_alias32 :: (points:[]Point3(SPN_World,u.Metre,f32))->Point3(SPN_World,u.Metre,f32) #export_c {return points[0]+SPN_mutate32(points);}
SPN_mutate64 :: (points:[]Point3(SPN_World,u.Metre,f64))->Vector3(SPN_World,u.Metre,f64) {points[0].x=101;points[0].y=202;points[0].z=303;return SPN_vector64(2,3,4);}
SPN_alias64 :: (points:[]Point3(SPN_World,u.Metre,f64))->Point3(SPN_World,u.Metre,f64) #export_c {return points[0]+SPN_mutate64(points);}
