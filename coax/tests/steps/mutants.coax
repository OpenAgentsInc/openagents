// A check's own #steps bounds its mutants too: a mutant that needs more
// steps than the check's budget fails the check, even when the mutation
// runner would allow ten times the unmutated steps. The assertion can't
// tell twice the loop from once; only the budget can.
count :: (n: int) -> int {
  s := 0;
  for i: 0..<n * 1 { s += 1; }
  return s;
}

#test "counting stays inside its own budget" #steps 300 {
  #assert count(50) >= 0;
}
