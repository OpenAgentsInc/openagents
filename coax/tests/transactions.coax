// The room action contract: only in-memory writes participate in rollback.
#import "Basic";
TxRefusal :: enum u8 { target; ledger; }

tx_check_target :: (at: int, fail: int) -> Result(void, TxRefusal) #effects(computes) {
  if at == fail { return Result(void, TxRefusal).{err = TxRefusal.target}; }
  return Result(void, TxRefusal).{ok};
}
tx_area :: (hp: [] int, fail: int) -> Result(void, TxRefusal) #effects(reads, writes, traps) {
  #transaction {
    for i: 0..<hp.count { try tx_check_target(i, fail); hp[i] -= 3; }
  }
  return Result(void, TxRefusal).{ok};
}
tx_append :: (ledger: [] int) -> Result(void, TxRefusal) #effects(reads, writes, traps) {
  ledger[0] += 1;
  return Result(void, TxRefusal).{err = TxRefusal.ledger};
}
tx_pay :: (balance: [] int, ledger: [] int) -> Result(void, TxRefusal) #effects(reads, writes, traps) {
  #transaction { balance[0] -= 5; try tx_append(ledger); }
  return Result(void, TxRefusal).{ok};
}
tx_private_work :: (out: [] int) #effects(reads, writes, traps) {
  scratch := [3] int.[1, 2, 3];
  tx_increment(scratch[..]);
  #assert scratch[0] == 2 && scratch[2] == 4;
  out[0] = scratch[1];
}
tx_increment :: (out: [] int) #effects(reads, writes, traps) { for i: 0..<out.count { out[i] += 1; } }
tx_none :: (out: [] int) -> int? #effects(reads, writes, traps) {
  #transaction {
    defer { out[0] += 100; }
    tx_private_work(out);
    out[0] += 7;
    return null;
  }
}
tx_nested :: (out: [] int) -> Result(void, TxRefusal) #effects(reads, writes, traps) {
  #transaction {
    out[0] += 1;
    switch tx_area(out[1..<3], 1) { case ok {} case err(why) { #assert why == TxRefusal.target; } }
    out[2] += 2;
  }
  return Result(void, TxRefusal).{ok};
}
TxSpans :: struct { a: [] int; b: [] int; }
tx_aliases :: (spans: TxSpans) -> int? #effects(reads, writes, traps) {
  #transaction { spans.a[0] = 90; spans.b[0] = 91; return null; }
}
tx_outer_local :: (out: [] int) -> int? #effects(reads, writes, traps) {
  local := [2] int.[3, 4];
  scalar := 5;
  defer { out[0] = local[0] + local[1] + scalar; }
  #transaction { local[0] = 30; scalar = 50; return null; }
}
TxDataError :: struct { code:int; detail:[2]int; }
tx_error_data :: (out:[]int)->Result(void,TxDataError) #effects(reads,writes,traps) {
  error:=TxDataError.{code=1,detail=[2]int.[1,2]};
  defer {out[0]=error.detail[0];}
  #transaction {
    error.detail[0]=9;out[0]=50;
    return Result(void,TxDataError).{err=error};
  }
}

tx_exercise :: () -> int {
  hp := [4] int.[20, 21, 22, 23];
  switch tx_area(hp[..], 2) { case ok { #assert false; } case err(why) { #assert why == TxRefusal.target; } }
  for i: 0..<4 { #assert hp[i] == 20 + i; }
  balance := [1] int.[100]; ledger := [1] int.[7];
  switch tx_pay(balance[..], ledger[..]) { case ok { #assert false; } case err(why) { #assert why == TxRefusal.ledger; } }
  #assert balance[0] == 100 && ledger[0] == 7;
  switch tx_none(balance[..]) { case none {} case some(v) { #assert false; } }
  #assert balance[0] == 100;
  switch tx_area(hp[..], -1) { case ok {} case err(why) { #assert false; } }
  for i: 0..<4 { #assert hp[i] == 17 + i; }
  switch tx_nested(hp[..]) { case ok {} case err(why) { #assert false; } }
  #assert hp[0] == 18 && hp[1] == 18 && hp[2] == 21 && hp[3] == 20;
  switch tx_aliases(TxSpans.{a=hp[..], b=hp[1..<3]}) { case none {} case some(v) { #assert false; } }
  #assert hp[0] == 18 && hp[1] == 18 && hp[2] == 21;
  switch tx_outer_local(balance[..]) { case none {} case some(v) { #assert false; } }
  #assert balance[0] == 12;
  switch tx_error_data(balance[..]) {case ok {#assert false;} case err(error) {#assert error.code==1 && error.detail[0]==9 && error.detail[1]==2;}}
  #assert balance[0]==1;
  return 0;
}
#test "area failure on the third target, ledger failure, none, defers and nested scopes roll back" { #assert tx_exercise() == 0; }
main :: () { #assert tx_exercise() == 0; print("transactions: ok\n"); }
