// The hosted runner's goldens (Protocol C5, GitHub #13242): proto/coder/agent-managed-v1alpha1.json
// holds the lines and bodies the engines and the runner wrote before runner-wire.coax, byte for
// byte. For each one this check
//   - writes it through runner-wire.coax from its values, and requires the same bytes;
//   - holds every key, nested ones too, to a json_name of its message in
//     proto/descriptors/agent-managed.pb (t is the line's kind, the message's json constant
//     when it has one);
//   - for a line marked "mapper", reads it through the JSON mapper and writes it back byte for byte.
// It holds the next answers' keys to NextTurn the same way, and seals the fixture's credential
// with AES-256-GCM (coax/lib/crypto/aes_gcm.coax, an implementation apart from the runner's
// OpenSSL) under rw_aad's associated data, for the same base64 the runner's seal wrote.
//
//   coax/web/tool.sh coax/web/agent/runner-wire-goldens.coax [proto/coder/agent-managed-v1alpha1.json]
//   coax/bin/coax test coax/web/agent/runner-wire-goldens.coax
#import "Basic";
#import_proto "../../../proto/descriptors/agent-managed.pb" as AM;
#load "runner-wire.coax";
#load "../../lib/json/json.coax";
#load "../../lib/proto/json.coax";
#load "../../lib/proto/importer.coax";
#load "../../lib/crypto/aes_gcm.coax";
#load "../../lib/text/base64.coax";
#load "../../lib/sys/tool.coax";
#load "../../lib/sys/args.coax";
#load "../../lib/sys/fs.coax";

RG_FIXTURE :: "proto/coder/agent-managed-v1alpha1.json";
RG_DESCRIPTOR :: "proto/descriptors/agent-managed.pb";
RG_PACKAGE :: ".openagents.agent.managed.v1alpha1.";
RG_LINE :: 16384;
RG_JSON :: 10;   // openagents.options.v1alpha1.json, as the importer numbers message options
// Each writer, the message its output is, and the line's kind (t), "" for a body.
RG_WRITERS :: [15] string.["event", "tool", "call", "repo", "done", "project_turn", "chat_turn", "reply", "stop", "batch", "working_batch", "project_end", "chat_end", "files", "next"];
RG_MESSAGES :: [15] string.["EventLine", "EventLine", "CallLine", "RepoLine", "DoneLine", "ProjectTurnLine", "ChatTurnLine", "ReplyLine", "StopLine", "EventBatch", "EventBatch", "TurnEnd", "TurnEnd", "", "NextTurn"];
RG_KINDS :: [15] string.["event", "event", "call", "repo", "done", "turn", "turn", "reply", "stop", "", "", "", "", "", ""];

RgDescriptor :: struct {
  types: [256] D_Type; enums: [64] D_Type; fields: [2048] D_Field; values: [1024] D_Value; groups: [4096] string;
  files: [64] string; deps: [256] string; arena: [4194304] u8; output: [1] u8; symbols: [8192] string;
  state: [1] D_State;
}
rg_descriptor_load :: (g: [] RgDescriptor, raw: string) -> string {
  g[0].state[0] = D_State.{types = g[0].types[..], enums = g[0].enums[..], fields = g[0].fields[..], values = g[0].values[..], groups = g[0].groups[..],
    files = g[0].files[..], deps = g[0].deps[..], arena = g[0].arena[..], output = g[0].output[..], symbols = g[0].symbols[..]};
  D_parse(g[0].state[..], raw, "RG");
  return g[0].state[0].error;
}
rg_type :: (st: [] D_State, full: string) -> int {
  for i: 0..<st[0].nt { if st[0].types[i].full == full { return i; } }
  return -1;
}
rg_named :: (st: [] D_State, name: string) -> int {
  b: [128] u8; n := 0;
  for c: RG_PACKAGE { b[n] = c; n += 1; }
  for c: name { if n < b.count { b[n] = c; n += 1; } }
  return rg_type(st, cast(string) b[0..<n]);
}
// Whether the object at `at` keeps message m's keys, recursing into message fields: "" when it
// does, else what is wrong. kind: the line's t, "" for none.
rg_keys :: (st: [] D_State, m: int, d: Jv, at: int, kind: string, depth: int) -> string {
  if depth > 8 { return "too deep"; }
  t := st[0].types[m];
  for i: 0..<jv_len(d, at) {
    v := jv_at(d, at, i); k := jv_key(d, v);
    if k == "t" && depth == 0 && kind != "" {
      if jv_kind(d, v) != JV_STRING || !jv_raw_eq(jv_raw(d, v), kind) { return "t is not the line's kind"; }
      if D_has_option(t.opts, RG_JSON) {
        want: [64] u8; n := 0;
        for c: "t=" { want[n] = c; n += 1; }
        for c: kind { want[n] = c; n += 1; }
        if t.opts.text[RG_JSON] != cast(string) want[0..<n] { return "the json option's constant is not the line's kind"; }
      }
      continue;
    }
    f := -1;
    for j: t.first..<t.first + t.count { if st[0].fields[j].json == k { f = j; } }
    if f < 0 { return "a key is no json_name of the message"; }
    sub := rg_type(st, st[0].fields[f].type_name);
    if sub >= 0 && jv_kind(d, v) == JV_OBJECT {
      why := rg_keys(st, sub, d, v, "", depth + 1); if why != "" { return why; }
    } else if sub >= 0 && jv_kind(d, v) == JV_ARRAY {
      for e: 0..<jv_len(d, v) {
        el := jv_at(d, v, e);
        if jv_kind(d, el) != JV_OBJECT { return "a list of messages holds something else"; }
        why := rg_keys(st, sub, d, el, "", depth + 1); if why != "" { return why; }
      }
    }
  }
  return "";
}
rg_line_keys :: (st: [] D_State, message: string, kind: string, line: string) -> string {
  m := rg_named(st, message);
  if m < 0 { return "the descriptor has no such message"; }
  nodes: [1024] JvNode; d: [1] Jv;
  if !jv_parse(d[..], line, nodes[..]) || jv_kind(d[0], 0) != JV_OBJECT { return "not a JSON object"; }
  return rg_keys(st, m, d[0], 0, kind, 0);
}

// Whether the JSON mapper reads line as message and writes it back byte for byte. Run only by
// the tool: the mapper's alias check does not run at compile time, where #test runs.
rg_mapper :: (message: string, line: string) -> bool {
  nodes: [2048] JvNode; wire: [RG_LINE] u8; out: [RG_LINE] u8;
  if message == "EventLine" {
    m := AM_EventLine_from_json(line, nodes[..], wire[..]); if m.error != 0 { return false; }
    v := AM_EventLine_to_json(m, out[..]); return v.error == 0 && cast(string) v.wire == line;
  }
  if message == "StopLine" {
    m := AM_StopLine_from_json(line, nodes[..], wire[..]); if m.error != 0 { return false; }
    v := AM_StopLine_to_json(m, out[..]); return v.error == 0 && cast(string) v.wire == line;
  }
  if message == "EventBatch" {
    m := AM_EventBatch_from_json(line, nodes[..], wire[..]); if m.error != 0 { return false; }
    v := AM_EventBatch_to_json(m, out[..]); return v.error == 0 && cast(string) v.wire == line;
  }
  return false;
}

// A golden's values, read with the engines' own field readers.
RgValues :: struct { raw: string; ar: [1] ClArena; buf: [65536] u8; }
rg_s :: (v: [] RgValues, key: string) -> string { return cl_str(v[0].ar[..], v[0].raw, key); }
rg_i :: (v: [] RgValues, key: string) -> int { return cl_int(v[0].raw, key).value; }
rg_f :: (v: [] RgValues, key: string) -> f64 { return cl_num(v[0].raw, key).value; }
rg_b :: (v: [] RgValues, key: string) -> bool { return cl_bool(v[0].raw, key).value; }

// Writes a golden from its values; the length, or -1.
rg_write :: (writer: string, values: string, out: [] u8) -> int {
  v: [1] RgValues; v[0].raw = values; v[0].ar[0].buf = v[0].buf[..];
  o: [1] ClOut; o[0].buf = out;
  if writer == "event" { rw_event(o[..], rg_s(v[..], "type"), rg_s(v[..], "key"), rg_s(v[..], "value")); }
  else if writer == "tool" { rw_tool(o[..], rg_s(v[..], "name"), rg_s(v[..], "detail")); }
  else if writer == "call" { rw_call(o[..], rg_i(v[..], "id"), rg_s(v[..], "tool"), rg_s(v[..], "args")); }
  else if writer == "repo" { rw_repo(o[..], rg_i(v[..], "id"), rg_s(v[..], "body")); }
  else if writer == "done" {
    rw_done(o[..], ifx rg_s(v[..], "layout") == "chat" then RW_DONE_CHAT else RW_DONE_PROJECT, rg_s(v[..], "status"), rg_s(v[..], "answer"),
            rg_s(v[..], "error"), rg_f(v[..], "cost_usd"), rg_b(v[..], "credential_expired"));
  } else if writer == "project_turn" {
    return rw_project_turn_write(rg_s(v[..], "slug"), rg_s(v[..], "turn"), rg_s(v[..], "history"), rg_s(v[..], "version"), rg_s(v[..], "model"),
                                 rg_f(v[..], "budget_usd"), rg_b(v[..], "repo"), rg_s(v[..], "cwd"), rg_s(v[..], "today"), out);
  } else if writer == "chat_turn" {
    return rw_chat_turn_write(rg_s(v[..], "turn"), rg_s(v[..], "model"), rg_f(v[..], "budget_usd"), rg_b(v[..], "resumed"), rg_s(v[..], "session"),
                              rg_s(v[..], "history"), rg_s(v[..], "cwd"), rg_s(v[..], "mirror"), rg_b(v[..], "service"), rg_s(v[..], "today"), out);
  } else if writer == "reply" { return rw_reply_write(rg_s(v[..], "id"), rg_i(v[..], "status"), rg_s(v[..], "body"), out); }
  else if writer == "stop" { return rw_stop_write(out); }
  else if writer == "batch" {
    items: [RG_LINE] u8; at := 0;
    evs := cl_raw(values, "events");
    for i: 0..<cl_count(evs) {
      e := cl_json(evs, cl_item(evs, i));
      ev: [1] RgValues; ev[0].raw = e; ev[0].ar[0].buf = ev[0].buf[..];
      at = rw_batch_item_write(rg_s(ev[..], "type"), rg_s(ev[..], "data"), at, items[..]);
      if at < 0 { return -1; }
    }
    return rw_batch_write(rg_i(v[..], "turn"), cast(string) items[0..<at], out);
  } else if writer == "working_batch" { return rw_working_batch_write(rg_i(v[..], "turn"), rg_s(v[..], "text"), out); }
  else if writer == "project_end" {
    return rw_project_end_write(rg_i(v[..], "turn"), rg_s(v[..], "status"), rg_s(v[..], "answer"), rg_s(v[..], "error"), rg_f(v[..], "cost_usd"),
                                rg_s(v[..], "commit"), rg_s(v[..], "commit_message"), rg_s(v[..], "files"), rg_b(v[..], "credential_expired"), out);
  } else if writer == "chat_end" {
    return rw_chat_end_write(rg_i(v[..], "turn"), rg_s(v[..], "status"), rg_s(v[..], "answer"), rg_s(v[..], "error"), rg_f(v[..], "cost_usd"),
                             rg_b(v[..], "resumed"), rg_b(v[..], "credential_expired"), out);
  } else if writer == "files" { return rw_files_write(rg_s(v[..], "names"), out); }
  else { return -1; }
  return rw_len(o[..]);
}

rg_hex :: (text: string, out: [] u8) -> bool {
  if text.count != out.count * 2 { return false; }
  for i: 0..<out.count {
    a := jv_hex(text[2 * i]); b := jv_hex(text[2 * i + 1]);
    if a < 0 || b < 0 { return false; }
    out[i] = cast(u8) (a * 16 + b);
  }
  return true;
}
// The credential sealed with key and nonce for owner and kind, as base64 of nonce | ciphertext |
// tag, into out; its length, or -1.
rg_seal :: (key_hex: string, nonce_hex: string, owner: string, kind: string, plain: string, out: [] u8) -> int {
  key: [32] u8; raw: [12 + 512 + 16] u8;
  if !rg_hex(key_hex, key[..]) || !rg_hex(nonce_hex, raw[0..<12]) || plain.count > 512 { return -1; }
  ab: [512] u8; a := rw_aad_write(owner, kind, ab[..]);
  if a < 0 { return -1; }
  pb: [512] u8; for i: 0..<plain.count { pb[i] = plain[i]; }
  n := aes256_gcm_seal(key[..], raw[0..<12], ab[0..<a], pb[0..<plain.count], raw[12..<raw.count]);
  if n < 0 { return -1; }
  return b64_encode(cast(string) raw[0..<12 + n], out);
}

RgText :: struct { b: [1024] u8; }

rg_check :: (text: string, st: [] D_State, quiet: bool) -> int {
  nodes: [8192] JvNode; j: [1] Jv;
  if !jv_parse(j[..], text, nodes[..]) || jv_kind(j[0], 0) != JV_OBJECT { if !quiet { print("FAIL  cannot parse the fixture\n"); } return 1; }
  d := j[0];
  goldens := jv_get(d, 0, "goldens");
  if jv_kind(d, goldens) != JV_ARRAY || jv_len(d, goldens) == 0 { if !quiet { print("FAIL  no goldens\n"); } return 1; }
  writers := RG_WRITERS; messages := RG_MESSAGES; kinds := RG_KINDS;
  seen: [14] bool;
  bad := 0;
  for i: 0..<jv_len(d, goldens) {
    item := jv_at(d, goldens, i);
    nb: [256] u8; wb: [64] u8; mb: [64] u8; lb: [RG_LINE] u8;
    name := cast(string) nb[0..<jv_str(d, jv_get(d, item, "name"), nb[..])];
    writer := cast(string) wb[0..<jv_str(d, jv_get(d, item, "writer"), wb[..])];
    message := cast(string) mb[0..<jv_str(d, jv_get(d, item, "message"), mb[..])];
    ln := jv_str(d, jv_get(d, item, "line"), lb[..]);
    want := ifx ln < 0 then "" else cast(string) lb[0..<ln];
    w := -1;
    for k: 0..<14 { if writers[k] == writer { w = k; } }
    if w < 0 || messages[w] != message { if !quiet { print("FAIL  % : writer % does not write %\n", name, writer, message); } bad += 1; continue; }
    seen[w] = true;
    out: [RG_LINE] u8;
    n := rg_write(writer, jv_raw(d, jv_get(d, item, "values")), out[..]);
    got := ifx n < 0 then "" else cast(string) out[0..<n];
    keys := ifx st.count > 0 && message != "" then rg_line_keys(st, message, kinds[w], want) else "";
    mapper := jv_bool(d, jv_get(d, item, "mapper"));
    if n < 0 || got != want { if !quiet { print("FAIL  % (%):\n  want: %\n  got:  %\n", name, message, want, got); } bad += 1; }
    else if keys != "" { if !quiet { print("FAIL  % (%): %\n", name, message, keys); } bad += 1; }
    else if st.count > 0 && mapper && !rg_mapper(message, want) { if !quiet { print("FAIL  % (%): the JSON mapper does not write it back byte for byte\n", name, message); } bad += 1; }
    else if !quiet { print("ok    % (%)\n", name, message); }
  }
  for k: 0..<13 { if !seen[k] { if !quiet { print("FAIL  writer % has no golden\n", writers[k]); } bad += 1; } }
  // the next answers: their keys are NextTurn's
  nexts := jv_get(d, 0, "next");
  for i: 0..<jv_len(d, nexts) {
    item := jv_at(d, nexts, i);
    bb: [RG_LINE] u8; bn := jv_str(d, jv_get(d, item, "body"), bb[..]);
    why := ifx bn < 0 then "no body" else ifx st.count > 0 then rg_line_keys(st, "NextTurn", "", cast(string) bb[0..<bn]) else "";
    if why != "" { if !quiet { print("FAIL  next %: %\n", i, why); } bad += 1; } else if !quiet { print("ok    next % (NextTurn)\n", i); }
  }
  // the sealed credential
  s := jv_get(d, 0, "sealed");
  sb: [6] RgText; sv: [6] string;
  sk := [6] string.["key", "nonce", "owner", "kind", "plain", "sealed"];
  for k: 0..<6 { m := jv_str(d, jv_get(d, s, sk[k]), sb[k].b[..]); sv[k] = ifx m < 0 then "" else cast(string) sb[k].b[0..<m]; }
  ab: [512] u8; an := jv_str(d, jv_get(d, s, "aad"), ab[..]);
  aw: [512] u8; awn := rw_aad_write(sv[2], sv[3], aw[..]);
  sealed: [1024] u8; m := rg_seal(sv[0], sv[1], sv[2], sv[3], sv[4], sealed[..]);
  if an < 0 || awn != an || cast(string) aw[0..<awn] != cast(string) ab[0..<an] { if !quiet { print("FAIL  sealed: the associated data is not rw_aad's\n"); } bad += 1; }
  else if m < 0 || cast(string) sealed[0..<m] != sv[5] { if !quiet { print("FAIL  sealed: AES-256-GCM does not give the runner's bytes\n"); } bad += 1; }
  else if !quiet { print("ok    sealed (SealedCredential)\n"); }
  if !quiet { print("%\n", ifx bad == 0 then "runner goldens hold" else "runner goldens fail"); }
  return ifx bad == 0 then 0 else 1;
}

#test "the sealed credential: a fixed key, nonce, owner and kind give fixed bytes" #steps 400000000 {
  out: [256] u8;
  n := rg_seal("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "a0a1a2a3a4a5a6a7a8a9aaab", "npub-test-owner", "api",
               "sk-ant-api03-TEST-not-a-real-key", out[..]);
  #assert n > 0 && cast(string) out[0..<n] == "oKGio6SlpqeoqaqrlXNRTCu/L94SDLfgKi6FjSSBN3/mmiNB7mtH6lLAEHgZS1Y1QmxHrdBTayoMXrd/";
  ab: [128] u8; a := rw_aad_write("npub-test-owner", "api", ab[..]);
  #assert cast(string) ab[0..<a] == "oa-chat-credential.v1|npub-test-owner|api";
  // another kind is other associated data, so other bytes
  #assert rg_seal("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "a0a1a2a3a4a5a6a7a8a9aaab", "npub-test-owner", "oauth",
                  "sk-ant-api03-TEST-not-a-real-key", out[..]) == n && cast(string) out[0..<n] != "oKGio6SlpqeoqaqrlXNRTCu/L94SDLfgKi6FjSSBN3/mmiNB7mtH6lLAEHgZS1Y1QmxHrdBTayoMXrd/";
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  loaded := args_load(args[..]);
  path := ifx loaded && args_count(args[..]) >= 1 then args_at(args[..], 0) else RG_FIXTURE;
  buf: [262144] u8;
  n := fs_read(path, buf[..]);
  if n <= 0 { tool_errln("runner-wire-goldens: cannot read the fixture"); return 2; }
  pb: [65536] u8;
  pn := fs_read(RG_DESCRIPTOR, pb[..]);
  if pn <= 0 { tool_errln("runner-wire-goldens: cannot read the descriptor"); return 2; }
  g: [1] RgDescriptor;
  err := rg_descriptor_load(g[..], cast(string) pb[0..<pn]);
  if err != "" { print("FAIL  descriptor: %\n", err); return 1; }
  st := g[0].state[..];
  // the key check bites: a key the message lacks, a nested one, and a wrong t
  if rg_line_keys(st, "EventLine", "event", "{\"t\":\"event\",\"tpye\":\"working\"}") == "" ||
     rg_line_keys(st, "EventLine", "event", "{\"t\":\"event\",\"type\":\"working\",\"data\":{\"txt\":\"x\"}}") == "" ||
     rg_line_keys(st, "StopLine", "stop", "{\"t\":\"stpo\"}") == "" ||
     rg_line_keys(st, "EventBatch", "", "{\"turn\":1,\"events\":[{\"type\":\"x\",\"data\":{\"lenght\":1}}]}") == "" {
    print("FAIL  the key check takes a line it should refuse\n"); return 1;
  }
  return rg_check(cast(string) buf[0..<n], st, false);
}
