ai_capture :: (c:[]Cdp)->bool {return fc_eval(c,"imported model GPU pixels","(async()=>{coaxial.renderCapture=null;coaxial.captureFrame();await coaxialClipStep(1,60);for(let i=0;i<100&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));const r=coaxial.renderCapture;if(!r?.bytes)return false;const hash=await crypto.subtle.digest('SHA-256',new Uint8Array(r.bytes));faceHashes.push(Array.from(new Uint8Array(hash),v=>v.toString(16).padStart(2,'0')).join(''));return true})()");}
