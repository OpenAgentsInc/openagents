// Actual station frames, source face clips, timing and GPU replacement.
// Captures and raw reports go to the caller's private directory.
#load "valley-capture.coax";
#load "anim-frame-report.coax";
#load "../lib/text/ph_num.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=5 {print("usage: anim-lab-check URL PRIVATE_DIR desktop|phone --record|--compare RECEIPT\n");return 2;}phone:=args_at(a[..],2)=="phone";missing:=args_at(a[..],2)=="missing";c:[1]Cdp;if !cdp_launch_background(c[..],1280,800,"animation-lab-check-") {return 1;}defer {cdp_close(c[..]);}
 _:=cdp_call(c[..],"Page.enable","",30000);metrics:=ifx phone then "{\"width\":390,\"height\":844,\"deviceScaleFactor\":1,\"mobile\":true}" else "{\"width\":1280,\"height\":800,\"deviceScaleFactor\":1,\"mobile\":false}";_=cdp_call(c[..],"Emulation.setDeviceMetricsOverride",metrics,30000);
 setup:="globalThis.coaxialClip=true;globalThis.coaxialRenderCapture=true;globalThis.coaxialRenderCaptureFormat='rgba8unorm';globalThis.faceErrors=[];globalThis.faceHashes=[];globalThis.alTimes=[];globalThis.alExpectLoss=false;globalThis.alLosses=0;const ce=console.error;console.error=(...a)=>{const m=a.map(String).join(' ');if(alExpectLoss&&m.startsWith('coaxial: GPU device lost (destroyed:'))alLosses++;else faceErrors.push(m);ce(...a)};globalThis.alEngine='';const observedFetch=fetch;globalThis.fetch=async(...a)=>{const r=await observedFetch(...a);if(new URL(typeof a[0]==='string'?a[0]:a[0].url,location.href).pathname.endsWith('/animationlab.wasm'))alEngine=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',await r.clone().arrayBuffer())),v=>v.toString(16).padStart(2,'0')).join('');return r};if(location.search==='?animlab-test-missing=1'){const af=fetch;globalThis.fetch=(...a)=>new URL(typeof a[0]==='string'?a[0]:a[0].url,location.href).pathname==='/private/animation-lab.bundle'?Promise.resolve(new Response('',{status:404})):af(...a)}";b:[4096]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"source");jo_str(o[..],setup);jo_end(o[..]);_=cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument",jo_text(o[..]),30000);jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],args_at(a[..],0));jo_end(o[..]);_=cdp_call(c[..],"Page.navigate",jo_text(o[..]),30000);
 ready_js:=ifx missing then "(async()=>!!globalThis.coaxial?.ready&&(await coaxialClipStep(1,60))===1&&coaxial.sceneReady)()" else "(async()=>!!globalThis.coaxial?.ready&&(await coaxialClipStep(1,60))===1&&coaxial.sceneReady&&coaxial.guardProbe(9)===1)()";ready:=false;until:=proc_now_ms()+120000;while proc_now_ms()<until {n:=cdp_evaluate(c[..],ready_js);if n>=0 && jv_raw(c[0].doc[0],n)=="true" {ready=true;break;}proc_sleep(100);}if !ready {print("FAIL station readiness\n");return 1;}
 if missing {if !fc_eval(c[..],"missing private bundle remains usable","(async()=>{location.hash='rig?rig=echo';await new Promise(r=>setTimeout(r,100));await coaxialClipStep(2,60);return coaxial.guardProbe(8)===8&&coaxial.guardProbe(9)===0&&coaxial.sceneReady&&faceErrors.length===0})()") || !al_capture(c[..]) || !fc_shot(c[..],args_at(a[..],1),"missing-private.png") {return 1;}print("PASS missing private animation-lab.bundle is named; builtin stage remains ready\n");return 0;}
 for test,k:[4]string.["rig?rig=mannequin","clip?rig=mannequin","rig?rig=echo","clip?rig=echo"] {
  js:[512]u8;j:[1]Jo;jo_start(j[..],js[..]);jo_obj(j[..]);jo_key(j[..],"hash");jo_str(j[..],test);jo_end(j[..]);expr:[1024]u8;p:[1]PnOut;p[0].buf=expr[..];pn_put(p[..],"(async()=>{location.hash=");pn_put(p[..],jo_text(j[..]));pn_put(p[..],".hash;await new Promise(r=>setTimeout(r,30));coaxial.send(700,'18');await coaxialClipStep(2,60);return coaxial.guardProbe(8)===0})()");if !fc_eval(c[..],"station selection",pn_text(p[..])) {return 1;}
  if !al_capture(c[..]) {return 1;}names:=[4]string.["mannequin-rig.png","mannequin-clip.png","echo-rig.png","echo-clip.png"];if !fc_shot(c[..],args_at(a[..],1),names[k]) {return 1;}
 }
 // All twenty source face clips use the same admitted document playback.
 for k:0..<24 {if !fc_key(c[..],"]") {return 1;}}
 if !fc_eval(c[..],"twenty Slay face clips", "(async()=>{for(let i=0;i<20;i++){if(coaxial.guardProbe(2)!==24+i)return false;coaxial.send(700,'12');await coaxialClipStep(1,60);dispatchEvent(new KeyboardEvent('keydown',{key:']'}));}return coaxial.guardProbe(4)===44})()") {return 1;}
 // Select the first face clip again for a plotted, held source frame.
 for k:0..<24 {if !fc_key(c[..],"]") {return 1;}}
 if !fc_eval(c[..],"held facial frame","(async()=>{coaxial.send(700,'12');await coaxialClipStep(2,60);return coaxial.guardProbe(2)===24&&coaxial.guardProbe(3)===12})()") || !al_capture(c[..]) || !fc_shot(c[..],args_at(a[..],1),"face-clip.png") {return 1;}
 if !fc_eval(c[..],"GPU device loss","(()=>{alExpectLoss=true;return coaxial.loseDevice()})()") {return 1;}recovered:=false;until=proc_now_ms()+20000;while proc_now_ms()<until {n:=cdp_evaluate(c[..],"(async()=>{await coaxialClipStep(1,60);return coaxial.gpuRecovery?.state==='recovered'&&coaxial.guardProbe(1)===1&&coaxial.guardProbe(2)===24&&coaxial.guardProbe(3)===12})()");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {recovered=true;break;}proc_sleep(100);}if !recovered || !al_capture(c[..]) {print("FAIL selected frame GPU recovery\n");return 1;}
 if !fc_eval(c[..],"recovered pixels and measured frames","(async()=>{alExpectLoss=false;if(faceHashes[4]!==faceHashes[5]||alLosses!==1)return false;for(let i=0;i<60;i++){const t=performance.now();await coaxialClipStep(1,60);alTimes.push(performance.now()-t);}alTimes.sort((a,b)=>a-b);return faceErrors.length===0&&alTimes[56]<33.3})()") {return 1;}
 if !phone && args_at(a[..],3)=="--record" && !fc_eval(c[..],"atomic bundle replacement","(async()=>{try{const bytes=await(await fetch('/build/animationlab.wasm')).arrayBuffer();const module=await WebAssembly.compile(bytes);const memory=new WebAssembly.Memory({initial:4096,maximum:4096});const imports={env:{memory}};for(const i of WebAssembly.Module.imports(module))if(i.kind==='function')(imports[i.module]??={})[i.name]=()=>0;const instance=await WebAssembly.instantiate(module,imports),x=instance.exports;x._initialize?.();const p=Number(x.__heap_base.value);x.coaxial_state_init(p);const payload=new Uint8Array(await(await fetch('/private/animation-lab.bundle')).arrayBuffer());const accepted=x.coaxial_asset(p,0,payload.length);new Uint8Array(memory.buffer,accepted,payload.length).set(payload);x.coaxial_asset_ready(p,0,payload.length);const hash=new TextEncoder().encode('clip?rig=echo');new Uint8Array(memory.buffer,x.coaxial_inbox(p),hash.length).set(hash);x.coaxial_hash(p,hash.length);if(x.coaxial_guard_probe(p,1)!==1||x.coaxial_guard_probe(p,9)!==1)return false;const pending=x.coaxial_asset(p,0,3);if(pending===accepted)return false;new Uint8Array(memory.buffer,pending,3).set([66,65,68]);x.coaxial_asset_ready(p,0,3);if(x.coaxial_guard_probe(p,9)!==1||x.coaxial_guard_probe(p,8)!==6||x.coaxial_asset(p,0,3)!==pending)return false;const old=await crypto.subtle.digest('SHA-256',new Uint8Array(memory.buffer,accepted,payload.length));const source=await crypto.subtle.digest('SHA-256',payload);alBankVerified=new Uint8Array(old).every((v,i)=>v===new Uint8Array(source)[i]);alEngine=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes)),v=>v.toString(16).padStart(2,'0')).join('');return alBankVerified}catch(e){console.error('bundle replacement test',e.message);return false}})()") {return 1;}
 n:=cdp_evaluate(c[..],"JSON.stringify({engine:globalThis.alEngine||'animationlab',bundle_replacement:!!globalThis.alBankVerified,viewport:[innerWidth,innerHeight],hashes:faceHashes,median_ms:alTimes[30],p95_ms:alTimes[56],recovery:coaxial.gpuRecovery,errors:faceErrors})");if n<0 {return 1;}receipt:[4096]u8;size:=jv_str(c[0].doc[0],n,receipt[..]);if size<0 {return 1;}actual:=cast(string)receipt[0..<size];print("%\n",actual);
 operation:=args_at(a[..],3);ok:=false;if operation=="--record" {ok=fs_write(args_at(a[..],4),actual);}else if operation=="--compare" {baseline:[4096]u8;bn:=fs_read(args_at(a[..],4),baseline[..]);ok=bn>0 && anim_frame_report_same(cast(string)baseline[0..<bn],actual);}return ifx ok then 0 else 1;
}
al_capture :: (c:[]Cdp)->bool {return fc_eval(c,"complete station GPU pixels","(async()=>{coaxial.renderCapture=null;coaxial.captureFrame();await coaxialClipStep(1,60);for(let i=0;i<100&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));const r=coaxial.renderCapture;if(!r?.bytes)return false;const hash=await crypto.subtle.digest('SHA-256',new Uint8Array(r.bytes));faceHashes.push(Array.from(new Uint8Array(hash),x=>x.toString(16).padStart(2,'0')).join(''));return true})()");}
