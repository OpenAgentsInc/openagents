// Layer toggles, contact meter, held GPU frames and complete frame timing.
// Captures and raw reports go to the caller's private directory.
#load "valley-capture.coax";
#load "anim-frame-report.coax";
#load "../../verse/tools/humans/ph_num.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=5 {print("usage: anim-layer-frame-check URL PRIVATE_DIR desktop|phone --record|--compare RECEIPT\n");return 2;}
phone:=args_at(a[..],2)=="phone";c:[1]Cdp;if !cdp_launch_background(c[..],1280,800,"animation-layers-check-") {return 1;}defer {cdp_close(c[..]);}
 _:=cdp_call(c[..],"Page.enable","",30000);metrics:=ifx phone then "{\"width\":390,\"height\":844,\"deviceScaleFactor\":1,\"mobile\":true}" else "{\"width\":1280,\"height\":800,\"deviceScaleFactor\":1,\"mobile\":false}";_=cdp_call(c[..],"Emulation.setDeviceMetricsOverride",metrics,30000);
 setup:="globalThis.coaxialClip=true;globalThis.coaxialRenderCapture=true;globalThis.coaxialRenderCaptureFormat='rgba8unorm';globalThis.faceErrors=[];globalThis.faceHashes=[];globalThis.alTimes=[];globalThis.alExpectLoss=false;globalThis.alLosses=0;const ce=console.error;console.error=(...a)=>{const m=a.map(String).join(' ');if(alExpectLoss&&m.startsWith('coaxial: GPU device lost (destroyed:'))alLosses++;else faceErrors.push(m);ce(...a)};globalThis.alEngine='';const observedFetch=fetch;globalThis.fetch=async(...a)=>{const r=await observedFetch(...a);if(new URL(typeof a[0]==='string'?a[0]:a[0].url,location.href).pathname.endsWith('/animationlab.wasm'))alEngine=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',await r.clone().arrayBuffer())),v=>v.toString(16).padStart(2,'0')).join('');return r};if(location.search==='?animlab-test-missing=1'){const af=fetch;globalThis.fetch=(...a)=>new URL(typeof a[0]==='string'?a[0]:a[0].url,location.href).pathname==='/private/animation-lab.bundle'?Promise.resolve(new Response('',{status:404})):af(...a)}";b:[4096]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"source");jo_str(o[..],setup);jo_end(o[..]);_=cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument",jo_text(o[..]),30000);jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],args_at(a[..],0));jo_end(o[..]);_=cdp_call(c[..],"Page.navigate",jo_text(o[..]),30000);

 ready:=false;until:=proc_now_ms()+30000;while proc_now_ms()<until {n:=cdp_evaluate(c[..],"(async()=>!!globalThis.coaxial?.ready&&(await coaxialClipStep(1,60))===1&&coaxial.sceneReady&&coaxial.guardProbe(9)===1)()");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {ready=true;break;}proc_sleep(100);}if !ready {
 abi:=cdp_evaluate(c[..],"(async()=>{let stage='fetch',x,memory,p;try{const bytes=await(await fetch('/build/animationlab.wasm')).arrayBuffer();stage='compile';const m=await WebAssembly.compile(bytes);memory=new WebAssembly.Memory({initial:4096,maximum:4096});const imports={env:{memory}};for(const i of WebAssembly.Module.imports(m))if(i.kind==='function')(imports[i.module]??={})[i.name]=()=>0;stage='instantiate';x=(await WebAssembly.instantiate(m,imports)).exports;stage='initialize';x._initialize?.();p=Number(x.__heap_base.value);stage='state_init';const size=x.coaxial_state_size();x.coaxial_state_init(p);stage='frame';const v=p+size+16,u=v+65536*12*4;const n=x.coaxial_frame(p,v,u,1280,800,1,0,1);for(const [i,url]of [[0,'/private/animation-lab.bundle'],[1,'/private/animation-lab.performance.json'],[2,'/private/animation-lab.contact.clip.json']]){stage='asset_fetch_'+i;const b=new Uint8Array(await(await fetch(url)).arrayBuffer());stage='asset_copy_'+i;new Uint8Array(memory.buffer,x.coaxial_asset(p,i,b.length),b.length).set(b);stage='asset_ready_'+i;x.coaxial_asset_ready(p,i,b.length);}return JSON.stringify({stage:'ok',size,p,n,station:x.coaxial_guard_probe(p,7),htmlPages:document.querySelector('script[data-app]')?.dataset.memoryPages})}catch(e){return JSON.stringify({stage,message:e.message,stack:e.stack?.slice(0,700),size:x?.coaxial_state_size(),p,station:p?x.coaxial_guard_probe(p,7):-1})}})()");if abi>=0 {print("ABI diagnostic %\n",jv_raw(c[0].doc[0],abi));}
 diagnostic:=cdp_evaluate(c[..],"JSON.stringify({ready:!!globalThis.coaxial?.ready,scene:globalThis.coaxial?.sceneReady,errors:faceErrors,probes:globalThis.coaxial?.guardProbe?[0,1,7,8,9,21,22].map(x=>[x,coaxial.guardProbe(x)]):[]})");if diagnostic>=0 {print("layers diagnostic %\n",jv_raw(c[0].doc[0],diagnostic));}print("FAIL layers readiness\n");return 1;}
 if !fc_eval(c[..],"private performance and annotated clip admission", "(async()=>{location.hash='layers?rig=echo';for(let i=0;i<100;i++){await new Promise(r=>setTimeout(r,30));await coaxialClipStep(1,60);if(coaxial.guardProbe(1)===1&&coaxial.guardProbe(7)===3&&coaxial.guardProbe(21)===1)return coaxial.guardProbe(22)>=6&&coaxial.guardProbe(8)===0;}return false})()") {return 1;}
 for k:0..<32 {n:=cdp_evaluate(c[..],"coaxial.guardProbe(22)");if n<0 {return 1;}count:=jv_int(c[0].doc[0],n,0);if k>=count {break;}if !fc_key(c[..],"Enter") {return 1;}expr:[128]u8;j:[1]PnOut;j[0].buf=expr[..];pn_put(j[..],"coaxial.guardProbe(23)===");pn_putint(j[..],cast(int)(cast(u32)1<<k));if !fc_eval(c[..],"selected layer toggles independently",pn_text(j[..])) || !fc_key(c[..],"Enter") || !fc_key(c[..],"=") {return 1;}}
 if !fc_eval(c[..],"individual toggles restore the full stack","coaxial.guardProbe(23)===0") {return 1;}
 if !fc_eval(c[..],"fixed planted frame and sliding meter", "(async()=>{globalThis.alFrame=-1;for(let f=1;f<coaxial.guardProbe(27)-1;f++){coaxial.send(700,String(f));await coaxialClipStep(1,60);if(coaxial.guardProbe(26)>0&&coaxial.guardProbe(24)>1000&&coaxial.guardProbe(25)<1000){alFrame=f;break;}}if(alFrame<0)return false;coaxial.send(700,String(alFrame));await coaxialClipStep(2,60);return coaxial.guardProbe(3)===alFrame})()") || !al_capture(c[..]) || !fc_shot(c[..],args_at(a[..],1),"layers-on.png") {return 1;}
 for key,k:[5]string.["1","2","3","4","5"] {if !fc_key(c[..],key) || !al_capture(c[..]) {return 1;}if k==4 && (!fc_eval(c[..],"foot lock off exposes the measured sliding", "coaxial.guardProbe(26)===0&&coaxial.guardProbe(25)===coaxial.guardProbe(24)&&coaxial.guardProbe(25)>1000") || !fc_shot(c[..],args_at(a[..],1),"fixes-off.png")) {return 1;}if !fc_key(c[..],key) {return 1;}}
 if !al_capture(c[..]) || !fc_eval(c[..],"all toggles restore identical held pixels", "faceHashes.pop()===faceHashes[0]&&coaxial.guardProbe(23)===0&&new Set(faceHashes).size===6") {return 1;}
 if !fc_eval(c[..],"measured performance frames meet budget", "(async()=>{for(let i=0;i<60;i++){const t=performance.now();await coaxialClipStep(1,60);alTimes.push(performance.now()-t);}alTimes.sort((a,b)=>a-b);return faceErrors.length===0&&alTimes[56]<33.3})()") {return 1;}
 n:=cdp_evaluate(c[..],"JSON.stringify({engine:alEngine,viewport:[innerWidth,innerHeight],frame:alFrame,layers:coaxial.guardProbe(22),off_cm:coaxial.guardProbe(24)/1000,on_cm:coaxial.guardProbe(25)/1000,hashes:faceHashes,median_ms:alTimes[30],p95_ms:alTimes[56],errors:faceErrors})");if n<0 {return 1;}receipt:[4096]u8;size:=jv_str(c[0].doc[0],n,receipt[..]);if size<0 {return 1;}actual:=cast(string)receipt[0..<size];print("%\n",actual);
 if args_at(a[..],3)=="--record" {return ifx fs_write(args_at(a[..],4),actual) then 0 else 1;}baseline:[4096]u8;bn:=fs_read(args_at(a[..],4),baseline[..]);return ifx bn>0 && anim_frame_report_same(cast(string)baseline[0..<bn],actual) then 0 else 1;
}
al_capture :: (c:[]Cdp)->bool {return fc_eval(c,"complete station GPU pixels","(async()=>{coaxial.renderCapture=null;coaxial.captureFrame();await coaxialClipStep(1,60);for(let i=0;i<100&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));const r=coaxial.renderCapture;if(!r?.bytes)return false;const hash=await crypto.subtle.digest('SHA-256',new Uint8Array(r.bytes));faceHashes.push(Array.from(new Uint8Array(hash),x=>x.toString(16).padStart(2,'0')).join(''));return true})()");}
