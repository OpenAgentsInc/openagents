// Actual station frames, source face clips, timing and GPU replacement.
// Captures and raw reports go to the caller's private directory.
#load "valley-capture.coax";
#load "anim-frame-report.coax";
#load "../../verse/tools/humans/ph_num.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=5 {print("usage: anim-retarget-frame-check URL PRIVATE_DIR desktop|phone --record|--compare RECEIPT\n");return 2;}
phone:=args_at(a[..],2)=="phone";c:[1]Cdp;if !cdp_launch_background(c[..],1280,800,"animation-retarget-check-") {return 1;}defer {cdp_close(c[..]);}
 _:=cdp_call(c[..],"Page.enable","",30000);metrics:=ifx phone then "{\"width\":390,\"height\":844,\"deviceScaleFactor\":1,\"mobile\":true}" else "{\"width\":1280,\"height\":800,\"deviceScaleFactor\":1,\"mobile\":false}";_=cdp_call(c[..],"Emulation.setDeviceMetricsOverride",metrics,30000);
 setup:="globalThis.coaxialClip=true;globalThis.coaxialRenderCapture=true;globalThis.coaxialRenderCaptureFormat='rgba8unorm';globalThis.faceErrors=[];globalThis.faceHashes=[];globalThis.alTimes=[];globalThis.alExpectLoss=false;globalThis.alLosses=0;const ce=console.error;console.error=(...a)=>{const m=a.map(String).join(' ');if(alExpectLoss&&m.startsWith('coaxial: GPU device lost (destroyed:'))alLosses++;else faceErrors.push(m);ce(...a)};globalThis.alEngine='';const observedFetch=fetch;globalThis.fetch=async(...a)=>{const r=await observedFetch(...a);if(new URL(typeof a[0]==='string'?a[0]:a[0].url,location.href).pathname.endsWith('/animationlab.wasm'))alEngine=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',await r.clone().arrayBuffer())),v=>v.toString(16).padStart(2,'0')).join('');return r};if(location.search==='?animlab-test-missing=1'){const af=fetch;globalThis.fetch=(...a)=>new URL(typeof a[0]==='string'?a[0]:a[0].url,location.href).pathname==='/private/animation-lab.bundle'?Promise.resolve(new Response('',{status:404})):af(...a)}";b:[4096]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"source");jo_str(o[..],setup);jo_end(o[..]);_=cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument",jo_text(o[..]),30000);jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],args_at(a[..],0));jo_end(o[..]);_=cdp_call(c[..],"Page.navigate",jo_text(o[..]),30000);

 ready:=false;until:=proc_now_ms()+120000;while proc_now_ms()<until {n:=cdp_evaluate(c[..],"(async()=>!!globalThis.coaxial?.ready&&(await coaxialClipStep(1,60))===1&&coaxial.sceneReady&&coaxial.guardProbe(9)===1)()");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {ready=true;break;}proc_sleep(100);}if !ready {print("FAIL retarget readiness\n");return 1;}
 if !fc_eval(c[..],"Echo to mannequin paired source and target", "(async()=>{location.hash='retarget?rig=echo&to=mannequin';await new Promise(r=>setTimeout(r,50));await coaxialClipStep(2,60);return coaxial.guardProbe(7)===2&&coaxial.guardProbe(1)===1&&coaxial.guardProbe(18)===0&&coaxial.guardProbe(17)===53&&coaxial.guardProbe(19)>1&&coaxial.guardProbe(8)===0})()") {return 1;}
 for frame,k:[2]string.["4","18"] {
  expr:[256]u8;p:[1]PnOut;p[0].buf=expr[..];pn_put(p[..],"(async()=>{coaxial.send(700,'");pn_put(p[..],frame);pn_put(p[..],"');await coaxialClipStep(2,60);return coaxial.guardProbe(3)===");pn_put(p[..],frame);pn_put(p[..],"})()");if !fc_eval(c[..],"shared source frame",pn_text(p[..])) || !al_capture(c[..]) || !fc_shot(c[..],args_at(a[..],1),ifx k==0 then "echo-mannequin-4.png" else "echo-mannequin-18.png") {return 1;}
 }
 if !fc_eval(c[..],"mannequin to Echo uses reversed anchor map", "(async()=>{location.hash='retarget?rig=mannequin&to=echo';await new Promise(r=>setTimeout(r,50));coaxial.send(700,'18');await coaxialClipStep(2,60);return coaxial.guardProbe(7)===2&&coaxial.guardProbe(1)===0&&coaxial.guardProbe(18)===1&&coaxial.guardProbe(17)===53&&coaxial.guardProbe(8)===0})()") || !al_capture(c[..]) || !fc_shot(c[..],args_at(a[..],1),"mannequin-echo-18.png") {return 1;}
 if !fc_eval(c[..],"both retarget frames advance and meet frame budget", "(async()=>{if(faceHashes[0]===faceHashes[1])return false;for(let i=0;i<60;i++){const t=performance.now();await coaxialClipStep(1,60);alTimes.push(performance.now()-t);}alTimes.sort((a,b)=>a-b);return faceErrors.length===0&&alTimes[56]<33.3})()") {return 1;}
 n:=cdp_evaluate(c[..],"JSON.stringify({engine:alEngine,viewport:[innerWidth,innerHeight],paired:coaxial.guardProbe(17),draws:coaxial.guardProbe(19),hashes:faceHashes,median_ms:alTimes[30],p95_ms:alTimes[56],errors:faceErrors})");if n<0 {return 1;}receipt:[4096]u8;size:=jv_str(c[0].doc[0],n,receipt[..]);if size<0 {return 1;}actual:=cast(string)receipt[0..<size];print("%\n",actual);
 if args_at(a[..],3)=="--record" {return ifx fs_write(args_at(a[..],4),actual) then 0 else 1;}baseline:[4096]u8;bn:=fs_read(args_at(a[..],4),baseline[..]);return ifx bn>0 && anim_frame_report_same(cast(string)baseline[0..<bn],actual) then 0 else 1;
}
al_capture :: (c:[]Cdp)->bool {return fc_eval(c,"complete station GPU pixels","(async()=>{coaxial.renderCapture=null;coaxial.captureFrame();await coaxialClipStep(1,60);for(let i=0;i<100&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));const r=coaxial.renderCapture;if(!r?.bytes)return false;const hash=await crypto.subtle.digest('SHA-256',new Uint8Array(r.bytes));faceHashes.push(Array.from(new Uint8Array(hash),x=>x.toString(16).padStart(2,'0')).join(''));return true})()");}
