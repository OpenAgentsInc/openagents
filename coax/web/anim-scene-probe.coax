// Headless original fixture admission and actual GPU frame smoke check.
#load "valley-capture.coax";
#load "../lib/text/ph_num.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=2 {return 2;}c:[1]Cdp;if !cdp_launch_background(c[..],640,360,"anim-scene-probe-") {return 1;}defer {cdp_close(c[..]);}
 _:=cdp_call(c[..],"Page.enable","",30000);b:[4096]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"source");jo_str(o[..],"globalThis.coaxialClip=true;globalThis.coaxialRenderCapture=true;globalThis.coaxialRenderCaptureFormat='rgba8unorm';globalThis.faceErrors=[];globalThis.faceHashes=[];addEventListener('error',e=>faceErrors.push(e.message));const ce=console.error;console.error=(...a)=>{faceErrors.push(a.map(String).join(' '));ce(...a)}");jo_end(o[..]);_=cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument",jo_text(o[..]),30000);jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],args_at(a[..],0));jo_end(o[..]);_=cdp_call(c[..],"Page.navigate",jo_text(o[..]),30000);
 ready:=false;until:=proc_now_ms()+60000;while proc_now_ms()<until {n:=cdp_evaluate(c[..],"(async()=>{if(!coaxial?.ready)return false;await coaxialClipStep(1,60);return coaxial.guardProbe(30)===1&&coaxial.sceneReady})()");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {ready=true;break;}proc_sleep(100);}n:=cdp_evaluate(c[..],"JSON.stringify({ready:coaxial?.ready,scene:coaxial?.sceneReady,probes:Array.from({length:36},(_,i)=>coaxial?.guardProbe(i)),errors:faceErrors})");if n>=0 {print("%\n",jv_raw(c[0].doc[0],n));}if !ready {return 1;}
 if !fc_eval(c[..],"scene GPU frame","(async()=>{coaxial.send(700,'60');await coaxialClipStep(1,30);coaxial.renderCapture=null;coaxial.captureFrame();await coaxialClipStep(1,30);for(let i=0;i<100&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));return !!coaxial.renderCapture?.bytes&&faceErrors.length===0})()") {return 1;}if !fc_shot(c[..],args_at(a[..],1),"original-scene.png") {return 1;}
 if !fc_eval(c[..],"inspection round trip retains the exact movie geometry", "(async()=>{const hash=async r=>Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new Uint8Array(r.bytes))),v=>v.toString(16).padStart(2,'0')).join('');const before=await hash(coaxial.renderCapture);location.hash='clip';await new Promise(r=>setTimeout(r,50));await coaxialClipStep(2,30);if(coaxial.guardProbe(7)!==1)return false;location.hash='cut';await new Promise(r=>setTimeout(r,50));coaxial.send(700,'60');await coaxialClipStep(2,30);coaxial.renderCapture=null;coaxial.captureFrame();await coaxialClipStep(1,30);for(let i=0;i<100&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));return coaxial.guardProbe(7)===5&&before===await hash(coaxial.renderCapture)&&faceErrors.length===0})()") {return 1;}print("original scene GPU inspection round trip: identical frame\n");return 0;
