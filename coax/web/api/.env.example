# Coax Web API local development environment example (Issue #14076)
# Copy to .env for local development. Never commit real secrets.

OA_ENV=local
OA_API_ORIGIN=http://127.0.0.1:8800
OA_API_SITE_ORIGINS=
OA_API_WORKERS=2
PORT=8810

# Postgres connection string (required)
OA_API_DATABASE=postgres://postgres@127.0.0.1:5432/oa_analytics

# Drivers (local defaults: log mail, sync/postgres queue, local storage, text logs)
OA_MAIL_DRIVER=log
OA_QUEUE_DRIVER=postgres
OA_STORAGE_DRIVER=local
OA_LOG_FORMAT=text

# Versioned 32-byte lowercase hex key rings ("1:<64 hex>[,2:<64 hex>...]")
# Required in production; optional in local dev
OA_AUTH_SEAL_KEY=
OA_AUTH_LOOKUP_PEPPER=

# Mail (required in production when OA_MAIL_DRIVER=resend)
OA_RESEND_API_KEY=
OA_EMAIL_ALLOW=

# Maintenance mode bypass secret (optional)
OA_MAINTENANCE_BYPASS_SECRET=
