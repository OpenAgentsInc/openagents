// Stateful process oracle for API handoff. Uses production preparation/task
// stores; the controlled SDK below is a fixture, never a provider inference.
#load "../../lib/agent/environment/preparation-store.coax";
#load "../../lib/agent/environment/task-store.coax";
#load "../../lib/agent/environment/offer-wire.coax";
#load "../../lib/agent/environment/transcript-store.coax";
#load "../../lib/agent/router/wire.coax";
#load "../../lib/sys/tool.coax";
#load "../../lib/sys/clock.coax";
ncf_station :: (host:string,out:[]u8)->int #effects(all) {
 q:[1]RtrRequest;q[0].n=1;s:=q[0].stations[0..<1];s[0].id="fixture-mac";s[0].name="Native fixture Mac";s[0].os="macos";s[0].cores=8;s[0].memory_total_mb=16384;s[0].memory_free_mb=4096;s[0].disk_free_mb=90000;s[0].disk_floor_mb=1000;s[0].apple_builds=true;s[0].reported_at_ms=cxproc_wall_us()/1000;
 for k:0..<2 {s[0].agents[k]=RtrAgent.{reported=true,installed=true,logged_in=true};}return rtr_report_write(q[..],0,host,out);
}
ncf_log :: (path:string,input:string,state:int,large:bool)->bool #effects(all) {
 s:[1]Session;pool:[524288]u8;s_init(s[..],pool[..]);s_user(s[..],input);s_delta(s[..],P_TEXT,"Checking native task. ");
 if large {body:[16384]u8;for i:0..<body.count {body[i]='x';}for i:0..<10 {id:[32]u8;o:[1]Jo;jo_start(o[..],id[..]);jo_put(o[..],"bulk-");jo_int(o[..],i);sl_test_tool(s[..],jo_text(o[..]),TK_READ,"fixture.txt","","","","{}",cast(string)body[..],false);}}
 sl_test_tool(s[..],"native-tool",TK_EXEC,"fixture command","shell","","","{\"command\":\"fixture\"}",ifx state==XT_COMPLETED then "Fixture write completed" else "",false);
 if state==XT_WAITING {s_notice(s[..],N_ASK,"Allow the fixture command?");}if state==XT_COMPLETED {s_delta(s[..],P_TEXT,"Native task complete.");}
 out:[1048576]u8;n:=sl_lines_checked(s[..],0,s[0].n,false,out[..]);return n>0 && fs_replace_durable(path,cast(string)out[0..<n]);
}
ncf_rpc :: (args:[]Args)->int #effects(all) {
 env:[4096]u8;root_buf:[FS_PATH_MAX]u8;host_buf:[FS_PATH_MAX]u8;prep_buf:[FS_PATH_MAX]u8;tasks_buf:[FS_PATH_MAX]u8;report_buf:[FS_PATH_MAX]u8;
 audit:=proc_getenv("OA_ENV_TASK_FIXTURE_AUDIT",env[..]);if audit=="" {return 2;}host:=args_value(args,"--host","");grant:=args_value(args,"--grant","");base:=fs_join(fs_dir(audit),"native-chat-fixture",root_buf[..]);root:=fs_join(base,host,host_buf[..]);if !fs_mkdir_private(root) {return 3;}
 prep:=fs_join(root,"inputs",prep_buf[..]);tasks:=fs_join(root,"tasks",tasks_buf[..]);report:=fs_join(root,"report.json",report_buf[..]);out:[47104]u8;
 if args_at(args,0)=="station-rpc" {n:=ncf_station(host,out[..]);if n<1 || !fs_replace_durable(report,cast(string)out[0..<n]) {return 3;}print("%\n",cast(string)out[0..<n]);return 0;}
 raw_buf:[40960]u8;n:=fs_read(args_value(args,"--request-file",""),raw_buf[..]);if n<1 {return 2;}raw:=cast(string)raw_buf[0..<n];arena:[8192]u8;
 offer:[1]XoRequest;if xo_request_read(raw,offer[..],arena[..]) {q:=offer[0];now:=cxproc_wall_us()/1000;v:=XoOffer.{host=host,workspace="default",probe=q.probe,engine=q.engine,account=q.account,state=XO_READY,observed=now,expires=xo_deadline(now,XO_TTL),n=1};v.models[0]=XoModel.{id="fixture-native-exact",label="Actual process fixture",n=2};v.models[0].levels[0]="low";v.models[0].levels[1]="high";made:=xo_write(v,out[..]);if made<1 {return 2;}print("%\n",cast(string)out[0..<made]);return 0;}
 b:[1]ExBinding;chunk:[1]ExChunk;view:[1]ExPrepView;receipt:[1024]u8;error:="";
 if ex_binding_read(raw,b[..],arena[..]) {error=exp_store_prepare(prep,grant,host,b[0],cxproc_wall_us()/1000,view[..]);if error!="" {return exp_refusal_status(error);}
  bytes:[RTR_REPORT_MAX]u8;nr:=fs_read(report,bytes[..]);hash:[64]u8;_=S_hex(S_hash(cast(string)bytes[0..<ifx nr>0 then nr else 0]),hash[..]);if nr<1 || cast(string)hash[..]!=b[0].report_hash {return 5;}
  dir:[FS_PATH_MAX]u8;file:[FS_PATH_MAX]u8;if !fs_replace_durable(fs_join(exp_task_dir(prep,grant,b[0].task,dir[..]),"report.json",file[..]),cast(string)bytes[0..<nr]) {return 3;}
  made:=exp_view_write(view[0],out[..]);if made<1 {return 2;}print("%\n",cast(string)out[0..<made]);return 0;
 }
 if ex_chunk_read(raw,chunk[..],arena[..]) {error=exp_store_put(prep,grant,chunk[0],cxproc_wall_us()/1000,view[..],receipt[..]);if error!="" {return exp_refusal_status(error);}made:=exp_view_write(view[0],out[..]);if made<1 {return 2;}print("%\n",cast(string)out[0..<made]);return 0;}
 q:[1]XtRequest;tq:[1]XhRequest;qa:[2048]u8;transcript:=xh_request_read(raw,tq[..],qa[..]);if transcript {q[0]=XtRequest.{method="ReadTask",task=tq[0].task};}else if !xt_request_read(raw,q[..],qa[..]) {return 2;}
 status:[1]XtStatus;sa:[2048]u8;path:[FS_PATH_MAX]u8;log_buf:[FS_PATH_MAX]u8;input_buf:[FS_PATH_MAX]u8;directory:=xt_task_dir(tasks,grant,q[0].task,path[..]);transcript_path:=fs_join(directory,"session.jsonl",log_buf[..]);source:=fs_join(directory,"input.json",input_buf[..]);
 match:=ifx q[0].method=="ReadTask" then 0 else xt_command_match(tasks,grant,q[0].command,raw);if match==2 {return 6;}
 if q[0].method=="StartTask" && match==0 {
  bb:[8192]u8;ba:[2048]u8;stage:[FS_PATH_MAX]u8;f:[FS_PATH_MAX]u8;bn:=fs_read(fs_join(exp_task_dir(prep,grant,q[0].task,stage[..]),"binding.json",f[..]),bb[..]);if bn<1 || !ex_binding_read(cast(string)bb[0..<bn],b[..],ba[..]) {return 3;}
  error=xt_store_start(tasks,prep,grant,b[0],q[0],raw,cxproc_wall_us()/1000,status[..]);if error!="" {return exp_refusal_status(error);}status[0].state=XT_WAITING;status[0].revision=2;status[0].interaction="native-request";status[0].native="fixture-native-session";
  input:[EX_INPUT_MAX]u8;large_path:[FS_PATH_MAX]u8;ni:=fs_read(source,input[..]);if ni<1 || !ncf_log(transcript_path,cast(string)input[0..<ni],XT_WAITING,fs_exists(fs_join(root,"large-capture",large_path[..]))) || !xt_status_save(directory,status[0]) {return 3;}
  effect:[FS_PATH_MAX]u8;if !fs_append_durable(fs_join(root,"starts",effect[..]),"start\n") {return 3;}
  // Lose the first reply after durable ownership/effect publication.
  return 3;
 }
 error=xt_status_load(tasks,grant,q[0].task,status[..],sa[..]);if error!="" {return exp_refusal_status(error);}
 if q[0].method!="ReadTask" && q[0].method!="StartTask" && match==0 {
  verdict:=xt_control(0,q[0].method,status[0].state,q[0].revision,status[0].revision,q[0].interaction==status[0].interaction,status[0].stop,q[0].issued,q[0].expires,cxproc_wall_us()/1000);if verdict<0 {return ifx verdict== -2 then 5 else 6;}
  error=xt_store_control(tasks,grant,q[0],raw);if error!="" {return exp_refusal_status(error);}status[0].state=ifx q[0].method=="StopTask" then XT_CANCELED else ifx q[0].allow then XT_COMPLETED else XT_FAILED;status[0].error=ifx status[0].state==XT_FAILED then "native_failed" else "";status[0].stop=q[0].method=="StopTask";status[0].revision+=1;status[0].interaction="";status[0].updated=cxproc_wall_us()/1000;
  input:[EX_INPUT_MAX]u8;large_path:[FS_PATH_MAX]u8;ni:=fs_read(source,input[..]);if ni<1 || !ncf_log(transcript_path,cast(string)input[0..<ni],status[0].state,fs_exists(fs_join(root,"large-capture",large_path[..]))) || !xt_status_save(directory,status[0]) {return 3;}
  effect:[FS_PATH_MAX]u8;if !fs_append_durable(fs_join(root,"controls",effect[..]),"control\n") {return 3;}
 }
 if transcript {captures:[FS_PATH_MAX]u8;page:[1]XhPage;strings:[XH_ARENA]u8;text:[XH_CHUNK_MAX+4]u8;error=xh_store_page(fs_join(root,"captures",captures[..]),grant,tq[0],status[0],transcript_path,cxproc_wall_us()/1000,page[..],strings[..],text[..]);if error!="" {return exp_refusal_status(error);}made:=xh_page_write(page[0],out[..]);if made<1 {return 2;}print("%\n",cast(string)out[0..<made]);return 0;}
 status[0].command=q[0].command;status[0].replay=match==1;made:=xt_status_write(status[0],out[..]);if made<1 {return 2;}print("%\n",cast(string)out[0..<made]);return 0;
}
