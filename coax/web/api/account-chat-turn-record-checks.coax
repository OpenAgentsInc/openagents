 n=ctr_summary(c[..],b[..]);summaries:=[1]string.[cast(string)b[0..<n]];out:[8192]u8;n=ctr_index(summaries[..],"page-1",out[..]);#assert n>0 && jv_parse(d[..],cast(string)out[0..<n],nodes[..]) && jv_len(d[0],0)==3 && jv_raw(d[0],jv_get(d[0],0,"schema"))=="openagents.chat.index.v2alpha1" && jv_raw(d[0],jv_get(d[0],0,"next_cursor"))=="page-1";at=jv_at(d[0],jv_get(d[0],0,"items"),0);#assert jv_raw(d[0],jv_get(d[0],at,"id"))==CT_TEST_CONVERSATION && ctr_index(summaries[..],"",out[0..<5])<0;
}
#test "message and event page refusal facts are independent" {
 b:[8192]u8;submit:[2048]u8;one:=[1]string.["Q"];n:=ct_submit_write("x","",0,"",-1,"",-1,one[..],submit[..]);raw:=cast(string)submit[0..<n];
 #assert ctr_user_message(raw,"bad",1,b[..])<0 && ctr_user_message(raw,CT_TEST_TURN,-1,b[..])<0 && ctr_user_message(raw,CT_TEST_TURN,1,b[0..<1])<0;
 v:[1]CtView;ct_record_running(v[..]);empty:[1]string;#assert ctr_events(v[..],-1,empty[0..<0],b[..])<0 && ctr_events(v[..],3,empty[0..<0],b[..])<0;
 v[0].state=0;#assert ctr_events(v[..],0,empty[0..<0],b[..])<0 && ctr_answer_message(v[..],0,b[..])<0;ct_record_running(v[..]);
 e:[1]CtEvent;part:[4096]u8;e[0]=CtEvent.{conversation=CT_TEST_CONVERSATION,turn=CT_TEST_TURN,sequence=2,kind=CT_STARTED,state=CT_RUNNING};n=ct_event_write(e[..],part[..]);events:=[1]string.[cast(string)part[0..<n]];#assert ctr_events(v[..],1,events[..],b[..])>0;
 v[0].sequence=1;#assert ctr_events(v[..],1,events[..],b[..])<0;v[0].sequence=2;
 e[0].sequence=1;e[0].conversation="cnv_ffffffffffffffffffffffffffffffff";n=ct_event_write(e[..],part[..]);events[0]=cast(string)part[0..<n];#assert ctr_events(v[..],0,events[..],b[..])<0;
 e[0].conversation=CT_TEST_CONVERSATION;e[0].turn="trn_ffffffffffffffffffffffffffffffff";n=ct_event_write(e[..],part[..]);events[0]=cast(string)part[0..<n];#assert ctr_events(v[..],0,events[..],b[..])<0;
}
#test "runner readers validate single-byte minimums full byte ceilings and independent nullable fields" {
 b:[4097]u8;c:[8192]u8;arena:[232]u8;r:[1]CtWorker;text:[81]u8;for j:0..<text.count {text[j]='x';}
 #assert cwr_write(1,"x","w","","",b[..])>0 && cwr_write(1,cast(string)text[0..<80],cast(string)text[0..<80],"","",b[..])>0;
 #assert cwr_write(1,cast(string)text[..],"w","","",b[..])<0 && cwr_write(1,"x",cast(string)text[..],"","",b[..])<0;
 #assert cwr_write(1,"x","w",CT_TEST_TURN,"",b[..])<0 && cwr_write(1,"x","w","",CT_TEST_DISPATCH,b[..])<0;
 n:=cwr_write(1,"x","w","","",b[..]);raw:=cast(string)b[0..<n];
 for key:[6]string.["schema","operation","operation_id","worker_id","turn_id","dispatch_id"] {#assert !cwr_read(ct_check_alias(raw,key,c[..]),r[..],arena[..]);}
 for j:n..<b.count {b[j]=' ';}#assert cwr_read(cast(string)b[0..<4096],r[..],arena[..]) && !cwr_read(cast(string)b[..],r[..],arena[..]);
 #assert cwr_job("x","","",b[..])<0;
}
#test "runner job decoder refuses every malformed peer field and exact encoded bounds" {
 b:[2049]u8;c:[8192]u8;r:[1]CtJob;arena:[108]u8;n:=cwr_job(CT_TEST_TURN,CT_TEST_CONVERSATION,CT_TEST_DISPATCH,b[..]);raw:=cast(string)b[0..<n];
 #assert !cwr_job_read(raw,r[..],arena[0..<107]);
 for key:[5]string.["schema","has_work","turn_id","conversation_id","dispatch_id"] {
  for bad:[5]string.["null","\"bad\"","true","1","\"\\u0000\""] {#assert !cwr_job_read(ct_check_replace(raw,key,bad,c[..]),r[..],arena[..])==(key!="has_work" || bad!="true");}
  #assert !cwr_job_read(ct_check_alias(raw,key,c[..]),r[..],arena[..]);
 }
 for key:[3]string.["turn_id","conversation_id","dispatch_id"] {#assert !cwr_job_read(ct_check_replace(raw,key,"\"xxx_0123456789abcdef0123456789abcdef\"",c[..]),r[..],arena[..]);}
 for j:n..<b.count {b[j]=' ';}#assert cwr_job_read(cast(string)b[0..<2048],r[..],arena[..]) && !cwr_job_read(cast(string)b[..],r[..],arena[..]);
 n=cwr_job("","","",b[..]);raw=cast(string)b[0..<n];for key:[3]string.["turn_id","conversation_id","dispatch_id"] {#assert !cwr_job_read(ct_check_replace(raw,key,"\"\"",c[..]),r[..],arena[..]);}
}
