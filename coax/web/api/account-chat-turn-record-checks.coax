 c[0].id="bad";#assert !ctr_conversation_valid(c[..]);c[0].id=CT_TEST_CONVERSATION;c[0].project="bad";#assert !ctr_conversation_valid(c[..]);c[0].project="";c[0].active="bad";#assert !ctr_conversation_valid(c[..]);c[0].active="";
