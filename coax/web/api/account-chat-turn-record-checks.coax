 for value:[3]int.[-1,0,CT_SEQUENCE_MAX+1] {i[0].revision=value;#assert !ctr_info_valid(i[..]);}i[0].revision=CT_SEQUENCE_MAX;#assert ctr_info_valid(i[..]);i[0].revision=1;
 i[0].created= -1;#assert !ctr_info_valid(i[..]);i[0].created=1;i[0].updated=0;#assert !ctr_info_valid(i[..]);i[0].updated=9007199254740992;#assert !ctr_info_valid(i[..]);i[0].updated=1;
 i[0].operation="";#assert !ctr_info_valid(i[..]);i[0].operation="op";i[0].model="";#assert !ctr_info_valid(i[..]);i[0].model="m";i[0].provider="";#assert !ctr_info_valid(i[..]);i[0].provider="p";
 i[0].snapshot="bad";#assert !ctr_info_valid(i[..]);i[0].snapshot="ctx_0123456789abcdef0123456789abcdef";#assert ctr_info_valid(i[..]);
}
