 r:[1]CtSubmit;arena:[174]u8;if !ct_id(turn,"trn_",32) || !ctr_time(created) || !ct_submit_read(raw,r[..],arena[..]) {return -1;}
 o:[1]Jo;jo_start(o[..],out);ctr_message_start(o[..],turn,false);for b:0..<r[0].blocks {ctr_text(o[..],ct_submit_text(r[..],b));}ctr_message_end(o[..],created);return ct_len(o[..]);
}
ctr_answer_message :: (v:[]CtView,created:int,out:[]u8)->int #export_c #effects(all) {if !ctr_view_valid(v) || !ctr_time(created) {return -1;}o:[1]Jo;jo_start(o[..],out);ctr_message_start(o[..],cast(string)v[0].turn[..],true);if v[0].bytes>0 {ctr_text(o[..],ct_view_text(v));}ctr_message_end(o[..],created);return ct_len(o[..]);}
ctr_message_start :: (o:[]Jo,turn:string,assistant:bool) {jo_obj(o);jo_key(o,"id");b:[64]u8;q:[1]Jo;jo_start(q[..],b[..]);jo_put(q[..],turn);jo_put(q[..],ifx assistant then ".assistant" else ".user");jo_str(o,jo_text(q[..]));jo_key(o,"turn_id");jo_str(o,turn);jo_key(o,"role");jo_str(o,ifx assistant then "assistant" else "user");jo_key(o,"content");jo_arr(o);}
ctr_message_end :: (o:[]Jo,created:int) {jo_end(o);jo_key(o,"created_at_ms");jo_int(o,created);jo_end(o);}
// A preserved legacy message has no rich turn receipt. Empty turn_id expresses
// that fact; stable identity is scoped to the new conversation and source index.
ctr_historical_message :: (conversation:string,index:int,assistant:bool,text:string,created:int,out:[]u8)->int #export_c #effects(all) {
