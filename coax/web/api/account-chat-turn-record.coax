  if e[0].conversation!=cast(string)v[0].conversation[..] || e[0].turn!=cast(string)v[0].turn[..] || !ct_sequence(last,e[0].sequence) || e[0].sequence>v[0].sequence {return -1;}
  last=e[0].sequence;
 }
 o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],CTR_EVENTS);jo_key(o[..],"conversation_id");jo_str(o[..],cast(string)v[0].conversation[..]);jo_key(o[..],"turn_id");jo_str(o[..],cast(string)v[0].turn[..]);jo_key(o[..],"after");jo_int(o[..],after);jo_key(o[..],"events");jo_arr(o[..]);for raw:events {jo_raw(o[..],raw);}jo_end(o[..]);jo_key(o[..],"next_cursor");jo_int(o[..],last);jo_key(o[..],"has_more");jo_bool(o[..],last<v[0].sequence);jo_key(o[..],"state");jo_str(o[..],ct_state_name(v[0].state));jo_end(o[..]);return ct_len(o[..]);
}
cwr_read :: (raw:string,r:[]CtWorker,arena:[]u8)->bool #export_c #effects(all) {
 if raw.count>4096 || arena.count<232 {return false;}d:[1]Jv;nodes:[16]JvNode;if !jv_parse(d[..],raw,nodes[..]) {return false;}v:=d[0];keys:=[6]string.["schema","operation","operation_id","worker_id","turn_id","dispatch_id"];
 if !js_fields(v,0,keys[..]) || jv_len(v,0)!=6 || jv_raw(v,jv_get(v,0,"schema"))!=CTR_RUNNER {return false;}
 name:=jv_raw(v,jv_get(v,0,"operation"));op:=ifx name=="next" then 1 else ifx name=="run" then 2 else ifx name=="lost" then 3 else 0;if op==0 {return false;}
 ni:=js_string(v,jv_get(v,0,"operation_id"),arena[0..<80]);nw:=js_string(v,jv_get(v,0,"worker_id"),arena[80..<160]);
 nt:=ct_nullable_string(v,jv_get(v,0,"turn_id"),arena[160..<196]); // mutant: equivalent (a widened turn span still fails the exact identity length or claim's null check)
 nd:=ct_nullable_string(v,jv_get(v,0,"dispatch_id"),arena[196..<232]);if ni<1 || nw<1 || nt<0 || nd<0 {return false;}
 next:=CtWorker.{operation=op,id=cast(string)arena[0..<ni],worker=cast(string)arena[80..<80+nw],turn=cast(string)arena[160..<160+nt],dispatch=cast(string)arena[196..<196+nd]};
 if op==1 {if jv_kind(v,jv_get(v,0,"turn_id"))!=JV_NULL || jv_kind(v,jv_get(v,0,"dispatch_id"))!=JV_NULL {return false;}}
 else if !ct_id(next.turn,"trn_",32) || !ct_id(next.dispatch,"run_",32) {return false;}
 r[0]=next;return true;
}
cwr_write :: (operation:int,id:string,worker:string,turn:string,dispatch:string,out:[]u8)->int #export_c #effects(all) {
 o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],CTR_RUNNER);jo_key(o[..],"operation");jo_str(o[..],ifx operation==1 then "next" else ifx operation==2 then "run" else ifx operation==3 then "lost" else "");jo_key(o[..],"operation_id");jo_str(o[..],id);jo_key(o[..],"worker_id");jo_str(o[..],worker);jo_key(o[..],"turn_id");ct_optional_text(o[..],turn);jo_key(o[..],"dispatch_id");ct_optional_text(o[..],dispatch);jo_end(o[..]);n:=ct_len(o[..]);r:[1]CtWorker;arena:[232]u8;
 if n<0 {return -1;} // mutant: equivalent (a JSON object is never zero or one bytes; writer failure is -1)
 if !cwr_read(cast(string)out[0..<n],r[..],arena[..]) {return -1;}return n;
}
cwr_job :: (turn:string,conversation:string,dispatch:string,out:[]u8)->int #export_c #effects(all) {
 some:=turn.count>0;if some {if !ct_id(turn,"trn_",32) || !ct_id(conversation,"cnv_",32) || !ct_id(dispatch,"run_",32) {return -1;}}else if conversation.count!=0 || dispatch.count!=0 {return -1;}
 o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],CTR_JOB);jo_key(o[..],"has_work");jo_bool(o[..],some);jo_key(o[..],"turn_id");ct_optional_text(o[..],turn);jo_key(o[..],"conversation_id");ct_optional_text(o[..],conversation);jo_key(o[..],"dispatch_id");ct_optional_text(o[..],dispatch);jo_end(o[..]);return ct_len(o[..]);
}
cwr_job_read :: (raw:string,r:[]CtJob,arena:[]u8)->bool #export_c #effects(all) {
 if raw.count>2048 || arena.count<108 {return false;}d:[1]Jv;nodes:[12]JvNode;if !jv_parse(d[..],raw,nodes[..]) {return false;}v:=d[0];keys:=[5]string.["schema","has_work","turn_id","conversation_id","dispatch_id"];
 if !js_fields(v,0,keys[..]) || jv_len(v,0)!=5 || jv_raw(v,jv_get(v,0,"schema"))!=CTR_JOB {return false;}
 work:=jv_kind(v,jv_get(v,0,"has_work"));if work!=JV_TRUE && work!=JV_FALSE {return false;}
 nt:=ct_nullable_string(v,jv_get(v,0,"turn_id"),arena[0..<36]); // mutant: equivalent (a widened span still fails the exact identity length or empty-queue null check)
 nc:=ct_nullable_string(v,jv_get(v,0,"conversation_id"),arena[36..<72]); // mutant: equivalent (a widened span still fails the exact identity length or empty-queue null check)
 nd:=ct_nullable_string(v,jv_get(v,0,"dispatch_id"),arena[72..<108]);if nt<0 || nc<0 || nd<0 {return false;}
 next:=CtJob.{has_work=work==JV_TRUE,turn=cast(string)arena[0..<nt],conversation=cast(string)arena[36..<36+nc],dispatch=cast(string)arena[72..<72+nd]};
 if next.has_work {if !ct_id(next.turn,"trn_",32) || !ct_id(next.conversation,"cnv_",32) || !ct_id(next.dispatch,"run_",32) {return false;}}
 else {for key:[3]string.["turn_id","conversation_id","dispatch_id"] {if jv_kind(v,jv_get(v,0,key))!=JV_NULL {return false;}}}
 r[0]=next;return true;
}
