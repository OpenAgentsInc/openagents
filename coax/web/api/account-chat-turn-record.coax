 e[0].kind=ifx v[0].state==CT_RUNNING then CT_USAGE else ifx v[0].state==CT_COMPLETED then CT_DONE else ifx v[0].state==CT_FAILED then CT_ERROR else ifx v[0].state==CT_CANCELLED then CT_CANCEL else CT_LOST;
