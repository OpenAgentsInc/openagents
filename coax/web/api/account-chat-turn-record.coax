// Resource/service codecs beside the shared submit/event codec. All strings
// read into output records borrow the explicit caller arena.
// coax test coax/web/api/account-chat-turn-record.coax --library
#load "account-chat-turn-wire.coax";
CTR_TURN :: "openagents.chat.turn.v2alpha1";
CTR_CONTROL :: "openagents.chat.control.v2alpha1";
CTR_CONVERSATION :: "openagents.chat.conversation.v2alpha1";
CTR_INDEX :: "openagents.chat.index.v2alpha1";
CTR_EVENTS :: "openagents.chat.events.v2alpha1";
CTR_RUNNER :: "openagents.chat.runner.v2alpha1";
CTR_JOB :: "openagents.chat.job.v2alpha1";
CtInfo :: struct {operation:string;model:string;provider:string;effort:string;route:string;why:string;snapshot:string;revision:int;created:int;updated:int;}
CtConversation :: struct {id:string;title:string;revision:int;project:string;legacy:string;legacy_revision:int= -1;active:string;created:int;updated:int;cursor:string;}
CtControl :: struct {conversation:string;turn:string;revision:int;state:int;stopped:bool;cursor:int;}
CtWorker :: struct {operation:int;id:string;worker:string;turn:string;dispatch:string;}
CtJob :: struct {has_work:bool;turn:string;conversation:string;dispatch:string;}
CtPage :: struct {next:int;more:bool;state:int;}
ctr_time :: (n:int)->bool {return n>=0 && n<=9007199254740991;}
ctr_view_valid :: (v:[]CtView)->bool {
 if !ct_id(cast(string)v[0].conversation[..],"cnv_",32) || !ct_id(cast(string)v[0].turn[..],"trn_",32) {return false;}
 if v[0].sequence<0 || v[0].sequence>CT_SEQUENCE_MAX {return false;} // mutant: equivalent (widening the sequence cap still fails ct_event_valid below, or the queued cursor-zero check)
 if v[0].bytes<0 || v[0].bytes>131072 || v[0].ne<0 || v[0].ne>512 {return false;}
 if v[0].nr<0 || v[0].nr>80 {return false;} // mutant: equivalent (no allowed stop-reason spelling is 80 bytes; rejecting exactly 80 still refuses an invalid reason)
 if !ct_valid_text(ct_view_text(v),131072) {return false;} // mutant: equivalent (the fixed content array and the preceding decoded-byte bound already cap this text)
 if v[0].state==CT_QUEUED {return v[0].sequence==0 && v[0].bytes==0 && !v[0].stop_requested && v[0].nr==0 && v[0].ne==0 && v[0].usage.input== -1 && v[0].usage.output== -1 && v[0].usage.cache_read== -1 && v[0].usage.cache_write== -1 && v[0].usage.reasoning== -1;}
 e:[1]CtEvent;e[0]=CtEvent.{conversation=cast(string)v[0].conversation[..],turn=cast(string)v[0].turn[..],sequence=v[0].sequence,state=v[0].state,stop_requested=v[0].stop_requested,usage=v[0].usage,has_usage=true,reason=ct_view_reason(v),error=cast(string)v[0].error[0..<v[0].ne]};
 e[0].kind=ifx v[0].state==CT_RUNNING then CT_USAGE else ifx v[0].state==CT_COMPLETED then CT_DONE else ifx v[0].state==CT_FAILED then CT_ERROR else ifx v[0].state==CT_CANCELLED then CT_CANCEL else CT_LOST;
 return ct_event_valid(e[..]);
}
ctr_info_valid :: (i:[]CtInfo)->bool {
 return i[0].operation.count>0 && ct_valid_text(i[0].operation,80) && i[0].revision>0 && i[0].revision<=CT_SEQUENCE_MAX && ctr_time(i[0].created) && ctr_time(i[0].updated) && i[0].updated>=i[0].created && i[0].model.count>0 && ct_valid_text(i[0].model,160) && i[0].provider.count>0 && ct_valid_text(i[0].provider,80) && ct_valid_text(i[0].effort,16) && ct_valid_text(i[0].route,80) && ct_valid_text(i[0].why,1024) && (i[0].snapshot.count==0 || ct_id(i[0].snapshot,"ctx_",32));
}
ctr_control_write :: (v:[]CtView,revision:int,out:[]u8)->int #export_c #effects(all) {
 if !ctr_view_valid(v) || revision<1 || revision>CT_SEQUENCE_MAX {return -1;}
 o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],CTR_CONTROL);jo_key(o[..],"conversation_id");jo_str(o[..],cast(string)v[0].conversation[..]);jo_key(o[..],"turn_id");jo_str(o[..],cast(string)v[0].turn[..]);jo_key(o[..],"conversation_revision");jo_int(o[..],revision);jo_key(o[..],"state");jo_str(o[..],ct_state_name(v[0].state));jo_key(o[..],"stop_requested");jo_bool(o[..],v[0].stop_requested);jo_key(o[..],"event_cursor");jo_int(o[..],v[0].sequence);jo_end(o[..]);return ct_len(o[..]);
}
ctr_control_read :: (raw:string,r:[]CtControl,arena:[]u8)->bool {
 if arena.count<72 || raw.count>2048 {return false;}d:[1]Jv;nodes:[16]JvNode;if !jv_parse(d[..],raw,nodes[..]) {return false;}v:=d[0];keys:=[7]string.["schema","conversation_id","turn_id","conversation_revision","state","stop_requested","event_cursor"];
 if !js_fields(v,0,keys[..]) || jv_len(v,0)!=7 || jv_raw(v,jv_get(v,0,"schema"))!=CTR_CONTROL {return false;}
 a:=js_string(v,jv_get(v,0,"conversation_id"),arena[0..<36]); // mutant: equivalent (a widened span cannot bypass the exact 36-byte identity checks below)
 b:=js_string(v,jv_get(v,0,"turn_id"),arena[36..<72]);if a!=36 || b!=36 {return false;}
 next:=CtControl.{conversation=cast(string)arena[0..<36],turn=cast(string)arena[36..<72],revision=js_number(v,jv_get(v,0,"conversation_revision")),state=ct_state_of(jv_raw(v,jv_get(v,0,"state"))),cursor=js_number(v,jv_get(v,0,"event_cursor"))};
 k:=jv_kind(v,jv_get(v,0,"stop_requested"));if k!=JV_TRUE && k!=JV_FALSE {return false;}next.stopped=k==JV_TRUE;
 if !ct_id(next.conversation,"cnv_",32) || !ct_id(next.turn,"trn_",32) || next.revision<1 || next.revision>CT_SEQUENCE_MAX || next.cursor<0 || next.cursor>CT_SEQUENCE_MAX {return false;}
 if next.state<CT_QUEUED || next.state>CT_UNKNOWN {return false;} // mutant: equivalent (ct_state_of yields zero or one of the six defined states, never seven)
 if next.state==CT_QUEUED {if next.cursor!=0 || next.stopped {return false;}}else if next.cursor<1 {return false;}
 if next.state==CT_CANCELLED && !next.stopped {return false;}
 r[0]=next;return true;
}
ctr_turn_write :: (v:[]CtView,i:[]CtInfo,out:[]u8)->int #export_c #effects(all) {
 if !ctr_view_valid(v) || !ctr_info_valid(i) {return -1;}o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],CTR_TURN);jo_key(o[..],"id");jo_str(o[..],cast(string)v[0].turn[..]);jo_key(o[..],"conversation_id");jo_str(o[..],cast(string)v[0].conversation[..]);jo_key(o[..],"operation_id");jo_str(o[..],i[0].operation);jo_key(o[..],"state");jo_str(o[..],ct_state_name(v[0].state));jo_key(o[..],"stop_requested");jo_bool(o[..],v[0].stop_requested);jo_key(o[..],"stop_reason");ct_optional_text(o[..],ct_view_reason(v));jo_key(o[..],"usage");ct_usage_at(o[..],v[0].usage);
 jo_key(o[..],"selection");jo_obj(o[..]);jo_key(o[..],"model_id");jo_str(o[..],i[0].model);jo_key(o[..],"provider_id");jo_str(o[..],i[0].provider);jo_key(o[..],"effort");jo_str(o[..],i[0].effort);jo_key(o[..],"route_decision_id");ct_optional_text(o[..],i[0].route);jo_key(o[..],"reason");jo_str(o[..],i[0].why);jo_end(o[..]);
 jo_key(o[..],"content");jo_arr(o[..]);if v[0].bytes>0 {ctr_text(o[..],ct_view_text(v));}jo_end(o[..]);jo_key(o[..],"event_cursor");jo_int(o[..],v[0].sequence);jo_key(o[..],"conversation_revision");jo_int(o[..],i[0].revision);jo_key(o[..],"context_snapshot_id");ct_optional_text(o[..],i[0].snapshot);jo_key(o[..],"error");ct_optional_text(o[..],cast(string)v[0].error[0..<v[0].ne]);jo_key(o[..],"created_at_ms");jo_int(o[..],i[0].created);jo_key(o[..],"updated_at_ms");jo_int(o[..],i[0].updated);jo_end(o[..]);return ct_len(o[..]);
}
// The API, CLI and native host share the same reader. Metadata strings borrow
// the caller's 1,476-byte arena; the reply and event cursor are owned by CtView.
ctr_turn_read :: (raw:string,out:[]CtView,info:[]CtInfo,arena:[]u8)->bool #export_c #effects(all) {
 if raw.count>1048576 || arena.count<1476 {return false;}d:[1]Jv;nodes:[128]JvNode;if !jv_parse(d[..],raw,nodes[..]) {return false;}v:=d[0];
 keys:=[16]string.["schema","id","conversation_id","operation_id","state","stop_requested","stop_reason","usage","selection","content","event_cursor","conversation_revision","context_snapshot_id","error","created_at_ms","updated_at_ms"];
 if !js_fields(v,0,keys[..]) || jv_len(v,0)!=16 || jv_raw(v,jv_get(v,0,"schema"))!=CTR_TURN {return false;}
 next:[1]CtView;n:=js_string(v,jv_get(v,0,"conversation_id"),next[0].conversation[..]);m:=js_string(v,jv_get(v,0,"id"),next[0].turn[..]);if n!=36 || m!=36 {return false;}
 next[0].state=ct_state_of(jv_raw(v,jv_get(v,0,"state")));next[0].sequence=js_number(v,jv_get(v,0,"event_cursor"));stop:=jv_kind(v,jv_get(v,0,"stop_requested"));if stop!=JV_TRUE && stop!=JV_FALSE {return false;}next[0].stop_requested=stop==JV_TRUE;
 next[0].nr=ct_nullable_string(v,jv_get(v,0,"stop_reason"),next[0].reason[..]);next[0].ne=ct_nullable_string(v,jv_get(v,0,"error"),next[0].error[..]);if next[0].nr<0 || next[0].ne<0 {return false;} // mutant: equivalent (changing only this OR to AND still reaches ctr_view_valid's independent negative-length refusals)
 if (next[0].nr==0 && jv_kind(v,jv_get(v,0,"stop_reason"))!=JV_NULL) || (next[0].ne==0 && jv_kind(v,jv_get(v,0,"error"))!=JV_NULL) {return false;}
 u:[1]CtUsage;if !ct_usage_read(v,jv_get(v,0,"usage"),u[..]) {return false;}next[0].usage=u[0];
 content:=jv_get(v,0,"content");if jv_kind(v,content)!=JV_ARRAY || jv_len(v,content)>1 {return false;}if jv_len(v,content)==1 {at:=jv_at(v,content,0);fields:=[2]string.["type","text"];if !js_fields(v,at,fields[..]) || jv_len(v,at)!=2 || jv_raw(v,jv_get(v,at,"type"))!="text" {return false;}next[0].bytes=js_string(v,jv_get(v,at,"text"),next[0].content[..]);if next[0].bytes<1 {return false;}}
 select:=jv_get(v,0,"selection");fields:=[5]string.["model_id","provider_id","effort","route_decision_id","reason"];if !js_fields(v,select,fields[..]) || jv_len(v,select)!=5 {return false;}
 lengths:[7]int;lengths[0]=js_string(v,jv_get(v,0,"operation_id"),arena[0..<80]);lengths[1]=js_string(v,jv_get(v,select,"model_id"),arena[80..<240]);lengths[2]=js_string(v,jv_get(v,select,"provider_id"),arena[240..<320]);lengths[3]=js_string(v,jv_get(v,select,"effort"),arena[320..<336]);lengths[4]=ct_nullable_string(v,jv_get(v,select,"route_decision_id"),arena[336..<416]);lengths[5]=js_string(v,jv_get(v,select,"reason"),arena[416..<1440]);lengths[6]=ct_nullable_string(v,jv_get(v,0,"context_snapshot_id"),arena[1440..<1476]);for value:lengths {if value<0 {return false;}} // mutant: equivalent (widening an individual metadata slice by one still fails ctr_info_valid's own byte ceiling)
 if (lengths[4]==0 && jv_kind(v,jv_get(v,select,"route_decision_id"))!=JV_NULL) || (lengths[6]==0 && jv_kind(v,jv_get(v,0,"context_snapshot_id"))!=JV_NULL) {return false;}
 i:=[1]CtInfo.[CtInfo.{operation=cast(string)arena[0..<lengths[0]],model=cast(string)arena[80..<80+lengths[1]],provider=cast(string)arena[240..<240+lengths[2]],effort=cast(string)arena[320..<320+lengths[3]],route=cast(string)arena[336..<336+lengths[4]],why=cast(string)arena[416..<416+lengths[5]],snapshot=cast(string)arena[1440..<1440+lengths[6]],revision=js_number(v,jv_get(v,0,"conversation_revision")),created=js_number(v,jv_get(v,0,"created_at_ms")),updated=js_number(v,jv_get(v,0,"updated_at_ms"))}];
 if !ctr_view_valid(next[..]) || !ctr_info_valid(i[..]) {return false;}out[0]=next[0];info[0]=i[0];return true;
}
// Apply a whole replay page to a temporary view. A malformed later event or
// cursor never leaves a client with a partially applied page.
ctr_page_apply :: (raw:string,out:[]CtView,page:[]CtPage)->bool #export_c #effects(all) {
 if raw.count>131072 || !ctr_view_valid(out) {return false;}d:[1]Jv;nodes:[1600]JvNode;if !jv_parse(d[..],raw,nodes[..]) {return false;}v:=d[0];keys:=[8]string.["schema","conversation_id","turn_id","after","events","next_cursor","has_more","state"];
 if !js_fields(v,0,keys[..]) || jv_len(v,0)!=8 || jv_raw(v,jv_get(v,0,"schema"))!=CTR_EVENTS || jv_raw(v,jv_get(v,0,"conversation_id"))!=cast(string)out[0].conversation[..] || jv_raw(v,jv_get(v,0,"turn_id"))!=cast(string)out[0].turn[..] {return false;}
 after:=js_number(v,jv_get(v,0,"after"));cursor:=js_number(v,jv_get(v,0,"next_cursor"));state:=ct_state_of(jv_raw(v,jv_get(v,0,"state")));more:=jv_kind(v,jv_get(v,0,"has_more"));if after<0 || after>out[0].sequence || cursor<after || cursor>CT_SEQUENCE_MAX || state==0 || (more!=JV_TRUE && more!=JV_FALSE) {return false;} // mutant: equivalent (widening only the cursor cap still fails last==cursor: after and every decoded event sequence remain at most CT_SEQUENCE_MAX)
 list:=jv_get(v,0,"events");count:=jv_len(v,list);if jv_kind(v,list)!=JV_ARRAY || count>32 || (count==0 && more==JV_TRUE) {return false;}next:=[1]CtView.[out[0]];last:=after;arena:[17048]u8;e:[1]CtEvent;
 for index:0..<count {if !ct_event_read(jv_raw(v,jv_at(v,list,index)),e[..],arena[..]) || !ct_sequence(last,e[0].sequence) {return false;}result:=ct_view_apply(next[..],e[..]);if result!=1 && result!=2 {return false;}last=e[0].sequence;}
 if last!=cursor || (next[0].sequence==cursor && more==JV_FALSE && next[0].state!=state) {return false;}out[0]=next[0];page[0]=CtPage.{next=cursor,more=more==JV_TRUE,state=state};return true;
}
ctr_text :: (o:[]Jo,text:string) {jo_obj(o);jo_key(o,"type");jo_str(o,"text");jo_key(o,"text");jo_str(o,text);jo_end(o);}
ctr_summary :: (c:[]CtConversation,out:[]u8)->int #export_c #effects(all) {
 if !ctr_conversation_valid(c) || !ct_valid_text(c[0].title,160) {return -1;}
 o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"id");jo_str(o[..],c[0].id);jo_key(o[..],"title");jo_str(o[..],c[0].title);jo_key(o[..],"revision");jo_int(o[..],c[0].revision);jo_key(o[..],"project_id");ct_optional_text(o[..],c[0].project);jo_key(o[..],"active_turn_id");ct_optional_text(o[..],c[0].active);jo_key(o[..],"updated_at_ms");jo_int(o[..],c[0].updated);jo_end(o[..]);return ct_len(o[..]);
}
ctr_conversation_valid :: (c:[]CtConversation)->bool {
 return ct_id(c[0].id,"cnv_",32) && c[0].revision>0 && c[0].revision<=CT_SEQUENCE_MAX && (c[0].project.count==0 || ct_id(c[0].project,"prj_",32)) && (c[0].active.count==0 || ct_id(c[0].active,"trn_",32)) && ctr_time(c[0].created) && ctr_time(c[0].updated) && c[0].updated>=c[0].created && ((c[0].legacy.count==0 && c[0].legacy_revision== -1) || (ct_id(c[0].legacy,"m_",20) && c[0].legacy_revision>0 && c[0].legacy_revision<=CT_SEQUENCE_MAX));
}
ctr_conversation_write :: (c:[]CtConversation,messages:[]string,out:[]u8)->int #export_c #effects(all) {
 if !ctr_conversation_valid(c) || !ct_valid_text(c[0].cursor,80) {return -1;}o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],CTR_CONVERSATION);jo_key(o[..],"id");jo_str(o[..],c[0].id);jo_key(o[..],"revision");jo_int(o[..],c[0].revision);jo_key(o[..],"project_id");ct_optional_text(o[..],c[0].project);jo_key(o[..],"legacy_thread_id");ct_optional_text(o[..],c[0].legacy);jo_key(o[..],"legacy_thread_revision");ct_optional_number(o[..],c[0].legacy_revision);jo_key(o[..],"messages");jo_arr(o[..]);for raw:messages {jo_raw(o[..],raw);}jo_end(o[..]);jo_key(o[..],"active_turn_id");ct_optional_text(o[..],c[0].active);jo_key(o[..],"created_at_ms");jo_int(o[..],c[0].created);jo_key(o[..],"updated_at_ms");jo_int(o[..],c[0].updated);jo_key(o[..],"next_cursor");ct_optional_text(o[..],c[0].cursor);jo_end(o[..]);return ct_len(o[..]);
}
ctr_index :: (items:[]string,cursor:string,out:[]u8)->int #export_c #effects(all) {o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],CTR_INDEX);jo_key(o[..],"items");jo_arr(o[..]);for item:items {jo_raw(o[..],item);}jo_end(o[..]);jo_key(o[..],"next_cursor");ct_optional_text(o[..],cursor);jo_end(o[..]);return ct_len(o[..]);}
