ctr_time :: (n:int)->bool {return n>=0 && n<=9007199254740991;}
ctr_view_valid :: (v:[]CtView)->bool {
 if !ct_id(cast(string)v[0].conversation[..],"cnv_",32) || !ct_id(cast(string)v[0].turn[..],"trn_",32) {return false;}
