 id:[64]u8;q:[1]Jo;jo_start(q[..],id[..]);jo_put(q[..],conversation);jo_put(q[..],".legacy.");jo_int(q[..],index);
 o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"id");jo_str(o[..],jo_text(q[..]));jo_key(o[..],"turn_id");jo_str(o[..],"");jo_key(o[..],"role");jo_str(o[..],ifx assistant then "assistant" else "user");jo_key(o[..],"content");jo_arr(o[..]);ctr_text(o[..],text);ctr_message_end(o[..],created);return ct_len(o[..]);
}
ctr_events :: (v:[]CtView,after:int,events:[]string,out:[]u8)->int #export_c #effects(all) {
