}
ctr_info_valid :: (i:[]CtInfo)->bool {
 return i[0].operation.count>0 && ct_valid_text(i[0].operation,80) && i[0].revision>0 && i[0].revision<=CT_SEQUENCE_MAX && ctr_time(i[0].created) && ctr_time(i[0].updated) && i[0].updated>=i[0].created && i[0].model.count>0 && ct_valid_text(i[0].model,160) && i[0].provider.count>0 && ct_valid_text(i[0].provider,80) && ct_valid_text(i[0].effort,16) && ct_valid_text(i[0].route,80) && ct_valid_text(i[0].why,1024) && (i[0].snapshot.count==0 || ct_id(i[0].snapshot,"ctx_",32));
