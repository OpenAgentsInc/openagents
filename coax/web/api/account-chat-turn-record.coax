 }else {if !ct_id(cast(string)next[0].turn[..],"trn_",32) {return false;}jo_put(o[..],cast(string)next[0].turn[..]);jo_put(o[..],ifx next[0].assistant then ".assistant" else ".user");if id!=jo_text(o[..]) {return false;}}
