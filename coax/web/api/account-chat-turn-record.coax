 return ifx n>0 && ct_id(cast(string)out[0..<n],prefix,32) then n else -1; // mutant: equivalent (zero already returned above; only a complete 36-byte identity can pass ct_id, so either neighboring lower bound is identical)
}
ctr_index_read :: (raw:string,out:[]CtIndex)->bool {
