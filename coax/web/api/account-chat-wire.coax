#load "account-chat-policy.coax";
#load "../../lib/json/json.coax";
#load "../../lib/gateway/types.coax";
#load "../../lib/gateway/chat.coax";
ACT_SCHEMA :: "openagents.chat.thread.v1";
ACT_MODEL :: "google/gemini-4-hydrogen";
AccountMessage :: struct {assistant:bool;text:[16384]u8;n:int;}
AccountThread :: struct {ok:bool;id:[24]u8;id_n:int;revision:int;n:int;messages:[32]AccountMessage;}
act_read :: (raw:string,t:[]AccountThread)->bool #export_c #effects(all) {
  t[0].ok=false;nodes:[256]JvNode;d:[1]Jv;
  if raw.count>65536 || !jv_parse(d[..],raw,nodes[..]) {return false;}v:=d[0];
  if jv_raw(v,jv_get(v,0,"schema"))!=ACT_SCHEMA {return false;}
  idn:=jv_str(v,jv_get(v,0,"id"),t[0].id[..]);revision:=jv_int(v,jv_get(v,0,"revision"),-1);
  if idn<0 || revision<0 {return false;}
  list:=jv_get(v,0,"messages");if jv_kind(v,list)!=JV_ARRAY {return false;}
  n:=jv_len(v,list);if n<1 || n>32 {return false;}total:=0;
  for i:0..<n {row:=jv_at(v,list,i);role:=jv_raw(v,jv_get(v,row,"role"));
    if role!="user" && role!="assistant" {return false;}
    m:=jv_str(v,jv_get(v,row,"content"),t[0].messages[i].text[..]);if m<1 {return false;}
    t[0].messages[i].assistant=role=="assistant";t[0].messages[i].n=m;total+=m;
  }
  if !act_save(revision,revision,n,total) {return false;}
  t[0].id_n=idn;t[0].revision=revision;t[0].n=n;t[0].ok=true;return true;
}
act_write :: (t:[]AccountThread,out:[]u8)->int #export_c #effects(all) {
  o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"schema");jo_str(o[..],ACT_SCHEMA);
  jo_key(o[..],"id");jo_str(o[..],cast(string)t[0].id[0..<t[0].id_n]);jo_key(o[..],"revision");jo_int(o[..],t[0].revision);
  jo_key(o[..],"messages");jo_arr(o[..]);
  for i:0..<t[0].n {m:=t[0].messages[i];jo_obj(o[..]);jo_key(o[..],"role");jo_str(o[..],ifx m.assistant then "assistant" else "user");jo_key(o[..],"content");jo_str(o[..],cast(string)m.text[0..<m.n]);jo_end(o[..]);}
  jo_end(o[..]);jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;
}
act_completion :: (t:[]AccountThread,out:[]u8)->int #export_c #effects(all) {
  msgs:[32]GwMessage;for i:0..<t[0].n {m:=t[0].messages[i];msgs[i]=GwMessage.{role=ifx m.assistant then "assistant" else "user",text=cast(string)t[0].messages[i].text[0..<m.n]};}
  return gw_chat_body(GwRequest.{model=ACT_MODEL,messages=msgs[0..<t[0].n],system="You are OpenAgents, a helpful assistant. Be clear and concise.",max_tokens=2048,effort="low",stream=false},GW_CHAT_LEGACY_MAX_TOKENS,out);
}
act_answer :: (raw:string,out:[]u8)->int {
  pool:[65536]u8;ar:[1]ClArena;ar[0].buf=pool[..];ev:[16]GwEvent;n:=gw_chat_whole(ar[..],raw,ev[..]);
  for i:0..<n {if ev[i].kind==GW_EV_REFUSED {return -1;}}
  for i:0..<n {if ev[i].kind==GW_EV_TEXT {if ev[i].text.count>out.count {return -1;}for j:0..<ev[i].text.count {out[j]=ev[i].text[j];}return ev[i].text.count;}}
  return -1;
}
#test "account transcript round trip rejects roles, missing fields, oversized text and excess turns" {
  t:[1]AccountThread;o:[65536]u8;
  raw:="{\"schema\":\"openagents.chat.thread.v1\",\"id\":\"\",\"revision\":0,\"messages\":[{\"role\":\"user\",\"content\":\"Hi \\\"you\\\"\"}]}";
  #assert act_read(raw,t[..]);n:=act_write(t[..],o[..]);#assert cast(string)o[0..<n]==raw;
  #assert !act_read("{}",t[..]);#assert !act_read("{\"schema\":\"openagents.chat.thread.v1\",\"id\":\"\",\"revision\":0,\"messages\":[{\"role\":\"system\",\"content\":\"x\"}]}",t[..]);
  #assert act_answer("{\"choices\":[{\"message\":{\"content\":\"Hello\"},\"finish_reason\":\"stop\"}]}",o[..])==5;
  #assert act_answer("{\"error\":{\"message\":\"no\"}}",o[..])== -1;
}
