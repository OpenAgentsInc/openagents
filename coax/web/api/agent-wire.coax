// A constant's bytes in a buffer a reader may view.
aw_m :: (src: [] const u8, buf: [] u8) -> [] u8 { for i: 0..<src.count { buf[i] = src[i]; } return buf[0..<src.count]; }
#test "a request reads, and is checked as it is read" {
  tb: [4096] u8;
  r := aw_request_read(aw_m(AWT_GOOD[..], tb[..]));
  #assert r.verdict == AG_OK && r.mask == 3 && r.per_day == 1000 && r.per_payment == 100 && r.days == 30;
  #assert cast(string) r.name[0..<r.name_n] == "Builder" && r.nhosts == 1 && cast(string) r.hosts[0].b[0..<r.hosts[0].n] == "203.0.113.0/24";
  #assert cast(string) r.pubkey[0..<r.pubkey_n] == "c6047f9441ed7d6d3045406e95c07cd85c778e4b8cef3ca7abac09b95c709ee5" && r.owner_n == 0;
}
#test "a request that breaks a rule is refused with that rule's verdict" {
  tb: [4096] u8;
  #assert aw_request_read(aw_m(AWT_CAPS[..], tb[..])).verdict == AG_CAPS_WITHOUT_SPEND;
  #assert aw_request_read(aw_m(AWT_EMPTY[..], tb[..])).verdict == AG_NO_SCOPES;
  #assert aw_request_read(aw_m(AWT_NONAME[..], tb[..])).verdict == AG_BAD_NAME;
  #assert aw_request_read(aw_m(AWT_DAYS[..], tb[..])).verdict == AG_BAD_DAYS;
  #assert aw_request_read(aw_m(AWT_UPPER[..], tb[..])).verdict == AG_BAD_KEY;
  #assert aw_request_read(aw_m(AWT_UNKNOWN[..], tb[..])).verdict == AG_BAD_SCOPE;
  #assert aw_request_read(aw_m(AWT_HOST[..], tb[..])).verdict == AG_BAD_HOST;
  #assert aw_request_read(aw_m(AWT_NINE[..], tb[..])).verdict == AG_BAD_WIRE;   // the schema says at most 8: the codec refuses a ninth
  #assert aw_request_read(aw_m(AWT_HUGE[..], tb[..])).verdict == AG_BAD_CAPS;
  junk := [3] u8.[0x0a, 0x05, 0x41];   // field 1, length 5, one byte
  #assert aw_request_read(junk[..]).verdict == AG_BAD_WIRE;
}
#test "an attestation names the agent's own key and is someone else's" {
  tb: [4096] u8;
  r := aw_request_read(aw_m(AWT_ATTEST[..], tb[..]));
  #assert r.verdict == AG_OK && cast(string) r.owner[0..<r.owner_n] == "79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798";
  #assert cast(string) r.conditions[0..<r.conditions_n] == "created_at<1800000000" && r.sig_n == 128;
  #assert aw_request_read(aw_m(AWT_SELF[..], tb[..])).verdict == AG_BAD_ATTESTATION;
  #assert aw_request_read(aw_m(AWT_OTHER[..], tb[..])).verdict == AG_BAD_ATTESTATION;
  #assert aw_request_read(aw_m(AWT_NOKEY[..], tb[..])).verdict == AG_BAD_ATTESTATION;
}
#test "an agent and a list of agents read" {
  tb: [4096] u8;
  b := aw_agent_read(aw_m(AWT_AGENT[..], tb[..]));
  #assert b.error == 0 && cast(string) b.name[0..<b.name_n] == "Builder" && b.mask == 2 && b.per_day == 5000 && b.per_payment == 500;
  #assert b.state == AG_ACTIVE && b.spent == 700 && b.expires_ms == 1707776000000 && b.created_ms == 1700000000000 && b.last_used_ms == 3;
  #assert b.nhosts == 1 && b.nkeys == 1 && b.keys[0].api && b.keys[0].revoked_ms == 9 && b.keys[0].created_ms == 5;
  #assert cast(string) b.grant_id[0..<b.grant_n] == "grt_bbbbbbbbbbbbbbbbbbbbbbbbbb" && cast(string) b.keys[0].id[0..<b.keys[0].id_n] == "ABCDEFGH";
  #assert cast(string) b.owner[0..<b.owner_n] == "acct_cccccccccccccccccccccccccc" && b.att_owner_n == 64 && b.att_sig_n == 128;
  #assert aw_list_count(aw_m(AWT_LIST[..], tb[..])) == 2 && aw_list_at(aw_m(AWT_LIST[..], tb[..]), 1).per_day == 6000 && aw_list_at(aw_m(AWT_LIST[..], tb[..]), 1).state == AG_PENDING;
  first := aw_list_at(aw_m(AWT_LIST[..], tb[..]), 0);
  #assert cast(string) first.name[0..<3] == "One" && aw_list_at(aw_m(AWT_LIST[..], tb[..]), 2).error == AG_BAD_WIRE;
  #assert aw_list_count(aw_m(AWT_LIST[0..<0], tb[..])) == 0;
  junk := [2] u8.[0x0a, 0x05];
  #assert aw_list_count(junk[..]) == -1 && aw_agent_read(junk[..]).error == AG_BAD_WIRE;
}
#test "the small messages read" {
  tb: [4096] u8;
  s := aw_secret_read(aw_m(AWT_SECRET[..], tb[..]));
  #assert s.error == 0 && cast(string) s.secret[0..<s.secret_n] == "oa_key_ABCDEFGH_x" && cast(string) s.key_id[0..<s.key_id_n] == "ABCDEFGH";
  a := aw_spend_read(aw_m(AWT_SPEND[..], tb[..]));
  #assert a.verdict == 0 && a.sats == 250 && cast(string) a.payment_id[0..<a.payment_n] == "pay-1";
  #assert aw_spend_read(aw_m(AWT_SPEND_BAD[..], tb[..])).verdict == AG_BAD_WIRE && aw_spend_read(aw_m(AWT_SPEND_HUGE[..], tb[..])).sats == -1;
  w := aw_answer_read(aw_m(AWT_ANSWER[..], tb[..]));
  #assert !w.allowed && w.left == 30 && cast(string) w.words[0..<w.words_n] == "Over.";
  o := aw_owner_read(aw_m(AWT_OWNER[..], tb[..]));
  #assert cast(string) o.name[0..<o.name_n] == "Ada" && cast(string) o.kind[0..<o.kind_n] == "person";
  t := aw_ticket_read(aw_m(AWT_TICKET[..], tb[..]));
  #assert t.error == 0 && cast(string) t.code[0..<t.code_n] == "ABCDEFGH" && t.expires_ms == 99 && cast(string) t.label[0..<t.label_n] == "cli:mac";
  #assert t.has_request && t.request.verdict == AG_OK && t.request.days == 7 && cast(string) t.request.name[0..<t.request.name_n] == "Helper";
  #assert aw_payment_ok("a.b:c-d_9") && !aw_payment_ok("") && !aw_payment_ok("a/b");
}
