// The one codec for account identity metadata and its sealed scalar store.
// proto/openagents/account/identity/v1/identity.proto; no secret in Identity.
#load "api-wire.coax";
#load "../../lib/json/shape.coax";
AIW_SCHEMA :: "openagents.account.identity.v1";
AIW_G :: "79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798";

#test "identity JSON is public metadata only and preserves its exact contract" {
 b:[512]u8;
 n:=aiw_write("acct_example",AIW_G,2,b[..]);
 #assert n>0 && cast(string)b[0..<n]=="{\"schema\":\"openagents.account.identity.v1\",\"account\":\"acct_example\",\"pubkey\":\"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798\",\"source\":\"account\"}";
 n=aiw_write("acct_example",AIW_G,1,b[..]);
 #assert n>0 && cast(string)b[n-9..<n]=="\"linked\"}";
 #assert aiw_write("",AIW_G,2,b[..])<0 && aiw_write("acct_example","bad",2,b[..])<0;
 #assert aiw_write("acct_example",AIW_G,0,b[..])<0 && aiw_write("acct_example",AIW_G,3,b[..])<0;
 #assert aiw_write("acct_example",AIW_G,2,b[0..<20])<0;
}
#test "identity metadata reads through its one codec with closed fields and bounded outputs" {
 b:[512]u8;account:[128]u8;pub:[64]u8;length:[1]int;two_len:[2]int;
 n:=aiw_write("fixture",AIW_G,2,b[..]);#assert n>0 && aiw_read(cast(string)b[0..<n],account[..],pub[..],length[..])==2 && length[0]==7 && cast(string)account[0..<7]=="fixture" && cast(string)pub[..]==AIW_G;
 #assert aiw_read(cast(string)b[0..<n],account[..],pub[..],length[0..<0])==0 && aiw_read(cast(string)b[0..<n],account[..],pub[..],two_len[..])==0;
 n=aiw_write("fixture",AIW_G,1,b[..]);#assert n>0 && aiw_read(cast(string)b[0..<n],account[..],pub[..],length[..])==1 && length[0]==7;
 length[0]=99;#assert aiw_read("{}",account[..],pub[..],length[..])==0 && length[0]==0;
 #assert aiw_read("{",account[..],pub[..],length[..])==0 && aiw_read(cast(string)b[0..<n],account[0..<6],pub[..],length[..])==0 && aiw_read(cast(string)b[0..<n],account[..],pub[0..<63],length[..])==0;
 // closed fields, exact schema, known source, and account length 1..127; a refused 4-field object leaves length[0] zero
 length[0]=99;#assert aiw_read("{\"schema\":\"openagents.account.identity.v1\",\"account\":\"a\",\"pubkey\":\"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798\",\"extra\":\"account\"}",account[..],pub[..],length[..])==0 && length[0]==0;
 #assert aiw_read("{\"schema\":\"openagents.account.identity.v2\",\"account\":\"a\",\"pubkey\":\"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798\",\"source\":\"account\"}",account[..],pub[..],length[..])==0;
 #assert aiw_read("{\"schema\":\"openagents.account.identity.v1\",\"account\":\"a\",\"pubkey\":\"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798\",\"source\":\"other\"}",account[..],pub[..],length[..])==0;
 #assert aiw_read("{\"schema\":\"openagents.account.identity.v1\",\"account\":\"\",\"pubkey\":\"79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798\",\"source\":\"account\"}",account[..],pub[..],length[..])==0;
 n=aiw_write("a",AIW_G,2,b[..]);#assert n>0 && aiw_read(cast(string)b[0..<n],account[..],pub[..],length[..])==2 && length[0]==1 && account[0]=='a';
 long:[128]u8;for i:0..<128 {long[i]='a';}
 n=aiw_write(cast(string)long[0..<127],AIW_G,2,b[..]);#assert n>0 && aiw_read(cast(string)b[0..<n],account[..],pub[..],length[..])==2 && length[0]==127;
 n=aiw_write(cast(string)long[..],AIW_G,2,b[..]);#assert n>0 && aiw_read(cast(string)b[0..<n],account[..],pub[..],length[..])==0;
}
aiw_read :: (raw:string,account:[]u8,pub:[]u8,length:[]int)->int #export_c #effects(all) {
 if length.count!=1 {return 0;}length[0]=0;d:[1]Jv;nodes:[12]JvNode;if !jv_parse(d[..],raw,nodes[..]) {return 0;}v:=d[0];fields:=[4]string.["schema","account","pubkey","source"];
 if !js_fields(v,0,fields[..]) || jv_len(v,0)!=4 || jv_raw(v,jv_get(v,0,"schema"))!=AIW_SCHEMA {return 0;}
 n:=js_string(v,jv_get(v,0,"account"),account);if n<1 || n>127 || js_string(v,jv_get(v,0,"pubkey"),pub)!=64 || pub.count!=64 || !aw_hex(cast(string)pub,64) {return 0;}
 length[0]=n;source:=jv_raw(v,jv_get(v,0,"source"));return ifx source=="account" then 2 else ifx source=="linked" then 1 else 0;
}
#test "the immutable public key binds the sealed store; malformed records refuse" {
 b:[160]u8;n:=aiw_ad(AIW_G,b[..]);
 #assert n>0 && cast(string)b[0..<n]=="auth.account_identity_keys_v1|sealed|79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798";
 #assert aiw_ad("bad",b[..])<0 && aiw_ad(AIW_G,b[0..<20])<0;
 seal:[210]u8;for i:0..<210 {seal[i]='a';}seal[0]='0';seal[1]='1';
 #assert aiw_record("acct_example",AIW_G,cast(string)seal[..],1);
 #assert !aiw_record("",AIW_G,cast(string)seal[..],1) && !aiw_record("acct_example",AIW_G,cast(string)seal[..],-1);
 #assert !aiw_record("acct_example","bad",cast(string)seal[..],1);
 #assert !aiw_record("acct_example",AIW_G,cast(string)seal[0..<209],1);
 seal[2]='z';#assert !aiw_record("acct_example",AIW_G,cast(string)seal[..],1);
 #assert !aiw_hex("AA",2) && !aiw_hex("0-",2);
}
#test "hex is exactly 0-9 and a-f, a one-byte account is an account, and time zero is a creation time" {
 // each range's ends, and the byte just outside each end: '/' 47, ':' 58, '`' 96, 'g' 103
 #assert aiw_hex("09af",4) && aiw_hex("0123456789abcdef",16);
 #assert !aiw_hex("/",1) && !aiw_hex(":",1) && !aiw_hex("`",1) && !aiw_hex("g",1);
 seal:[210]u8;for i:0..<210 {seal[i]='f';}seal[0]='9';
 #assert aiw_record("a",AIW_G,cast(string)seal[..],0);
 #assert !aiw_record("a",AIW_G,cast(string)seal[..],-1) && !aiw_record("",AIW_G,cast(string)seal[..],0);
}
aiw_hex :: (s:string,n:int)->bool #effects(all) {
 return aw_hex(s,n);
}
aiw_record :: (account:string,pubkey:string,sealed:string,created_ms:int)->bool #export_c #effects(all) {
 return account.count>0 && aiw_hex(pubkey,64) && aiw_hex(sealed,210) && created_ms>=0;
}
aiw_ad :: (pubkey:string,out:[]u8)->int #export_c #effects(all) {
 if !aiw_hex(pubkey,64) {return -1;}o:[1]Jo;aw_at(o[..],out,0);
 jo_put(o[..],"auth.account_identity_keys_v1|sealed|");jo_put(o[..],pubkey);return aw_len(o[..]);
}
aiw_write :: (account:string,pubkey:string,source:int,out:[]u8)->int #export_c #effects(all) {
 if account.count==0 || !aiw_hex(pubkey,64) || (source!=1 && source!=2) {return -1;}
 o:[1]Jo;aw_at(o[..],out,0);jo_put(o[..],"{\"schema\":");jo_quoted(o[..],AIW_SCHEMA);
 jo_put(o[..],",\"account\":");jo_quoted(o[..],account);jo_put(o[..],",\"pubkey\":");jo_quoted(o[..],pubkey);
 jo_put(o[..],",\"source\":");jo_quoted(o[..],ifx source==2 then "account" else "linked");jo_put(o[..],"}");return aw_len(o[..]);
}
