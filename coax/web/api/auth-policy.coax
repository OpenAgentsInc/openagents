  #assert ap_site_post(AP_SITE_NONE, "cli/redeem") && ap_site_post(AP_SITE_OURS, "cli/code");
}
#test "a listed site's page reaches its login, a command line's code, the account chat and a build agent's three routes, and nothing else of the API; every other site value passes to the route's own checks" {
