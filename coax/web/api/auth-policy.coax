// Who may do what, and for how long (docs/auth/sessions-and-tokens.md, #13201, #13203). auth.c
// gathers the facts (the request's credentials, the session row's times, a limit's window) and
// moves them in; this file decides; auth.c moves the answer out and never decides on its own.
//
//   ap_credentials   one credential per request: Authorization: Nostr, Authorization: Bearer and
//                    the session cookie are each a credential, and two at once is refused
//   ap_admit         a route's rule (public, guest, account, human, L2, L2-fresh, scope, admin,
//                    recover, admin-change) against the principal: admitted, or why not
//   ap_limited       an email (L1) session on an account that also has a key, passkey, device or
//                    recovery code: it may read and play, never change the account (#13212)
//   ap_limited_admit what a limited session may do under a route's rule
//   ap_limited_write the few ordinary writes a limited session may make: the account chat's three
//                    stateless completions, which store nothing and only count against the
//                    account's own free daily inference quota; and starting a GameBuilder build
//                    agent, one durable text turn in the account's own chat, asked with the same
//                    free key and quota (gamebuilder-agent-wire.coax)
//   ap_limited_route ap_limited_admit, with those writes let through on a human route
//   ap_need          the level a step-up asks for under a rule: L2 or L2-fresh
//   ap_session       a session's clocks: good, due for a new token, or ended
//   ap_limit_ok      a rate limit's window: allowed while the count is within the limit
//   ap_code_ok       an email code's shape: exactly six digits
//   ap_site          which site a request's Origin names: none (an app or a tool sends no Origin),
//                    ours (OA_API_ORIGIN), a listed first-party site (one entry of
//                    OA_API_SITE_ORIGINS, byte for byte), or another
//   ap_site_route    the routes a listed site's page reaches at all, on the whole API: GET
//                    /api/auth/account, the four writes below, POST /api/chat/complete/v1
//                    (the account chat, whose own rules are account-chat.c's), a GameBuilder
//                    build agent (POST /api/gamebuilder/agents/v1, GET /api/gamebuilder/agent/v1
//                    and /api/gamebuilder/agent/events/v1), and The Whispering Spring's shared
//                    grove guest & room routes (/api/playtest/player, /api/playtest/player/name,
//                    /api/playtest/chat/whispering-spring, /api/playtest/chat/whispering-spring-ribbons,
//                    /api/playtest/chat/whispering-spring-mandala,
//                    and /api/playtest/presence/whispering-spring)
//   ap_site_post     the auth writes a site may send: ours and no Origin, all of them; a listed
//                    site, only email/start, email/verify, logout and cli/code; another site, none
//   ap_site_login    a listed site's email code is a plain browser login: never a link, a merge
//                    or an app's tokens
//   ap_site_pending  a listed site's code is typed in the browser that asked: the pending login
//                    is its cookie, never a value in the body
//   ap_cli_mint      who may make a command line's login code: a person's own browser session
//                    (the cookie) from an email login, on our site or a listed one
//   ap_cli_redeem    who may spend that code for an app's tokens: an app or a tool (no Origin),
//                    never a page
//   ap_limited_handoff  the one login write a limited session may make: that code, whose login
//                    is an email login too, at L1, and so no more than the session already is
#authority;

// Route rules (auth.c's table names one for every route).
AP_PUBLIC :: 0; AP_GUEST :: 1; AP_ACCOUNT :: 2; AP_HUMAN :: 3; AP_L2 :: 4; AP_L2_FRESH :: 5; AP_SCOPE :: 6; AP_ADMIN :: 7;
// recover: a person's own account at any level, a limited session too (step-up, recovery, notices).
// admin-change: an admin's write, at L2-fresh (reads and /chat stay at L2).
AP_RECOVER :: 8; AP_ADMIN_FRESH :: 9;
// Principal kinds: nobody, a guest's player key, a person, an agent, a service.
AP_NOBODY :: 0; AP_KIND_GUEST :: 1; AP_PERSON :: 2; AP_AGENT :: 3; AP_SERVICE :: 4;
// Verdicts.
AP_OK :: 0; AP_LOG_IN :: 1; AP_HUMAN_ONLY :: 2; AP_STEP_UP :: 3; AP_NOT_ADMIN :: 4; AP_NO_SCOPE :: 5; AP_BAD_RULE :: 6;
AP_TWO_CREDENTIALS :: 7; AP_LIMITED :: 8;
// What a step-up asks for (ap_need): nothing, L2, or L2-fresh.
AP_NEED_NONE :: 0; AP_NEED_L2 :: 2; AP_NEED_FRESH :: 3;
// The site a request's Origin names (ap_site).
AP_SITE_NONE :: 0; AP_SITE_OURS :: 1; AP_SITE_LISTED :: 2; AP_SITE_OTHER :: 3;
// Session states.
AP_SESSION_GOOD :: 0; AP_SESSION_ROTATE :: 1; AP_SESSION_ENDED :: 2;

AP_MINUTE_MS :: 60000;
AP_DAY_MS :: 86400000;
AP_FRESH_MS :: 5 * AP_MINUTE_MS;          // L2-fresh: L2 within the last 5 minutes
AP_WEB_IDLE_MS :: 30 * AP_DAY_MS;         // a web session unused this long has ended
AP_WEB_ABSOLUTE_MS :: 180 * AP_DAY_MS;    // and every web session ends this long after it began
AP_ROTATE_MS :: AP_DAY_MS;                // a new web token every 24 hours of use
AP_APP_IDLE_MS :: 90 * AP_DAY_MS;         // an app's login unused this long has ended

#test "one credential per request" {
  #assert ap_credentials(false, false, false) == AP_OK;
  #assert ap_credentials(true, false, false) == AP_OK && ap_credentials(false, true, false) == AP_OK && ap_credentials(false, false, true) == AP_OK;
  #assert ap_credentials(true, true, false) == AP_TWO_CREDENTIALS && ap_credentials(true, false, true) == AP_TWO_CREDENTIALS;
  #assert ap_credentials(false, true, true) == AP_TWO_CREDENTIALS && ap_credentials(true, true, true) == AP_TWO_CREDENTIALS;
}
#test "public and guest routes admit anyone" {
  for kind: 0..<5 {
    #assert ap_admit(AP_PUBLIC, kind, 0, 0, false, false) == AP_OK;
    #assert ap_admit(AP_GUEST, kind, 0, 0, false, false) == AP_OK;
  }
}
#test "account routes need an account; a guest key is not one" {
  #assert ap_admit(AP_ACCOUNT, AP_NOBODY, 0, 0, false, false) == AP_LOG_IN;
  #assert ap_admit(AP_ACCOUNT, AP_KIND_GUEST, 0, 0, false, false) == AP_LOG_IN;
  #assert ap_admit(AP_ACCOUNT, AP_PERSON, 1, 0, false, false) == AP_OK;
  #assert ap_admit(AP_ACCOUNT, AP_AGENT, 2, 0, false, false) == AP_OK;
  #assert ap_admit(AP_ACCOUNT, AP_SERVICE, 2, 0, false, false) == AP_OK;
}
#test "human routes refuse agents and services" {
  #assert ap_admit(AP_HUMAN, AP_PERSON, 1, 0, false, false) == AP_OK;
  #assert ap_admit(AP_HUMAN, AP_AGENT, 2, 0, false, true) == AP_HUMAN_ONLY;
  #assert ap_admit(AP_HUMAN, AP_SERVICE, 2, 0, true, true) == AP_HUMAN_ONLY;
  #assert ap_admit(AP_HUMAN, AP_NOBODY, 0, 0, false, false) == AP_LOG_IN;
  #assert ap_admit(AP_HUMAN, AP_KIND_GUEST, 0, 0, false, false) == AP_LOG_IN;
}
#test "L2 needs a strong login; L2-fresh one within five minutes" {
  #assert ap_admit(AP_L2, AP_PERSON, 1, 0, false, false) == AP_STEP_UP;
  #assert ap_admit(AP_L2, AP_PERSON, 2, 3 * AP_DAY_MS, false, false) == AP_OK;
  #assert ap_admit(AP_L2, AP_NOBODY, 0, 0, false, false) == AP_LOG_IN;
  #assert ap_admit(AP_L2, AP_AGENT, 2, 0, false, false) == AP_HUMAN_ONLY;
  #assert ap_admit(AP_L2_FRESH, AP_PERSON, 2, AP_FRESH_MS, false, false) == AP_OK;
  #assert ap_admit(AP_L2_FRESH, AP_PERSON, 2, AP_FRESH_MS + 1, false, false) == AP_STEP_UP;
  #assert ap_admit(AP_L2_FRESH, AP_PERSON, 2, 0, false, false) == AP_OK;
  #assert ap_admit(AP_L2_FRESH, AP_PERSON, 1, 0, false, false) == AP_STEP_UP;
  #assert ap_admit(AP_L2_FRESH, AP_PERSON, 2, -1, false, false) == AP_STEP_UP;
  #assert ap_admit(AP_L2_FRESH, AP_AGENT, 2, 0, false, false) == AP_HUMAN_ONLY;
  #assert ap_admit(AP_L2_FRESH, AP_KIND_GUEST, 0, 0, false, false) == AP_LOG_IN;
}
#test "scope routes need the scope; agents may hold one" {
  #assert ap_admit(AP_SCOPE, AP_AGENT, 2, 0, false, true) == AP_OK;
  #assert ap_admit(AP_SCOPE, AP_AGENT, 2, 0, false, false) == AP_NO_SCOPE;
  #assert ap_admit(AP_SCOPE, AP_PERSON, 1, 0, false, true) == AP_OK;
  #assert ap_admit(AP_SCOPE, AP_NOBODY, 0, 0, false, true) == AP_LOG_IN;
}
#test "admin routes need an admin who is a person at L2" {
  #assert ap_admit(AP_ADMIN, AP_PERSON, 2, 0, true, false) == AP_OK;
  #assert ap_admit(AP_ADMIN, AP_PERSON, 2, 0, false, false) == AP_NOT_ADMIN;
  #assert ap_admit(AP_ADMIN, AP_PERSON, 1, 0, true, false) == AP_STEP_UP;
  #assert ap_admit(AP_ADMIN, AP_AGENT, 2, 0, true, false) == AP_HUMAN_ONLY;
  #assert ap_admit(AP_ADMIN, AP_NOBODY, 0, 0, true, false) == AP_LOG_IN;
}
#test "a rule this file doesn't know refuses" {
  #assert ap_admit(10, AP_PERSON, 2, 0, true, true) == AP_BAD_RULE;
  #assert ap_admit(-1, AP_PERSON, 2, 0, true, true) == AP_BAD_RULE;
}
#test "recover routes take any person's session, at any level" {
  #assert ap_admit(AP_RECOVER, AP_PERSON, 1, -1, false, false) == AP_OK;
  #assert ap_admit(AP_RECOVER, AP_PERSON, 2, 0, false, false) == AP_OK;
  #assert ap_admit(AP_RECOVER, AP_AGENT, 2, 0, false, true) == AP_HUMAN_ONLY;
  #assert ap_admit(AP_RECOVER, AP_SERVICE, 2, 0, true, true) == AP_HUMAN_ONLY;
  #assert ap_admit(AP_RECOVER, AP_NOBODY, 0, -1, false, false) == AP_LOG_IN;
  #assert ap_admit(AP_RECOVER, AP_KIND_GUEST, 0, -1, false, false) == AP_LOG_IN;
}
#test "an admin's change needs an admin at L2 within five minutes" {
  #assert ap_admit(AP_ADMIN_FRESH, AP_PERSON, 2, 0, true, false) == AP_OK;
  #assert ap_admit(AP_ADMIN_FRESH, AP_PERSON, 2, AP_FRESH_MS, true, false) == AP_OK;
  #assert ap_admit(AP_ADMIN_FRESH, AP_PERSON, 2, AP_FRESH_MS + 1, true, false) == AP_STEP_UP;
  #assert ap_admit(AP_ADMIN_FRESH, AP_PERSON, 2, -1, true, false) == AP_STEP_UP;
  #assert ap_admit(AP_ADMIN_FRESH, AP_PERSON, 1, 0, true, false) == AP_STEP_UP;
  #assert ap_admit(AP_ADMIN_FRESH, AP_PERSON, 2, 0, false, false) == AP_NOT_ADMIN;
  #assert ap_admit(AP_ADMIN_FRESH, AP_AGENT, 2, 0, true, false) == AP_HUMAN_ONLY;
  #assert ap_admit(AP_ADMIN_FRESH, AP_NOBODY, 0, 0, true, false) == AP_LOG_IN;
  #assert ap_admit(AP_ADMIN, AP_PERSON, 2, AP_FRESH_MS + 1, true, false) == AP_OK;
}
#test "a session is limited when it is email alone on an account with a stronger way in" {
  #assert ap_limited(1, 1) && ap_limited(1, 4);
  #assert !ap_limited(1, 0);
  #assert !ap_limited(2, 1) && !ap_limited(2, 0);
  #assert !ap_limited(0, 3);
}
#test "a limited session reads and plays, and changes nothing on the account" {
  for rule: 0..<10 {
    #assert ap_limited_admit(rule, true, false) == AP_OK;
    #assert ap_limited_admit(rule, false, false) == AP_OK;
  }
  #assert ap_limited_admit(AP_PUBLIC, true, true) == AP_OK && ap_limited_admit(AP_GUEST, true, true) == AP_OK;
  #assert ap_limited_admit(AP_RECOVER, true, true) == AP_OK && ap_limited_admit(AP_RECOVER, false, true) == AP_OK;
  #assert ap_limited_admit(AP_ACCOUNT, false, true) == AP_OK && ap_limited_admit(AP_HUMAN, false, true) == AP_OK;
  #assert ap_limited_admit(AP_SCOPE, false, true) == AP_OK;
  #assert ap_limited_admit(AP_ACCOUNT, true, true) == AP_LIMITED && ap_limited_admit(AP_HUMAN, true, true) == AP_LIMITED;
  #assert ap_limited_admit(AP_SCOPE, true, true) == AP_LIMITED;
  for rule: 4..<6 { #assert ap_limited_admit(rule, false, true) == AP_LIMITED && ap_limited_admit(rule, true, true) == AP_LIMITED; }
  #assert ap_limited_admit(AP_ADMIN, false, true) == AP_LIMITED && ap_limited_admit(AP_ADMIN, true, true) == AP_LIMITED;
  #assert ap_limited_admit(AP_ADMIN_FRESH, false, true) == AP_LIMITED && ap_limited_admit(AP_ADMIN_FRESH, true, true) == AP_LIMITED;
  #assert ap_limited_admit(10, false, true) == AP_LIMITED && ap_limited_admit(-1, false, true) == AP_LIMITED;
}
#test "a limited session's writes are the account chat's three completions and starting a GameBuilder build agent, by POST, and no other route" {
  #assert ap_limited_write("POST", "/api/chat/complete/v1") && ap_limited_write("POST", "/api/chat/world/complete/v1") && ap_limited_write("POST", "/api/chat/delegated/complete/v1");
  #assert ap_limited_write("POST", "/api/gamebuilder/agents/v1") && !ap_limited_write("GET", "/api/gamebuilder/agents/v1") && !ap_limited_write("PUT", "/api/gamebuilder/agents/v1");
  #assert !ap_limited_write("POST", "/api/gamebuilder/agent/v1") && !ap_limited_write("POST", "/api/gamebuilder/agents/v1/") && !ap_limited_write("POST", "/api/gamebuilder/agents") && !ap_limited_write("POST", "/api/gamebuilder/agents/v2");
  methods := [5] string.["GET", "PUT", "DELETE", "post", ""];
  for m: methods {
    #assert !ap_limited_write(m, "/api/chat/complete/v1") && !ap_limited_write(m, "/api/chat/world/complete/v1") && !ap_limited_write(m, "/api/chat/delegated/complete/v1");
  }
  paths := [24] string.["/api/chat/thread/v1", "/api/chat/world/player/v1", "/api/chat/project/v1", "/api/chat/project/complete/v1", "/api/chat/route/v1",
                        "/api/chat/library/v1", "/api/chat/submit/v2alpha1", "/api/chat/environment/v1", "/api/chat/complete", "/api/chat/complete/", "/api/chat/complete/v1/",
                        "/api/chat/complete/v2", "/api/chat/world/complete", "/api/chat/delegated/complete/v1x", "/api/auth/settings/v1", "/api/auth/link/nostr",
                        "/api/auth/passkey/register", "/api/auth/logout-everywhere", "/api/wallet/spend", "/api/agents", "/api/v1/inference/credit", "/chat/complete/v1", "/", ""];
  for path: paths { #assert !ap_limited_write("POST", path) && !ap_limited_write("GET", path); }
}
#test "a limited session passes the gate on those writes under a human rule only; everything else is as ap_limited_admit says" {
  chat := "/api/chat/complete/v1";
  #assert ap_limited_route(AP_HUMAN, true, true, "POST", chat) == AP_OK;
  #assert ap_limited_route(AP_HUMAN, true, true, "POST", "/api/chat/world/complete/v1") == AP_OK && ap_limited_route(AP_HUMAN, true, true, "POST", "/api/chat/delegated/complete/v1") == AP_OK;
  #assert ap_limited_route(AP_HUMAN, true, true, "POST", "/api/gamebuilder/agents/v1") == AP_OK && ap_limited_route(AP_L2, true, true, "POST", "/api/gamebuilder/agents/v1") == AP_LIMITED;
  // the same path under any other rule (were the table to change) keeps the refusal
  for rule: -1..<11 {
    if rule != AP_HUMAN { #assert ap_limited_route(rule, true, true, "POST", chat) == ap_limited_admit(rule, true, true); }
  }
  #assert ap_limited_route(AP_ACCOUNT, true, true, "POST", chat) == AP_LIMITED && ap_limited_route(AP_L2, true, true, "POST", chat) == AP_LIMITED;
  #assert ap_limited_route(AP_SCOPE, true, true, "POST", chat) == AP_LIMITED && ap_limited_route(AP_ADMIN, true, true, "POST", chat) == AP_LIMITED;
  // another method or path on a human route is still refused
  #assert ap_limited_route(AP_HUMAN, true, true, "PUT", chat) == AP_LIMITED && ap_limited_route(AP_HUMAN, true, true, "POST", "/api/chat/thread/v1") == AP_LIMITED;
  #assert ap_limited_route(AP_HUMAN, true, true, "POST", "/api/auth/settings/v1") == AP_LIMITED && ap_limited_route(AP_HUMAN, true, true, "POST", "/api/auth/link/nostr") == AP_LIMITED;
  // reads, and sessions that are not limited, are untouched
  for rule: 0..<10 {
    #assert ap_limited_route(rule, false, true, "GET", chat) == ap_limited_admit(rule, false, true);
    #assert ap_limited_route(rule, true, false, "POST", chat) == AP_OK && ap_limited_route(rule, true, false, "POST", "/api/agents") == AP_OK;
    #assert ap_limited_route(rule, true, true, "POST", "/api/agents") == ap_limited_admit(rule, true, true);
  }
}
#test "a step-up asks for L2, or for L2 within five minutes" {
  #assert ap_need(AP_L2) == AP_NEED_L2 && ap_need(AP_ADMIN) == AP_NEED_L2;
  #assert ap_need(AP_L2_FRESH) == AP_NEED_FRESH && ap_need(AP_ADMIN_FRESH) == AP_NEED_FRESH;
  for rule: 0..<4 { #assert ap_need(rule) == AP_NEED_L2; }
  #assert ap_need(AP_SCOPE) == AP_NEED_L2 && ap_need(AP_RECOVER) == AP_NEED_L2;
}
#test "each verdict has its status and words" {
  #assert ap_status(AP_OK) == 200 && ap_status(AP_LOG_IN) == 401 && ap_status(AP_STEP_UP) == 401;
  #assert ap_status(AP_HUMAN_ONLY) == 403 && ap_status(AP_NOT_ADMIN) == 403 && ap_status(AP_NO_SCOPE) == 403;
  #assert ap_status(AP_BAD_RULE) == 404 && ap_status(AP_TWO_CREDENTIALS) == 400 && ap_status(99) == 500;
  #assert ap_words(AP_LOG_IN) == "Log in first.";
  #assert ap_words(AP_STEP_UP) == "Log in again with your key or passkey to do this.";
  #assert ap_words(AP_HUMAN_ONLY) == "Only a person can do this, not an agent.";
  #assert ap_words(AP_NOT_ADMIN) == "Admins only.";
  #assert ap_words(AP_NO_SCOPE) == "This key isn't allowed to do this.";
  #assert ap_words(AP_BAD_RULE) == "Not found.";
  #assert ap_words(AP_TWO_CREDENTIALS) == "Send one credential: a signature, a token or the session cookie, not two.";
  #assert ap_words(AP_LIMITED) == "You logged in with email, and this account has a key. Log in with your key to change it, or ask for recovery.";
  #assert ap_status(AP_LIMITED) == 401;
  #assert ap_words(AP_OK) == "" && ap_words(99) == "";
}
#test "a web session: good, then due for a new token, then ended when idle or old" {
  t0 := 1000 * AP_DAY_MS;
  #assert ap_session(false, t0, t0, t0, t0) == AP_SESSION_GOOD;
  #assert ap_session(false, t0 + AP_ROTATE_MS - 1, t0, t0, t0) == AP_SESSION_GOOD;
  #assert ap_session(false, t0 + AP_ROTATE_MS, t0, t0 + AP_ROTATE_MS - 5, t0) == AP_SESSION_ROTATE;
  #assert ap_session(false, t0 + AP_WEB_IDLE_MS, t0, t0, t0) == AP_SESSION_ENDED;
  #assert ap_session(false, t0 + AP_WEB_IDLE_MS - 1, t0, t0, t0 + AP_WEB_IDLE_MS - 2) == AP_SESSION_GOOD;
  #assert ap_session(false, t0 + AP_WEB_ABSOLUTE_MS, t0, t0 + AP_WEB_ABSOLUTE_MS - 1, t0 + AP_WEB_ABSOLUTE_MS - 1) == AP_SESSION_ENDED;
  #assert ap_session(false, t0 + AP_WEB_ABSOLUTE_MS - 1, t0, t0 + AP_WEB_ABSOLUTE_MS - 2, t0 + AP_WEB_ABSOLUTE_MS - 2) == AP_SESSION_GOOD;
  #assert ap_session(false, t0 - 1, t0, t0, t0) == AP_SESSION_GOOD;
}
#test "an app's login: no web rotation, ended after 90 idle days" {
  t0 := 1000 * AP_DAY_MS;
  #assert ap_session(true, t0 + AP_ROTATE_MS * 2, t0, t0 + AP_ROTATE_MS, t0) == AP_SESSION_GOOD;
  #assert ap_session(true, t0 + AP_APP_IDLE_MS, t0, t0, t0) == AP_SESSION_ENDED;
  #assert ap_session(true, t0 + AP_APP_IDLE_MS - 1, t0, t0, t0) == AP_SESSION_GOOD;
  #assert ap_session(true, t0 + AP_WEB_ABSOLUTE_MS + AP_DAY_MS, t0, t0 + AP_WEB_ABSOLUTE_MS, t0) == AP_SESSION_GOOD;
}
#test "a limit allows up to its count in a window" {
  #assert ap_limit_ok(1, 5) && ap_limit_ok(5, 5);
  #assert !ap_limit_ok(6, 5) && !ap_limit_ok(100, 5);
  #assert !ap_limit_ok(1, 0) && !ap_limit_ok(0, 0);
  #assert ap_limit_ok(0, 1);
}
#test "an email code is six digits, nothing else" {
  #assert ap_code_ok("482913") && ap_code_ok("000000") && ap_code_ok("999999");
  #assert !ap_code_ok("48291") && !ap_code_ok("4829134") && !ap_code_ok("") && !ap_code_ok("48291a");
  #assert !ap_code_ok("/82913") && !ap_code_ok(":82913") && !ap_code_ok("48291:") && !ap_code_ok(" 82913");
}

#test "no Origin is an app or a tool; our own Origin is ours, whatever the list says" {
  #assert ap_site(false, "", "https://openagents.com", "") == AP_SITE_NONE;
  #assert ap_site(false, "https://evil.example", "https://openagents.com", "https://evil.example") == AP_SITE_NONE;
  #assert ap_site(true, "https://openagents.com", "https://openagents.com", "") == AP_SITE_OURS;
  #assert ap_site(true, "https://openagents.com", "https://openagents.com", "https://gamebuilder.org") == AP_SITE_OURS;
  #assert ap_site(true, "http://127.0.0.1:7000", "http://127.0.0.1:7000", "") == AP_SITE_OURS;
}
#test "an empty list is today's rule: every other Origin is another site" {
  #assert ap_site(true, "https://gamebuilder.org", "https://openagents.com", "") == AP_SITE_OTHER;
  #assert ap_site(true, "https://evil.example", "https://openagents.com", "") == AP_SITE_OTHER;
  #assert ap_site(true, "", "https://openagents.com", "") == AP_SITE_OTHER;
  #assert ap_site(true, "null", "https://openagents.com", "") == AP_SITE_OTHER;
  #assert ap_site(true, "", "https://openagents.com", ",") == AP_SITE_OTHER;
}
#test "a listed site is its entry byte for byte: no suffix, prefix, scheme, port, case or slash is forgiven" {
  one := "https://gamebuilder.org"; ours := "https://openagents.com";
  #assert ap_site(true, "https://gamebuilder.org", ours, one) == AP_SITE_LISTED;
  #assert ap_site(true, "https://evil.example", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.org.evil.com", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, "https://evilgamebuilder.org", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, "https://evil.gamebuilder.org", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.or", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.orgg", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, "http://gamebuilder.org", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.org:443", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.org/", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, "https://GameBuilder.org", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.org ", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, " https://gamebuilder.org", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, "gamebuilder.org", ours, one) == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.org,https://evil.example", ours, one) == AP_SITE_OTHER;
}
#test "several entries: each is its own site, in any place of the list" {
  list := "https://gamebuilder.org,https://second.example:8443,http://127.0.0.1:47920"; ours := "https://openagents.com";
  #assert ap_site(true, "https://gamebuilder.org", ours, list) == AP_SITE_LISTED;
  #assert ap_site(true, "https://second.example:8443", ours, list) == AP_SITE_LISTED;
  #assert ap_site(true, "http://127.0.0.1:47920", ours, list) == AP_SITE_LISTED;
  #assert ap_site(true, "https://second.example", ours, list) == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.org,https://second.example:8443", ours, list) == AP_SITE_OTHER;
  #assert ap_site(true, "org,https://second.example:8443", ours, list) == AP_SITE_OTHER;
  #assert ap_site(true, "https://evil.example", ours, list) == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.org", ours, ",,https://gamebuilder.org,") == AP_SITE_LISTED;
  #assert ap_site(true, "https://gamebuilder.org", ours, ",https://gamebuilder.org") == AP_SITE_LISTED;
}
#test "an entry that is not a plain origin is ignored, even for an Origin that spells it" {
  ours := "https://openagents.com";
  // whitespace, a wildcard, a path or a trailing slash, capitals, a user, an empty host: none is ever a site
  #assert ap_site(true, " https://gamebuilder.org", ours, " https://gamebuilder.org") == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.org ", ours, "https://gamebuilder.org ") == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.org", ours, "https://gamebuilder.org, https://second.example") == AP_SITE_LISTED;
  #assert ap_site(true, "https://second.example", ours, "https://gamebuilder.org, https://second.example") == AP_SITE_OTHER;
  #assert ap_site(true, "https://*.gamebuilder.org", ours, "https://*.gamebuilder.org") == AP_SITE_OTHER;
  #assert ap_site(true, "https://x.gamebuilder.org", ours, "https://*.gamebuilder.org") == AP_SITE_OTHER;
  #assert ap_site(true, "*", ours, "*") == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.org/", ours, "https://gamebuilder.org/") == AP_SITE_OTHER;
  #assert ap_site(true, "https://gamebuilder.org", ours, "https://gamebuilder.org/") == AP_SITE_OTHER;
  #assert ap_site(true, "https://GameBuilder.org", ours, "https://GameBuilder.org") == AP_SITE_OTHER;
  #assert ap_site(true, "https://a@gamebuilder.org", ours, "https://a@gamebuilder.org") == AP_SITE_OTHER;
  #assert ap_site(true, "https://", ours, "https://") == AP_SITE_OTHER;
  #assert ap_site(true, "null", ours, "null") == AP_SITE_OTHER;
  #assert ap_site(true, "gamebuilder.org", ours, "gamebuilder.org") == AP_SITE_OTHER;
}
#test "an entry is https, or http on this computer for the dev server, and nothing else" {
  #assert ap_site_entry("https://gamebuilder.org") && ap_site_entry("https://a.b-c.example") && ap_site_entry("https://x") && ap_site_entry("https://9.example");
  #assert ap_site_entry("https://gamebuilder.org:8443") && ap_site_entry("https://gamebuilder.org:1");
  #assert ap_site_entry("http://127.0.0.1") && ap_site_entry("http://localhost") && ap_site_entry("http://127.0.0.1:47920") && ap_site_entry("http://localhost:8080");
  #assert !ap_site_entry("http://gamebuilder.org") && !ap_site_entry("http://127.0.0.2") && !ap_site_entry("http://localhost.evil.example") && !ap_site_entry("http://127.0.0.1.evil.example");
