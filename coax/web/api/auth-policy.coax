  #assert !ap_site_route(AP_SITE_LISTED, "POST", "/api/auth/account") && !ap_site_route(AP_SITE_LISTED, "GET", "/api/auth/email/start");
  #assert !ap_site_route(AP_SITE_LISTED, "GET", "/api/auth/email/verify") && !ap_site_route(AP_SITE_LISTED, "GET", "/api/auth/logout");
  #assert ap_site_route(AP_SITE_LISTED, "POST", "/api/chat/complete/v1") && !ap_site_route(AP_SITE_LISTED, "GET", "/api/chat/complete/v1");
  #assert ap_site_route(AP_SITE_LISTED, "POST", "/api/auth/cli/code") && !ap_site_route(AP_SITE_LISTED, "GET", "/api/auth/cli/code") && !ap_site_route(AP_SITE_LISTED, "PUT", "/api/auth/cli/code");
  #assert !ap_site_route(AP_SITE_LISTED, "POST", "/api/auth/cli/redeem") && !ap_site_route(AP_SITE_LISTED, "POST", "/api/auth/cli/code/") && !ap_site_route(AP_SITE_LISTED, "POST", "/api/auth/cli");
  // The Whispering Spring's six shared-grove guest & room routes (no other playtest room or admin remove route)
  #assert ap_site_route(AP_SITE_LISTED, "POST", "/api/playtest/player") && !ap_site_route(AP_SITE_LISTED, "GET", "/api/playtest/player");
  #assert ap_site_route(AP_SITE_LISTED, "POST", "/api/playtest/player/name") && !ap_site_route(AP_SITE_LISTED, "GET", "/api/playtest/player/name");
  #assert ap_site_route(AP_SITE_LISTED, "GET", "/api/playtest/chat/whispering-spring") && ap_site_route(AP_SITE_LISTED, "POST", "/api/playtest/chat/whispering-spring");
  #assert ap_site_route(AP_SITE_LISTED, "GET", "/api/playtest/chat/whispering-spring-ribbons") && ap_site_route(AP_SITE_LISTED, "POST", "/api/playtest/chat/whispering-spring-ribbons");
  #assert ap_site_route(AP_SITE_LISTED, "GET", "/api/playtest/chat/whispering-spring-mandala") && ap_site_route(AP_SITE_LISTED, "POST", "/api/playtest/chat/whispering-spring-mandala");
  #assert ap_site_route(AP_SITE_LISTED, "POST", "/api/playtest/presence/whispering-spring") && !ap_site_route(AP_SITE_LISTED, "GET", "/api/playtest/presence/whispering-spring");
  #assert !ap_site_route(AP_SITE_LISTED, "POST", "/api/playtest/chat/whispering-spring/remove") && !ap_site_route(AP_SITE_LISTED, "POST", "/api/playtest/chat/everglade") && !ap_site_route(AP_SITE_LISTED, "GET", "/api/playtest/chat/everglade") && !ap_site_route(AP_SITE_LISTED, "PUT", "/api/playtest/chat/whispering-spring");
  #assert !ap_site_route(AP_SITE_LISTED, "PUT", "/api/chat/complete/v1") && !ap_site_route(AP_SITE_LISTED, "", "/api/chat/complete/v1");
  #assert !ap_site_route(AP_SITE_LISTED, "PUT", "/api/auth/logout") && !ap_site_route(AP_SITE_LISTED, "DELETE", "/api/auth/account") && !ap_site_route(AP_SITE_LISTED, "", "/api/auth/account");
  chats := [16] string.["/api/chat/complete", "/api/chat/complete/", "/api/chat/complete/v1/", "/api/chat/complete/v2", "/api/chat/complete/v", "/api/chat/world/complete/v1",
                        "/api/chat/delegated/complete/v1", "/api/chat/project/v1", "/api/chat/project/complete/v1", "/api/chat/thread/v1", "/api/chat/world/player/v1",
                        "/api/chat/route/v1", "/api/chat/library/v1", "/api/chat/history/v1", "/api/chat/submit/v2alpha1", "/chat/complete/v1"];
  for path: chats {
