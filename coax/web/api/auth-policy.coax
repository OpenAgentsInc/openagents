    #assert ap_site_route(AP_SITE_OURS, "POST", path) && ap_site_route(AP_SITE_NONE, "GET", path) && ap_site_route(AP_SITE_OTHER, "POST", path);
  }
  paths := [16] string.["/api/auth/email/link", "/api/auth/logout-everywhere", "/api/auth/sessions", "/api/auth/viewer", "/api/auth/me", "/api/auth/settings/v1",
                        "/api/auth/identity/change/v1", "/api/auth/nostr/custody/v1alpha1", "/api/auth/passkey/register", "/api/auth/recovery/start",
                        "/api/auth/freeze", "/api/auth/account/", "/api/auth/logout/", "/api/chat", "/api/auth", ""];
  for path: paths {
    #assert !ap_site_route(AP_SITE_LISTED, "GET", path) && !ap_site_route(AP_SITE_LISTED, "POST", path);
    #assert ap_site_route(AP_SITE_NONE, "POST", path) && ap_site_route(AP_SITE_OURS, "POST", path) && ap_site_route(AP_SITE_OTHER, "POST", path);
    #assert ap_site_route(AP_SITE_NONE, "GET", path) && ap_site_route(AP_SITE_OURS, "GET", path) && ap_site_route(AP_SITE_OTHER, "GET", path);
  }
  #assert ap_site_route(4, "POST", "/api/chat") && ap_site_route(-1, "GET", "/api/chat");
}
#test "a listed site's email code logs a browser in: no link, no merge, no app tokens" {
  #assert ap_site_login(AP_SITE_LISTED, true, false);
  #assert !ap_site_login(AP_SITE_LISTED, false, false) && !ap_site_login(AP_SITE_LISTED, true, true) && !ap_site_login(AP_SITE_LISTED, false, true);
  for site: 0..<2 {
    #assert ap_site_login(site, true, false) && ap_site_login(site, false, false) && ap_site_login(site, true, true) && ap_site_login(site, false, true);
  }
  #assert !ap_site_login(AP_SITE_OTHER, true, false) && !ap_site_login(AP_SITE_OTHER, false, true) && !ap_site_login(4, true, false) && !ap_site_login(-1, true, false);
}
#test "a listed site's code needs the pending cookie; ours and apps may send the value in the body" {
  #assert ap_site_pending(AP_SITE_LISTED, true) && !ap_site_pending(AP_SITE_LISTED, false);
  #assert ap_site_pending(AP_SITE_NONE, false) && ap_site_pending(AP_SITE_NONE, true) && ap_site_pending(AP_SITE_OURS, false) && ap_site_pending(AP_SITE_OURS, true);
  #assert !ap_site_pending(AP_SITE_OTHER, true) && !ap_site_pending(AP_SITE_OTHER, false) && !ap_site_pending(4, true) && !ap_site_pending(-1, true);
}

ap_credentials :: (nostr: bool, bearer: bool, cookie: bool) -> int #export_c #effects(all) {
  n := 0;
  if nostr { n += 1; }
  if bearer { n += 1; }
  if cookie { n += 1; }
  if n > 1 { return AP_TWO_CREDENTIALS; }
  return AP_OK;
}

// l2_age_ms: how long ago the principal last proved L2 (a NIP-98 signature is now: 0).
ap_admit :: (rule: int, kind: int, level: int, l2_age_ms: int, admin: bool, scope: bool) -> int #export_c #effects(all) {
  if rule < AP_PUBLIC || rule > AP_ADMIN_FRESH { return AP_BAD_RULE; }
  if rule == AP_PUBLIC || rule == AP_GUEST { return AP_OK; }
  if kind != AP_PERSON && kind != AP_AGENT && kind != AP_SERVICE { return AP_LOG_IN; }
  if rule == AP_ACCOUNT { return AP_OK; }
  if rule == AP_SCOPE {
    if scope { return AP_OK; }
    return AP_NO_SCOPE;
  }
  // human, recover, L2, L2-fresh and admin: people only
  if kind != AP_PERSON { return AP_HUMAN_ONLY; }
  if rule == AP_HUMAN || rule == AP_RECOVER { return AP_OK; }
  if (rule == AP_ADMIN || rule == AP_ADMIN_FRESH) && !admin { return AP_NOT_ADMIN; }
  if level < 2 { return AP_STEP_UP; }
  if ap_need(rule) == AP_NEED_FRESH && (l2_age_ms < 0 || l2_age_ms > AP_FRESH_MS) { return AP_STEP_UP; }
  return AP_OK;
}

// An email login (L1) on an account with a stronger way in (strong: its keys, passkeys, devices
// and unspent recovery codes) could be someone who took over the inbox.
ap_limited :: (level: int, strong: int) -> bool #export_c #effects(all) {
  return level == 1 && strong > 0;
}
// After ap_admit lets a request through: a limited session may use public and guest routes (play),
// the recover routes (step up, ask for recovery), and read its account. Nothing else.
ap_limited_admit :: (rule: int, write: bool, limited: bool) -> int #export_c #effects(all) {
  if !limited { return AP_OK; }
  if rule == AP_PUBLIC || rule == AP_GUEST || rule == AP_RECOVER { return AP_OK; }
  if !write && (rule == AP_ACCOUNT || rule == AP_HUMAN || rule == AP_SCOPE) { return AP_OK; }
  return AP_LIMITED;
}
// The ordinary writes a limited session may make. Default deny: a route not named here keeps
// ap_limited_admit's refusal. Each one stores nothing, changes nothing the account owns or how it
// logs in, and spends only the account's own free daily inference quota (account-chat.c:
// inference_ask with a free key, so no credit, sats or wallet is read or charged).
ap_limited_write :: (method: string, path: string) -> bool #export_c #effects(all) {
  if method != "POST" { return false; }
  return path == "/api/chat/complete/v1" || path == "/api/chat/world/complete/v1" || path == "/api/chat/delegated/complete/v1" || path == "/api/gamebuilder/agents/v1";
}
// A limited session may make a command line's login code (POST /api/auth/cli/code): the login
// the code becomes is an email login at L1 on the same account, limited the same way, with the
// browser session's own email proof time, so the command line holds no more than this session.
// It adds no way in, links nothing and changes nothing the account owns.
ap_limited_handoff :: (method: string, path: string) -> bool #export_c #effects(all) {
  return method == "POST" && path == "/api/auth/cli/code";
}
// The gate's question for a limited session: ap_limited_admit, and on a human route the writes above.
ap_limited_route :: (rule: int, write: bool, limited: bool, method: string, path: string) -> int #export_c #effects(all) {
  if rule == AP_HUMAN && (ap_limited_write(method, path) || ap_limited_handoff(method, path)) { return AP_OK; }
  return ap_limited_admit(rule, write, limited);
}
ap_need :: (rule: int) -> int #export_c #effects(all) {
  if rule == AP_L2_FRESH || rule == AP_ADMIN_FRESH { return AP_NEED_FRESH; }
  return AP_NEED_L2;
}

ap_status :: (verdict: int) -> int #export_c #effects(all) {
  if verdict == AP_OK { return 200; }
  if verdict == AP_LOG_IN || verdict == AP_STEP_UP || verdict == AP_LIMITED { return 401; }
  if verdict == AP_HUMAN_ONLY || verdict == AP_NOT_ADMIN || verdict == AP_NO_SCOPE { return 403; }
  if verdict == AP_BAD_RULE { return 404; }
  if verdict == AP_TWO_CREDENTIALS { return 400; }
  return 500;
}
ap_words :: (verdict: int) -> string #export_c #effects(all) {
  if verdict == AP_LOG_IN { return "Log in first."; }
  if verdict == AP_STEP_UP { return "Log in again with your key or passkey to do this."; }
  if verdict == AP_HUMAN_ONLY { return "Only a person can do this, not an agent."; }
  if verdict == AP_NOT_ADMIN { return "Admins only."; }
  if verdict == AP_NO_SCOPE { return "This key isn't allowed to do this."; }
  if verdict == AP_BAD_RULE { return "Not found."; }
  if verdict == AP_TWO_CREDENTIALS { return "Send one credential: a signature, a token or the session cookie, not two."; }
  if verdict == AP_LIMITED { return "You logged in with email, and this account has a key. Log in with your key to change it, or ask for recovery."; }
  return "";
}

// A session's state now. Times are milliseconds since 1970; app logins (refresh tokens) don't rotate
// here and end only when idle.
ap_session :: (app: bool, now_ms: int, created_ms: int, last_seen_ms: int, rotated_ms: int) -> int #export_c #effects(all) {
  if app {
    if now_ms - last_seen_ms >= AP_APP_IDLE_MS { return AP_SESSION_ENDED; }
    return AP_SESSION_GOOD;
  }
  if now_ms - last_seen_ms >= AP_WEB_IDLE_MS { return AP_SESSION_ENDED; }
  if now_ms - created_ms >= AP_WEB_ABSOLUTE_MS { return AP_SESSION_ENDED; }
  if now_ms - rotated_ms >= AP_ROTATE_MS { return AP_SESSION_ROTATE; }
  return AP_SESSION_GOOD;
}

// count: hits in this window, this one included.
ap_limit_ok :: (count: int, limit: int) -> bool #export_c #effects(all) {
  return limit > 0 && count <= limit;
}

ap_code_ok :: (code: string) -> bool #export_c #effects(all) {
  if code.count != 6 { return false; }
  for i: 0..<6 {
    if code[i] < '0' || code[i] > '9' { return false; }
  }
  return true;
}

// ---- sites (docs/auth/sessions-and-tokens.md, "A second first-party site")
// A host's bytes: lower-case letters, digits, dots and hyphens.
ap_host_byte :: (c: u8) -> bool #effects(all) {
  return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '-';
}
// A port: 1 to 5 digits.
ap_port :: (s: string) -> bool #effects(all) {
  if s.count < 1 || s.count > 5 { return false; }
  for c: s {
    if c < '0' || c > '9' { return false; }
  }
  return true;
}
// HOST or HOST:PORT. Nothing else: no path, slash, space, capital or wildcard.
ap_host_port :: (s: string) -> bool #effects(all) {
  n := 0;
  while n < s.count && ap_host_byte(s[n]) { n += 1; }
  if n == 0 { return false; }
  if n == s.count { return true; }
  return s[n] == ':' && ap_port(s[n + 1..<s.count]);
}
ap_site_starts :: (s: string, p: string) -> bool #effects(all) { return s.count >= p.count && s[0..<p.count] == p; }
// One entry of OA_API_SITE_ORIGINS that counts: https://HOST[:PORT], or the dev server's
// http://127.0.0.1[:PORT] and http://localhost[:PORT].
ap_site_entry :: (e: string) -> bool #export_c #effects(all) {
  if ap_site_starts(e, "https://") { return ap_host_port(e[8..<e.count]); }
  if ap_site_starts(e, "http://127.0.0.1") { return ap_site_local(e[16..<e.count]); }
  if ap_site_starts(e, "http://localhost") { return ap_site_local(e[16..<e.count]); }
  return false;
}
// What follows a loopback name: nothing, or :PORT.
ap_site_local :: (rest: string) -> bool #effects(all) {
  if rest.count == 0 { return true; }
  return rest[0] == ':' && ap_port(rest[1..<rest.count]);
}

// has: the request carries an Origin header; from: its bytes; ours: OA_API_ORIGIN; listed:
// OA_API_SITE_ORIGINS as set, entries between commas. An entry matches only when it is the whole
// Origin, byte for byte, and counts as an entry at all (ap_site_entry).
ap_site :: (has: bool, from: string, ours: string, listed: string) -> int #export_c #effects(all) {
  if !has { return AP_SITE_NONE; }
  if from == ours { return AP_SITE_OURS; }
  at := 0;
  for i: 0..<listed.count + 1 {
    if i == listed.count || listed[i] == ',' {
      if listed[at..<i] == from && ap_site_entry(from) { return AP_SITE_LISTED; }
      at = i + 1;
    }
  }
  return AP_SITE_OTHER;
}

// The gate's question, before any route runs: a listed site's page reaches GET /api/auth/account,
// its three login writes, the command line's code (made by the logged-in browser) and the account
// chat's one completion route; with its Origin on anything
// else, on any route file, it is refused. Every other site value goes on to the route's own Origin
// check, as before.
ap_site_route :: (site: int, method: string, path: string) -> bool #export_c #effects(all) {
  if site != AP_SITE_LISTED { return true; }
  if method == "GET" {
    return path == "/api/auth/account" || path == "/api/gamebuilder/agent/v1" || path == "/api/gamebuilder/agent/events/v1"
        || path == "/api/playtest/chat/whispering-spring" || path == "/api/playtest/chat/whispering-spring-ribbons"
        || path == "/api/playtest/chat/whispering-spring-mandala";
  }
  if method != "POST" { return false; }
  return path == "/api/auth/email/start" || path == "/api/auth/email/verify" || path == "/api/auth/logout" || path == "/api/chat/complete/v1" || path == "/api/gamebuilder/agents/v1"
      || path == "/api/auth/cli/code"
      || path == "/api/playtest/player" || path == "/api/playtest/player/name"
      || path == "/api/playtest/chat/whispering-spring" || path == "/api/playtest/chat/whispering-spring-ribbons"
      || path == "/api/playtest/chat/whispering-spring-mandala"
      || path == "/api/playtest/presence/whispering-spring";
}

// op: the route under /api/auth/ of a POST in auth.c's own table (the other auth files keep
// auth_same_site: ours or no Origin, nothing listed).
ap_site_post :: (site: int, op: string) -> bool #export_c #effects(all) {
  if site == AP_SITE_NONE || site == AP_SITE_OURS { return true; }
  if site != AP_SITE_LISTED { return false; }
  return op == "email/start" || op == "email/verify" || op == "logout" || op == "cli/code";
}

// login: the email code's purpose is a login (not a link or a merge); app: the client asked for an
// app's tokens. From ours or with no Origin, every purpose and client as before.
ap_site_login :: (site: int, login: bool, app: bool) -> bool #export_c #effects(all) {
  if site == AP_SITE_NONE || site == AP_SITE_OURS { return true; }
  if site != AP_SITE_LISTED { return false; }
  return login && !app;
}

// cookie: the request carries the pending cookie. A page of a listed site that posts to another
// host of ours (a form on gamebuilder.org sent to openagents.com) carries the listed Origin and no
// cookie (SameSite=Lax); a pending value in its body is one somebody else asked for, so it is not a
// login in this browser.
ap_site_pending :: (site: int, cookie: bool) -> bool #export_c #effects(all) {
  if site == AP_SITE_NONE || site == AP_SITE_OURS { return true; }
  if site != AP_SITE_LISTED { return false; }
  return cookie;
}

// ---- a command line logs in from a browser (docs/auth/sessions-and-tokens.md, "A command line
// logs in from a browser"). The browser, logged in, makes a one-time code; the command line spends
// it for an app's login of its own.
// site: ap_site; kind: the principal's; cookie: its credential is the session cookie; email: that
// session is an email login. Only a person's own browser session from an email login, on our site
// or a listed one: never an app's token, a signature, an agent, or a session from a key or passkey
// (its L2 must not become something a code carries).
ap_cli_mint :: (site: int, kind: int, cookie: bool, email: bool) -> bool #export_c #effects(all) {
  if site != AP_SITE_OURS && site != AP_SITE_LISTED { return false; }
  return kind == AP_PERSON && cookie && email;
}
// The code is spent by an app or a tool, which sends no Origin. A page (ours, a listed site's or
// another) never receives an app's tokens.
ap_cli_redeem :: (site: int) -> bool #export_c #effects(all) {
  return site == AP_SITE_NONE;
}

// A command line's code as the page shows it: 32 lower-case hex digits (128 random bits), nothing else.
ap_cli_code_ok :: (code: string) -> bool #export_c #effects(all) {
  if code.count != 32 { return false; }
  for c: code {
    if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) { return false; }
  }
  return true;
}

#test "a command line's code is 32 lower-case hex digits" {
  #assert ap_cli_code_ok("0123456789abcdef0123456789abcdef") && ap_cli_code_ok("ffffffffffffffffffffffffffffffff") && ap_cli_code_ok("00000000000000000000000000000000");
  #assert !ap_cli_code_ok("0123456789abcdef0123456789abcde") && !ap_cli_code_ok("0123456789abcdef0123456789abcdef0") && !ap_cli_code_ok("");
  #assert !ap_cli_code_ok("0123456789ABCDEF0123456789abcdef") && !ap_cli_code_ok("0123456789abcdeg0123456789abcdef") && !ap_cli_code_ok("0123456789abcdef 123456789abcdef");
  #assert !ap_cli_code_ok("/123456789abcdef0123456789abcdef") && !ap_cli_code_ok(":123456789abcdef0123456789abcdef") && !ap_cli_code_ok("`123456789abcdef0123456789abcdef");
  #assert !ap_cli_code_ok("482913");
}
#test "a command line's code is made by a person's own email browser session, on our site or a listed one" {
  #assert ap_cli_mint(AP_SITE_LISTED, AP_PERSON, true, true) && ap_cli_mint(AP_SITE_OURS, AP_PERSON, true, true);
  #assert !ap_cli_mint(AP_SITE_NONE, AP_PERSON, true, true) && !ap_cli_mint(AP_SITE_OTHER, AP_PERSON, true, true);
  #assert !ap_cli_mint(4, AP_PERSON, true, true) && !ap_cli_mint(-1, AP_PERSON, true, true);
  for site: 1..<3 {
    #assert !ap_cli_mint(site, AP_PERSON, false, true) && !ap_cli_mint(site, AP_PERSON, true, false) && !ap_cli_mint(site, AP_PERSON, false, false);
    for kind: 0..<5 { if kind != AP_PERSON { #assert !ap_cli_mint(site, kind, true, true); } }
  }
}
#test "a command line's code is spent only with no Origin: by an app or a tool, never a page" {
  #assert ap_cli_redeem(AP_SITE_NONE);
  #assert !ap_cli_redeem(AP_SITE_OURS) && !ap_cli_redeem(AP_SITE_LISTED) && !ap_cli_redeem(AP_SITE_OTHER) && !ap_cli_redeem(4) && !ap_cli_redeem(-1);
}
#test "a limited session may make a command line's code, by POST, and that is its only login write" {
  #assert ap_limited_handoff("POST", "/api/auth/cli/code");
  methods := [5] string.["GET", "PUT", "DELETE", "post", ""];
  for m: methods { #assert !ap_limited_handoff(m, "/api/auth/cli/code"); }
  paths := [10] string.["/api/auth/cli/redeem", "/api/auth/cli/code/", "/api/auth/cli", "/api/auth/device/approve", "/api/auth/link/nostr",
                        "/api/auth/passkey/register", "/api/auth/email/start", "/api/chat/complete/v1", "/api/auth/cli/codes", ""];
  for path: paths { #assert !ap_limited_handoff("POST", path); }
  #assert ap_limited_route(AP_HUMAN, true, true, "POST", "/api/auth/cli/code") == AP_OK;
  for rule: -1..<11 {
    if rule != AP_HUMAN { #assert ap_limited_route(rule, true, true, "POST", "/api/auth/cli/code") == ap_limited_admit(rule, true, true); }
  }
  #assert ap_limited_route(AP_HUMAN, true, true, "PUT", "/api/auth/cli/code") == AP_LIMITED && ap_limited_route(AP_HUMAN, true, true, "POST", "/api/auth/device/approve") == AP_LIMITED;
}

// ---- GitHub onboarding gate
// Every logged-in person account must link a GitHub account on /onboarding before reaching the workspace.
ap_onboarding_required :: (kind: int, has_github: bool) -> bool #export_c #effects(all) {
  return kind == AP_PERSON && !has_github;
}

ap_path_is_prefix :: (p: string, pre: string) -> bool #effects(all) {
  if p.count < pre.count { return false; }
  for i: 0..<pre.count { if p[i] != pre[i] { return false; } }
  return p.count == pre.count || p[pre.count] == '/' || p[pre.count] == '?';
}

ap_safe_next_path :: (p: string) -> bool #effects(all) {
  if p.count < 1 || p.count >= 256 || p[0] != '/' { return false; }
  if p.count >= 2 && p[1] == '/' { return false; }
  for c: p { if c <= ' ' || c >= 127 || c == '\\' { return false; } }
  if ap_path_is_prefix(p, "/onboarding") { return false; }
  if ap_path_is_prefix(p, "/login") && !ap_path_is_prefix(p, "/login/device") { return false; }
  return true;
}

// Where a web login lands: /onboarding (carrying safe non-default ?next=...) until GitHub is linked,
// else safe next_path (defaulting to /chat). Returns bytes written into out, or -1 if out is too small.
ap_post_login_dest :: (has_github: bool, next_path: string, out: [] u8) -> int #export_c #effects(all) {
  safe := ap_safe_next_path(next_path);
  if has_github {
    dest := ifx safe then next_path else "/chat";
    if dest.count > out.count { return -1; }
    for i: 0..<dest.count { out[i] = dest[i]; }
    return dest.count;
  }
  base := "/onboarding";
  carry := safe && next_path != "/" && next_path != "/chat";
  need := base.count + (ifx carry then 6 + next_path.count else 0);
  if need > out.count { return -1; }
  k := 0;
  for i: 0..<base.count { out[k] = base[i]; k += 1; }
  if carry {
    q := "?next=";
    for i: 0..<q.count { out[k] = q[i]; k += 1; }
    for i: 0..<next_path.count { out[k] = next_path[i]; k += 1; }
  }
  return k;
}

#test "GitHub onboarding is required for person accounts without a linked GitHub account and redirects login there" {
  #assert ap_onboarding_required(AP_PERSON, false);
  #assert !ap_onboarding_required(AP_PERSON, true);
  #assert !ap_onboarding_required(AP_NOBODY, false) && !ap_onboarding_required(AP_KIND_GUEST, false);
  #assert !ap_onboarding_required(AP_AGENT, false) && !ap_onboarding_required(AP_SERVICE, false);

  b: [300] u8;
  // Without GitHub: default destinations land cleanly on /onboarding
  n := ap_post_login_dest(false, "", b[..]);
  #assert cast(string) b[0..<n] == "/onboarding" && ap_post_login_dest(false, "", b[0..<n - 1]) == -1 && ap_post_login_dest(false, "", b[0..<n]) == n;
  n = ap_post_login_dest(false, "/", b[..]);
  #assert cast(string) b[0..<n] == "/onboarding";
  n = ap_post_login_dest(false, "/chat", b[..]);
  #assert cast(string) b[0..<n] == "/onboarding";
  n = ap_post_login_dest(false, "/onboarding", b[..]);
  #assert cast(string) b[0..<n] == "/onboarding";
  n = ap_post_login_dest(false, "/onboarding/step", b[..]);
  #assert cast(string) b[0..<n] == "/onboarding";
  n = ap_post_login_dest(false, "/onboarding?err=1", b[..]);
  #assert cast(string) b[0..<n] == "/onboarding";
  n = ap_post_login_dest(false, "/login", b[..]);
  #assert cast(string) b[0..<n] == "/onboarding";
  n = ap_post_login_dest(false, "/login?a=1", b[..]);
  #assert cast(string) b[0..<n] == "/onboarding";
  // Safe deep links are preserved as ?next=
  n = ap_post_login_dest(false, "/projects", b[..]);
  #assert cast(string) b[0..<n] == "/onboarding?next=/projects" && ap_post_login_dest(false, "/projects", b[0..<n - 1]) == -1 && ap_post_login_dest(false, "/projects", b[0..<n]) == n;
  n = ap_post_login_dest(false, "/login/device?code=1", b[..]);
  #assert cast(string) b[0..<n] == "/onboarding?next=/login/device?code=1";
  n = ap_post_login_dest(false, "/onboarding-info", b[..]);
  #assert cast(string) b[0..<n] == "/onboarding?next=/onboarding-info";
  n = ap_post_login_dest(false, "/login2", b[..]);
  #assert cast(string) b[0..<n] == "/onboarding?next=/login2";
  // With GitHub: safe next preserved, unsafe/auth paths fall back to /chat
  b[0] = 'X';
  n = ap_post_login_dest(true, "/", b[..]);
  #assert cast(string) b[0..<n] == "/";
  b[0] = 'X';
  n = ap_post_login_dest(true, "/projects", b[..]);
  #assert cast(string) b[0..<n] == "/projects" && ap_post_login_dest(true, "/projects", b[0..<n - 1]) == -1 && ap_post_login_dest(true, "/projects", b[0..<n]) == n;
  n = ap_post_login_dest(true, "/onboarding", b[..]);
  #assert cast(string) b[0..<n] == "/chat";
  n = ap_post_login_dest(true, "/login", b[..]);
  #assert cast(string) b[0..<n] == "/chat";
  n = ap_post_login_dest(true, "/login/device", b[..]);
  #assert cast(string) b[0..<n] == "/login/device";
  // Reject unsafe paths: non-leading slash, protocol-relative (exact len 2 too), backslash, space, control, DEL, >=256 bytes
  #assert !ap_path_is_prefix("xonboarding", "/onboarding");
  #assert !ap_safe_next_path("") && !ap_safe_next_path("https://evil.com") && !ap_safe_next_path("//") && !ap_safe_next_path("//evil.com");
  #assert !ap_safe_next_path("/a\\b") && !ap_safe_next_path("/a b") && !ap_safe_next_path("/a\nb");
  del_p: [3] u8; del_p[0] = '/'; del_p[1] = 'a'; del_p[2] = 127;
  #assert !ap_safe_next_path(cast(string) del_p[..]);
  til_p: [3] u8; til_p[0] = '/'; til_p[1] = '!'; til_p[2] = '~';
  #assert ap_safe_next_path(cast(string) til_p[..]);
  p255: [255] u8; p255[0] = '/'; for i: 1..<255 { p255[i] = 'a'; }
  p256: [256] u8; p256[0] = '/'; for i: 1..<256 { p256[i] = 'a'; }
  #assert ap_safe_next_path(cast(string) p255[..]) && !ap_safe_next_path(cast(string) p256[..]);
  #assert ap_safe_next_path("/") && ap_safe_next_path("/a");
}
