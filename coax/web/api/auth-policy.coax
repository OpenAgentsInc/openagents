  #assert ap_site_entry("https://gamebuilder.org:12345") && ap_site_entry("https://gamebuilder.org:09");
  #assert !ap_site_entry("https://gamebuilder.org/") && !ap_site_entry("https://gamebuilder.org/login") && !ap_site_entry("https://game builder.org") && !ap_site_entry("https://gamebuilder.org ");
  #assert !ap_site_entry("https://Gamebuilder.org") && !ap_site_entry("https://gamebuilder.orG") && !ap_site_entry("https://gamebuilderZorg") && !ap_site_entry("https://*.gamebuilder.org");
  #assert !ap_site_entry("https://a@b") && !ap_site_entry("https://a[b") && !ap_site_entry("https://a`b") && !ap_site_entry("https://a{b") && !ap_site_entry("https://a,b");
  #assert ap_site_entry("https://az09") && ap_site_entry("https://a-z.0-9") && !ap_site_entry("https://a/b") && !ap_site_entry("https://a:b") && !ap_site_entry("https://a+b");
}
#test "our own pages and apps send every auth write; a listed site only the email login and logout" {
  ops := [15] string.["email/start", "email/verify", "logout", "email/link", "nostr/challenge", "nostr", "phone/start", "phone/approve", "phone/poll",
                      "refresh", "logout-everywhere", "freeze", "sessions/12/remove", "", "email"];
  for op, i: ops {
