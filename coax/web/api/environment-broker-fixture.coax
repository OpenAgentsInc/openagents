// An independent process-boundary fixture. No relay, credentials or model call.
#load "../../lib/agent/environment/wire.coax";
#load "../../lib/agent/accounts/wire.coax";
#load "../../lib/agent/router/wire.coax";
#load "../../lib/agent/environment/task-wire.coax";
#load "../../lib/sys/tool.coax";
#load "../../lib/sys/fs.coax";
#load "../../lib/sys/proc.coax";
#load "../../lib/sys/clock.coax";
tool_main :: ()->int #export_c #effects(all) {
  args:[1]Args;if !args_load(args[..]) {return 2;}
  input:[XT_REQUEST_MAX]u8;n:=fs_read(args_value(args[..],"--request-file",""),input[..]);q:[1]EaRequest;
  if args_at(args[..],0)=="execution-rpc" {
    request:[1]XtRequest;arena:[2048]u8;host:=args_value(args[..],"--host","");
    if n<1 || !ea_id(host,64) || !xt_request_read(cast(string)input[0..<n],request[..],arena[..]) {return 2;}
    if request[0].method!="ReadTask" && !ea_fresh(request[0].issued,request[0].expires,cxproc_wall_us()/1000) {return 5;}
    epoch:=args_value(args[..],"--epoch","");if epoch=="98" {return 4;}if epoch=="97" {return 5;}if epoch=="96" {return 7;}if epoch=="95" {print("%\n","{}");return 0;}if epoch=="92" {return 3;}
    if request[0].method!="ReadTask" && epoch=="91" {return 4;}
    v:=XtStatus.{binding=ExBinding.{task=request[0].task,conversation="cnv_0123456789abcdef0123456789abcdef",turn="trn_0123456789abcdef0123456789abcdef",route="0123456789abcdef0123456789abcdef",host=host,workspace="default",session="0123456789abcdef0123456789abcdef",command="0123456789abcdef0123456789abcdef",engine="codex",account="system",model="fixture-native-model",effort="high",input_hash="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",input_bytes=251,report_hash="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",report_at=999,issued=1000,expires=301000},state=XT_WAITING,revision=3,interaction="native-request",native="native-session",updated=1000};
    if request[0].method=="StopTask" {v.state=XT_CANCELED;v.stop=true;v.interaction="";v.revision=4;v.command=request[0].command;}
    else if request[0].method=="RespondTask" {if request[0].revision!=3 || request[0].interaction!="native-request" {return 6;}v.state=XT_COMPLETED;v.interaction="";v.revision=4;v.command=request[0].command;}
    else if request[0].method!="ReadTask" {return 2;}
    if request[0].method!="ReadTask" {ab:[4096]u8;audit:=proc_getenv("OA_ENV_TASK_FIXTURE_AUDIT",ab[..]);if audit!="" {if !fs_append_durable(audit,cast(string)input[0..<n]) || !fs_append_durable(audit,"\n") {return 3;}}}
    // A negative fixture changes a valid identity after the control preflight.
    if request[0].method!="ReadTask" && args_value(args[..],"--epoch","")=="99" {v.binding.model="changed-after-preflight";}
    if request[0].method!="ReadTask" && epoch=="94" {v.command="11111111111111111111111111111111";}
    out:[8192]u8;made:=xt_status_write(v,out[..]);if made<1 {return 2;}print("%\n",cast(string)out[0..<made]);return 0;
  }
  // a computer's own report: the broker builds DescribeStation itself and waits 8 seconds at most
  if args_at(args[..],0)=="station-rpc" {
    host:=args_value(args[..],"--host","");if !ea_id(host,64) || args_value(args[..],"--wait-ms","")!="8000" || args_has(args[..],"--request-file") {return 2;}
    r:[1]RtrRequest;r[0].n=1;st:=r[0].stations[0..<1];st[0].id="fixture-mac";st[0].name=ifx args_has(args[..],"--refresh") then "Fixture computer, read again" else "Fixture computer";
    st[0].os="macos";st[0].cores=8;st[0].memory_total_mb=16384;st[0].memory_free_mb=4096;st[0].disk_free_mb=90000;st[0].disk_floor_mb=20480;st[0].apple_builds=true;
    st[0].agents[0]=RtrAgent.{reported=true,installed=true,logged_in=true};
    out:[RTR_REPORT_MAX]u8;made:=rtr_report_write(r[..],0,host,out[..]);if made<1 {return 2;}print("%\n",cast(string)out[0..<made]);return 0;
  }
  if args_at(args[..],0)=="accounts-rpc" {p:[1]PaRequest;if n<1 || !pa_request_read(cast(string)input[0..<n],p[..]) {return 2;}v:[1]PaView;_:=pa_copy(v[0].host[..],args_value(args[..],"--host",""));v[0].method=p[0].method;v[0].nm=p[0].nm;v[0].command=p[0].command;v[0].nc=p[0].nc;v[0].n=1;a:=v[0].accounts[0..<1];a[0].ni=pa_copy(a[0].id[..],"system");a[0].ne=pa_copy(a[0].email[..],"fixture@example.com");a[0].ns=pa_copy(a[0].state[..],"connected");a[0].selected=true;_:=pa_usage("{\"seven_day\":{\"utilization\":35}}",a);out:[8192]u8;n=pa_view_write(v[..],out[..]);if n<1 {return 2;}print("%\n",cast(string)out[0..<n]);return 0;}
  if n<1 || !ea_read(cast(string)input[0..<n],q[..]) || ea_right(cast(string)q[0].method[0..<q[0].nm])!=0 {return 2;}
  host:=args_value(args[..],"--host","");if !ea_id(host,64) {return 2;}
  v:[1]EaView;v[0].nh=ea_copy(v[0].host[..],host);v[0].nm=ea_copy(v[0].method[..],cast(string)q[0].method[0..<q[0].nm]);v[0].nl=ea_copy(v[0].label[..],"Fixture computer");v[0].complete=true;
  out:[4096]u8;n=ea_view_write(v[..],out[..]);if n<1 {return 2;}print("%\n",cast(string)out[0..<n]);return 0;
}
