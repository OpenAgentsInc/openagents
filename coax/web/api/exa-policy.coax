// OpenAgents Exa central metered proxy policy (#14114, #14115, docs/exa/SPEC.md):
//   - Shared-key parameter clamping (numResults, maxCharacters, URL batch size, search type)
//   - Domain & category validation
//   - SSRF URL safety guard for /api/v1/fetch and web_fetch_exa
//   - Exact integer decimal parser for Exa's costDollars.total -> upstream_usd_micros
//   - Admission & settlement policy (precheck, daily quotas, retail markup, msat ceiling)
#authority;

EXA_DEFAULT_NUM_RESULTS :: 8;
EXA_MAX_NUM_RESULTS :: 10;
EXA_DEFAULT_MAX_CHARS :: 3000;
EXA_MIN_MAX_CHARS :: 200;
EXA_MAX_MAX_CHARS :: 24000;
EXA_MAX_URLS :: 5;
EXA_MAX_DOMAINS :: 20;
EXA_MAX_QUERY_BYTES :: 2000;
EXA_DEFAULT_MARKUP_BPS :: 2500;
EXA_RATE_MAX_AGE_MS :: 3600000;

exa_clamp_num_results :: (n: int) -> int #export_c #effects(all) {
  if n <= 0 { return EXA_DEFAULT_NUM_RESULTS; }
  if n > EXA_MAX_NUM_RESULTS { return EXA_MAX_NUM_RESULTS; } // mutant: equivalent (when n == EXA_MAX_NUM_RESULTS both branches return EXA_MAX_NUM_RESULTS)
  return n;
}

exa_clamp_max_chars :: (n: int) -> int #export_c #effects(all) {
  if n <= 0 { return EXA_DEFAULT_MAX_CHARS; }
  if n < EXA_MIN_MAX_CHARS { return EXA_MIN_MAX_CHARS; } // mutant: equivalent (for integer n, n < 200 / <= 200 / < 201 all return 200 at n == 200)
  if n > EXA_MAX_MAX_CHARS { return EXA_MAX_MAX_CHARS; } // mutant: equivalent (when n == EXA_MAX_MAX_CHARS both branches return EXA_MAX_MAX_CHARS)
  return n;
}

exa_valid_url_count :: (n: int) -> bool #export_c #effects(all) {
  return n >= 1 && n <= EXA_MAX_URLS;
}

exa_valid_search_type :: (s: string) -> bool #export_c #effects(all) {
  return s == "" || s == "auto" || s == "fast";
}

exa_valid_category :: (s: string) -> bool #export_c #effects(all) {
  return s == "" || s == "company" || s == "research paper" || s == "news" ||
         s == "personal site" || s == "financial report" || s == "people" ||
         s == "tweet" || s == "github" || s == "pdf";
}

exa_lower_ascii :: (c: u8) -> u8 #effects(all) {
  if c >= 'A' && c <= 'Z' { return cast(u8) (c + 32); }
  return c;
}

exa_starts_ci :: (s: string, pre: string) -> bool #effects(all) {
  if s.count < pre.count { return false; }
  for i: 0..<pre.count {
    if exa_lower_ascii(s[i]) != exa_lower_ascii(pre[i]) { return false; }
  }
  return true;
}

exa_ends_ci :: (s: string, suf: string) -> bool #effects(all) {
  if s.count < suf.count { return false; }
  off := s.count - suf.count;
  for i: 0..<suf.count {
    if exa_lower_ascii(s[off + i]) != exa_lower_ascii(suf[i]) { return false; }
  }
  return true;
}

exa_eq_ci :: (a: string, b: string) -> bool #effects(all) {
  if a.count != b.count { return false; }
  for i: 0..<a.count {
    if exa_lower_ascii(a[i]) != exa_lower_ascii(b[i]) { return false; }
  }
  return true;
}

// Validates a bare hostname/domain for includeDomains/excludeDomains (no scheme, path, or whitespace).
exa_valid_domain :: (s: string) -> bool #export_c #effects(all) {
  if s.count < 3 || s.count > 253 { return false; }
  if s[0] == '.' || s[0] == '-' || s[s.count - 1] == '.' || s[s.count - 1] == '-' { return false; }
  has_dot := false;
  prev_dot := false; // mutant: equivalent (s[0] != '.' from line 79 so i == 0 never enters c == '.' and resets prev_dot)
  for i: 0..<s.count {
    c := exa_lower_ascii(s[i]);
    if c == '.' {
      if prev_dot { return false; }
      has_dot = true;
      prev_dot = true;
    } else if (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' {
      prev_dot = false;
    } else {
      return false;
    }
  }
  return has_dot;
}

// Parse a decimal octet in host[at..end) for RFC1918 172.16.0.0/12 check.
exa_is_172_private :: (host: string) -> bool #effects(all) {
  if !exa_starts_ci(host, "172.") { return false; }
  i := 4;
  val := 0;
  digits := 0;
  while i < host.count && host[i] >= '0' && host[i] <= '9' {
    val = val * 10 + cast(int) (host[i] - '0');
    digits += 1;
    i += 1;
    if digits > 3 { return false; }
  }
  if digits == 0 || i >= host.count || host[i] != '.' { return false; } // mutant: equivalent (digits == 1 has val <= 9 < 16 so next line returns false too)
  return val >= 16 && val <= 31;
}

// SSRF guard for /api/v1/fetch URLs: only public http(s) URLs are allowed.
exa_url_safe :: (url: string) -> bool #export_c #effects(all) {
  if url.count < 10 || url.count > 2048 { return false; }
  at := 0; // mutant: equivalent (always overwritten by 8 or 7 below, or returns false)
  if exa_starts_ci(url, "https://") { at = 8; }
  else if exa_starts_ci(url, "http://") { at = 7; }
  else { return false; }

  // Reject whitespace or control characters anywhere in URL
  for i: 0..<url.count { // mutant: equivalent (url[0] is 'h'/'H' from scheme check so never <= 32 or 127)
    if url[i] <= 32 || url[i] == 127 { return false; }
  }

  end := at;
  while end < url.count && url[end] != '/' && url[end] != '?' && url[end] != '#' {
    if url[end] == '@' { return false; } // disallow userinfo host confusion
    if url[end] == ':' { break; }
    end += 1;
  }
  if end <= at { return false; }
  host := cast(string) url[at..<end];
  if host[0] == '[' { return false; } // reject bracketed IPv6 literals (::1, fe80::, fc00::)
  if exa_eq_ci(host, "localhost") || exa_ends_ci(host, ".localhost") ||
     exa_ends_ci(host, ".local") || exa_ends_ci(host, ".internal") {
    return false;
  }
  if exa_starts_ci(host, "127.") || exa_starts_ci(host, "10.") ||
     exa_starts_ci(host, "192.168.") || exa_starts_ci(host, "169.254.") ||
     exa_starts_ci(host, "0.") || exa_is_172_private(host) {
    return false;
  }
  // Must contain a dot (reject bare intranet hostnames like http://metadata)
  has_dot := false;
  for i: 0..<host.count {
    if host[i] == '.' { has_dot = true; break; }
  }
  return has_dot;
}

// Exact integer decimal parser for Exa's costDollars.total (JSON number string -> USD micros, ceiling).
// Caps at $100.00 (100_000_000 micros) and returns 0 for non-positive or malformed inputs.
exa_cost_dollars_to_micros :: (s: string) -> int #export_c #effects(all) {
  if s.count == 0 { return 0; }
  i := 0;
  while i < s.count && (s[i] == ' ' || s[i] == '\t') { i += 1; }
  if i >= s.count || s[i] == '-' { return 0; }
  if s[i] == '+' { i += 1; }

  // Read up to 12 significant digits + track decimal point position and exponent.
  mantissa := 0;
  sig_digits := 0; // mutant: equivalent (11 vs 12 sig digits gives identical ceiling micros capped at 9-digit 100_000_000)
  frac_digits := 0;
  seen_dot := false;
  seen_digit := false; // mutant: equivalent (no digits parsed implies mantissa == 0 && !extra_nonzero, which returns 0 below)
  extra_nonzero := false;

  while i < s.count {
    c := s[i];
    if c >= '0' && c <= '9' {
      seen_digit = true;
      d := cast(int) (c - '0');
      if sig_digits < 12 { // mutant: equivalent (12 vs 13 sig digits fits in int64 and gives identical ceiling micros <= 10^8)
        if mantissa > 0 || d > 0 {
          mantissa = mantissa * 10 + d;
          sig_digits += 1;
        }
        if seen_dot { frac_digits += 1; }
      } else {
        if d > 0 { extra_nonzero = true; }
        if !seen_dot { frac_digits -= 1; }
      }
      i += 1;
    } else if c == '.' && !seen_dot {
      seen_dot = true;
      i += 1;
    } else {
      break;
    }
  }
  if !seen_digit { return 0; }

  exp10 := 0;
  if i < s.count && (s[i] == 'e' || s[i] == 'E') {
    i += 1;
    neg_exp := false;
    if i < s.count && (s[i] == '-' || s[i] == '+') {
      neg_exp = s[i] == '-';
      i += 1;
    }
    ed := 0;
    while i < s.count && s[i] >= '0' && s[i] <= '9' {
      if exp10 < 100 { exp10 = exp10 * 10 + cast(int) (s[i] - '0'); } // mutant: equivalent (overflow guard: exp10 >= 100 saturates scale > 9 or < -15)
      ed += 1; // mutant: equivalent (ed is only compared against 0 so any nonzero step gives ed != 0)
      i += 1;
    }
    if ed == 0 { return 0; }
    if neg_exp { exp10 = -exp10; }
  }
  while i < s.count && (s[i] == ' ' || s[i] == '\t') { i += 1; }
  if i != s.count { return 0; }

  if mantissa == 0 && !extra_nonzero { return 0; }

  // Value in micros = mantissa * 10^(6 + exp10 - frac_digits)
  scale := 6 + exp10 - frac_digits;
  if scale > 9 { return 100000000; } // mutant: equivalent (scale == 9 or 10 with mantissa >= 1 also clamps to 100000000 in the loop below)
  if scale < -15 { return ifx mantissa > 0 || extra_nonzero then 1 else 0; } // mutant: equivalent (mantissa > 0 from line 214 and mantissa < 10^12 so scale <= -12 rounds up to 1 below)

  res := mantissa;
  if scale >= 0 { // mutant: equivalent (when scale == 0 both branches do 0 iterations; extra_nonzero => mantissa >= 10^11 clamps to 10^8)
    for k: 0..<scale {
      if res > 10000000 { return 100000000; } // mutant: equivalent (res == 10000000*10 == 100000000; res == 10000001*10 clamps on line 237)
      res = res * 10;
    }
    if extra_nonzero && res < 100000000 { res += 1; } // mutant: equivalent (extra_nonzero requires sig_digits == 12 => mantissa >= 10^11 > 10^8)
  } else {
    div_steps := -scale;
    rem_nonzero := extra_nonzero;
    for k: 0..<div_steps {
      if (res % 10) != 0 { rem_nonzero = true; }
      res = res / 10;
    }
    if rem_nonzero { res += 1; }
  }
  if res > 100000000 { return 100000000; } // mutant: equivalent (when res == 100000000 both branches return 100000000)
  return res;
}

// Compute billed retail micros for Exa settlement.
exa_retail_micros :: (upstream_micros: int, markup_bps: int, fallback_retail: int, http_status: int) -> int #export_c #effects(all) {
  if http_status != 200 { return 0; }
  bps := ifx markup_bps > 0 then markup_bps else 0; // mutant: equivalent (when markup_bps == 0 both branches evaluate to 0)
  if upstream_micros > 0 {
    return (upstream_micros * (10000 + bps) + 9999) / 10000;
  }
  return ifx fallback_retail > 0 then fallback_retail else 0; // mutant: equivalent (when fallback_retail == 0 both branches evaluate to 0)
}

// Compute recorded upstream USD micros for Exa settlement.
exa_upstream_micros :: (upstream_micros: int, markup_bps: int, fallback_retail: int, http_status: int) -> int #export_c #effects(all) {
  if http_status != 200 { return 0; }
  if upstream_micros > 0 { return upstream_micros; }
  if fallback_retail <= 0 { return 0; } // mutant: equivalent (when fallback_retail == 0 both branches return 0)
  bps := ifx markup_bps > 0 then markup_bps else 0; // mutant: equivalent (when markup_bps == 0 both branches evaluate to 0)
  return (fallback_retail * 10000) / (10000 + bps);
}

// Convert retail USD micros to ceiling msat at usd_per_btc (0 for free callers or invalid rate).
exa_msat_due :: (usd_micros: int, usd_per_btc: int, free: bool) -> int #export_c #effects(all) {
  if free || usd_micros <= 0 || usd_per_btc <= 0 { return 0; } // mutant: equivalent (when usd_micros == 0 and usd_per_btc > 0 ceiling formula also returns 0)
  return (usd_micros * 100000 + usd_per_btc - 1) / usd_per_btc;
}

// Pre-quota admission check: model exists, and non-free callers have positive credit
// and a fresh BTC/USD exchange rate (<= 3600s old).
// Returns 200 (ok), 400 (unknown search service), 402 (no credit), or 503 (missing/stale rate).
exa_admit_precheck :: (model_found: bool, free: bool, credit_msat: int, has_rate: bool, rate_age_ms: int) -> int #export_c #effects(all) {
  if !model_found { return 400; }
  if !free {
    if credit_msat <= 0 { return 402; }
    if !has_rate || rate_age_ms > EXA_RATE_MAX_AGE_MS { return 503; }
  }
  return 200;
}

// Daily quota admission check after incrementing account_day.n.
// Returns 200 (ok), 4291 (daily request cap exceeded), or 4292 (daily USD spend cap reached).
exa_admit_quota :: (day_n: int, cap_n: int, day_usd_micros: int, cap_usd_micros: int) -> int #export_c #effects(all) {
  if day_n > cap_n { return 4291; }
  if day_usd_micros >= cap_usd_micros { return 4292; }
  return 200;
}

#test "exa-policy: clamping, search type, category, and domain validation" {
  #assert exa_clamp_num_results(0) == 8 && exa_clamp_num_results(-5) == 8;
  #assert exa_clamp_num_results(1) == 1 && exa_clamp_num_results(5) == 5 && exa_clamp_num_results(10) == 10 && exa_clamp_num_results(11) == 10 && exa_clamp_num_results(99) == 10;

  #assert exa_clamp_max_chars(0) == 3000 && exa_clamp_max_chars(-1) == 3000;
  #assert exa_clamp_max_chars(1) == 200 && exa_clamp_max_chars(50) == 200 && exa_clamp_max_chars(199) == 200;
  #assert exa_clamp_max_chars(200) == 200 && exa_clamp_max_chars(201) == 201 && exa_clamp_max_chars(4000) == 4000;
  #assert exa_clamp_max_chars(24000) == 24000 && exa_clamp_max_chars(24001) == 24000 && exa_clamp_max_chars(99999) == 24000;

  #assert !exa_valid_url_count(0) && exa_valid_url_count(1) && exa_valid_url_count(5) && !exa_valid_url_count(6);

  #assert exa_valid_search_type("") && exa_valid_search_type("auto") && exa_valid_search_type("fast");
  #assert !exa_valid_search_type("deep") && !exa_valid_search_type("deep-reasoning") && !exa_valid_search_type("neural");

  #assert exa_valid_category("") && exa_valid_category("company") && exa_valid_category("research paper");
  #assert exa_valid_category("news") && exa_valid_category("personal site") && exa_valid_category("financial report");
  #assert exa_valid_category("people") && exa_valid_category("tweet") && exa_valid_category("github") && exa_valid_category("pdf");
  #assert !exa_valid_category("invalid");

  // ASCII case-insensitive helpers: exact boundaries ('@', 'A', 'Z', '[') and length/offset edge cases
  #assert exa_lower_ascii('@') == '@' && exa_lower_ascii('A') == 'a' && exa_lower_ascii('M') == 'm' && exa_lower_ascii('Z') == 'z' && exa_lower_ascii('[') == '[';
  #assert exa_starts_ci("http", "http") && exa_starts_ci("HTTP", "http") && !exa_starts_ci("hi", "http") && !exa_starts_ci("xttp", "http");
  #assert exa_ends_ci(".local", ".local") && exa_ends_ci(".LOCAL", ".local") && !exa_ends_ci("a.b", ".local") && !exa_ends_ci("xlocal", ".local");
  #assert exa_eq_ci("LocalHost", "localhost") && exa_eq_ci("", "");
  #assert !exa_eq_ci("localhos", "localhost") && !exa_eq_ci("xocalhost", "localhost") && !exa_eq_ci("localhosx", "localhost");

  #assert exa_valid_domain("docs.exa.ai") && exa_valid_domain("github.com") && exa_valid_domain("sub-1.example.org");
  #assert exa_valid_domain("a.b") && exa_valid_domain("a.z") && exa_valid_domain("A.Z") && exa_valid_domain("0.9") && exa_valid_domain("a-.b") && exa_valid_domain("a.-b");
  #assert !exa_valid_domain("") && !exa_valid_domain("ab") && !exa_valid_domain("localhost") && !exa_valid_domain(".exa.ai") && !exa_valid_domain("exa.ai.");
  #assert !exa_valid_domain("-a.b") && !exa_valid_domain("a.b-") && !exa_valid_domain("!a.b") && !exa_valid_domain("a.{b") && !exa_valid_domain("a/b.c") && !exa_valid_domain("a:b.c");
  #assert !exa_valid_domain("https://exa.ai") && !exa_valid_domain("exa..ai") && !exa_valid_domain("exa.ai/path");

  // Exact 253 vs 254 domain length boundary
  d253: [253] u8;
  d254: [254] u8;
  for k: 0..<253 { d253[k] = 'a'; }
  d253[1] = '.';
  for k: 0..<254 { d254[k] = 'a'; }
  d254[1] = '.';
  #assert exa_valid_domain(cast(string) d253[..]) && !exa_valid_domain(cast(string) d254[..]);
}

#test "exa-policy: SSRF URL safety blocks private, loopback, link-local, userinfo, and non-http" {
  #assert exa_url_safe("https://docs.exa.ai/reference/search");
  #assert exa_url_safe("http://example.com/page?q=1");
  #assert exa_url_safe("https://example.com");
  #assert exa_url_safe("http://a.b") && !exa_url_safe("http://a.");
  #assert exa_url_safe("https://example.com/a!b") && exa_url_safe("https://a$b.com/");
  #assert exa_url_safe("https://.a");
  #assert exa_url_safe("https://172.15.0.1/ok") && exa_url_safe("https://172.32.0.1/ok");
  #assert !exa_url_safe("file:///etc/passwd") && !exa_url_safe("ftp://example.com/a");
  #assert !exa_url_safe("http://localhost:8080/") && !exa_url_safe("https://sub.localhost/") && !exa_url_safe("http://sub.localhost:8080/");
  #assert !exa_url_safe("https://localhost?a=1.2") && !exa_url_safe("https://localhost#a.b") && !exa_url_safe("https:///a.b");
  #assert !exa_url_safe("http://127.0.0.1/admin") && !exa_url_safe("https://127.0.0.1/") && !exa_url_safe("http://169.254.169.254/latest/meta-data");
  #assert !exa_url_safe("http://10.0.0.1/") && !exa_url_safe("http://192.168.1.1/") && !exa_url_safe("http://0.0.0.0/");
  #assert !exa_url_safe("http://172.16.0.1/") && !exa_url_safe("http://172.19.0.1/") && !exa_url_safe("http://172.20.0.1/") && !exa_url_safe("http://172.31.255.1/");
  #assert !exa_url_safe("http://172.016.0.1/") && exa_url_safe("http://172.0016.0.1/") && exa_url_safe("http://172.16") && exa_url_safe("http://172.16x.com/") && exa_url_safe("http://172.1:.0.1/");
  #assert !exa_is_172_private("172.1:.0.1");
  #assert !exa_url_safe("http://[::1]/") && !exa_url_safe("http://[a.b]/") && exa_url_safe("http://\\a.b/") && !exa_url_safe("http://metadata.google.internal/") && !exa_url_safe("http://box.local/");
  #assert !exa_url_safe("http://user@example.com/") && !exa_url_safe("http://metadata/compute") && !exa_url_safe("https://example.com/a b");

  // Control/DEL byte 127 vs byte 128 and 2048 vs 2049 length boundaries
  del_u: [20] u8;
  base_u := "https://exa.ai/a";
  for k: 0..<base_u.count { del_u[k] = base_u[k]; }
  del_u[base_u.count] = 127;
  #assert !exa_url_safe(cast(string) del_u[0..<base_u.count + 1]);
  del_u[base_u.count] = 128;
  #assert exa_url_safe(cast(string) del_u[0..<base_u.count + 1]);

  u2048: [2048] u8;
  u2049: [2049] u8;
  for k: 0..<base_u.count { u2048[k] = base_u[k]; u2049[k] = base_u[k]; }
  for k: base_u.count..<2048 { u2048[k] = 'x'; u2049[k] = 'x'; }
  u2049[2048] = 'x';
  #assert exa_url_safe(cast(string) u2048[..]) && !exa_url_safe(cast(string) u2049[..]);
}

#test "exa-policy: exact costDollars decimal parsing and retail ceiling markup" {
  #assert exa_cost_dollars_to_micros("0") == 0 && exa_cost_dollars_to_micros("0.0") == 0;
  #assert exa_cost_dollars_to_micros("-0.01") == 0 && exa_cost_dollars_to_micros("") == 0 && exa_cost_dollars_to_micros("abc") == 0;
  #assert exa_cost_dollars_to_micros("   ") == 0 && exa_cost_dollars_to_micros(".") == 0 && exa_cost_dollars_to_micros("+") == 0;
  #assert exa_cost_dollars_to_micros("!0.005") == 0 && exa_cost_dollars_to_micros("\n0.005") == 0 && exa_cost_dollars_to_micros(",1") == 0;
  #assert exa_cost_dollars_to_micros("0.00:") == 0 && exa_cost_dollars_to_micros("5F-3") == 0 && exa_cost_dollars_to_micros("5e") == 0;
  #assert exa_cost_dollars_to_micros("5e+") == 0 && exa_cost_dollars_to_micros("5e-") == 0 && exa_cost_dollars_to_micros("5e,1") == 0;
  #assert exa_cost_dollars_to_micros("5e-/") == 0 && exa_cost_dollars_to_micros("5e-:") == 0;
  #assert exa_cost_dollars_to_micros("0.005!") == 0 && exa_cost_dollars_to_micros("0.005\n") == 0 && exa_cost_dollars_to_micros("0.005x") == 0;

  #assert exa_cost_dollars_to_micros("1") == 1000000 && exa_cost_dollars_to_micros("10") == 10000000;
  #assert exa_cost_dollars_to_micros(".5") == 500000 && exa_cost_dollars_to_micros("+1") == 1000000 && exa_cost_dollars_to_micros("+0.005") == 5000;
  #assert exa_cost_dollars_to_micros(" 1") == 1000000 && exa_cost_dollars_to_micros("\t0.005") == 5000 && exa_cost_dollars_to_micros("  0.005") == 5000;
  #assert exa_cost_dollars_to_micros("0.005 ") == 5000 && exa_cost_dollars_to_micros("0.005\t") == 5000 && exa_cost_dollars_to_micros("0.005  ") == 5000;
  #assert exa_cost_dollars_to_micros("0.005") == 5000 && exa_cost_dollars_to_micros("0.009") == 9000;
  #assert exa_cost_dollars_to_micros("0.0125") == 12500;
  #assert exa_cost_dollars_to_micros("0.001") == 1000;
  #assert exa_cost_dollars_to_micros("1.5") == 1500000;
  #assert exa_cost_dollars_to_micros("0.0000001") == 1 && exa_cost_dollars_to_micros("0.0000011") == 2 && exa_cost_dollars_to_micros("0.0000123") == 13;
  #assert exa_cost_dollars_to_micros("5e-3") == 5000 && exa_cost_dollars_to_micros("5E-3") == 5000;
  #assert exa_cost_dollars_to_micros("5e1") == 50000000 && exa_cost_dollars_to_micros("5e+1") == 50000000;
  #assert exa_cost_dollars_to_micros("5e-0") == 5000000 && exa_cost_dollars_to_micros("5e-9") == 1 && exa_cost_dollars_to_micros("1e-25") == 1;
  #assert exa_cost_dollars_to_micros("1.25e-2") == 12500 && exa_cost_dollars_to_micros("1000000e-10") == 100;
  #assert exa_cost_dollars_to_micros("0000000000001") == 1000000 && exa_cost_dollars_to_micros("12.345678") == 12345678;
  #assert exa_cost_dollars_to_micros("1.000000000000") == 1000000 && exa_cost_dollars_to_micros("1.000000000001") == 1000001;
  #assert exa_cost_dollars_to_micros("1000000000000e-12") == 1000000 && exa_cost_dollars_to_micros("10000000000000000000e-18") == 10000000;
  #assert exa_cost_dollars_to_micros("100.000001") == 100000000 && exa_cost_dollars_to_micros("250") == 100000000 && exa_cost_dollars_to_micros("1e20") == 100000000;

  #assert exa_retail_micros(5000, 2500, 6250, 200) == 6250;
  #assert exa_retail_micros(1000, 2500, 1250, 200) == 1250;
  #assert exa_retail_micros(10000, 0, 0, 200) == 10000;
  #assert exa_retail_micros(10000, 1, 0, 200) == 10001;
  #assert exa_retail_micros(5000, -500, 6250, 200) == 5000;
  #assert exa_retail_micros(1, 2500, 6250, 200) == 2; // ceil(1 * 1.25) = 2
  #assert exa_retail_micros(0, 2500, 6250, 200) == 6250; // fallback when costDollars omitted
  #assert exa_retail_micros(0, 2500, 1, 200) == 1 && exa_retail_micros(0, 2500, -10, 200) == 0;
  #assert exa_retail_micros(5000, 2500, 6250, 502) == 0; // non-200 never charged

  #assert exa_upstream_micros(5000, 2500, 6250, 200) == 5000;
  #assert exa_upstream_micros(1, 2500, 6250, 200) == 1;
  #assert exa_upstream_micros(0, 2500, 6250, 200) == 5000;
  #assert exa_upstream_micros(-5, 2500, 6250, 200) == 5000;
  #assert exa_upstream_micros(0, 2500, 1250, 200) == 1000;
  #assert exa_upstream_micros(0, 0, 6250, 200) == 6250;
  #assert exa_upstream_micros(0, -500, 6250, 200) == 6250;
  #assert exa_upstream_micros(0, 1, 10001, 200) == 10000;
  #assert exa_upstream_micros(0, 2500, 0, 200) == 0 && exa_upstream_micros(0, 2500, -1250, 200) == 0;
  #assert exa_upstream_micros(0, 0, 1, 200) == 1;
  #assert exa_upstream_micros(5000, 2500, 6250, 502) == 0;
  #assert exa_upstream_micros(5000, 2500, 6250, 199) == 0 && exa_upstream_micros(5000, 2500, 6250, 201) == 0;

  #assert exa_msat_due(15625, 100000, false) == 15625;
  #assert exa_msat_due(15625, 100000, true) == 0;
  #assert exa_msat_due(0, 100000, false) == 0 && exa_msat_due(-100, 100000, false) == 0;
  #assert exa_msat_due(10000, 0, false) == 0 && exa_msat_due(10000, -100, false) == 0;
  #assert exa_msat_due(1, 100000, false) == 1 && exa_msat_due(1, 100001, false) == 1 && exa_msat_due(1, 99999, false) == 2;
  #assert exa_msat_due(2, 100000, false) == 2 && exa_msat_due(1, 1, false) == 100000;
}

#test "exa-policy: admission precheck and daily quota policy" {
  #assert exa_admit_precheck(false, true, 0, false, 0) == 400;
  #assert exa_admit_precheck(false, false, 100, true, 0) == 400;
  #assert exa_admit_precheck(true, true, 0, false, 9999999) == 200;
  #assert exa_admit_precheck(true, false, 0, true, 0) == 402;
  #assert exa_admit_precheck(true, false, -1, true, 0) == 402;
  #assert exa_admit_precheck(true, false, 1, false, 0) == 503;
  #assert exa_admit_precheck(true, false, 1, true, 3600000) == 200;
  #assert exa_admit_precheck(true, false, 1, true, 3600001) == 503;
  #assert exa_admit_precheck(true, false, 1, true, -10) == 200;

  #assert exa_admit_quota(1, 250, 0, 2000000) == 200;
  #assert exa_admit_quota(250, 250, 1999999, 2000000) == 200;
  #assert exa_admit_quota(251, 250, 0, 2000000) == 4291;
  #assert exa_admit_quota(1, 250, 2000000, 2000000) == 4292;
  #assert exa_admit_quota(1, 250, 2000001, 2000000) == 4292;
}
