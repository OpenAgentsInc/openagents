// Coax Web outbound HTTP client policy (Issue #14078):
//   - Scheme/host SSRF guard (https:// required in prod; http://127.0.0.1 or
//     http://localhost allowed only when allow_http_local is true)
//   - Mandatory connect/total timeout and max response-byte bounds
//   - Idempotent retry decision & bounded exponential backoff.
#authority;

HCP_MAX_TIMEOUT_MS :: 120000;
HCP_MAX_BYTES :: 16777216;
HCP_MAX_BACKOFF_MS :: 30000;

hcp_starts_with :: (s: string, prefix: string) -> bool #effects(all) {
  if s.count < prefix.count { return false; }
  for i: 0..<prefix.count { if s[i] != prefix[i] { return false; } }
  return true;
}

hcp_url_allowed :: (url: string, allow_http_local: bool) -> bool #export_c #effects(all) {
  if hcp_starts_with(url, "https://") {
    return url.count > 8 && !hcp_starts_with(url, "https://169.254.");
  }
  if allow_http_local {
    if hcp_starts_with(url, "http://127.0.0.1:") || hcp_starts_with(url, "http://127.0.0.1/") { return true; }
    if hcp_starts_with(url, "http://localhost:") || hcp_starts_with(url, "http://localhost/") { return true; }
  }
  return false;
}

hcp_timeout_valid :: (connect_ms: int, total_ms: int, max_bytes: int) -> bool #export_c #effects(all) {
  if connect_ms < 100 { return false; }
  if total_ms < connect_ms || total_ms > HCP_MAX_TIMEOUT_MS { return false; }
  return max_bytes >= 1 && max_bytes <= HCP_MAX_BYTES;
}

hcp_should_retry :: (status: int, attempt: int, max_attempts: int, idempotent: bool) -> bool #export_c #effects(all) {
  if !idempotent { return false; }
  if attempt >= max_attempts { return false; }
  return status == 0 || status == 429 || status >= 500;
}

hcp_backoff_ms :: (base_ms: int, attempt: int) -> int #export_c #effects(all) {
  if base_ms <= 0 || attempt < 0 { return -1; }
  if attempt > 6 { return HCP_MAX_BACKOFF_MS; }
  delay := base_ms;
  for step: 0..<attempt {
    delay = delay * 2;
  }
  return delay;
}

#test "url guard enforces https, blocks metadata/file, and scopes local http" {
  #assert hcp_url_allowed("https://a", false);
  #assert hcp_url_allowed("https://api.resend.com/emails", false);
  #assert !hcp_url_allowed("http", false);
  #assert !hcp_url_allowed("https://", false);
  #assert !hcp_url_allowed("xttps://api.resend.com/emails", false);
  #assert !hcp_url_allowed("https://169.254.169.254/latest", false);
  #assert !hcp_url_allowed("http://api.resend.com/emails", false);
  #assert !hcp_url_allowed("file:///etc/passwd", true);
  #assert !hcp_url_allowed("http://127.0.0.1:8080/x", false);
  #assert hcp_url_allowed("http://127.0.0.1:8080/x", true);
  #assert hcp_url_allowed("http://127.0.0.1/x", true);
  #assert hcp_url_allowed("http://localhost:8080/x", true);
  #assert hcp_url_allowed("http://localhost/x", true);
  #assert !hcp_url_allowed("http://169.254.169.254/x", true);
  #assert hcp_starts_with("https://", "https://");
}

#test "timeout and byte caps enforce exact boundaries" {
  #assert hcp_timeout_valid(100, 100, 1);
  #assert hcp_timeout_valid(1000, 120000, 16777216);
  #assert !hcp_timeout_valid(99, 1000, 64);
  #assert !hcp_timeout_valid(1000, 999, 64);
  #assert !hcp_timeout_valid(1000, 120001, 64);
  #assert !hcp_timeout_valid(1000, 5000, 0);
  #assert !hcp_timeout_valid(1000, 5000, 16777217);
}

#test "retry policy requires idempotency, remaining attempts, and transient status" {
  #assert hcp_should_retry(0, 1, 3, true);
  #assert hcp_should_retry(429, 1, 3, true);
  #assert hcp_should_retry(500, 1, 3, true);
  #assert hcp_should_retry(503, 2, 3, true);
  #assert !hcp_should_retry(500, 3, 3, true);
  #assert !hcp_should_retry(500, 1, 3, false);
  #assert !hcp_should_retry(400, 1, 3, true);
  #assert !hcp_should_retry(499, 1, 3, true);
  #assert !hcp_should_retry(200, 1, 3, true);
}

#test "backoff doubles up to attempt 6, caps at 30000 ms beyond, and rejects invalid args" {
  #assert hcp_backoff_ms(0, 1) == -1;
  #assert hcp_backoff_ms(-10, 1) == -1;
  #assert hcp_backoff_ms(500, -1) == -1;
  #assert hcp_backoff_ms(1, 0) == 1;
  #assert hcp_backoff_ms(500, 0) == 500;
  #assert hcp_backoff_ms(500, 1) == 1000;
  #assert hcp_backoff_ms(500, 2) == 2000;
  #assert hcp_backoff_ms(100, 6) == 6400;
  #assert hcp_backoff_ms(100, 7) == 30000;
}
