// Who the character chat's built-in characters are (#13261): POST /api/playtest/npc/ask names a
// character by id in a world (npc.c), and the persona the model is given comes from here, never
// from the page. Everglade's people and Fairy Forest's talkers are the constants their pages read
// (verse/everglade/people-words.coax, verse/fairy-forest/talk-words.coax), loaded here, so the two
// can't drift. The Haunted House's two are verse/haunt/house.json's npcs (packed into the page's
// Haunt.pb); test_npc.py fails when this table and house.json differ. A made realm's characters
// come from its document, in SQL (migrations/0156_npc_ask_keyed.sql).
//   coax/bin/coax test coax/web/api/npc-personas.coax --library
#load "../../../verse/everglade/people-words.coax";
#load "../../../verse/fairy-forest/talk-words.coax";
#load "../../lib/json/json.coax";

// The Haunted House's people (house.json's npcs: id, name, role, the first greeting). Their
// controls are the house's, verse.npc_request's own (an empty controls).
HH_PEOPLE :: 2;
HH_ID :: [HH_PEOPLE] string.["mortimer", "agatha"];
HH_NAME :: [HH_PEOPLE] string.["Mortimer", "Agatha"];
HH_ROLE :: [HH_PEOPLE] string.["caretaker", "witch"];
HH_GREET :: [HH_PEOPLE] string.["Evening. The house takes visitors after dark. The front door is open.", "Come in, come in. Mind the cat."];
HH_WORLD :: "Haunted House";

NPC_KNOWS :: 4096;   // what a character knows, at most (verse.npc_request keeps 4000)

// The persona of the character id in world ("everglade", "fairy-forest", "haunted-house") as JSON:
// {"name", "role", "greet", "knowledge", "world", "controls"}. Its length, -1 when there is no such
// character or it doesn't fit out.
npc_persona :: (world: string, id: string, out: [] u8) -> int #export_c #effects(all) {
  knows: [NPC_KNOWS] u8;
  k := 0;
  name: [16] u8;
  o: [1] Jo; jo_start(o[..], out);
  if world == EG_WORLD_ID {
    i := eg_person_of(id);
    if i < 0 { return -1; }
    k = npc_cat(knows[..], k, EG_CITY);
    npc_write(o[..], EG_PERSON[i], eg_words_role(i), EG_GREET[i], cast(string) knows[0..<k], EG_WORLD, EG_CONTROLS);
  } else if world == FF_WORLD_ID {
    c := ff_talker_of(id);
    if c < 0 { return -1; }
    nn := ff_name(c, name[..]);
    k = npc_cat(knows[..], k, FF_VALLEY);
    if c == FF_WOODCUTTER {
      k = npc_cat(knows[..], k, " "); k = npc_cat(knows[..], k, FF_ROWAN_KNOWS); k = npc_cat(knows[..], k, " "); k = npc_cat(knows[..], k, FF_ROWAN_SPEECH);
    } else {
      k = npc_cat(knows[..], k, " Your trouble: "); k = npc_cat(knows[..], k, FF_TROUBLE[c]); k = npc_cat(knows[..], k, " "); k = npc_cat(knows[..], k, FF_CREATURE_SPEECH);
    }
    npc_write(o[..], cast(string) name[0..<nn], ifx c == FF_WOODCUTTER then FF_ROWAN_PERSONA else FF_PERSONA[c], "",
              cast(string) knows[0..<k], FF_WORLD, FF_TALK_CONTROLS);
  } else if world == "haunted-house" {
    h := -1;
    for j: 0..<HH_PEOPLE { if HH_ID[j] == id { h = j; } }
    if h < 0 { return -1; }
    npc_write(o[..], HH_NAME[h], HH_ROLE[h], HH_GREET[h], "", HH_WORLD, "");
  } else {
    return -1;
  }
  if o[0].bad || k >= NPC_KNOWS { return -1; }
  return o[0].n;
}

npc_cat :: (out: [] u8, at: int, text: string) -> int #effects(all) {
  n := at;
  for i: 0..<text.count { if n >= out.count { return out.count; } out[n] = text[i]; n += 1; }
  return n;
}
npc_write :: (o: [] Jo, name: string, role: string, greet: string, knows: string, world: string, controls: string) #effects(all) {
  jo_obj(o);
  jo_key(o, "name"); jo_str(o, name);
  jo_key(o, "role"); jo_str(o, role);
  jo_key(o, "greet"); jo_str(o, greet);
  jo_key(o, "knowledge"); jo_str(o, knows);
  jo_key(o, "world"); jo_str(o, world);
  jo_key(o, "controls"); jo_str(o, controls);
  jo_end(o);
}

npc_has :: (text: string, part: string) -> bool {
  if part.count > text.count { return false; }
  for i: 0..<text.count - part.count + 1 { if text[i..<i + part.count] == part { return true; } }
  return false;
}

#test "each world's characters by id: the pages' own constants, as JSON" {
  out: [8192] u8;
  n := npc_persona("everglade", "marta", out[..]);
  p := cast(string) out[0..<n];
  #assert n > 0 && npc_has(p, "{\"name\":\"Marta\",\"role\":\"the innkeeper of the Everglade inn on Inn Street\",\"greet\":\"Come in out of the woods. There's a fire going.\",\"knowledge\":\"Everglade is a city in a forest.");
  #assert npc_has(p, "\"world\":\"Everglade\",\"controls\":\"W A S D or the arrows");
  n = npc_persona("everglade", "pebble", out[..]);
  #assert n > 0 && npc_has(cast(string) out[0..<n], "\"role\":\"a cat. You talk as a cat would");
  for i: 0..<EG_PEOPLE { b: [64] u8; m := eg_person_id(i, b[..]); #assert npc_persona("everglade", cast(string) b[0..<m], out[..]) > 0; }
  n = npc_persona("fairy-forest", "bramble", out[..]);
  p = cast(string) out[0..<n];
  #assert n > 0 && npc_has(p, "{\"name\":\"Bramble\",\"role\":\"a shy, fussy hedgehog") && npc_has(p, " Your trouble: Mossbank has gone grey")
          && npc_has(p, "Speak as a small forest creature") && npc_has(p, "\"world\":\"Fairy Forest\"");
  n = npc_persona("fairy-forest", "rowan", out[..]);
  p = cast(string) out[0..<n];
  #assert n > 0 && npc_has(p, "{\"name\":\"Rowan\",\"role\":\"an old woodcutter") && npc_has(p, "You cut only deadwood") && !npc_has(p, "Your trouble");
  n = npc_persona("haunted-house", "agatha", out[..]);
  #assert cast(string) out[0..<n] == "{\"name\":\"Agatha\",\"role\":\"witch\",\"greet\":\"Come in, come in. Mind the cat.\",\"knowledge\":\"\",\"world\":\"Haunted House\",\"controls\":\"\"}";
}

#test "an unknown character, an unknown world or too small a buffer is -1" {
  out: [8192] u8;
  #assert npc_persona("everglade", "nobody", out[..]) == -1 && npc_persona("everglade", "", out[..]) == -1;
  #assert npc_persona("fairy-forest", "Bramble", out[..]) == -1 && npc_persona("haunted-house", "guest-1", out[..]) == -1;
  #assert npc_persona("made", "marta", out[..]) == -1 && npc_persona("", "", out[..]) == -1;
  small: [64] u8;
  #assert npc_persona("everglade", "marta", small[..]) == -1;
}
