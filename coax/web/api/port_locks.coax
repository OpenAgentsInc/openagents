// The TCP ports of one coax/web/api/test.sh run, reserved until the run ends (#13331).
//
//   coax/web/tool.sh coax/web/api/port_locks.coax OUT PID NAME:LOW:WIDTH...
//
// The run takes one slot K of PL_SLOTS. Slot K gives each NAME the block of
// WIDTH ports from LOW + K * WIDTH, every block inside [LOW, LOW + 800). A slot
// is taken when its lock file (slot-K.lock in $OA_TEST_PORT_LOCKS, default
// /tmp/oa-test-ports-$USER) is flocked and every port of every block binds now;
// OUT then gets NAME=FIRST lines, and the tool holds the lock while process PID
// (test.sh) lives, or until test.sh's exit trap kills it. The kernel drops a
// flock when its holder dies, so a lock is never left behind.
//
// Why (#13331): test.sh used to probe a random port, let it go and bind it
// minutes later in a test_*.py file. Another run on the same host (agents and
// the pipeline's parts run side by side) could take it meanwhile, and so could
// the kernel: the old ranges (45000-59999) were inside Linux's ephemeral ports
// (32768-60999), handed to any outgoing connection on a busy build host. The
// test then failed with "Address already in use". Now runs of this suite never
// share a slot, and the ranges test.sh asks for are below 20000: under the
// kernels' ephemeral ports (Linux 32768+, macOS 49152+) and under the random
// ports the repository's other checks pick (20000-39999).
#import "Basic";
#load "../../lib/sys/tool.coax";
#load "../../lib/sys/fs.coax";
#load "../../lib/sys/proc.coax";
#load "../../lib/net/socket_foreign.coax";

cxproc_pid_alive :: (pid: int) -> int #foreign #effects(all);

PL_SPAN :: 800;
PL_SLOTS :: 100;   // PL_SPAN / 8, the widest block test.sh asks for
PL_MAX :: 32;

pl_put :: (out: [] u8, at: int, s: string) -> int #effects(all) {
  if at < 0 || at + s.count > out.count { return -1; }
  for i: 0..<s.count { out[at + i] = s[i]; }
  return at + s.count;
}
pl_digits :: (out: [] u8, at: int, v: int) -> int #effects(all) {
  tmp: [12] u8; k := 0; x := v;
  while true {
    tmp[k] = cast(u8) ('0' + x % 10); x /= 10; k += 1;
    if x == 0 { break; }
  }
  if at < 0 || at + k > out.count { return -1; }
  for i: 0..<k { out[at + i] = tmp[k - 1 - i]; }
  return at + k;
}
// Whether port binds on 127.0.0.1 now (the probe lets it go at once).
pl_free :: (port: int) -> bool #effects(all) {
  h := cxsock_listen(port);
  if h < 0 { return false; }
  r := cxsock_close(h);
  return true;
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 3 {
    tool_errln("usage: port_locks.coax OUT PID NAME:LOW:WIDTH...");
    return 2;
  }
  out := args_at(a[..], 0);
  parent := args_whole(args_at(a[..], 1));
  n := args_count(a[..]) - 2;
  if parent < 2 || n > PL_MAX { tool_errln("port_locks: a bad PID or too many names"); return 2; }
  names: [PL_MAX] string; lows: [PL_MAX] int; widths: [PL_MAX] int;
  for i: 0..<n {
    spec := args_at(a[..], i + 2);
    c1 := -1; c2 := -1;
    for c, j: spec { if c == ':' { if c1 < 0 { c1 = j; } else if c2 < 0 { c2 = j; } } }
    if c1 < 1 || c2 < c1 + 2 || c2 + 1 >= spec.count { tool_errln("port_locks: not NAME:LOW:WIDTH"); return 2; }
    names[i] = spec[0..<c1];
    lows[i] = args_whole(spec[c1 + 1..<c2]);
    widths[i] = args_whole(spec[c2 + 1..<spec.count]);
    if lows[i] < 1024 || widths[i] < 1 || widths[i] * PL_SLOTS > PL_SPAN || lows[i] + PL_SPAN > 65536 {
      tool_errln("port_locks: LOW under 1024, or a block wider than 8");
      return 2;
    }
  }
  dirb: [1024] u8; env: [256] u8;
  dir := proc_getenv("OA_TEST_PORT_LOCKS", dirb[..]);
  if dir.count == 0 {
    user := proc_getenv("USER", env[..]);
    k := pl_put(dirb[..], 0, "/tmp/oa-test-ports-");
    k = pl_put(dirb[..], k, ifx user.count > 0 then user else "anyone");
    if k < 0 { return 1; }
    dir = cast(string) dirb[0..<k];
  }
  if !fs_mkdir(dir) { tool_errln("port_locks: cannot make the lock directory"); return 1; }
  start := (proc_now_ns() / 1000 + parent) % PL_SLOTS;
  slot := -1;
  for t: 0..<PL_SLOTS {
    k := (start + t) % PL_SLOTS;
    nb: [32] u8; pb: [1024] u8;
    m := pl_put(nb[..], 0, "slot-"); m = pl_digits(nb[..], m, k); m = pl_put(nb[..], m, ".lock");
    if m < 0 { return 1; }
    lock := fs_join(dir, cast(string) nb[0..<m], pb[..]);
    if !fs_try_lock(lock) { continue; }
    free := true;
    for i: 0..<n {
      for p: 0..<widths[i] { if free && !pl_free(lows[i] + k * widths[i] + p) { free = false; } }
    }
    if free { slot = k; break; }
    u := fs_unlock();
  }
  if slot < 0 { tool_errln("port_locks: every slot is taken or busy"); return 1; }
  text: [4096] u8; w := 0;
  for i: 0..<n {
    w = pl_put(text[..], w, names[i]); w = pl_put(text[..], w, "=");
    w = pl_digits(text[..], w, lows[i] + slot * widths[i]); w = pl_put(text[..], w, "\n");
  }
  tb: [1100] u8;
  m := pl_put(tb[..], 0, out); m = pl_put(tb[..], m, ".tmp");
  if w < 0 || m < 0 { return 1; }
  tmp := cast(string) tb[0..<m];
  if !fs_write(tmp, cast(string) text[0..<w]) || !fs_rename(tmp, out) { tool_errln("port_locks: cannot write OUT"); return 1; }
  while cxproc_pid_alive(parent) == 1 { proc_sleep(1000); }
  return 0;
}
