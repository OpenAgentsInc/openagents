// The goldens of what realms.c writes itself (Protocol E11, GitHub #13250):
// proto/verse/realm-wire-v1alpha1.json holds the bytes realms.c wrote before realm-wire.coax, byte
// for byte. For each one this check
//   - writes it through realm-wire.coax from its values, and requires the same bytes;
//   - holds a JSON body's keys to the json_names of its message: a refusal to ErrorReply
//     (proto/descriptors/api-routes.pb), the card's answer to CardReply and a visibility's answer
//     to VisibilityReply (proto/descriptors/verse-doc.pb), each exactly or in any order as the
//     fixture's writer says; a refusal also goes through the JSON mapper and comes back the same;
//   - requires an answer with `page` added to be JSON whose last member is page.
// The realm routes' own tests (coax/web/api/test_realm_builder.py, test_realm_rights.py,
// tests/realm_record_checks.coax) hold the same bytes through the API.
//
//   coax/web/tool.sh coax/web/api/realm-wire-goldens.coax [proto/verse/realm-wire-v1alpha1.json]
#import "Basic";
#import_proto "../../../proto/descriptors/api-routes.pb" as AR;
#load "realm-wire.coax";
#load "../../lib/proto/json.coax";
#load "../../lib/proto/importer.coax";
#load "../../lib/proto/golden-keys.coax";
#load "../../lib/sys/tool.coax";
#load "../../lib/sys/args.coax";
#load "../../lib/sys/fs.coax";

RG_FIXTURE :: "proto/verse/realm-wire-v1alpha1.json";
RG_API :: "proto/descriptors/api-routes.pb";
RG_DOC :: "proto/descriptors/verse-doc.pb";
RG_BODY :: 8192;
RG_N :: 6;
RG_WRITERS :: [RG_N] string.["error", "paged", "paged-spaced", "card", "lines", "words"];

RgText :: struct { b: [RG_BODY] u8; n: int; }
rg_s :: (d: Jv, at: int, key: string, t: [] RgText) -> string {
  t[0].n = jv_str(d, jv_get(d, at, key), t[0].b[..]);
  return ifx t[0].n < 0 then "" else cast(string) t[0].b[0..<t[0].n];
}
rg_b :: (d: Jv, at: int, key: string) -> bool { return jv_kind(d, jv_get(d, at, key)) == JV_TRUE; }

// A golden written from its values (the writer's arguments): its length in out, or -1.
rg_write :: (writer: string, d: Jv, v: int, out: [] u8) -> int {
  a: [1] RgText; b: [1] RgText;
  if writer == "error" { return rlw_error_write(rg_s(d, v, "text", a[..]), out); }
  if writer == "paged" { return rlw_paged_write(rg_s(d, v, "answer", a[..]), rg_b(d, v, "paged"), false, out); }
  if writer == "paged-spaced" { return rlw_paged_write(rg_s(d, v, "answer", a[..]), rg_b(d, v, "paged"), true, out); }
  if writer == "card" { return rlw_card_write(rg_s(d, v, "slug", a[..]), rg_s(d, v, "at", b[..]), rg_b(d, v, "paged"), out); }
  if writer == "lines" { return rlw_made_lines_write(rg_s(d, v, "slug", a[..]), rg_b(d, v, "paged"), out); }
  if writer == "words" { return rlw_error_words(rg_s(d, v, "answer", a[..]), out); }
  return -1;
}
// Whether the JSON mapper reads a refusal and writes it back byte for byte.
rg_mapper :: (body: string) -> bool {
  nodes: [512] JvNode; wire: [4096] u8; out: [4096] u8;
  m := AR_ErrorReply_from_json(body, nodes[..], wire[..]); if m.error != 0 { return false; }
  v := AR_ErrorReply_to_json(m, out[..]); return v.error == 0 && cast(string) v.wire == body;
}
// A body's faults against the descriptors: "" when it holds.
rg_body :: (api: [] D_State, doc: [] D_State, writer: string, body: string, nodes: [] JvNode) -> string {
  if writer == "lines" || writer == "words" { return ""; }   // text, not JSON
  if writer == "error" {
    why := pk_text_keys(api, ".openagents.api.v1alpha1.ErrorReply", body, true, false, nodes);
    if why != "" { return why; }
    return ifx rg_mapper(body) then "" else "the JSON mapper does not write it back byte for byte";
  }
  if writer == "card" { return pk_text_keys(doc, ".openagents.verse.doc.v1alpha1.CardReply", body, true, false, nodes); }
  j: [1] Jv;
  if !jv_parse(j[..], body, nodes) || jv_kind(j[0], 0) != JV_OBJECT || jv_len(j[0], 0) < 1 { return "with page added it is not a JSON object"; }
  last := jv_at(j[0], 0, jv_len(j[0], 0) - 1);
  if jv_key(j[0], last) != "page" || (jv_kind(j[0], last) != JV_TRUE && jv_kind(j[0], last) != JV_FALSE) { return "its last member is not page, true or false"; }
  if writer == "paged-spaced" { return pk_text_keys(doc, ".openagents.verse.doc.v1alpha1.VisibilityReply", body, false, false, nodes); }
  return "";
}

RgWork :: struct { nodes: [8192] JvNode; body_nodes: [1024] JvNode; name: [256] u8; writer: [64] u8; body: [RG_BODY] u8; out: [RG_BODY] u8; }
rg_check :: (text: string, api: [] D_State, doc: [] D_State, w: [] RgWork) -> int {
  j: [1] Jv;
  if !jv_parse(j[..], text, w[0].nodes[..]) || jv_kind(j[0], 0) != JV_OBJECT { print("FAIL  cannot parse the fixture\n"); return 1; }
  d := j[0];
  goldens := jv_get(d, 0, "goldens");
  if jv_kind(d, goldens) != JV_ARRAY || jv_len(d, goldens) == 0 { print("FAIL  no goldens\n"); return 1; }
  writers := RG_WRITERS; seen: [RG_N] bool; bad := 0;
  for i: 0..<jv_len(d, goldens) {
    item := jv_at(d, goldens, i);
    name := cast(string) w[0].name[0..<jv_str(d, jv_get(d, item, "name"), w[0].name[..])];
    writer := cast(string) w[0].writer[0..<jv_str(d, jv_get(d, item, "writer"), w[0].writer[..])];
    bn := jv_str(d, jv_get(d, item, "body"), w[0].body[..]);
    want := ifx bn < 0 then "" else cast(string) w[0].body[0..<bn];
    k := -1;
    for q: 0..<RG_N { if writers[q] == writer { k = q; } }
    if k < 0 || bn < 0 { print("FAIL  % : no writer % or no body\n", name, writer); bad += 1; continue; }
    seen[k] = true;
    n := rg_write(writer, d, jv_get(d, item, "values"), w[0].out[..]);
    got := ifx n < 0 then "" else cast(string) w[0].out[0..<n];
    if n < 0 || got != want { print("FAIL  % (%):\n  want: %\n  got:  %\n", name, writer, want, got); bad += 1; continue; }
    why := rg_body(api, doc, writer, want, w[0].body_nodes[..]);
    if why != "" { print("FAIL  % (%): %\n", name, writer, why); bad += 1; } else { print("ok    % (%)\n", name, writer); }
  }
  for q: 0..<RG_N { if !seen[q] { print("FAIL  writer % has no golden\n", writers[q]); bad += 1; } }
  print("%\n", ifx bad == 0 then "realm wire goldens hold" else "realm wire goldens fail");
  return ifx bad == 0 then 0 else 1;
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  loaded := args_load(args[..]);
  pb: [65536] u8; g: [1] PkDescriptor; h: [1] PkDescriptor;
  pn := fs_read(RG_API, pb[..]);
  if pn <= 0 { tool_errln("realm-wire-goldens: cannot read the API descriptor"); return 2; }
  err := pk_load(g[..], cast(string) pb[0..<pn]);
  if err != "" { print("FAIL  descriptor: %\n", err); return 1; }
  qb: [65536] u8;
  qn := fs_read(RG_DOC, qb[..]);
  if qn <= 0 { tool_errln("realm-wire-goldens: cannot read the realm descriptor"); return 2; }
  err = pk_load(h[..], cast(string) qb[0..<qn]);
  if err != "" { print("FAIL  descriptor: %\n", err); return 1; }
  api := g[0].state[..]; doc := h[0].state[..];
  w: [1] RgWork;
  // the checks bite: a key the message lacks, a spaced refusal, a card with a member missing,
  // an answer whose last member is not page, a visibility with a key that is not its own
  if rg_body(api, doc, "error", "{\"eror\":\"x\"}", w[0].body_nodes[..]) == "" ||
     rg_body(api, doc, "error", "{\"error\": \"x\"}", w[0].body_nodes[..]) == "" ||
     rg_body(api, doc, "card", "{\"image\":\"/worlds/s/card.jpg?v=0\"}", w[0].body_nodes[..]) == "" ||
     rg_body(api, doc, "card", "{\"page\":true,\"image\":\"/worlds/s/card.jpg?v=0\"}", w[0].body_nodes[..]) == "" ||
     rg_body(api, doc, "paged", "{\"page\":true,\"slug\": \"s\"}", w[0].body_nodes[..]) == "" ||
     rg_body(api, doc, "paged", "{\"slug\": \"s\",\"page\":1}", w[0].body_nodes[..]) == "" ||
     rg_body(api, doc, "paged-spaced", "{\"is\": \"private\", \"slug\": \"s\", \"page\": true}", w[0].body_nodes[..]) == "" {
    print("FAIL  the check takes a body it should refuse\n"); return 1;
  }
  path := ifx loaded && args_count(args[..]) >= 1 then args_at(args[..], 0) else RG_FIXTURE;
  buf: [262144] u8;
  n := fs_read(path, buf[..]);
  if n <= 0 { tool_errln("realm-wire-goldens: cannot read the fixture"); return 2; }
  return rg_check(cast(string) buf[0..<n], api, doc, w[..]);
}
