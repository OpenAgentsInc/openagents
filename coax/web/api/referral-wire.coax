  rfw_line_int(o[..], "bonus_micros", bonus_micros);
  rfw_line_int(o[..], "github_bonus_micros", github_bonus_micros);
  rfw_line_int(o[..], "terms_version", terms_version);
  return aw_len(o[..]);
}

// ---- POST /api/v1/referral/redeem

rfw_redeem_req_read :: (raw: string, code_out: [] u8, source_out: [] u8, show_to_inviter: [] int) -> int #export_c #effects(all) {
  if show_to_inviter.count < 1 { return -1; }
  nodes: [32] JvNode; d: [1] Jv;
  if !jv_parse(d[..], raw, nodes[..]) { return -1; }
  v := d[0];
  cn := jv_str(v, jv_get(v, 0, "code"), code_out);
  if cn < 1 { return -1; }
  sn := jv_str(v, jv_get(v, 0, "source"), source_out);
  if sn < 1 {
    def := "typed";
    if source_out.count >= def.count {
      for i: 0..<def.count { source_out[i] = def[i]; }
    }
  }
  si := jv_get(v, 0, "show_to_inviter");
  if si >= 0 { // mutant: equivalent — jv_get returns -1 or a child node index > 0
    k := v.nodes[si].kind;
    if k != JV_TRUE && k != JV_FALSE { return -1; }
    show_to_inviter[0] = ifx jv_bool(v, si) then 1 else 0;
  } else {
    show_to_inviter[0] = 1;
  }
  return cn;
}

rfw_redeem_write :: (ok: bool, code: string, kind: string, bonus_micros: int,
                     status: string, message: string, out: [] u8) -> int #export_c #effects(all) {
  o: [1] Jo; aw_at(o[..], out, 0);
  jo_put(o[..], "{\"schema\":"); jo_quoted(o[..], RFW_SCHEMA_REDEEM);
  jo_put(o[..], ",\"ok\":"); rfw_put_bool(o[..], ok);
  jo_put(o[..], ",\"code\":"); jo_quoted(o[..], code);
  jo_put(o[..], ",\"kind\":"); jo_quoted(o[..], kind);
  jo_put(o[..], ",\"bonus_micros\":"); jo_int(o[..], bonus_micros);
  jo_put(o[..], ",\"status\":"); jo_quoted(o[..], status);
  jo_put(o[..], ",\"message\":"); jo_quoted(o[..], message);
  jo_put(o[..], "}");
  return aw_len(o[..]);
}

rfw_redeem_lines :: (ok: bool, code: string, kind: string, bonus_micros: int,
                     status: string, message: string, out: [] u8) -> int #export_c #effects(all) {
  o: [1] Jo; aw_at(o[..], out, 0);
  rfw_line_bool(o[..], "ok", ok);
  rfw_line_str(o[..], "code", code);
  rfw_line_str(o[..], "kind", kind);
  rfw_line_int(o[..], "bonus_micros", bonus_micros);
  rfw_line_str(o[..], "status", status);
  if message.count > 0 { rfw_line_str(o[..], "message", message); }
  return aw_len(o[..]);
}

// ---- POST /api/v1/referral/vanity

rfw_opt_bool :: (v: Jv, key: string, out: [] int, idx: int) -> bool #effects(all) {
  n := jv_get(v, 0, key);
  if n < 0 { out[idx] = -1; return true; } // mutant: equivalent — jv_get returns -1 or a child node index > 0
  k := v.nodes[n].kind;
  if k != JV_TRUE && k != JV_FALSE { return false; }
  out[idx] = ifx jv_bool(v, n) then 1 else 0;
  return true;
}

rfw_vanity_req_read :: (raw: string, vals: [] int) -> bool #export_c #effects(all) {
  if vals.count < 3 { return false; }
  nodes: [32] JvNode; d: [1] Jv;
  if !jv_parse(d[..], raw, nodes[..]) { return false; }
  v := d[0];
  if !rfw_opt_bool(v, "on", vals, 0) { return false; }
  if vals[0] == -1 && !rfw_opt_bool(v, "vanity_enabled", vals, 0) { return false; }
  if !rfw_opt_bool(v, "show_name", vals, 1) { return false; }
  if !rfw_opt_bool(v, "commit_footer_opt_in", vals, 2) { return false; }
  return vals[0] != -1 || vals[1] != -1 || vals[2] != -1;
}

rfw_vanity_write :: (vanity_enabled: bool, vanity: string, vanity_link: string,
                     show_name: bool, commit_footer_opt_in: bool, out: [] u8) -> int #export_c #effects(all) {
  o: [1] Jo; aw_at(o[..], out, 0);
  jo_put(o[..], "{\"schema\":"); jo_quoted(o[..], RFW_SCHEMA_VANITY);
  jo_put(o[..], ",\"vanity_enabled\":"); rfw_put_bool(o[..], vanity_enabled);
  jo_put(o[..], ",\"vanity\":"); jo_quoted(o[..], vanity);
  jo_put(o[..], ",\"vanity_link\":"); jo_quoted(o[..], vanity_link);
  jo_put(o[..], ",\"show_name\":"); rfw_put_bool(o[..], show_name);
  jo_put(o[..], ",\"commit_footer_opt_in\":"); rfw_put_bool(o[..], commit_footer_opt_in);
  jo_put(o[..], "}");
  return aw_len(o[..]);
}

rfw_vanity_lines :: (vanity_enabled: bool, vanity: string, vanity_link: string,
                     show_name: bool, commit_footer_opt_in: bool, out: [] u8) -> int #export_c #effects(all) {
  o: [1] Jo; aw_at(o[..], out, 0);
  rfw_line_bool(o[..], "vanity_enabled", vanity_enabled);
  if vanity.count > 0 { rfw_line_str(o[..], "vanity", vanity); }
  if vanity_link.count > 0 { rfw_line_str(o[..], "vanity_link", vanity_link); }
  rfw_line_bool(o[..], "show_name", show_name);
  rfw_line_bool(o[..], "commit_footer_opt_in", commit_footer_opt_in);
  return aw_len(o[..]);
}

