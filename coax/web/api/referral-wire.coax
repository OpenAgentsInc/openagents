// Closed wire codecs for /api/v1/referral/* (JSON and ?as=lines).
// Single codec registered in proto/registry.json (proto/verse/referral-v1.json).
// coax/web/api/referral.c calls only these #export_c writers/readers and builds no JSON of its own.
//
//   coax/bin/coax test coax/web/api/referral-wire.coax --library
//   coax/bin/coax mutate coax/web/api/referral-wire.coax --library
#load "api-wire.coax";

RFW_SCHEMA_SUMMARY :: "openagents.referral.summary.v1";
RFW_SCHEMA_LOOKUP :: "openagents.referral.lookup.v1";
RFW_SCHEMA_REDEEM :: "openagents.referral.redeem.v1";
RFW_SCHEMA_VANITY :: "openagents.referral.vanity.v1";
RFW_SCHEMA_RECHECK :: "openagents.referral.recheck.v1";
RFW_SCHEMA_ADMIN :: "openagents.referral.admin.v1";

rfw_bit :: (b: bool) -> string #effects(all) { return ifx b then "1" else "0"; }
rfw_bool :: (b: bool) -> string #effects(all) { return ifx b then "true" else "false"; }
rfw_put_bool :: (o: [] Jo, b: bool) #effects(all) { jo_put(o, rfw_bool(b)); }
rfw_nonneg :: (n: int) -> int #effects(all) { return ifx n < 0 then 0 else n; } // mutant: equivalent — at n == 0 both branches equal 0

rfw_line_str :: (o: [] Jo, key: string, val: string) #effects(all) {
  jo_put(o, key); jo_put(o, " "); jo_put(o, val); jo_put(o, "\n");
}

rfw_line_int :: (o: [] Jo, key: string, val: int) #effects(all) {
  jo_put(o, key); jo_put(o, " "); jo_int(o, val); jo_put(o, "\n");
}

rfw_line_bool :: (o: [] Jo, key: string, val: bool) #effects(all) {
  jo_put(o, key); jo_put(o, " "); jo_put(o, rfw_bit(val)); jo_put(o, "\n");
}

// ---- item step writers (grants & privacy-safe invitees)

rfw_grant_item_write :: (first: bool, id: int, kind: string, amount_micros: int,
                         status: string, reason: string, created_at: string,
                         expires_at: string, out: [] u8, at: int) -> int #export_c #effects(all) {
  o: [1] Jo; aw_at(o[..], out, at);
  if !first { jo_put(o[..], ","); }
  jo_put(o[..], "{\"id\":"); jo_int(o[..], id);
  jo_put(o[..], ",\"kind\":"); jo_quoted(o[..], kind);
  jo_put(o[..], ",\"amount_micros\":"); jo_int(o[..], amount_micros);
  jo_put(o[..], ",\"status\":"); jo_quoted(o[..], status);
  jo_put(o[..], ",\"reason\":"); jo_quoted(o[..], reason);
  jo_put(o[..], ",\"created_at\":"); jo_quoted(o[..], created_at);
  jo_put(o[..], ",\"expires_at\":"); jo_quoted(o[..], expires_at);
  jo_put(o[..], "}");
  return aw_len(o[..]);
}

rfw_invitee_item_write :: (first: bool, status: string, handle: string, active_days: int,
                           bound_at: string, out: [] u8, at: int) -> int #export_c #effects(all) {
  o: [1] Jo; aw_at(o[..], out, at);
  if !first { jo_put(o[..], ","); }
  jo_put(o[..], "{\"status\":"); jo_quoted(o[..], status);
  jo_put(o[..], ",\"handle\":"); jo_quoted(o[..], handle);
  jo_put(o[..], ",\"active_days\":"); jo_int(o[..], active_days);
  jo_put(o[..], ",\"bound_at\":"); jo_quoted(o[..], bound_at);
  jo_put(o[..], "}");
  return aw_len(o[..]);
}

// ---- GET /api/v1/referral

rfw_summary_write :: (code: string, vanity: string, vanity_enabled: bool,
                      link: string, vanity_link: string,
                      show_name: bool, commit_footer_opt_in: bool,
                      clicks: int, signups: int, pending_invitees: int, activated_invitees: int,
                      promo_micros: int, promo_expires_at: string,
                      promo_daily_spent: int, promo_daily_cap: int,
                      bonus_earned_micros: int, kickback_earned_micros: int, kickback_today_micros: int,
                      milestones_mask: int,
                      gh_connected: bool, gh_eligible: bool, gh_login: string, gh_reason: string,
                      attributed: bool, can_redeem: bool,
                      flag_redeem: bool, flag_grants: bool, flag_kickback: bool, flag_github_connect: bool,
                      grants_json: string, invitees_json: string, out: [] u8) -> int #export_c #effects(all) {
  o: [1] Jo; aw_at(o[..], out, 0);
  jo_put(o[..], "{\"schema\":"); jo_quoted(o[..], RFW_SCHEMA_SUMMARY);
  jo_put(o[..], ",\"code\":"); jo_quoted(o[..], code);
  jo_put(o[..], ",\"vanity\":"); jo_quoted(o[..], vanity);
  jo_put(o[..], ",\"vanity_enabled\":"); rfw_put_bool(o[..], vanity_enabled);
  jo_put(o[..], ",\"link\":"); jo_quoted(o[..], link);
  jo_put(o[..], ",\"vanity_link\":"); jo_quoted(o[..], vanity_link);
  jo_put(o[..], ",\"show_name\":"); rfw_put_bool(o[..], show_name);
  jo_put(o[..], ",\"commit_footer_opt_in\":"); rfw_put_bool(o[..], commit_footer_opt_in);
  jo_put(o[..], ",\"clicks\":"); jo_int(o[..], clicks);
  jo_put(o[..], ",\"signups\":"); jo_int(o[..], signups);
  jo_put(o[..], ",\"pending_invitees\":"); jo_int(o[..], pending_invitees);
  jo_put(o[..], ",\"activated_invitees\":"); jo_int(o[..], activated_invitees);
  jo_put(o[..], ",\"promo_micros\":"); jo_int(o[..], promo_micros);
  jo_put(o[..], ",\"promo_expires_at\":"); jo_quoted(o[..], promo_expires_at);
  jo_put(o[..], ",\"promo_daily_spent\":"); jo_int(o[..], promo_daily_spent);
  jo_put(o[..], ",\"promo_daily_cap\":"); jo_int(o[..], promo_daily_cap);
  jo_put(o[..], ",\"bonus_earned_micros\":"); jo_int(o[..], bonus_earned_micros);
  jo_put(o[..], ",\"kickback_earned_micros\":"); jo_int(o[..], kickback_earned_micros);
  jo_put(o[..], ",\"kickback_today_micros\":"); jo_int(o[..], kickback_today_micros);
  jo_put(o[..], ",\"milestones_mask\":"); jo_int(o[..], milestones_mask);
  jo_put(o[..], ",\"gh_connected\":"); rfw_put_bool(o[..], gh_connected);
  jo_put(o[..], ",\"gh_eligible\":"); rfw_put_bool(o[..], gh_eligible);
  jo_put(o[..], ",\"gh_login\":"); jo_quoted(o[..], gh_login);
  jo_put(o[..], ",\"gh_reason\":"); jo_quoted(o[..], gh_reason);
  jo_put(o[..], ",\"attributed\":"); rfw_put_bool(o[..], attributed);
  jo_put(o[..], ",\"can_redeem\":"); rfw_put_bool(o[..], can_redeem);
  jo_put(o[..], ",\"flags\":{\"referral_redeem\":"); rfw_put_bool(o[..], flag_redeem);
  jo_put(o[..], ",\"referral_grants\":"); rfw_put_bool(o[..], flag_grants);
  jo_put(o[..], ",\"referral_kickback\":"); rfw_put_bool(o[..], flag_kickback);
  jo_put(o[..], ",\"github_connect_grant\":"); rfw_put_bool(o[..], flag_github_connect);
  jo_put(o[..], "},\"grants\":["); jo_put(o[..], grants_json);
  jo_put(o[..], "],\"invitees\":["); jo_put(o[..], invitees_json);
  jo_put(o[..], "]}");
  return aw_len(o[..]);
}

rfw_summary_lines :: (code: string, vanity: string, vanity_enabled: bool,
                      link: string, vanity_link: string,
                      show_name: bool, commit_footer_opt_in: bool,
                      clicks: int, signups: int, pending_invitees: int, activated_invitees: int,
                      promo_micros: int, promo_expires_at: string,
                      promo_daily_spent: int, promo_daily_cap: int,
                      bonus_earned_micros: int, kickback_earned_micros: int, kickback_today_micros: int,
                      milestones_mask: int,
                      gh_connected: bool, gh_eligible: bool, gh_login: string, gh_reason: string,
                      attributed: bool, can_redeem: bool, out: [] u8) -> int #export_c #effects(all) {
  o: [1] Jo; aw_at(o[..], out, 0);
  rfw_line_str(o[..], "code", code);
  if vanity.count > 0 { rfw_line_str(o[..], "vanity", vanity); }
  rfw_line_bool(o[..], "vanity_enabled", vanity_enabled);
  rfw_line_str(o[..], "link", link);
  if vanity_link.count > 0 { rfw_line_str(o[..], "vanity_link", vanity_link); }
  rfw_line_bool(o[..], "show_name", show_name);
  rfw_line_bool(o[..], "commit_footer_opt_in", commit_footer_opt_in);
  rfw_line_int(o[..], "clicks", clicks);
  rfw_line_int(o[..], "signups", signups);
  rfw_line_int(o[..], "pending_invitees", pending_invitees);
  rfw_line_int(o[..], "activated_invitees", activated_invitees);
  rfw_line_int(o[..], "promo_micros", promo_micros);
  if promo_expires_at.count > 0 { rfw_line_str(o[..], "promo_expires_at", promo_expires_at); }
  rfw_line_int(o[..], "promo_daily_spent", promo_daily_spent);
  rfw_line_int(o[..], "promo_daily_cap", promo_daily_cap);
  rfw_line_int(o[..], "bonus_earned_micros", bonus_earned_micros);
  rfw_line_int(o[..], "kickback_earned_micros", kickback_earned_micros);
  rfw_line_int(o[..], "kickback_today_micros", kickback_today_micros);
  rfw_line_int(o[..], "milestones_mask", milestones_mask);
  rfw_line_bool(o[..], "gh_connected", gh_connected);
  rfw_line_bool(o[..], "gh_eligible", gh_eligible);
  if gh_login.count > 0 { rfw_line_str(o[..], "gh_login", gh_login); }
  if gh_reason.count > 0 { rfw_line_str(o[..], "gh_reason", gh_reason); }
  rfw_line_bool(o[..], "attributed", attributed);
  rfw_line_bool(o[..], "can_redeem", can_redeem);
  return aw_len(o[..]);
}

// ---- GET /api/v1/referral/lookup

rfw_lookup_write :: (valid: bool, kind: string, code: string,
                     inviter_handle: string, inviter_avatar: string,
                     bonus_micros: int, github_bonus_micros: int,
                     terms_version: int, out: [] u8) -> int #export_c #effects(all) {
  o: [1] Jo; aw_at(o[..], out, 0);
  jo_put(o[..], "{\"schema\":"); jo_quoted(o[..], RFW_SCHEMA_LOOKUP);
  jo_put(o[..], ",\"valid\":"); rfw_put_bool(o[..], valid);
  jo_put(o[..], ",\"kind\":"); jo_quoted(o[..], kind);
  jo_put(o[..], ",\"code\":"); jo_quoted(o[..], code);
  jo_put(o[..], ",\"inviter_handle\":"); jo_quoted(o[..], inviter_handle);
  jo_put(o[..], ",\"inviter_avatar\":"); jo_quoted(o[..], inviter_avatar);
  jo_put(o[..], ",\"bonus_micros\":"); jo_int(o[..], bonus_micros);
  jo_put(o[..], ",\"github_bonus_micros\":"); jo_int(o[..], github_bonus_micros);
  jo_put(o[..], ",\"terms_version\":"); jo_int(o[..], terms_version);
  jo_put(o[..], "}");
  return aw_len(o[..]);
}

rfw_lookup_lines :: (valid: bool, kind: string, code: string,
                     inviter_handle: string, inviter_avatar: string,
                     bonus_micros: int, github_bonus_micros: int,
                     terms_version: int, out: [] u8) -> int #export_c #effects(all) {
  o: [1] Jo; aw_at(o[..], out, 0);
  rfw_line_bool(o[..], "valid", valid);
  if kind.count > 0 { rfw_line_str(o[..], "kind", kind); }
  if code.count > 0 { rfw_line_str(o[..], "code", code); }
  if inviter_handle.count > 0 { rfw_line_str(o[..], "inviter_handle", inviter_handle); }
