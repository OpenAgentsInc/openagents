// What coax/web/api/seats.c writes itself (Protocol E11, GitHub #13250): seats.c calls the
// #export_c writers below through seat-wire.generated.c (api-sources.sh, deploy.sh, the Dockerfile)
// and builds no body of its own. The bodies are coax/lib/media/realm_seat_wire.coax's
// (proto/openagents/verse/seat/v1alpha1/seat.proto) and, for a refusal, api-wire.coax's ErrorReply:
//   stw_error_write          a refusal or a failure the route decides
//   stw_kept_write           POST .../<id>/keep, 200
//   stw_closed_write         POST .../<id>/close, 200
//   stw_grant_none_write     {}: a hosted seat's grant that could not be shown without its key
//   stw_runner_open_write    to the runner, /seat/open: the grant as SQL wrote it and the origin
//   stw_runner_close_write   to the runner, /seat/close
// The grant, the list and the action handed to the runner are SQL's, carried as they came. The
// bytes are the ones seats.c wrote before this file: proto/verse/realm-seat-v1alpha1.json holds
// them and seat-wire-goldens.coax writes each one through here. A writer returns the body's
// length, or -1 when it does not fit.
//   coax/bin/coax test coax/web/api/seat-wire.coax --library
#load "api-wire.coax";
#load "../../lib/media/realm_seat_wire.coax";

stw_error_write :: (text: string, out: [] u8) -> int #export_c #effects(all) {
  o: [1] Jo; aw_at(o[..], out, 0); aw_error(o[..], text); return aw_len(o[..]);
}
stw_kept_write :: (out: [] u8) -> int #export_c #effects(all) { return seatw_kept(out); }
stw_closed_write :: (out: [] u8) -> int #export_c #effects(all) { return seatw_closed(out); }
stw_grant_none_write :: (out: [] u8) -> int #export_c #effects(all) { return seatw_grant_none(out); }
stw_runner_open_write :: (seat: string, origin: string, out: [] u8) -> int #export_c #effects(all) { return seatw_runner_open(seat, origin, out); }
stw_runner_close_write :: (id: string, out: [] u8) -> int #export_c #effects(all) { return seatw_runner_close(id, out); }

#test "what seats.c writes: a refusal, kept, closed, and the runner's two bodies" {
  b: [256] u8;
  n := stw_error_write("no such open seat", b[..]);
  #assert cast(string) b[0..<n] == "{\"error\":\"no such open seat\"}" && stw_error_write("no such open seat", b[0..<n - 1]) == -1;
  n = stw_error_write("", b[..]);
  #assert cast(string) b[0..<n] == "{\"error\":\"\"}";
  n = stw_kept_write(b[..]);
  #assert cast(string) b[0..<n] == "{\"kept\":true}" && stw_kept_write(b[0..<12]) == -1;
  n = stw_closed_write(b[..]);
  #assert cast(string) b[0..<n] == "{\"closed\":true}" && stw_closed_write(b[0..<14]) == -1;
  n = stw_grant_none_write(b[..]);
  #assert cast(string) b[0..<n] == "{}" && stw_grant_none_write(b[0..<1]) == -1;
  n = stw_runner_open_write("{\"id\": 7}", "http://127.0.0.1:7000", b[..]);
  #assert cast(string) b[0..<n] == "{\"seat\":{\"id\": 7},\"origin\":\"http://127.0.0.1:7000\"}" && stw_runner_open_write("7", "o", b[..]) == -1;
  n = stw_runner_close_write("42", b[..]);
  #assert cast(string) b[0..<n] == "{\"id\":42}" && stw_runner_close_write("4x", b[..]) == -1;
}
