// Our own login's API checks (auth.c, migrations 0142 to 0146, docs/auth/; #13200 to #13205), run
// by test.sh after test.py: the gate (a route with no rule is 404; one credential at a time; L2
// and human-only rules), email codes and links (the browser that asked; tries; nothing kept in the
// clear), Nostr login (NIP-98 over a challenge, once), sessions (rotation, idle end, logout
// everywhere, freeze), app tokens (refresh, a reused one ends the login) and the limits, shown.
// Email goes to a fake Resend on RESEND_PORT: this program in its `mail` mode.
//   API=... PGURL=... PSQL=... SIGN=... RESEND_PORT=... coax/web/tool.sh coax/web/api/tests/auth_checks.coax
//   coax/web/tool.sh coax/web/api/tests/auth_checks.coax mail PORT DIR   (the fake Resend)
// tool.sh: tls
#load "auth_harness.coax";

ac_checks :: (t: [] Ap, dir: string) {
  out: [8192] u8; eb: [1024] u8;
  c1: [1] Sb; c2: [1] Sb; c3: [1] Sb;
  code: [6] u8; link: [64] u8;

  // ---- the gate
  ap_check(t, "a route with no rule is a 404", ac_call(t, "GET", "/api/no-such-route", "", "", "", "") == 404, ap_body(t));
  ap_check(t, "nobody: /api/auth/account says not logged in", ac_call(t, "GET", "/api/auth/account", "", "", "", "") == 200 && ap_member(ap_body(t), "logged_in", eb[..]) == "false", ap_body(t));
  ap_check(t, "nobody: the devices list asks you to log in", ac_call(t, "GET", "/api/auth/sessions", "", "", "", "") == 401
           && ap_member(ap_body(t), "error", eb[..]) == "Log in first.", ap_body(t));
  ap_check(t, "the limits are listed, every one with its number", ac_call(t, "GET", "/api/auth/limits", "", "", "", "") == 200
           && ap_has(ap_body(t), "\"email_hour\"") && ap_has(ap_body(t), "\"max\":5"), ap_body(t));

  // ---- email: a code, in the browser that asked
  pb: [128] u8; pend: [128] u8; pn := 0;
  st := ac_start(t, "Ada@Example.com", "203.0.113.20", false, pb[..]);
  p := ac_cookie(t, "__Host-oa_pending", pb[..]);
  ap_check(t, "an email code is sent, and the browser gets a pending cookie", st == 200 && p.count == 64 && ap_member(ap_body(t), "state", eb[..]) == "sent", ap_body(t));
  for i: 0..<p.count { pend[i] = p[i]; } pn = p.count;
  P := cast(string) pend[0..<pn];
  got := ac_mail(dir, code[..], link[..]);
  ap_check(t, "the mail holds a 6-digit code and a link", got, "");
  C := cast(string) code[..]; L := cast(string) link[..];
  ap_check(t, "nothing of the address is kept in the clear",
           ap_sql(t, "SELECT count(*) FROM auth.pending WHERE target_sealed ILIKE '%example%' OR target_lookup ILIKE '%example%'", out[..]) == "0"
           && ap_sql(t, "SELECT count(*) FROM auth.audit WHERE detail::text ILIKE '%example%'", out[..]) == "0", "");
  wrong := ifx C == "000000" then "111111" else "000000";
  wb: [1] Sb; sb(wb[..], "{\"code\":\""); sb(wb[..], wrong); sb(wb[..], "\"}");
  st = ac_call(t, "POST", "/api/auth/email/verify", sb_text(wb[..]), ac_cookie_header("__Host-oa_pending", P, c1[..]), "", "");
  ap_check(t, "a wrong code says how many tries are left", st == 401 && ap_member(ap_body(t), "error", eb[..]) == "That code isn't right. 4 tries left.", ap_body(t));
  vb: [1] Sb; sb(vb[..], "{\"code\":\""); sb(vb[..], C[0..<3]); sb(vb[..], " "); sb(vb[..], C[3..<6]); sb(vb[..], "\"}");
  st = ac_call(t, "POST", "/api/auth/email/verify", sb_text(vb[..]), "", "", "");
  ap_check(t, "the right code in another browser is refused", st == 409, ap_body(t));
  st = ac_call(t, "POST", "/api/auth/email/verify", sb_text(vb[..]), ac_cookie_header("__Host-oa_pending", P, c1[..]), "", "");
  sesb: [160] u8; ses := ac_cookie(t, "__Host-oa_session", sesb[..]);
  acb: [64] u8; acct := ap_member(ap_body(t), "account", acb[..]);
  ap_check(t, "the right code (typed with its space) logs in a new account", st == 200 && ap_starts(ses, "oas_") && ses.count == 62
           && ap_starts(acct, "acct_") && ap_member(ap_body(t), "new", eb[..]) == "true", ap_body(t));
  ap_check(t, "the session cookie is __Host-, HttpOnly, Secure", ap_has(ac_head(t), "__Host-oa_session=oas_") && ap_has(ac_head(t), "HttpOnly; Secure"), ac_head(t));
  S := ses;
  st = ac_call(t, "POST", "/api/auth/email/verify", sb_text(vb[..]), ac_cookie_header("__Host-oa_pending", P, c1[..]), "", "");
  ap_check(t, "a code logs in once", st == 409 || st == 410, ap_body(t));
  st = ac_call(t, "GET", "/api/auth/account", "", ac_cookie_header("__Host-oa_session", S, c1[..]), "", "");
  ap_check(t, "/api/auth/account knows the account at L1, the email list masked, the primary whole for its own name",
           st == 200 && ap_member(ap_body(t), "account", eb[..]) == acct && ap_has(ap_body(t), "\"level\":\"L1\"")
           && ap_has(ap_body(t), "\"emails\":[\"a•••@example.com\"]") && ap_has(ap_body(t), "\"primary\":\"ada@example.com\""), ap_body(t));
  q: [1] Sb; sb(q[..], "SELECT count(*) FROM auth.emails WHERE account = '"); sb(q[..], acct); sb(q[..], "' AND sealed ~ '^0[12][0-9a-f]+$' AND verified_at IS NOT NULL");
  ap_check(t, "the email is kept sealed under a key version", ap_sql(t, sb_text(q[..]), out[..]) == "1", "");
  st = ac_call(t, "GET", "/api/auth/sessions", "", ac_cookie_header("__Host-oa_session", S, c1[..]), "", "");
  ap_check(t, "the devices list shows this session as current", st == 200 && ap_has(ap_body(t), "\"this\": true"), ap_body(t));
  st = ac_call(t, "POST", "/api/auth/logout-everywhere", "", ac_cookie_header("__Host-oa_session", S, c1[..]), "", "");
  ap_check(t, "logging out everywhere asks for a key (L2) after an email login", st == 401
           && ap_member(ap_body(t), "error", eb[..]) == "Log in again with your key or passkey to do this.", ap_body(t));

  // the link: in the browser that asked it logs in; elsewhere it shows the code to type
  st = ac_start(t, "ada@example.com", "203.0.113.20", false, pb[..]);
  p2b: [128] u8; p2 := ac_cookie(t, "__Host-oa_pending", p2b[..]);
  got = ac_mail(dir, code[..], link[..]);
  lb: [1] Sb; sb(lb[..], "{\"t\":\""); sb(lb[..], cast(string) link[..]); sb(lb[..], "\"}");
  st = ac_call(t, "POST", "/api/auth/email/link", sb_text(lb[..]), "", "", "");
  ap_check(t, "the link in another browser shows the code to type where you asked", st == 409 && ap_member(ap_body(t), "state", eb[..]) == "elsewhere"
           && ap_has(ap_body(t), cast(string) code[0..<3]), ap_body(t));
  st = ac_call(t, "POST", "/api/auth/email/link", sb_text(lb[..]), ac_cookie_header("__Host-oa_pending", p2, c1[..]), "", "");
  ap_check(t, "the link in the browser that asked logs in to the same account", st == 200 && ap_member(ap_body(t), "account", eb[..]) == acct
           && ap_member(ap_body(t), "new", eb[..]) == "false", ap_body(t));
  l2b: [160] u8; L2 := ac_cookie(t, "__Host-oa_session", l2b[..]);
  st = ac_call(t, "POST", "/api/auth/logout", "", ac_cookie_header("__Host-oa_session", L2, c1[..]), "", "");
  ap_check(t, "logging out ends the session and clears its cookie", st == 200 && ap_has(ac_head(t), "__Host-oa_session=; Path=/; Max-Age=0"), ac_head(t));
  st = ac_call(t, "GET", "/api/auth/account", "", ac_cookie_header("__Host-oa_session", L2, c1[..]), "", "");
  ap_check(t, "a copied cookie replayed after logout is nobody", st == 200 && ap_member(ap_body(t), "logged_in", eb[..]) == "false", ap_body(t));

  // ---- the limits: shown, with when they lift
  i := 0; last := 0;
  while i < 8 { last = ac_start(t, "ada@example.com", "203.0.113.21", false, pb[..]); if last == 429 { break; } i += 1; }
  ap_check(t, "the sixth code this hour for one address is refused, and says when it lifts", last == 429
           && ap_member(ap_body(t), "limit", eb[..]) == "email_hour" && ap_has(ap_body(t), "Try again in ") && ap_header(t, "Retry-After") != "", ap_body(t));
  ap_check(t, "every refusal is in the audit log, with no address",
           ap_sql(t, "SELECT count(*) FROM auth.audit WHERE action = 'login.email' AND result = 'refused'", out[..]) != "0"
           && ap_sql(t, "SELECT count(*) FROM auth.audit WHERE detail::text ILIKE '%@%'", out[..]) == "0", "");

  // ---- Nostr: sign the challenge (NIP-98 over the route and its body), once
  kb: [2048] u8; other := proc_getenv("OTHER_KEY", kb[..]);
  st = ac_call(t, "POST", "/api/auth/nostr/challenge", "{}", "", "", "");
  chb: [128] u8; ch := ap_member(ap_body(t), "challenge", chb[..]);
  ap_check(t, "a challenge is given", st == 200 && ch.count == 64, ap_body(t));
  body: [1] Sb; sb(body[..], "{\"challenge\":\""); sb(body[..], ch); sb(body[..], "\",\"label\":\"extension\"}");
  url: [1] Sb; sb(url[..], t[0].api); sb(url[..], "/api/auth/nostr");
  sigb: [4096] u8; sig := ap_nostr(t, other, "POST", sb_text(url[..]), sb_text(body[..]), true, sigb[..]);
  ah: [1] Sb; sb(ah[..], "Authorization: Nostr "); sb(ah[..], sig);
  st = ac_call(t, "POST", "/api/auth/nostr", sb_text(body[..]), sb_text(ah[..]), "", "");
  kses: [160] u8; K := ac_cookie(t, "__Host-oa_session", kses[..]);
  kab: [64] u8; kacct := ap_member(ap_body(t), "account", kab[..]);
  ap_check(t, "a signed challenge logs in a new account at L2", st == 200 && ap_starts(K, "oas_") && ap_starts(kacct, "acct_") && kacct != acct, ap_body(t));
  st = ac_call(t, "POST", "/api/auth/nostr", sb_text(body[..]), sb_text(ah[..]), "", "");
  ap_check(t, "the same signature logs in once", st == 401, ap_body(t));
  st = ac_call(t, "GET", "/api/auth/sessions", "", sb_text(ah[..]), ac_cookie_header("__Host-oa_session", K, c1[..]), "");
  ap_check(t, "two credentials at once are refused", st == 400, ap_body(t));
  st = ac_call(t, "GET", "/api/auth/account", "", ac_cookie_header("__Host-oa_session", K, c1[..]), "", "");
  ap_check(t, "the key's session is L2 and names its key", st == 200 && ap_has(ap_body(t), "\"level\":\"L2\"") && ap_has(ap_body(t), "\"pubkey\""), ap_body(t));

  // ---- sessions: a new token each day of use, the old one 60 seconds more; idle ends them
  sb_clear(q[..]); sb(q[..], "UPDATE auth.sessions SET rotated_at = now() - interval '25 hours', created_at = now() - interval '25 hours' WHERE account = '"); sb(q[..], kacct); sb(q[..], "'");
  ap_do(t, sb_text(q[..]));
  st = ac_call(t, "GET", "/api/auth/account", "", ac_cookie_header("__Host-oa_session", K, c1[..]), "", "");
  rb: [160] u8; R := ac_cookie(t, "__Host-oa_session", rb[..]);
  ap_check(t, "a day-old session gets a new token", st == 200 && ap_starts(R, "oas_") && R != K, ac_head(t));
  st = ac_call(t, "GET", "/api/auth/account", "", ac_cookie_header("__Host-oa_session", K, c1[..]), "", "");
  ap_check(t, "the old token still works for a moment (other tabs)", st == 200 && ap_member(ap_body(t), "logged_in", eb[..]) == "true", ap_body(t));
  st = ac_call(t, "POST", "/api/auth/logout-everywhere", "", ac_cookie_header("__Host-oa_session", R, c1[..]), "", "");
  ap_check(t, "a key's session logs out everywhere", st == 200 && ap_member(ap_body(t), "state", eb[..]) == "logged-out", ap_body(t));
  st = ac_call(t, "GET", "/api/auth/account", "", ac_cookie_header("__Host-oa_session", R, c1[..]), "", "");
  ap_check(t, "after that, the session is nobody and its cookie is cleared", st == 200 && ap_member(ap_body(t), "logged_in", eb[..]) == "false"
           && ap_has(ac_head(t), "__Host-oa_session=; Path=/; Max-Age=0"), ac_head(t));
  sb_clear(q[..]); sb(q[..], "UPDATE auth.sessions SET last_seen_at = now() - interval '31 days' WHERE account = '"); sb(q[..], acct); sb(q[..], "'");
  ap_do(t, sb_text(q[..]));
  st = ac_call(t, "GET", "/api/auth/account", "", ac_cookie_header("__Host-oa_session", S, c1[..]), "", "");
  ap_check(t, "a session unused 30 days has ended", st == 200 && ap_member(ap_body(t), "logged_in", eb[..]) == "false", ap_body(t));

  // ---- an agent's key can't do what only a person can
  nb: [128] u8; np := ap_sql(t, "SELECT auth.new_person(NULL)", nb[..]);
  agb: [1100] u8; ak := fs_join(dir, "agent.key", agb[..]);   // a key of its own: test.sh's keys stay people's
  pkb: [256] u8; pk := ac_newkey(t, ak, pkb[..]);
  sb_clear(q[..]); sb(q[..], "WITH a AS (UPDATE auth.accounts SET kind = 'agent', owner = '"); sb(q[..], kacct); sb(q[..], "' WHERE id = '"); sb(q[..], np);
  sb(q[..], "' RETURNING id) INSERT INTO auth.nostr_keys (account, pubkey) SELECT id, '");
  sb(q[..], pk); sb(q[..], "' FROM a RETURNING account");
  made := ap_sql(t, sb_text(q[..]), out[..]);
  ab2: [1] Sb; sb(ab2[..], "{\"challenge\":\""); for k: 0..<64 { sb(ab2[..], "a"); } sb(ab2[..], "\"}");
  u2: [1] Sb; sb(u2[..], t[0].api); sb(u2[..], "/api/auth/phone/approve");
  s2b: [4096] u8; s2 := ap_nostr(t, ak, "POST", sb_text(u2[..]), sb_text(ab2[..]), true, s2b[..]);
  a2: [1] Sb; sb(a2[..], "Authorization: Nostr "); sb(a2[..], s2);
  st = ac_call(t, "POST", "/api/auth/phone/approve", sb_text(ab2[..]), sb_text(a2[..]), "", "");
  ap_check(t, "an agent's key is refused where only a person may act", made != "" && st == 403
           && ap_member(ap_body(t), "error", eb[..]) == "Only a person can do this, not an agent.", ap_body(t));

  // ---- app tokens: a pair, a refresh, and a reused refresh token ends the login
  st = ac_start(t, "app@example.com", "203.0.113.30", true, pb[..]);
  apb: [128] u8; ap_pend := ap_member(ap_body(t), "pending", apb[..]);
  got = ac_mail(dir, code[..], link[..]);
  vb2: [1] Sb; sb(vb2[..], "{\"code\":\""); sb(vb2[..], cast(string) code[..]); sb(vb2[..], "\",\"pending\":\""); sb(vb2[..], ap_pend); sb(vb2[..], "\"}");
  st = ac_call(t, "POST", "/api/auth/email/verify", sb_text(vb2[..]), "", "", "");
  atb: [160] u8; AT := ap_member(ap_body(t), "access_token", atb[..]);
  rtb: [160] u8; RT := ap_member(ap_body(t), "refresh_token", rtb[..]);
  ap_check(t, "an app's login gets an access and a refresh token, no cookie", st == 200 && ap_starts(AT, "oa_at_") && ap_starts(RT, "oa_rt_")
           && !ap_has(ac_head(t), "__Host-oa_session=oas_"), ap_body(t));
  bh: [1] Sb; sb(bh[..], "Authorization: Bearer "); sb(bh[..], AT);
  st = ac_call(t, "GET", "/api/auth/account", "", sb_text(bh[..]), "", "");
  ap_check(t, "the access token is the account", st == 200 && ap_member(ap_body(t), "logged_in", eb[..]) == "true", ap_body(t));
  rq: [1] Sb; sb(rq[..], "{\"refresh_token\":\""); sb(rq[..], RT); sb(rq[..], "\"}");
  st = ac_call(t, "POST", "/api/auth/refresh", sb_text(rq[..]), "", "", "");
  nrb: [160] u8; NRT := ap_member(ap_body(t), "refresh_token", nrb[..]);
  ap_check(t, "a refresh gives a new pair", st == 200 && ap_starts(NRT, "oa_rt_") && NRT != RT, ap_body(t));
  st = ac_call(t, "POST", "/api/auth/refresh", sb_text(rq[..]), "", "", "");
  ap_check(t, "a reused refresh token ends the whole login", st == 401 && ap_has(ap_body(t), "used twice"), ap_body(t));
  nq: [1] Sb; sb(nq[..], "{\"refresh_token\":\""); sb(nq[..], NRT); sb(nq[..], "\"}");
  st = ac_call(t, "POST", "/api/auth/refresh", sb_text(nq[..]), "", "", "");
  ap_check(t, "after that, its newest refresh token is dead too", st == 401, ap_body(t));
  ap_check(t, "a token with a wrong checksum is refused before any lookup", ac_call(t, "GET", "/api/auth/sessions", "", "Authorization: Bearer oa_at_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "", "") == 401, ap_body(t));

  // ---- freeze: "This wasn't me" ends every session, and email can't log in until a key unfreezes
  st = ac_start(t, "frozen@example.com", "203.0.113.40", false, pb[..]);
  f1b: [128] u8; f1 := ac_cookie(t, "__Host-oa_pending", f1b[..]);
  got = ac_mail(dir, code[..], link[..]);
  fv: [1] Sb; sb(fv[..], "{\"code\":\""); sb(fv[..], cast(string) code[..]); sb(fv[..], "\"}");
  st = ac_call(t, "POST", "/api/auth/email/verify", sb_text(fv[..]), ac_cookie_header("__Host-oa_pending", f1, c1[..]), "", "");
  fsb: [160] u8; FS := ac_cookie(t, "__Host-oa_session", fsb[..]);
  st = ac_call(t, "POST", "/api/auth/freeze", "{}", ac_cookie_header("__Host-oa_session", FS, c1[..]), "", "");
  ap_check(t, "freezing ends the session", st == 200 && ap_member(ap_body(t), "state", eb[..]) == "frozen", ap_body(t));
  st = ac_start(t, "frozen@example.com", "203.0.113.40", false, pb[..]);
  f2b: [128] u8; f2 := ac_cookie(t, "__Host-oa_pending", f2b[..]);
  got = ac_mail(dir, code[..], link[..]);
  sb_clear(fv[..]); sb(fv[..], "{\"code\":\""); sb(fv[..], cast(string) code[..]); sb(fv[..], "\"}");
  st = ac_call(t, "POST", "/api/auth/email/verify", sb_text(fv[..]), ac_cookie_header("__Host-oa_pending", f2, c1[..]), "", "");
  // Since #13214 a frozen account logs in, but only to look, unfreeze, delete or cancel, and log out.
  f3b: [160] u8; F3 := ac_cookie(t, "__Host-oa_session", f3b[..]);
  lst := ac_call(t, "GET", "/api/auth/life", "", ac_cookie_header("__Host-oa_session", F3, c1[..]), "", "");
  ap_check(t, "a frozen account's email login works, and the account says it is frozen", st == 200 && lst == 200 && ap_member(ap_body(t), "frozen", eb[..]) == "freeze", ap_body(t));
  st = ac_call(t, "GET", "/api/agents", "", ac_cookie_header("__Host-oa_session", F3, c1[..]), "", "");
  ap_check(t, "a frozen account's login can do nothing else, and says how to unfreeze", st == 423 && ap_has(ap_body(t), "settings/data"), ap_body(t));

  // ---- every rule the gate keeps is on a route that exists; Origin is checked on writes
  st = ac_call(t, "POST", "/api/auth/nostr/challenge", "{}", "Origin: https://evil.example", "", "");
  ap_check(t, "a write from another site's page is refused", st == 403, ap_body(t));
}
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) { return 2; }
  if args_count(a[..]) >= 1 && args_at(a[..], 0) == "mail" {
    if args_count(a[..]) != 3 { tool_errln("auth_checks mail PORT DIR"); return 2; }
    return am_main(ap_whole(args_at(a[..], 1)), args_at(a[..], 2));
  }
  t: [1] Ap;
  if !ap_open(t[..]) { return 2; }
  wb: [4096] u8; work := fs_temp("auth-mail", wb[..]);
  h := ac_mail_start(t[..], "coax/web/api/tests/auth_checks.coax", work);
  if h < 0 { return ap_done(t[..], "auth checks"); }
  ac_checks(t[..], work);
  ac_mail_stop(h, work);
  return ap_done(t[..], "auth checks");
}
