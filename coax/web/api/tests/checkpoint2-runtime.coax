  if status==PROC_RUNNING{ignored_4:=proc_kill(h,PROC_SIGKILL);status=proc_wait(h,2000);}ignored_5:=proc_release(h);return status;
}
c2_connect :: (v:[]C2Client,url:string)->bool {
  v[0]=C2Client.{};v[0].opened_ms=proc_now_ms();if !relay_conn_open(v[0].conn[..],url){v[0].closed=true;return false;}
  b:[64]u8;ignored_6:=relay_conn_send(v[0].conn[..],cast(string)b[0..<wire_put_pins(b[..],0,wire_pins_own())]);
  return relay_conn_send(v[0].conn[..],"H 4 ranger.0.0.0 druid 0 Checkpoint");
}
c2_input :: (seq:int,move:bool,heard:int,b:[]u8)->string {
  n:=wire_put_in(b,0,WireIn.{seq=seq,kx=ifx move then 100 else 0,heard=heard});return cast(string)b[0..<n];
}
#test "checkpoint fault consumer: movement has the exact nine-field gameplay input" {
  b:[128]u8;#assert c2_input(1,true,7,b[..])=="I 1 100 0 0 0 0 0 7";
}
c2_pump :: (v:[]C2Client,ms:int,move:bool) {
  until:=proc_now_ms()+ms;next:=proc_now_ms();b:[128]u8;
  while !v[0].closed&&proc_now_ms()<until{
    now:=proc_now_ms();if now>=next{next=now+33;v[0].seq+=1;ignored_7:=relay_conn_send(v[0].conn[..],c2_input(v[0].seq,move,v[0].mirror[0].heard,b[..]));}
    if now-v[0].ping_ms>=1000{v[0].ping_ms=now;n:=wire_int(b[..],wire_put(b[..],0,"t"),now);ignored_8:=relay_conn_send(v[0].conn[..],cast(string)b[0..<n]);}
    code:=relay_conn_poll(v[0].conn[..],0);
    while code==RC_TEXT{
      text:=cast(string)v[0].conn[0].text[0..<v[0].conn[0].text_n];
      if ap_starts(text,"y "){v[0].seat=ap_whole(c2_word(text,1));}
      if ap_starts(text,"D "){d:=wire_mirror_frame(v[0].mirror[..],text);if d.tick>=0{v[0].frames+=1;v[0].tick=d.tick;v[0].last_ms=proc_now_ms();if v[0].first_ms==0{v[0].first_ms=v[0].last_ms-v[0].opened_ms;}v[0].own=wire_mirror_of(v[0].mirror[..],v[0].seat);}}
      if text=="r 0 elsewhere"{v[0].elsewhere=true;}
      code=relay_conn_poll(v[0].conn[..],0);
    }
    if code==RC_FAIL||code==RC_CLOSED{v[0].closed=true;}proc_sleep(2);
  }
}
c2_close :: (v:[]C2Client){if !v[0].closed{ignored_9:=relay_conn_close(v[0].conn[..],1000);}v[0].closed=true;}
c2_saved :: (t:[]Ap,pid:string)->CharacterCapture {
  q:[1]Sb;b:[CC_BODY]u8;sb(q[..],"select body::text from verse.character_checkpoints_v2 where who=coalesce((select account from verse.players where id='");sb(q[..],pid);sb(q[..],"'),'");sb(q[..],pid);sb(q[..],"')");return cc_read(ap_sql(t,sb_text(q[..]),b[..]),false);
}
c2_file :: (dir:string,name:string,text:string)->bool {b:[4200]u8;return fs_write(fs_join(dir,name,b[..]),text);}
c2_read :: (dir:string,name:string,out:[]u8)->string {b:[4200]u8;n:=fs_read(fs_join(dir,name,b[..]),out);return ifx n>=0 then cast(string)out[0..<n] else "";}
