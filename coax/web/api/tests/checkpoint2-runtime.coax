  req:[8192]u8;answer:[2048]u8;w:[1]HttpWork;url:[1]Sb;sb(url[..],api);sb(url[..],"/api/playtest/room-checkpoint-v2");duplicates:=0;
  stop:[4200]u8;stopfile:=fs_join(dir,"stop",stop[..]);
  while !fs_exists(stopfile){h:=cxsock_accept(listener,20);if h<0{continue;}total:[1]int;end:=c2_request(h,req[..],total[..]);if end<0{ignored_16:=cxsock_close(h);continue;}
    mb:[16]u8;mode:=ap_trim(c2_read(dir,"mode",mb[..]));body:=cast(string)req[end..<total[0]];ignored_17:=c2_file(dir,"capture",body);
