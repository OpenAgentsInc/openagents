c2_vitals::(port:int,out:[]u8)->string{url:[1]Sb;sb(url[..],"http://127.0.0.1:");sb_int(url[..],port);sb(url[..],"/api/room/vitals");w:[1]HttpWork;none:[1]string;r:=http_do(w[..],"GET",sb_text(url[..]),none[0..<0],"",1000,0,out);return ifx r.error==HTTP_OK&&r.code==200 then cast(string)out[0..<r.n] else "";}
c2_signal :: (h:int,signal:string)->bool {
