  l:=cxsock_listen(0);port[0]=cxsock_port(l);ignored_10:=cxsock_close(l);ps:[24]u8;
  cp:[1]Sb;sb(cp[..],"OA_ROOM_CHECKPOINT_URL=http://127.0.0.1:");sb_int(cp[..],proxy_port);sb(cp[..],"/checkpoint");
  vit:[1]Sb;sb(vit[..],"OA_ROOM_VITALS_URL=");sb(vit[..],t[0].api);sb(vit[..],"/api/playtest/room-vitals");
  argv:=[7]string.[bin,"--port",ap_num(port[0],ps[..]),"--listen","127.0.0.1","--dev",dir];env:=[2]string.[sb_text(cp[..]),sb_text(vit[..])];h:=c2_start(argv[..],env[..]);
  until:=proc_now_ms()+5000;w:[1]HttpWork;out:[2048]u8;url:[1]Sb;sb(url[..],"http://127.0.0.1:");sb_int(url[..],port[0]);sb(url[..],"/health");none:[1]string;
  while h>=0&&proc_now_ms()<until{r:=http_do(w[..],"GET",sb_text(url[..]),none[0..<0],"",100,0,out[..]);if r.error==HTTP_OK&&r.code==200{return h;}ignored_11:=proc_line(h,20,out[..]);}return h;
}
c2_url :: (port:int,ticket:string,out:[]Sb)->string {sb_clear(out);sb(out,"ws://localhost:");sb_int(out,port);sb(out,"/api/room/relay/everglade/pair-e2-chkpt-1?t=");sb(out,ticket);return sb_text(out);}
c2_ready :: (v:[]C2Client)->bool {until:=proc_now_ms()+10000;while !v[0].closed&&v[0].frames==0&&proc_now_ms()<until{c2_pump(v,50,false);}return v[0].frames>0&&v[0].own.id>=0;}
c2_near :: (a:f32,b:f32)->bool {d:=a-b;return d>=-0.03&&d<=0.03;}
c2_place_matches :: (v:[]C2Client,c:CharacterCapture)->bool {return c.ok&&c2_near(v[0].own.x,f32(c.n[13])/1000)&&c2_near(v[0].own.z,f32(c.n[15])/1000);}
c2_metric::(s:string,key:string)->int{at:=0;while at<s.count{end:=at;while end<s.count&&s[end]!='\n'{end+=1;}line:=s[at..<end];if line.count>key.count&&line[0..<key.count]==key&&line[key.count]=='='{return ap_whole(line[key.count+1..<line.count]);}at=end+1;}return -1;}
c2_column::(line:string,which:int)->string{at:=0;field:=0;while at<=line.count{end:=at;while end<line.count&&line[end]!='|'{end+=1;}if field==which{return line[at..<end];}field+=1;at=end+1;}return "";}
c2_observed_capture::(text:string,c:CharacterCapture)->bool{at:=0;while at<text.count{end:=at;while end<text.count&&text[end]!='\n'{end+=1;}line:=text[at..<end];at=end+1;
  if c2_column(line,0)=="saved"&&c2_column(line,1)=="pair-e2-chkpt-1"&&c2_column(line,3)=="2"{
    return ap_whole(c2_column(line,4))==c.n[1]&&ap_whole(c2_column(line,5))==c.n[2]&&ap_whole(c2_column(line,6))==c.n[3]
      &&ap_whole(c2_column(line,7))>=30000&&ap_whole(c2_column(line,8))>=30000&&ap_whole(c2_column(line,9))>0&&c2_column(line,11)=="1"&&c2_column(line,12)=="1";
  }}return false;}
