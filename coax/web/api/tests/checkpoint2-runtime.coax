  s:[1]Sb;sb(s[..],"HTTP/1.1 ");sb_int(s[..],code);sb(s[..]," Test\r\nConnection: close\r\nContent-Length: ");sb_int(s[..],body.count);sb(s[..],"\r\n\r\n");sb(s[..],body);
  for c:sb_text(s[..]){ignored_12:=cxsock_write(h,cast(int)c);}ignored_13:=cxsock_flush(h,2000);ignored_14:=cxsock_close(h);
}
