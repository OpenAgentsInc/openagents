}

// A controllable HTTP boundary: before refuses without forwarding; after lets
// Postgres commit and then loses the reply; pass returns the actual receipt.
c2_head :: (s:string)->int {for i:0..<s.count-3{if s[i..<i+4]=="\r\n\r\n"{return i+4;}}return -1;}
c2_header :: (s:string,name:string)->string {
  at:=0;for i:0..<s.count{if s[i]!='\n'{continue;}line:=s[at..<i];at=i+1;
    if line.count>0&&line[line.count-1]=='\r'{line=line[0..<line.count-1];}
    if line.count>name.count&&line[name.count]==':'&&http_same(line[0..<name.count],name){return http_trim(line[name.count+1..<line.count]);}}
  return "";
}
#test "checkpoint proxy: CRLF header values are whole numbers and exact MAC bytes" {
  head:="POST /checkpoint HTTP/1.1\r\nContent-Length: 123\r\nX-Room-Mac: abc\r\n\r\n";
  #assert c2_header(head,"Content-Length")=="123"&&ap_whole(c2_header(head,"Content-Length"))==123&&c2_header(head,"X-Room-Mac")=="abc";
}
c2_request :: (h:int,b:[]u8,total:[]int)->int {
  used:=0;end:=-1;want:=-1;until:=proc_now_ms()+5000;
  while proc_now_ms()<until&&(want<0||used<want){n:=cxsock_read(h,100);if n==-2{continue;}if n<0||used+n>b.count{return -1;}
    for i:0..<n{b[used+i]=cast,trunc(u8)cxsock_byte(h,i);}used+=n;if end<0&&used>=4{end=c2_head(cast(string)b[0..<used]);}
    if end>=0&&want<0{size:=ap_whole(c2_header(cast(string)b[0..<end],"Content-Length"));if size<0{return -1;}want=end+size;if want>b.count{return -1;}}}
  if used!=want{return -1;}total[0]=used;return end;
}
