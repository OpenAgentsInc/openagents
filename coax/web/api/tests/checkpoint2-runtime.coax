c2_word :: (text:string,which:int)->string {
  at:=0;field:=0;while at<=text.count{end:=at;while end<text.count&&text[end]!=' '{end+=1;}if field==which{return text[at..<end];}field+=1;at=end+1;}return "";
}

C2Client :: struct {
  conn:[1]RelayConn; mirror:[1]WireMirror; seat:int=-1; seq:int;
