  ignored_39:=proc_kill(server,PROC_SIGTERM);c2_pump(client[..],500,false);exit:=c2_reap(server,0);final:=c2_saved(t,pid);
  print("crash2 final_exit=% saved_x_mm=% saved_z_mm=% observed_x=% observed_z=%\n",exit,final.n[13],final.n[15],final_x,final_z);
  ap_check(t,"crash2: planned termination accepts the final frozen body before successful exit",exit==0&&final.ok&&c2_near(f32(final.n[13])/1000,final_x)&&c2_near(f32(final.n[15])/1000,final_z),"");c2_close(client[..]);
  server=c2_room(t,bin,dir,proxy_port,port[..]);opened=c2_connect(client[..],c2_url(port[0],c2_ticket(t,pl_key(p[..]),tb[..]),url[..]));ready=c2_ready(client[..]);ignored_mode:=c2_file(dir,"mode","before");c2_pump(client[..],500,true);
  ignored_signal:=proc_kill(server,PROC_SIGTERM);c2_pump(client[..],500,false);failed_exit:=c2_reap(server,0);
  ap_check(t,"crash2: unavailable final save exits with failure rather than claiming a successful drain",opened&&ready&&failed_exit==1,"");c2_close(client[..]);
  ignored_40:=c2_file(dir,"stop","1");ignored_41:=c2_reap(proxy,0);ignored_42:=fs_remove(dir);
}

// The transport has 16 handles. Fill 16 pending characters at a time, close
// their sockets, and let their live grace bodies end before the next batch.
// The 257th admission therefore has a free room seat: only the outbox is full.
c2_capacity :: (t:[]Ap,bin:string) {
  wb:[4200]u8;dir:=fs_temp("character-capacity-",wb[..]);none:[1]string;mode:=c2_file(dir,"mode","before");
  pa:=[5]string.["coax/web/tool.sh","coax/web/api/tests/checkpoint2_checks.coax","proxy",dir,t[0].api];proxy:=c2_start(pa[..],none[0..<0]);
  pb:[32]u8;deadline:=proc_now_ms()+60000;proxy_port:=-1;
  while proxy>=0&&proxy_port<=0&&proc_now_ms()<deadline{proxy_port=ap_whole(ap_trim(c2_read(dir,"port",pb[..])));proc_sleep(20);}
  ap_do(t,"insert into verse.players(id,key_sha256,created_ms) select 'p-cap2-'||g,'cap2-'||g,1 from generate_series(0,256) g;insert into verse.room_owners(who,gen,at) select 'p-cap2-'||g,1,1 from generate_series(0,256) g");
  port:[1]int;server:=c2_room(t,bin,dir,proxy_port,port[..]);c:[1]RelayConn;joined:=0;refused:=false;tx:[1]Sb;url:[1]Sb;mac:[64]u8;ticket:[4096]u8;
  for batch:0..<16{
    for seat:0..<16{
      id:=batch*16+seat;sb_clear(tx[..]);sb(tx[..],"v2.p-cap2-");sb_int(tx[..],id);sb(tx[..],".0.-.pair-e2-chkpt-1.");sb_int(tx[..],cxproc_wall_us()/1000+600000);sb(tx[..],".-g1");
      sig:=ap_room_mac(t,sb_text(tx[..]),mac[..]);sb(tx[..],".");sb(tx[..],sig);tk:=resume_ticket_wrap(t[0].room_key,sb_text(tx[..]),"-",ticket[..]);
      if relay_conn_open(c[..],c2_url(port[0],tk,url[..])){
        pin:[64]u8;sent:=relay_conn_send(c[..],cast(string)pin[0..<wire_put_pins(pin[..],0,wire_pins_own())]);hello:=relay_conn_send(c[..],"H 4 ranger.0.0.0 druid 0 Capacity");
        until:=proc_now_ms()+200;got_y:=false;
        while proc_now_ms()<until{code:=relay_conn_poll(c[..],5);if code==RC_TEXT{msg:=cast(string)c[0].text[0..<c[0].text_n];if ap_starts(msg,"y "){got_y=true;}}}
        if got_y&&sent&&hello{joined+=1;}rc_shut(c[..]);
      }
    }
    // Native rm_eg_begin reaps held seats even while checkpoint-gated.
    proc_sleep(16000);print("capacity2 batch=% joined=%\n",batch+1,joined);
  }
  sb_clear(tx[..]);sb(tx[..],"v2.p-cap2-256.0.-.pair-e2-chkpt-1.");sb_int(tx[..],cxproc_wall_us()/1000+600000);sb(tx[..],".-g1");sig:=ap_room_mac(t,sb_text(tx[..]),mac[..]);sb(tx[..],".");sb(tx[..],sig);tk:=resume_ticket_wrap(t[0].room_key,sb_text(tx[..]),"-",ticket[..]);
  admitted:=relay_conn_open(c[..],c2_url(port[0],tk,url[..]));refused=!admitted;
  if admitted{rc_shut(c[..]);}
  w:[1]HttpWork;body:[2048]u8;health:[1]Sb;sb(health[..],"http://127.0.0.1:");sb_int(health[..],port[0]);sb(health[..],"/health");r:=http_do(w[..],"GET",sb_text(health[..]),none[0..<0],"",2000,0,body[..]);text:=cast(string)body[0..<r.n];
  ap_check(t,"capacity2: all 256 unaccepted captures survive their sockets and grace bodies",joined==256&&ap_has(text,"checkpoints pending 256"),text);
  ap_check(t,"capacity2: the 257th character is refused by the outbox with a free simulation seat",refused&&ap_has(text,"refused 1"),text);
  status:=c2_reap(server,PROC_SIGKILL);stop:=c2_file(dir,"stop","1");done:=c2_reap(proxy,0);gone:=fs_remove(dir);
}
