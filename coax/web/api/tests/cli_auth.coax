// The API's checks for the CLI as a caller, in Coax over coax/lib/net/http.coax
// (docs/cli/2026-11-01-openagents-cli-v1.md, "What the server needs"):
//   nip98   a NIP-98 signature is its key's account on /api/playtest/realms and
//           /api/auth/v2/me: an owner's signed save works, another key's is 403,
//           a replay, a changed body, an unbound write and a signature for
//           another URL are 401, another site's Origin is still 403, and the
//           X-Verse-Player key works as before
//   mine    GET /api/playtest/realms/mine: an owner with realms, one with none,
//           a guest key, nobody
//   device  device login: start (signed by the new key), poll (that key only),
//           look, approve with a site session (once; refused for a key with
//           realms of its own), the key then is the account (me, a realm save,
//           mine), unlink, and expiry where codes last seconds
//   visibility  a realm's visibility (0099): private is 404 to all but its owner and
//           site admins, unlisted is reached by its slug, public is on /og's rows; only
//           an approved creator (when invite only) or a site admin changes it; and admin
//           keys (0100): only a root admin adds or removes one, no one removes a root.
//           Its admin part needs ADMIN_SECRET_HEX (test.sh's throwaway root).
// Every key is made for the run and never printed.
//   coax/web/api/cli-auth-test.sh http://127.0.0.1:PORT        (test.sh runs it on its API)
//   coax/web/api/cli-auth-test.sh https://staging.openagents.com
#import "Basic";
#load "../../../lib/sys/tool.coax";
#load "../../../lib/sys/proc.coax";
#load "../../../lib/net/http.coax";
#load "../../../lib/nostr/nip98_sign.coax";
#load "../../../lib/nostr/nip06.coax";

cxrand_draw :: (out: [] u8, n: int) -> int #foreign;
cxproc_wall_us :: () -> int #foreign;

CaT :: struct {
  api: [256] u8; api_n: int;
  pass: int; fail: int;
  w: [1] HttpWork; out: [HTTP_BODY_MAX] u8; n: int; code: int;
  auth: [N98S_HEADER] u8; auth_n: int;          // the last signature sent
  run: [16] u8;                                 // this run's tag, for names
  cookie: [256] u8; cookie_n: int;              // a site session (oa_session=...), sent while cookie_on
  cookie_on: bool;
}
CaKey :: struct { secret: [32] u8; pub: [64] u8; }

ca_api :: (t: [] CaT) -> string { return cast(string) t[0].api[0..<t[0].api_n]; }
ca_body :: (t: [] CaT) -> string { return cast(string) t[0].out[0..<t[0].n]; }
ca_has :: (s: string, part: string) -> bool {
  if part.count > s.count { return false; }
  for i: 0..<s.count - part.count + 1 { if s[i..<i + part.count] == part { return true; } }
  return false;
}
ca_put :: (out: [] u8, at: int, s: string) -> int {
  if at < 0 || at + s.count > out.count { return -1; }
  for i: 0..<s.count { out[at + i] = s[i]; }
  return at + s.count;
}
ca_check :: (t: [] CaT, name: string, ok: bool) {
  if ok { t[0].pass += 1; print("ok   %\n", name); return; }
  t[0].fail += 1;
  print("FAIL % (status %: %)\n", name, t[0].code, ca_body(t));
}

ca_new_key :: (k: [] CaKey) -> bool {
  pub: [33] u8;
  if cxrand_draw(k[0].secret[..], 32) != 0 || !bip32_public(k[0].secret[..], pub[..]) { return false; }
  digits := "0123456789abcdef";
  for i: 0..<32 { k[0].pub[2 * i] = digits[cast(int) (pub[1 + i] >> 4)]; k[0].pub[2 * i + 1] = digits[cast(int) (pub[1 + i] & 15)]; }
  return true;
}
ca_pub_of :: (k: [] CaKey) -> string { return cast(string) k[0].pub[..]; }

// Signs METHOD api+sign_path with ca_body (bound unless a GET) into t[0].auth.
ca_sign :: (t: [] CaT, k: [] CaKey, method: string, sign_path: string, b: string, bind: bool) -> bool {
  url: [2048] u8; bb: [65536] u8; aux: [32] u8; nonce: [16] u8;
  u := ca_put(url[..], 0, ca_api(t)); u = ca_put(url[..], u, sign_path);
  bn := ca_put(bb[..], 0, b);
  if u < 0 || bn < 0 || cxrand_draw(aux[..], 32) != 0 || cxrand_draw(nonce[..], 16) != 0 { return false; }
  t[0].auth_n = n98s_header(k[0].secret[..], aux[..], nonce[..], cxproc_wall_us() / 1000000, cast(string) url[0..<u], method, bb[0..<bn], bind, t[0].auth[..]);
  return t[0].auth_n > 0;
}
// One request to api+path. auth: send t[0].auth; player: an X-Verse-Player key or ""; origin: an Origin or "".
ca_call :: (t: [] CaT, method: string, path: string, b: string, auth: bool, player: string, origin: string) -> int {
  url: [2048] u8; ah: [N98S_HEADER + 32] u8; ph: [300] u8; oh: [300] u8; ch: [300] u8;
  u := ca_put(url[..], 0, ca_api(t)); u = ca_put(url[..], u, path);
  hs: [5] string; n := 0;
  if t[0].cookie_on { c := ca_put(ch[..], 0, "Cookie: "); c = ca_put(ch[..], c, cast(string) t[0].cookie[0..<t[0].cookie_n]); hs[n] = cast(string) ch[0..<c]; n += 1; }
  hs[n] = "Content-Type: application/json"; n += 1;
  if auth { a := ca_put(ah[..], 0, "Authorization: "); a = ca_put(ah[..], a, cast(string) t[0].auth[0..<t[0].auth_n]); hs[n] = cast(string) ah[0..<a]; n += 1; }
  if player.count > 0 { p := ca_put(ph[..], 0, "X-Verse-Player: "); p = ca_put(ph[..], p, player); hs[n] = cast(string) ph[0..<p]; n += 1; }
  if origin.count > 0 { o := ca_put(oh[..], 0, "Origin: "); o = ca_put(oh[..], o, origin); hs[n] = cast(string) oh[0..<o]; n += 1; }
  r := http_do(t[0].w[..], method, cast(string) url[0..<u], hs[0..<n], b, 20000, 0, t[0].out[..]);
  t[0].n = r.n; t[0].code = ifx r.error == HTTP_OK then r.code else -r.error;
  return t[0].code;
}
// Signed by k for this path and body, then sent.
ca_signed :: (t: [] CaT, k: [] CaKey, method: string, path: string, b: string) -> int {
  if !ca_sign(t, k, method, path, b, method != "GET") { t[0].code = -100; t[0].n = 0; return -100; }
  return ca_call(t, method, path, b, true, "", "");
}
// The same, from a page on the API's own origin (as /login's signed POSTs are).
ca_signed_here :: (t: [] CaT, k: [] CaKey, method: string, path: string, b: string) -> int {
  if !ca_sign(t, k, method, path, b, method != "GET") { t[0].code = -100; t[0].n = 0; return -100; }
  return ca_call(t, method, path, b, true, "", ca_api(t));
}
// The value after "KEY " on a line of the last body, into out.
ca_line_value :: (t: [] CaT, key: string, out: [] u8) -> string {
  s := ca_body(t); at := 0;
  while at < s.count {
    e := at;
    while e < s.count && s[e] != '\n' { e += 1; }
    l := s[at..<e];
    if l.count > key.count && l[0..<key.count] == key && l[key.count] == ' ' {
      n := ca_put(out, 0, l[key.count + 1..<l.count]);
      return ifx n < 0 then "" else cast(string) out[0..<n];
    }
    at = e + 1;
  }
  return "";
}
// A realm made with a board of its own name, then made public so other keys see it (a new realm
// is private, 0099): its slug into out, or "".
ca_make :: (t: [] CaT, k: [] CaKey, player: string, name: string, out: [] u8) -> string {
  slug := ca_make_private(t, k, player, name, out);
  if slug.count == 0 { return ""; }
  p: [200] u8;
  pn := ca_put(p[..], 0, "/api/playtest/realms/"); pn = ca_put(p[..], pn, slug); pn = ca_put(p[..], pn, "/visibility");
  vis := "{\"visibility\":\"public\"}";
  code := ifx player.count > 0 then ca_call(t, "POST", cast(string) p[0..<pn], vis, false, player, "")
          else ca_signed(t, k, "POST", cast(string) p[0..<pn], vis);
  return ifx code == 200 then slug else "";
}
// A realm made with a board of its own name, private as made: its slug into out, or "".
ca_make_private :: (t: [] CaT, k: [] CaKey, player: string, name: string, out: [] u8) -> string {
  b: [256] u8;
  n := ca_put(b[..], 0, "{\"board\":{\"name\":\""); n = ca_put(b[..], n, name); n = ca_put(b[..], n, "\",\"features\":[]}}");
  code := ifx player.count > 0 then ca_call(t, "POST", "/api/playtest/realms?as=lines", cast(string) b[0..<n], false, player, "")
          else ca_signed(t, k, "POST", "/api/playtest/realms?as=lines", cast(string) b[0..<n]);
  return ifx code == 200 then ca_line_value(t, "slug", out) else "";
}
ca_path_of :: (slug: string, rest: string, out: [] u8) -> string {
  n := ca_put(out, 0, "/api/playtest/realms/"); n = ca_put(out, n, slug); n = ca_put(out, n, rest);
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
ca_name_of :: (t: [] CaT, who: string, out: [] u8) -> string {
  n := ca_put(out, 0, "Cli "); n = ca_put(out, n, who); n = ca_put(out, n, " "); n = ca_put(out, n, cast(string) t[0].run[..]);
  return ifx n < 0 then "" else cast(string) out[0..<n];
}

// A save refused: 403 on a realm the caller may see, 404 on a private one it may not.
ca_refused :: (status: int) -> bool { return status == 403 || status == 404; }
ca_nip98_checks :: (t: [] CaT, a: [] CaKey, b: [] CaKey, kept: [] u8) -> int {
  me := "/api/auth/v2/me";
  ca_check(t, "me: nobody is 401", ca_call(t, "GET", me, "", false, "", "") == 401);
  want: [80] u8;
  wn := ca_put(want[..], 0, "account n-"); wn = ca_put(want[..], wn, ca_pub_of(a));
  ca_check(t, "me: a signed GET answers the key's own account", ca_signed(t, a, "GET", me, "") == 200 && ca_has(ca_body(t), cast(string) want[0..<wn]));
  ca_check(t, "me: the same signature again is refused", ca_call(t, "GET", me, "", true, "", "") == 401 && ca_has(ca_body(t), "used already"));
  ca_check(t, "me: a signature for another URL is refused", ca_sign(t, a, "GET", "/api/auth/v2/me?x=1", "", false) && ca_call(t, "GET", me, "", true, "", "") == 401);

  na: [80] u8; sa: [64] u8; p: [200] u8;
  slug := ca_make_private(t, a, "", ca_name_of(t, "a", na[..]), sa[..]);
  ca_check(t, "realms: a signed MAKE IT makes a realm", slug.count > 0);
  ca_check(t, "realms: a replayed MAKE IT is refused", ca_call(t, "POST", "/api/playtest/realms?as=lines", "{\"board\":{\"name\":\"Again\",\"features\":[]}}", true, "", "") == 401);
  ca_check(t, "realms: its owner makes it public", ca_signed(t, a, "POST", ca_path_of(slug, "/visibility", p[..]), "{\"visibility\":\"public\"}") == 200);
  ca_check(t, "realms: the signer owns it", ca_signed(t, a, "GET", ca_path_of(slug, "", p[..]), "") == 200 && ca_has(ca_body(t), "\nrole owner\n"));
  ca_check(t, "realms: the owner's signed save works", ca_signed(t, a, "POST", ca_path_of(slug, "/save", p[..]), "{\"rev\":1,\"moved\":[]}") == 200 && ca_has(ca_body(t), "\"rev\""));
  ca_check(t, "realms: another key's signed save is refused", ca_refused(ca_signed(t, b, "POST", ca_path_of(slug, "/save", p[..]), "{\"rev\":1,\"moved\":[]}")));
  // A private realm is 404 to anyone but its owner (d5f78cbaee); a public one shows another key as a visitor.
  vs := ca_signed(t, b, "GET", ca_path_of(slug, "", p[..]), "");
  ca_check(t, "realms: another key is a visitor, or can't see it", vs == 404 || (vs == 200 && ca_has(ca_body(t), "\nrole visitor\n")));
  ok := ca_sign(t, a, "POST", ca_path_of(slug, "/save", p[..]), "{\"rev\":1,\"moved\":[]}", true);
  ca_check(t, "realms: a changed body is refused", ok && ca_call(t, "POST", ca_path_of(slug, "/save", p[..]), "{\"rev\":2,\"moved\":[]}", true, "", "") == 401);
  ok = ca_sign(t, a, "POST", ca_path_of(slug, "/save", p[..]), "{\"rev\":1,\"moved\":[]}", false);
  ca_check(t, "realms: an unbound signed write is refused", ok && ca_call(t, "POST", ca_path_of(slug, "/save", p[..]), "{\"rev\":1,\"moved\":[]}", true, "", "") == 401 && ca_has(ca_body(t), "payload"));
  ok = ca_sign(t, a, "POST", ca_path_of(slug, "/save", p[..]), "{\"rev\":1,\"moved\":[]}", true);
  ca_check(t, "realms: a signed write from another site's page is 403", ok && ca_call(t, "POST", ca_path_of(slug, "/save", p[..]), "{\"rev\":1,\"moved\":[]}", true, "", "https://evil.example") == 403);
  t[0].auth_n = ca_put(t[0].auth[..], 0, "Nostr eyJub3QiOiJhbiBldmVudCJ9");
  ca_check(t, "realms: a forged header is 401, never the player key", ca_call(t, "GET", ca_path_of(slug, "", p[..]), "", true, "", "") == 401);

  // The page's key works as before, and is not the signer.
  minted := ca_call(t, "POST", "/api/playtest/player", "{}", false, "", "") == 200;
  gk: [200] u8;
  gn := 0;
  s := ca_body(t);
  k := 0;
  while k + 7 < s.count && s[k..<k + 7] != "\"key\": " { k += 1; }
  if k + 8 < s.count { k += 8; while k < s.count && s[k] != '"' && gn < 199 { gk[gn] = s[k]; gn += 1; k += 1; } }
  guest := cast(string) gk[0..<gn];
  ca_check(t, "guest: a player key is minted", minted && gn >= 20);
  ng: [80] u8; sg: [64] u8; q: [200] u8;
  gslug := ca_make(t, a, guest, ca_name_of(t, "guest", ng[..]), sg[..]);
  ca_check(t, "guest: the player key makes a realm, as before", gslug.count > 0);
  ca_check(t, "guest: and saves it", ca_call(t, "POST", ca_path_of(gslug, "/save", q[..]), "{\"rev\":1,\"moved\":[]}", false, guest, "") == 200);
  ca_check(t, "guest: a signer can't save the guest's realm", ca_refused(ca_signed(t, a, "POST", ca_path_of(gslug, "/save", q[..]), "{\"rev\":1,\"moved\":[]}")));
  ca_check(t, "guest: the guest can't save the signer's realm", ca_refused(ca_call(t, "POST", ca_path_of(slug, "/save", p[..]), "{\"rev\":2,\"moved\":[]}", false, guest, "")));

  // GET /api/playtest/realms/mine
  ra: [80] u8;
  rn := ca_put(ra[..], 0, "realm "); rn = ca_put(ra[..], rn, slug); rn = ca_put(ra[..], rn, "|");
  rg: [80] u8;
  gn2 := ca_put(rg[..], 0, "realm "); gn2 = ca_put(rg[..], gn2, gslug); gn2 = ca_put(rg[..], gn2, "|");
  ca_check(t, "mine: an owner's realms, as lines", ca_signed(t, a, "GET", "/api/playtest/realms/mine?as=lines", "") == 200 &&
        ca_has(ca_body(t), cast(string) ra[0..<rn]) && !ca_has(ca_body(t), cast(string) rg[0..<gn2]));
  sj: [80] u8;
  jn := ca_put(sj[..], 0, "\"slug\": \""); jn = ca_put(sj[..], jn, slug); jn = ca_put(sj[..], jn, "\"");
  ca_check(t, "mine: and as JSON", ca_signed(t, a, "GET", "/api/playtest/realms/mine", "") == 200 && ca_has(ca_body(t), "{\"realms\": [") && ca_has(ca_body(t), cast(string) sj[0..<jn]));
  ca_check(t, "mine: a key with no realms has none", ca_signed(t, b, "GET", "/api/playtest/realms/mine?as=lines", "") == 200 && t[0].n == 0 &&
        ca_signed(t, b, "GET", "/api/playtest/realms/mine", "") == 200 && ca_body(t) == "{\"realms\": []}");
  ca_check(t, "mine: a guest key's realms", ca_call(t, "GET", "/api/playtest/realms/mine?as=lines", "", false, guest, "") == 200 &&
        ca_has(ca_body(t), cast(string) rg[0..<gn2]) && !ca_has(ca_body(t), cast(string) ra[0..<rn]));
  ca_check(t, "mine: nobody has none", ca_call(t, "GET", "/api/playtest/realms/mine?as=lines", "", false, "", "") == 200 && t[0].n == 0);
  ca_check(t, "mine: a replayed signature is refused", ca_call(t, "GET", "/api/playtest/realms/mine", "", true, "", "") == 401);
  ca_check(t, "mine: is a GET", ca_signed(t, a, "POST", "/api/playtest/realms/mine", "{}") == 405);
  return ca_put(kept, 0, slug);
}
// ---- Realm visibility (0099) and admin keys (0100) ---------------------------------
// a owns a realm, b is someone else, adm is a root admin (ADMIN_SECRET_HEX, from test.sh's
// throwaway admins.conf; skipped where it is not set).
ca_key_of_hex :: (hex: string, k: [] CaKey) -> bool {
  if hex.count < 64 { return false; }
  for i: 0..<32 {
    v := 0;
    for j: 0..<2 {
      c := hex[2 * i + j];
      d := -1;
      if c >= '0' && c <= '9' { d = cast(int) (c - '0'); }
      if c >= 'a' && c <= 'f' { d = cast(int) (c - 'a') + 10; }
      if d < 0 { return false; }
      v = v * 16 + d;
    }
    k[0].secret[i] = cast(u8) v;
  }
  pub: [33] u8;
  if !bip32_public(k[0].secret[..], pub[..]) { return false; }
  digits := "0123456789abcdef";
  for i: 0..<32 { k[0].pub[2 * i] = digits[cast(int) (pub[1 + i] >> 4)]; k[0].pub[2 * i + 1] = digits[cast(int) (pub[1 + i] & 15)]; }
  return true;
}
ca_vis :: (t: [] CaT, k: [] CaKey, slug: string, v: string) -> int {
  p: [200] u8; b: [64] u8;
  n := ca_put(b[..], 0, "{\"visibility\":\""); n = ca_put(b[..], n, v); n = ca_put(b[..], n, "\"}");
  return ca_signed(t, k, "POST", ca_path_of(slug, "/visibility", p[..]), cast(string) b[0..<n]);
}
ca_flag :: (t: [] CaT, adm: [] CaKey, on: bool) -> bool {
  return ca_signed(t, adm, "POST", "/api/admin/access/flag", ifx on then "{\"name\":\"realm_invites\",\"on\":true}" else "{\"name\":\"realm_invites\",\"on\":false}") == 200;
}

ca_visibility_checks :: (t: [] CaT, a: [] CaKey, b: [] CaKey, adm: [] CaKey, has_admin: bool) {
  na: [80] u8; sa: [64] u8; p: [200] u8; row: [80] u8;
  slug := ca_make_private(t, a, "", ca_name_of(t, "vis", na[..]), sa[..]);
  ca_check(t, "visibility: a made realm", slug.count > 0);
  rn := ca_put(row[..], 0, "/realms/"); rn = ca_put(row[..], rn, slug); rn = ca_put(row[..], rn, "|");
  listed := cast(string) row[0..<rn];
  ca_check(t, "visibility: a new realm is private: its owner sees it", ca_signed(t, a, "GET", ca_path_of(slug, "", p[..]), "") == 200 && ca_has(ca_body(t), "\nvisibility private\n"));
  ca_check(t, "visibility: private: another key gets 404", ca_signed(t, b, "GET", ca_path_of(slug, "", p[..]), "") == 404);
  ca_check(t, "visibility: private: nobody gets 404", ca_call(t, "GET", ca_path_of(slug, "", p[..]), "", false, "", "") == 404);
  ca_check(t, "visibility: private: its document is 404 too", ca_call(t, "GET", ca_path_of(slug, "/doc", p[..]), "", false, "", "") == 404);
  ca_check(t, "visibility: private: another key can't fork it", ca_signed(t, b, "POST", ca_path_of(slug, "/fork", p[..]), "{\"rules\":[]}") == 404);
  ca_check(t, "visibility: private: not on /og's rows", ca_call(t, "GET", "/api/playtest/realms/made", "", false, "", "") == 200 && !ca_has(ca_body(t), listed));
  ca_check(t, "visibility: mine says private", ca_signed(t, a, "GET", "/api/playtest/realms/mine?as=lines", "") == 200 && ca_has(ca_body(t), "|private\n"));
  ca_check(t, "visibility: another key can't change it (it is not there for them)", ca_vis(t, b, slug, "public") == 404);
  ca_check(t, "visibility: a word not a visibility is 400", ca_vis(t, a, slug, "secret") == 400);
  ca_check(t, "visibility: its owner makes it unlisted", ca_vis(t, a, slug, "unlisted") == 200 && ca_has(ca_body(t), "unlisted"));
  ca_check(t, "visibility: unlisted: another key reaches it by its slug", ca_signed(t, b, "GET", ca_path_of(slug, "", p[..]), "") == 200);
  ca_check(t, "visibility: unlisted: still not on /og's rows", ca_call(t, "GET", "/api/playtest/realms/made", "", false, "", "") == 200 && !ca_has(ca_body(t), listed));
  ca_check(t, "visibility: another key still can't change it", ca_vis(t, b, slug, "private") == 403);
  ca_check(t, "visibility: public: on /og's rows", ca_vis(t, a, slug, "public") == 200 && ca_call(t, "GET", "/api/playtest/realms/made", "", false, "", "") == 200 && ca_has(ca_body(t), listed));
  ca_check(t, "visibility: back to private: 404 to others again", ca_vis(t, a, slug, "private") == 200 && ca_signed(t, b, "GET", ca_path_of(slug, "", p[..]), "") == 404);
  if !has_admin { return; }

  ca_check(t, "visibility: a site admin sees a private realm", ca_signed(t, adm, "GET", ca_path_of(slug, "", p[..]), "") == 200);
  ca_check(t, "visibility: a site admin changes any realm's", ca_vis(t, adm, slug, "unlisted") == 200 && ca_vis(t, adm, slug, "private") == 200);
  srow: [80] u8;
  sn := ca_put(srow[..], 0, "realm "); sn = ca_put(srow[..], sn, slug); sn = ca_put(srow[..], sn, "|private|");
  ca_check(t, "admin realms: every realm with who sees it", ca_signed(t, adm, "GET", "/api/admin/access/realms?as=lines&visibility=private", "") == 200 && ca_has(ca_body(t), cast(string) srow[0..<sn]));
  ca_check(t, "admin realms: a filter leaves the others out", ca_signed(t, adm, "GET", "/api/admin/access/realms?as=lines&visibility=public", "") == 200 && !ca_has(ca_body(t), cast(string) srow[0..<sn]));
  ca_check(t, "admin realms: not for others", ca_signed(t, a, "GET", "/api/admin/access/realms", "") == 403);

  // Invite only: an owner who is not an approved creator can't change who sees it.
  ca_check(t, "invites on", ca_flag(t, adm, true));
  ca_check(t, "visibility: invite only: an owner not approved is 403", ca_vis(t, a, slug, "public") == 403);
  ca_check(t, "visibility: invite only: and a publish can't list it", ca_signed(t, a, "POST", ca_path_of(slug, "/publish", p[..]), "{\"listed\":true}") == 403);
  wb: [200] u8;
  wn := ca_put(wb[..], 0, "{\"who\":\""); wn = ca_put(wb[..], wn, ca_pub_of(a)); wn = ca_put(wb[..], wn, "\"}");
  ca_check(t, "admin: approve the owner as a creator", ca_signed(t, adm, "POST", "/api/admin/access/creators", cast(string) wb[0..<wn]) == 200);
  ca_check(t, "visibility: invite only: an approved creator changes it", ca_vis(t, a, slug, "unlisted") == 200 && ca_vis(t, a, slug, "private") == 200);
  ca_check(t, "invites off", ca_flag(t, adm, false));

  // Admin keys: only a root adds or removes a database admin; no one removes a root.
  ak: [200] u8; rb: [200] u8; rr: [200] u8; ra: [200] u8;
  an := ca_put(ak[..], 0, "{\"pubkey\":\""); an = ca_put(ak[..], an, ca_pub_of(b)); an = ca_put(ak[..], an, "\",\"note\":\"test\"}");
  rbn := ca_put(rb[..], 0, "/api/admin/access/admins/"); rbn = ca_put(rb[..], rbn, ca_pub_of(b)); rbn = ca_put(rb[..], rbn, "/remove");
  rrn := ca_put(rr[..], 0, "/api/admin/access/admins/"); rrn = ca_put(rr[..], rrn, ca_pub_of(adm)); rrn = ca_put(rr[..], rrn, "/remove");
  ran := ca_put(ra[..], 0, "{\"pubkey\":\""); ran = ca_put(ra[..], ran, ca_pub_of(a)); ran = ca_put(ra[..], ran, "\"}");
  ca_check(t, "admin keys: not an admin yet", ca_signed(t, b, "GET", "/api/admin/access", "") == 403);
  ca_check(t, "admin keys: a non-admin can't add one", ca_signed(t, a, "POST", "/api/admin/access/admins", cast(string) ra[0..<ran]) == 403);
  ca_check(t, "admin keys: a root adds a database admin", ca_signed(t, adm, "POST", "/api/admin/access/admins", cast(string) ak[0..<an]) == 200);
  ca_check(t, "admin keys: who is then an admin", ca_signed(t, b, "GET", "/api/admin/access", "") == 200);
  ca_check(t, "admin keys: listed as db, the root as root", ca_signed(t, adm, "GET", "/api/admin/access/admins", "") == 200 && ca_has(ca_body(t), ca_pub_of(b)) &&
        ca_has(ca_body(t), "|db|") && ca_has(ca_body(t), "|root\n"));
  ca_check(t, "admin keys: a database admin sees a private realm", ca_signed(t, b, "GET", ca_path_of(slug, "", p[..]), "") == 200);
  ca_check(t, "admin keys: a database admin can't add another", ca_signed(t, b, "POST", "/api/admin/access/admins", cast(string) ra[0..<ran]) == 403);
  ca_check(t, "admin keys: a database admin can't remove a root", ca_signed(t, b, "POST", cast(string) rr[0..<rrn], "{}") == 403);
  ca_check(t, "admin keys: nor can a root remove a root", ca_signed(t, adm, "POST", cast(string) rr[0..<rrn], "{}") == 409);
  ca_check(t, "admin keys: a root removes the database admin", ca_signed(t, adm, "POST", cast(string) rb[0..<rbn], "{}") == 200);
  ca_check(t, "admin keys: who is no longer an admin", ca_signed(t, b, "GET", "/api/admin/access", "") == 403 && ca_signed(t, b, "GET", ca_path_of(slug, "", p[..]), "") == 404);
  ca_check(t, "admin keys: removing it again is 404", ca_signed(t, adm, "POST", cast(string) rb[0..<rbn], "{}") == 404);
}

text_int_of :: (s: string) -> int {
  n := 0;
  for c: s { if c < '0' || c > '9' { return -1; } n = n * 10 + cast(int) (c - '0'); }
  return ifx s.count == 0 then -1 else n;
}

// The value of "KEY": "..." in the last JSON body (no escapes), into out.
ca_json_value :: (t: [] CaT, key: string, out: [] u8) -> string {
  s := ca_body(t); want: [80] u8;
  w := ca_put(want[..], 0, "\""); w = ca_put(want[..], w, key); w = ca_put(want[..], w, "\": \"");
  if w < 0 { return ""; }
  k := cast(string) want[0..<w];
  for i: 0..<s.count - k.count + 1 {
    if i >= 0 && s[i..<i + k.count] == k {
      e := i + k.count; n := 0;
      while e < s.count && s[e] != '"' && n < out.count { out[n] = s[e]; n += 1; e += 1; }
      return cast(string) out[0..<n];
    }
  }
  return "";
}
// Starts a device login signed by k: its id and code into the buffers; the HTTP status.
ca_start :: (t: [] CaT, k: [] CaKey, machine: string, id: [] u8, code: [] u8, id_n: [] int, code_n: [] int) -> int {
  b: [200] u8;
  n := ca_put(b[..], 0, "{\"machine\":\""); n = ca_put(b[..], n, machine); n = ca_put(b[..], n, "\"}");
  st := ca_signed(t, k, "POST", "/api/auth/v2/device/start?as=lines", cast(string) b[0..<n]);
  id_n[0] = ca_line_value(t, "id", id).count; code_n[0] = ca_line_value(t, "code", code).count;
  return st;
}
ca_code_body :: (code: string, out: [] u8) -> string {
  n := ca_put(out, 0, "{\"code\":\""); n = ca_put(out, n, code); n = ca_put(out, n, "\"}");
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
ca_poll_path :: (id: string, out: [] u8) -> string {
  n := ca_put(out, 0, "/api/auth/v2/device/"); n = ca_put(out, n, id); n = ca_put(out, n, "?as=lines");
  return ifx n < 0 then "" else cast(string) out[0..<n];
}

ca_device_checks :: (t: [] CaT, a: [] CaKey, b: [] CaKey, slug: string) {
  c: [1] CaKey; e: [1] CaKey;
  if !ca_new_key(c[..]) || !ca_new_key(e[..]) { ca_check(t, "device: keys", false); return; }
  origin := ca_api(t);
  idb: [32] u8; codeb: [64] u8; idn: [1] int; coden: [1] int;
  ca_check(t, "device: an unsigned start is 401", ca_call(t, "POST", "/api/auth/v2/device/start", "{\"machine\":\"x\"}", false, "", "") == 401);
  ca_check(t, "device: a start names its machine", ca_start(t, c[..], "", idb[..], codeb[..], idn[..], coden[..]) == 400);
  ca_check(t, "device: a signed start answers an id and a code", ca_start(t, c[..], "ci-box", idb[..], codeb[..], idn[..], coden[..]) == 200 && idn[0] == 16 && coden[0] == 32);
  id := cast(string) idb[0..<idn[0]]; code := cast(string) codeb[0..<coden[0]];
  pp: [80] u8; cb: [80] u8;
  poll := ca_poll_path(id, pp[..]); cbody := ca_code_body(code, cb[..]);
  ca_check(t, "device: the key's poll is waiting", ca_signed(t, c[..], "GET", poll, "") == 200 && ca_body(t) == "state waiting\n");
  ca_check(t, "device: another key's poll is 404", ca_signed(t, b[..], "GET", poll, "") == 404);
  ca_check(t, "device: an unsigned poll is 401", ca_call(t, "GET", poll, "", false, "", "") == 401);
  ca_check(t, "device: look from another site is 403", ca_call(t, "POST", "/api/auth/v2/device/look", cbody, false, "", "https://evil.example") == 403);
  mb: [80] u8;
  ca_check(t, "device: look shows the machine", ca_call(t, "POST", "/api/auth/v2/device/look", cbody, false, "", origin) == 200 &&
           ca_json_value(t, "machine", mb[..]) == "ci-box" && ca_has(ca_body(t), "\"state\": \"waiting\""));
  ca_check(t, "device: look with a bad code is 404", ca_call(t, "POST", "/api/auth/v2/device/look", "{\"code\":\"00000000000000000000000000000000\"}", false, "", origin) == 404);
  ca_check(t, "device: approving logged out is 401", ca_call(t, "POST", "/api/auth/v2/device/approve", cbody, false, "", origin) == 401);

  // Log in as a's key the way /login does (POST /api/auth/key, signed): a site session cookie.
  st := ca_signed_here(t, a, "POST", "/api/auth/key", "{\"kind\":\"login\"}");
  sc := http_header(cast(string) t[0].w[0].head[0..<t[0].w[0].head_n], "Set-Cookie");
  semi := 0;
  while semi < sc.count && sc[semi] != ';' { semi += 1; }
  t[0].cookie_n = ca_put(t[0].cookie[..], 0, sc[0..<semi]);
  ca_check(t, "device: a's key logs in with a session cookie", st == 200 && semi > 11 && sc[0..<11] == "oa_session=");
  t[0].cookie_on = true;
  acct: [80] u8;
  an := ca_put(acct[..], 0, "account n-"); an = ca_put(acct[..], an, ca_pub_of(a));
  want := cast(string) acct[0..<an];
  ca_check(t, "device: the session approves it", ca_call(t, "POST", "/api/auth/v2/device/approve?as=lines", cbody, false, "", origin) == 200 && ca_body(t) == "approved ci-box\n");
  ca_check(t, "device: approved once", ca_call(t, "POST", "/api/auth/v2/device/approve", cbody, false, "", origin) == 409);
  ca_check(t, "device: look says approved", ca_call(t, "POST", "/api/auth/v2/device/look", cbody, false, "", origin) == 200 && ca_has(ca_body(t), "\"state\": \"approved\""));
  t[0].cookie_on = false;
  ca_check(t, "device: the key's poll says approved, and the account", ca_signed(t, c[..], "GET", poll, "") == 200 &&
           ca_has(ca_body(t), "state approved\n") && ca_has(ca_body(t), want));
  ca_check(t, "device: the key is the account now", ca_signed(t, c[..], "GET", "/api/auth/v2/me", "") == 200 &&
           ca_has(ca_body(t), want) && ca_has(ca_body(t), "|cli:ci-box\n"));
  p: [200] u8;
  ca_check(t, "device: the key saves the account's realm", ca_signed(t, c[..], "POST", ca_path_of(slug, "/save", p[..]), "{\"rev\":1,\"moved\":[]}") == 200);
  ra: [80] u8;
  rn := ca_put(ra[..], 0, "realm "); rn = ca_put(ra[..], rn, slug); rn = ca_put(ra[..], rn, "|");
  ca_check(t, "device: and lists it as its own", ca_signed(t, c[..], "GET", "/api/playtest/realms/mine?as=lines", "") == 200 && ca_has(ca_body(t), cast(string) ra[0..<rn]));

  // A key that owns a realm of its own can't join another account.
  nb: [80] u8; sb: [64] u8;
  bslug := ca_make(t, b, "", ca_name_of(t, "b", nb[..]), sb[..]);
  ib: [32] u8; kb: [64] u8; ibn: [1] int; kbn: [1] int; cb2: [80] u8;
  ok := bslug.count > 0 && ca_start(t, b, "b-box", ib[..], kb[..], ibn[..], kbn[..]) == 200;
  t[0].cookie_on = true;
  ca_check(t, "device: a key with realms of its own is refused", ok &&
           ca_call(t, "POST", "/api/auth/v2/device/approve", ca_code_body(cast(string) kb[0..<kbn[0]], cb2[..]), false, "", origin) == 409);
  t[0].cookie_on = false;

  // Unlink: the account's own key stays; the device's key leaves, and is its own account again.
  ub: [120] u8; un := ca_put(ub[..], 0, "{\"pubkey\":\""); un = ca_put(ub[..], un, ca_pub_of(a)); un = ca_put(ub[..], un, "\"}");
  ca_check(t, "unlink: the account's own key stays", ca_signed(t, c[..], "POST", "/api/auth/v2/unlink", cast(string) ub[0..<un]) == 409);
  un = ca_put(ub[..], 0, "{\"pubkey\":\""); un = ca_put(ub[..], un, ca_pub_of(e[..])); un = ca_put(ub[..], un, "\"}");
  ca_check(t, "unlink: a key not the account's is 404", ca_signed(t, c[..], "POST", "/api/auth/v2/unlink", cast(string) ub[0..<un]) == 404);
  ca_check(t, "unlink: logged out is 401", ca_call(t, "POST", "/api/auth/v2/unlink", cast(string) ub[0..<un], false, "", origin) == 401);
  un = ca_put(ub[..], 0, "{\"pubkey\":\""); un = ca_put(ub[..], un, ca_pub_of(c[..])); un = ca_put(ub[..], un, "\"}");
  ca_check(t, "unlink: the device's key unlinks itself", ca_signed(t, c[..], "POST", "/api/auth/v2/unlink", cast(string) ub[0..<un]) == 200);
  own: [80] u8;
  on := ca_put(own[..], 0, "account n-"); on = ca_put(own[..], on, ca_pub_of(c[..]));
  ca_check(t, "unlink: and is its own account again", ca_signed(t, c[..], "GET", "/api/auth/v2/me", "") == 200 && ca_has(ca_body(t), cast(string) own[0..<on]));
  ca_check(t, "unlink: so it can't save the account's realm", ca_refused(ca_signed(t, c[..], "POST", ca_path_of(slug, "/save", p[..]), "{\"rev\":1,\"moved\":[]}")));

  // Expiry: only where codes last seconds (test.sh sets OA_DEVICE_TTL_MS); ten minutes elsewhere.
  ie: [32] u8; ke: [64] u8; ien: [1] int; ken: [1] int;
  if ca_start(t, e[..], "slow-box", ie[..], ke[..], ien[..], ken[..]) != 200 { ca_check(t, "expiry: a start", false); return; }
  eb: [40] u8;
  left := text_int_of(ca_line_value(t, "expires_ms", eb[..])) - cxproc_wall_us() / 1000;
  if left > 15000 { print("skip expiry: codes last % s here\n", left / 1000); return; }
  sleep_ms := left + 1500;
  if sleep_ms > 0 { gone := cxproc_sleep_ms(sleep_ms); }
  pe: [80] u8; ce: [80] u8;
  ca_check(t, "expiry: the poll says expired", ca_signed(t, e[..], "GET", ca_poll_path(cast(string) ie[0..<ien[0]], pe[..]), "") == 200 && ca_body(t) == "state expired\n");
  t[0].cookie_on = true;
  ca_check(t, "expiry: an expired code isn't approved", ca_call(t, "POST", "/api/auth/v2/device/approve", ca_code_body(cast(string) ke[0..<ken[0]], ce[..]), false, "", origin) == 410);
  t[0].cookie_on = false;
}

tool_main :: () -> int #export_c {
  t: [1] CaT;
  e: [256] u8;
  base := proc_getenv("API", e[..]);
  if base.count < 8 { tool_errln("cli_auth: set API, e.g. API=http://127.0.0.1:57000"); return 2; }
  t[0].api_n = ca_put(t[0].api[..], 0, base);
  r: [8] u8;
  if cxrand_draw(r[..], 8) != 0 { return 1; }
  digits := "0123456789abcdef";
  for i: 0..<8 { t[0].run[2 * i] = digits[cast(int) (r[i] >> 4)]; t[0].run[2 * i + 1] = digits[cast(int) (r[i] & 15)]; }
  a: [1] CaKey; b: [1] CaKey;
  if !ca_new_key(a[..]) || !ca_new_key(b[..]) { tool_errln("cli_auth: no keys"); return 1; }
  only := proc_getenv("ONLY", e[..]);
  kept: [64] u8;
  kn := ca_nip98_checks(t[..], a[..], b[..], kept[..]);
  if (only == "" || only == "device") && kn > 0 { ca_device_checks(t[..], a[..], b[..], cast(string) kept[0..<kn]); }
  adm: [1] CaKey; ah: [80] u8;
  has_admin := ca_key_of_hex(proc_getenv("ADMIN_SECRET_HEX", ah[..]), adm[..]);
  for i: 0..<ah.count { ah[i] = 0; }
  if only == "" || only == "visibility" { ca_visibility_checks(t[..], a[..], b[..], adm[..], has_admin); }
  print("% checks, % passed, % failed\n", t[0].pass + t[0].fail, t[0].pass, t[0].fail);
  return ifx t[0].fail == 0 then 0 else 1;
}
