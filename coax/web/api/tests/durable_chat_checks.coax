 st=ac_call(t,"GET",pr_route(project,"",path[..]),"",auth,"","");ap_check(t,"Project count includes its original legacy link and deliberate rich copy",st==200 && ap_member_int(ap_body(t),"data.counts.conversations",-1)==2 && ap_member_int(ap_body(t),"data.revision",-1)==2,ap_body(t));
