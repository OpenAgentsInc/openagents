dc_provider_calls :: (dir:string)->int {
 path:[4200]u8;b:[65536]u8;n:=fs_read(fs_join(dir,"all",path[..]),b[..]);count:=0;if n<0 {return 0;}for c:b[0..<n] {if c=='\n' {count+=1;}}return count;
}
dc_failure_case :: (t:[]Ap,auth:string,mode:string,expected:int,reason:string) {
 dirb:[4096]u8;dir:=fs_temp("durable-provider",dirb[..]);provider:=ac_server_start(t,"coax/web/api/tests/durable_chat_checks.coax",dir,mode,"INFER_PORT");name:[1]Sb;sb(name[..],mode);sb(name[..],": provider fixture starts");ap_check(t,sb_text(name[..]),provider>=0,"");if provider<0 {return;}
 st:=dc_post(t,auth,mode,"",0,"",-1,"Controlled durable provider response");c:[1]CtControl;arena:[72]u8;ok:=st==202 && ctr_control_read(ap_body(t),c[..],arena[..]);turn:[36]u8;if ok {_=js_copy(turn[..],c[0].turn);}sb_clear(name[..]);sb(name[..],mode);sb(name[..],": turn is saved before dispatch");ap_check(t,sb_text(name[..]),ok,ap_body(t));
 worker:= -1;if ok {
  tid:=cast(string)turn[..];worker=dc_worker(t);sb_clear(name[..]);sb(name[..],mode);sb(name[..],": actual resident runner starts");ap_check(t,sb_text(name[..]),worker>=0,"");
  if worker>=0 {
   if mode!="provider-refuse" {ok=dc_await(t,auth,tid,worker,true);sb_clear(name[..]);sb(name[..],mode);sb(name[..],": text persists before the provider terminates");ap_check(t,sb_text(name[..]),ok,ap_body(t));}
   v:[1]CtView;i:[1]CtInfo;a:[1476]u8;terminal:=false;deadline:=proc_now_ms()+12000;
   while !terminal && proc_now_ms()<deadline && proc_wait(worker,0)==PROC_RUNNING {st=dc_get(t,auth,"/api/chat/turn/v2alpha1",tid,0);terminal=st==200 && ctr_turn_read(ap_body(t),v[..],i[..],a[..]) && ct_terminal(v[0].state);if !terminal {_=proc_wait(worker,50);}}
   sb_clear(name[..]);sb(name[..],mode);sb(name[..],": terminal state and stop reason are truthful");ap_check(t,sb_text(name[..]),terminal && v[0].state==expected && ct_view_reason(v[..])==reason,ap_body(t));
   sb_clear(name[..]);sb(name[..],mode);sb(name[..],": exact partial content and error presence survive");ap_check(t,sb_text(name[..]),terminal && ct_view_text(v[..])==(ifx mode=="provider-refuse" then "" else "Hello") && (ifx expected==CT_COMPLETED then v[0].ne==0 else v[0].ne>0),ap_body(t));
   u:=v[0].usage;known:=mode=="provider-limit";sb_clear(name[..]);sb(name[..],mode);sb(name[..],": observed usage preserves zero versus unknown");ap_check(t,sb_text(name[..]),terminal && u.input==(ifx known then 12 else -1) && u.output==(ifx known then 2048 else -1) && u.cache_read==(ifx known then 0 else -1) && u.cache_write== -1 && u.reasoning==(ifx known then 21 else -1),ap_body(t));
   before:=dc_provider_calls(dir);st=dc_post(t,auth,mode,"",0,"",-1,"Controlled durable provider response");sb_clear(name[..]);sb(name[..],mode);sb(name[..],": submit replay returns the same terminal turn");ap_check(t,sb_text(name[..]),st==202 && ctr_control_read(ap_body(t),c[..],arena[..]) && c[0].turn==tid && c[0].state==expected,ap_body(t));
   st=dc_run_again(t,tid);sb_clear(name[..]);sb(name[..],mode);sb(name[..],": dispatched replay retains its terminal result");ap_check(t,sb_text(name[..]),st==200 && ctr_control_read(ap_body(t),c[..],arena[..]) && c[0].state==expected,ap_body(t));
   sb_clear(name[..]);sb(name[..],mode);sb(name[..],": replays make no additional upstream request");ap_check(t,sb_text(name[..]),before>0 && dc_provider_calls(dir)==before,"");
   if !terminal {_=dc_stop(t,auth,"failure-cleanup",tid);}
  }
 }
 if worker>=0 {_=proc_kill(worker,PROC_SIGTERM);_=proc_wait(worker,5000);_=proc_release(worker);}ac_mail_stop(provider,dir);
}
dc_failure_checks :: (t:[]Ap)->int {
 mb:[4096]u8;mail:=fs_temp("durable-failure-mail",mb[..]);h:=ac_mail_start(t,"coax/web/api/tests/durable_chat_checks.coax",mail);if h<0 {return 1;}
 ab:[512]u8;owner:[80]u8;ok:=ac_person_login(t,mail,"durablechat@example.com","203.0.113.133",ab[..],owner[..]);ap_check(t,"provider failure checks use a verified owned account",ok,"");
 if ok {q:[1]Sb;sb(q[..],"UPDATE auth.accounts SET team=true WHERE id='");sb(q[..],dc_z(owner[..]));sb(q[..],"'");ap_do(t,sb_text(q[..]));auth:=dc_z(ab[..]);
  dc_failure_case(t,auth,"provider-refuse",CT_FAILED,"error");dc_failure_case(t,auth,"provider-error",CT_FAILED,"error");dc_failure_case(t,auth,"provider-cut",CT_UNKNOWN,"unknown");dc_failure_case(t,auth,"provider-limit",CT_COMPLETED,"max_tokens");
 }
 ac_mail_stop(h,mail);return ap_done(t,"durable provider failures");
}
dc_stream_checks :: (t:[]Ap,auth:string,stranger:string,account:string,conversation:string,turn:string) {
 worker:=dc_worker(t);ap_check(t,"the actual resident runner starts",worker>=0,"");if worker<0 {return;}
 // This turn was queued before the worker existed: startup reconciliation must
 // recover a missed wake without a phone-owned request or another submit.
 ok:=dc_await(t,auth,turn,worker,true);ap_check(t,"a missed wake is recovered and real HTTP deltas persist before completion",ok,ap_body(t));
 st:=dc_get(t,auth,"/api/chat/events/v2alpha1",turn,0);cursor:=ap_member_int(ap_body(t),"next_cursor",-1);ap_check(t,"a reconnect can save the exact running event cursor",st==200 && cursor>=2 && ap_has(ap_body(t),"Hello"),ap_body(t));
 ok=dc_await(t,auth,turn,worker,false);ap_check(t,"the worker saves the exact completed stream and observed usage",ok && ap_has(ap_body(t),"\"input_tokens\":9") && ap_has(ap_body(t),"\"output_tokens\":2") && ap_has(ap_body(t),"\"cache_read_tokens\":0") && ap_has(ap_body(t),"\"cache_write_tokens\":null"),ap_body(t));
 st=dc_get(t,auth,"/api/chat/events/v2alpha1",turn,cursor);ap_check(t,"cursor resume returns only later text usage and completion",st==200 && !ap_has(ap_body(t),"\"text\":\"Hello\"") && ap_has(ap_body(t)," world") && ap_has(ap_body(t),"completed"),ap_body(t));
 st=dc_run_again(t,turn);ap_check(t,"a repeated dispatched run reconciles its completed attempt",st==200 && ap_has(ap_body(t),"completed"),ap_body(t));
 st=dc_post(t,auth,"stream-stop",conversation,2,"",-1,"Cancel this response");arena:[72]u8;control:[1]CtControl;ok=st==202 && ctr_control_read(ap_body(t),control[..],arena[..]);id:[36]u8;if ok {_=js_copy(id[..],control[0].turn);}ap_check(t,"a second live turn is admitted into the same conversation",ok,ap_body(t));
 if ok {
  next:=cast(string)id[..];dc_wake(t);
  ok=dc_await(t,auth,next,worker,true);ap_check(t,"the next response streams before Stop",ok,ap_body(t));
  st=dc_stop(t,auth,"live-stop",next);ap_check(t,"live Stop records a request before its authoritative outcome",st==200 && ap_has(ap_body(t),"\"stop_requested\":true"),ap_body(t));
  deadline:=proc_now_ms()+12000;cancelled:=false;while !cancelled && proc_now_ms()<deadline && proc_wait(worker,0)==PROC_RUNNING {_=dc_get(t,auth,"/api/chat/turn/v2alpha1",next,0);cancelled=ap_has(ap_body(t),"\"state\":\"cancelled\"");if !cancelled {_=proc_wait(worker,100);}}
  ap_check(t,"Stop terminates the actual transport and preserves the partial answer",cancelled && ap_has(ap_body(t),"\"text\":\"Hello\"") && !ap_has(ap_body(t),"Hello world"),ap_body(t));
 }
 q:[1]Sb;counts:[128]u8;sb(q[..],"SELECT count(*) FROM inference.calls WHERE pubkey=encode(sha256(convert_to('openagents.account-chat.v1:");sb(q[..],account);sb(q[..],"','UTF8')),'hex')");
 ap_check(t,"run replay and cancellation meter each actual model attempt once",ap_sql(t,sb_text(q[..]),counts[..])=="2","");
 sb_clear(q[..]);sb(q[..],"SELECT count(*) FROM chat.turns_v2 WHERE conversation='");sb(q[..],conversation);sb(q[..],"' AND dispatched_ms IS NOT NULL");ap_check(t,"queued cancellation and run replay dispatch exactly two saved attempts",ap_sql(t,sb_text(q[..]),counts[..])=="2","");
 dc_cli_checks(t,stranger);
 _=proc_kill(worker,PROC_SIGTERM);_=proc_wait(worker,5000);_=proc_release(worker);
 dc_recovery_checks(t,auth);
 dc_legacy_checks(t,auth,stranger);
}
dc_checks :: (t:[]Ap,mail:string) {
 authb:[512]u8;otherb:[512]u8;accountb:[80]u8;otheraccount:[80]u8;arena:[72]u8;control:[1]CtControl;
 ok:=ac_person_login(t,mail,"durablechat@example.com","203.0.113.131",authb[..],accountb[..]) && ac_person_login(t,mail,"durablestranger@example.com","203.0.113.132",otherb[..],otheraccount[..]);ap_check(t,"durable chat uses verified independent account logins",ok,"");if !ok {return;}auth:=dc_z(authb[..]);stranger:=dc_z(otherb[..]);account:=dc_z(accountb[..]);
 ap_check(t,"durable conversation index requires an account",dc_get(t,"","/api/chat/conversations/v2alpha1","",0)==401,ap_body(t));
