 secondary:[1]Ap;if !ap_open(secondary[..]) {ap_check(parent,"the process recovery harness loads its environment",false,"");return;}t:=secondary[..];
 port:=ap_whole(ap_env(t,"WAKE_PORT"))+2;url:[1]Sb;sb(url[..],"http://127.0.0.1:");sb_int(url[..],port);t[0].api=sb_text(url[..]);api:=dc_api(t,port);
 ap_check(t,"a separate real API starts on the same durable database",api>=0,"");if api<0 {parent[0].checks+=t[0].checks;parent[0].failed+=t[0].failed;return;}
 st:=dc_post(t,auth,"expired-claim","",0,"",-1,"Do not dispatch this expired claim");c:[1]CtControl;a:[72]u8;ok:=st==202 && ctr_control_read(ap_body(t),c[..],a[..]);turn:[36]u8;if ok {_=js_copy(turn[..],c[0].turn);}ap_check(t,"claim recovery starts with an actually admitted queued turn",ok,ap_body(t));
 if ok {
  tid:=cast(string)turn[..];j:[1]CtJob;ja:[108]u8;fence:[36]u8;st=dc_signed(t,1,"claim-old","worker-old","","","claim-first");ok=st==200 && cwr_job_read(ap_body(t),j[..],ja[..]) && j[0].has_work && j[0].turn==tid;if ok {_=js_copy(fence[..],j[0].dispatch);}ap_check(t,"a signed worker receives a durable claim receipt",ok,ap_body(t));
  if ok {
   q:[1]Sb;sb(q[..],"UPDATE chat.turns_v2 SET claim_until_ms=(extract(epoch FROM clock_timestamp())*1000)::bigint-1 WHERE id='");sb(q[..],tid);sb(q[..],"'");ap_do(t,sb_text(q[..]));
   st=dc_signed(t,2,"expired-run","worker-old",tid,cast(string)fence[..],"claim-expired");ap_check(t,"an expired claim cannot start an upstream request",st==409,ap_body(t));
   st=dc_signed(t,1,"claim-new","worker-new","","","claim-replacement");ap_check(t,"expired queued work receives a new fenced claim",st==200 && cwr_job_read(ap_body(t),j[..],ja[..]) && j[0].turn==tid && j[0].dispatch!=cast(string)fence[..],ap_body(t));
   st=dc_signed(t,1,"claim-old","worker-old","","","claim-replay");ap_check(t,"a replaced claim replays its original receipt and fence",st==200 && cwr_job_read(ap_body(t),j[..],ja[..]) && j[0].turn==tid && j[0].dispatch==cast(string)fence[..],ap_body(t));
   st=dc_signed(t,1,"claim-old","worker-new","","","claim-wrong-worker");ap_check(t,"claim replay cannot change its owning worker",st==409,ap_body(t));
   st=dc_signed(t,2,"stale-run","worker-old",tid,cast(string)fence[..],"claim-stale-run");ap_check(t,"a replaced fence cannot dispatch its old attempt",st==409,ap_body(t));
  }
  _=dc_stop(t,auth,"expired-cancel",tid);
 }
 st=dc_post(t,auth,"restart-live","",0,"",-1,"Recover this interrupted answer");ok=st==202 && ctr_control_read(ap_body(t),c[..],a[..]);conv:[36]u8;if ok {_=js_copy(turn[..],c[0].turn);_=js_copy(conv[..],c[0].conversation);}ap_check(t,"process recovery admits one new saved operation",ok,ap_body(t));
 worker:= -1;cursor:= -1;
 if ok {worker=dc_worker(t);ok=worker>=0 && dc_await(t,auth,cast(string)turn[..],worker,true);ap_check(t,"the separate API persists a real partial model answer",ok,ap_body(t));if ok {_=dc_get(t,auth,"/api/chat/events/v2alpha1",cast(string)turn[..],0);cursor=ap_member_int(ap_body(t),"next_cursor",-1);}}
 // SIGKILL includes the API's inference children. No graceful completion can
 // turn this into a test of an uninterrupted provider request.
 _=proc_kill(api,PROC_SIGKILL);_=proc_wait(api,5000);_=proc_release(api);
 if worker>=0 {_=proc_kill(worker,PROC_SIGKILL);_=proc_wait(worker,5000);_=proc_release(worker);worker= -1;}
 api=dc_api(t,port);ap_check(t,"the API restarts against its existing saved state",api>=0,"");
 if ok && api>=0 {
  st=dc_get(t,auth,"/api/chat/turn/v2alpha1",cast(string)turn[..],0);ap_check(t,"API process loss retains the exact partial answer and cursor",st==200 && ap_has(ap_body(t),"\"state\":\"running\"") && ap_has(ap_body(t),"\"text\":\"Hello\"") && ap_member_int(ap_body(t),"event_cursor",-1)==cursor,ap_body(t));
  q:[1]Sb;sb(q[..],"UPDATE chat.turns_v2 SET heartbeat_ms=(extract(epoch FROM clock_timestamp())*1000)::bigint-450001 WHERE id='");sb(q[..],cast(string)turn[..]);sb(q[..],"'");ap_do(t,sb_text(q[..]));
  worker=dc_worker(t);deadline:=proc_now_ms()+12000;unknown:=false;while worker>=0 && !unknown && proc_now_ms()<deadline && proc_wait(worker,0)==PROC_RUNNING {_=dc_get(t,auth,"/api/chat/turn/v2alpha1",cast(string)turn[..],0);unknown=ap_has(ap_body(t),"\"state\":\"unknown\"");if !unknown {_=proc_wait(worker,50);}}
  ap_check(t,"runner startup recovers a lost dispatched attempt as unknown with its partial text",unknown && ap_has(ap_body(t),"\"text\":\"Hello\"") && !ap_has(ap_body(t),"Hello world"),ap_body(t));
  st=dc_get(t,auth,"/api/chat/events/v2alpha1",cast(string)turn[..],cursor);ap_check(t,"cursor resume after both processes restart appends only the unknown outcome",st==200 && ap_has(ap_body(t),"\"type\":\"unknown\"") && !ap_has(ap_body(t),"\"text\":\"Hello\"") && ap_member_int(ap_body(t),"next_cursor",-1)==cursor+1,ap_body(t));
  st=dc_post(t,auth,"restart-live","",0,"",-1,"Recover this interrupted answer");ap_check(t,"a lost submit response reconciles the original unknown turn without redispatch",st==202 && ctr_control_read(ap_body(t),c[..],a[..]) && c[0].turn==cast(string)turn[..] && c[0].conversation==cast(string)conv[..] && c[0].state==CT_UNKNOWN,ap_body(t));
  st=dc_run_again(t,cast(string)turn[..]);ap_check(t,"an explicit replay of the interrupted dispatch returns its saved unknown result",st==200 && ap_has(ap_body(t),"unknown"),ap_body(t));
 }
 if worker>=0 {_=proc_kill(worker,PROC_SIGTERM);_=proc_wait(worker,5000);_=proc_release(worker);}if api>=0 {_=proc_kill(api,PROC_SIGTERM);_=proc_wait(api,5000);_=proc_release(api);}parent[0].checks+=t[0].checks;parent[0].failed+=t[0].failed;parent[0].sql_bad+=t[0].sql_bad;
}
