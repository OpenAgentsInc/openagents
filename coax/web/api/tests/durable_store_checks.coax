// Postgres oracle for the durable-chat storage boundary. These checks exercise
// actual constraints/cascades, not an in-memory copy. JSON columns are opaque
// here; the shared codec/lifecycle suites check their contents and transitions.
// tool.sh: tls
#load "api_harness.coax";
cts_refused :: (t:[]Ap,sql:string,state:string)->bool {
 q:[1]Sb;sb(q[..],"DO $oracle$ BEGIN BEGIN ");sb(q[..],sql);sb(q[..],"; RAISE EXCEPTION 'constraint missing' USING ERRCODE='XX000'; EXCEPTION WHEN SQLSTATE '");sb(q[..],state);sb(q[..],"' THEN NULL; END; END $oracle$");before:=t[0].sql_bad;ap_do(t,sb_text(q[..]));return t[0].sql_bad==before;
}
tool_main :: ()->int #export_c #effects(all) {
 t:[1]Ap;if !ap_open(t[..]) {return 2;}b:[4096]u8;
 ap_do(t[..],"INSERT INTO auth.accounts(id,kind,verse_account) VALUES ('acct_cccccccccccccccccccccccccc','person','durable-store-c'),('acct_dddddddddddddddddddddddddd','person','durable-store-d')");
 ap_do(t[..],"INSERT INTO projects.private_v1(id,account,name,description,instructions,revision,instructions_revision,instructions_updated_ms,created_ms,updated_ms) VALUES ('prj_cccccccccccccccccccccccccccccccc','acct_cccccccccccccccccccccccccc','Private','','',1,1,1,1,1)");
 ap_do(t[..],"INSERT INTO chat.conversations_v2(id,account,project,revision,title,created_ms,updated_ms) VALUES ('cnv_cccccccccccccccccccccccccccccccc','acct_cccccccccccccccccccccccccc','prj_cccccccccccccccccccccccccccccccc',1,'Private',1,1),('cnv_dddddddddddddddddddddddddddddddd','acct_dddddddddddddddddddddddddd',null,1,'Other',1,1)");
 ap_check(t[..],"durable store creates account and private Project conversations",ap_sql(t[..],"SELECT count(*) FROM chat.conversations_v2 WHERE id IN ('cnv_cccccccccccccccccccccccccccccccc','cnv_dddddddddddddddddddddddddddddddd')",b[..])=="2","");
 ap_check(t[..],"a Project association cannot name another account's Project",cts_refused(t[..],"INSERT INTO chat.conversations_v2(id,account,project,revision,title,created_ms,updated_ms) VALUES ('cnv_eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee','acct_dddddddddddddddddddddddddd','prj_cccccccccccccccccccccccccccccccc',1,'Bad',1,1)","23503"),"");
 ap_do(t[..],"INSERT INTO chat.turns_v2(id,account,conversation,ordinal,operation,digest,request_json,input_json,state,model,provider,effort,created_ms,updated_ms) VALUES ('trn_cccccccccccccccccccccccccccccccc','acct_cccccccccccccccccccccccccc','cnv_cccccccccccccccccccccccccccccccc',1,'submit-1','hash','{}','{}',1,'model','provider','low',1,1)");
 ap_check(t[..],"one active turn owns a conversation even for a different operation",cts_refused(t[..],"INSERT INTO chat.turns_v2(id,account,conversation,ordinal,operation,digest,request_json,input_json,state,model,provider,effort,created_ms,updated_ms) VALUES ('trn_dddddddddddddddddddddddddddddddd','acct_cccccccccccccccccccccccccc','cnv_cccccccccccccccccccccccccccccccc',2,'submit-2','hash','{}','{}',1,'model','provider','low',1,1)","23505"),"");
 ap_check(t[..],"an account operation cannot create a second terminal turn either",cts_refused(t[..],"INSERT INTO chat.turns_v2(id,account,conversation,ordinal,operation,digest,request_json,input_json,state,model,provider,effort,created_ms,updated_ms) VALUES ('trn_dddddddddddddddddddddddddddddddd','acct_cccccccccccccccccccccccccc','cnv_cccccccccccccccccccccccccccccccc',2,'submit-1','hash','{}','{}',3,'model','provider','low',1,1)","23505"),"");
 ap_check(t[..],"conversation ordinals cannot overwrite a previous turn",cts_refused(t[..],"INSERT INTO chat.turns_v2(id,account,conversation,ordinal,operation,digest,request_json,input_json,state,model,provider,effort,created_ms,updated_ms) VALUES ('trn_dddddddddddddddddddddddddddddddd','acct_cccccccccccccccccccccccccc','cnv_cccccccccccccccccccccccccccccccc',1,'submit-2','hash','{}','{}',3,'model','provider','low',1,1)","23505"),"");
 ap_check(t[..],"a turn's account must own its conversation",cts_refused(t[..],"INSERT INTO chat.turns_v2(id,account,conversation,ordinal,operation,digest,request_json,input_json,state,model,provider,effort,created_ms,updated_ms) VALUES ('trn_dddddddddddddddddddddddddddddddd','acct_dddddddddddddddddddddddddd','cnv_cccccccccccccccccccccccccccccccc',2,'submit-2','hash','{}','{}',3,'model','provider','low',1,1)","23503"),"");
 ap_do(t[..],"UPDATE chat.turns_v2 SET worker='worker-1',runner_key='runner',claim_operation='claim-1',dispatch='dispatch-1',claim_until_ms=60001 WHERE id='trn_cccccccccccccccccccccccccccccccc'; INSERT INTO chat.turn_claims_v2(account,runner_key,operation,worker,turn,dispatch,created_ms) VALUES ('acct_cccccccccccccccccccccccccc','runner','claim-1','worker-1','trn_cccccccccccccccccccccccccccccccc','dispatch-1',1); UPDATE chat.turns_v2 SET worker='worker-2',claim_operation='claim-2',dispatch='dispatch-2',claim_until_ms=120001 WHERE id='trn_cccccccccccccccccccccccccccccccc'; INSERT INTO chat.turn_claims_v2(account,runner_key,operation,worker,turn,dispatch,created_ms) VALUES ('acct_cccccccccccccccccccccccccc','runner','claim-2','worker-2','trn_cccccccccccccccccccccccccccccccc','dispatch-2',60001)");
 ap_check(t[..],"a replaced claim retains its original replay identity and fence",ap_sql(t[..],"SELECT dispatch FROM chat.turn_claims_v2 WHERE runner_key='runner' AND operation='claim-1'",b[..])=="dispatch-1" && ap_sql(t[..],"SELECT dispatch FROM chat.turns_v2 WHERE id='trn_cccccccccccccccccccccccccccccccc'",b[..])=="dispatch-2","");
 ap_check(t[..],"a runner operation cannot claim a different dispatch on retry",cts_refused(t[..],"INSERT INTO chat.turn_claims_v2(account,runner_key,operation,worker,turn,dispatch,created_ms) VALUES ('acct_cccccccccccccccccccccccccc','runner','claim-1','worker-2','trn_cccccccccccccccccccccccccccccccc','different',60001)","23505"),"");
 ap_do(t[..],"INSERT INTO chat.turn_events_v2(account,turn,sequence,record) VALUES ('acct_cccccccccccccccccccccccccc','trn_cccccccccccccccccccccccccccccccc',1,'{}'); INSERT INTO chat.turn_operations_v2(account,operation,path,digest,turn) VALUES ('acct_cccccccccccccccccccccccccc','stop-1','stop','hash','trn_cccccccccccccccccccccccccccccccc')");
 ap_check(t[..],"an event sequence can be appended only once",cts_refused(t[..],"INSERT INTO chat.turn_events_v2(account,turn,sequence,record) VALUES ('acct_cccccccccccccccccccccccccc','trn_cccccccccccccccccccccccccccccccc',1,'different')","23505"),"");
 ap_check(t[..],"event ownership cannot cross accounts",cts_refused(t[..],"INSERT INTO chat.turn_events_v2(account,turn,sequence,record) VALUES ('acct_dddddddddddddddddddddddddd','trn_cccccccccccccccccccccccccccccccc',2,'{}')","23503"),"");
 ap_check(t[..],"conflicting Stop receipt reuse cannot replace the first operation",cts_refused(t[..],"INSERT INTO chat.turn_operations_v2(account,operation,path,digest,turn) VALUES ('acct_cccccccccccccccccccccccccc','stop-1','other','different','trn_cccccccccccccccccccccccccccccccc')","23505"),"");
 ap_do(t[..],"UPDATE chat.turns_v2 SET state=6 WHERE id='trn_cccccccccccccccccccccccccccccccc'; INSERT INTO chat.turns_v2(id,account,conversation,ordinal,operation,digest,request_json,input_json,state,model,provider,effort,created_ms,updated_ms) VALUES ('trn_dddddddddddddddddddddddddddddddd','acct_cccccccccccccccccccccccccc','cnv_cccccccccccccccccccccccccccccccc',2,'submit-2','hash','{}','{}',1,'model','provider','low',2,2)");
 ap_check(t[..],"an explicit new operation can follow a retained unknown outcome",ap_sql(t[..],"SELECT string_agg(state::text,',' ORDER BY ordinal) FROM chat.turns_v2 WHERE conversation='cnv_cccccccccccccccccccccccccccccccc'",b[..])=="6,1","");
 ap_check(t[..],"all durable private rows participate in account lifecycle cleanup",ap_sql(t[..],"SELECT count(*) FROM auth.life_columns WHERE tbl IN ('chat.conversations_v2','chat.turns_v2','chat.turn_claims_v2','chat.turn_events_v2','chat.turn_operations_v2') AND col='account' AND on_merge='move' AND on_purge='delete'",b[..])=="5","");
 ap_do(t[..],"DELETE FROM auth.accounts WHERE id='acct_cccccccccccccccccccccccccc'");
 ap_check(t[..],"account purge removes inputs events operations and internal claims",ap_sql(t[..],"SELECT (SELECT count(*) FROM chat.conversations_v2 WHERE account='acct_cccccccccccccccccccccccccc')+(SELECT count(*) FROM chat.turns_v2 WHERE account='acct_cccccccccccccccccccccccccc')+(SELECT count(*) FROM chat.turn_claims_v2 WHERE account='acct_cccccccccccccccccccccccccc')+(SELECT count(*) FROM chat.turn_events_v2 WHERE account='acct_cccccccccccccccccccccccccc')+(SELECT count(*) FROM chat.turn_operations_v2 WHERE account='acct_cccccccccccccccccccccccccc')",b[..])=="0","");
 ap_check(t[..],"account purge preserves another account's conversation",ap_sql(t[..],"SELECT count(*) FROM chat.conversations_v2 WHERE account='acct_dddddddddddddddddddddddddd'",b[..])=="1","");
 ap_do(t[..],"DELETE FROM auth.accounts WHERE id='acct_dddddddddddddddddddddddddd'");
 return ap_done(t[..],"durable chat storage");
}
