// Independent API/database checks for email-L1 account-owned saved history.
// tool.sh: tls
#load "auth_harness.coax";
#load "../account-chat-wire.coax";
#load "../../../../metaverse-engine/editor/world-edit.coax";

chh_world_checks :: (t:[]Ap,account:string,auth:string,player:string) {
 // This grant belongs only to the disposable test database. Binding a player
 // must preserve an existing creator grant, never manufacture one itself.
 q:[1]Sb;sb(q[..],"INSERT INTO access.creators(who,how,at_ms) SELECT verse_account,'admin',0 FROM auth.accounts WHERE id='");sb(q[..],account);sb(q[..],"' ON CONFLICT DO NOTHING");ap_do(t,sb_text(q[..]));
 st:=ac_call(t,"POST","/api/playtest/realms","{\"board\":{\"name\":\"Native world fixture\",\"features\":[]}}",auth,player,"");slugb:[64]u8;slug:=ap_member(ap_body(t),"slug",slugb[..]);
 ap_check(t,"a creator's email-bound player creates a saved realm",st==200 && slug.count>0,ap_body(t));if st!=200 || slug.count==0 {return;}
 st=ac_call(t,"GET","/api/worlds","",auth,player,"");ap_check(t,"the mobile account library lists the newly saved realm",st==200 && ap_has(ap_body(t),slug),ap_body(t));
 sb_clear(q[..]);sb(q[..],"/api/worlds/");sb(q[..],slug);sb(q[..],"?lane=dev");path:=sb_text(q[..]);
 st=ac_call(t,"GET",path,"",auth,player,"");doc:[65536]u8;did:[65536]u8;scratch:[131072]u8;state:=we_state_read(ap_body(t),doc[..],did[..],scratch[..]);
 ap_check(t,"the mobile account reads its private editable world",st==200 && state.ok,ap_body(t));if st!=200 || !state.ok {return;}
 edits:[1]WorldEdit;edits[0]=WorldEdit.{ok=true,op=WE_CELL,id=1};edits[0].table_n=ct_copy(edits[0].table[..],"tools");edits[0].name_n=ct_copy(edits[0].name[..],"on");edits[0].text_n=ct_copy(edits[0].text[..],"1");wire:[4096]u8;base:=state.rev;batch:=we_batch_write(base,WB_APPLY,edits[..],1,wire[..]);
 st=ac_call(t,"POST",path,batch,auth,player,"");state=we_state_read(ap_body(t),doc[..],did[..],scratch[..]);ap_check(t,"the native editor's shared typed batch edits its owned realm",st==200 && state.ok && state.rev==base+1,ap_body(t));
 st=ac_call(t,"POST",path,batch,auth,player,"");ap_check(t,"an edit based on a stale mobile revision cannot replace the world",st==409,ap_body(t));
 batch=we_batch_write(base+1,WB_UNDO,edits[..],0,wire[..]);st=ac_call(t,"POST",path,batch,auth,player,"");state=we_state_read(ap_body(t),doc[..],did[..],scratch[..]);ap_check(t,"the mobile world edit follows the existing undo log",st==200 && state.ok && state.rev==base+2,ap_body(t));
 st=ac_call(t,"GET",path,"","","","");ap_check(t,"a private mobile-created world is not readable by a stranger",st==404,ap_body(t));
}

chh_api_checks :: (t:[]Ap,dir:string) {
  b:[128]u8;code:[6]u8;link:[64]u8;out:[8192]u8;acctb:[64]u8;tokenb:[256]u8;c:[1]Sb;q:[1]Sb;v:[1]Sb;
  ap_check(t,"history requires a login",ac_call(t,"GET","/api/chat/history/v1","","","","")==401,ap_body(t));
  st:=ac_start(t,"mobilehistory@example.com","203.0.113.91",true,b[..]);
  ap_check(t,"history code request is accepted",st==200,ifx st==200 then "" else ap_body(t));if st!=200 {return;}
  pending:=ap_member(ap_body(t),"pending",b[..]);got:=ac_mail(dir,code[..],link[..]);
  sb(v[..],"{\"code\":\"");sb(v[..],cast(string)code[..]);sb(v[..],"\",\"pending\":\"");sb(v[..],pending);sb(v[..],"\"}");
  st=ac_call(t,"POST","/api/auth/email/verify",sb_text(v[..]),"","","");
  token:=ap_member(ap_body(t),"access_token",tokenb[..]);sb(c[..],"Authorization: Bearer ");sb(c[..],token);account:=ap_member(ap_body(t),"account",acctb[..]);
  ap_check(t,"history fixture logs in by a delivered email code",got && st==200 && token.count>0 && account.count>0,ifx st==200 then "" else ap_body(t));if st!=200 || account.count==0 {return;}
  ap_check(t,"environment catalog requires a login",ac_call(t,"GET","/api/chat/environments/v1","","","","")==401,ap_body(t));
  sb_clear(q[..]);sb(q[..],"INSERT INTO chat.environment_connections_v1(account,host_pubkey,display_name,grant_id,epoch,relay) VALUES ('");sb(q[..],account);sb(q[..],"',repeat('aa',32),'My Mac',repeat('bb',32),0,'wss://relay.openagents.com')");ap_do(t,sb_text(q[..]));
  st=ac_call(t,"GET","/api/chat/environments/v1","",sb_text(c[..]),"","");
  ap_check(t,"email account sees its enrolled computer without a broker secret",st==200 && ap_has(ap_body(t),"My Mac") && !ap_has(ap_body(t),"grant_id"),ap_body(t));
  st=ac_call(t,"GET","/api/chat/environment/v1?host=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc&method=ListSessions","",sb_text(c[..]),"","");
  ap_check(t,"a host reference is not an account grant",st==404,ap_body(t));
  st=ac_call(t,"GET","/api/chat/environment/v1?host=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&method=SendMessage","",sb_text(c[..]),"","");
  ap_check(t,"a read route cannot dispatch a mutation",st==400,ap_body(t));
  st=ac_call(t,"GET","/api/chat/environment/v1?host=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&method=ListSessions","",sb_text(c[..]),"","");
  ap_check(t,"email login reaches the broker after production startup ignored SIGCHLD",st==200 && ap_has(ap_body(t),"Fixture computer") && ap_has(ap_body(t),"ListSessions"),ap_body(t));
  sb_clear(q[..]);
  sb(q[..],"INSERT INTO auth.nostr_keys(account,pubkey) VALUES ('");sb(q[..],account);sb(q[..],"',repeat('cd',32)); INSERT INTO chat.conversations(owner,model,title,created_ms,updated_ms) VALUES (repeat('cd',32),'claude-opus-5-5','Phone-owned history',1,2),(repeat('ef',32),'claude-opus-5-5','Someone else private chat',1,3)");
  ap_do(t,sb_text(q[..]));
  st=ac_call(t,"GET","/api/chat/history/v1","",sb_text(c[..]),"","");
  ap_check(t,"app email L1 bearer reads only its linked account chats",st==200 && ap_has(ap_body(t),"Phone-owned history") && !ap_has(ap_body(t),"Someone else private chat"),ap_body(t));
  ap_check(t,"history responses cannot be cached",ap_has(ac_head(t),"Cache-Control: no-store"),ac_head(t));
  st=ac_call(t,"GET","/api/chat/state","",sb_text(c[..]),"","");
  ap_check(t,"the old admin chat gate still requires stronger login",st!=200,"");
  st=ac_call(t,"POST","/api/chat/history/v1","{}",sb_text(c[..]),"","");
  ap_check(t,"the email history grant cannot write",st!=200,"");
  // The history fixture above deliberately attached a strong key. Preserve
  // that limited-email write gate; the mobile send fixture is email-only.
  sb_clear(q[..]);sb(q[..],"DELETE FROM auth.nostr_keys WHERE account='");sb(q[..],account);sb(q[..],"'");ap_do(t,sb_text(q[..]));
  bind_body:="{\"schema\":\"openagents.world.player-bind.v1\"}";
  ap_check(t,"world player binding requires verified account",ac_call(t,"POST","/api/chat/world/player/v1",bind_body,"","","")==401,ap_body(t));
  st=ac_call(t,"POST","/api/playtest/player","{}","","","");playerb:[160]u8;pidb:[160]u8;
  player:=ap_member(ap_body(t),"key",playerb[..]);pid:=ap_member(ap_body(t),"id",pidb[..]);ph:[1]Sb;sb(ph[..],"X-Verse-Player: ");sb(ph[..],player);
  ap_check(t,"native world fixture has a guest player",st==200 && player.count>0,"");
  st=ac_call(t,"POST","/api/chat/world/player/v1",bind_body,sb_text(c[..]),sb_text(ph[..]),"");
  ap_check(t,"email account attaches its guest without gaining admin",st==200 && ap_has(ap_body(t),player),ifx st==200 then "" else ap_body(t));
  st=ac_call(t,"POST","/api/chat/world/player/v1",bind_body,sb_text(c[..]),sb_text(ph[..]),"");
  ap_check(t,"world player binding is idempotent",st==200,ap_body(t));
  chh_world_checks(t,account,sb_text(c[..]),sb_text(ph[..]));
  sb_clear(q[..]);sb(q[..],"INSERT INTO verse.accounts(id,created_ms) VALUES ('world-bind-other',0) ON CONFLICT DO NOTHING; UPDATE verse.players SET account='world-bind-other' WHERE id='");sb(q[..],pid);sb(q[..],"'");ap_do(t,sb_text(q[..]));
  st=ac_call(t,"POST","/api/chat/world/player/v1",bind_body,sb_text(c[..]),sb_text(ph[..]),"");
  ap_check(t,"possessing another account player key cannot rebind its worlds",st==403,ap_body(t));
  thread:[1]AccountThread;wire:[65536]u8;thread[0].n=1;thread[0].messages[0].text[0]='H';thread[0].messages[0].n=1;
  wn:=act_write(thread[..],wire[..]);body:=cast(string)wire[0..<wn];
  st=ac_call(t,"POST","/api/chat/complete/v1",body,sb_text(c[..]),"","");
  ap_check(t,"ordinary email accounts do not inherit team-funded inference",st==403,ap_body(t));
  st=ac_call(t,"POST","/api/chat/thread/v1",body,sb_text(c[..]),"","");
  ap_check(t,"email account can save its own transcript",st==200 && act_read(ap_body(t),thread[..]) && thread[0].revision==1,ap_body(t));
  if st!=200 {return;}
  sb_clear(q[..]);sb(q[..],"/api/chat/thread/v1?id=");sb(q[..],cast(string)thread[0].id[0..<thread[0].id_n]);
  st=ac_call(t,"GET",sb_text(q[..]),"",sb_text(c[..]),"","");
  ap_check(t,"saved transcript reopens on the account",st==200 && ap_has(ap_body(t),"messages"),ap_body(t));
  st=ac_call(t,"POST","/api/chat/thread/v1",body,sb_text(c[..]),"","");
  ap_check(t,"creating with a claimed revision cannot overwrite a thread",st==200,"new ID stays a separate transcript");
  wn=act_write(thread[..],wire[..]);body=cast(string)wire[0..<wn];
  st=ac_call(t,"POST","/api/chat/thread/v1",body,sb_text(c[..]),"","");
  ap_check(t,"saving a matching revision succeeds",st==200,ap_body(t));
  st=ac_call(t,"POST","/api/chat/thread/v1",body,sb_text(c[..]),"","");
  ap_check(t,"stale saves refuse instead of replacing newer turns",st==409,ap_body(t));
  // A separate owner row is inserted directly as a fixture, never inferred from
  // a caller-supplied owner field.
  ap_do(t,"INSERT INTO auth.accounts(id,kind,verse_account) VALUES ('acct_aaaaaaaaaaaaaaaaaaaaaaaaaa','person','history-other') ON CONFLICT DO NOTHING");
  sb_clear(q[..]);sb(q[..],"UPDATE chat.account_threads_v1 SET account='acct_aaaaaaaaaaaaaaaaaaaaaaaaaa' WHERE account='");sb(q[..],account);sb(q[..],"'");ap_do(t,sb_text(q[..]));
  sb_clear(q[..]);sb(q[..],"/api/chat/thread/v1?id=");sb(q[..],cast(string)thread[0].id[0..<thread[0].id_n]);
  st=ac_call(t,"GET",sb_text(q[..]),"",sb_text(c[..]),"","");ap_check(t,"another account's ID is not readable",st==404,ap_body(t));
  st=ac_call(t,"POST","/api/chat/thread/v1",body,sb_text(c[..]),"","");ap_check(t,"another account's ID is not writable",st==409,ap_body(t));
  sb_clear(q[..]);sb(q[..],"UPDATE auth.accounts SET team=true WHERE id='");sb(q[..],account);sb(q[..],"'");ap_do(t,sb_text(q[..]));
  st=ac_call(t,"POST","/api/chat/complete/v1",body,sb_text(c[..]),"","");
  ap_check(t,"team email login reaches the existing metered model adapter",st==200 && ap_has(ap_body(t),"choices"),ap_body(t));
  world_request:[98304]u8;world_n:=awc_write(thread[..],"world.turn.v1 my-world dev 7 0\n",world_request[..]);
  st=ac_call(t,"POST","/api/chat/world/complete/v1",cast(string)world_request[0..<world_n],sb_text(c[..]),"","");
  ap_check(t,"team email world turn uses the existing metered model",st==200 && ap_has(ap_body(t),"choices"),ap_body(t));
  st=ac_call(t,"POST","/api/chat/world/complete/v1","{}",sb_text(c[..]),"","");
  ap_check(t,"malformed world turns do not reach inference",st==400,ap_body(t));


}

tool_main :: ()->int #export_c #effects(all) {
  a:[1]Args;if !args_load(a[..]) {return 2;}
  if args_count(a[..])==3 && args_at(a[..],0)=="mail" {return am_main(ap_whole(args_at(a[..],1)),args_at(a[..],2));}
  if args_count(a[..])==3 && args_at(a[..],0)=="infer" {return am_response(ap_whole(args_at(a[..],1)),args_at(a[..],2),"{\"choices\":[{\"message\":{\"content\":\"Hello from the account agent\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":6}}");}
  t:[1]Ap;if !ap_open(t[..]) {return 2;}
  wb:[4096]u8;work:=fs_temp("history-mail",wb[..]);
  h:=ac_mail_start(t[..],"coax/web/api/tests/history_checks.coax",work);
  if h<0 {return ap_done(t[..],"history checks");}
  ib:[4096]u8;infer_dir:=fs_temp("history-infer",ib[..]);ih:=ac_server_start(t[..],"coax/web/api/tests/history_checks.coax",infer_dir,"infer","INFER_PORT");
  if ih>=0 {chh_api_checks(t[..],work);ac_mail_stop(ih,infer_dir);}
  ac_mail_stop(h,work);return ap_done(t[..],"history checks");
}
