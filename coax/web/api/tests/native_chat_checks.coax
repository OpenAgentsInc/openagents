 dirbuf:[FS_PATH_MAX]u8;dir:=fs_temp("native-decisions",dirbuf[..]);dp:[32]u8;digits:[1]Jo;jo_start(digits[..],dp[..]);jo_int(digits[..],port+1);server:=ac_server_port(t,"coax/web/api/tests/durable_chat_checks.coax",dir,"native-decisions",jo_text(digits[..]));
 decisions:[1]Sb;sb(decisions[..],"http://127.0.0.1:");sb_int(decisions[..],port+1);api:=ifx server>=0 then dc_api_config(t,port,sb_text(decisions[..])) else -1;ap_check(t,"native handoff fixture starts real API and typed decision HTTP processes",api>=0,"");
 c:[1]Sc;c[0].cli=ap_env(t,"CLI");cb:[FS_PATH_MAX]u8;c[0].dir=fs_temp("native-cli",cb[..]);keybuf:[FS_PATH_MAX]u8;pub:[128]u8;key:=fs_join(c[0].dir,"key",keybuf[..]);pk:=ifx api>=0 then ac_newkey(t,key,pub[..]) else "";ok:=pk.count==64 && sc_key(c[..],key);
 if ok {
