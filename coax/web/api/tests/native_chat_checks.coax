  sb_clear(q[..]);sb(q[..],"INSERT INTO chat.environment_connections_v1(account,host_pubkey,display_name,grant_id,epoch,relay) VALUES('");sb(q[..],owner);sb(q[..],"','");sb(q[..],EX_TEST_HASH);sb(q[..],"','Native fixture Mac','");sb(q[..],EX_TEST_HASH);sb(q[..],"',88,'wss://fixture.invalid')");ap_do(t,sb_text(q[..]));
  instructions_path:[FS_PATH_MAX]u8;instructions:=sc_file(c[..],"instructions","Use the original violet instructions.",instructions_path[..]);create:=[5]string.["projects","create","Native handoff fixture","--instructions",instructions];st:=sc_cli(t,c[..],create[..]);pid:[40]u8;project:=ap_member(sc_text(c[..]),"data.id",pid[..]);ap_check(t,"native CLI creates its private Project",st==0 && project.count==36,sc_text(c[..]));
  message_path:[FS_PATH_MAX]u8;message:=sc_file(c[..],"request","Use the Mac to execute the native fixture.",message_path[..]);start:=[10]string.["chat","new","--project",project,"--project-rev","1","--file",message,"--operation-id","native-handoff"];st=sc_cli(t,c[..],start[..]);control:[1]CtControl;arena:[72]u8;ok=st==0 && ctr_control_read(sc_text(c[..]),control[..],arena[..]);turn:[36]u8;if ok {_=js_copy(turn[..],control[0].turn);}tid:=cast(string)turn[..];ap_check(t,"native CLI admits the Project turn before routing",ok,sc_text(c[..]));
  if ok {
   ap_check(t,"server-owned route uploads and starts once despite losing the Start reply",nct_claim_run(t,tid,"native-first"),ap_body(t));
   inspect:=[3]string.["chat","task",tid];st=sc_cli(t,c[..],inspect[..]);task:[1]CttTask;ta:[CTT_ARENA]u8;ok=st==0 && ctt_read(sc_text(c[..]),task[..],ta[..]);ap_check(t,"CLI reads the retained actual Mac Codex model effort and pinned Project input identity",ok && task[0].binding.engine=="codex" && task[0].binding.model=="fixture-native-exact" && task[0].binding.effort=="high" && task[0].binding.host==EX_TEST_HASH,sc_text(c[..]));
   if ok {
    taskid:[32]u8;_=js_copy(taskid[..],task[0].binding.task);native_id:=cast(string)taskid[..];ap_check(t,"a new worker rejoins the original task and permission prompt",nct_claim_run(t,tid,"native-rejoin"),ap_body(t));
    show:=[4]string.["tasks","show",EX_TEST_HASH,native_id];st=sc_cli(t,c[..],show[..]);v:[1]XtStatus;va:[2048]u8;ap_check(t,"public CLI sees the actual waiting task after API handoff",st==0 && xt_status_read(sc_text(c[..]),v[..],va[..]) && v[0].state==XT_WAITING && v[0].interaction=="native-request",sc_text(c[..]));
    command_path:[FS_PATH_MAX]u8;command:=fs_join(c[0].dir,"approve.json",command_path[..]);approve:=[10]string.["tasks","approve",EX_TEST_HASH,native_id,"--rev","2","--interaction","native-request","--command-file",command];st=sc_cli(t,c[..],approve[..]);ap_check(t,"CLI approval reaches the existing native control owner",st==0 && xt_status_read(sc_text(c[..]),v[..],va[..]) && v[0].state==XT_COMPLETED,sc_text(c[..]));
    retry:=[6]string.["tasks","retry",EX_TEST_HASH,"--file",command,"--json"];st=sc_cli(t,c[..],retry[0..<5]);ap_check(t,"lost approval responses replay the same committed native effect",st==0 && xt_status_read(sc_text(c[..]),v[..],va[..]) && v[0].replay,sc_text(c[..]));
    ap_check(t,"a further worker saves the original native result without model redispatch",nct_claim_run(t,tid,"native-result"),ap_body(t));
    st=dc_get(t,"","/api/chat/turn/v2alpha1",tid,0);ap_check(t,"native turn reads still require account authentication",st==401,ap_body(t));
    sb_clear(q[..]);sb(q[..],"SELECT state||'|'||output||'|'||model||'|'||provider||'|'||effort||'|'||(input_tokens IS NULL)::text FROM chat.turns_v2 WHERE id='");sb(q[..],tid);sb(q[..],"'");result:[1024]u8;
    ap_check(t,"saved result has complete text actual native choice and unknown usage",ap_sql(t,sb_text(q[..]),result[..])=="3|Checking native task. Native task complete.|fixture-native-exact|openai|high|true",cast(string)result[..]);
    ap_check(t,"another account cannot inspect the server-owned task association",dc_get(t,stranger,"/api/chat/turn-task/v1alpha1",tid,0)==404,ap_body(t));
    path:[FS_PATH_MAX]u8;root:[FS_PATH_MAX]u8;hostdir:[FS_PATH_MAX]u8;effect:[128]u8;base:=fs_join(fs_dir(ap_env(t,"API_BIN")),"native-chat-fixture",root[..]);directory:=fs_join(base,EX_TEST_HASH,hostdir[..]);n:=fs_read(fs_join(directory,"starts",path[..]),effect[..]);ap_check(t,"the native process records exactly one Start across claims and lost replies",n==6 && cast(string)effect[0..<n]=="start\n","");
    n=fs_read(fs_join(directory,"controls",path[..]),effect[..]);ap_check(t,"the native process records exactly one approval effect across retries",n==8 && cast(string)effect[0..<n]=="control\n","");
    nct_control_case(t,c[..],project,message,"stop");nct_control_case(t,c[..],project,message,"deny");
    nct_capture_case(t,c[..],project,message,directory);
    sb_clear(q[..]);sb(q[..],"UPDATE chat.environment_connections_v1 SET relay='wss://replacement.invalid' WHERE account='");sb(q[..],owner);sb(q[..],"'");ap_do(t,sb_text(q[..]));st=sc_cli(t,c[..],show[..]);ap_check(t,"a replacement enrollment cannot inspect an earlier native task",st!=0 && ap_has(sc_text(c[..]),"404"),sc_text(c[..]));
    original_turn:[36]u8;o:[1]Jo;jo_start(o[..],original_turn[..]);jo_put(o[..],"trn_");jo_put(o[..],native_id);inspect[2]=jo_text(o[..]);st=sc_cli(t,c[..],inspect[..]);ap_check(t,"the owner retains immutable association history after enrollment replacement",st==0 && ctt_read(sc_text(c[..]),task[..],ta[..]),sc_text(c[..]));
   }
  }
 }
 if api>=0 {_=proc_release(api);}if server>=0 {ac_mail_stop(server,dir);}_=fs_remove(c[0].dir);parent[0].checks+=t[0].checks;parent[0].failed+=t[0].failed;
