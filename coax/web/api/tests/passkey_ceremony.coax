// The passkey ceremonies as a browser would run them, with a software passkey (passkey_soft.coax),
// for the API's checks: logging in with a key or an email code, adding a passkey, logging in and
// stepping up with one. passkey_checks.coax (#13215) and wallet_checks.coax (#13217) load this.
// tool.sh: tls
#load "passkey_soft.coax";

pc_q :: (q: [] Sb, a: string, b: string, c: string) -> string { sb_clear(q); sb(q, a); sb(q, b); sb(q, c); return sb_text(q); }
pc_with :: (t: [] Ap, method: string, path: string, body: string, session: string) -> int {
  c1: [1] Sb;
  if session == "" { return ac_call(t, method, path, body, "", "", ""); }
  return ac_call(t, method, path, body, ac_cookie_header("__Host-oa_session", session, c1[..]), "", "");
}
// Logs in with a key (a signed challenge): the session's cookie value in out.
pc_key :: (t: [] Ap, keyfile: string, out: [] u8) -> string {
  ap_do(t, "DELETE FROM auth.limit_counts");
  if ac_call(t, "POST", "/api/auth/nostr/challenge", "{}", "", "", "") != 200 { return ""; }
  chb: [128] u8; ch := ap_member(ap_body(t), "challenge", chb[..]);
  body: [1] Sb; sb(body[..], "{\"challenge\":\""); sb(body[..], ch); sb(body[..], "\",\"label\":\"extension\"}");
  url: [1] Sb; sb(url[..], t[0].api); sb(url[..], "/api/auth/nostr");
  sigb: [4096] u8; sig := ap_nostr(t, keyfile, "POST", sb_text(url[..]), sb_text(body[..]), true, sigb[..]);
  ah: [1] Sb; sb(ah[..], "Authorization: Nostr "); sb(ah[..], sig);
  if ac_call(t, "POST", "/api/auth/nostr", sb_text(body[..]), sb_text(ah[..]), "", "") != 200 { return ""; }
  return ac_cookie(t, "__Host-oa_session", out);
}
// Logs in by email (a code): the session's cookie value in out.
pc_email :: (t: [] Ap, dir: string, address: string, out: [] u8) -> string {
  ap_do(t, "DELETE FROM auth.limit_counts");
  pb: [128] u8; pend: [128] u8; c1: [1] Sb;
  st := ac_start(t, address, "203.0.113.60", false, pb[..]);
  p := ac_cookie(t, "__Host-oa_pending", pb[..]);
  for i: 0..<p.count { pend[i] = p[i]; }
  code: [6] u8; link: [64] u8;
  if st != 200 || !ac_mail(dir, code[..], link[..]) { return ""; }
  vb: [1] Sb; sb(vb[..], "{\"code\":\""); sb(vb[..], cast(string) code[..]); sb(vb[..], "\"}");
  st = ac_call(t, "POST", "/api/auth/email/verify", sb_text(vb[..]), ac_cookie_header("__Host-oa_pending", cast(string) pend[0..<p.count], c1[..]), "", "");
  if st != 200 { return ""; }
  return ac_cookie(t, "__Host-oa_session", out);
}
// Links address to session's account (a code to that address).
pc_link_email :: (t: [] Ap, dir: string, session: string, address: string) -> int {
  ap_do(t, "DELETE FROM auth.limit_counts");
  b: [1] Sb; sb(b[..], "{\"email\":\""); sb(b[..], address); sb(b[..], "\",\"link\":true}");
  st := pc_with(t, "POST", "/api/auth/email/start", sb_text(b[..]), session);
  pb: [128] u8; pend: [128] u8; p := ac_cookie(t, "__Host-oa_pending", pb[..]);
  for i: 0..<p.count { pend[i] = p[i]; }
  code: [6] u8; link: [64] u8;
  if st != 200 || !ac_mail(dir, code[..], link[..]) { return st; }
  vb: [1] Sb; sb(vb[..], "{\"code\":\""); sb(vb[..], cast(string) code[..]); sb(vb[..], "\"}");
  c1: [1] Sb;
  return ac_call(t, "POST", "/api/auth/email/verify", sb_text(vb[..]), ac_cookie_header("__Host-oa_pending", cast(string) pend[0..<p.count], c1[..]), "", "");
}

// What a ceremony is made of, and what the checks change in it.
Pc :: struct {
  rp: string; origin: string;
  flags: int; count: u32;
  signer: int;          // 0 the passkey itself, else another passkey's seed
  handle: string;       // the user handle to send back ("" none)
  name: string;         // register: a typed name ("" none)
  aaguid_icloud: bool;
}
pc_plain :: (t: [] Ap) -> Pc {
  c: Pc; c.rp = "127.0.0.1"; c.origin = t[0].api; c.flags = PS_UP | PS_UV; c.count = 0; c.signer = 0; c.handle = ""; c.name = ""; c.aaguid_icloud = true;
  return c;
}
// Asks for a challenge at path (with this session, or the app's {"client":"app"}); its value in out.
pc_options :: (t: [] Ap, path: string, session: string, app: bool, out: [] u8) -> string {
  st := pc_with(t, "POST", path, ifx app then "{\"client\":\"app\"}" else "{}", session);
  if st != 200 { return ""; }
  return ap_member(ap_body(t), "challenge", out);
}
// Adds key to session's account through a fresh challenge: the status.
pc_register :: (t: [] Ap, session: string, key: Ps, c: Pc) -> int {
  chb: [128] u8; ch := pc_options(t, "/api/auth/passkey/register/options", session, false, chb[..]);
  if ch == "" { return ap_json(t, "GET", "/no-challenge", ""); }
  ub: [128] u8; uid := ap_member(ap_body(t), "user_id", ub[..]);
  return pc_register_with(t, session, key, c, ch, uid);
}
pc_register_with :: (t: [] Ap, session: string, key: Ps, c: Pc, ch: string, uid: string) -> int {
  aaguid: [16] u8;
  if c.aaguid_icloud { _ = cb_unhex("fbfc3007154e4ecc8c0b6e020557d7bd", aaguid[..]); }
  att: [600] u8; a := ps_attestation(key, c.rp, c.flags, c.count, aaguid[..], att[..]);
  cs: [1] Sb; cd := ps_client("webauthn.create", ch, c.origin, cs[..]);
  b: [1] Sb;
  sb(b[..], "{\"challenge\":\""); sb(b[..], ch); sb(b[..], "\",\"attestation\":\""); ps_b64(b[..], a);
  sb(b[..], "\",\"client_data\":\""); ps_b64(b[..], cd); sb(b[..], "\",\"user_id\":\""); sb(b[..], uid);
  sb(b[..], "\",\"transports\":\"internal,hybrid,bogus\",\"prf\":\"1\"");
  if c.name != "" { sb(b[..], ",\"name\":\""); sb(b[..], c.name); sb(b[..], "\""); }
  sb(b[..], "}");
  return pc_with(t, "POST", "/api/auth/passkey/register", sb_text(b[..]), session);
}
// A login or step-up answer for challenge ch, sent to path with these headers: the status.
pc_answer :: (t: [] Ap, path: string, ch: string, key: Ps, c: Pc, h1: string) -> int {
  ad: [64] u8; d := ps_auth_data(key, c.rp, c.flags, c.count, ad[..]);
  cs: [1] Sb; cd := ps_client("webauthn.get", ch, c.origin, cs[..]);
  signer := ifx c.signer == 0 then key else ps_new(c.signer);
  sigb: [80] u8; sig := ps_sign(signer, d, cd, sigb[..]);
  b: [1] Sb;
  sb(b[..], "{\"challenge\":\""); sb(b[..], ch); sb(b[..], "\",\"id\":\""); k := key; ps_b64(b[..], k.id[..]);
  sb(b[..], "\",\"auth_data\":\""); ps_b64(b[..], d); sb(b[..], "\",\"client_data\":\""); ps_b64(b[..], cd);
  sb(b[..], "\",\"signature\":\""); ps_b64(b[..], sig); sb(b[..], "\"");
  if c.handle != "" { sb(b[..], ",\"user_handle\":\""); sb(b[..], c.handle); sb(b[..], "\""); }
  sb(b[..], "}");
  return ac_call(t, "POST", path, sb_text(b[..]), h1, "", "");
}
// A web login: options (a browser cookie), then the answer with that cookie.
pc_login :: (t: [] Ap, key: Ps, c: Pc) -> int {
  ap_do(t, "DELETE FROM auth.limit_counts");
  chb: [128] u8; ch := pc_options(t, "/api/auth/passkey/login/options", "", false, chb[..]);
  bb: [128] u8; browser := ac_cookie(t, "__Host-oa_passkey", bb[..]);
  c1: [1] Sb;
  return pc_answer(t, "/api/auth/passkey/login", ch, key, c, ac_cookie_header("__Host-oa_passkey", browser, c1[..]));
}
pc_stepup :: (t: [] Ap, session: string, key: Ps, c: Pc) -> int {
  chb: [128] u8; ch := pc_options(t, "/api/auth/passkey/step-up/options", session, false, chb[..]);
  if ch == "" { return ap_json(t, "GET", "/no-challenge", ""); }
  c1: [1] Sb;
  return pc_answer(t, "/api/auth/passkey/step-up", ch, key, c, ac_cookie_header("__Host-oa_session", session, c1[..]));
}

