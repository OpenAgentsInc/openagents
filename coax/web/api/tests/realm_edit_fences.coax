// Real PostgreSQL acceptance checks for the optional realm edit revision fence.
// Run against an isolated database with all API migrations applied:
//   PGURL=... PSQL=/path/to/psql coax/web/tool.sh coax/web/api/tests/realm_edit_fences.coax
// Each scenario rolls back its fixtures. No real identity or model is used.
#import "Basic";
#load "../../../lib/sys/tool.coax";
#load "../../../lib/sys/proc.coax";

ref_sql :: (db: string, psql: string, name: string, body: string) -> bool {
  a := [8] string.[psql, "-XAt", "-v", "ON_ERROR_STOP=1", "--dbname", db, "-c", body];
  out: [4096] u8; err: [8192] u8;
  r := proc_run(a[..], 15000, out[..], err[..]);
  if r.status == 0 && !r.timed_out { print("ok %\n", name); return true; }
  tool_err("FAIL "); tool_errln(name); tool_err(cast(string) err[0..<r.err_n]);
  return false;
}

tool_main :: () -> int #export_c {
  dbb: [1024] u8; pb: [1024] u8;
  db := proc_getenv("PGURL", dbb[..]); psql := proc_getenv("PSQL", pb[..]);
  if db == "" || psql == "" { tool_errln("set PGURL and PSQL for an isolated migrated database"); return 2; }
  pass := 0;
  if ref_sql(db, psql, "stale and malformed revisions preserve all edit paths", "BEGIN; INSERT INTO verse.players(id,key_sha256,created_ms) VALUES ('p-fence-test',encode(sha256(convert_to('fence-test-player-key-001','UTF8')),'hex'),1); INSERT INTO verse.worlds(id,owner_player,created_ms) VALUES ('made-fence-test','p-fence-test',1); INSERT INTO verse.made_realms(slug,world,name,style,ground,time,features,tools,made_ms) VALUES ('fence-test','made-fence-test','Fence Test','lowpoly','grass','day','[{\"feature\":\"trees\",\"count\":4}]','{}',1); DO $$ DECLARE op text; x jsonb; before jsonb; bad jsonb; BEGIN SELECT to_jsonb(m) INTO before FROM verse.made_realms m WHERE slug='fence-test'; FOREACH op IN ARRAY ARRAY['switch','settings','place','lore','quest','ask-delete','row-delete','ask-done','accept','decline','visibility'] LOOP x:=verse.realm_edit_call('fence-test','{\"rev\":999}', 'fence-test-player-key-001',true,op,'1'); IF x <> '{\"status\":409,\"error\":\"changed since\",\"rev\":1}'::jsonb THEN RAISE EXCEPTION 'stale %: %',op,x; END IF; END LOOP; FOREACH bad IN ARRAY ARRAY['null'::jsonb,'\"1\"'::jsonb,'0'::jsonb,'-1'::jsonb,'1.5'::jsonb,'9223372036854775808'::jsonb] LOOP x:=verse.realm_edit_call('fence-test',jsonb_build_object('rev',bad),'fence-test-player-key-001',true,'settings',''); IF x->>'status' <> '400' THEN RAISE EXCEPTION 'bad revision %: %',bad,x; END IF; END LOOP; IF before IS DISTINCT FROM (SELECT to_jsonb(m) FROM verse.made_realms m WHERE slug='fence-test') THEN RAISE EXCEPTION 'refusal changed realm'; END IF; END $$; ROLLBACK;") { pass += 1; }
  if ref_sql(db, psql, "fresh edit advances, replay refuses, legacy caller remains compatible", "BEGIN; INSERT INTO verse.players(id,key_sha256,created_ms) VALUES ('p-fence-test',encode(sha256(convert_to('fence-test-player-key-001','UTF8')),'hex'),1); INSERT INTO verse.worlds(id,owner_player,created_ms) VALUES ('made-fence-test','p-fence-test',1); INSERT INTO verse.made_realms(slug,world,name,style,ground,time,features,tools,made_ms) VALUES ('fence-test','made-fence-test','Fence Test','lowpoly','grass','day','[{\"feature\":\"trees\",\"count\":4}]','{}',1); DO $$ DECLARE x jsonb; BEGIN x:=verse.realm_edit_call('fence-test','{\"rev\":1,\"row\":\"trees\",\"on\":false}','fence-test-player-key-001',false,'switch',''); IF x->>'status' <> '200' OR x->>'rev' <> '2' THEN RAISE EXCEPTION 'fresh %',x; END IF; x:=verse.realm_edit_call('fence-test','{\"rev\":1,\"row\":\"trees\",\"on\":true}','fence-test-player-key-001',false,'switch',''); IF x->>'status' <> '409' THEN RAISE EXCEPTION 'replay %',x; END IF; x:=verse.realm_edit_call('fence-test','{\"row\":\"trees\",\"on\":true}','fence-test-player-key-001',false,'switch',''); IF x <> '{\"status\":200,\"row\":\"trees\",\"on\":true}'::jsonb THEN RAISE EXCEPTION 'legacy %',x; END IF; x:=verse.realm_edit_call('fence-test','{\"rev\":3,\"who\":\"kai\",\"text\":\"A traveller\"}','fence-test-player-key-001',false,'lore',''); IF x->>'status' <> '200' OR x->>'rev' <> '4' THEN RAISE EXCEPTION 'lore %',x; END IF; IF position(E'edit_fence 1\\n' in verse.realm_edit_spec('fence-test','fence-test-player-key-001',false))=0 THEN RAISE EXCEPTION 'no capability'; END IF; END $$; ROLLBACK;") { pass += 1; }
  if ref_sql(db, psql, "async revise, ask and document results cannot overwrite an intervening edit", "BEGIN; INSERT INTO verse.players(id,key_sha256,created_ms) VALUES ('p-fence-test',encode(sha256(convert_to('fence-test-player-key-001','UTF8')),'hex'),1); INSERT INTO verse.worlds(id,owner_player,created_ms) VALUES ('made-fence-test','p-fence-test',1); INSERT INTO verse.made_realms(slug,world,name,style,ground,time,features,tools,made_ms) VALUES ('fence-test','made-fence-test','Fence Test','lowpoly','grass','day','[{\"feature\":\"trees\",\"count\":4}]','{}',1); DO $$ DECLARE op text; asked jsonb; x jsonb; r bigint; snap jsonb; BEGIN FOREACH op IN ARRAY ARRAY['revise','ask','ask-doc'] LOOP UPDATE verse.realm_plans SET ms=0 WHERE slug='fence-test'; SELECT rev INTO r FROM verse.made_realms WHERE slug='fence-test'; asked:=verse.realm_edit_start('fence-test',jsonb_build_object('rev',r,'prompt','night','words','night','name','design.md','text','night'),100000,'fence-test-player-key-001',false,op); IF asked->>'status' <> '200' OR NOT asked ? 'edit_fence' OR NOT asked ? 'request' THEN RAISE EXCEPTION 'start %: %',op,asked; END IF; x:=verse.realm_save('fence-test',jsonb_build_object('rev',r,'moved',jsonb_build_array(jsonb_build_object('entity','trees:0','x',r,'z',0))),'fence-test-player-key-001',false); SELECT to_jsonb(m) INTO snap FROM verse.made_realms m WHERE slug='fence-test'; x:=verse.realm_edit_finish(asked,200,'{}','test',0,op); IF x->>'status' <> '409' OR (x->>'rev')::bigint <> r+1 THEN RAISE EXCEPTION 'completion %: %',op,x; END IF; IF snap IS DISTINCT FROM (SELECT to_jsonb(m) FROM verse.made_realms m WHERE slug='fence-test') THEN RAISE EXCEPTION 'completion overwrote realm'; END IF; END LOOP; END $$; ROLLBACK;") { pass += 1; }
  print("%/3 realm revision fence scenarios passed\n", pass);
  return ifx pass == 3 then 0 else 1;
}
