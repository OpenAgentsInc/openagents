// End-to-end async fence: a local fake model changes the realm while the C request is pending.
// Start an isolated API with OA_BUILDER_URL=http://127.0.0.1:51391/model, then run this tool twice:
// MODEL_SERVER=1 PGURL=... PSQL=... coax/web/tool.sh coax/web/api/tests/realm_edit_model_race.coax
// API=http://127.0.0.1:PORT PGURL=... PSQL=... coax/web/tool.sh coax/web/api/tests/realm_edit_model_race.coax
// The fake model serves exactly three requests on loopback and then exits. No external model.
// tool.sh: tls
#import "Basic";
#load "../../../lib/sys/tool.coax";
#load "../../../lib/sys/proc.coax";
#load "../../../lib/net/http.coax";
#load "../../../lib/json/json.coax";

rem_sql :: (db: string, psql: string, sql: string) -> bool {
  a := [8] string.[psql,"-XAt","-v","ON_ERROR_STOP=1","--dbname",db,"-c",sql];
  out: [4096] u8; err: [8192] u8; got := proc_run(a[..],15000,out[..],err[..]);
  if got.status == 0 && !got.timed_out { return true; }
  tool_err(cast(string) err[0..<got.err_n]); return false;
}
rem_server :: (db: string, psql: string) -> int {
  listener := cxsock_listen(51391);
  if listener < 0 { tool_errln("fake model cannot listen on loopback:51391"); return 1; }
  for k: 0..<3 {
    h := cxsock_accept(listener,30000); if h < 0 { return 1; }
    request: [131072] u8; used := 0; total := -1;
    while total < 0 || used < total {
      n := cxsock_read(h,5000); if n <= 0 || used+n > request.count { return 1; }
      for i: 0..<n { request[used+i] = cast,trunc(u8) cxsock_byte(h,i); } used += n;
      if total < 0 && used >= 4 {
        s := cast(string) request[0..<used]; end := -1; size := -1;
        for i: 0..<used-3 { if s[i..<i+4] == "\r\n\r\n" { end = i+4; break; } }
        if end > 0 {
          for i: 0..<end-15 {
            if s[i..<i+15] != "Content-Length:" { continue; }
            j := i+15; while j < end && s[j] == ' ' { j += 1; }
            size = 0; while j < end && s[j] >= '0' && s[j] <= '9' { size = size*10 + cast(int) (s[j]-'0'); j += 1; }
          }
          if size < 0 || size > request.count-end { return 1; } total = end+size;
        }
      }
    }
    if !rem_sql(db,psql,"UPDATE verse.made_realms SET rev=rev+1,time='dawn' WHERE slug='fence-model';") { return 1; }
    reply := "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}";
    for c: reply { if cxsock_write(h,cast(int) c) != 0 { return 1; } }
    if cxsock_flush(h,5000) != 0 { return 1; }
    closed := cxsock_close(h);
  }
  closed := cxsock_close(listener); return 0;
}
tool_main :: () -> int #export_c {
  dbb: [1024] u8; pb: [1024] u8; ab: [256] u8; mb: [8] u8;
  db := proc_getenv("PGURL",dbb[..]); psql := proc_getenv("PSQL",pb[..]);
  if db == "" || psql == "" { tool_errln("set PGURL and PSQL for an isolated database"); return 2; }
  if proc_getenv("MODEL_SERVER",mb[..]) == "1" { return rem_server(db,psql); }
  api := proc_getenv("API",ab[..]);
  if api.count < 18 || api[0..<17] != "http://127.0.0.1:" { tool_errln("set local API=http://127.0.0.1:PORT"); return 2; }
  if !rem_sql(db,psql,"INSERT INTO verse.players(id,key_sha256,created_ms) VALUES ('p-fence-model',encode(sha256(convert_to('fence-model-player-key-001','UTF8')),'hex'),1); INSERT INTO verse.worlds(id,owner_player,created_ms) VALUES ('made-fence-model','p-fence-model',1); INSERT INTO verse.made_realms(slug,world,name,style,ground,time,features,tools,made_ms) VALUES ('fence-model','made-fence-model','Fence Model','lowpoly','grass','day','[{\"feature\":\"trees\",\"count\":4}]','{}',1);") { return 1; }
  tails := [3] string.["/edit-v1/revise","/edit-v1/asks","/edit-v1/asks/doc"];
  bodies := [3] string.["{\"rev\":1,\"prompt\":\"night\"}","{\"rev\":2,\"words\":\"night\"}","{\"rev\":3,\"name\":\"design.md\",\"data\":\"bmlnaHQ=\"}"];
  pass := 0;
  for i: 0..<3 {
    if !rem_sql(db,psql,"UPDATE verse.realm_plans SET ms=0 WHERE slug='fence-model';") { break; }
    url: [512] u8; n := 0;
    for c: api { url[n] = c; n += 1; }
    for c: "/api/playtest/realms/fence-model" { url[n] = c; n += 1; }
    for c: tails[i] { url[n] = c; n += 1; }
    hs := [2] string.["X-Verse-Player: fence-model-player-key-001","Content-Type: application/json"];
    w: [1] HttpWork; out: [HTTP_BODY_MAX] u8;
    got := http_do(w[..],"POST",cast(string) url[0..<n],hs[..],bodies[i],10000,0,out[..]);
    text := cast(string) out[0..<got.n]; nodes: [64] JvNode; d: [1] Jv;
    if got.error == HTTP_OK && got.code == 409 && jv_parse(d[..],text,nodes[..]) && jv_int(d[0],jv_get(d[0],0,"rev"),-1) == i+2 {
      pass += 1; print("ok C async fence retained through % model completion\n",tails[i]);
    } else { print("FAIL %: status %, %\n",tails[i],got.code,text); }
  }
  clean := rem_sql(db,psql,"DELETE FROM verse.made_realms WHERE slug='fence-model'; DELETE FROM verse.worlds WHERE id='made-fence-model'; DELETE FROM verse.players WHERE id='p-fence-model';");
  return ifx pass == 3 && clean then 0 else 1;
}
