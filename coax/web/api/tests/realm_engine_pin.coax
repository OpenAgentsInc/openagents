// The made realm's document checks in SQL (GitHub #12629): runs one rolled-back check file against
// PostgreSQL with every migration applied. Each check prints an "ok" line and the file ends with
// "done N"; the run passes when psql exits 0 and N checks said ok. No API, bucket, identity or
// model is used. PIN_SQL picks the file (realm_engine_pin.sql when unset; realm_shapes.sql,
// realm_walkthrough.sql).
//   PGURL=... PSQL=psql [PIN_SQL=FILE] coax/web/tool.sh coax/web/api/tests/realm_engine_pin.coax
#import "Basic";
#load "../../../lib/sys/tool.coax";
#load "../../../lib/sys/proc.coax";

// The number after "done ", or -1.
pin_done :: (line: string) -> int {
  if line.count < 6 || line[0..<5] != "done " { return -1; }
  v := 0;
  for c: line[5..<line.count] { if c < '0' || c > '9' { return -1; } v = v * 10 + cast(int) (c - '0'); }
  return v;
}

tool_main :: () -> int #export_c {
  dbb: [1024] u8; pb: [1024] u8; fb: [1024] u8;
  db := proc_getenv("PGURL", dbb[..]); psql := proc_getenv("PSQL", pb[..]);
  file := proc_getenv("PIN_SQL", fb[..]);
  if file == "" { file = "coax/web/api/tests/realm_engine_pin.sql"; }
  if db == "" || psql == "" { tool_errln("set PGURL and PSQL (a database with every migration applied)"); return 2; }
  a := [8] string.[psql, "-XAtq", "-v", "ON_ERROR_STOP=1", "--dbname", db, "-f", file];
  out: [16384] u8; err: [8192] u8;
  got := proc_run(a[..], 300000, out[..], err[..]);
  text := cast(string) out[0..<got.out_n];
  oks := 0; want := -1; at := 0;
  for i: 0..<text.count + 1 {
    if i == text.count || text[i] == '\n' {
      line := text[at..<i]; at = i + 1;
      if line.count > 3 && line[0..<3] == "ok " { oks += 1; print("%\n", line); }
      if pin_done(line) >= 0 { want = pin_done(line); }
    }
  }
  if got.status != 0 || got.timed_out || want < 1 || oks != want {
    tool_err("realm checks: "); tool_errln(cast(string) err[0..<got.err_n]);
    print("FAIL % of % checks in %\n", oks, want, file);
    return 1;
  }
  print("ok %: % checks\n", file, oks);
  return 0;
}
