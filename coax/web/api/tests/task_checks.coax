// Built CLI -> signed HTTP -> disposable database -> typed broker process.
// Native task effects/replay are qualified separately by task-host-smoke.coax.
// tool.sh: tls
#load "cli_harness.coax";
#load "auth_harness.coax";
#load "../../../lib/agent/environment/task-wire.coax";
#load "../../../lib/sys/clock.coax";
TAPI_HOST :: "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
TAPI_ID :: "0123456789abcdef0123456789abcdef";
TAPI_PATH :: "/api/chat/task/v1alpha1?host=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
TAPI_READ :: "/api/chat/task/v1alpha1?host=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd&task=0123456789abcdef0123456789abcdef";
tk_call :: (t:[]Ap,key:string,method:string,path:string,body:string,extra:string)->int {
 url:[1]Sb;sb(url[..],t[0].api);sb(url[..],path);token:[4096]u8;header:[1]Sb;sb(header[..],"Authorization: Nostr ");sb(header[..],ap_nostr(t,key,method,sb_text(url[..]),body,method=="POST",token[..]));return ac_call(t,method,path,body,sb_text(header[..]),extra,"");
}
tk_sql :: (t:[]Ap,account:string,prefix:string,suffix:string) {q:[1]Sb;sb(q[..],prefix);sb(q[..],account);sb(q[..],suffix);ap_do(t,sb_text(q[..]));}
tk_epoch :: (t:[]Ap,account:string,n:int) {q:[1]Sb;sb(q[..],"UPDATE chat.environment_connections_v1 SET epoch=");sb_int(q[..],n);sb(q[..]," WHERE account='");sb(q[..],account);sb(q[..],"'");ap_do(t,sb_text(q[..]));}
tk_count :: (audit:string)->int {raw:[65536]u8;n:=fs_read(audit,raw[..]);count:=0;if n>0 {for c:raw[0..<n] {if c=='\n' {count+=1;}}}return count;}
tk_checks :: (t:[]Ap,c:[]Sc,audit:string) {
 kb:[1024]u8;key:=fs_join(c[0].dir,"key",kb[..]);pkb:[128]u8;pk:=ac_newkey(t,key,pkb[..]);if !sc_key(c,key) {ap_check(t,"private CLI key available",false,"");return;}
 st:=ac_call(t,"GET",TAPI_READ,"","","","");ap_check(t,"native task reads require login",st==401,ap_body(t));
 show:=[4]string.["tasks","show",TAPI_HOST,TAPI_ID];st=sc_cli(t,c,show[..]);ap_check(t,"an unlinked signed key cannot read tasks",st==3,sc_text(c));
 q:[1]Sb;sb(q[..],"SELECT acct FROM auth.account_for_key('");sb(q[..],pk);sb(q[..],"','Native task CLI fixture')");ab:[80]u8;account:=ap_sql(t,sb_text(q[..]),ab[..]);
 st=sc_cli(t,c,show[..]);ap_check(t,"a linked account without this connection cannot read a task",st==6,sc_text(c));
 tk_sql(t,account,"UPDATE auth.accounts SET team=true WHERE id='","'");
 tk_sql(t,account,"INSERT INTO chat.environment_connections_v1(account,host_pubkey,display_name,grant_id,epoch,relay) VALUES ('","',repeat('dd',32),'Task computer',repeat('ee',32),0,'wss://relay.openagents.com')");
 st=sc_cli(t,c,show[..]);ap_check(t,"a connection alone cannot inspect a foreign conversation binding",st==6,sc_text(c));
 tk_sql(t,account,"INSERT INTO chat.conversations_v2(id,account,revision,title,created_ms,updated_ms) VALUES ('cnv_0123456789abcdef0123456789abcdef','","',1,'Native task',1,1)");
 tk_sql(t,account,"INSERT INTO chat.turns_v2(id,account,conversation,ordinal,operation,digest,request_json,input_json,state,model,provider,effort,created_ms,updated_ms) VALUES ('trn_0123456789abcdef0123456789abcdef','","','cnv_0123456789abcdef0123456789abcdef',1,'native-task-fixture','fixture','{}','{}',3,'fixture-native-model','fixture','high',1,1)");
 st=tk_call(t,key,"GET",TAPI_READ,"","");v:[1]XtStatus;arena:[2048]u8;ap_check(t,"owned task GET returns the primary typed status and native session",st==200 && xt_status_read(ap_body(t),v[..],arena[..]) && v[0].state==XT_WAITING && v[0].interaction=="native-request" && v[0].native=="native-session",ap_body(t));
 ap_check(t,"task observations are private and uncached",ap_has(ap_header(t,"Cache-Control"),"no-store") && ap_has(ap_header(t,"Cache-Control"),"private") && ap_has(ap_header(t,"Vary"),"Authorization") && !ap_has(ap_body(t),"grant_id") && !ap_has(ap_body(t),"/unused"),ac_head(t));
 st=sc_cli(t,c,show[..]);ap_check(t,"the built CLI reads the same owned native task",st==0 && xt_status_read(sc_text(c),v[..],arena[..]) && v[0].revision==3,sc_text(c));
 // Public dispatch cannot take an arbitrary caller route or Binding.
 body:[4096]u8;n:=xt_request_write(XtRequest.{method="StartTask",task=TAPI_ID,command=TAPI_ID,issued=1,expires=300001,route="{}"},body[..]);st=tk_call(t,key,"POST",TAPI_PATH,cast(string)body[0..<n],"");ap_check(t,"public task controls cannot start caller-directed work",st==400,ap_body(t));
 n=xt_request_write(XtRequest.{method="ReadTask",task=TAPI_ID},body[..]);st=tk_call(t,key,"POST",TAPI_PATH,cast(string)body[0..<n],"");ap_check(t,"POST observation stays read-only",st==200,ap_body(t));
 st=tk_call(t,key,"POST",TAPI_PATH,cast(string)body[0..<n],"Origin: https://foreign.example");ap_check(t,"cross-site task writes are refused",st==403,ap_body(t));
 st=tk_call(t,key,"GET","/api/chat/task/v1alpha1?host=bad&task=bad","","");ap_check(t,"invalid task references fail before contacting a computer",st==400,ap_body(t));
 st=tk_call(t,key,"GET","/api/chat/task/v1alpha1?host=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd0&task=0123456789abcdef0123456789abcdef","","");ap_check(t,"an overlong host cannot become its valid truncated prefix",st==400,ap_body(t));
 st=tk_call(t,key,"GET","/api/chat/task/v1alpha1?host=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd&task=0123456789abcdef0123456789abcdef0","","");ap_check(t,"an overlong task cannot become its valid truncated prefix",st==400,ap_body(t));
 fb:[1024]u8;file:=fs_join(c[0].dir,"approve.json",fb[..]);approve:=[10]string.["tasks","approve",TAPI_HOST,TAPI_ID,"--rev","3","--interaction","native-request","--command-file",file];st=sc_cli(t,c,approve[..]);ap_check(t,"CLI permission approval reaches the typed broker",st==0 && xt_status_read(sc_text(c),v[..],arena[..]) && v[0].state==XT_COMPLETED && v[0].command.count==32,sc_text(c));
 original:[4096]u8;original_n:=fs_read(file,original[..]);request:[1]XtRequest;ra:[2048]u8;ap_check(t,"CLI retains the complete original command with a real wall-clock window before HTTP",original_n>0 && xt_request_read(cast(string)original[0..<original_n],request[..],ra[..]) && request[0].allow && request[0].revision==3 && request[0].expires-request[0].issued==300000 && ea_fresh(request[0].issued,request[0].expires,cxproc_wall_us()/1000),"");
 retry:=[5]string.["tasks","retry",TAPI_HOST,"--file",file];st=sc_cli(t,c,retry[..]);ap_check(t,"CLI retries the retained command without changing its window or ID",st==0 && xt_status_read(sc_text(c),v[..],arena[..]) && v[0].command==request[0].command,sc_text(c));
 audit_raw:[65536]u8;an:=fs_read(audit,audit_raw[..]);ap_check(t,"the broker receives byte-identical permission intent on retry",an==2*(original_n+1) && cast(string)audit_raw[0..<original_n]==cast(string)original[0..<original_n] && cast(string)audit_raw[original_n+1..<2*original_n+1]==cast(string)original[0..<original_n],"");
 changed:=approve;changed[5]="4";before:=tk_count(audit);st=sc_cli(t,c,changed[..]);ap_check(t,"changed receipt reuse is refused locally before another control",st==2 && tk_count(audit)==before,sc_text(c));
 changed=approve;changed[1]="deny";st=sc_cli(t,c,changed[..]);ap_check(t,"a retained approval cannot become a denial",st==2 && tk_count(audit)==before,sc_text(c));
 db:[1024]u8;denial:=fs_join(c[0].dir,"deny.json",db[..]);changed[9]=denial;st=sc_cli(t,c,changed[..]);ap_check(t,"a fresh explicit denial reaches the native request",st==0 && tk_count(audit)==before+1,sc_text(c));
 stopbuf:[1024]u8;stopfile:=fs_join(c[0].dir,"stop.json",stopbuf[..]);stop:=[6]string.["tasks","stop",TAPI_HOST,TAPI_ID,"--command-file",stopfile];st=sc_cli(t,c,stop[..]);ap_check(t,"CLI Stop returns confirmed native cancellation",st==0 && xt_status_read(sc_text(c),v[..],arena[..]) && v[0].state==XT_CANCELED && v[0].stop,sc_text(c));
 tk_sql(t,account,"UPDATE auth.accounts SET team=false WHERE id='","'");before=tk_count(audit);st=sc_cli(t,c,approve[..]);ap_check(t,"an unfunded account cannot approve execution",st==4 && tk_count(audit)==before,sc_text(c));
 st=sc_cli(t,c,show[..]);ap_check(t,"loss of funding does not hide saved task status",st==0,sc_text(c));st=sc_cli(t,c,stop[..]);ap_check(t,"loss of funding does not prevent Stop",st==0 && tk_count(audit)==before+1,sc_text(c));
 tk_sql(t,account,"UPDATE auth.accounts SET team=true WHERE id='","'");
 // Same host/grant on two accounts is ambiguous even if one owns the turn.
 k2b:[1024]u8;key2:=fs_join(c[0].dir,"other-key",k2b[..]);p2b:[128]u8;pk2:=ac_newkey(t,key2,p2b[..]);sb_clear(q[..]);sb(q[..],"SELECT acct FROM auth.account_for_key('");sb(q[..],pk2);sb(q[..],"','Other task account')");a2b:[80]u8;other:=ap_sql(t,sb_text(q[..]),a2b[..]);tk_sql(t,other,"UPDATE auth.accounts SET team=true WHERE id='","'");
 _:=sc_key(c,key2);before=tk_count(audit);st=sc_cli(t,c,stop[..]);ap_check(t,"another account cannot control a computer it has not enrolled",st==6 && tk_count(audit)==before,sc_text(c));
 tk_sql(t,other,"INSERT INTO chat.environment_connections_v1(account,host_pubkey,display_name,grant_id,epoch,relay) VALUES ('","',repeat('dd',32),'Other task computer',repeat('ee',32),0,'wss://relay.openagents.com')");
 st=sc_cli(t,c,show[..]);ap_check(t,"a grant shared ambiguously across accounts is refused",st==5,sc_text(c));_=sc_key(c,key);st=sc_cli(t,c,show[..]);ap_check(t,"the owner also cannot use an ambiguous enrollment",st==5,sc_text(c));
 tk_sql(t,other,"UPDATE chat.environment_connections_v1 SET grant_id=repeat('ff',32) WHERE account='","'");_=sc_key(c,key2);st=sc_cli(t,c,show[..]);ap_check(t,"an independent connection cannot read another account's task binding",st==6,sc_text(c));st=sc_cli(t,c,stop[..]);ap_check(t,"foreign binding preflight blocks Stop before any native control",st==6 && tk_count(audit)==before,sc_text(c));_=sc_key(c,key);
 // Native transport exits and typed negative replies are kept distinct.
 tk_epoch(t,account,99);before=tk_count(audit);st=sc_cli(t,c,stop[..]);ap_check(t,"a changed immutable binding in a control reply is rejected",st!=0 && ap_has(sc_text(c),"502") && tk_count(audit)==before+1,sc_text(c));
 tk_epoch(t,account,94);st=sc_cli(t,c,stop[..]);ap_check(t,"a different native command reply cannot acknowledge this control",st!=0 && ap_has(sc_text(c),"502"),sc_text(c));
 tk_epoch(t,account,91);before=tk_count(audit);st=sc_cli(t,c,stop[..]);ap_check(t,"native revocation after preflight refuses the control without an effect",st==4 && tk_count(audit)==before,sc_text(c));
 for epoch,i:[5]int.[98,97,96,95,92] {tk_epoch(t,account,epoch);st=sc_cli(t,c,show[..]);want:=[5]int.[4,5,7,1,1];ap_check(t,"native denial expiry capacity malformed output and transport retain distinct failures",st==want[i],sc_text(c));}
 tk_epoch(t,account,0);
}
tool_main :: ()->int #export_c #effects(all) {
 t:[1]Ap;if !ap_open(t[..]) {return 2;}c:[1]Sc;cb:[1024]u8;c[0].cli=proc_getenv("CLI",cb[..]);db:[1024]u8;c[0].dir=fs_temp("native-task-cli",db[..]);audit:=ap_env(t[..],"OA_ENV_TASK_FIXTURE_AUDIT");tk_checks(t[..],c[..],audit);_=fs_remove(c[0].dir);return ap_done(t[..],"native task API and CLI");
}
