// A world's document through the API's routes (GitHub #13412, the browser editor's E3): Splice,
// the first world with an ID, read and edited at /api/worlds/splice-bots against test.sh's throwaway
// Postgres and API. Who may write (an admin, signed), the revision fence (409), a refusal in words
// naming the zone (422), the undo log, ORIGINAL, one outbox event a saved edit, and the dev and
// live revisions with the now and next-session rule and the revision kept for one release.
// Every body is read through the codec the API writes it with (metaverse-engine/editor/world-edit.coax).
// And a world's imported assets (#13420): a file named before it is sent, the upload opened in the
// bucket for an admin only, the object read back and checked against its name, the import, the
// pack by lane, and a row that draws a pack mesh held to the pack. The bucket is a fake on
// GCS_PORT, this program in its `bucket` mode, which keeps each object as a file.
//   API=... PGURL=... PSQL=... SIGN=... ADMIN_KEY=... OTHER_KEY=... GCS_PORT=... coax/web/tool.sh coax/web/api/tests/world_checks.coax
//   coax/web/tool.sh coax/web/api/tests/world_checks.coax bucket PORT DIR   (the fake bucket)
// tool.sh: stack-gib 1
#load "api_harness.coax";
#load "../../../lib/sys/args.coax";
#load "../../../../metaverse-engine/editor/world-edit.coax";
#load "../../../../metaverse-engine/editor/world-live.coax";
#load "../../../../metaverse-engine/editor/pack-import.coax";          // the files the checks import are made here, and their names
#load "../../../../metaverse-engine/editor/pack-import-checks.coax";   // pit_box, pit_wav
#load "../../../../metaverse-engine/editor/asset-wire.coax";

WC_PATH :: "/api/worlds/splice-bots";
// A palm by the scanner gate and a small crate by the rover's door, as metaverse/splice-bots/world-checks.coax places them.
WC_SPAWNS :: "{\"op\":\"spawn\",\"id\":0,\"kind\":113,\"x\":17720,\"y\":0,\"z\":-7060,\"yaw\":0,\"scale\":100},{\"op\":\"spawn\",\"id\":0,\"kind\":117,\"x\":280,\"y\":0,\"z\":150,\"yaw\":0,\"scale\":100}";
WC_IN_GATE :: "{\"op\":\"spawn\",\"id\":0,\"kind\":113,\"x\":17500,\"y\":0,\"z\":-6700,\"yaw\":0,\"scale\":100}";

Wc :: struct { doc: [200000] u8; did: [WE_BATCH_BODY] u8; scratch: [400000] u8; st: WorldState; words: [300] u8; content: int; }
wc_batch :: (b: [] Sb, rev: int, what: string, edits: string) -> string {
  sb_clear(b); sb(b, "{\"schema\":\"world.edit.v1\",\"rev\":"); sb_int(b, rev); sb(b, ",\"do\":\""); sb(b, what); sb(b, "\",\"edits\":["); sb(b, edits); sb(b, "]}");
  return sb_text(b);
}
// A signed POST of a batch: its status. The answer's state, when it is one, is in w[0].st.
wc_post :: (t: [] Ap, w: [] Wc, key: string, rev: int, what: string, edits: string) -> int { return wc_post_to(t, w, key, WC_PATH, rev, what, edits); }
wc_post_to :: (t: [] Ap, w: [] Wc, key: string, path: string, rev: int, what: string, edits: string) -> int {
  b: [1] Sb; body := wc_batch(b[..], rev, what, edits);
  url: [1] Sb; sb(url[..], t[0].api); sb(url[..], path);
  sig: [4096] u8; s := ap_nostr(t, key, "POST", sb_text(url[..]), body, true, sig[..]);
  auth: [1] Sb; sb(auth[..], "Authorization: Nostr "); sb(auth[..], s);
  h := [2] string.["Content-Type: application/json", sb_text(auth[..])];
  st := ap_call(t, "POST", path, body, h[..]);
  w[0].st = we_state_read(ap_body(t), w[0].doc[..], w[0].did[..], w[0].scratch[..]);
  return st;
}
wc_get :: (t: [] Ap, w: [] Wc, query: string) -> int {
  p: [1] Sb; sb(p[..], WC_PATH); sb(p[..], query);
  st := ap_call(t, "GET", sb_text(p[..]), "", t[0].no[0..<0]);
  w[0].st = we_state_read(ap_body(t), w[0].doc[..], w[0].did[..], w[0].scratch[..]);
  return st;
}
wc_doc :: (w: [] Wc) -> string { return cast(string) w[0].doc[0..<w[0].st.doc_n]; }
wc_did :: (w: [] Wc) -> string { return cast(string) w[0].did[0..<w[0].st.did_n]; }
// A refusal's words, and the edit it names in `edit`.
wc_refusal :: (t: [] Ap, w: [] Wc, edit: [] int) -> string {
  r := we_refusal_read(ap_body(t), w[0].words[..]);
  edit[0] = r.edit;
  return ifx r.ok then cast(string) w[0].words[0..<r.words_n] else "";
}
wc_reset :: (t: [] Ap) {
  ap_do(t, "DELETE FROM verse.world_outbox WHERE world = 'splice-bots'; DELETE FROM verse.world_steps WHERE world = 'splice-bots'; DELETE FROM verse.world_docs WHERE id = 'splice-bots'; INSERT INTO verse.world_docs (id, kind) VALUES ('splice-bots', 'splice-bots');");
}
// The lines of an events answer: how many, and each read by the codec. `first`: the revision the first carries.
wc_events :: (t: [] Ap, query: string, first: int, kind: int) -> int {
  p: [1] Sb; sb(p[..], WC_PATH); sb(p[..], "/events"); sb(p[..], query);
  if ap_call(t, "GET", sb_text(p[..]), "", t[0].no[0..<0]) != 200 { return -1; }
  body := ap_body(t); at := 0; n := 0;
  while at < body.count {
    end := at;
    while end < body.count && body[end] != '\n' { end += 1; }
    line := body[at..<end]; at = end + 1;
    if we_event_kind(line) != kind { return -2; }
    if kind == 1 { v := we_event_read(line); if !v.ok || v.rev != first + n || !we_event_world_is(v, "splice-bots") { return -3; } }
    if kind == 2 { v := we_published_read(line); if !v.ok || v.rev != first + n { return -3; } }
    n += 1;
  }
  return n;
}

wc_checks :: (t: [] Ap, w: [] Wc, other: string) {
  edit: [1] int; q: [200] u8;
  wc_reset(t);
  // ---- reading
  ap_check(t, "world: a world nobody made is not found", wc_get(t, w, "?lane=dev") == 200 && ap_call(t, "GET", "/api/worlds/nope?lane=dev", "", t[0].no[0..<0]) == 404 && ap_call(t, "GET", "/api/worlds/Splice", "", t[0].no[0..<0]) == 404, ap_body(t));
  st := wc_get(t, w, "?lane=dev");
  ap_check(t, "world: Splice's dev revision reads before its first edit: revision 0 and its document", st == 200 && w[0].st.ok && w[0].st.rev == 0 && w[0].st.dev == 0 && w[0].st.live == 0 && w[0].st.undo == 0 && w[0].st.redo == 0 && w[0].st.build[0] == 1 && w[0].st.build[3] == 1 && ap_starts(wc_doc(w), "world.doc.v1 splice-bots\ncontent "), ap_body(t));
  w[0].content = ap_whole(ct_part(ct_part(wc_doc(w), '\n', 1), ' ', 1));
  ap_check(t, "world: an answer names the build that reads it: its content pin is the document's", w[0].st.build[2] == w[0].content && w[0].content >= 1, "");
  st = wc_get(t, w, "");
  ap_check(t, "world: nothing is live until a publish", st == 404 && wc_refusal(t, w, edit[..]) == "nothing is published yet" && wc_get(t, w, "?lane=side") == 400, ap_body(t));
  // ---- who may write
  b: [1] Sb;
  st = ap_json(t, "POST", WC_PATH, wc_batch(b[..], 0, "apply", WC_SPAWNS));
  ap_check(t, "world: a write nobody signed is asked to log in", st == 401 && wc_refusal(t, w, edit[..]) == "log in", ap_body(t));
  st = wc_post(t, w, other, 0, "apply", WC_SPAWNS);
  ap_check(t, "world: a signed write by someone who is no admin is refused", st == 403 && wc_refusal(t, w, edit[..]) == "only its owner or an admin changes this world", ap_body(t));
  ho := [2] string.["Content-Type: application/json", "Origin: https://evil.example"];
  st = ap_call(t, "POST", WC_PATH, wc_batch(b[..], 0, "apply", WC_SPAWNS), ho[..]);
  ap_check(t, "world: a write from another site's page is refused", st == 403 && wc_refusal(t, w, edit[..]) == "cross-site", ap_body(t));
  st = wc_post(t, w, t[0].admin_key, 0, "save", "");
  ap_check(t, "world: what is no batch is refused, and nothing was written so far", st == 400 && ap_sql(t, "SELECT dev_rev || ' ' || steps || ' ' || (SELECT count(*) FROM verse.world_outbox WHERE world = 'splice-bots') FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == "0 0 0", ap_body(t));
  // ---- an admin's edits (the first spawn is numbered SPW_SHIPPED_N + 1, metaverse/splice-bots/world.coax: 9 shipped pieces, so 10)
  st = wc_post(t, w, t[0].admin_key, 0, "apply", WC_SPAWNS);
  ap_check(t, "world: an admin's batch is saved: the revision moves one an edit and the answer numbers the spawns", st == 200 && w[0].st.ok && w[0].st.rev == 2 && w[0].st.dev == 2 && w[0].st.undo == 1 && w[0].st.redo == 0 && ap_has(wc_did(w), "{\"op\":\"spawn\",\"id\":10,\"kind\":113,") && ap_has(wc_did(w), "{\"op\":\"spawn\",\"id\":11,\"kind\":117,"), ap_body(t));
  st = wc_post(t, w, t[0].admin_key, 0, "apply", WC_SPAWNS);
  ap_check(t, "world: a batch made from a stale revision is refused, 409", st == 409 && wc_refusal(t, w, edit[..]) == "the world changed since you read it: read it again", ap_body(t));
  st = wc_post(t, w, t[0].admin_key, 2, "apply", WC_IN_GATE);
  ap_check(t, "world: an edit Splice's own check refuses is refused in words that name the zone, and nothing is saved", st == 422 && wc_refusal(t, w, edit[..]) == "in the kept-clear zone 'Scanner gate'" && edit[0] == 0 && ap_sql(t, "SELECT dev_rev FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == "2", ap_body(t));
  st = wc_get(t, w, "?lane=dev");
  ap_check(t, "world: the saved document reads back at its head", st == 200 && w[0].st.rev == 2 && ap_has(wc_doc(w), "\nhead 2 12\n"), "");
  ap_check(t, "world: a saved edit is one event, in order, read by the codec", wc_events(t, "?lane=dev&after=0", 1, 1) == 2 && wc_events(t, "?lane=dev&after=1", 2, 1) == 1 && wc_events(t, "?lane=dev&after=2", 3, 1) == 0 && wc_events(t, "?lane=x", 1, 1) == -1, ap_body(t));
  // ---- a dry run, and the content tables
  b2: [1] Sb; body2 := wc_batch(b2[..], 2, "apply", "{\"op\":\"despawn\",\"id\":10}");
  url2: [1] Sb; sb(url2[..], t[0].api); sb(url2[..], WC_PATH); sb(url2[..], "?dry=1");
  sig2: [4096] u8; s2 := ap_nostr(t, t[0].admin_key, "POST", sb_text(url2[..]), body2, true, sig2[..]);
  auth2: [1] Sb; sb(auth2[..], "Authorization: Nostr "); sb(auth2[..], s2);
  h2 := [2] string.["Content-Type: application/json", sb_text(auth2[..])];
  p2: [1] Sb; sb(p2[..], WC_PATH); sb(p2[..], "?dry=1");
  st = ap_call(t, "POST", sb_text(p2[..]), body2, h2[..]);
  w[0].st = we_state_read(ap_body(t), w[0].doc[..], w[0].did[..], w[0].scratch[..]);
  ap_check(t, "world: a dry run carries the batch out in a copy, answers it as it would be taken, and saves nothing", st == 200 && w[0].st.ok && w[0].st.rev == 2 && ap_has(wc_did(w), "{\"op\":\"despawn\",\"id\":10}") && ap_sql(t, "SELECT dev_rev || ' ' || steps FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == "2 1", ap_body(t));
  st = ap_call(t, "GET", "/api/worlds/splice-bots/card", "", t[0].no[0..<0]);
  ap_check(t, "world: the card names the world, the dev revision and how many things it holds; a world with no card, and a write to one, are refused", st == 200 && ap_starts(ap_body(t), "world.card.v1 splice-bots ") && ap_has(ap_body(t), "\nname Splice Bots\n") && ap_call(t, "GET", "/api/worlds/nowhere/card", "", t[0].no[0..<0]) == 404 && ap_call(t, "POST", "/api/worlds/splice-bots/card", "{}", t[0].no[0..<0]) == 404, "");
  // Splice Bots' old ID names it: a saved link, the CLI or an MCP tool that says splice reads the same world (#13486)
  st = ap_call(t, "GET", "/api/worlds/splice/card", "", t[0].no[0..<0]);
  ap_check(t, "world: the world's old ID reads the world under its new one", st == 200 && ap_starts(ap_body(t), "world.card.v1 splice-bots ") && ap_call(t, "GET", "/api/worlds/splice?lane=dev", "", t[0].no[0..<0]) == 200 && ap_sql(t, "SELECT count(*) FROM verse.world_docs WHERE id = 'splice'", q[..]) == "0", ap_body(t));
  lu: [1] Sb; sb(lu[..], t[0].api); sb(lu[..], "/api/worlds");
  lsig: [4096] u8; ls := ap_nostr(t, t[0].admin_key, "GET", sb_text(lu[..]), "", false, lsig[..]);
  la: [1] Sb; sb(la[..], "Authorization: Nostr "); sb(la[..], ls);
  lh := [1] string.[sb_text(la[..])];
  st = ap_call(t, "GET", "/api/worlds", "", lh[..]);
  admin_list := ap_starts(ap_body(t), "world splice-bots Splice Bots\n");
  ap_check(t, "world: an admin's worlds start with Splice Bots; someone logged out has none", st == 200 && admin_list && ap_call(t, "GET", "/api/worlds", "", t[0].no[0..<0]) == 200 && ap_body(t) == "" && ap_call(t, "POST", "/api/worlds", "{}", t[0].no[0..<0]) == 404, ap_body(t));
  pq: [1] Sb; sb(pq[..], "INSERT INTO projects.docs VALUES ('side-list', 1, '{\"title\": \"Side List\", \"members\": [{\"name\": \"Admin\", \"pubkey\": \""); sb(pq[..], ap_env(t, "OA_ADMIN_PUBKEYS")); sb(pq[..], "\"}]}'::jsonb, 1, 'test') ON CONFLICT (slug) DO NOTHING");
  ap_do(t, sb_text(pq[..]));
  pu: [1] Sb; sb(pu[..], t[0].api); sb(pu[..], "/api/projects");
  psig: [4096] u8; ps := ap_nostr(t, t[0].admin_key, "GET", sb_text(pu[..]), "", false, psig[..]);
  pa: [1] Sb; sb(pa[..], "Authorization: Nostr "); sb(pa[..], ps);
  ph := [1] string.[sb_text(pa[..])];
  st = ap_call(t, "GET", "/api/projects", "", ph[..]);
  member_list := ap_has(ap_body(t), "project side-list Side List\n");
  ap_check(t, "projects: a member's projects name the ones they are in; someone logged out has none", st == 200 && member_list && ap_call(t, "GET", "/api/projects", "", t[0].no[0..<0]) == 200 && ap_body(t) == "" && ap_call(t, "POST", "/api/projects", "{}", t[0].no[0..<0]) == 404, ap_body(t));
  st = ap_call(t, "GET", "/api/worlds/splice-bots/content", "", t[0].no[0..<0]);
  ap_check(t, "world: the content tables are read to aim an edit: pieces, landmarks and kept-clear zones", st == 200 && ap_starts(ap_body(t), "aethyr.content.v1 splice ") && ap_has(ap_body(t), "\ntable pieces ") && ap_has(ap_body(t), "\ntable landmarks ") && ap_has(ap_body(t), "\ntable kept_clear ") && ap_call(t, "GET", "/api/worlds/nope/content", "", t[0].no[0..<0]) == 404, "");
  // ---- the undo log
  st = wc_post(t, w, t[0].admin_key, 2, "undo", "");
  ap_check(t, "world: an undo takes the batch back as edits of its own", st == 200 && w[0].st.rev == 4 && w[0].st.undo == 0 && w[0].st.redo == 1 && ap_has(wc_did(w), "{\"op\":\"despawn\",\"id\":11},{\"op\":\"despawn\",\"id\":10}"), ap_body(t));
  st = wc_post(t, w, t[0].admin_key, 4, "undo", "");
  ap_check(t, "world: with nothing to undo, an undo says so", st == 422 && wc_refusal(t, w, edit[..]) == "nothing to undo", ap_body(t));
  st = wc_post(t, w, t[0].admin_key, 4, "redo", "");
  ap_check(t, "world: a redo brings each piece back under its number", st == 200 && w[0].st.rev == 6 && w[0].st.undo == 1 && w[0].st.redo == 0 && ap_has(wc_did(w), "{\"op\":\"spawn\",\"id\":10,") && ap_has(wc_did(w), "{\"op\":\"spawn\",\"id\":11,"), ap_body(t));
  st = wc_post(t, w, t[0].admin_key, 6, "redo", "");
  ap_check(t, "world: with nothing to redo, a redo says so", st == 422 && wc_refusal(t, w, edit[..]) == "nothing to redo", ap_body(t));
  st = wc_post(t, w, t[0].admin_key, 6, "apply", "{\"op\":\"move\",\"id\":11,\"x\":300,\"y\":0,\"z\":120},{\"op\":\"rotate\",\"id\":11,\"yaw\":45}");
  ap_check(t, "world: a move and a turn are edits", st == 200 && w[0].st.rev == 8 && w[0].st.undo == 2, ap_body(t));
  st = wc_post(t, w, t[0].admin_key, 8, "undo", "");
  moved := st == 200 && w[0].st.rev == 10 && w[0].st.redo == 1;
  st = wc_post(t, w, t[0].admin_key, 10, "apply", "{\"op\":\"despawn\",\"id\":10}");
  ap_check(t, "world: a new edit after an undo cuts the steps ahead of it", moved && st == 200 && w[0].st.rev == 11 && w[0].st.undo == 2 && w[0].st.redo == 0 && ap_sql(t, "SELECT count(*) || ' ' || max(n) FROM verse.world_steps WHERE world = 'splice-bots'", q[..]) == "2 1", ap_body(t));
  ap_check(t, "world: the outbox holds one event a revision", ap_sql(t, "SELECT count(*) || ' ' || max(rev) || ' ' || count(DISTINCT seq) FROM verse.world_outbox WHERE world = 'splice-bots' AND lane = 'dev'", q[..]) == "11 11 11" && wc_events(t, "?lane=dev&after=0", 1, 1) == 11, "");
  ap_check(t, "world: a batch's events share one at, and each of its six batches has its own (a reader's steps, #13485)", ap_sql(t, "SELECT count(DISTINCT at_ms) || ' ' || (SELECT count(DISTINCT at_ms) FROM verse.world_outbox WHERE world = 'splice-bots' AND lane = 'dev' AND rev IN (7, 8)) FROM verse.world_outbox WHERE world = 'splice-bots' AND lane = 'dev'", q[..]) == "6 1", "");
  // ---- dev and live
  st = wc_post(t, w, t[0].admin_key, 10, "publish-now", "");
  ap_check(t, "world: a publish names the dev revision it read", st == 409, ap_body(t));
  st = wc_post(t, w, t[0].admin_key, 11, "publish-now", "");
  ap_check(t, "world: a publish makes dev live", st == 200 && w[0].st.ok && w[0].st.lane == WL_LIVE && w[0].st.rev == 1 && w[0].st.live == 1 && w[0].st.dev == 11 && w[0].st.when == WU_NOW, ap_body(t));
  st = wc_post(t, w, t[0].admin_key, 11, "publish-next", "");
  ap_check(t, "world: a publish of what is live already says so", st == 422 && wc_refusal(t, w, edit[..]) == "live is already this revision", ap_body(t));
  st = wc_get(t, w, "");
  live_ok := st == 200 && w[0].st.lane == WL_LIVE && w[0].st.rev == 1 && ap_has(wc_doc(w), "\nhead 11 ");
  p: [1] Sb; sb(p[..], "?lane=live&engine=1&rules=1&wire=1&content="); sb_int(p[..], w[0].content);
  st = wc_get(t, w, sb_text(p[..]));
  mine_ok := st == 200 && w[0].st.rev == 1;
  sb_clear(p[..]); sb(p[..], "?lane=live&engine=1&rules=1&wire=9&content="); sb_int(p[..], w[0].content);
  st = wc_get(t, w, sb_text(p[..]));
  ap_check(t, "world: live is read by anyone, and by a page whose build reads it; a page on other pins is told to reload", live_ok && mine_ok && st == 409 && wc_refusal(t, w, edit[..]) == "this page is older than the world: reload it", ap_body(t));
  ap_check(t, "world: a publish is one event of the live lane, with the build's pins", wc_events(t, "?lane=live&after=0", 1, 2) == 1 && ap_has(ap_body(t), "\"from\":11,\"when\":\"now\",\"engine\":1,\"rules\":1,"), ap_body(t));
  // live as a newer build would have published it (its wire raised): this build's update can't start now
  st = wc_post(t, w, t[0].admin_key, 11, "apply", "{\"op\":\"rotate\",\"id\":11,\"yaw\":90}");
  ap_do(t, "UPDATE verse.world_docs SET live_wire = 2 WHERE id = 'splice-bots'");
  st = wc_post(t, w, t[0].admin_key, 12, "publish-now", "");
  not_now := st == 422 && ap_has(wc_refusal(t, w, edit[..]), "it starts with the next session");
  st = wc_post(t, w, t[0].admin_key, 12, "publish-next", "");
  ap_check(t, "world: an update that changes a pin is refused for now and taken for the next session; the revision before it is kept", not_now && st == 200 && w[0].st.rev == 2 && w[0].st.when == WU_NEXT && ap_sql(t, "SELECT prev_rev || ' ' || prev_wire || ' ' || live_wire || ' ' || live_when || ' ' || live_from FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == "1 2 1 1 12", ap_body(t));
  sb_clear(p[..]); sb(p[..], "?lane=live&engine=1&rules=1&wire=2&content="); sb_int(p[..], w[0].content);
  st = wc_get(t, w, sb_text(p[..]));
  ap_check(t, "world: a session still on the pins before joins the revision kept for it", st == 200 && w[0].st.rev == 1 && ap_has(wc_doc(w), "\nhead 11 "), ap_body(t));
  // a repair on the same pins leaves the kept revision as it is
  st = wc_post(t, w, t[0].admin_key, 12, "original", "");
  // a new world holds the shipped pieces too, so ORIGINAL despawns them all: one revision an edit
  r0 := w[0].st.rev;
  bare := st == 200 && r0 > 12 && ap_has(wc_did(w), "{\"op\":\"despawn\",\"id\":");
  st = wc_post(t, w, t[0].admin_key, r0, "publish-now", "");
  ap_check(t, "world: ORIGINAL removes every placed piece, and a publish on the same pins is taken now and leaves the kept revision", bare && st == 200 && w[0].st.rev == 3 && w[0].st.when == WU_NOW && ap_sql(t, "SELECT prev_rev || ' ' || prev_wire FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == "1 2", ap_body(t));
  st = wc_post(t, w, t[0].admin_key, r0, "original", "");
  ap_check(t, "world: ORIGINAL with nothing placed changes nothing", st == 422 && wc_refusal(t, w, edit[..]) == "nothing to change", ap_body(t));
  // ---- the content tables, edited (#13419): a cell is an edit of the same log, and the tables are saved with the document
  st = wc_post(t, w, t[0].admin_key, r0, "apply", "{\"op\":\"cell\",\"table\":\"pieces\",\"row\":117,\"col\":\"name\",\"v\":\"Tiny crate\"}");
  celled := st == 200 && w[0].st.rev == r0 + 1 && w[0].st.undo >= 1 && ap_has(wc_did(w), "\"op\":\"cell\"");
  ev: [1] Sb; sb(ev[..], "?lane=dev&after="); sb_int(ev[..], r0);
  rv: [1] Sb; sb_int(rv[..], r0 + 1);
  st = ap_call(t, "GET", "/api/worlds/splice-bots/content?lane=dev", "", t[0].no[0..<0]);
  dev_new := st == 200 && ap_has(ap_body(t), "\n117|Tiny crate|") && ap_starts(ap_body(t), "aethyr.content.v1 splice ");
  st = ap_call(t, "GET", "/api/worlds/splice-bots/content", "", t[0].no[0..<0]);
  ap_check(t, "world: a cell of the content tables is an edit: dev's tables hold it, live's do not until a publish, and it is one event", celled && dev_new && st == 200 && ap_has(ap_body(t), "\n117|Small crate|") && wc_events(t, sb_text(ev[..]), r0 + 1, 1) == 1 && ap_has(ap_body(t), "\"op\":\"cell\"") && ap_sql(t, "SELECT (dev_tables <> '')::int || ' ' || (live_tables = '')::int FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == "1 1", ap_body(t));
  st = wc_post(t, w, t[0].admin_key, r0 + 1, "apply", "{\"op\":\"cell\",\"table\":\"pieces\",\"row\":117,\"col\":\"colour\",\"v\":\"red\"}");
  no_col := st == 422 && wc_refusal(t, w, edit[..]) == "no such table, row or column, or a value that column does not take";
  st = wc_post(t, w, t[0].admin_key, r0 + 1, "apply", "{\"op\":\"cell\",\"table\":\"pieces\",\"row\":117,\"col\":\"scale\",\"v\":\"5\"}");
  ap_check(t, "world: a cell its column or the tables' rules refuse is refused in words and changes nothing", no_col && st == 422 && wc_refusal(t, w, edit[..]) == "the tables' rules do not hold with that value" && ap_sql(t, "SELECT dev_rev FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == sb_text(rv[..]), ap_body(t));
  st = wc_post(t, w, t[0].admin_key, r0 + 1, "undo", "");
  undone := st == 200 && w[0].st.rev == r0 + 2;
  st = ap_call(t, "GET", "/api/worlds/splice-bots/content?lane=dev", "", t[0].no[0..<0]);
  back := st == 200 && ap_has(ap_body(t), "\n117|Small crate|");
  st = wc_post(t, w, t[0].admin_key, r0 + 2, "redo", "");
  again := st == 200 && w[0].st.rev == r0 + 3;
  st = wc_post(t, w, t[0].admin_key, r0 + 3, "publish-now", "");
  shown := st == 200;
  st = ap_call(t, "GET", "/api/worlds/splice-bots/content", "", t[0].no[0..<0]);
  ap_check(t, "world: an undo takes a cell back, a redo brings it again, and a publish makes the tables live", undone && back && again && shown && st == 200 && ap_has(ap_body(t), "\n117|Tiny crate|"), ap_body(t));
  wc_reset(t);
}

// ---- a world's imported assets (#13420)

// The fake bucket, as drops.c asks it: an upload opened (its object's name, type, size and origin
// logged to DIR/opened, a line each), the file PUT to the session it answered, an object's size,
// its bytes, and its deletion. An object is the file DIR/o.NAME, NAME as the request spells it
// (percent-encoded). Every call but the browser's PUT carries the service's token. It stops when
// DIR/stop exists.
WB_REQ :: 1200000;
WbWork :: struct { req: [WB_REQ] u8; obj: [WB_REQ] u8; }
wb_header :: (head: string, name: string) -> string {
  at := 0;
  for i: 0..<head.count {
    if head[i] != '\n' { continue; }
    line := head[at..<i]; at = i + 1;
    if line.count > 0 && line[line.count - 1] == '\r' { line = line[0..<line.count - 1]; }
    if line.count > name.count && line[name.count] == ':' && http_same(line[0..<name.count], name) { return http_trim(line[name.count + 1..<line.count]); }
  }
  return "";
}
// The value of name= in a query, or "".
wb_query :: (query: string, name: string) -> string {
  at := 0;
  for i: 0..<query.count + 1 {
    if i < query.count && query[i] != '&' { continue; }
    part := query[at..<i]; at = i + 1;
    if part.count > name.count && part[name.count] == '=' && part[0..<name.count] == name { return part[name.count + 1..<part.count]; }
  }
  return "";
}
wb_file :: (dir: string, name: string, out: [] u8) -> string {
  n: [1] Sb; sb(n[..], "o."); sb(n[..], name);
  ok := name.count > 0 && name.count < 200;
  for c: name { if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '%' || c == '-' || c == '_' || c == '.') { ok = false; } }
  return ifx ok then fs_join(dir, sb_text(n[..]), out) else "";
}
wb_main :: (port: int, dir: string) -> int {
  k := [1] WbWork.[WbWork.{}]; req := k[0].req[..];
  listener := cxsock_listen(port);
  if listener < 0 { tool_errln("world_checks bucket: can't listen"); return 1; }
  pb: [1100] u8; ready := fs_write(fs_join(dir, "ready", pb[..]), "1");
  ob: [1100] u8; opened := fs_join(dir, "opened", ob[..]);
  sp: [1100] u8; stop := fs_join(dir, "stop", sp[..]);
  while !fs_exists(stop) {
    h := cxsock_accept(listener, 50);
    if h < 0 { continue; }
    used := 0; end := -1; want := 0; deadline := proc_now_ms() + 20000;
    while (end < 0 || used < end + want) && proc_now_ms() < deadline {
      n := cxsock_read(h, 100);
      if n == -2 { continue; }
      if n < 0 || used + n > req.count { break; }
      for i: 0..<n { req[used + i] = cast,trunc(u8) cxsock_byte(h, i); }
      scan := ifx used >= 3 then used - 3 else 0;
      used += n;
      if end < 0 && used >= 4 {
        for i: scan..<used - 3 { if end < 0 && req[i] == '\r' && req[i + 1] == '\n' && req[i + 2] == '\r' && req[i + 3] == '\n' { end = i + 4; } }
        if end >= 0 { v := ap_whole(wb_header(cast(string) req[0..<end], "Content-Length")); want = ifx v < 0 then 0 else v; }
      }
    }
    if end < 0 || used < end + want { c := cxsock_close(h); continue; }
    head := cast(string) req[0..<end]; body := cast(string) req[end..<end + want];
    sp1 := 0; while sp1 < head.count && head[sp1] != ' ' { sp1 += 1; }
    sp2 := sp1 + 1; while sp2 < head.count && head[sp2] != ' ' && head[sp2] != '\r' { sp2 += 1; }
    method := head[0..<sp1]; target := ifx sp1 < head.count then head[sp1 + 1..<sp2] else "";
    q := 0; while q < target.count && target[q] != '?' { q += 1; }
    path := target[0..<q]; query := ifx q < target.count then target[q + 1..<target.count] else "";
    ours := wb_header(head, "Authorization") == "Bearer test-gcs";
    status := 404; extra: [1] Sb; out := ""; fb: [1400] u8;
    up := "/upload/storage/v1/b/drops-test/o"; ob_ := "/storage/v1/b/drops-test/o/"; se := "/session/";
    if method == "POST" && path == up && ours && wb_query(query, "uploadType") == "resumable" && wb_file(dir, wb_query(query, "name"), fb[..]).count > 0 {
      line: [1] Sb; sb(line[..], wb_query(query, "name")); sb(line[..], " "); sb(line[..], wb_header(head, "X-Upload-Content-Type")); sb(line[..], " "); sb(line[..], wb_header(head, "X-Upload-Content-Length"));
      sb(line[..], " "); sb(line[..], wb_header(head, "Origin")); sb(line[..], " "); sb(line[..], wb_query(query, "ifGenerationMatch")); sb(line[..], "\n");
      logged := fs_append(opened, sb_text(line[..]));
      sb(extra[..], "Location: http://127.0.0.1:"); sb_int(extra[..], port); sb(extra[..], se); sb(extra[..], wb_query(query, "name")); sb(extra[..], "\r\n");
      status = 200;
    } else if method == "PUT" && path.count > se.count && path[0..<se.count] == se {
      file := wb_file(dir, path[se.count..<path.count], fb[..]);
      if file.count > 0 && fs_write(file, body) { status = 200; out = "{}"; }
    } else if ours && path.count > ob_.count && path[0..<ob_.count] == ob_ {
      file := wb_file(dir, path[ob_.count..<path.count], fb[..]);
      size := ifx file.count > 0 && fs_exists(file) then fs_size(file) else -1;
      if method == "DELETE" { gone := size >= 0 && fs_remove(file); status = 204; }
      else if method == "GET" && size >= 0 && wb_query(query, "alt") == "media" {
        got := fs_read(file, k[0].obj[..]);
        ranged := wb_header(head, "Range").count > 0;
        if got >= 0 { status = ifx ranged then 206 else 200; out = cast(string) k[0].obj[0..<ifx ranged && got > 4096 then 4096 else got]; }
      } else if method == "GET" && size >= 0 {
        j: [1] Sb; sb(j[..], "{\"size\": \""); sb_int(j[..], size); sb(j[..], "\", \"md5Hash\": \"bWQ1\"}");
        got := 0; for c: sb_text(j[..]) { k[0].obj[got] = c; got += 1; }
        status = 200; out = cast(string) k[0].obj[0..<got];
      }
    }
    s: [1] Sb; sb(s[..], "HTTP/1.1 "); sb_int(s[..], status); sb(s[..], " X\r\nConnection: close\r\n"); sb(s[..], sb_text(extra[..])); sb(s[..], "Content-Length: "); sb_int(s[..], out.count); sb(s[..], "\r\n\r\n");
    good := true;
    for c: sb_text(s[..]) { if good && cxsock_write(h, cast(int) c) != 0 { good = false; } }
    for c: out { if good && cxsock_write(h, cast(int) c) != 0 { good = false; } }
    if good { f := cxsock_flush(h, 10000); }
    c := cxsock_close(h);
  }
  c := cxsock_close(listener);
  return 0;
}

WA_PATH :: "/api/worlds/splice-bots/assets";
Wa :: struct {
  glb: [4000] u8; other: [4000] u8; wav: [200] u8; big: [400044] u8; ask: [400] u8; pack: [HTTP_BODY_MAX] u8;
  l: [1] WasList; up: WasUploaded; url: [WAS_URL] u8; hash: [64] u8; dir: [1100] u8; dir_n: int;
}
// A request an admin (or someone else) signed, or one nobody did (key ""): its status.
wa_call :: (t: [] Ap, key: string, method: string, path: string, body: string) -> int {
  if key == "" { h := [1] string.["Content-Type: text/plain"]; return ap_call(t, method, path, body, ifx body.count > 0 then h[..] else h[0..<0]); }
  url: [1] Sb; sb(url[..], t[0].api); sb(url[..], path);
  sig: [4096] u8; s := ap_nostr(t, key, method, sb_text(url[..]), body, body.count > 0, sig[..]);
  auth: [1] Sb; sb(auth[..], "Authorization: Nostr "); sb(auth[..], s);
  h := [2] string.[sb_text(auth[..]), "Content-Type: text/plain"];
  return ap_call(t, method, path, body, h[0..<ifx body.count > 0 then 2 else 1]);
}
wa_words :: (t: [] Ap, w: [] Wc) -> string { edit: [1] int; return wc_refusal(t, w, edit[..]); }
// The ask for a file: its two lines, with the file's own hash (kept in a[0].hash).
wa_ask :: (a: [] Wa, licence: int, name: string, data: [] u8) -> string {
  if !asset_hex(asset_id(cast(string) data), a[0].hash[..]) { return ""; }
  return was_upload_ask(a[0].ask[..], licence, data.count, cast(string) a[0].hash[..], name);
}
// An admin names a file: the status, and the answer read into a[0].up (its address kept in a[0].url).
wa_open :: (t: [] Ap, a: [] Wa, key: string, licence: int, name: string, data: [] u8) -> int {
  st := wa_call(t, key, "POST", WA_PATH, wa_ask(a, licence, name, data));
  a[0].up = was_uploaded_read(ap_body(t));
  if a[0].up.ok { n := 0; for c: a[0].up.url { a[0].url[n] = c; n += 1; } a[0].up.url = cast(string) a[0].url[0..<n]; }
  return st;
}
// The browser's part: the bytes sent straight to the address the API answered.
wa_put :: (t: [] Ap, a: [] Wa, data: [] u8) -> bool { return a[0].up.ok && a[0].up.how == WU_PUT && ap_call(t, "PUT", a[0].up.url, cast(string) data, t[0].no[0..<0]) == 200; }
// The upload is said to be done: the status, and the list it answers read into a[0].l.
wa_done :: (t: [] Ap, a: [] Wa, key: string, licence: int, name: string, data: [] u8) -> int {
  p: [1] Sb; sb(p[..], WA_PATH); sb(p[..], "/done");
  st := wa_call(t, key, "POST", sb_text(p[..]), wa_ask(a, licence, name, data));
  listed := st == 200 && was_read(a[0].l[..], ap_body(t));
  if !listed { a[0].l[0] = WasList.{}; }
  return st;
}
// A file named, sent and imported, as the editor does it: the status of the last step that answered.
wa_import :: (t: [] Ap, a: [] Wa, licence: int, name: string, data: [] u8) -> int {
  st := wa_open(t, a, t[0].admin_key, licence, name, data);
  if st != 200 || !a[0].up.ok { return st; }
  if a[0].up.how == WU_PUT && !wa_put(t, a, data) { return -2; }
  return wa_done(t, a, t[0].admin_key, licence, name, data);
}
// Whether the bucket holds the object of the file last asked for.
wa_stored :: (a: [] Wa) -> bool {
  n: [1] Sb; sb(n[..], "o.test%2Fworlds%2Fsplice-bots%2Ffiles%2F"); sb(n[..], cast(string) a[0].hash[..]);
  pb: [1400] u8;
  return fs_exists(fs_join(cast(string) a[0].dir[0..<a[0].dir_n], sb_text(n[..]), pb[..]));
}
wa_opened :: (a: [] Wa, out: [] u8) -> string {
  pb: [1400] u8; n := fs_read(fs_join(cast(string) a[0].dir[0..<a[0].dir_n], "opened", pb[..]), out);
  return cast(string) out[0..<ifx n < 0 then 0 else n];
}
wa_cell :: (b: [] Sb, row: string) -> string { sb_clear(b); sb(b, "{\"op\":\"cell\",\"table\":\"pieces\",\"row\":201,\"col\":\"*\",\"v\":\""); sb(b, row); sb(b, "\"}"); return sb_text(b); }

wa_checks :: (t: [] Ap, w: [] Wc, a: [] Wa, other: string) {
  q: [400] u8; lg: [8192] u8; b: [1] Sb; edit: [1] int; l := a[0].l[..];
  wc_reset(t);
  box := pit_box(3, 1, 0.5, 1, 0.25, a[0].glb[..]);
  // ---- reading: anyone reads the list and the pack; the list for writing is an admin's
  st := wa_call(t, "", "GET", WA_PATH, "");
  ap_check(t, "assets: a world that has imported nothing lists its limits and licences, and its pack is empty", st == 200 && was_read(l, ap_body(t)) && !l[0].packed && l[0].n == 0 && l[0].file == 524288 && l[0].budget == 1048576 && l[0].licences == 3
           && ap_call(t, "GET", "/api/worlds/splice-bots/assets/pack", "", t[0].no[0..<0]) == 200 && t[0].n == 0 && ap_call(t, "GET", "/api/worlds/nope/assets", "", t[0].no[0..<0]) == 404, ap_body(t));
  st = wa_call(t, "", "GET", "/api/worlds/splice-bots/assets?lane=dev&write=1", "");
  none := st == 401 && wa_words(t, w) == "log in";
  st = wa_call(t, other, "GET", "/api/worlds/splice-bots/assets?lane=dev&write=1", "");
  no := st == 403 && wa_words(t, w) == "only its owner or an admin changes this world";
  st = wa_call(t, t[0].admin_key, "GET", "/api/worlds/splice-bots/assets?lane=dev&write=1", "");
  ap_check(t, "assets: the list for someone who would import is answered to an admin only", none && no && st == 200 && was_read(l, ap_body(t)) && l[0].n == 0, ap_body(t));
  // ---- who may open an upload
  st = wa_open(t, a, "", 0, "rock.glb", box);
  none = st == 401 && wa_words(t, w) == "log in";
  st = wa_open(t, a, other, 0, "rock.glb", box);
  no = st == 403 && wa_words(t, w) == "only its owner or an admin changes this world";
  ho := [2] string.["Content-Type: text/plain", "Origin: https://evil.example"];
  st = ap_call(t, "POST", WA_PATH, wa_ask(a, 0, "rock.glb", box), ho[..]);
  cross := st == 403 && wa_words(t, w) == "cross-site";
  p: [1] Sb; sb(p[..], WA_PATH); sb(p[..], "/done");
  st = ap_call(t, "POST", sb_text(p[..]), wa_ask(a, 0, "rock.glb", box), ho[0..<1]);
  ap_check(t, "assets: an upload is opened, and said to be done, by an admin only: nobody unsigned, nobody else, no other site's page; the bucket is not asked", none && no && cross && st == 401 && wa_opened(a, lg[..]) == "" && !wa_stored(a), ap_body(t));
  // ---- a file is checked by its name, size and licence before anything is stored
  st = wa_open(t, a, t[0].admin_key, -1, "rock.glb", box);
  unlicensed := st == 422 && wa_words(t, w) == "rock.glb has no licence. Choose one, then import it.";
  st = wa_call(t, t[0].admin_key, "POST", WA_PATH, was_upload_ask(a[0].ask[..], 0, 524289, WAS_TEST_HASH, "huge.glb"));
  huge := st == 422 && wa_words(t, w) == "huge.glb is 513 KB. A file can be 512 KB at most.";
  st = wa_call(t, t[0].admin_key, "POST", WA_PATH, was_upload_ask(a[0].ask[..], 0, 40, WAS_TEST_HASH, "notes.txt"));
  kind := st == 422 && wa_words(t, w) == "notes.txt is not a file the editor takes. Drop a .glb, .png, .wav, .ogg or .mp3 file.";
  st = wa_call(t, t[0].admin_key, "POST", WA_PATH, "world.asset.import.v1 0 rock.glb\nglTF");
  ap_check(t, "assets: a file with no licence, one over the file limit and one the editor does not take are refused in words before any upload; what is no ask is refused", unlicensed && huge && kind && st == 400 && wa_opened(a, lg[..]) == "", ap_body(t));
  // a row that draws a pack mesh, before the pack has the mesh
  st = wc_post(t, w, t[0].admin_key, 0, "apply", wa_cell(b[..], "201|Rock|pack/rock|1000|1|50|25|200"));
  ap_check(t, "assets: a row of the pieces table that draws a pack mesh is refused while the world's pack has no such mesh", st == 422 && wc_refusal(t, w, edit[..]) == "the world's pack has no mesh of that name: import it first", ap_body(t));
  // ---- the upload: opened for exactly the file's bytes and type, at the object its content names
  st = wa_open(t, a, t[0].admin_key, 0, "rock.glb", box);
  want: [1] Sb; sb(want[..], "test%2Fworlds%2Fsplice-bots%2Ffiles%2F"); sb(want[..], cast(string) a[0].hash[..]); sb(want[..], " model/gltf-binary "); sb_int(want[..], box.count); sb(want[..], " "); sb(want[..], t[0].api); sb(want[..], " 0\n");
  ap_check(t, "assets: an admin's ask opens an upload for exactly the file's bytes and content type, at the object its SHA-256 names, for this site's page", st == 200 && a[0].up.ok && a[0].up.how == WU_PUT && a[0].up.bytes == box.count && a[0].up.hash == cast(string) a[0].hash[..] && wa_opened(a, lg[..]) == sb_text(want[..]), wa_opened(a, lg[..]));
  st = wa_done(t, a, t[0].admin_key, 0, "rock.glb", box);
  ap_check(t, "assets: done before the file is sent is refused, and nothing is imported", st == 422 && wa_words(t, w) == "That file did not arrive. Import it again." && ap_sql(t, "SELECT dev_pack || '|' || (SELECT count(*) FROM verse.world_packs) FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == "|0", ap_body(t));
  // wrong bytes of the right size, then bytes of another size: refused, and the object is deleted
  wrong := pit_box(3, 1, 0.5, 1, 0.125, a[0].other[..]);
  sent := wrong.count == box.count && wa_put(t, a, wrong) && wa_stored(a);
  st = wa_done(t, a, t[0].admin_key, 0, "rock.glb", box);
  renamed := st == 422 && wa_words(t, w) == "That file is not the one that was named, so it is not kept. Import it again." && !wa_stored(a);
  st = wa_open(t, a, t[0].admin_key, 0, "rock.glb", box);
  sent = sent && st == 200 && wa_put(t, a, box[0..<box.count - 4]) && wa_stored(a);
  st = wa_done(t, a, t[0].admin_key, 0, "rock.glb", box);
  ap_check(t, "assets: bytes that are not the ones the name was made from, and a file that did not arrive whole, are refused and deleted from the bucket", sent && renamed && st == 422 && wa_words(t, w) == "That file did not arrive whole, so it is not kept. Import it again." && !wa_stored(a)
           && ap_sql(t, "SELECT dev_pack || '|' || (SELECT count(*) FROM verse.world_files) FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == "|0", ap_body(t));
  // ---- the right bytes: imported, and the pack's hash changes
  st = wa_import(t, a, 0, "rock.glb", box);
  hb: [64] u8; first: [64] u8;
  for k: 0..<64 { first[k] = l[0].hash[k]; }
  sqlq: [1] Sb; sb(sqlq[..], "SELECT dev_pack || '|' || live_pack || '|' || (SELECT count(*) FROM verse.world_packs WHERE world = 'splice-bots') || '|' || (SELECT name || ' ' || kind || ' ' || licence || ' ' || bytes || ' ' || hash FROM verse.world_files WHERE world = 'splice-bots') FROM verse.world_docs WHERE id = 'splice-bots'");
  row: [1] Sb; sb(row[..], cast(string) first[..]); sb(row[..], "||1|rock.glb 1 0 "); sb_int(row[..], box.count); sb(row[..], " "); sb(row[..], cast(string) a[0].hash[..]);
  ap_check(t, "assets: the right bytes are imported: the list names the mesh and the pack's hash, the pack is kept by that hash for dev, and the file has its row", st == 200 && l[0].packed && l[0].n == 1 && l[0].did && !l[0].did_replaced && l[0].a[0].kind == PIP_MESH && was_asset_name(l, 0) == "rock" && l[0].a[0].hx == 500 && l[0].a[0].top == 2000
           && ap_sql(t, sb_text(sqlq[..]), q[..]) == sb_text(row[..]) && wa_stored(a), ap_body(t));
  st = ap_call(t, "GET", "/api/worlds/splice-bots/assets/pack?lane=dev", "", t[0].no[0..<0]);
  pn := 0; for c: ap_body(t) { a[0].pack[pn] = c; pn += 1; }
  dev_pack := st == 200 && pn == l[0].bytes && asset_hex(asset_id(cast(string) a[0].pack[0..<pn]), hb[..]) && cast(string) hb[..] == cast(string) first[..];
  p2: [1] Sb; sb(p2[..], "/api/worlds/splice-bots/assets/pack?live="); sb(p2[..], cast(string) first[..]);
  st = ap_call(t, "GET", sb_text(p2[..]), "", t[0].no[0..<0]);
  by_hash := st == 200 && t[0].n == pn && asset_hex(asset_id(ap_body(t)), hb[..]) && cast(string) hb[..] == cast(string) first[..];
  sb_clear(p2[..]); sb(p2[..], "/api/worlds/splice-bots/assets/pack?live="); sb(p2[..], WAS_TEST_HASH);
  no_hash := ap_call(t, "GET", sb_text(p2[..]), "", t[0].no[0..<0]) == 404;
  st = wa_call(t, "", "GET", "/api/worlds/splice-bots/assets?lane=dev", "");
  dev_list := st == 200 && was_read(l, ap_body(t)) && l[0].n == 1 && !l[0].did && cast(string) l[0].hash[..] == cast(string) first[..];
  st = wa_call(t, "", "GET", WA_PATH, "");
  ap_check(t, "assets: dev's pack is its bytes by lane and by hash; live has none until a publish", dev_pack && by_hash && no_hash && dev_list && st == 200 && was_read(l, ap_body(t)) && !l[0].packed
           && ap_call(t, "GET", "/api/worlds/splice-bots/assets/pack", "", t[0].no[0..<0]) == 200 && t[0].n == 0, ap_body(t));
  // the same file again: the bucket has it, nothing is sent, and the import replaces the mesh
  before := wa_opened(a, lg[..]).count;
  st = wa_open(t, a, t[0].admin_key, 1, "rock.glb", box);
  kept := st == 200 && a[0].up.ok && a[0].up.how == WU_KEPT && wa_opened(a, lg[..]).count == before;
  st = wa_done(t, a, t[0].admin_key, 1, "rock.glb", box);
  ap_check(t, "assets: a file the bucket already has is not sent again, and importing it again replaces the asset", kept && st == 200 && l[0].did && l[0].did_replaced && l[0].n == 1 && l[0].a[0].licence == 1
           && ap_sql(t, "SELECT count(*) || ' ' || max(licence) FROM verse.world_files WHERE world = 'splice-bots'", q[..]) == "1 1" && ap_sql(t, "SELECT count(*) FROM verse.world_packs WHERE world = 'splice-bots'", q[..]) == "1", ap_body(t));
  // ---- a row that draws a pack mesh is held to the pack the world has
  st = wc_post(t, w, t[0].admin_key, 0, "apply", wa_cell(b[..], "201|Rock|pack/stone|1000|1|50|25|200"));
  stone := st == 422 && wc_refusal(t, w, edit[..]) == "the world's pack has no mesh of that name: import it first";
  st = wc_post(t, w, t[0].admin_key, 0, "apply", wa_cell(b[..], "201|Rock|pack/rock|1000|1|60|25|200"));
  foot := st == 422 && wc_refusal(t, w, edit[..]) == "a pack mesh's footprint is its bounds: hx, hz and top are not this mesh's at that size";
  st = wc_post(t, w, t[0].admin_key, 0, "apply", wa_cell(b[..], "201|Rock|pack/rock|1000|1|50|25|200"));
  rowed := st == 200 && w[0].st.rev == 1;
  st = wc_post(t, w, t[0].admin_key, 1, "apply", "{\"op\":\"spawn\",\"id\":0,\"kind\":201,\"x\":17720,\"y\":0,\"z\":-7060,\"yaw\":0,\"scale\":100}");
  ap_check(t, "assets: a pieces row for a pack mesh is saved only when the pack has the mesh and the footprint is its bounds, and the kind is then placed like any piece", stone && foot && rowed && st == 200 && w[0].st.rev == 2, ap_body(t));
  // the same file again while a rock stands by the gate: its bounds are the row's, so it replaces the mesh
  st = wa_import(t, a, 0, "rock.glb", box);
  ap_check(t, "assets: a mesh of the same bounds replaces one the world has pieces of", st == 200 && l[0].did && l[0].did_replaced && l[0].a[0].licence == 0, ap_body(t));
  // a mesh as wide as the yard may not replace the rock while one stands by the gate
  wide := pit_box(3, 1, 25, 1, 25, a[0].other[..]);
  wasb: [80] u8; was := ap_sql(t, "SELECT dev_pack FROM verse.world_docs WHERE id = 'splice-bots'", wasb[..]);
  st = wa_import(t, a, 0, "rock.glb", wide);
  ap_check(t, "assets: a mesh that does not fit where its kind stands is refused in words, the pack stays, and its file leaves the bucket", st == 422 && ap_has(wa_words(t, w), "rock.glb does not fit where its kind already stands: ") && !wa_stored(a)
           && was.count == 64 && ap_sql(t, "SELECT dev_pack FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == was, ap_body(t));
  // ---- the budget: two long sounds fit, the third would not
  long := a[0].big[..];
  for c, k: "RIFFsizeWAVE" { long[k] = c; }
  ok2 := true;
  for k: 0..<2 { long[20] = cast,trunc(u8) ('1' + k); nm: [1] Sb; sb(nm[..], "long-"); sb_int(nm[..], k + 1); sb(nm[..], ".wav"); ok2 = ok2 && wa_import(t, a, 2, sb_text(nm[..]), long) == 200 && l[0].n == 2 + k; }
  held := ap_sql(t, "SELECT dev_pack FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == cast(string) l[0].hash[..] && l[0].packed;
  long[20] = '3';
  st = wa_import(t, a, 2, "long-3.wav", long);
  kb: [1] Sb; sb(kb[..], "SELECT dev_pack || ' ' || (SELECT count(*) FROM verse.world_packs WHERE world = 'splice-bots') || ' ' || (SELECT count(*) FROM verse.world_files WHERE world = 'splice-bots') FROM verse.world_docs WHERE id = 'splice-bots'");
  ap_check(t, "assets: a file that would take the pack over its budget is refused in words; the pack and its rows stay, and the file leaves the bucket", ok2 && held && st == 422 && ap_starts(wa_words(t, w), "long-3.wav would make the pack ") && ap_ends(wa_words(t, w), " KB. Its budget is 1024 KB.") && !wa_stored(a)
           && ap_ends(ap_sql(t, sb_text(kb[..]), q[..]), " 1 3"), ap_body(t));
  // ---- a publish carries dev's pack to live with the document
  devp: [80] u8; dev := ap_sql(t, "SELECT dev_pack FROM verse.world_docs WHERE id = 'splice-bots'", devp[..]);
  st = wc_post(t, w, t[0].admin_key, 2, "publish-now", "");
  pub := st == 200 && ap_sql(t, "SELECT live_pack FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == dev && dev.count == 64;
  st = ap_call(t, "GET", "/api/worlds/splice-bots/assets/pack", "", t[0].no[0..<0]);
  live_pack := st == 200 && asset_hex(asset_id(ap_body(t)), hb[..]) && cast(string) hb[..] == dev;
  st = wa_call(t, "", "GET", WA_PATH, "");
  ap_check(t, "assets: a publish carries the dev pack to live with the document: live's list and pack are dev's", pub && live_pack && st == 200 && was_read(l, ap_body(t)) && l[0].n == 3 && cast(string) l[0].hash[..] == dev, ap_body(t));
  // an import after the publish changes dev's pack only; live's stays and both are kept
  wav := pit_wav(a[0].wav[..]);
  st = wa_import(t, a, 0, "door.wav", wav);
  after := st == 200 && l[0].n == 4 && cast(string) l[0].hash[..] != dev;
  ap_check(t, "assets: an import after a publish changes dev's pack and leaves live's; each lane's pack is kept, and no other", after && ap_sql(t, "SELECT live_pack || ' ' || (SELECT count(*) FROM verse.world_packs WHERE world = 'splice-bots') || ' ' || (dev_pack <> live_pack) FROM verse.world_docs WHERE id = 'splice-bots'", q[..]) == sb_text_of(dev, " 2 true", b[..]), ap_body(t));
  wc_reset(t);
  ap_check(t, "assets: a world's packs and files go with its row", ap_sql(t, "SELECT (SELECT count(*) FROM verse.world_packs) + (SELECT count(*) FROM verse.world_files)", q[..]) == "0", "");
}
sb_text_of :: (a: string, b: string, s: [] Sb) -> string { sb_clear(s); sb(s, a); sb(s, b); return sb_text(s); }

tool_main :: () -> int #export_c #effects(all) {
  ar: [1] Args;
  if !args_load(ar[..]) { return 2; }
  if args_count(ar[..]) >= 1 && args_at(ar[..], 0) == "bucket" {
    if args_count(ar[..]) != 3 { tool_errln("world_checks bucket PORT DIR"); return 2; }
    return wb_main(ap_whole(args_at(ar[..], 1)), args_at(ar[..], 2));
  }
  t: [1] Ap; w := [1] Wc.[Wc.{}];
  if !ap_open(t[..]) { return 2; }
  kb: [2048] u8; other := proc_getenv("OTHER_KEY", kb[..]);
  if t[0].sign == "" || t[0].admin_key == "" || other == "" { tool_errln("world checks: SIGN, ADMIN_KEY and OTHER_KEY come from coax/web/api/test.sh"); return 2; }
  wc_checks(t[..], w[..], other);
  wc_realm_checks(t[..], w[..]);
  // the assets' checks, with the fake bucket beside them
  gp: [32] u8; port := proc_getenv("GCS_PORT", gp[..]);
  a := [1] Wa.[Wa.{}];
  work := fs_temp("world-bucket", a[0].dir[..]); a[0].dir_n = work.count;
  ba := [5] string.["coax/web/tool.sh", "coax/web/api/tests/world_checks.coax", "bucket", port, work];
  h := proc_new(); ok := h >= 0 && port != "";
  for x: ba { ok = ok && proc_arg(h, x); }
  started := ok && proc_start(h) == 0;
  rb: [1400] u8; ready := fs_join(work, "ready", rb[..]);
  deadline := proc_now_ms() + 300000;
  while started && !fs_exists(ready) && proc_now_ms() < deadline && proc_wait(h, 0) == PROC_RUNNING { proc_sleep(50); }
  if !started || !fs_exists(ready) { ap_check(t[..], "assets: the fake bucket listens (GCS_PORT comes from test.sh)", false, port); return ap_done(t[..], "world checks"); }
  wa_checks(t[..], w[..], a[..], other);
  sb_: [1400] u8; stopped := fs_write(fs_join(work, "stop", sb_[..]), "1");
  wt := proc_wait(h, 5000); rl := proc_release(h);
  gone := fs_remove(work);
  return ap_done(t[..], "world checks");
}

// ---- a realm's world (#13422): a hand-built realm with a board, The Grid (migrations 0050, 0082, 0185), at
// /api/worlds/the-grid. Its rows and tools are content tables; a switch is a cell edit the realm's own SQL carries out.
WC_REALM :: "/api/worlds/the-grid";
wc_realm_checks :: (t: [] Ap, w: [] Wc) {
  edit: [1] int; q: [400] u8; b: [1] Sb;
  st := ap_call(t, "GET", "/api/worlds/the-grid?lane=dev", "", t[0].no[0..<0]);
  w[0].st = we_state_read(ap_body(t), w[0].doc[..], w[0].did[..], w[0].scratch[..]);
  ap_check(t, "realm world: a hand-built realm is a world with its ID, revision 0, nothing placed", st == 200 && w[0].st.ok && w[0].st.rev == 0 && w[0].st.doc_n == 0 && ap_sql(t, "SELECT kind FROM verse.world_docs WHERE id = 'the-grid'", q[..]) == "realm", ap_body(t));
  st = ap_call(t, "GET", WC_REALM, "", t[0].no[0..<0]);
  ap_check(t, "realm world: its switches reach everyone at once, so its live is its dev", st == 200 && we_state_read(ap_body(t), w[0].doc[..], w[0].did[..], w[0].scratch[..]).lane == WL_DEV, ap_body(t));
  st = ap_call(t, "GET", "/api/worlds/the-grid/content", "", t[0].no[0..<0]);
  body := ap_body(t);
  ap_check(t, "realm world: the board and the settings are content tables", st == 200 && ap_starts(body, "aethyr.content.v1 realm 1\nreach 40000\ntable kinds id name:text\ntable rows id key:text on:int label:text\n1|") && ap_has(body, "\ntable things id kind:ref.kinds x:cm z:cm turn:int size:int\ntable tools id name:text on:int\n"), body);
  row := ct_part(body, '\n', 4);
  key: [64] u8; kn := ct_copy(key[..], ct_part(row, '|', 1));
  was := ct_part(row, '|', 2) == "1";
  turn := ifx was then "0" else "1";
  cell: [1] Sb; sb(cell[..], "{\"op\":\"cell\",\"table\":\"rows\",\"row\":1,\"col\":\"on\",\"v\":\""); sb(cell[..], turn); sb(cell[..], "\"}");
  // who may switch
  st = ap_json(t, "POST", WC_REALM, wc_batch(b[..], 0, "apply", sb_text(cell[..])));
  ap_check(t, "realm world: a switch from nobody is asked to log in", st == 401 && wc_refusal(t, w, edit[..]) == "log in", ap_body(t));
  hv := [2] string.["Content-Type: application/json", "X-Verse-Player: wc-a-visitor-of-the-grid"];
  st = ap_call(t, "POST", WC_REALM, wc_batch(b[..], 0, "apply", sb_text(cell[..])), hv[..]);
  ap_check(t, "realm world: a visitor of the realm may not switch it", st == 403 && wc_refusal(t, w, edit[..]) == "only its owner or an admin changes this world", ap_body(t));
  // a site admin's switch: the realm's own SQL carries it out, one revision and one event
  st = wc_post_to(t, w, t[0].admin_key, WC_REALM, 0, "apply", sb_text(cell[..]));
  ks: [1] Sb; sb(ks[..], "SELECT coalesce((SELECT switched->>'"); sb(ks[..], cast(string) key[0..<kn]); sb(ks[..], "' FROM verse.realm_edit WHERE slug = 'the-grid'), 'none')");
  now := ap_sql(t, sb_text(ks[..]), q[..]);
  ap_check(t, "realm world: an admin's switch is the realm's: its board changes, the revision moves one, one event", st == 200 && w[0].st.rev == 1 && w[0].st.undo == 1 && now == (ifx was then "false" else "true") && ap_sql(t, "SELECT count(*) FROM verse.world_outbox WHERE world = 'the-grid'", q[..]) == "1", ap_body(t));
  st = ap_call(t, "GET", "/api/worlds/the-grid/content", "", t[0].no[0..<0]);
  ap_check(t, "realm world: the tables read as switched", st == 200 && ct_part(ct_part(ap_body(t), '\n', 4), '|', 2) == turn, ap_body(t));
  // an undo sets it back, through the same SQL
  st = wc_post_to(t, w, t[0].admin_key, WC_REALM, 1, "undo", "");
  ap_check(t, "realm world: an undo switches it back as an edit of its own", st == 200 && w[0].st.rev == 2 && w[0].st.undo == 0 && w[0].st.redo == 1 && ap_sql(t, sb_text(ks[..]), q[..]) == (ifx was then "true" else "false"), ap_body(t));
  // what a realm's world does not take, in words, and nothing to publish
  st = wc_post_to(t, w, t[0].admin_key, WC_REALM, 2, "apply", WC_SPAWNS);
  ap_check(t, "realm world: a thing of a kind the realm doesn't place is refused in words, at its edit", st == 422 && wc_refusal(t, w, edit[..]) == "no such kind of thing here" && edit[0] == 0 && ap_sql(t, "SELECT dev_rev FROM verse.world_docs WHERE id = 'the-grid'", q[..]) == "2", ap_body(t));
  st = wc_post_to(t, w, t[0].admin_key, WC_REALM, 2, "publish-now", "");
  ap_check(t, "realm world: there is nothing to publish", st == 422 && wc_refusal(t, w, edit[..]) == "a realm's switches and scripts reach everyone at once: there is nothing to publish", ap_body(t));
  ap_check(t, "realm world: a realm nobody made is no world", ap_call(t, "GET", "/api/worlds/no-such-realm-here?lane=dev", "", t[0].no[0..<0]) == 404 && ap_call(t, "GET", "/api/worlds/no-such-realm-here/content", "", t[0].no[0..<0]) == 404, ap_body(t));
  wc_realm_places(t, w);
}
// ---- places as world edits (#13506, migrations/0190): The Grid given two kinds of thing for these checks
wc_realm_places :: (t: [] Ap, w: [] Wc) {
  edit: [1] int; q: [400] u8;
  ap_do(t, "UPDATE verse.realm_rights SET things = ARRAY['crate', 'bench'] WHERE slug = 'the-grid'; UPDATE verse.realm_edit SET placed = '[]' WHERE slug = 'the-grid';");
  placed := "SELECT coalesce((SELECT placed::text FROM verse.realm_edit WHERE slug = 'the-grid'), '[]')";
  two := "{\"op\":\"spawn\",\"id\":0,\"kind\":2,\"x\":150,\"y\":0,\"z\":-250,\"yaw\":90,\"scale\":100},{\"op\":\"spawn\",\"id\":0,\"kind\":1,\"x\":-300,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}";
  st := wc_post_to(t, w, t[0].admin_key, WC_REALM, 2, "apply", two);
  did := cast(string) w[0].did[0..<w[0].st.did_n];
  ap_check(t, "realm places: a spawn places a thing through the realm's SQL; the batch as taken numbers them 1 and 2",
           st == 200 && w[0].st.rev == 4 && ap_has(did, "\"op\":\"spawn\",\"id\":1,\"kind\":2") && ap_has(did, "\"id\":2,\"kind\":1")
           && ap_sql(t, placed, q[..]) == "[{\"x\": 1.5, \"z\": -2.5, \"yaw\": 1.571, \"thing\": \"bench\"}, {\"x\": -3, \"z\": 0, \"yaw\": 0, \"thing\": \"crate\"}]", ap_body(t));
  st = ap_call(t, "GET", "/api/worlds/the-grid/content", "", t[0].no[0..<0]);
  ap_check(t, "realm places: the kinds and the things are tables", st == 200 && ap_has(ap_body(t), "table kinds id name:text\n1|crate\n2|bench\n") && ap_has(ap_body(t), "table things id kind:ref.kinds x:cm z:cm turn:int size:int\n1|2|150|-250|90|100\n2|1|-300|0|0|100\n"), ap_body(t));
  // a despawn marks thing 1 gone: thing 2 keeps its ID, and the next spawn is 3
  st = wc_post_to(t, w, t[0].admin_key, WC_REALM, 4, "apply", "{\"op\":\"despawn\",\"id\":1}");
  gone := ap_sql(t, "SELECT (placed->0->>'gone') || ' ' || jsonb_array_length(placed) FROM verse.realm_edit WHERE slug = 'the-grid'", q[..]) == "true 2";
  ap_check(t, "realm places: a despawn marks the thing gone and shifts no ID", st == 200 && w[0].st.rev == 5 && gone, ap_body(t));
  st = ap_call(t, "GET", "/api/worlds/the-grid/content", "", t[0].no[0..<0]);
  ap_check(t, "realm places: a gone thing is no row of the things table", st == 200 && ap_has(ap_body(t), "table things id kind:ref.kinds x:cm z:cm turn:int size:int\n2|1|-300|0|0|100\ntable tools"), ap_body(t));
  // the undo brings it back as it was; the redo takes it away again
  st = wc_post_to(t, w, t[0].admin_key, WC_REALM, 5, "undo", "");
  back := st == 200 && ap_sql(t, "SELECT (placed->0)::text FROM verse.realm_edit WHERE slug = 'the-grid'", q[..]) == "{\"x\": 1.5, \"z\": -2.5, \"yaw\": 1.571, \"thing\": \"bench\"}";
  st = wc_post_to(t, w, t[0].admin_key, WC_REALM, 6, "redo", "");
  ap_check(t, "realm places: undo and redo are the world's: the thing comes back exactly, then goes again", back && st == 200 && w[0].st.rev == 7 && ap_sql(t, "SELECT placed->0->>'gone' FROM verse.realm_edit WHERE slug = 'the-grid'", q[..]) == "true", ap_body(t));
  // the realm's own words, at the edit
  st = wc_post_to(t, w, t[0].admin_key, WC_REALM, 7, "apply", "{\"op\":\"despawn\",\"id\":1}");
  ap_check(t, "realm places: a thing gone already is refused in words, at its edit", st == 422 && wc_refusal(t, w, edit[..]) == "that thing is gone already" && edit[0] == 0, ap_body(t));
  st = wc_post_to(t, w, t[0].admin_key, WC_REALM, 7, "apply", "{\"op\":\"spawn\",\"id\":0,\"kind\":1,\"x\":40001,\"y\":0,\"z\":0,\"yaw\":0,\"scale\":100}");
  ap_check(t, "realm places: one too far is the place rules' refusal (realm-place-policy.coax), in words", st == 422 && wc_refusal(t, w, edit[..]) == "a thing stands within 400 m of the middle" && ap_sql(t, "SELECT jsonb_array_length(placed) FROM verse.realm_edit WHERE slug = 'the-grid'", q[..]) == "2", ap_body(t));
  ap_do(t, "UPDATE verse.realm_rights SET things = ARRAY[]::text[] WHERE slug = 'the-grid'; UPDATE verse.realm_edit SET placed = '[]' WHERE slug = 'the-grid';");
}
