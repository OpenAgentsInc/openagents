// The API's seat-ticket writer (#13260): metaverse-engine/session/seat-ticket.coax, the one v5 writer, compiled
// to C as one unit of the API (ticket-sign-unit.c; deploy.sh, test.sh). player.c room_ticket calls it
// when OA_ROOM_TICKET_SIGNING_KEY is set. It also checks room shards' writes (coax/web/room/room-write.coax,
// room_write_signed in rooms.c) when OA_ROOM_WRITE_MASTER is set. The format, its reader and the checks are in that file.
// And it carries crash report v1's codec (coax/web/room/room-crash.coax, #13298): the API checks a room's
// report, builds a page's and reads both through it (crash_*_c in ticket-sign-unit.c). And capacity record
// v1's (soak-record.coax, #13296): the API checks a night's record and reads its fields
// (capacity_record_*_c). And the room reports' codec (metaverse-engine/session/room-report.coax, #13250): the
// API writes a vitals post's receipt and a checkpoint's receipt through it (room_report_*_c).
//   coax c coax/web/api/ticket-sign.coax --run-steps 250000000 --library --header ticket-sign.generated.h
#run_steps 250000000;
#load "../../../metaverse-engine/session/seat-ticket.coax";
#load "../room/room-write.coax";
#load "../room/room-crash.coax";   // crash report v1: the one codec, for rooms.c and service.c (#13298)
#load "soak-record.coax";   // capacity record v1: the one codec, for rooms.c (#13296)
#load "../../../metaverse-engine/session/room-report.coax";   // the receipts player.c answers a room's vitals and checkpoint posts with (Protocol E7 and E8, #13250)
#load "../../../metaverse-engine/session/seat-class.coax";   // the EXT's class and level (#13259)
