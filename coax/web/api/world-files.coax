// Attachments' rules on the API (GitHub #13468; docs/protocol/world-files-v1.md): what
// coax/web/api/worlds.c asks for /api/worlds/ID/files and /api/projects/SLUG/files. worlds.c reads
// the facts (migrations/0184_world_attachments.sql: each scope's list, and who is a member), asks
// here, and stores what these answers say; every byte it answers is file-wire.coax's, written by
// the shared store code the dev server runs too (metaverse-engine/editor/file-store.coax).
//
//   who may read or write   the project's members and the site's admins, from this site or signed
//                           (wf_may); a world with no project, its admins only
//   a file                  named by its SHA-256 before it is sent by direct upload to the private
//                           bucket, then read back: its size and hash are the ones asked, and its
//                           first bytes are what its name says (fl_attach), or it is refused and
//                           deleted
//   the bytes               never logged; served as the type its extension names, never a browser's
// Loaded by world-policy.coax, the API's unit for the world routes.
#load "../../../metaverse-engine/editor/file-store.coax";

WF_NOT_MEMBER :: 12;   // logged in, but not a member of the project nor an admin
// Who may list, read or change a world's attachments and its project's.
wf_may :: (same_site: bool, known: bool, admin: bool, member: bool, has_project: bool) -> int #export_c #effects(all) {
  if !same_site { return WR_CROSS; }
  if !known { return WR_LOG_IN; }
  if admin { return WR_OK; }
  return ifx member && has_project then WR_OK else WF_NOT_MEMBER;
}
wf_status :: (verdict: int) -> int #export_c #effects(all) { return ifx verdict == WF_NOT_MEMBER then 403 else wr_status(verdict); }
wf_words :: (verdict: int) -> string #export_c #effects(all) {
  if verdict == WF_NOT_MEMBER { return "only the project's members and the site's admins see its attachments"; }
  if verdict == WR_LOG_IN { return "log in to see the project's attachments"; }
  return wr_words(verdict);
}
// The project a world belongs to ("" for none), and whether a slug is a project's.
wf_project :: (world: string) -> string #export_c #effects(all) { return fw_project_for(world); }
wf_project_ok :: (slug: string) -> bool #export_c #effects(all) { return fw_project_ok(slug); }
wf_world_ok :: (world: string) -> bool #export_c #effects(all) { return fw_world_ok(world); }
wf_id_ok :: (id: string) -> bool #export_c #effects(all) { return fw_id_ok(id); }
// The two stored lists read into one (world "" for a project's own list). other, other_bytes: what
// the project's other worlds hold.
wf_load :: (w: [] FlWork, world: string, project: string, world_text: string, project_text: string, other: int, other_bytes: int) -> bool #export_c #effects(all) {
  return fl_load(w, world, project, world_text, project_text, other, other_bytes);
}
// A stored list's own count and bytes (-1: it does not read).
wf_held :: (text: string, bytes: bool) -> int #export_c #effects(all) {
  if text.count == 0 { return 0; }
  n := 0; b := 0;
  for i: 0..<fw_parts(text, '\n') {
    line := fw_part(text, '\n', i);
    if fw_field(line, 0) == "f" { v := fw_num(fw_field(line, 4)); if v < 0 { return -1; } n += 1; b += v; }
  }
  return ifx bytes then b else n;
}
// A request's head read; what it is (FW_Q_*, 0: none).
wf_ask :: (a: [] FwAsk, body: string) -> int #export_c #effects(all) { return ifx fw_ask_read(a, body) then a[0].what else 0; }
wf_ask_hash :: (a: [] FwAsk) -> string #export_c #effects(all) { return ifx a[0].hashed then cast(string) a[0].hash[..] else ""; }
wf_ask_bytes :: (a: [] FwAsk) -> int #export_c #effects(all) { return a[0].bytes; }
wf_ask_type :: (a: [] FwAsk) -> string #export_c #effects(all) { return fw_type(cast(string) a[0].name[0..<a[0].name_n]); }
// A file named before it is sent: whether it may be attached now (200), else the refusal's status
// with its words in w.
wf_admit :: (w: [] FlWork, a: [] FwAsk) -> int #export_c #effects(all) {
  if a[0].what != FW_Q_UPLOAD || !a[0].hashed { return fl_say(w, 400, "send world.file.upload.v1 with the file's SHA-256"); }
  return fl_admit(w, a[0].scope, cast(string) a[0].name[0..<a[0].name_n], a[0].bytes);
}
// What a file whole in a request is told on the API: it takes files by direct upload.
wf_whole_words :: () -> string #export_c #effects(all) { return "This server takes a file by direct upload: send world.file.upload.v1, then the file to the address it answers, then the same ask to .../files/done."; }
// The stored object, once read back: its first bytes (16 at most) are scanned, and it is attached.
wf_attach :: (w: [] FlWork, a: [] FwAsk, head: string, now: int, by: string) -> int #export_c #effects(all) {
  return fl_attach(w, a, wf_ask_hash(a), head, now, by);
}
wf_apply :: (w: [] FlWork, a: [] FwAsk, now: int, by: string) -> int #export_c #effects(all) { return fl_apply(w, a, now, by); }
wf_said :: (w: [] FlWork) -> string #export_c #effects(all) { return fl_words_of(w); }
wf_list_answer :: (w: [] FlWork) -> string #export_c #effects(all) { return fl_answer(w); }
// A scope's stored list into out: its length, or -1 (that scope has no list here).
wf_stored :: (w: [] FlWork, scope: int, out: [] u8) -> int #export_c #effects(all) {
  s := fl_stored(w, scope, out);
  return ifx s.count == 0 then -1 else s.count;
}
wf_freed :: (w: [] FlWork) -> string #export_c #effects(all) { return ifx w[0].freed then cast(string) w[0].freed_hash[..] else ""; }
// The attachment of this ID that has a file: its place (-1: none), its SHA-256, size and type.
wf_file :: (w: [] FlWork, id: string) -> int #export_c #effects(all) { return fl_file_at(w, id); }
wf_file_hash :: (w: [] FlWork, i: int) -> string #export_c #effects(all) { return fw_hash_of(w[0].m[..], i); }
wf_file_bytes :: (w: [] FlWork, i: int) -> int #export_c #effects(all) { return w[0].m[0].f[i].bytes; }
wf_file_type :: (w: [] FlWork, i: int) -> string #export_c #effects(all) { return fw_type(fw_name_of(w[0].m[..], i)); }
wf_read_part :: () -> int #export_c #effects(all) { return FW_READ_PART; }
// Whether an object of this SHA-256 is still named by any list of the project: the caller asks each
// stored list (a detach removes a file only when none names it).
wf_names :: (text: string, hash: string) -> bool #export_c #effects(all) {
  for i: 0..<fw_parts(text, '\n') { line := fw_part(text, '\n', i); if fw_field(line, 0) == "f" && fw_field(line, 5) == hash { return true; } }
  return false;
}
// An upload's answer: where the bytes go (put), or that storage has them (kept).
wf_upload_answer :: (put: bool, hash: string, bytes: int, url: string, out: [] u8) -> int #export_c #effects(all) {
  s := fw_upload_answer(out, put, hash, bytes, url);
  return ifx s.count == 0 then -1 else s.count;
}

#test "the members and the admins, from this site or signed; nobody else" {
  #assert wf_may(true, true, true, false, false) == WR_OK && wf_may(true, true, false, true, true) == WR_OK;
  #assert wf_may(false, true, true, true, true) == WR_CROSS && wf_may(true, false, true, true, true) == WR_LOG_IN;
  #assert wf_may(true, true, false, false, true) == WF_NOT_MEMBER && wf_may(true, true, false, true, false) == WF_NOT_MEMBER;
  #assert wf_status(WF_NOT_MEMBER) == 403 && wf_status(WR_LOG_IN) == 401 && wf_status(WR_CROSS) == 403 && wf_words(WF_NOT_MEMBER).count > 20;
  #assert wf_project("splice") == "verse" && wf_project("nowhere") == "";
}
#test "a stored list's count and bytes, and whether it names a file" {
  t := "world.files.v1 splice verse 0 0 26214400 200 1073741824\nf 00112233445566aa world image 2000 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08 1 local a.png\nf 00112233445566bb world link 0 - 1 local x\nu https://example.com/x\n";
  #assert wf_held(t, false) == 2 && wf_held(t, true) == 2000 && wf_held("", true) == 0;
  #assert wf_names(t, "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08") && !wf_names(t, "00");
}
