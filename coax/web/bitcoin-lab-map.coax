// Generate the realm's chapter rows from the book registry, preserving status.
// coax/web/tool.sh bitcoin-lab-map [--check]
#import "Basic";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/json/json.coax";
#load "../../apps/openagents-web/bitcoin-lab-data.coax";
MapText :: struct {bytes:[2097152]u8;n:int;bad:bool;}
MAP_STATIONS :: [7]string.["Chain","Transactions/UTXOs","Proof/Script","Node","Mempool/Mining","Wallets","Lightning"];
map_add :: (b:[]MapText,s:string) {
  if s.count>b[0].bytes.count-b[0].n {b[0].bad=true;return;}
  for c:s {b[0].bytes[b[0].n]=c;b[0].n+=1;}
}
map_number :: (b:[]MapText,n:int) {
  bytes:[32]u8;o:[1]Jo;jo_start(o[..],bytes[..]);jo_int(o[..],n);map_add(b,jo_text(o[..]));
}
map_save :: (b:[]MapText,path:string,check:bool)->bool {
  if b[0].bad {return false;}
  text:=cast(string)b[0].bytes[0..<b[0].n];old:[2097152]u8;k:=fs_read(path,old[..]);
  if k>=0 && cast(string)old[0..<k]==text {return true;}
  if check {tool_err("stale: ");tool_errln(path);return false;}
  return fs_write(path,text);
}
map_html :: (b:[]MapText,text:string) {
  for c:text {
    if c=='&' {map_add(b,"&amp;");}else if c=='<' {map_add(b,"&lt;");}
    else {one:=[1]u8.[c];map_add(b,cast(string)one[..]);}
  }
}
map_recording :: (b:[]MapText,html:bool) {
  map_add(b,ifx html then "<section><h2>Recorded regtest blocks</h2><p>Validated-v1 recording, not a live node. Observation time unknown. Equal slabs represent one block each. Exact outpoint links imply no wallet ownership.</p>" else "\n## Recorded regtest blocks\n\nValidated-v1 recording; observation time unknown. Full transaction inputs, outputs, scripts and spend occurrences are in the HTML fallback and compiled recording.\n");
  for phase:0..<3 {
    snap:=LAB_SNAPSHOTS[phase];map_add(b,ifx html then "<details><summary>Snapshot " else "\n### Snapshot ");map_number(b,phase);map_add(b," — height ");map_number(b,snap.height);
    map_add(b,ifx html then "</summary><p>Committed tip: <code>" else "\n\nCommitted tip: `");map_add(b,snap.hash);map_add(b,ifx html then "</code></p>" else "`\n\n| Height | State | Full block hash | Bytes | Weight | Transactions |\n| --- | --- | --- | --- | --- | --- |\n");
    for index:snap.first..<snap.first+snap.count {
      row:=LAB_BLOCKS[index];map_add(b,ifx html then "<details><summary>Block " else "| ");map_number(b,row.height);map_add(b,ifx html then " — " else " | ");map_add(b,ifx row.active then "active" else "stale");
      map_add(b,ifx html then "</summary><p>Hash <code>" else " | ");map_add(b,row.hash);map_add(b,ifx html then "</code></p><p>Bytes " else " | ");map_number(b,row.size);map_add(b,ifx html then "; weight " else " | ");map_number(b,row.weight);map_add(b,ifx html then "; transactions " else " | ");map_number(b,row.count);
      if !html {map_add(b," |\n");continue;}
      map_add(b,"; header Unix time ");map_number(b,row.time);map_add(b,"</p><p>Previous <code>");map_add(b,row.previous);map_add(b,"</code>; chainwork <code>");map_add(b,row.chainwork);map_add(b,"</code></p><ul>");
      for t:row.tx..<row.tx+row.count {
        tx:=LAB_TXS[t];map_add(b,"<li><p>Transaction ");map_number(b,tx.order);map_add(b," <code>");map_add(b,tx.txid);map_add(b,"</code>; bytes ");map_number(b,tx.size);map_add(b,"; weight ");map_number(b,tx.weight);map_add(b,".</p><p>Inputs: ");
        for i:tx.input..<tx.input+tx.ni {input:=LAB_INPUTS[i];if input.coinbase {map_add(b,"coinbase; ");}else {map_add(b,"<code>");map_add(b,input.txid);map_add(b,":");map_number(b,input.vout);map_add(b,"</code>; ");}}
        map_add(b,"</p><ul>");for i:0..<tx.no {
          output:=LAB_OUTPUTS[tx.output+i];map_add(b,"<li>Output ");map_number(b,i);map_add(b,": ");map_number(b,output.value_sat);map_add(b," sat; ");
          map_add(b,ifx output.status=="unspent" && tx.order==0 && row.height+100>snap.height then "immature" else output.status);
          map_add(b,"; script <code>");map_add(b,output.script_hex);map_add(b,"</code>");
          if output.address!="" {map_add(b,"; address <code>");map_add(b,output.address);map_add(b,"</code>");}
          if output.spend!="" {map_add(b,"; spent by <code>");map_add(b,output.spend);map_add(b,"</code> in block <code>");map_add(b,output.spend_block);map_add(b,"</code> input ");map_number(b,output.vin);}
          map_add(b,"</li>");
        }map_add(b,"</ul></li>");
      }map_add(b,"</ul></details>");
    }if html {map_add(b,"</details>");}
  }if html {map_add(b,"</section>\n");}
}
map_target :: (d:Jv,row:int,plan:string,out:[]u8)->string {
  file:=jv_get(d,row,"file");if jv_kind(d,file)==JV_STRING {return jv_raw(d,file);}
  // A planned chapter has no file yet: link its exact done-criteria row.
  pattern:[1]MapText;map_add(pattern[..],"| ");map_number(pattern[..],jv_int(d,jv_get(d,row,"number"),0));map_add(pattern[..],". ");
  prefix:=cast(string)pattern[0].bytes[0..<pattern[0].n];line:=1;start:=0;
  for i:0..<plan.count {
    if i==start && i+prefix.count<=plan.count && plan[i..<i+prefix.count]==prefix {
      b:[1]MapText;map_add(b[..],"PLAN.md#L");map_number(b[..],line);
      if b[0].n>out.count {return "";}for k:0..<b[0].n {out[k]=b[0].bytes[k];}
      return cast(string)out[0..<b[0].n];
    }
    if plan[i]=='\n' {start=i+1;line+=1;}
  }
  return "";
}
// Parts are assigned once; cross-cutting verification chapters sit at Node.
map_station :: (n:int)->int {
  if n<=25 || (n>=35 && n<=39) || (n>=41 && n<=45) || (n>=100 && n<=103) {return 2;}
  if (n>=26 && n<=33) || (n>=94 && n<=99) || (n>=122 && n<=123) {return 5;}
  if n==34 || n==40 || n==57 || n==125 {return 1;}
  if n>=104 && n<=115 {return 6;}
  if n>=81 && n<=88 {return 4;}
  if n>=46 && n<=60 {return 0;}
  return 3;
}
#test "every chapter has one station and the integration chapters keep their homes" {
  for n:1..<126 {#assert map_station(n)>=0 && map_station(n)<7;}
  #assert map_station(1)==2 && map_station(34)==1 && map_station(46)==0;
  #assert map_station(64)==3 && map_station(82)==4 && map_station(99)==5;
  #assert map_station(110)==6 && map_station(117)==3 && map_station(125)==1;
}
tool_main :: ()->int #export_c {
  args:[1]Args;if !args_load(args[..]) || args_count(args[..])>1 {return 2;}
  check:=args_count(args[..])==1 && args_at(args[..],0)=="--check";
  if args_count(args[..])==1 && !check {return 2;}
  bytes:[262144]u8;n:=fs_read("bitcoin/book/chapters.json",bytes[..]);nodes:[32768]JvNode;d:[1]Jv;
  if n<0 || !jv_parse(d[..],cast(string)bytes[0..<n],nodes[..]) {return 2;}
  chapters:=jv_get(d[0],0,"chapters");if jv_len(d[0],chapters)!=125 {return 2;}
  plan_bytes:[131072]u8;pn:=fs_read("bitcoin/book/PLAN.md",plan_bytes[..]);if pn<0 {return 2;}
  plan:=cast(string)plan_bytes[0..<pn];target:[128]u8;
  b:[1]MapText;map_add(b[..],"// Generated by coax/web/bitcoin-lab-map.coax from bitcoin/book/chapters.json.\nLabChapter :: struct {title:string;file:string;status:string;station:int;}\nLAB_CHAPTERS :: [125]LabChapter.[\n");
  for i:0..<125 {
    row:=jv_at(d[0],chapters,i);if jv_int(d[0],jv_get(d[0],row,"number"),0)!=i+1 {return 2;}
    map_add(b[..],"  LabChapter.{title=\"");map_add(b[..],jv_raw(d[0],jv_get(d[0],row,"title")));
    file:=map_target(d[0],row,plan,target[..]);if file=="" {return 2;}
    map_add(b[..],"\",file=\"");map_add(b[..],file);
    map_add(b[..],"\",status=\"");map_add(b[..],jv_raw(d[0],jv_get(d[0],row,"status")));
    map_add(b[..],"\",station=");map_number(b[..],map_station(i+1));map_add(b[..],"},\n");
  }
  map_add(b[..],"];\n");
  ok:=map_save(b[..],"apps/openagents-web/bitcoin-lab-chapters.coax",check);
  // Keep the hand-authored introduction; only the marked table is generated.
  intro:[131072]u8;k:=fs_read("apps/openagents-web/realms/bitcoin-lab/index.md",intro[..]);if k<0 {return 2;}
  text:=cast(string)intro[0..<k];marker:="<!-- generated chapter map -->\n";end:=0;
  for i:0..<text.count-marker.count+1 {if text[i..<i+marker.count]==marker {end=i+marker.count;break;}}
  if end==0 {return 2;}
  b[0]=MapText.{};map_add(b[..],text[0..<end]);
  map_add(b[..],"\n| Chapter | Station | Book status | Visual exercise |\n| --- | --- | --- | --- |\n");
  for i:0..<125 {
    row:=jv_at(d[0],chapters,i);map_add(b[..],"| [");map_number(b[..],i+1);map_add(b[..],". ");map_add(b[..],jv_raw(d[0],jv_get(d[0],row,"title")));
    map_add(b[..],"](https://github.com/OpenAgentsInc/openagents/blob/main/bitcoin/book/");map_add(b[..],map_target(d[0],row,plan,target[..]));
    map_add(b[..],") | ");map_add(b[..],MAP_STATIONS[map_station(i+1)]);map_add(b[..]," | ");map_add(b[..],jv_raw(d[0],jv_get(d[0],row,"status")));
    map_add(b[..]," | not available |\n");
  }
  map_recording(b[..],false);md:=map_save(b[..],"apps/openagents-web/realms/bitcoin-lab/index.md",check);ok=ok && md;
  b[0]=MapText.{};
  map_add(b[..],"<h2>Chapter map</h2><p>RECORDED REGTEST / VALIDATED-V1 / UNLISTED. Select actual recorded block slabs, inspect transactions and outputs, and replay acknowledged A/B/C snapshots. Observation time unknown. This is not a live node. Each chapter has a primary station; book status and visual exercises are separate. WASD walks, arrows turn, 1-7 selects stations, M toggles the chapter map, R steps replay, / finds an identifier. Touch: left side walks, right side looks. Escape exits to Worlds.</p><table><caption>All 125 chapters</caption><thead><tr><th>Chapter</th><th>Station</th><th>Book status</th><th>Visual exercise</th></tr></thead><tbody>\n");
  for i:0..<125 {
    row:=jv_at(d[0],chapters,i);
    map_add(b[..],"<tr><td><a href=\"https://github.com/OpenAgentsInc/openagents/blob/main/bitcoin/book/");map_add(b[..],map_target(d[0],row,plan,target[..]));
    map_add(b[..],"\">");map_number(b[..],i+1);map_add(b[..],". ");map_html(b[..],jv_raw(d[0],jv_get(d[0],row,"title")));
    map_add(b[..],"</a></td><td>");map_html(b[..],MAP_STATIONS[map_station(i+1)]);map_add(b[..],"</td><td>");map_html(b[..],jv_raw(d[0],jv_get(d[0],row,"status")));
    map_add(b[..],"</td><td>not available</td></tr>\n");
  }
  map_add(b[..],"</tbody></table>\n");map_recording(b[..],true);html:=map_save(b[..],"apps/openagents-web/realms/bitcoin-lab/map.fallback",check);
  return ifx ok && html then 0 else 1;
}
