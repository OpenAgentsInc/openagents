// Opt-in room timing is a separate observer, not part of the realm producer.
#import "Basic";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/proc.coax";
#load "../lib/sys/args.coax";
tool_main::()->int #export_c {
  a:[1]Args;if !args_load(a[..])||args_count(a[..])!=2{tool_errln("usage: build-latency ROOT OUT.wasm");return 2;}
  p:[3][4096]u8;root:=args_at(a[..],0);script:=fs_join(root,"coax/web/wasm.sh",p[0][..]);source:=fs_join(root,"aethyr/net/latency-client.coax",p[1][..]);face:=fs_join(root,"coax/web/latency-face.c",p[2][..]);
  argv:=[5]string.["bash",script,source,face,args_at(a[..],1)];out:[1048576]u8;err:[1048576]u8;r:=proc_run(argv[..],180000,out[..],err[..]);
  if r.started!=0||r.status!=0||r.timed_out||r.cut{tool_errln(cast(string)err[0..<r.err_n]);return 1;}print("Opt-in room timing observer: %\n",args_at(a[..],1));return 0;
}
