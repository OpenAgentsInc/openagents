// Build queue admission independently of the realm and renderer images.
#import "Basic";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/proc.coax";
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..])||args_count(a[..])!=2{tool_errln("usage: build-sockets ROOT OUT.wasm");return 2;}
 root:=args_at(a[..],0);paths:[3][4096]u8;argv:=[5]string.["bash",fs_join(root,"coax/web/wasm.sh",paths[0][..]),fs_join(root,"aethyr/host/socket-carrier.coax",paths[1][..]),fs_join(root,"coax/web/socket-face.c",paths[2][..]),args_at(a[..],1)];out:[1048576]u8;err:[1048576]u8;r:=proc_run(argv[..],180000,out[..],err[..]);if r.started!=0||r.status!=0||r.cut||r.timed_out{tool_errln(cast(string)err[0..<r.err_n]);return 1;}print("Shared socket queue reactor:%\n",args_at(a[..],1));return 0;
}
