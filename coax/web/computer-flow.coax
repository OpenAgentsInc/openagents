// YOUR COMPUTER, played in headless Chrome (no window opens) against a local relay and a real
// `coder host` (openagents#12642; docs/verse/realm-edit.md "Your computer"). The page is the made
// realm pine-forest from staging, opened at a localhost origin granted Local Network Access (FL_LNA),
// whose requests DevTools interception sends on to staging, with two answers swapped in:
// the realm module is the one built from this checkout, and the realm's spec says we own it. Every other
// API call that would write (a POST) is answered here with 204 and never leaves the browser; the
// session carries the automation mark (verse-automation), so analytics leaves it out. The page
// reaches the local relay through ?relay=ws://localhost:PORT (the wire takes only that form).
//
// The owner opens EDIT > COMPUTER, pastes the host's key and pairs; the person at the computer allows
// it (`coder host allow`); the pane shows the computer answers, a request runs as a job whose steps
// come in, a reload keeps the pairing, a phone-width page shows the pane, and FORGET takes the
// browser off the computer. It reads the pane through coaxial.guardProbe(2400 + f) (verse/edit/
// edit.coax redit_probe: 4 * b + 0..3 button b's box, 96 the pane, 97 the view).
//
//   coax/relay/build.sh /tmp/relay && /tmp/relay --listen 127.0.0.1 --port 7777 --url ws://localhost:7777
//   OPENAGENTS_NIP_HOST_RELAY=ws://localhost:7777 CODER_HOME=/tmp/host-home coder/tui/coder.sh host --engine echo
//   COAXIAL_RUN_STEPS=250000000 coax/web/wasm.sh apps/openagents-web/myrealm.coax apps/openagents-web/myrealm-face.c \
//     /tmp/myrealm.wasm verse/edit/computer-wire.coax coax/lib/crypto/entropy.coax
//   CODER_HOME=/tmp/host-home BROWSER=/usr/bin/true coax/web/tool.sh computer-flow ws://localhost:7777 /tmp/myrealm.wasm [SHOTS_DIR]
//
// Run it from the repository's root (it runs coder/tui/coder.sh from there). Exit 0 when every check
// passed, 1 when one failed, 2 for a usage error.
#import "Basic";
#load "../lib/net/cdp.coax";

FL_ORIGIN :: "https://staging.openagents.com";
FL_HERE :: "http://golden.localhost:47998";   // the page's origin: nothing listens there; every request is answered or sent on to FL_ORIGIN
FL_SPEC :: "/api/playtest/realms/pine-forest";
FL_PAGE :: "/realms/pine-forest?relay=";
FL_LOCAL :: "ws://localhost:";
FL_WASM_MAX :: 4194304;                         // the largest module served
FL_B64_MAX :: FL_WASM_MAX / 3 * 4 + 8;
FL_CMD_MAX :: FL_B64_MAX + 8192;
FL_SPEC_MAX :: 1048576;
FL_PNG_MAX :: 25165824;
FL_PEND :: 8;                                   // spec bodies being read at once
FL_MS :: 30000;                                 // the wait for one DevTools reply
// Local Network Access: the page comes from a public server, so Chrome blocks its socket to this
// machine's relay unless granted; the permission's names across Chrome versions.
FL_LNA :: [3] string.["localNetworkAccess", "localNetwork", "loopbackNetwork"];

// Views (verse/edit/computer.coax RV_*) and buttons (verse/edit/edit.coax RB_*) the flow reads.
RV_UNPAIRED_V :: 1; RV_ASKING_V :: 2; RV_ALLOWED_V :: 3; RV_RUNNING_V :: 7; RV_STOPPED_V :: 8; RV_FAILED_V :: 9; RV_DONE_V :: 10;
FB_EDIT :: 0; FB_CTAB :: 12; FB_CMAIN :: 13; FB_CFORGET :: 14; FB_CFIELD :: 16;
FP_PANE :: 96; FP_VIEW :: 97; FL_COMPUTER_PANE :: 6;

Flow :: struct {
  wasm: [FL_WASM_MAX] u8; wasm_n: int;
  b64: [FL_B64_MAX] u8;
  cmd: [FL_CMD_MAX] u8; frame: [FL_CMD_MAX + 14] u8;
  spec: [FL_SPEC_MAX] u8; spec2: [FL_SPEC_MAX] u8;
  png: [FL_PNG_MAX] u8;
  page: [512] u8; page_n: int;
  coder: [2048] u8; coder_n: int;
  out: [262144] u8; out_n: int; err: [4096] u8;
  pend_id: [FL_PEND] int; pend_req: [FL_PEND * 256] u8; pend_n: [FL_PEND] int;
  label: [256] u8; label_n: int; ask: [128] u8; ask_n: int;
  served_wasm: int; served_spec: int; held_posts: int;
  failed: int; bad: bool;
}

// ---- text (pure) -------------------------------------------------------------

FlBuf :: struct { b: [8192] u8; n: int; bad: bool; }
fl_put :: (o: [] FlBuf, s: string) {
  if o[0].n + s.count > o[0].b.count { o[0].bad = true; return; }
  for i: 0..<s.count { o[0].b[o[0].n + i] = s[i]; }
  o[0].n += s.count;
}
fl_int :: (o: [] FlBuf, v: int) {
  if v < 0 { fl_put(o, "-"); fl_int(o, -v); return; }
  d: [20] u8; n := 0; x := v;
  if x == 0 { d[0] = '0'; n = 1; }
  while x > 0 { d[n] = cast(u8) ('0' + x % 10); x /= 10; n += 1; }
  for i: 0..<n { e: [1] u8; e[0] = d[n - 1 - i]; fl_put(o, cast(string) e[..]); }
}
fl_text :: (o: [] FlBuf) -> string { return cast(string) o[0].b[0..<o[0].n]; }
fl_starts :: (s: string, p: string) -> bool { return s.count >= p.count && s[0..<p.count] == p; }
fl_ends :: (s: string, p: string) -> bool { return s.count >= p.count && s[s.count - p.count..<s.count] == p; }
fl_has :: (s: string, part: string) -> bool {
  if part.count == 0 { return true; }
  for i: 0..<s.count - part.count + 1 { if s[i..<i + part.count] == part { return true; } }
  return false;
}
// A URL's path: after the host, before ? or #.
fl_path :: (url: string) -> string {
  i := 0;
  while i + 2 < url.count && !(url[i] == ':' && url[i + 1] == '/' && url[i + 2] == '/') { i += 1; }
  if i + 2 >= url.count { return ""; }
  i += 3;
  while i < url.count && url[i] != '/' { i += 1; }
  e := i;
  while e < url.count && url[e] != '?' && url[e] != '#' { e += 1; }
  return url[i..<e];
}
// The realm module's path, /build/myrealm.HASH.wasm.
fl_is_module :: (path: string) -> bool {
  if !fl_starts(path, "/build/myrealm.") || !fl_ends(path, ".wasm") { return false; }
  hash := path["/build/myrealm.".count..<path.count - ".wasm".count];
  if hash.count == 0 { return false; }
  for ch: hash { if !((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f')) { return false; } }
  return true;
}
// A local test relay, ws://localhost:PORT, as the wire takes it.
fl_relay_ok :: (relay: string) -> bool {
  if relay.count <= FL_LOCAL.count || relay.count > FL_LOCAL.count + 5 || !fl_starts(relay, FL_LOCAL) { return false; }
  for ch: relay[FL_LOCAL.count..<relay.count] { if ch < '0' || ch > '9' { return false; } }
  return true;
}
#test "computer flow: which requests it answers" {
  #assert fl_path("https://staging.openagents.com/build/myrealm.5a1af91632c3.wasm") == "/build/myrealm.5a1af91632c3.wasm";
  #assert fl_path("https://staging.openagents.com/api/playtest/realms/pine-forest?x=1") == FL_SPEC;
  #assert fl_path("https://staging.openagents.com") == "" && fl_path("nothing") == "";
  #assert fl_is_module("/build/myrealm.5a1af91632c3.wasm") && !fl_is_module("/build/myrealm..wasm") && !fl_is_module("/build/myrealm.x.wasm") && !fl_is_module("/build/realm.5a.wasm");
  #assert fl_relay_ok("ws://localhost:7777") && !fl_relay_ok("ws://localhost:") && !fl_relay_ok("ws://localhost.evil:7") && !fl_relay_ok("wss://relay.openagents.com");
  #assert fl_has("Chrome on Mac", "on Mac") && !fl_has("Mac", "on Mac");
}

// ---- DevTools, with the page's requests answered on the way ---------------------

// A command too big for cdp_send (the module's body): framed from our own buffers. Its id, or -1.
fl_send_big :: (c: [] Cdp, f: [] Flow, o: [] Jo) -> int {
  mask: [4] u8;
  if o[0].bad || c[0].h < 0 || !cdp_draw(4, mask[..]) { return -1; }
  n := ws_frame_write(WS_OP_TEXT, true, jo_text(o), mask[..], f[0].frame[..]);
  if n <= 0 || !cdp_put(c, cast(string) f[0].frame[0..<n]) { return -1; }
  return c[0].id;
}
// Fetch.fulfillRequest: the request answered with code, its type and body.
fl_fulfill :: (c: [] Cdp, f: [] Flow, req: string, code: int, ctype: string, body: string) -> bool {
  n := b64_encode(body, f[0].b64[..]);
  if n < 0 { return false; }
  c[0].id += 1;
  o: [1] Jo; jo_start(o[..], f[0].cmd[..]);
  jo_obj(o[..]); jo_key(o[..], "id"); jo_int(o[..], c[0].id); jo_key(o[..], "method"); jo_str(o[..], "Fetch.fulfillRequest");
  jo_key(o[..], "params"); jo_obj(o[..]);
  jo_key(o[..], "requestId"); jo_str(o[..], req); jo_key(o[..], "responseCode"); jo_int(o[..], code);
  jo_key(o[..], "responseHeaders"); jo_arr(o[..]);
  jo_obj(o[..]); jo_key(o[..], "name"); jo_str(o[..], "Content-Type"); jo_key(o[..], "value"); jo_str(o[..], ctype); jo_end(o[..]);
  jo_end(o[..]);
  if body.count > 0 { jo_key(o[..], "body"); jo_str(o[..], cast(string) f[0].b64[0..<n]); }
  jo_end(o[..]); jo_end(o[..]);
  return fl_send_big(c, f, o[..]) >= 0;
}
// Fetch.continueRequest to url instead (the page doesn't see the change).
fl_onward :: (c: [] Cdp, req: string, url: string) -> int {
  b: [9216] u8; o: [1] Jo; jo_start(o[..], b[..]);
  jo_obj(o[..]); jo_key(o[..], "requestId"); jo_str(o[..], req); jo_key(o[..], "url"); jo_str(o[..], url); jo_end(o[..]);
  return ifx o[0].bad then -1 else cdp_send(c, "Fetch.continueRequest", jo_text(o[..]));
}
fl_on :: (c: [] Cdp, method: string, req: string) -> int {
  b: [1024] u8; o: [1] Jo; jo_start(o[..], b[..]);
  jo_obj(o[..]); jo_key(o[..], "requestId"); jo_str(o[..], req); jo_end(o[..]);
  return ifx o[0].bad then -1 else cdp_send(c, method, jo_text(o[..]));
}
// The spec's body came back: answered with the owner's lines after it.
fl_spec_body :: (c: [] Cdp, f: [] Flow, d: Jv, req: string) {
  r := cdp_reply_result(d);
  n := jv_str(d, jv_get(d, r, "body"), f[0].spec[..]);
  if n < 0 { f[0].bad = true; s1 := fl_on(c, "Fetch.continueRequest", req); return; }
  m := n;
  if jv_bool(d, jv_get(d, r, "base64Encoded")) {
    m = b64_decode(cast(string) f[0].spec[0..<n], f[0].spec2[..]);
    if m < 0 { f[0].bad = true; s2 := fl_on(c, "Fetch.continueRequest", req); return; }
    for i: 0..<m { f[0].spec[i] = f[0].spec2[i]; }
  }
  if m > 0 && f[0].spec[m - 1] != '\n' && m < FL_SPEC_MAX { f[0].spec[m] = '\n'; m += 1; }
  owner := "role owner\nowner 1\n";
  if m + owner.count > FL_SPEC_MAX { f[0].bad = true; s3 := fl_on(c, "Fetch.continueRequest", req); return; }
  for i: 0..<owner.count { f[0].spec[m + i] = owner[i]; }
  m += owner.count;
  if !fl_fulfill(c, f, req, 200, "text/plain; charset=utf-8", cast(string) f[0].spec[0..<m]) { f[0].bad = true; }
  f[0].served_spec += 1;
}
// One message from the browser that isn't the reply being waited for.
fl_message :: (c: [] Cdp, f: [] Flow) {
  d := cdp_doc(c);
  rid := cdp_reply_id(d);
  if rid >= 0 {
    for i: 0..<FL_PEND {
      if f[0].pend_id[i] == rid {
        f[0].pend_id[i] = 0;
        rq: [256] u8; k := f[0].pend_n[i];
        for j: 0..<k { rq[j] = f[0].pend_req[i * 256 + j]; }
        fl_spec_body(c, f, d, cast(string) rq[0..<k]);
      }
    }
    return;
  }
  if cdp_event_method(d) != "Fetch.requestPaused" { return; }
  p := jv_get(d, 0, "params"); rqn := jv_get(d, p, "request");
  ib: [256] u8; ub: [8192] u8; mb: [32] u8;
  idn := jv_str(d, jv_get(d, p, "requestId"), ib[..]);
  un := jv_str(d, jv_get(d, rqn, "url"), ub[..]);
  vn := jv_str(d, jv_get(d, rqn, "method"), mb[..]);
  if idn <= 0 { f[0].bad = true; return; }
  req := cast(string) ib[0..<idn];
  url := ifx un > 0 then cast(string) ub[0..<un] else "";
  verb := ifx vn > 0 then cast(string) mb[0..<vn] else "";
  path := fl_path(url);
  if jv_get(d, p, "responseStatusCode") >= 0 {
    // the response stage: only the spec stops here
    if path == FL_SPEC && jv_int(d, jv_get(d, p, "responseStatusCode"), 0) == 200 {
      for i: 0..<FL_PEND {
        if f[0].pend_id[i] == 0 {
          id := fl_on(c, "Fetch.getResponseBody", req);
          if id < 0 { f[0].bad = true; return; }
          f[0].pend_id[i] = id; f[0].pend_n[i] = idn;
          for j: 0..<idn { f[0].pend_req[i * 256 + j] = req[j]; }
          return;
        }
      }
      f[0].bad = true;
    }
    s4 := fl_on(c, "Fetch.continueRequest", req);
    return;
  }
  if fl_is_module(path) {
    if !fl_fulfill(c, f, req, 200, "application/wasm", cast(string) f[0].wasm[0..<f[0].wasm_n]) { f[0].bad = true; }
    f[0].served_wasm += 1;
    return;
  }
  if verb != "GET" && verb != "HEAD" && fl_starts(path, "/api/") {
    f[0].held_posts += 1;
    if !fl_fulfill(c, f, req, 204, "text/plain", "") { f[0].bad = true; }
    return;
  }
  if fl_starts(url, FL_HERE) {
    to: [1] FlBuf; fl_put(to[..], FL_ORIGIN); fl_put(to[..], url[FL_HERE.count..<url.count]);
    if to[0].bad || fl_onward(c, req, fl_text(to[..])) < 0 { f[0].bad = true; }
    return;
  }
  s5 := fl_on(c, "Fetch.continueRequest", req);
}
// Reads messages for ms, answering the page's requests.
fl_pump :: (c: [] Cdp, f: [] Flow, ms: int) {
  deadline := proc_now_ms() + ms;
  while true {
    left := proc_left(deadline, proc_now_ms());
    if left <= 0 { return; }
    k := cdp_poll(c, left);
    if k == CDP_GOT { fl_message(c, f); continue; }
    if k != CDP_NONE { f[0].bad = true; proc_sleep(left); }
    return;
  }
}
// A command and its reply's result node in cdp_doc, or -1; the page's requests are answered meanwhile.
fl_call :: (c: [] Cdp, f: [] Flow, method: string, params: string) -> int {
  id := cdp_send(c, method, params);
  if id < 0 { return -1; }
  deadline := proc_now_ms() + FL_MS;
  while true {
    k := cdp_poll(c, proc_left(deadline, proc_now_ms()));
    if k != CDP_GOT { return -1; }
    d := cdp_doc(c);
    if cdp_reply_id(d) == id { return cdp_reply_result(d); }
    fl_message(c, f);
  }
  return -1;
}
fl_eval :: (c: [] Cdp, f: [] Flow, expression: string) -> int {
  b: [8192] u8; o: [1] Jo; jo_start(o[..], b[..]);
  jo_obj(o[..]); jo_key(o[..], "expression"); jo_str(o[..], expression);
  jo_key(o[..], "awaitPromise"); jo_bool(o[..], true); jo_key(o[..], "returnByValue"); jo_bool(o[..], true); jo_end(o[..]);
  if o[0].bad { return -1; }
  r := fl_call(c, f, "Runtime.evaluate", jo_text(o[..]));
  if r < 0 { return -1; }
  return jv_path(cdp_doc(c), r, "result.value");
}

// ---- the page -------------------------------------------------------------------

// The edit layer's probe field (redit_probe), or -1 while the page isn't up.
fl_probe :: (c: [] Cdp, f: [] Flow, field: int) -> int {
  b: [1] FlBuf; fl_put(b[..], "globalThis.coaxial && coaxial.ready ? coaxial.guardProbe("); fl_int(b[..], 2400 + field); fl_put(b[..], ") : -1");
  v := fl_eval(c, f, fl_text(b[..]));
  return ifx v >= 0 then jv_int(cdp_doc(c), v, -1) else -1;
}
fl_view :: (c: [] Cdp, f: [] Flow) -> int { return fl_probe(c, f, FP_VIEW); }
// Waits up to ms for lo <= probe(field) <= hi.
fl_wait :: (c: [] Cdp, f: [] Flow, field: int, lo: int, hi: int, ms: int) -> bool {
  deadline := proc_now_ms() + ms;
  while true {
    v := fl_probe(c, f, field);
    if v >= lo && v <= hi { return true; }
    if proc_now_ms() >= deadline { return false; }
    fl_pump(c, f, 250);
  }
  return false;
}
fl_mouse :: (c: [] Cdp, f: [] Flow, kind: string, x: int, y: int) -> bool {
  b: [512] u8; o: [1] Jo; jo_start(o[..], b[..]);
  jo_obj(o[..]); jo_key(o[..], "type"); jo_str(o[..], kind); jo_key(o[..], "x"); jo_int(o[..], x); jo_key(o[..], "y"); jo_int(o[..], y);
  jo_key(o[..], "button"); jo_str(o[..], "left"); jo_key(o[..], "clickCount"); jo_int(o[..], 1); jo_end(o[..]);
  return fl_call(c, f, "Input.dispatchMouseEvent", jo_text(o[..])) >= 0;
}
// Clicks button b's middle; false while it isn't shown.
fl_tap :: (c: [] Cdp, f: [] Flow, b: int) -> bool {
  x0 := fl_probe(c, f, 4 * b); y0 := fl_probe(c, f, 4 * b + 1); x1 := fl_probe(c, f, 4 * b + 2); y1 := fl_probe(c, f, 4 * b + 3);
  if x0 < 0 { return false; }
  x := (x0 + x1) / 2; y := (y0 + y1) / 2;
  ok := fl_mouse(c, f, "mouseMoved", x, y) && fl_mouse(c, f, "mousePressed", x, y) && fl_mouse(c, f, "mouseReleased", x, y);
  fl_pump(c, f, 300);
  return ok;
}
fl_type :: (c: [] Cdp, f: [] Flow, text: string) -> bool {
  b: [4096] u8; o: [1] Jo; jo_start(o[..], b[..]);
  jo_obj(o[..]); jo_key(o[..], "text"); jo_str(o[..], text); jo_end(o[..]);
  ok := !o[0].bad && fl_call(c, f, "Input.insertText", jo_text(o[..])) >= 0;
  fl_pump(c, f, 200);
  return ok;
}
fl_key :: (c: [] Cdp, f: [] Flow, kind: string) -> bool {
  b: [256] u8; o: [1] Jo; jo_start(o[..], b[..]);
  jo_obj(o[..]); jo_key(o[..], "type"); jo_str(o[..], kind); jo_key(o[..], "key"); jo_str(o[..], "Enter");
  jo_key(o[..], "code"); jo_str(o[..], "Enter"); jo_key(o[..], "windowsVirtualKeyCode"); jo_int(o[..], 13); jo_end(o[..]);
  return fl_call(c, f, "Input.dispatchKeyEvent", jo_text(o[..])) >= 0;
}
fl_enter :: (c: [] Cdp, f: [] Flow) -> bool {
  ok := fl_key(c, f, "keyDown") && fl_key(c, f, "keyUp");
  fl_pump(c, f, 300);
  return ok;
}
fl_size :: (c: [] Cdp, f: [] Flow, w: int, h: int, mobile: bool) -> bool {
  b: [512] u8; o: [1] Jo; jo_start(o[..], b[..]);
  jo_obj(o[..]); jo_key(o[..], "width"); jo_int(o[..], w); jo_key(o[..], "height"); jo_int(o[..], h);
  jo_key(o[..], "deviceScaleFactor"); jo_int(o[..], 1); jo_key(o[..], "mobile"); jo_bool(o[..], mobile); jo_end(o[..]);
  return fl_call(c, f, "Emulation.setDeviceMetricsOverride", jo_text(o[..])) >= 0;
}
// Opens the realm and its COMPUTER pane.
fl_open :: (c: [] Cdp, f: [] Flow) -> bool {
  b: [1024] u8; o: [1] Jo; jo_start(o[..], b[..]);
  jo_obj(o[..]); jo_key(o[..], "url"); jo_str(o[..], cast(string) f[0].page[0..<f[0].page_n]); jo_end(o[..]);
  if fl_call(c, f, "Page.navigate", jo_text(o[..])) < 0 { return false; }
  fl_pump(c, f, 500);
  r1 := fl_wait(c, f, 4 * FB_EDIT, 0, 1000000, 45000);      // EDIT is up once the spec says we own it
  r2 := fl_tap(c, f, FB_EDIT);
  r3 := fl_wait(c, f, 4 * FB_CTAB, 0, 1000000, 5000);
  r4 := fl_tap(c, f, FB_CTAB);
  return fl_wait(c, f, FP_PANE, FL_COMPUTER_PANE, FL_COMPUTER_PANE, 10000) && fl_wait(c, f, FP_VIEW, 1, 99, 10000);
}
fl_shot :: (c: [] Cdp, f: [] Flow, dir: string, name: string) {
  if dir.count == 0 { return; }
  r := fl_call(c, f, "Page.captureScreenshot", "{\"format\":\"png\"}");
  d := cdp_doc(c);
  n := b64_decode(jv_raw(d, jv_get(d, r, "data")), f[0].png[..]);
  p: [2048] u8;
  file := fs_join(dir, name, p[..]);
  if r < 0 || n <= 0 || file.count == 0 || !fs_write(file, cast(string) f[0].png[0..<n]) { tool_err("computer-flow: the shot was not written: "); tool_errln(name); }
}

// ---- the computer ---------------------------------------------------------------

// coder host ARGS... from the repository's root: its exit status, stdout in f.out.
fl_coder :: (f: [] Flow, a1: string, a2: string, a3: string) -> int {
  argv: [5] string; n := 0;
  argv[n] = cast(string) f[0].coder[0..<f[0].coder_n]; n += 1;
  argv[n] = "host"; n += 1;
  if a1.count > 0 { argv[n] = a1; n += 1; }
  if a2.count > 0 { argv[n] = a2; n += 1; }
  if a3.count > 0 { argv[n] = a3; n += 1; }
  r := proc_run(argv[0..<n], 120000, f[0].out[..], f[0].err[..]);
  f[0].out_n = r.out_n;
  return ifx r.started == 0 && !r.timed_out then r.status else -1;
}
// From `coder host list --json`: how many wait (the first one's label and id kept in f), or with
// browsers, how many are allowed. -1 when it can't be read.
fl_listed :: (f: [] Flow, browsers: bool) -> int {
  if fl_coder(f, "list", "--json", "") != 0 { return -1; }
  nodes: [2048] JvNode; d: [1] Jv;
  if !jv_parse(d[..], cast(string) f[0].out[0..<f[0].out_n], nodes[..]) { return -1; }
  l := jv_get(d[0], 0, ifx browsers then "browsers" else "waiting");
  if jv_kind(d[0], l) != JV_ARRAY { return -1; }
  if !browsers && jv_len(d[0], l) > 0 {
    first := jv_at(d[0], l, 0);
    f[0].label_n = jv_str(d[0], jv_get(d[0], first, "label"), f[0].label[..]);
    f[0].ask_n = jv_str(d[0], jv_get(d[0], first, "id"), f[0].ask[..]);
  }
  return jv_len(d[0], l);
}
fl_wait_listed :: (c: [] Cdp, f: [] Flow, browsers: bool, lo: int, hi: int, ms: int) -> int {
  deadline := proc_now_ms() + ms;
  while true {
    n := fl_listed(f, browsers);
    if n >= lo && n <= hi { return n; }
    if proc_now_ms() >= deadline { return n; }
    fl_pump(c, f, 500);
  }
  return -1;
}

fl_check :: (f: [] Flow, name: string, ok: bool, seen: int) {
  if ok { print("  ok    %\n", name); return; }
  print("  FAIL  %  (saw %)\n", name, seen);
  f[0].failed += 1;
}

tool_main :: () -> int #export_c {
  a: [1] Args;
  loaded := args_load(a[..]);
  relay := args_at(a[..], 0); module := args_at(a[..], 1); shots := args_at(a[..], 2);
  if !loaded || !fl_relay_ok(relay) || module.count == 0 {
    tool_errln("usage: coax/web/tool.sh computer-flow ws://localhost:PORT MYREALM.wasm [SHOTS_DIR]   (CODER_HOME: the running host's)");
    return 2;
  }
  f: [1] Flow;
  f[0].wasm_n = fs_read(module, f[0].wasm[..]);
  if f[0].wasm_n <= 0 { tool_err("computer-flow: can't read the module (at most 4 MiB): "); tool_errln(module); return 2; }
  u: [1] FlBuf; fl_put(u[..], FL_HERE); fl_put(u[..], FL_PAGE); fl_put(u[..], relay);
  for i: 0..<u[0].n { f[0].page[i] = u[0].b[i]; } f[0].page_n = u[0].n;
  cwd: [1024] u8;
  root := fs_cwd(cwd[..]);
  cp := fs_join(root, "coder/tui/coder.sh", f[0].coder[..]); f[0].coder_n = cp.count;
  if root.count == 0 || !fs_exists(cp) { tool_errln("computer-flow: run it from the repository's root"); return 2; }

  // the key `coder host` prints, to paste
  npub: [128] u8; npub_n := 0;
  if fl_coder(f[..], "key", "", "") == 0 {
    text := cast(string) f[0].out[0..<f[0].out_n]; i := 0;
    while i < text.count {
      e := i; while e < text.count && text[e] != '\n' && text[e] != ' ' { e += 1; }
      word := text[i..<e];
      if fl_starts(word, "npub1") && word.count <= npub.count { for j: 0..<word.count { npub[j] = word[j]; } npub_n = word.count; }
      i = e + 1;
    }
  }
  fl_check(f[..], "coder host key gives the npub to paste", npub_n == 63, npub_n);
  key := cast(string) npub[0..<npub_n];

  c: [1] Cdp;
  if !cdp_launch(c[..], 1440, 900, "coax-computer-flow-") { tool_err("computer-flow: "); tool_errln(cdp_error(c[..])); return 1; }
  ck: [1024] u8; o: [1] Jo; jo_start(o[..], ck[..]);
  jo_obj(o[..]); jo_key(o[..], "name"); jo_str(o[..], "verse-automation"); jo_key(o[..], "value"); jo_str(o[..], "computer-flow");
  jo_key(o[..], "url"); jo_str(o[..], FL_HERE); jo_end(o[..]);
  armed := fl_call(c[..], f[..], "Network.setCookie", jo_text(o[..])) >= 0;
  patterns := "{\"patterns\":[{\"urlPattern\":\"*/api/playtest/realms/pine-forest*\",\"requestStage\":\"Response\"},{\"urlPattern\":\"*\",\"requestStage\":\"Request\"}]}";
  armed = armed && fl_call(c[..], f[..], "Fetch.enable", patterns) >= 0;
  // the test relay is on this machine (FL_LNA)
  for perm: FL_LNA {
    pb: [512] u8; po: [1] Jo; jo_start(po[..], pb[..]);
    jo_obj(po[..]); jo_key(po[..], "permissions"); jo_arr(po[..]); jo_str(po[..], perm); jo_end(po[..]); jo_key(po[..], "origin"); jo_str(po[..], FL_HERE); jo_end(po[..]);
    g := fl_call(c[..], f[..], "Browser.grantPermissions", jo_text(po[..]));   // a name this Chrome lacks is refused: fine
  }
  if !armed { tool_errln("computer-flow: the browser refused the request interception"); cdp_close(c[..]); return 1; }

  v := 0;
  sz := fl_size(c[..], f[..], 1440, 900, false);
  fl_check(f[..], "the owner opens EDIT > COMPUTER", fl_open(c[..], f[..]), fl_probe(c[..], f[..], FP_PANE));
  v = fl_view(c[..], f[..]);
  fl_check(f[..], "unpaired, it asks for the computer's key", v == RV_UNPAIRED_V, v);
  fl_shot(c[..], f[..], shots, "1-unpaired.png");
  t1 := fl_tap(c[..], f[..], FB_CFIELD);
  t2 := fl_type(c[..], f[..], key);
  t3 := fl_enter(c[..], f[..]);
  fl_check(f[..], "PAIR asks the computer: ALLOW THIS BROWSER", fl_wait(c[..], f[..], FP_VIEW, RV_ASKING_V, RV_ASKING_V, 5000), fl_view(c[..], f[..]));
  w := fl_wait_listed(c[..], f[..], false, 1, 1000, 20000);
  label := cast(string) f[0].label[0..<fl_hi0(f[0].label_n)];
  fl_check(f[..], "the computer has the ask, with this browser's name", w == 1 && (fl_has(label, "on Mac") || fl_has(label, "on Linux")), w);
  fl_shot(c[..], f[..], shots, "2-asking.png");
  ask := cast(string) f[0].ask[0..<fl_hi0(f[0].ask_n)];
  st := ifx ask.count >= 8 then fl_coder(f[..], "allow", ask[0..<8], "") else -1;
  fl_check(f[..], "coder host allow allows it", st == 0, st);
  fl_check(f[..], "the pane says allowed, and that the computer answers", fl_wait(c[..], f[..], FP_VIEW, RV_ALLOWED_V, RV_ALLOWED_V, 15000), fl_view(c[..], f[..]));
  fl_shot(c[..], f[..], shots, "3-allowed.png");

  t4 := fl_tap(c[..], f[..], FB_CMAIN);                    // TYPE A REQUEST
  t5 := fl_type(c[..], f[..], "add a red barn by the pines");
  t6 := fl_tap(c[..], f[..], FB_CMAIN);                    // SEND
  fl_check(f[..], "SEND makes it a job", fl_wait(c[..], f[..], FP_VIEW, RV_RUNNING_V, RV_DONE_V, 8000), fl_view(c[..], f[..]));
  ended := fl_wait(c[..], f[..], FP_VIEW, RV_STOPPED_V, RV_DONE_V, 60000);
  v = fl_view(c[..], f[..]);
  fl_check(f[..], "its steps come in and the job ends", ended && (v == RV_DONE_V || v == RV_FAILED_V), v);
  fl_shot(c[..], f[..], shots, "4-job.png");

  r1 := fl_open(c[..], f[..]);
  fl_check(f[..], "a reload keeps the pairing", fl_wait(c[..], f[..], FP_VIEW, RV_ALLOWED_V, RV_ALLOWED_V, 15000), fl_view(c[..], f[..]));

  sz = fl_size(c[..], f[..], 390, 844, true);
  phone := fl_open(c[..], f[..]) && fl_wait(c[..], f[..], FP_VIEW, RV_ALLOWED_V, RV_ALLOWED_V, 15000);
  fl_check(f[..], "on a phone width the pane opens", phone, fl_view(c[..], f[..]));
  fx0 := fl_probe(c[..], f[..], 4 * FB_CFORGET); fx1 := fl_probe(c[..], f[..], 4 * FB_CFORGET + 2);
  fl_check(f[..], "its controls fit the phone's width", fx0 >= 0 && fx1 <= 390, fx1);
  fl_shot(c[..], f[..], shots, "5-phone.png");

  t7 := fl_tap(c[..], f[..], FB_CFORGET); t8 := fl_tap(c[..], f[..], FB_CFORGET);   // FORGET THIS COMPUTER, SURE?
  fl_check(f[..], "FORGET takes it back to unpaired", fl_wait(c[..], f[..], FP_VIEW, RV_UNPAIRED_V, RV_UNPAIRED_V, 3000), fl_view(c[..], f[..]));
  left := fl_wait_listed(c[..], f[..], true, 0, 0, 15000);
  fl_check(f[..], "the computer no longer lists this browser", left == 0, left);
  cdp_close(c[..]);

  if f[0].bad { tool_errln("computer-flow: a page request was not answered as planned"); f[0].failed += 1; }
  print("module served % times, spec % times, % writes held in the browser\n", f[0].served_wasm, f[0].served_spec, f[0].held_posts);
  if f[0].failed > 0 { print("computer flow: % failed\n", f[0].failed); return 1; }
  print("computer flow: passed\n");
  return 0;
}
fl_hi0 :: (n: int) -> int { return ifx n > 0 then n else 0; }
