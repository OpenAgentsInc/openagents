// Build a PDF slide deck in the Grid style of openagents.com from a deck file.
//   coax/web/tool.sh deck DECK.deck OUT.pdf [--fresh]
// The deck is coax/lib/media/media.coax, which `openagents labs deck` uses
// too; the format is in docs/web/decks.md.
#import "Basic";
#load "../lib/media/media.coax";

tool_main :: () -> int #export_c {
  a: [1] Args;
  ok := args_load(a[..]);
  spec := args_at(a[..], 0); out := args_at(a[..], 1);
  if !ok || spec.count == 0 || out.count == 0 || spec[0] == '-' {
    tool_errln("usage: coax/web/tool.sh deck DECK.deck OUT.pdf [--fresh]");
    return 2;
  }
  d: [1] DkDeck;
  n := fs_read(spec, d[0].src[..]);
  if n < 0 { tool_err("deck: could not read "); tool_errln(spec); return 1; }
  d[0].n = n;
  if !dk_parse(d[..]) { tool_err("deck: "); tool_err(spec); tool_err(": "); tool_errln(dk_deck_error(d[..])); return 1; }
  dk_place(d[..]);
  db: [4096] u8; dir := dk_captures(spec, db[..]);
  if !fs_exists(dir) && !fs_mkdir(dir) { tool_err("deck: could not make "); tool_errln(dir); return 1; }
  sd := fs_dir(spec);
  pic: [1] DkPic; ch: [1] DkChrome;
  got := dk_pictures(d[..], dir, ifx sd.count > 0 then sd else ".", args_has(a[..], "--fresh"), ch[..], pic[..]);
  if ch[0].up { cdp_close(ch[0].c[..]); }
  if !got { return 1; }
  print("deck: % pictures taken, % kept from before\n", d[0].taken, d[0].kept);
  p: [1] DkPdf; o: [1] DkCs;
  if !dk_write_pdf(d[..], out, pic[..], p[..], o[..]) { return 1; }
  print("deck: % slides\n%\n", d[0].slide_n, out);
  return 0;
}
