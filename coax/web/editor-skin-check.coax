// The editor has no look of its own (GitHub #13416; docs/editor/2026-11-12-browser-editor.md):
// every piece of its UI is a component of the frames set (components/kit/) in the mono skin
// (components/skin/mono.coax), as the chat page is. This tool reads the editor's UI sources and
// fails when one of them
//   - names a colour (#rgb, #rrggbb, rgb(...), hsl(...)),
//   - names a size in a CSS unit (12px, 1.5em, 40vh ...),
//   - names a face or a weight (font-family, font-size, font-weight, font:, @font-face),
//   - writes a rule or a look of its own (the skin's CSS writer mc(...), a <style>, an element's
//     .style, className or classList, a style attribute), or
//   - loads a skin other than mono.
// What the editor's stylesheet is, and that every class it uses is one the skin has, is checked
// where the tree is built (metaverse-engine/editor/shell.coax, its checks).
//   coax/web/tool.sh editor-skin-check            (from the repository root)
//   coax/bin/coax test coax/web/editor-skin-check.coax --library
// A new editor UI file goes in ESC_FILES in the change that adds it.
#import "Basic";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";

ESC_FILES :: [5] string.[
  "metaverse-engine/editor/shell.coax",
  "metaverse-engine/editor/viewport.coax",
  "metaverse-engine/editor/shell-model.coax",
  "apps/openagents-web/editor-shell.coax",
  "apps/openagents-web/editor-shell-face.c"];
// The host's part: the lines of coax/web/host.js that open the shell and carry bytes to and from it.
ESC_HOST :: "coax/web/host.js";
ESC_HOST_FROM :: "// The editor shell (?edit";
ESC_HOST_TO :: "\nfunction send(";
ESC_BYTES :: 1048576;
ESC_UNITS :: [9] string.["px", "em", "rem", "vh", "vw", "pt", "ch", "dvh", "vmin"];
ESC_WORDS :: [18] string.["rgb(", "rgba(", "hsl(", "hsla(", "font-family", "font-size", "font-weight", "font:", "@font-face", "mc(", "<style", ".style.", ".style =", ".style=", ".style[", "className", "classList", "style="];

esc_hex :: (b: u8) -> bool { return (b >= '0' && b <= '9') || (b >= 'a' && b <= 'f') || (b >= 'A' && b <= 'F'); }
esc_alnum :: (b: u8) -> bool { return (b >= '0' && b <= '9') || (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_'; }
esc_at :: (text: string, i: int, word: string) -> bool { return i + word.count <= text.count && cast(string) text[i..<i + word.count] == word; }
// What is wrong at byte i of the text: 0 nothing, 1 a colour, 2 a size, 3 a face or a rule of its own, 4 another skin.
esc_fault :: (text: string, i: int) -> int {
  b := text[i];
  if b == '#' {
    n := 0;
    while i + 1 + n < text.count && esc_hex(text[i + 1 + n]) { n += 1; }
    after := i + 1 + n;
    if (n == 3 || n == 4 || n == 6 || n == 8) && (after >= text.count || !esc_alnum(text[after])) { return 1; }
  }
  // a number with a CSS unit close behind it
  if b >= '0' && b <= '9' && i + 1 < text.count && !(text[i + 1] >= '0' && text[i + 1] <= '9') && text[i + 1] != '.' {
    units := ESC_UNITS;
    for u: units {
      if esc_at(text, i + 1, u) && (i + 1 + u.count >= text.count || !esc_alnum(text[i + 1 + u.count])) { return 2; }
    }
  }
  words := ESC_WORDS;
  for w, k: words {
    if !esc_at(text, i, w) { continue; }
    // "mc(" is the skin's writer only as a call of its own, not the end of a longer name
    if w == "mc(" && i > 0 && esc_alnum(text[i - 1]) { continue; }
    return ifx k < 4 then 1 else 3;
  }
  if esc_at(text, i, "/skin/") && !esc_at(text, i, "/skin/mono.coax") { return 4; }
  return 0;
}
esc_why :: (fault: int) -> string {
  if fault == 1 { return "names a colour"; }
  if fault == 2 { return "names a size in a CSS unit"; }
  if fault == 3 { return "names a face or writes a look of its own"; }
  return "loads a skin other than mono";
}
// The first fault in a text: its byte, or -1.
esc_first :: (text: string) -> int {
  for i: 0..<text.count { if esc_fault(text, i) != 0 { return i; } }
  return -1;
}
esc_line :: (text: string, at: int) -> int {
  n := 1;
  for i: 0..<at { if text[i] == '\n' { n += 1; } }
  return n;
}
// The host's part of a script: from its opening comment to the next function after it ("" when it is not there).
esc_part :: (text: string, from: string, to: string) -> string {
  a := -1;
  for i: 0..<text.count { if esc_at(text, i, from) { a = i; break; } }
  if a < 0 { return ""; }
  for i: a..<text.count { if esc_at(text, i, to) { return text[a..<i]; } }
  return "";
}
esc_report :: (path: string, text: string, base: int) -> int {
  found := 0; i := 0;
  while i < text.count {
    f := esc_fault(text, i);
    if f == 0 { i += 1; continue; }
    print("%:% %\n", path, base + esc_line(text, i) - 1, esc_why(f));
    found += 1;
    while i < text.count && text[i] != '\n' { i += 1; }   // one report a line
  }
  return found;
}

#test "a colour, a size, a face, a rule of its own and another skin are each a fault; the kit's words are not" {
  #assert esc_first("tr_leaf(t, \"x\", TG_SPAN, \"meta\", \"No. 2\");") == -1;
  #assert esc_first("#load \"../../components/skin/mono.coax\";") == -1 && esc_first("#define EXPORT(name) x") == -1 && esc_first("#effects(all)") == -1;
  #assert esc_first("ES_INBOX :: 32768; step := 0.016; \"Turn 45\" 1.5 e 12 points") == -1 && esc_first("dm_style(d, css); stylesheet; the pane's styles") == -1;
  #assert esc_fault("color:#fff;", 6) == 1 && esc_fault("#0a0a0a ", 0) == 1 && esc_fault("x rgb(1,2,3)", 2) == 1 && esc_fault("hsl(0 0% 4%)", 0) == 1;
  #assert esc_fault("12px", 1) == 2 && esc_fault("1.5em;", 2) == 2 && esc_fault("40vh}", 1) == 2 && esc_fault("12 points", 1) == 0 && esc_fault("2emu", 0) == 0;
  #assert esc_fault("font-family:x", 0) == 3 && esc_fault("font:500 x", 0) == 3 && esc_fault("n = mc(out, n, x)", 4) == 3 && esc_fault("el.style.top", 2) == 3 && esc_fault("d[0].styled", 4) == 0 && esc_fault("el.style = x", 2) == 3 && esc_fault("root.className = x", 5) == 3;
  #assert esc_fault("dmc(x)", 1) == 0 && esc_fault("mono_css(out)", 0) == 0;
  other := "#load \"../../components/skin/metaverse.coax\";";
  #assert esc_first(other) > 0 && esc_fault(other, esc_first(other)) == 4;
  #assert esc_line("a\nb\nc", 4) == 3 && esc_why(2) == "names a size in a CSS unit";
  #assert esc_part("x // The editor shell (?edit a b\nfunction send(", ESC_HOST_FROM, ESC_HOST_TO) == "// The editor shell (?edit a b" && esc_part("nothing", ESC_HOST_FROM, ESC_HOST_TO) == "";
}

EscMain :: struct { raw: [ESC_BYTES] u8; }
tool_main :: () -> int #export_c #effects(all) {
  h: [1] EscMain; found := 0; files := ESC_FILES;
  for path: files {
    n := fs_read(path, h[0].raw[..]);
    if n <= 0 { tool_err("editor-skin-check: cannot read "); tool_errln(path); return 2; }
    found += esc_report(path, cast(string) h[0].raw[0..<n], 1);
  }
  n := fs_read(ESC_HOST, h[0].raw[..]);
  if n <= 0 { tool_errln("editor-skin-check: cannot read coax/web/host.js"); return 2; }
  whole := cast(string) h[0].raw[0..<n];
  part := esc_part(whole, ESC_HOST_FROM, ESC_HOST_TO);
  if part.count == 0 { tool_errln("editor-skin-check: coax/web/host.js has no editor shell part"); return 2; }
  at := 0;
  for i: 0..<whole.count { if esc_at(whole, i, ESC_HOST_FROM) { at = i; break; } }
  found += esc_report(ESC_HOST, part, esc_line(whole, at));
  if found > 0 { print("editor-skin-check: % places where the editor has a look of its own; every look is the mono skin's (components/skin/mono.coax)\n", found); return 1; }
  print("editor-skin-check: the editor's % files and the host's part name no colour, size or face and load only the mono skin\n", files.count);
  return 0;
}
