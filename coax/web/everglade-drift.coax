// Everglade's drift check (GitHub #12778, epic #12718): the same scripted session played offline and
// in a local room, side by side, frame by frame. Any difference in what the two pages draw fails it,
// with the probe that drifted, when and by how much. It runs on this machine only: its own room
// server, page server, network and bots, and two headless Chromes.
//   coax/web/tool.sh everglade-drift [--profiles local,100,250] [--bots 3] [--port 8960] [--no-raid] [--forest-only] [--offline worker|native] [--tick-us N] [--out DIR]
// --forest-only: rehearse a real tree fire with two pages in the same native room (#12940), as a
// separate bounded command so a new forest check need not repeat an unchanged gameplay/raid result.
// --input-only: check the synthetic key's DOM target against the accessibility event guard.
// --tick-us N adds an explicit p95 qualification gate for the offline host; defaults
// to reporting the product lifecycle budget without tightening its policy.
// --offline: the offline page on the room server's local host (worker, the default: ?offline=worker,
// #12784), or the native local room (native). The page's own offline game is gone (#12882).
// Before it: coax/web/room/build.sh (the room server, coax/web/room/bin/room) and the page
// (coax/remote/pages.sh origin/main for main's built pages, then coax/web/wasm.sh for
// build/everglade5e.wasm alone; it says so when the checkout has no built pages).
//
// What it starts (and stops), on PORT and the three after it, all on 127.0.0.1:
//   - the room server (coax/web/room/bin/room --dev coax/web/room/dev: the world the page reads too),
//     with a seat-ticket key made up here and its control lines from a file this check writes
//     (pvp on, levels off, so the room's bar is the whole bar, as offline);
//   - the page server (coax/web/serve.sh --static --api ROOM);
//   - for each network profile, the network between the room page and the room
//     (coax/web/room/net-proxy.coax): local is none, 100 and 250 are that round trip with 30 ms of
//     jitter and 2% of reads lost; and BOTS players in the room (coax/web/room/drift-bots.coax).
// The session, sent to both pages at the same moments, each press at the same step of both pages
// (dr_both: so both rooms hear the same inputs, #12893) (the room page at ?relay=ws://localhost:PROXY&room=pair-drift-N: the page takes
// only a localhost relay):
//   start, crate (W into the crate the world puts 1.5 m ahead of the spawn), strafe (W and A: along
//   it), walk, jump, rg (Reverse Gravity from the bar, 5, and again to end it), wos (Wall of Stone,
//   Shift+1), ww (Wind Wall, 6), held (Hold Person on you and the townsperson nearest you, one scripted
//   spell on both pages: dr_hold; then W, which mustn't move you), folk (standing, the town's people
//   walking), end.
// Then the raid (unless --no-raid): the offline page's preview raid (?raid=preview) and the room's
// own (the siege on the south road at size 8, Darian at his camp, harm on, levels on to cap 2, reward
// 300%: #12860) with raid-check.coax's bots fighting at the front; the room page holds at the spawn, on
// the front's road, and casts Starry Wisp at the nearest raider. Both pages' stables
// must fall, and the room page's LEVEL plate must climb from LEVEL 1 to LEVEL 2 with its bar.
//
// The probes (coax/web/everglade-drift.js notes them every frame: everglade-net.coax net_probe 45 to
// 62, 400+, 600+, everglade5e-face.c coaxial_field_probe and coaxial_drift_text), each compared
// both ways within a window: a frame of one page fails when no frame of the other within WINDOW ms
// (250 plus the round trip; the town's conditions a lost read's resend more, DrProbe) has the same
// value, within the probe's tolerance. A probe drifts when
// DR_RUN frames fail in a row. Some are judged on each page alone: the camera's turn in one frame
// (DR_YAW_JUMP) and in DR_TURN_MS with no look (DR_TURN), the room's corrections (re-runs that moved you more than 5 cm: at most DR_FIX_RATE a
// second, none over 0.5 m), and the town's people (walking in place: a walking clip drawn where it
// was the frame before, on no more than DR_STALL more of the frames than offline).
// Output: one line per probe and profile, a table, and holds or fails (exit 0 or 1). The rows, both
// pages' screenshots as each step ends (shot-PROFILE-STEP-offline.png, -room.png), when each press
// reached each page (keys-PROFILE-offline.txt, -room.txt) and the servers' logs go to DIR (default
// coax/web/build/everglade-drift/STAMP). The offline page's room host says the stalls that dropped its
// beat, and room.log oa-room's ("a stall of"): a town a stall set back is not the two simulations parting.
#import "Basic";
#load "../lib/net/cdp.coax";
#load "../../aethyr/session/lifecycle.coax";   // each host's room tick budget (#12856)
#load "../../aethyr/net/record.coax";
#load "drift-hold.coax";
#load "drift-placement.coax";   // with Everglade's named points (verse/everglade/points.coax, #13078)
#load "map-points.coax";
#load "../../aethyr/render/tests/qualification-files.coax";
getpriority :: (which:s32,who:u32)->s32 #foreign #effects(all);

DR_JS_COLS :: 32;         // everglade-drift.js D.cols
DR_COLS :: 35;            // those, then C_LX, C_LZ and C_ST (dr_local)
DR_ROWS :: 20000;         // frames kept a page (5 minutes at 60 a second)
DR_PART :: 300;           // rows read back at once
// book:begin drift-bounds
DR_RUN :: 6;              // frames failing in a row that make a drift
DR_YAW_JUMP :: 300;       // mrad the camera may turn in one frame
DR_TURN :: 175;           // mrad (10 degrees) the camera may turn in DR_TURN_MS with no look (a pointer move): only
DR_TURN_MS :: 1000;       // your look turns it (aethyr/cam/camera.coax verse_orbit_follow), so this is rounding room
DR_FIX_RATE :: 1;         // corrections over 5 cm a second, at most
DR_STALL :: 15;           // percent more frames of the town's people walking in place than offline
// book:end drift-bounds
DR_MARKS :: 32;
DR_TEXTS :: 256;
DR_PROFILES :: 6;
DR_INPUTS :: 8192;
DrInputs :: struct {seen:[DR_INPUTS]bool;v:[DR_INPUTS*6]int;bad:bool;origin:int=-1;}
#test "drift input comparison distinguishes unequal scripts, missing sequences and changed resends" {
  a:[1]DrInputs;b:[1]DrInputs;
  dr_input_note(a[..],100,"I 101 0 1000 0 0 0 0 3");
  dr_input_note(b[..],200,"I 201 0 1000 0 0 0 0 8");
  #assert dr_inputs_same(a[..],b[..],1);
  dr_input_note(a[..],100,"I 102 1000 1000 0 0 0 0 3");
  dr_input_note(b[..],200,"I 202 0 1000 0 0 0 0 8");
  #assert !dr_inputs_same(a[..],b[..],2);
  dr_input_note(a[..],100,"I 103 0 1000 0 0 0 0 3");
  #assert !dr_inputs_same(a[..],b[..],3);
  dr_input_note(a[..],100,"I 101 1 1000 0 0 0 0 3");#assert a[0].bad;
  b[0]=DrInputs.{};dr_input_note(b[..],200,"I 201 0 1");#assert b[0].bad;
  #assert !dr_inputs_same(a[..],b[..],0);
}
dr_input_note :: (v:[]DrInputs,origin:int,text:string) {
  r:=net_record_read(text);
  if !r.ok || r.head!='I' || r.n!=8 {v[0].bad=true;return;}
  seq:=r.v[0]-origin;if seq<=0 {return;}
  if seq>=DR_INPUTS {v[0].bad=true;return;}
  for f:0..<6 {
    if v[0].seen[seq] && v[0].v[seq*6+f]!=r.v[1+f] {v[0].bad=true;}
    v[0].v[seq*6+f]=r.v[1+f];
  }
  v[0].seen[seq]=true;
}
dr_inputs_same :: (a:[]DrInputs,b:[]DrInputs,end:int)->bool {
  if a[0].bad || b[0].bad || end<1 || end>=DR_INPUTS {return false;}
  n:=0;
  for seq:1..<end+1 {
    if a[0].seen[seq]!=b[0].seen[seq] {return false;}
    if !a[0].seen[seq] {continue;} // casts and other commands legitimately occupy sequence numbers
    n+=1;for f:0..<6 {if a[0].v[seq*6+f]!=b[0].v[seq*6+f] {return false;}}
  }
  return n>0;
}
dr_input_pull :: (c:[]Cdp,v:[]DrInputs,path:string)->bool {
  origin:=dr_int(c,"__dr.origin",-1);if origin<0 || dr_int(c,"__dr.inputOverflow ? 1:0",1)!=0 {return false;}
  v[0].origin=origin;
  buf:[1048576]u8;text:=dr_str(c,"__dr.inputs.join('\\n')",buf[..]);
  header:[1]Buf;bput(header[..],"# origin ");bint(header[..],origin);bput(header[..],"\n");
  saved:=fs_write(path,btext(header[..])) && fs_append(path,text);if !saved || text.count==0 {return false;}
  at:=0;
  while at<text.count {end:=at;while end<text.count && text[end]!='\n' {end+=1;}dr_input_note(v,origin,text[at..<end]);at=end+1;}
  return !v[0].bad;
}
// the columns
C_T :: 0; C_X :: 2; C_Y :: 3; C_Z :: 4; C_YAW :: 5; C_LIFT :: 6; C_RERUNS :: 7; C_FIX :: 8; C_SPRITES :: 9;
C_RG :: 10; C_WW :: 11; C_WOS :: 12; C_SPELLS :: 13; C_BAR :: 14; C_COND :: 15; C_SCOND :: 16; C_OCOND :: 17;
C_FCOND :: 18; C_ECOND :: 19; C_SDOWN :: 20; C_SALL :: 21; C_ACT :: 22; C_CLIP :: 23; C_NET :: 24;
C_WALK :: 25; C_STALL :: 26; C_MOVED :: 27; C_FACE :: 28; C_SYAW :: 29; C_LOOK :: 30; C_STEP :: 31; C_LX :: 32; C_LZ :: 33; C_ST :: 34;

Buf :: struct { b: [16384] u8; n: int; bad: bool; }
bput :: (o: [] Buf, s: string) {
  if o[0].n + s.count > o[0].b.count { o[0].bad = true; return; }
  for k: 0..<s.count { o[0].b[o[0].n + k] = s[k]; }
  o[0].n += s.count;
}
bint :: (o: [] Buf, v: int) {
  if v < 0 { bput(o, "-"); bint(o, -v); return; }
  d: [20] u8; n := 0; x := v;
  if x == 0 { d[0] = '0'; n = 1; }
  while x > 0 { d[n] = cast(u8) ('0' + x % 10); x /= 10; n += 1; }
  for k: 0..<n { e: [1] u8; e[0] = d[n - 1 - k]; bput(o, cast(string) e[..]); }
}
btext :: (o: [] Buf) -> string { return cast(string) o[0].b[0..<o[0].n]; }

// One page's record: its rows, its marks (name, first row, wall ms) and its words as they changed.
DrMark :: struct { name: [24] u8; name_n: int; row: int; t: int; step: int; }
DrText :: struct { t: int; which: int; text: [160] u8; n: int; }
DR_FOLK :: 47; DR_FACTS :: 256;
DrFolk :: struct { t: int; lo: int; hi: int; cond: [DR_FOLK] int; }
DrPage :: struct {
  rows: [DR_ROWS * DR_COLS] int; n: int;
  marks: [DR_MARKS] DrMark; marks_n: int;
  texts: [DR_TEXTS] DrText; texts_n: int;
  facts: [DR_FACTS] DrFolk; facts_n: int;
  hold_from: int = -1; hold_to: int = -1;   // the hold's length, not compared (dr_hold_window)
}
dr_at :: (p: [] DrPage, r: int, c: int) -> int { return p[0].rows[r * DR_COLS + c]; }
dr_mark_name :: (p: [] DrPage, k: int) -> string { return cast(string) p[0].marks[k].name[0..<p[0].marks[k].name_n]; }
// The step a wall time falls in ("" before the first mark).
dr_step_at :: (p: [] DrPage, t: int) -> string {
  name := "";
  for k: 0..<p[0].marks_n { if p[0].marks[k].t <= t { name = dr_mark_name(p, k); } }
  return name;
}
dr_mark_t :: (p: [] DrPage, name: string) -> int { for k: 0..<p[0].marks_n { if dr_mark_name(p, k) == name { return p[0].marks[k].t; } } return -1; }

// A probe: a column (or two for the feet), how far apart two values may be, and how it is compared.
DR_EXACT :: 0; DR_NEAR :: 1; DR_SHARE :: 2; DR_ANGLE :: 3; DR_PLACE :: 4; DR_ON :: 5;
// lossy: what the room decides and the page only hears (the town's conditions), judged within a lost
// read's resend more: a read lost on the way holds every read after it for TCP's resend (net-proxy.coax:
// two round trips, 200 ms at least), so the room's word on it comes that much later, and no page can
// draw it before it comes (#12890). The page draws those conditions as their row comes, unbuffered.
// Each probe is compared on two clocks: the wall's, and the pages' steps (C_ST). Each press goes in at
// one step of both pages (dr_both), and a page that stalls a moment draws every step after it that
// much later: in a raid run the room page stalled 400 ms as the session began, and ran 380 ms behind
// the offline page from then on, step for step the same. What your presses make (your place, camera,
// lift, the abilities you cast, shown at your press) lines up by step; what the room decides (the
// town) lines up by the wall. A frame holds when it matches on either clock (#12778).
DrProbe :: struct { name: string; col: int; how: int; tol: int; from: string; lossy: bool; }
// The verdict on one probe: whether it drifted, the first frame that did (wall ms and its step),
// the values there and the smallest difference the window had.
DrVerdict :: struct { drifted: bool; t: int; step: string; mine: int; other: int; by: int; frames: int; note: [200] u8; note_n: int; }

dr_diff :: (how: int, a: int, b: int, a2: int, b2: int) -> int {
  if how == DR_ANGLE {
    d := a - b; while d > 3142 { d -= 6283; } while d < -3142 { d += 6283; }
    return ifx d < 0 then -d else d;
  }
  if how == DR_PLACE { dx := f64(a - b); dz := f64(a2 - b2); return cast(int) sqrt(dx * dx + dz * dz); }
  if how == DR_ON { return ifx (a > 0) == (b > 0) then 0 else 1; }
  d := a - b; return ifx d < 0 then -d else d;
}
dr_tol :: (pr: DrProbe, a: int, b: int) -> int {
  if pr.how == DR_SHARE { m := ifx a > b then a else b; t := m * 35 / 100; return ifx t > pr.tol then t else pr.tol; }
  if pr.how == DR_EXACT || pr.how == DR_ON { return 0; }
  return pr.tol;
}
// Frame r of page a against page b's frames within `window` ms: the smallest difference, and whether
// one was within the tolerance (closest b value in *other).
dr_match :: (pr: DrProbe, a: [] DrPage, r: int, b: [] DrPage, window: int, lo: int, other: [] int, tc: int) -> int {
  t := dr_at(a, r, tc);
  va := dr_at(a, r, pr.col); va2 := ifx pr.how == DR_PLACE then dr_at(a, r, pr.col + ifx pr.col == C_X then 2 else 1) else 0;
  best := 1000000000; k := lo;
  while k < b[0].n && dr_at(b, k, tc) < t - window { k += 1; }
  while k < b[0].n && dr_at(b, k, tc) <= t + window {
    vb := dr_at(b, k, pr.col); vb2 := ifx pr.how == DR_PLACE then dr_at(b, k, pr.col + ifx pr.col == C_X then 2 else 1) else 0;
    d := dr_diff(pr.how, va, vb, va2, vb2);
    // a value that moves fast (a fall, a lift) passes between two of b's frames: b had it then. Two
    // pages draw at their own instants, and under load a frame is 50-80 ms, so a fall at 4 cm/ms
    // moves past the tolerance between frames (#12887). Not the counts (tolerance 0): they step
    if pr.how == DR_NEAR && pr.tol > 0 && k > 0 && dr_at(b, k - 1, tc) >= t - window {
      vp := dr_at(b, k - 1, pr.col);
      if (vp <= va && va <= vb) || (vb <= va && va <= vp) { d = 0; }
    }
    if d < best { best = d; other[0] = vb; }
    if d <= dr_tol(pr, va, vb) { return -1; }
    k += 1;
  }
  return best;
}
// One way (a's frames against b's) of a probe, from wall ms t0 to t1.
dr_way :: (pr: DrProbe, a: [] DrPage, b: [] DrPage, window: int, t0: int, t1: int, v: [] DrVerdict) {
  run := 0; lo := 0; ls := 0;
  for r: 0..<a[0].n {
    t := dr_at(a, r, C_T);
    if t < t0 || t > t1 { continue; }
    if pr.col == C_COND && t >= a[0].hold_from && t <= a[0].hold_to { continue; }
    while lo < b[0].n && dr_at(b, lo, C_T) < t - window { lo += 1; }
    while ls < b[0].n && dr_at(b, ls, C_ST) < dr_at(a, r, C_ST) - window { ls += 1; }
    other: [1] int; other2: [1] int;
    by := dr_match(pr, a, r, b, window, lo, other[..], C_T);
    if by >= 0 { by2 := dr_match(pr, a, r, b, window, ls, other2[..], C_ST); if by2 < by { by = by2; other[0] = other2[0]; } }
    if by < 0 { run = 0; continue; }
    run += 1; v[0].frames += 1;
    if run == DR_RUN && !v[0].drifted {
      first := r - DR_RUN + 1;
      v[0].drifted = true; v[0].t = dr_at(a, first, C_T); v[0].step = dr_step_at(a, v[0].t);
      v[0].mine = dr_at(a, first, pr.col); v[0].other = other[0]; v[0].by = by;
    }
  }
}
dr_folk_present :: (f: DrFolk, i: int) -> bool {
  return ifx i < 24 then (f.lo & (1 << i)) != 0 else (f.hi & (1 << (i - 24))) != 0;
}
DrFolkMatch :: struct { seen: bool; ok: bool; other: int; }
dr_folk_match :: (b: [] DrPage, i: int, t: int, window: int, want: int) -> DrFolkMatch {
  out: DrFolkMatch;
  for f: 0..<b[0].facts_n {
    at := b[0].facts[f];
    until := ifx f + 1 < b[0].facts_n then b[0].facts[f + 1].t else ifx b[0].n > 0 then dr_at(b, b[0].n - 1, C_T) + 1 else at.t;
    if at.t > t + window || until <= t - window || !dr_folk_present(at, i) { continue; }
    out.seen = true; out.other = at.cond[i];
    if at.cond[i] == want { out.ok = true; return out; }
  }
  return out;
}
dr_folk_way :: (a: [] DrPage, b: [] DrPage, window: int, t0: int, t1: int, v: [] DrVerdict) {
  if a[0].facts_n < 1 || b[0].facts_n < 1 { v[0].drifted = true; v[0].step = "missing person observations"; return; }
  run: [DR_FOLK] int; fact := 0; conditioned := false;
  for r: 0..<a[0].n {
    t := dr_at(a, r, C_T); if t < t0 || t > t1 { continue; }
    while fact + 1 < a[0].facts_n && a[0].facts[fact + 1].t <= t { fact += 1; }
    at := a[0].facts[fact]; if at.t > t { continue; }
    for i: 0..<DR_FOLK {
      if !dr_folk_present(at, i) { run[i] = 0; continue; }
      match := dr_folk_match(b, i, t, window, at.cond[i]);
      if !match.seen || match.ok { run[i] = 0; if match.ok && at.cond[i] != 0 { conditioned = true; } continue; }
      run[i] += 1; v[0].frames += 1;
      if run[i] == DR_RUN && !v[0].drifted {
        v[0].drifted = true; v[0].t = t; v[0].step = dr_step_at(a, t); v[0].mine = at.cond[i]; v[0].other = match.other;
        note: [1] Buf; bput(note[..], "person "); bint(note[..], i); bput(note[..], " has condition bits "); bint(note[..], at.cond[i]); bput(note[..], " versus "); bint(note[..], match.other);
        for k: 0..<note[0].n { v[0].note[k] = note[0].b[k]; } v[0].note_n = note[0].n;
      }
    }
  }
  if !conditioned && !v[0].drifted { v[0].drifted = true; v[0].t = t0; v[0].step = "no shared conditioned person"; }
}
#test "conditions compare the same people rather than counting an out-of-view guard" {
  a: [1] DrPage; b: [1] DrPage;
  a[0].n = 8; b[0].n = 8; a[0].facts_n = 1; b[0].facts_n = 1;
  a[0].facts[0] = DrFolk.{t = 0, lo = 1}; a[0].facts[0].cond[0] = 18432;
  b[0].facts[0] = DrFolk.{t = 0, lo = 1, hi = 1024}; b[0].facts[0].cond[0] = 18432; b[0].facts[0].cond[34] = 18432;
  for r: 0..<8 {
    a[0].rows[r * DR_COLS + C_T] = 1000 + r * 33; b[0].rows[r * DR_COLS + C_T] = 1000 + r * 33;
    a[0].rows[r * DR_COLS + C_ST] = 1000 + r * 33; b[0].rows[r * DR_COLS + C_ST] = 1000 + r * 33;
    a[0].rows[r * DR_COLS + C_FCOND] = 1; b[0].rows[r * DR_COLS + C_FCOND] = 2;
  }
  v: [1] DrVerdict; dr_folk_way(a[..], b[..], 50, 1000, 1300, v[..]);
  #assert !v[0].drifted;
  b[0].facts[0].cond[0] = 256;
  v[0] = DrVerdict.{}; dr_folk_way(a[..], b[..], 50, 1000, 1300, v[..]);
  #assert v[0].drifted && v[0].mine == 18432 && v[0].other == 256;
  // Equal totals cannot hide conditions swapped between two visible people.
  a[0].facts[0].lo = 3; a[0].facts[0].cond[1] = 256;
  b[0].facts[0].lo = 3; b[0].facts[0].cond[1] = 18432;
  for r: 0..<8 { a[0].rows[r * DR_COLS + C_FCOND] = 2; b[0].rows[r * DR_COLS + C_FCOND] = 2; }
  v[0] = DrVerdict.{}; dr_folk_way(a[..], b[..], 50, 1000, 1300, v[..]);
  #assert v[0].drifted;
  #assert !dr_folk_match(b[..], 0, 1232, 0, 256).seen;
  a[0].facts[0].cond[0] = 0; a[0].facts[0].cond[1] = 0;
  b[0].facts[0].cond[0] = 0; b[0].facts[0].cond[1] = 0;
  v[0] = DrVerdict.{}; dr_folk_way(a[..], b[..], 50, 1000, 1300, v[..]);
  #assert v[0].drifted && v[0].step == "no shared conditioned person";
}

// The session's script: each step's name, then its keys. Both pages get each at once.
dr_key_js :: (q: [] Buf, down: bool, key: string, code: string, vk: int, shift: bool) {
  // Real key events target a Node. Window is not a valid argument to the accessibility root's
  // contains(), and its listener throws before forwarding a synthetic Window event to the game.
  bput(q, "(document.querySelector('canvas') || document.body).dispatchEvent(new KeyboardEvent('"); bput(q, ifx down then "keydown" else "keyup");
  bput(q, "', {key: '"); bput(q, key); bput(q, "', code: '"); bput(q, code); bput(q, "', keyCode: "); bint(q, vk);
  bput(q, ifx shift then ", shiftKey: true" else ""); bput(q, ", bubbles: true}))");
}
dr_press :: (c: [] Cdp, down: bool, key: string, code: string, vk: int, shift: bool) -> bool {
  q: [1] Buf;
  dr_key_js(q[..], down, key, code, vk, shift); bput(q[..], "; 1");
  return dr_int(c, btext(q[..]), 0) == 1;
}
dr_int :: (c: [] Cdp, js: string, fallback: int) -> int {
  v := cdp_evaluate(c, js);
  return ifx v >= 0 then jv_int(cdp_doc(c), v, fallback) else fallback;
}
// Exercise the browser's event target and the accessibility guard together. This catches the
// Window target failure even when two motionless pages would otherwise compare equal.
dr_input_check :: () -> bool {
  c: [1] Cdp; ok := false;
  if !cdp_launch_background(c[..], 128, 128, "coax-drift-input-") { return false; }
  setup := dr_int(c[..], "(() => { const root=document.createElement('div'), canvas=document.createElement('canvas'); document.body.append(root,canvas); globalThis.__drInput={errors:0,forwarded:0}; addEventListener('error',e=>{__drInput.errors++;e.preventDefault();}); addEventListener('keydown',e=>{if(root.contains(e.target))return;__drInput.forwarded++;}); dispatchEvent(new KeyboardEvent('keydown',{key:'d',bubbles:true})); return __drInput.errors===1 && __drInput.forwarded===0 ? 1 : 0; })()", 0);
  if setup == 1 {
    q: [1] Buf; dr_key_js(q[..], true, "d", "KeyD", 68, false);
    bput(q[..], "; __drInput.errors===1 && __drInput.forwarded===1 ? 1 : 0");
    ok = dr_int(c[..], btext(q[..]), 0) == 1;
  }
  cdp_close(c[..]);
  print("drift input event target: %\n", ifx ok then "holds" else "fails");
  return ok;
}
dr_str :: (c: [] Cdp, js: string, out: [] u8) -> string {
  v := cdp_evaluate(c, js);
  if v < 0 { return ""; }
  n := jv_str(cdp_doc(c), v, out);
  return ifx n > 0 then cast(string) out[0..<n] else "";
}
// ctl: the room's control file (the held step's scripted Hold Person); room: the room page's room
// code; worker: the offline page plays on the local host (?offline=worker)
// at: the step the last press went in at (dr_both); empty, each page takes a press as it comes
DrPair :: struct { a: [] Cdp; b: [] Cdp; shots: string; ctl: string; room: int; worker: bool; native: bool; at: [] int; hold_target:[]int; }
DR_SHOT :: 8388608;
// Both pages as they look now, into SHOTS-NAME-offline.png and -room.png (no SHOTS: none).
dr_shots :: (p: DrPair, name: string) {
  if p.shots.count == 0 { return; }
  png: [DR_SHOT] u8;
  for s: 0..<2 {
    q: [1] Buf; bput(q[..], p.shots); bput(q[..], "-"); bput(q[..], name); bput(q[..], ifx s == 0 then "-offline.png" else "-room.png");
    n := cdp_screenshot(ifx s == 0 then p.a else p.b, png[..]);
    if n > 0 { _ := fs_write(btext(q[..]), cast(string) png[0..<n]); }
  }
}
// A press on both pages at one step of each (everglade-drift.js __dr.at, #12893): DR_AHEAD steps past
// the later page's step now, and after the last press's, so the two rooms hear the same inputs.
DR_AHEAD :: 3;
#test "paired events share a future input step and never overtake an earlier event" {
  #assert dr_target(10,12,0)==15 && dr_target(12,10,0)==15;
  #assert dr_target(10,12,16)==17 && dr_target(0,0,0)==3;
}
dr_target :: (a:int,b:int,previous:int)->int {
  t:=(ifx a>b then a else b)+DR_AHEAD;return ifx t<=previous then previous+1 else t;
}
dr_both :: (p: DrPair, down: bool, key: string, code: string, vk: int, shift: bool) {
  sa := dr_int(p.a, "__dr.sstep()", -1); sb := dr_int(p.b, "__dr.sstep()", -1);
  if p.at.count == 0 || sa < 0 || sb < 0 { _ := dr_press(p.a, down, key, code, vk, shift); _ = dr_press(p.b, down, key, code, vk, shift); return; }
  t := dr_target(sa,sb,p.at[0]);
  p.at[0] = t;
  for side: 0..<2 {
    q: [1] Buf; bput(q[..], "__dr.at("); bint(q[..], t); bput(q[..], ", () => "); dr_key_js(q[..], down, key, code, vk, shift); bput(q[..], ")");
    _ := dr_int(ifx side == 0 then p.a else p.b, btext(q[..]), 0);
  }
}
dr_both_key :: (p: DrPair, down: bool, key: string, code: string, vk: int) { dr_both(p, down, key, code, vk, false); }
dr_tap :: (p: DrPair, key: string, code: string, vk: int) {
  dr_tap_shift(p,key,code,vk,false);
}
dr_tap_shift :: (p:DrPair,key:string,code:string,vk:int,shift:bool) {
  dr_both(p, true, key, code, vk,shift);
  // A slow rendered frame can drain both queued edges before any input step
  // sees the key. Observe the press through a step on both pages first.
  if p.at.count>0 {
    target:=p.at[0]+1;deadline:=proc_now_ms()+2000;seen:=false;
    while !seen && proc_now_ms()<deadline {
      seen=dr_int(p.a,"__dr.sstep()",-1)>=target && dr_int(p.b,"__dr.sstep()",-1)>=target;
      if !seen {proc_sleep(10);}
    }
    #assert seen;
  }
  proc_sleep(80);dr_both(p, false, key, code, vk,shift);
}
dr_mark :: (p: DrPair, name: string) {
  if p.shots.count > 0 && name != "start" && name != "raid" { dr_shots(p, name); }
  q: [1] Buf;
  sa:=dr_int(p.a,"__dr.sstep()",-1);sb:=dr_int(p.b,"__dr.sstep()",-1);
  scheduled:=name!="start" && p.at.count>0 && sa>=0 && sb>=0;
  if scheduled {t:=dr_target(sa,sb,p.at[0]);p.at[0]=t;bput(q[..],"__dr.at(");bint(q[..],t);bput(q[..],",()=>");}
  bput(q[..], "__dr.mark('"); bput(q[..], name); bput(q[..], "')");if scheduled {bput(q[..],")");}
  _ := dr_int(p.a, btext(q[..]), 0); _ = dr_int(p.b, btext(q[..]), 0);
  print("  step %\n", name);
}
dr_wait_end :: (p: DrPair) -> bool {
  deadline := proc_now_ms() + 5000;
  while proc_now_ms() < deadline {
    a := dr_int(p.a, "__dr.marks.some(m=>m[0]==='end') ? 1:0", 0);
    b := dr_int(p.b, "__dr.marks.some(m=>m[0]==='end') ? 1:0", 0);
    if a == 1 && b == 1 { return true; }
    proc_sleep(25);
  }
  tool_errln("everglade-drift: an end mark was scheduled but never observed on both pages"); return false;
}

// The held step starts the original nearest-person hold in the online room.
// Observe its unique present target, then name that person in the offline
// development host. Both apply the existing 3 s player and 6 s NPC holds.
// The verdict requires the same actual person before comparing conditions;
// independent nearest-person selection can choose different living people.
DR_HELD :: "((__dr.probe(52) & 3) || __dr.probe(53) > 0) ? 1 : 0";
dr_held_move_ms :: () -> int { return 500; }
// Publish a complete control answer; native hosts watch this rename immediately.
dr_control_write :: (path:string,text:string)->bool {
  temporary:[1]Buf;bput(temporary[..],path);bput(temporary[..],".next");
  if temporary[0].bad || !fs_write(btext(temporary[..]),text) {return false;}
  return fs_rename(btext(temporary[..]),path);
}
#test "the held movement attempt ends before either three-second hold expires" {
  // Even a delayed receipt leaves room for this attempt. Do not compare free walking across
  // two independently delivered releases as if it were an identical input interval.
  #assert dr_held_move_ms() <= 500 && dr_held_move_ms() > 0;
}
dr_hold :: (p: DrPair) {
  took := false; tries := 0; asked := 0; stamp := 0;
  while tries < 3 && !took {
    if proc_now_ms() - asked > 6500 {
      seat := dr_int(p.b, "__dr.probe(1)", -1);
      stamp = proc_now_ms(); asked = stamp; tries += 1;
      c: [1] Buf; bput(c[..], DR_CONTROL_PAIR); bput(c[..], "hold pair-drift-"); bint(c[..], p.room); bput(c[..], " "); bint(c[..], seat); bput(c[..], " "); bint(c[..], stamp); bput(c[..], "\n");
      _ := dr_control_write(p.ctl, btext(c[..]));
    }
    took = dr_int(p.b, DR_HELD, 0) == 1;
    if !took { proc_sleep(20); }
  }
  person:= -1;deadline:=proc_now_ms()+2000;
  while took && person<0 && proc_now_ms()<deadline {person=dr_hold_person(p.b);if person<0 {proc_sleep(20);}}
  if person<0 {_:=dr_control_write(p.ctl,DR_CONTROL_PAIR);print("  scripted hold: no unique visible target on the room page\n");return;}
  q:[1]Buf;held:=0;
  if p.native {
    bput(q[..],DR_CONTROL_PAIR);bput(q[..],"hold-person local-1 ");bint(q[..],dr_int(p.a,"__dr.probe(1)",-1));bput(q[..]," ");bint(q[..],stamp+1);bput(q[..]," ");bint(q[..],person);bput(q[..],"\n");
    if dr_control_write(p.ctl,btext(q[..])) {held=1;}
  } else {
    bput(q[..],"coaxial.roomHost.control('hold-person local-1 ' + __dr.probe(1) + ' ");bint(q[..],stamp+1);bput(q[..]," ");bint(q[..],person);bput(q[..],"\\n')");
    held=dr_int(p.a,btext(q[..]),0);
  }
  w := proc_now_ms();
  while held==1 && (dr_int(p.a,DR_HELD,0)!=1 || dr_hold_person(p.a)!=person) && proc_now_ms()-w<2000 {proc_sleep(20);}
  held = dr_int(p.a, DR_HELD, 0);
  actual:=dr_hold_person(p.a);
  if took && held==1 && actual==person && p.hold_target.count==1 {p.hold_target[0]=person;}
  print("  scripted Hold Person target: room %, offline %\n",person,actual);
  _ := dr_control_write(p.ctl, DR_CONTROL_PAIR);
  if !took { print("  (the room page was never held: % asks)\n", tries); }
  if held != 1 { print("  (the offline page did not take the hold: %)\n", held); }
}
// Read actual condition/presence words; target selection stays in Coax.
dr_hold_person :: (c:[]Cdp)->int #effects(all) {
  value:=cdp_evaluate(c,"Array.from({length:47},(_,i)=>[__dr.probe(700+i)===1,__dr.x.coaxial_field_probe(__dr.state,100+i)])");
  if value<0 {return -1;}d:=cdp_doc(c);if jv_len(d,value)!=DRH_FOLK {return -1;}
  bits:[DRH_FOLK]int;present:[DRH_FOLK]bool;
  for i:0..<DRH_FOLK {row:=jv_at(d,value,i);if jv_len(d,row)!=2 {return -1;}present[i]=jv_bool(d,jv_at(d,row,0));bits[i]=jv_int(d,jv_at(d,row,1),-1);if bits[i]<0 {return -1;}}
  return drh_person(bits[..],present[..]);
}

dr_rg_margin :: (x: int, z: int, nx: int, nz: int) -> bool {
  return dr_diff(DR_PLACE, x, nx * 10, z, nz * 10) <= 14740;
}
#test "the gravity rehearsal rejects a townsperson at the radius edge" {
  #assert !dr_rg_margin(-15530, -56700, -191, -6347);
  #assert dr_rg_margin(-11030, -56700, -191, -6347);
  #assert dr_rg_margin(0, 0, 1474, 0) && !dr_rg_margin(0, 0, 1475, 0);
}
dr_rg_patrols :: (x: int, z: int) -> bool {
  // Independent fixture points in cm: EG_SPOT[0..1] and VIA_BRAM/VIA_TILDA in routines.coax.
  // A circle is convex, so containing every endpoint contains both complete straight-leg beats.
  points := [14] int.[-450, -5950, -200, -6200, -150, -7050, 450, -5950, 220, -5920, 180, -5200, 180, -4500];
  for i: 0..<7 { if !dr_rg_margin(x, z, points[i * 2], points[i * 2 + 1]) { return false; } }
  return true;
}
#test "gravity rehearsal clears the lintel and contains both loose stable props with margin" {
  #assert drp_road_at(drp_test_map(),1500,-58800) && dr_rg_patrols(1500,-58800);
  // A convex circle contains the whole admitted rectangle when all four
  // corners fit. Raw observed stable props: meshes 31/32 at these cm.
  for x:[2]int.[500,2500] {for z:[2]int.[-58000,-59500] {
    #assert dr_rg_margin(x,z,1240,-6480) && dr_rg_margin(x,z,782,-6900);
  }}
}
#test "gravity placement contains both complete patrols, not only Bram's current point" {
  #assert !dr_rg_patrols(-6300, -60450);   // Tilda's Inn Street endpoint leaves the cylinder
  #assert !dr_rg_patrols(-15530, -56700);  // Bram's road endpoint leaves it
  #assert dr_rg_patrols(-6300, -56700) && dr_rg_patrols(0,-56800) && dr_rg_patrols(-300,-56800);
  #assert !dr_rg_patrols(6300,-55300) && !dr_rg_patrols(-6300,-55300); // the opposite gate post misses Bram's road endpoint
}
// The route's holds are wall-clock: on a loaded machine (the 100 ms profile of a room deploy, #13070)
// it can end a metre off the admitted rectangle. Short strafes, the same on both pages at the same
// steps (dr_both), bring both into its middle (x 0.8 to 2.2 m from the South Gate's gap, z 2.3 to
// 3.2 m past it: -58.3 to -59.2 m on 11-09) by their places.
dr_rg_nudge :: (g: DrMap, x: int, z: int) -> int {
  if x < g.gx + 800 { return 3; } if x > g.gx + 2200 { return 2; }
  if z > g.gz - 2300 { return 0; } if z < g.gz - 3200 { return 1; }
  return -1;
}
#test "the gravity rehearsal's settle strafes into the rectangle's middle and stops there (#13070)" {
  g := drp_test_map();
  #assert dr_rg_nudge(g, -80, -58800) == 3 && dr_rg_nudge(g, 2600, -58800) == 2;
  #assert dr_rg_nudge(g, 1500, -57900) == 0 && dr_rg_nudge(g, 1500, -59400) == 1;
  #assert dr_rg_nudge(g, 1140, -58680) == -1;
  for x: [2]int.[800, 2200] { for z: [2]int.[-58300, -59200] { #assert drp_road_at(g, x, z); } }
}
dr_rg_settle :: (p: DrPair) {
  g := dr_map();
  keys := [4] string.["w", "s", "a", "d"]; codes := [4] string.["KeyW", "KeyS", "KeyA", "KeyD"]; vks := [4] int.[87, 83, 65, 68];
  for attempt: 0..<16 {
    proc_sleep(300);
    k := -1;
    for side: 0..<2 {
      c := ifx side == 0 then p.a else p.b;
      x := dr_int(c, "__dr.x.coaxial_field_probe(__dr.state,0)", -999999);
      z := dr_int(c, "__dr.x.coaxial_field_probe(__dr.state,2)", -999999);
      if x == -999999 || z == -999999 { return; }
      if k < 0 { k = dr_rg_nudge(g, x, z); }
    }
    if k < 0 { return; }
    dr_both_key(p, true, keys[k], codes[k], vks[k]); proc_sleep(120); dr_both_key(p, false, keys[k], codes[k], vks[k]);
  }
}
dr_rg_ready :: (c: [] Cdp) -> bool {
  x := dr_int(c, "__dr.x.coaxial_field_probe(__dr.state,0)", -999999);
  z := dr_int(c, "__dr.x.coaxial_field_probe(__dr.state,2)", -999999);
  nx := dr_int(c, "__dr.probe(600)", 999999); nz := dr_int(c, "__dr.probe(601)", 999999);
  tx := dr_int(c, "__dr.probe(603)", 999999); tz := dr_int(c, "__dr.probe(604)", 999999);
  print("  gravity placement: you %,% mm, Bram %,% cm, Tilda %,% cm\n", x, z, nx, nz, tx, tz);
  return drp_road(x,z) && dr_rg_patrols(x, z) && dr_rg_margin(x, z, nx, nz) && dr_rg_margin(x, z, tx, tz) && dr_int(c, "__dr.probe(700)===1 && __dr.probe(701)===1 ? 1:0", 0) == 1;
}
#test "the rehearsal explicitly faces north from either initial camera heading" {
 #assert dr_north_drag(0)== -571 && dr_north_drag(3142)==0 && dr_north_drag(-3142)==0;
 for yaw:-3142..<3143 {px:=dr_north_drag(yaw);after:=yaw-px*11/2;delta:=3142-after;while delta>3142 {delta-=6284;}while delta< -3142 {delta+=6284;}#assert delta>= -6 && delta<=6;}
}
dr_north_drag :: (yaw:int)->int {
 delta:=3142-yaw;while delta>3142 {delta-=6284;}while delta< -3142 {delta+=6284;}
 return -delta*2/11; // actual LOOK_DRAG = 0.0055 radians per CSS pixel
}
dr_face_north :: (c:[]Cdp)->bool {
 for attempt:0..<3 {
  yaw:=dr_int(c,"__dr.probe(60)",-999999);if yaw== -999999 {return false;}
  dx:=dr_north_drag(yaw);if dx==0 {return true;}
  for phase:0..<3 {
   buf:[512]u8;o:[1]Jo;jo_start(o[..],buf[..]);jo_obj(o[..]);
   jo_key(o[..],"type");jo_str(o[..],[3]string.["mousePressed","mouseMoved","mouseReleased"][phase]);
   jo_key(o[..],"x");jo_int(o[..],640+(ifx phase==0 then 0 else dx));jo_key(o[..],"y");jo_int(o[..],250);
   jo_key(o[..],"button");jo_str(o[..],"left");jo_key(o[..],"buttons");jo_int(o[..],ifx phase==2 then 0 else 1);jo_key(o[..],"clickCount");jo_int(o[..],1);jo_end(o[..]);
   if cdp_call(c,"Input.dispatchMouseEvent",jo_text(o[..]),CDP_CALL_MS)<0 {return false;}
   proc_sleep(30);
  }
  proc_sleep(150);
 }
 return false;
}
dr_script :: (p: DrPair, dir: string) -> bool {
  if !dr_face_north(p.a) || !dr_face_north(p.b) {tool_errln("drift: camera did not face the north rehearsal route");return false;}
  dr_mark(p, "start");
  dr_both_key(p, true, "Escape", "Escape", 27); dr_both_key(p, false, "Escape", "Escape", 27);
  proc_sleep(1500);
  dr_mark(p, "crate");
  dr_both_key(p, true, "w", "KeyW", 87); proc_sleep(2500);
  dr_mark(p, "strafe");
  dr_both_key(p, true, "a", "KeyA", 65); proc_sleep(3000); dr_both_key(p, false, "a", "KeyA", 65);
  dr_mark(p, "walk"); proc_sleep(2500);
  dr_mark(p, "jump");
  dr_tap(p, " ", "Space", 32); proc_sleep(1800); dr_both_key(p, false, "w", "KeyW", 87); proc_sleep(1200);
  // Clear the front of the gate towers, cross to the open road, then enter
  // the arch. The palisade/post corners are solid; approaching at x=+/-6.3
  // leaves Bram's complete patrol outside the gravity cylinder.
  dr_both_key(p,true,"s","KeyS",83);proc_sleep(300);dr_both_key(p,false,"s","KeyS",83);
  dr_both_key(p,true,"d","KeyD",68);proc_sleep(2000);dr_both_key(p,false,"d","KeyD",68);
  dr_both_key(p,true,"w","KeyW",87);proc_sleep(500);dr_both_key(p,false,"w","KeyW",87);proc_sleep(500);
  // Clear the lintel before rising, and keep the stable props well inside
  // the field instead of clipping their centers at its 15.24 m boundary.
  dr_both_key(p,true,"w","KeyW",87);proc_sleep(300);dr_both_key(p,false,"w","KeyW",87);
  dr_both_key(p,true,"d","KeyD",68);proc_sleep(200);dr_both_key(p,false,"d","KeyD",68);proc_sleep(500);
  dr_rg_settle(p);
  dr_mark(p, "rg");
  rg_ready := dr_rg_ready(p.a); rg_ready_b := dr_rg_ready(p.b);
  // a round (6 s) between casts: the rules' one action a round
  dr_tap(p, "5", "Digit5", 53); proc_sleep(6000); dr_tap(p, "5", "Digit5", 53); proc_sleep(6500);
  dr_mark(p, "wos");
  dr_tap_shift(p,"!","Digit1",49,true);proc_sleep(6500);
  // a step aside first, so the Wind Wall (4 m ahead) isn't laid into the Wall of Stone
  dr_both_key(p, true, "a", "KeyA", 65); proc_sleep(1500); dr_both_key(p, false, "a", "KeyA", 65); proc_sleep(500);
  dr_mark(p, "ww");
  dr_tap(p, "6", "Digit6", 54); proc_sleep(6500);
  dr_mark(p, "held");
  dr_hold(p);
  dr_both_key(p, true, "w", "KeyW", 87); proc_sleep(dr_held_move_ms()); dr_both_key(p, false, "w", "KeyW", 87); proc_sleep(4000);
  dr_mark(p, "folk"); proc_sleep(6000);
  dr_mark(p, "end"); marked := dr_wait_end(p);
  return rg_ready && rg_ready_b && marked;
}

// The page's record back from the browser.
dr_pull :: (c: [] Cdp, pg: [] DrPage, folk: bool) -> bool {
  n := dr_int(c, "__dr.count()", -1);
  if n < 0 { return false; }
  if n > DR_ROWS { n = DR_ROWS; }
  pg[0].n = 0;
  at := 0;
  while at < n {
    k := ifx n - at > DR_PART then DR_PART else n - at;
    q: [1] Buf; bput(q[..], "__dr.rows("); bint(q[..], at); bput(q[..], ", "); bint(q[..], k); bput(q[..], ")");
    v := cdp_evaluate(c, btext(q[..]));
    if v < 0 { return false; }
    d := cdp_doc(c);
    e := d.nodes[v].first; i := 0;
    while e != -1 && i < k * DR_JS_COLS { pg[0].rows[(at + i / DR_JS_COLS) * DR_COLS + i % DR_JS_COLS] = jv_int(d, e, 0); i += 1; e = d.nodes[e].next; }
    at += k;
  }
  pg[0].n = n;
  pg[0].facts_n = 0;
  if folk {
    if dr_int(c, "__dr.factsOverflow ? 1 : 0", 1) != 0 { return false; }
    fv := cdp_evaluate(c, "__dr.facts");
    if fv < 0 { return false; }
    fd := cdp_doc(c); fe := fd.nodes[fv].first;
    while fe != -1 && pg[0].facts_n < DR_FACTS {
      f := pg[0].facts[pg[0].facts_n..<pg[0].facts_n + 1];
      f[0].t = jv_int(fd, jv_at(fd, fe, 0), -1); f[0].lo = jv_int(fd, jv_at(fd, fe, 1), 0); f[0].hi = jv_int(fd, jv_at(fd, fe, 2), 0);
      bits := jv_at(fd, fe, 3);
      for i: 0..<DR_FOLK { f[0].cond[i] = jv_int(fd, jv_at(fd, bits, i), -1); if f[0].cond[i] < 0 { return false; } }
      pg[0].facts_n += 1; fe = fd.nodes[fe].next;
    }
    if fe != -1 || pg[0].facts_n < 1 { return false; }
  }
  v := cdp_evaluate(c, "__dr.marks");
  if v >= 0 {
    d := cdp_doc(c); e := d.nodes[v].first; pg[0].marks_n = 0;
    while e != -1 && pg[0].marks_n < DR_MARKS {
      m := pg[0].marks[pg[0].marks_n..<pg[0].marks_n + 1];
      m[0].name_n = jv_str(d, jv_at(d, e, 0), m[0].name[..]); m[0].row = jv_int(d, jv_at(d, e, 1), 0); m[0].t = jv_int(d, jv_at(d, e, 2), 0);
      m[0].step = jv_int(d, jv_at(d, e, 3), -1);
      pg[0].marks_n += 1; e = d.nodes[e].next;
    }
  }
  if dr_mark_t(pg, "end") < 0 { return false; }
  v = cdp_evaluate(c, "__dr.texts.slice(-256)");
  if v >= 0 {
    d := cdp_doc(c); e := d.nodes[v].first; pg[0].texts_n = 0;
    while e != -1 && pg[0].texts_n < DR_TEXTS {
      x := pg[0].texts[pg[0].texts_n..<pg[0].texts_n + 1];
      x[0].t = jv_int(d, jv_at(d, e, 0), 0); x[0].which = jv_int(d, jv_at(d, e, 1), 0); x[0].n = jv_str(d, jv_at(d, e, 2), x[0].text[..]);
      if x[0].n < 0 { x[0].n = 0; }
      pg[0].texts_n += 1; e = d.nodes[e].next;
    }
  }
  return true;
}

// Words (0 the LEVEL plate, 1 the status lines) page a had at wall ms t.
dr_text_at :: (a: [] DrPage, which: int, t: int) -> string {
  s := "";
  for k: 0..<a[0].texts_n { x := a[0].texts[k]; if x.which == which && x.t <= t { s = cast(string) a[0].texts[k].text[0..<x.n]; } }
  return s;
}
// The words one way: every change of page a's (and each 500 ms while held) must be page b's within window.
dr_text_way :: (a: [] DrPage, b: [] DrPage, which: int, window: int, t0: int, t1: int, v: [] DrVerdict) {
  for k: 0..<a[0].texts_n {
    x := a[0].texts[k];
    if x.which != which || x.t < t0 || x.t > t1 { continue; }
    if which == 1 && x.t >= a[0].hold_from && x.t <= a[0].hold_to { continue; }
    want := cast(string) a[0].texts[k].text[0..<x.n];
    ok := false;
    t := x.t - window;
    while t <= x.t + window && !ok { if dr_text_at(b, which, t) == want { ok = true; } t += 16; }
    if ok || v[0].drifted { continue; }
    v[0].drifted = true; v[0].t = x.t; v[0].step = dr_step_at(a, x.t);
    got := dr_text_at(b, which, x.t);
    q: [1] Buf; bput(q[..], "\""); bput(q[..], want); bput(q[..], "\" against \""); bput(q[..], got); bput(q[..], "\"");
    n := ifx q[0].n < 200 then q[0].n else 200;
    for i: 0..<n { v[0].note[i] = q[0].b[i]; } v[0].note_n = n;
  }
}

DrResult :: struct { name: string; v: DrVerdict; }
DR_PROBES :: 64;
DrReport :: struct { r: [DR_PROBES] DrResult; n: int; overflow:bool; }
#test "a drift report cannot silently omit an overflowing required probe" {
  r:[1]DrReport;
  for i:0..<DR_PROBES {dr_add(r[..],"recorded",DrVerdict.{});}
  #assert r[0].n==DR_PROBES && !r[0].overflow;
  dr_add(r[..],"must not disappear",DrVerdict.{drifted=true});
  #assert r[0].overflow && r[0].n==DR_PROBES;
}
#test "the report retains every gameplay and raid verdict including late failures" {
  report:[1]DrReport;
  for i:0..<40 {dr_add(report[..],"probe",DrVerdict.{drifted=i==39});}
  #assert report[0].n==40;
  last:=report[0].n-1;#assert report[0].r[last].v.drifted;
}
dr_add :: (rep: [] DrReport, name: string, v: DrVerdict) {
  #assert rep[0].n>=0;
  if rep[0].n>=DR_PROBES {rep[0].overflow=true;return;}
  rep[0].r[rep[0].n] = DrResult.{name = name, v = v}; rep[0].n += 1;
}


// Where you are in your own heading (C_LX, C_LZ, mm): what you moved since the step began, turned by
// the camera's yaw that frame. Your keys move you by the camera, and the two browsers get each key
// in turn, so one page's camera can come to rest a frame's turn (about 13 mrad) from the other's;
// over a 26 m walk that alone opens 36 cm between the places. In each page's own heading the
// walks agree; a real snap shows in the corrections.
// A step begins at one page step on both pages (C_STEP, since the start mark): the later of the two
// pages' steps at its mark, moved on to the first step both pages drew a frame at. The driver marks
// the two pages one after the other, and their steps run on their own clocks, so a mark falls a few
// steps apart on the two: with W held that began the walk 406 mm apart, and where the walk then
// stopped at a wall the two stood "406 mm" apart, wherever they stood (#12778).
dr_first_at :: (p: [] DrPage, step: int) -> int {
  for r: 0..<p[0].n { if dr_at(p, r, C_STEP) >= step { return r; } }
  return -1;
}
dr_begin :: (a: [] DrPage, b: [] DrPage, k: int, out: [] int) -> bool {
  name := dr_mark_name(a, k); j := -1;
  for i: 0..<b[0].marks_n { if dr_mark_name(b, i) == name { j = i; } }
  if j < 0 || a[0].marks[k].step < 0 || b[0].marks[j].step < 0 { return false; }
  s := ifx a[0].marks[k].step > b[0].marks[j].step then a[0].marks[k].step else b[0].marks[j].step;
  for tries: 0..<60 {
    ra := dr_first_at(a, s); rb := dr_first_at(b, s);
    if ra < 0 || rb < 0 { return false; }
    sa := dr_at(a, ra, C_STEP); sb := dr_at(b, rb, C_STEP);
    if sa == sb { out[0] = ra; out[1] = rb; return true; }
    s = ifx sa > sb then sa else sb;
  }
  return false;
}
#test "shared movement origins preserve real gaps and do not invent one after convergence" {
  a:[1]DrPage;b:[1]DrPage;
  for side:0..<2 {
    p:=ifx side==0 then a[..] else b[..];p[0].n=2;p[0].marks_n=1;
    for ch,i:"start" {p[0].marks[0].name[i]=ch;}p[0].marks[0].name_n=5;p[0].marks[0].t=1000;
    for i:0..<2 {p[0].rows[i*DR_COLS+C_T]=1000+33*i;p[0].rows[i*DR_COLS+C_STEP]=i;}
    p[0].rows[DR_COLS+C_X]=1000;
  }
  b[0].rows[C_X]=400;dr_local(a[..],b[..]);
  #assert a[0].rows[DR_COLS+C_LX]==b[0].rows[DR_COLS+C_LX];
  #assert b[0].rows[C_LX]-a[0].rows[C_LX]==400;
}
dr_local :: (a: [] DrPage, b: [] DrPage) {
  if a[0].n<1 || b[0].n<1 {return;}
  // each page's rows that begin a step, in order (one marks; -1 a mark with no shared step: its wall moment)
  ba: [DR_MARKS] int; bb: [DR_MARKS] int;
  for k: 0..<DR_MARKS { ba[k] = -1; bb[k] = -1; }
  for k: 0..<a[0].marks_n {
    rr: [2] int;
    if dr_begin(a, b, k, rr[..]) {
      name := dr_mark_name(a, k);
      ba[k] = rr[0];
      for i: 0..<b[0].marks_n { if dr_mark_name(b, i) == name { bb[i] = rr[1]; } }
    }
  }
  // Both recordings use one physical origin per phase. Subtracting each
  // page's own rendered position hides an existing gap, then invents the
  // opposite gap when the players converge at a wall.
  oa:[DR_MARKS]int;ob:[DR_MARKS]int;
  for k:0..<a[0].marks_n {
    source:=ifx ba[k]>=0 then ba[k] else a[0].marks[k].row;
    if source<0 {source=0;}if source>=a[0].n {source=a[0].n-1;}
    oa[k]=source;
    for i:0..<b[0].marks_n {if dr_mark_name(a,k)==dr_mark_name(b,i) {ob[i]=source;}}
  }
  // each frame's step as a time (C_ST): the offline page's start mark, and a step every 1/30 s after it
  base := dr_mark_t(a, "start");
  for side: 0..<2 {
    p := ifx side == 0 then a else b;
    for r: 0..<p[0].n {
      st := dr_at(p, r, C_STEP);
      p[0].rows[r * DR_COLS + C_ST] = ifx st >= 0 && base >= 0 then base + st * 1000 / 30 else dr_at(p, r, C_T);
    }
  }
  for side: 0..<2 {
    p := ifx side == 0 then a else b;
    m := 0;
    for r: 0..<p[0].n {
      t := dr_at(p, r, C_T);
      for k: 0..<p[0].marks_n {
        at := ifx side == 0 then ba[k] else bb[k];
        origin:=ifx side==0 then oa[k] else ob[k];
        if at >= 0 { if at == r { m = origin; } }
        else if p[0].marks[k].t <= t && (r == 0 || p[0].marks[k].t > dr_at(p, r - 1, C_T)) { m = origin; }
      }
      dx := f64(dr_at(p, r, C_X) - dr_at(a, m, C_X)); dz := f64(dr_at(p, r, C_Z) - dr_at(a, m, C_Z));
      th := f64(dr_at(p, r, C_YAW)) / 1000.0;
      p[0].rows[r * DR_COLS + C_LX] = cast(int) (dx * cos(th) - dz * sin(th));
      p[0].rows[r * DR_COLS + C_LZ] = cast(int) (dx * sin(th) + dz * cos(th));
    }
  }
}

#test "movement coverage rejects idle recordings and measures only the requested interval" {
  p: [1] DrPage; p[0].n = 3;
  p[0].rows[C_T] = 0; p[0].rows[DR_COLS + C_T] = 1000; p[0].rows[2 * DR_COLS + C_T] = 2000;
  #assert dr_movement(p[..], 0, 2000) == 0;
  p[0].rows[DR_COLS + C_X] = 4000; p[0].rows[DR_COLS + C_Z] = 3000;
  p[0].rows[2 * DR_COLS + C_X] = 4000; p[0].rows[2 * DR_COLS + C_Z] = 3000;
  #assert dr_movement(p[..], 0, 2000) == 5000;
  #assert dr_movement(p[..], 1000, 2000) == 0;
  #assert dr_movement(p[..], 3000, 4000) == 0;
}
dr_movement :: (p: [] DrPage, t0: int, t1: int) -> int {
  first := -1; most := 0;
  for r: 0..<p[0].n {
    t := dr_at(p, r, C_T); if t < t0 || t > t1 { continue; }
    if first < 0 { first = r; }
    d := dr_diff(DR_PLACE, dr_at(p, r, C_X), dr_at(p, first, C_X), dr_at(p, r, C_Z), dr_at(p, first, C_Z));
    if d > most { most = d; }
  }
  return most;
}
dr_town_fell :: (p: [] DrPage, t0: int, t1: int) -> bool {
  if t0 < 0 || t1 <= t0 { return false; }
  for r: 0..<p[0].n {
    if dr_at(p, r, C_T) >= t0 && dr_at(p, r, C_T) < t1 && dr_at(p, r, C_FCOND) > 0 { return true; }
  }
  return false;
}
#test "the gravity rehearsal requires a condition before the scripted Hold Person" {
  p: [1] DrPage; p[0].n = 2;
  p[0].rows[C_T] = 1000; p[0].rows[DR_COLS + C_T] = 3000;
  #assert !dr_town_fell(p[..], 1000, 2000);
  p[0].rows[DR_COLS + C_FCOND] = 1;
  #assert !dr_town_fell(p[..], 1000, 2000);
  p[0].rows[C_FCOND] = 1;
  #assert dr_town_fell(p[..], 1000, 2000) && !dr_town_fell(p[..], -1, 2000);
}

#test "the jump rehearsal requires an observed rise inside its own phase" {
  p:[1]DrPage;p[0].n=3;
  for i:0..<3 {p[0].rows[i*DR_COLS+C_T]=(i+1)*1000;p[0].rows[i*DR_COLS+C_LIFT]=28;}
  #assert dr_jump_rise(p[..],1000,3000)==0;
  p[0].rows[DR_COLS+C_LIFT]=138;
  #assert dr_jump_rise(p[..],1000,3000)==110;
  #assert dr_jump_rise(p[..],1000,1500)==0 && dr_jump_rise(p[..],-1,3000)==0;
}
dr_jump_rise :: (p:[]DrPage,t0:int,t1:int)->int {
  if t0<0 || t1<=t0 {return 0;}first:= -1;rise:=0;
  for r:0..<p[0].n {
    t:=dr_at(p,r,C_T);if t<t0 || t>=t1 {continue;}
    if first<0 {first=r;}
    d:=dr_at(p,r,C_LIFT)-dr_at(p,first,C_LIFT);if d>rise {rise=d;}
  }
  return rise;
}

// Every probe of the paired session, offline (a) against the room (b) and back.
dr_compare :: (a: [] DrPage, b: [] DrPage, rtt: int, rep: [] DrReport, worker: bool) {
  window := 250 + rtt;
  dr_local(a, b);
  t0 := dr_mark_t(a, "start"); t1 := dr_mark_t(a, "end");
  if t0 < 0 || t1 < 0 { t0 = 0; t1 = 1 << 50; }
  // Comparing two idle pages can agree perfectly while no key reached either game.
  // The crate/strafe/walk steps must move both players before the scripted hold.
  {
    ma := dr_movement(a, t0, dr_mark_t(a, "held")); mb := dr_movement(b, dr_mark_t(b, "start"), dr_mark_t(b, "held"));
    v := DrVerdict.{drifted = ma < 3000 || mb < 3000, mine = ma, other = mb, by = 3000};
    dr_add(rep, "movement inputs took effect (mm)", v);
  }
  {
    ja:=dr_jump_rise(a,dr_mark_t(a,"jump"),dr_mark_t(a,"rg"));
    jb:=dr_jump_rise(b,dr_mark_t(b,"jump"),dr_mark_t(b,"rg"));
    dr_add(rep,"jump inputs took effect (cm)",DrVerdict.{drifted=ja<50 || jb<50,mine=ja,other=jb,by=50});
  }
  probes := [16] DrProbe.[
    DrProbe.{name = "position (in your heading, since the step)", col = C_LX, how = DR_PLACE, tol = 350},
    DrProbe.{name = "camera heading", col = C_YAW, how = DR_ANGLE, tol = 200},
    DrProbe.{name = "lift height", col = C_LIFT, how = DR_NEAR, tol = 50},
    DrProbe.{name = "Reverse Gravity shown", col = C_RG, how = DR_ON},
    DrProbe.{name = "Reverse Gravity particles", col = C_RG, how = DR_SHARE, tol = 12},
    DrProbe.{name = "Wind Wall shown", col = C_WW, how = DR_ON},
    DrProbe.{name = "Wind Wall particles", col = C_WW, how = DR_SHARE, tol = 12},
    DrProbe.{name = "Wall of Stone shown", col = C_WOS, how = DR_ON},
    DrProbe.{name = "Wall of Stone panels", col = C_WOS, how = DR_NEAR, tol = 0},
    DrProbe.{name = "spell and condition particles", col = C_SPELLS, how = DR_SHARE, tol = 20},
    DrProbe.{name = "hotbar slots", col = C_BAR, how = DR_EXACT},
    DrProbe.{name = "condition on you", col = C_COND, how = DR_EXACT},
    DrProbe.{name = "condition on others", col = C_OCOND, how = DR_EXACT},
    DrProbe.{name = "conditions on the town's people", col = C_FCOND, how = DR_NEAR, tol = 0, lossy = true},
    DrProbe.{name = "your engine conditions", col = C_ECOND, how = DR_EXACT},
    DrProbe.{name = "stables down", col = C_SDOWN, how = DR_NEAR, tol = 0},
  ];
  // a lost read's resend (coax/web/room/net-proxy.coax np_due); the local profile loses none
  resend := ifx rtt <= 0 then 0 else ifx 2 * rtt > 200 then 2 * rtt else 200;
  for pr: probes {
    win := window + (ifx pr.lossy then resend else 0);
    v: [1] DrVerdict;
    if pr.col == C_FCOND { dr_folk_way(a, b, win, t0, t1, v[..]); }
    else { dr_way(pr, a, b, win, t0, t1, v[..]); }
    w: [1] DrVerdict;
    if pr.col == C_FCOND { dr_folk_way(b, a, win, t0, t1, w[..]); }
    else { dr_way(pr, b, a, win, t0, t1, w[..]); }
    // the room's side drifting first is said as the room's value against offline's
    if w[0].drifted && (!v[0].drifted || w[0].t < v[0].t) { x := w[0]; x.mine = w[0].other; x.other = w[0].mine; x.frames += v[0].frames; v[0] = x; }
    else { v[0].frames += w[0].frames; }
    dr_add(rep, pr.name, v[0]);
  }
  for which: 0..<2 {
    v: [1] DrVerdict;
    dr_text_way(a, b, which, window + 500, t0, t1, v[..]);
    if !v[0].drifted { dr_text_way(b, a, which, window + 500, t0, t1, v[..]); }
    dr_add(rep, ifx which == 0 then "plate text" else "status lines", v[0]);
  }
  // each page alone: the camera's turn in a frame, the room's corrections, the town's people
  for side: 0..<2 {
    p := ifx side == 0 then a else b;
    v: [1] DrVerdict;
    for r: 1..<p[0].n {
      t := dr_at(p, r, C_T);
      if t < t0 || t > t1 { continue; }
      d := dr_diff(DR_ANGLE, dr_at(p, r, C_YAW), dr_at(p, r - 1, C_YAW), 0, 0);
      if d > DR_YAW_JUMP && !v[0].drifted {
        v[0].drifted = true; v[0].t = t; v[0].step = dr_step_at(p, t); v[0].mine = d; v[0].by = d - DR_YAW_JUMP;
        q: [1] Buf; bput(q[..], ifx side == 0 then "offline" else "room"); bput(q[..], " page turned "); bint(q[..], d); bput(q[..], " mrad in one frame");
        for i: 0..<q[0].n { v[0].note[i] = q[0].b[i]; } v[0].note_n = q[0].n;
      }
    }
    if side == 0 || !v[0].drifted { dr_add(rep, ifx side == 0 then "camera jump, offline" else "camera jump, room", v[0]); }
    else { dr_add(rep, "camera jump, room", v[0]); }
  }
  // each page alone: the camera turned more than DR_TURN in DR_TURN_MS with no look (no pointer move,
  // everglade-drift.js "look"): nothing but your look may turn it, however it turns (#12718)
  for side: 0..<2 {
    p := ifx side == 0 then a else b;
    v: [1] DrVerdict;
    j := 0; looked := -1;
    for r: 0..<p[0].n {
      t := dr_at(p, r, C_T);
      if dr_at(p, r, C_LOOK) != 0 { looked = r; }
      while j < r && t - dr_at(p, j, C_T) > DR_TURN_MS { j += 1; }
      if t < t0 || t > t1 || v[0].drifted || looked >= j { continue; }
      d := dr_diff(DR_ANGLE, dr_at(p, r, C_YAW), dr_at(p, j, C_YAW), 0, 0);
      if d > DR_TURN {
        v[0].drifted = true; v[0].t = t; v[0].step = dr_step_at(p, t); v[0].mine = d; v[0].by = d - DR_TURN;
        q: [1] Buf; bput(q[..], ifx side == 0 then "offline" else "room"); bput(q[..], " camera turned "); bint(q[..], d);
        bput(q[..], " mrad in "); bint(q[..], t - dr_at(p, j, C_T)); bput(q[..], " ms with no look");
        for i: 0..<q[0].n { v[0].note[i] = q[0].b[i]; } v[0].note_n = q[0].n;
      }
    }
    dr_add(rep, ifx side == 0 then "camera turn with no look, offline" else "camera turn with no look, room", v[0]);
  }
  {
    v: [1] DrVerdict; fixes := 0; worst := 0; first := -1;
    for r: 1..<b[0].n {
      t := dr_at(b, r, C_T);
      if t < t0 || t > t1 { continue; }
      if dr_at(b, r, C_RERUNS) > dr_at(b, r - 1, C_RERUNS) && dr_at(b, r, C_FIX) > 50 {
        fixes += 1; if first < 0 { first = t; }
        if dr_at(b, r, C_FIX) > worst { worst = dr_at(b, r, C_FIX); }
      }
    }
    secs := (t1 - t0) / 1000; if secs < 1 { secs = 1; }
    v[0].frames = fixes;
    if fixes > DR_FIX_RATE * secs || worst > 500 {
      v[0].drifted = true; v[0].t = first; v[0].step = dr_step_at(b, first); v[0].mine = fixes; v[0].by = worst;
      q: [1] Buf; bint(q[..], fixes); bput(q[..], " corrections over 5 cm in "); bint(q[..], secs); bput(q[..], " s, the largest "); bint(q[..], worst); bput(q[..], " mm");
      for i: 0..<q[0].n { v[0].note[i] = q[0].b[i]; } v[0].note_n = q[0].n;
    }
    dr_add(rep, "corrections", v[0]);
  }
  {
    // the held step's Hold Person reached the town (#12886): each page draws a held townsperson,
    // or the town's people's conditions above had nothing to compare
    v: [1] DrVerdict;
    for side: 0..<2 {
      p := ifx side == 0 then a else b;
      h := dr_mark_t(p, "held"); most := 0;
      for r: 0..<p[0].n { if h >= 0 && dr_at(p, r, C_T) >= h && dr_at(p, r, C_FCOND) > most { most = dr_at(p, r, C_FCOND); } }
      if most == 0 && !v[0].drifted {
        v[0].drifted = true; v[0].t = h; v[0].step = "held";
        q: [1] Buf; bput(q[..], "no townsperson held on the "); bput(q[..], ifx side == 0 then "offline" else "room"); bput(q[..], " page");
        for i: 0..<q[0].n { v[0].note[i] = q[0].b[i]; } v[0].note_n = q[0].n;
      }
    }
    dr_add(rep, "a townsperson held", v[0]);
  }
  {
    // walking in place: a walking clip drawn where it was; and how fast those walking go
    wa := 0; sa := 0; ma := 0; wb := 0; sb := 0; mb := 0;
    for r: 0..<a[0].n { t := dr_at(a, r, C_T); if t >= t0 && t <= t1 { wa += dr_at(a, r, C_WALK); sa += dr_at(a, r, C_STALL); ma += dr_at(a, r, C_MOVED); } }
    for r: 0..<b[0].n { t := dr_at(b, r, C_T); if t >= t0 && t <= t1 { wb += dr_at(b, r, C_WALK); sb += dr_at(b, r, C_STALL); mb += dr_at(b, r, C_MOVED); } }
    pa := ifx wa > 0 then sa * 100 / wa else 0; pb := ifx wb > 0 then sb * 100 / wb else 0;
    v: [1] DrVerdict;
    q: [1] Buf;
    bput(q[..], "walking in place on "); bint(q[..], pa); bput(q[..], "% of walking frames offline, "); bint(q[..], pb); bput(q[..], "% in the room; ");
    bput(q[..], "mm a walking frame "); bint(q[..], ifx wa > 0 then ma / wa else 0); bput(q[..], " offline, "); bint(q[..], ifx wb > 0 then mb / wb else 0); bput(q[..], " in the room");
    if pb > pa + DR_STALL || (wa > 0) != (wb > 0) { v[0].drifted = true; v[0].t = t0; v[0].step = "all"; v[0].mine = pa; v[0].other = pb; v[0].by = pb - pa; }
    for i: 0..<q[0].n { v[0].note[i] = q[0].b[i]; } v[0].note_n = q[0].n;
    dr_add(rep, "NPC speed against clip", v[0]);
  }
}

dr_print :: (rep: [] DrReport, profile: string, t0: int) -> bool {
  all := !rep[0].overflow;
  if rep[0].overflow {print("DRIFT % report overflow: a required probe could not be retained\n",profile);}
  for k: 0..<rep[0].n {
    r := rep[0].r[k];
    if !r.v.drifted { print("ok    % %\n", profile, r.name); continue; }
    all = false;
    if r.v.note_n > 0 {
      print("DRIFT % %: at % ms (step %): %\n", profile, r.name, r.v.t - t0, r.v.step, cast(string) rep[0].r[k].v.note[0..<r.v.note_n]);
    } else {
      print("DRIFT % %: at % ms (step %): offline % against room %, by % (% frames off)\n", profile, r.name, r.v.t - t0, r.v.step, r.v.mine, r.v.other, r.v.by, r.v.frames);
    }
  }
  return all;
}

// ---- the servers, network and bots: children of this program, stopped by it
dr_spawn :: (cmd: string) -> int {
  h := proc_new();
  if !(proc_arg(h, "/bin/sh") && proc_arg(h, "-c") && proc_arg(h, cmd) && proc_quiet(h)) || proc_start(h) != 0 { return -1; }
  return h;
}
dr_stop :: (h: int) {
  if h < 0 { return; }
  k := proc_kill(h, PROC_SIGTERM); w := proc_wait(h, 3000);
  if w == PROC_RUNNING { k = proc_kill(h, PROC_SIGKILL); w = proc_wait(h, 1000); }
  r := proc_release(h);
}
// A server still running (proc_wait: PROC_RUNNING), not one that exited because it couldn't listen.
dr_running :: (h: int) -> bool { return h >= 0 && proc_wait(h, 0) == PROC_RUNNING; }
DR_PORT_TRIES :: 8;
// The next block of five ports past PORT's, stepping over the owner's servers (8830, 8872).
dr_next_port :: (port: int) -> int {
  p := port + 10;
  while (p <= 8830 && p + 4 >= 8830) || (p <= 8872 && p + 4 >= 8872) { p += 10; }
  return p;
}
#test "a held port block moves the run ten ports on, past the owner's servers" {
  #assert dr_next_port(8960) == 8970 && dr_next_port(8970) == 8980;
  #assert dr_next_port(8816) == 8836 && dr_next_port(8860) == 8880 && dr_next_port(8858) == 8878;
}
dr_ready :: (c: [] Cdp, room: bool) -> bool {
  deadline := proc_now_ms() + 90000;
  while proc_now_ms() < deadline {
    proc_sleep(700);
    ok := ifx room then dr_int(c, "__dr.probe(0) === 2 && __dr.probe(1) >= 0 ? 1 : 0", 0) == 1 else dr_int(c, "__dr.count() > 60 ? 1 : 0", 0) == 1;
    if ok { return true; }
    _ := dr_press(c, true, "Enter", "Enter", 13, false); _ = dr_press(c, false, "Enter", "Enter", 13, false);
  }
  return false;
}
dr_open :: (c: [] Cdp, url: string, script: string) -> bool {
  params: [131072] u8; o: [1] Jo;
  if cdp_call(c, "Emulation.setDeviceMetricsOverride", "{\"width\":1280,\"height\":800,\"deviceScaleFactor\":1,\"mobile\":false}", CDP_CALL_MS) < 0 { return false; }
  if cdp_call(c, "Page.enable", "", CDP_CALL_MS) < 0 || cdp_call(c, "Emulation.setFocusEmulationEnabled", "{\"enabled\":true}", CDP_CALL_MS) < 0 { return false; }
  if cdp_call(c, "Network.setCookie", "{\"name\":\"verse-automation\",\"value\":\"drift-check\",\"url\":\"http://127.0.0.1\"}", CDP_CALL_MS) < 0 { return false; }
  jo_start(o[..], params[..]); jo_obj(o[..]); jo_key(o[..], "source"); jo_str(o[..], script); jo_end(o[..]);
  if o[0].bad || cdp_call(c, "Page.addScriptToEvaluateOnNewDocument", jo_text(o[..]), CDP_CALL_MS) < 0 { return false; }
  jo_start(o[..], params[..]); jo_obj(o[..]); jo_key(o[..], "url"); jo_str(o[..], url); jo_end(o[..]);
  return !o[0].bad && cdp_call(c, "Page.navigate", jo_text(o[..]), CDP_CALL_MS) >= 0;
}

DR_DEV_KEY :: "local-development-room-ticket-key-not-a-secret";   // room-dev.coax DEV_KEY, the bots' tickets
// the paired session's control lines: PvP on, levels off (the whole bar on both
// pages), no raid, and the dice fixed: each die lands on half its faces in both rooms (room-control.coax
// "dice", #12887). Otherwise each room's rules seed their dice from the clock and the room's slot,
// its world draws its own dice (whom your Reverse Gravity and Wind Wall lift) in its own order, and
// its townspeople take their turns (the saves they repeat) on a beat from when the room was made:
// the same spells harmed different people, so the WANTED level, the watch's blows and the
// conditions on the town came out differently in the two.
DR_CONTROL_PAIR :: "pvp 1\nedit 1\nlevels 0 2\nevent 0 0 3 12 6 1 3 3 31 1 2 1 100 15 0 0\ndice fixed\n";
#test "paired worker controls preserve the complete native control answer" {
  q:[1]Buf;dr_pair_control_js(q[..]);
  #assert btext(q[..])=="coaxial.roomHost && coaxial.roomHost.control ? coaxial.roomHost.control(\"pvp 1\\nedit 1\\nlevels 0 2\\nevent 0 0 3 12 6 1 3 3 31 1 2 1 100 15 0 0\\ndice fixed\\n\") : 0";
}
dr_pair_control_js :: (q:[]Buf) {
  data:[4096]u8;j:[1]Jo;jo_start(j[..],data[..]);jo_str(j[..],DR_CONTROL_PAIR);
  bput(q,"coaxial.roomHost && coaxial.roomHost.control ? coaxial.roomHost.control(");bput(q,jo_text(j[..]));bput(q,") : 0");
}
dr_pair_controls :: (c:[]Cdp,worker:bool)->bool {
  if !worker {return true;}
  q:[1]Buf;dr_pair_control_js(q[..]);return dr_int(c,btext(q[..]),0)==1;
}
// The offline page's room on the local host (--offline worker) takes the dice line as the room page's
// room takes it from its control file (coax/web/room-worker.js roomHost.control).
dr_dice :: (c: [] Cdp, worker: bool) {
  if !worker { return; }
  if dr_int(c, "coaxial.roomHost && coaxial.roomHost.control ? coaxial.roomHost.control('dice fixed\\n') : 0", 0) != 1 { print("  (the offline page's room didn't take the dice line)\n"); }
}
// worker: the offline page plays on the room server's local host (?offline=worker, #12784); false its own game
DrRun :: struct { port: int; bots: int; stamp: int; dir: string; ctl: string; script: string; key: string; worker: bool; native: bool; tick_us:int; }
dr_offline_script :: (run:DrRun,out:[]Buf)->string {
  out[0].n=0;
  if run.native {bput(out,"globalThis.coaxialNativeRoomHost='ws://127.0.0.1:");bint(out,run.port+4);bput(out,"';\n");}
  bput(out,run.script);return btext(out);
}
dr_native_ready :: (run:DrRun,c:[]Cdp)->bool {
  return !run.native || dr_int(c,"coaxial.roomHost?.native === true && __dr.probe(0)===2 && __dr.probe(1)===0 ? 1:0",0)==1;
}
dr_room_ready :: (c: [] Cdp, port: int) -> bool {
  began := proc_now_ms(); deadline := began + 60000;
  body: [64] u8;
  while proc_now_ms() < deadline {
    n := cdp_get(c, port, "/ready", body[..]);
    if n == 6 && cast(string) body[0..<n] == "ready\n" { print("  native room ready after % ms\n", proc_now_ms() - began); return true; }
    proc_sleep(100);
  }
  tool_errln("everglade-drift: native room never became ready"); return false;
}

// One paired session on one network profile: its verdicts into rep; false when it couldn't run.
dr_session :: (run: DrRun, profile: string, rtt: int, rep: [] DrReport, a: [] DrPage, b: [] DrPage) -> bool {
  room := run.port; page := run.port + 1; proxy := run.port + 2;
  ca: [1] Cdp; cb: [1] Cdp; ok := false;
  if !dr_room_ready(ca[..], room) { return false; }
  tool := "coax/web/tool.sh";
  q: [1] Buf;
  bput(q[..], "exec "); bput(q[..], tool); bput(q[..], " coax/web/room/net-proxy.coax "); bint(q[..], proxy); bput(q[..], " "); bint(q[..], room);
  bput(q[..], " "); bint(q[..], rtt); bput(q[..], ifx rtt > 0 then " 30 20 900" else " 0 0 900");
  bput(q[..], " > "); bput(q[..], run.dir); bput(q[..], "/proxy-"); bput(q[..], profile); bput(q[..], ".log 2>&1");
  hp := dr_spawn(btext(q[..]));
  code := run.stamp * 10 + rtt / 50;
  q[0].n = 0;
  bput(q[..], "OA_ROOM_TICKET_KEY="); bput(q[..], run.key); bput(q[..], " exec "); bput(q[..], tool); bput(q[..], " coax/web/room/drift-bots.coax ws://127.0.0.1:"); bint(q[..], room); bput(q[..], " "); bint(q[..], run.bots);
  bput(q[..], " 150 "); bint(q[..], code); bput(q[..], " "); bput(q[..], run.dir); bput(q[..], " > "); bput(q[..], run.dir); bput(q[..], "/bots-"); bput(q[..], profile); bput(q[..], ".log 2>&1");
  ready_path: [1] Buf; bput(ready_path[..], run.dir); bput(ready_path[..], "/bots-ready");
  unsafe_path: [1] Buf; bput(unsafe_path[..], run.dir); bput(unsafe_path[..], "/bots-unsafe");
  removed := fs_remove(btext(ready_path[..])); removed = fs_remove(btext(unsafe_path[..]));
  hb := dr_spawn(btext(q[..]));
  proc_sleep(2500);
  ua: [1] Buf; bput(ua[..], "http://127.0.0.1:"); bint(ua[..], run.port + 3); bput(ua[..], "/worlds/everglade?offline=worker&levels=off");
  ub: [1] Buf; bput(ub[..], "http://127.0.0.1:"); bint(ub[..], page); bput(ub[..], "/worlds/everglade?relay=ws://localhost:"); bint(ub[..], proxy); bput(ub[..], "&room=pair-drift-"); bint(ub[..], code);
  if cdp_launch_background(ca[..], 1280, 800, "coax-drift-a-") {
    if cdp_launch_background(cb[..], 1280, 800, "coax-drift-b-") {
      script:[1]Buf;
      if dr_open(ca[..], btext(ua[..]), dr_offline_script(run,script[..])) && dr_open(cb[..], btext(ub[..]), run.script) && dr_ready(ca[..], false) && dr_ready(cb[..], true) && dr_native_ready(run,ca[..]) && dr_pair_controls(ca[..],run.worker && !run.native) {
        proc_sleep(2500);
        deadline := proc_now_ms() + 12000;
        while !fs_exists(btext(ready_path[..])) && proc_now_ms() < deadline { proc_sleep(100); }
        if !fs_exists(btext(ready_path[..])) { tool_errln("everglade-drift: background players never reached 32 m clearance"); }
        sh: [1] Buf; bput(sh[..], run.dir); bput(sh[..], "/shot-"); bput(sh[..], profile);
        at: [1] int;hold_target:=[1]int.[-1];
        gravity_ready := dr_script(DrPair.{a = ca[..], b = cb[..], shots = btext(sh[..]), ctl = run.ctl, room = code, worker = run.worker, native=run.native, at = at[..],hold_target=hold_target[..]}, run.dir);
        dr_add(rep,"scripted Hold Person selects the same person",DrVerdict.{drifted=hold_target[0]<0,step="held",mine=hold_target[0]});
        ok = dr_pull(ca[..], a, true) && dr_pull(cb[..], b, true);
        ia:[1]DrInputs;ib:[1]DrInputs;ip:[1]Buf;
        bput(ip[..],run.dir);bput(ip[..],"/inputs-");bput(ip[..],profile);bput(ip[..],"-offline.txt");
        input_a:=dr_input_pull(ca[..],ia[..],btext(ip[..]));
        ip[0].n=0;bput(ip[..],run.dir);bput(ip[..],"/inputs-");bput(ip[..],profile);bput(ip[..],"-room.txt");
        input_b:=dr_input_pull(cb[..],ib[..],btext(ip[..]));
        end_a:=-1;end_b:=-1;
        for m:0..<a[0].marks_n {if dr_mark_name(a,m)=="end" {end_a=a[0].marks[m].step;}}
        for m:0..<b[0].marks_n {if dr_mark_name(b,m)=="end" {end_b=b[0].marks[m].step;}}
        same_inputs:=input_a && input_b && dr_inputs_same(ia[..],ib[..],ifx end_a<end_b then end_a else end_b);
        print("  transmitted inputs: origins %/%, end steps %/%, identical %\n",ia[0].origin,ib[0].origin,end_a,end_b,same_inputs);
        // Rendered frames can batch input steps across a scripted key edge. Retain exact streams
        // as diagnostics; they do not replace or loosen any existing movement/correction bound.
        ok=ok && input_a && input_b;
        clearance: [1] DrVerdict;
        clearance[0].drifted = !fs_exists(btext(ready_path[..])) || fs_exists(btext(unsafe_path[..]));
        clearance[0].step = "background players";
        dr_add(rep, "background players stayed at least 32 m away", clearance[0]);
        placement: [1] DrVerdict;
        placement[0].drifted = !gravity_ready || !dr_town_fell(a, dr_mark_t(a, "rg"), dr_mark_t(a, "wos")) || !dr_town_fell(b, dr_mark_t(b, "rg"), dr_mark_t(b, "wos"));
        placement[0].step = "rg"; placement[0].t = dr_mark_t(a, "rg");
        dr_add(rep, "gravity safely reaches and drops a townsperson", placement[0]);
        {
          diag: [65536] u8; path: [1] Buf; bput(path[..], run.dir); bput(path[..], "/corrections-"); bput(path[..], profile); bput(path[..], ".json");
          _ := fs_write(btext(path[..]), dr_str(cb[..], "JSON.stringify(__dr.largeCorrections)", diag[..]));
          path[0].n = 0; bput(path[..], run.dir); bput(path[..], "/vitals-"); bput(path[..], profile); bput(path[..], ".txt");
          _ = fs_write(btext(path[..]), dr_str(cb[..], "fetch('/api/room/vitals').then(r=>r.text())", diag[..]));
        }
        if run.worker {
          print("  (offline room host: % stalls, % ms of its beat dropped)\n", dr_int(ca[..], "coaxial.roomHost ? coaxial.roomHost.stalls | 0 : -1", -1), dr_int(ca[..], "coaxial.roomHost ? coaxial.roomHost.lost | 0 : -1", -1));
          // its tick against the host's budget (aethyr/session/lifecycle.coax LIFECYCLE_TICK_US)
          host := ifx run.native then LIFECYCLE_HOST_NATIVE else LIFECYCLE_HOST_WORKER;
          p95 := dr_int(ca[..], "coaxial.roomHost && coaxial.roomHost.tickP95Us >= 0 ? Math.round(coaxial.roomHost.tickP95Us) : -1", -1);
          p99 := dr_int(ca[..], "coaxial.roomHost && coaxial.roomHost.tickP99Us >= 0 ? Math.round(coaxial.roomHost.tickP99Us) : -1", -1);
          if !run.native && run.tick_us>0 {
            raw:[262144]u8;samples:[8192]int;
            text:=dr_str(ca[..],"__dr.tickSamples.join(',')",raw[..]);
            count:=dr_tick_parse(text,samples[..]);
            if dr_int(ca[..],"__dr.tickOverflow ? 1:0",1)!=0 {count= -1;}
            p95= -1;p99= -1;median:= -1;
            if count>0 {p95=dr_tick_quantile(samples[0..<count],950);p99=dr_tick_quantile(samples[0..<count],990);median=dr_tick_quantile(samples[0..<count],500);}
            record:[1]Buf;bput(record[..],run.dir);bput(record[..],"/worker-ticks-");bput(record[..],profile);bput(record[..],".csv");
            if !fs_write(btext(record[..]),text) {p95= -1;}
            print("  (worker workload: % ticks in completed cost batches, p50 % us, p95 % us, p99 % us)\n",count,median,p95,p99);
            part_raw:[65536]u8;parts:[8192]int;part_text:=dr_str(ca[..],"__dr.tickParts.join(',')",part_raw[..]);
            pn:=dr_tick_parse(part_text,parts[..]);
            if count>0 && pn>0 && pn%17==0 {
              names:=[17]string.["move","abilities","town","spells","people","rules","write","send","core","flush","begin","prepare","owners","casts","town_setup","town_results","orbit"];
              print("  worker mean tick parts (us):");
              for part:0..<17 {total:=0;for batch:0..<pn/17 {total+=parts[batch*17+part];}print(" %=%",names[part],total/count);}print("\n");
            }
          }
          print("  (% room tick: p95 % us, p99 % us, budget % us at p95: %)\n", ifx run.native then "native" else "worker", p95, p99, LIFECYCLE_TICK_US[host], ifx life_tick_ok(host, p95) then "within" else "over");
          if run.tick_us>0 {
            verdict:=DrVerdict.{drifted=!dr_tick_ok(p95,run.tick_us),t=dr_mark_t(a,"start"),step="tick budget",mine=p95,other=run.tick_us,by=p95-run.tick_us};
            message:[1]Buf;bput(message[..],"tick p95 ");bint(message[..],p95);bput(message[..]," us against qualification limit ");bint(message[..],run.tick_us);bput(message[..]," us");
            for ch,i:btext(message[..]) {if i<verdict.note.count {verdict.note[i]=ch;verdict.note_n=i+1;}}
            dr_add(rep,ifx run.native then "native tick p95" else "worker tick p95",verdict);
          }

        }
        // the town's people's conditions as each page drew them (wall ms, WANTED, the rows held, then PERSON:BITS), a note
        // for a drift of "conditions on the town's people": conds-PROFILE-offline.txt, -room.txt
        for side: 0..<2 {
          cn: [1] Buf; bput(cn[..], run.dir); bput(cn[..], "/conds-"); bput(cn[..], profile); bput(cn[..], ifx side == 0 then "-offline.txt" else "-room.txt");
          ct: [65536] u8;
          _ := fs_write(btext(cn[..]), dr_str(ifx side == 0 then ca[..] else cb[..], "__dr.conds.join('\\n') + '\\n'", ct[..]));
          cn[0].n = 0; bput(cn[..], run.dir); bput(cn[..], "/facts-"); bput(cn[..], profile); bput(cn[..], ifx side == 0 then "-offline.json" else "-room.json");
          _ = fs_write(btext(cn[..]), dr_str(ifx side == 0 then ca[..] else cb[..], "JSON.stringify(__dr.facts)", ct[..]));
          cn[0].n = 0; bput(cn[..], run.dir); bput(cn[..], "/commands-"); bput(cn[..], profile); bput(cn[..], ifx side == 0 then "-offline.json" else "-room.json");
          _ = fs_write(btext(cn[..]), dr_str(ifx side == 0 then ca[..] else cb[..], "JSON.stringify({commands:__dr.commands,messages:__dr.messages,texts:__dr.texts,marks:__dr.marks})", ct[..]));
        }
        // when each key reached each page (wall ms CODE down|up): keys-PROFILE-offline.txt, -room.txt
        for side: 0..<2 {
          kn: [1] Buf; bput(kn[..], run.dir); bput(kn[..], "/keys-"); bput(kn[..], profile); bput(kn[..], ifx side == 0 then "-offline.txt" else "-room.txt");
          kt: [16384] u8;
          _ := fs_write(btext(kn[..]), dr_str(ifx side == 0 then ca[..] else cb[..], "__dr.keys.join('\\n') + '\\n'", kt[..]));
        }
      } else {
        da: [2048] u8; db: [2048] u8; js := "JSON.stringify({rows: window.__dr && __dr.count(), net: window.__dr && __dr.probe(0), seat: window.__dr && __dr.probe(1), wasm: !!(window.__dr && __dr.x), title: document.title, url: location.href})";
        print("everglade-drift: the pages didn't come up: offline %, room %\n", dr_str(ca[..], js, da[..]), dr_str(cb[..], js, db[..]));
      }
      cdp_close(cb[..]);
    }
    cdp_close(ca[..]);
  }
  dr_stop(hb); dr_stop(hp);
  if ok { dr_compare(a, b, rtt, rep, run.worker); }
  return ok;
}

// A real spell in a fresh shared room. Both pages must see fire, then agree on the complete settled
// burnt forest, including trunk transforms. Uses only this tool's local server and proxy.
dr_forest :: (run: DrRun, profile: string, rtt: int, rep: [] DrReport) -> bool {
  q: [1] Buf;
  bput(q[..], "exec coax/web/tool.sh coax/web/room/net-proxy.coax "); bint(q[..], run.port + 2); bput(q[..], " "); bint(q[..], run.port);
  bput(q[..], " "); bint(q[..], rtt); bput(q[..], ifx rtt > 0 then " 30 20 900" else " 0 0 900");
  bput(q[..], " > "); bput(q[..], run.dir); bput(q[..], "/proxy-forest-"); bput(q[..], profile); bput(q[..], ".log 2>&1");
  hp := dr_spawn(btext(q[..])); proc_sleep(1000);
  url: [1] Buf; bput(url[..], "http://127.0.0.1:"); bint(url[..], run.port + 1);
  bput(url[..], "/worlds/everglade?relay=ws://localhost:"); bint(url[..], run.port + 2);
  bput(url[..], "&room=pair-forest-"); bint(url[..], run.stamp * 10 + rtt / 50);
  a: [1] Cdp; b: [1] Cdp; ok := false; fire_a := false; fire_b := false;
  burnt_a := -1; burnt_b := -1; hash_a := -1; hash_b := -1;
  if cdp_launch_background(a[..], 1280, 800, "coax-forest-a-") {
    if cdp_launch_background(b[..], 1280, 800, "coax-forest-b-") {
      if dr_open(a[..], btext(url[..]), run.script) && dr_ready(a[..], true) {
        marked := dr_int(a[..], "__dr.mark('start')", 0);
        _ := dr_press(a[..], true, "Escape", "Escape", 27, false); _ = dr_press(a[..], false, "Escape", "Escape", 27, false);
        proc_sleep(1500);
        before_x := dr_int(a[..], "__dr.fr[__dr.fr.length-1][2]", -999999);
        before_z := dr_int(a[..], "__dr.fr[__dr.fr.length-1][4]", -999999);
        // Move the caster before the observer arrives at the same spawn.
        _ = dr_press(a[..], true, "d", "KeyD", 68, false); proc_sleep(3000); _ = dr_press(a[..], false, "d", "KeyD", 68, false);
        print("  forest %: caster moved from %, % to %, % mm\n", profile, before_x, before_z,
          dr_int(a[..], "__dr.fr[__dr.fr.length-1][2]", -999999), dr_int(a[..], "__dr.fr[__dr.fr.length-1][4]", -999999));
        if dr_open(b[..], btext(url[..]), run.script) && dr_ready(b[..], true) {
        _ = dr_press(b[..], true, "Escape", "Escape", 27, false); _ = dr_press(b[..], false, "Escape", "Escape", 27, false); proc_sleep(1500);
        next_cast := proc_now_ms(); deadline := next_cast + 180000; quiet := 0; near := true; misses := 0;
        while proc_now_ms() < deadline {
          burning_a := dr_int(a[..], "__dr.probe(9001)", -1); burning_b := dr_int(b[..], "__dr.probe(9001)", -1);
          burnt_a = dr_int(a[..], "__dr.probe(9002)", -1); burnt_b = dr_int(b[..], "__dr.probe(9002)", -1);
          fire_a = fire_a || burning_a > 0; fire_b = fire_b || burning_b > 0;
          if burning_a > 0 && near {
            _ = dr_press(a[..], true, "a", "KeyA", 65, false); proc_sleep(1500); _ = dr_press(a[..], false, "a", "KeyA", 65, false); near = false;
          }
          if burning_a == 0 && burnt_a == 0 && proc_now_ms() >= next_cast {
            if !near { _ = dr_press(a[..], true, "d", "KeyD", 68, false); proc_sleep(3000); _ = dr_press(a[..], false, "d", "KeyD", 68, false); near = true; }
            tree := dr_int(a[..], "__dr.probe(9000)", -1);
            print("  forest %: Produce Flame at tree %\n", profile, tree);
            if tree < 0 { near = false; misses += 1; if misses >= 3 { break; } } else { misses = 0; }
            next_cast = proc_now_ms() + 6500;
          }
          settled := fire_a && fire_b && burnt_a > 0 && burnt_a == burnt_b && burning_a == 0 && burning_b == 0
            && dr_int(a[..], "__dr.probe(9003)", -1) == 0 && dr_int(b[..], "__dr.probe(9003)", -1) == 0;
          if settled {
            hash_a = dr_int(a[..], "__dr.probe(9004)", -1); hash_b = dr_int(b[..], "__dr.probe(9004)", -1);
            if hash_a >= 0 && hash_a == hash_b { quiet += 1; } else { quiet = 0; }
            if quiet >= 3 { ok = true; break; }
          } else { quiet = 0; }
          proc_sleep(1000);
        }
        png: [DR_SHOT] u8;
        for p: 0..<2 {
          path: [1] Buf; bput(path[..], run.dir); bput(path[..], "/shot-forest-"); bput(path[..], profile); bput(path[..], ifx p == 0 then "-caster.png" else "-observer.png");
          n := cdp_screenshot(ifx p == 0 then a[..] else b[..], png[..]); if n > 0 { _ = fs_write(btext(path[..]), cast(string) png[0..<n]); }
          details: [16384] u8; path[0].n = 0; bput(path[..], run.dir); bput(path[..], "/forest-"); bput(path[..], profile); bput(path[..], ifx p == 0 then "-caster.json" else "-observer.json");
          _ = fs_write(btext(path[..]), dr_str(ifx p == 0 then a[..] else b[..], "JSON.stringify({first:__dr.fr[0],last:__dr.fr[__dr.fr.length-1],keys:__dr.keys,texts:__dr.texts.slice(-12),seq:__dr.probe(15),net:__dr.probe(0),seat:__dr.probe(1)})", details[..]));
        }
        }
      }
      cdp_close(b[..]);
    }
    cdp_close(a[..]);
  }
  dr_stop(hp);
  print("  forest %: fire seen %/%, burnt %/%, settled digest %/%: %\n", profile, fire_a, fire_b, burnt_a, burnt_b, hash_a, hash_b, ifx ok then "holds" else "fails");
  verdict := DrVerdict.{drifted = !ok}; dr_add(rep, "shared burnt forest", verdict);
  return ok;
}
// The raid, on one profile: the offline page's preview raid (a) and the room's own (b), with
// raid-check.coax's bots fighting at the front; the room page walks from the commons out of the South
// Gate, keeps within Starry Wisp's reach of the nearest raider and casts it at that one. Its verdicts into rep.
DR_RAID_DIALS :: "event 1 0 1 8 3 1 3 1 1 1 3 1 300 5";   // the siege at size 8 (Cultists, a Fanatic, Warlocks), Darian at his camp, harm on, reward 300% (the waves, gates and minutes: the siege's no more)
DR_RAID_S :: 360;   // the announce and the siege, the cult's casters at the stables before the gate
// The bar's slots (its hash) page pg drew at wall ms t.
dr_bar_at :: (pg: [] DrPage, t: int) -> int { h := 0; for r: 0..<pg[0].n { if dr_at(pg, r, C_T) <= t { h = dr_at(pg, r, C_BAR); } } return h; }
dr_game_bar :: (pg: [] DrPage) -> int {
  t := dr_mark_t(pg, "end");
  if t < 0 || pg[0].n < 1 || dr_at(pg, pg[0].n - 1, C_T) < t { return -1; }
  return dr_bar_at(pg, t);
}
#test "raid baseline requires an observed end mark, not a future scheduled mark" {
  p: [1] DrPage; p[0].n = 1; p[0].rows[C_T] = 1000; p[0].rows[C_BAR] = 864523051;
  #assert dr_game_bar(p[..]) == -1;
  p[0].marks_n = 1; p[0].marks[0].name_n = 3;
  p[0].marks[0].name[0] = 'e'; p[0].marks[0].name[1] = 'n'; p[0].marks[0].name[2] = 'd'; p[0].marks[0].t = 1000;
  #assert dr_game_bar(p[..]) == 864523051;
}
#test "raid observer never samples a bar before LEVEL 1 when LEVEL 2 follows quickly" {
  #assert dr_raid_bar_time(1000, 1100) == 1000;
  #assert dr_raid_bar_time(1000, 1300) == 1100;
  #assert dr_raid_bar_time(1000, 5000) == 4000;
  #assert dr_raid_bar_time(1000, -1) == 4000;
}
dr_raid_bar_time :: (l1: int, l2: int) -> int {
  t := l1 + 3000; if l2 >= 0 && t > l2 - 200 { t = l2 - 200; } return ifx t < l1 then l1 else t;
}
// Control-file reads and the first kit snapshot are asynchronous. Establish the actual LEVEL 1
// kit before starting combat, rather than infer it from a fixed wait after opening the socket.
dr_raid_kit_ready :: (c: [] Cdp, whole: int) -> bool {
  if whole <= 0 { tool_errln("everglade-drift: the gameplay end has no full-kit baseline"); return false; }
  q: [1] Buf;
  bput(q[..], "(() => { const p=__dr.texts.filter(x=>x[1]===0), t=p[p.length-1]; return __dr.probe(65)===1 && __dr.probe(66)===1 && __dr.probe(49)!==");
  bint(q[..], whole); bput(q[..], " && t && t[2].startsWith('LEVEL 1') ? 1 : 0; })()");
  deadline := proc_now_ms() + 12000; stable := 0;
  while proc_now_ms() < deadline {
    if dr_int(c, btext(q[..]), 0) == 1 { stable += 1; } else { stable = 0; }
    if stable >= 3 {
      print("  raid: LEVEL 1 kit ready, bar % (whole %)\n", dr_int(c, "__dr.probe(49)", 0), whole);
      return true;
    }
    proc_sleep(100);
  }
  tool_errln("everglade-drift: the raid never established a LEVEL 1 kit before combat"); return false;
}
// The room page's walk from its arrival on the commons (the map's spawn, 0, -16 on 11-09) to the open
// road outside the South Gate (the map's gate-south, verse/everglade/points.coax, #13078). Until e0631669b3 you arrived on the road south of the gate (0, -84), inside the front's band;
// since then the commons is 40 m and more from the line, out of Starry Wisp's 18 m, so a page that
// holds at the spawn never hurts a raider (#13070). Round the fountain to the left as the paired
// session's route (dr_script) does, then down the road, steered into the gate's opening by the page's
// own position (its x within 0.8 to 2.2 m of the gap's middle, the session's lane through the arch),
// to 2.3 m past the gap.
dr_walk_key :: (c: [] Cdp, down: bool, key: string, code: string, vk: int) { _ := dr_press(c, down, key, code, vk, false); }
// The keys from (x, z) mm into the South Gate's lane (x 0.8 to 2.2 m from the gap's middle, g) and
// through it (bit 0 W, 1 S, 2 A, 3 D): south only in the lane, or while still 7 m and more short of
// the palisade (the gap's z). Off the lane nearer than 5 m it backs off north as it strafes, clear of
// the gate towers' fronts, as the paired session's route does (dr_script), rather than strafe into a tower.
dr_gate_keys :: (g: DrMap, x: int, z: int) -> int {
  k := ifx x < g.gx + 800 then 8 else (ifx x > g.gx + 2200 then 4 else 0);
  if k == 0 || z > g.gz + 7000 { k |= 1; } else if z < g.gz + 5000 { k |= 2; }
  return k;
}
#test "the raid page's walk strafes into the gate's lane before the palisade, never into a tower (#13070)" {
  g := drp_test_map();
  #assert dr_gate_keys(g, -5680, -40420) == (1 | 8);   // far from the wall: south and east
  #assert dr_gate_keys(g, -6300, -55050) == (2 | 8);   // at the west tower: back off north, east
  #assert dr_gate_keys(g, -3000, -50000) == 8;         // clear of the towers: east only
  #assert dr_gate_keys(g, 1500, -55300) == 1;          // in the lane: south
  #assert dr_gate_keys(g, 4000, -52000) == (2 | 4);
  // a gate the map moves takes the lane with it
  m := DrMap.{gx = 10000, gz = -40000, front_z = -45000};
  #assert dr_gate_keys(m, 11500, -39300) == 1 && dr_gate_keys(m, 1500, -34000) == 8;
}
dr_raid_walk :: (c: [] Cdp) -> bool {
  g := dr_map();
  if !dr_face_north(c) { tool_errln("everglade-drift: the raid page's camera didn't face the road"); return false; }
  st: [1] DrSteer;
  dr_steer_key(c, st[..], 0, true); proc_sleep(2500);
  dr_steer_key(c, st[..], 2, true); proc_sleep(3000); dr_steer_key(c, st[..], 2, false); proc_sleep(1000);
  deadline := proc_now_ms() + 30000;
  x := 0; z := 0;
  while proc_now_ms() < deadline {
    x = dr_int(c, "__dr.x.coaxial_field_probe(__dr.state,0)", -999999);
    z = dr_int(c, "__dr.x.coaxial_field_probe(__dr.state,2)", -999999);
    if z <= g.gz - 2300 { break; }
    keys := dr_gate_keys(g, x, z);
    for k: 0..<4 { dr_steer_key(c, st[..], k, (keys & (1 << k)) != 0); }
    proc_sleep(80);
  }
  dr_steer_stop(c, st[..]);
  proc_sleep(600);
  x = dr_int(c, "__dr.x.coaxial_field_probe(__dr.state,0)", -999999);
  z = dr_int(c, "__dr.x.coaxial_field_probe(__dr.state,2)", -999999);
  print("  raid: the room page stands at %,% mm\n", x, z);
  if !dr_raid_road(g, z) { tool_errln("everglade-drift: the raid page didn't reach the road outside the South Gate"); return false; }
  return true;
}
// In the fight the room page plays as a new player who fights does (raid-check.coax fight mode, the
// rule room-events.coax tunes the raid's XP to): it keeps within Starry Wisp's reach of the nearest foe
// (net_probe 930 to 932), DR_RAID_STANDOFF m from it, steering with W/S/A/D on the camera that faces
// north (W is -z, D is +x), for ms. The town's watch fights the line between; the page casts past it.
DR_RAID_STANDOFF :: 14000;   // mm
DrSteer :: struct { held: [4] bool; }   // W, S, A, D
dr_steer_key :: (c: [] Cdp, st: [] DrSteer, k: int, on: bool) {
  if st[0].held[k] == on { return; }
  st[0].held[k] = on;
  if k == 0 { dr_walk_key(c, on, "w", "KeyW", 87); } else if k == 1 { dr_walk_key(c, on, "s", "KeyS", 83); }
  else if k == 2 { dr_walk_key(c, on, "a", "KeyA", 65); } else { dr_walk_key(c, on, "d", "KeyD", 68); }
}
dr_steer_stop :: (c: [] Cdp, st: [] DrSteer) { for k: 0..<4 { dr_steer_key(c, st, k, false); } }
// The keys toward a stand DR_RAID_STANDOFF short of the foe at (fx, fz) from (x, z), all mm: bit 0 W,
// 1 S, 2 A, 3 D; none within 1.5 m of it.
dr_steer_keys :: (x: int, z: int, fx: int, fz: int) -> int {
  dx := x - fx; dz := z - fz;
  d := sqrt(f32(dx) * f32(dx) + f32(dz) * f32(dz));
  if d < 1.0 { return 0; }
  tx := fx + cast(int) (f32(dx) / d * f32(DR_RAID_STANDOFF)); tz := fz + cast(int) (f32(dz) / d * f32(DR_RAID_STANDOFF));
  k := 0;
  if tz < z - 1500 { k |= 1; } else if tz > z + 1500 { k |= 2; }
  if tx < x - 1500 { k |= 4; } else if tx > x + 1500 { k |= 8; }
  return k;
}
#test "the raid page closes to Starry Wisp's reach of its foe and backs off one too near (#13070)" {
  #assert dr_steer_keys(0, -59000, 0, -90000) == 1;             // 31 m south: W
  #assert dr_steer_keys(0, -59000, 0, -66000) == 2;             // 7 m: back, S
  #assert dr_steer_keys(0, -59000, 0, -73000) == 0;             // 14 m: hold
  #assert dr_steer_keys(0, -59000, 20000, -90000) == (1 | 8);   // south-east: W and D
}
dr_raid_close :: (c: [] Cdp, st: [] DrSteer, ms: int) {
  until := proc_now_ms() + ms;
  while proc_now_ms() < until {
    x := dr_int(c, "__dr.x.coaxial_field_probe(__dr.state,0)", -999999);
    z := dr_int(c, "__dr.x.coaxial_field_probe(__dr.state,2)", -999999);
    fx := dr_int(c, "__dr.probe(930)", -999999); fz := dr_int(c, "__dr.probe(931)", -999999);
    keys := ifx x == -999999 || fx == -999999 then 0 else dr_steer_keys(x, z, fx * 10, fz * 10);
    for k: 0..<4 { dr_steer_key(c, st, k, (keys & (1 << k)) != 0); }
    proc_sleep(100);
  }
}
// Whether z (mm) is out past the South Gate (the map's gate-south, RF_GATE_Z -56 m), within Starry
// Wisp's 18 m of the line's nearest hold (its raid-front, RF_HOLD_Z -61 m).
dr_raid_road :: (g: DrMap, z: int) -> bool { return z <= g.gz - 500 && z >= g.front_z - 18000; }
#test "the raid page's stand: past the gate and in Starry Wisp's reach of the line, never the commons (#13070)" {
  g := drp_test_map();
  #assert dr_raid_road(g, -58670) && dr_raid_road(g, -59030);
  #assert !dr_raid_road(g, -16000) && !dr_raid_road(g, -56000) && !dr_raid_road(g, -84000);
  #assert dr_raid_road(g, -79000) && !dr_raid_road(g, -79001) && dr_raid_road(g, -56500) && !dr_raid_road(g, -56499);
}
// whole: the whole bar's hash, as the paired session's room page drew it at its end (levels off there);
// the raid's offline page can't say it, as on the local host (?offline=worker) its room has levels on (#12897).
dr_raid :: (run: DrRun, profile: string, rtt: int, rep: [] DrReport, a: [] DrPage, b: [] DrPage, whole: int) -> bool {
  print("  raid: gameplay full-kit baseline %\n", whole);
  if whole <= 0 { tool_errln("everglade-drift: refusing a raid without an observed gameplay baseline"); return false; }
  room := run.port; page := run.port + 1; proxy := run.port + 2;
  cb_: [1] Buf; bput(cb_[..], "pvp 0\nedit 1\nlevels 1 2\n"); bput(cb_[..], DR_RAID_DIALS); bput(cb_[..], " 0 0\n");
  _ := fs_write(run.ctl, btext(cb_[..]));
  q: [1] Buf;
  bput(q[..], "exec coax/web/tool.sh coax/web/room/net-proxy.coax "); bint(q[..], proxy); bput(q[..], " "); bint(q[..], room);
  bput(q[..], " "); bint(q[..], rtt); bput(q[..], ifx rtt > 0 then " 30 20 900" else " 0 0 900");
  bput(q[..], " > "); bput(q[..], run.dir); bput(q[..], "/proxy-raid-"); bput(q[..], profile); bput(q[..], ".log 2>&1");
  hp := dr_spawn(btext(q[..]));
  code := run.stamp * 10 + rtt / 50;
  q[0].n = 0;
  bput(q[..], "OA_ROOM_TICKET_KEY="); bput(q[..], run.key); bput(q[..], " exec coax/web/tool.sh coax/web/room/raid-check.coax ws://127.0.0.1:"); bint(q[..], room);
  bput(q[..], " "); bint(q[..], run.bots); bput(q[..], " "); bint(q[..], DR_RAID_S + 20); bput(q[..], " "); bint(q[..], code);
  bput(q[..], " druid fight > "); bput(q[..], run.dir); bput(q[..], "/raid-bots-"); bput(q[..], profile); bput(q[..], ".log 2>&1");
  hb := dr_spawn(btext(q[..]));
  proc_sleep(3000);
  ua: [1] Buf; bput(ua[..], "http://127.0.0.1:"); bint(ua[..], run.port + 3); bput(ua[..], "/worlds/everglade?raid=preview&offline=worker");
  ub: [1] Buf; bput(ub[..], "http://127.0.0.1:"); bint(ub[..], page); bput(ub[..], "/worlds/everglade?relay=ws://localhost:"); bint(ub[..], proxy); bput(ub[..], "&room=pair-raid-"); bint(ub[..], code);
  ca: [1] Cdp; cc: [1] Cdp; ok := false;
  if cdp_launch_background(ca[..], 1280, 800, "coax-drift-a-") {
    if cdp_launch_background(cc[..], 1280, 800, "coax-drift-b-") {
      script:[1]Buf;
      open_a := dr_open(ca[..], btext(ua[..]), dr_offline_script(run,script[..]));
      open_b := open_a && dr_open(cc[..], btext(ub[..]), run.script);
      ready_a := open_b && dr_ready(ca[..], false); ready_b := ready_a && dr_ready(cc[..], true);
      native_ready := ready_b && dr_native_ready(run,ca[..]);
      print("  raid: opened %/%, ready %/%, native %\n", open_a, open_b, ready_a, ready_b, native_ready);
      if native_ready && dr_raid_kit_ready(cc[..], whole) && dr_raid_walk(cc[..]) {
        dr_dice(ca[..], run.worker && !run.native);
        sh: [1] Buf; bput(sh[..], run.dir); bput(sh[..], "/shot-raid-"); bput(sh[..], profile);
        p := DrPair.{a = ca[..], b = cc[..], shots = btext(sh[..])};
        dr_mark(p, "raid");
        // START: a new press acts in the live rooms
        bput(cb_[..], ""); cb_[0].n = 0; bput(cb_[..], "pvp 0\nedit 1\nlevels 1 2\n"); bput(cb_[..], DR_RAID_DIALS); bput(cb_[..], " 1 0\n");
        _ = fs_write(run.ctl, btext(cb_[..]));
        _ = dr_press(cc[..], true, "Escape", "Escape", 27, false); _ = dr_press(cc[..], false, "Escape", "Escape", 27, false);
        // the siege comes to the road (the front's band is past the gate): the page holds there
        proc_sleep(14000);
        dr_mark(p, "fight");
        t_end := proc_now_ms() + (DR_RAID_S - 20) * 1000;
        steer: [1] DrSteer;
        while proc_now_ms() < t_end {
          cast_ok := dr_int(cc[..], "__dr.probe(222)", 0);
          dr_raid_close(cc[..], steer[..], 1200);
          // done once both pages' stables fell and the room page is level 2
          fa := dr_int(ca[..], "(() => { const f = __dr.fr[__dr.fr.length - 1]; return f && f[21] > 0 && f[20] * 2 >= f[21] ? 1 : 0; })()", 0);
          fb := dr_int(cc[..], "(() => { const f = __dr.fr[__dr.fr.length - 1]; return f && f[21] > 0 && f[20] * 2 >= f[21] ? 1 : 0; })()", 0);
          l2 := dr_int(cc[..], "__dr.texts.some((x) => x[1] === 0 && x[2].startsWith('LEVEL 2')) ? 1 : 0", 0);
          if fa == 1 && fb == 1 && l2 == 1 { break; }
        }
        dr_steer_stop(cc[..], steer[..]);
        dr_mark(p, "end"); marked := dr_wait_end(p);
        ok = marked && dr_pull(ca[..], a, false) && dr_pull(cc[..], b, false);
      } else { tool_errln("everglade-drift: the raid's pages didn't come up"); }
      for side: 0..<2 {
        report: [1] Buf; bput(report[..], run.dir); bput(report[..], "/raid-"); bput(report[..], profile); bput(report[..], ifx side == 0 then "-offline.json" else "-room.json");
        obs: [65536] u8;
        _ = fs_write(btext(report[..]), dr_str(ifx side == 0 then ca[..] else cc[..], "JSON.stringify({texts:__dr.texts.filter(x=>x[1]===0).slice(-64),bars:__dr.bars.slice(-64),marks:__dr.marks,kit:__dr.probe(65),level:__dr.probe(66)})", obs[..]));
      }
      cdp_close(cc[..]);
    }
    cdp_close(ca[..]);
  }
  dr_stop(hb); dr_stop(hp);
  cb_[0].n = 0; bput(cb_[..], DR_CONTROL_PAIR);
  _ = fs_write(run.ctl, btext(cb_[..]));
  if !ok { return false; }
  // the stables, on each page: down (half their pieces or more) at some frame
  for side: 0..<2 {
    pg := ifx side == 0 then a else b;
    v: [1] DrVerdict; fell := -1; most := 0;
    for r: 0..<pg[0].n { all := dr_at(pg, r, C_SALL); d := dr_at(pg, r, C_SDOWN); if d > most { most = d; } if all > 0 && d * 2 >= all && fell < 0 { fell = dr_at(pg, r, C_T); } }
    if fell < 0 {
      v[0].drifted = true; v[0].t = dr_mark_t(pg, "raid"); v[0].step = "raid";
      nq: [1] Buf; bput(nq[..], "the stables never fell: at most "); bint(nq[..], most); bput(nq[..], " of "); bint(nq[..], ifx pg[0].n > 0 then dr_at(pg, pg[0].n - 1, C_SALL) else 0); bput(nq[..], " pieces down");
      for i: 0..<nq[0].n { v[0].note[i] = nq[0].b[i]; } v[0].note_n = nq[0].n;
    }
    dr_add(rep, ifx side == 0 then "stables collapse, offline raid" else "stables collapse, room raid", v[0]);
  }
  // the LEVEL plate: LEVEL 1 to LEVEL 2 with the XP, never CAP 0; the bar a level's kit, changing with it
  {
    // from the raid on: the paired session before it has levels off, and its plate may say LEVEL 1 over
    // the whole bar; at the raid the plate's LEVEL 1 counts from the raid's mark
    v: [1] DrVerdict; l1 := -1; l2 := -1; cap0 := -1;
    r0 := dr_mark_t(b, "raid");
    at0 := dr_text_at(b, 0, r0);
    if r0 >= 0 && at0.count >= 7 && at0[0..<7] == "LEVEL 1" { l1 = r0; }
    for k: 0..<b[0].texts_n {
      x := b[0].texts[k];
      if x.which != 0 || x.t < r0 { continue; }
      s := cast(string) b[0].texts[k].text[0..<x.n];
      if s.count >= 7 && s[0..<7] == "LEVEL 1" && l1 < 0 { l1 = x.t; }
      if s.count >= 7 && s[0..<7] == "LEVEL 2" && l2 < 0 { l2 = x.t; }
      if s.count >= 5 && s[s.count - 5..<s.count] == "CAP 0" && cap0 < 0 { cap0 = x.t; }
    }
    if l1 < 0 || l2 < 0 || cap0 >= 0 {
      v[0].drifted = true; v[0].t = ifx cap0 >= 0 then cap0 else dr_mark_t(b, "raid"); v[0].step = dr_step_at(b, v[0].t);
      nq: [1] Buf; bput(nq[..], "the plate said \""); bput(nq[..], dr_text_at(b, 0, dr_mark_t(b, "raid") + 2000)); bput(nq[..], "\" at the start and \"");
      bput(nq[..], dr_text_at(b, 0, dr_mark_t(b, "end"))); bput(nq[..], "\" at the end");
      n := ifx nq[0].n < 200 then nq[0].n else 200;
      for i: 0..<n { v[0].note[i] = nq[0].b[i]; } v[0].note_n = n;
    }
    dr_add(rep, "level up through XP", v[0]);
    w: [1] DrVerdict;
    full := ifx whole != 0 then whole else dr_bar_at(a, dr_mark_t(a, "end"));
    // the room re-reads its control lines every 2 s: the level's bar once that has come, and before LEVEL 2
    k1t := dr_raid_bar_time(l1, l2);
    k1 := ifx l1 >= 0 then dr_bar_at(b, k1t) else 0; k2 := ifx l2 >= 0 then dr_bar_at(b, l2 + 1500) else 0;
    if l1 >= 0 && (k1 == full || (l2 >= 0 && k2 == k1)) {
      w[0].drifted = true; w[0].t = l1; w[0].step = dr_step_at(b, l1); w[0].mine = full; w[0].other = k1;
      nq: [1] Buf; bput(nq[..], ifx k1 == full then "at LEVEL 1 the room's bar is the whole bar" else "the bar didn't change at LEVEL 2");
      for i: 0..<nq[0].n { w[0].note[i] = nq[0].b[i]; } w[0].note_n = nq[0].n;
    }
    dr_add(rep, "hotbar follows the level", w[0]);
  }
  return true;
}

dr_write_rows :: (path: string, p: [] DrPage) {
  q: [1] Buf;
  _ := fs_write(path, "");
  for r: 0..<p[0].n {
    q[0].n = 0;
    for c: 0..<DR_COLS { if c > 0 { bput(q[..], " "); } bint(q[..], dr_at(p, r, c)); }
    bput(q[..], "\n");
    _ = fs_append(path, btext(q[..]));
  }
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  ok := args_load(a[..]);
  if args_has(a[..], "--input-only") { return ifx dr_input_check() then 0 else 1; }
  // every place the walks aim at, from Everglade's map: a point it lacks stops the run here (#13078)
  mp_names := EG_POINT_NAME; mp_at := EG_POINT_AT; mp_want := DR_MAP_POINTS;
  if !map_need_all(EG_POINTS_ZONE, mp_names[..], mp_at[..], mp_want[..]) { return 2; }
  profiles := args_value(a[..], "--profiles", "local,100,250");
  bots := args_whole(args_value(a[..], "--bots", "3"));
  port := args_whole(args_value(a[..], "--port", "8960"));
  offline:=args_value(a[..],"--offline","worker");native:=offline=="native";
  tick_us:=args_whole(args_value(a[..],"--tick-us","0"));
  nice:=cast(int)getpriority(0,0);
  if !drh_priority_ok(tick_us>0,nice) {
    tool_errln("Timed qualification needs normal process priority (nice 0). Build the tool through the build gate, then run its prebuilt image outside the gate.");return 2;
  }
  near := (port <= 8830 && port + 4 >= 8830) || (port <= 8872 && port + 4 >= 8872);   // the owner's servers (it takes PORT to PORT + 4)
  if !ok || bots < 1 || port < 1024 || near || tick_us<0 || tick_us>1000000 || (offline!="native" && offline!="worker") {
    tool_errln("usage: coax/web/tool.sh everglade-drift [--profiles local,100,250] [--bots 3] [--port 8960] [--no-raid] [--forest-only] [--offline native|worker] [--tick-us N] [--out DIR] (not on 8830 or 8872)"); return 2;
  }
  js: [65536] u8;
  jn := fs_read("coax/web/everglade-drift.js", js[..]);
  if jn <= 0 { tool_errln("everglade-drift: can't read coax/web/everglade-drift.js (run it from the repository's root)"); return 2; }
  if !fs_exists("coax/web/room/bin/room") { tool_errln("everglade-drift: no coax/web/room/bin/room (coax/web/room/build.sh)"); return 2; }
  // A fresh worktree has no built pages: without them the page never draws a frame, and the
  // run would end, minutes later, with "the pages didn't come up" (#13117).
  for need: [3]string.["apps/openagents-web/build/everglade5e.wasm", "apps/openagents-web/build/everglade-room.wasm", "apps/openagents-web/build/render/everglade/render.json"] {
    if !fs_exists(need) {
      mq: [1] Buf; bput(mq[..], "everglade-drift: no "); bput(mq[..], need);
      bput(mq[..], ": this checkout has no built pages. Run coax/remote/pages.sh origin/main (main's build, about 10 seconds), then coax/web/wasm.sh for the module you changed");
      tool_errln(btext(mq[..])); return 2;
    }
  }
  // Build helpers with explicit help before starting servers. The raid helper has a live default
  // when invoked without arguments; warming it must not connect to that relay.
  for hk: 0..<3 {
    helper := ifx hk == 0 then "coax/web/room/net-proxy.coax" else ifx hk == 1 then "coax/web/room/drift-bots.coax" else "coax/web/room/raid-check.coax";
    hq: [1] Buf; bput(hq[..], "exec coax/web/tool.sh "); bput(hq[..], helper); bput(hq[..], " --help > /dev/null 2>&1");
    hh := dr_spawn(btext(hq[..]));
    if hh >= 0 { hw := proc_wait(hh, 600000); hr_ := proc_release(hh); }
  }
  stamp := (proc_now_ms() / 1000) % 100000;
  db: [1] Buf; bput(db[..], "coax/web/build/everglade-drift/"); bint(db[..], stamp);
  dir := args_value(a[..], "--out", btext(db[..]));
  _ := fs_mkdir("coax/web/build/everglade-drift"); _ = fs_mkdir(dir);
  inputs:[1]RtqInputs;
  for file:[16]string.["coax/web/drift-placement.coax","verse/everglade/points.coax","aethyr/world/points.coax","coax/web/map-points.coax","coax/web/room/worker.coax","coax/web/drift-snapshot.coax","coax/web/room/drift-bots.coax","coax/web/room/net-proxy.coax","coax/web/room/bin/room","apps/openagents-web/build/everglade5e.wasm","apps/openagents-web/build/everglade-room.wasm","coax/web/host.js","coax/web/room-worker.js","coax/web/everglade-drift.js","coax/web/everglade-drift.coax","coax/web/drift-hold.coax"] {
    if !rtq_input_add(inputs[..],file) {tool_errln("Cannot fence the actual drift inputs.");return 1;}
  }
  self:[4096]u8;self_n:=cxproc_self_path(self[..]);
  if self_n<1 || !rtq_input_add(inputs[..],cast(string)self[0..<self_n]) {return 1;}
  print("qualification process priority (nice): %\n",nice);
  // the room's --dev directory is DIR: dev/'s world, and its control lines (room-control.txt) this
  // program's to change, as the API's answer is (room-host.c --dev, room-dev.coax)
  wb: [262144] u8; wn := fs_read("coax/web/room/dev/world-everglade.json", wb[..]);
  if wn <= 0 { tool_errln("everglade-drift: can't read coax/web/room/dev/world-everglade.json"); return 2; }
  wp: [1] Buf; bput(wp[..], dir); bput(wp[..], "/world-everglade.json");
  _ = fs_write(btext(wp[..]), cast(string) wb[0..<wn]);
  cb: [1] Buf; bput(cb[..], dir); bput(cb[..], "/room-control.txt");
  ctl := btext(cb[..]);
  _ = fs_write(ctl, DR_CONTROL_PAIR);
  // The servers take PORT to PORT + 4. Each one that can't listen exits at once (serve.c, room-host.c):
  // a port another process holds, such as a server a stopped run left behind, would otherwise leave
  // the pages on that process's site, ending minutes later in "the pages didn't come up" (#13195).
  // So each must still be running once started; when one isn't, the run moves to the next block.
  // serve.sh builds the server first when it is stale; build it now (its usage exits at once), so
  // the check below sees the server listening or refused, not still compiling.
  hb0 := dr_spawn("exec coax/web/serve.sh --build-only-check > /dev/null 2>&1");
  if hb0 >= 0 { hw0 := proc_wait(hb0, 180000); hr0 := proc_release(hb0); }
  hr := -1; hs := -1; hn := -1; ho := -1; q: [1] Buf; up := false; tries := 0;
  while !up && tries < DR_PORT_TRIES {
    if tries > 0 {
      port = dr_next_port(port);
      print("everglade-drift: a server couldn't listen on its port (another process holds it); moving to %-%\n", port, port + 4);
    }
    tries += 1;
    // the room server, the API's stand-in (--dev DIR): its seat tickets signed with the stand-in's key
    q[0].n = 0;
    bput(q[..], "exec coax/web/room/bin/room --port "); bint(q[..], port); bput(q[..], " --dev "); bput(q[..], dir); bput(q[..], " > "); bput(q[..], dir); bput(q[..], "/room.log 2>&1");
    hr = dr_spawn(btext(q[..]));
    q[0].n = 0;
    bput(q[..], "exec coax/web/serve.sh apps/openagents-web --listen 127.0.0.1:"); bint(q[..], port + 1); bput(q[..], " --api "); bint(q[..], port); bput(q[..], " --static --cache 0 > "); bput(q[..], dir); bput(q[..], "/serve.log 2>&1");
    hs = dr_spawn(btext(q[..]));
    // The offline page has its own API/server. The native host runs its local
    // room there, so its tick measurement does not include the paired server's
    // unrelated room and bots. The worker has no rooms in its API stand-in.
    q[0].n = 0;
    bput(q[..], "exec coax/web/room/bin/room --port "); bint(q[..], port + 4); bput(q[..], " --dev "); bput(q[..], dir); bput(q[..],ifx native then " --listen 127.0.0.1 --native-local > " else " --no-rooms > "); bput(q[..], dir); bput(q[..], "/room-offline.log 2>&1");
    hn = dr_spawn(btext(q[..]));
    q[0].n = 0;
    bput(q[..], "exec coax/web/serve.sh apps/openagents-web --listen 127.0.0.1:"); bint(q[..], port + 3); bput(q[..], " --api "); bint(q[..],port+4); bput(q[..], " --static --cache 0 > "); bput(q[..], dir); bput(q[..], "/serve-offline.log 2>&1");
    ho = dr_spawn(btext(q[..]));
    proc_sleep(2000);
    up = dr_running(hr) && dr_running(hs) && dr_running(hn) && dr_running(ho);
    if !up { dr_stop(ho); dr_stop(hn); dr_stop(hs); dr_stop(hr); }
  }
  if !up { tool_errln("everglade-drift: no block of 5 free ports for its servers (see room.log and serve.log in the results)"); return 1; }
  // the bots sign their seat tickets with the room's key
  run := DrRun.{port = port, bots = bots, stamp = stamp, dir = dir, ctl = ctl, script = cast(string) js[0..<jn], key = DR_DEV_KEY, worker = offline!="page",native=native,tick_us=tick_us};
  print("everglade-drift: room 127.0.0.1:%, page 127.0.0.1:%, results in %\n", port, port + 1, dir);
  all := true;
  reps: [DR_PROFILES] DrReport; names: [DR_PROFILES] string; ran: [DR_PROFILES] bool; np := 0;
  pa: [1] DrPage; pb: [1] DrPage;
  at := 0;
  while at < profiles.count && np < DR_PROFILES {
    e := at; while e < profiles.count && profiles[e] != ',' { e += 1; }
    profile := profiles[at..<e]; at = e + 1;
    rtt := ifx profile == "local" then 0 else args_whole(profile);
    if rtt < 0 { tool_err("everglade-drift: no such profile "); tool_errln(profile); all = false; continue; }
    print("profile %: round trip % ms%\n", profile, rtt, ifx rtt > 0 then ", jitter 30 ms, 2% lost" else "");
    names[np] = profile;
    if args_has(a[..], "--forest-only") {
      ran[np] = dr_forest(run, profile, rtt, reps[np..<np + 1]); all = all && ran[np]; np += 1; continue;
    }
    ran[np] = dr_session(run, profile, rtt, reps[np..<np + 1], pa[..], pb[..]);
    np += 1;
    if !ran[np - 1] { print("DRIFT % session: it didn't run\n", profile); all = false; continue; }
    t0 := dr_mark_t(pa[..], "start");
    held := dr_print(reps[np - 1..<np], profile, t0);
    all = all && held;
    rb: [1] Buf; bput(rb[..], dir); bput(rb[..], "/rows-"); bput(rb[..], profile);
    ra: [1] Buf; bput(ra[..], btext(rb[..])); bput(ra[..], "-offline.txt"); dr_write_rows(btext(ra[..]), pa[..]);
    rr: [1] Buf; bput(rr[..], btext(rb[..])); bput(rr[..], "-room.txt"); dr_write_rows(btext(rr[..]), pb[..]);
    if held && !args_has(a[..], "--no-raid") {
      rr0 := reps[np - 1].n;
      whole := dr_game_bar(pb[..]);   // the session's room page: levels off, an observed whole bar
      if !dr_raid(run, profile, rtt, reps[np - 1..<np], pa[..], pb[..], whole) { print("DRIFT % raid: it didn't run\n", profile); all = false; }
      else {
        sub: [1] DrReport;sub[0].overflow=reps[np-1].overflow;
        for k: rr0..<reps[np - 1].n { dr_add(sub[..], reps[np - 1].r[k].name, reps[np - 1].r[k].v); }
        held2 := dr_print(sub[..], profile, dr_mark_t(pb[..], "raid"));
        all = all && held2;
      }
    }
  }
  // the table: a row a probe, a column a profile
  print("\n| probe |");
  for k: 0..<np { print(" % |", names[k]); }
  print("\n|---|");
  for k: 0..<np { print("---|"); }
  print("\n");
  first := -1; for k: 0..<np { if ran[k] && first < 0 { first = k; } }
  if first >= 0 {
    for r: 0..<reps[first].n {
      print("| % |", reps[first].r[r].name);
      for k: 0..<np { print(" % |", ifx !ran[k] then "-" else (ifx reps[k].r[r].v.drifted then "DRIFT" else "ok")); }
      print("\n");
    }
  }
  dr_stop(ho); dr_stop(hn); dr_stop(hs); dr_stop(hr);
  stable:=rtq_inputs_match(inputs[..]);all=all && stable;
  receipt:[65536]u8;o:[1]Jo;jo_start(o[..],receipt[..]);jo_obj(o[..]);
  jo_key(o[..],"schema");jo_str(o[..],"aethyr.everglade.drift-qualification.v1");
  jo_key(o[..],"nice");jo_int(o[..],nice);jo_key(o[..],"tick_limit_us");jo_int(o[..],tick_us);
  jo_key(o[..],"source_fence_unchanged");jo_bool(o[..],stable);jo_key(o[..],"passed");jo_bool(o[..],all);
  jo_key(o[..],"inputs");rtq_inputs_json(o[..],inputs[..],"");jo_end(o[..]);
  file:[1]Buf;bput(file[..],dir);bput(file[..],"/qualification.json");
  if o[0].bad || !fs_write(btext(file[..]),jo_text(o[..])) {return 1;}
  print("%\n", ifx all then "holds" else "fails");
  return ifx all then 0 else 1;
}

#forall "tick qualification refuses missing samples and includes the stated p95 limit" sample:-1..<842, which:0..<2 {
  limits:=[2]int.[600,840];limit:=limits[which];#assert dr_tick_ok(sample,limit)==(sample>=0 && sample<=limit);
}
dr_tick_ok :: (sample:int,limit:int)->bool {return sample>=0 && sample<=limit;}
dr_tick_parse :: (text:string,out:[]int)->int {
  if text.count==0 {return 0;}start:=0;count:=0;
  for end:0..<text.count+1 {
    if end<text.count && text[end]!=',' {continue;}
    if count>=out.count {return -1;}sample:=args_whole(text[start..<end]);
    if sample<0 {return -1;}out[count]=sample;count+=1;start=end+1;
  }
  return count;
}
dr_tick_quantile :: (samples:[]const int,per_mille:int)->int {
  if samples.count<1 || samples.count>8192 || per_mille<1 || per_mille>1000 {return -1;}
  ordered:[8192]int;
  for sample,i:samples {
    if sample<0 {return -1;}at:=i;
    while at>0 && ordered[at-1]>sample {ordered[at]=ordered[at-1];at-=1;}
    ordered[at]=sample;
  }
  return ordered[(samples.count*per_mille+999)/1000-1];
}

#test "worker qualification takes the nearest-rank percentile of every collected tick" {
  values:[100]int;for i:0..<100 {values[i]=100-i;}
  #assert dr_tick_quantile(values[..],500)==50 && dr_tick_quantile(values[..],950)==95;
  #assert dr_tick_quantile(values[..],990)==99 && dr_tick_quantile(values[..],1000)==100;
  #assert dr_tick_quantile(values[0..<0],950)== -1;
  #assert dr_tick_quantile(values[..],0)== -1 && dr_tick_quantile(values[..],1001)== -1;
  values[0]= -1;#assert dr_tick_quantile(values[..],950)== -1;
  out:[3]int;
  #assert dr_tick_parse("0,600,1000000",out[..])==3 && out[0]==0 && out[1]==600 && out[2]==1000000;
  #assert dr_tick_parse("",out[..])==0 && dr_tick_parse("600,",out[..])== -1;
  #assert dr_tick_parse("-1",out[..])== -1 && dr_tick_parse("NaN",out[..])== -1;
  #assert dr_tick_parse("1,2,3,4",out[..])== -1;
}
#forall "one slow tick in twenty fits p95; a second does not" slow:0..<21 {
  values:[20]int;for i:0..<20 {values[i]=ifx i<slow then 601 else 1;}
  #assert dr_tick_ok(dr_tick_quantile(values[..],950),600)==(slow<=1);
}
