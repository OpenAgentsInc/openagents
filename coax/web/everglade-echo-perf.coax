// Everglade's frame time with Echo on screen (docs/verse/2026-11-06-native-hero-characters.md, R4;
// GitHub #12988): the page in real time in headless Chrome, its frames timed by the host's frame
// trace (coax/web/host.js coaxialFrameTrace: each frame's start, whether it was drawn or held back
// because the GPU had frames in flight, the CPU's part of it), judged by the 60 FPS rule (aethyr/frame-report.coax: more than 30 frames, the
// 95th percentile at most 17.5 ms, none over 33 ms).
//   coax/web/tool.sh coax/web/everglade-echo-perf.coax URL SHOT SIZE
//     SHOT close   URL ?stage=echo: N starts her orbit; its first 1.2 s, the camera within about
//                  1.3 m of her face
//     SHOT medium  URL ?stage=echo: the orbit's held last frame, 3.6 m out on her and the player, 5 s
//     SHOT wide    URL ?raid=preview&stage=echo (#12996): the raid's own camera from her first cast, 5 s;
//                  URL ?raid=preview alone: the raid with no Echo, 20 s in, to compare
//     SIZE 1080 (1920x1080) or 720 (1280x720), at dpr 1
// A frame's time is from one drawn frame to the next, so a frame the host held back (frame admission)
// counts in the next drawn one's time. Prints one line: the drawn frames, frames a second, the frame
// time's median, 95th percentile and longest, the frames held back, the CPU's and the GPU's (the
// host's latest submit-to-done time, coaxial_frame_admit's measure) medians and 95th percentiles, the hair's share, her strand segments drawn and whether the shot holds 60 FPS. Exit 0 when it holds, 1 when it
// doesn't, 2 on bad usage.
// A hero qualification also requires ready character draws and the exact
// requested raster. Empty, suppressed or downscaled scenes remain diagnostics.
#load "valley-capture.coax";
#load "../../aethyr/frame-report.coax";
#load "everglade-echo-proof.coax";

EP_FRAMES :: 1200;

// The trace's rows, "gap:cpu:gpu:drawn,...|probe" (the gap since the last frame, the CPU's part and
// the GPU's latest completion time in whole microseconds, drawn 1 or 0), as drawn frames: each one's
// time since the drawn frame before it (the first drawn frame starts the count and has none), its CPU
// part and the GPU time. Returns how many; the rows held back are added to `held`.
ep_parse :: (t: string, gap: [] int, cpu: [] int, gpu: [] int, held: [] int) -> int {
  n := 0; field := 0; v := 0; since := 0; started := false; row_gap := 0; row_cpu := 0; row_gpu := 0;negative:=false;
  for ch: t {
    if ch == '|' { break; }
    if ch=='-' {negative=true;continue;}
    if ch >= '0' && ch <= '9' { v = v * 10 + cast(int) (ch - '0'); continue; }
    if ch == ':' || ch == ',' {
      value:=ifx negative then -v else v;
      if field == 0 { row_gap = value; } else if field == 1 { row_cpu = value; } else if field == 2 { row_gpu = value; }
      else {
        since += row_gap;
        if value == 1 {
          if started && n < gap.count { gap[n] = since; cpu[n] = row_cpu; gpu[n] = row_gpu; n += 1; }
          started = true; since = 0;
        } else if started { held[0] += 1; }
      }
      v = 0;negative=false;
      if ch == ':' { field += 1; } else { field = 0; }
    }
  }
  return n;
}
ep_ms :: (us: int) -> f64 { return cast(f64) us / 1000.0; }
#test "Echo performance suffix separates groom counts from actual raster dimensions" {
 p:=ep_probe("1:2:3:1,|4/9274/1920/1080");#assert p[0]==4 && p[1]==9274 && p[2]==1920 && p[3]==1080;
 p=ep_probe("1:2:3:1,|4/9274/1920/1080/12/1");#assert p[4]==12 && p[5]==1;
 p=ep_probe("1:2:3:1,|35/82638");#assert p[0]==35 && p[1]==82638 && p[2]==0 && p[3]==0;
}
ep_probe :: (text:string)->[6]int {out:[6]int;field:=0;started:=false;for ch:text {if ch=='|' {started=true;continue;}if !started {continue;}if ch=='/' {field+=1;continue;}if field<6 && ch>='0' && ch<='9' {out[field]=out[field]*10+cast(int)(ch-'0');}}return out;}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || (args_count(a[..]) != 3 && args_count(a[..]) != 4) { print("usage: everglade-echo-perf URL close|medium|wide 1080|720 [no-character]\n"); return 2; }
  hide:=args_count(a[..])==4 && args_at(a[..],3)=="no-character";
  if args_count(a[..])==4 && !hide {return 2;}
  shot := args_at(a[..], 1); big := args_at(a[..], 2) == "1080";
  if shot != "close" && shot != "medium" && shot != "wide" { print("everglade-echo-perf: SHOT is close, medium or wide\n"); return 2; }
  width := ifx big then 1920 else 1280; height := ifx big then 1080 else 720;
  c: [1] Cdp;
  if !cdp_launch_background(c[..], width, height, "echo-perf-") { return 1; }
  _ := cdp_call(c[..], "Page.enable", "", 30000);
  _ = cdp_call(c[..], "Emulation.setDeviceMetricsOverride", ifx big then "{\"width\":1920,\"height\":1080,\"deviceScaleFactor\":1,\"mobile\":false}" else "{\"width\":1280,\"height\":720,\"deviceScaleFactor\":1,\"mobile\":false}", 30000);
  b: [4096] u8; j: [1] Jo;
  jo_start(j[..], b[..]); jo_obj(j[..]); jo_key(j[..], "source");
  jo_str(j[..], "globalThis.coaxialFrameTrace=true;globalThis.faceErrors=[];const ce=console.error;console.error=(...a)=>{faceErrors.push(a.map(String).join(' '));ce(...a)}");
  jo_end(j[..]); _ = cdp_call(c[..], "Page.addScriptToEvaluateOnNewDocument", jo_text(j[..]), 30000);
  if hide {
    print("DIAGNOSTIC: Echo draw calls suppressed; room, spells, lights and resident resources unchanged (not a hero FPS qualification)\n");
    glue:[8192]u8;gn:=fs_read("coax/web/everglade-echo-isolate.js",glue[..]);#assert gn>0;
    params:[16384]u8;jo_start(j[..],params[..]);jo_obj(j[..]);jo_key(j[..],"source");jo_str(j[..],cast(string)glue[0..<gn]);jo_end(j[..]);#assert cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument",jo_text(j[..]),30000)>=0;
  }
  jo_start(j[..], b[..]); jo_obj(j[..]); jo_key(j[..], "url"); jo_str(j[..], args_at(a[..], 0)); jo_end(j[..]);
  _ = cdp_call(c[..], "Page.navigate", jo_text(j[..]), 30000);
  // the town drawn and her pass ready (a 1 GB pack)
  ready := false; until := proc_now_ms() + 240000;
  while proc_now_ms() < until {
    n := cdp_evaluate(c[..], "!!globalThis.coaxial?.ready&&coaxial.sceneReady");
    world:=n>=0 && jv_raw(c[0].doc[0],n)=="true";
    wanted:=false;loaded:=false;
    if world {
      n=cdp_evaluate(c[..],"new URL(location.href).searchParams.get('stage')==='echo'");wanted=n>=0 && jv_raw(c[0].doc[0],n)=="true";
      n=cdp_evaluate(c[..],"globalThis.coaxial?.character?.().status==='ready'");loaded=n>=0 && jv_raw(c[0].doc[0],n)=="true";
    }
    if ep_wait_ready(world,wanted,loaded) { ready = true; break; }
    failed:=cdp_evaluate(c[..],"globalThis.coaxial?.character?.().status==='failed'");
    if failed>=0 && jv_raw(c[0].doc[0],failed)=="true" {print("FAIL character pass failed to load\n");cdp_close(c[..]);return 1;}
    proc_sleep(100);
  }
  if !ready { print("FAIL the page (and her pass) never came ready\n"); cdp_close(c[..]); return 1; }
  adapter:=cdp_evaluate(c[..],CDP_ADAPTER_JS);if adapter>=0 {print("adapter: %\n",jv_raw(c[0].doc[0],adapter));}
  hardware:=cdp_evaluate(c[..],CDP_HARDWARE_JS);if hardware<0 || jv_raw(c[0].doc[0],hardware)!="true" {print("FAIL hardware WebGPU required\n");cdp_close(c[..]);return 1;}
  proc_sleep(2000);   // settle: her first uploads, the pipelines' first use
  ms := 5000;
  if shot == "close" { pressed := fc_key(c[..], "n"); ms = ifx pressed then 1200 else 0; }
  if shot == "medium" { pressed := fc_key(c[..], "n"); proc_sleep(ifx pressed then 10000 else 0); }
  on := cdp_evaluate(c[..], "coaxial.character?.().status==='ready'");
  echo := on >= 0 && jv_raw(c[0].doc[0], on) == "true";
  // a raid with no Echo (no stage=echo): the raid's own camera 20 s in, for comparison
  if shot == "wide" && !echo { proc_sleep(20000); }
  if shot == "wide" && echo {
    // her first cast (her pass's wind-up share, probe 10, over 0), three minutes at most
    casting := false; until = proc_now_ms() + 180000;
    while !casting && proc_now_ms() < until {
      n := cdp_evaluate(c[..], "(coaxial.character().probe?.[10]??0)>0");
      casting = n >= 0 && jv_raw(c[0].doc[0], n) == "true";
      if !casting { proc_sleep(20); }
    }
    if !casting { print("FAIL she never cast\n"); cdp_close(c[..]); return 1; }
  }
  // the measuring script, with its length in milliseconds
  script: [1024] u8; k := 0;
  head := "(async()=>{coaxial.takeFrameTrace();const t0=performance.now();await new Promise(r=>{const f=()=>{if(performance.now()-t0<";
  tail := ")requestAnimationFrame(f);else r()};requestAnimationFrame(f)});const t=coaxial.takeFrameTrace();return t.map(r=>Math.round(r[0]*1000)+':'+Math.round(r[4]*1000)+':'+Math.round(r[8]*1000)+':'+r[7]).join(',')+',|'+(coaxial.character?.()?.probe?.[2]??0)+'/'+(coaxial.character?.()?.probe?.[17]??0)+'/'+(t.at(-1)?.[5]??0)+'/'+(t.at(-1)?.[6]??0)+'/'+Math.min(...t.filter(r=>r[7]===1).map(r=>r[11]??0))+'/'+Math.min(...t.filter(r=>r[7]===1).map(r=>r[12]??0))})()";
  for ch: head { script[k] = ch; k += 1; }
  digits: [8] u8; d := 0; v := ms;
  while v > 0 { digits[d] = cast(u8) (48 + v % 10); v /= 10; d += 1; }
  while d > 0 { d -= 1; script[k] = digits[d]; k += 1; }
  for ch: tail { script[k] = ch; k += 1; }
  n := cdp_evaluate(c[..], cast(string) script[0..<k]);
  if n < 0 { print("FAIL %\n", cdp_error(c[..])); cdp_close(c[..]); return 1; }
  text := jv_raw(c[0].doc[0], n);
  gap: [EP_FRAMES] int; cpu: [EP_FRAMES] int; gpu: [EP_FRAMES] int; held: [1] int;
  count := ep_parse(text, gap[..], cpu[..], gpu[..], held[..]);
  f := frame_stats(gap[..], count);
  p := frame_stats(cpu[..], count);
  g := frame_stats(gpu[..], count);
  // after the bar: the hair's share (thousandths) / the strands' segments drawn (groom levels, #12988)
  meta:=ep_probe(text);share:=meta[0];drawn:=meta[1];
  e := cdp_evaluate(c[..], "faceErrors.length===0");
  clean := e >= 0 && jv_raw(c[0].doc[0], e) == "true";
  holds := frame_holds(f);
  live:=cdp_evaluate(c[..],"globalThis.coaxial?.character?.().status==='ready' && (coaxial.character().draws??0)>0");
  present:=echo && live>=0 && jv_raw(c[0].doc[0],live)=="true";
  qualified:=ep_hero_ok(EpHeroProof.{holds=holds,clean=clean,hidden=hide,ready=present,share=share,segments=drawn,width=meta[2],height=meta[3],wanted_width=width,wanted_height=height,world_draws=meta[4],hero_submitted=meta[5]});
  print("confirmed frame provenance: minimum % world draws; hero submitted %\n",meta[4],meta[5]);
  if !present {print("DIAGNOSTIC: no ready Echo draw; not a hero FPS qualification\n");}
  if meta[2]!=width || meta[3]!=height {print("FAIL actual raster differs from the requested raster\n");}
  print("% %x% (render %x%): % frames, % fps; frame p50 % ms, p95 % ms, max % ms; % held back; cpu p50 % ms, p95 % ms; gpu p50 % ms, p95 % ms; hair share %/1000, % strand segments drawn; % %\n",
        shot, width, height, meta[2],meta[3],f.n, cast(f64) frame_fps10(f) / 10.0, ep_ms(f.p50), ep_ms(f.p95), ep_ms(f.max), held[0], ep_ms(p.p50), ep_ms(p.p95), ep_ms(g.p50), ep_ms(g.p95), share, drawn,
        ifx holds then "holds 60 FPS" else "misses 60 FPS", ifx clean then "" else " (console errors)");
  cdp_close(c[..]);
  return ifx qualified then 0 else 1;
}
lo_int :: (a: int, b: int) -> int { return ifx a < b then a else b; }

#test "A frame held back counts in the next drawn frame's time" {
  gap: [4] int; cpu: [4] int; gpu: [4] int; held: [1] int;
  n := ep_parse("0:900:7000:1,16667:1200:7100:1,16700:300:7100:0,16600:1100:7300:1,|250", gap[..], cpu[..], gpu[..], held[..]);
  #assert n == 2 && gap[0] == 16667 && cpu[0] == 1200 && gpu[0] == 7100 && gap[1] == 33300 && cpu[1] == 1100 && gpu[1] == 7300 && held[0] == 1;
  #assert ep_parse("", gap[..], cpu[..], gpu[..], held[..]) == 0;
}

#test "unobserved trace callbacks never count as GPU submissions" {
 gap:[4]int;cpu:[4]int;gpu:[4]int;held:[1]int;
 n:=ep_parse("0:900:7000:1,16667:0:7000:-1,16666:1000:7000:1,|",gap[..],cpu[..],gpu[..],held[..]);#assert n==1 && gap[0]==33333 && held[0]==1;
}
