// Everglade's two-browser smoke (spec section 11.2, GitHub #12711): two headless Chromes open one
// Everglade room of their own and check the shared world, and how smooth it is.
//   coax/web/tool.sh everglade-pair [URL] [--phone] [--size WxH] [--shots PREFIX] [--trials N] [--allow-public-edit]
// URL defaults to https://openagents.com/worlds/everglade; the room is a fresh pair-<hex> (?room=),
// which the rooms list leaves out, and both sessions carry the automation mark pair-check-<hex>
// (the verse-automation cookie), so analytics and the usage counts leave them out too.
// --phone: a 390x844 touch phone at DPR 3 (else --size, default 1440x900 at DPR 1).
// The in-page half, coax/web/everglade-pair.js, notes the page's frames and its socket's frames.
// What it checks, in order (each a line, then one JSON line with every number, then holds/fails):
//   1. both join (ENTER past the CHARACTER picker), each has the other's player (D's p) and who it is
//      (D's n) and draws it (net_probe 2), and the name for its nameplate isn't "-";
//   2. by the spawn: A casts Conjure Animals (bar slot 32); both hear e cast from A's seat and have
//      the pack;
//   3. B casts Starry Wisp (slot 22) at the nearest creature until B's own hit kills one: both hear
//      B's hits and the same e die; both have every seat's WANTED level, the same;
//   4. move latency: A holds W, B's socket gets A somewhere new (--trials, the sessions take turns);
//   5. smoothness while A walks, per phase: frame spacing (p50, p99, long frames), the Coax frame's
//      time, your drawn feet (coaxial_field_probe: speed, its frame-to-frame jerk, snaps past
//      NET_SNAP, re-runs and those that moved you over 5 cm a second), the states' arrival and the
//      other player as drawn (stalls and lurches against the frames around them);
//   6. the jump: A jumps while walking and walks on; A's drawn clip (field probe 4) goes to the jump
//      once and never shows it after, and A's act is walking again on both sockets;
//   7. Reverse Gravity (slot 4, #12733): A casts it, the server's cylinder (an entity from 900000) is
//      on both pages, the server lifts A over 3 m (A's own word and B's D), A's press again ends it;
//   8. INVITE: a third page opens A's link (the page with ?room= A's instance, as INVITE copies it)
//      and must sit in A's instance on A's shard, with A in its state;
//   9. with OA_EVERGLADE_ADMIN_SESSION (an admin's oa_session) and --allow-public-edit: A places a
//      thing in EDIT and publishes; B hears e edit and fetches the world within 2 s. Off by default:
//      it publishes to the realm's world.
// Smoothness numbers are reported, not judged here (everglade-proof.sh judges them); the checks decide
// holds. Nothing opens on screen and no sound plays.
#import "Basic";
#load "../lib/net/cdp.coax";

EP_SHOT :: 25165824;
EP_TRIALS_MAX :: 16;
EP_OUT :: 262144;

Buf :: struct { b: [8192] u8; n: int; bad: bool; }
bput :: (o: [] Buf, s: string) {
  if o[0].n + s.count > o[0].b.count { o[0].bad = true; return; }
  for k: 0..<s.count { o[0].b[o[0].n + k] = s[k]; }
  o[0].n += s.count;
}
bint :: (o: [] Buf, v: int) {
  if v < 0 { bput(o, "-"); bint(o, -v); return; }
  d: [20] u8; n := 0; x := v;
  if x == 0 { d[0] = '0'; n = 1; }
  while x > 0 { d[n] = cast(u8) ('0' + x % 10); x /= 10; n += 1; }
  for k: 0..<n { e: [1] u8; e[0] = d[n - 1 - k]; bput(o, cast(string) e[..]); }
}
btext :: (o: [] Buf) -> string { return cast(string) o[0].b[0..<o[0].n]; }

// scheme://host[:port] of a URL, "" when it has none.
ep_origin :: (url: string) -> string {
  i := 0;
  while i + 2 < url.count && !(url[i] == ':' && url[i + 1] == '/' && url[i + 2] == '/') { i += 1; }
  if i + 2 >= url.count || i == 0 { return ""; }
  j := i + 3;
  while j < url.count && url[j] != '/' && url[j] != '?' && url[j] != '#' { j += 1; }
  return ifx j > i + 3 then url[0..<j] else "";
}
ep_has_query :: (url: string) -> bool { for c: url { if c == '?' { return true; } } return false; }
ep_sorted_mid :: (t: [] int, n: int, q: int) -> int {
  if n <= 0 { return -1; }
  s: [EP_TRIALS_MAX] int; for i: 0..<n { s[i] = t[i]; }
  for i: 1..<n { v := s[i]; j := i - 1; while j >= 0 && s[j] > v { s[j + 1] = s[j]; j -= 1; } s[j + 1] = v; }
  k := (n * q) / 100; if k >= n { k = n - 1; }
  return s[k];
}

#test "the pair smoke's pieces" {
  #assert ep_origin("https://openagents.com/worlds/everglade") == "https://openagents.com" && ep_origin("nope") == "";
  #assert ep_has_query("https://x/a?b=1") && !ep_has_query("https://x/a");
  t: [5] int; t[0] = 400; t[1] = 120; t[2] = 900; t[3] = 300; t[4] = 610;
  #assert ep_sorted_mid(t[..], 5, 50) == 400 && ep_sorted_mid(t[..], 5, 100) == 900 && ep_sorted_mid(t[..], 0, 50) == -1 && t[0] == 400;
  b: [1] Buf; bput(b[..], "__eg.mark('"); bput(b[..], "walk"); bput(b[..], "')"); bint(b[..], -12);
  #assert btext(b[..]) == "__eg.mark('walk')-12";
}

ep_int :: (c: [] Cdp, js: string, fallback: int) -> int {
  v := cdp_evaluate(c, js);
  return ifx v >= 0 then jv_int(cdp_doc(c), v, fallback) else fallback;
}
ep_str :: (c: [] Cdp, js: string, out: [] u8) -> string {
  v := cdp_evaluate(c, js);
  if v < 0 { return ""; }
  n := jv_str(cdp_doc(c), v, out);
  return ifx n > 0 then cast(string) out[0..<n] else "";
}
// A key as the page hears it: a keydown or keyup on window (host.js listens there).
ep_press :: (c: [] Cdp, down: bool, key: string, code: string, vk: int) -> bool {
  q: [1] Buf;
  bput(q[..], "dispatchEvent(new KeyboardEvent('"); bput(q[..], ifx down then "keydown" else "keyup");
  bput(q[..], "', {key: '"); bput(q[..], key); bput(q[..], "', code: '"); bput(q[..], code); bput(q[..], "', keyCode: "); bint(q[..], vk);
  bput(q[..], ", bubbles: true})); 1");
  return ep_int(c, btext(q[..]), 0) == 1;
}
ep_w :: (c: [] Cdp, down: bool) -> bool { return ep_press(c, down, "w", "KeyW", 87); }
ep_escape :: (c: [] Cdp) -> bool { return ep_press(c, true, "Escape", "Escape", 27) && ep_press(c, false, "Escape", "Escape", 27); }
ep_mark :: (ca: [] Cdp, cb: [] Cdp, name: string) {
  q: [1] Buf; bput(q[..], "__eg.mark('"); bput(q[..], name); bput(q[..], "')");
  _ := ep_int(ca, btext(q[..]), 0); _ = ep_int(cb, btext(q[..]), 0);
}

ep_open :: (c: [] Cdp, url: string, origin: string, mark: string, wh: ArgsSize, phone: bool, script: string) -> bool {
  params: [131072] u8; o: [1] Jo;
  jo_start(o[..], params[..]);
  jo_obj(o[..]); jo_key(o[..], "width"); jo_int(o[..], wh.w); jo_key(o[..], "height"); jo_int(o[..], wh.h);
  jo_key(o[..], "deviceScaleFactor"); jo_int(o[..], ifx phone then 3 else 1); jo_key(o[..], "mobile"); jo_bool(o[..], phone); jo_end(o[..]);
  if cdp_call(c, "Emulation.setDeviceMetricsOverride", jo_text(o[..]), CDP_CALL_MS) < 0 { return false; }
  if phone && cdp_call(c, "Emulation.setTouchEmulationEnabled", "{\"enabled\":true,\"maxTouchPoints\":5}", CDP_CALL_MS) < 0 { return false; }
  if cdp_call(c, "Page.enable", "", CDP_CALL_MS) < 0 { return false; }
  if cdp_call(c, "Emulation.setFocusEmulationEnabled", "{\"enabled\":true}", CDP_CALL_MS) < 0 { return false; }
  jo_start(o[..], params[..]);
  jo_obj(o[..]); jo_key(o[..], "name"); jo_str(o[..], "verse-automation"); jo_key(o[..], "value"); jo_str(o[..], mark);
  jo_key(o[..], "url"); jo_str(o[..], origin); jo_end(o[..]);
  if cdp_call(c, "Network.setCookie", jo_text(o[..]), CDP_CALL_MS) < 0 { return false; }
  jo_start(o[..], params[..]); jo_obj(o[..]); jo_key(o[..], "source"); jo_str(o[..], script); jo_end(o[..]);
  if o[0].bad || cdp_call(c, "Page.addScriptToEvaluateOnNewDocument", jo_text(o[..]), CDP_CALL_MS) < 0 { return false; }
  jo_start(o[..], params[..]); jo_obj(o[..]); jo_key(o[..], "url"); jo_str(o[..], url); jo_end(o[..]);
  return !o[0].bad && cdp_call(c, "Page.navigate", jo_text(o[..]), CDP_CALL_MS) >= 0;
}

tool_main :: () -> int #export_c {
  a: [1] Args;
  ok := args_load(a[..]);
  url := args_at(a[..], 0);
  if url.count == 0 || url[0] == '-' { url = "https://openagents.com/worlds/everglade"; }
  phone := args_has(a[..], "--phone");
  wh := args_size(args_value(a[..], "--size", ifx phone then "390x844" else "1440x900"));
  shots := args_value(a[..], "--shots", "");
  trials_n := args_number(args_value(a[..], "--trials", "4"));
  origin := ep_origin(url);
  if !ok || !wh.ok || !trials_n.ok || origin.count == 0 || trials_n.value < 1.0 || trials_n.value > f64(EP_TRIALS_MAX) {
    tool_errln("usage: coax/web/tool.sh everglade-pair [URL] [--phone] [--size WxH] [--shots PREFIX] [--trials 1..16]"); return 2;
  }
  js: [65536] u8;
  jn := fs_read("coax/web/everglade-pair.js", js[..]);
  if jn <= 0 { tool_errln("everglade-pair: can't read coax/web/everglade-pair.js (run it from the repository's root)"); return 2; }
  rnd: [6] u8;
  if !cdp_draw(6, rnd[..]) { tool_errln("everglade-pair: no entropy"); return 1; }
  hex := "0123456789abcdef";
  hx: [1] Buf;
  for b: rnd { h: [2] u8; h[0] = hex[b / 16]; h[1] = hex[b % 16]; bput(hx[..], cast(string) h[..]); }
  mb: [1] Buf; bput(mb[..], "pair-check-"); bput(mb[..], btext(hx[..]));
  ub: [1] Buf; bput(ub[..], url); bput(ub[..], ifx ep_has_query(url) then "&room=pair-" else "?room=pair-"); bput(ub[..], btext(hx[..]));
  ca: [1] Cdp; cb: [1] Cdp;
  if !cdp_launch(ca[..], wh.w, wh.h, "coax-egpair-a-") { tool_err("everglade-pair: "); tool_errln(cdp_error(ca[..])); return 1; }
  if !cdp_launch(cb[..], wh.w, wh.h, "coax-egpair-b-") { tool_err("everglade-pair: "); tool_errln(cdp_error(cb[..])); cdp_close(ca[..]); return 1; }
  // a live admin edit publishes to the realm's world: only with an admin's session, and never on a
  // realm everyone plays unless --allow-public-edit says so
  ab: [4096] u8; admin := proc_getenv("OA_EVERGLADE_ADMIN_SESSION", ab[..]);
  if admin.count > 0 && !args_has(a[..], "--allow-public-edit") { tool_errln("everglade-pair: OA_EVERGLADE_ADMIN_SESSION publishes an edit to the realm everyone plays; add --allow-public-edit to mean it"); return 2; }
  status := ep_run(ca[..], cb[..], btext(ub[..]), origin, btext(mb[..]), wh, phone, cast(string) js[0..<jn], cast(int) trials_n.value, shots, admin);
  cdp_close(ca[..]); cdp_close(cb[..]);
  return status;
}

ep_fail :: (c: [] Cdp, what: string) -> int { tool_err("everglade-pair: "); tool_err(what); tool_err(": "); tool_errln(cdp_error(c)); print("fails\n"); return 1; }
ep_check :: (ok: bool, what: string) -> bool { print("% %\n", ifx ok then "ok  " else "FAIL", what); return ok; }

ep_run :: (ca: [] Cdp, cb: [] Cdp, url: string, origin: string, mark: string, wh: ArgsSize, phone: bool, script: string, trials: int, shots: string, admin: string) -> int {
  if admin.count > 0 {
    params: [8192] u8; o: [1] Jo;
    jo_start(o[..], params[..]); jo_obj(o[..]); jo_key(o[..], "name"); jo_str(o[..], "oa_session"); jo_key(o[..], "value"); jo_str(o[..], admin);
    jo_key(o[..], "url"); jo_str(o[..], origin); jo_end(o[..]);
    if o[0].bad || cdp_call(ca, "Network.setCookie", jo_text(o[..]), CDP_CALL_MS) < 0 { return ep_fail(ca, "setting the admin's session"); }
  }
  if !ep_open(ca, url, origin, mark, wh, phone, script) { return ep_fail(ca, "opening A"); }
  if !ep_open(cb, url, origin, mark, wh, phone, script) { return ep_fail(cb, "opening B"); }
  print("room % (%), mark %, %\n", url, ifx phone then "phone" else "desktop", mark, ifx phone then "390x844 DPR 3" else "DPR 1");
  t_open := proc_now_ms();
  // 1. both in, each with the other's player and name
  live := false;
  deadline := proc_now_ms() + 90000;
  while !live && proc_now_ms() < deadline {
    proc_sleep(500);
    la := ep_int(ca, "__eg.live()", 0) == 1; lb := ep_int(cb, "__eg.live()", 0) == 1;
    // a first visit opens the CHARACTER picker and the socket waits for ENTER
    if !la { _ := ep_press(ca, true, "Enter", "Enter", 13); _ = ep_press(ca, false, "Enter", "Enter", 13); }
    if !lb { _ := ep_press(cb, true, "Enter", "Enter", 13); _ = ep_press(cb, false, "Enter", "Enter", 13); }
    live = la && lb;
  }
  all := ep_check(live, "both pages joined the room");
  if !live {
    dbg: [4096] u8;
    print("A: %\nB: %\n", ep_str(ca, "JSON.stringify({net: __eg.probe(0), seat: __eg.seat, ws: !!__eg.ws, wasm: !!__eg.x, frames: __eg.fr.length})", dbg[..]),
      ep_str(cb, "JSON.stringify({net: __eg.probe(0), seat: __eg.seat, ws: !!__eg.ws, wasm: !!__eg.x, frames: __eg.fr.length})", dbg[..]));
    print("fails\n"); return 1;
  }
  join_ms := proc_now_ms() - t_open;
  seen := false;
  deadline = proc_now_ms() + 20000;
  see_js := "(__eg.otherSeat() >= 0 && __eg.names[__eg.otherSeat()] !== undefined && __eg.probe(2) >= 1) ? 1 : 0";
  while !seen && proc_now_ms() < deadline { proc_sleep(250); seen = ep_int(ca, see_js, 0) == 1 && ep_int(cb, see_js, 0) == 1; }
  sa := ep_int(ca, "__eg.seat", -1); sb := ep_int(cb, "__eg.seat", -1);
  oa := ep_int(ca, "__eg.otherSeat()", -1); ob := ep_int(cb, "__eg.otherSeat()", -1);
  all = ep_check(seen && oa == sb && ob == sa, "each has the other's player and who it is (D's n) and draws its body") && all;
  named := "(() => { const n = __eg.names[__eg.otherSeat()]; return n && n !== '-' ? 1 : 0; })()";
  all = ep_check(ep_int(ca, named, 0) == 1 && ep_int(cb, named, 0) == 1, "each has a name for the other's nameplate (not -)") && all;
  info: [4096] u8; info2: [4096] u8;
  print("  A seat % sees %, drawn %; B seat % sees %, drawn %; names A % B %\n", sa, oa, ep_int(ca, "__eg.probe(2)", -1), sb, ob, ep_int(cb, "__eg.probe(2)", -1),
    ep_str(ca, "JSON.stringify(__eg.names)", info[..]), ep_str(cb, "JSON.stringify(__eg.names)", info[..]));
  proc_sleep(2000);
  _ := ep_escape(ca); _ = ep_escape(cb);
  ep_mark(ca, cb, "idle");
  proc_sleep(4000);
  // 2. near the spawn, before anyone walks off: A casts Conjure Animals; both hear it and have the pack
  ep_mark(ca, cb, "cast");
  went := ep_int(ca, "__eg.cast(32)", 0);
  heard := false; pack := false;
  qc: [1] Buf; bput(qc[..], "__eg.casts.some((c) => c[1] === "); bint(qc[..], sa); bput(qc[..], " && c[2] === 32) ? 1 : 0");
  t_cast := proc_now_ms(); pack_ms := -1;
  deadline = proc_now_ms() + 10000;
  while !(heard && pack) && proc_now_ms() < deadline {
    proc_sleep(200);
    heard = ep_int(ca, btext(qc[..]), 0) == 1 && ep_int(cb, btext(qc[..]), 0) == 1;
    pack = ep_int(ca, "__eg.probe(16)", 0) > 0 && ep_int(cb, "__eg.probe(16)", 0) > 0;
    if pack && pack_ms < 0 { pack_ms = proc_now_ms() - t_cast; }
  }
  all = ep_check(went == 1 && heard && pack, "A's Conjure Animals: both hear the cast and both have the pack") && all;
  print("  sent %, pack on both after % ms, creatures A % B %, casts heard A % B %\n", went, pack_ms, ep_int(ca, "__eg.probe(16)", -1), ep_int(cb, "__eg.probe(16)", -1),
    ep_str(ca, "JSON.stringify(__eg.casts.map((c) => [c[1], c[2]]))", info[..]), ep_str(cb, "JSON.stringify(__eg.casts.map((c) => [c[1], c[2]]))", info2[..]));
  // 3. B fights the pack with Starry Wisp (slot 22) from beside A, until B's own hit kills a creature;
  // both must hear B's hits (BY 1000 + B's seat) and the same creature's e die (WHO 2000 + EID)
  ep_mark(ca, cb, "fight");
  by: [1] Buf; bint(by[..], 1000 + sb);
  qk: [1] Buf; bput(qk[..], "JSON.stringify((() => { const mine = __eg.hits.filter((h) => h[2] === '"); bput(qk[..], btext(by[..]));
  bput(qk[..], "').map((h) => h[1]); return __eg.deaths.map((d) => d[1]).filter((w) => Number(w) >= 2000 && mine.includes(w)); })())");
  dead := false; casts_b := 0; kb: [512] u8; ka: [512] u8;
  deadline = proc_now_ms() + 25000;
  while !dead && proc_now_ms() < deadline {
    casts_b += ep_int(cb, "__eg.cast(22)", 0);
    proc_sleep(900);
    kills_b := ep_str(cb, btext(qk[..]), kb[..]); kills_a := ep_str(ca, btext(qk[..]), ka[..]);
    dead = kills_b.count > 2 && kills_b == kills_a;
  }
  proc_sleep(500);
  da: [512] u8; db: [512] u8;
  deaths_a := ep_str(ca, "JSON.stringify(__eg.deaths.map((d) => d[1]))", da[..]); deaths_b := ep_str(cb, "JSON.stringify(__eg.deaths.map((d) => d[1]))", db[..]);
  all = ep_check(dead, "a kill agrees: B's Starry Wisp kills a creature and both hear B's hits and the same e die") && all;
  print("  B cast % times; B's kills on A % on B %; deaths A % B %; B refused %\n", casts_b, ep_str(ca, btext(qk[..]), ka[..]), ep_str(cb, btext(qk[..]), kb[..]), deaths_a, deaths_b,
    ep_str(cb, "JSON.stringify(__eg.refused.slice(-4).map((r) => r[1]))", info[..]));
  wa: [512] u8; wb: [512] u8;
  wanted_a := ep_str(ca, "JSON.stringify(__eg.wanted)", wa[..]); wanted_b := ep_str(cb, "JSON.stringify(__eg.wanted)", wb[..]);
  wq: [1] Buf; bput(wq[..], "(() => { const o = "); bput(wq[..], ifx wanted_b.count > 0 then wanted_b else "{}"); bput(wq[..], ", m = __eg.wanted; for (const k of Object.keys(o)) if (k in m && m[k] !== o[k]) return 0; return ("); bint(wq[..], sa); bput(wq[..], " in o) && ("); bint(wq[..], sb); bput(wq[..], " in m) ? 1 : 2; })()");
  wv := ep_int(ca, btext(wq[..]), 0);
  all = ep_check(wv == 1, "WANTED agrees: each has the other's level, and where both have a seat's they match") && all;
  print("  WANTED A % B %; your own (net_probe 24) A % B %\n", wanted_a, wanted_b, ep_int(ca, "__eg.probe(24)", -9), ep_int(cb, "__eg.probe(24)", -9));
  // 4. move latency: the mover's key down to the watcher's socket having it somewhere new
  ep_mark(ca, cb, "trials");
  took: [EP_TRIALS_MAX] int; n_took := 0;
  for k: 0..<trials {
    mover := ifx k % 2 == 0 then ca else cb; watcher := ifx k % 2 == 0 then cb else ca;
    ms := ifx k % 2 == 0 then sa else sb;
    proc_sleep(1200);
    t0 := ep_int(mover, "Math.round(__eg.now())", -1);
    if t0 < 0 || !ep_w(mover, true) { return ep_fail(mover, "pressing W"); }
    q: [1] Buf; bput(q[..], "__eg.movedSince("); bint(q[..], t0); bput(q[..], ", "); bint(q[..], ms); bput(q[..], ")");
    pressed := proc_now_ms(); got := -1; up := false;
    while got < 0 && proc_now_ms() < pressed + 5000 {
      proc_sleep(30);
      got = ep_int(watcher, btext(q[..]), -1);
      if !up && proc_now_ms() > pressed + 800 { up = ep_w(mover, false); }
    }
    if !up { up = ep_w(mover, false); }
    took[k] = got; n_took += 1;
    print("  % moves, % has it: % ms\n", ifx k % 2 == 0 then "A" else "B", ifx k % 2 == 0 then "B" else "A", got);
  }
  proc_sleep(1200);
  missed := 0; for k: 0..<n_took { if took[k] < 0 { missed += 1; } }
  lat50 := ep_sorted_mid(took[..], n_took, 50); latmax := ep_sorted_mid(took[..], n_took, 100);
  all = ep_check(missed == 0 && latmax < 500, "move latency (key down to the other's socket): every trial under 500 ms") && all;
  // 5. A walks 6 s
  ep_mark(ca, cb, "walk");
  if !ep_w(ca, true) { return ep_fail(ca, "pressing W"); }
  proc_sleep(6000);
  // 6. A jumps while walking, then walks on
  ep_mark(ca, cb, "jump");
  tj := ep_int(ca, "Math.round(__eg.now())", -1);
  _ = ep_press(ca, true, " ", "Space", 32); proc_sleep(120); _ = ep_press(ca, false, " ", "Space", 32);
  tu := ep_int(ca, "Math.round(__eg.now())", -1) + 200;   // a jump pressed goes out with the next step or two
  proc_sleep(1800);
  ep_mark(ca, cb, "after_jump");
  tl := ep_int(ca, "Math.round(__eg.now())", -1);
  proc_sleep(1500);
  te := ep_int(ca, "Math.round(__eg.now())", -1);
  _ = ep_w(ca, false);
  ep_mark(ca, cb, "stand");
  // the drawn pose on A's page (coaxial_field_probe 3 and 4), and A's act on both sockets
  qa: [1] Buf; bput(qa[..], "__eg.jumpCheck("); bint(qa[..], tj); bput(qa[..], ", "); bint(qa[..], tl); bput(qa[..], ", "); bint(qa[..], te); bput(qa[..], ")");
  qs: [1] Buf; bput(qs[..], "(() => { const j = JSON.parse(__eg.actsSince("); bint(qs[..], tj);
  bput(qs[..], ")), l = JSON.parse(__eg.actsSince("); bint(qs[..], tl);
  bput(qs[..], ")), u = JSON.parse(__eg.actsSince("); bint(qs[..], tu);
  bput(qs[..], ")); const walked = (r) => r.length > 0 && r.slice(0, Math.max(1, r.length - 4)).every((x) => (x[0] === 1 || x[0] === 2) && (x[1] & 1));");
  bput(qs[..], " return JSON.stringify({ jumped: j.mine.some((x) => x[0] === 3), walked: walked(l.mine), jump_bits_after_up: u.jump_bits }); })()");
  qb: [1] Buf; bput(qb[..], "(() => { const l = JSON.parse(__eg.actsSince("); bint(qb[..], tl); bput(qb[..], ")).others['"); bint(qb[..], sa);
  bput(qb[..], "'] || []; return JSON.stringify({ walked: l.length > 0 && l.slice(0, Math.max(1, l.length - 4)).every((x) => (x[0] === 1 || x[0] === 2) && (x[1] & 1)) }); })()");
  ja: [4096] u8; js: [4096] u8; jb: [4096] u8;
  pose_a := ep_str(ca, btext(qa[..]), ja[..]); wire_a := ep_str(ca, btext(qs[..]), js[..]); wire_b := ep_str(cb, btext(qb[..]), jb[..]);
  print("  jump, A's drawn pose: %\n  jump, A's socket: %; B's socket: %\n", pose_a, wire_a, wire_b);
  qp: [1] Buf; bput(qp[..], "(() => { const p = "); bput(qp[..], ifx pose_a.count > 0 then pose_a else "{}"); bput(qp[..], ", a = ");
  bput(qp[..], ifx wire_a.count > 0 then wire_a else "{}"); bput(qp[..], ", b = "); bput(qp[..], ifx wire_b.count > 0 then wire_b else "{}");
  bput(qp[..], "; return p.jumped && p.into_jump === 1 && p.stuck_frames === 0 && p.frames_after > 30 && a.jumped && a.walked && a.jump_bits_after_up === 0 && b.walked ? 1 : 0; })()");
  all = ep_check(ep_int(ca, btext(qp[..]), 0) == 1, "the jump: A's drawn clip goes to the jump once and, walking on, never shows it again; A's act is walking again on both sockets") && all;
  proc_sleep(1500);
  // 7. A casts Reverse Gravity where it stands: the server's cylinder is an entity on both pages, and
  // the server lifts A (its own word on A, and B's), then A's press again ends it and A comes down
  ep_mark(ca, cb, "reverse_gravity");
  y0 := ep_int(ca, "__eg.probe(20)", -999999);
  tr := ep_int(cb, "Math.round(__eg.now())", -1);
  rg_went := ep_int(ca, "__eg.cast(4)", 0);
  rg_both := false; top_a := -999999; top_b := -999999;
  deadline = proc_now_ms() + 6000;
  qr: [1] Buf; bput(qr[..], "__eg.topSince("); bint(qr[..], tr); bput(qr[..], ", "); bint(qr[..], sa); bput(qr[..], ")");
  while proc_now_ms() < deadline && !(rg_both && top_a > y0 + 300 && top_b > y0 + 300) {
    proc_sleep(200);
    rg_both = ep_int(ca, "__eg.madeFrom(900000)", 0) > 0 && ep_int(cb, "__eg.madeFrom(900000)", 0) > 0;
    ya := ep_int(ca, "__eg.probe(20)", -999999); if ya > top_a { top_a = ya; }
    top_b = ep_int(cb, btext(qr[..]), -999999);
  }
  all = ep_check(rg_went == 1 && rg_both, "A's Reverse Gravity: its cylinder is the server's entity on both pages") && all;
  all = ep_check(top_a > y0 + 300 && top_b > y0 + 300, "Reverse Gravity lifts A on the server: A's own word and B's have A over 3 m up") && all;
  print("  A's y before % cm, highest: A's word % cm, B's % cm\n", y0, top_a, top_b);
  rg_off := ep_int(ca, "__eg.cast(4)", 0);
  gone := false;
  deadline = proc_now_ms() + 6000;
  while !gone && proc_now_ms() < deadline { proc_sleep(200); gone = ep_int(ca, "__eg.madeFrom(900000)", 1) == 0 && ep_int(cb, "__eg.madeFrom(900000)", 1) == 0; }
  proc_sleep(3000);
  y1 := ep_int(ca, "__eg.probe(20)", -999999);
  all = ep_check(rg_off == 1 && gone && y1 < y0 + 100, "A's press again ends it on both pages and A comes down") && all;
  print("  A's y after % cm\n", y1);
  // B walks 4 s, so A has a moving remote body too
  ep_mark(ca, cb, "walk_b");
  _ = ep_w(cb, true); proc_sleep(4000); _ = ep_w(cb, false);
  ep_mark(ca, cb, "end");
  // 8. INVITE's link: the page's address with ?room= and A's instance; a third page opens it and must
  // sit in A's instance (the same code, on the same shard's socket path) with A in its state
  inv_ok := false;
  code_b: [256] u8; code := ep_str(ca, "__eg.code || ''", code_b[..]);
  sock_b: [512] u8; sock_a := ep_str(ca, "__eg.wsUrl || ''", sock_b[..]);
  if code.count > 0 {
    lb: [1] Buf; bput(lb[..], origin); bput(lb[..], "/worlds/everglade?room="); bput(lb[..], code);
    cc: [1] Cdp;
    if cdp_launch(cc[..], wh.w, wh.h, "coax-egpair-c-") {
      if ep_open(cc[..], btext(lb[..]), origin, mark, wh, phone, script) {
        dl := proc_now_ms() + 90000; in := false;
        qi: [1] Buf; bput(qi[..], "(__eg.live() && (__eg.others['"); bint(qi[..], sa); bput(qi[..], "'] || []).length > 0) ? 1 : 0");
        while !in && proc_now_ms() < dl { proc_sleep(700); _ = ep_press(cc[..], true, "Enter", "Enter", 13); _ = ep_press(cc[..], false, "Enter", "Enter", 13); in = ep_int(cc[..], btext(qi[..]), 0) == 1; }
        cb2: [256] u8; sc: [512] u8;
        code_c := ep_str(cc[..], "__eg.code || ''", cb2[..]); sock_c := ep_str(cc[..], "__eg.wsUrl || ''", sc[..]);
        inv_ok = in && code_c == code && sock_c == sock_a;
        dc: [1024] u8;
        print("  INVITE link %: C sits in % (%), A is in % (%); C live %, has A %\n", btext(lb[..]), code_c, sock_c, code, sock_a,
          ep_int(cc[..], "__eg.live()", -1), ep_str(cc[..], "JSON.stringify({seat: __eg.seat, others: Object.keys(__eg.others), net: __eg.probe(0), frames: __eg.fr.length, d: __eg.d.length})", dc[..]));
      }
      cdp_close(cc[..]);
    }
  }
  all = ep_check(inv_ok, "INVITE: a page opening A's ?room= link lands in A's instance, on A's shard, and has A") && all;
  // 9. live admin edits (opt in): A, an admin (OA_EVERGLADE_ADMIN_SESSION, its oa_session), places a
  // thing and publishes (B: EDIT, 1: the first thing, B: DONE publishes at once); B's socket hears
  // e edit and B's page fetches the world within 2 s
  if admin.count > 0 {
    ep_mark(ca, cb, "edit");
    t_e := ep_int(cb, "Math.round(__eg.now())", -1);
    _ = ep_press(ca, true, "b", "KeyB", 66); _ = ep_press(ca, false, "b", "KeyB", 66); proc_sleep(600);
    _ = ep_press(ca, true, "1", "Digit1", 49); _ = ep_press(ca, false, "1", "Digit1", 49); proc_sleep(600);
    t_pub := ep_int(cb, "Math.round(__eg.now())", -1);
    _ = ep_press(ca, true, "b", "KeyB", 66); _ = ep_press(ca, false, "b", "KeyB", 66);
    proc_sleep(2500);
    qe: [1] Buf; bput(qe[..], "(() => { const e = __eg.edits.find((x) => x[0] >= "); bint(qe[..], t_e); bput(qe[..], "), g = __eg.worldGets.find((x) => x[0] >= ");
    bint(qe[..], t_e); bput(qe[..], "); return e && g ? Math.round(Math.max(e[0], g[0]) - "); bint(qe[..], t_pub); bput(qe[..], ") : -1; })()");
    shown := ep_int(cb, btext(qe[..]), -1);
    all = ep_check(shown >= 0 && shown <= 2000, "a live admin edit: B hears e edit and fetches the world within 2 s of A's DONE") && all;
    print("  edit reached B after % ms\n", shown);
  } else {
    print("skip a live admin edit (no OA_EVERGLADE_ADMIN_SESSION: an admin's oa_session; it publishes to the realm's world)\n");
  }
  if shots.count > 0 {
    png: [EP_SHOT] u8;
    for s: 0..<2 {
      c := ifx s == 0 then ca else cb;
      p: [1] Buf; bput(p[..], shots); bput(p[..], ifx s == 0 then "-a.png" else "-b.png");
      n := cdp_screenshot(c, png[..]);
      if n > 0 && fs_write(btext(p[..]), cast(string) png[0..<n]) { print("  %\n", btext(p[..])); }
    }
  }
  ra: [EP_OUT] u8; rb: [EP_OUT] u8;
  print("{\"viewport\":\"%\",\"join_ms\":%,\"move_latency_ms\":{\"p50\":%,\"max\":%,\"missed\":%},\"a\":%,\"b\":%}\n",
    ifx phone then "phone" else "desktop", join_ms, lat50, latmax, missed, ep_str(ca, "__eg.report()", ra[..]), ep_str(cb, "__eg.report()", rb[..]));
  print("%\n", ifx all then "holds" else "fails");
  return ifx all then 0 else 1;
}
