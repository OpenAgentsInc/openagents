// Everglade II's crowd check (#13057): N headless Chromes (2 to 3: the machine's cap) take the whole
// journey into one Everglade II room of their own, as players do, and say what each saw and how
// smooth the others were.
//   coax/web/tool.sh everglade2-crowd URL [--players N] [--seconds S] [--size WxH] [--room CODE] [--shot DIR] [--cast] [--layer] [--rest] [--levels]
// URL is the Character Create page (…/worlds/character-creator), with ?relay=ws://localhost:PORT for a
// local room (coax/web/room/local.coax); the room is a fresh pair-e2-<hex> (?room=), which the rooms
// list leaves out, unless --room names one (a load run's pair-e2-load-STAMP-1, to stand among its
// bots; then one page is enough). Every session carries the automation mark pair-check-<hex> (the verse-automation cookie), so
// analytics and the usage counts leave them out.
// The journey, each step a line, then one JSON line per page with every number, then holds/fails:
//   1. each page opens Character Create, page K presses SURPRISE ME K times (e2_probe 60, 61), so each is
//      someone different, takes the name Crowd Alpha, Bravo or Charlie in NAME (e2_probe 62 to 65; the
//      first tries "http x" first, which must be said and not sent), and presses USE IN EVERGLADE (its
//      box from e2_probe 56, 57); every page then has every other's chosen name (e2_probe 66 + K);
//   2. each is seated in the room (e2_probe 40 open, 41 a seat) within 10 s, while its run plays;
//   3. each draws the other N - 1 players (e2_probe 42) during the run, by its end;
//   4. after the run each holds W for S seconds, then stands; the window's numbers (everglade2-crowd.js:
//      frame spacing and Coax time, the first other's drawn speed, its stalls and lurches, the re-runs
//      and their largest move, names drawn) are reported per page. The checks: everyone seated and
//      seen, every other's name known (e2_probe 53), and names drawn over heads on the way (e2_probe 16's
//      most in a frame, everglade2-crowd.js namesMax).
//   --cast, once the runs end and before the walk: each page presses its class bar's first two slots
//      (keys 1 and 2) in turn, EC_CASTS presses 1.2 s apart (#13058). The checks: every cast went to
//      the room (e2_probe 82) and came back to its page (88), every page played every other's (83: as
//      many as the others sent), and each cast played its sounds (89, the sound lines written).
//   --rest, after --cast and before the walk: each page in turn presses its rest controls over the bar
//      (#13046) by mouse, at the centres e2_probe 34 to 37 give, and the room says each answer (e2_probe
//      30, the z code): LONG REST puts you asleep (3), and W then moves you nothing; WATCH (4); END REST,
//      then END REST again if the rest is broken (6), leaves no rest (0); SHORT REST (1), and walking
//      breaks it (0 again). With --shot, DIR/rest-asleep-K.jpg and DIR/rest-short-K.jpg.
//   --levels (#13046): in Character Create page 0 picks FIGHTER at LEVEL 5 and page 1 BARBARIAN at
//      LEVEL 3 by mouse (e2_probe 100 to 104); after the run each hears its level's bar from the room
//      (105, 106, 110 + i); page 0's Action Surge (key 3) is taken and its count drops; page 1's Rage
//      (key 1) is taken and holds (120), and a second Rage is refused by the room, and its predicted
//      sound and puffs are undone and fade (107, 108). With --shot, DIR/levels-K.jpg.
//   --layer, after the runs and before the walk: page 0 runs (W held) and casts (key 1), and with --shot
//      DIR/layer-run-0..2.jpg are three of its frames mid-cast (the legs in the run's stride, the arms
//      casting: everglade/scene/bodies.coax bd_layer) and DIR/layer-remote-1.jpg page 1's view of it; then it
//      stands, casts again, and DIR/layer-stand-0.jpg is the standing cast, the whole body's.
// Nothing opens on screen and no sound plays. Each Chrome this starts is closed before it exits.
#import "Basic";
#load "../lib/net/cdp.coax";

E2C_MAX :: 3;

Buf :: struct { b: [8192] u8; n: int; bad: bool; }
bput :: (o: [] Buf, s: string) {
  if o[0].n + s.count > o[0].b.count { o[0].bad = true; return; }
  for k: 0..<s.count { o[0].b[o[0].n + k] = s[k]; }
  o[0].n += s.count;
}
bint :: (o: [] Buf, v: int) {
  if v < 0 { bput(o, "-"); bint(o, -v); return; }
  d: [20] u8; n := 0; x := v;
  if x == 0 { d[0] = '0'; n = 1; }
  while x > 0 { d[n] = cast(u8) ('0' + x % 10); x /= 10; n += 1; }
  for k: 0..<n { e: [1] u8; e[0] = d[n - 1 - k]; bput(o, cast(string) e[..]); }
}
btext :: (o: [] Buf) -> string { return cast(string) o[0].b[0..<o[0].n]; }
ec_origin :: (url: string) -> string {
  i := 0;
  while i + 2 < url.count && !(url[i] == ':' && url[i + 1] == '/' && url[i + 2] == '/') { i += 1; }
  if i + 2 >= url.count || i == 0 { return ""; }
  j := i + 3;
  while j < url.count && url[j] != '/' && url[j] != '?' && url[j] != '#' { j += 1; }
  return ifx j > i + 3 then url[0..<j] else "";
}
ec_has_query :: (url: string) -> bool { for c: url { if c == '?' { return true; } } return false; }
#test "the crowd check's URL pieces" {
  #assert ec_origin("http://127.0.0.1:8811/worlds/character-creator?relay=ws://localhost:8938") == "http://127.0.0.1:8811";
  #assert ec_origin("nope") == "" && ec_has_query("https://x/a?b=1") && !ec_has_query("https://x/a");
}
ec_int :: (c: [] Cdp, js: string, fallback: int) -> int {
  v := cdp_evaluate(c, js);
  return ifx v >= 0 then jv_int(cdp_doc(c), v, fallback) else fallback;
}
ec_str :: (c: [] Cdp, js: string, out: [] u8) -> string {
  v := cdp_evaluate(c, js);
  if v < 0 { return ""; }
  n := jv_str(cdp_doc(c), v, out);
  return ifx n > 0 then cast(string) out[0..<n] else "";
}
ec_probe :: (c: [] Cdp, f: int) -> int { q: [1] Buf; bput(q[..], "__e2.probe("); bint(q[..], f); bput(q[..], ")"); return ec_int(c, btext(q[..]), -1); }
ec_key :: (c: [] Cdp, down: bool) -> bool {
  return cdp_call(c, "Input.dispatchKeyEvent", ifx down then "{\"type\":\"keyDown\",\"key\":\"w\",\"code\":\"KeyW\",\"windowsVirtualKeyCode\":87,\"nativeVirtualKeyCode\":87,\"text\":\"w\"}" else "{\"type\":\"keyUp\",\"key\":\"w\",\"code\":\"KeyW\",\"windowsVirtualKeyCode\":87,\"nativeVirtualKeyCode\":87}", CDP_CALL_MS) >= 0;
}
// Typed text, as a keyboard's (into the host's keyboard field when it has focus), and Enter.
ec_type :: (c: [] Cdp, t: string) -> bool {
  params: [256] u8; o: [1] Jo; jo_start(o[..], params[..]); jo_obj(o[..]); jo_key(o[..], "text"); jo_str(o[..], t); jo_end(o[..]);
  return cdp_call(c, "Input.insertText", jo_text(o[..]), CDP_CALL_MS) >= 0;
}
ec_enter :: (c: [] Cdp) -> bool {
  a := cdp_call(c, "Input.dispatchKeyEvent", "{\"type\":\"keyDown\",\"key\":\"Enter\",\"code\":\"Enter\",\"windowsVirtualKeyCode\":13,\"nativeVirtualKeyCode\":13}", CDP_CALL_MS) >= 0;
  return cdp_call(c, "Input.dispatchKeyEvent", "{\"type\":\"keyUp\",\"key\":\"Enter\",\"code\":\"Enter\",\"windowsVirtualKeyCode\":13,\"nativeVirtualKeyCode\":13}", CDP_CALL_MS) >= 0 && a;
}
// The names the pages take (Character Create's NAME), and the probes' hash of a name (everglade/client/client.coax e2_name_hash).
EC_NAMES :: [3] string.["Crowd Alpha", "Crowd Bravo", "Crowd Charlie"];
ec_hash :: (t: string) -> int { h := 2166136261; for ch: t { h = ((h ^ cast(int) ch) * 16777619) & 0xffffffff; } return h & 0x7fffffff; }
// NAME: pressed, the old text cleared, t typed and Enter; then its answer waited for (e2_probe 65).
ec_name :: (p: [] Cdp, t: string) -> bool {
  ec_class_tab(p);
  nx := ec_probe(p, 62); ny := ec_probe(p, 63);
  if nx <= 0 || ny <= 0 || !ec_click(p, nx, ny) { return false; }
  proc_sleep(200);
  for q: 0..<24 { _ := cdp_call(p, "Input.dispatchKeyEvent", "{\"type\":\"keyDown\",\"key\":\"Backspace\",\"code\":\"Backspace\",\"windowsVirtualKeyCode\":8,\"nativeVirtualKeyCode\":8}", CDP_CALL_MS); }
  if !ec_type(p, t) || !ec_enter(p) { return false; }
  deadline := proc_now_ms() + 5000;
  proc_sleep(100);
  while ec_probe(p, 65) == 1 && proc_now_ms() < deadline { proc_sleep(100); }
  return ec_probe(p, 65) == 0;
}
ec_click :: (c: [] Cdp, x: int, y: int) -> bool {
  q: [1] Buf;
  bput(q[..], "(() => { for (const t of ['pointerdown', 'pointerup']) dispatchEvent(new PointerEvent(t, {clientX: "); bint(q[..], x);
  bput(q[..], ", clientY: "); bint(q[..], y); bput(q[..], ", pointerId: 1, pointerType: 'mouse', isPrimary: true, button: 0, buttons: 1, bubbles: true})); return 1; })()");
  return ec_int(c, btext(q[..]), 0) == 1;
}
ec_open :: (c: [] Cdp, url: string, origin: string, mark: string, w: int, h: int, script: string) -> bool {
  params: [131072] u8; o: [1] Jo;
  jo_start(o[..], params[..]);
  jo_obj(o[..]); jo_key(o[..], "width"); jo_int(o[..], w); jo_key(o[..], "height"); jo_int(o[..], h);
  jo_key(o[..], "deviceScaleFactor"); jo_int(o[..], 1); jo_key(o[..], "mobile"); jo_bool(o[..], false); jo_end(o[..]);
  if cdp_call(c, "Emulation.setDeviceMetricsOverride", jo_text(o[..]), CDP_CALL_MS) < 0 { return false; }
  if cdp_call(c, "Page.enable", "", CDP_CALL_MS) < 0 { return false; }
  if cdp_call(c, "Emulation.setFocusEmulationEnabled", "{\"enabled\":true}", CDP_CALL_MS) < 0 { return false; }
  jo_start(o[..], params[..]);
  jo_obj(o[..]); jo_key(o[..], "name"); jo_str(o[..], "verse-automation"); jo_key(o[..], "value"); jo_str(o[..], mark);
  jo_key(o[..], "url"); jo_str(o[..], origin); jo_end(o[..]);
  if cdp_call(c, "Network.setCookie", jo_text(o[..]), CDP_CALL_MS) < 0 { return false; }
  jo_start(o[..], params[..]); jo_obj(o[..]); jo_key(o[..], "source"); jo_str(o[..], script); jo_end(o[..]);
  if o[0].bad || cdp_call(c, "Page.addScriptToEvaluateOnNewDocument", jo_text(o[..]), CDP_CALL_MS) < 0 { return false; }
  jo_start(o[..], params[..]); jo_obj(o[..]); jo_key(o[..], "url"); jo_str(o[..], url); jo_end(o[..]);
  return !o[0].bad && cdp_call(c, "Page.navigate", jo_text(o[..]), CDP_CALL_MS) >= 0;
}
// --shot DIR: each page's picture (JPEG) as it draws the others: DIR/run-K.jpg while the runs play and
// DIR/walk-K.jpg once all stand after the walk, to look at the bodies and the names over them.
ec_shot :: (c: [] Cdp, dir: string, what: string, k: int) {
  if dir.count == 0 { return; }
  r := cdp_call(c, "Page.captureScreenshot", "{\"format\":\"jpeg\",\"quality\":85}", CDP_CALL_MS);
  dd := cdp_doc(c); data := jv_get(dd, r, "data");
  if r < 0 || jv_kind(dd, data) != JV_STRING { print("  no picture from page %: %\n", k, cdp_error(c)); return; }
  pic: [4194304] u8;
  n := b64_decode(jv_raw(dd, data), pic[..]);
  q: [1] Buf; bput(q[..], dir); bput(q[..], "/"); bput(q[..], what); bput(q[..], "-"); bint(q[..], k); bput(q[..], ".jpg");
  if n > 0 && fs_write(btext(q[..]), cast(string) pic[0..<n]) { print("  picture %\n", btext(q[..])); }
}
EC_CASTS :: 4;
// A digit key pressed and let go (the class bar's slot keys, everglade/client/cast.coax e2k_key).
ec_digit :: (c: [] Cdp, d: int) -> bool {
  q: [1] Buf;
  bput(q[..], "{\"type\":\"keyDown\",\"key\":\""); bint(q[..], d); bput(q[..], "\",\"code\":\"Digit"); bint(q[..], d);
  bput(q[..], "\",\"windowsVirtualKeyCode\":"); bint(q[..], 48 + d); bput(q[..], ",\"nativeVirtualKeyCode\":"); bint(q[..], 48 + d); bput(q[..], ",\"text\":\""); bint(q[..], d); bput(q[..], "\"}");
  down := cdp_call(c, "Input.dispatchKeyEvent", btext(q[..]), CDP_CALL_MS) >= 0;
  u: [1] Buf;
  bput(u[..], "{\"type\":\"keyUp\",\"key\":\""); bint(u[..], d); bput(u[..], "\",\"code\":\"Digit"); bint(u[..], d);
  bput(u[..], "\",\"windowsVirtualKeyCode\":"); bint(u[..], 48 + d); bput(u[..], ",\"nativeVirtualKeyCode\":"); bint(u[..], 48 + d); bput(u[..], "}");
  return cdp_call(c, "Input.dispatchKeyEvent", btext(u[..]), CDP_CALL_MS) >= 0 && down;
}
// --cast: every page casts EC_CASTS times (with --shot, DIR/cast-K.jpg just after the first); each page's probes then (sent, its own back, others' played, sounds).
ec_casts :: (c: [] Cdp, shot: string) -> bool {
  n := c.count;
  for q: 0..<EC_CASTS {
    for i: 0..<n { _ := ec_digit(c[i..<i + 1], 1 + q % 2); }
    if q == 0 { proc_sleep(300); for i: 0..<n { ec_shot(c[i..<i + 1], shot, "cast", i); } proc_sleep(900); } else { proc_sleep(1200); }
  }
  proc_sleep(2000);
  sent: [E2C_MAX] int; back: [E2C_MAX] int; played: [E2C_MAX] int; sounds: [E2C_MAX] int; total := 0;
  for i: 0..<n { p := c[i..<i + 1]; sent[i] = ec_probe(p, 82); back[i] = ec_probe(p, 88); played[i] = ec_probe(p, 83); sounds[i] = ec_probe(p, 89); total += sent[i]; }
  all_sent := true; all_back := true; all_played := true; all_heard := true;
  for i: 0..<n {
    want := total - sent[i];
    print("  page %: casts sent %, its own back from the room %, others' played % of %, cast sounds played %\n", i, sent[i], back[i], played[i], want, sounds[i]);
    if sent[i] < EC_CASTS { all_sent = false; }
    if back[i] != sent[i] { all_back = false; }
    if played[i] < want { all_played = false; }
    if sounds[i] < sent[i] + played[i] { all_heard = false; }
  }
  ok := ec_check(all_sent, "every page cast its class bar's slots (keys 1 and 2) and sent each to the room");
  ok = ec_check(all_back, "the room took every cast and said each back to its caster (e cast)") && ok;
  ok = ec_check(all_played, "every page played every other page's casts where it is drawn") && ok;
  ok = ec_check(all_heard, "every cast played its sound on every page") && ok;
  return ok;
}
// --layer: a cast on the run (three frames of it, and page 1's view of it), then one standing.
ec_layer :: (c: [] Cdp, shot: string) -> bool {
  p := c[0..<1];
  sent := ec_probe(p, 82);
  _ := ec_key(p, true); proc_sleep(1500);
  _ = ec_digit(p, 1);
  proc_sleep(250); ec_shot(p, shot, "layer-run", 0);
  if c.count > 1 { ec_shot(c[1..<2], shot, "layer-remote", 1); }
  ec_shot(p, shot, "layer-run", 1);
  proc_sleep(150); ec_shot(p, shot, "layer-run", 2);
  proc_sleep(1500); _ = ec_key(p, false); proc_sleep(2000);
  _ = ec_digit(p, 1); proc_sleep(500); ec_shot(p, shot, "layer-stand", 0);
  proc_sleep(2000);
  return ec_check(ec_probe(p, 82) >= sent + 2, "page 0 cast on the run and standing, and sent both to the room");
}
// The rest controls (#13046): their codes and requests as the room and the rules have them
// (everglade-wire.coax WIRE_REST_*, aethyr/rules/srd/rest-control.coax RS_REST_*).
EC_NONE :: 0; EC_SHORT :: 1; EC_SLEEP :: 3; EC_WATCH :: 4; EC_BROKEN :: 6;
EC_R_SHORT :: 1; EC_R_SLEEP :: 2; EC_R_WATCH :: 3; EC_R_END :: 4;
// The room's rest code once it is one of want or other (-2 for none), within ms.
ec_rest_wait :: (p: [] Cdp, want: int, other: int, ms: int) -> int {
  deadline := proc_now_ms() + ms;
  while proc_now_ms() < deadline { r := ec_probe(p, 30); if r == want || r == other { return r; } proc_sleep(100); }
  r := ec_probe(p, 30); return ifx r == want || r == other then r else -2;
}
// Presses the first (last false) or the last rest control when it asks req; false when it doesn't.
ec_rest_press :: (p: [] Cdp, req: int, last: bool) -> bool {
  if ec_probe(p, ifx last then 33 else 32) != req { return false; }
  // the choices are in REST's menu, which your portrait opens (e2_probe 132, 133: what to press toward
  // it, your portrait and then REST's row where the portrait has a menu of its own; 134 the menu open, 2 REST)
  for step: 0..<2 { if ec_probe(p, 134) != 2 { bx := ec_probe(p, 132); by := ec_probe(p, 133); if bx <= 0 || by <= 0 || !ec_click(p, bx, by) { return false; } proc_sleep(150); } }
  x := ec_probe(p, ifx last then 36 else 34); y := ec_probe(p, ifx last then 37 else 35);
  return x > 0 && y > 0 && ec_click(p, x, y);
}
ec_rest_page :: (p: [] Cdp, i: int, shot: string) -> bool {
  ready := ec_rest_wait(p, EC_NONE, EC_NONE, 10000) == EC_NONE && ec_probe(p, 31) == 2;
  print("  page %: rest code %, controls % (% and %)\n", i, ec_probe(p, 30), ec_probe(p, 31), ec_probe(p, 32), ec_probe(p, 33));
  ok := ec_check(ready, "the room said this page's rest, and REST offers SHORT REST and LONG REST over the bar");
  if !ready { return false; }
  slept := ec_rest_press(p, EC_R_SLEEP, true) && ec_rest_wait(p, EC_SLEEP, EC_SLEEP, 4000) == EC_SLEEP;
  ok = ec_check(slept, "LONG REST: the room puts you asleep (z 3)") && ok;
  x0 := ec_probe(p, 38); z0 := ec_probe(p, 5);
  _ := ec_key(p, true); proc_sleep(1500); _ = ec_key(p, false); proc_sleep(500);
  x1 := ec_probe(p, 38); z1 := ec_probe(p, 5);
  print("  page %: W asleep moved you (% cm, % cm), code %\n", i, x1 - x0, z1 - z0, ec_probe(p, 30));
  ec_shot(p, shot, "rest-asleep", i);
  ok = ec_check(slept && x1 - x0 < 5 && x0 - x1 < 5 && z1 - z0 < 5 && z0 - z1 < 5 && ec_probe(p, 30) == EC_SLEEP, "asleep, W moves you nothing and you stay asleep") && ok;
  watch := ec_rest_press(p, EC_R_WATCH, false) && ec_rest_wait(p, EC_WATCH, EC_WATCH, 4000) == EC_WATCH;
  ok = ec_check(watch, "WATCH: the room has you on watch (z 4)") && ok;
  ended := ifx ec_rest_press(p, EC_R_END, true) then ec_rest_wait(p, EC_NONE, EC_BROKEN, 4000) else -2;
  broke := ended == EC_BROKEN;
  if broke { ended = ifx ec_rest_press(p, EC_R_END, true) then ec_rest_wait(p, EC_NONE, EC_NONE, 4000) else -2; }
  print("  page %: END REST %, then code %\n", i, ifx broke then "broke the rest, END REST again" else "ended it", ended);
  ok = ec_check(ended == EC_NONE && ec_probe(p, 31) == 2, "END REST: no rest, and SHORT REST and LONG REST show again (z 0)") && ok;
  short := ec_rest_press(p, EC_R_SHORT, false) && ec_rest_wait(p, EC_SHORT, EC_SHORT, 4000) == EC_SHORT;
  ok = ec_check(short, "SHORT REST: the room has you resting (z 1)") && ok;
  ec_shot(p, shot, "rest-short", i);
  _ = ec_key(p, true); proc_sleep(1500); _ = ec_key(p, false);
  walked := ec_rest_wait(p, EC_NONE, EC_BROKEN, 4000);
  x2 := ec_probe(p, 38); z2 := ec_probe(p, 5);
  print("  page %: walking in a Short Rest moved you (% cm, % cm), code %\n", i, x2 - x1, z2 - z1, walked);
  ok = ec_check(walked == EC_NONE && (x2 - x1) * (x2 - x1) + (z2 - z1) * (z2 - z1) > 100 * 100, "walking breaks the Short Rest (z 0), and you walk") && ok;
  return ok;
}
ec_rests :: (c: [] Cdp, shot: string) -> bool {
  ok := true;
  for i: 0..<c.count { ok = ec_rest_page(c[i..<i + 1], i, shot) && ok; }
  return ok;
}
ec_check :: (ok: bool, what: string) -> bool { print("% %\n", ifx ok then "ok  " else "FAIL", what); return ok; }

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  ok := args_load(a[..]);
  url := args_at(a[..], 0);
  players := args_number(args_value(a[..], "--players", "3"));
  seconds := args_number(args_value(a[..], "--seconds", "20"));
  wh := args_size(args_value(a[..], "--size", "1280x720"));
  room := args_value(a[..], "--room", "");
  shot := args_value(a[..], "--shot", "");
  casts := args_has(a[..], "--cast"); layer := args_has(a[..], "--layer"); rests := args_has(a[..], "--rest"); levels := args_has(a[..], "--levels");
  origin := ec_origin(url);
  if !ok || url.count == 0 || url[0] == '-' || origin.count == 0 || !players.ok || !seconds.ok || !wh.ok || players.value < (ifx room.count > 0 then 1.0 else 2.0) || players.value > f64(E2C_MAX) || seconds.value < 3 {
    tool_errln("usage: coax/web/tool.sh everglade2-crowd URL [--players 2..3, or 1 with --room] [--seconds S >= 3] [--size WxH] [--room CODE] [--shot DIR] [--cast] [--layer] [--rest] [--levels] (from the repository's root)"); return 2;
  }
  js: [65536] u8;
  jn := fs_read("coax/web/everglade2-crowd.js", js[..]);
  if jn <= 0 { tool_errln("everglade2-crowd: can't read coax/web/everglade2-crowd.js (run it from the repository's root)"); return 2; }
  rnd: [6] u8;
  if !cdp_draw(6, rnd[..]) { tool_errln("everglade2-crowd: no entropy"); return 1; }
  hex := "0123456789abcdef";
  hx: [1] Buf;
  for b: rnd { h: [2] u8; h[0] = hex[b / 16]; h[1] = hex[b % 16]; bput(hx[..], cast(string) h[..]); }
  mb: [1] Buf; bput(mb[..], "pair-check-"); bput(mb[..], btext(hx[..]));
  ub: [1] Buf; bput(ub[..], url); bput(ub[..], ifx ec_has_query(url) then "&room=" else "?room=");
  if room.count > 0 { bput(ub[..], room); } else { bput(ub[..], "pair-e2-"); bput(ub[..], btext(hx[..])); bput(ub[..], "-1"); }   // the instance, as the API names it
  n := cast(int) players.value;
  c: [E2C_MAX] Cdp;
  up := 0;
  for i: 0..<n {
    if !cdp_launch(c[i..<i + 1], wh.w, wh.h, "coax-e2crowd-") { tool_err("everglade2-crowd: "); tool_errln(cdp_error(c[i..<i + 1])); break; }
    up += 1;
  }
  status := ifx up == n then ec_run(c[0..<n], btext(ub[..]), origin, btext(mb[..]), wh.w, wh.h, cast(string) js[0..<jn], cast(int) seconds.value, shot, casts, layer, rests, levels) else 1;
  for i: 0..<up { cdp_close(c[i..<i + 1]); }
  return status;
}

ec_run :: (c: [] Cdp, url: string, origin: string, mark: string, w: int, h: int, script: string, seconds: int, shot: string, casts: bool, layer: bool, rests: bool, levels: bool) -> int {
  n := c.count;
  for i: 0..<n { if !ec_open(c[i..<i + 1], url, origin, mark, w, h, script) { tool_errln("everglade2-crowd: can't open a page"); print("fails\n"); return 1; } }
  print("room %, % players, mark %\n", url, n, mark);
  // 1. Character Create, then USE IN EVERGLADE on each
  picked: [E2C_MAX] bool; pressed: [E2C_MAX] bool; t_press: [E2C_MAX] int; named_ok: [E2C_MAX] bool; refused_said := false;
  deadline := proc_now_ms() + 60000;
  left := n;
  while left > 0 && proc_now_ms() < deadline {
    proc_sleep(500);
    for i: 0..<n {
      if pressed[i] { continue; }
      p := c[i..<i + 1];
      if ec_probe(p, 20) != 1 { continue; }   // the studio drawn
      bx := ec_probe(p, 56); by := ec_probe(p, 57);
      if bx <= 0 || by <= 0 { continue; }
      proc_sleep(300);
      // each page after the first is someone different: SURPRISE ME (e2_probe 60, 61), once per page number
      sx := ec_probe(p, 60); sy := ec_probe(p, 61);
      if sx > 0 && sy > 0 { for k: 0..<i { _ := ec_click(p, sx, sy); proc_sleep(250); } }
      // each page names itself (NAME); the first tries an address first, which is said and changes nothing
      if !named_ok[i] {
        if i == 0 { _ := ec_name(p, "http x"); refused_said = ec_probe(p, 64) > 0 && ec_probe(p, 65) == 0; }
        named_ok[i] = ec_name(p, EC_NAMES[i]) && ec_probe(p, 64) == 0;
      }
      if levels && i < 2 && !picked[i] { picked[i] = ec_pick(p, EC_LV_CLASS[i], EC_LV_LEVEL[i]); }
      _ := ec_click(p, bx, by);
      proc_sleep(400);
      if ec_probe(p, 21) == 1 || ec_probe(p, 25) == 1 { pressed[i] = true; t_press[i] = proc_now_ms(); left -= 1; }
    }
  }
  all := ec_check(left == 0, "every page pressed USE IN EVERGLADE and its run began");
  names_taken := true; for i: 0..<n { if !named_ok[i] { names_taken = false; } }
  all = ec_check(refused_said, "a refused name (an address) is said, and nothing is sent") && all;
  all = ec_check(names_taken, "every page took its name in Character Create (NAME, the API's player/name)") && all;
  if levels { all = ec_check(picked[0] && picked[1], "page 0 picked FIGHTER at LEVEL 5 and page 1 BARBARIAN at LEVEL 3 with the mouse") && all; }
  if left > 0 {
    for i: 0..<n { p := c[i..<i + 1]; print("  page %: studio % button (%, %) walking % kept % frames %\n", i, ec_probe(p, 20), ec_probe(p, 56), ec_probe(p, 57), ec_probe(p, 21), ec_probe(p, 25), ec_int(p, "__e2.fr.length", -1)); }
    print("fails\n"); return 1;
  }
  // 2. seated while the run plays
  seated: [E2C_MAX] int; for i: 0..<n { seated[i] = -1; }
  deadline = proc_now_ms() + 10000; left = n;
  while left > 0 && proc_now_ms() < deadline {
    proc_sleep(100);
    for i: 0..<n { if seated[i] < 0 && ec_probe(c[i..<i + 1], 40) == 2 && ec_probe(c[i..<i + 1], 41) >= 0 { seated[i] = proc_now_ms() - t_press[i]; left -= 1; } }
  }
  all = ec_check(left == 0, "every page is seated in the room while its run plays") && all;
  for i: 0..<n { p := c[i..<i + 1]; print("  page % seat % after % ms, running %; room state % want % joined % look % tries % frames in %\n", i, ec_probe(p, 41), seated[i], ec_probe(p, 22), ec_probe(p, 40), ec_probe(p, 50), ec_probe(p, 51), ec_probe(p, 52), ec_probe(p, 49), ec_probe(p, 48)); }
  // 3. everyone draws everyone else, during the run
  for i: 0..<n { _ := ec_int(c[i..<i + 1], "__e2.mark()", 0); }
  seen := false; deadline = proc_now_ms() + 15000; during := false;
  while !seen && proc_now_ms() < deadline {
    proc_sleep(250);
    seen = true; any_running := false;
    for i: 0..<n { if ec_probe(c[i..<i + 1], 42) < n - 1 { seen = false; } if ec_probe(c[i..<i + 1], 22) == 1 { any_running = true; } }
    if seen && any_running { during = true; }
  }
  all = ec_check(seen, "every page draws every other player") && all;
  // each page has every other page's name, as it was set: how long after the last seat
  t_named := -1; deadline = proc_now_ms() + 5000; t_last := proc_now_ms();
  while t_named < 0 && proc_now_ms() < deadline {
    have := true;
    for i: 0..<n { for j: 0..<n {
      if i == j { continue; }
      found := false; for k: 0..<16 { if ec_probe(c[i..<i + 1], 66 + k) == ec_hash(EC_NAMES[j]) { found = true; break; } }
      if !found { have = false; }
    } }
    if have { t_named = proc_now_ms() - t_last; } else { proc_sleep(100); }
  }
  all = ec_check(t_named >= 0, "every page has every other's chosen name") && all;
  print("  names in % ms after every page drew every other\n", t_named);
  print("  seen while a run played: %\n", ifx during then "yes" else "no (the runs had ended)");
  for i: 0..<n { ec_shot(c[i..<i + 1], shot, "run", i); }
  // the runs end (they hand the walk to you)
  deadline = proc_now_ms() + 40000;
  done := false;
  while !done && proc_now_ms() < deadline { proc_sleep(500); done = true; for i: 0..<n { if ec_probe(c[i..<i + 1], 22) == 1 { done = false; } } }
  run_report: [E2C_MAX * 2048] u8; rn: [E2C_MAX] int; ro: [E2C_MAX] int;
  for i: 0..<n {
    t := ec_str(c[i..<i + 1], "__e2.report()", run_report[i * 2048..<(i + 1) * 2048]); ro[i] = i * 2048; rn[i] = t.count;
  }
  if casts { all = ec_casts(c, shot) && all; }
  if layer { all = ec_layer(c, shot) && all; }
  if rests { all = ec_rests(c, shot) && all; }
  if levels { all = ec_levels(c, shot) && all; }
  // 4. all walk on together (W), then stand
  for i: 0..<n { _ := ec_int(c[i..<i + 1], "__e2.mark()", 0); pressed_w := ec_key(c[i..<i + 1], true); }
  proc_sleep(seconds * 1000);
  for i: 0..<n { _ := ec_key(c[i..<i + 1], false); }
  proc_sleep(3000);
  walk_report: [E2C_MAX * 2048] u8; wn: [E2C_MAX] int;
  plates := true;
  for i: 0..<n {
    t := ec_str(c[i..<i + 1], "__e2.report()", walk_report[i * 2048..<(i + 1) * 2048]); wn[i] = t.count;
    if ec_probe(c[i..<i + 1], 42) < n - 1 { plates = false; }
  }
  // names: every page has every other's name, and drew names over heads on the way (an other near
  // and ahead of its camera: a name behind you is rightly not drawn, so this is the journey's most)
  named := 0; for i: 0..<n { if ec_probe(c[i..<i + 1], 53) >= n - 1 && ec_int(c[i..<i + 1], "__e2.namesMax", 0) > 0 { named += 1; } }
  for i: 0..<n { p := c[i..<i + 1]; print("  page %: named others %, bodies for names %, names drawn now %, most in a frame %, draws %\n", i, ec_probe(p, 53), ec_probe(p, 17), ec_probe(p, 16), ec_int(p, "__e2.namesMax", 0), ec_probe(p, 0)); }
  // interest (#13058): the others in view, how many came into it and faded in, any pop (a body cut off
  // while more than a quarter showed) and those fading out now (e2_probe 42, 18, 19, 87)
  pops := 0;
  for i: 0..<n { p := c[i..<i + 1]; pops += ec_probe(p, 19); print("  page %: others drawn %, came into view and faded in %, pops %, fading out now %\n", i, ec_probe(p, 42), ec_probe(p, 18), ec_probe(p, 19), ec_probe(p, 87)); }
  all = ec_check(pops == 0, "nobody popped in or out (each faded)") && all;
  for i: 0..<n { ec_shot(c[i..<i + 1], shot, "walk", i); }
  all = ec_check(plates, "every page still draws every other player after the walk") && all;
  all = ec_check(named == n, "every page has every other's name and draws names over their heads") && all;
  print("{\"players\":%,\"pages\":[", n);
  for i: 0..<n {
    if i > 0 { print(","); }
    print("{\"seat\":%,\"seated_ms\":%,\"run\":%,\"walk\":%}", ec_probe(c[i..<i + 1], 41), seated[i],
      ifx rn[i] > 0 then cast(string) run_report[ro[i]..<ro[i] + rn[i]] else "null", ifx wn[i] > 0 then cast(string) walk_report[i * 2048..<i * 2048 + wn[i]] else "null");
  }
  print("]}\n%\n", ifx all then "holds" else "fails");
  return ifx all then 0 else 1;
}

// --levels (#13046): the classes and levels pages 0 and 1 pick (E2C_CLASS_NAMES: BARBARIAN 0, FIGHTER 4)
EC_LV_CLASS :: [2] int.[4, 0]; EC_LV_LEVEL :: [2] int.[5, 3];
// On a phone's studio, NAME, CLASS and LEVEL are on the CLASS tab (e2_probe 130, 131): pressed when it is not showing.
ec_class_tab :: (p: [] Cdp) {
  if ec_probe(p, 62) > 0 { return; }
  tx := ec_probe(p, 130); ty := ec_probe(p, 131);
  if tx > 0 && ty > 0 { _ := ec_click(p, tx, ty); proc_sleep(200); }
}
// CLASS, then LEVEL, pressed on their right halves until they say klass and level.
ec_pick :: (p: [] Cdp, klass: int, level: int) -> bool {
  ec_class_tab(p);
  for q: 0..<12 { if ec_probe(p, 28) == klass { break; } _ := ec_click(p, ec_probe(p, 102), ec_probe(p, 103)); proc_sleep(200); }
  for q: 0..<6 { if ec_probe(p, 104) == level { break; } _ := ec_click(p, ec_probe(p, 100), ec_probe(p, 101)); proc_sleep(200); }
  print("  page: class % level % picked\n", ec_probe(p, 28), ec_probe(p, 104));
  return ec_probe(p, 28) == klass && ec_probe(p, 104) == level;
}
// Waits until probe f is want (or ms pass); its last value.
ec_until :: (p: [] Cdp, f: int, want: int, ms: int) -> int {
  deadline := proc_now_ms() + ms;
  while proc_now_ms() < deadline { v := ec_probe(p, f); if v == want { return v; } proc_sleep(100); }
  return ec_probe(p, f);
}
ec_levels :: (c: [] Cdp, shot: string) -> bool {
  f := c[0..<1]; b := c[1..<2];
  known := ec_until(f, 106, 1, 8000) == 1 && ec_until(b, 106, 1, 8000) == 1;
  print("  page 0: bar % slots, room's word %, Action Surge left %; page 1: bar % slots, Rage left %\n", ec_probe(f, 105), ec_probe(f, 106), ec_probe(f, 112), ec_probe(b, 105), ec_probe(b, 110));
  ok := ec_check(known && ec_probe(f, 105) == 4 && ec_probe(b, 105) == 4, "each page hears its own level's bar from the room (b), 4 slots each");
  surge := ec_probe(f, 112); back := ec_probe(f, 88);
  k1 := ec_digit(f, 3);
  took := ec_until(f, 88, back + 1, 3000) == back + 1; proc_sleep(600);
  print("  page 0: Action Surge taken %, left % then %\n", took, surge, ec_probe(f, 112));
  ok = ec_check(took && ec_probe(f, 112) == surge - 1, "the level 5 Fighter's Action Surge is taken and its on-icon count drops by one") && ok;
  back = ec_probe(b, 88); undone := ec_probe(b, 107);
  k2 := ec_digit(b, 1);
  raged := ec_until(b, 88, back + 1, 3000) == back + 1 && ec_until(b, 120, 1, 2000) == 1;
  ec_shot(b, shot, "levels", 1); ec_shot(f, shot, "levels", 0);
  proc_sleep(1200);
  k3 := ec_digit(b, 1);
  faded := 0; deadline := proc_now_ms() + 3000;
  while proc_now_ms() < deadline && ec_probe(b, 107) == undone { proc_sleep(20); }
  faded = ec_probe(b, 108); proc_sleep(500);
  print("  page 1: Rage taken and holds %, second Rage undone % (fades going %, then %), casts back %\n", raged, ec_probe(b, 107) - undone, faded, ec_probe(b, 108), ec_probe(b, 88) - back);
  ok = ec_check(raged, "the level 3 Barbarian's Rage is taken and its icon says it holds") && ok;
  ok = ec_check(ec_probe(b, 107) == undone + 1 && ec_probe(b, 88) == back + 1 && ec_probe(b, 108) == 0, "a second Rage is refused by the room; its predicted sound and puffs are undone and faded out") && ok;
  return ok;
}
