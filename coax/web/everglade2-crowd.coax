// Everglade II's crowd check (#13057): N headless Chromes (2 to 3: the machine's cap) take the whole
// journey into one Everglade II room of their own, as players do, and say what each saw and how
// smooth the others were.
//   coax/web/tool.sh everglade2-crowd URL [--players N] [--seconds S] [--size WxH] [--room CODE]
// URL is the Character Create page (…/worlds/character-creator), with ?relay=ws://localhost:PORT for a
// local room (coax/web/room/local.coax); the room is a fresh pair-e2-<hex> (?room=), which the rooms
// list leaves out, unless --room names one (a load run's pair-e2-load-STAMP-1, to stand among its
// bots). Every session carries the automation mark pair-check-<hex> (the verse-automation cookie), so
// analytics and the usage counts leave them out.
// The journey, each step a line, then one JSON line per page with every number, then holds/fails:
//   1. each page opens Character Create and presses USE IN EVERGLADE (its box from e2_probe 56, 57);
//   2. each is seated in the room (e2_probe 40 open, 41 a seat) within 10 s, while its run plays;
//   3. each draws the other N - 1 players (e2_probe 42) during the run, by its end;
//   4. after the run each holds W for S seconds, then stands; the window's numbers (everglade2-crowd.js:
//      frame spacing and Coax time, the first other's drawn speed, its stalls and lurches, the re-runs
//      and their largest move, names drawn) are reported per page. The checks: everyone seated and
//      seen, and names drawn over the others (e2_probe 53) while they stand near.
// Nothing opens on screen and no sound plays. Each Chrome this starts is closed before it exits.
#import "Basic";
#load "../lib/net/cdp.coax";

E2C_MAX :: 3;

Buf :: struct { b: [8192] u8; n: int; bad: bool; }
bput :: (o: [] Buf, s: string) {
  if o[0].n + s.count > o[0].b.count { o[0].bad = true; return; }
  for k: 0..<s.count { o[0].b[o[0].n + k] = s[k]; }
  o[0].n += s.count;
}
bint :: (o: [] Buf, v: int) {
  if v < 0 { bput(o, "-"); bint(o, -v); return; }
  d: [20] u8; n := 0; x := v;
  if x == 0 { d[0] = '0'; n = 1; }
  while x > 0 { d[n] = cast(u8) ('0' + x % 10); x /= 10; n += 1; }
  for k: 0..<n { e: [1] u8; e[0] = d[n - 1 - k]; bput(o, cast(string) e[..]); }
}
btext :: (o: [] Buf) -> string { return cast(string) o[0].b[0..<o[0].n]; }
ec_origin :: (url: string) -> string {
  i := 0;
  while i + 2 < url.count && !(url[i] == ':' && url[i + 1] == '/' && url[i + 2] == '/') { i += 1; }
  if i + 2 >= url.count || i == 0 { return ""; }
  j := i + 3;
  while j < url.count && url[j] != '/' && url[j] != '?' && url[j] != '#' { j += 1; }
  return ifx j > i + 3 then url[0..<j] else "";
}
ec_has_query :: (url: string) -> bool { for c: url { if c == '?' { return true; } } return false; }
#test "the crowd check's URL pieces" {
  #assert ec_origin("http://127.0.0.1:8811/worlds/character-creator?relay=ws://localhost:8938") == "http://127.0.0.1:8811";
  #assert ec_origin("nope") == "" && ec_has_query("https://x/a?b=1") && !ec_has_query("https://x/a");
}
ec_int :: (c: [] Cdp, js: string, fallback: int) -> int {
  v := cdp_evaluate(c, js);
  return ifx v >= 0 then jv_int(cdp_doc(c), v, fallback) else fallback;
}
ec_str :: (c: [] Cdp, js: string, out: [] u8) -> string {
  v := cdp_evaluate(c, js);
  if v < 0 { return ""; }
  n := jv_str(cdp_doc(c), v, out);
  return ifx n > 0 then cast(string) out[0..<n] else "";
}
ec_probe :: (c: [] Cdp, f: int) -> int { q: [1] Buf; bput(q[..], "__e2.probe("); bint(q[..], f); bput(q[..], ")"); return ec_int(c, btext(q[..]), -1); }
ec_key :: (c: [] Cdp, down: bool) -> bool {
  return cdp_call(c, "Input.dispatchKeyEvent", ifx down then "{\"type\":\"keyDown\",\"key\":\"w\",\"code\":\"KeyW\",\"windowsVirtualKeyCode\":87,\"nativeVirtualKeyCode\":87,\"text\":\"w\"}" else "{\"type\":\"keyUp\",\"key\":\"w\",\"code\":\"KeyW\",\"windowsVirtualKeyCode\":87,\"nativeVirtualKeyCode\":87}", CDP_CALL_MS) >= 0;
}
ec_click :: (c: [] Cdp, x: int, y: int) -> bool {
  q: [1] Buf;
  bput(q[..], "(() => { for (const t of ['pointerdown', 'pointerup']) dispatchEvent(new PointerEvent(t, {clientX: "); bint(q[..], x);
  bput(q[..], ", clientY: "); bint(q[..], y); bput(q[..], ", pointerId: 1, pointerType: 'mouse', isPrimary: true, button: 0, buttons: 1, bubbles: true})); return 1; })()");
  return ec_int(c, btext(q[..]), 0) == 1;
}
ec_open :: (c: [] Cdp, url: string, origin: string, mark: string, w: int, h: int, script: string) -> bool {
  params: [131072] u8; o: [1] Jo;
  jo_start(o[..], params[..]);
  jo_obj(o[..]); jo_key(o[..], "width"); jo_int(o[..], w); jo_key(o[..], "height"); jo_int(o[..], h);
  jo_key(o[..], "deviceScaleFactor"); jo_int(o[..], 1); jo_key(o[..], "mobile"); jo_bool(o[..], false); jo_end(o[..]);
  if cdp_call(c, "Emulation.setDeviceMetricsOverride", jo_text(o[..]), CDP_CALL_MS) < 0 { return false; }
  if cdp_call(c, "Page.enable", "", CDP_CALL_MS) < 0 { return false; }
  if cdp_call(c, "Emulation.setFocusEmulationEnabled", "{\"enabled\":true}", CDP_CALL_MS) < 0 { return false; }
  jo_start(o[..], params[..]);
  jo_obj(o[..]); jo_key(o[..], "name"); jo_str(o[..], "verse-automation"); jo_key(o[..], "value"); jo_str(o[..], mark);
  jo_key(o[..], "url"); jo_str(o[..], origin); jo_end(o[..]);
  if cdp_call(c, "Network.setCookie", jo_text(o[..]), CDP_CALL_MS) < 0 { return false; }
  jo_start(o[..], params[..]); jo_obj(o[..]); jo_key(o[..], "source"); jo_str(o[..], script); jo_end(o[..]);
  if o[0].bad || cdp_call(c, "Page.addScriptToEvaluateOnNewDocument", jo_text(o[..]), CDP_CALL_MS) < 0 { return false; }
  jo_start(o[..], params[..]); jo_obj(o[..]); jo_key(o[..], "url"); jo_str(o[..], url); jo_end(o[..]);
  return !o[0].bad && cdp_call(c, "Page.navigate", jo_text(o[..]), CDP_CALL_MS) >= 0;
}
ec_check :: (ok: bool, what: string) -> bool { print("% %\n", ifx ok then "ok  " else "FAIL", what); return ok; }

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  ok := args_load(a[..]);
  url := args_at(a[..], 0);
  players := args_number(args_value(a[..], "--players", "3"));
  seconds := args_number(args_value(a[..], "--seconds", "20"));
  wh := args_size(args_value(a[..], "--size", "1280x720"));
  room := args_value(a[..], "--room", "");
  origin := ec_origin(url);
  if !ok || url.count == 0 || url[0] == '-' || origin.count == 0 || !players.ok || !seconds.ok || !wh.ok || players.value < 2 || players.value > f64(E2C_MAX) || seconds.value < 3 {
    tool_errln("usage: coax/web/tool.sh everglade2-crowd URL [--players 2..3] [--seconds S >= 3] [--size WxH] [--room CODE] (from the repository's root)"); return 2;
  }
  js: [65536] u8;
  jn := fs_read("coax/web/everglade2-crowd.js", js[..]);
  if jn <= 0 { tool_errln("everglade2-crowd: can't read coax/web/everglade2-crowd.js (run it from the repository's root)"); return 2; }
  rnd: [6] u8;
  if !cdp_draw(6, rnd[..]) { tool_errln("everglade2-crowd: no entropy"); return 1; }
  hex := "0123456789abcdef";
  hx: [1] Buf;
  for b: rnd { h: [2] u8; h[0] = hex[b / 16]; h[1] = hex[b % 16]; bput(hx[..], cast(string) h[..]); }
  mb: [1] Buf; bput(mb[..], "pair-check-"); bput(mb[..], btext(hx[..]));
  ub: [1] Buf; bput(ub[..], url); bput(ub[..], ifx ec_has_query(url) then "&room=" else "?room=");
  if room.count > 0 { bput(ub[..], room); } else { bput(ub[..], "pair-e2-"); bput(ub[..], btext(hx[..])); bput(ub[..], "-1"); }   // the instance, as the API names it
  n := cast(int) players.value;
  c: [E2C_MAX] Cdp;
  up := 0;
  for i: 0..<n {
    if !cdp_launch(c[i..<i + 1], wh.w, wh.h, "coax-e2crowd-") { tool_err("everglade2-crowd: "); tool_errln(cdp_error(c[i..<i + 1])); break; }
    up += 1;
  }
  status := ifx up == n then ec_run(c[0..<n], btext(ub[..]), origin, btext(mb[..]), wh.w, wh.h, cast(string) js[0..<jn], cast(int) seconds.value) else 1;
  for i: 0..<up { cdp_close(c[i..<i + 1]); }
  return status;
}

ec_run :: (c: [] Cdp, url: string, origin: string, mark: string, w: int, h: int, script: string, seconds: int) -> int {
  n := c.count;
  for i: 0..<n { if !ec_open(c[i..<i + 1], url, origin, mark, w, h, script) { tool_errln("everglade2-crowd: can't open a page"); print("fails\n"); return 1; } }
  print("room %, % players, mark %\n", url, n, mark);
  // 1. Character Create, then USE IN EVERGLADE on each
  pressed: [E2C_MAX] bool; t_press: [E2C_MAX] int;
  deadline := proc_now_ms() + 60000;
  left := n;
  while left > 0 && proc_now_ms() < deadline {
    proc_sleep(500);
    for i: 0..<n {
      if pressed[i] { continue; }
      p := c[i..<i + 1];
      if ec_probe(p, 20) != 1 { continue; }   // the studio drawn
      bx := ec_probe(p, 56); by := ec_probe(p, 57);
      if bx <= 0 || by <= 0 { continue; }
      proc_sleep(300);
      _ := ec_click(p, bx, by);
      proc_sleep(400);
      if ec_probe(p, 21) == 1 || ec_probe(p, 25) == 1 { pressed[i] = true; t_press[i] = proc_now_ms(); left -= 1; }
    }
  }
  all := ec_check(left == 0, "every page pressed USE IN EVERGLADE and its run began");
  if left > 0 {
    for i: 0..<n { p := c[i..<i + 1]; print("  page %: studio % button (%, %) walking % kept % frames %\n", i, ec_probe(p, 20), ec_probe(p, 56), ec_probe(p, 57), ec_probe(p, 21), ec_probe(p, 25), ec_int(p, "__e2.fr.length", -1)); }
    print("fails\n"); return 1;
  }
  // 2. seated while the run plays
  seated: [E2C_MAX] int; for i: 0..<n { seated[i] = -1; }
  deadline = proc_now_ms() + 10000; left = n;
  while left > 0 && proc_now_ms() < deadline {
    proc_sleep(100);
    for i: 0..<n { if seated[i] < 0 && ec_probe(c[i..<i + 1], 40) == 2 && ec_probe(c[i..<i + 1], 41) >= 0 { seated[i] = proc_now_ms() - t_press[i]; left -= 1; } }
  }
  all = ec_check(left == 0, "every page is seated in the room while its run plays") && all;
  for i: 0..<n { p := c[i..<i + 1]; print("  page % seat % after % ms, running %; room state % want % joined % look % tries % frames in %\n", i, ec_probe(p, 41), seated[i], ec_probe(p, 22), ec_probe(p, 40), ec_probe(p, 50), ec_probe(p, 51), ec_probe(p, 52), ec_probe(p, 49), ec_probe(p, 48)); }
  // 3. everyone draws everyone else, during the run
  for i: 0..<n { _ := ec_int(c[i..<i + 1], "__e2.mark()", 0); }
  seen := false; deadline = proc_now_ms() + 15000; during := false;
  while !seen && proc_now_ms() < deadline {
    proc_sleep(250);
    seen = true; any_running := false;
    for i: 0..<n { if ec_probe(c[i..<i + 1], 42) < n - 1 { seen = false; } if ec_probe(c[i..<i + 1], 22) == 1 { any_running = true; } }
    if seen && any_running { during = true; }
  }
  all = ec_check(seen, "every page draws every other player") && all;
  print("  seen while a run played: %\n", ifx during then "yes" else "no (the runs had ended)");
  // the runs end (they hand the walk to you)
  deadline = proc_now_ms() + 40000;
  done := false;
  while !done && proc_now_ms() < deadline { proc_sleep(500); done = true; for i: 0..<n { if ec_probe(c[i..<i + 1], 22) == 1 { done = false; } } }
  run_report: [E2C_MAX * 2048] u8; rn: [E2C_MAX] int; ro: [E2C_MAX] int;
  for i: 0..<n {
    t := ec_str(c[i..<i + 1], "__e2.report()", run_report[i * 2048..<(i + 1) * 2048]); ro[i] = i * 2048; rn[i] = t.count;
  }
  // 4. all walk on together (W), then stand
  for i: 0..<n { _ := ec_int(c[i..<i + 1], "__e2.mark()", 0); pressed_w := ec_key(c[i..<i + 1], true); }
  proc_sleep(seconds * 1000);
  for i: 0..<n { _ := ec_key(c[i..<i + 1], false); }
  proc_sleep(3000);
  walk_report: [E2C_MAX * 2048] u8; wn: [E2C_MAX] int;
  plates := true;
  for i: 0..<n {
    t := ec_str(c[i..<i + 1], "__e2.report()", walk_report[i * 2048..<(i + 1) * 2048]); wn[i] = t.count;
    if ec_probe(c[i..<i + 1], 42) < n - 1 { plates = false; }
  }
  // names: every page draws at least one name while all stand close (they walked the same way)
  named := 0; for i: 0..<n { if ec_probe(c[i..<i + 1], 53) >= n - 1 && ec_probe(c[i..<i + 1], 16) > 0 { named += 1; } }
  for i: 0..<n { p := c[i..<i + 1]; print("  page %: named others %, bodies for names %, names drawn %, draws %\n", i, ec_probe(p, 53), ec_probe(p, 17), ec_probe(p, 16), ec_probe(p, 0)); }
  all = ec_check(plates, "every page still draws every other player after the walk") && all;
  all = ec_check(named == n, "every page has every other's name and draws names over their heads") && all;
  print("{\"players\":%,\"pages\":[", n);
  for i: 0..<n {
    if i > 0 { print(","); }
    print("{\"seat\":%,\"seated_ms\":%,\"run\":%,\"walk\":%}", ec_probe(c[i..<i + 1], 41), seated[i],
      ifx rn[i] > 0 then cast(string) run_report[ro[i]..<ro[i] + rn[i]] else "null", ifx wn[i] > 0 then cast(string) walk_report[i * 2048..<i * 2048 + wn[i]] else "null");
  }
  print("]}\n%\n", ifx all then "holds" else "fails");
  return ifx all then 0 else 1;
}
