// Actual SDK instance spans, opaque/blended ordering, old-ABI fallback and GPU recovery.
#load "valley-capture.coax";
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=2 {print("usage: grass-root-check URL ranges|legacy|blend|recover|negative\n");return 2;}
 mode:=args_at(a[..],1);if mode!="ranges" && mode!="legacy" && mode!="blend" && mode!="recover" && mode!="negative" {return 2;}
 c:[1]Cdp;if !cdp_launch_background(c[..],960,540,"grass-root-") {return 1;}defer {cdp_close(c[..]);}
 _:=cdp_call(c[..],"Page.enable","",30000);
 b:[32768]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"source");jo_str(j[..],ifx mode=="legacy" then "globalThis.grassMode='legacy'" else ifx mode=="blend" then "globalThis.grassMode='blend'" else ifx mode=="negative" then "globalThis.grassMode='negative'" else "globalThis.grassMode='ranges'");jo_end(j[..]);_=cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument",jo_text(j[..]),30000);
 probe:[16384]u8;n:=fs_read("coax/web/grass-root-probe.js",probe[..]);if n<1 {return 1;}
 jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"source");jo_str(j[..],cast(string)probe[0..<n]);jo_end(j[..]);_=cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument",jo_text(j[..]),30000);
 jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"url");jo_str(j[..],args_at(a[..],0));jo_end(j[..]);_=cdp_call(c[..],"Page.navigate",jo_text(j[..]),30000);
 if !fc_eval(c[..],"ready real grass and character","grassProof.ready()") {return 1;}
 ok:=fc_eval(c[..],"actual instance IDs and pass ordering","grassProof.check()");
 if mode=="recover" {ok=ok && fc_eval(c[..],"same instance ranges after GPU replacement","grassProof.recover()");}
 node:=cdp_evaluate(c[..],"JSON.stringify({result:grassProof.result,errors:grassProof.errors})");if node>=0 {print("%\n",jv_raw(c[0].doc[0],node));}
 print("% %\n",ifx ok then "PASS" else "FAIL",mode);return ifx ok then 0 else 1;
}
