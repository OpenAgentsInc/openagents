// The engine's layers, checked (GitHub #13264; audit docs/audits/2026-11-11-everglade-aethyr-aaa-audit.md, G6).
// metaverse-engine/ is the engine, everglade/ the game on it, metaverse/, apps/ and coax/web/ the realms and pages
// on both. A load goes down the layers, never up, and product code does not load test code. This
// tool reads every `#load "..."` line (git grep), resolves its path against the loading file's
// folder, and fails on a load that breaks a rule and that metaverse-engine/layer-allowlist.txt does not
// excuse. Run it before a push:
//   coax/web/tool.sh layer-check                 (from the repository root)
//   coax/web/tool.sh layer-check --base REV      compare the allowlist with REV's (default origin/main), at
//                                              the commit where this checkout left REV
//   coax/web/tool.sh layer-check --consumers     report the engine modules no product loads, each with its line in metaverse-engine/consumers.txt (#13272)
//   coax/bin/coax test coax/web/layer-check.coax --library
//
// The rules, for a loading file that is not support code (below):
//   aethyr-up     a file under metaverse-engine/ or rules/ (the SRD rules, out of the engine since #13270) loads from metaverse/, apps/, everglade/ or coax/web/
//   everglade-up  a file under everglade/ loads from apps/
//   tests         a file under metaverse-engine/, rules/, everglade/, coax/web/api/, coax/web/room/ or pay/ loads a file in a tests/ or
//                 test/ folder, or a checks file beside it (X-checks.E, checks.E, test_X, test-X, X_test.E, X-test.E), with a
//                 plain #load; `#load "FILE" #test;` is how a module loads its checks (#13383)
//   context       a file in context A loads a file in context B (A != B) not in A's "may load" list in contexts.txt (#13317)
//   model-effects a model file listed in metaverse-engine/model-files.txt declares #effects(all) (#13314)
// And one gate with no allowlist (#13267 step 7, #13346): the room server's load closure (every file
// coax/web/room/room.coax loads, directly or through another) has no Everglade v1 file, none named
// apps/openagents-web/everglade-*.coax or apps/openagents-web/everglade5e*.coax. v1's room builds
// frozen from everglade/server/legacy/v1.sh's pin; Everglade II's room is everglade/server/ and the
// shared code both sides load is everglade/shared/.
// Support code is a test, check, tool, example or book file, which may load what it exercises:
//   a path with a folder named tests, test, tools, examples, book, fixtures, fuzz or lab;
//   a file named test_X, test-X, check-X, check.E, checks.E, X_test.E, X-test.E, X-check.E,
//   X-checks.E or X_check.E (the names wire-check also treats as tests, and the check-X programs);
//   a file that defines `tool_main ::` (a program run by coax/web/tool.sh, not a module).
// A module whose name only looks like a check's (the SRD's ability checks) is in LC_NAMED_MODULES:
// it is product code, judged like any module and loaded plainly.
// A load whose path is absolute is outside the tree and not judged.
//
// metaverse-engine/layer-allowlist.txt names the loads that break a rule today, one per line:
//   RULE FROM -> TO        e.g. aethyr-up metaverse-engine/net/latency.coax -> everglade/shared/everglade-wire.coax
// The list only shrinks (the rule proto/wire-allowlist.txt keeps): a line that REV's copy lacks
// fails unless it ends with a reason and an issue number ("# why (#1234)"), and a line that excuses
// nothing now fails, so the list stays true. To take a line out, make the load go (move the code it
// needs down into the layer, or pass it in from the caller) and delete the line.
// Exits 0 when the tree keeps the rules, 1 when it does not, 2 when it can't be read.
#import "Basic";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/proc.coax";

LC_ALLOW :: "metaverse-engine/layer-allowlist.txt";
LC_CONTEXTS :: "contexts.txt";
LC_MODELS :: "metaverse-engine/model-files.txt";
LC_CONSUMERS :: "metaverse-engine/consumers.txt";
LC_HOW :: "metaverse-engine/README.md, \"Layers\"";
LC_BUF :: 16777216;      // git grep's and git ls-files' output, and the largest file read
LC_MODS :: 8192;         // engine modules tracked by --consumers
LC_LINES :: 4096;        // allowlist lines tracked
LC_MAX_CTX :: 64;        // bounded contexts in contexts.txt
LC_MAX_PFX :: 32;        // folder/file prefixes or allowed dependencies per context

// The rules, by index (0: none). LC_ALLOW_RULES bounds allowlisted load rules; model-effects is never allowlisted.
LC_UP_AETHYR :: 1; LC_UP_EVERGLADE :: 2; LC_TESTS :: 3; LC_CONTEXT :: 4; LC_ALLOW_RULES :: 5; LC_MODEL_EFFECTS :: 5; LC_RULES :: 6;
LC_NAMES :: [6] string.["", "aethyr-up", "everglade-up", "tests", "context", "model-effects"];

LcRun :: struct { quiet: bool; }
LcCtx :: struct {
  slug: string;
  folders: [LC_MAX_PFX] string;
  n_folders: int;
  may: [LC_MAX_PFX] string;
  n_may: int;
}
LcCtxMap :: struct {
  ok: bool;
  bad: string;
  ctxs: [LC_MAX_CTX] LcCtx;
  n: int;
}
// One "#load" line of git grep's output: the loading file, its line and the path it names.
// checks: a check load, `#load "REL" #test;` (#13383): how a module names its checks.
LcLoad :: struct { ok: bool; from: string; line: int; rel: string; checks: bool; }

// ---- text

lc_starts :: (s: string, p: string) -> bool { return p.count <= s.count && cast(string) s[0..<p.count] == p; }
lc_has :: (s: string, p: string) -> bool {
  if p.count > s.count { return false; }
  for k: 0..<s.count - p.count + 1 { if cast(string) s[k..<k + p.count] == p { return true; } }
  return false;
}
lc_digit :: (c: u8) -> bool { return c >= '0' && c <= '9'; }
lc_letter :: (c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
lc_trim :: (s: string) -> string {
  a := 0; b := s.count;
  while a < b && (s[a] == ' ' || s[a] == '\t' || s[a] == '\r') { a += 1; }
  while b > a && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\r') { b -= 1; }
  return cast(string) s[a..<b];
}
// The folder of a path ("" for a file at the root).
lc_dir :: (path: string) -> string {
  e := path.count;
  while e > 0 && path[e - 1] != '/' { e -= 1; }
  return cast(string) path[0..<ifx e > 0 then e - 1 else 0];
}
// Bytewise order, as git sorts paths: <0, 0 or >0.
lc_cmp :: (a: string, b: string) -> int {
  n := ifx a.count < b.count then a.count else b.count;
  for k: 0..<n { if a[k] != b[k] { return cast(int) a[k] - cast(int) b[k]; } }
  return a.count - b.count;
}

// ---- load lines

// A line of `git grep -n` output for "#load" lines: "PATH:LINE:#load \"REL\" ...".
lc_parse :: (row: string) -> LcLoad {
  l: LcLoad;
  a := 0;
  while a < row.count && row[a] != ':' { a += 1; }
  b := a + 1;
  while b < row.count && lc_digit(row[b]) { b += 1; }
  if a >= row.count || b == a + 1 || b >= row.count || row[b] != ':' { return l; }
  p := "#load \"";
  text := cast(string) row[b + 1..<row.count];
  if !lc_starts(text, p) { return l; }
  e := p.count;
  while e < text.count && text[e] != '"' { e += 1; }
  if e >= text.count || e == p.count { return l; }
  n := 0;
  for k: a + 1..<b { n = n * 10 + cast(int) (row[k] - '0'); }
  l.ok = true; l.from = cast(string) row[0..<a]; l.line = n; l.rel = cast(string) text[p.count..<e];
  l.checks = lc_starts(lc_trim(cast(string) text[e + 1..<text.count]), "#test");
  return l;
}
// dir joined with rel, with "." and ".." resolved, into out; "" when it climbs past the root
// or rel is absolute.
lc_resolve :: (dir: string, rel: string, out: [] u8) -> string {
  if rel.count > 0 && rel[0] == '/' { return ""; }
  n := 0;
  starts: [256] int; depth := 0;
  for pass: 0..<2 {
    s := ifx pass == 0 then dir else rel;
    i := 0;
    while i < s.count {
      e := i;
      while e < s.count && s[e] != '/' { e += 1; }
      seg := cast(string) s[i..<e]; i = e + 1;
      if seg.count == 0 || seg == "." { continue; }
      if seg == ".." {
        if depth == 0 { return ""; }
        depth -= 1; n = starts[depth]; if n > 0 { n -= 1; }
        continue;
      }
      if depth >= starts.count || n + seg.count + 1 > out.count { return ""; }
      if n > 0 { out[n] = '/'; n += 1; }
      starts[depth] = n; depth += 1;
      for c: seg { out[n] = c; n += 1; }
    }
  }
  return cast(string) out[0..<n];
}

// ---- the room's closure (#13346)

LC_ROOM :: "coax/web/room/room.coax";
LC_ROOM_FILES :: 2048;    // files in the room's closure tracked
// Whether path is an Everglade v1 file the room must not load.
lc_v1 :: (path: string) -> bool {
  return lc_starts(path, "apps/openagents-web/everglade-") || lc_starts(path, "apps/openagents-web/everglade5e");
}
// The v1 files in root's load closure, as `loads` (git grep's "FILE:LINE:#load ..." rows) has it:
// each named once. How many.
lc_room_v1 :: (loads: string, root: string, run: LcRun) -> int {
  pool: [262144] u8; pn := 0;
  at: [LC_ROOM_FILES] int; sz: [LC_ROOM_FILES] int; n := 0;
  for c: root { pool[pn] = c; pn += 1; }
  at[0] = 0; sz[0] = root.count; n = 1;
  bad := 0;
  q := 0;
  while q < n {
    from := cast(string) pool[at[q]..<at[q] + sz[q]]; q += 1;
    dir := lc_dir(from);
    i := 0;
    while i < loads.count {
      j := i;
      while j < loads.count && loads[j] != '\n' { j += 1; }
      row := cast(string) loads[i..<j]; i = j + 1;
      if row.count <= from.count || row[from.count] != ':' || !lc_starts(row, from) { continue; }
      l := lc_parse(row);
      if !l.ok { continue; }
      to_b: [1024] u8;
      to := lc_resolve(dir, l.rel, to_b[..]);
      if to.count == 0 { continue; }
      seen := false;
      for k: 0..<n { if cast(string) pool[at[k]..<at[k] + sz[k]] == to { seen = true; break; } }
      if seen { continue; }
      if n >= LC_ROOM_FILES || pn + to.count > pool.count {
        if !run.quiet { print("layer-check: the room's closure is past % files; raise LC_ROOM_FILES\n", LC_ROOM_FILES); }
        return bad + 1;
      }
      at[n] = pn; sz[n] = to.count; n += 1;
      for c: to { pool[pn] = c; pn += 1; }
      if lc_v1(to) {
        bad += 1;
        if !run.quiet { print("room-v1 % -> %   (the room loads an Everglade v1 file; everglade/shared/ holds what both sides need)\n", from, to); }
      }
    }
  }
  return bad;
}

// ---- support code and the rules

// Modules whose file name looks like a check's. The name alone would make each support code, which
// no rule judges, and a plain load of it a load of checks. They are product code. Prefer a name that
// does not look like a check; add one here only when the domain gives the name.
LC_NAMED_MODULES :: [3] string.["rules/srd/ability-checks.coax", "rules/srd/check-training.coax", "metaverse-engine/anim/scene-check.coax"];
lc_named_module :: (path: string) -> bool {
  mods := LC_NAMED_MODULES;
  for m: mods { if m == path { return true; } }
  return false;
}
// Whether path is support code by its name: a test, check, tool, example, book, fuzz or lab folder, or
// a test or check file name.
lc_support_path :: (path: string) -> bool {
  if lc_named_module(path) { return false; }
  i := 0;
  while i < path.count {
    j := i;
    while j < path.count && path[j] != '/' { j += 1; }
    seg := cast(string) path[i..<j];
    if j < path.count {
      if seg == "tests" || seg == "test" || seg == "tools" || seg == "examples" || seg == "book" || seg == "fixtures" || seg == "fuzz" || seg == "lab" { return true; }
    } else {
      if lc_starts(seg, "test_") || lc_starts(seg, "test-") || lc_starts(seg, "check-") || lc_starts(seg, "check.") || lc_starts(seg, "checks.") { return true; }
      marks := [5] string.["_test.", "-test.", "-check.", "-checks.", "_check."];
      for m: marks { if lc_has(seg, m) { return true; } }
    }
    i = j + 1;
  }
  return false;
}
// Whether a sorted list of paths, one a line, has path.
lc_listed :: (list: string, path: string) -> bool {
  i := 0;
  while i < list.count {
    j := i;
    while j < list.count && list[j] != '\n' { j += 1; }
    if cast(string) list[i..<j] == path { return true; }
    i = j + 1;
  }
  return false;
}
// Whether path is support code: by its name, or a program (tools lists the files that define tool_main).
lc_support :: (path: string, tools: string) -> bool { return lc_support_path(path) || lc_listed(tools, path); }
// Whether path is a checks file by its name, wherever it sits: X-checks.E, checks.E, test_X, test-X,
// X_test.E or X-test.E. A module loads one with `#load "FILE" #test;` (#13383). The check-X programs
// and X-check diagnostics are not checks files: a tool that wraps one loads it plainly.
lc_checks_file :: (path: string) -> bool {
  if lc_named_module(path) { return false; }
  cut := path.count;
  while cut > 0 && path[cut - 1] != '/' { cut -= 1; }
  seg := cast(string) path[cut..<path.count];
  if lc_starts(seg, "test_") || lc_starts(seg, "test-") || lc_starts(seg, "checks.") { return true; }
  return lc_has(seg, "_test.") || lc_has(seg, "-test.") || lc_has(seg, "-checks.");
}
// Whether a path has a folder named tests or test.
lc_in_tests :: (path: string) -> bool {
  i := 0;
  while i < path.count {
    j := i;
    while j < path.count && path[j] != '/' { j += 1; }
    if j < path.count && (cast(string) path[i..<j] == "tests" || cast(string) path[i..<j] == "test") { return true; }
    i = j + 1;
  }
  return false;
}
// Parses contexts.txt: one line per context, "SLUG folders: A/ B/ ... may load: SLUG ...".
lc_parse_contexts :: (text: string) -> LcCtxMap {
  m: LcCtxMap; m.ok = true;
  i := 0;
  while i < text.count {
    j := i;
    while j < text.count && text[j] != '\n' { j += 1; }
    raw := cast(string) text[i..<j]; i = j + 1;
    e := 0;
    while e < raw.count && raw[e] != '#' { e += 1; }
    line := lc_trim(cast(string) raw[0..<e]);
    if line.count == 0 { continue; }
    if m.n >= LC_MAX_CTX { m.ok = false; m.bad = line; return m; }
    c: LcCtx;
    // split by whitespace
    words: [128] string; wn := 0; k := 0;
    while k < line.count {
      while k < line.count && (line[k] == ' ' || line[k] == '\t') { k += 1; }
      if k >= line.count { break; }
      w0 := k;
      while k < line.count && line[k] != ' ' && line[k] != '\t' { k += 1; }
      if wn < words.count { words[wn] = cast(string) line[w0..<k]; wn += 1; }
    }
    if wn < 4 || words[1] != "folders:" {
      m.ok = false; m.bad = line; return m;
    }
    c.slug = words[0];
    may_at := -1;
    for q: 2..<wn - 1 {
      if words[q] == "may" && words[q + 1] == "load:" { may_at = q; break; }
    }
    if may_at < 3 {
      m.ok = false; m.bad = line; return m;
    }
    for q: 2..<may_at {
      if c.n_folders >= LC_MAX_PFX { m.ok = false; m.bad = line; return m; }
      c.folders[c.n_folders] = words[q]; c.n_folders += 1;
    }
    for q: may_at + 2..<wn {
      if c.n_may >= LC_MAX_PFX { m.ok = false; m.bad = line; return m; }
      c.may[c.n_may] = words[q]; c.n_may += 1;
    }
    m.ctxs[m.n] = c; m.n += 1;
  }
  for a: 0..<m.n {
    for q: 0..<m.ctxs[a].n_may {
      want := m.ctxs[a].may[q]; found := false;
      for b: 0..<m.n { if m.ctxs[b].slug == want { found = true; break; } }
      if !found { m.ok = false; m.bad = want; return m; }
    }
  }
  return m;
}
// Index of the context in m whose folder/file prefix is longest for path, or -1.
lc_context_of :: (m: LcCtxMap, path: string) -> int {
  best := -1; best_len := 0;
  for c: 0..<m.n {
    for f: 0..<m.ctxs[c].n_folders {
      pfx := m.ctxs[c].folders[f];
      if lc_starts(path, pfx) && pfx.count > best_len {
        best = c; best_len = pfx.count;
      }
    }
  }
  return best;
}
// Whether context a allows loading context b.
lc_context_allows :: (m: LcCtxMap, a: int, b: int) -> bool {
  if a < 0 || b < 0 || a == b { return true; }
  target := m.ctxs[b].slug;
  for k: 0..<m.ctxs[a].n_may {
    if m.ctxs[a].may[k] == target { return true; }
  }
  return false;
}
// The fixed layer rule a load from `from` (not support code) to `to` breaks, or 0.
lc_rule :: (from: string, to: string) -> int {
  if (lc_starts(from, "metaverse-engine/") || lc_starts(from, "rules/")) && (lc_starts(to, "metaverse/") || lc_starts(to, "verse/") || lc_starts(to, "apps/") || lc_starts(to, "everglade/") || lc_starts(to, "coax/web/")) { return LC_UP_AETHYR; }
  if lc_starts(from, "everglade/") && lc_starts(to, "apps/") { return LC_UP_EVERGLADE; }
  if (lc_starts(from, "metaverse-engine/") || lc_starts(from, "rules/") || lc_starts(from, "everglade/") || lc_starts(from, "coax/web/api/") || lc_starts(from, "coax/web/room/") || lc_starts(from, "pay/")) && (lc_in_tests(to) || lc_checks_file(to)) { return LC_TESTS; }
  return 0;
}
// Including contexts.txt: fixed rules take precedence; otherwise cross-context disallowed loads return LC_CONTEXT.
lc_rule_ctx :: (from: string, to: string, ctxs: LcCtxMap, from_ctx: [] int, to_ctx: [] int) -> int {
  r := lc_rule(from, to);
  if r != 0 { return r; }
  if ctxs.n == 0 { return 0; }
  // Everglade's one allowed adapter path into v1 code while v1 still builds (#13269)
  if lc_starts(from, "everglade/server/legacy/") { return 0; }
  a := lc_context_of(ctxs, from);
  if a < 0 { return 0; }
  b := lc_context_of(ctxs, to);
  if b < 0 || lc_context_allows(ctxs, a, b) { return 0; }
  from_ctx[0] = a; to_ctx[0] = b;
  return LC_CONTEXT;
}

// ---- the allowlist

// A line's entry: what stands before its #, trimmed ("" for a comment or an empty line).
lc_entry :: (line: string) -> string {
  e := 0;
  while e < line.count && line[e] != '#' { e += 1; }
  return lc_trim(cast(string) line[0..<e]);
}
// Whether a line carries a reason and an issue number after its #: "# why (#1234)".
lc_reasoned :: (line: string) -> bool {
  e := 0;
  while e < line.count && line[e] != '#' { e += 1; }
  if e >= line.count { return false; }
  issue := false; letters := 0;
  k := e + 1;
  while k < line.count {
    if line[k] == '#' {
      n := k + 1;
      while n < line.count && lc_digit(line[n]) { n += 1; }
      if n - k - 1 >= 3 { issue = true; }
    }
    if lc_letter(line[k]) { letters += 1; }
    k += 1;
  }
  return issue && letters >= 3;
}
// "RULE FROM -> TO" into out.
lc_line :: (rule: int, from: string, to: string, out: [] u8) -> string {
  n := 0;
  parts := [5] string.[LC_NAMES[rule], " ", from, " -> ", to];
  for p: parts { for c: p { if n < out.count { out[n] = c; n += 1; } } }
  return cast(string) out[0..<n];
}
// The number of the list's line whose entry is `entry`, or -1.
lc_allow_find :: (list: string, entry: string) -> int {
  if entry.count == 0 { return -1; }
  i := 0; n := 0;
  while i < list.count {
    j := i;
    while j < list.count && list[j] != '\n' { j += 1; }
    if lc_entry(cast(string) list[i..<j]) == entry { return n; }
    i = j + 1; n += 1;
  }
  return -1;
}
// Word k of an entry split by single spaces, or "".
lc_word :: (s: string, k: int) -> string {
  n := 0; from := 0;
  for i: 0..<s.count + 1 {
    if i == s.count || s[i] == ' ' {
      if n == k { return cast(string) s[from..<i]; }
      n += 1; from = i + 1;
    }
  }
  return "";
}
// The rule an allowlist entry names, or 0 when it is not "RULE FROM -> TO".
lc_entry_rule :: (entry: string) -> int {
  if lc_word(entry, 2) != "->" || lc_word(entry, 1).count == 0 || lc_word(entry, 3).count == 0 || lc_word(entry, 4).count > 0 { return 0; }
  name := lc_word(entry, 0);
  for r: 1..<LC_ALLOW_RULES { if LC_NAMES[r] == name { return r; } }
  return 0;
}

// ---- model-effects (#13314)

// First 1-based line in `src` where code (outside `//` comments) contains `#effects(all)`, or 0.
lc_model_all_line :: (src: string) -> int {
  i := 0; line := 1;
  while i < src.count {
    j := i;
    while j < src.count && src[j] != '\n' { j += 1; }
    row := cast(string) src[i..<j];
    e := row.count;
    if row.count >= 2 {
      for k: 0..<row.count - 1 {
        if row[k] == '/' && row[k + 1] == '/' { e = k; break; }
      }
    }
    if lc_has(cast(string) row[0..<e], "#effects(all)") { return line; }
    i = j + 1; line += 1;
  }
  return 0;
}
// Checks one model file's source: returns 1 and increments found[LC_MODEL_EFFECTS] if it declares `#effects(all)`.
lc_judge_model_source :: (path: string, src: string, run: LcRun, found: [] int) -> int {
  line := lc_model_all_line(src);
  if line == 0 { return 0; }
  found[LC_MODEL_EFFECTS] += 1;
  if !run.quiet {
    print("FAIL model-effects: %:% declares #effects(all). Model files listed in % do no I/O by construction; narrow to #effects(reads, writes, traps) or tighter (#13314).\n", path, line, LC_MODELS);
  }
  return 1;
}
// Checks every path listed in `models` (one path a line; `#` comments and blank lines skipped).
lc_judge_models_fs :: (models: string, buf: [] u8, run: LcRun, found: [] int, checked: [] int) -> int {
  bad := 0; i := 0;
  while i < models.count {
    j := i;
    while j < models.count && models[j] != '\n' { j += 1; }
    path := lc_entry(cast(string) models[i..<j]); i = j + 1;
    if path.count == 0 { continue; }
    checked[0] += 1;
    n := fs_read(path, buf);
    if n < 0 {
      found[LC_MODEL_EFFECTS] += 1; bad += 1;
      if !run.quiet { print("FAIL model-effects: % listed in % could not be read.\n", path, LC_MODELS); }
      continue;
    }
    bad += lc_judge_model_source(path, cast(string) buf[0..<n], run, found);
  }
  return bad;
}

// ---- the judgment

// Every load in `loads` (git grep -n output for "#load" lines): how many break a rule with no
// allowlist line. found counts the loads that break each rule (excused or not), once per
// FROM -> TO; used marks the allowlist lines that excused a load.
lc_judge_with_contexts :: (loads: string, tools: string, allow: string, ctxs: LcCtxMap, used: [] bool, run: LcRun, found: [] int) -> int {
  bad := 0; i := 0;
  last := ""; last_support := false; last_judged := false;
  prev_from := ""; prev_to: [1024] u8; prev_n := 0;
  out: [1024] u8; buf: [2048] u8;
  fc: [1] int; tc: [1] int;
  while i < loads.count {
    j := i;
    while j < loads.count && loads[j] != '\n' { j += 1; }
    l := lc_parse(cast(string) loads[i..<j]); i = j + 1;
    if !l.ok { continue; }
    if l.from != last {
      last = l.from;
      in_fixed := lc_starts(l.from, "metaverse-engine/") || lc_starts(l.from, "rules/") || lc_starts(l.from, "everglade/") || lc_starts(l.from, "coax/web/api/") || lc_starts(l.from, "coax/web/room/") || lc_starts(l.from, "pay/");
      last_judged = in_fixed || (ctxs.n > 0 && lc_context_of(ctxs, l.from) >= 0);
      last_support = ifx last_judged then lc_support(l.from, tools) else false;
    }
    if !last_judged || last_support { continue; }
    to := lc_resolve(lc_dir(l.from), l.rel, out[..]);
    if to.count == 0 { continue; }
    rule := lc_rule_ctx(l.from, to, ctxs, fc[..], tc[..]);
    // A check load is how a module names its checks: no compile emits them (#13383). A plain
    // load of a file in a tests folder, or of a checks file beside the module, ships it.
    if l.checks && rule == LC_TESTS { continue; }
    if rule == 0 { continue; }
    // a file that loads the same path twice is one load
    if l.from == prev_from && cast(string) prev_to[0..<prev_n] == to { continue; }
    prev_from = l.from; prev_n = 0;
    for c: to { if prev_n < prev_to.count { prev_to[prev_n] = c; prev_n += 1; } }
    found[rule] += 1;
    at := lc_allow_find(allow, lc_line(rule, l.from, to, buf[..]));
    if at >= 0 { if at < used.count { used[at] = true; } continue; }
    bad += 1;
    if run.quiet { continue; }
    if rule == LC_UP_AETHYR { print("FAIL aethyr-up: %:% loads %. metaverse-engine/ is the engine: it loads nothing from metaverse/, apps/, everglade/ or coax/web/. Fix: move what it needs down into metaverse-engine/, or have the caller pass it in (%).\n", l.from, l.line, to, LC_HOW); }
    else if rule == LC_UP_EVERGLADE { print("FAIL everglade-up: %:% loads %. everglade/ is the game: it loads nothing from apps/. Fix: move what it needs into everglade/ or metaverse-engine/ (%).\n", l.from, l.line, to, LC_HOW); }
    else if rule == LC_TESTS { print("FAIL tests: %:% loads %, a tests-folder or checks file, with a plain #load, and % is not a test, check or tool. Fix: load a module's own checks with #load \"FILE\" #test; and move what product code needs out of the checks file into a module (%).\n", l.from, l.line, to, l.from, LC_HOW); }
    else { print("FAIL context: %:% (%) loads % (%), which %'s line in % does not allow. Fix: move the dependency behind an allowed context or published contract (%).\n", l.from, l.line, ctxs.ctxs[fc[0]].slug, to, ctxs.ctxs[tc[0]].slug, ctxs.ctxs[fc[0]].slug, LC_CONTEXTS, LC_HOW); }
  }
  return bad;
}
lc_judge :: (loads: string, tools: string, allow: string, used: [] bool, run: LcRun, found: [] int) -> int {
  empty: LcCtxMap;
  return lc_judge_with_contexts(loads, tools, allow, empty, used, run, found);
}
// The allowlist's own faults: a line that is not "RULE FROM -> TO", and a line that excused
// nothing this run (the load is gone: take the line out).
lc_judge_allow :: (allow: string, used: [] bool, run: LcRun) -> int {
  bad := 0; i := 0; n := 0;
  while i < allow.count {
    j := i;
    while j < allow.count && allow[j] != '\n' { j += 1; }
    entry := lc_entry(cast(string) allow[i..<j]); i = j + 1; n += 1;
    if entry.count == 0 { continue; }
    if lc_entry_rule(entry) == 0 {
      bad += 1;
      if !run.quiet { print("FAIL allowlist: % has a line that is not \"RULE FROM -> TO\" with RULE aethyr-up, everglade-up, tests or context: \"%\"\n", LC_ALLOW, entry); }
      continue;
    }
    if n - 1 < used.count && !used[n - 1] {
      bad += 1;
      if !run.quiet { print("FAIL allowlist: the line \"%\" excuses nothing now (the load is gone, or the file is support code). Fix: take it out of %.\n", entry, LC_ALLOW); }
    }
  }
  return bad;
}
// The lines of list that base lacks and that carry no reason and issue number. added counts
// every line base lacks.
lc_grown :: (list: string, base: string, run: LcRun, added: [] int) -> int {
  bad := 0; i := 0;
  while i < list.count {
    j := i;
    while j < list.count && list[j] != '\n' { j += 1; }
    line := cast(string) list[i..<j]; i = j + 1;
    entry := lc_entry(line);
    if entry.count == 0 || lc_allow_find(base, entry) >= 0 { continue; }
    added[0] += 1;
    if lc_reasoned(line) { continue; }
    bad += 1;
    if !run.quiet { print("FAIL allowlist: % has a new line with no reason and issue number: \"%\". The allowlist only shrinks. Fix: take the load out (%), or end the line with \"# why (#ISSUE)\".\n", LC_ALLOW, entry, LC_HOW); }
  }
  return bad;
}

// ---- the consumer report (#13272)

// The index of path in mods (sorted), or -1.
lc_find :: (mods: [] string, n: int, path: string) -> int {
  lo := 0; hi := n;
  while lo < hi {
    mid := (lo + hi) / 2;
    c := lc_cmp(mods[mid], path);
    if c == 0 { return mid; }
    if c < 0 { lo = mid + 1; } else { hi = mid; }
  }
  return -1;
}
// Marks the engine modules (mods: metaverse-engine/ files that are not support code) that a product loads:
// a file outside metaverse-engine/ that is not support code or a document, or a module already marked,
// following loads until nothing changes. loaders counts each module's loaders of any kind.
lc_consumed :: (loads: string, tools: string, mods: [] string, n: int, consumed: [] bool, loaders: [] int) {
  out: [1024] u8;
  pass := 0; changed := true;
  while changed {
    changed = false;
    i := 0; last := ""; last_product := false;
    while i < loads.count {
      j := i;
      while j < loads.count && loads[j] != '\n' { j += 1; }
      l := lc_parse(cast(string) loads[i..<j]); i = j + 1;
      if !l.ok { continue; }
      to := lc_resolve(lc_dir(l.from), l.rel, out[..]);
      if !lc_starts(to, "metaverse-engine/") { continue; }
      m := lc_find(mods, n, to);
      if m < 0 { continue; }
      if pass == 0 { loaders[m] += 1; }
      if consumed[m] { continue; }
      product := false;
      if lc_starts(l.from, "metaverse-engine/") { f := lc_find(mods, n, l.from); product = f >= 0 && consumed[f]; }
      else {
        if l.from != last { last = l.from; last_product = !lc_starts(l.from, "docs/") && !lc_support(l.from, tools); }
        product = last_product;
      }
      if product { consumed[m] = true; changed = true; }
    }
    pass += 1;
  }
}

// ---- the consumers list (#13272): metaverse-engine/consumers.txt says why each engine module with no product
// consumer is kept, one line a module or folder prefix:
//   adopt PREFIX #ISSUE     an open issue of the AAA program (#13257) takes it into the product
//   book PREFIX CHAPTER     it is the Aethyr book's own implementation, and CHAPTER names it
//   built PREFIX SCRIPT     no file loads it: SCRIPT compiles it by name (a page's renderer carrier)
//   pipeline PREFIX TOOL    an offline tool that makes a shipped thing loads it (a film, a sound bank)
// The longest prefix that starts a module's path covers it. A module with no consumer and no line
// fails; so does a line that covers nothing now, an adopt line with no issue, and a line whose
// evidence file is missing or does not name the prefix (its path under metaverse-engine/).
// The kind of a consumers line: 1 adopt, 2 book, 3 built, 4 pipeline; 0 for any other line.
lc_cons_kind :: (line: string) -> int {
  w := lc_word(line, 0);
  if w == "adopt" { return 1; }
  if w == "book" { return 2; }
  if w == "built" { return 3; }
  if w == "pipeline" { return 4; }
  return 0;
}
// Whether a word is an issue number: # and digits.
lc_issue :: (w: string) -> bool {
  if w.count < 2 || w[0] != '#' { return false; }
  for i: 1..<w.count { if !lc_digit(w[i]) { return false; } }
  return true;
}
// Line k of a text, trimmed ("" past its end).
lc_nth_line :: (text: string, k: int) -> string {
  i := 0; n := 0;
  while i < text.count {
    j := i;
    while j < text.count && text[j] != '\n' { j += 1; }
    if n == k { return lc_trim(cast(string) text[i..<j]); }
    i = j + 1; n += 1;
  }
  return "";
}
lc_line_count :: (text: string) -> int {
  n := 0;
  for c: text { if c == '\n' { n += 1; } }
  if text.count > 0 && text[text.count - 1] != '\n' { n += 1; }
  return n;
}
// The consumers line (its number in the list) whose prefix is the longest that starts path, or -1.
lc_cover :: (list: string, path: string) -> int {
  best := -1; best_n := 0;
  for k: 0..<lc_line_count(list) {
    line := lc_nth_line(list, k);
    if lc_cons_kind(line) == 0 { continue; }
    p := lc_word(line, 1);
    if p.count > best_n && lc_starts(path, p) { best = k; best_n = p.count; }
  }
  return best;
}
// The modules with no product consumer against the list. counts[0] takes those no line covers,
// counts[1..4] those each kind covers; used marks the lines that cover one. Returns the failures:
// an uncovered module, a line that is not one of the four kinds, an adopt line with no issue, a
// line with no evidence word, and a line that covers nothing now.
lc_judge_consumers :: (mods: [] string, n: int, consumed: [] bool, list: string, run: LcRun, counts: [] int, used: [] bool) -> int {
  bad := 0;
  for m: 0..<n {
    if consumed[m] { continue; }
    c := lc_cover(list, mods[m]);
    if c < 0 || c >= used.count {
      bad += 1; counts[0] += 1;
      if !run.quiet { print("FAIL consumers: % has no product consumer and no line in %. Fix: load it from the product, delete it, or add a line naming the issue that adopts it (%).\n", mods[m], LC_CONSUMERS, LC_HOW); }
      continue;
    }
    used[c] = true; counts[lc_cons_kind(lc_nth_line(list, c))] += 1;
  }
  for k: 0..<lc_line_count(list) {
    line := lc_nth_line(list, k);
    if line.count == 0 || line[0] == '#' { continue; }
    kind := lc_cons_kind(line);
    if kind == 0 || lc_word(line, 1).count == 0 || lc_word(line, 2).count == 0 {
      bad += 1;
      if !run.quiet { print("FAIL consumers: % has a line that is not \"adopt|book|built|pipeline PREFIX EVIDENCE\": \"%\"\n", LC_CONSUMERS, line); }
      continue;
    }
    if kind == 1 && !lc_issue(lc_word(line, 2)) {
      bad += 1;
      if !run.quiet { print("FAIL consumers: an adopt line names its issue as #NUMBER: \"%\"\n", line); }
      continue;
    }
    if k < used.count && !used[k] {
      bad += 1;
      if !run.quiet { print("FAIL consumers: the line \"%\" covers nothing now (its modules have a consumer, or are gone). Fix: take it out of %.\n", line, LC_CONSUMERS); }
    }
  }
  return bad;
}
// Whether a line's evidence text names its prefix: the prefix's path under metaverse-engine/, or, for one
// module, its file name (a file beside it loads it by that name alone).
lc_evidence_names :: (line: string, evidence: string) -> bool {
  p := lc_word(line, 1);
  if !lc_starts(p, "metaverse-engine/") { return false; }
  if lc_has(evidence, cast(string) p[17..<p.count]) { return true; }
  cut := p.count;
  while cut > 0 && p[cut - 1] != '/' { cut -= 1; }
  return cut < p.count && lc_has(evidence, cast(string) p[cut..<p.count]);
}

tool_main :: () -> int #export_c #effects(all) {
  args: [1] Args;
  if !args_load(args[..]) { tool_errln("usage: coax/web/tool.sh layer-check [--base REV] [--consumers]"); return 2; }
  run: LcRun;
  base := args_value(args[..], "--base", "origin/main");
  err: [4096] u8;
  // The base is where this checkout left it (git merge-base HEAD BASE). A checkout behind BASE
  // (the after-landing check of a commit main has moved past) is compared with its own ancestor,
  // not with a later allowlist that has shrunk since, where every line it still has looks new.
  fork: [64] u8;
  {
    mb := [4] string.["git", "merge-base", "HEAD", base];
    m := proc_run(mb[..], 60000, fork[..], err[..]);
    n := m.out_n; while n > 0 && (fork[n - 1] == 10 || fork[n - 1] == ' ') { n -= 1; }
    if m.started == 0 && m.status == 0 && n >= 40 { base = cast(string) fork[0..<n]; }
  }
  atext: [1048576] u8;
  an := fs_read(LC_ALLOW, atext[..]);
  if an < 0 { print("layer-check: no % here; run from the repository root (an empty file is the goal; a missing one is not)\n", LC_ALLOW); return 2; }
  allow := cast(string) atext[0..<an];
  ctext: [65536] u8;
  ctxs_n := fs_read(LC_CONTEXTS, ctext[..]);
  if ctxs_n < 0 { print("layer-check: no % here; run from the repository root\n", LC_CONTEXTS); return 2; }
  ctxs := lc_parse_contexts(cast(string) ctext[0..<ctxs_n]);
  if !ctxs.ok { print("layer-check: invalid line in %: \"%\"\n", LC_CONTEXTS, ctxs.bad); return 2; }
  mtext: [65536] u8;
  mn := fs_read(LC_MODELS, mtext[..]);
  if mn < 0 { print("layer-check: no % here; run from the repository root\n", LC_MODELS); return 2; }
  models := cast(string) mtext[0..<mn];

  loads_buf: [LC_BUF] u8; tools_buf: [1048576] u8; body: [LC_BUF] u8;
  grep := [6] string.["git", "grep", "-nE", "^#load \"", "--", "*.coax"];
  g := proc_run(grep[..], 120000, loads_buf[..], err[..]);
  if g.started != 0 || g.status != 0 || g.cut { tool_errln("layer-check: git grep for #load lines failed"); return 2; }
  loads := cast(string) loads_buf[0..<g.out_n];
  tl := [6] string.["git", "grep", "-l", "^tool_main ::", "--", "*.coax"];
  t := proc_run(tl[..], 120000, tools_buf[..], err[..]);
  if t.started != 0 || (t.status != 0 && t.status != 1) || t.cut { tool_errln("layer-check: git grep for tool_main failed"); return 2; }
  tools := cast(string) tools_buf[0..<t.out_n];

  // the engine modules, which of them a product consumes, and the consumers list's word on the rest (#13272)
  ls := [3] string.["git", "ls-files", "metaverse-engine/*.coax"];
  r := proc_run(ls[..], 60000, body[..], err[..]);
  if r.started != 0 || r.status != 0 || r.cut { tool_errln("layer-check: git ls-files failed"); return 2; }
  all_buf: [1048576] u8; all_n := 0;
  for q: 0..<r.out_n { if all_n < all_buf.count { all_buf[all_n] = body[q]; all_n += 1; } }
  all := cast(string) all_buf[0..<all_n];
  mods: [LC_MODS] string; n := 0;
  i := 0;
  while i < all.count {
    j := i;
    while j < all.count && all[j] != '\n' { j += 1; }
    p := cast(string) all[i..<j]; i = j + 1;
    if p.count > 0 && !lc_support(p, tools) && n < mods.count { mods[n] = p; n += 1; }
  }
  consumed: [LC_MODS] bool; loaders: [LC_MODS] int;
  lc_consumed(loads, tools, mods[..], n, consumed[..], loaders[..]);
  cons_text: [262144] u8;
  cons_n := fs_read(LC_CONSUMERS, cons_text[..]);
  if cons_n < 0 { print("layer-check: no % here; run from the repository root\n", LC_CONSUMERS); return 2; }
  cons := cast(string) cons_text[0..<cons_n];
  cons_counts: [5] int; cons_used: [LC_LINES] bool;
  if args_has(args[..], "--consumers") {
    none := 0; lines := 0;
    for k: 0..<n {
      if consumed[k] { continue; }
      size := fs_read(mods[k], body[..]); nl := 0;
      for q: 0..<ifx size > 0 then size else 0 { if body[q] == '\n' { nl += 1; } }
      none += 1; lines += nl;
      c := lc_cover(cons, mods[k]);
      print("%\t% lines\t% loader%\t%\n", mods[k], nl, loaders[k], ifx loaders[k] == 1 then "" else "s", ifx c < 0 then "NO LINE" else lc_nth_line(cons, c));
    }
    print("layer-check --consumers: % of % engine modules under metaverse-engine/ (% lines) have no product consumer: nothing outside metaverse-engine/ that is not a test, tool, example, book or document loads them, directly or through another module. % says why each is kept\n", none, n, lines, LC_CONSUMERS);
    return 0;
  }

  used: [LC_LINES] bool; found: [LC_RULES] int; model_checked: [1] int;
  bad := lc_judge_with_contexts(loads, tools, allow, ctxs, used[..], run, found[..]);
  bad += lc_judge_allow(allow, used[..], run);
  bad += lc_judge_models_fs(models, body[..], run, found[..], model_checked[..]);
  room_v1 := lc_room_v1(loads, LC_ROOM, run);
  bad += room_v1;
  bad += lc_judge_consumers(mods[..], n, consumed[..], cons, run, cons_counts[..], cons_used[..]);
  for k: 0..<lc_line_count(cons) {
    line := lc_nth_line(cons, k);
    if lc_cons_kind(line) < 2 || lc_word(line, 2).count == 0 { continue; }
    size := fs_read(lc_word(line, 2), body[..]);
    if size < 0 || !lc_evidence_names(line, cast(string) body[0..<size]) {
      bad += 1;
      print("FAIL consumers: the line \"%\" names % as its evidence, which % (the prefix's path under metaverse-engine/, or the module's file name, must be in it)\n", line, lc_word(line, 2), ifx size < 0 then "is not a file here" else "does not name the prefix");
    }
  }

  // the allowlist against the base's copy: it only shrinks
  added: [1] int;
  commit: [1024] u8; cn := 0;
  for c: base { if cn < 1000 { commit[cn] = c; cn += 1; } }
  for c: "^{commit}" { commit[cn] = c; cn += 1; }
  rp := [5] string.["git", "rev-parse", "--verify", "--quiet", cast(string) commit[0..<cn]];
  v := proc_run(rp[..], 60000, body[..], err[..]);
  if v.started != 0 || v.status != 0 {
    print("note: % is not a commit here, so the allowlist was not compared with it; pass --base REV\n", base);
  } else {
    spec: [1024] u8; sn := 0;
    for c: base { if sn < 900 { spec[sn] = c; sn += 1; } }
    spec[sn] = ':'; sn += 1;
    for c: LC_ALLOW { spec[sn] = c; sn += 1; }
    show := [3] string.["git", "show", cast(string) spec[0..<sn]];
    s := proc_run(show[..], 60000, body[..], err[..]);
    if s.started != 0 || s.status != 0 {
      // the commit that adds the file seeds it with the loads that were there
      print("note: % has no %, so this is its seed and its lines were not compared\n", base, LC_ALLOW);
    } else {
      bad += lc_grown(allow, cast(string) body[0..<s.out_n], run, added[..]);
      if added[0] > 0 { print("note: % line% of % not in %'s copy; a new line needs a reason and an issue number\n", added[0], ifx added[0] == 1 then "" else "s", LC_ALLOW, base); }
    }
  }

  total := found[1] + found[2] + found[3] + found[4];
  print("layer-check: aethyr-up %, everglade-up %, tests %, context %, model-effects % (of % in %), total % loads across the layers (each needs a line in %), room-v1 % (none allowed), no-consumer modules: % with no line (none allowed), % adopted, % the book's, % built by name, % a pipeline's (%), % failed\n", found[1], found[2], found[3], found[4], found[LC_MODEL_EFFECTS], model_checked[0], LC_MODELS, total, LC_ALLOW, room_v1, cons_counts[0], cons_counts[1], cons_counts[2], cons_counts[3], cons_counts[4], LC_CONSUMERS, bad);
  return ifx bad == 0 then 0 else 1;
}

// ---------------------------------------------------------------- checks

LC_T_QUIET :: LcRun.{quiet = true};
// git grep -n output: an engine module loading the page's wire, a test and a sibling; a test that
// may load anything; a tool program; a game file loading the web app; a page loading the engine.
LC_T_LOADS :: "metaverse-engine/net/latency.coax:5:#load \"../../everglade/shared/everglade-wire.coax\";\nmetaverse-engine/net/latency.coax:6:#load \"../tests/net-fixture.coax\";\nmetaverse-engine/net/latency.coax:7:#load \"clock.coax\";\nmetaverse-engine/tests/net-checks.coax:3:#load \"../../metaverse/everglade/zone.coax\";\nmetaverse-engine/host/build-x.coax:2:#load \"../../coax/web/wasm-chrome.coax\";\neverglade/zone.coax:4:#load \"../apps/openagents-web/hud.coax\";\neverglade/zone.coax:5:#load \"../metaverse-engine/net/latency.coax\";\napps/openagents-web/page.coax:9:#load \"../../metaverse-engine/net/latency.coax\";\n";
LC_T_TOOLS :: "metaverse-engine/host/build-x.coax\n";
LC_T_ALLOW :: "# seed\naethyr-up metaverse-engine/net/latency.coax -> everglade/shared/everglade-wire.coax\ntests metaverse-engine/net/latency.coax -> metaverse-engine/tests/net-fixture.coax\neverglade-up everglade/zone.coax -> apps/openagents-web/hud.coax\n";

#test "a load line: its file, its line and the path it names" {
  l := lc_parse("metaverse-engine/ui/draw.coax:6:#load \"../../metaverse/hud/frame.coax\" as frame;");
  #assert l.ok && l.from == "metaverse-engine/ui/draw.coax" && l.line == 6 && l.rel == "../../metaverse/hud/frame.coax";
  #assert !lc_parse("a.coax:3:// #load \"x.coax\";").ok && !lc_parse("a.coax:3:#load \"\";").ok && !lc_parse("a.coax:x:#load \"b.coax\";").ok && !lc_parse("").ok;
  o: [256] u8;
  #assert lc_resolve("metaverse-engine/net", "../../everglade/shared/everglade-wire.coax", o[..]) == "everglade/shared/everglade-wire.coax";
  #assert lc_resolve("metaverse-engine/move", "walk.coax", o[..]) == "metaverse-engine/move/walk.coax" && lc_resolve("metaverse-engine/a", "./b/../c.coax", o[..]) == "metaverse-engine/a/c.coax";
  #assert lc_resolve("a", "../../b.coax", o[..]) == "" && lc_resolve("a", "/Users/x/b.coax", o[..]) == "";
  #assert lc_dir("metaverse-engine/net/latency.coax") == "metaverse-engine/net" && lc_dir("a.coax") == "";
  #assert lc_cmp("metaverse-engine/a", "metaverse-engine/b") < 0 && lc_cmp("metaverse-engine/a", "metaverse-engine/a") == 0 && lc_cmp("metaverse-engine/a/b", "metaverse-engine/a") > 0;
}
#test "support code: tests, checks, tools, examples, the book and programs" {
  #assert lc_support_path("metaverse-engine/tests/walk.coax") && lc_support_path("metaverse-engine/render/tools/bake.coax") && lc_support_path("metaverse-engine/examples/one-press.coax") && lc_support_path("metaverse-engine/book/tools/x.coax") && lc_support_path("metaverse-engine/lab/physics-lab.coax") && lc_support_path("metaverse-engine/space/fixtures/a.coax");
  #assert lc_support_path("metaverse-engine/anim/bundle-checks.coax") && lc_support_path("metaverse-engine/actors/checks.coax") && lc_support_path("metaverse-engine/host/check-browser.coax") && lc_support_path("metaverse-engine/a_test.coax");
  #assert !lc_support_path("metaverse-engine/move/walk.coax") && !lc_support_path("metaverse-engine/render/checker.coax") && !lc_support_path("metaverse-engine/contest/a.coax") && !lc_support_path("metaverse-engine/toolsy/a.coax");
  #assert lc_support("metaverse-engine/host/build-x.coax", LC_T_TOOLS) && !lc_support("metaverse-engine/host/build", LC_T_TOOLS);
  #assert lc_in_tests("metaverse-engine/tests/a.coax") && lc_in_tests("coax/lib/test/a.coax") && !lc_in_tests("metaverse-engine/tests.coax") && !lc_in_tests("metaverse-engine/latest/a.coax");
}
#test "the rules: up from aethyr, up from everglade, and product code loading tests" {
  #assert lc_rule("metaverse-engine/net/latency.coax", "everglade/shared/everglade-wire.coax") == LC_UP_AETHYR;
  #assert lc_rule("metaverse-engine/ui/draw.coax", "metaverse/hud/frame.coax") == LC_UP_AETHYR && lc_rule("metaverse-engine/a.coax", "everglade/zone.coax") == LC_UP_AETHYR && lc_rule("metaverse-engine/a.coax", "coax/web/wasm-chrome.coax") == LC_UP_AETHYR;
  #assert lc_rule("metaverse-engine/a.coax", "coax/lib/json/json.coax") == 0 && lc_rule("metaverse-engine/a.coax", "psionic/lib/a.coax") == 0 && lc_rule("metaverse-engine/a.coax", "metaverse-engine/b.coax") == 0;
  #assert lc_rule("everglade/zone.coax", "apps/openagents-web/hud.coax") == LC_UP_EVERGLADE && lc_rule("everglade/zone.coax", "metaverse/everglade/a.coax") == 0 && lc_rule("everglade/zone.coax", "metaverse-engine/a.coax") == 0;
  #assert lc_rule("metaverse-engine/move/walk.coax", "metaverse-engine/tests/walk-fixture.coax") == LC_TESTS && lc_rule("everglade/a.coax", "coax/lib/tests/x.coax") == LC_TESTS && lc_rule("coax/web/api/a.coax", "coax/web/api/tests/x.coax") == LC_TESTS && lc_rule("coax/web/room/a.coax", "coax/web/room/tests/x.coax") == LC_TESTS && lc_rule("pay/a.coax", "coax/tests/x.coax") == LC_TESTS && lc_rule("pay/a.coax", "coax/lib/x.coax") == 0;
  // the other trees are not judged here
  #assert lc_rule("rules/srd/a-probes.coax", "metaverse/experimental-hostiles.coax") == LC_UP_AETHYR && lc_rule("rules/srd/a.coax", "metaverse-engine/tests/x.coax") == LC_TESTS && lc_rule("rules/srd/a.coax", "metaverse-engine/core/math.coax") == 0;
  #assert lc_rule("metaverse/a.coax", "apps/b.coax") == 0 && lc_rule("coax/lib/a.coax", "coax/lib/tests/b.coax") == 0;
}
#test "a checks file beside its module: a plain load fails, a check load passes, and a module that is only named like one is product code" {
  #assert lc_checks_file("metaverse-engine/anim/bundle-checks.coax") && lc_checks_file("everglade/server/checks.coax") && lc_checks_file("pay/test_wallet.coax") && lc_checks_file("pay/test-wallet.coax") && lc_checks_file("a_test.coax") && lc_checks_file("rules/srd/a-test.coax");
  // programs and diagnostics are not checks files, and neither is a name that only contains the word
  #assert !lc_checks_file("metaverse-engine/host/check-browser.coax") && !lc_checks_file("metaverse-engine/anim/pose-check.coax") && !lc_checks_file("metaverse-engine/a_check.coax") && !lc_checks_file("metaverse-engine/render/checker.coax") && !lc_checks_file("metaverse-engine/checks/a.coax") && !lc_checks_file("metaverse-engine/mychecks.coax") && !lc_checks_file("metaverse-engine/latest.coax");
  #assert lc_rule("metaverse-engine/anim/bundle.coax", "metaverse-engine/anim/bundle-checks.coax") == LC_TESTS && lc_rule("coax/web/api/a-policy.coax", "coax/web/api/a-checks.coax") == LC_TESTS && lc_rule("pay/wallet.coax", "pay/checks.coax") == LC_TESTS;
  #assert lc_rule("metaverse/a.coax", "metaverse/a-checks.coax") == 0 && lc_rule("metaverse-engine/host/x-tool.coax", "metaverse-engine/host/check-x.coax") == 0;
  used: [4] bool;
  f: [LC_RULES] int;
  #assert lc_judge("everglade/server/room-everglade.coax:9:#load \"room-checks.coax\";\n", "", "", used[..], LC_T_QUIET, f[..]) == 1 && f[LC_TESTS] == 1;
  g: [LC_RULES] int;
  #assert lc_judge("everglade/server/room-everglade.coax:9:#load \"room-checks.coax\" #test;\n", "", "", used[..], LC_T_QUIET, g[..]) == 0 && g[LC_TESTS] == 0;
  // a fuzzer is support code: it loads the room's checks plainly
  h: [LC_RULES] int;
  #assert lc_support_path("coax/web/room/fuzz/wire-fuzz.coax") && lc_judge("coax/web/room/fuzz/wire-fuzz.coax:4:#load \"../../../../everglade/server/room-checks.coax\";\n", "", "", used[..], LC_T_QUIET, h[..]) == 0;
  // the SRD's ability checks are a module: loaded plainly, and judged like one
  #assert lc_named_module("rules/srd/ability-checks.coax") && !lc_named_module("rules/srd/ability-checks.coax.bak") && !lc_named_module("rules/srd/dice-checks.coax");
  #assert !lc_checks_file("rules/srd/ability-checks.coax") && !lc_support_path("rules/srd/ability-checks.coax") && !lc_support_path("rules/srd/check-training.coax") && !lc_support_path("metaverse-engine/anim/scene-check.coax") && lc_support_path("rules/srd/dice-checks.coax");
  k: [LC_RULES] int;
  #assert lc_judge("rules/srd/battle.coax:5:#load \"ability-checks.coax\";\n", "", "", used[..], LC_T_QUIET, k[..]) == 0;
  m: [LC_RULES] int;
  #assert lc_judge("rules/srd/ability-checks.coax:5:#load \"../../everglade/model/content.coax\";\nrules/srd/dice-checks.coax:5:#load \"../../everglade/model/content.coax\";\n", "", "", used[..], LC_T_QUIET, m[..]) == 1 && m[LC_UP_AETHYR] == 1;
}
#test "a check load of a file in a tests folder passes; a plain one fails" {
  #assert lc_parse("a.coax:1:#load \"b.coax\" #test;").checks && lc_parse("a.coax:1:#load \"b.coax\"  #test ;").checks;
  #assert !lc_parse("a.coax:1:#load \"b.coax\";").checks && !lc_parse("a.coax:1:#load \"b.coax\" as b;").checks && !lc_parse("a.coax:1:#load \"b.coax\"; // #test").checks;
  used: [4] bool;
  f: [LC_RULES] int;
  #assert lc_judge("metaverse-engine/move/walk.coax:26:#load \"tests/walk-fixture.coax\" #test;\nmetaverse-engine/move/walk.coax:27:#load \"../tests/walk-oracle.coax\" #test;\n", "", "", used[..], LC_T_QUIET, f[..]) == 0 && f[LC_TESTS] == 0;
  g: [LC_RULES] int;
  #assert lc_judge("metaverse-engine/move/walk.coax:27:#load \"../tests/walk-oracle.coax\";\npay/a.coax:2:#load \"tests/a.coax\";\n", "", "", used[..], LC_T_QUIET, g[..]) == 2 && g[LC_TESTS] == 2;
  // a checks file is support code: it loads its fixtures plainly; a file outside the ruled folders is not judged
  h: [LC_RULES] int;
  #assert lc_judge("metaverse-engine/move/walk-tuning-checks.coax:2:#load \"../tests/walk-fixture.coax\";\nmetaverse/a.coax:2:#load \"tests/a.coax\";\n", "", "", used[..], LC_T_QUIET, h[..]) == 0;
  // a check load up the layers is still an upward load
  k: [LC_RULES] int;
  #assert lc_judge("metaverse-engine/move/walk.coax:3:#load \"../../metaverse/tests/x.coax\" #test;\n", "", "", used[..], LC_T_QUIET, k[..]) == 1 && k[LC_UP_AETHYR] == 1 && k[LC_TESTS] == 0;
}
#test "the seeded allowlist passes; a new upward load fails" {
  used: [8] bool; found: [LC_RULES] int;
  #assert lc_judge(LC_T_LOADS, LC_T_TOOLS, LC_T_ALLOW, used[..], LC_T_QUIET, found[..]) == 0;
  #assert found[LC_UP_AETHYR] == 1 && found[LC_UP_EVERGLADE] == 1 && found[LC_TESTS] == 1 && used[1] && used[2] && used[3] && !used[0];
  #assert lc_judge_allow(LC_T_ALLOW, used[..], LC_T_QUIET) == 0;
  // one more load from the engine up into a realm
  more := "metaverse-engine/ui/draw.coax:6:#load \"../../metaverse/hud/frame.coax\";\n";
  fresh: [8] bool; f2: [LC_RULES] int;
  joined: [4096] u8; n := 0;
  for c: LC_T_LOADS { joined[n] = c; n += 1; }
  for c: more { joined[n] = c; n += 1; }
  #assert lc_judge(cast(string) joined[0..<n], LC_T_TOOLS, LC_T_ALLOW, fresh[..], LC_T_QUIET, f2[..]) == 1 && f2[LC_UP_AETHYR] == 2;
  // and a product module that loads a test file, and a game file that loads the web app
  f3: [LC_RULES] int;
  #assert lc_judge("metaverse-engine/move/walk.coax:26:#load \"tests/walk-fixture.coax\";\neverglade/dash.coax:2:#load \"../apps/a/b.coax\";\n", "", "", fresh[..], LC_T_QUIET, f3[..]) == 2 && f3[LC_TESTS] == 1 && f3[LC_UP_EVERGLADE] == 1;
  // the same path loaded twice is one load; an absolute path is not judged
  f4: [LC_RULES] int;
  #assert lc_judge("metaverse-engine/a.coax:1:#load \"../metaverse/b.coax\";\nmetaverse-engine/a.coax:2:#load \"../metaverse/b.coax\";\nmetaverse-engine/a.coax:3:#load \"/x/metaverse/b.coax\";\n", "", "", fresh[..], LC_T_QUIET, f4[..]) == 1 && f4[LC_UP_AETHYR] == 1;
}
#test "the room's closure: an Everglade v1 file it reaches through another fails; everglade/shared/ and v1's own loads do not (#13346)" {
  loads := "coax/web/room/room.coax:3:#load \"room-a.coax\";\ncoax/web/room/room-a.coax:1:#load \"../../../everglade/shared/everglade-wire.coax\";\neverglade/shared/everglade-wire.coax:2:#load \"everglade-forest-profile.coax\";\napps/openagents-web/everglade.coax:9:#load \"everglade5e-rules.coax\";\n";
  #assert lc_room_v1(loads, LC_ROOM, LC_T_QUIET) == 0;
  more := "coax/web/room/room-a.coax:2:#load \"../../../apps/openagents-web/everglade-cast-rules.coax\";\napps/openagents-web/everglade-cast-rules.coax:1:#load \"everglade5e-rules.coax\";\ncoax/web/room/room.coax:4:#load \"room-a.coax\";\n";
  joined: [4096] u8; n := 0;
  for c: loads { joined[n] = c; n += 1; }
  for c: more { joined[n] = c; n += 1; }
  #assert lc_room_v1(cast(string) joined[0..<n], LC_ROOM, LC_T_QUIET) == 2;   // each named once, however reached
  #assert lc_v1("apps/openagents-web/everglade5e.coax") && lc_v1("apps/openagents-web/everglade-wire.coax") && !lc_v1("everglade/shared/move.coax") && !lc_v1("everglade/shared/everglade-wire.coax");
}
#test "the allowlist stays true and only shrinks" {
  used: [8] bool;
  // a line no load needs, and lines that are not RULE FROM -> TO
  #assert lc_judge_allow("aethyr-up metaverse-engine/gone.coax -> metaverse/a.coax\n", used[..], LC_T_QUIET) == 1;
  used[0] = true;
  #assert lc_judge_allow("aethyr-up metaverse-engine/gone.coax -> metaverse/a.coax\n", used[..], LC_T_QUIET) == 0;
  #assert lc_judge_allow("up metaverse-engine/a.coax -> metaverse/a.coax\n", used[..], LC_T_QUIET) == 1 && lc_judge_allow("aethyr-up metaverse-engine/a.coax metaverse/a.coax\n", used[..], LC_T_QUIET) == 1 && lc_judge_allow("tests a -> b c\n", used[..], LC_T_QUIET) == 1;
  #assert lc_entry_rule("tests metaverse-engine/a.coax -> metaverse-engine/tests/b.coax") == LC_TESTS && lc_entry_rule("everglade-up a -> b") == LC_UP_EVERGLADE && lc_entry_rule("context a -> b") == LC_CONTEXT;
  base := "# seed\naethyr-up metaverse-engine/a.coax -> metaverse/a.coax\ntests metaverse-engine/b.coax -> metaverse-engine/tests/b.coax\n";
  added: [1] int;
  #assert lc_grown(base, base, LC_T_QUIET, added[..]) == 0 && lc_grown("tests metaverse-engine/b.coax -> metaverse-engine/tests/b.coax\n", base, LC_T_QUIET, added[..]) == 0 && added[0] == 0;
  #assert lc_grown("aethyr-up metaverse-engine/c.coax -> apps/x.coax\n", base, LC_T_QUIET, added[..]) == 1 && added[0] == 1;
  #assert lc_grown("aethyr-up metaverse-engine/c.coax -> apps/x.coax  # later\n", base, LC_T_QUIET, added[..]) == 1;
  added[0] = 0;
  #assert lc_grown("aethyr-up metaverse-engine/c.coax -> apps/x.coax  # the HUD frame moves down in P2.1 (#13270)\n", base, LC_T_QUIET, added[..]) == 0 && added[0] == 1;
  #assert lc_reasoned("a  # why (#123)") && !lc_reasoned("a") && !lc_reasoned("a # #1234");
}
#test "contexts.txt: allowed loads pass, disallowed loads fail, allowlisted loads pass" {
  ctext := "# contexts\nengine folders: metaverse-engine/ may load: toolchain\ncombat-rules folders: rules/srd/ metaverse-engine/rules/srd/ may load: engine toolchain\nroom-session folders: metaverse-engine/session/ coax/web/room/ may load: combat-rules engine toolchain\npayments folders: pay/ coax/lib/bitcoin/ may load: toolchain\ntoolchain folders: coax/lib/ may load:\nworld folders: everglade/world/ everglade/server/ everglade/client/ everglade/server/legacy/ may load: engine combat-rules toolchain\n";
  ctxs := lc_parse_contexts(ctext);
  #assert ctxs.ok && ctxs.n == 6;
  // longest prefix wins: metaverse-engine/rules/srd/ belongs to combat-rules, not engine; coax/lib/bitcoin/ to payments, not toolchain
  #assert ctxs.ctxs[lc_context_of(ctxs, "metaverse-engine/move/walk.coax")].slug == "engine";
  #assert ctxs.ctxs[lc_context_of(ctxs, "metaverse-engine/rules/srd/dice.coax")].slug == "combat-rules";
  #assert ctxs.ctxs[lc_context_of(ctxs, "coax/lib/bitcoin/tx.coax")].slug == "payments";
  #assert ctxs.ctxs[lc_context_of(ctxs, "coax/lib/json/json.coax")].slug == "toolchain";
  #assert ctxs.ctxs[lc_context_of(ctxs, "everglade/server/legacy/v1.coax")].slug == "world";
  #assert lc_context_of(ctxs, "docs/x.coax") < 0;
  // allowed cross-context load (room-session -> combat-rules) and same-context load pass
  ok_loads := "metaverse-engine/session/turn.coax:3:#load \"../rules/srd/dice.coax\";\nmetaverse-engine/session/turn.coax:4:#load \"seat.coax\";\neverglade/server/legacy/v1.coax:2:#load \"../../../metaverse-engine/move/walk.coax\";\n";
  used: [8] bool; found: [LC_RULES] int;
  #assert lc_judge_with_contexts(ok_loads, "", "", ctxs, used[..], LC_T_QUIET, found[..]) == 0 && found[LC_CONTEXT] == 0;
  // disallowed cross-context load (room-session -> payments) fails without an allowlist line
  bad_loads := "metaverse-engine/session/turn.coax:5:#load \"../../coax/lib/bitcoin/tx.coax\";\n";
  f2: [LC_RULES] int;
  #assert lc_judge_with_contexts(bad_loads, "", "", ctxs, used[..], LC_T_QUIET, f2[..]) == 1 && f2[LC_CONTEXT] == 1;
  // allowlisted cross-context load passes and marks its allowlist line used
  allow := "context metaverse-engine/session/turn.coax -> coax/lib/bitcoin/tx.coax  # seeded (#13317)\n";
  u3: [8] bool; f3: [LC_RULES] int;
  #assert lc_judge_with_contexts(bad_loads, "", allow, ctxs, u3[..], LC_T_QUIET, f3[..]) == 0 && f3[LC_CONTEXT] == 1 && u3[0];
  #assert lc_judge_allow(allow, u3[..], LC_T_QUIET) == 0;
  // support code in a context is exempt, and contexts.txt validation rejects malformed lines or unknown may-load slugs
  u4: [8] bool; f4: [LC_RULES] int;
  #assert lc_judge_with_contexts("metaverse-engine/session/tests/t.coax:1:#load \"../../../coax/lib/bitcoin/tx.coax\";\n", "", "", ctxs, u4[..], LC_T_QUIET, f4[..]) == 0;
  #assert !lc_parse_contexts("engine folders: metaverse-engine/ may load: nope\n").ok && !lc_parse_contexts("engine metaverse-engine/\n").ok;
}
#test "model-effects: a listed file with #effects(all) fails, one with narrow effects passes" {
  found: [LC_RULES] int;
  narrow := "// Narrowed from #effects(all)\nf :: (x: int) -> int #effects(reads, writes, traps) { return x + 1; }\ng :: () -> int #effects() { return 0; }\n";
  #assert lc_judge_model_source("metaverse-engine/session/ledger.coax", narrow, LC_T_QUIET, found[..]) == 0 && found[LC_MODEL_EFFECTS] == 0;
  wide := "f :: (x: int) -> int #effects(reads, writes, traps) { return x; }\nbad :: () #effects(all) {}\n";
  #assert lc_model_all_line(wide) == 2;
  #assert lc_judge_model_source("metaverse-engine/session/ledger.coax", wide, LC_T_QUIET, found[..]) == 1 && found[LC_MODEL_EFFECTS] == 1;
  // model-effects is never allowlisted
  #assert lc_entry_rule("model-effects metaverse-engine/session/ledger.coax -> a") == 0;
}
#test "consumers list: the longest prefix covers a module; an uncovered module, a stale line and a bad line fail" {
  list := "# why each is kept\nadopt metaverse-engine/world/ #13280  # one world\nbook metaverse-engine/world/weather.coax metaverse-engine/book/ch071.md\nbuilt metaverse-engine/render/carriers/ coax/web/wasm.sh\npipeline metaverse-engine/render/film.coax metaverse-engine/tools/film-frames.coax\n";
  #assert lc_cons_kind("adopt a #1") == 1 && lc_cons_kind("book a b") == 2 && lc_cons_kind("built a b") == 3 && lc_cons_kind("pipeline a b") == 4 && lc_cons_kind("# adopt") == 0 && lc_cons_kind("") == 0 && lc_cons_kind("adopted a #1") == 0;
  #assert lc_issue("#13280") && !lc_issue("#") && !lc_issue("13280") && !lc_issue("#13a") && !lc_issue("");
  #assert lc_line_count(list) == 5 && lc_line_count("a") == 1 && lc_line_count("") == 0 && lc_nth_line(list, 1) == "adopt metaverse-engine/world/ #13280  # one world" && lc_nth_line(list, 9) == "" && lc_nth_line(" a \nb", 0) == "a" && lc_nth_line("a\nb", 1) == "b";
  #assert lc_cover(list, "metaverse-engine/world/cells.coax") == 1 && lc_cover(list, "metaverse-engine/world/weather.coax") == 2 && lc_cover(list, "metaverse-engine/render/carriers/a.coax") == 3 && lc_cover(list, "metaverse-engine/render/passes.coax") == -1 && lc_cover("", "metaverse-engine/a.coax") == -1;
  mods := [5] string.["metaverse-engine/core/loop.coax", "metaverse-engine/render/carriers/a.coax", "metaverse-engine/render/film.coax", "metaverse-engine/world/cells.coax", "metaverse-engine/world/weather.coax"];
  consumed := [5] bool.[true, false, false, false, false];
  counts: [5] int; used: [8] bool;
  #assert lc_judge_consumers(mods[..], 5, consumed[..], list, LC_T_QUIET, counts[..], used[..]) == 0;
  #assert counts[0] == 0 && counts[1] == 1 && counts[2] == 1 && counts[3] == 1 && counts[4] == 1 && !used[0] && used[1] && used[2] && used[3] && used[4];
  // a consumed module needs no line, so its line is stale; an uncovered module fails
  all := [5] bool.[true, true, true, true, true];
  c2: [5] int; u2: [8] bool;
  #assert lc_judge_consumers(mods[..], 5, all[..], list, LC_T_QUIET, c2[..], u2[..]) == 4 && c2[0] == 0;
  c3: [5] int; u3: [8] bool;
  #assert lc_judge_consumers(mods[..], 5, consumed[..], "adopt metaverse-engine/world/ #13280\n", LC_T_QUIET, c3[..], u3[..]) == 2 && c3[0] == 2 && c3[1] == 2;
  // an adopt line names an issue; every line has its evidence word; an unknown kind fails
  c4: [5] int; u4: [8] bool;
  #assert lc_judge_consumers(mods[..], 1, all[..], "adopt metaverse-engine/world/ later\n", LC_T_QUIET, c4[..], u4[..]) == 1;
  #assert lc_judge_consumers(mods[..], 1, all[..], "book metaverse-engine/world/\n", LC_T_QUIET, c4[..], u4[..]) == 1;
  #assert lc_judge_consumers(mods[..], 1, all[..], "keep metaverse-engine/world/ #1\n", LC_T_QUIET, c4[..], u4[..]) == 1;
  #assert lc_judge_consumers(mods[..], 1, all[..], "# a comment\n\n", LC_T_QUIET, c4[..], u4[..]) == 0;
  #assert lc_evidence_names("book metaverse-engine/world/weather.coax ch", "see [weather](../world/weather.coax)") && !lc_evidence_names("book metaverse-engine/world/weather.coax ch", "see weather") && !lc_evidence_names("book metaverse/a.coax ch", "metaverse/a.coax");
  #assert lc_evidence_names("pipeline metaverse-engine/audio/measure.coax t", "#load \"measure.coax\";") && !lc_evidence_names("adopt metaverse-engine/audio/ t", "audio") && lc_evidence_names("book metaverse-engine/space/ ch", "(../space/frames.coax)");
}
#test "consumers: a module a product loads, directly or through another module, is consumed" {
  mods := [4] string.["metaverse-engine/a.coax", "metaverse-engine/b.coax", "metaverse-engine/c.coax", "metaverse-engine/d.coax"];
  loads := "apps/page.coax:1:#load \"../metaverse-engine/a.coax\";\nmetaverse-engine/a.coax:1:#load \"b.coax\";\nmetaverse-engine/tests/t.coax:1:#load \"../c.coax\";\nmetaverse-engine/d.coax:1:#load \"c.coax\";\ndocs/x/y.coax:1:#load \"../../metaverse-engine/d.coax\";\n";
  consumed: [4] bool; loaders: [4] int;
  lc_consumed(loads, "", mods[..], 4, consumed[..], loaders[..]);
  #assert consumed[0] && consumed[1] && !consumed[2] && !consumed[3];
  #assert loaders[0] == 1 && loaders[1] == 1 && loaders[2] == 2 && loaders[3] == 1;
  #assert lc_find(mods[..], 4, "metaverse-engine/c.coax") == 2 && lc_find(mods[..], 4, "metaverse-engine/e.coax") == -1;
}
