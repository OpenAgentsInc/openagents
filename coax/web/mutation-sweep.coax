// The nightly mutation sweep (GitHub #13583). The gate that blocks a change mutates only the
// procedures it touched (`coax mutate --changed`, through coax/remote/check.sh); this sweep
// mutates every procedure of every #authority file, reports, and blocks nothing:
//   1. the work: `tool.sh suites --list --authority-units`, which puts each #authority file
//      under one suite, the one whose #load closure reaching it is smallest, and each one no suite
//      reaches under the smallest file with checks that reaches it (often itself), everywhere but
//      docs/, coax/tests/, coax/book/, coax/examples/ and psionic/ (suites.coax, su_sweep_scope)
//   2. each suite's files split into one part per eight files, at most --parts; each part is one
//      `coax mutate SUITE --unit A --unit B ... --killers K` (one baseline for all its files,
//      #13581) on the build pool (coax/remote/remote.sh run: its hosts, slots and spend cap),
//      at most --jobs at once; K is that part's killers file from the last night, which the
//      run then rewrites, so a night only repeats the checks that killed last time first.
//      A part stops after --part-minutes (default 180; remote.sh's OA_REMOTE_TIMEOUT) and is
//      reported as stopped; the native kills it found are in K already, so the next night resumes
//      from them. A part ran when it reported every file it was given.
//      Each part runs with --native --mutation-stats (#13587): native code finds each mutant's
//      killer and the evaluator confirms it, and the run's stderr comes with its stdout, so the
//      sweep reads every unit's `native-mutants agree= limits= disagree=` line
//   3. the parts' reports joined: one row a file, its survivors under it, and the native
//      counts summed: limits (native ticks against evaluator steps) and disagreements (a coax
//      bug in the native path; never a verdict), each listed, so a drift shows
//   4. one tracking issue (ms_issue_step): a clean sweep (every part ran, no survivor and no
//      undecided mutant) rewrites its body and closes it with the summary as the closing comment;
//      a sweep that isn't clean reopens it, or files it when there is none, and rewrites its body.
//      A clean sweep with no issue files nothing. The issue is the number kept in STATE/issue, else
//      the newest one with this title in any state, so a lost state folder never files a second.
//      --dry-run prints the report and touches no issue
// State lives in --state DIR (default mutation-sweep/ at the checkout's root, untracked, so
// remote.sh sends the killers files with the snapshot and brings the rewritten ones back):
// killers/, parts/ (each part's output), report.md and issue (the tracking issue's number).
//   coax/web/tool.sh mutation-sweep [--parts N] [--jobs J] [--part-minutes M] [--only SUITE,SUITE]
//                                   [--state DIR] [--local] [--dry-run] [--issue N]
//   coax/bin/coax test coax/web/mutation-sweep.coax --library     its own checks
// Run it from a clean checkout of origin/main (coax/remote/mutation-sweep.sh makes one).
// Exit 0 when every part ran (survivors are the report, not a failure), 1 when a part could
// not run or the issue could not be written, 2 on bad usage.
#import "Basic";
#load "../lib/sys/args.coax";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/proc.coax";
#load "mutation-sweep-host.coax";

MS_SUITES :: 1024;
MS_UNITS :: 64;                // #authority files one part mutates
MS_PARTS_MAX :: 16;            // parts a suite
MS_PER_PART :: 8;              // files a part holds before a suite splits: each part repeats the baseline
MS_JOBS :: 18;                 // parts at once: 6 hosts x 3 slots (remote.sh's defaults)
MS_TEXT :: 4194304;            // the suite list, a part's output, the report
MS_BODY :: 60000;              // a GitHub issue body holds 65,536 characters
MS_SHOW :: 12;                 // survivors shown a file
MS_TITLE :: "Nightly mutation sweep: survivors in #authority files";
// gh issue list's rows cut to the newest with exactly that title, as "NUMBER STATE" (ms_found)
MS_JQ :: "[.[] | select(.title == \"Nightly mutation sweep: survivors in #authority files\")] | first // empty | \"\\(.number) \\(.state)\"";
#test "the issue search keeps the newest issue with exactly the sweep's title" { #assert ms_has(MS_JQ, MS_TITLE) && ms_has(MS_JQ, "\"\\(.number) \\(.state)\"") && ms_has(MS_JQ, "| first //"); }
MS_PART_MINUTES :: 180;       // a part's time limit: a hang guard; the native kills it found are kept
MS_LANE :: 2097152;            // a part's output kept: 30 battle units with their survivors' source lines

MsSuite :: struct { path: string; library: bool; root_only: bool; run_steps: string; traversal: string; units: string; nunits: int; }
// want: the files it was given; got: the files its output reported; status: remote.sh's exit
MsPart :: struct { suite: int; part: int; parts: int; h: int; ok: bool; started_ms: int; want: int; got: int; status: int; cut: bool; }
// Kept text: bytes is a view of the caller's buffer.
MsText :: struct { bytes: [] u8; used: int; full: bool; }

ms_put :: (t: [] MsText, s: string) {
  if t[0].used + s.count > t[0].bytes.count { t[0].full = true; return; }
  for i: 0..<s.count { t[0].bytes[t[0].used + i] = s[i]; }
  t[0].used += s.count;
}
ms_text :: (t: [] MsText) -> string { return cast(string) t[0].bytes[0..<t[0].used]; }
ms_keep :: (t: [] MsText, s: string) -> string {
  at := t[0].used;
  ms_put(t, s);
  return ifx t[0].full then "" else cast(string) t[0].bytes[at..<at + s.count];
}
ms_itoa :: (v: int, out: [] u8) -> string {
  if out.count < 21 { return ""; }
  neg := v < 0; x := ifx neg then -v else v;
  tmp: [20] u8; n := 0;
  while true { tmp[n] = cast,trunc(u8) (48 + x % 10); n += 1; x = x / 10; if x == 0 { break; } }
  k := 0;
  if neg { out[0] = '-'; k = 1; }
  for i: 0..<n { out[k + i] = tmp[n - 1 - i]; }
  return cast(string) out[0..<k + n];
}
#test "numbers as text" { b: [32] u8; #assert ms_itoa(0, b[..]) == "0" && ms_itoa(4096, b[..]) == "4096" && ms_itoa(-7, b[..]) == "-7"; }
ms_starts :: (s: string, word: string) -> bool {
  if word.count > s.count { return false; }
  for i: 0..<word.count { if s[i] != word[i] { return false; } }
  return true;
}
ms_has :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  i := 0;
  while i + needle.count <= hay.count {
    if cast(string) hay[i..<i + needle.count] == needle { return true; }
    i += 1;
  }
  return false;
}
// The word after `flag ` in line, or "".
ms_after :: (line: string, flag: string) -> string {
  i := 0;
  while i + flag.count + 1 <= line.count {
    if cast(string) line[i..<i + flag.count] == flag && line[i + flag.count] == ' ' {
      e := i + flag.count + 1;
      while e < line.count && line[e] != ' ' { e += 1; }
      return cast(string) line[i + flag.count + 1..<e];
    }
    i += 1;
  }
  return "";
}
// The k-th comma-separated item of list.
ms_item :: (list: string, k: int) -> string {
  at := 0; s := 0;
  for i: 0..<list.count + 1 {
    if i == list.count || list[i] == ',' {
      if at == k { return cast(string) list[s..<i]; }
      at += 1; s = i + 1;
    }
  }
  return "";
}
ms_items :: (list: string) -> int {
  if list.count == 0 { return 0; }
  n := 1;
  for c: list { if c == ',' { n += 1; } }
  return n;
}
// A suite path as one file name: '/' becomes '_'.
ms_slug :: (path: string, out: [] u8) -> string {
  n := ifx path.count < out.count then path.count else out.count;
  for i: 0..<n { out[i] = ifx path[i] == '/' then '_' else path[i]; }
  return cast(string) out[0..<n];
}

// The suites of `suites --list --authority-units` that hold #authority files:
// "PATH  BUDGET [--library] [--root-only] [--run-steps N] ...  #authority FILE,FILE".
ms_suites :: (list: string, only: string, keep: [] MsText, out: [] MsSuite) -> int {
  n := 0; i := 0;
  while i < list.count && n < out.count {
    j := i;
    while j < list.count && list[j] != '\n' { j += 1; }
    line := cast(string) list[i..<j]; i = j + 1;
    units := ms_after(line, " #authority");
    if units.count == 0 || ms_has(line, "(skipped here") { continue; }
    e := 0;
    while e < line.count && line[e] != ' ' { e += 1; }
    path := cast(string) line[0..<e];
    if path.count == 0 { continue; }
    if only.count > 0 {
      hit := false;
      for k: 0..<ms_items(only) { if ms_item(only, k) == path { hit = true; } }
      if !hit { continue; }
    }
    out[n] = MsSuite.{path = ms_keep(keep, path), library = ms_has(line, " --library"), root_only = ms_has(line, " --root-only"),
                      run_steps = ms_keep(keep, ms_after(line, "--run-steps")), traversal = ms_keep(keep, ms_after(line, "--traversal")), units = ms_keep(keep, units), nunits = ms_items(units)};
    n += 1;
  }
  return n;
}
#test "the sweep takes each suite's #authority files from the list, with its flags, and leaves the skipped ones" {
  list := "rules/srd/battle.coax  default --library --traversal 16000000000  #authority rules/srd/a.coax,rules/srd/b.coax\ncoax/web/x.coax  default\nm.coax  default --library  #authority\npay/w.coax  --steps 9 --run-steps 50 --root-only  #authority pay/w.coax\nbad.coax  default  (skipped here: loads y, not in the tree)  #authority bad.coax\n";
  kb: [4096] u8; k: [1] MsText; k[0].bytes = kb[..]; s: [8] MsSuite;
  n := ms_suites(list, "", k[..], s[..]);
  #assert n == 2 && s[0].path == "rules/srd/battle.coax" && s[0].library && !s[0].root_only && s[0].run_steps == "" && s[0].traversal == "16000000000";
  #assert s[0].nunits == 2 && ms_item(s[0].units, 1) == "rules/srd/b.coax";
  #assert s[1].path == "pay/w.coax" && !s[1].library && s[1].root_only && s[1].run_steps == "50" && s[1].nunits == 1;
  #assert ms_suites(list, "pay/w.coax", k[..], s[..]) == 1 && s[0].path == "pay/w.coax";
}

// The native counts of a part's output: its `native-mutants agree=A limits=L disagree=D
// not-compared=N ...` lines summed (one a unit; --native --mutation-stats).
MsNative :: struct { agree: int; limits: int; disagree: int; apart: int; units: int; }
// The digits after key in line, -1 when key isn't there or no digit follows.
ms_field :: (line: string, key: string) -> int {
  i := 0;
  while i + key.count <= line.count {
    if cast(string) line[i..<i + key.count] == key {
      e := i + key.count; v := 0; any := false;
      while e < line.count && line[e] >= '0' && line[e] <= '9' && v < 100000000000 { v = v * 10 + cast(int)(line[e] - '0'); e += 1; any = true; }
      return ifx any then v else -1;
    }
    i += 1;
  }
  return -1;
}
ms_native :: (out: string) -> MsNative {
  n: MsNative;
  i := 0;
  while i < out.count {
    j := i;
    while j < out.count && out[j] != '\n' { j += 1; }
    line := cast(string) out[i..<j]; i = j + 1;
    if !ms_starts(line, "native-mutants agree=") { continue; }
    a := ms_field(line, "agree="); l := ms_field(line, " limits="); d := ms_field(line, " disagree="); x := ms_field(line, " not-compared=");
    if a < 0 || l < 0 || d < 0 || x < 0 { continue; }
    n.agree += a; n.limits += l; n.disagree += d; n.apart += x; n.units += 1;
  }
  return n;
}
#test "a part's native counts are its units' lines summed" {
  out := "native-mutants agree=10 limits=1 disagree=0 not-compared=2 emit=0.01 run=1.00\nmutation scope: unit a.coax (x)\nnative-mutant-limits 4 a.coax:1:2: y\nnative-mutants agree=5 limits=0 disagree=3 not-compared=0 emit=0.01\nnative-mutants agree=x\n";
  n := ms_native(out);
  #assert n.units == 2 && n.agree == 15 && n.limits == 1 && n.disagree == 3 && n.apart == 2;
  #assert ms_field("a=1 b=22", " b=") == 22 && ms_field("a=1", "c=") == -1 && ms_field("a=", "a=") == -1;
  e := ms_native("4 mutants, 4 killed, 0 survived\n");
  #assert e.units == 0 && e.agree == 0;
}

// The number that ends right before word in line ("17 killed" for " killed"), -1 when none does.
ms_before :: (line: string, word: string) -> int {
  i := 0;
  while i + word.count <= line.count {
    if cast(string) line[i..<i + word.count] == word {
      s := i;
      while s > 0 && line[s - 1] >= '0' && line[s - 1] <= '9' { s -= 1; }
      if s == i { return -1; }
      v := 0;
      for k: s..<i { v = v * 10 + cast(int)(line[k] - '0'); }
      return v;
    }
    i += 1;
  }
  return -1;
}
#test "a count is the number before its word" {
  l := "18 mutants, 17 killed, 0 survived, 1 marked equivalent";
  #assert ms_before(l, " mutants") == 18 && ms_before(l, " killed") == 17 && ms_before(l, " marked equivalent") == 1;
  #assert ms_before(l, " not decided") == -1 && ms_before("x mutants", " mutants") == -1;
  // the first place the word is, every digit 0 to 9 and nothing else
  #assert ms_before(" a 3 a", " a") == -1 && ms_before("10 killed", " killed") == 10 && ms_before("19 survived", " survived") == 19;
  #assert ms_before("a:9 x", " x") == 9;
}

// One file's result in a part's output: from its "mutation scope: unit FILE" line to its counts line.
// undecided: mutants the run could not decide (#13605), which a clean sweep can't have.
MsUnit :: struct { path: string; line: string; survivors: int; undecided: int; mutants: int; killed: int; equivalent: int; at: int; end: int; }
ms_unit :: (out: string, from: int) -> MsUnit {
  u: MsUnit; u.at = -1;
  i := from;
  // At i == out.count the line is empty and matches nothing, so `<=` there changes nothing.
  while i < out.count { // mutant: equivalent
    j := i;
    while j < out.count && out[j] != '\n' { j += 1; }
    line := cast(string) out[i..<j];
    if u.at < 0 && ms_starts(line, "mutation scope: unit ") {
      u.at = i; e := 21;
      while e < line.count && line[e] != ' ' { e += 1; }
      u.path = cast(string) line[21..<e];
    } else if u.at >= 0 {
      if ms_has(line, ": mutant survived: ") { u.survivors += 1; }
      if ms_has(line, ": mutant not decided: ") { u.undecided += 1; }
      if ms_has(line, " killed, ") && ms_has(line, " survived") {
        u.line = line; u.end = j;
        u.mutants = ms_before(line, " mutant"); u.killed = ms_before(line, " killed");
        e := ms_before(line, " marked equivalent");
        if e >= 1 { u.equivalent = e; }
        return u;
      }
    }
    i = j + 1;
  }
  u.at = -1;
  return u;
}
#test "a part's output splits into its files' results, remote.sh's lines around them left out" {
  out := "remote: host 1\nmutation scope: unit a.coax (its procedures; every check retained)\na.coax:3:4: mutant survived: x\n  x\n4 mutants, 3 killed, 1 survived\nmutation scope: unit b.coax (its procedures; every check retained)\n3 mutants, 2 killed, 0 survived, 1 marked equivalent\nmutation scope: unit c.coax (x)\nc.coax:1:2: mutant not decided: y\n1 mutant, 0 killed, 0 survived, 1 not decided\nremote: done\n";
  a := ms_unit(out, 0);
  #assert a.at > 0 && a.path == "a.coax" && a.survivors == 1 && a.line == "4 mutants, 3 killed, 1 survived" && a.mutants == 4 && a.killed == 3;
  #assert a.undecided == 0 && a.equivalent == 0;
  b := ms_unit(out, a.end);
  #assert b.path == "b.coax" && b.survivors == 0 && b.equivalent == 1 && b.mutants == 3;
  c := ms_unit(out, b.end);
  #assert c.path == "c.coax" && c.undecided == 1 && c.survivors == 0 && c.mutants == 1;
  #assert ms_unit(out, c.end).at < 0 && ms_unit("mutation scope: unit c.coax (cut\n", 0).at < 0;
  #assert ms_units_in(out) == 3 && ms_units_in("remote: no host\n") == 0;
  // a result at the output's start, a second scope line before the counts, no newline at the end
  top := "mutation scope: unit ab.coax (x)\nmutation scope: unit b.coax (y)\n1 mutant, 1 killed, 0 survived";
  t := ms_unit(top, 0);
  #assert t.at == 0 && t.path == "ab.coax" && t.mutants == 1 && ms_units_in(top) == 1;
  #assert ms_unit("mutation scope: unit \n1 mutant, 1 killed, 0 survived\n", 0).path == "";
  #assert ms_unit("mutation scope: unit a.coax\n1 mutant, 1 killed, 0 survived\n", 0).path == "a.coax";
  #assert ms_units_in("mutation scope: unit a.coax (x)\n1 mutant, 1 killed, 0 survived\n") == 1;
}
// How many files' results a part's output holds.
ms_units_in :: (out: string) -> int {
  n := 0; at := 0;
  while true { u := ms_unit(out, at); if u.at < 0 { break; } n += 1; at = u.end; }
  return n;
}

// The one tracking issue (#13586). state: the issue's state as gh says it ("OPEN", "CLOSED"),
// "" when there is none. clean: every part ran and no file has a survivor or an undecided mutant.
MsStep :: enum u8 { NONE; FILE; EDIT; CLOSE; REOPEN; QUIET; }
ms_issue_step :: (clean: bool, state: string) -> MsStep {
  if state == "OPEN" { return ifx clean then MsStep.CLOSE else MsStep.EDIT; }
  if state == "CLOSED" { return ifx clean then MsStep.QUIET else MsStep.REOPEN; }
  return ifx clean then MsStep.NONE else MsStep.FILE;
}
// The gh commands a step runs, in order: the body always replaced (on a closed issue too, which
// notifies no one), the summary as the closing or reopening comment.
MsCmd :: struct { argv: [8] string; n: int; }
ms_cmd :: (out: [] MsCmd, at: int, a: [] string) -> int {
  if at >= out.count { return at; }
  for k: 0..<a.count { out[at].argv[k] = a[k]; }
  out[at].n = a.count;
  return at + 1;
}
ms_issue_cmds :: (step: MsStep, issue: string, bodyfile: string, summary: string, out: [] MsCmd) -> int {
  n := 0;
  edit := [6] string.["gh", "issue", "edit", issue, "--body-file", bodyfile];
  if step == MsStep.FILE { c := [7] string.["gh", "issue", "create", "--title", MS_TITLE, "--body-file", bodyfile]; n = ms_cmd(out, n, c[..]); }
  if step == MsStep.EDIT || step == MsStep.QUIET { n = ms_cmd(out, n, edit[..]); }
  if step == MsStep.CLOSE { n = ms_cmd(out, n, edit[..]); c := [6] string.["gh", "issue", "close", issue, "--comment", summary]; n = ms_cmd(out, n, c[..]); }
  if step == MsStep.REOPEN { c := [6] string.["gh", "issue", "reopen", issue, "--comment", summary]; n = ms_cmd(out, n, c[..]); n = ms_cmd(out, n, edit[..]); }
  return n;
}
// `gh issue list --json number,state` cut to "NUMBER STATE": the number and the state.
MsFound :: struct { number: string; state: string; }
ms_found :: (line: string) -> MsFound {
  f: MsFound; e := 0;
  while e < line.count && line[e] >= '0' && line[e] <= '9' { e += 1; }
  if e == 0 || e >= line.count || line[e] != ' ' { return f; }
  s := e + 1; t := s;
  while t < line.count && line[t] >= 'A' && line[t] <= 'Z' { t += 1; }
  f.number = cast(string) line[0..<e]; f.state = cast(string) line[s..<t];
  return f;
}
#test "a clean sweep closes the issue with its summary, a dirty one reopens or files it, and one issue is all there is" {
  #assert ms_issue_step(true, "OPEN") == MsStep.CLOSE && ms_issue_step(false, "OPEN") == MsStep.EDIT;
  #assert ms_issue_step(false, "CLOSED") == MsStep.REOPEN && ms_issue_step(true, "CLOSED") == MsStep.QUIET;
  #assert ms_issue_step(false, "") == MsStep.FILE && ms_issue_step(true, "") == MsStep.NONE;
  c: [4] MsCmd;
  n := ms_issue_cmds(MsStep.CLOSE, "13586", "/s/body.md", "clean at abc", c[..]);
  #assert n == 2 && c[0].n == 6 && c[0].argv[2] == "edit" && c[0].argv[3] == "13586" && c[0].argv[5] == "/s/body.md";
  #assert c[1].argv[2] == "close" && c[1].argv[3] == "13586" && c[1].argv[4] == "--comment" && c[1].argv[5] == "clean at abc";
  n = ms_issue_cmds(MsStep.REOPEN, "13586", "/s/body.md", "2 survivors", c[..]);
  #assert n == 2 && c[0].argv[2] == "reopen" && c[0].argv[5] == "2 survivors" && c[1].argv[2] == "edit";
  n = ms_issue_cmds(MsStep.FILE, "", "/s/body.md", "x", c[..]);
  #assert n == 1 && c[0].n == 7 && c[0].argv[2] == "create" && c[0].argv[4] == MS_TITLE;
  #assert ms_issue_cmds(MsStep.EDIT, "7", "b", "x", c[..]) == 1 && c[0].argv[2] == "edit";
  #assert ms_issue_cmds(MsStep.QUIET, "7", "b", "x", c[..]) == 1 && c[0].argv[2] == "edit";
  #assert ms_issue_cmds(MsStep.NONE, "7", "b", "x", c[..]) == 0;
  fresh: [2] MsCmd;
  #assert ms_issue_cmds(MsStep.EDIT, "7", "b", "x", fresh[..]) == 1 && fresh[0].argv[0] == "gh" && fresh[0].argv[1] == "issue";
  one: [1] MsCmd;
  #assert ms_issue_cmds(MsStep.CLOSE, "7", "b", "x", one[..]) == 1;
  f := ms_found("13586 CLOSED");
  #assert f.number == "13586" && f.state == "CLOSED" && ms_found("12 OPEN\n").state == "OPEN";
  #assert ms_found("").number == "" && ms_found("OPEN").number == "" && ms_found("12").number == "";
  // digits 0 to 9 then one space, capitals A to Z
  #assert ms_found("x5 OPEN").number == "" && ms_found("1090 OPEN").number == "1090" && ms_found("12: OPEN").number == "";
  #assert ms_found(" OPEN").state == "" && ms_found("7 OPEN").number == "7" && ms_found("3 ZAP").state == "ZAP" && ms_found("3 OPEN[").state == "OPEN";
}
// What a part that did not run says: stopped at the limit, its output cut, its files not all reported.
ms_why :: (status: int, got: int, want: int, cut: bool, minutes: int, out: [] u8) -> string {
  t: [1] MsText; t[0].bytes = out; nb: [32] u8;
  if status == 124 || status == 137 { ms_put(t[..], "stopped at the "); ms_put(t[..], ms_itoa(minutes, nb[..])); ms_put(t[..], "-minute limit (its native kills are kept for the next run)"); }
  else if cut { ms_put(t[..], "its output was longer than the sweep keeps"); }
  else if status != 0 && status != 1 { ms_put(t[..], "did not run: status "); ms_put(t[..], ms_itoa(status, nb[..])); }
  else { ms_put(t[..], "reported "); ms_put(t[..], ms_itoa(got, nb[..])); ms_put(t[..], " of its "); ms_put(t[..], ms_itoa(want, nb[..])); ms_put(t[..], " files"); }
  if !(status == 0 || status == 1) && got > 0 { ms_put(t[..], ", after "); ms_put(t[..], ms_itoa(got, nb[..])); ms_put(t[..], " of its "); ms_put(t[..], ms_itoa(want, nb[..])); ms_put(t[..], " files"); }
  return ms_text(t[..]);
}
#test "a part that did not run says why" {
  b: [256] u8;
  #assert ms_why(124, 0, 30, false, 180, b[..]) == "stopped at the 180-minute limit (its native kills are kept for the next run)";
  #assert ms_why(124, 2, 30, false, 60, b[..]) == "stopped at the 60-minute limit (its native kills are kept for the next run), after 2 of its 30 files";
  #assert ms_why(1, 0, 4, false, 180, b[..]) == "reported 0 of its 4 files" && ms_why(97, 0, 1, false, 180, b[..]) == "did not run: status 97";
  #assert ms_why(0, 3, 4, true, 180, b[..]) == "its output was longer than the sweep keeps";
  #assert ms_why(137, 0, 2, false, 30, b[..]) == "stopped at the 30-minute limit (its native kills are kept for the next run)";
  #assert ms_why(0, 3, 4, false, 180, b[..]) == "reported 3 of its 4 files" && ms_why(1, 2, 4, false, 180, b[..]) == "reported 2 of its 4 files";
  #assert ms_why(97, 1, 3, false, 180, b[..]) == "did not run: status 97, after 1 of its 3 files";
}

// Runs argv in dir to its end: stdout into out, and its length; -1 when it didn't start.
ms_run :: (argv: [] string, dir: string, out: [] u8, status: [] int) -> int {
  h := proc_new();
  status[0] = -1;
  if h < 0 { return -1; }
  ok := proc_cwd(h, dir);
  for a: argv { ok = ok && proc_arg(h, a); }
  if !ok || proc_start(h) != 0 { d := proc_release(h); return -1; }
  n := 0; line: [65536] u8;
  while true {
    m := proc_line(h, -1, line[..]);
    if m == PROC_EOF || m == PROC_ERROR { break; }
    if m < 0 { continue; }
    if n + m + 1 <= out.count { for k: 0..<m { out[n + k] = line[k]; } out[n + m] = '\n'; n += m + 1; }
  }
  status[0] = proc_wait(h, -1);
  d := proc_release(h);
  return n;
}
// path from root when it is under root (a part runs from the checkout's root on its host), else path.
ms_rel :: (root: string, path: string) -> string {
  if root.count == 0 || path.count <= root.count + 1 || !ms_starts(path, root) || path[root.count] != '/' { return path; }
  return cast(string) path[root.count + 1..<path.count];
}
// The state folder's .gitignore: what remote.sh leaves out of a part's snapshot.
MS_IGNORE :: "/.gitignore\n/parts/\n/report.md\n/issue-body.md\n/issue\n";
MS_KILLERS_README :: "Each part's killers file (coax mutate --killers), kept between nights: coax/web/mutation-sweep.coax.\n";
#test "a killers file goes to the host as a path in the checkout, and only it of the state" {
  #assert !ms_has(MS_IGNORE, "README") && ms_has(MS_KILLERS_README, "--killers");
  #assert ms_rel("/h/c", "/h/c/mutation-sweep/killers/a.tsv") == "mutation-sweep/killers/a.tsv";
  #assert ms_rel("/h/c", "/h/cc/k.tsv") == "/h/cc/k.tsv" && ms_rel("/h/c", "/elsewhere/k.tsv") == "/elsewhere/k.tsv" && ms_rel("/h/c", "/h/c") == "/h/c";
  #assert ms_rel("", "/x/y") == "/x/y" && ms_rel("/h/c", "/h/c/") == "/h/c/" && ms_rel("/h/c", "/h/c/x") == "x";
  #assert ms_has(MS_IGNORE, "/parts/") && ms_has(MS_IGNORE, "/report.md") && !ms_has(MS_IGNORE, "killers");
}
// STATE/SUB/SLUG.partK.EXT
ms_part_file :: (state: string, sub: string, suite: string, k: int, ext: string, out: [] u8) -> string {
  b: [4096] u8; n := 0; sb: [4096] u8; nb: [32] u8;
  for c: ms_slug(suite, sb[..]) { b[n] = c; n += 1; }
  for c: ".part" { b[n] = c; n += 1; }
  for c: ms_itoa(k, nb[..]) { b[n] = c; n += 1; }
  for c: ext { b[n] = c; n += 1; }
  db: [4096] u8;
  return fs_join(fs_join(state, sub, db[..]), cast(string) b[0..<n], out);
}
