 if ready && args_has(a[..],"--motion") {motion:=cdp_evaluate(c[..],"(async()=>{globalThis.ocChecks??=[];const p=i=>coaxial.guardProbe(i),key=(key,down=true)=>dispatchEvent(new KeyboardEvent(down?'keydown':'keyup',{key,bubbles:true}));key('r');await coaxialClipStep(1,30);key('w');let previous=p(29)/1e6,min=1,max=0,residual=0,wraps=0,lastCycle=0;for(let i=0;i<180;i++){await coaxialClipStep(1,30);const visible=p(29)/1e6,delta=visible-previous;previous=visible;min=Math.min(min,delta);max=Math.max(max,delta);residual=Math.max(residual,Math.abs(p(23)),Math.abs(p(24)));if(p(1)===2){const cycle=Math.floor(p(9)/30000/(p(28)/1e6));if(cycle>lastCycle)wraps++;lastCycle=cycle}else lastCycle=0}key('w',false);globalThis.ocMotion={minVisibleStep:min,maxVisibleStep:max,rootResidualMicrometres:residual,runWraps:wraps,sourceWalk:p(25)/1e6,sourceRun:p(26)/1e6};ocChecks.push({label:'run crosses multiple original loop boundaries',ok:wraps>=4},{label:'rendered pelvis has no backward chops',ok:min>-.08&&max<.2},{label:'carrier transport is applied exactly once',ok:residual===0},{label:'source walk and run speeds',ok:Math.abs(p(25)/1e6-.64)<.00001&&Math.abs(p(26)/1e6-2.25)<.00001});key('r');if(ocChecks.some(x=>!x.ok))throw Error(JSON.stringify(ocMotion));return true})()");if motion<0 {tool_errln(cdp_doc(c[..]).text);ready=false;}}
 if ready && args_has(a[..],"--foliage") {journey:=cdp_evaluate(c[..],"(async()=>{globalThis.ocChecks??=[];globalThis.ocFoliage={samples:[]};globalThis.ocFoliageImages=[];const p=i=>coaxial.guardProbe(i),key=(key,down=true)=>dispatchEvent(new KeyboardEvent(down?'keydown':'keyup',{key,bubbles:true})),step=n=>coaxialClipStep(n,60);key('r');for(let i=0;i<6;i++)key('ArrowUp');await step(2);const snap=async(label)=>{coaxial.captureFrame();await step(2);await new Promise(r=>setTimeout(r,250));const r=coaxial.renderCapture;if(!r||r.format!=='rgba8unorm')throw Error('foliage readback');const c=document.createElement('canvas');c.width=r.width;c.height=r.height;c.getContext('2d').putImageData(new ImageData(new Uint8ClampedArray(r.bytes),r.width,r.height),0,0);ocFoliageImages.push(c.toDataURL('image/png').split(',')[1]);ocFoliage.samples.push({label,x:p(6),y:p(32),z:p(7)})};await snap('start');key('a');for(let i=0;i<3;i++){await step(20);await snap('walk '+i)}key('a',false);for(let i=0;i<3;i++){for(let j=0;j<4;j++)key('ArrowLeft');await step(2);await snap('orbit '+i)}const a=ocFoliage.samples[0],b=ocFoliage.samples[3];ocChecks.push({label:'foliage walk-by exceeds one metre',ok:Math.hypot(b.x-a.x,b.z-a.z)>1000},{label:'seven foliage walk/orbit readbacks',ok:ocFoliageImages.length===7});if(ocChecks.some(x=>!x.ok))throw Error(JSON.stringify(ocFoliage));key('r');return true})()");if journey<0 {tool_errln(cdp_doc(c[..]).text);ready=false;}else {framepng:[8388608]u8;framepath:[4096]u8;foliage_name:=args_at(a[..],1);#assert foliage_name.count+6<=framepath.count;for leaf_byte,k:foliage_name {framepath[k]=leaf_byte;}for frame:0..<7 {script:=[7]string.["ocFoliageImages[0]","ocFoliageImages[1]","ocFoliageImages[2]","ocFoliageImages[3]","ocFoliageImages[4]","ocFoliageImages[5]","ocFoliageImages[6]"][frame];encoded_frame:=cdp_evaluate(c[..],script);#assert encoded_frame>=0;frame_size:=b64_decode(jv_raw(cdp_doc(c[..]),encoded_frame),framepng[..]);#assert frame_size>0;framepath[foliage_name.