 if ready && args_has(a[..],"--recover") {recovered:=cdp_evaluate(c[..],"(async()=>{globalThis.ocChecks??=[];globalThis.ocExpectedLoss=true;const before=await coaxial.stateDigest();const original=fetch;let requested=0;globalThis.fetch=(...a)=>{if(String(a[0]).includes('/private/')){requested++;throw Error('pack refetched after device loss')}return original(...a)};coaxial.loseDevice();const until=performance.now()+20000;while(performance.now()<until&&coaxial.gpuRecovery?.state!=='recovered'&&coaxial.gpuRecovery?.state!=='failed')await new Promise(r=>setTimeout(r,100));ocChecks.push({label:'recovered GPU',ok:coaxial.gpuRecovery?.state==='recovered'},{label:'retained source without network',ok:requested===0},{label:'identical source and player state',ok:before===await coaxial.stateDigest()});if(ocChecks.some(x=>!x.ok))throw Error(JSON.stringify({checks:ocChecks,recovery:coaxial.gpuRecovery}));return true})()");if recovered<0 {tool_errln(cdp_doc(c[..]).text);ready=false;}}
