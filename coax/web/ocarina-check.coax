 n:=cdp_evaluate(c[..],"JSON.stringify({ready:globalThis.coaxial?.ready,sceneReady:globalThis.coaxial?.sceneReady,text:document.body.innerText,errors:ocErrors,checks:globalThis.ocChecks||null,motion:globalThis.ocMotion||null,foliage:globalThis.ocFoliage||null,controller:globalThis.ocController||null,shaders:ocShader,capture:coaxial?.renderCapture?{format:coaxial.renderCapture.format,lit:coaxial.renderCapture.bytes.reduce((s,v)=>s+(v>0),0),length:coaxial.renderCapture.bytes.length}:null,probe:globalThis.coaxial?Array.from({length:30},(_,i)=>coaxial.guardProbe(i)):[]})");if n>=0 {print("%\n",jv_raw(c[0].doc[0],n));}else {print("eval failed %\n",cdp_error(c[..]));}
