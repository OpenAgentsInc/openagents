  #assert r == 1 && h[0].argv[12] == "coax/web/tool.sh suites --since B --check-affected ";
  #assert pp_has(pp_report(h[0].r[..]), "prepush: coax check FAILED (0 s):\n      FAIL coax check apps/openagents-desktop/app.coax\n      E0216\n");
  // a push with no Coax in it compiles nothing
