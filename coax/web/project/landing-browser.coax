// Public homepage watches. All event, signature, beacon and subscription
// decisions stay in Coax; the browser moves socket bytes only.
#load "landing-nostr.coax";
#load "landing-xp.coax";
#load "landing-cache.coax";
#load "../../lib/nostr/fixtures/nip42_events.coax";
#authority;
LbMessage :: struct {code:int;written:int;}
LbSeen :: struct {n:int;start:int;started:bool;ids:[LR_EVENTS*32]u8;}
#test "homepage watches are scoped and activity ids do not count twice" {
  keys:="[\"f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9\"]";
  out:[8192]u8;
  for mode:0..<6 {#assert lb_request(mode,keys,2000000000,out[..])>0;}
  #assert lb_request(1,"[]",0,out[..])<0;
  held:[1]LbSeen;id:[32]u8;
  #assert lb_begin(held[..],2,keys,2000000000,out[..])>0 && held[0].start==2000000000;
  #assert lb_once(held[..],id[..]) && !lb_once(held[..],id[..]);
  #assert lb_message(held[..],"[]",keys,0,out[..]).code==0;
  #assert lb_message(held[..],"[\"EOSE\",\"home-beacons\"]",keys,0,out[..]).code==3;
  #assert lb_message(held[..],"[\"CLOSED\",\"home-beacons\",\"restricted: no\"]",keys,0,out[..]).code== -3;
  #assert lb_message(held[..],"[\"EOSE\",\"home-xp\"]",keys,0,out[..]).code==5;
  #assert lb_message(held[..],"[\"CLOSED\",\"home-xp\",\"restricted: no\"]",keys,0,out[..]).code==0;
}
lb_once :: (s:[]LbSeen,id:[]u8)->bool {
  for k:0..<s[0].n {if lr_equal_id(s[0].ids[k*32..<k*32+32],id) {return false;}}
  if id.count!=32 || s[0].n>=LR_EVENTS {return false;}
  for i:0..<32 {s[0].ids[s[0].n*32+i]=id[i];}s[0].n+=1;return true;
}
lb_begin :: (s:[]LbSeen,mode:int,keys:string,now:int,out:[]u8)->int #export_c {
  n:=lb_request(mode,keys,now,out);if n>0 && mode==2 && !s[0].started {s[0].start=now;s[0].started=true;}return n;
}
lb_request :: (mode:int,keys:string,now:int,out:[]u8)->int #export_c {
  if mode>=3 && mode<=5 {return ifx now<0 || now>NF_SAFE then -1 else lx_request(mode-3,out);}
  if mode<0 || mode>2 || now<0 || now>NF_SAFE {return -1;}
  authors:[8]string;count:=lr_ids(keys,authors[..]);if count<1 {return -1;}
  f:NostrFilter;kinds:[9]int;values:=[1]string.[PB_MARKER];tags:=[1]NostrTagFilter.[NostrTagFilter.{name='t',values=values[..]}];
  f.has_kinds=true;f.has_since=true;f.since=ifx mode==0 then (ifx now>300 then now-300 else 0) else now;
  sub:="home-beacons";
  if mode==0 {kinds[0]=PB_KIND;f.kinds=kinds[0..<1];f.tags=tags[..];f.has_limit=true;f.limit=128;}
  if mode==1 {sub="home-projects";kinds=[9]int.[30617,30621,30623,1621,1111,1630,1631,1632,1633];f.kinds=kinds[..];f.has_authors=true;f.authors=authors[0..<count];}
  if mode==2 {sub="home-work";kinds[0]=26910;kinds[1]=27010;f.kinds=kinds[0..<2];}
  filters:=[1]NostrFilter.[f];return nostr_message_write_req(sub,filters[..],out,false);
}
lb_message :: (seen:[]LbSeen,text:string,keys:string,now:int,out:[]u8)->LbMessage #export_c {
  m:=nostr_message_read(text);if m.error!=NM_OK {return LbMessage.{};}
  sub:=nm_text(m,m.sub);
  if sub==LX_SUB || sub==LX_WORK_SUB || sub==LX_CHECK_SUB {
    // A refused XP watch never takes the Pylon and project watches down with it.
    if m.type==NM_EOSE {return LbMessage.{code=ifx sub==LX_SUB then 5 else ifx sub==LX_WORK_SUB then 6 else 7};}if m.type!=NM_EVENT {return LbMessage.{};}
    xe:=nm_text(m,m.event);xs:[NE_MAX_OUTPUT]u8;x:=lr_event(xe,xs[..]);
    if x.error!=NE_OK || !x.verified || now<0 || x.created_at>now+30 {return LbMessage.{code= -4};}
    w:=lx_record(x,out);return ifx w>0 then LbMessage.{code=4,written=w} else LbMessage.{};
  }
  if sub!="home-beacons" && sub!="home-projects" && sub!="home-work" {return LbMessage.{};}
  if m.type==NM_CLOSED {return LbMessage.{code= -3};}
  if m.type==NM_EOSE && sub=="home-beacons" {return LbMessage.{code=3};}
  if m.type!=NM_EVENT {return LbMessage.{};}
  original:=nm_text(m,m.event);scratch:[NE_MAX_OUTPUT]u8;e:=lr_event(original,scratch[..]);
  if e.error!=NE_OK || !e.verified || now<0 || e.created_at>now+30 {return LbMessage.{code= -4};}
  if sub=="home-beacons" {
    n:=lr_beacon(original,now,out);return ifx n>0 then LbMessage.{code=1,written=n} else LbMessage.{code= -4};
  }
  if sub=="home-projects" {
    if e.kind!=30617 && e.kind!=30621 && e.kind!=30623 && e.kind!=1621 && e.kind!=1111 && (e.kind<1630 || e.kind>1633) {return LbMessage.{};}
    authors:[8]string;count:=lr_ids(keys,authors[..]);
    for i:0..<count {if lr_public_key(e,authors[i]) {return LbMessage.{code=10+i};}}
    return LbMessage.{};
  }
  if (e.kind!=26910 && e.kind!=27010) || !seen[0].started || e.created_at<seen[0].start || e.created_at>now || !lb_once(seen,e.id[..]) {return LbMessage.{};}
  key:[64]u8;hex:="0123456789abcdef";for i:0..<32 {key[2*i]=hex[e.public_key[i]>>4];key[2*i+1]=hex[e.public_key[i]&15];}
  n:=json_raw(out,0,"{\"provider\":");n=json_write_string(out,n,cast(string)key[..]);n=json_raw(out,n,",\"kind\":");n=json_write_int(out,n,e.kind);
  n=json_raw(out,n,",\"at\":");n=json_write_int(out,n,e.created_at);n=json_raw(out,n,"}");return LbMessage.{code=2,written=n};
}
#test "the page's catch-up never checks a kept event again and keeps its own copy" {
  q:[1]LrQuery;c:[1]HcCache;r:[1]HcRoom;hc_test(c[..],r[..]);out:[8192]u8;
  #assert lr_begin(q[..],"{\"kinds\":[22242]}") && lr_request(q[..],out[..])>0;
  scratch:[4096]u8;e:=nostr_event_read(N42_FX_SPEC,scratch[..],false);#assert e.error==NE_OK;
  id:=e.id;#assert hc_append(c[..],3,id[..],e.created_at,e.kind,0,N42_FX_SPEC)==1;
  frame:[4096]u8;n:=json_raw(frame[..],0,"[\"EVENT\",\"land-1\",");n=json_raw(frame[..],n,N42_FX_SPEC);n=json_raw(frame[..],n,"]");
  bad:=frame;bad[n-4]='1';#assert lb_frame(q[..],c[..],3,cast(string)bad[0..<n])==0 && c[0].n==1 && q[0].count==1 && hc_json(c[..],0)==N42_FX_SPEC;
  odd:=frame;odd[60]='f';#assert lb_frame(q[..],c[..],3,cast(string)odd[0..<n])== -4;
  #assert hc_entry("{}",1,out[..])== -1;
}
// lr_frame for the page's catch-up, into its cache: an event already there
// was admitted before (the same id is the same bytes, hashed here again), so
// its signature isn't checked twice and its copy here stays the one kept.
// 0 ignored or known, 1 a new admitted event kept, 2 page ended; negative
// refuses, as lr_frame.
lb_frame :: (s:[]LrQuery,c:[]HcCache,k:int,text:string)->int #export_c {
  if s[0].state!=2 {return -1;}
  m:=nostr_message_read(text);
  if m.error!=NM_OK {return ifx lr_auth(text) then 0 else -2;}
  if m.type==NM_NOTICE {return 0;}
  sub:[64]u8;n:=lr_sub(s,sub[..]);
  if !json_is(nm_text(m,m.sub),cast(string)sub[0..<n]) {return 0;}
  if m.type==NM_CLOSED {s[0].state= -1;return -3;}
  if m.type==NM_EOSE {
    if s[0].count>s[0].peak {s[0].peak=s[0].count;}
    until:=lr_page_end(s[0].until,s[0].oldest,s[0].count,lr_finish(text),s[0].pages,s[0].peak);
    if until== -2 {s[0].state= -1;return -5;}
    s[0].until=until;s[0].state=ifx until== -1 then 3 else 1;return 2;
  }
  if m.type!=NM_EVENT {return 0;}
  original:=nm_text(m,m.event);scratch:[NE_MAX_OUTPUT]u8;e:=nostr_event_read(original,scratch[..],false);
  if e.error!=NE_OK {s[0].state= -1;return -4;}
  known:=hc_find(c,e.id[..])>=0;
  if !known {if !nostr_fast_verify_vartime(e.id[..],e.public_key[..],e.signature[..]) {s[0].state= -1;return -4;}e.verified=true;}
  strs:[1024]string;ints:[1024]int;tags:[64]NostrTagFilter;bytes:[8192]u8;
  sp:=[1]FrSpace.[FrSpace.{strs=strs[..],ints=ints[..],tags=tags[..],bytes=bytes[..]}];f:[1]NostrFilter;
  if !lr_parse_filter(cast(string)s[0].filter[0..<s[0].filter_n],f[..],sp[..]) || !nf_match(f[0],e) || (s[0].until>=0 && e.created_at>s[0].until) {return -6;}
  s[0].count+=1;if s[0].oldest<0 || e.created_at<s[0].oldest {s[0].oldest=e.created_at;}
  if known {return 0;}
  r:=hc_add(c,k,e);if r<0 {s[0].state= -1;return -7;}return r;
}
