// The homepage's admitted project events, each once, by id. An entry is
// written only after Coax admitted its event: its id hashed from its own
// bytes and its BIP-340 signature verified, here or by the build's capture
// (the same verifier). The text form is what the page keeps in IndexedDB and
// what the build ships as its seed, so a repeat visit, or a first one, asks
// the relay only for what is newer and checks no signature twice.
//
//   E<k> <id> <created_at> <kind> <d> <length>\n<the event's original JSON>\n
//   S<k> <synced>\n     project k's entries are complete through synced
//   H <chunks>\n        a head record: how many chunk records follow
//
// A field is fixed width (zero padded), so a header is HC_HEAD bytes.
HC_EVENTS :: 16384;
HC_BYTES :: 12582912;
HC_TABLE :: 32768;
HC_CHUNK :: 1000000;
HC_HEAD :: 102;
HC_PROJECTS :: 8;
HC_PROJ :: 196608;       // the page's room for a project's fold as it draws it (landing-fold.coax lf_result)
HC_PROJ_HEAD :: 33;
HC_KEY_MOD :: 999999999989;

#test "an entry's text round-trips through absorb, once, and a newer replaceable replaces the older" {
  c:[1]HcCache;r:[1]HcRoom;hc_test(c[..],r[..]);
  id:[32]u8;id[0]=1;id[31]=9;out:[512]u8;
  n:=hc_write(out[..],0,2,id[..],1793374251,1621,0,"{\"a\":1}");
  #assert n==HC_HEAD+8 && cast(string)out[0..<2]=="E2" && out[HC_HEAD-1]==10;
  #assert hc_absorb(c[..],cast(string)out[0..<n])==1 && c[0].n==1 && hc_find(c[..],id[..])==0;
  #assert hc_absorb(c[..],cast(string)out[0..<n])==0 && c[0].n==1;
  #assert cast(string)hc_json(c[..],0)=="{\"a\":1}" && hc_newest(c[..],2)==1793374251;
  id[0]=2;n=hc_write(out[..],0,2,id[..],100,30623,77,"{}");#assert hc_absorb(c[..],cast(string)out[0..<n])==1;
  id[0]=3;n=hc_write(out[..],0,2,id[..],200,30623,77,"{}");#assert hc_absorb(c[..],cast(string)out[0..<n])==1;
  #assert c[0].dead[1] && !c[0].dead[2] && c[0].live==2;
  id[0]=4;n=hc_write(out[..],0,2,id[..],150,30623,77,"{}");#assert hc_absorb(c[..],cast(string)out[0..<n])==0 && c[0].n==3;
  #assert hc_absorb(c[..],"S2 0000000300\nH 0000003\n")==0 && c[0].pending[2]==300 && c[0].head_chunks==3;
  #assert hc_absorb(c[..],"E9 bad\n")<0;
}
#test "chunks pack live entries in order, and dropping a project keeps the rest findable" {
  c:[1]HcCache;r:[1]HcRoom;hc_test(c[..],r[..]);id:[32]u8;out:[512]u8;
  for i:0..<3 {id[0]=cast(u8)(i+1);n:=hc_write(out[..],0,i%2,id[..],10+i,1111,0,"{}");#assert hc_absorb(c[..],cast(string)out[0..<n])==1;}
  #assert hc_chunks(c[..])==1 && hc_chunk_of(c[..],2)==0;
  packed:[2048]u8;#assert hc_pack(c[..],0,packed[..])==3*(HC_HEAD+3) && hc_pack(c[..],1,packed[..])==0;
  c[0].snap[1]=12;h:=hc_head(c[..],1,packed[..]);#assert cast(string)packed[0..<h]=="H 0000001\nS1 0000000012\n";
  hc_compact(c[..],0);#assert c[0].rewrite && c[0].gen==1 && c[0].n==1 && c[0].project[0]==1 && hc_find(c[..],id[..])<0;
  id[0]=2;#assert hc_find(c[..],id[..])==0 && hc_next(c[..],1,0)==0 && hc_next(c[..],0,0)== -1;
}
// Views over storage its owner holds (the page's C face: HC_EVENTS entries,
// HC_BYTES of text, an HC_TABLE index, a power of two); a test's are small.
HcCache :: struct {
  n:int; used:int; live:int; dirty:bool; dirty_from:int; head_chunks:int; skipped:int; gen:int; rewrite:bool; from_store:bool;
  from:[]int; size:[]int; project:[]int; at:[]int; kind:[]int; dkey:[]int; dead:[]bool;
  id:[]u8; slot:[]int; bytes:[]u8;
  synced:[HC_PROJECTS]int; pending:[HC_PROJECTS]int; snap:[HC_PROJECTS]int;
  seeding:bool; foreign:[HC_PROJECTS]int;
  proj:[]u8; proj_n:[HC_PROJECTS]int; proj_count:[HC_PROJECTS]int; proj_key:[HC_PROJECTS]int;
}
HcRoom :: struct {proj:[4096]u8;from:[64]int;size:[64]int;project:[64]int;at:[64]int;kind:[64]int;dkey:[64]int;dead:[64]bool;id:[64*32]u8;slot:[128]int;bytes:[16384]u8;}
hc_test :: (c:[]HcCache,r:[]HcRoom) {
  c[0].from=r[0].from[..];c[0].size=r[0].size[..];c[0].project=r[0].project[..];c[0].at=r[0].at[..];c[0].kind=r[0].kind[..];c[0].dkey=r[0].dkey[..];
  c[0].dead=r[0].dead[..];c[0].id=r[0].id[..];c[0].slot=r[0].slot[..];c[0].bytes=r[0].bytes[..];c[0].proj=r[0].proj[..];
}
hc_hash :: (c:[]HcCache,id:[]u8)->int {return (cast(int)id[0]*256+cast(int)id[1]+cast(int)id[2]*65536)&(c[0].slot.count-1);}
hc_same :: (c:[]HcCache,i:int,id:[]u8)->bool {for b:0..<32 {if c[0].id[i*32+b]!=id[b] {return false;}}return true;}
hc_find :: (c:[]HcCache,id:[]u8)->int #export_c {
  if id.count!=32 || c[0].slot.count<2 {return -1;}h:=hc_hash(c,id);mask:=c[0].slot.count-1;
  for probe:0..<c[0].slot.count {v:=c[0].slot[(h+probe)&mask];if v==0 {return -1;}if hc_same(c,v-1,id) {return v-1;}}
  return -1;
}
hc_index :: (c:[]HcCache,i:int) {
  h:=hc_hash(c,c[0].id[i*32..<i*32+32]);mask:=c[0].slot.count-1;
  for probe:0..<c[0].slot.count {at:=(h+probe)&mask;if c[0].slot[at]==0 {c[0].slot[at]=i+1;return;}}
}
hc_touch :: (c:[]HcCache,i:int) {if !c[0].dirty || i<c[0].dirty_from {c[0].dirty_from=i;}c[0].dirty=true;}
// The d tag's value as a nonzero number, for a replaceable kind; 0 otherwise.
hc_dkey :: (e:NostrEvent)->int {
  if e.kind<30000 || e.kind>39999 {return 0;}
  d:=pt_tag(e.original[e.tags_from..<e.tags_to],"d");value:=ifx d.ok && d.count>=1 && d.size>=2 then d.v[1] else "";
  h:=7;for ch:value {h=(h*31+cast(int)ch)%99999989;}return h+1;
}
hc_digits :: (out:[]u8,at:int,value:int,width:int,base:int)->int {
  if at<0 || at+width>out.count || value<0 {return -1;}v:=value;hex:="0123456789abcdef";
  i:=width-1;while i>=0 {out[at+i]=hex[v%base];v=v/base;i-=1;}
  return ifx v==0 then at+width else -1;
}
hc_write :: (out:[]u8,at:int,k:int,id:[]u8,created:int,kind:int,dkey:int,json:string)->int {
  if k<0 || k>9 || id.count!=32 || at<0 || at+HC_HEAD+json.count+1>out.count {return -1;}
  hex:="0123456789abcdef";n:=at;out[n]='E';out[n+1]=cast(u8)(48+k);out[n+2]=' ';n+=3;
  for b:0..<32 {out[n+2*b]=hex[id[b]>>4];out[n+2*b+1]=hex[id[b]&15];}n+=64;out[n]=' ';
  n=hc_digits(out,n+1,created,10,10);if n<0 {return -1;}out[n]=' ';
  n=hc_digits(out,n+1,kind,5,10);if n<0 {return -1;}out[n]=' ';
  n=hc_digits(out,n+1,dkey,8,16);if n<0 {return -1;}out[n]=' ';
  n=hc_digits(out,n+1,json.count,7,10);if n<0 {return -1;}out[n]=10;n+=1;
  for i:0..<json.count {out[n+i]=json[i];}n+=json.count;out[n]=10;return n+1;
}
// The build's writer: an event Coax admits here, as one entry. -1 refused.
hc_entry :: (text:string,k:int,out:[]u8)->int #export_c {
  scratch:[NE_MAX_OUTPUT]u8;e:=lr_event(text,scratch[..]);if e.error!=NE_OK || !e.verified {return -1;}
  return hc_write(out,0,k,e.id[..],e.created_at,e.kind,hc_dkey(e),text);
}
hc_number :: (text:string,at:int,width:int,base:int)->int {
  v:=0;for i:at..<at+width {c:=text[i];d:=ifx c>='0' && c<='9' then cast(int)c-48 else ifx base==16 && c>='a' && c<='f' then cast(int)c-87 else -1;if d<0 {return -1;}v=v*base+d;}return v;
}
// An entry at the end of the cache; a replaceable kind keeps its newest. 1
// kept, 0 already here or older than the one here, -1 no room.
hc_append :: (c:[]HcCache,k:int,id:[]u8,created:int,kind:int,dkey:int,json:string)->int {
  if hc_find(c,id)>=0 {return 0;}
  if dkey!=0 {for i:0..<c[0].n {if !c[0].dead[i] && c[0].project[i]==k && c[0].kind[i]==kind && c[0].dkey[i]==dkey {
    if c[0].at[i]>=created {return 0;}c[0].dead[i]=true;c[0].live-=1;hc_touch(c,i);if !c[0].seeding {c[0].foreign[k]+=1;}}}}
  if c[0].n>=c[0].from.count || c[0].n>=c[0].slot.count/2 || c[0].used+HC_HEAD+json.count+1>c[0].bytes.count {return -1;}
  i:=c[0].n;n:=hc_write(c[0].bytes[..],c[0].used,k,id,created,kind,dkey,json);if n<0 {return -1;}
  c[0].from[i]=c[0].used;c[0].size[i]=n-c[0].used;c[0].project[i]=k;c[0].at[i]=created;c[0].kind[i]=kind;c[0].dkey[i]=dkey;c[0].dead[i]=false;
  for b:0..<32 {c[0].id[i*32+b]=id[b];}hc_index(c,i);c[0].n+=1;c[0].live+=1;c[0].used=n;hc_touch(c,i);if !c[0].seeding {c[0].foreign[k]+=1;}return 1;
}
// An event Coax admitted in this page (lb_frame), from its original bytes.
hc_add :: (c:[]HcCache,k:int,e:NostrEvent)->int {
  if e.error!=NE_OK || !e.verified || k<0 || k>=HC_PROJECTS {return -1;}
  id:=e.id;return hc_append(c,k,id[..],e.created_at,e.kind,hc_dkey(e),e.original);
}
// Entries, synced lines and a head line from the page's storage or the
// build's seed, all written by hc_write and hc_head. Returns entries kept, or
// -1 at the first malformed line (what came before it stays).
hc_absorb :: (c:[]HcCache,text:string)->int #export_c {return hc_read(c,text,false);}
hc_read :: (c:[]HcCache,text:string,seed:bool)->int #export_c {
  c[0].seeding=seed;r:=hc_lines(c,text);c[0].seeding=false;return r;
}
hc_lines :: (c:[]HcCache,text:string)->int {
  at:=0;kept:=0;
  while at<text.count {
    if text[at]=='S' {if at+14>text.count || text[at+13]!=10 || text[at+2]!=' ' {return -1;}k:=cast(int)text[at+1]-48;t:=hc_number(text,at+3,10,10);
      if k<0 || k>=HC_PROJECTS || t<0 {return -1;}if t>c[0].pending[k] {c[0].pending[k]=t;}at+=14;continue;}
    if text[at]=='H' {if at+10>text.count || text[at+9]!=10 {return -1;}v:=hc_number(text,at+2,7,10);if v<0 {return -1;}c[0].head_chunks=v;c[0].from_store=c[0].n==0;at+=10;continue;}
    if text[at]=='P' {
      if at+HC_PROJ_HEAD>text.count || text[at+HC_PROJ_HEAD-1]!=10 {return -1;}k:=cast(int)text[at+1]-48;count:=hc_number(text,at+3,7,10);key:=hc_number(text,at+11,13,10);size:=hc_number(text,at+25,7,10);
      if k<0 || k>=HC_PROJECTS || count<0 || key<0 || size<0 || at+HC_PROJ_HEAD+size+1>text.count || text[at+HC_PROJ_HEAD+size]!=10 {return -1;}
      hc_set_projection(c,k,text[at+HC_PROJ_HEAD..<at+HC_PROJ_HEAD+size],count,key);at+=HC_PROJ_HEAD+size+1;continue;
    }
    if text[at]!='E' || at+HC_HEAD>text.count || text[at+HC_HEAD-1]!=10 {return -1;}
    k:=cast(int)text[at+1]-48;id:[32]u8;
    for b:0..<32 {hi:=hc_number(text,at+3+2*b,1,16);lo:=hc_number(text,at+4+2*b,1,16);if hi<0 || lo<0 {return -1;}id[b]=cast(u8)(hi*16+lo);}
    created:=hc_number(text,at+68,10,10);kind:=hc_number(text,at+79,5,10);dkey:=hc_number(text,at+85,8,16);size:=hc_number(text,at+94,7,10);
    if k<0 || k>=HC_PROJECTS || created<0 || kind<0 || dkey<0 || size<2 || at+HC_HEAD+size+1>text.count || text[at+HC_HEAD+size]!=10 {return -1;}
    r:=hc_append(c,k,id[..],created,kind,dkey,text[at+HC_HEAD..<at+HC_HEAD+size]);if r<0 {return -1;}kept+=r;if r==0 {c[0].skipped+=1;}at+=HC_HEAD+size+1;
  }
  return kept;
}
hc_json :: (c:[]HcCache,i:int)->string #export_c {return ifx i>=0 && i<c[0].n then cast(string)c[0].bytes[c[0].from[i]+HC_HEAD..<c[0].from[i]+c[0].size[i]-1] else "";}
hc_next :: (c:[]HcCache,k:int,i:int)->int #export_c {for e:hi_cache(i,0)..<c[0].n {if !c[0].dead[e] && c[0].project[e]==k {return e;}}return -1;}
hi_cache :: (a:int,b:int)->int {return ifx a>b then a else b;}
hc_newest :: (c:[]HcCache,k:int)->int #export_c {t:=0;for e:0..<c[0].n {if !c[0].dead[e] && c[0].project[e]==k && c[0].at[e]>t {t=c[0].at[e];}}return t;}
// The issue ids of project k's entries, 50 from offset, for the follow-up
// queries; 0 when there are no more.
hc_issue_ids :: (c:[]HcCache,k:int,offset:int,out:[]u8)->int #export_c {
  n:=json_raw(out,0,"[");count:=0;seen:=0;hex:="0123456789abcdef";
  for e:0..<c[0].n {
    if c[0].dead[e] || c[0].project[e]!=k || c[0].kind[e]!=1621 {continue;}
    if seen<offset {seen+=1;continue;}if count==50 {break;}
    id:[64]u8;for b:0..<32 {id[2*b]=hex[c[0].id[e*32+b]>>4];id[2*b+1]=hex[c[0].id[e*32+b]&15];}
    if count>0 {n=json_raw(out,n,",");}n=json_write_string(out,n,cast(string)id[..]);count+=1;
  }
  return ifx count==0 then 0 else json_raw(out,n,"]");
}
// Of the 64-hex ids a line each in known, from the offset-th for 50, the ones
// not here, as a JSON array; 0 when all of them are.
hc_missing :: (c:[]HcCache,known:string,offset:int,out:[]u8)->int #export_c {
  n:=json_raw(out,0,"[");count:=0;
  for i:offset..<offset+50 {
    at:=i*65;if at+64>known.count {break;}text:=known[at..<at+64];id:[32]u8;ok:=true;
    for b:0..<32 {hi:=hc_number(text,2*b,1,16);lo:=hc_number(text,2*b+1,1,16);if hi<0 || lo<0 {ok=false;break;}id[b]=cast(u8)(hi*16+lo);}
    if !ok || hc_find(c,id[..])>=0 {continue;}
    if count>0 {n=json_raw(out,n,",");}n=json_write_string(out,n,text);count+=1;
  }
  return ifx count==0 then 0 else json_raw(out,n,"]");
}
// Chunk records: every entry in order (a replaced one too: reading it back
// replaces it again), a chunk at most HC_CHUNK bytes. Entries only append, so
// a full chunk never changes until hc_compact rewrites them all.
hc_chunk_of :: (c:[]HcCache,entry:int)->int #export_c {
  chunk:=0;size:=0;
  for e:0..<c[0].n {if size>0 && size+c[0].size[e]>HC_CHUNK {chunk+=1;size=0;}if e>=entry {return chunk;}size+=c[0].size[e];}
  return chunk;
}
hc_chunks :: (c:[]HcCache)->int #export_c {return ifx c[0].n==0 then 0 else hc_chunk_of(c,c[0].n-1)+1;}
hc_pack :: (c:[]HcCache,chunk:int,out:[]u8)->int #export_c {
  at:=0;size:=0;n:=0;
  for e:0..<c[0].n {
    if size>0 && size+c[0].size[e]>HC_CHUNK {at+=1;size=0;}size+=c[0].size[e];
    if at<chunk {continue;}if at>chunk {break;}
    if n+c[0].size[e]>out.count {return -1;}for i:0..<c[0].size[e] {out[n+i]=c[0].bytes[c[0].from[e]+i];}n+=c[0].size[e];
  }
  return n;
}
hc_head :: (c:[]HcCache,chunks:int,out:[]u8)->int #export_c {
  n:=hc_head_lines(c,chunks,out);if n<0 || chunks==0 {return n;}
  for k:0..<HC_PROJECTS {m:=c[0].proj_n[k];if m<=0 || c[0].snap[k]<=0 || n+HC_PROJ_HEAD+m+1>out.count || n+HC_PROJ_HEAD+m+1>HC_CHUNK {continue;}
    out[n]='P';out[n+1]=cast(u8)(48+k);out[n+2]=' ';z:=hc_digits(out,n+3,c[0].proj_count[k],7,10);out[z]=' ';z=hc_digits(out,z+1,c[0].proj_key[k],13,10);out[z]=' ';z=hc_digits(out,z+1,m,7,10);out[z]=10;z+=1;
    w:=c[0].proj.count/HC_PROJECTS;for i:0..<m {out[z+i]=c[0].proj[k*w+i];}z+=m;out[z]=10;n=z+1;}
  return n;
}
hc_head_lines :: (c:[]HcCache,chunks:int,out:[]u8)->int {
  n:=json_raw(out,0,"H ");n=hc_digits(out,n,chunks,7,10);if n<0 || n>=out.count {return -1;}out[n]=10;n+=1;
  for k:0..<HC_PROJECTS {if c[0].snap[k]<=0 || chunks==0 {continue;}if n+14>out.count {return -1;}out[n]='S';out[n+1]=cast(u8)(48+k);out[n+2]=' ';n=hc_digits(out,n+3,c[0].snap[k],10,10);if n<0 {return -1;}out[n]=10;n+=1;}
  return n;
}
// Keep the live entries (and, when drop names one, not that project's), in
// order, packed to the front, with a fresh index.
hc_compact :: (c:[]HcCache,drop:int) #export_c {
  n:=0;used:=0;
  for i:0..<c[0].slot.count {c[0].slot[i]=0;}
  for e:0..<c[0].n {
    if c[0].dead[e] || c[0].project[e]==drop {continue;}
    from:=c[0].from[e];size:=c[0].size[e];for i:0..<size {c[0].bytes[used+i]=c[0].bytes[from+i];}
    c[0].from[n]=used;c[0].size[n]=size;c[0].project[n]=c[0].project[e];c[0].at[n]=c[0].at[e];c[0].kind[n]=c[0].kind[e];c[0].dkey[n]=c[0].dkey[e];c[0].dead[n]=false;
    for b:0..<32 {c[0].id[n*32+b]=c[0].id[e*32+b];}hc_index(c,n);used+=size;n+=1;
  }
  c[0].n=n;c[0].live=n;c[0].used=used;c[0].dirty=true;c[0].dirty_from=0;c[0].gen+=1;c[0].rewrite=true;
  if drop>=0 && drop<HC_PROJECTS {c[0].synced[drop]=0;c[0].pending[drop]=0;c[0].foreign[drop]=1;}
}
// A whole source (every seed part, or a head and every chunk) arrived: what
// it says is complete becomes complete here.
// Read back whole from storage, with nothing dropped, the records already
// say what is here: nothing to write until something changes.
hc_commit :: (c:[]HcCache,keep:bool) #export_c {
  for k:0..<HC_PROJECTS {if keep && c[0].pending[k]>c[0].synced[k] {c[0].synced[k]=c[0].pending[k];}c[0].pending[k]=0;}
  if keep && c[0].skipped==0 && !c[0].rewrite && c[0].from_store {c[0].dirty=false;}c[0].skipped=0;c[0].from_store=false;
}
hc_settle :: (c:[]HcCache,k:int) #export_c {if k>=0 && k<HC_PROJECTS {t:=hc_newest(c,k);c[0].synced[k]=ifx t>0 then t else 1;if !c[0].dirty {c[0].dirty_from=c[0].n;}c[0].dirty=true;}}
// A save's start: what it will say is complete is what is complete now; the
// first chunk to write (0 after hc_compact), or -1 when nothing changed.
hc_persist_begin :: (c:[]HcCache)->int #export_c {
  if !c[0].dirty {return -1;}for k:0..<HC_PROJECTS {c[0].snap[k]=c[0].synced[k];}c[0].dirty=false;
  return ifx c[0].rewrite then 0 else hc_chunk_of(c,c[0].dirty_from);
}
// What a project's fold was made from: its live entries' count and a sum of
// their ids, so a kept fold is drawn again only for exactly those events.
hc_count :: (c:[]HcCache,k:int)->int {n:=0;for e:0..<c[0].n {if !c[0].dead[e] && c[0].project[e]==k {n+=1;}}return n;}
hc_key :: (c:[]HcCache,k:int)->int {
  key:=0;for e:0..<c[0].n {if c[0].dead[e] || c[0].project[e]!=k {continue;}v:=0;for b:0..<5 {v=v*256+cast(int)c[0].id[e*32+b];}key=(key+v)%HC_KEY_MOD;}return key;
}
hc_set_projection :: (c:[]HcCache,k:int,text:string,count:int,key:int) {
  w:=c[0].proj.count/HC_PROJECTS;if k<0 || k>=HC_PROJECTS {return;}
  if text.count>w {c[0].proj_n[k]=0;return;}for i:0..<text.count {c[0].proj[k*w+i]=text[i];}c[0].proj_n[k]=text.count;c[0].proj_count[k]=count;c[0].proj_key[k]=key;
}
// A fold just made from what project k holds now.
hc_keep_projection :: (c:[]HcCache,k:int,text:string) #export_c {hc_set_projection(c,k,text,hc_count(c,k),hc_key(c,k));if !c[0].dirty {c[0].dirty_from=c[0].n;}c[0].dirty=true;}
// The kept fold of project k when it was made from exactly what k holds; "" otherwise.
hc_projection :: (c:[]HcCache,k:int)->string #export_c {
  if k<0 || k>=HC_PROJECTS || c[0].proj_n[k]<=0 || c[0].synced[k]<=0 || c[0].proj_count[k]!=hc_count(c,k) || c[0].proj_key[k]!=hc_key(c,k) {return "";}
  w:=c[0].proj.count/HC_PROJECTS;return cast(string)c[0].proj[k*w..<k*w+c[0].proj_n[k]];
}
#test "a kept fold is offered only for exactly the events it was made from" {
  c:[1]HcCache;r:[1]HcRoom;hc_test(c[..],r[..]);id:[32]u8;out:[512]u8;
  for i:0..<2 {id[0]=cast(u8)(i+1);n:=hc_write(out[..],0,0,id[..],10+i,1111,0,"{}");#assert hc_absorb(c[..],cast(string)out[0..<n])==1;}
  c[0].synced[0]=11;hc_keep_projection(c[..],0,"{\"issues\":[]}");#assert hc_projection(c[..],0)=="{\"issues\":[]}";
  id[0]=9;n:=hc_write(out[..],0,0,id[..],12,1111,0,"{}");#assert hc_absorb(c[..],cast(string)out[0..<n])==1 && hc_projection(c[..],0)=="";
  c[0].snap[0]=12;hc_keep_projection(c[..],0,"{}");head:[1024]u8;h:=hc_head(c[..],1,head[..]);
  d:[1]HcCache;q:[1]HcRoom;hc_test(d[..],q[..]);#assert h>0 && hc_absorb(d[..],cast(string)head[0..<h])==0 && d[0].proj_n[0]==2 && d[0].proj_count[0]==3;
}
