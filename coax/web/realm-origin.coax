// The realm origin's rules (GitHub #13432; docs/metaverse/realm-origin.md): a realm that runs someone
// else's code is served from an origin of its own, and every document that origin serves is
// sandboxed by its own response, so it has no origin: no cookies, no storage, nothing of the site's.
//
// The dev server (serve.c, --realm-host HOST:PORT) answers a request whose Host is the realm's by
// these rules; the load balancer holds the same ones for the deployed site (coax/web/api/lb.sh).
//   realm_origin_serves   which addresses the realm origin answers: a realm's page and what a page
//                         loads (its module, shaders, packs, the host script). Never the API, a login,
//                         the chat, a settings page or the live-reload channel
//   realm_origin_headers  the headers every answer from it carries
//   coax/bin/coax test coax/web/realm-origin.coax --library
//   coax/bin/coax mutate coax/web/realm-origin.coax --library
#authority;

// Under one of these, or one of them itself, and nothing else.
REALM_ORIGIN_ROOTS :: [4] string.["/worlds", "/realms", "/build", "/coaxial"];
// Sent with every answer:
//   Content-Security-Policy: sandbox ...    the document gets no origin, however it is opened: in the
//                                           site's frame or in a tab of its own. Scripts, the pointer
//                                           lock and fullscreen are what a game needs; no forms, no
//                                           popups, no top navigation, and never allow-same-origin
//   Cross-Origin-Resource-Policy            the site's page (COEP: require-corp) may hold the frame
//   Access-Control-Allow-Origin: *          a page with no origin fetches its own module and packs
//                                           without credentials; nothing here is private
//   Referrer-Policy                         the realm's address is not handed on
REALM_ORIGIN_HEADERS :: "Content-Security-Policy: sandbox allow-scripts allow-pointer-lock allow-orientation-lock\r\nCross-Origin-Resource-Policy: cross-origin\r\nAccess-Control-Allow-Origin: *\r\nReferrer-Policy: no-referrer\r\n";

realm_origin_under :: (path: string, root: string) -> bool #effects(reads, traps) {
  if path.count < root.count { return false; }
  for i: 0..<root.count { if path[i] != root[i] { return false; } }
  return path.count == root.count || path[root.count] == '/';
}
// Whether the realm origin answers this address (the path, with or without its query).
realm_origin_serves :: (url: string) -> bool #export_c #effects(reads, traps) {
  end := 0;
  while end < url.count && url[end] != '?' && url[end] != '#' { end += 1; }
  path := url[0..<end];
  // the dev server's live-reload channel is the site's, not a realm's
  if realm_origin_under(path, "/coaxial/live") { return false; }
  for root: REALM_ORIGIN_ROOTS { if realm_origin_under(path, root) { return true; } }
  // a page's shader as the dev server names it, /APP.wgsl (a deploy puts it under /build), and the site's icon
  return realm_origin_shader(path) || path == "/favicon.svg";
}
// "/NAME.wgsl": at the root, a name of lowercase letters, digits and dashes.
realm_origin_shader :: (path: string) -> bool #effects(reads, traps) {
  tail := ".wgsl";
  if path.count < tail.count + 2 || path[0] != '/' || path[path.count - tail.count..<path.count] != tail { return false; }
  for i: 1..<path.count - tail.count {
    c := path[i];
    if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') { return false; }
  }
  return true;
}
realm_origin_headers :: () -> string #export_c #effects() { return REALM_ORIGIN_HEADERS; }
// Whether a request's Host names the realm origin: the same bytes, letters compared without case.
realm_origin_host :: (host: string, realm: string) -> bool #export_c #effects(reads, traps) {
  if realm.count == 0 || host.count != realm.count { return false; }
  for i: 0..<host.count {
    a := host[i]; b := realm[i];
    if a >= 'A' && a <= 'Z' { a = a + 32; }
    if b >= 'A' && b <= 'Z' { b = b + 32; }
    if a != b { return false; }
  }
  return true;
}

#test "the realm origin answers a realm's page and what it loads, and nothing of the site's" {
  yes := [9] string.["/worlds", "/worlds/splice", "/worlds/splice/", "/worlds/splice/llms.txt", "/realms/splice/assets/fonts/a.woff2", "/build/splice-bots.0e7b9526d8a2.wasm", "/coaxial/host.js", "/worlds/splice?frame=1", "/build/x.wgsl#a"];
  for u: yes { #assert realm_origin_serves(u); }
  no := [16] string.["/", "", "/api/playtest/realms", "/api", "/login", "/chat", "/settings/agents", "/coaxial/live", "/coaxial/live?x", "/worldsx", "/world", "/builder", "/realmsx/a", "/index.html", "/llms.txt", "/?next=/worlds/splice"];
  // (a shader's name is the whole of the address: "/login.wgsl" is a shader's, "/login" is not)
  for u: no { #assert !realm_origin_serves(u); }
  #assert realm_origin_serves("/coaxial/liveness.js") && !realm_origin_serves("/coaxial/live/x") && !realm_origin_serves("worlds/splice") && !realm_origin_serves("/WORLDS/splice");
  #assert realm_origin_under("/build", "/build") && realm_origin_under("/build/a", "/build") && !realm_origin_under("/buil", "/build") && !realm_origin_under("/buildx", "/build");
  // a page's shader at the root, by name; nothing else at the root but the icon
  #assert realm_origin_serves("/splice-bots.wgsl") && realm_origin_serves("/everglade-2.wgsl?v=1") && realm_origin_serves("/a.wgsl") && realm_origin_serves("/az09-.wgsl") && realm_origin_serves("/favicon.svg");
  #assert !realm_origin_serves("/.wgsl") && !realm_origin_serves("/a/b.wgsl") && !realm_origin_serves("/A.wgsl") && !realm_origin_serves("/a.wgslx") && !realm_origin_serves("/a.wgs") && !realm_origin_serves("/a_b.wgsl") && !realm_origin_serves("a.wgsl") && !realm_origin_serves("/favicon.svgx") && !realm_origin_serves("/favicon.sv");
  #assert !realm_origin_shader("/`.wgsl") && !realm_origin_shader("/{.wgsl") && !realm_origin_shader("//.wgsl") && !realm_origin_shader("/:.wgsl") && !realm_origin_shader("/,.wgsl") && !realm_origin_shader("/..wgsl") && !realm_origin_shader("xa.wgsl") && realm_origin_shader("/z.wgsl") && realm_origin_shader("/9.wgsl") && realm_origin_shader("/0.wgsl");
  // the first byte counts too, and only ? and # end the path
  #assert !realm_origin_under("Xworlds", "/worlds") && !realm_origin_serves("Xworlds/a") && realm_origin_serves("/worlds#x") && realm_origin_serves("/worlds?x") && !realm_origin_serves("/worlds$x") && !realm_origin_serves("/worlds>x") && !realm_origin_serves("/worlds@x");
}
#test "every answer is sandboxed with no origin, may be framed by the site and fetched without credentials" {
  h := realm_origin_headers();
  #assert h == "Content-Security-Policy: sandbox allow-scripts allow-pointer-lock allow-orientation-lock\r\nCross-Origin-Resource-Policy: cross-origin\r\nAccess-Control-Allow-Origin: *\r\nReferrer-Policy: no-referrer\r\n";
  // never the token that would give the document its origin back
  word := "allow-same-origin"; found := false;
  for i: 0..<h.count - word.count + 1 { if h[i..<i + word.count] == word { found = true; } }
  #assert !found;
}
#test "a request is the realm's by its Host, whole, whatever its case" {
  #assert realm_origin_host("localhost:9400", "localhost:9400") && realm_origin_host("LocalHost:9400", "localhost:9400") && realm_origin_host("play.example", "PLAY.EXAMPLE");
  #assert !realm_origin_host("127.0.0.1:9400", "localhost:9400") && !realm_origin_host("localhost:940", "localhost:9400") && !realm_origin_host("localhost:94000", "localhost:9400") && !realm_origin_host("", "") && !realm_origin_host("a", "") && !realm_origin_host("", "a");
  #assert realm_origin_host("Ab", "ab") && realm_origin_host("ab", "Ab") && realm_origin_host("aZ", "az") && realm_origin_host("az", "aZ") && !realm_origin_host("{a", "[a") && !realm_origin_host("`a", "@a") && !realm_origin_host("@a", "`a");
  #assert !realm_origin_host("localhosu:9400", "localhost:9400") && !realm_origin_host("@ocalhost", "`ocalhost") && realm_origin_host("Zz", "zZ") && !realm_origin_host("[a", "{a");
}
