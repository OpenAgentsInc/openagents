// A seat in a running realm, for an agent (docs/verse/realm-seat.md, #12637, slice 2): opens a made
// realm in headless Chrome, runs typed actions from a file, one JSON object a line, and prints one
// observation a line after each. The seat itself is coax/lib/media/realm_seat.coax, which lists the
// actions; `openagents realm play` keeps one open between commands.
//
//   coax/web/tool.sh realm-seat https://staging.openagents.com SLUG [--actions FILE] [--phone]
//                    [--player-file FILE] [--shots PREFIX]
//
// Without --actions it opens the realm and prints the first observation. The page opens at
// /realms/built#SLUG, so a private realm works for its owner (--player-file: the browser's playtest
// player, {"key": ..., "id": ...}, as localStorage verse.player holds it) and a public or unlisted
// one for anyone. Exit 0 when every action ran (a "blocked" walk still ran), 1 otherwise.
#import "Basic";
#load "../lib/media/realm_seat.coax";

tool_main :: () -> int #export_c {
  a: [1] Args;
  ok := args_load(a[..]);
  s: [1] Seat;
  if !ok || !seat_init(s[..], seat_origin_of(args_at(a[..], 0)), args_at(a[..], 1), args_has(a[..], "--phone")) {
    tool_errln("usage: coax/web/tool.sh realm-seat https://staging.openagents.com SLUG [--actions FILE] [--phone] [--player-file FILE] [--shots PREFIX]");
    return 2;
  }
  actions: [65536] u8; an := 0;
  path := args_value(a[..], "--actions", "");
  if path.count > 0 { an = fs_read(path, actions[..]); if an < 0 { tool_err("realm-seat: can't read "); tool_errln(path); return 2; } }
  player: [2048] u8; pn := 0;
  pf := args_value(a[..], "--player-file", "");
  if pf.count > 0 { pn = fs_read(pf, player[..]); if pn <= 0 { tool_err("realm-seat: can't read "); tool_errln(pf); return 2; } }
  while pn > 0 && (player[pn - 1] == '\n' || player[pn - 1] == ' ') { pn -= 1; }
  shots := args_value(a[..], "--shots", "");
  c: [1] Cdp;
  if !cdp_launch(c[..], s[0].w, s[0].h, "coax-realm-seat-") { tool_err("realm-seat: "); tool_errln(cdp_error(c[..])); return 1; }
  if !seat_open(s[..], c[..], cast(string) player[0..<pn]) { tool_err("realm-seat: opening the realm: "); tool_errln(cdp_error(c[..])); cdp_close(c[..]); return 1; }
  if !seat_wait_laid(s[..], c[..], 60000) { tool_errln("realm-seat: the realm never laid out (private and not yours, or not there)"); cdp_close(c[..]); return 1; }
  seat_read_spec(s[..], c[..]);
  seat_note(s[..], "seated");
  o: [1] SeatBuf;
  seat_observation(s[..], "open", true, o[..]); print("%\n", seat_text(o[..]));
  png: [SEAT_SHOT] u8;
  status := 0; i := 0; step := 0;
  text := cast(string) actions[0..<an];
  while i < text.count {
    e := i; while e < text.count && text[e] != '\n' { e += 1; }
    line := text[i..<e]; i = e + 1;
    if line.count == 0 || line[0] == '#' { continue; }
    step += 1;
    if !seat_act(s[..], c[..], line, png[..], o[..]) { status = 1; }
    print("%\n", seat_text(o[..]));
    if shots.count > 0 {
      p: [1] SeatBuf; seat_put(p[..], shots); seat_put(p[..], "-"); seat_int(p[..], step); seat_put(p[..], ".png");
      n := cdp_screenshot(c[..], png[..]);
      if n > 0 { _ := fs_write(seat_text(p[..]), cast(string) png[0..<n]); }
    }
  }
  cdp_close(c[..]);
  return status;
}
