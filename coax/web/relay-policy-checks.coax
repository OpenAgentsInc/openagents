#load "../../nostr/relay/relay_rate.coax";
#load "../../nostr/relay/relay_route.coax";
#load "../../nostr/relay/message_server.coax";
#load "../../nostr/relay/store_fresh.coax";
#load "../../nostr/relay/store_compact.coax";
#load "../../nostr/relay/relay_key_policy.coax";
#load "../../nostr/relay/relay_write.coax";
#load "../../nostr/relay/relay_extension_policy.coax";
