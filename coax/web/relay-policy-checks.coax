// Pure policy suites for nostr/relay/, which sits outside suites.coax's
// library roots. Keep relay policy changes in the normal touched-suite gate.
// Socket, TLS, crash and independent signature checks remain relay_session.py.
// coax test coax/web/relay-policy-checks.coax --library
#run_steps 250000000;
