// A recorded session replays bit for bit natively and in the browser
// (aethyr/replay.coax, Aethyr book chapter 5). aethyr/tests/replay-walk.coax
// records a walk, replays it and plants a fault; this builds it to wasm the
// way pages are built (coax/web/wasm.sh: -O2, no fast math, no
// contraction), runs it in headless Chrome (coax/web/wasm-chrome.coax), and
// compares every number with the native run of
// aethyr/examples/replay-a-walk.coax. The second check does the same for a
// recorded Grid session (verse/tests/grid-session.coax: the Grid's own
// session code, verse/gridwalk.coax, with keys, a drag, the wheel, the touch
// stick, a pinch and taps) and compares the digest of every step. Both
// sessions turn while they walk through angles where the hosts' sinf and
// cosf round differently, so either check fails if a step calls the C
// library's sin or cos. The third check (Aethyr book chapter 80) builds
// aethyr/tests/scatter-hosts.coax the same way and compares its seven
// digests (a forest scattered from a seed over a built ground, its trees'
// heights, a second layer, a split window, another version, another seed)
// with the native run of aethyr/examples/scatter-from-a-seed.coax. The fourth (#12854) builds
// aethyr/tests/crowd-deadgears.coax the same way and compares its three digests (Dead Gears'
// mutants sensing, remembering and finding their way as two crowds meet in a passage) with the
// native run of aethyr/tests/crowd-deadgears-native.coax.
//   coax/web/tool.sh replay-hosts [walk|grid|scatter|deadgears|exchange|crypto]     (from the repo root; all by default)
// Prints "pass"/"FAIL" per check and exits 0 only when every check passes.
#load "wasm-chrome.coax";
#load "../lib/sys/proc-raw.coax";

RH_OUT :: 1048576;
RH_NUMS :: 4096;

#test "the numbers in a text, in order" {
  n: [8] int;
  #assert rh_numbers("refused 1 2 3\nrecorded -45 x7y", n[..]) == 5 && n[0] == 1 && n[3] == -45 && n[4] == 7;
  k := rh_numbers("a-1 b22 -3", n[..]);
  #assert k == 3 && n[0] == -1 && n[1] == 22 && n[2] == -3;
  #assert rh_numbers("none", n[..]) == 0;
}
#test "lines" {
  t := "a\nbb\n\nc";
  #assert rh_line(t, 0) == "a" && rh_line(t, 1) == "bb" && rh_line(t, 2) == "" && rh_line(t, 3) == "c" && rh_line(t, 4) == "";
  #assert rh_session("session 123") && !rh_session("session ") && !rh_session("session 1x") && !rh_session("sessions 1");
}

// Every -?\d+ in text into out, as JavaScript's matchAll reads them: the count.
rh_numbers :: (text: string, out: [] int) -> int {
  k := 0; i := 0;
  while i < text.count && k < out.count {
    neg := text[i] == '-' && i + 1 < text.count && text[i + 1] >= '0' && text[i + 1] <= '9';
    if neg || (text[i] >= '0' && text[i] <= '9') {
      j := ifx neg then i + 1 else i; v := 0;
      while j < text.count && text[j] >= '0' && text[j] <= '9' { v = v * 10 + cast(int) (text[j] - '0'); j += 1; }
      out[k] = ifx neg then -v else v; k += 1; i = j;
    } else { i += 1; }
  }
  return k;
}
rh_line :: (text: string, k: int) -> string {
  i := 0; l := 0;
  while i <= text.count {
    j := i;
    while j < text.count && text[j] != '\n' { j += 1; }
    if l == k { return text[i..<j]; }
    if j >= text.count { return ""; }
    l += 1; i = j + 1;
  }
  return "";
}
rh_session :: (s: string) -> bool {
  h := "session ";
  if s.count <= h.count || s[0..<h.count] != h { return false; }
  for i: h.count..<s.count { if s[i] < '0' || s[i] > '9' { return false; } }
  return true;
}
rh_run :: (argv: [] string, out: [] u8) -> int {
  err: [8192] u8;
  r := proc_run(argv, 600000, out, err[..]);
  if r.started != 0 || r.status != 0 || r.cut {
    tool_err("replay-hosts: ");for i:0..<argv.count {if i>=3 {break;}tool_err(argv[i]);tool_err(" ");}tool_err("failed: ");
    tool_errln(cast(string) err[0..<r.err_n]);
    return -1;
  }
  return r.out_n;
}
rh_check :: (ok: bool, what: string) -> bool {
  if !ok { tool_err("replay-hosts: "); tool_errln(what); }
  return ok;
}
// The wasm build of coax_file + face, instantiated in c.
rh_wasm :: (c: [] Cdp, coax_file: string, face: string, pages: int) -> bool {
  tmp: [1024] u8; path: [1100] u8; out: [4096] u8;
  dir := fs_temp("replay-hosts-", tmp[..]);
  if dir.count == 0 { return rh_check(false, "no temporary directory"); }
  wasm := fs_join(dir, "m.wasm", path[..]);
  argv := [4] string.["coax/web/wasm.sh", coax_file, face, wasm];
  if rh_run(argv[..], out[..]) < 0 { r := fs_remove(dir); return false; }
  bytes: [16777216] u8;
  n := fs_read(wasm, bytes[..]);
  r := fs_remove(dir);
  if n < 0 { return rh_check(false, "the wasm build wrote nothing"); }
  return rh_check(wc_file(c, "m", cast(string) bytes[0..<n]) && wc_load(c, "m", pages, "{}", WC_ZERO) == "ok", cdp_error(c));
}

// A recorded walk gives the same digests natively and in wasm.
rh_walk :: (c: [] Cdp) -> bool {
  out: [RH_OUT] u8;
  argv := [3] string.["coax/bin/coax", "run", "aethyr/examples/replay-a-walk.coax"];
  n := rh_run(argv[..], out[..]);
  if n < 0 { return false; }
  native: [16] int;
  k := rh_numbers(cast(string) out[0..<n], native[..]);
  if !rh_check(k == 7, "replay-a-walk printed other than 7 numbers") { return false; }
  if !rh_wasm(c, "aethyr/tests/replay-walk.coax", "aethyr/tests/replay-walk-face.c", 256) { return false; }
  refused := wc_int(c, "replay_walk", "3n");
  browser := [7] int.[refused / 1000000, refused / 1000 % 1000, refused % 1000, wc_int(c, "replay_walk", "0n"), wc_int(c, "replay_walk", "1n"), 150, wc_int(c, "replay_walk", "2n")];
  same := true;
  for i: 0..<7 { if browser[i] != native[i] { same = false; print("  number %: browser % native %\n", i, browser[i], native[i]); } }
  // the native output: refused (3 numbers), recorded, replayed, "step 150", first divergent step
  return rh_check(same, "the browser's numbers differ from native") && rh_check(native[3] == native[4], "the replay did not match the recording") &&
         rh_check(native[3] > 0, "the recording's digest is 0") && rh_check(native[6] == 150, "the planted fault was not found where it starts");
}

// Exchange actual encoded records in both directions. Each receiver reads
// the producer's bytes and compares every step; it never makes model calls.
rh_exchange :: (c:[]Cdp)->bool {
  tmp:[1024]u8;dir:=fs_temp("replay-exchange-",tmp[..]);if dir.count==0 {return false;}
  defer {removed:=fs_remove(dir);}
  pb:[1200]u8;path:=fs_join(dir,"native.arc",pb[..]);out:[RH_OUT]u8;
  make:=[6]string.["coax/web/tool.sh","aethyr/tests/replay-wire-native.coax","make",path,"2026",""];
  n:=rh_run(make[0..<5],out[..]);if n<0 {return false;}
  native:[RH_NUMS]int;nn:=rh_numbers(cast(string)out[0..<n],native[..]);
  if !rh_check(nn>3 && native[0]>0 && native[1]==nn-3,"native exchange trace has invalid extents") {return false;}
  bytes:[131072]u8;nb:=fs_read(path,bytes[..]);
  if !rh_check(nb==native[0],"native record size differs") {return false;}
  if !rh_wasm(c,"aethyr/tests/replay-wire-walk.coax","aethyr/tests/replay-wire-face.c",512) {return false;}
  pointer:=wc_int(c,"rw_pointer","");
  if !wc_write(c,pointer,cast(string)bytes[0..<nb]) {return false;}
  arg:[128]u8;d:[24]u8;parts:=[2]string.[wc_dec(d[..],nb),"n,-1n"];
  if !rh_check(wc_int(c,"rw_play",wc_cat(arg[..],parts[..]))==native[1],"browser refused native record") {return false;}
  for tick:0..<native[1] {
    number:=[2]string.[wc_dec(d[..],tick),"n"];
    if !rh_check(wc_int(c,"rw_mark",wc_cat(arg[..],number[..]))==native[tick+3],"native-to-browser step differs") {return false;}
  }
  if !rh_check(wc_int(c,"rw_digest","")==native[2] && wc_int(c,"rw_remote","")==0,"native-to-browser digest or remote-call count differs") {return false;}
  faulty:=[2]string.[wc_dec(d[..],nb),"n,150n"];
  if !rh_check(wc_int(c,"rw_play",wc_cat(arg[..],faulty[..]))==-4 && wc_int(c,"rw_diverged","")==150,"exchanged record misses the planted fault") {return false;}
  browser_bytes:=wc_int(c,"rw_make","2027n");steps:=wc_int(c,"rw_steps","");digest:=wc_int(c,"rw_digest","");
  if !rh_check(browser_bytes>0 && steps>0,"browser produced no record") {return false;}
  if wc_read(c,pointer,browser_bytes,bytes[..])!=browser_bytes {return false;}
  bp:[1200]u8;browser:=fs_join(dir,"browser.arc",bp[..]);if !fs_write(browser,cast(string)bytes[0..<browser_bytes]) {return false;}
  play:=[5]string.["coax/web/tool.sh","aethyr/tests/replay-wire-native.coax","play",browser,"2027"];
  n=rh_run(play[..],out[..]);if n<0 {return false;}
  nn=rh_numbers(cast(string)out[0..<n],native[..]);
  if !rh_check(nn==steps+3 && native[0]==browser_bytes && native[1]==steps && native[2]==digest,"browser-to-native record differs") {return false;}
  for tick:0..<steps {
    number:=[2]string.[wc_dec(d[..],tick),"n"];
    if !rh_check(wc_int(c,"rw_mark",wc_cat(arg[..],number[..]))==native[tick+3],"browser-to-native step differs") {return false;}
  }
  return true;
}

// Explicit secret storage after a real signed/encrypted roundtrip and
// refusal, using the same Coax runtime in optimized C, ASan/UBSan and Wasm.
rh_crypto :: (c:[]Cdp)->bool {
  temp:[1024]u8;dir:=fs_temp("nip59-host-cleanup-",temp[..]);if dir.count==0 {return false;}
  defer {removed:=fs_remove(dir);}
  paths:[4][1200]u8;header:=fs_join(dir,"nip59-cleanup.h",paths[0][..]);source:=fs_join(dir,"cleanup.c",paths[1][..]);exe:=fs_join(dir,"cleanup",paths[2][..]);
  out:[8388608]u8;
  for release:[2]bool.[false,true] {
    argv:=[8]string.["coax/bin/coax","c","coax/tests/nostr/nip59-cleanup.coax","--library","--header",header,"--release",""];
    env:[]string;errors:[8192]u8;
    emitted:=proc_run_bytes(argv[0..<ifx release then 7 else 6],env,600000,out[..],errors[..]);
    if emitted.started!=0 || emitted.status!=0 || emitted.cut || emitted.timed_out {tool_errln(cast(string)errors[0..<emitted.err_n]);return false;}
    if !fs_write(source,cast(string)out[0..<emitted.out_n]) {return false;}
    include:[1300]u8;prefix:="-I";parts:=[2]string.[prefix,dir];inc:=wc_cat(include[..],parts[..]);
    for sanitizer:[2]bool.[false,true] {
      if release && sanitizer {continue;}
      cc:=[15]string.["cc","-std=c11",ifx sanitizer then "-O1" else "-O2","-g","-ffp-contract=off","-fno-fast-math",inc,source,
        "coax/tests/nostr/nip59-cleanup-face.c","-lm","-o",exe,ifx sanitizer then "-fsanitize=address,undefined" else "-fno-omit-frame-pointer","-fno-omit-frame-pointer",""];
      if rh_run(cc[0..<14],out[..])<0 {return false;}
      run:=[1]string.[exe];if rh_run(run[..],out[..])<0 {return false;}
    }
  }
  if !rh_wasm(c,"coax/tests/nostr/nip59-cleanup.coax","coax/tests/nostr/nip59-cleanup-face.c",512) {return false;}
  return rh_check(wc_int(c,"crypto_cleanup","")==1,"Wasm NIP-59 cleanup or roundtrip failed");
}

// A recorded Grid session gives the same digest at every step natively and in wasm.
rh_grid :: (c: [] Cdp) -> bool {
  out: [RH_OUT] u8;
  argv := [3] string.["coax/bin/coax", "run", "verse/tests/grid-session.coax"];
  n := rh_run(argv[..], out[..]);
  if n < 0 { return false; }
  text := cast(string) out[0..<n];
  head: [4] int;
  if !rh_check(rh_numbers(rh_line(text, 0), head[..]) >= 2, "grid-session's first line has no record and step counts") { return false; }
  records := head[0]; steps := head[1];
  if !rh_check(records == 1, "the session is not one record") || !rh_check(steps > 600 && steps < 100000, "the session has too few steps") { return false; }
  session := rh_line(text, 1 + steps);
  if !rh_check(rh_session(session), "no session line after the steps") || !rh_check(rh_line(text, 2 + steps) == "replayed true", "the session did not replay") { return false; }
  if !rh_wasm(c, "verse/tests/grid-session.coax", "verse/tests/grid-session-face.c", 256) { return false; }
  if !rh_check(wc_int(c, "grid_play", "") == steps, "the browser played another number of steps") { return false; }
  if !rh_check(wc_int(c, "grid_records", "") == 1, "the browser's session is not one record") { return false; }
  first := -1; d: [24] u8; arg: [32] u8;
  for k: 0..<steps {
    parts1 := [2] string.[wc_dec(d[..], k), "n"];
    a := wc_cat(arg[..], parts1[..]);
    if wc_int(c, "grid_mark", a) != wc_parse(rh_line(text, 1 + k)) { first = k; break; }
  }
  if first >= 0 { print("  step % is the first that differs\n", first); }
  parts2 := [2] string.[wc_dec(d[..], steps), "n"];
  last := wc_cat(arg[..], parts2[..]);
  sb: [64] u8;
  parts3 := [2] string.["session ", wc_call(c, "grid_session", "")];
  browser_session := wc_cat(sb[..], parts3[..]);
  return rh_check(first < 0, "a step differs") && rh_check(wc_int(c, "grid_mark", last) == -1, "a mark past the last step") &&
         rh_check(browser_session == session, "the browser's session digest differs") && rh_check(wc_int(c, "grid_replayed", "") == 1, "the browser did not replay");
}

// A scatter and its ground from a seed give the same digests natively and in wasm.
RH_SCATTER_CASES :: 7;
rh_scatter :: (c: [] Cdp) -> bool {
  out: [RH_OUT] u8;
  argv := [3] string.["coax/bin/coax", "run", "aethyr/examples/scatter-from-a-seed.coax"];
  n := rh_run(argv[..], out[..]);
  if n < 0 { return false; }
  text := cast(string) out[0..<n];
  line := "";
  for k: 0..<64 {
    l := rh_line(text, k);
    if l.count > 8 && l[0..<8] == "digests " { line = l; break; }
  }
  native: [16] int;
  if !rh_check(rh_numbers(line, native[..]) == RH_SCATTER_CASES, "scatter-from-a-seed printed no line of 7 digests") { return false; }
  if !rh_wasm(c, "aethyr/tests/scatter-hosts.coax", "aethyr/tests/scatter-hosts-face.c", 256) { return false; }
  same := true;
  d: [24] u8; arg: [32] u8;
  for i: 0..<RH_SCATTER_CASES {
    parts := [2] string.[wc_dec(d[..], i), "n"];
    browser := wc_int(c, "scatter_case", wc_cat(arg[..], parts[..]));
    if browser != native[i] { same = false; print("  case %: browser % native %\n", i, browser, native[i]); }
  }
  return rh_check(same, "the browser's scatter differs from native") && rh_check(native[1] == native[4], "the split window is not the whole") &&
         rh_check(native[0] > 0 && native[1] != native[0], "the keep-outs took nothing away");
}

// Dead Gears' crowds in a passage give the same digests natively and in wasm.
RH_DEADGEARS_CASES :: 3;
rh_deadgears :: (c: [] Cdp) -> bool {
  out: [RH_OUT] u8;
  argv := [3] string.["coax/bin/coax", "run", "aethyr/tests/crowd-deadgears-native.coax"];
  n := rh_run(argv[..], out[..]);
  if n < 0 { return false; }
  text := cast(string) out[0..<n];
  line := ""; stated := false;
  for k: 0..<64 {
    l := rh_line(text, k);
    if l.count > 8 && l[0..<8] == "digests " { line = l; }
    if l == "runs not as stated: 0" { stated = true; }
  }
  if !rh_check(stated, "a passage run in crowd-deadgears-native is not as stated") { return false; }
  native: [8] int;
  if !rh_check(rh_numbers(line, native[..]) == RH_DEADGEARS_CASES, "crowd-deadgears-native printed no line of 3 digests") { return false; }
  if !rh_wasm(c, "aethyr/tests/crowd-deadgears.coax", "aethyr/tests/crowd-deadgears-face.c", 256) { return false; }
  same := true;
  d: [24] u8; arg: [32] u8;
  for i: 0..<RH_DEADGEARS_CASES {
    parts := [2] string.[wc_dec(d[..], i), "n"];
    browser := wc_int(c, "deadgears_npc_case", wc_cat(arg[..], parts[..]));
    if browser != native[i] { same = false; print("  case %: browser % native %\n", i, browser, native[i]); }
  }
  return rh_check(same, "the browser's crowds differ from native") && rh_check(native[0] != native[1] && native[1] != native[2], "two cases gave one digest");
}

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) { return 2; }
  only := ifx args_count(a[..]) > 0 then args_at(a[..], 0) else "";
  if only != "" && only != "walk" && only != "grid" && only != "scatter" && only != "deadgears" && only != "exchange" && only != "crypto" { tool_errln("usage: coax/web/tool.sh replay-hosts [walk|grid|scatter|deadgears|exchange|crypto]"); return 2; }
  c: [1] Cdp;
  if !wc_open(c[..]) { tool_err("replay-hosts: "); tool_errln(cdp_error(c[..])); return 1; }
  failed := 0;
  if only == "" || only == "walk" {
    ok := rh_walk(c[..]);
    print("% a recorded walk gives the same digests natively and in wasm\n", ifx ok then "pass" else "FAIL");
    if !ok { failed += 1; }
  }
  if only == "" || only == "grid" {
    ok := rh_grid(c[..]);
    print("% a recorded Grid session gives the same digest at every step natively and in wasm\n", ifx ok then "pass" else "FAIL");
    if !ok { failed += 1; }
  }
  if only == "" || only == "scatter" {
    ok := rh_scatter(c[..]);
    print("% a scatter and its ground from a seed give the same digests natively and in wasm\n", ifx ok then "pass" else "FAIL");
    if !ok { failed += 1; }
  }
  if only == "" || only == "deadgears" {
    ok := rh_deadgears(c[..]);
    print("% Dead Gears' crowds in a passage give the same digests natively and in wasm\n", ifx ok then "pass" else "FAIL");
    if !ok { failed += 1; }
  }
  if only=="" || only=="exchange" {ok:=rh_exchange(c[..]);print("% actual replay records exchanged native/browser in both directions\n",ifx ok then "pass" else "FAIL");if !ok {failed+=1;}}
  if only=="" || only=="crypto" {ok:=rh_crypto(c[..]);print("% NIP-59 cleanup in native/release, ASan/UBSan and Wasm\n",ifx ok then "pass" else "FAIL");if !ok {failed+=1;}}
  cdp_close(c[..]);
  return ifx failed == 0 then 0 else 1;
}
