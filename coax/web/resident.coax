// The resident browser: one headless Chrome per checkout that stays up between
// `coax/web/tool.sh shot`, `clip` and `drive` calls, so a call pays for its page, not for a
// browser (GitHub #13139; docs/metaverse/fast-shots.md). No window opens and no sound plays.
//
//   c: [1] Cdp;
//   r: [1] Rs;
//   if rs_open(c[..], r[..]) && rs_fresh(c[..], r[..], w, h) { ... the page's commands, as after cdp_launch ...; rs_release(c[..], r[..], false); }
//   else if cdp_launch(c[..], w, h, "coax-shot-") { ...; cdp_close(c[..]); }   // the fallback
//
// rs_open answers false when there is no resident browser to use: SHOT_RESIDENT=0, the
// browser could not start or does not answer, or another call in this checkout holds
// it. The caller then starts its own browser, as every call did before.
//
// The parts, under ~/.cache/coax-shots/CHECKOUT/ (SHOT_RESIDENT_DIR names another place):
//   profile/       Chrome's profile: its HTTP, shader and compiled-Wasm caches outlive the browser
//   state          the DevTools port and the browser's ws:// URL, written by the keeper
//   page           the ws:// URL of the page the last call left loaded
//   keeper.lock    held by the keeper for its life
//   request.lock   held by the call that uses the page
//   used           written by each call; the keeper stops the browser RS_IDLE_MS after the last
// The keeper is this tool run as `shot --keeper DIR` (rs_keeper), detached from the call
// that started it. It owns Chrome, so the browser's process group goes when the keeper
// stops: after RS_IDLE_MS without a call, when `state` is removed (`shot --stop`), or
// when Chrome quits.
//
// Each call's page is a new tab in a new browser context (Target.createBrowserContext):
// no cookies, storage or HTTP cache from an earlier call, as a new profile had. A call
// with --keep leaves its page loaded, its world's loop off; any other call closes its
// page. A --keep call uses the page left for it as it stands when rs_same says it is
// the same one: the same key (mode, colour scheme and URL) and the same files (rs_note
// keeps each file's validator or SHA-256; rs_same asks the server again). Otherwise the
// call closes it and loads its own.
//
// rs_settle replaces a fixed wait: it ends when the page has stopped loading and its
// picture stands still or moves steadily (rs_quiet), or at the wait's length, whichever
// comes first.
#load "../lib/media/media.coax";
#load "../lib/image/png.coax";

cxproc_self_path :: (out: [] u8) -> int #foreign #effects(all);

RS_IDLE_MS :: 180000;      // the keeper stops the browser 3 minutes after the last call (SHOT_RESIDENT_IDLE_S: another time)
RS_START_MS :: 30000;      // the most a call waits for a starting resident browser
RS_STATE :: 2048;

// ---- the checkout's directory (pure) --------------------------------------

#test "a checkout's directory name: its path with every other byte an underscore" {
  out: [64] u8;
  #assert rs_name("/Users/a/work/oa-shots", out[..]) == "Users_a_work_oa-shots";
  #assert rs_name("/a b/c.d/", out[..]) == "a_b_c.d" && rs_name("", out[..]) == "none" && rs_name("///", out[..]) == "none";
  // a long path keeps its end, where checkouts differ
  long: [200] u8; for i: 0..<200 { long[i] = ifx i < 150 then 'x' else 'y'; }
  got := rs_name(cast(string) long[..], out[..]);
  #assert got.count == 64 && got[0] == 'x' && got[63] == 'y' && got[13] == 'x' && got[14] == 'y';
}
rs_name :: (path: string, out: [] u8) -> string {
  from := 0; to := path.count;
  while from < to && path[from] == '/' { from += 1; }
  while to > from && path[to - 1] == '/' { to -= 1; }
  if to - from > out.count { from = to - out.count; }
  if to == from { return ws_text_rs("none", out); }
  for i: from..<to {
    b := path[i];
    keep := (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '-' || b == '.';
    out[i - from] = ifx keep then b else '_';
  }
  return cast(string) out[0..<to - from];
}
ws_text_rs :: (s: string, out: [] u8) -> string {
  n := ifx s.count < out.count then s.count else out.count;
  for i: 0..<n { out[i] = s[i]; }
  return cast(string) out[0..<n];
}
#test "the state file: a port, then the browser's URL" {
  u: [64] u8;
  #assert rs_state_url("9222\nws://127.0.0.1:9222/devtools/page/A\n", u[..]) == "ws://127.0.0.1:9222/devtools/page/A";
  #assert rs_state_url("9222\nws://h/x", u[..]) == "ws://h/x";
  #assert rs_state_url("9222\n", u[..]) == "" && rs_state_url("", u[..]) == "" && rs_state_url("x\nws://h/x\n", u[..]) == "" && rs_state_url("9222\nhttp://h/x\n", u[..]) == "";
}
rs_state_url :: (text: string, out: [] u8) -> string {
  if cdp_port_of(text) < 0 { return ""; }
  i := 0;
  while i < text.count && text[i] != '\n' { i += 1; }
  from := i + 1; to := from;
  while to < text.count && text[to] != '\n' && text[to] != '\r' { to += 1; }
  if from >= text.count || to - from > out.count { return ""; }
  url := text[from..<to];
  if !cdp_ws_parts(url).ok { return ""; }
  return ws_text_rs(url, out);
}

// ---- when a picture has stopped changing (pure) --------------------------

// Two small pictures of the page (RGBA, the same size): how many of a thousand pixels
// differ by more than RS_PIXEL in some channel. -1 when the sizes differ.
RS_PIXEL :: 6;
RS_QUIET :: 12;           // pixels in a thousand that a steady scene's change may vary by
#test "pictures differ by their changed pixels, not by small noise" {
  a: [40] u8; b: [40] u8;
  for i: 0..<40 { a[i] = 100; b[i] = 100; }
  #assert rs_changed(a[..], b[..]) == 0;
  for i: 0..<40 { b[i] = 100 + cast(u8) RS_PIXEL; }
  #assert rs_changed(a[..], b[..]) == 0;
  b[4] = 100 + cast(u8) RS_PIXEL + 1;
  #assert rs_changed(a[..], b[..]) == 100 && rs_changed(b[..], a[..]) == 100;
  for i: 0..<40 { b[i] = 0; }
  #assert rs_changed(a[..], b[..]) == 1000 && rs_changed(a[0..<36], b[..]) == -1 && rs_changed(a[0..<0], b[0..<0]) == -1;
}
rs_changed :: (a: [] u8, b: [] u8) -> int {
  if a.count != b.count || a.count < 4 { return -1; }
  px := a.count / 4; n := 0;
  for p: 0..<px {
    hit := false;
    for k: 0..<3 {
      d := cast(int) a[p * 4 + k] - cast(int) b[p * 4 + k];
      if d > RS_PIXEL || d < -RS_PIXEL { hit = true; }
    }
    if hit { n += 1; }
  }
  return n * 1000 / px;
}
// A settle's memory: the looks in a row whose picture did not change at all, and the
// last RS_WINDOW amounts of change (oldest first) since anything loaded.
RS_WINDOW :: 6;
RS_BUSY :: 600;           // a picture that changes in this many pixels of a thousand is never steady
RsQuiet :: struct { still: int; n: int; last: [RS_WINDOW] int; }
// One look more. `near` is how much the picture changed against the look before (pixels
// in a thousand; -1: no such pair). A look after which the page loaded something, awaits
// media or runs a finite animation, or whose picture changed nearly everywhere, starts over.
rs_quiet_next :: (q: RsQuiet, near: int, loaded: bool, waiting: bool) -> RsQuiet {
  r := q;
  if near < 0 || loaded || waiting || near >= RS_BUSY { r.still = 0; r.n = 0; return r; }
  r.still = ifx near == 0 then q.still + 1 else 0;
  if r.n == RS_WINDOW { for i: 0..<RS_WINDOW - 1 { r.last[i] = r.last[i + 1]; } r.n = RS_WINDOW - 1; }
  r.last[r.n] = near; r.n += 1;
  return r;
}
// Whether the page is ready for its picture. A page that stands still is: `still` looks
// in a row without one changed pixel. A scene that always moves (grass, water, a crowd)
// is once it moves steadily: RS_WINDOW looks whose amounts of change stay within a factor
// of two of each other (plus RS_QUIET) and do not fall off, the later half at least three
// fifths of the earlier. Something coming to rest (a card fading out, a character taking
// its place) changes less with each look, so it is waited out until it stands still.
#test "a still page is quiet at once; a moving scene once it moves steadily; one coming to rest is waited out" {
  q: RsQuiet;
  q = rs_quiet_next(q, -1, false, false); #assert !rs_quiet(q, 2) && q.n == 0;
  q = rs_quiet_next(q, 0, false, false); #assert !rs_quiet(q, 2) && rs_quiet(q, 1);
  q = rs_quiet_next(q, 0, false, false); #assert rs_quiet(q, 2);
  // a load, awaited media or a picture changing everywhere starts over
  #assert !rs_quiet(rs_quiet_next(q, 0, true, false), 1) && !rs_quiet(rs_quiet_next(q, 0, false, true), 1) && !rs_quiet(rs_quiet_next(q, RS_BUSY, false, false), 1);
  #assert rs_quiet_next(q, RS_BUSY - 1, false, false).n == 3 && rs_quiet_next(q, RS_BUSY, false, false).n == 0;
  // grass: steady after RS_WINDOW looks, not one before
  m: RsQuiet;
  for v, i: [6] int.[27, 31, 29, 46, 45, 32] { #assert !rs_quiet(m, 2); m = rs_quiet_next(m, v, false, false); }
  #assert rs_quiet(m, 2) && m.n == RS_WINDOW;
  // a character taking its place: less each look, then still
  d: RsQuiet;
  for v: [6] int.[4, 3, 2, 2, 1, 1] { d = rs_quiet_next(d, v, false, false); }
  #assert !rs_quiet(d, 2);
  d = rs_quiet_next(d, 0, false, false); #assert !rs_quiet(d, 2);
  d = rs_quiet_next(d, 0, false, false); #assert rs_quiet(d, 2);
  // a burst (a card gone, a pack arrived) is not steady until it has left the window
  b: RsQuiet;
  for v: [6] int.[400, 30, 28, 31, 29, 30] { b = rs_quiet_next(b, v, false, false); }
  #assert !rs_quiet(b, 2);
  b = rs_quiet_next(b, 33, false, false); #assert rs_quiet(b, 2) && b.last[0] == 30 && b.last[5] == 33;
  // growing change is not steady
  g: RsQuiet;
  for v: [6] int.[10, 20, 40, 80, 160, 320] { g = rs_quiet_next(g, v, false, false); }
  #assert !rs_quiet(g, 2);
}
rs_quiet :: (q: RsQuiet, still: int) -> bool {
  if q.still >= still { return true; }
  if q.n < RS_WINDOW { return false; }
  lo := q.last[0]; hi := q.last[0]; early := 0; late := 0;
  for i: 0..<RS_WINDOW {
    v := q.last[i];
    if v < lo { lo = v; }
    if v > hi { hi = v; }
    if i < RS_WINDOW / 2 { early += v; } else { late += v; }
  }
  return hi <= lo * 2 + RS_QUIET && late * 5 >= early * 3;
}

// ---- the page's side --------------------------------------------------------

// What the page is loading: "RESOURCES WAITING" (resource entries so far; media not yet ready
// plus finite CSS animations and transitions still running).
RS_BUSY_JS :: "(() => { const c = globalThis.coaxial; let m = 0; try { m = (c && c.renderMediaState ? c.renderMediaState() : []).filter((x) => !x.ready && !x.failed).length; } catch (e) {} try { m += document.getAnimations().filter((a) => a.playState === 'running' && a.effect && Number.isFinite(a.effect.getComputedTiming().endTime)).length; } catch (e) {} return performance.getEntriesByType('resource').length + ' ' + m; })()";
// Three frames drawn (or a second gone by, for a page that draws none).
RS_FRAMES_JS :: "new Promise((r) => { let n = 0; const t = setTimeout(() => r(n), 1000); const f = () => { if (++n >= 3) { clearTimeout(t); r(n); } else requestAnimationFrame(f); }; requestAnimationFrame(f); })";
// The world's loop off (a kept page draws nothing between calls; a page in clip mode
// draws only when stepped) and on again.
RS_PAUSE_JS :: "(() => { try { const c = globalThis.coaxial; if (c && c.setWorldPaused && c.ready && globalThis.coaxialClip !== true) c.setWorldPaused(true); } catch (e) {} return true; })()";
RS_RESUME_JS :: "(() => { try { const c = globalThis.coaxial; if (c && c.setWorldPaused && c.worldLoop && c.worldLoop().paused) c.setWorldPaused(false); } catch (e) {} return true; })()";
// coaxShotNote(key) keeps the page's key and its files' signatures; coaxShotCheck(key)
// answers 'same' when the page has that key and every file still has its signature,
// 'changed' when a file differs, 'other' for another page. A file is the document or a
// same-origin URL with an extension, outside /api/. Its signature is the server's ETag
// or Last-Modified when a HEAD gives one (a CDN), else its SHA-256 (above 16 MiB: its
// size and the SHA-256 of sixteen 64 KiB parts spread over it).
RS_LIB_JS :: "(() => { const stat = (u) => { try { const x = new URL(u); return x.origin === location.origin && !x.pathname.startsWith('/api/') && (u === location.href || /[.][a-z0-9]{2,5}$/i.test(x.pathname)); } catch (e) { return false; } }; const one = async (u) => { try { let r = await fetch(u, { method: 'HEAD', cache: 'no-store' }); const v = r.ok && (r.headers.get('etag') || r.headers.get('last-modified')); if (v) return u + ' ' + v + ' ' + r.headers.get('content-length'); r = await fetch(u, { cache: 'no-store', headers: { Range: 'bytes=0-0' } }); const total = r.status === 206 ? Number((r.headers.get('content-range') || '').split('/')[1]) : -1; await r.arrayBuffer(); if (total > 16777216) { let d = ''; for (let i = 0; i < 16; i++) { const at = Math.floor((total - 65536) * i / 15); const part = await (await fetch(u, { cache: 'no-store', headers: { Range: 'bytes=' + at + '-' + (at + 65535) } })).arrayBuffer(); d += Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', part)).slice(0, 4), (x) => x.toString(16).padStart(2, '0')).join(''); } return u + ' ' + total + ' ' + d; } r = await fetch(u, { cache: 'no-store' }); const b = await r.arrayBuffer(); const h = new Uint8Array(await crypto.subtle.digest('SHA-256', b)); return u + ' ' + r.status + ' ' + b.byteLength + ' ' + Array.from(h.slice(0, 12), (x) => x.toString(16).padStart(2, '0')).join(''); } catch (e) { return u + ' ?'; } }; const sig = async (urls) => (await Promise.all(urls.map(one))).join(' | '); globalThis.coaxShotNote = async (k) => { const urls = [location.href].concat(performance.getEntriesByType('resource').map((e) => e.name)).filter((u, i, a) => a.indexOf(u) === i && stat(u)); globalThis.coaxShot = { key: k, urls, sig: await sig(urls) }; performance.clearResourceTimings(); return urls.length; }; globalThis.coaxShotCheck = async (k) => { const s = globalThis.coaxShot; if (!s || s.key !== k) return 'other'; const same = (await sig(s.urls)) === s.sig; performance.clearResourceTimings(); return same ? 'same' : 'changed'; }; return true; })()";

// ---- effects ------------------------------------------------------------------

Rs :: struct {
  dir: [1200] u8; dir_n: int;
  held: bool;                 // this call holds request.lock
  port: int; browser: [512] u8; browser_n: int;   // from the state file
  samples: int; settled_ms: int; settled: bool;   // the last rs_settle
  trace: bool;                // rs_settle says each look on stderr (shot --times)
  look: [2] [1048576] u8; png: [1048576] u8; work: [1310720] u8;   // two small pictures and png_decode's room
}
rs_path :: (r: [] Rs, name: string, out: [] u8) -> string { return fs_join(cast(string) r[0].dir[0..<r[0].dir_n], name, out); }

// The checkout's resident directory into r: SHOT_RESIDENT_DIR, else
// ~/.cache/coax-shots/NAME for the checkout tool.sh names (COAX_TOOL_REPO), else for the
// working directory. False with no home directory.
rs_dir :: (r: [] Rs) -> bool {
  given: [1024] u8;
  d := proc_getenv("SHOT_RESIDENT_DIR", given[..]);
  if d.count > 0 { r[0].dir_n = ws_text_rs(d, r[0].dir[..]).count; return true; }
  home: [1024] u8; repo: [4096] u8; name: [160] u8; base: [1100] u8;
  h := proc_getenv("HOME", home[..]);
  if h.count == 0 { return false; }
  where := proc_getenv("COAX_TOOL_REPO", repo[..]);
  if where.count == 0 { where = fs_cwd(repo[..]); }
  // a browser is started with CHROME and CDP_WEBGPU as they were: another value is another browser
  n := rs_name(where, name[0..<100]).count;
  gpu: [32] u8; chrome: [4096] u8; part: [24] u8;
  for extra: [2] string.[proc_getenv("CDP_WEBGPU", gpu[..]), proc_getenv("CHROME", chrome[..])] {
    if extra.count > 0 { n = ws_put(name[..], n, "+"); n = ws_put(name[..], n, rs_name(extra, part[..])); }
  }
  path := fs_join(fs_join(h, ".cache/coax-shots", base[..]), cast(string) name[0..<n], r[0].dir[..]);
  r[0].dir_n = path.count;
  return path.count > 0;
}

// Finds the checkout's resident browser, starting its keeper when none runs, and takes
// the page lock. True: the caller holds the browser until rs_release, and next calls
// rs_kept or rs_fresh for its page. False: use cdp_launch.
rs_open :: (c: [] Cdp, r: [] Rs) -> bool {
  off: [16] u8;
  if proc_getenv("SHOT_RESIDENT", off[..]) == "0" { return false; }
  if !rs_dir(r) { return false; }
  dir := cast(string) r[0].dir[0..<r[0].dir_n];
  if !fs_mkdir(dir) { return false; }
  p: [1300] u8; q: [1300] u8;
  state := rs_path(r, "state", p[..]);
  // No keeper holds its lock: start one, and wait for the state it writes. A keeper on its
  // way out (idle, or stopped) lets go of its lock a moment after its state goes, so a
  // second one is started then; when that one leaves no state either, no browser starts here.
  text: [RS_STATE] u8; ws := "";
  waited := 0; polls := 0; keepers := 0;
  while true {
    if fs_try_lock(rs_path(r, "keeper.lock", q[..])) {
      u := fs_unlock();
      gone := fs_remove(state);
      if keepers >= 2 || !rs_spawn_keeper(dir) { return false; }
      keepers += 1;
      proc_sleep(50);   // the keeper takes its lock first
    }
    n := fs_read(state, text[..]);
    if n > 0 { ws = rs_state_url(cast(string) text[0..<n], r[0].browser[..]); r[0].port = cdp_port_of(cast(string) text[0..<n]); }
    if ws.count > 0 { break; }
    ms := cdp_next_wait(polls, waited, RS_START_MS);
    if ms < 0 { return false; }
    if ms > 200 { ms = 200; }
    proc_sleep(ms); waited += ms; polls += 1;
  }
  r[0].browser_n = ws.count;
  // One call at a time in the browser; a second call in this checkout takes its own.
  if !fs_try_lock(rs_path(r, "request.lock", q[..])) { return false; }
  r[0].held = true;
  touched := fs_write(rs_path(r, "used", q[..]), "1");
  c[0].proc = -1; c[0].h = -1; c[0].used = 0; c[0].id = 0; c[0].err_n = 0; c[0].profile_n = 0;
  return true;
}
rs_unhold :: (r: [] Rs) { if r[0].held { u := fs_unlock(); r[0].held = false; } }
// The browser is gone or does not answer: its keeper stops when the state goes. The
// caller falls back to cdp_launch.
rs_drop :: (c: [] Cdp, r: [] Rs) {
  p: [1300] u8;
  cdp_shut(c);
  gone := fs_remove(rs_path(r, "state", p[..]));
  rs_unhold(r);
}
// Connects c to the page the last call left, its world's loop on again. False when
// there is none (c is then not connected).
rs_kept :: (c: [] Cdp, r: [] Rs) -> bool {
  p: [1300] u8; text: [RS_STATE] u8;
  n := fs_read(rs_path(r, "page", p[..]), text[..]);
  while n > 0 && text[n - 1] <= ' ' { n -= 1; }
  if n <= 0 || !cdp_ws_parts(cast(string) text[0..<n]).ok { return false; }
  if !cdp_connect(c, cast(string) text[0..<n]) || cdp_evaluate(c, RS_RESUME_JS) < 0 { cdp_shut(c); c[0].err_n = 0; return false; }
  return true;
}
// Connects c to the browser itself and closes every page a call left (each in its own
// browser context). False when the browser does not answer.
RS_CONTEXTS :: 32;
rs_clear :: (c: [] Cdp, r: [] Rs) -> bool {
  p: [1300] u8;
  gone := fs_remove(rs_path(r, "page", p[..]));
  if !cdp_connect(c, cast(string) r[0].browser[0..<r[0].browser_n]) { return false; }
  got := cdp_call(c, "Target.getBrowserContexts", "", CDP_IO_MS * 2);
  if got < 0 { return false; }
  ids: [RS_CONTEXTS * 64] u8; lens: [RS_CONTEXTS] int; count := 0;
  d := cdp_doc(c);
  list := jv_get(d, got, "browserContextIds");
  for i: 0..<jv_len(d, list) {
    if count >= RS_CONTEXTS { break; }
    n := jv_str(d, jv_at(d, list, i), ids[count * 64..<count * 64 + 64]);
    if n > 0 { lens[count] = n; count += 1; }
  }
  params: [256] u8;
  for i: 0..<count {
    o: [1] Jo; jo_start(o[..], params[..]);
    jo_obj(o[..]); jo_key(o[..], "browserContextId"); jo_str(o[..], cast(string) ids[i * 64..<i * 64 + lens[i]]); jo_end(o[..]);
    closed := cdp_call(c, "Target.disposeBrowserContext", jo_text(o[..]), CDP_IO_MS * 2);
  }
  c[0].err_n = 0;
  return true;
}
// Closes every page an earlier call left and connects c to a new blank page, w x h, in
// a new browser context. False when the browser fails (cdp_error): the caller calls
// rs_drop and falls back.
rs_fresh :: (c: [] Cdp, r: [] Rs, w: int, h: int) -> bool {
  p: [1300] u8;
  page := rs_path(r, "page", p[..]);
  if !rs_clear(c, r) { return false; }
  params: [256] u8;
  made := cdp_call(c, "Target.createBrowserContext", "", CDP_IO_MS * 2);
  ctx: [64] u8;
  cn := ifx made < 0 then -1 else jv_str(cdp_doc(c), jv_get(cdp_doc(c), made, "browserContextId"), ctx[..]);
  if cn <= 0 { return cdp_fail(c, "the resident browser made no browser context", ""); }
  o: [1] Jo; jo_start(o[..], params[..]);
  jo_obj(o[..]); jo_key(o[..], "url"); jo_str(o[..], "about:blank"); jo_key(o[..], "browserContextId"); jo_str(o[..], cast(string) ctx[0..<cn]);
  jo_key(o[..], "newWindow"); jo_bool(o[..], true); jo_key(o[..], "width"); jo_int(o[..], w); jo_key(o[..], "height"); jo_int(o[..], h); jo_end(o[..]);
  tab := cdp_call(c, "Target.createTarget", jo_text(o[..]), CDP_IO_MS * 2);
  id: [64] u8;
  tn := ifx tab < 0 then -1 else jv_str(cdp_doc(c), jv_get(cdp_doc(c), tab, "targetId"), id[..]);
  if tn <= 0 { return cdp_fail(c, "the resident browser made no page", ""); }
  url: [256] u8;
  k := ws_put(url[..], 0, "ws://127.0.0.1:"); k = ws_digits(url[..], k, r[0].port); k = ws_put(url[..], k, "/devtools/page/"); k = ws_put(url[..], k, cast(string) id[0..<tn]);
  if k < 0 || !cdp_connect(c, cast(string) url[0..<k]) { return false; }
  wrote := fs_write(page, cast(string) url[0..<k]);
  return cdp_evaluate(c, "1") >= 0;
}
// Lets go of the browser. With leave, the page stays as it is for the next call (--keep),
// its world's loop off; without, the page is closed, so an idle browser holds no world.
rs_release :: (c: [] Cdp, r: [] Rs, leave: bool) {
  if leave { if c[0].h >= 0 { v := cdp_evaluate(c, RS_PAUSE_JS); } }
  else { cleared := rs_clear(c, r); }
  q: [1300] u8;
  touched := fs_write(rs_path(r, "used", q[..]), "1");
  if c[0].h >= 0 { sent := cdp_frame(c, WS_OP_CLOSE, ""); }
  cdp_shut(c);
  rs_unhold(r);
}
// Stops the checkout's resident browser, if one runs (its keeper sees the state go).
rs_stop :: (r: [] Rs) -> bool {
  if !rs_dir(r) { return false; }
  p: [1300] u8;
  state := rs_path(r, "state", p[..]);
  had := fs_exists(state);
  gone := fs_remove(state);
  return had;
}

rs_spawn_keeper :: (dir: string) -> bool {
  self: [4096] u8;
  n := cxproc_self_path(self[..]);
  if n <= 0 { return false; }
  h := proc_new();
  ok := h >= 0 && proc_arg(h, cast(string) self[0..<n]) && proc_arg(h, "--keeper") && proc_arg(h, dir) && proc_quiet(h) && proc_detach(h);
  started := ok && proc_start(h) == 0;
  released := proc_release(h);
  return started;
}

// The keeper (`shot --keeper DIR`): starts the browser on DIR/profile, writes DIR/state,
// and stops the browser when the checkout has made no call for idle_default_ms
// (SHOT_RESIDENT_IDLE_S seconds, when set), when the state
// is removed, or when Chrome quits. 0 when another keeper already runs.
rs_keeper :: (dir: string, idle_default_ms: int) -> int {
  p: [1300] u8; q: [1300] u8; t: [1300] u8;
  given: [32] u8;
  secs := args_whole(proc_getenv("SHOT_RESIDENT_IDLE_S", given[..]));
  idle_ms := ifx secs > 0 then secs * 1000 else idle_default_ms;
  if !fs_mkdir(dir) || !fs_try_lock(fs_join(dir, "keeper.lock", p[..])) { return 0; }
  c: [1] Cdp;
  if !cdp_launch_at(c[..], 1440, 900, fs_join(dir, "profile", p[..]), true) { u := fs_unlock(); return 1; }
  text: [RS_STATE] u8;
  k := ws_digits(text[..], 0, c[0].port); k = ws_put(text[..], k, "\n"); k = ws_put(text[..], k, cdp_browser_url(c[..])); k = ws_put(text[..], k, "\n");
  state := fs_join(dir, "state", q[..]); tmp := fs_join(dir, "state.new", t[..]);
  cdp_shut(c[..]);
  used := fs_join(dir, "used", p[..]);
  touched := fs_write(used, "1");
  if k < 0 || cdp_browser_url(c[..]).count == 0 || !fs_write(tmp, cast(string) text[0..<k]) || !fs_rename(tmp, state) { cdp_close(c[..]); u := fs_unlock(); return 1; }
  seen := fs_mtime_ns(used); since := proc_now_ms();
  while true {
    proc_sleep(1000);
    if proc_wait(c[0].proc, 0) != PROC_RUNNING { break; }
    if !fs_exists(state) { break; }
    m := fs_mtime_ns(used);
    if m != seen { seen = m; since = proc_now_ms(); }
    if proc_now_ms() - since >= idle_ms { break; }
  }
  // only this keeper's state goes: a newer keeper may have written its own
  now: [RS_STATE] u8;
  n := fs_read(state, now[..]);
  if n == k && cast(string) now[0..<n] == cast(string) text[0..<k] { gone := fs_remove(state); }
  cdp_close(c[..]);
  u := fs_unlock();
  return 0;
}

// A small picture of the page into out (RGBA): its bytes, or -1.
rs_look :: (c: [] Cdp, r: [] Rs, w: int, h: int, out: [] u8) -> int {
  params: [256] u8; o: [1] Jo;
  jo_start(o[..], params[..]);
  jo_obj(o[..]); jo_key(o[..], "format"); jo_str(o[..], "png"); jo_key(o[..], "optimizeForSpeed"); jo_bool(o[..], true);
  jo_key(o[..], "clip"); jo_obj(o[..]); jo_key(o[..], "x"); jo_int(o[..], 0); jo_key(o[..], "y"); jo_int(o[..], 0);
  jo_key(o[..], "width"); jo_int(o[..], w); jo_key(o[..], "height"); jo_int(o[..], h); jo_key(o[..], "scale"); jo_raw(o[..], "0.125"); jo_end(o[..]);
  jo_end(o[..]);
  n := cdp_screenshot_with(c, jo_text(o[..]), r[0].png[..]);
  if n <= 0 { return -1; }
  info := png_info(r[0].png[0..<n]);
  if info.status != PNG_OK || info.w * info.h * 4 > out.count || info.work > r[0].work.count { return -1; }
  if png_decode(r[0].png[0..<n], r[0].work[..], out[0..<info.w * info.h * 4]) != PNG_OK { return -1; }
  return info.w * info.h * 4;
}
// Waits until the page is ready for its picture (rs_quiet: it stands still for `still`
// looks, or moves steadily), looking at a small picture of it every RS_LOOK_MS. It never
// waits longer than cap_ms (a fixed wait's length).
// r.settled says whether the page went quiet, r.settled_ms how long this took.
RS_LOOK_MS :: 200; RS_LOOK_GAP_MS :: 20;
rs_settle :: (c: [] Cdp, r: [] Rs, w: int, h: int, cap_ms: int, still: int) {
  start := proc_now_ms();
  r[0].samples = 0; r[0].settled = false;
  word: [64] u8; last: [64] u8; last_n := -1;
  have := [2] int.[-1, -1]; q: RsQuiet;
  while proc_now_ms() - start < cap_ms {
    began := proc_now_ms();
    n := media_value(c, RS_BUSY_JS, word[..]);
    busy := ifx n > 0 then cast(string) word[0..<n] else "";
    loaded := last_n >= 0 && busy != cast(string) last[0..<last_n];
    waiting := busy.count < 2 || busy[busy.count - 2..<busy.count] != " 0";
    last_n = ifx n > 0 then n else 0;
    for i: 0..<last_n { last[i] = word[i]; }
    at := r[0].samples % 2; prev := 1 - at;
    have[at] = rs_look(c, r, w, h, r[0].look[at][..]);
    near := -1;
    if have[at] > 0 && have[prev] == have[at] { near = rs_changed(r[0].look[prev][0..<have[at]], r[0].look[at][0..<have[at]]); }
    r[0].samples += 1;
    if r[0].trace {
      b: [24] u8; k := ws_digits(b[..], 0, proc_now_ms() - start);
      tool_err("shot: look at "); tool_err(cast(string) b[0..<k]); tool_err(" ms: loading "); tool_err(busy);
      k = ws_digits(b[..], 0, ifx near < 0 then 0 else near); tool_err(", changed "); tool_errln(ifx near < 0 then "-" else cast(string) b[0..<k]);
    }
    q = rs_quiet_next(q, near, loaded, waiting);
    if rs_quiet(q, still) { r[0].settled = true; break; }
    left := cap_ms - (proc_now_ms() - start);
    if left <= 0 { break; }
    // one look every RS_LOOK_MS; a look that took most of that (a busy GPU) is followed at once
    rest := RS_LOOK_MS - (proc_now_ms() - began);
    if rest < RS_LOOK_GAP_MS { rest = RS_LOOK_GAP_MS; }
    proc_sleep(ifx left < rest then left else rest);
  }
  r[0].settled_ms = proc_now_ms() - start;
}

// The page's key: what must be the same for a kept page to be used as it stands.
rs_key :: (mode: string, dark: bool, url: string, out: [] u8) -> string {
  n := ws_put(out, 0, mode); n = ws_put(out, n, ifx dark then " dark " else " light "); n = ws_put(out, n, url);
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
rs_call_js :: (name: string, key: string, out: [] u8) -> string {
  o: [1] Jo; jo_start(o[..], out);
  jo_put(o[..], "(globalThis."); jo_put(o[..], name); jo_put(o[..], " ? globalThis."); jo_put(o[..], name); jo_put(o[..], "(");
  jo_quoted(o[..], key); jo_put(o[..], ") : 'other')");
  return ifx o[0].bad then "" else jo_text(o[..]);
}
// Whether the loaded page is the one with this key, its files unchanged on the server.
rs_same :: (c: [] Cdp, key: string) -> bool {
  js: [70000] u8; word: [64] u8;
  call := rs_call_js("coaxShotCheck", key, js[..]);
  if call.count == 0 { return false; }
  n := media_value(c, call, word[..]);
  return n == 4 && cast(string) word[0..<4] == "same";
}
// Keeps the loaded page's key and its files' signatures, for rs_same on a later call.
rs_note :: (c: [] Cdp, key: string) -> bool {
  js: [70000] u8;
  if cdp_evaluate(c, RS_LIB_JS) < 0 { return false; }
  call := rs_call_js("coaxShotNote", key, js[..]);
  return call.count > 0 && cdp_evaluate(c, call) >= 0;
}

// ---- a shot on the resident browser ------------------------------------------

// Where a shot's time went, in ms (shot --times prints them).
RsTimes :: struct { kept: bool; page: int; ready: int; settle: int; settled: bool; samples: int; script: int; capture: int; note: int; }

// media_shot on the resident browser: the same steps and the same MediaShot. With keep,
// the page the last call left is used as it stands when it is this URL with unchanged
// files (t.kept); otherwise the URL loads in a new page. With exact, the waits are
// media_shot's fixed ones (o.wait after the page is ready, 500 ms after the script);
// without it they end as soon as the page is quiet (rs_settle), and are never longer.
// Status 1 with c not connected: the browser failed, and the caller falls back.
rs_shot :: (c: [] Cdp, r: [] Rs, url: string, out: string, wh: ArgsSize, o: MediaShotOptions, keep: bool, exact: bool, value: [] u8, build: [] u8, t: [] RsTimes) -> MediaShot {
  s: MediaShot;
  kb: [66000] u8;
  key := rs_key("shot", o.dark, url, kb[..]);
  if key.count == 0 { s.status = 2; return s; }
  t0 := proc_now_ms();
  t[0].kept = keep && rs_kept(c, r) && media_size(c, wh) && media_scheme(c, o.dark) && rs_same(c, key);
  if !t[0].kept {
    if !rs_fresh(c, r, wh.w, wh.h) { cdp_shut(c); s.status = 1; return s; }
    if !media_size(c, wh) || !media_scheme(c, o.dark) { s.status = 1; return s; }
  }
  focus := cdp_call(c, "Emulation.setFocusEmulationEnabled", "{\"enabled\":true}", CDP_CALL_MS);
  t[0].page = proc_now_ms() - t0;
  if !t[0].kept {
    params: [65536] u8; j: [1] Jo;
    jo_start(j[..], params[..]); jo_obj(j[..]); jo_key(j[..], "url"); jo_str(j[..], url); jo_end(j[..]);
    if j[0].bad { s.status = 2; return s; }
    if cdp_call(c, "Page.navigate", jo_text(j[..]), CDP_CALL_MS) < 0 { s.status = 1; return s; }
    start := proc_now_ms(); idle_from := -1;
    word: [512] u8;
    while true {
      n := media_value(c, MEDIA_READY_JS, word[..]);
      status := ifx n > 0 then cast(string) word[0..<n] else "";
      now := proc_now_ms();
      if status == "idle" { if idle_from < 0 { idle_from = now; } } else { idle_from = -1; }
      step := media_ready_step(status, now - start, ifx idle_from < 0 then 0 else now - idle_from, o.ready_ms);
      s.waited_ms = now - start;
      if step == MEDIA_READY { break; }
      if step == MEDIA_TIMEOUT { s.status = 4; return s; }
      if step == MEDIA_FAILED {
        said := ifx status.count > 7 then status[7..<status.count] else "";
        s.value_n = ifx said.count <= value.count then said.count else value.count;
        for i: 0..<s.value_n { value[i] = said[i]; }
        s.status = 5; return s;
      }
      if c[0].h < 0 { s.status = 1; return s; }
      proc_sleep(RS_READY_POLL_MS);
    }
    t[0].ready = s.waited_ms;
    t1 := proc_now_ms();
    if exact { proc_sleep(o.wait); } else { rs_settle(c, r, wh.w, wh.h, o.wait, RS_SETTLE_LOOKS); t[0].settled = r[0].settled; t[0].samples = r[0].samples; }
    t[0].settle = proc_now_ms() - t1;
  } else {
    drawn := cdp_evaluate(c, RS_FRAMES_JS);
  }
  if o.guard.count > 0 {
    v := cdp_evaluate(c, o.guard);
    if jv_kind(cdp_doc(c), v) != JV_TRUE { s.status = 6; return s; }
  }
  if o.script.count > 0 {
    t2 := proc_now_ms();
    s.value_n = media_value(c, o.script, value);
    if exact { proc_sleep(500); } else { drawn := cdp_evaluate(c, RS_FRAMES_JS); rs_settle(c, r, wh.w, wh.h, 500, 1); }
    t[0].script = proc_now_ms() - t2;
  }
  bn := media_value(c, MEDIA_BUILD_JS, build);
  s.build_n = ifx bn > 0 then bn else 0;
  t3 := proc_now_ms();
  png: [MEDIA_PNG] u8;
  // the same pixels as media_shot's PNG, compressed less: Chrome spends a tenth of the time on it
  n := cdp_screenshot_with(c, "{\"format\":\"png\",\"optimizeForSpeed\":true}", png[..]);
  if n == 0 { n = cdp_screenshot_with(c, "{\"format\":\"png\",\"optimizeForSpeed\":true}", png[..]); }   // a busy GPU now and then answers with no picture
  if n <= 0 { s.status = 1; return s; }
  if !fs_write(out, cast(string) png[0..<n]) { s.status = 3; return s; }
  t[0].capture = proc_now_ms() - t3;
  t4 := proc_now_ms();
  if keep && !t[0].kept { noted := rs_note(c, key); }
  t[0].note = proc_now_ms() - t4;
  return s;
}
RS_READY_POLL_MS :: 50;
RS_SETTLE_LOOKS :: 2;   // looks in a row without a changed pixel before a loaded page is taken

// ---- a clip on the resident browser -------------------------------------------

// Connects c to the page for a clip of url: the page the last call left when keep asks
// for it and it is this clip's page with unchanged files (true in kept[0]: the recording
// goes on from where that page stands), else a new blank page. False: the browser failed.
rs_clip_page :: (c: [] Cdp, r: [] Rs, mode: string, url: string, wh: ArgsSize, keep: bool, kept: [] bool) -> bool {
  kb: [66000] u8;
  key := rs_key(mode, false, url, kb[..]);
  kept[0] = keep && key.count > 0 && rs_kept(c, r) && rs_same(c, key);
  if kept[0] { return true; }
  return rs_fresh(c, r, wh.w, wh.h);
}
// After a clip recorded with keep: keeps the page's key and files for the next call.
rs_clip_note :: (c: [] Cdp, mode: string, url: string) {
  kb: [66000] u8;
  key := rs_key(mode, false, url, kb[..]);
  if key.count > 0 { noted := rs_note(c, key); }
}
