// Independent bounded lanes for platform HTTP effects. The SDK moves one
// datagram per offer and one complete response; Coax owns admission/retirement.
#authority;
BG_LANES::7;
BG_CONTROL::0;BG_WORLD::1;BG_VITALS::2;BG_CHECKPOINT::3;BG_DIRECTORY::4;BG_STATS::5;BG_MOD::6;
BG_DEADLINE::15000;
BgFlight::struct{id:int;at:int;revision:int;}
BgBudget::struct{
  slot:[BG_LANES]BgFlight;retry_at:[BG_LANES]int;next:int;
  offered:int;refused:int;expired:int;late:int;failed:int;
  world_needed:bool=true;world_revision:int=1;world_retired:bool;
}
#test "background lanes reserve independently and refuse an occupied lane" {
  b:[1]BgBudget;
  for k:0..<BG_LANES{#assert bg_offer(b[..],k,100)==k+1;}
  #assert bg_offer(b[..],0,101)==0&&b[0].refused==1&&b[0].offered==7;
  #assert !bg_ready(b[..],0,15099)&&bg_ready(b[..],0,15100);
  #assert bg_offer(b[..],0,15100)==8&&b[0].expired==1;
  #assert !bg_finish(b[..],0,1,true,15100)&&b[0].late==1;
  #assert bg_finish(b[..],0,8,false,15100)&&b[0].failed==1;
  #assert !bg_ready(b[..],0,16099)&&bg_offer(b[..],0,16100)==9;
  for k:1..<BG_LANES{#assert b[0].slot[k].id==k+1;}
}
#test "background admission rejects invalid clocks lanes and exhausted identity without changing owners" {
  b:[1]BgBudget;#assert !bg_ready(b[..],-1,0)&&!bg_ready(b[..],7,0)&&!bg_ready(b[..],0,-1);
  #assert bg_offer(b[..],-1,0)==0&&bg_offer(b[..],7,0)==0&&bg_offer(b[..],0,-1)==0;
  #assert !bg_finish(b[..],-1,1,true,0)&&!bg_finish(b[..],7,1,true,0)&&!bg_finish(b[..],0,0,true,0);
  #assert bg_offer(b[..],0,300)==1&&!bg_ready(b[..],0,299);
  b[0].next=9223372036854775807;#assert bg_offer(b[..],1,300)==0&&b[0].slot[1].id==0;
  #assert !bg_finish(b[..],0,1,true,299)&&b[0].slot[0].id==1&&b[0].late==4;
  #assert bg_finish(b[..],0,1,true,300)&&b[0].slot[0].id==0&&b[0].failed==0;
}
#test "a late response cannot apply after its deadline even without a replacement offer" {
  b:[1]BgBudget;id:=bg_offer(b[..],0,0);
  #assert bg_finish(b[..],0,id,true,14999);
  id=bg_offer(b[..],0,15000);#assert !bg_finish(b[..],0,id,true,30000)&&b[0].expired==1&&b[0].slot[0].id==0;
  #assert bg_offer(b[..],0,30000)==3;
}
#test "world responses cover only the requested publication and failed fetches keep retrying" {
  b:[1]BgBudget;#assert b[0].world_needed&&b[0].world_revision==1;
  id:=bg_offer(b[..],BG_WORLD,0);bg_world_changed(b[..]);
  #assert !bg_finish(b[..],BG_WORLD,id,true,0)&&b[0].world_needed&&b[0].late==1;
  id=bg_offer(b[..],BG_WORLD,1);#assert bg_finish(b[..],BG_WORLD,id,false,1)&&b[0].world_needed;
  id=bg_offer(b[..],BG_WORLD,1001);#assert bg_finish(b[..],BG_WORLD,id,true,1001)&&!b[0].world_needed;
  bg_world_changed(b[..]);#assert b[0].world_needed&&b[0].world_revision==3;
  b[0].world_revision=9223372036854775806;bg_world_changed(b[..]);#assert b[0].world_revision==9223372036854775807&&!b[0].world_retired;
  id=bg_offer(b[..],BG_WORLD,1002);bg_world_changed(b[..]);#assert b[0].world_retired&&b[0].world_needed;
  #assert !bg_finish(b[..],BG_WORLD,id,true,1002)&&b[0].world_needed&&bg_offer(b[..],BG_WORLD,1003)==0;
}
bg_ready::(b:[]BgBudget,k:int,now:int)->bool #export_c #effects(all) {
  if k<0||k>=BG_LANES||now<0{return false;}
  f:=b[0].slot[k];return now>=b[0].retry_at[k]&&(f.id==0||now-f.at>=BG_DEADLINE);
}
bg_offer::(b:[]BgBudget,k:int,now:int)->int #export_c #effects(all) {
  if !bg_ready(b,k,now)||b[0].next==9223372036854775807||(k==BG_WORLD&&b[0].world_retired){b[0].refused+=1;return 0;}
  if b[0].slot[k].id!=0{b[0].expired+=1;}
  b[0].next+=1;b[0].offered+=1;
  b[0].slot[k]=BgFlight.{id=b[0].next,at=now,revision=b[0].world_revision};return b[0].next;
}
bg_finish::(b:[]BgBudget,k:int,id:int,ok:bool,now:int)->bool #export_c #effects(all) {
  if k<0||k>=BG_LANES||id<=0||b[0].slot[k].id!=id{b[0].late+=1;return false;}
  if now<b[0].slot[k].at{b[0].late+=1;return false;}
  if now-b[0].slot[k].at>=BG_DEADLINE{b[0].expired+=1;b[0].slot[k]=BgFlight.{};return false;}
  if !ok{b[0].failed+=1;b[0].retry_at[k]=now+1000;}
  if ok&&k==BG_WORLD{
    if b[0].world_retired||b[0].slot[k].revision!=b[0].world_revision{b[0].late+=1;b[0].slot[k]=BgFlight.{};return false;}
    b[0].world_needed=false;
  }
  b[0].slot[k]=BgFlight.{};return true;
}
bg_world_changed::(b:[]BgBudget) #export_c #effects(all) {
  b[0].world_needed=true;
  if b[0].world_revision==9223372036854775807{b[0].world_retired=true;}else{b[0].world_revision+=1;}
}
