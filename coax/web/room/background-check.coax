}

BcPage::struct{c:[1]RelayConn;m:[1]WireMirror;seat:int=-1;seq:int;frames:int;tick:int;last:int;gap:int;busy:int;closed:bool;observe:bool;pets:int;zones:int;raiders:int;break_frames:int;raid_cast_frames:int;}
bc_open::(p:[]BcPage,port:int,room:string,pid:string)->bool{
  return bc_open_on(p,port,"/api/room/relay/everglade/",room,pid);
}
bc_open_on::(p:[]BcPage,port:int,path:string,room:string,pid:string)->bool{
  return bc_open_as(p,port,path,room,pid,false);
}
bc_open_as::(p:[]BcPage,port:int,path:string,room:string,pid:string,wl:bool)->bool{
  ticket:[256]u8;n:=tk_sign_admin_on("local-development-room-ticket-key-not-a-secret",pid,"Overload",room,0,cxproc_wall_us()/1000+180000,ticket[..]);
  url:[1]BcText;bc_s(url[..],"ws://localhost:");bc_i(url[..],port);bc_s(url[..],path);bc_s(url[..],room);bc_s(url[..],"?t=");bc_s(url[..],cast(string)ticket[0..<n]);
  if n<=0||!relay_conn_open(p[0].c[..],bc_text(url[..])){return false;}b:[64]u8;ignored_16:=relay_conn_send(p[0].c[..],cast(string)b[0..<wire_put_pins(b[..],0,WirePins.{})]);
  return relay_conn_send(p[0].c[..],ifx wl then "H 4 ranger.0.0.0 warlock 64 Overload" else "H 4 ranger.0.0.0 druid 64 Overload");
}
bc_observe::(p:[]BcPage,text:string){
  pets:=0;zones:=0;raiders:=0;for e:0..<WIRE_MIRROR{w:=wire_mirror_get(p[0].m[..],e);if w.id<0{continue;}
    if w.kind==WK_BEAST&&w.p1==1&&w.owner>=0&&w.hp>0{pets+=1;}
    if w.kind==WK_ZONE{zones+=1;}if w.kind==WK_BEAST&&w.p1>=27{raiders+=1;}}
  if pets>p[0].pets{p[0].pets=pets;}if zones>p[0].zones{p[0].zones=zones;}if raiders>p[0].raiders{p[0].raiders=raiders;}
  if bc_has(text,"e break "){p[0].break_frames+=1;}if bc_has(text,"e rc "){p[0].raid_cast_frames+=1;}
}
bc_poll::(p:[]BcPage,measure:bool){
  code:=relay_conn_poll(p[0].c[..],0);while code==RC_TEXT{text:=cast(string)p[0].c[0].text[0..<p[0].c[0].text_n];
    if rs_starts(text,"y "){p[0].seat=rs_num(rs_field(text,1));}
    if rs_starts(text,"r ")&&bc_has(text,"busy"){p[0].busy+=1;}
    if rs_starts(text,"D "){d:=wire_mirror_frame(p[0].m[..],text);if p[0].observe{bc_observe(p,text);}if d.tick>p[0].tick{now:=rs_now();if measure&&p[0].last>0&&now-p[0].last>p[0].gap{p[0].gap=now-p[0].last;}p[0].last=now;p[0].frames+=1;p[0].tick=d.tick;}}
    code=relay_conn_poll(p[0].c[..],0);
  }if code==RC_FAIL||code==RC_CLOSED{p[0].closed=true;}
}
bc_input::(p:[]BcPage){if p[0].closed{return;}p[0].seq+=1;b:[128]u8;n:=wire_put_in(b[..],0,WireIn.{seq=p[0].seq,kx=30,heard=p[0].m[0].heard});ignored_17:=relay_conn_send(p[0].c[..],cast(string)b[0..<n]);}
bc_still::(p:[]BcPage){if p[0].closed{return;}p[0].seq+=1;b:[128]u8;n:=wire_put_in(b[..],0,WireIn.{seq=p[0].seq,heard=p[0].m[0].heard});ignored_still:=relay_conn_send(p[0].c[..],cast(string)b[0..<n]);}
bc_cast::(p:[]BcPage,slot:int,x:f32,z:f32){if p[0].closed{return;}p[0].seq+=1;b:[128]u8;n:=wire_put_cast(b[..],0,WireCast.{seq=p[0].seq,slot=slot,ax=x,ay=2,az=z,tgt= -1});ignored_cast:=relay_conn_send(p[0].c[..],cast(string)b[0..<n]);}
bc_get::(port:int,path:string,out:[]u8)->int{url:[1]BcText;bc_s(url[..],"http://127.0.0.1:");bc_i(url[..],port);bc_s(url[..],path);w:[1]HttpWork;none:[1]string;r:=http_do(w[..],"GET",bc_text(url[..]),none[0..<0],"",300,0,out);return ifx r.code==200 then r.n else -1;}
bc_env::(name:string,port:int,path:string,out:[]BcText)->string{bc_s(out,name);bc_s(out,"=http://127.0.0.1:");bc_i(out,port);bc_s(out,path);return bc_text(out);}

// Ten real gameplay sockets: eight mixed casters, an independent moving room,
// and a consumer which stops reading/acknowledging for 35 seconds. This last
// case qualifies state-age recovery; kernel send-pressure has its own probe.
bc_stress::(dir:string,port:int,room:int,secs:int)->int{
  p:[10]BcPage;opened:=true;for i:0..<10{pid:[48]u8;n:=rs_put(pid[..],0,"stress-");n=rs_int(pid[..],n,i);
    opened=bc_open_as(p[i..<i+1],port,"/api/room/relay/everglade/",ifx i==8 then "pair-stress-healthy" else "pair-stress-busy",cast(string)pid[0..<n],i<8&&i%2==1)&&opened;}
  p[0].observe=true;start:=rs_now();next:=start;cast_at:=start+2200;health_at:=start;cast_round:=0;casts:=0;bad:=0;health_ok:=0;pending_max:=0;burst:=false;slow_before:=0;slow_after:=0;out:[16384]u8;
  stalled:=false;released:=false;publication:=false;slow_rejoined:=false;slow_closed:=0;waiting_max:=0;
  while opened&&rs_now()-start<secs*1000{now:=rs_now();age:=now-start;
    for i:0..<10{if i!=9||age<15000||age>=50000{bc_poll(p[i..<i+1],age>2000);}}
    if age>=50000&&!slow_rejoined&&p[9].closed{slow_closed+=1;ignored_slow_release:=relay_conn_close(p[9].c[..],1000);p[9]=BcPage.{};slow_rejoined=bc_open_as(p[9..<10],port,"/api/room/relay/everglade/","pair-stress-busy","stress-9",false);}
    if age>=15000&&slow_before==0{slow_before=p[9].tick;}if age>=55000&&slow_after==0{slow_after=p[9].tick;}
    if !stalled&&age>=20000{stalled=bc_file(dir,"mode","stall");}
    if !released&&age>=55000{released=bc_file(dir,"mode","healthy");}
    if !publication&&age>=60000{publication=bc_file(dir,"mode","publication");}
    if now>=next{next=now+33;for i:0..<8{bc_still(p[i..<i+1]);}bc_input(p[8..<9]);if age<15000||age>=50000{bc_still(p[9..<10]);}}
    if now>=cast_at{cast_at=now+600;
      for i:0..<8{slot:=ifx i%2==1 then (ifx cast_round<4 then 65 else 64) else 2;
        if cast_round==0&&i%2==0{slot=ifx i<4 then 32 else 20;}
        // Conjure/area targets are near the stationary owners; physical blasts
        // hit the actual south-gate wall. Accepted entities are observed below.
        me:=wire_mirror_of(p[i].m[..],p[i].seat);near:=cast_round==0&&i%2==0;
        if near{print("stress initial: actor=% seat=% position=%/% slot=%\n",i,p[i].seat,me.x,me.z,slot);}
        // Keep the summoned wolves out of the simultaneous friendly Moonbeams.
        near_x:=me.x+(ifx i<4 then -9.0f32 else 9.0f32);
        bc_cast(p[i..<i+1],slot,ifx near then near_x else 0,ifx near then me.z+4 else -56);casts+=1;}
      cast_round+=1;}
    if !burst&&age>=12000{for i:0..<64{bc_cast(p[0..<1],2,0,-56);}burst=true;casts+=64;}
    if now>=health_at{health_at=now+500;n:=bc_get(port,"/health",out[..]);if n<=0{bad+=1;}else{health_ok+=1;s:=cast(string)out[0..<n];mark:="background pending ";
      for q:0..<s.count-mark.count+1{if s[q..<q+mark.count]==mark{v:=rs_num(s[q+mark.count..<s.count]);if v>pending_max{pending_max=v;}}}
      wait_mark:="waiting ";for q:0..<s.count-wait_mark.count+1{if s[q..<q+wait_mark.count]==wait_mark{v:=rs_num(s[q+wait_mark.count..<s.count]);if v>waiting_max{waiting_max=v;}}}}}
    ignored_stress_line:=proc_line(room,0,out[..]);proc_sleep(2);
  }
  ignored_healthy_fixture:=bc_file(dir,"mode","publication");until:=rs_now()+12000;recovered:=false;
  while opened&&rs_now()<until{for i:0..<10{bc_poll(p[i..<i+1],false);}n:=bc_get(port,"/health",out[..]);if n>0&&bc_has(cast(string)out[0..<n],"background pending 0/6"){recovered=true;break;}proc_sleep(20);}
  n:=bc_get(port,"/health",out[..]);if n>0{print("stress health:\n%",cast(string)out[0..<n]);}
  busy:=0;closed:=0;for i:0..<10{busy+=p[i].busy;if p[i].closed{closed+=1;}ignored_stress_close:=relay_conn_close(p[i].c[..],1000);}
  print("stress: seconds=% opened=% casts_sent=% busy=% peak_pets=% peak_zones=% peak_raiders=% break_frames=% raid_cast_frames=%\n",secs,opened,casts,busy,p[0].pets,p[0].zones,p[0].raiders,p[0].break_frames,p[0].raid_cast_frames);
  print("stress: healthy_frames=% healthy_gap_max_ms=% slow_tick_before=% slow_tick_after=% slow_closed=% slow_rejoined=% waiting_max_bytes=% closed=% health_ok=% health_failed=% pending_max=%/6 recovered=% publication=%\n",p[8].frames,p[8].gap,slow_before,slow_after,slow_closed,slow_rejoined,waiting_max,closed,health_ok,bad,pending_max,recovered,publication);
  return ifx opened&&burst&&stalled&&released&&publication&&recovered&&bad==0&&health_ok>100&&pending_max>0&&pending_max<=6&&p[8].frames>secs*20&&p[8].gap<250&&closed==0&&slow_after>slow_before+30&&busy>0&&p[0].pets>=4&&p[0].zones>=1&&p[0].raiders>=6&&p[0].break_frames>0&&p[0].raid_cast_frames>0 then 0 else 1;
}
// One extra process owns the sixteenth gameplay socket. The parent's sixteen
// SDK slots retain room for HTTP health probes; the socket contract is unchanged.
bc_peer::(port:int,room:string,secs:int)->int{
  if port<1024||secs<1||secs>90{return 2;}p:[1]BcPage;
  if !bc_open(p[..],port,room,room){return 1;}start:=rs_now();next:=start;
  while rs_now()-start<secs*1000{bc_poll(p[..],true);if rs_now()>=next{bc_input(p[..]);next=rs_now()+33;}proc_sleep(2);}
  ok:=p[0].frames>secs*20&&!p[0].closed;ignored_peer:=relay_conn_close(p[0].c[..],1000);
  print("warm peer: frames=% gap_ms=% closed=%\n",p[0].frames,p[0].gap,p[0].closed);return ifx ok then 0 else 1;
}

