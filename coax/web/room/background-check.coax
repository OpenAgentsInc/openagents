    connected:=ready&&bc_open_on(p[0..<1],port,startup_paths[1],"pair-startup","startup");until=rs_now()+2000;
    while connected&&p[0].frames==0&&rs_now()<until{bc_poll(p[0..<1],false);proc_sleep(2);}
    if connected{ignored_warm_close:=relay_conn_close(p[0].c[..],1000);}bc_stop(room);ignored_stop_fixture:=bc_file(dir,"stop","1");bc_stop(fixture);ignored_remove_fixture:=fs_remove(dir);
