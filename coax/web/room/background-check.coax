// Actual native HTTP outage and socket isolation check. All services, ports,
// process groups and fixtures belong to this invocation. No production calls.
// coax/web/tool.sh coax/web/room/background-check.coax ROOM_BIN [SECONDS=40]
// coax/web/tool.sh coax/web/room/background-check.coax warm ROOM_BIN [SECONDS=35]
// coax/web/tool.sh coax/web/room/background-check.coax startup ROOM_BIN
// coax/web/tool.sh coax/web/room/background-check.coax stress ROOM_BIN [SECONDS=75]
// tool.sh: tls
#load "room-socket.coax";
#load "../../lib/sys/fs.coax";
#load "../../lib/net/http.coax";

BcText::struct{b:[8192]u8;n:int;}
