  page:[16]BcPage;opened:=ready&&bc_open(page[0..<1],port,"pair-overload", "overload-a")&&bc_open(page[1..<2],port,"pair-healthy","overload-b");
  ignored_21:=bc_file(dir,"mode",ifx warm then "healthy" else "stall");start:=rs_now();next:=start;health_at:=start;bad:=0;pending_max:=0;health_ok:=0;casts:=0;pages:=2;publication:=false;peer:= -1;
  while opened&&rs_now()-start<secs*1000{
    now:=rs_now();local_pages:=ifx pages==16 then 15 else pages;for i:0..<local_pages{bc_poll(page[i..<i+1],now-start>2000);}
    if warm&&pages<16&&now-start>=pages*1000{b:[64]u8;n:=rs_put(b[..],0,"pair-warm-");n=rs_int(b[..],n,pages);
      if pages==15{
        seconds:[24]u8;sn:=rs_int(seconds[..],0,secs-(now-start)/1000);
        peer_args:=[5]string.[cast(string)exe[0..<en],"peer",cast(string)pb[0..<pn],cast(string)b[0..<n],cast(string)seconds[0..<sn]];
        peer=bc_start(peer_args[..],none[0..<0]);if peer>=0{pages+=1;}else{bad+=1;}
      }else{if bc_open(page[pages..<pages+1],port,cast(string)b[0..<n],cast(string)b[0..<n]){pages+=1;}else{bad+=1;}}
    }
    if warm&&!publication&&now-start>=18000{publication=bc_file(dir,"mode","publication");}
    if now>=next{next=now+33;for i:0..<local_pages{bc_input(page[i..<i+1]);}
      // Area casts and pet summons in one room while another keeps walking.
      if casts<150&&page[0].seq%6==0{b:[128]u8;n:=wire_put_cast(b[..],0,WireCast.{seq=page[0].seq,slot=ifx casts%3==0 then 32 else 0,ax=0,ay=2,az= -84,tgt= -1});ignored_22:=relay_conn_send(page[0].c[..],cast(string)b[0..<n]);casts+=1;}
    }
    if now>=health_at{health_at=now+500;n:=bc_get(port,"/health",out[..]);if n<=0{bad+=1;}else{health_ok+=1;s:=cast(string)out[0..<n];
      mark:="background pending ";for q:0..<s.count-mark.count+1{if s[q..<q+mark.count]==mark{pending:=rs_num(s[q+mark.count..<s.count]);if pending>pending_max{pending_max=pending;}}}}}
    ignored_23:=proc_line(room,0,out[..]);proc_sleep(2);
  }
  if warm{n:=bc_get(port,"/health",out[..]);if n>0{print("warm native health:\n%",cast(string)out[0..<n]);}}
  ignored_24:=bc_file(dir,"mode",ifx warm then "publication" else "healthy");recovered:=false;until=rs_now()+12000;
  while opened&&rs_now()<until{for i:0..<2{bc_poll(page[i..<i+1],true);}n:=bc_get(port,"/health",out[..]);if n>0&&bc_has(cast(string)out[0..<n],"background pending 0/6"){recovered=true;break;}proc_sleep(20);}
  pub_seen:=bc_read(dir,"world_seen",pb[..])=="2";
  warmed:=true;local_pages:=ifx pages==16 then 15 else pages;
  for i:0..<local_pages{if page[i].frames<30||page[i].closed{warmed=false;}if opened&&!page[i].closed{ignored_25:=relay_conn_close(page[i].c[..],1000);}}
  if peer>=0{exit:=proc_wait(peer,5000);if exit!=0{warmed=false;}line:[4096]u8;got:=proc_line(peer,0,line[..]);if got>0{print("%\n",cast(string)line[0..<got]);}if exit==PROC_RUNNING{bc_stop(peer);}else{ignored_peer_release:=proc_release(peer);}}
  bc_stop(room);ignored_26:=bc_file(dir,"stop","1");bc_stop(fixture);ignored_27:=fs_remove(dir);
  print("background native: ready=% opened=% outage_s=% health_ok=% health_failed=% pending_max=%/6 recovered=%\n",ready,opened,secs,health_ok,bad,pending_max,recovered);
  print("background native: busy_room_frames=% healthy_room_frames=% healthy_gap_max_ms=% busy_refusals=% closed=%/%\n",page[0].frames,page[1].frames,page[1].gap,page[0].busy,page[0].closed,page[1].closed);
  if warm{print("warm native: rooms=% publication_requested=% publication_served=% all_streaming=%\n",pages,publication,pub_seen,warmed);}
  return ifx opened&&bad==0&&health_ok>20&&(warm||pending_max>0)&&pending_max<=6&&recovered&&page[1].frames>secs*20&&page[1].gap<250&&!page[1].closed&&(!warm||(pages==16&&publication&&pub_seen&&warmed)) then 0 else 1;
}
