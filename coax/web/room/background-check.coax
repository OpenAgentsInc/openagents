      if path=="/world"{body=cast(string)world[0..<wn];ignored_12:=bc_file(dir,"world_seen",ifx bc_read(dir,"mode",mode[..])=="publication" then "2" else "1");}
      if path=="/control"{body=ifx bc_read(dir,"mode",mode[..])=="publication" then "pvp 0\nedit 2\nlevels 0\n" else "pvp 0\nedit 1\nlevels 0\n";ignored_13:=bc_file(dir,"control_seen","1");}
      if path=="/control"&&stress{event:[1]BcText;bc_s(event[..],body);bc_s(event[..],"event 1 0 3 24 6 1 3 3 31 1 3 1 100 15 ");bc_i(event[..],ifx rs_now()-began>=4000 then 1 else 0);bc_s(event[..]," 0\n");body=bc_text(event[..]);bc_reply(c[0].h,body);c[0].h= -1;continue;}
      bc_reply(c[0].h,body);c[0].h= -1;
    }
  }
