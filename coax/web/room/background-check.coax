        for q:0..<got{c[0].b[c[0].n+q]=cast,trunc(u8)cxsock_byte(c[0].h,q);}c[0].n+=got;}
      text:=cast(string)c[0].b[0..<c[0].n];if c[0].want<0{end:=bc_head(text);if end>=0{c[0].head=end;c[0].want=end+bc_length(text[0..<end]);}}
      if c[0].want<0||c[0].n<c[0].want||stalled{continue;}
