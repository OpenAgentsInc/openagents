  listen:=cxsock_listen(0);if listen<0{return 2;}b:[24]u8;n:=rs_int(b[..],0,cxsock_port(listen));ignored_8:=bc_file(dir,"port",cast(string)b[0..<n]);
  conn:[24]BcHttp;mode:[32]u8;world:[2048]u8;wn:=fs_read("coax/web/room/dev/world-everglade.json",world[..]);if wn<=0{return 2;}
  stop:[4200]u8;stopfile:=fs_join(dir,"stop",stop[..]);scenario:[32]u8;stress:=bc_read(dir,"scenario",scenario[..])=="stress";began:=rs_now();
