// Socket observation only. Exact input sequence matching; no clock sync or
// presentation claim. The last millisecond bucket means 2000 ms or longer.
#authority;
CF_RING::256;CF_HIST::2001;
CfTiming::struct{seq:[CF_RING]int;at:[CF_RING]int;hist:[CF_HIST]int;ack:int;missing:int;backwards:int;}
#test "capacity client timing matches exact input generations without inventing missing clock samples" {
  t:[1]CfTiming;cf_input(t[..],1,100);cf_ack(t[..],1,130);cf_ack(t[..],1,140);
  #assert t[0].hist[30]==1&&t[0].hist[40]==0&&t[0].missing==0&&t[0].ack==1;
  cf_ack(t[..],2,150);#assert t[0].missing==1;
  cf_input(t[..],3,200);cf_ack(t[..],3,199);#assert t[0].backwards==1;
  cf_input(t[..],4,300);cf_input(t[..],4+CF_RING,310);cf_ack(t[..],4,400);#assert t[0].missing==2;
  cf_input(t[..],5,400);cf_ack(t[..],5,2400);#assert t[0].hist[2000]==1;
  h:[CF_HIST]int;#assert cf_quantile(h[..],950)== -1;
  h[10]=5;h[20]=4;h[2000]=1;#assert cf_quantile(h[..],500)==10&&cf_quantile(h[..],950)==2000&&cf_quantile(h[..],1000)==2000;
  #assert cf_quantile(h[..],1)==10&&cf_quantile(h[..],0)== -1&&cf_quantile(h[..],1001)== -1;
  z:[1]CfTiming;z[0].at[0]=77;cf_input(z[..],0,0);#assert z[0].at[0]==77;
  cf_input(z[..],-1,0);cf_input(z[..],6,-1);#assert z[0].seq[6]==0;
  cf_input(z[..],7,0);cf_ack(z[..],7,0);#assert z[0].hist[0]==1&&z[0].backwards==0;
  cf_input(z[..],257,100);#assert z[0].seq[1]==257&&z[0].at[1]==100;
  cf_ack(z[..],257,2101);#assert z[0].hist[2000]==1&&z[0].ack==257;
  h[0]=1000;h[10]=0;h[20]=0;h[2000]=1;#assert cf_quantile(h[..],999)==0&&cf_quantile(h[..],1000)==2000;
  odd:[3]int;odd[1]=1;#assert cf_quantile(odd[..],500)==1;
}
cf_input::(t:[]CfTiming,seq:int,at:int) #effects(all) {if seq<=0||at<0{return;}t[0].seq[seq%CF_RING]=seq;t[0].at[seq%CF_RING]=at;}
cf_ack::(t:[]CfTiming,ack:int,now:int) #effects(all) {
  if ack<=t[0].ack{return;}t[0].ack=ack;k:=ack%CF_RING;
  if t[0].seq[k]!=ack{t[0].missing+=1;return;}
  ms:=now-t[0].at[k];if ms<0{t[0].backwards+=1;return;}
  bucket:=ifx ms>=CF_HIST then CF_HIST-1 else ms;t[0].hist[bucket]+=1;
}
cf_quantile::(h:[]int,q:int)->int #effects(all) {
  if q<1||q>1000{return -1;}n:=0;for count:h{n+=count;}if n==0{return -1;}
  want:=(n*q+999)/1000;i:=0;got:=h[0];while got<want{i+=1;got+=h[i];}return i;
}
