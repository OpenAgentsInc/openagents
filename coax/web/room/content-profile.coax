// The content numbers' profile check (#13286, everglade/model/content-ids.coax,
// docs/protocol/everglade-content-ids-v1.md): proto/verse/everglade-content-ids-v1.json and the
// registry hold the same rows in the same order, the file's hash is the registry's, and the P
// frame's content pin is sealed with it.
//   coax/web/tool.sh coax/web/room/content-profile.coax proto/verse/everglade-content-ids-v1.json
#import "Basic";
#load "../../../everglade/shared/class-kit.coax";
#load "../../../everglade/shared/everglade-wire.coax";
#load "../../lib/sys/tool.coax";
#load "../../lib/sys/fs.coax";
#load "../../lib/json/json.coax";

CP_FILE :: 262144;

cp_text :: (d: Jv, at: int, key: string, out: [] u8) -> string {
  n := jv_str(d, jv_get(d, at, key), out);
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
// How many ways the profile's text differs from the registry (0: none); -1 when it is not the profile.
cp_faults :: (text: string, loud: bool) -> int #effects(all) {
  nodes: [8192] JvNode; d: [1] Jv;
  if !jv_parse(d[..], text, nodes[..]) { return -1; }
  pb: [64] u8;
  if cp_text(d[0], 0, "profile", pb[..]) != "openagents.everglade.content-ids" || jv_int(d[0], jv_get(d[0], 0, "version"), -1) != 1 { return -1; }
  failed := 0;
  kinds := jv_get(d[0], 0, "kinds");
  for k: 1..<CT_KINDS + 1 { if jv_int(d[0], jv_get(d[0], kinds, CT_KIND[k]), -1) != k { failed += 1; if loud { tool_err("content ids: the kind's number: "); tool_errln(CT_KIND[k]); } } }
  if jv_len(d[0], kinds) != CT_KINDS { failed += 1; }
  ids := jv_get(d[0], 0, "ids");
  if jv_len(d[0], ids) != CONTENT_N { failed += 1; if loud { tool_errln("content ids: the file and the registry differ in how many rows"); } }
  row := jv_at(d[0], ids, 0);
  for i: 0..<CONTENT_N {
    if row < 0 { break; }
    kb: [32] u8; sb: [CT_KEY + 8] u8;
    kind := cp_text(d[0], row, "kind", kb[..]); key := cp_text(d[0], row, "key", sb[..]);
    r := CONTENT[i];
    if kind != CT_KIND[r.kind] || key != r.key || jv_int(d[0], jv_get(d[0], row, "id"), -1) != r.id {
      failed += 1; if loud { tool_err("content ids: the file's row is not the registry's: "); tool_errln(r.key); }
    }
    row = d[0].nodes[row].next;
  }
  if jv_int(d[0], jv_get(d[0], 0, "hash"), -1) != content_hash() || content_hash() != CONTENT_HASH {
    failed += 1; if loud { print("content ids: the hash is % now; set CONTENT_HASH, WIRE_CONTENT_IDS and the file's \"hash\" to it\n", content_hash()); }
  }
  if WIRE_CONTENT_IDS != CONTENT_HASH || jv_int(d[0], jv_get(d[0], 0, "content_pin"), -1) != WIRE_CONTENT {
    failed += 1; if loud { tool_errln("content ids: the P frame's content pin is not sealed with this registry"); }
  }
  return failed;
}
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) != 1 { tool_errln("usage: coax/web/tool.sh coax/web/room/content-profile.coax proto/verse/everglade-content-ids-v1.json"); return 2; }
  text: [CP_FILE] u8; n := fs_read(args_at(a[..], 0), text[..]);
  if n < 1 { tool_errln("content ids: no such file"); return 2; }
  failed := cp_faults(cast(string) text[0..<n], true);
  if failed < 0 { tool_errln("content ids: not the v1 profile"); return 2; }
  if failed > 0 { print("content ids v1: % difference(s)\n", failed); return 1; }
  abilities := 0; spells := 0; creatures := 0; items := 0; spawns := 0;
  for i: 0..<CONTENT_N {
    k := CONTENT[i].kind;
    if k == CT_ABILITY { abilities += 1; } else if k == CT_SPELL { spells += 1; } else if k == CT_CREATURE { creatures += 1; } else if k == CT_ITEM { items += 1; } else { spawns += 1; }
  }
  print("content ids v1: % abilities, % spells, % creature templates, % item kinds and % spawns as the file says; hash %, content pin %\n",
        abilities, spells, creatures, items, spawns, CONTENT_HASH, WIRE_CONTENT);
  return 0;
}

#test "content profile: a file that is not the profile, or whose kinds are wrong, is refused" {
  #assert cp_faults("{", false) == -1 && cp_faults("{\"profile\":\"x\",\"version\":1}", false) == -1;
  #assert cp_faults("{\"profile\":\"openagents.everglade.content-ids\",\"version\":2}", false) == -1;
  #assert cp_faults("{\"profile\":\"openagents.everglade.content-ids\",\"version\":1,\"kinds\":{\"ability\":2},\"ids\":[],\"hash\":1,\"content_pin\":9}", false) >= 4;
}
