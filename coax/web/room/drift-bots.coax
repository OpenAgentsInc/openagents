// The drift check's bots (coax/web/everglade-drift.coax, #12778): N players in the room the page plays
// (pair-drift-ROOM), so the server steps more than one seat. They keep moving on the empty south
// road, with their actual positions checked DB_OUT m out and more: clear of you (a body you bump is a
// correction offline never has) and of what the check's spells reach, and farther from the people
// round you than you are, so they turn to you as they do offline (the townspeople face and greet
// the nearest player, everglade-watch.coax everglade_room_town; at 6 and 10 m the bots drew some,
// and your Reverse Gravity lifted them, so the room's WANTED level and its conditions on the town
// came out unlike the offline page's, #12887). Each time the file DIR/hold appears bot 0 comes in
// to 6 m and, within 15 m (the spell's 60 feet, less the lag), casts Hold Person (bar slot 45) on them, removes the file
// and writes DIR/held with the cast's sequence number. DIR/bots-heard.txt has what bot 0 sent and
// heard of it: its casts, every e cast and every refusal (r SEQ WHY). The page's player is the seat that isn't a bot's.
//   coax/web/tool.sh coax/web/room/drift-bots.coax ws://127.0.0.1:PORT N SECONDS ROOM DIR
// Seat tickets are signed with OA_ROOM_TICKET_KEY (room-ticket.coax), as raid-check.coax's are; the
// bots are tagged as tests: room pair-drift-ROOM, player ids p-drift-K, names "Drift K".
// Prints one line at the end: the casts sent, those refused and the D frames heard.
#run_steps 250000000;   // secp256k1's tables: the seat ticket's v5 check (aethyr/session/seat-ticket.coax, #13260)
#load "room-socket.coax";
#load "../drift-snapshot.coax";
#load "../../lib/sys/fs.coax";
#load "../../../verse/everglade/points.coax";   // the empty south road, by name (#13078)
#load "../map-points.coax";

DB_MAX :: 8;
// m round the page's player the bots walk: twice your Reverse Gravity's reach (everglade-abilities.coax
// AB_RG_R, 15.24 m), so anyone it lifts is nearer you than any bot
DB_OUT :: 32;
DbBot :: struct { seat: int = -1; x: f32; z: f32; seen: bool; d: int; refused: int; wall_delta: int; m: [1] WireMirror; }   // m: the rows its D's left, as a page's (its I's HEARD)
DbWorld :: struct { seats: [64] bool; px: [64] f32; pz: [64] f32; }
DbAim :: struct { x: f32; z: f32; }
// Bot i's goal at tick: on the empty south road (road: the map's south-road, (0, -128) on 11-09), each
// bot 8 m further down it, or with hold bot 0 6 m round (cx, cz).
db_goal :: (tick: int, i: int, cx: f32, cz: f32, hold: bool, road: MapPoint) -> DbAim {
  ang := f32(tick) * 0.01 + f32(i) * 1.3;
  if i == 0 && hold { return DbAim.{x = cx + 6 * cos(ang), z = cz + 6 * sin(ang)}; }
  return DbAim.{x = road.x + 2 * sin(ang), z = road.z - f32(i) * 8 + 4 * cos(ang)};
}
db_clear :: (b: [] DbBot, n: int, w: [] DbWorld, page: int) -> bool {
  if n < 1 || n > b.count || page < 0 || page >= 64 || !w[0].seats[page] { return false; }
  for i: 0..<n {
    if !b[i].seen { return false; }
    dx := b[i].x - w[0].px[page]; dz := b[i].z - w[0].pz[page];
    if dx * dx + dz * dz < f32(DB_OUT * DB_OUT) { return false; }
  }
  return true;
}
#test "background clearance uses every actual position and requires a known page" {
  b: [3] DbBot; w: [1] DbWorld;
  #assert !db_clear(b[..], 3, w[..], -1);
  w[0].seats[3] = true;
  #assert !db_clear(b[..], 3, w[..], 3);
  for i: 0..<3 { b[i].seen = true; b[i].z = 32; }
  #assert db_clear(b[..], 3, w[..], 3);
  b[2].z = 31.99;
  #assert !db_clear(b[..], 3, w[..], 3);
}
#test "background players keep moving on the empty south road, away from the town" {
  road := eg_point("south-road"); #assert road.found;
  fixture := MapPoint.{found = true, x = 0, z = -128};   // the road as the bounds below were taken (11-09)
  for tick: 0..<1800 {
    for i: 0..<3 {
      goal := db_goal(tick, i, -15.53, -56.7, false, fixture);
      #assert abs(goal.x) <= 2 && goal.z <= -124 - f32(i) * 8;
      on := db_goal(tick, i, -15.53, -56.7, false, road);
      #assert abs(on.x - road.x) <= 2 && on.z <= road.z + 4 - f32(i) * 8;
    }
  }
}

// Every player's place as the bot's D frames leave them (its mirror, as a page's: wire 3 sends a
// row only when it changed), and the bot's own seat from y.
db_hear :: (b: [] DbBot, w: [] DbWorld, t: string, notes: string) {
  if rs_starts(t, "y ") { b[0].seat = rs_num(rs_field(t, 1)); return; }
  if rs_starts(t, "r ") { b[0].refused += 1; if notes.count > 0 { _ := fs_append(notes, t); _ = fs_append(notes, "\n"); } return; }
  if rs_starts(t, "e cast ") && notes.count > 0 { _ := fs_append(notes, t); _ = fs_append(notes, "\n"); }
  if !rs_starts(t, "D ") { return; }
  b[0].d += 1;
  frame := wire_mirror_frame(b[0].m[..], t);
  // A full snapshot clears the mirror at part zero. Keep the last published
  // world until its final part, rather than reporting a transient missing page.
  if frame.tick<0 || (frame.f&2)!=0 {return;}
  for q: 0..<64 { w[0].seats[q] = false; }
  if !ds_complete(frame.tick,b[0].m[0].heard,b[0].m[0].whole,frame.f) {return;}
  for e: 0..<WIRE_MIRROR {
    r := wire_mirror_get(b[0].m[..], e);
    if r.id < 0 || r.kind != WK_PLAYER || r.id >= 64 { continue; }
    ss := r.id;
    w[0].seats[ss] = true; w[0].px[ss] = r.x; w[0].pz[ss] = r.z;
    if ss == b[0].seat { b[0].x = r.x; b[0].z = r.z; b[0].seen = true; }
  }
}
// The page's seat: a player that is no bot's (-1 none yet).
db_page_seat :: (b: [] DbBot, n: int, w: [] DbWorld) -> int {
  for ss: 0..<64 {
    if !w[0].seats[ss] { continue; }
    mine := false;
    for i: 0..<n { if b[i].seat == ss { mine = true; } }
    if !mine { return ss; }
  }
  return -1;
}

#test "the bots read seats and places from D" {
  b: [2] DbBot; w: [1] DbWorld;
  db_hear(b[0..<1], w[..], "y 1 2 1700000000000", "");
  // a snapshot with both players, as the room writes it
  zero: [WIRE_SF] s32; row: [WIRE_SF] s32;
  f: [WIRE_SERVER_FRAME] u8;
  n := wire_put_d(f[..], 0, WireD.{tick = 10, ack = 3, f = 1});
  wire_s_pack(WireS.{id = 0, kind = WK_PLAYER, x = 5, z = -84}, row[..]); n = wire_put_s(f[..], n, 0, 0, zero[..], row[..]);
  n = wire_sep(f[..], n);
  wire_s_pack(WireS.{id = 1, kind = WK_PLAYER, x = 1, z = 2}, row[..]); n = wire_put_s(f[..], n, 1, 0, zero[..], row[..]);
  db_hear(b[0..<1], w[..], cast(string) f[0..<n], "");
  #assert b[0].seat == 1 && b[0].seen && abs(b[0].x - 1) < 0.01 && abs(b[0].z - 2) < 0.01 && b[0].d == 1 && b[0].m[0].heard == 10;
  #assert db_page_seat(b[..], 1, w[..]) == 0 && abs(w[0].pz[0] + 84) < 0.01;
  #assert rs_atan2(1, 0) > 1.57 && rs_atan2(1, 0) < 1.58;
}

#test "background clearance never publishes an incomplete multipart snapshot" {
 b:[1]DbBot;w:[1]DbWorld;b[0].seat=1;b[0].seen=true;b[0].z=40;w[0].seats[0]=true;
 zero:[WIRE_SF]s32;row:[WIRE_SF]s32;f:[WIRE_SERVER_FRAME]u8;
 n:=wire_put_d(f[..],0,WireD.{tick=20,f=3});
 wire_s_pack(WireS.{id=1,kind=WK_PLAYER,z=40},row[..]);n=wire_put_s(f[..],n,1,0,zero[..],row[..]);
 db_hear(b[..],w[..],cast(string)f[0..<n],"");
 #assert db_clear(b[..],1,w[..],0) && w[0].pz[0]==0;
 n=wire_put_d(f[..],0,WireD.{tick=20,part=1});
 wire_s_pack(WireS.{id=0,kind=WK_PLAYER,z=10},row[..]);n=wire_put_s(f[..],n,0,0,zero[..],row[..]);
 db_hear(b[..],w[..],cast(string)f[0..<n],"");
 #assert w[0].seats[0] && w[0].pz[0]==10 && !db_clear(b[..],1,w[..],0);
 n=wire_put_d(f[..],0,WireD.{tick=21,f=3});db_hear(b[..],w[..],cast(string)f[0..<n],"");
 #assert w[0].seats[0];
 n=wire_put_d(f[..],0,WireD.{tick=21,part=2});db_hear(b[..],w[..],cast(string)f[0..<n],"");
 #assert !db_clear(b[..],1,w[..],0); // a missing part must still refuse clearance

}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 5 { tool_errln("usage: coax/web/tool.sh coax/web/room/drift-bots.coax ws://127.0.0.1:PORT N SECONDS ROOM DIR"); return 2; }
  road := eg_point("south-road");
  if !map_need(road) { return 2; }
  bb: [512] u8;
  base := rs_base(args_at(a[..], 0), bb[..]);
  n := rs_num(args_at(a[..], 1)); if n < 1 { n = 1; } if n > DB_MAX { n = DB_MAX; }
  secs := rs_num(args_at(a[..], 2)); if secs < 5 { secs = 5; }
  room := rs_num(args_at(a[..], 3));
  dir := args_at(a[..], 4);
  u: [1024] u8;
  url := rs_url(u[..], base, "/api/room/relay/everglade/", "pair-e2-drift-", room);
  hold_b: [1024] u8; held_b: [1024] u8;
  hold := fs_join(dir, "hold", hold_b[..]); held := fs_join(dir, "held", held_b[..]);
  log_b: [1024] u8; notes := fs_join(dir, "bots-heard.txt", log_b[..]);   // bot 0's casts heard and refusals, as they come
  pos_b: [1024] u8; positions := fs_join(dir, "bots-positions.txt", pos_b[..]);
  ready_b: [1024] u8; ready := fs_join(dir, "bots-ready", ready_b[..]);
  unsafe_b: [1024] u8; unsafe := fs_join(dir, "bots-unsafe", unsafe_b[..]);
  wrote := fs_write(positions, "wall_ms page_x_cm page_z_cm [seat bot_x_cm bot_z_cm gap_cm]...\n");
  c: [DB_MAX] RelayConn; b: [DB_MAX] DbBot; w: [1] DbWorld; seq: [DB_MAX] int;
  for i: 0..<n {
    ub: [1024] u8; pid: [32] u8; nm: [32] u8;
    pn := rs_int(pid[..], rs_put(pid[..], 0, "p-drift-"), i);
    mn := rs_int(nm[..], rs_put(nm[..], 0, "Drift "), i);
    ui := rs_ticketed(ub[..], url, cast(string) pid[0..<pn], cast(string) nm[0..<mn]);
    if ui.count == 0 || !relay_conn_open(c[i..<i + 1], ui) { tool_err("drift-bots: can't open "); tool_errln(url); return 1; }
    hm: [96] u8;
    hn := rs_put(hm[..], rs_put(hm[..], 0, "H 5 ranger.0.0.0 druid 0 "), cast(string) nm[0..<mn]);
    _ := relay_conn_send(c[i..<i + 1], cast(string) hm[0..<hn]);
  }
  print("drift-bots: % in %\n", n, url);
  t0 := rs_now(); tick := 0; casts := 0; armed := false;
  while rs_now() - t0 < secs * 1000 {
    tick += 1;
    for i: 0..<n { while relay_conn_poll(c[i..<i + 1], 0) == RC_TEXT {
      msg := cast(string) c[i].text[0..<c[i].text_n];
      if rs_starts(msg, "y ") { b[i].wall_delta = rs_num(rs_field(msg, 3)) - rs_now(); }
      db_hear(b[i..<i + 1], w[..], msg, ifx i == 0 then notes else "");
    } }
    page := db_page_seat(b[..], n, w[..]);
    clear := db_clear(b[..], n, w[..], page);
    if !armed && clear { armed = fs_write(ready, "all actual gaps >= 32 m\n"); }
    if armed && !clear && !fs_exists(hold) { wrote = fs_write(unsafe, "background clearance was lost or became unknown\n"); }
    if page >= 0 && tick % 30 == 0 {
      row: [2048] u8; at := rs_int(row[..], 0, rs_now() + b[0].wall_delta);
      at = rs_int(row[..], rs_put(row[..], at, " "), cast(int) (w[0].px[page] * 100));
      at = rs_int(row[..], rs_put(row[..], at, " "), cast(int) (w[0].pz[page] * 100));
      for i: 0..<n {
        dx := b[i].x - w[0].px[page]; dz := b[i].z - w[0].pz[page];
        at = rs_int(row[..], rs_put(row[..], at, " "), b[i].seat);
        at = rs_int(row[..], rs_put(row[..], at, " "), cast(int) (b[i].x * 100));
        at = rs_int(row[..], rs_put(row[..], at, " "), cast(int) (b[i].z * 100));
        at = rs_int(row[..], rs_put(row[..], at, " "), cast(int) (sqrt(dx * dx + dz * dz) * 100));
      }
      at = rs_put(row[..], at, "\n"); wrote = fs_append(positions, cast(string) row[0..<at]);
    }
    for i: 0..<n {
      if !b[i].seen { continue; }
      // The old orbit crossed walls and left actual players inside spell range. Stay on open road;
      // the separate legacy hold request still brings bot 0 in to 6 m.
      cx := ifx page >= 0 then w[0].px[page] else b[i].x; cz := ifx page >= 0 then w[0].pz[page] else b[i].z;
      goal := db_goal(tick, i, cx, cz, fs_exists(hold), road);
      wx := goal.x - b[i].x; wz := goal.z - b[i].z;
      ahead := ifx wx * wx + wz * wz > 1 then 100 else 0;
      run := ifx wx * wx + wz * wz > 16 then 1 else 0;   // running to keep up
      // the camera's yaw (aethyr/move/walk.coax): it sits at theta round you, so ahead is -(sin, cos) of it
      yaw := rs_atan2(wx, wz) + 3.14159265;
      if yaw > 3.14159265 { yaw -= 6.2831853; }
      seq[i] += 1;
      m: [128] u8;
      k := rs_put(m[..], rs_int(m[..], rs_put(m[..], 0, "I "), seq[i]), " 0 ");
      k = rs_int(m[..], k, ahead); k = rs_put(m[..], k, " 0 0 "); k = rs_int(m[..], k, cast(int) (yaw * 10000)); k = rs_put(m[..], k, " "); k = rs_int(m[..], k, run);   // THETA in 0.1 mrad (WIRE_FINE)
      k = rs_put(m[..], k, " "); k = rs_int(m[..], k, b[i].m[0].heard);   // HEARD: the newest tick its rows came whole
      _ := relay_conn_send(c[i..<i + 1], cast(string) m[0..<k]);
    }
    // Hold Person on the page's player, when the check asks
    near := false;
    if page >= 0 && b[0].seen { gx := w[0].px[page] - b[0].x; gz := w[0].pz[page] - b[0].z; near = gx * gx + gz * gz < 225; }
    if !near && tick % 60 == 0 && fs_exists(hold) {
      gb: [160] u8; gn := rs_put(gb[..], 0, "hold asked; bot 0 at "); gn = rs_int(gb[..], gn, cast(int) b[0].x); gn = rs_put(gb[..], gn, " "); gn = rs_int(gb[..], gn, cast(int) b[0].z);
      gn = rs_put(gb[..], gn, ", page seat "); gn = rs_int(gb[..], gn, page);
      if page >= 0 { gn = rs_put(gb[..], gn, " at "); gn = rs_int(gb[..], gn, cast(int) w[0].px[page]); gn = rs_put(gb[..], gn, " "); gn = rs_int(gb[..], gn, cast(int) w[0].pz[page]); }
      _ := fs_append(notes, cast(string) gb[0..<gn]); _ = fs_append(notes, "\n");
    }
    if near && fs_exists(hold) {
      _ := fs_remove(hold);
      seq[0] += 1;
      m: [128] u8;
      k := rs_int(m[..], rs_put(m[..], 0, "C "), seq[0]);
      k = rs_put(m[..], k, " 45 "); k = rs_int(m[..], k, cast(int) (w[0].px[page] * 100));
      k = rs_put(m[..], k, " 100 "); k = rs_int(m[..], k, cast(int) (w[0].pz[page] * 100)); k = rs_put(m[..], k, " ");
      k = rs_int(m[..], k, 1000 + page);
      _ = relay_conn_send(c[0..<1], cast(string) m[0..<k]);
      casts += 1;
      sb: [160] u8; sn := rs_int(sb[..], 0, seq[0]);
      _ = fs_write(held, cast(string) sb[0..<sn]);
      _ = fs_append(notes, cast(string) m[0..<k]);
      gx := w[0].px[page] - b[0].x; gz := w[0].pz[page] - b[0].z;
      gb: [64] u8; gn := rs_int(gb[..], rs_put(gb[..], 0, " from cm away "), cast(int) (sqrt(gx * gx + gz * gz) * 100));
      _ = fs_append(notes, cast(string) gb[0..<gn]); _ = fs_append(notes, "\n");
    }
    while rs_now() - t0 < tick * 1000 / 30 { proc_sleep(2); }
  }
  refused := 0; d := 0;
  for i: 0..<n { refused += b[i].refused; d += b[i].d; }
  print("drift-bots: % Hold Person casts, % refused, % D frames heard\n", casts, refused, d);
  for i: 0..<n { _ := relay_conn_close(c[i..<i + 1], 1000); }
  return 0;
}
