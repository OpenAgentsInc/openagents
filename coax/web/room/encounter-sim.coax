// Everglade II's encounter simulator (#13288): time to kill for every class and level, headless, from a
// seed. Each fight is a fresh room of the real server (room.coax: its tick, its creatures and guard,
// its casts, the shared SRD rules), with one scripted player and no network: the checks' host part
// (room-casts.coax rc_test_tick, every line of sight clear), the room's dice from the host's own key
// (rm_dice_key) made from the seed, and the player's casts through the room's handler (everglade/server/
// casts.coax eg_e2_cast), refused or taken exactly as a page's. Nothing here rolls a die or deals harm.
//
// The encounters: the third wolf pack in the woods (three SRD Wolves, everglade/server/creatures.coax),
// the path's guard (an SRD level 10 Fighter, everglade/server/guard.coax), and the first and second
// packs along the path (one Wolf, two Wolves). The player stands on the
// path near them and doesn't move; the wolves notice and come, and the guard turns on the player's first
// blow. The scripted player, every ES_RETRY ticks (the room takes what its turn's pace allows): below half its Hit Points,
// a heal on itself; else, once a fight, each buff on itself (Rage, Innate Sorcery, a levelled spell on
// itself; Wild Shape only with no spell slot left, for a Beast can't cast); else its harmful abilities, levelled spells highest first, then the rest in its bar's
// order, at the nearest foe (a Concentration spell not while it concentrates, nor a spell for
// Humanoids at a Beast). The first the room takes
// is its press. A fight ends when every foe is down (a win), the player is at 0 Hit Points (a down), or
// at ES_CAP_S.
//
// It prints the table (encounter-table.coax). --write FILE puts it in FILE with its header;
// --check FILE compares it with FILE's rows and fails on any moved more than ES_SHARE percent
// (the after-landing check runs that against docs/dnd/encounter-ttk.md: coax/remote/check.sh room).
//   coax/web/tool.sh coax/web/room/encounter-sim.coax [--seeds N] [--write FILE] [--check FILE]
//                                                      [--class NAME] [--level L] [--encounter NAME]   (wolves, guard, "one wolf", "two wolves", "goblin camp")
// --bars FILE writes the bots' table (bot-bars.coax: each class's bar as the scripted player sees
// it, script-player.coax) and --check-bars FILE fails when FILE is stale (#13296).
#import "Basic";
#run_steps 250000000;   // secp256k1's tables: the room loads the seat ticket's v5 check
#load "room.coax";
#load "../../../everglade/server/room-checks.coax";   // this program runs the fixture as code
#load "encounter-table.coax";
#load "script-player.coax";   // the scripted player's choice, the bots' too (#13296)
#load "../../lib/sys/tool.coax";
#load "../../lib/sys/args.coax";
#load "../../lib/sys/fs.coax";

ES_CAP_S :: 120;        // s a fight lasts at most
ES_RETRY :: 3;          // ticks before a player that pressed nothing the room took tries again
ES_PACK_N :: 3;         // the most foes in a pack
// An encounter's pack (the content tables' troops, creatures.coax E2Zoo): its first monster, and how many it holds. The third
// pack is monsters 5, 6 and 7; the first is monster 0; the second monsters 3 and 4.
es_pack :: (enc: int) -> int { return ifx enc == ES_WOLF then 0 else (ifx enc == ES_PAIR then 3 else (ifx enc == ES_CAMP then 8 else 5)); }
es_pack_n :: (enc: int) -> int { return ifx enc == ES_WOLF then 1 else (ifx enc == ES_PAIR then 2 else (ifx enc == ES_CAMP then 2 else 3)); }
ES_CLOCK0 :: 1762190000000;
ES_CAMP_ASIDE :: 0.5;    // m west of the middle of the camp fire the player stands: outside what either archer notices

// One fight's numbers, in whole Hit Points and ticks.
EsFight :: struct { win: bool; down: bool; ticks: int; first: int = -1; end: int; dealt: int; healed: int; taken: int; hp: int; hp_max: int; res: int; res_max: int; }

es_heals :: (a: FbAb) -> bool {
  if a.kind == FB_WIND || a.kind == FB_LAY || a.kind == FB_WHOLE || a.kind == FB_PRESERVE { return true; }
  if a.kind != FB_SPELL { return false; }
  s := rs_spell(a.sp);
  for q: 0..<s.step_n { if s.steps[q].kind == RS_S_HEAL { return true; } }
  return false;
}
es_buff :: (a: FbAb) -> bool {
  if a.kind == FB_RAGE || a.kind == FB_INNATE || a.kind == FB_WILD || a.kind == FB_SURGE { return true; }
  return a.kind == FB_SPELL && a.tg == FB_SELF && a.lvl > 0 && !es_heals(a);
}
// A buff that bars its user's spells while it lasts (wild-shape.coax rs_casting_barred): Wild Shape, Rage.
es_form :: (a: FbAb) -> bool { return a.kind == FB_WILD || a.kind == FB_RAGE; }
// Whether the player presses a for harm: not a help, not a check or move, never Zone of Truth.
es_harms :: (a: FbAb) -> bool {
  if egb_helps(a) { return false; }
  if a.kind == FB_SKILL || a.kind == FB_GRAPPLE || a.kind == FB_SHOVE || a.kind == FB_DASH || a.kind == FB_CDASH || a.kind == FB_HIDE { return false; }
  if a.kind == FB_READY || a.kind == FB_WORLD || a.kind == FB_RITUAL || a.kind == FB_INSPIRE || a.kind == FB_TURN { return false; }
  return !(a.kind == FB_SPELL && a.sp == SP_ZONE_OF_TRUTH);
}
// A bar's entry as the scripted player sees it (script-player.coax): its wire slot (-1: not in the
// class's catalogue), what it is for, a levelled spell's level, and the two rules a spell can carry.
es_entry :: (c: int, a: FbAb, cat_i: int) -> SpEntry {
  e := SpEntry.{slot = ifx cat_i >= 0 then xk_slot(c, cat_i) else -1};
  e.role = (ifx es_heals(a) then SP_HEAL else 0) + (ifx es_buff(a) then SP_BUFF else 0) + (ifx es_harms(a) then SP_HARM else 0) + (ifx es_form(a) then SP_FORM else 0);
  if a.kind == FB_SPELL {
    e.lvl = a.lvl;
    e.conc = rs_spell(a.sp).concentration; e.humanoid = rs_spell(a.sp).humanoid_only;
  }
  return e;
}
// Class c's bar at `level`, as the scripted player sees it: how many entries.
es_bar :: (c: int, level: int, out: [] SpEntry) -> int {
  bar: [XC_SLOTS] FbAb; nb := xk_bar_at(c, level, bar[..]);
  cat: [XC_SLOTS] FbAb; nc := xk_catalog(c, cat[..]);
  for i: 0..<nb {
    at := -1;
    for j: 0..<nc { if at < 0 && xc_id(cat[j]) == xc_id(bar[i]) { at = j; } }
    out[i] = es_entry(c, bar[i], at);
  }
  return nb;
}
// The bots' table (bot-bars.coax, #13296): every class's bar at levels 1 to ES_LEVELS, as source.
ES_BARS_HEAD :: "// Written by `coax/web/tool.sh coax/web/room/encounter-sim.coax --bars coax/web/room/bot-bars.coax` (#13296):\n// each class's bar at levels 1 to 6 as the scripted player sees it (script-player.coax SpEntry), for the\n// protocol bots, which can't load the rules beside the socket (both name things rs_). Don't edit it:\n// `encounter-sim.coax --check-bars coax/web/room/bot-bars.coax` (the room check) fails when it is stale.\n// One row an entry: CLASS LEVEL SLOT ROLE SPELL-LEVEL CONCENTRATION HUMANOIDS-ONLY.\n";
es_bars_text :: (out: [] u8) -> int {
  n := es_put(out, 0, ES_BARS_HEAD);
  rows := 0;
  body: [ES_TEXT] u8; m := 0;
  for c: 0..<12 { for l: 1..<ES_LEVELS + 1 {
    e: [XC_SLOTS] SpEntry; nb := es_bar(c, l, e[..]);
    for i: 0..<nb {
      if e[i].slot < 0 || e[i].role == SP_OTHER { continue; }
      v := [7] int.[c, l, e[i].slot, e[i].role, e[i].lvl, ifx e[i].conc then 1 else 0, ifx e[i].humanoid then 1 else 0];
      m = es_put(body[..], m, "  ");
      for q: 0..<7 { d: [24] u8; m = es_put(body[..], m, es_dec(v[q], d[..])); m = es_put(body[..], m, ifx q < 6 then ", " else ",\n"); }
      rows += 1;
    }
  } }
  d: [24] u8;
  n = es_put(out, n, "BB_ROWS :: "); n = es_put(out, n, es_dec(rows, d[..])); n = es_put(out, n, ";\nBB_COLS :: 7;\nBB :: [");
  n = es_put(out, n, es_dec(rows * 7, d[..])); n = es_put(out, n, "] int.[\n");
  n = es_put(out, n, cast(string) body[0..<m]);
  n = es_put(out, n, "];\n");
  return n;
}
es_dec :: (v: int, out: [] u8) -> string {
  if v == 0 { out[0] = '0'; return cast(string) out[0..<1]; }
  t: [24] u8; k := 0; x := v;
  while x > 0 { t[k] = cast(u8) ('0' + x % 10); x /= 10; k += 1; }
  for i: 0..<k { out[i] = t[k - 1 - i]; }
  return cast(string) out[0..<k];
}

// Resources a creature holds: spell slots and every limited use, Focus and Rages among them (into
// r[0] now, r[1] most). A Healer's Kit is gear with no most, and is not counted.
es_res :: (c: RsCreature, r: [] int) {
  r[0] = 0; r[1] = 0;
  for l: 1..<10 { r[0] += c.slots[l]; r[1] += c.slots_max[l]; }
  for u: 0..<RS_USES { if u != RS_USE_KIT { r[0] += c.uses[u]; r[1] += c.uses_max[u]; } }
}

// The foes' creatures (-1: down or gone) into f: how many still stand.
es_foes :: (v: [] RmServer, k: int, enc: int, f: [] int) -> int {
  n := 0;
  b := v[0].eg[k].rules[0].b[..];
  for j: 0..<f.count { f[j] = -1; }
  if enc == ES_GUARD {
    g := v[0].eg[k].guard[0];
    if g.q >= 0 && b[0].c[EGB_BEAST0 + g.q].hp > 0 { f[0] = EGB_BEAST0 + g.q; n = 1; }
    return n;
  }
  for j: 0..<es_pack_n(enc) {
    mo := v[0].eg[k].monsters[0].mon[es_pack(enc) + j];
    if mo.q >= 0 && (mo.state == E2M_IDLE || mo.state == E2M_CHASE || mo.state == E2M_RETURN) && b[0].c[EGB_BEAST0 + mo.q].hp > 0 { f[j] = EGB_BEAST0 + mo.q; n += 1; }
  }
  return n;
}
// Where creature i stands (metres).
es_at :: (v: [] RmServer, k: int, i: int) -> [2] f32 {
  g := v[0].eg[k].guard[0];
  if g.q >= 0 && i == EGB_BEAST0 + g.q { return [2] f32.[g.x, g.z]; }
  bt := v[0].eg[k].rules[0].beasts[i - EGB_BEAST0];
  return [2] f32.[bt.x, bt.z];
}
es_place :: (v: [] RmServer, k: int, x: f32, z: f32) { v[0].eg[k].seat[0].pose.x = x; v[0].eg[k].seat[0].pose.z = z; egb_place(v[0].eg[k].rules[..], 0, x, z); }
es_tick :: (v: [] RmServer, k: int) { rc_test_tick(v, k, true); while rm_relay_next(v) > 0 { } }

// One press: the bar's entry at catalogue index i at (ax, az). Whether the room took it.
es_press :: (v: [] RmServer, k: int, c: int, i: int, seq: int, ax: f32, az: f32) -> bool {
  t := v[0].eg[k].tick;
  eg_e2_cast(v, k, SeatId.{value = 0}, WireCast.{seq = seq, slot = xk_slot(c, i), ax = ax, az = az});
  return v[0].eg[k].seat[0].last_cast == t;
}

// Class c at `level` against encounter enc, from seed (trace: each press the room took, and the foes'
// Hit Points as it was pressed).
es_fight :: (v: [] RmServer, enc: int, c: int, level: int, seed: int, trace: bool) -> EsFight {
  out := EsFight.{};
  rm_init(v); rm_clock(v, 0, ES_CLOCK0);
  rm_dice_key(v, seed * 2654435 + enc * 7919 + 17, c * 1000 + level * 31 + 5);
  if rm_join(v, 0, "GET /api/room/relay/everglade/pair-e2-encounter-sim HTTP/1.1\r\n\r\n") != 0 { return out; }
  k := eg_room_at(v, v[0].conns[0].relay);
  hello: [64] u8; word: [32] u8;
  n := es_put(hello[..], 0, "H 6 ranger.0.0.0 "); n = es_put(hello[..], n, cast(string) word[0..<fb_cl_kind_at(c, level, word[..])]); n = es_put(hello[..], n, " 0 -");
  rm_heard(v, 0, cast(string) hello[0..<n]);
  es_tick(v, k);
  r := v[0].eg[k].rules[..]; b := r[0].b[..]; me := EGB_SEAT;
  if r[0].klass[0] != EGB_CL0 + c || b[0].c[me].level != level { return out; }
  // where the player stands: on the path by the pack's middle wolf, or beside the guard
  px: f32 = 0; pz: f32 = 0;
  if enc == ES_GUARD {
    g := v[0].eg[k].guard[0];
    if g.q < 0 { return out; }
    px = g.x + 1.0; pz = g.z;
  } else {
    w := v[0].eg[k].monsters[0].mon[es_pack(enc) + (ifx es_pack_n(enc) > 1 then 1 else 0)];
    pz = w.hz; px = e2_road_x(pz);
    // the camp's two Warriors are fought at their fire, between them and half a metre to its far side from the
    // archers' perches: each archer is its own group and notices at 9 m, so neither joins
    if enc == ES_CAMP { o := v[0].eg[k].monsters[0].mon[es_pack(enc)]; px = (o.hx + w.hx) * 0.5 - f32(ES_CAMP_ASIDE); pz = (o.hz + w.hz) * 0.5; }
  }
  es_place(v, k, px, pz);
  // the bar at this level, each entry's catalogue index
  bar: [XC_SLOTS] FbAb; nb := xk_bar_at(c, level, bar[..]);
  cat: [XC_SLOTS] FbAb; nc := xk_catalog(c, cat[..]);
  at: [XC_SLOTS] int;
  for i: 0..<nb { at[i] = -1; for j: 0..<nc { if at[i] < 0 && xc_id(cat[j]) == xc_id(bar[i]) { at[i] = j; } } }
  used: [XC_SLOTS] bool;
  sb: [XC_SLOTS] SpEntry;
  for i: 0..<nb { sb[i] = es_entry(c, bar[i], at[i]); }
  foes: [ES_PACK_N] int; hp_was: [ES_PACK_N] int;
  _ := es_foes(v, k, enc, foes[..]);
  for j: 0..<ES_PACK_N { hp_was[j] = ifx foes[j] >= 0 then b[0].c[foes[j]].hp else 0; }
  my_was := b[0].c[me].hp;
  seq := 0; next := 0; t0 := v[0].eg[k].tick;
  cap := ES_CAP_S * EG_HZ;
  while v[0].eg[k].tick - t0 < cap {
    t := v[0].eg[k].tick;
    standing := es_foes(v, k, enc, foes[..]);
    if standing == 0 { out.win = true; break; }
    if b[0].c[me].hp <= 0 || b[0].c[me].dead { out.down = true; break; }
    if t >= next {   // the room's pace decides what it takes (everglade/shared/cast-pace.coax): its turn's parts, one each a 1.5 s beat
      // the nearest foe
      fx := px; fz := pz; best: f32 = 1000000; near := -1;
      for j: 0..<ES_PACK_N { if foes[j] >= 0 { p := es_at(v, k, foes[j]); d := (p[0] - px) * (p[0] - px) + (p[1] - pz) * (p[1] - pz); if d < best { best = d; fx = p[0]; fz = p[1]; near = foes[j]; } } }
      took := false;
      hurt := b[0].c[me].hp * 2 < b[0].c[me].hp_max;
      // the scripted player's order (script-player.coax); the first the room takes is its press
      plan: [XC_SLOTS * 3] int;
      slots := false; for l: 1..<10 { if b[0].c[me].slots[l] > 0 { slots = true; } }
      np := sp_plan(sb[..], nb, hurt, used[..], b[0].c[me].conc >= 0, near < 0 || b[0].c[near].humanoid, slots, plan[..]);
      // a plan's order is heals (when hurt), then buffs, then harm: which part entry q is in
      nh := 0; nf := 0;
      for i: 0..<nb { if hurt && (sb[i].role & SP_HEAL) != 0 { nh += 1; } if sp_buffs(sb[i], used[i], slots) { nf += 1; } }
      for q: 0..<np {
        i := plan[q];
        if took || at[i] < 0 { continue; }
        part := ifx q < nh then SP_HEAL else ifx q < nh + nf then SP_BUFF else SP_HARM;
        own := part != SP_HARM;
        seq += 1; took = es_press(v, k, c, at[i], seq, ifx own then px else fx, ifx own then pz else fz);
        if !took { continue; }
        if part == SP_BUFF { used[i] = true; }
        if part == SP_HARM && out.first < 0 { out.first = t; }
        if trace && part == SP_HEAL { print("  t % heal %: me %\n", t - t0, bar[i].name, b[0].c[me].hp); }
        if trace && part == SP_BUFF { print("  t % buff %\n", t - t0, bar[i].name); }
        if trace && part == SP_HARM { print("  t % harm %: foes", t - t0, bar[i].name); for j: 0..<ES_PACK_N { print(" %", ifx foes[j] >= 0 then b[0].c[foes[j]].hp else -1); } print(" me %\n", b[0].c[me].hp); }
      }
      if !took { next = t + ES_RETRY; }
    }
    es_place(v, k, px, pz);
    es_tick(v, k);
    // what the tick did: harm to the foes, the player's Hit Points down and up
    for j: 0..<ES_PACK_N {
      if foes[j] < 0 { continue; }
      now := rs_max(b[0].c[foes[j]].hp, 0);
      if now < hp_was[j] { out.dealt += hp_was[j] - now; }
      hp_was[j] = now;
    }
    my := rs_max(b[0].c[me].hp, 0);
    if my < my_was { out.taken += my_was - my; } else { out.healed += my - my_was; }
    my_was = my;
  }
  out.end = v[0].eg[k].tick;
  out.ticks = out.end - (ifx out.first >= 0 then out.first else t0);
  out.hp = rs_max(b[0].c[me].hp, 0); out.hp_max = rs_max(b[0].c[me].hp_max, 1);
  rr: [2] int; es_res(b[0].c[me], rr[..]); out.res = rr[0]; out.res_max = rr[1];
  return out;
}

// A row: class c at `level` against enc over seeds 1 to n (32 unless --seeds says).
es_row :: (v: [] RmServer, enc: int, c: int, level: int, n: int, trace: bool) -> EsRow {
  row := EsRow.{enc = enc, klass = c, level = level, n = n};
  win_ticks := 0; fight_ticks := 0; dealt := 0; healed := 0; taken := 0; hp := 0; res := 0;
  for s: 1..<n + 1 {
    f := es_fight(v, enc, c, level, s, trace);
    if f.win { row.wins += 1; win_ticks += f.ticks; }
    if f.down { row.downs += 1; }
    fight_ticks += rs_max(f.ticks, EG_HZ);   // at least a second: a one-press kill isn't a rate
    dealt += f.dealt; healed += f.healed; taken += f.taken;
    hp += f.hp * 100 / f.hp_max;
    res += ifx f.res_max > 0 then f.res * 100 / f.res_max else 100;
  }
  // tenths: seconds are ticks / EG_HZ
  row.ttk = ifx row.wins > 0 then (win_ticks * 10 + row.wins * EG_HZ / 2) / (row.wins * EG_HZ) else -1;
  row.dps = (dealt * EG_HZ * 10 + fight_ticks / 2) / fight_ticks;
  row.healed = (healed * 10 + n / 2) / n; row.taken = (taken * 10 + n / 2) / n;
  row.hp = (hp + n / 2) / n; row.res = (res + n / 2) / n;
  return row;
}

ES_TEXT :: 262144;
ES_TITLE :: "# Encounter time to kill\n\nWritten by `coax/web/tool.sh coax/web/room/encounter-sim.coax --write docs/dnd/encounter-ttk.md` (#13288): every\nclass at levels 1 to 6, alone, against the third wolf pack (three Wolves), the path's guard (a level 10 Fighter),\nthe first pack (one Wolf), the second (two Wolves) and the goblin camp (its two Goblin Warriors, fought at their fire; the two archers, each on its own, stay on their perches),\nin the real room's rules, 32 fights (seeds 1 to 32) a row. Wins: fights where every foe fell first. TTK: the mean seconds from\nthe player's first harmful press to the last foe's fall, over the wins. Damage/s, healed and taken: per fight.\nDowns: fights where the player fell. HP and resources (spell slots, limited uses, Focus) left: at the fight's end.\nA fight lasts at most 120 s. The after-landing check fails a change that moves a row's TTK, damage a second or\nwins by more than 25%; run this again with --write in the same commit when the change is meant.\n\n";

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("usage: encounter-sim [--seeds N] [--write FILE] [--check FILE] [--class NAME] [--level L] [--encounter NAME]"); return 2; }
  seeds := es_read_int(args_value(a[..], "--seeds", "32"));
  only_class := es_class_at(args_value(a[..], "--class", ""));
  only_level := es_read_int(args_value(a[..], "--level", ""));
  only_enc := es_enc_at(args_value(a[..], "--encounter", ""));
  trace := args_has(a[..], "--trace");
  if seeds < 1 { tool_errln("encounter-sim: --seeds wants a whole number"); return 2; }
  pinned: [ES_TEXT] u8; old: [ES_ROWS] EsRow; old_n := 0;
  check := args_value(a[..], "--check", "");
  if check.count > 0 {
    m := fs_read(check, pinned[..]);
    if m <= 0 { tool_err("encounter-sim: cannot read "); tool_errln(check); return 2; }
    old_n = es_table_read(cast(string) pinned[0..<m], old[..]);
  }
  bars := args_value(a[..], "--bars", ""); check_bars := args_value(a[..], "--check-bars", "");
  if bars.count > 0 || check_bars.count > 0 {
    bt: [ES_TEXT] u8; bn := es_bars_text(bt[..]);
    if bars.count > 0 {
      if !fs_write(bars, cast(string) bt[0..<bn]) { tool_err("encounter-sim: cannot write "); tool_errln(bars); return 2; }
      print("encounter-sim: wrote %\n", bars);
      return 0;
    }
    was: [ES_TEXT] u8; wn := fs_read(check_bars, was[..]);
    if wn != bn || cast(string) was[0..<wn] != cast(string) bt[0..<bn] {
      print("encounter-sim: % is stale: coax/web/tool.sh coax/web/room/encounter-sim.coax --bars % writes it again\n", check_bars, check_bars);
      return 1;
    }
    print("encounter-sim: % matches the classes' bars\n", check_bars);
    return 0;
  }
  v: [1] RmServer;
  text: [ES_TEXT] u8; n := es_put(text[..], 0, ES_TITLE); n = es_put(text[..], n, ES_HEAD);
  print("%", ES_HEAD);
  moved := 0; rows := 0;
  for enc: 0..<ES_ENCOUNTERS { for c: 0..<12 { for l: 1..<ES_LEVELS + 1 {
    if (only_enc >= 0 && enc != only_enc) || (only_class >= 0 && c != only_class) || (only_level >= 1 && l != only_level) { continue; }
    row := es_row(v[..], enc, c, l, seeds, trace);
    line: [256] u8; ln := es_row_put(line[..], 0, row);
    print("%", cast(string) line[0..<ln]);
    n = es_put(text[..], n, cast(string) line[0..<ln]);
    rows += 1;
    if check.count > 0 {
      i := es_find(old[..], old_n, row);
      if i < 0 { print("moved: no pinned row for this one\n"); moved += 1; }
      else if es_moved(old[i], row, ES_SHARE) {
        was: [256] u8; wn := es_row_put(was[..], 0, old[i]);
        print("moved: was %", cast(string) was[0..<wn]); moved += 1;
      }
    }
  } } }
  write := args_value(a[..], "--write", "");
  if write.count > 0 && !fs_write(write, cast(string) text[0..<n]) { tool_err("encounter-sim: cannot write "); tool_errln(write); return 2; }
  if check.count > 0 {
    print("encounter-sim: % rows, % moved more than % percent from %\n", rows, moved, ES_SHARE, check);
    if moved > 0 { return 1; }
  }
  return 0;
}
