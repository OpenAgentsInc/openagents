// Hold Everglade II's familiar and Healer's Kit profiles (proto/verse/everglade-familiar*-v1.json,
// everglade-find-familiar-v1.json and everglade-healers-kit-v1.json; #13244) to the room's codec for
// them, the functions its handlers call: everglade/server/wire-prev-wire.coax (e2_familiar_read and the
// e2_familiar_put_* writers) and, for the kit, everglade/server/kit-wire.coax, the one codec the room
// (aid.coax) and the page (everglade/client/net.coax) both load: egk_ask_put and egk_ask_read for U1,
// egk_used_put and egk_used_read for u1, each frame written and read back (#13245). A profile's format
// strings ("request": "M1 SEQ FORM SLOT", ...) name its frames' fields in order; each "frames" entry's
// values name those fields in that order; a request's text read by the room gives back its values; a
// reply's values written by the room give exactly its text; every "malformed" request is refused by the
// room's reader (the kit's "malformed_accepted" by the page's); and the enumerations (forms, spirits,
// orders, status, modes, max_rows, the kit's max_left) are the room's.
// Those are the wire 6 frames, which the room still speaks to a wire 6 page behind the previous wire's hooks
// (everglade/server/wire-prev.coax; their codec moved to wire-prev-wire.coax and kit-wire.coax, #13398).
// Since wire 7 (#13276, #13245) the profile is proto/verse/everglade2-familiar-v2.json and the codec
// everglade/server/familiar-wire.coax, the one file the room and the page both load: a familiar's row
// kind, each request as an E kind and each answer as an e entry (fp_v2).
//   coax/web/tool.sh coax/web/room/familiar-profile.coax proto/verse/everglade-familiar-v1.json
#import "Basic";
#run_steps 250000000;   // secp256k1's tables: the room loads the seat ticket's v5 check
#load "room.coax";
#load "../../lib/json/json.coax";
#load "../../lib/sys/tool.coax";
#load "../../lib/sys/fs.coax";

FP_FILE :: 16384;
FP_NONE :: -999999999;
FP_KEYS :: [8] string.["request", "accepted", "refused", "success", "refusal", "progress", "state", "snapshot"];

fp_str :: (d: Jv, at: int, out: [] u8) -> string {
  n := jv_str(d, at, out);
  return ifx n >= 0 then cast(string) out[0..<n] else "";
}
// Word i of a format (split on spaces), or "".
fp_word :: (s: string, i: int) -> string {
  at := 0; w := 0;
  while at < s.count {
    while at < s.count && s[at] == ' ' { at += 1; }
    start := at;
    while at < s.count && s[at] != ' ' { at += 1; }
    if start < at { if w == i { return s[start..<at]; } w += 1; }
  }
  return "";
}
fp_words :: (s: string) -> int {
  n := 0;
  while fp_word(s, n) != "" { n += 1; }
  return n;
}
fp_lower :: (c: u8) -> u8 { return ifx c >= 65 && c <= 90 then cast(u8) (cast(int) c + 32) else c; }
fp_same_name :: (a: string, b: string) -> bool {
  if a.count != b.count { return false; }
  for i: 0..<a.count { if fp_lower(a[i]) != fp_lower(b[i]) { return false; } }
  return true;
}
// An object of exactly these names and values, in this order.
fp_enum :: (d: Jv, key: string, names: [3] string, values: [3] int) -> bool {
  o := jv_get(d, 0, key);
  if jv_kind(d, o) != JV_OBJECT || jv_len(d, o) != names.count { return false; }
  for i: 0..<names.count {
    m := jv_at(d, o, i);
    if jv_key(d, m) != names[i] || jv_int(d, m, FP_NONE) != values[i] { return false; }
  }
  return true;
}

// The fields each frame carries, in the room's order (the format's words after its head).
fp_fields :: (head: string) -> string {
  if head == "M1" { return "SEQ FORM SLOT"; }
  if head == "M3" { return "SEQ FORM SLOT SPIRIT"; }
  if head == "M4" || head == "m4" { return "SEQ ORDER"; }
  if head == "M6" { return "SEQ SEAT"; }
  if head == "M5" || head == "M7" || head == "U1" || head == "r" || head == "m5" || head == "m6" || head == "m7" { return "SEQ"; }
  if head == "m1" { return "SEQ FORM"; }
  if head == "m3" { return "SEQ STATUS"; }
  if head == "m8" { return "MODE"; }
  if head == "u1" { return "SEQ LEFT"; }
  if head == "m2" { return "TICK COUNT [OWNER FORM X Z HP MAX]..."; }
  return "";
}
fp_request :: (head: string) -> bool { return head == "M1" || head == "M3" || head == "M4" || head == "M5" || head == "M6" || head == "M7" || head == "U1"; }

// One "frames" entry against the room's reader (a request) or writer (a reply).
fp_frame :: (d: Jv, row: int, kit: bool) -> bool {
  tb: [3][1024] u8;
  key := fp_str(d, jv_get(d, row, "frame"), tb[0][..]);
  fmt := fp_str(d, jv_get(d, 0, key), tb[1][..]);
  text := fp_str(d, jv_get(d, row, "text"), tb[2][..]);
  vals := jv_get(d, row, "values");
  head := fp_word(fmt, 0);
  if key == "" || fmt == "" || text == "" || jv_kind(d, vals) != JV_OBJECT { return false; }
  fields := fp_fields(head);
  out: [1024] u8; n := -1;
  if head == "m2" {
    if fmt != "m2 TICK COUNT [OWNER FORM X Z HP MAX]..." || jv_len(d, vals) != 3 { return false; }
    if jv_key(d, jv_at(d, vals, 0)) != "TICK" || jv_key(d, jv_at(d, vals, 1)) != "COUNT" || jv_key(d, jv_at(d, vals, 2)) != "ROWS" { return false; }
    tick := jv_int(d, jv_at(d, vals, 0), FP_NONE); count := jv_int(d, jv_at(d, vals, 1), FP_NONE);
    rows_at := jv_at(d, vals, 2);
    if jv_kind(d, rows_at) != JV_ARRAY || count != jv_len(d, rows_at) || count > jv_int(d, jv_get(d, 0, "max_rows"), -1) { return false; }
    rows: [960] u8; size := 0;
    for i: 0..<count {
      r := jv_at(d, rows_at, i);
      if jv_kind(d, r) != JV_ARRAY || jv_len(d, r) != 6 { return false; }
      c: [6] int;
      for q: 0..<6 { c[q] = jv_int(d, jv_at(d, r, q), FP_NONE); if c[q] == FP_NONE { return false; } }
      size = e2_familiar_put_row(rows[..], size, c[0], c[1], c[2], c[3], c[4], c[5]);
    }
    n = e2_familiar_put_rows(out[..], tick, count, cast(string) rows[0..<size]);
    return n == text.count && cast(string) out[0..<n] == text;
  }
  // The format is the head, the room's fields and, for r, the reason.
  nf := fp_words(fields);
  if fields == "" || fp_words(fmt) != nf + 1 + (ifx head == "r" then 1 else 0) { return false; }
  for i: 0..<nf { if fp_word(fmt, i + 1) != fp_word(fields, i) { return false; } }
  if jv_len(d, vals) != nf { return false; }
  v: [4] int;
  for i: 0..<nf {
    m := jv_at(d, vals, i);
    if jv_key(d, m) != fp_word(fields, i) { return false; }
    v[i] = jv_int(d, m, FP_NONE);
    if v[i] == FP_NONE { return false; }
  }
  if fp_request(head) {
    if kit != (head == "U1") { return false; }
    if kit { n = egk_ask_put(out[..], v[0]); return n == text.count && cast(string) out[0..<n] == text && egk_ask_read(text) == v[0]; }
    a := e2_familiar_read(text);
    if !a.ok || a.seq != v[0] { return false; }
    if a.wizard != (head == "M3") || a.step != (head == "M5") || a.touch != (head == "M6") || a.sense != (head == "M7") { return false; }
    if a.lifecycle != (head == "M4" || head == "M5" || head == "M6" || head == "M7") { return false; }
    if (head == "M1" || head == "M3" || head == "M4" || head == "M6") && a.choice != v[1] { return false; }
    if (head == "M1" || head == "M3") && a.slot != v[2] { return false; }
    if head == "M3" && a.spirit != v[3] { return false; }
    return true;
  }
  if head == "r" {
    reason := fp_word(fmt, 2);
    if reason != (ifx kit then EGK_REFUSED else E2_FAMILIAR_REFUSED) { return false; }
    n = wire_put_refused(out[..], 0, v[0], reason);
  }
  else if head == "m1" { n = e2_familiar_put_done(out[..], 0, v[0], v[1]); }
  else if head == "m4" { if v[1] < E2_FAMILIAR_POCKET || v[1] > E2_FAMILIAR_RELEASE { return false; } n = e2_familiar_put_done(out[..], v[1], v[0], 0); }
  else if head == "m5" { n = e2_familiar_put_done(out[..], E2_FAMILIAR_STEP, v[0], 0); }
  else if head == "m6" { n = e2_familiar_put_done(out[..], E2_FAMILIAR_CURE, v[0], 0); }
  else if head == "m7" { n = e2_familiar_put_done(out[..], E2_FAMILIAR_SENSES, v[0], 0); }
  else if head == "m3" { n = e2_familiar_put_status(out[..], v[0], v[1]); }
  else if head == "m8" { n = e2_familiar_put_sense(out[..], v[0]); }
  else if head == "u1" {
    if !kit { return false; }
    n = egk_used_put(out[..], v[0], v[1]);
    u := egk_used_read(text);
    if !u.ok || u.seq != v[0] || u.left != v[1] { return false; }
  }
  return n == text.count && cast(string) out[0..<n] == text;
}

// A named whole number of object `key`, FP_NONE when it has none.
fp_named :: (d: Jv, key: string, name: string) -> int { return jv_int(d, jv_get(d, jv_get(d, 0, key), name), FP_NONE); }
// The wire 7 profile against familiar-wire.coax: the row kind, the E kinds, the orders, spirits,
// statuses and modes; each request's text read as its ask and written back; each answer written and
// read back; each malformed request and answer refused by every reader.
fp_v2 :: (d: Jv) -> bool {
  tb: [3][512] u8;
  row := jv_get(d, 0, "row"); fields := jv_get(d, row, "fields");
  mask := 0;
  names := [5] string.["g", "hp", "max", "owner", "p1"]; bits := [5] int.[WS_G, WS_HP, WS_MAX, WS_OWNER, WS_P1];
  if jv_kind(d, fields) != JV_ARRAY || jv_len(d, fields) != names.count { print("row.fields\n"); return false; }
  for i: 0..<names.count { if fp_str(d, jv_at(d, fields, i), tb[0][..]) != names[i] { print("row.fields %\n", i); return false; } mask = mask | (1 << bits[i]); }
  if (mask | WIRE_POSE) != wire_kind_fields(WK_FAMILIAR) || jv_int(d, jv_get(d, row, "kind"), FP_NONE) != WK_FAMILIAR ||
    jv_int(d, jv_get(d, row, "entity_base"), FP_NONE) != WIRE_ID_MADE + WIRE_FAM_EID || jv_int(d, jv_get(d, row, "count"), FP_NONE) != EG_SEATS || EG_SEATS != WIRE_SEATS { print("row\n"); return false; }
  use_names := [7] string.["summon", "rite", "order", "step", "cure", "senses", "kit"];
  use_kinds := [7] int.[WE_FAM_SUMMON, WE_FAM_RITE, WE_FAM_ORDER, WE_FAM_STEP, WE_FAM_CURE, WE_FAM_SENSES, WE_KIT];
  if jv_len(d, jv_get(d, 0, "uses")) != use_names.count || jv_len(d, jv_get(d, 0, "id")) != use_names.count { print("uses\n"); return false; }
  for i: 0..<use_names.count { if fp_named(d, "uses", use_names[i]) != use_kinds[i] || jv_get(d, jv_get(d, 0, "id"), use_names[i]) < 0 { print("uses %\n", use_names[i]); return false; } }
  order_names := [7] string.["summon", "pocket", "recall", "release", "step", "cure", "senses"];
  order_values := [7] int.[0, E2_FAMILIAR_POCKET, E2_FAMILIAR_RECALL, E2_FAMILIAR_RELEASE, E2_FAMILIAR_STEP, E2_FAMILIAR_CURE, E2_FAMILIAR_SENSES];
  if jv_len(d, jv_get(d, 0, "orders")) != order_names.count { print("orders\n"); return false; }
  for i: 0..<order_names.count { if fp_named(d, "orders", order_names[i]) != order_values[i] { print("orders %\n", order_names[i]); return false; } }
  if !fp_enum(d, "status", [3] string.["casting", "complete", "interrupted"], [3] int.[E2_WIZARD_CASTING, E2_WIZARD_COMPLETE, E2_WIZARD_INTERRUPTED]) { print("status\n"); return false; }
  if !fp_enum(d, "spirits", [3] string.["fey", "celestial", "fiend"], [3] int.[RS_FAMILIAR_FEY, RS_FAMILIAR_CELESTIAL, RS_FAMILIAR_FIEND]) { print("spirits\n"); return false; }
  if !fp_enum(d, "modes", [3] string.["owner", "sight", "sight_and_hearing"], [3] int.[E2_SENSE_OWNER, E2_SENSE_SIGHT, E2_SENSE_SIGHT_HEARING]) { print("modes\n"); return false; }
  if jv_int(d, jv_get(d, 0, "forms"), -1) != RS_FAMILIAR_FORMS.count || RS_FAMILIAR_FORMS.count > EGF_FORMS || RS_FAMILIAR_FIEND >= EGF_SPIRITS || EG_SEATS > EGF_SEATS { print("forms\n"); return false; }
  if jv_int(d, jv_get(d, 0, "max_left"), -1) != EGF_LEFT_MOST || EGF_LEFT_MOST != EGK_LEFT_MOST { print("max_left\n"); return false; }
  // the formats are the codec's words
  if fp_str(d, jv_get(d, 0, "request"), tb[0][..]) != "E SEQ KIND ID" || fp_str(d, jv_get(d, 0, "done"), tb[1][..]) != "e fam SEQ ORDER FORM" ||
    fp_str(d, jv_get(d, 0, "cast"), tb[2][..]) != "e fam-cast SEQ STATUS" { print("formats\n"); return false; }
  if fp_str(d, jv_get(d, 0, "kit"), tb[0][..]) != "e kit SEQ LEFT" || fp_str(d, jv_get(d, 0, "refusal"), tb[1][..]) != "r SEQ familiar" ||
    fp_str(d, jv_get(d, 0, "kit_refusal"), tb[2][..]) != "r SEQ kit" || E2_FAMILIAR_REFUSED != "familiar" || EGF_KIT_REFUSED != EGK_REFUSED { print("formats\n"); return false; }
  out: [256] u8;
  // each request: the text is an E the room reads as that ask, and the ask written is that text
  reqs := jv_get(d, 0, "requests"); seen: [6] bool;
  if jv_kind(d, reqs) != JV_ARRAY || jv_len(d, reqs) < 6 { print("requests\n"); return false; }
  for i: 0..<jv_len(d, reqs) {
    r := jv_at(d, reqs, i);
    text := fp_str(d, jv_get(d, r, "text"), tb[0][..]); use := fp_str(d, jv_get(d, r, "use"), tb[1][..]);
    rd := [1] WireRd.[wire_rd(text, 1)];
    u := wire_read_use(text, rd[..]);
    a := egf_use_read(u, RS_FAMILIAR_FEY);
    which := -1; for q: 0..<6 { if use == use_names[q] { which = q; } }
    if which < 0 || !wire_is(text, "E") || !rd[0].ok || wire_fields(text) != 4 || !a.ok || u.kind != use_kinds[which] { print("request %: %\n", i, text); return false; }
    seen[which] = true;
    if a.seq != jv_int(d, jv_get(d, r, "seq"), FP_NONE) || a.choice != jv_int(d, jv_get(d, r, "choice"), FP_NONE) || a.slot != jv_int(d, jv_get(d, r, "slot"), FP_NONE) ||
      a.spirit != jv_int(d, jv_get(d, r, "spirit"), FP_NONE) { print("request %: its values\n", i); return false; }
    if a.wizard != (which == 1) || a.lifecycle != (which >= 2) || a.step != (which == 3) || a.touch != (which == 4) || a.sense != (which == 5) { print("request %: its kind\n", i); return false; }
    n := wire_put_use(out[..], 0, egf_use_of(a));
    if cast(string) out[0..<n] != text || egf_kit_read(u) != 0 { print("request %: written %\n", i, cast(string) out[0..<n]); return false; }
  }
  for q: 0..<6 { if !seen[q] { print("requests: none for %\n", use_names[q]); return false; } }
  kits := jv_get(d, 0, "kit_requests");
  if jv_kind(d, kits) != JV_ARRAY || jv_len(d, kits) < 1 { print("kit_requests\n"); return false; }
  for i: 0..<jv_len(d, kits) {
    r := jv_at(d, kits, i);
    text := fp_str(d, jv_get(d, r, "text"), tb[0][..]);
    rd := [1] WireRd.[wire_rd(text, 1)];
    u := wire_read_use(text, rd[..]);
    seq := egf_kit_read(u);
    n := wire_put_use(out[..], 0, egf_kit_use(seq));
    if !wire_is(text, "E") || !rd[0].ok || wire_fields(text) != 4 || seq <= 0 || seq != jv_int(d, jv_get(d, r, "seq"), FP_NONE) || cast(string) out[0..<n] != text || egf_use_read(u, RS_FAMILIAR_FEY).ok { print("kit request %: %\n", i, text); return false; }
  }
  // each answer: written from its values it is the text, and the text reads back as them; kept, each
  answers := jv_get(d, 0, "answers"); kinds: [3] bool;
  if jv_kind(d, answers) != JV_ARRAY || jv_len(d, answers) < 3 { print("answers\n"); return false; }
  for i: 0..<jv_len(d, answers) {
    r := jv_at(d, answers, i);
    entry := fp_str(d, jv_get(d, r, "entry"), tb[0][..]); text := fp_str(d, jv_get(d, r, "text"), tb[1][..]);
    seq := jv_int(d, jv_get(d, r, "seq"), FP_NONE); a := jv_int(d, jv_get(d, r, "a"), FP_NONE); b := jv_int(d, jv_get(d, r, "b"), FP_NONE);
    n := -1; back := false;
    if entry == "done" { kinds[0] = true; n = egf_done_put(out[..], EgfDone.{seq = seq, order = a, form = b}); g := egf_done_read(text); back = g.ok && g.seq == seq && g.order == a && g.form == b && !egf_cast_read(text).ok && !egf_kit_used(text).ok; }
    if entry == "cast" { kinds[1] = true; n = egf_cast_put(out[..], EgfCast.{seq = seq, status = a}); g := egf_cast_read(text); back = g.ok && g.seq == seq && g.status == a && b == 0 && !egf_done_read(text).ok && !egf_kit_used(text).ok; }
    if entry == "kit" { kinds[2] = true; n = egf_kit_put(out[..], EgfKit.{seq = seq, left = a}); g := egf_kit_used(text); back = g.ok && g.seq == seq && g.left == a && b == 0 && !egf_done_read(text).ok && !egf_cast_read(text).ok; }
    if n < 0 || cast(string) out[0..<n] != text || !back || !egf_kept(text) || wire_outcome(text) || egc_kept(text) { print("answer %: %\n", i, text); return false; }
  }
  if !kinds[0] || !kinds[1] || !kinds[2] { print("answers: an entry has none\n"); return false; }
  // the refusals are the session's r, with these reasons
  refusals := jv_get(d, 0, "refusals");
  if jv_kind(d, refusals) != JV_ARRAY || jv_len(d, refusals) != 2 { print("refusals\n"); return false; }
  for i: 0..<2 {
    r := jv_at(d, refusals, i);
    text := fp_str(d, jv_get(d, r, "text"), tb[0][..]); reason := fp_str(d, jv_get(d, r, "reason"), tb[1][..]);
    n := wire_put_refused(out[..], 0, jv_int(d, jv_get(d, r, "seq"), FP_NONE), reason);
    if reason != (ifx i == 0 then E2_FAMILIAR_REFUSED else EGF_KIT_REFUSED) || cast(string) out[0..<n] != text { print("refusal %: %\n", i, text); return false; }
  }
  // what is malformed is refused whole: a request by both readers, an answer by all three
  bad := jv_get(d, 0, "malformed_requests");
  if jv_kind(d, bad) != JV_ARRAY || jv_len(d, bad) < 6 { print("malformed_requests\n"); return false; }
  for i: 0..<jv_len(d, bad) {
    t := fp_str(d, jv_at(d, bad, i), tb[0][..]);
    rd := [1] WireRd.[wire_rd(t, 1)];
    u := wire_read_use(t, rd[..]);
    if !wire_is(t, "E") || (rd[0].ok && wire_fields(t) == 4 && (egf_use_read(u, RS_FAMILIAR_FEY).ok || egf_kit_read(u) != 0)) { print("malformed request %: %\n", i, t); return false; }
  }
  worse := jv_get(d, 0, "malformed_answers");
  if jv_kind(d, worse) != JV_ARRAY || jv_len(d, worse) < 6 { print("malformed_answers\n"); return false; }
  for i: 0..<jv_len(d, worse) {
    t := fp_str(d, jv_at(d, worse, i), tb[0][..]);
    if egf_done_read(t).ok || egf_cast_read(t).ok || egf_kit_used(t).ok { print("malformed answer %: %\n", i, t); return false; }
  }
  return true;
}

fp_check :: (d: Jv, path: string) -> bool {
  tb: [2][512] u8;
  identity := fp_str(d, jv_get(d, 0, "identity"), tb[0][..]);
  if identity == "" || fp_str(d, jv_get(d, 0, "base_session"), tb[1][..]) != "everglade-session-v7" { return false; }
  want: [512] u8;
  wn := wire_put(want[..], wire_put(want[..], wire_put(want[..], 0, "proto/verse/"), identity), ".json");
  file := cast(string) want[0..<wn];
  if path.count < file.count || path[path.count - file.count..<path.count] != file { print("identity: not the file's name\n"); return false; }
  command: [512] u8;
  cn := wire_put(command[..], wire_put(command[..], 0, "coax/web/tool.sh coax/web/room/familiar-profile.coax "), file);
  if fp_str(d, jv_get(d, 0, "check"), tb[1][..]) != cast(string) command[0..<cn] { print("check: not %\n", cast(string) command[0..<cn]); return false; }
  kit := identity == "everglade-healers-kit-v1";
  if identity == "everglade2-familiar-v2" { return fp_v2(d); }

  // The enumerations each profile names are the room's constants.
  if identity == "everglade-familiar-v1" {
    forms := jv_get(d, 0, "forms");
    if jv_kind(d, forms) != JV_ARRAY || jv_len(d, forms) != RS_FAMILIAR_FORMS.count { return false; }
    for i: 0..<RS_FAMILIAR_FORMS.count {
      if !fp_same_name(fp_str(d, jv_at(d, forms, i), tb[1][..]), rs_monster_block(RS_FAMILIAR_FORMS[i]).name) { return false; }
    }
  }
  if identity == "everglade-find-familiar-v1" {
    if !fp_enum(d, "status", [3] string.["casting", "complete", "interrupted"], [3] int.[E2_WIZARD_CASTING, E2_WIZARD_COMPLETE, E2_WIZARD_INTERRUPTED]) { return false; }
    if !fp_enum(d, "spirits", [3] string.["fey", "celestial", "fiend"], [3] int.[RS_FAMILIAR_FEY, RS_FAMILIAR_CELESTIAL, RS_FAMILIAR_FIEND]) { return false; }
  }
  if identity == "everglade-familiar-lifecycle-v1" &&
    !fp_enum(d, "orders", [3] string.["pocket", "recall", "release"], [3] int.[E2_FAMILIAR_POCKET, E2_FAMILIAR_RECALL, E2_FAMILIAR_RELEASE]) { return false; }
  if identity == "everglade-familiar-senses-v1" &&
    !fp_enum(d, "modes", [3] string.["owner", "sight", "sight_and_hearing"], [3] int.[E2_SENSE_OWNER, E2_SENSE_SIGHT, E2_SENSE_SIGHT_HEARING]) { return false; }
  if identity == "everglade-familiar-state-v1" && jv_int(d, jv_get(d, 0, "max_rows"), -1) != EG_SEATS { return false; }

  // Every frame the profile names has a fixture, and each holds.
  frames := jv_get(d, 0, "frames");
  if jv_kind(d, frames) != JV_ARRAY || jv_len(d, frames) < 1 { return false; }
  requests := false;
  for key: FP_KEYS {
    at := jv_get(d, 0, key);
    if at < 0 { continue; }
    if key == "request" { requests = true; }
    seen := false;
    for i: 0..<jv_len(d, frames) { if fp_str(d, jv_get(d, jv_at(d, frames, i), "frame"), tb[1][..]) == key { seen = true; } }
    if !seen { return false; }
  }
  for i: 0..<jv_len(d, frames) {
    if !fp_frame(d, jv_at(d, frames, i), kit) {
      print("frame %: %\n", i, fp_str(d, jv_get(d, jv_at(d, frames, i), "text"), tb[1][..]));
      return false;
    }
  }

  // The room's reader refuses each malformed request.
  bad := jv_get(d, 0, "malformed");
  if requests && (jv_kind(d, bad) != JV_ARRAY || jv_len(d, bad) < 3) { return false; }
  for i: 0..<jv_len(d, bad) {
    t := fp_str(d, jv_at(d, bad, i), tb[1][..]);
    if kit && egk_ask_read(t) != 0 { print("malformed %: %\n", i, t); return false; }
    if !kit && e2_familiar_read(t).ok { print("malformed %: %\n", i, t); return false; }
  }
  // The kit's outcome: the page's reader refuses each malformed one, and LEFT's bound is the codec's.
  if kit {
    if jv_int(d, jv_get(d, 0, "max_left"), -1) != EGK_LEFT_MOST { print("max_left\n"); return false; }
    worse := jv_get(d, 0, "malformed_accepted");
    if jv_kind(d, worse) != JV_ARRAY || jv_len(d, worse) < 3 { return false; }
    for i: 0..<jv_len(d, worse) {
      t := fp_str(d, jv_at(d, worse, i), tb[1][..]);
      if egk_used_read(t).ok { print("malformed_accepted %: %\n", i, t); return false; }
    }
  }
  return true;
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) != 1 { tool_errln("usage: familiar-profile PROFILE.json"); return 2; }
  path := args_at(a[..], 0);
  text: [FP_FILE] u8; n := fs_read(path, text[..]);
  nodes: [2048] JvNode; d: [1] Jv;
  if n <= 0 || !jv_parse(d[..], cast(string) text[0..<n], nodes[..]) { tool_errln("familiar-profile: cannot parse JSON"); return 2; }
  if !fp_check(d[0], path) { print("%: profile fails\n", path); return 1; }
  print("%: profile holds\n", path);
  return 0;
}
