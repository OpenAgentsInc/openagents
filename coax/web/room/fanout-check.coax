// The instance fan-out check (#12717, spec sections 3.4 and 9): PLAYERS bots go into Everglade the way
// a page does, through the API's instance directory. Each is a guest (POST /api/playtest/player), asks
// for a seat ticket naming the realm (POST /api/playtest/room-ticket/REALM?realm=REALM: the API picks
// the instance and the oa-room shard that holds it), and opens the socket on that shard's path
// (wss://HOST/api/room/sK/relay/everglade/INSTANCE?t=...), which the load balancer sends to shard K.
// The realm is a test one, pair-fan-STAMP, so the bots never meet people (spec 3.4).
// Passes when every bot sat; instances 1, 2, ... filled 16 at a time; GET /api/playtest/rooms/REALM
// lists each instance on the shard its bots reached, with their count; and,
// once the bots leave, every instance closes and the list is empty.
//   coax/web/tool.sh coax/web/room/fanout-check.coax [https://openagents.com] [players=17] [seconds=10]
//   (FANOUT_ROOM_WS=ws://localhost:8830 sends the sockets to a room server on this machine)
// Bots run 8 to a process (a child: fanout-check.coax group SITE N SECONDS REALM GROUP); each prints
// "sat BOT ROOM SHARD PID" or "failed BOT WHY", then "seated" when its bots are in and "left" at the end.
// Prints one JSON line, then "fans out" and exits 0, or "fails" and 1.
#load "room-socket.coax";
#load "../../lib/net/http.coax";

FC_GROUP :: 8;             // bots a process (each socket's buffers are about 400 KB)
FC_MAX :: 256;
FC_SEATS :: 16;

// A flat JSON answer's field, its text without quotes ("" none).
fc_field :: (t: string, name: string) -> string {
  for i: 0..<t.count {
    if t[i] != '"' || i + name.count + 3 > t.count || t[i + 1..<i + 1 + name.count] != name || t[i + 1 + name.count] != '"' || t[i + 2 + name.count] != ':' { continue; }
    a := i + 3 + name.count;
    while a < t.count && t[a] == ' ' { a += 1; }   // {"key": "..."} too
    q := a < t.count && t[a] == '"';
    if q { a += 1; }
    e := a;
    while e < t.count && (ifx q then t[e] != '"' else (t[e] != ',' && t[e] != '}')) { e += 1; }
    return t[a..<e];
  }
  return "";
}
// wss://HOST for https://HOST (ws:// for http://).
fc_ws :: (site: string, out: [] u8) -> string {
  k := -1;
  if rs_starts(site, "https://") { k = rs_put(out, rs_put(out, 0, "wss://"), site[8..<site.count]); }
  else if rs_starts(site, "http://") { k = rs_put(out, rs_put(out, 0, "ws://"), site[7..<site.count]); }
  while k > 0 && out[k - 1] == '/' { k -= 1; }
  return ifx k < 0 then "" else cast(string) out[0..<k];
}

#test "fan-out: a JSON answer's fields; the socket's site" {
  a := "{\"ticket\":\"v3.p-1.0.-.r-2.2.9.-.ab\",\"id\":\"p-1\",\"room\":\"r-2\",\"shard\":2,\"full\":true}";
  #assert fc_field("{\"id\": \"p-1\", \"key\": \"ab\"}", "key") == "ab";
  #assert fc_field(a, "ticket") == "v3.p-1.0.-.r-2.2.9.-.ab" && fc_field(a, "room") == "r-2" && fc_field(a, "shard") == "2" && fc_field(a, "full") == "true" && fc_field(a, "x") == "";
  o: [64] u8;
  #assert fc_ws("https://openagents.com/", o[..]) == "wss://openagents.com" && fc_ws("http://localhost:8787", o[..]) == "ws://localhost:8787";
}

// One HTTP exchange: the status (0 none) and the body into out.
fc_http :: (w: [] HttpWork, method: string, url: string, key: string, body: string, out: [] u8, n: [] int) -> int {
  hk: [256] u8;
  kn := rs_put(hk[..], rs_put(hk[..], 0, "X-Verse-Player: "), key);
  hd := [3] string.["Content-Type: application/json", "X-Verse-Automation: fanout-check", cast(string) hk[0..<kn]];
  hs := ifx key.count > 0 then hd[..] else hd[0..<2];
  r := http_do(w, method, url, hs, body, 20000, 0, out);
  n[0] = ifx r.error == HTTP_OK then r.n else 0;
  return ifx r.error == HTTP_OK then r.code else 0;
}

// A child: N bots of group G, each into the realm, held SECONDS, then gone.
fc_group :: (site: string, bots: int, seconds: int, realm: string, group: int) -> int {
  if bots < 1 || bots > FC_GROUP { return 2; }
  w: [1] HttpWork; body: [8192] u8; bn: [1] int;
  c: [FC_GROUP] RelayConn;
  wb: [256] u8;
  ws := fc_ws(site, wb[..]);
  // FANOUT_ROOM_WS: the room server's own address, for a check on this machine (no load balancer)
  ob: [256] u8; own := proc_getenv("FANOUT_ROOM_WS", ob[..]);
  if own.count > 0 { ws = own; }
  u: [1024] u8;
  for i: 0..<bots {
    id := group * FC_GROUP + i;
    k := rs_put(u[..], rs_put(u[..], 0, site), "/api/playtest/player");
    st := fc_http(w[..], "POST", cast(string) u[0..<k], "", "{}", body[..], bn[..]);
    t := cast(string) body[0..<bn[0]];
    key := fc_field(t, "key");
    if st != 200 || key.count == 0 { print("failed % player %\n", id, st); continue; }
    kb: [128] u8; kc := rs_put(kb[..], 0, key);
    nb: [32] u8; nn := rs_int(nb[..], rs_put(nb[..], 0, "{\"name\":\"Fan "), id); nn = rs_put(nb[..], nn, "\"}");
    k = rs_put(u[..], rs_put(u[..], 0, site), "/api/playtest/room-ticket/"); k = rs_put(u[..], k, realm); k = rs_put(u[..], k, "?realm="); k = rs_put(u[..], k, realm);
    st = fc_http(w[..], "POST", cast(string) u[0..<k], cast(string) kb[0..<kc], cast(string) nb[0..<nn], body[..], bn[..]);
    t = cast(string) body[0..<bn[0]];
    ticket := fc_field(t, "ticket"); room := fc_field(t, "room"); shard := fc_field(t, "shard"); pid := fc_field(t, "id");
    if st != 200 || ticket.count == 0 || room.count == 0 || shard.count == 0 { print("failed % ticket %\n", id, st); continue; }
    rb: [32] u8; rn := rs_put(rb[..], 0, room); sb: [8] u8; sn := rs_put(sb[..], 0, shard); pb: [48] u8; pn := rs_put(pb[..], 0, pid);
    k = rs_put(u[..], 0, ws); k = rs_put(u[..], k, "/api/room/s"); k = rs_put(u[..], k, shard); k = rs_put(u[..], k, "/relay/everglade/");
    k = rs_put(u[..], k, room); k = rs_put(u[..], k, "?t="); k = rs_put(u[..], k, ticket);
    if k < 0 || !relay_conn_open(c[i..<i + 1], cast(string) u[0..<k]) { print("failed % open\n", id); continue; }
    // seated when the server says y
    sat := false; t0 := rs_now();
    while !sat && rs_now() - t0 < 10000 && c[i].h >= 0 {
      if relay_conn_poll(c[i..<i + 1], 50) == RC_TEXT && rs_starts(cast(string) c[i].text[0..<c[i].text_n], "y ") { sat = true; }
    }
    if sat { print("sat % % % %\n", id, cast(string) rb[0..<rn], cast(string) sb[0..<sn], cast(string) pb[0..<pn]); }
    else { print("failed % seat\n", id); }
  }
  print("seated\n");
  // held: each pings the clock every 2 s (a socket not heard for 20 s is closed) and reads what comes
  t0 := rs_now(); last := 0;
  while rs_now() - t0 < seconds * 1000 {
    if rs_now() - last >= 2000 {
      last = rs_now();
      m: [32] u8; mk := rs_int(m[..], rs_put(m[..], 0, "t "), last);
      for i: 0..<bots { if c[i].h >= 0 { r := relay_conn_send(c[i..<i + 1], cast(string) m[0..<mk]); } }
    }
    for i: 0..<bots { if c[i].h >= 0 { while relay_conn_poll(c[i..<i + 1], 0) == RC_TEXT {} } }
    proc_sleep(20);
  }
  for i: 0..<bots { if c[i].h >= 0 { r := relay_conn_close(c[i..<i + 1], 1000); } }
  print("left\n");
  return 0;
}

FcSat :: struct { room: [32] u8; room_n: int; shard: int; pid: [48] u8; pid_n: int; }

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("fanout-check: bad arguments"); return 2; }
  if args_count(a[..]) >= 6 && args_at(a[..], 0) == "group" {
    return fc_group(args_at(a[..], 1), rs_num(args_at(a[..], 2)), rs_num(args_at(a[..], 3)), args_at(a[..], 4), rs_num(args_at(a[..], 5)));
  }
  site := ifx args_count(a[..]) > 0 then args_at(a[..], 0) else "https://openagents.com";
  while site.count > 0 && site[site.count - 1] == '/' { site = site[0..<site.count - 1]; }
  players := ifx args_count(a[..]) > 1 then rs_num(args_at(a[..], 1)) else 17;
  seconds := ifx args_count(a[..]) > 2 then rs_num(args_at(a[..], 2)) else 10;
  if players < 1 || players > FC_MAX || seconds < 3 { tool_errln("usage: coax/web/tool.sh coax/web/room/fanout-check.coax [SITE] [players 1..256] [seconds >= 3] (from the repository's root)"); return 2; }
  rb: [32] u8; rn := rs_int(rb[..], rs_put(rb[..], 0, "pair-fan-"), rs_stamp());
  realm := cast(string) rb[0..<rn];
  groups := (players + FC_GROUP - 1) / FC_GROUP;
  hs: [FC_MAX / FC_GROUP] int;
  nb: [16] u8; secb: [16] u8; gb: [16] u8;
  secn := rs_int(secb[..], 0, seconds + 30);   // held past the list's check
  for g: 0..<groups {
    n := ifx g == groups - 1 then players - g * FC_GROUP else FC_GROUP;
    h := proc_new(); hs[g] = h;
    ok := proc_arg(h, "coax/web/tool.sh") && proc_arg(h, "coax/web/room/fanout-check.coax") && proc_arg(h, "group") && proc_arg(h, site) &&
          proc_arg(h, cast(string) nb[0..<rs_int(nb[..], 0, n)]) && proc_arg(h, cast(string) secb[0..<secn]) && proc_arg(h, realm) &&
          proc_arg(h, cast(string) gb[0..<rs_int(gb[..], 0, g)]);
    if !ok || proc_start(h) != 0 { tool_errln("fanout-check: can't start a group's process (run it from the repository's root)"); return 1; }
  }
  // a child's lines come when it ends (its output is a pipe), so the list is watched instead: once it
  // has every bot's seat (the shards report every few seconds), that is the list checked below
  w: [1] HttpWork; body: [16384] u8; bn: [1] int;
  u: [512] u8;
  k := rs_put(u[..], rs_put(u[..], rs_put(u[..], 0, site), "/api/playtest/rooms/"), realm);
  lb: [16384] u8; ln := 0; st := 0;
  t_list := rs_now();
  while rs_now() - t_list < 120000 {
    proc_sleep(2000);
    st = fc_http(w[..], "GET", cast(string) u[0..<k], "", "", body[..], bn[..]);
    ln = rs_put(lb[..], 0, cast(string) body[0..<bn[0]]);
    if ln < 0 { ln = 0; }
    seated := 0; t := cast(string) lb[0..<ln]; key := "\"players\":";
    for i: 0..<t.count { if i + key.count <= t.count && t[i..<i + key.count] == key { seated += rs_num(t[i + key.count..<t.count]); } }
    if st == 200 && seated >= players { proc_sleep(6000); st = fc_http(w[..], "GET", cast(string) u[0..<k], "", "", body[..], bn[..]); ln = rs_put(lb[..], 0, cast(string) body[0..<bn[0]]); if ln < 0 { ln = 0; } break; }
  }
  listed := cast(string) lb[0..<ln];
  // the bots' own word: which instance and shard each sat in
  sats: [FC_MAX] FcSat; sat_n := 0; failed := 0;
  line: [512] u8;
  for g: 0..<groups {
    while true {
      n := proc_line(hs[g], (seconds + 120) * 1000, line[..]);
      if n < 0 { break; }
      t := cast(string) line[0..<n];
      if rs_starts(t, "failed ") { failed += 1; tool_errln(t); continue; }
      if rs_starts(t, "sat ") && sat_n < FC_MAX {
        room := rs_field(t, 2); pid := rs_field(t, 4);
        for i: 0..<room.count { sats[sat_n].room[i] = room[i]; }
        for i: 0..<pid.count { sats[sat_n].pid[i] = pid[i]; }
        sats[sat_n].room_n = room.count; sats[sat_n].pid_n = pid.count; sats[sat_n].shard = rs_num(rs_field(t, 3));
        sat_n += 1;
      }
    }
    r := proc_wait(hs[g], 10000); q := proc_release(hs[g]);
  }
  // each instance REALM-N for N = 1.. holds 16 bots but the last, on the shard its bots reached,
  // and the list says so
  ok := failed == 0 && sat_n == players && st == 200;
  rooms := (players + FC_SEATS - 1) / FC_SEATS;
  shards: [FC_MAX / FC_SEATS] int;
  for r: 0..<rooms {
    want := ifx r == rooms - 1 then players - r * FC_SEATS else FC_SEATS;
    cb: [32] u8; cn := rs_int(cb[..], rs_put(cb[..], rs_put(cb[..], 0, realm), "-"), r + 1);
    code := cast(string) cb[0..<cn];
    got := 0; shard := 0; same := true;
    for i: 0..<sat_n {
      if cast(string) sats[i].room[0..<sats[i].room_n] != code { continue; }
      got += 1;
      if shard == 0 { shard = sats[i].shard; } else if shard != sats[i].shard { same = false; }
    }
    shards[r] = shard;
    // {"code":"REALM-N","players":P,"shard":K} in the list
    eb: [96] u8; en := rs_put(eb[..], 0, "{\"code\":\""); en = rs_put(eb[..], en, code); en = rs_put(eb[..], en, "\",\"players\":");
    en = rs_int(eb[..], en, got); en = rs_put(eb[..], en, ",\"shard\":"); en = rs_int(eb[..], en, shard); en = rs_put(eb[..], en, "}");
    entry := cast(string) eb[0..<en];
    found := false;
    for i: 0..<listed.count { if i + entry.count <= listed.count && listed[i..<i + entry.count] == entry { found = true; } }
    if got != want || !same || !found { ok = false; tool_err("fanout-check: "); tool_err(code); tool_errln(" is not as it should be"); }
  }
  closed := false; t0 := rs_now(); after: [4096] u8; an := 0;
  while !closed && rs_now() - t0 < 40000 {
    proc_sleep(3000);
    st = fc_http(w[..], "GET", cast(string) u[0..<k], "", "", body[..], bn[..]);
    an = rs_put(after[..], 0, cast(string) body[0..<bn[0]]);
    if an < 0 { an = 0; }
    closed = st == 200 && rs_ends(cast(string) after[0..<an], "\"rooms\":[]}");
  }
  if !closed { ok = false; tool_errln("fanout-check: an instance didn't close after its bots left"); }
  print("{\"realm\":\"%\",\"players\":%,\"seated\":%,\"failed\":%,\"shards\":[", realm, players, sat_n, failed);
  for r: 0..<rooms { if r > 0 { print(","); } print("%", shards[r]); }
  print("],\"listed\":%,\"closed\":%}\n%\n", cast(string) lb[0..<ln], ifx closed then "true" else "false", ifx ok then "fans out" else "fails");
  return ifx ok then 0 else 1;
}
rs_ends :: (t: string, end: string) -> bool { return t.count >= end.count && t[t.count - end.count..<t.count] == end; }
