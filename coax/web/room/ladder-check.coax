// The stars' responders in a room (#12794, #12872). One socket is the outlaw, a second (another
// page) stands by and watches the town's rows. The outlaw is WANTED one of two ways:
//   earn      it bolts the nearest of the town, its people and then the guards who come for it, until
//             the room says it is WANTED 3 (w);
//   arrive L [PID]  it joins already WANTED L (1 to 5), the level its ticket brings back as a room
//             saved it (room-vitals.coax rv_join): the carry-over of #12872;
//   rejoin L PID    player PID, who left this room server WANTED L, joins again on a ticket that
//             brings nothing back: the server's own note of it (rv_join) must.
// Then it stands. The level's roster (verse/everglade/watch.coax LADDER) must come in on the server,
// show on the other page as responders (their rows' FORM: rank + 1; 1 a Guard, 2 the Veteran, 4 the
// Knight, 5 the Priest, 8 a Scout), and fight: the outlaw's Hit Points drop. At WANTED 4 and over the
// doors row's FORM says the gates are shut on both pages; under 4 it says they are open.
//   coax/web/tool.sh coax/web/room/ladder-check.coax ws://127.0.0.1:PORT [SECONDS] [earn | arrive L [PID] | rejoin L PID]
// Run it against a local room (local.coax, or room --dev with its stand-in key as OA_ROOM_TICKET_KEY).
// Prints one JSON line, then "comes" and exits 0, or "fails" and 1.
#load "room-socket.coax";

LC_IDS :: 64;
LC_RANKS :: 8;   // watch.coax RANKS
// LADDER (verse/everglade/watch.coax): each level's roster by rank (Guard, Veteran, Mage, Knight,
// Priest, Archmage, Gladiator, Scout)
LC_LADDER :: [48] int.[
  0, 0, 0, 0, 0, 0, 0, 0,
  2, 0, 0, 0, 0, 0, 0, 0,
  4, 0, 0, 0, 0, 0, 0, 0,
  6, 0, 0, 0, 0, 0, 0, 2,
  8, 1, 0, 0, 0, 0, 0, 2,
  8, 1, 0, 1, 1, 0, 0, 2
];
LcHeard :: struct {
  w: bool; d: int; seat: int;
  me_x: f32; me_z: f32; me_seen: bool; hp: int = -1; hp_min: int = 1000000;
  near_i: int = -1; near_d: f32 = 1000000; near_x: f32; near_z: f32;
  wanted: int; wanted_most: int; wanted_first: int = -1;
  gates: int = -1;      // the doors row's FORM last heard (1 the gates shut)
  closest: f32 = 1000000;   // m: the nearest a responder came to this seat
  form: [LC_IDS] int;   // each townsperson's FORM last heard (an observer's)
  bad: int;
  m: [1] WireMirror;
}
lc_entry :: (h: [] LcHeard, me: int, t: string) {
  k := rs_field(t, 0);
  if k == "s" {
    w := wire_mirror_of(h[0].m[..], rs_num(rs_field(t, 1)));
    if w.id < 0 { h[0].bad += 1; return; }
    if w.kind == WK_DOORS { h[0].gates = w.form; return; }
    if w.kind == WK_PLAYER && w.id == me {
      h[0].me_x = w.x; h[0].me_z = w.z; h[0].me_seen = true; h[0].hp = w.hp;
      if w.hp < h[0].hp_min { h[0].hp_min = w.hp; }
      return;
    }
    if w.kind == WK_FOLK {
      i := w.id - WIRE_ID_FOLK;
      if i >= 0 && i < LC_IDS { h[0].form[i] = w.form; }
      d := (w.x - h[0].me_x) * (w.x - h[0].me_x) + (w.z - h[0].me_z) * (w.z - h[0].me_z);
      if w.form > 0 && h[0].me_seen && d < h[0].closest * h[0].closest { h[0].closest = sqrt(d); }
      if w.hp > 0 && (i == h[0].near_i || d < h[0].near_d) { h[0].near_i = i; h[0].near_d = d; h[0].near_x = w.x; h[0].near_z = w.z; }
      if w.hp <= 0 && i == h[0].near_i { h[0].near_i = -1; h[0].near_d = 1000000; }
    }
    return;
  }
  if k == "w" && rs_num(rs_field(t, 1)) == me {
    h[0].wanted = rs_num(rs_field(t, 2));
    if h[0].wanted_first < 0 { h[0].wanted_first = h[0].wanted; }
    if h[0].wanted > h[0].wanted_most { h[0].wanted_most = h[0].wanted; }
  }
}
lc_hear :: (h: [] LcHeard, t: string) {
  if rs_starts(t, "W ") { h[0].w = true; return; }
  if rs_starts(t, "y ") { h[0].seat = rs_num(rs_field(t, 1)); return; }   // its own seat
  if !rs_starts(t, "D ") { return; }
  h[0].d += 1;
  _ := wire_mirror_frame(h[0].m[..], t);
  at := 0; sp := 0;
  while at < t.count && sp < 5 { if t[at] == ' ' { sp += 1; } at += 1; }
  while at < t.count {
    e := at;
    while e < t.count && t[e] != ';' { e += 1; }
    lc_entry(h, h[0].seat, t[at..<e]);
    at = e + 1;
  }
}
lc_input :: (c: [] RelayConn, h: [] LcHeard, seq: [] int) -> bool {
  seq[0] += 1;
  m: [96] u8;
  k := rs_int(m[..], rs_put(m[..], 0, "I "), seq[0]);
  k = rs_put(m[..], k, " 0 0 0 0 0 0 "); k = rs_int(m[..], k, h[0].m[0].heard);
  return relay_conn_send(c, cast(string) m[0..<k]);
}
// Both stand still for ms, an input each 1/30 s, hearing everything.
lc_steps :: (c: [] RelayConn, h: [] LcHeard, seq: [] int, ms: int) -> bool {
  ok := true;
  t0 := rs_now(); n := 0;
  while rs_now() - t0 < ms {
    ok = lc_input(c[0..<1], h[0..<1], seq[0..<1]) && ok;
    ok = lc_input(c[1..<2], h[1..<2], seq[1..<2]) && ok;
    n += 1;
    while rs_now() - t0 < n * 1000 / 30 {
      for q: 0..<2 { while relay_conn_poll(c[q..<q + 1], 0) == RC_TEXT { lc_hear(h[q..<q + 1], cast(string) c[q].text[0..<c[q].text_n]); } }
      proc_sleep(2);
    }
  }
  return ok;
}
lc_count :: (h: [] LcHeard, form: int) -> int { n := 0; for i: 0..<LC_IDS { if h[0].form[i] == form { n += 1; } } return n; }
// Whether the watcher has heard level l's whole roster: of each rank, as many responders as LADDER has.
lc_roster :: (h: [] LcHeard, l: int) -> bool {
  for r: 0..<LC_RANKS { if lc_count(h, r + 1) < LC_LADDER[l * LC_RANKS + r] { return false; } }
  return true;
}
// A seat ticket for pid that brings WANTED `wanted` back (0 none), signed as an admin's with the stand-in
// key (OA_ROOM_TICKET_KEY), as rs_ticketed signs one.
lc_ticketed :: (out: [] u8, url: string, pid: string, name: string, wanted: int) -> string {
  kb: [TICKET_KEY] u8;
  key := proc_getenv("OA_ROOM_TICKET_KEY", kb[..]);
  if key.count < 32 { return url; }
  at := url.count;
  while at > 0 && url[at - 1] != '/' { at -= 1; }
  t: [TICKET_TEXT] u8;
  n := tk_sign_admin_wanted(key, pid, name, url[at..<url.count], 0, cxproc_wall_us() / 1000 + 300000, wanted, t[..]);
  if n == 0 || url.count + 3 + n > out.count { return ""; }
  k := rs_put(out, 0, url); k = rs_put(out, k, "?t="); k = rs_put(out, k, cast(string) t[0..<n]);
  return ifx k < 0 then "" else cast(string) out[0..<k];
}

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("ladder-check: bad arguments"); return 2; }
  b: [512] u8;
  base := rs_base(ifx args_count(a[..]) > 0 then args_at(a[..], 0) else "ws://localhost:8841", b[..]);
  secs := ifx args_count(a[..]) > 1 then rs_num(args_at(a[..], 1)) else 90;
  arrive := 0; rejoin := false;
  if args_count(a[..]) > 3 && (args_at(a[..], 2) == "arrive" || args_at(a[..], 2) == "rejoin") { arrive = rs_num(args_at(a[..], 3)); rejoin = args_at(a[..], 2) == "rejoin"; }
  if rejoin && args_count(a[..]) < 5 { tool_errln("ladder-check: rejoin takes L and PID"); return 2; }
  if arrive < 0 || arrive > 5 { tool_errln("ladder-check: arrive takes 1 to 5"); return 2; }
  goal := ifx arrive > 0 then arrive else 3;
  u: [1024] u8;
  url := rs_url(u[..], base, "/api/room/relay/everglade/", "pair-ladder-", rs_stamp());
  c: [2] RelayConn; h: [2] LcHeard; seq: [2] int;
  ua: [1024] u8; ub: [1024] u8;
  // the outlaw a new player each run: the room's own note of a player from the last 5 minutes outranks
  // its ticket (room-vitals.coax rv_join)
  pb: [64] u8;
  pk := rs_int(pb[..], rs_put(pb[..], 0, "p-laddercheck-a-"), rs_stamp());
  pid := ifx args_count(a[..]) > 4 then args_at(a[..], 4) else cast(string) pb[0..<pk];
  url_a := lc_ticketed(ua[..], url, pid, "Ladder Outlaw", ifx rejoin then 0 else arrive);
  url_b := rs_ticketed(ub[..], url, "p-laddercheck-b", "Ladder Watcher");
  if url.count == 0 || url_a.count == 0 || url_b.count == 0 || !relay_conn_open(c[1..<2], url_b) {
    tool_err("ladder-check: can't open "); tool_errln(url); print("fails\n"); return 1;
  }
  // the watcher sits first, then the outlaw
  sent := relay_conn_send(c[1..<2], "H 5 ranger.2.0.0 druid 64 Ladder Watcher");
  t00 := rs_now();
  while rs_now() - t00 < 1000 { while relay_conn_poll(c[1..<2], 0) == RC_TEXT { lc_hear(h[1..<2], cast(string) c[1].text[0..<c[1].text_n]); } proc_sleep(5); }
  if !relay_conn_open(c[0..<1], url_a) { tool_err("ladder-check: can't open "); tool_errln(url); print("fails\n"); return 1; }
  sent = relay_conn_send(c[0..<1], "H 5 ranger.1.0.0 druid 64 Ladder Outlaw") && sent;
  sent = lc_steps(c[..], h[..], seq[..], 2000) && sent;
  // earn: the outlaw's bolt at the nearest of the town standing, until WANTED 3 (or SECONDS)
  strikes := 0;
  m: [128] u8;
  t0 := rs_now();
  while arrive == 0 && h[0].wanted < goal && rs_now() - t0 < secs * 1000 {
    if h[0].near_i >= 0 {
      seq[0] += 1;
      k := rs_int(m[..], rs_put(m[..], 0, "C "), seq[0]);
      k = rs_put(m[..], k, " 1 "); k = rs_int(m[..], k, cast(int) (h[0].near_x * 100));
      k = rs_put(m[..], k, " 0 "); k = rs_int(m[..], k, cast(int) (h[0].near_z * 100)); k = rs_put(m[..], k, " ");
      k = rs_int(m[..], k, h[0].near_i);
      sent = relay_conn_send(c[0..<1], cast(string) m[0..<k]) && sent;
      strikes += 1;
    }
    sent = lc_steps(c[..], h[..], seq[..], 900) && sent;
  }
  reach_ms := rs_now() - t0;
  hp_at := h[0].hp;
  level := h[0].wanted;
  // then it stands: the roster comes in from the gates, and the other page sees them
  gates_seen := h[1].gates;
  t1 := rs_now();
  while rs_now() - t1 < secs * 1000 && !(lc_roster(h[1..<2], goal) && h[0].hp_min < hp_at) {
    sent = lc_steps(c[..], h[..], seq[..], 500) && sent;
    if h[0].wanted >= goal && h[0].hp > 0 { gates_seen = h[1].gates; }
  }
  came_ms := rs_now() - t1;
  gates_want := ifx goal >= 4 then 1 else 0;
  ok := sent && h[0].w && h[1].w && h[0].wanted_most >= goal && lc_roster(h[1..<2], goal) && h[0].hp_min < hp_at &&
        gates_seen == gates_want && h[0].bad == 0 && h[1].bad == 0;
  if arrive > 0 { ok = ok && h[0].wanted_first == arrive; }   // WANTED from its first word: the carry-over
  out: [1536] u8; o: [1] Jo;
  jo_start(o[..], out[..]);
  jo_obj(o[..]);
  jo_key(o[..], "mode"); jo_str(o[..], ifx rejoin then "rejoin" else ifx arrive > 0 then "arrive" else "earn");
  jo_key(o[..], "level"); jo_int(o[..], goal);
  jo_key(o[..], "strikes"); jo_int(o[..], strikes);
  jo_key(o[..], "wanted_first"); jo_int(o[..], h[0].wanted_first);
  jo_key(o[..], "wanted_most"); jo_int(o[..], h[0].wanted_most);
  jo_key(o[..], "ms_to_level"); jo_int(o[..], reach_ms);
  jo_key(o[..], "guards_seen_by_other_page"); jo_int(o[..], lc_count(h[1..<2], 1));
  jo_key(o[..], "scouts_seen_by_other_page"); jo_int(o[..], lc_count(h[1..<2], 8));
  jo_key(o[..], "veterans_seen_by_other_page"); jo_int(o[..], lc_count(h[1..<2], 2));
  jo_key(o[..], "knights_seen_by_other_page"); jo_int(o[..], lc_count(h[1..<2], 4));
  jo_key(o[..], "priests_seen_by_other_page"); jo_int(o[..], lc_count(h[1..<2], 5));
  jo_key(o[..], "ms_to_roster"); jo_int(o[..], came_ms);
  jo_key(o[..], "gates_on_other_page"); jo_int(o[..], gates_seen);
  jo_key(o[..], "hp_at_level"); jo_int(o[..], hp_at);
  jo_key(o[..], "hp_least"); jo_int(o[..], h[0].hp_min);
  jo_key(o[..], "closest_responder_cm"); jo_int(o[..], cast(int) (h[0].closest * 100));
  jo_key(o[..], "outlaw_x_cm"); jo_int(o[..], cast(int) (h[0].me_x * 100));
  jo_key(o[..], "outlaw_z_cm"); jo_int(o[..], cast(int) (h[0].me_z * 100));
  jo_key(o[..], "level_heard_at_start"); jo_int(o[..], level);
  jo_key(o[..], "bad_rows"); jo_int(o[..], h[0].bad + h[1].bad);
  jo_end(o[..]);
  print("%\n", jo_text(o[..]));
  _ := relay_conn_close(c[0..<1], 1000);
  _ = relay_conn_close(c[1..<2], 1000);
  print("%\n", ifx ok then "comes" else "fails");
  return ifx ok then 0 else 1;
}
