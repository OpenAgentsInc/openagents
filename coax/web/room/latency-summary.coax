// Summarize actual client observations. Raw timestamps and signed uncertainty
// intervals stay in the input record; this never substitutes unknown with zero.
#import "Basic";
#load "../../lib/sys/tool.coax";
#load "../../lib/sys/fs.coax";
#load "../../lib/json/json.coax";
LS_MAX :: 9007199254740991;
#test "latency record validation separates complete observations and clock uncertainty" {
  t:[23]int;for i:0..<23{t[i]=i+1;}t[0]=1;t[1]=2;t[2]=3;t[15]=100000;t[16]= -10;t[17]=10;t[18]= -5;t[19]=15;t[20]= -3;t[21]=17;t[22]=1;
  #assert ls_valid(t[..]);t[14]=t[13]-1;#assert !ls_valid(t[..]);t[14]=15;t[6]=t[5]-1;#assert !ls_valid(t[..]);t[6]=7;
  t[19]= -1;#assert !ls_valid(t[..]);t[22]=0;#assert ls_valid(t[..]);t[22]=2;#assert !ls_valid(t[..]);
}
#test "latency quantiles use nearest rank after ordering complete samples" {
  v:=[4]int.[8,2,5,1];#assert ls_q(v[..],4,50)==2&&ls_q(v[..],4,95)==8&&ls_q(v[..],4,100)==8;
}
ls_valid::(t:[]int)->bool {
  if t.count!=23{return false;}for i:0..<15{if t[i]<=0||t[i]>LS_MAX{return false;}}
  for i:5..<11{if t[i]<t[i-1]{return false;}}
  if t[11]<t[3]||t[12]<t[11]||t[13]<t[12]||t[14]<t[13]||t[14]-t[3]>=2000000||t[15]<0{return false;}
  if t[22]!=0&&t[22]!=1{return false;}
  return t[22]==0||(t[16]<=t[17]&&t[18]<=t[19]&&t[19]>=0&&t[20]<=t[21]&&t[21]>=0);
}
ls_q::(values:[]int,n:int,q:int)->int {
  sorted:[64]int;for i:0..<n{sorted[i]=values[i];for back:0..<i{j:=i-back;if sorted[j]<sorted[j-1]{x:=sorted[j];sorted[j]=sorted[j-1];sorted[j-1]=x;}}}
  return sorted[(n*q+99)/100-1];
}
tool_main::()->int #export_c {
  a:[1]Args;if !args_load(a[..])||args_count(a[..])!=1{tool_errln("usage: latency-summary OBSERVATION.json");return 2;}
  raw:[131072]u8;n:=fs_read(args_at(a[..],0),raw[..]);nodes:[8192]JvNode;d:[1]Jv;if n<1||!jv_parse(d[..],cast(string)raw[0..<n],nodes[..]){return 1;}
  if jv_len(d[0],jv_path(d[0],0,"errors"))!=0||jv_kind(d[0],jv_path(d[0],0,"trace.error"))!=JV_NULL{return 1;}
  active:=jv_path(d[0],0,"trace.active");if jv_len(d[0],active)!=1{return 1;}observer:=jv_at(d[0],active,0);rows:=jv_get(d[0],observer,"rows");count:=jv_len(d[0],rows);if count<5||count>64{return 1;}
  samples:[64][23]int;known:=0;
  for i:0..<count{row:=jv_at(d[0],rows,i);if jv_len(d[0],row)!=23{return 1;}for f:0..<23{samples[i][f]=jv_int(d[0],jv_at(d[0],row,f),LS_MAX+1);}
    if !ls_valid(samples[i][..]){return 1;}if samples[i][22]==1{known+=1;}
    if i>0&&(samples[i][0]>=samples[i-1][0]||samples[i][1]>=samples[i-1][1]){return 1;}
  }
  print("actual samples=%, bounded history=64, known one-way clock intervals=% (quantum100us, drift100ppm, freshness5s model)\n",count,known);
  print("expired=%, refused=%, missing=%; GPU completion is not physical scanout\n",jv_int(d[0],jv_get(d[0],observer,"expired"),-1),jv_int(d[0],jv_get(d[0],observer,"refused"),-1),jv_int(d[0],jv_get(d[0],observer,"missing"),-1));
  names:=[10]string.["input-to-completed-render","server input queue","movement step","remaining simulation","serialization","serialization-to-D-queue","browser dispatch","application-to-submit","GPU completion","interpolation delay"];
  from:=[10]int.[3,4,5,6,8,9,11,12,13,-1];to:=[10]int.[14,5,6,7,9,10,12,13,14,15];
  for k:0..<10{v:[64]int;for i:0..<count{v[i]=samples[i][to[k]]-(ifx from[k]>=0 then samples[i][from[k]] else 0);}
    print("% us: p50=% p95=% max=%\n",names[k],ls_q(v[..],count,50),ls_q(v[..],count,95),ls_q(v[..],count,100));
  }
  if known>0{
    width:[64]int;up_lo:[64]int;up_hi:[64]int;down_lo:[64]int;down_hi:[64]int;j:=0;
    for i:0..<count{if samples[i][22]!=1{continue;}width[j]=samples[i][17]-samples[i][16];up_lo[j]=samples[i][18];up_hi[j]=samples[i][19];down_lo[j]=samples[i][20];down_hi[j]=samples[i][21];j+=1;}
    print("offset interval width us: p50=% p95=% max=%\n",ls_q(width[..],known,50),ls_q(width[..],known,95),ls_q(width[..],known,100));
    print("uplink us: p50 interval=[%,%] p95 interval=[%,%]\n",ls_q(up_lo[..],known,50),ls_q(up_hi[..],known,50),ls_q(up_lo[..],known,95),ls_q(up_hi[..],known,95));
    print("D queue to WebSocket receipt us: p50 interval=[%,%] p95 interval=[%,%]\n",ls_q(down_lo[..],known,50),ls_q(down_hi[..],known,50),ls_q(down_lo[..],known,95),ls_q(down_hi[..],known,95));
  }
  return ifx known>0 then 0 else 1;
}
