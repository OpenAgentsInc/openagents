// The room's load test (ol-room): PLAYERS sockets join one Orbit League
// room, each reports a car at 60 Hz, and each counts the states it hears.
// Passes when every socket opened, every player hears >= 59 states a second
// and all hear the same ball (even seats as sent, odd seats turned round: x
// and z negated) within 2 mm.
//   coax/web/tool.sh coax/web/room/load.coax [ws://localhost:8830] [players=4] [seconds=10]
// Prints one JSON line, then "holds" and exits 0, or "fails" and 1.
//
// The everglade mode (spec section 11.3): PLAYERS sockets (default 64, up to 256) join the server's
// everglade rooms pair-load-STAMP-K in 16s (room-everglade.coax: the server's world), each sends its
// hello, an input every 1/30 s (I, a walk that turns), a cast every 5 s (C, Thunderbolt 5 m ahead)
// and a clock ping a second. Passes when every socket opened, every player hears >= 28 state frames
// (D) a second, sees every other seat's player, its ACK never goes back and in the end is its last
// input, and an input is acknowledged within 120 ms at the 95th percentile on this machine (a tick's
// wait) or, through wss:// (the load balancer), within 50 ms past the ping's round trip at the 95th
// percentile (#12731). The everglade2 mode is the same run in Everglade II's world (rooms pair-e2-load-STAMP-K,
// room-everglade.coax eg_e2_code): the clearing's ground, no town. There each bot says a Character
// Create class in its hello (srd-*, bot K the K-th of FB_CL_KIND round), casts its kit's first slot
// (ld_cast_slot: for the Fighter and the Paladin, whose first is a heal, the next) where it stands, and must hear its own e cast and, with
// company, the others' (#13058). A run that fails says why in its JSON line ("why": each bar missed).
//   coax/web/tool.sh coax/web/room/load.coax everglade [ws://localhost:8830] [players=64] [seconds=20] [stamp] [pings a second=1] [shards=0]
// shards 0: every room through /api/room/relay/ (shard 1, as before the directory); N: the rooms as
// the directory packs them (#12717), two to a shard, shard 1 first, up to N shards, each room's
// sockets on /api/room/sK/relay/ with v3 tickets for shard K.
// The rooms are pair-load-STAMP-1, -2, ... (STAMP from the clock unless given), so
// GET /api/playtest/rooms/pair-load-STAMP lists them while the run lasts (a test realm: never in
// everglade's own list). Each room's line also has the round trip's p99, the ACK's p99, and the
// state frames dropped (a D whose tick is more than EG_SEND past the last one; D carries every
// tick) and the frames the server refused (r). The bots are tagged as tests: their rooms are
// pair-* (left out of the rooms list), their seat tickets' player ids p-load-ROOM-K, their names
// "Load K", so a usage count can leave them out.
#run_steps 250000000;   // secp256k1's tables: the seat ticket's v5 check (metaverse-engine/session/seat-ticket.coax, #13260)
#load "room-socket.coax";
#load "script-player.coax";   // SP_HARM: what a bar's entry is for
#load "bot-bars.coax";        // each class's bar as the scripted player sees it (the cast a bot makes)
// The everglade2 mode's classes and casts (#13058): fivebar.coax FB_CL_KIND and class-kit.coax xk_slot
// (XK_SLOT0 + class * XK_PER), written here because the SRD engine's names clash with this tool's
// (rs_put); room-everglade.coax's e2 cast check holds the room to the same slots.
ld_xk_slot :: (c: int, i: int) -> int { return 128 + c * 24 + i; }
// The slot bot K's class casts: its kit's first, unless that is no press for a player who stands
// unhurt (bot-bars.coax, the scripted player's table, has it as a heal or not at all); then its bar's
// first harmful entry at level 1. The Fighter's first is Second Wind and the Paladin's Lay on Hands,
// which the room refuses at full Hit Points: with 20 bots those two heard none of their own casts
// and the run failed with no cause said (#13296).
ld_cast_slot :: (c: int) -> int {
  first := ld_xk_slot(c, 0); harm := -1;
  for r: 0..<BB_ROWS {
    o := r * BB_COLS;
    if BB[o] != c || BB[o + 1] != 1 { continue; }
    if BB[o + 2] == first && (BB[o + 3] & SP_HEAL) == 0 { return first; }
    if harm < 0 && (BB[o + 3] & SP_HARM) != 0 { harm = BB[o + 2]; }
  }
  return ifx harm >= 0 then harm else first;
}
#test "every class's cast is a slot of its own kit, and never the Fighter's or the Paladin's heal" {
  for c: 0..<RS_CL_N { s := ld_cast_slot(c); #assert s >= ld_xk_slot(c, 0) && s < ld_xk_slot(c + 1, 0); }
  #assert ld_cast_slot(4) == ld_xk_slot(4, 1) && ld_cast_slot(6) == ld_xk_slot(6, 1);
  for c: [10] int.[0, 1, 2, 3, 5, 7, 8, 9, 10, 11] { #assert ld_cast_slot(c) == ld_xk_slot(c, 0); }
}

LD_MAX :: 16;                 // players at most
LD_BALLS :: 64;               // recent ticks whose ball each player keeps
LdPlayer :: struct { heard: int; seat: int = -1; tick: int; gaps: int; ball_tick: [LD_BALLS] int; ball: [LD_BALLS * 3] int; }

#test "a state frame updates its player" {
  p: [1] LdPlayer;
  ld_hear(p[..], "s 5 1 0 0 0 0 0 0 0 11 -22 33 9");
  ld_hear(p[..], "s 7 1 0 0 0 0 0 0 0 1 2 3");
  ld_hear(p[..], "y 0 0");
  #assert p[0].heard == 2 && p[0].tick == 7 && p[0].seat == 1 && p[0].gaps == 1;
  b: [3] int;
  #assert ld_ball(p[..], 5, b[..]) && b[0] == 11 && b[1] == -22 && b[2] == 33 && !ld_ball(p[..], 6, b[..]);
}
#test "tenths, as toFixed(1) then Number prints them" {
  o: [64] u8;
  #assert ld_tenths(o[..], 600) == "60" && ld_tenths(o[..], 598) == "59.8" && ld_tenths(o[..], 5) == "0.5" && ld_tenths(o[..], -15) == "-1.5";
}

ld_hear :: (p: [] LdPlayer, t: string) {
  if rs_field(t, 0) != "s" { return; }
  tick := rs_num(rs_field(t, 1));
  if p[0].tick != 0 && tick != p[0].tick + 1 { p[0].gaps += 1; }
  p[0].tick = tick; p[0].seat = rs_num(rs_field(t, 2)); p[0].heard += 1;
  k := ((tick % LD_BALLS) + LD_BALLS) % LD_BALLS;
  p[0].ball_tick[k] = tick;
  for j: 0..<3 { p[0].ball[k * 3 + j] = rs_num(rs_field(t, 10 + j)); }
}
// The ball this player heard at tick, if it still has it.
ld_ball :: (p: [] LdPlayer, tick: int, out: [] int) -> bool {
  k := ((tick % LD_BALLS) + LD_BALLS) % LD_BALLS;
  if p[0].ball_tick[k] != tick || tick == 0 { return false; }
  for j: 0..<3 { out[j] = p[0].ball[k * 3 + j]; }
  return true;
}
// v/10 with one decimal, the decimal dropped when it is 0.
ld_tenths :: (out: [] u8, v: int) -> string {
  a := ifx v < 0 then -v else v;
  n := ifx v < 0 then rs_put(out, 0, "-") else 0;
  n = rs_int(out, n, a / 10);
  if a % 10 != 0 { n = rs_int(out, rs_put(out, n, "."), a % 10); }
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
ld_poll :: (c: [] RelayConn, p: [] LdPlayer, n: int) -> bool {
  got := false;
  for i: 0..<n {
    if c[i].h < 0 { continue; }
    while relay_conn_poll(c[i..<i + 1], 0) == RC_TEXT { ld_hear(p[i..<i + 1], cast(string) c[i].text[0..<c[i].text_n]); got = true; }
  }
  return got;
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("load: bad arguments"); return 2; }
  if args_count(a[..]) > 0 && args_at(a[..], 0) == "everglade" { return eg_load(a[..], false); }
  if args_count(a[..]) > 0 && args_at(a[..], 0) == "everglade2" { return eg_load(a[..], true); }
  if args_count(a[..]) > 0 && args_at(a[..], 0) == "everglade-room" { return eg_room_main(a[..], false); }
  if args_count(a[..]) > 0 && args_at(a[..], 0) == "everglade2-room" { return eg_room_main(a[..], true); }
  b: [512] u8;
  base := rs_base(ifx args_count(a[..]) > 0 then args_at(a[..], 0) else "ws://localhost:8830", b[..]);
  players := ifx args_count(a[..]) > 1 then rs_num(args_at(a[..], 1)) else 4;
  seconds := ifx args_count(a[..]) > 2 then rs_num(args_at(a[..], 2)) else 10;
  if players < 1 || players > LD_MAX || seconds < 1 { tool_errln("usage: coax/web/tool.sh coax/web/room/load.coax [URL] [players 1..16] [seconds]"); return 2; }
  stamp := rs_stamp();
  u: [1024] u8; nm: [32] u8;
  url := rs_url(u[..], base, "/api/room/orbit-league/", "load-", stamp);
  room := cast(string) nm[0..<rs_int(nm[..], rs_put(nm[..], 0, "load-"), stamp)];
  c: [LD_MAX] RelayConn; p: [LD_MAX] LdPlayer;
  open := 0;
  for i: 0..<players {
    // a cold service or a fresh edge can take a few seconds
    up := false;
    for attempt: 0..<3 { if !up && relay_conn_open(c[i..<i + 1], url) { up = true; } }
    if up { open += 1; }
  }
  start: [LD_MAX] int;
  for i: 0..<players { start[i] = p[i].heard; }
  msg: [128] u8;
  t0 := rs_now(); until := t0 + seconds * 1000;
  t := 0;
  while true {
    now := rs_now();
    if now >= until { break; }
    // tick t is due at t0 + t * 1000/60 ms
    if (now - t0) * 60 >= (t + 1) * 1000 {
      t += 1;
      z := -20000 + ((t * 300) % 40000);
      for i: 0..<players {
        if c[i].h < 0 { continue; }
        k := rs_put(msg[..], 0, "c "); k = rs_int(msg[..], k, i * 3000); k = rs_put(msg[..], k, " 900 "); k = rs_int(msg[..], k, z);
        k = rs_put(msg[..], k, " 0 0 0 10000 0 0 18000 0 0 0");
        r := relay_conn_send(c[i..<i + 1], cast(string) msg[0..<k]);
      }
    }
    if !ld_poll(c[..], p[..], players) { proc_sleep(1); }
  }
  dt := rs_now() - t0;
  // rates in tenths of a state a second
  rates: [LD_MAX] int; fast := true;
  for i: 0..<players {
    rates[i] = cast(int) ((cast(f64) (p[i].heard - start[i]) * 10000.0 / cast(f64) dt) + 0.5);
    if rates[i] < 590 { fast = false; }
  }
  // the same ball at the same tick
  tick := p[0].tick;
  for i: 0..<players { if p[i].tick < tick { tick = p[i].tick; } }
  tick -= 1;
  spread := 0.0; have := true;
  b0: [3] f64; bi: [3] int;
  for i: 0..<players {
    if !ld_ball(p[i..<i + 1], tick, bi[..]) { have = false; continue; }
    v: [3] f64;
    for j: 0..<3 { v[j] = cast(f64) bi[j]; }
    if p[i].seat % 2 != 0 { v[0] = -v[0]; v[2] = -v[2]; }
    if i == 0 { for j: 0..<3 { b0[j] = v[j]; } }
    d := sqrt((v[0] - b0[0]) * (v[0] - b0[0]) + (v[1] - b0[1]) * (v[1] - b0[1]) + (v[2] - b0[2]) * (v[2] - b0[2]));
    if d > spread { spread = d; }
  }
  out: [4096] u8; o: [1] Jo; tx: [32] u8;
  jo_start(o[..], out[..]);
  jo_obj(o[..]);
  jo_key(o[..], "room"); jo_str(o[..], room);
  jo_key(o[..], "open"); jo_int(o[..], open);
  jo_key(o[..], "seats"); jo_arr(o[..]); for i: 0..<players { jo_int(o[..], p[i].seat); } jo_end(o[..]);
  jo_key(o[..], "rates"); jo_arr(o[..]); for i: 0..<players { jo_raw(o[..], ld_tenths(tx[..], rates[i])); } jo_end(o[..]);
  jo_key(o[..], "gaps"); jo_arr(o[..]); for i: 0..<players { jo_int(o[..], p[i].gaps); } jo_end(o[..]);
  jo_key(o[..], "ball_spread_mm");
  if have { jo_raw(o[..], ld_tenths(tx[..], cast(int) (spread * 10.0 + 0.5))); } else { jo_null(o[..]); }
  jo_end(o[..]);
  print("%\n", jo_text(o[..]));
  ok := open == players && fast && have && spread < 2.0;
  print("%\n", ifx ok then "holds" else "fails");
  for i: 0..<players { if c[i].h >= 0 { r := relay_conn_close(c[i..<i + 1], 1000); } }
  return ifx ok then 0 else 1;
}

// ---- the everglade mode
EG_MAX :: 256;
EG_SEATS :: 16;
EG_HIST :: 2001;              // ms buckets, the last one "2 s or more"
EG_RING :: 128;               // inputs' send times kept, by SEQ
EG_SEND :: 1;                 // the server's ticks between D frames (room-everglade.coax EG_SEND)
EgPlayer :: struct {
  seat: int = -1; seq: int; ack: int; back: int;
  sent: [EG_RING] int;        // when input SEQ % EG_RING went out
  seen: [EG_SEATS] bool;      // the seats whose player it has heard
  d: int; d_counted: int;     // D frames, and those inside the measured window
  bytes: int;                 // the bytes of every frame heard inside the measured window
  d_tick: int; dropped: int; refused: int;   // the last D's tick; ticks missed past it; r frames
  d_at: int;                  // when the last new tick's D arrived (its gap to the next is a stall's length)
  next_i: int; next_c: int; next_t: int; steps: int;   // steps: the inputs sent (I), for their 30 Hz clock
  x: f32; z: f32;             // where the server has it
  cast_own: int; cast_other: int;   // e cast heard: its own, the others' (the everglade2 mode)
  m: [1] WireMirror;          // the rows its D's left, as the page's (its I's HEARD)
}
// lat: input to ACK; rtt: the clock ping; gap: from one new tick's D to the next (33 ms at 30 Hz; a
// lost packet on TCP holds every frame behind it, so the long gaps are what the network stalled, #12858)
EgRun :: struct { lat: [EG_HIST] int; rtt: [EG_HIST] int; gap: [EG_HIST] int; m0: int; m1: int; }

eg_hist_add :: (h: [] int, ms: int) { k := ifx ms < 0 then 0 else (ifx ms >= EG_HIST then EG_HIST - 1 else ms); h[k] += 1; }
// The ms at which q (in thousandths) of the counts lie at or below.
eg_hist_at :: (h: [] int, q: int) -> int {
  n := 0; for i: 0..<h.count { n += h[i]; }
  if n == 0 { return -1; }
  want := (n * q + 999) / 1000; k := 0;
  for i: 0..<h.count { k += h[i]; if k >= want { return i; } }
  return h.count - 1;
}
#test "the everglade load test's histogram" {
  h: [EG_HIST] int;
  #assert eg_hist_at(h[..], 950) == -1;
  for i: 0..<100 { eg_hist_add(h[..], i); }
  eg_hist_add(h[..], 99999); eg_hist_add(h[..], -3);
  #assert eg_hist_at(h[..], 500) == 49 && eg_hist_at(h[..], 950) == 95 && eg_hist_at(h[..], 1000) == EG_HIST - 1 && h[0] == 2;
}

eg_hear :: (p: [] EgPlayer, r: [] EgRun, t: string, now: int) {
  k := rs_field(t, 0);
  if now >= r[0].m0 && now < r[0].m1 { p[0].bytes += t.count; }
  if k == "y" { p[0].seat = rs_num(rs_field(t, 1)); return; }
  if k == "t" { if now >= r[0].m0 && now < r[0].m1 { eg_hist_add(r[0].rtt[..], now - rs_num(rs_field(t, 1))); } return; }
  if k == "r" { p[0].refused += 1; return; }
  if k != "D" { return; }
  p[0].d += 1;
  tick := rs_num(rs_field(t, 1));
  // a D a tick (F 2: more of this tick follows) every EG_SEND ticks: more than that past the last is a drop
  if p[0].d_tick > 0 && tick > p[0].d_tick + EG_SEND && now >= r[0].m0 && now < r[0].m1 { p[0].dropped += (tick - p[0].d_tick) / EG_SEND - 1; }
  if tick > p[0].d_tick {
    if p[0].d_at > 0 && now >= r[0].m0 && now < r[0].m1 { eg_hist_add(r[0].gap[..], now - p[0].d_at); }
    p[0].d_tick = tick; p[0].d_at = now;
  }
  if now >= r[0].m0 && now < r[0].m1 { p[0].d_counted += 1; }
  ack := rs_num(rs_field(t, 2));
  if ack < p[0].ack { p[0].back += 1; }
  if ack > p[0].ack {
    if ack > p[0].seq - EG_RING && now >= r[0].m0 && now < r[0].m1 { eg_hist_add(r[0].lat[..], now - p[0].sent[ack % EG_RING]); }
    p[0].ack = ack;
  }
  // the players in it, read as the page reads them (everglade-wire.coax's mirror)
  _ := wire_mirror_frame(p[0].m[..], t);
  for e: 0..<WIRE_MIRROR {
    en := p[0].m[0].ents[e];
    if !en.live || en.id < 0 || en.id >= EG_SEATS { continue; }
    p[0].seen[en.id] = true;
  }
  if p[0].seat >= 0 { me := wire_mirror_of(p[0].m[..], p[0].seat); if me.id >= 0 { p[0].x = me.x; p[0].z = me.z; } }
  // the casts it heard, as the page reads them (everglade/client/net.coax e2n_entry)
  rd: [1] WireRd; rd[0] = wire_rd(t, 1); d := wire_read_d(t, rd[..]);
  if rd[0].ok {
    from := rd[0].at;
    for q: 0..<wire_entries(t, from) {
      e := wire_entry(t, from, q);
      if !wire_is(e, "e cast") { continue; }
      rc: [1] WireRd; rc[0] = wire_rd(e, 6); ce := wire_read_cast_e(e, rc[..]);
      if !rc[0].ok { continue; }
      if ce.ss == p[0].seat { p[0].cast_own += 1; } else { p[0].cast_other += 1; }
    }
  }
}
// One more reason a run fails, joined to the ones before by "; " (-1 when it doesn't fit: the reasons are cut there).
eg_why :: (b: [] u8, n: int, t: string) -> int {
  if n < 0 { return n; }
  k := ifx n > 0 then rs_put(b, n, "; ") else n;
  return rs_put(b, k, t);
}
#test "a failing run's reasons are joined" {
  b: [64] u8;
  n := eg_why(b[..], 0, "sends failed"); n = eg_why(b[..], n, "an ACK went back");
  #assert cast(string) b[0..<n] == "sends failed; an ACK went back" && eg_why(b[0..<4], 0, "sends failed") == -1 && eg_why(b[..], -1, "x") == -1;
}
// A step of the random walk, from the run's clock and the player (no shared state).
eg_rand :: (i: int, t: int) -> int { x := (i * 7919 + t * 104729) % 2003; return x - 1001; }

// The whole run: a room of 16 a process (a process opens at most 16 sockets, CXSOCK_MAX), all
// started at once from the repository's root, each printing its JSON line and verdict.
eg_load :: (a: [] Args, e2: bool) -> int {
  url := ifx args_count(a) > 1 then args_at(a, 1) else "ws://localhost:8830";
  players := ifx args_count(a) > 2 then rs_num(args_at(a, 2)) else 64;
  seconds := ifx args_count(a) > 3 then rs_num(args_at(a, 3)) else 20;
  given := ifx args_count(a) > 4 then rs_num(args_at(a, 4)) else 0;
  hz := ifx args_count(a) > 5 then rs_num(args_at(a, 5)) else 1;
  shards := ifx args_count(a) > 6 then rs_num(args_at(a, 6)) else 0;
  if shards < 0 || shards > 6 { tool_errln("load: shards 0..6"); return 2; }
  if players < 2 || players > EG_MAX || seconds < 3 || hz < 1 || hz > 8 { tool_errln("usage: coax/web/tool.sh coax/web/room/load.coax everglade [URL] [players 2..256] [seconds >= 3] [stamp] [pings a second 1..8: inputs are 30 a second and the relay takes 40] (from the repository's root)"); return 2; }
  stamp := ifx given > 0 then given else rs_stamp();
  rooms := (players + EG_SEATS - 1) / EG_SEATS;
  hs: [EG_MAX / EG_SEATS] int;
  nb: [16] u8; sb: [16] u8; kb: [16] u8; secb: [16] u8; hzb: [16] u8;
  hzn := rs_int(hzb[..], 0, hz); shb: [16] u8;
  sn := rs_int(sb[..], 0, stamp); secn := rs_int(secb[..], 0, seconds);
  for k: 0..<rooms {
    n := ifx k == rooms - 1 then players - k * EG_SEATS else EG_SEATS;
    h := proc_new(); hs[k] = h;
    ok := proc_arg(h, "coax/web/tool.sh") && proc_arg(h, "coax/web/room/load.coax") && proc_arg(h, ifx e2 then "everglade2-room" else "everglade-room") && proc_arg(h, url) &&
          proc_arg(h, cast(string) nb[0..<rs_int(nb[..], 0, n)]) && proc_arg(h, cast(string) secb[0..<secn]) &&
          proc_arg(h, cast(string) sb[0..<sn]) && proc_arg(h, cast(string) kb[0..<rs_int(kb[..], 0, k + 1)]) && proc_arg(h, cast(string) hzb[0..<hzn]) &&
          proc_arg(h, cast(string) shb[0..<rs_int(shb[..], 0, ifx shards == 0 then 0 else (k / 2) % shards + 1)]);
    if !ok || proc_start(h) != 0 { tool_errln("load: can't start a room's process (run it from the repository's root)"); return 1; }
  }
  all := true; line: [8192] u8;
  print("{\"players\":%,\"realm\":\"%", players, ifx e2 then "pair-e2-load-" else "pair-e2-load-"); print("%\",\"rooms\":[", stamp);
  for k: 0..<rooms {
    json := 0; verdict := false;
    while true {
      n := proc_line(hs[k], (seconds + 120) * 1000, line[..]);
      if n < 0 { break; }
      t := cast(string) line[0..<n];
      if t.count > 0 && t[0] == '{' { if k > 0 { print(","); } print("%", t); json += 1; }
      if t == "holds" { verdict = true; }
    }
    if json == 0 { if k > 0 { print(","); } print("null"); }
    w := proc_wait(hs[k], 10000); r := proc_release(hs[k]);
    if !verdict { all = false; }
  }
  print("]}\n%\n", ifx all then "holds" else "fails");
  return ifx all then 0 else 1;
}
eg_room_main :: (a: [] Args, e2: bool) -> int {
  if args_count(a) < 6 { tool_errln("load: everglade-room URL PLAYERS SECONDS STAMP ROOM"); return 2; }
  b: [512] u8;
  base := rs_base(args_at(a, 1), b[..]);
  hz := ifx args_count(a) > 6 then rs_num(args_at(a, 6)) else 1;
  shard := ifx args_count(a) > 7 then rs_num(args_at(a, 7)) else 0;
  return eg_room(base, rs_num(args_at(a, 2)), rs_num(args_at(a, 3)), rs_num(args_at(a, 4)), rs_num(args_at(a, 5)), ifx hz < 1 then 1 else hz, shard, e2);
}
// One room of up to 16 players, pair-load-STAMP-ROOM (ROOM from 1), each pinging hz times a second, on
// oa-room shard `shard` (0: the old path, shard 1).
eg_room :: (base: string, players: int, seconds: int, stamp: int, room: int, hz: int, shard: int, e2: bool) -> int {
  if players < 1 || players > EG_SEATS { return 2; }
  c: [EG_SEATS] RelayConn; p: [EG_SEATS] EgPlayer; run: [1] EgRun;
  u: [1024] u8; nm: [64] u8;
  open := 0;
  t_open := rs_now();
  for i: 0..<players {
    k := rs_put(nm[..], 0, ifx e2 then "pair-e2-load-" else "pair-e2-load-"); k = rs_int(nm[..], k, stamp); k = rs_put(nm[..], k, "-"); k = rs_int(nm[..], k, room);
    n := rs_put(u[..], 0, base);
    if shard > 0 { n = rs_put(u[..], n, "/api/room/s"); n = rs_int(u[..], n, shard); n = rs_put(u[..], n, "/relay/everglade/"); }
    else { n = rs_put(u[..], n, "/api/room/relay/everglade/"); }
    n = rs_put(u[..], n, cast(string) nm[0..<k]);
    // each socket its own seat ticket (room-ticket.coax), when the environment has the key
    id: [48] u8; ik := rs_put(id[..], 0, "p-load-"); ik = rs_int(id[..], ik, room); ik = rs_put(id[..], ik, "-"); ik = rs_int(id[..], ik, i);
    ut: [1024] u8;
    url := rs_ticketed_on(ut[..], cast(string) u[0..<n], cast(string) id[0..<ik], "", shard);
    up := false;
    for attempt: 0..<3 { if !up && url.count > 0 && relay_conn_open(c[i..<i + 1], url) { up = true; } }
    if up { open += 1; }
    // read as we go, so nobody's output waits
    for j: 0..<i + 1 { if c[j].h >= 0 { while relay_conn_poll(c[j..<j + 1], 0) == RC_TEXT { eg_hear(p[j..<j + 1], run[..], cast(string) c[j].text[0..<c[j].text_n], rs_now()); } } }
  }
  open_ms := rs_now() - t_open;
  t0 := rs_now();
  // the measured window: from 1 s in to 1 s before the end (what was sent inside it)
  run[0].m0 = t0 + 1000; run[0].m1 = t0 + seconds * 1000 - 1000;
  until := t0 + seconds * 1000;
  msg0: [96] u8; hello_failed := 0;
  for i: 0..<players {
    p[i].next_i = t0 + (i * 7) % 33; p[i].next_c = t0 + 500 + (i * 211) % 5000; p[i].next_t = t0 + (i * 31) % (1000 / hz);
    k := rs_put(msg0[..], 0, "H 6 ranger.0.0.0 "); k = rs_put(msg0[..], k, ifx e2 then RS_CL_KIND[i % RS_CL_N] else "druid"); k = rs_put(msg0[..], k, " 64 Load "); k = rs_int(msg0[..], k, i);
    if c[i].h >= 0 && !relay_conn_send(c[i..<i + 1], cast(string) msg0[0..<k]) { hello_failed += 1; }
  }
  msg: [256] u8;
  sends_failed := hello_failed;
  while true {
    now := rs_now();
    if now >= until + 500 { break; }
    if now < until {
      for i: 0..<players {
        if c[i].h < 0 { continue; }
        if now >= p[i].next_i {
          // a walk that turns: ahead, with the camera's yaw going round once in 20 s
          p[i].seq += 1; p[i].sent[p[i].seq % EG_RING] = now;
          k := rs_put(msg[..], 0, "I "); k = rs_int(msg[..], k, p[i].seq);
          k = rs_put(msg[..], k, " 0 100 0 0 "); k = rs_int(msg[..], k, ((now - t0) * 62832 / 20000 + i * 4000) % 62832 - 31416);   // THETA in 0.1 mrad
          k = rs_put(msg[..], k, ifx p[i].seq % 90 < 45 then " 1 " else " 0 "); k = rs_int(msg[..], k, p[i].m[0].heard);
          if !relay_conn_send(c[i..<i + 1], cast(string) msg[0..<k]) { sends_failed += 1; }
          // on the page's clock: 30 a second exactly (33 ms a step ran 1% fast, so the server's queue
          // of a seat's inputs filled and held each one about 270 ms: #12731)
          p[i].next_i = t0 + (i * 7) % 33 + (p[i].steps + 1) * 1000 / 30; p[i].steps += 1;
        }
        if now >= p[i].next_c {
          p[i].seq += 1; p[i].sent[p[i].seq % EG_RING] = now;
          k := rs_put(msg[..], 0, "C "); k = rs_int(msg[..], k, p[i].seq);
          if e2 {   // its class's first slot, where it stands: within any ability's reach (eg_e2_cast)
            k = rs_put(msg[..], k, " "); k = rs_int(msg[..], k, ld_cast_slot(i % RS_CL_N)); k = rs_put(msg[..], k, " ");
            k = rs_int(msg[..], k, cast(int) (p[i].x * 100)); k = rs_put(msg[..], k, " 100 "); k = rs_int(msg[..], k, cast(int) (p[i].z * 100)); k = rs_put(msg[..], k, " -1");
          } else {
            k = rs_put(msg[..], k, " 1 ");
            k = rs_int(msg[..], k, cast(int) (p[i].x * 100) + 500); k = rs_put(msg[..], k, " 0 "); k = rs_int(msg[..], k, cast(int) (p[i].z * 100)); k = rs_put(msg[..], k, " -1");
          }
          if !relay_conn_send(c[i..<i + 1], cast(string) msg[0..<k]) { sends_failed += 1; }
          p[i].next_c += 5000;
        }
        if now >= p[i].next_t {
          k := rs_put(msg[..], 0, "t "); k = rs_int(msg[..], k, now);
          if !relay_conn_send(c[i..<i + 1], cast(string) msg[0..<k]) { sends_failed += 1; }
          p[i].next_t += 1000 / hz;
        }
      }
    }
    got := false;
    for i: 0..<players {
      if c[i].h < 0 { continue; }
      while relay_conn_poll(c[i..<i + 1], 0) == RC_TEXT { eg_hear(p[i..<i + 1], run[..], cast(string) c[i].text[0..<c[i].text_n], rs_now()); got = true; }
    }
    if !got { proc_sleep(1); }
  }
  // each player's state rate in tenths of a frame a second; who saw everyone; the ACKs
  window := run[0].m1 - run[0].m0;
  slowest := 1000000; alive := 0; blind := 0; back := 0; behind := 0; dropped := 0; refused := 0; bytes := 0;
  own := 0; other := 0; own_min := 1000000; other_min := 1000000;
  for i: 0..<players {
    if c[i].h >= 0 { alive += 1; }
    r := p[i].d_counted * 10000 / window;
    if r < slowest { slowest = r; }
    back += p[i].back; dropped += p[i].dropped; refused += p[i].refused; bytes += p[i].bytes;
    own += p[i].cast_own; other += p[i].cast_other;
    if p[i].cast_own < own_min { own_min = p[i].cast_own; } if p[i].cast_other < other_min { other_min = p[i].cast_other; }
    // the last input was a step (I) or a cast (C): either way the ACK is the last I stepped, at most 1 short
    if p[i].ack < p[i].seq - 1 { behind += 1; }
    for j: 0..<players { if p[j].seat >= 0 && !p[i].seen[p[j].seat] { blind += 1; } }
  }
  p95 := eg_hist_at(run[0].lat[..], 950); p50 := eg_hist_at(run[0].lat[..], 500); rtt := eg_hist_at(run[0].rtt[..], 500);
  p99 := eg_hist_at(run[0].lat[..], 990); rtt95 := eg_hist_at(run[0].rtt[..], 950); rtt99 := eg_hist_at(run[0].rtt[..], 990);
  pings := 0; for b: 0..<EG_HIST { pings += run[0].rtt[b]; }
  gap99 := eg_hist_at(run[0].gap[..], 990); gap_max := -1; stalls := 0;
  for b: 0..<EG_HIST { if run[0].gap[b] > 0 { gap_max = b; if b >= 100 { stalls += run[0].gap[b]; } } }
  out: [4096] u8; o: [1] Jo; tx: [32] u8;
  jo_start(o[..], out[..]);
  jo_obj(o[..]);
  jo_key(o[..], "room"); jo_int(o[..], room);
  jo_key(o[..], "shard"); jo_int(o[..], shard);
  jo_key(o[..], "players"); jo_int(o[..], players);
  jo_key(o[..], "open"); jo_int(o[..], open);
  jo_key(o[..], "open_ms"); jo_int(o[..], open_ms);
  jo_key(o[..], "still_open"); jo_int(o[..], alive);
  jo_key(o[..], "sends_failed"); jo_int(o[..], sends_failed);
  jo_key(o[..], "blind"); jo_int(o[..], blind);
  jo_key(o[..], "ack_back"); jo_int(o[..], back);
  jo_key(o[..], "ack_behind"); jo_int(o[..], behind);
  jo_key(o[..], "slowest_d_hz"); jo_raw(o[..], ld_tenths(tx[..], slowest));
  jo_key(o[..], "ack_p50_ms"); jo_int(o[..], p50);
  jo_key(o[..], "ack_p95_ms"); jo_int(o[..], p95);
  jo_key(o[..], "ack_p99_ms"); jo_int(o[..], p99);
  jo_key(o[..], "ping_rtt_ms"); jo_int(o[..], rtt);
  jo_key(o[..], "ping_rtt_p95_ms"); jo_int(o[..], rtt95);
  jo_key(o[..], "ping_rtt_p99_ms"); jo_int(o[..], rtt99);
  jo_key(o[..], "pings"); jo_int(o[..], pings);
  jo_key(o[..], "d_dropped"); jo_int(o[..], dropped);
  // the state's arrival gaps, all players: p99, the longest (2000: 2 s or more) and those of 100 ms or more
  jo_key(o[..], "d_gap_p99_ms"); jo_int(o[..], gap99);
  jo_key(o[..], "d_gap_max_ms"); jo_int(o[..], gap_max);
  jo_key(o[..], "d_stalls_100ms"); jo_int(o[..], stalls);
  jo_key(o[..], "refused"); jo_int(o[..], refused);
  // e cast heard, all players: their own and the others' (the everglade2 mode's casts, #13058)
  jo_key(o[..], "casts_own"); jo_int(o[..], own); jo_key(o[..], "casts_other"); jo_int(o[..], other);
  // what a player hears: the room's frames' bytes a second, each player's mean
  jo_key(o[..], "bytes_per_s"); jo_int(o[..], ifx window > 0 && players > 0 then bytes * 1000 / window / players else 0);
  // why it fails, when it does: each bar missed, by name, and for the casts which bots (#13296: a run
  // of 20 bots printed "fails" with every figure inside its bar and no cause)
  local := rs_starts(base, "ws://localhost");
  timely := ifx local then p95 >= 0 && p95 < 120 else true;
  casts_ok := !e2 || (own_min > 0 && (players < 2 || other_min > 0));
  wb: [512] u8; wn := 0;
  if open != players { wn = eg_why(wb[..], wn, "sockets not opened"); }
  if alive != players { wn = eg_why(wb[..], wn, "sockets closed before the end"); }
  if sends_failed != 0 { wn = eg_why(wb[..], wn, "sends failed"); }
  if blind != 0 { wn = eg_why(wb[..], wn, "a player not seen by another"); }
  if back != 0 { wn = eg_why(wb[..], wn, "an ACK went back"); }
  if behind != 0 { wn = eg_why(wb[..], wn, "an ACK behind its last input"); }
  if slowest < 280 { wn = eg_why(wb[..], wn, "under 28 state frames a second"); }
  if dropped != 0 { wn = eg_why(wb[..], wn, "state frames dropped"); }
  if !timely { wn = eg_why(wb[..], wn, "input-to-ACK p95 of 120 ms or more"); }
  if !casts_ok {
    wn = eg_why(wb[..], wn, "casts not heard:");
    for i: 0..<players {
      if p[i].cast_own > 0 && (players < 2 || p[i].cast_other > 0) { continue; }
      wn = rs_put(wb[..], rs_int(wb[..], rs_put(wb[..], wn, " bot "), i), " ("); wn = rs_put(wb[..], wn, RS_CL_KIND[i % RS_CL_N]);
      wn = rs_put(wb[..], wn, ifx p[i].cast_own == 0 then ", none of its own" else ", none of the others'"); wn = rs_put(wb[..], wn, ")");
    }
  }
  jo_key(o[..], "why"); jo_str(o[..], ifx wn > 0 then cast(string) wb[0..<wn] else "");
  jo_end(o[..]);
  print("%\n", jo_text(o[..]));
  // on this machine an input waits a tick at most (its D goes out the tick it is stepped); through the
  // load balancer an ACK is a round trip, so there the ping's round trip at the same percentile comes
  // off it and the rest, what the server adds, is held to 50 ms at the 95th percentile (#12731; the
  // spec's goal 3 was 250 ms past the median). The network's own spread (ping p95 against its median,
  // 60 ms and more from a busy machine) is not the server's.
  // Through the site the 50 ms is reported, not a failure: a deploy is stopped only by a regression it
  // causes (the network's spread there moves it by tens of ms from run to run).
  if !local { print("latency: input-to-ACK p95 % ms, ping p95 % ms, % ms past it (goal 50, reported only)\n", p95, rtt95, p95 - rtt95); }
  // the everglade2 mode: every bot heard its own casts and, with company, the others' (casts_ok, above)
  ok := open == players && alive == players && sends_failed == 0 && blind == 0 && back == 0 && behind == 0 && slowest >= 280 && dropped == 0 && timely && casts_ok;
  print("%\n", ifx ok then "holds" else "fails");
  for i: 0..<players { if c[i].h >= 0 { r := relay_conn_close(c[i..<i + 1], 200); } }
  return ifx ok then 0 else 1;
}
