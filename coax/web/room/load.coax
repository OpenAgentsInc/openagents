// The room's load test (ol-room): PLAYERS sockets join one Orbit League
// room, each reports a car at 60 Hz, and each counts the states it hears.
// Passes when every socket opened, every player hears >= 59 states a second
// and all hear the same ball (even seats as sent, odd seats turned round: x
// and z negated) within 2 mm.
//   coax/web/tool.sh coax/web/room/load.coax [ws://localhost:8830] [players=4] [seconds=10]
// Prints one JSON line, then "holds" and exits 0, or "fails" and 1.
//
// The everglade mode (spec section 11.3): PLAYERS sockets (default 64, up to 256) join the server's
// everglade rooms pair-load-STAMP-K in 16s (room-everglade.coax: the server's world), each sends its
// hello, an input every 1/30 s (I, a walk that turns), a cast every 5 s (C, Thunderbolt 5 m ahead)
// and a clock ping a second. Passes when every socket opened, every player hears >= 14 state frames
// (D) a second, sees every other seat's player, its ACK never goes back and in the end is its last
// input, and an input is acknowledged within 120 ms at the 95th percentile on this machine (a tick
// and a state frame's wait) or, through wss:// (the load balancer), within 250 ms past the median
// ping's round trip (the spec's goal 3).
//   coax/web/tool.sh coax/web/room/load.coax everglade [ws://localhost:8830] [players=64] [seconds=20]
#load "room-socket.coax";

LD_MAX :: 16;                 // players at most
LD_BALLS :: 64;               // recent ticks whose ball each player keeps
LdPlayer :: struct { heard: int; seat: int = -1; tick: int; gaps: int; ball_tick: [LD_BALLS] int; ball: [LD_BALLS * 3] int; }

#test "a state frame updates its player" {
  p: [1] LdPlayer;
  ld_hear(p[..], "s 5 1 0 0 0 0 0 0 0 11 -22 33 9");
  ld_hear(p[..], "s 7 1 0 0 0 0 0 0 0 1 2 3");
  ld_hear(p[..], "y 0 0");
  #assert p[0].heard == 2 && p[0].tick == 7 && p[0].seat == 1 && p[0].gaps == 1;
  b: [3] int;
  #assert ld_ball(p[..], 5, b[..]) && b[0] == 11 && b[1] == -22 && b[2] == 33 && !ld_ball(p[..], 6, b[..]);
}
#test "tenths, as toFixed(1) then Number prints them" {
  o: [64] u8;
  #assert ld_tenths(o[..], 600) == "60" && ld_tenths(o[..], 598) == "59.8" && ld_tenths(o[..], 5) == "0.5" && ld_tenths(o[..], -15) == "-1.5";
}

ld_hear :: (p: [] LdPlayer, t: string) {
  if rs_field(t, 0) != "s" { return; }
  tick := rs_num(rs_field(t, 1));
  if p[0].tick != 0 && tick != p[0].tick + 1 { p[0].gaps += 1; }
  p[0].tick = tick; p[0].seat = rs_num(rs_field(t, 2)); p[0].heard += 1;
  k := ((tick % LD_BALLS) + LD_BALLS) % LD_BALLS;
  p[0].ball_tick[k] = tick;
  for j: 0..<3 { p[0].ball[k * 3 + j] = rs_num(rs_field(t, 10 + j)); }
}
// The ball this player heard at tick, if it still has it.
ld_ball :: (p: [] LdPlayer, tick: int, out: [] int) -> bool {
  k := ((tick % LD_BALLS) + LD_BALLS) % LD_BALLS;
  if p[0].ball_tick[k] != tick || tick == 0 { return false; }
  for j: 0..<3 { out[j] = p[0].ball[k * 3 + j]; }
  return true;
}
// v/10 with one decimal, the decimal dropped when it is 0.
ld_tenths :: (out: [] u8, v: int) -> string {
  a := ifx v < 0 then -v else v;
  n := ifx v < 0 then rs_put(out, 0, "-") else 0;
  n = rs_int(out, n, a / 10);
  if a % 10 != 0 { n = rs_int(out, rs_put(out, n, "."), a % 10); }
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
ld_poll :: (c: [] RelayConn, p: [] LdPlayer, n: int) -> bool {
  got := false;
  for i: 0..<n {
    if c[i].h < 0 { continue; }
    while relay_conn_poll(c[i..<i + 1], 0) == RC_TEXT { ld_hear(p[i..<i + 1], cast(string) c[i].text[0..<c[i].text_n]); got = true; }
  }
  return got;
}

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("load: bad arguments"); return 2; }
  if args_count(a[..]) > 0 && args_at(a[..], 0) == "everglade" { return eg_load(a[..]); }
  if args_count(a[..]) > 0 && args_at(a[..], 0) == "everglade-room" { return eg_room_main(a[..]); }
  b: [512] u8;
  base := rs_base(ifx args_count(a[..]) > 0 then args_at(a[..], 0) else "ws://localhost:8830", b[..]);
  players := ifx args_count(a[..]) > 1 then rs_num(args_at(a[..], 1)) else 4;
  seconds := ifx args_count(a[..]) > 2 then rs_num(args_at(a[..], 2)) else 10;
  if players < 1 || players > LD_MAX || seconds < 1 { tool_errln("usage: coax/web/tool.sh coax/web/room/load.coax [URL] [players 1..16] [seconds]"); return 2; }
  stamp := rs_stamp();
  u: [1024] u8; nm: [32] u8;
  url := rs_url(u[..], base, "/api/room/orbit-league/", "load-", stamp);
  room := cast(string) nm[0..<rs_int(nm[..], rs_put(nm[..], 0, "load-"), stamp)];
  c: [LD_MAX] RelayConn; p: [LD_MAX] LdPlayer;
  open := 0;
  for i: 0..<players {
    // a cold service or a fresh edge can take a few seconds
    up := false;
    for attempt: 0..<3 { if !up && relay_conn_open(c[i..<i + 1], url) { up = true; } }
    if up { open += 1; }
  }
  start: [LD_MAX] int;
  for i: 0..<players { start[i] = p[i].heard; }
  msg: [128] u8;
  t0 := rs_now(); until := t0 + seconds * 1000;
  t := 0;
  while true {
    now := rs_now();
    if now >= until { break; }
    // tick t is due at t0 + t * 1000/60 ms
    if (now - t0) * 60 >= (t + 1) * 1000 {
      t += 1;
      z := -20000 + ((t * 300) % 40000);
      for i: 0..<players {
        if c[i].h < 0 { continue; }
        k := rs_put(msg[..], 0, "c "); k = rs_int(msg[..], k, i * 3000); k = rs_put(msg[..], k, " 900 "); k = rs_int(msg[..], k, z);
        k = rs_put(msg[..], k, " 0 0 0 10000 0 0 18000 0 0 0");
        r := relay_conn_send(c[i..<i + 1], cast(string) msg[0..<k]);
      }
    }
    if !ld_poll(c[..], p[..], players) { proc_sleep(1); }
  }
  dt := rs_now() - t0;
  // rates in tenths of a state a second
  rates: [LD_MAX] int; fast := true;
  for i: 0..<players {
    rates[i] = cast(int) ((cast(f64) (p[i].heard - start[i]) * 10000.0 / cast(f64) dt) + 0.5);
    if rates[i] < 590 { fast = false; }
  }
  // the same ball at the same tick
  tick := p[0].tick;
  for i: 0..<players { if p[i].tick < tick { tick = p[i].tick; } }
  tick -= 1;
  spread := 0.0; have := true;
  b0: [3] f64; bi: [3] int;
  for i: 0..<players {
    if !ld_ball(p[i..<i + 1], tick, bi[..]) { have = false; continue; }
    v: [3] f64;
    for j: 0..<3 { v[j] = cast(f64) bi[j]; }
    if p[i].seat % 2 != 0 { v[0] = -v[0]; v[2] = -v[2]; }
    if i == 0 { for j: 0..<3 { b0[j] = v[j]; } }
    d := sqrt((v[0] - b0[0]) * (v[0] - b0[0]) + (v[1] - b0[1]) * (v[1] - b0[1]) + (v[2] - b0[2]) * (v[2] - b0[2]));
    if d > spread { spread = d; }
  }
  out: [4096] u8; o: [1] Jo; tx: [32] u8;
  jo_start(o[..], out[..]);
  jo_obj(o[..]);
  jo_key(o[..], "room"); jo_str(o[..], room);
  jo_key(o[..], "open"); jo_int(o[..], open);
  jo_key(o[..], "seats"); jo_arr(o[..]); for i: 0..<players { jo_int(o[..], p[i].seat); } jo_end(o[..]);
  jo_key(o[..], "rates"); jo_arr(o[..]); for i: 0..<players { jo_raw(o[..], ld_tenths(tx[..], rates[i])); } jo_end(o[..]);
  jo_key(o[..], "gaps"); jo_arr(o[..]); for i: 0..<players { jo_int(o[..], p[i].gaps); } jo_end(o[..]);
  jo_key(o[..], "ball_spread_mm");
  if have { jo_raw(o[..], ld_tenths(tx[..], cast(int) (spread * 10.0 + 0.5))); } else { jo_null(o[..]); }
  jo_end(o[..]);
  print("%\n", jo_text(o[..]));
  ok := open == players && fast && have && spread < 2.0;
  print("%\n", ifx ok then "holds" else "fails");
  for i: 0..<players { if c[i].h >= 0 { r := relay_conn_close(c[i..<i + 1], 1000); } }
  return ifx ok then 0 else 1;
}

// ---- the everglade mode
EG_MAX :: 256;
EG_SEATS :: 16;
EG_HIST :: 2001;              // ms buckets, the last one "2 s or more"
EG_RING :: 128;               // inputs' send times kept, by SEQ
EgPlayer :: struct {
  seat: int = -1; seq: int; ack: int; back: int;
  sent: [EG_RING] int;        // when input SEQ % EG_RING went out
  seen: [EG_SEATS] bool;      // the seats whose player it has heard
  d: int; d_counted: int;     // D frames, and those inside the measured window
  next_i: int; next_c: int; next_t: int;
  x: f32; z: f32;             // where the server has it
}
EgRun :: struct { lat: [EG_HIST] int; rtt: [EG_HIST] int; m0: int; m1: int; }

eg_hist_add :: (h: [] int, ms: int) { k := ifx ms < 0 then 0 else (ifx ms >= EG_HIST then EG_HIST - 1 else ms); h[k] += 1; }
// The ms at which q (in thousandths) of the counts lie at or below.
eg_hist_at :: (h: [] int, q: int) -> int {
  n := 0; for i: 0..<h.count { n += h[i]; }
  if n == 0 { return -1; }
  want := (n * q + 999) / 1000; k := 0;
  for i: 0..<h.count { k += h[i]; if k >= want { return i; } }
  return h.count - 1;
}
#test "the everglade load test's histogram" {
  h: [EG_HIST] int;
  #assert eg_hist_at(h[..], 950) == -1;
  for i: 0..<100 { eg_hist_add(h[..], i); }
  eg_hist_add(h[..], 99999); eg_hist_add(h[..], -3);
  #assert eg_hist_at(h[..], 500) == 49 && eg_hist_at(h[..], 950) == 95 && eg_hist_at(h[..], 1000) == EG_HIST - 1 && h[0] == 2;
}

eg_hear :: (p: [] EgPlayer, r: [] EgRun, t: string, now: int) {
  k := rs_field(t, 0);
  if k == "y" { p[0].seat = rs_num(rs_field(t, 1)); return; }
  if k == "t" { eg_hist_add(r[0].rtt[..], now - rs_num(rs_field(t, 1))); return; }
  if k != "D" { return; }
  p[0].d += 1;
  if now >= r[0].m0 && now < r[0].m1 { p[0].d_counted += 1; }
  ack := rs_num(rs_field(t, 2));
  if ack < p[0].ack { p[0].back += 1; }
  if ack > p[0].ack {
    if ack > p[0].seq - EG_RING && now >= r[0].m0 && now < r[0].m1 { eg_hist_add(r[0].lat[..], now - p[0].sent[ack % EG_RING]); }
    p[0].ack = ack;
  }
  // the players in it: "p SS X Y Z ..." after "D TICK ACK F ", then after each ';'
  at := 0; sp := 0;
  while at < t.count && sp < 4 { if t[at] == ' ' { sp += 1; } at += 1; }
  while at < t.count {
    e := at;
    while e < t.count && t[e] != ';' { e += 1; }
    en := t[at..<e];
    if rs_starts(en, "p ") {
      ss := rs_num(rs_field(en, 1));
      if ss >= 0 && ss < EG_SEATS { p[0].seen[ss] = true; }
      if ss == p[0].seat { p[0].x = f32(rs_num(rs_field(en, 2))) / 100; p[0].z = f32(rs_num(rs_field(en, 4))) / 100; }
    }
    at = e + 1;
  }
}
// A step of the random walk, from the run's clock and the player (no shared state).
eg_rand :: (i: int, t: int) -> int { x := (i * 7919 + t * 104729) % 2003; return x - 1001; }

// The whole run: a room of 16 a process (a process opens at most 16 sockets, CXSOCK_MAX), all
// started at once from the repository's root, each printing its JSON line and verdict.
eg_load :: (a: [] Args) -> int {
  url := ifx args_count(a) > 1 then args_at(a, 1) else "ws://localhost:8830";
  players := ifx args_count(a) > 2 then rs_num(args_at(a, 2)) else 64;
  seconds := ifx args_count(a) > 3 then rs_num(args_at(a, 3)) else 20;
  if players < 2 || players > EG_MAX || seconds < 3 { tool_errln("usage: coax/web/tool.sh coax/web/room/load.coax everglade [URL] [players 2..256] [seconds >= 3] (from the repository's root)"); return 2; }
  stamp := rs_stamp();
  rooms := (players + EG_SEATS - 1) / EG_SEATS;
  hs: [EG_MAX / EG_SEATS] int;
  nb: [16] u8; sb: [16] u8; kb: [16] u8; secb: [16] u8;
  sn := rs_int(sb[..], 0, stamp); secn := rs_int(secb[..], 0, seconds);
  for k: 0..<rooms {
    n := ifx k == rooms - 1 then players - k * EG_SEATS else EG_SEATS;
    h := proc_new(); hs[k] = h;
    ok := proc_arg(h, "coax/web/tool.sh") && proc_arg(h, "coax/web/room/load.coax") && proc_arg(h, "everglade-room") && proc_arg(h, url) &&
          proc_arg(h, cast(string) nb[0..<rs_int(nb[..], 0, n)]) && proc_arg(h, cast(string) secb[0..<secn]) &&
          proc_arg(h, cast(string) sb[0..<sn]) && proc_arg(h, cast(string) kb[0..<rs_int(kb[..], 0, k)]);
    if !ok || proc_start(h) != 0 { tool_errln("load: can't start a room's process (run it from the repository's root)"); return 1; }
  }
  all := true; line: [8192] u8;
  print("{\"players\":%,\"rooms\":[", players);
  for k: 0..<rooms {
    json := 0; verdict := false;
    while true {
      n := proc_line(hs[k], (seconds + 120) * 1000, line[..]);
      if n < 0 { break; }
      t := cast(string) line[0..<n];
      if t.count > 0 && t[0] == '{' { if k > 0 { print(","); } print("%", t); json += 1; }
      if t == "holds" { verdict = true; }
    }
    if json == 0 { if k > 0 { print(","); } print("null"); }
    w := proc_wait(hs[k], 10000); r := proc_release(hs[k]);
    if !verdict { all = false; }
  }
  print("]}\n%\n", ifx all then "holds" else "fails");
  return ifx all then 0 else 1;
}
eg_room_main :: (a: [] Args) -> int {
  if args_count(a) < 6 { tool_errln("load: everglade-room URL PLAYERS SECONDS STAMP ROOM"); return 2; }
  b: [512] u8;
  base := rs_base(args_at(a, 1), b[..]);
  return eg_room(base, rs_num(args_at(a, 2)), rs_num(args_at(a, 3)), rs_num(args_at(a, 4)), rs_num(args_at(a, 5)));
}
// One room of up to 16 players, pair-load-STAMP-ROOM.
eg_room :: (base: string, players: int, seconds: int, stamp: int, room: int) -> int {
  if players < 1 || players > EG_SEATS { return 2; }
  c: [EG_SEATS] RelayConn; p: [EG_SEATS] EgPlayer; run: [1] EgRun;
  u: [1024] u8; nm: [64] u8;
  open := 0;
  t_open := rs_now();
  for i: 0..<players {
    k := rs_put(nm[..], 0, "pair-load-"); k = rs_int(nm[..], k, stamp); k = rs_put(nm[..], k, "-"); k = rs_int(nm[..], k, room);
    n := rs_put(u[..], 0, base); n = rs_put(u[..], n, "/api/room/relay/everglade/"); n = rs_put(u[..], n, cast(string) nm[0..<k]);
    up := false;
    for attempt: 0..<3 { if !up && relay_conn_open(c[i..<i + 1], cast(string) u[0..<n]) { up = true; } }
    if up { open += 1; }
    // read as we go, so nobody's output waits
    for j: 0..<i + 1 { if c[j].h >= 0 { while relay_conn_poll(c[j..<j + 1], 0) == RC_TEXT { eg_hear(p[j..<j + 1], run[..], cast(string) c[j].text[0..<c[j].text_n], rs_now()); } } }
  }
  open_ms := rs_now() - t_open;
  t0 := rs_now();
  // the measured window: from 1 s in to 1 s before the end (what was sent inside it)
  run[0].m0 = t0 + 1000; run[0].m1 = t0 + seconds * 1000 - 1000;
  until := t0 + seconds * 1000;
  msg0: [96] u8; hello_failed := 0;
  for i: 0..<players {
    p[i].next_i = t0 + (i * 7) % 33; p[i].next_c = t0 + 500 + (i * 211) % 5000; p[i].next_t = t0 + (i * 31) % 1000;
    k := rs_put(msg0[..], 0, "H 1 ranger.0.0.0 druid 0 Load "); k = rs_int(msg0[..], k, i);
    if c[i].h >= 0 && !relay_conn_send(c[i..<i + 1], cast(string) msg0[0..<k]) { hello_failed += 1; }
  }
  msg: [256] u8;
  sends_failed := hello_failed;
  while true {
    now := rs_now();
    if now >= until + 500 { break; }
    if now < until {
      for i: 0..<players {
        if c[i].h < 0 { continue; }
        if now >= p[i].next_i {
          // a walk that turns: ahead, with the camera's yaw going round once in 20 s
          p[i].seq += 1; p[i].sent[p[i].seq % EG_RING] = now;
          k := rs_put(msg[..], 0, "I "); k = rs_int(msg[..], k, p[i].seq);
          k = rs_put(msg[..], k, " 0 100 0 0 "); k = rs_int(msg[..], k, ((now - t0) * 628 / 20000 + i * 40) % 628 - 314);
          k = rs_put(msg[..], k, ifx p[i].seq % 90 < 45 then " 1" else " 0");
          if !relay_conn_send(c[i..<i + 1], cast(string) msg[0..<k]) { sends_failed += 1; }
          p[i].next_i += 33;
        }
        if now >= p[i].next_c {
          p[i].seq += 1; p[i].sent[p[i].seq % EG_RING] = now;
          k := rs_put(msg[..], 0, "C "); k = rs_int(msg[..], k, p[i].seq); k = rs_put(msg[..], k, " 1 ");
          k = rs_int(msg[..], k, cast(int) (p[i].x * 100) + 500); k = rs_put(msg[..], k, " 0 "); k = rs_int(msg[..], k, cast(int) (p[i].z * 100)); k = rs_put(msg[..], k, " -1");
          if !relay_conn_send(c[i..<i + 1], cast(string) msg[0..<k]) { sends_failed += 1; }
          p[i].next_c += 5000;
        }
        if now >= p[i].next_t {
          k := rs_put(msg[..], 0, "t "); k = rs_int(msg[..], k, now);
          if !relay_conn_send(c[i..<i + 1], cast(string) msg[0..<k]) { sends_failed += 1; }
          p[i].next_t += 1000;
        }
      }
    }
    got := false;
    for i: 0..<players {
      if c[i].h < 0 { continue; }
      while relay_conn_poll(c[i..<i + 1], 0) == RC_TEXT { eg_hear(p[i..<i + 1], run[..], cast(string) c[i].text[0..<c[i].text_n], rs_now()); got = true; }
    }
    if !got { proc_sleep(1); }
  }
  // each player's state rate in tenths of a frame a second; who saw everyone; the ACKs
  window := run[0].m1 - run[0].m0;
  slowest := 1000000; alive := 0; blind := 0; back := 0; behind := 0;
  for i: 0..<players {
    if c[i].h >= 0 { alive += 1; }
    r := p[i].d_counted * 10000 / window;
    if r < slowest { slowest = r; }
    back += p[i].back;
    // the last input was a step (I) or a cast (C): either way the ACK is the last I stepped, at most 1 short
    if p[i].ack < p[i].seq - 1 { behind += 1; }
    for j: 0..<players { if p[j].seat >= 0 && !p[i].seen[p[j].seat] { blind += 1; } }
  }
  p95 := eg_hist_at(run[0].lat[..], 950); p50 := eg_hist_at(run[0].lat[..], 500); rtt := eg_hist_at(run[0].rtt[..], 500);
  out: [4096] u8; o: [1] Jo; tx: [32] u8;
  jo_start(o[..], out[..]);
  jo_obj(o[..]);
  jo_key(o[..], "room"); jo_int(o[..], room);
  jo_key(o[..], "players"); jo_int(o[..], players);
  jo_key(o[..], "open"); jo_int(o[..], open);
  jo_key(o[..], "open_ms"); jo_int(o[..], open_ms);
  jo_key(o[..], "still_open"); jo_int(o[..], alive);
  jo_key(o[..], "sends_failed"); jo_int(o[..], sends_failed);
  jo_key(o[..], "blind"); jo_int(o[..], blind);
  jo_key(o[..], "ack_back"); jo_int(o[..], back);
  jo_key(o[..], "ack_behind"); jo_int(o[..], behind);
  jo_key(o[..], "slowest_d_hz"); jo_raw(o[..], ld_tenths(tx[..], slowest));
  jo_key(o[..], "ack_p50_ms"); jo_int(o[..], p50);
  jo_key(o[..], "ack_p95_ms"); jo_int(o[..], p95);
  jo_key(o[..], "ping_rtt_ms"); jo_int(o[..], rtt);
  jo_end(o[..]);
  print("%\n", jo_text(o[..]));
  // on this machine an input waits a tick and a state frame at most; through the load balancer an ACK
  // is a round trip, so there the median ping's round trip comes off it first and the rest is held to
  // the spec's goal 3 (250 ms at the 95th percentile)
  local := rs_starts(base, "ws://localhost");
  timely := ifx local then p95 >= 0 && p95 < 120 else p95 >= 0 && rtt >= 0 && p95 - rtt < 250;
  ok := open == players && alive == players && sends_failed == 0 && blind == 0 && back == 0 && behind == 0 && slowest >= 140 && timely;
  print("%\n", ifx ok then "holds" else "fails");
  for i: 0..<players { if c[i].h >= 0 { r := relay_conn_close(c[i..<i + 1], 200); } }
  return ifx ok then 0 else 1;
}
