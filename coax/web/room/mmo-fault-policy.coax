// Qualification orchestration only. This grants no production admission.
#authority;
MQ_SLICES::[4]string.["durable","overlap","startup","isolation"];
#test "MMO qualification selects only implemented bounded slices" {
  for name,i:MQ_SLICES{#assert mq_slice(name)==i;}
  for bad:[5]string.["","all","Durable","browser","unknown"]{#assert mq_slice(bad)== -1;}
  #assert mq_timeout(-1)==0&&mq_timeout(4)==0;
  #assert mq_timeout(0)==840000&&mq_timeout(1)==600000&&mq_timeout(2)==120000&&mq_timeout(3)==180000;
  #assert mq_marker(0)=="api: checkpoint2 checks passed"&&mq_marker(1)=="api: checks passed";
  #assert mq_marker(2)=="startup native:"&&mq_marker(3)=="stress:"&&mq_marker(-1)==""&&mq_marker(4)=="";
}
#forall "MMO qualification never converts a timeout, lost output or failed process into a pass" started:-1..<2,status:-1..<2,bits:0..<8 {
  #assert mq_pass(started,status,(bits&1)!=0,(bits&2)!=0,(bits&4)!=0)==(started==0&&status==0&&bits==4);
}
mq_slice::(name:string)->int{for name_at,i:MQ_SLICES{if name==name_at{return i;}}return -1;}
mq_timeout::(kind:int)->int{
  if kind==0{return 840000;}if kind==1{return 600000;}if kind==2{return 120000;}if kind==3{return 180000;}return 0;
}
mq_marker::(kind:int)->string{
  if kind==0{return "api: checkpoint2 checks passed";}if kind==1{return "api: checks passed";}
  if kind==2{return "startup native:";}if kind==3{return "stress:";}return "";
}
mq_pass::(started:int,status:int,timed:bool,cut:bool,complete:bool)->bool{return started==0&&status==0&&!timed&&!cut&&complete;}
