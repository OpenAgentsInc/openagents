// A moderator's commands against a running room (#13302, room-mod.coax; docs/protocol/moderation-v1.md):
// a moderator's socket and a player's sit in one room, the moderator sends each command, and the
// room's answers ("q ok ..." or "q no ...") are printed, one a line.
//   coax/web/tool.sh coax/web/room/moderation-check.coax MODERATOR_URL PLAYER_URL COMMAND...
// Each URL is the room's WebSocket address with its seat ticket (wss://HOST/api/room/.../CODE?t=TICKET),
// the moderator's signed for one of the realm's admins. A COMMAND is a record, "VERB PID MINUTES REASON"
// (quote it); the tool sends "X " and the record. Then the player's socket sends the first command as
// its own: a player's line must be told nothing. Exits 0 when every moderator's command was answered
// "q ok" and the player's was not answered; 1 otherwise. Use test accounts only.
#run_steps 250000000;   // secp256k1's tables: the seat ticket's v5 check (room-socket.coax loads room-ticket.coax)
#load "room-socket.coax";
#load "../../../aethyr/session/moderation.coax";

MC_ANSWERS :: 32;

McHeard :: struct { y: bool; n: int; ok: int; text: [MC_ANSWERS][MOD_LINE] u8; len: [MC_ANSWERS] int; refused: bool; }

mc_hear :: (h: [] McHeard, t: string) {
  if rs_starts(t, "y ") { h[0].y = true; return; }
  if rs_starts(t, "r ") { h[0].refused = true; return; }
  if !rs_starts(t, "q ") || h[0].n >= MC_ANSWERS || t.count > MOD_LINE { return; }
  for i: 0..<t.count { h[0].text[h[0].n][i] = t[i]; }
  h[0].len[h[0].n] = t.count; h[0].n += 1;
  if rs_starts(t, "q ok ") { h[0].ok += 1; }
}
// Both sockets heard for ms, or until `want` answers have come to socket q.
mc_wait :: (c: [] RelayConn, h: [] McHeard, ms: int, q: int, want: int) {
  t0 := rs_now();
  while rs_now() - t0 < ms && (want < 0 || h[q].n < want) {
    for i: 0..<c.count { while relay_conn_poll(c[i..<i + 1], 0) == RC_TEXT { mc_hear(h[i..<i + 1], cast(string) c[i].text[0..<c[i].text_n]); } }
    proc_sleep(5);
  }
}
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 3 {
    tool_errln("usage: coax/web/tool.sh coax/web/room/moderation-check.coax MODERATOR_URL PLAYER_URL COMMAND...");
    return 2;
  }
  c: [2] RelayConn; h: [2] McHeard;
  if !relay_conn_open(c[0..<1], args_at(a[..], 0)) || !relay_conn_open(c[1..<2], args_at(a[..], 1)) { tool_errln("moderation-check: can't open a socket (a ticket refused?)"); print("fails\n"); return 1; }
  sent := relay_conn_send(c[0..<1], "H 6 ranger.0.0.0 srd-fighter 0 Moderator") && relay_conn_send(c[1..<2], "H 6 ranger.0.0.0 srd-fighter 0 Player");
  mc_wait(c[..], h[..], 2000, 0, -1);
  if !sent || !h[0].y || !h[1].y || h[0].refused || h[1].refused { tool_errln("moderation-check: a seat did not sit"); print("fails\n"); return 1; }
  commands := args_count(a[..]) - 2;
  m: [MOD_LINE + 2] u8; first := 0;
  for i: 0..<commands {
    rec := args_at(a[..], 2 + i);
    r := moderation_read(rec, 0);
    k := ifx r.ok then moderation_command_write(m[..], r.verb, rec[r.pid_at..<r.pid_at + r.pid_n], r.minutes, rec[r.reason_at..<r.reason_at + r.reason_n]) else -1;
    if k < 0 { tool_err("moderation-check: not a record: "); tool_errln(rec); print("fails\n"); return 1; }
    if i == 0 { first = k; }
    sent = relay_conn_send(c[0..<1], cast(string) m[0..<k]) && sent;
    mc_wait(c[..], h[..], 3000, 0, i + 1);
  }
  // the player's own try, the first command again: told nothing
  r0 := moderation_read(args_at(a[..], 2), 0); rec0 := args_at(a[..], 2);
  first = moderation_command_write(m[..], r0.verb, rec0[r0.pid_at..<r0.pid_at + r0.pid_n], r0.minutes, rec0[r0.reason_at..<r0.reason_at + r0.reason_n]);
  sent = relay_conn_send(c[1..<2], cast(string) m[0..<first]) && sent;
  mc_wait(c[..], h[..], 1500, 1, 1);
  for i: 0..<h[0].n { print("%\n", cast(string) h[0].text[i][0..<h[0].len[i]]); }
  good := sent && h[0].n == commands && h[0].ok == commands && h[1].n == 0;
  print("moderation-check: % command(s), % answered ok, the player's own answered % time(s)\n", commands, h[0].ok, h[1].n);
  _ := relay_conn_close(c[0..<1], 500); _ = relay_conn_close(c[1..<2], 500);
  print("%\n", ifx good then "holds" else "fails");
  return ifx good then 0 else 1;
}
