// The Cultist Raid's check (room-events.coax, apps/openagents-web/everglade5e-room-raid.coax): N
// players (8 by default) share one Everglade room while a raid runs. Each stands where it came in and,
// about every 0.6 s, casts Starry Wisp (slot 22) at the nearest raider it sees by its TGT code
// (2000 + EID). The check counts what each heard: the raid's g entries (its phases, waves and leader),
// the raiders (c, kind 12, P1 27 to 30 a Cultist, Fanatic, Warlock or Darian Odiodei, 40 a ward
// stone), their casts (e rc), the hits on them (e hit), and the XP and levels it earned (e xp, e
// level, v). The raid's start and its dials are the room's control lines: run it as room-proof.coax raid
// does, with a local room server whose control URL is a file the script writes.
//   coax/web/tool.sh coax/web/room/raid-check.coax ws://127.0.0.1:8871 [N] [SECONDS] [ROOM]
// ROOM: the room's number (pair-raid-ROOM), so browser players (?relay=ws://localhost:8871&room=
// pair-raid-ROOM) can join the same raid; a number from the clock when it isn't given.
// CLASS: druid (the default), warlock, mix (every other seat a Warlock), or demo (every seat plays
// Everglade's own level 9 druid: the hello's EV_DEMO_FLAG on the admin's ticket, as cast-check does;
// a level 1 druid at the front falls often and lies EV_RISE_S, so it may earn nothing). MODE: square (the default:
// each walks to the square and holds it, casting at what comes in range; the siege stands outside the
// palisade, so nothing does) or fight (each goes into range of the nearest raider it sees, out
// through the South Gate, as a new player does, and casts its level 1 kit at it: the
// druid's Starry Wisp, Produce Flame and Ray of Frost, and Ice Knife while it has slots; the
// Warlock's Eldritch Blast, and Chill Touch up close). LEVEL2: 1 to fail unless every seat reached
// level 2 (the XP check, room-proof.coax raid RAID_LEVEL2=1).
//   coax/web/tool.sh coax/web/room/raid-check.coax URL N SECONDS ROOM CLASS MODE LEVEL2
// The siege (#12860): the town's watch (P1 21 to 24) are on the players' side, never a target. The
// check follows the front from each g entry's FRONT (permille of the road, 0 the cult's camp, 1000 the
// gate): its least and most, its share of seconds in the band before the palisade (500 to 860), the
// camp's fall (OUTCOME 1) and when, and the cult's regroup after it (the siege's phase again).
// EXPECT (arg 8): hold (the front in its band 80% of the time and the camp standing), fall (the camp
// falls and the cult regroups) or any.
//   coax/web/tool.sh coax/web/room/raid-check.coax URL N SECONDS ROOM CLASS MODE LEVEL2 EXPECT
// Prints one JSON line (each seat's XP, and the part of it after the outcome: the raid's end
// award), then "raids" and exits 0, or "fails" and 1.
#run_steps 250000000;   // secp256k1's tables: the seat ticket's v5 check (aethyr/session/seat-ticket.coax, #13260)
#load "room-socket.coax";
#load "raid-identity.coax";
#load "../../lib/sys/fs.coax";
#load "capacity-client.coax";
#load "../../../everglade/legacy/v1/points.coax";   // the South Gate and the muster, by name (#13078)
#load "../map-points.coax";

RC_MAX :: 16;
#test "raid skew injection is explicit and sends only one extra step per ten ticks" {
  #assert rc_skew(false,"")==0&&rc_skew(true,"0")==0&&rc_skew(true,"1")==1;
  #assert rc_skew(true,"")== -1&&rc_skew(true,"2")== -1;
}
rc_skew::(asked:bool,value:string)->int{if !asked||value=="0"{return 0;}return ifx value=="1" then 1 else -1;}
#test "capacity hold keeps bots alive after raid victory for the full declared interval" {
  #assert rc_early_end(false,false,10,101)&&!rc_early_end(false,false,10,100);
  #assert !rc_early_end(true,false,10,101)&&!rc_early_end(false,true,10,101)&&!rc_early_end(false,false,-1,101);
}
rc_early_end::(full:bool,capture:bool,ended:int,tick:int)->bool{return !full&&!capture&&ended>=0&&tick-ended>90;}
#test "raid shaped links distribute at most six sockets per existing proxy" {
  #assert rc_proxy_port(61262,0)==61262&&rc_proxy_port(61262,5)==61262&&rc_proxy_port(61262,6)==61263&&rc_proxy_port(61262,15)==61264;
  #assert rc_proxy_port(0,0)==0&&rc_proxy_port(65534,15)== -1&&rc_proxy_port(61262,-1)== -1&&rc_proxy_port(61262,16)== -1;
}
rc_proxy_port::(base:int,seat:int)->int{if seat<0||seat>=RC_MAX||base<0||base>65533{return -1;}return ifx base==0 then 0 else base+seat/6;}
#test "fleet characters are distinct across towns and seats" {
  a:[32]u8;b:[32]u8;c:[32]u8;
  #assert raid_identity(1284301,SeatId.{value=0},a[..])=="p-raidcheck-1284301-0";
  #assert raid_identity(1284301,SeatId.{value=0},a[..])!=raid_identity(1284302,SeatId.{value=0},b[..]);
  #assert raid_identity(1284301,SeatId.{value=0},a[..])!=raid_identity(1284301,SeatId.{value=1},c[..]);
}

rc_max :: (a: int, b: int) -> int { return ifx a > b then a else b; }
rc_min :: (a: int, b: int) -> int { return ifx a < b then a else b; }
RC_SEEN :: 128;
// Where the seats go, from Everglade's map (everglade/legacy/v1/points.coax, #13078): the commons' north
// side they muster on (raid-muster) and the palisade's South Gate they walk out through (gate-south,
// plan.coax EG_GATE, 6 m wide). The tool asks for both before it opens a seat.
RC_MAP_POINTS :: [2] string.["raid-muster", "gate-south"];
RcHeard :: struct {
  w: bool; d: int; me_x: f32; me_z: f32; me_seen: bool;
  phase_seen: int;                 // bit p: phase p was heard in a g entry
  wave_max: int; arch_seen: int;   // bit a: the leader's state a
  outcome: int;
  ids: [RC_SEEN] int; xs: [RC_SEEN] f32; zs: [RC_SEEN] f32; forms: [RC_SEEN] int; n: int;   // the raid creatures it sees now
  kinds: int;                      // bit (P1 - 20): the kinds it saw
  raiders_seen: int; casts: int; hits_on: int; breaks: int; xp: int; level: int; levels_heard: int; v_level: int;
  bad: int;
  seat: int = -1;                  // the seat the room gave it (its y frame); its index until then
  refused: int; r_cool: int; r_range: int; r_level: int; r_other: int; r_dead: int; r_busy: int; r_slot: int;
  flip: f32; last_gap: f32 = -1; gap_at: int; aside: int;   // the walk: the side it last stepped to, the gap a second ago, the tick its step aside ends
  wl: bool; casts_n: int;                        // a Warlock's seat; its casts sent, for the kit's turn
  xp_end: int;                                   // XP heard after the raid's outcome (its end award)
  v_xp: int;                                     // its XP as the room's v entry last said (the total)
  bytes: int;                                    // the bytes of every frame it heard
  timing:[1]CfTiming;peak_raiders:int;peak_pets:int;peak_zones:int;
  m: [1] WireMirror;                             // the rows its D's left, as the page's (its I's HEARD)
  // the siege (#12860): the front's least and most (permille), its samples and those in the band, the
  // sieges begun, the camp's fall (ms after the first siege), the watch at most, the phase now
  f_lo: int = 1000; f_hi: int; f_n: int; f_band: int; sieges: int; fall_ms: int = -1; regroup: bool;
  watch_hi: int; f_now: int = -1; phase: int = -1; siege_at: int = -1; fell: bool;
}
// The level 1 kit's next attack for seat h (fivebar.coax bar slots), and its reach in metres (the
// spell's range less a little, so the raider's step doesn't take it out of range).
rc_kit_slot :: (h: [] RcHeard, close: bool) -> int {
  n := h[0].casts_n;
  if h[0].wl { return ifx close && n % 2 == 1 then 71 else 64; }   // Chill Touch (touch), Eldritch Blast (120 ft)
  if n % 6 == 5 { return 13; }                                       // Ice Knife (60 ft), a 1st-level slot
  return ifx n % 3 == 0 then 22 else (ifx n % 3 == 1 then 21 else 43);   // Starry Wisp, Produce Flame, Ray of Frost (60 ft)
}
rc_reach :: (h: [] RcHeard) -> f32 { return ifx h[0].wl then 32.0f32 else 16.0f32; }
// The angle of (y, x), radians.
rc_atan2 :: (y: f32, x: f32) -> f32 {
  if x == 0 && y == 0 { return 0; }
  ax := ifx x < 0 then -x else x; ay := ifx y < 0 then -y else y;
  a := ifx ax > ay then ay / ax else ax / ay;
  s := a * a;
  r := ((-0.0464964749 * s + 0.15931422) * s - 0.327622764) * s * a + a;
  if ay > ax { r = 1.57079637 - r; }
  if x < 0 { r = 3.14159274 - r; }
  if y < 0 { r = -r; }
  return r;
}
rc_find :: (h: [] RcHeard, id: int) -> int { for q: 0..<h[0].n { if h[0].ids[q] == id { return q; } } return -1; }
rc_entry :: (h: [] RcHeard, me: int, t: string) {
  k := rs_field(t, 0);
  if k == "s" {
    // a row, read into the mirror with its frame (rc_hear): what it now says
    w := wire_mirror_of(h[0].m[..], rs_num(rs_field(t, 1)));
    if w.id < 0 { return; }
    if w.kind == WK_PLAYER && w.id == me { h[0].me_x = w.x; h[0].me_z = w.z; h[0].me_seen = true; return; }
    if w.kind != WK_BEAST || w.p1 < 20 { return; }
    form := w.p1;
    if form > 20 && form <= 24 { return; }   // the town's watch: on our side, not a target (#12860)
    id := w.id - WIRE_ID_MADE;
    q := rc_find(h, id);
    if q < 0 {
      if h[0].n >= RC_SEEN { return; }
      q = h[0].n; h[0].n += 1; h[0].raiders_seen += 1;
    }
    h[0].ids[q] = id; h[0].forms[q] = form;
    h[0].xs[q] = w.x; h[0].zs[q] = w.z;
    h[0].kinds = h[0].kinds | (1 << (form - 20));
    if form != 40 && (form < 27 || form > 31) { h[0].bad += 1; }   // 27 to 31: Cultist, Fanatic, Warlock, Darian, Cult Priest (#12771)
    return;
  }
  if k == "g" {
    p := rs_num(rs_field(t, 2));
    h[0].phase_seen = h[0].phase_seen | (1 << p);
    // the siege's phases (room-events.coax EV_SIEGE 7, EV_STAND 8): the front, the watch, its begins
    if (p == 7 || p == 8) && rs_field(t, 17).count > 0 {
      f := rs_num(rs_field(t, 17));
      h[0].f_now = f; h[0].f_lo = rc_min(h[0].f_lo, f); h[0].f_hi = rc_max(h[0].f_hi, f);
      h[0].watch_hi = rc_max(h[0].watch_hi, rs_num(rs_field(t, 18)));
    }
    if p == 7 && h[0].phase != 7 && h[0].phase != 8 {
      h[0].sieges += 1;
      if h[0].siege_at < 0 { h[0].siege_at = rs_now(); }
      if h[0].fell { h[0].regroup = true; }
    }
    if p == 5 && rs_num(rs_field(t, 12)) == 1 && !h[0].fell && h[0].siege_at >= 0 { h[0].fell = true; h[0].fall_ms = rs_now() - h[0].siege_at; }
    h[0].phase = p;
    h[0].wave_max = rc_max(h[0].wave_max, rs_num(rs_field(t, 3)));
    h[0].arch_seen = h[0].arch_seen | (1 << rs_num(rs_field(t, 11)));
    o := rs_num(rs_field(t, 12)); if o != 0 { h[0].outcome = o; }
    if rs_field(t, 15).count == 0 { h[0].bad += 1; }
    return;
  }
  if k == "v" {
    if rs_num(rs_field(t, 1)) == me { h[0].v_level = rs_num(rs_field(t, 2)); h[0].v_xp = rc_max(h[0].v_xp, rs_num(rs_field(t, 3))); }
    return;
  }
  if k == "x" {
    q := rc_find(h, rs_num(rs_field(t, 1)) - WIRE_ID_MADE);
    if q >= 0 { h[0].n -= 1; h[0].ids[q] = h[0].ids[h[0].n]; h[0].xs[q] = h[0].xs[h[0].n]; h[0].zs[q] = h[0].zs[h[0].n]; h[0].forms[q] = h[0].forms[h[0].n]; }
    return;
  }
  if k == "e" {
    w := rs_field(t, 1);
    if w == "rc" { h[0].casts += 1; if rs_field(t, 7).count == 0 { h[0].bad += 1; } }
    if w == "hit" && rs_num(rs_field(t, 2)) > 2000 { h[0].hits_on += 1; }
    if w == "break" { h[0].breaks += 1; }   // a piece of the town down, as the page hears it (the stables: #12769)
    if w == "xp" && rs_num(rs_field(t, 2)) == me { h[0].xp += rs_num(rs_field(t, 3)); if h[0].outcome != 0 { h[0].xp_end += rs_num(rs_field(t, 3)); } }
    if w == "level" && rs_num(rs_field(t, 2)) == me { h[0].level = rs_num(rs_field(t, 3)); h[0].levels_heard += 1; }
  }
}
rc_hear :: (h: [] RcHeard, me: int, t: string) {
  h[0].bytes += t.count;
  if rs_starts(t, "W ") { h[0].w = true; return; }
  if rs_starts(t, "y ") { h[0].seat = rs_num(rs_field(t, 1)); return; }
  if rs_starts(t, "r ") {
    h[0].refused += 1;
    why := rs_field(t, 2);
    if why == "cooldown" { h[0].r_cool += 1; } else if why == "range" { h[0].r_range += 1; } else if why == "level" { h[0].r_level += 1; } else if why == "dead" { h[0].r_dead += 1; } else if why == "busy" { h[0].r_busy += 1; } else if why == "slot" { h[0].r_slot += 1; } else { h[0].r_other += 1; }
    return;
  }
  if !rs_starts(t, "D ") { return; }
  h[0].d += 1;
  frame:=wire_mirror_frame(h[0].m[..], t);
  if frame.tick>=0&&h[0].m[0].heard==frame.tick&&(frame.f&2)==0{cf_ack(h[0].timing[..],frame.ack,rs_now());}
  if (rs_num(rs_field(t,3))&2)==0{
    raiders:=0;pets:=0;zones:=0;
    for e:0..<WIRE_MIRROR{w:=wire_mirror_get(h[0].m[..],e);if w.id<0{continue;}
      if w.kind==WK_BEAST&&w.hp>0{if w.p1>=27&&w.p1<=31{raiders+=1;}if w.p1==1&&w.owner>=0{pets+=1;}}
      if w.kind==WK_ZONE{zones+=1;}
    }
    h[0].peak_raiders=rc_max(h[0].peak_raiders,raiders);h[0].peak_pets=rc_max(h[0].peak_pets,pets);h[0].peak_zones=rc_max(h[0].peak_zones,zones);
  }
  at := 0; sp := 0;
  while at < t.count && sp < 5 { if t[at] == ' ' { sp += 1; } at += 1; }
  while at < t.count {
    e := at;
    while e < t.count && t[e] != ';' { e += 1; }
    rc_entry(h, ifx h[0].seat >= 0 then h[0].seat else me, t[at..<e]);
    at = e + 1;
  }
}
#test "raid transport capture preserves quotes and complete multiline frames" {
  b:[256]u8;row:=rc_capture_row(33,"D 4;name \"Raid\"\n",b[..]);j:[1]Jv;nodes:[8]JvNode;
  #assert jv_parse(j[..],row,nodes[..]) && jv_int(j[0],jv_at(j[0],0,0),-1)==33;
  decoded:[64]u8;n:=jv_str(j[0],jv_at(j[0],0,1),decoded[..]);#assert cast(string)decoded[0..<n]=="D 4;name \"Raid\"\n";
}
rc_capture_row :: (stamp:int,text:string,out:[]u8)->string {
  o:[1]Jo;jo_start(o[..],out);jo_arr(o[..]);jo_int(o[..],stamp);jo_str(o[..],text);jo_end(o[..]);return ifx o[0].bad then "" else jo_text(o[..]);
}
rc_drain :: (c: [] RelayConn, h: [] RcHeard, n: int,capture:string,started:int,written:[]int) {
  for i: 0..<n { while relay_conn_poll(c[i..<i + 1], 0) == RC_TEXT {
    text:=cast(string)c[i].text[0..<c[i].text_n];
    if i==0 && capture.count>0 {
      buf:[32768]u8;row:=rc_capture_row(rs_now()-started,text,buf[..]);
      if row.count==0 {tool_errln("raid-check: capture frame exceeds fixture limit");return;}
      if written[0]>0 {comma:=fs_append(capture,",");}saved:=fs_append(capture,row);written[0]+=1;
    }
    rc_hear(h[i..<i + 1], i, text);
  } }
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("raid-check: bad arguments"); return 2; }
  if args_has(a[..], "--help") { print("usage: coax/web/tool.sh coax/web/room/raid-check.coax RELAY N SECONDS ROOM CLASS [fight]\n"); return 0; }
  mp_names := EG_POINT_NAME; mp_at := EG_POINT_AT; mp_want := RC_MAP_POINTS;
  if !map_need_all(EG_POINTS_ZONE, mp_names[..], mp_at[..], mp_want[..]) { print("fails\n"); return 2; }
  muster := eg_point("raid-muster"); gate := eg_point("gate-south");
  b: [512] u8;
  base := rs_base(ifx args_count(a[..]) > 0 then args_at(a[..], 0) else "ws://127.0.0.1:8871", b[..]);
  n := ifx args_count(a[..]) > 1 then rc_max(rc_min(rs_num(args_at(a[..], 1)), RC_MAX), 1) else 8;
  secs := ifx args_count(a[..]) > 2 then rc_max(rs_num(args_at(a[..], 2)), 10) else 150;
  u: [1024] u8;
  room := ifx args_count(a[..]) > 3 then rs_num(args_at(a[..], 3)) else rs_stamp();
  url := rs_url(u[..], base, "/api/room/relay/everglade/", "pair-e2-raid-", room);
  proxy_b:[24]u8;proxy_text:=proc_getenv("RAID_PROXY_BASE",proxy_b[..]);proxy_base:=ifx proxy_text=="" then 0 else args_whole(proxy_text);
  if rc_proxy_port(proxy_base,n-1)<0{tool_errln("RAID_PROXY_BASE must leave three permitted adjacent loopback ports");return 2;}
  skew_b:[8]u8;skew:=rc_skew(proc_has_env("RAID_SKEW"),proc_getenv("RAID_SKEW",skew_b[..]));if skew<0{return 2;}
  full_b:[8]u8;full:=rc_skew(proc_has_env("RAID_RUN_FULL"),proc_getenv("RAID_RUN_FULL",full_b[..]));if full<0{return 2;}
  klass := ifx args_count(a[..]) > 4 then args_at(a[..], 4) else "druid";
  fight := args_count(a[..]) > 5 && args_at(a[..], 5) == "fight";
  want2 := args_count(a[..]) > 6 && args_at(a[..], 6) == "1";
  expect := ifx args_count(a[..]) > 7 then args_at(a[..], 7) else "any";
  c: [RC_MAX] RelayConn; h: [RC_MAX] RcHeard; seq: [RC_MAX] int; next: [RC_MAX] int;
  capture_buf:[4096]u8;capture:=proc_getenv("OA_RAID_CAPTURE",capture_buf[..]);written:[1]int;capture_at:=rs_now();
  if capture.count>0 {began:=fs_write(capture,"[");}
  for i: 0..<n {
    ub: [1024] u8; pid: [32] u8; nm: [32] u8;
    proxy_url:[1024]u8;dial:=url;
    if proxy_base>0{pb:[64]u8;pn2:=rs_int(pb[..],rs_put(pb[..],0,"ws://127.0.0.1:"),rc_proxy_port(proxy_base,i));dial=rs_url(proxy_url[..],cast(string)pb[0..<pn2],"/api/room/relay/everglade/","pair-e2-raid-",room);}
    identity:=raid_identity(room,SeatId.{value=i},pid[..]);pn:=identity.count;
    mn := rs_int(nm[..], rs_put(nm[..], 0, "Raid "), i);
    ui := rs_ticketed(ub[..], dial, cast(string) pid[0..<pn], cast(string) nm[0..<mn]);
    if ui.count == 0 || !relay_conn_open(c[i..<i + 1], ui) { tool_err("raid-check: can't open "); tool_errln(url); print("fails\n"); return 1; }
    hm: [96] u8;
    h[i].wl = klass == "warlock" || (klass == "mix" && i % 2 == 1);
    hello := ifx h[i].wl then "H 6 ranger.0.0.0 warlock 0 " else (ifx klass == "demo" then "H 6 ranger.0.0.0 druid 64 " else "H 6 ranger.0.0.0 druid 0 ");
    hn := rs_put(hm[..], rs_put(hm[..], 0, hello), cast(string) nm[0..<mn]);
    _ := relay_conn_send(c[i..<i + 1], cast(string) hm[0..<hn]);
    t1 := rs_now();
    while rs_now() - t1 < 300 { rc_drain(c[..], h[..], i + 1,capture,capture_at,written[..]); proc_sleep(5); }
  }
  t0 := rs_now(); tick := 0; sent_casts := 0; ended := -1;
  while rs_now() - t0 < secs * 1000 {
    tick += 1;
    // the siege's camp fallen and the cult regrouped (or an outcome other than the camp's): 3 s more
    // for its last entries, then done
    if ended < 0 && (h[0].regroup || (h[0].outcome != 0 && h[0].outcome != 1)) { ended = tick; }
    // each second, the front where the siege stands (the band: 500 to 860 permille)
    if tick % 30 == 0 && (h[0].phase == 7 || h[0].phase == 8) {
      h[0].f_n += 1;
      if h[0].f_now >= 500 && h[0].f_now <= 860 { h[0].f_band += 1; }
    }
    if rc_early_end(full==1,capture.count>0,ended,tick){break;}
    for i: 0..<n {
      seq[i] += 1;
      m: [128] u8;
      // to the muster on the commons' north side, to hold it (the map's raid-muster, (0, 16) on 11-09):
      // ahead at the yaw that faces it, and the other way if a second of that went away from it (the
      // camera's yaw convention)
      sx := muster.x + f32(i % 4) * 2 - 3; sz := muster.z + f32(i / 4) * 2 - 3;
      // fight: to the nearest raider it sees (a ward stone or Darian too), until it is in reach
      nq := -1; nd: f32 = 1000000;
      for q: 0..<h[i].n {
        dx := h[i].xs[q] - h[i].me_x; dz := h[i].zs[q] - h[i].me_z;
        if dx * dx + dz * dz < nd { nd = dx * dx + dz * dz; nq = q; }
      }
      stop: f32 = 3;
      if fight && nq >= 0 { sx = h[i].xs[nq]; sz = h[i].zs[nq]; stop = rc_reach(h[i..<i + 1]) - 2; }
      // the siege stands outside the palisade (#12860): a seat inside it with its raider outside walks
      // out through the South Gate's gap, not into the wall beside it
      if fight && nq >= 0 && h[i].me_z > gate.z - 2 && sz < gate.z {
        sx = gate.x; sz = ifx abs(h[i].me_x - gate.x) > 1.5 then gate.z + 5 else gate.z - 4; stop = 0.5;
      }
      wx := sx - h[i].me_x; wz := sz - h[i].me_z; gap := sqrt(wx * wx + wz * wz);
      ahead := ifx h[i].me_seen && gap > stop then 100 else 0;
      // ahead is -(sin, cos) of the camera's yaw (cast-check.coax): the yaw that faces the goal. A
      // second of walking that came no nearer (the watch's ranks in the way) steps aside for 0.7 s,
      // the other side each time.
      yaw := rc_atan2(-wx, -wz);
      if h[i].me_seen && tick - h[i].gap_at >= 30 {
        if h[i].last_gap >= 0 && ahead > 0 && gap > h[i].last_gap - 0.5 { h[i].flip = ifx h[i].flip > 0 then -1.0f32 else 1.0f32; h[i].aside = tick + 20; }
        h[i].last_gap = gap; h[i].gap_at = tick;
      }
      side := ifx ahead > 0 && tick < h[i].aside then cast(int) (h[i].flip * 100) else 0;
      while yaw > 3.14159 { yaw -= 6.28318; }
      while yaw < -3.14159 { yaw += 6.28318; }
      input:=WireIn.{seq=seq[i],kx=side,ky=ahead,theta=yaw,b=WB_RUN,heard=h[i].m[0].heard};k:=wire_put_in(m[..],0,input);
      cf_input(h[i].timing[..],seq[i],rs_now());
      _ := relay_conn_send(c[i..<i + 1], cast(string) m[0..<k]);
      if skew==1&&i==0&&tick%10==0{seq[i]+=1;input.seq=seq[i];k=wire_put_in(m[..],0,input);cf_input(h[i].timing[..],seq[i],rs_now());_=relay_conn_send(c[i..<i+1],cast(string)m[0..<k]);}
      // about every 0.6 s, a Starry Wisp at the nearest raider within 18 m (its 60 feet)
      if tick < next[i] || !h[i].me_seen { continue; }
      next[i] = tick + 16 + i % 4;
      reach := ifx fight then rc_reach(h[i..<i + 1]) else 18.0f32;
      best := -1; bd: f32 = reach * reach;
      for q: 0..<h[i].n {
        dx := h[i].xs[q] - h[i].me_x; dz := h[i].zs[q] - h[i].me_z;
        if dx * dx + dz * dz < bd { bd = dx * dx + dz * dz; best = q; }
      }
      if best < 0 { continue; }
      slot := ifx fight then rc_kit_slot(h[i..<i + 1], bd < 9) else (ifx h[i].wl then 64 else 22);
      h[i].casts_n += 1;
      seq[i] += 1;
      k = rs_int(m[..], rs_put(m[..], 0, "C "), seq[i]);
      k = rs_put(m[..], k, " "); k = rs_int(m[..], k, slot); k = rs_put(m[..], k, " "); k = rs_int(m[..], k, cast(int) (h[i].xs[best] * 100));
      k = rs_put(m[..], k, " 100 "); k = rs_int(m[..], k, cast(int) (h[i].zs[best] * 100)); k = rs_put(m[..], k, " ");
      k = rs_int(m[..], k, 2000 + h[i].ids[best]);
      _ = relay_conn_send(c[i..<i + 1], cast(string) m[0..<k]);
      sent_casts += 1;
    }
    while rs_now() - t0 < tick * 1000 / 30 { rc_drain(c[..], h[..], n,capture,capture_at,written[..]); proc_sleep(2); }
  }
  // a gain's e xp is aimed at its seat, so no busy tick drops it (#12907), but a frame lost on the
  // way still can; the v entry carries the room's total, so a seat's XP is the larger (what the room
  // saves), the part an e xp missed counted with the raid's
  missed := 0;
  for i: 0..<n { if h[i].v_xp > h[i].xp { missed += h[i].v_xp - h[i].xp; h[i].xp = h[i].v_xp; } }
  // what all heard
  waves := 1000; climax := 0; seen := 1000; casts := 1000; hits := 1000; breaks := 0; earned := 0; bad := 0; xp := 0; lv2 := 0; d := 1000000; bytes := 0;
  for i: 0..<n {
    waves = rc_min(waves, h[i].wave_max);
    if (h[i].phase_seen & (1 << 4)) != 0 && (h[i].arch_seen & 2) != 0 { climax += 1; }
    seen = rc_min(seen, h[i].raiders_seen); casts = rc_min(casts, h[i].casts); hits = rc_min(hits, h[i].hits_on); breaks = rc_max(breaks, h[i].breaks);
    if h[i].xp > 0 { earned += 1; }
    if h[i].v_level >= 2 { lv2 += 1; }
    xp += h[i].xp; bad += h[i].bad; d = rc_min(d, h[i].d); bytes += h[i].bytes;
  }
  ran := rc_max((rs_now() - t0) / 1000, 1);
  rate := f32(d) / f32(ran);
  // a wave seen by all, raiders' casts and our hits heard by all, XP earned, nothing malformed, the D rate kept
  // the siege: begun, and as EXPECT says, held in its band or the camp fallen and regrouped
  band := h[0].f_band * 100 / rc_max(h[0].f_n, 1);
  siege_ok := h[0].sieges >= 1 && (expect != "hold" || (band >= 80 && !h[0].fell)) && (expect != "fall" || (h[0].fell && h[0].regroup));
  ok := seen >= 4 && casts > 0 && hits > 0 && earned >= 1 && bad == 0 && rate > 20 && (!want2 || lv2 == n) && siege_ok;
  out: [8192] u8; o: [1] Jo;
  jo_start(o[..], out[..]);
  jo_obj(o[..]);
  jo_key(o[..], "players"); jo_int(o[..], n);
  jo_key(o[..], "seconds"); jo_int(o[..], ran);
  jo_key(o[..],"seat0_offered_extra_inputs");jo_int(o[..],ifx skew==1 then tick/10 else 0);
  jo_key(o[..], "least_d_hz"); jo_int(o[..], cast(int) rate);
  jo_key(o[..], "bytes_per_s"); jo_int(o[..], bytes / ran / rc_max(n, 1));   // what a player hears, each player's mean
  ack_hist:[CF_HIST]int;unknown:=0;backwards:=0;raiders_hi:=0;pets_hi:=0;zones_hi:=0;
  for i:0..<n{for j:0..<CF_HIST{ack_hist[j]+=h[i].timing[0].hist[j];}unknown+=h[i].timing[0].missing;backwards+=h[i].timing[0].backwards;raiders_hi=rc_max(raiders_hi,h[i].peak_raiders);pets_hi=rc_max(pets_hi,h[i].peak_pets);zones_hi=rc_max(zones_hi,h[i].peak_zones);}
  jo_key(o[..],"input_to_final_ack_p50_ms");jo_int(o[..],cf_quantile(ack_hist[..],500));
  jo_key(o[..],"input_to_final_ack_p95_ms");jo_int(o[..],cf_quantile(ack_hist[..],950));
  jo_key(o[..],"input_to_final_ack_p99_ms");jo_int(o[..],cf_quantile(ack_hist[..],990));
  jo_key(o[..],"input_to_final_ack_max_ms_or_2000plus");jo_int(o[..],cf_quantile(ack_hist[..],1000));
  jo_key(o[..],"ack_samples_missing");jo_int(o[..],unknown);jo_key(o[..],"ack_clock_backwards");jo_int(o[..],backwards);
  jo_key(o[..],"peak_live_raiders_in_a_seat_mirror");jo_int(o[..],raiders_hi);jo_key(o[..],"peak_live_pets_in_a_seat_mirror");jo_int(o[..],pets_hi);jo_key(o[..],"peak_zones_in_a_seat_mirror");jo_int(o[..],zones_hi);
  jo_key(o[..], "front_least"); jo_int(o[..], h[0].f_lo);
  jo_key(o[..], "front_most"); jo_int(o[..], h[0].f_hi);
  jo_key(o[..], "front_band_pct"); jo_int(o[..], band);
  jo_key(o[..], "watch_most"); jo_int(o[..], h[0].watch_hi);
  jo_key(o[..], "sieges"); jo_int(o[..], h[0].sieges);
  jo_key(o[..], "camp_fell_s"); jo_int(o[..], ifx h[0].fell then h[0].fall_ms / 1000 else -1);
  jo_key(o[..], "regrouped"); jo_int(o[..], ifx h[0].regroup then 1 else 0);
  jo_key(o[..], "expect"); jo_str(o[..], expect);
  jo_key(o[..], "least_raiders_seen"); jo_int(o[..], seen);
  jo_key(o[..], "kinds_seat0"); jo_int(o[..], h[0].kinds);
  jo_key(o[..], "least_raider_casts_heard"); jo_int(o[..], casts);
  jo_key(o[..], "least_hits_on_raiders_heard"); jo_int(o[..], hits);
  jo_key(o[..], "most_breaks_heard"); jo_int(o[..], breaks);
  jo_key(o[..], "our_casts"); jo_int(o[..], sent_casts);
  jo_key(o[..], "seats_earned_xp"); jo_int(o[..], earned);
  jo_key(o[..], "xp_total"); jo_int(o[..], xp);
  jo_key(o[..], "seats_level_2"); jo_int(o[..], lv2);
  jo_key(o[..], "phases_seat0"); jo_int(o[..], h[0].phase_seen);
  jo_key(o[..], "arch_seat0"); jo_int(o[..], h[0].arch_seen);
  jo_key(o[..], "outcome_seat0"); jo_int(o[..], h[0].outcome);
  jo_key(o[..], "camp"); jo_str(o[..], ifx h[0].fell then "taken" else "standing");
  maxxp := 0; for i: 0..<n { if h[i].xp > maxxp { maxxp = h[i].xp; } }
  jo_key(o[..], "most_xp_a_seat"); jo_int(o[..], maxxp);
  jo_key(o[..], "bad"); jo_int(o[..], bad);
  minxp := 1000000; for i: 0..<n { if h[i].xp < minxp { minxp = h[i].xp; } }
  jo_key(o[..], "least_xp_a_seat"); jo_int(o[..], minxp);
  jo_key(o[..], "mode"); jo_str(o[..], ifx fight then "fight" else "square");
  jo_key(o[..], "class"); jo_str(o[..], klass);
  // each seat's XP: "w" a Warlock's, "d" a druid's, and after "+" its end award
  sb: [1024] u8; sn := 0;
  for i: 0..<n {
    if sn > 990 { break; }
    if i > 0 { sn = rs_put(sb[..], sn, " "); }
    sn = rs_put(sb[..], sn, ifx h[i].wl then "w" else "d"); sn = rs_int(sb[..], sn, h[i].xp - h[i].xp_end);
    sn = rs_put(sb[..], sn, "+"); sn = rs_int(sb[..], sn, h[i].xp_end);
  }
  jo_key(o[..], "xp_cues_missed"); jo_int(o[..], missed);
  jo_key(o[..], "xp_seats"); jo_str(o[..], cast(string) sb[0..<sn]);
  far := 0; for i: 0..<n { if h[i].last_gap > 8 { far += 1; } }
  rf := 0; rcool := 0; rrange := 0; rlevel := 0; rother := 0;
  for i: 0..<n { rf += h[i].refused; rcool += h[i].r_cool; rrange += h[i].r_range; rlevel += h[i].r_level; rother += h[i].r_other; }
  jo_key(o[..], "refused"); jo_int(o[..], rf);
  jo_key(o[..], "refused_cooldown"); jo_int(o[..], rcool);
  jo_key(o[..], "refused_range"); jo_int(o[..], rrange);
  jo_key(o[..], "refused_level"); jo_int(o[..], rlevel);
  jo_key(o[..], "refused_other"); jo_int(o[..], rother);
  rdead := 0; rbusy := 0; rslot := 0; for i: 0..<n { rdead += h[i].r_dead; rbusy += h[i].r_busy; rslot += h[i].r_slot; }
  jo_key(o[..], "refused_dead"); jo_int(o[..], rdead);
  jo_key(o[..], "refused_busy"); jo_int(o[..], rbusy);
  jo_key(o[..], "refused_slot"); jo_int(o[..], rslot);
  jo_key(o[..], "players_off_the_square"); jo_int(o[..], far);
  jo_end(o[..]);
  print("%\n", jo_text(o[..]));
  print("%\n", ifx ok then "raids" else "fails");
  for i: 0..<n { _ := relay_conn_close(c[i..<i + 1], 500); }
  if capture.count>0 {finished:=fs_append(capture,"]");}
  return ifx ok then 0 else 1;
}
