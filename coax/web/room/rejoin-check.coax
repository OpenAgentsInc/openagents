// The everglade rooms' rejoin check (room-relay.coax rl_replace_stale, room-vitals.coax rv_back,
// room-world.c world_place_at): a player whose network drops without a close comes back where they
// stood, once. A and B sit in one room with seat tickets; A walks east off the gate for 3 s, then
// A's socket goes silent (it neither sends nor reads, and never closes, as a phone between networks).
// 7 s on (the page's own quiet check, everglade-net.coax NET_SILENT_MS, is 6 s), A opens a new
// socket with a fresh ticket for the same player. A's new seat's first word on itself is where A
// stood, within 1 m, not the gate; B hears A's old seat go and A's new one where A was, and has one A.
// Then a page on another wire (#12788): a socket whose hello says wire 2 hears "r 0 version" and is
// closed. Last, a page from before wire 3 (hello "H 1", room-oldwire.coax): until WIRE_OLD_UNTIL_MS
// (by the clock in the room's y) it is seated, its D's are the old wire's ("D TICK ACK F " and its own
// p) and its inputs without HEARD are acknowledged; after it, it is refused as wire 2 is.
// It needs the seat-ticket key (OA_ROOM_TICKET_KEY): run it as deploy.sh does, or against a local
// room server started with the same key (raid-proof.sh's way).
//   coax/web/tool.sh coax/web/room/rejoin-check.coax [ws://localhost:8830]
// Prints one JSON line, then "rejoins" and exits 0, or "fails" and 1.
#load "room-socket.coax";

RJ_SEATS :: 16;
RjHeard :: struct {
  seat: int = -1;
  d: int;
  x: [RJ_SEATS] f32; z: [RJ_SEATS] f32; seen: [RJ_SEATS] bool; gone: [RJ_SEATS] bool;
  first_ok: bool; first_x: f32; first_z: f32;   // this socket's first word on its own seat
  m: [1] WireMirror;                             // the rows its D's left, as the page's (its I's HEARD)
}
rj_hear :: (h: [] RjHeard, t: string) {
  if rs_starts(t, "y ") { h[0].seat = rs_num(rs_field(t, 1)); return; }
  if !rs_starts(t, "D ") { return; }
  h[0].d += 1;
  _ := wire_mirror_frame(h[0].m[..], t);
  // every seat's player as the page has them after this D: seen, or gone (x)
  for ss: 0..<RJ_SEATS {
    w := wire_mirror_of(h[0].m[..], ss);
    if w.id != ss { if h[0].seen[ss] { h[0].gone[ss] = true; } h[0].seen[ss] = false; continue; }
    h[0].x[ss] = w.x; h[0].z[ss] = w.z; h[0].seen[ss] = true; h[0].gone[ss] = false;
    if ss == h[0].seat && !h[0].first_ok { h[0].first_ok = true; h[0].first_x = w.x; h[0].first_z = w.z; }
  }
}
rj_drain :: (c: [] RelayConn, h: [] RjHeard) {
  if c[0].h < 0 { return; }
  while relay_conn_poll(c, 0) == RC_TEXT { rj_hear(h, cast(string) c[0].text[0..<c[0].text_n]); }
}
// An input from socket c: walking east (kx 100) when `walk`, else standing.
rj_input :: (c: [] RelayConn, h: [] RjHeard, seq: int, walk: bool) -> bool {
  m: [64] u8;
  k := rs_int(m[..], rs_put(m[..], 0, "I "), seq);
  k = rs_put(m[..], k, ifx walk then " 100 0 0 0 0 0 " else " 0 0 0 0 0 0 "); k = rs_int(m[..], k, h[0].m[0].heard);
  return relay_conn_send(c, cast(string) m[0..<k]);
}
// Whether text holds part.
rj_has :: (text: string, part: string) -> bool {
  if part.count > text.count { return false; }
  for i: 0..<text.count - part.count + 1 { if text[i..<i + part.count] == part { return true; } }
  return false;
}
// The players other than seat `me` this socket has now.
rj_others :: (h: [] RjHeard, me: int) -> int { n := 0; for s: 0..<RJ_SEATS { if s != me && h[0].seen[s] { n += 1; } } return n; }

tool_main :: () -> int #export_c {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("rejoin-check: bad arguments"); return 2; }
  kb: [128] u8;
  if proc_getenv("OA_ROOM_TICKET_KEY", kb[..]).count < 32 { tool_errln("rejoin-check: needs OA_ROOM_TICKET_KEY (the player's seat tickets name who comes back)"); print("fails\n"); return 1; }
  b: [512] u8;
  base := rs_base(ifx args_count(a[..]) > 0 then args_at(a[..], 0) else "ws://localhost:8830", b[..]);
  u: [1024] u8;
  url := rs_url(u[..], base, "/api/room/relay/everglade/", "pair-rejoin-", rs_stamp());
  c: [3] RelayConn; h: [3] RjHeard;   // 0 A's first socket, 1 B, 2 A's second
  for i: 0..<3 { c[i].h = -1; }
  ua: [1024] u8; ub: [1024] u8;
  url_a := rs_ticketed(ua[..], url, "p-rejoincheck-a", "Rejoin A"); url_b := rs_ticketed(ub[..], url, "p-rejoincheck-b", "Rejoin B");
  if url.count == 0 || url_a.count == 0 || url_b.count == 0 || !relay_conn_open(c[0..<1], url_a) || !relay_conn_open(c[1..<2], url_b) { tool_err("rejoin-check: can't open "); tool_errln(url); print("fails\n"); return 1; }
  sent := relay_conn_send(c[0..<1], "H 3 ranger.2.1.0 druid 0 Rejoin A") && relay_conn_send(c[1..<2], "H 3 ranger.0.0.0 druid 0 Rejoin B");
  seq_a := 0; seq_b := 0;
  // both stand 1 s, then A walks east 3 s
  t0 := rs_now(); n := 0;
  while rs_now() - t0 < 4000 {
    seq_a += 1; seq_b += 1;
    sent = rj_input(c[0..<1], h[0..<1], seq_a, rs_now() - t0 > 1000) && rj_input(c[1..<2], h[1..<2], seq_b, false) && sent;
    n += 1;
    while rs_now() - t0 < n * 33 { rj_drain(c[0..<1], h[0..<1]); rj_drain(c[1..<2], h[1..<2]); proc_sleep(2); }
  }
  sa := h[0].seat; sb := h[1].seat;
  // a short stand, so A's place settles; then A's socket goes silent: B alone talks and reads for 7 s
  t1 := rs_now(); n = 0;
  while rs_now() - t1 < 7500 {
    if rs_now() - t1 < 500 { seq_a += 1; sent = rj_input(c[0..<1], h[0..<1], seq_a, false) && sent; rj_drain(c[0..<1], h[0..<1]); }
    seq_b += 1; sent = rj_input(c[1..<2], h[1..<2], seq_b, false) && sent;
    n += 1;
    while rs_now() - t1 < n * 33 { rj_drain(c[1..<2], h[1..<2]); proc_sleep(2); }
  }
  stood_x := ifx sa >= 0 then h[1].x[sa] else 0; stood_z := ifx sa >= 0 then h[1].z[sa] else 0;
  walked := sa >= 0 && h[1].seen[sa] && stood_x > 3;
  // A's page opens a new socket, with a fresh ticket for the same player
  ua2: [1024] u8;
  url_a2 := rs_ticketed(ua2[..], url, "p-rejoincheck-a", "Rejoin A");
  opened := url_a2.count > 0 && relay_conn_open(c[2..<3], url_a2);
  sent = opened && relay_conn_send(c[2..<3], "H 3 ranger.2.1.0 druid 0 Rejoin A") && sent;
  t2 := rs_now(); n = 0;
  while opened && rs_now() - t2 < 3000 {
    seq_a += 1; seq_b += 1;
    sent = rj_input(c[2..<3], h[2..<3], seq_a, false) && rj_input(c[1..<2], h[1..<2], seq_b, false) && sent;
    n += 1;
    while rs_now() - t2 < n * 33 { rj_drain(c[1..<2], h[1..<2]); rj_drain(c[2..<3], h[2..<3]); proc_sleep(2); }
  }
  sa2 := h[2].seat;
  dx := h[2].first_x - stood_x; dz := h[2].first_z - stood_z;
  back_m := ifx h[2].first_ok then sqrt(dx * dx + dz * dz) else -1;
  where_b := ifx sa2 >= 0 && h[1].seen[sa2] then sqrt((h[1].x[sa2] - stood_x) * (h[1].x[sa2] - stood_x) + (h[1].z[sa2] - stood_z) * (h[1].z[sa2] - stood_z)) else -1;
  old_gone := sa >= 0 && sa != sa2 && !h[1].seen[sa];
  once := rj_others(h[1..<2], sb) == 1;
  // an old page (#12788): its hello says wire 2; the room says why (r 0 version) and closes the socket
  old: [1] RelayConn; old[0].h = -1;
  uo: [1024] u8; url_o := rs_ticketed(uo[..], url, "p-rejoincheck-old", "Rejoin Old");
  refused := false; closed := false;
  if url_o.count > 0 && relay_conn_open(old[..], url_o) && relay_conn_send(old[..], "H 2 ranger.0.0.0 druid 0 Old") {
    t3 := rs_now();
    while !closed && rs_now() - t3 < 5000 {
      r := relay_conn_poll(old[..], 50);
      if r == RC_TEXT && rj_has(cast(string) old[0].text[0..<old[0].text_n], "r 0 version") { refused = true; }
      if r == RC_CLOSED || r == RC_FAIL { closed = true; }
    }
  }
  pg: [1] RelayConn; pg[0].h = -1;
  up: [1024] u8; url_p := rs_ticketed(up[..], url, "p-rejoincheck-page2", "Rejoin Page2");
  window := false; plays := false; acked := false; told := false; shut := false; me := -1;
  if url_p.count > 0 && relay_conn_open(pg[..], url_p) && relay_conn_send(pg[..], "H 1 ranger.0.0.0 druid 0 Page2") {
    t4 := rs_now(); seq := 0;
    while !shut && rs_now() - t4 < 3000 {
      if rs_now() - t4 >= seq * 100 {
        seq += 1;
        m: [64] u8; k := rs_put(m[..], rs_int(m[..], rs_put(m[..], 0, "I "), seq), " 0 0 0 0 0 0");
        _ := relay_conn_send(pg[..], cast(string) m[0..<k]);
      }
      r := relay_conn_poll(pg[..], 20);
      if r == RC_CLOSED || r == RC_FAIL { shut = true; }
      if r != RC_TEXT { continue; }
      t := cast(string) pg[0].text[0..<pg[0].text_n];
      if rs_starts(t, "y ") { me = rs_num(rs_field(t, 1)); window = rs_num(rs_field(t, 3)) < WIRE_OLD_UNTIL_MS; }
      if rj_has(t, "r 0 version") { told = true; }
      // "D TICK ACK F p ME ...": its own p first after the three-field header
      if me >= 0 && rs_starts(t, "D ") && rs_field(t, 4) == "p" && rs_num(rs_field(t, 5)) == me {
        plays = true;
        if rs_num(rs_field(t, 2)) >= 1 { acked = true; }
      }
    }
  }
  page2 := ifx window then plays && acked && !told && !shut else told && shut;
  ok := sent && walked && opened && h[2].first_ok && back_m >= 0 && back_m < 1 && where_b >= 0 && where_b < 1 && old_gone && once && refused && closed && page2;
  out: [1024] u8; o: [1] Jo;
  jo_start(o[..], out[..]);
  jo_obj(o[..]);
  jo_key(o[..], "seat_a"); jo_int(o[..], sa);
  jo_key(o[..], "seat_a_again"); jo_int(o[..], sa2);
  jo_key(o[..], "stood_cm"); jo_int(o[..], cast(int) (stood_x * 100)); jo_key(o[..], "stood_z_cm"); jo_int(o[..], cast(int) (stood_z * 100));
  jo_key(o[..], "first_cm"); jo_int(o[..], cast(int) (h[2].first_x * 100)); jo_key(o[..], "first_z_cm"); jo_int(o[..], cast(int) (h[2].first_z * 100));
  jo_key(o[..], "back_cm"); jo_int(o[..], cast(int) (back_m * 100));
  jo_key(o[..], "b_sees_a_again_cm"); jo_int(o[..], cast(int) (where_b * 100));
  jo_key(o[..], "old_seat_gone"); jo_bool(o[..], old_gone);
  jo_key(o[..], "b_others"); jo_int(o[..], rj_others(h[1..<2], sb));
  jo_key(o[..], "walked"); jo_bool(o[..], walked);
  jo_key(o[..], "sent"); jo_bool(o[..], sent);
  jo_key(o[..], "old_wire_refused"); jo_bool(o[..], refused);
  jo_key(o[..], "old_wire_closed"); jo_bool(o[..], closed);
  jo_key(o[..], "page2_window"); jo_bool(o[..], window);
  jo_key(o[..], "page2_plays"); jo_bool(o[..], plays && acked);
  jo_key(o[..], "page2_refused"); jo_bool(o[..], told && shut);
  jo_end(o[..]);
  print("%\n", jo_text(o[..]));
  print("%\n", ifx ok then "rejoins" else "fails");
  return ifx ok then 0 else 1;
}
