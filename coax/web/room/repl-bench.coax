// The replication layer's benchmark (#13178): the room's relevance and replication work per tick at
// 50, 200 and 1,000 entities, each a client too (the worst case: everyone a player), before and after
// the engine-wide grid, priority and link budget (aethyr/net/grid.coax, budget.coax); and the bytes a
// player in a crowded glade is sent a second, from the real wire (everglade-wire.coax), before and after.
//   coax/web/tool.sh coax/web/room/repl-bench.coax
// It fails when the glade's player is sent more than RB_GLADE_MOST bytes a second, or a row waits past
// WIRE_MAX_AGE ticks. The breakdown of after's time is the grid's query, the priorities and the order.
// Before: each client scans every entity (as everglade-wire's frame scanned every slot), weighs the
// relevant ones by distance alone and sends rows by that priority up to WIRE_BUDGET (1,000 bytes) a
// tick. After: each client asks the grid for the entities within its relevance radius, weighs them by
// distance, view, speed and age (net_priority), orders them so the starved go first (net_order) and
// sends up to its link's limit (EG_ROW_BPS a second at 30 Hz: 500 bytes a tick).
// The entities walk at constant density (one per 400 m²), so a client's neighbourhood holds about the
// same number at every size: before grows with the square of the count, after with the count.
// tool.sh: release
// tool.sh: stack-gib 2
#import "Basic";
#load "../../lib/sys/proc.coax";
#load "../../../everglade/shared/everglade-wire.coax";
#load "../../../aethyr/net/grid.coax";

RB_MAX :: 1000;               // entities at most
RB_RADIUS :: 130.0;           // m: the room's interest radius (room-interest.coax IM_EXIT)
RB_TICKS :: 60;               // ticks measured at each size
RB_ROW :: 11;                 // bytes of a walking townsperson's packed update row, with its separator (the glade's bytes over its rows)
RB_GLADE_MOST :: 18000;       // B/s: the most a player in the crowded glade may be sent, everything in (#13178)
RB_HZ :: 30;
RB_AFTER_BPS :: 15000;        // room-everglade.coax EG_ROW_BPS

RbWorld :: struct {
  n: int; side: f32; seed: int;
  x: [RB_MAX] f32; z: [RB_MAX] f32; vx: [RB_MAX] f32; vz: [RB_MAX] f32; yaw: [RB_MAX] f32;
  acc: [RB_MAX * RB_MAX] f32;   // client c's priority of entity e at [c * RB_MAX + e]
  since: [RB_MAX * RB_MAX] int; last: [RB_MAX * RB_MAX] int;
  grid: [1] NetGrid;
  tq: int; tp: int; to: int;
}
rb_rand :: (w: [] RbWorld) -> f32 { w[0].seed = (w[0].seed * 1103515245 + 12345) & 2147483647; return f32(w[0].seed % 100000) / 100000; }
rb_setup :: (w: [] RbWorld, n: int) {
  w[0].n = n; w[0].side = sqrt(f32(n) * 400); w[0].seed = 7 + n;
  for e: 0..<n {
    w[0].x[e] = rb_rand(w) * w[0].side; w[0].z[e] = rb_rand(w) * w[0].side;
    w[0].vx[e] = (rb_rand(w) - 0.5) * 6; w[0].vz[e] = (rb_rand(w) - 0.5) * 6; w[0].yaw[e] = rb_rand(w) * 6.28;
  }
  for i: 0..<n * RB_MAX { w[0].acc[i] = 0; w[0].since[i] = 0; w[0].last[i] = 0; }
  net_grid_init(w[0].grid[..], RB_RADIUS);
  for e: 0..<n { _ := net_grid_put(w[0].grid[..], e, w[0].x[e], w[0].z[e]); }
}
rb_move :: (w: [] RbWorld) {
  for e: 0..<w[0].n {
    w[0].x[e] += w[0].vx[e] / RB_HZ; w[0].z[e] += w[0].vz[e] / RB_HZ;
    if w[0].x[e] < 0 || w[0].x[e] > w[0].side { w[0].vx[e] = -w[0].vx[e]; }
    if w[0].z[e] < 0 || w[0].z[e] > w[0].side { w[0].vz[e] = -w[0].vz[e]; }
  }
}
// One tick before: every client scans every entity. The rows sent.
rb_before :: (w: [] RbWorld, now: int) -> int {
  n := w[0].n; sent := 0;
  r2 := f32(RB_RADIUS * RB_RADIUS);
  cand: [RB_MAX] int; count: [32] int; start: [32] int; order: [RB_MAX] int;
  for c: 0..<n {
    cn := 0;
    for e: 0..<n {
      if e == c { continue; }
      dx := w[0].x[e] - w[0].x[c]; dz := w[0].z[e] - w[0].z[c]; d2 := dx * dx + dz * dz;
      if d2 > r2 { continue; }
      w[0].acc[c * RB_MAX + e] += 1.0 / (1 + sqrt(d2) / NET_NEAR);
      cand[cn] = e; cn += 1;
    }
    for k: 0..<32 { count[k] = 0; }
    for i: 0..<cn { count[net_prio_class(w[0].acc[c * RB_MAX + cand[i]])] += 1; }
    s := 0; k := 31; while k >= 0 { start[k] = s; s += count[k]; k -= 1; }
    for i: 0..<cn { b := net_prio_class(w[0].acc[c * RB_MAX + cand[i]]); order[start[b]] = cand[i]; start[b] += 1; }
    spent := 0;
    for i: 0..<cn {
      if spent + RB_ROW > WIRE_BUDGET { break; }
      spent += RB_ROW; w[0].acc[c * RB_MAX + order[i]] = 0; sent += 1;
    }
  }
  return sent;
}
// One tick after: the grid, each client's neighbourhood, net_priority, net_order and its link's limit.
rb_after :: (w: [] RbWorld, now: int) -> int {
  n := w[0].n; sent := 0;
  for e: 0..<n { _ := net_grid_put(w[0].grid[..], e, w[0].x[e], w[0].z[e]); }
  near: [RB_MAX] int; cand: [RB_MAX] int; order: [RB_MAX] int;
  limit := RB_AFTER_BPS / RB_HZ;
  for c: 0..<n {
    t0 := cxproc_now_ns();
    found := net_grid_query(w[0].grid[..], w[0].x[c], w[0].z[c], near[..]);
    t1 := cxproc_now_ns(); w[0].tq += t1 - t0;
    fx := -sin(w[0].yaw[c]); fz := -cos(w[0].yaw[c]);
    cn := 0;
    base := c * RB_MAX;
    for i: 0..<(ifx found < RB_MAX then found else RB_MAX) {
      e := near[i];
      if e == c { continue; }
      dx := w[0].x[e] - w[0].x[c]; dz := w[0].z[e] - w[0].z[c];
      sp := sqrt(w[0].vx[e] * w[0].vx[e] + w[0].vz[e] * w[0].vz[e]);
      l := w[0].last[base + e];
      w[0].acc[base + e] += net_priority(NetPrio.{weight = 1, d2 = dx * dx + dz * dz, view = net_in_view(fx, fz, dx, dz), speed = sp, age = ifx l > 0 then now - l else 0});
      if w[0].since[base + e] == 0 { w[0].since[base + e] = now; }
      cand[cn] = e; cn += 1;
    }
    t2 := cxproc_now_ns(); w[0].tp += t2 - t1;
    _ := net_order(w[0].acc[base..<base + RB_MAX], w[0].since[base..<base + RB_MAX], cand[..], cn, now, WIRE_MAX_AGE, order[..]);
    spent := 0; w[0].to += cxproc_now_ns() - t2;
    for i: 0..<cn {
      if spent + RB_ROW > limit { break; }
      e := order[i];
      spent += RB_ROW; w[0].acc[base + e] = 0; w[0].since[base + e] = 0; w[0].last[base + e] = now; sent += 1;
    }
  }
  return sent;
}

// The crowded glade: you and 200 townsfolk walking within 40 m of you, 300 ticks (10 s) on the real
// wire, each frame heard 3 ticks on. The bytes a second you are sent, and the rows that waited.
RbGlade :: struct { bps: int; rows: int; left: int; oldest: int; }
rb_glade :: (after: bool) -> RbGlade {
  h: [1] WireHist; st: [1] WireSeat; st[0].packed = true;
  pick: [WIRE_SLOTS] f32; fields: [WIRE_SLOTS] int; combat: [WIRE_SLOTS] int;
  buf: [16384] u8;
  link: NetLink;
  total := 0; rows := 0; left := 0; oldest := 0;
  seed := 11;
  px: [200] f32; pz: [200] f32; pvx: [200] f32; pvz: [200] f32;
  for i: 0..<200 {
    seed = (seed * 1103515245 + 12345) & 2147483647; a := f32(seed % 6283) / 1000;
    seed = (seed * 1103515245 + 12345) & 2147483647; r := 3 + f32(seed % 3700) / 100;
    px[i] = cos(a) * r; pz[i] = sin(a) * r;
    seed = (seed * 1103515245 + 12345) & 2147483647; pvx[i] = f32(seed % 300) / 100 - 1.5;
    seed = (seed * 1103515245 + 12345) & 2147483647; pvz[i] = f32(seed % 300) / 100 - 1.5;
  }
  for q: 0..<WIRE_SLOTS { fields[q] = (1 << WIRE_SF) - 1; combat[q] = 0; }
  for t: 1..<301 {
    wire_hist_begin(h[..], t);
    wire_test_put(h[..], 0, WireS.{id = 0, kind = WK_PLAYER, hp = 10, max = 10});
    for i: 0..<200 {
      px[i] += pvx[i] / RB_HZ; pz[i] += pvz[i] / RB_HZ;
      if px[i] * px[i] + pz[i] * pz[i] > 1600 { pvx[i] = -pvx[i]; pvz[i] = -pvz[i]; }
      wire_test_put(h[..], 16 + i, WireS.{id = WIRE_ID_FOLK + i, kind = WK_FOLK, x = px[i], z = pz[i], vx = pvx[i], vz = pvz[i], clip = 1, p1 = i});
    }
    row := t % WIRE_BASES;
    for q: 0..<WIRE_SLOTS { pick[q] = ifx h[0].id[row * WIRE_SLOTS + q] == 0 then -1.0f32 else 0.0f32; }
    if t > 3 { wire_seat_ack(st[..], h[..], t - 3); }
    n := 0;
    if after {
      link = net_link_step(link, t, RB_HZ, RB_AFTER_BPS, 0, 3);
      lim := ifx link.limit < WIRE_BUDGET then link.limit else WIRE_BUDGET;
      n = wire_seat_frame_look(st[..], h[..], 0, 0, 0, pick[..], fields[..], WireLook.{fx = 0, fz = -1}, combat[..], lim, buf[..]);
      link = net_link_spent(link, st[0].bytes, st[0].left);
    } else {
      n = wire_seat_frame_fields(st[..], h[..], 0, 0, 0, pick[..], fields[..], WIRE_BUDGET, buf[..]);
    }
    if t > 60 { total += n + 1; left += st[0].left; if st[0].oldest > oldest { oldest = st[0].oldest; } }
    for i: 0..<n { if buf[i] == ';' { rows += ifx t > 60 then 1 else 0; } }
  }
  return RbGlade.{bps = total * RB_HZ / 240, rows = rows * RB_HZ / 240, left = left * RB_HZ / 240, oldest = oldest};
}

tool_main :: () -> int #export_c #effects(all) {
  sizes := [3] int.[50, 200, 1000];
  w: [1] RbWorld;
  for si: 0..<3 {
    n := sizes[si];
    t_b := 0; t_a := 0; s_b := 0; s_a := 0;
    rb_setup(w[..], n);
    for t: 1..<RB_TICKS + 1 { rb_move(w[..]); a := cxproc_now_ns(); s_b += rb_before(w[..], t); t_b += cxproc_now_ns() - a; }
    rb_setup(w[..], n);
    for t: 1..<RB_TICKS + 1 { rb_move(w[..]); a := cxproc_now_ns(); s_a += rb_after(w[..], t); t_a += cxproc_now_ns() - a; }
    print("entities % clients %: before % us/tick (% rows/client/tick), after % us/tick (% rows/client/tick), grid visits % (query % priority % order % us)\n",
          n, n, t_b / RB_TICKS / 1000, s_b / RB_TICKS / n, t_a / RB_TICKS / 1000, s_a / RB_TICKS / n, w[0].grid[0].visits / RB_TICKS, w[0].tq / RB_TICKS / 1000, w[0].tp / RB_TICKS / 1000, w[0].to / RB_TICKS / 1000); w[0].tq = 0; w[0].tp = 0; w[0].to = 0;
  }
  b := rb_glade(false); a := rb_glade(true);
  print("crowded glade (you + 200 within 40 m): before % B/s (% rows/s, % waited/s, oldest % ticks), after % B/s (% rows/s, % waited/s, oldest % ticks)\n",
        b.bps, b.rows, b.left, b.oldest, a.bps, a.rows, a.left, a.oldest);
  if a.bps > RB_GLADE_MOST || a.oldest > WIRE_MAX_AGE { print("fails: over % B/s or a row older than % ticks\n", RB_GLADE_MOST, WIRE_MAX_AGE); return 1; }
  print("holds\n");
  return 0;
}
