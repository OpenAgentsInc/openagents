#load "../../../aethyr/ids.coax";
// The everglade rooms' hotbar abilities on the server (GitHub #12718, #12733): the casts room-everglade.coax
// takes (C) and the ends (E) of the abilities the world runs, handed to the host's world (room-world.c
// world_ability: apps/openagents-web/everglade-room-abilities.coax runs each seat's own copy of the
// page's ability code there), and what every seat's copy holds up heard by every seat as entities of
// the room's table (ra_table; everglade-wire.coax's s rows):
//   kind WK_ZONE, OWNER the seat, P1 the ability, P2 Reverse Gravity's radius in cm (else its cast's
//   mode), X Y Z YAW where its last cast was (the caster's feet, or the aim) and its facing
// and a townsperson the world's abilities hold off their feet is that high in their row's Y.
// Each seat's are its own: as many as it casts stand at once, as offline. A new cast of one is a new
// entity. The rules still roll each spell's SRD record (everglade5e-room-rules.coax) but Reverse
// Gravity's, which the world runs whole; the damage the world's falls dealt goes to the rules (e5rr_hurt).
// The host, each tick before the town: rm_ra_casts / rm_ra_cast / rm_ra_heard into world_ability, then
// world_abilities, then rm_ra_live for each seat's every ability, rm_ra_air for each person and
// rm_ra_hurt for what the falls dealt.

#load "effect-budget.coax";
RA_CASTS :: EG_SEATS*(EF_STARTS+EF_ENDS);
RA_CAST_FLOATS :: 11;           // BY AB X Y Z YAW ON AX AY AZ (and a spare)
RA_ID0 :: 900000;               // the abilities' entity ids, past the rules' zones and creatures
RA_ABS :: 48;                   // abilities a seat, room for everglade-abilities.coax AB_N
RA_AB_N :: 43;                  // its AB_N: bar slots 4 to 46 (47 and 48 are Rebuild and the row switcher, 64 on the Warlock's)
RA_REVERSE :: 0;                // everglade-abilities.coax AB_REVERSE (bar slot EG_SP_SLOTS + it, fivebar.coax)
RA_RG_R_CM :: 1524;             // its 50-foot radius (AB_RG_R)

RaCast :: struct { by: int; ab: int; x: f32; y: f32; z: f32; yaw: f32; on: bool; ax: f32; ay: f32; az: f32; mode: int; }
RaLive :: struct { on: bool; id: int; epoch: int; x: f32; y: f32; z: f32; yaw: f32; mode: int; }   // mode: its last cast's (RaCast)
RaRoom :: struct {
  q: [RA_CASTS] RaCast; q_n: int;
  live: [EG_SEATS * RA_ABS] RaLive;            // each seat's abilities up
  next_id: int;
  air: [E5R_FOLK] int;                          // cm
}

// Whether bar slot `slot` is an ability the world runs (everglade-room-abilities.coax eg_ra_world: the
// pages run Levitate, Feather Fall, Water Walk, Water Breathing, Shapechange and Speak with Animals
// themselves and never send them; Conjure Animals' and Polymorph's creatures are the rules').
ra_world_slot :: (slot: int) -> bool {
  ab := slot - EG_SP_SLOTS;
  return ab >= 0 && ab < RA_AB_N && ab != 28 && ab != 29;
}
// Whether the world runs it whole: the rules roll nothing for it (Reverse Gravity has no roll).
ra_whole :: (slot: int) -> bool { return slot - EG_SP_SLOTS == RA_REVERSE; }
RA_MODES :: 8;   // a cast's mode at most (everglade-room-abilities.coax eg_ra_mode)

ra_fresh :: (v: [] RmServer, k: int) {
  if k < 0 || k >= EG_ROOMS { return; }
  v[0].ab[k] = RaRoom.{};
  v[0].ab[k].next_id = 1;
}
#test "overload: every seat keeps two ability starts and four ordered ends (#12841)" #steps 3000000000 {
  v:[1]RmServer;k:=rc_test_room(v[..],"pair-ability-budget",16,false);
  for s:0..<EG_SEATS{
    for q:0..<4{#assert ra_queue(v[..],k,RaCast.{by=s,on=false});}
    for q:0..<2{#assert ra_queue(v[..],k,RaCast.{by=s,on=true});}
    #assert !ra_queue(v[..],k,RaCast.{by=s,on=true})&&!ra_queue(v[..],k,RaCast.{by=s,on=false});
  }
  #assert v[0].ab[k].q_n==96;
  #assert !ra_queue(v[..],k,RaCast.{by=0,on=true})&&!ra_queue(v[..],k,RaCast.{by=15,on=false});
  rm_ra_heard(v[..],k);#assert ra_queue(v[..],k,RaCast.{by=15,on=true});
  #assert !ra_queue(v[..],k,RaCast.{by= -1,on=true})&&!ra_queue(v[..],k,RaCast.{by=16,on=true});
}
ra_queue :: (v: [] RmServer, k: int, c: RaCast) -> bool {
  r := v[0].ab[k..<k + 1];
  if !ra_may_queue(v,k, SeatId.{value = c.by},c.on) { return false; }
  r[0].q[r[0].q_n] = c; r[0].q_n += 1;
  return true;
}
ra_may_queue :: (v:[]RmServer,k:int, seat_id: SeatId,start:bool)->bool { seat := seat_id.value;
  if seat<0||seat>=EG_SEATS||v[0].ab[k].q_n>=RA_CASTS{return false;}
  starts:=0;ends:=0;
  for q:0..<v[0].ab[k].q_n{c:=v[0].ab[k].q[q];if c.by!=seat{continue;}if c.on{starts+=1;}else{ends+=1;}}
  return ef_admit(start,starts,ends);
}
// A cast of bar slot `slot` from seat `seat` standing at `me`, at the aim (room-everglade.coax
// eg_heard_cast, once it is checked): an ability the world runs goes to it (pressed again, one that
// toggles ends: the world's copy decides, as a page's does). Whether it went.
ra_cast :: (v: [] RmServer, k: int, seat_id: SeatId, slot: int, me: EgPose, ax: f32, ay: f32, az: f32, mode: int) -> bool { seat := seat_id.value;
  if !ra_world_slot(slot) || seat < 0 || seat >= EG_SEATS { return false; }
  m := ifx mode >= 0 && mode <= RA_MODES then mode else 0;
  if !ra_queue(v, k, RaCast.{by = seat, ab = slot - EG_SP_SLOTS, x = me.x, y = me.y, z = me.z, yaw = me.yaw, on = true, ax = ax, ay = ay, az = az, mode = m}) { return false; }
  v[0].ab[k].live[seat * RA_ABS + slot - EG_SP_SLOTS].mode = m;   // its entity says it (ra_table P2)
  return true;
}
// E: seat `seat` ends what bar slot `slot` holds up in the world. Whether it held one up (as the
// world said last tick: rm_ra_live).
ra_end :: (v: [] RmServer, k: int, seat_id: SeatId, slot: int) -> bool { seat := seat_id.value;
  if !ra_world_slot(slot) || !v[0].ab[k].live[seat * RA_ABS + slot - EG_SP_SLOTS].on { return false; }
  me := v[0].eg[k].seat[seat].pose;
  return ra_queue(v, k, RaCast.{by = seat, ab = slot - EG_SP_SLOTS, x = me.x, y = me.y, z = me.z, yaw = me.yaw, on = false, ax = me.x, ay = me.y, az = me.z});
}

// ---- the host

rm_ra_casts :: (v: [] RmServer, k: int) -> int #export_c { return ifx rm_eg_live(v, k) then v[0].ab[k].q_n else 0; }
rm_ra_cast :: (v: [] RmServer, k: int, q: int, out: [] f32) #export_c {
  if !rm_eg_live(v, k) || q < 0 || q >= v[0].ab[k].q_n || out.count < RA_CAST_FLOATS { return; }
  c := v[0].ab[k].q[q];
  out[0] = f32(c.by); out[1] = f32(c.ab); out[2] = c.x; out[3] = c.y; out[4] = c.z; out[5] = c.yaw; out[6] = ifx c.on then 1.0f32 else 0.0f32;
  out[7] = c.ax; out[8] = c.ay; out[9] = c.az; out[10] = f32(c.mode);
}
rm_ra_heard :: (v: [] RmServer, k: int) #export_c { if rm_eg_live(v, k) { v[0].ab[k].q_n = 0; } }
// Seat s's ability ab now: up or not, where its last cast was, its facing, and its casts (`epoch`: a
// new one is a new entity, every page casts it again).
rm_ra_live :: (v: [] RmServer, k: int, s_id: SeatId, ab: int, on: bool, x: f32, y: f32, z: f32, yaw: f32, epoch: int) #export_c { s := s_id.value;
  if !rm_eg_live(v, k) || s < 0 || s >= EG_SEATS || ab < 0 || ab >= RA_ABS { return; }
  r := v[0].ab[k..<k + 1];
  l := r[0].live[s * RA_ABS + ab..<s * RA_ABS + ab + 1];
  if !on { l[0] = RaLive.{}; return; }
  if !l[0].on || l[0].epoch != epoch { l[0].id = RA_ID0 + r[0].next_id; r[0].next_id += 1; }
  l[0].on = true; l[0].epoch = epoch; l[0].x = x; l[0].y = y; l[0].z = z; l[0].yaw = yaw;
}
// The world's cylinder for seat `by` (rm_ra_live of its Reverse Gravity).
rm_ra_rg :: (v: [] RmServer, k: int, on: bool, by: int, x: f32, y: f32, z: f32) #export_c {
  if !rm_eg_live(v, k) || by < 0 || by >= EG_SEATS { return; }
  l := v[0].ab[k].live[by * RA_ABS + RA_REVERSE];
  rm_ra_live(v, k, SeatId.{value = by}, RA_REVERSE, on, x, y, z, 0, ifx on && !l.on then l.epoch + 1 else l.epoch);
}
// Person j is `m` metres over their feet.
rm_ra_air :: (v: [] RmServer, k: int, j: int, m: f32) #export_c {
  if !rm_eg_live(v, k) || j < 0 || j >= E5R_FOLK { return; }
  v[0].ab[k].air[j] = ifx m > 0.005 then least(eg_round(m * 100), 100000) else 0;
}
// A fall the world's ability dealt person j (`amount`), seat `by`'s doing: the rules deal it.
rm_ra_hurt :: (v: [] RmServer, k: int, j: int, amount: int, by: int) #export_c {
  if !rm_eg_live(v, k) || j < 0 || j >= E5R_FOLK || amount <= 0 { return; }
  e5rr_hurt(v[0].eg[k].rules[..], j, amount, ifx by >= 0 && by < EG_SEATS then EG_TGT_SEAT + by else -1);
}

// ---- into the room's table (room-everglade.coax eg_table)

// Every seat's abilities up, each in a slot of the table's EG_SLOT_AB on (room k's ab_slot keeps each
// one's), a new cast of one a new entity in it; one that ends frees its slot.
ra_table :: (v: [] RmServer, k: int) {
  r := v[0].ab[k..<k + 1];
  rm := v[0].eg[k..<k + 1];
  used: [EG_SLOT_ABS] bool;
  for q: 0..<EG_SEATS * WE_WATCH { if rm[0].fx_slot[q] > 0 { used[rm[0].fx_slot[q] - 1] = true; } }   // the watch effects' (eg_table)
  for q: 0..<EG_SEATS * RA_ABS {
    if !r[0].live[q].on { rm[0].ab_slot[q] = 0; continue; }
    if rm[0].ab_slot[q] > 0 { used[rm[0].ab_slot[q] - 1] = true; }
  }
  for q: 0..<EG_SEATS * RA_ABS {
    l := r[0].live[q];
    if !l.on { continue; }
    if rm[0].ab_slot[q] == 0 {
      for j: 0..<EG_SLOT_ABS { if !used[j] { used[j] = true; rm[0].ab_slot[q] = j + 1; break; } }
      if rm[0].ab_slot[q] == 0 { continue; }   // more up than the table holds: the rest wait
    }
    ab := q % RA_ABS;
    wire_hist_put(rm[0].hist[..], EG_SLOT_AB + rm[0].ab_slot[q] - 1,
                  WireS.{id = WIRE_ID_MADE + l.id, kind = WK_ZONE, x = l.x, y = l.y, z = l.z, yaw = l.yaw, hp = -1, g = 1,
                         owner = q / RA_ABS, p1 = ab, p2 = ifx ab == RA_REVERSE then RA_RG_R_CM else l.mode}, wire_rel(WK_ZONE), false, false);
  }
}

#test "everglade room abilities: each seat's abilities go to the world and come back as their own entities, two seats' cylinders at once" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_control(v[..], "levels 0 2\n");   // the full Everglade character: levels off, as an admin can set
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-rg HTTP/1.1\r\n\r\n";
  box: [1] EgInbox;
  #assert rm_join(v[..], 0, ev) == 0 && rm_join(v[..], 1, ev) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  // seat 0 casts Reverse Gravity (slot 4): the world is handed it with its aim, the rules roll nothing
  rm_heard(v[..], 0, "C 1 4 0 0 200 -1");
  eg_test_tick(v[..], k);   // (it starts at the tick: room-casts.coax)
  #assert rm_ra_casts(v[..], k) == 1;
  c: [RA_CAST_FLOATS] f32;
  rm_ra_cast(v[..], k, 0, c[..]);
  #assert c[0] == 0 && c[1] == f32(RA_REVERSE) && c[6] == 1 && c[9] == 2;
  any := false; for q: 0..<EG_CASTS { if v[0].eg[k].casts[q].on { any = true; } }
  #assert !any;
  // seat 1 casts Wind Wall (slot 5): the rules roll it and the world runs it too
  rm_heard(v[..], 1, "C 1 5 0 0 200 -1");
  eg_test_tick(v[..], k);   // (it starts at the tick: room-casts.coax)
  #assert rm_ra_casts(v[..], k) == 2;
  rm_ra_cast(v[..], k, 1, c[..]);
  #assert c[0] == 1 && c[1] == 1 && c[6] == 1;
  rm_ra_heard(v[..], k);
  // the world says what each seat holds up: both cylinders (seat 1 cast one too) and seat 1's wall
  rm_ra_live(v[..], k, SeatId.{value = 0}, RA_REVERSE, true, 0, 0, 0, 0, 1);
  rm_ra_live(v[..], k, SeatId.{value = 1}, RA_REVERSE, true, 3, 0, 0, 0, 1);
  rm_ra_live(v[..], k, SeatId.{value = 1}, 1, true, 0, 0, 0, 1.5, 1);
  rm_ra_air(v[..], k, 3, 2.5);
  person := [12] f32.[2, 0, 0, 0, 0, 9, 1, -1, 0, -1, 0, 9];   // townsperson 3 outdoors, 2 m off (the town's own, 9 HP at most)
  rm_eg_folk(v[..], k, 3, person[..]);
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  a := eg_test_of(box[..], 0); b := eg_test_of(box[..], 1);
  for c2: 0..<2 {
    r1 := eg_test_ent(box[..], c2, WIRE_ID_MADE + 900001); r2 := eg_test_ent(box[..], c2, WIRE_ID_MADE + 900002); w3 := eg_test_ent(box[..], c2, WIRE_ID_MADE + 900003);
    #assert r1.kind == WK_ZONE && r1.x == 0 && r1.owner == 0 && r1.p1 == RA_REVERSE && r1.p2 == RA_RG_R_CM;
    #assert r2.kind == WK_ZONE && r2.x == 3 && r2.owner == 1 && r2.p1 == RA_REVERSE && r2.p2 == RA_RG_R_CM;
    #assert w3.kind == WK_ZONE && w3.yaw == 1.5 && w3.owner == 1 && w3.p1 == 1;
    // the person off their feet: their row's Y
    #assert eg_test_ent(box[..], c2, WIRE_ID_FOLK + 3).y == 2.5;
  }
  #assert eg_test_has(a, "e cast 0 4 ") && eg_test_has(b, "e cast 1 5 ");
  // not again while nothing changed
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  #assert !eg_test_has(eg_test_of(box[..], 1), "s 11000") && !eg_test_has(eg_test_of(box[..], 1), "s 100003");
  // a joiner's snapshot has all three
  #assert rm_join(v[..], 2, ev) == 2;
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  #assert eg_test_ent(box[..], 2, WIRE_ID_MADE + 900001).id == WIRE_ID_MADE + 900001 && eg_test_ent(box[..], 2, WIRE_ID_MADE + 900002).id == WIRE_ID_MADE + 900002 && eg_test_ent(box[..], 2, WIRE_ID_MADE + 900003).id == WIRE_ID_MADE + 900003;
  #assert eg_test_ent(box[..], 2, WIRE_ID_FOLK + 3).y == 2.5;
  // seat 0's E goes to the world (its copy ends its own); seat 1's wall cast again is a new entity
  rm_heard(v[..], 0, "E 2 5 4");
  #assert rm_ra_casts(v[..], k) == 1;
  rm_ra_cast(v[..], k, 0, c[..]);
  #assert c[0] == 0 && c[6] == 0;
  rm_ra_heard(v[..], k);
  rm_ra_live(v[..], k, SeatId.{value = 0}, RA_REVERSE, false, 0, 0, 0, 0, 1);
  rm_ra_live(v[..], k, SeatId.{value = 1}, 1, true, 0, 0, 0, 1.5, 2);
  rm_ra_air(v[..], k, 3, 0);
  for q: 0..<10 { eg_test_tick(v[..], k); }
  eg_test_drain(v[..], box[..]);
  b = eg_test_of(box[..], 1);
  #assert eg_test_has(b, "x 1100001") && !eg_test_has(b, "x 1100002") && eg_test_has(b, "x 1100003");
  #assert eg_test_ent(box[..], 1, WIRE_ID_MADE + 900001).id == -1 && eg_test_ent(box[..], 1, WIRE_ID_MADE + 900003).id == -1 && eg_test_ent(box[..], 1, WIRE_ID_MADE + 900004).p1 == 1;
  #assert eg_test_ent(box[..], 1, WIRE_ID_FOLK + 3).y == 0;
}
#test "everglade room abilities: Levitate goes to the world, a spell's mode goes with its cast to the world, every page and its entity, and Levitate's keys in the input" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_control(v[..], "levels 0 2\n");   // the full Everglade character: levels off, as an admin can set
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-mode HTTP/1.1\r\n\r\n";
  box: [1] EgInbox;
  #assert rm_join(v[..], 0, ev) == 0 && rm_join(v[..], 1, ev) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  c: [RA_CAST_FLOATS] f32;
  // seat 0's Levitate (slot 6): the world runs it in seat 0's copy
  rm_heard(v[..], 0, "C 1 6 0 0 0 -1");
  eg_test_tick(v[..], k);   // (it starts at the tick: room-casts.coax)
  #assert rm_ra_casts(v[..], k) == 1;
  rm_ra_cast(v[..], k, 0, c[..]);
  #assert c[0] == 0 && c[1] == 2 && c[6] == 1 && c[10] == 0;
  rm_ra_heard(v[..], k);
  // seat 1's Destroy Water (slot 18, mode 2): the world, the e cast and the entity carry it
  rm_heard(v[..], 1, "C 1 18 1 0 200 -1 2");
  eg_test_tick(v[..], k);   // (it starts at the tick: room-casts.coax)
  #assert rm_ra_casts(v[..], k) == 1;
  rm_ra_cast(v[..], k, 0, c[..]);
  #assert c[0] == 1 && c[1] == 14 && c[10] == 2;
  rm_ra_heard(v[..], k);
  rm_ra_live(v[..], k, SeatId.{value = 1}, 14, true, 1, 0, 2, 0, 1);
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  a := eg_test_of(box[..], 0);
  // its e cast ends with the mode
  at := -1; head := "e cast 1 18 ";
  for i: 0..<a.count - head.count { if at < 0 && a[i..<i + head.count] == head { at = i; } }
  #assert at >= 0;
  end := at; while end < a.count && a[end] != ';' && a[end] != '|' { end += 1; }
  #assert a[end - 2..<end] == " 2";
  dw := eg_test_ent(box[..], 0, WIRE_ID_MADE + 900001);
  #assert dw.kind == WK_ZONE && dw.x == 1 && dw.z == 2 && dw.owner == 1 && dw.p1 == 14 && dw.p2 == 2;
  // a cast with a field past its mode is no cast
  for q: 0..<30 { eg_test_tick(v[..], k); }
  rm_heard(v[..], 1, "C 2 18 1 0 200 -1 2 9");
  #assert rm_ra_casts(v[..], k) == 0;
  // the rise and sink keys (8, 16) come through the input to the world
  rm_heard(v[..], 0, "I 3 0 0 0 0 0 24 0");
  in: [EG_IN_FIELDS] int;
  #assert rm_eg_begin(v[..], k) && rm_eg_input(v[..], k, SeatId.{value = 0}, in[..]) && in[6] == 24;
}
