#load "../../../aethyr/ids.coax";
// Character checkpoint profile 2. All effects here consume the shared checked
// capture/flow policies. A schema 1 seat keeps the legacy path unchanged.
#load "../../../aethyr/session/checkpoint-flow.coax";
#load "tests/checkpoint-fixture.coax";
// The limited-use counts profile 2 carries: the first 11 (state 16..26). Profile 3 carries the rest
// of the rules' RS_USES in its optional `uses` (CC_MORE); a profile 2 restore leaves those full.
CK_USES :: CC_STATE - 16;
#test "checkpoint: a capture carries every limited-use count the rules keep, 11 in state and the rest in uses" { #assert CK_USES == 11 && CK_USES + CC_MORE == RS_USES; }
CheckpointSlot :: struct {
  live:bool;owner:int;pid:[TICKET_PID]u8;pid_n:int;
  latest:CharacterCapture;latest_rest:CharacterRest;capture_mono:int;acked:int;accepted:bool;accepted_mono:int;
  receipt_mono:int;accepted_at:int;accepted_process:int;accepted_capture_wall:int;
  held:bool;held_capture:CharacterCapture;held_rest:CharacterRest;held_mono:int;   // the capture sent and not yet acknowledged: it goes again as it was (#13185)
  since_mono:int;   // its restoring hello: until its first receipt, the loss bound counts from there (#13185)
}
RmCheckpoints :: struct {
  slot:[CF_CAP]CheckpointSlot;
  cursor:int;rev:int;last:int;
  fly:bool;waiting:bool;fly_i:int;fly_capture:CharacterCapture;fly_rest:CharacterRest;fly_mono:int;
  two_only:bool;two_falls:int;   // profile 3 refused by this API (400 or 5xx): profile 2 from then on (#13046)
  request:int;sent_mono:int;retry_at:int;tries:int;
  out:[CC_BODY]u8;out_n:int;mac:[64]u8;
  posts:int;retries:int;applied:int;duplicates:int;failures:int;late:int;refused:int;fenced:int;
  finalizing:bool;
}

#test "checkpoint: restore the signed dead body and resources once; only an exact receipt releases initial gameplay" #steps 4000000000 {
  v:[1]RmServer;ck_test_init(v[..]);c:=cc_fixture();c.state[7]=0;k:=ck_test_join(v[..],0,7,c);#assert k>=0;
  h:=v[0].eg[k].rules[0].b[0].c[E5RR_SEAT];#assert h.hp==0&&h.dead&&h.temp==4&&h.slots[1]==0;
  #assert rm_eg_back(v[..],k, SeatId.{value = 0},0)==1&&rm_eg_back(v[..],k, SeatId.{value = 0},1)<-1.23&&rm_eg_back(v[..],k, SeatId.{value = 0},1)>-1.24;
  rm_heard(v[..],0,"H 5 ranger.0.0.0 druid 0 Ash");#assert v[0].eg[k].rules[0].klass[0]==1&&v[0].eg[k].rules[0].b[0].c[E5RR_SEAT].hp==0;
  // waiting for its first receipt the seat is held; its encounter plays on for the others (#13185)
  #assert !rm_checkpoint_paused(v[..],k)&&!ck_can_play(v[..],k, SeatId.{value = 0});ck_test_place(v[..],k);
  #assert rm_checkpoint_due(v[..])>0&&rm_checkpoint_pending(v[..])==1;
  rm_checkpoint_answer(v[..],1,200,"{\"kept\":1}");#assert !ck_can_play(v[..],k, SeatId.{value = 0})&&rm_checkpoint_pending(v[..])==1;
  rm_clock(v[..],v[0].ck.retry_at,1762190001000);#assert rm_checkpoint_due(v[..])>0;
  b:[256]u8;rm_checkpoint_answer(v[..],2,200,ck_test_receipt(v[..],"duplicate",b[..]));#assert ck_can_play(v[..],k, SeatId.{value = 0})&&!rm_checkpoint_paused(v[..],k)&&rm_checkpoint_pending(v[..])==0;
  i:=ck_find(v[..],"p-a");rm_clock(v[..],v[0].ck.slot[i].accepted_mono+30000,1762190030000);tick:=v[0].eg[k].tick;#assert !rm_eg_begin(v[..],k)&&v[0].eg[k].tick==tick;
}
#test "checkpoint: mailbox coalesces without changing a lost-response retry, and a late answer cannot acknowledge it" #steps 4000000000 {
  v:[1]RmServer;ck_test_init(v[..]);c:=CharacterCapture.{};k:=ck_test_join(v[..],0,7,c);ck_test_place(v[..],k);
  #assert rm_checkpoint_due(v[..])>0;first:=cc_read(cast(string)v[0].ck.out[0..<v[0].ck.out_n],true);#assert first.ok&&first.n[9]==7;
  v[0].eg[k].rules[0].b[0].c[E5RR_SEAT].hp=5;ck_capture(v[..],k, SeatId.{value = 0});rm_checkpoint_answer(v[..],1,500,"");
  rm_clock(v[..],v[0].ck.retry_at,1762190001000);#assert rm_checkpoint_due(v[..])>0;again:=cc_read(cast(string)v[0].ck.out[0..<v[0].ck.out_n],true);
  #assert again.n[9]==7&&again.n[3]==first.n[3]&&again.n[4]==first.n[4]&&again.n[5]>first.n[5];
  b:[256]u8;rm_checkpoint_answer(v[..],1,200,ck_test_receipt(v[..],"applied",b[..]));#assert v[0].ck.late==1&&rm_checkpoint_pending(v[..])==1;
  rm_checkpoint_answer(v[..],2,200,ck_test_receipt(v[..],"duplicate",b[..]));#assert rm_checkpoint_pending(v[..])==1&&rm_checkpoint_due(v[..])>0;
  last:=cc_read(cast(string)v[0].ck.out[0..<v[0].ck.out_n],true);#assert last.n[9]==5&&last.n[3]>first.n[3];
  rm_checkpoint_answer(v[..],3,200,ck_test_receipt(v[..],"applied",b[..]));#assert rm_checkpoint_pending(v[..])==0;
}
#test "checkpoint: a saturated outbox refuses admission, preserving unsaved and in-flight entries" #steps 4000000000 {
  v:[1]RmServer;ck_test_init(v[..]);c:=cc_fixture();p:[40]u8;
  for i:0..<256{n:=rv_int(p[..],tk_add(p[..],0,"p-"),i);v[0].ck.slot[i]=CheckpointSlot.{live=true,owner=7,pid_n=n,latest=c};for q:0..<n{v[0].ck.slot[i].pid[q]=p[q];}}
  t:=Ticket.{ok=true,schema=2,pid_n=3,owner=7};t.pid[0]='n';t.pid[1]='e';t.pid[2]='w';#assert !ck_reserve(v[..],t)&&v[0].ck.refused==1&&rm_checkpoint_pending(v[..])==256;
  v[0].ck.slot[17].acked=3;v[0].ck.fly=true;v[0].ck.fly_i=17;#assert !ck_reserve(v[..],t)&&rm_checkpoint_pending(v[..])==255;
  v[0].ck.fly=false;#assert ck_reserve(v[..],t)&&ck_find(v[..],"new")==17&&rm_checkpoint_pending(v[..])==255;
}
#test "checkpoint: a planned final flush waits for the final capture, never a legacy receipt" #steps 4000000000 {
  v:[1]RmServer;ck_test_init(v[..]);c:=CharacterCapture.{};k:=ck_test_join(v[..],0,7,c);ck_test_place(v[..],k);#assert rm_checkpoint_due(v[..])>0;
  b:[256]u8;rm_checkpoint_answer(v[..],1,200,ck_test_receipt(v[..],"applied",b[..]));#assert rm_checkpoint_pending(v[..])==0;
  v[0].eg[k].rules[0].b[0].c[E5RR_SEAT].hp=4;rm_checkpoint_finish(v[..]);#assert rm_checkpoint_pending(v[..])==1&&rm_checkpoint_paused(v[..],k);
  v[0].eg[k].rules[0].b[0].c[E5RR_SEAT].hp=3;rm_checkpoint_flush(v[..]);#assert !rm_checkpoint_clean(v[..]);
  rm_vitals_flush(v[..]);if rm_vitals_due(v[..])>0{rm_vitals_local(v[..]);}#assert rm_checkpoint_pending(v[..])==1;
  #assert rm_checkpoint_due(v[..])>0;sent:=cc_read(cast(string)v[0].ck.out[0..<v[0].ck.out_n],true);#assert sent.n[9]==4;
  rm_checkpoint_answer(v[..],2,200,ck_test_receipt(v[..],"applied",b[..]));#assert rm_checkpoint_pending(v[..])==0&&rm_checkpoint_clean(v[..]);
}
#test "checkpoint: placement waits for the hello that restores the signed capture" #steps 4000000000 {
  v:[1]RmServer;ck_test_init(v[..]);k:=ck_test_join(v[..],0,7,cc_fixture());
  v[0].eg[k].seat[0].checkpoint_hello=false;
  #assert !rm_eg_unplaced(v[..],k, SeatId.{value = 0});
  rm_heard(v[..],0,"H 5 ranger.0.0.0 druid 0 Ash");
  #assert rm_eg_unplaced(v[..],k, SeatId.{value = 0})&&rm_eg_back(v[..],k, SeatId.{value = 0},1)<-1.23;
}

#test "checkpoint: a player writes on the timer and at their own events, never per tick; an idle one writes nothing and plays on (#13184)" #steps 4000000000 {
  v:[1]RmServer;ck_test_init(v[..]);k:=ck_test_join(v[..],0,7,CharacterCapture.{});
  #assert rm_checkpoint_due(v[..])==0;   // joined and said hello, not yet placed: nothing to save
  ck_test_place(v[..],k);#assert rm_checkpoint_pending(v[..])==1&&rm_checkpoint_due(v[..])>0;   // placed: its first capture at once
  b:[256]u8;rm_checkpoint_answer(v[..],1,200,ck_test_receipt(v[..],"applied",b[..]));#assert rm_checkpoint_pending(v[..])==0;
  i:=ck_find(v[..],"p-a");rev:=v[0].ck.slot[i].acked;
  // a minute standing still: each timer finds the same character, writes nothing, and its play never pauses
  wall:=1762190000000;mono:=v[0].mono_ms;
  for q:1..<13{rm_clock(v[..],mono+q*CF_EVERY,wall+q*CF_EVERY);#assert rm_checkpoint_due(v[..])==0&&!rm_checkpoint_paused(v[..],k);}
  #assert v[0].ck.posts==1&&v[0].ck.rev==rev&&v[0].ck.slot[i].accepted_mono==v[0].mono_ms;
  // moving is not a write by itself: the next timer is
  for q:0..<30{rm_eg_moved(v[..],k, SeatId.{value = 0},q+1,1+f32(q)*0.1,0,2,0,0,0,0,0,0,0);#assert rm_checkpoint_due(v[..])==0;}
  rm_clock(v[..],mono+13*CF_EVERY,wall+13*CF_EVERY);#assert rm_checkpoint_due(v[..])>0&&v[0].ck.posts==2;
  sent:=cc_read(cast(string)v[0].ck.out[0..<v[0].ck.out_n],true);#assert sent.ok&&sent.n[13]==3900;
  rm_checkpoint_answer(v[..],2,200,ck_test_receipt(v[..],"applied",b[..]));
  // its socket closing is its own event: saved now, without the timer
  v[0].eg[k].rules[0].b[0].c[E5RR_SEAT].hp=3;eg_hold(v[..],k, SeatId.{value = 0});
  #assert rm_checkpoint_pending(v[..])==1&&rm_checkpoint_due(v[..])>0&&cc_read(cast(string)v[0].ck.out[0..<v[0].ck.out_n],true).n[9]==3;
}
#test "checkpoint: a refused capture waits its turn while another player's posts, and a seat waiting for its first receipt never stops the tick (#13185)" #steps 4000000000 {
  v:[1]RmServer;ck_test_init(v[..]);k:=ck_test_join_as(v[..],0,"p-a",7,CharacterCapture.{});#assert k>=0;ck_test_place(v[..],k);
  b:[256]u8;#assert rm_checkpoint_due(v[..])>0;rm_checkpoint_answer(v[..],1,200,ck_test_receipt(v[..],"applied",b[..]));
  a:=SeatId.{value = 0};#assert ck_can_play(v[..],k,a);
  // B joins the same room, restored: held until its first receipt, while A's encounter goes on ticking
  #assert ck_test_join_as(v[..],1,"p-b",7,CharacterCapture.{})==k;bs:=v[0].conns[1].seat;#assert bs>0;s:=SeatId.{value = bs};
  rm_eg_moved(v[..],k,s,0,3,0,2,0,0,0,0,0,0,0);
  #assert !ck_can_play(v[..],k,s)&&!rm_checkpoint_paused(v[..],k);tick:=v[0].eg[k].tick;#assert rm_eg_begin(v[..],k)&&v[0].eg[k].tick==tick+1;
  // the store refuses B's capture: A's next one goes before B's comes round again, and B's is unchanged
  #assert rm_checkpoint_due(v[..])>0;first:=cc_read(cast(string)v[0].ck.out[0..<v[0].ck.out_n],true);#assert first.ok&&cast(string)first.pid[0..<first.pid_n]=="p-b";
  rm_checkpoint_answer(v[..],2,200,ck_test_receipt(v[..],"unknown",b[..]));#assert !v[0].ck.fly&&rm_checkpoint_pending(v[..])==1;
  v[0].eg[k].rules[0].b[0].c[E5RR_SEAT].hp=5;ck_capture(v[..],k,a);rm_clock(v[..],v[0].ck.retry_at,1762190001000);
  #assert rm_checkpoint_due(v[..])>0;next:=cc_read(cast(string)v[0].ck.out[0..<v[0].ck.out_n],true);#assert cast(string)next.pid[0..<next.pid_n]=="p-a"&&next.n[9]==5;
  rm_checkpoint_answer(v[..],3,200,ck_test_receipt(v[..],"applied",b[..]));#assert ck_can_play(v[..],k,a)&&rm_checkpoint_pending(v[..])==1;
  #assert rm_checkpoint_due(v[..])>0;again:=cc_read(cast(string)v[0].ck.out[0..<v[0].ck.out_n],true);#assert cast(string)again.pid[0..<again.pid_n]=="p-b"&&again.n[3]==first.n[3]&&again.n[4]==first.n[4];
  rm_checkpoint_answer(v[..],4,200,ck_test_receipt(v[..],"applied",b[..]));#assert ck_can_play(v[..],k,s)&&rm_checkpoint_pending(v[..])==0;
  // the loss bound still holds: a seat whose first receipt never comes holds its encounter after CF_BOUND
  #assert ck_test_join_as(v[..],2,"p-c",7,CharacterCapture.{})==k;c:=SeatId.{value = v[0].conns[2].seat};#assert !ck_can_play(v[..],k,c)&&!rm_checkpoint_paused(v[..],k);
  i:=ck_find(v[..],"p-c");rm_clock(v[..],v[0].ck.slot[i].since_mono+CF_BOUND,1762190031000);#assert ck_stale(v[..],k,c)&&rm_checkpoint_paused(v[..],k);
}
ck_find :: (v:[]RmServer,pid:string)->int {
  for i:0..<CF_CAP{e:=v[0].ck.slot[i..<i+1];if e[0].live&&cast(string)e[0].pid[0..<e[0].pid_n]==pid{return i;}}return -1;
}
ck_seated :: (v:[]RmServer,pid:string)->bool {
  for k:0..<EG_ROOMS{if !v[0].eg[k].live{continue;}for s:0..<EG_SEATS{if !v[0].eg[k].seat[s].live{continue;}tk:=eg_ticket(v,k, SeatId.{value = s});if tk.ok&&tk.schema==2&&cast(string)tk.pid[0..<tk.pid_n]==pid{return true;}}}return false;
}
ck_reserve :: (v:[]RmServer,tk:Ticket)->bool {
  if tk.schema!=2{return true;}pid:=tk.pid;name:=cast(string)pid[0..<tk.pid_n];i:=ck_find(v,name);
  if i>=0{if v[0].ck.slot[i].owner>tk.owner{return false;}if v[0].ck.slot[i].owner==tk.owner{return true;}}
  if i<0{for j:0..<CF_CAP{e:=v[0].ck.slot[j..<j+1];if !e[0].live{i=j;break;}ep:=cast(string)e[0].pid[0..<e[0].pid_n];if cf_reuse(e[0].live,e[0].latest.ok&&e[0].latest.n[3]>e[0].acked,ck_seated(v,ep),v[0].ck.fly&&v[0].ck.fly_i==j){i=j;break;}}}
  if i<0{v[0].ck.refused+=1;return false;}
  v[0].ck.slot[i]=CheckpointSlot.{live=true,owner=tk.owner,pid_n=tk.pid_n};for q:0..<tk.pid_n{v[0].ck.slot[i].pid[q]=pid[q];}return true;
}
ck_slot_seat :: (v:[]RmServer,k:int, s_id: SeatId)->int {
  tk:=eg_ticket(v,k, s_id);if !tk.ok||tk.schema!=2{return -1;}return ck_find(v,cast(string)tk.pid[0..<tk.pid_n]);
}
// The write rate (#13184). A seat is captured on the CF_EVERY timer (rm_checkpoint_due) and at its own
// events: placed after its hello, a socket closed, a leave, a journey to another room, a drain. Never per
// tick, and another player's join captures nobody else. A capture equal to the seat's last one is no new
// revision, so it is no write: an idle player writes nothing. So each player writes at most once per
// CF_EVERY plus once per event of their own, and one post is in flight per process.
ck_capture :: (v:[]RmServer,k:int, s_id: SeatId) { s := s_id.value;
  if v[0].ck.finalizing{return;}
  i:=ck_slot_seat(v,k, s_id);if i<0{return;}st:=v[0].eg[k].seat[s];if !st.placed||!st.checkpoint_hello{return;}
  tk:=eg_ticket(v,k, s_id);if v[0].ck.slot[i].owner!=tk.owner{return;}
  r:=v[0].eg[k].relay;if r<0{return;}
  c:=CharacterCapture.{ok=true,pid_n=tk.pid_n,room_n=v[0].relays[r].code_n};c.pid=tk.pid;c.room=v[0].relays[r].code;
  pins:=WirePins.{};hero:=v[0].eg[k].rules[0].b[0].c[E5RR_SEAT+s];
  c.n=[17]int.[2,tk.owner,v[0].vit.gen,0,v[0].wall_ms,v[0].wall_ms,pins.engine,pins.rules,pins.content,hero.hp,hero.hp_max,ev_xp_of(v,k, s_id),v[0].eg[k].wanted[s],eg_round(st.pose.x*1000),eg_round(st.pose.y*1000),eg_round(st.pose.z*1000),eg_round(st.pose.yaw*1000)];
  c.dead=hero.dead&&hero.hp<=0;c.state[0]=ifx v[0].eg[k].rules[0].klass[s]==1 then 1 else 0;   // the capture's class bit: the Warlock or not (a Character Create class comes back with its hello)
  c.state[1]=ifx (st.flags&EV_DEMO_FLAG)!=0&&tk.admin then 1 else 0;c.state[2]=hero.temp;
  c.state[3]=rs_max(0,trv_repair_ticks()-(v[0].eg[k].tick-st.repaired));c.state[4]=rs_max(0,EG_CAST_GAP-(v[0].eg[k].tick-st.last_cast));c.state[5]=v[0].ev[k].down[s];
  for q:0..<10{c.state[6+q]=hero.slots[q];}for q:0..<CK_USES{c.state[16+q]=hero.uses[q];}
  // Everglade II also carries the seat's rest (profile 3)
  rest:=CharacterRest.{};if v[0].eg[k].e2&&rs_carry_out(v[0].eg[k].rules[0].b[..],E5RR_SEAT+s,rest.n[..]){rest.on=true;c.n[0]=3;rest.more=true;for q:0..<CC_MORE{rest.uses[q]=hero.uses[CK_USES+q];}}
  e:=v[0].ck.slot[i];
  if e.latest.ok&&ck_same(e.latest,e.latest_rest,c,rest){
    // unchanged: when the accepted capture is this one, it still describes the character now, so the
    // loss bound (CF_BOUND) counts from now; nothing is unsaved
    if e.accepted&&e.latest.n[3]<=e.acked{v[0].ck.slot[i].accepted_mono=v[0].mono_ms;}
    return;
  }
  v[0].ck.rev+=1;c.n[3]=v[0].ck.rev;
  v[0].ck.slot[i].latest=c;v[0].ck.slot[i].latest_rest=rest;v[0].ck.slot[i].capture_mono=v[0].mono_ms;
}
// Whether two captures hold the same character: all but the revision and the capture and send times.
ck_same :: (a:CharacterCapture,ar:CharacterRest,b:CharacterCapture,br:CharacterRest)->bool {
  for q:0..<17{if q>=3&&q<=5{continue;}if a.n[q]!=b.n[q]{return false;}}
  if a.dead!=b.dead||a.pid_n!=b.pid_n||a.room_n!=b.room_n{return false;}
  for q:0..<a.room_n{if a.room[q]!=b.room[q]{return false;}}
  for q:0..<CC_STATE{if a.state[q]!=b.state[q]{return false;}}
  if ar.on!=br.on||ar.more!=br.more{return false;}
  for q:0..<CC_REST{if ar.n[q]!=br.n[q]{return false;}}
  for q:0..<CC_MORE{if ar.uses[q]!=br.uses[q]{return false;}}
  return true;
}
ck_restore :: (v:[]RmServer,k:int, s_id: SeatId) { s := s_id.value;
  tk:=eg_ticket(v,k, s_id);c:=tk.capture;if tk.schema!=2||!c.ok{return;}
  hero:=v[0].eg[k].rules[0].b[0].c[E5RR_SEAT+s..<E5RR_SEAT+s+1];
  hero[0].hp=rs_min(c.n[9],hero[0].hp_max);hero[0].dead=c.dead;hero[0].temp=c.state[2];
  for q:0..<10{hero[0].slots[q]=rs_min(c.state[6+q],hero[0].slots_max[q]);}for q:0..<CK_USES{hero[0].uses[q]=rs_min(c.state[16+q],hero[0].uses_max[q]);}
  v[0].eg[k].seat[s].repaired=v[0].eg[k].tick-(trv_repair_ticks()-c.state[3]);v[0].eg[k].seat[s].last_cast=v[0].eg[k].tick-(EG_CAST_GAP-c.state[4]);v[0].ev[k].down[s]=c.state[5];
  v[0].ev[k].fought[s]=v[0].eg[k].tick+1; // a restart is not a free out-of-combat Long Rest
  v[0].eg[k].wanted[s]=c.n[12];v[0].eg[k].seat[s].want_seed=c.n[12];
  // a profile 3 rest resumes where it was, without offline credit; one that does not fit this body is dropped
  if c.n[0]==3&&tk.rest.more{for q:0..<CC_MORE{hero[0].uses[CK_USES+q]=rs_min(tk.rest.uses[q],hero[0].uses_max[CK_USES+q]);}}
  if v[0].eg[k].e2&&c.n[0]==3&&tk.rest.on{_:=rs_carry_in(v[0].eg[k].rules[0].b[..],E5RR_SEAT+s,tk.rest.n[..]);v[0].eg[k].seat[s].rest_told= -1;}
  r:=v[0].eg[k].relay;room:=c.room;v[0].eg[k].seat[s].back=false;
  // the same room's code, or for Everglade II any of its rooms: they are one land (#13057), so a
  // restarted or drained room's player comes back where they stood in whichever instance takes them
  here:=ifx r>=0 then cast(string)v[0].relays[r].code[0..<v[0].relays[r].code_n] else "";saved:=cast(string)room[0..<c.room_n];
  if r>=0&&(saved==here||(v[0].eg[k].e2&&eg_e2_code(saved)&&eg_e2_code(here))){st:=v[0].eg[k].seat[s..<s+1];st[0].back=true;st[0].back_x=f32(c.n[13])/1000;st[0].back_y=f32(c.n[14])/1000;st[0].back_z=f32(c.n[15])/1000;st[0].back_yaw=f32(c.n[16])/1000;st[0].back_at=rs_max(c.n[4],v[0].wall_ms-CF_BOUND);}
  // back_at: an idle character's capture keeps its first time (an unchanged one is not written again),
  // but the room never ran it more than CF_BOUND past its accepted capture, so that is the most a page's
  // claim may have moved
}
// The restoring hello (rm_heard H, once a seat): a seat with no receipt yet in this process has its
// restored body, the API's last accepted capture, as its saved state, so its loss bound counts from here.
ck_hello :: (v:[]RmServer,k:int, s_id: SeatId) {
  i:=ck_slot_seat(v,k, s_id);if i>=0&&!v[0].ck.slot[i].accepted{v[0].ck.slot[i].since_mono=v[0].mono_ms;}
}
// Whether seat s holds its encounter back (#13185): its last accepted capture is CF_BOUND old, or with
// none yet in this process, its restore is. A seat waiting for its first receipt is itself held
// (ck_can_play), but the others play on: a restore never stops the tick or the seating of others.
ck_stale :: (v:[]RmServer,k:int, s_id: SeatId)->bool {
  tk:=eg_ticket(v,k, s_id);if tk.schema!=2{return false;}i:=ck_slot_seat(v,k, s_id);if i<0{return true;}e:=v[0].ck.slot[i];
  return !cf_fresh(true,v[0].mono_ms-(ifx e.accepted then e.accepted_mono else e.since_mono));
}
ck_can_play :: (v:[]RmServer,k:int, s_id: SeatId)->bool {
  tk:=eg_ticket(v,k, s_id);if tk.schema!=2{return net_session_saved(NET_DURABLE_NONE,false,0);}i:=ck_slot_seat(v,k, s_id);return i>=0&&net_session_saved(NET_DURABLE_RECEIPTS,v[0].ck.slot[i].accepted,v[0].mono_ms-v[0].ck.slot[i].accepted_mono);
}
rm_checkpoint_paused :: (v:[]RmServer,k:int)->bool #export_c #effects(all) {
  if k<0||k>=EG_ROOMS||!v[0].eg[k].live{return false;}
  for s:0..<EG_SEATS{if v[0].eg[k].seat[s].live&&v[0].eg[k].seat[s].checkpoint_hello&&(v[0].ck.finalizing||ck_stale(v,k, SeatId.{value = s})){return true;}}return false;
}
ck_pause :: (v:[]RmServer,k:int) {
  for s:0..<EG_SEATS{st:=v[0].eg[k].seat[s..<s+1];if !st[0].live{continue;}st[0].q_n=0;st[0].bank=0;st[0].sat_ms=v[0].mono_ms;st[0].earned=0;}
}
rm_checkpoint_flush :: (v:[]RmServer) #export_c #effects(all) {
  for k:0..<EG_ROOMS{if !v[0].eg[k].live{continue;}for s:0..<EG_SEATS{if v[0].eg[k].seat[s].live{ck_capture(v,k, SeatId.{value = s});}}}
}
rm_checkpoint_finish :: (v:[]RmServer) #export_c #effects(all) {rm_checkpoint_flush(v);v[0].ck.finalizing=true;}
rm_checkpoint_clean :: (v:[]RmServer)->bool #export_c #effects(all) {return rm_checkpoint_pending(v)==0&&!v[0].ck.fly;}
rm_checkpoint_pending :: (v:[]RmServer)->int #export_c #effects(all) {
  n:=0;for i:0..<CF_CAP{e:=v[0].ck.slot[i..<i+1];if e[0].live&&e[0].latest.ok&&e[0].latest.n[3]>e[0].acked{n+=1;}}return n;
}
rm_checkpoint_due :: (v:[]RmServer)->int #export_c #effects(all) {
  v[0].ck.out_n=0;if v[0].tkey_n==0{return 0;}
  if v[0].mono_ms-v[0].ck.last>=CF_EVERY{rm_checkpoint_flush(v);v[0].ck.last=v[0].mono_ms;}
  if v[0].ck.waiting{if v[0].mono_ms-v[0].ck.sent_mono<CF_RESPONSE{return 0;}ck_failed(v);}
  if v[0].mono_ms<v[0].ck.retry_at{return 0;}
  if !v[0].ck.fly{
    // round the slots from the cursor: a capture refused or unanswered waits its turn again, so one
    // player's (an absent one's too) never holds back the others' (#13185); it goes again as it was
    for q:0..<CF_CAP{i:=(v[0].ck.cursor+q)%CF_CAP;e:=v[0].ck.slot[i..<i+1];if !e[0].live||!e[0].latest.ok||e[0].latest.n[3]<=e[0].acked{continue;}
      if !e[0].held||e[0].held_capture.n[3]<=e[0].acked{e[0].held=true;e[0].held_capture=e[0].latest;e[0].held_rest=e[0].latest_rest;e[0].held_mono=e[0].capture_mono;}
      v[0].ck.fly=true;v[0].ck.fly_i=i;v[0].ck.fly_capture=e[0].held_capture;v[0].ck.fly_rest=e[0].held_rest;v[0].ck.fly_mono=e[0].held_mono;v[0].ck.cursor=(i+1)%CF_CAP;break;}
  }
  if !v[0].ck.fly{return 0;}c:=v[0].ck.fly_capture;c.n[5]=rs_max(v[0].wall_ms,c.n[4]);
  if v[0].ck.two_only{c.n[0]=2;}body:=cc_write_rest(c,v[0].ck.fly_rest,v[0].ck.out[..]);
  if body.count==0||!checkpoint2_input(body,c.n[5])||!tk_mac(cast(string)v[0].tkey[0..<v[0].tkey_n],body,v[0].ck.mac[..]){return 0;}
  v[0].ck.request+=1;v[0].ck.waiting=true;v[0].ck.sent_mono=v[0].mono_ms;v[0].ck.out_n=body.count;v[0].ck.posts+=1;if v[0].ck.tries>0{v[0].ck.retries+=1;}return body.count;
}
ck_failed :: (v:[]RmServer) {v[0].ck.waiting=false;v[0].ck.fly=false;v[0].ck.tries+=1;v[0].ck.failures+=1;v[0].ck.retry_at=v[0].mono_ms+cf_wait(v[0].ck.tries,(v[0].vit.gen+v[0].ck.request)%2147483647);}
rm_checkpoint_answer :: (v:[]RmServer,request:int,status:int,body:string) #export_c #effects(all) {
  if !v[0].ck.waiting||request!=v[0].ck.request{v[0].ck.late+=1;return;}
  nodes:[32]JvNode;d:[1]Jv;valid:=status==200&&jv_parse(d[..],body,nodes[..]);f:=v[0].ck.fly_capture;
  word:[24]u8;wn:=ifx valid then jv_str(d[0],jv_get(d[0],0,"status"),word[..]) else -1;name:=ifx wn>=0 then cast(string)word[0..<wn] else "";
  version:=jv_int(d[0],jv_get(d[0],0,"v"),0);owner:=jv_int(d[0],jv_get(d[0],0,"owner"),0);process:=jv_int(d[0],jv_get(d[0],0,"process"),0);rev:=jv_int(d[0],jv_get(d[0],0,"rev"),0);accepted:=jv_int(d[0],jv_get(d[0],0,"accepted_at"),0);
  if !valid||!cf_ack(version,name,OwnerGeneration.{value=owner},process,rev,accepted,OwnerGeneration.{value=f.n[1]},f.n[2],f.n[3]){
    if valid&&cf_fenced(version,name,OwnerGeneration.{value=owner},process,rev,OwnerGeneration.{value=f.n[1]},f.n[2],f.n[3]){v[0].ck.fenced+=1;pid:=f.pid;_:=rl_owner_drop(v,cast(string)pid[0..<f.pid_n],owner+1,-1);i:=v[0].ck.fly_i;if v[0].ck.slot[i].owner==owner{v[0].ck.slot[i].live=false;}v[0].ck.fly=false;v[0].ck.waiting=false;return;}
    if !v[0].ck.two_only&&f.n[0]==3&&(status==400||status>=500){v[0].ck.two_only=true;v[0].ck.two_falls+=1;}
    ck_failed(v);return;
  }
  i:=v[0].ck.fly_i;if v[0].ck.slot[i].owner==owner{v[0].ck.slot[i].acked=rev;v[0].ck.slot[i].accepted=true;v[0].ck.slot[i].accepted_mono=v[0].ck.fly_mono;v[0].ck.slot[i].receipt_mono=v[0].mono_ms;v[0].ck.slot[i].accepted_at=accepted;v[0].ck.slot[i].accepted_process=process;v[0].ck.slot[i].accepted_capture_wall=f.n[4];v[0].ck.slot[i].held=false;}
  if name=="duplicate"{v[0].ck.duplicates+=1;}else{v[0].ck.applied+=1;}v[0].ck.fly=false;v[0].ck.waiting=false;v[0].ck.tries=0;v[0].ck.retry_at=0;
  trv_route_due(v);
}
