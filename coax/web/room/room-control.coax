#load "../../../aethyr/core/ids.coax";
// What the API says about Everglade's rooms, asked every two seconds (#12714; coax/web/api/player.c
// room_control): "pvp 0|1\nedit STAMP\nkick PID\n...".
//   - pvp: the realm's row (off unless switched on); the rules let harm reach another player only
//     while it is on (everglade5e-room-rules.coax EgBattle.pvp).
//   - edit: when Everglade's world or board last changed. A change is said to every page in every
//     room as "e edit STAMP" (wire_put_edit), and each page asks for the world again, so an admin's
//     placed bench shows for everyone within seconds of the publish (spec section 6.8).
//   - kick: who an admin kicked (24 hours): their sockets are closed, and a join with their ticket
//     gets no seat.
//   - hold: "hold CODE SEAT STAMP", a scripted Hold Person in everglade room CODE, once a STAMP (the
//     drift check's held step, GitHub #12886): the watch's hold on seat SEAT (3 s, no save to end it
//     sooner or later) and the rules' on the living townsperson nearest it (6 s, no save).
//     The paired check observes that person and sends "hold-person CODE SEAT STAMP PERSON"
//     to its development or local host; public rooms refuse the named command.
//   - place: "place CODE SEAT BOAT STAMP", seat SEAT of everglade room CODE put on the bank beside
//     rowboat BOAT (0 to 2, the Lantern, Thinking and Fern ponds' boats; river.coax), once a STAMP:
//     the boat check's two seats at a pond (GitHub #12861). Only a local room takes it, as the dice.
//   - dice: "dice fixed" (or "dice random"), every everglade room's rules rolling each die on half its
//     faces from now on (rules/srd/engine.coax RsDice.fixed), and the rooms made after it too:
//     the drift check's two rooms roll alike whatever order their rolls come in (GitHub #12887). Only
//     a local room takes it: oa-room under --dev, and the browser's local host (rm_control_local).
//     Production's answer never says it, and production's rooms never take it.
//   - flag: "flag NAME VALUE", a whole number the API holds for the rooms (verse.flags, set with no
//     deploy: POST /api/admin/flags, #13299). Every answer carries the whole list, so a flag taken away
//     at the API is gone here two seconds later. rm_flag reads one. The flags a room reads today:
//     "closed" (every shard) and "closed-sK" (shard K): while not 0 the shard's directory report says d,
//     so the directory places nobody new on it (room-directory.coax), and its seated players play on:
//     a shard taken out of rotation without a drain or a restart.
CONTROL_KICKS :: 64;
CONTROL_FLAGS :: 16;
CONTROL_FLAG_NAME :: 32;
CONTROL_EVERY_MS :: 2000;

RmControl :: struct {
  pvp: bool;
  edit: int; edit_known: bool;
  kick: [CONTROL_KICKS * TICKET_PID] u8; kick_n: [CONTROL_KICKS] int; kicks: int;
  asked: int;                    // wall ms it was last asked (rm_control_due)
  ask: [64] u8; ask_n: int;      // the ask's "t MS" and its MAC, for the host's request
  mac: [64] u8;
  hold_stamp: int;               // the last "hold" line's STAMP (0 none yet): each is laid once
  local: bool;                   // the browser's local host (room-worker.c): its own player's offline game
  dice_fixed: bool;              // "dice fixed": the rooms' dice land on half their faces (a local room's only)
  flag_name: [CONTROL_FLAGS * CONTROL_FLAG_NAME] u8; flag_name_n: [CONTROL_FLAGS] int; flag_value: [CONTROL_FLAGS] int; flags: int;   // the API's flags, the whole list of the last answer
}

// The API's flag `name` as the last control answer had it, or fallback when it named no such flag.
rm_flag :: (v: [] RmServer, name: string, fallback: int) -> int #export_c #effects(all) {
  for i: 0..<v[0].ctl.flags {
    if cast(string) v[0].ctl.flag_name[i * CONTROL_FLAG_NAME..<i * CONTROL_FLAG_NAME + v[0].ctl.flag_name_n[i]] == name { return v[0].ctl.flag_value[i]; }
  }
  return fallback;
}
// Whether the API has this shard out of rotation: "closed", or "closed-sK" for this shard.
rc_closed :: (v: [] RmServer) -> bool {
  if rm_flag(v, "closed", 0) != 0 { return true; }
  b: [16] u8; n := tk_add(b[..], 0, "closed-s"); n = rv_int(b[..], n, v[0].shard);
  return rm_flag(v, cast(string) b[0..<n], 0) != 0;
}

// The browser's local host (room-worker.c rw_start): offline play, one player's own game.
rm_control_local :: (v: [] RmServer) #export_c #effects(all) { v[0].ctl.local = true; }
// The native CLI supplies its actual bind address, after environment overrides.
rm_native_local :: (v:[]RmServer,address:string)->bool #export_c #effects(all) {
  if !native_local_enable(v[0].dev.on,address) {return false;}
  rm_control_local(v);return true;
}
// Whether a room's dice are fixed: "dice fixed" said to a local room (--dev or the local host).
rc_dice_fixed :: (v: [] RmServer) -> bool { return v[0].ctl.dice_fixed && (v[0].dev.on || v[0].ctl.local); }

rc_kicked :: (v: [] RmServer, pid: string) -> bool {
  for i: 0..<v[0].ctl.kicks {
    if cast(string) v[0].ctl.kick[i * TICKET_PID..<i * TICKET_PID + v[0].ctl.kick_n[i]] == pid { return true; }
  }
  return false;
}
// Whether it is time to ask: the ask's "t MS" in ctl.ask and its MAC in ctl.mac (none without a key).
rm_control_due :: (v: [] RmServer) -> bool #export_c #effects(all) {
  if !rm_writes(v) || v[0].wall_ms - v[0].ctl.asked < CONTROL_EVERY_MS { return false; }
  v[0].ctl.asked = v[0].wall_ms;
  n := tk_add(v[0].ctl.ask[..], 0, "t "); n = rv_int(v[0].ctl.ask[..], n, v[0].wall_ms);
  v[0].ctl.ask_n = n;
  return rm_write_mac(v, "control", cast(string) v[0].ctl.ask[0..<n], v[0].ctl.mac[..]);
}
rc_word :: (line: string, at: int) -> string {
  i := at;
  while i < line.count && line[i] != ' ' { i += 1; }
  return line[at..<i];
}
rc_num :: (t: string) -> int {
  if t.count == 0 || t.count > 15 { return -1; }
  n := 0;
  for c: t { if c < '0' || c > '9' { return -1; } n = n * 10 + cast(int) (c - '0'); }
  return n;
}
// The API's answer: applied. Kicked players' sockets are marked (rm_relay_kicked) for the host to close.
// "hold CODE SEAT STAMP" (see the top): seat SEAT of everglade room CODE held by the watch's Hold
// Person on the host's next tick.
rc_hold :: (v: [] RmServer, line: string) {
  code := rc_word(line, 5);
  at := 5 + code.count + 1;
  if at >= line.count { return; }
  sw := rc_word(line, at); seat := rc_num(sw);
  at += sw.count + 1;
  if at >= line.count { return; }
  stamp := rc_num(rc_word(line, at));
  if code.count == 0 || seat < 0 || stamp <= 0 || stamp == v[0].ctl.hold_stamp { return; }
  r := -1;
  for q: 0..<RELAYS {
    m := v[0].relays[q];
    if m.live && cast(string) m.game[0..<m.game_n] == EVERGLADE && cast(string) m.code[0..<m.code_n] == code { r = q; }
  }
  k := ifx r >= 0 then eg_room_at(v, r) else -1;
  if k < 0 || !rm_eg_seat_live(v, k, SeatId.{value = seat}) { return; }   // not yet: a later answer's line holds it
  v[0].ctl.hold_stamp = stamp;
  v[0].eg[k].seat[seat].hold_due = true;
}
// "place CODE SEAT BOAT STAMP" (see the top): seat SEAT of everglade room CODE beside rowboat BOAT on
// the host's next tick (room-world.c world_place_boat). A local room's only; lines with newer STAMPs
// than the last that room laid are each laid once.
rc_place :: (v: [] RmServer, line: string) {
  if !(v[0].dev.on || v[0].ctl.local) { return; }
  code := rc_word(line, 6);
  at := 6 + code.count + 1;
  if at >= line.count { return; }
  sw := rc_word(line, at); seat := rc_num(sw);
  at += sw.count + 1;
  if at >= line.count { return; }
  bw := rc_word(line, at); boat := rc_num(bw);
  at += bw.count + 1;
  if at >= line.count { return; }
  stamp := rc_num(rc_word(line, at));
  if code.count == 0 || seat < 0 || boat < 0 || boat >= EG_BOATS || stamp <= 0 { return; }
  k := rc_room(v, code);
  if k < 0 || stamp <= v[0].eg[k].place_stamp || !rm_eg_seat_live(v, k, SeatId.{value = seat}) { return; }   // not yet: a later answer's line lays it
  v[0].eg[k].place_stamp = stamp;
  v[0].eg[k].seat[seat].place_due = boat + 1;
}
// Everglade room CODE's slot (-1 none open).
rc_room :: (v: [] RmServer, code: string) -> int {
  for q: 0..<RELAYS {
    m := v[0].relays[q];
    if m.live && cast(string) m.game[0..<m.game_n] == EVERGLADE && cast(string) m.code[0..<m.code_n] == code { return eg_room_at(v, q); }
  }
  return -1;
}
rm_control :: (v: [] RmServer, text: string) #export_c #effects(all) {
  kicks := 0; pvp := v[0].ctl.pvp; edit := -1; flags := 0;
  at := 0;
  while at < text.count {
    e := at;
    while e < text.count && text[e] != '\n' { e += 1; }
    line := text[at..<e];
    at = e + 1;
    ev_control_line(v, line);   // world events and levels (room-events.coax)
    if line.count > 4 && line[0..<4] == "pvp " { pvp = line[4..<line.count] == "1"; }
    if line.count > 5 && line[0..<5] == "edit " { edit = rc_num(line[5..<line.count]); }
    if line.count > 5 && line[0..<5] == "hold " { rc_hold(v, line); }
    if line.count > 6 && line[0..<6] == "place " { rc_place(v, line); }
    if line.count > 5 && line[0..<5] == "flag " && flags < CONTROL_FLAGS {
      name := rc_word(line, 5);
      value := ifx 5 + name.count + 1 < line.count then rc_num(line[5 + name.count + 1..<line.count]) else -1;
      if name.count > 0 && name.count <= CONTROL_FLAG_NAME && value >= 0 {
        for i: 0..<name.count { v[0].ctl.flag_name[flags * CONTROL_FLAG_NAME + i] = name[i]; }
        v[0].ctl.flag_name_n[flags] = name.count; v[0].ctl.flag_value[flags] = value; flags += 1;
      }
    }
    if line == "dice fixed" { v[0].ctl.dice_fixed = true; }
    if line == "dice random" { v[0].ctl.dice_fixed = false; }
    if line.count > 5 && line[0..<5] == "kick " && kicks < CONTROL_KICKS {
      pid := rc_word(line, 5);
      if pid.count > 0 && pid.count <= TICKET_PID {
        for i: 0..<pid.count { v[0].ctl.kick[kicks * TICKET_PID + i] = pid[i]; }
        v[0].ctl.kick_n[kicks] = pid.count; kicks += 1;
      }
    }
  }
  v[0].ctl.kicks = kicks;
  v[0].ctl.flags = flags;
  v[0].ctl.pvp = pvp;
  for k: 0..<EG_ROOMS { v[0].eg[k].rules[0].pvp = pvp; v[0].eg[k].rules[0].b[0].dice[0].fixed = rc_dice_fixed(v); }
  // the board or world changed: every page asks for it again
  if edit >= 0 {
    if v[0].ctl.edit_known && edit != v[0].ctl.edit {
      b: [48] u8;
      n := wire_put_edit(b[..], 0, edit);
      for k: 0..<EG_ROOMS { if v[0].eg[k].live { eg_event(v, k, cast(string) b[0..<n], 0, 0, true); } }
    }
    v[0].ctl.edit = edit; v[0].ctl.edit_known = true;
  }
  // the kicked go
  for c: 0..<CONNS {
    t := v[0].conns[c].ticket;
    if v[0].conns[c].live && t.ok && rc_kicked(v, cast(string) t.pid[0..<t.pid_n]) { v[0].conns[c].kicked = true; }
  }
}
