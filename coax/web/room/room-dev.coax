// The API's stand-in for local development (room-host.c --dev, coax/web/room/local.coax; #12774).
// A local room then behaves as production's: seat tickets signed with a key and checked, players
// named, the control's levels, cap, PvP and event dials read from dev/room-control.txt every two
// seconds as the API's answer is, and HP, XP and WANTED brought back between visits from the room's own
// vitals (room-vitals.coax), as the API keeps them. The page asks its usual /api/ paths, which
// serve.sh --api sends here:
//   POST /api/playtest/player                 a new player: {"key":KEY,"id":PID} (player.c)
//   POST /api/playtest/room-ticket/ROOM       a seat ticket for ROOM, for the X-Verse-Player key; with
//                                          ?checkpoint=2 a v4 ticket carrying the character's checkpoint (#13057)
//   POST /api/playtest/player/name            {name}: the key's own name, the API's shape (player-name.coax; the
//                                          blocked words are the API's alone), {"name": ""} the made one
//   POST /api/playtest/room-state             what you bring back (look, class): taken, not kept; WANTED is the room's
//   GET  /api/playtest/rooms/SLUG             the instances (rm_rooms, room-relay.coax)
//   GET  /api/playtest/world/everglade     the world document (room-host.c)
//   POST /api/playtest/world/everglade     publish {doc, summary}: the world document written, the next
//                                          version, every room and page told (room-host.c dev_publish)
//   POST /api/playtest/world/everglade/reset  the designed city back: {doc: null, version: 0}
//   GET  /api/playtest/realms/everglade    the realm's edit spec (verse.edit_spec): its role, tools,
//                                          things and the board's rows (migrations 0050_realm_edit.sql)
//   POST /api/playtest/realms/everglade/switch    {row, on}: a board row on or off, an admin's
//   POST /api/playtest/realms/everglade/settings  {tools}: the tools visitors get, an admin's
//   GET  /api/playtest/realms/everglade/proposals, /asks, /panes   none waiting (empty)
//   GET  /api/auth/viewer                  "A|1": the local player is the realm's admin, so EDIT and
//                                          Aethyr Forge work as production's do for an admin (on by default
//                                          in --dev, OA_ROOM_DEV_ADMIN=0 a visitor; there is no --dev in
//                                          production, so never there)
// Anything else under /api/ answers 404 {"error":"not in the local API"}.
//   coax test --library coax/web/room/room.coax --steps 4000000000 --only "dev:"

DEV_KEY :: "local-development-room-ticket-key-not-a-secret";   // the stand-in's ticket key (>= 32 bytes)
// Whether a room code names an instance: it ends in -N ("everglade2-1"), not a realm ("everglade2").
dv_numbered :: (room: string) -> bool {
  k := room.count;
  while k > 0 && room[k - 1] >= '0' && room[k - 1] <= '9' { k -= 1; }
  return k < room.count && k > 1 && room[k - 1] == '-';
}
DEV_OUT :: 6144;   // a v4 ticket's answer (RT_TEXT) fits
// Everglade's realm as migrations/0050_realm_edit.sql seeds it: the tools its code honours, the things a
// visitor may propose, and the board's rows (KEY, LABEL).
DEV_TOOLS :: [2] string.["map", "build"];
DEV_THINGS :: [5] string.["crate", "barrel", "bench", "fence", "stall"];
DEV_ROWS :: [4] string.["flock", "floats", "undergrowth", "daycycle"];
DEV_ROW_LABELS :: [4] string.["The flock that follows you", "Ducks and lily pads", "Bushes, ferns and rocks", "Day turning to night"];
DEV_NAMES_A :: [8] string.["Mossy", "Quiet", "Amber", "Swift", "Cedar", "Misty", "Bright", "Rowan"];
DEV_NAMES_B :: [8] string.["Heron", "Otter", "Wren", "Badger", "Lynx", "Finch", "Hare", "Newt"];

DEV_NAMED :: 8;              // players with a name of their own (a local room's few pages), in memory for the room's life
RmDev :: struct {
  on: bool;
  named_pid: [DEV_NAMED][TICKET_PID] u8; named_pid_n: [DEV_NAMED] int; named: [DEV_NAMED][24] u8; named_n: [DEV_NAMED] int; named_count: int;
  admin: bool;               // the viewer is the realm's admin (rm_dev_start: on unless OA_ROOM_DEV_ADMIN=0)
  minted: int;               // players made (each key's number)
  row_off: [4] bool;         // the board's rows switched off (DEV_ROWS), in memory for the room's life
  tool_off: [2] bool;        // the tools visitors don't get (DEV_TOOLS)
  out: [DEV_OUT] u8;         // the answer: "STATUS\n" then the JSON body
  ck: [DEV_CK] DevCheckpoint; ck_n: int; ck_dirty: bool;   // the checkpoint store (#13057)
  store: [DEV_STORE] u8;     // the store as the host keeps it on disk (rm_dev_store)
}

// The stand-in's character checkpoint store (character-checkpoint-v2, #13057), as the API's
// verse.character_checkpoints_v2 and verse.room_owners keep it: each player's owner generation (one
// more each v4 ticket) and the last accepted capture. The room posts its captures here in-process
// (room-host.c checkpoint_post under --dev, rm_dev_checkpoint), ordered by the API's own rule
// (coax/web/api/checkpoint-policy.coax room_checkpoint_decide), and the host keeps the store in a file
// (OA_ROOM_DEV_STORE, else ~/.openagents/room-dev/checkpoints-PORT.txt), so a local room killed and
// started again brings its players back where they were, as production's does.
DEV_CK :: 16;   // a local room's few players
DEV_STORE :: DEV_CK * (CC_BODY + 128);
// touched: its newest owner issued or capture accepted (wall ms); the store full, the least recently touched goes
DevCheckpoint :: struct { pid: [TICKET_PID] u8; pid_n: int; owner: int; saved: bool; c: CharacterCapture; rest: CharacterRest; accepted: int; touched: int; }

// --dev: the stand-in's key signs and checks every seat ticket, and a join needs one, as in production.
rm_dev_start :: (v: [] RmServer) #export_c #effects(all) {
  v[0].dev.on = true; v[0].dev.admin = true;
  rm_ticket_key(v, DEV_KEY, true);
}
// OA_ROOM_DEV_ADMIN=0 (room-host.c): the local player is a visitor, to try what a visitor sees.
rm_dev_admin :: (v: [] RmServer, on: bool) #export_c #effects(all) { v[0].dev.admin = on; }

dv_put :: (o: [] u8, n: int, s: string) -> int { return tk_add(o, n, s); }
dv_hex :: (o: [] u8, n: int, mac: [] u8, digits: int) -> int {
  if n + digits > o.count { return o.count + 1; }
  for i: 0..<digits { o[n + i] = mac[i]; }
  return n + digits;
}
// The request's header value ("" none), its name in lower case.
dv_header :: (req: string, name: string) -> string {
  i := 0;
  while i < req.count {
    e := i;
    while e < req.count && req[e] != '\n' { e += 1; }
    line := req[i..<e];
    if line.count > name.count + 1 && line[name.count] == ':' {
      same := true;
      for j: 0..<name.count {
        c := line[j];
        if c >= 'A' && c <= 'Z' { c += 32; }
        if c != name[j] { same = false; break; }
      }
      if same {
        a := name.count + 1;
        while a < line.count && line[a] == ' ' { a += 1; }
        z := line.count;
        while z > a && (line[z - 1] == '\r' || line[z - 1] == ' ') { z -= 1; }
        return line[a..<z];
      }
    }
    i = e + 1;
  }
  return "";
}
// A player's id for its key: p- and 16 hex of the key's MAC, the same key the same id.
dv_pid :: (key: string, out: [] u8) -> int {
  mac: [64] u8;
  if !tk_mac(DEV_KEY, key, mac[..]) { return 0; }
  n := dv_put(out, 0, "p-");
  return dv_hex(out, n, mac[..], 16);
}
// Its name: its own (POST /api/playtest/player/name), else two words from the id.
dv_name_of :: (v: [] RmServer, pid: string, out: [] u8) -> int {
  i := dv_named_at(v, pid);
  if i >= 0 { return dv_put(out, 0, cast(string) v[0].dev.named[i][0..<v[0].dev.named_n[i]]); }
  return dv_name(pid, out);
}
dv_named_at :: (v: [] RmServer, pid: string) -> int {
  for i: 0..<v[0].dev.named_count { if cast(string) v[0].dev.named_pid[i][0..<v[0].dev.named_pid_n[i]] == pid { return i; } }
  return -1;
}
dv_name :: (pid: string, out: [] u8) -> int {
  h := 0;
  for c: pid { h = (h * 31 + cast(int) c) % 1000003; }
  n := dv_put(out, 0, DEV_NAMES_A[h % 8]); n = dv_put(out, n, " "); n = dv_put(out, n, DEV_NAMES_B[(h / 8) % 8]);
  return n;
}
dv_answer :: (v: [] RmServer, status: string, body: string) -> int {
  n := dv_put(v[0].dev.out[..], 0, status); n = dv_put(v[0].dev.out[..], n, "\n"); n = dv_put(v[0].dev.out[..], n, body);
  return ifx n > DEV_OUT then 0 else n;
}
dv_path :: (req: string, method: string, path: string) -> bool {
  return req.count > method.count + 1 + path.count && req[0..<method.count] == method && req[method.count] == ' ' &&
         req[method.count + 1..<method.count + 1 + path.count] == path;
}

// The answer to an /api/ request (dev.out: "STATUS\nBODY"), its count; -1 when it isn't the stand-in's
// to answer (the host answers the world and the rooms list itself).
rm_dev_api :: (v: [] RmServer, req: string) -> int #export_c #effects(all) {
  if !v[0].dev.on { return -1; }
  if dv_path(req, "POST", "/api/playtest/player ") || dv_path(req, "POST", "/api/playtest/player?") {
    v[0].dev.minted += 1;
    kb: [64] u8;
    k := dv_put(kb[..], 0, "dev-"); k = rv_int(kb[..], k, v[0].wall_ms); k = dv_put(kb[..], k, "-"); k = rv_int(kb[..], k, v[0].dev.minted);
    key := cast(string) kb[0..<k];
    pb: [TICKET_PID] u8; pn := dv_pid(key, pb[..]);
    b: [256] u8;
    n := dv_put(b[..], 0, "{\"key\":\""); n = dv_put(b[..], n, key); n = dv_put(b[..], n, "\",\"id\":\""); n = dv_put(b[..], n, cast(string) pb[0..<pn]);
    n = dv_put(b[..], n, "\",\"account\":false}");
    return dv_answer(v, "200", cast(string) b[0..<n]);
  }
  if dv_path(req, "POST", "/api/playtest/room-ticket/") {
    at := 5 + "/api/playtest/room-ticket/".count;
    e := at;
    while e < req.count && req[e] != ' ' && req[e] != '?' { e += 1; }
    room := req[at..<e];
    if room.count == 0 || room.count > 24 { return dv_answer(v, "404", "{\"error\":\"unknown\"}"); }
    for c: room { if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') { return dv_answer(v, "404", "{\"error\":\"unknown\"}"); } }
    // a ticket for the realm itself (?realm=, everglade-party.coax): the API's directory places it in a
    // room; the stand-in has one, the realm's first (its rooms list's "join"), so the ticket is for that
    // room, whose socket the page opens (a ticket for "everglade2" was refused at "everglade2-1")
    rb: [32] u8;
    if !dv_numbered(room) {
      rn := dv_put(rb[..], 0, room); rn = dv_put(rb[..], rn, "-1");
      room = cast(string) rb[0..<rn];
    }
    key := dv_header(req, "x-verse-player");
    if key.count == 0 { return dv_answer(v, "401", "{\"error\":\"a player key\"}"); }
    pb: [TICKET_PID] u8; pn := dv_pid(key, pb[..]);
    pid := cast(string) pb[0..<pn];
    nb: [32] u8; nn := dv_name_of(v, pid, nb[..]);
    name := cast(string) nb[0..<nn];
    // HP for 10 minutes and the XP, from the room's own vitals (the API's verse.room_vitals)
    hp := -1; xp := 0; wanted := 0;
    i := rv_find(v, pid);
    if i >= 0 {
      e2 := v[0].vit.v[i];
      xp = e2.xp;
      if e2.hp < e2.max && v[0].wall_ms - e2.at < 600000 { hp = e2.hp; }
      if v[0].wall_ms - e2.at < VITALS_WANTED_MS { wanted = e2.wanted; }   // and WANTED for 5 (#12794)
    }
    expires := v[0].wall_ms + TICKET_LIFE_MS;
    tb: [TICKET_TEXT] u8;
    // ?checkpoint=2 for Everglade II's rooms: the next owner generation, and the last accepted capture
    // wrapped in (a v4 ticket). Everglade's local rooms keep the v2 ticket, so its drift checks are as they were.
    // &rest=1 (#13046) takes a profile 3 capture as it is; without it, its profile 2 part
    three := dv_has(tk_query_line(req), "rest=1");
    resume := dv_has(tk_query_line(req), "checkpoint=2") && eg_e2_code(room);
    ci := ifx resume then dv_ck_owner_next(v, pid) else -1;
    if resume && ci < 0 { return dv_answer(v, "503", "{\"error\":\"character recovery unavailable\"}"); }
    owner := ifx ci >= 0 then v[0].dev.ck[ci].owner else 0;
    if ci >= 0 && v[0].dev.ck[ci].saved { xp = rs_max(xp, v[0].dev.ck[ci].c.n[11]); }
    tn := tk_sign_owner(DEV_KEY, pid, false, name, room, 0, expires, hp, ifx xp > 0 then xp else -1, wanted, owner, tb[..]);
    if tn == 0 { return dv_answer(v, "500", "{\"error\":\"no ticket\"}"); }
    rb4: [RT_TEXT] u8; saved: [CC_BODY] u8; ticket := cast(string) tb[0..<tn];
    if ci >= 0 { ticket = resume_ticket_wrap(DEV_KEY, ticket, ifx v[0].dev.ck[ci].saved then cc_stored_as(v[0].dev.ck[ci].c, v[0].dev.ck[ci].rest, ifx three then 3 else 2, saved[..]) else "-", rb4[..]); }
    if ticket.count == 0 { return dv_answer(v, "500", "{\"error\":\"no ticket\"}"); }
    b: [RT_TEXT + 512] u8;
    n := dv_put(b[..], 0, "{\"ticket\":\""); n = dv_put(b[..], n, ticket);
    n = dv_put(b[..], n, "\",\"id\":\""); n = dv_put(b[..], n, pid);
    n = dv_put(b[..], n, "\",\"account\":false,\"name\":\""); n = dv_put(b[..], n, name);
    n = dv_put(b[..], n, "\",\"room\":\""); n = dv_put(b[..], n, room);
    n = dv_put(b[..], n, "\",\"expires\":"); n = rv_int(b[..], n, expires); n = dv_put(b[..], n, "}");
    return dv_answer(v, "200", cast(string) b[0..<n]);
  }
  if dv_path(req, "POST", "/api/playtest/player/name") { return dv_set_name(v, req); }
  if dv_path(req, "POST", "/api/playtest/room-state") { return dv_answer(v, "200", "{\"ok\":true}"); }
  // who is viewing: the realm's admin, or nobody logged in (a 200 with nothing, as the API's)
  if dv_path(req, "GET", "/api/auth/viewer") { return dv_answer(v, "200", ifx v[0].dev.admin then "A|1\n" else ""); }
  if dv_path(req, "POST", "/api/playtest/world/everglade") && !v[0].dev.admin { return dv_answer(v, "403", "{\"error\":\"an admin's\"}"); }
  if dv_path(req, "POST", "/api/playtest/world/everglade") { return -1; }   // the host writes the world document (room-host.c dev_publish)
  if dv_path(req, "GET", "/api/playtest/rooms/") || dv_path(req, "GET", "/api/playtest/world/") { return -1; }
  if dv_path(req, "GET", "/api/playtest/realms/everglade") || dv_path(req, "POST", "/api/playtest/realms/everglade") { return dv_realm(v, req); }
  if dv_path(req, "GET", "/api/") || dv_path(req, "POST", "/api/") { return dv_answer(v, "404", "{\"error\":\"not in the local API\"}"); }
  return -1;
}

// POST /api/playtest/player/name {name}: as verse.player_set_name (migrations/0116): the key's player,
// the name trimmed, "" back to the made one, a shape the filter refuses 400, else {name, account}.
dv_set_name :: (v: [] RmServer, req: string) -> int {
  key := dv_header(req, "x-verse-player");
  if key.count == 0 { return dv_answer(v, "403", "{\"error\":\"unknown player key\"}"); }
  pb: [TICKET_PID] u8; pn := dv_pid(key, pb[..]); pid := cast(string) pb[0..<pn];
  body := req; for i: 0..<req.count - 3 { if req[i] == '\r' && req[i + 1] == '\n' && req[i + 2] == '\r' && req[i + 3] == '\n' { body = req[i + 4..<req.count]; break; } }
  if net_field_dev(body, "name").count == 0 && !dv_has(body, "\"name\"") { return dv_answer(v, "400", "{\"error\":\"not json\"}"); }
  want := net_field_dev(body, "name");
  a := 0; z := want.count; while a < z && want[a] == ' ' { a += 1; } while z > a && want[z - 1] == ' ' { z -= 1; } want = want[a..<z];
  i := dv_named_at(v, pid);
  if want.count == 0 {
    if i >= 0 { last := v[0].dev.named_count - 1; v[0].dev.named_pid[i] = v[0].dev.named_pid[last]; v[0].dev.named_pid_n[i] = v[0].dev.named_pid_n[last]; v[0].dev.named[i] = v[0].dev.named[last]; v[0].dev.named_n[i] = v[0].dev.named_n[last]; v[0].dev.named_count = last; }
  } else {
    if pn_why(want) != PN_OK { return dv_answer(v, "400", "{\"error\":\"pick another name: 3 to 20 letters, digits, spaces, hyphens\"}"); }
    if i < 0 {
      // full: the oldest name goes (a local room's pages come and go)
      if v[0].dev.named_count >= DEV_NAMED {
        for q: 1..<DEV_NAMED { v[0].dev.named_pid[q - 1] = v[0].dev.named_pid[q]; v[0].dev.named_pid_n[q - 1] = v[0].dev.named_pid_n[q]; v[0].dev.named[q - 1] = v[0].dev.named[q]; v[0].dev.named_n[q - 1] = v[0].dev.named_n[q]; }
        v[0].dev.named_count -= 1;
      }
      i = v[0].dev.named_count; v[0].dev.named_count += 1;
    }
    v[0].dev.named_pid_n[i] = dv_put(v[0].dev.named_pid[i][..], 0, pid);
    v[0].dev.named_n[i] = dv_put(v[0].dev.named[i][..], 0, want);
  }
  nb: [32] u8; nn := dv_name_of(v, pid, nb[..]);
  b: [96] u8;
  n := dv_put(b[..], 0, "{\"name\":\""); n = dv_put(b[..], n, cast(string) nb[0..<nn]); n = dv_put(b[..], n, "\",\"account\":false}");
  return dv_answer(v, "200", cast(string) b[0..<n]);
}
dv_has :: (t: string, part: string) -> bool { if part.count > t.count { return false; } for i: 0..<t.count - part.count + 1 { if t[i..<i + part.count] == part { return true; } } return false; }
// The request line's query ("" none).
tk_query_line :: (req: string) -> string {
  e := 0; while e < req.count && req[e] != '\r' && req[e] != '\n' { e += 1; }
  line := req[0..<e]; q := 0; while q < line.count && line[q] != '?' { q += 1; }
  return ifx q < line.count then line[q..<line.count] else "";
}

// ---- the checkpoint store (#13057)
dv_ck_find :: (v: [] RmServer, pid: string) -> int {
  for i: 0..<v[0].dev.ck_n { if cast(string) v[0].dev.ck[i].pid[0..<v[0].dev.ck[i].pid_n] == pid { return i; } }
  return -1;
}
// Player pid's entry, made when new, last touched at `at`; -1 none. The store full, the entry touched
// longest ago goes, unless the new one is older still: a file's stale players never push out one this
// room just issued an owner to and has not saved yet (#13185: its captures were "unknown" from then on).
dv_ck_entry :: (v: [] RmServer, pid: string, at: int) -> int {
  if pid.count == 0 || pid.count > TICKET_PID { return -1; }
  i := dv_ck_find(v, pid);
  if i >= 0 { return i; }
  if v[0].dev.ck_n < DEV_CK { i = v[0].dev.ck_n; v[0].dev.ck_n += 1; }
  else {
    i = 0; for j: 1..<DEV_CK { if v[0].dev.ck[j].touched < v[0].dev.ck[i].touched { i = j; } }
    if v[0].dev.ck[i].touched > at { return -1; }
  }
  v[0].dev.ck[i] = DevCheckpoint.{pid_n = pid.count, touched = at};
  for q: 0..<pid.count { v[0].dev.ck[i].pid[q] = pid[q]; }
  return i;
}
// A v4 ticket's owner generation: one more than the last (verse.room_owner_next).
dv_ck_owner_next :: (v: [] RmServer, pid: string) -> int {
  i := dv_ck_entry(v, pid, v[0].wall_ms);
  if i < 0 || v[0].dev.ck[i].owner >= 2147483646 { return -1; }
  v[0].dev.ck[i].owner += 1; v[0].dev.ck[i].touched = rs_max(v[0].dev.ck[i].touched, v[0].wall_ms); v[0].dev.ck_dirty = true;
  return i;
}
// The room's due checkpoint post (rm_checkpoint_due), answered here as the API answers
// POST /api/playtest/room-checkpoint-v2 (player.c room_checkpoint): false when none was due.
rm_dev_checkpoint :: (v: [] RmServer) -> bool #export_c #effects(all) {
  if !v[0].dev.on { return false; }
  n := rm_checkpoint_due(v);
  if n <= 0 { return false; }
  request := v[0].ck.request;
  body := cast(string) v[0].ck.out[0..<n];
  c := cc_read(body, true); rest := cc_rest(body, true);
  if !c.ok || !checkpoint2_input(body, v[0].wall_ms) { rm_checkpoint_answer(v, request, 400, "{\"error\":\"bad checkpoint\"}"); return true; }
  i := dv_ck_find(v, cast(string) c.pid[0..<c.pid_n]);
  known := i >= 0 && v[0].dev.ck[i].owner > 0;
  e := ifx i >= 0 then v[0].dev.ck[i] else DevCheckpoint.{};
  a: [CC_BODY] u8; b: [CC_BODY] u8;
  same := e.saved && cc_stored_rest(c, rest, a[..]) == cc_stored_rest(e.c, e.rest, b[..]);
  code := room_checkpoint_decide(true, known, OwnerGeneration.{value = c.n[1]}, OwnerGeneration.{value = e.owner}, c.n[2], c.n[3], c.n[11],
                                 OwnerGeneration.{value = ifx e.saved then e.c.n[1] else 0}, ifx e.saved then e.c.n[2] else 0, ifx e.saved then e.c.n[3] else 0, ifx e.saved then e.c.n[11] else 0, same);
  if code == 0 { c.n[5] = c.n[4]; v[0].dev.ck[i].c = c; v[0].dev.ck[i].rest = rest; v[0].dev.ck[i].saved = true; v[0].dev.ck[i].accepted = v[0].wall_ms; v[0].dev.ck[i].touched = rs_max(v[0].dev.ck[i].touched, v[0].wall_ms); v[0].dev.ck_dirty = true; }
  r := ifx i >= 0 then v[0].dev.ck[i] else DevCheckpoint.{};
  o: [1] Jo; out: [256] u8; jo_start(o[..], out[..]); jo_obj(o[..]);
  jo_key(o[..], "v"); jo_int(o[..], 2); jo_key(o[..], "status"); jo_str(o[..], room_checkpoint_status(code));
  jo_key(o[..], "owner"); jo_int(o[..], ifx r.saved then r.c.n[1] else r.owner); jo_key(o[..], "process"); jo_int(o[..], ifx r.saved then r.c.n[2] else 0);
  jo_key(o[..], "rev"); jo_int(o[..], ifx r.saved then r.c.n[3] else 0); jo_key(o[..], "accepted_at"); jo_int(o[..], r.accepted); jo_end(o[..]);
  rm_checkpoint_answer(v, request, 200, jo_text(o[..]));
  return true;
}
// The store as text for the host's file, one line a player: "c PID OWNER ACCEPTED CAPTURE" (CAPTURE "-"
// none, else its stored JSON; ACCEPTED for one with none: when its owner was issued); its count in
// dev.store, and the store marked kept.
rm_dev_store :: (v: [] RmServer) -> int #export_c #effects(all) {
  n := 0;
  for i: 0..<v[0].dev.ck_n {
    e := v[0].dev.ck[i]; cb: [CC_BODY] u8;
    n = dv_put(v[0].dev.store[..], n, "c "); n = dv_put(v[0].dev.store[..], n, cast(string) e.pid[0..<e.pid_n]);
    n = rv_int(v[0].dev.store[..], dv_put(v[0].dev.store[..], n, " "), e.owner); n = rv_int(v[0].dev.store[..], dv_put(v[0].dev.store[..], n, " "), ifx e.saved then e.accepted else e.touched);
    n = dv_put(v[0].dev.store[..], n, " "); n = dv_put(v[0].dev.store[..], n, ifx e.saved then cc_stored_rest(e.c, e.rest, cb[..]) else "-"); n = dv_put(v[0].dev.store[..], n, "\n");
  }
  if n > DEV_STORE { return 0; }
  v[0].dev.ck_dirty = false;
  return n;
}
rm_dev_dirty :: (v: [] RmServer) -> bool #export_c #effects(all) { return v[0].dev.on && v[0].dev.ck_dirty; }
// The host's file read (at the start, and before each write and ticket, since another local room may
// share it: two shards over one store, as production's API is), merged into the store: the entries it holds.
rm_dev_restore :: (v: [] RmServer, text: string) -> int #export_c #effects(all) {
  at := 0;
  while at < text.count {
    e := at; while e < text.count && text[e] != '\n' { e += 1; }
    line := text[at..<e]; at = e + 1;
    if line.count < 4 || line[0..<2] != "c " { continue; }
    f: [4] string; k := 0; p := 2;   // PID OWNER ACCEPTED, then the capture (the rest of the line)
    while k < 3 && p <= line.count { q := p; while q < line.count && line[q] != ' ' { q += 1; } f[k] = line[p..<q]; k += 1; p = q + 1; }
    if k < 3 || p > line.count { continue; }
    f[3] = line[p..<line.count];
    seen := dv_whole(f[2]);
    i := dv_ck_entry(v, f[0], seen);
    if i < 0 { continue; }   // the store full of players touched since
    v[0].dev.ck[i].touched = rs_max(v[0].dev.ck[i].touched, seen);
    // merged as the API's one table is shared by every shard: the newest owner, the newest accepted capture
    v[0].dev.ck[i].owner = rs_max(v[0].dev.ck[i].owner, dv_whole(f[1]));
    if f[3] != "-" {
      c := cc_read(f[3], false); rest := cc_rest(f[3], false); was := v[0].dev.ck[i];
      if c.ok && (!was.saved || c.n[1] > was.c.n[1] || (c.n[1] == was.c.n[1] && (c.n[2] != was.c.n[2] || c.n[3] > was.c.n[3]))) { v[0].dev.ck[i].c = c; v[0].dev.ck[i].rest = rest; v[0].dev.ck[i].saved = true; v[0].dev.ck[i].accepted = dv_whole(f[2]); }
    }
  }
  v[0].dev.ck_dirty = false;
  return v[0].dev.ck_n;
}
dv_whole :: (t: string) -> int { n := 0; for c: t { if c < '0' || c > '9' || n > 100000000000000 { return 0; } n = n * 10 + cast(int) (c - '0'); } return n; }
#test "dev: a v4 ticket brings back the last accepted checkpoint, which the store keeps across a restart" #steps 4000000000 {
  v: [1] RmServer;
  rm_init(v[..]); rm_clock(v[..], 100, 1800000000000); rm_dev_start(v[..]); rm_vitals_gen(v[..], 77);
  key := "dev-key-for-the-checkpoint-check-1";
  pb: [TICKET_PID] u8; pn := dv_pid(key, pb[..]); pid := cast(string) pb[0..<pn];
  rb: [256] u8;
  m := dv_put(rb[..], 0, "POST /api/playtest/room-ticket/pair-e2-ck-1?checkpoint=2 HTTP/1.1\r\nX-Verse-Player: "); m = dv_put(rb[..], m, key); m = dv_put(rb[..], m, "\r\n\r\n{}");
  a := cast(string) v[0].dev.out[0..<rm_dev_api(v[..], cast(string) rb[0..<m])];
  #assert a[0..<4] == "200\n";
  tk := tk_check(DEV_KEY, net_field_dev(a, "ticket"), "pair-e2-ck-1", v[0].wall_ms);
  #assert tk.ok && tk.schema == 2 && tk.owner == 1 && !tk.capture.ok && rm_dev_dirty(v[..]);
  // a seat of Everglade II's room with it: its capture goes to the store, whose receipt lets it play
  jb: [RT_TEXT + 128] u8; jn := dv_put(jb[..], 0, "GET /api/room/relay/everglade/pair-e2-ck-1?t="); jn = dv_put(jb[..], jn, net_field_dev(a, "ticket")); jn = dv_put(jb[..], jn, " HTTP/1.1\r\n\r\n");
  #assert rm_join(v[..], 0, cast(string) jb[0..<jn]) >= 0;
  k := eg_room_at(v[..], v[0].conns[0].relay); #assert k >= 0;
  rm_heard(v[..], 0, "A 12345 0 -9876 150"); rm_heard(v[..], 0, "H 5 ranger.0.0.0 druid 0 Ash");
  rm_eg_moved(v[..], k, SeatId.{value = 0}, 0, 123.45, 0, -98.76, 1.5, 0, 0, 0, 0, 0, 0);
  #assert !ck_can_play(v[..], k, SeatId.{value = 0}) && rm_dev_checkpoint(v[..]) && ck_can_play(v[..], k, SeatId.{value = 0});
  i := dv_ck_find(v[..], pid); #assert i >= 0 && v[0].dev.ck[i].saved && v[0].dev.ck[i].c.n[13] == 123450 && v[0].dev.ck[i].c.n[15] == -98760;
  // kept on disk and read back by a new process: its next ticket carries the place
  n := rm_dev_store(v[..]); #assert n > 0 && !rm_dev_dirty(v[..]);
  kept: [4096] u8; for q: 0..<n { kept[q] = v[0].dev.store[q]; }
  for q: 0..<DEV_CK { v[0].dev.ck[q] = DevCheckpoint.{}; } v[0].dev.ck_n = 0;   // the process gone with what it held
  #assert rm_dev_restore(v[..], cast(string) kept[0..<n]) == 1;
  b := cast(string) v[0].dev.out[0..<rm_dev_api(v[..], cast(string) rb[0..<m])];
  t2 := tk_check(DEV_KEY, net_field_dev(b, "ticket"), "pair-e2-ck-1", v[0].wall_ms);
  #assert t2.ok && t2.schema == 2 && t2.owner == 2 && t2.capture.ok && t2.capture.n[13] == 123450 && t2.capture.n[15] == -98760;
  // without checkpoint=2: the old ticket, no capture
  m2 := dv_put(rb[..], 0, "POST /api/playtest/room-ticket/pair-e2-ck-1 HTTP/1.1\r\nX-Verse-Player: "); m2 = dv_put(rb[..], m2, key); m2 = dv_put(rb[..], m2, "\r\n\r\n{}");
  t3 := tk_check(DEV_KEY, net_field_dev(cast(string) v[0].dev.out[0..<rm_dev_api(v[..], cast(string) rb[0..<m2])], "ticket"), "pair-e2-ck-1", v[0].wall_ms);
  #assert t3.ok && t3.schema != 2;
}
#test "dev: a room restarted over a full store seats new players, and its stale players never push out their entries (#13185)" #steps 4000000000 {
  // the file a run left: DEV_CK players with accepted captures, none of them the new run's
  file: [DEV_STORE] u8; kept := 0;
  for q: 0..<DEV_CK {
    pb: [TICKET_PID] u8; pn := dv_put(pb[..], 0, "p-old-"); pn = rv_int(pb[..], pn, q);
    c := cc_fixture(); c.pid_n = pn; for x: 0..<pn { c.pid[x] = pb[x]; } c.n[1] = 1; cb: [CC_BODY] u8;
    kept = dv_put(file[..], kept, "c "); kept = dv_put(file[..], kept, cast(string) pb[0..<pn]); kept = dv_put(file[..], kept, " 1 ");
    kept = rv_int(file[..], kept, 1800000000000 - 1000 * (q + 1)); kept = dv_put(file[..], kept, " "); kept = dv_put(file[..], kept, cc_stored(c, cb[..])); kept = dv_put(file[..], kept, "\n");
  }
  // the restarted room reads it, then two new players each take a ticket, as room-host.c's dev path does:
  // the file read, the answer, then the file read again and written (dev_store_save)
  v: [1] RmServer; rm_init(v[..]); rm_clock(v[..], 100, 1800000600000); rm_dev_start(v[..]); rm_vitals_gen(v[..], 78);
  #assert rm_dev_restore(v[..], cast(string) file[0..<kept]) == DEV_CK;
  keys := [2] string.["dev-key-for-the-full-store-check-a", "dev-key-for-the-full-store-check-b"];
  for p: 0..<2 {
    rb: [256] u8;
    m := dv_put(rb[..], 0, "POST /api/playtest/room-ticket/pair-e2-full-1?checkpoint=2 HTTP/1.1\r\nX-Verse-Player: "); m = dv_put(rb[..], m, keys[p]); m = dv_put(rb[..], m, "\r\n\r\n{}");
    r1 := rm_dev_restore(v[..], cast(string) file[0..<kept]);
    a := cast(string) v[0].dev.out[0..<rm_dev_api(v[..], cast(string) rb[0..<m])];
    #assert a[0..<4] == "200\n";
    t: [RT_TEXT] u8; tn := 0; for ch: net_field_dev(a, "ticket") { t[tn] = ch; tn += 1; }
    r2 := rm_dev_restore(v[..], cast(string) file[0..<kept]); kept = rm_dev_store(v[..]); for q: 0..<kept { file[q] = v[0].dev.store[q]; }
    jb: [RT_TEXT + 128] u8; jn := dv_put(jb[..], 0, "GET /api/room/relay/everglade/pair-e2-full-1?t="); jn = dv_put(jb[..], jn, cast(string) t[0..<tn]); jn = dv_put(jb[..], jn, " HTTP/1.1\r\n\r\n");
    #assert rm_join(v[..], p, cast(string) jb[0..<jn]) >= 0;
    rm_heard(v[..], p, "A 12345 0 -9876 150"); rm_heard(v[..], p, "H 5 ranger.0.0.0 druid 0 Ash");
  }
  k := eg_room_at(v[..], v[0].conns[0].relay); #assert k >= 0 && eg_room_at(v[..], v[0].conns[1].relay) == k;
  for p: 0..<2 { rm_eg_moved(v[..], k, SeatId.{value = v[0].conns[p].seat}, 0, 1 + f32(p), 0, 2, 0, 0, 0, 0, 0, 0, 0); }
  // both seated and held, the room ticking; their first captures are accepted (they were "unknown")
  #assert !rm_checkpoint_paused(v[..], k);
  for q: 0..<4 { posted := rm_dev_checkpoint(v[..]); }
  #assert v[0].ck.applied == 2 && rm_checkpoint_pending(v[..]) == 0 && !rm_checkpoint_paused(v[..], k);
  for p: 0..<2 { #assert ck_can_play(v[..], k, SeatId.{value = v[0].conns[p].seat}); }
  // and the store kept both of them, DEV_CK players in all
  pa: [TICKET_PID] u8; na := dv_pid(keys[0], pa[..]); pb: [TICKET_PID] u8; nb := dv_pid(keys[1], pb[..]);
  r3 := rm_dev_restore(v[..], cast(string) file[0..<kept]);
  #assert v[0].dev.ck_n == DEV_CK && dv_ck_find(v[..], cast(string) pa[0..<na]) >= 0 && dv_ck_find(v[..], cast(string) pb[0..<nb]) >= 0;
}
#test "dev: a guest names itself, its next ticket carries the name, and a name of the wrong shape is refused" {
  v: [1] RmServer;
  rm_init(v[..]); rm_clock(v[..], 100, 1800000000000); rm_dev_start(v[..]);
  key := "dev-key-for-the-name-check-0001";
  rb: [256] u8;
  m := dv_put(rb[..], 0, "POST /api/playtest/player/name HTTP/1.1\r\nX-Verse-Player: "); m = dv_put(rb[..], m, key);
  bad := dv_put(rb[..], m, "\r\n\r\n{\"name\":\"http x\"}");
  #assert cast(string) v[0].dev.out[0..<rm_dev_api(v[..], cast(string) rb[0..<bad])][0..<4] == "400\n";
  ok := dv_put(rb[..], m, "\r\n\r\n{\"name\":\" Crowd Alpha \"}");
  a := cast(string) v[0].dev.out[0..<rm_dev_api(v[..], cast(string) rb[0..<ok])];
  #assert a[0..<4] == "200\n" && net_field_dev(a, "name") == "Crowd Alpha";
  tb: [256] u8;
  t := dv_put(tb[..], 0, "POST /api/playtest/room-ticket/pair-e2-n-1 HTTP/1.1\r\nX-Verse-Player: "); t = dv_put(tb[..], t, key); t = dv_put(tb[..], t, "\r\n\r\n{}");
  ans := cast(string) v[0].dev.out[0..<rm_dev_api(v[..], cast(string) tb[0..<t])];
  #assert ans[0..<4] == "200\n" && net_field_dev(ans, "name") == "Crowd Alpha";
  tk := tk_check(DEV_KEY, net_field_dev(ans, "ticket"), "pair-e2-n-1", v[0].wall_ms);
  #assert tk.ok && cast(string) tk.name[0..<tk.name_n] == "Crowd Alpha";
  // "" goes back to the made name
  clear := dv_put(rb[..], m, "\r\n\r\n{\"name\":\"\"}");
  c := cast(string) v[0].dev.out[0..<rm_dev_api(v[..], cast(string) rb[0..<clear])];
  #assert c[0..<4] == "200\n" && net_field_dev(c, "name") != "Crowd Alpha" && net_field_dev(c, "name").count > 0 && v[0].dev.named_count == 0;
  #assert cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "POST /api/playtest/player/name HTTP/1.1\r\n\r\n{\"name\":\"Ash\"}")][0..<4] == "403\n";
  // more players than the table holds: the oldest name goes, the newest is kept
  for q: 0..<DEV_NAMED + 2 {
    kb: [64] u8; kn := dv_put(kb[..], 0, "dev-key-for-the-name-check-1"); kn = rv_int(kb[..], kn, q);
    qb: [256] u8; qn := dv_put(qb[..], 0, "POST /api/playtest/player/name HTTP/1.1\r\nX-Verse-Player: "); qn = dv_put(qb[..], qn, cast(string) kb[0..<kn]);
    qn = dv_put(qb[..], qn, "\r\n\r\n{\"name\":\"Crowd Alpha\"}");
    #assert cast(string) v[0].dev.out[0..<rm_dev_api(v[..], cast(string) qb[0..<qn])][0..<4] == "200\n";
  }
  #assert v[0].dev.named_count == DEV_NAMED;
}

// ---- the realm's edit layer (verse/edit/edit.coax), as the API's verse.edit_spec, edit_switch and edit_settings
dv_realm :: (v: [] RmServer, req: string) -> int {
  base := "/api/playtest/realms/everglade";
  at := (ifx req[0] == 'G' then 4 else 5) + base.count;
  e := at;
  while e < req.count && req[e] != ' ' && req[e] != '?' { e += 1; }
  tail := req[at..<e];
  admin := v[0].dev.admin;
  if req[0] == 'G' && tail.count == 0 {
    b: [DEV_OUT] u8;
    n := dv_put(b[..], 0, "realm everglade\nrole "); n = dv_put(b[..], n, ifx admin then "admin" else "visitor");
    n = dv_put(b[..], n, ifx admin then "\nowner 1\n" else "\nowner 0\n");
    for t: 0..<DEV_TOOLS.count { n = dv_put(b[..], n, "tool "); n = dv_put(b[..], n, DEV_TOOLS[t]); n = dv_put(b[..], n, ifx v[0].dev.tool_off[t] then " 0\n" else " 1\n"); }
    for t: 0..<DEV_THINGS.count { n = dv_put(b[..], n, "thing "); n = dv_put(b[..], n, DEV_THINGS[t]); n = dv_put(b[..], n, "\n"); }
    for r: 0..<DEV_ROWS.count {
      n = dv_put(b[..], n, "row "); n = dv_put(b[..], n, DEV_ROWS[r]); n = dv_put(b[..], n, ifx v[0].dev.row_off[r] then " 0 " else " 1 ");
      n = dv_put(b[..], n, DEV_ROW_LABELS[r]); n = dv_put(b[..], n, "\n");
    }
    if admin { n = dv_put(b[..], n, "waiting 0\n"); }
    return dv_answer(v, "200", cast(string) b[0..<n]);
  }
  if req[0] == 'G' && (tail == "/proposals" || tail == "/asks" || tail == "/panes") { return dv_answer(v, "200", ""); }
  if req[0] == 'P' && (tail == "/switch" || tail == "/settings") {
    if !admin { return dv_answer(v, "403", "{\"error\":\"only its owner and admins\"}"); }
    body := dv_body(req);
    if tail == "/switch" {
      key := dv_json_text(body, "row"); on := dv_json_flag(body, "on");
      if key.count == 0 || on < 0 { return dv_answer(v, "404", "{\"error\":\"a row and on\"}"); }
      for r: 0..<DEV_ROWS.count {
        if DEV_ROWS[r] != key { continue; }
        v[0].dev.row_off[r] = on == 0;
        b: [96] u8;
        n := dv_put(b[..], 0, "{\"row\":\""); n = dv_put(b[..], n, key); n = dv_put(b[..], n, ifx on == 1 then "\",\"on\":true}" else "\",\"on\":false}");
        return dv_answer(v, "200", cast(string) b[0..<n]);
      }
      return dv_answer(v, "404", "{\"error\":\"no such row\"}");
    }
    for t: 0..<DEV_TOOLS.count { f := dv_json_flag(body, DEV_TOOLS[t]); if f >= 0 { v[0].dev.tool_off[t] = f == 0; } }
    return dv_answer(v, "200", "{\"ok\":true}");
  }
  return dv_answer(v, "404", "{\"error\":\"not in the local API\"}");
}
// A request's body: after its blank line.
dv_body :: (req: string) -> string {
  for i: 3..<req.count { if req[i - 3] == '\r' && req[i - 2] == '\n' && req[i - 1] == '\r' && req[i] == '\n' { return req[i + 1..<req.count]; } }
  return "";
}
// A JSON body's "name":"TEXT" (the first), "" none.
dv_json_text :: (t: string, name: string) -> string {
  a := dv_json_at(t, name);
  if a < 0 || a >= t.count || t[a] != '"' { return ""; }
  e := a + 1;
  while e < t.count && t[e] != '"' { e += 1; }
  return t[a + 1..<e];
}
// "name":true 1, false 0, else -1.
dv_json_flag :: (t: string, name: string) -> int {
  a := dv_json_at(t, name);
  if a < 0 { return -1; }
  if a + 4 <= t.count && t[a..<a + 4] == "true" { return 1; }
  if a + 5 <= t.count && t[a..<a + 5] == "false" { return 0; }
  return -1;
}
// Where "name"'s value starts (past the colon and spaces), -1 not there.
dv_json_at :: (t: string, name: string) -> int {
  for i: 0..<t.count {
    if t[i] != '"' || i + name.count + 2 > t.count || t[i + 1..<i + 1 + name.count] != name || t[i + 1 + name.count] != '"' { continue; }
    a := i + 2 + name.count;
    while a < t.count && t[a] == ' ' { a += 1; }
    if a >= t.count || t[a] != ':' { continue; }
    a += 1;
    while a < t.count && t[a] == ' ' { a += 1; }
    return a;
  }
  return -1;
}

#test "dev: the realm's edit spec says the local admin's role, tools, things and rows; a switch and the settings stick; a visitor may not" {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_dev_start(v[..]);
  spec := cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "GET /api/playtest/realms/everglade HTTP/1.1\r\n\r\n")];
  #assert spec == "200\nrealm everglade\nrole admin\nowner 1\ntool map 1\ntool build 1\nthing crate\nthing barrel\nthing bench\nthing fence\nthing stall\nrow flock 1 The flock that follows you\nrow floats 1 Ducks and lily pads\nrow undergrowth 1 Bushes, ferns and rocks\nrow daycycle 1 Day turning to night\nwaiting 0\n";
  sw := cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "POST /api/playtest/realms/everglade/switch HTTP/1.1\r\nContent-Length: 30\r\n\r\n{\"row\":\"daycycle\",\"on\":false}")];
  #assert sw == "200\n{\"row\":\"daycycle\",\"on\":false}" && v[0].dev.row_off[3];
  #assert cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "POST /api/playtest/realms/everglade/switch HTTP/1.1\r\n\r\n{\"row\":\"moon\",\"on\":true}")][0..<4] == "404\n";
  #assert cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "POST /api/playtest/realms/everglade/settings HTTP/1.1\r\n\r\n{\"tools\":{\"map\":true,\"build\":false}}")][0..<4] == "200\n";
  spec2 := cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "GET /api/playtest/realms/everglade?x=1 HTTP/1.1\r\n\r\n")];
  #assert spec2 == "200\nrealm everglade\nrole admin\nowner 1\ntool map 1\ntool build 0\nthing crate\nthing barrel\nthing bench\nthing fence\nthing stall\nrow flock 1 The flock that follows you\nrow floats 1 Ducks and lily pads\nrow undergrowth 1 Bushes, ferns and rocks\nrow daycycle 0 Day turning to night\nwaiting 0\n";
  #assert cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "GET /api/playtest/realms/everglade/proposals HTTP/1.1\r\n\r\n")] == "200\n";
  v[0].dev.admin = false;
  #assert cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "POST /api/playtest/realms/everglade/switch HTTP/1.1\r\n\r\n{\"row\":\"flock\",\"on\":false}")][0..<4] == "403\n";
  vs := cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "GET /api/playtest/realms/everglade HTTP/1.1\r\n\r\n")];
  #assert vs[0..<33] == "200\nrealm everglade\nrole visitor\n";
}

#test "dev: the stand-in mints a player, signs a ticket the room checks, and names it" {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_clock(v[..], 100, 1800000000000);
  #assert rm_dev_api(v[..], "POST /api/playtest/player HTTP/1.1\r\n\r\n") == -1;   // off without --dev
  rm_dev_start(v[..]);
  n := rm_dev_api(v[..], "POST /api/playtest/player HTTP/1.1\r\n\r\n{}");
  a := cast(string) v[0].dev.out[0..<n];
  #assert n > 4 && a[0..<4] == "200\n";
  key := net_field_dev(a, "key");
  #assert key.count > 4;
  kb: [64] u8; for i: 0..<key.count { kb[i] = key[i]; }
  rb: [256] u8;
  m := dv_put(rb[..], 0, "POST /api/playtest/room-ticket/everglade2-1?realm=everglade2 HTTP/1.1\r\nX-Verse-Player: ");
  m = dv_put(rb[..], m, cast(string) kb[0..<key.count]); m = dv_put(rb[..], m, "\r\n\r\n{}");
  t := rm_dev_api(v[..], cast(string) rb[0..<m]);
  ans := cast(string) v[0].dev.out[0..<t];
  #assert ans[0..<4] == "200\n";
  ticket := net_field_dev(ans, "ticket");
  tk := tk_check(DEV_KEY, ticket, "everglade2-1", v[0].wall_ms);
  #assert tk.ok && tk.name_n > 0 && net_field_dev(ans, "name").count > 0;
  // a ticket asked for the realm (as the page asks one from the rooms list, #12852) is for the room its
  // socket opens, the realm's first: a page with no ?room= sits in the local room
  qb: [256] u8;
  m2 := dv_put(qb[..], 0, "POST /api/playtest/room-ticket/everglade2?realm=everglade2&build=1.1.1 HTTP/1.1\r\nX-Verse-Player: ");
  m2 = dv_put(qb[..], m2, cast(string) kb[0..<key.count]); m2 = dv_put(qb[..], m2, "\r\n\r\n{}");
  t3 := rm_dev_api(v[..], cast(string) qb[0..<m2]);
  ans3 := cast(string) v[0].dev.out[0..<t3];
  #assert ans3[0..<4] == "200\n" && net_field_dev(ans3, "room") == "everglade2-1";
  #assert tk_check(DEV_KEY, net_field_dev(ans3, "ticket"), "everglade2-1", v[0].wall_ms).ok;
  #assert dv_numbered("everglade2-1") && dv_numbered("pair-e2-ab12-3") && !dv_numbered("everglade") && !dv_numbered("-1") && !dv_numbered("x-");
  // the same key, the same player
  t2 := rm_dev_api(v[..], cast(string) rb[0..<m]);
  #assert net_field_dev(cast(string) v[0].dev.out[0..<t2], "id") == cast(string) tk.pid[0..<tk.pid_n];
  // no key: refused, as the API does
  #assert cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "POST /api/playtest/room-ticket/everglade2-1 HTTP/1.1\r\n\r\n")][0..<4] == "401\n";
  #assert cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "GET /api/playtest/npc/ask HTTP/1.1\r\n\r\n")][0..<4] == "404\n";
  #assert v[0].tkey_n > 0 && v[0].tkey_must;
  // the local player is the realm's admin: EDIT without ?forge; the world's publish is the host's
  #assert cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "GET /api/auth/viewer HTTP/1.1\r\n\r\n")] == "200\nA|1\n";
  #assert rm_dev_api(v[..], "POST /api/playtest/world/everglade HTTP/1.1\r\n\r\n{}") == -1;
  v[0].dev.admin = false;
  #assert cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "GET /api/auth/viewer HTTP/1.1\r\n\r\n")] == "200\n";
  #assert cast(string) v[0].dev.out[0..<rm_dev_api(v[..], "POST /api/playtest/world/everglade HTTP/1.1\r\n\r\n{}")][0..<4] == "403\n";
}
// A flat JSON field's text, for the checks.
net_field_dev :: (t: string, name: string) -> string {
  for i: 0..<t.count {
    if t[i] != '"' || i + name.count + 3 > t.count || t[i + 1..<i + 1 + name.count] != name || t[i + 1 + name.count] != '"' || t[i + 2 + name.count] != ':' { continue; }
    a := i + 3 + name.count;
    q := a < t.count && t[a] == '"';
    if q { a += 1; }
    e := a;
    while e < t.count && (ifx q then t[e] != '"' else (t[e] != ',' && t[e] != '}')) { e += 1; }
    return t[a..<e];
  }
  return "";
}
