// Everglade II's rests (#13046): the room's shared rules decide them, from the body the room steps.
// A page asks (Z SEQ REQ: Short Rest, sleep, watch, one Hit Die, end; everglade-wire.coax); the room
// admits a start only when its own last step of that seat showed it grounded and still with its keys
// released and nothing of its input is still queued, then calls the shared rest control
// (aethyr/rules/srd/rest-control.coax rs_rest_control). Each accepted step reports the walking and
// jumping it actually moved (rs_rest_observe_motion), so moving interrupts a Short Rest and turns a
// Long Rest's watch into exertion; stopping returns it to watch, never to sleep. Time is the rules'
// clock (rm_eg_rules: e5rr_step), so recovery comes once, at the rules' boundary, never from a page.
// The seat hears its rest (z SEQ CODE DICE) when it asks, whenever the rules change it, and again on
// every new socket, so a page that rejoins shows the rest the room kept.
//   coax test coax/web/room/room.coax --only "e2 rest"

// An Everglade II room's battle schedules rests from its first tick.
e2_rest_start :: (v: [] RmServer, k: int) {
  _ := rs_rest_schedule_enable(v[0].eg[k].rules[0].b[..]);
  // a rest clock old enough to hold any carried rest history (a checkpoint's, rs_carry_in)
  if v[0].eg[k].rules[0].b[0].rest_clock.ticks < RS_CARRY_EPOCH { v[0].eg[k].rules[0].b[0].rest_clock.ticks = RS_CARRY_EPOCH; }
}
// What the step of input seq showed of seat s (moved from was): the walking and jumping it actually
// did, for the rules, and whether it now stands settled. A place (seq 0) or a cut is no observation.
e2_rest_step :: (v: [] RmServer, k: int, s_id: SeatId, seq: int, was: EgPose, was_placed: bool) { s := s_id.value;
  st := v[0].eg[k].seat[s..<s + 1];
  if seq <= 0 || !was_placed { st[0].rest_seen = false; st[0].rest_settled = false; return; }
  p := st[0].pose;
  keys := st[0].step_kx != 0 || st[0].step_ky != 0 || st[0].step_px != 0 || st[0].step_py != 0;
  jump := (st[0].step_b & WB_JUMP) != 0;
  dx := p.x - was.x; dz := p.z - was.z;
  walked := keys && dx * dx + dz * dz > 0.000001;
  jumped := jump && (was.g & WG_GROUND) != 0 && (p.g & WG_GROUND) == 0 && p.y > was.y;
  still := (p.g & WG_GROUND) != 0 && abs(p.vx) < 0.01 && abs(p.vz) < 0.01 && abs(p.vy) < 0.01;
  st[0].rest_seen = true; st[0].rest_settled = still && !keys && !jump;
  _ := rs_rest_observe_motion(v[0].eg[k].rules[0].b[..], E5RR_SEAT + s, walked, jumped, still);
}
// Whether the room's own observation of seat s admits starting or changing a rest now: its latest
// stepped input stood it still, and every input still queued (a page sends one each 1/30 s, so one
// is often waiting) holds its controls released too, unless the body can't move (asleep: its steps
// carry no locomotion, rm_eg_input).
e2_rest_settled :: (v: [] RmServer, k: int, s_id: SeatId) -> bool { s := s_id.value;
  st := v[0].eg[k].seat[s];
  if !(st.live && st.placed && st.rest_seen && st.rest_settled && v[0].eg[k].rules[0].live[s]) { return false; }
  if rs_locomotion_scale(v[0].eg[k].rules[0].b[..], E5RR_SEAT + s) <= 0 { return true; }
  for i: 0..<st.q_n { q := st.q[i]; if q.kx != 0 || q.ky != 0 || q.px != 0 || q.py != 0 || (q.b & WB_JUMP) != 0 { return false; } }
  return true;
}
// Z SEQ REQ.
e2_heard_rest :: (v: [] RmServer, k: int, seat_id: SeatId, text: string) { seat := seat_id.value;
  r: [1] WireRd; r[0] = wire_rd(text, 1);
  a := wire_read_rest_ask(text, r[..]);
  if !r[0].ok || eg_fields(text) != 3 || a.seq <= 0 { return; }
  if a.req < RS_REST_SHORT || a.req > RS_REST_DIE || !v[0].eg[k].rules[0].live[seat] { eg_refuse(v, k, seat_id, a.seq, "rest"); return; }
  b := v[0].eg[k].rules[0].b[..];
  if !rs_rest_control(b, E5RR_SEAT + seat, a.req, e2_rest_settled(v, k, seat_id)) { eg_refuse(v, k, seat_id, a.seq, "rest"); return; }
  e2_rest_tell(v, k, seat_id, a.seq);
}
// Everglade's whole-heal Long Rest (L) is not Everglade II's: its rests are the shared rules'.
e2_heard_old_rest :: (v: [] RmServer, k: int, seat_id: SeatId, text: string) {
  r: [1] WireRd; r[0] = wire_rd(text, 1);
  seq := wire_num(text, r[..]);
  if r[0].ok { eg_refuse(v, k, seat_id, seq, "rest"); }
}
// A creature's rest as the wire says it (WIRE_REST_*), and its Hit Dice left.
e2_rest_code :: (c: RsCreature) -> int {
  if c.long_rest.phase == 1 { return ifx c.long_rest.mode == 1 then WIRE_REST_SLEEP else ifx c.long_rest.mode == 3 then WIRE_REST_EXERT else WIRE_REST_WATCH; }
  if c.long_rest.phase == 2 { return WIRE_REST_BROKEN; }
  if c.long_rest.phase == 3 { return WIRE_REST_DUE; }
  if c.rest.phase == 1 { return WIRE_REST_SHORT; }
  if c.rest.phase == 2 { return WIRE_REST_CHOOSE; }
  return WIRE_REST_NONE;
}
e2_rest_dice :: (c: RsCreature) -> int {
  if c.rest.seeded { return c.rest.dice; }
  return ifx rs_class_hit_die(c.klass) > 0 && c.level >= 1 && c.level <= 20 then c.level else 0;
}
// Seat s hears its rest now (seq: the request it answers, 0 none).
e2_rest_tell :: (v: [] RmServer, k: int, s_id: SeatId, seq: int) { s := s_id.value;
  st := v[0].eg[k].seat[s..<s + 1];
  if !st[0].live || st[0].conn < 0 { return; }
  c := v[0].eg[k].rules[0].b[0].c[E5RR_SEAT + s];
  z := WireRestState.{seq = seq, code = e2_rest_code(c), dice = e2_rest_dice(c)};
  b: [48] u8;
  n := wire_put_rest_state(b[..], 0, z);
  rl_queue(v, v[0].eg[k].relay, st[0].conn, -1, cast(string) b[0..<n], "");
  st[0].rest_told = z.code; st[0].rest_told_dice = z.dice;
}
// After the rules' tick: each seat whose rest changed (or whose socket is new) hears it.
e2_rest_tell_all :: (v: [] RmServer, k: int) {
  for s: 0..<EG_SEATS {
    st := v[0].eg[k].seat[s];
    if !st.live || st.conn < 0 || !v[0].eg[k].rules[0].live[s] { continue; }
    c := v[0].eg[k].rules[0].b[0].c[E5RR_SEAT + s];
    if e2_rest_code(c) != st.rest_told || e2_rest_dice(c) != st.rest_told_dice { e2_rest_tell(v, k, SeatId.{value = s}, 0); }
  }
}

// ---- the bar (#13046): each seat hears what its bar has left (b N V ..., everglade-wire.coax), its
// level's bar in its order, whenever that changes: what a cast spent, a rest restored, a Rage ending.
// The page draws the counts on the icons; the room's rules are the only source of them.
e2_kit :: (v: [] RmServer, k: int, s: int) -> WireKit {
  w: WireKit;
  r := v[0].eg[k].rules[..];
  if !r[0].live[s] || r[0].klass[s] < E5R_CL0 { return w; }
  i := E5RR_SEAT + s; b := r[0].b[..]; c := b[0].c[i];
  bar: [XC_SLOTS] FbAb; n := xk_bar_at(r[0].klass[s] - E5R_CL0, c.level, bar[..]);
  w.n = ifx n > WIRE_KIT then WIRE_KIT else n;
  for q: 0..<w.n {
    a := bar[q];
    on := (a.kind == FB_RAGE && c.raging) || (a.kind == FB_WILD && c.wild_form != 0);
    w.v[q] = wire_kit_v(fb_left(b, i, a), on);
  }
  return w;
}
e2_kit_hash :: (w: WireKit) -> int { h := w.n + 1; for q: 0..<w.n { h = (h * 131 + w.v[q] + 1) % 1000000007; } return h; }
// Seat s hears its bar now, if it changed since it last heard (or `always`).
e2_kit_tell :: (v: [] RmServer, k: int, s_id: SeatId, always: bool) { s := s_id.value;
  st := v[0].eg[k].seat[s..<s + 1];
  if !st[0].live || st[0].conn < 0 { return; }
  w := e2_kit(v, k, s);
  h := e2_kit_hash(w);
  if w.n == 0 || (!always && h == st[0].kit_told) { return; }
  b: [WIRE_KIT * 5 + 16] u8;
  n := wire_put_kit(b[..], 0, w);
  rl_queue(v, v[0].eg[k].relay, st[0].conn, -1, cast(string) b[0..<n], "");
  st[0].kit_told = h;
}
// After the rules' tick: a sixth of the seats each tick, so each is looked at five times a second.
e2_kit_tell_all :: (v: [] RmServer, k: int) {
  for s: 0..<EG_SEATS {
    if (v[0].eg[k].tick + s) % 6 != 0 && v[0].eg[k].seat[s].kit_told != -1 { continue; }
    st := v[0].eg[k].seat[s];
    if !st.live || st.conn < 0 || !v[0].eg[k].rules[0].live[s] { continue; }
    e2_kit_tell(v, k, SeatId.{value = s}, false);
  }
}

// ---- checks
e2rt_room :: (v: [] RmServer, kind: string) -> int {
  rm_init(v); rm_clock(v, 0, 1762190000000);
  path := "GET /api/room/relay/everglade/pair-e2-rest HTTP/1.1\r\n\r\n";
  if rm_join(v, 0, path) != 0 { return -1; }
  k := eg_room_at(v, v[0].conns[0].relay);
  h: [96] u8; n := put(h[..], 0, "H 5 ranger.0.0.0 "); n = put(h[..], n, kind); n = put(h[..], n, " 0 -");
  rm_heard(v, 0, cast(string) h[0..<n]);
  for q: 0..<3 { eg_test_tick(v, k); }
  return k;
}
// One input from conn c (its pad's forward push: 0 still) and the room's tick that steps it.
e2rt_step :: (v: [] RmServer, k: int, c: int, seq: int, push: int) {
  m: [64] u8; q := put(m[..], 0, "I "); q = put_int(m[..], q, seq); q = put(m[..], q, " 0 0 "); q = put_int(m[..], q, push); q = put(m[..], q, " 0 0 0 0");
  rm_heard(v, c, cast(string) m[0..<q]); eg_test_tick(v, k);
}
e2rt_ask :: (v: [] RmServer, c: int, seq: int, req: int) {
  b: [32] u8; rm_heard(v, c, cast(string) b[0..<wire_put_rest_ask(b[..], 0, WireRestAsk.{seq = seq, req = req})]);
}
// The rules' clock on by `seconds` in one room tick (as hours of play would, in a check's time).
e2rt_wait :: (v: [] RmServer, k: int, seconds: int) { v[0].eg[k].tick += seconds * EG_HZ; eg_test_tick(v, k); }
e2rt_heard :: (v: [] RmServer, c: int, box: [] u8) -> string { return rl_heard_by(v, c, box); }

#test "e2 rest: the room starts a Long Rest only from its own settled step; sleep holds the body, movement is exertion, and recovery comes once" #steps 4000000000 {
  v: [1] RmServer; k := e2rt_room(v[..], "srd-fighter"); #assert k >= 0 && v[0].eg[k].e2;
  b := v[0].eg[k].rules[0].b[..]; c := b[0].c[E5RR_SEAT..<E5RR_SEAT + 1]; box: [16384] u8;
  #assert b[0].rest_auto;
  // nothing stepped since its place: the room has not seen it still, so it may not rest
  _ := e2rt_heard(v[..], 0, box[..]);
  e2rt_ask(v[..], 0, 1, RS_REST_SLEEP);
  #assert eg_test_has(e2rt_heard(v[..], 0, box[..]), "r 1 rest") && c[0].long_rest.phase == 0;
  // walking: still not settled; then a still step: asleep
  e2rt_step(v[..], k, 0, 1, 100); e2rt_ask(v[..], 0, 2, RS_REST_SLEEP);
  #assert eg_test_has(e2rt_heard(v[..], 0, box[..]), "r 2 rest") && c[0].long_rest.phase == 0;
  e2rt_step(v[..], k, 0, 2, 0); e2rt_ask(v[..], 0, 3, RS_REST_SLEEP);
  #assert eg_test_has(e2rt_heard(v[..], 0, box[..]), "z 3 3 1") && rs_sleeping(c[0]);
  // malformed or unknown requests are refused and change nothing; the old whole-heal L is not this room's
  e2rt_ask(v[..], 0, 4, 9); rm_heard(v[..], 0, "L 5"); rm_heard(v[..], 0, "Z 6");
  a := e2rt_heard(v[..], 0, box[..]); #assert eg_test_has(a, "r 4 rest") && eg_test_has(a, "r 5 rest") && !eg_test_has(a, "r 6") && rs_sleeping(c[0]);
  // asleep, the keys move nothing; awake on watch, walking is exertion and stopping is watch again
  x := v[0].eg[k].seat[0].pose.x;
  e2rt_step(v[..], k, 0, 3, 100); #assert v[0].eg[k].seat[0].pose.x == x && c[0].long_rest.mode == 1;
  e2rt_ask(v[..], 0, 7, RS_REST_WATCH); #assert !rs_sleeping(c[0]) && c[0].long_rest.mode == 2;
  e2rt_step(v[..], k, 0, 4, 100); #assert v[0].eg[k].seat[0].pose.x > x && c[0].long_rest.mode == 3;
  #assert eg_test_has(e2rt_heard(v[..], 0, box[..]), "z 0 5 1");
  e2rt_step(v[..], k, 0, 5, 0); #assert c[0].long_rest.mode == 2 && c[0].long_rest.phase == 1;
  // back to sleep, then the night: whole once, at the rules' boundary
  e2rt_ask(v[..], 0, 8, RS_REST_SLEEP); c[0].hp = 3; c[0].slots[1] = 0;
  e2rt_wait(v[..], k, 8 * 3600 + 60);
  #assert c[0].long_rest.completed && c[0].long_rest.phase == 0 && c[0].hp == c[0].hp_max && !rs_sleeping(c[0]);
  #assert eg_test_has(e2rt_heard(v[..], 0, box[..]), "z 0 0 1");
  c[0].hp = 2; e2rt_wait(v[..], k, 3600); #assert c[0].hp == 2;
  #assert !eg_test_has(e2rt_heard(v[..], 0, box[..]), "z 0");
  // a second Long Rest within the day is the rules' to refuse
  e2rt_step(v[..], k, 0, 6, 0); e2rt_ask(v[..], 0, 9, RS_REST_SLEEP);
  #assert eg_test_has(e2rt_heard(v[..], 0, box[..]), "r 9 rest") && c[0].long_rest.phase == 0;
}
#test "e2 rest: a Short Rest broken by walking starts over, and its Hit Die choice heals once" #steps 4000000000 {
  v: [1] RmServer; k := e2rt_room(v[..], "srd-wizard"); #assert k >= 0;
  b := v[0].eg[k].rules[0].b[..]; c := b[0].c[E5RR_SEAT..<E5RR_SEAT + 1]; box: [16384] u8;
  b[0].dice[0].fixed = true; c[0].hp = 1;
  e2rt_step(v[..], k, 0, 1, 0); e2rt_ask(v[..], 0, 1, RS_REST_SHORT);
  #assert c[0].rest.phase == 1 && eg_test_has(e2rt_heard(v[..], 0, box[..]), "z 1 1 1");
  e2rt_wait(v[..], k, 1800); e2rt_step(v[..], k, 0, 2, 100);
  #assert c[0].rest.phase == 0 && eg_test_has(e2rt_heard(v[..], 0, box[..]), "z 0 0 1");
  e2rt_ask(v[..], 0, 2, RS_REST_DIE); #assert eg_test_has(e2rt_heard(v[..], 0, box[..]), "r 2 rest") && c[0].hp == 1;
  e2rt_step(v[..], k, 0, 3, 0); e2rt_ask(v[..], 0, 3, RS_REST_SHORT);
  e2rt_wait(v[..], k, 3600 + 1);
  #assert c[0].rest.phase == 2 && eg_test_has(e2rt_heard(v[..], 0, box[..]), "z 0 2 1");
  e2rt_ask(v[..], 0, 4, RS_REST_DIE); hp := c[0].hp;
  #assert hp > 1 && c[0].rest.dice == 0 && eg_test_has(e2rt_heard(v[..], 0, box[..]), "z 4 2 0");
  e2rt_ask(v[..], 0, 5, RS_REST_DIE); #assert c[0].hp == hp && eg_test_has(e2rt_heard(v[..], 0, box[..]), "r 5 rest");
  e2rt_ask(v[..], 0, 6, RS_REST_END); #assert c[0].rest.phase == 0 && eg_test_has(e2rt_heard(v[..], 0, box[..]), "z 6 0 0");
}
#test "e2 rest: an hour of walking interrupts a Long Rest, which resumes on sleep and completes once" #steps 4000000000 {
  v: [1] RmServer; k := e2rt_room(v[..], "srd-cleric"); #assert k >= 0;
  b := v[0].eg[k].rules[0].b[..]; c := b[0].c[E5RR_SEAT..<E5RR_SEAT + 1]; box: [16384] u8;
  e2rt_step(v[..], k, 0, 1, 0); e2rt_ask(v[..], 0, 1, RS_REST_WATCH);
  e2rt_step(v[..], k, 0, 2, 100); #assert c[0].long_rest.mode == 3;
  e2rt_wait(v[..], k, 3601);
  #assert c[0].long_rest.phase == 2 && c[0].long_rest.interruptions == 1 && eg_test_has(e2rt_heard(v[..], 0, box[..]), "z 0 6 1");
  c[0].hp = 4;
  // still interrupted: no sleep before the room sees the body settle again
  e2rt_ask(v[..], 0, 2, RS_REST_SLEEP); #assert c[0].long_rest.phase == 2 && eg_test_has(e2rt_heard(v[..], 0, box[..]), "r 2 rest");
  e2rt_step(v[..], k, 0, 3, 0); e2rt_ask(v[..], 0, 3, RS_REST_SLEEP); #assert c[0].long_rest.phase == 1 && rs_sleeping(c[0]) && c[0].hp == 4;
  e2rt_wait(v[..], k, 9 * 3600);
  #assert c[0].long_rest.completed && c[0].hp == c[0].hp_max;
  c[0].hp = 4; e2rt_wait(v[..], k, 600); #assert c[0].hp == 4;
}
#test "e2 rest: a socket rejoin within the grace keeps the rest, its time and casts, and the new page hears it" #steps 4000000000 {
  v: [1] RmServer; rm_init(v[..]); now := 1762190000000; rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  t: [256] u8; r: [512] u8; box: [16384] u8;
  n := tk_sign(key, "p-0011223344556677", false, "", "pair-e2-rest", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 0, tk_test_ask_in(r[..], t[..], n, "pair-e2-rest")) == 0;
  rm_heard(v[..], 0, "H 5 ranger.0.0.0 srd-fighter 0 A");
  k := eg_room_at(v[..], v[0].conns[0].relay);
  for q: 0..<3 { eg_test_tick(v[..], k); }
  c := v[0].eg[k].rules[0].b[0].c[E5RR_SEAT..<E5RR_SEAT + 1];
  e2rt_step(v[..], k, 0, 1, 0); e2rt_ask(v[..], 0, 1, RS_REST_SLEEP);
  wire: [128] u8; c[0].hp = 3;
  e2rt_wait(v[..], k, 3600);
  _ := e2rt_heard(v[..], 0, box[..]);
  sleep := c[0].long_rest.sleep; last := v[0].eg[k].seat[0].last_cast;
  rm_left(v[..], 0); #assert eg_held(v[..], k, SeatId.{value = 0});
  v[0].eg_test_t0 += 3000; eg_test_tick(v[..], k);
  #assert c[0].long_rest.phase == 1 && rs_sleeping(c[0]) && c[0].long_rest.sleep > sleep;
  n = tk_sign(key, "p-0011223344556677", false, "", "pair-e2-rest", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 1, tk_test_ask_in(r[..], t[..], n, "pair-e2-rest")) == 0;
  rm_heard(v[..], 1, "H 5 ranger.0.0.0 srd-fighter 0 A");
  eg_test_tick(v[..], k);
  #assert c[0].long_rest.phase == 1 && rs_sleeping(c[0]) && c[0].hp == 3 && v[0].eg[k].seat[0].last_cast == last;
  #assert eg_test_has(e2rt_heard(v[..], 1, box[..]), "z 0 3 1");
  // the new page must be seen still again before it changes the rest
  e2rt_ask(v[..], 1, 2, RS_REST_WATCH); #assert eg_test_has(e2rt_heard(v[..], 1, box[..]), "r 2 rest") && rs_sleeping(c[0]);
  e2rt_step(v[..], k, 1, 1, 0); e2rt_ask(v[..], 1, 3, RS_REST_WATCH); #assert !rs_sleeping(c[0]) && c[0].long_rest.mode == 2;
}
// A v4-ticket join of p-a to pair-e2-rest carrying capture (and its rest, for profile 3).
e2rt_ck_join :: (v: [] RmServer, conn: int, owner: int, capture: CharacterCapture, rest: CharacterRest) -> int {
  core: [256] u8; out: [RT_TEXT] u8; saved: [CC_BODY] u8; request: [4608] u8;
  n := tk_sign_owner(CK_TEST_KEY, "p-a", false, "Ash", "pair-e2-rest", 1, v[0].wall_ms + 60000, -1, -1, 0, owner, core[..]);
  cap := ifx capture.ok then cc_stored_rest(capture, rest, saved[..]) else "-";
  ticket := resume_ticket_wrap(CK_TEST_KEY, cast(string) core[0..<n], cap, out[..]);
  size := tk_add(request[..], 0, "GET /api/room/relay/everglade/pair-e2-rest?t="); size = tk_add(request[..], size, ticket); size = tk_add(request[..], size, " HTTP/1.1\r\n\r\n");
  if rm_join(v, conn, cast(string) request[0..<size]) < 0 { return -1; }
  k := eg_room_at(v, v[0].conns[conn].relay);
  rm_heard(v, conn, "H 5 ranger.0.0.0 srd-fighter 0 Ash");
  ck_test_place(v, k);   // a seat waits for its first durable capture to play
  return k;
}
e2rt_ack :: (v: [] RmServer) { b: [256] u8; rm_checkpoint_answer(v, v[0].ck.request, 200, ck_test_receipt(v, "applied", b[..])); }
e2rt_land :: (v: [] RmServer, k: int) { for q: 0..<90 { eg_test_tick(v, k); } }

#test "e2 rest: a restarted room's checkpoint carries the rest, which the new process resumes without offline credit; an API without profile 3 gets profile 2 (#13046)" #steps 4000000000 {
  v: [1] RmServer; ck_test_init(v[..]); k := e2rt_ck_join(v[..], 0, 7, CharacterCapture.{}, CharacterRest.{});
  #assert k >= 0 && v[0].eg[k].e2 && v[0].eg[k].rules[0].b[0].rest_clock.ticks >= RS_CARRY_EPOCH;
  #assert rm_checkpoint_due(v[..]) > 0; e2rt_ack(v[..]); #assert !rm_checkpoint_paused(v[..], k); e2rt_land(v[..], k);
  b := v[0].eg[k].rules[0].b[..]; c := b[0].c[E5RR_SEAT..<E5RR_SEAT + 1]; box: [16384] u8;
  e2rt_step(v[..], k, 0, 1, 0); e2rt_ask(v[..], 0, 2, RS_REST_SLEEP); #assert rs_sleeping(c[0]);
  e2rt_wait(v[..], k, 3 * 3600); slept := c[0].long_rest.sleep; #assert slept >= 10800000000;
  ck_capture(v[..], k, SeatId.{value = 0}); #assert rm_checkpoint_due(v[..]) > 0;
  body := cast(string) v[0].ck.out[0..<v[0].ck.out_n]; cap := cc_read(body, true); rest := cc_rest(body, true);
  #assert cap.ok && cap.n[0] == 3 && rest.on && rest.n[6] == 1 && rest.n[7] == 1 && rest.n[9] == slept / 1000;
  e2rt_ack(v[..]);
  // the replacement process, an hour later: asleep with the same night so far, and it says so
  ck_test_init(v[..]); rm_clock(v[..], 5000, 1762190000000 + 3600000);
  kw := e2rt_ck_join(v[..], 0, 8, cap, rest); #assert kw >= 0;
  wc := v[0].eg[kw].rules[0].b[0].c[E5RR_SEAT..<E5RR_SEAT + 1];
  #assert rs_sleeping(wc[0]) && wc[0].long_rest.phase == 1 && wc[0].long_rest.sleep == slept / 1000 * 1000;
  // this API refuses profile 3: the retry and every later capture are profile 2
  #assert rm_checkpoint_due(v[..]) > 0 && cc_read(cast(string) v[0].ck.out[0..<v[0].ck.out_n], true).n[0] == 3;
  rm_checkpoint_answer(v[..], v[0].ck.request, 400, "{\"error\":\"bad checkpoint\"}");
  #assert v[0].ck.two_only && v[0].ck.two_falls == 1;
  rm_clock(v[..], v[0].ck.retry_at, 1762190000000 + 3601000); #assert rm_checkpoint_due(v[..]) > 0;
  two := cast(string) v[0].ck.out[0..<v[0].ck.out_n]; #assert cc_read(two, true).ok && cc_read(two, true).n[0] == 2 && !cc_rest(two, true).on;
  e2rt_ack(v[..]); #assert !rm_checkpoint_paused(v[..], kw); e2rt_land(v[..], kw);
  #assert eg_test_has(e2rt_heard(v[..], 0, box[..]), "z 0 3 ") && rs_sleeping(wc[0]);
  two_cap := cc_read(two, true);
  // no offline credit: the rest completes only after the rest of its eight hours here
  wc[0].hp = 2; left := (28800000000 - wc[0].long_rest.elapsed) / 1000000;
  e2rt_wait(v[..], kw, left - 60); #assert !wc[0].long_rest.completed && wc[0].hp == 2;
  e2rt_wait(v[..], kw, 120); #assert wc[0].long_rest.completed && wc[0].hp == wc[0].hp_max;
  // a profile 2 capture brings no rest back
  ck_test_init(v[..]);
  kx := e2rt_ck_join(v[..], 0, 9, two_cap, CharacterRest.{}); #assert kx >= 0;
  #assert v[0].eg[kx].rules[0].b[0].c[E5RR_SEAT].long_rest.phase == 0 && !rs_sleeping(v[0].eg[kx].rules[0].b[0].c[E5RR_SEAT]);
}
#test "e2 rest: a restarted room's profile 3 checkpoint carries the limited uses past profile 2's 11; a body without them leaves those full (#13046)" #steps 4000000000 {
  v: [1] RmServer; ck_test_init(v[..]); k := e2rt_ck_join(v[..], 0, 7, CharacterCapture.{}, CharacterRest.{});
  #assert k >= 0; #assert rm_checkpoint_due(v[..]) > 0; e2rt_ack(v[..]); e2rt_land(v[..], k);
  c := v[0].eg[k].rules[0].b[0].c[E5RR_SEAT..<E5RR_SEAT + 1];
  // Uncanny Metabolism and Faithful Steed spent, Magical Cunning left
  for q: 0..<CC_MORE { c[0].uses_max[CK_USES + q] = 1; c[0].uses[CK_USES + q] = ifx q == 1 then 1 else 0; }
  ck_capture(v[..], k, SeatId.{value = 0}); #assert rm_checkpoint_due(v[..]) > 0;
  body := cast(string) v[0].ck.out[0..<v[0].ck.out_n]; cap := cc_read(body, true); rest := cc_rest(body, true);
  #assert cap.ok && cap.n[0] == 3 && rest.on && rest.more && rest.uses[0] == 0 && rest.uses[1] == 1 && rest.uses[2] == 0;
  e2rt_ack(v[..]);
  for older: 0..<2 {
    ck_test_init(v[..]);
    r := rest; if older == 1 { r.more = false; r.uses = [3] int.[0, 0, 0]; }   // an older room's profile 3 body
    kw := e2rt_ck_join(v[..], 0, 8 + older, cap, r); #assert kw >= 0;
    wc := v[0].eg[kw].rules[0].b[0].c[E5RR_SEAT..<E5RR_SEAT + 1];
    // a body that has these features (an srd-* seat starts at level 1), then the restore
    for q: 0..<CC_MORE { wc[0].uses_max[CK_USES + q] = 1; wc[0].uses[CK_USES + q] = 1; }
    ck_restore(v[..], kw, SeatId.{value = 0});
    for q: 0..<CC_MORE { #assert wc[0].uses[CK_USES + q] == (ifx older == 1 || q == 1 then 1 else 0); }
    // never more than this body's own
    wc[0].uses_max[CK_USES + 1] = 0; ck_restore(v[..], kw, SeatId.{value = 0}); #assert wc[0].uses[CK_USES + 1] == (ifx older == 1 then 1 else 0);
  }
}
#test "e2 rest: a still input still queued (a page sends one each 1/30 s) does not refuse a rest; a queued walking or jumping one does" #steps 4000000000 {
  v: [1] RmServer; k := e2rt_room(v[..], "srd-fighter"); c := v[0].eg[k].rules[0].b[0].c[E5RR_SEAT..<E5RR_SEAT + 1]; box: [16384] u8;
  e2rt_step(v[..], k, 0, 1, 0); _ := e2rt_heard(v[..], 0, box[..]);
  rm_heard(v[..], 0, "I 2 0 0 0 100 0 0 0"); #assert v[0].eg[k].seat[0].q_n == 1;
  e2rt_ask(v[..], 0, 1, RS_REST_SHORT); #assert eg_test_has(e2rt_heard(v[..], 0, box[..]), "r 1 rest") && c[0].rest.phase == 0;
  eg_test_tick(v[..], k); e2rt_step(v[..], k, 0, 3, 0);
  m: [64] u8; q := put(m[..], 0, "I 4 0 0 0 0 0 "); q = put_int(m[..], q, WB_JUMP); q = put(m[..], q, " 0");
  rm_heard(v[..], 0, cast(string) m[0..<q]); #assert v[0].eg[k].seat[0].q_n == 1;
  e2rt_ask(v[..], 0, 2, RS_REST_SHORT); #assert eg_test_has(e2rt_heard(v[..], 0, box[..]), "r 2 rest") && c[0].rest.phase == 0;
  eg_test_tick(v[..], k); e2rt_step(v[..], k, 0, 5, 0); for t: 0..<30 { eg_test_tick(v[..], k); } e2rt_step(v[..], k, 0, 6, 0);
  rm_heard(v[..], 0, "I 7 0 0 0 0 0 0 0"); #assert v[0].eg[k].seat[0].q_n == 1;
  e2rt_ask(v[..], 0, 3, RS_REST_SHORT); #assert eg_test_has(e2rt_heard(v[..], 0, box[..]), "z 3 1 ") && c[0].rest.phase == 1;
  // asleep, a queued walking input moves nothing, so it does not keep the sleeper from the watch
  e2rt_ask(v[..], 0, 4, RS_REST_END); eg_test_tick(v[..], k); e2rt_step(v[..], k, 0, 8, 0);
  e2rt_ask(v[..], 0, 5, RS_REST_SLEEP); #assert rs_sleeping(c[0]);
  rm_heard(v[..], 0, "I 9 0 0 100 0 0 0 0"); #assert v[0].eg[k].seat[0].q_n == 1;
  e2rt_ask(v[..], 0, 6, RS_REST_WATCH); #assert !rs_sleeping(c[0]) && c[0].long_rest.mode == 2;
}

#test "e2 healer kit: room admits contact with a dying ally once and spends the saved Action" #steps 4000000000 {
  v:[1] RmServer; rm_init(v[..]); rm_clock(v[..],0,1762190000000);
  path:="GET /api/room/relay/everglade/pair-e2-first-aid HTTP/1.1\r\n\r\n";
  #assert rm_join(v[..],0,path)==0 && rm_join(v[..],1,path)==1;
  k:=eg_room_at(v[..],v[0].conns[0].relay);
  rm_heard(v[..],0,"H 5 ranger.0.0.0 srd-fighter 0 -");
  rm_heard(v[..],1,"H 5 ranger.0.0.0 srd-wizard 0 -");
  for q:0..<3 { eg_test_tick(v[..],k); }
  room:=v[0].eg[k..<k+1];
  rules:=room[0].rules[..]; b:=rules[0].b[..];
  actor:=E5RR_SEAT; patient:=actor+1;
  #assert b[0].c[actor].healer_kit==10;
  rs_damage(b,actor,patient,b[0].c[patient].hp,RS_FORCE,false,-1);
  #assert rs_death_eligible(b[0].c[patient]);
  room[0].seat[1].pose=room[0].seat[0].pose;
  room[0].seat[1].pose.x+=2;
  rm_heard(v[..],0,"U1 3000001");
  rc_test_tick(v[..],k,true);
  #assert !b[0].c[patient].stable && b[0].c[actor].healer_kit==10;
  room[0].seat[1].pose.x-=1;
  rm_heard(v[..],0,"U1 3000001");
  #assert !b[0].c[patient].stable;
  rm_heard(v[..],0,"U1 3000002");
  rc_test_tick(v[..],k,false);
  #assert !b[0].c[patient].stable && b[0].c[actor].healer_kit==10;
  rm_heard(v[..],0,"U1 3000003");
  rc_test_tick(v[..],k,true);
  #assert b[0].c[patient].stable && b[0].c[patient].hp==0 && b[0].c[actor].healer_kit==9;
  #assert rules[0].seat[0].turn.action;
  box:[16384] u8;
  #assert eg_test_has(e2rt_heard(v[..],0,box[..]),"u1 3000003 9");
  rm_heard(v[..],0,"U1 3000002");
  #assert b[0].c[actor].healer_kit==9;
}
