// Everglade's world events and its levels 1 to 3 on the room server (spec
// docs/verse/2026-11-03-everglade-world-events.md; epic #12737, #12738, #12739). Each Everglade
// instance runs at most one event at a time, the same for every seat in it: the Cultist Raid first.
//
// The dials are the realm's, an admin's from the events pane: the API keeps them
// (verse.room_events, coax/web/api/player.c room_event) and room-control.coax's poll hears them
// every 2 s as two lines, which ev_control_line reads:
//   event ON EVERY WAVES SIZE CULT FAN WL WLMAX GATES ARCH AGGR HARM REWARD MINUTES START STOP
//   levels ON CAP      (CAP the highest level a character reaches: 1 to 3, 2 for now)
// START and STOP count an admin's presses: a shard acts on each new count once, in every live room.
// EVERY (minutes, 0 off) starts a raid in every live room at each whole multiple of it on the wall
// clock, so every shard and instance starts together.
//
// The lifecycle (spec 3.2): idle, announce (30 s), wave (until it is down, 90 s at most), lull
// (15 s), the waves again, climax (until the leader withdraws, 3 minutes at most), end (5 s) and
// aftermath (60 s, then the server's own rebuild). The time limit, the town's people all down and
// an admin's STOP end it early (spec 3.3).
//
// What a seat hears, in its D frames (pages that don't know them skip them):
//   g KIND PHASE WAVE WAVES SECS LEFT STANDING SLAIN SQUARE WARDS ARCH OUTCOME FOLK LEVELS CAP PLAYERS
//       the event's state on change (KIND 0: none); SECS the phase's seconds left (idle: to the
//       next scheduled start, -1 none), LEFT the time limit's
//   v SS LEVEL XP CAP LO HI   each seat's level, XP, the level cap, and the bar slots its character has
//       (bit q of LO: druid slot q; bit q of HI: Warlock slot FB_WL0 + q; both 0: the whole bar)
//   e xp SS AMOUNT, e level SS LEVEL   a gain, a level-up
//
// Levels (spec 6): with `levels 1`, each seat's character is the SRD 5.2.1 Druid or Fiend Warlock at
// the level its XP gives (300 for 2, 900 for 3, never past the cap), built by the engine's rs_druid
// and rs_warlock, with that level's kit of the bar and nothing more (ev_kit): a cast of a slot outside
// it is refused ("r SEQ level"). Everglade's own level 9 druid and level 17 Warlock stay as a demo
// character for the realm's admins (their ticket's ACCT 2 and the hello's FLAGS bit EV_DEMO_FLAG).
// XP counts and saves either way: the vitals report carries it (room-vitals.coax) and the seat ticket
// brings it back (room-ticket.coax).
//   coax test --library coax/web/room/room.coax --steps 4000000000 --only "events:"

EV_NONE :: 0; EV_RAID :: 1;
EV_IDLE :: 0; EV_ANNOUNCE :: 1; EV_WAVE :: 2; EV_LULL :: 3; EV_CLIMAX :: 4; EV_END :: 5; EV_AFTER :: 6;
EV_OUT_NONE :: 0; EV_OUT_HELD :: 1; EV_OUT_FELL :: 2; EV_OUT_OFF :: 3;
EV_ARCH_AWAY :: 0; EV_ARCH_WARDED :: 1; EV_ARCH_EXPOSED :: 2; EV_ARCH_GONE :: 3;
// the phases' lengths, seconds (spec 3.2)
EV_ANNOUNCE_S :: 30; EV_WAVE_S :: 90; EV_LULL_S :: 15; EV_CLIMAX_S :: 180; EV_END_S :: 5; EV_AFTER_S :: 60;
// levels (SRD 5.2.1, Character Advancement): XP for level 2 and 3; 3 is the cap
EV_XP2 :: 300; EV_XP3 :: 900; EV_LEVEL_TOP :: 3;   // the cap is a dial (EvDials.cap), 1 to EV_LEVEL_TOP
// The raid's XP, every number of it here (spec 4.1, 6.4 and 7), each times the reward dial. A raider
// gives EV_XP_SRD_X times its SRD XP, split evenly among every seat that hurt it (the SRD's split
// among those who took part): the waves grow with the players (everglade-raid-scale.coax), so a
// group earns about what one player does. A ward stone gives EV_XP_WARD the same way. At the raid's
// end, each seat that earned XP in it gets EV_XP_HELD when the town held, EV_XP_FELL when it fell
// (an admin's STOP: nothing). Tuned so a new player who fights reaches level 2 in about one raid,
// held or fallen, with 1 player or 16 (raid-proof.sh RAID_MODE=fight RAID_LEVEL2=1).
EV_XP_SRD_X :: 2;               // the raid pays twice the SRD's XP for each raider
EV_XP_CULTIST :: 25;            // SRD: Cultist, CR 1/8
EV_XP_FANATIC :: 450;           // SRD: Cultist Fanatic, CR 2
EV_XP_WARLOCK :: [3] int.[50, 100, 200];   // Warlock, level 1 to 3: CR 1/4, 1/2, 1 (a house rule)
EV_XP_WARD :: 100;              // a ward stone
EV_XP_HELD :: 150;              // the town held
EV_XP_FELL :: 100;              // the town fell
EV_DEMO_FLAG :: 64;             // the hello's FLAGS bit: an admin plays Everglade's own character, the demo
EV_XP_MAX :: 9999999;
EV_G :: 160;                    // the g entry's bytes at most
// the raid (spec 4 and 5): at most this many raiders stand at once, waves together
EV_STANDING_MAX :: 60;          // (with Darian Odiodei and 3 ward stones, the raid's 64 places: E5RD_MAX)
EV_SQUARE_PLAYER :: 2;
EV_RISE_S :: 10;                // s a fallen player lies before standing again, whole, where they fell          // on the square a player counts as this many of the town
EV_SQUARE_R :: 18.0;            // m: the square, about its well (plan.coax EG_SQUARE 0)
EV_GATES :: 5;                  // the dial's bits: plan.coax EG_GATE's four (South, North, East, West), then the river bridge
EV_OUT_M :: 20.0;               // m outside its gate a raider comes from
// the town's places (verse/everglade/plan.coax, which the room server doesn't load: keep them alike)
EV_GATE :: [16] f32.[0, -56, 6, 0,   44, 60, 5, 0,   -64, 0, 5, 1,   64, 0, 5, 1];   // EG_GATE: South, North, East, West
EV_BRIDGE :: [5] f32.[84, -18, 92, -5, 0.5];                                       // EG_BRIDGE: its two ends
EV_SQUARE :: [4] f32.[0, 0, 16, 0];                                                 // EG_SQUARE 0: the square by the well

// The dials (spec 8.2), each clamped to its range as it is heard.
EvDials :: struct {
  on: bool; every: int; waves: int = 3; size: int = 12; cult: int = 6; fan: int = 1; wl: int = 3; wlmax: int = 3;
  gates: int = 31; arch: bool = true; aggr: int = 2; harm: bool = true; reward: int = 100; minutes: int = 15;
  start: int; stop: int; levels: bool; cap: int = 2;
}
RmEvents :: struct {
  d: EvDials;
  known: bool;                  // the API has answered once (until then, nothing starts)
  start_seen: int; stop_seen: int;
  slot: int = -1;               // the schedule's period last started (wall ms / EVERY minutes)
  levels: bool;                 // the levels switch as the rooms last applied it
  cap: int = 2;                 // and the cap
}
EvRoom :: struct {
  kind: int; phase: int; until: int;   // until: the tick the phase ends
  wave: int; ends: int;                // ends: the tick the time limit runs out
  standing: int; slain: int; outcome: int; arch: int; wards: int; folk: int;
  square: int;                         // who holds the square: 0 the town, else the cult's ticks in it
  earned: [EG_SEATS] bool;             // the seats that earned XP in this event
  xp: [EG_SEATS] int; level: [EG_SEATS] int;   // level: the one its character is built at (0 Everglade's own)
  demo: [EG_SEATS] bool;               // an admin asked for Everglade's own character (EV_DEMO_FLAG)
  g: [EV_G] u8; g_n: int; g_h: int; g_tick: int = -1;
  heard_g: [EG_SEATS] int;             // the g hash each seat last heard (0 none)
  heard_v: [EG_SEATS * EG_SEATS] int;  // each seat's view of each seat's v: LEVEL * 10^7 + XP + 1 (0 none)
  // the raid's (everglade5e-room-raid.coax has its creatures)
  pending: int;                        // raiders of this wave still to come (EV_STANDING_MAX stand at once)
  sent: int;                           // raiders sent so far: their mix and their gates count on from it
  number: [RS_NPCS] int;               // each stat block's count, for the names ("Cultist 12")
  mix: [RS_NPCS] int;                  // this wave's of each
  hurt: [E5RR_BEASTS] int;             // each raid creature: the seats (bit s) that hurt it
  down: [EG_SEATS] int;                // each seat: the seconds it has lain dead (ev_rise)
}

// ---- the dials, from the API

ev_clamp :: (v: int, a: int, b: int) -> int { return ifx v < a then a else (ifx v > b then b else v); }
// One line of room-control's answer (room-control.coax rm_control hands each one here).
ev_control_line :: (v: [] RmServer, line: string) {
  if line.count > 7 && line[0..<7] == "levels " {
    on := rc_word(line, 7);
    v[0].evc.d.levels = on == "1";
    if line.count > 8 + on.count { c := rc_num(line[8 + on.count..<line.count]); if c > 0 { v[0].evc.d.cap = ev_clamp(c, 1, EV_LEVEL_TOP); } }
    return;
  }
  if line.count < 7 || line[0..<6] != "event " { return; }
  f: [16] int; n := 0; at := 6;
  while at < line.count && n < 16 {
    w := rc_word(line, at);
    x := rc_num(w);
    if x < 0 { return; }
    f[n] = x; n += 1; at += w.count + 1;
  }
  if n != 16 { return; }
  d := v[0].evc.d;
  d.on = f[0] == 1;
  d.every = ifx f[1] == 0 then 0 else ev_clamp(f[1], 15, 240);
  d.waves = ev_clamp(f[2], 1, 8); d.size = ev_clamp(f[3], 4, 24);
  d.cult = ev_clamp(f[4], 0, 10); d.fan = ev_clamp(f[5], 0, 10); d.wl = ev_clamp(f[6], 0, 10);
  if d.cult + d.fan + d.wl == 0 { d.cult = 1; }
  d.wlmax = ev_clamp(f[7], 1, 3); d.gates = ev_clamp(f[8], 1, 31);
  d.arch = f[9] == 1; d.aggr = ev_clamp(f[10], 0, 3); d.harm = f[11] == 1;
  d.reward = ev_clamp(f[12], 50, 300); d.minutes = ev_clamp(f[13], 5, 30);
  d.start = f[14]; d.stop = f[15];
  v[0].evc.d.on = d.on; v[0].evc.d.every = d.every; v[0].evc.d.waves = d.waves; v[0].evc.d.size = d.size;
  v[0].evc.d.cult = d.cult; v[0].evc.d.fan = d.fan; v[0].evc.d.wl = d.wl; v[0].evc.d.wlmax = d.wlmax;
  v[0].evc.d.gates = d.gates; v[0].evc.d.arch = d.arch; v[0].evc.d.aggr = d.aggr; v[0].evc.d.harm = d.harm;
  v[0].evc.d.reward = d.reward; v[0].evc.d.minutes = d.minutes; v[0].evc.d.start = d.start; v[0].evc.d.stop = d.stop;
}
// After a whole answer: a new press of START or STOP acts in every live room; the first answer only
// learns the counts (a shard that restarts doesn't replay a press). The levels switch, changed, is
// applied to every seat.
ev_control_done :: (v: [] RmServer) {
  d := v[0].evc.d;
  if !v[0].evc.known {
    v[0].evc.known = true; v[0].evc.start_seen = d.start; v[0].evc.stop_seen = d.stop;
  } else {
    if d.stop != v[0].evc.stop_seen {
      v[0].evc.stop_seen = d.stop;
      for k: 0..<EG_ROOMS { if v[0].eg[k].live { ev_stop(v, k); } }
    }
    if d.start != v[0].evc.start_seen {
      v[0].evc.start_seen = d.start;
      if d.on { for k: 0..<EG_ROOMS { if v[0].eg[k].live { ev_start(v, k); } } }
    }
  }
  if d.levels != v[0].evc.levels || d.cap != v[0].evc.cap {
    v[0].evc.levels = d.levels; v[0].evc.cap = d.cap;
    for k: 0..<EG_ROOMS {
      if !v[0].eg[k].live { continue; }
      for s: 0..<EG_SEATS { if v[0].eg[k].seat[s].live { ev_build(v, k, s); } }
    }
  }
}

// ---- levels and XP

// The level XP gives, up to the cap (1 to EV_LEVEL_TOP).
ev_level_of :: (xp: int, cap: int) -> int { l := ifx xp >= EV_XP3 then 3 else (ifx xp >= EV_XP2 then 2 else 1); return ev_clamp(l, 1, ev_clamp(cap, 1, EV_LEVEL_TOP)); }
ev_level :: (v: [] RmServer, xp: int) -> int { return ev_level_of(xp, v[0].evc.d.cap); }

// ---- the kits: what a character has at each level, as bar slots (SRD 5.2.1, the classes' tables)
//
// Druid (p. 42): level 1 Spellcasting (2 cantrips, 4 prepared spells, two 1st-level slots), Druidic
// (a language: nothing on a bar) and Primal Order, taken as Magician (one more cantrip); level 2
// Wild Shape (2 uses) and Wild Companion (the engine counts the uses; their bar entry waits on the
// room's forms, #12733), 5 prepared spells and three 1st-level slots; level 3 the Druid Circle (the
// Circle of the Land's Land's Aid, in the engine), 6 prepared and two 2nd-level slots.
//   cantrips: Produce Flame, Starry Wisp, Ray of Frost
//   prepared: Healing Word, Thunderwave, Entangle, Ice Knife; at 2 Faerie Fire; at 3 Moonbeam
// Fiend Warlock (p. 70): level 1 Pact Magic (one 1st-level slot), 2 cantrips, 2 prepared spells and
// one Eldritch Invocation, Armor of Shadows (the engine's rs_warlock: AC 13 + Dex); level 2 two more
// invocations, Agonizing Blast and Repelling Blast on Eldritch Blast, Magical Cunning and two slots;
// level 3 the Fiend Patron's Dark One's Blessing and 2nd-level slots.
//   cantrips: Eldritch Blast and Chill Touch; prepared: Hex, and Hellish Rebuke (a Reaction to
//   damage: the engine casts it, rs_hellish_rebuke, so it has no bar slot)
// The rebuild and NEXT ROW are the realm's, not a class's: every kit has them.
EV_DRUID_CANTRIPS :: [3] int.[21, 22, 43];
EV_DRUID_L1 :: [4] int.[28, 9, 26, 13];
EV_DRUID_L2 :: 27; EV_DRUID_L3 :: 20;
EV_REALM_SLOTS :: [2] int.[47, 48];
EV_WL_BLAST :: 0; EV_WL_REBUILD :: 6; EV_WL_CHILL :: 7; EV_WL_HEX :: 8;   // fivebar.coax fb_warlock_bar's order
// The bar slots a character has at `level` (0: Everglade's own, the whole bar): LO the druid's, HI the Warlock's.
EvKit :: struct { lo: int; hi: int; }
ev_kit :: (warlock: bool, level: int) -> EvKit {
  if level <= 0 { return EvKit.{}; }
  if warlock {
    return EvKit.{hi = (1 << EV_WL_BLAST) | (1 << EV_WL_REBUILD) | (1 << EV_WL_CHILL) | (1 << EV_WL_HEX)};
  }
  lo := 0;
  for q: EV_DRUID_CANTRIPS { lo = lo | (1 << q); }
  for q: EV_DRUID_L1 { lo = lo | (1 << q); }
  for q: EV_REALM_SLOTS { lo = lo | (1 << q); }
  if level >= 2 { lo = lo | (1 << EV_DRUID_L2); }
  if level >= 3 { lo = lo | (1 << EV_DRUID_L3); }
  return EvKit.{lo = lo};
}
ev_kit_has :: (kit: EvKit, slot: int) -> bool {
  if kit.lo == 0 && kit.hi == 0 { return true; }
  if slot >= FB_WL0 { q := slot - FB_WL0; return q < 62 && (kit.hi & (1 << q)) != 0; }
  return slot >= 0 && slot < 62 && (kit.lo & (1 << slot)) != 0;
}
// Seat s's character as the levels switch says: the SRD class at its XP's level, or Everglade's own
// (level 0). Its Hit Points carry over (full stays full; a level gained adds its Hit Points).
ev_build :: (v: [] RmServer, k: int, s: int) {
  demo := v[0].ev[k].demo[s] && eg_ticket(v, k, s).admin;
  want := ifx v[0].evc.d.levels && !demo then ev_level(v, v[0].ev[k].xp[s]) else 0;
  if want == v[0].ev[k].level[s] { return; }
  b := v[0].eg[k].rules[0].b[..];
  i := E5RR_SEAT + s;
  c := b[0].c[i];
  wl := v[0].eg[k].rules[0].klass[s] == 1;
  n: [1] RsCreature;
  if want == 0 { n[0] = ifx wl then fb_warlock_hero("Player", 0) else fb_everglade_hero("Player", 0); }
  else if wl { n[0] = rs_warlock("Player", 0, want, SP_ELDRITCH_BLAST); n[0].rebuke = true; }
  else { n[0] = rs_druid("Player", 0, want); }
  n[0].turn_at = c.turn_at; n[0].round_at = c.round_at; n[0].x = c.x; n[0].y = c.y;
  up := want > v[0].ev[k].level[s] && v[0].ev[k].level[s] > 0;
  if c.dead || c.hp <= 0 { n[0].hp = 0; n[0].dead = c.dead; }
  else if c.hp >= c.hp_max { n[0].hp = n[0].hp_max; }
  else if up { n[0].hp = rs_min(c.hp + n[0].hp_max - c.hp_max, n[0].hp_max); }
  else { n[0].hp = rs_max(rs_min(c.hp, n[0].hp_max), 1); }
  b[0].c[i] = n[0];
  v[0].ev[k].level[s] = want;
}
// Whether seat s's character has bar slot `slot` (entry a) in its kit, and a spell slot for it.
ev_may_cast :: (v: [] RmServer, k: int, s: int, slot: int, a: FbAb) -> bool {
  lv := v[0].ev[k].level[s];
  if lv == 0 { return true; }
  if !ev_kit_has(ev_kit(v[0].eg[k].rules[0].klass[s] == 1, lv), slot) { return false; }
  if a.kind != FB_SPELL || a.lvl <= 0 { return true; }
  c := v[0].eg[k].rules[0].b[0].c[E5RR_SEAT + s];
  for l: a.lvl..<10 { if c.slots_max[l] > 0 { return true; } }
  return false;
}
// Seat s's hello (room-everglade.coax eg_heard_hello): whether it asks for the demo character.
ev_hello :: (v: [] RmServer, k: int, s: int, flags: int) {
  demo := (flags & EV_DEMO_FLAG) != 0;
  if demo == v[0].ev[k].demo[s] { return; }
  v[0].ev[k].demo[s] = demo;
  ev_build(v, k, s);
}
// XP for seat s (times the reward dial), its gain heard by everyone near it, a level-up by everyone.
ev_award :: (v: [] RmServer, k: int, s: int, base: int) {
  if base <= 0 || s < 0 || s >= EG_SEATS || !v[0].eg[k].seat[s].live { return; }
  amount := rs_max(base * v[0].evc.d.reward / 100, 1);
  was := ev_level(v, v[0].ev[k].xp[s]);
  v[0].ev[k].xp[s] = rs_min(v[0].ev[k].xp[s] + amount, EV_XP_MAX);
  v[0].ev[k].earned[s] = true;
  p := v[0].eg[k].seat[s].pose;
  b: [64] u8;
  n := wire_int(b[..], wire_int(b[..], wire_put(b[..], 0, "e xp"), s), amount);
  eg_event(v, k, cast(string) b[0..<n], p.x, p.z, false);
  now := ev_level(v, v[0].ev[k].xp[s]);
  if now > was {
    n = wire_int(b[..], wire_int(b[..], wire_put(b[..], 0, "e level"), s), now);
    eg_event(v, k, cast(string) b[0..<n], p.x, p.z, true);
    ev_build(v, k, s);
  }
}

// ---- the seats

// A new room in slot k: no event, no XP.
ev_fresh :: (v: [] RmServer, k: int) {
  if k < 0 || k >= EG_ROOMS { return; }
  v[0].ev[k] = EvRoom.{};
}
// Seat s sat (after its HP came back, rv_join): its XP from this server's note or its ticket, and
// its character at its level.
ev_join :: (v: [] RmServer, k: int, s: int) {
  v[0].ev[k].xp[s] = 0; v[0].ev[k].level[s] = 0; v[0].ev[k].earned[s] = false; v[0].ev[k].demo[s] = false;
  for q: 0..<EG_SEATS { v[0].ev[k].heard_v[q * EG_SEATS + s] = 0; v[0].ev[k].heard_v[s * EG_SEATS + q] = 0; }
  v[0].ev[k].heard_g[s] = 0;
  tk := eg_ticket(v, k, s);
  if tk.ok {
    xp := tk.xp;
    i := rv_find(v, cast(string) tk.pid[0..<tk.pid_n]);
    if i >= 0 && v[0].vit.v[i].xp > xp { xp = v[0].vit.v[i].xp; }
    v[0].ev[k].xp[s] = ev_clamp(xp, 0, EV_XP_MAX);
  }
  hp := v[0].eg[k].rules[0].b[0].c[E5RR_SEAT + s].hp;
  ev_build(v, k, s);
  // a returning player's HP is theirs at the new level too (rv_join set it on Everglade's own)
  if tk.ok && tk.hp > 0 { b := v[0].eg[k].rules[0].b[..]; b[0].c[E5RR_SEAT + s].hp = rs_min(hp, b[0].c[E5RR_SEAT + s].hp_max); }
}
// Seat s's class changed (its hello's CLASS: e5rr_join_as built Everglade's own): built at its level again.
ev_class :: (v: [] RmServer, k: int, s: int) { v[0].ev[k].level[s] = 0; ev_build(v, k, s); }
ev_xp_of :: (v: [] RmServer, k: int, s: int) -> int { return ifx k >= 0 && k < EG_ROOMS && s >= 0 && s < EG_SEATS then v[0].ev[k].xp[s] else 0; }

// ---- the lifecycle

ev_secs :: (n: int) -> int { return n * EG_HZ; }
ev_phase :: (v: [] RmServer, k: int, phase: int, secs: int) {
  v[0].ev[k].phase = phase;
  v[0].ev[k].until = v[0].eg[k].tick + ev_secs(secs);
}
// A raid starts in room k now (one already running goes on).
ev_start :: (v: [] RmServer, k: int) {
  e := v[0].ev[k..<k + 1];
  if e[0].phase != EV_IDLE { return; }
  e[0].kind = EV_RAID; e[0].wave = 0; e[0].standing = 0; e[0].slain = 0; e[0].outcome = EV_OUT_NONE;
  e[0].arch = EV_ARCH_AWAY; e[0].wards = 0; e[0].square = 0;
  for s: 0..<EG_SEATS { e[0].earned[s] = false; }
  e[0].ends = v[0].eg[k].tick + ev_secs(v[0].evc.d.minutes * 60);
  ev_phase(v, k, EV_ANNOUNCE, EV_ANNOUNCE_S);
}
// An admin's STOP: called off, the raiders gone, no bonus.
ev_stop :: (v: [] RmServer, k: int) {
  e := v[0].ev[k..<k + 1];
  if e[0].phase == EV_IDLE || e[0].phase == EV_END || e[0].phase == EV_AFTER { return; }
  ev_raid_clear(v, k);
  ev_end(v, k, EV_OUT_OFF);
}
ev_end :: (v: [] RmServer, k: int, outcome: int) {
  e := v[0].ev[k..<k + 1];
  e[0].outcome = outcome;
  // the raiders that fell this tick first: a town that falls still pays for its last kills
  ev_raid_downs(v, k);
  award := ifx outcome == EV_OUT_HELD then EV_XP_HELD else (ifx outcome == EV_OUT_FELL then EV_XP_FELL else 0);
  if award > 0 { for s: 0..<EG_SEATS { if e[0].earned[s] { ev_award(v, k, s, award); } } }
  ev_phase(v, k, EV_END, EV_END_S);
}
// The town's people standing (of those the world has out of doors and in the rules).
ev_folk_up :: (v: [] RmServer, k: int) -> int {
  b := v[0].eg[k].rules[0].b[..];
  up := 0;
  for j: 0..<E5R_FOLK {
    c := b[0].c[E5RR_FOLK0 + j];
    if c.hp_max > 0 && !c.dead && c.hp > 0 { up += 1; }
  }
  return up;
}
ev_folk_known :: (v: [] RmServer, k: int) -> bool {
  b := v[0].eg[k].rules[0].b[..];
  for j: 0..<E5R_FOLK { if b[0].c[E5RR_FOLK0 + j].hp_max > 0 && b[0].c[E5RR_FOLK0 + j].x != E5R_AWAY { return true; } }
  return false;
}
// The server's own rebuild at the aftermath's end (spec 7): as R does, without R's waits.
ev_rebuild :: (v: [] RmServer, k: int) {
  v[0].eg[k].rebuild = true;
  v[0].eg[k].rebuilt_at = v[0].eg[k].tick;
  e5rr_folk_restore(v[0].eg[k].rules[..]);
  e5rr_zombies_clear(v[0].eg[k].rules[..]);
  e5rd_wall_whole(v[0].eg[k].rules[..]);   // the palisade whole: the raid's breaches shut
  for q: 0..<EG_PIECES { v[0].eg[k].broken[q] = false; v[0].eg[k].burning[q] = false; }
  b: [32] u8;
  eg_event(v, k, cast(string) b[0..<wire_put_rebuilt(b[..], 0)], 0, 0, true);
}

// Room k's tick (rm_eg_end, before the seats hear it): the schedule, the phase, then the g entry.
ev_tick :: (v: [] RmServer, k: int) {
  if k < 0 || k >= EG_ROOMS || !v[0].eg[k].live { return; }
  e := v[0].ev[k..<k + 1];
  d := v[0].evc.d;
  t := v[0].eg[k].tick;
  // the schedule: each whole multiple of EVERY minutes on the wall clock (checked once a second)
  if t % EG_HZ == 0 && v[0].evc.known && d.on && d.every > 0 {
    slot := v[0].wall_ms / (d.every * 60000);
    if v[0].evc.slot < 0 { v[0].evc.slot = slot; }
    if slot != v[0].evc.slot {
      v[0].evc.slot = slot;
      for q: 0..<EG_ROOMS { if v[0].eg[q].live { ev_start(v, q); } }
    }
  }
  if t % EG_HZ == 0 { ev_rise(v, k); }
  if e[0].phase != EV_IDLE {
    if t % EG_HZ == 0 { ev_second(v, k); }
    if t >= e[0].until { ev_next(v, k); }
  }
  ev_raid_step(v, k);
  ev_cache(v, k);
}
// Once a second: a player down (dead, or at 0 Hit Points) EV_RISE_S stands again where they fell, with all their Hit Points
// (as a page on its own stands you up after YOU DIED). Without it a death in a room lasted until
// the player left, and a raid's fallen were out of it for good.
ev_rise :: (v: [] RmServer, k: int) {
  e := v[0].ev[k..<k + 1];
  b := v[0].eg[k].rules[0].b[..];
  for s: 0..<EG_SEATS {
    i := E5RR_SEAT + s;
    if !v[0].eg[k].seat[s].live || !v[0].eg[k].rules[0].live[s] || (!b[0].c[i].dead && b[0].c[i].hp > 0) { e[0].down[s] = 0; continue; }
    e[0].down[s] += 1;
    if e[0].down[s] < EV_RISE_S { continue; }
    e[0].down[s] = 0;
    b[0].c[i].hp = b[0].c[i].hp_max; b[0].c[i].temp = 0; b[0].c[i].dead = false; b[0].c[i].cond = 0;
    b[0].c[i].death_ok = 0; b[0].c[i].death_fail = 0; b[0].c[i].stable = false;
  }
}
// Once a second while an event runs: what it counts, and the ends that come early.
ev_second :: (v: [] RmServer, k: int) {
  e := v[0].ev[k..<k + 1];
  e[0].standing = ev_raid_standing(v, k);
  e[0].folk = ev_folk_up(v, k);
  p := e[0].phase;
  if p != EV_WAVE && p != EV_LULL && p != EV_CLIMAX { return; }
  if e[0].kind == EV_RAID { ev_raid_square(v, k); }
  if ev_folk_known(v, k) && e[0].folk == 0 { ev_raid_clear(v, k); ev_end(v, k, EV_OUT_FELL); return; }
  if e[0].square >= ev_secs(60) { ev_raid_clear(v, k); ev_end(v, k, EV_OUT_FELL); return; }
  if v[0].eg[k].tick >= e[0].ends { ev_raid_clear(v, k); ev_end(v, k, ifx e[0].square > 0 then EV_OUT_FELL else EV_OUT_HELD); return; }
  // a wave that is down ends early: the lull comes at once
  if p == EV_WAVE && e[0].standing == 0 { e[0].until = v[0].eg[k].tick; }
  if p == EV_CLIMAX && e[0].arch == EV_ARCH_GONE { ev_end(v, k, EV_OUT_HELD); }
}
// The phase is over: the next one.
ev_next :: (v: [] RmServer, k: int) {
  e := v[0].ev[k..<k + 1];
  d := v[0].evc.d;
  p := e[0].phase;
  if p == EV_ANNOUNCE || p == EV_LULL {
    e[0].wave += 1;
    ev_phase(v, k, EV_WAVE, EV_WAVE_S);
    ev_raid_wave(v, k);
    e[0].standing = ev_raid_standing(v, k);
    return;
  }
  if p == EV_WAVE {
    if e[0].wave < d.waves { ev_phase(v, k, EV_LULL, EV_LULL_S); return; }
    if d.arch { ev_phase(v, k, EV_CLIMAX, EV_CLIMAX_S); ev_raid_arch(v, k); return; }
    // no leader: the town held once the last wave is down (it fights on until it is)
    if e[0].standing == 0 { ev_end(v, k, EV_OUT_HELD); } else { e[0].until = v[0].eg[k].tick + EG_HZ; }
    return;
  }
  // the climax's time up: Darian Odiodei withdraws, and the town held (the square, lost, already ended it: ev_second)
  if p == EV_CLIMAX { ev_raid_withdraw(v, k); ev_end(v, k, EV_OUT_HELD); return; }
  if p == EV_END { ev_raid_flee(v, k); ev_phase(v, k, EV_AFTER, EV_AFTER_S); return; }
  if p == EV_AFTER {
    ev_raid_clear(v, k);
    ev_rebuild(v, k);
    e[0].phase = EV_IDLE; e[0].kind = EV_NONE;
    return;
  }
}

// ---- the raid's content: the waves, the ward stones and the leader as creatures of the room's
// battle (apps/openagents-web/everglade5e-room-raid.coax), the XP for each that falls.

ev_rules :: (v: [] RmServer, k: int) -> [] E5rRoom { return v[0].eg[k].rules[..]; }
// Gate g (0 to EV_GATES): where it is (the way in), and where a raider through it comes from.
ev_gate :: (g: int, out: [] f32) {
  if g >= 4 {
    // the river bridge (plan.coax EG_BRIDGE): its town end, and 12 m past its far end
    nx := EV_BRIDGE[0]; nz := EV_BRIDGE[1]; fx := EV_BRIDGE[2]; fz := EV_BRIDGE[3];
    dx := fx - nx; dz := fz - nz; d := sqrt(dx * dx + dz * dz);
    out[0] = nx; out[1] = nz; out[2] = fx + dx / d * 12; out[3] = fz + dz / d * 12;
    return;
  }
  gx := EV_GATE[g * 4]; gz := EV_GATE[g * 4 + 1];
  d := sqrt(gx * gx + gz * gz);
  out[0] = gx; out[1] = gz; out[2] = gx + gx / d * f32(EV_OUT_M); out[3] = gz + gz / d * f32(EV_OUT_M);
}
// Gate g's way in for the raid's tactics (everglade-raid-tactics.coax): a gate in the palisade
// (plan.coax EG_PALISADE: the south and north walls run x -64 to 64, the east and west z -56 to 60), or
// the bridge, with no wall.
ev_way :: (g: int) -> RtGate {
  p: [4] f32;
  ev_gate(g, p[..]);
  if g >= 4 { dx := p[2] - p[0]; dz := p[3] - p[1]; d := sqrt(dx * dx + dz * dz); return rt_open(p[0], p[1], dx / d, dz / d); }
  along_z := EV_GATE[g * 4 + 3] > 0.5;
  return rt_gate(p[0], p[1], EV_GATE[g * 4 + 2], along_z, ifx along_z then -56.0f32 else -64.0f32, ifx along_z then 60.0f32 else 64.0f32, EV_SQUARE[0], EV_SQUARE[1]);
}
// The n-th gate of those the dial picked (any of them, in turn).
ev_gate_of :: (v: [] RmServer, n: int) -> int {
  bits := v[0].evc.d.gates;
  on := 0; for g: 0..<EV_GATES { if (bits & (1 << g)) != 0 { on += 1; } }
  if on == 0 { return n % EV_GATES; }
  m := n % on;
  for g: 0..<EV_GATES { if (bits & (1 << g)) != 0 { if m == 0 { return g; } m -= 1; } }
  return 0;
}
ev_jitter :: (v: [] RmServer, k: int, m: f32) -> f32 { return f32(rs_roll(v[0].eg[k].rules[0].b[0].dice[..], 2001) - 1001) / 1000.0 * m; }
// The raid creature whose beast id is id: its place among the beasts, -1 none.
ev_slot_of :: (v: [] RmServer, k: int, id: int) -> int {
  if id <= 0 { return -1; }
  for q: 0..<E5RR_BEASTS { if v[0].eg[k].rules[0].beasts[q].tag == id { return q; } }
  return -1;
}
// The next raider of the wave: its stat block by the dials' parts (each the most behind its share),
// its gate in turn (groups of up to 8), a little apart outside it.
ev_raid_one :: (v: [] RmServer, k: int) -> bool {
  e := v[0].ev[k..<k + 1];
  d := v[0].evc.d;
  kinds := [3] int.[RS_NPC_CULTIST, RS_NPC_FANATIC, RS_NPC_WARLOCK];
  // this wave's mix and its Warlocks' top level (apps/openagents-web/everglade-raid-scale.coax)
  parts: [3] int;
  raid_wave_parts(d.cult, d.fan, d.wl, e[0].wave, d.waves, parts[..]);
  wlmax := raid_wave_wlmax(d.wlmax, e[0].wave, d.waves);
  total := parts[0] + parts[1] + parts[2];
  made := 0; for c: 0..<3 { made += e[0].mix[kinds[c]]; }
  npc := RS_NPC_CULTIST; lag := -1000000;
  for c: 0..<3 {
    if parts[c] <= 0 { continue; }
    l := parts[c] * (made + 1) - e[0].mix[kinds[c]] * total;
    if l > lag { lag = l; npc = kinds[c]; }
  }
  level := 1;
  if npc == RS_NPC_WARLOCK { level = 1 + e[0].number[RS_NPC_WARLOCK] % wlmax; }
  g: [4] f32;
  gate := ev_gate_of(v, e[0].sent / 8);
  ev_gate(gate, g[..]);
  // across the road from it, two deep, clear of the players' spawn
  ox := g[2] - g[0]; oz := g[3] - g[1]; od := sqrt(ox * ox + oz * oz); ox /= od; oz /= od;
  side := f32(e[0].sent % 8) - 3.5;
  p: [2] f32;
  rt_clear(g[2] + oz * side * 1.4 + ox * f32((e[0].sent % 8) / 4) * 1.6 + ev_jitter(v, k, 0.4),
           g[3] - ox * side * 1.4 + oz * f32((e[0].sent % 8) / 4) * 1.6 + ev_jitter(v, k, 0.4),
           f32(E5RD_SPAWN_X), f32(E5RD_SPAWN_Z), f32(RT_SPAWN_R) + 2, p[..]);
  x := p[0]; z := p[1];
  // its way in (a gate in the wall, or the bridge: no wall), its squad, and its own place about the square
  way := ev_way(gate);
  rt_ring(e[0].sent, EV_SQUARE[0], EV_SQUARE[1], 3, f32(EV_SQUARE_R) - 3, p[..]);
  id := e5rd_raider(ev_rules(v, k), npc, level, e[0].number[npc] + 1, x, z, way, e[0].sent / RT_SQUAD, e[0].sent % RT_SQUAD, p[0], p[1]);
  if id <= 0 { return false; }
  q := ev_slot_of(v, k, id);
  if q >= 0 { e[0].hurt[q] = 0; }
  e[0].number[npc] += 1; e[0].mix[npc] += 1; e[0].sent += 1;
  return true;
}
// The wave's raiders come: as many as stand room for, the rest as others fall.
ev_raid_spawn :: (v: [] RmServer, k: int) {
  e := v[0].ev[k..<k + 1];
  while e[0].pending > 0 && e5rd_standing(ev_rules(v, k)) < EV_STANDING_MAX {
    if !ev_raid_one(v, k) { return; }
    e[0].pending -= 1;
  }
}
ev_raid_wave :: (v: [] RmServer, k: int) {
  e := v[0].ev[k..<k + 1];
  for n: 0..<RS_NPCS { e[0].mix[n] = 0; }
  e[0].pending += raid_wave_size(v[0].evc.d.size, ev_players(v, k));   // the SIZE dial for the players here
  ev_raid_spawn(v, k);
}
// The climax: three ward stones raised just inside three of the gates, and Darian Odiodei at the
// first, holding behind his lines.
ev_raid_arch :: (v: [] RmServer, k: int) {
  e := v[0].ev[k..<k + 1];
  r := ev_rules(v, k);
  g: [4] f32;
  wards := 0;
  for n: 0..<3 {
    ev_gate(ev_gate_of(v, n) % 4, g[..]);   // a stone stands at a gate in the wall (the bridge's go to the wall's)
    ix := -g[0]; iz := -g[1]; d := sqrt(ix * ix + iz * iz);
    if e5rd_ward(r, g[0] + ix / d * 6 + f32(n) * 0.01, g[1] + iz / d * 6) > 0 { wards += 1; }
  }
  // Darian at the first gate, coming from outside it; with none of his lines left he holds 10 m inside it
  ev_gate(ev_gate_of(v, 0), g[..]);
  ex := g[0] - EV_SQUARE[0]; ez := g[1] - EV_SQUARE[1]; ed := sqrt(ex * ex + ez * ez);
  p: [2] f32;
  rt_clear(g[2], g[3], f32(E5RD_SPAWN_X), f32(E5RD_SPAWN_Z), f32(RT_SPAWN_R) + 2, p[..]);
  id := e5rd_arch(r, p[0], p[1], g[0], g[1], g[0] - ex / ed * 10, g[1] - ez / ed * 10);
  e[0].wards = wards;
  e[0].arch = ifx id <= 0 then EV_ARCH_GONE else (ifx wards > 0 then EV_ARCH_WARDED else EV_ARCH_EXPOSED);
  if id > 0 && wards == 0 { e5rd_expose(r); }
}
ev_raid_withdraw :: (v: [] RmServer, k: int) {
  if v[0].ev[k].arch != EV_ARCH_AWAY && v[0].ev[k].arch != EV_ARCH_GONE { _ := e5rd_withdraw(ev_rules(v, k)); }
  if v[0].ev[k].arch != EV_ARCH_AWAY { v[0].ev[k].arch = EV_ARCH_GONE; }
}
ev_raid_flee :: (v: [] RmServer, k: int) { v[0].ev[k].pending = 0; e5rd_flee(ev_rules(v, k)); if v[0].ev[k].arch != EV_ARCH_AWAY { v[0].ev[k].arch = EV_ARCH_GONE; } }
ev_raid_clear :: (v: [] RmServer, k: int) { ev_raid_downs(v, k); v[0].ev[k].pending = 0; e5rd_clear(ev_rules(v, k)); }
// The raid creatures that fell since the last step: their XP to the seats that hurt them.
ev_raid_downs :: (v: [] RmServer, k: int) {
  r := ev_rules(v, k);
  w := r[0].raid[..];
  for c: 0..<w[0].down_n { ev_fell(v, k, w[0].downs[c]); }
  w[0].down_n = 0;
}
// The players in room k now.
ev_players :: (v: [] RmServer, k: int) -> int {
  n := 0;
  for s: 0..<EG_SEATS { if v[0].eg[k].seat[s].live { n += 1; } }
  return n;
}
// The raiders standing, and those of the wave still to come.
ev_raid_standing :: (v: [] RmServer, k: int) -> int { return e5rd_standing(ev_rules(v, k)) + v[0].ev[k].pending; }
// The square's second (spec 3.3): the cult holds it while more of it stand there than the town, each
// player there counting EV_SQUARE_PLAYER and each townsperson one.
ev_raid_square :: (v: [] RmServer, k: int) {
  e := v[0].ev[k..<k + 1];
  r := ev_rules(v, k);
  cult := e5rd_in(r, EV_SQUARE[0], EV_SQUARE[1], f32(EV_SQUARE_R), false);
  town := e5rd_in(r, EV_SQUARE[0], EV_SQUARE[1], f32(EV_SQUARE_R), true) * EV_SQUARE_PLAYER;
  b := r[0].b[..];
  for j: 0..<E5R_FOLK {
    i := E5RR_FOLK0 + j;
    if !e5rd_up(r, i) { continue; }
    dx := r[0].folk_x[j] - EV_SQUARE[0]; dz := r[0].folk_z[j] - EV_SQUARE[1];
    if dx * dx + dz * dz <= f32(EV_SQUARE_R) * f32(EV_SQUARE_R) { town += 1; }
  }
  if cult > town { e[0].square += EG_HZ; } else { e[0].square = 0; }
}
// The engine's event (room-everglade.coax eg_engine_events): a seat's harm to a raid creature, or its
// summons', is that seat's share of its XP.
ev_engine :: (v: [] RmServer, k: int, kind: int, by: int, who: int) {
  if kind != RS_EV_DAMAGE || who <= E5RR_TGT_BEAST || v[0].ev[k].phase == EV_IDLE { return; }
  q := ev_slot_of(v, k, who - E5RR_TGT_BEAST);
  if q < 0 || v[0].eg[k].rules[0].beasts[q].form < E5RR_FORM_RAID { return; }
  s := -1;
  if by >= EG_TGT_SEAT && by < EG_TGT_SEAT + EG_SEATS { s = by - EG_TGT_SEAT; }
  else if by > E5RR_TGT_BEAST {
    o := ev_slot_of(v, k, by - E5RR_TGT_BEAST);
    if o >= 0 { s = v[0].eg[k].rules[0].beasts[o].by; }
  }
  if s >= 0 && s < EG_SEATS { v[0].ev[k].hurt[q] = v[0].ev[k].hurt[q] | (1 << s); }
}
// A raid creature's XP (EV_XP_*): a warlock's by its level, EV_XP_SRD_X times the SRD's.
ev_xp_for :: (npc: int, level: int) -> int {
  if npc == RS_NPC_CULTIST { return EV_XP_SRD_X * EV_XP_CULTIST; }
  if npc == RS_NPC_FANATIC { return EV_XP_SRD_X * EV_XP_FANATIC; }
  if npc == RS_NPC_WARLOCK { return EV_XP_SRD_X * EV_XP_WARLOCK[ev_clamp(level, 1, 3) - 1]; }
  return EV_XP_SRD_X * EV_XP_WARD;
}
// One fell: its XP split evenly among the seats in the room that hurt it (themselves, or by a
// creature they summoned), however far they stand now and whoever struck last (each at least 1).
ev_fell :: (v: [] RmServer, k: int, dn: E5rdDown) {
  e := v[0].ev[k..<k + 1];
  if dn.npc != 0 { e[0].slain += 1; }
  bits := ifx dn.q >= 0 && dn.q < E5RR_BEASTS then e[0].hurt[dn.q] else 0;
  if dn.q >= 0 && dn.q < E5RR_BEASTS { e[0].hurt[dn.q] = 0; }
  n := 0;
  for s: 0..<EG_SEATS { if (bits & (1 << s)) != 0 && v[0].eg[k].seat[s].live { n += 1; } }
  if n == 0 { return; }
  share := rs_max(ev_xp_for(dn.npc, dn.level) / n, 1);
  for s: 0..<EG_SEATS { if (bits & (1 << s)) != 0 && v[0].eg[k].seat[s].live { ev_award(v, k, s, share); } }
}
// Each tick while the raid runs: what its creatures cast reaches the pages (and the town, when its
// damage dial is on), who fell gets its XP, the wave's rest come, the wards and the leader.
ev_raid_step :: (v: [] RmServer, k: int) {
  e := v[0].ev[k..<k + 1];
  r := ev_rules(v, k);
  w := r[0].raid[..];
  if e[0].phase == EV_IDLE { w[0].cast_n = 0; w[0].down_n = 0; return; }
  d := v[0].evc.d;
  w[0].aggr = d.aggr; w[0].harm = d.harm;
  ev_raid_downs(v, k);
  if v[0].eg[k].tick % EG_HZ == 0 {
    if e[0].phase == EV_WAVE || e[0].phase == EV_LULL || e[0].phase == EV_CLIMAX { ev_raid_spawn(v, k); }
    if e[0].arch == EV_ARCH_WARDED || e[0].arch == EV_ARCH_EXPOSED {
      e[0].wards = e5rd_wards(r);
      if e[0].arch == EV_ARCH_WARDED && e[0].wards == 0 { e[0].arch = EV_ARCH_EXPOSED; e5rd_expose(r); }
      hp: [2] int;
      if !e5rd_arch_hp(r, hp[..]) { e[0].arch = EV_ARCH_GONE; }
      else if e[0].arch == EV_ARCH_EXPOSED && hp[0] * 2 <= hp[1] + 1 { _ := e5rd_withdraw(r); e[0].arch = EV_ARCH_GONE; }
    }
  }
  for c: 0..<w[0].cast_n { ev_raid_cast(v, k, w[0].casts[c]); }
  w[0].cast_n = 0;
  if v[0].eg[k].strike_n + RT_HOUSE_BLASTS <= EG_CASTS && e5rd_house_falls(r) { ev_house_fall(v, k); }   // the next tick when the strikes are full
}
// The stables fall (everglade5e-room-raid.coax e5rd_house_hurt; #12769): RT_HOUSE_BLASTS Fireballs
// across them bring down what still stands in the server's town, and every page hears it break.
ev_house_fall :: (v: [] RmServer, k: int) {
  if !v[0].evc.d.harm { return; }
  r := ev_rules(v, k);
  y := r[0].raid[0].house_y;
  o: [2] f32;
  for n: 0..<RT_HOUSE_BLASTS {
    if v[0].eg[k].strike_n >= EG_CASTS { return; }
    rt_house_blast(n, o[..]);
    seed := rs_roll(r[0].b[0].dice[..], 999983);
    v[0].eg[k].strikes[v[0].eg[k].strike_n] = EgStrike.{by = -1, slot = EG_WL_BLAST + RT_K_FIREBALL, fx = o[0], fy = y + 9, fz = o[1] - 2, ax = o[0], ay = y + 1.5, az = o[1], seed = seed};
    v[0].eg[k].strike_n += 1;
  }
}
// A raid creature's cast: `e rc ID K AX AY AZ SEED` to the pages near it (K the look the page plays,
// everglade-raid-spells.coax RT_K_*), and the strike on the server's town of a spell that harms
// objects: Eldritch Blast, Fire Bolt, Fireball, Lightning Bolt.
ev_raid_cast :: (v: [] RmServer, k: int, c: E5rdCast) {
  q := ev_slot_of(v, k, c.id);
  if q < 0 { return; }
  bt := v[0].eg[k].rules[0].beasts[q];
  ay := bt.y + 1.0;
  if c.to >= E5RR_SEAT && c.to < E5RR_SEAT + EG_SEATS && v[0].eg[k].seat[c.to - E5RR_SEAT].live {
    p := v[0].eg[k].seat[c.to - E5RR_SEAT].pose;
    ay = p.y + 1.0;
  }
  b: [96] u8;
  n := wire_put(b[..], 0, "e rc");
  n = wire_int(b[..], n, c.id); n = wire_int(b[..], n, c.k);
  n = wire_m(b[..], n, c.ax); n = wire_m(b[..], n, ay); n = wire_m(b[..], n, c.az);
  n = wire_int(b[..], n, c.seed);
  eg_event(v, k, cast(string) b[0..<n], bt.x, bt.z, false);
  if v[0].evc.d.harm && (c.k == RT_K_BLAST || c.k == RT_K_FIREBALL || c.k == RT_K_FIRE_BOLT || c.k == RT_K_LIGHTNING) && v[0].eg[k].strike_n < EG_CASTS {
    v[0].eg[k].strikes[v[0].eg[k].strike_n] = EgStrike.{by = -1, slot = EG_WL_BLAST + c.k, fx = bt.x, fy = bt.y + 1.5, fz = bt.z, ax = c.ax, ay = ay, az = c.az, seed = c.seed};
    v[0].eg[k].strike_n += 1;
  }
}
// The wire's F for summoned creature q: a raider's level in its bits 8 and up (the page draws it).
ev_beast_f :: (v: [] RmServer, k: int, q: int) -> int {
  bt := v[0].eg[k].rules[0].beasts[q];
  if bt.form < E5RR_FORM_RAID { return 0; }
  return v[0].eg[k].rules[0].raid[0].slot[q].level << 8;
}
// Whether a raider's move waits this tick: each is sent at most every third tick, in turn (its hits
// and its going are sent as ever: only its moves wait).
ev_beast_wait :: (v: [] RmServer, k: int, q: int) -> bool {
  return v[0].eg[k].rules[0].beasts[q].form >= E5RR_FORM_RAID && (v[0].eg[k].tick + q) % 3 != 0;
}

// ---- what the seats hear

// The seconds the banner counts: the phase's, or (idle) to the next scheduled start (-1 none).
ev_banner_secs :: (v: [] RmServer, k: int) -> int {
  e := v[0].ev[k];
  if e.phase != EV_IDLE { return rs_max((e.until - v[0].eg[k].tick + EG_HZ - 1) / EG_HZ, 0); }
  d := v[0].evc.d;
  if !d.on || d.every <= 0 { return -1; }
  per := d.every * 60000;
  return (per - v[0].wall_ms % per + 999) / 1000;
}
// The g entry, written once a tick for every seat.
ev_cache :: (v: [] RmServer, k: int) {
  e := v[0].ev[k..<k + 1];
  if e[0].g_tick == v[0].eg[k].tick { return; }
  e[0].g_tick = v[0].eg[k].tick;
  d := v[0].evc.d;
  kind := ifx e[0].phase != EV_IDLE then e[0].kind else (ifx d.on && d.every > 0 then EV_RAID else EV_NONE);
  left := ifx e[0].phase == EV_IDLE then 0 else rs_max((e[0].ends - v[0].eg[k].tick + EG_HZ - 1) / EG_HZ, 0);
  b := e[0].g[..];
  n := wire_put(b, 0, "g");
  n = wire_int(b, n, kind); n = wire_int(b, n, e[0].phase); n = wire_int(b, n, e[0].wave); n = wire_int(b, n, d.waves);
  n = wire_int(b, n, ev_banner_secs(v, k)); n = wire_int(b, n, left);
  n = wire_int(b, n, e[0].standing); n = wire_int(b, n, e[0].slain); n = wire_int(b, n, e[0].square / EG_HZ);
  n = wire_int(b, n, e[0].wards); n = wire_int(b, n, e[0].arch); n = wire_int(b, n, e[0].outcome); n = wire_int(b, n, e[0].folk);
  n = wire_int(b, n, ifx d.levels then 1 else 0); n = wire_int(b, n, d.cap);
  n = wire_int(b, n, ev_players(v, k));   // the players the waves are for (the EVENTS pane shows the scale)
  e[0].g_n = n; e[0].g_h = eg_hash(cast(string) b[0..<n]);
}
// Seat s's D (room-everglade.coax eg_send): the g entry and each seat's v, on change.
ev_send :: (v: [] RmServer, k: int, s: int, full: bool, o: [] EgOut) {
  e := v[0].ev[k..<k + 1];
  ev_cache(v, k);
  if full {
    e[0].heard_g[s] = 0;
    for q: 0..<EG_SEATS { e[0].heard_v[s * EG_SEATS + q] = 0; }
  }
  if e[0].heard_g[s] != e[0].g_h { eg_out_entry(o, v, k, s, 0, cast(string) e[0].g[0..<e[0].g_n]); e[0].heard_g[s] = e[0].g_h; }
  b: [96] u8;
  cap := v[0].evc.d.cap;
  for q: 0..<EG_SEATS {
    if !v[0].eg[k].seat[q].live { e[0].heard_v[s * EG_SEATS + q] = 0; continue; }
    lv := ifx e[0].level[q] > 0 then e[0].level[q] else ev_level(v, e[0].xp[q]);
    kit := ev_kit(v[0].eg[k].rules[0].klass[q] == 1, e[0].level[q]);
    h := eg_hash(cast(string) b[0..<wire_int(b[..], wire_int(b[..], wire_int(b[..], wire_int(b[..], wire_int(b[..], 0, lv), e[0].xp[q]), cap), kit.lo), kit.hi)]);
    if e[0].heard_v[s * EG_SEATS + q] == h { continue; }
    n := wire_int(b[..], wire_int(b[..], wire_int(b[..], wire_put(b[..], 0, "v"), q), lv), e[0].xp[q]);
    n = wire_int(b[..], wire_int(b[..], wire_int(b[..], n, cap), kit.lo), kit.hi);
    eg_out_entry(o, v, k, s, 0, cast(string) b[0..<n]);
    e[0].heard_v[s * EG_SEATS + q] = h;
  }
}

// ---- checks

ev_test_server :: (v: [] RmServer) -> int {
  rm_init(v);
  rm_clock(v, 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-events HTTP/1.1\r\n\r\n";
  #assert rm_join(v, 0, ev) == 0 && rm_join(v, 1, ev) == 1;
  k := eg_room_at(v, v[0].conns[0].relay);
  rm_heard(v, 0, "H 1 ranger.0.0.0 druid 0 -");
  rm_heard(v, 1, "H 1 ranger.0.0.0 druid 0 -");
  eg_test_tick(v, k); eg_test_tick(v, k);
  return k;
}
ev_test_ticks :: (v: [] RmServer, k: int, n: int) { for q: 0..<n { eg_test_tick(v, k); } }

#test "events: the dials are heard and clamped; START acts once per press, and not on the first answer" #steps 4000000000 {
  v: [1] RmServer;
  k := ev_test_server(v[..]);
  rm_control(v[..], "pvp 0\nevent 1 0 99 2 6 1 3 7 31 1 9 1 1000 2 4 0\nlevels 0\n");
  d := v[0].evc.d;
  #assert d.on && d.waves == 8 && d.size == 4 && d.wlmax == 3 && d.aggr == 3 && d.reward == 300 && d.minutes == 5 && d.start == 4;
  #assert v[0].ev[k].phase == EV_IDLE;   // the first answer learns the count
  rm_control(v[..], "event 1 0 3 12 6 1 3 3 31 1 2 1 100 15 5 0\n");
  #assert v[0].ev[k].phase == EV_ANNOUNCE && v[0].ev[k].kind == EV_RAID;
  rm_control(v[..], "event 1 0 3 12 6 1 3 3 31 1 2 1 100 15 5 0\n");
  #assert v[0].ev[k].phase == EV_ANNOUNCE;
  // a malformed line changes nothing
  rm_control(v[..], "event 1 0 3 x 6 1 3 3 31 1 2 1 100 15 5 0\n");
  #assert v[0].evc.d.size == 12;
}

// The phase's end, now: one tick (the room's ticks are cheap, the checks' interpreter is not).
ev_test_skip :: (v: [] RmServer, k: int) { v[0].ev[k].until = v[0].eg[k].tick + 1; ev_test_ticks(v, k, 1); }
// To the next whole second, where the event counts.
ev_test_second :: (v: [] RmServer, k: int) { while v[0].eg[k].tick % EG_HZ != EG_HZ - 1 { eg_test_tick(v, k); } eg_test_tick(v, k); }

// Seat s strikes raid creature q down where it stands, a metre from the seat (the engine's damage event,
// then the damage, as a cast's roll does).
ev_test_strike :: (v: [] RmServer, k: int, s: int, q: int, amount: int) {
  r := v[0].eg[k].rules[..];
  b := r[0].b[..];
  i := E5RR_BEAST0 + q;
  p := v[0].eg[k].seat[s].pose;
  r[0].beasts[q].x = p.x + 1; r[0].beasts[q].z = p.z;
  b[0].c[i].x = e5r_sq(p.x + 1); b[0].c[i].y = e5r_sq(p.z);
  l: [1] RsLine;
  rs_tell(b, RS_EV_DAMAGE, -1, E5RR_SEAT + s, i, amount, RS_FORCE, l[..]);
  rs_damage(b, E5RR_SEAT + s, i, amount, RS_FORCE, false, -1);
}
// Every raider standing (not the stones, not the leader), struck down by seat s.
ev_test_rout :: (v: [] RmServer, k: int, s: int) {
  r := v[0].eg[k].rules[..];
  for q: 0..<E5RR_BEASTS {
    f := r[0].beasts[q].form;
    if e5rd_is(r[0].beasts[q]) && f != E5RR_FORM_WARD && f != E5RR_FORM_RAID + RS_NPC_ARCH { ev_test_strike(v, k, s, q, 999); }
  }
}
ev_test_count :: (v: [] RmServer, k: int, form: int) -> int {
  n := 0;
  for q: 0..<E5RR_BEASTS { if e5rd_is(v[0].eg[k].rules[0].beasts[q]) && (form < 0 || v[0].eg[k].rules[0].beasts[q].form == form) { n += 1; } }
  return n;
}

#test "events: a raid's waves come by the gates and fall for XP; Darian behind his wards can't be hurt, then withdraws; the town held" #steps 16000000000 {
  v: [1] RmServer;
  box: [1] EgInbox;
  k := ev_test_server(v[..]);
  // two waves of 24 at 5 players (10 for these 2): 6 Cultists, 1 Fanatic, 3 Warlocks in parts by the
  // last wave, levels 1 to 3; all gates; the leader on
  rm_control(v[..], "event 1 0 2 24 6 1 3 3 31 1 2 1 100 15 0 0\n");
  rm_control(v[..], "event 1 0 2 24 6 1 3 3 31 1 2 1 100 15 1 0\n");
  #assert v[0].ev[k].until == v[0].eg[k].tick + ev_secs(EV_ANNOUNCE_S);
  eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 0), ";g 1 1 0 2 30 900 ") && eg_test_has(eg_test_of(box[..], 1), ";g 1 1 0 2 ");
  ev_test_skip(v[..], k);
  #assert v[0].ev[k].phase == EV_WAVE && v[0].ev[k].wave == 1;
  m := raid_wave_size(24, 2);
  #assert m == 12 && ev_raid_standing(v[..], k) == m && ev_test_count(v[..], k, -1) == m;
  // the first wave: no Fanatic yet, one Warlock part in 7, all at level 1 (everglade-raid-scale.coax)
  pt: [3] int; ct: [3] int;
  raid_wave_parts(6, 1, 3, 1, 2, pt[..]); raid_wave_counts(m, pt[..], ct[..]);
  #assert v[0].ev[k].mix[RS_NPC_CULTIST] == ct[0] && v[0].ev[k].mix[RS_NPC_FANATIC] == 0 && v[0].ev[k].mix[RS_NPC_WARLOCK] == ct[2] && ct[2] >= 1;
  lv := 0; for q: 0..<E5RR_BEASTS { if e5rd_is(v[0].eg[k].rules[0].beasts[q]) && v[0].eg[k].rules[0].raid[0].slot[q].level > lv { lv = v[0].eg[k].rules[0].raid[0].slot[q].level; } }
  #assert lv == 1;
  // each outside a gate, a long way from the square
  r := v[0].eg[k].rules[..];
  far := 0;
  was: [E5RR_BEASTS] f32;
  for q: 0..<E5RR_BEASTS { bt := r[0].beasts[q]; was[q] = sqrt(bt.x * bt.x + bt.z * bt.z); if e5rd_is(bt) && was[q] > 60 { far += 1; } }
  #assert far == m;
  // they march to their own places in their squads' siege lines outside the wall
  // (everglade-raid-tactics.coax): in a few seconds every one is there, none in the spawn's clear ground
  ev_test_ticks(v[..], k, 4 * EG_HZ);
  near := 0;
  for q: 0..<E5RR_BEASTS {
    bt := r[0].beasts[q];
    if !e5rd_is(bt) { continue; }
    sl := r[0].raid[0].slot[q];
    o: [2] f32;
    rt_siege_pos(sl.g, sl.squad, sl.k, sl.role, o[..]);
    if (bt.x - o[0]) * (bt.x - o[0]) + (bt.z - o[1]) * (bt.z - o[1]) < 4 * 4 { near += 1; }
    sx := bt.x - f32(E5RD_SPAWN_X); sz := bt.z - f32(E5RD_SPAWN_Z);
    #assert sx * sx + sz * sz >= f32(RT_SPAWN_R) * f32(RT_SPAWN_R);
  }
  #assert near == m;
  // a raider the page sees: a beast entry with its look (P1 27 a Cultist) and its level in F
  q0 := -1;
  for q: 0..<E5RR_BEASTS { if q0 < 0 && r[0].beasts[q].form == E5RR_FORM_RAID + RS_NPC_CULTIST { q0 = q; } }
  e5rr_beast_ground(r, q0, 0);
  ev_test_strike(v[..], k, 0, q0, 1);   // a metre from seat 0
  eg_test_drain(v[..], box[..]);
  ev_test_ticks(v[..], k, 3);
  eg_test_drain(v[..], box[..]);
  bc: [48] u8; bn := wire_put(bc[..], 0, ";c"); bn = wire_int(bc[..], bn, r[0].beasts[q0].id);
  #assert eg_test_has(eg_test_of(box[..], 0), cast(string) bc[0..<bn]);
  // seat 0 cuts the wave down: twice the SRD's 25 XP a Cultist, 450 the Fanatic, 50, 100 or 200 a Warlock by its level
  want := 0;
  for q: 0..<E5RR_BEASTS { bt := r[0].beasts[q]; if e5rd_is(bt) { want += ev_xp_for(r[0].raid[0].slot[q].npc, r[0].raid[0].slot[q].level); } }
  ev_test_rout(v[..], k, 0);
  eg_test_tick(v[..], k);
  #assert v[0].ev[k].slain == m && v[0].ev[k].xp[0] == want && v[0].ev[k].xp[1] == 0;
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 0), "e xp 0 50");
  ev_test_second(v[..], k); eg_test_tick(v[..], k);   // the wave is down: the lull comes at once
  #assert v[0].ev[k].phase == EV_LULL && v[0].ev[k].until > v[0].eg[k].tick + ev_secs(EV_LULL_S) - 3;
  ev_test_skip(v[..], k);
  #assert v[0].ev[k].phase == EV_WAVE && v[0].ev[k].wave == 2 && ev_raid_standing(v[..], k) == m;
  // both seats fight this wave: each raider hit by both, so each seat gets half of its XP
  had0 := v[0].ev[k].xp[0]; had1 := v[0].ev[k].xp[1];
  want = 0;
  for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) { want += ev_xp_for(r[0].raid[0].slot[q].npc, r[0].raid[0].slot[q].level) / 2; ev_test_strike(v[..], k, 1, q, 1); } }
  ev_test_rout(v[..], k, 0);
  eg_test_tick(v[..], k);
  #assert v[0].ev[k].slain == 2 * m && v[0].ev[k].xp[0] - had0 == want && v[0].ev[k].xp[1] - had1 == want;
  ev_test_second(v[..], k); eg_test_tick(v[..], k);
  // the climax: three ward stones and Darian Odiodei, warded
  #assert v[0].ev[k].phase == EV_CLIMAX && v[0].ev[k].arch == EV_ARCH_WARDED && v[0].ev[k].wards == 3;
  #assert ev_test_count(v[..], k, E5RR_FORM_WARD) == 3 && ev_test_count(v[..], k, E5RR_FORM_RAID + RS_NPC_ARCH) == 1;
  hp: [2] int;
  da := r[0].raid[0].arch;
  ev_test_strike(v[..], k, 0, da, 400);
  #assert e5rd_arch_hp(r, hp[..]) && hp[0] == hp[1];
  // the stones broken: exposed, worth 100 XP each
  had0 = v[0].ev[k].xp[0];
  for q: 0..<E5RR_BEASTS { if e5rd_is(r[0].beasts[q]) && r[0].beasts[q].form == E5RR_FORM_WARD { ev_test_strike(v[..], k, 0, q, 60); } }
  ev_test_second(v[..], k);
  #assert v[0].ev[k].arch == EV_ARCH_EXPOSED && v[0].ev[k].wards == 0 && v[0].ev[k].xp[0] == had0 + 3 * EV_XP_SRD_X * EV_XP_WARD;
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 1), ";g 1 4 2 2 ");
  // a hit past half leaves him at half, and he withdraws (never among the slain)
  ev_test_strike(v[..], k, 0, da, 400);
  #assert e5rd_arch_hp(r, hp[..]) && hp[0] == hp[1] / 2;
  ev_test_second(v[..], k);
  #assert v[0].ev[k].arch == EV_ARCH_GONE && ev_test_count(v[..], k, E5RR_FORM_RAID + RS_NPC_ARCH) == 0 && v[0].ev[k].slain == 2 * m;
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 0), "e rc ");   // his Dimension Door, for the pages
  had0 = v[0].ev[k].xp[0];
  ev_test_second(v[..], k);
  #assert v[0].ev[k].phase == EV_END && v[0].ev[k].outcome == EV_OUT_HELD && v[0].ev[k].xp[0] == had0 + EV_XP_HELD;
  ev_test_skip(v[..], k);
  #assert v[0].ev[k].phase == EV_AFTER && v[0].ev[k].until > v[0].eg[k].tick + ev_secs(EV_AFTER_S) - 3;
  eg_test_drain(v[..], box[..]);
  ev_test_skip(v[..], k);
  eg_test_drain(v[..], box[..]);
  #assert v[0].ev[k].phase == EV_IDLE && ev_test_count(v[..], k, -1) == 0 && eg_test_has(eg_test_of(box[..], 0), "e rebuild") && eg_test_has(eg_test_of(box[..], 1), ";g 0 0 ");
}

#test "events: an assist shares a raider's XP, however far the seat stands and whoever struck last; a town that falls pays EV_XP_FELL and its last kills" #steps 16000000000 {
  v: [1] RmServer;
  box: [1] EgInbox;
  k := ev_test_server(v[..]);
  rm_control(v[..], "event 1 0 2 24 6 1 3 3 31 1 2 1 100 15 0 0\n");
  rm_control(v[..], "event 1 0 2 24 6 1 3 3 31 1 2 1 100 15 1 0\n");
  ev_test_skip(v[..], k);
  #assert v[0].ev[k].phase == EV_WAVE;
  r := v[0].eg[k].rules[..];
  q0 := -1;
  for q: 0..<E5RR_BEASTS { if q0 < 0 && r[0].beasts[q].form == E5RR_FORM_RAID + RS_NPC_CULTIST { q0 = q; } }
  // seat 1 lands a hit and walks 200 m off (a ranged caster far back); seat 0 strikes it down
  ev_test_strike(v[..], k, 1, q0, 1);
  eg_test_tick(v[..], k);
  v[0].eg[k].seat[1].pose.x += 200;
  ev_test_strike(v[..], k, 0, q0, 999);
  eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  half := EV_XP_SRD_X * EV_XP_CULTIST / 2;
  #assert v[0].ev[k].xp[0] == half && v[0].ev[k].xp[1] == half;
  #assert eg_test_has(eg_test_of(box[..], 1), "e xp 1 25");
  // a raider struck down in the tick the town falls still pays, and then the fall's award
  q1 := -1;
  for q: 0..<E5RR_BEASTS { if q1 < 0 && r[0].beasts[q].form == E5RR_FORM_RAID + RS_NPC_CULTIST && e5rd_is(r[0].beasts[q]) { q1 = q; } }
  had0 := v[0].ev[k].xp[0];
  ev_test_strike(v[..], k, 0, q1, 999);
  e5rr_beasts_check(r); eg_engine_events(v[..], k);    // it falls in the rules, its hit heard,
  ev_raid_clear(v[..], k); ev_end(v[..], k, EV_OUT_FELL);   // and the town falls before the raid's step (ev_second)
  #assert v[0].ev[k].phase == EV_END && v[0].ev[k].outcome == EV_OUT_FELL;
  #assert v[0].ev[k].xp[0] == had0 + EV_XP_SRD_X * EV_XP_CULTIST + EV_XP_FELL;
  #assert v[0].ev[k].xp[1] == half + EV_XP_FELL;
}

#test "events: a fallen player stands again whole after EV_RISE_S, where they fell" #steps 4000000000 {
  v: [1] RmServer;
  k := ev_test_server(v[..]);
  b := v[0].eg[k].rules[0].b[..];
  i := E5RR_SEAT;
  b[0].c[i].hp = 0; b[0].c[i].dead = true; b[0].c[i].death_fail = 3;
  for n: 0..<EV_RISE_S - 1 { ev_rise(v[..], k); }
  #assert b[0].c[i].dead;
  ev_rise(v[..], k);
  #assert !b[0].c[i].dead && b[0].c[i].hp == b[0].c[i].hp_max && b[0].c[i].death_fail == 0;
}

#test "events: the time limit and STOP end a raid; STOP pays no bonus" #steps 8000000000 {
  v: [1] RmServer;
  k := ev_test_server(v[..]);
  rm_control(v[..], "event 1 0 8 12 6 1 3 3 31 0 2 1 100 5 0 0\n");
  rm_control(v[..], "event 1 0 8 12 6 1 3 3 31 0 2 1 100 5 1 0\n");
  #assert v[0].ev[k].ends == v[0].eg[k].tick + ev_secs(5 * 60);
  ev_test_skip(v[..], k);
  v[0].ev[k].earned[0] = true;
  v[0].ev[k].ends = v[0].eg[k].tick;   // the time limit is out
  ev_test_second(v[..], k);
  #assert v[0].ev[k].phase == EV_END && v[0].ev[k].outcome == EV_OUT_HELD && v[0].ev[k].xp[0] == EV_XP_HELD;
  ev_test_skip(v[..], k); ev_test_skip(v[..], k);
  #assert v[0].ev[k].phase == EV_IDLE;
  rm_control(v[..], "event 1 0 8 12 6 1 3 3 31 0 2 1 100 5 2 0\n");
  #assert v[0].ev[k].phase == EV_ANNOUNCE;
  v[0].ev[k].earned[1] = true;
  rm_control(v[..], "event 1 0 8 12 6 1 3 3 31 0 2 1 100 5 2 1\n");
  #assert v[0].ev[k].phase == EV_END && v[0].ev[k].outcome == EV_OUT_OFF && v[0].ev[k].xp[1] == 0;
}

#test "events: the schedule starts every live room at a whole multiple of EVERY on the wall clock" #steps 8000000000 {
  v: [1] RmServer;
  k := ev_test_server(v[..]);
  rm_control(v[..], "event 1 15 3 12 6 1 3 3 31 1 2 1 100 15 0 0\n");
  per := 15 * 60000;
  rm_clock(v[..], 0, (1762190000000 / per + 1) * per - 1500);
  ev_test_second(v[..], k);
  #assert v[0].ev[k].phase == EV_IDLE;
  rm_clock(v[..], 0, (1762190000000 / per + 1) * per + 10);
  ev_test_second(v[..], k);
  #assert v[0].ev[k].phase == EV_ANNOUNCE;
}

#test "events: XP levels a seat at 300 and no further than the cap (2, then 3 at 900), times the reward dial; the SRD class at its level with its kit only" #steps 8000000000 {
  v: [1] RmServer;
  box: [1] EgInbox;
  k := ev_test_server(v[..]);
  rm_control(v[..], "event 0 0 3 12 6 1 3 3 31 1 2 1 200 15 0 0\nlevels 1 2\n");
  b := v[0].eg[k].rules[0].b[..];
  #assert v[0].ev[k].level[0] == 1 && b[0].c[0].level == 1 && b[0].c[0].hp_max == 9 && b[0].c[0].slots_max[1] == 2;
  // outside the level 1 kit: Moonbeam (a 2nd-level spell) and Meteor Swarm; in it: Healing Word
  rm_heard(v[..], 0, "C 1 20 300 0 0 -1");
  rm_heard(v[..], 0, "C 2 0 300 0 0 -1");
  rm_heard(v[..], 0, "C 3 28 0 0 0 1000");
  eg_test_drain(v[..], box[..]);
  a := eg_test_of(box[..], 0);
  #assert eg_test_has(a, "r 1 level") && eg_test_has(a, "r 2 level") && !eg_test_has(a, "r 3 ");
  ev_award(v[..], k, 0, 150);   // 300 at 200%
  eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  #assert v[0].ev[k].xp[0] == 300 && v[0].ev[k].level[0] == 2 && b[0].c[0].level == 2 && b[0].c[0].hp_max == 15 && b[0].c[0].slots_max[1] == 3;
  #assert eg_test_has(eg_test_of(box[..], 0), "e xp 0 300") && eg_test_has(eg_test_of(box[..], 1), "e level 0 2") && eg_test_has(eg_test_of(box[..], 1), "v 0 2 300 2 ");
  #assert ev_kit_has(ev_kit(false, 2), 27) && !ev_kit_has(ev_kit(false, 1), 27) && !ev_kit_has(ev_kit(false, 2), 20);
  // the cap is 2: XP past it is kept and gives nothing
  ev_award(v[..], k, 0, 5000);
  #assert v[0].ev[k].level[0] == 2 && v[0].ev[k].xp[0] == 10300;
  // the cap raised to 3: the seat is level 3 at once, with Moonbeam
  rm_control(v[..], "levels 1 3\n");
  #assert v[0].ev[k].level[0] == 3 && b[0].c[0].slots_max[2] == 2;
  ev_test_ticks(v[..], k, EG_CAST_GAP + 1);
  eg_test_drain(v[..], box[..]);
  rm_heard(v[..], 0, "C 4 20 300 0 0 -1");
  eg_test_drain(v[..], box[..]);
  #assert !eg_test_has(eg_test_of(box[..], 0), "r 4 level") && ev_level_of(EV_XP_MAX, 9) == EV_LEVEL_TOP;
  // a Warlock at level 1: Eldritch Blast, not Fireball
  rm_heard(v[..], 1, "H 1 ranger.0.0.0 warlock 0 -");
  #assert v[0].ev[k].level[1] == 1 && b[0].c[1].klass == RS_WARLOCK && b[0].c[1].level == 1 && b[0].c[1].hp_max == 9;
  rm_heard(v[..], 1, "C 5 65 300 0 0 -1");
  ev_test_ticks(v[..], k, EG_CAST_GAP + 1);
  rm_heard(v[..], 1, "C 6 71 300 0 0 -1");   // Chill Touch: in the level 1 kit
  ev_test_ticks(v[..], k, EG_CAST_GAP + 1);
  rm_heard(v[..], 1, "C 7 72 300 0 0 -1");   // Hex: the same
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 1), "r 5 level") && !eg_test_has(eg_test_of(box[..], 1), "r 6 level") && !eg_test_has(eg_test_of(box[..], 1), "r 7 level");
  #assert b[0].c[1].rebuke;   // Hellish Rebuke, prepared: the engine casts it as a Reaction
  // the demo character is an admin's only: a guest's FLAGS bit asks for nothing
  rm_heard(v[..], 1, "H 1 ranger.0.0.0 warlock 64 -");
  #assert v[0].ev[k].level[1] == 1;
  // levels off: Everglade's own druid again, its XP kept
  rm_control(v[..], "levels 0 3\n");
  #assert v[0].ev[k].level[0] == 0 && b[0].c[0].level == FB_EG_LEVEL && v[0].ev[k].xp[0] == 10300;
}

#test "events: an admin's ticket (ACCT 2) and the demo bit give Everglade's own level 17 Warlock while levels are on" #steps 4000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  rm_control(v[..], "levels 1 2\n");
  t: [256] u8; r: [512] u8;
  m := tk_sign_admin(key, "p-0011223344556677", "pair-tk", now + 60000, t[..]);
  #assert m > 0 && rm_join(v[..], 0, tk_test_ask(r[..], t[..], m)) == 0 && v[0].conns[0].ticket.admin && v[0].conns[0].ticket.account;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 1 ranger.0.0.0 warlock 64 -");
  b := v[0].eg[k].rules[0].b[..];
  #assert v[0].ev[k].level[0] == 0 && b[0].c[0].level == FB_WL_LEVEL;
  rm_heard(v[..], 0, "H 1 ranger.0.0.0 warlock 0 -");
  #assert v[0].ev[k].level[0] == 1 && b[0].c[0].level == 1;
}

#test "events: a ticket brings XP back (HPxXP), an old ticket means 0 XP, and the vitals post carries it" #steps 4000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  #assert tk_check(key, "", "r", now).xp == 0;
  t: [256] u8; r: [512] u8;
  n := tk_sign_xp(key, "p-0011223344556677", false, "", "pair-tk", 0, now + 60000, -1, 420, t[..]);
  #assert eg_test_has(cast(string) t[0..<n], ".-x420.");
  #assert rm_join(v[..], 0, tk_test_ask(r[..], t[..], n)) == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  #assert v[0].ev[k].xp[0] == 420;
  n = tk_sign_xp(key, "p-8899aabbccddeeff", false, "", "pair-tk", 0, now + 60000, 7, 0, t[..]);
  #assert rm_join(v[..], 1, tk_test_ask(r[..], t[..], n)) == 1 && v[0].conns[1].ticket.hp == 7 && v[0].ev[k].xp[1] == 0;
  n = tk_sign(key, "p-0123012301230123", false, "", "pair-tk", now + 60000, 5, t[..]);
  #assert tk_check(key, cast(string) t[0..<n], "pair-tk", now).ok && tk_check(key, cast(string) t[0..<n], "pair-tk", now).xp == 0;
  ev_award(v[..], k, 0, 30);
  rm_left(v[..], 0);
  #assert rm_vitals_due(v[..]) > 0;
  #assert eg_test_has(cast(string) v[0].vit.out[0..<v[0].vit.out_n], " 450\n");
}

#test "events: the stables' fall brings the rest down in the server's town once, and a rebuild stands them up (#12769)" #steps 8000000000 {
  v: [1] RmServer;
  k := ev_test_server(v[..]);
  rm_control(v[..], "event 1 0 2 24 6 1 3 3 31 1 2 1 100 15 0 0\n");
  rm_control(v[..], "event 1 0 2 24 6 1 3 3 31 1 2 1 100 15 1 0\n");
  eg_test_tick(v[..], k);
  ev_test_skip(v[..], k);
  #assert v[0].ev[k].phase == EV_WAVE;
  r := v[0].eg[k].rules[..];
  // a piece of them broken in the town takes from them; their fall comes from the raid's bolts
  e5rd_wall_broke(r, 14, -70);
  #assert r[0].raid[0].house == RT_HOUSE_PIECE && e5rd_house_stage(r) == RT_HOUSE_WHOLE;
  for n: 0..<3 { e5rd_house_hurt(r, RT_HOUSE_HP); }   // a blow takes them a stage on at most
  #assert e5rd_house_stage(r) == RT_HOUSE_FALLEN;
  v[0].eg[k].strike_n = 0;
  ev_raid_step(v[..], k);
  // RT_HOUSE_BLASTS Fireballs across them, each in them, by no seat
  #assert v[0].eg[k].strike_n == RT_HOUSE_BLASTS;
  for q: 0..<RT_HOUSE_BLASTS {
    st := v[0].eg[k].strikes[q];
    #assert st.by == -1 && st.slot == EG_WL_BLAST + RT_K_FIREBALL && rt_house_has(st.ax, st.az);
  }
  // once: the next tick strikes nothing more of theirs, and more hurt doesn't fall them again
  v[0].eg[k].strike_n = 0;
  e5rd_house_hurt(r, 10);
  ev_raid_step(v[..], k);
  #assert v[0].eg[k].strike_n == 0;
  // the aftermath's rebuild stands them up
  ev_rebuild(v[..], k);
  #assert e5rd_house_stage(r) == RT_HOUSE_WHOLE && r[0].raid[0].house == 0;
}
