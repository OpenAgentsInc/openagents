// The room server's Everglade rooms: the server is the authority (spec
// docs/verse/2026-11-03-everglade-multiplayer-spec.md sections 3.1 and 3.6; GitHub #12705).
// An everglade relay room (room-relay.coax, game "everglade") relays nothing: its seats' frames are
// intents for the room's simulation here, which runs at EG_HZ, and each seat hears the world from it.
// The frames are apps/openagents-web/everglade-wire.coax's (version 3), read and written by its code,
// which the page #loads too:
//   in:  H 3 LOOK CLASS FLAGS NAME   I SEQ KX KY PX PY THETA B HEARD   C SEQ SLOT AX AY AZ TGT
//        E SEQ KIND ID (KIND 5: end what slot ID holds up)   R SEQ   (t MS, the relay's)
//   out: W TICK HZ SEED DAY WEATHER BUDGET   D TICK ACK F PART E;E;...   r SEQ REASON
// D's entries: s (every entity's state, the wire's one replication model: eg_table fills the room's
// table each tick, wire_seat_frame cuts each seat's rows from it), x ID (one gone from your view),
// n (who a seat is, on change), and the events near you (e cast, e hit, e heal, e die, e rebuild).
//
// Each tick: every seat's queued inputs are stepped, one controller step of 1/EG_HZ s each, as many
// as its page's clock has earned (EG_BANK: the steps of time it may be owed, EG_TICK_STEPS at most a
// tick), by the shared movement step on the room's Everglade world
// (everglade-step.coax, everglade-move.coax: the page predicts with the same calls). That step
// lives in other C units, so the host runs it: rm_eg_input hands it a seat's next input and
// rm_eg_moved takes the state back. Then casts that strike now are rolled by the SRD 5e engine
// (apps/openagents-web/everglade5e-room-rules.coax: one battle for the 16 seats), the engine's
// clock moves on, and each tick each seat gets its D frame.

EG_BEHIND :: 4096;        // bytes waiting on a seat's socket at a tick's start past which its rows wait that tick
// book:begin room-size
EG_ROOMS :: 16;                 // simulated rooms at once (256 players)
EG_SEATS :: 16;
EG_HZ :: 30;
// book:end room-size
// A D frame every tick (30 Hz). At every 2 ticks (15 Hz), an input stepped on the odd tick waited a
// tick for its ACK, up to 66 ms on top of the round trip (#12731); the table every seat's rows are cut
// from is filled once a tick (eg_table).
EG_SEND :: 1;
EG_INPUTS :: 16;                // inputs queued a seat; past it the oldest go
EG_IN_FIELDS :: 7;              // SEQ KX KY PX PY THETA B: what rm_eg_input hands the host (HEARD is the wire's: wire_seat_ack)
// A seat earns a step for each 1/EG_HZ s of the server's clock since it sat (not a step a tick: a tick
// that ran late or a beat the host started again cost the seat nothing, so its page's one input a
// step is stepped as fast as it comes and no queue stands; a step a tick let a raid's slow ticks fall
// behind the pages' 30 a second, the queue filled to its 16 and input-to-ACK stood at 528 ms, #12718)
// and spends one an input. What it is owed is kept up to EG_BANK (half a
// second), so a page that stalled (a busy browser runs 2 to 4 steps in one frame, then none) spends
// the steps when they come, at most EG_TICK_STEPS a tick: a page can't move faster than the tick over
// time, nor more than 4 steps at once. With the old bank of 4, every stall over 4 steps lost its time
// for good, and the inputs after it waited in the queue a tick each from then on: the queue grew to
// its 8, about 270 ms of input-to-ACK, and past that the oldest went (the page had stepped them; the
// server's word snapped you back) (#12731).
EG_BANK :: 15;
EG_TICK_STEPS :: 4;
EG_KEEP :: 4;                   // ticks of input a seat may hold past what it may step now (rm_eg_begin)
EG_JOIN_BANK :: 3;              // what a seat that just sat is owed (its first tick's step on top)
EG_VIEW :: 120.0;               // m: what a seat hears of creatures, zones and events
EG_CHUNK :: 3740;               // a D frame's entries at most (WIRE_SERVER_FRAME with its header); past it, F 2
EG_CASTS :: 32;                 // casts heard and on their way, from the press to the strike (room-casts.coax)
EG_CAST_GAP :: 8;               // ticks between a seat's casts at least (about 4 a second)
EG_NAME :: 24; EG_LOOK :: 32;
EG_EVENTS :: 96; EG_EV_BYTES :: 6144;
EG_TGT_SEAT :: 1000;            // TGT codes (spec 3.6): 1000 + SS a seat, 2000 + EID a creature
// the bar slots that make the wire's creature kinds (everglade-wire.coax WK_*): SP_SLOTS (4) + the
// ability (everglade-abilities.coax AB_*, everglade-circle.coax)
EG_SLOT_STONE :: 10; EG_SLOT_TENTACLES :: 12; EG_SLOT_CONJURE :: 32; EG_SLOT_THORNS :: 36;
EG_SP_SLOTS :: 4;
// the Warlock's slots that the world plays (fivebar.coax FB_WL0 + k): Eldritch Blast, Fireball, Dimension Door
EG_WL_BLAST :: 64; EG_WL_FIREBALL :: 65; EG_WL_DOOR :: 69;
EG_FOLK_FLOATS :: 7;            // a townsperson as the world hands them (everglade-watch.coax EG_ROOM_VIEW_FLOATS)
EG_CRIMES :: 16;
EG_REBUILD_QUIET :: 10; EG_REBUILD_EVERY :: 30;   // s: R stands the town up once no spell struck it for 10 s, once in 30 s at most
EG_PIECES :: 6000;              // the town's pieces at most: verse/demolish.coax DEMO_PIECES, which wave 1 raised (the bridge's are past 4000)
EG_ENT :: 192;                  // bytes of one cached n entry (eg_table) at most
// the table's slots (everglade-wire.coax WIRE_SLOTS): the seats' players, the townsfolk, the summoned
// creatures, the rules' zones, then the world's abilities' entities as they come and go
EG_SLOT_FOLK :: EG_SEATS; EG_SLOT_BEAST :: EG_SLOT_FOLK + E5R_FOLK; EG_SLOT_ZONE :: EG_SLOT_BEAST + E5RR_BEASTS;
// (the watch's effects on the seats take slots of the same EG_SLOT_AB pool, fx_slot)
EG_SLOT_AB :: EG_SLOT_ZONE + E5RR_ZONES; EG_SLOT_ABS :: WIRE_SLOTS - EG_SLOT_AB;
EG_FX_ID :: 950000;              // a watch effect's id: WIRE_ID_MADE + EG_FX_ID + SS * WE_WATCH + cause

EgIn :: struct { seq: int; kx: int; ky: int; px: int; py: int; theta: int; b: int; at: int; }   // theta in WIRE_FINE units; at: mono ms it was heard (room-stats.coax)
EgPose :: struct { x: f32; y: f32; z: f32; yaw: f32; vx: f32; vy: f32; vz: f32; g: int; clip: int; carry: int; }
EgSeat :: struct {
  live: bool; conn: int = -1;
  q: [EG_INPUTS] EgIn; q_n: int; bank: int; took: int; ack: int;   // took: inputs stepped this tick
  sat_ms: int = -1; earned: int;   // the server's clock when it sat (mono ms), and the steps of time earned since
  late: int;                       // inputs gone for coming faster than the clock (EG_KEEP)
  pose: EgPose; placed: bool;    // placed: the host has put it in the world (rm_eg_moved)
  back: bool; back_x: f32; back_y: f32; back_z: f32; back_yaw: f32;   // where its player stood in this room (rv_back)
  look: [EG_LOOK] u8; look_n: int; klass: [EG_NAME] u8; klass_n: int; flags: int; name: [EG_NAME] u8; name_n: int;
  last_cast: int = -1000;
  repaired: int = -100000;       // the tick of its last Repair (CR_REPAIR_EVERY from one to the next)
  heard_ms: int;                 // when its page last sent a frame (G's AWAY bit after WIRE_AWAY_MS)
  heard_n: [EG_SEATS] int;                            // a hash of who it last heard each seat is (0 nothing)
  heard_w: [EG_SEATS] int;                            // the WANTED level it last heard of each seat, plus 1 (0 nothing)
  rep: [1] WireSeat;                                  // what its page holds of the table (everglade-wire.coax)
  // its n and w entries of each seat: the tick each last went out, the ticks it went out in (a bit
  // each, as WireSeat's sent), and whether a tick its page heard held it
  n_t: [EG_SEATS] int; n_bits: [EG_SEATS] int; n_ok: [EG_SEATS] bool;
  w_t: [EG_SEATS] int; w_bits: [EG_SEATS] int; w_ok: [EG_SEATS] bool;
  // its D's are snapshots (F 1: the page forgets everything first) from its first, until its page
  // says it heard one (full_t: the first's tick); the town's broken pieces go with the first (pieces)
  full: bool; full_t: int; pieces: bool;
  old: bool;                                          // a page from before wire 3: its state on the old wire (room-oldwire.coax)
  fresh: bool;                                        // just sat: the world's watch meets a new player
  want_seed: int;                                     // the WANTED level it comes back with, for the world's town (rv_join; 0 none)
  wcond: int;                                         // the world's conditions on it (WC_*), with the rules' in p's COND
  fx_left: [WE_WATCH] f32; fx_t0: [WE_WATCH] int; fx_dur: [WE_WATCH] int;   // its watch effects (WE_*): seconds left, start tick, ticks
  step_at: int; ack_at: int; ack_told: int;           // when the input stepped last and the one ACK names were heard (room-stats.coax rm_st_ack)
}
// A cast from its hearing to its strike (room-casts.coax, #12790): its phase (RC_*), the ticks it was
// heard, started, is released and strikes at, the order it was heard in, and its line of sight's
// question this tick and answer (0 none, 1 clear, 2 blocked).
EgCast :: struct {
  on: bool; seat: int; slot: int; x: f32; y: f32; z: f32; tgt: int; due: int;
  seq: int; mode: int; phase: int; heard: int; start: int; release: int; order: int; helps: bool; seed: int;
  ask: int = -1; sight: int;
  hp0: int; mx: f32; mz: f32;   // a Repair's: its caster's HP and feet at its start (hurt or moved, it stops)
}
EgRoom :: struct {
  stale_n: int;        // hellos refused for another WIRE_VERSION (#12788)
  old_n: int;          // seats on the old wire, its window open (room-oldwire.coax)
  behind_n: int;       // seat ticks whose rows waited, its socket behind
  live: bool; relay: int = -1;
  tick: int; seed: int;
  ev_dropped: int;               // events a tick had no room for (EG_EVENTS, EG_EV_BYTES), since the host last asked
  sky: int;                      // the weather its seats last heard, as W has it (room-sky.coax)
  seat: [EG_SEATS] EgSeat;
  casts: [EG_CASTS] EgCast; cast_order: int;
  hurts: [EG_HURTS] EgHurt; hurt_n: int;   // the world's harm to seats this tick, dealt after the heals (room-casts.coax)
  rules: [1] E5rRoom;
  // the events since the last D, as entry text, each with where it happened
  ev: [EG_EV_BYTES] u8; ev_bytes: int; ev_n: int;
  ev_at: [EG_EVENTS] int; ev_len: [EG_EVENTS] int; ev_x: [EG_EVENTS] f32; ev_z: [EG_EVENTS] f32; ev_all: [EG_EVENTS] bool;
  // the town, as the host's world steps it (everglade-watch.coax everglade_room_town): each person as a
  // page hears them (EG_FOLK_FLOATS: X Z YAW CLIP MODE HP SHOWN), each seat's WANTED level
  folk: [E5R_FOLK * EG_FOLK_FLOATS] f32; folk_on: bool;
  wanted: [EG_SEATS] int;
  // the harm seats did the town since the world last heard (a crime each), and who last harmed each person
  crimes: [EG_CRIMES] EgCrime; crime_n: int;
  folk_by: [E5R_FOLK] int;
  // the town's pieces: Everglade's four spells' strikes for the world (it breaks and burns the pieces),
  // the rebuild asked for, and what is broken and burning now (a seat's snapshot names them)
  strikes: [EG_CASTS] EgStrike; strike_n: int;
  rebuild: bool;
  broke_at: int = -100000; rebuilt_at: int = -100000;   // the ticks of the last spell on the town and the last rebuild (R's rules)
  fresh: bool;                   // a new room in this slot: the world's town starts whole
  broken: [EG_PIECES] bool; burning: [EG_PIECES] bool;
  // an admin's placed things (verse/everglade/edits.coax, by their index): alight, burnt and broken apart
  placed_burn: [CR_PLACED_MAX] bool; placed_gone: [CR_PLACED_MAX] bool;
  // every entity's state this tick, filled once (eg_table) for every seat's rows to be cut from, and
  // each player's n entry with its hash
  cache_tick: int = -1;
  hist: [1] WireHist;
  ab_slot: [EG_SEATS * RA_ABS] int;   // the table slot each seat's ability's entity has, + 1 (0 none)
  fx_slot: [EG_SEATS * WE_WATCH] int;  // and each seat's watch effect's (SS * WE_WATCH + cause), from the same pool
  cn: [EG_SEATS * EG_ENT] u8; cn_n: [EG_SEATS] int; cn_h: [EG_SEATS] int;
  // who may receive what (room-interest.coax, #12789), and each seat's blocks by player id (K)
  im: [1] Interest; im_blk: [EG_SEATS] ImBlockList;
}
EgStrike :: struct { by: int; slot: int; fx: f32; fy: f32; fz: f32; ax: f32; ay: f32; az: f32; seed: int; }
EgCrime :: struct { by: int; x: f32; z: f32; }

// ---- text

eg_n :: (b: [] u8, at: int, v: int) -> int {
  n := put(b, at, " ");
  if v < 0 { n = put(b, n, "-"); return put_int(b, n, -v); }
  return put_int(b, n, v);
}
eg_round :: (v: f32) -> int {
  if !(v == v) || v > 1.0e9 || v < -1.0e9 { return 0; }
  return cast(int) floor(v + 0.5);
}
eg_hash :: (t: string) -> int {
  h := 2166136261;
  for c: t { h = ((h ^ cast(int) c) * 16777619) & 4294967295; }
  return ifx h == 0 then 1 else h;
}
eg_fields :: (t: string) -> int {
  if t.count == 0 { return 0; }
  n := 1;
  for c: t { if c == ' ' { n += 1; } }
  return n;
}
eg_clamp :: (v: int, a: int, b: int) -> int { return ifx v < a then a else (ifx v > b then b else v); }
// A word for a frame: letters, digits, '.', '-' and '_' only.
eg_word :: (t: string, out: [] u8) -> int {
  n := 0;
  for c: t {
    if n >= out.count { break; }
    ok := (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '-' || c == '_';
    if ok { out[n] = c; n += 1; }
  }
  return n;
}

// ---- rooms

eg_room_at :: (v: [] RmServer, r: int) -> int {
  for k: 0..<EG_ROOMS { if v[0].eg[k].live && v[0].eg[k].relay == r { return k; } }
  return -1;
}
// The simulation of relay room r, made when its first seat sits: its index, or -1 (all taken).
eg_room_of :: (v: [] RmServer, r: int) -> int {
  k := eg_room_at(v, r);
  if k >= 0 { return k; }
  for q: 0..<EG_ROOMS {
    if v[0].eg[q].live { continue; }
    v[0].eg[q].live = true; v[0].eg[q].relay = r; v[0].eg[q].tick = 0; v[0].eg[q].cache_tick = -1;
    for t: 0..<WIRE_BASES { v[0].eg[q].hist[0].tick[t] = -1; }
    for a: 0..<EG_SEATS * RA_ABS { v[0].eg[q].ab_slot[a] = 0; }
    v[0].eg[q].seed = 1 + (v[0].wall_ms / 7 + r * 7919) % 999999937;
    for s: 0..<EG_SEATS { v[0].eg[q].seat[s] = EgSeat.{}; }
    for c: 0..<EG_CASTS { v[0].eg[q].casts[c].on = false; }
    v[0].eg[q].cast_order = 0; v[0].eg[q].hurt_n = 0;
    v[0].eg[q].ev_n = 0; v[0].eg[q].ev_bytes = 0;
    // the town as new: the world's (the host's) is made whole again on rm_eg_fresh
    v[0].eg[q].folk_on = false; v[0].eg[q].crime_n = 0; v[0].eg[q].strike_n = 0; v[0].eg[q].rebuild = false; v[0].eg[q].fresh = true;
    v[0].eg[q].broke_at = -100000; v[0].eg[q].rebuilt_at = -100000;
    for s: 0..<EG_SEATS { v[0].eg[q].wanted[s] = 0; }
    for j: 0..<E5R_FOLK { v[0].eg[q].folk_by[j] = -1; }
    for c: 0..<EG_PIECES { v[0].eg[q].broken[c] = false; v[0].eg[q].burning[c] = false; }
    for c: 0..<CR_PLACED_MAX { v[0].eg[q].placed_burn[c] = false; v[0].eg[q].placed_gone[c] = false; }
    e5rr_start(v[0].eg[q].rules[..], v[0].eg[q].seed);
    ra_fresh(v, q);   // its abilities (room-abilities.coax)
    ev_fresh(v, q);   // its world event, XP and levels (room-events.coax)
    return q;
  }
  return -1;
}
// A seat sat down in everglade relay room r: it hears the world's header (after the relay's y), and
// its first D is a snapshot. The host puts it in the world (rm_eg_unplaced, rm_eg_moved) first.
eg_join :: (v: [] RmServer, r: int, conn: int, seat: int) {
  k := eg_room_of(v, r);
  if k < 0 || seat < 0 || seat >= EG_SEATS { return; }
  v[0].eg[k].seat[seat] = EgSeat.{live = true, conn = conn, full = true, bank = EG_JOIN_BANK, fresh = true};
  v[0].eg[k].wanted[seat] = 0;
  e5rr_join(v[0].eg[k].rules[..], seat, 0, 0);
  rv_join(v, k, seat);   // the HP its player left with (room-vitals.coax, #12715)
  rv_back(v, k, seat);   // and where they stood in this room, if lately
  ev_join(v, k, seat);   // its XP and its character's level (room-events.coax, #12739)
  v[0].eg[k].rules[0].pvp = v[0].ctl.pvp;   // the realm's pvp row (room-control.coax, #12714)
  v[0].eg[k].seat[seat].heard_ms = v[0].mono_ms;
  b: [128] u8;
  // the day and the weather: the server's (room-sky.coax)
  w := eg_sky_world(v, k); v[0].eg[k].sky = w.weather;
  n := wire_put_world(b[..], 0, w);
  rl_queue(v, r, conn, -1, cast(string) b[0..<n], "");
  for s: 0..<EG_SEATS { v[0].eg[k].seat[s].heard_n[seat] = 0; }
  v[0].eg[k].im_blk[seat] = ImBlockList.{};   // its page sends its blocks after its hello
  im_seat_reset(v[0].eg[k].im[..], seat); im_room_blocks(v, k);
}
eg_left :: (v: [] RmServer, r: int, seat: int) {
  k := eg_room_at(v, r);
  if k < 0 || seat < 0 || seat >= EG_SEATS { return; }
  rv_note_seat(v, k, seat);   // its HP kept for its player (room-vitals.coax, #12715)
  v[0].vit.flush = true;      // and posted at the host's next second; the note stays until a receipt covers it (#12793)
  v[0].eg[k].seat[seat].live = false;
  e5rr_leave(v[0].eg[k].rules[..], seat);
  rc_left(v, k, seat);   // its casts on their bars stop where everyone hears (room-casts.coax)
  v[0].eg[k].im_blk[seat] = ImBlockList.{}; im_seat_reset(v[0].eg[k].im[..], seat); im_room_blocks(v, k);
  any := false;
  for s: 0..<EG_SEATS { if v[0].eg[k].seat[s].live { any = true; } }
  if !any { v[0].eg[k].live = false; v[0].eg[k].relay = -1; }
}
eg_refuse :: (v: [] RmServer, k: int, seat: int, seq: int, why: string) {
  b: [64] u8;
  n := wire_put_refused(b[..], 0, seq, why);
  rl_queue(v, v[0].eg[k].relay, v[0].eg[k].seat[seat].conn, -1, cast(string) b[0..<n], "");
}
// The events every room's ticks had no room for since the last ask (room-host.c's minute report), then 0.
rm_eg_dropped :: (v: [] RmServer) -> int #export_c {
  n := 0;
  for k: 0..<EG_ROOMS { n += v[0].eg[k].ev_dropped; v[0].eg[k].ev_dropped = 0; }
  return n;
}
// An event since the last D, heard within EG_VIEW of (x, z), or by everyone (all).
eg_event :: (v: [] RmServer, k: int, text: string, x: f32, z: f32, all: bool) {
  e := v[0].eg[k].ev_n;
  if e >= EG_EVENTS || v[0].eg[k].ev_bytes + text.count > EG_EV_BYTES { v[0].eg[k].ev_dropped += 1; return; }
  a := v[0].eg[k].ev_bytes;
  for i: 0..<text.count { v[0].eg[k].ev[a + i] = text[i]; }
  v[0].eg[k].ev_at[e] = a; v[0].eg[k].ev_len[e] = text.count; v[0].eg[k].ev_x[e] = x; v[0].eg[k].ev_z[e] = z; v[0].eg[k].ev_all[e] = all;
  v[0].eg[k].ev_bytes += text.count; v[0].eg[k].ev_n = e + 1;
}

// ---- intents

// A seat's frame (past the relay's rate limits and pings).
eg_heard :: (v: [] RmServer, r: int, seat: int, text: string) {
  k := eg_room_at(v, r);
  if k < 0 || seat < 0 || seat >= EG_SEATS || !v[0].eg[k].seat[seat].live || text.count < 3 || text[1] != ' ' { return; }
  v[0].eg[k].seat[seat].heard_ms = v[0].mono_ms;
  c := text[0];
  if c == 'I' { eg_heard_input(v, k, seat, text); return; }
  if c == 'C' { eg_heard_cast(v, k, seat, text); return; }
  if c == 'H' { eg_heard_hello(v, k, seat, text); return; }
  if c == 'K' { im_heard_blocks(v, k, seat, text); return; }   // who it blocks (room-interest.coax, #12789)
  if c == 'E' {
    rd: [1] WireRd; rd[0] = wire_rd(text, 1);
    u := wire_read_use(text, rd[..]);
    if !rd[0].ok || eg_fields(text) != 4 { return; }
    // talking, doors, boats and boards are the world's, not yet the server's: only ending a slot is
    if u.kind != WE_END { eg_refuse(v, k, seat, u.seq, "unbuilt"); return; }
    world := ra_end(v, k, seat, u.id);   // the world's (room-abilities.coax), and the rules' concentration
    if ra_whole(u.id) { return; }
    if !e5rr_end(v[0].eg[k].rules[..], seat, u.id) && !world { eg_refuse(v, k, seat, u.seq, "nothing"); }
    return;
  }
  if c == 'L' { eg_heard_rest(v, k, seat, text); return; }   // a Long Rest (room-events.coax ev_rest_ok)
  if c == 'R' {
    // a room's town is rebuilt by the room (the aftermath's ev_rebuild) or by an admin, never a player's R (#12801)
    if !eg_ticket(v, k, seat).admin { rr0: [1] WireRd; rr0[0] = wire_rd(text, 1); eg_refuse(v, k, seat, wire_num(text, rr0[..]), "admin"); return; }
    // the world stands its pieces and people up (rm_eg_rebuild), the rules the people, every page hears it:
    // if no spell struck the town in the last EG_REBUILD_QUIET s, and at most once every EG_REBUILD_EVERY s (spec 6.6)
    rr: [1] WireRd; rr[0] = wire_rd(text, 1);
    seq := wire_num(text, rr[..]);
    now := v[0].eg[k].tick;
    if now - v[0].eg[k].broke_at < EG_REBUILD_QUIET * EG_HZ { eg_refuse(v, k, seat, seq, "breaking"); return; }
    if now - v[0].eg[k].rebuilt_at < EG_REBUILD_EVERY * EG_HZ { eg_refuse(v, k, seat, seq, "cooldown"); return; }
    v[0].eg[k].rebuilt_at = now;
    v[0].eg[k].rebuild = true;
    e5rr_folk_restore(v[0].eg[k].rules[..]);
    e5rr_zombies_clear(v[0].eg[k].rules[..]);   // the Warlock's Zombies fall with it
    e5rd_wall_whole(v[0].eg[k].rules[..]);      // the palisade whole: the raid's breaches shut
    for q: 0..<EG_PIECES { v[0].eg[k].broken[q] = false; v[0].eg[k].burning[q] = false; }
    for q: 0..<CR_PLACED_MAX { v[0].eg[k].placed_burn[q] = false; v[0].eg[k].placed_gone[q] = false; }
    p := v[0].eg[k].seat[seat].pose;
    b: [32] u8;
    eg_event(v, k, cast(string) b[0..<wire_put_rebuilt(b[..], 0)], p.x, p.z, true);
    return;
  }
}
// Seat seat's page heard tick `heard` whole: what went out that tick is its page's (rows, n and w
// entries), and its snapshots end once it is one of them.
eg_seat_heard :: (v: [] RmServer, k: int, seat: int, heard: int) {
  st := v[0].eg[k].seat[seat..<seat + 1];
  if st[0].full && st[0].full_t > 0 && heard >= st[0].full_t { st[0].full = false; }
  if st[0].full || heard <= st[0].rep[0].heard { return; }
  wire_seat_ack(st[0].rep[..], v[0].eg[k].hist[..], heard);
  if st[0].rep[0].heard != heard { return; }
  bit := 1 << (heard % WIRE_ACKS);
  for q: 0..<EG_SEATS {
    if (st[0].n_bits[q] & bit) != 0 && heard >= st[0].n_t[q] - WIRE_ACKS + 1 { st[0].n_ok[q] = true; }
    if (st[0].w_bits[q] & bit) != 0 && heard >= st[0].w_t[q] - WIRE_ACKS + 1 { st[0].w_ok[q] = true; }
  }
}
// book:begin intent-queue
// I SEQ KX KY PX PY THETA B HEARD: one step's input (THETA in WIRE_FINE units), queued for the tick; and the state tick its page
// heard whole, which is now its page's (wire_seat_ack), and ends its snapshots once it is one of them.
eg_heard_input :: (v: [] RmServer, k: int, seat: int, text: string) {
  if v[0].eg[k].seat[seat].old { eg_old_input(v, k, seat, text); return; }   // (room-oldwire.coax)
  r: [1] WireRd; r[0] = wire_rd(text, 1);
  w := wire_read_in(text, r[..]);
  if !r[0].ok || eg_fields(text) != 9 { return; }
  eg_seat_heard(v, k, seat, w.heard);
  st := v[0].eg[k].seat[seat..<seat + 1];
  seq := w.seq;
  n := st[0].q_n;
  if seq <= st[0].ack || (n > 0 && seq <= st[0].q[n - 1].seq) { return; }   // old or repeated
  if n >= EG_INPUTS {
    for i: 1..<EG_INPUTS { st[0].q[i - 1] = st[0].q[i]; }
    n = EG_INPUTS - 1;
  }
  st[0].q[n] = EgIn.{seq = seq, kx = eg_clamp(w.kx, -100, 100), ky = eg_clamp(w.ky, -100, 100),
                     px = eg_clamp(w.px, -100, 100), py = eg_clamp(w.py, -100, 100),
                     theta = eg_clamp(eg_round(w.theta * f32(WIRE_FINE)), -40000, 40000), b = eg_clamp(w.b, 0, 31), at = v[0].mono_ms};
  st[0].q_n = n + 1;
}
// book:end intent-queue
// H 3 LOOK CLASS FLAGS NAME
eg_heard_hello :: (v: [] RmServer, k: int, seat: int, text: string) {
  r: [1] WireRd; r[0] = wire_rd(text, 1);
  h := wire_read_hello(text, r[..]);
  if !r[0].ok { return; }
  st := v[0].eg[k].seat[seat..<seat + 1];
  // a page from before wire 3 (H 1): seated on the old wire while its window is open (room-oldwire.coax);
  // a page on any other wire: told why, and its socket closed (the host closes a kicked one), and
  // the page reloads (#12788)
  if h.version == WIRE_OLD_HELLO && eg_old_open(v) { eg_old_seat(v, k, seat); }
  else if h.version != WIRE_VERSION {
    eg_refuse(v, k, seat, 0, WIRE_REFUSE_VERSION);
    if st[0].conn >= 0 && st[0].conn < CONNS { v[0].conns[st[0].conn].kicked = true; }
    v[0].eg[k].stale_n += 1;
    return;
  }
  st[0].look_n = eg_word(h.look, st[0].look[..]);
  st[0].klass_n = eg_word(h.kind, st[0].klass[..]);
  // CLASS warlock: the seat's caster is the level 17 Warlock (fivebar.coax fb_warlock_hero), else the druid
  wl := ifx cast(string) st[0].klass[0..<st[0].klass_n] == "warlock" then 1 else 0;
  if v[0].eg[k].rules[0].klass[seat] != wl { e5rr_join_as(v[0].eg[k].rules[..], seat, st[0].pose.x, st[0].pose.z, wl); ev_class(v, k, seat); }
  st[0].flags = eg_clamp(h.flags, 0, 255);
  ev_hello(v, k, seat, st[0].flags);   // an admin's demo character (room-events.coax)
  // the name: letters, digits, spaces, '-' and '_' ("-" none)
  m := 0;
  for ch: h.name {
    if m >= EG_NAME { break; }
    ok := (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || (ch == ' ' && m > 0) || ch == '-' || ch == '_';
    if ok { st[0].name[m] = ch; m += 1; }
  }
  while m > 0 && st[0].name[m - 1] == ' ' { m -= 1; }
  st[0].name_n = ifx m == 1 && st[0].name[0] == '-' then 0 else m;
  // a seat ticket's name and account bit outrank the hello's (room-ticket.coax, #12712)
  tk := eg_ticket(v, k, seat);
  if tk.ok {
    st[0].flags = (st[0].flags & 253) | (ifx tk.account then 2 else 0);
    // only the ticket's name, which the API filtered (verse.name_ok, #12714); none: "-"
    for i: 0..<tk.name_n { st[0].name[i] = tk.name[i]; }
    st[0].name_n = tk.name_n;
  }
}
// The seat's ticket (ok false: none, in a room that needs none).
eg_ticket :: (v: [] RmServer, k: int, seat: int) -> Ticket {
  c := v[0].eg[k].seat[seat].conn;
  if c < 0 || c >= CONNS || !v[0].eg[k].seat[seat].live { return Ticket.{}; }   // (its socket may be closing: eg_left)
  return v[0].conns[c].ticket;
}
// C SEQ SLOT AX AY AZ TGT: a cast at the aim. The checks that need no place here (the slot, the class,
// the level); the rest at its start, once the inputs before it are stepped (room-casts.coax).
eg_heard_cast :: (v: [] RmServer, k: int, seat: int, text: string) {
  r: [1] WireRd; r[0] = wire_rd(text, 1);
  wc := wire_read_cast(text, r[..]);
  nf := eg_fields(text);
  if !r[0].ok || (nf != 7 && nf != 8) { return; }   // (a mode last, or none)
  seq := wc.seq;
  mode := eg_clamp(wc.mode, 0, RA_MODES);
  slot := wc.slot;
  // the druid's bar, or the Warlock's (FB_WL0 on) for a Warlock's seat
  wl := v[0].eg[k].rules[0].klass[seat] == 1;
  if !e5r_has(slot) || (slot >= FB_WL0) != wl { eg_refuse(v, k, seat, seq, "slot"); return; }
  a := e5rr_entry(v[0].eg[k].rules[..], slot);
  if a.kind == FB_WORLD && !cr_repair(slot) { eg_refuse(v, k, seat, seq, "slot"); return; }   // R is Repair (everglade-repair.coax)
  if !ev_may_cast(v, k, seat, slot, a) { eg_refuse(v, k, seat, seq, "level"); return; }   // levels 1 to 3 (room-events.coax)
  if !(wc.ax == wc.ax) || !(wc.az == wc.az) || !(wc.ay == wc.ay) { eg_refuse(v, k, seat, seq, cr_word(CR_AIM)); return; }
  if !rc_hear(v, k, seat, seq, slot, wc.ax, wc.ay, wc.az, wc.tgt, mode) { eg_refuse(v, k, seat, seq, "busy"); return; }
  if !cr_repair(slot) { ev_fought(v, k, seat); }   // casting is fighting (a Repair isn't): no Long Rest for EV_CALM_S
}
// L SEQ: a Long Rest. Between raids and out of combat only (room-events.coax ev_rest_ok); then the seat
// is whole again and hears e rest SEAT, its page its own rest (everglade-rest.coax).
eg_heard_rest :: (v: [] RmServer, k: int, seat: int, text: string) {
  r: [1] WireRd; r[0] = wire_rd(text, 1);
  seq := wire_num(text, r[..]);
  if !r[0].ok { return; }
  if !ev_rest_ok(v, k, seat) { eg_refuse(v, k, seat, seq, ifx v[0].ev[k].phase != EV_IDLE && v[0].ev[k].phase != EV_AFTER then "raid" else "combat"); return; }
  ev_long_rest(v, k, seat);
  b: [32] u8;
  p := v[0].eg[k].seat[seat].pose;
  eg_event(v, k, cast(string) b[0..<wire_put_rested(b[..], 0, seat)], p.x, p.z, false);
}

// ---- the tick. The host, EG_HZ times a second for each live room: rm_eg_begin; for each seat
// rm_eg_unplaced (then rm_eg_moved with seq 0 at the gate) and while rm_eg_input, the shared
// step and rm_eg_moved; then rm_eg_end, and the queue out.

// Room k's tick begins: each seat is owed the steps of time the server's clock has run since its last
// tick (EG_BANK at most), however late this tick is. False: no such room.
rm_eg_begin :: (v: [] RmServer, k: int) -> bool #export_c {
  if k < 0 || k >= EG_ROOMS || !v[0].eg[k].live { return false; }
  v[0].eg[k].tick += 1;
  now := v[0].mono_ms;
  for s: 0..<EG_SEATS {
    st := v[0].eg[k].seat[s..<s + 1];
    if !st[0].live { continue; }
    st[0].took = 0;
    // its first tick earns its first step; each 1/EG_HZ s of the clock after it, one more (to the nearest)
    if st[0].sat_ms < 0 || now < st[0].sat_ms { st[0].sat_ms = now; st[0].earned = 0; st[0].bank = least(st[0].bank + 1, EG_BANK); }
    due := ((now - st[0].sat_ms) * EG_HZ + 500) / 1000;
    if due > st[0].earned { st[0].bank = least(st[0].bank + due - st[0].earned, EG_BANK); st[0].earned = due; }
    // input past what it is owed and EG_KEEP ticks more is a page sending faster than the clock (a
    // skewed clock, or a cheat): the oldest of it goes, so no seat's input stands more than EG_KEEP
    // ticks behind its time; the page's re-run takes the server's word for the step that went
    over := st[0].q_n - st[0].bank - EG_KEEP;
    if over > 0 {
      for i: over..<st[0].q_n { st[0].q[i - over] = st[0].q[i]; }
      st[0].q_n -= over; st[0].late += over;
    }
  }
  return true;
}
// Seat s's next input to step this tick, EG_IN_FIELDS into out (SEQ KX KY PX PY THETA B); false when
// none is queued, none owed, or EG_TICK_STEPS were stepped this tick.
rm_eg_input :: (v: [] RmServer, k: int, s: int, out: [] int) -> bool #export_c {
  if k < 0 || k >= EG_ROOMS || s < 0 || s >= EG_SEATS || out.count < EG_IN_FIELDS { return false; }
  st := v[0].eg[k].seat[s..<s + 1];
  if !st[0].live || !st[0].placed || st[0].q_n == 0 || st[0].bank <= 0 || st[0].took >= EG_TICK_STEPS { return false; }
  i := st[0].q[0];
  for q: 1..<st[0].q_n { st[0].q[q - 1] = st[0].q[q]; }
  st[0].q_n -= 1; st[0].bank -= 1; st[0].took += 1;
  st[0].step_at = i.at;
  out[0] = i.seq; out[1] = i.kx; out[2] = i.ky; out[3] = i.px; out[4] = i.py; out[5] = i.theta; out[6] = i.b;
  return true;
}
// Where seat s stands after the step of input seq (0: just placed), as the step left it.
rm_eg_moved :: (v: [] RmServer, k: int, s: int, seq: int, x: f32, y: f32, z: f32, yaw: f32, vx: f32, vy: f32, vz: f32, g: int, clip: int, carry: int) #export_c {
  if k < 0 || k >= EG_ROOMS || s < 0 || s >= EG_SEATS || !v[0].eg[k].live || !v[0].eg[k].seat[s].live { return; }
  st := v[0].eg[k].seat[s..<s + 1];
  st[0].pose = EgPose.{x = x, y = y, z = z, yaw = yaw, vx = vx, vy = vy, vz = vz, g = g, clip = clip, carry = carry};
  if seq > st[0].ack { st[0].ack = seq; st[0].ack_at = st[0].step_at; }
  st[0].placed = true;
  e5rr_place(v[0].eg[k].rules[..], s, x, z);
}
// Whether seat s sits and is still to be put in the world.
rm_eg_unplaced :: (v: [] RmServer, k: int, s: int) -> bool #export_c {
  return k >= 0 && k < EG_ROOMS && s >= 0 && s < EG_SEATS && v[0].eg[k].live && v[0].eg[k].seat[s].live && !v[0].eg[k].seat[s].placed;
}
rm_eg_rooms :: () -> int #export_c { return EG_ROOMS; }
rm_eg_seats :: () -> int #export_c { return EG_SEATS; }
rm_eg_hz :: () -> int #export_c { return EG_HZ; }
rm_eg_live :: (v: [] RmServer, k: int) -> bool #export_c { return k >= 0 && k < EG_ROOMS && v[0].eg[k].live; }
rm_eg_seat_live :: (v: [] RmServer, k: int, s: int) -> bool #export_c { return rm_eg_live(v, k) && s >= 0 && s < EG_SEATS && v[0].eg[k].seat[s].live; }
// Summoned creatures: how many places, where q stands (x, z) when it is on, and the ground's height
// under it, which the host's world knows (before rm_eg_end: a new one is heard once it has it).
rm_eg_beasts :: () -> int #export_c { return E5RR_BEASTS; }
rm_eg_beast_at :: (v: [] RmServer, k: int, q: int, out: [] f32) -> bool #export_c {
  if !rm_eg_live(v, k) || q < 0 || q >= E5RR_BEASTS || out.count < 2 { return false; }
  bt := v[0].eg[k].rules[0].beasts[q];
  if bt.id == 0 { return false; }
  out[0] = bt.x; out[1] = bt.z;
  return true;
}
rm_eg_beast_ground :: (v: [] RmServer, k: int, q: int, y: f32) #export_c { if rm_eg_live(v, k) { e5rr_beast_ground(v[0].eg[k].rules[..], q, y); } }

// Room k's tick ends: the casts that strike now are rolled, the engine's clock moves on, its events
// are heard (rm_eg_rules), and every EG_SEND ticks (each tick) each seat gets its state (rm_eg_send).
// The host calls the two apart, to time the rules and the writing of the frames (room-stats.h).
rm_eg_end :: (v: [] RmServer, k: int) #export_c { rm_eg_rules(v, k); rm_eg_send(v, k); }
rm_eg_rules :: (v: [] RmServer, k: int) #export_c {
  if k < 0 || k >= EG_ROOMS || !v[0].eg[k].live { return; }
  t := v[0].eg[k].tick;
  // the casts in the tick's order (room-casts.coax): starts, heals, the world's harm; the rules' step
  // (the creatures' turns); then stops, releases and harm
  rc_tick_first(v, k);
  e5rr_step(v[0].eg[k].rules[..], f32(t) / f32(EG_HZ));
  rc_tick_last(v, k);
  eg_engine_events(v, k);
  eg_sky_tick(v, k);   // the weather turned: everyone hears it (room-sky.coax)
  ev_tick(v, k);       // its world event (room-events.coax)
}
rm_eg_send :: (v: [] RmServer, k: int) #export_c {
  if k < 0 || k >= EG_ROOMS || !v[0].eg[k].live || v[0].eg[k].tick % EG_SEND != 0 { return; }
  for s: 0..<EG_SEATS { if v[0].eg[k].seat[s].live && v[0].eg[k].seat[s].placed { eg_send(v, k, s); } }
  v[0].eg[k].ev_n = 0; v[0].eg[k].ev_bytes = 0;
}
// Where a TGT code is now (a seat's place, a summoned creature's), else (x, z).
eg_where :: (v: [] RmServer, k: int, tgt: int, x: f32, z: f32) -> EgPose {
  if tgt >= EG_TGT_SEAT && tgt < EG_TGT_SEAT + EG_SEATS { return v[0].eg[k].seat[tgt - EG_TGT_SEAT].pose; }
  if tgt > E5RR_TGT_BEAST {
    i := e5rr_beast_of_tgt(v[0].eg[k].rules[..], tgt);
    if i >= 0 { bt := v[0].eg[k].rules[0].beasts[i - E5RR_BEAST0]; return EgPose.{x = bt.x, y = bt.y, z = bt.z}; }
  }
  return EgPose.{x = x, z = z};
}
eg_engine_events :: (v: [] RmServer, k: int) {
  ev: [64 * E5RR_EV_FLOATS] f32;
  n := e5rr_events(v[0].eg[k].rules[..], ev[..]);
  for q: 0..<n {
    o := q * E5RR_EV_FLOATS;
    kind := cast(int) ev[o]; by := cast(int) ev[o + 2]; who := cast(int) ev[o + 3];
    at := eg_where(v, k, who, ev[o + 6], ev[o + 7]);
    b: [96] u8; m := 0;
    if kind == RS_EV_DAMAGE { eg_crime(v, k, by, who, at.x, at.z); }
    ev_engine(v, k, kind, by, who);   // a raider's harm, the XP's (room-events.coax)
    if kind == RS_EV_DAMAGE { m = wire_put_hit(b[..], 0, WireHit.{who = who, by = by, amt = cast(int) ev[o + 4], kind = cast(int) ev[o + 5]}); }
    else if kind == RS_EV_HEAL { m = wire_put_heal(b[..], 0, who, cast(int) ev[o + 4]); }
    else if kind == RS_EV_DEATH { m = wire_put_die(b[..], 0, who); }
    if m > 0 { eg_event(v, k, cast(string) b[0..<m], at.x, at.z, false); }
  }
}

// Seat harm (by a seat, or a creature a seat summoned) to a townsperson `who` is a crime the world hears.
eg_crime :: (v: [] RmServer, k: int, by: int, who: int, x: f32, z: f32) {
  if who < 0 || who >= E5R_FOLK { return; }
  seat := -1;
  if by >= EG_TGT_SEAT && by < EG_TGT_SEAT + EG_SEATS { seat = by - EG_TGT_SEAT; }
  else if by > E5RR_TGT_BEAST {
    i := e5rr_beast_of_tgt(v[0].eg[k].rules[..], by);
    if i >= 0 { seat = v[0].eg[k].rules[0].beasts[i - E5RR_BEAST0].by; }
  }
  if seat < 0 || seat >= EG_SEATS { return; }
  v[0].eg[k].folk_by[who] = seat;
  if v[0].eg[k].crime_n < EG_CRIMES { v[0].eg[k].crimes[v[0].eg[k].crime_n] = EgCrime.{by = seat, x = x, z = z}; v[0].eg[k].crime_n += 1; }
}

// ---- the town: the host's world steps it between rm_eg_begin and rm_eg_end (room-world.c world_town)

// Whether room k is new since the world last heard (its town starts whole: world_fresh).
rm_eg_fresh :: (v: [] RmServer, k: int) -> bool #export_c {
  if !rm_eg_live(v, k) || !v[0].eg[k].fresh { return false; }
  v[0].eg[k].fresh = false;
  return true;
}
// Seat s for the world: X Y Z LIVE HP MAX COND (everglade-watch.coax EG_ROOM_SEAT_FLOATS; LIVE 2 just sat).
rm_eg_seat_town :: (v: [] RmServer, k: int, s: int, out: [] f32) #export_c {
  if out.count < 7 { return; }
  for q: 0..<7 { out[q] = 0; }
  if !rm_eg_seat_live(v, k, s) || !v[0].eg[k].seat[s].placed { return; }
  o: [E5RR_OUT_FLOATS] f32;
  e5rr_seat_out(v[0].eg[k].rules[..], s, o[..]);
  p := v[0].eg[k].seat[s].pose;
  out[0] = p.x; out[1] = p.y; out[2] = p.z; out[3] = ifx v[0].eg[k].seat[s].fresh then 2.0f32 else 1.0f32;   // 2: new
  v[0].eg[k].seat[s].fresh = false;
  out[4] = ifx o[4] > 0.5 then 0.0f32 else o[0]; out[5] = o[1]; out[6] = o[3];
}
// The people where the world has them (E5R_FOLK_FLOATS each, n of them), for the rules.
rm_eg_people :: (v: [] RmServer, k: int, folk: [] f32, n: int) #export_c { if rm_eg_live(v, k) { e5rr_people(v[0].eg[k].rules[..], folk, n); } }
// Person j's Hit Points in the rules now, for the world: HP TEMP BY (the seat that last harmed them, -1).
rm_eg_folk_hp :: (v: [] RmServer, k: int, j: int, out: [] f32) -> bool #export_c {
  if !rm_eg_live(v, k) || j < 0 || j >= E5R_FOLK || out.count < 3 { return false; }
  o: [E5RR_OUT_FLOATS] f32;
  e5rr_folk_out(v[0].eg[k].rules[..], j, o[..]);
  out[0] = o[0]; out[1] = o[2]; out[2] = f32(v[0].eg[k].folk_by[j]);
  return true;
}
// The crimes since the world last heard: q's BY X Z, while q < the count.
rm_eg_crimes :: (v: [] RmServer, k: int) -> int #export_c { return ifx rm_eg_live(v, k) then v[0].eg[k].crime_n else 0; }
rm_eg_crime :: (v: [] RmServer, k: int, q: int, out: [] f32) #export_c {
  if !rm_eg_live(v, k) || q < 0 || q >= v[0].eg[k].crime_n || out.count < 3 { return; }
  c := v[0].eg[k].crimes[q];
  out[0] = f32(c.by); out[1] = c.x; out[2] = c.z;
}
rm_eg_crimes_heard :: (v: [] RmServer, k: int) #export_c { if rm_eg_live(v, k) { v[0].eg[k].crime_n = 0; } }
// The strikes since the world last heard: q's BY SLOT FX FY FZ AX AY AZ SEED.
rm_eg_strikes :: (v: [] RmServer, k: int) -> int #export_c { return ifx rm_eg_live(v, k) then v[0].eg[k].strike_n else 0; }
rm_eg_strike :: (v: [] RmServer, k: int, q: int, out: [] f32) #export_c {
  if !rm_eg_live(v, k) || q < 0 || q >= v[0].eg[k].strike_n || out.count < 9 { return; }
  c := v[0].eg[k].strikes[q];
  out[0] = f32(c.by); out[1] = f32(c.slot); out[2] = c.fx; out[3] = c.fy; out[4] = c.fz; out[5] = c.ax; out[6] = c.ay; out[7] = c.az; out[8] = f32(c.seed);
}
rm_eg_strikes_heard :: (v: [] RmServer, k: int) #export_c { if rm_eg_live(v, k) { v[0].eg[k].strike_n = 0; } }
// Whether a rebuild was asked for since the world last heard.
rm_eg_rebuild :: (v: [] RmServer, k: int) -> bool #export_c {
  if !rm_eg_live(v, k) || !v[0].eg[k].rebuild { return false; }
  v[0].eg[k].rebuild = false;
  return true;
}
// Piece `piece` broke (KIND 1, thrown at A B C m/s) or caught or went out (KIND 2, A 1 alight) in the
// world, standing at (x, z): every page hears it, near or far, for every page's town is the same.
// KIND 3: a Repair stood structure `piece` up (everglade-repair.coax RP_*: a group, or a placed thing
// past CR_REPAIR_PLACED0), its pieces whole (rm_eg_piece_up, from the host first). KIND 4 and 5: placed thing
// `piece` caught or went out (A 1 alight), or burnt through and broke apart (everglade-placed-fire.coax).
rm_eg_piece :: (v: [] RmServer, k: int, kind: int, piece: int, a: f32, b: f32, c: f32, x: f32, z: f32) #export_c {
  if !rm_eg_live(v, k) || piece < 0 { return; }
  e: [96] u8; n := 0;
  if kind == 3 {
    q := piece - CR_REPAIR_PLACED0;
    if q >= 0 && q < CR_PLACED_MAX { v[0].eg[k].placed_burn[q] = false; v[0].eg[k].placed_gone[q] = false; }
    n = wire_int(e[..], wire_put(e[..], 0, "e mend"), piece);
    eg_event(v, k, cast(string) e[0..<n], x, z, true);
    return;
  }
  if kind == 4 || kind == 5 {
    if piece >= CR_PLACED_MAX { return; }
    if kind == 4 { v[0].eg[k].placed_burn[piece] = a > 0.5; } else { v[0].eg[k].placed_gone[piece] = true; v[0].eg[k].placed_burn[piece] = false; }
    n = eg_put_placed(e[..], kind, piece, a > 0.5);
    eg_event(v, k, cast(string) e[0..<n], x, z, true);
    return;
  }
  if piece >= EG_PIECES { return; }
  if kind == 1 {
    v[0].eg[k].broken[piece] = true; v[0].eg[k].burning[piece] = false;
    e5rd_wall_broke(v[0].eg[k].rules[..], x, z);   // a palisade post down opens a raid's breach (#12747)
    n = eg_put_break(e[..], piece, a, b, c);
  } else {
    v[0].eg[k].burning[piece] = a > 0.5;
    n = eg_put_burn(e[..], piece, a > 0.5);
  }
  eg_event(v, k, cast(string) e[0..<n], x, z, true);
}
// Piece i stands whole again (a Repair): late pages hear nothing of it.
rm_eg_piece_up :: (v: [] RmServer, k: int, i: int) #export_c {
  if !rm_eg_live(v, k) || i < 0 || i >= EG_PIECES { return; }
  v[0].eg[k].broken[i] = false; v[0].eg[k].burning[i] = false;
}
// The realm's placed things changed (the host laid a new world): what burnt of the old list is forgotten.
rm_eg_placed_reset :: (v: [] RmServer) #export_c {
  for k: 0..<EG_ROOMS { for q: 0..<CR_PLACED_MAX { v[0].eg[k].placed_burn[q] = false; v[0].eg[k].placed_gone[q] = false; } }
}
// e pburn I ON, or e pgone I: placed thing I alight or out, or burnt through.
eg_put_placed :: (e: [] u8, kind: int, i: int, on: bool) -> int {
  if kind == 5 { return wire_int(e, wire_put(e, 0, "e pgone"), i); }
  return wire_int(e, wire_int(e, wire_put(e, 0, "e pburn"), i), ifx on then 1 else 0);
}
eg_put_break :: (e: [] u8, piece: int, a: f32, b: f32, c: f32) -> int {
  n := wire_put(e, 0, "e break"); n = wire_int(e, n, piece); n = wire_m(e, n, a); n = wire_m(e, n, b); n = wire_m(e, n, c);
  return n;
}
eg_put_burn :: (e: [] u8, piece: int, on: bool) -> int {
  n := wire_put(e, 0, "e burn"); n = wire_int(e, n, piece); n = wire_int(e, n, ifx on then 1 else 0);
  return n;
}
// What the watch's blows took from seat s this tick, and who dealt them (a watch actor, -1 none).
rm_eg_hurt :: (v: [] RmServer, k: int, s: int, amount: int, by: int) #export_c {
  // dealt at the tick's end, after its heals (room-casts.coax rc_tick_first); a full tick's at once
  if !rm_eg_seat_live(v, k, s) || amount <= 0 { return; }
  if v[0].eg[k].hurt_n >= EG_HURTS { e5rr_hurt(v[0].eg[k].rules[..], EG_TGT_SEAT + s, amount, by); return; }
  v[0].eg[k].hurts[v[0].eg[k].hurt_n] = EgHurt.{s = s, amount = amount, by = by};
  v[0].eg[k].hurt_n += 1;
}
// Person i as pages hear them (X Z YAW CLIP MODE HP SHOWN), and seat s's WANTED level.
rm_eg_folk :: (v: [] RmServer, k: int, i: int, at: [] f32) #export_c {
  if !rm_eg_live(v, k) || i < 0 || i >= E5R_FOLK || at.count < EG_FOLK_FLOATS { return; }
  for q: 0..<EG_FOLK_FLOATS { v[0].eg[k].folk[i * EG_FOLK_FLOATS + q] = at[q]; }
  v[0].eg[k].folk_on = true;
}
rm_eg_cond :: (v: [] RmServer, k: int, s: int, bits: int) #export_c { if rm_eg_seat_live(v, k, s) { v[0].eg[k].seat[s].wcond = bits; } }
// Seat s's watch effect by cause (WE_*): its seconds left, 0 none. A new one, or one cast again (more
// left than last tick's), starts now (T0) and lasts what is left (DUR, ticks).
rm_eg_cond_left :: (v: [] RmServer, k: int, s: int, cause: int, left: f32) #export_c {
  if !rm_eg_seat_live(v, k, s) || cause < 0 || cause >= WE_WATCH { return; }
  st := v[0].eg[k].seat[s..<s + 1];
  was := st[0].fx_left[cause];
  if left > 0 && (was <= 0 || left > was + 0.1) { st[0].fx_t0[cause] = v[0].eg[k].tick; st[0].fx_dur[cause] = cast(int) floor(left * f32(WIRE_HZ) + 0.5); }
  st[0].fx_left[cause] = ifx left > 0 then left else 0;
}
rm_eg_wanted :: (v: [] RmServer, k: int, s: int, level: int) #export_c { if rm_eg_seat_live(v, k, s) { v[0].eg[k].wanted[s] = level; } }
// The WANTED level seat s comes back with (rv_join, #12794), once: the host lays it on the world's town
// when the town first steps the seat. 0 none.
rm_eg_want_take :: (v: [] RmServer, k: int, s: int) -> int #export_c {
  if !rm_eg_seat_live(v, k, s) { return 0; }
  w := v[0].eg[k].seat[s].want_seed;
  v[0].eg[k].seat[s].want_seed = 0;
  return w;
}

// ---- what a seat hears

EgOut :: struct { b: [EG_CHUNK + 512] u8; n: int; any: bool; part: int; old: bool; }   // old: D's header on the old wire (room-oldwire.coax)
eg_out_entry :: (o: [] EgOut, v: [] RmServer, k: int, s: int, f: int, entry: string) {
  if o[0].any && o[0].n + entry.count + 1 > EG_CHUNK { eg_out_send(o, v, k, s, f | 2); }
  if o[0].any { o[0].b[o[0].n] = ';'; o[0].n += 1; }
  o[0].n = put(o[0].b[..], o[0].n, entry);
  o[0].any = true;
}
// The entries so far out as one D frame with F f, the tick's next part; the next start a new frame.
eg_out_send :: (o: [] EgOut, v: [] RmServer, k: int, s: int, f: int) {
  h: [64] u8;
  n := wire_put_d(h[..], 0, WireD.{tick = v[0].eg[k].tick, ack = v[0].eg[k].seat[s].ack, f = f, part = o[0].part});
  if o[0].old { n = wire_put(h[..], wire_int(h[..], wire_int(h[..], wire_int(h[..], wire_put(h[..], 0, "D"), v[0].eg[k].tick), v[0].eg[k].seat[s].ack), f), " "); }
  rl_queue(v, v[0].eg[k].relay, v[0].eg[k].seat[s].conn, -1, cast(string) h[0..<n], cast(string) o[0].b[0..<o[0].n]);
  o[0].n = 0; o[0].any = false; o[0].part += 1;
}
eg_snap :: (v: f32, step: f32) -> f32 { return f32(eg_round(v / step)) * step; }
eg_near :: (p: EgPose, x: f32, z: f32) -> bool { return (p.x - x) * (p.x - x) + (p.z - z) * (p.z - z) <= f32(EG_VIEW * EG_VIEW); }
eg_kind_of :: (slot: int) -> int {
  if slot == EG_SLOT_CONJURE { return WK_PACK; }
  if slot == EG_SLOT_STONE { return WK_STONE; }
  if slot == EG_SLOT_TENTACLES { return WK_TENTACLES; }
  if slot == EG_SLOT_THORNS { return WK_THORNS; }
  return WK_ZONE;
}

// Room k's table this tick, once for every seat (everglade-wire.coax WireHist): every placed player,
// every townsperson outdoors, every summoned creature whose ground is known, every zone the rules hold
// and every ability the world's copies hold up, each in its slot (EG_SLOT_*), and each player's n
// entry with its hash.
eg_table :: (v: [] RmServer, k: int) {
  rm := v[0].eg[k..<k + 1];
  if rm[0].cache_tick == rm[0].tick { return; }
  rm[0].cache_tick = rm[0].tick;
  h := rm[0].hist[..];
  wire_hist_begin(h, rm[0].tick);
  out: [E5RR_OUT_FLOATS] f32;
  for q: 0..<EG_SEATS {
    rm[0].cn_n[q] = 0;
    other := rm[0].seat[q];
    if !other.live || !other.placed { continue; }
    e5rr_seat_out(rm[0].rules[..], q, out[..]);
    p := other.pose;
    g := p.g | (ifx out[4] > 0.5 then WG_DEAD else 0) | (ifx v[0].mono_ms - other.heard_ms > WIRE_AWAY_MS then WG_AWAY else 0);
    wire_hist_put(h, q, WireS.{id = q, kind = WK_PLAYER, x = p.x, y = p.y, z = p.z, yaw = p.yaw, vx = p.vx, vy = p.vy, vz = p.vz, g = g, clip = p.clip,
                               hp = cast(int) out[0], max = cast(int) out[1], temp = cast(int) out[2], cond = cast(int) out[3] | other.wcond,
                               owner = q, carry = f32(p.carry) / 10000.0}, wire_rel(WK_PLAYER), true, false);
    a := q * EG_ENT;
    tq := eg_ticket(v, k, q);
    n := wire_put_n(rm[0].cn[a..<a + EG_ENT], 0, WireN.{ss = q, id = ifx tq.ok then cast(string) tq.pid[0..<tq.pid_n] else "-", look = ifx other.look_n > 0 then cast(string) other.look[0..<other.look_n] else "ranger.0.0.0",
                                    kind = ifx other.klass_n > 0 then cast(string) other.klass[0..<other.klass_n] else "druid",
                                    flags = other.flags, name = ifx other.name_n > 0 then cast(string) other.name[0..<other.name_n] else "-"});
    rm[0].cn_n[q] = n; rm[0].cn_h[q] = eg_hash(cast(string) rm[0].cn[a..<a + n]);
  }
  // the townsfolk outdoors: G their mode, CLIP their clip, P1 who, Y how high the world's abilities
  // hold them over their feet (Reverse Gravity)
  if rm[0].folk_on {
    for i: 0..<E5R_FOLK {
      fo := i * EG_FOLK_FLOATS;
      fl := rm[0].folk[fo..<fo + EG_FOLK_FLOATS];
      if fl[6] < 0.5 { continue; }
      wire_hist_put(h, EG_SLOT_FOLK + i, WireS.{id = WIRE_ID_FOLK + i, kind = WK_FOLK, x = fl[0], y = f32(v[0].ab[k].air[i]) / 100, z = fl[1], yaw = fl[2],
                                                 clip = cast(int) fl[3], g = cast(int) fl[4], hp = cast(int) fl[5], p1 = i}, wire_rel(WK_FOLK), false, true);
    }
  }
  // summoned creatures (raiders among them) once their ground is known: G 1 while it runs (a raider's
  // level in bits 8 and up), P1 its form, MAX its most Hit Points
  bf: [E5RR_BEAST_FLOATS] f32;
  for q: 0..<E5RR_BEASTS {
    id := e5rr_beast(rm[0].rules[..], q, bf[..]);
    if id <= 0 || bf[9] < 0.5 { continue; }
    wire_hist_put(h, EG_SLOT_BEAST + q, WireS.{id = WIRE_ID_MADE + id, kind = WK_BEAST, x = bf[0], y = bf[1], z = bf[2], yaw = bf[3], hp = cast(int) bf[4], max = cast(int) bf[5],
                                                g = cast(int) bf[8] + ev_beast_f(v, k, q), owner = cast(int) bf[6], p1 = cast(int) bf[7]}, wire_rel(WK_BEAST), false, true);
  }
  // the rules' lasting areas: P1 the ability a zone is from, P2 its radius in cm
  zf: [E5RR_ZONE_FLOATS] f32;
  for q: 0..<E5RR_ZONES {
    id := e5rr_zone(rm[0].rules[..], q, zf[..]);
    if id <= 0 { continue; }
    slot := cast(int) zf[5]; by := cast(int) zf[1];
    kind := eg_kind_of(slot);
    wire_hist_put(h, EG_SLOT_ZONE + q, WireS.{id = WIRE_ID_MADE + id, kind = kind, x = zf[2], z = zf[3], hp = -1, g = 1,
                                               owner = ifx by >= EG_TGT_SEAT then by - EG_TGT_SEAT else -1,
                                               p1 = ifx kind == WK_ZONE then slot - EG_SP_SLOTS else 0, p2 = wire_cm(zf[4])}, wire_rel(kind), false, false);
  }
  // each seat's watch effects (Hold Person, Earthbind, Ray of Frost): OWNER the seat's TGT code, P1
  // the cause, P2 its WC_* bit, T0 the tick it started, DUR its ticks (no place: the same row all along)
  used: [EG_SLOT_ABS] bool;
  for q: 0..<EG_SEATS * RA_ABS { if rm[0].ab_slot[q] > 0 { used[rm[0].ab_slot[q] - 1] = true; } }
  for q: 0..<EG_SEATS {
    st := rm[0].seat[q];
    for c: 0..<WE_WATCH {
      f := q * WE_WATCH + c;
      if !st.live || !st.placed || st.fx_left[c] <= 0 { rm[0].fx_slot[f] = 0; continue; }
      if rm[0].fx_slot[f] > 0 { used[rm[0].fx_slot[f] - 1] = true; }
    }
  }
  for q: 0..<EG_SEATS {
    st := rm[0].seat[q];
    if !st.live || !st.placed { continue; }
    for c: 0..<WE_WATCH {
      f := q * WE_WATCH + c;
      if st.fx_left[c] <= 0 { continue; }
      if rm[0].fx_slot[f] == 0 { for j: 0..<EG_SLOT_ABS { if !used[j] { used[j] = true; rm[0].fx_slot[f] = j + 1; break; } } }
      if rm[0].fx_slot[f] == 0 { continue; }   // the pool full: it waits
      wire_hist_put(h, EG_SLOT_AB + rm[0].fx_slot[f] - 1, WireS.{id = WIRE_ID_MADE + EG_FX_ID + q * WE_WATCH + c, kind = WK_EFFECT,
                                                           owner = WIRE_TGT_SEAT + q, p1 = c, p2 = WE_BIT[c], t0 = st.fx_t0[c], dur = st.fx_dur[c]}, wire_rel(WK_EFFECT), true, false);
    }
  }
  ra_table(v, k);   // what the world's abilities hold up (room-abilities.coax)
}

// Seat s's state this tick: a D frame (in parts when it runs past EG_CHUNK) of its rows (cut from the
// room's table: wire_seat_frame, against what its page acknowledged, the nearest first within
// WIRE_BUDGET), who each seat is and their WANTED levels (on change, again until acknowledged), the
// world's event, and the events near it. Until its page has heard one, every D is a snapshot (F 1:
// whole, the page forgetting all it held first, the budget off); the town's broken pieces go with the first.
eg_send :: (v: [] RmServer, k: int, s: int) {
  if v[0].eg[k].seat[s].old { eg_old_send(v, k, s); return; }   // a page from before wire 3 (room-oldwire.coax)
  st := v[0].eg[k].seat[s..<s + 1];
  now := v[0].eg[k].tick;
  full := st[0].full;
  f := ifx full then 1 else 0;
  if full {
    wire_seat_reset(st[0].rep[..]);
    for q: 0..<EG_SEATS { st[0].heard_n[q] = 0; st[0].heard_w[q] = 0; st[0].n_bits[q] = 0; st[0].w_bits[q] = 0; st[0].n_ok[q] = false; st[0].w_ok[q] = false; }
    if st[0].full_t == 0 { st[0].full_t = now; }
  }
  o: [1] EgOut;
  me := st[0].pose;
  e: [320] u8;
  if full && !st[0].pieces {
    st[0].pieces = true;
    for q: 0..<EG_PIECES {
      if v[0].eg[k].broken[q] { n := eg_put_break(e[..], q, 0, 0, 0); eg_out_entry(o[..], v, k, s, f, cast(string) e[0..<n]); }
      else if v[0].eg[k].burning[q] { n := eg_put_burn(e[..], q, true); eg_out_entry(o[..], v, k, s, f, cast(string) e[0..<n]); }
    }
    for q: 0..<CR_PLACED_MAX {
      if v[0].eg[k].placed_gone[q] { n := eg_put_placed(e[..], 5, q, false); eg_out_entry(o[..], v, k, s, f, cast(string) e[0..<n]); }
      else if v[0].eg[k].placed_burn[q] { n := eg_put_placed(e[..], 4, q, true); eg_out_entry(o[..], v, k, s, f, cast(string) e[0..<n]); }
    }
  }
  eg_table(v, k);
  rm := v[0].eg[k..<k + 1];
  rows: [WIRE_SLOTS * 96] u8;
  // a socket still behind (EG_BEHIND bytes waiting when the tick began) gets only its own row and the
  // x's: the rest would be out of date before they went, and the next tick's go against what it heard
  c := st[0].conn;
  behind := !full && c >= 0 && c < CONNS && v[0].conns[c].waiting > EG_BEHIND;
  if behind { v[0].eg[k].behind_n += 1; }
  n := wire_seat_frame(st[0].rep[..], rm[0].hist[..], s, me.x, me.z, f32(EG_VIEW), ifx full then rows.count else ifx behind then 0 else WIRE_BUDGET, rows[..]);
  for q: 0..<wire_entries(cast(string) rows[0..<n], 0) {
    en := wire_entry(cast(string) rows[0..<n], 0, q);
    if en.count > 0 { eg_out_entry(o[..], v, k, s, f, en); }
  }
  // who each seat is and its WANTED level: on change, and again WIRE_RESEND ticks on until a tick that
  // held it is acknowledged (a frame the relay's queue had no room for)
  keep := ((1 << WIRE_ACKS) - 1) ^ (1 << (now % WIRE_ACKS));
  for q: 0..<EG_SEATS {
    st[0].n_bits[q] = st[0].n_bits[q] & keep; st[0].w_bits[q] = st[0].w_bits[q] & keep;
    other := v[0].eg[k].seat[q];
    if !other.live || !other.placed { st[0].heard_n[q] = 0; st[0].heard_w[q] = 0; continue; }
    h := rm[0].cn_h[q];
    if h != st[0].heard_n[q] || (!st[0].n_ok[q] && now - st[0].n_t[q] >= WIRE_RESEND) {
      if h != st[0].heard_n[q] { st[0].n_bits[q] = 0; st[0].n_ok[q] = false; }
      a := q * EG_ENT;
      eg_out_entry(o[..], v, k, s, f, cast(string) rm[0].cn[a..<a + rm[0].cn_n[q]]);
      st[0].heard_n[q] = h; st[0].n_t[q] = now; st[0].n_bits[q] = st[0].n_bits[q] | (1 << (now % WIRE_ACKS));
    }
    w1 := v[0].eg[k].wanted[q] + 1;
    if w1 != st[0].heard_w[q] || (!st[0].w_ok[q] && now - st[0].w_t[q] >= WIRE_RESEND) {
      if w1 != st[0].heard_w[q] { st[0].w_bits[q] = 0; st[0].w_ok[q] = false; }
      m := wire_put(e[..], 0, "w"); m = wire_int(e[..], m, q); m = wire_int(e[..], m, v[0].eg[k].wanted[q]);
      eg_out_entry(o[..], v, k, s, f, cast(string) e[0..<m]);
      st[0].heard_w[q] = w1; st[0].w_t[q] = now; st[0].w_bits[q] = st[0].w_bits[q] | (1 << (now % WIRE_ACKS));
    }
  }
  ev_send(v, k, s, full, o[..]);   // the world event and everyone's level (room-events.coax)
  // the events since the last state, near you
  for q: 0..<v[0].eg[k].ev_n {
    if !v[0].eg[k].ev_all[q] && !eg_near(me, v[0].eg[k].ev_x[q], v[0].eg[k].ev_z[q]) { continue; }
    a := v[0].eg[k].ev_at[q];
    eg_out_entry(o[..], v, k, s, f, cast(string) v[0].eg[k].ev[a..<a + v[0].eg[k].ev_len[q]]);
  }
  eg_out_send(o[..], v, k, s, f);
}

// ---- checks

// The host's part for a check: every seat at the gate, then each tick a flat world's step (each
// input moves its seat PX/100 m along x and PY/100 m along z) instead of the shared one.
// The checks' server clock a tick (1/EG_HZ s) on from the last, as the host's is each tick.
eg_test_clock :: (v: [] RmServer) {
  if v[0].eg_test_ticks == 0 { v[0].eg_test_t0 = v[0].mono_ms; }
  v[0].eg_test_ticks += 1;
  rm_clock(v, v[0].eg_test_t0 + (v[0].eg_test_ticks * 1000 + EG_HZ - 1) / EG_HZ, v[0].wall_ms);
}
eg_test_tick :: (v: [] RmServer, k: int) {
  eg_test_clock(v);
  if !rm_eg_begin(v, k) { return; }
  in: [EG_IN_FIELDS] int;
  for s: 0..<EG_SEATS {
    if rm_eg_unplaced(v, k, s) { rm_eg_moved(v, k, s, 0, f32(s), 0, 0, 0, 0, 0, 0, 1, 0, 0); }
    while rm_eg_input(v, k, s, in[..]) {
      p := v[0].eg[k].seat[s].pose;
      rm_eg_moved(v, k, s, in[0], p.x + f32(in[3]) / 100.0, 0, p.z + f32(in[4]) / 100.0, 0, 0, 0, 0, 1, 1, 0);
    }
  }
  xz: [2] f32;
  for q: 0..<rm_eg_beasts() { if rm_eg_beast_at(v, k, q, xz[..]) { rm_eg_beast_ground(v, k, q, 0); } }
  rm_eg_end(v, k);
}
// What conns 0 to EG_TEST_CONNS - 1 heard since the last read, each its frames joined by '|' (the
// queue is read once, for everyone), and each one's page's table as its D's leave it (a mirror, as
// the page's), whose heard tick goes back to the room as the page's next I would say it (unless deaf).
EG_TEST_CONNS :: 4;
EgInbox :: struct { t: [EG_TEST_CONNS * 16384] u8; n: [EG_TEST_CONNS] int; m: [EG_TEST_CONNS] WireMirror; deaf: [EG_TEST_CONNS] bool; }
eg_test_drain :: (v: [] RmServer, box: [] EgInbox) {
  for c: 0..<EG_TEST_CONNS { box[0].n[c] = 0; }
  while true {
    got := rm_relay_next(v);
    if got == 0 { break; }
    for c: 0..<EG_TEST_CONNS {
      if v[0].rto[c] && got > 0 && v[0].rout[0] == 'D' { _ := wire_mirror_frame(box[0].m[c..<c + 1], cast(string) v[0].rout[0..<got]); }
      if !v[0].rto[c] || box[0].n[c] + got + 1 > 16384 { continue; }
      at := c * 16384 + box[0].n[c];
      if box[0].n[c] > 0 { box[0].t[at] = '|'; at += 1; box[0].n[c] += 1; }
      for i: 0..<got { box[0].t[at + i] = v[0].rout[i]; }
      box[0].n[c] += got;
    }
  }
  for c: 0..<EG_TEST_CONNS {
    if box[0].deaf[c] || box[0].m[c].heard == 0 { continue; }
    for k: 0..<EG_ROOMS {
      if !v[0].eg[k].live { continue; }
      for s: 0..<EG_SEATS { if v[0].eg[k].seat[s].live && v[0].eg[k].seat[s].conn == c && v[0].conns[c].relay == v[0].eg[k].relay { eg_seat_heard(v, k, s, box[0].m[c].heard); } }
    }
  }
}
// What conn c's page holds of entity id (WireS id -1: nothing).
eg_test_ent :: (box: [] EgInbox, c: int, id: int) -> WireS { return wire_mirror_of(box[0].m[c..<c + 1], id); }
eg_test_of :: (box: [] EgInbox, c: int) -> string { return cast(string) box[0].t[c * 16384..<c * 16384 + box[0].n[c]]; }
eg_test_has :: (t: string, part: string) -> bool {
  if part.count > t.count { return false; }
  for i: 0..<t.count - part.count + 1 { if t[i..<i + part.count] == part { return true; } }
  return false;
}

#test "everglade room: a hello on another wire version is refused with its reason, and its socket is closed (#12788)" {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-old HTTP/1.1\r\n\r\n";
  box: [1] EgInbox;
  #assert rm_join(v[..], 0, ev) == 0 && rm_join(v[..], 1, ev) == 1;
  eg_test_drain(v[..], box[..]);
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 3 ranger.0.0.0 druid 0 Old");   // a page from before this release
  rm_heard(v[..], 1, "H 4 ranger.0.0.0 druid 0 New");
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 0), "r 0 version") && rm_relay_kicked(v[..], 0);
  #assert !eg_test_has(eg_test_of(box[..], 1), "r 0 version") && !rm_relay_kicked(v[..], 1);
  #assert v[0].eg[k].stale_n == 1 && cast(string) v[0].eg[k].seat[1].name[0..<v[0].eg[k].seat[1].name_n] == "New";
}
#test "everglade room: the world's header on joining, each seat's inputs stepped no faster than the tick, everyone's players and names in D" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_control(v[..], "levels 0 2\n");   // the full Everglade character: levels off, as an admin can set
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-sim HTTP/1.1\r\n\r\n";
  box: [1] EgInbox;
  #assert rm_join(v[..], 0, ev) == 0 && rm_join(v[..], 1, ev) == 1;
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 0), "y 0 0 1762190000000|W 0 30 ");
  k := eg_room_at(v[..], v[0].conns[0].relay);
  #assert k >= 0;
  rm_heard(v[..], 0, "H 4 ranger.2.1.0 druid 1 Ash Vale");
  rm_heard(v[..], 1, "H 4 ranger.0.0.0 druid 0 -");
  // seat 0 queues 8 inputs at once: 4 are stepped this tick (its bank), the rest on the next ticks
  for q: 1..<9 {
    t: [64] u8; n := put(t[..], 0, "I"); n = eg_n(t[..], n, q); n = put(t[..], n, " 0 0 0 50 0 1 0");
    rm_heard(v[..], 0, cast(string) t[0..<n]);
  }
  rm_heard(v[..], 0, "I 3 0 0 0 50 0 1 0");   // a repeat goes
  eg_test_tick(v[..], k);
  #assert v[0].eg[k].seat[0].ack == 4 && v[0].eg[k].seat[0].q_n == 4;
  eg_test_tick(v[..], k);   // tick 2: still a snapshot, the page not having said it heard tick 1's
  #assert v[0].eg[k].seat[0].ack == 5;
  eg_test_drain(v[..], box[..]);
  a := eg_test_of(box[..], 0); c := eg_test_of(box[..], 1);
  // your own row first, absolute in a snapshot
  #assert eg_test_has(a, "D 1 4 1 0 s 0 0 ") && eg_test_has(a, "D 2 5 1 0 s 0 0 ");
  #assert eg_test_has(a, ";n 0 - ranger.2.1.0 druid 1 Ash Vale") && eg_test_has(a, ";n 1 - ranger.0.0.0 druid 0 -");
  me := eg_test_ent(box[..], 0, 0); them := eg_test_ent(box[..], 0, 1);
  #assert me.z == 2.5 && me.hp == 57 && me.max == 57 && me.owner == 0 && them.x == 1 && them.kind == WK_PLAYER && them.owner == 1;
  // seat 1 hears seat 0, with seat 1's own ACK (none yet)
  #assert eg_test_has(c, "D 2 0 1 0 s 1 0 ") && eg_test_ent(box[..], 1, 0).z == 2.5;
  // the page heard tick 2: the next frames are deltas against it, only what changed (seat 0's Z; seat
  // 1's own row every frame, empty; the names not again)
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  c = eg_test_of(box[..], 1);
  #assert eg_test_has(c, "D 4 0 0 0 s 1 2 0;s 0 2 8 100") && !eg_test_has(c, "n 0") && eg_test_ent(box[..], 1, 0).z == 3.5;
  // a bad input is dropped whole
  waiting := v[0].eg[k].seat[0].q_n;
  rm_heard(v[..], 0, "I 20 0 0 x 50 0 1");
  rm_heard(v[..], 0, "I 21 0 0 50 0 0 1");
  #assert v[0].eg[k].seat[0].q_n == waiting;
}

eg_test_input :: (v: [] RmServer, seq: int) {
  t: [64] u8; n := put(t[..], 0, "I"); n = eg_n(t[..], n, seq); n = put(t[..], n, " 0 0 0 10 0 1 0");
  rm_heard(v, 0, cast(string) t[0..<n]);
}
#test "everglade room: a seat whose socket is behind gets its own row only, and the rest once it catches up" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_control(v[..], "levels 0 2\n");
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-behind HTTP/1.1\r\n\r\n";
  box: [1] EgInbox;
  #assert rm_join(v[..], 0, ev) == 0 && rm_join(v[..], 1, ev) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 4 ranger.0.0.0 druid 0 -"); rm_heard(v[..], 1, "H 4 ranger.0.0.0 druid 0 -");
  for t: 0..<3 { eg_test_tick(v[..], k); eg_test_drain(v[..], box[..]); }
  // seat 0 walks; seat 1's socket has 10 KB waiting: its frame holds its own row, not seat 0's
  rm_conn_waiting(v[..], 1, 10000);
  for q: 1..<4 { eg_test_input(v[..], q); }
  eg_test_tick(v[..], k); eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 1), "s 1 ") && !eg_test_has(eg_test_of(box[..], 1), "s 0 ") && v[0].eg[k].behind_n == 1;
  // caught up: seat 0's row, where it is now
  rm_conn_waiting(v[..], 1, 0);
  eg_test_tick(v[..], k); eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 1), "s 0 ") && eg_test_ent(box[..], 1, 0).z == eg_test_ent(box[..], 0, 0).z;
}
#test "everglade room: the watch's Hold Person on a seat is an effect entity on every page, its start and length the rules' time left, gone when it ends" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_control(v[..], "levels 0 2\n");
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-fx HTTP/1.1\r\n\r\n";
  box: [1] EgInbox;
  #assert rm_join(v[..], 0, ev) == 0 && rm_join(v[..], 1, ev) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 4 ranger.0.0.0 druid 0 -"); rm_heard(v[..], 1, "H 4 ranger.0.0.0 druid 0 -");
  for t: 0..<3 { eg_test_tick(v[..], k); eg_test_drain(v[..], box[..]); }
  id := WIRE_ID_MADE + EG_FX_ID + 1 * WE_WATCH + WE_HOLD_PERSON;
  // the world holds seat 1 for 3 s: a row on both pages
  rm_eg_cond_left(v[..], k, 1, WE_HOLD_PERSON, 3.0);
  t0 := v[0].eg[k].tick;
  eg_test_tick(v[..], k); eg_test_drain(v[..], box[..]);
  for c: 0..<2 {
    e := eg_test_ent(box[..], c, id);
    #assert e.kind == WK_EFFECT && e.owner == WIRE_TGT_SEAT + 1 && e.p1 == WE_HOLD_PERSON && e.p2 == WC_PARALYZED && e.t0 == t0 && e.dur == 3 * WIRE_HZ;
  }
  // a tick on, less left: the same row (no bytes); then it ends: gone on both
  rm_eg_cond_left(v[..], k, 1, WE_HOLD_PERSON, 2.96);
  eg_test_tick(v[..], k); eg_test_drain(v[..], box[..]);
  #assert eg_test_ent(box[..], 0, id).t0 == t0 && !eg_test_has(eg_test_of(box[..], 0), "s 1150003 ");
  rm_eg_cond_left(v[..], k, 1, WE_HOLD_PERSON, 0);
  for t: 0..<2 { eg_test_tick(v[..], k); eg_test_drain(v[..], box[..]); }
  #assert eg_test_ent(box[..], 0, id).id < 0 && eg_test_ent(box[..], 1, id).id < 0;
}
#test "everglade room: a page that stalls spends the steps it is owed, and its inputs wait no tick after (#12731)" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-stall HTTP/1.1\r\n\r\n";
  #assert rm_join(v[..], 0, ev) == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  eg_test_tick(v[..], k);
  seq := 0;
  // a steady page: one input a tick, each stepped the tick it comes
  for q: 0..<30 { seq += 1; eg_test_input(v[..], seq); eg_test_tick(v[..], k); #assert v[0].eg[k].seat[0].ack == seq; }
  // it stalls 8 ticks, then sends the 8 steps it owes at once (as a busy browser does), and goes on
  for q: 0..<8 { eg_test_tick(v[..], k); }
  for q: 0..<9 { seq += 1; eg_test_input(v[..], seq); }
  eg_test_tick(v[..], k);
  #assert v[0].eg[k].seat[0].ack == seq - 5;   // 4 at most a tick
  seq += 1; eg_test_input(v[..], seq); eg_test_tick(v[..], k);
  seq += 1; eg_test_input(v[..], seq); eg_test_tick(v[..], k);
  #assert v[0].eg[k].seat[0].ack == seq && v[0].eg[k].seat[0].q_n == 0;   // caught up: nothing waits
  // it stalls a long while: half a second is kept, no more (a page can't bank time to run ahead)
  for q: 0..<90 { eg_test_tick(v[..], k); }
  #assert v[0].eg[k].seat[0].bank == EG_BANK;
  // it sends 16 at once: 4 a tick, its bank covering them; then 16 more at once with the bank spent:
  // those past its owed time and EG_KEEP ticks go, the rest are stepped as the clock owes them (no page runs ahead)
  was := v[0].eg[k].seat[0].ack;
  for q: 0..<16 { seq += 1; eg_test_input(v[..], seq); }
  for q: 0..<4 { eg_test_tick(v[..], k); }
  #assert v[0].eg[k].seat[0].ack == was + 16 && v[0].eg[k].seat[0].bank == EG_BANK - 16 + 3;   // (the first tick's step past a full bank is lost)
  was = v[0].eg[k].seat[0].ack;
  for q: 0..<16 { seq += 1; eg_test_input(v[..], seq); }
  for q: 0..<4 { eg_test_tick(v[..], k); }
  // owed 3 at the first tick: the 9 oldest past 3 + EG_KEEP go; 3 then step, and one a tick after
  #assert v[0].eg[k].seat[0].late == 16 - 3 - EG_KEEP && v[0].eg[k].seat[0].ack == was + 15 && v[0].eg[k].seat[0].q_n == 1;
}

#test "everglade room: a seat earns its steps by the server's clock, so a late tick or a host stall leaves no queue standing (#12718)" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-owe HTTP/1.1\r\n\r\n";
  #assert rm_join(v[..], 0, ev) == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  eg_test_tick(v[..], k);
  seq := 0;
  for q: 0..<30 { seq += 1; eg_test_input(v[..], seq); eg_test_tick(v[..], k); }
  #assert v[0].eg[k].seat[0].ack == seq;
  v[0].eg[k].seat[0].bank = 0;   // nothing owed (what it sat with spent)
  // the host stalls 400 ms (no tick ran); the page sent its 12 inputs meanwhile
  for q: 0..<12 { seq += 1; eg_test_input(v[..], seq); }
  v[0].eg_test_ticks += 12;
  // then one a tick again: the 12 drain at 4 a tick, and nothing waits after
  for q: 0..<6 { seq += 1; eg_test_input(v[..], seq); eg_test_tick(v[..], k); }
  #assert v[0].eg[k].seat[0].ack == seq && v[0].eg[k].seat[0].q_n == 0;
  // ticks that run late: a page's 30 a second over 21 ticks that came in 1 s still all step in that second
  for q: 0..<30 { seq += 1; eg_test_input(v[..], seq); if q % 3 != 2 { eg_test_tick(v[..], k); } else { v[0].eg_test_ticks += 1; } }
  for q: 0..<2 { eg_test_tick(v[..], k); }
  #assert v[0].eg[k].seat[0].ack == seq && v[0].eg[k].seat[0].q_n == 0;
  // a page sending 33 a second (its clock fast, or a cheat): its queue never stands more than EG_KEEP
  // ticks past what it is owed, so its input-to-ACK stays bounded instead of growing to the queue's 16
  for q: 0..<300 { seq += 1; eg_test_input(v[..], seq); if q % 10 == 0 { seq += 1; eg_test_input(v[..], seq); } eg_test_tick(v[..], k); #assert v[0].eg[k].seat[0].q_n <= EG_KEEP + 1; }
  #assert v[0].eg[k].seat[0].ack >= seq - EG_KEEP - 1 && v[0].eg[k].seat[0].late > 0;
}

#test "everglade room: a Warlock's seat casts the Warlock's bar and not the druid's; a druid's seat not the Warlock's; everyone hears the cast" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_control(v[..], "levels 0 2\n");   // the full Everglade character: levels off, as an admin can set
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-warlock HTTP/1.1\r\n\r\n";
  box: [1] EgInbox;
  #assert rm_join(v[..], 0, ev) == 0 && rm_join(v[..], 1, ev) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 4 ranger.0.0.0 warlock 0 -");
  rm_heard(v[..], 1, "H 4 ranger.0.0.0 druid 0 -");
  #assert v[0].eg[k].rules[0].klass[0] == 1 && v[0].eg[k].rules[0].klass[1] == 0;
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  // Eldritch Blast (slot 64) at (4, 7): within its 120 feet
  rm_heard(v[..], 0, "C 1 64 400 0 700 -1");
  for q: 0..<4 { eg_test_tick(v[..], k); }
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 0), ";e cast 0 64 400 0 700 ") && eg_test_has(eg_test_of(box[..], 1), ";e cast 0 64 400 0 700 ");
  for q: 0..<10 { eg_test_tick(v[..], k); }
  eg_test_drain(v[..], box[..]);
  // the druid's Thunderbolt from the Warlock, and Eldritch Blast from the druid: refused
  rm_heard(v[..], 0, "C 2 1 400 0 700 -1");
  rm_heard(v[..], 1, "C 3 64 400 0 700 -1");
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 0), "r 2 slot") && eg_test_has(eg_test_of(box[..], 1), "r 3 slot");
  // Blight's 30 feet: a cast 20 m off is out of range
  rm_heard(v[..], 0, "C 4 66 2000 0 0 -1");
  eg_test_tick(v[..], k);   // (checked at its start: room-casts.coax)
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 0), "r 4 range");
}

#test "everglade room: the wolves one seat conjures are in both seats' state and the other can kill one; a heal reaches the other; a joiner's snapshot has the pack; it outlasts its caster's leaving" #steps 4000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_control(v[..], "levels 0 2\n");   // the full Everglade character: levels off, as an admin can set
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-pack HTTP/1.1\r\n\r\n";
  box: [1] EgInbox;
  #assert rm_join(v[..], 0, ev) == 0 && rm_join(v[..], 1, ev) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  // Conjure Animals at (4, 7): seat 0 stands at x 0, seat 1 at x 1
  rm_heard(v[..], 0, "C 1 32 400 0 700 -1");
  for q: 0..<4 { eg_test_tick(v[..], k); }
  eg_test_drain(v[..], box[..]);
  a := eg_test_of(box[..], 0); c := eg_test_of(box[..], 1);
  #assert eg_test_has(a, ";e cast 0 32 400 0 700 ") && eg_test_has(c, ";e cast 0 32 400 0 700 ");
  // four wolves (WK_BEAST 12, form 1, 11 Hit Points), ids 1 to 4, owner seat 0, once the ground under them is known
  for c2: 0..<2 {
    for w: 1..<5 { wf := eg_test_ent(box[..], c2, WIRE_ID_MADE + w); #assert wf.kind == WK_BEAST && wf.owner == 0 && wf.p1 == 1 && wf.hp == 11 && wf.max == 11; }
  }
  // seat 1 hurts wolf 2 until it is gone: everyone hears it hit, die and go
  e5rr_hurt(v[0].eg[k].rules[..], E5RR_TGT_BEAST + 2, 30, -1);
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 0), "x 200002") && eg_test_has(eg_test_of(box[..], 1), "x 200002") && eg_test_has(eg_test_of(box[..], 1), "e die 2002");
  #assert eg_test_ent(box[..], 1, WIRE_ID_MADE + 2).id == -1 && eg_test_ent(box[..], 1, WIRE_ID_MADE + 1).id == WIRE_ID_MADE + 1;
  // too far: refused, to the caster only
  for q: 0..<10 { eg_test_tick(v[..], k); }
  eg_test_drain(v[..], box[..]);
  rm_heard(v[..], 1, "C 2 1 50000 0 0 -1");
  eg_test_tick(v[..], k);   // (checked at its start: room-casts.coax)
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 1), "r 2 range") && !eg_test_has(eg_test_of(box[..], 0), "r 2") && !eg_test_has(eg_test_of(box[..], 0), "e cast 1 1 ");
  // seat 1 hurt by the world, then healed by seat 0's Healing Word
  e5rr_hurt(v[0].eg[k].rules[..], EG_TGT_SEAT + 1, 30, -1);
  rm_heard(v[..], 0, "C 3 28 100 0 0 1001");
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 1), ";e heal 1001 ");
  // a third joins: its snapshot holds every player and the pack
  #assert rm_join(v[..], 2, ev) == 2;
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  j := eg_test_of(box[..], 2);
  #assert eg_test_ent(box[..], 2, 0).id == 0 && eg_test_ent(box[..], 2, 1).id == 1 && eg_test_ent(box[..], 2, 2).id == 2 && eg_test_has(j, ";n 0 - ");
  #assert eg_test_ent(box[..], 2, WIRE_ID_MADE + 1).kind == WK_BEAST && eg_test_ent(box[..], 2, WIRE_ID_MADE + 2).id == -1;
  // seat 0 leaves: the others hear it gone, and its pack stays (until its Concentration's 10 minutes)
  rm_left(v[..], 0);
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  #assert eg_test_ent(box[..], 1, 0).id == -1 && eg_test_ent(box[..], 1, WIRE_ID_MADE + 1).id >= 0 && eg_test_ent(box[..], 1, WIRE_ID_MADE + 4).id >= 0;
}

#test "everglade room: what is over 120 m off isn't in a seat's state; seat 1 hears seat 0's Moonbeam once it walks up, and its end" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_control(v[..], "levels 0 2\n");   // the full Everglade character: levels off, as an admin can set
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-far HTTP/1.1\r\n\r\n";
  box: [1] EgInbox;
  #assert rm_join(v[..], 0, ev) == 0 && rm_join(v[..], 1, ev) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  eg_test_tick(v[..], k);
  rm_eg_moved(v[..], k, 1, 0, 200, 0, 0, 0, 0, 0, 0, 1, 0, 0);   // seat 1 is 200 m off
  rm_heard(v[..], 0, "C 1 20 300 0 0 -1");                     // Moonbeam 3 m from seat 0
  eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  a := eg_test_of(box[..], 0); c := eg_test_of(box[..], 1);
  mb := eg_test_ent(box[..], 0, WIRE_ID_MADE + 1);
  #assert mb.kind == WK_ZONE && mb.owner == 0 && mb.p1 == 16 && eg_test_ent(box[..], 1, WIRE_ID_MADE + 1).id == -1 && !eg_test_has(c, "e cast");
  #assert eg_test_ent(box[..], 1, 0).id == 0;   // players are always heard
  rm_eg_moved(v[..], k, 1, 0, 10, 0, 0, 0, 0, 0, 0, 1, 0, 0);
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  #assert eg_test_ent(box[..], 1, WIRE_ID_MADE + 1).kind == WK_ZONE;
  rm_eg_moved(v[..], k, 1, 0, 300, 0, 0, 0, 0, 0, 0, 1, 0, 0);
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 1), "x 200001") && eg_test_ent(box[..], 1, WIRE_ID_MADE + 1).id == -1;
  // seat 0 ends it (E SEQ 5 SLOT): gone for seat 0 too; ending it again is refused
  rm_heard(v[..], 0, "E 2 5 20");
  eg_test_tick(v[..], k); eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 0), "x 200001") && eg_test_ent(box[..], 0, WIRE_ID_MADE + 1).id == -1;
  rm_heard(v[..], 0, "E 3 5 20");
  eg_test_drain(v[..], box[..]);
  #assert eg_test_of(box[..], 0) == "r 3 nothing";
}
