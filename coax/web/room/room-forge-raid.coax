// The desktop controls the actual world event, not a second NPC simulation.
ev_siege_caps :: (v:[]RmServer,k:int) {
  if v[0].dev.on && v[0].forge.raid_local {v[0].ev[k].caps[0]=v[0].forge.raid_cult;v[0].ev[k].caps[1]=24;}
  else {raid_siege_caps(v[0].evc.d.size,v[0].ev[k].caps[..]);}
}
fg_raid_show :: (v:[]RmServer,k:int) {
  r:=ev_rules(v,k);j:[1]Jo;jo_start(j[..],v[0].forge.out[..]);jo_obj(j[..]);
  jo_key(j[..],"ok");jo_bool(j[..],true);jo_key(j[..],"version");jo_int(j[..],v[0].forge.raid_version);
  jo_key(j[..],"active");jo_bool(j[..],v[0].evc.siege);jo_key(j[..],"phase");jo_int(j[..],v[0].ev[k].phase);
  jo_key(j[..],"cult_target");jo_int(j[..],v[0].forge.raid_cult);jo_key(j[..],"cult_alive");jo_int(j[..],e5rd_standing(r));
  jo_key(j[..],"watch_target");jo_int(j[..],24);jo_key(j[..],"watch_alive");jo_int(j[..],e5rd_town_standing(r));
  jo_key(j[..],"wards");jo_int(j[..],e5rd_wards(r));jo_key(j[..],"leader");jo_int(j[..],v[0].ev[k].arch);
  jo_key(j[..],"sent");jo_int(j[..],v[0].ev[k].sent);jo_key(j[..],"front_z_cm");jo_int(j[..],eg_round(v[0].ev[k].front[0].z*100));
  jo_end(j[..]);v[0].forge.n=jo_text(j[..]).count;
}
fg_raid_api :: (v:[]RmServer,req:string)->int {
  get:=dv_path(req,"GET","/api/playtest/forge/raid ");post:=dv_path(req,"POST","/api/playtest/forge/raid ");if !get && !post {return 0;}
  if !fnp_access(v[0].dev.on,v[0].dev.admin) {_:=fg_answer(v,false,"Local admin access is required.");return 403;}
  k:=fg_room(v);if k<0 {_:=fg_answer(v,false,"Exactly one active local Everglade room is required.");return 409;}
  if get {fg_raid_show(v,k);return 200;}
  c:[1]FrCommand;if !fr_parse(dv_body(req),c[..]) {_:=fg_answer(v,false,"Invalid raid command: start, stop, double, wave, or set.");return 400;}
  if !fnp_write(c[0].base,v[0].forge.raid_version) {_:=fg_answer(v,false,"Raid revision changed or was exhausted. Read raid again.");return 409;}
  if !fr_phase(c[0].op,v[0].ev[k].phase) {_:=fg_answer(v,false,"Start requires an inactive event; army edits require the active siege before the camp stand.");return 409;}
  r:=ev_rules(v,k);target:=fr_target(c[0].op,v[0].forge.raid_cult,c[0].count);
  if c[0].op!="stop" {
    other:=0;for q:0..<E5RR_BEASTS {bt:=r[0].beasts[q];if !e5rd_is(bt) && (bt.id>0 || bt.forge_id>0) {other+=1;}}
    if !fr_fit(target,other) {_:=fg_answer(v,false,"Army cannot fit: cult target must be 1..60 and cult + 24 watch + 4 leaders/wards + other creatures must fit 96 slots. Nothing changed.");return 400;}
  }
  v[0].forge.raid_local=true;v[0].evc.known=true;v[0].evc.d.every=0;
  if c[0].op=="stop" {v[0].evc.siege=false;v[0].evc.d.on=false;ev_stop(v,k);ev_raid_clear(v,k);}
  else {
    v[0].forge.raid_cult=target;v[0].evc.d.on=true;v[0].evc.siege=true;r[0].raid[0].limit=E5RR_BEASTS;
    if c[0].op=="start" {
      ev_raid_clear(v,k);v[0].ev[k].phase=EV_IDLE;ev_start(v,k);ev_siege_begin(v,k);
    }else{
      ev_siege_caps(v,k);n:=e5rd_standing(r);
      q:=E5RR_BEASTS-1;while n>target && q>=0 {
        bt:=r[0].beasts[q];if e5rd_cult(bt) && bt.form!=E5RR_FORM_WARD && bt.form!=E5RR_FORM_RAID+RS_NPC_ARCH {
          e5b_gone(r[0].b[..],r[0].beasts[..],E5RR_BEAST0,q);n-=1;
        }q-=1;
      }
      ev_muster(v,k,RF_CULT,target-n);
    }
  }
  v[0].forge.raid_version+=1;v[0].ev[k].standing=e5rd_standing(r);v[0].ev[k].town=e5rd_town_standing(r);
  v[0].ev[k].g_tick= -1;ev_cache(v,k);fg_raid_show(v,k);return 200;
}

#test "local forge event starts real armies doubles only the cult refuses overflow and stops without deleting authored NPCs" #steps 2000000000 {
  v:[1]RmServer;rm_init(v[..]);get:="GET /api/playtest/forge/raid HTTP/1.1\r\n\r\n";
  #assert rm_forge_api(v[..],get)==403;v[0].dev.on=true;v[0].dev.admin=true;#assert rm_forge_api(v[..],get)==409;
  rm_clock(v[..],0,1762190000000);#assert rm_join(v[..],0,"GET /api/room/relay/everglade/pair-forge HTTP/1.1\r\n\r\n")==0;
  k:=eg_room_at(v[..],v[0].conns[0].relay);rm_heard(v[..],0,"H 4 ranger.0.0.0 druid 0 Editor");r:=ev_rules(v[..],k);
  #assert r[0].raid[0].limit==64;
  for id:1..<9 {_:=e5rf_spawn(r,ForgeNpc.{id=id,group=1,kind=1});}
  // A dead authored creature still owns its durable slot and may not be replaced.
  dead:=fg_slot(r,8);r[0].beasts[dead].id=0;r[0].b[0].c[E5RR_BEAST0+dead].dead=true;
  #assert rm_forge_api(v[..],"POST /api/playtest/forge/raid HTTP/1.1\r\n\r\n{\"op\":\"start\",\"base\":0}")==200;
  #assert e5rd_standing(r)==30 && e5rd_town_standing(r)==24 && e5rd_wards(r)==3 && v[0].ev[k].arch==EV_ARCH_WARDED;
  #assert rm_forge_api(v[..],"POST /api/playtest/forge/raid HTTP/1.1\r\n\r\n{\"op\":\"double\",\"base\":0}")==409;
  #assert rm_forge_api(v[..],"POST /api/playtest/forge/raid HTTP/1.1\r\n\r\n{\"op\":\"start\",\"base\":1}")==409;
  #assert rm_forge_api(v[..],"POST /api/playtest/forge/raid HTTP/1.1\r\n\r\n{\"op\":\"double\",\"base\":1}")==200;
  #assert e5rd_standing(r)==60 && e5rd_town_standing(r)==24 && v[0].forge.raid_cult==60;
  #assert fg_slot(r,8)==dead && r[0].beasts[dead].id==0 && e5rd_free(r)== -1;
  ev_control_line(v[..],"event 0 0 3 12 6 1 3 3 31 1 2 1 100 15 0 0");ev_control_done(v[..]);ev_siege_second(v[..],k);
  #assert v[0].evc.siege && v[0].ev[k].caps[0]==60;
  #assert rm_forge_api(v[..],"POST /api/playtest/forge/raid HTTP/1.1\r\n\r\n{\"op\":\"wave\",\"base\":2}")==400 && e5rd_standing(r)==60 && v[0].forge.raid_version==2;
  #assert rm_forge_api(v[..],"POST /api/playtest/forge/raid HTTP/1.1\r\n\r\n{\"op\":\"set\",\"count\":10,\"base\":2}")==200 && e5rd_standing(r)==10;
  #assert rm_forge_api(v[..],"POST /api/playtest/forge/raid HTTP/1.1\r\n\r\n{\"op\":\"wave\",\"count\":5,\"base\":3}")==200 && e5rd_standing(r)==15;
  #assert rm_forge_api(v[..],"POST /api/playtest/forge/raid HTTP/1.1\r\n\r\n{\"op\":\"stop\",\"base\":4}")==200;
  #assert !v[0].evc.siege && e5rd_standing(r)==0 && e5rd_town_standing(r)==0 && fg_slot(r,1)>=0;
  #assert rm_forge_api(v[..],"POST /api/playtest/forge/raid HTTP/1.1\r\n\r\n{\"op\":\"wave\",\"base\":5}")==409;
}
