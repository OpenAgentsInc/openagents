// Read production state; never substitute HTTP success, expiry or an ACK for
// durable acceptance. These exports have no admission or persistence effects.
#test "capacity input observations use actual pending inputs and preserve unknown clock ages (#12843)" #steps 2000000000 {
  v:[1]RmServer;k:=rc_test_room(v[..],"pair-input-age",3,false);o:[5]int;
  v[0].mono_ms=1000;v[0].eg[k].seat[0].q_n=2;v[0].eg[k].seat[0].q[0].at=850;v[0].eg[k].seat[0].q[1].at=920;
  v[0].eg[k].seat[1].q_n=1;v[0].eg[k].seat[1].q[0].at=950;v[0].eg[k].seat[1].late=4;
  rm_st_inputs(v[..],o[..]);#assert o[0]==3&&o[1]==150&&o[2]==2&&o[3]==4&&o[4]==0;
  v[0].eg[k].seat[0].live=false;rm_st_inputs(v[..],o[..]);#assert o[0]==1&&o[1]==50&&o[2]==1;
  v[0].eg[k].seat[1].q[0].at=1001;rm_st_inputs(v[..],o[..]);#assert o[1]== -1&&o[4]==1;
  v[0].eg[k].live=false;rm_st_inputs(v[..],o[..]);for q:0..<5{#assert o[q]==0;}
  o[0]=99;rm_st_inputs(v[..],o[0..<4]);#assert o[0]==99;
}
rm_st_inputs::(v:[]RmServer,out:[]int) #export_c {
  if out.count<5{return;}for q:0..<5{out[q]=0;}
  for k:0..<EG_ROOMS{if !v[0].eg[k].live{continue;}
    for s:0..<EG_SEATS{st:=v[0].eg[k].seat[s..<s+1];if !st[0].live{continue;}
      out[0]+=st[0].q_n;out[2]=rs_max(out[2],st[0].q_n);out[3]+=st[0].late;
      for q:0..<st[0].q_n{at:=st[0].q[q].at;if at>v[0].mono_ms{out[4]+=1;}else{out[1]=rs_max(out[1],v[0].mono_ms-at);}}
    }
  }
  if out[4]>0{out[1]= -1;}
}
#test "capacity observations distinguish native slots, connected seats, grace holds and initial gates (#12840)" #steps 2000000000 {
  v:[1]RmServer;k:=rc_test_room(v[..],"pair-capacity-observe",3,false);o:[6]int;
  v[0].eg[k].seat[1].conn= -1;v[0].eg[k].seat[1].held=true;
  v[0].eg[k].seat[2].placed=false;
  rm_st_capacity(v[..],o[..]);
  #assert o[0]==EG_ROOMS&&o[1]==1&&o[2]==EG_ROOMS-1&&o[3]==2&&o[4]==1&&o[5]==1;
  v[0].eg[k].seat[1].live=false;rm_st_capacity(v[..],o[..]);#assert o[3]==2&&o[4]==0&&o[5]==1;
  v[0].eg[k].live=false;rm_st_capacity(v[..],o[..]);#assert o[1]==0&&o[2]==EG_ROOMS&&o[3]==0&&o[4]==0&&o[5]==0;
  o[0]=99;rm_st_capacity(v[..],o[0..<5]);#assert o[0]==99;
}
#test "vitals: failed and late checkpoint posts cannot advance accepted revision or age (#12840)" #steps 4000000000 {
  v:[1]RmServer;ck_test_init(v[..]);k:=ck_test_join(v[..],0,7,CharacterCapture.{});ck_test_place(v[..],k);out:[12]int;
  #assert rm_st_saved(v[..],k,0,out[..])&&out[0]==2&&out[1]==7&&out[3]==0&&out[4]== -1&&out[11]==0;
  #assert rm_checkpoint_due(v[..])>0;rev:=v[0].ck.fly_capture.n[3];rm_checkpoint_answer(v[..],1,500,"");
  #assert rm_st_saved(v[..],k,0,out[..])&&out[3]==0&&out[4]== -1&&out[8]==1;
  rm_clock(v[..],v[0].ck.retry_at,1762190001000);#assert rm_checkpoint_due(v[..])>0;
  b:[256]u8;rm_checkpoint_answer(v[..],2,200,ck_test_receipt(v[..],"duplicate",b[..]));
  #assert rm_st_saved(v[..],k,0,out[..])&&out[2]==101&&out[3]==rev&&out[4]>=0&&out[5]==0&&out[6]==1762190000001&&out[11]==1;
  capture_age:=out[4];rm_clock(v[..],v[0].mono_ms+500,1762190001500);rm_checkpoint_answer(v[..],1,500,"");
  #assert rm_st_saved(v[..],k,0,out[..])&&out[3]==rev&&out[4]==capture_age+500&&out[5]==500;
  totals:[28]int;rm_st_saves(v[..],totals[..]);#assert totals[2]==2&&totals[3]==1&&totals[4]==1&&totals[6]==1&&totals[7]==1&&totals[11]==1;
  out[0]=99;#assert !rm_st_saved(v[..],k,0,out[0..<11])&&out[0]==99;
  #assert !rm_st_saved(v[..],-1,0,out[..])&&!rm_st_saved(v[..],k,EG_SEATS,out[..]);
}
#test "vitals: legacy abandonment and refusal are not durable acceptance (#12840)" #steps 2000000000 {
  v:[1]RmServer;k:=rc_test_room(v[..],"pair-legacy-observe",1,false);
  // A legacy producer may advance its outbox cursor after expiry. The durable
  // marker is separate and starts unknown, including a bare historical 2xx.
  v[0].conns[0].ticket=Ticket.{ok=true,pid_n=3,owner=9};v[0].conns[0].ticket.pid[0]='p';v[0].conns[0].ticket.pid[1]='-';v[0].conns[0].ticket.pid[2]='z';
  rv_note(v[..],"p-z",7,10,20,0);i:=rv_find(v[..],"p-z");v[0].vit.v[i].owner=9;v[0].vit.v[i].acked=v[0].vit.v[i].rev;
  out:[12]int;#assert rm_st_saved(v[..],k,0,out[..])&&out[0]==1&&out[3]==0&&out[4]== -1&&out[11]==0;
  v[0].vit.v[i].durable_rev=3;v[0].vit.v[i].durable_owner=9;v[0].vit.v[i].durable_capture_at=v[0].wall_ms-2000;v[0].vit.v[i].durable_at=v[0].wall_ms-1000;
  #assert rm_st_saved(v[..],k,0,out[..])&&out[3]==3&&out[4]==2000&&out[5]==1000&&out[6]==0&&out[11]==1;
  v[0].conns[0].ticket.owner=10;#assert rm_st_saved(v[..],k,0,out[..])&&out[1]==10&&out[3]==0&&out[4]== -1&&out[11]==0;
}
#test "vitals: the actual legacy receipt preserves the accepted capture through coalescing refusal and expiry (#12840)" #steps 2000000000 {
  v:[1]RmServer;ck_test_init(v[..]);rv_note(v[..],"p-observe",7,10,20,0);i:=rv_find(v[..],"p-observe");
  #assert rm_vitals_due(v[..])>0;rev:=v[0].vit.fly_rev[0];captured:=v[0].vit.fly_capture_at[0];
  rm_clock(v[..],2000,v[0].wall_ms+1000);rv_note(v[..],"p-observe",6,10,21,0);b:[128]u8;
  rm_vitals_answer(v[..],1,200,rv_test_receipt(b[..],101,1,"a"));
  #assert v[0].vit.v[i].durable_rev==rev&&v[0].vit.v[i].durable_capture_at==captured&&v[0].vit.v[i].durable_at==v[0].wall_ms&&v[0].vit.v[i].durable_process==101;
  #assert rm_vitals_due(v[..])>0;rm_vitals_answer(v[..],2,200,rv_test_receipt(b[..],101,2,"u"));#assert v[0].vit.v[i].durable_rev==rev;
  rv_note(v[..],"p-observe",5,10,22,0);rm_clock(v[..],3000,v[0].wall_ms+VITALS_OUTBOX_MS+1);ignored_expiry:=rm_vitals_due(v[..]);
  #assert v[0].vit.gave_up==1&&v[0].vit.v[i].durable_rev==rev&&v[0].vit.v[i].acked>rev;
}
#test "vitals: serialized row gauges name their own worst room and seat (#12840)" #steps 2000000000 {
  v:[1]RmServer;k:=rc_test_room(v[..],"pair-row-observe",2,false);o:[9]int;
  v[0].st.rows_last[k*EG_SEATS]=3;v[0].st.left_last[k*EG_SEATS]=8;
  v[0].st.rows_last[k*EG_SEATS+1]=7;v[0].st.left_last[k*EG_SEATS+1]=2;
  rm_st_rows(v[..],o[..]);#assert o[3]==10&&o[4]==10&&o[5]==k&&o[6]==0&&o[7]==3&&o[8]==8;
  v[0].eg[k].seat[0].live=false;rm_st_rows(v[..],o[..]);#assert o[3]==7&&o[4]==2&&o[6]==1;
}
#test "vitals: local ACK timing consumes only a final actually queued frame for that seat (#12840)" #steps 2000000000 {
  v:[1]RmServer;k:=rc_test_room(v[..],"pair-queued-ack",1,false);v[0].eg[k].seat[0].ack=9;v[0].eg[k].seat[0].ack_at=1250;
  #assert rm_st_sent_ack(v[..],0,"D 4 9 2 0 s 0 0 1 2")== -1;
  #assert rm_st_sent_ack(v[..],0,"D 4 8 0 0 s 0 0 1 2")== -1;
  #assert rm_st_sent_ack(v[..],0,"D 4 9 0 0 s 0 0 1 2")==1250;
  #assert rm_st_sent_ack(v[..],0,"D 4 9 0 0 s 0 0 1 2")== -1&&v[0].eg[k].seat[0].ack_told==0;
}
// The native SDK calls this only after the addressed final D was accepted by
// its socket buffer. Multipart prefixes, stale sequence and generations do not
// consume the sample. This is not network transit or client presentation.
rm_st_sent_ack::(v:[]RmServer,conn:int,text:string)->int #export_c{
  ks:[2]int;if !rm_st_conn(v,conn,ks[..])||text.count<2||text[0]!='D'{return -1;}
  r:[1]WireRd;r[0]=wire_rd(text,1);d:=wire_read_d(text,r[..]);if !r[0].ok||(d.f&2)!=0{return -1;}
  st:=v[0].eg[ks[0]].seat[ks[1]..<ks[1]+1];
  if d.ack!=st[0].ack||d.ack<=st[0].ack_sent_told||st[0].ack_at<=0{return -1;}
  st[0].ack_sent_told=d.ack;return st[0].ack_at;
}
rm_st_saved::(v:[]RmServer,k:int,s:int,out:[]int)->bool #export_c{
  if out.count<12||!rm_eg_live(v,k)||s<0||s>=EG_SEATS||!v[0].eg[k].seat[s].live{return false;}
  for q:0..<12{out[q]=0;}out[4]= -1;out[5]= -1;tk:=eg_ticket(v,k,s);out[1]=tk.owner;
  if tk.schema==2{
    out[0]=2;i:=ck_slot_seat(v,k,s);if i<0{return true;}e:=v[0].ck.slot[i..<i+1];
    out[2]=e[0].accepted_process;out[3]=e[0].acked;out[6]=e[0].accepted_at;out[7]=e[0].latest.n[3];out[8]=ifx e[0].latest.ok&&e[0].latest.n[3]>e[0].acked then 1 else 0;
    out[9]=ifx !ck_can_play(v,k,s)||v[0].ck.finalizing then 1 else 0;out[10]=e[0].accepted_capture_wall;out[11]=ifx e[0].accepted then 1 else 0;
    if e[0].accepted{out[4]=rs_max(0,v[0].mono_ms-e[0].accepted_mono);out[5]=rs_max(0,v[0].mono_ms-e[0].receipt_mono);}return true;
  }
  out[0]=1;pid:=tk.pid;i:=rv_find(v,cast(string)pid[0..<tk.pid_n]);if i<0{return true;}e:=v[0].vit.v[i..<i+1];
  out[7]=e[0].rev;out[8]=ifx e[0].rev>e[0].acked then 1 else 0;
  if e[0].durable_rev>0&&e[0].durable_owner==tk.owner{out[2]=e[0].durable_process;out[3]=e[0].durable_rev;out[10]=e[0].durable_capture_at;out[4]=rs_max(0,v[0].wall_ms-e[0].durable_capture_at);out[5]=rs_max(0,v[0].wall_ms-e[0].durable_at);out[11]=1;}return true;
}
rm_st_saves::(v:[]RmServer,out:[]int) #export_c{
  if out.count<28{return;}for q:0..<28{out[q]=0;}
  out[0]=rm_checkpoint_pending(v);out[1]=ifx v[0].ck.fly then 1 else 0;
  out[2]=v[0].ck.posts;out[3]=v[0].ck.retries;out[4]=v[0].ck.failures;out[5]=v[0].ck.applied;out[6]=v[0].ck.duplicates;out[7]=v[0].ck.late;out[8]=v[0].ck.refused;out[9]=v[0].ck.fenced;
  for i:0..<CF_CAP{e:=v[0].ck.slot[i..<i+1];if !e[0].live{continue;}out[10]+=1;if e[0].accepted{out[11]+=1;out[12]=rs_max(out[12],v[0].mono_ms-e[0].accepted_mono);out[13]=rs_max(out[13],v[0].mono_ms-e[0].receipt_mono);}}
  for k:0..<EG_ROOMS{if rm_checkpoint_paused(v,k){out[14]+=1;}if !v[0].eg[k].live{continue;}for s:0..<EG_SEATS{if v[0].eg[k].seat[s].live{out[26]=rs_max(out[26],eg_ticket(v,k,s).owner);}}}
  out[15]=ifx v[0].ck.finalizing then 1 else 0;out[16]=rm_vitals_pending(v);out[17]=ifx v[0].vit.fly then 1 else 0;
  out[18]=v[0].vit.posts;out[19]=v[0].vit.retried;out[20]=v[0].vit.failed;out[21]=v[0].vit.applied;out[22]=v[0].vit.dup;out[23]=v[0].vit.fenced;out[24]=v[0].vit.gave_up;out[25]=v[0].vit.evicted;out[27]=v[0].st.refused[ST_ELSEWHERE];
}
rm_st_rows::(v:[]RmServer,out:[]int) #export_c{
  if out.count<9{return;}for q:0..<9{out[q]=0;}out[0]=v[0].st.rows;out[1]=v[0].st.row_bytes;out[2]=v[0].st.rows_deferred;out[5]= -1;out[6]= -1;
  for k:0..<EG_ROOMS{if !v[0].eg[k].live{continue;}for s:0..<EG_SEATS{if !v[0].eg[k].seat[s].live||!v[0].eg[k].seat[s].placed{continue;}
    at:=k*EG_SEATS+s;n:=v[0].st.rows_last[at];left:=v[0].st.left_last[at];out[3]+=n;out[4]+=left;
    if out[5]<0||n+left>out[7]+out[8]{out[5]=k;out[6]=s;out[7]=n;out[8]=left;}
  }}
}
rm_st_capacity::(v:[]RmServer,out:[]int) #export_c{
  if out.count<6{return;}for q:0..<6{out[q]=0;}out[0]=EG_ROOMS;
  for k:0..<EG_ROOMS{if !v[0].eg[k].live{out[2]+=1;continue;}out[1]+=1;
    for s:0..<EG_SEATS{st:=v[0].eg[k].seat[s];if !st.live{continue;}
      if st.conn>=0{out[3]+=1;}if eg_held(v,k,s){out[4]+=1;}if !st.placed{out[5]+=1;}
    }
  }
}
