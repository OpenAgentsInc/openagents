#load "../../../aethyr/ids.coax";
// Pages from before wire 3, for a week after its release (#12783, #12788).
//
// A page loaded before wire 3 says hello "H 1" and reads the old state: "D TICK ACK F " and its
// entries whole (p a player, n who they are, f a townsperson, c a creature or zone, a a townsperson
// off their feet, w a WANTED level, x K ID one gone), each sent on a change, with no
// acknowledgement (its socket is ordered and the page keeps what it last heard). Its inputs have no
// HEARD. Nothing reloads such a page on the room's word or the API's: host.js follows action 1
// (navigate) only from the page's own taps (FORK IT), a refusal shows "CAN'T · VERSION" and the
// page tries again. So the room speaks the old wire to it, cut from the same table as every other
// seat's rows, until WIRE_OLD_UNTIL_MS: a page left open over the release plays on in the same
// rooms, and its next load is the new build. After that, or once the API's control answer says
// "oldwire 0", its hello is refused as any other wire's. Remove this file after the window.
// (WIRE_OLD_HELLO and WIRE_OLD_UNTIL_MS: everglade-wire.coax, so the checks know them too)
EG_OLD_FOLK_CM :: 30; EG_OLD_FOLK_CRAD :: 15;   // how far a townsperson moves or turns before an old page hears them again (the old room's)

// Whether the room still seats old pages.
eg_old_open :: (v: [] RmServer) -> bool { return !v[0].ctl.old_shut && v[0].wall_ms < WIRE_OLD_UNTIL_MS; }

// Seat seat's hello was an old page's: from now its state goes on the old wire, a snapshot first.
eg_old_seat :: (v: [] RmServer, k: int, seat_id: SeatId) { seat := seat_id.value;
  st := v[0].eg[k].seat[seat..<seat + 1];
  if st[0].old { return; }
  st[0].old = true; st[0].full = true; st[0].full_t = 0; st[0].pieces = 0;
  v[0].eg[k].old_n += 1;
}

// I SEQ KX KY PX PY THETA B: an old page's step (THETA in centiradians, kept in WIRE_FINE units), queued
// as eg_heard_input does.
eg_old_input :: (v: [] RmServer, k: int, seat_id: SeatId, text: string) { seat := seat_id.value;
  if eg_fields(text) != 8 { return; }
  r: [1] WireRd; r[0] = wire_rd(text, 1);
  seq := wire_num(text, r[..]); kx := wire_num(text, r[..]); ky := wire_num(text, r[..]);
  px := wire_num(text, r[..]); py := wire_num(text, r[..]); theta := wire_num(text, r[..]); b := wire_num(text, r[..]);
  if !r[0].ok { return; }
  st := v[0].eg[k].seat[seat..<seat + 1];
  n := st[0].q_n;
  if seq <= st[0].ack || (n > 0 && seq <= st[0].q[n - 1].seq) { return; }   // old or repeated
  if n >= EG_INPUTS {
    for i: 1..<EG_INPUTS { st[0].q[i - 1] = st[0].q[i]; }
    n = EG_INPUTS - 1;
  }
  st[0].q[n] = EgIn.{seq = seq, kx = eg_clamp(kx, -100, 100), ky = eg_clamp(ky, -100, 100), px = eg_clamp(px, -100, 100), py = eg_clamp(py, -100, 100),
                     theta = eg_clamp(theta * (WIRE_FINE / 100), -40000, 40000), b = eg_clamp(b, 0, 31), at = v[0].mono_ms};
  st[0].q_n = n + 1;
}

// x K ID: entity id (a table id) gone, as the old wire names it.
eg_old_x :: (out: [] u8, at: int, id: int) -> int {
  n := wire_put(out, at, ifx id < WIRE_ID_FOLK then "x p" else ifx id < WIRE_ID_MADE then "x f" else "x c");
  return wire_int(out, n, ifx id < WIRE_ID_FOLK then id else ifx id < WIRE_ID_MADE then id - WIRE_ID_FOLK else id - WIRE_ID_MADE);
}
eg_old_f :: (f: [] s32, q: int) -> int { return cast(int) f[q]; }
// Table row f (entity id) as its old entry into out: its bytes, 0 for what the old wire has no word
// for (an effect: the old page reads it from the player's COND).
eg_old_row :: (f: [] s32, id: int, out: [] u8) -> int {
  kind := eg_old_f(f, WS_KIND);
  if kind == WK_EFFECT || kind == WK_DOORS { return 0; }
  if id < WIRE_ID_FOLK {
    // p SS X Y Z YAW VX VY VZ G CLIP HP MAX TEMP COND FORM CARRY
    n := wire_int(out, wire_put(out, 0, "p"), id);
    for q: WS_X..<WS_HP { if q != WS_KIND { n = wire_int(out, n, eg_old_f(f, q)); } }
    n = wire_int(out, n, eg_old_f(f, WS_HP)); n = wire_int(out, n, eg_old_f(f, WS_MAX)); n = wire_int(out, n, eg_old_f(f, WS_TEMP));
    n = wire_int(out, n, eg_old_f(f, WS_COND)); n = wire_int(out, n, eg_old_f(f, WS_FORM)); n = wire_int(out, n, eg_old_f(f, WS_CARRY));
    return n;
  }
  if id < WIRE_ID_MADE {
    // f I X Z YAW CLIP MODE HP (the table's G is the mode)
    n := wire_int(out, wire_put(out, 0, "f"), id - WIRE_ID_FOLK);
    n = wire_int(out, n, eg_old_f(f, WS_X)); n = wire_int(out, n, eg_old_f(f, WS_Z)); n = wire_int(out, n, eg_old_f(f, WS_YAW));
    n = wire_int(out, n, eg_old_f(f, WS_CLIP)); n = wire_int(out, n, eg_old_f(f, WS_G)); n = wire_int(out, n, eg_old_f(f, WS_HP));
    return n;
  }
  // c EID KIND X Y Z YAW HP F OWNER P1 P2 (the table's G is F; a beast's P2 was its most Hit Points)
  n := wire_int(out, wire_put(out, 0, "c"), id - WIRE_ID_MADE);
  n = wire_int(out, n, kind);
  n = wire_int(out, n, eg_old_f(f, WS_X)); n = wire_int(out, n, eg_old_f(f, WS_Y)); n = wire_int(out, n, eg_old_f(f, WS_Z)); n = wire_int(out, n, eg_old_f(f, WS_YAW));
  n = wire_int(out, n, eg_old_f(f, WS_HP)); n = wire_int(out, n, eg_old_f(f, WS_G)); n = wire_int(out, n, eg_old_f(f, WS_OWNER));
  n = wire_int(out, n, eg_old_f(f, WS_P1)); n = wire_int(out, n, ifx kind == WK_BEAST then eg_old_f(f, WS_MAX) else eg_old_f(f, WS_P2));
  return n;
}
eg_old_snap :: (v: int, step: int) -> int { return ifx v >= 0 then (v + step / 2) / step else -((-v + step / 2) / step); }
// What an old page is sent again on: the entry itself, a townsperson's where snapped as the old room did.
eg_old_hash :: (f: [] s32, id: int, row: string) -> int {
  if id < WIRE_ID_FOLK || id >= WIRE_ID_MADE { return eg_hash(row); }
  t: [96] u8;
  n := wire_int(t[..], wire_put(t[..], 0, "f"), id);
  n = wire_int(t[..], n, eg_old_snap(eg_old_f(f, WS_X), EG_OLD_FOLK_CM)); n = wire_int(t[..], n, eg_old_snap(eg_old_f(f, WS_Z), EG_OLD_FOLK_CM));
  n = wire_int(t[..], n, eg_old_snap(eg_old_f(f, WS_YAW), EG_OLD_FOLK_CRAD));
  n = wire_int(t[..], n, eg_old_f(f, WS_CLIP)); n = wire_int(t[..], n, eg_old_f(f, WS_G)); n = wire_int(t[..], n, eg_old_f(f, WS_HP));
  return eg_hash(cast(string) t[0..<n]);
}

// Seat st's old entries for this tick (h's newest) into out, ';' apart: an x for each entity its page
// holds that is gone, out of view or another now, then each entity in view that changed since it was
// last sent (its own player every tick: its ACK is where the page re-runs from). WireSeat's held is
// what the page holds, last the hash it was sent at, base a townsperson's height it was sent (a).
// only_me: its socket is behind, only its own row (the rest go once it catches up).
eg_old_rows :: (st: [] WireSeat, h: [] WireHist, me: int, pick: [] f32, only_me: bool, out: [] u8) -> int {
  now := h[0].now; row := now % WIRE_BASES;
  n := 0; e: [WIRE_ROW] u8;
  for q: 0..<WIRE_SLOTS {
    if only_me && q != me { continue; }
    id1 := cast(int) h[0].id[row * WIRE_SLOTS + q];
    a := (row * WIRE_SLOTS + q) * WIRE_SF;
    f := h[0].f[a..<a + WIRE_SF];
    seen := id1 != 0 && (q == me || pick[q] >= 0);   // its interest pick (room-blocks.coax eg_im_pick, #12789)
    m := ifx seen then eg_old_row(f, id1 - 1, e[..]) else 0;
    held := cast(int) st[0].held[q];
    if held != 0 && (m == 0 || held != id1) {
      if n + 16 > out.count { continue; }
      if n > 0 { n = wire_sep(out, n); }
      n = eg_old_x(out, n, held - 1);
      st[0].held[q] = 0; st[0].last[q] = 0; st[0].base[q] = 0;
    }
    if m == 0 { continue; }
    hh := eg_old_hash(f, id1 - 1, cast(string) e[0..<m]);
    if q != me && cast(int) st[0].held[q] == id1 && hh == st[0].last[q] { continue; }
    if n + m + 40 > out.count { continue; }   // (the next tick)
    if n > 0 { n = wire_sep(out, n); }
    for i: 0..<m { out[n + i] = e[i]; }
    n += m;
    st[0].held[q] = wire_s32(id1); st[0].last[q] = hh;
    // a townsperson off their feet (the world's abilities: Reverse Gravity): a I CM, and once at 0
    y := eg_old_f(f, WS_Y);
    if id1 - 1 >= WIRE_ID_FOLK && id1 - 1 < WIRE_ID_MADE && y != st[0].base[q] {
      n = wire_sep(out, n); n = wire_int(out, wire_put(out, n, "a"), id1 - 1 - WIRE_ID_FOLK); n = wire_int(out, n, y);
      st[0].base[q] = y;
    }
  }
  st[0].bytes = n;
  return n;
}

// Seat s's state this tick on the old wire: a D frame (in parts past EG_CHUNK, F 2 on all but the
// last) of its entries, who each seat is and their WANTED levels on a change, the world's event, and
// the events near it. Its first after the hello is a snapshot (F 1 on its last part), the town's broken
// pieces with it; the old page needs no word back to end it.
eg_old_send :: (v: [] RmServer, k: int, s_id: SeatId) { s := s_id.value;
  st := v[0].eg[k].seat[s..<s + 1];
  full := st[0].full;
  f := ifx full then 1 else 0;
  o: [1] EgOut; o[0].old = true;
  me := st[0].pose;
  e: [320] u8;
  if full {
    wire_seat_reset(st[0].rep[..]);
    for q: 0..<EG_SEATS { st[0].heard_n[q] = 0; st[0].heard_w[q] = 0; }
    st[0].full = false; st[0].pieces = EG_PIECES_ALL;
    for q: 0..<EG_PIECES {
      if v[0].eg[k].broken[q] { n := eg_put_break(e[..], q, 0, 0, 0); eg_out_entry(o[..], v, k, s_id, f, cast(string) e[0..<n]); }
      else if v[0].eg[k].burning[q] { n := eg_put_burn(e[..], q, true); eg_out_entry(o[..], v, k, s_id, f, cast(string) e[0..<n]); }
    }
  }
  eg_table(v, k);
  rm := v[0].eg[k..<k + 1];
  rows: [WIRE_SLOTS * 96] u8;
  c := st[0].conn;
  behind := !full && c >= 0 && c < CONNS && v[0].conns[c].waiting > EG_BEHIND;
  if behind { v[0].eg[k].behind_n += 1; }
  pick: [WIRE_SLOTS] f32;
  eg_im_pick(v, k, s_id, me.x, me.z, pick[..]);
  unseen := eg_im_unseen(v, k, s_id, pick[..]);
  n := eg_old_rows(st[0].rep[..], rm[0].hist[..], s, pick[..], behind, rows[..]);
  for q: 0..<wire_entries(cast(string) rows[0..<n], 0) {
    en := wire_entry(cast(string) rows[0..<n], 0, q);
    if en.count > 0 { eg_out_entry(o[..], v, k, s_id, f, en); }
  }
  for q: 0..<EG_SEATS {
    other := v[0].eg[k].seat[q];
    if !other.live || !other.placed || ((unseen >> q) & 1) != 0 { st[0].heard_n[q] = 0; st[0].heard_w[q] = 0; continue; }
    h := rm[0].cn_h[q];
    if h != st[0].heard_n[q] { a := q * EG_ENT; eg_out_entry(o[..], v, k, s_id, f, cast(string) rm[0].cn[a..<a + rm[0].cn_n[q]]); st[0].heard_n[q] = h; }
    w1 := v[0].eg[k].wanted[q] + 1;
    if w1 != st[0].heard_w[q] {
      m := wire_put(e[..], 0, "w"); m = wire_int(e[..], m, q); m = wire_int(e[..], m, v[0].eg[k].wanted[q]);
      eg_out_entry(o[..], v, k, s_id, f, cast(string) e[0..<m]);
      st[0].heard_w[q] = w1;
    }
  }
  ev_send(v, k, s_id, full, unseen, o[..]);
  for q: 0..<v[0].eg[k].ev_n {
    if !v[0].eg[k].ev_all[q] && ((v[0].eg[k].ev_who[q] >> s) & 1) == 0 && !eg_near(me, v[0].eg[k].ev_x[q], v[0].eg[k].ev_z[q]) { continue; }   // (aimed at s: wherever it is)
    if eg_im_event_withheld(v, k, s_id, SeatId.{value = q}, unseen) { continue; }
    a := v[0].eg[k].ev_at[q];
    eg_out_entry(o[..], v, k, s_id, f, cast(string) v[0].eg[k].ev[a..<a + v[0].eg[k].ev_len[q]]);
  }
  eg_out_send(o[..], v, k, s_id, f);
}

#test "everglade room: a page from before wire 3 plays on the old wire for the window, beside a new page; after it, it is refused (#12783)" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_control(v[..], "levels 0 2\n");
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-oldwire HTTP/1.1\r\n\r\n";
  box: [1] EgInbox;
  #assert rm_join(v[..], 0, ev) == 0 && rm_join(v[..], 1, ev) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 5 ranger.0.0.0 druid 0 New");
  rm_heard(v[..], 1, "H 1 ranger.0.0.0 druid 0 Old");   // the page production served before this release
  #assert v[0].eg[k].seat[1].old && !v[0].eg[k].seat[0].old && v[0].eg[k].old_n == 1 && v[0].eg[k].stale_n == 0;
  eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  a := eg_test_of(box[..], 0); c := eg_test_of(box[..], 1);
  #assert !eg_test_has(c, "r 0 version") && !rm_relay_kicked(v[..], 1);
  // the old page: a three-field header, F 1, both players' p and both n's
  #assert eg_test_has(c, "D 1 0 1 p 0 0 0 0 ") && eg_test_has(c, ";p 1 100 0 0 ") && eg_test_has(c, ";n 0 - ranger.0.0.0 druid 0 New") && eg_test_has(c, ";n 1 - ranger.0.0.0 druid 0 Old");
  #assert !eg_test_has(c, " s ") && !eg_test_has(c, ";s ");
  // the new page hears the old page's player as any other's
  #assert eg_test_has(a, "D 1 0 1 0 s 0 0 ") && eg_test_ent(box[..], 0, 1).x == 1;
  // its inputs have no HEARD: stepped; and after its snapshot, only what changed (its own p every tick)
  rm_heard(v[..], 1, "I 1 0 0 0 50 0 1");
  eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  c = eg_test_of(box[..], 1);
  #assert v[0].eg[k].seat[1].ack == 1 && eg_test_has(c, "D 2 1 0 p 1 100 0 50 ") && !eg_test_has(c, "p 0 ") && !eg_test_has(c, "n 0 ");
  // its heading in centiradians, kept as a new page's (WIRE_FINE)
  rm_heard(v[..], 1, "I 2 0 0 0 0 157 0");
  #assert v[0].eg[k].seat[1].q_n == 1 && v[0].eg[k].seat[1].q[0].theta == 15700;
  // the new page goes: its player is gone from the old page as the old wire says it
  rm_left(v[..], 0);
  eg_test_tick(v[..], k);
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 1), " 0 x p 0;p 1 ");
  // the API closes the window: an old hello is refused and its socket closed, as on another wire
  rm_control(v[..], "oldwire 0\n");
  #assert rm_join(v[..], 2, ev) >= 0;
  rm_heard(v[..], 2, "H 1 ranger.0.0.0 druid 0 Late");
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 2), "r 0 version") && rm_relay_kicked(v[..], 2) && v[0].eg[k].stale_n == 1;
}
#test "everglade room: the old wire closes on its own at WIRE_OLD_UNTIL_MS" {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_clock(v[..], 0, WIRE_OLD_UNTIL_MS);
  ev := "GET /api/room/relay/everglade/pair-oldwire2 HTTP/1.1\r\n\r\n";
  box: [1] EgInbox;
  #assert rm_join(v[..], 0, ev) == 0;
  rm_heard(v[..], 0, "H 1 ranger.0.0.0 druid 0 Old");
  eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 0), "r 0 version") && rm_relay_kicked(v[..], 0);
}
