// What the room server counts about its own work for the admins' room view (#12791; research
// docs/research/mmo.md section 15): the parts of the action path the Coax side sees. The host
// (room-host.c with room-stats.h) times the tick, counts the bytes, the queues and the join bursts,
// and asks these for the rest:
//   - admission refusals by reason (rl_join: ST_* below), and reconnects: a join whose request says
//     re=1 (the page's own rejoin after it lost the room, everglade-net.coax) and whether it sat;
//   - input to acknowledgement: when each seat's newest acknowledged input was heard (rm_st_ack);
//   - relevant entities: what a seat's page may be told about, as its last interest pick had it
//     (room-interest.coax, #12789), read when asked (once a second);
//   - the signature over the host's report (rm_st_sign), with the seat-ticket key, as room-vitals is.
// Every counter here is a total since the start; the host takes differences for its window.

ST_REASONS :: 11;
ST_NO_ROOM :: 0;     // no such room, or no free simulation for a new one
ST_TICKET :: 1;      // a seat ticket missing, forged or expired
ST_KICKED :: 2;      // the player is kicked (room-control.coax)
ST_SHARD :: 3;       // the ticket or the path is another shard's
ST_FULL :: 4;        // every seat taken
ST_VERSION :: 5;     // a page on another wire (#12788)
// a page of another build (#12839, room-everglade.coax eg_admit): its engine, its rules, its world, or
// saved data newer than this room reads (a rollback past its limit)
ST_ENGINE :: 6; ST_RULES :: 7; ST_CONTENT :: 8; ST_SCHEMA :: 9;
ST_ELSEWHERE :: 10;  // a ticket older than the one a seat of the same character holds on this server (#12834)
ST_REASON_NAMES :: [11] string.["no room", "ticket", "kicked", "shard", "full", "version", "engine", "rules", "content", "schema", "elsewhere"];
// The reason a compatibility refusal (CP_*) is counted under.
st_compat :: (why: int) -> int {
  if why == CP_ENGINE { return ST_ENGINE; }
  if why == CP_RULES { return ST_RULES; }
  if why == CP_CONTENT { return ST_CONTENT; }
  if why == CP_SCHEMA { return ST_SCHEMA; }
  return ST_VERSION;
}
// This room's build, for the admins' room view: engine, rules, world, oldest and newest wire, schema.
rm_st_pin :: (i: int) -> int #export_c {
  s := eg_server();
  if i == 0 { return s.pins.engine; }
  if i == 1 { return s.pins.rules; }
  if i == 2 { return s.pins.content; }
  if i == 3 { return s.wire_min; }
  if i == 4 { return s.pins.wire; }
  return s.pins.schema;
}

RmStats :: struct {
  refused: [ST_REASONS] int;
  re_tries: int; re_ok: int;      // joins with re=1, and those seated
  re_seat: int;                   // joins that took back their player's held seat (room-relay.coax rl_take_back, #12792)
  held: int; held_out: int;       // seats held for their player when the socket closed, and those that left at the grace's end
  stale: int;                     // frames dropped from a socket that is no longer its seat's (an older generation)
  // the allowances beside the rows' (#12836): bytes of x's (WIRE_LIFE_BUDGET), of n and w entries
  // (EG_META_BUDGET) and of a joining page's pieces (EG_JOIN_BUDGET), and the entries each left waiting
  life_b: int; life_wait: int; meta_b: int; meta_wait: int; join_b: int; join_wait: int;
  // and of events (room-everglade.coax EG_CUE_BUDGET): cue bytes and cues dropped (a seat each), outcome
  // and aimed bytes, and outcomes lost past their own room (a room each)
  cue_b: int; cue_drop: int; out_b: int; ev_lost: int;
  snaps_held: int;   // seat ticks a snapshot its page hadn't heard waited (room-everglade.coax EG_HEARD_BEHIND, #12903)
  resnaps: int;   // snapshots to a seat that was behind EG_RESNAP ticks or more (#12837)
  towns: int;     // towns sent again from the start, a page having missed an outcome (O, #12902)
}

st_refuse :: (v: [] RmServer, why: int) -> int {
  if why >= 0 && why < ST_REASONS { v[0].st.refused[why] += 1; }
  return -1;
}
rm_st_refused :: (v: [] RmServer, why: int) -> int #export_c { return ifx why >= 0 && why < ST_REASONS then v[0].st.refused[why] else 0; }
rm_st_reasons :: () -> int #export_c { return ST_REASONS; }
rm_st_reason :: (why: int) -> string #export_c { return ifx why >= 0 && why < ST_REASONS then ST_REASON_NAMES[why] else ""; }
rm_st_refuse_more :: (v: [] RmServer, why: int) #export_c { _ := st_refuse(v, why); }   // the host's own (no free connection)
rm_st_re_tries :: (v: [] RmServer) -> int #export_c { return v[0].st.re_tries; }
rm_st_re_ok :: (v: [] RmServer) -> int #export_c { return v[0].st.re_ok; }
rm_st_re_seat :: (v: [] RmServer) -> int #export_c { return v[0].st.re_seat; }
rm_st_stale :: (v: [] RmServer) -> int #export_c { return v[0].st.stale; }

// The everglade room and seat on connection conn into out (k, s), or false.
rm_st_conn :: (v: [] RmServer, conn: int, out: [] int) -> bool #export_c {
  if conn < 0 || conn >= CONNS || out.count < 2 || !v[0].conns[conn].live || v[0].conns[conn].relay < 0 { return false; }
  k := eg_room_at(v, v[0].conns[conn].relay);
  s := v[0].conns[conn].seat;
  if k < 0 || s < 0 || s >= EG_SEATS || !v[0].eg[k].seat[s].live || v[0].eg[k].seat[s].conn != conn { return false; }
  out[0] = k; out[1] = s;
  return true;
}
// Everglade room k's code (its relay's), "" none.
rm_st_code :: (v: [] RmServer, k: int) -> string #export_c {
  if !rm_eg_live(v, k) || v[0].eg[k].relay < 0 { return ""; }
  r := v[0].eg[k].relay;
  return cast(string) v[0].relays[r].code[0..<v[0].relays[r].code_n];
}

// When seat s's newest acknowledged input was heard (mono ms), once each time it moves on; -1 none since.
rm_st_ack :: (v: [] RmServer, k: int, s: int) -> int #export_c {
  if !rm_eg_seat_live(v, k, s) { return -1; }
  st := v[0].eg[k].seat[s..<s + 1];
  if st[0].ack <= st[0].ack_told || st[0].ack_at <= 0 { return -1; }
  st[0].ack_told = st[0].ack;
  return st[0].ack_at;
}

// What seat s's page may be told about this tick, as its last interest pick had it (room-interest.coax,
// #12789): the entities picked whole or health-only, its own among them.
rm_st_relevant :: (v: [] RmServer, k: int, s: int) -> int #export_c {
  if !rm_eg_seat_live(v, k, s) || !v[0].eg[k].seat[s].placed { return 0; }
  c: [4] int;
  im_counts(v[0].eg[k].im[..], s, c[..]);
  return c[0] + c[1];
}

// Seat s's replication counters (everglade-wire.coax WireSeat, #12836) into out: rows sent for their age
// so far (WIRE_MAX_AGE), the ticks the oldest changed row still waiting has waited, the rows the last
// tick left for a later one, and that tick's row bytes; false for no such seat.
rm_st_wire :: (v: [] RmServer, k: int, s: int, out: [] int) -> bool #export_c {
  if !rm_eg_seat_live(v, k, s) || out.count < 4 { return false; }
  r := v[0].eg[k].seat[s].rep[0];
  out[0] = r.aged_all; out[1] = r.oldest; out[2] = r.left; out[3] = r.bytes;
  return true;
}

// The allowances' totals so far (#12836) into out: x bytes, x's left waiting (a seat a tick each), n and
// w bytes, those left waiting, joining pages' piece bytes, the seat ticks with pieces still to go, cue
// bytes, cues dropped, outcome and aimed bytes, outcomes lost, snapshots after a long time behind,
// towns sent again, and seat ticks a snapshot waited (unheard on a slow link).
rm_st_alloc :: (v: [] RmServer, out: [] int) #export_c {
  if out.count < 13 { return; }
  out[0] = v[0].st.life_b; out[1] = v[0].st.life_wait; out[2] = v[0].st.meta_b; out[3] = v[0].st.meta_wait; out[4] = v[0].st.join_b; out[5] = v[0].st.join_wait;
  out[6] = v[0].st.cue_b; out[7] = v[0].st.cue_drop; out[8] = v[0].st.out_b; out[9] = v[0].st.ev_lost; out[10] = v[0].st.resnaps; out[11] = v[0].st.towns; out[12] = v[0].st.snaps_held;
}

// The X-Room-Mac of body (64 hex into out), with the seat-ticket key; false without one.
rm_st_sign :: (v: [] RmServer, body: string, out: [] u8) -> bool #export_c {
  if v[0].tkey_n == 0 || out.count < 64 { return false; }
  key: [TICKET_KEY] u8;
  for i: 0..<v[0].tkey_n { key[i] = v[0].tkey[i]; }
  b: [ST_BODY] u8;
  if body.count > ST_BODY { return false; }
  for i: 0..<body.count { b[i] = body[i]; }
  mac: [32] u8;
  if hmac_sha256_checked(key[0..<v[0].tkey_n], b[0..<body.count], mac[..], false) != SHA_OK { return false; }
  for i: 0..<32 { out[i * 2] = tk_hex(cast(int) (mac[i] >> 4)); out[i * 2 + 1] = tk_hex(cast(int) (mac[i] & 15)); }
  return true;
}
ST_BODY :: 14000;   // the host's report at most (its poster's config holds 16 KB)

#test "stats: a refused join is counted by its reason, a rejoin by whether it sat (#12791)" {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-st HTTP/1.1\r\n\r\n") == 0;
  #assert rm_join(v[..], 1, "GET /api/room/relay/everglade/pair-st?re=1 HTTP/1.1\r\n\r\n") == 1;
  #assert rm_st_re_tries(v[..]) == 1 && rm_st_re_ok(v[..]) == 1;
  for c: 2..<16 { #assert rm_join(v[..], c, "GET /api/room/relay/everglade/pair-st HTTP/1.1\r\n\r\n") == c; }
  #assert rm_join(v[..], 16, "GET /api/room/relay/everglade/pair-st?re=1 HTTP/1.1\r\n\r\n") == -1;
  #assert rm_st_refused(v[..], ST_FULL) == 1 && rm_st_re_tries(v[..]) == 2 && rm_st_re_ok(v[..]) == 1;
  #assert rm_join(v[..], 17, "GET /api/room/s7/relay/everglade/pair-st HTTP/1.1\r\n\r\n") == -1 && rm_st_refused(v[..], ST_SHARD) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  out: [2] int;
  #assert rm_st_conn(v[..], 3, out[..]) && out[0] == k && out[1] == 3 && rm_st_code(v[..], k) == "pair-st";
}
#test "stats: the acknowledged input's heard time, once a step; every other player is relevant (#12791)" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  rm_clock(v[..], 0, 1762190000000);
  ev := "GET /api/room/relay/everglade/pair-ack HTTP/1.1\r\n\r\n";
  #assert rm_join(v[..], 0, ev) == 0 && rm_join(v[..], 1, ev) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  eg_test_tick(v[..], k);
  rm_clock(v[..], 500, 1762190000500);
  eg_test_input(v[..], 1);
  rm_clock(v[..], 520, 1762190000520);
  eg_test_tick(v[..], k);
  #assert rm_st_ack(v[..], k, 0) == 500 && rm_st_ack(v[..], k, 0) == -1;
  #assert rm_st_relevant(v[..], k, 0) >= 1;
}
