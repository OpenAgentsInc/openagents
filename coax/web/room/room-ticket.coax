// Seat tickets (#12712): who sits in an Everglade seat. The API signs one at
// POST /api/playtest/room-ticket/ROOM (coax/web/api/player.c room_ticket) and the
// page joins with it as ?t=TICKET (or &t=). The text is
//
//   v1.PID.ACCT.NAME64.ROOM.EXPIRES.MAC
//
// PID the player id (p-<16 hex>), ACCT 1 when the player has an account, NAME64
// the display name in unpadded base64url ("-" none), ROOM the relay code,
// EXPIRES wall-clock milliseconds, and MAC the lowercase hex HMAC-SHA256 of
// everything before ".MAC" under OA_ROOM_TICKET_KEY (Secret Manager
// oa-room-ticket-key). A room joins only with a ticket for itself that has not
// expired and whose MAC checks; the seat then carries the ticket's id, name and
// account bit, so a page cannot claim another player's id.
#load "../../lib/crypto/hmac.coax";

TICKET_KEY :: 128;        // the key's most bytes
TICKET_TEXT :: 256;       // a ticket's most bytes
TICKET_PID :: 40;
TICKET_NAME :: 24;
TICKET_LIFE_MS :: 600000; // what the API signs (player.c TICKET_MS)
TICKET_SKEW_MS :: 60000;  // clocks may differ this much

Ticket :: struct {
  ok: bool;
  pid: [TICKET_PID] u8; pid_n: int;
  account: bool;
  name: [TICKET_NAME] u8; name_n: int;
  expires: int;
}

// The t= value in the request line's query ("" none).
tk_query :: (req: string) -> string {
  i := 0;
  while i < req.count && req[i] != ' ' { i += 1; }
  i += 1;
  while i < req.count && req[i] != '?' && req[i] != ' ' && req[i] != '\r' && req[i] != '\n' { i += 1; }
  if i >= req.count || req[i] != '?' { return ""; }
  i += 1;
  while i < req.count && req[i] != ' ' && req[i] != '\r' && req[i] != '\n' {
    at := i;
    while i < req.count && req[i] != '&' && req[i] != ' ' && req[i] != '\r' && req[i] != '\n' { i += 1; }
    if i - at > 2 && req[at] == 't' && req[at + 1] == '=' { return req[at + 2..<i]; }
    if i < req.count && req[i] == '&' { i += 1; }
  }
  return "";
}

tk_b64 :: (c: u8) -> int {
  if c >= 'A' && c <= 'Z' { return cast(int) (c - 'A'); }
  if c >= 'a' && c <= 'z' { return cast(int) (c - 'a') + 26; }
  if c >= '0' && c <= '9' { return cast(int) (c - '0') + 52; }
  if c == '-' { return 62; }
  if c == '_' { return 63; }
  return -1;
}
// Unpadded base64url into out: the bytes written, or -1.
tk_unb64 :: (s: string, out: [] u8) -> int {
  if s.count % 4 == 1 { return -1; }
  n := 0; acc := 0; bits := 0;
  for c: s {
    d := tk_b64(c);
    if d < 0 { return -1; }
    acc = (acc * 64 + d) % 16777216; bits += 6;
    if bits >= 8 {
      bits -= 8;
      if n >= out.count { return -1; }
      out[n] = cast(u8) ((acc >> bits) & 255); n += 1;
    }
  }
  return n;
}
tk_name_ok :: (name: [] u8, n: int) -> bool {
  for i: 0..<n {
    ch := name[i];
    ok := (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || (ch == ' ' && i > 0 && i < n - 1) || ch == '-' || ch == '_';
    if !ok { return false; }
  }
  return true;
}
tk_hex :: (d: int) -> u8 { return ifx d < 10 then cast(u8) ('0' + d) else cast(u8) ('a' + d - 10); }

// The MAC of text under key, as 64 lowercase hex characters into out; false if it failed.
tk_mac :: (key: string, text: string, out: [] u8) -> bool {
  if key.count > TICKET_KEY || text.count > TICKET_TEXT || out.count < 64 { return false; }
  k: [TICKET_KEY] u8; t: [TICKET_TEXT] u8; mac: [32] u8;
  for i: 0..<key.count { k[i] = key[i]; }
  for i: 0..<text.count { t[i] = text[i]; }
  if hmac_sha256_checked(k[0..<key.count], t[0..<text.count], mac[..], false) != SHA_OK { return false; }
  for i: 0..<32 { out[i * 2] = tk_hex(cast(int) (mac[i] >> 4)); out[i * 2 + 1] = tk_hex(cast(int) (mac[i] & 15)); }
  return true;
}

// The ticket checked against key, the room's code and now (wall ms): ok false unless all of it holds.
tk_check :: (key: string, ticket: string, room: string, now: int) -> Ticket {
  t := Ticket.{};
  if key.count < 32 || ticket.count == 0 || ticket.count > TICKET_TEXT { return t; }
  // the seven fields
  at: [8] int; n := 1; at[0] = 0;
  for i: 0..<ticket.count {
    if ticket[i] == '.' {
      if n >= 7 { return t; }
      at[n] = i + 1; n += 1;
    }
  }
  if n != 7 { return t; }
  at[7] = ticket.count + 1;
  f: [7] string;
  for i: 0..<7 { f[i] = ticket[at[i]..<at[i + 1] - 1]; }
  if f[0] != "v1" || f[4] != room || f[6].count != 64 { return t; }
  // the MAC, compared in constant time
  want: [64] u8;
  if !tk_mac(key, ticket[0..<at[6] - 1], want[..]) { return t; }
  diff := 0;
  for i: 0..<64 { diff = diff | cast(int) (want[i] ^ f[6][i]); }
  if diff != 0 { return t; }
  // the id
  if f[1].count == 0 || f[1].count > TICKET_PID { return t; }
  for c: f[1] { if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') { return t; } }
  // the account bit
  if f[2] != "0" && f[2] != "1" { return t; }
  // when it ends: not yet, and not further off than the API ever signs
  if f[5].count == 0 || f[5].count > 15 { return t; }
  ends := 0;
  for c: f[5] { if c < '0' || c > '9' { return t; } ends = ends * 10 + cast(int) (c - '0'); }
  if now > ends || ends - now > TICKET_LIFE_MS + TICKET_SKEW_MS { return t; }
  // the name
  if f[3] != "-" {
    m := tk_unb64(f[3], t.name[..]);
    if m <= 0 || !tk_name_ok(t.name[..], m) { return Ticket.{}; }
    t.name_n = m;
  }
  for i: 0..<f[1].count { t.pid[i] = f[1][i]; }
  t.pid_n = f[1].count;
  t.account = f[2] == "1";
  t.expires = ends;
  t.ok = true;
  return t;
}

tk_add :: (b: [] u8, n: int, s: string) -> int {
  if n + s.count > b.count { return b.count + 1; }
  for i: 0..<s.count { b[n + i] = s[i]; }
  return n + s.count;
}
// A ticket as the API signs it (for tests and the deploy checks): its count in out, 0 if it did not fit.
tk_sign :: (key: string, pid: string, account: bool, name: string, room: string, expires: int, out: [] u8) -> int {
  a := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
  b: [TICKET_TEXT] u8; n := 0;
  n = tk_add(b[..], n, "v1."); n = tk_add(b[..], n, pid); n = tk_add(b[..], n, ifx account then ".1." else ".0.");
  if name.count == 0 { n = tk_add(b[..], n, "-"); }
  i := 0;
  while i < name.count && n + 4 < b.count {
    v := cast(int) name[i] * 65536;
    if i + 1 < name.count { v += cast(int) name[i + 1] * 256; }
    if i + 2 < name.count { v += cast(int) name[i + 2]; }
    b[n] = a[(v >> 18) & 63]; b[n + 1] = a[(v >> 12) & 63]; n += 2;
    if i + 1 < name.count { b[n] = a[(v >> 6) & 63]; n += 1; }
    if i + 2 < name.count { b[n] = a[v & 63]; n += 1; }
    i += 3;
  }
  n = tk_add(b[..], n, "."); n = tk_add(b[..], n, room); n = tk_add(b[..], n, ".");
  d: [20] u8; dn := 0; e := expires;
  if e <= 0 { return 0; }
  while e > 0 { d[dn] = cast(u8) ('0' + e % 10); dn += 1; e = e / 10; }
  for j: 0..<dn { if n < b.count { b[n] = d[dn - 1 - j]; n += 1; } }
  if n + 65 > b.count || n + 65 > out.count { return 0; }
  mac: [64] u8;
  if !tk_mac(key, cast(string) b[0..<n], mac[..]) { return 0; }
  for j: 0..<n { out[j] = b[j]; }
  out[n] = '.';
  for j: 0..<64 { out[n + 1 + j] = mac[j]; }
  return n + 65;
}

#test "ticket: a signed ticket checks, and every forged field is refused" {
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  b: [256] u8;
  n := tk_sign(key, "p-00112233aabbccdd", true, "Ash Ranger", "dawn", 1000000, b[..]);
  #assert n > 0;
  tk := cast(string) b[0..<n];
  t := tk_check(key, tk, "dawn", 990000);
  #assert t.ok && cast(string) t.pid[0..<t.pid_n] == "p-00112233aabbccdd" && t.account && cast(string) t.name[0..<t.name_n] == "Ash Ranger";
  #assert !tk_check(key, tk, "dusk", 990000).ok;                       // another room
  #assert !tk_check(key, tk, "dawn", 1000001).ok;                      // expired
  #assert !tk_check(key, tk, "dawn", 1000000 - TICKET_LIFE_MS - TICKET_SKEW_MS - 1).ok;   // too far off
  #assert !tk_check("fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210", tk, "dawn", 990000).ok;   // another key
  // another player's id in a ticket signed for mine
  f: [256] u8; for i: 0..<n { f[i] = b[i]; }
  f[17] = ifx f[17] == '0' then '1' else '0';
  #assert !tk_check(key, cast(string) f[0..<n], "dawn", 990000).ok;
  // the account bit flipped
  for i: 0..<n { f[i] = b[i]; }
  f[22] = '0';
  #assert !tk_check(key, cast(string) f[0..<n], "dawn", 990000).ok;
  // a guest with no name
  n = tk_sign(key, "p-ffeeddccbbaa9988", false, "", "dawn", 1000000, b[..]);
  t = tk_check(key, cast(string) b[0..<n], "dawn", 999999);
  #assert t.ok && !t.account && t.name_n == 0;
  #assert !tk_check(key, "", "dawn", 0).ok && !tk_check(key, "v1.p-1.0.-.dawn.5.zz", "dawn", 0).ok;
}
#test "ticket: t= comes out of the request line's query" {
  #assert tk_query("GET /api/room/relay/everglade/dawn?t=abc HTTP/1.1\r\n") == "abc";
  #assert tk_query("GET /api/room/relay/everglade/dawn?relay=x&t=v1.a.b HTTP/1.1\r\n") == "v1.a.b";
  #assert tk_query("GET /api/room/relay/everglade/dawn HTTP/1.1\r\nX: ?t=no\r\n") == "";
  #assert tk_query("GET /api/room/relay/everglade/dawn?tt=1 HTTP/1.1") == "";
}
