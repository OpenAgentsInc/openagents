// A player's travel from one everglade room to another (#12850): the room server's side of
// aethyr/session/travel.coax, for two rooms of one realm. The page asks with
//   T SEQ CODE        go to the instance CODE (everglade-wire.coax)
// and the room takes the protocol's steps:
//   1. reserve: when CODE runs on this server, a seat there is set aside for the player for TRAVEL_MS
//      (no one else's join takes it); a full one refuses with "r SEQ full", and the player plays on.
//      An instance on another shard is the API directory's to place (room_pick, rooms.c).
//   2. prepare: the seat stops taking intents (the cutover: I, C, E, L and R are dropped and counted),
//      its casts still on their bars stop ("e stop SS SLOT left"; one already released lands),
//      and the player's HP, XP and WANTED are noted and posted (room-vitals.coax), so the destination
//      starts from the last command this room accepted.
//   3. route, once the API's receipt covers that note (it is durable, so a crash of this room after
//      the route loses nothing; with nothing new to save, at once): the page hears "g CODE": it closes this socket, asks the API for a ticket for CODE and
//      joins it (everglade-net.coax net_go). Its close here ends the seat at once (others hear l; no
//      seat is held), so no twin stands in two rooms.
//   4. commit and activate: the destination's join with the new ticket. The API issues the ticket
//      the character's next owner generation (#12834), so a write of this room's after it is refused
//      (f) and a seat of the player's still here ends (room-relay.coax rl_owner_drop); a seat that
//      joins here takes the reservation and its HP from this server's note (rv_back).
// Recovery. Every step before the destination's join is undone by time: a page that never leaves
// (it crashed, or its close was lost) gets its commands back after TRAVEL_MS, and the reservation
// lapses. A page that left and can't sit at CODE (full, or its room gone) joins again as on any
// reconnect, and the note has its HP. A crash of this room after the route loses nothing the note
// didn't post: the route waits for the post's receipt, and the destination's ticket brings the posted
// HP. A crash before the receipt sends no route: the page rejoins this room as after any drop.
TRAVEL_MS :: 8000;        // a cutover and a reservation last this long without the page's arrival
TRAVELS :: 16;            // journeys in flight on one server

RmTravel :: struct {
  live: bool;
  pid: [TICKET_PID] u8; pid_n: int;
  to: [RELAY_NAME] u8; to_n: int;
  until: int;             // mono ms the reservation lapses
  k: int; seat: int;      // where the player sits until routed
  rev: int;               // the vitals revision that must be saved before the route
  routed: bool;
}
RmTravels :: struct {
  t: [TRAVELS] RmTravel;
  asked: int; routed: int; full: int; refused: int; arrived: int; aborted: int; dropped: int;
}

// Journey j still holds its place.
trv_live :: (v: [] RmServer, j: int) -> bool { return v[0].trv.t[j].live && v[0].mono_ms < v[0].trv.t[j].until; }
// The reservations in the room called code, for anyone but pid.
trv_held_for_others :: (v: [] RmServer, code: string, pid: string) -> int {
  n := 0;
  for j: 0..<TRAVELS {
    e := v[0].trv.t[j];
    if !trv_live(v, j) || cast(string) e.to[0..<e.to_n] != code || cast(string) e.pid[0..<e.pid_n] == pid { continue; }
    n += 1;
  }
  return n;
}
// The free seats of relay room r: its seats less those taken (sockets, held seats).
trv_free :: (v: [] RmServer, r: int) -> int {
  taken: [RELAY_SEATS] bool; n := 0;
  for i: 0..<CONNS {
    c := v[0].conns[i];
    if c.live && c.relay == r && c.seat >= 0 && c.seat < RELAY_SEATS { taken[c.seat] = true; }
  }
  k := ifx v[0].relays[r].limited then eg_room_at(v, r) else -1;
  if k >= 0 { for s: 0..<EG_SEATS { if eg_held(v, k, s) { taken[s] = true; } } }
  for s: 0..<v[0].relays[r].seats { if !taken[s] { n += 1; } }
  return n;
}
// The live everglade room called code on this server, or -1.
trv_room :: (v: [] RmServer, code: string) -> int {
  for r: 0..<RELAYS {
    m := v[0].relays[r];
    if m.live && m.limited && cast(string) m.code[0..<m.code_n] == code { return r; }
  }
  return -1;
}
// The realm of an instance code: up to its last '-' ("everglade-3" is everglade's).
trv_realm :: (code: string) -> string {
  i := code.count - 1;
  while i > 0 && code[i] != '-' { i -= 1; }
  return code[0..<i];
}
trv_code_ok :: (t: string) -> bool {
  if t.count == 0 || t.count > RELAY_NAME { return false; }
  for ch: t { if !((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '-') { return false; } }
  return true;
}

// T SEQ CODE from seat `seat` of everglade room k.
eg_heard_travel :: (v: [] RmServer, k: int, seat: int, text: string) {
  rd: [1] WireRd; rd[0] = wire_rd(text, 1);
  seq := wire_num(text, rd[..]);
  to := wire_word(text, rd[..]);
  v[0].trv.asked += 1;
  r := v[0].eg[k].relay;
  if !rd[0].ok || r < 0 || !trv_code_ok(to) { v[0].trv.refused += 1; return; }
  here := cast(string) v[0].relays[r].code[0..<v[0].relays[r].code_n];
  tk := eg_ticket(v, k, seat);
  // a ticketed player, to another instance of this realm, not already on the way
  if !tk.ok || tk.pid_n == 0 { v[0].trv.refused += 1; eg_refuse(v, k, seat, seq, "ticket"); return; }
  if to == here || trv_realm(to) != trv_realm(here) || trv_realm(to).count == 0 { v[0].trv.refused += 1; eg_refuse(v, k, seat, seq, "room"); return; }
  if eg_travelling(v, k, seat) { v[0].trv.refused += 1; return; }
  pid := cast(string) tk.pid[0..<tk.pid_n];
  // 1. reserve: a seat in the destination when it runs here
  d := trv_room(v, to);
  if d >= 0 && trv_free(v, d) - trv_held_for_others(v, to, pid) <= 0 { v[0].trv.full += 1; eg_refuse(v, k, seat, seq, "full"); return; }
  slot := -1;
  for j: 0..<TRAVELS {
    if slot < 0 && !trv_live(v, j) { slot = j; }
    e := v[0].trv.t[j];
    if trv_live(v, j) && cast(string) e.pid[0..<e.pid_n] == pid { slot = j; break; }   // a journey of theirs before: this one replaces it
  }
  if slot < 0 { v[0].trv.full += 1; eg_refuse(v, k, seat, seq, "busy"); return; }
  e := RmTravel.{live = true, pid_n = pid.count, to_n = to.count, until = v[0].mono_ms + TRAVEL_MS, k = k, seat = seat};
  for i: 0..<pid.count { e.pid[i] = pid[i]; }
  for i: 0..<to.count { e.to[i] = to[i]; }
  v[0].trv.t[slot] = e;
  // 2. prepare: the cutover, and what the destination starts from
  v[0].eg[k].seat[seat].travel_until = v[0].mono_ms + TRAVEL_MS;
  rc_cutover(v, k, seat);
  rv_note_seat(v, k, seat); v[0].vit.flush = true;
  i := rv_find(v, pid);
  v[0].trv.t[slot].rev = ifx i >= 0 then v[0].vit.v[i].rev else 0;
  // 3. route, when that is saved
  trv_route_due(v);
}
// The journeys whose captured state is saved (a receipt covers its revision, or no key posts it)
// send their page on: "g CODE".
trv_route_due :: (v: [] RmServer) {
  for j: 0..<TRAVELS {
    e := v[0].trv.t[j];
    if !trv_live(v, j) || e.routed { continue; }
    i := rv_find(v, cast(string) e.pid[0..<e.pid_n]);
    if v[0].tkey_n > 0 && i >= 0 && v[0].vit.v[i].acked < e.rev { continue; }
    v[0].trv.t[j].routed = true;
    if !v[0].eg[e.k].live || !eg_travelling(v, e.k, e.seat) { continue; }
    b: [64] u8;
    n := wire_put_go(b[..], 0, cast(string) e.to[0..<e.to_n]);
    c := v[0].eg[e.k].seat[e.seat].conn;
    if c >= 0 && c < CONNS { rl_queue(v, v[0].eg[e.k].relay, c, -1, cast(string) b[0..<n], ""); v[0].trv.routed += 1; }
  }
}
// Seat `seat` of room k is cut over for travel: its page was told to go, and hasn't yet.
eg_travelling :: (v: [] RmServer, k: int, seat: int) -> bool {
  u := v[0].eg[k].seat[seat].travel_until;
  return u > 0 && v[0].mono_ms < u;
}
// An intent from a seat cut over for travel: dropped while the cutover lasts; past it the journey is
// called off and the seat takes commands again. Whether it is dropped.
eg_travel_drops :: (v: [] RmServer, k: int, seat: int) -> bool {
  u := v[0].eg[k].seat[seat].travel_until;
  if u == 0 { return false; }
  if v[0].mono_ms < u { v[0].trv.dropped += 1; return true; }
  v[0].eg[k].seat[seat].travel_until = 0; v[0].trv.aborted += 1;
  return false;
}
// A join of player pid in the room called code took its seat: its reservation is used.
trv_arrived :: (v: [] RmServer, code: string, pid: string) {
  for j: 0..<TRAVELS {
    e := v[0].trv.t[j];
    if trv_live(v, j) && cast(string) e.to[0..<e.to_n] == code && cast(string) e.pid[0..<e.pid_n] == pid { v[0].trv.t[j].live = false; v[0].trv.arrived += 1; }
  }
}
// The counts for the minute log: 0 asked, 1 routed, 2 full, 3 refused, 4 arrived, 5 aborted, 6 intents dropped in a cutover.
rm_travel_stat :: (v: [] RmServer, which: int) -> int #export_c {
  t := v[0].trv;
  if which == 0 { return t.asked; }
  if which == 1 { return t.routed; }
  if which == 2 { return t.full; }
  if which == 3 { return t.refused; }
  if which == 4 { return t.arrived; }
  if which == 5 { return t.aborted; }
  if which == 6 { return t.dropped; }
  return 0;
}
