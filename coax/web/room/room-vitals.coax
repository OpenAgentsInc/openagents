#load "../../../aethyr/ids.coax";
// What a player's HP is when they leave an Everglade room, kept so a reload is not a free heal
// (#12715, spec section 7). The server owns HP (everglade5e-room-rules.coax), so the server reports
// it: each ticketed seat's HP (its ticket's player id, room-ticket.coax) is noted when the seat
// leaves and every VITALS_EVERY_MS while it plays, and the host posts what changed to the API,
// POST /api/playtest/room-vitals, signed with the seat-ticket key (coax/web/api/player.c
// room_vitals), which keeps it by the player's account when logged in (so another device gets it).
// A ticket brings it back for 10 minutes (its HP field); this server's own note, newer than any
// post, wins when the same player sits again here.
VITALS :: 128;
RV_SCHEMA :: 2;   // legacy vitals plus character-checkpoint-v2's signed resume envelope
VITALS_KEEP_MS :: 600000;
// Where the player stood is kept too, by the room's code, so a socket that dropped (a phone between
// networks, a tab that slept past the server's silence check) or a reload puts them back where they
// were in that room instead of at the gate: within VITALS_PLACE_MS of the note.
VITALS_PLACE_MS :: 120000;
VITALS_EVERY_MS :: 10000;
VITALS_OWNER_MS :: 30000;   // a seated character with an owner generation is reported at least this often, changed or not (#12834)
VITALS_BODY :: 4096;
// The outbox (#12793). A note that changed is a new revision. The API applies each report once by its
// operation ID (this shard, this process's generation, the player, the revision) and answers with a
// receipt that names each line's outcome; only a receipt marks a revision saved (acked). Until then
// the note stays in this table and is sent again: one post in flight at a time, at most VITALS_BATCH
// players a post, with backoff and jitter after a failure, and given up after VITALS_OUTBOX_MS.
// A crash loses what no receipt covered: at most the last VITALS_EVERY_MS of HP, XP and WANTED for a
// seat that plays, more while the API is down (the launch runbook, "What a crash may lose").
VITALS_BATCH :: 40;               // players a post (a line is at most ~100 bytes of VITALS_BODY)
VITALS_RECEIPT_MS :: 15000;       // a post with no answer by then failed (its curl gives up at 5 s)
VITALS_BACKOFF_MS :: 1000;        // the first retry's wait; it doubles each failure
VITALS_BACKOFF_MAX_MS :: 30000;
VITALS_OUTBOX_MS :: 900000;       // an unsaved revision older than this is given up (and counted)
VITALS_WANTED_MS :: 300000;       // a WANTED level comes back within 5 minutes (as the API's ticket brings it)

RoomVital :: struct {
  live: bool;
  pid: [TICKET_PID] u8; pid_n: int;
  hp: int; max: int;
  dead: bool;       // it was dead, not only down at 0 (#12883)
  xp: int;          // the XP it has (room-events.coax)
  wanted: int;      // its WANTED level, the room's (room-everglade.coax wanted; 0 none, #12794)
  // the Everglade II class its first hello chose, its ticket naming none (room-everglade.coax class_report,
  // #13259; "" none): its lines carry it, and the API keeps a character's first class (verse.room_class_once)
  klass: [SEAT_CLASS_TEXT] u8; klass_n: int;
  at: int;          // wall ms it was noted
  rev: int;         // these values' revision (RmVitals.rev when they changed)
  rev_at: int;      // wall ms they changed: the report's AT, which orders HP at the API
  acked: int;       // the newest revision a receipt covers: rev > acked is in the outbox
  durable_rev:int;durable_at:int;durable_capture_at:int;durable_owner:int;durable_process:int; // exact a/d receipt only, not expiry/refusal/stale/fallback
  // owner generations are #counter fields: they move only through the named integer operations (#12927)
  owner: int #counter;   // the newest owner generation a seat ticket gave its character here (#12834; 0 none): its lines carry it
  floor: int #counter;   // the lowest owner generation that may still sit here: one past an owner the API fenced (f, #12834)
  sent_at: int;     // wall ms its line last went out (a seated owner's goes again each VITALS_OWNER_MS)
  // where it stood, in which room's code, and when (wall ms; 0 none)
  room: [RELAY_NAME] u8; room_n: int; x: f32; y: f32; z: f32; yaw: f32; placed_at: int;
}
RmVitals :: struct {
  v: [VITALS] RoomVital;
  last: int;        // wall ms the seats were last noted
  gen: int;         // this process's generation (rm_vitals_gen: its start, wall ms), part of every operation ID
  rev: int;         // the last revision given out
  batch: int;       // the last post's number (its receipt names it)
  // the post in flight: which entries, at which revisions
  fly: bool; fly_at: int; fly_n: int; fly_i: [VITALS_BATCH] int; fly_rev: [VITALS_BATCH] int; fly_owner: [VITALS_BATCH] int #counter;fly_capture_at:[VITALS_BATCH]int;
  tries: int;       // failures in a row
  retry_at: int;    // wall ms the next post may go (backoff)
  flush: bool;      // note every seat and post at the next call, not at VITALS_EVERY_MS
  // counted since start, for the minute log (rm_vitals_stat)
  posts: int; retried: int; failed: int; applied: int; dup: int; stale: int; refused: int; late: int; gave_up: int; evicted: int;
  fenced: int;      // lines the API refused for an older owner generation (f, #12834): the character plays elsewhere
  dropped: int;     // seats that went for it (room-relay.coax rl_owner_drop)
  out: [VITALS_BODY] u8; out_n: int;   // the post rm_vitals_due made: "t MS\no SHARD GEN BATCH\nPID HP MAX XP WANTED REV AT\n..."
  mac: [64] u8;                        // its X-Room-Mac
}

rv_find :: (v: [] RmServer, pid: string) -> int {
  for i: 0..<VITALS {
    e := v[0].vit.v[i];
    if e.live && cast(string) e.pid[0..<e.pid_n] == pid { return i; }
  }
  return -1;
}
// The player's HP, XP and WANTED now (from the seat of ticket pid). A change is a new revision, in
// the outbox until a receipt covers it.
rv_note :: (v: [] RmServer, pid: string, hp: int, max: int, xp: int, wanted: int) { rv_note_as(v, pid, hp, max, xp, wanted, false); }
// The same, dead (not only down at 0) or not.
rv_note_as :: (v: [] RmServer, pid: string, hp: int, max: int, xp: int, wanted: int, dead: bool) {
  if pid.count == 0 || pid.count > TICKET_PID || max <= 0 { return; }
  i := rv_find(v, pid);
  if i < 0 {
    i = rv_slot(v);
    v[0].vit.v[i] = RoomVital.{live = true, pid_n = pid.count};
    for c: 0..<pid.count { v[0].vit.v[i].pid[c] = pid[c]; }
  } else if v[0].vit.v[i].hp == hp && v[0].vit.v[i].max == max && v[0].vit.v[i].xp == xp && v[0].vit.v[i].wanted == wanted && v[0].vit.v[i].dead == dead {
    v[0].vit.v[i].at = v[0].wall_ms;
    return;
  }
  e := v[0].vit.v[i..<i + 1];
  e[0].hp = hp; e[0].max = max; e[0].xp = xp; e[0].wanted = wanted; e[0].dead = dead; e[0].at = v[0].wall_ms;
  v[0].vit.rev += 1;
  e[0].rev = v[0].vit.rev; e[0].rev_at = v[0].wall_ms;
}
// An entry for a new player: a free one, else the one longest saved; an unsaved one only when every
// entry is unsaved (counted: what it held is lost).
rv_slot :: (v: [] RmServer) -> int {
  best := -1; old := 0; lost := -1; lost_at := 0;
  for j: 0..<VITALS {
    e := v[0].vit.v[j];
    if !e.live { return j; }
    if e.rev <= e.acked { if best < 0 || e.at < old { best = j; old = e.at; } }
    else if lost < 0 || e.rev_at < lost_at { lost = j; lost_at = e.rev_at; }
  }
  if best >= 0 { return best; }
  v[0].vit.evicted += 1;
  return lost;
}
// Seat s of everglade room k: its HP noted, and where it stands, when its ticket names a player.
// The checkpoint is not captured here: the vitals timer is not its timer (room-checkpoint.coax, #13184).
rv_note_seat :: (v: [] RmServer, k: int, s_id: SeatId) { s := s_id.value;
  tk := eg_ticket(v, k, s_id);
  if !tk.ok { return; }
  c := v[0].eg[k].rules[0].b[0].c[EGB_SEAT + s];
  pid := cast(string) tk.pid[0..<tk.pid_n];
  // a seat of an older owner than one already noted here (#12834): its HP isn't the character's now
  was := rv_find(v, pid);
  if tk.owner > 0 && was >= 0 && v[0].vit.v[was].owner > tk.owner { return; }
  rv_note_as(v, pid, c.hp, c.hp_max, ev_xp_of(v, k, s_id), v[0].eg[k].wanted[s], c.dead && c.hp <= 0);
  i := rv_find(v, pid);
  if i >= 0 && tk.owner > v[0].vit.v[i].owner { v[0].vit.v[i].owner = tk.owner; }   // its lines go as the newest owner here
  st := v[0].eg[k].seat[s];
  // its first class, to keep (#13259): a new revision, so the next post carries it
  kc := fb_cl_of_kind(cast(string) st.klass[0..<st.klass_n]);
  if i >= 0 && st.class_report && kc >= 0 && v[0].vit.v[i].klass_n == 0 {
    w := FB_CL_KIND[kc];
    for q: 0..<w.count { v[0].vit.v[i].klass[q] = w[q]; }
    v[0].vit.v[i].klass_n = w.count;
    v[0].vit.rev += 1; v[0].vit.v[i].rev = v[0].vit.rev; v[0].vit.v[i].rev_at = v[0].wall_ms;
  }
  r := v[0].eg[k].relay;
  if i < 0 || !st.placed || r < 0 { return; }
  e := v[0].vit.v[i..<i + 1];
  e[0].room_n = v[0].relays[r].code_n;
  for q: 0..<e[0].room_n { e[0].room[q] = v[0].relays[r].code[q]; }
  e[0].x = st.pose.x; e[0].y = st.pose.y; e[0].z = st.pose.z; e[0].yaw = st.pose.yaw; e[0].placed_at = v[0].wall_ms;
}
// A seat that just joined: where its player stood in this room, when this server noted it in the last
// VITALS_PLACE_MS (the host puts it there instead of the gate: rm_eg_back).
rv_back :: (v: [] RmServer, k: int, s_id: SeatId) { s := s_id.value;
  tk := eg_ticket(v, k, s_id);
  r := v[0].eg[k].relay;
  if !tk.ok || r < 0 { return; }
  i := rv_find(v, cast(string) tk.pid[0..<tk.pid_n]);
  if i < 0 { return; }
  e := v[0].vit.v[i];
  if e.placed_at == 0 || v[0].wall_ms - e.placed_at > VITALS_PLACE_MS { return; }
  if cast(string) e.room[0..<e.room_n] != cast(string) v[0].relays[r].code[0..<v[0].relays[r].code_n] { return; }
  st := v[0].eg[k].seat[s..<s + 1];
  st[0].back = true; st[0].back_x = e.x; st[0].back_y = e.y; st[0].back_z = e.z; st[0].back_yaw = e.yaw; st[0].back_at = e.placed_at;
}
// For the host, placing seat s of room k: 1 when it goes back where its player stood, then (field 1
// to 4) that place's x, y, z and facing; 0 to the gate.
rm_eg_back :: (v: [] RmServer, k: int, s_id: SeatId, field: int) -> f32 #export_c #effects(all) { s := s_id.value;
  if k < 0 || k >= EG_ROOMS || s < 0 || s >= EG_SEATS || !v[0].eg[k].seat[s].live || !v[0].eg[k].seat[s].back { return 0; }
  st := v[0].eg[k].seat[s];
  if field == 1 { return st.back_x; }
  if field == 2 { return st.back_y; }
  if field == 3 { return st.back_z; }
  if field == 4 { return st.back_yaw; }
  return 1;
}
// A seat that just joined (after e5rr_join): the HP its player left with, this server's note when it
// has one from the last 10 minutes (down at 0, or dead, stays so: #12883), else its ticket's. A ticket
// with none (or 0: it fell somewhere else) leaves it full. The seat keeps it (back_hp) until its hello
// has built its character (rv_hp_back), since a class or the demo character builds it whole again.
rv_join :: (v: [] RmServer, k: int, s_id: SeatId) { s := s_id.value;
  v[0].eg[k].seat[s].back_hp = -1; v[0].eg[k].seat[s].back_dead = false;
  tk := eg_ticket(v, k, s_id);
  if !tk.ok { return; }
  hp := tk.hp; dead := false;
  i := rv_find(v, cast(string) tk.pid[0..<tk.pid_n]);
  noted := i >= 0 && v[0].wall_ms - v[0].vit.v[i].at <= VITALS_KEEP_MS;
  if noted { hp = rs_max(v[0].vit.v[i].hp, 0); dead = v[0].vit.v[i].dead && hp == 0; }
  // its WANTED level (#12794): this server's note from the last 5 minutes, else the ticket's (the
  // API's, which only a room's signed report writes); kept and reported (v1's town laid it, #13267)
  want := tk.wanted;
  if i >= 0 && v[0].wall_ms - v[0].vit.v[i].at <= VITALS_WANTED_MS { want = v[0].vit.v[i].wanted; }
  if want > 0 && want <= 5 { v[0].eg[k].seat[s].want_seed = want; v[0].eg[k].wanted[s] = want; }
  if hp < 0 || (hp == 0 && !noted) { return; }
  v[0].eg[k].seat[s].back_hp = hp; v[0].eg[k].seat[s].back_dead = dead;
  rv_hp_back(v, k, s_id);
}
// Seat s's character after a build (its join, its level, its hello's class or demo): no more Hit Points
// than its player came back with, and down or dead as they left. The hello's build is the last
// (eg_heard_hello clears back_hp).
rv_hp_back :: (v: [] RmServer, k: int, s_id: SeatId) { s := s_id.value;
  hp := v[0].eg[k].seat[s].back_hp;
  if hp < 0 { return; }
  c := v[0].eg[k].rules[0].b[0].c[EGB_SEAT + s..<EGB_SEAT + s + 1];
  c[0].hp = rs_min(rs_min(hp, c[0].hp_max), c[0].hp);
  if c[0].hp <= 0 { c[0].hp = 0; c[0].dead = v[0].eg[k].seat[s].back_dead; }
}

// Called by the host once a second: every VITALS_EVERY_MS the playing seats are noted, and the
// outbox's next post is written into vit.out with its MAC, unless one is in flight or backing off.
// Its count (0 nothing to post now). The body:
//   t MS                          when it was signed (the API takes it within two minutes)
//   o SHARD GEN BATCH             who reports: this shard, this process's generation, the post's number
//   PID HP MAX XP WANTED REV AT   a player's values at revision REV, changed at AT (wall ms), then its owner
//                                 generation (#12834) and " c=CLASS", the class to keep (#13259), when it has them
// The operation ID of a line is (SHARD, GEN, PID, REV). GEN lets the API refuse a replaced process's
// reports once the directory fences owners (#12797).
rm_vitals_due :: (v: [] RmServer) -> int #export_c #effects(all) {
  v[0].vit.out_n = 0;
  if !rm_writes(v) { return 0; }
  if v[0].vit.gen == 0 { v[0].vit.gen = v[0].wall_ms; }
  if v[0].vit.flush || v[0].wall_ms - v[0].vit.last >= VITALS_EVERY_MS {
    v[0].vit.last = v[0].wall_ms;
    for k: 0..<EG_ROOMS {
      if !v[0].eg[k].live { continue; }
      for s: 0..<EG_SEATS { if v[0].eg[k].seat[s].live { rv_note_seat(v, k, SeatId.{value = s}); } }
    }
  }
  // a revision unsaved for VITALS_OUTBOX_MS is given up
  for i: 0..<VITALS {
    e := v[0].vit.v[i];
    if e.live && e.rev > e.acked && v[0].wall_ms - e.rev_at > VITALS_OUTBOX_MS { v[0].vit.v[i].acked = e.rev; v[0].vit.gave_up += 1; }
  }
  if v[0].vit.fly {
    if v[0].wall_ms - v[0].vit.fly_at < VITALS_RECEIPT_MS { return 0; }
    rv_failed(v);   // no answer: the request, or its answer, was lost
  }
  if v[0].wall_ms < v[0].vit.retry_at { return 0; }
  v[0].vit.flush = false;
  o := v[0].vit.out[..];
  batch := v[0].vit.batch + 1;
  n := tk_add(o, 0, "t "); n = rv_int(o, n, v[0].wall_ms);
  n = tk_add(o, n, "\no "); n = rv_int(o, n, v[0].shard); n = tk_add(o, n, " "); n = rv_int(o, n, v[0].vit.gen);
  n = tk_add(o, n, " "); n = rv_int(o, n, batch); n = tk_add(o, n, "\n");
  m := 0;
  for i: 0..<VITALS {
    e := v[0].vit.v[i];
    // unchanged, a character seated here under an owner generation still goes each VITALS_OWNER_MS
    // (e.at: noted at the last VITALS_EVERY_MS), so a room that lost it (a paused process that
    // resumed) hears f from the API and ends the seat, as the owner's lease lapses in the contract
    seated := e.owner > 0 && v[0].wall_ms - e.at <= 2 * VITALS_EVERY_MS && v[0].wall_ms - e.sent_at >= VITALS_OWNER_MS;
    if !e.live || (e.rev <= e.acked && !seated) { continue; }
    if m >= VITALS_BATCH || n + e.pid_n + 120 > o.count { break; }
    n = tk_add(o, n, cast(string) e.pid[0..<e.pid_n]); n = tk_add(o, n, " "); n = rv_int(o, n, e.hp);
    n = tk_add(o, n, " "); n = rv_int(o, n, e.max); n = tk_add(o, n, " "); n = rv_int(o, n, e.xp);
    n = tk_add(o, n, " "); n = rv_int(o, n, e.wanted); n = tk_add(o, n, " "); n = rv_int(o, n, e.rev);
    n = tk_add(o, n, " "); n = rv_int(o, n, e.rev_at);
    if e.owner > 0 { n = tk_add(o, n, " "); n = rv_int(o, n, e.owner); }   // the owner generation (#12834)
    if e.klass_n > 0 { n = tk_add(o, n, " c="); n = tk_add(o, n, cast(string) e.klass[0..<e.klass_n]); }   // the class to keep (#13259)
    n = tk_add(o, n, "\n");
    v[0].vit.fly_i[m] = i; v[0].vit.fly_rev[m] = e.rev; v[0].vit.fly_owner[m] = e.owner;v[0].vit.fly_capture_at[m]=e.rev_at; m += 1;
    v[0].vit.v[i].sent_at = v[0].wall_ms;
  }
  if m == 0 { return 0; }
  if !rm_write_mac(v, "vitals", cast(string) o[0..<n], v[0].vit.mac[..]) { return 0; }
  v[0].vit.batch = batch;
  v[0].vit.fly = true; v[0].vit.fly_at = v[0].wall_ms; v[0].vit.fly_n = m;
  v[0].vit.posts += 1;
  if v[0].vit.tries > 0 { v[0].vit.retried += 1; }
  v[0].vit.out_n = n;
  return n;
}
// The post in flight failed (a 5xx, a timeout, a dropped request): the next waits VITALS_BACKOFF_MS,
// doubled for each failure in a row up to VITALS_BACKOFF_MAX_MS, and then between half of it and all
// of it, so shards that failed together don't retry together.
rv_failed :: (v: [] RmServer) {
  v[0].vit.fly = false;
  v[0].vit.failed += 1;
  v[0].vit.tries += 1;
  d := VITALS_BACKOFF_MS;
  for t: 1..<v[0].vit.tries { if d < VITALS_BACKOFF_MAX_MS { d *= 2; } }
  if d > VITALS_BACKOFF_MAX_MS { d = VITALS_BACKOFF_MAX_MS; }
  h := (v[0].vit.gen % 2147483647) * 31 + v[0].vit.batch * 7919 + v[0].vit.tries * 104729 + v[0].shard * 15485863;
  h = (h % 2147483648 * 1103515245 + 12345) % 2147483648;
  v[0].vit.retry_at = v[0].wall_ms + d / 2 + (h / 65536) % (d / 2 + 1);
}
// The API's answer to post BATCH (the host's: STATUS the HTTP status, 0 none in time or dropped, and
// its body). A 2xx "receipt GEN BATCH CODES" has one code a line, in the post's order:
//   a applied   d already applied (a retry of one the API kept)   s stale (a newer revision is kept)
//   u no such player   x a line it couldn't read   f fenced: a newer owner generation has the character (#12834)
// Each of these is final, and marks that line's revision saved, but for an f on a line whose player
// sat here again since with a newer ticket: it goes again as that owner. A line with no code stays in
// the outbox. Anything else (an older API's {"kept":N} aside) is a failure, and the post is sent again.
rm_vitals_answer :: (v: [] RmServer, batch: int, status: int, body: string) #export_c #effects(all) {
  if !v[0].vit.fly || batch != v[0].vit.batch { v[0].vit.late += 1; return; }
  if status >= 200 && status < 300 {
    if body.count > 8 && body[0..<8] == "receipt " {
      f: [4] string; fn := 0; at := 8; j := 8;
      while j <= body.count && fn < 4 {
        if j == body.count || body[j] == ' ' || body[j] == '\n' { f[fn] = body[at..<j]; fn += 1; at = j + 1; if j < body.count && body[j] == '\n' { break; } }
        j += 1;
      }
      if fn >= 2 && rv_num(f[0]) == v[0].vit.gen && rv_num(f[1]) == batch {
        codes := ifx fn >= 3 then f[2] else "";
        for q: 0..<v[0].vit.fly_n {
          if q >= codes.count { break; }
          c := codes[q];
          if c == 'a' { v[0].vit.applied += 1; }
          else if c == 'd' { v[0].vit.dup += 1; }
          else if c == 's' { v[0].vit.stale += 1; }
          else if c == 'u' || c == 'x' { v[0].vit.refused += 1; }
          else if c == 'f' { v[0].vit.fenced += 1; if v[0].vit.v[v[0].vit.fly_i[q]].owner > v[0].vit.fly_owner[q] { continue; } }
          else { continue; }
          i := v[0].vit.fly_i[q];
          if (c=='a'||c=='d')&&v[0].vit.v[i].owner==v[0].vit.fly_owner[q]&&v[0].vit.fly_rev[q]>=v[0].vit.v[i].durable_rev{v[0].vit.v[i].durable_rev=v[0].vit.fly_rev[q];v[0].vit.v[i].durable_at=v[0].wall_ms;v[0].vit.v[i].durable_capture_at=v[0].vit.fly_capture_at[q];v[0].vit.v[i].durable_owner=v[0].vit.fly_owner[q];v[0].vit.v[i].durable_process=v[0].vit.gen;}
          if v[0].vit.fly_rev[q] > v[0].vit.v[i].acked { v[0].vit.v[i].acked = v[0].vit.fly_rev[q]; }
          // fenced for good: a newer owner has the character elsewhere, so its seats here of that
          // generation or older go, each told "elsewhere" (room-relay.coax rl_owner_drop)
          if c == 'f' && v[0].vit.fly_owner[q] > 0 {
            e := v[0].vit.v[i];
            // that owner's tickets sit no more: the floor is fenced up to one past it, never down
            // (one past the largest owner generation stays the largest: none sits above it, #12927)
            past := add_sat(v[0].vit.fly_owner[q], 1);
            g: [1] ControlFence; g[0].gen[0] = e.floor;
            if control_fence(g[..], CharacterId.{value = 0}, past) == CONTROL_OK { v[0].vit.v[i].floor = g[0].gen[0]; }
            v[0].vit.dropped += rl_owner_drop(v, cast(string) e.pid[0..<e.pid_n], past, -1);
          }
        }
        v[0].vit.fly = false; v[0].vit.tries = 0; v[0].vit.retry_at = 0;
        trv_route_due(v);   // a journey waiting on this save goes (room-travel.coax)
        return;
      }
    } else if body.count > 8 && body[0..<8] == "{\"kept\":" {
      // an API from before receipts (#12793) kept every line it could: its merge is safe to repeat
      for q: 0..<v[0].vit.fly_n {
        i := v[0].vit.fly_i[q];
        if v[0].vit.fly_rev[q] > v[0].vit.v[i].acked { v[0].vit.v[i].acked = v[0].vit.fly_rev[q]; }
        v[0].vit.applied += 1;
      }
      v[0].vit.fly = false; v[0].vit.tries = 0; v[0].vit.retry_at = 0;
      trv_route_due(v);
      return;
    }
  }
  rv_failed(v);
}
// --dev with no vitals URL: the stand-in keeps the room's own notes (room-dev.coax), so the post in
// flight is applied at once.
rm_vitals_local :: (v: [] RmServer) #export_c #effects(all) {
  if !v[0].vit.fly { return; }
  b: [128] u8;
  n := tk_add(b[..], 0, "receipt "); n = rv_int(b[..], n, v[0].vit.gen); n = tk_add(b[..], n, " "); n = rv_int(b[..], n, v[0].vit.batch); n = tk_add(b[..], n, " ");
  for q: 0..<v[0].vit.fly_n { n = tk_add(b[..], n, "a"); }
  rm_vitals_answer(v, v[0].vit.batch, 200, cast(string) b[0..<n]);
}
// The room is draining (SIGTERM; #12797): every seat noted now and the outbox posted at the next call,
// without waiting out a backoff.
rm_vitals_flush :: (v: [] RmServer) #export_c #effects(all) {
  v[0].vit.flush = true; v[0].vit.retry_at = 0;
}
// Entries whose newest revision no receipt covers yet.
rm_vitals_pending :: (v: [] RmServer) -> int #export_c #effects(all) {
  n := 0;
  for i: 0..<VITALS { if v[0].vit.v[i].live && v[0].vit.v[i].rev > v[0].vit.v[i].acked { n += 1; } }
  return n;
}
// The counts for the minute log: 0 posts, 1 retried, 2 failed, 3 applied, 4 already applied, 5 stale,
// 6 refused, 7 late answers, 8 given up, 9 evicted unsaved, 10 pending now, 11 fenced (#12834), 12 seats
// that went for it.
rm_vitals_stat :: (v: [] RmServer, which: int) -> int #export_c #effects(all) {
  t := v[0].vit;
  if which == 0 { return t.posts; }
  if which == 1 { return t.retried; }
  if which == 2 { return t.failed; }
  if which == 3 { return t.applied; }
  if which == 4 { return t.dup; }
  if which == 5 { return t.stale; }
  if which == 6 { return t.refused; }
  if which == 7 { return t.late; }
  if which == 8 { return t.gave_up; }
  if which == 9 { return t.evicted; }
  if which == 10 { return rm_vitals_pending(v); }
  if which == 11 { return t.fenced; }
  if which == 12 { return t.dropped; }
  return 0;
}
// This process's generation (the host's start, wall ms): a later process's is larger.
rm_vitals_gen :: (v: [] RmServer, gen: int) #export_c #effects(all) { if gen > 0 { v[0].vit.gen = gen; } }
rv_num :: (t: string) -> int {
  if t.count == 0 || t.count > 18 { return -1; }
  x := 0;
  for c: t { if c < '0' || c > '9' { return -1; } x = x * 10 + cast(int) (c - '0'); }
  return x;
}
rv_int :: (b: [] u8, at: int, x: int) -> int {
  d: [20] u8; dn := 0; e := ifx x < 0 then 0 else x;
  while e > 0 || dn == 0 { d[dn] = cast(u8) ('0' + e % 10); dn += 1; e = e / 10; }
  n := at;
  for j: 0..<dn { if n < b.count { b[n] = d[dn - 1 - j]; n += 1; } }
  return n;
}

rv_test_receipt :: (b: [] u8, gen: int, batch: int, codes: string) -> string {
  n := tk_add(b, 0, "receipt "); n = rv_int(b, n, gen); n = tk_add(b, n, " "); n = rv_int(b, n, batch);
  n = tk_add(b, n, " "); n = tk_add(b, n, codes); n = tk_add(b, n, "\n");
  return cast(string) b[0..<n];
}
#test "vitals outbox (#12793): a note is saved only by its receipt; a failure is sent again after a backoff with jitter; a change in flight waits for its own receipt" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  rm_ticket_key(v[..], "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", true);
  rm_vitals_gen(v[..], now - 5000);
  gen := now - 5000;
  rv_note(v[..], "p-0011223344556677", 7, 10, 300, 2);
  #assert rm_vitals_due(v[..]) > 0;
  body := cast(string) v[0].vit.out[0..<v[0].vit.out_n];
  #assert eg_test_has(body, "\no 1 1762189995000 1\n") && eg_test_has(body, "\np-0011223344556677 7 10 300 2 1 1762190000000\n");
  #assert rm_vitals_due(v[..]) == 0;   // one post in flight at a time
  // a 500: not saved, and sent again after half to all of VITALS_BACKOFF_MS
  rm_vitals_answer(v[..], 1, 500, "{\"error\":\"down\"}");
  #assert rm_vitals_pending(v[..]) == 1 && v[0].vit.failed == 1 && !v[0].vit.fly;
  wait := v[0].vit.retry_at - now;
  #assert wait >= VITALS_BACKOFF_MS / 2 && wait <= VITALS_BACKOFF_MS;
  #assert rm_vitals_due(v[..]) == 0;
  rm_clock(v[..], 0, v[0].vit.retry_at);
  #assert rm_vitals_due(v[..]) > 0 && v[0].vit.batch == 2 && v[0].vit.retried == 1;
  // no answer within VITALS_RECEIPT_MS (a timeout, a lost answer): failed, and the wait doubles
  rm_clock(v[..], 0, v[0].wall_ms + VITALS_RECEIPT_MS);
  #assert rm_vitals_due(v[..]) == 0 && v[0].vit.failed == 2;
  w2 := v[0].vit.retry_at - v[0].wall_ms;
  #assert w2 >= VITALS_BACKOFF_MS && w2 <= 2 * VITALS_BACKOFF_MS;
  rm_clock(v[..], 0, v[0].vit.retry_at);
  #assert rm_vitals_due(v[..]) > 0 && v[0].vit.batch == 3;
  // the XP changes while post 3 is in flight; post 2's answer comes late and changes nothing
  rv_note(v[..], "p-0011223344556677", 7, 10, 350, 2);
  b: [128] u8;
  rm_vitals_answer(v[..], 2, 200, rv_test_receipt(b[..], gen, 2, "a"));
  #assert v[0].vit.late == 1 && v[0].vit.fly;
  // post 3's receipt saves revision 1, not revision 2
  rm_vitals_answer(v[..], 3, 200, rv_test_receipt(b[..], gen, 3, "a"));
  #assert v[0].vit.applied == 1 && rm_vitals_pending(v[..]) == 1 && v[0].vit.tries == 0 && v[0].vit.retry_at == 0;
  #assert rm_vitals_due(v[..]) > 0 && eg_test_has(cast(string) v[0].vit.out[0..<v[0].vit.out_n], " 7 10 350 2 2 ");
  // a receipt naming another generation (a replaced process's) is not this post's: a failure
  rm_vitals_answer(v[..], 4, 200, rv_test_receipt(b[..], gen + 1, 4, "a"));
  #assert rm_vitals_pending(v[..]) == 1 && v[0].vit.failed == 3;
  rm_clock(v[..], 0, v[0].vit.retry_at);
  #assert rm_vitals_due(v[..]) > 0 && v[0].vit.batch == 5;
  // the API kept post 4 before its answer was lost: post 5 is "already applied", and saved
  rm_vitals_answer(v[..], 5, 200, rv_test_receipt(b[..], gen, 5, "d"));
  #assert rm_vitals_pending(v[..]) == 0 && v[0].vit.dup == 1;
  #assert rm_vitals_due(v[..]) == 0;   // nothing left to post
  // a stale revision (the API holds a newer one for this process) is final too
  rv_note(v[..], "p-0011223344556677", 6, 10, 350, 2);
  #assert rm_vitals_due(v[..]) > 0;
  rm_vitals_answer(v[..], 6, 200, rv_test_receipt(b[..], gen, 6, "s"));
  #assert rm_vitals_pending(v[..]) == 0 && v[0].vit.stale == 1;
  // an API from before receipts answers {"kept":N}: its merge is safe to repeat, so that saves it
  rv_note(v[..], "p-0011223344556677", 5, 10, 350, 2);
  #assert rm_vitals_due(v[..]) > 0;
  rm_vitals_answer(v[..], 7, 200, "{\"kept\":1}");
  #assert rm_vitals_pending(v[..]) == 0;
}
#test "vitals outbox (#12834): a line carries its character's owner generation; an older owner's f is final, unless a newer ticket sat here since" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  rm_ticket_key(v[..], "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", true);
  rm_vitals_gen(v[..], now - 5000);
  gen := now - 5000;
  b: [128] u8;
  // no generation (a ticket from before): the line as before
  rv_note(v[..], "p-0011223344556677", 7, 10, 300, 0);
  #assert rm_vitals_due(v[..]) > 0 && eg_test_has(cast(string) v[0].vit.out[0..<v[0].vit.out_n], "\np-0011223344556677 7 10 300 0 1 1762190000000\n");
  rm_vitals_answer(v[..], 1, 200, rv_test_receipt(b[..], gen, 1, "a"));
  // generation 4: last on its line
  i := rv_find(v[..], "p-0011223344556677");
  v[0].vit.v[i].owner = 4;
  rv_note(v[..], "p-0011223344556677", 6, 10, 300, 0);
  #assert rm_vitals_due(v[..]) > 0 && eg_test_has(cast(string) v[0].vit.out[0..<v[0].vit.out_n], "\np-0011223344556677 6 10 300 0 2 1762190000000 4\n");
  // the player sat here again with generation 5 while the line was in flight: f, and it goes again as 5
  v[0].vit.v[i].owner = 5;
  rm_vitals_answer(v[..], 2, 200, rv_test_receipt(b[..], gen, 2, "f"));
  #assert v[0].vit.fenced == 1 && rm_vitals_pending(v[..]) == 1 && rm_vitals_stat(v[..], 11) == 1;
  #assert rm_vitals_due(v[..]) > 0 && eg_test_has(cast(string) v[0].vit.out[0..<v[0].vit.out_n], " 2 1762190000000 5\n");
  // f again with no newer ticket: final; the character plays elsewhere
  rm_vitals_answer(v[..], 3, 200, rv_test_receipt(b[..], gen, 3, "f"));
  #assert v[0].vit.fenced == 2 && rm_vitals_pending(v[..]) == 0 && v[0].vit.refused == 0 && rm_vitals_due(v[..]) == 0;
}
#test "vitals outbox (#12793): bounded: an unsaved note is evicted only when every entry is unsaved, and given up after VITALS_OUTBOX_MS" #steps 4000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  rm_ticket_key(v[..], "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", true);
  p: [32] u8;
  for i: 0..<VITALS {
    n := rv_int(p[..], tk_add(p[..], 0, "p-test"), 1000 + i);
    rv_note(v[..], cast(string) p[0..<n], 5, 10, i, 0);
  }
  #assert rm_vitals_pending(v[..]) == VITALS && v[0].vit.evicted == 0;
  // full of unsaved notes: a new player's takes the oldest, and that is counted
  rm_clock(v[..], 0, now + 1000);
  rv_note(v[..], "p-test-new-1", 5, 10, 1, 0);
  #assert v[0].vit.evicted == 1 && rm_vitals_pending(v[..]) == VITALS && rv_find(v[..], "p-test1000") < 0;
  // one saved: the next new player takes it, and nothing unsaved is lost
  j := rv_find(v[..], "p-test1001");
  v[0].vit.v[j].acked = v[0].vit.v[j].rev;
  rv_note(v[..], "p-test-new-2", 5, 10, 1, 0);
  #assert v[0].vit.evicted == 1 && rv_find(v[..], "p-test1001") < 0 && rv_find(v[..], "p-test-new-2") >= 0;
  // the API down for longer than VITALS_OUTBOX_MS: the outbox gives the old revisions up
  rm_clock(v[..], 0, now + 1000 + VITALS_OUTBOX_MS + 1);
  #assert rm_vitals_due(v[..]) == 0;   // given up, so nothing to post
  #assert v[0].vit.gave_up == VITALS && rm_vitals_pending(v[..]) == 0;
}
#test "vitals (#12794): the room reports each seat's WANTED; a ticket's w brings it back, and this server's note within 5 minutes wins" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  t: [256] u8; r: [512] u8;
  // a ticket with w3: the seat sits WANTED 3
  n := tk_sign_wanted(key, "p-0011223344556677", false, "", "pair-e2-tk", 0, now + 60000, -1, 40, 3, t[..]);
  #assert eg_test_has(cast(string) t[0..<n], ".-x40w3.") && tk_check(key, cast(string) t[0..<n], "pair-e2-tk", now).wanted == 3;
  #assert rm_join(v[..], 0, tk_test_ask(r[..], t[..], n)) == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  #assert v[0].eg[k].wanted[0] == 3;
  // the town makes it 4; the seat leaves, and its note goes at once (a flush), WANTED with it
  #assert rm_vitals_due(v[..]) > 0;
  rm_vitals_local(v[..]);
  v[0].eg[k].wanted[0] = 4;
  rm_left(v[..], 0);
  #assert rm_vitals_due(v[..]) > 0 && eg_test_has(cast(string) v[0].vit.out[0..<v[0].vit.out_n], " 40 4 ");
  // back within the seat's grace (#12792): the same seat, its live level kept
  n = tk_sign_xp(key, "p-0011223344556677", false, "", "pair-e2-tk", 0, now + 120000, -1, 40, t[..]);
  #assert rm_join(v[..], 0, tk_test_ask(r[..], t[..], n)) == 0;
  #assert v[0].eg[k].wanted[0] == 4;
  rm_left(v[..], 0);
  // back after it, within 5 minutes, with a ticket that has none: this server's note
  rm_clock(v[..], EG_GRACE_MS + 1000, now + 60000);
  if rm_eg_begin(v[..], k) {}
  #assert rm_join(v[..], 0, tk_test_ask(r[..], t[..], n)) == 0;
  k = eg_room_at(v[..], v[0].conns[0].relay);
  #assert v[0].eg[k].wanted[0] == 4 && v[0].eg[k].seat[0].want_seed == 4;
  // a WANTED level out of range is refused, even signed
  x: [256] u8;
  m := tk_add(x[..], 0, "v2.p-0011223344556677.0.-.pair-e2-tk."); m = rv_int(x[..], m, now + 120000); m = tk_add(x[..], m, ".-x40w9");
  mac: [64] u8;
  #assert tk_mac(key, cast(string) x[0..<m], mac[..]);
  m = tk_add(x[..], m, "."); m = tk_add(x[..], m, cast(string) mac[..]);
  #assert !tk_check(key, cast(string) x[0..<m], "pair-e2-tk", now + 60000).ok;
  // and the same text with w2 checks
  m = tk_add(x[..], 0, "v2.p-0011223344556677.0.-.pair-e2-tk."); m = rv_int(x[..], m, now + 120000); m = tk_add(x[..], m, ".-x40w2");
  #assert tk_mac(key, cast(string) x[0..<m], mac[..]);
  m = tk_add(x[..], m, "."); m = tk_add(x[..], m, cast(string) mac[..]);
  #assert tk_check(key, cast(string) x[0..<m], "pair-e2-tk", now + 60000).wanted == 2;
}

// Seat 0's creature in the room of conn 0's relay.
rv_test_c0 :: (v: [] RmServer) -> RsCreature {
  k := eg_room_at(v, v[0].conns[0].relay);
  return v[0].eg[k].rules[0].b[0].c[EGB_SEAT + v[0].conns[0].seat];
}
// Conn 0 (player pid) leaves at `hp` (dead or not) while conn 1 keeps the room running, and comes back
// on a ticket that brings no HP, saying `hello`; admin signs its tickets as an admin's (the demo).
rv_test_back :: (v: [] RmServer, key: string, pid: string, admin: bool, hello: string, hp: int, dead: bool) -> RsCreature {
  t: [256] u8; r: [512] u8;
  now := v[0].wall_ms;
  n := ifx admin then tk_sign_admin_wanted(key, pid, "", "pair-e2-tk", 0, now + 60000, 0, t[..]) else tk_sign_xp(key, pid, false, "", "pair-e2-tk", 0, now + 60000, -1, 0, t[..]);
  _ := rm_join(v, 0, tk_test_ask(r[..], t[..], n));
  rm_heard(v, 0, hello);
  k := eg_room_at(v, v[0].conns[0].relay);
  c := v[0].eg[k].rules[0].b[0].c[EGB_SEAT + v[0].conns[0].seat..<EGB_SEAT + v[0].conns[0].seat + 1];
  c[0].hp = hp; c[0].dead = dead;
  rm_left(v, 0);
  rm_clock(v, 0, now + 20000);
  n = ifx admin then tk_sign_admin_wanted(key, pid, "", "pair-e2-tk", 0, now + 80000, 0, t[..]) else tk_sign_xp(key, pid, false, "", "pair-e2-tk", 0, now + 80000, -1, 0, t[..]);
  _ = rm_join(v, 0, tk_test_ask(r[..], t[..], n));
  rm_heard(v, 0, hello);
  return rv_test_c0(v);
}
#test "vitals (#12883): a player who rejoins a running room has the HP they left with, as a Warlock or the demo too, and down or dead stays so" #steps 4000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  t: [256] u8; r: [512] u8;
  // the other page keeps the room running
  n := tk_sign_xp(key, "p-ffffeeeeddddcccc", false, "", "pair-e2-tk", 0, now + 600000, -1, 0, t[..]);
  #assert rm_join(v[..], 1, tk_test_ask(r[..], t[..], n)) == 0;
  // the druid: its hello builds nothing new
  c := rv_test_back(v[..], key, "p-0000000000000001", false, "H 5 ranger.0.0.0 druid 0 -", 5, false);
  #assert c.hp == 5 && !c.dead && c.hp_max > 5;
  // the Warlock: its hello builds the caster whole, and the HP comes back after it
  c = rv_test_back(v[..], key, "p-0000000000000002", false, "H 5 ranger.0.0.0 warlock 0 -", 4, false);
  #assert v[0].eg[eg_room_at(v[..], v[0].conns[0].relay)].rules[0].klass[v[0].conns[0].seat] == 1;
  #assert c.hp == 4 && !c.dead && c.hp_max > 4;
  // an admin's demo character (the hello's FLAGS 64): Everglade's own, whole, unless it left hurt (the #12883 report: 52 of 57)
  c = rv_test_back(v[..], key, "p-0000000000000003", true, "H 5 ranger.1.0.0 druid 64 -", 52, false);
  #assert c.hp == 52 && c.hp_max == 57;
  // down at 0 stays down, and dead stays dead (the room stands them up after EV_RISE_S, ev_rise)
  c = rv_test_back(v[..], key, "p-0000000000000004", false, "H 5 ranger.0.0.0 druid 0 -", 0, false);
  #assert c.hp == 0 && !c.dead;
  c = rv_test_back(v[..], key, "p-0000000000000005", false, "H 5 ranger.0.0.0 warlock 0 -", 0, true);
  #assert c.hp == 0 && c.dead;
  // a ticket's 0 from another server still means full (its player fell there)
  n = tk_sign_xp(key, "p-0000000000000006", false, "", "pair-e2-tk", 0, v[0].wall_ms + 60000, 0, 0, t[..]);
  _ := rm_join(v[..], 0, tk_test_ask(r[..], t[..], n));
  rm_heard(v[..], 0, "H 5 ranger.0.0.0 druid 0 -");
  c = rv_test_c0(v[..]);
  #assert c.hp == c.hp_max && !c.dead;
}
