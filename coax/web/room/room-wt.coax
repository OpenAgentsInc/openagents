// The room's side of WebTransport (#13176, aethyr/net/transport.coax): which channel each frame of
// Everglade's wire goes on, a datagram's repeated inputs let through once, and the seats whose state
// goes as one datagram a tick (room-everglade.coax eg_send). The host (room-host.c, room-wt.c) carries
// the bytes: a datagram for NET_DATAGRAM, else the reliable stream of the frame's domain.
//   A seat on WebTransport gets each tick's state as one D datagram that decodes on its own: part 0,
//   never "more follows" (F 2), at most NET_DATAGRAM_MAX bytes; its TICK is its sequence number and
//   each row names its baseline (BACK). Rows that don't fit wait for the next tick in priority order
//   (everglade-wire.coax wire_seat_frame), as a WebSocket seat's past its budget do. Its outcomes
//   (every e entry, o N, and the town's pieces) go on the combat stream as D frames with F 4: out of
//   band, read for their entries only, never counted toward a tick's parts.
//   coax/bin/coax test --library coax/web/room/room.coax --only "webtransport"
EG_DG_HEAD :: 48;                                   // a D datagram's header at most ("D TICK ACK F 0 "), with room to spare
EG_DG_ROWS :: NET_DATAGRAM_MAX - EG_DG_HEAD;        // its entries' bytes at most
// Everglade's frames by their first word; any other is the session's.
RM_WT_ROUTES :: [12] NetRoute.[
  NetRoute.{word = "D", channel = NET_DATAGRAM},     // state (F 4: the combat stream's, rm_wt_channel)
  // the previous wire's frames, for a seat that says WIRE_MIN (everglade/server/wire-prev.coax, #13398): gone with them
  NetRoute.{word = "g2", channel = NET_DATAGRAM},    // the path guard's state, whole each time
  NetRoute.{word = "h2", channel = NET_DATAGRAM},    // the monsters in view, whole each time
  NetRoute.{word = "g3", channel = NET_COMBAT},      // the guard's blows
  NetRoute.{word = "h3", channel = NET_COMBAT},      // the monsters' blows, arrows and falls
  NetRoute.{word = "m2", channel = NET_DATAGRAM},    // your familiar, whole each time
  NetRoute.{word = "a", channel = NET_COMBAT},       // an arrow loosed
  NetRoute.{word = "d", channel = NET_COMBAT},       // and where it ended
  NetRoute.{word = "r", channel = NET_COMBAT},       // an intent refused
  NetRoute.{word = "b", channel = NET_LOOT},         // your bar's counts
  NetRoute.{word = "z", channel = NET_LOOT},         // your rest
  NetRoute.{word = "u1", channel = NET_LOOT},        // an aid's count
];
// gate: the inputs (I, J1) a datagram repeats; casts and launches (C, F) come both ways, on the stream
// and in the datagrams until acknowledged (everglade/client/net.coax e2n_send), each heard once (#13187)
RmWt :: struct { on: bool; gate: [1] NetGate; casts: [1] NetSeen; looses: [1] NetSeen; dgrams: int; spilled: int; oob: int; }

// Conn conn is (on) or is no longer a WebTransport session: what it counted starts again.
rm_wt_conn :: (v: [] RmServer, conn: int, on: bool) #export_c #effects(all) {
  if conn < 0 || conn >= CONNS { return; }
  v[0].wt[conn] = RmWt.{on = on};
}
rm_wt_on :: (v: [] RmServer, conn: int) -> bool { return conn >= 0 && conn < CONNS && v[0].wt[conn].on; }
// The channel a frame goes on to a WebTransport session (aethyr/net/transport.coax NET_*).
rm_wt_channel :: (v: [] RmServer, text: string) -> int #export_c #effects(all) { return rm_wt_channel_of(text); }
rm_wt_channel_of :: (text: string) -> int {
  if text.count > 1 && text[0] == 'D' && text[1] == ' ' {
    r: [1] WireRd; r[0] = wire_rd(text, 1);
    d := wire_read_d(text, r[..]);
    if r[0].ok && (d.f & WIRE_F_OOB) != 0 { return NET_COMBAT; }
    return NET_DATAGRAM;
  }
  return net_route(RM_WT_ROUTES[..], text);
}
// Whether a frame on a reliable stream goes as a datagram too, now and again next tick (room-wt.c
// wt_out): an arrow loosed (a) or ended (d), which the page draws from the moment it names and takes
// once by its id (everglade/client/net.coax e2n_shot_word). A resend's wait on the stream would show late.
rm_wt_hasten :: (v: [] RmServer, text: string) -> bool #export_c #effects(all) { return wire_is(text, "a") || wire_is(text, "d"); }
// A datagram from session conn: its frames, '\n' apart, each one heard (NET_SAME made whole); an input
// (I or J1) only the first time its number comes (each datagram repeats the ones the room hasn't
// acknowledged), and a cast or a launch only the first time either way brings it.
rm_wt_heard :: (v: [] RmServer, conn: int, text: string) #export_c #effects(all) {
  if !rm_wt_on(v, conn) { return; }
  b: [RELAY_FRAME] u8;
  for q: 0..<net_bundle_count(text) {
    f := net_bundle_expand(text, q, b[..]);
    if f.count == 0 { continue; }
    if wire_is(f, "I") || wire_is(f, "J1") {
      r: [1] WireRd; r[0] = wire_rd(f, ifx f[0] == 'J' then 2 else 1);
      seq := wire_num(f, r[..]);
      if !r[0].ok || !net_gate_fresh(v[0].wt[conn].gate[..], seq) { continue; }
    }
    if !rm_wt_once(v, conn, f) { continue; }
    rm_heard(v, conn, f);
  }
}
// A frame from session conn's reliable stream: heard, but a cast or launch its datagrams brought first.
rm_wt_reliable :: (v: [] RmServer, conn: int, text: string) #export_c #effects(all) {
  if rm_wt_on(v, conn) && !rm_wt_once(v, conn, text) { return; }
  rm_heard(v, conn, text);
}
// Whether f is to be heard: false for a cast (C SEQ) or launch (F SEQ) whose number came before.
rm_wt_once :: (v: [] RmServer, conn: int, f: string) -> bool {
  if !wire_is(f, "C") && !wire_is(f, "F") { return true; }
  r: [1] WireRd; r[0] = wire_rd(f, 1);
  seq := wire_num(f, r[..]);
  if !r[0].ok { return true; }
  return net_seen_fresh(ifx f[0] == 'C' then v[0].wt[conn].casts[..] else v[0].wt[conn].looses[..], seq);
}
rm_wt_stat :: (v: [] RmServer, conn: int, what: int) -> int #export_c #effects(all) {
  if conn < 0 || conn >= CONNS { return -1; }
  w := v[0].wt[conn];
  return ifx what == 0 then w.dgrams else ifx what == 1 then w.spilled else ifx what == 2 then w.oob else ifx what == 3 then w.gate[0].repeats else -1;
}
// Whether entry goes in a WebTransport seat's state datagram: a row (s, packed S), one gone (x), who a
// seat is (n) and a WANTED level (w); everything else is an outcome or a cue, the combat stream's.
eg_dg_state :: (entry: string) -> bool {
  if entry.count > 1 && entry[0] == 'S' { return true; }
  return entry.count > 1 && entry[1] == ' ' && (entry[0] == 's' || entry[0] == 'x' || entry[0] == 'n' || entry[0] == 'w');
}

#test "webtransport: frames by channel, a datagram's repeated inputs once, and the state entries" {
  v: [1] RmServer;
  #assert rm_wt_channel(v[..], "D 40 3 0 0 s 1 0 7 1") == NET_DATAGRAM && rm_wt_channel(v[..], "D 40 3 4 0 e hit 1 2 3 0") == NET_COMBAT;
  #assert rm_wt_channel(v[..], "D 40 3 5 0 e town") == NET_COMBAT && rm_wt_channel(v[..], "D x") == NET_DATAGRAM;
  #assert rm_wt_channel(v[..], "m2 4 0") == NET_DATAGRAM && rm_wt_channel(v[..], "d 4 0 1 2 3") == NET_COMBAT && rm_wt_channel(v[..], "a 1 2") == NET_COMBAT;
  #assert rm_wt_channel(v[..], "b 1 2") == NET_LOOT && rm_wt_channel(v[..], "y 0 2 3") == NET_SESSION && rm_wt_channel(v[..], "W 1 30 1 2 0 1000") == NET_SESSION;
  #assert rm_wt_hasten(v[..], "a 1302 1 0 1001325 0 0 0 0 0 0 1000 250") && rm_wt_hasten(v[..], "d 1302 1 1 0 0 0 0 0 0 -1") && !rm_wt_hasten(v[..], "a") && !rm_wt_hasten(v[..], "r 1 2") && !rm_wt_hasten(v[..], "ab 1");
  #assert eg_dg_state("s 1 0 7 1") && eg_dg_state("SAbc") && eg_dg_state("x 4") && eg_dg_state("n 1 - a b 0 -") && eg_dg_state("w 1 2");
  #assert !eg_dg_state("e hit 1 2 3 0") && !eg_dg_state("e mon 4 1 2 3 0") && !eg_dg_state("e guard 4 1 2 3") && !eg_dg_state("o 4") && !eg_dg_state("e town") && !eg_dg_state("s") && !eg_dg_state("S");
  rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-wt-gate HTTP/1.1\r\n\r\n") == 0;
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 druid 0 -");
  k := eg_room_at(v[..], v[0].conns[0].relay); #assert k >= 0;
  rm_wt_heard(v[..], 0, "I 1 100 0 0 0 0 0 0"); #assert v[0].eg[k].seat[0].q_n == 0;   // not a WebTransport session: nothing
  rm_wt_conn(v[..], 0, true);
  rm_wt_heard(v[..], 0, "I 1 100 0 0 0 0 0 0");
  rm_wt_heard(v[..], 0, "I 1 100 0 0 0 0 0 0\nI 2 100 0 0 0 0 0 0");
  rm_wt_heard(v[..], 0, "I 1 100 0 0 0 0 0 0\nI 2 100 0 0 0 0 0 0\nI 3 100 0 0 0 0 0 0\nnonsense\n");
  #assert v[0].eg[k].seat[0].q_n == 3 && v[0].eg[k].seat[0].q[0].seq == 1 && v[0].eg[k].seat[0].q[2].seq == 3 && rm_wt_stat(v[..], 0, 3) == 3;
  #assert v[0].conns[0].dropped == 0;   // the repeats never reach the rate limits
  // a held stick's repeats as NET_SAME, made whole; a cast and its launch both ways, heard once each
  rm_wt_heard(v[..], 0, "~\n~\nI 6 100 0 0 0 0 0 0");
  #assert v[0].eg[k].seat[0].q_n == 6 && v[0].eg[k].seat[0].q[3].seq == 4 && v[0].eg[k].seat[0].q[5].seq == 6;
  rm_wt_reliable(v[..], 0, "F 1000007 0 1450 -30000 0 0 -60000 1000 0");
  rm_wt_heard(v[..], 0, "F 1000007 0 1450 -30000 0 0 -60000 1000 0\nC 1000007 128 0 1 -40 -1\nI 7 100 0 0 0 0 0 0");
  rm_wt_reliable(v[..], 0, "C 1000007 128 0 1 -40 -1");
  #assert v[0].wt[0].looses[0].dups == 1 && v[0].wt[0].casts[0].dups == 1 && v[0].eg[k].seat[0].q_n == 7;
  rm_wt_reliable(v[..], 0, "C 1000040 128 0 1 -40 -1"); rm_wt_reliable(v[..], 0, "C x"); #assert v[0].wt[0].casts[0].dups == 1;
  rm_wt_conn(v[..], 0, false); #assert rm_wt_stat(v[..], 0, 3) == 0 && rm_wt_stat(v[..], 0, 9) == -1 && rm_wt_stat(v[..], -1, 0) == -1;
}
// Each frame of what conn c heard since the last drain ('|' apart) that is a D: the datagrams' bytes
// most, their count, any with more than part 0 or F 2, and the out-of-band ones.
WtSeen :: struct { dgrams: int; most: int; bad: int; oob: int; snaps: int; }
wt_test_seen :: (box: [] EgInbox, c: int, s: [] WtSeen) {
  t := eg_test_of(box, c); from := 0;
  for i: 0..<t.count + 1 {
    if i < t.count && t[i] != '|' { continue; }
    f := t[from..<i]; from = i + 1;
    if f.count < 2 || f[0] != 'D' || f[1] != ' ' { continue; }
    r: [1] WireRd; r[0] = wire_rd(f, 1); d := wire_read_d(f, r[..]);
    if (d.f & WIRE_F_OOB) != 0 { s[0].oob += 1; continue; }
    s[0].dgrams += 1; if f.count > s[0].most { s[0].most = f.count; }
    if d.part != 0 || (d.f & 2) != 0 { s[0].bad += 1; }
    if (d.f & 1) != 0 { s[0].snaps += 1; }
  }
}
// The other seats of a full room (conns 2 to EG_SEATS - 1), each a player walking: Everglade II's own
// load on a seat's frames (v1's townsfolk filled them before, #13346).
wt_test_crowd :: (v: [] RmServer, code: string) {
  ask: [96] u8; m := put(ask[..], 0, "GET /api/room/relay/everglade/"); m = put(ask[..], m, code); m = put(ask[..], m, " HTTP/1.1\r\n\r\n");
  for c: 2..<EG_SEATS { _ := rm_join(v, c, cast(string) ask[0..<m]); rm_heard(v, c, "H 6 ranger.0.0.0 druid 0 -"); }
}
wt_test_walk :: (v: [] RmServer, t: int) {
  b: [96] u8;
  for c: 2..<EG_SEATS { n := wire_put_in(b[..], 0, WireIn.{seq = t, kx = ifx (c + t / 30) % 2 == 0 then 100 else -100, px = 40, heard = t - 1}); rm_heard(v, c, cast(string) b[0..<n]); }
}
wt_test_live :: (m: [] WireMirror) -> int { n := 0; for e: 0..<WIRE_MIRROR { if m[0].ents[e].live { n += 1; } } return n; }
#test "webtransport: a seat's state is one datagram a tick within NET_DATAGRAM_MAX, the rest waiting by priority, its outcomes out of band; its page holds what a WebSocket page holds" #steps 8000000000 {
  v: [1] RmServer; box: [1] EgInbox;
  rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  rm_wt_conn(v[..], 0, true);
  #assert rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-wt-state HTTP/1.1\r\n\r\n") == 0;
  #assert rm_join(v[..], 1, "GET /api/room/relay/everglade/pair-e2-wt-state HTTP/1.1\r\n\r\n") == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay); #assert k >= 0;
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 druid 0 -"); rm_heard(v[..], 1, "H 6 ranger.0.0.0 druid 0 -");
  wt_test_crowd(v[..], "pair-e2-wt-state");
  b: [96] u8; seen: [2] WtSeen; ws_most := 0;
  for t: 1..<91 {
    // a full room's players walking near: more rows a tick than one datagram holds
    wt_test_walk(v[..], t);
    for c: 0..<2 { n := wire_put_in(b[..], 0, WireIn.{seq = t, px = 40, heard = box[0].m[c].heard}); rm_heard(v[..], c, cast(string) b[0..<n]); }
    eg_test_tick(v[..], k); eg_test_drain(v[..], box[..]);
    wt_test_seen(box[..], 0, seen[0..<1]); wt_test_seen(box[..], 1, seen[1..<2]);
    if seen[1].most > ws_most { ws_most = seen[1].most; }
  }
  // one datagram a tick, each whole on its own, never past NET_DATAGRAM_MAX, though the WebSocket's frames were larger
  #assert seen[0].dgrams == 90 && seen[0].bad == 0 && seen[0].most <= NET_DATAGRAM_MAX && seen[0].snaps >= 1;
  #assert ws_most > NET_DATAGRAM_MAX && seen[1].oob == 0;
  // what didn't fit came on later ticks: the page holds every entity the WebSocket page does, and the other player where the room has them
  #assert wt_test_live(box[0].m[0..<1]) == wt_test_live(box[0].m[1..<2]) && wt_test_live(box[0].m[0..<1]) > 2;
  o := eg_test_ent(box[..], 0, 1); p := v[0].eg[k].seat[1].pose;
  #assert o.id == 1 && (o.x - p.x) * (o.x - p.x) + (o.z - p.z) * (o.z - p.z) < 0.01 && box[0].m[0].heard > 80;
  // an outcome (the town again, after a page said it missed one) goes out of band on the combat stream
  eg_heard_missed(v[..], k, SeatId.{value = 0}); eg_heard_missed(v[..], k, SeatId.{value = 1});
  for t: 91..<94 { for c: 0..<2 { n := wire_put_in(b[..], 0, WireIn.{seq = t, heard = box[0].m[c].heard}); rm_heard(v[..], c, cast(string) b[0..<n]); } eg_test_tick(v[..], k); eg_test_drain(v[..], box[..]); wt_test_seen(box[..], 0, seen[0..<1]); }
  #assert seen[0].oob >= 1 && rm_wt_stat(v[..], 0, 2) == seen[0].oob && rm_wt_stat(v[..], 0, 0) == seen[0].dgrams;
  #assert v[0].eg[k].seat[0].town_end == false && v[0].eg[k].seat[1].town_end == false;
}

// ---- the pipeline's loss check (#13177): the room's own frames through a seeded bad network
// A model of the two transports at LOSS per thousand, RTT ms and ±JITTER/2 ms, per frame, 30 Hz:
//   WebTransport: a datagram (a seat's tick of state) is lost, or arrives in its own time, out of order
//     as may be; a reliable frame (out of band, on its domain's stream) that is lost comes a resend
//     later (1.5 RTT: QUIC's loss detection), and holds the frames after it on its stream.
//   WebSocket: every frame is one TCP stream; a lost one comes TCP's resend later (the larger of
//     200 ms and 2 RTT, as net-proxy.coax) and holds every frame after it.
// The number: how old the newest state a page holds is, each tick (its mirror's HEARD), at the 95th
// percentile: what the other players are drawn from. coax/web/room/net-matrix.coax measures the
// same in two Chromes; this runs in the room's own checks on every build host.
WT_SIM_PEND :: 96;
WtPend :: struct { due: int; n: int; s: int; b: [RELAY_FRAME] u8; }
WtSim :: struct { seed: int; loss: int; rtt: int; jitter: int; pend: [2] [WT_SIM_PEND] WtPend; last: [2] [2] int; lost: int; full: int; }
wt_sim_rand :: (s: [] WtSim, n: int) -> int { s[0].seed = (s[0].seed % 2147483648 * 1103515245 + 12345) % 2147483648; return (s[0].seed / 32768) % n; }
// Frame f to conn c (0 WebTransport, 1 WebSocket) at `now` ms, held for its time.
wt_sim_send :: (s: [] WtSim, c: int, f: string, now: int) {
  dg := c == 0 && f.count > 1 && rm_wt_channel_of(f) == NET_DATAGRAM;
  lost := s[0].loss > 0 && wt_sim_rand(s, 1000) < s[0].loss;
  if dg && lost { s[0].lost += 1; return; }
  d := s[0].rtt / 2 + ifx s[0].jitter > 0 then wt_sim_rand(s, s[0].jitter + 1) - s[0].jitter / 2 else 0;
  if lost { d += ifx c == 0 then s[0].rtt * 3 / 2 else (ifx 2 * s[0].rtt > 200 then 2 * s[0].rtt else 200); }
  due := now + d;
  // ordered: a stream's frame never before the one ahead of it (WebSocket: the one stream; WebTransport: its domain's)
  st := ifx dg then -1 else ifx c == 0 && rm_wt_channel_of(f) != NET_COMBAT then 1 else 0;
  if st >= 0 { if due < s[0].last[c][st] { due = s[0].last[c][st]; } s[0].last[c][st] = due; }
  for k: 0..<WT_SIM_PEND {
    p := s[0].pend[c][k..<k + 1];
    if p[0].n != 0 { continue; }
    p[0].due = due; p[0].n = f.count; for i: 0..<f.count { p[0].b[i] = f[i]; }
    return;
  }
  s[0].full += 1;
}
// Every frame due by `now`, into conn c's page.
wt_sim_give :: (s: [] WtSim, c: int, now: int, m: [] WireMirror) {
  // in the order they were due (a WebSocket's in its stream's order)
  while true {
    best := -1;
    for k: 0..<WT_SIM_PEND { p := s[0].pend[c][k..<k + 1]; if p[0].n != 0 && p[0].due <= now && (best < 0 || p[0].due < s[0].pend[c][best].due) { best = k; } }
    if best < 0 { return; }
    p := s[0].pend[c][best..<best + 1];
    _ := wire_mirror_frame(m, cast(string) p[0].b[0..<p[0].n]);
    p[0].n = 0;
  }
}
// The p-th percentile of v's first n.
wt_sim_pct :: (v: [] int, n: int, p: int) -> int {
  if n <= 0 { return -1; }
  for i: 1..<n { x := v[i]; j := i; while j > 0 && v[j - 1] > x { v[j] = v[j - 1]; j -= 1; } v[j] = x; }
  k := n * p / 100; if k >= n { k = n - 1; }
  return v[k];
}
// The two pages' state age (ms) at the 95th percentile, [0] on WebTransport and [1] on a WebSocket.
wt_sim_run :: (loss: int, rtt: int, jitter: int, seed: int, ticks: int, out: [] int) {
  v: [1] RmServer; m: [2] WireMirror; sim: [1] WtSim;
  sim[0].seed = seed; sim[0].loss = loss; sim[0].rtt = rtt; sim[0].jitter = jitter;
  rm_init(v[..]); rm_clock(v[..], 0, 1762190000000);
  rm_wt_conn(v[..], 0, true);
  _ := rm_join(v[..], 0, "GET /api/room/relay/everglade/pair-e2-wt-sim HTTP/1.1\r\n\r\n"); _2 := rm_join(v[..], 1, "GET /api/room/relay/everglade/pair-e2-wt-sim HTTP/1.1\r\n\r\n");
  k := eg_room_at(v[..], v[0].conns[0].relay);
  rm_heard(v[..], 0, "H 6 ranger.0.0.0 druid 0 -"); rm_heard(v[..], 1, "H 6 ranger.0.0.0 druid 0 -");
  wt_test_crowd(v[..], "pair-e2-wt-sim");
  b: [96] u8; age: [2] [1200] int; an := 0;
  for t: 1..<ticks + 1 {
    now := t * 1000 / EG_HZ;
    wt_test_walk(v[..], t);   // a full room's players walking
    // the pages' inputs reach the room at once (the model is the room's sending)
    for c: 0..<2 { n := wire_put_in(b[..], 0, WireIn.{seq = t, px = 40, heard = m[c].heard}); rm_heard(v[..], c, cast(string) b[0..<n]); }
    eg_test_tick(v[..], k);
    while true {
      got := rm_relay_next(v[..]);
      if got == 0 { break; }
      for c: 0..<2 { if v[0].rto[c] && got > 0 { wt_sim_send(sim[..], c, cast(string) v[0].rout[0..<got], now); } }
    }
    for c: 0..<2 { wt_sim_give(sim[..], c, now, m[c..<c + 1]); }
    if t > 60 && an < 1200 { for c: 0..<2 { age[c][an] = (v[0].eg[k].tick - m[c].heard) * 1000 / EG_HZ; } an += 1; }
  }
  for c: 0..<2 { out[c] = wt_sim_pct(age[c][..], an, 95); }
  if out.count > 3 { out[2] = sim[0].lost; out[3] = sim[0].full; }
}
#test "webtransport under loss: at 2% and 10% with 120 ms ±30 ms the state a page holds is under 2 RTT old at the 95th percentile, and no older than a WebSocket page's (#13177)" #steps 40000000000 {
  for seed: [2] int.[1, 7] {
    a: [2] int; wt_sim_run(20, 120, 60, seed, 450, a[..]);
    #assert a[0] > 0 && a[0] < 240 && a[0] <= a[1];
  }
  // at 10% a WebSocket's page waits on TCP's resends; WebTransport's doesn't
  bad: [2] int; wt_sim_run(100, 120, 60, 1, 450, bad[..]);
  #assert bad[0] < 240 && bad[0] < bad[1];
  clean: [2] int; wt_sim_run(0, 120, 60, 3, 240, clean[..]);
  #assert clean[0] <= clean[1] + 34;   // with no loss the two are a tick apart at most
}
