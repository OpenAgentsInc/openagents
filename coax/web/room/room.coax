  #assert rm_join(w[..], 0, tk_test_ask(r[..], t[..], n)) == 0;
  kw := eg_room_at(w[..], w[0].conns[0].relay);
  #assert w[0].eg[kw].rules[0].b[0].c[E5RR_SEAT].hp == 5;
}
#test "control: the API's pvp row reaches the rules, a changed edit stamp is said to every page, and a kicked player goes and can't sit again" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  #assert rm_control_due(v[..]) && !rm_control_due(v[..]) && cast(string) v[0].ctl.ask[0..<v[0].ctl.ask_n] == "t 1762190000000";
  t: [256] u8; r: [512] u8;
  n := tk_sign(key, "p-0011223344556677", false, "", "pair-tk", now + 60000, -1, t[..]);
  #assert rm_join(v[..], 0, tk_test_ask(r[..], t[..], n)) == 0;
  n = tk_sign(key, "p-8899aabbccddeeff", false, "", "pair-tk", now + 60000, -1, t[..]);
  #assert rm_join(v[..], 1, tk_test_ask(r[..], t[..], n)) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  box: [1] EgInbox;
  rm_control(v[..], "pvp 0\nedit 100\n");
  #assert !v[0].eg[k].rules[0].pvp;
  eg_test_tick(v[..], k); eg_test_tick(v[..], k); eg_test_drain(v[..], box[..]);
  #assert !eg_test_has(eg_test_of(box[..], 1), "e edit");   // the first stamp is only learned
  rm_control(v[..], "pvp 1\nedit 107\nkick p-0011223344556677\n");
  #assert v[0].eg[k].rules[0].pvp && rm_relay_kicked(v[..], 0) && !rm_relay_kicked(v[..], 1);
  eg_test_tick(v[..], k); eg_test_tick(v[..], k); eg_test_drain(v[..], box[..]);
  #assert eg_test_has(eg_test_of(box[..], 1), "e edit 107");
  rm_left(v[..], 0);
  n = tk_sign(key, "p-0011223344556677", false, "", "pair-tk", now + 60000, -1, t[..]);
  #assert rm_join(v[..], 0, tk_test_ask(r[..], t[..], n)) < 0;
}
#test "vitals: a player back in the same room within VITALS_PLACE_MS stands where they were, not at the gate" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  t: [256] u8; r: [512] u8;
  n := tk_sign(key, "p-0011223344556677", false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 0, tk_test_ask(r[..], t[..], n)) == 0;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  #assert rm_eg_back(v[..], k, SeatId.{value = 0}, 0) == 0;   // a first visit: the gate
  rm_eg_moved(v[..], k, SeatId.{value = 0}, 0, 0, 0, -56, 0, 0, 0, 0, 1, 0, 0);
  rm_heard(v[..], 0, "I 1 0 0 0 0 0 0 0");
  rm_eg_moved(v[..], k, SeatId.{value = 0}, 1, 12.5, 0.25, -30, 1.5, 0, 0, 0, 1, 0, 0);
  n = tk_sign(key, "p-8899aabbccddeeff", false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 1, tk_test_ask(r[..], t[..], n)) == 1;
  // A's socket goes silent (a network that dropped) and A's page opens a new one 7 s on: A's own seat,
  // still where A stood (#12792)
  rm_clock(v[..], 7000, now + 7000);
  rm_heard(v[..], 1, "I 1 0 0 0 0 0 0 0");
  n = tk_sign(key, "p-0011223344556677", false, "", "pair-tk", now + 600000, -1, t[..]);
  s2 := rm_join(v[..], 2, tk_test_ask(r[..], t[..], n));
  #assert s2 == 0 && rm_relay_kicked(v[..], 0) && v[0].eg[k].seat[0].placed && v[0].eg[k].seat[0].pose.x == 12.5 && v[0].eg[k].seat[0].pose.z == -30;
  rm_left(v[..], 0);
  // A's socket closes and the grace runs out: A's next join is a new seat, where A stood
  rm_left(v[..], 2);
  rm_clock(v[..], 7000 + EG_GRACE_MS + 1000, now + 7000 + EG_GRACE_MS + 1000);
  #assert rm_eg_begin(v[..], k) && !v[0].eg[k].seat[0].live;
  n = tk_sign(key, "p-0011223344556677", false, "", "pair-tk", now + 600000, -1, t[..]);
  s4 := rm_join(v[..], 2, tk_test_ask(r[..], t[..], n));
  #assert s4 >= 0 && !v[0].eg[k].seat[s4].placed;
  #assert rm_eg_back(v[..], k, SeatId.{value = s4}, 0) == 1 && rm_eg_back(v[..], k, SeatId.{value = s4}, 1) == 12.5 && rm_eg_back(v[..], k, SeatId.{value = s4}, 2) == 0.25 && rm_eg_back(v[..], k, SeatId.{value = s4}, 3) == -30 && rm_eg_back(v[..], k, SeatId.{value = s4}, 4) == 1.5;
  rm_left(v[..], 2);
  // B leaves and comes back after VITALS_PLACE_MS: the gate
  rm_left(v[..], 1);
  rm_clock(v[..], 7000 + VITALS_PLACE_MS + 1000, now + 7000 + VITALS_PLACE_MS + 1000);
  if rm_eg_begin(v[..], k) {}   // (the held seats' grace over)
  n = tk_sign(key, "p-8899aabbccddeeff", false, "", "pair-tk", now + 600000 + VITALS_PLACE_MS, -1, t[..]);
  s3 := rm_join(v[..], 1, tk_test_ask(r[..], t[..], n));
  k = eg_room_at(v[..], v[0].conns[1].relay);
  #assert s3 >= 0 && rm_eg_back(v[..], k, SeatId.{value = s3}, 0) == 0;
  // A in another room: the gate there
  n = tk_sign(key, "p-0011223344556677", false, "", "pair-other", now + 600000 + VITALS_PLACE_MS, -1, t[..]);
  #assert rm_join(v[..], 3, tk_test_ask_in(r[..], t[..], n, "pair-other")) >= 0;
  ko := eg_room_at(v[..], v[0].conns[3].relay);
  #assert ko != k && rm_eg_back(v[..], ko, SeatId.{value = v[0].conns[3].seat}, 0) == 0;
}
#test "relay: a player's own silent socket gives way to their new one (no twin in the town); one still talking stays" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  t: [256] u8; r: [512] u8;
  n := tk_sign(key, "p-0011223344556677", false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 0, tk_test_ask(r[..], t[..], n)) == 0;
  // a second tab while the first still talks: both stay
  rm_clock(v[..], 1000, now + 1000);
  rm_heard(v[..], 0, "I 1 0 0 0 0 0 0 0");
  n = tk_sign(key, "p-0011223344556677", false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 1, tk_test_ask(r[..], t[..], n)) == 1;
  #assert !rm_relay_kicked(v[..], 0) && !rm_relay_kicked(v[..], 1);
  // the first goes silent (its phone changed networks); the player's new socket takes its seat (#12792)
  rm_clock(v[..], 6000, now + 6000);
  rm_heard(v[..], 1, "I 1 0 0 0 0 0 0 0");
  n = tk_sign(key, "p-0011223344556677", false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 2, tk_test_ask(r[..], t[..], n)) == 0;
  #assert rm_relay_kicked(v[..], 0) && !rm_relay_kicked(v[..], 1) && !rm_relay_kicked(v[..], 2);
  // a frame still in flight on the old socket is dropped and counted; the host's close of it leaves the seat be
  stale := rm_st_stale(v[..]);
  rm_heard(v[..], 0, "I 9 100 0 0 0 0 0 0");
  k := eg_room_at(v[..], v[0].conns[2].relay);
  #assert rm_st_stale(v[..]) == stale + 1 && v[0].eg[k].seat[0].q_n == 0;
  rm_left(v[..], 0);
  #assert v[0].eg[k].seat[0].live && v[0].eg[k].seat[0].conn == 2;
  // another player's silent socket is theirs: it stays
  n = tk_sign(key, "p-8899aabbccddeeff", false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 3, tk_test_ask(r[..], t[..], n)) == 2;
  rm_clock(v[..], 12000, now + 12000);
  rm_heard(v[..], 1, "I 2 0 0 0 0 0 0 0"); rm_heard(v[..], 2, "I 1 0 0 0 0 0 0 0");
  n = tk_sign(key, "p-0011223344556677", false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 4, tk_test_ask(r[..], t[..], n)) == 3;
  #assert !rm_relay_kicked(v[..], 3) && !rm_relay_kicked(v[..], 1) && !rm_relay_kicked(v[..], 2);
}
// A ticket for player pid in room with owner generation owner (#12834), and the join's request line.
rl_test_owned :: (r: [] u8, t: [] u8, key: string, pid: string, room: string, owner: int, now: int) -> string {
  n := tk_sign_owner(key, pid, false, "", room, 0, now + 600000, -1, -1, 0, owner, t);
  return tk_test_ask_in(r, t, n, room);
}
// What conns a and b heard since the last drain, into ba and bb (rl_heard_by for two).
rl_test_heard2 :: (v: [] RmServer, a: int, ba: [] u8, na: [] int, b: int, bb: [] u8, nb: [] int) {
  na[0] = 0; nb[0] = 0;
  while true {
    got := rm_relay_next(v);
    if got == 0 { break; }
    if v[0].rto[a] { if na[0] > 0 { ba[na[0]] = '|'; na[0] += 1; } for i: 0..<got { ba[na[0]] = v[0].rout[i]; na[0] += 1; } }
    if v[0].rto[b] { if nb[0] > 0 { bb[nb[0]] = '|'; nb[0] += 1; } for i: 0..<got { bb[nb[0]] = v[0].rout[i]; nb[0] += 1; } }
  }
}
#test "owner (#12834): a newer ticket takes its character's seat from a tab still talking, which is told elsewhere; an older ticket is refused" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  t: [256] u8; r: [512] u8; box: [8192] u8;
  a := "p-0011223344556677";
  #assert rm_join(v[..], 0, rl_test_owned(r[..], t[..], key, a, "pair-tk", 3, now)) == 0;
  #assert rm_join(v[..], 1, rl_test_owned(r[..], t[..], key, "p-8899aabbccddeeff", "pair-tk", 9, now)) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  _ := rl_heard_by(v[..], 0, box[..]); _ = rl_heard_by(v[..], 1, box[..]);
  // a second tab (generation 4) while the first still talks: it takes the same seat, the first hears elsewhere
  rm_clock(v[..], 1000, now + 1000);
  rm_heard(v[..], 0, "I 1 0 0 0 0 0 0 0");
  #assert rm_join(v[..], 2, rl_test_owned(r[..], t[..], key, a, "pair-tk", 4, now)) == 0;
  #assert rm_relay_kicked(v[..], 0) && !rm_relay_kicked(v[..], 2) && v[0].eg[k].seat[0].conn == 2;
  #assert eg_test_has(rl_heard_by(v[..], 0, box[..]), "r 0 elsewhere");
  b := rl_heard_by(v[..], 1, box[..]);
  #assert !eg_test_has(b, "j 0") && !eg_test_has(b, "l 0");
  // the first tab's close leaves the seat be
  rm_left(v[..], 0);
  #assert v[0].eg[k].seat[0].live && v[0].eg[k].seat[0].conn == 2;
  // a page that asked for its ticket before the second tab's (3): refused, and counted
  #assert rm_join(v[..], 3, rl_test_owned(r[..], t[..], key, a, "pair-tk", 3, now)) == -1 && rm_st_refused(v[..], ST_ELSEWHERE) == 1;
  #assert rm_st_reason(ST_ELSEWHERE) == "elsewhere";
  // the player chose this tab again (a new ticket, 5): it takes the seat back, and the second hears elsewhere
  rm_heard(v[..], 2, "I 1 0 0 0 0 0 0 0");
  #assert rm_join(v[..], 4, rl_test_owned(r[..], t[..], key, a, "pair-tk", 5, now)) == 0;
  #assert rm_relay_kicked(v[..], 2) && eg_test_has(rl_heard_by(v[..], 2, box[..]), "r 0 elsewhere");
  // held seat: a closed socket's seat waits for its player, and an older ticket can't take it
  rm_left(v[..], 2); rm_left(v[..], 4);
  #assert eg_held(v[..], k, SeatId.{value = 0}) && rl_owner_newest(v[..], a) == 5;
  #assert rm_join(v[..], 5, rl_test_owned(r[..], t[..], key, a, "pair-tk", 4, now)) == -1;
  #assert rm_join(v[..], 5, rl_test_owned(r[..], t[..], key, a, "pair-tk", 6, now)) == 0 && !eg_held(v[..], k, SeatId.{value = 0});
  // tickets with no generation keep the rule before: a second tab sits beside the first
  c := "p-c0ffeec0ffeec0ff";
  n := tk_sign(key, c, false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 6, tk_test_ask(r[..], t[..], n)) == 2;
  rm_heard(v[..], 6, "I 1 0 0 0 0 0 0 0");
  n = tk_sign(key, c, false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 7, tk_test_ask(r[..], t[..], n)) == 3 && !rm_relay_kicked(v[..], 6);
}
#test "owner (#12834): a newer ticket in another room here ends the character's seat in the first, held or not; an older one there is refused" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  t: [256] u8; r: [512] u8; box: [8192] u8;
  a := "p-0011223344556677";
  #assert rm_join(v[..], 0, rl_test_owned(r[..], t[..], key, a, "pair-a", 5, now)) == 0;
  #assert rm_join(v[..], 1, rl_test_owned(r[..], t[..], key, "p-8899aabbccddeeff", "pair-a", 2, now)) == 1;
  ka := eg_room_at(v[..], v[0].conns[0].relay);
  _ := rl_heard_by(v[..], 0, box[..]); _ = rl_heard_by(v[..], 1, box[..]);
  // A logs in to pair-b with a newer ticket: their pair-a seat goes at once, its socket told elsewhere
  #assert rm_join(v[..], 2, rl_test_owned(r[..], t[..], key, a, "pair-b", 6, now)) == 0;
  ha: [8192] u8; hb: [8192] u8; na: [1] int; nb: [1] int;
  rl_test_heard2(v[..], 0, ha[..], na[..], 1, hb[..], nb[..]);
  #assert rm_relay_kicked(v[..], 0) && !v[0].eg[ka].seat[0].live && eg_test_has(cast(string) ha[0..<na[0]], "r 0 elsewhere");
  #assert eg_test_has(cast(string) hb[0..<nb[0]], "l 0") && !eg_test_has(cast(string) ha[0..<na[0]], "l 0");
  // another player sits meanwhile; the old socket's close: no second l, and nobody else's seat changes
  #assert rm_join(v[..], 3, rl_test_owned(r[..], t[..], key, "p-1111222233334444", "pair-a", 1, now)) == 2;
  _ = rl_heard_by(v[..], 1, box[..]);
  rm_left(v[..], 0);
  #assert v[0].eg[ka].seat[2].live && v[0].eg[ka].seat[1].live && !v[0].eg[ka].seat[0].live && !eg_test_has(rl_heard_by(v[..], 1, box[..]), "l ");
  // A's old page asks pair-a again with its older ticket: refused
  #assert rm_join(v[..], 4, rl_test_owned(r[..], t[..], key, a, "pair-a", 5, now)) == -1 && rm_st_refused(v[..], ST_ELSEWHERE) == 1;
  // A's pair-b socket closes (held), and A logs in to pair-a with a newer ticket: the held seat goes too
  kb := eg_room_at(v[..], v[0].conns[2].relay);
  rm_left(v[..], 2);
  #assert eg_held(v[..], kb, SeatId.{value = 0});
  #assert rm_join(v[..], 5, rl_test_owned(r[..], t[..], key, a, "pair-a", 7, now)) == 0;
  #assert !v[0].eg[kb].live && rl_owner_newest(v[..], a) == 7;
}
#test "owner (#12834): a vitals line fenced for good ends the character's seats of that owner here, each told elsewhere" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  rm_vitals_gen(v[..], now - 5000);
  t: [256] u8; r: [512] u8; box: [8192] u8; b: [128] u8;
  a := "p-0011223344556677";
  #assert rm_join(v[..], 0, rl_test_owned(r[..], t[..], key, a, "pair-tk", 7, now)) == 0;
  #assert rm_join(v[..], 1, rl_test_owned(r[..], t[..], key, "p-8899aabbccddeeff", "pair-tk", 2, now)) == 1;
  k := eg_room_at(v[..], v[0].conns[0].relay);
  _ := rl_heard_by(v[..], 0, box[..]); _ = rl_heard_by(v[..], 1, box[..]);
  #assert rm_vitals_due(v[..]) > 0 && eg_test_has(cast(string) v[0].vit.out[0..<v[0].vit.out_n], " 7\n");
  rm_vitals_answer(v[..], 1, 200, rv_test_receipt(b[..], now - 5000, 1, "aa"));
  // unchanged, nothing goes; VITALS_OWNER_MS on, the seated owners' lines go again
  rm_clock(v[..], 1000, now + 1000);
  #assert rm_vitals_due(v[..]) == 0;
  rm_clock(v[..], VITALS_OWNER_MS, now + VITALS_OWNER_MS);
  #assert rm_vitals_due(v[..]) > 0 && eg_test_has(cast(string) v[0].vit.out[0..<v[0].vit.out_n], " 7\n") && v[0].vit.fly_n == 2;
  // the room was paused while A moved to a room on another shard; resumed, its line for A is fenced
  rm_vitals_answer(v[..], 2, 200, rv_test_receipt(b[..], now - 5000, 2, "fd"));
  #assert rm_vitals_stat(v[..], 11) == 1 && rm_vitals_stat(v[..], 12) == 1;
  #assert !v[0].eg[k].seat[0].live && v[0].eg[k].seat[1].live && rm_relay_kicked(v[..], 0) && !rm_relay_kicked(v[..], 1);
  ha: [8192] u8; hb: [8192] u8; na: [1] int; nb: [1] int;
  rl_test_heard2(v[..], 0, ha[..], na[..], 1, hb[..], nb[..]);
  #assert eg_test_has(cast(string) ha[0..<na[0]], "r 0 elsewhere") && eg_test_has(cast(string) hb[0..<nb[0]], "l 0");
  rm_left(v[..], 0);
  #assert !v[0].eg[k].seat[0].live;
  // the page again with its ticket of that owner: refused, though no seat of A's is here; a newer one sits
  #assert rm_join(v[..], 2, rl_test_owned(r[..], t[..], key, a, "pair-tk", 7, now)) == -1 && rm_st_refused(v[..], ST_ELSEWHERE) == 1;
  #assert rm_join(v[..], 3, rl_test_owned(r[..], t[..], key, a, "pair-tk", 8, now)) >= 0;
}
#test "travel (#12850): a player asks for another room here; a seat there is set aside, their seat cuts over, they're sent, and arrive with no twin" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  t: [256] u8; r: [512] u8; box: [8192] u8;
  a := "p-0011223344556677";
  #assert rm_join(v[..], 0, rl_test_owned(r[..], t[..], key, a, "pair-a", 3, now)) == 0;
  #assert rm_join(v[..], 1, rl_test_owned(r[..], t[..], key, "p-8899aabbccddeeff", "pair-a", 2, now)) == 1;
  #assert rm_join(v[..], 2, rl_test_owned(r[..], t[..], key, "p-c0ffeec0ffeec0ff", "pair-b", 2, now)) == 0;
  #assert rm_join(v[..], 3, rl_test_owned(r[..], t[..], key, "p-1111222233334444", "pair-c", 2, now)) == 0;
  ka := eg_room_at(v[..], v[0].conns[0].relay); kb := eg_room_at(v[..], v[0].conns[2].relay);
  rb := v[0].conns[2].relay; rc := v[0].conns[3].relay;
  _ := rl_heard_by(v[..], 0, box[..]);
  // not this realm's, or this room: refused, and A plays on
  rm_heard(v[..], 0, "T 1 other-1"); rm_heard(v[..], 0, "T 2 pair-a");
  #assert eg_test_has(rl_heard_by(v[..], 0, box[..]), "r 2 room") && !eg_travelling(v[..], ka, SeatId.{value = 0});
  // full: pair-c has one seat, taken
  v[0].relays[rc].seats = 1;
  rm_heard(v[..], 0, "T 3 pair-c");
  #assert eg_test_has(rl_heard_by(v[..], 0, box[..]), "r 3 full") && !eg_travelling(v[..], ka, SeatId.{value = 0}) && rm_travel_stat(v[..], 2) == 1;
  // pair-b: one seat left, and it is set aside for A; A's intents stop, and its state is posted
  v[0].relays[rb].seats = 2;
  rm_vitals_gen(v[..], now - 5000);
  rm_heard(v[..], 0, "T 4 pair-b");
  #assert eg_travelling(v[..], ka, SeatId.{value = 0}) && v[0].vit.flush && rv_find(v[..], a) >= 0;
  // A's page hears g only once the API's receipt covers what was captured
  #assert !eg_test_has(rl_heard_by(v[..], 0, box[..]), "g pair-b") && rm_vitals_due(v[..]) > 0;
  #assert !eg_test_has(rl_heard_by(v[..], 0, box[..]), "g pair-b");
  marks: [16] u8; for i: 0..<v[0].vit.fly_n { marks[i] = 0x61; }
  b: [128] u8;
  rm_vitals_answer(v[..], v[0].vit.batch, 200, rv_test_receipt(b[..], now - 5000, v[0].vit.batch, cast(string) marks[0..<v[0].vit.fly_n]));
  #assert eg_test_has(rl_heard_by(v[..], 0, box[..]), "g pair-b") && rm_travel_stat(v[..], 1) == 1;
  q := v[0].eg[ka].seat[0].q_n;
  rm_heard(v[..], 0, "I 1 0 100 0 0 0 0 0");
  #assert v[0].eg[ka].seat[0].q_n == q && rm_travel_stat(v[..], 6) == 1;
  // someone else's join to pair-b: the seat is A's
  #assert rm_join(v[..], 4, rl_test_owned(r[..], t[..], key, "p-5555666677778888", "pair-b", 2, now)) == -1 && rm_st_refused(v[..], ST_FULL) == 1;
  // A's page leaves: the seat goes at once (B hears l, nothing held)
  rm_left(v[..], 0);
  #assert !v[0].eg[ka].seat[0].live && eg_test_has(rl_heard_by(v[..], 1, box[..]), "l 0");
  // and joins pair-b with its new ticket: the set-aside seat, its HP from this server's note
  hp := v[0].vit.v[rv_find(v[..], a)].hp;
  s := rm_join(v[..], 5, rl_test_owned(r[..], t[..], key, a, "pair-b", 4, now));
  #assert s == 1 && rm_travel_stat(v[..], 4) == 1 && v[0].eg[kb].rules[0].b[0].c[E5RR_SEAT + 1].hp == hp;
}
#test "travel (#12850): to a room on this server, spent spell slots and uses, Temporary Hit Points and the Repair wait travel with the character" #steps 3000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  t: [256] u8; r: [512] u8; box: [8192] u8;
  a := "p-0011223344556677";
  #assert rm_join(v[..], 0, rl_test_owned(r[..], t[..], key, a, "pair-a", 3, now)) == 0;
  #assert rm_join(v[..], 1, rl_test_owned(r[..], t[..], key, "p-c0ffeec0ffeec0ff", "pair-b", 2, now)) == 0;
  ka := eg_room_at(v[..], v[0].conns[0].relay); kb := eg_room_at(v[..], v[0].conns[1].relay);
  rm_heard(v[..], 0, "H 5 ranger.0.0.0 warlock 0 Ash");
  // spent: a slot of each level it has, a use, 4 Temporary Hit Points; repaired 2 s ago
  c := v[0].eg[ka].rules[0].b[0].c[E5RR_SEAT..<E5RR_SEAT + 1];
  lv := -1; for i: 1..<10 { if lv < 0 && c[0].slots_max[i] > 0 { lv = i; } }
  #assert lv > 0;
  c[0].slots[lv] = c[0].slots_max[lv] - 1; c[0].temp = 4;
  u := -1; for i: 0..<RS_USES { if u < 0 && c[0].uses_max[i] > 0 { u = i; } }
  if u >= 0 { c[0].uses[u] = c[0].uses_max[u] - 1; }
  v[0].eg[ka].seat[0].repaired = v[0].eg[ka].tick - 2 * EG_HZ;
  rm_vitals_gen(v[..], now - 5000);
  rm_heard(v[..], 0, "T 4 pair-b");
  #assert eg_travelling(v[..], ka, SeatId.{value = 0}) && rm_vitals_due(v[..]) > 0;
  marks: [16] u8; for i: 0..<v[0].vit.fly_n { marks[i] = 0x61; }
  b: [128] u8;
  rm_vitals_answer(v[..], v[0].vit.batch, 200, rv_test_receipt(b[..], now - 5000, v[0].vit.batch, cast(string) marks[0..<v[0].vit.fly_n]));
  #assert eg_test_has(rl_heard_by(v[..], 0, box[..]), "g pair-b");
  rm_left(v[..], 0);
  // pair-b: the same build, laid on after its hello; the Repair wait goes on from where it was
  s := rm_join(v[..], 2, rl_test_owned(r[..], t[..], key, a, "pair-b", 4, now));
  #assert s == 1;
  rm_heard(v[..], 2, "H 5 ranger.0.0.0 warlock 0 Ash");
  d := v[0].eg[kb].rules[0].b[0].c[E5RR_SEAT + 1];
  #assert d.slots[lv] == d.slots_max[lv] - 1 && d.temp == 4;
  if u >= 0 { #assert d.uses[u] == d.uses_max[u] - 1; }
  #assert v[0].eg[kb].tick - v[0].eg[kb].seat[1].repaired == 2 * EG_HZ;
  // once: a later hello builds it as any hello does
  rm_heard(v[..], 2, "H 5 ranger.0.0.0 druid 0 Ash");
  rm_heard(v[..], 2, "H 5 ranger.0.0.0 warlock 0 Ash");
  #assert v[0].eg[kb].rules[0].b[0].c[E5RR_SEAT + 1].slots[lv] == v[0].eg[kb].rules[0].b[0].c[E5RR_SEAT + 1].slots_max[lv];
}
#test "travel (#12850): a cast on its bar stops at the cutover, and the room hears why; one released before lands" #steps 3000000000 {
  v: [1] RmServer; box: [1] EgInbox;
  rm_init(v[..]);
  rm_control(v[..], "levels 0 2\n");
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  t: [256] u8; r: [512] u8;
  #assert rm_join(v[..], 0, rl_test_owned(r[..], t[..], key, "p-0011223344556677", "pair-a", 3, now)) == 0;
  #assert rm_join(v[..], 1, rl_test_owned(r[..], t[..], key, "p-8899aabbccddeeff", "pair-a", 2, now)) == 1;
  #assert rm_join(v[..], 2, rl_test_owned(r[..], t[..], key, "p-c0ffeec0ffeec0ff", "pair-b", 2, now)) == 0;
  ka := eg_room_at(v[..], v[0].conns[0].relay);
  for q: 0..<10 { rc_test_tick(v[..], ka, true); }
  rm_heard(v[..], 0, "C 1 0 3000 0 0 -1");   // Meteor Swarm's 2.5 s bar
  for q: 0..<20 { rc_test_tick(v[..], ka, true); }
  eg_test_drain(v[..], box[..]);
  #assert !eg_test_has(eg_test_of(box[..], 1), "e stop");
  rm_heard(v[..], 0, "T 2 pair-b");
  rc_test_tick(v[..], ka, true);
  eg_test_drain(v[..], box[..]);
  #assert eg_travelling(v[..], ka, SeatId.{value = 0});
  #assert eg_test_has(eg_test_of(box[..], 1), "e stop 0 0 left");
  on := 0; for c: 0..<EG_CASTS { if v[0].eg[ka].casts[c].on && v[0].eg[ka].casts[c].seat == 0 { on += 1; } }
  #assert on == 0;
  // released: a cast in flight is left alone
  v[0].eg[ka].casts[0] = EgCast.{on = true, seat = 1, phase = RC_FLIGHT};
  v[0].eg[ka].casts[1] = EgCast.{on = true, seat = 1, phase = RC_BAR};
  rc_cutover(v[..], ka, SeatId.{value = 1});
  #assert v[0].eg[ka].casts[0].on && !v[0].eg[ka].casts[1].on;
}
#test "travel (#12850): unsaved, no route; a page that never leaves gets its commands back after TRAVEL_MS, and the set-aside seat lapses" #steps 2000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  t: [256] u8; r: [512] u8; box: [8192] u8;
  a := "p-0011223344556677";
  #assert rm_join(v[..], 0, rl_test_owned(r[..], t[..], key, a, "pair-a", 3, now)) == 0;
  #assert rm_join(v[..], 1, rl_test_owned(r[..], t[..], key, "p-c0ffeec0ffeec0ff", "pair-b", 2, now)) == 0;
  ka := eg_room_at(v[..], v[0].conns[0].relay);
  v[0].relays[v[0].conns[1].relay].seats = 2;
  rm_heard(v[..], 0, "T 1 pair-b");
  #assert eg_travelling(v[..], ka, SeatId.{value = 0});
  // a second ask while cut over is dropped, not a second journey; no receipt ever comes (the API is
  // down, or this room crashed before its post): no route
  rm_heard(v[..], 0, "T 2 pair-b");
  #assert rm_travel_stat(v[..], 6) == 1 && rm_travel_stat(v[..], 1) == 0 && !eg_test_has(rl_heard_by(v[..], 0, box[..]), "g ");
  rm_clock(v[..], TRAVEL_MS, now + TRAVEL_MS);
  q := v[0].eg[ka].seat[0].q_n;
  rm_heard(v[..], 0, "I 1 0 100 0 0 0 0 0");
  #assert !eg_travelling(v[..], ka, SeatId.{value = 0}) && v[0].eg[ka].seat[0].q_n == q + 1 && rm_travel_stat(v[..], 5) == 1;
  #assert rm_join(v[..], 2, rl_test_owned(r[..], t[..], key, "p-5555666677778888", "pair-b", 2, now)) == 1;
  // its close now holds the seat for it, as any page's (#12792)
  rm_left(v[..], 0);
  #assert eg_held(v[..], ka, SeatId.{value = 0});
}
// Ticks of room k, each draining what conn heard: whether any frame held part.
rl_test_ticks :: (v: [] RmServer, k: int, ticks: int, conn: int, part: string) -> bool {
  box: [65536] u8; any := false;
  for i: 0..<ticks { eg_test_tick(v, k); if eg_test_has(rl_heard_by(v, conn, box[..]), part) { any = true; } }
  return any;
}
#test "relay: a closed socket's seat is held for its player EG_GRACE_MS; their rejoin takes it back as it stood, after it the seat goes (#12792)" #steps 4000000000 {
  v: [1] RmServer;
  rm_init(v[..]);
  now := 1762190000000;
  rm_clock(v[..], 0, now);
  key := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  rm_ticket_key(v[..], key, true);
  t: [256] u8; r: [512] u8; box: [8192] u8;
  n := tk_sign(key, "p-0011223344556677", false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 0, tk_test_ask(r[..], t[..], n)) == 0;
  n = tk_sign(key, "p-8899aabbccddeeff", false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 1, tk_test_ask(r[..], t[..], n)) == 1;
  rm_heard(v[..], 0, "H 5 ranger.2.1.0 druid 0 A"); rm_heard(v[..], 1, "H 5 ranger.0.0.0 druid 0 B");
  k := eg_room_at(v[..], v[0].conns[0].relay);
  for i: 0..<10 { eg_test_tick(v[..], k); }
  // A is hurt, and walks a little; then A's socket closes
  v[0].eg[k].rules[0].b[0].c[E5RR_SEAT + 0].hp -= 3;
  hp := v[0].eg[k].rules[0].b[0].c[E5RR_SEAT + 0].hp;
  for i: 1..<6 { m: [64] u8; q := put(m[..], 0, "I "); q = put_int(m[..], q, i); q = put(m[..], q, " 0 0 100 0 0 0 0"); rm_heard(v[..], 0, cast(string) m[0..<q]); eg_test_tick(v[..], k); }
  x := v[0].eg[k].seat[0].pose.x;
  _ := rl_heard_by(v[..], 1, box[..]);
  rm_left(v[..], 0);
  // held: B hears no l, and A stands in the world
  v[0].eg_test_t0 += 5000;   // (the clock jumps on 5 s)
  #assert !rl_test_ticks(v[..], k, 3, 1, "l 0") && eg_held(v[..], k, SeatId.{value = 0}) && v[0].eg[k].seat[0].pose.x == x && rl_people(v[..], v[0].eg[k].relay) == 2;
  // A's page rejoins within the grace: the same seat, the next generation, the same HP; B hears no j
  n = tk_sign(key, "p-0011223344556677", false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 2, tk_test_ask(r[..], t[..], n)) == 0;
  a := rl_heard_by(v[..], 2, box[..]);
  #assert eg_test_has(a, "y 0 1 ") && eg_test_has(a, " 2|") && eg_test_has(a, "j 1") && v[0].conns[2].gen.value == 2 && v[0].eg[k].seat[0].gen.value == 2;
  #assert !eg_held(v[..], k, SeatId.{value = 0}) && v[0].eg[k].seat[0].full && v[0].eg[k].seat[0].ack == 0 && rm_st_re_seat(v[..]) == 1;
  #assert v[0].eg[k].rules[0].b[0].c[E5RR_SEAT + 0].hp == hp && v[0].eg[k].seat[0].pose.x == x && v[0].eg[k].seat[0].placed;
  rm_heard(v[..], 2, "H 5 ranger.2.1.0 druid 0 A");
  #assert v[0].eg[k].rules[0].b[0].c[E5RR_SEAT + 0].hp == hp;
  rm_heard(v[..], 1, "I 1 0 0 0 0 0 0 0");
  b := rl_heard_by(v[..], 1, box[..]);
  #assert !eg_test_has(b, "j 0") && !eg_test_has(b, "l 0");
  // its first D is a snapshot, and its inputs count from the new page's first
  rm_heard(v[..], 2, "I 1 0 0 0 0 0 0 0");
  eg_test_tick(v[..], k);
  #assert v[0].eg[k].seat[0].ack == 1;
  // closed again, and not back: at the grace's end the seat goes and B hears l
  rm_left(v[..], 2);
  v[0].eg_test_t0 += EG_GRACE_MS - 1000;
  #assert !rl_test_ticks(v[..], k, 3, 1, "l 0") && eg_held(v[..], k, SeatId.{value = 0});
  v[0].eg_test_t0 += 1000;
  #assert rl_test_ticks(v[..], k, 3, 1, "l 0") && !v[0].eg[k].seat[0].live && rl_people(v[..], v[0].eg[k].relay) == 1;
  // a kicked socket (over its limits, refused, an admin's kick) leaves at once
  n = tk_sign(key, "p-0011223344556677", false, "", "pair-tk", now + 600000, -1, t[..]);
  #assert rm_join(v[..], 3, tk_test_ask(r[..], t[..], n)) == 0;
  v[0].conns[3].kicked = true;
  rm_left(v[..], 3);
  #assert !v[0].eg[k].seat[0].live;
  // the last player gone, the held seat keeps the room; its grace over, the room closes
  rm_left(v[..], 1);
  #assert v[0].eg[k].live && eg_held(v[..], k, SeatId.{value = 1});
  v[0].eg_test_t0 += EG_GRACE_MS;
  for i: 0..<3 { eg_test_tick(v[..], k); }
  #assert !v[0].eg[k].live;
}
