// The scripted player (#13288, #13296): what a player with no person behind it presses, and in what
// order. One file for the two places that play one: the encounter simulator (encounter-sim.coax, a
// room in the same process) and the protocol bots (load.coax's soak mode, over the wire). It loads
// nothing: a bar's entry here is the few facts the choice needs, which the simulator reads from the
// rules and the bots from the table the simulator writes (bot-bars.coax).
//
// Each time the room would take a cast: below half its Hit Points, a heal on itself; else, once a
// fight, each buff on itself; else its harmful abilities, levelled spells highest first, then the
// rest in its bar's order, at the nearest foe (a Concentration spell not while it concentrates, nor
// a spell for Humanoids at a foe that isn't one). The first the room takes is its press.
SP_OTHER :: 0; SP_HEAL :: 1; SP_BUFF :: 2; SP_HARM :: 4;
// slot: the wire's bar slot; role: SP_* bits (an ability can heal and harm); lvl: a levelled spell's level, 0 for the rest;
// conc: a Concentration spell; humanoid: a spell for Humanoids only.
SpEntry :: struct { slot: int; role: int; lvl: int; conc: bool; humanoid: bool; }

#test "below half its Hit Points the scripted player tries its heals first, then unused buffs, then harm by level" {
  bar: [6] SpEntry;
  bar[0] = SpEntry.{slot = 10, role = SP_HARM};
  bar[1] = SpEntry.{slot = 11, role = SP_HEAL};
  bar[2] = SpEntry.{slot = 12, role = SP_BUFF};
  bar[3] = SpEntry.{slot = 13, role = SP_HARM, lvl = 1};
  bar[4] = SpEntry.{slot = 14, role = SP_HARM, lvl = 3};
  bar[5] = SpEntry.{slot = 15, role = SP_OTHER};
  used: [6] bool; out: [6] int;
  n := sp_plan(bar[..], 6, true, used[..], false, true, out[..]);
  #assert n == 5 && out[0] == 1 && out[1] == 2 && out[2] == 4 && out[3] == 3 && out[4] == 0;
  n = sp_plan(bar[..], 6, false, used[..], false, true, out[..]);
  #assert n == 4 && out[0] == 2 && out[1] == 4 && out[2] == 3 && out[3] == 0;
  used[2] = true;
  n = sp_plan(bar[..], 6, false, used[..], false, true, out[..]);
  #assert n == 3 && out[0] == 4 && out[1] == 3 && out[2] == 0;
}
#test "a Concentration spell waits while it concentrates, and a spell for Humanoids is not for a Beast" {
  bar: [4] SpEntry;
  bar[0] = SpEntry.{slot = 1, role = SP_HARM, lvl = 2, conc = true};
  bar[1] = SpEntry.{slot = 2, role = SP_HARM, lvl = 2, humanoid = true};
  bar[2] = SpEntry.{slot = 3, role = SP_HARM, lvl = 9};
  bar[3] = SpEntry.{slot = 4, role = SP_HARM, lvl = 2};
  used: [4] bool; out: [4] int;
  n := sp_plan(bar[..], 4, false, used[..], false, true, out[..]);
  #assert n == 4 && out[0] == 2 && out[1] == 0 && out[2] == 1 && out[3] == 3;
  n = sp_plan(bar[..], 4, false, used[..], true, true, out[..]);
  #assert n == 3 && out[0] == 2 && out[1] == 1 && out[2] == 3;
  n = sp_plan(bar[..], 4, false, used[..], false, false, out[..]);
  #assert n == 3 && out[0] == 2 && out[1] == 0 && out[2] == 3;
  // an ability that heals and harms is a heal when hurt and harm besides
  both: [1] SpEntry; both[0] = SpEntry.{slot = 9, role = SP_HEAL + SP_HARM};
  #assert sp_plan(both[..], 1, true, used[..], false, true, out[..]) == 2 && out[0] == 0 && out[1] == 0;
  #assert sp_plan(both[..], 1, false, used[..], false, true, out[..]) == 1;
  // a plan never writes past the room it is given, and an empty bar is no plan
  two: [2] int;
  #assert sp_plan(bar[..], 4, false, used[..], false, true, two[..]) == 2 && two[0] == 2 && two[1] == 0;
  #assert sp_plan(bar[..], 0, true, used[..], false, true, out[..]) == 0;
}

// The bar's entries to try, in order, as indices into bar: how many were written to out.
// hurt: below half its Hit Points; used: the buffs pressed this fight; concentrating: it holds a
// Concentration spell; foe_humanoid: the nearest foe is a Humanoid (true when there is none).
sp_plan :: (bar: [] SpEntry, n: int, hurt: bool, used: [] bool, concentrating: bool, foe_humanoid: bool, out: [] int) -> int {
  k := 0;
  for i: 0..<n { if hurt && (bar[i].role & SP_HEAL) != 0 && k < out.count { out[k] = i; k += 1; } }
  for i: 0..<n { if (bar[i].role & SP_BUFF) != 0 && !used[i] && k < out.count { out[k] = i; k += 1; } }
  for lv: 0..<10 {
    for i: 0..<n {
      a := bar[i];
      if (a.role & SP_HARM) == 0 || a.lvl != 9 - lv { continue; }
      if a.conc && concentrating { continue; }
      if a.humanoid && !foe_humanoid { continue; }
      if k < out.count { out[k] = i; k += 1; }
    }
  }
  return k;
}
