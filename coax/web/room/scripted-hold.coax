// Development fixture: apply the same named Hold Person target in paired rooms.
#authority;
#load "../../../apps/openagents-web/everglade5e-room-rules.coax";

#test "paired scripted holds keep one target when the nearest people differ" #steps 2000000000 {
  a:[1]E5rRoom;b:[1]E5rRoom;
  e5rr_start(a[..],7);e5rr_test_people(a[..]);
  e5rr_start(b[..],7);e5rr_test_people(b[..]);
  #assert e5rr_folk_near(a[..],3,0.7,30)!=e5rr_folk_near(b[..],3,0.9,30);
  #assert rc_script_hold_exact(a[..],1,3,0.7,30) && rc_script_hold_exact(b[..],1,3,0.9,30);
  out:[E5RR_OUT_FLOATS]f32;
  for side:0..<2 {
    r:=ifx side==0 then a[..] else b[..];
    e5rr_folk_out(r,1,out[..]);#assert (cast(int)out[3]&RS_PARALYZED)!=0 && out[7]==f32(SP_HOLD_PERSON);
    e5rr_folk_out(r,0,out[..]);#assert (cast(int)out[3]&RS_PARALYZED)==0;
    t:=r[0].b[0].clock;e5rr_step(r,t+5.5);e5rr_folk_out(r,1,out[..]);#assert (cast(int)out[3]&RS_PARALYZED)!=0;
    e5rr_step(r,t+6.5);e5rr_folk_out(r,1,out[..]);#assert (cast(int)out[3]&RS_PARALYZED)==0;
  }
}
#test "named scripted holds refuse invalid absent dead and distant people without a fallback" #steps 2000000000 {
  r:[1]E5rRoom;e5rr_start(r[..],7);e5rr_test_people(r[..]);
  #assert !rc_script_hold_exact(r[0..<0],0,0,0,30);
  #assert !rc_script_hold_exact(r[..],-1,0,0,30) && !rc_script_hold_exact(r[..],E5R_FOLK,0,0,30);
  #assert !rc_script_hold_exact(r[..],1,0,0,-30) && !rc_script_hold_exact(r[..],1,-80,0,30);
  i:=e5rr_folk(1);r[0].b[0].c[i].dead=true;
  #assert !rc_script_hold_exact(r[..],1,15,0,30);
  r[0].b[0].c[i].dead=false;r[0].b[0].c[i].x=E5R_AWAY;
  #assert !rc_script_hold_exact(r[..],1,15,0,30);
  out:[E5RR_OUT_FLOATS]f32;e5rr_folk_out(r[..],0,out[..]);#assert (cast(int)out[3]&RS_PARALYZED)==0;
}
rc_script_hold_exact :: (r:[]E5rRoom,person:int,x:f32,z:f32,reach:f32)->bool #effects(reads,writes,traps) {
  if r.count<1 || person<0 || person>=E5R_FOLK || reach<0 {return false;}
  i:=e5rr_folk(person);b:=r[0].b[..];
  if b[0].c[i].dead || b[0].c[i].x==E5R_AWAY {return false;}
  dx:=r[0].folk_x[person]-x;dz:=r[0].folk_z[person]-z;
  if !(dx*dx+dz*dz<=reach*reach) {return false;}
  return rs_put_effect(b,i,RsEffect.{kind=EF_COND,cond=RS_PARALYZED,by= -1,spell=SP_HOLD_PERSON,until=b[0].clock+E5RR_HOLD_S,save= -1,dc=0});
}
#test "named scripted hold propagates full effect storage refusal without changing owners" #steps 2000000000 {
  r:[1]E5rRoom;e5rr_start(r[..],7);e5rr_test_people(r[..]);
  i:=e5rr_folk(0);
  for k:0..<RS_EFFECTS {r[0].b[0].c[i].eff[k]=RsEffect.{kind=EF_HEX,by=100+k,until=100};}
  #assert !rc_script_hold_exact(r[..],0,3,0,0) && !rs_has(r[0].b[0].c[i],RS_PARALYZED);
  for k:0..<RS_EFFECTS {#assert r[0].b[0].c[i].eff[k].kind==EF_HEX && r[0].b[0].c[i].eff[k].by==100+k;}
}
#test "named holds preserve exact effect metadata and refuse across the folk span and reach boundary" #steps 2000000000 {
  r:[1]E5rRoom;e5rr_start(r[..],7);e5rr_test_people(r[..]);
  #assert rc_script_hold_exact(r[..],0,3,0,0) && rc_script_hold_exact(r[..],1,3,1.6,0);
  e:=r[0].b[0].c[e5rr_folk(0)].eff[0];
  #assert e.kind==EF_COND && e.cond==RS_PARALYZED && e.by== -1 && e.spell==SP_HOLD_PERSON && e.until==r[0].b[0].clock+E5RR_HOLD_S && e.save== -1 && e.dc==0;
  #assert !rc_script_hold_exact(r[..],0,-27,0,29.99) && rc_script_hold_exact(r[..],0,-27,0,30);
  #assert !rc_script_hold_exact(r[..],2,0,-30,30);
  #assert !rc_script_hold_exact(r[..],2,30,-30,29.99) && rc_script_hold_exact(r[..],2,30,-30,30);
  // The following battle slot can be alive without being a townsperson.
  r[0].b[0].c[e5rr_folk(E5R_FOLK)].dead=false;r[0].b[0].c[e5rr_folk(E5R_FOLK)].x=0;
  #assert !rc_script_hold_exact(r[..],E5R_FOLK,0,0,30);
}
