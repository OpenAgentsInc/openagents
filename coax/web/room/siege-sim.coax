// The siege with no player's help (#12860): a room with two idle seats at the players' spawn (no
// raider sets on them there, and they help neither side), the siege started at the default dials,
// then MINUTES (30 by default) of the room's own ticks, as fast as they run. It prints, each minute,
// the front (z, metres; the band before the palisade is z -81 to -63), each side's fighters standing,
// sent and fallen, then a summary line: the front's least and most, its share of seconds in the band,
// each side's fallen and reinforcements, the camp's fall (it shouldn't), and the tick's mean cost.
//   coax/web/tool.sh coax/web/room/siege-sim.coax [MINUTES] [SIZE]
// Exits 0 when the front kept its band 90% of the time, the camp stood, and both sides lost fighters
// and were reinforced.
#run_steps 250000000;   // secp256k1's tables: the seat ticket's v5 check (aethyr/session/seat-ticket.coax, #13260)
#import "Basic";
#load "../../lib/sys/tool.coax";
#load "../../lib/sys/proc.coax";
#load "room.coax";
#load "../../../verse/everglade/points.coax";   // the players' spawn, by name (#13078)
#load "../map-points.coax";

ss_num :: (t: string) -> int { n := 0; for i: 0..<t.count { if t[i] >= '0' && t[i] <= '9' { n = n * 10 + cast(int) (t[i] - '0'); } } return n; }
ss_put :: (out: [] u8, at: int, t: string) -> int { for i: 0..<t.count { out[at + i] = t[i]; } return at + t.count; }
ss_int :: (out: [] u8, at: int, v: int) -> int {
  d: [20] u8; n := 0; x := v;
  if x == 0 { d[0] = '0'; n = 1; }
  while x > 0 { d[n] = cast(u8) ('0' + x % 10); x /= 10; n += 1; }
  for i: 0..<n { out[at + i] = d[n - 1 - i]; }
  return at + n;
}

ss_made :: (e: EvRoom) -> int { return e.mix[RS_NPC_CULTIST] + e.mix[RS_NPC_FANATIC] + e.mix[RS_NPC_WARLOCK]; }

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  _ := args_load(a[..]);
  minutes := ifx args_count(a[..]) > 0 then rs_max(ss_num(args_at(a[..], 0)), 1) else 30;
  size := ifx args_count(a[..]) > 1 then ss_num(args_at(a[..], 1)) else 12;
  v: [1] RmServer;
  k := ev_test_server(v[..]);
  // the seats at the spawn, where no raider sets on them: the map's spawn (the commons since
  // e0631669b3; this sim held them at the old one, (0, -84) on the road, until #13078)
  spawn := eg_point("spawn");
  if !map_need(spawn) { return 2; }
  for s: 0..<2 { v[0].eg[k].seat[s].pose.x = spawn.x + f32(s) * 2 - 1; v[0].eg[k].seat[s].pose.z = spawn.z; }
  dl: [256] u8;
  n := ss_put(dl[..], 0, "event 1 0 3 "); n = ss_int(dl[..], n, size); n = ss_put(dl[..], n, " 6 1 3 3 31 1 2 1 100 15 0 0\n");
  rm_control(v[..], cast(string) dl[0..<n]);
  n = ss_put(dl[..], 0, "event 1 0 3 "); n = ss_int(dl[..], n, size); n = ss_put(dl[..], n, " 6 1 3 3 31 1 2 1 100 15 1 0\n");
  rm_control(v[..], cast(string) dl[0..<n]);
  ev_test_skip(v[..], k);
  e := v[0].ev[k..<k + 1];
  caps := e[0].caps;
  print("siege: size %, caps cult % watch %, phase %\n", size, caps[0], caps[1], e[0].phase);
  lo: f32 = 0; hi: f32 = -1000; band := 0; secs := 0; fell := false; stands := 0; was_phase := e[0].phase;
  t0 := proc_now_ms();
  for m: 0..<minutes {
    for s: 0..<60 {
      for t: 0..<EG_HZ { eg_test_tick(v[..], k); }
      for q: 0..<2 { v[0].eg[k].seat[q].pose.x = spawn.x + f32(q) * 2 - 1; v[0].eg[k].seat[q].pose.z = spawn.z; }   // idle at the spawn
      z := e[0].front[0].z;
      if secs == 0 { lo = z; }
      lo = ifx z < lo then z else lo; hi = ifx z > hi then z else hi;
      if rf_in_band(z) { band += 1; }
      secs += 1;
      if e[0].phase == EV_STAND && was_phase != EV_STAND { stands += 1; }
      if e[0].outcome == EV_OUT_HELD { fell = true; }
      was_phase = e[0].phase;
    }
    made := ss_made(e[0]);
    print("min %: front z % (u %), cult % standing of % sent, % fallen; watch % standing of % sent, % fallen; phase %\n",
          m + 1, e[0].front[0].z, rf_u(e[0].front[0].z), e[0].standing, made, made - e[0].standing, e[0].town, e[0].tsent, e[0].tsent - e[0].town, e[0].phase);
  }
  ms := proc_now_ms() - t0;
  made := ss_made(e[0]);
  cult_fallen := made - e[0].standing; town_fallen := e[0].tsent - e[0].town;
  cult_re := made - caps[0]; town_re := e[0].tsent - caps[1];
  pct := band * 100 / rs_max(secs, 1);
  print("summary: % min, front z % to %, % pct in band, cult fallen % reinforced %, watch fallen % reinforced %, stands %, camp % , % us a tick\n",
        minutes, lo, hi, pct, cult_fallen, cult_re, town_fallen, town_re, stands, ifx fell then "fell" else "stood", ms * 1000 / rs_max(secs * EG_HZ, 1));
  ok := pct >= 90 && !fell && cult_fallen > 0 && town_fallen > 0 && cult_re > 0 && town_re > 0;
  print("%\n", ifx ok then "holds" else "fails");
  return ifx ok then 0 else 1;
}
