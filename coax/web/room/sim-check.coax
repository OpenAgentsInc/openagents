// The everglade rooms' check (room-everglade.coax, room-world.c): two sockets share one world.
// A says who it is and walks ahead for two seconds at 30 inputs a second; B stands. Each hears the
// world's header (W), state at about 30 Hz (D), its own player with its ACK, and the other by name.
// A conjures its wolves 3 m off: both hear the cast (e cast) and the four Wolves (c, kind 12, with
// their Hit Points). B casts Starry Wisp (slot 22, one target) at one of them by its TGT code (2000 + EID) until it
// is gone: both hear B's hits on it (e hit) and it go (x c). A leaves: the room holds A's seat for
// the session's hold (LIFECYCLE_HOLD_MS, 15 s, #12792 and #12856), so 800 ms on B still has A and
// the rest of the pack (A's Concentration holds while A's character does), then hears A gone (x ID)
// once the hold runs out.
// B strikes a townsperson (WANTED, A not) and calls meteors on the town: both hear the same breaks up to the rebuild (A leaves just after it).
// C joins then: within 1 s its snapshot has the broken town, B's WANTED and the people. B's R is
// refused while the spell is fresh, and 10 s on stands the town up for everyone.
//   coax/web/tool.sh coax/web/room/sim-check.coax [ws://localhost:8830]
//   (deploy.sh runs it through wss://openagents.com)
// Prints one JSON line, then "shares" and exits 0, or "fails" and 1.
#run_steps 250000000;   // secp256k1's tables: the seat ticket's v5 check (aethyr/session/seat-ticket.coax, #13260)
#load "room-socket.coax";
#load "../../../aethyr/session/lifecycle.coax";   // LIFECYCLE_HOLD_MS: how long the room holds a closed socket's seat

SC_SEATS :: 3;   // A, B and C, who joins late
// the town's people it can tell apart: the 40 who live there and the watch's responders a WANTED star brings (#12872)
SC_FOLK :: 128;
// What one socket heard.
ScHeard :: struct {
  w: bool; d: int; snap: bool; ack: int;
  me_x: f32; me_z: f32; me_z0: f32; me_seen: bool;          // its own player
  other_seen: bool; other_z0: f32; other_z: f32; other_named: bool;
  cast_seen: bool; wolves: [8] int; wolf_n: int; wolf_x: f32; wolf_z: f32; wolf_hp: int;
  gone: [8] int; gone_n: int; hits: int; other_gone: bool;
  folk: [SC_FOLK] bool; folk_n: int; near_i: int = -1; near_d: f32 = 1000000; near_x: f32; near_z: f32;   // the town's people (f)
  wanted: int; wanted_heard: bool;                       // its own WANTED level (w)
  other_wanted: int;                                     // the other's (w)
  wanted_of: [16] int;                                   // every seat's (w)
  breaks: int; break_sum: int; burns: int; rebuilt: bool; breaks_up: int; sum_up: int; // the town's pieces (e break, e burn, e rebuild)
  refused_breaking: bool; refused_n: int;                                // R too soon after a break (r SEQ breaking)
  bad: int;
  m: [1] WireMirror;   // the rows its D's left, as the page's (its I's HEARD)
}
sc_cm :: (t: string) -> f32 { return f32(rs_num(t)) / 100.0; }
// One D entry: "s ID ..." (read into the mirror with its frame: sc_hear), "n SS ...", "x ID", "e cast SS ...".
sc_entry :: (h: [] ScHeard, me: int, t: string) {
  k := rs_field(t, 0);
  if k == "s" {
    w := wire_mirror_of(h[0].m[..], rs_num(rs_field(t, 1)));
    if w.id < 0 { h[0].bad += 1; return; }   // a row its mirror couldn't read
    if w.kind == WK_PLAYER {
      z := w.z;
      if w.id == me { h[0].me_x = w.x; h[0].me_z = z; if !h[0].me_seen { h[0].me_z0 = z; } h[0].me_seen = true; }
      else { if !h[0].other_seen { h[0].other_z0 = z; } h[0].other_z = z; h[0].other_seen = true; }
      return;
    }
    if w.kind == WK_BEAST {
      id := w.id - WIRE_ID_MADE;
      known := false;
      for q: 0..<h[0].wolf_n { if h[0].wolves[q] == id { known = true; } }
      if !known && h[0].wolf_n < 8 { h[0].wolves[h[0].wolf_n] = id; h[0].wolf_n += 1; }
      if id == h[0].wolves[0] { h[0].wolf_x = w.x; h[0].wolf_z = w.z; h[0].wolf_hp = w.hp; }
      return;
    }
    if w.kind == WK_FOLK {
      i := w.id - WIRE_ID_FOLK;
      if i < 0 || i >= SC_FOLK || w.p1 != i { h[0].bad += 1; return; }
      if !h[0].folk[i] { h[0].folk[i] = true; h[0].folk_n += 1; }
      x := w.x; z := w.z;
      d := (x - h[0].me_x) * (x - h[0].me_x) + (z - h[0].me_z) * (z - h[0].me_z);
      if i == h[0].near_i || d < h[0].near_d { h[0].near_i = i; h[0].near_d = d; h[0].near_x = x; h[0].near_z = z; }
    }
    return;
  }
  if k == "n" { if rs_num(rs_field(t, 1)) != me && rs_ends(t, " Sim A") { h[0].other_named = true; } return; }
  if k == "w" {
    if rs_num(rs_field(t, 1)) == me { h[0].wanted = rs_num(rs_field(t, 2)); h[0].wanted_heard = true; }
    else { h[0].other_wanted = rs_num(rs_field(t, 2)); }
    w := rs_num(rs_field(t, 1));
    if w >= 0 && w < 16 { h[0].wanted_of[w] = rs_num(rs_field(t, 2)); }
    return;
  }
  if k == "x" {
    id := rs_num(rs_field(t, 1));
    if id >= WIRE_ID_MADE && h[0].gone_n < 8 { h[0].gone[h[0].gone_n] = id - WIRE_ID_MADE; h[0].gone_n += 1; }
    if id >= 0 && id < WIRE_ID_FOLK && id != me { h[0].other_gone = true; }
    return;
  }
  if k == "e" && rs_field(t, 1) == "cast" && rs_field(t, 3) == "32" { h[0].cast_seen = true; }
  if k == "e" && rs_field(t, 1) == "break" { h[0].breaks += 1; h[0].break_sum += rs_num(rs_field(t, 2)); }
  if k == "e" && rs_field(t, 1) == "burn" { h[0].burns += 1; }
  if k == "e" && rs_field(t, 1) == "rebuild" { if !h[0].rebuilt { h[0].breaks_up = h[0].breaks; h[0].sum_up = h[0].break_sum; } h[0].rebuilt = true; }
  if k == "e" && rs_field(t, 1) == "hit" && h[0].wolf_n > 0 && rs_num(rs_field(t, 2)) == 2000 + h[0].wolves[0] && rs_field(t, 3) == "1001" { h[0].hits += 1; }
}
sc_hear :: (h: [] ScHeard, me: int, t: string) {
  if rs_starts(t, "W ") { h[0].w = true; return; }
  if rs_starts(t, "r ") && rs_ends(t, "breaking") { h[0].refused_breaking = true; h[0].refused_n += 1; return; }
  if !rs_starts(t, "D ") { return; }
  h[0].d += 1;
  h[0].ack = rs_num(rs_field(t, 2));
  if (rs_num(rs_field(t, 3)) & 1) != 0 { h[0].snap = true; }
  _ := wire_mirror_frame(h[0].m[..], t);
  // the entries after "D TICK ACK F PART "
  at := 0; sp := 0;
  while at < t.count && sp < 5 { if t[at] == ' ' { sp += 1; } at += 1; }
  while at < t.count {
    e := at;
    while e < t.count && t[e] != ';' { e += 1; }
    sc_entry(h, me, t[at..<e]);
    at = e + 1;
  }
}
sc_gone :: (h: ScHeard, id: int) -> bool { for q: 0..<h.gone_n { if h.gone[q] == id { return true; } } return false; }
rs_ends :: (t: string, end: string) -> bool { return t.count >= end.count && t[t.count - end.count..<t.count] == end; }
sc_drain :: (c: [] RelayConn, h: [] ScHeard) {
  for i: 0..<SC_SEATS {
    if c[i].h < 0 { continue; }
    while relay_conn_poll(c[i..<i + 1], 0) == RC_TEXT { sc_hear(h[i..<i + 1], i, cast(string) c[i].text[0..<c[i].text_n]); }
  }
}
// Both send an input each 1/30 s for ms: A ahead (ky 100) when walk, else both still.
sc_steps :: (c: [] RelayConn, h: [] ScHeard, seq: [] int, ms: int, walk: bool) -> bool {
  ok := true;
  t0 := rs_now(); n := 0;
  while rs_now() - t0 < ms {
    for i: 0..<SC_SEATS {
      if c[i].h < 0 { continue; }
      seq[i] += 1;
      m: [96] u8;
      k := rs_int(m[..], rs_put(m[..], 0, "I "), seq[i]);
      k = rs_put(m[..], k, ifx walk && i == 0 then " 0 100 0 0 0 0" else " 0 0 0 0 0 0");
      k = rs_put(m[..], k, " "); k = rs_int(m[..], k, h[i].m[0].heard);
      if !relay_conn_send(c[i..<i + 1], cast(string) m[0..<k]) { ok = false; }
    }
    n += 1;
    while rs_now() - t0 < n * 1000 / 30 { sc_drain(c, h); proc_sleep(2); }
  }
  return ok;
}

// p-simcheck-STAMP-x: a test player (p-simcheck-*, as before, so a usage count leaves it out).
sc_pid :: (out: [] u8, stamp: int, end: string) -> string {
  n := rs_put(out, 0, "p-simcheck-"); n = rs_int(out, n, stamp); n = rs_put(out, n, end);
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("sim-check: bad arguments"); return 2; }
  b: [512] u8;
  base := rs_base(ifx args_count(a[..]) > 0 then args_at(a[..], 0) else "ws://localhost:8830", b[..]);
  u: [1024] u8;
  stamp := rs_stamp();
  url := rs_url(u[..], base, "/api/room/relay/everglade/", "pair-e2-sim-", stamp);
  // each run's own players: a fixed id came back with the last run's saved HP (down, once the watch
  // had struck it) and WANTED, and couldn't walk or cast
  ida: [48] u8; idb: [48] u8; idc: [48] u8;
  pa := sc_pid(ida[..], stamp, "-a"); pb := sc_pid(idb[..], stamp, "-b"); pc := sc_pid(idc[..], stamp, "-c");
  c: [SC_SEATS] RelayConn; h: [SC_SEATS] ScHeard; seq: [SC_SEATS] int;
  c[2].h = -1;   // C joins after the town breaks
  ua: [1024] u8; ub: [1024] u8;
  url_a := rs_ticketed(ua[..], url, pa, "Sim A"); url_b := rs_ticketed(ub[..], url, pb, "Sim B");
  if url.count == 0 || url_a.count == 0 || url_b.count == 0 || !relay_conn_open(c[0..<1], url_a) || !relay_conn_open(c[1..<2], url_b) { tool_err("sim-check: can't open "); tool_errln(url); print("fails\n"); return 1; }
  sent := relay_conn_send(c[0..<1], "H 6 ranger.2.1.0 druid 64 Sim A") && relay_conn_send(c[1..<2], "H 6 ranger.0.0.0 druid 64 Sim B");
  t0 := rs_now();
  sent = sc_steps(c[..], h[..], seq[..], 2000, true) && sent;
  walked := h[0].me_z - h[0].me_z0;
  seen_walk := h[1].other_z - h[1].other_z0;
  // A conjures a pack 3 m ahead of where it stands
  m: [128] u8;
  k := rs_int(m[..], rs_put(m[..], 0, "C "), seq[0] + 1);
  seq[0] += 1;
  k = rs_put(m[..], k, " 32 "); k = rs_int(m[..], k, cast(int) (h[0].me_x * 100));
  k = rs_put(m[..], k, " 0 "); k = rs_int(m[..], k, cast(int) ((h[0].me_z + 3) * 100)); k = rs_put(m[..], k, " -1");
  sent = relay_conn_send(c[0..<1], cast(string) m[0..<k]) && sent;
  sent = sc_steps(c[..], h[..], seq[..], 800, false) && sent;
  // B fights the first wolf it sees: Starry Wisp (slot 22) at it, every half second, until it is gone
  wolf := h[1].wolves[0];
  tries := 0;
  while wolf > 0 && tries < 16 && !sc_gone(h[1], wolf) {
    k = rs_int(m[..], rs_put(m[..], 0, "C "), seq[1] + 1);
    seq[1] += 1;
    k = rs_put(m[..], k, " 22 "); k = rs_int(m[..], k, cast(int) (h[1].wolf_x * 100));
    k = rs_put(m[..], k, " 0 "); k = rs_int(m[..], k, cast(int) (h[1].wolf_z * 100)); k = rs_put(m[..], k, " ");
    k = rs_int(m[..], k, 2000 + wolf);
    sent = relay_conn_send(c[1..<2], cast(string) m[0..<k]) && sent;
    sent = sc_steps(c[..], h[..], seq[..], 500, false) && sent;
    tries += 1;
  }
  // B strikes the nearest townsperson with the bolt (slot 1, 140 m) until the watch wants B
  near := h[1].near_i; strikes := 0;
  while near >= 0 && strikes < 8 && h[1].wanted == 0 {
    k = rs_int(m[..], rs_put(m[..], 0, "C "), seq[1] + 1);
    seq[1] += 1;
    k = rs_put(m[..], k, " 1 "); k = rs_int(m[..], k, cast(int) (h[1].near_x * 100));
    k = rs_put(m[..], k, " 0 "); k = rs_int(m[..], k, cast(int) (h[1].near_z * 100)); k = rs_put(m[..], k, " ");
    k = rs_int(m[..], k, near);
    sent = relay_conn_send(c[1..<2], cast(string) m[0..<k]) && sent;
    sent = sc_steps(c[..], h[..], seq[..], 600, false) && sent;
    strikes += 1;
  }
  // B calls the meteors down where the townsperson stood: both hear the same pieces break; then the rebuild
  k = rs_int(m[..], rs_put(m[..], 0, "C "), seq[1] + 1);
  seq[1] += 1;
  k = rs_put(m[..], k, " 0 "); k = rs_int(m[..], k, cast(int) (h[1].near_x * 100));
  k = rs_put(m[..], k, " 0 "); k = rs_int(m[..], k, cast(int) (h[1].near_z * 100)); k = rs_put(m[..], k, " -1");
  sent = relay_conn_send(c[1..<2], cast(string) m[0..<k]) && sent;
  sent = sc_steps(c[..], h[..], seq[..], 4000, false) && sent;
  // C joins now: within a second its snapshot has the broken town, B's WANTED, A not, and the people
  uc: [1024] u8;
  url_c := rs_ticketed(uc[..], url, pc, "Sim C");
  late_open := url_c.count > 0 && relay_conn_open(c[2..<3], url_c);
  if late_open { sent = relay_conn_send(c[2..<3], "H 6 ranger.1.0.0 druid 64 Sim C") && sent; }
  b_breaks_at_join := h[1].breaks;
  late_t0 := rs_now();
  late_ms := -1;
  while rs_now() - late_t0 < 1000 {
    sent = sc_steps(c[..], h[..], seq[..], 100, false) && sent;
    if late_ms < 0 && h[2].snap && h[2].breaks > 0 && h[2].wanted_of[1] >= 1 && h[2].folk_n >= 5 { late_ms = rs_now() - late_t0; }
  }
  // C has the WANTED levels B has: B's own, and A's (A's wolves may bite a townsperson too, which is A's crime)
  late_a_wanted := h[2].wanted_of[0];
  late_ok := late_open && late_ms >= 0 && h[2].wanted_of[0] == h[1].wanted_of[0] && h[2].wanted_of[1] == h[1].wanted;
  late_breaks := h[2].breaks;
  // R while the town still breaks is refused; once nothing broke for 10 s it stands the town up (spec 6.6)
  k = rs_int(m[..], rs_put(m[..], 0, "R "), seq[1] + 1);
  seq[1] += 1;
  sent = relay_conn_send(c[1..<2], cast(string) m[0..<k]) && sent;
  early := false;
  quiet0 := rs_now();
  // 10 s without a blow (what the fire burns through doesn't count): R puts the fire out and stands the town up
  while rs_now() - quiet0 < 10500 {
    sent = sc_steps(c[..], h[..], seq[..], 500, false) && sent;
    early = early || h[0].rebuilt || h[1].rebuilt;
  }
  waited := rs_now() - quiet0;
  k = rs_int(m[..], rs_put(m[..], 0, "R "), seq[1] + 1);
  seq[1] += 1;
  sent = relay_conn_send(c[1..<2], cast(string) m[0..<k]) && sent;
  sent = sc_steps(c[..], h[..], seq[..], 500, false) && sent;
  killed := h[1].gone_n;   // the meteors may take a wolf too; none more goes once A has
  bad_before := h[0].bad + h[1].bad + h[2].bad;
  // WANTED went to B and A heard it (the watch may strike B down in the hold that follows)
  wanted_ok := h[0].wanted_heard && h[1].wanted_heard && h[1].wanted >= 1 && h[0].wanted_of[1] >= 1;
  closed := relay_conn_close(c[0..<1], 1000);
  c[0].h = -1;
  left0 := rs_now();
  sent = sc_steps(c[..], h[..], seq[..], 800, false) && sent;
  // the seat is held: B still has A, and A's pack (its Concentration with A's held character)
  a_held := !h[1].other_gone;
  // (the watch's responders may kill a wolf meanwhile: the leave just doesn't take the pack, so one
  // still stands; when the fight took all four before A left there is no pack to keep)
  pack_stays := killed >= 4 || h[1].gone_n < 4;
  // and freed once the hold runs out (B keeps stepping, so the room keeps it); 3 s of slack for the network
  gone_ms := -1;
  while rs_now() - left0 < LIFECYCLE_HOLD_MS + 3000 && gone_ms < 0 {
    sent = sc_steps(c[..], h[..], seq[..], 100, false) && sent;
    if h[1].other_gone { gone_ms = rs_now() - left0; }
  }
  a_freed := gone_ms >= LIFECYCLE_HOLD_MS - 500;
  ms := rs_now() - t0;
  rate := f32(h[1].d) / (f32(ms) / 1000.0);
  // each condition by name, so a failure says which (deploy.sh's check loop prints the line)
  conds := [22] bool.[sent, h[0].w && h[1].w, h[0].snap && h[1].snap, h[0].ack > 30, abs(walked) > 3, abs(seen_walk - walked) < 1.5, h[1].other_named,
                 h[0].cast_seen && h[1].cast_seen, h[0].wolf_n == 4 && h[1].wolf_n == 4, h[0].hits > 0 && h[1].hits > 0,
                 sc_gone(h[0], wolf) && sc_gone(h[1], wolf), pack_stays, a_held, a_freed, rate > 12,
                 h[0].folk_n >= 5 && h[1].folk_n >= 5, wanted_ok,
                 h[0].breaks_up > 0 && h[0].breaks_up == h[1].breaks_up && h[0].sum_up == h[1].sum_up, h[0].rebuilt && h[1].rebuilt && !early,
                 h[1].refused_breaking, late_ok, h[0].bad + h[1].bad + h[2].bad == 0];
  names := [22] string.["sent", "w", "snap", "ack", "walked", "seen_walk", "named", "cast_seen", "wolves", "hits", "wolf_killed", "pack_stays",
                   "a_held", "a_freed", "rate", "folk", "wanted", "breaks_up", "rebuilt", "refused_breaking", "late", "bad"];
  ok := true;
  for q: 0..<conds.count { if !conds[q] { ok = false; } }
  out: [4096] u8; o: [1] Jo;
  jo_start(o[..], out[..]);
  jo_obj(o[..]);
  jo_key(o[..], "failed"); jo_arr(o[..]); for q: 0..<conds.count { if !conds[q] { jo_str(o[..], names[q]); } } jo_end(o[..]);
  jo_key(o[..], "a_walked_cm"); jo_int(o[..], cast(int) (walked * 100));
  jo_key(o[..], "b_saw_walk_cm"); jo_int(o[..], cast(int) (seen_walk * 100));
  jo_key(o[..], "a_ack"); jo_int(o[..], h[0].ack);
  jo_key(o[..], "b_d_frames"); jo_int(o[..], h[1].d);
  jo_key(o[..], "b_d_hz10"); jo_int(o[..], cast(int) (rate * 10));
  jo_key(o[..], "named"); jo_bool(o[..], h[1].other_named);
  jo_key(o[..], "wolves_a"); jo_int(o[..], h[0].wolf_n);
  jo_key(o[..], "wolves_b"); jo_int(o[..], h[1].wolf_n);
  jo_key(o[..], "b_casts"); jo_int(o[..], tries);
  jo_key(o[..], "hits_seen_a"); jo_int(o[..], h[0].hits);
  jo_key(o[..], "hits_seen_b"); jo_int(o[..], h[1].hits);
  jo_key(o[..], "late_ms"); jo_int(o[..], late_ms);
  jo_key(o[..], "late_breaks"); jo_int(o[..], late_breaks);
  jo_key(o[..], "b_breaks_at_join"); jo_int(o[..], b_breaks_at_join);
  jo_key(o[..], "late_b_wanted"); jo_int(o[..], h[2].wanted_of[1]);
  jo_key(o[..], "late_folk"); jo_int(o[..], h[2].folk_n);
  jo_key(o[..], "early_rebuild"); jo_bool(o[..], early);
  jo_key(o[..], "refused_breaking"); jo_bool(o[..], h[1].refused_breaking);
  jo_key(o[..], "refused_n"); jo_int(o[..], h[1].refused_n);
  jo_key(o[..], "quiet_wait_ms"); jo_int(o[..], waited);
  jo_key(o[..], "wolf_killed"); jo_bool(o[..], sc_gone(h[0], wolf) && sc_gone(h[1], wolf));
  jo_key(o[..], "a_held"); jo_bool(o[..], a_held);
  jo_key(o[..], "a_gone"); jo_bool(o[..], h[1].other_gone);
  jo_key(o[..], "a_gone_ms"); jo_int(o[..], gone_ms);
  jo_key(o[..], "pack_stays"); jo_bool(o[..], pack_stays);
  jo_key(o[..], "wolves_killed_before_leave"); jo_int(o[..], killed);
  jo_key(o[..], "late_ok"); jo_bool(o[..], late_ok);
  jo_key(o[..], "late_a_wanted"); jo_int(o[..], late_a_wanted);
  jo_key(o[..], "sums_up_match"); jo_bool(o[..], h[0].sum_up == h[1].sum_up);
  jo_key(o[..], "bad"); jo_int(o[..], h[0].bad + h[1].bad + h[2].bad);
  jo_key(o[..], "bad_abc"); jo_arr(o[..]); for i: 0..<SC_SEATS { jo_int(o[..], h[i].bad); } jo_end(o[..]);
  jo_key(o[..], "bad_before_leave"); jo_int(o[..], bad_before);
  jo_key(o[..], "wolves_gone_b"); jo_int(o[..], h[1].gone_n);
  jo_key(o[..], "folk_seen_a"); jo_int(o[..], h[0].folk_n);
  jo_key(o[..], "folk_seen_b"); jo_int(o[..], h[1].folk_n);
  jo_key(o[..], "b_struck"); jo_int(o[..], near);
  jo_key(o[..], "b_strikes"); jo_int(o[..], strikes);
  jo_key(o[..], "b_wanted"); jo_int(o[..], h[1].wanted);
  jo_key(o[..], "a_wanted"); jo_int(o[..], h[0].wanted);
  jo_key(o[..], "a_heard_b_wanted"); jo_int(o[..], h[0].wanted_of[1]);
  jo_key(o[..], "breaks_a"); jo_int(o[..], h[0].breaks);
  jo_key(o[..], "breaks_b"); jo_int(o[..], h[1].breaks);
  jo_key(o[..], "breaks_a_to_rebuild"); jo_int(o[..], h[0].breaks_up);
  jo_key(o[..], "breaks_b_to_rebuild"); jo_int(o[..], h[1].breaks_up);
  jo_key(o[..], "burns_a"); jo_int(o[..], h[0].burns);
  jo_key(o[..], "rebuilt"); jo_bool(o[..], h[0].rebuilt && h[1].rebuilt);
  jo_end(o[..]);
  print("%\n", jo_text(o[..]));
  print("%\n", ifx ok then "shares" else "fails");
  _ := closed;
  r := relay_conn_close(c[1..<2], 1000);
  return ifx ok then 0 else 1;
}
