// Integration fixtures exercise actual signed tickets and the room exports.
CK_TEST_KEY :: "profile-check-key-not-a-secret-0123456789";
ck_test_init :: (v:[]RmServer){rm_init(v);rm_clock(v,1000,1762190000000);rm_ticket_key(v,CK_TEST_KEY,true);rm_vitals_gen(v,101);}
ck_test_join :: (v:[]RmServer,conn:int,owner:int,capture:CharacterCapture)->int {return ck_test_join_as(v,conn,"p-a",owner,capture);}
ck_test_join_as :: (v:[]RmServer,conn:int,pid:string,owner:int,given:CharacterCapture)->int {
  // the capture saved in this room, an Everglade II room's (#13267): the shared fixture's is pair-a
  capture:=given;if capture.ok&&cast(string)capture.room[0..<capture.room_n]=="pair-a"{room:="pair-e2-a";for c,i:room{capture.room[i]=c;}capture.room_n=room.count;}
  core:[256]u8;out:[RT_TEXT]u8;saved:[CC_BODY]u8;request:[4608]u8;
  n:=tk_sign_owner(CK_TEST_KEY,pid,false,"Ash","pair-e2-a",1,v[0].wall_ms+60000,7,350,2,owner,core[..]);
  cap:=ifx capture.ok then cc_stored(capture,saved[..]) else "-";ticket:=resume_ticket_wrap(CK_TEST_KEY,cast(string)core[0..<n],cap,out[..]);
  size:=tk_add(request[..],0,"GET /api/room/relay/everglade/pair-e2-a?t=");size=tk_add(request[..],size,ticket);size=tk_add(request[..],size," HTTP/1.1\r\n\r\n");
  if rm_join(v,conn,cast(string)request[0..<size])<0{return -1;}k:=eg_room_at(v,v[0].conns[conn].relay);
  rm_heard(v,conn,"H 5 ranger.0.0.0 druid 0 Ash");return k;
}
ck_test_place :: (v:[]RmServer,k:int){rm_eg_moved(v,k, SeatId.{value = 0},0,1,0,2,0,0,0,0,0,0,0);}
ck_test_receipt :: (v:[]RmServer,status:string,out:[]u8)->string {
  c:=v[0].ck.fly_capture;o:[1]Jo;jo_start(o[..],out);jo_obj(o[..]);jo_key(o[..],"v");jo_int(o[..],2);jo_key(o[..],"status");jo_str(o[..],status);
  jo_key(o[..],"owner");jo_int(o[..],c.n[1]);jo_key(o[..],"process");jo_int(o[..],c.n[2]);jo_key(o[..],"rev");jo_int(o[..],c.n[3]);jo_key(o[..],"accepted_at");jo_int(o[..],1762190000001);jo_end(o[..]);return jo_text(o[..]);
}
