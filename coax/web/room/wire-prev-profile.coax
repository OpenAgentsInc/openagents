// Hold the previous wire's profile (proto/verse/everglade-wire-prev-vN.json, #13398) to its one codec,
// everglade/server/wire-prev-wire.coax, and to the session's versions:
//   - "serves" is the codec's WPREV_SERVES and the session's WIRE_MIN, "under" its WPREV_UNDER and
//     WIRE_VERSION, and WIRE_MIN is one below WIRE_VERSION: a wire raised without the version before
//     it rewritten here fails;
//   - each "said_as" entry of this wire is written as its old frame, each "said_the_same" entry is left
//     as it is, and "withheld" names the row kinds a seat on the old wire is not sent;
//   - each "heard_as" frame of the old page is read as the E (use) it is on this wire, which this
//     wire's own reader takes, and every "malformed" frame is refused;
//   - "frames" names the old frames' own profiles, which coax/web/room/familiar-profile.coax holds to
//     the same codec.
//   coax/web/tool.sh coax/web/room/wire-prev-profile.coax proto/verse/everglade-wire-prev-v6.json
#import "Basic";
#load "../../../everglade/server/wire-prev-wire.coax";
#load "../../lib/json/json.coax";
#load "../../lib/sys/tool.coax";
#load "../../lib/sys/fs.coax";

WQ_FILE :: 32768;
WQ_NONE :: -999999999;
// The old wire's own frame profiles, which coax/web/room/familiar-profile.coax holds to this codec's functions.
WQ_FRAMES :: [9] string.["everglade-familiar-v1", "everglade-find-familiar-v1", "everglade-familiar-lifecycle-v1", "everglade-familiar-step-v1",
  "everglade-familiar-cure-v1", "everglade-familiar-senses-v1", "everglade-familiar-state-v1", "everglade-healers-kit-v1", "everglade2-familiar-v2"];

wq_str :: (d: Jv, at: int, out: [] u8) -> string { n := jv_str(d, at, out); return ifx n >= 0 then cast(string) out[0..<n] else ""; }
// A profile's versions against the codec's and the session's: 0 holds, else which rule fails.
wq_versions :: (serves: int, under: int) -> int {
  if WIRE_MIN != WIRE_VERSION - 1 { return 1; }
  if under != WIRE_VERSION || under != WPREV_UNDER { return 2; }
  if serves != WIRE_MIN || serves != WPREV_SERVES { return 3; }
  return 0;
}
#test "the previous wire's profile is for the version just below the session's, and no other" {
  #assert wq_versions(WIRE_VERSION - 1, WIRE_VERSION) == 0;
  // a wire raised by one with this profile and codec left as they are: refused
  #assert wq_versions(WIRE_VERSION - 1, WIRE_VERSION + 1) == 2 && wq_versions(WIRE_VERSION, WIRE_VERSION + 1) == 2;
  #assert wq_versions(WIRE_VERSION - 2, WIRE_VERSION) == 3 && wq_versions(WIRE_VERSION, WIRE_VERSION) == 3 && wq_versions(WIRE_VERSION - 1, WIRE_VERSION - 1) == 2;
}
wq_check :: (d: Jv, path: string) -> bool {
  tb: [3][512] u8;
  serves := jv_int(d, jv_get(d, 0, "serves"), WQ_NONE); under := jv_int(d, jv_get(d, 0, "under"), WQ_NONE);
  why := wq_versions(serves, under);
  if why != 0 {
    print("versions (rule %): the profile serves wire % under wire %; the codec serves % under %; the session speaks % to %. Rewrite everglade/server/wire-prev.coax, its codec and this profile for the version the wire leaves behind\n",
          why, serves, under, WPREV_SERVES, WPREV_UNDER, WIRE_MIN, WIRE_VERSION);
    return false;
  }
  // identity: everglade-wire-prev-vSERVES, in the file of that name, checked by this program
  ib: [64] u8; n := wire_put(ib[..], 0, "everglade-wire-prev-v"); dg: [24] u8; dn := wire_int(dg[..], 0, serves);
  for q: 0..<dn { if dg[q] != ' ' { ib[n] = dg[q]; n += 1; } }
  identity := wq_str(d, jv_get(d, 0, "identity"), tb[0][..]);
  if identity != cast(string) ib[0..<n] { print("identity: not everglade-wire-prev-v%\n", serves); return false; }
  fb: [128] u8; fnn := wire_put(fb[..], wire_put(fb[..], wire_put(fb[..], 0, "proto/verse/"), identity), ".json"); file := cast(string) fb[0..<fnn];
  if path.count < file.count || path[path.count - file.count..<path.count] != file { print("identity: not the file's name\n"); return false; }
  cb: [200] u8; cn := wire_put(cb[..], wire_put(cb[..], 0, "coax/web/tool.sh coax/web/room/wire-prev-profile.coax "), file);
  if wq_str(d, jv_get(d, 0, "check"), tb[1][..]) != cast(string) cb[0..<cn] { print("check: not this program\n"); return false; }
  if wq_str(d, jv_get(d, 0, "codec"), tb[1][..]) != "everglade/server/wire-prev-wire.coax" { print("codec\n"); return false; }
  if wq_str(d, jv_get(d, 0, "base_session"), tb[1][..]) != "everglade-session-v7" { print("base_session\n"); return false; }
  // what a seat on the old wire is not sent: every familiar's row and every mount's, and no entry (each is said as its old frame)
  wh := jv_get(d, 0, "withheld"); kinds := jv_get(d, wh, "row_kinds"); ents := jv_get(d, wh, "entries");
  if jv_len(d, kinds) != 2 || jv_int(d, jv_at(d, kinds, 0), -1) != WK_FAMILIAR || jv_int(d, jv_at(d, kinds, 1), -1) != WK_MOUNT { print("withheld.row_kinds\n"); return false; }
  if jv_kind(d, ents) != JV_ARRAY || jv_len(d, ents) != 0 { print("withheld.entries\n"); return false; }
  // each entry of this wire, as the old frame it is said as: every order of e fam, e fam-cast and e kit
  said := jv_get(d, 0, "said_as"); heads: [7] bool; names := [7] string.["m1", "m3", "m4", "m5", "m6", "m7", "u1"];
  if jv_kind(d, said) != JV_ARRAY || jv_len(d, said) < 7 { print("said_as\n"); return false; }
  for i: 0..<jv_len(d, said) {
    out: [200] u8; e := wq_str(d, jv_get(d, jv_at(d, said, i), "entry"), tb[1][..]); f := wq_str(d, jv_get(d, jv_at(d, said, i), "frame"), tb[2][..]);
    m := wprev_entry_put(out[..], e);
    if m == 0 || cast(string) out[0..<m] != f || !egf_kept(e) { print("said_as %: %\n", i, e); return false; }
    for q: 0..<7 { if wire_is(f, names[q]) { heads[q] = true; } }
  }
  for q: 0..<7 { if !heads[q] { print("said_as: none said as %\n", names[q]); return false; } }
  same := jv_get(d, 0, "said_the_same");
  if jv_kind(d, same) != JV_ARRAY || jv_len(d, same) < 3 { print("said_the_same\n"); return false; }
  for i: 0..<jv_len(d, same) { out: [200] u8; e := wq_str(d, jv_at(d, same, i), tb[1][..]); if wprev_entry_put(out[..], e) != 0 { print("said_the_same %: %\n", i, e); return false; } }
  // each frame the old page says, as the E (use) it is on this wire: all six familiar requests and the kit's
  heard := jv_get(d, 0, "heard_as"); kinds_seen: [7] bool;
  if jv_kind(d, heard) != JV_ARRAY || jv_len(d, heard) < 7 { print("heard_as\n"); return false; }
  for i: 0..<jv_len(d, heard) {
    out: [200] u8; f := wq_str(d, jv_get(d, jv_at(d, heard, i), "frame"), tb[1][..]); u := wq_str(d, jv_get(d, jv_at(d, heard, i), "use"), tb[2][..]);
    w := wprev_use_read(f);
    m := wire_put_use(out[..], 0, w);
    if w.kind < WE_FAM_SUMMON || w.kind > WE_KIT || cast(string) out[0..<m] != u { print("heard_as %: %\n", i, f); return false; }
    kinds_seen[w.kind - WE_FAM_SUMMON] = true;
    // and this wire's own reader takes that use as a request
    if w.kind == WE_KIT { if egf_kit_read(w) != w.seq { print("heard_as %: not the kit's ask\n", i); return false; } }
    else if !egf_use_read(w, WPREV_FEY).ok { print("heard_as %: not a familiar's request\n", i); return false; }
  }
  for q: 0..<7 { if !kinds_seen[q] { print("heard_as: no frame for E kind %\n", WE_FAM_SUMMON + q); return false; } }
  bad := jv_get(d, 0, "malformed");
  if jv_kind(d, bad) != JV_ARRAY || jv_len(d, bad) < 6 { print("malformed\n"); return false; }
  for i: 0..<jv_len(d, bad) { t := wq_str(d, jv_at(d, bad, i), tb[1][..]); if wprev_use_read(t).kind != 0 { print("malformed % taken: %\n", i, t); return false; } }
  // the old frames' own profiles, by name: each is held to this codec by familiar-profile.coax
  frames := jv_get(d, 0, "frames");
  if jv_kind(d, frames) != JV_ARRAY || jv_len(d, frames) != WQ_FRAMES.count { print("frames\n"); return false; }
  for i: 0..<WQ_FRAMES.count { if wq_str(d, jv_at(d, frames, i), tb[1][..]) != WQ_FRAMES[i] { print("frames %\n", i); return false; } }
  return true;
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) != 1 { tool_errln("usage: wire-prev-profile PROFILE.json"); return 2; }
  path := args_at(a[..], 0);
  text: [WQ_FILE] u8; n := fs_read(path, text[..]);
  nodes: [4096] JvNode; d: [1] Jv;
  if n <= 0 || !jv_parse(d[..], cast(string) text[0..<n], nodes[..]) { tool_errln("wire-prev-profile: cannot parse JSON"); return 2; }
  if !wq_check(d[0], path) { print("%: profile fails\n", path); return 1; }
  print("%: profile holds\n", path);
  return 0;
}
