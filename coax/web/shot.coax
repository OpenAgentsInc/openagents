// Screenshot a Coaxial page with WebGPU in headless Chrome: no window opens and
// nothing takes focus. Agents never open a visible browser for checks.
//   coax/web/tool.sh shot URL OUT.png [WIDTHxHEIGHT] [WAIT_MS] [--eval JS]   (prints what JS returns)
// It waits WAIT_MS of real time (the pages animate in), then captures. A
// value the script returns is printed: a string as it is, anything else as
// compact JSON. Then OUT is printed. The capture is coax/lib/media/media.coax,
// which `openagents labs shot` uses too.
#import "Basic";
#load "../lib/media/media.coax";

tool_main :: () -> int #export_c {
  a: [1] Args;
  ok := args_load(a[..]);
  url := args_at(a[..], 0); out := args_at(a[..], 1);
  // The size and wait are positional; a flag in their place leaves the default.
  size := args_at(a[..], 2); wait := args_at(a[..], 3);
  if size.count == 0 || (size.count > 1 && size[0] == '-' && size[1] == '-') { size = "1440x900"; }
  if wait.count == 0 || (wait.count > 1 && wait[0] == '-' && wait[1] == '-') { wait = "4000"; }
  e := args_find(a[..], "--eval");
  script := ifx e > 0 then args_at(a[..], e + 1) else "";
  if !ok || url.count == 0 || out.count == 0 {
    tool_errln("usage: coax/web/tool.sh shot URL OUT.png [WxH] [WAIT_MS] [--eval JS]");
    return 2;
  }
  wh := args_size(size); ms := args_number(wait);
  if !wh.ok || !ms.ok || ms.value < 0.0 { tool_errln("shot: WxH is two whole numbers and WAIT_MS a number of milliseconds"); return 2; }
  c: [1] Cdp;
  if !cdp_launch(c[..], wh.w, wh.h, "coax-shot-") { tool_err("shot: "); tool_errln(cdp_error(c[..])); return 1; }
  o: MediaShotOptions; o.wait = cast(int) ms.value; o.script = script;
  value: [1048576] u8; build: [256] u8;
  s := media_shot(c[..], url, out, wh, o, value[..], build[..]);
  if s.status == 1 { tool_err("shot: "); tool_errln(cdp_error(c[..])); }
  cdp_close(c[..]);
  if s.status == 2 { tool_errln("shot: the URL is too long"); return 2; }
  if s.status == 3 { tool_err("shot: could not write "); tool_errln(out); return 1; }
  if s.status != 0 { return 1; }
  if s.value_n >= 0 { print("%\n", cast(string) value[0..<s.value_n]); }
  print("%\n", out);
  return 0;
}
