// The site's moved addresses (docs/naming/2026-11-12-metaverse-rename.md, #13405), as the dev
// server answers them (serve.c). The load balancer holds the same rules for the deployed site
// (coax/web/api/lb.sh, "The Metaverse's addresses"); smoke.sh checks those on staging and
// production. Change both together.
//
//   /verse, /verse/*                    moved for good to /metaverse, /metaverse/* (query kept)
//   /projects/verse, /projects/verse/*  moved for good to /projects/metaverse, ... (query kept)
//   /projects/metaverse, .../*          the project whose slug is still "verse": its files are
//                                       projects/verse/ (the slug is the project's name on the
//                                       relay and in the bucket; only the address changed)
//   /verse/galaxy, /metaverse/galaxy    the retired galaxy: moved for good to /worlds, query dropped
//   /forge, /forge/*                    the realm editor's old address: moved for good to /worlds/new,
//                                       the rest of the path dropped (query kept)
//   /worlds/splice, /worlds/splice/*    Splice Bots' old address: moved for good to /worlds/splice-bots,
//                                       ... (query kept, so ?edit opens the editor), and every other
//                                       renamed world's the same way (world-alias.coax,
//                                       docs/naming/2026-11-13-splice-bots-rename.md, #13486)
//
// A route says what to do with a path (the address without its query):
//   status 0    serve the file at `to` followed by the path after its first `skip` bytes
//   status 301  answer 301 with Location `to` followed by the path after its first `skip`
//               bytes, and the request's query when `query` is set
SiteRoute :: struct { status:int; to:string; skip:int; query:bool; }

// Whether path is root itself or something under it ("/verse" and "/verse/x", never "/verse-os").
site_under :: (path:string,root:string)->bool #effects(all) {
  if path.count<root.count {return false;}
  for i:0..<root.count {if path[i]!=root[i] {return false;}}
  return path.count==root.count || path[root.count]=='/';
}

// Whether `seg` is a canonical cloud chat conversation ID: lowercase 36-char UUID
// (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx) or legacy "cnv_" + 32 lowercase hex chars.
site_chat_conv_id :: (seg:string)->bool #effects(all) {
  if seg.count!=36 {return false;}
  if seg[8]=='-' && seg[13]=='-' && seg[18]=='-' && seg[23]=='-' {
    for i:0..<36 {
      if i==8 || i==13 || i==18 || i==23 {continue;}
      c:=seg[i];
      if !((c>='0' && c<='9') || (c>='a' && c<='f')) {return false;}
    }
    return true;
  }
  if seg[0]!='c' || seg[1]!='n' || seg[2]!='v' || seg[3]!='_' {return false;}
  for i:4..<36 {
    c:=seg[i];
    if !((c>='0' && c<='9') || (c>='a' && c<='f')) {return false;}
  }
  return true;
}

// Whether `seg` is a referral code or GitHub vanity handle (1..39 of A-Z, a-z, 0-9, -, _).
site_ref_token :: (seg:string)->bool #effects(all) {
  if seg.count<1 || seg.count>39 {return false;}
  for c:seg {
    if !((c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') || c=='-' || c=='_') {return false;}
  }
  return true;
}

site_route :: (path:string)->SiteRoute #export_c #effects(all) {
  if site_under(path,"/verse/galaxy") || site_under(path,"/metaverse/galaxy") {return SiteRoute.{status=301,to="/worlds",skip=path.count,query=false};}
  if site_under(path,"/forge") {return SiteRoute.{status=301,to="/worlds/new",skip=path.count,query=true};}
  w:=site_moved_world(path);
  if w>=0 {return SiteRoute.{status=301,to=WORLD_IS_PATH[w],skip=WORLD_WAS_PATH[w].count,query=true};}
  if site_under(path,"/verse") {return SiteRoute.{status=301,to="/metaverse",skip=6,query=true};}
  if site_under(path,"/projects/verse") {return SiteRoute.{status=301,to="/projects/metaverse",skip=15,query=true};}
  if site_under(path,"/projects/metaverse") {return SiteRoute.{status=0,to="/projects/verse",skip=19,query=false};}
  // Static SSR books generated into build/books/ by apps/openagents-web/books-build.coax (deploy.sh stages them at site/books/).
  if site_under(path,"/books") {return SiteRoute.{status=0,to="/build/books",skip=6,query=false};}
  // Referral landing routes (/r/<code> or /r/<vanity_handle>): serve /r/index.html.
  if path.count>=4 && cast(string)path[0..<3]=="/r/" {
    end:=path.count;
    if path[end-1]=='/' {end-=1;}
    if site_ref_token(cast(string)path[3..<end]) {return SiteRoute.{status=0,to="/r/index.html",skip=path.count,query=false};}
  }
  // Unified cloud chat SPA routes (/chat/cnv_<32hex>, #14094): serve /chat/index.html so reloads hydrate cleanly.
  if path.count>=42 && cast(string)path[0..<6]=="/chat/" {
    end:=path.count;
    if path[end-1]=='/' {end-=1;}
    if site_chat_conv_id(cast(string)path[6..<end]) {return SiteRoute.{status=0,to="/chat/index.html",skip=path.count,query=false};}
  }
  return SiteRoute.{status=0,to="",skip=0,query=false};
}

// A renamed world's address, old and new: the worlds of metaverse-engine/editor/world-alias.coax
// (WORLD_WAS, WORLD_IS), whose API IDs the dev server reads there (world-alias-host.coax). Change both.
SITE_MOVED_WORLDS :: 1;
WORLD_WAS_PATH :: [SITE_MOVED_WORLDS] string.["/worlds/splice"];
WORLD_IS_PATH :: [SITE_MOVED_WORLDS] string.["/worlds/splice-bots"];
// Which renamed world's old address path is (-1 for none).
site_moved_world :: (path:string)->int #effects(all) {
  for k:0..<SITE_MOVED_WORLDS {if site_under(path,WORLD_WAS_PATH[k]) {return k;}}
  return -1;
}

// Where a route sends a path, as text, for the checks below.
site_goes :: (path:string,out:[]u8)->string #effects(all) {
  r:=site_route(path);n:=0;
  for ch:r.to {out[n]=ch;n+=1;}
  for i:r.skip..<path.count {out[n]=path[i];n+=1;}
  return cast(string)out[0..<n];
}

#test "the old landing moves for good to /metaverse, the rest of its path kept" {
  b:[256]u8;
  r:=site_route("/verse");#assert r.status==301 && r.query && site_goes("/verse",b[..])=="/metaverse";
  r=site_route("/verse/");#assert r.status==301 && r.query && site_goes("/verse/",b[..])=="/metaverse/";
  r=site_route("/verse/index.md");#assert r.status==301 && r.query && site_goes("/verse/index.md",b[..])=="/metaverse/index.md";
  r=site_route("/verse/og-verse.jpg");#assert r.status==301 && site_goes("/verse/og-verse.jpg",b[..])=="/metaverse/og-verse.jpg";
}
#test "the old project address moves for good to /projects/metaverse" {
  b:[256]u8;
  r:=site_route("/projects/verse");#assert r.status==301 && r.query && site_goes("/projects/verse",b[..])=="/projects/metaverse";
  r=site_route("/projects/verse/index.md");#assert r.status==301 && r.query && site_goes("/projects/verse/index.md",b[..])=="/projects/metaverse/index.md";
  r=site_route("/projects/verse/work/engine.json");#assert r.status==301 && site_goes("/projects/verse/work/engine.json",b[..])=="/projects/metaverse/work/engine.json";
}
#test "/projects/metaverse is the project whose slug is verse" {
  b:[256]u8;
  r:=site_route("/projects/metaverse");#assert r.status==0 && !r.query && site_goes("/projects/metaverse",b[..])=="/projects/verse";
  r=site_route("/projects/metaverse/index.md");#assert r.status==0 && !r.query && site_goes("/projects/metaverse/index.md",b[..])=="/projects/verse/index.md";
}
#test "the retired galaxy moves to /worlds under both names, its query dropped" {
  b:[256]u8;
  paths:=[6]string.["/verse/galaxy","/verse/galaxy/","/verse/galaxy/index.md","/metaverse/galaxy","/metaverse/galaxy/","/metaverse/galaxy/index.md"];
  for p:paths {r:=site_route(p);#assert r.status==301 && !r.query && site_goes(p,b[..])=="/worlds";}
}
#test "the realm editor's old address moves for good to /worlds/new, its query kept" {
  b:[256]u8;
  paths:=[4]string.["/forge","/forge/","/forge/my-realm","/forge/my-realm/index.md"];
  for p:paths {r:=site_route(p);#assert r.status==301 && r.query && site_goes(p,b[..])=="/worlds/new";}
  #assert site_route("/forged").status==0 && site_route("/worlds/new").status==0;
}
#test "Splice Bots' old address moves for good to /worlds/splice-bots, the rest of its path and its query kept" {
  b:[256]u8;
  r:=site_route("/worlds/splice");#assert r.status==301 && r.query && site_goes("/worlds/splice",b[..])=="/worlds/splice-bots";
  r=site_route("/worlds/splice/");#assert r.status==301 && r.query && site_goes("/worlds/splice/",b[..])=="/worlds/splice-bots/";
  r=site_route("/worlds/splice/index.md");#assert r.status==301 && site_goes("/worlds/splice/index.md",b[..])=="/worlds/splice-bots/index.md";
  #assert site_route("/worlds/splice-bots").status==0 && site_route("/worlds/splice-bots/index.md").status==0 && site_route("/worlds/splicer").status==0;
}
#test "every other path is served as it is" {
  b:[256]u8;
  same:=[12]string.["/","/metaverse","/metaverse/","/metaverse/index.md","/metaverse/og-verse.jpg","/verse-os/","/verses","/projects","/projects/verses","/projects/metaverse-x","/worlds/haunted-house","/forged"];
  for p:same {r:=site_route(p);#assert r.status==0 && !r.query && r.skip==0 && r.to.count==0 && site_goes(p,b[..])==p;}
}
#test "a moved address never leads to another moved address" {
  b:[256]u8;c:[256]u8;
  old:=[12]string.["/verse","/verse/","/verse/index.md","/verse/galaxy","/metaverse/galaxy","/projects/verse","/projects/verse/","/projects/verse/index.md","/forge","/forge/my-realm","/worlds/splice","/worlds/splice/index.md"];
  for p:old {to:=site_goes(p,b[..]);#assert site_route(p).status==301 && site_route(to).status==0;}
}
#test "/chat/<uuid> and /chat/cnv_<32hex> serve /chat/index.html without affecting /chat/index.md or malformed paths" {
  b:[256]u8;
  ru:=site_route("/chat/019370a4-7b1c-7e82-9a3f-4c2e1b8d6f05");
  #assert ru.status==0 && !ru.query && site_goes("/chat/019370a4-7b1c-7e82-9a3f-4c2e1b8d6f05",b[..])=="/chat/index.html";
  ru2:=site_route("/chat/019370a4-7b1c-7e82-9a3f-4c2e1b8d6f05/");
  #assert ru2.status==0 && !ru2.query && site_goes("/chat/019370a4-7b1c-7e82-9a3f-4c2e1b8d6f05/",b[..])=="/chat/index.html";
  #assert site_route("/chat/019370A4-7b1c-7e82-9a3f-4c2e1b8d6f05").to.count==0;
  #assert site_route("/chat/019370a4x7b1c-7e82-9a3f-4c2e1b8d6f05").to.count==0;
  r:=site_route("/chat/cnv_0123456789abcdef0123456789abcdef");
  #assert r.status==0 && !r.query && site_goes("/chat/cnv_0123456789abcdef0123456789abcdef",b[..])=="/chat/index.html";
  r2:=site_route("/chat/cnv_0123456789abcdef0123456789abcdef/");
  #assert r2.status==0 && !r2.query && site_goes("/chat/cnv_0123456789abcdef0123456789abcdef/",b[..])=="/chat/index.html";
  #assert site_route("/chat").to.count==0 && site_route("/chat/index.md").to.count==0 && site_route("/chat/cnv_short").to.count==0 && site_route("/chat/cnv_0123456789ABCDEF0123456789abcdef").to.count==0;
}
#test "/books and /books/* map to /build/books without affecting sibling prefixes" {
  b:[256]u8;
  r:=site_route("/books");
  #assert r.status==0 && !r.query && site_goes("/books",b[..])=="/build/books";
  r2:=site_route("/books/");
  #assert r2.status==0 && !r2.query && site_goes("/books/",b[..])=="/build/books/";
  r3:=site_route("/books/mono.css");
  #assert r3.status==0 && !r3.query && site_goes("/books/mono.css",b[..])=="/build/books/mono.css";
  r3s:=site_route("/books/search.json");
  #assert r3s.status==0 && !r3s.query && site_goes("/books/search.json",b[..])=="/build/books/search.json";
  r3j:=site_route("/books/search.js");
  #assert r3j.status==0 && !r3j.query && site_goes("/books/search.js",b[..])=="/build/books/search.js";
  r4:=site_route("/books/coax/ch01-getting-started/index.md");
  #assert r4.status==0 && !r4.query && site_goes("/books/coax/ch01-getting-started/index.md",b[..])=="/build/books/coax/ch01-getting-started/index.md";
  #assert site_route("/book").to.count==0 && site_route("/bookshop").to.count==0 && site_route("/books-old").to.count==0;
}
#test "/r/<code> serves /r/index.html without affecting /r/index.html, dots, or /referrals" {
  b:[256]u8;
  r:=site_route("/r/7K3M9Q2P");
  #assert r.status==0 && !r.query && site_goes("/r/7K3M9Q2P",b[..])=="/r/index.html";
  r2:=site_route("/r/octocat-dev/");
  #assert r2.status==0 && !r2.query && site_goes("/r/octocat-dev/",b[..])=="/r/index.html";
  // Boundary lengths (1, 39 valid; 0, 40 invalid) and trailing-slash single-char token
  #assert site_route("/r/a").to=="/r/index.html" && site_route("/r/a/").to=="/r/index.html";
  #assert site_route("/r/!a").to.count==0 && site_route("/r//").to.count==0;
  #assert !site_ref_token("") && site_ref_token("azAZ09-_");
  #assert site_ref_token("a23456789012345678901234567890123456789");
  #assert !site_ref_token("a234567890123456789012345678901234567890");
  // Character class boundary rejections (one below/above each range)
  #assert !site_ref_token("`") && !site_ref_token("{") && !site_ref_token("@") && !site_ref_token("[") && !site_ref_token("/") && !site_ref_token(":");
  #assert site_route("/r").to.count==0 && site_route("/r/").to.count==0 && site_route("/r/index.html").to.count==0 && site_route("/r/a/b").to.count==0 && site_route("/referrals").to.count==0;
}
