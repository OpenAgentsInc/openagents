// Every Coax test suite of the web app, the Verse, the web tools (coax/web)
// and the Coax libraries (coax/lib), each run at the budget
// its own header declares.
//   coax/web/tool.sh suites                    # every suite
//   coax/web/tool.sh suites --since REF        # only suites whose sources changed since REF (the #load graph; coax deps when the compiler or a .pb changed)
//   coax/web/tool.sh suites --since REF --deps # the same, asking coax deps for every suite
//   coax/web/tool.sh suites --since REF --affected [--faces]  # every .coax file whose #load closure holds a changed file (exit 3: can't tell; --faces: the caller places changed .c and .h files itself)
//   coax/web/tool.sh suites --list             # the suites and their budgets; nothing runs
//   coax/web/tool.sh suites --only PATH,PATH   # these suites (paths from the repo root)
//   coax/web/tool.sh suites --jobs N           # suites side by side (default 6)
//   coax/web/tool.sh suites --part I/N         # the I-th of N parts: suites I, I+N, I+2N... (after --since and --only)
//   coax test coax/web/suites.coax --library   # its own checks
//
// The convention. A suite is a .coax file under apps/openagents-web/,
// metaverse/, metaverse-engine/, everglade/, rules/, coax/web/ or coax/lib/ with a #test or #forall in it (or a --native-link line) that no other file #loads, or one
// whose header (its first 80 lines) names itself in a `coax test` line. That
// line is how it runs: `coax test apps/openagents-web/everglade.coax --steps
// 2000000000` gives each of its tests 2,000,000,000 steps, and --library,
// --run-steps (the compile's own budget: tables built at compile time),
// --root-only and --only WORD (just the checks whose names hold WORD, no spaces: a
// file that loads a whole suite only to add its own checks) pass on too. A quoted
// --only "some words" doesn't pass on: it tells a person how to run a part by hand,
// and the suite runs every check, as it did before --only passed on. A file with no checks of its own whose header names
// itself is a suite too: it runs the checks of what it loads (a file pinned by
// a verification record can't take a header line, so one beside it does). A suite with no such line runs at the compiler's
// default, 20,000,000 steps a test; one that needs more says so in its own
// header, and nothing raises the budget for every suite. A file that a file
// with checks loads runs its tests inside that one. A suite with no `main ::`
// of its own runs with --library, since `coax test` asks a program for its
// main (E0336). A file of checks that uses its loader's names can't run
// alone: its loader names itself in a `coax test` line, or, when the loader
// can't take one (a compiler input), a file beside it loads it and does
// (coax/lib/checker-checks.coax).
//
// `--native-link UNIT` on that line makes it a native suite: checks that call
// a #foreign from a separately compiled unit (a recorded verification
// boundary) can't run at compile time, so the file exports
// native_check(i, run) and this builds it and UNIT with coax lib, links them
// with coax/web/native-check.c and runs every check in its own process. They
// count as checks like any other.
//
// release.sh runs it with --since production's release once the release is
// live, as a report (releases/<time>/SUITES); it never holds a release back.
// Exit 0 when every suite passed, 1 when one failed, 2 on bad usage.
#import "Basic";
#load "../lib/sys/args.coax";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/proc.coax";

SU_FILES :: 16384;           // tracked .coax files read (6,776 on 2026-11-09)
SU_LOADS :: 65536;           // #load lines kept, as repo paths (about 10,600 on 2026-11-09)
SU_ARENA :: 4194304;         // their bytes and the suites' paths
SU_SUITES :: 4096;
SU_TEXT :: 8388608;          // the largest .coax file read
SU_HEAD_LINES :: 80;
SU_TIMEOUT_MS :: 3600000;    // one suite's longest run, 60 minutes: a hang guard, not a budget (Everglade takes ~41 on a loaded Mac)
SU_JOBS :: 6;

SuHead :: struct { found: bool; steps: string; run_steps: string; library: bool; root_only: bool; native: string; only: string; }
Suite :: struct { path: string; steps: string; run_steps: string; library: bool; root_only: bool; native: string; missing: string; only: string; }   // native: the unit it links, beside it   // missing: a #load not in the tree
// Kept text: bytes is a view of the caller's buffer.
SuArena :: struct { bytes: [] u8; used: int; full: bool; }

su_keep :: (a: [] SuArena, s: string) -> string {
  if a[0].used + s.count > a[0].bytes.count { a[0].full = true; return ""; }
  at := a[0].used;
  for i: 0..<s.count { a[0].bytes[at + i] = s[i]; }
  a[0].used += s.count;
  return cast(string) a[0].bytes[at..<at + s.count];
}

su_ident :: (c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }
su_space :: (c: u8) -> bool { return c == ' ' || c == '\t' || c == '\r'; }
su_starts :: (s: string, at: int, word: string) -> bool {
  if at + word.count > s.count { return false; }
  for i: 0..<word.count { if s[at + i] != word[i] { return false; } }
  return true;
}
su_base :: (path: string) -> string {
  from := 0;
  for i: 0..<path.count { if path[i] == '/' { from = i + 1; } }
  return path[from..<path.count];
}
su_dir :: (path: string) -> string {
  to := 0;
  for i: 0..<path.count { if path[i] == '/' { to = i; } }
  return path[0..<to];
}

// The repo path of rel (a #load's string) from dir (a repo path): "." and
// ".." resolved, "" when it climbs out of the repo.
su_norm :: (dir: string, rel: string, out: [] u8) -> string {
  starts: [256] int; n := 0; used := 0;
  for pass: 0..<2 {
    s := ifx pass == 0 then dir else rel;
    i := 0;
    while i <= s.count {
      j := i;
      while j < s.count && s[j] != '/' { j += 1; }
      part := s[i..<j];
      if part.count == 0 || part == "." {
      } else if part == ".." {
        if n == 0 { return ""; }
        n -= 1; used = starts[n];   // back to before it (and its slash)
      } else {
        if n >= 256 || used + part.count + 1 > out.count { return ""; }
        starts[n] = used;
        if n > 0 { out[used] = '/'; used += 1; }
        for k: 0..<part.count { out[used + k] = part[k]; }
        used += part.count; n += 1;
      }
      i = j + 1;
    }
  }
  return cast(string) out[0..<used];
}

// A #test or #forall at the start of a line (spaces before it allowed).
su_has_tests :: (text: string) -> bool {
  i := 0;
  while i < text.count {
    j := i;
    while j < text.count && su_space(text[j]) { j += 1; }
    for word: [2] string.["#test", "#forall"] {
      if su_starts(text, j, word) && (j + word.count >= text.count || !su_ident(text[j + word.count])) { return true; }
    }
    while i < text.count && text[i] != '\n' { i += 1; }
    i += 1;
  }
  return false;
}

// A `main ::` declaration at a line's start: the file is a program.
su_has_main :: (text: string) -> bool {
  i := 0;
  while i < text.count {
    j := i;
    while j < text.count && su_space(text[j]) { j += 1; }
    if su_starts(text, j, "main") {
      k := j + 4;
      while k < text.count && su_space(text[k]) { k += 1; }
      if su_starts(text, k, "::") { return true; }
    }
    while i < text.count && text[i] != '\n' { i += 1; }
    i += 1;
  }
  return false;
}

#test "a file with main :: at a line's start is a program; a name that only begins with main is not" {
  #assert su_has_main("x :: 1;\nmain :: () { }\n") && su_has_main("  main  :: () {}");
  #assert !su_has_main("main_loop :: () {}\n// main\n") && !su_has_main("x := main;\n") && !su_has_main("");
}

// The `coax test` line in the first SU_HEAD_LINES lines that names a file
// called base, and the budget and flags on it.
su_head :: (text: string, base: string) -> SuHead {
  h: SuHead;
  i := 0; line := 0;
  while i < text.count && line < SU_HEAD_LINES {
    e := i;
    while e < text.count && text[e] != '\n' { e += 1; }
    l := text[i..<e];
    for k: 0..<l.count {
      if !su_starts(l, k, "coax test") { continue; }
      // the words after it: the first .coax one is the file it runs
      named := false; steps := ""; run_steps := ""; library := false; root_only := false; native := ""; only := "";
      w := k + 9;
      while w < l.count {
        while w < l.count && su_space(l[w]) { w += 1; }
        x := w;
        while x < l.count && !su_space(l[x]) { x += 1; }
        word := l[w..<x];
        if word.count > 5 && su_starts(word, word.count - 5, ".coax") && !named {
          if su_base(word) != base { break; }
          named = true;
        } else if word == "--library" { library = true; }
        else if word == "--root-only" { root_only = true; }
        else if word == "--native-link" || word == "--only" {
          y := x;
          while y < l.count && su_space(l[y]) { y += 1; }
          z := y;
          while z < l.count && !su_space(l[z]) { z += 1; }
          if word == "--only" && z > y && l[y] == '"' {
            // a quoted phrase is how a person runs a part by hand; the suite runs whole
            z = y + 1;
            while z < l.count && l[z] != '"' { z += 1; }
            if z < l.count { z += 1; }
          } else if word == "--only" { only = l[y..<z]; } else { native = l[y..<z]; }
          x = z;
        }
        else if word == "--steps" || word == "--run-steps" {
          y := x;
          while y < l.count && su_space(l[y]) { y += 1; }
          z := y;
          while z < l.count && l[z] >= '0' && l[z] <= '9' { z += 1; }
          if z > y { if word == "--steps" { steps = l[y..<z]; } else { run_steps = l[y..<z]; } }
        }
        w = x;
      }
      if named { h.found = true; h.steps = steps; h.run_steps = run_steps; h.library = library; h.root_only = root_only; h.native = native; h.only = only; return h; }
    }
    i = e + 1; line += 1;
  }
  return h;
}

// Each #load's repo path, from the file at path, kept in a.
su_loads :: (text: string, path: string, a: [] SuArena, loads: [] string, from: int) -> int {
  n := from;
  dir := su_dir(path);
  buf: [1024] u8;
  i := 0;
  while i < text.count {
    j := i;
    while j < text.count && su_space(text[j]) { j += 1; }
    if su_starts(text, j, "#load") {
      q := j + 5;
      while q < text.count && text[q] != '"' && text[q] != '\n' { q += 1; }
      if q < text.count && text[q] == '"' {
        r := q + 1;
        while r < text.count && text[r] != '"' && text[r] != '\n' { r += 1; }
        p := su_norm(dir, text[q + 1..<r], buf[..]);
        if p.count > 0 && n < loads.count { loads[n] = su_keep(a, p); n += 1; }
      }
    }
    while i < text.count && text[i] != '\n' { i += 1; }
    i += 1;
  }
  return n;
}

// Under apps/openagents-web/, metaverse/, metaverse-engine/ (the engine core), everglade/ (the game), rules/ (the SRD rules: its
// check files ran as suites under metaverse-engine/rules/srd/ and stopped when the folder moved, #13270), coax/web/ or coax/lib/,
// and not in a hidden folder (.dev scratch).
su_in :: (path: string) -> bool {
  roots := [7] string.["apps/openagents-web/", "metaverse/", "metaverse-engine/", "everglade/", "rules/", "coax/web/", "coax/lib/"];
  for r: roots { if su_starts(path, 0, r) { return !su_contains(path, "/."); } }
  return false;
}
// Whether a changed file that isn't Coax can change a suite's result. A
// suite's checks run at compile time, and the compiler reads only #load
// (Coax), #import_proto (a .pb descriptor) and itself. So: a descriptor, the
// compiler's sources and what builds it, and the C a native suite links. A C
// face, a host script, a budget table or a Swift source can't.
su_input :: (path: string) -> bool {
  if path.count > 3 && su_starts(path, path.count - 3, ".pb") { return true; }
  roots := [5] string.["coax/src/", "coax/bootstrap/", "coax/build.sh", "coax/provenance.sh", "coax/web/native-check.c"];
  for r: roots { if su_starts(path, 0, r) { return true; } }
  return false;
}
// Whether a changed file that isn't Coax can be an input of a web module
// (--affected): anything in the trees the web build reads. With faces
// (--faces) a .c or .h file isn't asked here: the caller matches the faces
// against the build's own commands.
su_web_input :: (path: string, faces: bool) -> bool {
  if su_input(path) { return true; }
  if faces && path.count > 2 && (su_starts(path, path.count - 2, ".c") || su_starts(path, path.count - 2, ".h")) { return false; }
  roots := [11] string.["coax/platform/", "coax/lib/", "coax/web/", "apps/openagents-web/", "metaverse/", "metaverse-engine/", "everglade/", "rules/", "psionic/", "proto/", "protocol/"];
  for r: roots { if su_starts(path, 0, r) { return true; } }
  return false;
}

#test "a changed file that isn't Coax changes a suite only through the compiler, a descriptor or a native suite's C" {
  #assert su_input("coax/src/check.cpp") && su_input("coax/bootstrap/checker.c") && su_input("coax/build.sh") && su_input("coax/web/native-check.c");
  #assert su_input("metaverse/voice.pb") && su_input("os/wire/desk.pb");
  #assert !su_input("metaverse-engine/host/frame.c") && !su_input("apps/openagents-web/wasm-budgets.txt") && !su_input("coax/web/tool.sh");
  #assert !su_input("apps/everglade-desktop/Sources/Workshop.swift") && !su_input("coax/remote/after.sh") && !su_input("pb") && !su_input(".gitignore");
}
#test "a web module's inputs are wider: the trees the build reads, its faces left to the caller on request" {
  #assert su_web_input("apps/openagents-web/wasm-budgets.txt", false) && su_web_input("coax/web/host.js", true) && su_web_input("coax/src/emit_c.cpp", true);
  #assert su_web_input("metaverse-engine/host/frame.c", false) && !su_web_input("metaverse-engine/host/frame.c", true) && !su_web_input("apps/openagents-web/sound-bank.h", true);
  #assert !su_web_input("apps/everglade-desktop/Sources/Workshop.swift", false) && !su_web_input("scripts/join-pylon.sh", true) && !su_web_input("coax/remote/check.sh", false);
}
#test "paths: a #load from a file's folder, dots resolved, never out of the repo" {
  b: [256] u8;
  #assert su_norm("apps/openagents-web", "../../metaverse/space.coax", b[..]) == "metaverse/space.coax";
  #assert su_norm("metaverse/everglade", "../terrain.coax", b[..]) == "metaverse/terrain.coax";
  #assert su_norm("metaverse", "./edit/edit.coax", b[..]) == "metaverse/edit/edit.coax";
  #assert su_norm("apps/openagents-web", "font.coax", b[..]) == "apps/openagents-web/font.coax";
  #assert su_norm("metaverse", "../../x.coax", b[..]) == "";
  #assert su_base("everglade/legacy/v1/plan.coax") == "plan.coax" && su_dir("everglade/legacy/v1/plan.coax") == "everglade/legacy/v1";
}
#test "a suite has a #test or #forall at a line's start; a word that only begins so does not count" {
  #assert su_has_tests("x :: 1;\n#test \"a\" { }\n") && su_has_tests("  #forall a: 0..<3 { }");
  #assert !su_has_tests("// #testing\n#tests_off :: 1;\n") && !su_has_tests("x := \"#test\";\n");
}
#test "the header's own coax test line carries the budget and flags; another file's does not" {
  t := "// Everglade.\n//   coax/bin/coax test apps/openagents-web/everglade.coax --steps 2000000000\n#load \"x.coax\";\n";
  h := su_head(t, "everglade.coax");
  #assert h.found && h.steps == "2000000000" && !h.library;
  #assert !su_head(t, "fairy.coax").found;
  l := su_head("//   coax/bin/coax test --library metaverse/water.coax --steps 500000000\n", "water.coax");
  #assert l.found && l.library && l.steps == "500000000";
  d := su_head("// coax test metaverse/space.coax\n", "space.coax");
  #assert d.found && d.steps == "" && d.native == "";
  n := su_head("//   coax test apps/openagents-web/project-frames.coax --native-link project-capacity.coax\n", "project-frames.coax");
  #assert n.found && n.native == "project-capacity.coax" && n.steps == "";
  k := su_head("// coax test keys.coax --library --run-steps 250000000\n", "keys.coax");
  #assert k.found && k.library && k.run_steps == "250000000" && k.steps == "";
  // --only: just the checks whose names hold it (a file that loads a whole suite to add its own)
  o := su_head("// coax test --library fuzz.coax --steps 9 --only room-fuzz: --native-link\n", "fuzz.coax");
  #assert o.found && o.only == "room-fuzz:" && o.native == "" && o.steps == "9" && k.only == "";
  // a quoted phrase is not passed on, and the words in it are not read as options
  q := su_head("// coax test five.coax --only \"5E --library MMO\" --steps 7\n", "five.coax");
  #assert q.found && q.only == "" && !q.library && q.steps == "7";
}
#test "loads: each #load's repo path, comments and strings that only mention it left out" {
  keep: [4096] u8; a: [1] SuArena; a[0].bytes = keep[..]; loads: [8] string;
  n := su_loads("#load \"font.coax\";\n  #load \"../../metaverse/camera.coax\";\n// see #loading\n", "apps/openagents-web/x.coax", a[..], loads[..], 0);
  #assert n == 2 && loads[0] == "apps/openagents-web/font.coax" && loads[1] == "metaverse/camera.coax";
}

su_say :: (s: string) { print("%", s); }

// Runs argv in dir to its end: stdout into out.
su_run :: (argv: [] string, dir: string, out: [] u8) -> ProcRun {
  r: ProcRun;
  h := proc_new();
  if h < 0 { r.started = PROC_ERROR; return r; }
  ok := proc_cwd(h, dir);
  for a: argv { ok = ok && proc_arg(h, a); }
  if !ok { d := proc_release(h); r.started = PROC_ERROR; return r; }
  r.started = proc_start(h);
  if r.started != 0 { d := proc_release(h); return r; }
  line: [65536] u8;
  while true {
    n := proc_line(h, 600000, line[..]);
    if n == PROC_EOF || n == PROC_ERROR { break; }
    if n == PROC_TIMEOUT { r.timed_out = true; break; }
    if n == PROC_TOO_LONG { r.cut = true; continue; }
    if r.out_n + n + 1 > out.count { r.cut = true; continue; }
    for i: 0..<n { out[r.out_n + i] = line[i]; }
    out[r.out_n + n] = '\n'; r.out_n += n + 1;
  }
  if r.timed_out { k := proc_kill(h, PROC_SIGKILL); }
  r.status = proc_wait(h, 5000);
  d := proc_release(h);
  return r;
}

// A native suite's program: the suite and its unit through coax lib, linked
// with coax/web/native-check.c in a fresh temporary directory. Its path, kept
// in into; empty when a step failed, with what that step said in out[0..<said].
Native :: struct { exe: string; said: int; }
su_rm :: (dir: string) {
  rm := [3] string.["rm", "-rf", dir];
  junk: [4096] u8;
  r := su_run(rm[..], ".", junk[..]);
}
su_native_build :: (coax: string, root: string, dir: string, s: Suite, out: [] u8, into: [] u8) -> Native {
  no: Native;
  mk := [2] string.["mktemp", "-d"];
  t := su_run(mk[..], dir, out);
  if t.started != 0 || t.status != 0 || t.out_n < 2 { return no; }
  tb: [4096] u8;
  if t.out_n > tb.count { return no; }
  for i: 0..<t.out_n - 1 { tb[i] = out[i]; }
  tmp := cast(string) tb[0..<t.out_n - 1];
  pa: [4096] u8; pb: [4096] u8; pc: [4096] u8;
  suite_o := fs_join(tmp, "suite.o", pa[..]);
  unit_o := fs_join(tmp, "unit.o", pb[..]);
  shim := fs_join(root, "coax/web/native-check.c", pc[..]);
  exe := fs_join(tmp, "checks", into);
  a1 := [5] string.[coax, "lib", su_base(s.path), "-o", suite_o];
  a2 := [5] string.[coax, "lib", s.native, "-o", unit_o];
  a3 := [8] string.["cc", "-O1", shim, suite_o, unit_o, "-lm", "-o", exe];
  r1 := su_run(a1[..], dir, out);
  if r1.started != 0 || r1.status != 0 { no.said = r1.out_n; su_rm(tmp); return no; }
  r2 := su_run(a2[..], dir, out);
  if r2.started != 0 || r2.status != 0 { no.said = r2.out_n; su_rm(tmp); return no; }
  r3 := su_run(a3[..], dir, out);
  if r3.started != 0 || r3.status != 0 { no.said = r3.out_n; su_rm(tmp); return no; }
  return Native.{exe = exe};
}

su_contains :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return false; }
  for i: 0..<hay.count - needle.count + 1 { if su_starts(hay, i, needle) { return true; } }
  return false;
}

Lane :: struct { h: int; suite: int; started_ms: int; last: [512] u8; last_n: int; fails: [6] [256] u8; fail_n: [6] int; fails_kept: int; tmp: [4096] u8; tmp_n: int; }   // tmp: a native suite's build, removed when it ends

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("suites: too many arguments"); return 2; }
  since := args_value(a[..], "--since", ""); only := args_value(a[..], "--only", "");
  list_only := args_has(a[..], "--list");
  jobs := SU_JOBS;
  if args_has(a[..], "--jobs") { j := args_number(args_value(a[..], "--jobs", "")); if !j.ok || j.value < 1 { tool_errln("suites: --jobs N"); return 2; } jobs = cast(int) j.value; }
  if jobs > 16 { jobs = 16; }
  // --part I/N: the green-main pipeline's full run splits the suites across host slots.
  part := args_value(a[..], "--part", ""); part_i := 0; part_n := 1;
  if part.count > 0 {
    cut := -1;
    for k: 0..<part.count { if part[k] == '/' { cut = k; } }
    if cut < 0 { tool_errln("suites: --part I/N"); return 2; }
    pi := args_number(part[0..<cut]); pn := args_number(part[cut + 1..<part.count]);
    if !pi.ok || !pn.ok || pn.value < 1 || pi.value < 1 || pi.value > pn.value { tool_errln("suites: --part I/N, 1 <= I <= N"); return 2; }
    part_i = cast(int) pi.value - 1; part_n = cast(int) pn.value;
  }

  big: [SU_TEXT] u8;
  av1 := [3] string.["git", "rev-parse", "--show-toplevel"];
  top := su_run(av1[..], ".", big[..]);
  if top.started != 0 || top.status != 0 || top.out_n < 2 { tool_errln("suites: not in a git checkout"); return 2; }
  kept: [SU_ARENA] u8; arena: [1] SuArena; arena[0].bytes = kept[..];
  root := su_keep(arena[..], cast(string) big[0..<top.out_n - 1]);
  bin_buf: [4096] u8;
  coax := fs_join(root, "coax/bin/coax", bin_buf[..]);
  if !fs_exists(coax) { tool_err("suites: no compiler at "); tool_err(coax); tool_errln(" (coax/build.sh)"); return 2; }
  // A compiler built from an older tree fails suites that use newer language
  // (a stale coax/bin/coax once failed every suite loading cdp.coax), so the
  // run refuses unless the provenance record matches this tree's inputs.
  if !list_only && !args_has(a[..], "--affected") {
    av0 := [6] string.["coax/provenance.sh", "verify", root, "coax/bin/coax", "coax/bin/provenance-check", "coax/bin/provenance.record"];
    pv := su_run(av0[..], root, big[..]);
    if pv.started != 0 || pv.status != 0 { tool_err("suites: "); tool_err(coax); tool_errln(" was not built from this tree; run coax/build.sh"); return 2; }
  }

  av2 := [3] string.["git", "ls-files", "*.coax"];
  listed := su_run(av2[..], root, big[..]);
  if listed.started != 0 || listed.status != 0 || listed.cut { tool_errln("suites: git ls-files failed"); return 2; }
  files: [SU_FILES] string; nf := 0;
  i := 0;
  while i < listed.out_n {
    e := i;
    while e < listed.out_n && big[e] != '\n' { e += 1; }
    p := cast(string) big[i..<e];
    if p.count > 0 && !su_starts(p, 0, "projects/") && nf < SU_FILES { files[nf] = su_keep(arena[..], p); nf += 1; }
    i = e + 1;
  }
  loads: [SU_LOADS] string; nl := 0;
  load_by: [SU_LOADS] int;     // the file each #load is in
  tested: [SU_FILES] bool;     // that file has checks of its own
  cand: [SU_SUITES] Suite; heads: [SU_SUITES] bool; cand_file: [SU_SUITES] int; nc := 0;
  pb: [4096] u8;
  for f: 0..<nf {
    path := files[f];
    n := fs_read(fs_join(root, path, pb[..]), big[..]);
    if n < 0 { continue; }
    text := cast(string) big[0..<n];
    from := nl;
    nl = su_loads(text, path, arena[..], loads[..], nl);
    for k: from..<nl { load_by[k] = f; }
    tested[f] = su_in(path) && (su_has_tests(text) || su_head(text, su_base(path)).found);   // and so runs here
    h := ifx su_in(path) then su_head(text, su_base(path)) else SuHead.{};
    if su_in(path) && (su_has_tests(text) || h.found) && nc < SU_SUITES {
      // a #load that isn't in the tree: generated by the build (projects/baked.coax) or staged (a template)
      missing := "";
      for k: from..<nl { if missing.count == 0 && !fs_exists(fs_join(root, loads[k], pb[..])) { missing = loads[k]; } }
      // without a main of its own it is checked as a library: `coax test` asks a program for its main (E0336)
      cand[nc] = Suite.{path = path, steps = su_keep(arena[..], h.steps), run_steps = su_keep(arena[..], h.run_steps), library = h.library || !su_has_main(text), root_only = h.root_only, native = su_keep(arena[..], h.native), missing = missing, only = su_keep(arena[..], h.only)};
      heads[nc] = h.found; cand_file[nc] = f; nc += 1;
    }
  }
  if arena[0].full || nl >= SU_LOADS || nf >= SU_FILES || nc >= SU_SUITES { tool_errln("suites: more files than it keeps; raise SU_*"); return 2; }

  // A file runs inside a suite here that loads it, directly or through files
  // without checks: covered, from the loads, until nothing changes.
  load_to: [SU_LOADS] int;
  for l: 0..<nl { load_to[l] = -1; for f: 0..<nf { if files[f] == loads[l] { load_to[l] = f; break; } } }
  // A suite is skipped, not failed, when what it loads loads something not in
  // the tree: project-checks.coax loads project.coax, which loads the build's
  // projects/baked.coax. lacks: the first such #load, through any depth.
  lacks: [SU_FILES] string;
  for l: 0..<nl { by := load_by[l]; if lacks[by].count == 0 && load_to[l] < 0 && !fs_exists(fs_join(root, loads[l], pb[..])) { lacks[by] = loads[l]; } }
  spread := true;
  while spread {
    spread = false;
    for l: 0..<nl { to := load_to[l]; by := load_by[l]; if to >= 0 && lacks[by].count == 0 && lacks[to].count > 0 { lacks[by] = lacks[to]; spread = true; } }
  }
  for c: 0..<nc { if cand[c].missing.count == 0 { cand[c].missing = lacks[cand_file[c]]; } }
  covered: [SU_FILES] bool;
  grew := true;
  while grew {
    grew = false;
    for l: 0..<nl {
      to := load_to[l]; by := load_by[l];
      if to >= 0 && to != by && !covered[to] && (tested[by] || covered[by]) { covered[to] = true; grew = true; }
    }
  }
  suites: [SU_SUITES] Suite; ns := 0;
  for c: 0..<nc {
    loaded := false;
    for f: 0..<nf { if files[f] == cand[c].path { loaded = covered[f]; break; } }
    if loaded && !heads[c] { continue; }
    if only.count > 0 {
      hit := false; s := 0;
      for k: 0..<only.count + 1 {
        if k == only.count || only[k] == ',' { if only[s..<k] == cand[c].path { hit = true; } s = k + 1; }
      }
      if !hit { continue; }
    }
    suites[ns] = cand[c]; ns += 1;
  }

  if since.count > 0 {
    changed: [1048576] u8;
    av3 := [5] string.["git", "diff", "--name-only", since, "HEAD"];
    d := su_run(av3[..], root, changed[..]);
    if d.started != 0 || d.status != 0 { tool_err("suites: git diff "); tool_err(since); tool_errln(" failed"); return 2; }
    keep := 0;
    db: [4096] u8;
    // The #load graph answers first when every changed file is a tracked
    // .coax file, a document, or a file that can't change a suite's result
    // (su_input): a suite is touched when its #load closure holds a changed
    // file. A changed compiler source or descriptor can reach any suite, so
    // then every suite asks coax deps. Native suites always do: their linked
    // unit isn't #loaded. --affected asks the wider su_web_input.
    hit: [SU_FILES] bool;      // a changed .coax file
    want_affected := args_has(a[..], "--affected"); faces := args_has(a[..], "--faces");
    by_graph := !args_has(a[..], "--deps"); any_changed := false;
    c0 := 0;
    while c0 < d.out_n {
      e := c0;
      while e < d.out_n && changed[e] != '\n' { e += 1; }
      if e > c0 {
        path := cast(string) changed[c0..<e];
        doc := su_starts(path, 0, "docs/") || (path.count > 3 && su_starts(path, path.count - 3, ".md"));
        if !doc {
          found := -1;
          for f: 0..<nf { if files[f] == path { found = f; break; } }
          if found >= 0 { hit[found] = true; any_changed = true; }
          else if (want_affected && su_web_input(path, faces)) || (!want_affected && su_input(path)) { by_graph = false; }
        }
      }
      c0 = e + 1;
    }
    // --affected: every tracked .coax file whose #load closure holds a
    // changed file, by the graph (check.sh picks the web modules to build
    // from it); exit 3 when the graph can't tell.
    if args_has(a[..], "--affected") {
      if !by_graph { tool_errln("suites: --affected: a changed file isn't a .coax file the #load graph reaches"); return 3; }
      affected: [SU_FILES] bool;
      for f: 0..<nf { affected[f] = hit[f]; }
      grew2 := true;
      while grew2 {
        grew2 = false;
        for l: 0..<nl { to := load_to[l]; if to >= 0 && affected[to] && !affected[load_by[l]] { affected[load_by[l]] = true; grew2 = true; } }
      }
      for f: 0..<nf { if affected[f] { su_say(files[f]); su_say("\n"); } }
      return 0;
    }
    // The graph as edges from each file (counting sort of the loads by file).
    first: [SU_FILES + 1] int; edges: [SU_LOADS] int;
    for l: 0..<nl { first[load_by[l] + 1] += 1; }
    for f: 0..<nf { first[f + 1] += first[f]; }
    fill: [SU_FILES] int;
    for f: 0..<nf { fill[f] = first[f]; }
    for l: 0..<nl { edges[fill[load_by[l]]] = load_to[l]; fill[load_by[l]] += 1; }
    seen: [SU_FILES] int;      // the suite (plus one) whose walk last reached it
    todo: [SU_FILES] int;
    for s: 0..<ns {
      if by_graph && suites[s].native.count == 0 {
        start := -1;
        for f: 0..<nf { if files[f] == suites[s].path { start = f; break; } }
        touched := start < 0;   // can't tell: run it
        if start >= 0 && any_changed {
          sp := 1; todo[0] = start; seen[start] = s + 1;
          while sp > 0 && !touched {
            sp -= 1; f := todo[sp];
            if hit[f] { touched = true; }
            for k: first[f]..<first[f + 1] {
              to := edges[k];
              if to >= 0 && seen[to] != s + 1 { seen[to] = s + 1; todo[sp] = to; sp += 1; }
            }
          }
        }
        if touched { suites[keep] = suites[s]; keep += 1; }
        continue;
      }
      dir := fs_join(root, su_dir(suites[s].path), db[..]);
      av4 := [3] string.[coax, "deps", su_base(suites[s].path)];
      deps := su_run(av4[..], dir, big[..]);
      touched := deps.started != 0 || deps.status != 0;   // can't tell: run it
      n_deps := deps.out_n;
      if suites[s].native.count > 0 && !touched {
        // the unit it links is a source too
        av5 := [3] string.[coax, "deps", suites[s].native];
        unit := su_run(av5[..], dir, big[n_deps..<big.count]);
        if unit.started != 0 || unit.status != 0 { touched = true; }
        n_deps += unit.out_n;
      }
      text := cast(string) big[0..<n_deps];
      c := 0;
      while !touched && c < d.out_n {
        e := c;
        while e < d.out_n && changed[e] != '\n' { e += 1; }
        if e > c {
          want: [4096] u8; w := 0;
          want[w] = '"'; w += 1;
          for b: 0..<root.count { want[w] = root[b]; w += 1; }
          want[w] = '/'; w += 1;
          for b: c..<e { if w < 4094 { want[w] = changed[b]; w += 1; } }
          want[w] = '"'; w += 1;
          if su_contains(text, cast(string) want[0..<w]) { touched = true; }
        }
        c = e + 1;
      }
      if touched { suites[keep] = suites[s]; keep += 1; }
    }
    ns = keep;
  }
  if part_n > 1 {
    keep := 0;
    for s: 0..<ns { if s % part_n == part_i { suites[keep] = suites[s]; keep += 1; } }
    ns = keep;
  }

  if list_only {
    for s: 0..<ns {
      su_say(suites[s].path);
      if suites[s].steps.count > 0 { su_say("  --steps "); su_say(suites[s].steps); } else { su_say("  default"); }
      if suites[s].run_steps.count > 0 { su_say(" --run-steps "); su_say(suites[s].run_steps); }
      if suites[s].library { su_say(" --library"); }
      if suites[s].root_only { su_say(" --root-only"); }
      if suites[s].only.count > 0 { su_say(" --only "); su_say(suites[s].only); }
      if suites[s].native.count > 0 { su_say(" --native-link "); su_say(suites[s].native); }
      if suites[s].missing.count > 0 { su_say("  (skipped here: loads "); su_say(suites[s].missing); su_say(", not in the tree)"); }
      su_say("\n");
    }
    return 0;
  }
  // A suite that loads a file the tree doesn't hold is said and left out: build.sh
  // generates projects/baked.coax before the release runs these; a template runs from its stage.
  runs := 0; skipped := 0;
  for s: 0..<ns {
    if suites[s].missing.count > 0 { su_say("skip "); su_say(suites[s].path); su_say(": loads "); su_say(suites[s].missing); su_say(", which is not in the tree (generated by the build, or a template's stage)\n"); skipped += 1; }
    else { suites[runs] = suites[s]; runs += 1; }
  }
  ns = runs;

  lanes: [16] Lane;
  for l: 0..<16 { lanes[l].h = -1; }
  next := 0; done := 0; failed := 0;
  t0 := proc_now_ms();
  line: [65536] u8; db2: [4096] u8;
  while done < ns {
    for l: 0..<jobs {
      if lanes[l].h < 0 && next < ns {
        s := suites[next];
        dir := fs_join(root, su_dir(s.path), db2[..]);
        h := -1; ok := true; said := 0; run_n := 0;
        run_buf: [4096] u8;
        if s.native.count > 0 {
          // built here, before its lane starts: a few seconds
          nb := su_native_build(coax, root, dir, s, big[..], run_buf[..]);
          ok = nb.exe.count > 0; run_n = nb.exe.count;
          said = ifx nb.said < 2000 then nb.said else 2000;
          h = ifx ok then proc_new() else -1;
          ok = ok && h >= 0 && proc_cwd(h, dir) && proc_arg(h, nb.exe);
        } else {
          h = proc_new();
          ok = h >= 0 && proc_cwd(h, dir) && proc_arg(h, coax) && proc_arg(h, "test") && proc_arg(h, su_base(s.path));
          if s.steps.count > 0 { ok = ok && proc_arg(h, "--steps") && proc_arg(h, s.steps); }
          if s.run_steps.count > 0 { ok = ok && proc_arg(h, "--run-steps") && proc_arg(h, s.run_steps); }
          if s.library { ok = ok && proc_arg(h, "--library"); }
          if s.root_only { ok = ok && proc_arg(h, "--root-only"); }
          if s.only.count > 0 { ok = ok && proc_arg(h, "--only") && proc_arg(h, s.only); }
        }
        lanes[l].tmp_n = 0;
        if ok && s.native.count > 0 { lanes[l].tmp_n = run_n - 7; for k: 0..<run_n - 7 { lanes[l].tmp[k] = run_buf[k]; } }   // less "/checks"
        lanes[l].suite = next; lanes[l].last_n = 0; lanes[l].fails_kept = 0; lanes[l].started_ms = proc_now_ms();
        next += 1;
        if !ok || proc_start(h) != 0 {
          if h >= 0 { r := proc_release(h); }
          su_say("FAIL "); su_say(s.path); su_say(ifx s.native.count > 0 then ": the native build failed\n" else ": the compiler did not start\n");
          if said > 0 { su_say(cast(string) big[0..<said]); }
          failed += 1; done += 1;
          continue;
        }
        lanes[l].h = h;
      }
      if lanes[l].h < 0 { continue; }
      h := lanes[l].h;
      ended := false;
      while true {
        n := proc_line(h, 0, line[..]);
        if n == PROC_TIMEOUT { break; }
        if n == PROC_EOF || n == PROC_ERROR { ended = true; break; }
        if n == PROC_TOO_LONG { continue; }
        t := cast(string) line[0..<n];
        if su_contains(t, " passed, ") && su_contains(t, " failed") {   // "418 checks, 418 passed, 0 failed" or "1 check, ..."
          m := ifx n > 512 then 512 else n;
          for k: 0..<m { lanes[l].last[k] = line[k]; }
          lanes[l].last_n = m;
        }
        if su_starts(t, 0, "FAIL") && lanes[l].fails_kept < 6 {
          f := lanes[l].fails_kept; m := ifx n > 256 then 256 else n;
          for k: 0..<m { lanes[l].fails[f][k] = line[k]; }
          lanes[l].fail_n[f] = m; lanes[l].fails_kept += 1;
        }
      }
      over := proc_now_ms() - lanes[l].started_ms > SU_TIMEOUT_MS;
      if !ended && !over { continue; }
      if over { k := proc_kill(h, PROC_SIGKILL); }
      status := proc_wait(h, 5000);
      err: [2048] u8;
      tail := proc_stderr(h, err[..]);
      r := proc_release(h);
      if lanes[l].tmp_n > 0 {
        su_rm(cast(string) lanes[l].tmp[0..<lanes[l].tmp_n]);
      }
      lanes[l].h = -1; done += 1;
      s := suites[lanes[l].suite];
      last := cast(string) lanes[l].last[0..<lanes[l].last_n];
      passed := !over && status == 0 && su_contains(last, " 0 failed");
      if !passed { failed += 1; }
      su_say(ifx passed then "ok   " else "FAIL "); su_say(s.path);
      if s.steps.count > 0 { su_say(" (--steps "); su_say(s.steps); su_say(")"); }
      su_say(": ");
      if over { su_say("still running after 60 minutes"); } else if last.count > 0 { su_say(last); } else { su_say("no summary"); }
      print(" (% s)\n", (proc_now_ms() - lanes[l].started_ms) / 1000);
      if !passed {
        for f: 0..<lanes[l].fails_kept { su_say("       "); su_say(cast(string) lanes[l].fails[f][0..<lanes[l].fail_n[f]]); su_say("\n"); }
        if lanes[l].last_n == 0 && tail.count > 0 { su_say("       "); su_say(tail); su_say("\n"); }
      }
    }
    proc_sleep(50);
  }
  print("suites: % of % passed in % s (% skipped)\n", ns - failed, ns, (proc_now_ms() - t0) / 1000, skipped);
  return ifx failed > 0 then 1 else 0;
}
