// Every Coax test suite of the web app, the Metaverse, the web tools (coax/web)
// and the Coax libraries (coax/lib), each run at the budget
// its own header declares.
//   coax/web/tool.sh suites                    # every suite
//   coax/web/tool.sh suites --since REF        # only suites whose sources changed since REF (the #load graph; coax deps when the compiler or a .pb changed)
//   coax/web/tool.sh suites --since REF --deps # the same, asking coax deps for every suite
//   coax/web/tool.sh suites --since REF --until REV  # the suites whose sources changed from REF to REV, not to HEAD (#13610)
//   coax/web/tool.sh suites --since REF --affected [--faces]  # every .coax file whose #load closure holds a changed file (exit 3: can't tell; --faces: the caller places changed .c and .h files itself)
//   coax/web/tool.sh suites --since REF --check-affected  # coax check of every root (a file nothing #loads) above a changed .coax file, nearest first: the pre-push compile check (exit 1: one fails)
//   coax/web/tool.sh suites --list             # the suites and their budgets (and "#authority" when one loads such a file); nothing runs
//   coax/web/tool.sh suites --list --authority-units  # and after "#authority", the #authority files whose mutants the nightly
//                                              # sweep runs under that suite: each file under the suite with the smallest
//                                              # #load closure that reaches it (the cheapest baseline), comma-separated;
//                                              # then the #authority files no suite reaches (su_sweep_scope), each under
//                                              # the smallest file with checks that reaches it, often itself (#13586)
//   coax/web/tool.sh suites --only PATH,PATH   # these suites (paths from the repo root)
//   coax/web/tool.sh suites --jobs N           # suites side by side (default 6)
//   coax/web/tool.sh suites --part I/N         # the I-th of N parts: suites I, I+N, I+2N... (after --since and --only)
//   coax/web/tool.sh suites --mutate-changed REF  # also, for each suite that loads an #authority file, `coax mutate
//                                              # SUITE --changed REF`: the mutants of the procedures changed since REF
//                                              # (#13583); a survivor fails it as a failed check does
//   coax/web/tool.sh suites --mutate-changed REF --mutate-only  # those mutants alone, no `coax test`: the
//                                              # after-landing mutation job's (coax/remote/check.sh mutate-since); --part
//                                              # then splits the #authority suites, not every suite. A survivor in a check
//                                              # unit (a file the suite reaches only through `#load "x-checks.coax" #test;`,
//                                              # whose procedures only checks reach, su_check_units) is counted, one line a
//                                              # file ("check-only: PATH: N mutant(s) ..."), not listed (#13610)
//   coax/web/tool.sh suites --mutate-changed REF --mutate-unit PATH  # only PATH's mutants (coax mutate --unit; not with
//                                              # a --root-only suite): the mutation report's recheck of one file (#13610)
//   coax test coax/web/suites.coax --library   # its own checks
//
// The convention. A suite is a .coax file under apps/openagents-web/, apps/openagents-desktop/,
// metaverse/, metaverse-engine/, everglade/, rules/, coax/web/ or coax/lib/ with a #test or #forall in it (or a --native-link line) that no other file #loads, or one
// whose header (its first 80 lines) names itself in a `coax test` line. That
// line is how it runs: `coax test apps/openagents-web/everglade.coax --steps
// 2000000000` gives each of its tests 2,000,000,000 steps, and --library,
// --run-steps (the compile's own budget: tables built at compile time),
// --root-only and --only WORD (just the checks whose names hold WORD, no spaces: a
// file that loads a whole suite only to add its own checks) pass on too, and so does
// --traversal N (the compile-time traversal budget; `coax mutate` runs every check in the
// evaluator, which a suite's native checks don't, so a large one may need it there). A quoted
// --only "some words" doesn't pass on: it tells a person how to run a part by hand,
// and the suite runs every check, as it did before --only passed on. A file with no checks of its own whose header names
// itself is a suite too: it runs the checks of what it loads (a file pinned by
// a verification record can't take a header line, so one beside it does). A suite with no such line runs at the compiler's
// default, 20,000,000 steps a test; one that needs more says so in its own
// header, and nothing raises the budget for every suite. A file that a file
// with checks loads runs its tests inside that one. A suite with no `main ::`
// of its own runs with --library, since `coax test` asks a program for its
// main (E0336). A file of checks that uses its loader's names can't run
// alone: its loader names itself in a `coax test` line, or, when the loader
// can't take one (a compiler input), a file beside it loads it and does
// (coax/lib/checker-checks.coax).
//
// `--native-link UNIT` on that line makes it a native suite: checks that call
// a #foreign from a separately compiled unit (a recorded verification
// boundary) can't run at compile time, so the file exports
// native_check(i, run) and this builds it and UNIT with coax lib, links them
// with coax/web/native-check.c and runs every check in its own process. They
// count as checks like any other.
//
// release.sh runs it with --since production's release once the release is
// live, as a report (releases/<time>/SUITES); it never holds a release back.
// Exit 0 when every suite passed, 1 when one failed, 2 on bad usage.
#import "Basic";
#load "../lib/sys/args.coax";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/proc.coax";
#load "suites-host.coax";

SU_FILES :: 16384;           // tracked .coax files read (6,776 on 2026-11-09)
SU_LOADS :: 65536;           // #load lines kept, as repo paths (about 10,600 on 2026-11-09)
SU_ARENA :: 4194304;         // their bytes and the suites' paths
SU_SUITES :: 4096;
SU_TEXT :: 8388608;          // the largest .coax file read
SU_HEAD_LINES :: 80;
SU_TIMEOUT_MS :: 3600000;    // one suite's longest run, 60 minutes: a hang guard, not a budget (Everglade takes ~41 on a loaded Mac)
SU_JOBS :: 6;

SuHead :: struct { found: bool; steps: string; run_steps: string; traversal: string; library: bool; root_only: bool; native: string; only: string; }
Suite :: struct { path: string; steps: string; run_steps: string; traversal: string; library: bool; root_only: bool; native: string; missing: string; only: string; authority: bool; mutate: bool; }   // native: the unit it links, beside it   // missing: a #load not in the tree
// Kept text: bytes is a view of the caller's buffer.
SuArena :: struct { bytes: [] u8; used: int; full: bool; }

su_keep :: (a: [] SuArena, s: string) -> string {
  if a[0].used + s.count > a[0].bytes.count { a[0].full = true; return ""; }
  at := a[0].used;
  for i: 0..<s.count { a[0].bytes[at + i] = s[i]; }
  a[0].used += s.count;
  return cast(string) a[0].bytes[at..<at + s.count];
}

su_ident :: (c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }
su_space :: (c: u8) -> bool { return c == ' ' || c == '\t' || c == '\r'; }
su_starts :: (s: string, at: int, word: string) -> bool {
  if at + word.count > s.count { return false; }
  for i: 0..<word.count { if s[at + i] != word[i] { return false; } }
  return true;
}
su_base :: (path: string) -> string {
  from := 0;
  for i: 0..<path.count { if path[i] == '/' { from = i + 1; } }
  return path[from..<path.count];
}
su_dir :: (path: string) -> string {
  to := 0;
  for i: 0..<path.count { if path[i] == '/' { to = i; } }
  return path[0..<to];
}

// The repo path of rel (a #load's string) from dir (a repo path): "." and
// ".." resolved, "" when it climbs out of the repo.
su_norm :: (dir: string, rel: string, out: [] u8) -> string {
  starts: [256] int; n := 0; used := 0;
  for pass: 0..<2 {
    s := ifx pass == 0 then dir else rel;
    i := 0;
    while i <= s.count {
      j := i;
      while j < s.count && s[j] != '/' { j += 1; }
      part := s[i..<j];
      if part.count == 0 || part == "." {
      } else if part == ".." {
        if n == 0 { return ""; }
        n -= 1; used = starts[n];   // back to before it (and its slash)
      } else {
        if n >= 256 || used + part.count + 1 > out.count { return ""; }
        starts[n] = used;
        if n > 0 { out[used] = '/'; used += 1; }
        for k: 0..<part.count { out[used + k] = part[k]; }
        used += part.count; n += 1;
      }
      i = j + 1;
    }
  }
  return cast(string) out[0..<used];
}

// Whether the #load line starting at j ends in #test after its path.
su_test_load :: (text: string, j: int) -> bool {
  e := j; while e < text.count && text[e] != '\n' { e += 1; }
  q := j; quotes := 0;
  while q < e && quotes < 2 { if text[q] == '"' { quotes += 1; } q += 1; }
  if quotes < 2 { return false; }
  while q < e && su_space(text[q]) { q += 1; }
  return su_starts(text, q, "#test") && (q + 5 >= text.count || !su_ident(text[q + 5]));
}
// A #test or #forall at the start of a line (spaces before it allowed), or a
// #load of checks that load only under #test (`#load "tests/x.coax" #test;`):
// those checks run when this file is tested, and need its declarations.
su_has_tests :: (text: string) -> bool {
  i := 0;
  while i < text.count {
    j := i;
    while j < text.count && su_space(text[j]) { j += 1; }
    for word: [2] string.["#test", "#forall"] {
      if su_starts(text, j, word) && (j + word.count >= text.count || !su_ident(text[j + word.count])) { return true; }
    }
    if su_starts(text, j, "#load") && su_test_load(text, j) { return true; }
    while i < text.count && text[i] != '\n' { i += 1; }
    i += 1;
  }
  return false;
}

// An `#authority` directive at a line's start: the file decides money, admission or policy.
su_has_authority :: (text: string) -> bool {
  i := 0;
  while i < text.count {
    j := i;
    while j < text.count && su_space(text[j]) { j += 1; }
    if su_starts(text, j, "#authority") && (j + 10 >= text.count || !su_ident(text[j + 10])) { return true; }
    while i < text.count && text[i] != '\n' { i += 1; }
    i += 1;
  }
  return false;
}
#test "an #authority line marks a file; a mention in a comment or another word does not" {
  #assert su_has_authority("#import \"Basic\";\n#authority;\n") && su_has_authority("  #authority;");
  #assert !su_has_authority("// #authority;\n") && !su_has_authority("#authorityx;\n") && !su_has_authority("");
}

// A `main ::` declaration at a line's start: the file is a program.
su_has_main :: (text: string) -> bool {
  i := 0;
  while i < text.count {
    j := i;
    while j < text.count && su_space(text[j]) { j += 1; }
    if su_starts(text, j, "main") {
      k := j + 4;
      while k < text.count && su_space(text[k]) { k += 1; }
      if su_starts(text, k, "::") { return true; }
    }
    while i < text.count && text[i] != '\n' { i += 1; }
    i += 1;
  }
  return false;
}

#test "a file with main :: at a line's start is a program; a name that only begins with main is not" {
  #assert su_has_main("x :: 1;\nmain :: () { }\n") && su_has_main("  main  :: () {}");
  #assert !su_has_main("main_loop :: () {}\n// main\n") && !su_has_main("x := main;\n") && !su_has_main("");
}

// The `coax test` line in the first SU_HEAD_LINES lines that names a file
// called base, and the budget and flags on it.
// The compile-time budget a tool is built with: N from its "// tool.sh: run-steps N" line
// (coax/web/tool.sh), else "".
su_tool_run_steps :: (text: string) -> string {
  w := "// tool.sh: run-steps ";
  i := 0;
  while true {
    if su_starts(text, i, w) {
      from := i + w.count; z := from;
      while z < text.count && text[z] >= '0' && text[z] <= '9' { z += 1; }
      if z == text.count || text[z] == '\n' { return text[from..<z]; }  // "" when no digits
    }
    while i < text.count && text[i] != '\n' { i += 1; }
    if i == text.count { return ""; }
    i += 1;
  }
  return "";
}
// A file with checks that compiles only inside the program that loads it (it uses that program's
// names), the program, and whether that program is built as a library, as its own build does
// (#13586). labs.coax uses out.coax's Rep; apps/openagents-cli/build.sh runs `coax c main.coax --library`.
SuFragment :: struct { root: string; library: bool; }
su_fragment_root :: (path: string) -> SuFragment {
  if path == "apps/openagents-cli/labs.coax" { return SuFragment.{root = "apps/openagents-cli/main.coax", library = true}; }
  return SuFragment.{};
}
#test "a tool's compile-time budget comes from its tool.sh line, and a fragment's root is its program" {
  #assert su_tool_run_steps("// tool.sh: run-steps 100000000\n#load \"x.coax\";\n") == "100000000";
  #assert su_tool_run_steps("#load \"x.coax\";\n// tool.sh: run-steps 7") == "7";
  #assert su_tool_run_steps("// tool.sh: run-steps \n") == "" && su_tool_run_steps("// tool.sh: run-steps 12x\n") == "" && su_tool_run_steps("") == "";
  #assert su_tool_run_steps("x // tool.sh: run-steps 5\n") == "" && su_tool_run_steps("// tool.sh: run-steps 9\n// tool.sh: run-steps 8\n") == "9";
  #assert su_tool_run_steps("// tool.sh: run-steps 1/\n") == "" && su_tool_run_steps("// tool.sh: run-steps 1:\n") == "" && su_tool_run_steps("x\n\n// tool.sh: run-steps 3") == "3";
  fr := su_fragment_root("apps/openagents-cli/labs.coax");
  #assert fr.root == "apps/openagents-cli/main.coax" && fr.library;
  #assert su_fragment_root("apps/openagents-cli/main.coax").root == "" && !su_fragment_root("x.coax").library;
}
su_head :: (text: string, base: string) -> SuHead {
  h: SuHead;
  i := 0; line := 0;
  while i < text.count && line < SU_HEAD_LINES {
    e := i;
    while e < text.count && text[e] != '\n' { e += 1; }
    l := text[i..<e];
    for k: 0..<l.count {
      if !su_starts(l, k, "coax test") { continue; }
      // the words after it: the first .coax one is the file it runs
      named := false; steps := ""; run_steps := ""; traversal := ""; library := false; root_only := false; native := ""; only := "";
      w := k + 9;
      while w < l.count {
        while w < l.count && su_space(l[w]) { w += 1; }
        x := w;
        while x < l.count && !su_space(l[x]) { x += 1; }
        word := l[w..<x];
        if word.count > 5 && su_starts(word, word.count - 5, ".coax") && !named {
          if su_base(word) != base { break; }
          named = true;
        } else if word == "--library" { library = true; }
        else if word == "--root-only" { root_only = true; }
        else if word == "--native-link" || word == "--only" {
          y := x;
          while y < l.count && su_space(l[y]) { y += 1; }
          z := y;
          while z < l.count && !su_space(l[z]) { z += 1; }
          if word == "--only" && z > y && l[y] == '"' {
            // a quoted phrase is how a person runs a part by hand; the suite runs whole
            z = y + 1;
            while z < l.count && l[z] != '"' { z += 1; }
            if z < l.count { z += 1; }
          } else if word == "--only" { only = l[y..<z]; } else { native = l[y..<z]; }
          x = z;
        }
        else if word == "--steps" || word == "--run-steps" || word == "--traversal" {
          y := x;
          while y < l.count && su_space(l[y]) { y += 1; }
          z := y;
          while z < l.count && l[z] >= '0' && l[z] <= '9' { z += 1; }
          if z > y { if word == "--steps" { steps = l[y..<z]; } else if word == "--traversal" { traversal = l[y..<z]; } else { run_steps = l[y..<z]; } }
        }
        w = x;
      }
      if named { h.found = true; h.steps = steps; h.run_steps = run_steps; h.traversal = traversal; h.library = library; h.root_only = root_only; h.native = native; h.only = only; return h; }
    }
    i = e + 1; line += 1;
  }
  return h;
}

// Each #load's repo path, from the file at path, kept in a, and in tests whether it is a check load
// (`#load "x-checks.coax" #test;`).
su_loads :: (text: string, path: string, a: [] SuArena, loads: [] string, tests: [] bool, from: int) -> int {
  n := from;
  dir := su_dir(path);
  buf: [1024] u8;
  i := 0;
  while i < text.count {
    j := i;
    while j < text.count && su_space(text[j]) { j += 1; }
    if su_starts(text, j, "#load") {
      q := j + 5;
      while q < text.count && text[q] != '"' && text[q] != '\n' { q += 1; }
      if q < text.count && text[q] == '"' {
        r := q + 1;
        while r < text.count && text[r] != '"' && text[r] != '\n' { r += 1; }
        p := su_norm(dir, text[q + 1..<r], buf[..]);
        if p.count > 0 && n < loads.count && n < tests.count { loads[n] = su_keep(a, p); tests[n] = su_test_load(text, j); n += 1; }
      }
    }
    while i < text.count && text[i] != '\n' { i += 1; }
    i += 1;
  }
  return n;
}

// Under apps/openagents-web/, apps/openagents-desktop/, metaverse/, metaverse-engine/ (the engine core), everglade/ (the game), rules/ (the SRD rules: its
// check files ran as suites under metaverse-engine/rules/srd/ and stopped when the folder moved, #13270), coax/web/ or coax/lib/,
// and not in a hidden folder (.dev scratch).
#test "Coax Native installed policy and starter are checked suites" {
  #assert su_in("coax/native/updates-policy.coax") && su_in("coax/native/starter/app.coax");
  #assert !su_in("coax/native/.scratch/app.coax");
  #assert su_in("pay/wallet-balance-policy.coax") && su_in("apps/openagents-desktop/extras/app.coax");
  // the desktop page suite (641 checks) ran only from evals/openagents-desktop/run.sh, so no suite run saw
  // 76ded7e0e0 break it; the whole app folder is a suite folder, extras/ with it
  #assert su_in("apps/openagents-desktop/page.coax") && su_in("apps/openagents-desktop/page/checks/simpane-checks.coax");
  #assert !su_in("apps/openagents-cli/main.coax") && !su_in("evals/openagents-desktop/tier1/replay_test.coax");
}
su_in :: (path: string) -> bool {
  roots := [10] string.["apps/openagents-web/", "metaverse/", "metaverse-engine/", "everglade/", "rules/", "coax/web/", "coax/lib/", "coax/native/", "pay/", "apps/openagents-desktop/"];
  for r: roots { if su_starts(path, 0, r) { return !su_contains(path, "/."); } }
  return false;
}
// The nightly mutation sweep (--authority-units, #13586) also takes the #authority files no suite
// above reaches: apps/openagents-cli/, os/, nostr/relay/, tools/coax-nostr/ and the like. It leaves
// out docs/ (verification records: frozen copies of old inputs), coax/tests/ (the compiler's own
// fixtures, some red or weak on purpose), coax/book/ and coax/examples/ (listings whose survivors
// the book shows), psionic/ (psionic/check.sh mutates each of its units to zero survivors) and
// projects/ (other people's code). su_sweep_owner: where a file that runs such a file's checks may be.
su_sweep_scope :: (path: string) -> bool {
  if !su_sweep_owner(path) { return false; }
  out := [5] string.["coax/tests/", "coax/book/", "coax/examples/", "psionic/", "docs/"];
  for r: out { if su_starts(path, 0, r) { return false; } }
  return true;
}
su_sweep_owner :: (path: string) -> bool {
  return !su_starts(path, 0, "docs/") && !su_starts(path, 0, "projects/") && !su_contains(path, "/.") && !su_starts(path, 0, ".");
}
#test "the sweep takes #authority files outside the suites' folders, and not records, fixtures, listings or Psionic" {
  #assert su_sweep_scope("apps/openagents-cli/rules.coax") && su_sweep_scope("os/battlenet-policy.coax") && su_sweep_scope("nostr/relay/store_file.coax");
  #assert !su_sweep_scope("docs/verification/x/combined.coax") && !su_sweep_scope("coax/tests/fail/authority_red.coax");
  #assert !su_sweep_scope("coax/book/examples/ch22_spend1.coax") && !su_sweep_scope("coax/examples/money.coax") && !su_sweep_scope("psionic/lib/text.coax");
  #assert !su_sweep_scope("projects/repos/x/a.coax") && !su_sweep_scope("apps/.scratch/a.coax") && !su_sweep_scope(".dev/a.coax");
  #assert su_sweep_owner("coax/tests/bitcoin/coinscache-native.coax") && su_sweep_owner("psionic/tests/a.coax") && !su_sweep_owner("docs/a.coax");
}

// Whether a changed file that isn't Coax can change a suite's result. A
// suite's checks run at compile time, and the compiler reads only #load
// (Coax), #import_proto (a .pb descriptor) and itself. So: a descriptor, the
// compiler's sources and what builds it, and the C a native suite links. A C
// face, a host script, a budget table or a Swift source can't.
su_input :: (path: string) -> bool {
  if path.count > 3 && su_starts(path, path.count - 3, ".pb") { return true; }
  roots := [5] string.["coax/src/", "coax/bootstrap/", "coax/build.sh", "coax/provenance.sh", "coax/web/native-check.c"];
  for r: roots { if su_starts(path, 0, r) { return true; } }
  return false;
}
// Whether a changed file that isn't Coax can be an input of a web module
// (--affected): anything in the trees the web build reads. With faces
// (--faces) a .c or .h file isn't asked here: the caller matches the faces
// against the build's own commands.
su_web_input :: (path: string, faces: bool) -> bool {
  if su_input(path) { return true; }
  if faces && path.count > 2 && (su_starts(path, path.count - 2, ".c") || su_starts(path, path.count - 2, ".h")) { return false; }
  roots := [11] string.["coax/platform/", "coax/lib/", "coax/web/", "apps/openagents-web/", "metaverse/", "metaverse-engine/", "everglade/", "rules/", "psionic/", "proto/", "protocol/"];
  for r: roots { if su_starts(path, 0, r) { return true; } }
  return false;
}

#test "a changed file that isn't Coax changes a suite only through the compiler, a descriptor or a native suite's C" {
  #assert su_input("coax/src/check.cpp") && su_input("coax/bootstrap/checker.c") && su_input("coax/build.sh") && su_input("coax/web/native-check.c");
  #assert su_input("metaverse/voice.pb") && su_input("os/wire/desk.pb");
  #assert !su_input("metaverse-engine/host/frame.c") && !su_input("apps/openagents-web/wasm-budgets.txt") && !su_input("coax/web/tool.sh");
  #assert !su_input("apps/everglade-desktop/Sources/Workshop.swift") && !su_input("coax/remote/after.sh") && !su_input("pb") && !su_input(".gitignore");
}
#test "a web module's inputs are wider: the trees the build reads, its faces left to the caller on request" {
  #assert su_web_input("apps/openagents-web/wasm-budgets.txt", false) && su_web_input("coax/web/host.js", true) && su_web_input("coax/src/emit_c.cpp", true);
  #assert su_web_input("metaverse-engine/host/frame.c", false) && !su_web_input("metaverse-engine/host/frame.c", true) && !su_web_input("apps/openagents-web/sound-bank.h", true);
  #assert !su_web_input("apps/everglade-desktop/Sources/Workshop.swift", false) && !su_web_input("scripts/join-pylon.sh", true) && !su_web_input("coax/remote/check.sh", false);
}
#test "paths: a #load from a file's folder, dots resolved, never out of the repo" {
  b: [256] u8;
  #assert su_norm("apps/openagents-web", "../../metaverse/space.coax", b[..]) == "metaverse/space.coax";
  #assert su_norm("metaverse/everglade", "../terrain.coax", b[..]) == "metaverse/terrain.coax";
  #assert su_norm("metaverse", "./edit/edit.coax", b[..]) == "metaverse/edit/edit.coax";
  #assert su_norm("apps/openagents-web", "font.coax", b[..]) == "apps/openagents-web/font.coax";
  #assert su_norm("metaverse", "../../x.coax", b[..]) == "";
  #assert su_base("everglade/legacy/v1/plan.coax") == "plan.coax" && su_dir("everglade/legacy/v1/plan.coax") == "everglade/legacy/v1";
}
#test "a suite has a #test or #forall at a line's start; a word that only begins so does not count" {
  #assert su_has_tests("x :: 1;\n#test \"a\" { }\n") && su_has_tests("  #forall a: 0..<3 { }");
  #assert !su_has_tests("// #testing\n#tests_off :: 1;\n") && !su_has_tests("x := \"#test\";\n");
  #assert su_has_tests("#load \"tests/codec.coax\" #test;\n") && !su_has_tests("#load \"codec.coax\";\n") && !su_has_tests("#load \"a.coax\"; // #test\n");
}
#test "the header's own coax test line carries the budget and flags; another file's does not" {
  t := "// Everglade.\n//   coax/bin/coax test apps/openagents-web/everglade.coax --steps 2000000000\n#load \"x.coax\";\n";
  h := su_head(t, "everglade.coax");
  #assert h.found && h.steps == "2000000000" && !h.library;
  #assert !su_head(t, "fairy.coax").found;
  l := su_head("//   coax/bin/coax test --library metaverse/water.coax --steps 500000000\n", "water.coax");
  #assert l.found && l.library && l.steps == "500000000";
  d := su_head("// coax test metaverse/space.coax\n", "space.coax");
  #assert d.found && d.steps == "" && d.native == "";
  n := su_head("//   coax test apps/openagents-web/project-frames.coax --native-link project-capacity.coax\n", "project-frames.coax");
  #assert n.found && n.native == "project-capacity.coax" && n.steps == "";
  k := su_head("// coax test keys.coax --library --run-steps 250000000\n", "keys.coax");
  #assert k.found && k.library && k.run_steps == "250000000" && k.steps == "" && k.traversal == "";
  // --traversal: the compile-time traversal budget, which mutation's evaluator runs need (#13583)
  tv := su_head("//   coax/bin/coax test --library rules/srd/battle.coax --traversal 16000000000\n", "battle.coax");
  #assert tv.found && tv.library && tv.traversal == "16000000000" && tv.steps == "";
  // --only: just the checks whose names hold it (a file that loads a whole suite to add its own)
  o := su_head("// coax test --library fuzz.coax --steps 9 --only room-fuzz: --native-link\n", "fuzz.coax");
  #assert o.found && o.only == "room-fuzz:" && o.native == "" && o.steps == "9" && k.only == "";
  // a quoted phrase is not passed on, and the words in it are not read as options
  q := su_head("// coax test five.coax --only \"5E --library MMO\" --steps 7\n", "five.coax");
  #assert q.found && q.only == "" && !q.library && q.steps == "7";
}
#test "loads: each #load's repo path, comments and strings that only mention it left out" {
  keep: [4096] u8; a: [1] SuArena; a[0].bytes = keep[..]; loads: [8] string; tests: [8] bool;
  n := su_loads("#load \"font.coax\";\n  #load \"../../metaverse/camera.coax\";\n// see #loading\n#load \"font-checks.coax\" #test;\n", "apps/openagents-web/x.coax", a[..], loads[..], tests[..], 0);
  #assert n == 3 && loads[0] == "apps/openagents-web/font.coax" && loads[1] == "metaverse/camera.coax" && loads[2] == "apps/openagents-web/font-checks.coax";
  #assert !tests[0] && !tests[1] && tests[2];
  short: [1] bool;
  #assert su_loads("#load \"a.coax\";\n#load \"b.coax\";\n", "x.coax", a[..], loads[..], short[..], 0) == 1;
}

// The check units a suite reaches (#13610): the files its #load closure holds only through check
// loads (`#load "x-checks.coax" #test;`, Chapter 10), whose procedures no compile emits (E0616): only
// checks reach them. mark[f] is 1 when plain loads reach f from start (it ships with whatever loads
// the suite), 2 when only a path through a check load does (a check unit), 0 when the suite doesn't
// reach f. first, to and test are each file's loads: first[f]..<first[f + 1] index to (the file the
// load names, -1 when it is not in the tree) and test (a check load). todo holds mark.count files.
su_check_units :: (start: int, first: [] int, to: [] int, test: [] bool, mark: [] u8, todo: [] int) {
  for f: 0..<mark.count { mark[f] = 0; }
  if start < 0 || start >= mark.count { return; }
  mark[start] = 1; todo[0] = start; sp := 1;
  while sp > 0 {
    sp -= 1; f := todo[sp];
    for k: first[f]..<first[f + 1] { t := to[k]; if t >= 0 && !test[k] && mark[t] == 0 { mark[t] = 1; todo[sp] = t; sp += 1; } }
  }
  for f: 0..<mark.count { if mark[f] == 1 { todo[sp] = f; sp += 1; } }
  while sp > 0 {
    sp -= 1; f := todo[sp];
    for k: first[f]..<first[f + 1] { t := to[k]; if t >= 0 && mark[t] == 0 { mark[t] = 2; todo[sp] = t; sp += 1; } }
  }
}
#test "a file only check loads reach is a check unit; one a plain load also reaches ships" {
  // 0 the suite: plain 1, check 2; 1: plain 3; 2 (checks): plain 4, plain 3; 3: one off the tree; 5, 6 unreached
  first := [8] int.[0, 2, 3, 5, 6, 6, 6, 6];
  to := [6] int.[1, 2, 3, 4, 3, -1];
  test := [6] bool.[false, true, false, false, false, false];
  mark: [7] u8; todo: [7] int;
  su_check_units(0, first[..], to[..], test[..], mark[..], todo[..]);
  #assert mark[0] == 1 && mark[1] == 1 && mark[3] == 1 && mark[2] == 2 && mark[4] == 2 && mark[5] == 0 && mark[6] == 0;
  // the same tree from the checks file itself: everything it loads ships with it
  su_check_units(2, first[..], to[..], test[..], mark[..], todo[..]);
  #assert mark[2] == 1 && mark[3] == 1 && mark[4] == 1 && mark[0] == 0 && mark[1] == 0;
  // a check load of a check load, and a check load back to a shipped file
  first2 := [4] int.[0, 1, 3, 3]; to2 := [3] int.[1, 2, 0]; test2 := [3] bool.[true, true, true];
  m2: [3] u8; t2: [3] int;
  su_check_units(0, first2[..], to2[..], test2[..], m2[..], t2[..]);
  #assert m2[0] == 1 && m2[1] == 2 && m2[2] == 2;
  su_check_units(-1, first2[..], to2[..], test2[..], m2[..], t2[..]);
  #assert m2[0] == 0 && m2[1] == 0 && m2[2] == 0;
  su_check_units(3, first2[..], to2[..], test2[..], m2[..], t2[..]);
  #assert m2[0] == 0;
}

// The files --check-affected compiles: each tracked file whose #load closure holds a changed file
// (hit) and that no other file loads (a root: a suite, a program, a tool, wherever it lives), the
// nearest loaders of the change first, so a short time limit still compiles the closest ones. A
// compile error in a loaded file fails every root above it, and a changed signature fails the
// loaders that use it; only roots compile alone (a part uses its loader's names). The loads are
// load_by[l] loading load_to[l] (-1: not in the tree); dist and loaded are scratch, nf long; out
// takes the roots' file numbers. 76ded7e0e0 broke page/todos.coax, which only
// apps/openagents-desktop/page.coax loads, and no check before the push compiled it.
su_affected_roots :: (nf: int, load_by: [] int, load_to: [] int, hit: [] bool, dist: [] int, loaded: [] bool, out: [] int) -> int {
  for f: 0..<nf { dist[f] = ifx hit[f] then 0 else -1; loaded[f] = false; }
  for l: 0..<load_by.count { to := load_to[l]; if to >= 0 && to != load_by[l] { loaded[to] = true; } }
  level := 0; grew := true;
  while grew {
    grew = false;
    for l: 0..<load_by.count {
      to := load_to[l]; by := load_by[l];
      if to >= 0 && dist[to] == level && dist[by] < 0 { dist[by] = level + 1; grew = true; }
    }
    level += 1;
  }
  n := 0;
  for d: 0..<level { for f: 0..<nf { if dist[f] == d && !loaded[f] && n < out.count { out[n] = f; n += 1; } } }
  return n;
}
#test "the roots above a change, nearest first; a loaded file is never one" {
  // 0 loads 1, 1 loads 2 (changed), 3 loads 2 and 4, 5 loads 0; 6 is apart and changed; 7 loads one off the tree
  by := [6] int.[0, 1, 3, 3, 5, 7]; to := [6] int.[1, 2, 2, 4, 0, -1];
  hit := [8] bool.[false, false, true, false, false, false, true, false];
  dist: [8] int; loaded: [8] bool; out: [8] int;
  n := su_affected_roots(8, by[..], to[..], hit[..], dist[..], loaded[..], out[..]);
  #assert n == 3 && out[0] == 6 && out[1] == 3 && out[2] == 5;
  #assert dist[2] == 0 && dist[1] == 1 && dist[0] == 2 && dist[5] == 3 && dist[4] == -1 && dist[7] == -1;
  none := [8] bool.[false, false, false, false, false, false, false, false];
  #assert su_affected_roots(8, by[..], to[..], none[..], dist[..], loaded[..], out[..]) == 0;
  // a change to a root alone compiles it; out keeps no more than it holds
  only5 := [8] bool.[false, false, false, false, false, true, false, false];
  #assert su_affected_roots(8, by[..], to[..], only5[..], dist[..], loaded[..], out[..]) == 1 && out[0] == 5;
  one: [1] int;
  #assert su_affected_roots(8, by[..], to[..], hit[..], dist[..], loaded[..], one[..]) == 1 && one[0] == 6;
  // a changed root that loads another changed file is still distance 0, ahead of a nearer-numbered root
  // at distance 1: 0 loads 2, 1 (changed) loads 2 (changed)
  by2 := [2] int.[0, 1]; to2 := [2] int.[2, 2];
  hit2 := [3] bool.[false, true, true];
  #assert su_affected_roots(3, by2[..], to2[..], hit2[..], dist[..], loaded[..], out[..]) == 2 && out[0] == 1 && out[1] == 0;
  // the scratch from an earlier call is cleared: with no loads every changed file is a root
  nob: [1] int; all3 := [3] bool.[true, true, true];
  #assert su_affected_roots(3, nob[0..<0], nob[0..<0], all3[..], dist[..], loaded[..], out[..]) == 3 && out[2] == 2;
}

// A mutate run's survivor line ("../x.coax:2:12: mutant survived: '+' became '-'") as its file's repo
// path, from the folder of the suite it ran in; "" when the line names no file.
su_survivor_file :: (line: string, suite: string, out: [] u8) -> string {
  e := 0;
  while e < line.count && line[e] != ':' { e += 1; }
  if e == 0 || e >= line.count { return ""; }
  return su_norm(su_dir(suite), line[0..<e], out);
}
#test "a survivor's file is a repo path from its suite's folder" {
  b: [256] u8;
  #assert su_survivor_file("battle-strike-checks.coax:30:5: mutant survived: 2 became 3", "rules/srd/battle.coax", b[..]) == "rules/srd/battle-strike-checks.coax";
  #assert su_survivor_file("../web/x.coax:1:1: mutant survived: x", "coax/lib/a.coax", b[..]) == "coax/web/x.coax";
  #assert su_survivor_file("a.coax:1:1: x", "a.coax", b[..]) == "a.coax";
  #assert su_survivor_file("no file here", "a.coax", b[..]) == "" && su_survivor_file(":1:1: x", "a.coax", b[..]) == "";
}

su_say :: (s: string) { print("%", s); }

// Runs argv in dir to its end: stdout into out.
su_run :: (argv: [] string, dir: string, out: [] u8) -> ProcRun {
  r: ProcRun;
  h := proc_new();
  if h < 0 { r.started = PROC_ERROR; return r; }
  ok := proc_cwd(h, dir);
  for a: argv { ok = ok && proc_arg(h, a); }
  if !ok { d := proc_release(h); r.started = PROC_ERROR; return r; }
  r.started = proc_start(h);
  if r.started != 0 { d := proc_release(h); return r; }
  line: [65536] u8;
  while true {
    n := proc_line(h, 600000, line[..]);
    if n == PROC_EOF || n == PROC_ERROR { break; }
    if n == PROC_TIMEOUT { r.timed_out = true; break; }
    if n == PROC_TOO_LONG { r.cut = true; continue; }
    if r.out_n + n + 1 > out.count { r.cut = true; continue; }
    for i: 0..<n { out[r.out_n + i] = line[i]; }
    out[r.out_n + n] = '\n'; r.out_n += n + 1;
  }
  if r.timed_out { k := proc_kill(h, PROC_SIGKILL); }
  r.status = proc_wait(h, 5000);
  d := proc_release(h);
  return r;
}

// A native suite's program: the suite and its unit through coax lib, linked
// with coax/web/native-check.c in a fresh temporary directory. Its path, kept
// in into; empty when a step failed, with what that step said in out[0..<said].
Native :: struct { exe: string; said: int; }
su_rm :: (dir: string) {
  rm := [3] string.["rm", "-rf", dir];
  junk: [4096] u8;
  r := su_run(rm[..], ".", junk[..]);
}
su_native_build :: (coax: string, root: string, dir: string, s: Suite, out: [] u8, into: [] u8) -> Native {
  no: Native;
  mk := [2] string.["mktemp", "-d"];
  t := su_run(mk[..], dir, out);
  if t.started != 0 || t.status != 0 || t.out_n < 2 { return no; }
  tb: [4096] u8;
  if t.out_n > tb.count { return no; }
  for i: 0..<t.out_n - 1 { tb[i] = out[i]; }
  tmp := cast(string) tb[0..<t.out_n - 1];
  pa: [4096] u8; pb: [4096] u8; pc: [4096] u8;
  suite_o := fs_join(tmp, "suite.o", pa[..]);
  unit_o := fs_join(tmp, "unit.o", pb[..]);
  shim := fs_join(root, "coax/web/native-check.c", pc[..]);
  exe := fs_join(tmp, "checks", into);
  a1 := [5] string.[coax, "lib", su_base(s.path), "-o", suite_o];
  a2 := [5] string.[coax, "lib", s.native, "-o", unit_o];
  a3 := [8] string.["cc", "-O1", shim, suite_o, unit_o, "-lm", "-o", exe];
  r1 := su_run(a1[..], dir, out);
  if r1.started != 0 || r1.status != 0 { no.said = r1.out_n; su_rm(tmp); return no; }
  r2 := su_run(a2[..], dir, out);
  if r2.started != 0 || r2.status != 0 { no.said = r2.out_n; su_rm(tmp); return no; }
  r3 := su_run(a3[..], dir, out);
  if r3.started != 0 || r3.status != 0 { no.said = r3.out_n; su_rm(tmp); return no; }
  return Native.{exe = exe};
}

su_contains :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return false; }
  for i: 0..<hay.count - needle.count + 1 { if su_starts(hay, i, needle) { return true; } }
  return false;
}

// The lines a failing suite's report keeps: its first failing checks, or a mutate run's survivors (the
// after-landing mutation report lists them, coax/remote/after.sh) with the last kept for "not reached".
SU_FAILS :: 40;
SU_CO :: 64;   // check units a lane counts survivors in
Lane :: struct { h: int; suite: int; started_ms: int; last: [512] u8; last_n: int; fails: [SU_FAILS] [256] u8; fail_n: [SU_FAILS] int; fails_kept: int; tmp: [4096] u8; tmp_n: int; co_file: [SU_CO] int; co_n: [SU_CO] int; co_k: int; }   // tmp: a native suite's build, removed when it ends

// --mutate-only: the suites that have mutants (an #authority file's, not a native suite's, whose
// checks don't run in the evaluator), first and in order, each marked to mutate. The count kept.
su_mutate_only :: (suites: [] Suite) -> int {
  keep := 0;
  for s: 0..<suites.count {
    if suites[s].authority && suites[s].native.count == 0 { suites[keep] = suites[s]; suites[keep].mutate = true; keep += 1; }
  }
  return keep;
}
#test "--mutate-only keeps the #authority suites that run in the evaluator, in order, each to mutate" {
  s: [4] Suite;
  s[0].path = "a.coax"; s[0].authority = true;
  s[1].path = "b.coax";
  s[2].path = "c.coax"; s[2].authority = true; s[2].native = "c.c";
  s[3].path = "d.coax"; s[3].authority = true;
  n := su_mutate_only(s[..]);
  #assert n == 2 && s[0].path == "a.coax" && s[1].path == "d.coax" && s[0].mutate && s[1].mutate;
  #assert su_mutate_only(s[0..<0]) == 0;
  one: [1] Suite; one[0].authority = true;
  #assert su_mutate_only(one[..]) == 1 && one[0].mutate;
}
