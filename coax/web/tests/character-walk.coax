// Character Create -> USE IN EVERGLADE -> the walk -> Everglade, in headless Chrome
// (docs/metaverse/character-creator.md, "The road to Everglade").
//   coax/web/tool.sh coax/web/tests/character-walk.coax URL
//     Real time: the saved character walks for 30 s while Everglade opens out of sight, the page
//     hands over in place, Everglade admits a seat with the same appearance and no character
//     dialog, and no loading screen shows at any point after the click. Prints timings.
//   coax/web/tool.sh coax/web/tests/character-walk.coax URL --film OUT.mp4 FRAMES_DIR
//     The same journey in real time, screenshot after screenshot, written at 30 fps by the clock
//     (each shot repeats for the frames its time spans) and encoded at 1920x1080. Every shot is
//     checked for a loading screen as it is taken.
//     Then a held W must walk the seated player (the keyboard follows the hand-off).
//   Add --motion reduce to run with prefers-reduced-motion (the hand-off shows without a fade).
//   coax/web/tool.sh coax/web/tests/character-walk.coax URL --cold
//     The comparison: Everglade from a new browser (URL is Everglade).
// URL is the creator, e.g. http://127.0.0.1:8817/worlds/character-creator.
#import "Basic";
#load "../../lib/media/media.coax";

cw_eval :: (c:[]Cdp,js:string)->bool {n:=cdp_evaluate(c,js);return n>=0 && jv_kind(cdp_doc(c),n)==JV_TRUE;}
cw_int :: (c:[]Cdp,js:string)->int {n:=cdp_evaluate(c,js);if n<0 {return -1000000;}return jv_int(cdp_doc(c),n,-1000000);}
// A pointer press and release on the canvas, as a player's click reaches the page.
cw_click :: (c:[]Cdp,x:int,y:int)->bool {
  js:[512]u8;o:[1]Jo;jo_start(o[..],js[..]);jo_put(o[..],"(()=>{const c=document.querySelector('canvas');for(const type of ['pointerdown','pointerup'])c.dispatchEvent(new PointerEvent(type,{clientX:");
  jo_int(o[..],x);jo_put(o[..],",clientY:");jo_int(o[..],y);jo_put(o[..],",pointerId:31,pointerType:'mouse',button:0,bubbles:true}));return true;})()");
  return cw_eval(c,jo_text(o[..]));
}
// The creator's choices (probes 1 outfit, 2 female, 3 colorway, 4 dye, 10 eyes) and Everglade's
// saved player (27, 22, 25, 23, 24): the same character on both sides of the hand-off. Everglade
// runs in the zone frame Character Create opened (coax/web/zone-host.js), or as the page itself.
CW_CREATOR :: "[1,2,3,4,10].map(f=>coaxial.fieldProbe(f)).join(',')";
CW_EVERGLADE :: "(()=>{const c=(document.querySelector('iframe[data-zone]')?.contentWindow??window).coaxial;return [27,22,25,23,24].map(f=>c.fieldProbe(f)).join(',')})()";
cw_text :: (c:[]Cdp,js:string,out:[]u8)->string {n:=cdp_evaluate(c,js);if n<0 {return "";}t:=jv_raw(cdp_doc(c),n);k:=0;for ch:t {if k<out.count {out[k]=ch;k+=1;}}return cast(string)out[0..<k];}
CW_ARRIVED :: "location.pathname==='/worlds/everglade'&&(()=>{const c=(document.querySelector('iframe[data-zone]')?.contentWindow??window).coaxial;return !!c?.sceneReady&&c.fieldProbe(20)===1})()";
CW_SEATED :: "(()=>{const c=(document.querySelector('iframe[data-zone]')?.contentWindow??window).coaxial;return c?.netProbe?.(0)===2&&c.netProbe(1)>=0})()";
CW_PICKER :: "location.pathname==='/worlds/everglade'&&(()=>{const c=(document.querySelector('iframe[data-zone]')?.contentWindow??window).coaxial;return !!c?.sceneReady&&c.fieldProbe(20)===1&&c.fieldProbe(29)!==0})()";
// What the visitor sees after the click: 0 the walk or Everglade, 1 a loading screen on the page,
// 2 a loading screen in the shown zone frame, 3 a zone frame that can't be read, 4 Everglade
// opened the ordinary way (a new page load, its loader and all).
CW_SHOWN :: "(()=>{const f=document.querySelector('iframe[data-zone]');const on=d=>{const l=d&&d.getElementById('coaxial-load');return !!l&&!l.classList.contains('gone')};if(on(document))return 1;if(f&&f.style.zIndex==='3'){try{if(on(f.contentDocument))return 2;}catch{return 3;}}if(!f&&location.pathname==='/worlds/everglade')return 4;return 0;})()";
// The zone frame shown over the walk (the hand-off has begun).
CW_HANDED :: "document.querySelector('iframe[data-zone]')?.style.zIndex==='3'";
// Everglade's world loop held still while it waits out of sight.
CW_HELD :: "!!document.querySelector('iframe[data-zone]')?.contentWindow.coaxial?.worldLoop?.().paused";
// After the seat, a held W (real input, to whatever has focus) must walk Everglade's player: the
// hand-off gives the zone frame the keyboard (coax/web/zone-host.js).
CW_MARK :: "(()=>{const c=(document.querySelector('iframe[data-zone]')?.contentWindow??window).coaxial;globalThis.__cw=[c.fieldProbe(0),c.fieldProbe(2)];return true})()";
CW_MOVED :: "(()=>{const c=(document.querySelector('iframe[data-zone]')?.contentWindow??window).coaxial;return Math.round(Math.abs(c.fieldProbe(0)-__cw[0])+Math.abs(c.fieldProbe(2)-__cw[1]))})()";
cw_key :: (c:[]Cdp,down:bool)->bool {return cdp_call(c,"Input.dispatchKeyEvent",ifx down then "{\"type\":\"keyDown\",\"key\":\"w\",\"code\":\"KeyW\",\"windowsVirtualKeyCode\":87}" else "{\"type\":\"keyUp\",\"key\":\"w\",\"code\":\"KeyW\",\"windowsVirtualKeyCode\":87}",CDP_CALL_MS)>=0;}
// The creator's USE IN EVERGLADE (desktop sidebar, boxes[17]) and SURPRISE ME (boxes[14]).
CW_USE_X :: 260; CW_USE_Y :: 696; CW_SURPRISE_X :: 260; CW_SURPRISE_Y :: 652;

tool_main :: ()->int #export_c #effects(all) {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])<1 {tool_errln("character-walk: URL [--film OUT.mp4 FRAMES_DIR]");return 2;}
  // --mbps N throttles the browser's downloads to N megabits a second with 40 ms latency (a home
  // connection), so the open's overlap with the walk shows; without it localhost is near instant.
  mb:=args_value(a[..],"--mbps","0");mbps:=0;for j:0..<mb.count {if mb[j]>=48 && mb[j]<=57 {mbps=mbps*10+cast(int)(mb[j]-48);}}
  n:=ifx mbps>0 then args_count(a[..])-2 else args_count(a[..]);
  // --motion reduce runs the page with prefers-reduced-motion set: the hand-off skips its fade.
  still:=args_value(a[..],"--motion","full")=="reduce";if still {n-=2;}
  url:=args_at(a[..],0);film:=n==4 && args_at(a[..],1)=="--film";cold:=n==2 && args_at(a[..],1)=="--cold";
  if n!=1 && !film && !cold {tool_errln("character-walk: URL [--cold | --film OUT.mp4 FRAMES_DIR] [--mbps N]");return 2;}

  c:[1]Cdp;if !cdp_launch(c[..],1920,1080,"character-walk-") {tool_errln(cdp_error(c[..]));return 1;}
  if still && cdp_call(c[..],"Emulation.setEmulatedMedia","{\"features\":[{\"name\":\"prefers-reduced-motion\",\"value\":\"reduce\"}]}",CDP_CALL_MS)<0 {tool_errln(cdp_error(c[..]));cdp_close(c[..]);return 1;}
  status:=0;if cold {status=cw_cold(c[..],url,mbps);} else {status=cw_journey(c[..],url,mbps,still,film,ifx film then args_at(a[..],2) else "",ifx film then args_at(a[..],3) else "");}
  cdp_close(c[..]);return status;
}

cw_open :: (c:[]Cdp,url:string,cw_mbps:int)->bool {
  if !media_size(c,ArgsSize.{ok=true,w=1920,h=1080}) || cdp_call(c,"Runtime.enable","",CDP_CALL_MS)<0 || cdp_call(c,"Page.enable","",CDP_CALL_MS)<0 {return false;}
  if cw_mbps>0 {
    q:[256]u8;t:[1]Jo;jo_start(t[..],q[..]);jo_obj(t[..]);jo_key(t[..],"offline");jo_bool(t[..],false);jo_key(t[..],"latency");jo_int(t[..],40);
    jo_key(t[..],"downloadThroughput");jo_int(t[..],cw_mbps*125000);jo_key(t[..],"uploadThroughput");jo_int(t[..],cw_mbps*125000);jo_end(t[..]);
    if cdp_call(c,"Network.enable","",CDP_CALL_MS)<0 || cdp_call(c,"Network.emulateNetworkConditions",jo_text(t[..]),CDP_CALL_MS)<0 {return false;}
  }
  p:[4096]u8;o:[1]Jo;jo_start(o[..],p[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],url);jo_end(o[..]);
  return cdp_call(c,"Page.navigate",jo_text(o[..]),CDP_CALL_MS)>=0;
}

// ---- the journey, in real time (the film takes a screenshot at each step as well)
CW_FPS :: 30;
cw_journey :: (c:[]Cdp,url:string,mbps:int,still:bool,film:bool,out:string,frames:string)->int {
  if film {ok:=fs_mkdir(frames);}
  if !cw_open(c,url,mbps) {tool_errln(cdp_error(c));return 1;}
  ready:=false;for i:0..<600 {proc_sleep(100);if cw_eval(c,"!!globalThis.coaxial?.sceneReady&&!document.getElementById('coaxial-load')&&coaxial.fieldProbe(14)>0") {ready=true;break;}}
  if !ready {tool_errln("Character Create never drew its glade");return 1;}
  if !cw_click(c,CW_SURPRISE_X,CW_SURPRISE_Y) {return 1;}
  n:=0;shot:[MEDIA_PNG]u8;size:=0;written:=0;started:=proc_now_ms();
  // A second and a half of the studio before the click, in the film.
  while film && proc_now_ms()-started<1500 {k:=cw_jpeg(c,shot[..]);if k>0 {size=k;}due:=(proc_now_ms()-started)*CW_FPS/1000;while written<due && size>0 {if !cw_write(frames,n,cast(string)shot[0..<size]) {return 1;}n+=1;written+=1;}}
  if !film {proc_sleep(300);}
  look:[64]u8;before:=cw_text(c,CW_CREATOR,look[..]);
  t0:=proc_now_ms();if !cw_click(c,CW_USE_X,CW_USE_Y) {return 1;}
  walking:= -1;warm:= -1;warm_walk:= -1;held:=false;fade_walk:= -1;handed:= -1;moved:= -1;arrived:= -1;seated:= -1;
  picker:=false;shown_bad:=0;bad_at:= -1;checks:=0;pct:= -1;
  while proc_now_ms()-t0<120000 {
    if film {
      k:=cw_jpeg(c,shot[..]);if k>0 {size=k;}
      due:=(proc_now_ms()-started)*CW_FPS/1000;while written<due && size>0 {if !cw_write(frames,n,cast(string)shot[0..<size]) {return 1;}n+=1;written+=1;}
    } else {proc_sleep(50);}
    now:=proc_now_ms()-t0;
    // Every look after the click: no loading screen, and no ordinary page load.
    v:=cw_int(c,CW_SHOWN);checks+=1;if v>0 && shown_bad==0 {shown_bad=v;bad_at=now;}
    if handed<0 {
      w:=cw_int(c,"coaxial.fieldProbe(20)");
      if w>=2 && walking<0 {walking=now;}
      if warm<0 {st:=cw_int(c,"coaxial.fieldProbe(23)");pct=cw_int(c,"coaxial.fieldProbe(24)");if st==1 {warm=now;warm_walk=cw_int(c,"coaxial.fieldProbe(21)");}}
      if warm>=0 && !held && cw_eval(c,CW_HELD) {held=true;}
      if w>=4 && fade_walk<0 {fade_walk=cw_int(c,"coaxial.fieldProbe(21)");}
      if cw_eval(c,CW_HANDED) {handed=now;}
    }
    if moved<0 && cw_eval(c,"location.pathname==='/worlds/everglade'") {moved=now;}
    if moved>=0 && cw_eval(c,CW_PICKER) {picker=true;}
    if moved>=0 && arrived<0 && cw_eval(c,CW_ARRIVED) {arrived=now;}
    if arrived>=0 && seated<0 && cw_eval(c,CW_SEATED) {seated=now;}
    if arrived>=0 && now>arrived+6000 && (seated>=0 || now>arrived+15000) {break;}
  }
  after:[64]u8;landed:=cw_text(c,CW_EVERGLADE,after[..]);
  print("{\"walking_ms\":%,\"everglade_up_ms\":%,\"everglade_up_walk_ms\":%,\"held_out_of_sight\":%,\"hand_off_walk_ms\":%,\"handed_ms\":%,\"address_ms\":%,\"everglade_drawn_ms\":%,\"seated_ms\":%,\"creator\":\"%\",\"everglade\":\"%\",\"picker\":%,\"looks\":%,\"loading_screen\":%,\"loading_screen_ms\":%",
    walking,warm,warm_walk,ifx held then "true" else "false",fade_walk,handed,moved,arrived,seated,before,landed,ifx picker then "true" else "false",checks,shown_bad,bad_at);
  if film {print(",\"frames\":%",n);}
  print("}\n");
  if film {
    pattern:[4200]u8;err:[65536]u8;so:[4096]u8;
    av:=[19]string.["ffmpeg","-v","error","-y","-framerate","30","-i",fs_join(frames,"f%05d.jpg",pattern[..]),"-c:v","libx264","-preset","slow","-pix_fmt","yuv420p","-crf","23","-movflags","+faststart",out];
    enc:=proc_run(av[..],-1,so[..],err[..]);
    if enc.started!=0 || enc.status!=0 {tool_errln("ffmpeg failed");tool_errln(cast(string)err[0..<enc.err_n]);return 1;}
    print("Film: %\n",out);
  }
  if shown_bad==4 {tool_errln("Everglade opened as a new page load, not in place");return 1;}
  if shown_bad>0 {tool_errln("a loading screen showed after USE IN EVERGLADE");return 1;}
  if handed<0 || moved<0 {tool_errln("the walk never handed Everglade over in place");return 1;}
  if picker {tool_errln("Everglade opened a character dialog after the walk");return 1;}
  if seated<0 {tool_errln("Everglade never seated the walker");return 1;}
  // Reduced motion skips the walk: Everglade comes up in place within a few seconds instead.
  if still && handed>5000 {tool_errln("with reduced motion, Everglade did not come up within 5 s");return 1;}
  if !still && (fade_walk<28000 || fade_walk>40000) {tool_errln("the walk did not take about 30 seconds");return 1;}
  if !cw_same(before,landed) {tool_errln("Everglade's player is not the saved character");return 1;}
  walked:=-1;if cw_eval(c,CW_MARK) && cw_key(c,true) {proc_sleep(1500);walked=cw_int(c,CW_MOVED);if !cw_key(c,false) {walked=-1;}}
  print("{\"keys_walked\":%}\n",walked);
  if walked<=100 {tool_errln("a held W after the hand-off did not move Everglade's player");return 1;}
  if still {print("Character walk (reduced motion): save, Everglade in place within 5 s, same character, seat, keys walk, no dialog, no loading screen.\n");return 0;}
  print("Character walk: save, 30 s walk with Everglade opening out of sight, hand-off in place, same character, seat, no dialog, no loading screen.\n");return 0;
}
// The comparison: Everglade opened straight from a new browser (URL is Everglade).
cw_cold :: (c:[]Cdp,url:string,mbps:int)->int {
  t0:=proc_now_ms();if !cw_open(c,url,mbps) {tool_errln(cdp_error(c));return 1;}
  for i:0..<1200 {proc_sleep(50);if cw_eval(c,"!!globalThis.coaxial?.sceneReady") {print("{\"cold_everglade_drawn_ms\":%}\n",proc_now_ms()-t0);return 0;}}
  tool_errln("Everglade never drew");return 1;
}
// "outfit,female,colorway,dye,eyes" from both sides.
cw_same :: (a:string,b:string)->bool {return a.count>0 && a==b;}

cw_jpeg :: (c:[]Cdp,out:[]u8)->int {
  r:=cdp_call(c,"Page.captureScreenshot","{\"format\":\"jpeg\",\"quality\":88}",CDP_CALL_MS);if r<0 {return -1;}
  d:=cdp_doc(c);data:=jv_get(d,r,"data");if jv_kind(d,data)!=JV_STRING {return -1;}return b64_decode(jv_raw(d,data),out);
}
cw_write :: (frames:string,n:int,bytes:string)->bool {
  name:[32]u8;name[0]=102;k:=1;digits:[8]u8;v:=n;for j:0..<5 {digits[4-j]=cast(u8)(48+v%10);v=v/10;}for j:0..<5 {name[k]=digits[j];k+=1;}ext:=".jpg";for j:0..<4 {name[k]=ext[j];k+=1;}
  path:[4200]u8;return fs_write(fs_join(frames,cast(string)name[0..<k],path[..]),bytes);
}
