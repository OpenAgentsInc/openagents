Vec  size 12  align 4
       0     4  x: f32
       4     4  y: f32
       8     4  z: f32
Item  size 24  align 8
       0     2  q: u16
       2     6  (padding)
       8     8  id: int
      16     1  n: u8
      17     7  (padding)
Inner  size 24  align 8
       0     8  hp: int
       8    12  pos: Vec
      20     4  tag: [4] u8
Game  size 144  align 8
       0     1  ready: bool
       1     3  (padding)
       4     4  heat: f32
       8     4  score: s32
      12     1  mode: Mode
      13     3  (padding)
      16    72  items: [3] Item
      88    24  inner: [1] Inner
     112    16  name: string
     128     8  gone: int
     136     4  grid: [2] [2] u8
     140     4  (padding)
Mode  enum u8  size 1
  idle = 0
  walk = 1
  run = 2
