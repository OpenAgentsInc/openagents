Vec :: struct { x: f32; y: f32; }
Mode :: enum u8 { idle; walk; run; }
Item :: struct { id: s32; n: u8; }
Inner :: struct { hp: int; pos: Vec; }
Game :: struct {
  ready: bool;
  heat: f32;
  score: s32;
  mode: Mode;
  items: [3] Item;
  inner: [1] Inner;
  name: string;
  grid: [2] [2] u8;
}
use :: (g: [] Game) -> bool #export_c #effects(all) { return g[0].name.count > 0; }
