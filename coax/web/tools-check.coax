// The tools-in-Coax rule (coax/tools-in-coax.md), checked: every tracked
// .ts, .py, .js, .sh and .cjs file either says why it stays non-Coax in a
// header line starting "Firm reason:" (one of its first 60 lines, after
// comment marks) or is on coax/tools-port.txt. A new file that
// is neither fails. A file under coax/tests/vectors/upstream/ that
// coax/tests/vectors/manifest.json lists as upstream, with the SHA-256 its
// bytes have, is vendored data and not a tool; an unlisted one there still
// needs a reason, and a listed one whose bytes changed fails. Entries on the list that are gone, or now carry a
// header, are reported so the list keeps shrinking.
//   coax/web/tool.sh tools-check            (from the repo root)
// Not yet run by release.sh.
#import "Basic";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/proc.coax";
#load "../lib/json/json.coax";
#load "../lib/crypto/sha256-memory.coax";

LIST :: "coax/tools-port.txt";
TC_FILE :: 33554432;
TC_MANIFEST :: "coax/tests/vectors/manifest.json";
TC_MANIFEST_DIR :: "coax/tests/vectors/";
TC_UPSTREAM :: "coax/tests/vectors/upstream/";
// tc_vendored's answers.
TC_TOOL :: 0; TC_VENDORED :: 1; TC_CHANGED :: 2;
// Bootstrap whose bytes are the compiler's fingerprint: reason 4 without a header.
FINGERPRINTED :: [3] string.["coax/build.sh", "coax/bootstrap-build.sh", "coax/provenance.sh"];

#test "which files the rule covers, and list lines" {
  #assert tc_covered("a/b.ts") && tc_covered("x.py") && tc_covered("x.js") && tc_covered("x.sh") && tc_covered("x.cjs");
  #assert !tc_covered("x.coax") && !tc_covered("x.mjs") && !tc_covered("ts") && !tc_covered("x.tsx");
  #assert tc_listed("a\nb/c.ts\n# x.ts\n", "b/c.ts") && !tc_listed("a\nb/c.ts\n", "c.ts") && !tc_listed("# x.ts\n", "x.ts") && tc_listed("a", "a");
  #assert tc_has("x\n# Firm reason: 5 (...)\n", "Firm reason:") && !tc_has("Firm reason", "Firm reason:");
}
#test "the reason is a header line, not the words anywhere" {
  #assert tc_header("#!/bin/sh\n# Firm reason: 5 (a wrapper)\n") && tc_header("// Firm reason: 1 (glue)\n") && tc_header("\"\"\"Firm reason: 2 (oracle)\n");
  #assert tc_header(" * Firm reason: 3\n") && tc_header("Firm reason: 4\n") && tc_header("x\n  #  Firm reason: 2\n");
  #assert !tc_header("echo \"no Firm reason: here\"\n") && !tc_header("# a tool without a \"Firm reason:\" line\n") && !tc_header("");
  deep: [4096] u8; n := 0;
  for i: 0..<TC_HEADER_LINES { deep[n] = 'x'; deep[n + 1] = '\n'; n += 2; }
  tail := "# Firm reason: 5\n";
  for c: tail { deep[n] = c; n += 1; }
  #assert !tc_header(cast(string) deep[0..<n]) && tc_header(cast(string) deep[2..<n]);
}
TC_HEADER_LINES :: 60;
// Whether one of the first TC_HEADER_LINES lines starts, after spaces and
// comment marks (# // /* * """ ''' -- ;), with "Firm reason:".
tc_header :: (body: string) -> bool {
  mark := "Firm reason:";
  i := 0; line := 0;
  while i < body.count && line < TC_HEADER_LINES {
    j := i;
    while j < body.count && (body[j] == ' ' || body[j] == '\t' || body[j] == '#' || body[j] == '/' || body[j] == '*' || body[j] == '"' || body[j] == '\'' || body[j] == '-' || body[j] == ';') { j += 1; }
    if j + mark.count <= body.count && body[j..<j + mark.count] == mark { return true; }
    while i < body.count && body[i] != '\n' { i += 1; }
    i += 1; line += 1;
  }
  return false;
}
#test "the list's base commit" {
  #assert tc_base("# x\n# base: 0123abcd\na.py\n") == "0123abcd" && tc_base("a.py\n") == "" && tc_base("# base: \n") == "";
  #assert tc_base("# base: 12 34\n") == "";
}
// The commit named by the list's "# base: HASH" line, or "".
tc_base :: (list: string) -> string {
  head := "# base: ";
  i := 0;
  while i < list.count {
    j := i;
    while j < list.count && list[j] != '\n' { j += 1; }
    line := list[i..<j]; i = j + 1;
    if line.count > head.count && line[0..<head.count] == head {
      h := line[head.count..<line.count];
      for c: h { if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) { return ""; } }
      return h;
    }
  }
  return "";
}
tc_ends :: (s: string, tail: string) -> bool { return s.count > tail.count && s[s.count - tail.count..<s.count] == tail; }
tc_covered :: (path: string) -> bool {
  return tc_ends(path, ".ts") || tc_ends(path, ".py") || tc_ends(path, ".js") || tc_ends(path, ".sh") || tc_ends(path, ".cjs");
}
tc_has :: (s: string, part: string) -> bool {
  if part.count > s.count { return false; }
  for i: 0..<s.count - part.count + 1 { if s[i] == part[0] && s[i..<i + part.count] == part { return true; } }
  return false;
}
// Whether path is a whole line of the list (comment lines start with #).
tc_listed :: (list: string, path: string) -> bool {
  i := 0;
  while i < list.count {
    j := i;
    while j < list.count && list[j] != '\n' { j += 1; }
    if list[i..<j] == path { return true; }
    i = j + 1;
  }
  return false;
}

#test "vendored upstream vectors: listed with their hash, or a tool like any other" {
  // three entries, each with SHA-256("abc"): upstream, derived, and an upstream path marked derived
  m := "{\"files\":[{\"path\":\"upstream/core/t.py\",\"kind\":\"upstream\",\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"},{\"path\":\"derived/d.py\",\"kind\":\"derived\",\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"},{\"path\":\"upstream/core/u.py\",\"kind\":\"derived\",\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"}]}";
  nodes: [64] JvNode; d: [1] Jv;
  #assert jv_parse(d[..], m, nodes[..]);
  abc: [3] u8; abc[0] = 'a'; abc[1] = 'b'; abc[2] = 'c';
  abd: [3] u8; abd[0] = 'a'; abd[1] = 'b'; abd[2] = 'd';
  #assert tc_vendored(d[0], "coax/tests/vectors/upstream/core/t.py", abc[..]) == TC_VENDORED;
  // the listed file with other bytes
  #assert tc_vendored(d[0], "coax/tests/vectors/upstream/core/t.py", abd[..]) == TC_CHANGED;
  #assert tc_vendored(d[0], "coax/tests/vectors/upstream/core/t.py", abc[0..<0]) == TC_CHANGED;
  // an unlisted .py in the folder, a listed one not marked upstream, and paths outside the folder
  #assert tc_vendored(d[0], "coax/tests/vectors/upstream/core/new.py", abc[..]) == TC_TOOL;
  #assert tc_vendored(d[0], "coax/tests/vectors/upstream/core/u.py", abc[..]) == TC_TOOL;
  #assert tc_vendored(d[0], "coax/tests/vectors/derived/d.py", abc[..]) == TC_TOOL;
  #assert tc_vendored(d[0], "upstream/core/t.py", abc[..]) == TC_TOOL;
  #assert tc_vendored(d[0], "x/coax/tests/vectors/upstream/core/t.py", abc[..]) == TC_TOOL;
  #assert tc_vendored(d[0], "coax/tests/vectors/upstream/", abc[..]) == TC_TOOL;
  // no manifest, or one without a files array
  e: [1] Jv;
  #assert tc_vendored(e[0], "coax/tests/vectors/upstream/core/t.py", abc[..]) == TC_TOOL;
  #assert jv_parse(d[..], "{\"files\":{\"path\":\"upstream/core/t.py\"}}", nodes[..]);
  #assert tc_vendored(d[0], "coax/tests/vectors/upstream/core/t.py", abc[..]) == TC_TOOL;
}
// Whether path is vendored upstream data: TC_VENDORED when it is under
// TC_UPSTREAM and the manifest m lists it (relative to TC_MANIFEST_DIR) with
// kind "upstream" and body's SHA-256; TC_CHANGED when it is listed so but
// body hashes otherwise; TC_TOOL (the rule applies) for anything else.
tc_vendored :: (m: Jv, path: string, body: [] u8) -> int {
  if path.count <= TC_UPSTREAM.count || path[0..<TC_UPSTREAM.count] != TC_UPSTREAM { return TC_TOOL; }
  rel := path[TC_MANIFEST_DIR.count..<path.count];
  files := jv_get(m, 0, "files");
  if jv_kind(m, files) != JV_ARRAY { return TC_TOOL; }
  k := m.nodes[files].first;
  while k != -1 {
    p := jv_get(m, k, "path"); kind := jv_get(m, k, "kind");
    if jv_kind(m, p) == JV_STRING && jv_raw_eq(jv_raw(m, p), rel) && jv_kind(m, kind) == JV_STRING && jv_raw_eq(jv_raw(m, kind), "upstream") {
      raw: [32] u8; hex: [64] u8;
      // raw is this frame's own array: it cannot overlap body
      if sha256_hash_checked(body, raw[..], false) != SHA_OK { return TC_CHANGED; }
      digits := "0123456789abcdef";
      for i: 0..<32 { hex[i * 2] = digits[cast(int) (raw[i] >> 4)]; hex[i * 2 + 1] = digits[cast(int) (raw[i] & 15)]; }
      h := jv_get(m, k, "sha256");
      return ifx jv_kind(m, h) == JV_STRING && jv_raw(m, h) == cast(string) hex[..] then TC_VENDORED else TC_CHANGED;
    }
    k = m.nodes[k].next;
  }
  return TC_TOOL;
}

tool_main :: () -> int #export_c {
  list: [1048576] u8;
  ln := fs_read(LIST, list[..]);
  if ln < 0 { tool_errln("tools-check: run from the repo root (no coax/tools-port.txt here)"); return 2; }
  text := cast(string) list[0..<ln];
  argv := [7] string.["git", "ls-files", "*.ts", "*.py", "*.js", "*.sh", "*.cjs"];
  files: [4194304] u8; err: [4096] u8;
  r := proc_run(argv[..], 60000, files[..], err[..]);
  if r.started != 0 || r.status != 0 || r.cut { tool_errln("tools-check: git ls-files failed"); return 2; }
  all := cast(string) files[0..<r.out_n];
  // No manifest: nothing counts as vendored.
  mtext: [1048576] u8;
  mn := fs_read(TC_MANIFEST, mtext[..]);
  mnodes: [16384] JvNode; md: [1] Jv;
  if mn >= 0 && !jv_parse(md[..], cast(string) mtext[0..<mn], mnodes[..]) { print("tools-check: % is not JSON (or has too many nodes)\n", TC_MANIFEST); return 2; }
  vendored := 0;
  body: [TC_FILE] u8;
  bad := 0; tracked := 0;
  i := 0;
  while i < all.count {
    j := i;
    while j < all.count && all[j] != '\n' { j += 1; }
    path := all[i..<j]; i = j + 1;
    if !tc_covered(path) { continue; }
    tracked += 1;
    skip := false;
    for f: FINGERPRINTED { if f == path { skip = true; } }
    if skip { continue; }
    n := fs_read(path, body[..]);
    if n >= 0 {
      v := tc_vendored(md[0], path, body[0..<n]);
      if v == TC_VENDORED { vendored += 1; continue; }
      if v == TC_CHANGED { print("vendored upstream file whose bytes no longer match its sha256 in %: %\n", TC_MANIFEST, path); bad += 1; continue; }
    }
    header := n >= 0 && tc_header(cast(string) body[0..<n]);
    listed := tc_listed(text, path);
    if !header && !listed { print("new non-Coax tool with no Firm reason: line and not on the port list: %\n", path); bad += 1; }
    if header && listed { print("on the port list but carries a Firm reason: line (take it off the list): %\n", path); }
  }
  // Every listed path was tracked at the list's base commit.
  base := tc_base(text);
  if base.count < 7 { tool_errln("tools-check: coax/tools-port.txt has no \"# base: COMMIT\" line"); return 2; }
  tree: [4194304] u8;
  lt := [6] string.["git", "ls-tree", "-r", "--name-only", base, ""];
  t := proc_run(lt[0..<5], 60000, tree[..], err[..]);
  if t.started != 0 || t.status != 0 || t.cut { print("tools-check: git ls-tree % failed (is the base commit fetched?)\n", base); return 2; }
  // only the covered paths, so each lookup scans less
  at_base: [1048576] u8; bn := 0;
  q := 0;
  while q < t.out_n {
    e := q;
    while e < t.out_n && tree[e] != '\n' { e += 1; }
    if tc_covered(cast(string) tree[q..<e]) && bn + e - q + 1 <= at_base.count {
      for x: q..<e { at_base[bn] = tree[x]; bn += 1; }
      at_base[bn] = '\n'; bn += 1;
    }
    q = e + 1;
  }
  base_paths := cast(string) at_base[0..<bn];
  // Entries whose file is gone: the port landed, so the line goes.
  k := 0;
  while k < text.count {
    e := k;
    while e < text.count && text[e] != '\n' { e += 1; }
    line := text[k..<e]; k = e + 1;
    if line.count == 0 || line[0] == '#' { continue; }
    if !tc_listed(all, line) { print("on the port list but not tracked (ported? take it off): %\n", line); continue; }
    if !tc_listed(base_paths, line) { print("on the port list but added after its base commit (write it in Coax, or give it a Firm reason: line): %\n", line); bad += 1; }
  }
  print("tools-check: % tracked tool files (% of them vendored upstream vectors), % new without a reason\n", tracked, vendored, bad);
  return ifx bad == 0 then 0 else 1;
}
