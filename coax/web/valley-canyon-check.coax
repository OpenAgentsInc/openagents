// Actual source pack -> Coax SHA gate -> immutable GPU geometry/maps/shadows, in muted headless Chrome.
#import "Basic";
#load "../lib/net/cdp.coax";
cc_eval :: (c:[]Cdp,label:string,js:string)->bool {n:=cdp_evaluate(c,js);if n>=0 && jv_raw(c[0].doc[0],n)=="true" {return true;}print("FAIL %\n",label);n=cdp_evaluate(c,"JSON.stringify({ready:coaxial?.sceneReady,probe:Array.from({length:6},(_,i)=>coaxial?.guardProbe(i)),errors:canyonErrors,hashes:canyonPixels,mode:globalThis.canyonGateMode,recovery:coaxial?.gpuRecovery})");if n>=0 {print("%\n",jv_raw(c[0].doc[0],n));}return false;}
cc_key :: (c:[]Cdp,key:string)->bool {b:[256]u8;j:[1]Jo;for k:0..<2 {jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"type");jo_str(j[..],ifx k==0 then "keyDown" else "keyUp");jo_key(j[..],"key");jo_str(j[..],key);if key==" " {jo_key(j[..],"code");jo_str(j[..],"Space");}jo_end(j[..]);if cdp_call(c,"Input.dispatchKeyEvent",jo_text(j[..]),30000)<0 {return false;}}return cc_eval(c,"key frame","coaxialClipStep(1,60).then(()=>true)");}
cc_capture :: (c:[]Cdp)->bool {return cc_eval(c,"source GPU crop","(async()=>{coaxial.renderCapture=null;if(!coaxial.captureFrame())return false;await coaxialClipStep(1,60);for(let i=0;i<100&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));let r=coaxial.renderCapture;if(r?.format!=='rgba8unorm')return false;let x=Math.floor(r.width/2)-32,y=Math.floor(r.height/2)-32,b=new Uint8Array(64*64*4);for(let j=0;j<64;j++)b.set(r.bytes.slice(((y+j)*r.width+x)*4,((y+j)*r.width+x+64)*4),j*256);let h=new Uint8Array(await crypto.subtle.digest('SHA-256',b));canyonPixels.push(Array.from(h,x=>x.toString(16).padStart(2,'0')).join(''));return true})()");}
cc_ready :: (c:[]Cdp)->bool {until:=proc_now_ms()+55000;while proc_now_ms()<until {n:=cdp_evaluate(c,"(async()=>!!globalThis.coaxial?.ready&&(await coaxialClipStep(1,60))===1&&coaxial.sceneReady)()");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {return true;}proc_sleep(100);}return false;}
cc_refused :: (c:[]Cdp)->bool {until:=proc_now_ms()+20000;while proc_now_ms()<until {n:=cdp_evaluate(c,"globalThis.coaxial?.guardProbe(0)===0&&coaxial.guardProbe(6)===1&&coaxial.guardProbe(7)===1&&globalThis.canyonErrors?.length===1&&canyonErrors[0]==='valleycanyon asset pack: asset pack SHA256 refused by Coax'");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {return true;}proc_sleep(100);}return cc_eval(c,"changed source bytes refused","false");}
cc_run :: (c:[]Cdp,url:string,phone:bool)->bool {
  _:=cdp_call(c,"Page.enable","",30000);b:[8192]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"source");jo_str(j[..],"globalThis.coaxialClip=true;globalThis.coaxialRenderCapture=true;globalThis.coaxialRenderCaptureFormat='rgba8unorm';globalThis.canyonPixels=[];globalThis.canyonErrors=[];globalThis.canyonGateMode='ok';globalThis.canyonRequests=0;const cf=fetch.bind(globalThis);globalThis.fetch=async(...a)=>{if(String(a[0]).endsWith('.pack')&&String(a[0]).includes('/private/valley-echo')){canyonRequests++;if(canyonGateMode==='missing')return new Response('',{status:404});let r=await cf(...a);if(canyonGateMode==='corrupt'){let b=new Uint8Array(await r.arrayBuffer());b[1000000]^=1;return new Response(b,{status:200})}return r}return cf(...a)};const ce=console.error;console.error=(...a)=>{canyonErrors.push(a.map(String).join(' '));ce(...a)}");jo_end(j[..]);if cdp_call(c,"Page.addScriptToEvaluateOnNewDocument",jo_text(j[..]),30000)<0 {return false;}
  _=cdp_call(c,"Emulation.setDeviceMetricsOverride",ifx phone then "{\"width\":390,\"height\":844,\"deviceScaleFactor\":1,\"mobile\":true}" else "{\"width\":1280,\"height\":800,\"deviceScaleFactor\":1,\"mobile\":false}",30000);
  if phone {_=cdp_call(c,"Emulation.setTouchEmulationEnabled","{\"enabled\":true,\"maxTouchPoints\":1}",30000);}
  jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"url");jo_str(j[..],url);jo_end(j[..]);if cdp_call(c,"Page.navigate",jo_text(j[..]),30000)<0 || !cc_ready(c) {not_ready:=cc_eval(c,"pack readiness","false");return false;}
  if !cc_eval(c,"exact full source and native matrix words","(async()=>{for(let i=0;i<100&&coaxial.guardProbe(0)!==1;i++){await coaxialClipStep(1,60);await new Promise(r=>setTimeout(r,10))}let r=await(await fetch('/assets/valley/canyon-poses.json')).json();return coaxial.guardProbe(0)===1&&coaxial.guardProbe(1)===1999990&&(coaxial.guardProbe(4)>>>0)<4000000000&&coaxial.guardProbe(5)<21000000&&r.pose_words.every((v,i)=>v===(coaxial.guardProbe(10+i)>>>0))})()") {return false;}
  if !cc_eval(c,"walk is the default","coaxial.guardProbe(65)===1&&coaxial.guardProbe(64)===0") {return false;}
  if !cc_eval(c,"remember starting feet","(globalThis.canyonFeet=[60,61,62].map(i=>coaxial.guardProbe(i)),true)") {return false;}
  if cdp_call(c,"Input.dispatchKeyEvent","{\"type\":\"keyDown\",\"key\":\"w\",\"code\":\"KeyW\"}",30000)<0 || !cc_eval(c,"shared walking advances in Wasm","(async()=>{await coaxialClipStep(30,64);return coaxial.guardProbe(62)>canyonFeet[2]+100&&coaxial.guardProbe(63)===1&&coaxial.guardProbe(64)===0})()") || cdp_call(c,"Input.dispatchKeyEvent","{\"type\":\"keyUp\",\"key\":\"w\",\"code\":\"KeyW\"}",30000)<0 {return false;}
  if !cc_eval(c,"jump press","(globalThis.canyonFloor=coaxial.guardProbe(61),true)") || !cc_key(c," ") || !cc_eval(c,"shared jump rises","(async()=>{await coaxialClipStep(8,64);return coaxial.guardProbe(61)>canyonFloor+100&&coaxial.guardProbe(63)===0})()") || !cc_key(c,"r") || !cc_eval(c,"reset restores feet","[60,61,62].every((f,i)=>coaxial.guardProbe(f)===canyonFeet[i])")  {return false;}
  if phone {if cdp_call(c,"Emulation.setTouchEmulationEnabled","{\"enabled\":true,\"maxTouchPoints\":1}",30000)<0 || cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchStart\",\"touchPoints\":[{\"x\":80,\"y\":500,\"id\":1}]}",30000)<0 || cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchMove\",\"touchPoints\":[{\"x\":80,\"y\":440,\"id\":1}]}",30000)<0 || !cc_eval(c,"phone touch walks","(async()=>{await coaxialClipStep(20,64);return coaxial.guardProbe(62)>canyonFeet[2]+100})()") || cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchEnd\",\"touchPoints\":[]}",30000)<0 || !cc_key(c,"r") {return false;}}
  if !cc_key(c,"o") || !cc_eval(c,"orbit remains isolated","coaxial.guardProbe(65)===0&&coaxial.guardProbe(63)===0") || !cc_capture(c) {return false;}
  for k:0..<4 {if !cc_key(c,"v") || !cc_capture(c) {return false;}}if !cc_eval(c,"five source material diagnostics","new Set(canyonPixels).size===5") {return false;}
  if !cc_key(c,"i") || !cc_eval(c,"isolate actual instance 0","coaxial.guardProbe(3)===0&&coaxial.guardProbe(1)===999995") || !cc_capture(c) || !cc_key(c,"i") || !cc_eval(c,"isolate actual instance 1","coaxial.guardProbe(3)===1&&coaxial.guardProbe(1)===999995") || !cc_capture(c) || !cc_eval(c,"two distinct source placements","canyonPixels[5]!==canyonPixels[6]") || !cc_key(c,"r") || !cc_capture(c) || !cc_eval(c,"exact view reset","canyonPixels[0]===canyonPixels[7]") {return false;}
  if !cc_eval(c,"source GPU recovery","(async()=>{let before=await coaxial.stateDigest();coaxial.loseDevice();await new Promise(r=>setTimeout(r,10));for(let i=0;i<2000&&coaxial.gpuRecovery?.state!=='recovered';i++)await new Promise(r=>setTimeout(r,10));if(coaxial.gpuRecovery?.state!=='recovered'||await coaxial.stateDigest()!==before)return false;await coaxialClipStep(1,60);return coaxial.guardProbe(0)===1&&coaxial.guardProbe(1)===1999990&&canyonErrors.length===1&&canyonErrors.pop().startsWith('coaxial: GPU device lost (destroyed:')})()") || !cc_capture(c) || !cc_eval(c,"identical source maps and geometry after GPU loss","canyonPixels[0]===canyonPixels[8]&&canyonErrors.length===0") {return false;}
  n:=cdp_evaluate(c,"JSON.stringify({triangles:coaxial.guardProbe(1),submittedVertices:coaxial.guardProbe(5),declaredMeasuredBytes:coaxial.guardProbe(4),packRequests:canyonRequests,hashes:canyonPixels})");if n>=0 {print("Source observation % %\n",ifx phone then "phone" else "desktop",jv_raw(c[0].doc[0],n));}
  if !phone {
    // Reload the same module with a same-length byte edit in the vertex payload. The Coax pack gate must refuse before GPU upload.
    jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"source");jo_str(j[..],"globalThis.canyonGateMode='corrupt'");jo_end(j[..]);n=cdp_call(c,"Page.addScriptToEvaluateOnNewDocument",jo_text(j[..]),30000);if n<0 {return false;}
    _=cdp_call(c,"Page.reload","{\"ignoreCache\":true}",30000);if !cc_refused(c) {return false;}
  }
  print("PASS Canyon %: 1999990 source triangles, default shared walk/jump/key release/reset, native/Wasm source matrices, original 4K maps, five GPU views, isolated poses, exact reset and GPU loss recovery%\n",ifx phone then "phone" else "desktop",ifx phone then "" else ", same-length vertex corruption refused by Coax before upload");return true;
}
tool_main :: ()->int #export_c #effects(all) {a:[1]Args;if !args_load(a[..]) || args_count(a[..])<1 || args_count(a[..])>2 {return 2;}if args_count(a[..])==2 && args_at(a[..],1)!="phone" && args_at(a[..],1)!="desktop" {return 2;}for phone:0..<2 {if args_count(a[..])==2 && ((args_at(a[..],1)=="phone" && phone==0) || (args_at(a[..],1)=="desktop" && phone==1)) {continue;}c:[1]Cdp;if !cdp_launch_background(c[..],ifx phone==0 then 1280 else 390,ifx phone==0 then 800 else 844,"valley-canyon-") {return 1;}path:[4096]u8;url:=fs_join(args_at(a[..],0),"worlds/valley-canyon?pack=valley-echo",path[..]);ok:=cc_run(c[..],url,phone==1);cdp_close(c[..]);if !ok {return 1;}}return 0;}
