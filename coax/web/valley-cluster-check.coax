   if ok {n:=cdp_evaluate(c[..],"(async()=>{const start=performance.now();await worldStep(30,Infinity);return JSON.stringify({mode:coaxial.guardProbe(14),serialFrames:30,serialMs:performance.now()-start,colorTriangles:coaxial.guardProbe(1),shadowTriangles:coaxial.guardProbe(9),colorDraws:coaxial.guardProbe(8),shadowDraws:coaxial.guardProbe(10),nodes:coaxial.guardProbe(12),rejected:coaxial.guardProbe(13),fastInstances:coaxial.guardProbe(18),fallbacks:coaxial.guardProbe(15),bytes:coaxial.guardProbe(4)*1024})})()");if n<0 {ok=false;}else {print("View % % pixels=%\n",station,jv_raw(c[0].doc[0],n),cast(string)hash[..]);}}
  }
 }
