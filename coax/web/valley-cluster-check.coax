nc_eval :: (c:[]Cdp,js:string)->bool {n:=cdp_evaluate(c,js);if n>=0 && jv_raw(c[0].doc[0],n)=="true" {return true;}print("FAIL browser expression %\n",js);return false;}
nc_key :: (c:[]Cdp,key:string)->bool {b:[256]u8;j:[1]Jo;for k:0..<2 {jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"type");jo_str(j[..],ifx k==0 then "keyDown" else "keyUp");jo_key(j[..],"key");jo_str(j[..],key);jo_end(j[..]);if cdp_call(c,"Input.dispatchKeyEvent",jo_text(j[..]),30000)<0 {print("FAIL key %: %\n",key,cdp_error(c));return false;}}return nc_eval(c,"worldStep(1,Infinity).then(()=>true)");}
nc_mode :: (c:[]Cdp,mode:int)->bool {for k:0..<3 {n:=cdp_evaluate(c,"coaxial.guardProbe(14)");if n>=0 && jv_int(c[0].doc[0],n,-1)==mode {return true;}if !nc_key(c,"g") {return false;}}print("FAIL geometry mode %: %\n",mode,cdp_error(c));return false;}
nc_capture :: (c:[]Cdp,out:[]u8)->int {n:=cdp_evaluate(c,"(async()=>{coaxial.renderCapture=null;if(!coaxial.captureFrame())return '';await worldStep(1,Infinity);for(let i=0;i<200&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));const r=coaxial.renderCapture;if(r?.format!=='rgba8unorm'||r.width!==2560||r.height!==1600||r.bytes.length!==r.width*r.height*4)return '';return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new Uint8Array(r.bytes))),x=>x.toString(16).padStart(2,'0')).join('')})()");if n<0 {print("FAIL capture CDP: %\n",cdp_error(c));return 0;}s:=jv_raw(c[0].doc[0],n);if s.count!=64 {print("FAIL capture returned %\n",s);return 0;}for v,k:s {out[k]=v;}return 64;}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || (args_count(a[..])<1 || args_count(a[..])>3) {return 2;}recover:=args_count(a[..])==2 && args_at(a[..],1)=="--recover";inspect:=args_count(a[..])==3 && args_at(a[..],1)=="--inspect";c:[1]Cdp;if !cdp_launch_background(c[..],1280,800,"valley-clusters-") {print("FAIL headless launch: %\n",cdp_error(c[..]));return 1;}
