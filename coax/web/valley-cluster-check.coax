 b:[8192]u8;path:[4096]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"url");jo_str(j[..],fs_join(args_at(a[..],0),"worlds/valley-world?pack=valley-world",path[..]));jo_end(j[..]);_=cdp_call(c[..],"Page.navigate",jo_text(j[..]),30000);
 ready:=false;until:=proc_now_ms()+150000;while proc_now_ms()<until {n:=cdp_evaluate(c[..],"(async()=>{if(!globalThis.coaxial?.ready)return false;await worldStep(1,Infinity);return coaxial.sceneReady&&coaxial.guardProbe(0)===1})()");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {ready=true;break;}proc_sleep(100);}
 if !ready {print("FAIL cluster scene ready\n");cdp_close(c[..]);return 1;}
 tool_errln("Headless world ready; comparing cuts");ok:=nc_eval(c[..],"coaxial.guardProbe(16)===3819380&&coaxial.guardProbe(11)===24921&&coaxial.guardProbe(17)===49712&&coaxial.guardProbe(3)===27501&&coaxial.guardProbe(72)===334");
 if inspect {
  hash:[64]u8;ok=ok && nc_mode(c[..],2) && nc_key(c[..],"l") && nc_capture(c[..],hash[..])==64;
  if ok {n:=cdp_evaluate(c[..],"(()=>{const r=coaxial.renderCapture;const canvas=document.createElement('canvas');canvas.width=r.width;canvas.height=r.height;canvas.getContext('2d').putImageData(new ImageData(new Uint8ClampedArray(r.bytes),r.width,r.height),0,0);const display=document.createElement('canvas');display.width=innerWidth;display.height=innerHeight;display.getContext('2d').drawImage(canvas,0,0,display.width,display.height);return display.toDataURL('image/png').split(',')[1]})()");png:[8388608]u8;size:=ifx n>=0 then b64_decode(jv_raw(c[0].doc[0],n),png[..]) else -1;ok=size>0 && fs_write(args_at(a[..],2),cast(string)png[0..<size]);if !ok {print("FAIL inspector PNG node=% decoded=% error=%\n",n,size,cdp_error(c[..]));if n>=0 {print("PNG encoded bytes=%\n",jv_raw(c[0].doc[0],n).count);}}}
  cdp_close(c[..]);if !ok {return 1;}print("PASS admitted source hierarchy and geometry inspector captured\n");return 0;
 }
 if recover {
  before:[64]u8;after:[64]u8;ok=ok && nc_key(c[..],"5") && nc_mode(c[..],2) && nc_capture(c[..],before[..])==64;
  if ok {ok=nc_eval(c[..],"(async()=>{const before=await coaxial.stateDigest();coaxial.loseDevice();await new Promise(r=>setTimeout(r,10));for(let i=0;i<6000&&!['recovered','failed'].includes(coaxial.gpuRecovery?.state);i++)await new Promise(r=>setTimeout(r,20));return coaxial.gpuRecovery?.state==='recovered'&&await coaxial.stateDigest()===before})()") && nc_capture(c[..],after[..])==64 && cast(string)before[..]==cast(string)after[..] && nc_eval(c[..],"clusterErrors.length===1&&clusterErrors[0].startsWith('coaxial: GPU device lost')&&coaxial.guardProbe(16)===3819380&&coaxial.guardProbe(18)>0");}
  cdp_close(c[..]);if !ok {print("FAIL hierarchy device recovery\n");return 1;}print("PASS complete source hierarchy, state and full frame pixels survive device replacement: %\n",cast(string)before[..]);return 0;
