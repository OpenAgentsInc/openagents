// Actual muted headless WebGPU. Tolerances are fixed before promoting the Q16 source page.
#import "Basic";
#load "../lib/net/cdp.coax";
dc_eval :: (c:[]Cdp,label:string,js:string)->bool {n:=cdp_evaluate(c,js);if n>=0 && jv_raw(c[0].doc[0],n)=="true" {return true;}print("FAIL %: %\n",label,cdp_error(c));n=cdp_evaluate(c,"JSON.stringify({ready:coaxial.sceneReady,probes:Array.from({length:26},(_,i)=>coaxial.guardProbe(i)),errors:detailErrors})");if n>=0 {print("%\n",jv_raw(c[0].doc[0],n));}return false;}
dc_key :: (c:[]Cdp,key:string)->bool {b:[256]u8;j:[1]Jo;for k:0..<2 {jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"type");jo_str(j[..],ifx k==0 then "keyDown" else "keyUp");jo_key(j[..],"key");jo_str(j[..],key);jo_end(j[..]);if cdp_call(c,"Input.dispatchKeyEvent",jo_text(j[..]),30000)<0 {return false;}}return dc_eval(c,"key frame","worldStep(1).then(()=>true)");}
dc_mode :: (c:[]Cdp,mode:int)->bool {for k:0..<3 {n:=cdp_evaluate(c,"coaxial.guardProbe(19)");if n>=0 && jv_int(c[0].doc[0],n,-1)==mode {return true;}if !dc_key(c,"k") {return false;}}return false;}
dc_capture :: (c:[]Cdp,name:string)->bool {b:[2048]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_str(j[..],name);script:[4096]u8;at:=0;for part:[3]string.["(async()=>{coaxial.renderCapture=null;if(!coaxial.captureFrame())return false;await worldStep(1);for(let i=0;i<200&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));const r=coaxial.renderCapture;if(r?.format!=='rgba8unorm'||r.width!==2560||r.height!==1600)return false;detailFrames[",jo_text(j[..]),"]=new Uint8Array(r.bytes);return true})()"] {for v:part {script[at]=v;at+=1;}}return dc_eval(c,"complete readback",cast(string)script[0..<at]);}
dc_shot :: (c:[]Cdp,path:string)->bool {png:[8388608]u8;n:=cdp_evaluate(c,"(()=>{const r=coaxial.renderCapture;const a=document.createElement('canvas');a.width=r.width;a.height=r.height;a.getContext('2d').putImageData(new ImageData(new Uint8ClampedArray(r.bytes),r.width,r.height),0,0);const b=document.createElement('canvas');b.width=innerWidth;b.height=innerHeight;b.getContext('2d').drawImage(a,0,0,b.width,b.height);return b.toDataURL('image/png').split(',')[1]})()");size:=ifx n>=0 then b64_decode(jv_raw(c[0].doc[0],n),png[..]) else -1;return size>0 && fs_write(path,cast(string)png[0..<size]);}
dc_request :: (c:[]Cdp,id:string,corrupt:bool) {b:[1024]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"requestId");jo_str(j[..],id);if corrupt {jo_key(j[..],"responseCode");jo_int(j[..],200);jo_key(j[..],"body");jo_str(j[..],"eA==");}jo_end(j[..]);sent:=cdp_send(c,ifx corrupt then "Fetch.fulfillRequest" else "Fetch.continueRequest",jo_text(j[..]));}
tool_main :: ()->int #export_c #effects(all) {
 args:[1]Args;if !args_load(args[..]) || args_count(args[..])<1 || args_count(args[..])>3 {return 2;}mode:=ifx args_count(args[..])>=2 then args_at(args[..],1) else "--compare";c:[1]Cdp;if !cdp_launch_background(c[..],1280,800,"valley-detail-") {print("FAIL launch %\n",cdp_error(c[..]));return 1;}
 _:=cdp_call(c[..],"Page.enable","",30000);_=cdp_call(c[..],"Emulation.setDeviceMetricsOverride","{\"width\":1280,\"height\":800,\"deviceScaleFactor\":1,\"mobile\":false}",30000);_=cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument","{\"source\":\"globalThis.coaxialClip=true;globalThis.worldStep=async(n,fps=Infinity)=>{for(let i=0;i<n;i++)await coaxialClipStep(1,fps);return 1};globalThis.coaxialRenderCapture=true;globalThis.coaxialRenderCaptureFormat='rgba8unorm';globalThis.detailErrors=[];globalThis.detailFrames={};const old=console.error;console.error=(...a)=>{detailErrors.push(a.join(' '));old(...a)}\"}",30000);
 if mode=="--missing" {_=cdp_call(c[..],"Network.enable","",30000);_=cdp_call(c[..],"Network.setBlockedURLs","{\"urls\":[\"*valley-detail*.page\"]}",30000);}
 if mode=="--corrupt" || mode=="--held" || mode=="--held-recover" {_=cdp_call(c[..],"Fetch.enable","{\"patterns\":[{\"urlPattern\":\"*valley-detail*.page\"}]}",30000);}
 b:[8192]u8;path:[4096]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"url");jo_str(j[..],fs_join(args_at(args[..],0),"worlds/valley-world?pack=valley-world",path[..]));jo_end(j[..]);_=cdp_call(c[..],"Page.navigate",jo_text(j[..]),30000);
 held:[4][256]u8;held_n:[4]int;if mode=="--corrupt" || mode=="--held" || mode=="--held-recover" {for k:0..<2 {if !cdp_wait_event(c[..],"Fetch.requestPaused",60000) {cdp_close(c[..]);return 1;}id:=jv_raw(c[0].doc[0],jv_path(c[0].doc[0],0,"params.requestId"));if id.count==0 || id.count>256 {cdp_close(c[..]);return 1;}held_n[k]=id.count;for v,i:id {held[k][i]=v;}if mode=="--corrupt" {dc_request(c[..],cast(string)held[k][0..<held_n[k]],true);}}}
 ready:=false;until:=proc_now_ms()+180000;while proc_now_ms()<until {n:=cdp_evaluate(c[..],"(async()=>{if(!globalThis.coaxial?.ready)return false;await worldStep(1);return coaxial.sceneReady&&coaxial.guardProbe(0)===1})()");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {ready=true;break;}n=cdp_evaluate(c[..],"globalThis.detailErrors?.length>0");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {startup_bad:=dc_eval(c[..],"startup console","false");break;}proc_sleep(100);}if !ready {print("FAIL scene readiness %\n",cdp_error(c[..]));cdp_close(c[..]);return 1;}
 tool_errln("Source world ready; checking source page");ok:=true;
 if mode=="--held-recover" {
  ok=dc_eval(c[..],"root remains visible while pages wait","coaxial.guardProbe(21)===0&&coaxial.guardProbe(23)===0&&detailErrors.length===0") && dc_capture(c[..],"fallback") && dc_eval(c[..],"device replacement starts before source arrival","(async()=>{globalThis.heldState=await coaxial.stateDigest();coaxial.loseDevice();return true})()");
  for k:2..<4 {if !cdp_wait_event(c[..],"Fetch.requestPaused",60000) {cdp_close(c[..]);return 1;}id:=jv_raw(c[0].doc[0],jv_path(c[0].doc[0],0,"params.requestId"));held_n[k]=id.count;if id.count==0 || id.count>256 {cdp_close(c[..]);return 1;}for v,i:id {held[k][i]=v;}}
  ok=ok && dc_eval(c[..],"held pages cannot block root recovery","(async()=>{const until=performance.now()+60000;while(!['recovered','failed'].includes(coaxial.gpuRecovery?.state)&&performance.now()<until)await new Promise(r=>setTimeout(r,20));return coaxial.gpuRecovery?.state==='recovered'&&await coaxial.stateDigest()===heldState})()");
  for k:0..<2 {dc_request(c[..],cast(string)held[k][0..<held_n[k]],true);}
  ok=ok && dc_eval(c[..],"retired corrupt completion cannot publish or refuse on the replacement","(async()=>{await new Promise(r=>setTimeout(r,300));await worldStep(1);return coaxial.guardProbe(21)===0&&coaxial.guardProbe(25)===0})()");
  for k:2..<4 {dc_request(c[..],cast(string)held[k][0..<held_n[k]],false);}
 }
 if mode=="--missing" || mode=="--corrupt" || mode=="--held" {ok=dc_eval(c[..],"complete source fallback while both pages are unavailable","coaxial.guardProbe(21)===0&&coaxial.guardProbe(23)===0&&coaxial.guardProbe(1)>100000&&coaxial.guardProbe(72)===334&&detailErrors.length===0") && dc_capture(c[..],"fallback");if mode!="--held" {if mode=="--corrupt" {ok=ok && dc_eval(c[..],"both corrupt identities refused","coaxial.guardProbe(25)===2");}cdp_close(c[..]);if !ok {return 1;}print("PASS % optional source pages preserve the complete original world and Echo\n",mode);return 0;}for k:0..<2 {dc_request(c[..],cast(string)held[k][0..<held_n[k]],false);}}
 until=proc_now_ms()+60000;while proc_now_ms()<until {n:=cdp_evaluate(c[..],"coaxial.guardProbe(21)===3");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {break;}proc_sleep(100);}
 ok=ok && dc_eval(c[..],"complete page arrival reaches the next frame","worldStep(1).then(()=>true)") && dc_eval(c[..],"both exact page identities and one source replacement","coaxial.guardProbe(21)===3&&coaxial.guardProbe(23)===1997616&&coaxial.guardProbe(22)>=0&&coaxial.guardProbe(25)===0");
 if mode=="--held" || mode=="--held-recover" {cdp_close(c[..]);if !ok {return 1;}print("PASS %: complete root renders while pages wait; only current complete pages replace it\n",mode);return 0;}
 if mode=="--recover" {for profile:1..<3 {ok=ok && dc_mode(c[..],profile) && dc_capture(c[..],"before");if ok {ok=dc_eval(c[..],"exact source state survives replacement","(async()=>{const before=await coaxial.stateDigest();coaxial.loseDevice();await new Promise(r=>setTimeout(r,10));const until=performance.now()+60000;while(!['recovered','failed'].includes(coaxial.gpuRecovery?.state)&&performance.now()<until)await new Promise(r=>setTimeout(r,20));return coaxial.gpuRecovery?.state==='recovered'&&await coaxial.stateDigest()===before})()") && dc_capture(c[..],"after") && dc_eval(c[..],"every source frame byte survives replacement","detailFrames.before.length===detailFrames.after.length&&detailFrames.before.every((v,i)=>v===detailFrames.after[i])&&coaxial.guardProbe(21)===3&&coaxial.guardProbe(23)===1997616");}}cdp_close(c[..]);if !ok {return 1;}print("PASS Q16 and exact F32 source state and all frame bytes survive device replacement\n");return 0;}
 if ok && mode=="--inspect" {ok=dc_key(c[..],"l") && dc_capture(c[..],"inspect") && args_count(args[..])==3 && dc_shot(c[..],args_at(args[..],2));cdp_close(c[..]);if !ok {return 1;}print("PASS full source page inspector\n");return 0;}
 for station:0..<4 {if !ok {break;}ok=dc_key(c[..],[4]string.["2","3","4","5"][station]) && dc_mode(c[..],0) && dc_capture(c[..],"base") && dc_mode(c[..],1) && dc_capture(c[..],"quant") && dc_mode(c[..],2) && dc_capture(c[..],"raw");if !ok {break;}
  // Three visible-detail observations plus the unchanged north occlusion control. Image tolerances
  // are identical at all four; north is explicitly not evidence of added visible source detail.
  ok=dc_eval(c[..],"Q16 source image tolerance fixed before promotion","(()=>{const q=detailFrames.quant,r=detailFrames.raw,b=detailFrames.base;let sum=0,bad=0,changed=0;for(let i=0;i<q.length;i+=4){let peak=0,delta=0;for(let k=0;k<3;k++){const d=Math.abs(q[i+k]-r[i+k]);sum+=d;peak=Math.max(peak,d);delta=Math.max(delta,Math.abs(r[i+k]-b[i+k]));}if(peak>8)bad++;if(delta>0)changed++;}globalThis.detailMetrics={meanRgb:sum/(q.length/4*3),badFraction:bad/(q.length/4),changedPixels:changed};return detailMetrics.meanRgb<=0.25&&detailMetrics.badFraction<=0.001})()");if station<3 {ok=ok && dc_eval(c[..],"source detail is visible in the three qualified views","coaxial.guardProbe(23)===1997616&&detailMetrics.changedPixels>=1000");}n:=cdp_evaluate(c[..],"JSON.stringify({metrics:detailMetrics,pageMask:coaxial.guardProbe(21),instance:coaxial.guardProbe(22),fineTriangles:coaxial.guardProbe(23),colorTriangles:coaxial.guardProbe(1),shadowTriangles:coaxial.guardProbe(9),bytes:coaxial.guardProbe(4)*1024})");if n>=0 {print("View % %\n",station,jv_raw(c[0].doc[0],n));}
 }
 if ok {ok=dc_eval(c[..],"clean WebGPU source page submission","detailErrors.length===0&&coaxial.frameQueue().bounded&&coaxial.frameQueue().pending<=2");}cdp_close(c[..]);if !ok {return 1;}print("PASS Q16/F32 tolerance in four views: three visible source-detail observations and north occlusion control\n");return 0;
}
