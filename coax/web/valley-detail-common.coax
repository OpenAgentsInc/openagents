// Actual muted headless WebGPU. Tolerances are fixed before promoting the Q16 source page.
#import "Basic";
#load "../lib/net/cdp.coax";
dc_eval :: (c:[]Cdp,label:string,js:string)->bool {n:=cdp_evaluate(c,js);if n>=0 && jv_raw(c[0].doc[0],n)=="true" {return true;}print("FAIL %: %\n",label,cdp_error(c));n=cdp_evaluate(c,"JSON.stringify({ready:coaxial.sceneReady,probes:Array.from({length:26},(_,i)=>coaxial.guardProbe(i)),errors:detailErrors})");if n>=0 {print("%\n",jv_raw(c[0].doc[0],n));}return false;}
dc_key :: (c:[]Cdp,key:string)->bool {b:[256]u8;j:[1]Jo;for k:0..<2 {jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"type");jo_str(j[..],ifx k==0 then "keyDown" else "keyUp");jo_key(j[..],"key");jo_str(j[..],key);jo_end(j[..]);if cdp_call(c,"Input.dispatchKeyEvent",jo_text(j[..]),30000)<0 {return false;}}return dc_eval(c,"key frame","worldStep(1).then(()=>true)");}
dc_mode :: (c:[]Cdp,mode:int)->bool {for k:0..<3 {n:=cdp_evaluate(c,"coaxial.guardProbe(19)");if n>=0 && jv_int(c[0].doc[0],n,-1)==mode {return true;}if !dc_key(c,"k") {return false;}}return false;}
dc_capture :: (c:[]Cdp,name:string)->bool {b:[2048]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_str(j[..],name);script:[4096]u8;at:=0;for part:[3]string.["(async()=>{coaxial.renderCapture=null;if(!coaxial.captureFrame())return false;await worldStep(1);for(let i=0;i<200&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));const r=coaxial.renderCapture;if(r?.format!=='rgba8unorm'||r.width!==2560||r.height!==1600)return false;detailFrames[",jo_text(j[..]),"]=new Uint8Array(r.bytes);return true})()"] {for v:part {script[at]=v;at+=1;}}return dc_eval(c,"complete readback",cast(string)script[0..<at]);}
dc_shot :: (c:[]Cdp,path:string)->bool {png:[8388608]u8;n:=cdp_evaluate(c,"(()=>{const r=coaxial.renderCapture;const a=document.createElement('canvas');a.width=r.width;a.height=r.height;a.getContext('2d').putImageData(new ImageData(new Uint8ClampedArray(r.bytes),r.width,r.height),0,0);const b=document.createElement('canvas');b.width=innerWidth;b.height=innerHeight;b.getContext('2d').drawImage(a,0,0,b.width,b.height);return b.toDataURL('image/png').split(',')[1]})()");size:=ifx n>=0 then b64_decode(jv_raw(c[0].doc[0],n),png[..]) else -1;return size>0 && fs_write(path,cast(string)png[0..<size]);}
dc_request :: (c:[]Cdp,id:string,corrupt:bool) {b:[1024]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"requestId");jo_str(j[..],id);if corrupt {jo_key(j[..],"responseCode");jo_int(j[..],200);jo_key(j[..],"body");jo_str(j[..],"eA==");}jo_end(j[..]);sent:=cdp_send(c,ifx corrupt then "Fetch.fulfillRequest" else "Fetch.continueRequest",jo_text(j[..]));}
