// Actual private face pack -> source-rate Wasm playback -> WebGPU captures/recovery.
#import "Basic";
#load "../lib/net/cdp.coax";
#load "../lib/sys/fs.coax";
fc_eval :: (c:[]Cdp,label:string,js:string)->bool {n:=cdp_evaluate(c,js);if n>=0 && jv_raw(c[0].doc[0],n)=="true" {return true;}print("FAIL %: %\n",label,cdp_error(c));n=cdp_evaluate(c,"JSON.stringify({ready:coaxial?.sceneReady,probes:Array.from({length:5},(_,i)=>coaxial?.guardProbe(87+i)),errors:faceErrors,recovery:coaxial?.gpuRecovery,hashes:faceHashes})");if n>=0 {print("%\n",jv_raw(c[0].doc[0],n));}return false;}
fc_key :: (c:[]Cdp,key:string)->bool {b:[256]u8;j:[1]Jo;for phase:[2]string.["keyDown","keyUp"] {jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"type");jo_str(j[..],phase);jo_key(j[..],"key");jo_str(j[..],key);jo_end(j[..]);if cdp_call(c,"Input.dispatchKeyEvent",jo_text(j[..]),30000)<0 {return false;}}return true;}
fc_hash :: (c:[]Cdp)->bool {return fc_eval(c,"actual face GPU crop","(async()=>{coaxial.renderCapture=null;coaxial.captureFrame();await coaxialClipStep(1,60);for(let i=0;i<100&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));let r=coaxial.renderCapture;if(!r?.bytes)return false;let x=Math.floor(r.width*.34),y=Math.floor(r.height*.42),w=Math.floor(r.width*.32),h=Math.floor(r.height*.50),b=new Uint8Array(w*h*4);for(let j=0;j<h;j++)b.set(r.bytes.slice(((y+j)*r.width+x)*4,((y+j)*r.width+x+w)*4),j*w*4);let hash=await crypto.subtle.digest('SHA-256',b);faceHashes.push(Array.from(new Uint8Array(hash),x=>x.toString(16).padStart(2,'0')).join(''));return true})()");}
fc_shot :: (c:[]Cdp,root:string,name:string)->bool {bytes:[8388608]u8;path:[4096]u8;n:=cdp_screenshot(c,bytes[..]);return n>0 && fs_write(fs_join(root,name,path[..]),cast(string)bytes[0..<n]);}
tool_main :: ()->int #export_c {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=2 {return 2;}c:[1]Cdp;if !cdp_launch_background(c[..],1280,800,"echo-face-") {return 1;}
 _:=cdp_call(c[..],"Page.enable","",30000);setup:="globalThis.coaxialClip=true;globalThis.coaxialRenderCapture=true;globalThis.coaxialRenderCaptureFormat='rgba8unorm';globalThis.faceHashes=[];globalThis.faceErrors=[];const ce=console.error;console.error=(...a)=>{faceErrors.push(a.map(String).join(' '));ce(...a)}";b:[4096]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"source");jo_str(j[..],setup);jo_end(j[..]);_=cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument",jo_text(j[..]),30000);
 jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"url");jo_str(j[..],args_at(a[..],0));jo_end(j[..]);_=cdp_call(c[..],"Page.navigate",jo_text(j[..]),30000);
 ready:=false;until:=proc_now_ms()+60000;while proc_now_ms()<until {n:=cdp_evaluate(c[..],"(async()=>!!coaxial?.ready&&(await coaxialClipStep(1,60))===1&&coaxial.sceneReady)()");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {ready=true;break;}proc_sleep(100);}
 ok:=ready && fc_key(c[..],"f") && fc_eval(c[..],"TF0100 performance view","coaxial.guardProbe(91)===1&&coaxial.guardProbe(87)===4") && fc_key(c[..],"b") && fc_hash(c[..]) && fc_shot(c[..],args_at(a[..],1),"neutral.png") && fc_key(c[..],"b") && fc_eval(c[..],"source frames advance","(async()=>{await coaxialClipStep(12,24);return coaxial.guardProbe(88)>=11&&coaxial.guardProbe(88)<=12&&coaxial.guardProbe(90)===1000})()") && fc_hash(c[..]) && fc_shot(c[..],args_at(a[..],1),"tf0100-frame12.png") && fc_eval(c[..],"second source pose","coaxialClipStep(16,24).then(()=>true)") && fc_hash(c[..]) && fc_shot(c[..],args_at(a[..],1),"tf0100-frame28.png") && fc_key(c[..],"p") && fc_eval(c[..],"face changes include brows eyes jaw and lips","new Set(faceHashes).size===3&&faceErrors.length===0") && fc_hash(c[..]) && fc_eval(c[..],"paused face","coaxialClipStep(12,24).then(()=>true)") && fc_hash(c[..]) && fc_eval(c[..],"pause retains exact face pixels","faceHashes[3]===faceHashes[4]");
 if ok {ok=fc_eval(c[..],"face GPU recovery retains source frame and weights","(async()=>{let state=await coaxial.stateDigest();coaxial.loseDevice();for(let i=0;i<2000&&coaxial.gpuRecovery?.state!=='recovered';i++)await new Promise(r=>setTimeout(r,10));if(coaxial.gpuRecovery?.state!=='recovered'||await coaxial.stateDigest()!==state)return false;await coaxialClipStep(1,60);return coaxial.sceneReady&&faceErrors.length===1&&faceErrors.pop().startsWith('coaxial: GPU device lost (destroyed:')})()") && fc_hash(c[..]) && fc_eval(c[..],"identical face after recovery","faceHashes[4]===faceHashes[5]") && fc_key(c[..],"b") && fc_hash(c[..]) && fc_eval(c[..],"zero weights restore exact neutral face","faceHashes[0]===faceHashes[6]") && fc_key(c[..],"]") && fc_eval(c[..],"next source clip","coaxial.guardProbe(87)===5");}
 n:=cdp_evaluate(c[..],"JSON.stringify({hashes:faceHashes,errors:faceErrors,recovery:coaxial.gpuRecovery})");if n>=0 {print("Face observation %\n",jv_raw(c[0].doc[0],n));}cdp_close(c[..]);if ok {print("PASS Slay face: source frame samples, visible moving face, exact neutral/pause and GPU recovery\n");}return ifx ok then 0 else 1;
}
