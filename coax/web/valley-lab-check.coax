  if !vl_key(c,"b","KeyB",true) || !vl_key(c,"b","KeyB",false) || !vl_eval(c,"(async()=>{for(let i=0;i<80&&coaxial.guardProbe(54)<valleyRockBaseRefusals+2;i++){await coaxialClipStep(1,60);await new Promise(r=>setTimeout(r,10))}return coaxial.guardProbe(50)===3072&&coaxial.guardProbe(52)===0&&coaxial.guardProbe(54)>=valleyRockBaseRefusals+2})()") {return false;}
  if !vl_key(c,"b","KeyB",true) || !vl_key(c,"b","KeyB",false) || !vl_eval(c,"(async()=>{for(let i=0;i<80&&coaxial.guardProbe(52)!==256;i++){await coaxialClipStep(1,60);await new Promise(r=>setTimeout(r,10))}await coaxialClipStep(1,60);let before=await coaxial.stateDigest();coaxial.loseDevice();await new Promise(r=>setTimeout(r,10));for(let i=0;i<300&&(coaxial.gpuRecovery?.state!=='recovered'||!coaxial.sceneReady);i++)await new Promise(r=>setTimeout(r,10));if(await coaxial.stateDigest()!==before)return false;await coaxialClipStep(1,60);return coaxial.guardProbe(50)===3070&&coaxial.guardProbe(52)===256&&valleyErrors.length===1&&valleyErrors.pop().startsWith('coaxial: GPU device lost (destroyed:')})()") || !vl_rock_capture(c) || !vl_eval(c,"valleyPixels[18]===valleyPixels[20]") {return false;}
  print("PASS Valley real-rock parent %: original 3072->3070, boundary star 6->4, conservative LOD, real HTTP missing/corrupt fallback, 255/256-byte admission, exact unpaged/paged GPU crop and device-loss recovery\n",ifx phone then "phone" else "desktop");
  perf:=cdp_evaluate(c,"(async()=>{let samples=[];for(let i=0;i<30;i++){let t=performance.now();await coaxialClipStep(1,60);samples.push(performance.now()-t)}samples.sort((a,b)=>a-b);return JSON.stringify({scope:'30 static paged-rock-parent frames, CPU submission plus GPU queue completion, not GPU timestamps or route FPS',viewport:[innerWidth,innerHeight],triangles:coaxial.guardProbe(50),medianMs:samples[15],p95Ms:samples[28],p99Ms:samples[29]})})()");
  if perf<0 {return false;}print("Valley fenced frame observation: %\n",jv_raw(c[0].doc[0],perf));
  print("PASS Valley asset/geometry %: stations, actual index pulling, view modes, three native/Wasm SHA256 matches, bounded replacement and %\n",ifx phone then "phone" else "desktop",ifx phone then "touch station/detail controls" else "keyboard controls");
  if !vl_eval(c,"document.querySelector('meta[name=robots]')?.content==='noindex, nofollow' && valleyErrors.length===0 && coaxial.guardProbe(5)>600") {return false;}
  print("PASS Valley Lab %: direct route, rendered geometry, WASD, jump/land, reset, %, noindex, no console errors\n",ifx phone then "phone" else "desktop",ifx phone then "actual touch movement" else "keyboard controls");return true;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {return 2;}
  for phone:0..<2 {
    c:[1]Cdp;if !cdp_launch_background(c[..],ifx phone==1 then 390 else 1280,ifx phone==1 then 844 else 800,"valley-lab-check-") {return 1;}
    p:[4096]u8;url:=fs_join(args_at(a[..],0),"worlds/valley-lab",p[..]);ok:=vl_run(c[..],url,phone==1);
    if !ok {n:=cdp_evaluate(c[..],"JSON.stringify({ready:globalThis.coaxial?.ready,scene:globalThis.coaxial?.sceneReady,pose:Array.from({length:6},(_,i)=>globalThis.coaxial?.guardProbe(i)),mode:globalThis.coaxial?.guardProbe(7),hierarchy:Array.from({length:7},(_,i)=>globalThis.coaxial?.guardProbe(30+i)),captures:globalThis.valleyPixels?.length,pages:Array.from({length:11},(_,i)=>globalThis.coaxial?.guardProbe(50+i)),pageRequests:globalThis.valleyPageGate?.requests,errors:globalThis.valleyErrors,text:document.body.innerText.slice(0,300)})");if n>=0 {print("FAIL %: %\n",ifx phone==1 then "phone" else "desktop",jv_raw(c[0].doc[0],n));}}
    cdp_close(c[..]);if !ok {return 1;}
  }return 0;
}
