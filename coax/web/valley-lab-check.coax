// Actual muted headless Valley Lab: route -> Wasm -> input -> shared walker -> GPU.
// coax/web/tool.sh valley-lab-check http://127.0.0.1:8891
#import "Basic";
#load "../lib/net/cdp.coax";
vl_eval :: (c:[]Cdp,js:string)->bool {
  n:=cdp_evaluate(c,js);return n>=0 && jv_raw(c[0].doc[0],n)=="true";
}
vl_param :: (c:[]Cdp,method:string,key:string,value:string)->bool {
  b:[4096]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],key);jo_str(o[..],value);jo_end(o[..]);
  return cdp_call(c,method,jo_text(o[..]),30000)>=0;
}
vl_key :: (c:[]Cdp,key:string,code:string,down:bool)->bool {
  b:[1024]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_obj(o[..]);
  jo_key(o[..],"type");jo_str(o[..],ifx down then "keyDown" else "keyUp");jo_key(o[..],"key");jo_str(o[..],key);
  jo_key(o[..],"code");jo_str(o[..],code);jo_end(o[..]);return cdp_call(c,"Input.dispatchKeyEvent",jo_text(o[..]),30000)>=0;
}
vl_capture :: (c:[]Cdp)->bool {
  return vl_eval(c,"(async()=>{coaxial.renderCapture=null;if(!coaxial.captureFrame())return false;await coaxialClipStep(1,60);for(let i=0;i<100&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));let r=coaxial.renderCapture;if(r?.format!=='rgba8unorm')return false;let b=new Uint8Array(16*16*4),x=Math.floor(r.width/2)-8,y=Math.floor(r.height/2)-8;for(let j=0;j<16;j++)b.set(r.bytes.slice(((y+j)*r.width+x)*4,((y+j)*r.width+x+16)*4),j*64);let h=new Uint8Array(await crypto.subtle.digest('SHA-256',b));valleyPixels.push(Array.from(h,x=>x.toString(16).padStart(2,'0')).join(''));return true})()");
}
vl_run :: (c:[]Cdp,url:string,phone:bool)->bool {
  _:=cdp_call(c,"Page.enable","",30000);
  if !vl_param(c,"Page.addScriptToEvaluateOnNewDocument","source","globalThis.coaxialClip=true;globalThis.coaxialRenderCapture=true;globalThis.coaxialRenderCaptureFormat='rgba8unorm';globalThis.valleyPixels=[];globalThis.valleyErrors=[];const ce=console.error;console.error=(...a)=>{valleyErrors.push(a.map(String).join(' '));ce(...a)}") {return false;}
  if !phone {desktop_metrics:=cdp_call(c,"Emulation.setDeviceMetricsOverride","{\"width\":1280,\"height\":800,\"deviceScaleFactor\":1,\"mobile\":false}",30000);}
  if phone {
    metrics:=cdp_call(c,"Emulation.setDeviceMetricsOverride","{\"width\":390,\"height\":844,\"deviceScaleFactor\":1,\"mobile\":true}",30000);
    touch_enabled:=cdp_call(c,"Emulation.setTouchEmulationEnabled","{\"enabled\":true,\"maxTouchPoints\":5}",30000);}
  if !vl_param(c,"Page.navigate","url",url) {return false;}
  ready:=false;until:=proc_now_ms()+30000;
  while proc_now_ms()<until {
    if vl_eval(c,"(async()=>!!globalThis.coaxial?.ready && (await globalThis.coaxialClipStep?.(1,60))===1 && coaxial.sceneReady===true)()") {ready=true;break;}
    proc_sleep(100);
  }
  if !ready {return false;}
  if !vl_key(c,"w","KeyW",true) || !vl_eval(c,"coaxialClipStep(32,60).then(()=>coaxial.guardProbe(2)>-11000 && coaxial.guardProbe(3)>0)") {return false;}
  if !vl_key(c,"w","KeyW",false) || !vl_key(c," ","Space",true) || !vl_eval(c,"coaxialClipStep(5,60).then(()=>coaxial.guardProbe(1)>100)") {return false;}
  if !vl_key(c," ","Space",false) || !vl_eval(c,"coaxialClipStep(100,60).then(()=>Math.abs(coaxial.guardProbe(1))<100)") {return false;}
  if !vl_key(c,"r","KeyR",true) || !vl_key(c,"r","KeyR",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(2)===-12000 && coaxial.guardProbe(4)===0)") {return false;}
  if phone {
    if cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchStart\",\"touchPoints\":[{\"x\":70,\"y\":650,\"id\":1}]}",30000)<0 {return false;}
    if cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchMove\",\"touchPoints\":[{\"x\":70,\"y\":594,\"id\":1}]}",30000)<0 {return false;}
    if !vl_eval(c,"coaxialClipStep(32,60).then(()=>coaxial.guardProbe(2)>-11000)") {return false;}
    if cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchEnd\",\"touchPoints\":[]}",30000)<0 {return false;}
  }
  if !vl_key(c,"2","Digit2",true) || !vl_key(c,"2","Digit2",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(6)===1 && coaxial.guardProbe(11)===1 && location.hash==='#assets')") {return false;}
  if !vl_capture(c) || !vl_eval(c,"(globalThis.valleyReference={width:coaxial.renderCapture.width,height:coaxial.renderCapture.height,bytes:coaxial.renderCapture.bytes.slice()},true)") {return false;}
  if !vl_eval(c,"Array.from({length:8},(_,i)=>(coaxial.guardProbe(20+i)>>>0).toString(16).padStart(8,'0')).join('')==='3669c50bede0c4da9f611f4c658620ffc906ad6839984107838ab73aba37550b'") {return false;}
  if !vl_key(c,"v","KeyV",true) || !vl_key(c,"v","KeyV",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(7)===1)") || !vl_capture(c) {return false;}
  if !vl_key(c,"v","KeyV",true) || !vl_key(c,"v","KeyV",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(7)===2)") || !vl_capture(c) {return false;}
  if !vl_key(c,"3","Digit3",true) || !vl_key(c,"3","Digit3",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(6)===2 && coaxial.guardProbe(7)===3 && coaxial.guardProbe(12)===10944 && coaxial.guardProbe(5)===3462)") || !vl_capture(c) {return false;}
  if !vl_key(c,"l","KeyL",true) || !vl_key(c,"l","KeyL",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(8)===12288 && coaxial.guardProbe(11)===1 && Array.from({length:8},(_,i)=>(coaxial.guardProbe(20+i)>>>0).toString(16).padStart(8,'0')).join('')==='4e2053348a34e5a363ee5451b54412daba41bd41813c40d0cd6d8559f2ddd56c')") {return false;}
  if !vl_key(c,"l","KeyL",true) || !vl_key(c,"l","KeyL",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(8)===768 && coaxial.guardProbe(11)===1 && Array.from({length:8},(_,i)=>(coaxial.guardProbe(20+i)>>>0).toString(16).padStart(8,'0')).join('')==='c39ef513e76cfb373abbb2185e35120cf4a02e13db13f80f92c82e05449bbf64')") {return false;}
  if phone {
    if cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchStart\",\"touchPoints\":[{\"x\":160,\"y\":103,\"id\":5}]}",30000)<0 {return false;}
    if cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchEnd\",\"touchPoints\":[]}",30000)<0 {return false;}
    if !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(6)===1)") {return false;}
    if cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchStart\",\"touchPoints\":[{\"x\":270,\"y\":780,\"id\":6}]}",30000)<0 {return false;}
    if cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchEnd\",\"touchPoints\":[]}",30000)<0 {return false;}
    if !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(8)===3072 && coaxial.guardProbe(11)===1)") {return false;}
  }
  if !vl_key(c,"3","Digit3",true) || !vl_key(c,"3","Digit3",false) {return false;}
  if !vl_key(c,"v","KeyV",true) || !vl_key(c,"v","KeyV",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(7)===4)") || !vl_capture(c) {return false;}
  if !vl_eval(c,"new Set(valleyPixels).size===5 && (()=>{let r=coaxial.renderCapture,i=(Math.floor(r.height/2)*r.width+Math.floor(r.width/2))*4,b=r.bytes;return b[i]===b[i+1]&&b[i]===b[i+2]&&b[i]>0&&b[i]<255})()") {return false;}
  // The actual leaf path preserves source geometry. Compare its lit center
  // with the default full-detail reference, then inspect cluster-ID pixels.
  if !phone {if !vl_key(c,"l","KeyL",true) || !vl_key(c,"l","KeyL",false) {return false;}}
  if !vl_key(c,"c","KeyC",true) || !vl_key(c,"c","KeyC",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(7)===5 && coaxial.guardProbe(16)===1 && coaxial.guardProbe(14)>1 && coaxial.guardProbe(5)===1296+coaxial.guardProbe(15) && coaxial.guardProbe(12)===10512)") || !vl_capture(c) {return false;}
  if !vl_key(c,"v","KeyV",true) || !vl_key(c,"v","KeyV",false) || !vl_key(c,"v","KeyV",true) || !vl_key(c,"v","KeyV",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(7)===0 && coaxial.guardProbe(16)===1)") || !vl_capture(c) {return false;}
  if !vl_eval(c,"valleyPixels[6]===valleyPixels[0] && valleyPixels[5]!==valleyPixels[6] && (()=>{let a=valleyReference,b=coaxial.renderCapture;if(a.width!==b.width||a.height!==b.height)return false;for(let y=Math.floor(a.height*.25);y<Math.floor(a.height*.55);y++)for(let x=Math.floor(a.width*.4);x<Math.floor(a.width*.6);x++)for(let k=0;k<4;k++){let i=(y*a.width+x)*4+k;if(a.bytes[i]!==b.bytes[i])return false}return true})()") {return false;}
  if !vl_key(c,"c","KeyC",true) || !vl_key(c,"c","KeyC",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(16)===0 && coaxial.guardProbe(5)===3030)") {return false;}
  if !vl_eval(c,"(async()=>{location.hash='clusters';await new Promise(r=>setTimeout(r,100));await coaxialClipStep(1,60);return coaxial.guardProbe(7)===5 && coaxial.guardProbe(16)===1})()") {return false;}
  print("PASS Valley clusters %: decoded leaf counts/index traffic, cluster-ID readback, exact lit reference region, C path toggle and #clusters link\n",ifx phone then "phone" else "desktop");
  if !vl_eval(c,"(async()=>{location.hash='hierarchy';await new Promise(r=>setTimeout(r,100));await coaxialClipStep(1,60);return coaxial.guardProbe(7)===6 && coaxial.guardProbe(30)===71 && coaxial.guardProbe(31)===6 && coaxial.guardProbe(32)===1 && coaxial.guardProbe(33)===18 && coaxial.guardProbe(35)===3072 && coaxial.guardProbe(36)===0 && coaxial.guardProbe(12)===10944})()") || !vl_capture(c) {return false;}
  if !vl_key(c,"h","KeyH",true) || !vl_key(c,"h","KeyH",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(32)===2 && coaxial.guardProbe(33)===9 && coaxial.guardProbe(35)===3072)") || !vl_capture(c) {return false;}
  if !vl_eval(c,"valleyPixels[7]!==valleyPixels[8]") {return false;}
  if !vl_key(c,"f","KeyF",true) || !vl_key(c,"f","KeyF",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(34)===1 && coaxial.guardProbe(32)===0 && coaxial.guardProbe(35)===4 && coaxial.guardProbe(12)===1740)") || !vl_capture(c) {return false;}
  if !vl_key(c,"h","KeyH",true) || !vl_key(c,"h","KeyH",false) || !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(35)===2 && coaxial.guardProbe(36)===0 && coaxial.guardProbe(12)===1734)") || !vl_capture(c) {return false;}
  if phone {
    if cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchStart\",\"touchPoints\":[{\"x\":100,\"y\":720,\"id\":12}]}",30000)<0 || cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchEnd\",\"touchPoints\":[]}",30000)<0 {return false;}
  }else {if !vl_key(c,"f","KeyF",true) || !vl_key(c,"f","KeyF",false) {return false;}}
  if !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(34)===2 && coaxial.guardProbe(35)===4 && coaxial.guardProbe(36)===0)") || !vl_capture(c) {return false;}
  if phone {
    if cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchStart\",\"touchPoints\":[{\"x\":270,\"y\":780,\"id\":13}]}",30000)<0 || cdp_call(c,"Input.dispatchTouchEvent","{\"type\":\"touchEnd\",\"touchPoints\":[]}",30000)<0 {return false;}
  }else {if !vl_key(c,"h","KeyH",true) || !vl_key(c,"h","KeyH",false) {return false;}}
  if !vl_eval(c,"coaxialClipStep(1,60).then(()=>coaxial.guardProbe(35)===2 && coaxial.guardProbe(36)===750 && coaxial.guardProbe(12)===1734)") || !vl_capture(c) {return false;}
  if !vl_eval(c,"valleyPixels[9]!==valleyPixels[10] && valleyPixels[11]!==valleyPixels[12] && valleyErrors.length===0") {return false;}
  print("PASS Valley hierarchy %: real parent cuts/colors, unchanged rock triangles, planar 4->2 error=0, bent 4->2 error=750mm, %\n",ifx phone then "phone" else "desktop",ifx phone then "actual touch source/level controls" else "H/F keyboard controls");
  perf:=cdp_evaluate(c,"(async()=>{let samples=[];for(let i=0;i<30;i++){let t=performance.now();await coaxialClipStep(1,60);samples.push(performance.now()-t)}samples.sort((a,b)=>a-b);return JSON.stringify({scope:'30 static bent-fan coarse frames, CPU submission plus GPU queue completion, not GPU timestamps or route FPS',viewport:[innerWidth,innerHeight],triangles:coaxial.guardProbe(35),medianMs:samples[15],p95Ms:samples[28],p99Ms:samples[29]})})()");
  if perf<0 {return false;}print("Valley fenced frame observation: %\n",jv_raw(c[0].doc[0],perf));
  print("PASS Valley asset/geometry %: stations, actual index pulling, view modes, three native/Wasm SHA256 matches, bounded replacement and %\n",ifx phone then "phone" else "desktop",ifx phone then "touch station/detail controls" else "keyboard controls");
  if !vl_eval(c,"document.querySelector('meta[name=robots]')?.content==='noindex, nofollow' && valleyErrors.length===0 && coaxial.guardProbe(5)>600") {return false;}
  print("PASS Valley Lab %: direct route, rendered geometry, WASD, jump/land, reset, %, noindex, no console errors\n",ifx phone then "phone" else "desktop",ifx phone then "actual touch movement" else "keyboard controls");return true;
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {return 2;}
  for phone:0..<2 {
    c:[1]Cdp;if !cdp_launch_background(c[..],ifx phone==1 then 390 else 1280,ifx phone==1 then 844 else 800,"valley-lab-check-") {return 1;}
    p:[4096]u8;url:=fs_join(args_at(a[..],0),"worlds/valley-lab",p[..]);ok:=vl_run(c[..],url,phone==1);
    if !ok {n:=cdp_evaluate(c[..],"JSON.stringify({ready:globalThis.coaxial?.ready,scene:globalThis.coaxial?.sceneReady,pose:Array.from({length:6},(_,i)=>globalThis.coaxial?.guardProbe(i)),mode:globalThis.coaxial?.guardProbe(7),hierarchy:Array.from({length:7},(_,i)=>globalThis.coaxial?.guardProbe(30+i)),captures:globalThis.valleyPixels?.length,errors:globalThis.valleyErrors,text:document.body.innerText.slice(0,300)})");if n>=0 {print("FAIL %: %\n",ifx phone==1 then "phone" else "desktop",jv_raw(c[0].doc[0],n));}}
    cdp_close(c[..]);if !ok {return 1;}
  }return 0;
}
