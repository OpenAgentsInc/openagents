// Source data -> same-origin bounded HTTP -> SHA256 admission -> actual headless WebGPU.
#import "Basic";
#load "../lib/net/cdp.coax";
vs_eval :: (c:[]Cdp,label:string,js:string)->bool {
  n:=cdp_evaluate(c,js);if n>=0 && jv_raw(c[0].doc[0],n)=="true" {return true;}print("FAIL %\n",label);
  n=cdp_evaluate(c,"JSON.stringify({scan:[110,111,112,113,114,69,70].map(x=>coaxial?.guardProbe(x)),errors:scanErrors,requests:scanGate.requests,pixels:scanPixels})");if n>=0 {print("%\n",jv_raw(c[0].doc[0],n));}return false;
}
vs_key :: (c:[]Cdp,key:string)->bool {b:[512]u8;o:[1]Jo;for k:0..<2 {jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"type");jo_str(o[..],ifx k==0 then "keyDown" else "keyUp");jo_key(o[..],"key");jo_str(o[..],key);jo_end(o[..]);if cdp_call(c,"Input.dispatchKeyEvent",jo_text(o[..]),30000)<0 {return false;}}return vs_eval(c,"key frame","coaxialClipStep(1,60).then(()=>true)");}
vs_capture :: (c:[]Cdp)->bool {
  return vs_eval(c,"GPU pixels","(async()=>{coaxial.renderCapture=null;if(!coaxial.captureFrame())return false;await coaxialClipStep(1,60);for(let i=0;i<100&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));let r=coaxial.renderCapture;if(r?.format!=='rgba8unorm')return false;let x=Math.floor(r.width/2),y=Math.floor(r.height/2),b=new Uint8Array(64*64*4);for(let j=0;j<64;j++)b.set(r.bytes.slice(((y+j-32)*r.width+x-32)*4,((y+j-32)*r.width+x+32)*4),j*256);let h=new Uint8Array(await crypto.subtle.digest('SHA-256',b));scanPixels.push(Array.from(h,x=>x.toString(16).padStart(2,'0')).join(''));return true})()");
}
vs_wait :: (c:[]Cdp,state:int)->bool {s:=ifx state==2 then "2" else "3";b:[1024]u8;at:=0;for part:[3]string.["(async()=>{for(let i=0;i<200;i++){await coaxialClipStep(1,60);await new Promise(r=>setTimeout(r,10));if(coaxial.guardProbe(110)===",s,")return true}return false})()"] {for ch:part {b[at]=ch;at+=1;}}return vs_eval(c,"scan result",cast(string)b[0..<at]);}
vs_run :: (c:[]Cdp,url:string,phone:bool)->bool {
  _:=cdp_call(c,"Page.enable","",30000);b:[4096]u8;o:[1]Jo;jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"source");jo_str(o[..],"globalThis.coaxialClip=true;globalThis.coaxialRenderCapture=true;globalThis.coaxialRenderCaptureFormat='rgba8unorm';globalThis.scanPixels=[];globalThis.scanErrors=[];globalThis.scanGate={mode:'ok',requests:[],releases:[]};const sf=fetch.bind(globalThis);globalThis.fetch=async(...a)=>{if(String(a[0]).includes('/assets/valley/scans/')){let g=scanGate;g.requests.push(String(a[0]));let mode=g.mode,r=await sf(...a),t=await r.text();if(mode==='hold')await new Promise(f=>g.releases.push(f));if(mode==='corrupt')t=t.slice(0,80)+(t[80]==='0'?'1':'0')+t.slice(81);return new Response(t,{status:mode==='missing'?404:r.status})}return sf(...a)};const se=console.error;console.error=(...a)=>{scanErrors.push(a.map(String).join(' '));se(...a)}");jo_end(o[..]);if cdp_call(c,"Page.addScriptToEvaluateOnNewDocument",jo_text(o[..]),30000)<0 {return false;}
  _=cdp_call(c,"Emulation.setDeviceMetricsOverride",ifx phone then "{\"width\":390,\"height\":844,\"deviceScaleFactor\":1,\"mobile\":true}" else "{\"width\":1280,\"height\":800,\"deviceScaleFactor\":1,\"mobile\":false}",30000);
  jo_start(o[..],b[..]);jo_obj(o[..]);jo_key(o[..],"url");jo_str(o[..],url);jo_end(o[..]);if cdp_call(c,"Page.navigate",jo_text(o[..]),30000)<0 {return false;}
  ready:=false;until:=proc_now_ms()+30000;while proc_now_ms()<until {n:=cdp_evaluate(c,"(async()=>!!globalThis.coaxial?.ready&&(await coaxialClipStep(1,60))===1&&coaxial.sceneReady)()");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {ready=true;break;}proc_sleep(100);}if !ready {return false;}
  if !vs_wait(c,2) || !vs_eval(c,"source rock","coaxial.guardProbe(111)===0&&coaxial.guardProbe(112)===6780&&coaxial.guardProbe(113)===2994&&coaxial.guardProbe(70)<9500000&&coaxial.guardProbe(69)<80000") || !vs_capture(c) {return false;}
  for k:0..<4 {if !vs_key(c,"v") || !vs_capture(c) {return false;}}if !vs_eval(c,"five diagnostic views","new Set(scanPixels).size===5") {return false;}
  if !vs_key(c,"l") || !vs_wait(c,2) || !vs_eval(c,"source cliff","coaxial.guardProbe(111)===1&&coaxial.guardProbe(112)===1949&&coaxial.guardProbe(113)===3099") || !vs_capture(c) {return false;}
  if !vs_eval(c,"corrupt next download","(scanGate.mode='corrupt',true)") || !vs_key(c,"l") || !vs_wait(c,3) || !vs_eval(c,"corrupt bytes retain cliff","coaxial.guardProbe(111)===1&&coaxial.guardProbe(113)===3099") {return false;}
  if !vs_eval(c,"missing source","(scanGate.mode='missing',true)") || !vs_key(c,"r") || !vs_wait(c,3) || !vs_eval(c,"missing retains cliff","coaxial.guardProbe(111)===1&&coaxial.guardProbe(113)===3099") {return false;}
  if !vs_eval(c,"retry","(scanGate.mode='ok',true)") || !vs_key(c,"r") || !vs_wait(c,2) || !vs_eval(c,"recovered source","coaxial.guardProbe(111)===0&&coaxial.guardProbe(113)===2994") {return false;}
  if !vs_eval(c,"hold","(scanGate.mode='hold',true)") || !vs_key(c,"l") || !vs_eval(c,"request held","(async()=>{for(let i=0;i<100&&!scanGate.releases.length;i++){await coaxialClipStep(1,60);await new Promise(r=>setTimeout(r,10))}return scanGate.releases.length===1})()") || !vs_key(c,"1") || !vs_eval(c,"stale response","(async()=>{scanGate.mode='ok';scanGate.releases.splice(0).forEach(f=>f());await new Promise(r=>setTimeout(r,100));await coaxialClipStep(2,60);return coaxial.guardProbe(114)===0&&coaxial.guardProbe(6)===0&&coaxial.guardProbe(111)===0})()") {return false;}
  if !vs_key(c,"0") || !vs_wait(c,2) || !vs_capture(c) || !vs_eval(c,"GPU device recovery","(async()=>{let before=await coaxial.stateDigest();coaxial.loseDevice();await new Promise(r=>setTimeout(r,10));for(let i=0;i<300&&coaxial.gpuRecovery?.state!=='recovered';i++)await new Promise(r=>setTimeout(r,10));if(coaxial.gpuRecovery?.state!=='recovered'||await coaxial.stateDigest()!==before)return false;await coaxialClipStep(1,60);return coaxial.sceneReady&&scanErrors.length===1&&scanErrors.pop().startsWith('coaxial: GPU device lost (destroyed:')})()") || !vs_capture(c) || !vs_eval(c,"identical recovered scan pixels","scanPixels[6]===scanPixels[7]&&scanErrors.length===0") {return false;}
  n:=cdp_evaluate(c,"JSON.stringify({scan:[110,111,112,113,69,70].map(x=>coaxial.guardProbe(x)),requests:scanGate.requests.length,hashes:scanPixels})");if n>=0 {print("Observation % %\n",ifx phone then "phone" else "desktop",jv_raw(c[0].doc[0],n));}print("PASS scans %: exact two sources, five GPU views, corrupt/missing/stale retention, retry, identical GPU recovery\n",ifx phone then "phone" else "desktop");return true;
}
tool_main :: ()->int #export_c {a:[1]Args;if !args_load(a[..]) || args_count(a[..])!=1 {return 2;}for phone:0..<2 {c:[1]Cdp;if !cdp_launch_background(c[..],ifx phone==0 then 1280 else 390,ifx phone==0 then 800 else 844,"valley-scans-") {return 1;}path:[4096]u8;url:=fs_join(args_at(a[..],0),"worlds/valley-lab#scans",path[..]);ok:=vs_run(c[..],url,phone==1);cdp_close(c[..]);if !ok {return 1;}}return 0;}
