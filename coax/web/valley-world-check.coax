// Actual muted headless WebGPU: source-world navigation, Echo, reset, admission and device replacement.
#import "Basic";
#load "../lib/net/cdp.coax";
vw_eval :: (c:[]Cdp,label:string,js:string)->bool {n:=cdp_evaluate(c,js);if n>=0 && jv_raw(c[0].doc[0],n)=="true" {return true;}print("FAIL %\n",label);n=cdp_evaluate(c,"JSON.stringify({ready:globalThis.coaxial?.sceneReady,probes:Array.from({length:9},(_,i)=>globalThis.coaxial?.guardProbe(i)),feet:[60,61,62].map(i=>globalThis.coaxial?.guardProbe(i)),errors:globalThis.worldErrors})");if n>=0 {print("%\n",jv_raw(c[0].doc[0],n));}return false;}
vw_wait :: (c:[]Cdp)->bool {until:=proc_now_ms()+150000;while proc_now_ms()<until {n:=cdp_evaluate(c,"(async()=>{if(!globalThis.coaxial?.ready)return false;await worldStep(1,60);return coaxial.sceneReady&&coaxial.guardProbe(0)===1})()");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {return true;}n=cdp_evaluate(c,"globalThis.worldErrors?.length>0");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {return vw_eval(c,"source world console","false");}proc_sleep(100);}return vw_eval(c,"source world ready","false");}
vw_key :: (c:[]Cdp,key:string)->bool {b:[256]u8;j:[1]Jo;for k:0..<2 {jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"type");jo_str(j[..],ifx k==0 then "keyDown" else "keyUp");jo_key(j[..],"key");jo_str(j[..],key);if key==" " {jo_key(j[..],"code");jo_str(j[..],"Space");}jo_end(j[..]);if cdp_call(c,"Input.dispatchKeyEvent",jo_text(j[..]),30000)<0 {return false;}}return vw_eval(c,"key reaches world","worldStep(1,60).then(()=>true)");}
vw_parent :: (c:[]Cdp)->bool {until:=proc_now_ms()+30000;while proc_now_ms()<until {n:=cdp_evaluate(c,"(async()=>{if(location.pathname!=='/worlds/valley-lab'||!globalThis.coaxial?.ready)return false;await worldStep(1,60);return coaxial.sceneReady})()");if n>=0 && jv_raw(c[0].doc[0],n)=="true" {return true;}proc_sleep(100);}return false;}
vw_pixels :: (c:[]Cdp)->bool {return vw_eval(c,"source GPU readback","(async()=>{coaxial.renderCapture=null;if(!coaxial.captureFrame())return false;await worldStep(1,60);for(let i=0;i<100&&!coaxial.renderCapture;i++)await new Promise(r=>setTimeout(r,10));let r=coaxial.renderCapture;if(r?.format!=='rgba8unorm')return false;let x=Math.floor(r.width/2)-64,y=Math.floor(r.height/2)-64,b=new Uint8Array(128*128*4);for(let j=0;j<128;j++)b.set(r.bytes.slice(((y+j)*r.width+x)*4,((y+j)*r.width+x+128)*4),j*512);let h=new Uint8Array(await crypto.subtle.digest('SHA-256',b));worldPixels.push(Array.from(h,x=>x.toString(16).padStart(2,'0')).join(''));return true})()");}
vw_shot :: (c:[]Cdp,root:string,phone:int,station:int)->bool {png:[8388608]u8;path:[4096]u8;name:=[8]string.["desktop-basin.png","desktop-west.png","desktop-east.png","desktop-north.png","phone-basin.png","phone-west.png","phone-east.png","phone-north.png"][phone*4+station];row:=cdp_evaluate(c,"(()=>{const r=coaxial.renderCapture;if(r?.format!=='rgba8unorm')return '';const canvas=document.createElement('canvas');canvas.width=r.width;canvas.height=r.height;canvas.getContext('2d').putImageData(new ImageData(new Uint8ClampedArray(r.bytes),r.width,r.height),0,0);const display=document.createElement('canvas');display.width=innerWidth;display.height=innerHeight;display.getContext('2d').drawImage(canvas,0,0,display.width,display.height);return display.toDataURL('image/png').split(',')[1]})()");n:=ifx row>=0 then b64_decode(jv_raw(c[0].doc[0],row),png[..]) else -1;return n>0 && fs_write(fs_join(root,name,path[..]),cast(string)png[0..<n]);}
tool_main :: ()->int #export_c #effects(all) {
 a:[1]Args;if !args_load(a[..]) || args_count(a[..])<1 || args_count(a[..])>3 {return 2;}captures:=args_count(a[..])==3 && args_at(a[..],2)=="--captures";
 for phone:0..<2 {c:[1]Cdp;if !cdp_launch_background(c[..],ifx phone==0 then 1280 else 390,ifx phone==0 then 800 else 844,"valley-world-") {return 1;}
  _:=cdp_call(c[..],"Page.enable","",30000);_=cdp_call(c[..],"Page.addScriptToEvaluateOnNewDocument","{\"source\":\"globalThis.coaxialClip=true;globalThis.worldStep=async(n,fps)=>{for(let i=0;i<n;i++)await coaxialClipStep(1,fps);return 1};globalThis.coaxialRenderCapture=true;globalThis.coaxialRenderCaptureFormat='rgba8unorm';globalThis.worldErrors=[];globalThis.worldPixels=[];const old=console.error;console.error=(...v)=>{worldErrors.push(v.join(' '));old(...v)}\"}",30000);
  _=cdp_call(c[..],"Emulation.setDeviceMetricsOverride",ifx phone==0 then "{\"width\":1280,\"height\":800,\"deviceScaleFactor\":1,\"mobile\":false}" else "{\"width\":390,\"height\":844,\"deviceScaleFactor\":1,\"mobile\":true}",30000);
  if phone==1 {_=cdp_call(c[..],"Emulation.setTouchEmulationEnabled","{\"enabled\":true,\"maxTouchPoints\":5}",30000);}
  path:[4096]u8;b:[8192]u8;j:[1]Jo;jo_start(j[..],b[..]);jo_obj(j[..]);jo_key(j[..],"url");jo_str(j[..],fs_join(args_at(a[..],0),ifx captures then "worlds/valley-lab" else "worlds/valley-world?pack=valley-world",path[..]));jo_end(j[..]);_=cdp_call(c[..],"Page.navigate",jo_text(j[..]),30000);
  if captures {if !vw_parent(c[..]) {cdp_close(c[..]);return 1;}if phone==0 {_=cdp_call(c[..],"Input.dispatchKeyEvent","{\"type\":\"keyDown\",\"key\":\"n\"}",30000);}else {_=cdp_call(c[..],"Input.dispatchTouchEvent","{\"type\":\"touchStart\",\"touchPoints\":[{\"x\":180,\"y\":30,\"id\":5}]}",30000);_=cdp_call(c[..],"Input.dispatchTouchEvent","{\"type\":\"touchEnd\",\"touchPoints\":[]}",30000);}}
  ok:=vw_wait(c[..]);if ok {ok=vw_eval(c[..],"complete source instances and original Echo","coaxial.frameQueue().bounded&&coaxial.frameQueue().pending<=2&&coaxial.guardProbe(3)===27501&&coaxial.guardProbe(2)>0&&coaxial.guardProbe(1)>100000&&coaxial.guardProbe(72)===334&&coaxial.guardProbe(64)===0&&worldErrors.length===0");}
  if captures {for station:0..<4 {if ok {ok=vw_key(c[..],[4]string.["2","3","4","5"][station]) && vw_pixels(c[..]) && vw_shot(c[..],args_at(a[..],1),phone,station);}}if ok {if phone==0 {_=cdp_call(c[..],"Input.dispatchKeyEvent","{\"type\":\"keyDown\",\"key\":\"1\"}",30000);}else {_=cdp_call(c[..],"Input.dispatchTouchEvent","{\"type\":\"touchStart\",\"touchPoints\":[{\"x\":50,\"y\":30,\"id\":5}]}",30000);_=cdp_call(c[..],"Input.dispatchTouchEvent","{\"type\":\"touchEnd\",\"touchPoints\":[]}",30000);}ok=vw_parent(c[..]);}cdp_close(c[..]);if !ok {print("FAIL world capture/navigation %\n",phone);return 1;}print("PASS world %: parent N/touch entry, four full GPU captures, back to lab\n",phone);continue;}
  if ok {ok=vw_eval(c[..],"remember source feet","(globalThis.worldFeet=[60,61,62].map(i=>coaxial.guardProbe(i)),true)") && vw_pixels(c[..]);}
  if ok {_=cdp_call(c[..],"Input.dispatchKeyEvent","{\"type\":\"keyDown\",\"key\":\"w\"}",30000);ok=vw_eval(c[..],"paid route steps","(async()=>{let start=performance.now();await worldStep(90,60);globalThis.worldRouteMs=performance.now()-start;return true})()");_=cdp_call(c[..],"Input.dispatchKeyEvent","{\"type\":\"keyUp\",\"key\":\"w\"}",30000);}
  if ok {ok=vw_eval(c[..],"Echo walks on source ground","Math.hypot(coaxial.guardProbe(60)-worldFeet[0],coaxial.guardProbe(62)-worldFeet[2])>500&&coaxial.guardProbe(64)===0") && vw_key(c[..],"r") && vw_eval(c[..],"exact source reset","[60,61,62].every((p,i)=>coaxial.guardProbe(p)===worldFeet[i])&&coaxial.guardProbe(71)===0");}
  if ok && phone==1 {_=cdp_call(c[..],"Input.dispatchTouchEvent","{\"type\":\"touchStart\",\"touchPoints\":[{\"x\":70,\"y\":650,\"id\":1}]}",30000);_=cdp_call(c[..],"Input.dispatchTouchEvent","{\"type\":\"touchMove\",\"touchPoints\":[{\"x\":70,\"y\":594,\"id\":1}]}",30000);ok=vw_eval(c[..],"phone thumb moves Echo on source ground","(async()=>{await worldStep(40,64);return Math.hypot(coaxial.guardProbe(60)-worldFeet[0],coaxial.guardProbe(62)-worldFeet[2])>100})()");_=cdp_call(c[..],"Input.dispatchTouchEvent","{\"type\":\"touchEnd\",\"touchPoints\":[]}",30000);ok=ok && vw_key(c[..],"r");}
  if ok {ok=vw_key(c[..]," ") && vw_eval(c[..],"jump tap leaves source ground","coaxial.guardProbe(61)>worldFeet[1]+10") && vw_key(c[..],"r");}
  if ok && phone==1 {_=cdp_call(c[..],"Input.dispatchTouchEvent","{\"type\":\"touchStart\",\"touchPoints\":[{\"x\":330,\"y\":738,\"id\":2}]}",30000);_=cdp_call(c[..],"Input.dispatchTouchEvent","{\"type\":\"touchEnd\",\"touchPoints\":[]}",30000);ok=vw_eval(c[..],"phone JUMP button queues a tap","(async()=>{await worldStep(2,60);return coaxial.guardProbe(61)>worldFeet[1]+10})()") && vw_key(c[..],"r");}
  for station:0..<4 {if ok {ok=vw_key(c[..],[4]string.["2","3","4","5"][station]) && vw_pixels(c[..]);if ok && args_count(a[..])==2 {ok=vw_shot(c[..],args_at(a[..],1),phone,station);}}}
  if ok {ok=vw_eval(c[..],"four nonempty source views","new Set(worldPixels.slice(-4)).size===4&&coaxial.guardProbe(2)>0") && vw_key(c[..],"2") && vw_key(c[..],"r") && vw_key(c[..],"o") && vw_pixels(c[..]);}
  if ok {ok=vw_eval(c[..],"GPU replacement retains source world session","(async()=>{const before=await coaxial.stateDigest();coaxial.loseDevice();await new Promise(r=>setTimeout(r,10));for(let i=0;i<6000&&!['recovered','failed'].includes(coaxial.gpuRecovery?.state);i++)await new Promise(r=>setTimeout(r,20));if(coaxial.gpuRecovery?.state!=='recovered'||await coaxial.stateDigest()!==before)return false;await worldStep(1,60);return coaxial.guardProbe(0)===1})()") && vw_pixels(c[..]) && vw_eval(c[..],"identical source pixels after GPU loss","worldPixels.at(-1)===worldPixels.at(-2)&&worldErrors.length===1&&worldErrors[0].startsWith('coaxial: GPU device lost')");}
  if ok {n:=cdp_evaluate(c[..],"JSON.stringify({sourceInstances:coaxial.guardProbe(3),serialRouteFrames:90,serialRouteMs:worldRouteMs,visibleInstances:coaxial.guardProbe(2),sourceTriangles:coaxial.guardProbe(1),draws:coaxial.guardProbe(8),accountedKiB:coaxial.guardProbe(4),submittedVertices:coaxial.guardProbe(5),pixels:worldPixels})");if n>=0 {print("World % %\n",ifx phone==0 then "desktop" else "phone",jv_raw(c[0].doc[0],n));}}
  cdp_close(c[..]);if !ok {return 1;}print("PASS world %: source scenery, Echo walk/jump, four views, reset and device recovery\n",phone);
 }return 0;
}
