// Two readings for coax/web/wasm.sh, which builds each page's and realm's module:
//   coax/web/tool.sh wasm-size sources UNIT.coax...   (from the repo root)
//     every file in the units' #load closure, one path a line, as the compiler
//     resolves them (relative to the loading file). wasm.sh hashes them into the
//     key of its C cache, so a unit whose closure is unchanged isn't compiled
//     again. Exit 3 when a unit has an #import_proto (its descriptors are inputs
//     this doesn't follow: no cache), 1 when a file can't be read.
//   coax/web/tool.sh wasm-size exports UNIT.coax...   (from the repo root)
//     the units wasm.sh compiles into one module, each its own C library. Every
//     #export_c procedure in a unit's #load closure is a global C symbol of that
//     unit's object, so a file with one that two units both load gives wasm-ld
//     a duplicate symbol (#12661: S_hash and S_hex, when myrealm's renderer
//     carrier and YOUR COMPUTER's wire both loaded sha256-kernel.coax). Names
//     each such symbol, its file and both units before any C is compiled; exit
//     1 when there is one, 0 when there is none (a file not there yet is skipped).
//   coax/web/tool.sh wasm-size report FILE.wasm [N]
//     the module's sections by size and its N biggest functions (default 25),
//     by name when the module has a name section: what wasm.sh prints when a
//     module is over its budget (apps/openagents-web/wasm-budgets.txt).
//   coax/web/tool.sh wasm-size symbols IN.wasm OUT.wasm OUT.syms
//     splits a module's function names from the bytes that ship (#13298, docs/deployment/crash-reports.md):
//     OUT.wasm is IN.wasm without its "name" custom section (the bytes wasm-opt writes without -g),
//     and OUT.syms has one "INDEX NAME" line a function. host.js fetches the .syms only after a trap,
//     to turn the stack's wasm-function[INDEX] into names. Exit 1 when IN.wasm has no names.
//   coax/web/tool.sh wasm-size state IN.wasm LAYOUT OUT.wasm
//     OUT.wasm is IN.wasm with LAYOUT (the state's field table, as `coax layout` prints it) in a
//     "coaxial.state" custom section, replacing one already there (#13411). wasm.sh adds it to a
//     development module; host.js reads it on an engine swap to carry the state field by field
//     (coax/web/state-keep.js). A release module has none.
#import "Basic";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/args.coax";

WS_PATHS :: 4096;          // files in one closure (the compiler admits 4096 units)
WS_ARENA :: 1048576;       // their paths, together
WS_FILE :: 33554432;       // one source file or module
WS_FUNCS :: 131072;        // functions in a module

Closure :: struct {
  arena: [WS_ARENA] u8; used: int;
  at: [WS_PATHS] int; len: [WS_PATHS] int; n: int;
  proto: bool;             // an #import_proto: descriptors this doesn't follow
  full: bool;              // more paths than it holds
}

// dir/rel with "." and ".." parts taken out, into out; "" when it doesn't fit.
// An absolute rel stands alone; ".." past the start of a relative path stays.
ws_resolve :: (dir: string, rel: string, out: [] u8) -> string {
  joined: [8192] u8; j := 0;
  if rel.count > 0 && rel[0] == '/' {
    if rel.count > joined.count { return ""; }
    for c: rel { joined[j] = c; j += 1; }
  } else {
    if dir.count + 1 + rel.count > joined.count { return ""; }
    for c: dir { joined[j] = c; j += 1; }
    joined[j] = '/'; j += 1;
    for c: rel { joined[j] = c; j += 1; }
  }
  path := cast(string) joined[0..<j];
  absolute := path[0] == '/';
  starts: [1024] int; parts := 0;   // where each kept part starts in out
  n := 0;
  if absolute { if out.count < 1 { return ""; } out[0] = '/'; n = 1; }
  i := 0;
  while i < path.count {
    if path[i] == '/' { i += 1; continue; }
    e := i;
    while e < path.count && path[e] != '/' { e += 1; }
    part := path[i..<e]; i = e;
    if part == "." { continue; }
    if part == ".." && parts > 0 && cast(string) out[starts[parts - 1]..<n] != ".." {
      parts -= 1; n = starts[parts];
      if n > 0 && out[n - 1] == '/' && !(absolute && n == 1) { n -= 1; }
      continue;
    }
    if parts >= starts.count { return ""; }
    if n > 0 && out[n - 1] != '/' { if n >= out.count { return ""; } out[n] = '/'; n += 1; }
    if n + part.count > out.count { return ""; }
    starts[parts] = n; parts += 1;
    for c: part { out[n] = c; n += 1; }
  }
  if n == 0 { if out.count < 1 { return ""; } out[0] = '.'; n = 1; }
  return cast(string) out[0..<n];
}
#test "paths resolve as the compiler's #load does" {
  o: [256] u8;
  #assert ws_resolve("apps/openagents-web", "../../metaverse-engine/move/player.coax", o[..]) == "metaverse-engine/move/player.coax";
  #assert ws_resolve("verse/everglade", "plan.coax", o[..]) == "verse/everglade/plan.coax";
  #assert ws_resolve("verse/everglade", "./../style.coax", o[..]) == "verse/style.coax";
  #assert ws_resolve("a", "../../b.coax", o[..]) == "../b.coax";
  #assert ws_resolve(".", "x.coax", o[..]) == "x.coax";
  #assert ws_resolve("a/b", "/abs/c/../d.coax", o[..]) == "/abs/d.coax";
  #assert ws_resolve("/r/a", "../b.coax", o[..]) == "/r/b.coax";
  small: [4] u8;
  #assert ws_resolve("abc", "def", small[..]) == "";
}

ws_path :: (c: [] Closure, i: int) -> string { return cast(string) c[0].arena[c[0].at[i]..<c[0].at[i] + c[0].len[i]]; }
// Adds path once; false only when the closure is full.
ws_add :: (c: [] Closure, path: string) -> bool {
  for i: 0..<c[0].n { if ws_path(c, i) == path { return true; } }
  if c[0].n >= WS_PATHS || c[0].used + path.count > WS_ARENA { c[0].full = true; return false; }
  at := c[0].used;
  for k: 0..<path.count { c[0].arena[at + k] = path[k]; }
  c[0].at[c[0].n] = at; c[0].len[c[0].n] = path.count; c[0].n += 1; c[0].used = at + path.count;
  return true;
}
// The #load paths of one unit's text (a directive starts its line), resolved
// beside the unit, into the closure; an #import_proto marks it.
ws_scan :: (c: [] Closure, unit: string, text: string) -> bool {
  dir := fs_dir(unit);
  o: [8192] u8;
  i := 0;
  while i < text.count {
    e := i;
    while e < text.count && text[e] != '\n' { e += 1; }
    s := i;
    while s < e && (text[s] == ' ' || text[s] == '\t') { s += 1; }
    line := text[s..<e]; i = e + 1;
    if line.count >= 13 && line[0..<13] == "#import_proto" { c[0].proto = true; continue; }
    if line.count < 7 || line[0..<7] != "#load \"" { continue; }
    q := 7;
    while q < line.count && line[q] != '"' { q += 1; }
    if q >= line.count { continue; }
    path := ws_resolve(dir, line[7..<q], o[..]);
    if path.count == 0 || !ws_add(c, path) { return false; }
  }
  return true;
}
#test "a unit's loads, once each, beside it" {
  c: [1] Closure;
  #assert ws_add(c[..], "apps/w/a.coax");
  t := "#import \"Basic\";\n#load \"b.coax\";\n  #load \"../../verse/c.coax\" as c;\n// #load \"no.coax\";\nx := \"#load \\\"no\\\"\";\n#load \"b.coax\";";
  #assert ws_scan(c[..], "apps/w/a.coax", t) && c[0].n == 3 && !c[0].proto;
  #assert ws_path(c[..], 1) == "apps/w/b.coax" && ws_path(c[..], 2) == "verse/c.coax";
  #assert ws_scan(c[..], "apps/w/b.coax", "#import_proto \"x.proto\";\n") && c[0].proto && c[0].n == 3;
}

ws_sources :: (a: [] Args) -> int {
  c: [1] Closure;
  for k: 1..<args_count(a) { if !ws_add(c[..], args_at(a, k)) { tool_errln("wasm-size: too many units"); return 2; } }
  body: [WS_FILE] u8;
  i := 0;
  while i < c[0].n {
    unit := ws_path(c[..], i);
    n := fs_read(unit, body[..]);
    if n < 0 { tool_err("wasm-size: can't read "); tool_errln(unit); return 1; }
    if !ws_scan(c[..], unit, cast(string) body[0..<n]) { tool_errln("wasm-size: the closure is too large"); return 2; }
    i += 1;
  }
  for k: 0..<c[0].n { print("%\n", ws_path(c[..], k)); }
  return ifx c[0].proto then 3 else 0;
}

// #export_c symbols, by unit: what each unit's C library defines globally.
WS_EXPORTS :: 16384;
Exports :: struct {
  arena: [WS_ARENA] u8; used: int;
  name_at: [WS_EXPORTS] int; name_len: [WS_EXPORTS] int;
  file_at: [WS_EXPORTS] int; file_len: [WS_EXPORTS] int;
  unit: [WS_EXPORTS] int; n: int;
}
ws_ex_name :: (e: [] Exports, i: int) -> string { return cast(string) e[0].arena[e[0].name_at[i]..<e[0].name_at[i] + e[0].name_len[i]]; }
ws_ex_file :: (e: [] Exports, i: int) -> string { return cast(string) e[0].arena[e[0].file_at[i]..<e[0].file_at[i] + e[0].file_len[i]]; }
ws_ex_keep :: (e: [] Exports, s: string) -> int {
  if e[0].used + s.count > WS_ARENA { return -1; }
  at := e[0].used;
  for k: 0..<s.count { e[0].arena[at + k] = s[k]; }
  e[0].used = at + s.count;
  return at;
}
// Records unit's symbol name, from file, once a unit; false only when full.
ws_ex_add :: (e: [] Exports, name: string, unit: int, file: string) -> bool {
  for i: 0..<e[0].n { if e[0].unit[i] == unit && ws_ex_name(e, i) == name { return true; } }
  if e[0].n >= WS_EXPORTS { return false; }
  na := ws_ex_keep(e, name); fa := ws_ex_keep(e, file);
  if na < 0 || fa < 0 { return false; }
  i := e[0].n;
  e[0].name_at[i] = na; e[0].name_len[i] = name.count; e[0].file_at[i] = fa; e[0].file_len[i] = file.count;
  e[0].unit[i] = unit; e[0].n = i + 1;
  return true;
}
// The earlier entry in which another unit defines entry i's symbol, or -1.
ws_ex_dup :: (e: [] Exports, i: int) -> int {
  for j: 0..<i { if e[0].unit[j] != e[0].unit[i] && ws_ex_name(e, j) == ws_ex_name(e, i) { return j; } }
  return -1;
}
ws_ident :: (c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }
// One file's #export_c procedures, as unit's: a declaration (NAME :: at the
// start of its line) whose signature, on that line or a later one, carries
// #export_c outside a comment and a string.
ws_ex_scan :: (e: [] Exports, unit: int, file: string, text: string) -> bool {
  name := "";
  i := 0;
  while i < text.count {
    eol := i;
    while eol < text.count && text[eol] != '\n' { eol += 1; }
    line := text[i..<eol]; i = eol + 1;
    code := line; quotes := 0;
    for k: 0..<line.count {
      if line[k] == '"' { quotes += 1; }
      if quotes % 2 == 0 && k + 1 < line.count && line[k] == '/' && line[k + 1] == '/' { code = line[0..<k]; break; }
    }
    mark := -1; quotes = 0;
    for k: 0..<code.count {
      if code[k] == '"' { quotes += 1; }
      if mark < 0 && quotes % 2 == 0 && k + 9 <= code.count && code[k..<k + 9] == "#export_c" && (k + 9 == code.count || !ws_ident(code[k + 9])) { mark = k; }
    }
    s := 0;
    while s < code.count && (code[s] == ' ' || code[s] == '\t') { s += 1; }
    t := s;
    while t < code.count && ws_ident(code[t]) { t += 1; }
    u := t;
    while u < code.count && code[u] == ' ' { u += 1; }
    if t > s && u + 1 < code.count && code[u] == ':' && code[u + 1] == ':' { name = code[s..<t]; }
    if mark >= 0 && name.count > 0 && !ws_ex_add(e, name, unit, file) { return false; }
  }
  return true;
}
#test "#export_c procedures, by name, outside comments and strings" {
  e: [1] Exports;
  t := "S_seed :: (n: int) -> int { return n; }\nS_hash :: (input: string) -> S_Digest #export_c {\n  x :: 3;\n}\nwalk :: (a: int,\n         b: int) -> int #export_c { return a; }\n// old :: () #export_c {}\nnote :: () { s := \"y :: () #export_c\"; }\nquiet :: () -> int { return 0; } // #export_c later\nnear :: () -> int #export_cx;\n";
  #assert ws_ex_scan(e[..], 0, "k.coax", t) && e[0].n == 2;
  #assert ws_ex_name(e[..], 0) == "S_hash" && ws_ex_name(e[..], 1) == "walk" && ws_ex_file(e[..], 1) == "k.coax";
}
#test "a symbol two units define names both units; one unit's, loaded twice, is once" {
  e: [1] Exports;
  k := "S_hex :: (d: int) -> bool #export_c { return true; }\n";
  #assert ws_ex_scan(e[..], 0, "sha.coax", k) && ws_ex_scan(e[..], 0, "sha.coax", k) && e[0].n == 1;
  #assert ws_ex_scan(e[..], 1, "wire.coax", "wire_open :: () -> int #export_c { return 1; }\n") && e[0].n == 2;
  #assert ws_ex_dup(e[..], 0) == -1 && ws_ex_dup(e[..], 1) == -1;
  #assert ws_ex_scan(e[..], 2, "sha.coax", k) && e[0].n == 3;
  #assert ws_ex_dup(e[..], 2) == 0 && ws_ex_file(e[..], 2) == "sha.coax";
}

// Each unit's closure and its #export_c symbols; every symbol two units define, named.
ws_exports :: (a: [] Args) -> int {
  units: [1] Closure; e: [1] Exports; c: [1] Closure;
  for k: 1..<args_count(a) { if !ws_add(units[..], args_at(a, k)) { tool_errln("wasm-size: too many units"); return 2; } }
  body: [WS_FILE] u8;
  for u: 0..<units[0].n {
    c[0].used = 0; c[0].n = 0; c[0].proto = false; c[0].full = false;
    if !ws_add(c[..], ws_path(units[..], u)) { return 2; }
    i := 0;
    while i < c[0].n {
      file := ws_path(c[..], i);
      n := fs_read(file, body[..]);
      if n < 0 { i += 1; continue; }   // not there yet (a generated file): the compiler says so, this names only duplicates
      text := cast(string) body[0..<n];
      if !ws_scan(c[..], file, text) { tool_errln("wasm-size: the closure is too large"); return 2; }
      if !ws_ex_scan(e[..], u, file, text) { tool_errln("wasm-size: too many #export_c symbols"); return 2; }
      i += 1;
    }
  }
  twice := 0;
  for i: 0..<e[0].n {
    j := ws_ex_dup(e[..], i);
    if j < 0 { continue; }
    twice += 1;
    tool_err("wasm-size: "); tool_err(ws_ex_name(e[..], i)); tool_err(" is #export_c in "); tool_err(ws_ex_file(e[..], i));
    tool_err(", which units "); tool_err(ws_path(units[..], e[0].unit[j])); tool_err(" and "); tool_err(ws_path(units[..], e[0].unit[i]));
    tool_errln(" both load: wasm-ld would find it twice. Load it in one unit (a carrier that #loads the other, as apps/openagents-web/carriers/ do).");
  }
  return ifx twice > 0 then 1 else 0;
}

// An unsigned LEB128 at at[0] in m, moving at[0] past it; -1 when it runs off the end.
ws_leb :: (m: string, at: [] int) -> int {
  v := 0; shift := 0;
  while at[0] < m.count && shift < 63 {
    b := cast(int) m[at[0]]; at[0] += 1;
    v += (b & 127) << shift;
    if b < 128 { return v; }
    shift += 7;
  }
  return -1;
}
#test "LEB128 reads and stops at the end" {
  at: [1] int;
  one := [1] u8.[2]; three := [3] u8.[0xe5, 0x8e, 0x26]; cut := [1] u8.[0x80];
  #assert ws_leb(cast(string) one[..], at[..]) == 2 && at[0] == 1;
  at[0] = 0;
  #assert ws_leb(cast(string) three[..], at[..]) == 624485 && at[0] == 3;
  at[0] = 0;
  #assert ws_leb(cast(string) cut[..], at[..]) == -1;
}
SECTION_NAMES :: [13] string.["custom", "type", "import", "function", "table", "memory", "global", "export", "start", "element", "code", "data", "datacount"];

ws_report :: (a: [] Args) -> int {
  m: [WS_FILE] u8;
  file := args_at(a, 1);
  mn := fs_read(file, m[..]);
  if mn < 8 { tool_err("wasm-size: can't read the module "); tool_errln(file); return 1; }
  w := cast(string) m[0..<mn];
  if w[0] != 0 || w[1..<4] != "asm" { tool_err("wasm-size: not a wasm module: "); tool_errln(file); return 1; }
  top := 25;
  if args_count(a) > 2 {
    t := args_at(a, 2); top = 0;
    for ch: t { if ch >= '0' && ch <= '9' { top = top * 10 + cast(int) (ch - '0'); } }
  }
  size: [WS_FUNCS] int; name_at: [WS_FUNCS] int; name_len: [WS_FUNCS] int;
  imported := 0; bodies := 0; code_bytes := 0; data_bytes := 0; segments := 0;
  print("%: % bytes\n", file, mn);
  at: [1] int; at[0] = 8;
  while at[0] < mn {
    id := cast(int) w[at[0]]; at[0] += 1;
    slen := ws_leb(w, at[..]);
    if slen < 0 || at[0] + slen > mn { tool_errln("wasm-size: a section runs past the end"); return 1; }
    start := at[0]; end := start + slen;
    p: [1] int; p[0] = start;
    if id == 0 {
      nl := ws_leb(w, p[..]);
      label := w[p[0]..<p[0] + nl]; p[0] += nl;
      print("  %  custom \"%\"\n", slen, label);
      if label == "name" {
        while p[0] < end {
          sub := cast(int) w[p[0]]; p[0] += 1;
          sl := ws_leb(w, p[..]); se := p[0] + sl;
          if sub == 1 {
            count := ws_leb(w, p[..]);
            for k: 0..<count {
              idx := ws_leb(w, p[..]); l := ws_leb(w, p[..]);
              if idx >= 0 && idx < WS_FUNCS { name_at[idx] = p[0]; name_len[idx] = l; }
              p[0] += l;
            }
          }
          p[0] = se;
        }
      }
    } else {
      print("  %  %\n", slen, ifx id < 13 then SECTION_NAMES[id] else "unknown");
    }
    if id == 2 {
      count := ws_leb(w, p[..]);
      for k: 0..<count {
        l := ws_leb(w, p[..]); p[0] += l;
        l = ws_leb(w, p[..]); p[0] += l;
        kind := cast(int) w[p[0]]; p[0] += 1;
        if kind == 0 { t := ws_leb(w, p[..]); imported += 1; }
        else if kind == 1 { p[0] += 1; flags := ws_leb(w, p[..]); lo := ws_leb(w, p[..]); if (flags & 1) != 0 { hi := ws_leb(w, p[..]); } }
        else if kind == 2 { flags := ws_leb(w, p[..]); lo := ws_leb(w, p[..]); if (flags & 1) != 0 { hi := ws_leb(w, p[..]); } }
        else if kind == 3 { p[0] += 2; }
        else { p[0] += 1; t := ws_leb(w, p[..]); }
      }
    }
    if id == 10 {
      count := ws_leb(w, p[..]);
      for k: 0..<count {
        l := ws_leb(w, p[..]);
        if bodies < WS_FUNCS { size[bodies] = l; bodies += 1; }
        code_bytes += l; p[0] += l;
      }
    }
    if id == 11 {
      count := ws_leb(w, p[..]);
      for k: 0..<count {
        flag := ws_leb(w, p[..]);
        if flag == 2 { mem := ws_leb(w, p[..]); }
        if flag != 1 {   // the offset expression, up to its end (0x0b)
          while p[0] < end && cast(int) w[p[0]] != 11 {
            op := cast(int) w[p[0]]; p[0] += 1;
            if op == 0x41 || op == 0x42 || op == 0x23 { while p[0] < end && cast(int) w[p[0]] >= 128 { p[0] += 1; } p[0] += 1; }
          }
          p[0] += 1;
        }
        l := ws_leb(w, p[..]); p[0] += l; data_bytes += l; segments += 1;
      }
    }
    at[0] = end;
  }
  print("% functions, % bytes of code; % data segments, % bytes\n", bodies, code_bytes, segments, data_bytes);
  print("the % biggest functions:\n", top);
  taken: [WS_FUNCS] bool;
  for r: 0..<top {
    best := -1;
    for k: 0..<bodies { if !taken[k] && (best < 0 || size[k] > size[best]) { best = k; } }
    if best < 0 { break; }
    taken[best] = true;
    idx := imported + best;
    label := ifx name_len[idx] > 0 then w[name_at[idx]..<name_at[idx] + name_len[idx]] else "(no name section)";
    print("  %  %\n", size[best], label);
  }
  return 0;
}

// A module without its "name" custom section into out (its length), and the function names as
// "INDEX NAME" lines into syms (sn[0] their length). -1 when m is not a module or something doesn't fit.
ws_split :: (m: string, out: [] u8, syms: [] u8, sn: [] int) -> int {
  sn[0] = 0;
  if m.count < 8 || m[0] != 0 || m[1..<4] != "asm" || out.count < m.count { return -1; }
  for i: 0..<8 { out[i] = m[i]; }
  on := 8; at: [1] int; at[0] = 8; d: [24] u8;
  while at[0] < m.count {
    from := at[0];
    id := cast(int) m[at[0]]; at[0] += 1;
    slen := ws_leb(m, at[..]);
    if slen < 0 || at[0] + slen > m.count { return -1; }
    end := at[0] + slen;
    p: [1] int; p[0] = at[0];
    named := false;
    if id == 0 {
      nl := ws_leb(m, p[..]);
      named = nl == 4 && p[0] + 4 <= end && m[p[0]..<p[0] + 4] == "name";
      p[0] += 4;
    }
    if !named {
      for i: from..<end { out[on + i - from] = m[i]; }
      on += end - from;
    }
    while named && p[0] < end {
      sub := cast(int) m[p[0]]; p[0] += 1;
      sl := ws_leb(m, p[..]); se := p[0] + sl;
      if sl < 0 || se > end { return -1; }
      if sub == 1 {
        count := ws_leb(m, p[..]);
        for k: 0..<count {
          idx := ws_leb(m, p[..]); l := ws_leb(m, p[..]);
          if idx < 0 || l < 0 || p[0] + l > se { return -1; }
          num := ws_num(idx, d[..]);
          if sn[0] + num.count + l + 2 > syms.count { return -1; }
          for i: 0..<num.count { syms[sn[0] + i] = num[i]; }
          sn[0] += num.count; syms[sn[0]] = ' '; sn[0] += 1;
          for i: 0..<l { c := m[p[0] + i]; syms[sn[0] + i] = ifx c == '\n' then cast(u8) ' ' else c; }
          sn[0] += l; syms[sn[0]] = '\n'; sn[0] += 1;
          p[0] += l;
        }
      }
      p[0] = se;
    }
    at[0] = end;
  }
  return on;
}
#test "symbols: the name section leaves the module and its function names become lines" {
  // a header, a type section (id 1, empty vector), the name section (functions 0 "f" and 7 "go"), a custom "x"
  m := [35] u8.[0, 0x61, 0x73, 0x6d, 1, 0, 0, 0,  1, 1, 0,
                0, 19, 4, 0x6e, 0x61, 0x6d, 0x65,  0, 2, 1, 0x6d,  1, 8, 2, 0, 1, 0x66, 7, 2, 0x67, 0x6f,
                0, 2, 1];
  full: [36] u8; for i: 0..<35 { full[i] = m[i]; } full[35] = 0x78;
  out: [64] u8; syms: [64] u8; sn: [1] int;
  n := ws_split(cast(string) full[..], out[..], syms[..], sn[..]);
  #assert n == 15 && cast(string) syms[0..<sn[0]] == "0 f\n7 go\n";
  #assert cast(string) out[0..<11] == cast(string) full[0..<11] && cast(string) out[11..<15] == cast(string) full[32..<36];
  #assert ws_split(cast(string) full[0..<20], out[..], syms[..], sn[..]) == -1;        // a section past the end
  #assert ws_split(cast(string) full[..], out[0..<35], syms[..], sn[..]) == -1 && ws_split("", out[..], syms[..], sn[..]) == -1;
  #assert ws_split(cast(string) full[..], out[..], syms[0..<6], sn[..]) == -1;
  n = ws_split(cast(string) full[0..<11], out[..], syms[..], sn[..]);
  #assert n == 11 && sn[0] == 0;                                                      // no names: the same bytes
}
ws_symbols :: (a: [] Args) -> int {
  m: [WS_FILE] u8; out: [WS_FILE] u8; syms: [WS_FILE / 4] u8; sn: [1] int;
  mn := fs_read(args_at(a, 1), m[..]);
  if mn < 8 { tool_err("wasm-size: can't read the module "); tool_errln(args_at(a, 1)); return 2; }
  n := ws_split(cast(string) m[0..<mn], out[..], syms[..], sn[..]);
  if n < 0 { tool_err("wasm-size: not a wasm module, or its names don't fit: "); tool_errln(args_at(a, 1)); return 2; }
  if sn[0] == 0 { tool_err("wasm-size: no function names in "); tool_errln(args_at(a, 1)); return 1; }
  if !fs_write(args_at(a, 2), cast(string) out[0..<n]) || !fs_write(args_at(a, 3), cast(string) syms[0..<sn[0]]) {
    tool_errln("wasm-size: can't write the module or its symbols"); return 2;
  }
  return 0;
}

// ---- the state's field table, carried by a development module (#13411) ------
WS_STATE_SECTION :: "coaxial.state";
// n as an unsigned LEB128 into out; how many bytes (0 when it doesn't fit).
ws_put_leb :: (n: int, out: [] u8) -> int {
  v := n; k := 0;
  while true {
    if k >= out.count { return 0; }
    b := v & 127; v = v >> 7;
    out[k] = cast(u8) (ifx v > 0 then b | 128 else b); k += 1;
    if v == 0 { return k; }
  }
  return 0;
}
// m without any "coaxial.state" section, then one holding `table`, into out (its length).
// -1 when m is not a module or the result doesn't fit.
ws_state :: (m: string, table: string, out: [] u8) -> int {
  if m.count < 8 || m[0] != 0 || m[1..<4] != "asm" || out.count < 8 { return -1; }
  for i: 0..<8 { out[i] = m[i]; }
  on := 8; at: [1] int; at[0] = 8;
  while at[0] < m.count {
    from := at[0];
    id := cast(int) m[at[0]]; at[0] += 1;
    slen := ws_leb(m, at[..]);
    if slen < 0 || at[0] + slen > m.count { return -1; }
    end := at[0] + slen;
    p: [1] int; p[0] = at[0];
    ours := false;
    if id == 0 {
      nl := ws_leb(m, p[..]);
      ours = nl == WS_STATE_SECTION.count && p[0] + nl <= end && m[p[0]..<p[0] + nl] == WS_STATE_SECTION;
    }
    if !ours {
      if on + end - from > out.count { return -1; }
      for i: from..<end { out[on + i - from] = m[i]; }
      on += end - from;
    }
    at[0] = end;
  }
  d: [10] u8;
  body := 1 + WS_STATE_SECTION.count + table.count;   // the name's length (one byte), the name, the table
  dn := ws_put_leb(body, d[..]);
  if dn == 0 || on + 1 + dn + body > out.count { return -1; }
  out[on] = 0; on += 1;
  for i: 0..<dn { out[on + i] = d[i]; } on += dn;
  out[on] = cast(u8) WS_STATE_SECTION.count; on += 1;
  for c, i: WS_STATE_SECTION { out[on + i] = c; } on += WS_STATE_SECTION.count;
  for c, i: table { out[on + i] = c; } on += table.count;
  return on;
}
#test "state: the table is the module's last section, once, and its length reads back" {
  m := [11] u8.[0, 0x61, 0x73, 0x6d, 1, 0, 0, 0,  1, 1, 0];   // a header and an empty type section
  out: [512] u8; again: [512] u8;
  n := ws_state(cast(string) m[..], "S  size 8  align 8\n", out[..]);
  #assert n == 11 + 2 + 14 + 19 && cast(string) out[0..<11] == cast(string) m[..];
  #assert out[11] == 0 && out[12] == 33 && out[13] == 13 && cast(string) out[14..<27] == "coaxial.state" && cast(string) out[27..<n] == "S  size 8  align 8\n";
  // a second table replaces the first; a table past 127 bytes takes a two-byte length
  long: [200] u8; for i: 0..<200 { long[i] = 'x'; }
  k := ws_state(cast(string) out[0..<n], cast(string) long[..], again[..]);
  at: [1] int; at[0] = 12;
  #assert k == 11 + 3 + 14 + 200 && again[11] == 0 && ws_leb(cast(string) again[0..<k], at[..]) == 214 && at[0] == 14;
  #assert ws_state(cast(string) again[0..<k], "", out[..]) == 11 + 2 + 14;
  #assert ws_state("", "t", out[..]) == -1 && ws_state(cast(string) m[..], "t", out[0..<20]) == -1 && ws_state(cast(string) m[0..<10], "t", out[..]) == -1;
  d: [2] u8; #assert ws_put_leb(0, d[..]) == 1 && d[0] == 0 && ws_put_leb(300, d[..]) == 2 && d[0] == 0xac && d[1] == 2 && ws_put_leb(70000, d[..]) == 0;
}
ws_state_verb :: (a: [] Args) -> int {
  m: [WS_FILE] u8; out: [WS_FILE] u8; t: [WS_FILE / 4] u8;
  mn := fs_read(args_at(a, 1), m[..]); tn := fs_read(args_at(a, 2), t[..]);
  if mn < 8 { tool_err("wasm-size: can't read the module "); tool_errln(args_at(a, 1)); return 2; }
  if tn <= 0 { tool_err("wasm-size: can't read the state's layout "); tool_errln(args_at(a, 2)); return 2; }
  n := ws_state(cast(string) m[0..<mn], cast(string) t[0..<tn], out[..]);
  if n < 0 { tool_err("wasm-size: not a wasm module, or it doesn't fit with its state's layout: "); tool_errln(args_at(a, 1)); return 2; }
  if !fs_write(args_at(a, 3), cast(string) out[0..<n]) { tool_errln("wasm-size: can't write the module"); return 2; }
  return 0;
}

// ---- size budgets (apps/openagents-web/wasm-budgets.txt) --------------------

// n in decimal, into out.
ws_num :: (n: int, out: [] u8) -> string {
  if n < 0 { return "-"; }
  k := out.count;
  v := n;
  while true {
    k -= 1; out[k] = cast,trunc(u8) (cast(int) '0' + v % 10); v = v / 10;
    if v == 0 || k == 0 { break; }
  }
  return cast(string) out[k..<out.count];
}
// A budget line's bytes: a positive decimal; -1 when it isn't one.
ws_bytes :: (s: string) -> int {
  if s.count == 0 || s.count > 12 { return -1; }
  v := 0;
  for ch: s { if ch < '0' || ch > '9' { return -1; } v = v * 10 + cast(int) (ch - '0'); }
  return ifx v > 0 then v else -1;
}
// The next field of line from at[0] (spaces and tabs between), moving at[0] past it.
ws_field :: (line: string, at: [] int) -> string {
  s := at[0];
  while s < line.count && (line[s] == ' ' || line[s] == '\t' || line[s] == '\r') { s += 1; }
  e := s;
  while e < line.count && line[e] != ' ' && line[e] != '\t' && line[e] != '\r' { e += 1; }
  at[0] = e;
  return line[s..<e];
}
// The budgets file's lines into names and bytes (a "#" line and a blank one
// say nothing): the count, or -(line number) of the first line that is not
// NAME BYTES, or that names a module a second time.
ws_budget_lines :: (text: string, names: [] Closure, bytes: [] int) -> int {
  i := 0; line_no := 0;
  while i < text.count {
    e := i;
    while e < text.count && text[e] != '\n' { e += 1; }
    line := text[i..<e]; i = e + 1; line_no += 1;
    at: [1] int;
    name := ws_field(line, at[..]);
    if name.count == 0 || name[0] == '#' { continue; }
    n := ws_bytes(ws_field(line, at[..]));
    if n < 0 || ws_field(line, at[..]).count > 0 { return -line_no; }
    before := names[0].n;
    if before >= bytes.count || !ws_add(names, name) || names[0].n == before { return -line_no; }
    bytes[before] = n;
  }
  return names[0].n;
}
// The line naming name, or -1.
ws_budget_of :: (names: [] Closure, name: string) -> int {
  for k: 0..<names[0].n { if ws_path(names, k) == name { return k; } }
  return -1;
}
// Every module a build script writes ("$here/build/NAME.wasm"), once each,
// into built; false only when full.
ws_built :: (text: string, built: [] Closure) -> bool {
  mark := "$here/build/";
  i := 0;
  while i + mark.count <= text.count {
    if text[i..<i + mark.count] != mark { i += 1; continue; }
    s := i + mark.count; e := s;
    while e < text.count && (ws_ident(text[e]) || text[e] == '-') { e += 1; }
    if e > s && e + 5 <= text.count && text[e..<e + 5] == ".wasm" && (e + 5 == text.count || !ws_ident(text[e + 5])) {
      if !ws_add(built, text[s..<e]) { return false; }
    }
    i = e;
  }
  return true;
}
#test "budget lines: NAME BYTES, comments and blanks skipped, a bad or second line named" {
  names: [1] Closure; bytes: [64] int;
  #assert ws_budget_lines("# NAME BYTES\n\noneshot 320000\n  everglade\t2000000\r\n", names[..], bytes[..]) == 2;
  #assert ws_path(names[..], 1) == "everglade" && bytes[1] == 2000000 && bytes[0] == 320000;
  #assert ws_budget_of(names[..], "oneshot") == 0 && ws_budget_of(names[..], "everglade") == 1 && ws_budget_of(names[..], "villa") == -1;
  again: [1] Closure;
  #assert ws_budget_lines("a 1\nb 2\na 3\n", again[..], bytes[..]) == -3;
  b1: [1] Closure; #assert ws_budget_lines("a\n", b1[..], bytes[..]) == -1;
  b2: [1] Closure; #assert ws_budget_lines("a 12x\n", b2[..], bytes[..]) == -1;
  b3: [1] Closure; #assert ws_budget_lines("# x\na 0\n", b3[..], bytes[..]) == -2;
  b4: [1] Closure; #assert ws_budget_lines("a 1 2\n", b4[..], bytes[..]) == -1;
  b5: [1] Closure; #assert ws_budget_lines("a -4\n", b5[..], bytes[..]) == -1;
  few: [1] int; b6: [1] Closure;
  #assert ws_budget_lines("a 1\nb 2\n", b6[..], few[..]) == -2;
  #assert ws_bytes("1999999") == 1999999 && ws_bytes("9") == 9 && ws_bytes("") == -1 && ws_bytes("1234567890123") == -1;
  o: [24] u8;
  #assert ws_num(0, o[..]) == "0" && ws_num(924684, o[..]) == "924684" && ws_num(-1, o[..]) == "-";
}
#test "the modules a build script writes, once each" {
  b: [1] Closure;
  t := "# Builds build/splash.wasm and build/nope.wasm\nwasm.sh \"$here/splash.coax\" \"$here/face.c\" \"$here/build/splash.wasm\" &\nvoice/build.sh \"$here/build/voice.wasm\"\nx \"$here/build/connect-pylon.wasm\" \"$here/build/splash.wasm\"\ncp \"$here/build/zeron/\" \"$here/build/a.wasmx\" \"$here/build/.wasm\" \"$here/build/b_2.wasm\"";
  #assert ws_built(t, b[..]) && b[0].n == 4;
  #assert ws_path(b[..], 0) == "splash" && ws_path(b[..], 1) == "voice" && ws_path(b[..], 2) == "connect-pylon" && ws_path(b[..], 3) == "b_2";
}
ws_bad_line :: (file: string, line: int) {
  o: [24] u8;
  tool_err("wasm-size: "); tool_err(file); tool_err(":"); tool_err(ws_num(line, o[..]));
  tool_errln(": not a NAME BYTES line, or a module named twice");
}

// wasm-size budgets BUDGETS SCRIPT...: every module the scripts write has a
// line in BUDGETS, and every line names a module one of them writes.
ws_budgets :: (a: [] Args) -> int {
  body: [WS_FILE] u8;
  file := args_at(a, 1);
  n := fs_read(file, body[..]);
  if n < 0 { tool_err("wasm-size: can't read "); tool_errln(file); return 2; }
  names: [1] Closure; bytes: [WS_PATHS] int;
  lines := ws_budget_lines(cast(string) body[0..<n], names[..], bytes[..]);
  if lines < 0 { ws_bad_line(file, -lines); return 1; }
  built: [1] Closure;
  for k: 2..<args_count(a) {
    script := args_at(a, k);
    m := fs_read(script, body[..]);
    if m < 0 { tool_err("wasm-size: can't read "); tool_errln(script); return 2; }
    if !ws_built(cast(string) body[0..<m], built[..]) { tool_errln("wasm-size: too many modules"); return 2; }
  }
  wrong := 0;
  for k: 0..<built[0].n {
    name := ws_path(built[..], k);
    if ws_budget_of(names[..], name) >= 0 { continue; }
    wrong += 1;
    tool_err("wasm-size: "); tool_err(name); tool_err(".wasm has no size budget: add a line \""); tool_err(name); tool_err(" BYTES\" to "); tool_errln(file);
  }
  for k: 0..<names[0].n {
    name := ws_path(names[..], k);
    if ws_budget_of(built[..], name) >= 0 { continue; }
    wrong += 1;
    tool_err("wasm-size: "); tool_err(file); tool_err(" has a line for "); tool_err(name); tool_errln(", which no build script writes: take it out");
  }
  return ifx wrong > 0 then 1 else 0;
}

// A module up to 2% over its line only warns: a small overrun never stops a release.
ws_within_slack :: (size: int, budget: int) -> bool { return size * 100 <= budget * 102; }

#test "up to 2% over a budget warns, more stops" {
  #assert ws_within_slack(1000, 1000);
  #assert ws_within_slack(1020, 1000);
  #assert !ws_within_slack(1021, 1000);
  #assert ws_within_slack(975000, 970000);
  #assert !ws_within_slack(990000, 970000);
}

// wasm-size budget BUDGETS NAME FILE.wasm: the module against its line. Exit
// 0 within it or up to 2% over it (a warning), 1 more than 2% over, 4 when it has no line.
ws_budget :: (a: [] Args) -> int {
  body: [WS_FILE] u8;
  file := args_at(a, 1); name := args_at(a, 2); module := args_at(a, 3);
  n := fs_read(file, body[..]);
  if n < 0 { tool_err("wasm-size: can't read "); tool_errln(file); return 2; }
  names: [1] Closure; bytes: [WS_PATHS] int;
  lines := ws_budget_lines(cast(string) body[0..<n], names[..], bytes[..]);
  if lines < 0 { ws_bad_line(file, -lines); return 2; }
  size := fs_read(module, body[..]);
  if size < 0 { tool_err("wasm-size: can't read "); tool_errln(module); return 2; }
  o: [24] u8;
  k := ws_budget_of(names[..], name);
  if k < 0 {
    tool_err("wasm-size: "); tool_err(name); tool_err(" is "); tool_err(ws_num(size, o[..]));
    tool_err(" bytes and has no size budget: add a line \""); tool_err(name); tool_err(" BYTES\" to "); tool_errln(file);
    return 4;
  }
  if size <= bytes[k] { return 0; }
  if ws_within_slack(size, bytes[k]) {   // up to 2% over warns, never stops a build, release or room deploy
    tool_err("wasm-size: warning: "); tool_err(name); tool_err(" is "); tool_err(ws_num(size, o[..]));
    tool_err(" bytes, over its budget of "); tool_err(ws_num(bytes[k], o[..])); tool_err(" by less than 2% (raise it in "); tool_err(file); tool_errln(")");
    return 0;
  }
  tool_err("wasm-size: "); tool_err(name); tool_err(" is "); tool_err(ws_num(size, o[..]));
  tool_err(" bytes, over its budget of "); tool_err(ws_num(bytes[k], o[..])); tool_err(" ("); tool_err(file); tool_errln(")");
  return 1;
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  ok := args_load(a[..]);
  verb := args_at(a[..], 0);
  if ok && verb == "sources" && args_count(a[..]) >= 2 { return ws_sources(a[..]); }
  if ok && verb == "exports" && args_count(a[..]) >= 2 { return ws_exports(a[..]); }
  if ok && verb == "report" && args_count(a[..]) >= 2 { return ws_report(a[..]); }
  if ok && verb == "budgets" && args_count(a[..]) >= 3 { return ws_budgets(a[..]); }
  if ok && verb == "budget" && args_count(a[..]) == 4 { return ws_budget(a[..]); }
  if ok && verb == "symbols" && args_count(a[..]) == 4 { return ws_symbols(a[..]); }
  if ok && verb == "state" && args_count(a[..]) == 4 { return ws_state_verb(a[..]); }
  tool_errln("usage: wasm-size sources UNIT.coax... | wasm-size exports UNIT.coax... | wasm-size report FILE.wasm [N] | wasm-size budgets BUDGETS SCRIPT... | wasm-size budget BUDGETS NAME FILE.wasm | wasm-size symbols IN.wasm OUT.wasm OUT.syms | wasm-size state IN.wasm LAYOUT OUT.wasm");
  return 2;
}
