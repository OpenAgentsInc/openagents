// A page's whole WGSL module from Coax (docs/metaverse/native-gpu.md, G6): `coax wgsl` writes
// the vertex and fragment entries named, everything they call, their structs and their
// bindings (lib/compiler/wgsl.coax), and this writes them to OUT under one header line.
// The bindings file gives each resource its group and binding as the page's host.js
// layouts have them; --strip takes a prefix off the entries' names (eg_post_fs is post_fs).
//   coax/web/tool.sh coax/web/wgsl-module.coax FILE.coax OUT.wgsl OPTIONS     (from the repo root)
// OPTIONS is a file of `--vertices A,B --fragments C,D --bindings F [--strip P]`, apart by
// spaces or lines, so the page's build and its checks lower the same entries
// (apps/openagents-web/gpu/everglade-v1/gpu.module). OUT is written only when the module changes.
//   coax/web/tool.sh coax/web/wgsl-module.coax --site            every page's module (wm_site)
// The committed .wgsl files are what the dev server, the GPU passes and the golden checks
// read without a build, so they must be what their Coax writes. --check, after either form,
// writes nothing: it names each .wgsl that differs from what its Coax writes now and fails (1).
//   coax/web/tool.sh coax/web/wgsl-module.coax --site --check
// In development (COAXIAL_MODE=dev, what coax serve builds) each module also gets its
// dependency list, APP/build/.live/NAME.wgsl.deps beside the app that loads it (#13410): every
// file its `coax wgsl` read (what `coax deps` names, the options and bindings files) and the
// command that writes this module alone again. coax serve watches those files, runs the command
// when one changes, and tells the tabs "wgsl" (coax/web/serve.c, "What the build read").
#import "Basic";
#load "../lib/sys/tool.coax";
#load "../lib/sys/fs.coax";
#load "../lib/sys/args.coax";
#load "../lib/sys/proc.coax";
#load "../lib/json/json.coax";

WM_PAGE :: 4194304;
WM_TIMEOUT_MS :: 300000;   // each coax wgsl (wm_module)
// Every page's module, as apps/openagents-web/build.sh writes them: v1 Everglade's two (its
// passes and .module files in apps/openagents-web/gpu/everglade-v1/, the puffs' source in
// everglade/client/gpu/gpu-fx.coax), then each NAME.coax with NAME.module in a folder of WM_GPU (the web
// app's, then the game's scene and client: everglade/scene/gpu/, everglade/client/gpu/) to
// apps/openagents-web/NAME.wgsl. gpu/nip.coax is the NIP pages' (nip01.wgsl, generated
// and ignored), which build.sh writes itself.
WM_GPU :: [4] string.["apps/openagents-web/gpu", "everglade/scene/gpu", "everglade/client/gpu", "metaverse/splice-bots/gpu"];
WM_APP :: "apps/openagents-web";
WM_SKIP :: "nip";
// Committed copies of a page's module, each after its source: [copy, source]. The Pylon guide
// (/docs/connect-a-pylon) draws the homepage's Grid, so connect-pylon.wgsl is newland.wgsl byte
// for byte (coax/web/connect-pylon-page.ts writes it too). A --site run writes each copy again
// once its source is written, and --check names a copy that is not its source, so a change to
// newland's Coax can't leave the guide's copy behind (it did twice: 1eafdd7fea, then 9f20bb8394).
WM_COPIES :: [2] string.["apps/openagents-web/connect-pylon.wgsl", "apps/openagents-web/newland.wgsl"];
// wm_module's answers.
WM_SAME :: 0; WM_FAILED :: 1; WM_WRITTEN :: 2; WM_STALE :: 3;
// What a --site run found.
WmTally :: struct { bad: int; stale: int; seen: int; }

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  n := args_load(a[..]);
  count := args_count(a[..]);
  check := n && count > 0 && args_at(a[..], count - 1) == "--check";
  if check { count -= 1; }
  if n && count == 1 && args_at(a[..], 0) == "--site" { return wm_site(check); }
  if !n || count != 3 { tool_errln("usage: wgsl-module FILE.coax OUT.wgsl OPTIONS [--check] | wgsl-module --site [--check]"); return 2; }
  r := wm_module(args_at(a[..], 0), args_at(a[..], 1), args_at(a[..], 2), check);
  if r == WM_STALE { wm_stale(args_at(a[..], 1)); }
  return ifx r == WM_FAILED || r == WM_STALE then 1 else 0;
}
wm_stale :: (into: string) {
  tool_err("stale: "); tool_err(into);
  tool_errln(" differs from what its Coax writes (apps/openagents-web/build.sh writes it; commit the result)");
}
// Every page's module: written, or with check compared; 1 when one failed or is stale.
wm_site :: (check: bool) -> int {
  t: WmTally;
  t = wm_tally(t, wm_module("apps/openagents-web/gpu/everglade-v1/gpu.coax", "apps/openagents-web/everglade.wgsl", "apps/openagents-web/gpu/everglade-v1/gpu.module", check), "apps/openagents-web/everglade.wgsl");
  t = wm_tally(t, wm_module("everglade/client/gpu/gpu-fx.coax", "apps/openagents-web/everglade-fx.wgsl", "apps/openagents-web/gpu/everglade-v1/gpu-fx.module", check), "apps/openagents-web/everglade-fx.wgsl");
  for g: 0..<WM_GPU.count {
    gpu := WM_GPU[g];
    l: [1] FsList;
    k := fs_list(gpu, l[..]);
    if k < 0 || l[0].full { tool_err("wgsl-module: cannot list "); tool_errln(gpu); return 1; }
    for i: 0..<k {
      name := wm_stem(fs_entry(l[..], i));
      if name.count == 0 || name == WM_SKIP { continue; }
      fb: [512] u8; ob: [512] u8; mb: [512] u8;
      file := wm_path(fb[..], gpu, name, ".coax");
      into := wm_path(ob[..], WM_APP, name, ".wgsl");
      opts := wm_path(mb[..], gpu, name, ".module");
      if file.count == 0 || into.count == 0 || opts.count == 0 { tool_err("wgsl-module: name too long: "); tool_errln(name); t.bad += 1; continue; }
      t = wm_tally(t, wm_module(file, into, opts, check), into);
    }
  }
  for c: 0..<WM_COPIES.count / 2 {
    into := WM_COPIES[c * 2]; from := WM_COPIES[c * 2 + 1];
    r := wm_copy(into, from, check);
    if r == WM_STALE { tool_err("stale: "); tool_err(into); tool_err(" is not "); tool_err(from); tool_errln(" (coax/web/tool.sh coax/web/wgsl-module.coax --site copies it; commit the result)"); r = WM_SAME; t.stale += 1; }
    t = wm_tally(t, r, into);
  }
  if check { print("wgsl-module: % module(s) checked, % stale, % failed\n", t.seen, t.stale, t.bad); }
  return ifx t.bad > 0 || t.stale > 0 then 1 else 0;
}
// into made the same as from (a committed copy of a module), or with check only compared.
// WM_SAME, WM_WRITTEN, WM_STALE or WM_FAILED.
wm_copy :: (into: string, from: string, check: bool) -> int {
  src: [WM_PAGE] u8;
  sn := fs_read(from, src[..]);
  if sn < 0 { tool_err("wgsl-module: cannot read "); tool_errln(from); return WM_FAILED; }
  was: [WM_PAGE] u8;
  wn := fs_read(into, was[..]);
  r := wm_copy_answer(wn >= 0, ifx wn >= 0 then cast(string) was[0..<wn] else "", cast(string) src[0..<sn], check);
  if r != WM_WRITTEN { return r; }
  if !fs_write(into, cast(string) src[0..<sn]) { tool_err("wgsl-module: cannot write "); tool_errln(into); return WM_FAILED; }
  return WM_WRITTEN;
}
// What a copy needs: WM_SAME when it is its source, WM_STALE when it is not and check only
// compares, WM_WRITTEN when it is to be written (it differs, or there is none).
wm_copy_answer :: (have: bool, was: string, src: string, check: bool) -> int {
  if have && was == src { return WM_SAME; }
  return ifx check then WM_STALE else WM_WRITTEN;
}
// t with one module's answer r (for into) counted; a stale one is named.
wm_tally :: (t: WmTally, r: int, into: string) -> WmTally {
  u := t;
  u.seen += 1;
  if r == WM_FAILED { u.bad += 1; }
  if r == WM_STALE { u.stale += 1; wm_stale(into); }
  return u;
}
// NAME of NAME.module, or "" for any other entry.
wm_stem :: (entry: string) -> string {
  ext := ".module";
  if entry.count <= ext.count || entry[entry.count - ext.count..<entry.count] != ext { return ""; }
  return entry[0..<entry.count - ext.count];
}
// dir/NAME.ext into out, or "" when it does not fit.
wm_path :: (out: [] u8, dir: string, name: string, ext: string) -> string {
  n := wm_add(out, 0, dir); n = wm_add(out, n, "/"); n = wm_add(out, n, name); n = wm_add(out, n, ext);
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
// FILE's module (coax wgsl with the options file's words) under its header: written to into
// when it changed, or with check only compared. WM_SAME, WM_WRITTEN, WM_STALE or WM_FAILED.
wm_module :: (file: string, into: string, options: string, check: bool) -> int {
  ob: [8192] u8;
  on := fs_read(options, ob[..]);
  if on < 0 { tool_err("wgsl-module: no options file "); tool_errln(options); return WM_FAILED; }
  // coax wgsl FILE and the file's options
  argv: [16] string;
  argv[0] = "coax/bin/coax"; argv[1] = "wgsl"; argv[2] = file;
  m := wm_words(cast(string) ob[0..<on], argv[3..<16]);
  if m < 0 { tool_errln("wgsl-module: too many options"); return WM_FAILED; }
  out: [WM_PAGE] u8; err: [65536] u8;
  // Five minutes a module. A module takes about 1.4 s on a quiet Mac; the minutes
  // releases saw on 2026-11-11 were each compile's exit walking the check cache
  // (#13307), which no compile does now. A timeout says so, apart from a failure.
  r := proc_run(argv[0..<m + 3], WM_TIMEOUT_MS, out[..], err[..]);
  if r.started != 0 || r.status != 0 || r.cut || r.timed_out {
    tool_err(cast(string) err[0..<r.err_n]);
    if r.timed_out {
      tool_err("wgsl-module: coax wgsl on "); tool_err(file);
      tool_errln(" ran past five minutes and was stopped (the machine's load, or a hang: time it alone with coax/bin/coax wgsl and its options)");
    } else { tool_err("wgsl-module: coax wgsl failed on "); tool_err(file); tool_errln(" (run from the repo root)"); }
    return WM_FAILED;
  }
  page: [WM_PAGE] u8; pn := 0;
  pn = wm_add(page[..], pn, "// ---- generated: "); pn = wm_add(page[..], pn, file);
  pn = wm_add(page[..], pn, " (the module) by coax wgsl; do not edit\n");
  pn = wm_add(page[..], pn, cast(string) out[0..<r.out_n]);
  if pn < 0 { tool_errln("wgsl-module: the module is too large"); return WM_FAILED; }
  text := cast(string) page[0..<pn];
  was: [WM_PAGE] u8;
  wn := fs_read(into, was[..]);
  same := wn >= 0 && cast(string) was[0..<wn] == text;
  if same || check { if !check { wm_live(file, into, options, argv[3..<m + 3], false); } return ifx same then WM_SAME else WM_STALE; }
  if !fs_write(into, text) { tool_err("wgsl-module: cannot write "); tool_errln(into); return WM_FAILED; }
  wm_live(file, into, options, argv[3..<m + 3], true);
  return WM_WRITTEN;
}
// The module's dependency list for coax serve, in development only. Written again when the
// module was (its Coax changed, so its loads may have), or when the list is missing or older
// than the module's Coax. A list that can't be made is said, and the module still counts.
wm_live :: (file: string, into: string, options: string, words: [] string, written: bool) {
  mb: [16] u8;
  if proc_getenv("COAXIAL_MODE", mb[..]) != "dev" { return; }
  cb: [1024] u8; cwd := fs_cwd(cb[..]);
  lb: [2048] u8; pb: [2048] u8; ob: [2048] u8;
  app := fs_dir(into);
  live := wm_path(lb[..], app, "build", "/.live");
  at := wm_add(pb[..], 0, live); at = wm_add(pb[..], at, "/"); at = wm_add(pb[..], at, fs_base(into)); at = wm_add(pb[..], at, ".deps");
  if cwd.count == 0 || live.count == 0 || at < 0 { tool_err("wgsl-module: no dependency list for coax serve: "); tool_errln(into); return; }
  list := cast(string) pb[0..<at];
  if !written && fs_kind(list) == FS_FILE && fs_mtime_ns(list) >= fs_mtime_ns(file) { return; }
  argv := [5] string.["coax/bin/coax", "deps", file, "--library", ""];
  out: [262144] u8; err: [16384] u8;
  r := proc_run(argv[0..<4], WM_TIMEOUT_MS, out[..], err[..]);
  page: [524288] u8;
  n := ifx r.started == 0 && r.status == 0 && !r.cut && !r.timed_out then wm_deps_text(page[..], cwd, file, into, options, words, cast(string) out[0..<r.out_n]) else -1;
  bin := wm_path(ob[..], app, "build", "");
  made := n > 0 && (fs_kind(bin) == FS_DIR || fs_mkdir(bin)) && (fs_kind(live) == FS_DIR || fs_mkdir(live));
  tmp: [2100] u8; tn := wm_add(tmp[..], 0, list); tn = wm_add(tmp[..], tn, ".tmp");
  if !made || tn < 0 || !fs_write(cast(string) tmp[0..<tn], cast(string) page[0..<n]) || !fs_rename(cast(string) tmp[0..<tn], list) {
    tool_err("wgsl-module: no dependency list for coax serve: "); tool_errln(into);
  }
}
// The list's text into out from `coax deps FILE` (deps, its JSON) in the folder cwd: its
// length, or -1 when it does not fit or deps names no sources. Paths are absolute; the options
// file and the bindings file its words name are sources too.
wm_deps_text :: (out: [] u8, cwd: string, file: string, into: string, options: string, words: [] string, deps: string) -> int {
  nodes: [8192] JvNode; d: [1] Jv;
  if !jv_parse(d[..], deps, nodes[..]) { return -1; }
  sources := jv_get(d[0], 0, "sources");
  if jv_len(d[0], sources) < 1 { return -1; }
  n := wm_add(out, 0, "coax-live-1\nkind wgsl\nout "); n = wm_abs(out, n, cwd, into);
  n = wm_add(out, n, "\ncmd cd '"); n = wm_add(out, n, cwd); n = wm_add(out, n, "' && env COAXIAL_MODE=dev coax/web/tool.sh coax/web/wgsl-module.coax '");
  n = wm_add(out, n, file); n = wm_add(out, n, "' '"); n = wm_add(out, n, into); n = wm_add(out, n, "' '"); n = wm_add(out, n, options); n = wm_add(out, n, "'\n");
  for i: 0..<jv_len(d[0], sources) {
    sb: [4096] u8; k := jv_str(d[0], jv_at(d[0], sources, i), sb[..]);
    if k < 1 { return -1; }
    n = wm_add(out, n, "src "); n = wm_abs(out, n, cwd, cast(string) sb[0..<k]); n = wm_add(out, n, "\n");
  }
  n = wm_add(out, n, "src "); n = wm_abs(out, n, cwd, options); n = wm_add(out, n, "\n");
  for i: 0..<words.count {
    if words[i] == "--bindings" && i + 1 < words.count { n = wm_add(out, n, "src "); n = wm_abs(out, n, cwd, words[i + 1]); n = wm_add(out, n, "\n"); }
  }
  return n;
}
// path after the n bytes of out, under cwd when it is relative; -1 when it does not fit.
wm_abs :: (out: [] u8, n: int, cwd: string, path: string) -> int {
  if path.count > 0 && path[0] == '/' { return wm_add(out, n, path); }
  m := wm_add(out, n, cwd); m = wm_add(out, m, "/"); return wm_add(out, m, path);
}
// s after the n bytes of out; -1 when it does not fit (or n was already -1).
wm_add :: (out: [] u8, n: int, s: string) -> int {
  if n < 0 || n + s.count > out.count { return -1; }
  for i: 0..<s.count { out[n + i] = s[i]; }
  return n + s.count;
}
// The words of text (apart by spaces, tabs and lines) into into; their count, -1 when more than it holds.
wm_words :: (text: string, into: [] string) -> int {
  n := 0; i := 0;
  while i < text.count {
    if text[i] == ' ' || text[i] == '\t' || text[i] == '\n' || text[i] == '\r' { i += 1; continue; }
    j := i;
    while j < text.count && text[j] != ' ' && text[j] != '\t' && text[j] != '\n' && text[j] != '\r' { j += 1; }
    if n >= into.count { return -1; }
    into[n] = text[i..<j]; n += 1; i = j;
  }
  return n;
}
#test "a module's dependency list for coax serve" {
  o: [1024] u8;
  words := [4] string.["--vertices", "a", "--bindings", "apps/x/gpu/s.bindings"];
  deps := "{\"schema_version\":1,\"sources\":[\"/r/apps/x/gpu/s.coax\",\"/r/engine/gpu/shader.coax\"],\"descriptors\":[]}";
  n := wm_deps_text(o[..], "/r", "apps/x/gpu/s.coax", "apps/x/s.wgsl", "apps/x/gpu/s.module", words[..], deps);
  #assert n > 0;
  #assert cast(string) o[0..<n] == "coax-live-1\nkind wgsl\nout /r/apps/x/s.wgsl\ncmd cd '/r' && env COAXIAL_MODE=dev coax/web/tool.sh coax/web/wgsl-module.coax 'apps/x/gpu/s.coax' 'apps/x/s.wgsl' 'apps/x/gpu/s.module'\nsrc /r/apps/x/gpu/s.coax\nsrc /r/engine/gpu/shader.coax\nsrc /r/apps/x/gpu/s.module\nsrc /r/apps/x/gpu/s.bindings\n";
  // no sources, not JSON, or too long: no list
  #assert wm_deps_text(o[..], "/r", "f", "i", "m", words[0..<0], "{\"sources\":[]}") == -1;
  #assert wm_deps_text(o[..], "/r", "f", "i", "m", words[0..<0], "nope") == -1;
  #assert wm_deps_text(o[0..<40], "/r", "apps/x/gpu/s.coax", "apps/x/s.wgsl", "apps/x/gpu/s.module", words[..], deps) == -1;
  #assert wm_abs(o[..], 0, "/r", "/abs") == 4 && cast(string) o[0..<4] == "/abs";
  #assert wm_abs(o[..], 0, "/r", "rel") == 6 && cast(string) o[0..<6] == "/r/rel";
}
#test "an options file's words" {
  w: [3] string;
  #assert wm_words("  --a b\n\t--c\r\n", w[..]) == 3 && w[0] == "--a" && w[1] == "b" && w[2] == "--c";
  #assert wm_words("", w[..]) == 0 && wm_words("a b c d", w[..]) == -1;
}
#test "adding to a page" {
  o: [4] u8;
  #assert wm_add(o[..], 0, "ab") == 2 && wm_add(o[..], 2, "cd") == 4 && cast(string) o[..] == "abcd";
  #assert wm_add(o[..], 3, "cd") == -1 && wm_add(o[..], -1, "") == -1;
}
#test "a page's module names" {
  #assert wm_stem("realm.module") == "realm" && wm_stem("everglade-fx.module") == "everglade-fx";
  #assert wm_stem("realm.coax") == "" && wm_stem(".module") == "" && wm_stem("module") == "" && wm_stem("realm.bindings") == "";
  o: [40] u8;
  #assert wm_path(o[..], "apps/openagents-web/gpu", "realm", ".coax") == "apps/openagents-web/gpu/realm.coax";
  #assert wm_path(o[..], "apps/openagents-web/gpu", "realmrealm", ".module") == "";
  #assert wm_path(o[..], WM_GPU[2], "fx", ".coax") == "everglade/client/gpu/fx.coax";
}
#test "a module's copy is kept, named stale, or written" {
  #assert wm_copy_answer(true, "fn a() {}\n", "fn a() {}\n", true) == WM_SAME;
  #assert wm_copy_answer(true, "fn a() {}\n", "fn a() {}\n", false) == WM_SAME;
  #assert wm_copy_answer(true, "fn old() {}\n", "fn a() {}\n", true) == WM_STALE;
  #assert wm_copy_answer(true, "fn old() {}\n", "fn a() {}\n", false) == WM_WRITTEN;
  #assert wm_copy_answer(false, "", "", true) == WM_STALE && wm_copy_answer(false, "", "", false) == WM_WRITTEN;
  #assert WM_COPIES.count % 2 == 0 && WM_COPIES[1] == "apps/openagents-web/newland.wgsl";
}
#test "a failed module is bad; written and unchanged ones are only seen" {
  t: WmTally;
  t = wm_tally(t, WM_SAME, "x");
  #assert t.bad == 0 && t.stale == 0 && t.seen == 1;
  t = wm_tally(t, WM_FAILED, "x");
  #assert t.bad == 1 && t.stale == 0 && t.seen == 2;
  t = wm_tally(t, WM_WRITTEN, "x");
  #assert t.bad == 1 && t.stale == 0 && t.seen == 3;
}
