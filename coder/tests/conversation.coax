// Eight-turn continuation with seven read-only byte checkpoints and independent qualification.
#load "process.coax";
#load "../../coax/lib/agent/claude/fields.coax";
CV_TURNS :: [8]string.[
 "Read AGENTS.md and src.coax. The eventual span_count(lo,hi) contract counts IDs inclusively, valid endpoints 0 through 63. Any negative endpoint, endpoint above 63, or lo>hi returns -1. For now diagnose the stub only; do not edit any file.",
 "Still no edits. Describe the zero-width case lo==hi and how it differs from an empty invalid interval. Keep the public API.",
 "An old proposal used modulo wrapping for out-of-range IDs. We reject that proposal: invalid input stays invalid. Explain the distinction without editing files.",
 "Still read-only. Discuss reversed endpoints and negative endpoints, and which boundary examples should be checked.",
 "A stale draft used zero for errors. The current error sentinel remains -1. Explain why zero would be ambiguous. Do not edit yet.",
 "Before implementation, review the upper endpoint 63 and inclusive counts near it. Requests involving 64 must be rejected. Remain read-only.",
 "Summarize the agreed complete contract and a short testing plan. Keep src.coax and AGENTS.md unchanged; implementation is next.",
 "Implement the agreed span_count contract now. Preserve API, AGENTS.md and existing checks. Add sharp checks before changing implementation, then run the Coax checks and root-only mutation with zero survivors, using the qualified compiler named in AGENTS.md. No equivalent annotations, no commit, no unrelated files." ];
cv_write :: (dir:string,name:string,s:string)->bool {b:[4096]u8;return fs_write(pe_join(dir,name,b[..]),s);}
cv_read :: (dir:string,name:string,b:[]u8)->string {p:[4096]u8;n:=fs_read(pe_join(dir,name,p[..]),b);return ifx n<0 || n>=b.count then "" else cast(string)b[0..<n];}
cv_seal :: (e:PeEnv,gate:string,list:string,out:string,r:[]PeRun)->bool {a:=[6]string.[gate,"seal","--list",list,"--out",out];pe_cmd(e,a[..],r);return r[0].status==0;}
cv_sid :: (s:string,out:[]u8)->string {
  at:=0;while at<s.count {end:=at;while end<s.count && s[end]!=10 {end+=1;}line:=cast(string)s[at..<end];at=end+1;ab:[512]u8;ar:[1]ClArena;ar[0].buf=ab[..];
    if cl_str(ar[..],line,"kind")=="session" {id:=cl_str(ar[..],line,"id");n:=pe_cat(out,0,id);return cast(string)out[0..<n];}}
  return "";
}
tool_main :: ()->int #export_c {
  a:[1]Args;if !args_load(a[..]) {return 2;}gate:=args_value(a[..],"--gate","");driver:=args_value(a[..],"--driver","");repo:=args_value(a[..],"--driver-repo","");cb:[4096]u8;coax:=proc_getenv("COAX",cb[..]);tb:[4096]u8;root:=fs_temp("coder-conversation-",tb[..]);
  if gate.count==0 || driver.count==0 || repo.count==0 || coax.count==0 || root.count==0 {return 2;}
  rb:[4096]u8;work:=pe_join(root,"repo",rb[..]);hb:[4096]u8;home:=pe_join(root,"home",hb[..]);ok:=fs_mkdir(work) && fs_mkdir(home);
  e:=PeEnv.{repo=repo,coder=driver,coax=coax,cwd=work,home=home};r:[1]PeRun;
  rules:[8192]u8;n:=pe_cat(rules[..],0,"Only edit src.coax; preserve its API and existing checks. No commit. Qualified compiler: ");n=pe_cat(rules[..],n,coax);n=pe_cat(rules[..],n,"\n");
  ok=ok && cv_write(work,"AGENTS.md",cast(string)rules[0..<n]) && cv_write(work,"src.coax","span_count :: (lo:int,hi:int)->int {return 0;}\n#test \"initial regression\" {#assert span_count(0,0)==1 && span_count(0,2)==3;}\n");
  srcb:[4096]u8;src:=pe_join(work,"src.coax",srcb[..]);agb:[4096]u8;agents:=pe_join(work,"AGENTS.md",agb[..]);ob:[8192]u8;
  n=json_raw(ob[..],0,"#load ");n=json_write_string(ob[..],n,src);n=json_raw(ob[..],n,";\n#test \"external span acceptance\" #steps 20000000 {\nfor lo:-2..<66 {for hi:-2..<66 {want:= -1;if lo>=0 && hi<=63 && lo<=hi {want=0;for id:0..<64 {if id>=lo && id<=hi {want+=1;}}}#assert span_count(lo,hi)==want;}}\n}\n");ok=ok && cv_write(root,"accept.coax",cast(string)ob[0..<n]);
  ab:[4096]u8;accept:=pe_join(root,"accept.coax",ab[..]);n=pe_cat(ob[..],0,agents);n=pe_cat(ob[..],n,"\n");n=pe_cat(ob[..],n,accept);n=pe_cat(ob[..],n,"\n");ok=ok && cv_write(root,"protected-list.txt",cast(string)ob[0..<n]);
  n=pe_cat(ob[..],0,src);n=pe_cat(ob[..],n,"\n");n=pe_cat(ob[..],n,agents);n=pe_cat(ob[..],n,"\n");ok=ok && cv_write(root,"checkpoint-list.txt",cast(string)ob[0..<n]);
  plb:[4096]u8;pl:=pe_join(root,"protected-list.txt",plb[..]);psb:[4096]u8;ps:=pe_join(root,"protected.json",psb[..]);clb:[4096]u8;cl:=pe_join(root,"checkpoint-list.txt",clb[..]);
  ok=ok && cv_seal(e,gate,pl,ps,r[..]);if !ok {return 2;}
  turns:=CV_TURNS;parent:[128]u8;np:=0;status:=0;elapsed:=0;timedout:=false;truncated:=false;chain:[524288]u8;cn:=json_raw(chain[..],0,"{\"schema\":\"coder.checkpoints.v1\",\"pairs\":[");
  for i:0..<8 {
    num:[32]u8;number:=pe_num(i,num[..]);nameb:[64]u8;nn:=pe_cat(nameb[..],0,number);nn=pe_cat(nameb[..],nn,"-before.json");bp:[4096]u8;before:=pe_join(root,cast(string)nameb[0..<nn],bp[..]);
    nn=pe_cat(nameb[..],0,number);nn=pe_cat(nameb[..],nn,"-after.json");ap:[4096]u8;after:=pe_join(root,cast(string)nameb[0..<nn],ap[..]);
    if i<7 && !cv_seal(e,gate,cl,before,r[..]) {return 2;}
    if i==0 {run:=[10]string.[driver,"run",turns[i],"--engine","micro","--deadline","55","--cwd",work,"--json"];pe_run(e,run[..],60000,r[..]);}
    else {run:=[11]string.[driver,"fork",cast(string)parent[0..<np],turns[i],"--engine","micro","--deadline",ifx i==7 then "115" else "55","--cwd",work,"--json"];pe_run(e,run[..],ifx i==7 then 120000 else 60000,r[..]);}
    elapsed+=r[0].ms;timedout=timedout || r[0].timeout;truncated=truncated || r[0].cut;if r[0].status!=0 || r[0].timeout || r[0].cut {status=1;}
    nn=pe_cat(nameb[..],0,number);nn=pe_cat(nameb[..],nn,".jsonl");ok=cv_write(root,cast(string)nameb[0..<nn],pe_text(r[..]));next:[128]u8;sid:=cv_sid(pe_text(r[..]),next[..]);np=pe_cat(parent[..],0,sid);
    if !ok || np==0 {return 2;}
    if i<7 {
      if !cv_seal(e,gate,cl,after,r[..]) {return 2;}
      b:[32768]u8;bn:=fs_read(before,b[..]);d:[32768]u8;dn:=fs_read(after,d[..]);if bn<0 || dn<0 {return 2;}
      if i>0 {cn=json_raw(chain[..],cn,",");}cn=json_raw(chain[..],cn,"{\"before\":");cn=json_raw(chain[..],cn,cast(string)b[0..<bn]);cn=json_raw(chain[..],cn,",\"after\":");cn=json_raw(chain[..],cn,cast(string)d[0..<dn]);cn=json_raw(chain[..],cn,"}");
    }
    if status!=0 {break;}
  }
  cn=json_raw(chain[..],cn,"]}");if cn<0 || !cv_write(root,"checkpoints.json",cast(string)chain[0..<cn]) {return 2;}
  // The supervisor records actual aggregate process facts, not model claims.
  n=json_raw(ob[..],0,"{\"schema\":\"coder.execution.v1\",\"engine_exit\":");n=json_write_int(ob[..],n,status);n=json_raw(ob[..],n,",\"elapsed_ms\":");n=json_write_int(ob[..],n,elapsed);n=json_raw(ob[..],n,",\"budget_ms\":600000,\"timeout\":");n=json_raw(ob[..],n,ifx timedout then "true" else "false");n=json_raw(ob[..],n,",\"cut\":");n=json_raw(ob[..],n,ifx truncated then "true" else "false");n=json_raw(ob[..],n,",\"log_sha256\":");
  // A separate summary log binds the eight transcript hashes without concatenation overflow.
  digestlog:[8192]u8;dl:=0;for i:0..<8 {b:[32]u8;number:=pe_num(i,b[..]);nb:[64]u8;nn:=pe_cat(nb[..],0,number);nn=pe_cat(nb[..],nn,".jsonl");fb:[262144]u8;text:=cv_read(root,cast(string)nb[0..<nn],fb[..]);hh:[64]u8;dl=pe_cat(digestlog[..],dl,pe_sha(text,hh[..]));dl=pe_cat(digestlog[..],dl,"\n");}
  hh:[64]u8;n=json_write_string(ob[..],n,pe_sha(cast(string)digestlog[0..<dl],hh[..]));n=json_raw(ob[..],n,"}\n");ok=cv_write(root,"execution.json",cast(string)ob[0..<n]) && cv_write(root,"transcripts.sha256",cast(string)digestlog[0..<dl]);
  eb:[4096]u8;execution:=pe_join(root,"execution.json",eb[..]);db:[4096]u8;digests:=pe_join(root,"transcripts.sha256",db[..]);chb:[4096]u8;checkpoints:=pe_join(root,"checkpoints.json",chb[..]);qb:[4096]u8;qualified:=pe_join(root,"qualification",qb[..]);
  check:=[22]string.[gate,"verify","--repo",work,"--coax",coax,"--accept",accept,"--unit",src,"--seal",ps,"--checkpoint-chain",checkpoints,"--execution",execution,"--run-log",digests,"--out",qualified,"--checkpoint-before",ps];
  if !ok {return 2;}pe_run(e,check[..],250000,r[..]);pe_put(pe_text(r[..]));pe_put("artifacts: ");pe_put(root);pe_put("\n");return r[0].status;
}
