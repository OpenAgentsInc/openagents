// Physical journal-file observations through the ordinary host C SDK.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/proc.coax";

jf_run :: (argv:[]string)->bool {
  out:[8192]u8;err:[8192]u8;
  result:=proc_run(argv,30000,out[..],err[..]);
  if result.started!=0 || result.status!=0 || result.cut {
    tool_errln(cast(string)err[0..<result.err_n]);return false;
  }
  print("%",cast(string)out[0..<result.out_n]);return true;
}
tool_main :: ()->int #export_c {
  temp:[1024]u8;dir:=fs_temp("agent-journal-",temp[..]);
  if dir.count==0 {return 1;}
  defer {removed:=fs_remove(dir);}
  name:[1200]u8;exe:=fs_join(dir,"fixture",name[..]);
  cc:=[12]string.["cc","-std=c11","-O1","-g","-fsanitize=address,undefined","-fno-omit-frame-pointer",
    "-Icoax/platform","coax/platform/store-file-native.c","coax/tests/agent-journal-file.c","-o",exe,""];
  if !jf_run(cc[0..<11]) {return 1;}
  argv:=[2]string.[exe,dir];return ifx jf_run(argv[..]) then 0 else 1;
}
