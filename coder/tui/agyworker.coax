// Antigravity as a worker process (GitHub #13802): runs agy acp through the shared
// Coax ACP / Antigravity engine (coax/lib/agent/engine/antigravity.coax), speaking the
// Microcoder worker's JSON-line protocol (coax/lib/agent/engine/mcworker-wire.coax)
// so apps/openagents-desktop/Worker.swift drives it like mcworker / claudeworker.
//
//   in   {"task":"...","cwd":"/path","model":"...","effort":"..."}   run a task
//        {"steer":"...","id":"..."}                                 mid-turn steer (session/prompt without cancel)
//        {"recall":"..."}                                           conversation history / Edit-from-here rollback
//        {"stop":true} / {"interrupt":true}                         stop current turn (session/cancel)
//   out  {"kind":"ready"}
//        {"kind":"turn","turn":N,"source":"message","id":"","text":""}   a task line's turn starts
//        {"kind":"ask","command":"...","ticket":N}                  tool call started (no answer owed)
//        {"kind":"command","command":"...","exit":0,"timed_out":false,"output":"..."}   tool call ended
//        {"kind":"thought","text":"..."}                            agent thought chunk
//        {"kind":"reply","text":"..."}                              agent message chunk
//        {"kind":"steered","id":"...","status":"applied",...}       steer acknowledgement
//        {"kind":"ended","ending":"finished","text":"..."}          turn ended (or stopped / failed)
//        {"kind":"attempt","gateway":"antigravity","model":"gemini-4-carbon-low",...,"outcome":"configured"}
//                                                                    the model agy really runs this session on
//
//   agyworker --probe   opens one agy session (no prompt), prints the model it would run on as
//                       "ID<TAB>NAME" (gemini-4-carbon-low	Gemini 4 Carbon (Low)) and exits; 1 and why on stderr
//                       when agy did not open one. Same environment as a run (CODER_AGY_*).
//   agyworker --connect [--code FILE]
//                       installs agy when missing, opens a session, signs in through Google when agy
//                       is signed out (the code read from FILE), saying each step as KIND<TAB>TEXT
//                       lines (step / url / ok / fail; see agyw_connect). The desktop's onboarding
//                       "Connect Google Antigravity" runs it.
//
// Environment variables:
//   CODER_AGY_BIN       optional custom agy binary path (default: agy_program / agy on PATH)
//   CODER_AGY_PROFILE   optional isolated --gemini-dir profile directory
//   CODER_AGY_MODE      auto | default | plan (default: auto)
//   CODER_AGY_MODEL     optional default model id
//   CODER_AGY_EFFORT    low | medium | high (default: AGYW_EFFORT, medium)
//
//   coax/web/tool.sh coder/tui/agyworker.coax

#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/proc.coax";        // proc_sleep: --probe waits on agy
#load "../../coax/lib/agent/engine/antigravity.coax";
#load "../../coax/lib/agent/engine/agy-install-lib.coax";   // --connect installs agy when it is missing
#load "../../coax/lib/agent/observe/antigravity.coax";
#load "../../coax/lib/agent/engine/mcworker-wire.coax";
#load "../../coax/lib/agent/user-instructions.coax";

cxterm_byte :: (timeout_ms: int) -> int #foreign #effects(all);
cxterm_write :: (s: [] u8) -> int #foreign #effects(all);

AGYW_LINE :: 1048576;
AGYW_LABEL :: 300;
AGYW_OUTPUT :: 4000;
AGYW_OPEN :: 32;
AGYW_SUBS :: 16;
AGYW_ID :: 96;
AGYW_RECALL :: 65536;
AGYW_REPLY :: 65536;
AGYW_CAPS :: 16384;

AgywCall :: struct {
  id: [AGYW_ID] u8; id_n: int;
  label: [AGYW_LABEL] u8; label_n: int;
  path: [512] u8; path_n: int;
  used: bool;
}

AgywSub :: struct {
  id: [AGYW_ID] u8; id_n: int;
  label: [AGYW_LABEL] u8; label_n: int;
  state: int;
  used: bool;
}

AgywConfig :: struct {
  program: [512] u8; program_n: int;
  profile: [1024] u8; profile_n: int;
  mode: [32] u8; mode_n: int;
  model: [128] u8; model_n: int;
  effort: [32] u8; effort_n: int;
  auth_method: [32] u8; auth_method_n: int;
  api_key: [512] u8; api_key_n: int;
  gcp_project: [256] u8; gcp_project_n: int;
  gcp_location: [128] u8; gcp_location_n: int;
  mcp_url: [256] u8; mcp_url_n: int;
  mcp_token: [256] u8; mcp_token_n: int;
  mcp_stdio: [512] u8; mcp_stdio_n: int;
  interactive: bool;
}

AgywState :: struct {
  cfg: AgywConfig;
  calls: [AGYW_OPEN] AgywCall;
  subs: [AGYW_SUBS] AgywSub;
  last_sub_poll: int;
  next_ticket: int;
  turn_active: bool;
  turn: int;                              // the turns started, as the turn lines number them
  stopping: bool;
  stop_deadline_ms: int;        // force-close hung agy child if session/cancel gets no reply within 3s
  respawned: bool;
  retried_sig: bool;
  reply: [AGYW_REPLY] u8; reply_n: int;
  reply_break: bool;            // true after thought/tool so final reply starts fresh without duplicating interim prose
  last_prompt: [CUE_OWED] u8; last_prompt_n: int;
  recall: [AGYW_RECALL] u8; recall_n: int;
  has_recall: bool;
  cwd: [1024] u8; cwd_n: int;
  turn_model: [128] u8; turn_model_n: int;
  turn_effort: [32] u8; turn_effort_n: int;
  active_model: [128] u8; active_model_n: int;
  active_effort: [32] u8; active_effort_n: int;
  sess_json: [AGYW_CAPS] u8; sess_json_n: int;   // cached session/new result for mid-session model/effort updates
  ran: [128] u8; ran_n: int;              // the model agy runs the open session on (agy_effective_model)
  ran_name: [128] u8; ran_name_n: int;    // and agy's name for it
  compact: bool;                                // the turn is a /compact, which may end with no words
  denied: [AGYW_LABEL] u8; denied_n: int;       // why this worker denied a tool call this turn ("" none)
  denied_id: [AGYW_ID] u8; denied_id_n: int;    // ... and that call's toolCallId
  pending_permit: bool;                         // waiting for owner MWW_ANSWER to an escalated permission / question (#13831)
  pending_ticket: int;
  pending_is_question: bool;
  pending_id: [AGYW_ID] u8; pending_id_n: int;
  pending_label: [AGYW_LABEL] u8; pending_label_n: int;
  lease_root: [1024] u8; lease_root_n: int;     // active managed release lease (#13839)
  lease_rid: [64] u8; lease_rid_n: int;
  lease_pid: int;
  out: [AGYW_LINE] u8;
  sink: bool; log: [16384] u8; log_n: int;      // checks: lines go here instead of stdout
}

// Acquire a disk lease if program is inside ~/.openagents/runtimes/agy/releases/<id>/ (#13839).
agyw_lease_acquire :: (s: [] AgywState, pid: int) {
  if pid <= 0 { return; }
  hb: [1024] u8; home := cl_getenv("HOME", hb[..]);
  if home.count == 0 { home = cl_getenv("USERPROFILE", hb[..]); }
  if home.count == 0 { return; }
  rb: [1024] u8; root := agy_managed_root(home, rb[..]);
  if root.count == 0 { return; }
  prog := agyw_str(s[0].cfg.program[..], s[0].cfg.program_n);
  ridb: [64] u8; rid := agy_release_id_from_exe_path(root, prog, ridb[..]);
  if rid.count != 64 { return; }
  if agy_lease_acquire_file(root, rid, pid) {
    s[0].lease_root_n = agyw_copy(s[0].lease_root[..], root);
    s[0].lease_rid_n = agyw_copy(s[0].lease_rid[..], rid);
    s[0].lease_pid = pid;
  }
}

agyw_lease_release :: (s: [] AgywState) {
  if s[0].lease_pid <= 0 || s[0].lease_root_n == 0 || s[0].lease_rid_n != 64 { return; }
  _ = agy_lease_release_file(agyw_str(s[0].lease_root[..], s[0].lease_root_n), agyw_str(s[0].lease_rid[..], s[0].lease_rid_n), s[0].lease_pid);
  s[0].lease_pid = 0;
  s[0].lease_rid_n = 0;
  s[0].lease_root_n = 0;
}

// Copy src into dst, backing up to a valid UTF-8 codepoint boundary when truncating (#13836).
agyw_copy :: (dst: [] u8, src: string) -> int {
  n := ifx src.count < dst.count then src.count else dst.count;
  if n < src.count && n > 0 && (src[n] & 0xC0) == 0x80 {
    while n > 0 && (src[n - 1] & 0xC0) == 0x80 { n -= 1; }
    if n > 0 { n -= 1; }
  }
  for i: 0..<n { dst[i] = src[i]; }
  return n;
}

agyw_str :: (buf: [] u8, n: int) -> string {
  m := ifx n < 0 then 0 else ifx n > buf.count then buf.count else n;
  return cast(string) buf[0..<m];
}

agyw_trim :: (s: string) -> string {
  a := 0; b := s.count;
  while a < b && s[a] <= 32 { a += 1; }
  while b > a && s[b - 1] <= 32 { b -= 1; }
  return ifx a < b then cast(string) s[a..<b] else "";
}

// Resolve mode from CODER_AGY_MODE: auto | default | plan (default: auto).
agyw_resolve_mode :: (raw: string) -> string {
  m := agyw_trim(raw);
  if m == "auto" || m == "default" || m == "plan" { return m; }
  return AGY_MODE_AUTO;
}

// The thought level a chat's turn runs at when neither the task line nor Settings
// (CODER_AGY_EFFORT) names one. Not the engine's AGY_EFFORT (low, for Coder and the Workshop):
// at low, Carbon (agy's default model) and Flash think not at all, so session/prompt reports
// thoughtTokens 0, agy sends no agent_thought_chunk, and a chat showed only its tool calls.
// Measured 2026-11-20 on agy 1.5.13 through a tee around agy acp, an LRU-cache task, 3 runs each:
//   Carbon low:     no thoughts; first byte 3 to 20 s, longest quiet 14 to 39 s, done in 46 to 120 s
//   Carbon medium:  4 to 6 thoughts; the first at 4 s, longest quiet 12 to 16 s, done in 47 to 60 s
//   Carbon high:    20 thoughts; longest quiet 59 s, done in 194 s (1 run)
// At medium every model tried (Carbon, Neon, Argon, Flash) streamed thoughts in every run, the
// first within 3 to 9 s. A thought arrives every few seconds while the model thinks, so a long
// think (#13227) reads as thinking, not as a stall.
AGYW_EFFORT :: "medium";
// Resolve effort from task or CODER_AGY_EFFORT: low | medium | high | xhigh (else empty).
agyw_resolve_effort :: (task_effort: string, env_effort: string) -> string {
  e := agyw_trim(task_effort);
  if e.count == 0 { e = agyw_trim(env_effort); }
  if e == "low" || e == "medium" || e == "high" || e == "xhigh" { return e; }
  return "";
}

// Resolve model: task model overrides env model; strips "agy:" prefix; sentinel "antigravity" / "agy" means default.
agyw_strip_model_prefix :: (raw: string) -> string {
  m := agyw_trim(raw);
  if m.count >= 4 && cast(string) m[0..<4] == "agy:" {
    m = agyw_trim(cast(string) m[4..<m.count]);
  }
  if m == "antigravity" || m == "agy" { return ""; }
  return m;
}

agyw_resolve_model :: (task_model: string, env_model: string) -> string {
  m := agyw_strip_model_prefix(task_model);
  if m.count == 0 { m = agyw_strip_model_prefix(env_model); }
  return m;
}

// Resolve binary path: CODER_AGY_BIN else agy_program().
agyw_resolve_program :: (env_bin: string, out: [] u8) -> string {
  b := agyw_trim(env_bin);
  if b.count > 0 { n := agyw_copy(out, b); return cast(string) out[0..<n]; }
  return agy_program(out);
}

agyw_load_env :: (s: [] AgywState) {
  bb: [512] u8; pb: [1024] u8; mb: [64] u8; modb: [128] u8; eb: [64] u8;
  prog := agyw_resolve_program(cl_getenv("CODER_AGY_BIN", bb[..]), s[0].cfg.program[..]);
  s[0].cfg.program_n = prog.count;
  prof := agyw_trim(cl_getenv("CODER_AGY_PROFILE", pb[..]));
  if prof.count == 0 { prof = agyw_trim(cl_getenv("CODER_AGY_PROFILE_DIR", pb[..])); }
  s[0].cfg.profile_n = agyw_copy(s[0].cfg.profile[..], prof);
  mode := agyw_resolve_mode(cl_getenv("CODER_AGY_MODE", mb[..]));
  s[0].cfg.mode_n = agyw_copy(s[0].cfg.mode[..], mode);
  mod := agyw_trim(cl_getenv("CODER_AGY_MODEL", modb[..]));
  s[0].cfg.model_n = agyw_copy(s[0].cfg.model[..], mod);
  eff := agyw_resolve_effort("", cl_getenv("CODER_AGY_EFFORT", eb[..]));
  s[0].cfg.effort_n = agyw_copy(s[0].cfg.effort[..], eff);
  amb: [64] u8; am := agyw_trim(cl_getenv("CODER_AGY_AUTH_METHOD", amb[..]));
  s[0].cfg.auth_method_n = agyw_copy(s[0].cfg.auth_method[..], am);
  akb: [512] u8; ak := agyw_trim(cl_getenv("CODER_AGY_API_KEY", akb[..]));
  s[0].cfg.api_key_n = agyw_copy(s[0].cfg.api_key[..], ak);
  gpb: [256] u8; gp := agyw_trim(cl_getenv("CODER_AGY_GCP_PROJECT", gpb[..]));
  s[0].cfg.gcp_project_n = agyw_copy(s[0].cfg.gcp_project[..], gp);
  glb: [128] u8; gl := agyw_trim(cl_getenv("CODER_AGY_GCP_LOCATION", glb[..]));
  s[0].cfg.gcp_location_n = agyw_copy(s[0].cfg.gcp_location[..], gl);
  ib: [16] u8; intr := agyw_trim(cl_getenv("CODER_AGY_INTERACTIVE", ib[..]));
  s[0].cfg.interactive = intr == "1" || intr == "true";
  mub: [256] u8; s[0].cfg.mcp_url_n = agyw_copy(s[0].cfg.mcp_url[..], agyw_trim(cl_getenv("CODER_MCP_URL", mub[..])));
  mtb: [256] u8; s[0].cfg.mcp_token_n = agyw_copy(s[0].cfg.mcp_token[..], agyw_trim(cl_getenv("CODER_MCP_TOKEN", mtb[..])));
  msb: [512] u8; s[0].cfg.mcp_stdio_n = agyw_copy(s[0].cfg.mcp_stdio[..], agyw_trim(cl_getenv("CODER_MCP_STDIO", msb[..])));
}

agyw_auth_config :: (s: [] AgywState) -> AgyAuthConfig {
  mode := agyw_str(s[0].cfg.mode[..], s[0].cfg.mode_n);
  return AgyAuthConfig.{
    method = agyw_str(s[0].cfg.auth_method[..], s[0].cfg.auth_method_n),
    api_key = agyw_str(s[0].cfg.api_key[..], s[0].cfg.api_key_n),
    gcp_project = agyw_str(s[0].cfg.gcp_project[..], s[0].cfg.gcp_project_n),
    gcp_location = agyw_str(s[0].cfg.gcp_location[..], s[0].cfg.gcp_location_n),
    skip_permissions = (mode == "auto"),
  };
}

// Launch agy using T3 auth config when CODER_AGY_AUTH_METHOD is configured, else legacy agy_launch_with.
agyw_launch_engine :: (s: [] AgywState, x: [] CuEngine, cwd: string) -> string {
  prog := agyw_str(s[0].cfg.program[..], s[0].cfg.program_n);
  prof := agyw_str(s[0].cfg.profile[..], s[0].cfg.profile_n);
  if s[0].cfg.auth_method_n > 0 {
    return agy_launch_auth(x, prog, cwd, "openagents-agyworker", "1.0", prof, agyw_auth_config(s));
  }
  skip_perm := agyw_str(s[0].cfg.mode[..], s[0].cfg.mode_n) == "auto";
  return agy_launch_with_skip(x, prog, cwd, "openagents-agyworker", "1.0", prof, skip_perm);
}

agyw_is_logout :: (text: string) -> bool {
  return agyw_trim(text) == "/logout";
}

agyw_apply_mcp :: (s: [] AgywState, c: [] CuClient) {
  cu_mcp_clear(c);
  url := agyw_str(s[0].cfg.mcp_url[..], s[0].cfg.mcp_url_n);
  if url.count > 0 {
    _ = cu_mcp_add_http(c, "openagents-coder", url, agyw_str(s[0].cfg.mcp_token[..], s[0].cfg.mcp_token_n));
  }
  stdio := agyw_str(s[0].cfg.mcp_stdio[..], s[0].cfg.mcp_stdio_n);
  if stdio.count > 0 {
    _ = cu_mcp_add_stdio(c, "openagents-coder-stdio", stdio, "[\"mcp\"]");
  }
}

// ---------------------------------------------------------------- wire I/O

agyw_write_line :: (s: [] AgywState, n: int) {
  if n <= 0 || n >= s[0].out.count { return; }
  s[0].out[n] = '\n';
  if s[0].sink {
    s[0].log_n += agyw_copy(s[0].log[s[0].log_n..<s[0].log.count], cast(string) s[0].out[0..<n + 1]);
    return;
  }
  _ = cxterm_write(s[0].out[0..<n + 1]);
}

agyw_emit_ready :: (s: [] AgywState) { agyw_write_line(s, mww_ready(s[0].out[..])); }
agyw_emit_thought :: (s: [] AgywState, text: string) { if text.count > 0 { agyw_write_line(s, mww_thought(s[0].out[..], text)); } }
agyw_emit_reply :: (s: [] AgywState, text: string) { if text.count > 0 { agyw_write_line(s, mww_reply(s[0].out[..], text)); } }
agyw_emit_ask :: (s: [] AgywState, cmd: string, ticket: int) { agyw_write_line(s, mww_ask(s[0].out[..], cmd, ticket)); }
agyw_emit_command :: (s: [] AgywState, cmd: string, exit_code: int, out_text: string) {
  agyw_write_line(s, mww_command(s[0].out[..], cmd, exit_code, false, out_text));
}
agyw_emit_ended :: (s: [] AgywState, ending: string, text: string) { agyw_write_line(s, mww_ended(s[0].out[..], ending, text)); }
agyw_emit_steered :: (s: [] AgywState, id: string, status: string, reason: string, text: string) {
  agyw_write_line(s, mww_steered(s[0].out[..], id, status, 0, reason, 0, text));
}
agyw_emit_permit :: (s: [] AgywState, ticket: int, question: bool, title: string, cmd: string, options_json: string) {
  agyw_write_line(s, mww_permit(s[0].out[..], ticket, question, title, cmd, options_json));
}

// Read one line from stdin with timeout. Returns: >0 line length, 0 timeout, -1 EOF.
agyw_read_line :: (buf: [] u8, nbuf: [] int, timeout_ms: int) -> int {
  b := cxterm_byte(timeout_ms);
  while b >= 0 {
    if b == '\n' {
      n := nbuf[0]; nbuf[0] = 0;
      if n > 0 && buf[n - 1] == '\r' { n -= 1; }
      return n;
    }
    if nbuf[0] < buf.count { buf[nbuf[0]] = cast(u8) b; nbuf[0] += 1; }
    b = cxterm_byte(0);
  }
  if b == -2 { return -1; }
  return 0;
}

// ---------------------------------------------------------------- tool call tracking

agyw_call_find :: (s: [] AgywState, id: string) -> int {
  if id.count == 0 { return -1; }
  for i: 0..<AGYW_OPEN {
    if s[0].calls[i].used && agyw_str(s[0].calls[i].id[..], s[0].calls[i].id_n) == id { return i; }
  }
  return -1;
}

agyw_call_open :: (s: [] AgywState, id: string, label: string) -> int {
  at := agyw_call_find(s, id);
  if at >= 0 {
    if label.count > 0 { s[0].calls[at].label_n = agyw_copy(s[0].calls[at].label[..], label); }
    return at;
  }
  for i: 0..<AGYW_OPEN {
    if !s[0].calls[i].used {
      s[0].calls[i].used = true;
      s[0].calls[i].id_n = agyw_copy(s[0].calls[i].id[..], id);
      s[0].calls[i].label_n = agyw_copy(s[0].calls[i].label[..], label);
      return i;
    }
  }
  return -1;
}

agyw_call_close :: (s: [] AgywState, at: int) {
  if at >= 0 && at < AGYW_OPEN { s[0].calls[at].used = false; s[0].calls[at].id_n = 0; s[0].calls[at].label_n = 0; s[0].calls[at].path_n = 0; }
}

agyw_calls_clear :: (s: [] AgywState) {
  for i: 0..<AGYW_OPEN { s[0].calls[i].used = false; s[0].calls[i].id_n = 0; s[0].calls[i].label_n = 0; s[0].calls[i].path_n = 0; }
}

// Read-repair (#13834): when fs/read_text_file is served for a path that has an open
// read tool call that agy never closes with tool_call_update, synthesize completion.
agyw_read_repair_served :: (s: [] AgywState, path: string, ok: bool, emit: bool) -> bool {
  if path.count == 0 { return false; }
  for i: 0..<AGYW_OPEN {
    if !s[0].calls[i].used || s[0].calls[i].path_n == 0 { continue; }
    if agyw_str(s[0].calls[i].path[..], s[0].calls[i].path_n) != path { continue; }
    cmd := agyw_str(s[0].calls[i].label[..], s[0].calls[i].label_n);
    if cmd.count == 0 { cmd = path; }
    if emit { agyw_emit_command(s, cmd, ifx ok then 0 else 1, ifx ok then "" else "Read failed."); }
    agyw_call_close(s, i);
    return true;
  }
  return false;
}

// Serve an ACP fs/read_text_file request scoped strictly to [cwd, attach_dir] (#13834).
agyw_handle_fs_read :: (s: [] AgywState, c: [] CuClient, id_json: string, path: string, cwd: string, attach_dir: string, emit: bool) -> bool {
  allowed := cu_path_under_root(path, cwd) || (attach_dir.count > 0 && cu_path_under_root(path, attach_dir));
  if !allowed {
    cu_fs_read_error(c, id_json, -32000, "path outside allowed roots");
    _ = agyw_read_repair_served(s, path, false, emit);
    return false;
  }
  raw: [65536] u8;
  n := fs_read(path, raw[..]);
  if n < 0 {
    cu_fs_read_error(c, id_json, -32001, "could not read file");
    _ = agyw_read_repair_served(s, path, false, emit);
    return false;
  }
  dec: [65536] u8;
  dn := cu_decode_utf16_bom(raw[0..<n], dec[..]);
  content := ifx dn >= 0 then cast(string) dec[0..<dn] else cast(string) raw[0..<n];
  cu_fs_read_result(c, id_json, content);
  _ = agyw_read_repair_served(s, path, true, emit);
  return true;
}

// ---------------------------------------------------------------- detached subagents (#13832)

agyw_subs_clear :: (s: [] AgywState) {
  for i: 0..<AGYW_SUBS { s[0].subs[i].used = false; s[0].subs[i].id_n = 0; s[0].subs[i].label_n = 0; s[0].subs[i].state = AGR_SUB_UNKNOWN; }
  s[0].last_sub_poll = 0;
}

agyw_sub_find :: (s: [] AgywState, id: string) -> int {
  if id.count == 0 { return -1; }
  for i: 0..<AGYW_SUBS {
    if s[0].subs[i].used && agyw_str(s[0].subs[i].id[..], s[0].subs[i].id_n) == id { return i; }
  }
  return -1;
}

agyw_sub_label :: (sub: AgrSubagent, out: [] u8) -> string {
  n := agyw_copy(out, "Subagent");
  if sub.name.count > 0 {
    n += agyw_copy(out[n..<out.count], ": ");
    n += agyw_copy(out[n..<out.count], sub.name);
  }
  if sub.prompt.count > 0 {
    n += agyw_copy(out[n..<out.count], " — ");
    n += agyw_copy(out[n..<out.count], sub.prompt);
  }
  return cast(string) out[0..<n];
}

// Sync a batch of parsed detached subagents into CuEngine's held-turn counter and emit
// worker ask/command lines for newly running or settled subagents. Killed subagents
// (AGR_SUB_KILLED / SUBAGENT_STATE_KILLED) are terminal and never hold a parent turn open.
agyw_sync_subagents :: (s: [] AgywState, x: [] CuEngine, subs: [] AgrSubagent, n: int, emit: bool) -> int {
  prev_running := cue_bg_subagents(x);
  running := agr_subagents_running(subs, n);
  cue_bg_subagents_set(x, running);
  any_killed := false;
  any_completed := false;
  limit := ifx n < subs.count then n else subs.count;
  for i: 0..<limit {
    sub := subs[i];
    if sub.id.count == 0 { continue; }
    at := agyw_sub_find(s, sub.id);
    if at < 0 {
      for k: 0..<AGYW_SUBS {
        if !s[0].subs[k].used {
          at = k;
          s[0].subs[k].used = true;
          s[0].subs[k].id_n = agyw_copy(s[0].subs[k].id[..], sub.id);
          s[0].subs[k].state = AGR_SUB_UNKNOWN;
          break;
        }
      }
      if at < 0 { continue; }
    }
    prev := s[0].subs[at].state;
    if prev == sub.state { continue; }
    lb: [AGYW_LABEL] u8;
    label := agyw_sub_label(sub, lb[..]);
    if s[0].subs[at].label_n == 0 { s[0].subs[at].label_n = agyw_copy(s[0].subs[at].label[..], label); }
    shown := agyw_str(s[0].subs[at].label[..], s[0].subs[at].label_n);
    s[0].subs[at].state = sub.state;
    if sub.state == AGR_SUB_RUNNING {
      s[0].next_ticket += 1;
      if emit { agyw_emit_ask(s, shown, s[0].next_ticket); }
    } else if sub.state == AGR_SUB_DONE || sub.state == AGR_SUB_FAILED || sub.state == AGR_SUB_KILLED {
      if sub.state == AGR_SUB_KILLED { any_killed = true; } else { any_completed = true; }
      if prev == AGR_SUB_UNKNOWN {
        s[0].next_ticket += 1;
        if emit { agyw_emit_ask(s, shown, s[0].next_ticket); }
      }
      exit_code := ifx sub.state == AGR_SUB_DONE then 0 else 1;
      out_txt := ifx sub.state == AGR_SUB_KILLED then (ifx sub.error.count > 0 then sub.error else "Subagent killed.")
                 else ifx sub.state == AGR_SUB_FAILED then (ifx sub.error.count > 0 then sub.error else "Subagent failed.")
                 else sub.summary;
      if emit { agyw_emit_command(s, shown, exit_code, out_txt); }
    }
  }
  if prev_running > 0 && running == 0 && any_killed && !any_completed {
    cue_bg_expect_wake(x, false);
  } else if any_completed {
    cue_bg_expect_wake(x, true);
  }
  return running;
}

// Resolve Antigravity's brain directory: <profile>/antigravity-acp/brain when profiled,
// else $HOME/.gemini/antigravity-acp/brain (or antigravity-cli/brain if present).
agyw_brain_dir :: (profile: string, home: string, out: [] u8) -> string {
  if profile.count > 0 {
    b1: [1024] u8; p1 := fs_join(profile, AGY_APP_DATA_DIR, b1[..]);
    return ifx p1.count > 0 then fs_join(p1, "brain", out) else "";
  }
  if home.count == 0 { return ""; }
  b1: [1024] u8; p1 := fs_join(home, ".gemini/antigravity-acp/brain", b1[..]);
  if p1.count > 0 && fs_exists(p1) { return cast(string) out[0..<agyw_copy(out, p1)]; }
  return fs_join(home, ".gemini/antigravity-cli/brain", out);
}

agyw_poll_subagents :: (s: [] AgywState, x: [] CuEngine, emit: bool) {
  root_id := cu_session_id(x[0].c);
  if root_id.count == 0 { return; }
  hb: [1024] u8; home := cl_getenv("HOME", hb[..]);
  bb: [2048] u8; brain := agyw_brain_dir(agyw_str(s[0].cfg.profile[..], s[0].cfg.profile_n), home, bb[..]);
  if brain.count == 0 { return; }
  ab: [16384] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  subs: [AGYW_SUBS] AgrSubagent;
  n := agr_subagents_read(brain, root_id, subs[..], ar[..]);
  if n > 0 || cue_bg_subagents(x) > 0 { _ = agyw_sync_subagents(s, x, subs[..], n, emit); }
}

// Extract textual output from a tool_call_update's content or rawOutput.
agyw_tool_output :: (ar: [] ClArena, update: string, out: [] u8) -> string {
  n := 0;
  content := cl_raw(update, "content");
  cnt := cl_count(content);
  for i: 0..<cnt {
    item := cl_json(content, cl_item(content, i));
    txt := cl_str(ar, item, "content.text");
    if txt.count == 0 { txt = cl_str(ar, item, "text"); }
    if txt.count > 0 {
      if n > 0 && n < out.count { out[n] = '\n'; n += 1; }
      n += agyw_copy(out[n..<out.count], txt);
    }
  }
  if n == 0 {
    ro := cl_str(ar, update, "rawOutput");
    if ro.count == 0 { ro = cl_str(ar, update, "rawOutput.output"); }
    if ro.count == 0 { ro = cl_str(ar, update, "rawOutput.stdout"); }
    if ro.count > 0 { n = agyw_copy(out, ro); }
  }
  return cast(string) out[0..<n];
}

// A finished tool call's exit code: agy marks a command that exited non-zero "completed" and
// gives its code in rawOutput.exit_code (agy 1.5.13); a call that failed or was cancelled is 1.
agyw_exit_code :: (update: string, status: string) -> int {
  if status != "completed" { return 1; }
  ec := cl_int(update, "rawOutput.exit_code");
  return ifx ec.ok then ec.value else 0;
}

// ---------------------------------------------------------------- permissions & /compact & rollback

// Permission policy for agyworker:
// - In plan mode: deny writes and command execution, allow reads.
// - A path agy names with ".." (rawInput Path, Cwd, ...): deny.
// - Otherwise: allow (a non-interactive worker, matching claudeworker's bypassed permissions).
// Why the tool call in params is denied, or "" when it is allowed.
agyw_deny_reason :: (c: [] CuClient, params: string, mode: string) -> string {
  tool := cl_raw(params, "toolCall");
  if agy_outside(tool, c[0].ar[..]) { return "it names a path outside the workspace"; }
  if mode == "plan" {
    kind := cl_str(c[0].ar[..], tool, "kind");
    eff := cu_kind_effect(kind);
    if eff == CU_EFFECT_WRITE || eff == CU_EFFECT_RUN { return "plan mode runs no edits or commands"; }
  }
  return "";
}

agyw_decide_permission :: (c: [] CuClient, params: string, mode: string) -> int {
  return ifx agyw_deny_reason(c, params, mode).count > 0 then CU_DISP_DENY else CU_DISP_ALLOW;
}

// Answer agy's session/request_permission. It must be answered here: a request left open is
// declined by the client on its next poll (cu_settle), and agy cancels the whole turn when any
// tool call is denied (measured on agy 1.5.13: "Tool confirmation ... approved=false", then
// "CancelCascadeInvocation", then session/prompt answered end_turn with no words). So every
// denial is kept, and the turn that ends after it says so.
agyw_answer_permission :: (s: [] AgywState, c: [] CuClient, params: string, mode: string) -> int {
  why := agyw_deny_reason(c, params, mode);
  if why.count == 0 {
    id := cu_allow_option(c);
    if id.count > 0 { cu_permit(c, id); return CU_DISP_ALLOW; }
    why = "Antigravity offered no option to allow it";
  }
  tool := cl_raw(params, "toolCall");
  nb: [AGYW_LABEL] u8;
  label := cu_tool_display_name(tool, c[0].ar[..], nb[..]);
  if label.count == 0 { label = "a tool call"; }
  n := agyw_copy(s[0].denied[..], "OpenAgents denied ");
  n += agyw_copy(s[0].denied[n..<s[0].denied.count], label);
  n += agyw_copy(s[0].denied[n..<s[0].denied.count], ": ");
  n += agyw_copy(s[0].denied[n..<s[0].denied.count], why);
  n += agyw_copy(s[0].denied[n..<s[0].denied.count], ".");
  s[0].denied_n = n;
  s[0].denied_id_n = agyw_copy(s[0].denied_id[..], cl_str(c[0].ar[..], tool, "toolCallId"));
  cu_decline(c);
  return CU_DISP_DENY;
}

// Handle a session/request_permission event: hard-denied calls decline immediately; in auto mode
// all tool/command permission requests (including git push & unsandboxed commands) auto-approve
// without prompting, while native user questions ("interaction_*") or explicit supervised
// "default" mode emit MWW_PERMIT and pause waiting for the owner's MWW_ANSWER (#13831).
agyw_on_permission :: (s: [] AgywState, c: [] CuClient, params: string, mode: string, emit: bool) -> int {
  why := agyw_deny_reason(c, params, mode);
  if why.count > 0 { return agyw_answer_permission(s, c, params, mode); }
  is_q := cu_perm_is_question(params, c[0].ar[..]);
  ask_user := s[0].cfg.interactive && (is_q || mode == "default");
  if !ask_user { return agyw_answer_permission(s, c, params, mode); }
  tool := cl_raw(params, "toolCall");
  nb: [AGYW_LABEL] u8;
  label := cu_tool_display_name(tool, c[0].ar[..], nb[..]);
  if label.count == 0 { label = ifx is_q then "Choose an option." else "Approve tool call"; }
  cmd := cl_str(c[0].ar[..], tool, "rawInput.CommandLine");
  if cmd.count == 0 { cmd = cl_str(c[0].ar[..], tool, "rawInput.commandLine"); }
  if cmd.count == 0 { cmd = cl_str(c[0].ar[..], tool, "rawInput.command"); }
  if cmd.count == 0 { cmd = cl_str(c[0].ar[..], tool, "rawInput.Path"); }
  if cmd.count == 0 { cmd = cl_str(c[0].ar[..], tool, "rawInput.AbsolutePath"); }
  if cmd.count == 0 { cmd = cl_str(c[0].ar[..], tool, "rawInput.TargetFile"); }
  opts := cl_raw(params, "options");
  s[0].next_ticket += 1;
  s[0].pending_permit = true;
  s[0].pending_ticket = s[0].next_ticket;
  s[0].pending_is_question = is_q;
  s[0].pending_id_n = agyw_copy(s[0].pending_id[..], cl_str(c[0].ar[..], tool, "toolCallId"));
  s[0].pending_label_n = agyw_copy(s[0].pending_label[..], label);
  if emit { agyw_emit_permit(s, s[0].pending_ticket, is_q, label, cmd, opts); }
  return CU_DISP_ASK;
}

// Apply the owner's MWW_ANSWER to a pending interactive permission or question (#13831).
agyw_handle_answer :: (s: [] AgywState, x: [] CuEngine, req: MwwRequest) -> bool {
  if !s[0].pending_permit { return false; }
  if req.ticket.ok && req.ticket.value != s[0].pending_ticket { return false; }
  s[0].pending_permit = false;
  c := x[0].c;
  if req.allow {
    opt := req.option;
    if opt == "allow_session" && !cu_perm_has_option(c, opt) && cu_perm_has_option(c, "allow_always") {
      opt = "allow_always";
    }
    if opt.count == 0 || !cu_perm_has_option(c, opt) { opt = cu_allow_option(c); }
    if opt.count > 0 { cu_permit(c, opt); } else { cu_decline(c); }
  } else {
    label := agyw_str(s[0].pending_label[..], s[0].pending_label_n);
    if label.count == 0 { label = "a tool call"; }
    why := ifx req.why.count > 0 then req.why else "denied by user";
    n := agyw_copy(s[0].denied[..], "OpenAgents denied ");
    n += agyw_copy(s[0].denied[n..<s[0].denied.count], label);
    n += agyw_copy(s[0].denied[n..<s[0].denied.count], ": ");
    n += agyw_copy(s[0].denied[n..<s[0].denied.count], why);
    n += agyw_copy(s[0].denied[n..<s[0].denied.count], ".");
    s[0].denied_n = n;
    s[0].denied_id_n = agyw_copy(s[0].denied_id[..], agyw_str(s[0].pending_id[..], s[0].pending_id_n));
    cu_decline(c);
  }
  s[0].pending_ticket = 0;
  s[0].pending_is_question = false;
  s[0].pending_id_n = 0;
  s[0].pending_label_n = 0;
  if x[0].live && !s[0].sink { _ = cu_flush(x[0].c, x[0].p); }
  // Reset stall watchdog after human approval wait so a long prompt pause never triggers a stall timeout.
  x[0].heard = true;
  return true;
}

// True when a prompt is a /compact slash command.
agyw_is_compact :: (text: string) -> bool {
  t := agyw_trim(text);
  if t == "/compact" { return true; }
  return t.count > 9 && cast(string) t[0..<9] == "/compact ";
}

// A new session's first prompt with the person's own instructions ahead of it (~/.openagents/
// instructions.md, GitHub #13808), as Microcoder and Claude Code get them in their system prompts:
// ACP takes no system prompt, so they lead the session's first message. block is uinstr_block's;
// the prompt alone when there is none or the two don't fit out.
AGYW_TASK_HEAD :: "\nThe person's message:\n";
agyw_with_instructions :: (block: string, prompt: string, out: [] u8) -> string {
  if block.count == 0 || block.count + AGYW_TASK_HEAD.count + prompt.count > out.count { return prompt; }
  n := agyw_copy(out, block);
  n += agyw_copy(out[n..<out.count], AGYW_TASK_HEAD);
  n += agyw_copy(out[n..<out.count], prompt);
  return cast(string) out[0..<n];
}

// Compose a prompt with recalled conversation history (for Edit-from-here rollback / fresh session).
agyw_compose_prompt :: (recall: string, prompt: string, out: [] u8) -> string {
  if recall.count == 0 { n := agyw_copy(out, prompt); return cast(string) out[0..<n]; }
  n := 0;
  n += agyw_copy(out[n..<out.count], "Previous conversation context (rolled back / resumed):\n");
  n += agyw_copy(out[n..<out.count], recall);
  n += agyw_copy(out[n..<out.count], "\n\nUser message:\n");
  n += agyw_copy(out[n..<out.count], prompt);
  return cast(string) out[0..<n];
}

// Append text to the turn's accumulated reply buffer.
agyw_reply_append :: (s: [] AgywState, text: string) {
  if text.count == 0 { return; }
  rem := s[0].reply.count - s[0].reply_n;
  if rem <= 0 { return; }
  s[0].reply_n += agyw_copy(s[0].reply[s[0].reply_n..<s[0].reply.count], text);
}

// ---------------------------------------------------------------- notification & event dispatch

agyw_handle_update :: (s: [] AgywState, x: [] CuEngine, params: string, emit: bool) {
  if !s[0].turn_active { return; }
  update := cl_raw(params, "update");
  if update.count == 0 { return; }
  ar := x[0].c[0].ar[..];
  kind := cl_str(ar, update, "sessionUpdate");
  if kind == "agent_thought_chunk" {
    txt := cl_str(ar, update, "content.text");
    if txt.count == 0 { txt = cl_str(ar, update, "text"); }
    if txt.count > 0 {
      if s[0].reply_n > 0 { s[0].reply_break = true; }
      if emit { agyw_emit_thought(s, txt); }
    }
    return;
  }
  if kind == "agent_message_chunk" {
    txt := cl_str(ar, update, "content.text");
    if txt.count > 0 {
      if s[0].reply_break { s[0].reply_n = 0; s[0].reply_break = false; }
      agy_chunk(x, txt);
      agyw_reply_append(s, txt);
      if emit { agyw_emit_reply(s, txt); }
    }
    return;
  }
  if kind == "tool_call" || kind == "tool_call_update" {
    id := cl_str(ar, update, "toolCallId");
    status := cl_str(ar, update, "status");
    nb: [AGYW_LABEL] u8;
    label := cu_tool_display_name(update, ar, nb[..]);
    existing := agyw_call_find(s, id);
    if existing < 0 && (status.count == 0 || status == "pending" || status == "in_progress") {
      if s[0].reply_n > 0 { s[0].reply_break = true; }
      at := agyw_call_open(s, id, label);
      if at >= 0 {
        rp := cl_str(ar, update, "rawInput.Path");
        if rp.count == 0 { rp = cl_str(ar, update, "rawInput.path"); }
        if rp.count == 0 { rp = cl_str(ar, update, "rawInput.AbsolutePath"); }
        if rp.count > 0 { s[0].calls[at].path_n = agyw_copy(s[0].calls[at].path[..], rp); }
        s[0].next_ticket += 1;
        if emit { agyw_emit_ask(s, agyw_str(s[0].calls[at].label[..], s[0].calls[at].label_n), s[0].next_ticket); }
      }
      return;
    }
    if status == "completed" || status == "failed" || status == "cancelled" {
      if s[0].reply_n > 0 { s[0].reply_break = true; }
      at := existing;
      cmd := "";
      if at >= 0 && s[0].calls[at].label_n > 0 {
        // Match the exact label emitted on ask so the UI resolves the running spinner row in place.
        cmd = agyw_str(s[0].calls[at].label[..], s[0].calls[at].label_n);
      }
      if cmd.count == 0 { cmd = label; }
      if cmd.count == 0 { cmd = "tool"; }
      ob: [AGYW_OUTPUT] u8;
      out_txt := agyw_tool_output(ar, update, ob[..]);
      if out_txt.count == 0 && status != "completed" { out_txt = agyw_no_output(s, id, status); }
      exit_code := agyw_exit_code(update, status);
      if emit { agyw_emit_command(s, cmd, exit_code, out_txt); }
      agyw_call_close(s, at);
      return;
    }
    if existing >= 0 && s[0].calls[existing].label_n == 0 && label.count > 0 {
      s[0].calls[existing].label_n = agyw_copy(s[0].calls[existing].label[..], label);
    }
  }
}

// What a tool call that failed or was cancelled with no output of its own says instead.
agyw_no_output :: (s: [] AgywState, id: string, status: string) -> string {
  if s[0].denied_n > 0 {
    if id.count > 0 && id == agyw_str(s[0].denied_id[..], s[0].denied_id_n) { return agyw_str(s[0].denied[..], s[0].denied_n); }
    return "Not finished: Antigravity cancelled the turn after a tool call was denied.";
  }
  if status == "cancelled" { return "Cancelled."; }
  return "Antigravity reported that this tool call failed and gave no output.";
}

agyw_finish_turn :: (s: [] AgywState, ending: string, text: string, emit: bool) {
  s[0].turn_active = false;
  s[0].stopping = false;
  s[0].stop_deadline_ms = 0;
  agyw_calls_clear(s);
  agyw_subs_clear(s);
  if emit { agyw_emit_ended(s, ending, text); }
  s[0].reply_n = 0;
  s[0].reply_break = false;
  s[0].denied_n = 0; s[0].denied_id_n = 0;
  s[0].pending_permit = false; s[0].pending_ticket = 0; s[0].pending_is_question = false;
  s[0].pending_id_n = 0; s[0].pending_label_n = 0;
  s[0].compact = false;
}

// The turn agy answered (result: session/prompt's result, "" for a held turn's end) ended:
// finished with its words, or failed saying why. Never a silent empty reply.
agyw_turn_end :: (s: [] AgywState, ar: [] ClArena, result: string, emit: bool) {
  if s[0].denied_n > 0 {
    nb: [AGYW_LABEL + 128] u8;
    n := agyw_copy(nb[..], agyw_str(s[0].denied[..], s[0].denied_n));
    n += agyw_copy(nb[n..<nb.count], " Antigravity ends its turn when a tool call is denied.");
    agyw_finish_turn(s, "failed", cast(string) nb[0..<n], emit);
    return;
  }
  reply := agyw_str(s[0].reply[..], s[0].reply_n);
  if agyw_trim(reply).count > 0 || s[0].compact { agyw_finish_turn(s, "finished", reply, emit); return; }
  why := agyw_no_reply(cl_str(ar, result, "stopReason"));
  wb: [160] u8; wn := agyw_copy(wb[..], why);
  agyw_finish_turn(s, "failed", cast(string) wb[0..<wn], emit);
}

// Why a turn ended with no words, from session/prompt's stopReason.
agyw_no_reply :: (stop: string) -> string {
  if stop == "max_tokens" { return "Antigravity ended the turn without a reply: the model reached its output limit."; }
  if stop == "max_turn_requests" { return "Antigravity ended the turn without a reply: it reached its limit of model requests."; }
  if stop == "refusal" { return "Antigravity ended the turn without a reply: the model refused."; }
  if stop == "cancelled" { return "Antigravity cancelled the turn without a reply."; }
  return "Antigravity ended the turn without a reply.";
}

// The model the session just opened runs on (never "default"): kept, and told to the owner as an
// attempt line with no counts, so the message it answers names the model that wrote it.
agyw_ran :: (s: [] AgywState, x: [] CuEngine, result: string, model: string, effort: string, emit: bool) {
  ar := x[0].c[0].ar[..];
  ob: [128] u8; id := agy_effective_at(result, model, effort, AGYW_EFFORT, ar, ob[..]);
  s[0].ran_n = agyw_copy(s[0].ran[..], id);
  s[0].ran_name_n = agyw_copy(s[0].ran_name[..], agy_model_shown(result, id, ar));
  if !emit || id.count == 0 { return; }
  none := [7] int.[-1, -1, -1, -1, -1, -1, -1];
  agyw_write_line(s, mww_attempt(s[0].out[..], "antigravity", agyw_str(s[0].ran[..], s[0].ran_n), effort, "configured", 0, none[..]));
}

// Verify that a conversation DB / pbtxt blob belongs to our temporary probe session
// (matches both session_id and workspace_uri) before unlinking (#13836).
agyw_session_db_owned :: (raw: string, session_id: string, workspace_uri: string) -> bool {
  if raw.count == 0 || session_id.count == 0 || workspace_uri.count == 0 { return false; }
  return agr_has(raw, session_id) && agr_has(raw, workspace_uri);
}

agyw_probe_cleanup :: (profile: string, home: string, session_id: string, cwd: string) {
  if session_id.count == 0 || cwd.count == 0 { return; }
  // Reject any path separator or ".." in session_id.
  for c: session_id { if c == '/' || c == '\\' || c == '.' { return; } }
  base_buf: [1024] u8;
  base := "";
  if profile.count > 0 {
    base = fs_join(profile, AGY_APP_DATA_DIR, base_buf[..]);
  } else if home.count > 0 {
    base = fs_join(home, ".gemini/antigravity-acp", base_buf[..]);
  }
  if base.count == 0 { return; }
  conv_buf: [1024] u8;
  conv := fs_join(base, "conversations", conv_buf[..]);
  if conv.count == 0 { return; }
  uri_buf: [1088] u8;
  un := agyw_copy(uri_buf[..], "file://");
  un += agyw_copy(uri_buf[un..<uri_buf.count], cwd);
  uri := cast(string) uri_buf[0..<un];
  exts := [2] string.[".db", ".pbtxt"];
  for ext: exts {
    nb: [256] u8; nn := agyw_copy(nb[..], session_id); nn += agyw_copy(nb[nn..<nb.count], ext);
    pb: [2048] u8; p := fs_join(conv, cast(string) nb[0..<nn], pb[..]);
    if p.count == 0 || !fs_exists(p) { continue; }
    rb: [65536] u8; rn := fs_read(p, rb[..]);
    if rn > 0 && agyw_session_db_owned(cast(string) rb[0..<rn], session_id, uri) {
      _ = fs_remove(p);
    }
  }
}

// agy started with the run's settings and one session opened (no prompt), then closed and its
// on-disk traces removed: "" with the model in s.ran / s.ran_name, else why not (agy's own words
// when it refused, e.g. "Authentication required").
AGYW_PROBE_MS :: 45000;
agyw_open_once :: (s: [] AgywState, x: [] CuEngine, why_out: [] u8) -> string {
  s[0].ran_n = 0; s[0].ran_name_n = 0;
  s[0].turn_model_n = agyw_copy(s[0].turn_model[..], agyw_resolve_model("", agyw_str(s[0].cfg.model[..], s[0].cfg.model_n)));
  s[0].turn_effort_n = agyw_copy(s[0].turn_effort[..], agyw_resolve_effort("", agyw_str(s[0].cfg.effort[..], s[0].cfg.effort_n)));
  hb: [1024] u8; cwd := cl_getenv("HOME", hb[..]);
  if cwd.count == 0 { cwd = cl_getenv("USERPROFILE", hb[..]); }
  if cwd.count == 0 { cwd = "."; }
  why := agyw_launch_engine(s, x, cwd);
  if why.count > 0 { return cast(string) why_out[0..<agyw_copy(why_out, why)]; }
  agyw_lease_acquire(s, x[0].p[0].pid);
  until := cxproc_now_ms() + AGYW_PROBE_MS;
  while x[0].live && s[0].ran_n == 0 && cxproc_now_ms() < until {
    ev: [1] CuEvent;
    cue_poll(x, ev[..]);
    if ev[0].kind == CuEventKind.idle { proc_sleep(20); continue; }
    agyw_handle_event(s, x, ev[0], false);
  }
  if s[0].ran_n == 0 {
    w := ifx x[0].live then "Antigravity opened no session in time." else cue_why(x);
    if w.count == 0 { w = "Antigravity stopped before it opened a session."; }
    wn := agyw_copy(why_out, w);
    if x[0].live { cue_close(x); }
    agyw_lease_release(s);
    return cast(string) why_out[0..<wn];
  }
  sid_buf: [CU_ID] u8; sid_n := agyw_copy(sid_buf[..], cu_session_id(x[0].c));
  cue_close(x);
  agyw_lease_release(s);
  agyw_probe_cleanup(agyw_str(s[0].cfg.profile[..], s[0].cfg.profile_n), cwd, cast(string) sid_buf[0..<sid_n], cwd);
  return "";
}

// agyworker --probe: agy started with the run's settings, one session opened, its model printed.
agyw_probe :: (s: [] AgywState, x: [] CuEngine) -> int {
  wb: [1024] u8; why := agyw_open_once(s, x, wb[..]);
  if why.count > 0 { tool_errln(why); return 1; }
  n := agyw_copy(s[0].out[..], agyw_str(s[0].ran[..], s[0].ran_n));
  n += agyw_copy(s[0].out[n..<s[0].out.count], "\t");
  n += agyw_copy(s[0].out[n..<s[0].out.count], agyw_str(s[0].ran_name[..], s[0].ran_name_n));
  agyw_write_line(s, n);
  return 0;
}
agyw_flag_asked :: (flag: string) -> bool {
  a: [1] Args;
  if !args_load(a[..]) { return false; }
  for i: 0..<args_count(a[..]) { if args_at(a[..], i) == flag { return true; } }
  return false;
}
agyw_probe_asked :: () -> bool { return agyw_flag_asked("--probe"); }
agyw_probe_json_asked :: () -> bool { return agyw_flag_asked("--probe-json"); }
agyw_logout_asked :: () -> bool { return agyw_flag_asked("--logout"); }

// Extract thought_level config option into JSON snippet:
// "thinking":true,"thoughtLevels":["low","medium","high","xhigh"],"thinkingId":"...","thinkingDefault":"...","thinkingLevels":[{"value":"...","label":"..."}]
agyw_put_thinking_json :: (o: [] ClOut, result: string, ar: [] ClArena) {
  opts := cl_raw(result, "configOptions");
  n := cl_count(opts);
  for i: 0..<n {
    item := cl_json(opts, cl_item(opts, i));
    if cl_str(ar, item, "category") != "thought_level" && cl_str(ar, item, "id") != "thought_level" { continue; }
    oid := cl_str(ar, item, "id");
    cur := cl_str(ar, item, "currentValue");
    choices := cl_raw(item, "options");
    m := cl_count(choices);
    cl_put(o, ",\"thinking\":"); cl_put(o, ifx m > 0 then "true" else "false");
    cl_put(o, ",\"thoughtLevels\":[");
    wrote_t := false;
    for j: 0..<m {
      ch := cl_json(choices, cl_item(choices, j));
      val := cl_str(ar, ch, "value");
      if val.count == 0 { continue; }
      if wrote_t { cl_put(o, ","); }
      cl_put_string(o, val);
      wrote_t = true;
    }
    cl_put(o, "]");
    cl_put(o, ",\"thinkingId\":"); cl_put_string(o, oid);
    cl_put(o, ",\"thinkingDefault\":"); cl_put_string(o, cur);
    cl_put(o, ",\"thinkingLevels\":[");
    wrote := false;
    for j: 0..<m {
      ch := cl_json(choices, cl_item(choices, j));
      val := cl_str(ar, ch, "value");
      if val.count == 0 { continue; }
      lbl := cl_str(ar, ch, "name");
      if lbl.count == 0 { lbl = val; }
      if wrote { cl_put(o, ","); }
      cl_put(o, "{\"value\":"); cl_put_string(o, val);
      cl_put(o, ",\"label\":"); cl_put_string(o, lbl);
      cl_put(o, "}");
      wrote = true;
    }
    cl_put(o, "]");
    return;
  }
  cl_put(o, ",\"thinking\":false,\"thoughtLevels\":[]");
}

AGYW_MAX_PROBED :: 24;
AgywProbedModel :: struct {
  slug: [128] u8; slug_n: int;
  name: [128] u8; name_n: int;
  is_default: bool;
}

agyw_probed_has :: (list: [] AgywProbedModel, count: int, slug: string) -> bool {
  for i: 0..<count {
    if cast(string) list[i].slug[0..<list[i].slug_n] == slug { return true; }
  }
  return false;
}

agyw_probed_push :: (list: [] AgywProbedModel, count: int, slug: string, name: string, cur_val: string) -> int {
  s := agyw_trim(slug);
  if s.count == 0 || count >= list.count || agyw_probed_has(list, count, s) { return count; }
  n := agyw_trim(name);
  if n.count == 0 { n = s; }
  list[count] = AgywProbedModel.{};
  list[count].slug_n = agyw_copy(list[count].slug[..], s);
  list[count].name_n = agyw_copy(list[count].name[..], n);
  list[count].is_default = cur_val.count > 0 && s == cur_val;
  return count + 1;
}

// Extract Antigravity models from session/new result (exact port of T3 buildAntigravityModelsFromSession):
// prefers configOptions[id=="model" || category=="model"] (flat or grouped options),
// falling back to models.availableModels only when configOptions has no model option.
// Writes the model configOption id into cfg_id_out (empty if fallback to models.availableModels).
agyw_collect_session_models :: (sess_json: string, ar: [] ClArena, out: [] AgywProbedModel, cfg_id_out: [] u8, cfg_id_n: [] int) -> int {
  cfg_id_n[0] = 0;
  count := 0;
  opts := cl_raw(sess_json, "configOptions");
  on := cl_count(opts);
  found_cfg := false;
  for i: 0..<on {
    item := cl_json(opts, cl_item(opts, i));
    oid := cl_str(ar, item, "id");
    cat := cl_str(ar, item, "category");
    if oid != "model" && cat != "model" { continue; }
    found_cfg = true;
    cfg_id_n[0] = agyw_copy(cfg_id_out, oid);
    cur := cl_str(ar, item, "currentValue");
    choices := cl_raw(item, "options");
    cn := cl_count(choices);
    for j: 0..<cn {
      ch := cl_json(choices, cl_item(choices, j));
      val := cl_str(ar, ch, "value");
      if val.count > 0 {
        count = agyw_probed_push(out, count, val, cl_str(ar, ch, "name"), cur);
      } else {
        sub := cl_raw(ch, "options");
        sn := cl_count(sub);
        for k: 0..<sn {
          sch := cl_json(sub, cl_item(sub, k));
          sval := cl_str(ar, sch, "value");
          if sval.count > 0 {
            count = agyw_probed_push(out, count, sval, cl_str(ar, sch, "name"), cur);
          }
        }
      }
    }
    break;
  }
  if found_cfg && count > 0 { return count; }
  // Fallback: models.availableModels (legacy agy < 1.4 or sessions without configOptions model)
  cur_m := cl_str(ar, sess_json, "models.currentModelId");
  models := cl_raw(sess_json, "models.availableModels");
  mc := cl_count(models);
  for i: 0..<mc {
    item := cl_json(models, cl_item(models, i));
    mid := cl_str(ar, item, "modelId");
    if mid.count > 0 {
      count = agyw_probed_push(out, count, mid, cl_str(ar, item, "name"), cur_m);
    }
  }
  return count;
}

// agyworker --probe-json: full T3 AntigravityProvider status + catalog probe.
// Emits one JSON line with version, authStatus, authMethod, models (with per-model thought_level options),
// hasAutoMode, defaultModel, and error message. Never logs API keys or tokens.
agyw_probe_json :: (s: [] AgywState, x: [] CuEngine) -> int {
  auth_cfg := agyw_auth_config(s);
  method := agy_auth_normalize(auth_cfg.method);
  o := [1] ClOut.[ClOut.{buf = s[0].out[..]}];
  prog := agyw_str(s[0].cfg.program[..], s[0].cfg.program_n);
  if prog.count == 0 {
    cl_put(o[..], "{\"installed\":false,\"authStatus\":\"unknown\",\"authMethod\":"); cl_put_string(o[..], method);
    cl_put(o[..], ",\"status\":\"error\",\"message\":"); cl_put_string(o[..], AGY_MISSING);
    cl_put(o[..], ",\"models\":[]}");
    agyw_write_line(s, o[0].len);
    return 0;
  }
  issue := ifx s[0].cfg.auth_method_n > 0 then agy_auth_config_issue(auth_cfg) else "";
  if issue.count > 0 {
    cl_put(o[..], "{\"installed\":true,\"binaryPath\":"); cl_put_string(o[..], prog);
    cl_put(o[..], ",\"authStatus\":\"unauthenticated\",\"authMethod\":"); cl_put_string(o[..], method);
    cl_put(o[..], ",\"status\":\"warning\",\"message\":"); cl_put_string(o[..], issue);
    cl_put(o[..], ",\"models\":[]}");
    agyw_write_line(s, o[0].len);
    return 0;
  }
  hb: [1024] u8; cwd := cl_getenv("HOME", hb[..]);
  if cwd.count == 0 { cwd = cl_getenv("USERPROFILE", hb[..]); }
  if cwd.count == 0 { cwd = "."; }
  why := agyw_launch_engine(s, x, cwd);
  if why.count > 0 {
    cl_put(o[..], "{\"installed\":true,\"binaryPath\":"); cl_put_string(o[..], prog);
    cl_put(o[..], ",\"authStatus\":\"unknown\",\"authMethod\":"); cl_put_string(o[..], method);
    cl_put(o[..], ",\"status\":\"error\",\"message\":"); cl_put_string(o[..], why);
    cl_put(o[..], ",\"models\":[]}");
    agyw_write_line(s, o[0].len);
    return 0;
  }
  agyw_lease_acquire(s, x[0].p[0].pid);
  until := cxproc_now_ms() + AGYW_PROBE_MS;
  sess_buf: [65536] u8; sess_n := 0;
  ver_buf: [64] u8; ver_n := 0;
  err_buf: [1024] u8; err_n := 0;
  authed := false;
  auth_refused := false;
  while x[0].live && sess_n == 0 && !auth_refused && cxproc_now_ms() < until {
    ev: [1] CuEvent;
    cue_poll(x, ev[..]);
    if ev[0].kind == CuEventKind.idle { proc_sleep(20); continue; }
    if ev[0].kind == CuEventKind.initialized {
      ver_n = agyw_copy(ver_buf[..], cu_version(x[0].c));
      vw := agy_check_version(cast(string) ver_buf[0..<ver_n]);
      if vw.count > 0 { err_n = agyw_copy(err_buf[..], vw); break; }
    } else if ev[0].kind == CuEventKind.refused && (ev[0].of == CU_AUTHENTICATE || ev[0].of == CU_SESSION_NEW) {
      auth_refused = true;
      err_n = agyw_copy(err_buf[..], ev[0].message);
      break;
    } else if ev[0].kind == CuEventKind.answered && ev[0].of == CU_SESSION_NEW {
      authed = true;
      sess_n = agyw_copy(sess_buf[..], ev[0].result);
      break;
    } else if ev[0].kind == CuEventKind.end || ev[0].kind == CuEventKind.failed {
      err_n = agyw_copy(err_buf[..], cue_why(x));
      break;
    }
  }
  if !authed {
    if err_n == 0 {
      w := cue_why(x);
      if w.count == 0 { w = "Antigravity could not authenticate with the configured credentials."; }
      err_n = agyw_copy(err_buf[..], w);
    }
    if x[0].live { cue_close(x); }
    agyw_lease_release(s);
    err_str := cast(string) err_buf[0..<err_n];
    is_unauth := auth_refused || agy_is_signin_required(err_str);
    err_str = agy_format_auth_error(err_str, method, true);
    cl_put(o[..], "{\"installed\":true,\"binaryPath\":"); cl_put_string(o[..], prog);
    cl_put(o[..], ",\"version\":"); cl_put_string(o[..], cast(string) ver_buf[0..<ver_n]);
    cl_put(o[..], ",\"authStatus\":"); cl_put_string(o[..], ifx is_unauth then "unauthenticated" else "unknown");
    cl_put(o[..], ",\"authMethod\":"); cl_put_string(o[..], method);
    cl_put(o[..], ",\"status\":"); cl_put_string(o[..], ifx is_unauth then "warning" else "error");
    cl_put(o[..], ",\"message\":"); cl_put_string(o[..], err_str);
    cl_put(o[..], ",\"models\":[]}");
    agyw_write_line(s, o[0].len);
    return 0;
  }
  // Authenticated! Extract default model + models list (configOptions first, fallback models.availableModels)
  // and probe per-model thought_level options (exact port of T3 AntigravityProvider.ts).
  sid_buf: [CU_ID] u8; sid_n := agyw_copy(sid_buf[..], cu_session_id(x[0].c));
  sess_json := cast(string) sess_buf[0..<sess_n];
  pab: [65536] u8; par := [1] ClArena.[ClArena.{buf = pab[..]}];
  probed: [AGYW_MAX_PROBED] AgywProbedModel;
  mcfg_id: [128] u8; mcfg_id_n: [1] int;
  mc := agyw_collect_session_models(sess_json, par[..], probed[..], mcfg_id[..], mcfg_id_n[..]);
  def_id_buf: [128] u8;
  def_name_buf: [128] u8;
  def_id := ""; def_name := "";
  for i: 0..<mc {
    if probed[i].is_default {
      def_id = cast(string) def_id_buf[0..<agyw_copy(def_id_buf[..], cast(string) probed[i].slug[0..<probed[i].slug_n])];
      def_name = cast(string) def_name_buf[0..<agyw_copy(def_name_buf[..], cast(string) probed[i].name[0..<probed[i].name_n])];
      break;
    }
  }
  if def_id.count == 0 {
    par[0].at = 0; par[0].full = false;
    def_id = agy_effective_at(sess_json, "", "", AGYW_EFFORT, par[..], def_id_buf[..]);
    def_name = cast(string) def_name_buf[0..<agyw_copy(def_name_buf[..], agy_model_shown(sess_json, def_id, par[..]))];
  }
  cl_put(o[..], "{\"installed\":true,\"binaryPath\":"); cl_put_string(o[..], prog);
  cl_put(o[..], ",\"version\":"); cl_put_string(o[..], cast(string) ver_buf[0..<ver_n]);
  cl_put(o[..], ",\"authStatus\":\"authenticated\",\"authMethod\":"); cl_put_string(o[..], method);
  cl_put(o[..], ",\"authLabel\":"); cl_put_string(o[..], agy_auth_label(method));
  cl_put(o[..], ",\"status\":\"ready\",\"hasAutoMode\":");
  cl_put(o[..], ifx cu_has_auto_mode(x[0].c) then "true" else "false");
  cl_put(o[..], ",\"defaultModel\":"); cl_put_string(o[..], def_id);
  cl_put(o[..], ",\"defaultModelName\":"); cl_put_string(o[..], def_name);
  cl_put(o[..], ",\"models\":[");
  wrote_m := false;
  switched_model := false;
  has_cfg_model := mcfg_id_n[0] > 0;
  cfg_model_id := cast(string) mcfg_id[0..<mcfg_id_n[0]];
  for i: 0..<mc {
    par[0].at = 0; par[0].full = false;
    mid := cast(string) probed[i].slug[0..<probed[i].slug_n];
    mname := cast(string) probed[i].name[0..<probed[i].name_n];
    // Probe per-model thinking config options via set_config_option / set_model (skip current default which sess_json already describes).
    mres_buf: [16384] u8; mres_n := 0;
    if !probed[i].is_default && x[0].live && cxproc_now_ms() < until {
      want_of := ifx has_cfg_model then CU_SESSION_SET_CONFIG else CU_SESSION_SET_MODEL;
      if has_cfg_model { _ = cu_set_config(x[0].c, cfg_model_id, mid); }
      else { _ = cu_set_model(x[0].c, mid); }
      _ = cu_flush(x[0].c, x[0].p);
      switched_model = true;
      m_until := cxproc_now_ms() + 3000;
      while x[0].live && cxproc_now_ms() < m_until {
        mev: [1] CuEvent;
        cue_poll(x, mev[..]);
        if mev[0].kind == CuEventKind.idle { proc_sleep(10); continue; }
        if mev[0].kind == CuEventKind.answered && mev[0].of == want_of {
          if cl_raw(mev[0].result, "configOptions").count > 0 {
            mres_n = agyw_copy(mres_buf[..], mev[0].result);
          }
          break;
        }
        if mev[0].kind == CuEventKind.refused && mev[0].of == want_of { break; }
        if mev[0].kind == CuEventKind.notification && mev[0].method == "session/update" {
          upd := cl_raw(mev[0].params, "update");
          if cl_str(x[0].c[0].ar[..], upd, "sessionUpdate") == "config_option_update" {
            mres_n = agyw_copy(mres_buf[..], upd);
          }
        }
        if mev[0].kind == CuEventKind.end || mev[0].kind == CuEventKind.failed { break; }
      }
    }
    if wrote_m { cl_put(o[..], ","); }
    cl_put(o[..], "{\"slug\":"); cl_put_string(o[..], mid);
    cl_put(o[..], ",\"name\":"); cl_put_string(o[..], mname);
    cl_put(o[..], ",\"isDefault\":"); cl_put(o[..], ifx probed[i].is_default then "true" else "false");
    agyw_put_thinking_json(o[..], ifx mres_n > 0 then cast(string) mres_buf[0..<mres_n] else sess_json, par[..]);
    cl_put(o[..], "}");
    wrote_m = true;
  }
  // Restore original default model on the session before closing, matching T3 publishCatalog.
  if switched_model && def_id.count > 0 && x[0].live {
    if has_cfg_model { _ = cu_set_config(x[0].c, cfg_model_id, def_id); }
    else { _ = cu_set_model(x[0].c, def_id); }
    _ = cu_flush(x[0].c, x[0].p);
  }
  cl_put(o[..], "]}");
  cue_close(x);
  agyw_lease_release(s);
  agyw_probe_cleanup(agyw_str(s[0].cfg.profile[..], s[0].cfg.profile_n), cwd, cast(string) sid_buf[0..<sid_n], cwd);
  agyw_write_line(s, o[0].len);
  return 0;
}

// agyworker --logout: sign out the profile via ACP logout RPC (port of T3 AntigravityAuth.ts signOut).
agyw_logout :: (s: [] AgywState, x: [] CuEngine) -> int {
  o := [1] ClOut.[ClOut.{buf = s[0].out[..]}];
  hb: [1024] u8; cwd := cl_getenv("HOME", hb[..]);
  if cwd.count == 0 { cwd = cl_getenv("USERPROFILE", hb[..]); }
  if cwd.count == 0 { cwd = "."; }
  // Start without auto-opening a session: send logout immediately after initialize!
  prog := agyw_str(s[0].cfg.program[..], s[0].cfg.program_n);
  prof := agyw_str(s[0].cfg.profile[..], s[0].cfg.profile_n);
  if prog.count == 0 {
    cl_put(o[..], "{\"ok\":false,\"error\":\"Antigravity CLI not found\"}");
    agyw_write_line(s, o[0].len);
    return 1;
  }
  cue_agent(x, agy_agent());
  e: [1] AgyEnv; l: [1] CuLaunch;
  agy_prepare_launch_auth(l[..], e[..], prog, cwd, prof, agyw_auth_config(s));
  _ = agy_wrap_windows_cmd(l[..]);
  why := cue_start(x, l[0], "openagents-agyworker", "1.0");
  if why.count > 0 {
    cl_put(o[..], "{\"ok\":false,\"error\":"); cl_put_string(o[..], why); cl_put(o[..], "}");
    agyw_write_line(s, o[0].len);
    return 1;
  }
  until := cxproc_now_ms() + 15000;
  sent_logout := false;
  ok := false;
  err_buf: [512] u8; err_n := 0;
  while x[0].live && cxproc_now_ms() < until {
    ev: [1] CuEvent;
    ev[0] = cu_poll(x[0].c, x[0].p, 0);
    if ev[0].kind == CuEventKind.idle { proc_sleep(20); continue; }
    if ev[0].kind == CuEventKind.initialized && !sent_logout {
      _ = cu_logout(x[0].c);
      sent_logout = true;
    } else if ev[0].kind == CuEventKind.answered && ev[0].of == CU_LOGOUT {
      ok = true; break;
    } else if ev[0].kind == CuEventKind.refused && ev[0].of == CU_LOGOUT {
      err_n = agyw_copy(err_buf[..], ev[0].message); break;
    } else if ev[0].kind == CuEventKind.end || ev[0].kind == CuEventKind.failed {
      err_n = agyw_copy(err_buf[..], cu_error(x[0].c)); break;
    }
  }
  cue_close(x);
  if ok {
    cl_put(o[..], "{\"ok\":true}");
    agyw_write_line(s, o[0].len);
    return 0;
  }
  err_str := ifx err_n > 0 then cast(string) err_buf[0..<err_n] else "Logout timed out or failed.";
  cl_put(o[..], "{\"ok\":false,\"error\":"); cl_put_string(o[..], err_str); cl_put(o[..], "}");
  agyw_write_line(s, o[0].len);
  return 1;
}

// ---------------------------------------------------------------- --connect (the desktop's "Connect Google Antigravity")
//
// agyworker --connect [--code FILE]: makes agy usable here, saying what it does one line at a time
// (KIND<TAB>TEXT on stdout, which the desktop reads from a log file):
//   step  words for what it is doing now
//   progress  PCT<TAB>DONE_MB<TAB>TOTAL_MB while the Antigravity CLI downloads (TOTAL_MB 0: unknown)
//   profile   the agy profile folder it signs in to (OpenAgents' own, file-backed sign-in), which
//         the desktop then passes to the Antigravity worker as CODER_AGY_PROFILE
//   url   the Google sign-in page (https://accounts.google.com/...) to open; the code Google then
//         shows is read from FILE once the desktop writes it there, and handed to agy
//   ok    agy runs here and is signed in: the model it runs on ("Gemini 4 Carbon (Low)")
//   fail  why it could not
// Steps: the Antigravity CLI (CODER_AGY_BIN, on PATH, or the managed install), else installed from
// Google's release list into ~/.openagents/runtimes/agy; a session opened as --probe does; when agy
// says it is not signed in, `agy acp --login` (as t3code signs in, docs/audits/
// 2026-11-20-t3code-antigravity-v0-1-11-audit.md §3.1), then a session again.
AGYW_LOGIN_MS :: 600000;

agyw_say :: (s: [] AgywState, kind: string, text: string) {
  n := agyw_copy(s[0].out[..], kind);
  n += agyw_copy(s[0].out[n..<s[0].out.count], "\t");
  // one line: newlines and tabs in agy's words become spaces
  for c: text {
    if n >= s[0].out.count - 2 { break; }
    s[0].out[n] = ifx c == '\n' || c == '\r' || c == '\t' then ' ' else c;
    n += 1;
  }
  agyw_write_line(s, n);
}

agyw_arg_value :: (name: string, out: [] u8) -> string {
  a: [1] Args;
  if !args_load(a[..]) { return ""; }
  v := args_value(a[..], name, "");
  return cast(string) out[0..<agyw_copy(out, v)];
}

agyw_connect_asked :: () -> bool {
  a: [1] Args;
  if !args_load(a[..]) { return false; }
  for i: 0..<args_count(a[..]) { if args_at(a[..], i) == "--connect" { return true; } }
  return false;
}

agyw_ends_with :: (s: string, tail: string) -> bool {
  return s.count >= tail.count && cast(string) s[s.count - tail.count..<s.count] == tail;
}

// `agy acp --login`: the sign-in page's address relayed as "url", the code (or callback URL) from
// code_path validated and handed to agy's stdin, its end awaited: "" when agy signed in, else why not.
agyw_login :: (s: [] AgywState, code_path: string, why_out: [] u8) -> string {
  prog := agyw_str(s[0].cfg.program[..], s[0].cfg.program_n);
  prof := agyw_str(s[0].cfg.profile[..], s[0].cfg.profile_n);
  auth_cfg := agyw_auth_config(s);
  method := agy_auth_normalize(auth_cfg.method);
  if prof.count > 0 && s[0].cfg.auth_method_n > 0 { _ = agy_write_settings_json(prof, auth_cfg); }
  h := proc_new();
  if h < 0 { return cast(string) why_out[0..<agyw_copy(why_out, "Could not start the Antigravity CLI to sign in.")]; }
  ok := true;
  if agyw_ends_with(prog, ".cmd") || agyw_ends_with(prog, ".bat") || agyw_ends_with(prog, ".CMD") || agyw_ends_with(prog, ".BAT") {
    ok = proc_arg(h, "cmd.exe") && proc_arg(h, "/c");
  }
  ok = ok && proc_arg(h, prog) && proc_arg(h, "acp");
  if prof.count > 0 {
    ok = ok && proc_arg(h, "--gemini-dir") && proc_arg(h, prof) && proc_arg(h, "--app-data-dir") && proc_arg(h, AGY_APP_DATA_DIR);
    gb: [1100] u8; gn := agyw_copy(gb[..], "GEMINI_HOME="); gn += agyw_copy(gb[gn..<gb.count], prof);
    ok = ok && proc_env(h, cast(string) gb[0..<gn]);
    if method == AGY_AUTH_OAUTH_PERSONAL {
      ok = ok && proc_env(h, "SSH_CONNECTION=127.0.0.1 0 127.0.0.1 0");
    } else {
      ok = ok && proc_unset(h, "SSH_CONNECTION");
    }
  }
  ok = ok && proc_arg(h, "--login") && proc_env(h, "AGY_CLI_DISABLE_AUTO_UPDATE=1") && proc_env(h, "AGY_ACP_FORCE_FILE_STORAGE=1");
  // Strip all 19 ambient credentials + DISPLAY/WAYLAND_DISPLAY so agy prints the sign-in address (#13837).
  rem := AGY_REMOVED_ENV_KEYS;
  for i: 0..<AGY_REMOVED_ENV_COUNT { ok = ok && proc_unset(h, rem[i]); }
  ok = ok && proc_unset(h, "DISPLAY") && proc_unset(h, "WAYLAND_DISPLAY") && proc_err_to_out(h);
  hb: [1024] u8; home := cl_getenv("HOME", hb[..]);
  if home.count == 0 { home = cl_getenv("USERPROFILE", hb[..]); }
  if home.count > 0 { ok = ok && proc_cwd(h, home); }
  if !ok { _ = proc_release(h); return cast(string) why_out[0..<agyw_copy(why_out, "Could not prepare the Antigravity sign-in.")]; }
  if proc_start(h) != 0 { _ = proc_release(h); return cast(string) why_out[0..<agyw_copy(why_out, "Could not start the Antigravity CLI to sign in.")]; }
  deadline := cxproc_now_ms() + AGYW_LOGIN_MS;
  sent_url := false; sent_code := false; timed_out := false;
  state_buf: [256] u8; state_n := 0;
  line: [8192] u8;
  tail: [512] u8; tail_n := 0;
  while true {
    n := proc_line(h, 250, line[..]);
    if n == PROC_EOF || n == PROC_ERROR { break; }
    if n >= 0 {
      text := agyw_trim(cast(string) line[0..<n]);
      ub: [4096] u8;
      if !sent_url {
        st_tmp: [256] u8;
        mode := agy_parse_auth_url_detail(text, ub[..], st_tmp[..]);
        u := ifx mode != AGY_OAUTH_MODE_NONE then agy_parse_oauth_url(text, ub[..]) else agy_parse_oauth_url(text, ub[..]);
        if u.count > 0 {
          st_str := agy_query_param(u, "state", state_buf[..]);
          state_n = st_str.count;
          agyw_say(s, "url", u);
          sent_url = true;
        } else if text.count > 0 { tail_n = agyw_copy(tail[..], text); }
      } else if text.count > 0 { tail_n = agyw_copy(tail[..], text); }
    }
    if sent_url && !sent_code && code_path.count > 0 && fs_exists(code_path) {
      cb: [4096] u8; cn := fs_read(code_path, cb[..]);
      raw := ifx cn > 0 then agyw_trim(cast(string) cb[0..<cn]) else "";
      if raw.count > 0 {
        parsed_buf: [2048] u8; err_buf: [256] u8;
        code := agy_parse_login_response(raw, cast(string) state_buf[0..<state_n], parsed_buf[..], err_buf[..]);
        _ = fs_remove(code_path);
        if code.count > 0 {
          _ = proc_send(h, code); _ = proc_send(h, "\n");
          sent_code = true;
          agyw_say(s, "step", "Finishing the Google sign-in…");
        } else {
          err_msg := cast(string) err_buf[0..<256];
          en := 0; while en < err_msg.count && err_msg[en] != 0 { en += 1; }
          agyw_say(s, "warn", ifx en > 0 then cast(string) err_buf[0..<en] else "Invalid sign-in code or callback URL.");
        }
      }
    }
    if cxproc_now_ms() > deadline { timed_out = true; break; }
  }
  if timed_out { _ = proc_kill(h, PROC_SIGKILL); }
  st := proc_wait(h, ifx timed_out then 2000 else 15000);
  if st == PROC_RUNNING { _ = proc_kill(h, PROC_SIGKILL); st = proc_wait(h, 2000); }
  _ = proc_release(h);
  if timed_out { return cast(string) why_out[0..<agyw_copy(why_out, "The Google sign-in was not finished in time. Try again.")]; }
  if st != 0 {
    w := ifx tail_n > 0 then cast(string) tail[0..<tail_n] else "The Antigravity sign-in did not finish.";
    return cast(string) why_out[0..<agyw_copy(why_out, w)];
  }
  return "";
}

// The size curl will download from url (its last Content-Length, after redirects), or -1.
agyw_remote_size :: (url: string) -> int {
  argv := [4] string.["curl", "-fsSIL", "--max-time", "20"];
  h := proc_new();
  if h < 0 { return -1; }
  ok := true;
  for a: argv { ok = ok && proc_arg(h, a); }
  ok = ok && proc_arg(h, url) && proc_err_to_out(h);
  if !ok || proc_start(h) != 0 { _ = proc_release(h); return -1; }
  size := -1;
  line: [2048] u8;
  while true {
    n := proc_line(h, 25000, line[..]);
    if n < 0 { break; }
    t := agyw_trim(cast(string) line[0..<n]);
    key := "content-length:";
    if t.count > key.count {
      same := true;
      for i: 0..<key.count {
        lc := cast(int) t[i];
        if lc >= 65 && lc <= 90 { lc += 32; }
        if lc != cast(int) key[i] { same = false; break; }
      }
      if same {
        v := 0; any := false;
        for i: key.count..<t.count {
          d := cast(int) t[i];
          if d >= 48 && d <= 57 { v = v * 10 + (d - 48); any = true; } else if any { break; }
        }
        if any { size = v; }
      }
    }
  }
  _ = proc_wait(h, 5000);
  _ = proc_release(h);
  return size;
}

// v (0 or more) in decimal into out at n: the new n.
agyw_put_int :: (out: [] u8, n0: int, v0: int) -> int {
  n := n0; v := ifx v0 < 0 then 0 else v0;
  tmp: [24] u8; k := 0;
  while true { tmp[k] = cast(u8) (48 + v % 10); k += 1; v /= 10; if v == 0 || k == tmp.count { break; } }
  for i: 0..<k { if n < out.count { out[n] = tmp[k - 1 - i]; n += 1; } }
  return n;
}

#test "agyworker: progress numbers are written whole, zero included" {
  b: [32] u8;
  n := agyw_put_int(b[..], 0, 0); n = agyw_put_int(b[..], n, 52); n = agyw_put_int(b[..], n, 1234);
  #assert cast(string) b[0..<n] == "0521234";
}

// "progress<TAB>PCT<TAB>DONE_MB<TAB>TOTAL_MB" (TOTAL_MB 0 when the size is not known).
agyw_say_progress :: (s: [] AgywState, pct: int, done_mb: int, total_mb: int) {
  pb: [64] u8; n := 0;
  n = agyw_put_int(pb[..], n, pct); pb[n] = '\t'; n += 1;
  n = agyw_put_int(pb[..], n, done_mb); pb[n] = '\t'; n += 1;
  n = agyw_put_int(pb[..], n, total_mb);
  agyw_say(s, "progress", cast(string) pb[0..<n]);
}

// The newest managed agy for this machine from Google's release list, downloaded by curl in the
// background so "progress" lines can say how far it is, then verified and installed by the
// installer library (agy_install_from_manifest): "" and agy's path in s.cfg.program, else why not.
agyw_install :: (s: [] AgywState, why_out: [] u8) -> string {
  hb: [4096] u8; home := cl_getenv("HOME", hb[..]);
  if home.count == 0 { home = cl_getenv("USERPROFILE", hb[..]); }
  rb: [4200] u8; root := agy_managed_root(home, rb[..]);
  if root.count == 0 { return cast(string) why_out[0..<agyw_copy(why_out, "Could not find the home folder to install the Antigravity CLI in.")]; }
  os := agy_host_os();
  ab: [16] u8; arch := agy_host_arch(ab[..]);
  mb: [8192] u8; mjson := agy_fetch_manifest(os, arch, false, mb[..]);
  if mjson.count == 0 { return cast(string) why_out[0..<agyw_copy(why_out, "Could not reach Google's Antigravity CLI release list. Check the internet connection.")]; }
  rel: [1] AgyRelease;
  if !agy_parse_release(mjson, os, arch, false, rel[..]) { return cast(string) why_out[0..<agyw_copy(why_out, "Google's Antigravity CLI release list was not one this version understands.")]; }
  url := cast(string) rel[0].url[0..<rel[0].nurl];
  ridb: [80] u8; rid := agy_release_id_from_sha512(cast(string) rel[0].sha512[0..<rel[0].nsha512], ridb[..]);
  eb: [1280] u8; target := agy_managed_exe_path(root, rid, os == "windows", eb[..]);
  dl := "";
  dlb: [1280] u8;
  if rid.count == 64 && target.count > 0 && fs_kind(target) != FS_FILE {
    sb: [1024] u8; stg := fs_join(root, "staging", sb[..]);
    if stg.count == 0 || !fs_mkdir_all(stg) { return cast(string) why_out[0..<agyw_copy(why_out, "Could not make the Antigravity CLI's download folder.")]; }
    nb: [96] u8; nn := agyw_copy(nb[..], rid); nn += agyw_copy(nb[nn..<nb.count], ".progress");
    dl = fs_join(stg, cast(string) nb[0..<nn], dlb[..]);
    _ = fs_remove(dl);
    total := agyw_remote_size(url);
    total_mb := ifx total > 0 then (total + 524288) / 1048576 else 0;
    agyw_say_progress(s, 0, 0, total_mb);
    h := proc_new();
    if h < 0 { return cast(string) why_out[0..<agyw_copy(why_out, "Could not start the download.")]; }
    ok := proc_arg(h, "curl") && proc_arg(h, "-fsSL") && proc_arg(h, "--retry") && proc_arg(h, "2") && proc_arg(h, "-o") && proc_arg(h, dl) && proc_arg(h, url) && proc_quiet(h);
    if !ok || proc_start(h) != 0 { _ = proc_release(h); return cast(string) why_out[0..<agyw_copy(why_out, "Could not start the download (curl).")]; }
    last_pct := -1; last_mb := -1;
    st := PROC_RUNNING;
    while true {
      st = proc_wait(h, 300);
      got := fs_size(dl);
      if got < 0 { got = 0; }
      pct := ifx total > 0 then (got * 100) / total else 0;
      if pct > 99 && st == PROC_RUNNING { pct = 99; }
      done_mb := got / 1048576;
      if pct != last_pct || (total <= 0 && done_mb != last_mb) { agyw_say_progress(s, pct, done_mb, total_mb); last_pct = pct; last_mb = done_mb; }
      if st != PROC_RUNNING { break; }
    }
    _ = proc_release(h);
    if st != 0 { _ = fs_remove(dl); return cast(string) why_out[0..<agyw_copy(why_out, "The Antigravity CLI download failed. Check the internet connection and try again.")]; }
    agyw_say_progress(s, 100, ifx total_mb > 0 then total_mb else last_mb, total_mb);
    agyw_say(s, "step", "Verifying the Antigravity CLI…");
  }
  xb: [4300] u8;
  err := agy_install_from_manifest(root, mjson, os, arch, false, dl, true, xb[..]);
  if dl.count > 0 { _ = fs_remove(dl); }
  if err.count > 0 { return cast(string) why_out[0..<agyw_copy(why_out, err)]; }
  s[0].cfg.program_n = agy_program(s[0].cfg.program[..]).count;
  if s[0].cfg.program_n == 0 && target.count > 0 && fs_kind(target) == FS_FILE {
    s[0].cfg.program_n = agyw_copy(s[0].cfg.program[..], target);
  }
  if s[0].cfg.program_n == 0 { return cast(string) why_out[0..<agyw_copy(why_out, "The Antigravity CLI installed but could not be found.")]; }
  return "";
}

// --connect keeps OpenAgents' own agy profile (CODER_AGY_PROFILE, else ~/.openagents/runtimes/agy/profile):
// agy then keeps its Google sign-in as a file in it (agy_prepare_launch sets SSH_CONNECTION and
// GEMINI_HOME for a profile), so whether it is signed in is a file, not a session that waits.
agyw_default_profile :: (s: [] AgywState) {
  if s[0].cfg.profile_n > 0 { return; }
  hb: [4096] u8; home := cl_getenv("HOME", hb[..]);
  if home.count == 0 { home = cl_getenv("USERPROFILE", hb[..]); }
  rb: [4200] u8; root := agy_managed_root(home, rb[..]);
  if root.count == 0 { return; }
  pb: [1024] u8; prof := fs_join(root, "profile", pb[..]);
  if prof.count > 0 && prof.count <= s[0].cfg.profile.count && fs_mkdir_all(prof) {
    s[0].cfg.profile_n = agyw_copy(s[0].cfg.profile[..], prof);
  }
}

agyw_signed_in_file :: (s: [] AgywState) -> bool {
  prof := agyw_str(s[0].cfg.profile[..], s[0].cfg.profile_n);
  if prof.count == 0 { return false; }
  hb: [4096] u8; home := cl_getenv("HOME", hb[..]);
  if home.count == 0 { home = cl_getenv("USERPROFILE", hb[..]); }
  tb: [1100] u8; tok := agy_token_path(home, prof, tb[..]);
  return tok.count > 0 && fs_exists(tok);
}

agyw_connect :: (s: [] AgywState, x: [] CuEngine) -> int {
  cpb: [1024] u8; code_path := agyw_arg_value("--code", cpb[..]);
  if code_path.count == 0 { code_path = agyw_trim(cl_getenv("CODER_AGY_CODE_FILE", cpb[..])); }
  auth_cfg := agyw_auth_config(s);
  method := agy_auth_normalize(auth_cfg.method);
  if s[0].cfg.auth_method_n > 0 {
    issue := agy_auth_config_issue(auth_cfg);
    if issue.count > 0 { agyw_say(s, "fail", issue); return 1; }
  }
  if s[0].cfg.program_n == 0 {
    agyw_say(s, "step", "Downloading the Antigravity CLI from Google…");
    ib: [1024] u8; iw := agyw_install(s, ib[..]);
    if iw.count > 0 { agyw_say(s, "fail", iw); return 1; }
  }
  agyw_default_profile(s);
  prof := agyw_str(s[0].cfg.profile[..], s[0].cfg.profile_n);
  if prof.count > 0 && s[0].cfg.auth_method_n > 0 { _ = agy_write_settings_json(prof, auth_cfg); }
  agyw_say(s, "profile", prof);
  wb: [1024] u8;
  // Non-browser auth methods (gemini-api-key, agent-platform): verify credentials directly.
  if s[0].cfg.auth_method_n > 0 && !agy_auth_uses_browser(method) {
    agyw_say(s, "step", "Verifying Antigravity credentials…");
    why := agyw_open_once(s, x, wb[..]);
    if why.count > 0 { agyw_say(s, "fail", agy_format_auth_error(why, method, true)); return 1; }
    return agyw_connected(s);
  }
  why := "";
  signed := agyw_signed_in_file(s);
  force_login := agyw_flag_asked("--force-login");
  if signed && !force_login {
    agyw_say(s, "step", "Checking your Antigravity sign-in…");
    why = agyw_open_once(s, x, wb[..]);
    if why.count == 0 { return agyw_connected(s); }
    if !agy_is_signin_required(why) && agyw_signed_in_file(s) { agyw_say(s, "fail", agy_format_auth_error(why, method, true)); return 1; }
  }
  agyw_say(s, "step", "Opening the Google sign-in…");
  lb: [1024] u8; lw := agyw_login(s, code_path, lb[..]);
  if lw.count > 0 { agyw_say(s, "fail", agy_format_auth_error(lw, method, true)); return 1; }
  agyw_say(s, "step", "Starting Antigravity…");
  why = agyw_open_once(s, x, wb[..]);
  if why.count > 0 { agyw_say(s, "fail", agy_format_auth_error(why, method, true)); return 1; }
  return agyw_connected(s);
}

agyw_connected :: (s: [] AgywState) -> int {
  name := agyw_str(s[0].ran_name[..], s[0].ran_name_n);
  if name.count == 0 { name = agyw_str(s[0].ran[..], s[0].ran_n); }
  agyw_say(s, "ok", ifx name.count > 0 then name else "Antigravity");
  return 0;
}

// Re-apply model or thought_level on an already-open session when a later turn changes either,
// e.g. switching from low (which emits no thoughts on Carbon/Flash) to medium or high mid-chat.
// Returns true when a setting change was sent (holding cue_send until acknowledged).
agyw_reconfigure :: (s: [] AgywState, x: [] CuEngine, mod: string, eff: string, mode: string, emit: bool) -> bool {
  if !x[0].live || !x[0].ready { return false; }
  prev_mod := agyw_str(s[0].active_model[..], s[0].active_model_n);
  prev_eff := agyw_str(s[0].active_effort[..], s[0].active_effort_n);
  if mod == prev_mod && eff == prev_eff { return false; }
  x[0].c[0].ar[0].at = 0; x[0].c[0].ar[0].full = false;
  caps := agyw_str(s[0].sess_json[..], s[0].sess_json_n);
  if caps.count > 0 {
    missed := agy_configure_at(x, caps, mod, eff, mode, AGYW_EFFORT);
    if eff.count > 0 && (missed & AGY_EFFORT_NOT_APPLIED) != 0 && eff == "xhigh" {
      cue_set(x, "thought_level", eff);
    }
    agyw_ran(s, x, caps, mod, eff, emit);
  } else {
    x[0].hold = 0;
    if mod != prev_mod && mod.count > 0 { cue_set_model(x, mod); }
    if eff != prev_eff {
      level := ifx eff.count > 0 then eff else AGYW_EFFORT;
      cue_set(x, "thought_level", level);
    }
  }
  s[0].active_model_n = agyw_copy(s[0].active_model[..], mod);
  s[0].active_effort_n = agyw_copy(s[0].active_effort[..], eff);
  return x[0].hold > 0;
}

agyw_handle_event :: (s: [] AgywState, x: [] CuEngine, ev: CuEvent, emit: bool) {
  if ev.kind == CuEventKind.none || ev.kind == CuEventKind.idle { return; }
  if ev.kind == CuEventKind.initialized {
    ver := cu_version(x[0].c);
    why := agy_check_version(ver);
    if why.count > 0 {
      cue_close(x);
      agyw_lease_release(s);
      agyw_finish_turn(s, "failed", why, emit);
    }
    return;
  }
  if ev.kind == CuEventKind.answered {
    if ev.of == CU_SESSION_NEW || ev.of == CU_SESSION_LOAD || ev.of == CU_SESSION_RESUME {
      if ev.result.count > 0 && (agy_has(ev.result, "configOptions") || agy_has(ev.result, "models")) {
        s[0].sess_json_n = agyw_copy(s[0].sess_json[..], ev.result);
      }
      mod := agyw_str(s[0].turn_model[..], s[0].turn_model_n);
      eff := agyw_str(s[0].turn_effort[..], s[0].turn_effort_n);
      mode := agyw_str(s[0].cfg.mode[..], s[0].cfg.mode_n);
      s[0].active_model_n = agyw_copy(s[0].active_model[..], mod);
      s[0].active_effort_n = agyw_copy(s[0].active_effort[..], eff);
      missed := agy_configure_at(x, ev.result, mod, eff, mode, AGYW_EFFORT);
      if eff.count > 0 && (missed & AGY_EFFORT_NOT_APPLIED) != 0 && eff == "xhigh" {
        cue_set(x, "thought_level", eff);
      }
      agyw_ran(s, x, ev.result, mod, eff, emit);
      cue_owed(x, s[0].turn_active);
      return;
    }
    if ev.of == CU_SESSION_SET_CONFIG || ev.of == CU_SESSION_SET_MODEL || ev.of == CU_SESSION_SET_MODE {
      cue_owed(x, s[0].turn_active);
      return;
    }
    if ev.of == CU_SESSION_PROMPT {
      if !s[0].turn_active { return; }
      if cue_held_bg(x) { return; }
      if s[0].stopping {
        agyw_finish_turn(s, "stopped", "Stopped.", emit);
        return;
      }
      if cue_stalled(x) {
        agyw_finish_turn(s, "failed", "Antigravity stopped responding and the stall watchdog gave up.", emit);
        return;
      }
      notice := agy_turn_failed(x, ev.result);
      if notice.count > 0 {
        agyw_finish_turn(s, "failed", notice, emit);
        return;
      }
      agyw_turn_end(s, x[0].c[0].ar[..], ev.result, emit);
      return;
    }
    return;
  }
  if ev.kind == CuEventKind.refused {
    if ev.of == CU_AUTHENTICATE || ev.of == CU_SESSION_NEW {
      raw_why := ifx ev.message.count > 0 then ev.message else "Antigravity could not authenticate with the configured credentials.";
      why := ifx emit then agy_format_auth_error(raw_why, agyw_str(s[0].cfg.auth_method[..], s[0].cfg.auth_method_n), false) else raw_why;
      x[0].err_n = agyw_copy(x[0].err[..], why);
      cue_close(x);
      agyw_lease_release(s);
      if s[0].turn_active { agyw_finish_turn(s, "failed", why, emit); }
      return;
    }
    if ev.of == CU_SESSION_SET_CONFIG || ev.of == CU_SESSION_SET_MODEL || ev.of == CU_SESSION_SET_MODE {
      cue_owed(x, s[0].turn_active);
      return;
    }
    if ev.of == CU_SESSION_PROMPT {
      if !s[0].turn_active { return; }
      if agy_lost_thinking_signature(ev.message) && !s[0].retried_sig && s[0].last_prompt_n > 0 {
        s[0].retried_sig = true;
        s[0].reply_n = 0;
        s[0].reply_break = false;
        cue_fresh_session(x);
        _ = cue_send(x, agyw_str(s[0].last_prompt[..], s[0].last_prompt_n));
        return;
      }
      raw_why := ifx ev.message.count > 0 then ev.message else "Antigravity refused the prompt.";
      why := ifx emit then agy_format_auth_error(raw_why, agyw_str(s[0].cfg.auth_method[..], s[0].cfg.auth_method_n), false) else raw_why;
      agyw_finish_turn(s, "failed", why, emit);
      return;
    }
    return;
  }
  if ev.kind == CuEventKind.notification {
    if ev.method == "session/update" { agyw_handle_update(s, x, ev.params, emit); }
    return;
  }
  if ev.kind == CuEventKind.permission {
    mode := agyw_str(s[0].cfg.mode[..], s[0].cfg.mode_n);
    _ = agyw_on_permission(s, x[0].c, ev.params, mode, emit);
    return;
  }
  if ev.kind == CuEventKind.question { cu_question(x[0].c, true); return; }
  if ev.kind == CuEventKind.plan { cu_plan(x[0].c, false); return; }
  if ev.kind == CuEventKind.end || ev.kind == CuEventKind.failed {
    agyw_lease_release(s);
    if s[0].turn_active {
      if x[0].restart_required && !s[0].respawned && s[0].last_prompt_n > 0 {
        s[0].respawned = true;
        _ = cue_prepare_restart(x);
        why := agyw_launch_engine(s, x, agyw_str(s[0].cwd[..], s[0].cwd_n));
        if why.count == 0 {
          agyw_lease_acquire(s, x[0].p[0].pid);
          _ = cue_send(x, agyw_str(s[0].last_prompt[..], s[0].last_prompt_n));
          return;
        }
      }
      raw_why := cue_why(x);
      if raw_why.count == 0 { raw_why = "Antigravity process stopped unexpectedly."; }
      why := ifx emit then agy_format_auth_error(raw_why, agyw_str(s[0].cfg.auth_method[..], s[0].cfg.auth_method_n), false) else raw_why;
      agyw_finish_turn(s, "failed", why, emit);
    }
  }
}

// ---------------------------------------------------------------- main loop

// Handle MWW_STOP / MWW_INTERRUPT. Returns true when an active live turn entered graceful stop
// and tool_main should arm stop_deadline_ms; otherwise finalizes immediately so the UI never hangs
// in "Stopping…" when the worker is already idle or receives a second stop click.
agyw_handle_stop :: (s: [] AgywState, x: [] CuEngine, emit: bool) -> bool {
  if s[0].pending_permit {
    s[0].pending_permit = false;
    cu_decline(x[0].c);
    if x[0].live { _ = cu_flush(x[0].c, x[0].p); }
  }
  if !s[0].turn_active {
    agyw_finish_turn(s, "stopped", "", emit);
    return false;
  }
  if s[0].stopping {
    if x[0].live { cue_close(x); agyw_lease_release(s); }
    agyw_finish_turn(s, "stopped", "Stopped.", emit);
    return false;
  }
  s[0].stopping = true;
  if x[0].live {
    was_held_only := cue_held_bg(x) && !cue_prompting(x);
    cue_stop(x);
    if was_held_only {
      if !s[0].sink { _ = cu_flush(x[0].c, x[0].p); }
      agyw_finish_turn(s, "stopped", "Stopped.", emit);
      return false;
    }
    return true;
  }
  agyw_finish_turn(s, "stopped", "Stopped.", emit);
  return false;
}

tool_main :: () -> int #export_c #effects(all) {
  sb: [1] AgywState; s := sb[..];
  agyw_load_env(s);

  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess;
  cu_line: [65536] u8; cu_arena: [65536] u8; cu_out: [65536] u8;
  cue_attach(x, cb[..], pb[..], cu_line[..], cu_arena[..], cu_out[..]);
  if agyw_probe_asked() { return agyw_probe(s, x); }
  if agyw_probe_json_asked() { return agyw_probe_json(s, x); }
  if agyw_logout_asked() { return agyw_logout(s, x); }
  if agyw_connect_asked() { return agyw_connect(s, x); }

  in_buf: [AGYW_LINE] u8; in_len: [1] int;
  req_ar_buf: [131072] u8; req_ar: [1] ClArena; req_ar[0].buf = req_ar_buf[..];

  agyw_emit_ready(s);

  while true {
    // 1. Poll stdin for owner requests (short timeout when engine is live).
    wait_ms := ifx x[0].live || s[0].turn_active then 10 else 50;
    rn := agyw_read_line(in_buf[..], in_len[..], wait_ms);
    if rn == -1 {
      if x[0].live { cue_stop(x); cue_close(x); }
      agyw_lease_release(s);
      break;
    }
    if rn > 0 {
      line := cast(string) in_buf[0..<rn];
      req_ar[0].at = 0; req_ar[0].full = false;
      req: [1] MwwRequest;
      rk := mww_request(req_ar[..], line, req[..]);
      if rk == MWW_RECALL {
        s[0].recall_n = agyw_copy(s[0].recall[..], req[0].recall);
        s[0].has_recall = s[0].recall_n > 0;
        if x[0].live && x[0].ready { cue_fresh_session(x); }
      } else if rk == MWW_ANSWER {
        _ = agyw_handle_answer(s, x, req[0]);
      } else if rk == MWW_STOP || rk == MWW_INTERRUPT {
        if agyw_handle_stop(s, x, true) {
          s[0].stop_deadline_ms = cxproc_now_ms() + 3000;
        }
      } else if rk == MWW_STEER {
        if agyw_is_compact(req[0].text) && (!x[0].live || !cu_can_compact(x[0].c)) {
          agyw_emit_steered(s, req[0].id, "refused", "compact_unavailable", req[0].text);
        } else if x[0].live {
          _ = cue_steer(x, req[0].text);
          agyw_emit_steered(s, req[0].id, "applied", "", req[0].text);
        } else {
          agyw_emit_steered(s, req[0].id, "refused", "not_running", req[0].text);
        }
      } else if rk == MWW_TASK {
        if req[0].task.count > 0 {
          // the turn's start, as mcworker says it (source message: the owner's task line)
          s[0].turn += 1; agyw_write_line(s, mww_turn(s[0].out[..], s[0].turn, "message", "", ""));
          s[0].turn_active = true;
          s[0].stopping = false;
          s[0].stop_deadline_ms = 0;
          s[0].respawned = false;
          s[0].retried_sig = false;
          s[0].reply_n = 0;
          s[0].reply_break = false;
          s[0].denied_n = 0; s[0].denied_id_n = 0;
          s[0].compact = agyw_is_compact(req[0].task);
          agyw_calls_clear(s);
  agyw_subs_clear(s);

          mod := agyw_resolve_model(req[0].model, agyw_str(s[0].cfg.model[..], s[0].cfg.model_n));
          eff := agyw_resolve_effort(req[0].effort, agyw_str(s[0].cfg.effort[..], s[0].cfg.effort_n));
          s[0].turn_model_n = agyw_copy(s[0].turn_model[..], mod);
          s[0].turn_effort_n = agyw_copy(s[0].turn_effort[..], eff);

          // Check /compact support before sending.
          if agyw_is_compact(req[0].task) && x[0].live && x[0].ready && !cu_can_compact(x[0].c) {
            agyw_finish_turn(s, "failed", "Antigravity did not advertise /compact for this session.", true);
          } else {
            cwd := ifx req[0].cwd.count > 0 then req[0].cwd else ".";
            cwd_changed := s[0].cwd_n > 0 && agyw_str(s[0].cwd[..], s[0].cwd_n) != cwd;
            s[0].cwd_n = agyw_copy(s[0].cwd[..], cwd);
            if cwd_changed && x[0].live { cue_close(x); agyw_lease_release(s); }

            prompt_buf: [CUE_OWED] u8;
            prompt := req[0].task;
            if s[0].has_recall {
              prompt = agyw_compose_prompt(agyw_str(s[0].recall[..], s[0].recall_n), req[0].task, prompt_buf[..]);
              s[0].has_recall = false;
              s[0].recall_n = 0;
            }
            // a new session's first prompt carries the user instructions, read again for each session
            ui_buf: [CUE_OWED] u8; uib: [UINSTR_BLOCK_BYTES] u8; uipb: [FS_PATH_MAX] u8; uitb: [UINSTR_MAX_BYTES + 1] u8;
            if !x[0].live && !agyw_is_compact(req[0].task) {
              prompt = agyw_with_instructions(uinstr_block("", uinstr_read(uinstr_path(uipb[..]), uitb[..]), uib[..]), prompt, ui_buf[..]);
            }
            s[0].last_prompt_n = agyw_copy(s[0].last_prompt[..], prompt);

            if agyw_is_logout(req[0].task) {
              if x[0].live { _ = cu_logout(x[0].c); _ = cu_flush(x[0].c, x[0].p); proc_sleep(300); agy_signout_drain(x); agyw_lease_release(s); }
              agyw_finish_turn(s, "finished", "Signed out of Antigravity.", true);
            } else if !x[0].live {
              agyw_apply_mcp(s, x[0].c);
              why := agyw_launch_engine(s, x, cwd);
              if why.count > 0 {
                agyw_finish_turn(s, "failed", why, true);
              } else {
                agyw_lease_acquire(s, x[0].p[0].pid);
                _ = cue_send(x, prompt);
              }
            } else {
              // Apply mid-chat model or thinking-level switch on an already-live session before sending prompt.
              if !s[0].compact {
                mode := agyw_str(s[0].cfg.mode[..], s[0].cfg.mode_n);
                _ = agyw_reconfigure(s, x, mod, eff, mode, true);
              }
              _ = cue_send(x, prompt);
            }
          }
        }
      }
    }

    // 2. Poll the ACP engine and watchdog (paused while awaiting an interactive permit/question answer).
    // Must also break immediately inside the batch loop when pending_permit is raised so the next
    // cue_poll -> cu_settle does not auto-decline the open permission request before the UI answers.
    if x[0].live && !s[0].pending_permit {
      for step: 0..<64 {
        ev: [1] CuEvent;
        cue_poll(x, ev[..]);
        if ev[0].kind == CuEventKind.idle { break; }
        agyw_handle_event(s, x, ev[0], true);
        if !x[0].live || s[0].pending_permit { break; }
      }
      if x[0].live && s[0].turn_active && !s[0].pending_permit {
        now := cxproc_now_ms();
        if s[0].stopping && s[0].stop_deadline_ms > 0 && now >= s[0].stop_deadline_ms {
          cue_close(x);
          agyw_lease_release(s);
          agyw_finish_turn(s, "stopped", "Stopped.", true);
        } else {
          if now - s[0].last_sub_poll >= 250 {
            s[0].last_sub_poll = now;
            agyw_poll_subagents(s, x, true);
          }
          w := cue_watch(x, now);
          if w == CUE_WATCH_BG_DONE {
            agyw_turn_end(s, x[0].c[0].ar[..], "", true);
          } else if w == CUE_WATCH_ENDED {
            agyw_finish_turn(s, "failed", "Antigravity stopped responding and was closed.", true);
          }
        }
      }
    }
  }
  return 0;
}

// ---------------------------------------------------------------- checks

#test "agyworker: env resolution for mode, effort, model, and /compact" {
  #assert agyw_resolve_mode("") == "auto";
  #assert agyw_resolve_mode("auto") == "auto";
  #assert agyw_resolve_mode("default") == "default";
  #assert agyw_resolve_mode("plan") == "plan";
  #assert agyw_resolve_mode("bogus") == "auto";

  #assert agyw_resolve_effort("high", "low") == "high";
  #assert agyw_resolve_effort("xhigh", "medium") == "xhigh";
  #assert agyw_resolve_effort("", "medium") == "medium";
  #assert agyw_resolve_effort("", "") == "";
  #assert agyw_resolve_effort("invalid", "low") == "";

  #assert agyw_resolve_model("gemini-4-hydrogen", "gemini-4-carbon") == "gemini-4-hydrogen";
  #assert agyw_resolve_model("agy:gemini-4-neon", "gemini-4-carbon") == "gemini-4-neon";
  #assert agyw_resolve_model("agy:", "gemini-4-carbon") == "gemini-4-carbon";
  #assert agyw_resolve_model("antigravity", "gemini-4-carbon") == "gemini-4-carbon";
  #assert agyw_resolve_model("agy", "") == "";

  #assert agyw_is_compact("/compact");
  #assert agyw_is_compact("  /compact now ");
  #assert !agyw_is_compact("/compactify") && !agyw_is_compact("please compact");
}

#test "agyworker: permissions deny outside workspace and deny writes in plan mode" {
  cb: [1] CuClient; line: [4096] u8; arena: [8192] u8; out: [4096] u8;
  cu_init(cb[..], line[..], arena[..], out[..]);
  p_write := "{\"toolCall\":{\"kind\":\"edit\",\"rawInput\":{\"TargetFile\":\"a.coax\"}}}";
  p_read := "{\"toolCall\":{\"kind\":\"read\",\"rawInput\":{\"Path\":\"a.coax\"}}}";
  p_out := "{\"toolCall\":{\"kind\":\"read\",\"rawInput\":{\"Path\":\"../secret\"}}}";
  #assert agyw_decide_permission(cb[..], p_write, "auto") == CU_DISP_ALLOW;
  #assert agyw_decide_permission(cb[..], p_write, "plan") == CU_DISP_DENY;
  #assert agyw_decide_permission(cb[..], p_read, "plan") == CU_DISP_ALLOW;
  #assert agyw_decide_permission(cb[..], p_out, "auto") == CU_DISP_DENY;
}

#test "agyworker: tool calls track lifecycle and reply chunks accumulate" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [4096] u8; arena: [8192] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  s[0].turn_active = true;

  u_start := "{\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"t1\",\"status\":\"in_progress\",\"title\":\"Read file\",\"rawInput\":{\"Path\":\"a.coax\"}}}";
  agyw_handle_update(s, x, u_start, false);
  #assert agyw_call_find(s, "t1") >= 0 && s[0].next_ticket == 1;

  u_end := "{\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"t1\",\"status\":\"completed\",\"content\":[{\"type\":\"content\",\"content\":{\"type\":\"text\",\"text\":\"ok\"}}]}}";
  agyw_handle_update(s, x, u_end, false);
  #assert agyw_call_find(s, "t1") < 0;

  u_msg := "{\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"Hello from agy\"}}}";
  agyw_handle_update(s, x, u_msg, false);
  #assert agyw_str(s[0].reply[..], s[0].reply_n) == "Hello from agy";
}

#test "agyworker: interim prose before tools starts a fresh final reply instead of concatenating" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [4096] u8; arena: [8192] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  s[0].turn_active = true;

  agyw_handle_update(s, x, "{\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"Checking \"}}}", false);
  agyw_handle_update(s, x, "{\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"files.\"}}}", false);
  #assert agyw_str(s[0].reply[..], s[0].reply_n) == "Checking files.";

  agyw_handle_update(s, x, "{\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"t1\",\"status\":\"in_progress\",\"title\":\"Read file\"}}", false);
  agyw_handle_update(s, x, "{\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"t1\",\"status\":\"completed\"}}", false);
  // If no post-tool text arrives, interim prose is still preserved so turn_end won't report empty reply.
  #assert agyw_str(s[0].reply[..], s[0].reply_n) == "Checking files." && s[0].reply_break;

  // Once post-tool text arrives, reply starts fresh instead of gluing "Checking files.All done.".
  agyw_handle_update(s, x, "{\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"All \"}}}", false);
  agyw_handle_update(s, x, "{\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"done.\"}}}", false);
  #assert agyw_str(s[0].reply[..], s[0].reply_n) == "All done." && !s[0].reply_break;
}

#test "agyworker: a new session's first prompt carries the user instructions" {
  ob: [512] u8; bb: [UINSTR_BLOCK_BYTES] u8;
  block := uinstr_block("", "Commit and push.", bb[..]);
  p := agyw_with_instructions(block, "fix the bug", ob[..]);
  #assert uinstr_find(p, UINSTR_HEADER) == 0 && uinstr_find(p, "Commit and push.\n\nThe person's message:\nfix the bug") > 0;
  #assert agyw_with_instructions("", "fix the bug", ob[..]) == "fix the bug";
  #assert agyw_with_instructions(block, "fix the bug", ob[0..<20]) == "fix the bug";   // doesn't fit: the prompt alone
}

#test "agyworker: rollback recall composes context into next prompt" {
  ob: [1024] u8;
  p := agyw_compose_prompt("user: hi\nassistant: hello", "try again", ob[..]);
  #assert agy_has(p, "Previous conversation context") && agy_has(p, "user: hi") && agy_has(p, "try again");
  p2 := agyw_compose_prompt("", "plain", ob[..]);
  #assert p2 == "plain";
}

#test "agyworker: lost thinking signature triggers fresh session retry once" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [4096] u8; arena: [8192] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  x[0].live = true; x[0].ready = true; s[0].turn_active = true;
  s[0].last_prompt_n = agyw_copy(s[0].last_prompt[..], "retry me");
  ev := CuEvent.{kind = CuEventKind.refused, of = CU_SESSION_PROMPT, message = "invalid signature in thinking block"};
  agyw_handle_event(s, x, ev, false);
  #assert s[0].retried_sig && s[0].turn_active && !x[0].ready;
  // A second failure ends the turn.
  agyw_handle_event(s, x, ev, false);
  #assert !s[0].turn_active;
}

#test "agyworker: an opened session names the model it runs on, not 'default'" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [4096] u8; arena: [16384] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  ev := CuEvent.{kind = CuEventKind.answered, of = CU_SESSION_NEW, result = AGY_OPENED_DEFAULT};
  agyw_handle_event(s, x, ev, false);
  // nothing named: agy's default model at the chat's level (AGYW_EFFORT, medium)
  #assert agyw_str(s[0].ran[..], s[0].ran_n) == "gemini-4-carbon-medium" && agyw_str(s[0].ran_name[..], s[0].ran_name_n) == "Gemini 4 Carbon (Medium)";
  // an effort set in Settings (CODER_AGY_EFFORT) wins over it
  s[0].turn_effort_n = agyw_copy(s[0].turn_effort[..], "low");
  agyw_handle_event(s, x, ev, false);
  #assert agyw_str(s[0].ran[..], s[0].ran_n) == "gemini-4-carbon-low" && agyw_str(s[0].ran_name[..], s[0].ran_name_n) == "Gemini 4 Carbon (Low)";
  s[0].turn_effort_n = 0;
  // a model set in Settings is the one named
  s[0].turn_model_n = agyw_copy(s[0].turn_model[..], "gemini-4-argon-high");
  agyw_handle_event(s, x, ev, false);
  #assert agyw_str(s[0].ran[..], s[0].ran_n) == "gemini-4-argon-high" && agyw_str(s[0].ran_name[..], s[0].ran_name_n) == "Gemini 4 Argon (High)";
  // what the owner reads: an attempt line with that model
  o: [1024] u8; none := [7] int.[-1, -1, -1, -1, -1, -1, -1];
  n := mww_attempt(o[..], "antigravity", "gemini-4-carbon-low", "", "configured", 0, none[..]);
  ab: [4096] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}]; l: [1] MwwLine;
  #assert mww_read(ar[..], cast(string) o[0..<n], l[..]) == MWW_ATTEMPT && l[0].model == "gemini-4-carbon-low" && l[0].gateway == "antigravity";
}

// agy 1.5.13's own lines, captured 2026-11-20 through a tee around `agy acp` while agyworker ran
// "read a.txt, then ../outside.txt" (the workspace's path shortened to /w, the session id kept).
// agy names absolute paths, reports no file contents for read_file, asks before a read outside
// the workspace, and answers session/prompt end_turn with usage and no words once it is denied.
AGYW_FX_READ :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"d374a3b5-6498-4a4a-821a-ae285564bcec\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"call_15035010722467532092\",\"name\":\"read_file\",\"args\":{\"Path\":\"/w/ws/a.txt\"},\"status\":\"in_progress\",\"kind\":\"read\",\"title\":\"File a.txt\",\"locations\":[{\"path\":\"/w/ws/a.txt\"}],\"rawInput\":{\"Path\":\"/w/ws/a.txt\"}}}}";
AGYW_FX_READ_DONE :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"d374a3b5-6498-4a4a-821a-ae285564bcec\",\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"call_15035010722467532092\",\"name\":\"read_file\",\"args\":{\"Path\":\"/w/ws/a.txt\"},\"status\":\"completed\",\"kind\":\"read\",\"title\":\"File a.txt\",\"locations\":[{\"path\":\"/w/ws/a.txt\"}],\"rawInput\":{\"Path\":\"/w/ws/a.txt\"}}}}";
AGYW_FX_OUT :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"d374a3b5-6498-4a4a-821a-ae285564bcec\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"call_15035010722467529939\",\"name\":\"read_file\",\"args\":{\"Path\":\"/w/outside.txt\"},\"status\":\"in_progress\",\"kind\":\"read\",\"title\":\"File ../outside.txt\",\"locations\":[{\"path\":\"/w/outside.txt\"}],\"rawInput\":{\"Path\":\"/w/outside.txt\"}}}}";
AGYW_FX_OUT_PENDING :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"d374a3b5-6498-4a4a-821a-ae285564bcec\",\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"call_15035010722467529939\",\"name\":\"read_file\",\"args\":{\"Path\":\"/w/outside.txt\"},\"status\":\"pending\",\"kind\":\"read\",\"title\":\"File ../outside.txt\",\"locations\":[{\"path\":\"/w/outside.txt\"}],\"rawInput\":{\"Path\":\"/w/outside.txt\"}}}}";
AGYW_FX_OUT_ASKS :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/request_permission\",\"params\":{\"sessionId\":\"d374a3b5-6498-4a4a-821a-ae285564bcec\",\"toolCall\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"call_15035010722467529939\",\"name\":\"read_file\",\"args\":{\"Path\":\"/w/outside.txt\"},\"status\":\"pending\",\"kind\":\"read\",\"title\":\"File ../outside.txt\",\"locations\":[{\"path\":\"/w/outside.txt\"}],\"rawInput\":{\"Path\":\"/w/outside.txt\"}},\"options\":[{\"optionId\":\"allow\",\"name\":\"Allow\",\"kind\":\"allow_once\"},{\"optionId\":\"deny\",\"name\":\"Deny\",\"kind\":\"reject_once\"}]},\"id\":\"1\"}";
AGYW_FX_OUT_FAILED :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"d374a3b5-6498-4a4a-821a-ae285564bcec\",\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"call_15035010722467529939\",\"name\":\"read_file\",\"args\":{\"Path\":\"/w/outside.txt\"},\"status\":\"failed\",\"kind\":\"read\",\"title\":\"File ../outside.txt\",\"locations\":[{\"path\":\"/w/outside.txt\"}],\"rawInput\":{\"Path\":\"/w/outside.txt\"}}}}";
AGYW_FX_ENDED :: "{\"jsonrpc\":\"2.0\",\"result\":{\"stopReason\":\"end_turn\",\"usage\":{\"inputTokens\":10095,\"outputTokens\":344,\"cachedReadTokens\":0,\"cachedWriteTokens\":0,\"thoughtTokens\":0,\"totalTokens\":10439}},\"id\":3}";

// A worker whose session is open and whose turn was sent (session/prompt is request 3).
agyw_fx_turn :: (s: [] AgywState, x: [] CuEngine) {
  s[0].sink = true; s[0].turn_active = true;
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  ev = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"sessionId\":\"d374a3b5-6498-4a4a-821a-ae285564bcec\"}}");
  #assert cue_send(x, "read a.txt, then ../outside.txt");
}
agyw_fx_feed :: (s: [] AgywState, x: [] CuEngine, line: string) { agyw_handle_event(s, x, cue_feed(x, line), true); }
agyw_logged :: (s: [] AgywState, part: string) -> bool { return agy_has(agyw_str(s[0].log[..], s[0].log_n), part); }

#test "agyworker: agy's permission request is answered allow, and the read finishes with agy's words" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [8192] u8; arena: [16384] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  agyw_fx_turn(s, x);
  agyw_fx_feed(s, x, AGYW_FX_READ);
  agyw_fx_feed(s, x, AGYW_FX_READ_DONE);
  #assert agyw_logged(s, "{\"kind\":\"command\",\"command\":\"File a.txt\",\"exit\":0");
  agyw_fx_feed(s, x, AGYW_FX_OUT);
  agyw_fx_feed(s, x, AGYW_FX_OUT_PENDING);
  agyw_fx_feed(s, x, AGYW_FX_OUT_ASKS);
  // Answered here, in the same poll: allow (a request left open is declined on the next poll).
  #assert agy_out_has(x, "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":{\"outcome\":{\"outcome\":\"selected\",\"optionId\":\"allow\"}}}");
  #assert s[0].denied_n == 0 && cb[0].asking == 0;
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"d374a3b5-6498-4a4a-821a-ae285564bcec\",\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"hello outside\"}}}}");
  agyw_fx_feed(s, x, AGYW_FX_ENDED);
  #assert !s[0].turn_active && agyw_logged(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"hello outside\"}");
}

#test "agyworker: a denied tool call fails the turn agy then cancels, saying why" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [8192] u8; arena: [16384] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  agyw_fx_turn(s, x);
  // The captured request, naming the path with ".." as a tool may: OpenAgents denies it.
  asks := "{\"jsonrpc\":\"2.0\",\"method\":\"session/request_permission\",\"params\":{\"sessionId\":\"d374a3b5-6498-4a4a-821a-ae285564bcec\",\"toolCall\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"call_15035010722467529939\",\"name\":\"read_file\",\"status\":\"pending\",\"kind\":\"read\",\"title\":\"File ../outside.txt\",\"rawInput\":{\"Path\":\"/w/ws/../outside.txt\"}},\"options\":[{\"optionId\":\"allow\",\"name\":\"Allow\",\"kind\":\"allow_once\"},{\"optionId\":\"deny\",\"name\":\"Deny\",\"kind\":\"reject_once\"}]},\"id\":\"1\"}";
  agyw_fx_feed(s, x, AGYW_FX_OUT);
  agyw_fx_feed(s, x, asks);
  #assert agy_out_has(x, "\"optionId\":\"deny\"") && s[0].denied_n > 0;
  agyw_fx_feed(s, x, AGYW_FX_OUT_FAILED);
  #assert agyw_logged(s, "{\"kind\":\"command\",\"command\":\"File ../outside.txt\",\"exit\":1,\"timed_out\":false,\"output\":\"OpenAgents denied File ../outside.txt: it names a path outside the workspace.\"}");
  agyw_fx_feed(s, x, AGYW_FX_ENDED);
  #assert !s[0].turn_active && agyw_logged(s, "{\"kind\":\"ended\",\"ending\":\"failed\",\"text\":\"OpenAgents denied File ../outside.txt: it names a path outside the workspace. Antigravity ends its turn when a tool call is denied.\"}");
  #assert !agyw_logged(s, "\"ending\":\"finished\"") && s[0].denied_n == 0;
}

#test "agyworker: a turn agy ends with no words fails saying so, never a silent empty reply" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [8192] u8; arena: [16384] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  agyw_fx_turn(s, x);
  agyw_fx_feed(s, x, AGYW_FX_READ);
  agyw_fx_feed(s, x, AGYW_FX_READ_DONE);
  agyw_fx_feed(s, x, AGYW_FX_ENDED);
  #assert agyw_logged(s, "{\"kind\":\"ended\",\"ending\":\"failed\",\"text\":\"Antigravity ended the turn without a reply.\"}");
  #assert agyw_no_reply("max_tokens") != agyw_no_reply("end_turn") && agyw_no_reply("cancelled") != agyw_no_reply("");
  // A tool call that failed or was cancelled with nothing to show says so.
  s[0].denied_n = 0;
  #assert agyw_no_output(s, "t", "cancelled") == "Cancelled." && agyw_no_output(s, "t", "failed").count > 0;
  // A command agy calls completed with a non-zero exit code (captured from agy 1.5.13, trimmed).
  ran := "{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"call_5502546541690535549\",\"name\":\"run_command\",\"status\":\"completed\",\"kind\":\"execute\",\"title\":\"git log -n 2 --stat\",\"rawOutput\":{\"output\":\"Command exited with code 128.\",\"exit_code\":128}}";
  #assert agyw_exit_code(ran, "completed") == 128 && agyw_exit_code(ran, "failed") == 1;
  #assert agyw_exit_code("{\"status\":\"completed\"}", "completed") == 0;
  // A /compact may end with no words.
  s[0].log_n = 0; agyw_fx_turn(s, x); s[0].compact = true;
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"result\":{\"stopReason\":\"end_turn\"},\"id\":4}");
  agyw_handle_event(s, x, ev, true);
  #assert agyw_logged(s, "\"ending\":\"finished\"");
}

// agy 1.5.13's own lines, captured 2026-11-20 through a tee around `agy acp` while agyworker ran an
// LRU-cache task (the workspace's path shortened to /w, a written file's text cut). At medium agy
// streams the model's thinking as agent_thought_chunk, a bold title and a paragraph each, and
// reports it as thoughtTokens; at low, on Carbon, it sends tool calls and words but no thought
// chunk at all, and reports thoughtTokens 0. No other update kind carries thinking.
AGYW_FX_SESSION_NEW :: "{\"jsonrpc\":\"2.0\",\"result\":{\"sessionId\":\"63a19ef3-e900-4141-912a-4f727455dd5b\",\"models\":{\"availableModels\":[{\"modelId\":\"gemini-4-carbon-medium\",\"name\":\"Gemini 4 Carbon (Medium)\"},{\"modelId\":\"gemini-4-carbon-high\",\"name\":\"Gemini 4 Carbon (High)\"},{\"modelId\":\"gemini-4-carbon-low\",\"name\":\"Gemini 4 Carbon (Low)\"}],\"currentModelId\":\"gemini-4-carbon-medium\"},\"configOptions\":[{\"id\":\"model\",\"name\":\"Model\",\"category\":\"model\",\"type\":\"select\",\"currentValue\":\"gemini-4-carbon\",\"options\":[{\"value\":\"gemini-4-carbon\",\"name\":\"Gemini 4 Carbon\"}]},{\"id\":\"thought_level\",\"name\":\"Thinking Level\",\"category\":\"thought_level\",\"type\":\"select\",\"currentValue\":\"medium\",\"options\":[{\"value\":\"low\",\"name\":\"Low\"},{\"value\":\"medium\",\"name\":\"Medium\"},{\"value\":\"high\",\"name\":\"High\"}]}]},\"id\":2}";
AGYW_FX_THOUGHT :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"63a19ef3-e900-4141-912a-4f727455dd5b\",\"update\":{\"sessionUpdate\":\"agent_thought_chunk\",\"content\":{\"type\":\"text\",\"text\":\"**Drafting LRUCache Implementation**\\n\\nI'm focusing on implementing the `LRUCache` class within `lru.py`, ensuring it correctly handles `get` and `put` operations, including the crucial least-recently-used eviction logic based on capacity. Testing will follow closely.\\n\\n\"}}}}";
AGYW_FX_ENDED_MEDIUM :: "{\"jsonrpc\":\"2.0\",\"result\":{\"stopReason\":\"end_turn\",\"usage\":{\"inputTokens\":20482,\"outputTokens\":4146,\"cachedReadTokens\":39899,\"cachedWriteTokens\":0,\"thoughtTokens\":1587,\"totalTokens\":64527}},\"id\":4}";
AGYW_FX_LOW_WRITE :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"fa0f9160-ca80-4307-8513-393054de5060\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"call_13351050124385443137\",\"name\":\"write_file\",\"args\":{\"Content\":\"from collections import OrderedDict\\n\",\"TargetFile\":\"/w/lru.py\",\"toolSummary\":\"Create lru.py with LRUCache\"},\"status\":\"in_progress\",\"kind\":\"edit\",\"title\":\"File lru.py\",\"locations\":[{\"path\":\"/w/lru.py\"}]}}}";
AGYW_FX_LOW_WRITE_DONE :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"fa0f9160-ca80-4307-8513-393054de5060\",\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"call_13351050124385443137\",\"name\":\"write_file\",\"status\":\"completed\",\"kind\":\"edit\",\"title\":\"File lru.py\",\"locations\":[{\"path\":\"/w/lru.py\"}]}}}";
AGYW_FX_LOW_WORDS :: "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"fa0f9160-ca80-4307-8513-393054de5060\",\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"Created lru.py.\"}}}}";
AGYW_FX_ENDED_LOW :: "{\"jsonrpc\":\"2.0\",\"result\":{\"stopReason\":\"end_turn\",\"usage\":{\"inputTokens\":15896,\"outputTokens\":1793,\"cachedReadTokens\":18171,\"cachedWriteTokens\":0,\"thoughtTokens\":0,\"totalTokens\":35860}},\"id\":3}";

#test "agyworker: a new chat session thinks at medium, and agy's thought chunks become thought lines" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [8192] u8; arena: [16384] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  s[0].sink = true; s[0].turn_active = true;
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  cu_outbox_clear(x[0].c);
  // the captured session/new: no model or effort named, so the chat's medium; agy's default model
  agyw_fx_feed(s, x, AGYW_FX_SESSION_NEW);
  #assert agy_out_has(x, "\"configId\":\"thought_level\",\"value\":\"medium\"") && !agy_out_has(x, "\"value\":\"low\"");
  #assert agyw_logged(s, "\"gateway\":\"antigravity\",\"model\":\"gemini-4-carbon-medium\"");
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"result\":{},\"id\":3}");   // the thought level, answered
  #assert cue_send(x, "Create lru.py ...");
  agyw_fx_feed(s, x, AGYW_FX_THOUGHT);
  #assert agyw_logged(s, "{\"kind\":\"thought\",\"text\":\"**Drafting LRUCache Implementation**\\n\\nI'm focusing on implementing the `LRUCache` class");
  agyw_fx_feed(s, x, AGYW_FX_LOW_WORDS);
  agyw_fx_feed(s, x, AGYW_FX_ENDED_MEDIUM);
  #assert !s[0].turn_active && agyw_logged(s, "\"ending\":\"finished\"");
}

#test "agyworker: a low-effort turn on Carbon, as agy sent it, has its tool call and reply and no thought" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [8192] u8; arena: [16384] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  agyw_fx_turn(s, x);
  agyw_fx_feed(s, x, AGYW_FX_LOW_WRITE);
  agyw_fx_feed(s, x, AGYW_FX_LOW_WRITE_DONE);
  agyw_fx_feed(s, x, AGYW_FX_LOW_WORDS);
  agyw_fx_feed(s, x, AGYW_FX_ENDED_LOW);
  #assert agyw_logged(s, "{\"kind\":\"ask\",\"command\":\"File lru.py\"") && agyw_logged(s, "{\"kind\":\"command\",\"command\":\"File lru.py\",\"exit\":0");
  #assert agyw_logged(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Created lru.py.\"}") && !agyw_logged(s, "\"kind\":\"thought\"");
  // the same turn at medium: its thought, then the same end
  s[0].log_n = 0; agyw_fx_turn(s, x);
  agyw_fx_feed(s, x, AGYW_FX_THOUGHT);
  agyw_fx_feed(s, x, AGYW_FX_LOW_WORDS);
  agyw_fx_feed(s, x, AGYW_FX_ENDED_MEDIUM);
  #assert agyw_logged(s, "\"kind\":\"thought\"") && agyw_logged(s, "\"ending\":\"finished\"");
}

#test "agyworker: auto mode auto-approves git push & tools immediately while default mode and interaction_ questions wait for MWW_ANSWER" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [8192] u8; arena: [16384] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  s[0].sink = true; s[0].turn_active = true;
  s[0].cfg.interactive = true;
  s[0].cfg.mode_n = agyw_copy(s[0].cfg.mode[..], "auto");
  // Simulate session/new advertising auto mode and currentModeId auto.
  _ = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  _ = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"sessionId\":\"g-1\",\"modes\":{\"currentModeId\":\"auto\",\"availableModes\":[{\"id\":\"default\"},{\"id\":\"auto\"}]}}}");
  cu_outbox_clear(x[0].c);

  // 1. In auto mode, escalated tool/command permission (e.g. git push) auto-approves immediately with NO prompt.
  perm_push := "{\"jsonrpc\":\"2.0\",\"id\":50,\"method\":\"session/request_permission\",\"params\":{\"toolCall\":{\"toolCallId\":\"tc-1\",\"title\":\"git push\",\"kind\":\"execute\",\"rawInput\":{\"CommandLine\":\"git push\"}},\"options\":[{\"optionId\":\"allow\",\"name\":\"Allow\",\"kind\":\"allow_once\"},{\"optionId\":\"deny\",\"name\":\"Deny\",\"kind\":\"reject_once\"}]}}";
  agyw_fx_feed(s, x, perm_push);
  #assert !s[0].pending_permit && x[0].c[0].asking == 0;
  #assert !agyw_logged(s, "\"kind\":\"permit\"");
  #assert agy_out_has(x, "\"outcome\":\"selected\",\"optionId\":\"allow\"");

  // 2. Native Antigravity question (toolCallId starts with interaction_) still prompts and sends chosen optionId.
  cu_outbox_clear(x[0].c); s[0].log_n = 0;
  ar_buf: [2048] u8; ar := [1] ClArena.[ClArena.{buf = ar_buf[..]}];
  req: [1] MwwRequest;
  q := "{\"jsonrpc\":\"2.0\",\"id\":51,\"method\":\"session/request_permission\",\"params\":{\"toolCall\":{\"toolCallId\":\"interaction_9\",\"title\":\"Which backend?\",\"kind\":\"other\"},\"options\":[{\"optionId\":\"opt_1\",\"name\":\"Metal\"},{\"optionId\":\"opt_2\",\"name\":\"Vulkan\"}]}}";
  agyw_fx_feed(s, x, q);
  #assert s[0].pending_permit && s[0].pending_is_question && s[0].pending_ticket == 1;
  #assert agyw_logged(s, "\"kind\":\"permit\",\"ticket\":1,\"question\":true,\"title\":\"Which backend?\"");
  #assert mww_request(ar[..], "{\"answer\":true,\"ticket\":1,\"option\":\"opt_2\"}", req[..]) == MWW_ANSWER;
  #assert agyw_handle_answer(s, x, req[0]) && !s[0].pending_permit;
  #assert agy_out_has(x, "\"outcome\":\"selected\",\"optionId\":\"opt_2\"");

  // 3. In supervised "default" mode, permissions wait for MWW_ANSWER, ignore stale tickets, and map allow_session -> allow_always.
  s[0].cfg.mode_n = agyw_copy(s[0].cfg.mode[..], "default");
  cu_outbox_clear(x[0].c); s[0].log_n = 0;
  perm_always := "{\"jsonrpc\":\"2.0\",\"id\":52,\"method\":\"session/request_permission\",\"params\":{\"toolCall\":{\"toolCallId\":\"tc-2\",\"title\":\"Run shell command\",\"kind\":\"execute\",\"rawInput\":{\"CommandLine\":\"git push\"}},\"options\":[{\"optionId\":\"allow_once\",\"name\":\"Allow once\",\"kind\":\"allow_once\"},{\"optionId\":\"allow_always\",\"name\":\"Allow always\",\"kind\":\"allow_always\"},{\"optionId\":\"reject_once\",\"name\":\"Deny\",\"kind\":\"reject_once\"}]}}";
  agyw_fx_feed(s, x, perm_always);
  #assert s[0].pending_permit && s[0].pending_ticket == 2 && x[0].c[0].asking != 0;
  #assert mww_request(ar[..], "{\"answer\":true,\"ticket\":99}", req[..]) == MWW_ANSWER;
  #assert !agyw_handle_answer(s, x, req[0]) && s[0].pending_permit && cu_outbox(x[0].c).count == 0;
  #assert mww_request(ar[..], "{\"answer\":true,\"ticket\":2,\"option\":\"allow_session\"}", req[..]) == MWW_ANSWER;
  #assert agyw_handle_answer(s, x, req[0]) && !s[0].pending_permit && x[0].c[0].asking == 0;
  #assert agy_out_has(x, "\"outcome\":\"selected\",\"optionId\":\"allow_always\"");

  // 4. Denying a supervised permission declines agy and records the denial reason.
  cu_outbox_clear(x[0].c); s[0].log_n = 0;
  agyw_fx_feed(s, x, perm_always);
  #assert s[0].pending_permit && s[0].pending_ticket == 3;
  #assert mww_request(ar[..], "{\"answer\":false,\"ticket\":3,\"why\":\"too risky\"}", req[..]) == MWW_ANSWER;
  #assert agyw_handle_answer(s, x, req[0]) && !s[0].pending_permit;
  #assert agy_out_has(x, "\"optionId\":\"reject_once\"") && s[0].denied_n > 0;
}

#test "agyworker: detached subagents hold turn open while running and settle when killed or completed" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [8192] u8; arena: [16384] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  s[0].sink = true; s[0].turn_active = true;
  _ = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  _ = cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"sessionId\":\"root-7\"}}");
  #assert cue_send(x, "audit tests");
  cu_outbox_clear(x[0].c);

  ab: [4096] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  subs: [2] AgrSubagent;
  subs[0] = agr_subagent_parse("{\"id\":\"c-1\",\"name\":\"researcher\",\"state\":\"SUBAGENT_STATE_RUNNING\",\"prompt\":\"Scan repo\"}", "c-1", ar[..]);
  subs[1] = agr_subagent_parse("{\"id\":\"c-2\",\"name\":\"helper\",\"state\":\"SUBAGENT_STATE_KILLED\",\"error\":\"killed by parent\"}", "c-2", ar[..]);
  #assert agyw_sync_subagents(s, x, subs[..], 2, true) == 1 && cue_bg_subagents(x) == 1;
  #assert agyw_logged(s, "\"kind\":\"ask\",\"command\":\"Subagent: researcher — Scan repo\"");
  #assert agyw_logged(s, "\"kind\":\"command\",\"command\":\"Subagent: helper\",\"exit\":1,\"timed_out\":false,\"output\":\"killed by parent\"");

  // Prompt settles while c-1 is still running -> turn stays held_bg.
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"stopReason\":\"end_turn\"}}");
  #assert s[0].turn_active && cue_held_bg(x);
  #assert cue_watch(x, 1000) == CUE_WATCH_NONE;

  // c-1 is killed -> running drops to 0 -> cue_watch releases the held turn.
  subs[0] = agr_subagent_parse("{\"id\":\"c-1\",\"name\":\"researcher\",\"state\":\"SUBAGENT_STATE_KILLED\"}", "c-1", ar[..]);
  #assert agyw_sync_subagents(s, x, subs[..], 2, true) == 0 && cue_bg_subagents(x) == 0;
  #assert cue_watch(x, 1250) == CUE_WATCH_BG_DONE && !cue_held_bg(x);
}

#test "agyworker: MCP server injection passes bearer token to ACP session without logging it" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [8192] u8; arena: [16384] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  s[0].sink = true;
  s[0].cfg.mcp_url_n = agyw_copy(s[0].cfg.mcp_url[..], "http://127.0.0.1:7777/mcp");
  s[0].cfg.mcp_token_n = agyw_copy(s[0].cfg.mcp_token[..], "super-secret-token");
  agyw_apply_mcp(s, x[0].c);
  cu_outbox_clear(x[0].c);
  _ = cu_session_new(x[0].c, "/repo");
  #assert agy_out_has(x, "\"openagents-coder\"") && agy_out_has(x, "Bearer super-secret-token");
  #assert !agyw_logged(s, "super-secret-token");
}

#test "agyworker: fs/read_text_file enforces root scoping and read-repair closes dangling read calls" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [8192] u8; arena: [16384] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  s[0].sink = true; s[0].turn_active = true;
  // Open a read tool call that agy never closes with tool_call_update.
  at := agyw_call_open(s, "tc-read-1", "Read notes.txt");
  #assert at >= 0;
  s[0].calls[at].path_n = agyw_copy(s[0].calls[at].path[..], "/repo/notes.txt");
  // Reject path outside [cwd, attach_dir]
  cu_outbox_clear(x[0].c);
  #assert !agyw_handle_fs_read(s, x[0].c, "88", "/etc/passwd", "/repo", "/tmp/attach", true);
  #assert agy_out_has(x, "\"id\":88") && agy_out_has(x, "outside allowed roots");
  // Read-repair closes the open tool call when served
  #assert agyw_read_repair_served(s, "/repo/notes.txt", true, true);
  #assert !s[0].calls[at].used && agyw_logged(s, "\"kind\":\"command\",\"command\":\"Read notes.txt\",\"exit\":0");
}

#test "agyworker: UTF-8-safe truncation never splits multi-byte codepoints and probe cleanup verifies ownership" {
  // 2-byte 'é' (C3 A9), 3-byte '中' (E4 B8 AD), 4-byte '😀' (F0 9F 98 80)
  s2 := "aé";       // 1 + 2 = 3 bytes
  b2: [2] u8;
  #assert agyw_copy(b2[..], s2) == 1 && cast(string) b2[0..<1] == "a";
  b3: [3] u8;
  #assert agyw_copy(b3[..], s2) == 3 && cast(string) b3[0..<3] == "aé";

  s3 := "x中y";      // 1 + 3 + 1 = 5 bytes
  c2: [2] u8; #assert agyw_copy(c2[..], s3) == 1 && cast(string) c2[0..<1] == "x";
  c3: [3] u8; #assert agyw_copy(c3[..], s3) == 1 && cast(string) c3[0..<1] == "x";
  c4: [4] u8; #assert agyw_copy(c4[..], s3) == 4 && cast(string) c4[0..<4] == "x中";

  s4 := "😀!";       // 4 + 1 = 5 bytes
  d3: [3] u8; #assert agyw_copy(d3[..], s4) == 0;
  d4: [4] u8; #assert agyw_copy(d4[..], s4) == 4 && cast(string) d4[0..<4] == "😀";

  // Probe temp-session ownership verification requires BOTH session_id and workspace_uri
  #assert agyw_session_db_owned("...session_id:probe-1...file:///Users/me...", "probe-1", "file:///Users/me");
  #assert !agyw_session_db_owned("...session_id:probe-1...file:///other...", "probe-1", "file:///Users/me");
  #assert !agyw_session_db_owned("...session_id:real-9...file:///Users/me...", "probe-1", "file:///Users/me");
  #assert !agyw_session_db_owned("", "probe-1", "file:///Users/me");
}

#test "agyworker: T3 model catalog extraction (configOptions flat & grouped + thoughtLevels) and SSH error translation" {
  // 1. configOptions[id="model"] wins over legacy models.availableModels, handles flat + grouped options
  sess := "{\"models\":{\"availableModels\":[{\"modelId\":\"gemini-4-carbon-low\",\"name\":\"Legacy Low\"}]},\"configOptions\":[{\"id\":\"model\",\"category\":\"model\",\"type\":\"select\",\"currentValue\":\"gemini-4-carbon\",\"options\":[{\"value\":\"gemini-4-neon\",\"name\":\"Gemini 4 Neon\"},{\"label\":\"Standard\",\"options\":[{\"value\":\"gemini-4-carbon\",\"name\":\"Gemini 4 Carbon\"},{\"value\":\"gemini-4-hydrogen\",\"name\":\"Gemini 4 Hydrogen\"}]}]},{\"id\":\"thought_level\",\"category\":\"thought_level\",\"type\":\"select\",\"currentValue\":\"medium\",\"options\":[{\"value\":\"low\",\"name\":\"Low\"},{\"value\":\"medium\",\"name\":\"Medium\"},{\"value\":\"high\",\"name\":\"High\"},{\"value\":\"xhigh\",\"name\":\"Extra\"}]}]}";
  ab: [8192] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  probed: [AGYW_MAX_PROBED] AgywProbedModel;
  cfg_id: [64] u8; cfg_n: [1] int;
  mc := agyw_collect_session_models(sess, ar[..], probed[..], cfg_id[..], cfg_n[..]);
  #assert mc == 3 && cast(string) cfg_id[0..<cfg_n[0]] == "model";
  #assert cast(string) probed[0].slug[0..<probed[0].slug_n] == "gemini-4-neon" && !probed[0].is_default;
  #assert cast(string) probed[1].slug[0..<probed[1].slug_n] == "gemini-4-carbon" && probed[1].is_default;
  #assert cast(string) probed[2].slug[0..<probed[2].slug_n] == "gemini-4-hydrogen" && cast(string) probed[2].name[0..<probed[2].name_n] == "Gemini 4 Hydrogen";

  // 2. agyw_put_thinking_json emits both thinking:true, thoughtLevels:[...] AND thinkingLevels:[...]
  ob: [2048] u8; o := [1] ClOut.[ClOut.{buf = ob[..]}];
  cl_put(o[..], "{\"slug\":\"gemini-4-neon\"");
  agyw_put_thinking_json(o[..], sess, ar[..]);
  cl_put(o[..], "}");
  out_s := cast(string) ob[0..<o[0].len];
  #assert agy_has(out_s, "\"thinking\":true");
  #assert agy_has(out_s, "\"thoughtLevels\":[\"low\",\"medium\",\"high\",\"xhigh\"]");
  #assert agy_has(out_s, "\"thinkingDefault\":\"medium\"");

  // 3. Raw SSH error on authenticate / session/new refusal NEVER leaks into chat
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [4096] u8; arena: [8192] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  s[0].sink = true; s[0].turn_active = true; x[0].live = true;
  ev := CuEvent.{kind = CuEventKind.refused, of = CU_AUTHENTICATE, message = "No browser is available here (this is a remote (SSH) session, so the browser's sign-in redirect can't reach this machine). Run 'agy acp --login'"};
  agyw_handle_event(s, x, ev, true);
  #assert !s[0].turn_active && agyw_logged(s, AGY_SIGNIN_REQUIRED) && !agyw_logged(s, "remote (SSH)");
}

#test "agyworker: mid-session effort change reconfigures thought_level and holds prompt until applied" {
  #assert agyw_resolve_effort("xhigh", "") == "xhigh";
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [8192] u8; arena: [16384] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  s[0].sink = true; s[0].turn_active = true;
  s[0].turn_effort_n = agyw_copy(s[0].turn_effort[..], "low");
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  cu_outbox_clear(x[0].c);
  agyw_fx_feed(s, x, AGYW_FX_SESSION_NEW);
  #assert agy_out_has(x, "\"configId\":\"thought_level\",\"value\":\"low\"");
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"result\":{},\"id\":3}");
  // Turn 2: unchanged effort sends no extra set_config_option.
  cu_outbox_clear(x[0].c);
  #assert !agyw_reconfigure(s, x, "", "low", "auto", true);
  #assert !agy_out_has(x, "set_config_option");
  // Turn 2: switching from low to high sends set_config_option, holds prompt until answered, then streams thoughts.
  s[0].log_n = 0;
  #assert agyw_reconfigure(s, x, "", "high", "auto", true);
  #assert agy_out_has(x, "\"configId\":\"thought_level\",\"value\":\"high\"");
  #assert agyw_logged(s, "\"model\":\"gemini-4-carbon-high\"");
  #assert !cue_send(x, "Think carefully.");
  #assert !agy_out_has(x, "session/prompt");
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"result\":{},\"id\":4}");
  #assert agy_out_has(x, "\"method\":\"session/prompt\"") && agy_out_has(x, "Think carefully.");
  // Top-level text fallback in agent_thought_chunk also emits a thought line.
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"63a19ef3-e900-4141-912a-4f727455dd5b\",\"update\":{\"sessionUpdate\":\"agent_thought_chunk\",\"text\":\"Fallback thought\"}}}");
  #assert agyw_logged(s, "{\"kind\":\"thought\",\"text\":\"Fallback thought\"}");
}

#test "agyworker: MWW_STOP acknowledges immediately when idle and force-stops on second stop" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [4096] u8; arena: [8192] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  s[0].sink = true;
  // 1. Idle worker receiving MWW_STOP immediately emits ended:stopped so UI never hangs in "Stopping…".
  s[0].turn_active = false;
  #assert !agyw_handle_stop(s, x, true);
  #assert agyw_logged(s, "\"kind\":\"ended\",\"ending\":\"stopped\"");

  // 2. Active live turn: first stop sends session/cancel and asks caller to arm deadline; second stop force-finishes.
  s[0].log_n = 0; s[0].turn_active = true; s[0].stopping = false;
  ev := cue_feed(x, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}");
  agyw_fx_feed(s, x, AGYW_FX_SESSION_NEW);
  cu_outbox_clear(x[0].c);
  #assert agyw_handle_stop(s, x, true) && s[0].stopping && s[0].turn_active;
  #assert agy_out_has(x, "\"method\":\"session/cancel\"");
  #assert !agyw_handle_stop(s, x, true) && !s[0].turn_active && !s[0].stopping && !x[0].live;
  #assert agyw_logged(s, "\"kind\":\"ended\",\"ending\":\"stopped\"");
}

#test "agyworker: background command holds turn across reactive wakeup and chained bg work, then ends once with final reply" {
  sb: [1] AgywState; s := sb[..];
  xb: [1] CuEngine; x := xb[..];
  cb: [1] CuClient; pb: [1] ClProcess; line: [8192] u8; arena: [16384] u8; out: [4096] u8;
  agy_test(x, cb[..], pb[..], line[..], arena[..], out[..]);
  agyw_fx_turn(s, x);

  // 1. Background build.sh starts, model writes interim status, session/prompt answers end_turn.
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"call_build\",\"name\":\"run_command\",\"kind\":\"execute\",\"status\":\"in_progress\",\"title\":\"apps/openagents-desktop/build.sh --minimal\",\"rawInput\":{\"CommandLine\":\"apps/openagents-desktop/build.sh --minimal\",\"WaitMsBeforeAsync\":500}}}}");
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"Building minimal — I'll push when done.\"}}}}");
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"usage_update\",\"used\":9680,\"size\":1048576}}}");
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"stopReason\":\"end_turn\"}}");
  #assert s[0].turn_active && cue_held_bg(x) && !agyw_logged(s, "\"kind\":\"ended\"");
  #assert cue_watch(x, 1000) == CUE_WATCH_NONE;

  // 2. build.sh finishes -> MUST NOT emit ended during the 7-12s reactive wakeup gap!
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"call_build\",\"name\":\"run_command\",\"kind\":\"execute\",\"status\":\"completed\",\"title\":\"apps/openagents-desktop/build.sh --minimal\",\"rawOutput\":{\"output\":\"built ok\",\"exit_code\":0}}}}");
  #assert s[0].turn_active && cue_held_bg(x) && !agyw_logged(s, "\"kind\":\"ended\"");
  #assert cue_watch(x, 1100) == CUE_WATCH_NONE && cue_watch(x, 13000) == CUE_WATCH_NONE;

  // 3. Reactive wakeup thinks, emits intermediate usage_update 4ms before chained bg git push.
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"agent_thought_chunk\",\"content\":{\"type\":\"text\",\"text\":\"Build passed, pushing now.\"}}}}");
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"usage_update\",\"used\":10100,\"size\":1048576}}}");
  #assert cue_watch(x, 13002) == CUE_WATCH_NONE;
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"call_push\",\"name\":\"run_command\",\"kind\":\"execute\",\"status\":\"in_progress\",\"title\":\"git push origin HEAD:main\",\"rawInput\":{\"CommandLine\":\"git push origin HEAD:main\"}}}}");
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"Waiting for pre-push checks.\"}}}}");
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"usage_update\",\"used\":10300,\"size\":1048576}}}");
  // usage_update while call_push is running must NOT end the turn.
  #assert cue_watch(x, 15000) == CUE_WATCH_NONE && cue_watch(x, 20000) == CUE_WATCH_NONE && cue_held_bg(x);

  // 4. git push completes, model writes real final reply + final usage_update -> settles after CUE_BG_USAGE_SETTLE_MS.
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"call_push\",\"name\":\"run_command\",\"kind\":\"execute\",\"status\":\"completed\",\"title\":\"git push origin HEAD:main\",\"rawOutput\":{\"output\":\"pushed\",\"exit_code\":0}}}}");
  #assert cue_watch(x, 25000) == CUE_WATCH_NONE;
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"Fixed and pushed to main.\"}}}}");
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"usage_update\",\"used\":10600,\"size\":1048576}}}");
  #assert cue_watch(x, 30000) == CUE_WATCH_NONE && !agyw_logged(s, "\"kind\":\"ended\"");
  #assert cue_watch(x, 30000 + CUE_BG_USAGE_SETTLE_MS) == CUE_WATCH_BG_DONE && !cue_held_bg(x);
  agyw_turn_end(s, x[0].c[0].ar[..], "", true);
  #assert !s[0].turn_active;
  #assert agyw_logged(s, "\"kind\":\"thought\",\"text\":\"Build passed, pushing now.\"");
  #assert agyw_logged(s, "\"kind\":\"command\",\"command\":\"git push origin HEAD:main\",\"exit\":0");
  #assert agyw_logged(s, "{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"Fixed and pushed to main.\"}");

  // 5. Explicit stop during a held background turn sends session/cancel, keeps agy alive,
  //    ends immediately, and ignores subsequent cancelled updates (no orphan post-ended lines).
  s[0].log_n = 0; s[0].turn_active = true; s[0].stopping = false;
  #assert cue_send(x, "run slow job");
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call\",\"toolCallId\":\"call_slow\",\"name\":\"run_command\",\"kind\":\"execute\",\"status\":\"in_progress\",\"title\":\"sleep 99\",\"rawInput\":{\"CommandLine\":\"sleep 99\"}}}}");
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"stopReason\":\"end_turn\"}}");
  #assert s[0].turn_active && cue_held_bg(x) && !cue_prompting(x);
  cu_outbox_clear(x[0].c); s[0].log_n = 0;
  #assert !agyw_handle_stop(s, x, true) && !s[0].turn_active && x[0].live && !cue_held_bg(x);
  #assert agy_out_has(x, "\"method\":\"session/cancel\"");
  #assert agyw_logged(s, "{\"kind\":\"ended\",\"ending\":\"stopped\",\"text\":\"Stopped.\"}");
  s[0].log_n = 0;
  agyw_fx_feed(s, x, "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"s-1\",\"update\":{\"sessionUpdate\":\"tool_call_update\",\"toolCallId\":\"call_slow\",\"status\":\"cancelled\"}}}");
  #assert s[0].log_n == 0 && !cue_held_bg(x);
}
