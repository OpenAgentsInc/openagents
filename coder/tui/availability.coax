// Coder's part of a provider failure: the shared cooldown record
// (coax/lib/agent/engine/availability.coax) and the session's observability line.

ca_failure :: (a: [] App) {
  engine := cd_engine_name(a[0].engine);
  if a[0].engine == ENGINE_MICRO { engine = "micro"; }
  if ca_index(engine) < 0 { return; }
  saved: [1] bool; retry := ca_record(engine, a[0].provider_reset_s, saved[..]);
  cs_put(a, cst_availability(a[0].log[0].line[..], engine, retry, saved[0]));
}
