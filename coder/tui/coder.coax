// Coder in the terminal: an inline TUI (Coder book, chapter 36). Finished
// turns go into the terminal's own scrollback; a live region at the bottom
// holds the working status, the reply as it streams, and the composer.
// Engines: claude (the installed Claude Code CLI on its own login, driven
// over stream-json by coax/lib/agent/claude, one session for the whole
// conversation), codex (the installed Codex CLI on its own login, driven as
// `codex app-server` by coax/lib/agent/codex, one thread; codex.coax) and
// microcoder (OpenAgents' own small loop, coax/lib/microcoder, through a
// Vertex/Gemini/OpenRouter plan; microcoder.coax) and echo (offline: it
// streams your words back). Shift-Tab cycles claude, codex and microcoder;
// each keeps its own conversation. In any engine,
// a message that starts with "$ " runs that command in the working
// directory.
//
//   coder/tui/coder.sh [--engine claude|codex|microcoder|echo] [--model M] [--ask] [--cwd DIR]
//   coder/tui/coder.sh --print "TASK"      no TUI: one task, plain lines out
//
// Keys: Enter sends, Shift-Enter (Ctrl-J, Alt-Enter or a trailing \ where
// the terminal cannot report Shift-Enter) adds a line, Up and
// Down walk history, Shift-Tab switches agent, Esc stops a run, Ctrl-C stops a run, clears the
// composer, or quits; Ctrl-D on an empty composer quits. /help lists the
// slash commands.

#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/tui/tui.coax";
#load "../../coax/lib/tui/vt.coax";
#load "../../coax/lib/agent/claude/claude.coax";
#load "../../coax/lib/sys/fs.coax";
#load "diff.coax";
#load "codex.coax";
#load "microcoder.coax";
#load "session.coax";
#load "route.coax";
#load "plugins.coax";
#load "router.coax";
#load "mcp.coax";
#load "approvals.coax";
#load "term.coax";
#load "acp.coax";
#load "remote.coax";
#load "daemon.coax";
#load "mcp_http.coax";
#load "memory.coax";

cxterm_keys :: (on: int) -> int #foreign;
cxproc_sleep_ms :: (ms: int) -> int #foreign;
cxterm_size :: () -> int #foreign;
cxterm_byte :: (timeout_ms: int) -> int #foreign;
cxterm_write :: (s: [] u8) -> int #foreign;
cxterm_watch :: () -> int #foreign;
cxterm_stopped :: () -> int #foreign;
cxterm_resized :: () -> int #foreign;
cxproc_pty :: (h: int, cols: int, rows: int) -> int #foreign;
cxproc_pty_resize :: (h: int, cols: int, rows: int) -> int #foreign;

CODER_VERSION :: "0.1.0";
ENGINE_ECHO :: 0; ENGINE_CLAUDE :: 1; ENGINE_CODEX :: 2; ENGINE_MICRO :: 3; ENGINE_PSIONIC :: 4;
// Microcoder's worker runs both: psionic is Microcoder on a model served on this machine (chapter 12).
cd_is_micro :: (e: int) -> bool { return e == ENGINE_MICRO || e == ENGINE_PSIONIC; }
END_FINISHED :: 0; END_STOPPED :: 1; END_FAILED :: 2; END_EXPIRED :: 3; END_REDIRECTED :: 4;   // redirected: the watchdog interrupted the turn with a message (chapter 20)
   // expired: stopped at --deadline (chapter 14)
COMMAND_MS :: 120000;      // a "$ " command is stopped after two minutes
SPIN :: [10] string.["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];

App :: struct {
  plain: bool;                   // --print: no TUI, plain lines
  hist: [262144] u8; nhist: int; // the transcript as committed, newest last, for /find (chapter 36)
  effort_b: [16] u8; neffort: int; // the effort for the engine: --effort, or System One's (chapter 13); none leaves the engine's
  auto_engine: bool;                  // --engine auto: System One picks the engine at each conversation's first message
  pre: string;                   // a fork's earlier turns, sent ahead of its first message
  vt: [1] Vt;                    // reads a tool's output as a terminal would show it (chapter 37)
  pl: [] PlRegistry;             // plugins: their commands and hooks (chapter 15)
  vt_out: [131072] u8;
  engine: int;
  model: string;
  model_engine: int;             // --model is for the engine it came with
  ask_first: bool;               // --ask: permission prompts instead of skipping them
  deadline_ms: int;              // --deadline: when the job expires (0: never)
  expiring: bool;
  redirecting: bool;             // the watchdog left ID.turnstop: this turn's stop ends as redirected                // the job passed its deadline: its stop ends as expired
  next_inbox_ms: int;
  cur: [256] u8; ncur: int;      // the step running now, for the status line
  jobs: int; next_jobs_ms: int;  // background jobs running on this machine, counted every 2 s            // the terminal UI looks for job reports this often
  term: [1] CdTerm;               // the terminal the agent drives with --coder-tools (chapter 37)
  coder_tools: bool;              // --coder-tools: Coder's own verbs as an in-process MCP server in Claude Code (chapter 10)
  pol: [1] CdPolicy;              // --allow, --ceiling, --root: approvals answered by policy (chapters 10 and 11)
  cwd: string;
  cols: int; rows: int;
  // the terminal
  ob: [1048576] u8; o: [1] TuiOut;
  lv: [1] TuiLive;
  rows_buf: [1] TuiRows;
  wrap_buf: [1] TuiRows;
  md: [1] TuiMd;                 // the reply's Markdown state (a code block open)
  md_out: [65536] u8;
  // Edit and Write calls shown as diffs once they have run
  df_pending: [1] DfPending;
  df_table: [] DfTable;
  df_file: [2097152] u8;
  keys: [1] TuiKeys;
  ed: [1] TuiEditor;
  inb: [8192] u8; nin: int; last_in_ms: int;
  quit: bool;
  // a run
  running: bool;
  started_ms: int;
  steps: int;
  rep: [65536] u8; nrep: int; rep_done: int; rep_lines: int;   // the reply; committed up to rep_done
  // echo engine
  echo: [8192] u8; necho: int; echo_at: int; echo_next_ms: int;
  // a "$ " command
  cmd: [8192] u8; ncmd: int; cmd_h: int = -1; cmd_out: [65536] u8; ncmd_out: int; cmd_started: int;
  // claude engine: one CLI session for the conversation
  q: [] ClQuery; p: [] ClProcess; qline: [] u8; qarena: [] u8; qout: [] u8; scratch: [] u8;
  live: bool;                     // the CLI is running
  stopping: bool; stop_ms: int;   // an interrupt was sent
  pending: [16384] u8; npending: int;   // the first message, sent once initialize is answered
  ask: bool;                      // a permission request waits for y, a or n
  ask_text: [1024] u8; nask: int;
  ask_input: [65536] u8; nask_input: int;
  ask_perm: [16384] u8; nask_perm: int;
  // codex engine: one app-server thread for the conversation
  cx: [] CxClient; cxp: [] ClProcess; cx_line: [] u8; cx_arena: [] u8; cx_outb: [] u8;
  cx_live: bool;                  // the server is running
  cx_ready: bool;                 // its thread is started
  err: [1024] u8; nerr: int;      // an error notification, for a failed turn
  // microcoder engine: its worker process (mcworker.coax), a run per message
  mc_h: int = -1;
  mc_line: [] u8;
  mc_ar: [1] ClArena;
  log: [] CsLog;                  // the session's log file (session.coax)
  exit: int;                      // coder run's exit code: the last turn's ending
  turns: int;
  cost: f64;
}

cd_engine_name :: (e: int) -> string { return ifx e == ENGINE_CLAUDE then "claude" else ifx e == ENGINE_CODEX then "codex" else ifx e == ENGINE_MICRO then "microcoder" else ifx e == ENGINE_PSIONIC then "psionic" else "echo"; }

// ---------------------------------------------------------------- output

cd_flush :: (a: [] App) {
  if a[0].o[0].n > 0 { r := cxterm_write(a[0].o[0].b[0..<a[0].o[0].n]); a[0].o[0].n = 0; }
}

// Finished text into the scrollback (or stdout, plain).
cd_commit :: (a: [] App, style: int, s: string) {
  cd_hist_add(a, s);
  if a[0].log[0].json { return; }          // coder run --json: the log's lines are the output
  if a[0].plain { tui_put(a[0].o[..], s); tui_put(a[0].o[..], "\n"); cd_flush(a); return; }
  tui_live_commit(a[0].o[..], a[0].lv[..], style, s);
}

// Keeps committed text for /find; when full, the oldest half goes.
cd_hist_add :: (a: [] App, s: string) {
  h := a[0].hist[..];
  if s.count + 1 > h.count { return; }
  if a[0].nhist + s.count + 1 > h.count {
    cut := a[0].nhist / 2; while cut < a[0].nhist && h[cut] != 10 { cut += 1; }
    if cut < a[0].nhist { cut += 1; }
    for i: cut..<a[0].nhist { h[i - cut] = h[i]; }
    a[0].nhist -= cut;
  }
  for c: s { h[a[0].nhist] = c; a[0].nhist += 1; }
  h[a[0].nhist] = 10; a[0].nhist += 1;
}

cd_lower :: (c: u8) -> u8 { return ifx c >= 'A' && c <= 'Z' then c + 32 else c; }

// Whether line holds q, ignoring ASCII case.
cd_holds :: (line: string, q: string) -> bool {
  if q.count == 0 || q.count > line.count { return false; }
  for i: 0..<line.count - q.count + 1 {
    same := true;
    for j: 0..<q.count { if cd_lower(line[i + j]) != cd_lower(q[j]) { same = false; break; } }
    if same { return true; }
  }
  return false;
}

// /find TEXT: the transcript's lines that hold TEXT, the last CD_FIND_MAX of them, without the mouse.
CD_FIND_MAX :: 20;
cd_find :: (a: [] App, q: string) {
  h := cast(string) a[0].hist[0..<a[0].nhist];
  starts: [CD_FIND_MAX] int; ends: [CD_FIND_MAX] int; found := 0;
  at := 0;
  while at < h.count {
    e := at; while e < h.count && h[e] != 10 { e += 1; }
    line := cast(string) h[at..<e];
    earlier := rt_has_prefix(line, "› /find ") || rt_has_prefix(line, "  ⌕ ");
    if cd_holds(line, q) && !earlier {
      k := found % CD_FIND_MAX; starts[k] = at; ends[k] = e; found += 1;
    }
    at = e + 1;
  }
  tb: [24] u8;
  if found == 0 { cd_commit(a, TUI_FAINT, "  Not in the transcript."); return; }
  first := ifx found > CD_FIND_MAX then found - CD_FIND_MAX else 0;
  for i: first..<found {
    k := i % CD_FIND_MAX;
    lb: [1200] u8; ln := cd_cat(lb[..], 0, "  ⌕ "); ln = cd_cat(lb[..], ln, cast(string) h[starts[k]..<ifx ends[k] - starts[k] > 1000 then starts[k] + 1000 else ends[k]]);
    cd_commit(a, TUI_DIM, cast(string) lb[0..<ln]);
  }
  sb: [96] u8; sn := cd_cat(sb[..], 0, "  "); sn = cd_cat(sb[..], sn, cd_itoa(found, tb[..])); sn = cd_cat(sb[..], sn, ifx found == 1 then " line" else " lines");
  if found > CD_FIND_MAX { sn = cd_cat(sb[..], sn, ", the last "); sn = cd_cat(sb[..], sn, cd_itoa(CD_FIND_MAX, tb[..])); sn = cd_cat(sb[..], sn, " shown"); }
  cd_commit(a, TUI_FAINT, cast(string) sb[0..<sn]);
}

// Text under a prefix, continued lines indented to match.
cd_commit_prefixed :: (a: [] App, style: int, first: string, cont: string, s: string) {
  // wrapped at word boundaries to the screen, continued lines indented
  r := a[0].wrap_buf[..];
  tui_rows_reset(r);
  w := tui_rows_wrap(r, style, first, cont, s, a[0].cols - 1);
  buf: [65536] u8; n := 0;
  for i: 0..<r[0].n {
    if i > 0 { n = cd_cat(buf[..], n, "\n"); }
    n = cd_cat(buf[..], n, cast(string) r[0].text[i][0..<r[0].len[i]]);
  }
  cd_commit(a, style, cast(string) buf[0..<n]);
}

cd_itoa :: (v: int, out: [] u8) -> string { o_b: [1] TuiOut; o := o_b[..]; o[0].b = out; tui_int(o, v); return tui_text(o); }

cd_cat :: (out: [] u8, n: int, s: string) -> int { m := n; for c: s { if m < out.count { out[m] = c; m += 1; } } return m; }

cd_seconds_text :: (ms: int, out: [] u8) -> string {
  b: [16] u8;
  n := cd_cat(out, 0, cd_itoa(ms / 1000, b[..]));
  n = cd_cat(out, n, "."); n = cd_cat(out, n, cd_itoa((ms % 1000) / 100, b[..])); n = cd_cat(out, n, "s");
  return cast(string) out[0..<n];
}

// ---------------------------------------------------------------- the live region

cd_draw :: (a: [] App) {
  if a[0].plain { return; }
  r := a[0].rows_buf[..];
  tui_rows_reset(r);
  cols := a[0].cols - 1;
  if a[0].running {
    // the reply's unfinished line, right under the transcript
    if a[0].nrep > a[0].rep_done {
      first := ifx a[0].rep_lines == 0 then "● " else "  ";
      peek_b: [1] TuiMd; peek := peek_b[..]; peek[0] = a[0].md[0];     // a partial line does not move the state
      shown := cd_md(a, peek, cast(string) a[0].rep[a[0].rep_done..<a[0].nrep]);
      if shown.count > 0 { w := tui_rows_wrap(r, TUI_PLAIN, first, "  ", shown, cols); }
    }
    r[0].pad_at = r[0].n;
    // status and any question, just above the composer
    sb: [512] u8; n := 0;
    spin := SPIN;
    n = cd_cat(sb[..], n, spin[(cd_now(a) / 100) % 10]);
    n = cd_cat(sb[..], n, ifx a[0].ask then " Waiting for you" else " Working");
    if a[0].steps > 0 { tb: [16] u8; n = cd_cat(sb[..], n, " · step "); n = cd_cat(sb[..], n, cd_itoa(a[0].steps + 1, tb[..])); }
    tb2: [32] u8; n = cd_cat(sb[..], n, " · "); n = cd_cat(sb[..], n, cd_seconds_text(cd_now(a) - a[0].started_ms, tb2[..]));
    n = cd_cat(sb[..], n, " · Esc to stop");
    // the step running now, last: the row cuts it before the time and the way to stop
    if a[0].ncur > 0 && !a[0].ask { n = cd_cat(sb[..], n, " · "); n = cd_cat(sb[..], n, cast(string) a[0].cur[0..<a[0].ncur]); }
    if a[0].ask {
      w := tui_rows_wrap(r, TUI_BRIGHT, "? ", "  ", cast(string) a[0].ask_text[0..<a[0].nask], cols);
      k := tui_rows_add(r, TUI_DIM, "  y allow · a allow and don't ask again · n deny");
    }
    st := cast(string) sb[0..<n];
    k := tui_rows_add(r, TUI_DIM, cast(string) st[0..<tui_fit(st, cols)]);
  }
  rule: [4096] u8; nr := 0;
  for i: 0..<cols { nr = cd_cat(rule[..], nr, "─"); }
  k := tui_rows_add(r, TUI_FAINT, cast(string) rule[0..<nr]);
  max := a[0].rows - r[0].n - 3;
  if max < 1 { max = 1; } if max > 12 { max = 12; }
  tui_rows_editor(r, a[0].ed[..], "› ", "  ", cols, max, TUI_BRIGHT);
  k = tui_rows_add(r, TUI_FAINT, cast(string) rule[0..<nr]);
  // the agent first, so a narrow row still names it
  hb: [256] u8; hn := cd_cat(hb[..], 0, ifx a[0].engine == ENGINE_ECHO then "echo (offline)" else cd_engine_name(a[0].engine));
  if a[0].jobs > 0 { jb: [16] u8; hn = cd_cat(hb[..], hn, " · "); hn = cd_cat(hb[..], hn, cd_itoa(a[0].jobs, jb[..])); hn = cd_cat(hb[..], hn, ifx a[0].jobs == 1 then " job running" else " jobs running"); }
  hn = cd_cat(hb[..], hn, " · Enter send · Shift-Enter newline · Shift-Tab agent · ↑ history · Esc stop · Ctrl-C quit");
  hint := cast(string) hb[0..<hn];
  k = tui_rows_add(r, TUI_FAINT, cast(string) hint[0..<tui_fit(hint, cols)]);
  tui_live_draw(a[0].o[..], a[0].lv[..], r);
  cd_flush(a);
}

cd_now :: (a: [] App) -> int { return cxproc_now_ms(); }

// ---------------------------------------------------------------- the reply

cd_reply_add :: (a: [] App, s: string) { cs_reply_add(a, s); for c: s { if a[0].nrep < a[0].rep.count { a[0].rep[a[0].nrep] = c; a[0].nrep += 1; } } }

// Commits whole lines of the reply; with all, the rest too.
// A reply line as the terminal shows it: Markdown rendered to styles, or
// as written with --print. "" for a line that shows nothing (a code fence).
cd_md :: (a: [] App, st: [] TuiMd, line: string) -> string {
  if a[0].plain { return line; }
  o_b: [1] TuiOut; o := o_b[..]; o[0].b = a[0].md_out[..]; o[0].theme = a[0].o[0].theme;
  if !tui_md_line(st, line, o, a[0].cols - 3) { return ""; }
  return tui_text(o);
}

cd_reply_commit :: (a: [] App, all: bool) {
  for guard: 0..<100000 {
    at := a[0].rep_done;
    if at >= a[0].nrep { return; }
    nl := at; while nl < a[0].nrep && a[0].rep[nl] != 10 { nl += 1; }
    if nl >= a[0].nrep && !all { return; }
    line := cast(string) a[0].rep[at..<nl];
    first := ifx a[0].rep_lines == 0 then "● " else "  ";
    a[0].rep_done = ifx nl < a[0].nrep then nl + 1 else nl;
    shown := cd_md(a, a[0].md[..], line);
    if shown.count == 0 && line.count > 0 { continue; }      // a code fence
    cd_commit_prefixed(a, TUI_PLAIN, first, "  ", shown);
    a[0].rep_lines += 1;
  }
}

cd_end_word :: (e: int) -> string { return ifx e == END_STOPPED then "stopped" else ifx e == END_FAILED then "failed" else ifx e == END_EXPIRED then "expired" else ifx e == END_REDIRECTED then "redirected" else "finished"; }

cd_finish :: (a: [] App, ending_in: int, text: string) {
  ending := ifx ending_in == END_STOPPED && a[0].expiring then END_EXPIRED else ifx ending_in == END_STOPPED && a[0].redirecting then END_REDIRECTED else ending_in;
  a[0].redirecting = false;
  if a[0].pl.count > 0 && a[0].pl[0].busy >= 0 { pl_done(a[0].pl); }   // a plugin draining for this command settles
  cd_reply_commit(a, true);
  if text.count > 0 && ending == END_FAILED { cd_commit_prefixed(a, TUI_RED, "● ", "  ", text); }
  sb: [256] u8; n := 0; tb: [32] u8;
  n = cd_cat(sb[..], n, "  └ ");
  n = cd_cat(sb[..], n, cd_end_word(ending));
  n = cd_cat(sb[..], n, " · "); n = cd_cat(sb[..], n, cd_seconds_text(cd_now(a) - a[0].started_ms, tb[..]));
  if a[0].steps > 0 { n = cd_cat(sb[..], n, " · "); n = cd_cat(sb[..], n, cd_itoa(a[0].steps, tb[..])); n = cd_cat(sb[..], n, ifx a[0].steps == 1 then " step" else " steps"); }
  cd_commit(a, ifx ending == END_FINISHED then TUI_FAINT else TUI_RED, cast(string) sb[0..<n]);
  cs_end(a, cd_end_word(ending), cd_now(a) - a[0].started_ms, a[0].steps, text);
  cd_hooks(a, "turn_end", cd_end_word(ending));
  a[0].exit = ifx ending == END_FINISHED then 0 else ifx ending == END_STOPPED then 130 else ifx ending == END_EXPIRED then 124 else 1;
  a[0].running = false; a[0].ask = false; a[0].ncur = 0;
}

// What a terminal would show for output a program wrote: CR rewrites, cursor
// moves and colors applied, so a progress bar reads as its last state. Text
// with no control bytes comes back as it is.
cd_screen :: (a: [] App, output: string) -> string {
  plain := true;
  for c: output { if (c < 32 && c != 10 && c != 9) || c == 127 { plain = false; break; } }
  if plain { return output; }
  vt_init(a[0].vt[..], 200, 160, true);
  vt_feed(a[0].vt[..], output);
  return vt_text(a[0].vt[..], a[0].vt_out[..]);
}

cd_command_event :: (a: [] App, cmd: string, exit: int, timed_out: bool, output_raw: string) {
  output := cd_screen(a, output_raw);
  cd_reply_commit(a, true);
  sb: [4096] u8; n := 0; tb: [16] u8;
  n = cd_cat(sb[..], n, "  $ "); n = cd_cat(sb[..], n, cmd);
  n = cd_cat(sb[..], n, ifx timed_out then " · timed out" else " · exit ");
  if !timed_out { n = cd_cat(sb[..], n, cd_itoa(exit, tb[..])); }
  cs_tool(a, cast(string) sb[2..<n]);
  cs_result(a, output, timed_out || exit != 0);
  cd_commit(a, ifx exit == 0 && !timed_out then TUI_DIM else TUI_RED, cast(string) sb[0..<n]);
  // the first lines of output
  shown := 0; at := 0; total := 0;
  for c: output { if c == 10 { total += 1; } }
  if output.count > 0 && output[output.count - 1] != 10 { total += 1; }
  while at < output.count && shown < 4 {
    nl := at; while nl < output.count && output[nl] != 10 { nl += 1; }
    line := cast(string) output[at..<nl];
    lb: [512] u8; ln := cd_cat(lb[..], 0, "    ");
    ln = cd_cat(lb[..], ln, cast(string) line[0..<tui_fit(line, a[0].cols - 6)]);
    cd_commit(a, TUI_FAINT, cast(string) lb[0..<ln]);
    shown += 1; at = nl + 1;
  }
  if total > shown { mb: [64] u8; mn := cd_cat(mb[..], 0, "    … "); mn = cd_cat(mb[..], mn, cd_itoa(total - shown, tb[..])); mn = cd_cat(mb[..], mn, " more lines"); cd_commit(a, TUI_FAINT, cast(string) mb[0..<mn]); }
}

// ---------------------------------------------------------------- engines

cd_start :: (a: [] App, msg: string) {
  a[0].running = true; a[0].started_ms = cd_now(a); a[0].steps = 0;
  a[0].nrep = 0; a[0].rep_done = 0; a[0].rep_lines = 0;
  a[0].md[0].in_code = false;
  a[0].turns += 1;
  if msg.count > 2 && msg[0] == '$' && msg[1] == ' ' { cd_command_start(a, cast(string) msg[2..<msg.count]); return; }
  sent := msg;
  fb: [40000] u8;
  if a[0].pre.count > 0 {        // a fork's first message carries the conversation it was forked from
    n := cd_cat(fb[..], 0, "Earlier in this conversation:\n\n"); n = cd_cat(fb[..], n, a[0].pre);
    n = cd_cat(fb[..], n, "\n\nNow: "); n = cd_cat(fb[..], n, msg);
    sent = cast(string) fb[0..<n];
    a[0].pre = "";
  }
  cs_request(a, sent);           // what the engine is sent, as a digest `coder replay` rebuilds (chapters 2 and 23)
  if a[0].engine == ENGINE_ECHO {
    a[0].necho = 0; a[0].echo_at = 0; a[0].echo_next_ms = cd_now(a) + 300;
    a[0].necho = cd_cat(a[0].echo[..], 0, "Echo engine, offline. You said: ");
    a[0].necho = cd_cat(a[0].echo[..], a[0].necho, sent);
    a[0].necho = cd_cat(a[0].echo[..], a[0].necho, "\nStart with \"$ \" to run a command here, or press Shift-Tab for Claude Code, Codex or Microcoder.");
    return;
  }
  a[0].nerr = 0;
  if a[0].engine == ENGINE_CODEX { cd_codex_send(a, sent); return; }
  if cd_is_micro(a[0].engine) { cd_micro_send(a, sent); return; }
  cd_claude_send(a, sent);
}

// ---------------------------------------------------------------- "$ " commands

cd_command_start :: (a: [] App, cmd: string) {
  a[0].ncmd = cd_cat(a[0].cmd[..], 0, cmd);
  a[0].ncmd_out = 0; a[0].cmd_started = cd_now(a);
  h := cxproc_new();
  if h < 0 { cd_finish(a, END_FAILED, "No process slot is free."); return; }
  wb: [8300] u8; wn := cd_cat(wb[..], 0, "exec 2>&1; "); wn = cd_cat(wb[..], wn, cmd);
  ok := cl_push(h, CL_FIELD_ARG, "/bin/sh") && cl_push(h, CL_FIELD_ARG, "-c") && cl_push(h, CL_FIELD_ARG, cast(string) wb[0..<wn]);
  if a[0].cwd.count > 0 { ok = ok && cl_push(h, CL_FIELD_CWD, a[0].cwd); }
  // on a pseudo-terminal the width of the screen, so programs that draw only for a terminal draw (chapter 37)
  ok = ok && cl_push(h, CL_FIELD_ENV, "TERM=xterm-256color") && cxproc_pty(h, ifx a[0].cols > 8 then a[0].cols - 4 else 80, CD_PTY_ROWS) == 0;
  if !ok || cxproc_spawn(h) != 0 { r := cxproc_release(h); cd_finish(a, END_FAILED, "The command could not start."); return; }
  a[0].cmd_h = h;
  // with no one to type, end of input at once, as a closed stdin was
  if a[0].plain { eot: [1] u8; eot[0] = 4; cd_command_keys(a, cast(string) eot[..]); }
}

CD_PTY_ROWS :: 24;

// Keystrokes to the running command's terminal; the line discipline echoes them.
cd_command_keys :: (a: [] App, keys: string) {
  if a[0].cmd_h < 0 { return; }
  for c: keys { x := cxproc_write(a[0].cmd_h, cast(int) c); }
  y := cxproc_flush(a[0].cmd_h);
}

// Takes the lines the command has written; true when something changed.
cd_command_poll :: (a: [] App) -> bool {
  h := a[0].cmd_h;
  changed := false;
  for guard: 0..<256 {
    n := cxproc_read_line(h, 0);
    if n == CL_TIMEOUT { break; }
    if n == CL_EOF || (n < 0 && n != CL_TOO_LONG) {
      status := cxproc_wait(h, 5000);
      r := cxproc_release(h); a[0].cmd_h = -1;
      cd_command_event(a, cast(string) a[0].cmd[0..<a[0].ncmd], status, false, cast(string) a[0].cmd_out[0..<a[0].ncmd_out]);
      a[0].steps = 1;
      cd_finish(a, ifx status == 0 then END_FINISHED else END_FAILED, "");
      return true;
    }
    if n > 0 {
      for i: 0..<n { if a[0].ncmd_out < a[0].cmd_out.count { a[0].cmd_out[a[0].ncmd_out] = cast,trunc(u8) cxproc_line_byte(h, i); a[0].ncmd_out += 1; } }
    }
    if a[0].ncmd_out < a[0].cmd_out.count { a[0].cmd_out[a[0].ncmd_out] = 10; a[0].ncmd_out += 1; }
    changed = true;
  }
  if cd_now(a) - a[0].cmd_started > COMMAND_MS {
    k := cxproc_kill(h, CL_SIGKILL); status := cxproc_wait(h, 5000);
    r := cxproc_release(h); a[0].cmd_h = -1;
    cd_command_event(a, cast(string) a[0].cmd[0..<a[0].ncmd], -1, true, cast(string) a[0].cmd_out[0..<a[0].ncmd_out]);
    cd_finish(a, END_FAILED, "");
    return true;
  }
  return changed;
}

cd_command_stop :: (a: [] App) {
  if a[0].cmd_h < 0 { return; }
  k := cxproc_kill(a[0].cmd_h, CL_SIGKILL); status := cxproc_wait(a[0].cmd_h, 5000);
  r := cxproc_release(a[0].cmd_h); a[0].cmd_h = -1;
}

// ---------------------------------------------------------------- claude engine

cd_claude_reset :: (q: [] ClQuery) { fresh: ClQuery; q[0] = fresh; }

// Partial messages so the reply streams; the person's Claude Code login,
// never an API key from the environment.
cd_claude_options :: (q: [] ClQuery, cwd: string, model: string, ask: bool, effort: string, coder_tools: bool, tool_hooks: bool) {
  o: [1] ClOptions;
  o[0].include_partial_messages = true;
  if tool_hooks { cl_add_hook(o[..], "PreToolUse", "", 60.0); }    // every tool call first passes the plugins' tool_call hooks
  if coder_tools { cd_claude_coder_server(o[..]); }
  if effort.count > 0 { o[0].effort = effort; }
  // Tools run without asking, as with claude --dangerously-skip-permissions;
  // --ask sends each permission request to the y/a/n prompt instead.
  if ask { o[0].permission_handler = true; }
  else { o[0].permission_mode = ClPermissionMode.bypass_permissions; o[0].allow_dangerously_skip_permissions = true; }
  o[0].cwd = cwd;
  if model.count > 0 { o[0].model = model; }
  cl_remove_env(o[..], "ANTHROPIC_API_KEY");
  q[0].options = o[0];
}

// Starts the CLI on the first message; later messages go to the same session.
cd_claude_send :: (a: [] App, msg: string) {
  if a[0].live {
    cl_send_user(a[0].q, msg);
    return;
  }
  cd_claude_reset(a[0].q);
  cl_init(a[0].q, a[0].qline, a[0].qarena, a[0].qout);
  cd_claude_options(a[0].q, a[0].cwd, ifx a[0].model_engine == ENGINE_CLAUDE then a[0].model else "", a[0].ask_first || a[0].pol[0].on, cd_effort(a), a[0].coder_tools, cd_has_hook(a, "tool_call"));
  a[0].npending = cd_cat(a[0].pending[..], 0, msg);
  problem := cl_start(a[0].q, a[0].p, "", true, a[0].scratch);
  if problem.count > 0 { cd_finish(a, END_FAILED, problem); return; }
  a[0].live = true;
}

cd_claude_close :: (a: [] App) {
  if !a[0].live { return; }
  x := cl_end_input(a[0].q, a[0].p);
  k := cl_kill(a[0].p);
  cl_close(a[0].p);
  a[0].live = false;
}

// A short label for a tool call: Bash(command), Read(file_path) and so on.
cd_tool_label :: (a: [] App, name: string, input: string, out: [] u8) -> string {
  arg := cl_str(a[0].q[0].ar[..], input, "command");
  if arg.count == 0 { arg = cl_str(a[0].q[0].ar[..], input, "file_path"); }
  if arg.count == 0 { arg = cl_str(a[0].q[0].ar[..], input, "pattern"); }
  if arg.count == 0 { arg = cl_str(a[0].q[0].ar[..], input, "url"); }
  if arg.count == 0 { arg = cl_str(a[0].q[0].ar[..], input, "description"); }
  return cd_label(a, name, arg, out);
}

// Name(arg): the argument's first line, cut to the row, a path relative to the working directory.
cd_label :: (a: [] App, name: string, arg_in: string, out: [] u8) -> string {
  n := cd_cat(out, 0, name);
  arg := arg_in;
  // a path inside the working directory, relative to it
  if a[0].cwd.count > 0 && arg.count > a[0].cwd.count + 1 && cast(string) arg[0..<a[0].cwd.count] == a[0].cwd && arg[a[0].cwd.count] == '/' {
    arg = cast(string) arg[a[0].cwd.count + 1..<arg.count];
  }
  if arg.count > 0 {
    n = cd_cat(out, n, "(");
    line := 0; while line < arg.count && arg[line] != 10 { line += 1; }
    shown := cast(string) arg[0..<line];
    n = cd_cat(out, n, cast(string) shown[0..<tui_fit(shown, a[0].cols - name.count - 10)]);
    if line < arg.count || tui_fit(shown, a[0].cols - name.count - 10) < shown.count { n = cd_cat(out, n, "…"); }
    n = cd_cat(out, n, ")");
  }
  return cast(string) out[0..<n];
}

cd_claude_message :: (a: [] App, m: ClMessage) {
  q := a[0].q;
  if m.parent_tool_use_id.count > 0 { return; }       // a subagent's own traffic
  if m.kind == ClKind.stream_event {
    t := cl_str(q[0].ar[..], m.line, "event.type");
    if t == "content_block_delta" && cl_str(q[0].ar[..], m.line, "event.delta.type") == "text_delta" {
      cd_reply_add(a, cl_str(q[0].ar[..], m.line, "event.delta.text"));
      cd_reply_commit(a, false);
    }
    return;
  }
  if m.kind == ClKind.assistant {
    content := cl_raw(m.line, "message.content");
    count := cl_count(content);
    for i: 0..<count {
      item := cl_json(content, cl_item(content, i));
      if cl_str(q[0].ar[..], item, "type") != "tool_use" { continue; }
      cd_reply_commit(a, true); a[0].rep_lines = 0; a[0].nrep = 0; a[0].rep_done = 0;
      lb: [1024] u8;
      label := cd_tool_label(a, cl_str(q[0].ar[..], item, "name"), cl_raw(item, "input"), lb[..]);
      cd_tool_row(a, label);
      a[0].steps += 1;
      name := cl_str(q[0].ar[..], item, "name");
      if name == "Edit" || name == "Write" {
        input := cl_raw(item, "input");
        dp := a[0].df_pending[..];
        dp[0].write = name == "Write";
        dp[0].nid = cd_cat(dp[0].id[..], 0, cl_str(q[0].ar[..], item, "id"));
        dp[0].npath = cd_cat(dp[0].path[..], 0, cl_str(q[0].ar[..], input, "file_path"));
        dp[0].nold = cd_cat(dp[0].old[..], 0, ifx dp[0].write then "" else cl_str(q[0].ar[..], input, "old_string"));
        dp[0].nnext = cd_cat(dp[0].next[..], 0, cl_str(q[0].ar[..], input, ifx dp[0].write then "content" else "new_string"));
        dp[0].active = dp[0].npath > 0;
      }
    }
    return;
  }
  if m.kind == ClKind.user {
    content := cl_raw(m.line, "message.content");
    count := cl_count(content);
    for i: 0..<count {
      item := cl_json(content, cl_item(content, i));
      if cl_str(q[0].ar[..], item, "type") != "tool_result" { continue; }
      text := cl_str(q[0].ar[..], item, "content");
      if text.count == 0 { text = cl_str(q[0].ar[..], item, "content.0.text"); }
      bad := cl_bool(item, "is_error");
      dp := a[0].df_pending[..];
      if dp[0].active && cl_str(q[0].ar[..], item, "tool_use_id") == cast(string) dp[0].id[0..<dp[0].nid] {
        dp[0].active = false;
        if !(bad.ok && bad.value) { df_show(a, dp); continue; }
      }
      cd_result_line(a, text, bad.ok && bad.value);
    }
    return;
  }
  if m.kind == ClKind.result {
    r := cl_result_of(q[0].ar[..], m);
    a[0].cost += r.total_cost_usd;
    ok := r.kind == ClResultKind.success && !r.is_error;
    if !ok && a[0].nrep == 0 && r.result.count > 0 { cd_reply_add(a, r.result); }
    cd_finish(a, ifx ok then END_FINISHED else ifx a[0].stopping then END_STOPPED else END_FAILED, ifx ok then "" else "Claude Code ended the turn with an error.");
    a[0].stopping = false;
  }
}

// A tool call's row, logged.
cd_tool_row :: (a: [] App, label: string) {
  cs_tool(a, label);
  a[0].ncur = cd_cat(a[0].cur[..], 0, cast(string) label[0..<tui_fit(label, 60)]);
  cd_commit_prefixed(a, TUI_DIM, "  ⏺ ", "    ", label);
}

// A tool's result in one row: its first line and how many more.
cd_result_line :: (a: [] App, text_raw: string, bad: bool) {
  text := cd_screen(a, text_raw);
  cs_result(a, text, bad);
  lines := 0; for c: text { if c == 10 { lines += 1; } }
  if text.count > 0 && text[text.count - 1] == 10 { lines -= 1; }
  e := 0; while e < text.count && text[e] != 10 { e += 1; }
  first := cast(string) text[0..<e];
  rb: [1024] u8; rn := cd_cat(rb[..], 0, "    └ ");
  rn = cd_cat(rb[..], rn, cast(string) first[0..<tui_fit(first, a[0].cols - 14)]);
  if lines > 0 { tb: [16] u8; rn = cd_cat(rb[..], rn, " … +"); rn = cd_cat(rb[..], rn, cd_itoa(lines, tb[..])); rn = cd_cat(rb[..], rn, " lines"); }
  cd_commit(a, ifx bad then TUI_RED else TUI_FAINT, cast(string) rb[0..<rn]);
}

// One poll of the CLI; true when something changed.
cd_claude_poll :: (a: [] App) -> bool {
  if !a[0].live || a[0].ask { return false; }
  q := a[0].q; p := a[0].p;
  changed := false;
  for guard: 0..<64 {
    ev := cl_poll(q, p, 0);
    if ev.kind == ClEventKind.idle { break; }
    changed = true;
    if ev.kind == ClEventKind.initialized {
      cl_send_user(q, cast(string) a[0].pending[0..<a[0].npending]);
      continue;
    }
    if ev.kind == ClEventKind.end || ev.kind == ClEventKind.failed {
      eb: [2048] u8; why := cl_error(q);
      if why.count == 0 { why = cl_stderr(p, eb[..]); }
      if why.count == 0 { why = "Claude Code exited."; }
      wb: [2600] u8; wn := cd_cat(wb[..], 0, why);
      cd_claude_close(a);
      if a[0].running { cd_finish(a, END_FAILED, cast(string) wb[0..<wn]); }
      return true;
    }
    if ev.kind == ClEventKind.permission {
      lb: [1024] u8;
      label := cd_tool_label(a, ev.request.tool_name, ev.request.input, lb[..]);
      if a[0].pol[0].on {
        pw: [256] u8; pn: [1] int;
        verdict := cd_claude_verdict(a, ev.request.tool_name, ev.request.input, label, pw[..], pn[..]);
        if verdict == CD_VERDICT_RUN { cl_allow(q, ev.request.input, ""); continue; }
        if verdict == CD_VERDICT_REFUSE {
          db: [400] u8; dn := cd_cat(db[..], 0, "Coder's policy refuses this: "); dn = cd_cat(db[..], dn, cast(string) pw[0..<pn[0]]);
          cl_deny(q, cast(string) db[0..<dn], false); continue;
        }
      }
      a[0].nask = cd_cat(a[0].ask_text[..], 0, "Allow ");
      a[0].nask = cd_cat(a[0].ask_text[..], a[0].nask, label);
      a[0].nask = cd_cat(a[0].ask_text[..], a[0].nask, "?");
      a[0].nask_input = cd_cat(a[0].ask_input[..], 0, ev.request.input);
      a[0].nask_perm = cd_cat(a[0].ask_perm[..], 0, ev.request.permission_suggestions);
      a[0].ask = true;
      return true;      // no more polls until answered: a poll would refuse the request
    }
    if ev.kind == ClEventKind.tool_call { cd_claude_tool_call(a, ev); continue; }
    if ev.kind == ClEventKind.hook { cd_claude_pre_tool(a, ev); continue; }
    if ev.kind == ClEventKind.message { cd_claude_message(a, ev.message); }
    if !a[0].live { return true; }
  }
  return changed;
}

cd_claude_answer :: (a: [] App, c: int) {
  if a[0].engine == ENGINE_CODEX { cd_codex_answer(a, c); }
  else if cd_is_micro(a[0].engine) { cd_micro_answer(a, c); }
  else if c == 'y' || c == 'Y' { cl_allow(a[0].q, cast(string) a[0].ask_input[0..<a[0].nask_input], ""); }
  else if c == 'a' || c == 'A' { cl_allow(a[0].q, cast(string) a[0].ask_input[0..<a[0].nask_input], cast(string) a[0].ask_perm[0..<a[0].nask_perm]); }
  else { cl_deny(a[0].q, "The person denied this.", false); }
  ab: [1100] u8; an := cd_cat(ab[..], 0, "  ");
  an = cd_cat(ab[..], an, cast(string) a[0].ask_text[0..<a[0].nask]);
  an = cd_cat(ab[..], an, ifx c == 'y' || c == 'Y' then " yes" else ifx c == 'a' || c == 'A' then " yes, from now on" else " no");
  cd_commit(a, TUI_DIM, cast(string) ab[0..<an]);
  a[0].ask = false;
}

cd_stop :: (a: [] App) {
  if !a[0].running { return; }
  if a[0].cmd_h >= 0 { cd_command_stop(a); cd_finish(a, END_STOPPED, ""); return; }
  if a[0].engine == ENGINE_ECHO { cd_finish(a, END_STOPPED, ""); return; }
  if a[0].engine == ENGINE_CODEX { cd_codex_stop(a); return; }
  if cd_is_micro(a[0].engine) { cd_micro_stop(a); return; }
  if a[0].ask { cl_deny(a[0].q, "The person stopped the turn.", true); a[0].ask = false; }
  if a[0].live && !a[0].stopping {
    a[0].stopping = true;
    x := cl_interrupt(a[0].q);
    a[0].stop_ms = cd_now(a);
    return;           // the turn ends with its result
  }
  // asked twice, or no answer: end the session; the next message starts a new one
  cd_claude_close(a);
  a[0].stopping = false;
  cd_finish(a, END_STOPPED, "");
}

// One poll of the running engine; true when something changed.
cd_poll :: (a: [] App) -> bool {
  if !a[0].running {
    // late lines between turns
    changed := false;
    if a[0].live { changed = cd_claude_poll(a); }
    if a[0].cx_live { changed = cd_codex_poll(a) || changed; }
    if a[0].mc_h >= 0 { changed = cd_micro_poll(a) || changed; }
    return changed;
  }
  if a[0].cmd_h >= 0 { return cd_command_poll(a); }
  if a[0].engine == ENGINE_CLAUDE {
    if a[0].stopping && cd_now(a) - a[0].stop_ms > 5000 { cd_stop(a); return true; }
    return cd_claude_poll(a);
  }
  if a[0].engine == ENGINE_CODEX {
    if a[0].stopping && cd_now(a) - a[0].stop_ms > 5000 { cd_stop(a); return true; }
    return cd_codex_poll(a);
  }
  if cd_is_micro(a[0].engine) {
    if a[0].stopping && cd_now(a) - a[0].stop_ms > 5000 { cd_stop(a); return true; }
    return cd_micro_poll(a);
  }
  if cd_now(a) < a[0].echo_next_ms { return false; }
  // a word at a time, like a stream
  at := a[0].echo_at;
  if at >= a[0].necho { cd_finish(a, END_FINISHED, ""); return true; }
  e := at; while e < a[0].necho && a[0].echo[e] != ' ' && a[0].echo[e] != 10 { e += 1; }
  if e < a[0].necho { e += 1; }
  cd_reply_add(a, cast(string) a[0].echo[at..<e]);
  cd_reply_commit(a, false);
  a[0].echo_at = e;
  a[0].echo_next_ms = cd_now(a) + 45;
  return true;
}

// ---------------------------------------------------------------- input

HELP :: "/help      this list\n/clear     forget the conversation and clear the screen\n/engine E  claude (Claude Code on its own login), codex (Codex on its own login), microcoder (OpenAgents' own loop),\n           psionic (Microcoder on a model server on this machine), echo (offline) or auto (System One picks at the first message)\n/find TEXT the transcript's lines that hold TEXT\n/theme T   dark, light (for a light background) or none (no colors)\n/plugins   plugins and their states; /plugin enable|disable NAME; /NAME runs a plugin's command\nShift-Tab  switch agent: claude, codex, microcoder; each keeps its own conversation\n/quit      leave (Ctrl-C or Ctrl-D on an empty line too)";

cd_submit :: (a: [] App) {
  text := tui_ed_text(a[0].ed[..]);
  // trim
  s := 0; e := text.count;
  while s < e && (text[s] == ' ' || text[s] == 10) { s += 1; }
  while e > s && (text[e - 1] == ' ' || text[e - 1] == 10) { e -= 1; }
  if s == e { return; }
  mb: [16384] u8; mn := cd_cat(mb[..], 0, cast(string) text[s..<e]);
  msg := cast(string) mb[0..<mn];
  tui_ed_remember(a[0].ed[..], msg);
  tui_ed_clear(a[0].ed[..]);
  if msg[0] == '/' {
    cd_commit_prefixed(a, TUI_DIM, "› ", "  ", msg);
    if msg == "/quit" || msg == "/exit" { a[0].quit = true; return; }
    if msg == "/help" { cd_commit_prefixed(a, TUI_DIM, "  ", "  ", HELP); return; }
    if msg == "/clear" {
      cd_claude_close(a); cd_codex_close(a); cd_micro_close(a);
      if !a[0].plain { tui_csi(a[0].o[..], "2J"); tui_csi(a[0].o[..], "H"); tui_live_cleared(a[0].lv[..]); }
      a[0].log[0].nid = 0; a[0].log[0].on = false;     // the next message opens a new session file
      cd_commit(a, TUI_FAINT, "  The conversation is cleared; the next message starts a new session.");
      return;
    }
    if msg == "/engine echo" { cd_claude_close(a); cd_codex_close(a); cd_micro_close(a); a[0].engine = ENGINE_ECHO; cd_commit(a, TUI_DIM, "  Engine: echo (offline)."); return; }
    if msg == "/engine claude" { cd_switch(a, ENGINE_CLAUDE); return; }
    if msg == "/engine codex" { cd_switch(a, ENGINE_CODEX); return; }
    if msg == "/engine microcoder" { cd_switch(a, ENGINE_MICRO); return; }
    if msg == "/engine psionic" { cd_switch(a, ENGINE_PSIONIC); return; }
    if msg == "/engine auto" { a[0].auto_engine = true; cd_commit(a, TUI_DIM, "  Engine: auto. System One picks the engine at each conversation's first message."); return; }
    if msg.count > 7 && cast(string) msg[0..<7] == "/theme " {
      tv := tui_theme_of(cast(string) msg[7..<msg.count]);
      if tv < 0 { cd_commit(a, TUI_RED, "  /theme is dark, light or none."); return; }
      a[0].o[0].theme = tv;
      cd_commit(a, TUI_DIM, ifx tv == TUI_THEME_LIGHT then "  Theme: light." else ifx tv == TUI_THEME_NONE then "  Theme: none, no colors." else "  Theme: dark.");
      return;
    }
    if msg == "/plugins" { cd_plugins_show(a); return; }
    if msg.count > 6 && cast(string) msg[0..<6] == "/find " { cd_find(a, cast(string) msg[6..<msg.count]); return; }
    if msg.count > 16 && (cast(string) msg[0..<16] == "/plugin disable " || cast(string) msg[0..<15] == "/plugin enable ") { cd_plugin_toggle(a, msg); return; }
    // a plugin's command: /NAME [ARGS] runs its command with ARGS, as a "$ " command
    w := 1; while w < msg.count && msg[w] != ' ' { w += 1; }
    ci := pl_find_cmd(a[0].pl, cast(string) msg[1..<w]);
    if ci >= 0 {
      rb: [4800] u8; rn := cd_cat(rb[..], 0, "$ ");
      owner := a[0].pl[0].cmds[ci].owner;
      eb: [2400] u8; rn = cd_cat(rb[..], rn, pl_cap_env(a[0].pl, owner, eb[..]));     // the capabilities it uses
      rn = cd_cat(rb[..], rn, cast(string) a[0].pl[0].cmds[ci].run[0..<a[0].pl[0].cmds[ci].nrun]);
      a[0].pl[0].busy = owner;
      rn = cd_cat(rb[..], rn, cast(string) msg[w..<msg.count]);
      if a[0].log[0].nid == 0 { cs_open(a); cd_hooks(a, "session_start", ""); }
      cs_user(a, msg);
      cd_start(a, cast(string) rb[0..<rn]);
      return;
    }
    cd_commit(a, TUI_RED, "  Unknown command. /help lists them.");
    return;
  }
  cd_commit_prefixed(a, TUI_BRIGHT, "› ", "  ", msg);
  if a[0].log[0].nid == 0 && a[0].auto_engine { cd_auto_route(a, msg); }
  else if a[0].log[0].nid == 0 { cs_open(a); cd_hooks(a, "session_start", ""); }
  cs_user(a, msg);
  cd_start(a, msg);
}

cd_plugins_show :: (a: [] App) {
  if a[0].pl[0].n == 0 { cd_commit(a, TUI_FAINT, "  No plugins: add NAME.json to ~/.openagents/coder/plugins (Coder book chapter 15)."); return; }
  for k: 0..<a[0].pl[0].n { lb: [1024] u8; tb: [1100] u8; n := cd_cat(tb[..], 0, "  "); n = cd_cat(tb[..], n, pl_line(a[0].pl, k, lb[..])); cd_commit(a, ifx a[0].pl[0].p[k].state == PL_FAILED then TUI_RED else TUI_DIM, cast(string) tb[0..<n]); }
}

// Runs every active plugin's hooks on event, in the session's folder, with
// its context in the environment: CODER_EVENT, CODER_SESSION, CODER_ENGINE,
// CODER_ENDING. Each hook's output shows as rows and is logged as a "hook"
// line. A hook runs for at most PL_HOOK_SECONDS.
PL_HOOK_SECONDS :: 30;
cd_hooks :: (a: [] App, event: string, ending: string) { wb: [8] u8; x := cd_hooks_run(a, event, ending, "", "", wb[..]); }

// Runs the active plugins' hooks on event. For tool_call, CODER_TOOL and
// CODER_TOOL_INPUT name the call, and a hook that exits non-zero refuses it:
// the result is false and why holds the hook's output (chapter 15).
cd_hooks_run :: (a: [] App, event: string, ending: string, tool: string, input: string, why: [] u8) -> bool {
  r := a[0].pl;
  if r.count == 0 { return true; }
  all_ok := true;
  for i: 0..<r[0].nhooks {
    h := r[0].hooks[i..<i + 1];
    if cast(string) h[0].on[0..<h[0].non] != event || r[0].p[h[0].owner].state != PL_ACTIVE { continue; }
    run := cast(string) h[0].run[0..<h[0].nrun];
    owner := pl_name(r, h[0].owner);
    eb: [6] [4200] u8; env: [6] string;
    env[0] = cast(string) eb[0][0..<cd_cat(eb[0][..], cd_cat(eb[0][..], 0, "CODER_EVENT="), event)];
    env[1] = cast(string) eb[1][0..<cd_cat(eb[1][..], cd_cat(eb[1][..], 0, "CODER_SESSION="), cs_id(a[0].log))];
    env[2] = cast(string) eb[2][0..<cd_cat(eb[2][..], cd_cat(eb[2][..], 0, "CODER_ENGINE="), cd_engine_name(a[0].engine))];
    env[3] = cast(string) eb[3][0..<cd_cat(eb[3][..], cd_cat(eb[3][..], 0, "CODER_ENDING="), ending)];
    env[4] = cast(string) eb[4][0..<cd_cat(eb[4][..], cd_cat(eb[4][..], 0, "CODER_TOOL="), tool)];
    env[5] = cast(string) eb[5][0..<cd_cat(eb[5][..], cd_cat(eb[5][..], 0, "CODER_TOOL_INPUT="), cast(string) input[0..<ifx input.count > 4000 then 4000 else input.count])];
    capb: [2400] u8; cb: [3600] u8; cn := cd_cat(cb[..], cd_cat(cb[..], cd_cat(cb[..], 0, pl_cap_env(r, h[0].owner, capb[..])), run), " 2>&1");
    argv := [3] string.["/bin/sh", "-c", cast(string) cb[0..<cn]];
    ob: [65536] u8; ok: [1] bool;
    out := rt_run_in(argv[..], env[..], a[0].cwd, PL_HOOK_SECONDS, ob[..], ok[..]);
    if !ok[0] && all_ok && event == "tool_call" {
      all_ok = false;
      wn := cd_cat(why, 0, owner); wn = cd_cat(why, wn, ": ");
      wn = cd_cat(why, wn, ifx out.count > 0 then cast(string) out[0..<ifx out.count > 300 then 300 else out.count] else "refused");
      while wn > 0 && (why[wn - 1] == 10 || why[wn - 1] == ' ') { wn -= 1; }
      if wn < why.count { why[wn] = 0; }
    }
    // a tool_call hook that says nothing and allows shows nothing: one row per call would bury the transcript
    if event != "tool_call" || !ok[0] || out.count > 0 {
      hb: [1200] u8; hn := cd_cat(hb[..], 0, "Hook("); hn = cd_cat(hb[..], hn, owner); hn = cd_cat(hb[..], hn, ": ");
      hn = cd_cat(hb[..], hn, run); hn = cd_cat(hb[..], hn, ")");
      cd_commit(a, TUI_DIM, cast(string) hb[0..<hn]);
      if out.count > 0 { cd_commit_prefixed(a, ifx ok[0] then TUI_FAINT else TUI_RED, "  ⎿ ", "    ", cast(string) out[0..<ifx out.count > 2000 then 2000 else out.count]); }
    }
    o := a[0].log[0].line[..];
    n := json_raw(o, 0, "{\"kind\":\"hook\",\"on\":"); n = json_write_string(o, n, event);
    n = json_raw(o, n, ",\"plugin\":"); n = json_write_string(o, n, owner);
    n = json_raw(o, n, ",\"run\":"); n = json_write_string(o, n, run);
    if tool.count > 0 { n = json_raw(o, n, ",\"tool\":"); n = json_write_string(o, n, tool); }
    n = json_raw(o, n, ifx ok[0] then ",\"ok\":true" else ",\"ok\":false");
    n = json_raw(o, n, ",\"text\":"); n = json_write_string(o, n, cast(string) out[0..<ifx out.count > 4000 then 4000 else out.count]);
    n = json_raw(o, n, "}");
    if n > 0 { cs_put(a, n); }
  }
  return all_ok;
}

// A goal (chapter 14): a check command that decides when the session's work
// is done. It runs in the session's folder after each finished turn, through
// /bin/sh, for at most CD_GOAL_SECONDS; exit 0 is met. Logged as a "goal"
// line; when it is not met, msg gets the next turn's message.
CD_GOAL_SECONDS :: 900;
cd_goal_check :: (a: [] App, check: string, turn: int, msg: [] u8, nmsg: [] int) -> bool {
  cb: [4200] u8; cn := cd_cat(cb[..], cd_cat(cb[..], 0, check), " 2>&1");
  argv := [3] string.["/bin/sh", "-c", cast(string) cb[0..<cn]];
  none: [1] string; ob: [65536] u8; ok: [1] bool;
  out := rt_run_in(argv[..], none[0..<0], a[0].cwd, CD_GOAL_SECONDS, ob[..], ok[..]);
  tail := ifx out.count > 2000 then cast(string) out[out.count - 2000..<out.count] else out;
  hb: [4400] u8; hn := cd_cat(hb[..], 0, "Goal("); hn = cd_cat(hb[..], hn, check); hn = cd_cat(hb[..], hn, ifx ok[0] then ") met" else ") not met yet");
  cd_commit(a, ifx ok[0] then TUI_FAINT else TUI_DIM, cast(string) hb[0..<hn]);
  if !ok[0] && tail.count > 0 { cd_commit_prefixed(a, TUI_FAINT, "  ⎿ ", "    ", tail); }
  o := a[0].log[0].line[..];
  n := json_raw(o, 0, "{\"kind\":\"goal\",\"check\":"); n = json_write_string(o, n, check);
  n = json_raw(o, n, ",\"turn\":"); n = json_write_int(o, n, turn);
  n = json_raw(o, n, ifx ok[0] then ",\"met\":true" else ",\"met\":false");
  n = json_raw(o, n, ",\"text\":"); n = json_write_string(o, n, tail);
  n = json_raw(o, n, "}");
  if n > 0 { cs_put(a, n); }
  if !ok[0] {
    m := cd_cat(msg, 0, "The goal is not met yet: its check `"); m = cd_cat(msg, m, check); m = cd_cat(msg, m, "` failed");
    m = cd_cat(msg, m, ifx tail.count > 0 then ":\n" else "."); m = cd_cat(msg, m, tail);
    m = cd_cat(msg, m, "\nKeep working until the check passes.");
    nmsg[0] = m;
  }
  return ok[0];
}

// Whether an active plugin has a hook on event.
cd_has_hook :: (a: [] App, event: string) -> bool {
  r := a[0].pl;
  if r.count == 0 { return false; }
  for i: 0..<r[0].nhooks { if cast(string) r[0].hooks[i].on[0..<r[0].hooks[i].non] == event && r[0].p[r[0].hooks[i].owner].state == PL_ACTIVE { return true; } }
  return false;
}

// Claude Code's PreToolUse hook: the plugins' tool_call hooks may refuse the call.
cd_claude_pre_tool :: (a: [] App, ev: ClEvent) {
  q := a[0].q;
  tool := cl_str(q[0].ar[..], ev.arguments, "tool_name");
  input := cl_raw(ev.arguments, "tool_input");
  lb: [1024] u8; label := cd_tool_label(a, tool, input, lb[..]);
  wb: [400] u8; for i: 0..<wb.count { wb[i] = 0; }
  if cd_hooks_run(a, "tool_call", "", label, input, wb[..]) { cl_hook_answer(q, "{}"); return; }
  k := 0; while k < wb.count && wb[k] != 0 { k += 1; }
  ob: [1200] u8;
  n := json_raw(ob[..], 0, "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":");
  rb: [600] u8; rn := cd_cat(rb[..], 0, "A Coder plugin refused this. "); rn = cd_cat(rb[..], rn, cast(string) wb[0..<k]);
  n = json_write_string(ob[..], n, cast(string) rb[0..<rn]); n = json_raw(ob[..], n, "}}");
  cl_hook_answer(q, ifx n > 0 then cast(string) ob[0..<n] else "{}");
}

// /plugin enable NAME, /plugin disable NAME: the disabled list on disk follows.
cd_plugin_toggle :: (a: [] App, msg: string) {
  enable := cast(string) msg[0..<15] == "/plugin enable ";
  name := cast(string) msg[ifx enable then 15 else 16..<msg.count];
  k := pl_index(a[0].pl, name);
  if k < 0 { cd_commit(a, TUI_RED, "  No such plugin. /plugins lists them."); return; }
  db: [1100] u8; dir := pl_dir(db[..]); trb: [16384] u8; trusted := pl_read_small(dir, "trusted", trb[..]);
  ok := ifx enable then pl_enable(a[0].pl, k, trusted) else pl_disable(a[0].pl, k);
  if !ok { cd_commit(a, TUI_RED, ifx enable then "  It isn't disabled." else "  It isn't active or failed."); return; }
  x := pl_save_disabled(a[0].pl);
  lb: [1024] u8; tb: [1100] u8; n := cd_cat(tb[..], 0, "  "); n = cd_cat(tb[..], n, pl_line(a[0].pl, k, lb[..]));
  cd_commit(a, TUI_DIM, cast(string) tb[0..<n]);
}

cd_cmd_plugins :: (r: [] PlRegistry, json: bool) -> int {
  if json { cd_out("["); }
  for k: 0..<r[0].n {
    ob: [2048] u8;
    if json { if k > 0 { cd_out(","); } cd_out(pl_json(r, k, ob[..])); } else { cd_outln(pl_line(r, k, ob[..])); }
  }
  if json { cd_outln("]"); } else if r[0].n == 0 { cd_outln("No plugins: add NAME.json to ~/.openagents/coder/plugins."); }
  return 0;
}

// Switches the agent. Each agent's session stays open with its own conversation.
cd_switch :: (a: [] App, e: int) {
  a[0].engine = e;
  if a[0].log[0].nid > 0 { cs_agent(a, e); }
  cd_commit(a, TUI_DIM, ifx e == ENGINE_CODEX then "  Agent: Codex" else ifx e == ENGINE_MICRO then "  Agent: Microcoder" else ifx e == ENGINE_PSIONIC then "  Agent: Microcoder on Psionic (this machine)" else "  Agent: Claude Code");
}

cd_key :: (a: [] App, k: TuiKey) {
  if k.kind == TUI_K_NONE { return; }
  if a[0].ask && k.kind == TUI_K_CHAR { cd_claude_answer(a, k.cp); return; }
  if k.kind == TUI_K_BACKTAB {
    if a[0].running { return; }      // one agent per run; switch once it is done
    cd_switch(a, ifx a[0].engine == ENGINE_CLAUDE then ENGINE_CODEX else ifx a[0].engine == ENGINE_CODEX then ENGINE_MICRO else ENGINE_CLAUDE);
    return;
  }
  if k.kind == TUI_K_CTRL_C {
    if a[0].running { cd_stop(a); return; }
    if a[0].ed[0].n > 0 { tui_ed_clear(a[0].ed[..]); return; }
    a[0].quit = true; return;
  }
  if k.kind == TUI_K_CTRL_D && a[0].running && a[0].cmd_h >= 0 && a[0].ed[0].n == 0 { eot: [1] u8; eot[0] = 4; cd_command_keys(a, cast(string) eot[..]); return; }
  if k.kind == TUI_K_CTRL_D { if a[0].ed[0].n == 0 && !a[0].running { a[0].quit = true; } else { x := tui_ed_key(a[0].ed[..], TuiKey.{kind = TUI_K_DELETE}); } return; }
  if k.kind == TUI_K_ESC { if a[0].running { cd_stop(a); } return; }
  if k.kind == TUI_K_CLEAR { tui_csi(a[0].o[..], "2J"); tui_csi(a[0].o[..], "H"); tui_live_cleared(a[0].lv[..]); return; }
  r := tui_ed_key(a[0].ed[..], k);
  if r == TUI_ED_SUBMIT {
    if a[0].running && a[0].cmd_h >= 0 {
      // a running command takes the line as typed input, through its terminal
      line := tui_ed_text(a[0].ed[..]);
      lb: [16384] u8; ln := cd_cat(lb[..], 0, line); ln = cd_cat(lb[..], ln, "\r");
      cd_command_keys(a, cast(string) lb[0..<ln]);
      cs_text(a, "keys", "text", line);
      tui_ed_clear(a[0].ed[..]);
      return;
    }
    if a[0].running { return; }      // one task at a time for now; the text stays
    cd_submit(a);
  }
}

// Reads what stdin has and decodes whole keys; a lone ESC counts as Esc
// after 30 ms with nothing behind it.
cd_read_keys :: (a: [] App, wait_ms: int) -> bool {
  got := false;
  b := cxterm_byte(wait_ms);
  if b == -2 { a[0].quit = true; return true; }
  while b >= 0 {
    if a[0].nin < a[0].inb.count { a[0].inb[a[0].nin] = cast,trunc(u8) b; a[0].nin += 1; }
    got = true;
    b = cxterm_byte(0);
  }
  if got { a[0].last_in_ms = cd_now(a); }
  changed := got;
  at := 0;
  for guard: 0..<8192 {
    if at >= a[0].nin { break; }
    more := cd_now(a) - a[0].last_in_ms < 30;
    r := tui_key(a[0].keys[..], cast(string) a[0].inb[0..<a[0].nin], at, more);
    if r.used == 0 { break; }
    cd_key(a, r.key);
    changed = true;
    at += r.used;
  }
  for i: at..<a[0].nin { a[0].inb[i - at] = a[0].inb[i]; }
  a[0].nin -= at;
  return changed;
}

cd_size :: (a: [] App) {
  s := cxterm_size();
  a[0].rows = 24; a[0].cols = 80;
  if s > 0 { a[0].rows = s / 65536; a[0].cols = s % 65536; }
  if a[0].cols < 20 { a[0].cols = 20; } if a[0].cols > 1000 { a[0].cols = 1000; }
  if a[0].rows < 6 { a[0].rows = 6; }
}

// ---------------------------------------------------------------- start

USAGE :: "usage: coder                                  the terminal UI\n       coder run \"TASK\" [--json]                one task, its steps as text or JSON lines; System One picks the engine unless --engine\n       coder route \"TASK\" [--json]              only the engine System One would pick\n       coder decide \"QUESTION\" --options A,B [--state TEXT]   one typed decision from System One\n       coder run \"TASK\" --detach                a background job: prints its ID and returns\n       coder VERB ... --on ssh:DEST|cloud [--remote-repo DIR]   the verb with Coder on another machine (a GCE pool host for cloud)\n                 [--deadline SECONDS]             it expires after this long\n                 [--goal CHECK [--goal-turns N]]  keep working, turn after turn, until the shell command CHECK exits 0\n                 [--report-to ID]                 its ending and last reply go to session ID\n       coder fork ID \"TASK\" [--at TURN]         a new session that carries ID's first TURN turns (all by default)\n       coder stop ID                             stop a running session\n       coder attach ID [\"MESSAGE\"] [--json]    follow a session; a message becomes the job's next turn\n       coder trigger \"TEXT\" [--thread T] [--source S] [--author A] [--to-agent]   an event for the Router\n       coder router [--once] [--stuck SECONDS] [--json]   the Router: starts Workers for events, keeps them online\n       coder replay ID [--json]                  rebuild every request from the log and compare bytes\n       coder daemon [--name N] [--engines E,F] [--root DIR,DIR] [--once]   attach this machine: start queued jobs within its grant\n       coder queue \"TASK\" [--engine E] [--cwd DIR]   a job for this machine's daemon (with --on, that machine's; held here while it does not answer)\n       coder jobs [--json]                       the daemon's heartbeat and its jobs\n       coder policy list|add NAME --mode M [--authors A,B] [--engine E] [--label L] [--channel chat|issue] [--deliver] [--ci] [--text P]|rm NAME\n       coder watch THREAD | --stop THREAD | --list   events on a watched Thread are addressed to the agent\n       coder bench [SUITE] [--json]              run a suite (harness, checks, smoke) and report it\n       coder mcp [--http PORT]                   the verbs as MCP tools on stdio, or Streamable HTTP on 127.0.0.1:PORT, for Claude Code or another agent\n       coder acp [--engine E]                    Coder as an agent for editors (Agent Client Protocol on stdio)\n       coder remember KEY \"TEXT\" [--project] [--days N]   a fact Coder keeps across sessions (yours, or with --project this folder's)\n       coder revise KEY \"TEXT\" [--reason correction|update|resolve]   a new version that supersedes the old\n       coder forget KEY [--project]              the fact's text is hidden in every earlier event\n       coder recall [\"QUERY\"] [--top N] [--json]   the facts, ranked by embedding similarity to QUERY\n       coder ls [--json]                         sessions, newest first\n       coder plugins [--json]                    plugins and their states\n       coder status ID [--json]                  one session's state\n       coder log ID [--json]                     one session's log\noptions: --engine claude|codex|micro|psionic|echo|auto  --profile NAME (plugins: ~/.openagents/coder/profiles/NAME.json)  --effort low|medium|high  --model M  --ask  --cwd DIR  --coder-tools (Claude Code gets Coder's verbs as tools)  --theme dark|light|none\n         --allow EFFECT  --ceiling EFFECT  --root DIR,DIR   approvals by policy; effects: read, network, write, run";

// Flags that take a value: their value is not a positional argument.
CD_VALUE_FLAGS :: [36] string.["--goal", "--goal-turns", "--http", "--name", "--engines", "--remote-repo", "--profile", "--options", "--state", "--theme", "--deadline", "--report-to", "--allow", "--ceiling", "--root", "--effort", "--engine", "--model", "--cwd", "--print", "--on", "--session", "--at", "--thread", "--source", "--author", "--stuck", "--mode", "--authors", "--label", "--channel", "--text", "--stop", "--days", "--reason", "--top"];

// Positional argument k (0 is the verb), skipping flags and their values.
cd_positional :: (args: [] Args, k: int) -> string {
  seen := 0; i := 0;
  flags := CD_VALUE_FLAGS;
  while i < args_count(args) {
    v := args_at(args, i);
    if v.count > 0 && v[0] == '-' {
      takes := false; for f: flags { if v == f { takes = true; } }
      i += ifx takes then 2 else 1;
      continue;
    }
    if seen == k { return v; }
    seen += 1; i += 1;
  }
  return "";
}

// Writes s to stdout, any length.
cd_out :: (s: string) {
  ob: [8192] u8; n := 0;
  for c: s { ob[n] = c; n += 1; if n == ob.count { r := cxterm_write(ob[0..<n]); n = 0; } }
  if n > 0 { r := cxterm_write(ob[0..<n]); }
}
cd_outln :: (s: string) { cd_out(s); cd_out("\n"); }

// "3m ago" from a start time in microseconds.
cd_age :: (us: int, out: [] u8) -> string {
  if us <= 0 { return "?"; }
  s := (cxproc_wall_us() - us) / 1000000;
  tb: [16] u8; n := 0;
  if s < 60 { n = cd_cat(out, 0, cd_itoa(s, tb[..])); n = cd_cat(out, n, "s ago"); }
  else if s < 3600 { n = cd_cat(out, 0, cd_itoa(s / 60, tb[..])); n = cd_cat(out, n, "m ago"); }
  else if s < 86400 { n = cd_cat(out, 0, cd_itoa(s / 3600, tb[..])); n = cd_cat(out, n, "h ago"); }
  else { n = cd_cat(out, 0, cd_itoa(s / 86400, tb[..])); n = cd_cat(out, n, "d ago"); }
  return cast(string) out[0..<n];
}

// A session file's text: "" when there is none. ID may be a prefix of one.
cd_session_file :: (id: string, buf: [] u8, idout: [] u8) -> string {
  db: [1100] u8; dir := cs_dir(db[..]);
  if dir.count == 0 || id.count == 0 { return ""; }
  l_b: [1] FsList; l := l_b[..];
  n := fs_list(dir, l);
  found := -1;
  for i: 0..<n {
    name := fs_entry(l, i);
    if name.count >= id.count + 6 && cast(string) name[0..<id.count] == id && cast(string) name[name.count - 6..<name.count] == ".jsonl" { found = i; }    // the newest match
  }
  if found < 0 { return ""; }
  name := fs_entry(l, found);
  k := cd_cat(idout, 0, cast(string) name[0..<name.count - 6]);
  pb: [1400] u8; pn := cd_cat(pb[..], 0, dir); pn = cd_cat(pb[..], pn, "/"); pn = cd_cat(pb[..], pn, name);
  m := fs_read(cast(string) pb[0..<pn], buf);
  if m < 0 { return ""; }
  return cast(string) buf[0..<m];
}

cd_summary_line :: (id: string, s: [] CsSummary, json: bool, out: [] u8) -> string {
  n := 0;
  if json {
    n = json_raw(out, 0, "{\"id\":"); n = json_write_string(out, n, id);
    n = json_raw(out, n, ",\"engine\":"); n = json_write_string(out, n, cast(string) s[0].engine[0..<s[0].nengine]);
    n = json_raw(out, n, ",\"state\":"); n = json_write_string(out, n, cast(string) s[0].ending[0..<s[0].nending]);
    n = json_raw(out, n, ",\"turns\":"); n = json_write_int(out, n, s[0].turns);
    n = json_raw(out, n, ",\"steps\":"); n = json_write_int(out, n, s[0].steps);
    n = json_raw(out, n, ",\"started_us\":"); n = json_write_int(out, n, s[0].started_us);
    n = json_raw(out, n, ",\"cwd\":"); n = json_write_string(out, n, cast(string) s[0].cwd[0..<s[0].ncwd]);
    n = json_raw(out, n, ",\"task\":"); n = json_write_string(out, n, cast(string) s[0].task[0..<s[0].ntask]);
    n = json_raw(out, n, "}");
    return ifx n < 0 then "" else cast(string) out[0..<n];
  }
  ab: [32] u8; tb: [16] u8;
  n = cd_cat(out, 0, id); n = cd_cat(out, n, "  ");
  n = cd_cat(out, n, cast(string) s[0].engine[0..<s[0].nengine]); for i: s[0].nengine..<11 { n = cd_cat(out, n, " "); }
  st := cast(string) s[0].ending[0..<s[0].nending]; if st.count == 0 { st = "empty"; }
  n = cd_cat(out, n, st); for i: st.count..<10 { n = cd_cat(out, n, " "); }
  ag := cd_age(s[0].started_us, ab[..]); n = cd_cat(out, n, ag); for i: ag.count..<9 { n = cd_cat(out, n, " "); }
  task := cast(string) s[0].task[0..<s[0].ntask];
  e := 0; while e < task.count && task[e] != 10 { e += 1; }
  task = cast(string) task[0..<e];
  n = cd_cat(out, n, cast(string) task[0..<tui_fit(task, 60)]);
  if tui_fit(task, 60) < task.count { n = cd_cat(out, n, "…"); }
  return cast(string) out[0..<n];
}

CD_LS_MAX :: 50;

cd_cmd_ls :: (json: bool) -> int {
  db: [1100] u8; dir := cs_dir(db[..]);
  if dir.count == 0 { tool_errln("coder: no $HOME"); return 1; }
  l_b: [1] FsList; l := l_b[..];
  n := fs_list(dir, l);
  if n <= 0 { if json { cd_outln("[]"); } else { cd_outln("No sessions yet: coder run \"TASK\" or coder starts one."); } return 0; }
  fb: [4194304] u8; s: [1] CsSummary; ab: [65536] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  shown := 0;
  if json { cd_out("["); }
  i := n - 1;
  while i >= 0 && shown < CD_LS_MAX {
    name := fs_entry(l, i);
    i -= 1;
    if name.count < 7 || cast(string) name[name.count - 6..<name.count] != ".jsonl" { continue; }
    pb: [1400] u8; pn := cd_cat(pb[..], 0, dir); pn = cd_cat(pb[..], pn, "/"); pn = cd_cat(pb[..], pn, name);
    m := fs_read(cast(string) pb[0..<pn], fb[..]);
    if m < 0 { continue; }
    cs_read(cast(string) fb[0..<m], s[..], ar[..]);
    if !s[0].ok { continue; }
    ob: [4096] u8;
    line := cd_summary_line(cast(string) name[0..<name.count - 6], s[..], json, ob[..]);
    if json && shown > 0 { cd_out(","); }
    if json { cd_out(line); } else { cd_outln(line); }
    shown += 1;
  }
  if json { cd_outln("]"); }
  return 0;
}

cd_cmd_status :: (id: string, json: bool) -> int {
  fb: [4194304] u8; ib: [128] u8;
  text := cd_session_file(id, fb[..], ib[..]);
  if text.count == 0 { tool_err("coder: no session "); tool_errln(id); return 6; }
  s: [1] CsSummary; ab: [65536] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  cs_read(text, s[..], ar[..]);
  full := cast(string) ib[0..<ifx id.count > 0 then cd_cat(ib[..], 0, "") else 0];
  k := 0; while k < ib.count && ib[k] != 0 { k += 1; }
  full = cast(string) ib[0..<k];
  ob: [4096] u8;
  if json { cd_outln(cd_summary_line(full, s[..], true, ob[..])); return 0; }
  tb: [16] u8;
  cd_out("id      "); cd_outln(full);
  cd_out("engine  "); cd_outln(cast(string) s[0].engine[0..<s[0].nengine]);
  cd_out("state   "); cd_outln(ifx s[0].nending > 0 then cast(string) s[0].ending[0..<s[0].nending] else "empty");
  cd_out("cwd     "); cd_outln(cast(string) s[0].cwd[0..<s[0].ncwd]);
  cd_out("turns   "); cd_outln(cd_itoa(s[0].turns, tb[..]));
  cd_out("steps   "); cd_outln(cd_itoa(s[0].steps, tb[..]));
  ab2: [32] u8; cd_out("started "); cd_outln(cd_age(s[0].started_us, ab2[..]));
  return 0;
}

// The log as the transcript showed it, or its JSON lines.
cd_cmd_log :: (id: string, json: bool) -> int {
  fb: [4194304] u8; ib: [128] u8;
  text := cd_session_file(id, fb[..], ib[..]);
  if text.count == 0 { tool_err("coder: no session "); tool_errln(id); return 6; }
  if json { cd_out(text); return 0; }
  cd_render(text);
  return 0;
}

// A session log's lines as `coder log` shows them.
cd_render :: (text: string) {
  ab: [262144] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  at := 0;
  while at < text.count {
    e := at; while e < text.count && text[e] != 10 { e += 1; }
    line := cast(string) text[at..<e];
    at = e + 1;
    ar[0].at = 0; ar[0].full = false;
    kind := cl_str(ar[..], line, "kind");
    ob: [8192] u8; n := 0;
    if kind == "session" { n = cd_cat(ob[..], 0, "Coder "); n = cd_cat(ob[..], n, cl_str(ar[..], line, "version")); n = cd_cat(ob[..], n, " · "); n = cd_cat(ob[..], n, cl_str(ar[..], line, "engine")); n = cd_cat(ob[..], n, " · "); n = cd_cat(ob[..], n, cl_str(ar[..], line, "cwd")); }
    else if kind == "user" { n = cd_cat(ob[..], 0, "› "); n = cd_cat(ob[..], n, cl_str(ar[..], line, "text")); }
    else if kind == "route" {
      n = cd_cat(ob[..], 0, "  Engine: "); n = cd_cat(ob[..], n, cl_str(ar[..], line, "ran"));
      ok := cl_bool(line, "ok");
      if ok.ok && ok.value { n = cd_cat(ob[..], n, ", System One said "); n = cd_cat(ob[..], n, cl_str(ar[..], line, "engine")); }
      else { n = cd_cat(ob[..], n, ", the default; no decision: "); n = cd_cat(ob[..], n, cl_str(ar[..], line, "text")); }
    }
    else if kind == "agent" { n = cd_cat(ob[..], 0, "  Agent: "); n = cd_cat(ob[..], n, cl_str(ar[..], line, "engine")); }
    else if kind == "tool" { n = cd_cat(ob[..], 0, "  ⏺ "); n = cd_cat(ob[..], n, cl_str(ar[..], line, "label")); }
    else if kind == "result" {
      t := cl_str(ar[..], line, "text"); f := 0; while f < t.count && t[f] != 10 { f += 1; }
      n = cd_cat(ob[..], 0, "    └ "); n = cd_cat(ob[..], n, cast(string) t[0..<f]);
      bad := cl_bool(line, "error"); if bad.ok && bad.value { n = cd_cat(ob[..], n, "  (error)"); }
    }
    else if kind == "diff" {
      tb: [16] u8;
      n = cd_cat(ob[..], 0, "    └ "); n = cd_cat(ob[..], n, cl_str(ar[..], line, "path"));
      n = cd_cat(ob[..], n, " (+"); ad := cl_int(line, "adds"); n = cd_cat(ob[..], n, cd_itoa(ad.value, tb[..]));
      n = cd_cat(ob[..], n, " -"); de := cl_int(line, "dels"); n = cd_cat(ob[..], n, cd_itoa(de.value, tb[..])); n = cd_cat(ob[..], n, ")");
    }
    else if kind == "reply" {
      t := cl_str(ar[..], line, "text");
      n = cd_cat(ob[..], 0, "● ");
      for c: t { n = cd_cat(ob[..], n, ifx c == 10 then "\n  " else ""); if c != 10 && n < ob.count { ob[n] = c; n += 1; } }
    }
    else if kind == "job" {
      n = cd_cat(ob[..], 0, "  ◆ job "); n = cd_cat(ob[..], n, cl_str(ar[..], line, "id")); n = cd_cat(ob[..], n, " ");
      n = cd_cat(ob[..], n, cl_str(ar[..], line, "ending"));
      jt := cl_str(ar[..], line, "text"); if jt.count > 0 { n = cd_cat(ob[..], n, ": "); n = cd_cat(ob[..], n, cast(string) jt[0..<tui_fit(jt, 200)]); }
    }
    else if kind == "end" {
      tb: [32] u8;
      ms := cl_int(line, "ms"); st := cl_int(line, "steps");
      n = cd_cat(ob[..], 0, "  └ "); n = cd_cat(ob[..], n, cl_str(ar[..], line, "ending"));
      n = cd_cat(ob[..], n, " · "); n = cd_cat(ob[..], n, cd_seconds_text(ms.value, tb[..]));
      if st.value > 0 { n = cd_cat(ob[..], n, " · "); n = cd_cat(ob[..], n, cd_itoa(st.value, tb[..])); n = cd_cat(ob[..], n, ifx st.value == 1 then " step" else " steps"); }
      why := cl_str(ar[..], line, "text"); if why.count > 0 { n = cd_cat(ob[..], n, " · "); n = cd_cat(ob[..], n, why); }
    }
    if n > 0 { cd_outln(cast(string) ob[0..<n]); }
  }
}

// --report-to ID: when the job is over, its ending and last reply land in
// ID's log as a "job" line and in ID's inbox as a message, so a session that
// is still working (a job, or the terminal UI) takes it as its next turn.
cd_report_job :: (a: [] App) {
  l := a[0].log;
  if l[0].nreport == 0 || l[0].nid == 0 { return; }
  to := cast(string) l[0].report[0..<l[0].nreport];
  ending := ifx l[0].nending > 0 then cast(string) l[0].ending[0..<l[0].nending] else "failed";
  text := cast(string) l[0].last[0..<l[0].nlast];
  jb: [16384] u8;
  n := json_raw(jb[..], 0, "{\"kind\":\"job\",\"id\":"); n = json_write_string(jb[..], n, cs_id(l));
  n = json_raw(jb[..], n, ",\"ending\":"); n = json_write_string(jb[..], n, ending);
  n = json_raw(jb[..], n, ",\"text\":"); n = json_write_string(jb[..], n, cast(string) text[0..<ifx text.count > 8000 then 8000 else text.count]);
  n = json_raw(jb[..], n, "}\n");
  pb: [1300] u8; path := cd_sibling(to, ".jsonl", pb[..]);
  if n > 0 && path.count > 0 { x := fs_append(path, cast(string) jb[0..<n]); }
  mb: [16384] u8;
  m := cd_cat(mb[..], 0, "Job "); m = cd_cat(mb[..], m, cs_id(l)); m = cd_cat(mb[..], m, " ended "); m = cd_cat(mb[..], m, ending);
  m = cd_cat(mb[..], m, ifx text.count > 0 then ": " else "."); m = cd_cat(mb[..], m, cast(string) text[0..<ifx text.count > 8000 then 8000 else text.count]);
  qb: [1400] u8; y := cd_msg_put(to, cast(string) mb[0..<m], qb[..]);
}

// ---------------------------------------------------------------- messages to a job (coder attach)

// A job's messages wait in sessions/ID.inbox, one file each, named by the
// time they were sent. Whoever renames a message to .taken first owns it, so
// a message is taken once even when the job and `coder attach` race.
cd_msg_put :: (id: string, text: string, path_out: [] u8) -> string {
  db: [1300] u8; dir := cd_sibling(id, ".inbox", db[..]);
  if dir.count == 0 { return ""; }
  x := fs_mkdir(dir);
  tb: [24] u8;
  n := cd_cat(path_out, 0, dir); n = cd_cat(path_out, n, "/"); n = cd_cat(path_out, n, cd_itoa(cxproc_wall_us(), tb[..])); n = cd_cat(path_out, n, ".msg");
  jb: [65536] u8;
  m := json_raw(jb[..], 0, "{\"text\":"); m = json_write_string(jb[..], m, text); m = json_raw(jb[..], m, "}\n");
  if m < 0 || !fs_write(cast(string) path_out[0..<n], cast(string) jb[0..<m]) { return ""; }
  return cast(string) path_out[0..<n];
}

// Takes the message at path: "" when someone else took it first.
cd_msg_take :: (path: string, out: [] u8) -> string {
  tb: [1400] u8; tn := cd_cat(tb[..], cd_cat(tb[..], 0, path), ".taken");
  if !fs_rename(path, cast(string) tb[0..<tn]) { return ""; }
  jb: [65536] u8; jn := fs_read(cast(string) tb[0..<tn], jb[..]);
  x := fs_remove(cast(string) tb[0..<tn]);
  if jn <= 0 { return ""; }
  ab: [65536] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  n := cd_cat(out, 0, cl_str(ar[..], cast(string) jb[0..<jn], "text"));
  return cast(string) out[0..<n];
}

// Takes the oldest message waiting for id; "" when there is none.
cd_msg_next :: (id: string, out: [] u8) -> string {
  db: [1300] u8; dir := cd_sibling(id, ".inbox", db[..]);
  if dir.count == 0 || !fs_exists(dir) { return ""; }
  for attempt: 0..<4 {
    l_b: [1] FsList; n := fs_list(dir, l_b[..]);
    best := -1;
    for i: 0..<n {
      name := fs_entry(l_b[..], i);
      if name.count < 5 || cast(string) name[name.count - 4..<name.count] != ".msg" { continue; }
      if best < 0 { best = i; continue; }
      o := fs_entry(l_b[..], best);
      if name.count < o.count || (name.count == o.count && cd_less(name, o)) { best = i; }
    }
    if best < 0 { return ""; }
    pb: [1400] u8; pn := cd_cat(pb[..], cd_cat(pb[..], cd_cat(pb[..], 0, dir), "/"), fs_entry(l_b[..], best));
    m := cd_msg_take(cast(string) pb[0..<pn], out);
    if m.count > 0 { return m; }
  }
  return "";
}

cd_less :: (x: string, y: string) -> bool {
  for i: 0..<x.count { if i >= y.count { return false; } if x[i] != y[i] { return x[i] < y[i]; } }
  return x.count < y.count;
}

// coder attach ID ["MESSAGE"]: follow a session as it runs; with a message,
// the job takes it as its next turn, or, when the job has ended, the
// conversation continues in a fork that attach then follows.
cd_cmd_attach :: (id_in: string, msg: string, json: bool) -> int {
  fb: [4194304] u8; ib: [128] u8;
  text := cd_session_file(id_in, fb[..], ib[..]);
  // a job that was just started writes its session file a moment after its pid file
  for w: 0..<100 { if text.count > 0 || cd_job_pid(id_in) <= 0 { break; } x := cxproc_sleep_ms(100); text = cd_session_file(id_in, fb[..], ib[..]); }
  if text.count == 0 { tool_err("coder: no session "); tool_errln(id_in); return 6; }
  k := 0; while k < ib.count && ib[k] != 0 { k += 1; }
  idb: [64] u8; idn := cd_cat(idb[..], 0, cast(string) ib[0..<k]);
  pending: [1400] u8; npending := 0;
  if msg.count > 0 {
    p := cd_msg_put(cast(string) idb[0..<idn], msg, pending[..]);
    if p.count == 0 { tool_errln("coder attach: could not leave the message"); return 1; }
    npending = p.count;
  }
  shown := 0;
  for guard: 0..<100000000 {
    id := cast(string) idb[0..<idn];
    text = cd_session_file(id, fb[..], ib[..]);
    end := text.count; while end > shown && text[end - 1] != 10 { end -= 1; }
    if end > shown {
      if json { cd_out(cast(string) text[shown..<end]); } else { cd_render(cast(string) text[shown..<end]); }
      shown = end;
    }
    pid := cd_job_pid(id);
    alive := pid > 0 && cxproc_pid_alive(pid) == 1;
    if npending > 0 && !fs_exists(cast(string) pending[0..<npending]) { npending = 0; }   // the job took it
    if npending > 0 && !alive {
      // the job is over: take the message back and continue the conversation in a fork
      mb: [65536] u8; m := cd_msg_take(cast(string) pending[0..<npending], mb[..]);
      npending = 0;
      if m.count > 0 {
        args := [3] string.["fork", id, m];
        nb: [256] u8; nid := rt_coder(args[..], nb[..]);
        if nid.count == 0 || nid.count > 40 { tool_errln("coder attach: the session has ended and a fork did not start"); return 1; }
        if !json { lb: [200] u8; ln := cd_cat(lb[..], 0, "  The session had ended; continuing in "); ln = cd_cat(lb[..], ln, nid); cd_outln(cast(string) lb[0..<ln]); }
        idn = cd_cat(idb[..], 0, nid); shown = 0;
        for w: 0..<100 { if cd_job_pid(nid) > 0 { break; } x := cxproc_sleep_ms(50); }
        continue;
      }
    }
    if !alive && npending == 0 {
      s: [1] CsSummary; ab: [65536] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
      cs_read(text, s[..], ar[..]);
      if end == text.count { return ifx cast(string) s[0].ending[0..<s[0].nending] == "finished" then 0 else 1; }
    }
    x := cxproc_sleep_ms(200);
  }
  return 0;
}

// ---------------------------------------------------------------- coder bench

CD_SUITES :: [3] string.["harness", "checks", "smoke"];
CD_SUITE_ABOUT :: [3] string.[
  "chapter 21: the harness measured end to end, with seeds, verdicts and a receipt chain",
  "Coder's own checks: coax test coder/tui/coder.coax",
  "the offline smoke: the terminal UI in a pseudo-terminal, then every verb"];

// coder bench [SUITE] [--json]: runs a suite from this checkout, reports
// whether it passed and how long it took, and keeps the report in
// ~/.openagents/coder/bench.
cd_cmd_bench :: (suite: string, json: bool) -> int {
  names := CD_SUITES; about := CD_SUITE_ABOUT;
  k := -1; for i: 0..<names.count { if names[i] == suite { k = i; } }
  if k < 0 {
    if suite.count > 0 { tool_err("coder bench: no suite "); tool_errln(suite); }
    for i: 0..<names.count { lb: [256] u8; ln := cd_cat(lb[..], 0, names[i]); while ln < 10 { ln = cd_cat(lb[..], ln, " "); } ln = cd_cat(lb[..], ln, about[i]); cd_outln(cast(string) lb[0..<ln]); }
    return ifx suite.count > 0 then 2 else 0;
  }
  rb: [4096] u8; repo := cl_getenv("CODER_REPO", rb[..]);
  if repo.count == 0 { tool_errln("coder bench: run it through coder/tui/coder.sh, which names the checkout"); return 2; }
  cb: [4200] u8; cn := cd_cat(cb[..], cd_cat(cb[..], 0, repo), "/coax/bin/coax");
  argv: [3] string; na := 3;
  if k == 0 { argv[0] = cast(string) cb[0..<cn]; argv[1] = "run"; argv[2] = "psionic/examples/measure-harness.coax"; }
  else if k == 1 { argv[0] = cast(string) cb[0..<cn]; argv[1] = "test"; argv[2] = "coder/tui/coder.coax"; }
  else { argv[0] = "python3"; argv[1] = "coder/tui/smoke.py"; na = 2; }
  if !json { lb: [256] u8; ln := cd_cat(lb[..], 0, "Running "); ln = cd_cat(lb[..], ln, names[k]); ln = cd_cat(lb[..], ln, ": "); ln = cd_cat(lb[..], ln, about[k]); cd_outln(cast(string) lb[0..<ln]); }
  env := [1] string.["BROWSER=/usr/bin/true"];
  t0 := cxproc_wall_us();
  ob: [1048576] u8; ok: [1] bool;
  out := rt_run_in(argv[0..<na], env[..], repo, 1800, ob[..], ok[..]);
  ms := (cxproc_wall_us() - t0) / 1000;
  // the last line that says something: a total or a verdict
  e := out.count; while e > 0 && (out[e - 1] == 10 || out[e - 1] == ' ') { e -= 1; }
  st := e; while st > 0 && out[st - 1] != 10 { st -= 1; }
  last := cast(string) out[st..<e];
  jb: [8192] u8;
  n := json_raw(jb[..], 0, "{\"suite\":"); n = json_write_string(jb[..], n, names[k]);
  n = json_raw(jb[..], n, ifx ok[0] then ",\"passed\":true" else ",\"passed\":false");
  n = json_raw(jb[..], n, ",\"ms\":"); n = json_write_int(jb[..], n, ms);
  n = json_raw(jb[..], n, ",\"at_us\":"); n = json_write_int(jb[..], n, t0);
  n = json_raw(jb[..], n, ",\"last\":"); n = json_write_string(jb[..], n, cast(string) last[0..<ifx last.count > 2000 then 2000 else last.count]);
  n = json_raw(jb[..], n, "}");
  hb: [1024] u8; home := cl_getenv("HOME", hb[..]);
  if home.count > 0 && n > 0 {
    pb: [1300] u8; pn := cd_cat(pb[..], 0, home); pn = cd_cat(pb[..], pn, "/.openagents/coder/bench"); x := fs_mkdir(cast(string) pb[0..<pn]);
    ib: [32] u8; pn = cd_cat(pb[..], pn, "/"); pn = cd_cat(pb[..], pn, names[k]); pn = cd_cat(pb[..], pn, "-"); pn = cd_cat(pb[..], pn, cs_make_id(t0, ib[..])); pn = cd_cat(pb[..], pn, ".json");
    lb: [8200] u8; ln := cd_cat(lb[..], cd_cat(lb[..], 0, cast(string) jb[0..<n]), "\n");
    y := fs_write(cast(string) pb[0..<pn], cast(string) lb[0..<ln]);
  }
  if json { cd_outln(cast(string) jb[0..<n]); }
  else {
    tb: [32] u8; lb: [2300] u8;
    ln := cd_cat(lb[..], 0, ifx ok[0] then "passed · " else "FAILED · "); ln = cd_cat(lb[..], ln, cd_seconds_text(ms, tb[..]));
    ln = cd_cat(lb[..], ln, " · "); ln = cd_cat(lb[..], ln, cast(string) last[0..<ifx last.count > 200 then 200 else last.count]);
    cd_outln(cast(string) lb[0..<ln]);
  }
  return ifx ok[0] then 0 else 1;
}

// ---------------------------------------------------------------- coder replay

// SHA-256 of s as 64 lowercase hex digits.
cd_sha256_hex :: (s: string, out: [] u8) -> string {
  ib: [65536] u8; n := ifx s.count <= ib.count then s.count else ib.count;
  for i: 0..<n { ib[i] = s[i]; }
  d: [32] u8; x := sha256_hash_checked(ib[0..<n], d[..], false);
  digits := "0123456789abcdef";
  for i: 0..<32 { out[2 * i] = digits[cast(int) (d[i] >> 4)]; out[2 * i + 1] = digits[cast(int) (d[i] & 15)]; }
  return cast(string) out[0..<64];
}

// The message a turn sent its engine, rebuilt from the log: the user's text,
// and for a fork's first turn, the parent's first `at` turns ahead of it.
cd_rebuild :: (user: string, parent: string, at: int, first: bool, out: [] u8) -> string {
  if !first || parent.count == 0 { n := cd_cat(out, 0, user); return cast(string) out[0..<n]; }
  fb: [4194304] u8; ib: [128] u8;
  ptext := cd_session_file(parent, fb[..], ib[..]);
  ab: [262144] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  tb: [40000] u8; tn: [1] int;
  turns := cs_turns_text(ptext, at, ar[..], tb[..], tn[..]);
  if turns == 0 { n := cd_cat(out, 0, user); return cast(string) out[0..<n]; }
  n := cd_cat(out, 0, "Earlier in this conversation:\n\n"); n = cd_cat(out, n, cast(string) tb[0..<tn[0]]);
  n = cd_cat(out, n, "\n\nNow: "); n = cd_cat(out, n, user);
  return cast(string) out[0..<n];
}

// coder replay ID: rebuilds every request the session sent from its log and
// compares each one's bytes, by SHA-256 and length, with what was logged.
cd_cmd_replay :: (id: string, json: bool) -> int {
  fb: [4194304] u8; ib: [128] u8;
  text := cd_session_file(id, fb[..], ib[..]);
  if text.count == 0 { tool_err("coder: no session "); tool_errln(id); return 6; }
  pb: [64] u8; pn := 0; at := 0;
  ub: [65536] u8; un := 0; have_user := false; first := true; users := 0;
  requests := 0; matched := 0; tb: [24] u8;
  pos := 0;
  if json { cd_out("{\"requests\":["); }
  while pos < text.count {
    e := pos; while e < text.count && text[e] != 10 { e += 1; }
    line := cast(string) text[pos..<e];
    pos = e + 1;
    ab: [131072] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
    kind := cl_str(ar[..], line, "kind");
    if kind == "session" {
      pn = cd_cat(pb[..], 0, cl_str(ar[..], line, "parent"));
      a2 := cl_int(line, "at"); at = ifx a2.ok then a2.value else 0;
    } else if kind == "user" {
      un = cd_cat(ub[..], 0, cl_str(ar[..], line, "text")); have_user = true; users += 1;
      first = users == 1;
    } else if kind == "request" {
      requests += 1;
      want := cl_str(ar[..], line, "sha256"); wb := cl_int(line, "bytes");
      rb: [131072] u8; hb: [64] u8;
      sent := ifx have_user then cd_rebuild(cast(string) ub[0..<un], cast(string) pb[0..<pn], at, first, rb[..]) else "";
      got := cd_sha256_hex(sent, hb[..]);
      same := have_user && got == want && wb.ok && wb.value == sent.count;
      if same { matched += 1; }
      have_user = false;
      if json {
        ob: [512] u8;
        n := json_raw(ob[..], 0, ifx requests > 1 then ",{\"turn\":" else "{\"turn\":"); n = json_write_int(ob[..], n, users);
        n = json_raw(ob[..], n, ",\"bytes\":"); n = json_write_int(ob[..], n, sent.count);
        n = json_raw(ob[..], n, ",\"sha256\":"); n = json_write_string(ob[..], n, got);
        n = json_raw(ob[..], n, ifx same then ",\"same\":true}" else ",\"same\":false}");
        cd_out(cast(string) ob[0..<n]);
      } else {
        ob: [512] u8;
        n := cd_cat(ob[..], 0, "turn "); n = cd_cat(ob[..], n, cd_itoa(users, tb[..]));
        n = cd_cat(ob[..], n, ifx same then ": same bytes (" else ": DIFFERENT (");
        n = cd_cat(ob[..], n, cd_itoa(sent.count, tb[..])); n = cd_cat(ob[..], n, " bytes, sha256 ");
        n = cd_cat(ob[..], n, cast(string) got[0..<12]); n = cd_cat(ob[..], n, "…)");
        cd_outln(cast(string) ob[0..<n]);
      }
    }
  }
  if json {
    ob: [128] u8; n := json_raw(ob[..], 0, "],\"matched\":"); n = json_write_int(ob[..], n, matched);
    n = json_raw(ob[..], n, ",\"total\":"); n = json_write_int(ob[..], n, requests); n = json_raw(ob[..], n, "}");
    cd_outln(cast(string) ob[0..<n]);
  } else {
    ob: [128] u8; n := cd_cat(ob[..], 0, cd_itoa(matched, tb[..])); n = cd_cat(ob[..], n, " of ");
    n = cd_cat(ob[..], n, cd_itoa(requests, tb[..])); n = cd_cat(ob[..], n, " requests rebuilt with the same bytes.");
    cd_outln(cast(string) ob[0..<n]);
  }
  return ifx matched == requests then 0 else 1;
}

cd_effort :: (a: [] App) -> string { return cast(string) a[0].effort_b[0..<a[0].neffort]; }

// After a decision: its engine, and its effort when System One was sure; --effort wins.
cd_route_apply :: (a: [] App, r: [] CdRoute, effort_flag: bool) {
  a[0].engine = cd_route_pick(r); a[0].model_engine = a[0].engine;
  if !effort_flag && r[0].ok && r[0].probability >= CD_ROUTE_SURE { a[0].neffort = cd_cat(a[0].effort_b[..], 0, cast(string) r[0].effort[0..<r[0].neffort]); }
}

// The engine to run for a decision: System One's pick when it is sure and the
// agent is here; else Claude Code when it is installed, else Microcoder.
cd_route_pick :: (r: [] CdRoute) -> int {
  fallback := ifx cd_on_path("claude") then ENGINE_CLAUDE else ENGINE_MICRO;
  if !r[0].ok || r[0].probability < CD_ROUTE_SURE { return fallback; }
  e := cd_route_engine(r);
  if e == "claude" { return ifx cd_on_path("claude") then ENGINE_CLAUDE else ENGINE_MICRO; }
  if e == "codex" { return ifx cd_on_path("codex") then ENGINE_CODEX else fallback; }
  if e == "psionic" { return ENGINE_PSIONIC; }
  return ENGINE_MICRO;
}

// --engine auto: System One picks this conversation's engine from its first
// message; with no decision the current engine runs and the route line says why.
cd_auto_route :: (a: [] App, msg: string) {
  cb: [16] u8; rt: [1] CdRoute;
  cd_route(msg, cl_getenv("PSIONIC_BASE_URL", cb[..]).count > 0, rt[..]);
  sure := rt[0].ok && rt[0].probability >= CD_ROUTE_SURE;
  if sure { pick := cd_route_pick(rt[..]); if pick != a[0].engine { cd_switch(a, pick); } cd_route_apply(a, rt[..], false); }
  cs_open(a); cs_route(a, rt[..]); cd_hooks(a, "session_start", "");
  rb: [700] u8; cd_commit(a, TUI_FAINT, cd_route_line(a, rt[..], rb[..]));
}

// "  Engine: codex (0.87) · easy · effort low, chosen by System One"
cd_route_line :: (a: [] App, r: [] CdRoute, out: [] u8) -> string {
  tb: [256] u8;
  n := cd_cat(out, 0, "  Engine: "); n = cd_cat(out, n, cd_engine_name(a[0].engine));
  if !r[0].ok { n = cd_cat(out, n, ", the default; no decision: "); n = cd_cat(out, n, cast(string) r[0].why[0..<r[0].nwhy]); }
  else if cd_engine_name(a[0].engine) != cd_route_engine(r) && !(a[0].engine == ENGINE_MICRO && cd_route_engine(r) == "micro") {
    n = cd_cat(out, n, ", the default; System One said "); n = cd_cat(out, n, cd_route_text(r, tb[..]));
  } else { n = cd_cat(out, 0, "  Engine: "); n = cd_cat(out, n, cd_route_text(r, tb[..])); n = cd_cat(out, n, ", chosen by System One"); }
  return cast(string) out[0..<n];
}

cd_route_json :: (r: [] CdRoute, ran: string, out: [] u8) -> string {
  n := json_raw(out, 0, "{\"kind\":\"route\",\"ok\":"); n = json_raw(out, n, ifx r[0].ok then "true" else "false");
  if r[0].ok {
    n = json_raw(out, n, ",\"engine\":"); n = json_write_string(out, n, cd_route_engine(r));
    pm := cast(int) (r[0].probability * 1000.0 + 0.5);       // as 0.962: three places are what the decision carries
    n = json_raw(out, n, ",\"probability\":"); n = json_write_int(out, n, pm / 1000); n = json_raw(out, n, ".");
    n = json_raw(out, n, ifx pm % 1000 < 10 then "00" else ifx pm % 1000 < 100 then "0" else ""); n = json_write_int(out, n, pm % 1000);
    n = json_raw(out, n, ",\"difficulty\":"); n = json_write_int(out, n, r[0].difficulty);
    n = json_raw(out, n, ",\"effort\":"); n = json_write_string(out, n, cast(string) r[0].effort[0..<r[0].neffort]);
  } else { n = json_raw(out, n, ",\"text\":"); n = json_write_string(out, n, cast(string) r[0].why[0..<r[0].nwhy]); }
  if ran.count > 0 { n = json_raw(out, n, ",\"ran\":"); n = json_write_string(out, n, ran); }
  n = json_raw(out, n, "}");
  return ifx n < 0 then "" else cast(string) out[0..<n];
}

cs_route :: (a: [] App, r: [] CdRoute) {
  n := 0; o := a[0].log[0].line[..];
  line := cd_route_json(r, cd_engine_name(a[0].engine), o);
  cs_put(a, line.count);
}

cd_cmd_route :: (task: string, json: bool) -> int {
  if task.count == 0 { tool_errln("coder route: needs a task: coder route \"TASK\""); return 2; }
  rt: [1] CdRoute; eb: [64] u8;
  cd_route(task, cl_getenv("PSIONIC_BASE_URL", eb[..]).count > 0, rt[..]);
  ob: [1024] u8;
  if json { cd_outln(cd_route_json(rt[..], "", ob[..])); }
  else if rt[0].ok { cd_outln(cd_route_text(rt[..], ob[..])); }
  else { tool_err("coder route: "); tool_errln(cast(string) rt[0].why[0..<rt[0].nwhy]); }
  return ifx rt[0].ok then 0 else 1;
}

cxproc_pid_alive :: (pid: int) -> int #foreign;
cxproc_detach :: (h: int) -> int #foreign;
cxproc_quiet :: (h: int) -> int #foreign;
cxproc_pid_signal :: (pid: int, sig: int) -> int #foreign;

cd_atoi :: (s: string) -> int { v := 0; for c: s { if c < '0' || c > '9' { return -1; } v = v * 10 + cast(int) (c - '0'); } return v; }

// run or fork --detach: the same command as a job of its own with a session
// ID given up front; prints the ID and returns. The job's stdout and stderr go
// nowhere, so it holds none of the caller's pipes; its session file is the record.
cd_detach :: (args: [] Args, json: bool) -> int {
  rb: [4096] u8; repo := cl_getenv("CODER_REPO", rb[..]);
  if repo.count == 0 { tool_errln("coder: CODER_REPO is not set: start Coder with coder/tui/coder.sh"); return 2; }
  db: [1100] u8; dir := cs_dir(db[..]);
  if dir.count == 0 { tool_errln("coder: no $HOME"); return 1; }
  ib: [32] u8; id := cs_make_id(cxproc_wall_us(), ib[..]);
  sb: [4200] u8; sn := cd_cat(sb[..], cd_cat(sb[..], 0, repo), "/coder/tui/coder.sh");
  h := cxproc_new();
  if h < 0 { tool_errln("coder: no process slot is free"); return 1; }
  ok := cl_push(h, CL_FIELD_ARG, cast(string) sb[0..<sn]);
  for i: 0..<args_count(args) { v := args_at(args, i); if v != "--detach" && v != "--json" { ok = ok && cl_push(h, CL_FIELD_ARG, v); } }
  ok = ok && cl_push(h, CL_FIELD_ARG, "--session") && cl_push(h, CL_FIELD_ARG, id);
  ok = ok && cxproc_detach(h) == 0 && cxproc_quiet(h) == 0;     // holds none of the caller's pipes: the session file is the record
  if !ok || cxproc_spawn(h) != 0 { r := cxproc_release(h); tool_errln("coder: the job did not start"); return 1; }
  pid := cxproc_pid(h);
  r := cxproc_release(h);
  pb: [1300] u8; pn := cd_cat(pb[..], 0, dir); pn = cd_cat(pb[..], pn, "/"); pn = cd_cat(pb[..], pn, id); pn = cd_cat(pb[..], pn, ".pid");
  tb: [24] u8; w := fs_write(cast(string) pb[0..<pn], cd_itoa(pid, tb[..]));
  if json {
    ob: [256] u8; n := json_raw(ob[..], 0, "{\"id\":"); n = json_write_string(ob[..], n, id);
    n = json_raw(ob[..], n, ",\"pid\":"); n = json_write_int(ob[..], n, pid); n = json_raw(ob[..], n, "}");
    cd_outln(cast(string) ob[0..<n]);
  } else { cd_outln(id); }
  return 0;
}

// A session's sibling file by ID: DIR/ID.ext.
cd_sibling :: (id: string, ext: string, out: [] u8) -> string {
  db: [1100] u8; dir := cs_dir(db[..]);
  n := cd_cat(out, 0, dir); n = cd_cat(out, n, "/"); n = cd_cat(out, n, id); n = cd_cat(out, n, ext);
  return cast(string) out[0..<n];
}

// How many detached jobs on this machine are running: pid files whose process is alive.
cd_jobs_running :: () -> int {
  db: [1100] u8; dir := cs_dir(db[..]);
  if dir.count == 0 || !fs_exists(dir) { return 0; }
  l_b: [1] FsList; n := fs_list(dir, l_b[..]);
  count := 0;
  for i: 0..<n {
    name := fs_entry(l_b[..], i);
    if name.count < 5 || cast(string) name[name.count - 4..<name.count] != ".pid" { continue; }
    pid := cd_job_pid(cast(string) name[0..<name.count - 4]);
    if pid > 0 && cxproc_pid_alive(pid) == 1 { count += 1; }
  }
  return count;
}

// The pid a detached run left, or 0.
cd_job_pid :: (id: string) -> int {
  pb: [1300] u8; fb: [32] u8;
  n := fs_read(cd_sibling(id, ".pid", pb[..]), fb[..]);
  if n <= 0 { return 0; }
  v := cd_atoi(cast(string) fb[0..<n]);
  return ifx v > 0 then v else 0;
}

// Stops a running session: ID.stop, then up to 10 seconds for its end line; a
// detached job that doesn't end is killed, and its end is written here.
cd_cmd_stop :: (id_in: string, json: bool) -> int {
  fb: [4194304] u8; ib: [128] u8;
  text := cd_session_file(id_in, fb[..], ib[..]);
  if text.count == 0 { tool_err("coder: no session "); tool_errln(id_in); return 6; }
  k := 0; while k < ib.count && ib[k] != 0 { k += 1; }
  id := cast(string) ib[0..<k];
  s: [1] CsSummary; ab: [65536] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  cs_read(text, s[..], ar[..]);
  if cast(string) s[0].ending[0..<s[0].nending] != "running" { cd_outln(ifx json then "{\"stopped\":false,\"why\":\"not running\"}" else "Not running."); return 0; }
  sb: [1300] u8; stop_file := cd_sibling(id, ".stop", sb[..]);
  w := fs_write(stop_file, "stop\n");
  for i: 0..<100 {
    x := cxproc_sleep_ms(100);
    t2 := cd_session_file(id, fb[..], ib[..]);
    cs_read(t2, s[..], ar[..]);
    if cast(string) s[0].ending[0..<s[0].nending] != "running" { cd_outln(ifx json then "{\"stopped\":true}" else "Stopped."); return 0; }
  }
  pid := cd_job_pid(id);
  if pid > 0 && cxproc_pid_alive(pid) == 1 {
    x := cxproc_pid_signal(pid, 9);
    pb: [1300] u8; lb: [256] u8;
    n := json_raw(lb[..], 0, "{\"kind\":\"end\",\"ending\":\"stopped\",\"ms\":0,\"steps\":0,\"text\":\"coder stop ended the job's process\"}\n");
    y := fs_append(cd_sibling(id, ".jsonl", pb[..]), cast(string) lb[0..<n]);
    z := fs_remove(stop_file);
    cd_outln(ifx json then "{\"stopped\":true,\"killed\":true}" else "Stopped (the job's process was ended).");
    return 0;
  }
  z := fs_remove(stop_file);
  tool_errln("coder stop: the session did not stop, and it has no job process here to end");
  return 1;
}

tool_main :: () -> int #export_c {
  args_b: [1] Args; args := args_b[..];
  if !args_load(args) { tool_errln("coder: bad arguments"); return 2; }
  verb := cd_positional(args, 0);
  if args_has(args, "--help") || args_has(args, "-h") || verb == "help" { tool_errln(USAGE); return 0; }
  if args_has(args, "--version") || verb == "version" { tool_errln(CODER_VERSION); return 0; }
  json := args_has(args, "--json");
  // another machine: --on ssh:DEST or cloud runs the verb there; a session started that way is followed there
  on := args_value(args, "--on", "");
  if !cd_on_local(on) { return cd_cmd_on(args, verb, on); }
  if verb == "status" || verb == "log" || verb == "stop" || verb == "attach" || verb == "replay" {
    rv := cd_cmd_remote_id(args, cd_positional(args, 1));
    if rv >= 0 { return rv; }
  }
  if verb == "ls" { return cd_cmd_ls(json); }
  if verb == "status" { return cd_cmd_status(cd_positional(args, 1), json); }
  if verb == "log" { return cd_cmd_log(cd_positional(args, 1), json); }
  if verb == "route" { return cd_cmd_route(cd_positional(args, 1), json); }
  if verb == "decide" {
    db: [65536] u8; dok: [1] bool;
    d := cd_decide(cd_positional(args, 1), args_value(args, "--options", ""), args_value(args, "--state", ""), db[..], dok[..]);
    ab: [4096] u8; dar: [1] ClArena; dar[0] = ClArena.{buf = ab[..]};
    if json || dok[0] { cd_outln(d); } else { tool_err("coder decide: "); tool_errln(cl_str(dar[..], d, "error")); }
    return ifx dok[0] then 0 else 1;
  }
  if verb == "stop" { return cd_cmd_stop(cd_positional(args, 1), json); }
  if verb == "mcp" { hp := args_value(args, "--http", ""); if hp.count > 0 { return cd_cmd_mcp_http(cd_atoi(hp)); } return cd_cmd_mcp(); }
  if verb == "acp" { return cd_cmd_acp(args_value(args, "--engine", "")); }
  if verb == "bench" { return cd_cmd_bench(cd_positional(args, 1), json); }
  if verb == "policy" { return cd_cmd_policy(args, json); }
  if verb == "watch" { st := args_value(args, "--stop", ""); return cd_cmd_watch(ifx st.count > 0 then st else cd_positional(args, 1), st.count > 0, args_has(args, "--list")); }
  if verb == "replay" { return cd_cmd_replay(cd_positional(args, 1), json); }
  if verb == "attach" { return cd_cmd_attach(cd_positional(args, 1), cd_positional(args, 2), json); }
  if verb == "trigger" { return cd_cmd_trigger(cd_positional(args, 1), args_value(args, "--thread", ""), args_value(args, "--source", "local"), args_value(args, "--author", "me"), args_has(args, "--to-agent")); }
  if verb == "daemon" { return cd_cmd_daemon(args_value(args, "--name", ""), args_value(args, "--engines", ""), args_value(args, "--root", ""), args_has(args, "--once"), json); }
  if verb == "queue" { qb: [4096] u8; return cd_cmd_queue(cd_positional(args, 1), args_value(args, "--engine", "auto"), args_value(args, "--cwd", cl_getenv("PWD", qb[..])), json); }
  if verb == "jobs" { return cd_cmd_jobs(json); }
  if verb == "remember" || verb == "revise" || verb == "forget" || verb == "recall" {
    days := cd_atoi(args_value(args, "--days", "0")); top := cd_atoi(args_value(args, "--top", "0"));
    if days < 0 || top < 0 { tool_errln("coder: --days and --top take a whole number"); return 2; }
    if verb == "recall" { return cd_cmd_memory(verb, "", cd_positional(args, 1), false, 0, "", top, json); }
    return cd_cmd_memory(verb, cd_positional(args, 1), cd_positional(args, 2), args_has(args, "--project"), days, args_value(args, "--reason", ""), 0, json);
  }
  if verb == "router" { return cd_cmd_router(args_has(args, "--once"), cd_atoi(args_value(args, "--stuck", "1800")), json); }
  profb: [128] u8;
  pl_b: [1] PlRegistry; pwhy := pl_load(pl_b[..], args_value(args, "--profile", cl_getenv("CODER_PROFILE", profb[..])));
  if pwhy.count > 0 { tool_err("coder: "); tool_errln(pwhy); return 2; }
  if verb == "plugins" { return cd_cmd_plugins(pl_b[..], json); }
  if (verb == "run" || verb == "fork") && args_has(args, "--detach") { return cd_detach(args, json); }
  if verb.count > 0 && verb != "run" && verb != "fork" { tool_err("coder: unknown verb "); tool_errln(verb); tool_errln(USAGE); return 2; }
  a_b: [1] App; a := a_b[..];
  q: [1] ClQuery; p: [1] ClProcess;
  dft: [1] DfTable; a[0].df_table = dft[..];
  qline_b: [CL_LINE_MAX] u8; qarena_b: [CL_LINE_MAX] u8; qout_b: [262144] u8; scratch_b: [196608] u8;
  cx_b: [1] CxClient; cxp_b: [1] ClProcess; cxl_b: [CL_LINE_MAX] u8; cxa_b: [262144] u8; cxo_b: [262144] u8;
  a[0].cx = cx_b[..]; a[0].cxp = cxp_b[..]; a[0].cx_line = cxl_b[..]; a[0].cx_arena = cxa_b[..]; a[0].cx_outb = cxo_b[..];
  a[0].cxp[0].handle = -1;
  mcl_b: [CL_LINE_MAX] u8; mca_b: [262144] u8;
  a[0].mc_line = mcl_b[..]; a[0].mc_ar[0] = ClArena.{buf = mca_b[..]};
  a[0].q = q[..]; a[0].p = p[..]; a[0].qline = qline_b[..]; a[0].qarena = qarena_b[..]; a[0].qout = qout_b[..]; a[0].scratch = scratch_b[..];
  a[0].o[0].b = a[0].ob[..];
  // the palette: --theme, else CODER_THEME, else none when NO_COLOR is set, else dark
  thb: [32] u8; nc: [8] u8;
  theme_name := args_value(args, "--theme", cl_getenv("CODER_THEME", thb[..]));
  if theme_name.count == 0 && cl_getenv("NO_COLOR", nc[..]).count > 0 { theme_name = "none"; }
  if theme_name.count > 0 {
    tv := tui_theme_of(theme_name);
    if tv < 0 { tool_errln("coder: --theme is dark, light or none"); return 2; }
    a[0].o[0].theme = tv;
  }
  cb: [4096] u8;
  a[0].cwd = args_value(args, "--cwd", cl_getenv("PWD", cb[..]));
  a[0].model = args_value(args, "--model", "");
  a[0].ask_first = args_has(args, "--ask");
  a[0].coder_tools = args_has(args, "--coder-tools");
  cd_term_reset(a[0].term[..]);
  dl := args_value(args, "--deadline", ""); dv := 0;
  if dl.count > 0 {
    for c: dl { if c < '0' || c > '9' { dv = -1; break; } dv = dv * 10 + cast(int) (c - '0'); }
    if dv <= 0 { tool_errln("coder: --deadline takes whole seconds"); return 2; }
  }
  rto := args_value(args, "--report-to", "");
  if rto.count > 0 {
    rfb: [1300] u8; rpath := cd_sibling(rto, ".jsonl", rfb[..]);
    // a job started a moment ago may not have written its file yet
    for w: 0..<30 { if rpath.count == 0 || fs_exists(rpath) { break; } z := cxproc_sleep_ms(100); }
    if rpath.count == 0 || !fs_exists(rpath) { tool_err("coder: no session "); tool_errln(rto); return 6; }
  }
  a[0].engine = ENGINE_CLAUDE;
  want := args_value(args, "--engine", "");
  if want == "echo" { a[0].engine = ENGINE_ECHO; }
  else if want == "codex" { a[0].engine = ENGINE_CODEX; }
  else if want == "microcoder" || want == "micro" { a[0].engine = ENGINE_MICRO; }
  else if want == "psionic" { a[0].engine = ENGINE_PSIONIC; }
  else if want == "auto" { a[0].auto_engine = true; }
  else if want.count > 0 && want != "claude" { tool_errln("coder: --engine is claude, codex, micro, psionic, echo or auto"); return 2; }
  perr := cd_policy_args(a[0].pol[..], args_value(args, "--allow", ""), args_value(args, "--ceiling", ""), args_value(args, "--root", ""));
  if perr.count > 0 { tool_errln(perr); return 2; }
  cd_policy_resolve(a[0].pol[..], a[0].cwd);
  ef := args_value(args, "--effort", "");
  if ef.count > 0 {
    if ef != "low" && ef != "medium" && ef != "high" { tool_errln("coder: --effort is low, medium or high"); return 2; }
    a[0].neffort = cd_cat(a[0].effort_b[..], 0, ef);
  }
  a[0].model_engine = a[0].engine;

  log_b: [1] CsLog; a[0].log = log_b[..];
  if dl.count > 0 { a[0].log[0].deadline_s = dv; }
  if rto.count > 0 { a[0].log[0].nreport = cd_cat(a[0].log[0].report[..], 0, rto); }
  a[0].pl = pl_b[..];
  task := args_value(args, "--print", "");
  if verb == "run" { task = cd_positional(args, 1); }
  // fork ID "TASK": the parent's turns ride ahead of the first message (chapter 14)
  fork_text: [4194304] u8; pre_b: [32768] u8;
  if verb == "fork" {
    pid := cd_positional(args, 1); task = cd_positional(args, 2);
    if task.count == 0 { tool_errln("coder fork: coder fork ID \"TASK\" [--at TURN]"); return 2; }
    ib: [128] u8;
    parent := cd_session_file(pid, fork_text[..], ib[..]);
    if parent.count == 0 { tool_err("coder: no session "); tool_errln(pid); return 6; }
    k := 0; while k < ib.count && ib[k] != 0 { k += 1; }
    at := cd_atoi(args_value(args, "--at", "0"));
    far: [262144] u8; fa: [1] ClArena; fa[0] = ClArena.{buf = far[..]};
    pn: [1] int;
    kept := cs_turns_text(parent, at, fa[..], pre_b[..], pn[..]);
    if at > kept { tool_err("coder fork: the session has "); tb: [16] u8; tool_err(cd_itoa(kept, tb[..])); tool_errln(" turns"); return 2; }
    a[0].pre = cast(string) pre_b[0..<pn[0]];
    a[0].log[0].nparent = cd_cat(a[0].log[0].parent[..], 0, cast(string) ib[0..<k]);
    a[0].log[0].at = kept;
    // the parent's engine unless --engine
    if want.count == 0 {
      s: [1] CsSummary; sar: [65536] u8; sa: [1] ClArena; sa[0] = ClArena.{buf = sar[..]};
      cs_read(parent, s[..], sa[..]);
      pe := cast(string) s[0].engine[0..<s[0].nengine];
      a[0].engine = ifx pe == "codex" then ENGINE_CODEX else ifx pe == "microcoder" then ENGINE_MICRO else ifx pe == "psionic" then ENGINE_PSIONIC else ifx pe == "echo" then ENGINE_ECHO else ENGINE_CLAUDE;
      a[0].model_engine = a[0].engine;
      want = pe;
    }
  }
  sess := args_value(args, "--session", "");
  if sess.count > 0 { a[0].log[0].nwant = cd_cat(a[0].log[0].want[..], 0, sess); }
  if verb == "run" || verb == "fork" || task.count > 0 || args_has(args, "--print") {
    a[0].plain = true; a[0].cols = 100; a[0].rows = 40;
    a[0].log[0].json = json;
    if task.count == 0 { tool_errln("coder run: needs a task: coder run \"TASK\""); return 2; }
    tui_ed_set(a[0].ed[..], task);
    // No --engine: System One chooses (chapter 13); the session's first lines say what and why.
    rt: [1] CdRoute; routed := verb == "run" && (want.count == 0 || want == "auto");
    if routed { cd_route(task, cl_getenv("PSIONIC_BASE_URL", cb[..]).count > 0, rt[..]); cd_route_apply(a, rt[..], args_has(args, "--effort")); cs_open(a); cs_route(a, rt[..]); cd_hooks(a, "session_start", ""); }
    cd_submit(a);
    if !json { tb: [64] u8; tn := cd_cat(tb[..], 0, "  session "); tn = cd_cat(tb[..], tn, cs_id(a[0].log)); cd_commit(a, TUI_FAINT, cast(string) tb[0..<tn]); }
    if routed && !json { rb: [700] u8; cd_commit(a, TUI_FAINT, cd_route_line(a, rt[..], rb[..])); }
    // `coder stop ID` leaves ID.stop: the run stops as if Esc was pressed
    stb: [1300] u8; stop_file := cs_sibling(a[0].log, ".stop", stb[..]);
    tsb: [1300] u8; turnstop_file := cs_sibling(a[0].log, ".turnstop", tsb[..]);
    next_look := cd_now(a); stopped := false;
    pfb0: [1300] u8; job_pid_file := cs_sibling(a[0].log, ".pid", pfb0[..]);
    goal := args_value(args, "--goal", "");
    goal_turns := cd_atoi(args_value(args, "--goal-turns", "0"));   // a cap the person sets; none by default
    goal_turn := 1;
    for guard: 0..<100000000 {
      if !a[0].running {
        // a goal: a finished turn runs the check; until it passes, its output is the next turn
        if goal.count > 0 && !stopped && a[0].exit == 0 {
          gm: [8192] u8; gn: [1] int;
          if cd_goal_check(a, goal, goal_turn, gm[..], gn[..]) { goal = ""; }
          else if goal_turns > 0 && goal_turn >= goal_turns {
            tb: [24] u8; lb: [128] u8; ln := cd_cat(lb[..], 0, "goal not met after "); ln = cd_cat(lb[..], ln, cd_itoa(goal_turn, tb[..])); ln = cd_cat(lb[..], ln, ifx goal_turn == 1 then " turn" else " turns");
            cd_commit(a, TUI_RED, cast(string) lb[0..<ln]);
            a[0].exit = 1; goal = "";
          } else {
            goal_turn += 1;
            tui_ed_set(a[0].ed[..], cast(string) gm[0..<gn[0]]);
            cd_submit(a);
            continue;
          }
        }
        // a detached job takes messages left by `coder attach` as its next turns
        if sess.count == 0 || stopped { break; }
        mb: [65536] u8; m := cd_msg_next(cs_id(a[0].log), mb[..]);
        if m.count == 0 {
          // about to end: drop the pid file, then look once more, so a message sent meanwhile is not lost
          pt: [32] u8; ptn := fs_read(job_pid_file, pt[..]);
          x := fs_remove(job_pid_file);
          m = cd_msg_next(cs_id(a[0].log), mb[..]);
          if m.count == 0 { break; }
          if ptn > 0 { y := fs_write(job_pid_file, cast(string) pt[0..<ptn]); }
        }
        tui_ed_set(a[0].ed[..], m);
        cd_submit(a);
        continue;
      }
      if a[0].ask { cd_claude_answer(a, 'n'); }
      if a[0].deadline_ms == 0 && a[0].log[0].deadline_s > 0 { a[0].deadline_ms = cd_now(a) + a[0].log[0].deadline_s * 1000; }
      if !stopped && a[0].deadline_ms > 0 && cd_now(a) >= a[0].deadline_ms { a[0].expiring = true; stopped = true; cd_stop(a); }
      if !stopped && stop_file.count > 0 && cd_now(a) >= next_look {
        next_look = cd_now(a) + 200;
        if fs_exists(stop_file) { stopped = true; cd_stop(a); }
        // the watchdog's redirect: end this turn only; its message in the inbox is the next one
        else if !a[0].redirecting && fs_exists(turnstop_file) { x := fs_remove(turnstop_file); a[0].redirecting = true; cd_stop(a); }
      }
      if !cd_poll(a) { x := cxproc_sleep_ms(5); }
    }
    if stop_file.count > 0 { x := fs_remove(stop_file); }
    cd_report_job(a);
    pfb: [1300] u8; pid_file := cs_sibling(a[0].log, ".pid", pfb[..]);
    if sess.count > 0 && pid_file.count > 0 { x := fs_remove(pid_file); }     // a detached job is over
    cd_claude_close(a); cd_codex_close(a); cd_micro_close(a); cd_term_stop(a[0].term[..]);
    return a[0].exit;
  }

  if cxterm_size() < 0 { tool_errln("coder: needs a terminal; use --print \"TASK\" for plain output"); return 2; }
  w := cxterm_watch();
  x := cxterm_keys(1);
  cd_size(a);
  tui_live_pin(a[0].o[..], a[0].lv[..], a[0].rows);    // the composer sits on the bottom rows
  tui_live_width(a[0].lv[..], a[0].cols);
  tui_csi(a[0].o[..], "?2004h");                       // bracketed paste
  tui_csi(a[0].o[..], TUI_KEYS_ON);                     // Shift-Enter distinct from Enter
  hb: [512] u8; hn := cd_cat(hb[..], 0, "Coder ");
  hn = cd_cat(hb[..], hn, CODER_VERSION); hn = cd_cat(hb[..], hn, " · ");
  hn = cd_cat(hb[..], hn, ifx a[0].engine == ENGINE_CLAUDE then "Claude Code" else ifx a[0].engine == ENGINE_CODEX then "Codex" else ifx a[0].engine == ENGINE_MICRO then "Microcoder" else ifx a[0].engine == ENGINE_PSIONIC then "Microcoder on Psionic" else "echo engine (offline)");
  hn = cd_cat(hb[..], hn, " · "); hn = cd_cat(hb[..], hn, a[0].cwd);
  cd_commit(a, TUI_BRIGHT, cast(string) hb[0..<hn]);
  cd_commit(a, TUI_FAINT, "/help for commands.");
  cd_draw(a);
  last_draw := 0;
  while !a[0].quit {
    if cxterm_stopped() != 0 { break; }
    dirty := false;
    if cxterm_resized() != 0 {
      cd_size(a); tui_live_resize(a[0].lv[..], a[0].rows); tui_live_width(a[0].lv[..], a[0].cols); dirty = true;
      if a[0].cmd_h >= 0 { pr := cxproc_pty_resize(a[0].cmd_h, ifx a[0].cols > 8 then a[0].cols - 4 else 80, CD_PTY_ROWS); }
    }
    wait := ifx a[0].running then 10 else 40;
    if cd_read_keys(a, wait) { dirty = true; }
    if a[0].quit { break; }
    if cd_now(a) >= a[0].next_jobs_ms {
      a[0].next_jobs_ms = cd_now(a) + 2000;
      jn := cd_jobs_running();
      if jn != a[0].jobs { a[0].jobs = jn; dirty = true; }
    }
    // a job this session started reports back (--report-to): its message is the next turn
    if !a[0].running && a[0].log[0].nid > 0 && a[0].ed[0].n == 0 && cd_now(a) >= a[0].next_inbox_ms {
      a[0].next_inbox_ms = cd_now(a) + 1000;
      ib2: [65536] u8; im := cd_msg_next(cs_id(a[0].log), ib2[..]);
      if im.count > 0 { tui_ed_set(a[0].ed[..], im); cd_submit(a); dirty = true; }
    }
    if cd_poll(a) { dirty = true; }
    now := cd_now(a);
    if a[0].running && now - last_draw >= 100 { dirty = true; }
    if dirty { cd_draw(a); last_draw = now; }
  }
  if a[0].running { cd_stop(a); }
  cd_claude_close(a); cd_codex_close(a); cd_micro_close(a);
  tui_live_erase(a[0].o[..], a[0].lv[..]);
  tui_csi(a[0].o[..], TUI_KEYS_OFF);
  tui_csi(a[0].o[..], "?2004l"); tui_csi(a[0].o[..], "?25h"); tui_csi(a[0].o[..], "0m");
  cd_flush(a);
  x = cxterm_keys(0);
  return 0;
}
