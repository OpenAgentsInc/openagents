// The codex engine: the installed Codex CLI on its own ChatGPT login,
// driven as `codex app-server` over JSON-RPC by coax/lib/agent/codex, one
// thread for the conversation. Like the claude engine it streams the reply,
// shows each command and its output, and shows file changes as diffs.
// Commands run without asking (approval policy never, full access); with
// --ask each approval comes to the y/a/n prompt instead. Under a policy the
// sandbox follows its ceiling (cd_codex_sandbox): read-only below write.

#load "../../coax/lib/agent/codex/codex.coax";
#load "codex-options.coax";

// This read-only handoff is available in every Codex chat, without requiring
// MCP configuration or --coder-tools. Share the public catalog's contract.
cd_codex_tools :: (out: [] u8) -> string {
  n := json_raw(out, 0, "[{\"type\":\"function\",\"name\":\"coder_session_read\",\"deferLoading\":false,\"description\":");
  n = json_write_string(out, n, CD_MCP_ABOUT[11]);
  n = json_raw(out, n, ",\"inputSchema\":"); n = json_raw(out, n, CD_MCP_SCHEMAS[11]); n = json_raw(out, n, "}]");
  return ifx n < 0 then "[]" else cast(string) out[0..<n];
}

// The thread and its turns: no approvals and full access by default.
cd_codex_settings :: (a: [] App) -> CxSettings {
  st: CxSettings;
  st.cwd = a[0].cwd;
  if a[0].model_engine == ENGINE_CODEX { st.model = a[0].model; }
  st.effort = cd_effort(a);
  launch_effort := ccx_text(a[0].cx_options[0].launch_effort[..]);
  if launch_effort.count > 0 { st.effort = launch_effort; }
  if a[0].cx_options[0].selected {
    st.model = ccx_model(a[0].cx_options[..]);
    st.effort = ccx_effort(a[0].cx_options[..]);
  }
  asked := a[0].ask_first || a[0].pol[0].on || cd_has_hook(a, "tool_call");
  // the sandbox follows the ceiling (ceiling.coax): a read ceiling is a read-only sandbox
  st.sandbox = cd_codex_sandbox(a[0].pol[..], asked);
  if asked { st.approval_policy = "untrusted"; st.ask_person = true; }
  else { st.approval_policy = "never"; }
  st.dynamic_tools = cd_codex_tools(a[0].cx_tools[..]);
  return st;
}

cd_codex_reader_answer :: (a: [] App) {
  out: [CSR_OUTPUT_MAX] u8;
  got := csr_request_in(cast(string) a[0].ask_input[0..<a[0].nask_input], a[0].cwd, out[..]);
  cx_tool_answer(a[0].cx, got, cl_raw(got, "error").count == 0);
}

// Client-executed tools must pass Coder's own hooks and existing policy:
// the reader keeps the shared MCP tool's conservative unknown-tool/run
// effect. Foreign-history files are outside the session's room. An ask in
// a job with no person is refused by the existing job approval path.
cd_codex_tool_call :: (a: [] App, ev: CxEvent) {
  c := a[0].cx;
  if a[0].engine != ENGINE_CODEX || !a[0].running || a[0].stopping { cx_tool_answer(c, "Coder's Codex turn is inactive.", false); return; }
  name := cd_cx_str(a, ev.params, "tool");
  if name != "coder_session_read" || cd_cx_str(a, ev.params, "namespace").count > 0 { cx_tool_answer(c, "Unknown Coder tool.", false); return; }
  thread := cd_cx_str(a, ev.params, "threadId"); turn := cd_cx_str(a, ev.params, "turnId");
  if (thread.count > 0 && thread != cx_thread_id(c)) || (turn.count > 0 && turn != cx_turn_id(c)) { cx_tool_answer(c, "Coder's Codex turn is inactive.", false); return; }
  args := cl_raw(ev.params, "arguments");
  if args.count == 0 || args.count > a[0].ask_input.count { cx_tool_answer(c, "Invalid or overlong reader arguments.", false); return; }
  hw: [400] u8;
  if !cd_hooks_run(a, "tool_call", "", name, args, hw[..]) { cx_tool_answer(c, "A Coder tool hook refused this call.", false); return; }
  if a[0].pol[0].on {
    why: [256] u8; verdict := cd_policy_tool(a[0].pol[..], name, false, why[..]);
    k := 0; while k < why.count && why[k] != 0 { k += 1; }
    cd_approval_note(a, name, cd_effect_of(name), false, verdict, cast(string) why[0..<k]);
    if verdict == CD_VERDICT_REFUSE { cx_tool_answer(c, cast(string) why[0..<k], false); return; }
    // An external history read cannot be silently approved through roots.
  }
  a[0].nask_input = cd_cat(a[0].ask_input[..], 0, args);
  if a[0].ask_first || a[0].pol[0].on {
    a[0].nask = cd_cat(a[0].ask_text[..], 0, "Allow coder_session_read to read local Claude history?");
    a[0].ask = true; return;
  }
  cd_codex_reader_answer(a);
}

// Opening the Codex tab resolves its configuration and catalog without
// sending a prompt. All later messages remain turns on that same thread.
cd_codex_open :: (a: [] App) {
  if a[0].cx_live { return; }
  a[0].cx_options[0].failed = false;
  a[0].cx_options[0].resolved = false;
  ok := ccx_keep(a[0].cx_options[0].actual_model[..], "");
  ok = ccx_keep(a[0].cx_options[0].actual_effort[..], "");
  fresh: CxClient; a[0].cx[0] = fresh;
  cx_init(a[0].cx, a[0].cx_line, a[0].cx_arena, a[0].cx_outb);
  l: [1] CxLaunch; l[0].cwd = a[0].cwd;
  why := cx_start(a[0].cx, a[0].cxp, l[0]);
  if why.count > 0 {
    a[0].cx_options[0].failed = true;
    if a[0].running { cd_finish(a, END_FAILED, why); }
    else { cd_commit_prefixed(a, TUI_RED, "  Codex: ", "  ", why); }
    return;
  }
  a[0].cx_live = true; a[0].cx_ready = false;
  r := cx_initialize(a[0].cx, "openagents-coder", "Coder", CODER_VERSION);
}

cd_codex_send :: (a: [] App, msg: string) {
  none: [1] string;
  if a[0].cx_live && a[0].cx_ready {
    r := cx_turn_start(a[0].cx, msg, none[0..<0], cd_codex_settings(a));
    return;
  }
  a[0].npending = cd_cat(a[0].pending[..], 0, msg);
  cd_codex_open(a);
}

cd_codex_close :: (a: [] App) {
  if !a[0].cx_live { return; }
  cx_close_process(a[0].cxp);
  a[0].cx_live = false; a[0].cx_ready = false;
}

cd_codex_row :: (a: [] App, out: [] u8) -> string {
  st := cd_codex_settings(a);
  return ccx_row(a[0].cx_options[..], st.model, st.effort, out);
}

cd_codex_options_show :: (a: [] App, models: bool) {
  o := a[0].cx_options[..]; b: [512] u8;
  cd_commit_prefixed(a, TUI_DIM, "  ", "  ", cd_codex_row(a, b[..]));
  st := cd_codex_settings(a);
  model := st.model;
  if model.count == 0 { model = ccx_text(o[0].actual_model[..]); }
  for k: 0..<o[0].n {
    if !models && ccx_id(o, k) != model { continue; }
    n := cd_cat(b[..], 0, ccx_id(o, k));
    n = cd_cat(b[..], n, " · reasoning: ");
    if o[0].nlevels[k] == 0 { n = cd_cat(b[..], n, "default"); }
    for j: 0..<o[0].nlevels[k] {
      if j > 0 { n = cd_cat(b[..], n, ", "); }
      n = cd_cat(b[..], n, ccx_text(o[0].levels[k][j][..]));
    }
    def := ccx_text(o[0].defaults[k][..]);
    if def.count > 0 { n = cd_cat(b[..], n, " (default "); n = cd_cat(b[..], n, def); n = cd_cat(b[..], n, ")"); }
    cd_commit_prefixed(a, TUI_DIM, "  ", "    ", cast(string) b[0..<n]);
  }
  cd_commit_prefixed(a, TUI_FAINT, "  ", "  ", "Change with /model MODEL [EFFORT] or /effort LEVEL. Applies to the next Codex message in this Coder session; switching agents keeps the selection.");
  if o[0].catalog_failed { cd_commit(a, TUI_FAINT, "  Codex's model catalog is unavailable. /model retries it."); }
  else if !o[0].listed { cd_commit(a, TUI_FAINT, "  Codex's model catalog is loading. /model shows it when ready."); }
  else if ccx_find(o, model) < 0 && !models { cd_commit(a, TUI_FAINT, "  This model has no catalog entry; /model lists the available models and levels."); }
  if o[0].n == CCX_MODELS { cd_commit(a, TUI_FAINT, "  Showing the first 64 models."); }
}

// These commands are handled here, never sent as prompts to an engine.
cd_codex_options_cmd :: (a: [] App, msg: string) -> bool {
  models := msg == "/model" || rt_has_prefix(msg, "/model ");
  effort := msg == "/effort" || rt_has_prefix(msg, "/effort ");
  if !models && !effort { return false; }
  if a[0].engine != ENGINE_CODEX { cd_commit(a, TUI_DIM, "  /model and /effort configure Codex. Switch with /engine codex or Shift-Tab."); return true; }
  cd_codex_open(a);
  if models && a[0].cx_live && a[0].cx_options[0].catalog_failed {
    cd_codex_catalog_start(a);
  }
  start := ifx models then 6 else 7;
  s := start; while s < msg.count && msg[s] == ' ' { s += 1; }
  e := s; while e < msg.count && msg[e] != ' ' { e += 1; }
  if s == msg.count {
    cd_codex_options_show(a, models);
    a[0].cx_options[0].show_list = models && !a[0].cx_options[0].listed && a[0].cx_live;
    return true;
  }
  if !a[0].cx_ready || !a[0].cx_options[0].listed { cd_commit(a, TUI_DIM, "  Wait for Codex's configuration and model catalog, then try again."); return true; }
  if a[0].running { cd_commit(a, TUI_DIM, "  Stop the current turn before changing Codex's model or reasoning."); return true; }
  value := cast(string) msg[s..<e];
  while e < msg.count && msg[e] == ' ' { e += 1; }
  model := value; level := cast(string) msg[e..<msg.count];
  if effort {
    if level.count > 0 { cd_commit(a, TUI_RED, "  Usage: /effort LEVEL"); return true; }
    level = value;
    st := cd_codex_settings(a); model = st.model;
    if model.count == 0 { model = ccx_text(a[0].cx_options[0].actual_model[..]); }
  }
  why := ccx_choose(a[0].cx_options[..], model, level);
  if why.count > 0 { cd_commit_prefixed(a, TUI_RED, "  ", "  ", why); return true; }
  cd_codex_options_show(a, false);
  return true;
}

CODEX_HELP :: "/model [MODEL [EFFORT]]  Codex's current settings and available models; select a model and optional reasoning level\n/effort [LEVEL]          Codex's supported reasoning levels; change the level for the next message\n                        Selections last for this Coder session and survive switching agents. Codex's --effort also accepts xhigh, max and ultra when supported.";

cd_codex_catalog_start :: (a: [] App) {
  o := a[0].cx_options[..]; o[0].n = 0; o[0].pages = 0;
  o[0].listed = false; o[0].catalog_failed = false;
  for k: 0..<CCX_MODELS { o[0].nlevels[k] = 0; o[0].defaults[k][0] = 0; }
  r := cx_model_list(a[0].cx, "");
}

cd_cx_str :: (a: [] App, json: string, path: string) -> string { return cl_str(a[0].cx[0].ar[..], json, path); }

// Whether Codex's codexErrorInfo names the model provider not answering: a
// connection, a stream, a server error, an overload or a usage limit, all of
// which clear on their own. The value is "name" or {"name":{...}}.
CD_CX_PROVIDER :: [7] string.["usageLimitExceeded", "httpConnectionFailed", "responseStreamConnectionFailed", "internalServerError", "responseStreamDisconnected", "responseTooManyFailedAttempts", "serverOverloaded"];
cd_cx_provider :: (info: string) -> bool {
  at := 0;
  while at < info.count && (info[at] == ' ' || info[at] == '{') { at += 1; }
  if at >= info.count || info[at] != '"' { return false; }
  e := at + 1; while e < info.count && info[e] != '"' { e += 1; }
  name := cast(string) info[at + 1..<e];
  for v: CD_CX_PROVIDER { if name == v { return true; } }
  return false;
}

#test "codex: provider errors from codexErrorInfo" {
  #assert cd_cx_provider("\"serverOverloaded\"");
  #assert cd_cx_provider("{\"httpConnectionFailed\":{\"httpStatusCode\":502}}");
  #assert !cd_cx_provider("\"contextWindowExceeded\"");
  #assert !cd_cx_provider("{\"badRequest\":null}");
  #assert !cd_cx_provider("");
}

// A command as the person would type it: the first command action's text,
// else the command without its "/bin/zsh -lc" wrapper.
cd_codex_command :: (a: [] App, item: string) -> string {
  cmd := cd_cx_str(a, item, "commandActions.0.command");
  if cmd.count > 0 { return cmd; }
  return cd_cx_str(a, item, "command");
}

cd_codex_started :: (a: [] App, item: string) {
  ty := cd_cx_str(a, item, "type");
  lb: [1024] u8; label := "";
  if ty == "agentMessage" {
    // a new message after earlier text or tools: its own paragraph
    if a[0].nrep > 0 { cd_reply_commit(a, true); a[0].rep_lines = 0; a[0].nrep = 0; a[0].rep_done = 0; }
    return;
  }
  if ty == "commandExecution" { label = cd_label(a, "Bash", cd_codex_command(a, item), lb[..]); }
  else if ty == "fileChange" {
    changes := cl_raw(item, "changes");
    n := cl_count(changes);
    path := cd_cx_str(a, item, "changes.0.path");
    kind := cd_cx_str(a, item, "changes.0.kind.type");
    label = cd_label(a, ifx kind == "add" then "Write" else ifx kind == "delete" then "Delete" else "Edit", path, lb[..]);
    if n > 1 { tb: [16] u8; ln := label.count; ln = cd_cat(lb[..], ln, " and "); ln = cd_cat(lb[..], ln, cd_itoa(n - 1, tb[..])); ln = cd_cat(lb[..], ln, " more"); label = cast(string) lb[0..<ln]; }
  }
  else if ty == "mcpToolCall" {
    nb: [256] u8; nn := cd_cat(nb[..], 0, cd_cx_str(a, item, "server")); nn = cd_cat(nb[..], nn, "."); nn = cd_cat(nb[..], nn, cd_cx_str(a, item, "tool"));
    label = cd_label(a, cast(string) nb[0..<nn], "", lb[..]);
  }
  else if ty == "dynamicToolCall" { label = cd_label(a, cd_cx_str(a, item, "tool"), "", lb[..]); }
  else if ty == "webSearch" { label = cd_label(a, "Search", cd_cx_str(a, item, "query"), lb[..]); }
  else if ty == "imageView" { label = cd_label(a, "View", cd_cx_str(a, item, "path"), lb[..]); }
  else { return; }
  cd_reply_commit(a, true); a[0].rep_lines = 0; a[0].nrep = 0; a[0].rep_done = 0;
  cd_tool_row(a, label);
  a[0].steps += 1;
}

cd_codex_completed :: (a: [] App, item: string) {
  ty := cd_cx_str(a, item, "type");
  status := cd_cx_str(a, item, "status");
  if ty == "commandExecution" {
    out := cd_cx_str(a, item, "aggregatedOutput");
    exit := cl_int(item, "exitCode");
    bad := status == "failed" || status == "declined" || (exit.ok && exit.value != 0);
    if status == "declined" { out = "declined"; }
    cd_result_line(a, out, bad);
    return;
  }
  if ty == "fileChange" {
    if status != "completed" { cd_result_line(a, ifx status == "declined" then "declined" else "the change did not apply", true); return; }
    changes := cl_raw(item, "changes");
    n := cl_count(changes);
    for i: 0..<n {
      ch := cl_json(changes, cl_item(changes, i));
      // copies: the arena is reused by each lookup
      pb: [1024] u8; pn := cd_cat(pb[..], 0, cd_cx_str(a, ch, "path"));
      kb: [16] u8; kn := cd_cat(kb[..], 0, cd_cx_str(a, ch, "kind.type"));
      df_unified(a, cast(string) pb[0..<pn], cast(string) kb[0..<kn], cd_cx_str(a, ch, "diff"));
    }
    return;
  }
  if ty == "mcpToolCall" || ty == "dynamicToolCall" {
    cd_result_line(a, ifx status == "failed" then cd_cx_str(a, item, "error.message") else status, status == "failed");
  }
}

// One poll of the server; true when something changed.
cd_codex_poll :: (a: [] App) -> bool {
  if !a[0].cx_live || a[0].ask { return false; }
  c := a[0].cx; p := a[0].cxp;
  changed := false;
  none: [1] string;
  for guard: 0..<64 {
    ev := cx_poll(c, p, 0);
    if ev.kind == CxEventKind.idle { break; }
    changed = true;
    if ev.kind == CxEventKind.end || ev.kind == CxEventKind.failed {
      eb: [2048] u8; why := cx_error(c);
      if why.count == 0 { why = cl_stderr(p, eb[..]); }
      if why.count == 0 { why = "Codex exited."; }
      wb: [2600] u8; wn := cd_cat(wb[..], 0, why);
      cd_codex_close(a);
      a[0].cx_options[0].failed = true;
      if a[0].running && a[0].engine == ENGINE_CODEX { cd_finish(a, END_FAILED, cast(string) wb[0..<wn]); }
      else if a[0].engine == ENGINE_CODEX { cd_commit_prefixed(a, TUI_RED, "  Codex: ", "  ", cast(string) wb[0..<wn]); }
      return true;
    }
    if ev.kind == CxEventKind.initialized {
      // A restarted server may expose a different catalog.
      cd_codex_catalog_start(a);
      r := cx_thread_start(c, cd_codex_settings(a));
      continue;
    }
    if ev.kind == CxEventKind.answered && ev.of == CX_MODEL_LIST {
      ccx_page(a[0].cx_options[..], c[0].ar[..], ev.result);
      cursor := cd_cx_str(a, ev.result, "nextCursor");
      if cursor.count > 0 && a[0].cx_options[0].n < CCX_MODELS && a[0].cx_options[0].pages < CCX_MODELS { r := cx_model_list(c, cursor); }
      else {
        a[0].cx_options[0].listed = true;
        if a[0].cx_options[0].show_list && a[0].engine == ENGINE_CODEX { cd_codex_options_show(a, true); }
        a[0].cx_options[0].show_list = false;
      }
      continue;
    }
    if ev.kind == CxEventKind.answered && ev.of == CX_THREAD_START {
      ccx_resolved(a[0].cx_options[..], c[0].ar[..], ev.result);
      cs_cx_model(a);
      a[0].cx_ready = true;
      if a[0].npending > 0 && a[0].running {
        r := cx_turn_start(c, cast(string) a[0].pending[0..<a[0].npending], none[0..<0], cd_codex_settings(a));
        a[0].npending = 0;
      }
      continue;
    }
    if ev.kind == CxEventKind.refused {
      mb: [1024] u8; mn := cd_cat(mb[..], 0, ev.message);
      if ev.of == CX_MODEL_LIST {
        a[0].cx_options[0].catalog_failed = true;
        a[0].cx_options[0].show_list = false;
        cd_commit_prefixed(a, TUI_RED, "  Codex model catalog: ", "  ", cast(string) mb[0..<mn]);
        continue;
      }
      if ev.of == CX_THREAD_START { cd_codex_close(a); }
      if ev.of == CX_THREAD_START { a[0].cx_options[0].failed = true; }
      if a[0].running && ev.of != CX_TURN_INTERRUPT { cd_finish(a, END_FAILED, cast(string) mb[0..<mn]); a[0].stopping = false; }
      else if ev.of == CX_THREAD_START { cd_commit_prefixed(a, TUI_RED, "  Codex: ", "  ", cast(string) mb[0..<mn]); }
      if !a[0].cx_live { return true; }
      continue;
    }
    if ev.kind == CxEventKind.tool_call {
      cd_codex_tool_call(a, ev);
      if a[0].ask { return true; }
      continue;
    }
    if ev.kind == CxEventKind.approval {
      lb: [1024] u8; what := "more permissions for this turn"; effect := CD_EFFECT_RUN; inside := true;
      if ev.of == CX_ASK_EXEC || ev.of == CX_ASK_EXEC_V1 {
        cmd := cd_cx_str(a, ev.params, "command");
        if cmd.count == 0 { cmd = cd_cx_str(a, ev.params, "command.0"); }
        what = cd_label(a, "Bash", cmd, lb[..]);
        cw := cd_cx_str(a, ev.params, "cwd");
        if cw.count > 0 { inside = cd_inside(a[0].pol[..], a[0].cwd, cw); }
      } else if ev.of == CX_ASK_PATCH || ev.of == CX_ASK_PATCH_V1 {
        what = "these file changes"; effect = CD_EFFECT_WRITE;
        gr := cd_cx_str(a, ev.params, "grantRoot");
        if gr.count > 0 { inside = cd_inside(a[0].pol[..], a[0].cwd, gr); }
      }
      hw: [400] u8; for i: 0..<hw.count { hw[i] = 0; }
      if !cd_hooks_run(a, "tool_call", "", what, ev.params, hw[..]) { cx_approve(a[0].cx, false); continue; }
      if !a[0].pol[0].on && !a[0].ask_first { cx_approve(a[0].cx, true); continue; }   // asked only for the hooks
      if a[0].pol[0].on {
        pw: [256] u8;
        verdict := cd_policy_decide(a[0].pol[..], effect, inside, pw[..]);
        k := 0; while k < pw.count && pw[k] != 0 { k += 1; }
        cd_approval_note(a, what, effect, inside, verdict, cast(string) pw[0..<k]);
        if verdict != CD_VERDICT_ASK { cx_approve(a[0].cx, verdict == CD_VERDICT_RUN); continue; }
      }
      a[0].nask = cd_cat(a[0].ask_text[..], 0, "Allow ");
      a[0].nask = cd_cat(a[0].ask_text[..], a[0].nask, what);
      a[0].nask = cd_cat(a[0].ask_text[..], a[0].nask, "?");
      a[0].ask = true;
      return true;      // no more polls until answered: a poll would decline it
    }
    if ev.kind != CxEventKind.notification { continue; }
    if a[0].engine != ENGINE_CODEX || !a[0].running { continue; }   // late lines after a stop
    m := ev.method;
    if m == "thread/tokenUsage/updated" {
      if cx_thread_id(c).count > 0 && cx_turn_id(c).count > 0 && cd_cx_str(a, ev.params, "threadId") == cx_thread_id(c) && cd_cx_str(a, ev.params, "turnId") == cx_turn_id(c) {
        cs_cx_usage(a, cl_raw(ev.params, "tokenUsage"));
      }
      continue;
    }
    if m == "item/agentMessage/delta" {
      cd_reply_add(a, cd_cx_str(a, ev.params, "delta"));
      cd_reply_commit(a, false);
      continue;
    }
    if m == "item/started" { cd_codex_started(a, cl_raw(ev.params, "item")); continue; }
    if m == "item/completed" { cd_codex_completed(a, cl_raw(ev.params, "item")); continue; }
    if m == "error" {
      retry := cl_bool(ev.params, "willRetry");
      if !(retry.ok && retry.value) { a[0].nerr = cd_cat(a[0].err[..], 0, cd_cx_str(a, ev.params, "error.message")); }
      continue;
    }
    if m == "turn/completed" {
      st := cd_cx_str(a, ev.params, "turn.status");
      if st == "completed" { cd_finish(a, END_FINISHED, ""); }
      else if st == "interrupted" { cd_finish(a, END_STOPPED, ""); }
      else {
        if cd_cx_provider(cl_raw(ev.params, "turn.error.codexErrorInfo")) { a[0].ncause = cd_cat(a[0].cause[..], 0, "provider"); }
        why := cd_cx_str(a, ev.params, "turn.error.message");
        if why.count == 0 && a[0].nerr > 0 { why = cast(string) a[0].err[0..<a[0].nerr]; }
        if why.count == 0 { why = "Codex ended the turn with an error."; }
        wb: [1024] u8; wn := cd_cat(wb[..], 0, why);
        cd_finish(a, END_FAILED, cast(string) wb[0..<wn]);
      }
      a[0].stopping = false; a[0].nerr = 0;
      continue;
    }
  }
  return changed;
}

cd_codex_answer :: (a: [] App, c: int) {
  if a[0].cx[0].asking == CX_ASK_TOOL && (c == 'y' || c == 'Y' || c == 'a' || c == 'A') { cd_codex_reader_answer(a); return; }
  cx_approve(a[0].cx, c == 'y' || c == 'Y' || c == 'a' || c == 'A');
}

// Esc: interrupt the turn; asked twice, or no turn to interrupt, end the session.
cd_codex_stop :: (a: [] App) {
  if a[0].ask { cx_approve(a[0].cx, false); a[0].ask = false; }
  if a[0].cx_live && a[0].cx_ready && !a[0].stopping && cx_interrupt(a[0].cx) != 0 {
    a[0].stopping = true;
    a[0].stop_ms = cd_now(a);
    return;           // the turn ends with turn/completed, status interrupted
  }
  cd_codex_close(a);
  a[0].stopping = false;
  cd_finish(a, END_STOPPED, "");
}
