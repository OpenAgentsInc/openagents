// Credential handles (chapter 20). A credential is a named secret kept on
// this machine, one file each:
//
//   ~/.openagents/coder/credentials/NAME.env   VAR=value, mode 600, in a mode 700 folder
//
// A job names handles, never values. The daemon starts a job with a handle's
// variable in that session's environment only when its grant lists the
// handle, and the session writes the value as [credential] wherever it would
// reach its log, its --json output or a report.

CR_DIR :: "/.openagents/coder/credentials";
CR_MIN :: 8;           // shorter values would hide ordinary words in the log
CR_MAX :: 8;           // handles a job may name
CR_VALUE :: 4096;

// Letters, digits, - and _, at most 64.
cr_name_ok :: (name: string) -> bool {
  if name.count == 0 || name.count > 64 { return false; }
  for c: name {
    ok := (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_';
    if !ok { return false; }
  }
  return true;
}

// An environment variable name: A-Z, 0-9 and _, not starting with a digit.
cr_var_ok :: (v: string) -> bool {
  if v.count == 0 || v.count > 128 || (v[0] >= '0' && v[0] <= '9') { return false; }
  for c: v { if !((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') { return false; } }
  return true;
}

cr_dir :: (out: [] u8) -> string {
  hb: [1024] u8; home := cd_state_home(hb[..]);
  if home.count == 0 { return ""; }
  n := cd_cat(out, 0, home); n = cd_cat(out, n, CR_DIR);
  return cast(string) out[0..<n];
}

cr_file :: (name: string, out: [] u8) -> string {
  db: [1100] u8; dir := cr_dir(db[..]);
  if dir.count == 0 { return ""; }
  n := cd_cat(out, 0, dir); n = cd_cat(out, n, "/"); n = cd_cat(out, n, name); n = cd_cat(out, n, ".env");
  return cast(string) out[0..<n];
}

// chmod where the system keeps it: /bin/chmod, else the first on PATH (NixOS has no /bin/chmod).
cr_chmod_program :: () -> string { return ifx fs_exists("/bin/chmod") then "/bin/chmod" else "chmod"; }

cr_chmod :: (mode: string, path: string) -> bool {
  ob: [256] u8; ok: [1] bool;
  av := [3] string.[cr_chmod_program(), mode, path];
  x := rt_run(av[..], ob[..], ok[..]);
  return ok[0];
}

// A handle's VAR=value line copied into out; "" when it is missing or malformed.
cr_entry :: (name: string, out: [] u8) -> string {
  if !cr_name_ok(name) { return ""; }
  pb: [1300] u8; path := cr_file(name, pb[..]);
  if path.count == 0 { return ""; }
  n := fs_read(path, out);
  while n > 0 && (out[n - 1] == 10 || out[n - 1] == 13) { n -= 1; }
  if n <= 0 { return ""; }
  eq := 0; while eq < n && out[eq] != '=' { eq += 1; }
  if eq == 0 || eq >= n - 1 || !cr_var_ok(cast(string) out[0..<eq]) { return ""; }
  return cast(string) out[0..<n];
}

// The variable a VAR=value entry sets.
cr_var_of :: (entry: string) -> string {
  eq := 0; while eq < entry.count && entry[eq] != '=' { eq += 1; }
  return cast(string) entry[0..<eq];
}

// Why a job's handles are refused, or "" when the grant holds them all and each exists.
cr_admit :: (grant: string, wanted: string) -> string {
  if wanted.count == 0 { return ""; }
  at := 0; k := 0;
  while at <= wanted.count {
    e := at; while e < wanted.count && wanted[e] != ',' { e += 1; }
    nm := cast(string) wanted[at..<e];
    if nm.count > 0 {
      k += 1;
      if k > CR_MAX { return "it names more than 8 credentials"; }
      if grant.count == 0 || !dm_listed(grant, nm) { return "a credential it names is outside this machine's grant"; }
      eb: [CR_VALUE] u8;
      if cr_entry(nm, eb[..]).count == 0 { return "a credential it names is not stored on this machine"; }
    }
    at = e + 1;
  }
  return "";
}

// coder credential add NAME VAR | ls | rm NAME. The value comes from stdin,
// so it never sits in a command line, the shell history or a process list.
cd_cmd_credential :: (sub: string, name: string, v: string, json: bool) -> int {
  db: [1100] u8; dir := cr_dir(db[..]);
  if dir.count == 0 { tool_errln("coder credential: no $HOME"); return 1; }
  if sub == "add" {
    if !cr_name_ok(name) || !cr_var_ok(v) { tool_errln("coder credential add NAME VAR < file   (NAME: letters, digits, - and _; VAR: an environment variable such as GITHUB_TOKEN)"); return 2; }
    val: [CR_VALUE] u8; n := 0;
    for guard: 0..<CR_VALUE + 2 {
      c := cxterm_byte(-1);
      if c == -2 { break; }
      if c < 0 { continue; }
      if n >= val.count { tool_errln("coder credential: the value is over 4096 bytes"); return 1; }
      val[n] = cast,trunc(u8) c; n += 1;
    }
    while n > 0 && (val[n - 1] == 10 || val[n - 1] == 13) { n -= 1; }
    for i: 0..<n { if val[i] == 10 || val[i] == 13 { for j: 0..<n { val[j] = 0; } tool_errln("coder credential: the value has a line break; store one line"); return 1; } }
    if n < CR_MIN { for j: 0..<n { val[j] = 0; } tool_errln("coder credential: the value is shorter than 8 characters, too short to hide in logs"); return 1; }
    hb: [1024] u8; home := cd_state_home(hb[..]);
    mb: [1100] u8;
    x := fs_mkdir(cast(string) mb[0..<cd_cat(mb[..], cd_cat(mb[..], 0, home), "/.openagents")]);
    x = fs_mkdir(cast(string) mb[0..<cd_cat(mb[..], cd_cat(mb[..], 0, home), "/.openagents/coder")]);
    x = fs_mkdir(dir);
    if !cr_chmod("700", dir) { tool_errln("coder credential: could not make the folder private"); return 1; }
    pb: [1300] u8; path := cr_file(name, pb[..]);
    tb: [1310] u8; tn := cd_cat(tb[..], cd_cat(tb[..], 0, path), ".new");
    tmp := cast(string) tb[0..<tn];
    body: [CR_VALUE + 200] u8;
    k := cd_cat(body[..], 0, v); k = cd_cat(body[..], k, "="); k = cd_cat(body[..], k, cast(string) val[0..<n]); k = cd_cat(body[..], k, "\n");
    // the file is empty while its mode is set, so the value is never readable by others
    good := fs_write(tmp, "") && cr_chmod("600", tmp) && fs_write(tmp, cast(string) body[0..<k]) && fs_rename(tmp, path);
    for j: 0..<val.count { val[j] = 0; }
    for j: 0..<body.count { body[j] = 0; }
    if !good { y := fs_remove(tmp); tool_errln("coder credential: could not store it"); return 1; }
    if json { ob: [512] u8; m := json_raw(ob[..], 0, "{\"name\":"); m = json_write_string(ob[..], m, name); m = json_raw(ob[..], m, ",\"var\":"); m = json_write_string(ob[..], m, v); m = json_raw(ob[..], m, ",\"stored\":true}"); cd_outln(cast(string) ob[0..<m]); }
    else {
      ob: [1024] u8; m := cd_cat(ob[..], 0, "Stored "); m = cd_cat(ob[..], m, name); m = cd_cat(ob[..], m, " as "); m = cd_cat(ob[..], m, v);
      m = cd_cat(ob[..], m, ". A job gets it only from a daemon whose grant lists it: coder daemon --credentials "); m = cd_cat(ob[..], m, name);
      cd_outln(cast(string) ob[0..<m]);
    }
    return 0;
  }
  if sub == "rm" {
    if !cr_name_ok(name) { tool_errln("coder credential rm NAME"); return 2; }
    pb: [1300] u8; path := cr_file(name, pb[..]);
    if !fs_exists(path) { tool_errln("coder credential: no such credential"); return 1; }
    // overwrite before removing, so the value does not stay in the file's blocks
    w := fs_write(path, "                                                                ");
    if !fs_remove(path) { tool_errln("coder credential: could not remove it"); return 1; }
    if json { cd_outln("{\"removed\":true}"); } else { ob: [256] u8; m := cd_cat(ob[..], 0, "Removed "); m = cd_cat(ob[..], m, name); cd_outln(cast(string) ob[0..<m]); }
    return 0;
  }
  if sub == "ls" || sub.count == 0 {
    l_b: [1] FsList; l := l_b[..];
    n := fs_list(dir, l);
    o: [65536] u8; m := ifx json then json_raw(o[..], 0, "[") else 0;
    rows := 0;
    for i: 0..<n {
      f := fs_entry(l, i);
      if f.count < 5 || cast(string) f[f.count - 4..<f.count] != ".env" { continue; }
      nm := cast(string) f[0..<f.count - 4];
      eb: [CR_VALUE] u8; e := cr_entry(nm, eb[..]);
      if e.count == 0 { continue; }
      vr := cr_var_of(e);
      if json {
        m = json_raw(o[..], m, ifx rows > 0 then "," else ""); m = json_raw(o[..], m, "{\"name\":"); m = json_write_string(o[..], m, nm);
        m = json_raw(o[..], m, ",\"var\":"); m = json_write_string(o[..], m, vr); m = json_raw(o[..], m, "}");
      } else { m = cd_cat(o[..], m, nm); m = cd_cat(o[..], m, "  "); m = cd_cat(o[..], m, vr); m = cd_cat(o[..], m, "\n"); }
      for j: 0..<eb.count { eb[j] = 0; }
      rows += 1;
    }
    if json { m = json_raw(o[..], m, "]"); cd_outln(cast(string) o[0..<m]); }
    else if rows == 0 { cd_outln("No credentials. To store one: coder credential add NAME VAR < file"); }
    else { while m > 0 && o[m - 1] == 10 { m -= 1; } cd_outln(cast(string) o[0..<m]); }
    return 0;
  }
  tool_errln("coder credential add NAME VAR | ls | rm NAME");
  return 2;
}

#test "credential: names, variables and the grant" {
  #assert cr_name_ok("gh-bot_1");
  #assert !cr_name_ok("../x");
  #assert !cr_name_ok("");
  #assert cr_var_ok("GITHUB_TOKEN");
  #assert !cr_var_ok("1X");
  #assert !cr_var_ok("lower");
  #assert cr_var_of("GH=abc=d") == "GH";
  #assert cr_admit("", "") == "";
  #assert cr_admit("", "gh") == "a credential it names is outside this machine's grant";
  #assert cr_admit("a,b", "c") == "a credential it names is outside this machine's grant";
}
