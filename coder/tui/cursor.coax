// The cursor and antigravity engines: the installed Cursor CLI on the person's own login,
// driven as `agent acp`, and Google's Antigravity CLI driven as `agy acp`
// (coax/lib/agent/engine/antigravity.coax), both by the shared ACP engine
// (coax/lib/agent/engine/cursor.coax), one session for the conversation. The
// engine starts the agent, logs in, opens or resumes the session and holds
// the first message; each event then comes here, where it is printed and
// where Coder's settings, permissions, plans and questions are answered. The reply streams, tool calls show as rows, and
// file changes show as diffs. Tools run without asking; with --ask each
// permission comes to the y/a/n prompt. Under a policy the tool kind is
// the effect (read, search, fetch, edit, delete, move, execute).

// The ACP engines: Cursor and Antigravity share the one ACP engine (a[0].cue).
cd_is_acp :: (e: int) -> bool { return e == ENGINE_CURSOR || e == ENGINE_ANTIGRAVITY; }
// The engine whose agent the ACP engine holds.
cd_cue_engine :: (a: [] App) -> int { return ifx agy_is(a[0].cue) then ENGINE_ANTIGRAVITY else ENGINE_CURSOR; }
// "  Cursor: " or "  Antigravity: ", for a red line.
cd_cue_prefix :: (a: [] App, out: [] u8) -> string { n := cd_cat(out, 0, "  "); n = cd_cat(out, n, cue_title(a[0].cue)); n = cd_cat(out, n, ": "); return cast(string) out[0..<n]; }

cd_cursor_open :: (a: [] App) {
  x := a[0].cue;
  agy := a[0].engine == ENGINE_ANTIGRAVITY;
  if x[0].live && agy_is(x) != agy { cue_close(x); }       // the other agent's session: a new process
  if x[0].live { return; }
  prog: [4096] u8; program := ifx agy then agy_program(prog[..]) else cue_program(prog[..]);
  if program.count == 0 {
    if agy {
      if a[0].running { cd_finish(a, END_FAILED, AGY_MISSING); } else { cd_commit_prefixed(a, TUI_RED, "  Antigravity: ", "  ", AGY_MISSING); }
      return;
    }
    why := "Cursor's agent was not found. Install it from cursor.com/install, or put cursor-agent on PATH.";
    if a[0].running { cd_finish(a, END_FAILED, why); } else { cd_commit(a, TUI_RED, "  Cursor: the agent was not found."); }
    return;
  }
  // a fork resumes the parent's session (Cursor's session/load, Antigravity's session/resume) until the agent has been asked to
  cue_resume(x, cast(string) a[0].cursor_resume[0..<a[0].ncursor_resume]);
  why := "";
  if agy { why = agy_launch(x, program, a[0].cwd, "Coder", CODER_VERSION); }
  else { cue_agent(x, cu_agent_cursor()); why = cue_launch(x, program, a[0].cwd, "Coder", CODER_VERSION); }
  if why.count > 0 {
    pb: [40] u8;
    if a[0].running { cd_finish(a, END_FAILED, why); } else { cd_commit_prefixed(a, TUI_RED, cd_cue_prefix(a, pb[..]), "  ", why); }
    return;
  }
}

// At once on an open session with no setting unanswered, else owed until it is.
cd_cursor_send :: (a: [] App, msg: string) {
  if cue_send(a[0].cue, msg) { return; }
  cd_cursor_open(a);
}

cd_cursor_close :: (a: [] App) { cue_close(a[0].cue); }

cd_cursor_lines :: (text: string) -> int {
  if text.count == 0 { return 0; }
  n := 1;
  for c: text { if c == 10 { n += 1; } }
  if text[text.count - 1] == 10 { n -= 1; }
  return n;
}

cd_cursor_unified :: (out: [] u8, old: string, newt: string) -> int {
  tb: [16] u8;
  n := cd_cat(out, 0, "@@ -1,"); n = cd_cat(out, n, cd_itoa(cd_cursor_lines(old), tb[..]));
  n = cd_cat(out, n, " +1,"); n = cd_cat(out, n, cd_itoa(cd_cursor_lines(newt), tb[..])); n = cd_cat(out, n, " @@\n");
  at := 0;
  while at < old.count && n + 4 < out.count {
    e := at; while e < old.count && old[e] != 10 { e += 1; }
    n = cd_cat(out, n, "-"); n = cd_cat(out, n, cast(string) old[at..<e]); n = cd_cat(out, n, "\n");
    at = ifx e < old.count then e + 1 else e;
  }
  at = 0;
  while at < newt.count && n + 4 < out.count {
    e := at; while e < newt.count && newt[e] != 10 { e += 1; }
    n = cd_cat(out, n, "+"); n = cd_cat(out, n, cast(string) newt[at..<e]); n = cd_cat(out, n, "\n");
    at = ifx e < newt.count then e + 1 else e;
  }
  return n;
}

cd_cursor_show_diff :: (a: [] App, path: string, old: string, newt: string) {
  if old.count == 0 { df_unified(a, path, "add", newt); return; }
  if newt.count == 0 { df_unified(a, path, "delete", ""); return; }
  if old.count > 6000 || newt.count > 6000 {
    nb: [1200] u8; nn := cd_cat(nb[..], 0, "Edited "); nn = cd_cat(nb[..], nn, df_rel(a, path));
    cd_commit(a, TUI_DIM, cast(string) nb[0..<nn]);
    return;
  }
  buf: [14000] u8; n := cd_cursor_unified(buf[..], old, newt);
  df_unified(a, path, "update", cast(string) buf[0..<n]);
}

cd_cursor_path_ok :: (a: [] App, path: string) -> bool {
  if path.count == 0 { return true; }
  return cd_inside(a[0].pol[..], a[0].cwd, path);
}

cd_cursor_inside :: (a: [] App, tool: string) -> bool {
  if cu_tool_outside(tool, a[0].cu[0].ar[..]) { return false; }
  locs := cl_raw(tool, "locations");
  n := cl_count(locs);
  for i: 0..<n {
    item := cl_json(locs, cl_item(locs, i));
    if !cd_cursor_path_ok(a, cl_str(a[0].cu[0].ar[..], item, "path")) { return false; }
  }
  raw := cl_raw(tool, "rawInput");
  if !cd_cursor_path_ok(a, cl_str(a[0].cu[0].ar[..], raw, "path")) { return false; }
  if !cd_cursor_path_ok(a, cl_str(a[0].cu[0].ar[..], raw, "file_path")) { return false; }
  if !cd_cursor_path_ok(a, cl_str(a[0].cu[0].ar[..], raw, "cwd")) { return false; }
  if agy_is(a[0].cue) {
    if agy_outside(tool, a[0].cu[0].ar[..]) { return false; }
    keys := AGY_PATH_KEYS;
    for key: keys { if !cd_cursor_path_ok(a, cl_str(a[0].cu[0].ar[..], raw, key)) { return false; } }
  }
  return true;
}

cd_cursor_note :: (a: [] App, text: string) {
  cd_commit(a, TUI_FAINT, text);
  cs_text(a, "note", "text", text);
}

cd_cursor_remember :: (a: [] App) {
  id := cu_session_id(a[0].cu);
  if id.count == 0 || a[0].nengine_sid > 0 { return; }
  a[0].nengine_sid = cd_cat(a[0].engine_sid[..], 0, id);
  cs_engine_session(a, cd_engine_name(cd_cue_engine(a)), id);
}

cd_cursor_configure :: (a: [] App, result: string) {
  if agy_is(a[0].cue) {
    missed := agy_configure(a[0].cue, result, ifx a[0].model_engine == ENGINE_ANTIGRAVITY then a[0].model else "", cd_effort(a));
    if (missed & AGY_MODEL_NOT_APPLIED) != 0 { cd_cursor_note(a, "  --model was not applied: this Antigravity session did not advertise it."); }
    if (missed & AGY_EFFORT_NOT_APPLIED) != 0 { cd_cursor_note(a, "  --effort was not applied: this Antigravity session did not advertise that thought level."); }
    return;
  }
  a[0].cue[0].hold = 0;
  model := ifx a[0].model_engine == ENGINE_CURSOR then a[0].model else "";
  if model.count > 0 {
    id := cu_config_id(result, "model", model, a[0].cu[0].ar[..]);
    if id.count == 0 { cd_cursor_note(a, "  --model was not applied: this Cursor session did not advertise it."); }
    else { cue_set(a[0].cue, id, model); }
  }
  effort := cd_effort(a);
  if effort.count > 0 {
    id := cu_config_id(result, "thought_level", effort, a[0].cu[0].ar[..]);
    if id.count == 0 { cd_cursor_note(a, "  --effort was not applied: this Cursor session did not advertise a thought level."); }
    else { cue_set(a[0].cue, id, effort); }
  }
}

cd_cursor_prompt_pending :: (a: [] App) { cue_owed(a[0].cue, a[0].running); }

cd_cursor_content :: (a: [] App, update: string) {
  content := cl_raw(update, "content");
  n := cl_count(content);
  status := cl_str(a[0].cu[0].ar[..], update, "status");
  shown := false;
  for i: 0..<n {
    item := cl_json(content, cl_item(content, i));
    ty := cl_str(a[0].cu[0].ar[..], item, "type");
    if ty == "diff" {
      path := cl_str(a[0].cu[0].ar[..], item, "path");
      old := cl_str(a[0].cu[0].ar[..], item, "oldText");
      newt := cl_str(a[0].cu[0].ar[..], item, "newText");
      cd_cursor_show_diff(a, path, old, newt);
      shown = true;
    } else if ty == "content" {
      text := cl_str(a[0].cu[0].ar[..], item, "content.text");
      if text.count > 0 { cd_result_line(a, text, status == "failed"); shown = true; }
    }
  }
  if !shown && status == "failed" { cd_result_line(a, "failed", true); }
}

cd_cursor_answer :: (a: [] App, c: int) {
  if a[0].cu[0].asking == CU_ASK_PLAN { cu_plan(a[0].cu, c == 'y' || c == 'Y' || c == 'a' || c == 'A'); return; }
  id := cu_choice(a[0].cu, c);
  // Antigravity offers allow and deny only: "from now on" is allowed this once
  if id.count == 0 && (c == 'a' || c == 'A') && agy_is(a[0].cue) { id = cu_allow_option(a[0].cu); }
  if id.count == 0 { cu_decline(a[0].cu); } else { cu_permit(a[0].cu, id); }
}

cd_cursor_stop :: (a: [] App) {
  if a[0].ask {
    if a[0].cu[0].asking == CU_ASK_PERMISSION { cu_respond(a[0].cu, "{\"outcome\":{\"outcome\":\"cancelled\"}}"); }
    else { cu_decline(a[0].cu); }
    a[0].ask = false;
  }
  if a[0].cue[0].live && a[0].cue[0].ready && !a[0].stopping && a[0].cu[0].session_n > 0 {
    cue_cancel(a[0].cue);
    a[0].stopping = true;
    a[0].stop_ms = cd_now(a);
    return;
  }
  cd_cursor_close(a);
  a[0].stopping = false;
  cd_finish(a, END_STOPPED, "");
}

cd_cursor_finish_turn :: (a: [] App, result: string) {
  reason := cl_str(a[0].cu[0].ar[..], result, "stopReason");
  rb: [64] u8; rn := cd_cat(rb[..], 0, reason);
  reason = cast(string) rb[0..<rn];
  a[0].stopping = false;
  if agy_is(a[0].cue) { cs_acp_usage(a, "antigravity", cl_raw(result, "usage")); }
  failed := ifx agy_is(a[0].cue) then agy_turn_failed(a[0].cue, result) else "";
  if failed.count > 0 {
    if agy_provider(failed) { a[0].ncause = cd_cat(a[0].cause[..], 0, "provider"); }
    fb: [1100] u8; fn := cd_cat(fb[..], 0, "Antigravity: "); fn = cd_cat(fb[..], fn, failed);
    cd_finish(a, END_FAILED, cast(string) fb[0..<fn]); return;
  }
  if reason == "end_turn" || reason == "end" || reason.count == 0 { cd_finish(a, END_FINISHED, ""); return; }
  if reason == "cancelled" && cue_stalled(a[0].cue) { sb: [256] u8; cd_finish(a, END_FAILED, cue_stall_why(a[0].cue, sb[..])); return; }
  if reason == "cancelled" { cd_finish(a, END_STOPPED, ""); return; }
  wb: [160] u8; wn := cd_cat(wb[..], 0, cue_title(a[0].cue)); wn = cd_cat(wb[..], wn, " ended the turn: "); wn = cd_cat(wb[..], wn, reason);
  cd_finish(a, END_FAILED, cast(string) wb[0..<wn]);
}

// One poll of the CLI; true when something changed.
// The stall watchdog (cue_watch) on Coder's clock: what it did is a note; a closed agent fails the turn.
cd_cursor_watch :: (a: [] App) -> bool {
  x := a[0].cue;
  w := cue_watch(x, cd_now(a));
  if w == CUE_WATCH_NONE { return false; }
  nb: [300] u8; nn := cd_cat(nb[..], 0, "  "); wb: [256] u8; nn = cd_cat(nb[..], nn, cue_watch_notice(x, w, wb[..]));
  cd_cursor_note(a, cast(string) nb[0..<nn]);
  if w == CUE_WATCH_ENDED && a[0].running { a[0].stopping = false; cd_finish(a, END_FAILED, cue_stall_why(x, wb[..])); }
  return true;
}

cd_cursor_poll :: (a: [] App) -> bool {
  x := a[0].cue;
  if cd_cursor_watch(a) && !x[0].live { return true; }
  if !x[0].live || a[0].ask { return false; }
  c := a[0].cu;
  changed := false;
  one: [1] CuEvent;
  for guard: 0..<64 {
    // the engine's part of each event is done when it comes back: logged in, the session opened,
    // a setting's answer counted, a replayed request answered (none), a dead agent closed
    cue_poll(x, one[..]);
    ev := one[0];
    if ev.kind == CuEventKind.idle { break; }
    changed = true;
    if ev.kind == CuEventKind.end || ev.kind == CuEventKind.failed {
      own := cd_cue_engine(a);
      pb: [40] u8; prefix := cd_cue_prefix(a, pb[..]);
      why := cue_why(x);
      wb: [2600] u8; wn := cd_cat(wb[..], 0, why);
      if why.count == 0 { wn = cd_cat(wb[..], 0, cue_title(x)); wn = cd_cat(wb[..], wn, " exited."); }
      cd_cursor_close(a);
      if a[0].running && a[0].engine == own { cd_finish(a, END_FAILED, cast(string) wb[0..<wn]); }
      else if a[0].engine == own { cd_commit_prefixed(a, TUI_RED, prefix, "  ", cast(string) wb[0..<wn]); }
      return true;
    }
    if ev.kind == CuEventKind.none && agy_is(x) { u := cue_spent(x); if u.count > 0 { cs_acp_usage(a, "antigravity", u); } }   // a part the watchdog continued
    if ev.kind == CuEventKind.none || ev.kind == CuEventKind.initialized { continue; }
    if ev.kind == CuEventKind.answered && ev.of == CU_AUTHENTICATE { a[0].ncursor_resume = 0; continue; }
    if ev.kind == CuEventKind.refused && ev.of == CU_AUTHENTICATE {
      cd_cursor_close(a);
      if a[0].running { cd_finish(a, END_FAILED, "Cursor is not logged in. Run agent login."); }
      else { cd_commit(a, TUI_RED, "  Cursor is not logged in. Run agent login."); }
      return true;
    }
    if ev.kind == CuEventKind.refused && (ev.of == CU_SESSION_LOAD || ev.of == CU_SESSION_RESUME) {
      a[0].ncursor_resume = 0;
      nb: [128] u8; nn := cd_cat(nb[..], 0, "  The "); nn = cd_cat(nb[..], nn, cue_title(x)); nn = cd_cat(nb[..], nn, " session could not be resumed. Starting a new one.");
      cd_cursor_note(a, cast(string) nb[0..<nn]);
      continue;
    }
    if ev.kind == CuEventKind.refused {
      mb: [1024] u8; mn := cd_cat(mb[..], 0, ev.message);
      if agy_is(x) && agy_signed_out(ev.message) { mn = cd_cat(mb[..], 0, AGY_SIGNED_OUT); }
      if agy_is(x) && a[0].running && ev.of == CU_SESSION_PROMPT && agy_provider(ev.message) { a[0].ncause = cd_cat(a[0].cause[..], 0, "provider"); }
      if ev.of == CU_SESSION_SET_CONFIG || ev.of == CU_SESSION_SET_MODEL || ev.of == CU_SESSION_SET_MODE {
        nb: [128] u8; nn := cd_cat(nb[..], 0, "  A "); nn = cd_cat(nb[..], nn, cue_title(x)); nn = cd_cat(nb[..], nn, " setting was not applied.");
        cd_cursor_note(a, cast(string) nb[0..<nn]); cd_cursor_prompt_pending(a); continue;
      }
      if a[0].running && ev.of == CU_SESSION_PROMPT { cd_finish(a, END_FAILED, cast(string) mb[0..<mn]); a[0].stopping = false; }
      else if ev.of == CU_SESSION_NEW {
        pb: [40] u8; prefix := cd_cue_prefix(a, pb[..]);
        cd_cursor_close(a);
        if a[0].running { cd_finish(a, END_FAILED, cast(string) mb[0..<mn]); }
        else { cd_commit_prefixed(a, TUI_RED, prefix, "  ", cast(string) mb[0..<mn]); }
        return true;
      }
      continue;
    }
    if ev.kind == CuEventKind.answered && (ev.of == CU_SESSION_NEW || ev.of == CU_SESSION_LOAD || ev.of == CU_SESSION_RESUME) {
      a[0].ncursor_resume = 0;
      cd_cursor_remember(a);
      cd_cursor_configure(a, ev.result);
      cd_cursor_prompt_pending(a);
      continue;
    }
    if ev.kind == CuEventKind.answered && (ev.of == CU_SESSION_SET_CONFIG || ev.of == CU_SESSION_SET_MODEL || ev.of == CU_SESSION_SET_MODE) {
      cd_cursor_prompt_pending(a);
      continue;
    }
    if ev.kind == CuEventKind.answered && ev.of == CU_SESSION_PROMPT && a[0].running && a[0].engine == cd_cue_engine(a) {
      cd_cursor_finish_turn(a, ev.result);
      continue;
    }
    if ev.kind == CuEventKind.question {
      qb: [400] u8; qn := cd_cat(qb[..], 0, cl_str(c[0].ar[..], ev.params, "questions.0.prompt"));
      if qn == 0 { qn = cd_cat(qb[..], 0, cue_title(x)); qn = cd_cat(qb[..], qn, " asked a question"); }
      qn = cd_cat(qb[..], qn, " (skipped)");
      cd_commit(a, TUI_FAINT, cast(string) qb[0..<qn]);
      cu_question(c, true);
      continue;
    }
    if ev.kind == CuEventKind.plan {
      if !a[0].ask_first && !a[0].pol[0].on { cu_plan(c, true); continue; }
      a[0].nask = cd_cat(a[0].ask_text[..], 0, "Accept this plan?");
      a[0].ask = true;
      return true;
    }
    if ev.kind == CuEventKind.permission {
      tool := cl_raw(ev.params, "toolCall");
      kb: [32] u8; kn := cd_cat(kb[..], 0, cl_str(c[0].ar[..], tool, "kind"));
      tb: [400] u8; tn := cd_cat(tb[..], 0, cl_str(c[0].ar[..], tool, "title"));
      title := cast(string) tb[0..<tn];
      if tn == 0 { title = cast(string) kb[0..<kn]; }
      effect := cu_kind_effect(cast(string) kb[0..<kn]);
      inside := cd_cursor_inside(a, tool);
      if !a[0].pol[0].on && !a[0].ask_first {
        id := cu_allow_option(c);
        if id.count == 0 { cu_decline(c); cd_approval_note(a, title, effect, inside, CD_VERDICT_REFUSE, "no allow option was offered"); }
        else { cu_permit(c, id); cd_approval_note(a, title, effect, inside, CD_VERDICT_RUN, "the session trusts this agent"); }
        continue;
      }
      if a[0].pol[0].on {
        pw: [256] u8;
        verdict := cd_policy_decide(a[0].pol[..], effect, inside, pw[..]);
        k := 0; while k < pw.count && pw[k] != 0 { k += 1; }
        cd_approval_note(a, title, effect, inside, verdict, cast(string) pw[0..<k]);
        if verdict == CD_VERDICT_REFUSE { cu_decline(c); continue; }
        if verdict == CD_VERDICT_RUN {
          id := cu_allow_option(c);
          if id.count == 0 { cu_decline(c); } else { cu_permit(c, id); }
          continue;
        }
      }
      a[0].nask = cd_cat(a[0].ask_text[..], 0, "Allow ");
      a[0].nask = cd_cat(a[0].ask_text[..], a[0].nask, title);
      a[0].nask = cd_cat(a[0].ask_text[..], a[0].nask, "?");
      a[0].ask = true;
      return true;
    }
    if ev.kind != CuEventKind.notification { continue; }
    if a[0].engine != cd_cue_engine(a) || !a[0].running || x[0].replay { continue; }
    update := cl_raw(ev.params, "update");
    kind := cl_str(c[0].ar[..], update, "sessionUpdate");
    if ev.method == "cursor/task" {
      db: [400] u8; dn := cd_cat(db[..], 0, "  task: "); dn = cd_cat(db[..], dn, cl_str(c[0].ar[..], ev.params, "description"));
      cd_commit(a, TUI_FAINT, cast(string) db[0..<dn]);
      continue;
    }
    if kind == "agent_thought_chunk" || kind == "user_message_chunk" { continue; }
    if kind == "agent_message_chunk" {
      text := cl_str(c[0].ar[..], update, "content.text");
      if text.count > 0 { cd_reply_add(a, text); cd_reply_commit(a, false); if agy_is(x) { agy_chunk(x, text); } }
      continue;
    }
    if kind == "tool_call" {
      title := cl_str(c[0].ar[..], update, "title");
      if title.count == 0 { title = cl_str(c[0].ar[..], update, "kind"); }
      cd_reply_commit(a, true); a[0].rep_lines = 0; a[0].nrep = 0; a[0].rep_done = 0;
      cd_commit_prefixed(a, TUI_DIM, "  ⏺ ", "    ", title);
      a[0].ncur = cd_cat(a[0].cur[..], 0, title);
      a[0].steps += 1;
      continue;
    }
    if kind == "tool_call_update" { cd_cursor_content(a, update); continue; }
  }
  return changed;
}

#test "Shift-Tab passes Antigravity between Cursor and Microcoder; both are the ACP engine" {
  #assert cd_next_engine(ENGINE_CODEX) == ENGINE_CURSOR && cd_next_engine(ENGINE_CURSOR) == ENGINE_ANTIGRAVITY;
  #assert cd_next_engine(ENGINE_ANTIGRAVITY) == ENGINE_MICRO && cd_next_engine(ENGINE_MICRO) == ENGINE_CLAUDE;
  #assert cd_is_acp(ENGINE_CURSOR) && cd_is_acp(ENGINE_ANTIGRAVITY) && !cd_is_acp(ENGINE_CODEX) && !cd_is_acp(ENGINE_MICRO);
  #assert cd_engine_name(ENGINE_ANTIGRAVITY) == "antigravity" && ca_engine(4) == ENGINE_ANTIGRAVITY;
}
