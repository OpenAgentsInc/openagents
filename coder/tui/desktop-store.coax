// Coder Desktop's chat store, read and written from the terminal (GitHub #13707).
// Coder Desktop (apps/coder-desktop) keeps its chats in
// ~/Library/Application Support/Coder/chats: index.json, the list (CoderStore
// in App.swift), and one ID.json a chat (coder_page_save in page.coax: cost,
// budget, the /goal state and the turns). This file is the pure part: it
// reads and rewrites those texts with no files, clocks or sockets, so
// `coax test` checks every operation. coder/tui/desktop.coax is the
// `coder desktop` verb that moves the bytes.
//
// The rules mirror the app's: a pin takes the next order after the highest,
// an unpin renumbers the rest from 0, a rename collapses whitespace and keeps
// at most 120 bytes, a budget below the cost clears an approval, approving
// above budget resumes a budget-limited goal, and a goal is saved only with
// an objective. A chat file is rewritten with its other members as they were.
#load "../../coax/lib/json/json.coax";

DK_FOREMAN_ID :: "foreman";            // Foreman.chatID: the Foreman's own chat, never listed
DK_BUDGET_DEFAULT :: 50000000;         // CP_BUDGET_DEFAULT: $50 a chat
DK_TITLE_MAX :: 120;                   // CoderStore.cleanTitle's bytes
DK_GOAL_TEXT :: 2048;                  // CP_GOAL_TEXT
DK_GOAL_NONE :: 0; DK_GOAL_ACTIVE :: 1; DK_GOAL_PAUSED :: 2; DK_GOAL_COMPLETE :: 3; DK_GOAL_BLOCKED :: 4; DK_GOAL_BUDGET_LIMITED :: 5;

// ---- scanning: top-level members and elements, without a node per value ----
// A chat file can hold megabytes of tool output; these walk it by byte range.

DkItem :: struct { ok: bool; kf: int; kt: int; vf: int; vt: int; next: int; }

dk_space :: (c: u8) -> bool { return c == 32 || c == 9 || c == 10 || c == 13; }
dk_ws :: (t: string, i: int) -> int { j := i; while j < t.count && dk_space(t[j]) { j += 1; } return j; }
// The end (one past the closing quote) of the string that starts at i, or -1.
dk_str_end :: (t: string, i: int) -> int {
  j := i + 1;
  while j < t.count {
    if t[j] == '\\' { j += 2; continue; }
    if t[j] == '"' { return j + 1; }
    j += 1;
  }
  return -1;
}
// The end of the value that starts at i, or -1 when it is cut short.
dk_end :: (t: string, i: int) -> int {
  if i >= t.count { return -1; }
  c := t[i];
  if c == '"' { return dk_str_end(t, i); }
  if c == '{' || c == '[' {
    depth := 0; j := i;
    while j < t.count {
      d := t[j];
      if d == '"' { e := dk_str_end(t, j); if e < 0 { return -1; } j = e; continue; }
      if d == '{' || d == '[' { depth += 1; }
      else if d == '}' || d == ']' { depth -= 1; if depth == 0 { return j + 1; } }
      j += 1;
    }
    return -1;
  }
  j := i;
  while j < t.count && t[j] != ',' && t[j] != '}' && t[j] != ']' && t[j] != ':' && !dk_space(t[j]) { j += 1; }
  return ifx j > i then j else -1;
}
// Just past the opening c ('{' or '[') of t, or -1.
dk_open :: (t: string, c: u8) -> int { i := dk_ws(t, 0); return ifx i < t.count && t[i] == c then i + 1 else -1; }
// The member (keyed) or element after i; ok false at the close or on bad text.
dk_next :: (t: string, i: int, keyed: bool) -> DkItem {
  r: DkItem;
  if i < 0 { return r; }
  j := dk_ws(t, i);
  if j < t.count && t[j] == ',' { j = dk_ws(t, j + 1); }
  if j >= t.count || t[j] == '}' || t[j] == ']' { return r; }
  if keyed {
    if t[j] != '"' { return r; }
    ke := dk_str_end(t, j); if ke < 0 { return r; }
    r.kf = j + 1; r.kt = ke - 1;
    j = dk_ws(t, ke);
    if j >= t.count || t[j] != ':' { return r; }
    j = dk_ws(t, j + 1);
  }
  ve := dk_end(t, j); if ve < 0 { return r; }
  r.vf = j; r.vt = ve; r.next = ve; r.ok = true;
  return r;
}
// The raw value of member key in object t, or "" when it has none.
dk_get :: (t: string, key: string) -> string {
  i := dk_open(t, '{');
  for guard: 0..<1000000 {
    m := dk_next(t, i, true);
    if !m.ok { return ""; }
    if t[m.kf..<m.kt] == key { return t[m.vf..<m.vt]; }
    i = m.next;
  }
  return "";
}
// How many elements array t holds.
dk_count :: (t: string) -> int {
  i := dk_open(t, '['); n := 0;
  for guard: 0..<10000000 { m := dk_next(t, i, false); if !m.ok { return n; } n += 1; i = m.next; }
  return n;
}
// Element k of array t, raw, or "".
dk_elem :: (t: string, k: int) -> string {
  i := dk_open(t, '['); n := 0;
  for guard: 0..<10000000 {
    m := dk_next(t, i, false);
    if !m.ok { return ""; }
    if n == k { return t[m.vf..<m.vt]; }
    n += 1; i = m.next;
  }
  return "";
}
// The whole-number part of a raw number ("1763500000.25" is 1763500000), or fallback.
dk_int :: (raw: string, fallback: int) -> int {
  if raw.count == 0 { return fallback; }
  i := 0; neg := false;
  if raw[0] == '-' { neg = true; i = 1; }
  v := 0; seen := false;
  while i < raw.count && raw[i] >= '0' && raw[i] <= '9' {
    if v > 900719925474099 { return fallback; }
    v = v * 10 + cast(int) (raw[i] - '0'); i += 1; seen = true;
  }
  if !seen { return fallback; }
  return ifx neg then -v else v;
}
// A raw string value unescaped into out; "" when raw is not a string or does not fit.
dk_text :: (raw: string, out: [] u8) -> string {
  if raw.count < 2 || raw[0] != '"' { return ""; }
  n := jv_unescape(raw[1..<raw.count - 1], out);
  return ifx n < 0 then "" else cast(string) out[0..<n];
}
dk_copy :: (dst: [] u8, s: string) -> int { n := 0; for c: s { if n < dst.count { dst[n] = c; n += 1; } } return n; }
dk_cat :: (out: [] u8, n: int, s: string) -> int { m := n; for c: s { if m < out.count { out[m] = c; m += 1; } } return m; }
dk_lower :: (c: u8) -> u8 { return ifx c >= 'A' && c <= 'Z' then c + 32 else c; }
// Whether hay holds needle, ASCII case folded; an empty needle is in everything.
dk_has :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  if needle.count > hay.count { return false; }
  for i: 0..<hay.count - needle.count + 1 {
    same := true;
    for j: 0..<needle.count { if dk_lower(hay[i + j]) != dk_lower(needle[j]) { same = false; break; } }
    if same { return true; }
  }
  return false;
}
// At most max bytes of s, never cutting a UTF-8 character.
dk_clip :: (s: string, max: int) -> string {
  if s.count <= max { return s; }
  k := max;
  while k > 0 && (s[k] & 0xc0) == 0x80 { k -= 1; }
  return s[0..<k];
}
// CoderStore.cleanTitle: whitespace runs become one space, ends trimmed, at most 120 bytes.
dk_clean_title :: (raw: string, out: [] u8) -> string {
  n := 0; gap := false;
  for c: raw {
    if dk_space(c) { gap = n > 0; continue; }
    if gap { if n < out.count { out[n] = ' '; n += 1; } gap = false; }
    if n < out.count { out[n] = c; n += 1; }
  }
  return dk_clip(cast(string) out[0..<n], DK_TITLE_MAX);
}
// Whole microdollars as a JSON number of dollars: 1500000 is 1.5.
dk_usd_json :: (micros: int, out: [] u8) -> string {
  tb: [24] u8; m := ifx micros < 0 then -micros else micros;
  n := ifx micros < 0 then dk_cat(out, 0, "-") else 0;
  n = dk_cat(out, n, dk_num(m / 1000000, tb[..]));
  frac := m % 1000000;
  if frac > 0 {
    d: [6] u8; f := frac;
    for i: 0..<6 { d[5 - i] = cast,trunc(u8) (f % 10) + '0'; f /= 10; }
    k := 6; while k > 0 && d[k - 1] == '0' { k -= 1; }
    n = dk_cat(out, n, "."); n = dk_cat(out, n, cast(string) d[0..<k]);
  }
  return cast(string) out[0..<n];
}
// Microdollars for people: "$1.50".
dk_usd :: (micros: int, out: [] u8) -> string {
  tb: [24] u8; m := ifx micros < 0 then 0 else micros;
  cents := (m + 5000) / 10000;
  n := dk_cat(out, 0, "$"); n = dk_cat(out, n, dk_num(cents / 100, tb[..]));
  n = dk_cat(out, n, ifx cents % 100 < 10 then ".0" else "."); n = dk_cat(out, n, dk_num(cents % 100, tb[..]));
  return cast(string) out[0..<n];
}
dk_num :: (v: int, out: [] u8) -> string {
  if v == 0 { out[0] = '0'; return cast(string) out[0..<1]; }
  neg := v < 0; m := ifx neg then -v else v; d: [24] u8; k := 0;
  while m > 0 { d[k] = cast,trunc(u8) (m % 10) + '0'; m /= 10; k += 1; }
  n := 0; if neg { out[0] = '-'; n = 1; }
  for i: 0..<k { out[n] = d[k - 1 - i]; n += 1; }
  return cast(string) out[0..<n];
}
// Dollars as written on the command line ("5", "2.50", "1e1") in microdollars; -1 when it is not a positive amount.
dk_usd_micros :: (text: string) -> int {
  if text.count == 0 || text.count > 24 { return -1; }
  whole := 0; frac := 0; places := 0; dot := false; seen := false;
  for c: text {
    if c == '.' { if dot { return -1; } dot = true; continue; }
    if c < '0' || c > '9' { return -1; }
    seen = true;
    if dot { if places < 6 { frac = frac * 10 + cast(int) (c - '0'); places += 1; } }
    else { if whole > 100000000 { return -1; } whole = whole * 10 + cast(int) (c - '0'); }
  }
  if !seen { return -1; }
  while places < 6 { frac *= 10; places += 1; }
  v := whole * 1000000 + frac;
  return ifx v > 0 then v else -1;
}
// Seconds since 1970 with microseconds, the way Swift's JSONEncoder writes a Date's Double.
dk_time_json :: (wall_us: int, out: [] u8) -> string {
  tb: [24] u8; n := dk_cat(out, 0, dk_num(wall_us / 1000000, tb[..]));
  f := wall_us % 1000000; d: [6] u8;
  for i: 0..<6 { d[5 - i] = cast,trunc(u8) (f % 10) + '0'; f /= 10; }
  n = dk_cat(out, n, "."); n = dk_cat(out, n, cast(string) d[..]);
  return cast(string) out[0..<n];
}
// A version 4 UUID, lower case, from 16 random bytes.
dk_uuid :: (b: [] u8, out: [] u8) -> string {
  hx := "0123456789abcdef"; n := 0;
  for i: 0..<16 {
    v := b[i];
    if i == 6 { v = (v & 0x0f) | 0x40; }
    if i == 8 { v = (v & 0x3f) | 0x80; }
    if i == 4 || i == 6 || i == 8 || i == 10 { out[n] = '-'; n += 1; }
    out[n] = hx[(v >> 4) & 15]; out[n + 1] = hx[v & 15]; n += 2;
  }
  return cast(string) out[0..<n];
}
// A chat id Coder Desktop could have made, safe as a file name: letters, digits and -, at most 64.
dk_id_ok :: (id: string) -> bool {
  if id.count == 0 || id.count > 64 { return false; }
  for c: id { if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_') { return false; } }
  return true;
}

// ---- the list: index.json ----

DkChat :: struct {
  id: [96] u8; id_n: int;
  title: [256] u8; title_n: int;
  folder: [1024] u8; folder_n: int;
  managed: [64] u8; managed_n: int;
  wt_path: [1024] u8; wt_path_n: int;       // worktree_path: the chat's own worktree (GitHub #13758), "" for none
  wt_branch: [128] u8; wt_branch_n: int;    // worktree_branch
  repo: [1024] u8; repo_n: int;             // repo_root: the main checkout it came from
  created: [40] u8; created_n: int;   // raw number; 0 when the entry has none
  updated: [40] u8; updated_n: int;   // raw number
  renamed: bool;
  pinned: int = -1;                   // order in Pinned, or -1
}
DkIndex :: struct { chats: [] DkChat; n: int; full: bool; }

dk_id :: (x: [] DkIndex, i: int) -> string { return cast(string) x[0].chats[i].id[0..<x[0].chats[i].id_n]; }
dk_title :: (x: [] DkIndex, i: int) -> string { return cast(string) x[0].chats[i].title[0..<x[0].chats[i].title_n]; }
dk_folder :: (x: [] DkIndex, i: int) -> string { return cast(string) x[0].chats[i].folder[0..<x[0].chats[i].folder_n]; }
dk_managed :: (x: [] DkIndex, i: int) -> string { return cast(string) x[0].chats[i].managed[0..<x[0].chats[i].managed_n]; }
dk_wt_path :: (x: [] DkIndex, i: int) -> string { return cast(string) x[0].chats[i].wt_path[0..<x[0].chats[i].wt_path_n]; }
dk_wt_branch :: (x: [] DkIndex, i: int) -> string { return cast(string) x[0].chats[i].wt_branch[0..<x[0].chats[i].wt_branch_n]; }
dk_repo :: (x: [] DkIndex, i: int) -> string { return cast(string) x[0].chats[i].repo[0..<x[0].chats[i].repo_n]; }
dk_created :: (x: [] DkIndex, i: int) -> string { return cast(string) x[0].chats[i].created[0..<x[0].chats[i].created_n]; }
dk_updated :: (x: [] DkIndex, i: int) -> string { return cast(string) x[0].chats[i].updated[0..<x[0].chats[i].updated_n]; }

// index.json into x. An empty or missing list is an empty index; false when the text is not a list of chats.
dk_index_parse :: (x: [] DkIndex, text: string) -> bool {
  x[0].n = 0; x[0].full = false;
  if dk_ws(text, 0) >= text.count { return true; }
  i := dk_open(text, '[');
  if i < 0 { return false; }
  for guard: 0..<1000000 {
    m := dk_next(text, i, false);
    if !m.ok { return dk_next_close(text, i); }
    i = m.next;
    e := text[m.vf..<m.vt];
    if e.count == 0 || e[0] != '{' { return false; }
    if x[0].n >= x[0].chats.count { x[0].full = true; continue; }
    k := x[0].n; c: DkChat; tb: [4096] u8;
    c.id_n = dk_copy(c.id[..], dk_text(dk_get(e, "id"), tb[..]));
    if c.id_n == 0 { continue; }
    c.title_n = dk_copy(c.title[..], dk_text(dk_get(e, "title"), tb[..]));
    c.folder_n = dk_copy(c.folder[..], dk_text(dk_get(e, "folder"), tb[..]));
    c.managed_n = dk_copy(c.managed[..], dk_text(dk_get(e, "managed_by"), tb[..]));
    c.wt_path_n = dk_copy(c.wt_path[..], dk_text(dk_get(e, "worktree_path"), tb[..]));
    c.wt_branch_n = dk_copy(c.wt_branch[..], dk_text(dk_get(e, "worktree_branch"), tb[..]));
    c.repo_n = dk_copy(c.repo[..], dk_text(dk_get(e, "repo_root"), tb[..]));
    cr := dk_get(e, "created"); if cr != "null" { c.created_n = dk_copy(c.created[..], cr); }
    c.updated_n = dk_copy(c.updated[..], dk_get(e, "updated"));
    if c.updated_n == 0 { c.updated_n = dk_copy(c.updated[..], "0"); }
    c.renamed = dk_get(e, "renamed") == "true";
    p := dk_get(e, "pinned");
    c.pinned = ifx p.count > 0 && p != "null" then dk_int(p, -1) else -1;
    x[0].chats[k] = c; x[0].n += 1;
  }
  return true;
}
// After the last element: whether only the closing bracket is left.
dk_next_close :: (t: string, i: int) -> bool { j := dk_ws(t, i); if j < t.count && t[j] == ',' { j = dk_ws(t, j + 1); } return j < t.count && t[j] == ']'; }

// index.json as CoderStore writes it: one object a chat, absent optionals left out.
dk_index_write :: (x: [] DkIndex, o: [] Jo) {
  jo_arr(o);
  for i: 0..<x[0].n {
    jo_obj(o);
    jo_key(o, "id"); jo_str(o, dk_id(x, i));
    jo_key(o, "title"); jo_str(o, dk_title(x, i));
    if x[0].chats[i].created_n > 0 { jo_key(o, "created"); jo_raw(o, dk_created(x, i)); }
    jo_key(o, "updated"); jo_raw(o, dk_updated(x, i));
    jo_key(o, "folder"); jo_str(o, dk_folder(x, i));
    if x[0].chats[i].renamed { jo_key(o, "renamed"); jo_bool(o, true); }
    if x[0].chats[i].pinned >= 0 { jo_key(o, "pinned"); jo_int(o, x[0].chats[i].pinned); }
    if x[0].chats[i].managed_n > 0 { jo_key(o, "managed_by"); jo_str(o, dk_managed(x, i)); }
    if x[0].chats[i].wt_path_n > 0 { jo_key(o, "worktree_path"); jo_str(o, dk_wt_path(x, i)); }
    if x[0].chats[i].wt_branch_n > 0 { jo_key(o, "worktree_branch"); jo_str(o, dk_wt_branch(x, i)); }
    if x[0].chats[i].repo_n > 0 { jo_key(o, "repo_root"); jo_str(o, dk_repo(x, i)); }
    jo_end(o);
  }
  jo_end(o);
}
dk_find :: (x: [] DkIndex, id: string) -> int { for i: 0..<x[0].n { if dk_id(x, i) == id { return i; } } return -1; }
// The chats as the sidebar shows them: Pinned in their order, then the rest, newest first. The Foreman's own chat is left out.
dk_ordered :: (x: [] DkIndex, out: [] int, pinned_only: bool) -> int {
  n := 0;
  // pinned: a stable selection by order
  done: [4096] bool; left := 0;
  for i: 0..<x[0].n { if x[0].chats[i].pinned >= 0 && dk_id(x, i) != DK_FOREMAN_ID { left += 1; } }
  while left > 0 {
    best := -1;
    for i: 0..<x[0].n {
      if i < done.count && done[i] { continue; }
      if x[0].chats[i].pinned < 0 || dk_id(x, i) == DK_FOREMAN_ID { continue; }
      if best < 0 || x[0].chats[i].pinned < x[0].chats[best].pinned { best = i; }
    }
    if best < 0 { break; }
    if best < done.count { done[best] = true; }
    if n < out.count { out[n] = best; n += 1; }
    left -= 1;
  }
  if pinned_only { return n; }
  for i: 0..<x[0].n { if x[0].chats[i].pinned < 0 && dk_id(x, i) != DK_FOREMAN_ID && n < out.count { out[n] = i; n += 1; } }
  return n;
}
dk_pinned_count :: (x: [] DkIndex) -> int { o: [4096] int; return dk_ordered(x, o[..], true); }
// CoderStore.normalizePins: Pinned renumbered 0, 1, 2 in its order.
dk_normalize_pins :: (x: [] DkIndex) {
  o: [4096] int; k := dk_ordered(x, o[..], true);
  for j: 0..<k { x[0].chats[o[j]].pinned = j; }
}
// Pins chat i after the last pinned one; a pinned chat stays where it is.
dk_pin :: (x: [] DkIndex, i: int) {
  if x[0].chats[i].pinned >= 0 { return; }
  top := -1;
  for j: 0..<x[0].n { if x[0].chats[j].pinned > top { top = x[0].chats[j].pinned; } }
  x[0].chats[i].pinned = top + 1;
}
dk_unpin :: (x: [] DkIndex, i: int) {
  if x[0].chats[i].pinned < 0 { return; }
  x[0].chats[i].pinned = -1;
  dk_normalize_pins(x);
}
// CoderStore.rename: false when the cleaned title is empty.
dk_rename :: (x: [] DkIndex, i: int, title: string) -> bool {
  tb: [512] u8; clean := dk_clean_title(title, tb[..]);
  if clean.count == 0 { return false; }
  x[0].chats[i].title_n = dk_copy(x[0].chats[i].title[..], clean);
  x[0].chats[i].renamed = true;
  return true;
}
dk_set_folder :: (x: [] DkIndex, i: int, folder: string) -> bool {
  if folder.count == 0 || folder.count > 1024 { return false; }
  x[0].chats[i].folder_n = dk_copy(x[0].chats[i].folder[..], folder);
  return true;
}
// CoderStore.remove: the chat leaves the list and Pinned closes up.
dk_remove :: (x: [] DkIndex, i: int) {
  for j: i..<x[0].n - 1 { x[0].chats[j] = x[0].chats[j + 1]; }
  x[0].n -= 1;
  dk_normalize_pins(x);
}
// A new chat at the top of the list (CoderStore.registerChat). A given title counts as the user's, so the app keeps it.
dk_add :: (x: [] DkIndex, id: string, title: string, folder: string, now: string, managed: string) -> bool {
  if x[0].n >= x[0].chats.count || dk_find(x, id) >= 0 { return false; }
  for j: 0..<x[0].n { x[0].chats[x[0].n - j] = x[0].chats[x[0].n - 1 - j]; }
  c: DkChat; tb: [512] u8; clean := dk_clean_title(title, tb[..]);
  c.id_n = dk_copy(c.id[..], id);
  c.title_n = dk_copy(c.title[..], ifx clean.count > 0 then clean else "New chat");
  c.renamed = clean.count > 0;
  c.folder_n = dk_copy(c.folder[..], folder);
  c.managed_n = dk_copy(c.managed[..], managed);
  c.created_n = dk_copy(c.created[..], now); c.updated_n = dk_copy(c.updated[..], now);
  x[0].chats[0] = c; x[0].n += 1;
  return true;
}

// ---- one chat: ID.json ----

DkState :: struct {
  ok: bool;
  cost: int; budget: int; override: bool;
  goal_status: int; goal_time: int; goal_turns: int;
  goal: [DK_GOAL_TEXT] u8; goal_n: int;
  turns: int;
}
dk_goal_name :: (st: int) -> string {   // CoderWindow.goalStatusName
  if st == DK_GOAL_ACTIVE { return "active"; }
  if st == DK_GOAL_PAUSED { return "paused"; }
  if st == DK_GOAL_COMPLETE { return "complete"; }
  if st == DK_GOAL_BLOCKED { return "blocked"; }
  if st == DK_GOAL_BUDGET_LIMITED { return "budget_limited"; }
  return "none";
}
dk_goal_text :: (s: [] DkState) -> string { return cast(string) s[0].goal[0..<s[0].goal_n]; }
// A chat's text as coder_page_load reads it; ok false when it is not a chat (no turns list).
dk_state_load :: (s: [] DkState, text: string) {
  s[0] = DkState.{};
  turns := dk_get(text, "turns");
  if turns.count == 0 || turns[0] != '[' { return; }
  s[0].ok = true; s[0].turns = dk_count(turns);
  c := dk_int(dk_get(text, "cost_usd_micros"), 0); s[0].cost = ifx c > 0 then c else 0;
  b := dk_int(dk_get(text, "budget_usd_micros"), 0); s[0].budget = ifx b > 0 then b else DK_BUDGET_DEFAULT;
  s[0].override = dk_get(text, "budget_override") == "true";
  gs := dk_int(dk_get(text, "goal_status"), 0);
  if gs >= DK_GOAL_ACTIVE && gs <= DK_GOAL_BUDGET_LIMITED {
    gb: [8192] u8; obj := dk_text(dk_get(text, "goal_objective"), gb[..]);
    if obj.count > 0 {
      s[0].goal_status = gs; s[0].goal_n = dk_copy(s[0].goal[..], obj);
      gt := dk_int(dk_get(text, "goal_time"), 0); s[0].goal_time = ifx gt > 0 then gt else 0;
      gn := dk_int(dk_get(text, "goal_turns"), 0); s[0].goal_turns = ifx gn > 0 then gn else 0;
    }
  }
}
dk_exceeded :: (s: [] DkState) -> bool { return !s[0].override && s[0].cost >= s[0].budget; }
DK_STATE_KEYS :: [8] string.["v", "cost_usd_micros", "budget_usd_micros", "budget_override", "goal_status", "goal_time", "goal_turns", "goal_objective"];
// The chat's text again with s's budget and goal (coder_page_save's order); every other member as it was.
dk_state_save :: (s: [] DkState, text: string, o: [] Jo) {
  jo_obj(o);
  v := dk_get(text, "v");
  jo_key(o, "v"); jo_raw(o, ifx v.count > 0 then v else "1");
  jo_key(o, "cost_usd_micros"); jo_int(o, s[0].cost);
  jo_key(o, "budget_usd_micros"); jo_int(o, s[0].budget);
  if s[0].override { jo_key(o, "budget_override"); jo_bool(o, true); }
  if s[0].goal_status != DK_GOAL_NONE && s[0].goal_n > 0 {
    jo_key(o, "goal_status"); jo_int(o, s[0].goal_status);
    jo_key(o, "goal_time"); jo_int(o, s[0].goal_time);
    jo_key(o, "goal_turns"); jo_int(o, s[0].goal_turns);
    jo_key(o, "goal_objective"); jo_str(o, dk_goal_text(s));
  }
  i := dk_open(text, '{');
  for guard: 0..<1000000 {
    m := dk_next(text, i, true);
    if !m.ok { break; }
    i = m.next;
    key := text[m.kf..<m.kt]; skip := false;
    for k: DK_STATE_KEYS { if key == k { skip = true; } }
    if skip { continue; }
    jo_value(o); jo_requote(o, key); jo_byte(o, ':'); o[0].keyed = true;
    jo_raw(o, text[m.vf..<m.vt]);
  }
  jo_end(o);
}
// An empty chat with a budget and maybe a goal, as the app would keep it before its first message.
dk_state_new :: (s: [] DkState, budget: int) { s[0] = DkState.{ok = true, budget = ifx budget > 0 then budget else DK_BUDGET_DEFAULT}; }

// coder_page_set_budget_usd_micros: a budget at or above the cost clears an approval.
dk_budget_set :: (s: [] DkState, micros: int) -> bool {
  if micros <= 0 { return false; }
  s[0].budget = micros;
  if s[0].cost < micros { s[0].override = false; }
  return true;
}
// coder_page_budget_approve ("Continue above budget"); off takes the approval back.
dk_budget_override :: (s: [] DkState, on: bool) {
  s[0].override = on;
  if on && s[0].goal_status == DK_GOAL_BUDGET_LIMITED { s[0].goal_status = DK_GOAL_ACTIVE; }
  if !on && s[0].goal_status == DK_GOAL_ACTIVE && dk_exceeded(s) { s[0].goal_status = DK_GOAL_BUDGET_LIMITED; }
}
// /goal OBJECTIVE (cp_goal_start_or_update): a new goal starts its clock and turns at 0; an update keeps them.
dk_goal_set :: (s: [] DkState, objective: string) -> bool {
  a := 0; b := objective.count;
  while a < b && dk_space(objective[a]) { a += 1; }
  while b > a && dk_space(objective[b - 1]) { b -= 1; }
  if a == b { return false; }
  had := s[0].goal_status != DK_GOAL_NONE && s[0].goal_n > 0;
  s[0].goal_n = dk_copy(s[0].goal[..], dk_clip(objective[a..<b], DK_GOAL_TEXT));
  s[0].goal_status = DK_GOAL_ACTIVE;
  if !had { s[0].goal_time = 0; s[0].goal_turns = 0; }
  if dk_exceeded(s) { s[0].goal_status = DK_GOAL_BUDGET_LIMITED; }
  return true;
}
// /goal pause, resume, complete (cp_goal_set_status): false when there is no goal.
dk_goal_status_set :: (s: [] DkState, st: int) -> bool {
  if s[0].goal_status == DK_GOAL_NONE || s[0].goal_n == 0 { return false; }
  s[0].goal_status = st;
  if st == DK_GOAL_ACTIVE && dk_exceeded(s) { s[0].goal_status = DK_GOAL_BUDGET_LIMITED; }
  return true;
}
// /goal clear: false when there was no goal (the chat is unchanged either way).
dk_goal_clear :: (s: [] DkState) -> bool {
  had := s[0].goal_status != DK_GOAL_NONE;
  s[0].goal_status = DK_GOAL_NONE; s[0].goal_n = 0; s[0].goal_time = 0; s[0].goal_turns = 0;
  return had;
}

// ---- what --json prints ----

// The state's fields into the object o has open.
dk_state_fields :: (s: [] DkState, o: [] Jo) {
  if !s[0].ok { jo_key(o, "missing_file"); jo_bool(o, true); return; }
  jo_key(o, "turn_count"); jo_int(o, s[0].turns);
  jo_key(o, "cost_usd_micros"); jo_int(o, s[0].cost);
  jo_key(o, "budget_usd_micros"); jo_int(o, s[0].budget);
  jo_key(o, "budget_override"); jo_bool(o, s[0].override);
  jo_key(o, "budget_exceeded"); jo_bool(o, dk_exceeded(s));
  jo_key(o, "goal_status"); jo_str(o, dk_goal_name(s[0].goal_status));
  if s[0].goal_status != DK_GOAL_NONE {
    jo_key(o, "goal_objective"); jo_str(o, dk_goal_text(s));
    jo_key(o, "goal_turns"); jo_int(o, s[0].goal_turns);
    jo_key(o, "goal_time_seconds"); jo_int(o, s[0].goal_time);
  }
}
// Chat i's list entry into the object o has open.
dk_chat_fields :: (x: [] DkIndex, i: int, o: [] Jo) {
  jo_key(o, "id"); jo_str(o, dk_id(x, i));
  jo_key(o, "title"); jo_str(o, dk_title(x, i));
  jo_key(o, "folder"); jo_str(o, dk_folder(x, i));
  jo_key(o, "pinned"); jo_bool(o, x[0].chats[i].pinned >= 0);
  if x[0].chats[i].pinned >= 0 { jo_key(o, "pin_order"); jo_int(o, x[0].chats[i].pinned); }
  jo_key(o, "renamed"); jo_bool(o, x[0].chats[i].renamed);
  jo_key(o, "managed_by"); jo_str(o, dk_managed(x, i));
  if x[0].chats[i].created_n > 0 { jo_key(o, "created"); jo_raw(o, dk_created(x, i)); }
  jo_key(o, "updated"); jo_raw(o, dk_updated(x, i));
}
// The turns of a chat's text as read prints them: the last tail (all with full), replies cut to 4000 bytes
// unless full; full adds each tool call and each sub-agent's reply.
dk_turns_write :: (text: string, tail: int, full: bool, o: [] Jo) {
  turns := dk_get(text, "turns"); total := dk_count(turns);
  from := ifx full || tail <= 0 || tail >= total then 0 else total - tail;
  jo_key(o, "total_turns"); jo_int(o, total);
  jo_key(o, "first_turn"); jo_int(o, from);
  jo_key(o, "turns"); jo_arr(o);
  i := dk_open(turns, '['); k := 0;
  for guard: 0..<1000000 {
    m := dk_next(turns, i, false);
    if !m.ok { break; }
    i = m.next;
    if k >= from {
      t := turns[m.vf..<m.vt]; tb: [262144] u8;
      jo_obj(o);
      jo_key(o, "index"); jo_int(o, k);
      jo_key(o, "ask"); jo_str(o, dk_text(dk_get(t, "ask"), tb[..]));
      r := dk_text(dk_get(t, "reply"), tb[..]); rc := ifx full then r else dk_clip(r, 4000);
      jo_key(o, "reply"); jo_str(o, rc);
      if rc.count < r.count { jo_key(o, "reply_truncated"); jo_bool(o, true); }
      jo_key(o, "note"); jo_str(o, dk_text(dk_get(t, "note"), tb[..]));
      jo_key(o, "state"); jo_int(o, dk_int(dk_get(t, "state"), 0));
      cmds := dk_get(t, "cmds");
      jo_key(o, "tool_count"); jo_int(o, dk_count(cmds));
      if full {
        jo_key(o, "tools"); jo_arr(o);
        for j: 0..<dk_count(cmds) {
          c := dk_elem(cmds, j);
          jo_obj(o);
          jo_key(o, "text"); jo_str(o, dk_text(dk_get(c, "text"), tb[..]));
          jo_key(o, "out"); jo_str(o, dk_text(dk_get(c, "out"), tb[..]));
          jo_key(o, "failed"); jo_bool(o, dk_get(c, "failed") == "true");
          jo_key(o, "took"); jo_int(o, dk_int(dk_get(c, "took"), 0));
          jo_end(o);
        }
        jo_end(o);
      }
      agents := dk_get(t, "agents");
      jo_key(o, "agents"); jo_arr(o);
      for j: 0..<dk_count(agents) {
        a := dk_elem(agents, j);
        jo_obj(o);
        jo_key(o, "level"); jo_str(o, dk_text(dk_get(a, "level"), tb[..]));
        jo_key(o, "task"); jo_str(o, dk_text(dk_get(a, "task"), tb[..]));
        jo_key(o, "state"); jo_int(o, dk_int(dk_get(a, "state"), 0));
        jo_key(o, "calls"); jo_int(o, dk_int(dk_get(a, "calls"), 0));
        if full { jo_key(o, "reply"); jo_str(o, dk_text(dk_get(a, "reply"), tb[..])); }
        jo_end(o);
      }
      jo_end(o);
      jo_end(o);
    }
    k += 1;
  }
  jo_end(o);
}
// Where QUERY shows in chat i: "title", "folder", "text" (its asks and replies, matched in the file's
// own escaped text), or "" when nowhere.
dk_match :: (x: [] DkIndex, i: int, chat_text: string, query: string) -> string {
  if dk_has(dk_title(x, i), query) { return "title"; }
  if dk_has(dk_folder(x, i), query) { return "folder"; }
  if dk_has(chat_text, query) { return "text"; }
  return "";
}

// ---- the live app: Coder Desktop's Foreman control server ----
// ForemanControlServer (apps/coder-desktop/Foreman.swift) listens on 127.0.0.1 with a token in
// X-Foreman-Token; foreman-ctl and these requests use the same paths and fields.

// The request for a verb: "GET /v1/status" style, or "" when the app has no endpoint for it.
dk_live_route :: (verb: string) -> string {
  if verb == "status" { return "GET /v1/status"; }
  if verb == "tier" { return "GET /v1/tier"; }
  if verb == "ls" { return "POST /v1/chats/list"; }
  if verb == "read" || verb == "budget" || verb == "goal-status" { return "POST /v1/chats/read"; }
  if verb == "create" { return "POST /v1/chats/create"; }
  if verb == "send" { return "POST /v1/chats/send"; }
  if verb == "rename" || verb == "pin" || verb == "unpin" || verb == "delete" || verb == "stop" || verb == "set-budget" || verb == "goal" { return "POST /v1/chats/control"; }
  if verb == "stop-all" { return "POST /v1/chats/stop-all"; }
  if verb == "search-chats" { return "POST /v1/search/chats"; }
  if verb == "search-repo" { return "POST /v1/search/repo"; }
  return "";
}
// The control action for `goal ID SUB`; "" for complete, which the app's API does not take.
dk_goal_action :: (sub: string) -> string {
  if sub == "set" { return "set_goal"; }
  if sub == "pause" { return "pause_goal"; }
  if sub == "resume" { return "resume_goal"; }
  if sub == "clear" { return "clear_goal"; }
  return "";
}
dk_pl_list :: (pinned: bool, limit: int, o: [] Jo) {
  jo_obj(o); jo_key(o, "limit"); jo_int(o, limit); jo_key(o, "filter"); jo_str(o, ifx pinned then "pinned" else "all"); jo_end(o);
}
dk_pl_read :: (id: string, tail: int, tools: bool, o: [] Jo) {
  jo_obj(o); jo_key(o, "chat_id"); jo_str(o, id); jo_key(o, "tail"); jo_int(o, tail); jo_key(o, "include_tools"); jo_bool(o, tools); jo_end(o);
}
dk_pl_create :: (title: string, prompt: string, folder: string, budget: int, goal: string, pin: bool, o: [] Jo) {
  jo_obj(o);
  jo_key(o, "title"); jo_str(o, title); jo_key(o, "prompt"); jo_str(o, prompt); jo_key(o, "folder"); jo_str(o, folder);
  if budget > 0 { ub: [32] u8; jo_key(o, "budget_usd"); jo_raw(o, dk_usd_json(budget, ub[..])); }
  if goal.count > 0 { jo_key(o, "goal"); jo_str(o, goal); }
  if pin { jo_key(o, "pin"); jo_bool(o, true); }
  jo_end(o);
}
dk_pl_send :: (id: string, prompt: string, mode: string, o: [] Jo) {
  jo_obj(o); jo_key(o, "chat_id"); jo_str(o, id); jo_key(o, "prompt"); jo_str(o, prompt); jo_key(o, "mode"); jo_str(o, mode); jo_end(o);
}
// A control request: title for rename, budget for set_budget (a whole number of microdollars, sent as dollars), objective for set_goal.
dk_pl_control :: (id: string, action: string, title: string, budget: int, objective: string, o: [] Jo) {
  jo_obj(o); jo_key(o, "chat_id"); jo_str(o, id); jo_key(o, "action"); jo_str(o, action);
  if title.count > 0 { jo_key(o, "title"); jo_str(o, title); }
  if budget > 0 { ub: [32] u8; jo_key(o, "budget_usd"); jo_raw(o, dk_usd_json(budget, ub[..])); }
  if objective.count > 0 { jo_key(o, "objective"); jo_str(o, objective); }
  jo_end(o);
}
dk_pl_stop_all :: (all: bool, o: [] Jo) { jo_obj(o); jo_key(o, "all"); jo_bool(o, all); jo_end(o); }
dk_pl_search :: (query: string, limit: int, folder: string, glob: string, o: [] Jo) {
  jo_obj(o); jo_key(o, "query"); jo_str(o, query);
  if limit > 0 { jo_key(o, "limit"); jo_int(o, limit); jo_key(o, "max"); jo_int(o, limit); }
  if folder.count > 0 { jo_key(o, "folder"); jo_str(o, folder); }
  if glob.count > 0 { jo_key(o, "glob"); jo_str(o, glob); }
  jo_end(o);
}

// ---- checks ----

#test "desktop store: requests to the live app" {
  #assert dk_live_route("status") == "GET /v1/status" && dk_live_route("tier") == "GET /v1/tier" && dk_live_route("ls") == "POST /v1/chats/list";
  #assert dk_live_route("pin") == "POST /v1/chats/control" && dk_live_route("stop-all") == "POST /v1/chats/stop-all" && dk_live_route("search-repo") == "POST /v1/search/repo";
  #assert dk_live_route("folder") == "" && dk_goal_action("pause") == "pause_goal" && dk_goal_action("complete") == "" && dk_goal_action("set") == "set_goal";
  buf: [1024] u8; o: [1] Jo;
  jo_start(o[..], buf[..]); dk_pl_list(true, 200, o[..]); #assert jo_text(o[..]) == "{\"limit\":200,\"filter\":\"pinned\"}";
  jo_start(o[..], buf[..]); dk_pl_read("abc", 8, false, o[..]); #assert jo_text(o[..]) == "{\"chat_id\":\"abc\",\"tail\":8,\"include_tools\":false}";
  jo_start(o[..], buf[..]); dk_pl_create("T", "do \"it\"", "/w", 2500000, "g", true, o[..]);
  #assert jo_text(o[..]) == "{\"title\":\"T\",\"prompt\":\"do \\\"it\\\"\",\"folder\":\"/w\",\"budget_usd\":2.5,\"goal\":\"g\",\"pin\":true}";
  jo_start(o[..], buf[..]); dk_pl_create("", "p", "", 0, "", false, o[..]); #assert jo_text(o[..]) == "{\"title\":\"\",\"prompt\":\"p\",\"folder\":\"\"}";
  jo_start(o[..], buf[..]); dk_pl_send("abc", "next", "follow_up", o[..]); #assert jo_text(o[..]) == "{\"chat_id\":\"abc\",\"prompt\":\"next\",\"mode\":\"follow_up\"}";
  jo_start(o[..], buf[..]); dk_pl_control("abc", "rename", "New", 0, "", o[..]); #assert jo_text(o[..]) == "{\"chat_id\":\"abc\",\"action\":\"rename\",\"title\":\"New\"}";
  jo_start(o[..], buf[..]); dk_pl_control("abc", "set_budget", "", 7000000, "", o[..]); #assert jo_text(o[..]) == "{\"chat_id\":\"abc\",\"action\":\"set_budget\",\"budget_usd\":7}";
  jo_start(o[..], buf[..]); dk_pl_control("abc", "set_goal", "", 0, "ship", o[..]); #assert jo_text(o[..]) == "{\"chat_id\":\"abc\",\"action\":\"set_goal\",\"objective\":\"ship\"}";
  jo_start(o[..], buf[..]); dk_pl_stop_all(false, o[..]); #assert jo_text(o[..]) == "{\"all\":false}";
  jo_start(o[..], buf[..]); dk_pl_search("q", 20, "", "", o[..]); #assert jo_text(o[..]) == "{\"query\":\"q\",\"limit\":20,\"max\":20}";
}

DK_FIXTURE_INDEX :: "[{\"id\":\"aaa\",\"title\":\"First \\/ chat\",\"created\":1763500000.5,\"updated\":1763500100.25,\"folder\":\"\\/tmp\\/one\"},{\"id\":\"foreman\",\"title\":\"Foreman\",\"updated\":1,\"folder\":\"\\/tmp\",\"managed_by\":\"foreman\"},{\"id\":\"bbb\",\"title\":\"Second\",\"updated\":1763400000,\"folder\":\"\\/tmp\\/two\",\"renamed\":true,\"pinned\":1},{\"id\":\"ccc\",\"title\":\"Third\",\"updated\":5,\"folder\":\"\\/x\",\"pinned\":0,\"managed_by\":\"foreman\"}]";
DK_FIXTURE_CHAT :: "{\"v\":1,\"cost_usd_micros\":2000000,\"budget_usd_micros\":3000000,\"turns\":[{\"ask\":\"hi\",\"reply\":\"hello \\\"there\\\"\",\"cut\":false,\"state\":2,\"note\":\"\",\"more\":0,\"earlier\":0,\"cmds\":[{\"text\":\"ls\",\"out\":\"a\\nb\",\"read\":false,\"failed\":false,\"took\":3}],\"agents\":[{\"level\":\"low\",\"task\":\"look\",\"state\":2,\"reply\":\"done\",\"more\":0,\"earlier\":0,\"after\":0,\"rows\":[],\"calls\":4,\"took\":1}]},{\"ask\":\"again\",\"reply\":\"ok\",\"state\":2,\"cmds\":[],\"agents\":[]}]}";

#test "desktop store: scanning members, elements and values" {
  t := "{ \"a\" : [1, {\"b\":\"x}\\\"\"}], \"c\":-12.5 ,\"d\":true}";
  #assert dk_get(t, "a") == "[1, {\"b\":\"x}\\\"\"}]" && dk_get(t, "c") == "-12.5" && dk_get(t, "d") == "true" && dk_get(t, "e") == "";
  #assert dk_count(dk_get(t, "a")) == 2 && dk_count("[]") == 0 && dk_count("[ ]") == 0 && dk_elem(dk_get(t, "a"), 1) == "{\"b\":\"x}\\\"\"}";
  #assert dk_int("-12.5", 0) == -12 && dk_int("1763500000.25", 0) == 1763500000 && dk_int("x", 7) == 7 && dk_int("", 7) == 7;
  tb: [64] u8;
  #assert dk_text("\"a\\/b\\n\"", tb[..]) == "a/b\n" && dk_text("12", tb[..]) == "" && dk_get("{\"a\":", "a") == "";
  #assert dk_has("Hello World", "wORLD") && !dk_has("abc", "abcd") && dk_has("abc", "");
}

#test "desktop store: titles, dollars, times and ids" {
  tb: [512] u8;
  #assert dk_clean_title("  a \t b\n\nc  ", tb[..]) == "a b c" && dk_clean_title(" \n ", tb[..]) == "";
  long: [300] u8; for i: 0..<300 { long[i] = 'x'; }
  #assert dk_clean_title(cast(string) long[..], tb[..]).count == 120;
  e := "éééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé";   // 2 bytes each
  #assert dk_clean_title(e, tb[..]).count == 120 && dk_clip("aé", 2) == "a";
  #assert dk_usd_micros("5") == 5000000 && dk_usd_micros("2.5") == 2500000 && dk_usd_micros("0.000001") == 1;
  #assert dk_usd_micros("0") == -1 && dk_usd_micros("-1") == -1 && dk_usd_micros("1.2.3") == -1 && dk_usd_micros("") == -1 && dk_usd_micros("abc") == -1;
  #assert dk_usd_json(2500000, tb[..]) == "2.5" && dk_usd_json(50000000, tb[..]) == "50" && dk_usd_json(1, tb[..]) == "0.000001";
  #assert dk_usd(2500000, tb[..]) == "$2.50" && dk_usd(50000, tb[..]) == "$0.05" && dk_usd(0, tb[..]) == "$0.00";
  #assert dk_time_json(1763500000000042, tb[..]) == "1763500000.000042";
  b := [16] u8.[0xff, 1, 2, 3, 4, 5, 0xff, 7, 0xff, 9, 10, 11, 12, 13, 14, 15];
  #assert dk_uuid(b[..], tb[..]) == "ff010203-0405-4f07-bf09-0a0b0c0d0e0f";
  #assert dk_id_ok("ff010203-0405-4f07-bf09-0a0b0c0d0e0f") && !dk_id_ok("../x") && !dk_id_ok("") && !dk_id_ok("a b");
}

#test "desktop store: the list reads, orders and writes back" {
  chats: [8] DkChat; x := [1] DkIndex.[DkIndex.{chats = chats[..]}];
  #assert dk_index_parse(x[..], DK_FIXTURE_INDEX) && x[0].n == 4;
  #assert dk_title(x[..], 0) == "First / chat" && dk_folder(x[..], 0) == "/tmp/one" && dk_created(x[..], 0) == "1763500000.5" && dk_updated(x[..], 0) == "1763500100.25";
  #assert x[0].chats[2].renamed && x[0].chats[2].pinned == 1 && x[0].chats[3].pinned == 0 && dk_managed(x[..], 3) == "foreman" && x[0].chats[0].pinned == -1;
  o: [8] int; n := dk_ordered(x[..], o[..], false);
  #assert n == 3 && o[0] == 3 && o[1] == 2 && o[2] == 0;        // pinned by order, then the rest; the Foreman's chat is not listed
  #assert dk_ordered(x[..], o[..], true) == 2 && dk_pinned_count(x[..]) == 2;
  buf: [4096] u8; w: [1] Jo; jo_start(w[..], buf[..]); dk_index_write(x[..], w[..]);
  #assert !w[0].bad;
  again: [8] DkChat; y := [1] DkIndex.[DkIndex.{chats = again[..]}];
  #assert dk_index_parse(y[..], jo_text(w[..])) && y[0].n == 4 && dk_title(y[..], 0) == "First / chat" && y[0].chats[2].pinned == 1 && dk_updated(y[..], 2) == "1763400000";
  #assert jo_text(w[..]) == "[{\"id\":\"aaa\",\"title\":\"First / chat\",\"created\":1763500000.5,\"updated\":1763500100.25,\"folder\":\"/tmp/one\"},{\"id\":\"foreman\",\"title\":\"Foreman\",\"updated\":1,\"folder\":\"/tmp\",\"managed_by\":\"foreman\"},{\"id\":\"bbb\",\"title\":\"Second\",\"updated\":1763400000,\"folder\":\"/tmp/two\",\"renamed\":true,\"pinned\":1},{\"id\":\"ccc\",\"title\":\"Third\",\"updated\":5,\"folder\":\"/x\",\"pinned\":0,\"managed_by\":\"foreman\"}]";
  #assert dk_index_parse(y[..], "") && y[0].n == 0 && dk_index_parse(y[..], " [ ] ") && y[0].n == 0;
  #assert !dk_index_parse(y[..], "{}") && !dk_index_parse(y[..], "[1]") && !dk_index_parse(y[..], "[{\"id\":\"a\"}");
  small: [2] DkChat; z := [1] DkIndex.[DkIndex.{chats = small[..]}];
  #assert dk_index_parse(z[..], DK_FIXTURE_INDEX) && z[0].n == 2 && z[0].full;
}

#test "desktop store: a chat's worktree survives a rewrite" {
  t := "[{\"id\":\"w1\",\"title\":\"T\",\"created\":2,\"updated\":3,\"folder\":\"\\/w\\/r-1\\/w1\",\"managed_by\":\"foreman\",\"worktree_path\":\"\\/w\\/r-1\\/w1\",\"worktree_branch\":\"coder\\/w1\",\"repo_root\":\"\\/r\"}]";
  chats: [2] DkChat; x := [1] DkIndex.[DkIndex.{chats = chats[..]}];
  #assert dk_index_parse(x[..], t) && x[0].n == 1 && dk_wt_path(x[..], 0) == "/w/r-1/w1" && dk_wt_branch(x[..], 0) == "coder/w1" && dk_repo(x[..], 0) == "/r";
  buf: [2048] u8; w: [1] Jo; jo_start(w[..], buf[..]); dk_index_write(x[..], w[..]);
  #assert jo_text(w[..]) == "[{\"id\":\"w1\",\"title\":\"T\",\"created\":2,\"updated\":3,\"folder\":\"/w/r-1/w1\",\"managed_by\":\"foreman\",\"worktree_path\":\"/w/r-1/w1\",\"worktree_branch\":\"coder/w1\",\"repo_root\":\"/r\"}]";
}

#test "desktop store: pin, unpin, rename, folder, delete and create" {
  chats: [8] DkChat; x := [1] DkIndex.[DkIndex.{chats = chats[..]}];
  #assert dk_index_parse(x[..], DK_FIXTURE_INDEX);
  a := dk_find(x[..], "aaa"); #assert a == 0 && dk_find(x[..], "zzz") == -1;
  dk_pin(x[..], a); #assert x[0].chats[a].pinned == 2;              // after the highest
  dk_pin(x[..], a); #assert x[0].chats[a].pinned == 2;              // pinning again changes nothing
  dk_unpin(x[..], dk_find(x[..], "ccc"));                            // the first pinned leaves: the rest close up from 0
  #assert x[0].chats[dk_find(x[..], "ccc")].pinned == -1 && x[0].chats[dk_find(x[..], "bbb")].pinned == 0 && x[0].chats[a].pinned == 1;
  #assert dk_rename(x[..], a, "  New\n name ") && dk_title(x[..], a) == "New name" && x[0].chats[a].renamed;
  #assert !dk_rename(x[..], a, " \t ") && dk_title(x[..], a) == "New name";
  #assert dk_set_folder(x[..], a, "/work/repo") && dk_folder(x[..], a) == "/work/repo" && !dk_set_folder(x[..], a, "");
  dk_remove(x[..], dk_find(x[..], "bbb"));
  #assert x[0].n == 3 && dk_find(x[..], "bbb") == -1 && x[0].chats[a].pinned == 0;   // Pinned renumbered
  #assert dk_add(x[..], "new-1", "", "/w", "1763600000.000001", "") && x[0].n == 4 && dk_find(x[..], "new-1") == 0;
  #assert dk_title(x[..], 0) == "New chat" && !x[0].chats[0].renamed && dk_created(x[..], 0) == "1763600000.000001" && dk_updated(x[..], 0) == "1763600000.000001";
  #assert dk_add(x[..], "new-2", " Mine ", "/w", "2", "foreman") && dk_title(x[..], 0) == "Mine" && x[0].chats[0].renamed && dk_managed(x[..], 0) == "foreman";
  #assert !dk_add(x[..], "new-2", "dup", "/w", "3", "") && dk_id(x[..], 1) == "new-1" && dk_id(x[..], 2) == "aaa";
}

#test "desktop store: a chat's budget, cost and goal survive a rewrite" {
  s: [1] DkState; dk_state_load(s[..], DK_FIXTURE_CHAT);
  #assert s[0].ok && s[0].turns == 2 && s[0].cost == 2000000 && s[0].budget == 3000000 && !s[0].override && s[0].goal_status == DK_GOAL_NONE && !dk_exceeded(s[..]);
  #assert dk_goal_set(s[..], "  ship it  ") && dk_goal_text(s[..]) == "ship it" && s[0].goal_status == DK_GOAL_ACTIVE;
  buf: [8192] u8; w: [1] Jo; jo_start(w[..], buf[..]); dk_state_save(s[..], DK_FIXTURE_CHAT, w[..]);
  out := jo_text(w[..]);
  #assert !w[0].bad && dk_get(out, "goal_status") == "1" && dk_get(out, "goal_objective") == "\"ship it\"" && dk_get(out, "turns") == dk_get(DK_FIXTURE_CHAT, "turns");
  #assert dk_get(out, "budget_usd_micros") == "3000000" && dk_get(out, "budget_override") == "" && dk_get(out, "v") == "1";
  t: [1] DkState; dk_state_load(t[..], out);
  #assert t[0].goal_status == DK_GOAL_ACTIVE && dk_goal_text(t[..]) == "ship it" && t[0].cost == 2000000;
  // without a turns list it is not a chat; a missing budget is the default
  dk_state_load(t[..], "{\"v\":1}"); #assert !t[0].ok;
  dk_state_load(t[..], "{\"turns\":[]}"); #assert t[0].ok && t[0].budget == DK_BUDGET_DEFAULT && t[0].cost == 0;
  // a goal with no objective is not kept
  dk_state_load(t[..], "{\"goal_status\":1,\"goal_objective\":\"\",\"turns\":[]}"); #assert t[0].goal_status == DK_GOAL_NONE;
  dk_state_new(t[..], 0); #assert t[0].ok && t[0].budget == DK_BUDGET_DEFAULT;
  jo_start(w[..], buf[..]); dk_state_save(t[..], "{\"turns\":[]}", w[..]);
  #assert jo_text(w[..]) == "{\"v\":1,\"cost_usd_micros\":0,\"budget_usd_micros\":50000000,\"turns\":[]}";
}

#test "desktop store: budget and override follow the app" {
  s: [1] DkState; dk_state_load(s[..], DK_FIXTURE_CHAT);
  #assert !dk_budget_set(s[..], 0) && !dk_budget_set(s[..], -5) && s[0].budget == 3000000;
  #assert dk_budget_set(s[..], 1000000) && dk_exceeded(s[..]);           // cost 2.00 over a 1.00 budget
  #assert dk_goal_set(s[..], "go") && s[0].goal_status == DK_GOAL_BUDGET_LIMITED;   // a goal over budget waits
  dk_budget_override(s[..], true);
  #assert s[0].override && !dk_exceeded(s[..]) && s[0].goal_status == DK_GOAL_ACTIVE;   // approving resumes it
  #assert dk_budget_set(s[..], 1500000) && s[0].override;                // still under the cost: the approval stays
  dk_budget_override(s[..], false);
  #assert !s[0].override && s[0].goal_status == DK_GOAL_BUDGET_LIMITED;
  #assert dk_budget_set(s[..], 9000000) && !s[0].override && !dk_exceeded(s[..]);
  #assert dk_goal_status_set(s[..], DK_GOAL_ACTIVE) && s[0].goal_status == DK_GOAL_ACTIVE;
  buf: [8192] u8; w: [1] Jo; jo_start(w[..], buf[..]); dk_budget_override(s[..], true); dk_state_save(s[..], DK_FIXTURE_CHAT, w[..]);
  #assert dk_get(jo_text(w[..]), "budget_override") == "true" && dk_get(jo_text(w[..]), "budget_usd_micros") == "9000000";
}

#test "desktop store: the /goal lifecycle" {
  s: [1] DkState; dk_state_new(s[..], 0);
  #assert !dk_goal_status_set(s[..], DK_GOAL_PAUSED) && !dk_goal_clear(s[..]) && !dk_goal_set(s[..], "  \n ");
  #assert dk_goal_set(s[..], "write tests") && s[0].goal_status == DK_GOAL_ACTIVE && s[0].goal_turns == 0;
  s[0].goal_turns = 3; s[0].goal_time = 90;
  #assert dk_goal_status_set(s[..], DK_GOAL_PAUSED) && dk_goal_name(s[0].goal_status) == "paused";
  #assert dk_goal_set(s[..], "write more tests") && s[0].goal_turns == 3 && s[0].goal_time == 90;   // an update keeps its turns and clock
  #assert dk_goal_status_set(s[..], DK_GOAL_COMPLETE) && dk_goal_name(s[0].goal_status) == "complete";
  #assert dk_goal_status_set(s[..], DK_GOAL_ACTIVE) && dk_goal_name(s[0].goal_status) == "active";
  #assert dk_goal_clear(s[..]) && s[0].goal_status == DK_GOAL_NONE && s[0].goal_n == 0 && s[0].goal_turns == 0;
  #assert dk_goal_set(s[..], "again") && s[0].goal_turns == 0;
  #assert dk_goal_name(DK_GOAL_BLOCKED) == "blocked" && dk_goal_name(DK_GOAL_BUDGET_LIMITED) == "budget_limited" && dk_goal_name(0) == "none";
}

#test "desktop store: --json for a list entry, a chat and its turns" {
  chats: [8] DkChat; x := [1] DkIndex.[DkIndex.{chats = chats[..]}];
  #assert dk_index_parse(x[..], DK_FIXTURE_INDEX);
  s: [1] DkState; dk_state_load(s[..], DK_FIXTURE_CHAT); _ := dk_goal_set(s[..], "g");
  buf: [16384] u8; w: [1] Jo; jo_start(w[..], buf[..]);
  jo_obj(w[..]); dk_chat_fields(x[..], 2, w[..]); dk_state_fields(s[..], w[..]); jo_end(w[..]);
  #assert jo_text(w[..]) == "{\"id\":\"bbb\",\"title\":\"Second\",\"folder\":\"/tmp/two\",\"pinned\":true,\"pin_order\":1,\"renamed\":true,\"managed_by\":\"\",\"updated\":1763400000,\"turn_count\":2,\"cost_usd_micros\":2000000,\"budget_usd_micros\":3000000,\"budget_override\":false,\"budget_exceeded\":false,\"goal_status\":\"active\",\"goal_objective\":\"g\",\"goal_turns\":0,\"goal_time_seconds\":0}";
  m: [1] DkState; dk_state_load(m[..], "");
  jo_start(w[..], buf[..]); jo_obj(w[..]); dk_state_fields(m[..], w[..]); jo_end(w[..]);
  #assert jo_text(w[..]) == "{\"missing_file\":true}";
  jo_start(w[..], buf[..]); jo_obj(w[..]); dk_turns_write(DK_FIXTURE_CHAT, 1, false, w[..]); jo_end(w[..]);
  #assert jo_text(w[..]) == "{\"total_turns\":2,\"first_turn\":1,\"turns\":[{\"index\":1,\"ask\":\"again\",\"reply\":\"ok\",\"note\":\"\",\"state\":2,\"tool_count\":0,\"agents\":[]}]}";
  jo_start(w[..], buf[..]); jo_obj(w[..]); dk_turns_write(DK_FIXTURE_CHAT, 1, true, w[..]); jo_end(w[..]);
  t := jo_text(w[..]);
  #assert dk_get(t, "first_turn") == "0" && dk_count(dk_get(t, "turns")) == 2;
  t0 := dk_elem(dk_get(t, "turns"), 0);
  #assert dk_get(t0, "reply") == "\"hello \\\"there\\\"\"" && dk_get(t0, "tool_count") == "1";
  #assert dk_elem(dk_get(t0, "tools"), 0) == "{\"text\":\"ls\",\"out\":\"a\\nb\",\"failed\":false,\"took\":3}";
  #assert dk_elem(dk_get(t0, "agents"), 0) == "{\"level\":\"low\",\"task\":\"look\",\"state\":2,\"calls\":4,\"reply\":\"done\"}";
  #assert dk_match(x[..], 0, "", "first") == "title" && dk_match(x[..], 0, "", "tmp/one") == "folder" && dk_match(x[..], 0, DK_FIXTURE_CHAT, "HELLO") == "text" && dk_match(x[..], 0, DK_FIXTURE_CHAT, "nowhere") == "";
}
