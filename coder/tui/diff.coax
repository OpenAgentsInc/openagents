// Edits as diffs, the way Claude Code shows them: the changed lines with
// their numbers in the file, added lines on green and removed lines on red,
// three lines of context around each change, and the code itself
// highlighted (coax/lib/tui's highlighter). Write shows the first lines of
// the new file. The line numbers come from reading the file once the tool
// has run.

DF_MAX_LINES :: 400;       // lines per side the diff compares
DF_SHOWN :: 40;            // rows shown before "… N more lines"
DF_CONTEXT :: 3;
// A row's background: Coder Noir's success #9fd08a or danger #ff4d42 at 25%
// over #0a0a0a, or the same on a light background; none without colours.
df_bg :: (theme: int, sign: u8) -> Rgba {
  if theme == TUI_THEME_NONE || (sign != '+' && sign != '-') { return tui_own(); }
  light := theme == TUI_THEME_LIGHT;
  if sign == '+' { return ifx light then tui_rgb(218, 245, 222) else tui_rgb(47, 59, 42); }
  return ifx light then tui_rgb(252, 224, 226) else tui_rgb(71, 27, 24);
}
// The line number's and the sign's look: the row's colour on a change, grey on context; bold with no colours.
df_mark :: (theme: int, sign: u8) -> TuiLook {
  none := theme == TUI_THEME_NONE; light := theme == TUI_THEME_LIGHT;
  if sign == '+' { return ifx none then tui_look(TERM_FACE_BOLD, tui_own()) else tui_look(TERM_FACE_PLAIN, ifx light then tui_rgb(30, 130, 60) else tui_rgb(159, 208, 138)); }
  if sign == '-' { return ifx none then tui_look(TERM_FACE_BOLD, tui_own()) else tui_look(TERM_FACE_PLAIN, ifx light then tui_rgb(190, 40, 40) else tui_rgb(255, 77, 66)); }
  return tui_look(TERM_FACE_PLAIN, ifx none then tui_own() else ifx light then tui_rgb(140, 141, 147) else tui_rgb(129, 129, 129));
}

// A tool call waiting for its result: Edit (old -> new) or Write (new only).
DfPending :: struct {
  id: [128] u8; nid: int;
  path: [1024] u8; npath: int;
  old: [65536] u8; nold: int;
  next: [65536] u8; nnext: int;
  write: bool;
  active: bool;
}

DfLines :: struct { at: [DF_MAX_LINES] int; end: [DF_MAX_LINES] int; n: int; more: bool; }

df_split :: (s: string, l: [] DfLines) {
  l[0].n = 0; l[0].more = false;
  if s.count == 0 { return; }
  at := 0;
  for guard: 0..<s.count + 1 {
    if l[0].n >= DF_MAX_LINES { l[0].more = true; return; }
    e := at; while e < s.count && s[e] != 10 { e += 1; }
    l[0].at[l[0].n] = at; l[0].end[l[0].n] = e; l[0].n += 1;
    if e >= s.count { return; }
    at = e + 1;
    if at >= s.count { return; }      // a trailing newline ends the last line
  }
}

df_line :: (s: string, l: [] DfLines, i: int) -> string { return cast(string) s[l[0].at[i]..<l[0].end[i]]; }

// One row: number, sign and code, on the row's background to the edge,
// painted (coax/lib/tui's painter: the terminal backend writes its styles).
DfRow :: struct { o: [1] TuiOut; b: [8192] u8; p: [1] TuiPaint; }

df_row :: (a: [] App, num: int, sign: u8, code: string, lang: int, hl: [] TuiHl) {
  r_b: [1] DfRow; r := r_b[..]; o := r[0].o[..]; o[0].b = r[0].b[..];
  th := a[0].o[0].theme; o[0].theme = th;
  bg := df_bg(th, sign); mark := df_mark(th, sign); plain := tui_look(TERM_FACE_PLAIN, tui_own());
  width := a[0].cols - 1;
  p := r[0].p[..]; tui_paint(p, o, width);
  tui_paint_spaces(p, plain, tui_own(), 6);
  // the number in the row's color on a changed line, grey on context
  nb: [16] u8; ns := ifx num > 0 then cd_itoa(num, nb[..]) else "";
  tui_paint_spaces(p, mark, bg, 5 - ns.count);
  tui_paint_text(p, mark, bg, ns); tui_paint_text(p, mark, bg, " ");
  tui_paint_text(p, mark, bg, ifx sign == '+' then "+" else ifx sign == '-' then "-" else " ");
  tui_hl_paint(p, hl, lang, code, bg);
  if bg.a > 0 { tui_paint_spaces(p, plain, bg, width - p[0].col); }
  tui_paint_flush(p);
  fb: [8400] u8; fn := cd_cat(fb[..], 0, tui_text(o));
  if a[0].plain {
    // plain output: the same row without styles
    pn := 0; i := 0; t := cast(string) fb[0..<fn];
    while i < t.count { e := tui_esc_len(t, i); if e > 0 { i += e; continue; } fb[pn] = t[i]; pn += 1; i += 1; }
    fn = pn;
  }
  cd_commit(a, TUI_PLAIN, cast(string) fb[0..<fn]);
}

df_note :: (a: [] App, s: string) {
  b: [2048] u8; n := cd_cat(b[..], 0, "    └ "); n = cd_cat(b[..], n, s);
  cd_commit(a, TUI_DIM, cast(string) b[0..<n]);
}

// Kinds of diff rows.
DF_SAME :: 0; DF_DEL :: 1; DF_ADD :: 2;
DfOps :: struct { kind: [2 * DF_MAX_LINES] u8; oi: [2 * DF_MAX_LINES] int; ni: [2 * DF_MAX_LINES] int; n: int; }
DfTable :: struct { t: [(DF_MAX_LINES + 1) * (DF_MAX_LINES + 1)] u16; }

// A line diff by longest common subsequence.
df_ops :: (old: string, ol: [] DfLines, after: string, nl: [] DfLines, ops: [] DfOps, tb: [] DfTable) {
  n := ol[0].n; m := nl[0].n; w := m + 1;
  for i: 0..<n + 1 { tb[0].t[i * w + m] = 0; }
  for j: 0..<m + 1 { tb[0].t[n * w + j] = 0; }
  i := n - 1;
  while i >= 0 {
    j := m - 1;
    while j >= 0 {
      if df_line(old, ol, i) == df_line(after, nl, j) { tb[0].t[i * w + j] = tb[0].t[(i + 1) * w + j + 1] + 1; }
      else {
        x := tb[0].t[(i + 1) * w + j]; y := tb[0].t[i * w + j + 1];
        tb[0].t[i * w + j] = ifx x >= y then x else y;
      }
      j -= 1;
    }
    i -= 1;
  }
  ops[0].n = 0; i = 0; j := 0;
  while i < n || j < m {
    k := ops[0].n;
    if i < n && j < m && df_line(old, ol, i) == df_line(after, nl, j) { ops[0].kind[k] = DF_SAME; ops[0].oi[k] = i; ops[0].ni[k] = j; i += 1; j += 1; }
    // removals before additions, as a reader expects
    else if i < n && (j >= m || tb[0].t[(i + 1) * w + j] >= tb[0].t[i * w + j + 1]) { ops[0].kind[k] = DF_DEL; ops[0].oi[k] = i; ops[0].ni[k] = j; i += 1; }
    else { ops[0].kind[k] = DF_ADD; ops[0].oi[k] = i; ops[0].ni[k] = j; j += 1; }
    ops[0].n += 1;
  }
}

// Where `needle` starts in the file, as a 1-based line, or 0.
df_find_line :: (file: string, needle: string) -> int {
  if needle.count == 0 || needle.count > file.count { return 0; }
  for i: 0..<file.count - needle.count + 1 {
    if file[i] == needle[0] && cast(string) file[i..<i + needle.count] == needle {
      line := 1; for k: 0..<i { if file[k] == 10 { line += 1; } }
      return line;
    }
  }
  return 0;
}

df_show :: (a: [] App, p: [] DfPending) {
  path := cast(string) p[0].path[0..<p[0].npath];
  old := cast(string) p[0].old[0..<p[0].nold];
  after := cast(string) p[0].next[0..<p[0].nnext];
  lang := tui_hl_lang(path);
  rel := path;
  if a[0].cwd.count > 0 && path.count > a[0].cwd.count + 1 && cast(string) path[0..<a[0].cwd.count] == a[0].cwd && path[a[0].cwd.count] == '/' {
    rel = cast(string) path[a[0].cwd.count + 1..<path.count];
  }
  nl_b: [1] DfLines; nl := nl_b[..]; df_split(after, nl);
  if p[0].write {
    cs_diff(a, path, nl[0].n, 0, true, "", after);
    nb: [2048] u8; nn := cd_cat(nb[..], 0, "Wrote "); tb: [16] u8;
    nn = cd_cat(nb[..], nn, cd_itoa(nl[0].n, tb[..])); nn = cd_cat(nb[..], nn, ifx nl[0].n == 1 then " line to " else " lines to ");
    nn = cd_cat(nb[..], nn, rel);
    df_note(a, cast(string) nb[0..<nn]);
    hl_b: [1] TuiHl;
    shown := ifx nl[0].n < 12 then nl[0].n else 12;
    for i: 0..<shown { df_row(a, i + 1, ' ', df_line(after, nl, i), lang, hl_b[..]); }
    if nl[0].n > shown { mb: [64] u8; mn := cd_cat(mb[..], 0, "      … "); mn = cd_cat(mb[..], mn, cd_itoa(nl[0].n - shown, tb[..])); mn = cd_cat(mb[..], mn, " more lines"); cd_commit(a, TUI_FAINT, cast(string) mb[0..<mn]); }
    return;
  }
  ol_b: [1] DfLines; ol := ol_b[..]; df_split(old, ol);
  ops_b: [1] DfOps; ops := ops_b[..];
  if ol[0].more || nl[0].more {
    // too long to compare line by line: all removed, then all added
    ops[0].n = 0;
    for i: 0..<ol[0].n { k := ops[0].n; ops[0].kind[k] = DF_DEL; ops[0].oi[k] = i; ops[0].ni[k] = 0; ops[0].n += 1; }
    for j: 0..<nl[0].n { k := ops[0].n; ops[0].kind[k] = DF_ADD; ops[0].oi[k] = ol[0].n; ops[0].ni[k] = j; ops[0].n += 1; }
  } else {
    df_ops(old, ol, after, nl, ops, a[0].df_table);
  }
  adds := 0; dels := 0;
  for k: 0..<ops[0].n { if ops[0].kind[k] == DF_ADD { adds += 1; } else if ops[0].kind[k] == DF_DEL { dels += 1; } }
  // the file as it is now, for line numbers and the context around the edit
  fn := fs_read(path, a[0].df_file[..]);
  file := ifx fn > 0 then cast(string) a[0].df_file[0..<fn] else "";
  start := df_find_line(file, after);
  fl_at := 0;    // file offset of line `start`
  if start > 0 { line := 1; while line < start && fl_at < file.count { if file[fl_at] == 10 { line += 1; } fl_at += 1; } }
  cs_diff(a, path, adds, dels, true, old, after);
  sb: [2048] u8; sn := cd_cat(sb[..], 0, "Updated "); tb: [16] u8;
  sn = cd_cat(sb[..], sn, rel); sn = cd_cat(sb[..], sn, " (+"); sn = cd_cat(sb[..], sn, cd_itoa(adds, tb[..]));
  sn = cd_cat(sb[..], sn, " -"); sn = cd_cat(sb[..], sn, cd_itoa(dels, tb[..])); sn = cd_cat(sb[..], sn, ")");
  df_note(a, cast(string) sb[0..<sn]);
  hl_b: [1] TuiHl; hl := hl_b[..];
  rows := 0;
  // context before the edit, from the file
  if start > 1 {
    first := ifx start - DF_CONTEXT > 1 then start - DF_CONTEXT else 1;
    at := fl_at; line := start;
    while line > first && at > 0 { at -= 1; while at > 0 && file[at - 1] != 10 { at -= 1; } line -= 1; }
    for ln: first..<start { e := at; while e < file.count && file[e] != 10 { e += 1; } df_row(a, ln, ' ', cast(string) file[at..<e], lang, hl); rows += 1; at = e + 1; }
  }
  // the edit: unchanged lines far from a change fold into "…"
  hidden := false;
  for k: 0..<ops[0].n {
    if rows >= DF_SHOWN { break; }
    kind := ops[0].kind[k];
    if kind == DF_SAME {
      near := false;
      for d: 1..<DF_CONTEXT + 1 { if (k - d >= 0 && ops[0].kind[k - d] != DF_SAME) || (k + d < ops[0].n && ops[0].kind[k + d] != DF_SAME) { near = true; } }
      if !near { if !hidden { cd_commit(a, TUI_FAINT, "      …"); hidden = true; rows += 1; } continue; }
    }
    hidden = false;
    oi := ops[0].oi[k]; ni := ops[0].ni[k];
    num := 0;
    if start > 0 { num = ifx kind == DF_DEL then start + oi else start + ni; }
    df_row(a, num, ifx kind == DF_ADD then '+' else ifx kind == DF_DEL then '-' else ' ',
           ifx kind == DF_DEL then df_line(old, ol, oi) else df_line(after, nl, ni), lang, hl);
    rows += 1;
  }
  // context after the edit
  if start > 0 && rows < DF_SHOWN {
    at := fl_at + after.count; line := start + nl[0].n;
    if at < file.count && file[at] == 10 { at += 1; }
    else { e := at; while e < file.count && file[e] != 10 { e += 1; } at = ifx e < file.count then e + 1 else e; }
    for c: 0..<DF_CONTEXT {
      if at >= file.count { break; }
      e := at; while e < file.count && file[e] != 10 { e += 1; }
      df_row(a, line, ' ', cast(string) file[at..<e], lang, hl); rows += 1;
      line += 1; at = e + 1;
    }
  }
  if rows >= DF_SHOWN { cd_commit(a, TUI_FAINT, "      … more lines"); }
}

// A path inside the working directory, relative to it.
df_rel :: (a: [] App, path: string) -> string {
  if a[0].cwd.count > 0 && path.count > a[0].cwd.count + 1 && cast(string) path[0..<a[0].cwd.count] == a[0].cwd && path[a[0].cwd.count] == '/' {
    return cast(string) path[a[0].cwd.count + 1..<path.count];
  }
  return path;
}

// A change as Codex reports it (a fileChange item's change): kind "add" or
// "delete" with the file's text, "update" with a unified diff whose hunk
// headers give the line numbers. Shown like df_show: added and removed
// lines on green and red, the context the diff carries, "…" between hunks.
df_unified :: (a: [] App, path: string, kind: string, diff: string) {
  rel := df_rel(a, path);
  lang := tui_hl_lang(path);
  hl_b: [1] TuiHl; hl := hl_b[..];
  tb: [16] u8;
  if kind == "delete" { cs_diff(a, path, 0, 0, false, "", ""); nb: [2048] u8; nn := cd_cat(nb[..], 0, "Deleted "); nn = cd_cat(nb[..], nn, rel); df_note(a, cast(string) nb[0..<nn]); return; }
  hunks := false;
  i := 0;
  while i < diff.count { if i + 3 <= diff.count && cast(string) diff[i..<i + 3] == "@@ " { hunks = true; break; } while i < diff.count && diff[i] != 10 { i += 1; } i += 1; }
  if kind == "add" || !hunks {
    nl_b: [1] DfLines; nl := nl_b[..]; df_split(diff, nl);
    cs_diff(a, path, nl[0].n, 0, kind == "add", "", diff);
    nb: [2048] u8; nn := cd_cat(nb[..], 0, "Wrote ");
    nn = cd_cat(nb[..], nn, cd_itoa(nl[0].n, tb[..])); nn = cd_cat(nb[..], nn, ifx nl[0].n == 1 then " line to " else " lines to ");
    nn = cd_cat(nb[..], nn, rel);
    df_note(a, cast(string) nb[0..<nn]);
    shown := ifx nl[0].n < 12 then nl[0].n else 12;
    for k: 0..<shown { df_row(a, k + 1, ' ', df_line(diff, nl, k), lang, hl); }
    if nl[0].n > shown { mb: [64] u8; mn := cd_cat(mb[..], 0, "      … "); mn = cd_cat(mb[..], mn, cd_itoa(nl[0].n - shown, tb[..])); mn = cd_cat(mb[..], mn, " more lines"); cd_commit(a, TUI_FAINT, cast(string) mb[0..<mn]); }
    return;
  }
  // count first, for the header
  adds := 0; dels := 0; at := 0;
  while at < diff.count {
    e := at; while e < diff.count && diff[e] != 10 { e += 1; }
    line := cast(string) diff[at..<e];
    if line.count > 0 && line[0] == '+' && !(line.count >= 3 && cast(string) line[0..<3] == "+++") { adds += 1; }
    if line.count > 0 && line[0] == '-' && !(line.count >= 3 && cast(string) line[0..<3] == "---") { dels += 1; }
    at = e + 1;
  }
  cs_diff(a, path, adds, dels, false, "", "");
  sb: [2048] u8; sn := cd_cat(sb[..], 0, "Updated ");
  sn = cd_cat(sb[..], sn, rel); sn = cd_cat(sb[..], sn, " (+"); sn = cd_cat(sb[..], sn, cd_itoa(adds, tb[..]));
  sn = cd_cat(sb[..], sn, " -"); sn = cd_cat(sb[..], sn, cd_itoa(dels, tb[..])); sn = cd_cat(sb[..], sn, ")");
  df_note(a, cast(string) sb[0..<sn]);
  old_n := 0; new_n := 0; rows := 0; seen := 0; in_hunk := false;
  at = 0;
  while at < diff.count && rows < DF_SHOWN {
    e := at; while e < diff.count && diff[e] != 10 { e += 1; }
    line := cast(string) diff[at..<e];
    at = e + 1;
    if line.count >= 3 && cast(string) line[0..<3] == "@@ " {
      // @@ -a,b +c,d @@
      j := 3; while j < line.count && line[j] != '-' { j += 1; }
      j += 1; v := 0; while j < line.count && line[j] >= '0' && line[j] <= '9' { v = v * 10 + cast(int) (line[j] - '0'); j += 1; }
      old_n = v;
      while j < line.count && line[j] != '+' { j += 1; }
      j += 1; v = 0; while j < line.count && line[j] >= '0' && line[j] <= '9' { v = v * 10 + cast(int) (line[j] - '0'); j += 1; }
      new_n = v;
      if seen > 0 { cd_commit(a, TUI_FAINT, "      …"); rows += 1; }
      seen += 1; in_hunk = true;
      continue;
    }
    if !in_hunk { continue; }      // ---/+++ headers
    if line.count == 0 { df_row(a, new_n, ' ', "", lang, hl); old_n += 1; new_n += 1; rows += 1; continue; }
    c := line[0];
    code := cast(string) line[1..<line.count];
    if c == '+' { df_row(a, new_n, '+', code, lang, hl); new_n += 1; rows += 1; }
    else if c == '-' { df_row(a, old_n, '-', code, lang, hl); old_n += 1; rows += 1; }
    else if c == ' ' { df_row(a, new_n, ' ', code, lang, hl); old_n += 1; new_n += 1; rows += 1; }
  }
  if rows >= DF_SHOWN && at < diff.count { cd_commit(a, TUI_FAINT, "      … more lines"); }
}
