// The shared-checkout guard as a Claude Code PreToolUse hook (GitHub #13771): a Claude sub-agent's
// Bash commands go through the same check as Microcoder's shell tool
// (coax/lib/microcoder/git-guard.coax mc_gg_refuse), so neither can git stash, reset --hard and the
// rest in a main checkout other chats work in. coder/tui/claudeworker.coax starts Claude Code with
// this program as its PreToolUse hook for Bash; Coder Desktop ships it beside claudeworker.
//
//   in   the hook's JSON on stdin: {"tool_name":"Bash","tool_input":{"command":"..."},"cwd":"/path",...}
//   out  exit 0: the call runs. Exit 2: refused, why on stderr, which Claude Code hands to Claude.
//
// A call to any other tool runs. A Bash call whose JSON can't be read is refused: the guard never
// lets through what it could not check. HOME is the hook's own (Claude Code passes its environment on).
//
//   coax/web/tool.sh coder/tui/gitguard.coax < hook.json

#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/proc.coax";
#load "../../coax/lib/json/json.coax";
#load "../../coax/lib/microcoder/git-guard.coax";

cxterm_byte :: (timeout_ms: int) -> int #foreign #effects(all);

GH_INPUT :: 1048576;
GH_NODES :: 4096;

// Why the call in input (a PreToolUse hook's JSON) is refused, into out; "" when it runs. cwd is
// the hook's own folder, for a call whose JSON names none.
gh_decide :: (input: string, cwd: string, home: string, out: [] u8) -> string {
  nodes: [GH_NODES] JvNode; d: [1] Jv;
  parsed := jv_parse(d[..], input, nodes[..]);
  if !parsed { return "Refused: the shared-checkout guard could not read this tool call. Nothing ran."; }
  v := d[0];
  nb: [64] u8;
  nn := jv_str(v, jv_path(v, 0, "tool_name"), nb[..]);
  if nn < 0 || cast(string) nb[0..<nn] != "Bash" { return ""; }
  at := jv_path(v, 0, "tool_input.command");
  if at < 0 { return ""; }
  cb: [65536] u8;
  cn := jv_str(v, at, cb[..]);
  if cn < 0 { return "Refused: this command is too long for the shared-checkout guard to read. Nothing ran. Split it into shorter commands."; }
  wb: [4096] u8;
  wn := jv_str(v, jv_path(v, 0, "cwd"), wb[..]);
  here := ifx wn > 0 then cast(string) wb[0..<wn] else cwd;
  return mc_gg_refuse(here, cast(string) cb[0..<cn], home, out);
}

tool_main :: () -> int #export_c #effects(all) {
  input: [GH_INPUT] u8; n := 0;
  b := cxterm_byte(5000);
  while b >= 0 {
    if n >= input.count { tool_errln("Refused: the tool call is larger than the shared-checkout guard reads (1 MiB). Nothing ran."); return 2; }
    input[n] = cast,trunc(u8) b; n += 1;
    b = cxterm_byte(5000);
  }
  hb: [4096] u8; cb: [4096] u8; out: [2048] u8;
  why := gh_decide(cast(string) input[0..<n], fs_cwd(cb[..]), proc_getenv("HOME", hb[..]), out[..]);
  if why.count == 0 { return 0; }
  tool_errln(why);
  return 2;
}

#test "the hook passes other tools and safe commands, and refuses unreadable Bash calls" {
  out: [2048] u8;
  #assert gh_decide("{\"tool_name\":\"Read\",\"tool_input\":{\"file_path\":\"/x\"}}", "", "/h", out[..]) == "";
  #assert gh_decide("{\"tool_name\":\"Bash\",\"tool_input\":{}}", "", "/h", out[..]) == "";
  // no folder known anywhere counts as shared, so a refused form is refused and a read is not
  #assert gh_decide("{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git status\"}}", "", "/h", out[..]) == "";
  r := gh_decide("{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git stash\"}}", "", "/h", out[..]);
  #assert mc_cmd_starts(r, "Refused: `git stash` would change the files of a shared checkout");
  #assert mc_cmd_starts(gh_decide("{\"tool_name\":\"Bash\"", "", "/h", out[..]), "Refused: the shared-checkout guard could not read");
  // the JSON's own escapes are undone before the command is read
  r = gh_decide("{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"echo \\\"hi\\\" && git reset --hard\"}}", "", "/h", out[..]);
  #assert mc_cmd_starts(r, "Refused: `git reset --hard`");
  // which folders are main checkouts is the filesystem's: coder/tui/gitguard-test.sh runs those
}
