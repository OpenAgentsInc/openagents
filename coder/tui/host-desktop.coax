// Coder Desktop's chats on the paired phone (GitHub #13713). Since #13694 the daemon
// (`coder host serve`) runs each Coder Desktop chat's worker as a run under
// ~/.openagents/coder/host/runs (host-runs.coax). This file shows those runs to a paired phone over
// the same environment methods and the same admission as the computer's own sessions:
//
//   ListSessions   each chat whose worker runs in the grant's workspace, as a session
//                  "desktop-RUN" with "surface":"coder-desktop" (EaSession.desktop)
//   ReadSession    the chat's transcript, built from the run's worker lines (ID.out): each turn's
//                  message, thoughts, replies, commands, file reads and sub-agent calls, paged as
//                  any session is (es_project_at)
//   ReadSubagent   a sub-agent call's own transcript: the run the chat's Coder started for it (an
//                  mcworker or claudeworker run whose task line names the chat's session)
//   SendMessage    while a turn runs, a steer for it (mww_steer); while none runs, a follow-up the
//                  worker starts at once (mww_queue add, then promote now)
//   StopTurn       ends the running turn (mww_interrupt) and stops its sub-agents' workers
//   StopSubagent   stops one running sub-agent's worker, the one a ReadSession item's call started
//                  (GitHub #13776): its siblings and the turn go on, and Coder Desktop reads that
//                  sub-agent's worker end as it reads any, so the chat's run is told it stopped
//
// The phone never starts, stops or forgets a run: StartRun, StopRun, ListRuns and ForgetRun stay
// on the local socket (daemon-wire.coax). Its lines go into the run's ID.in, which the daemon
// forwards as it forwards Coder's (both append whole lines with O_APPEND), so Coder Desktop sees a
// phone's follow-up as a queued turn and a phone's steer by the words the worker says back.
// Everything here reads the worker's own lines (mcworker-wire.coax); no transcript text is ever
// taken as an operation.
//
// A chat is the phone's only when its worker's folder (the task line's "cwd") is the grant's
// workspace or inside it, as a session the phone opens is.
//
// A chat's session id is its Coder chat id (the UUID its queue is bound to, without dashes), so it
// stays the same across the runs Coder starts for it and after them (GitHub #13755): once Coder
// forgets a run (its files are gone), the phone reads the chat Coder saved,
// ~/Library/Application Support/Coder/chats/ID.json, read only. Its title is the one Coder shows
// (chats/index.json), else the daemon's session meta, else its first message. A run whose queue is
// not bound yet goes by its run id.

DK_PREFIX :: "desktop-";
DK_RUNS :: 64;
DK_HEAD :: 131072;         // bytes of a run's input a listing reads (its first task, its queue key)
DK_FILE :: 1048576;        // bytes of a run's input or output read whole (the newest, past that)
DK_TAIL :: 512;            // bytes of a run's task text kept to match a sub-agent run to its call
DK_ARENA :: 262144;

DkInfo :: struct {
  id: [32] u8; state: [16] u8; ns: int; started: int; ended: int; out: int; updated: int;
  session: [192] u8; nsession: int;      // the worker's session ("coder-desktop-UUID"; a sub-agent's adds "-agent-J-UUID")
  cwd: [1024] u8; ncwd: int;
  title: [256] u8; nt: int;              // its first message, cut
  tail: [DK_TAIL] u8; ntail: int;        // the end of its first task's text
  key: [128] u8; nkey: int;              // the chat's id, from the queue's open line
  model: [64] u8; nmo: int;              // the task line's model slug (e.g. "gemini-4-neon" / "inkling-2-mini")
  effort: [16] u8; nef: int;             // the task line's thinking effort ("low" / "medium" / "high" / "xhigh")
  busy: bool;                            // a turn of it runs: its newest turn line is after its newest ended line
}

dk_is :: (id: string) -> bool { return id.count == DK_PREFIX.count + 32 && hs_prefix(id, DK_PREFIX) && ea_id(cast(string) id[DK_PREFIX.count..<id.count], 32); }
dk_run_of :: (id: string) -> string { return cast(string) id[DK_PREFIX.count..<id.count]; }
dk_has :: (s: string, needle: string) -> bool {
  if needle.count == 0 || needle.count > s.count { return needle.count == 0; }
  for i: 0..<s.count - needle.count + 1 { if cast(string) s[i..<i + needle.count] == needle { return true; } }
  return false;
}
// A run this host started for a phone's chat (host-phone.coax): its task lines name "phone-ID".
dk_phone :: (r: [] DkInfo) -> bool { return hs_prefix(cast(string) r[0].session[0..<r[0].nsession], PH_SESSION); }
dk_top :: (r: [] DkInfo) -> bool { return r[0].nsession > 0 && !dk_has(cast(string) r[0].session[0..<r[0].nsession], "-agent-"); }
dk_running :: (r: [] DkInfo) -> bool { return cast(string) r[0].state[0..<r[0].ns] == "running"; }

// A Coder chat id ("8-4-4-4-12" lowercase hex) as the 32 hex digits of its session id, or false.
dk_hex_key :: (key: string, out: [] u8) -> bool {
  if key.count != 36 || out.count < 32 { return false; }
  n := 0;
  for c, i: key {
    if i == 8 || i == 13 || i == 18 || i == 23 { if c != '-' { return false; } continue; }
    if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) { return false; }
    out[n] = c; n += 1;
  }
  return n == 32;
}
// The 32 hex digits the run goes by on the phone: its chat's id, else its own.
dk_hex :: (r: [] DkInfo, out: [] u8) -> string {
  if dk_hex_key(cast(string) r[0].key[0..<r[0].nkey], out) { return cast(string) out[0..<32]; }
  return cast(string) r[0].id[..];
}

// ---------------------------------------------------------------- the chats Coder saved

DK_CHATS :: 128;
DK_INDEX :: 262144;        // bytes of Coder's chat list read
DkChat :: struct {
  id: [64] u8; ni: int; hex: [32] u8; has_hex: bool;
  title: [256] u8; nt: int;
  folder: [1024] u8; nf: int;
  updated: int;            // seconds
}
// Where Coder keeps its chats: $HOME/Library/Application Support/Coder/chats/NAME.
dk_chat_path :: (name: string, out: [] u8) -> string {
  hb: [1024] u8; home := hs_home(hb[..]);
  if home.count == 0 { return ""; }
  n := hs_cat(out, 0, home); n = hs_cat(out, n, "/Library/Application Support/Coder/chats/"); n = hs_cat(out, n, name);
  return cast(string) out[0..<n];
}
// The whole seconds of a JSON number ("1795136276.25").
dk_seconds :: (raw: string) -> int {
  v := 0;
  for c: raw { if c < '0' || c > '9' { break; } v = v * 10 + cast(int) (c - '0'); }
  return v;
}
// Coder's chat list (chats/index.json): every chat but Foreman's, at most chats.count.
dk_chats :: (chats: [] DkChat) -> int {
  pb: [1400] u8; b: [DK_INDEX] u8; n := fs_read(dk_chat_path("index.json", pb[..]), b[..]);
  if n < 2 || n >= b.count { return 0; }
  text := cast(string) b[0..<n]; count := 0;
  ab: [8192] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  for i: 0..<cl_count(text) {
    if count >= chats.count { break; }
    one := cl_json(text, cl_item(text, i));
    ar[0].at = 0; ar[0].full = false;
    id := cl_str(ar[..], one, "id");
    if id.count == 0 || id.count > 64 || id == "foreman" { continue; }
    c := chats[count..<count + 1]; c[0] = DkChat.{};
    c[0].ni = hs_set(c[0].id[..], id); c[0].has_hex = dk_hex_key(id, c[0].hex[..]);
    c[0].nt = hs_set(c[0].title[..], hs_cut(cl_str(ar[..], one, "title"), 200));
    c[0].nf = hs_set(c[0].folder[..], cl_str(ar[..], one, "folder"));
    c[0].updated = dk_seconds(cl_raw(one, "updated"));
    if c[0].has_hex { count += 1; }
  }
  return count;
}
// The projects a phone may start a chat in: the workspace itself (named by its folder, "openagents")
// and each other project Coder's chats work in inside it: a chat's repository root ("repo_root",
// so a chat in a worktree counts as its repository), else its folder. Never the workspace's
// subfolders as such, and nothing outside the workspace the pairing allows.
dk_projects :: (root: string, v: [] EaView) {
  v[0].nfolders = 0; v[0].nroot = 0;
  if root.count == 0 { return; }
  v[0].nroot = ea_copy(v[0].root[..], hs_cut(fs_base(root), 80)); if v[0].nroot < 0 { v[0].nroot = 0; }
  pb: [1400] u8; b: [DK_INDEX] u8; n := fs_read(dk_chat_path("index.json", pb[..]), b[..]);
  if n < 2 || n >= b.count { return; }
  text := cast(string) b[0..<n];
  ab: [8192] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  for i: 0..<cl_count(text) {
    if v[0].nfolders >= EA_FOLDERS { break; }
    one := cl_json(text, cl_item(text, i));
    ar[0].at = 0; ar[0].full = false;
    at := cl_str(ar[..], one, "repo_root"); if at.count == 0 { at = cl_str(ar[..], one, "folder"); }
    real: [1024] u8; path := fs_realpath(at, real[..]);
    rel := dk_project_rel(root, path);
    if rel.count == 0 || fs_kind(path) != FS_DIR { continue; }
    _ = dk_project_add(v, rel);
  }
}
// `path` (canonical) as a project under `root`: its path from root, or "" for root itself, a path
// outside it, or one through a hidden or dot folder (a worktree under .claude, say).
dk_project_rel :: (root: string, path: string) -> string {
  if root.count == 0 || path.count <= root.count + 1 || cast(string) path[0..<root.count] != root || path[root.count] != '/' { return ""; }
  rel := cast(string) path[root.count + 1..<path.count];
  return ifx ea_folder_ok(rel) then rel else "";
}
dk_project_add :: (v: [] EaView, rel: string) -> bool {
  for k: 0..<v[0].nfolders { if cast(string) v[0].folders[k].path[0..<v[0].folders[k].np] == rel { return false; } }
  if v[0].nfolders >= EA_FOLDERS { return false; }
  f := v[0].folders[v[0].nfolders..<v[0].nfolders + 1]; f[0].np = ea_copy(f[0].path[..], rel);
  if f[0].np < 1 { f[0].np = 0; return false; }
  v[0].nfolders += 1; return true;
}
dk_chat_of :: (chats: [] DkChat, nc: int, key: string) -> int {
  for i: 0..<nc { if key.count > 0 && cast(string) chats[i].id[0..<chats[i].ni] == key { return i; } }
  return -1;
}
dk_chat_by_hex :: (chats: [] DkChat, nc: int, hex: string) -> int {
  if hex.count != 32 { return -1; }
  for i: 0..<nc { if chats[i].has_hex && cast(string) chats[i].hex[..] == hex { return i; } }
  return -1;
}
// Number of turns recorded in run id's output log.
dk_run_turns :: (id: string, file: [] u8, ab: [] u8) -> int {
  op: [1400] u8; t := dk_read_tail(dr_file(id, ".out", op[..]), file);
  next := [1] int.[0]; ar := [1] ClArena.[ClArena.{buf = ab}]; l: [1] MwwLine; turns := 0;
  while true {
    line := dk_line(t, next[..]);
    if line.count == 0 { if next[0] >= t.count { break; } continue; }
    ar[0].at = 0; ar[0].full = false;
    if mww_read(ar[..], line, l[..]) == MWW_TURN { turns += 1; }
  }
  return turns;
}
// Number of turns saved in Coder's chat file (0 when missing, -1 when file exceeds buffer).
dk_saved_turn_count :: (c: [] DkChat, file: [] u8) -> int {
  nb: [128] u8; nn := hs_cat(nb[..], 0, cast(string) c[0].id[0..<c[0].ni]); nn = hs_cat(nb[..], nn, ".json");
  pb: [1400] u8; path := dk_chat_path(cast(string) nb[0..<nn], pb[..]);
  sz := fs_size(path);
  if sz < 2 { return 0; }
  if sz > file.count { return -1; }
  n := fs_read(path, file[0..<sz]);
  if n < 2 { return 0; }
  return cl_count(cl_raw(cast(string) file[0..<n], "turns"));
}
// Saved chat index when Desktop persisted turns beyond what phone run r's .out holds, else -1.
dk_desktop_ahead :: (r: [] DkInfo, chats: [] DkChat, nc: int, file: [] u8, ab: [] u8) -> int {
  if !dk_phone(r) || r[0].busy { return -1; }
  id := cast(string) r[0].id[..];
  c := dk_chat_by_hex(chats, nc, id);
  if c < 0 { return -1; }
  saved_n := dk_saved_turn_count(chats[c..<c + 1], file);
  if saved_n == 0 { return -1; }
  ran_n := dk_run_turns(id, file, ab);
  base := ph_base(id);
  if saved_n > base + ran_n { return c; }
  if saved_n < 0 && chats[c].updated * 1000 > r[0].updated { return c; }
  return -1;
}
dk_is_desktop_ahead :: (r: [] DkInfo, chats: [] DkChat, nc: int) -> bool {
  file: [DK_FILE] u8; ab: [DK_ARENA] u8;
  return dk_desktop_ahead(r, chats, nc, file[..], ab[..]) >= 0;
}

// The whole lines of b, one at a time: next[0] is where the next starts. A line not ended by a
// newline (still being written) is not one.
dk_line :: (b: string, next: [] int) -> string {
  at := next[0];
  if at >= b.count { return ""; }
  e := at; while e < b.count && b[e] != '\n' { e += 1; }
  if e >= b.count { next[0] = b.count; return ""; }
  next[0] = e + 1;
  return cast(string) b[at..<e];
}
// The newest up to DK_FILE bytes of a run's file into out, from a line's start: what was read.
dk_read_tail :: (path: string, out: [] u8) -> string {
  size := fs_size(path);
  if size < 1 { return ""; }
  from := ifx size > out.count then size - out.count else 0;
  n := fs_read_at(path, from, out);
  if n < 1 { return ""; }
  at := 0;
  if from > 0 { while at < n && out[at] != '\n' { at += 1; } at += 1; }
  return ifx at < n then cast(string) out[at..<n] else "";
}

// What a run is, from its state file, the head of its input and the tail of its output.
dk_info :: (id: string, r: [] DkInfo) -> bool {
  r[0] = DkInfo.{};
  st: [1] DmRun;
  if !ea_id(id, 32) || !dr_state_read(id, st[..]) { return false; }
  _ = hs_set(r[0].id[..], id);
  r[0].ns = ea_copy(r[0].state[..], cast(string) st[0].state[0..<st[0].ns]);
  r[0].started = st[0].started; r[0].ended = st[0].ended; r[0].out = st[0].out;
  ip: [1400] u8; head: [DK_HEAD] u8; n := fs_read(dr_file(id, ".in", ip[..]), head[..]);
  defer { for i: 0..<head.count { head[i] = 0; } }
  if n < 1 { return false; }
  b := cast(string) head[0..<n]; next := [1] int.[0];
  ab: [65536] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}]; q: [1] MwwRequest;
  while true {
    line := dk_line(b, next[..]);
    if line.count == 0 { if next[0] >= b.count { break; } continue; }
    ar[0].at = 0; ar[0].full = false;
    k := mww_request(ar[..], line, q[..]);
    if k == MWW_TASK {
      if r[0].nsession == 0 {
        r[0].nsession = hs_set(r[0].session[..], q[0].session);
        r[0].ncwd = hs_set(r[0].cwd[..], q[0].cwd);
        r[0].nt = hs_set(r[0].title[..], hs_cut(q[0].task, 200));
        t := q[0].task; from := ifx t.count > DK_TAIL then t.count - DK_TAIL else 0;
        while from < t.count && (t[from] & 0xc0) == 0x80 { from += 1; }
        r[0].ntail = hs_set(r[0].tail[..], cast(string) t[from..<t.count]);
      }
      m := q[0].model;
      if hs_prefix(m, "agy:") { m = cast(string) m[4..<m.count]; }
      if q[0].local && m.count == 0 { m = PA_INKLING_ID; }
      if m.count > 0 && ea_choice(m) { r[0].nmo = hs_set(r[0].model[..], m); }
      if q[0].effort.count > 0 && ea_choice(q[0].effort) { r[0].nef = hs_set(r[0].effort[..], q[0].effort); }
    }
    if k == MWW_QUEUE && q[0].op == "open" && q[0].key.count > 0 && q[0].key.count <= 128 { r[0].nkey = hs_set(r[0].key[..], q[0].key); }
  }
  if r[0].nsession == 0 { return false; }
  // a turn runs while the newest turn line is after the newest ended line
  op: [1400] u8; out := dr_file(id, ".out", op[..]);
  tail: [65536] u8; t := dk_read_tail(out, tail[..]); tn := [1] int.[0];
  turn := -1; ended := -1; k := 0;
  while true {
    line := dk_line(t, tn[..]);
    if line.count == 0 { if tn[0] >= t.count { break; } continue; }
    if hs_prefix(line, "{\"kind\":\"turn\"") { turn = k; }
    if hs_prefix(line, "{\"kind\":\"ended\"") { ended = k; }
    k += 1;
  }
  r[0].busy = dk_running(r) && turn > ended;
  mt := fs_mtime_ns(out); r[0].updated = ifx mt > 0 then mt / 1000000 else r[0].started * 1000;
  return true;
}

// Every run that has a state file, at most DK_RUNS.
dk_all :: (runs: [] DkInfo) -> int {
  l: [1] FsList; p: [1400] u8; n := fs_list(es_path("runs", p[..]), l[..]); count := 0;
  for i: 0..<n {
    if count >= runs.count { break; }
    name := fs_entry(l[..], i);
    if name.count != 38 || !hs_ends(name, ".state") { continue; }
    if dk_info(cast(string) name[0..<32], runs[count..<count + 1]) { count += 1; }
  }
  return count;
}

// Whether the run's folder is the grant's workspace or inside it, or a chat's own worktree of a
// repository that is (GitHub #13758): Coder Desktop runs a new chat in
// ~/.openagents/worktrees/REPO/CHAT, whose .git file names the main checkout's .git/worktrees/NAME.
dk_scoped :: (h: [] HsHost, r: [] DkInfo) -> bool { return dk_inside(h, cast(string) r[0].cwd[0..<r[0].ncwd]); }
dk_inside :: (h: [] HsHost, folder: string) -> bool {
  c := h[0].environment[0].configuration[..];
  root := cast(string) c[0].workspace[0..<c[0].nw];
  real: [1024] u8; at := fs_realpath(folder, real[..]);
  if root.count == 0 || at.count == 0 { return false; }
  if at == root || es_folder_inside(root, at) { return true; }
  hb: [1024] u8; home := hs_home(hb[..]);
  if home.count == 0 { return false; }
  wb: [1200] u8; n := hs_cat(wb[..], 0, home); n = hs_cat(wb[..], n, "/.openagents/worktrees");
  wr: [1024] u8; worktrees := ifx n > 0 then fs_realpath(cast(string) wb[0..<n], wr[..]) else "";
  if worktrees.count == 0 || !es_folder_inside(worktrees, at) { return false; }
  gb: [1100] u8; gf: [2048] u8; g := fs_read(fs_join(at, ".git", gb[..]), gf[..]);
  if g < 1 { return false; }
  sr: [1024] u8; source := dk_worktree_source(cast(string) gf[0..<g]);
  src := ifx source.count > 0 then fs_realpath(source, sr[..]) else "";
  return src.count > 0 && (src == root || es_folder_inside(root, src));
}
// The main checkout a worktree's .git file names ("gitdir: /w/repo/.git/worktrees/NAME"): "/w/repo",
// or "" when the file says anything else.
dk_worktree_source :: (gitfile: string) -> string {
  if gitfile.count < 9 || cast(string) gitfile[0..<9] != "gitdir: /" { return ""; }
  e := gitfile.count;
  while e > 0 && (gitfile[e - 1] == '\n' || gitfile[e - 1] == '\r' || gitfile[e - 1] == ' ') { e -= 1; }
  dir := cast(string) gitfile[8..<e];
  mark := "/.git/worktrees/";
  at := -1;
  for i: 0..<dir.count - mark.count + 1 { if cast(string) dir[i..<i + mark.count] == mark { at = i; } }
  if at < 1 { return ""; }
  rest := cast(string) dir[at + mark.count..<dir.count];
  if rest.count == 0 { return ""; }
  for b: rest { if b == '/' { return ""; } }
  return cast(string) dir[0..<at];
}

// The run as the phone's session: its id, the chat's title (the one Coder shows, else the name
// given in the daemon's session meta, else its first message), available while its worker runs and
// read only after.
dk_summary :: (r: [] DkInfo, chats: [] DkChat, nc: int, s: [] EaSession) {
  s[0] = EaSession.{};
  // a phone's own chat keeps the 32-hex id the phone gave it, even while Desktop runs a turn in it
  hx: [32] u8; hex := dk_hex(r, hx[..]);
  is_ph := dk_phone(r) || ph_is(hex);
  b: [64] u8; n := ifx is_ph then 0 else hs_cat(b[..], 0, DK_PREFIX); n = hs_cat(b[..], n, hex);
  s[0].ni = ea_copy(s[0].id[..], cast(string) b[0..<n]); s[0].nw = ea_copy(s[0].workspace[..], "default");
  title := cast(string) r[0].title[0..<r[0].nt];
  meta: [DM_META_MAX] DmSessionMeta; nm := dm_meta_load(meta[..]); key := cast(string) r[0].key[0..<r[0].nkey];
  for i: 0..<nm { if key.count > 0 && cast(string) meta[i].id[0..<meta[i].ni] == key && meta[i].nt > 0 { title = cast(string) meta[i].title[0..<meta[i].nt]; } }
  c := dk_chat_of(chats, nc, key);
  if c < 0 { c = dk_chat_by_hex(chats, nc, hex); }
  if c >= 0 && chats[c].nt > 0 { title = cast(string) chats[c].title[0..<chats[c].nt]; }
  s[0].nt = ea_copy(s[0].title[..], hs_cut(title, 200)); if s[0].nt < 0 { s[0].nt = 0; }
  s[0].managed = true; s[0].desktop = true;
  s[0].nc = ea_copy(s[0].control[..], ifx dk_running(r) then "available" else "observe-only");
  s[0].generation = r[0].started * 1000; s[0].revision = r[0].out; s[0].busy = r[0].busy; s[0].updated = r[0].updated;
  // a phone's chat takes messages after its worker ended too (it starts again), under one generation
  if is_ph {
    s[0].nc = ea_copy(s[0].control[..], "available");
    g := ph_generation(hex); if g > 0 { s[0].generation = g; }
    if c >= 0 && chats[c].updated * 1000 > s[0].updated {
      s[0].updated = chats[c].updated * 1000;
      s[0].revision += chats[c].updated;
    }
    mb: [1024] u8; ob: [64] u8; eb: [16] u8; pm := ph_meta_read(hex, mb[..]);
    m := ifx !dk_phone(r) && r[0].nmo > 0 then cast(string) r[0].model[0..<r[0].nmo] else ph_model_in(pm, ob[..]);
    if m.count > 0 { s[0].nmo = ea_copy(s[0].model[..], m); if s[0].nmo < 0 { s[0].nmo = 0; } }
    ef := ifx !dk_phone(r) && r[0].nef > 0 then cast(string) r[0].effort[0..<r[0].nef] else ph_effort_in(pm, eb[..]);
    if ef.count == 0 { ef = pa_effort(pa_engine_of(m), m, ""); }
    if ef.count > 0 { s[0].nef = ea_copy(s[0].effort[..], ef); if s[0].nef < 0 { s[0].nef = 0; } }
    // and, when it fell back, says so on the session (never as an item: TestFlight 1413 would draw it as the reply)
    nb: [EA_NOTE] u8; note := ph_note_in(pm, nb[..]);
    if note.count > 0 { s[0].nno = ea_copy(s[0].note[..], note); if s[0].nno < 0 { s[0].nno = 0; } }
  } else {
    if r[0].nmo > 0 { s[0].nmo = ea_copy(s[0].model[..], cast(string) r[0].model[0..<r[0].nmo]); if s[0].nmo < 0 { s[0].nmo = 0; } }
    if r[0].nef > 0 { s[0].nef = ea_copy(s[0].effort[..], cast(string) r[0].effort[0..<r[0].nef]); if s[0].nef < 0 { s[0].nef = 0; } }
  }
}
// The session `id` names (a Coder Desktop chat, or a phone's run) into v's sessions, when it is the grant's.
dk_read_summary :: (h: [] HsHost, id: string, v: [] EaView) {
  runs: [DK_RUNS] DkInfo; n := dk_all(runs[..]);
  chats: [DK_CHATS] DkChat; nc := dk_chats(chats[..]);
  k := dk_find(h, id, runs[..], n);
  if k >= 0 && v[0].ns < 128 { dk_summary(runs[k..<k + 1], chats[..], nc, v[0].sessions[v[0].ns..<v[0].ns + 1]); v[0].ns += 1; }
}

// A chat Coder saved, with no run left, as the phone's session: read only, nothing running.
dk_saved_summary :: (c: [] DkChat, s: [] EaSession) {
  s[0] = EaSession.{};
  hex := cast(string) c[0].hex[..];
  is_ph := ph_is(hex);
  b: [64] u8; n := ifx is_ph then 0 else hs_cat(b[..], 0, DK_PREFIX); n = hs_cat(b[..], n, hex);
  s[0].ni = ea_copy(s[0].id[..], cast(string) b[0..<n]); s[0].nw = ea_copy(s[0].workspace[..], "default");
  s[0].nt = ea_copy(s[0].title[..], hs_cut(cast(string) c[0].title[0..<c[0].nt], 200)); if s[0].nt < 0 { s[0].nt = 0; }
  s[0].managed = true; s[0].desktop = true;
  s[0].nc = ea_copy(s[0].control[..], ifx is_ph then "available" else "observe-only");
  s[0].generation = c[0].updated * 1000; s[0].revision = c[0].updated; s[0].busy = false; s[0].updated = c[0].updated * 1000;
  if is_ph {
    g := ph_generation(hex); if g > 0 { s[0].generation = g; }
    mb: [1024] u8; ob: [64] u8; eb: [16] u8; pm := ph_meta_read(hex, mb[..]);
    m := ph_model_in(pm, ob[..]);
    if m.count > 0 { s[0].nmo = ea_copy(s[0].model[..], m); if s[0].nmo < 0 { s[0].nmo = 0; } }
    ef := ph_effort_in(pm, eb[..]);
    if ef.count == 0 { ef = pa_effort(pa_engine_of(m), m, ""); }
    if ef.count > 0 { s[0].nef = ea_copy(s[0].effort[..], ef); if s[0].nef < 0 { s[0].nef = 0; } }
  }
}

// Whether run i is the one its chat goes by: of the grant's runs bound to the same chat, the
// running one, else the newest.
dk_lead :: (h: [] HsHost, runs: [] DkInfo, n: int, i: int) -> bool {
  hi: [32] u8; me := dk_hex(runs[i..<i + 1], hi[..]);
  for j: 0..<n {
    if j == i || !dk_top(runs[j..<j + 1]) || !dk_scoped(h, runs[j..<j + 1]) { continue; }
    hj: [32] u8; if dk_hex(runs[j..<j + 1], hj[..]) != me { continue; }
    ri := dk_running(runs[i..<i + 1]); rj := dk_running(runs[j..<j + 1]);
    if rj && !ri { return false; }
    if rj == ri && (runs[j].started > runs[i].started || (runs[j].started == runs[i].started && j < i)) { return false; }
  }
  return true;
}

// Maximum Desktop sessions returned in one ListSessions reply: each EaSession emits up to
// 14 JSON keys, and sealed NIP-HOST artifacts (coax/lib/nostr/jcs.coax) enforce JCS_MAX_KEYS = 1024.
// Capping at 48 sessions (newest-updated first) keeps the full reply under ~780 keys with headroom
// for offer models, efforts, folders, and envelope metadata so hb_seal never fails with JCS_LIMIT.
DK_LIST_MAX :: 48;

// ListSessions: the grant's Coder Desktop chats, running ones first, then the newest chats Coder
// saved that no run is left for, bounded to DK_LIST_MAX so sealed replies stay within JCS_MAX_KEYS.
dk_list :: (h: [] HsHost, v: [] EaView) {
  runs: [DK_RUNS] DkInfo; n := dk_all(runs[..]);
  chats: [DK_CHATS] DkChat; nc := dk_chats(chats[..]);
  // Sort runs and saved chats newest-updated first so the capped page always carries the latest chats.
  for i: 1..<n { j := i; while j > 0 && runs[j - 1].updated < runs[j].updated { t := runs[j]; runs[j] = runs[j - 1]; runs[j - 1] = t; j -= 1; } }
  for i: 1..<nc { j := i; while j > 0 && chats[j - 1].updated < chats[j].updated { t := chats[j]; chats[j] = chats[j - 1]; chats[j - 1] = t; j -= 1; } }
  for pass: 0..<2 {
    for i: 0..<n {
      r := runs[i..<i + 1];
      if !dk_top(r) || dk_running(r) != (pass == 0) || !dk_scoped(h, r) || !dk_lead(h, runs[..], n, i) { continue; }
      if v[0].ns >= DK_LIST_MAX { v[0].complete = false; return; }
      dk_summary(r, chats[..], nc, v[0].sessions[v[0].ns..<v[0].ns + 1]); v[0].ns += 1;
    }
  }
  for c: 0..<nc {
    if dk_run_for(h, runs[..], n, cast(string) chats[c].hex[..]) >= 0 || !dk_inside(h, cast(string) chats[c].folder[0..<chats[c].nf]) { continue; }
    if v[0].ns >= DK_LIST_MAX { v[0].complete = false; return; }
    dk_saved_summary(chats[c..<c + 1], v[0].sessions[v[0].ns..<v[0].ns + 1]); v[0].ns += 1;
  }
}

// ---------------------------------------------------------------- the transcript

// A sub-agent run of the chat with session `parent`: its run id, start and task text's end.
DkSub :: struct { id: [32] u8; started: int; tail: [DK_TAIL] u8; ntail: int; used: bool; running: bool; }
dk_subs :: (runs: [] DkInfo, n: int, parent: string, subs: [] DkSub) -> int {
  m := 0;
  b: [256] u8; pn := hs_cat(b[..], 0, parent); pn = hs_cat(b[..], pn, "-agent-"); prefix := cast(string) b[0..<pn];
  for i: 0..<n {
    if m >= subs.count { break; }
    if !hs_prefix(cast(string) runs[i].session[0..<runs[i].nsession], prefix) { continue; }
    subs[m] = DkSub.{}; subs[m].id = runs[i].id; subs[m].started = runs[i].started;
    subs[m].ntail = hs_set(subs[m].tail[..], cast(string) runs[i].tail[0..<runs[i].ntail]); subs[m].running = dk_running(runs[i..<i + 1]);
    m += 1;
  }
  // oldest first: a delegate line's tasks take them in the order they started
  for i: 1..<m { j := i; while j > 0 && subs[j - 1].started > subs[j].started { t := subs[j]; subs[j] = subs[j - 1]; subs[j - 1] = t; j -= 1; } }
  return m;
}
// The unused sub-agent run whose task ends with the delegated task's text, else the oldest unused.
dk_sub_for :: (subs: [] DkSub, n: int, task: string) -> int {
  want := ifx task.count > DK_TAIL then cast(string) task[task.count - DK_TAIL..<task.count] else task;
  for i: 0..<n {
    if subs[i].used { continue; }
    t := cast(string) subs[i].tail[0..<subs[i].ntail];
    if want.count > 0 && (hs_ends(t, want) || (t.count == DK_TAIL && hs_ends(want, cast(string) t[t.count / 2..<t.count]))) { return i; }
  }
  for i: 0..<n { if !subs[i].used { return i; } }
  return -1;
}

dk_tool :: (s: [] Session, name: string, tk: int, arg: string) -> int {
  k := s_part(s, P_TOOL);
  if k < 0 { return -1; }
  s[0].parts[k].name = s_put(s, name); s[0].parts[k].tk = tk; s[0].parts[k].arg = s_put(s, hs_cut(arg, 4000));
  s[0].parts[k].input = s[0].parts[k].arg;
  return k;
}
dk_done :: (s: [] Session, k: int, output: string, failed: bool) {
  if k < 0 { return; }
  s[0].parts[k].output = s_put(s, hs_cut(output, 4000)); s[0].parts[k].failed = failed; s[0].parts[k].resolved = true;
}

// Part k's sub-agent rows, from its run's lines: the calls its agent made and what it said.
dk_sub_rows :: (s: [] Session, k: int, id: string, running: bool, file: [] u8, ab: [] u8) {
  op: [1400] u8; t := dk_read_tail(dr_file(id, ".out", op[..]), file);
  next := [1] int.[0]; ar := [1] ClArena.[ClArena.{buf = ab}]; l: [1] MwwLine;
  said: [4000] u8; nsaid := 0; ended := false; ending_text: [2000] u8; nend := 0;
  while true {
    line := dk_line(t, next[..]);
    if line.count == 0 { if next[0] >= t.count { break; } continue; }
    ar[0].at = 0; ar[0].full = false;
    kind := mww_read(ar[..], line, l[..]);
    if kind == MWW_REPLY { nsaid = hs_cat(said[..], nsaid, l[0].text); continue; }
    if kind == MWW_NONE || kind == MWW_READY || kind == MWW_JOURNAL || kind == MWW_ATTEMPT || kind == MWW_THOUGHT || kind == MWW_TODOS || kind == MWW_STATS { continue; }
    if nsaid > 0 { _ = s_sub_add(s, k, false, "", cast(string) said[0..<nsaid], ""); nsaid = 0; }
    if kind == MWW_ASK {
      if s_sub_add(s, k, true, "Bash", l[0].command, "") { s[0].parts[k].subcalls += 1; dk_now(s, k, "Bash", l[0].command); }
    } else if kind == MWW_COMMAND {
      // the call its ask started, else one of its own
      r := -1; i := s[0].nsubs - 1;
      while i >= 0 { if s[0].subs[i].part == k && s[0].subs[i].tool && !s[0].subs[i].done && s[0].subs[i].text == l[0].command { r = i; break; } i -= 1; }
      if r < 0 && s_sub_add(s, k, true, "Bash", l[0].command, "") { r = s[0].nsubs - 1; s[0].parts[k].subcalls += 1; dk_now(s, k, "Bash", l[0].command); }
      if r >= 0 {
        s[0].subs[r].done = true; s[0].subs[r].output = s_put(s, hs_cut(l[0].output, S_SUB_OUT));
        s[0].subs[r].failed = (l[0].exit.ok && l[0].exit.value != 0) || (l[0].timed_out.ok && l[0].timed_out.value);
      }
    } else if kind == MWW_VIEW {
      if s_sub_add(s, k, true, "Read", l[0].path, "") {
        r := s[0].nsubs - 1; s[0].subs[r].done = true; s[0].subs[r].output = s_put(s, ifx l[0].found.ok && l[0].found.value then "" else "Not found");
        s[0].parts[k].subcalls += 1; dk_now(s, k, "Read", l[0].path);
      }
    } else if kind == MWW_ENDED {
      ended = true; nend = hs_cat(ending_text[..], 0, hs_cut(l[0].text, ending_text.count));
    }
  }
  if nsaid > 0 { _ = s_sub_add(s, k, false, "", cast(string) said[0..<nsaid], ""); }
  if ended || !running { dk_done(s, k, cast(string) ending_text[0..<nend], false); }
}
dk_now :: (s: [] Session, k: int, name: string, arg: string) {
  b: [160] u8; n := hs_cat(b[..], 0, name); n = hs_cat(b[..], n, " "); n = hs_cat(b[..], n, hs_cut(arg, 150));
  s[0].parts[k].subnow = s_put(s, hs_cut(cast(string) b[0..<n], 160));
}

// The chat's transcript from its run's lines, sub-agent calls with their own rows; stamps[k] is
// when a still running sub-agent call began (wall ms). The parts' count of stamps.
// want, with found one long: the part of a sub-agent call whose run found[0] gets (its id empty
// when that call has no run); -1 for none.
dk_session :: (r: [] DkInfo, runs: [] DkInfo, nruns: int, s: [] Session, stamps: [] int, file: [] u8, ab: [] u8, want: int, found: [] DkSub) -> int {
  for i: 0..<stamps.count { stamps[i] = 0; }
  subs: [32] DkSub; nsub := dk_subs(runs, nruns, cast(string) r[0].session[0..<r[0].nsession], subs[..]);
  // the delegated calls first (their rows are read after the chat's lines: file is reused)
  calls: [32] int; call_sub: [32] int; ncall := 0;
  steer_ids: [8 * 64] u8; steer_n: [8] int; steer_text: [8 * 2000] u8; steer_tn: [8] int; nsteer := 0;
  id := cast(string) r[0].id[..];
  // the chat's turns before this run, from the chat Coder saved: a run's lines hold only the turns
  // it ran, so a phone opening a long chat mid-turn would see that one turn and nothing to scroll
  dk_earlier(r, s, file, ab);
  op: [1400] u8; t := dk_read_tail(dr_file(id, ".out", op[..]), file);
  next := [1] int.[0]; ar := [1] ClArena.[ClArena.{buf = ab}]; l: [1] MwwLine;
  ask := -1; open := false; text_since := false;
  // a phone's own run: a turn its task line started says no words, and the task line is the
  // phone's message alone, so each such turn shows its task's words (the newest ones line up)
  asks: [DK_ASKS] string; nasks := 0; inb: [DK_IN_TAIL] u8; tab: [DK_IN_TAIL] u8; skip := [1] int.[0];
  if dk_phone(r) { nasks = dk_phone_asks(id, t, asks[..], inb[..], tab[..], ab, skip[..]); }
  while true {
    line := dk_line(t, next[..]);
    if line.count == 0 { if next[0] >= t.count { break; } continue; }
    ar[0].at = 0; ar[0].full = false;
    kind := mww_read(ar[..], line, l[..]);
    if kind == MWW_TURN && l[0].text.count == 0 && l[0].source == "message" && skip[0] > 0 { skip[0] -= 1; s_user(s, "(follow-up)"); open = true; text_since = false; ask = -1; }
    else if kind == MWW_TURN && l[0].text.count == 0 && l[0].source == "message" && nasks > 0 { s_user(s, asks[asks.count - nasks]); nasks -= 1; open = true; text_since = false; ask = -1; }
    else if kind == MWW_TURN { s_user(s, ifx l[0].text.count > 0 then l[0].text else "(follow-up)"); open = true; text_since = false; ask = -1; }
    else if kind == MWW_THOUGHT { s_delta(s, P_THINK, l[0].text); }
    else if kind == MWW_REPLY { s_delta(s, P_TEXT, l[0].text); text_since = true; }
    else if kind == MWW_ASK { ask = dk_tool(s, "Bash", TK_EXEC, l[0].command); }
    else if kind == MWW_COMMAND {
      k := -1;
      if ask >= 0 && s[0].parts[ask].arg == hs_cut(l[0].command, 4000) && !s[0].parts[ask].resolved { k = ask; } else { k = dk_tool(s, "Bash", TK_EXEC, l[0].command); }
      dk_done(s, k, l[0].output, (l[0].exit.ok && l[0].exit.value != 0) || (l[0].timed_out.ok && l[0].timed_out.value)); ask = -1;
    }
    else if kind == MWW_VIEW { k := dk_tool(s, "Read", TK_READ, l[0].path); dk_done(s, k, ifx l[0].found.ok && l[0].found.value then "" else "Not found", false); }
    else if kind == MWW_DELEGATE {
      tasks := l[0].tasks;
      for i: 0..<cl_count(tasks) {
        one := cl_json(tasks, cl_item(tasks, i));
        ta: [32768] u8; tar := [1] ClArena.[ClArena.{buf = ta[..]}];
        task := cl_str(tar[..], one, "task");
        // a task with resume goes on with (or waits for) a sub-agent the turn already started: no new call (#13766)
        resume := cl_int(one, "resume"); if resume.ok && resume.value > 0 { continue; }
        k := dk_tool(s, "Task", TK_AGENT, task);
        if k < 0 || ncall >= calls.count { continue; }
        j := dk_sub_for(subs[..], nsub, task); if j >= 0 { subs[j].used = true; }
        calls[ncall] = k; call_sub[ncall] = j; ncall += 1;
        if k == want && found.count == 1 && j >= 0 { found[0] = subs[j]; }
      }
    }
    else if kind == MWW_STEERED {
      // a steer the turn took shows where it went in, with the words its accepted line gave
      if l[0].steer_status == "accepted" && l[0].text.count > 0 && nsteer < 8 {
        steer_n[nsteer] = hs_set(steer_ids[nsteer * 64..<nsteer * 64 + 64], hs_cut(l[0].id, 64)); steer_tn[nsteer] = hs_set(steer_text[nsteer * 2000..<nsteer * 2000 + 2000], hs_cut(l[0].text, 2000)); nsteer += 1;
      }
      if l[0].steer_status == "applied" {
        for q: 0..<nsteer { if cast(string) steer_ids[q * 64..<q * 64 + steer_n[q]] == hs_cut(l[0].id, 64) { k := s_part(s, P_USER); if k >= 0 { s_append(s, k, cast(string) steer_text[q * 2000..<q * 2000 + steer_tn[q]]); } } }
      }
    }
    else if kind == MWW_ENDED {
      open = false;
      if l[0].ending == "finished" || l[0].ending == "asked" { if !text_since && l[0].text.count > 0 { s_delta(s, P_TEXT, l[0].text); } }
      else { s_notice(s, ifx l[0].ending == "stopped" then N_STOPPED else N_ERROR, ifx l[0].ending == "stopped" then "Stopped" else ifx l[0].text.count > 0 then l[0].text else "The turn ended early."); }
    }
  }
  s[0].live = open && dk_running(r);
  for c: 0..<ncall {
    k := calls[c]; j := call_sub[c];
    if j >= 0 {
      dk_sub_rows(s, k, cast(string) subs[j].id[..], subs[j].running, file, ab);
      if !s[0].parts[k].resolved && k < stamps.count { stamps[k] = subs[j].started * 1000; }
    }
    if !s[0].live { s[0].parts[k].resolved = true; }
  }
  return ifx s[0].n < stamps.count then s[0].n else stamps.count;
}

// The words of the task lines a phone's run `id` was sent, for the wordless message turns of its
// output t, in order, at the end of asks: how many (the newest tasks, one for each such turn).
DK_ASKS :: 64; DK_IN_TAIL :: 262144;
dk_phone_asks :: (id: string, t: string, asks: [] string, inb: [] u8, tab: [] u8, ab: [] u8, skip: [] int) -> int {
  next := [1] int.[0]; ar := [1] ClArena.[ClArena.{buf = ab}]; l: [1] MwwLine; turns := 0;
  while true {
    line := dk_line(t, next[..]);
    if line.count == 0 { if next[0] >= t.count { break; } continue; }
    ar[0].at = 0; ar[0].full = false;
    if mww_read(ar[..], line, l[..]) == MWW_TURN && l[0].text.count == 0 && l[0].source == "message" { turns += 1; }
  }
  ip: [1400] u8; b := dk_read_tail(dr_file(id, ".in", ip[..]), inb);
  tasks: [DK_ASKS] string; n := 0; tn := [1] int.[0]; tar := [1] ClArena.[ClArena.{buf = tab}]; q: [1] MwwRequest;
  while true {
    line := dk_line(b, tn[..]);
    if line.count == 0 { if tn[0] >= b.count { break; } continue; }
    if mww_request(tar[..], line, q[..]) == MWW_TASK {
      if n == tasks.count { for i: 1..<n { tasks[i - 1] = tasks[i]; } n -= 1; }
      tasks[n] = q[0].task; n += 1;
    }
  }
  m := ifx turns < n then turns else n;
  m = ifx m > asks.count then asks.count else m;
  op: [1400] u8;
  out_whole := fs_size(dr_file(id, ".out", op[..])) <= DK_FILE;
  in_whole := fs_size(dr_file(id, ".in", ip[..])) <= inb.count;
  base_idx := ifx out_whole && in_whole && turns <= n then 0 else n - m;
  for i: 0..<m { asks[asks.count - m + i] = tasks[base_idx + i]; }
  skip[0] = turns - m;   // the oldest turns, whose tasks are no longer in the input's tail
  return m;
}

// The turns of run r's chat that Coder saved before the run's own: the saved chat holds every turn,
// the run's too (a running one saved as running), so its last turns, as many as the run's lines
// start, are left to those lines. Nothing when the run has no saved chat.
dk_earlier :: (r: [] DkInfo, s: [] Session, file: [] u8, ab: [] u8) {
  hx: [32] u8; hex := dk_hex(r, hx[..]);
  if hex.count == 0 { return; }
  chats: [DK_CHATS] DkChat; nc := dk_chats(chats[..]); c := dk_chat_by_hex(chats[..], nc, hex);
  if c < 0 { return; }
  if dk_phone(r) {
    // Phone runs record in ID.phone ("base") how many earlier saved turns precede ID.out.
    base := ph_base(cast(string) r[0].id[..]);
    if base <= 0 { return; }
    cut := [1] bool.[false];
    text := dk_saved_read(chats[c..<c + 1], file, DK_SAVED, cut[..]);
    if text.count < 2 { return; }
    turns := cl_raw(text, "turns"); count := cl_count(turns);
    if count < 1 { return; }
    drop := ifx count > base then count - base else 0;
    if cut[0] { s_notice(s, N_META, DK_EARLIER); }
    dk_saved_turns(text, s, ab, drop);
    return;
  }
  // the run's turns, and whether its last is still open
  op: [1400] u8; t := dk_read_tail(dr_file(cast(string) r[0].id[..], ".out", op[..]), file);
  next := [1] int.[0]; ar := [1] ClArena.[ClArena.{buf = ab}]; l: [1] MwwLine; ran := 0; open := false;
  while true {
    line := dk_line(t, next[..]);
    if line.count == 0 { if next[0] >= t.count { break; } continue; }
    ar[0].at = 0; ar[0].full = false;
    kind := mww_read(ar[..], line, l[..]);
    if kind == MWW_TURN { ran += 1; open = true; } else if kind == MWW_ENDED { open = false; }
  }
  cut := [1] bool.[false];
  text := dk_saved_read(chats[c..<c + 1], file, DK_SAVED, cut[..]);
  if text.count < 2 { return; }
  turns := cl_raw(text, "turns"); count := cl_count(turns);
  if count < 1 { return; }
  // a turn the run started but Coder has not saved yet is not among the saved ones
  last := cl_int(cl_json(turns, cl_item(turns, count - 1)), "state");
  drop := ran; if open && !(last.ok && last.value == DK_RUNNING) { drop -= 1; }
  if drop < 0 { drop = 0; }
  if drop >= count { return; }
  if cut[0] { s_notice(s, N_META, DK_EARLIER); }
  dk_saved_turns(text, s, ab, drop);
}

// The run the 32 hex digits name for this grant: the lead run of the chat with that id, else the
// run with that id. -1 when none.
dk_run_for :: (h: [] HsHost, runs: [] DkInfo, n: int, hex: string) -> int {
  for i: 0..<n {
    r := runs[i..<i + 1];
    if !dk_top(r) || !dk_scoped(h, r) { continue; }
    hx: [32] u8; if dk_hex(r, hx[..]) == hex && dk_lead(h, runs, n, i) { return i; }
  }
  for i: 0..<n { if cast(string) runs[i].id[..] == hex && dk_top(runs[i..<i + 1]) && dk_scoped(h, runs[i..<i + 1]) { return i; } }
  return -1;
}
// The run `id` names for this grant, or -1 (refused not_found).
dk_find :: (h: [] HsHost, id: string, runs: [] DkInfo, n: int) -> int {
  if ea_id(id, 32) {
    if !ph_is(id) { return -1; }
    return dk_run_for(h, runs, n, id);
  }
  if !dk_is(id) { return -1; }
  hex := dk_run_of(id);
  if ph_is(hex) { return -1; }
  k := dk_run_for(h, runs, n, hex);
  return ifx k >= 0 && dk_phone(runs[k..<k + 1]) then -1 else k;
}
// The saved chat `id` names for this grant, or -1.
dk_saved_for :: (h: [] HsHost, id: string, chats: [] DkChat, nc: int) -> int {
  hex := "";
  if ea_id(id, 32) {
    if !ph_is(id) { return -1; }
    hex = id;
  } else if dk_is(id) {
    hex = dk_run_of(id);
    if ph_is(hex) { return -1; }
  } else {
    return -1;
  }
  for c: 0..<nc { if cast(string) chats[c].hex[..] == hex && dk_inside(h, cast(string) chats[c].folder[0..<chats[c].nf]) { return c; } }
  return -1;
}

// A chat Coder saved (persist.coax's coder_page_save text) as the transcript: each turn's message
// and steers, its thoughts, replies, commands and file reads, its sub-agents with their own rows,
// and how it ended. Read only; nothing in it runs.
DK_RUNNING :: 0; DK_DONE :: 1; DK_FAILED :: 2; DK_STOPPED :: 3;   // persist.coax's CP_RUNNING...
dk_saved_rows :: (s: [] Session, rows: string, k: int, ab: [] u8) {
  ar := [1] ClArena.[ClArena.{buf = ab}];
  for i: 0..<cl_count(rows) {
    one := cl_json(rows, cl_item(rows, i));
    ar[0].at = 0; ar[0].full = false;
    text := cl_str(ar[..], one, "text"); out := cl_str(ar[..], one, "out");
    thought := cl_bool(one, "thought"); said := cl_bool(one, "said"); read := cl_bool(one, "read"); failed := cl_bool(one, "failed");
    bad := failed.ok && failed.value;
    if k >= 0 {
      // a sub-agent's row
      if said.ok && said.value { _ = s_sub_add(s, k, false, "", ifx out.count > 0 then out else text, ""); continue; }
      if thought.ok && thought.value { continue; }
      if s_sub_add(s, k, true, ifx read.ok && read.value then "Read" else "Bash", text, "") {
        r := s[0].nsubs - 1; s[0].subs[r].done = true; s[0].subs[r].output = s_put(s, hs_cut(out, S_SUB_OUT)); s[0].subs[r].failed = bad;
        s[0].parts[k].subcalls += 1;
      }
      continue;
    }
    if thought.ok && thought.value { p := s_part(s, P_THINK); if p >= 0 { s_append(s, p, ifx out.count > 0 then out else text); } continue; }
    if said.ok && said.value { s_delta(s, P_TEXT, ifx out.count > 0 then out else text); continue; }
    if read.ok && read.value { p := dk_tool(s, "Read", TK_READ, text); dk_done(s, p, out, bad); continue; }
    p := dk_tool(s, "Bash", TK_EXEC, text); dk_done(s, p, out, bad);
  }
}
dk_saved_session :: (c: [] DkChat, s: [] Session, file: [] u8, ab: [] u8) {
  cut := [1] bool.[false];
  text := dk_saved_read(c, file, DK_SAVED, cut[..]);
  if text.count < 2 { s_notice(s, N_ERROR, "Coder has not saved this chat yet."); return; }
  if cut[0] { s_notice(s, N_META, DK_EARLIER); }
  dk_saved_turns(text, s, ab, 0);
}
// Earlier turns than a long chat's newest the phone gets stay in Coder on the computer.
DK_EARLIER :: "Earlier messages are in Coder on this computer.";
// The bytes of a saved chat the phone reads: its newest turns, enough to scroll back through and
// small enough for the transcript's pool and parts (the live run's rows come after them).
DK_SAVED :: 196608;
// A saved chat's text, or its newest whole turns rebuilt as {"turns":[...]} when the file is past
// `most` bytes (cut[0] then true). A turn starts at {"ask": (a turn's first key; nothing nested in a
// turn has an "ask" key, and a string's quote is escaped). "" when the file can't be read.
dk_saved_read :: (c: [] DkChat, file: [] u8, most: int, cut: [] bool) -> string {
  nb: [128] u8; nn := hs_cat(nb[..], 0, cast(string) c[0].id[0..<c[0].ni]); nn = hs_cat(nb[..], nn, ".json");
  pb: [1400] u8; path := dk_chat_path(cast(string) nb[0..<nn], pb[..]);
  return dk_saved_tail(path, file, most, cut);
}
dk_saved_tail :: (path: string, file: [] u8, most: int, cut: [] bool) -> string {
  cut[0] = false;
  size := fs_size(path);
  if size < 2 { return ""; }
  room := ifx most < file.count then most else file.count;
  if size <= room { n := fs_read(path, file[0..<room]); return ifx n >= 2 then cast(string) file[0..<n] else ""; }
  if room <= DK_TURNS_N + 16 { return ""; }
  n := fs_read_at(path, size - (room - DK_TURNS_N), file[DK_TURNS_N..<room]);
  if n < 1 { return ""; }
  m := dk_tail_turns(file, n);
  cut[0] = m > 0;
  return ifx m > 0 then cast(string) file[0..<m] else "";
}
DK_TURNS_HEAD :: "{\"turns\":["; DK_TURNS_N :: 10;
// file[DK_TURNS_N..<+n] holds a saved chat's last bytes: they become {"turns":[ and the turns
// from the first whole one on, in place. Their length, or 0 when no turn starts in them.
dk_tail_turns :: (file: [] u8, n: int) -> int {
  h := DK_TURNS_N; mark := "{\"ask\":"; at := -1;
  for i: 0..<n - mark.count + 1 {
    if cast(string) file[h + i..<h + i + mark.count] == mark { at = i; break; }
  }
  if at < 0 { return 0; }
  for k: 0..<n - at { file[h + k] = file[h + at + k]; }
  for k: 0..<h { file[k] = DK_TURNS_HEAD[k]; }
  return h + n - at;
}
dk_saved_text :: (text: string, s: [] Session, ab: [] u8) { dk_saved_turns(text, s, ab, 0); }
// The saved turns but the last `drop` (a live run's own turns, which its lines show), each one
// whole while the parts leave room for the run's (S_PARTS - DK_LIVE_PARTS).
DK_LIVE_PARTS :: 256;
dk_saved_turns :: (text: string, s: [] Session, ab: [] u8, drop: int) {
  turns := cl_raw(text, "turns");
  ar := [1] ClArena.[ClArena.{buf = ab}];
  for i: 0..<cl_count(turns) - drop {
    if s[0].n >= S_PARTS - DK_LIVE_PARTS || s[0].exhausted { break; }
    t := cl_json(turns, cl_item(turns, i));
    ar[0].at = 0; ar[0].full = false;
    ask := cl_str(ar[..], t, "ask");
    s_user(s, ifx ask.count > 0 then ask else "(follow-up)");
    steers := cl_raw(t, "steers");
    for j: 0..<cl_count(steers) {
      ar[0].at = 0; ar[0].full = false;
      w := cl_text(ar[..], steers, cl_item(steers, j));
      if w.count > 0 { p := s_part(s, P_USER); if p >= 0 { s_append(s, p, w); } }
    }
    dk_saved_rows(s, cl_raw(t, "cmds"), -1, ab);
    agents := cl_raw(t, "agents");
    for j: 0..<cl_count(agents) {
      a := cl_json(agents, cl_item(agents, j));
      ar[0].at = 0; ar[0].full = false;
      task := cl_str(ar[..], a, "task");
      k := dk_tool(s, "Task", TK_AGENT, task);
      if k < 0 { continue; }
      dk_saved_rows(s, cl_raw(a, "rows"), k, ab);
      ar[0].at = 0; ar[0].full = false;
      reply := cl_str(ar[..], a, "reply");
      st := cl_int(a, "state");
      if reply.count > 0 { _ = s_sub_add(s, k, false, "", reply, ""); }
      dk_done(s, k, reply, st.ok && st.value == DK_FAILED);
    }
    ar[0].at = 0; ar[0].full = false;
    reply := cl_str(ar[..], t, "reply");
    if reply.count > 0 { s_delta(s, P_TEXT, reply); }
    state := cl_int(t, "state"); st := ifx state.ok then state.value else DK_DONE;
    ar[0].at = 0; ar[0].full = false;
    note := cl_str(ar[..], t, "note");
    if st == DK_STOPPED || st == DK_RUNNING { s_notice(s, N_STOPPED, "Stopped"); }
    else if st == DK_FAILED { s_notice(s, N_ERROR, ifx note.count > 0 then note else "The turn ended early."); }
  }
  s[0].live = false;
}

// ReadSession and ReadSubagent of a Coder Desktop chat.
dk_read :: (h: [] HsHost, q: [] EaRequest, v: [] EaView) {
  runs: [DK_RUNS] DkInfo; n := dk_all(runs[..]);
  chats: [DK_CHATS] DkChat; nc := dk_chats(chats[..]);
  id := cast(string) q[0].session[0..<q[0].ns];
  k := dk_find(h, id, runs[..], n);
  ses: [1] Session; pool: [524288] u8; s_init(ses[..], pool[..]);
  stamps: [S_PARTS] int; file: [DK_FILE] u8; ab: [DK_ARENA] u8;
  if k < 0 {
    // no run is left: the chat Coder saved
    c := dk_saved_for(h, id, chats[..], nc);
    if c < 0 { es_refuse(v, "not_found"); return; }
    if v[0].ns < 128 { dk_saved_summary(chats[c..<c + 1], v[0].sessions[v[0].ns..<v[0].ns + 1]); v[0].ns += 1; }
    dk_saved_session(chats[c..<c + 1], ses[..], file[..], ab[..]);
    if cast(string) q[0].method[0..<q[0].nm] == "ReadSubagent" { es_project_sub(ses[..], q, v); return; }
    es_project_at(ses[..], stamps[0..<0], q, v);
    return;
  }
  r := runs[k..<k + 1];
  if v[0].ns < 128 { dk_summary(r, chats[..], nc, v[0].sessions[v[0].ns..<v[0].ns + 1]); v[0].ns += 1; }
  ahead := dk_desktop_ahead(r, chats[..], nc, file[..], ab[..]);
  if ahead >= 0 {
    dk_saved_session(chats[ahead..<ahead + 1], ses[..], file[..], ab[..]);
    if cast(string) q[0].method[0..<q[0].nm] == "ReadSubagent" { es_project_sub(ses[..], q, v); return; }
    es_project_at(ses[..], stamps[0..<0], q, v);
    return;
  }
  none: [1] DkSub; have := dk_session(r, runs[..], n, ses[..], stamps[..], file[..], ab[..], -1, none[0..<0]);
  if cast(string) q[0].method[0..<q[0].nm] == "ReadSubagent" { es_project_sub(ses[..], q, v); return; }
  es_project_at(ses[..], stamps[0..<have], q, v);
}

// ---------------------------------------------------------------- the phone's writes

// The newest task line Coder sent the run (the follow-up's settings), and its queue's key.
dk_last_task :: (id: string, task: [] u8, ntask: [] int, key: [] u8, nkey: [] int) {
  ntask[0] = 0; nkey[0] = 0;
  ip: [1400] u8; b: [DK_FILE] u8; t := dk_read_tail(dr_file(id, ".in", ip[..]), b[..]);
  defer { for i: 0..<b.count { b[i] = 0; } }
  next := [1] int.[0]; ab: [65536] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}]; q: [1] MwwRequest;
  while true {
    line := dk_line(t, next[..]);
    if line.count == 0 { if next[0] >= t.count { break; } continue; }
    ar[0].at = 0; ar[0].full = false;
    k := mww_request(ar[..], line, q[..]);
    if k == MWW_TASK && line.count <= task.count { for c, i: line { task[i] = c; } ntask[0] = line.count; }
    if k == MWW_QUEUE && q[0].op == "open" && q[0].key.count > 0 && q[0].key.count <= key.count { nkey[0] = hs_set(key, q[0].key); }
  }
}

// The lines a phone's SendMessage or StopTurn writes into the run's input: their length, or -1.
dk_lines :: (r: [] DkInfo, runs: [] DkInfo, n: int, method: string, command: string, text: string, out: [] u8) -> int {
  id := cast(string) r[0].id[..];
  if method == "StopTurn" {
    if !r[0].busy { return 0; }
    return mww_interrupt(out, false);
  }
  if r[0].busy { return mww_steer(out, command, text, 0); }
  // a follow-up: the chat's own settings with the phone's words, queued and started at once
  tb: [32768] u8; tn: [1] int; kb: [128] u8; kn: [1] int;
  dk_last_task(id, tb[..], tn[..], kb[..], kn[..]);
  defer { for i: 0..<tb.count { tb[i] = 0; } }
  if tn[0] < 1 { return -1; }
  ab: [65536] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}]; t: [1] McTask;
  if !mww_task_read(ar[..], cast(string) tb[0..<tn[0]], t[..]) { return -1; }
  t[0].task = text;
  msg: [32768] u8; mn := mww_task(msg[..], t[0]);
  if mn < 2 { return -1; }
  at := 0;
  if kn[0] > 0 { w := mww_queue(out, "open", "", "", "", 0, false, cast(string) kb[0..<kn[0]]); if w < 0 { return -1; } at = w; }
  w := mww_queue(out[at..<out.count], "add", command, text, cast(string) msg[0..<mn - 1], 0, false, "");
  if w < 0 { return -1; }
  at += w;
  w = mww_queue(out[at..<out.count], "promote", command, "", "", 0, true, "");
  if w < 0 { return -1; }
  return at + w;
}

// The sub-agent run a ReadSession item ("PART:START") of chat run r started: 1 with its id in
// found[0] while it runs, 0 when it has ended, -1 when the item names no sub-agent call of a run.
dk_sub_of :: (r: [] DkInfo, runs: [] DkInfo, n: int, item: string, found: [] DkSub) -> int {
  part := 0; digits := 0;
  for c: item { if c == ':' { break; } if c < '0' || c > '9' || digits > 6 { return -1; } part = part * 10 + cast(int) (c - '0'); digits += 1; }
  if digits == 0 { return -1; }
  ses: [1] Session; pool: [524288] u8; s_init(ses[..], pool[..]);
  stamps: [S_PARTS] int; file: [DK_FILE] u8; ab: [DK_ARENA] u8;
  found[0] = DkSub.{};
  _ = dk_session(r, runs, n, ses[..], stamps[..], file[..], ab[..], part, found);
  if found[0].id[0] == 0 { return -1; }
  return ifx found[0].running then 1 else 0;
}

// SendMessage, StopTurn and StopSubagent on a Coder Desktop chat, under one command identity each:
// its intent is kept before its lines go, and a retry of the same request is answered without
// writing again.
dk_write :: (h: [] HsHost, q: [] EaRequest, grant: string, v: [] EaView) {
  method := cast(string) q[0].method[0..<q[0].nm];
  if method != "SendMessage" && method != "StopTurn" && method != "StopSubagent" { es_refuse(v, "unsupported_profile"); return; }
  command := cast(string) q[0].command[0..<q[0].nc];
  if !ea_id(command, 32) { es_refuse(v, "malformed"); return; }
  runs: [DK_RUNS] DkInfo; n := dk_all(runs[..]);
  chats: [DK_CHATS] DkChat; nc := dk_chats(chats[..]);
  k := dk_find(h, cast(string) q[0].session[0..<q[0].ns], runs[..], n);
  if k < 0 {
    // a saved chat with no run is read only: Coder starts its next turn
    es_refuse(v, ifx dk_saved_for(h, cast(string) q[0].session[0..<q[0].ns], chats[..], nc) >= 0 then "conflict" else "not_found"); return;
  }
  r := runs[k..<k + 1];
  raw: [24576] u8; rn := ea_write(q, raw[..]); if rn < 0 { es_refuse(v, "malformed"); return; }
  name: [256] u8; nn := hs_cat(name[..], 0, "command-"); nn = hs_cat(name[..], nn, grant); nn = hs_cat(name[..], nn, "-"); nn = hs_cat(name[..], nn, command); nn = hs_cat(name[..], nn, ".json");
  path: [1400] u8; file := es_path(cast(string) name[0..<nn], path[..]);
  if fs_exists(file) {
    previous: [24576] u8; got := fs_read(file, previous[..]);
    if got != rn || cast(string) previous[0..<ifx got > 0 then got else 0] != cast(string) raw[0..<rn] { es_refuse(v, "idempotency_conflict"); return; }
    dk_summary(r, chats[..], nc, v[0].sessions[0..<1]); v[0].ns = 1;
    v[0].nq = ea_copy(v[0].command[..], command); v[0].nt = ea_copy(v[0].status[..], "accepted"); return;
  }
  if !ea_fresh(q[0].issued, q[0].expires, cxproc_wall_us() / 1000) { es_refuse(v, "expired"); return; }
  text := cast(string) q[0].text[0..<q[0].nt];
  hx: [32] u8; hex := dk_hex(r, hx[..]);
  if dk_phone(r) { ph_write(h, q, r, runs[..], n, chats[..], nc, method, command, text, file, cast(string) raw[0..<rn], v); return; }
  is_ph := ph_is(hex);
  if is_ph && !dk_running(r) {
    pk := -1;
    for i: 0..<n { if cast(string) runs[i].id[..] == hex && dk_phone(runs[i..<i + 1]) && dk_scoped(h, runs[i..<i + 1]) { pk = i; break; } }
    if pk >= 0 { ph_write(h, q, runs[pk..<pk + 1], runs[..], n, chats[..], nc, method, command, text, file, cast(string) raw[0..<rn], v); return; }
  }
  want_gen := ifx is_ph then ph_generation(hex) else r[0].started * 1000;
  if !dk_running(r) || q[0].generation != want_gen { es_refuse(v, "conflict"); return; }
  if method == "SendMessage" && !ea_text(text) { es_refuse(v, "malformed"); return; }
  // one sub-agent of the running turn: its run, found before the intent is kept (#13776)
  one: [1] DkSub;
  if method == "StopSubagent" {
    got := dk_sub_of(r, runs[..], n, cast(string) q[0].item[0..<q[0].nit], one[..]);
    if got < 0 { es_refuse(v, "not_found"); return; }
    if got == 0 || !r[0].busy { es_refuse(v, "conflict"); return; }
  }
  lines: [98304] u8; ln := ifx method == "StopSubagent" then 0 else dk_lines(r, runs[..], n, method, command, text, lines[..]);
  if ln < 0 { es_refuse(v, "conflict"); return; }
  if !fs_replace_durable(file, cast(string) raw[0..<rn]) { es_refuse(v, "storage_unavailable"); return; }
  ip: [1400] u8;
  if ln > 0 && !fs_append(dr_file(cast(string) r[0].id[..], ".in", ip[..]), cast(string) lines[0..<ln]) { es_refuse(v, "storage_unavailable"); return; }
  // a stopped turn's sub-agents stop too, as Coder's own Stop does
  if method == "StopTurn" && r[0].busy {
    subs: [32] DkSub; ns := dk_subs(runs[..], n, cast(string) r[0].session[0..<r[0].nsession], subs[..]);
    for i: 0..<ns { if subs[i].running { sp: [1400] u8; _ = fs_append(dr_file(cast(string) subs[i].id[..], ".in", sp[..]), MWW_STOP_LINE); } }
  }
  // that sub-agent alone stops, as Coder Desktop's one-agent Stop stops its worker
  if method == "StopSubagent" { sp: [1400] u8; if !fs_append(dr_file(cast(string) one[0].id[..], ".in", sp[..]), MWW_STOP_LINE) { es_refuse(v, "storage_unavailable"); return; } }
  dk_summary(r, chats[..], nc, v[0].sessions[0..<1]); v[0].ns = 1;
  v[0].nq = ea_copy(v[0].command[..], command); v[0].nt = ea_copy(v[0].status[..], "accepted");
}

// SendMessage and StopTurn on a phone's own chat (host-phone.coax): a steer or a task line while its
// worker runs, else the worker starts again (or switches engines when switching Neon <-> Inkling);
// StopSubagent has nothing to stop (no sub-agents).
ph_write :: (h: [] HsHost, q: [] EaRequest, r: [] DkInfo, runs: [] DkInfo, n: int, chats: [] DkChat, nc: int, method: string, command: string, text: string, file: string, raw: string, v: [] EaView) {
  if method == "StopSubagent" { es_refuse(v, "not_found"); return; }
  id := cast(string) r[0].id[..];
  if q[0].generation != ph_generation(id) { es_refuse(v, "conflict"); return; }
  if method == "RespondInteraction" {
    ticket := hs_atoi(cast(string) q[0].interaction[0..<q[0].ni]);
    if ticket < 1 || !dk_running(r) { es_refuse(v, "interaction_expired"); return; }
    if !fs_replace_durable(file, raw) { es_refuse(v, "storage_unavailable"); return; }
    ans_buf: [4096] u8;
    an := mww_answer(ans_buf[..], q[0].allow, ticket, cast(string) q[0].text[0..<q[0].nt]);
    ip: [1400] u8;
    if an < 1 || !fs_append(dr_file(id, ".in", ip[..]), cast(string) ans_buf[0..<an]) { es_refuse(v, "storage_unavailable"); return; }
    dk_summary(r, chats, nc, v[0].sessions[0..<1]); v[0].ns = 1;
    v[0].nq = ea_copy(v[0].command[..], command); v[0].nt = ea_copy(v[0].status[..], "accepted");
    return;
  }
  if method == "SendMessage" && !ea_text(text) { es_refuse(v, "malformed"); return; }
  if method == "StopTurn" && !r[0].busy { es_refuse(v, "conflict"); return; }
  if !fs_replace_durable(file, raw) { es_refuse(v, "storage_unavailable"); return; }
  want_model := cast(string) q[0].model[0..<q[0].nmo];
  want_effort := cast(string) q[0].effort[0..<q[0].nef];
  prev_engine := ph_engine(id);
  switch_engine := false;
  if method == "SendMessage" && dk_running(r) && !r[0].busy && want_model.count > 0 {
    p := pa_pick(ph_facts(h), want_model);
    if p.engine != PA_NONE && p.engine != PA_CLAUDE && p.engine != prev_engine { switch_engine = true; }
  }
  desktop_ahead := method == "SendMessage" && dk_is_desktop_ahead(r, chats, nc);
  if method == "SendMessage" && (!dk_running(r) || switch_engine || desktop_ahead) {
    if dk_running(r) { dr_stop_sync(h[0].runs[..], id); }
    why := ph_restart(h, r, runs, n, command, text, want_model, want_effort);
    if why.count > 0 { es_refuse(v, why); return; }
  } else {
    eff := want_effort;
    model := want_model;
    if method == "SendMessage" && !r[0].busy && (want_model.count > 0 || want_effort.count > 0) {
      pmb: [1024] u8; pm := ph_meta_read(id, pmb[..]);
      prev_mb: [64] u8; prev_m := ph_model_in(pm, prev_mb[..]);
      prev_eb: [16] u8; prev_e := ph_effort_in(pm, prev_eb[..]);
      if model.count == 0 {
        model = prev_m;
      } else {
        p := pa_pick(ph_facts(h), model);
        model = ifx p.engine == prev_engine && p.model.count > 0 then p.model else prev_m;
      }
      eff = pa_effort(prev_engine, model, ifx want_effort.count > 0 then want_effort else prev_e);
      if prev_engine != PA_NONE { _ = ph_meta(id, ph_generation(id), PaPick.{engine = prev_engine, model = model}, eff); }
    }
    lines: [EX_INPUT_MAX + 8192] u8; ln := ph_lines(r, method, command, text, model, eff, lines[..]);
    if ln < 0 { es_refuse(v, "conflict"); return; }
    ip: [1400] u8;
    if ln > 0 && !fs_append(dr_file(id, ".in", ip[..]), cast(string) lines[0..<ln]) { es_refuse(v, "storage_unavailable"); return; }
  }
  dk_summary(r, chats, nc, v[0].sessions[0..<1]); v[0].ns = 1;
  if method == "SendMessage" { v[0].sessions[0].busy = true; }
  v[0].nq = ea_copy(v[0].command[..], command); v[0].nt = ea_copy(v[0].status[..], "accepted");
}
dk_dispatch :: (h: [] HsHost, q: [] EaRequest, grant: string, v: [] EaView) {
  method := cast(string) q[0].method[0..<q[0].nm];
  if method == "ReadSession" || method == "ReadSubagent" { dk_read(h, q, v); return; }
  dk_write(h, q, grant, v);
}

#test "a chat's worktree names the main checkout it was made from" {
  #assert dk_worktree_source("gitdir: /w/repo/.git/worktrees/3f2a\n") == "/w/repo";
  #assert dk_worktree_source("gitdir: /w/a/.git/worktrees/b/.git/worktrees/c") == "/w/a/.git/worktrees/b";
  #assert dk_worktree_source("gitdir: /w/repo/.git/modules/sub\n") == "" && dk_worktree_source("gitdir: ../repo/.git/worktrees/x") == "";
  #assert dk_worktree_source("gitdir: /w/repo/.git/worktrees/\n") == "" && dk_worktree_source("gitdir: /w/repo/.git/worktrees/x/y") == "" && dk_worktree_source("") == "";
}

#test "a Coder Desktop chat's session id names its run" {
  #assert dk_is("desktop-0123456789abcdef0123456789abcdef") && dk_run_of("desktop-0123456789abcdef0123456789abcdef") == "0123456789abcdef0123456789abcdef";
  #assert !dk_is("desktop-0123") && !dk_is("0123456789abcdef0123456789abcdef") && !dk_is("desktop-0123456789ABCDEF0123456789abcdef");
}
#test "a run goes by its Coder chat's id once its queue is bound" {
  r: [1] DkInfo; _ = hs_set(r[0].id[..], "0123456789abcdef0123456789abcdef"); hx: [32] u8;
  #assert dk_hex(r[..], hx[..]) == "0123456789abcdef0123456789abcdef";
  r[0].nkey = hs_set(r[0].key[..], "e83dd354-f4f4-4188-861e-fef97556d871");
  #assert dk_hex(r[..], hx[..]) == "e83dd354f4f44188861efef97556d871";
  r[0].nkey = hs_set(r[0].key[..], "chat-smoke"); #assert dk_hex(r[..], hx[..]) == "0123456789abcdef0123456789abcdef";
  #assert !dk_hex_key("E83DD354-F4F4-4188-861E-FEF97556D871", hx[..]) && !dk_hex_key("e83dd354f4f44188861efef97556d871xxxx", hx[..]);
  #assert dk_seconds("1795136276.25") == 1795136276 && dk_seconds("") == 0;
  chats: [2] DkChat;
  chats[0].ni = hs_set(chats[0].id[..], "066a38a0-8277-2f3c-a4ad-f42451d17a54");
  chats[0].has_hex = dk_hex_key(cast(string) chats[0].id[0..<chats[0].ni], chats[0].hex[..]);
  chats[1].ni = hs_set(chats[1].id[..], "e83dd354-f4f4-4188-861e-fef97556d871");
  chats[1].has_hex = dk_hex_key(cast(string) chats[1].id[0..<chats[1].ni], chats[1].hex[..]);
  #assert dk_chat_by_hex(chats[..], 2, "066a38a082772f3ca4adf42451d17a54") == 0;
  #assert dk_chat_by_hex(chats[..], 2, "e83dd354f4f44188861efef97556d871") == 1;
  #assert dk_chat_by_hex(chats[..], 2, "00000000000000000000000000000000") == -1;
  #assert dk_chat_by_hex(chats[..], 2, "short") == -1;
}
#test "a saved chat reads back as its turns, steers, rows, sub-agents and ending" {
  ses: [1] Session; pool: [65536] u8; s_init(ses[..], pool[..]); ab: [65536] u8;
  t := "{\"v\":1,\"turns\":[{\"ask\":\"Please survey the tests\",\"reply\":\"Taking that into account.\",\"state\":3,\"note\":\"\",\"steers\":[\"Also list the slow tests\"],\"cmds\":[{\"text\":\"A sub-agent\",\"out\":\"A sub-agent can survey the tests.\",\"read\":false,\"failed\":false,\"thought\":true,\"took\":0},{\"text\":\"ls\",\"out\":\"a_test.coax\",\"read\":false,\"failed\":false,\"took\":1}],\"agents\":[{\"level\":\"hydrogen\",\"task\":\"Survey the tests\",\"state\":3,\"reply\":\"Looking at the tests first.\",\"rows\":[{\"text\":\"ls\",\"out\":\"a_test.coax\",\"read\":false,\"failed\":false,\"took\":0}],\"calls\":1,\"took\":2}]}]}";
  dk_saved_text(t, ses[..], ab[..]);
  user := 0; think := 0; tool := 0; task := -1; notice := false; said := false;
  for k: 0..<ses[0].n {
    p := ses[0].parts[k].kind;
    if p == P_USER { user += 1; } if p == P_THINK { think += 1; }
    if p == P_TOOL { tool += 1; if ses[0].parts[k].tk == TK_AGENT { task = k; } }
  }
  #assert user == 2 && think == 1 && tool == 2 && task >= 0 && ses[0].parts[task].subcalls == 1 && ses[0].parts[task].resolved;
  #assert ses[0].nsubs == 2 && ses[0].subs[0].done && !ses[0].live;
}
#test "a long saved chat reads back as its newest whole turns, and a live run's turns are left to its lines" {
  big := "{\"v\":1,\"turns\":[{\"ask\":\"first, with {\\\"ask\\\": inside\",\"reply\":\"one\",\"state\":1,\"cmds\":[],\"agents\":[]},{\"ask\":\"second\",\"reply\":\"two\",\"state\":1,\"cmds\":[],\"agents\":[]},{\"ask\":\"third\",\"reply\":\"\",\"state\":0,\"cmds\":[],\"agents\":[]}]}";
  // the file's last bytes, from inside the first turn (past its own escaped {"ask": mark)
  file: [4096] u8; from := 40; n := big.count - from;
  for k: 0..<n { file[DK_TURNS_N + k] = big[from + k]; }
  m := dk_tail_turns(file[..], n);
  tail := cast(string) file[0..<m];
  #assert m > 0 && cl_count(cl_raw(tail, "turns")) == 2;
  none: [64] u8; #assert dk_tail_turns(none[..], 8) == 0;
  ses: [1] Session; pool: [65536] u8; s_init(ses[..], pool[..]); ab: [65536] u8;
  dk_saved_turns(big, ses[..], ab[..], 1);
  users := 0; for k: 0..<ses[0].n { if ses[0].parts[k].kind == P_USER { users += 1; } }
  #assert users == 2;
}
#test "the projects a phone picks are the workspace's repositories, never its subfolders or what lies outside" {
  #assert dk_project_rel("/u/work", "/u/work/openagents") == "openagents";
  #assert dk_project_rel("/u/work", "/u/work") == "" && dk_project_rel("/u/work", "/u/workshop/x") == "" && dk_project_rel("/u/work", "/u/.openagents/worktrees/a") == "";
  #assert dk_project_rel("/u/work/openagents", "/u/work/openagents/.claude/worktrees/x") == "";
  v: [1] EaView;
  #assert dk_project_add(v[..], "openagents") && !dk_project_add(v[..], "openagents") && dk_project_add(v[..], "psionic") && v[0].nfolders == 2;
}
#test "a run's lines are read whole, never a line still being written" {
  b := "{\"a\":1}\n{\"b\":2}\n{\"c\":"; next := [1] int.[0];
  #assert dk_line(b, next[..]) == "{\"a\":1}" && dk_line(b, next[..]) == "{\"b\":2}" && dk_line(b, next[..]) == "" && next[0] == b.count;
}
#test "a delegated task finds the sub-agent run whose task ends with it" {
  subs: [3] DkSub;
  subs[0].ntail = hs_set(subs[0].tail[..], "skills...\nSurvey the docs"); subs[1].ntail = hs_set(subs[1].tail[..], "skills...\nSurvey the tests");
  #assert dk_sub_for(subs[..], 2, "Survey the tests") == 1 && dk_sub_for(subs[..], 2, "Survey the docs") == 0;
  subs[1].used = true; #assert dk_sub_for(subs[..], 2, "Survey the tests") == 0;   // none matches: the oldest unused
  subs[0].used = true; #assert dk_sub_for(subs[..], 2, "x") == -1;
}
#test "a phone's steer and stop become the worker's own lines" {
  r: [1] DkInfo; r[0].busy = true; out: [4096] u8; none: [1] DkInfo;
  n := dk_lines(r[..], none[..], 0, "SendMessage", "0123456789abcdef0123456789abcdef", "use b", out[..]);
  #assert n > 0 && cast(string) out[0..<n] == "{\"steer\":\"use b\",\"id\":\"0123456789abcdef0123456789abcdef\"}\n";
  n = dk_lines(r[..], none[..], 0, "StopTurn", "0123456789abcdef0123456789abcdef", "", out[..]);
  #assert cast(string) out[0..<n] == "{\"interrupt\":true}\n";
  r[0].busy = false; #assert dk_lines(r[..], none[..], 0, "StopTurn", "0123456789abcdef0123456789abcdef", "", out[..]) == 0;
}
#test "a full DK_LIST_MAX ListSessions reply seals cleanly inside NIP-HOST JCS_MAX_KEYS" {
  v: [1] EaView;
  host := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
  v[0].nh = ea_copy(v[0].host[..], host); v[0].nl = ea_copy(v[0].label[..], "Mac"); v[0].nm = ea_copy(v[0].method[..], "ListSessions");
  v[0].offer.nv = 4; v[0].offer.default_level = 1;
  eids := PA_EFFORT_ID; elbs := PA_EFFORT_LABEL;
  for k: 0..<4 { v[0].offer.levels[k].ni = ea_copy(v[0].offer.levels[k].id[..], eids[k]); v[0].offer.levels[k].nl = ea_copy(v[0].offer.levels[k].label[..], elbs[k]); }
  v[0].offer.n = 5;
  mids := PA_NEON_ID; mlbs := PA_NEON_LABEL;
  for k: 0..<5 { v[0].offer.models[k].ni = ea_copy(v[0].offer.models[k].id[..], mids[k]); v[0].offer.models[k].nl = ea_copy(v[0].offer.models[k].label[..], mlbs[k]); v[0].offer.models[k].ladder = 15; }
  v[0].nroot = ea_copy(v[0].root[..], "openagents");
  for i: 0..<DK_LIST_MAX {
    s := EaSession.{};
    s.ni = ea_copy(s.id[..], "desktop-0123456789abcdef0123456789abcdef");
    s.nw = ea_copy(s.workspace[..], "default");
    s.nt = ea_copy(s.title[..], "Sample conversation title");
    s.managed = true; s.desktop = true;
    s.nc = ea_copy(s.control[..], "available");
    s.nmo = ea_copy(s.model[..], "gemini-4-neon");
    s.nef = ea_copy(s.effort[..], "medium");
    s.nno = ea_copy(s.note[..], "Fallback note");
    v[0].sessions[i] = s;
  }
  v[0].ns = DK_LIST_MAX;
  data: [HB_BODY_MAX] u8; vn := ea_view_write(v[..], data[..]);
  #assert vn > 0;
  body: [HB_BODY_MAX] u8; bn := hb_app_reply_write(host, host, host, 1000, 1060, "ListSessions", cast(string) data[0..<vn], body[..]);
  #assert bn > 0;
  scratch: [HB_REGION] u8; env_out: [HB_REGION] u8;
  built := envelope_build_checked(cast(string) body[0..<bn], HB_REPLY_SCHEMA, 1000, 4600, scratch[..], env_out[..], false);
  #assert built.error == AE_OK && built.written > 0;
}
