// The environment service is a resident execution owner; windows are clients.
// HOST owns carriage/admission. The shared engine and reader own Claude wire
// and native history. No transcript text is ever interpreted as an operation.
#load "../../coax/lib/agent/environment/host-wire.coax";
#load "../../coax/lib/agent/engine/engine.coax";
#load "../../coax/lib/agent/observe/claude-files.coax";
#load "../../coax/lib/agent/environment/history.coax";
#load "../../coax/lib/agent/session/log.coax";
#load "../../coax/lib/agent/environment/task-store.coax";
#load "../../coax/lib/agent/accounts/claude.coax";

ES_SLOTS :: 4;
XtRun :: struct {
 active:bool;dispatched:bool;status:[1]XtStatus;strings:[2048]u8;route:[32768]u8;nroute:int;
 auth:[1]PaProbe;auth_account:[1]PaAccount;auth_done:bool;auth_ok:bool;deadline:int;
}
EsSlot :: struct {
  occupied:bool;probing:bool;offer_index:int;summary:EaSession;grant:[64]u8;device:[64]u8;engine:[1]Engine;s:[1]Session;
  mode:int;codex:[1]CxEngine;codex_mem:[CX_MEM]u8;execution:[1]XtRun;
  provider:[32]u8;nprovider:int;options:[1]ClOptions;pool:[524288]u8;line:[1048576]u8;arena:[1048576]u8;
  out:[2*EX_INPUT_MAX+8192]u8;scratch:[2*EX_INPUT_MAX+8192]u8;prompt:[EX_INPUT_MAX+1024]u8;last_saved:int;failed:bool;started:bool;
}
EsHost :: struct {slots:[ES_SLOTS]EsSlot;configuration:[1]EaConfiguration;configured:bool;}

// The resident service owns buffers and admission; the shared agent interface
// owns Send, pumping, approvals and Stop. The frozen runtime profile is Claude
// only. A routed multi-engine profile must pin its engine before using this view.
es_agent :: (slot:[]EsSlot)->Agent #effects(all) {
  none:[]CxEngine;return Agent.{mode=slot[0].mode,claude=slot[0].engine[..],codex=ifx slot[0].mode==MODE_CODEX then slot[0].codex[..] else none,session=slot[0].s[..]};
}

// The same registered RuntimeRequest/View, newline framed over an owner-only
// Unix socket. Both ends authenticate the actual kernel peer, never a supplied
// PID or a loopback address. One request per connection; no shell command.
es_local_listen :: ()->int #effects(all) {
  path:[1400]u8;p:=es_path("service.sock",path[..]);for c:p {_ = cxsock_host_push(cast(int)c);}return cxsock_listen_unix();
}
es_local_tick :: (h:[]HsHost,listener:int) #effects(all) {
  connection:=cxsock_accept(listener,0);if connection<0 {return;}defer {_ = cxsock_close(connection);}
  if cxsock_peer_self(connection)!=1 {return;}
  input:[24576]u8;n:=0;done:=false;deadline:=cxsock_now_ms()+1000;
  while cxsock_now_ms()<deadline && !done {
    got:=cxsock_read(connection,50);if got== -2 {continue;}if got<0 {break;}
    for i:0..<got {c:=cxsock_byte(connection,i);if c==10 {done=true;break;}if n>=input.count {return;}input[n]=cast(u8)c;n+=1;}
  }
  q:[1]EaRequest;if !done || !ea_read(cast(string)input[0..<n],q[..]) {return;}
  v:[1]EaView;c:=h[0].environment[0].configuration[..];
  if !es_load_configuration(h[0].environment[..]) {return;}
  es_dispatch(h,q[..],cast(string)c[0].device[..],cast(string)c[0].grant[..],v[..]);
  out:[HB_BODY_MAX]u8;made:=ea_view_write(v[..],out[..]);if made<1 {return;}
  for i:0..<made {_ = cxsock_write(connection,cast(int)out[i]);}_ = cxsock_write(connection,10);_ = cxsock_flush(connection,2000);
}
es_local_call :: (args:[]Args)->int #effects(all) {
  data:[24576]u8;n:=fs_read(args_value(args,"--request-file",""),data[..]);q:[1]EaRequest;
  if n<1 || !ea_read(cast(string)data[0..<n],q[..]) {return 2;}
  path:[1400]u8;p:=es_path("service.sock",path[..]);for c:p {_ = cxsock_host_push(cast(int)c);}
  connection:=cxsock_connect_unix(2000);if connection<0 {return 3;}defer {_ = cxsock_close(connection);}
  if cxsock_peer_self(connection)!=1 {return 3;}
  for i:0..<n {_ = cxsock_write(connection,cast(int)data[i]);}_ = cxsock_write(connection,10);if cxsock_flush(connection,2000)<0 {return 3;}
  out:[HB_BODY_MAX]u8;at:=0;deadline:=cxsock_now_ms()+10000;
  while cxsock_now_ms()<deadline {got:=cxsock_read(connection,500);if got== -2 {continue;}if got<0 {return 3;}
    for i:0..<got {c:=cxsock_byte(connection,i);if c==10 {v:[1]EaView;if !ea_view_read(cast(string)out[0..<at],v[..]) {return 3;}hs_outln(cast(string)out[0..<at]);return 0;}if at>=out.count {return 3;}out[at]=cast(u8)c;at+=1;}
  }return 3;
}

es_path :: (name:string,out:[]u8)->string #effects(all) {return hs_path(name,out);}
es_configure :: (args:[]Args)->int #effects(all) {
  device:=args_value(args,"--device","");grant:=args_value(args,"--grant","");workspace:=args_value(args,"--workspace","");label:=args_value(args,"--label","");
  canonical:[1024]u8;root:=fs_realpath(workspace,canonical[..]);history_path:[1024]u8;history:=fs_realpath(args_value(args,"--history-root",workspace),history_path[..]);
  if !ea_id(device,64) || !ea_id(grant,64) || root.count==0 || fs_kind(root)!=FS_DIR || history.count==0 || fs_kind(history)!=FS_DIR || label.count==0 || label.count>80 {tool_errln("environment-enable needs --device KEY --grant ID --workspace EXISTING_ROOT --label NAME");return 2;}
  st:[1]HsState;b:[HS_STATE_MAX]u8;hs_load(st[..],b[..]);found:=false;
  for i:0..<st[0].ng {g:=st[0].grants[i];if cast(string)g.device[..]==device && cast(string)g.grant[..]==grant && !g.revoked && g.expires>hs_now() {found=true;}}
  if !found {tool_errln("Allow this device through coder host pairing first.");return 3;}
  c:[1]EaConfiguration;c[0].enabled=true;n:=ea_copy(c[0].device[..],device);n=ea_copy(c[0].grant[..],grant);
  c[0].nh=ea_copy(c[0].history[..],history);c[0].nw=ea_copy(c[0].workspace[..],root);c[0].nl=ea_copy(c[0].label[..],label);
  also:=args_has(args,"--also");
  prior:[1]EsHost;if es_load_configuration(prior[..]) {
    old:=prior[0].configuration[0];
    if cast(string)old.grant[..]==grant && (also || cast(string)old.workspace[0..<old.nw]!=root) {tool_errln("A workspace binding is immutable. Revoke and pair a new grant to change it.");return 3;}
  }
  if also {
    second:[1]EsHost;if es_load_device(second[..],grant) && cast(string)second[0].configuration[0].workspace[0..<second[0].configuration[0].nw]!=root {tool_errln("A workspace binding is immutable. Revoke and pair a new grant to change it.");return 3;}
  }
  out:[8192]u8;n=ea_config_write(c[..],out[..]);p:[1400]u8;
  file:=ifx also then es_device_file(grant,p[..]) else es_path("environment.json",p[..]);
  if n<1 || !hs_dir() || !fs_replace_durable(file,cast(string)out[0..<n]) {return 1;}
  hs_outln("Environment enabled for this device and workspace. Existing terminal histories remain read-only.");return 0;
}
// A further device's enrollment (a paired phone, coder host pair), beside the first in
// environment.json: its own file, named by its grant. Each binds one device, one grant and
// one workspace, with the same immutability; revoking the grant ends it.
es_device_file :: (grant:string,out:[]u8)->string #effects(all) {
  b:[160]u8;n:=hs_cat(b[..],0,"environment-device-");n=hs_cat(b[..],n,grant);n=hs_cat(b[..],n,".json");return es_path(cast(string)b[0..<n],out);
}
es_load_device :: (e:[]EsHost,grant:string)->bool #effects(all) {
  if !ea_id(grant,64) {return false;}
  p:[1400]u8;b:[8192]u8;n:=fs_read(es_device_file(grant,p[..]),b[..]);c:[1]EaConfiguration;
  if n<1 || !ea_config_read(cast(string)b[0..<n],c[..]) || !c[0].enabled || cast(string)c[0].grant[..]!=grant {return false;}
  e[0].configuration[0]=c[0];e[0].configured=true;return true;
}
// The enrollment a request is admitted under: the first one when it is this device's and grant's,
// else this grant's own, else the first (whose scope then refuses the request).
es_load_for :: (e:[]EsHost,signer:string,grant:string)->bool #effects(all) {
  first:=es_load_configuration(e);
  if first && cast(string)e[0].configuration[0].device[..]==signer && cast(string)e[0].configuration[0].grant[..]==grant {return true;}
  other:[1]EsHost;
  if es_load_device(other[..],grant) && cast(string)other[0].configuration[0].device[..]==signer {e[0].configuration[0]=other[0].configuration[0];e[0].configured=true;return true;}
  return first;
}
es_load_configuration :: (e:[]EsHost)->bool #effects(all) {
  p:[1400]u8;b:[8192]u8;n:=fs_read(es_path("environment.json",p[..]),b[..]);
  e[0].configured=n>0 && ea_config_read(cast(string)b[0..<ifx n>0 then n else 0],e[0].configuration[..]) && e[0].configuration[0].enabled;
  return e[0].configured;
}
es_find :: (e:[]EsHost,id:string,grant:string)->int #effects(all) {
  for i:0..<ES_SLOTS {s:=e[0].slots[i].summary;g:=e[0].slots[i].grant;
    if e[0].slots[i].occupied && cast(string)s.id[0..<s.ni]==id && cast(string)g[..]==grant {return i;}}
  return -1;
}
es_file :: (slot:[]EsSlot,extension:string,out:[]u8)->string #effects(all) {
  return es_named_file(cast(string)slot[0].grant[..],cast(string)slot[0].summary.id[0..<slot[0].summary.ni],extension,out);
}
es_named_file :: (grant:string,id:string,extension:string,out:[]u8)->string #effects(all) {
  b:[256]u8;n:=hs_cat(b[..],0,"environment-");n=hs_cat(b[..],n,grant);n=hs_cat(b[..],n,"-");n=hs_cat(b[..],n,id);n=hs_cat(b[..],n,extension);
  return es_path(cast(string)b[0..<n],out);
}
es_save :: (slot:[]EsSlot,host:string,label:string)->bool #effects(all) {
  // Reuse the session log's one writer, including tools and native notices.
  saved_log:[2097152]u8;n:=sl_lines_checked(slot[0].s[..],0,slot[0].s[0].n,!slot[0].s[0].live,saved_log[..]);
  p:[1400]u8;if n<0 || !fs_replace_durable(es_file(slot,".jsonl",p[..]),cast(string)saved_log[0..<n]) {slot[0].failed=true;return false;}
  v:[1]EaView;v[0].nh=ea_copy(v[0].host[..],host);v[0].nl=ea_copy(v[0].label[..],label);v[0].nm=ea_copy(v[0].method[..],"ReadSession");v[0].ns=1;v[0].sessions[0]=slot[0].summary;v[0].complete=true;
  b:[8192]u8;n=ea_view_write(v[..],b[..]);
  if n<0 || !fs_replace_durable(es_file(slot,".json",p[..]),cast(string)b[0..<n]) {slot[0].failed=true;return false;}
  return true;
}
es_tick :: (h:[]HsHost) #effects(all) {
  e:=h[0].environment[..];
  now:=cxproc_wall_us()/1000;
  for i:0..<ES_SLOTS {slot:=e[0].slots[i..<i+1];
    why:=es_free_why(slot,now);if why!=ES_KEEP {es_release(h,slot,why==ES_IDLE);continue;}
    if !slot[0].occupied || slot[0].probing || slot[0].failed || slot[0].execution[0].active {continue;}
    s:=slot[0].s[..];before:=s[0].live;asking:=s[0].asking;
    slot[0].started=slot[0].started || slot[0].engine[0].running;ag_poll(es_agent(slot),0.016,true);
    if s[0].exhausted {slot[0].failed=true;ag_stop(es_agent(slot));}
    if slot[0].started && !slot[0].engine[0].running {slot[0].summary.nc=ea_copy(slot[0].summary.control[..],"observe-only");}
    if s[0].changed || before!=s[0].live || asking!=s[0].asking {
      slot[0].summary.busy=s[0].live;slot[0].summary.updated=cxproc_wall_us()/1000;
      if asking!=s[0].asking {slot[0].summary.revision+=1;}
      pending:=ifx s[0].asking>=0 then cl_pending_id(slot[0].engine[0].q[..]) else "";
      slot[0].summary.nr=ea_copy(slot[0].summary.interaction[..],pending);
      if slot[0].summary.nr<0 {slot[0].summary.nr=0;slot[0].failed=true;ag_stop(es_agent(slot));}
      // Snapshots are bounded; no live process continues after a failed save.
      if !es_save(slot,cast(string)h[0].xhex[..],cast(string)e[0].configuration[0].label[0..<e[0].configuration[0].nl]) {ag_stop(es_agent(slot));}
      s[0].changed=false;
    }
  }
}

// Slots are given back (environment-runtime-v1alpha1.md, "The service retains four managed
// process slots"). A managed chat holds one while its Claude process runs; it gives it back when
// that process ends, after ES_IDLE_MS with no turn, or when a new chat needs one and it is the
// least recently used idle chat. A turn running, a permission waiting or a message still on its
// way to the CLI keeps the slot. A chat given back while idle keeps its Claude session ID beside
// its saved files and continues on its next message; one whose process ended is read only.
ES_IDLE_MS :: 600000;
ES_KEEP :: 0; ES_ENDED :: 1; ES_IDLE :: 2;
// A managed chat with nothing in progress.
es_idle :: (slot:[]EsSlot)->bool #effects(all) {
  return slot[0].occupied && es_idle_rule(slot[0].probing || slot[0].execution[0].active,slot[0].s[0].live,slot[0].s[0].asking,slot[0].engine[0].pend,slot[0].summary.nr);
}
es_idle_rule :: (other:bool,live:bool,asking:int,pend:int,interaction:int)->bool {return !other && !live && asking<0 && pend<0 && interaction==0;}
// Whether a slot is given back now, and why (ES_KEEP: not).
es_free_why :: (slot:[]EsSlot,now:int)->int #effects(all) {
  return es_free_rule(es_idle(slot),slot[0].failed || (slot[0].started && !slot[0].engine[0].running),slot[0].summary.updated,now);
}
es_free_rule :: (idle:bool,ended:bool,updated:int,now:int)->int {
  if !idle {return ES_KEEP;}if ended {return ES_ENDED;}return ifx now-updated>=ES_IDLE_MS then ES_IDLE else ES_KEEP;
}
// The idle chat a new one takes the slot of: the least recently updated, or -1.
es_evict_pick :: (e:[]EsHost)->int #effects(all) {
  idle:[ES_SLOTS]bool;updated:[ES_SLOTS]int;for i:0..<ES_SLOTS {idle[i]=es_idle(e[0].slots[i..<i+1]);updated[i]=e[0].slots[i].summary.updated;}
  return es_oldest(idle[..],updated[..]);
}
es_oldest :: (idle:[]bool,updated:[]int)->int {k:= -1;for i:0..<idle.count {if idle[i] && (k<0 || updated[i]<updated[k]) {k=i;}}return k;}
// A free slot for a new or resumed chat, giving back the least recent idle one when all are
// held; -1 when every slot has a turn running or a permission waiting.
es_take_slot :: (h:[]HsHost)->int #effects(all) {
  e:=h[0].environment[..];for i:0..<ES_SLOTS {if !e[0].slots[i].occupied {return i;}}
  k:=es_evict_pick(e);if k<0 {return -1;}es_release(h,e[0].slots[k..<k+1],true);return k;
}
// The slot gives its chat back: saved as it stands, its Claude process closed. resume keeps its
// Claude session ID (environment-GRANT-ID.resume) so the next message continues it.
es_release :: (h:[]HsHost,slot:[]EsSlot,resume:bool) #effects(all) {
  e:=h[0].environment[..];c:=e[0].configuration[..];
  saved:=!slot[0].failed && es_save(slot,cast(string)h[0].xhex[..],cast(string)c[0].label[0..<c[0].nl]);
  p:[1400]u8;marker:=es_file(slot,".resume",p[..]);engine:=slot[0].engine[..];
  if resume && saved && engine[0].sid_n>0 {_ = fs_replace_durable(marker,cast(string)engine[0].sid[0..<engine[0].sid_n]);}
  else if fs_exists(marker) {_ = fs_remove(marker);}
  xt_close(slot);xt_reset(slot);
}
// A chat's kept Claude session ID ("" when it was not given back while idle).
es_resume_id :: (grant:string,id:string,out:[]u8)->string #effects(all) {
  p:[1400]u8;n:=fs_read(es_named_file(grant,id,".resume",p[..]),out);
  if n<1 || n>128 {return "";}for b:out[0..<n] {if !((b>='0' && b<='9') || (b>='a' && b<='z') || (b>='A' && b<='Z') || b=='-') {return "";}}
  return cast(string)out[0..<n];
}
// A slot made ready for a managed chat of this grant and device.
es_occupy :: (h:[]HsHost,slot:[]EsSlot,grant:string,device:string) #effects(all) {
  e:=h[0].environment[..];
  xt_reset(slot);slot[0].occupied=true;ncopy:=ea_copy(slot[0].grant[..],grant);ncopy=ea_copy(slot[0].device[..],device);
  s:=slot[0].s[..];s_init(s,slot[0].pool[..]);engine:=slot[0].engine[..];e_attach(engine,slot[0].line[..],slot[0].arena[..],slot[0].out[..],slot[0].scratch[..],slot[0].prompt[..]);
  c:=e[0].configuration[..];engine[0].cwd_n=ea_copy(engine[0].cwd[..],cast(string)c[0].workspace[0..<c[0].nw]);
  home:[1024]u8;exe:[1200]u8;p:=fs_join(proc_getenv("HOME",home[..]),".local/bin/claude",exe[..]);if fs_kind(p)==FS_FILE {engine[0].claude_n=ea_copy(engine[0].claude[..],p);}
  slot[0].summary.updated=cxproc_wall_us()/1000;
}
// A chat given back while idle takes a slot again with its saved history and Claude session:
// its slot index, -1 when it cannot continue, -2 when no slot is free.
es_resume :: (h:[]HsHost,id:string,grant:string,device:string)->int #effects(all) {
  summary:[1]EaSession;sid:[128]u8;
  if !es_saved_summary(h,id,grant,summary[..]) || cast(string)summary[0].control[0..<summary[0].nc]!="available" {return -1;}
  resume:=es_resume_id(grant,id,sid[..]);if resume.count==0 {return -1;}
  k:=es_take_slot(h);if k<0 {return -2;}
  slot:=h[0].environment[0].slots[k..<k+1];es_occupy(h,slot,grant,device);
  saved:=summary[0];saved.updated=slot[0].summary.updated;slot[0].summary=saved;
  path:[1400]u8;data:[2097152]u8;n:=fs_read(es_file(slot,".jsonl",path[..]),data[..]);
  if n<0 || !pa_bind(h,slot,id,grant) {xt_reset(slot);return -1;}
  sl_load(slot[0].s[..],cast(string)data[0..<n]);
  engine:=slot[0].engine[..];engine[0].sid_n=ea_copy(engine[0].sid[..],resume);
  // the slot owns the chat again; a restart from here reads it as observe-only
  p:[1400]u8;_ = fs_remove(es_named_file(grant,id,".resume",p[..]));
  return k;
}
#test "a slot is given back when its chat ends or idles, never during a turn or a permission" {
  #assert es_idle_rule(false,false,-1,-1,0) && !es_idle_rule(false,true,-1,-1,0) && !es_idle_rule(false,false,0,-1,0) && !es_idle_rule(false,false,-1,0,0) && !es_idle_rule(false,false,-1,-1,3) && !es_idle_rule(true,false,-1,-1,0);
  #assert es_free_rule(true,false,1000,1000+ES_IDLE_MS-1)==ES_KEEP && es_free_rule(true,false,1000,1000+ES_IDLE_MS)==ES_IDLE;
  #assert es_free_rule(true,true,1000,1001)==ES_ENDED && es_free_rule(false,true,1000,1000+ES_IDLE_MS)==ES_KEEP && es_free_rule(false,false,1000,1000+ES_IDLE_MS)==ES_KEEP;
}
#test "a full computer gives a new chat the least recently used idle slot, and refuses when all are busy" {
  idle:=[4]bool.[false,false,false,false];updated:=[4]int.[5000,4999,4998,4997];#assert es_oldest(idle[..],updated[..])== -1;
  idle[1]=true;idle[2]=true;#assert es_oldest(idle[..],updated[..])==2;idle[2]=false;#assert es_oldest(idle[..],updated[..])==1;
}

es_handle :: (h:[]HsHost,rq:HbAppRequest,signer:string,event:string,mailbox:string,w:[]HbWork,st:[]HsState,statebuf:[]u8,out:[]u8)->int #effects(all) {
  if rq.request!=mailbox || rq.host!=cast(string)h[0].xhex[..] || rq.relay!=hs_relay_of(h) {return 0;}
  configured:=es_load_for(h[0].environment[..],signer,rq.grant);c:=h[0].environment[0].configuration[..];
  hs_load(st,statebuf);ga:[HS_GRANTS]HostGrantRecord;epochs:[HS_EPOCHS]HostEpoch;hs_records(st,ga[..],epochs[..]);
  scoped:=ea_scope(configured,c[0].enabled,cast(string)c[0].device[..]==signer,cast(string)c[0].grant[..]==rq.grant);
  // The local operator's explicit environment enable extends this one grant
  // with review. It never changes the frozen realm-browser wire projection.
  if scoped {for i:0..<st[0].ng {if ga[i].grant==rq.grant && ga[i].device==signer {ga[i].rights|=1<<HA_REVIEW;}}}
  params:=[1]EaRequest.[rq.params];right:=ea_right(cast(string)params[0].method[0..<params[0].nm]);
  request:=HostRequest.{request=rq.request,event=event,signer=signer,grant=rq.grant,epoch=rq.epoch,issued_at=rq.issued_at,expires_at=rq.expires_at,right=right};
  none:[1]HostRetained;verdict:=host_admit(ga[0..<st[0].ng],epochs[0..<st[0].ne],none[0..<0],request,hs_now());
  if verdict==HA_SILENT {return 0;}
  if verdict!=HA_OK || !scoped {return hs_seal_reply(h,hs_refused(h,rq.request,event,rq.expires_at,"forbidden",""),signer,w,out);}
  v:[1]EaView;es_dispatch(h,params[..],signer,rq.grant,v[..]);data:[HB_BODY_MAX]u8;vn:=ea_view_write(v[..],data[..]);
  if vn<1 {return hs_seal_reply(h,hs_refused(h,rq.request,event,rq.expires_at,"too_large",""),signer,w,out);}
  body:[HB_BODY_MAX]u8;n:=hb_app_reply_write(rq.request,event,cast(string)h[0].xhex[..],hs_now(),rq.expires_at,cast(string)params[0].method[0..<params[0].nm],cast(string)data[0..<vn],body[..]);
  peer:[32]u8;nonce:[32]u8;aux:[32]u8;
  if n<1 || !hb_unhex(signer,peer[..]) || cxrand_draw(nonce[..],32)!=0 || cxrand_draw(aux[..],32)!=0 {return 0;}
  return hb_seal(cast(string)body[0..<n],HB_REPLY_SCHEMA,h[0].secret[..],peer[..],rq.request,nonce[..],aux[..],hs_now(),w,out);
}

es_rpc_call :: (args:[]Args)->int #effects(all) {
 input:[24576]u8;n:=fs_read(args_value(args,"--request-file",""),input[..]);q:[1]EaRequest;if n<1 || !ea_read(cast(string)input[0..<n],q[..]) {return 2;}
 out:[HB_BODY_MAX]u8;result:=es_rpc_exchange(args,cast(string)q[0].method[0..<q[0].nm],cast(string)input[0..<n],out[..]);size:=result.n;v:[1]EaView;
 if size== -5 {v[0].nh=ea_copy(v[0].host[..],args_value(args,"--host",""));v[0].nm=ea_copy(v[0].method[..],cast(string)q[0].method[0..<q[0].nm]);es_refuse(v[..],cast(string)result.code[0..<result.nc]);made:=ea_view_write(v[..],out[..]);if made>0 {hs_outln(cast(string)out[0..<made]);return 0;}return 3;}
 if size<1 || !ea_view_read(cast(string)out[0..<size],v[..]) {tool_errln("Environment did not return an admitted reply. No command is automatically replayed.");return 3;}hs_outln(cast(string)out[0..<size]);return 0;
}
// How long a call waits for the computer's reply: --wait-ms, from 1 to 20 seconds; 20 when unset or unreadable.
es_wait_ms :: (text:string)->int {
  if text.count==0 || text.count>5 {return 20000;}v:=0;for c:text {if c<'0' || c>'9' {return 20000;}v=v*10+cast(int)(c-'0');}
  return ifx v<1000 then 1000 else ifx v>20000 then 20000 else v;
}
#test "a call's wait is bounded" {
  #assert es_wait_ms("")==20000 && es_wait_ms("8000")==8000 && es_wait_ms("1000")==1000 && es_wait_ms("999")==1000 && es_wait_ms("20000")==20000 && es_wait_ms("20001")==20000;
  #assert es_wait_ms("99999")==20000 && es_wait_ms("123456")==20000 && es_wait_ms("8s")==20000 && es_wait_ms("-1")==20000 && es_wait_ms("0")==1000;
}
EsRpcResult :: struct {n:int;code:[40]u8;nc:int;}
es_rpc_exchange :: (args:[]Args,method:string,raw:string,response:[]u8)->EsRpcResult #effects(all) {
  host:=args_value(args,"--host","");grant:=args_value(args,"--grant","");epoch:=hs_atoi(args_value(args,"--epoch","0"));
  keyfile:=args_value(args,"--browser-key","");requestfile:=args_value(args,"--request-file","");
  hx:[32]u8;sk:[32]u8;bx:[32]u8;bhex:[64]u8;key:[80]u8;
  if !hb_unhex(host,hx[..]) || !ea_id(grant,64) || epoch<0 {tool_errln("host rpc needs --host KEY --grant ID --epoch N --browser-key FILE --request-file FILE");return EsRpcResult.{n=-2};}
  nk:=fs_read(keyfile,key[..]);while nk>0 && (key[nk-1]==10 || key[nk-1]==13) {nk-=1;}
  if nk!=64 || !hb_unhex(cast(string)key[0..<64],sk[..]) || !hb_public(sk[..],bx[..]) || !hb_hex(bx[..],bhex[..]) {wipe(key[..]);return EsRpcResult.{n=-2};}
  wipe(key[..]);defer {wipe(sk[..]);}
  relay:=args_value(args,"--relay",HS_RELAY);if !relay_uri(relay).ok {return EsRpcResult.{n=-2};}
  rb:[64]u8;request:=hs_random_hex(32,rb[..]);now:=hs_now();
  q:=HbRpcRequest.{request=request,host=host,grant=grant,relay=relay,epoch=epoch,issued_at=now,expires_at=now+60,method=method,params=raw};
  body:[HB_BODY_MAX]u8;n:=hb_rpc_write(q,body[..]);w:[1]HbWork;out:[131072]u8;nonce:[32]u8;aux:[32]u8;
  if n<1 || cxrand_draw(nonce[..],32)!=0 || cxrand_draw(aux[..],32)!=0 {return EsRpcResult.{n=-2};}
  sealed:=hb_seal(cast(string)body[0..<n],HB_REQUEST_SCHEMA,sk[..],hx[..],request,nonce[..],aux[..],now,w[..],out[..]);if sealed<1 {return EsRpcResult.{n=-2};}
  idb:[64]u8;event:=hs_event_id(cast(string)out[0..<sealed],idb[..]);sub:[1]CliRelay;pub:[1]CliRelay;
  if !cr_open(sub[..],relay,sk[..]) {return EsRpcResult.{n=-3};}
  defer {cr_close(sub[..]);if pub[0].open {cr_close(pub[..]);}}
  filter:[512]u8;nf:=hb_reply_filter(cast(string)bhex[..],request,filter[..]);
  if nf<1 || !cr_req(sub[..],cast(string)filter[0..<nf]) || !cr_open(pub[..],relay,sk[..]) || !cr_publish(pub[..],cast(string)out[0..<sealed],cxsock_now_ms()+5000) {return EsRpcResult.{n=-3};}
  cr_close(pub[..]);deadline:=cxsock_now_ms()+es_wait_ms(args_value(args,"--wait-ms",""));
  while cxsock_now_ms()<deadline {
    result:=cr_next(sub[..],deadline);if result==CR_FAIL || result==CR_CLOSED {break;}if result!=CR_EVENT {continue;}
    opened:=hb_open(cr_event(sub[..]),sk[..],bx[..],HB_REPLY_SCHEMA,w[..],body[..]);
    if opened.error!=HB_OK || cast(string)opened.signer[..]!=host || cast(string)opened.mailbox[..]!=request {continue;}
    value:=hb_app_reply_read(cast(string)body[0..<opened.body_n],host,request,event,method,hs_now());
    if value.count>0 {return EsRpcResult.{n=pa_copy(response,value)};}
    // A signed, correlated refusal is a result, not a transport timeout.
    refusal:[1]HbReply;arena:[4096]u8;text:=[1]HbText.[HbText.{buf=arena[..]}];
    if hb_reply_read(cast(string)body[0..<opened.body_n],refusal[..],text[..])==HB_OK && !refusal[0].ok && refusal[0].host==host && refusal[0].request==request && refusal[0].request_event==event && refusal[0].expires_at>=hs_now() {
      refused_result:EsRpcResult;refused_result.n= -5;refused_result.nc=pa_copy(refused_result.code[..],refusal[0].code);return refused_result;
    }
  }
  return EsRpcResult.{n=-3};
}
es_snapshot :: (h:[]HsHost,q:[]EaRequest,grant:string,v:[]EaView) #effects(all) {
  e:=h[0].environment[..];v[0]=EaView.{};v[0].nh=ea_copy(v[0].host[..],cast(string)h[0].xhex[..]);es_offer(v);
  c:=e[0].configuration[..];v[0].nl=ea_copy(v[0].label[..],cast(string)c[0].label[0..<c[0].nl]);v[0].nm=ea_copy(v[0].method[..],cast(string)q[0].method[0..<q[0].nm]);v[0].complete=true;
  for i:0..<ES_SLOTS {g:=e[0].slots[i].grant;if e[0].slots[i].occupied && !e[0].slots[i].probing && !e[0].slots[i].execution[0].active && cast(string)g[..]==grant {v[0].sessions[v[0].ns]=e[0].slots[i].summary;v[0].ns+=1;}}
  id:=cast(string)q[0].session[0..<q[0].ns];k:=es_find(e,id,grant);if k<0 || e[0].slots[k].execution[0].active {return;}
  slot:=e[0].slots[k..<k+1];es_project(slot[0].s[..],q,v);
  if slot[0].failed {for i:0..<v[0].ns {if cast(string)v[0].sessions[i].id[0..<v[0].sessions[i].ni]==id {v[0].sessions[i].nc=ea_copy(v[0].sessions[i].control[..],"unknown");}}es_refuse(v,"record_limit");}

}

// One timeline projection for resident and recovered logs. The numeric cursor
// is (part+1)*1000000 + byte-end. Pages walk backward without dropping a long
// message; the owned arena survives value copies. A page is at most6000 raw
// bytes, leaving room for worst-case JSON escaping and HOST metadata.
es_project :: (s:[]Session,q:[]EaRequest,v:[]EaView) #effects(all) {
  part:=s[0].n-1;end:= -1;
  if q[0].before>0 {part=q[0].before/1000000-1;end=q[0].before%1000000;if part<0 || part>=s[0].n {es_refuse(v,"stale_cursor");return;}}
  bytes:=0;
  while part>=0 && v[0].ni<24 && bytes<5996 {
    p:=s[0].parts[part];if p.kind==P_THINK {part-=1;end= -1;continue;}
    text:=ifx p.kind==P_TOOL then (ifx p.resolved && p.output.count>0 then p.output else ifx p.input.count>0 then p.input else p.detail) else s_text_of(s,part);
    to:=ifx end>=0 then end else text.count;if to>text.count {es_refuse(v,"stale_cursor");return;}
    start:=ifx to>6000-bytes then to-(6000-bytes) else 0;
    while start<to && text[start]>=128 && text[start]<192 {start+=1;}
    m:=v[0].items[v[0].ni];id:[128]u8;n:=hs_cat(id[..],0,"");digits:[64]u8;n=hs_cat(id[..],n,hs_itoa(part,digits[..]));n=hs_cat(id[..],n,":");n=hs_cat(id[..],n,hs_itoa(start,digits[..]));m.ni=ea_copy(m.id[..],cast(string)id[0..<n]);
    m.nr=ea_copy(m.role[..],ifx p.kind==P_USER then "user" else ifx p.kind==P_TOOL then "tool" else ifx p.kind==P_TEXT then "assistant" else "notice");m.nk=ea_copy(m.tool[..],hs_cut(p.name,128));
    m.text_at=ea_text_put(v,cast(string)text[start..<to]);m.nt=to-start;m.complete=start==0 && to==text.count && (p.kind!=P_TEXT || part<s[0].n-1 || !s[0].live);if m.text_at<0 {es_refuse(v,"output_limit");return;}
    v[0].items[v[0].ni]=m;v[0].ni+=1;bytes+=m.nt;
    if start>0 {end=start;break;}part-=1;end= -1;
  }
  // Offsets borrow only our owned arena; reverse item order, never their bytes.
  for i:0..<v[0].ni/2 {j:=v[0].ni-1-i;tmp:=v[0].items[i];v[0].items[i]=v[0].items[j];v[0].items[j]=tmp;}
  if part>=0 {if end<0 {p:=s[0].parts[part];text:=ifx p.kind==P_TOOL then (ifx p.resolved && p.output.count>0 then p.output else ifx p.input.count>0 then p.input else p.detail) else s_text_of(s,part);end=text.count;}
    b:[64]u8;v[0].nc=ea_copy(v[0].cursor[..],hs_itoa((part+1)*1000000+end,b[..]));v[0].complete=false;}
}
#test "managed timeline pages retain every byte of a long message and refuse a foreign cursor" {
  s:[1]Session;pool:[24000]u8;s_init(s[..],pool[..]);text:[12000]u8;for i:0..<12000 {text[i]=ifx i<6000 then cast(u8)'a' else cast(u8)'b';}s_user(s[..],cast(string)text[..]);
  q:[1]EaRequest;v:[1]EaView;es_project(s[..],q[..],v[..]);#assert v[0].ni==1 && ea_item_text(v[..],0)==cast(string)text[6000..<12000] && v[0].nc>0;
  q[0].before=1006000;v[0]=EaView.{};es_project(s[..],q[..],v[..]);#assert v[0].ni==1 && ea_item_text(v[..],0)==cast(string)text[0..<6000] && v[0].nc==0;
  q[0].before=9000000;v[0]=EaView.{};es_project(s[..],q[..],v[..]);#assert v[0].ne>0 && v[0].ni==0;
}

es_refuse :: (v:[]EaView,code:string) #effects(all) {v[0].ne=ea_copy(v[0].error[..],code);v[0].complete=false;}
// What a new conversation can start on: the engine's own catalog (the one a
// fresh slot starts with), its unnamed CLI default named "default".
es_offer :: (v:[]EaView) #effects(all) {
  c:=[1]AgCatalog.[claude_catalog()];o:=v[0].offer;o=EaOffer.{};
  o.nv=ifx c[0].levels<EA_LEVELS then c[0].levels else EA_LEVELS;o.default_level=c[0].default_level;
  for k:0..<o.nv {o.levels[k].ni=ea_copy(o.levels[k].id[..],c[0].level_id[k]);o.levels[k].nl=ea_copy(o.levels[k].label[..],c[0].level_label[k]);}
  for k:0..<c[0].n {if o.n>=EA_MODELS {break;}m:=o.models[o.n];
    m.ni=ea_copy(m.id[..],ifx c[0].id[k].count==0 then "default" else c[0].id[k]);m.nl=ea_copy(m.label[..],ifx c[0].id[k].count==0 then "Default" else c[0].label[k]);m.ladder=c[0].ladder[k]&((1<<o.nv)-1);
    if m.ni>0 && m.nl>0 {o.models[o.n]=m;o.n+=1;}}
  v[0].offer=o;
}
// The engine's model and level for a turn's choice (absent: unchanged); false
// when this computer's Claude does not offer it.
es_choice :: (cat:[]AgCatalog,q:[]EaRequest,model:[]int,level:[]int)->bool #effects(all) {
  if q[0].nmo>0 {
    id:=cast(string)q[0].model[0..<q[0].nmo];k:=claude_find(cat,ifx id=="default" then "" else id);
    if k<0 && id=="default" {k=0;}if k<0 {return false;}model[0]=k;
  }
  if q[0].nef>0 {
    id:=cast(string)q[0].effort[0..<q[0].nef];k:= -1;for i:0..<cat[0].levels {if cat[0].level_id[i]==id {k=i;}}
    if k<0 || (cat[0].ladder[model[0]]&(1<<k))==0 {return false;}level[0]=k;
  }
  return true;
}
// The conversation's model and effort as the views name them.
es_mark :: (slot:[]EsSlot) #effects(all) {
  e:=slot[0].engine[..];id:=e[0].cat[0].id[e[0].model];lv:=ag_level_for(e[0].cat[..],e[0].model,e[0].effort);
  slot[0].summary.nmo=ea_copy(slot[0].summary.model[..],ifx id.count==0 then "default" else id);if slot[0].summary.nmo<0 {slot[0].summary.nmo=0;}
  slot[0].summary.nef=ifx lv>=0 then ea_copy(slot[0].summary.effort[..],e[0].cat[0].level_id[lv]) else 0;if slot[0].summary.nef<0 {slot[0].summary.nef=0;}
}
#test "a turn runs on the offered model and effort and refuses one this computer does not offer" {
  cat:=[1]AgCatalog.[claude_catalog()];q:[1]EaRequest;m:=[1]int.[0];l:=[1]int.[2];
  #assert es_choice(cat[..],q[..],m[..],l[..]) && m[0]==0 && l[0]==2;
  q[0].nmo=ea_copy(q[0].model[..],"claude-opus-5-5");q[0].nef=ea_copy(q[0].effort[..],"max");
  #assert es_choice(cat[..],q[..],m[..],l[..]) && cat[0].id[m[0]]=="claude-opus-5-5" && cat[0].level_id[l[0]]=="max";
  q[0].nmo=ea_copy(q[0].model[..],"claude-haiku-4-5");m[0]=0;#assert !es_choice(cat[..],q[..],m[..],l[..]);
  q[0].nef=0;#assert es_choice(cat[..],q[..],m[..],l[..]) && cat[0].id[m[0]]=="claude-haiku-4-5";
  q[0].nmo=ea_copy(q[0].model[..],"claude-unknown-9");#assert !es_choice(cat[..],q[..],m[..],l[..]);
  q[0].nmo=ea_copy(q[0].model[..],"default");#assert es_choice(cat[..],q[..],m[..],l[..]) && m[0]==0;
  v:[1]EaView;es_offer(v[..]);#assert v[0].offer.n==cat[0].n && cast(string)v[0].offer.models[0].id[0..<v[0].offer.models[0].ni]=="default" && v[0].offer.nv==7;
}
es_saved_summary :: (h:[]HsHost,id:string,grant:string,summary:[]EaSession)->bool #effects(all) {
  if !ea_id(id,32) || !ea_id(grant,64) {return false;}
  slot:[1]EsSlot;slot[0].summary.ni=ea_copy(slot[0].summary.id[..],id);ncopy:=ea_copy(slot[0].grant[..],grant);
  path:[1400]u8;b:[8192]u8;n:=fs_read(es_file(slot[..],".json",path[..]),b[..]);v:[1]EaView;
  if n<1 || !ea_view_read(cast(string)b[0..<n],v[..]) || v[0].ns!=1 || cast(string)v[0].host[..]!=cast(string)h[0].xhex[..] {return false;}
  s:=v[0].sessions[0];if cast(string)s.id[0..<s.ni]!=id {return false;}
  // A chat that gave its slot back while idle (es_release) continues; any other saved chat is
  // read only, as after a service restart.
  sb:[128]u8;resumable:=!s.busy && es_resume_id(grant,id,sb[..]).count>0;
  s.nc=ea_copy(s.control[..],ifx s.busy then "unknown" else ifx resumable then "available" else "observe-only");s.busy=false;s.nr=0;summary[0]=s;return true;
}
es_saved_list :: (h:[]HsHost,grant:string,v:[]EaView) #effects(all) {
  dir:[1400]u8;files:[1]FsList;count:=fs_list(es_path("",dir[..]),files[..]);if count<0 {v[0].complete=false;return;}
  prefix:[128]u8;np:=hs_cat(prefix[..],0,"environment-");np=hs_cat(prefix[..],np,grant);np=hs_cat(prefix[..],np,"-");
  for i:0..<count {name:=fs_entry(files[..],i);
    if name.count!=np+37 || !hs_prefix(name,cast(string)prefix[0..<np]) || !csr_suffix(name,".json") {continue;}
    id:=cast(string)name[np..<np+32];if es_find(h[0].environment[..],id,grant)>=0 {continue;}
    summary:[1]EaSession;if !es_saved_summary(h,id,grant,summary[..]) {v[0].complete=false;continue;}
    if v[0].ns>=8 {v[0].complete=false;break;}v[0].sessions[v[0].ns]=summary[0];v[0].ns+=1;
  }
}
es_read_saved :: (h:[]HsHost,q:[]EaRequest,grant:string,v:[]EaView) #effects(all) {
  summary:[1]EaSession;id:=cast(string)q[0].session[0..<q[0].ns];if !es_saved_summary(h,id,grant,summary[..]) {es_refuse(v,"not_found");return;}
  slot:[1]EsSlot;slot[0].summary=summary[0];ncopy:=ea_copy(slot[0].grant[..],grant);path:[1400]u8;data:[2097152]u8;n:=fs_read(es_file(slot[..],".jsonl",path[..]),data[..]);
  if n<0 {es_refuse(v,"source_unavailable");return;}s_init(slot[0].s[..],slot[0].pool[..]);sl_load(slot[0].s[..],cast(string)data[0..<n]);
  v[0].ns=1;v[0].sessions[0]=summary[0];es_project(slot[0].s[..],q,v);

}
es_native_list :: (h:[]HsHost,q:[]EaRequest,v:[]EaView) #effects(all) {
  e:=h[0].environment[..];c:=e[0].configuration[..];scan:[1]CsrScan;rb:[2048]u8;pb:[2048]u8;
  root:=csr_root(rb[..]);projects:=fs_join(root,"projects",pb[..]);
  csr_discover_tree(scan[..],projects,cast(string)c[0].history[0..<c[0].nh],0);
  v[0].complete=v[0].complete && !scan[0].incomplete;
  start:=ifx q[0].before<scan[0].n then q[0].before else scan[0].n;
  for i:start..<scan[0].n {
    if v[0].ns>=16 {v[0].complete=false;b:[64]u8;v[0].nc=ea_copy(v[0].cursor[..],hs_itoa(i,b[..]));break;}row:=scan[0].rows[i];s:=v[0].sessions[v[0].ns];
    s.ni=ea_copy(s.id[..],cast(string)row.id[0..<row.nid]);s.nw=ea_copy(s.workspace[..],"default");s.nt=ea_copy(s.title[..],cast(string)row.title[0..<row.ntitle]);
    s.nc=ea_copy(s.control[..],"observe-only");s.updated=row.modified/1000000;v[0].sessions[v[0].ns]=s;v[0].ns+=1;
  }
}
es_native_read :: (h:[]HsHost,q:[]EaRequest,v:[]EaView) #effects(all) {
  // Resolve from the admitted workspace's catalog; a native UUID is not a path
  // grant and must never use the reader's broader exact-ID discovery shortcut.
  e:=h[0].environment[..];c:=e[0].configuration[..];scan:[1]CsrScan;rb:[2048]u8;pb:[2048]u8;
  root:=csr_root(rb[..]);projects:=fs_join(root,"projects",pb[..]);csr_discover_tree(scan[..],projects,cast(string)c[0].history[0..<c[0].nh],0);
  found:= -1;for i:0..<scan[0].n {row:=scan[0].rows[i];if cast(string)row.id[0..<row.nid]==cast(string)q[0].session[0..<q[0].ns] {found=i;}}
  if found<0 {es_refuse(v,ifx scan[0].incomplete then "discovery_incomplete" else "not_found");return;}
  row:=scan[0].rows[found];data:[CSR_OUTPUT_MAX]u8;raw:=csr_read_file(cast(string)row.path[0..<row.npath],cast(string)row.id[0..<row.nid],24,q[0].before,1024,false,data[..]);
  nodes:[2048]JvNode;d:[1]Jv;if !jv_parse(d[..],raw,nodes[..]) {es_refuse(v,"source_unavailable");return;}
  j:=d[0];if jv_get(j,0,"error")>=0 {es_refuse(v,"source_unavailable");return;}
  turns:=jv_get(j,0,"turns");if jv_kind(j,turns)!=JV_ARRAY {es_refuse(v,"source_unavailable");return;}
  if !eh_read(raw,v) {es_refuse(v,"output_limit");return;}
  before:=jv_int(j,jv_get(j,0,"next_before"),0);if before>0 {b:[64]u8;v[0].nc=ea_copy(v[0].cursor[..],hs_itoa(before,b[..]));}
  v[0].complete=before==0 && jv_len(j,jv_get(j,0,"warnings"))==0;
  epoch:[64]u8;v[0].np=ea_copy(v[0].epoch[..],hs_itoa(row.modified,epoch[..]));
}
es_dispatch :: (h:[]HsHost,q:[]EaRequest,device:string,grant:string,v:[]EaView) #effects(all) {
  e:=h[0].environment[..];es_snapshot(h,q,grant,v);method:=cast(string)q[0].method[0..<q[0].nm];
  if method=="DescribeEnvironment" {return;}
  if cast(string)q[0].workspace[0..<q[0].nw]!="default" {es_refuse(v,"workspace_refused");return;}
  if method=="ListSessions" {if q[0].before==0 {es_saved_list(h,grant,v);}else {v[0].ns=0;}es_native_list(h,q,v);return;}
  id:=cast(string)q[0].session[0..<q[0].ns];k:=es_find(e,id,grant);
  if k>=0 && e[0].slots[k].execution[0].active {es_refuse(v,"unsupported_profile");return;}
  if method=="ReadSession" {if k<0 {if ea_id(id,32) {es_read_saved(h,q,grant,v);}else {es_native_read(h,q,v);}}return;}
  if !ea_id(cast(string)q[0].command[0..<q[0].nc],32) || !ea_id(id,32) {es_refuse(v,"malformed");return;}
  command:[24576]u8;n:=ea_write(q,command[..]);if n<0 {es_refuse(v,"malformed");return;}
  name:[256]u8;name_n:=hs_cat(name[..],0,"command-");name_n=hs_cat(name[..],name_n,grant);name_n=hs_cat(name[..],name_n,"-");name_n=hs_cat(name[..],name_n,cast(string)q[0].command[..]);name_n=hs_cat(name[..],name_n,".json");
  path:[1400]u8;file:=es_path(cast(string)name[0..<name_n],path[..]);
  if fs_exists(file) {
    previous:[24576]u8;got:=fs_read(file,previous[..]);if got!=n || cast(string)previous[0..<ifx got>0 then got else 0]!=cast(string)command[0..<n] {es_refuse(v,"idempotency_conflict");return;}
    v[0].nq=ea_copy(v[0].command[..],cast(string)q[0].command[..]);v[0].nt=ea_copy(v[0].status[..],ifx k>=0 then "accepted" else "unknown");return;
  }
  if !ea_fresh(q[0].issued,q[0].expires,cxproc_wall_us()/1000) {es_refuse(v,"expired");return;}
  if method=="OpenSession" {
    if xt_claimed_session(grant,id) {es_refuse(v,"conflict");return;}
    if k>=0 || !ea_text(cast(string)q[0].text[0..<q[0].nt]) {es_refuse(v,"conflict");return;}
    k=es_take_slot(h);
    if k<0 {es_refuse(v,"capacity");return;}
    slot:=e[0].slots[k..<k+1];es_occupy(h,slot,grant,device);engine:=slot[0].engine[..];
    summary:=slot[0].summary;summary.ni=ea_copy(summary.id[..],id);summary.nw=ea_copy(summary.workspace[..],"default");summary.nt=ea_copy(summary.title[..],hs_cut(cast(string)q[0].text[0..<q[0].nt],200));
    summary.managed=true;summary.nc=ea_copy(summary.control[..],"available");summary.generation=cxproc_wall_us()/1000;slot[0].summary=summary;
    if !pa_bind(h,slot,id,grant) {slot[0].occupied=false;es_refuse(v,"conflict");return;}
    m:=[1]int.[engine[0].model];l:=[1]int.[engine[0].effort];
    if !es_choice(engine[0].cat[..],q,m[..],l[..]) {slot[0].occupied=false;es_refuse(v,"model_unavailable");return;}
  } else {
    // A chat that gave its slot back while idle continues: its next message resumes it.
    if k<0 && method=="SendMessage" {k=es_resume(h,id,grant,device);if k== -2 {es_refuse(v,"capacity");return;}}
    if k<0 {es_refuse(v,"not_found");return;}
    slot:=e[0].slots[k..<k+1];summary:=slot[0].summary;
    if slot[0].failed || cast(string)summary.control[0..<summary.nc]!="available" || ea_command(q[0].generation,summary.generation,q[0].revision,summary.revision,method=="SendMessage" && summary.busy,false)!=0 {es_refuse(v,"conflict");return;}
    if method=="SendMessage" && !ea_text(cast(string)q[0].text[0..<q[0].nt]) {es_refuse(v,"malformed");return;}
    m:=[1]int.[slot[0].engine[0].model];l:=[1]int.[slot[0].engine[0].effort];
    if method=="SendMessage" && !es_choice(slot[0].engine[0].cat[..],q,m[..],l[..]) {es_refuse(v,"model_unavailable");return;}
    if method=="RespondInteraction" && (summary.nr==0 || cast(string)summary.interaction[0..<summary.nr]!=cast(string)q[0].interaction[0..<q[0].ni]) {es_refuse(v,"interaction_expired");return;}
  }
  slot:=e[0].slots[k..<k+1];
  // A durable intent precedes every process/control effect. Its exact retry is
  // never automatically dispatched again, including after a service restart.
  if !fs_replace_durable(file,cast(string)command[0..<n]) {if method=="OpenSession" {slot[0].occupied=false;}es_refuse(v,"storage_unavailable");return;}
  slot[0].summary.revision+=1;
  if method=="OpenSession" || method=="SendMessage" {
    // The chosen model reaches a running CLI now; a new effort restarts it with this message.
    engine:=slot[0].engine[..];m:=[1]int.[engine[0].model];l:=[1]int.[engine[0].effort];
    if es_choice(engine[0].cat[..],q,m[..],l[..]) {if m[0]!=engine[0].model {e_set_model(engine,m[0]);}engine[0].effort=l[0];}
    es_mark(slot);text:=cast(string)q[0].text[0..<q[0].nt];ag_send(es_agent(slot),text,text);
  }
  else if method=="StopTurn" {ag_stop(es_agent(slot));}
  else if method=="RespondInteraction" {ag_answer(es_agent(slot),q[0].allow);}
  slot[0].summary.busy=slot[0].s[0].live;slot[0].summary.nr=0;es_tick(h);es_snapshot(h,q,grant,v);
  v[0].nq=ea_copy(v[0].command[..],cast(string)q[0].command[..]);v[0].nt=ea_copy(v[0].status[..],"accepted");
}

// coder host pair --workspace DIR [--label NAME] [--wait SECONDS]: pairs a phone with this
// computer, with no account. It prints a link with this computer's key, its relay and a one-time
// code; the phone that opens the link asks over the relay with the code in its pairing label
// (encrypted to this computer). The first waiting request whose label ends with the code is
// allowed, and its grant is enabled for DIR beside any other enrollment (environment-enable --also).
// The code is the evidence that the phone saw this screen; it is good for one pairing, while
// this command waits (ten minutes at most).
ES_PAIR_ALPHABET :: "ABCDEFGHJKMNPQRSTUVWXYZ23456789";
es_pair_code :: (out:[]u8)->string #effects(all) {
  b:[8]u8;if out.count<8 || cxrand_draw(b[..],8)!=0 {return "";}
  for i:0..<8 {out[i]=ES_PAIR_ALPHABET[cast(int)b[i]%ES_PAIR_ALPHABET.count];}return cast(string)out[0..<8];
}
// s into out from at, percent-escaping all but unreserved bytes (RFC 3986).
es_pair_escape :: (out:[]u8,at:int,s:string)->int #effects(all) {
  hex:="0123456789ABCDEF";n:=at;
  for c:s {
    plain:=(c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') || c=='-' || c=='.' || c=='_' || c=='~';
    if plain {if n<out.count {out[n]=c;n+=1;}}
    else if n+3<=out.count {out[n]='%';out[n+1]=hex[c>>4];out[n+2]=hex[c&15];n+=3;}
  }
  return n;
}
es_pair_ends :: (s:string,tail:string)->bool #effects(all) {return tail.count>0 && s.count>=tail.count && cast(string)s[s.count-tail.count..<s.count]==tail;}
es_pair :: (args:[]Args)->int #effects(all) {
  workspace:=args_value(args,"--workspace","");label:=args_value(args,"--label","This computer");
  canonical:[1024]u8;root:=fs_realpath(workspace,canonical[..]);
  if root.count==0 || fs_kind(root)!=FS_DIR || label.count==0 || label.count>80 {tool_errln("pair needs --workspace EXISTING_ROOT [--label NAME]");return 2;}
  wait:=hs_atoi(args_value(args,"--wait","600"));if wait<=0 || wait>600 {wait=600;}
  sk:[32]u8;x:[32]u8;xh:[64]u8;if !hs_key(sk[..],x[..],xh[..]) {tool_errln("coder host: could not read or make the host key");return 1;}wipe(sk[..]);
  eb:[512]u8;env:=proc_getenv("OPENAGENTS_NIP_HOST_RELAY",eb[..]);relay:=args_value(args,"--relay",ifx env.count>0 then env else HS_RELAY);
  cb:[8]u8;code:=es_pair_code(cb[..]);if code.count!=8 {return 1;}
  link:[1024]u8;n:=hs_cat(link[..],0,"openagents://pair?host=");n=hs_cat(link[..],n,cast(string)xh[..]);
  n=hs_cat(link[..],n,"&relay=");n=es_pair_escape(link[..],n,relay);n=hs_cat(link[..],n,"&code=");n=hs_cat(link[..],n,code);
  n=hs_cat(link[..],n,"&name=");n=es_pair_escape(link[..],n,label);
  hs_outln("Open this link on your phone (OpenAgents opens it and asks this computer to pair):");
  hs_outln(cast(string)link[0..<n]);
  cl:[64]u8;cn:=hs_cat(cl[..],0,"The phone shows the code ");cn=hs_cat(cl[..],cn,code);cn=hs_cat(cl[..],cn,". Waiting for it.");hs_outln(cast(string)cl[0..<cn]);
  tail:[16]u8;tn:=hs_cat(tail[..],0," ");tn=hs_cat(tail[..],tn,code);
  deadline:=hs_now()+wait;
  while hs_now()<deadline {
    st:[1]HsState;buf:[HS_STATE_MAX]u8;hs_load(st[..],buf[..]);now:=hs_now();
    for i:0..<st[0].np {
      p:=st[0].pairings[i];
      if !hs_waiting(p,now) || !es_pair_ends(hs_label(st[0].pairings[..],i),cast(string)tail[0..<tn]) {continue;}
      gb:[64]u8;g:=hs_allow(st[..],i,hs_random_hex(32,gb[..]),now);
      if g<0 || !hs_save(st[..],buf[..]) {tool_errln("coder host pair: could not save the grant");return 1;}
      device:=cast(string)st[0].grants[g].device[..];grant:=cast(string)st[0].grants[g].grant[..];
      c:[1]EaConfiguration;c[0].enabled=true;k:=ea_copy(c[0].device[..],device);k=ea_copy(c[0].grant[..],grant);
      c[0].nh=ea_copy(c[0].history[..],root);c[0].nw=ea_copy(c[0].workspace[..],root);c[0].nl=ea_copy(c[0].label[..],label);
      out:[8192]u8;w:=ea_config_write(c[..],out[..]);path:[1400]u8;
      if w<1 || !hs_dir() || !fs_replace_durable(es_device_file(grant,path[..]),cast(string)out[0..<w]) {tool_errln("coder host pair: could not save the enrollment");return 1;}
      ok:[400]u8;on:=hs_cat(ok[..],0,"Paired ");on=hs_cat(ok[..],on,hs_label(st[0].pairings[..],i));on=hs_cat(ok[..],on," for 7 days in ");on=hs_cat(ok[..],on,root);
      on=hs_cat(ok[..],on,". Revoke it with: coder host forget ");on=hs_cat(ok[..],on,cast(string)grant[0..<8]);hs_outln(cast(string)ok[0..<on]);
      return 0;
    }
    _ = cxproc_sleep_ms(1000);
  }
  tool_errln("coder host pair: no phone asked with that code; run it again");return 3;
}
