// Worker runs the unified daemon owns for Coder Desktop (GitHub #13694): the
// daemon (`coder host serve`) starts each Microcoder or Claude Code worker,
// carries its lines and keeps them on disk, so a run goes on after Coder quits
// and Coder attaches to it again when it opens.
//
// A run lives in ~/.openagents/coder/host/runs/ (mode 700) as files named by
// its 32-hex id:
//   ID.spec   what to start: {"program","cwd","env":["K=V"],"unset":["K"][,"skip":N]}; Coder
//             writes it (mode 600) and the daemon removes it once the worker runs
//   ID.in     lines for the worker; Coder appends, the daemon forwards to stdin
//   ID.out    the worker's mcworker-wire lines, each with its newline, as written
//   ID.state  {"state","pid","started","ended","exit"}: running, stopping,
//             exited, stopped or lost (the daemon that owned it went away)
// The lines are the worker's own (coax/lib/agent/engine/mcworker-wire.coax):
// the daemon never reads or changes them. The control methods (StartRun,
// StopRun, ListRuns, ForgetRun) are daemon-wire.coax's, on the local socket only.
//
// Coder answers each gated command's ask with yes at once (README, "Coder does not
// ask you"). While no Coder is attached (ID.attached, which Coder touches every
// second, is older than DR_DETACHED_MS) the daemon gives that same yes, so a run
// goes on after Coder quits. Coder's own answer to an ask the daemon already
// answered carries a stale ticket, which the worker ignores (mc_run_answer_owned).
#load "../../coax/lib/agent/engine/mcworker-wire.coax";

DR_MAX :: 12;                  // workers running at once: Coder says so when a start is refused
DR_CHUNK :: 65536;
DR_KEEP_S :: 7 * 24 * 3600;    // a finished run's files are removed after a week
DR_STOP_GRACE_MS :: 2000;      // a stopped run's worker gets this long after its stdin closes
DR_DETACHED_MS :: 3000;        // no Coder has touched ID.attached for this long: the daemon answers asks
DR_IDLE_MS :: 10000;           // a detached worker idle this long gives its slot to a new run at the limit
DR_RECLAIM_GRACE_MS :: 1000;   // a reclaimed worker gets this long after its stdin closes

DrRun :: struct {
  used: bool;
  id: [32] u8;
  handle: int = -1;
  pid: int; started: int;
  in_off: int; pending: bool;   // pending: bytes still buffered for a worker that was not reading
  stopping: bool; stop_at: int;
  ask: int;                     // the ticket of the worker's ask that waits for its yes, 0 for none
  idle: bool; idle_at: int;     // its last line said its turn ended and its queue is empty, at idle_at (ms)
  reclaimed: bool;              // its slot went to a new run: it ends as exited, not stopped
}
DrHost :: struct { runs: [DR_MAX] DrRun; ready: bool; }

dr_file :: (id: string, ext: string, out: [] u8) -> string {
  nb: [64] u8; n := hs_cat(nb[..], 0, "runs/"); n = hs_cat(nb[..], n, id); n = hs_cat(nb[..], n, ext);
  return es_path(cast(string) nb[0..<n], out);
}
dr_dir :: () -> bool {
  p: [1400] u8; d := es_path("runs", p[..]);
  if d.count == 0 { return false; }
  if !fs_exists(d) { ok := fs_mkdir_private(d); }
  return fs_exists(d);
}

// A worker program Coder may start: an absolute path ending in /inky, /mcworker, /claudeworker or /agyworker.
dr_program_ok :: (p: string) -> bool {
  if p.count < 2 || p[0] != '/' { return false; }
  for c: p { if c == 0 { return false; } }
  return hs_ends(p, "/inky") || hs_ends(p, "/mcworker") || hs_ends(p, "/claudeworker") || hs_ends(p, "/agyworker");
}
hs_ends :: (s: string, tail: string) -> bool { return s.count >= tail.count && cast(string) s[s.count - tail.count..<s.count] == tail; }

dr_state_write :: (id: string, state: string, pid: int, started: int, ended: int, exit: int) {
  b: [512] u8; o: [1] Jo; jo_start(o[..], b[..]); jo_obj(o[..]);
  jo_key(o[..], "state"); jo_str(o[..], state);
  jo_key(o[..], "pid"); jo_int(o[..], pid);
  jo_key(o[..], "started"); jo_int(o[..], started);
  jo_key(o[..], "ended"); jo_int(o[..], ended);
  jo_key(o[..], "exit"); jo_int(o[..], exit);
  jo_end(o[..]);
  if o[0].bad { return; }
  p: [1400] u8; _ = fs_replace_durable(dr_file(id, ".state", p[..]), cast(string) b[0..<o[0].n]);
}

// A run's state as kept on disk; false when it has none.
dr_state_read :: (id: string, r: [] DmRun) -> bool {
  r[0] = DmRun.{};
  p: [1400] u8; b: [512] u8; n := fs_read(dr_file(id, ".state", p[..]), b[..]);
  if n < 1 { return false; }
  j: [1] Jv; nodes: [32] JvNode;
  if !jv_parse(j[..], cast(string) b[0..<n], nodes[..]) || jv_kind(j[0], 0) != JV_OBJECT { return false; }
  r[0].ni = ea_copy(r[0].id[..], id);
  r[0].ns = jv_str(j[0], jv_get(j[0], 0, "state"), r[0].state[..]); if r[0].ns < 1 { return false; }
  r[0].pid = jv_int(j[0], jv_get(j[0], 0, "pid"), 0);
  r[0].started = jv_int(j[0], jv_get(j[0], 0, "started"), 0);
  r[0].ended = jv_int(j[0], jv_get(j[0], 0, "ended"), 0);
  r[0].exit = jv_int(j[0], jv_get(j[0], 0, "exit"), 0);
  op: [1400] u8; sz := fs_size(dr_file(id, ".out", op[..])); r[0].out = ifx sz > 0 then sz else 0;
  return true;
}

dr_find :: (d: [] DrHost, id: string) -> int {
  for i: 0..<DR_MAX { if d[0].runs[i].used && cast(string) d[0].runs[i].id[..] == id { return i; } }
  return -1;
}
dr_count :: (d: [] DrHost) -> int { n := 0; for i: 0..<DR_MAX { if d[0].runs[i].used { n += 1; } } return n; }

// The first time the daemon ticks: a run left "running" or "stopping" by a daemon
// that went away is lost (its worker ended with that daemon's pipes), and finished
// runs older than DR_KEEP_S lose their files.
dr_recover :: (d: [] DrHost) {
  d[0].ready = true;
  if !dr_dir() { return; }
  l: [1] FsList; p: [1400] u8; dir := es_path("runs", p[..]);
  n := fs_list(dir, l[..]); now := hs_now();
  for i: 0..<n {
    name := fs_entry(l[..], i);
    if name.count != 38 || !hs_ends(name, ".state") { continue; }
    id := cast(string) name[0..<32];
    if !ea_id(id, 32) { continue; }
    r: [1] DmRun;
    if !dr_state_read(id, r[..]) { continue; }
    st := cast(string) r[0].state[0..<r[0].ns];
    if st == "running" || st == "stopping" { dr_state_write(id, "lost", r[0].pid, r[0].started, now, -1); continue; }
    if r[0].ended > 0 && now - r[0].ended > DR_KEEP_S { dr_forget_files(id); }
  }
}
dr_forget_files :: (id: string) {
  exts := [6] string.[".spec", ".in", ".out", ".state", ".err", ".attached"];
  for e: exts { p: [1400] u8; f := dr_file(id, e, p[..]); if fs_exists(f) { _ = fs_remove(f); } }
}

dr_push :: (h: int, field: int, s: string) -> bool {
  for c: s { if c == 0 || cxproc_push(h, field, cast(int) c) != 0 { return false; } }
  return cxproc_end(h, field) == 0;
}

// StartRun: the worker ID.spec names starts, owned by this daemon. "" or why not.
dr_start :: (d: [] DrHost, id: string) -> string {
  if !d[0].ready { dr_recover(d); }
  if !ea_id(id, 32) { return "invalid-run"; }
  if dr_find(d, id) >= 0 { return ""; }
  if dr_count(d) >= DR_MAX && !dr_reclaim(d) { return "run-limit"; }
  sp: [1400] u8; spec := dr_file(id, ".spec", sp[..]);
  raw: [32768] u8; n := fs_read(spec, raw[..]);
  if n < 1 { return "missing-spec"; }
  defer { for i: 0..<raw.count { raw[i] = 0; } }
  j: [1] Jv; nodes: [256] JvNode;
  if !jv_parse(j[..], cast(string) raw[0..<n], nodes[..]) || jv_kind(j[0], 0) != JV_OBJECT { _ = fs_remove(spec); return "invalid-spec"; }
  pb: [1024] u8; pn := jv_str(j[0], jv_get(j[0], 0, "program"), pb[..]);
  if pn < 1 || !dr_program_ok(cast(string) pb[0..<pn]) || !fs_exists(cast(string) pb[0..<pn]) { _ = fs_remove(spec); return "invalid-program"; }
  h := cxproc_new();
  if h < 0 { _ = fs_remove(spec); return "run-limit"; }
  ok := dr_push(h, 0, cast(string) pb[0..<pn]);
  env := jv_get(j[0], 0, "env");
  if env >= 0 && jv_kind(j[0], env) == JV_ARRAY {
    for k: 0..<jv_len(j[0], env) { e: [8192] u8; en := jv_str(j[0], jv_at(j[0], env, k), e[..]); ok = ok && en > 2 && dr_push(h, 1, cast(string) e[0..<en]); for x: 0..<e.count { e[x] = 0; } }
  }
  un := jv_get(j[0], 0, "unset");
  if un >= 0 && jv_kind(j[0], un) == JV_ARRAY {
    for k: 0..<jv_len(j[0], un) { e: [256] u8; en := jv_str(j[0], jv_at(j[0], un, k), e[..]); ok = ok && en > 0 && dr_push(h, 2, cast(string) e[0..<en]); }
  }
  // skip: bytes of ID.in an earlier worker of the run already had (a phone's chat started again, host-phone.coax)
  sk := jv_get(j[0], 0, "skip"); skip := ifx sk >= 0 then jv_int(j[0], sk, -1) else 0;
  ip0: [1400] u8; have := fs_size(dr_file(id, ".in", ip0[..]));
  if skip < 0 || (skip > 0 && skip > have) { _ = fs_remove(spec); r := cxproc_release(h); return "invalid-spec"; }
  cb: [1024] u8; cn := jv_str(j[0], jv_get(j[0], 0, "cwd"), cb[..]);
  if cn > 0 && fs_kind(cast(string) cb[0..<cn]) == FS_DIR { ok = ok && dr_push(h, 3, cast(string) cb[0..<cn]); }
  _ = fs_remove(spec);   // it may hold a key; the worker has what it needs once it runs
  if !ok { r := cxproc_release(h); return "invalid-spec"; }
  if cxproc_spawn(h) != 0 { r := cxproc_release(h); return "spawn-failed"; }
  k := -1; for i: 0..<DR_MAX { if !d[0].runs[i].used { k = i; break; } }
  r := d[0].runs[k..<k + 1];
  r[0] = DrRun.{};
  r[0].used = true; _ = hs_set(r[0].id[..], id); r[0].handle = h; r[0].pid = cxproc_pid(h); r[0].started = hs_now(); r[0].in_off = skip;
  // lines Coder wrote before the start are forwarded; the log starts empty
  op: [1400] u8; out := dr_file(id, ".out", op[..]); if !fs_exists(out) { _ = fs_write(out, ""); }
  ip: [1400] u8; inp := dr_file(id, ".in", ip[..]); if !fs_exists(inp) { _ = fs_write(inp, ""); }
  dr_state_write(id, "running", r[0].pid, r[0].started, 0, 0);
  return "";
}

// StopRun: the worker's stdin closes (a worker ends on that and stops what it started),
// and its process group is killed if it is still there DR_STOP_GRACE_MS later.
dr_stop :: (d: [] DrHost, id: string) -> string {
  k := dr_find(d, id);
  if k < 0 { return ""; }
  r := d[0].runs[k..<k + 1];
  if r[0].stopping { return ""; }
  dr_forward(r);
  _ = cxproc_close_stdin(r[0].handle);
  r[0].stopping = true; r[0].stop_at = cxsock_now_ms() + DR_STOP_GRACE_MS;
  dr_state_write(id, "stopping", r[0].pid, r[0].started, 0, 0);
  return "";
}

// ForgetRun: a run that no longer runs loses its files.
dr_forget :: (d: [] DrHost, id: string) -> string {
  if dr_find(d, id) >= 0 { return "running"; }
  dr_forget_files(id);
  return "";
}

// ListRuns: every run with a state file, the running ones first, up to DM_RUNS_MAX.
dr_list :: (d: [] DrHost, v: [] DmView) {
  if !d[0].ready { dr_recover(d); }
  v[0].nruns = 0;
  for i: 0..<DR_MAX {
    if !d[0].runs[i].used || v[0].nruns >= DM_RUNS_MAX { continue; }
    r: [1] DmRun; if dr_state_read(cast(string) d[0].runs[i].id[..], r[..]) { v[0].runs[v[0].nruns] = r[0]; v[0].nruns += 1; }
  }
  l: [1] FsList; p: [1400] u8; n := fs_list(es_path("runs", p[..]), l[..]);
  for i: 0..<n {
    if v[0].nruns >= DM_RUNS_MAX { break; }
    name := fs_entry(l[..], i);
    if name.count != 38 || !hs_ends(name, ".state") { continue; }
    id := cast(string) name[0..<32];
    if !ea_id(id, 32) || dr_find(d, id) >= 0 { continue; }
    r: [1] DmRun; if dr_state_read(id, r[..]) { v[0].runs[v[0].nruns] = r[0]; v[0].nruns += 1; }
  }
}

// What Coder appended to ID.in since the last tick goes to the worker's stdin.
dr_forward :: (r: [] DrRun) {
  if r[0].stopping { return; }
  if r[0].pending {
    f := cxproc_flush_timeout(r[0].handle, 10);
    r[0].pending = f == CXPROC_TIMEOUT_V;
    if r[0].pending { return; }
  }
  ip: [1400] u8; inp := dr_file(cast(string) r[0].id[..], ".in", ip[..]);
  size := fs_size(inp);
  if size <= r[0].in_off { return; }
  b: [DR_CHUNK] u8;
  for pass: 0..<8 {
    if r[0].in_off >= size { break; }
    n := fs_read_at(inp, r[0].in_off, b[..]);
    if n < 1 { break; }
    for i: 0..<n { _ = cxproc_write(r[0].handle, cast(int) b[i]); }
    r[0].in_off += n;
    dr_mark(r, false);
    // a worker busy with a step may not read for a while: the daemon never waits on it
    f := cxproc_flush_timeout(r[0].handle, 10);
    if f == CXPROC_TIMEOUT_V { r[0].pending = true; break; }
    if f != 0 { break; }
  }
}

// The worker's lines since the last tick join ID.out; at its end the run's state is kept.
dr_drain :: (r: [] DrRun) -> bool {
  op: [1400] u8; out := dr_file(cast(string) r[0].id[..], ".out", op[..]);
  b: [DR_CHUNK] u8;
  for lines: 0..<256 {
    n := cxproc_read_line(r[0].handle, 0);
    if n == CXPROC_TIMEOUT_V { return false; }
    if n == CXPROC_TOO_LONG_V { continue; }
    if n < 0 { return true; }
    if n < b.count {
      for i: 0..<n { b[i] = cast(u8) cxproc_line_byte(r[0].handle, i); }
      r[0].ask = dr_ask_ticket(cast(string) b[0..<n]);
      dr_mark(r, dr_idle_line(cast(string) b[0..<n]));
      b[n] = 10;
      _ = fs_append(out, cast(string) b[0..<n + 1]);
      continue;
    }
    r[0].ask = 0;
    dr_mark(r, false);
    at := 0;
    for i: 0..<n {
      b[at] = cast(u8) cxproc_line_byte(r[0].handle, i); at += 1;
      if at == b.count { _ = fs_append(out, cast(string) b[0..<at]); at = 0; }
    }
    b[at] = 10; at += 1;
    _ = fs_append(out, cast(string) b[0..<at]);
  }
  return false;
}
// A worker line's ask ticket (mcworker-wire's {"kind":"ask",...,"ticket":N}), 0 for any other line.
dr_ask_ticket :: (line: string) -> int {
  if !hs_prefix(line, "{\"kind\":\"ask\"") { return 0; }
  ab: [DR_CHUNK] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  l: [1] MwwLine;
  if mww_read(ar[..], line, l[..]) != MWW_ASK || !l[0].ticket.ok || l[0].ticket.value <= 0 { return 0; }
  return l[0].ticket.value;
}
// No Coder has touched the run's .attached file in DR_DETACHED_MS.
dr_detached :: (id: string) -> bool {
  p: [1400] u8; mt := fs_mtime_ns(dr_file(id, ".attached", p[..]));
  return mt < 0 || cxproc_wall_us() * 1000 - mt > DR_DETACHED_MS * 1000000;
}
// The yes Coder would give, for the ask the worker waits on while no Coder is attached.
dr_answer :: (r: [] DrRun) {
  if r[0].ask <= 0 || r[0].stopping || r[0].pending || !dr_detached(cast(string) r[0].id[..]) { return; }
  b: [128] u8; n := mww_answer(b[..], true, r[0].ask, "");
  r[0].ask = 0;
  if n < 1 { return; }
  for i: 0..<n { _ = cxproc_write(r[0].handle, cast(int) b[i]); }
  f := cxproc_flush_timeout(r[0].handle, 10);
  r[0].pending = f == CXPROC_TIMEOUT_V;
}
// A worker's line saying it has nothing to do: its queue line with no active item and no items,
// or its turn's ended line (agyworker writes no queue line after it).
dr_idle_line :: (line: string) -> bool {
  if !hs_prefix(line, "{\"kind\":\"queue\"") && !hs_prefix(line, "{\"kind\":\"ended\"") { return false; }
  ab: [DR_CHUNK] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  l: [1] MwwLine;
  k := mww_read(ar[..], line, l[..]);
  if k == MWW_ENDED { return true; }
  if k != MWW_QUEUED { return false; }
  return l[0].active.count == 0 && (l[0].items.count == 0 || l[0].items == "[]");
}
dr_mark :: (r: [] DrRun, idle: bool) {
  if idle && !r[0].idle { r[0].idle_at = cxsock_now_ms(); }
  r[0].idle = idle;
}
// A run whose slot a new run may take: idle for DR_IDLE_MS, nothing waiting on it, no Coder attached.
dr_reclaimable :: (r: DrRun, detached: bool, now: int) -> bool {
  return r.used && r.idle && !r.stopping && !r.pending && r.ask == 0 && detached && now - r.idle_at >= DR_IDLE_MS;
}
// At the limit, the run idle longest that no Coder watches ends so a new one can start
// (workers wait on stdin for a follow-up, so a chat Coder let go of would hold its slot for ever).
dr_reclaim :: (d: [] DrHost) -> bool {
  now := cxsock_now_ms();
  k := -1;
  for i: 0..<DR_MAX {
    r := d[0].runs[i];
    if !r.used || !r.idle { continue; }
    if !dr_reclaimable(r, dr_detached(cast(string) r.id[..]), now) { continue; }
    if k < 0 || r.idle_at < d[0].runs[k].idle_at { k = i; }
  }
  if k < 0 { return false; }
  r := d[0].runs[k..<k + 1];
  _ = cxproc_close_stdin(r[0].handle);
  r[0].stopping = true; r[0].reclaimed = true;
  _ = cxproc_wait(r[0].handle, DR_RECLAIM_GRACE_MS);
  r[0].stop_at = 0;
  dr_finish(r);
  return dr_count(d) < DR_MAX;
}
CXPROC_TIMEOUT_V :: -2;
CXPROC_TOO_LONG_V :: -4;

dr_finish :: (r: [] DrRun) {
  id := cast(string) r[0].id[..];
  status := cxproc_wait(r[0].handle, 0);
  if status == CXPROC_TIMEOUT_V {
    if !r[0].stopping { return; }
    if cxsock_now_ms() < r[0].stop_at { return; }
    _ = cxproc_kill(r[0].handle, 9);
    status = cxproc_wait(r[0].handle, 2000);
  }
  for k: 0..<64 { if dr_drain(r) { break; } }
  // the newest stderr the worker wrote, for when a run ends early
  nerr := cxproc_stderr_count(r[0].handle);
  if nerr > 0 {
    eb: [8192] u8; m := ifx nerr > eb.count then eb.count else nerr;
    for i: 0..<m { eb[i] = cast(u8) cxproc_stderr_byte(r[0].handle, nerr - m + i); }
    ep: [1400] u8; _ = fs_write(dr_file(id, ".err", ep[..]), cast(string) eb[0..<m]);
  }
  dr_state_write(id, ifx r[0].stopping && !r[0].reclaimed then "stopped" else "exited", r[0].pid, r[0].started, hs_now(), status);
  _ = cxproc_release(r[0].handle);
  r[0] = DrRun.{};
}

// One pass for every run: forward input, keep output, end the ones that ended.
dr_tick :: (h: [] HsHost) {
  d := h[0].runs[..];
  if !d[0].ready { dr_recover(d); }
  for i: 0..<DR_MAX {
    r := d[0].runs[i..<i + 1];
    if !r[0].used { continue; }
    dr_forward(r);
    ended := dr_drain(r);
    dr_answer(r);
    if ended || r[0].stopping { dr_finish(r); }
  }
}
dr_active :: (h: [] HsHost) -> int { return dr_count(h[0].runs[..]); }

// The run methods of the local control plane.
dr_execute :: (h: [] HsHost, q: [] DmRequest, v: [] DmView) {
  d := h[0].runs[..];
  method := cast(string) q[0].method[0..<q[0].nm];
  id := cast(string) q[0].run[0..<q[0].nr];
  why := "";
  if method == "StartRun" { why = dr_start(d, id); }
  else if method == "StopRun" { why = dr_stop(d, id); }
  else if method == "ForgetRun" { why = dr_forget(d, id); }
  else if method != "ListRuns" { why = "unknown-method"; }
  if why.count > 0 { dm_fail(v, why); return; }
  if method == "ListRuns" { dr_list(d, v); v[0].nst = ea_copy(v[0].status[..], "ready"); return; }
  r: [1] DmRun;
  if dr_state_read(id, r[..]) { v[0].runs[0] = r[0]; v[0].nruns = 1; }
  v[0].nst = ea_copy(v[0].status[..], ifx method == "StartRun" then "started" else ifx method == "StopRun" then "stopping" else "forgotten");
}

#test "only the bundled workers may be started" {
  #assert dr_program_ok("/Applications/OpenAgents.app/Contents/Resources/inky");
  #assert dr_program_ok("/Applications/Coder.app/Contents/Resources/mcworker");
  #assert dr_program_ok("/tmp/build/Coder.app/Contents/Resources/claudeworker");
  #assert dr_program_ok("/tmp/build/Coder.app/Contents/Resources/agyworker");
  #assert !dr_program_ok("inky") && !dr_program_ok("/tmp/inky.sh");
  #assert !dr_program_ok("mcworker") && !dr_program_ok("/bin/sh") && !dr_program_ok("/tmp/mcworker.sh") && !dr_program_ok("");
}

#test "only an ask line carries a ticket the daemon may answer" {
  #assert dr_ask_ticket("{\"kind\":\"ask\",\"command\":\"ls\",\"ticket\":7}") == 7;
  #assert dr_ask_ticket("{\"kind\":\"reply\",\"text\":\"{\\\"kind\\\":\\\"ask\\\"\"}") == 0;
  #assert dr_ask_ticket("{\"kind\":\"command\",\"command\":\"ls\",\"exit\":0,\"timed_out\":false,\"output\":\"\"}") == 0;
  #assert dr_ask_ticket("{\"kind\":\"ask\",\"command\":\"ls\"}") == 0;
}

#test "only an empty queue line says a worker is idle" {
  #assert dr_idle_line("{\"kind\":\"queue\",\"paused\":false,\"reason\":\"\",\"active\":\"\",\"items\":[]}");
  #assert dr_idle_line("{\"kind\":\"queue\",\"paused\":true,\"reason\":\"interrupted\",\"active\":\"\",\"items\":[]}");
  #assert !dr_idle_line("{\"kind\":\"queue\",\"paused\":false,\"reason\":\"\",\"active\":\"q-1\",\"items\":[]}");
  #assert !dr_idle_line("{\"kind\":\"queue\",\"paused\":false,\"reason\":\"\",\"active\":\"\",\"items\":[{\"id\":\"q\",\"text\":\"t\"}]}");
  #assert dr_idle_line("{\"kind\":\"ended\",\"ending\":\"finished\",\"text\":\"\"}");
  #assert !dr_idle_line("{\"kind\":\"reply\",\"text\":\"{\\\"kind\\\":\\\"queue\\\"\"}");
}

#test "only an idle run no Coder watches gives up its slot" {
  r := DrRun.{used = true, idle = true, idle_at = 1000};
  now := 1000 + DR_IDLE_MS;
  #assert dr_reclaimable(r, true, now);
  #assert !dr_reclaimable(r, false, now);
  #assert !dr_reclaimable(r, true, now - 1);
  b := r; b.idle = false; #assert !dr_reclaimable(b, true, now);
  b = r; b.ask = 3; #assert !dr_reclaimable(b, true, now);
  b = r; b.pending = true; #assert !dr_reclaimable(b, true, now);
  b = r; b.stopping = true; #assert !dr_reclaimable(b, true, now);
  b = r; b.used = false; #assert !dr_reclaimable(b, true, now);
}
