// Real Git in a disposable, explicitly supplied test root; never an owner's repository.
ws_test_write :: (h:[]HsHost,root:string,q:[]WsRequest,v:[]WsView,method:string,command:string) {q[0].nm=js_copy(q[0].method[..],method);q[0].command[0]=0;q[0].nc=js_copy(q[0].command[..],command);q[0].expected=v[0].revision;q[0].nx=v[0].nx;q[0].issued=cxproc_wall_us()/1000;q[0].expires=q[0].issued+120000;v[0]=WsView.{};ws_execute(h,root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q,v);}
ws_selftest :: (root:string)->int {
 #assert root.count>0 && !fs_exists(root) && fs_mkdir_private(root);h:[1]HsHost;_=js_copy(h[0].xhex[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");buf:[65536]u8;
 args:=[11]string.["git","-C",root,"-c","init.defaultBranch=main","-c","core.hooksPath=/dev/null","init","--quiet",".",""];err:[1024]u8;r:=proc_run(args[0..<10],10000,buf[..],err[..]);#assert wt_ok(r);
 commit:=[15]string.["git","-C",root,"-c","user.name=Fixture","-c","user.email=fixture@example.com","-c","commit.gpgsign=false","-c","core.hooksPath=/dev/null","commit","--allow-empty","-m","Fixture"];r=proc_run(commit[..],10000,buf[..],err[..]);#assert wt_ok(r);
 #assert wt_ok(wt_git4(root,"remote","add","origin","https://github.com/example/repo.git",buf[..]));
 folder:[1400]u8;hb:[1024]u8;home:=hs_home(hb[..]);#assert fs_mkdir_private(fs_join(home,".openagents",folder[..]));#assert fs_mkdir_private(fs_join(home,".openagents/coder",folder[..]));#assert fs_mkdir_private(hs_path("",folder[..]));q:[1]WsRequest;v:[1]WsView;q[0].page=3;q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");q[0].nw=js_copy(q[0].workspace[..],"default");ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);#assert v[0].ne==0 && v[0].nt==0 && v[0].nbra==0 && v[0].np==1 && cast(string)v[0].branch[0..<v[0].nb]=="main";
 q[0].nb=js_copy(q[0].branch[..],"feature/native");q[0].na=js_copy(q[0].base[..],"main");ws_test_write(h[..],root,q[..],v[..],"CreateBranch","00000000000000000000000000000001");#assert v[0].ne==0 && cast(string)v[0].branch[0..<v[0].nb]=="feature/native";
 // Retry uses exactly the old bytes and returns its receipt, not a second switch.
 v[0]=WsView.{};ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);#assert v[0].ne==0 && cast(string)v[0].branch[0..<v[0].nb]=="feature/native";
 q[0].title[0]='x';q[0].nt=1;v[0]=WsView.{};ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);#assert cast(string)v[0].error[0..<v[0].ne]=="idempotency_conflict";q[0].nt=0;
 q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");q[0].nc=0;q[0].nx=0;q[0].issued=0;q[0].expires=0;q[0].nb=0;q[0].na=0;ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);#assert v[0].ne==0;
 file:[1400]u8;#assert fs_write(fs_join(root,"dirty.txt",file[..]),"preserve me");q[0].nb=js_copy(q[0].branch[..],"main");ws_test_write(h[..],root,q[..],v[..],"SwitchBranch","00000000000000000000000000000002");#assert cast(string)v[0].error[0..<v[0].ne]=="stale_state";
 // Read the dirty state first: a branch switch then refuses without stashing.
 q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");q[0].nc=0;q[0].nx=0;q[0].issued=0;q[0].expires=0;q[0].nb=0;v[0]=WsView.{};ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);q[0].nb=js_copy(q[0].branch[..],"main");ws_test_write(h[..],root,q[..],v[..],"SwitchBranch","00000000000000000000000000000003");#assert cast(string)v[0].error[0..<v[0].ne]=="dirty_worktree" && fs_exists(fs_join(root,"dirty.txt",file[..]));#assert fs_remove(fs_join(root,"dirty.txt",file[..]));
 // Create an isolated worktree even while the adopted worktree is in use.
 q[0].page=2;q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");q[0].nc=0;q[0].nx=0;q[0].issued=0;q[0].expires=0;q[0].nb=0;v[0]=WsView.{};ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);q[0].nb=js_copy(q[0].branch[..],"feature/tree");q[0].na=js_copy(q[0].base[..],"main");ws_test_write(h[..],root,q[..],v[..],"CreateWorktree","00000000000000000000000000000004");#assert v[0].ne==0 && v[0].nt==2;
 // PR title/body are passed as literal argv, including shell-looking text.
 q[0].page=3;
 q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");q[0].nc=0;q[0].nx=0;q[0].issued=0;q[0].expires=0;q[0].nb=0;q[0].na=0;v[0]=WsView.{};ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);
 q[0].na=js_copy(q[0].base[..],"main");q[0].nb=0;q[0].nt=js_copy(q[0].title[..],"Native 'controls' $(no shell)");q[0].nd=js_copy(q[0].body[..],"First line\nSecond `literal` line");ws_test_write(h[..],root,q[..],v[..],"CreatePullRequest","00000000000000000000000000000005");#assert v[0].ne==0;
 q[0].number=12;ws_test_write(h[..],root,q[..],v[..],"EditPullRequest","00000000000000000000000000000006");#assert v[0].ne==0;
 hs_outln("workspace selftest: discovery, branch writes, exact replay, conflict, dirty/stale refusal, worktree creation and native PR create/edit passed");return 0;
}
ws_selftest_more :: (root:string)->int {
 #assert root.count>30 && fs_exists(root);h:[1]HsHost;_=js_copy(h[0].xhex[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");q:[1]WsRequest;v:[1]WsView;buf:[65536]u8;q[0].nw=js_copy(q[0].workspace[..],"default");q[0].page=2;q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);#assert v[0].ne==0 && v[0].nt==2;
 h[0].environment[0].slots[0].occupied=true;h[0].environment[0].slots[0].s[0].live=true;h[0].environment[0].slots[0].engine[0].cwd_n=js_copy(h[0].environment[0].slots[0].engine[0].cwd[..],root);q[0].nb=js_copy(q[0].branch[..],"main");ws_test_write(h[..],root,q[..],v[..],"SwitchBranch","00000000000000000000000000000011");#assert cast(string)v[0].error[0..<v[0].ne]=="workspace_busy";h[0].environment[0].slots[0].occupied=false;
 q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");q[0].nc=0;q[0].nx=0;q[0].issued=0;q[0].expires=0;q[0].nb=0;ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);ws_test_write(h[..],root,q[..],v[..],"RemoveWorktree","00000000000000000000000000000012");#assert cast(string)v[0].error[0..<v[0].ne]=="workspace_refused" && fs_exists(root);
 q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");q[0].nc=0;q[0].nx=0;q[0].issued=0;q[0].expires=0;ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);found:=false;for i:0..<v[0].nt {path:=cast(string)v[0].trees[i].path[0..<v[0].trees[i].np];if ws_owned(path) {q[0].workspace=v[0].trees[i].id;q[0].nw=64;found=true;break;}}#assert found;ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);#assert v[0].ne==0;ws_test_write(h[..],root,q[..],v[..],"RemoveWorktree","00000000000000000000000000000013");#assert v[0].ne==0 && v[0].nt==1;
 // Git's push reaches a private local bare fixture through an exact URL rewrite.
 homebuf:[1024]u8;home:=hs_home(homebuf[..]);barebuf:[1400]u8;bare:=fs_join(home,"remote.git",barebuf[..]);#assert wt_ok(wt_git4(root,"init","--bare","--quiet",bare,buf[..]));key:[1600]u8;n:=hs_cat(key[..],0,"url.");n=hs_cat(key[..],n,bare);n=hs_cat(key[..],n,".insteadOf");#assert wt_ok(wt_git3(root,"config",cast(string)key[0..<n],"https://github.com/example/repo.git",buf[..]));q[0]=WsRequest.{};q[0].nw=js_copy(q[0].workspace[..],"default");q[0].nm=js_copy(q[0].method[..],"ReadWorkspace");ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);#assert v[0].ne==0;ws_test_write(h[..],root,q[..],v[..],"PushBranch","00000000000000000000000000000014");#assert v[0].ne==0 && wt_ok(wt_git3(bare,"show-ref","--verify","refs/heads/feature/native",buf[..]));
 // An interrupted durable claim is never executed a second time.
 q[0]=WsRequest.{};q[0].nm=js_copy(q[0].method[..],"SwitchBranch");q[0].nw=js_copy(q[0].workspace[..],"default");q[0].nb=js_copy(q[0].branch[..],"main");q[0].expected=v[0].revision;q[0].nx=64;q[0].nc=js_copy(q[0].command[..],"00000000000000000000000000000015");q[0].issued=cxproc_wall_us()/1000;q[0].expires=q[0].issued+120000;raw:[24576]u8;size:=ws_write(q[..],raw[..]);file:[1400]u8;#assert size>0 && fs_replace_durable(ws_receipt("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",cast(string)q[0].command[..],".request",file[..]),cast(string)raw[0..<size]);ws_execute(h[..],root,"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",q[..],v[..]);#assert cast(string)v[0].error[0..<v[0].ne]=="unknown";branch:=wt_git3(root,"symbolic-ref","--short","HEAD",buf[..]);#assert wt_ok(branch) && cast(string)buf[0..<branch.out_n]=="feature/native";
 hs_outln("workspace selftest: busy/root refusals, clean removal, real local push and interrupted-command recovery passed");return 0;
}
