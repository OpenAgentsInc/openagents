// Inky Self-Improvement CLI (docs/coder/inky-self-improvement.md §4–§7).
//
// Subcommands:
//   audit        --runs DIR                    Telemetry scorecard (KV hit, edit vs shell, Class-E receipts)
//   reanchor     --runs DIR                    Offline zero-LLM-call K-fold grouped-CV policy optimizer
//   mine-skills  --runs DIR --out DIR          Dev-only failure-cluster SKILL.md miner (Ch 247 quarantine)
//   distill      --runs DIR --out DIR [--opt-in]  Opt-in ATIF-v1.8 shard exporter (default-OFF per Ch 247)
//   train-router --shards DIR --out PATH       Ch 140 Rank-8 LoRA routing adapter trainer & tamper proof
//   selftest                                   End-to-end 6-stage + adversarial refusal self-test
//
// Build/Run:
//   coax/web/tool.sh coder/tui/inky-improve.coax selftest
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/inky/improve.coax";

ik_cli_usage :: () {
  print("usage: inky-improve <subcommand> [flags]\n");
  print("  audit        --runs DIR\n");
  print("  reanchor     --runs DIR\n");
  print("  mine-skills  --runs DIR --out DIR\n");
  print("  distill      --runs DIR --out DIR [--opt-in]\n");
  print("  train-router [--shards DIR] [--out PATH]\n");
  print("  selftest\n");
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 1 {
    ik_cli_usage();
    return 2;
  }
  cmd := args_at(a[..], 0);
  w: [1] IkImpWork;
  rep: [16384] u8;

  if cmd == "selftest" {
    ok := ik_imp_selftest(w[..], rep[..]);
    // Find length by scanning for '\n' or stopping at end
    rn := 0;
    while rn < rep.count && rep[rn] != 0 { rn += 1; }
    print("%", cast(string) rep[0..<rn]);
    return ifx ok then 0 else 1;
  }

  runs_dir := args_value(a[..], "--runs", "");
  out_path := args_value(a[..], "--out", "");
  shards_dir := args_value(a[..], "--shards", "");
  opt_in := args_has(a[..], "--opt-in");

  if cmd == "audit" {
    if runs_dir.count == 0 { ik_cli_usage(); return 2; }
    loaded := ik_imp_load_runs(w[..], runs_dir);
    if loaded <= 0 { print("inky-improve audit: no summary.json cases found under %\n", runs_dir); return 1; }
    rn := ik_imp_format_audit(w[..], rep[..]);
    print("%", cast(string) rep[0..<rn]);
    return 0;
  }

  if cmd == "reanchor" {
    if runs_dir.count == 0 { ik_cli_usage(); return 2; }
    loaded := ik_imp_load_runs(w[..], runs_dir);
    if loaded <= 0 { print("inky-improve reanchor: no summary.json cases found under %\n", runs_dir); return 1; }
    bp: [1] IkPolicy;
    rn := ik_imp_run_reanchor(w[..], rep[..], bp[..]);
    print("%", cast(string) rep[0..<rn]);
    return 0;
  }

  if cmd == "mine-skills" {
    if runs_dir.count == 0 || out_path.count == 0 { ik_cli_usage(); return 2; }
    loaded := ik_imp_load_runs(w[..], runs_dir);
    if loaded <= 0 { print("inky-improve mine-skills: no summary.json cases found under %\n", runs_dir); return 1; }
    rn := ik_imp_mine_skills(w[..], out_path, rep[..]);
    print("%", cast(string) rep[0..<rn]);
    return 0;
  }

  if cmd == "distill" {
    if runs_dir.count == 0 || out_path.count == 0 { ik_cli_usage(); return 2; }
    loaded := ik_imp_load_runs(w[..], runs_dir);
    if loaded <= 0 { print("inky-improve distill: no summary.json cases found under %\n", runs_dir); return 1; }
    rn := ik_imp_distill(w[..], out_path, opt_in, rep[..]);
    print("%", cast(string) rep[0..<rn]);
    return 0;
  }

  if cmd == "train-router" {
    rn := ik_imp_train_router(w[..], shards_dir, out_path, rep[..]);
    print("%", cast(string) rep[0..<rn]);
    return 0;
  }

  ik_cli_usage();
  return 2;
}
