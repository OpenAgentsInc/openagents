// Inky worker process for OpenAgents Desktop and evals (docs/coder/inky-spec.md §4.3).
// Speaks the exact mcworker-wire.coax JSON-line protocol on stdin/stdout so it is a
// zero-churn drop-in replacement for coder/tui/mcworker.coax on local Inkling 2.0
// (Psionic Metal 4 / CUDA) sessions.
//
// Build: coax/web/tool.sh coder/tui/inky.coax

#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/inky/run.coax";
#load "../../coax/lib/agent/engine/mcworker-wire.coax";
#load "../../coax/lib/agent/engine/mcworker-queue.coax";

cxproc_wall_us :: () -> int #foreign #effects(all);
cxterm_byte :: (timeout_ms: int) -> int #foreign #effects(all);
cxterm_write :: (s: [] u8) -> int #foreign #effects(all);

IKW_LINE :: 1048576;
IKW_SRC_MESSAGE :: 0;
IKW_SRC_QUEUE :: 1;
IKW_SRC_RESUBMIT :: 2;

ikw_send :: (o: [] u8, n: int) {
  if n < 0 || n >= o.count { return; }
  o[n] = 10;
  _ = cxterm_write(o[0..<n + 1]);
}

ikw_keep :: (dst: [] u8, s: string) -> int {
  n := ifx s.count < dst.count then s.count else dst.count;
  while n > 0 && n < s.count && (s[n] & 0xC0) == 0x80 { n -= 1; }
  for i: 0..<n { dst[i] = s[i]; }
  return n;
}

ikw_env_int :: (name: string, fallback: int) -> int {
  b: [32] u8;
  s := gw_env(name, b[..]);
  if s.count == 0 { return fallback; }
  v := 0;
  for c: s {
    if c < '0' || c > '9' { return fallback; }
    v = v * 10 + cast(int) (c - '0');
  }
  return v;
}

ikw_event :: (e: IkRunEvent, o: [] u8) {
  n := 0;
  if e.kind == IK_EV_REPLY { n = mww_reply(o, e.text); }
  else if e.kind == IK_EV_THOUGHT { n = mww_thought(o, e.text); }
  else if e.kind == IK_EV_ATTEMPT {
    u := e.usage;
    values := [7] int.[
      ifx (u.observed & 1) != 0 then u.input_tokens else -1,
      ifx (u.observed & 2) != 0 then u.output_tokens else -1,
      ifx (u.observed & 4) != 0 then u.cached_tokens else -1,
      ifx (u.observed & 8) != 0 then u.reasoning_tokens else -1,
      ifx (u.observed & 16) != 0 then u.cache_write_tokens else -1,
      u.cost_usd_micros, u.card_usd_micros];
    n = mww_attempt(o, e.gateway, e.model, e.effort, e.outcome, e.status, values[..]);
    ikw_send(o, n);
    if e.outcome == "done" {
      ttft := ifx e.ttft_ms > 0 then e.ttft_ms else ifx e.ttft_ms == 0 then 1 else -1;
      if ttft > 0 || (e.output_tokens > 0 && e.decode_ms > 0) {
        ikw_send(o, mww_stats(o, ttft, e.decode_ms, e.output_tokens));
      }
    }
    return;
  }
  else if e.kind == IK_EV_COMMAND {
    ikw_send(o, mww_command(o, e.text, e.exit, e.timed_out, e.output));
    n = mww_device_of(o, e.text, e.exit, e.output);
    if n <= 0 { return; }
  }
  else if e.kind == IK_EV_VIEW { n = mww_view(o, e.text, e.found); }
  else if e.kind == IK_EV_TODOS { n = mww_todos(o, e.text); }
  else if e.kind == IK_EV_ASK { n = mww_ask(o, e.text, e.ticket); }
  else if e.kind == IK_EV_ENDED { n = mww_ended(o, ik_ending_name(e.ending), e.text); }
  else { return; }
  ikw_send(o, n);
}

ikw_ended :: (o: [] u8, ending: string, text: string) {
  ikw_send(o, mww_ended(o, ending, text));
}

// Non-blocking drain (0 ms) when the last poll emitted streaming tokens, 10 ms when waiting for
// the next token during an active turn, 200 ms when idle.
ikw_poll_wait_ms :: (running: bool, polled: bool) -> int {
  if !running { return 200; }
  return ifx polled then 0 else 10;
}

// ---------------------------------------------------------------- local endpoint resolution

IkEndpoint :: struct {
  ok: bool;
  base: [512] u8; nbase: int;
  model: [128] u8; nmodel: int;
  why: [512] u8; nwhy: int;
}

ikw_resolve_local :: (ep: [] IkEndpoint, req_model: string) -> bool {
  ep[0] = IkEndpoint.{};
  rb: [1024] u8;
  replaying := gw_env("GW_REPLAY", rb[..]).count > 0;

  base := "";
  peer_model := "";
  pb: [1024] u8;
  peers_raw := gw_env("PSIONIC_PEERS", pb[..]);
  if peers_raw.count > 0 {
    peers: [8] GwPsionicPeer;
    np := gw_psionic_parse_peers(peers_raw, peers[..]);
    if np > 0 {
      seed := proc_now_ms();
      if seed < 0 { seed = -seed; }
      start := seed % np;
      for off: 0..<np {
        idx := (start + off) % np;
        if replaying || ik_lhttp_up(peers[idx].base) {
          ep[0].nbase = ikw_keep(ep[0].base[..], peers[idx].base);
          base = cast(string) ep[0].base[0..<ep[0].nbase];
          if peers[idx].model.count > 0 { peer_model = peers[idx].model; }
          break;
        }
      }
      if base.count == 0 {
        n := ik_fmt_put(ep[0].why[..], 0, "No PSIONIC_PEERS server answered /v1/models (");
        n = ik_fmt_put(ep[0].why[..], n, peers_raw);
        ep[0].nwhy = ik_fmt_put(ep[0].why[..], n, ").");
        return false;
      }
    }
  }
  if base.count == 0 {
    ub: [512] u8;
    b := gw_psionic_base(ub[..]);
    ep[0].nbase = ikw_keep(ep[0].base[..], b);
    base = cast(string) ep[0].base[0..<ep[0].nbase];
    if !replaying && !ik_lhttp_up(base) {
      n := ik_fmt_put(ep[0].why[..], 0, "No local model server answers at ");
      n = ik_fmt_put(ep[0].why[..], n, base);
      ep[0].nwhy = ik_fmt_put(ep[0].why[..], n, "/v1/models. Start psionic-inkling-serve or set PSIONIC_BASE_URL.");
      return false;
    }
  }
  mb: [128] u8;
  env_model := gw_env("PSIONIC_MODEL", mb[..]);
  picked := ifx req_model.count > 0 then req_model else ifx peer_model.count > 0 then peer_model else ifx env_model.count > 0 then env_model else "inkling-2-mini";
  ep[0].nmodel = ikw_keep(ep[0].model[..], picked);
  ep[0].ok = true;
  return true;
}

// ---------------------------------------------------------------- follow-ups & queue

IkFollow :: struct {
  turn: int;
  steerable: bool;
  starting: bool;
  src: int;
  src_id: [MWQ_ID] u8; nsrc_id: int;
  src_text: [MWQ_TEXT] u8; nsrc_text: int;
  last: [MWQ_MESSAGE] u8; nlast: int;
  resubmit: [MWQ_MESSAGE] u8; nresubmit: int;
  resubmit_due: bool;
  force_head: bool;
  qbuf: [MWQ_FILE] u8;
  qarena: [MWQ_MESSAGE + MWQ_TEXT] u8;
}

ikw_src_name :: (src: int) -> string {
  if src == IKW_SRC_QUEUE { return "queue"; }
  if src == IKW_SRC_RESUBMIT { return "resubmit"; }
  return "message";
}

ikw_queue_changed :: (q: [] MwQueue, f: [] IkFollow, o: [] u8) {
  _ = mwq_save(q, f[0].qbuf[..]);
  ikw_send(o, mwq_line(q, o));
}

ikw_task_with :: (f: [] IkFollow, text: string, out: [] u8) -> string {
  if f[0].nlast == 0 { return ""; }
  ab: [MWQ_MESSAGE] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  t: [1] McTask;
  last := cast(string) f[0].last[0..<f[0].nlast];
  if !mww_task_read(ar[..], last, t[..]) {
    t[0] = McTask.{cwd = cl_str(ar[..], last, "cwd"), session = cl_str(ar[..], last, "session"), sandbox = "danger-full-access", local = true};
  }
  t[0].task = text;
  n := mww_task(out, t[0]);
  return ifx n < 2 then "" else cast(string) out[0..<n - 1];
}

ikw_turn_begin :: (f: [] IkFollow, msg: string, o: [] u8) {
  f[0].turn += 1;
  ikw_send(o, mww_turn(o, f[0].turn, ikw_src_name(f[0].src), cast(string) f[0].src_id[0..<f[0].nsrc_id], cast(string) f[0].src_text[0..<f[0].nsrc_text]));
  f[0].nlast = ifx msg.count <= f[0].last.count then ikw_keep(f[0].last[..], msg) else 0;
  st := cl_bool(msg, "steerable");
  f[0].steerable = !st.ok || st.value;
  f[0].starting = true;
  f[0].src = IKW_SRC_MESSAGE; f[0].nsrc_id = 0; f[0].nsrc_text = 0;
}

ikw_drained :: (st: [] McSteers, f: [] IkFollow, o: [] u8) {
  for i: 0..<st[0].nd {
    ikw_send(o, mww_steered(o, mc_steer_done_id(st, i), "applied", f[0].turn, "", st[0].done[i].step, ""));
  }
  st[0].nd = 0;
}

ikw_turn_end :: (ending: string, st: [] McSteers, q: [] MwQueue, f: [] IkFollow, o: [] u8) {
  f[0].starting = false;
  mwq_ended(q);
  if st[0].n > 0 && f[0].resubmit_due {
    jb: [MWQ_MESSAGE] u8; text := mc_steer_join(st, jb[..]);
    m := ikw_task_with(f, text, f[0].resubmit[..]);
    f[0].nresubmit = m.count;
    if m.count > 0 {
      f[0].nsrc_id = ikw_keep(f[0].src_id[..], mc_steer_id(st, 0));
      f[0].nsrc_text = ikw_keep(f[0].src_text[..], text);
      for i: 0..<st[0].n { ikw_send(o, mww_steered(o, mc_steer_id(st, i), "resubmitted", f[0].turn, "", 0, "")); }
      mc_steer_clear(st);
    }
  }
  i := st[0].n - 1;
  while i >= 0 {
    mb: [MWQ_MESSAGE] u8; m := ikw_task_with(f, mc_steer_text(st, i), mb[..]);
    why := ifx m.count > 0 then mwq_add_first(q, mc_steer_id(st, i), mc_steer_text(st, i), m) else "invalid";
    ikw_send(o, mww_steered(o, mc_steer_id(st, i), ifx why.count == 0 then "queued" else "rejected", f[0].turn, why, 0, ""));
    i -= 1;
  }
  mc_steer_clear(st);
  f[0].resubmit_due = false;
  if ending == "stopped" && f[0].nresubmit == 0 && !f[0].force_head { mwq_pause(q, "interrupted"); }
  else if ending == "failed" || ending == "no_capacity" { mwq_pause(q, "error"); }
  ikw_queue_changed(q, f, o);
}

ikw_dispatch :: (q: [] MwQueue, f: [] IkFollow, line: [] u8, o: [] u8) -> int {
  if f[0].nresubmit > 0 {
    n := ikw_keep(line, cast(string) f[0].resubmit[0..<f[0].nresubmit]);
    f[0].nresubmit = 0; f[0].src = IKW_SRC_RESUBMIT;
    return n;
  }
  if q[0].n == 0 || (q[0].paused && !f[0].force_head) { return 0; }
  n := ikw_keep(line, mwq_message(q, 0));
  f[0].src = IKW_SRC_QUEUE;
  f[0].nsrc_id = ikw_keep(f[0].src_id[..], mwq_id(q, 0));
  f[0].nsrc_text = ikw_keep(f[0].src_text[..], mwq_text(q, 0));
  f[0].force_head = false;
  _ = mwq_start_head(q);
  ikw_queue_changed(q, f, o);
  return n;
}

ikw_steer :: (running: bool, req: [] MwwRequest, st: [] McSteers, f: [] IkFollow, o: [] u8) {
  why := "";
  if !running || f[0].starting { why = "no_active_turn"; }
  else if req[0].turn.ok && req[0].turn.value != f[0].turn { why = "expected_turn_mismatch"; }
  else if !f[0].steerable && !req[0].parent { why = "active_turn_not_steerable"; }
  else { why = mc_steer_add(st, req[0].id, req[0].text); }
  ikw_send(o, mww_steered(o, req[0].id, ifx why.count == 0 then "accepted" else "rejected", f[0].turn, why, 0, ifx why.count == 0 then req[0].text else ""));
}

ikw_queue_op :: (running: bool, req: [] MwwRequest, q: [] MwQueue, f: [] IkFollow, home: string, o: [] u8) -> bool {
  op := req[0].op; id := req[0].id; why := "";
  stop := false;
  if op == "open" {
    pb: [4096] u8; path := mwq_path(home, req[0].key, pb[..]);
    if path.count == 0 { why = "invalid"; }
    else if cast(string) q[0].path[0..<q[0].npath] != path {
      _ = mwq_save(q, f[0].qbuf[..]);
      if q[0].npath == 0 && q[0].n > 0 { q[0].npath = ikw_keep(q[0].path[..], path); }
      else { _ = mwq_load(q, path, f[0].qbuf[..], f[0].qarena[..]); }
    }
  }
  else if op == "add" { why = mwq_add(q, id, req[0].text, req[0].message); }
  else if op == "update" { why = mwq_update(q, id, req[0].text, req[0].message); }
  else if op == "delete" { why = mwq_delete(q, id); }
  else if op == "move" { why = mwq_move(q, id, ifx req[0].to.ok then req[0].to.value else 0); }
  else if op == "promote" {
    why = mwq_move(q, id, 0);
    if why.count == 0 && req[0].now { f[0].force_head = true; stop = running; }
  }
  else if op == "pause" { mwq_pause(q, "user"); }
  else if op == "resume" { mwq_resume(q); }
  else if op == "clear" { mwq_clear(q); }
  else if op != "list" { why = "invalid"; }
  if why.count > 0 { ikw_send(o, mww_queue_refused(o, op, id, why)); return false; }
  ikw_queue_changed(q, f, o);
  return stop;
}

ikw_auth_asked :: () -> bool {
  a: [1] Args;
  if !args_load(a[..]) { return false; }
  for i: 0..<args_count(a[..]) { if args_at(a[..], i) == "--auth" { return true; } }
  return false;
}

tool_main :: () -> int #export_c #effects(all) {
  if ikw_auth_asked() {
    o: [64] u8;
    n := json_raw(o[..], 0, "{\"source\":\"local\",\"ready\":true}");
    ikw_send(o[..], n);
    return 0;
  }

  run: [1] IkRun;
  bufs: [1] IkRunBufs;
  hist: [1] IkHistory;
  ik_hist_init(hist[..]);
  ep: [1] IkEndpoint;

  line: [IKW_LINE] u8; nl := 0;
  out: [IKW_LINE] u8;
  ab: [65536] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  task_buf: [32768] u8; cwd_buf: [4096] u8; prof_buf: [64] u8;
  journal: [1] JfWriter; defer jf_close(journal[..]);

  jp: [4096] u8; homebuf: [4096] u8;
  home := cl_getenv("CODER_HOME", homebuf[..]);
  if home.count == 0 { home = cl_getenv("HOME", homebuf[..]); }
  path: [4096] u8;
  pn := json_raw(path[..], 0, home); pn = json_raw(path[..], pn, "/.openagents/coder/sessions");
  if home.count == 0 || pn < 0 || !fs_mkdir(cast(string) path[0..<pn]) { return 1; }
  jn := json_raw(jp[..], 0, cast(string) path[0..<pn]);
  jn = json_raw(jp[..], jn, "/worker-");
  jn = json_write_int(jp[..], jn, cxproc_wall_us());
  jn = json_raw(jp[..], jn, ".ajr");
  if jn < 0 { return 1; }

  // Sibling .out directory for >16 KB command output spills.
  // Journal file is opened lazily on the first real turn (right before jf_context)
  // so build/EOF/rejected worker invocations never leak 0-byte worker-*.ajr files.
  sn := json_raw(run[0].spill_dir[..], 0, cast(string) jp[0..<jn - 4]);
  sn = json_raw(run[0].spill_dir[..], sn, ".out");
  run[0].nspill_dir = ifx sn > 0 then sn else 0;
  run[0].journal = journal[..];

  running := false;
  req: [1] MwwRequest;
  st: [1] McSteers; q: [1] MwQueue; f: [1] IkFollow;
  run[0].steers = st[..];

  ikw_send(out[..], mww_ready(out[..]));

  os_name := ifx tool_os() == TOOL_LINUX then "Linux" else "macOS";
  max_ctx := ikw_env_int("INKY_CTX", IK_DEFAULT_CTX);
  env_steps := ikw_env_int("INKY_MAX_STEPS", 0);
  det_b: [16] u8;
  det_mode := gw_env("INKY_DETERMINISTIC", det_b[..]) == "1";
  exec_b: [16] u8;
  env_hybrid := gw_env("INKY_EXECUTOR", exec_b[..]) == "1";
  ae_b: [16] u8;
  // Adaptive mid-session effort shifts change Inkling's system-position effort token and bust
  // the multi-turn KV prefix cache, so keep it opt-in (INKY_ADAPTIVE_EFFORT=1).
  env_adaptive := gw_env("INKY_ADAPTIVE_EFFORT", ae_b[..]) == "1";
  env_max_tok := ikw_env_int("INKY_MAX_TOKENS", 0);
  env_max_think := ikw_env_int("INKY_MAX_THINK_TOKENS", 0);
  eff_env_b: [32] u8;
  env_effort := gw_env("INKY_EFFORT", eff_env_b[..]);
  rse_b: [16] u8;
  env_refuse_shell_edit := gw_env("INKY_REFUSE_SHELL_EDIT", rse_b[..]) == "1";
  nev_b: [16] u8;
  env_exit_verify := gw_env("INKY_NO_EXIT_VERIFY", nev_b[..]) != "1";
  at_b: [16] u8;
  env_adaptive_think := gw_env("INKY_ADAPTIVE_THINK", at_b[..]) == "1";
  ns_b: [16] u8;
  env_no_seed := gw_env("INKY_NO_SEED", ns_b[..]) == "1";
  nac_b: [16] u8;
  env_no_auto_check := gw_env("INKY_NO_AUTO_CHECK", nac_b[..]) == "1";
  acc_b: [512] u8;
  env_auto_check_cmd := gw_env("INKY_AUTO_CHECK_CMD", acc_b[..]);

  while true {
    ended := "";
    polled := false;
    if running {
      ev: [32] IkRunEvent;
      n := ik_run_poll(run[..], hist[..], bufs[..], ev[..]);
      polled = n > 0;
      for i: 0..<n {
        if ev[i].kind == IK_EV_ENDED {
          running = false;
          ended = ik_ending_name(ev[i].ending);
        }
        ikw_event(ev[i], out[..]);
      }
      ikw_drained(st[..], f[..], out[..]);
    }
    if !running && f[0].starting && ended.count == 0 { ended = "failed"; }
    if ended.count > 0 { ikw_turn_end(ended, st[..], q[..], f[..], out[..]); }

    fed := false;
    if !running && nl == 0 { nl = ikw_dispatch(q[..], f[..], line[..], out[..]); fed = nl > 0; }
    if !fed {
      ch := cxterm_byte(ikw_poll_wait_ms(running, polled));
      if ch == -2 { break; }
      got_line := false;
      while ch >= 0 {
        if ch == 10 { got_line = true; break; }
        if nl < line.count { line[nl] = cast,trunc(u8) ch; nl += 1; }
        ch = cxterm_byte(0);
      }
      if ch == -2 && !got_line { break; }
      if !got_line { continue; }
    }
    msg := cast(string) line[0..<nl];
    nl = 0;
    ar[0].at = 0; ar[0].full = false;
    what := mww_request(ar[..], msg, req[..]);

    if what == MWW_STEER { ikw_steer(running, req[..], st[..], f[..], out[..]); continue; }
    if what == MWW_QUEUE {
      if !ikw_queue_op(running, req[..], q[..], f[..], home, out[..]) { continue; }
      what = MWW_STOP;
    }
    if what == MWW_INTERRUPT {
      if !running { continue; }
      f[0].resubmit_due = req[0].resubmit;
      what = MWW_STOP;
    }
    if what == MWW_STOP {
      if running {
        ev: [8] IkRunEvent;
        n := ik_run_stop(run[..], ev[..]);
        ending := "stopped";
        for i: 0..<n {
          ikw_event(ev[i], out[..]);
          if ev[i].kind == IK_EV_ENDED { ending = ik_ending_name(ev[i].ending); }
        }
        running = false;
        ikw_turn_end(ending, st[..], q[..], f[..], out[..]);
      }
      continue;
    }
    if what == MWW_FORGET {
      if !running { ik_hist_clear(hist[..]); }
      continue;
    }
    if what == MWW_RECALL {
      if !running {
        // Hydrate persisted turns as real alternating user/assistant messages up to 50% of max_ctx (~48 KB at 32K).
        _ = ik_hist_recall(hist[..], req[0].recall, (max_ctx * 3) / 2);
      }
      continue;
    }
    if what == MWW_EMBED {
      ikw_send(out[..], mww_embedding_error(out[..], "embeddings are not served by the local worker"));
      continue;
    }
    if what == MWW_ANSWER {
      if running {
        ev: [16] IkRunEvent;
        ticket := req[0].ticket;
        n := ik_run_answer(run[..], hist[..], bufs[..], ifx ticket.ok then ticket.value else 0, req[0].allow, req[0].why, ev[..]);
        e := "";
        for i: 0..<n {
          if ev[i].kind == IK_EV_ENDED { running = false; e = ik_ending_name(ev[i].ending); }
          ikw_event(ev[i], out[..]);
        }
        ikw_drained(st[..], f[..], out[..]);
        if e.count > 0 { ikw_turn_end(e, st[..], q[..], f[..], out[..]); }
      }
      continue;
    }
    if what != MWW_TASK || running { continue; }

    mw_task := req[0].task;
    mw_cwd := req[0].cwd;
    ikw_turn_begin(f[..], msg, out[..]);
    if mw_task.count > task_buf.count || mw_cwd.count == 0 || mw_cwd.count > cwd_buf.count {
      ikw_ended(out[..], "failed", "task or workspace exceeds worker bounds");
      ikw_turn_end("failed", st[..], q[..], f[..], out[..]);
      continue;
    }
    tn := ikw_keep(task_buf[..], mw_task);
    cn := ikw_keep(cwd_buf[..], mw_cwd);
    tk := cast(string) task_buf[0..<tn];
    cd := cast(string) cwd_buf[0..<cn];

    req_model := ifx req[0].model.count > 0 then req[0].model else cl_str(ar[..], msg, "model");
    if !ikw_resolve_local(ep[..], req_model) {
      ikw_ended(out[..], "no_capacity", cast(string) ep[0].why[0..<ep[0].nwhy]);
      ikw_turn_end("no_capacity", st[..], q[..], f[..], out[..]);
      continue;
    }
    profile := ifx req[0].sandbox.count > 0 then req[0].sandbox else "danger-full-access";
    if profile != "danger-full-access" && profile != "read-only" && profile != "workspace-write" {
      ikw_ended(out[..], "failed", "unknown sandbox profile");
      ikw_turn_end("failed", st[..], q[..], f[..], out[..]);
      continue;
    }
    np := ikw_keep(prof_buf[..], profile);
    ceiling := 3;
    if req[0].policy_on {
      c := req[0].ceiling;
      if !c.ok || c.value < 0 || c.value > 3 {
        ikw_ended(out[..], "failed", "invalid frozen effect ceiling");
        ikw_turn_end("failed", st[..], q[..], f[..], out[..]);
        continue;
      }
      ceiling = c.value;
    }
    effort := ifx env_effort.count > 0 then env_effort else req[0].effort;
    eff_num := effort.count >= 1 && effort.count <= 4 && effort[0] >= '0' && effort[0] <= '9';
    if !eff_num && effort != "none" && effort != "minimal" && effort != "low" && effort != "medium" && effort != "high" && effort != "xhigh" && effort != "max" {
      effort = "medium";
    }
    ms_field := cl_int(msg, "max_steps");
    turn_steps := ifx ms_field.ok && ms_field.value > 0 then ms_field.value else env_steps;

    ev: [8] IkRunEvent;
    run[0].hybrid_exec = env_hybrid;
    run[0].adaptive_effort = env_adaptive;
    run[0].adaptive_think = env_adaptive_think;
    run[0].no_seed = env_no_seed;
    run[0].no_auto_check = env_no_auto_check;
    run[0].nauto_check = ikw_keep(run[0].auto_check_cmd[..], env_auto_check_cmd);
    run[0].max_tokens_step = env_max_tok;
    run[0].max_thinking_tokens = env_max_think;
    run[0].refuse_shell_edit = env_refuse_shell_edit;
    run[0].require_exit_verify = env_exit_verify;
    ne := ik_run_start(
      run[..], hist[..], bufs[..], cd,
      cast(string) ep[0].base[0..<ep[0].nbase],
      cast(string) ep[0].model[0..<ep[0].nmodel],
      effort, cast(string) prof_buf[0..<np], ceiling,
      req[0].gated, req[0].edits, turn_steps, max_ctx, det_mode, os_name, tk, ev[..],
    );
    if ne > 0 {
      for i: 0..<ne { ikw_event(ev[i], out[..]); }
      ikw_turn_end("failed", st[..], q[..], f[..], out[..]);
      continue;
    }

    // Lazy journal open on the first real turn (prevents 0-byte .ajr files on EOF/build/reject).
    if !journal[0].opened {
      if !jf_open(journal[..], cast(string) jp[0..<jn]) {
        ikw_ended(out[..], "failed", "durable journal failed to open; no request or tool started");
        ikw_turn_end("failed", st[..], q[..], f[..], out[..]);
        continue;
      }
      ikw_send(out[..], mww_journal(out[..], cast(string) jp[0..<jn]));
    }

    // Durable context frame before the first model call or tool effect.
    ctx_buf: [32768] u8;
    nc := json_raw(ctx_buf[..], 0, "{\"profile\":\"inky-native-v1\",\"cwd\":");
    nc = json_write_string(ctx_buf[..], nc, cd);
    nc = json_raw(ctx_buf[..], nc, ",\"session\":");
    nc = json_write_string(ctx_buf[..], nc, req[0].session);
    nc = json_raw(ctx_buf[..], nc, ",\"sandbox\":");
    nc = json_write_string(ctx_buf[..], nc, cast(string) prof_buf[0..<np]);
    nc = json_raw(ctx_buf[..], nc, ",\"system\":");
    nc = json_write_string(ctx_buf[..], nc, ik_loop_system(run[0].l[..]));
    nc = json_raw(ctx_buf[..], nc, ifx req[0].gated then ",\"gated\":true}" else ",\"gated\":false}");
    if nc < 0 || !jf_context(journal[..], cast(string) ctx_buf[0..<nc]) {
      ikw_ended(out[..], "failed", "durable context failed; no request or tool started");
      ikw_turn_end("failed", st[..], q[..], f[..], out[..]);
      continue;
    }

    mc_steer_clear(st[..]); st[0].nd = 0;
    running = true;
    f[0].starting = false;
  }

  if running {
    ev: [8] IkRunEvent;
    _ = ik_run_stop(run[..], ev[..]);
  }
  return 0;
}

#test "inky worker: poll wait drains streaming tokens with 0 ms delay" {
  #assert ikw_poll_wait_ms(false, false) == 200;
  #assert ikw_poll_wait_ms(false, true) == 200;
  #assert ikw_poll_wait_ms(true, false) == 10;
  #assert ikw_poll_wait_ms(true, true) == 0;
}
