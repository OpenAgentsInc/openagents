// Real owner-only Unix socket, isolated files and the ordinary resident CLI.
// No owner credentials, Keychain, browser, provider login or agent turn.
// TMPDIR=/tmp coax/web/tool.sh coder/tui/local-provider-smoke.coax
// The short temporary root fits the macOS Unix socket path limit.
#load "host-smoke-driver.coax";
#load "../../coax/lib/agent/environment/local-request.coax";
tool_main :: ()->int #export_c #effects(all) {
 s:[1]Sm;rp:[1]Rp;cwd:[1024]u8;repo:=fs_cwd(cwd[..]);s[0].nrepo=sm_cat(s[0].repo[..],0,repo);
 s[0].ncoder=sm_cat(s[0].coder[..],0,repo);s[0].ncoder=sm_cat(s[0].coder[..],s[0].ncoder,"/coder/tui/coder.sh");
 t:[1024]u8;tmp:=fs_temp("oa-local-provider.",t[..]);if tmp.count==0 {return 2;}s[0].ntmp=sm_cat(s[0].tmp[..],0,tmp);s[0].nhome=sm_cat(s[0].home[..],0,tmp);
 defer {cleanup:=[3]string.["rm","-rf",tmp];sm_exec(s[..],rp[..],cleanup[..],10000);}
 sm_env(s[..],0,"CODER_HOME",tmp);sm_env(s[..],1,"HOME",tmp);sm_env(s[..],2,"CODER_USAGE_KEYCHAIN","0");sm_env(s[..],3,"ANTHROPIC_API_KEY","");sm_env(s[..],4,"OPENAGENTS_NIP_HOST_RELAY","ws://localhost:1");sm_env(s[..],5,"NO_OPEN_BROWSER","1");
 key:=[1]string.["key"];sm_host(s[..],rp[..],key[..]);if rp[0].status!=0 {tool_errln("local-provider: isolated CLI did not build/start");return 1;}
 p:[1400]u8;file:=sm_in_tmp(s[..],".openagents/coder/host/environment.json",p[..]);e:[1]EaConfiguration;e[0].enabled=true;_=pa_copy(e[0].device[..],"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");_=pa_copy(e[0].grant[..],"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb");e[0].nw=pa_copy(e[0].workspace[..],tmp);e[0].nh=pa_copy(e[0].history[..],tmp);e[0].nl=pa_copy(e[0].label[..],"Fixture");bytes:[8192]u8;n:=ea_config_write(e[..],bytes[..]);if n<1 || !fs_write(file,cast(string)bytes[0..<n]) {return 1;}
 av:=[7]string.[sm_str(s[0].coder[..],s[0].ncoder),"host","serve","--engine","echo","--for","30"];resident:=sm_spawn(s[..],av[..],false);if resident<0 {return 1;}defer {sm_stop(resident);}
 line:[4096]u8;started:=false;deadline:=proc_now_ms()+120000;
 while !started && proc_now_ms()<deadline {got:=proc_line(resident,deadline-proc_now_ms(),line[..]);if got<0 {break;}started=sm_has(cast(string)line[0..<got],"Coder host ");}
 if !started {err:[8192]u8;tool_errln("local-provider: isolated listener did not start");tool_errln(proc_stderr(resident,err[..]));return 1;}
 q:[1]PaRequest;q[0].nm=pa_copy(q[0].method[..],"ListAccounts");n=pa_request_write(q[..],bytes[..]);rpath:[1400]u8;request:=sm_in_tmp(s[..],"request.json",rpath[..]);if n<1 || !fs_write(request,cast(string)bytes[0..<n]) {return 1;}
 call:=[3]string.["local-rpc","--request-file",request];sm_host(s[..],rp[..],call[..]);v:[1]PaView;
 sm_check(s[..],rp[0].status==0 && pa_view_read(sm_text(rp[..]),v[..]) && cast(string)v[0].error[0..<v[0].ne]=="forbidden","the actual local socket refuses provider access before explicit enablement");
 store:[1]PaStore;store[0].device=e[0].device;store[0].grant=e[0].grant;store[0].enabled=true;store[0].n=1;store[0].ns=pa_copy(store[0].selected[..],"system");store[0].profiles[0].ni=pa_copy(store[0].profiles[0].id[..],"system");n=pa_store_write(store[..],bytes[..]);storepath:[1400]u8;provider:=sm_in_tmp(s[..],".openagents/coder/host/provider-accounts.json",storepath[..]);if n<1 || !fs_write(provider,cast(string)bytes[0..<n]) {return 1;}
 q[0].nm=pa_copy(q[0].method[..],"SelectAccount");q[0].na=pa_copy(q[0].account[..],"system");q[0].nc=pa_copy(q[0].command[..],"11111111111111111111111111111111");q[0].issued=cxproc_wall_us()/1000;q[0].expires=ea_deadline(q[0].issued);n=pa_request_write(q[..],bytes[..]);if n<1 || !fs_write(request,cast(string)bytes[0..<n]) {return 1;}
 sm_host(s[..],rp[..],call[..]);sm_check(s[..],rp[0].status==0 && pa_view_read(sm_text(rp[..]),v[..]) && cast(string)v[0].command[..]==cast(string)q[0].command[..] && cast(string)v[0].error[0..<v[0].ne]=="login_required","the enabled local provider dispatcher returns its exact command without launching a login");
 e_req:[1]EaRequest;e_req[0].nm=ea_copy(e_req[0].method[..],"ListSessions");e_req[0].nw=ea_copy(e_req[0].workspace[..],"default");n=ea_write(e_req[..],bytes[..]);if n<1 || !fs_write(request,cast(string)bytes[0..<n]) {return 1;}
 sm_host(s[..],rp[..],call[..]);view:[1]EaView;sm_check(s[..],rp[0].status==0 && ea_view_read(sm_text(rp[..]),view[..]),"the existing local chat profile still uses the same listener");
 return ifx s[0].fails==0 then 0 else 1;
}
