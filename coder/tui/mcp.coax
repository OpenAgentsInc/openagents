// Coder's verbs as MCP tools (Coder book chapters 16 and 23), so Claude
// Code or another agent can drive Coder: `coder mcp` is an MCP server on
// stdio, one JSON-RPC message a line. It answers initialize, ping,
// tools/list and tools/call; every tool runs the matching `coder` verb as a
// child process, so the tools and the verbs can't drift apart.
//
//   claude mcp add coder -- /path/to/openagents/coder/tui/coder.sh mcp

CD_MCP_VERSIONS :: [3] string.["2025-06-18", "2025-03-26", "2024-11-05"];
CD_MCP_LINE :: 1048576;

CD_MCP_TOOLS :: [8] string.["coder_run", "coder_ls", "coder_status", "coder_log", "coder_send", "coder_stop", "coder_fork", "coder_replay"];
CD_MCP_ABOUT :: [8] string.[
  "Start a coding task in a repository as a background Coder session and return its ID at once. Follow it with coder_status and coder_log. engine is claude, codex, micro, psionic or echo; without it, System One picks.",
  "List Coder sessions, newest first, with state, engine, age and task.",
  "One Coder session's state: running, finished, stopped, failed or lost, its last step and its ending.",
  "One Coder session's log as text: messages, tool calls, results and replies.",
  "Send a message to a Coder session. A running session takes it as its next turn; an ended one continues in a new session that carries the conversation, whose ID is returned.",
  "Stop a running Coder session.",
  "Start a new background session from an existing one's conversation (its first `at` turns, or all of them) with a new task, and return the new ID.",
  "Rebuild every request a session sent its engine from its log and compare bytes; reports each turn as same or different."];
// Each tool's input schema's properties and required list.
CD_MCP_SCHEMAS :: [8] string.[
  "{\"type\":\"object\",\"properties\":{\"task\":{\"type\":\"string\"},\"engine\":{\"type\":\"string\",\"enum\":[\"claude\",\"codex\",\"micro\",\"psionic\",\"echo\"]},\"cwd\":{\"type\":\"string\",\"description\":\"the repository folder\"}},\"required\":[\"task\"]}",
  "{\"type\":\"object\",\"properties\":{}}",
  "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"description\":\"a session ID or a unique prefix\"}},\"required\":[\"id\"]}",
  "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"}},\"required\":[\"id\"]}",
  "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"required\":[\"id\",\"message\"]}",
  "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"}},\"required\":[\"id\"]}",
  "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"task\":{\"type\":\"string\"},\"at\":{\"type\":\"integer\",\"minimum\":1}},\"required\":[\"id\",\"task\"]}",
  "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"}},\"required\":[\"id\"]}"];

cd_mcp_send :: (s: string) { cd_outln(s); }

// {"jsonrpc":"2.0","id":ID,"result":RESULT}
cd_mcp_result :: (id: string, result: string, out: [] u8) {
  n := json_raw(out, 0, "{\"jsonrpc\":\"2.0\",\"id\":"); n = json_raw(out, n, id);
  n = json_raw(out, n, ",\"result\":"); n = json_raw(out, n, result); n = json_raw(out, n, "}");
  if n > 0 { cd_mcp_send(cast(string) out[0..<n]); }
}

cd_mcp_error :: (id: string, code: int, message: string, out: [] u8) {
  n := json_raw(out, 0, "{\"jsonrpc\":\"2.0\",\"id\":"); n = json_raw(out, n, ifx id.count > 0 then id else "null");
  n = json_raw(out, n, ",\"error\":{\"code\":"); n = json_write_int(out, n, code);
  n = json_raw(out, n, ",\"message\":"); n = json_write_string(out, n, message); n = json_raw(out, n, "}}");
  if n > 0 { cd_mcp_send(cast(string) out[0..<n]); }
}

cd_mcp_tools :: (out: [] u8) -> string {
  names := CD_MCP_TOOLS; about := CD_MCP_ABOUT; schemas := CD_MCP_SCHEMAS;
  n := json_raw(out, 0, "{\"tools\":[");
  for i: 0..<names.count {
    n = json_raw(out, n, ifx i > 0 then ",{\"name\":" else "{\"name\":"); n = json_write_string(out, n, names[i]);
    n = json_raw(out, n, ",\"description\":"); n = json_write_string(out, n, about[i]);
    n = json_raw(out, n, ",\"inputSchema\":"); n = json_raw(out, n, schemas[i]); n = json_raw(out, n, "}");
  }
  n = json_raw(out, n, "]}");
  return ifx n < 0 then "" else cast(string) out[0..<n];
}

// Runs coder.sh with args; its output, and ok when it exited 0.
cd_mcp_coder :: (args: [] string, out: [] u8, ok: [] bool) -> string {
  rb: [4096] u8; repo := cl_getenv("CODER_REPO", rb[..]);
  sb: [4200] u8; sn := cd_cat(sb[..], cd_cat(sb[..], 0, repo), "/coder/tui/coder.sh");
  argv: [12] string; argv[0] = cast(string) sb[0..<sn];
  for i: 0..<args.count { argv[i + 1] = args[i]; }
  env := [1] string.["BROWSER=/usr/bin/true"];
  return rt_run_in(argv[0..<args.count + 1], env[..], "", 600, out, ok);
}

// A tools/call: the verb's output as text content, isError when it failed.
cd_mcp_call :: (ar: [] ClArena, params: string, out: [] u8) -> string {
  name := cl_str(ar, params, "name");
  args := cl_raw(params, "arguments");
  if args.count == 0 { args = "{}"; }
  id := cl_str(ar, args, "id"); task := cl_str(ar, args, "task");
  a: [10] string; na := 0;
  text := ""; ok: [1] bool; ok[0] = false;
  ob: [262144] u8;
  if name == "coder_run" {
    if task.count == 0 { text = "coder_run needs a task."; }
    else {
      a[0] = "run"; a[1] = task; a[2] = "--detach"; na = 3;
      eng := cl_str(ar, args, "engine"); if eng.count > 0 { a[na] = "--engine"; a[na + 1] = eng; na += 2; }
      cwd := cl_str(ar, args, "cwd"); if cwd.count > 0 { a[na] = "--cwd"; a[na + 1] = cwd; na += 2; }
      text = cd_mcp_coder(a[0..<na], ob[..], ok[..]);
    }
  } else if name == "coder_ls" { a[0] = "ls"; text = cd_mcp_coder(a[0..<1], ob[..], ok[..]); }
  else if name == "coder_status" || name == "coder_log" || name == "coder_stop" || name == "coder_replay" {
    if id.count == 0 { text = "This tool needs an id."; }
    else {
      a[0] = ifx name == "coder_status" then "status" else ifx name == "coder_log" then "log" else ifx name == "coder_stop" then "stop" else "replay";
      a[1] = id; text = cd_mcp_coder(a[0..<2], ob[..], ok[..]);
    }
  } else if name == "coder_fork" {
    if id.count == 0 || task.count == 0 { text = "coder_fork needs an id and a task."; }
    else {
      a[0] = "fork"; a[1] = id; a[2] = task; a[3] = "--detach"; na = 4;
      at := cl_int(args, "at"); tb: [16] u8;
      if at.ok && at.value > 0 { a[4] = "--at"; a[5] = cd_itoa(at.value, tb[..]); na = 6; }
      text = cd_mcp_coder(a[0..<na], ob[..], ok[..]);
    }
  } else if name == "coder_send" {
    msg := cl_str(ar, args, "message");
    if id.count == 0 || msg.count == 0 { text = "coder_send needs an id and a message."; }
    else { text = cd_mcp_send_message(id, msg, ob[..], ok[..]); }
  } else { return ""; }
  n := json_raw(out, 0, "{\"content\":[{\"type\":\"text\",\"text\":"); n = json_write_string(out, n, ifx text.count > 0 then text else (ifx ok[0] then "Done." else "It failed."));
  n = json_raw(out, n, ifx ok[0] then "}],\"isError\":false}" else "}],\"isError\":true}");
  return ifx n < 0 then "" else cast(string) out[0..<n];
}

// A message for a session: a running job takes it as its next turn; an
// ended one continues in a detached fork.
cd_mcp_send_message :: (id_in: string, msg: string, out: [] u8, ok: [] bool) -> string {
  ok[0] = false;
  fb: [4194304] u8; ib: [128] u8;
  text := cd_session_file(id_in, fb[..], ib[..]);
  if text.count == 0 { n := cd_cat(out, 0, "No session "); n = cd_cat(out, n, id_in); return cast(string) out[0..<n]; }
  k := 0; while k < ib.count && ib[k] != 0 { k += 1; }
  id := cast(string) ib[0..<k];
  pid := cd_job_pid(id);
  if pid > 0 && cxproc_pid_alive(pid) == 1 {
    pb: [1400] u8; p := cd_msg_put(id, msg, pb[..]);
    if p.count == 0 { n := cd_cat(out, 0, "Could not leave the message."); return cast(string) out[0..<n]; }
    ok[0] = true;
    n := cd_cat(out, 0, "Sent to "); n = cd_cat(out, n, id); n = cd_cat(out, n, "; it takes the message when its current turn ends.");
    return cast(string) out[0..<n];
  }
  a := [4] string.["fork", id, msg, "--detach"];
  nb: [256] u8; nid := cd_mcp_coder(a[..], nb[..], ok);
  if !ok[0] { n := cd_cat(out, 0, "The session has ended and a new one did not start: "); n = cd_cat(out, n, nid); return cast(string) out[0..<n]; }
  n := cd_cat(out, 0, "The session had ended; the conversation continues in "); n = cd_cat(out, n, nid);
  return cast(string) out[0..<n];
}

// coder mcp: serves until stdin ends.
cd_cmd_mcp :: () -> int {
  line: [CD_MCP_LINE] u8;
  out: [524288] u8;
  for guard: 0..<1000000000 {
    n := 0; eof := false;
    while true {
      c := cxterm_byte(-1);
      if c == -2 { eof = true; break; }
      if c < 0 { continue; }
      if c == 10 { break; }
      if n < line.count { line[n] = cast,trunc(u8) c; n += 1; }
    }
    if n > 0 {
      msg := cast(string) line[0..<n];
      ab: [262144] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
      method := cl_str(ar[..], msg, "method");
      id := cl_raw(msg, "id");
      params := cl_raw(msg, "params");
      if id.count == 0 { }                                   // a notification: no answer
      else if method == "initialize" {
        want := cl_str(ar[..], params, "protocolVersion");
        versions := CD_MCP_VERSIONS; v := versions[0];
        for x: versions { if x == want { v = x; } }
        rb: [1024] u8;
        r := json_raw(rb[..], 0, "{\"protocolVersion\":"); r = json_write_string(rb[..], r, v);
        r = json_raw(rb[..], r, ",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"coder\",\"version\":"); r = json_write_string(rb[..], r, CODER_VERSION);
        r = json_raw(rb[..], r, "},\"instructions\":\"Coder runs coding tasks in repositories on this machine as background sessions. Start one with coder_run, follow it with coder_status and coder_log, and talk to it with coder_send.\"}");
        cd_mcp_result(id, cast(string) rb[0..<r], out[..]);
      }
      else if method == "ping" { cd_mcp_result(id, "{}", out[..]); }
      else if method == "tools/list" { tb: [16384] u8; cd_mcp_result(id, cd_mcp_tools(tb[..]), out[..]); }
      else if method == "tools/call" {
        cb: [524288] u8; r := cd_mcp_call(ar[..], params, cb[..]);
        if r.count == 0 { cd_mcp_error(id, -32602, "Unknown tool.", out[..]); } else { cd_mcp_result(id, r, out[..]); }
      }
      else { cd_mcp_error(id, -32601, "Method not found.", out[..]); }
    }
    if eof { return 0; }
  }
  return 0;
}

#test "the tool list names every verb with a schema" {
  tb: [16384] u8; t := cd_mcp_tools(tb[..]);
  ab: [65536] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  list := cl_raw(t, "tools");
  #assert cl_count(list) == 8;
  first := cl_json(list, cl_item(list, 0));
  #assert cl_str(ar[..], first, "name") == "coder_run" && cl_raw(cl_raw(first, "inputSchema"), "required") == "[\"task\"]";
}
