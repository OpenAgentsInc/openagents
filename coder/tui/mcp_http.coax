// `coder mcp --http PORT`: the same MCP server over the Streamable HTTP
// transport (MCP 2025-06-18), on 127.0.0.1 only (Coder book chapter 16).
// Each POST to /mcp carries one JSON-RPC message: a request is answered
// with 200 and the response as application/json, and a notification or a
// response is acknowledged with 202 and no body. The server offers no
// server-to-client stream, so GET is answered 405. A request whose Origin
// header names anything but this machine is refused with 403, against DNS
// rebinding. One connection at a time, closed after each answer.
#load "../../coax/lib/net/socket_foreign.coax";

CD_SOCK_TIMEOUT :: -2;
CD_HTTP_MAX :: 262144;      // a request's head and body together

// Where the head ends (just past the blank line), or -1 while it has not.
cd_http_end :: (b: string) -> int {
  for i: 3..<b.count { if b[i] == 10 && b[i - 1] == 13 && b[i - 2] == 10 && b[i - 3] == 13 { return i + 1; } }
  return -1;
}

cd_http_lower :: (c: u8) -> u8 { return ifx c >= 'A' && c <= 'Z' then c + 32 else c; }

// The value of header name (lower case) in head, trimmed; "" when it is absent.
cd_http_header :: (head: string, name: string) -> string {
  at := 0;
  while at < head.count {
    e := at; while e < head.count && head[e] != 10 { e += 1; }
    ln := cast(string) head[at..<e];
    if ln.count > name.count && ln[name.count] == ':' {
      same := true;
      for i: 0..<name.count { if cd_http_lower(ln[i]) != name[i] { same = false; break; } }
      if same {
        f := name.count + 1; t := ln.count;
        while f < t && (ln[f] == ' ' || ln[f] == 9) { f += 1; }
        while t > f && (ln[t - 1] == 13 || ln[t - 1] == ' ' || ln[t - 1] == 9) { t -= 1; }
        return cast(string) ln[f..<t];
      }
    }
    at = e + 1;
  }
  return "";
}

// Word k (0 the method, 1 the target) of the request line.
cd_http_word :: (head: string, k: int) -> string {
  at := 0;
  for w: 0..<k + 1 {
    e := at; while e < head.count && head[e] != ' ' && head[e] != 13 && head[e] != 10 { e += 1; }
    if w == k { return cast(string) head[at..<e]; }
    if e >= head.count || head[e] != ' ' { return ""; }
    at = e + 1;
  }
  return "";
}

// Whether an Origin header is absent or names this machine.
cd_http_origin_ok :: (o: string) -> bool {
  if o.count == 0 { return true; }
  hosts := [6] string.["http://localhost", "https://localhost", "http://127.0.0.1", "https://127.0.0.1", "http://[::1]", "https://[::1]"];
  for h: hosts {
    if o == h { return true; }
    if o.count > h.count && cast(string) o[0..<h.count] == h && o[h.count] == ':' {
      for i: h.count + 1..<o.count { if o[i] < '0' || o[i] > '9' { return false; } }
      return o.count > h.count + 1;
    }
  }
  return false;
}

// What to answer a request: its status, for 200 the body, and the session
// it started. Pure, for the tests: the caller passes a fresh session ID.
CdHttpReply :: struct { status: int; body: string; session: string; }

// Sessions (Mcp-Session-Id): an initialize starts one, with a random ID in
// the response header. Every later request names it; a request without one
// is 400, an ID this server doesn't hold is 404 (the client then initializes
// again), and DELETE ends it. The 32 newest are held.
CD_HTTP_SESSIONS :: 32;
CdHttpSessions :: struct { id: [CD_HTTP_SESSIONS] [32] u8; nid: [CD_HTTP_SESSIONS] int; next: int; }

cd_http_held :: (ss: [] CdHttpSessions, sid: string) -> int {
  if sid.count == 0 { return -1; }
  for i: 0..<CD_HTTP_SESSIONS { if ss[0].nid[i] > 0 && cast(string) ss[0].id[i][0..<ss[0].nid[i]] == sid { return i; } }
  return -1;
}

// The local routes: what a page on this machine (openagents.com/chat under development, through the
// dev server's /local/ proxy) uses to show every Coder session and drive them. Beside /mcp, with the
// same Origin rule, and one more: every request carries "X-Coder-Local: 1", a header a page on another
// site can't send without a preflight this server never answers. So a link, an image or a form
// somewhere else can't start a session here.
//   GET  /sessions                    `coder ls --json`: every session, newest first
//   GET  /log?id=ID&after=N           the session log's complete lines from byte N (-1: its last
//                                     CD_LOCAL_CHUNK bytes), after one line {"next":N,"size":Z}
//   POST /run   {"task","engine","model","effort","cwd","on"}   a detached session; the body is its ID.
//                                     "on": "boat:ID" runs it on that boat dev box (#13474), resumed
//                                     under the dev box policy when it is stopped
//   GET  /sessions also lists the sessions started on boat boxes (their .remote records); /log, /send
//                                     and /stop of one go to its box
//   POST /send  {"id","message"}      the session's next turn (an ended one continues in a new session)
//   POST /stop  {"id"}
//   GET  /claude                      this folder's Claude Code conversations, newest first (`coder session-read list`)
//   POST /import {"ref"}              one of them as a Coder session (`coder import claude REF`, the same
//                                     session each time); the body is {"id": its ID}
CD_LOCAL_CHUNK :: 240000;

// A session ID as Coder makes them: digits and dashes.
cd_local_id_ok :: (id: string) -> bool {
  if id.count == 0 || id.count > 40 { return false; }
  for c: id { if !((c >= '0' && c <= '9') || c == '-') { return false; } }
  return true;
}
// The value of name in a target's query ("/log?id=7&after=3" and "after" is "3"); "" when it is absent.
cd_local_query :: (target: string, name: string) -> string {
  at := 0; while at < target.count && target[at] != '?' { at += 1; }
  at += 1;
  while at < target.count {
    e := at; while e < target.count && target[e] != '&' { e += 1; }
    if e - at > name.count && target[at + name.count] == '=' && cast(string) target[at..<at + name.count] == name { return cast(string) target[at + name.count + 1..<e]; }
    at = e + 1;
  }
  return "";
}
// Where to read a log of size bytes from, asked for after (a byte offset; under 0 for its end).
cd_local_from :: (size: int, after: int) -> int {
  if after < 0 { return ifx size > CD_LOCAL_CHUNK then size - CD_LOCAL_CHUNK else 0; }
  return ifx after > size then size else after;
}
// The complete lines of chunk, which starts at byte from of a log (cut: from is inside a line, so
// the first is dropped). RpSpan-like: where they start and end in chunk.
CdLocalSpan :: struct { at: int; end: int; }
cd_local_lines :: (chunk: string, cut: bool) -> CdLocalSpan {
  at := 0;
  if cut { while at < chunk.count && chunk[at] != 10 { at += 1; } if at < chunk.count { at += 1; } }
  end := chunk.count;
  while end > at && chunk[end - 1] != 10 { end -= 1; }
  return CdLocalSpan.{at = at, end = end};
}
cd_local_log :: (id: string, after: int, out: [] u8) -> string {
  db: [1100] u8; dir := cs_dir(db[..]);
  pb: [1400] u8; pn := cd_cat(pb[..], 0, dir); pn = cd_cat(pb[..], pn, "/"); pn = cd_cat(pb[..], pn, id); pn = cd_cat(pb[..], pn, ".jsonl");
  path := cast(string) pb[0..<pn];
  size := fs_size(path);
  if dir.count == 0 || size < 0 { return ""; }
  from := cd_local_from(size, after);
  chunk: [CD_LOCAL_CHUNK] u8;
  got := fs_read_at(path, from, chunk[..]);
  if got < 0 { got = 0; }
  return cd_local_log_answer(size, from, after, cast(string) chunk[0..<got], out);
}
// The /log answer for chunk, read from byte from of a log of size bytes for an ask after after.
cd_local_log_answer :: (size: int, from: int, after: int, chunk: string, out: [] u8) -> string {
  got := chunk.count;
  span := cd_local_lines(chunk, after < 0 && from > 0);
  // a line longer than a chunk is passed over, so a reader never stalls on it
  next := ifx span.end > span.at then from + span.end else ifx got == CD_LOCAL_CHUNK then from + got else from + span.at;
  tb: [24] u8;
  n := cd_cat(out, 0, "{\"next\":"); n = cd_cat(out, n, cd_itoa(next, tb[..])); n = cd_cat(out, n, ",\"size\":"); n = cd_cat(out, n, cd_itoa(size, tb[..])); n = cd_cat(out, n, "}\n");
  if span.end > span.at { n = cd_cat(out, n, cast(string) chunk[span.at..<span.end]); }
  return cast(string) out[0..<n];
}
// The same for a session that lives on a boat box: one ssh reads the size and the chunk there.
cd_local_boat_log :: (r: [] CdRoute2, id: string, after: int, out: [] u8) -> string {
  if !cd_r2_boat_fresh(r, false) { return ""; }
  tb: [24] u8; lb: [1024] u8;
  n := cd_cat(lb[..], 0, "f=\"$HOME/.openagents/coder/sessions/"); n = cd_cat(lb[..], n, id);
  n = cd_cat(lb[..], n, ".jsonl\"; s=$(stat -c %s \"$f\" 2>/dev/null) || exit 3; a=");
  n = cd_cat(lb[..], n, ifx after < 0 then "-1" else cd_itoa(after, tb[..]));
  n = cd_cat(lb[..], n, "; c=240000; if [ $a -lt 0 ]; then a=$((s > c ? s - c : 0)); elif [ $a -gt $s ]; then a=$s; fi; echo \"$s $a\"; tail -c +$((a + 1)) \"$f\" | head -c $c");
  argv: [32] string; bufs: [3] [1200] u8;
  na := cd_r2_argv(r, cast(string) lb[0..<n], argv[..], bufs[..]);
  ok: [1] bool; none: [1] string;
  got: [CD_LOCAL_CHUNK + 64] u8;
  text := rt_run_in(argv[0..<na], none[0..<0], "", 60, got[..], ok[..]);
  if !ok[0] { return ""; }
  e := 0; while e < text.count && text[e] != '\n' { e += 1; }
  sp := 0; while sp < e && text[sp] != ' ' { sp += 1; }
  if sp >= e { return ""; }
  size := cd_atoi(cast(string) text[0..<sp]); from := cd_atoi(cast(string) text[sp + 1..<e]);
  body := ifx e < text.count then cast(string) text[e + 1..<text.count] else "";
  return cd_local_log_answer(size, from, after, body, out);
}
// Whether a session belongs beside the chat: one that is running, or one started in the last day that
// is not a copy of a Claude Code conversation (those are listed as the conversations they are).
CD_LOCAL_DAY_US :: 86400000000;
cd_local_listed :: (state: string, started_us: int, now_us: int, imported: bool) -> bool {
  if state == "running" { return true; }
  return !imported && started_us > 0 && now_us - started_us < CD_LOCAL_DAY_US;
}
// Whether session id's log says it was imported (its first line).
cd_local_imported :: (id: string) -> bool {
  if !cd_local_id_ok(id) { return false; }
  db: [1100] u8; dir := cs_dir(db[..]);
  pb: [1400] u8; pn := cd_cat(pb[..], 0, dir); pn = cd_cat(pb[..], pn, "/"); pn = cd_cat(pb[..], pn, id); pn = cd_cat(pb[..], pn, ".jsonl");
  hb: [800] u8;
  got := fs_read_at(cast(string) pb[0..<pn], 0, hb[..]);
  if got <= 0 { return false; }
  e := 0; while e < got && hb[e] != 10 { e += 1; }
  return cl_raw(cast(string) hb[0..<e], "imported").count > 0;
}
// `coder ls --json`, less the sessions that don't belong beside the chat.
cd_local_sessions :: (now_us: int, out: [] u8, ok: [] bool) -> string {
  lb: [262144] u8; a := [2] string.["ls", "--json"];
  all := cd_mcp_coder(a[..], lb[..], ok);
  if !ok[0] { return ""; }
  ab: [4096] u8; ar: [1] ClArena;
  n := cd_cat(out, 0, "["); kept := 0;
  for i: 0..<cl_count(all) {
    el := cl_item(all, i);
    if !el.ok { continue; }
    one := cast(string) all[el.from..<el.to];
    ar[0] = ClArena.{buf = ab[..]};
    started := cl_int(one, "started_us");
    if !cd_local_listed(cl_str(ar[..], one, "state"), ifx started.ok then started.value else 0, now_us, cd_local_imported(cl_str(ar[..], one, "id"))) { continue; }
    if kept > 0 { n = cd_cat(out, n, ","); }
    n = cd_cat(out, n, one); kept += 1;
  }
  n = cd_local_boat_sessions(now_us, out, n, kept);
  n = cd_cat(out, n, "]");
  return cast(string) out[0..<n];
}
// The sessions started on boat boxes in the last day, from their .remote records, as list entries
// (state "on boat", cwd "boat:ID"), after kept entries already in out. The new length.
cd_local_boat_sessions :: (now_us: int, out: [] u8, at: int, kept_in: int) -> int {
  db: [1100] u8; dir := cs_dir(db[..]);
  if dir.count == 0 { return at; }
  l: [1] FsList; count := fs_list(dir, l[..]);
  n := at; kept := kept_in;
  for i: 0..<(ifx count < 0 then 0 else count) {
    name := fs_entry(l[..], i);
    if name.count < 8 || cast(string) name[name.count - 7..<name.count] != ".remote" { continue; }
    id := cast(string) name[0..<name.count - 7];
    if !cd_local_id_ok(id) { continue; }
    pb: [2048] u8; path := fs_join(dir, name, pb[..]);
    started := fs_mtime_ns(path) / 1000;
    if started <= 0 || now_us - started >= CD_LOCAL_DAY_US { continue; }
    fb: [4096] u8; k := fs_read(path, fb[..]);
    if k <= 0 { continue; }
    eb: [2048] u8; e := cd_local_boat_entry(cast(string) fb[0..<k], id, started, eb[..]);
    if e.count == 0 { continue; }
    if kept > 0 { n = cd_cat(out, n, ","); }
    for c: e { if n < out.count { out[n] = c; n += 1; } }
    kept += 1;
  }
  return n;
}
// One list entry for a boat session's record; "" when the record is not a boat one. Written into
// scratch (which may be out's free end: the caller copies it into place).
cd_local_boat_entry :: (rec: string, id: string, started_us: int, scratch: [] u8) -> string {
  ab: [4096] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  if cl_str(ar[..], rec, "on") != "boat" { return ""; }
  box := cl_str(ar[..], rec, "box");
  if !bt_id_ok(box) { return ""; }
  o: [2048] u8;
  n := json_raw(o[..], 0, "{\"id\":"); n = json_write_string(o[..], n, id);
  eng := cl_str(ar[..], rec, "engine");
  n = json_raw(o[..], n, ",\"engine\":"); n = json_write_string(o[..], n, ifx eng.count > 0 then eng else "claude");
  n = json_raw(o[..], n, ",\"state\":\"on boat\",\"turns\":0,\"steps\":0,\"started_us\":"); n = json_write_int(o[..], n, started_us);
  n = json_raw(o[..], n, ",\"cwd\":\"boat:"); n = json_raw(o[..], n, box);
  n = json_raw(o[..], n, "\",\"on\":\"boat:"); n = json_raw(o[..], n, box);
  n = json_raw(o[..], n, "\",\"task\":"); n = json_write_string(o[..], n, cl_str(ar[..], rec, "task"));
  n = json_raw(o[..], n, "}");
  if n < 0 || n > scratch.count { return ""; }
  // scratch may sit after what out already holds: copy forward
  for i: 0..<n { scratch[i] = o[i]; }
  return cast(string) scratch[0..<n];
}
// Whether target is one of the local routes.
cd_local_route :: (path: string) -> bool { return path == "/sessions" || path == "/log" || path == "/run" || path == "/send" || path == "/stop" || path == "/claude" || path == "/import" || path == "/agents"; }
// The agents on this machine a page may offer (#13465), in the page's order (Claude Code, Codex, Antigravity,
// Microcoder): {"agents":[{"engine":E,"ready":true|false,"why":TEXT},...]}. Ready: its program is here and,
// for Claude Code and Codex, a login it can use without a browser (an API key, or the login its CLI keeps).
// Nothing is started to find out, so nothing opens a sign-in.
cd_local_ready :: (out: [] u8) -> string {
  hb: [1024] u8; home := cl_getenv("HOME", hb[..]);
  kb: [16] u8; pb: [1200] u8; fb: [1048576] u8;
  claude := agr_on_path("claude");
  claude_in := cl_getenv("ANTHROPIC_API_KEY", kb[..]).count > 0;
  if claude && !claude_in && home.count > 0 {
    k := fs_read(fs_join(home, ".claude.json", pb[..]), fb[..]);
    claude_in = k > 0 && cd_local_has(cast(string) fb[0..<k], "\"oauthAccount\"");
  }
  codex := agr_on_path("codex");
  cb: [1200] u8; codex_in := home.count > 0 && fs_exists(fs_join(home, ".codex/auth.json", cb[..]));
  agy := ca_agy_installed();
  ready := [4] bool.[claude && claude_in, codex && codex_in, agy, true];
  why := [4] string.[ifx !claude then "Claude Code isn't installed here. Install it from claude.com/code." else "Claude Code isn't logged in here. Run claude in a terminal and log in.",
    ifx !codex then "Codex isn't installed here. Install it with npm install -g @openai/codex." else "Codex isn't logged in here. Run codex login in a terminal.",
    "Antigravity isn't installed here.", ""];
  return cd_local_ready_json(ready[..], why[..], out);
}
// The /agents answer for what cd_local_ready found; pure, for the tests.
cd_local_ready_json :: (ready: [] bool, why: [] string, out: [] u8) -> string {
  engines := [4] string.["claude", "codex", "antigravity", "micro"];
  n := cd_cat(out, 0, "{\"agents\":[");
  for i: 0..<4 {
    if i > 0 { n = cd_cat(out, n, ","); }
    n = cd_cat(out, n, "{\"engine\":\""); n = cd_cat(out, n, engines[i]); n = cd_cat(out, n, "\",\"ready\":");
    n = cd_cat(out, n, ifx ready[i] then "true" else "false"); n = cd_cat(out, n, ",\"why\":\"");
    n = cd_cat(out, n, ifx ready[i] then "" else why[i]); n = cd_cat(out, n, "\"}");
  }
  n = cd_cat(out, n, "]}");
  return cast(string) out[0..<n];
}
// The Claude Code conversations open now in this folder: each running `claude` keeps
// CLAUDE_DIR/sessions/PID.json with the conversation it has open, its folder and whether it is busy,
// and removes it when it exits. A file whose process is gone is left over from a crash and skipped.
// Written as "live":[{"id":ID,"busy":true|false},...] for the /claude answer.
CD_LIVE_MAX :: 32;
cd_local_live :: (root: string, here: string, out: [] u8, at: int) -> int {
  n := cd_cat(out, at, "\"live\":[");
  sb: [2048] u8; dir := fs_join(root, "sessions", sb[..]);
  l: [1] FsList; count := fs_list(dir, l[..]);
  kept := 0;
  for i: 0..<(ifx count < 0 then 0 else count) {
    name := fs_entry(l[..], i);
    if name.count < 6 || cast(string) name[name.count - 5..<name.count] != ".json" { continue; }
    digits := true; for c: name[0..<name.count - 5] { if c < '0' || c > '9' { digits = false; } }
    if !digits || kept >= CD_LIVE_MAX { continue; }
    pb: [2048] u8; fb: [8192] u8; k := fs_read(fs_join(dir, name, pb[..]), fb[..]);
    if k <= 0 { continue; }
    text := cast(string) fb[0..<k];
    ab: [8192] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
    pid := cl_int(text, "pid"); id := cl_str(ar[..], text, "sessionId"); cwd := cl_str(ar[..], text, "cwd");
    // a person's window: its entrypoint is "cli". Coder's own claude processes say "sdk-cli", and Coder lists those sessions itself
    if cl_str(ar[..], text, "entrypoint") != "cli" { continue; }
    if !pid.ok || cxproc_pid_alive(pid.value) != 1 || (here.count > 0 && cwd != here) || !cd_local_ref_ok(id) { continue; }
    if kept > 0 { n = cd_cat(out, n, ","); }
    n = cd_cat(out, n, "{\"id\":\""); n = cd_cat(out, n, id); n = cd_cat(out, n, "\",\"busy\":");
    n = cd_cat(out, n, ifx cl_str(ar[..], text, "status") == "busy" then "true}" else "false}");
    kept += 1;
  }
  return cd_cat(out, n, "]");
}
// The Claude Code conversation an ended session would continue: the last one its claude reported,
// else the one it was imported from. "" for a running session (a message waits for its turn) or another engine.
cd_local_conversation :: (id: string, out: [] u8) -> string {
  fb: [4194304] u8; ib: [128] u8;
  text := cd_session_file(id, fb[..], ib[..]);
  if text.count == 0 { return ""; }
  k := 0; while k < ib.count && ib[k] != 0 { k += 1; }
  pid := cd_job_pid(cast(string) ib[0..<k]);
  if pid > 0 && cxproc_pid_alive(pid) == 1 { return ""; }
  ab: [8192] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  n := 0; at := 0; first := true;
  while at < text.count {
    e := at; while e < text.count && text[e] != '\n' { e += 1; }
    line := cast(string) text[at..<e]; at = e + 1;
    ar[0].at = 0;
    if first { first = false; if cl_str(ar[..], line, "engine") != "claude" { return ""; } }
    kind := cl_str(ar[..], line, "kind");
    r := "";
    if kind == "session" { r = cl_str(ar[..], line, "resume"); }
    else if kind == "engine_session" { r = cl_str(ar[..], line, "id"); }
    if cd_local_ref_ok(r) { n = cd_cat(out, 0, r); }
  }
  return cast(string) out[0..<n];
}
// Whether text holds part.
cd_local_has :: (text: string, part: string) -> bool {
  if part.count == 0 || part.count > text.count { return false; }
  for i: 0..<text.count - part.count + 1 { if cast(string) text[i..<i + part.count] == part { return true; } }
  return false;
}
// A Claude Code conversation's ID: 36 characters of lowercase hex and dashes.
cd_local_ref_ok :: (ref: string) -> bool {
  if ref.count != 36 { return false; }
  for c: ref { if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || c == '-') { return false; } }
  return true;
}
cd_local_reply :: (head: string, body: string, out: [] u8) -> CdHttpReply {
  r: CdHttpReply;
  if cd_http_header(head, "x-coder-local") != "1" { r.status = 403; return r; }
  target := cd_http_word(head, 1); verb := cd_http_word(head, 0);
  q := 0; while q < target.count && target[q] != '?' { q += 1; }
  path := cast(string) target[0..<q];
  get := path == "/sessions" || path == "/log" || path == "/claude" || path == "/agents";
  if verb != (ifx get then "GET" else "POST") { r.status = 405; return r; }
  ok: [1] bool; a: [12] string; na := 0;
  ab: [65536] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  if path == "/sessions" { r.body = cd_local_sessions(cxproc_wall_us(), out, ok[..]); r.status = ifx ok[0] then 200 else 500; return r; }
  if path == "/agents" { r.body = cd_local_ready(out); r.status = 200; return r; }
  if path == "/claude" {
    cb: [1100] u8; here := fs_cwd(cb[..]);
    a[0] = "session-read"; a[1] = "list"; a[2] = "--cwd"; a[3] = here;
    list := cd_mcp_coder(a[0..<4], out, ok[..]);
    if !ok[0] || list.count < 2 || list[0] != '{' { r.body = list; r.status = 500; return r; }
    // the list, with the conversations open now in front of it: {"live":[...],"schema":...}
    rb: [2048] u8; root := csr_root(rb[..]);
    lb: [8192] u8; ln := cd_local_live(root, here, lb[..], 0);
    if ln + list.count + 2 > out.count { r.body = list; r.status = 200; return r; }
    for j: 0..<list.count - 1 { out[list.count - 1 - j + ln + 1] = list[list.count - 1 - j]; }   // back to front: list is in out
    out[0] = '{'; for j: 0..<ln { out[1 + j] = lb[j]; } out[ln + 1] = ',';
    r.body = cast(string) out[0..<list.count + ln + 1]; r.status = 200; return r;
  }
  if path == "/import" {
    ref := cl_str(ar[..], body, "ref");
    if !cd_local_ref_ok(ref) { r.status = 400; return r; }
    a[0] = "import"; a[1] = "claude"; a[2] = ref;
    said := cd_mcp_coder(a[0..<3], out, ok[..]);
    e := 0; while e < said.count && ((said[e] >= '0' && said[e] <= '9') || said[e] == '-') { e += 1; }
    if !ok[0] || !cd_local_id_ok(cast(string) said[0..<e]) { r.body = said; r.status = 500; return r; }
    idb: [48] u8; k := cd_cat(idb[..], 0, cast(string) said[0..<e]);
    n := cd_cat(out, 0, "{\"id\":\""); n = cd_cat(out, n, cast(string) idb[0..<k]); n = cd_cat(out, n, "\"}");
    r.body = cast(string) out[0..<n]; r.status = 200; return r;
  }
  if path == "/log" {
    id := cd_local_query(target, "id"); after := cd_local_query(target, "after");
    if !cd_local_id_ok(id) { r.status = 400; return r; }
    rr: [1] CdRoute2; full: [64] u8;
    if cd_r2_recorded(id, rr[..], full[..]) && rr[0].boat {
      r.body = cd_local_boat_log(rr[..], id, ifx after.count == 0 || after[0] == '-' then -1 else cd_atoi(after), out);
      r.status = ifx r.body.count > 0 then 200 else 502;
      return r;
    }
    r.body = cd_local_log(id, ifx after.count == 0 || after[0] == '-' then -1 else cd_atoi(after), out);
    r.status = ifx r.body.count > 0 then 200 else 404;
    return r;
  }
  id := cl_str(ar[..], body, "id");
  if path == "/run" {
    task := cl_str(ar[..], body, "task");
    if task.count == 0 { r.status = 400; return r; }
    a[0] = "run"; a[1] = task; a[2] = "--detach"; na = 3;
    names := [4] string.["engine", "model", "effort", "cwd"]; flags := [4] string.["--engine", "--model", "--effort", "--cwd"];
    for k: 0..<names.count { v := cl_str(ar[..], body, names[k]); if v.count > 0 { a[na] = flags[k]; a[na + 1] = v; na += 2; } }
    on := cl_str(ar[..], body, "on");
    if on.count > 0 {
      if !(on.count > 5 && cast(string) on[0..<5] == "boat:" && bt_id_ok(cast(string) on[5..<on.count])) { r.status = 400; return r; }
      a[na] = "--on"; a[na + 1] = on; na += 2;
    }
    r.body = cd_mcp_coder(a[0..<na], out, ok[..]);
  } else if !cd_local_id_ok(id) { r.status = 400; return r; }
  else if path == "/send" {
    msg := cl_str(ar[..], body, "message");
    if msg.count == 0 { r.status = 400; return r; }
    // a session on a boat box goes on there: the same conversation, a new session beside it
    rr: [1] CdRoute2; full: [64] u8;
    if cd_r2_recorded(id, rr[..], full[..]) && rr[0].boat {
      ob: [64] u8; on := cast(string) ob[0..<cd_cat(ob[..], cd_cat(ob[..], 0, "boat:"), cd_r2_s(rr[0].box[..], rr[0].nbox))];
      a[0] = "fork"; a[1] = id; a[2] = msg; a[3] = "--same-conversation"; a[4] = "--detach"; a[5] = "--on"; a[6] = on;
      said := cd_mcp_coder(a[0..<7], out, ok[..]);
      sb: [4096] u8; sar: [1] ClArena; sar[0] = ClArena.{buf = sb[..]};
      nid := ""; at := 0;
      while at < said.count && nid.count == 0 {
        e := at; while e < said.count && said[e] != '\n' { e += 1; }
        nid = cd_r2_session_of(cast(string) said[at..<e], sar[..]); at = e + 1;
      }
      if !ok[0] || !cd_local_id_ok(nid) { r.body = said; r.status = 500; return r; }
      idb: [48] u8; k := cd_cat(idb[..], 0, nid);
      n := cd_cat(out, 0, "{\"id\":\""); n = cd_cat(out, n, cast(string) idb[0..<k]); n = cd_cat(out, n, "\"}");
      r.body = cast(string) out[0..<n]; r.status = 200; return r;
    }
    // An ended Claude Code session goes on as the same conversation, unless a window has it open:
    // two claude processes writing one conversation would break it, and the window can't take a
    // message from here, so the page says where to type instead.
    cb2: [48] u8; conv := cd_local_conversation(id, cb2[..]);
    if conv.count > 0 {
      rb: [2048] u8; lb: [8192] u8; ln := cd_local_live(csr_root(rb[..]), "", lb[..], 0);
      if cd_local_has(cast(string) lb[0..<ln], conv) { r.status = 409; r.body = "This conversation is open in a Claude Code window. Type there, or close it there to continue it here."; return r; }
    }
    said := cd_mcp_send_as(id, msg, conv.count > 0, out, ok[..]);
    // the session the message went to: this one, or the new one an ended session continues in
    lead := "The session had ended; the conversation continues in ";
    now := id;
    if said.count > lead.count && cast(string) said[0..<lead.count] == lead {
      e := lead.count; while e < said.count && ((said[e] >= '0' && said[e] <= '9') || said[e] == '-') { e += 1; }
      now = cast(string) said[lead.count..<e];
    }
    if ok[0] && cd_local_id_ok(now) {
      idb: [48] u8; k := cd_cat(idb[..], 0, now);
      n := cd_cat(out, 0, "{\"id\":\""); n = cd_cat(out, n, cast(string) idb[0..<k]); n = cd_cat(out, n, "\"}");
      r.body = cast(string) out[0..<n];
    } else { r.body = said; ok[0] = false; }
  } else { a[0] = "stop"; a[1] = id; r.body = cd_mcp_coder(a[0..<2], out, ok[..]); }
  r.status = ifx ok[0] then 200 else 500;
  return r;
}

cd_http_reply :: (head: string, body: string, ss: [] CdHttpSessions, fresh: string, out: [] u8) -> CdHttpReply {
  r: CdHttpReply;
  if !cd_http_origin_ok(cd_http_header(head, "origin")) { r.status = 403; return r; }
  target := cd_http_word(head, 1);
  q := 0; while q < target.count && target[q] != '?' { q += 1; }
  if cd_local_route(cast(string) target[0..<q]) { return cd_local_reply(head, body, out); }
  if cast(string) target[0..<q] != "/mcp" { r.status = 404; return r; }
  verb := cd_http_word(head, 0);
  sid := cd_http_header(head, "mcp-session-id");
  if verb == "DELETE" {
    k := cd_http_held(ss, sid);
    if k < 0 { r.status = ifx sid.count == 0 then 400 else 404; return r; }
    ss[0].nid[k] = 0; r.status = 200; return r;
  }
  if verb != "POST" { r.status = 405; return r; }
  b := 0; while b < body.count && (body[b] == ' ' || body[b] == 9 || body[b] == 13 || body[b] == 10) { b += 1; }
  if b >= body.count || body[b] != '{' { r.status = 400; return r; }    // one message a POST; no batches
  ab: [4096] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  if cl_str(ar[..], body, "method") == "initialize" {
    k := ss[0].next; ss[0].next = (k + 1) % CD_HTTP_SESSIONS;
    ss[0].nid[k] = cd_cat(ss[0].id[k][..], 0, fresh);
    r.session = cast(string) ss[0].id[k][0..<ss[0].nid[k]];
  } else if sid.count == 0 { r.status = 400; return r; }
  else if cd_http_held(ss, sid) < 0 { r.status = 404; return r; }
  r.body = cd_mcp_answer(body, out);
  r.status = ifx r.body.count > 0 then 200 else 202;
  return r;
}

cxrand_fill :: (n: int) -> int #foreign #effects(all);
cxrand_byte :: (i: int) -> int #foreign #effects(all);

// 16 random bytes as 32 hex digits, from the system's entropy.
cd_http_fresh :: (out: [] u8) -> string {
  if cxrand_fill(16) != 0 { return ""; }
  hx := "0123456789abcdef";
  for i: 0..<16 { v := cxrand_byte(i); out[2 * i] = hx[(v >> 4) & 15]; out[2 * i + 1] = hx[v & 15]; }
  return cast(string) out[0..<32];
}

cd_http_write :: (c: int, s: string) -> bool {
  for x: s { if cxsock_write(c, cast(int) x) != 0 { return false; } }
  return true;
}

cd_http_reason :: (status: int) -> string {
  if status == 200 { return "OK"; }
  if status == 202 { return "Accepted"; }
  if status == 400 { return "Bad Request"; }
  if status == 403 { return "Forbidden"; }
  if status == 404 { return "Not Found"; }
  if status == 405 { return "Method Not Allowed"; }
  if status == 500 { return "Internal Server Error"; }
  return "Payload Too Large";
}

cd_http_send :: (c: int, r: CdHttpReply) {
  tb: [24] u8;
  reason := cd_http_reason(r.status);
  hb: [512] u8;
  n := cd_cat(hb[..], 0, "HTTP/1.1 "); n = cd_cat(hb[..], n, cd_itoa(r.status, tb[..])); n = cd_cat(hb[..], n, " "); n = cd_cat(hb[..], n, reason);
  n = cd_cat(hb[..], n, "\r\nConnection: close\r\nContent-Length: "); n = cd_cat(hb[..], n, cd_itoa(r.body.count, tb[..]));
  if r.body.count > 0 { n = cd_cat(hb[..], n, "\r\nContent-Type: application/json"); }
  if r.session.count > 0 { n = cd_cat(hb[..], n, "\r\nMcp-Session-Id: "); n = cd_cat(hb[..], n, r.session); }
  if r.status == 405 { n = cd_cat(hb[..], n, "\r\nAllow: POST, DELETE"); }
  n = cd_cat(hb[..], n, "\r\n\r\n");
  ok := cd_http_write(c, cast(string) hb[0..<n]) && cd_http_write(c, r.body);
  f := cxsock_flush(c, 10000);
}

// coder mcp --http PORT (0 picks a port): serves until killed.
cd_cmd_mcp_http :: (port: int) -> int {
  l := cxsock_listen(port);
  if l < 0 { tool_err("coder mcp: could not listen on 127.0.0.1:"); tb0: [24] u8; tool_errln(cd_itoa(port, tb0[..])); return 1; }
  pb: [24] u8; lb: [128] u8;
  m := cd_cat(lb[..], 0, "coder mcp: http://127.0.0.1:"); m = cd_cat(lb[..], m, cd_itoa(cxsock_port(l), pb[..])); m = cd_cat(lb[..], m, "/mcp");
  cd_outln(cast(string) lb[0..<m]);
  req: [CD_HTTP_MAX] u8;
  out: [524288] u8;
  ss: [1] CdHttpSessions;
  for guard: 0..<1000000000 {
    c := cxsock_accept(l, 1000);
    if c < 0 { continue; }
    n := 0; head := -1; total := -1; big := false;
    for reads: 0..<100000 {
      k := cxsock_read(c, 10000);
      if k <= 0 { break; }
      for i: 0..<k { if n < req.count { req[n] = cast,trunc(u8) cxsock_byte(c, i); n += 1; } else { big = true; } }
      if head < 0 {
        head = cd_http_end(cast(string) req[0..<n]);
        if head >= 0 { clen := cd_atoi(cd_http_header(cast(string) req[0..<head], "content-length")); total = head + (ifx clen > 0 then clen else 0); }
      }
      if big || (total >= 0 && n >= total) { break; }
    }
    r: CdHttpReply;
    if big || (total > req.count) { r.status = 413; }
    else if head >= 0 && n >= total {
      fb: [32] u8; fresh := cd_http_fresh(fb[..]);
      if fresh.count == 0 { r.status = 500; }
      else { r = cd_http_reply(cast(string) req[0..<head], cast(string) req[head..<total], ss[..], fresh, out[..]); }
    }
    else { r.status = 400; }
    cd_http_send(c, r);
    x := cxsock_close(c);
  }
  return 0;
}

#test "mcp over http: one message a POST to /mcp, from this machine only" {
  out: [65536] u8;
  head := "POST /mcp HTTP/1.1\r\nHost: 127.0.0.1:7777\r\ncontent-length: 58\r\nOrigin: http://localhost:3000\r\nAccept: application/json, text/event-stream\r\n\r\n";
  #assert cd_http_end(cast(string) head) == head.count;
  #assert cd_http_end("POST /mcp HTTP/1.1\r\nHost: x\r\n") == -1;
  #assert cd_http_header(head, "content-length") == "58" && cd_http_header(head, "origin") == "http://localhost:3000" && cd_http_header(head, "mcp-session-id") == "";
  #assert cd_http_word(head, 0) == "POST" && cd_http_word(head, 1) == "/mcp";
  ss: [1] CdHttpSessions;
  #assert cd_http_reply(head, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}", ss[..], "f1", out[..]).status == 400;   // no session yet
  i0 := cd_http_reply(head, "{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"initialize\",\"params\":{}}", ss[..], "abc123", out[..]);
  #assert i0.status == 200 && i0.session == "abc123";
  sh := "POST /mcp HTTP/1.1\r\nMcp-Session-Id: abc123\r\n\r\n";
  r := cd_http_reply(sh, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}", ss[..], "f2", out[..]);
  #assert r.status == 200 && r.body == "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}" && r.session.count == 0;
  #assert cd_http_reply(sh, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}", ss[..], "f3", out[..]).status == 202;
  #assert cd_http_reply("POST /mcp HTTP/1.1\r\nMcp-Session-Id: nope\r\n\r\n", "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}", ss[..], "f4", out[..]).status == 404;
  #assert cd_http_reply(sh, "[{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}]", ss[..], "f5", out[..]).status == 400;
  #assert cd_http_reply("GET /mcp HTTP/1.1\r\nAccept: text/event-stream\r\n\r\n", "", ss[..], "f6", out[..]).status == 405;
  #assert cd_http_reply("POST /other HTTP/1.1\r\n\r\n", "{}", ss[..], "f7", out[..]).status == 404;
  #assert cd_http_reply("POST /mcp HTTP/1.1\r\nOrigin: https://evil.example\r\n\r\n", "{}", ss[..], "f8", out[..]).status == 403;
  #assert cd_http_reply("DELETE /mcp HTTP/1.1\r\nMcp-Session-Id: abc123\r\n\r\n", "", ss[..], "f9", out[..]).status == 200;
  #assert cd_http_reply(sh, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"ping\"}", ss[..], "fa", out[..]).status == 404;   // ended
  #assert cd_http_origin_ok("http://127.0.0.1:8080") && cd_http_origin_ok("") && cd_http_origin_ok("http://[::1]");
  #assert !cd_http_origin_ok("http://localhost.evil.example") && !cd_http_origin_ok("http://localhost:80x") && !cd_http_origin_ok("null");
}

#test "the local routes: a boat session's record becomes a list entry; other records don't" {
  sb: [1024] u8;
  e := cd_local_boat_entry("{\"id\":\"20261113-160000-001\",\"on\":\"boat\",\"box\":\"bx_fwh3xnws\",\"dest\":\"boat-bx_fwh3xnws\",\"repo\":\"~/oa\",\"task\":\"fix \\\"it\\\"\",\"engine\":\"codex\"}", "20261113-160000-001", 7, sb[..]);
  #assert e == "{\"id\":\"20261113-160000-001\",\"engine\":\"codex\",\"state\":\"on boat\",\"turns\":0,\"steps\":0,\"started_us\":7,\"cwd\":\"boat:bx_fwh3xnws\",\"on\":\"boat:bx_fwh3xnws\",\"task\":\"fix \\\"it\\\"\"}";
  #assert cd_local_boat_entry("{\"on\":\"boat\",\"box\":\"bx_fwh3xnws\"}", "1-2", 1, sb[..]) == "{\"id\":\"1-2\",\"engine\":\"claude\",\"state\":\"on boat\",\"turns\":0,\"steps\":0,\"started_us\":1,\"cwd\":\"boat:bx_fwh3xnws\",\"on\":\"boat:bx_fwh3xnws\",\"task\":\"\"}";
  #assert cd_local_boat_entry("{\"on\":\"ssh\",\"dest\":\"coderos-4080\"}", "1-2", 1, sb[..]) == "" && cd_local_boat_entry("{\"on\":\"boat\",\"box\":\"x\"}", "1-2", 1, sb[..]) == "";
  tiny: [8] u8;
  #assert cd_local_boat_entry("{\"on\":\"boat\",\"box\":\"bx_fwh3xnws\"}", "1-2", 1, tiny[..]) == "";
  // a remote log's answer: the same lines and offsets as a local one
  ob: [256] u8;
  #assert cd_local_log_answer(20, 0, 0, "{\"a\":1}\n{\"b\":2}\n{\"c", ob[..]) == "{\"next\":16,\"size\":20}\n{\"a\":1}\n{\"b\":2}\n";
  #assert cd_local_log_answer(20, 4, -1, "x}\n{\"b\":2}\n", ob[..]) == "{\"next\":15,\"size\":20}\n{\"b\":2}\n";
}

#test "the local routes: only with the header a page elsewhere can't send, and only well-formed asks" {
  out: [65536] u8; ss: [1] CdHttpSessions;
  #assert cd_http_reply("GET /sessions HTTP/1.1\r\n\r\n", "", ss[..], "f", out[..]).status == 403;
  #assert cd_http_reply("POST /run HTTP/1.1\r\n\r\n", "{\"task\":\"x\"}", ss[..], "f", out[..]).status == 403;
  #assert cd_http_reply("POST /run HTTP/1.1\r\nX-Coder-Local: 1\r\nOrigin: https://evil.example\r\n\r\n", "{\"task\":\"x\"}", ss[..], "f", out[..]).status == 403;
  #assert cd_http_reply("POST /sessions HTTP/1.1\r\nX-Coder-Local: 1\r\n\r\n", "", ss[..], "f", out[..]).status == 405;
  #assert cd_http_reply("GET /run HTTP/1.1\r\nX-Coder-Local: 1\r\n\r\n", "", ss[..], "f", out[..]).status == 405;
  #assert cd_http_reply("POST /run HTTP/1.1\r\nX-Coder-Local: 1\r\n\r\n", "{}", ss[..], "f", out[..]).status == 400;
  #assert cd_http_reply("POST /send HTTP/1.1\r\nX-Coder-Local: 1\r\n\r\n", "{\"id\":\"../x\",\"message\":\"m\"}", ss[..], "f", out[..]).status == 400;
  #assert cd_http_reply("POST /send HTTP/1.1\r\nX-Coder-Local: 1\r\n\r\n", "{\"id\":\"2026-1\"}", ss[..], "f", out[..]).status == 400;
  #assert cd_http_reply("POST /stop HTTP/1.1\r\nX-Coder-Local: 1\r\n\r\n", "{}", ss[..], "f", out[..]).status == 400;
  #assert cd_http_reply("GET /log?id=..%2Fx HTTP/1.1\r\nX-Coder-Local: 1\r\n\r\n", "", ss[..], "f", out[..]).status == 400;
  #assert cd_http_reply("POST /import HTTP/1.1\r\nX-Coder-Local: 1\r\n\r\n", "{\"ref\":\"../../etc\"}", ss[..], "f", out[..]).status == 400;
  #assert cd_http_reply("POST /claude HTTP/1.1\r\nX-Coder-Local: 1\r\n\r\n", "", ss[..], "f", out[..]).status == 405;
  #assert cd_local_ref_ok("7fe255eb-ec54-4f77-b7b3-64252ee8d7ff") && !cd_local_ref_ok("7fe255eb") && !cd_local_ref_ok("7fe255eb-ec54-4f77-b7b3-64252ee8d7fg") && !cd_local_ref_ok("7FE255EB-ec54-4f77-b7b3-64252ee8d7ff");
  #assert cd_local_id_ok("20261110-152212-593") && !cd_local_id_ok("") && !cd_local_id_ok("a") && !cd_local_id_ok("1/2") && !cd_local_id_ok("1.2");
  #assert cd_local_query("/log?id=7&after=30", "id") == "7" && cd_local_query("/log?id=7&after=30", "after") == "30" && cd_local_query("/log?id=7", "after") == "" && cd_local_query("/log", "id") == "" && cd_local_query("/log?xid=7", "id") == "";
  #assert cd_local_route("/agents") && cd_local_route("/log") && cd_local_route("/sessions") && cd_local_route("/run") && cd_local_route("/send") && cd_local_route("/stop") && !cd_local_route("/mcp") && !cd_local_route("/");
}

#test "a log is read in complete lines: from a byte, or its last chunk" {
  #assert cd_local_listed("running", 0, 5, true) && cd_local_listed("finished", 10, 10 + CD_LOCAL_DAY_US - 1, false) && !cd_local_listed("finished", 10, 10 + CD_LOCAL_DAY_US, false);
  #assert !cd_local_listed("finished", 10, 20, true) && !cd_local_listed("finished", 0, 20, false) && !cd_local_imported("../x");
  #assert cd_local_from(100, -1) == 0 && cd_local_from(CD_LOCAL_CHUNK + 50, -1) == 50 && cd_local_from(100, 40) == 40 && cd_local_from(100, 400) == 100 && cd_local_from(100, 0) == 0;
  s := cd_local_lines("ab\ncd\nef", false);
  #assert s.at == 0 && s.end == 6;
  s = cd_local_lines("ab\ncd\nef", true);
  #assert s.at == 3 && s.end == 6;
  s = cd_local_lines("abcdef", false);
  #assert s.at == 0 && s.end == 0;
  s = cd_local_lines("abcdef", true);
  #assert s.at == 6 && s.end == 6;
  s = cd_local_lines("", false);
  #assert s.at == 0 && s.end == 0;
  s = cd_local_lines("ab\n", false);
  #assert s.at == 0 && s.end == 3;
}

#test "the agents on this machine: each of the page's four, ready or why not, and a GET only" {
  out: [8192] u8;
  ready := [4] bool.[true, false, false, true];
  why := [4] string.["no", "Codex isn't logged in here.", "Antigravity isn't installed here.", ""];
  b := cd_local_ready_json(ready[..], why[..], out[..]);
  #assert b == "{\"agents\":[{\"engine\":\"claude\",\"ready\":true,\"why\":\"\"},{\"engine\":\"codex\",\"ready\":false,\"why\":\"Codex isn't logged in here.\"},{\"engine\":\"antigravity\",\"ready\":false,\"why\":\"Antigravity isn't installed here.\"},{\"engine\":\"micro\",\"ready\":true,\"why\":\"\"}]}";
  #assert cd_local_route("/agents");
  #assert cd_local_reply("POST /agents HTTP/1.1\r\nX-Coder-Local: 1", "", out[..]).status == 405;
  #assert cd_local_reply("GET /agents HTTP/1.1", "", out[..]).status == 403;
}
