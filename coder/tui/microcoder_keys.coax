// Microcoder's gateway plan and conversation for mcworker.coax: the
// credentials this machine has (as the desktop Lab reads them: files under
// ~/work/.secrets go into curl's child environment only, through
// Gateway.key_value, and Vertex's token is minted by gcloud with the
// service-account key file and a gcloud config of its own, set in gcloud's
// environment only), the plan built from them (Vertex Gemini, then the
// Gemini API, then OpenRouter), and the earlier turns told to each run.
//
// Vertex (GitHub #13231): the service account, project and location are the
// ones ~/.openagents/coder/antigravity.env names for Coder's Antigravity
// engine (GOOGLE_APPLICATION_CREDENTIALS, a path; GOOGLE_CLOUD_PROJECT;
// GOOGLE_CLOUD_LOCATION), read the way that engine reads them: a variable
// already in this process's environment wins over the file. Without them,
// ~/work/.secrets/vertex-sa-inference.json, openagentsgemini, global. The
// owner's --model (gemini-4-argon, gemini-4-carbon, gemini-4-hydrogen; Hydrogen
// by default) goes to Vertex's native streamGenerateContent, which reports
// thoughts and cached tokens; recorded answers (GW_REPLAY) stay on the
// OpenAI endpoint they were recorded from.

#load "../../coax/lib/microcoder/run.coax";
#load "../../coax/lib/gateway/vertex.coax";
#load "../../coax/lib/gateway/openrouter.coax";
#load "../../coax/lib/gateway/psionic.coax";
#load "../../coax/lib/sys/fs.coax";

MK_SECRETS :: "/work/.secrets/";                          // under $HOME
MK_VERTEX_KEYFILE :: "/work/.secrets/vertex-sa-inference.json";
MK_GCLOUD_CONFIG :: "/.cache/openagents/coder-gcloud";
MK_GCLOUDS :: [5] string.["/google-cloud-sdk/bin/gcloud", "/.nix-profile/bin/gcloud", "/opt/homebrew/bin/gcloud", "/usr/local/bin/gcloud", "/run/current-system/sw/bin/gcloud"];   // the first two under $HOME
MK_GCLOUDS_HOME :: 2;
MK_AGY_ENV :: "/.openagents/coder/antigravity.env";      // under $HOME: the Antigravity engine's Google Cloud sign-in
MK_TURNS :: 6;                   // earlier turns each run is told
MK_TURN_TEXT :: 1200;            // bytes of each task and reply kept

MkKeys :: struct {
  read: bool;
  vx: [1] GwVertex;
  or_key: [512] u8; nor: int;
  gm_key: [512] u8; ngm: int;
  keyfile: [1200] u8; nkf: int;
  gcloud: [1200] u8; ngc: int;
  config: [1200] u8; ncf: int;
  gurl: [512] u8;
  orh: [2] string;               // OpenRouter's headers: the plan keeps them
  none: [1] string;              // no headers, also kept
  told: bool;                    // why Vertex was skipped went to stderr
  pbase: [512] u8; purl: [600] u8; pmodel: [256] u8;   // the psionic engine's server
  project: [128] u8; location: [64] u8;                // Vertex's, when antigravity.env or the environment names them
}

mk_cat :: (out: [] u8, n: int, s: string) -> int { m := n; for c: s { if m < out.count { out[m] = c; m += 1; } } return m; }
mk_exists :: (path: string) -> bool { return fs_exists(path); }

// The text cut to fit, at a UTF-8 boundary.
mk_keep :: (dst: [] u8, s: string) -> int {
  n := ifx s.count < dst.count then s.count else dst.count;
  while n > 0 && n < s.count && (s[n] & 0xC0) == 0x80 { n -= 1; }
  for i: 0..<n { dst[i] = s[i]; }
  return n;
}

// NAME=value from an env file's text ("" when absent); an export prefix and quotes are dropped.
mk_env_value :: (text: string, name: string) -> string {
  at := 0;
  while at < text.count {
    e := at; while e < text.count && text[e] != 10 { e += 1; }
    line := cast(string) text[at..<e];
    if line.count > 7 && cast(string) line[0..<7] == "export " { line = cast(string) line[7..<line.count]; }
    if line.count > name.count && cast(string) line[0..<name.count] == name && line[name.count] == '=' {
      v := cast(string) line[name.count + 1..<line.count];
      while v.count > 0 && (v[v.count - 1] == 13 || v[v.count - 1] == ' ') { v = cast(string) v[0..<v.count - 1]; }
      if v.count >= 2 && (v[0] == '"' || v[0] == '\'') && v[v.count - 1] == v[0] { v = cast(string) v[1..<v.count - 1]; }
      return v;
    }
    at = e + 1;
  }
  return "";
}

// One secret from an env file under ~/work/.secrets into dst; the file's bytes are wiped.
mk_secret :: (home: string, file: string, name: string, dst: [] u8) -> int {
  path: [1400] u8; buf: [8192] u8;
  np := mk_cat(path[..], mk_cat(path[..], mk_cat(path[..], 0, home), MK_SECRETS), file);
  nf := fs_read(cast(string) path[0..<np], buf[..]);
  v := mk_env_value(cast(string) buf[0..<ifx nf > 0 then nf else 0], name);
  n := ifx v.count <= dst.count then mk_cat(dst, 0, v) else 0;
  for i: 0..<buf.count { buf[i] = 0; }
  return n;
}

// NAME's value: this process's environment first, then the Antigravity file's text; "" for neither.
mk_agy_value :: (agy: string, name: string, out: [] u8) -> string {
  e := cl_getenv(name, out);
  if e.count > 0 { return e; }
  v := mk_env_value(agy, name);
  if v.count == 0 || v.count > out.count { return ""; }
  return cast(string) out[0..<mk_cat(out, 0, v)];
}

// Vertex's project and location, each "" for the default, into k (copied into its buffers).
mk_vertex_place :: (k: [] MkKeys, project: string, location: string) {
  k[0].vx[0].project = GW_VERTEX_PROJECT; k[0].vx[0].location = GW_VERTEX_LOCATION;
  if project.count > 0 && project.count <= k[0].project.count { k[0].vx[0].project = cast(string) k[0].project[0..<mk_cat(k[0].project[..], 0, project)]; }
  if location.count > 0 && location.count <= k[0].location.count { k[0].vx[0].location = cast(string) k[0].location[0..<mk_cat(k[0].location[..], 0, location)]; }
}

// The credentials this machine has, read once.
mk_keys :: (k: [] MkKeys) {
  if k[0].read { return; }
  k[0].read = true;
  k[0].vx[0].project = GW_VERTEX_PROJECT; k[0].vx[0].location = GW_VERTEX_LOCATION;
  hb: [1024] u8; home := cl_getenv("HOME", hb[..]);
  if home.count == 0 { return; }
  k[0].nor = mk_secret(home, "openrouter.env", GW_OPENROUTER_KEY_ENV, k[0].or_key[..]);
  k[0].ngm = mk_secret(home, "openagents-gemini-provider.env", "GEMINI_API_KEY", k[0].gm_key[..]);
  ap: [1400] u8; ab: [4096] u8;
  na := fs_read(cast(string) ap[0..<mk_cat(ap[..], mk_cat(ap[..], 0, home), MK_AGY_ENV)], ab[..]);
  agy := cast(string) ab[0..<ifx na > 0 then na else 0];
  pb2: [128] u8; lb2: [64] u8;
  mk_vertex_place(k, mk_agy_value(agy, "GOOGLE_CLOUD_PROJECT", pb2[..]), mk_agy_value(agy, "GOOGLE_CLOUD_LOCATION", lb2[..]));
  kb: [1200] u8; named := mk_env_value(agy, "GOOGLE_APPLICATION_CREDENTIALS");
  if named.count > 0 && named.count <= kb.count && mk_exists(named) { k[0].nkf = mk_cat(k[0].keyfile[..], 0, named); }
  else {
    kf := mk_cat(k[0].keyfile[..], mk_cat(k[0].keyfile[..], 0, home), MK_VERTEX_KEYFILE);
    if mk_exists(cast(string) k[0].keyfile[0..<kf]) { k[0].nkf = kf; }
  }
  for i: 0..<ab.count { ab[i] = 0; }
  gclouds := MK_GCLOUDS;
  for g, i: gclouds {
    n := ifx i < MK_GCLOUDS_HOME then mk_cat(k[0].gcloud[..], mk_cat(k[0].gcloud[..], 0, home), g) else mk_cat(k[0].gcloud[..], 0, g);
    if mk_exists(cast(string) k[0].gcloud[0..<n]) { k[0].ngc = n; break; }
  }
  k[0].ncf = mk_cat(k[0].config[..], mk_cat(k[0].config[..], 0, home), MK_GCLOUD_CONFIG);
}

// Vertex's token: from the environment when it has one, else from the key file through gcloud.
mk_vertex :: (k: [] MkKeys) -> string {
  t: [16] u8; c: [16] u8;
  if cl_getenv("VERTEX_ACCESS_TOKEN", t[..]).count > 0 || cl_getenv("GOOGLE_APPLICATION_CREDENTIALS", c[..]).count > 0 { return gw_vertex_token(k[0].vx[..]); }
  if k[0].nkf == 0 { return "no Vertex key file"; }
  if k[0].ngc == 0 { return "gcloud isn't installed"; }
  return gw_vertex_token_file(k[0].vx[..], cast(string) k[0].gcloud[0..<k[0].ngc], cast(string) k[0].keyfile[0..<k[0].nkf], cast(string) k[0].config[0..<k[0].ncf]);
}

// The Vertex model for the owner's --model: a Gemini name without "google/", else Hydrogen.
mk_vertex_model :: (model: string) -> string {
  m := gw_gemini_model(model);
  if m.count > 7 && m[0..<7] == "gemini-" { return m; }
  return gw_gemini_model(GW_VERTEX_FLASH);
}

// How long a call may stay silent, by effort (GitHub #13231): at low, Flash, Argon and Carbon
// answer an 11K-token prompt in 3-7 s; at medium they can think for minutes.
mk_first_limit_ms :: (effort: string) -> int {
  if effort == "medium" { return 240000; }
  if effort == "high" { return 290000; }
  return 90000;
}
MK_IDLE_LIMIT_MS :: 90000;
MK_RETRIES :: 3;

// The plan's retries and silence limits for a run at effort.
mk_plan_limits :: (p: [] GwPlan, effort: string) {
  p[0].retries = MK_RETRIES; p[0].backoff_ms = 2000;
  p[0].first_limit_ms = mk_first_limit_ms(effort); p[0].idle_limit_ms = MK_IDLE_LIMIT_MS;
}

// The plan for one message: every gateway with a credential, Vertex first. How many.
mk_plan :: (k: [] MkKeys, p: [] GwPlan, pb: [] GwPlanBuffers, model: string) -> int {
  gw_plan_init(p, pb);
  none := k[0].none[0..<0];
  // a replay of recorded answers (GW_REPLAY): Vertex's wire, with no credential, since nothing is sent
  rb: [1024] u8;
  if gw_env("GW_REPLAY", rb[..]).count > 0 { x := gw_plan_add(p, gw_vertex(k[0].vx[..]), GW_VERTEX_FLASH, none); return p[0].n; }
  why := mk_vertex(k);
  if why.count == 0 { vm := mk_vertex_model(model); x := gw_plan_add(p, gw_vertex_native(k[0].vx[..], vm), vm, none); }
  else if !k[0].told { k[0].told = true; tool_err("microcoder: Vertex skipped: "); tool_errln(why); }
  if k[0].ngm > 0 {
    g := gw_gemini(GW_GEMINI_FLASH, true, k[0].gurl[..]); g.key_value = cast(string) k[0].gm_key[0..<k[0].ngm];
    x := gw_plan_add(p, g, GW_GEMINI_FLASH, none);
  }
  if k[0].nor > 0 {
    g := gw_openrouter(false); g.key_value = cast(string) k[0].or_key[0..<k[0].nor];
    k[0].orh = GW_OPENROUTER_HEADERS;
    x := gw_plan_add(p, g, GW_OPENROUTER_FLASH, k[0].orh[..]);
  }
  return p[0].n;
}

// The psionic engine's plan: one keyless gateway, the Chat Completions server
// on this machine at PSIONIC_BASE_URL (http://127.0.0.1:8080 by default),
// with PSIONIC_MODEL or "local" as the model. Nothing leaves the machine.
// "" when the plan is made, else why not.
mk_plan_local :: (k: [] MkKeys, p: [] GwPlan, pb: [] GwPlanBuffers, why: [] u8) -> string {
  gw_plan_init(p, pb);
  base := gw_psionic_base(k[0].pbase[..]);
  rb: [1024] u8; replaying := gw_env("GW_REPLAY", rb[..]).count > 0;    // recorded answers: no server to ask
  if !replaying && !gw_psionic_up(base) {
    n := mk_cat(why, 0, "No model server answers at "); n = mk_cat(why, n, base);
    n = mk_cat(why, n, "/v1/models. Start one there (psionic, llama-server or any Chat Completions server), or set PSIONIC_BASE_URL.");
    return cast(string) why[0..<n];
  }
  model := gw_env("PSIONIC_MODEL", k[0].pmodel[..]);
  if model.count == 0 { model = "local"; }
  x := gw_plan_add(p, gw_psionic(base, k[0].purl[..]), model, k[0].none[0..<0]);
  return "";
}

// ---------------------------------------------------------------- the conversation

// Earlier turns, oldest first: turn i's task at slot 2i, its reply at 2i+1.
MkTurns :: struct {
  text: [2 * MK_TURNS * MK_TURN_TEXT] u8;
  n: [2 * MK_TURNS] int;
  turns: int;
  cur: [MK_TURN_TEXT] u8; ncur: int;    // the running turn's task
}
mk_slot :: (h: [] MkTurns, k: int) -> [] u8 { return h[0].text[k * MK_TURN_TEXT..<(k + 1) * MK_TURN_TEXT]; }
mk_text :: (h: [] MkTurns, k: int) -> string { return cast(string) h[0].text[k * MK_TURN_TEXT..<k * MK_TURN_TEXT + h[0].n[k]]; }

// Remembers the running turn with its reply; the oldest goes when there are MK_TURNS.
mk_remember :: (h: [] MkTurns, reply: string) {
  if h[0].turns == MK_TURNS {
    for k: 2..<2 * MK_TURNS { h[0].n[k - 2] = mk_keep(mk_slot(h, k - 2), mk_text(h, k)); }
    h[0].turns -= 1;
  }
  k := 2 * h[0].turns;
  h[0].n[k] = mk_keep(mk_slot(h, k), cast(string) h[0].cur[0..<h[0].ncur]);
  h[0].n[k + 1] = mk_keep(mk_slot(h, k + 1), reply);
  h[0].turns += 1;
}

// A command's time limit in a Coder run (GitHub #13325): 120 s, where the loop's own is 30 s.
// A unit's checks often take a minute or more; in #13231's H6 the model spent 5 to 8 calls
// starting them in the background and polling. STOP waits for a running command to end.
MK_COMMAND_SECONDS :: 120;

// The facts a run is told: the machine, the folder, a command's time limit (when the run has
// its own) and the conversation so far.
mk_facts :: (h: [] MkTurns, os: string, cwd: string, command_seconds: int, o: [] u8) -> string {
  n := json_raw(o, 0, "{\"os\":"); n = json_write_string(o, n, os);
  n = json_raw(o, n, ",\"app\":\"Coder in the terminal\",\"cwd\":");
  n = json_write_string(o, n, cwd);
  if command_seconds > 0 { n = json_raw(o, n, ",\"command_seconds\":"); n = json_write_int(o, n, command_seconds); }
  if h[0].turns > 0 {
    n = json_raw(o, n, ",\"conversation\":[");
    for i: 0..<h[0].turns {
      if i > 0 { n = json_raw(o, n, ","); }
      n = json_raw(o, n, "{\"user\":"); n = json_write_string(o, n, mk_text(h, 2 * i));
      n = json_raw(o, n, ",\"you\":"); n = json_write_string(o, n, mk_text(h, 2 * i + 1));
      n = json_raw(o, n, "}");
    }
    n = json_raw(o, n, "]");
  }
  n = json_raw(o, n, "}");
  if n < 0 { return "{\"os\":\"macOS\"}"; }
  return cast(string) o[0..<n];
}

#test "the conversation keeps the last turns, oldest first, and goes into the facts" {
  h: [1] MkTurns; o: [4096] u8;
  #assert mk_facts(h[..], "macOS", "/w", 0, o[..]) == "{\"os\":\"macOS\",\"app\":\"Coder in the terminal\",\"cwd\":\"/w\"}";
  #assert mk_facts(h[..], "Linux", "/w", MK_COMMAND_SECONDS, o[..]) == "{\"os\":\"Linux\",\"app\":\"Coder in the terminal\",\"cwd\":\"/w\",\"command_seconds\":120}";
  for i: 0..<MK_TURNS + 2 {
    tb: [8] u8; tb[0] = cast(u8) ('a' + i);
    h[0].ncur = mk_keep(h[0].cur[..], cast(string) tb[0..<1]);
    mk_remember(h[..], "r");
  }
  #assert h[0].turns == MK_TURNS && mk_text(h[..], 0) == "c" && mk_text(h[..], 2 * MK_TURNS - 2) == "h";
  f := mk_facts(h[..], "Linux", "/w", 0, o[..]);
  #assert cl_count(cl_raw(f, "conversation")) == MK_TURNS;
}

#test "Vertex from antigravity.env: its project and location, the defaults without them; the model and its limits" {
  k: [1] MkKeys;
  agy := "# agy\nAGY_ADC_AUTH=1\nGOOGLE_APPLICATION_CREDENTIALS=/k/sa.json\nGOOGLE_CLOUD_PROJECT=p-test-only\nGOOGLE_CLOUD_LOCATION=us\n";
  mk_vertex_place(k[..], mk_env_value(agy, "GOOGLE_CLOUD_PROJECT"), mk_env_value(agy, "GOOGLE_CLOUD_LOCATION"));
  #assert k[0].vx[0].project == "p-test-only" && k[0].vx[0].location == "us" && mk_env_value(agy, "GOOGLE_APPLICATION_CREDENTIALS") == "/k/sa.json";
  #assert gw_vertex_native_url(k[0].vx[..], "gemini-4-argon") == "https://aiplatform.us.rep.googleapis.com/v1/projects/p-test-only/locations/us/publishers/google/models/gemini-4-argon:streamGenerateContent?alt=sse";
  mk_vertex_place(k[..], "", "");
  #assert k[0].vx[0].project == GW_VERTEX_PROJECT && k[0].vx[0].location == GW_VERTEX_LOCATION;
  #assert mk_vertex_model("gemini-4-carbon") == "gemini-4-carbon" && mk_vertex_model("google/gemini-4-argon") == "gemini-4-argon";
  #assert mk_vertex_model("") == "gemini-4-hydrogen" && mk_vertex_model("claude-sonnet-5-5") == "gemini-4-hydrogen";
  p: [1] GwPlan;
  mk_plan_limits(p[..], "low");
  #assert p[0].retries == MK_RETRIES && p[0].first_limit_ms == 90000 && p[0].idle_limit_ms == MK_IDLE_LIMIT_MS;
  #assert mk_first_limit_ms("medium") == 240000 && mk_first_limit_ms("high") == 290000 && mk_first_limit_ms("") == 90000;
}

#test "env files: export prefixes, quotes and carriage returns" {
  #assert mk_env_value("A=1\nexport KEY=\"v w\"\r\nB=2", "KEY") == "v w";
  #assert mk_env_value("KEYS=x\nKEY='y'", "KEY") == "y";
  #assert mk_env_value("OTHER=1", "KEY") == "";
}
