  #assert mk_auth_text(MK_VX_ADC, "p", 0, "", o[..]) == "vertex\tVertex AI (ADC, project p)";
  #assert mk_auth_text(MK_VX_NONE, "p", MK_KEY_SETTINGS, "1a2b", o[..]) == "key\tAPI key ending 1a2b (Settings)";
  #assert mk_auth_text(MK_VX_NONE, "p", MK_KEY_SECRETS, "9z9z", o[..]) == "key\tAPI key ending 9z9z (~/work/.secrets)";
  #assert mk_auth_text(MK_VX_NONE, "p", MK_KEY_ENV, "abcd", o[..]) == "key\tAPI key ending abcd (GEMINI_API_KEY)";
  #assert mk_auth_text(MK_VX_NONE, "p", 0, "", o[..]) == "none\t";
}

#test "local and active-goal guidance selection covers workspace boundaries, refusals, clean finish, and goal audit" {
  #assert mk_local_guidance(false, false) == "";
  lg_local := mk_local_guidance(true, false);
  lg_combo := mk_local_guidance(false, true);
  #assert lg_local == MK_LOCAL_GUIDANCE && lg_combo == MK_LOCAL_GUIDANCE;
  #assert ps_find(lg_local, "Workspace boundary") >= 0 && ps_find(lg_local, "refuse immediately") >= 0 && ps_find(lg_local, "commands:[], edits:[], view:[]") >= 0;

  #assert !mk_is_goal_task("Fix calc.py so python3 -m unittest passes.");
  #assert !mk_is_goal_task("Mention <goal_objective>\nfoo\n</goal_objective>\n without completion tag");
  #assert mk_goal_guidance("Fix calc.py") == "";

  goal_start := "<goal_objective>\nCreate todo.py\n</goal_objective>\nWork autonomously. Include [GOAL_COMPLETE] at the end of your reply.";
  #assert mk_is_goal_task(goal_start) && !mk_is_goal_audit(goal_start);
  #assert mk_goal_guidance(goal_start) == MK_GOAL_GUIDANCE && ps_find(mk_goal_guidance(goal_start), "[GOAL_COMPLETE]") >= 0;

  goal_audit := "<goal_objective>\nCreate todo.py\n</goal_objective>\nYou said the goal above is done. Before it closes, check the work as a skeptical reviewer. End with [GOAL_COMPLETE].";
  #assert mk_is_goal_task(goal_audit) && mk_is_goal_audit(goal_audit);
  #assert mk_goal_guidance(goal_audit) == MK_GOAL_AUDIT_GUIDANCE && ps_find(mk_goal_guidance(goal_audit), "gh issue view") >= 0 && ps_find(mk_goal_guidance(goal_audit), "[GOAL_COMPLETE]") >= 0;
}

#test "local Psionic model selection honors hybrid, peer, env, task model, then local fallback" {
  #assert mk_local_model_pick("hybrid-exec-v1", "peer-m", "env-m") == "hybrid-exec-v1";
  #assert mk_local_model_pick("inkling-2-mini", "peer-m", "env-m") == "peer-m";
  #assert mk_local_model_pick("inkling-2-mini", "", "env-m") == "env-m";
  #assert mk_local_model_pick("inkling-2-mini", "", "") == "inkling-2-mini";
  #assert mk_local_model_pick("", "", "") == "local";
}

#test "local anti-spin guard nudges verified audit turns and repeated passing checks without interfering with edits or failures" {
  g: [1] MkLocalGuard;
  audit := "<goal_objective>\nCreate todo.py\n</goal_objective>\nYou said the goal above is done. Before it closes, check the work as a skeptical reviewer. End with [GOAL_COMPLETE].";
  mk_lg_init(g[..], true, audit);
  // Step-0 seed commands are ignored.
  mk_lg_command(g[..], 0, "python3 -m unittest -v", 0, false);
  #assert mk_lg_note(g[..]) == "";
  // Step 1 on audit turn runs passing unittest -> immediate verification-passed note.
  mk_lg_command(g[..], 1, "cat SKILL.md", 0, false);
  mk_lg_command(g[..], 1, "python3 -m unittest -v", 0, false);
  #assert mk_lg_note(g[..]) == MK_NOTE_AUDIT_VERIFIED;
  // Step 2 re-runs passing unittest without edits -> repeat-check note.
  mk_lg_command(g[..], 2, "python3 -m unittest -v", 0, false);
  #assert mk_lg_note(g[..]) == MK_NOTE_GOAL_REPEAT;

  // Regular task: write+test step does not trigger; re-running same check without edits triggers; failure or edit resets cleanly.
  goal := "<goal_objective>\nCreate todo.py\n</goal_objective>\nInclude [GOAL_COMPLETE] at the end.";
  mk_lg_init(g[..], true, goal);
  mk_lg_command(g[..], 1, "cat > todo.py <<'EOF'\nEOF\npython3 -m unittest -v", 0, false);
  #assert mk_lg_note(g[..]) == "";
  mk_lg_command(g[..], 2, "python3 -m unittest", 0, false);
  #assert mk_lg_note(g[..]) == MK_NOTE_GOAL_REPEAT;
  mk_lg_command(g[..], 3, "edit todo.py", 0, false);
  mk_lg_command(g[..], 3, "python3 -m unittest", 0, false);
  #assert mk_lg_note(g[..]) == "";
  mk_lg_command(g[..], 4, "python3 -m unittest", 1, false);
  #assert mk_lg_note(g[..]) == "";

  // Non-goal local task: identical passing read command repeated twice breaks spin.
  mk_lg_init(g[..], true, "Write ready to notes.txt");
  mk_lg_command(g[..], 1, "cat notes.txt", 0, false);
  #assert mk_lg_note(g[..]) == "";
  mk_lg_command(g[..], 2, "cat notes.txt", 0, false);
  #assert mk_lg_note(g[..]) == MK_NOTE_LOCAL_REPEAT;
  // Inactive guard (cloud runs) never emits notes.
  mk_lg_init(g[..], false, audit);
  mk_lg_command(g[..], 1, "python3 -m unittest -v", 0, false);
  #assert mk_lg_note(g[..]) == "";
}
