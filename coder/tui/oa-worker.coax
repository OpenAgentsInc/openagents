// ---------------------------------------------------------------- basic helpers

fww_send :: (o: [] u8, n: int) {
  if n < 0 || n >= o.count { return; }
  o[n] = 10;
  _ = cxterm_write(o[0..<n + 1]);
}

fww_keep :: (dst: [] u8, s: string) -> int {
  n := ifx s.count < dst.count then s.count else dst.count;
  while n > 0 && n < s.count && (s[n] & 0xC0) == 0x80 { n -= 1; }
  for i: 0..<n { dst[i] = s[i]; }
  return n;
}

fww_cat :: (dst: [] u8, at: int, s: string) -> int {
  n := at;
  if n < 0 { return 0; }
  for c: s {
    if n >= dst.count { return n; }
    dst[n] = c; n += 1;
  }
  return n;
}

fww_put_int :: (dst: [] u8, at: int, v: int) -> int {
  n := at;
  if n < 0 || n >= dst.count { return n; }
  x := v;
  if x < 0 {
    dst[n] = '-'; n += 1;
    x = -x;
  }
  if x == 0 {
    if n < dst.count { dst[n] = '0'; n += 1; }
    return n;
  }
  tmp: [24] u8; k := 0;
  while x > 0 && k < 24 { tmp[k] = cast(u8) ('0' + x % 10); x /= 10; k += 1; }
  while k > 0 && n < dst.count { k -= 1; dst[n] = tmp[k]; n += 1; }
  return n;
}

fww_trim :: (s: string) -> string {
  a := 0; b := s.count;
  while a < b && (s[a] == ' ' || s[a] == '\t' || s[a] == '\r' || s[a] == '\n') { a += 1; }
  while b > a && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\r' || s[b - 1] == '\n') { b -= 1; }
  return cast(string) s[a..<b];
}

fww_parse_int :: (s: string, fallback: int) -> int {
  t := fww_trim(s);
  if t.count == 0 { return fallback; }
  v := 0;
  for c: t {
    if c < '0' || c > '9' { return fallback; }
    v = v * 10 + cast(int) (c - '0');
  }
  return v;
}

fww_env_int :: (name: string, fallback: int) -> int {
  b: [64] u8;
  s := cl_getenv(name, b[..]);
  if s.count == 0 { return fallback; }
  return fww_parse_int(s, fallback);
}

fww_env_bool :: (name: string, fallback: bool) -> bool {
  b: [32] u8;
  s := fww_trim(cl_getenv(name, b[..]));
  if s.count == 0 { return fallback; }
  if s == "1" || s == "true" || s == "on" || s == "yes" { return true; }
  if s == "0" || s == "false" || s == "off" || s == "no" { return false; }
  return fallback;
}

fww_poll_wait_ms :: (running: bool, polled: bool) -> int {
  if !running { return 200; }
  return ifx polled then 0 else 10;
}

// ---------------------------------------------------------------- runtime config (from Settings -> Flawed env)

FwConfig :: struct {
  backend_pref: int;          // FLAWED_BE_*
  model: [128] u8; nmodel: int;
  custom_model: [128] u8; ncustom_model: int;
  effort: [32] u8; neffort: int;
  thinking_mode: int;         // FLAWED_THINK_*
  thinking_hidden: bool;
  permission_mode: int;       // FLAWED_PMODE_*
  bypass_danger: bool;
  sandbox_mode: int;          // FLAWED_SANDBOX_*
  git_guard: bool;
  prompt_cache: int;          // FLAWED_CACHE_*
  auto_compact: bool;
  auto_memory: bool;
  bare_mode: bool;
  output_style: int;          // FLAWED_STYLE_*
  hooks_mode: int;            // FLAWED_HOOKS_*
  mcp_defer: bool;
  fast_mode: bool;
  extended_ctx: bool;
  remote_bridge: bool;
  max_turns: int;             // 0 = unlimited (capped at 64 safety)
  max_budget_micros: int;     // 0 = unlimited
  budget_s: int;              // 0 = no wall-clock pacing budget (set via FLAWED_BUDGET_S)
  bash_timeout_s: int;        // 0 = default 120s (harness sets 20s fast-fail)
  local_max_tokens: int;      // 0 = wire default (harness sets 6144 for local Inkling)
  base_url: [512] u8; nbase_url: int;
  allowed_tools: [512] u8; nallowed: int;
  disallowed_tools: [512] u8; ndisallowed: int;
  additional_dirs: [1024] u8; nadd_dirs: int;
}

fww_parse_permission_mode :: (pm: string) -> int {
  if pm == "ask" || pm == "default" { return FLAWED_PMODE_DEFAULT; }
  if pm == "accept_edits" || pm == "acceptEdits" { return FLAWED_PMODE_ACCEPT_EDITS; }
  if pm == "plan" { return FLAWED_PMODE_PLAN; }
  if pm == "auto" { return FLAWED_PMODE_AUTO; }
  if pm == "dont_ask" || pm == "dontAsk" { return FLAWED_PMODE_DONT_ASK; }
  return FLAWED_PMODE_BYPASS;
}

fww_getenv2 :: (primary: string, legacy: string, buf: [] u8) -> string {
  v := fww_trim(cl_getenv(primary, buf));
  if v.count > 0 { return v; }
  return fww_trim(cl_getenv(legacy, buf));
}

fww_env_int2 :: (primary: string, legacy: string, fallback: int) -> int {
  b: [64] u8;
  v := fww_getenv2(primary, legacy, b[..]);
  if v.count == 0 { return fallback; }
  return fww_parse_int(v, fallback);
}

fww_env_bool2 :: (primary: string, legacy: string, fallback: bool) -> bool {
  b: [64] u8;
  v := fww_getenv2(primary, legacy, b[..]);
  if v.count == 0 { return fallback; }
  if v == "1" || v == "true" || v == "yes" || v == "on" { return true; }
  if v == "0" || v == "false" || v == "no" || v == "off" { return false; }
  return fallback;
}

fww_load_config :: (cfg: [] FwConfig) {
  cfg[0] = FwConfig.{};
  b: [1024] u8;

  be := fww_getenv2("OA_AGENT_BACKEND", "FLAWED_BACKEND", b[..]);
  if be == "local" || be == "psionic" || be == "1" { cfg[0].backend_pref = FLAWED_BE_LOCAL; }
  else if be == "vertex" || be == "2" { cfg[0].backend_pref = FLAWED_BE_VERTEX; }
  else if be == "gemini" || be == "3" { cfg[0].backend_pref = FLAWED_BE_GEMINI; }
  else if be == "openrouter" || be == "4" { cfg[0].backend_pref = FLAWED_BE_OPENROUTER; }
  else { cfg[0].backend_pref = FLAWED_BE_AUTO; }

  m := fww_getenv2("OA_AGENT_MODEL", "FLAWED_MODEL", b[..]);
  cfg[0].nmodel = fww_keep(cfg[0].model[..], ifx m.count > 0 then m else "inkling-2-mini");
  cm := fww_getenv2("OA_AGENT_CUSTOM_MODEL", "FLAWED_CUSTOM_MODEL", b[..]);
  cfg[0].ncustom_model = fww_keep(cfg[0].custom_model[..], cm);

  ef := fww_getenv2("OA_AGENT_EFFORT", "FLAWED_EFFORT", b[..]);
  cfg[0].neffort = fww_keep(cfg[0].effort[..], ifx ef.count > 0 then ef else "high");

  tm := fww_getenv2("OA_AGENT_THINKING_MODE", "FLAWED_THINKING_MODE", b[..]);
  if tm == "extended" || tm == "1" { cfg[0].thinking_mode = FLAWED_THINK_EXTENDED; }
  else if tm == "off" || tm == "2" { cfg[0].thinking_mode = FLAWED_THINK_OFF; }
  else { cfg[0].thinking_mode = FLAWED_THINK_ADAPTIVE; }

  td := fww_getenv2("OA_AGENT_THINKING_DISPLAY", "FLAWED_THINKING_DISPLAY", b[..]);
  cfg[0].thinking_hidden = td == "omitted" || td == "hidden" || td == "1";

  pm := fww_getenv2("OA_AGENT_PERMISSION_MODE", "FLAWED_PERMISSION_MODE", b[..]);
  cfg[0].permission_mode = fww_parse_permission_mode(pm);

  cfg[0].bypass_danger = fww_env_bool2("OA_AGENT_BYPASS_PERMISSIONS", "FLAWED_BYPASS_PERMISSIONS", false);

  sb := fww_getenv2("OA_AGENT_SANDBOX_MODE", "FLAWED_SANDBOX_MODE", b[..]);
  if sb == "auto" || sb == "1" { cfg[0].sandbox_mode = FLAWED_SANDBOX_AUTO; }
  else if sb == "enforced" || sb == "2" { cfg[0].sandbox_mode = FLAWED_SANDBOX_ENFORCED; }
  else { cfg[0].sandbox_mode = FLAWED_SANDBOX_OFF; }

  cfg[0].git_guard = fww_env_bool2("OA_AGENT_GIT_GUARD", "FLAWED_GIT_GUARD", false);

  pc := fww_getenv2("OA_AGENT_PROMPT_CACHE", "FLAWED_PROMPT_CACHE", b[..]);
  if pc == "org" || pc == "1" { cfg[0].prompt_cache = FLAWED_CACHE_ORG; }
  else if pc == "off" || pc == "2" { cfg[0].prompt_cache = FLAWED_CACHE_OFF; }
  else { cfg[0].prompt_cache = FLAWED_CACHE_GLOBAL; }

  cfg[0].auto_compact = fww_env_bool2("OA_AGENT_AUTO_COMPACT", "FLAWED_AUTO_COMPACT", true);
  cfg[0].auto_memory = fww_env_bool2("OA_AGENT_AUTO_MEMORY", "FLAWED_AUTO_MEMORY", true);
  cfg[0].bare_mode = fww_env_bool2("OA_AGENT_BARE_MODE", "FLAWED_BARE_MODE", false);

  os_st := fww_getenv2("OA_AGENT_OUTPUT_STYLE", "FLAWED_OUTPUT_STYLE", b[..]);
  if os_st == "concise" || os_st == "1" { cfg[0].output_style = FLAWED_STYLE_CONCISE; }
  else if os_st == "explanatory" || os_st == "2" { cfg[0].output_style = FLAWED_STYLE_EXPLANATORY; }
  else if os_st == "learning" || os_st == "3" { cfg[0].output_style = FLAWED_STYLE_LEARNING; }
  else { cfg[0].output_style = FLAWED_STYLE_DEFAULT; }

  hm := fww_getenv2("OA_AGENT_HOOKS_MODE", "FLAWED_HOOKS_MODE", b[..]);
  if hm == "managed" || hm == "1" { cfg[0].hooks_mode = FLAWED_HOOKS_MANAGED; }
  else if hm == "off" || hm == "2" { cfg[0].hooks_mode = FLAWED_HOOKS_OFF; }
  else { cfg[0].hooks_mode = FLAWED_HOOKS_ALL; }

  cfg[0].mcp_defer = fww_env_bool2("OA_AGENT_MCP_DEFER", "FLAWED_MCP_DEFER", true);
  cfg[0].fast_mode = fww_env_bool2("OA_AGENT_FAST_MODE", "FLAWED_FAST_MODE", false);
  cfg[0].extended_ctx = fww_env_bool2("OA_AGENT_EXTENDED_CTX", "FLAWED_EXTENDED_CTX", false);
  cfg[0].remote_bridge = fww_env_bool2("OA_AGENT_REMOTE_BRIDGE", "FLAWED_REMOTE_BRIDGE", false);
  cfg[0].max_turns = fww_env_int2("OA_AGENT_MAX_TURNS", "FLAWED_MAX_TURNS", 0);
  cfg[0].max_budget_micros = fww_env_int2("OA_AGENT_MAX_BUDGET_MICROS", "FLAWED_MAX_BUDGET_MICROS", 0);
  cfg[0].budget_s = fww_env_int2("OA_AGENT_BUDGET_S", "FLAWED_BUDGET_S", 0);

  bu := fww_getenv2("OA_AGENT_BASE_URL", "FLAWED_BASE_URL", b[..]);
  cfg[0].nbase_url = fww_keep(cfg[0].base_url[..], bu);

  cfg[0].nallowed = fww_keep(cfg[0].allowed_tools[..], fww_getenv2("OA_AGENT_ALLOWED_TOOLS", "FLAWED_ALLOWED_TOOLS", b[..]));
  cfg[0].ndisallowed = fww_keep(cfg[0].disallowed_tools[..], fww_getenv2("OA_AGENT_DISALLOWED_TOOLS", "FLAWED_DISALLOWED_TOOLS", b[..]));
  cfg[0].nadd_dirs = fww_keep(cfg[0].additional_dirs[..], fww_getenv2("OA_AGENT_ADDITIONAL_DIRS", "FLAWED_ADDITIONAL_DIRS", b[..]));
}

// ---------------------------------------------------------------- secure credential resolution (never logged)

FWW_VX_TTL_MS :: 3000000;   // 50 minutes (Vertex tokens live 60 minutes)
FWW_GCLOUDS :: [5] string.["/google-cloud-sdk/bin/gcloud", "/.nix-profile/bin/gcloud", "/opt/homebrew/bin/gcloud", "/usr/local/bin/gcloud", "/run/current-system/sw/bin/gcloud"];
FWW_GCLOUDS_HOME :: 2;

FwAuth :: struct {
  ok: bool;
  backend: int;               // resolved FLAWED_BE_LOCAL / _VERTEX / _GEMINI / _OPENROUTER
  key: [4096] u8; nkey: int;
  vx_project: [128] u8; nvx_project: int;
  vx_location: [64] u8; nvx_location: int;
  vx_keyfile: [1200] u8; nvx_keyfile: int;
  vx_gcloud: [1200] u8; nvx_gcloud: int;
  vx_config: [1200] u8; nvx_config: int;
  vx_tok: [4096] u8; nvx_tok: int;
  vx_minted_ms: int;
  source: [64] u8; nsource: int;
  label: [160] u8; nlabel: int;
}

fww_read_trimmed_file :: (path: string, out: [] u8) -> int {
  if path.count == 0 || !fs_exists(path) { return 0; }
  raw: [4096] u8;
  n := fs_read(path, raw[..]);
  if n <= 0 { return 0; }
  t := fww_trim(cast(string) raw[0..<n]);
  r := fww_keep(out, t);
  for i: 0..<raw.count { raw[i] = 0; }
  return r;
}

fww_read_env_file_key :: (path: string, var_name: string, out: [] u8) -> int {
  if path.count == 0 || !fs_exists(path) { return 0; }
  raw: [8192] u8;
  n := fs_read(path, raw[..]);
  if n <= 0 { return 0; }
  s := cast(string) raw[0..<n];
  res := 0;
  i := 0;
  while i < s.count {
    e := i;
    while e < s.count && s[e] != '\n' { e += 1; }
    ln := fww_trim(cast(string) s[i..<e]);
    i = e + 1;
    if ln.count == 0 || ln[0] == '#' { continue; }
    if flawed_aw_starts(ln, "export ") { ln = fww_trim(cast(string) ln[7..<ln.count]); }
    if ln.count > var_name.count + 1 && flawed_aw_starts(ln, var_name) && ln[var_name.count] == '=' {
      val := fww_trim(cast(string) ln[var_name.count + 1..<ln.count]);
      if val.count >= 2 && ((val[0] == '"' && val[val.count - 1] == '"') || (val[0] == '\'' && val[val.count - 1] == '\'')) {
        val = cast(string) val[1..<val.count - 1];
      }
      res = fww_keep(out, val);
      break;
    }
  }
  for k: 0..<raw.count { raw[k] = 0; }
  return res;
}

fww_key_suffix_label :: (prefix: string, key: string, out: [] u8) -> int {
  n := fww_cat(out, 0, prefix);
  if key.count >= 4 {
    n = fww_cat(out, n, " (ends …");
    n = fww_cat(out, n, cast(string) key[key.count - 4..<key.count]);
    n = fww_cat(out, n, ")");
  }
  return n;
}

fww_token_valid :: (t: string) -> bool {
  if t.count < 20 { return false; }
  for c: t { if c < 33 || c > 126 { return false; } }
  return true;
}

// Discover Vertex AI project, location, keyfile, and gcloud binary (same discovery as microcoder_keys.coax).
fww_vertex_discover :: (home: string, auth: [] FwAuth) {
  b: [1200] u8;
  agy_p: [1400] u8;
  agy_path := ifx home.count > 0 then fs_join(home, ".openagents/coder/antigravity.env", agy_p[..]) else "";

  proj := fww_trim(cl_getenv("GOOGLE_CLOUD_PROJECT", b[..]));
  if proj.count == 0 && agy_path.count > 0 {
    pn := fww_read_env_file_key(agy_path, "GOOGLE_CLOUD_PROJECT", b[..]);
    if pn > 0 { proj = cast(string) b[0..<pn]; }
  }
  auth[0].nvx_project = fww_keep(auth[0].vx_project[..], ifx proj.count > 0 then proj else "openagentsgemini");

  loc := fww_trim(cl_getenv("GOOGLE_CLOUD_LOCATION", b[..]));
  if loc.count == 0 && agy_path.count > 0 {
    ln := fww_read_env_file_key(agy_path, "GOOGLE_CLOUD_LOCATION", b[..]);
    if ln > 0 { loc = cast(string) b[0..<ln]; }
  }
  auth[0].nvx_location = fww_keep(auth[0].vx_location[..], ifx loc.count > 0 then loc else "us");

  auth[0].nvx_keyfile = 0;
  env_kf := fww_trim(cl_getenv("GOOGLE_APPLICATION_CREDENTIALS", b[..]));
  if env_kf.count > 0 && fs_exists(env_kf) {
    auth[0].nvx_keyfile = fww_keep(auth[0].vx_keyfile[..], env_kf);
  }
  if auth[0].nvx_keyfile == 0 && agy_path.count > 0 {
    kn := fww_read_env_file_key(agy_path, "GOOGLE_APPLICATION_CREDENTIALS", b[..]);
    if kn > 0 && fs_exists(cast(string) b[0..<kn]) {
      auth[0].nvx_keyfile = fww_keep(auth[0].vx_keyfile[..], cast(string) b[0..<kn]);
    }
  }
  if auth[0].nvx_keyfile == 0 && home.count > 0 {
    kp: [1400] u8;
    def_kf := fs_join(home, "work/.secrets/vertex-sa-inference.json", kp[..]);
    if def_kf.count > 0 && fs_exists(def_kf) {
      auth[0].nvx_keyfile = fww_keep(auth[0].vx_keyfile[..], def_kf);
    }
  }

  auth[0].nvx_gcloud = 0;
  gclouds := FWW_GCLOUDS;
  for g, i: gclouds {
    gp: [1400] u8;
    n := ifx i < FWW_GCLOUDS_HOME then (ifx home.count > 0 then fww_cat(gp[..], fww_cat(gp[..], 0, home), g) else 0) else fww_cat(gp[..], 0, g);
    if n > 0 && fs_exists(cast(string) gp[0..<n]) {
      auth[0].nvx_gcloud = fww_keep(auth[0].vx_gcloud[..], cast(string) gp[0..<n]);
      break;
    }
  }
  auth[0].nvx_config = ifx home.count > 0 then fww_cat(auth[0].vx_config[..], fww_cat(auth[0].vx_config[..], 0, home), "/.cache/openagents/coder-gcloud") else 0;
}

fww_vertex_has_creds :: (auth: [] FwAuth) -> bool {
  tb: [64] u8;
  if fww_trim(cl_getenv("VERTEX_ACCESS_TOKEN", tb[..])).count >= 20 { return true; }
  return auth[0].nvx_keyfile > 0 && auth[0].nvx_gcloud > 0;
}

// Mint (or reuse 50-min cached) Vertex AI OAuth access token via env or gcloud SA keyfile.
fww_vertex_mint :: (auth: [] FwAuth) -> bool {
  now := proc_now_ms();
  if auth[0].nvx_tok > 0 && now - auth[0].vx_minted_ms < FWW_VX_TTL_MS { return true; }
  auth[0].nvx_tok = 0;

  tb: [4096] u8;
  env_t := fww_trim(cl_getenv("VERTEX_ACCESS_TOKEN", tb[..]));
  if fww_token_valid(env_t) {
    auth[0].nvx_tok = fww_keep(auth[0].vx_tok[..], env_t);
    auth[0].vx_minted_ms = now;
    return true;
  }
  if auth[0].nvx_keyfile == 0 || auth[0].nvx_gcloud == 0 { return false; }

  h := proc_new();
  if h < 0 { return false; }
  e1: [1400] u8; n1 := fww_cat(e1[..], fww_cat(e1[..], 0, "GOOGLE_APPLICATION_CREDENTIALS="), cast(string) auth[0].vx_keyfile[0..<auth[0].nvx_keyfile]);
  e2: [1400] u8; n2 := fww_cat(e2[..], fww_cat(e2[..], 0, "CLOUDSDK_CONFIG="), cast(string) auth[0].vx_config[0..<auth[0].nvx_config]);
  e3 := "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/run/current-system/sw/bin";
  ok := proc_arg(h, cast(string) auth[0].vx_gcloud[0..<auth[0].nvx_gcloud])
        && proc_arg(h, "auth") && proc_arg(h, "application-default") && proc_arg(h, "print-access-token")
        && proc_env(h, cast(string) e1[0..<n1])
        && proc_env(h, cast(string) e2[0..<n2])
        && proc_env(h, e3);
  if !ok || proc_start(h) != 0 { _ = proc_release(h); return false; }
  _ = proc_close_stdin(h);
  ln := proc_line(h, 25000, tb[..]);
  st := proc_wait(h, 2000);
  _ = proc_release(h);
  if st != 0 || ln <= 0 { return false; }
  tok := fww_trim(cast(string) tb[0..<ln]);
  if !fww_token_valid(tok) { return false; }
  auth[0].nvx_tok = fww_keep(auth[0].vx_tok[..], tok);
  auth[0].vx_minted_ms = proc_now_ms();
  return true;
}

fww_try_gemini_key :: (home: string, out_key: [] u8, src_out: [] u8, nsrc: [] int) -> int {
  b: [4096] u8;
  k := fww_getenv2("OA_AGENT_API_KEY", "FLAWED_API_KEY", b[..]);
  if k.count > 0 && !flawed_aw_starts(k, "sk-or-") { nsrc[0] = fww_keep(src_out, "agent_env"); return fww_keep(out_key, k); }
  if home.count > 0 {
    pb: [1024] u8;
    n := fww_read_trimmed_file(fs_join(home, "Library/Application Support/Coder/agent-key", pb[..]), out_key);
    if n > 0 && !flawed_aw_starts(cast(string) out_key[0..<n], "sk-or-") { nsrc[0] = fww_keep(src_out, "agent_key"); return n; }
    n = fww_read_trimmed_file(fs_join(home, "Library/Application Support/Coder/flawed-key", pb[..]), out_key);
    if n > 0 && !flawed_aw_starts(cast(string) out_key[0..<n], "sk-or-") { nsrc[0] = fww_keep(src_out, "agent_key"); return n; }
    n = fww_read_trimmed_file(fs_join(home, "Library/Application Support/Coder/gemini-key", pb[..]), out_key);
    if n > 0 { nsrc[0] = fww_keep(src_out, "gemini_key"); return n; }
    n = fww_read_env_file_key(fs_join(home, "work/.secrets/openagents-gemini-provider.env", pb[..]), "GEMINI_API_KEY", out_key);
    if n > 0 { nsrc[0] = fww_keep(src_out, "gemini_secrets"); return n; }
  }
  k = fww_trim(cl_getenv("GEMINI_API_KEY", b[..]));
  if k.count > 0 { nsrc[0] = fww_keep(src_out, "gemini_env"); return fww_keep(out_key, k); }
  return 0;
}

fww_try_openrouter_key :: (home: string, out_key: [] u8) -> int {
  b: [4096] u8;
  k := fww_trim(cl_getenv("OPENROUTER_API_KEY", b[..]));
  if k.count > 0 { return fww_keep(out_key, k); }
  if home.count > 0 {
    pb: [1024] u8;
    n := fww_read_trimmed_file(fs_join(home, "Library/Application Support/Coder/agent-key", pb[..]), out_key);
    if n > 0 && flawed_aw_starts(cast(string) out_key[0..<n], "sk-or-") { return n; }
    n = fww_read_trimmed_file(fs_join(home, "Library/Application Support/Coder/flawed-key", pb[..]), out_key);
    if n > 0 && flawed_aw_starts(cast(string) out_key[0..<n], "sk-or-") { return n; }
    n = fww_read_trimmed_file(fs_join(home, "Library/Application Support/Coder/openrouter-key", pb[..]), out_key);
    if n > 0 { return n; }
    n = fww_read_env_file_key(fs_join(home, "work/.secrets/openrouter.env", pb[..]), "OPENROUTER_API_KEY", out_key);
    if n > 0 { return n; }
  }
  return 0;
}

fww_local_reachable :: (local_base: string) -> bool {
  ub: [512] u8;
  b := flawed_aw_trim_slash(ifx local_base.count > 0 then local_base else "http://127.0.0.1:8080");
  n := fww_cat(ub[..], 0, b);
  n = fww_cat(ub[..], n, "/v1/models");
  h := proc_new();
  if h < 0 { return false; }
  ok := proc_arg(h, "curl") && proc_arg(h, "-sf") && proc_arg(h, "--connect-timeout") && proc_arg(h, "1") && proc_arg(h, "--max-time") && proc_arg(h, "2") && proc_arg(h, cast(string) ub[0..<n]);
  if !ok || proc_start(h) != 0 { _ = proc_release(h); return false; }
  _ = proc_close_stdin(h);
  st := proc_wait(h, 2500);
  _ = proc_release(h);
  return st == 0;
}

fww_local_installed :: (home: string) -> bool {
  if home.count == 0 { return false; }
  pb: [1024] u8;
  return fs_exists(fs_join(home, ".openagents/models/inkling-2-mini", pb[..]))
      || fs_exists(fs_join(home, ".openagents/models/inkling-2-mini-uncensored-lora", pb[..]))
      || fs_exists(fs_join(home, ".openagents/models/inkling-2-mini-uncensored-q4k", pb[..]))
      || fs_exists(fs_join(home, ".openagents/models/inkling-2-mini-uncensored-iq3s", pb[..]))
      || fs_exists(fs_join(home, ".openagents/models/inkling-2-mini-uncensored-iq2m", pb[..]))
      || fs_exists(fs_join(home, ".openagents/models/inkling-2-mini-abliterated-mix16g", pb[..]))
      || fs_exists(fs_join(home, ".openagents/models/inkling-2-mini-abliterated-mix12g", pb[..]))
      || fs_exists(fs_join(home, ".openagents/models/inkling-2-mini-custom", pb[..]));
}

fww_local_variant_short :: (pm: string) -> string {
  if pm == "inkling-2-mini-uncensored-lora" { return "Uncensored LoRA"; }
  if pm == "inkling-2-mini-uncensored-maple" { return "Uncensored (Maple)"; }
  if pm == "inkling-2-mini-uncensored-q4k" { return "Uncensored AD-Q4_K"; }
  if pm == "inkling-2-mini-uncensored-iq3s" { return "Uncensored AD-IQ3_S"; }
  if pm == "inkling-2-mini-uncensored-iq2m" { return "Uncensored AD-IQ2_M"; }
  if pm == "inkling-2-mini-abliterated-mix16g" { return "Abliterated Mix-16G"; }
  if pm == "inkling-2-mini-abliterated-mix12g" { return "Abliterated Mix-12G"; }
  if pm == "inkling-2-mini-custom" { return "Custom Local .gguf"; }
  if pm == "inkling-2-mini" { return "Official IQ4_NL"; }
  return pm;
}

fww_cat_local_label :: (out: [] u8, at: int) -> int {
  n := fww_cat(out, at, "Local Psionic");
  pb: [128] u8;
  pm := fww_trim(cl_getenv("PSIONIC_MODEL", pb[..]));
  if pm.count > 0 {
    n = fww_cat(out, n, " (");
    n = fww_cat(out, n, fww_local_variant_short(pm));
    n = fww_cat(out, n, ")");
  }
  return n;
}

fww_vertex_label :: (auth: [] FwAuth, out: [] u8) -> int {
  n := fww_cat(out, 0, "Vertex AI (project ");
  n = fww_cat(out, n, cast(string) auth[0].vx_project[0..<auth[0].nvx_project]);
  n = fww_cat(out, n, ")");
  return n;
}

// Model-aware credential & backend resolution (Local Psionic Metal, Vertex AI, Gemini API, OpenRouter — zero Anthropic).
// Keeps cached Vertex OAuth token intact across turns.
fww_resolve_auth :: (cfg: [] FwConfig, home: string, req_model: string, auth: [] FwAuth, probe_only: bool) {
  // Preserve cached Vertex token across refreshes
  saved_tok: [4096] u8;
  saved_nt := auth[0].nvx_tok;
  saved_ms := auth[0].vx_minted_ms;
  if saved_nt > 0 { for i: 0..<saved_nt { saved_tok[i] = auth[0].vx_tok[i]; } }

  auth[0] = FwAuth.{};
  if saved_nt > 0 {
    for i: 0..<saved_nt { auth[0].vx_tok[i] = saved_tok[i]; }
    auth[0].nvx_tok = saved_nt;
    auth[0].vx_minted_ms = saved_ms;
  }

  fww_vertex_discover(home, auth);
  rb: [256] u8;
  replaying := cl_getenv("GW_REPLAY", rb[..]).count > 0;
  pref := cfg[0].backend_pref;
  lbase_b: [512] u8;
  lbase := fww_trim(cl_getenv("PSIONIC_BASE_URL", lbase_b[..]));

  // Probe summary for --auth in Settings -> Flawed
  if probe_only && pref == FLAWED_BE_AUTO {
    has_local := fww_local_installed(home) || fww_local_reachable(lbase);
    has_vx := fww_vertex_has_creds(auth);
    src_b: [32] u8; nsrc := [1] int.[0];
    gm_b: [256] u8; gm_n := fww_try_gemini_key(home, gm_b[..], src_b[..], nsrc[..]);
    or_b: [256] u8; or_n := fww_try_openrouter_key(home, or_b[..]);
    n := 0;
    if has_local {
      n = fww_cat_local_label(auth[0].label[..], n);
      auth[0].ok = true;
      auth[0].backend = FLAWED_BE_LOCAL;
      auth[0].nsource = fww_keep(auth[0].source[..], "local");
    }
    if has_vx {
      if n > 0 { n = fww_cat(auth[0].label[..], n, " · "); }
      n = fww_cat(auth[0].label[..], n, "Vertex AI (");
      n = fww_cat(auth[0].label[..], n, cast(string) auth[0].vx_project[0..<auth[0].nvx_project]);
      n = fww_cat(auth[0].label[..], n, ")");
      auth[0].ok = true;
      if !has_local { auth[0].backend = FLAWED_BE_VERTEX; auth[0].nsource = fww_keep(auth[0].source[..], "vertex"); }
    } else if gm_n > 0 {
      if n > 0 { n = fww_cat(auth[0].label[..], n, " · "); }
      n = fww_cat(auth[0].label[..], n, "Gemini API");
      auth[0].ok = true;
      if !has_local { auth[0].backend = FLAWED_BE_GEMINI; auth[0].nsource = fww_keep(auth[0].source[..], "gemini"); }
    } else if or_n > 0 {
      if n > 0 { n = fww_cat(auth[0].label[..], n, " · "); }
      n = fww_cat(auth[0].label[..], n, "OpenRouter");
      auth[0].ok = true;
      if !has_local { auth[0].backend = FLAWED_BE_OPENROUTER; auth[0].nsource = fww_keep(auth[0].source[..], "openrouter"); }
    }
    if n > 0 { auth[0].nlabel = n; return; }
    auth[0].nsource = fww_keep(auth[0].source[..], "none");
    auth[0].nlabel = fww_keep(auth[0].label[..], "Install Inkling 2 Mini or configure Vertex AI / Gemini API");
    return;
  }

  wants_local := pref == FLAWED_BE_LOCAL || (pref == FLAWED_BE_AUTO && flawed_wire_is_local_model(req_model));
  if wants_local {
    if replaying || probe_only && fww_local_installed(home) || fww_local_reachable(lbase) {
      auth[0].ok = true;
      auth[0].backend = FLAWED_BE_LOCAL;
      auth[0].nsource = fww_keep(auth[0].source[..], "local");
      auth[0].nlabel = fww_cat_local_label(auth[0].label[..], 0);
      return;
    }
    auth[0].nsource = fww_keep(auth[0].source[..], "local_offline");
    auth[0].nlabel = fww_keep(auth[0].label[..], "Local Psionic server not running (start Inkling 2 Mini or switch to Gemini 4 Neon)");
    return;
  }

  if pref == FLAWED_BE_VERTEX {
    if replaying || (probe_only && fww_vertex_has_creds(auth)) || (!probe_only && fww_vertex_mint(auth)) {
      auth[0].ok = true;
      auth[0].backend = FLAWED_BE_VERTEX;
      auth[0].nkey = fww_keep(auth[0].key[..], cast(string) auth[0].vx_tok[0..<auth[0].nvx_tok]);
      auth[0].nsource = fww_keep(auth[0].source[..], "vertex");
      auth[0].nlabel = fww_vertex_label(auth, auth[0].label[..]);
      return;
    }
    auth[0].nsource = fww_keep(auth[0].source[..], "none");
    auth[0].nlabel = fww_keep(auth[0].label[..], "No Vertex AI credentials found (check gcloud & service account)");
    return;
  }

  if pref == FLAWED_BE_GEMINI {
    src_b: [32] u8; nsrc := [1] int.[0];
    kn := fww_try_gemini_key(home, auth[0].key[..], src_b[..], nsrc[..]);
    if kn > 0 || replaying {
      auth[0].ok = true;
      auth[0].backend = FLAWED_BE_GEMINI;
      auth[0].nkey = kn;
      auth[0].nsource = fww_keep(auth[0].source[..], ifx nsrc[0] > 0 then cast(string) src_b[0..<nsrc[0]] else "gemini");
      auth[0].nlabel = fww_key_suffix_label("Gemini API key", cast(string) auth[0].key[0..<kn], auth[0].label[..]);
      return;
    }
    auth[0].nsource = fww_keep(auth[0].source[..], "none");
    auth[0].nlabel = fww_keep(auth[0].label[..], "No Gemini API key configured (add in Settings → Agent)");
    return;
  }

  if pref == FLAWED_BE_OPENROUTER {
    kn := fww_try_openrouter_key(home, auth[0].key[..]);
    if kn > 0 || replaying {
      auth[0].ok = true;
      auth[0].backend = FLAWED_BE_OPENROUTER;
      auth[0].nkey = kn;
      auth[0].nsource = fww_keep(auth[0].source[..], "openrouter");
      auth[0].nlabel = fww_key_suffix_label("OpenRouter", cast(string) auth[0].key[0..<kn], auth[0].label[..]);
      return;
    }
    auth[0].nsource = fww_keep(auth[0].source[..], "none");
    auth[0].nlabel = fww_keep(auth[0].label[..], "No OpenRouter API key configured");
    return;
  }

  // Auto cloud routing (for Gemini 4 Neon / Carbon / Hydrogen / Argon):
  // 1. Vertex AI (service account / ADC / VERTEX_ACCESS_TOKEN)
  if fww_vertex_has_creds(auth) && (probe_only || fww_vertex_mint(auth)) {
    auth[0].ok = true;
    auth[0].backend = FLAWED_BE_VERTEX;
    auth[0].nkey = fww_keep(auth[0].key[..], cast(string) auth[0].vx_tok[0..<auth[0].nvx_tok]);
    auth[0].nsource = fww_keep(auth[0].source[..], "vertex");
    auth[0].nlabel = fww_vertex_label(auth, auth[0].label[..]);
    return;
  }
  // 2. Gemini API key
  src_b: [32] u8; nsrc := [1] int.[0];
  kn := fww_try_gemini_key(home, auth[0].key[..], src_b[..], nsrc[..]);
  if kn > 0 {
    auth[0].ok = true;
    auth[0].backend = FLAWED_BE_GEMINI;
    auth[0].nkey = kn;
    auth[0].nsource = fww_keep(auth[0].source[..], cast(string) src_b[0..<nsrc[0]]);
    auth[0].nlabel = fww_key_suffix_label("Gemini API key", cast(string) auth[0].key[0..<kn], auth[0].label[..]);
    return;
  }
  // 3. OpenRouter key
  kn = fww_try_openrouter_key(home, auth[0].key[..]);
  if kn > 0 {
    auth[0].ok = true;
    auth[0].backend = FLAWED_BE_OPENROUTER;
    auth[0].nkey = kn;
    auth[0].nsource = fww_keep(auth[0].source[..], "openrouter");
    auth[0].nlabel = fww_key_suffix_label("OpenRouter", cast(string) auth[0].key[0..<kn], auth[0].label[..]);
    return;
  }
  // 4. Auto compute fallback to local Psionic Metal when no cloud credentials are configured
  rm := flawed_wire_strip_model(req_model);
  if pref == FLAWED_BE_AUTO && (rm == "auto" || rm.count == 0) {
    if (probe_only && fww_local_installed(home)) || fww_local_reachable(lbase) {
      auth[0].ok = true;
      auth[0].backend = FLAWED_BE_LOCAL;
      auth[0].nsource = fww_keep(auth[0].source[..], "local");
      auth[0].nlabel = fww_cat_local_label(auth[0].label[..], 0);
      return;
    }
  }
  // 5. Replay fallback
  if replaying {
    auth[0].ok = true;
    auth[0].backend = FLAWED_BE_VERTEX;
    auth[0].nsource = fww_keep(auth[0].source[..], "replay");
    auth[0].nlabel = fww_keep(auth[0].label[..], "Replay");
    return;
  }
  auth[0].nsource = fww_keep(auth[0].source[..], "none");
  auth[0].nlabel = fww_keep(auth[0].label[..], "No Vertex AI or Gemini API credentials configured (open Settings → Agent)");
}

// ---------------------------------------------------------------- conversation history (zero-heap slab)

FwBlock :: struct {
  kind: int;
  id_at: int; id_n: int;
  name_at: int; name_n: int;
  text_at: int; text_n: int;
  sig_at: int; sig_n: int;
  img_mime_at: int; img_mime_n: int;
  img_at: int; img_n: int;
  is_error: bool;
}

FwMsg :: struct {
  role: int;
  blocks: [FWW_MAX_BLOCKS] FwBlock;
  nblocks: int;
}

FwHist :: struct {
  msgs: [FWW_MAX_MSGS] FwMsg;
  nmsgs: int;
  slab: [FWW_SLAB] u8;
  nslab: int;
  total_in: int;
  total_out: int;
  total_cached: int;
  total_cost_micros: int;
  last_in_tok: int;
  last_in_bytes: int;
  last_cached_tok: int;
  last_cloud_turn_ms: int;
  compact_count: int;
}

fww_slab_put :: (h: [] FwHist, s: string, out_at: [] int) -> int {
  if s.count == 0 { out_at[0] = 0; return 0; }
  avail := h[0].slab.count - h[0].nslab;
  if avail <= 0 { out_at[0] = 0; return 0; }
  n := ifx s.count < avail then s.count else avail;
  while n > 0 && n < s.count && (s[n] & 0xC0) == 0x80 { n -= 1; }
  at := h[0].nslab;
  for i: 0..<n { h[0].slab[at + i] = s[i]; }
  h[0].nslab += n;
  out_at[0] = at;
  return n;
}

fww_slab_str :: (h: [] FwHist, at: int, n: int) -> string {
  if n <= 0 || at < 0 || at + n > h[0].slab.count { return ""; }
  return cast(string) h[0].slab[at..<at + n];
}

fww_hist_clear :: (h: [] FwHist) {
  h[0].nmsgs = 0;
  h[0].nslab = 0;
  h[0].last_in_tok = 0;
  h[0].last_in_bytes = 0;
  h[0].total_in = 0;
  h[0].total_out = 0;
  h[0].total_cached = 0;
  h[0].total_cost_micros = 0;
  h[0].compact_count = 0;
  h[0].last_cached_tok = 0;
}

fww_hist_push_user :: (h: [] FwHist, text: string) {
  if h[0].nmsgs >= FWW_MAX_MSGS { return; }
  m := h[0].nmsgs;
  h[0].msgs[m] = FwMsg.{role = FWW_MROLE_USER};
  at := [1] int.[0];
  n := fww_slab_put(h, text, at[..]);
  h[0].msgs[m].blocks[0] = FwBlock.{kind = FWW_MB_TEXT, text_at = at[0], text_n = n};
  h[0].msgs[m].nblocks = 1;
  h[0].nmsgs += 1;
}

fww_hist_push_assistant_text :: (h: [] FwHist, text: string) {
  if h[0].nmsgs >= FWW_MAX_MSGS { return; }
  m := h[0].nmsgs;
  h[0].msgs[m] = FwMsg.{role = FWW_MROLE_ASSISTANT};
  at := [1] int.[0];
  n := fww_slab_put(h, text, at[..]);
  h[0].msgs[m].blocks[0] = FwBlock.{kind = FWW_MB_TEXT, text_at = at[0], text_n = n};
  h[0].msgs[m].nblocks = 1;
  h[0].nmsgs += 1;
}

// UTF-8 safe prefix length <= max_b.
fww_utf8_cut :: (s: string, max_b: int) -> int {
  if max_b <= 0 { return 0; }
  n := ifx s.count < max_b then s.count else max_b;
  while n > 0 && n < s.count && (s[n] & 0xC0) == 0x80 { n -= 1; }
  return n;
}

// UTF-8 safe suffix start >= s.count - max_b.
fww_utf8_tail_start :: (s: string, max_b: int) -> int {
  if max_b <= 0 || max_b >= s.count { return ifx max_b <= 0 then s.count else 0; }
  at := s.count - max_b;
  while at < s.count && (s[at] & 0xC0) == 0x80 { at += 1; }
  return at;
}

// Writes src into dst[at..], compacting middle with head+tail marker when src.count > max_b.
fww_shrink_head_tail :: (dst: [] u8, at: int, src: string, max_b: int, tag: string) -> int {
  if max_b <= 0 || src.count <= max_b { return fww_cat(dst, at, src); }
  if max_b < 160 {
    k := fww_utf8_cut(src, max_b);
    return fww_cat(dst, at, cast(string) src[0..<k]);
  }
  budget := max_b - 96;
  head_b := (budget * 7) / 10;
  tail_b := budget - head_b;
  hc := fww_utf8_cut(src, head_b);
  ts := fww_utf8_tail_start(src, tail_b);
  if ts <= hc { return fww_cat(dst, at, src); }
  omitted := ts - hc;
  n := fww_cat(dst, at, cast(string) src[0..<hc]);
  n = fww_cat(dst, n, "\n... [");
  n = fww_cat(dst, n, tag);
  n = fww_cat(dst, n, " ");
  n = fww_put_int(dst, n, omitted);
  n = fww_cat(dst, n, " bytes] ...\n");
  n = fww_cat(dst, n, cast(string) src[ts..<src.count]);
  return n;
}

// Case-insensitive ASCII substring search.
fww_contains_ci :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  if needle.count > hay.count { return false; }
  lim := hay.count - needle.count + 1;
  for i: 0..<lim {
    ok := true;
    for j: 0..<needle.count {
      a := hay[i + j]; b := needle[j];
      if a >= 'A' && a <= 'Z' { a += 32; }
      if b >= 'A' && b <= 'Z' { b += 32; }
      if a != b { ok = false; break; }
    }
    if ok { return true; }
  }
  return false;
}

// Detects context-length / prompt-too-long errors across Psionic, OpenAI, Vertex/Gemini, and OpenRouter.
fww_is_context_overflow_err :: (msg: string) -> bool {
  if msg.count == 0 { return false; }
  return fww_contains_ci(msg, "context length")
      || fww_contains_ci(msg, "context_length_exceeded")
      || fww_contains_ci(msg, "too long")
      || fww_contains_ci(msg, "maximum context")
      || fww_contains_ci(msg, "token limit")
      || fww_contains_ci(msg, "exceeds the maximum")
      || fww_contains_ci(msg, "exceeded the context");
}

// Detects transient mid-stream SSE errors (e.g. Gemini HTTP 200 stream ending with 503/UNAVAILABLE
// "high demand" or 429 rate-limit JSON) so Ch 05 exponential backoff retries instead of hard-failing.
fww_is_transient_sse_err :: (msg: string) -> bool {
  if msg.count == 0 { return false; }
  return fww_contains_ci(msg, "high demand")
      || fww_contains_ci(msg, "overloaded")
      || fww_contains_ci(msg, "unavailable")
      || fww_contains_ci(msg, "temporarily")
      || fww_contains_ci(msg, "try again")
      || fww_contains_ci(msg, "rate limit")
      || fww_contains_ci(msg, "resource exhausted")
      || fww_contains_ci(msg, "resource_exhausted")
      || fww_contains_ci(msg, "internal error")
      || fww_contains_ci(msg, "deadline exceeded");
}

// Extracts N from "...context length is N..." when reported by server (0 if absent).
fww_parse_ctx_limit_from_err :: (msg: string) -> int {
  key := "context length is ";
  if msg.count <= key.count { return 0; }
  lim := msg.count - key.count;
  for i: 0..<lim {
    ok := true;
    for j: 0..<key.count {
      a := msg[i + j];
      if a >= 'A' && a <= 'Z' { a += 32; }
      if a != key[j] { ok = false; break; }
    }
    if !ok { continue; }
    p := i + key.count;
    v := 0; digits := 0;
    while p < msg.count && msg[p] >= '0' && msg[p] <= '9' && digits < 8 {
      v = v * 10 + cast(int) (msg[p] - '0');
      p += 1; digits += 1;
    }
    if digits > 0 { return v; }
  }
  return 0;
}

// Estimates serialized prompt bytes matching what fww_build_openai_body / fww_build_gemini_body actually send.
fww_estimate_prompt_bytes :: (h: [] FwHist, sys_n: int, is_local: bool, no_tools: bool) -> int {
  total := sys_n + (ifx no_tools then 256 else 5600);
  for i: 0..<h[0].nmsgs {
    msg := h[0].msgs[i];
    total += 96;
    for b: 0..<msg.nblocks {
      bk := msg.blocks[b];
      if bk.kind == FWW_MB_THINK {
        if !is_local || i + 2 < h[0].nmsgs { continue; }
      }
      total += bk.id_n + bk.name_n + bk.text_n + 48;
      if !is_local {
        total += bk.sig_n;
        if bk.img_n > 0 { total += bk.img_mime_n + bk.img_n + 128; }
      }
    }
  }
  return total;
}

// Conservative token estimate (~3 B/tok for text/code, ~1600 tok per attached image), calibrated upward against server-reported prompt_tokens.
fww_estimate_prompt_tokens :: (h: [] FwHist, sys_n: int, is_local: bool, no_tools: bool) -> int {
  text_bytes := sys_n + (ifx no_tools then 256 else 5600);
  img_tokens := 0;
  for i: 0..<h[0].nmsgs {
    msg := h[0].msgs[i];
    text_bytes += 96;
    for b: 0..<msg.nblocks {
      bk := msg.blocks[b];
      if bk.kind == FWW_MB_THINK {
        if !is_local || i + 2 < h[0].nmsgs { continue; }
      }
      text_bytes += bk.id_n + bk.name_n + bk.text_n + 48;
      if !is_local {
        text_bytes += bk.sig_n;
        if bk.img_n > 0 { img_tokens += 1600; }
      }
    }
  }
  est := (text_bytes + 2) / 3 + img_tokens;
  if h[0].last_in_tok > 0 {
    bytes := fww_estimate_prompt_bytes(h, sys_n, is_local, no_tools);
    delta := bytes - h[0].last_in_bytes;
    cal := h[0].last_in_tok + (ifx delta > 0 then (delta + 2) / 3 else delta / 4);
    if cal > est { est = cal; }
  }
  return est;
}

// Finds active user request text inside msgs[0..<limit], unwrapping any prior compaction header so the goal is never lost.
fww_find_active_user_goal :: (h: [] FwHist, limit: int) -> string {
  marker := "Current user request:\n";
  i := limit - 1;
  while i >= 0 {
    if h[0].msgs[i].role == FWW_MROLE_USER && h[0].msgs[i].nblocks > 0 {
      txt := fww_slab_str(h, h[0].msgs[i].blocks[0].text_at, h[0].msgs[i].blocks[0].text_n);
      if txt.count > 0 {
        if !flawed_aw_starts(txt, "[Compacted earlier") { return txt; }
        if txt.count > marker.count {
          mlim := txt.count - marker.count;
          for p: 0..<mlim {
            ok := true;
            for j: 0..<marker.count { if txt[p + j] != marker[j] { ok = false; break; } }
            if ok { return cast(string) txt[p + marker.count..<txt.count]; }
          }
        }
        return txt;
      }
    }
    i -= 1;
  }
  return "";
}

// Unified multi-layer compaction engine (microcompact old tool results, intra-turn full compaction, & emergency trim).
//   drop_to_tail: 0 = microcompact/trim in-place without dropping messages; >0 = keep at most drop_to_tail tail msgs; -1 = collapse ALL msgs into 1 summary USER msg.
//   keep_recent_tools: number of newest TOOL_RESULTS messages exempt from old_tool_cap.
//   old_tool_cap: max bytes for older TOOL_RES blocks (0 = no cap).
//   recent_block_cap: max bytes for kept TOOL_RES / TEXT blocks (0 = no cap).
//   max_sum_bytes: max bytes for compacted summary header (0 = default 10240).
fww_hist_compact_ex :: (h: [] FwHist, drop_to_tail: int, keep_recent_tools: int, old_tool_cap: int, recent_block_cap: int, max_sum_bytes: int, tmp_buf: [] u8) -> bool {
  if h[0].nmsgs <= 0 { return false; }
  old_nslab := h[0].nslab;
  old_nmsgs := h[0].nmsgs;

  keep_from := 0;
  if drop_to_tail < 0 {
    keep_from = h[0].nmsgs;
  } else if drop_to_tail > 0 {
    if h[0].nmsgs <= drop_to_tail { return false; }
    keep_from = h[0].nmsgs - drop_to_tail;
    // Never leave an orphaned TOOL_RESULTS message at index 0 of kept tail: step back to include its ASSISTANT tool_use!
    if keep_from > 0 && keep_from < h[0].nmsgs && h[0].msgs[keep_from].role == FWW_MROLE_TOOL_RESULTS {
      keep_from -= 1;
    }
    if keep_from <= 0 { return false; }
  }

  sum_cap := ifx max_sum_bytes > 0 then max_sum_bytes else 10240;
  if sum_cap > tmp_buf.count / 3 { sum_cap = tmp_buf.count / 3; }
  sum_n := 0;

  if keep_from > 0 {
    goal := fww_find_active_user_goal(h, keep_from);
    goal_cap := ifx sum_cap >= 4096 then 2400 else sum_cap / 2;
    body_lim := sum_cap - (ifx goal.count > 0 then (ifx goal.count < goal_cap then goal.count else goal_cap) + 64 else 0);
    if body_lim < 512 { body_lim = 512; }

    sum_n = fww_cat(tmp_buf, 0, "[Compacted earlier conversation context — ");
    sum_n = fww_put_int(tmp_buf, sum_n, keep_from);
    sum_n = fww_cat(tmp_buf, sum_n, " earlier messages summarized]\n");
    for i: 0..<keep_from {
      if sum_n + 160 >= body_lim { break; }
      msg := h[0].msgs[i];
      if msg.role == FWW_MROLE_USER {
        sum_n = fww_cat(tmp_buf, sum_n, "User: ");
        for b: 0..<msg.nblocks {
          bk := msg.blocks[b];
          if bk.kind == FWW_MB_TEXT && bk.text_n > 0 {
            txt := fww_slab_str(h, bk.text_at, bk.text_n);
            take := fww_utf8_cut(txt, 220);
            sum_n = fww_cat(tmp_buf, sum_n, cast(string) txt[0..<take]);
            break;
          }
        }
        sum_n = fww_cat(tmp_buf, sum_n, "\n");
      } else if msg.role == FWW_MROLE_ASSISTANT {
        sum_n = fww_cat(tmp_buf, sum_n, "Assistant: ");
        wrote := false;
        for b: 0..<msg.nblocks {
          if sum_n + 120 >= body_lim { break; }
          bk := msg.blocks[b];
          if bk.kind == FWW_MB_TEXT && bk.text_n > 0 {
            txt := fww_slab_str(h, bk.text_at, bk.text_n);
            take := fww_utf8_cut(txt, 220);
            sum_n = fww_cat(tmp_buf, sum_n, cast(string) txt[0..<take]);
            sum_n = fww_cat(tmp_buf, sum_n, " ");
            wrote = true;
          } else if bk.kind == FWW_MB_TOOL_USE {
            nm := fww_slab_str(h, bk.name_at, bk.name_n);
            ag := fww_slab_str(h, bk.text_at, bk.text_n);
            take := fww_utf8_cut(ag, 96);
            sum_n = fww_cat(tmp_buf, sum_n, "[");
            sum_n = fww_cat(tmp_buf, sum_n, nm);
            sum_n = fww_cat(tmp_buf, sum_n, "(");
            sum_n = fww_cat(tmp_buf, sum_n, cast(string) ag[0..<take]);
            sum_n = fww_cat(tmp_buf, sum_n, ")] ");
            wrote = true;
          }
        }
        if !wrote { sum_n = fww_cat(tmp_buf, sum_n, "(step)"); }
        sum_n = fww_cat(tmp_buf, sum_n, "\n");
      } else if msg.role == FWW_MROLE_TOOL_RESULTS {
        for b: 0..<msg.nblocks {
          if sum_n + 120 >= body_lim { break; }
          bk := msg.blocks[b];
          if bk.kind == FWW_MB_TOOL_RES {
            nm := fww_slab_str(h, bk.name_at, bk.name_n);
            res := fww_slab_str(h, bk.text_at, bk.text_n);
            take := fww_utf8_cut(res, 140);
            sum_n = fww_cat(tmp_buf, sum_n, "ToolResult(");
            sum_n = fww_cat(tmp_buf, sum_n, ifx nm.count > 0 then nm else "tool");
            if bk.is_error { sum_n = fww_cat(tmp_buf, sum_n, ",err"); }
            sum_n = fww_cat(tmp_buf, sum_n, "): ");
            sum_n = fww_cat(tmp_buf, sum_n, cast(string) res[0..<take]);
            sum_n = fww_cat(tmp_buf, sum_n, "\n");
          }
        }
      }
    }
    if goal.count > 0 && sum_n + 64 < sum_cap {
      sum_n = fww_cat(tmp_buf, sum_n, "\nCurrent user request:\n");
      rem := sum_cap - sum_n;
      take := fww_utf8_cut(goal, ifx rem < goal_cap then rem else goal_cap);
      sum_n = fww_cat(tmp_buf, sum_n, cast(string) goal[0..<take]);
    }
  }

  // Copy kept messages into kept_msgs and identify the last keep_recent_tools TOOL_RESULTS messages.
  kept_msgs: [FWW_MAX_MSGS] FwMsg;
  nkept := h[0].nmsgs - keep_from;
  for k: 0..<nkept { kept_msgs[k] = h[0].msgs[keep_from + k]; }

  total_tr := 0;
  for k: 0..<nkept { if kept_msgs[k].role == FWW_MROLE_TOOL_RESULTS { total_tr += 1; } }
  recent_tr_from := total_tr - keep_recent_tools;

  // Guard tmp_buf headroom so relocated blocks NEVER clip an id, tool name, thoughtSignature, or TOOL_USE JSON argument string.
  avail_reloc := tmp_buf.count - sum_n - 4096;
  if nkept > 0 && avail_reloc <= 0 { return false; }
  eff_recent_cap := recent_block_cap;
  if nkept > 0 && avail_reloc > 0 {
    fixed_kept := 0;
    shrink_kept := 0;
    shrink_blks := 0;
    tr_pre := 0;
    for k: 0..<nkept {
      is_old_pre := false;
      if kept_msgs[k].role == FWW_MROLE_TOOL_RESULTS {
        is_old_pre = tr_pre < recent_tr_from;
        tr_pre += 1;
      }
      for b: 0..<kept_msgs[k].nblocks {
        bk := kept_msgs[k].blocks[b];
        fixed_kept += bk.id_n + bk.name_n + bk.sig_n;
        if bk.kind == FWW_MB_TOOL_USE {
          fixed_kept += bk.text_n;
        } else {
          shrink_kept += bk.text_n;
          if bk.text_n > 0 { shrink_blks += 1; }
          if bk.kind == FWW_MB_TOOL_RES && bk.img_n > 0 && !(is_old_pre && old_tool_cap > 0) && eff_recent_cap == 0 {
            fixed_kept += bk.img_mime_n + bk.img_n;
          }
        }
      }
    }
    if fixed_kept > avail_reloc { return false; }
    if fixed_kept + shrink_kept > avail_reloc {
      if shrink_blks == 0 { return false; }
      per_blk := (avail_reloc - fixed_kept) / shrink_blks;
      if per_blk < 128 { return false; }
      if eff_recent_cap == 0 || per_blk < eff_recent_cap { eff_recent_cap = per_blk; }
    }
  }

  // Relocate kept slab bytes into tmp_buf[sum_n..], applying microcompact & recent block caps.
  // Atomic overflow check: if ANY id, name, signature, or uncapped block does not fit in tmp_buf
  // (or won't fit back into h[0].slab), abort without mutating h so the caller can escalate cleanly.
  reloc_at := sum_n;
  tr_seen := 0;
  overflowed := false;
  for k: 0..<nkept {
    is_old_tr := false;
    if kept_msgs[k].role == FWW_MROLE_TOOL_RESULTS {
      is_old_tr = tr_seen < recent_tr_from;
      tr_seen += 1;
    }
    for b: 0..<kept_msgs[k].nblocks {
      bk := kept_msgs[k].blocks[b];
      id_s := fww_slab_str(h, bk.id_at, bk.id_n);
      if reloc_at + id_s.count > tmp_buf.count { overflowed = true; break; }
      id_new := reloc_at; id_n := fww_cat(tmp_buf, reloc_at, id_s) - reloc_at; reloc_at += id_n;
      if id_n != id_s.count { overflowed = true; break; }
      nm_s := fww_slab_str(h, bk.name_at, bk.name_n);
      if reloc_at + nm_s.count > tmp_buf.count { overflowed = true; break; }
      nm_new := reloc_at; nm_n := fww_cat(tmp_buf, reloc_at, nm_s) - reloc_at; reloc_at += nm_n;
      if nm_n != nm_s.count { overflowed = true; break; }
      tx_s := fww_slab_str(h, bk.text_at, bk.text_n);
      tx_new := reloc_at;
      cap_b := 0;
      drop_img := false;
      if bk.kind == FWW_MB_TOOL_RES {
        if is_old_tr && old_tool_cap > 0 { cap_b = old_tool_cap; drop_img = true; }
        if eff_recent_cap > 0 && (cap_b == 0 || eff_recent_cap < cap_b) { cap_b = eff_recent_cap; drop_img = true; }
      } else if bk.kind == FWW_MB_TEXT || bk.kind == FWW_MB_THINK {
        if eff_recent_cap > 0 { cap_b = eff_recent_cap; }
      }
      if cap_b == 0 && reloc_at + tx_s.count > tmp_buf.count { overflowed = true; break; }
      tx_end := ifx cap_b > 0 then fww_shrink_head_tail(tmp_buf, reloc_at, tx_s, cap_b, "compacted") else fww_cat(tmp_buf, reloc_at, tx_s);
      tx_n := tx_end - reloc_at; reloc_at = tx_end;
      if cap_b == 0 && tx_n != tx_s.count { overflowed = true; break; }
      if cap_b > 0 && tx_s.count > 0 && reloc_at >= tmp_buf.count { overflowed = true; break; }
      sg_s := fww_slab_str(h, bk.sig_at, bk.sig_n);
      if reloc_at + sg_s.count > tmp_buf.count { overflowed = true; break; }
      sg_new := reloc_at; sg_n := fww_cat(tmp_buf, reloc_at, sg_s) - reloc_at; reloc_at += sg_n;
      if sg_n != sg_s.count { overflowed = true; break; }
      im_new := 0; im_n := 0;
      idb_new := 0; idb_n := 0;
      if bk.img_n > 0 && !drop_img {
        im_s := fww_slab_str(h, bk.img_mime_at, bk.img_mime_n);
        idb_s := fww_slab_str(h, bk.img_at, bk.img_n);
        if reloc_at + im_s.count + idb_s.count <= tmp_buf.count {
          im_new = reloc_at; im_n = fww_cat(tmp_buf, reloc_at, im_s) - reloc_at; reloc_at += im_n;
          idb_new = reloc_at; idb_n = fww_cat(tmp_buf, reloc_at, idb_s) - reloc_at; reloc_at += idb_n;
        }
      }
      kept_msgs[k].blocks[b].id_at = id_new; kept_msgs[k].blocks[b].id_n = id_n;
      kept_msgs[k].blocks[b].name_at = nm_new; kept_msgs[k].blocks[b].name_n = nm_n;
      kept_msgs[k].blocks[b].text_at = tx_new; kept_msgs[k].blocks[b].text_n = tx_n;
      kept_msgs[k].blocks[b].sig_at = sg_new; kept_msgs[k].blocks[b].sig_n = sg_n;
      kept_msgs[k].blocks[b].img_mime_at = im_new; kept_msgs[k].blocks[b].img_mime_n = im_n;
      kept_msgs[k].blocks[b].img_at = idb_new; kept_msgs[k].blocks[b].img_n = idb_n;
    }
    if overflowed { break; }
  }
  if overflowed || reloc_at + 4096 > h[0].slab.count { return false; }

  // If microcompact-only made zero reduction, skip rewriting slab.
  if keep_from == 0 && (reloc_at - sum_n) >= old_nslab { return false; }

  saved_total_in := h[0].total_in;
  saved_total_out := h[0].total_out;
  saved_total_cached := h[0].total_cached;
  saved_total_cost := h[0].total_cost_micros;
  saved_compact_count := h[0].compact_count;
  fww_hist_clear(h);
  h[0].total_in = saved_total_in;
  h[0].total_out = saved_total_out;
  h[0].total_cached = saved_total_cached;
  h[0].total_cost_micros = saved_total_cost;
  h[0].compact_count = saved_compact_count;
  if sum_n > 0 {
    fww_hist_push_user(h, cast(string) tmp_buf[0..<sum_n]);
    // Keep strict user/assistant role alternation for both OpenAI/Psionic and Gemini:
    // only insert an Assistant ack when the next kept message is also USER (NOT when it's ASSISTANT tool_use!).
    if nkept > 0 && kept_msgs[0].role == FWW_MROLE_USER {
      fww_hist_push_assistant_text(h, "Understood. I have the compacted context and will continue seamlessly.");
    }
  }
  for k: 0..<nkept {
    if h[0].nmsgs >= FWW_MAX_MSGS { break; }
    mi := h[0].nmsgs;
    h[0].msgs[mi] = FwMsg.{role = kept_msgs[k].role};
    for b: 0..<kept_msgs[k].nblocks {
      bk := kept_msgs[k].blocks[b];
      nb := FwBlock.{kind = bk.kind, is_error = bk.is_error};
      a0 := [1] int.[0];
      nb.id_n = fww_slab_put(h, cast(string) tmp_buf[bk.id_at..<bk.id_at + bk.id_n], a0[..]); nb.id_at = a0[0];
      nb.name_n = fww_slab_put(h, cast(string) tmp_buf[bk.name_at..<bk.name_at + bk.name_n], a0[..]); nb.name_at = a0[0];
      nb.text_n = fww_slab_put(h, cast(string) tmp_buf[bk.text_at..<bk.text_at + bk.text_n], a0[..]); nb.text_at = a0[0];
      nb.sig_n = fww_slab_put(h, cast(string) tmp_buf[bk.sig_at..<bk.sig_at + bk.sig_n], a0[..]); nb.sig_at = a0[0];
      if bk.img_n > 0 && bk.img_mime_n > 0 {
        nb.img_mime_n = fww_slab_put(h, cast(string) tmp_buf[bk.img_mime_at..<bk.img_mime_at + bk.img_mime_n], a0[..]); nb.img_mime_at = a0[0];
        nb.img_n = fww_slab_put(h, cast(string) tmp_buf[bk.img_at..<bk.img_at + bk.img_n], a0[..]); nb.img_at = a0[0];
      }
      h[0].msgs[mi].blocks[b] = nb;
    }
    h[0].msgs[mi].nblocks = kept_msgs[k].nblocks;
    h[0].nmsgs += 1;
  }
  h[0].compact_count += 1;
  return h[0].nmsgs < old_nmsgs || h[0].nslab < old_nslab || keep_from > 0;
}

// Standard compaction entry point (/compact slash command & normal auto-compact).
fww_hist_compact :: (h: [] FwHist, tmp_buf: [] u8) -> bool {
  if fww_hist_compact_ex(h, 4, 2, 512, 0, 10240, tmp_buf) { return true; }
  if fww_hist_compact_ex(h, 2, 1, 512, 0, 8192, tmp_buf) { return true; }
  if fww_hist_compact_ex(h, 0, 1, 512, 0, 0, tmp_buf) { return true; }
  return fww_hist_compact_ex(h, -1, 0, 0, 0, 4096, tmp_buf);
}

// Progressive emergency compaction when approaching hard ceiling or recovering from HTTP 400 context overflow.
fww_emergency_compact :: (h: [] FwHist, level: int, ctx_win: int, tmp_buf: [] u8) -> bool {
  cwin := ifx ctx_win > 0 then ctx_win else 32768;
  if level <= 1 {
    return fww_hist_compact_ex(h, 2, 1, 256, 3072, 6144, tmp_buf)
        || fww_hist_compact_ex(h, 0, 1, 256, 3072, 0, tmp_buf);
  }
  if level == 2 {
    return fww_hist_compact_ex(h, 2, 1, 160, 1024, 3072, tmp_buf)
        || fww_hist_compact_ex(h, 0, 0, 160, 1024, 0, tmp_buf);
  }
  // Level 3+: total collapse into a single concise USER message guaranteed to fit any context >= 2048 tokens.
  cap := cwin / 2;
  if cap > 4096 { cap = 4096; }
  if cap < 1024 { cap = 1024; }
  return fww_hist_compact_ex(h, -1, 0, 0, 0, cap, tmp_buf)
      || fww_hist_compact_ex(h, 0, 0, 0, cap, 0, tmp_buf);
}

// Pre-flight context budget guard: guarantees prompt fits inside ctx_win BEFORE sending HTTP request.
fww_ensure_context_fits :: (h: [] FwHist, sys_n: int, ctx_win: int, is_local: bool, no_tools: bool, auto_compact: bool, tmp_buf: [] u8) -> bool {
  auto_th := ifx is_local then (ctx_win * 60) / 100 else flawed_auto_compact_threshold(flawed_effective_context_window(ctx_win, 32768, 0), 0);
  hard_lim := ifx is_local then ctx_win - (ifx ctx_win >= 16384 then 3584 else ctx_win / 4) else ctx_win - 49152;
  if hard_lim < 1536 { hard_lim = 1536; }
  if auto_th > hard_lim { auto_th = hard_lim; }

  near_msgs := h[0].nmsgs >= FWW_MAX_MSGS - 6;
  near_slab := h[0].nslab >= FWW_SLAB - 262144;
  near_body := fww_estimate_prompt_bytes(h, sys_n, is_local, no_tools) >= 4194304;
  est := fww_estimate_prompt_tokens(h, sys_n, is_local, no_tools);
  need_auto := auto_compact && est >= auto_th;
  need_hard := est >= hard_lim || near_msgs || near_slab || near_body;
  if !need_auto && !need_hard { return false; }

  did := false;
  // Layer 1: Microcompact old tool results in-place (only when not already at message-slot limit).
  if !near_msgs && fww_hist_compact_ex(h, 0, 2, 512, 0, 0, tmp_buf) {
    did = true;
    est = fww_estimate_prompt_tokens(h, sys_n, is_local, no_tools);
    near_slab = h[0].nslab >= FWW_SLAB - 262144;
    near_body = fww_estimate_prompt_bytes(h, sys_n, is_local, no_tools) >= 4194304;
    if est < auto_th && !near_slab && !near_body { return true; }
  }
  // Layer 2: Intra-turn full compaction keeping last 4 messages.
  max_sum := ifx is_local then (ctx_win * 3) / 10 else 16384;
  if max_sum > 10240 { max_sum = 10240; }
  if fww_hist_compact_ex(h, 4, 2, 512, 0, max_sum, tmp_buf) {
    did = true;
    est = fww_estimate_prompt_tokens(h, sys_n, is_local, no_tools);
    near_slab = h[0].nslab >= FWW_SLAB - 262144;
    near_body = fww_estimate_prompt_bytes(h, sys_n, is_local, no_tools) >= 4194304;
    if est < hard_lim && h[0].nmsgs < FWW_MAX_MSGS - 6 && !near_slab && !near_body { return true; }
  }
  // Layer 3: Aggressive compaction keeping last 2 messages + capping kept tool/text blocks.
  if est >= hard_lim || h[0].nmsgs >= FWW_MAX_MSGS - 6 || h[0].nslab >= FWW_SLAB - 262144 || fww_estimate_prompt_bytes(h, sys_n, is_local, no_tools) >= 4194304 {
    if fww_hist_compact_ex(h, 2, 1, 256, 4096, max_sum / 2, tmp_buf) {
      did = true;
      est = fww_estimate_prompt_tokens(h, sys_n, is_local, no_tools);
      if est < hard_lim && h[0].nslab < FWW_SLAB - 262144 && fww_estimate_prompt_bytes(h, sys_n, is_local, no_tools) < 4194304 { return true; }
    }
  }
  // Layer 4: Hard safety trim on remaining oversized blocks so a single giant paste/output can NEVER exceed ctx_win.
  if est >= hard_lim || h[0].nmsgs >= FWW_MAX_MSGS - 6 || h[0].nslab >= FWW_SLAB - 262144 || fww_estimate_prompt_bytes(h, sys_n, is_local, no_tools) >= 4194304 {
    rem_tok := hard_lim - ((sys_n + (ifx no_tools then 256 else 5600) + 512) / 3);
    if rem_tok < 512 { rem_tok = 512; }
    max_blk := (rem_tok * 2) / (ifx h[0].nmsgs > 0 then h[0].nmsgs else 1);
    if max_blk < 512 { max_blk = 512; }
    if fww_hist_compact_ex(h, 0, 0, max_blk, max_blk, 0, tmp_buf) { did = true; }
    est = fww_estimate_prompt_tokens(h, sys_n, is_local, no_tools);
    if est >= hard_lim || h[0].nmsgs >= FWW_MAX_MSGS - 6 || h[0].nslab >= FWW_SLAB - 262144 || fww_estimate_prompt_bytes(h, sys_n, is_local, no_tools) >= 4194304 {
      if fww_emergency_compact(h, 3, ctx_win, tmp_buf) { did = true; }
    }
  }
  return did;
}

// Structural conversation sanitizer: enforces strict protocol invariants BEFORE every API call so
// neither Gemini ("Requests ending with a model turn are not supported", unmatched functionCall/Response,
// consecutive same-role turns) nor OpenAI/Psionic can EVER receive malformed turn history — even after
// mid-tool stop, prior turn failure, recall of interrupted turns, compaction, or FWW_MAX_MSGS pressure.
fww_msg_count_tool_use :: (m: FwMsg) -> int {
  n := 0;
  for b: 0..<m.nblocks { if m.blocks[b].kind == FWW_MB_TOOL_USE { n += 1; } }
  return n;
}

fww_msg_count_tool_res :: (m: FwMsg) -> int {
  n := 0;
  for b: 0..<m.nblocks { if m.blocks[b].kind == FWW_MB_TOOL_RES { n += 1; } }
  return n;
}

fww_msg_has_visible_model_part :: (m: FwMsg) -> bool {
  for b: 0..<m.nblocks {
    bk := m.blocks[b];
    if bk.kind == FWW_MB_TOOL_USE { return true; }
    if bk.kind == FWW_MB_TEXT && (bk.text_n > 0 || bk.sig_n > 0) { return true; }
  }
  return false;
}

// Verifies an ASSISTANT(TOOL_USE) + TOOL_RESULTS(TOOL_RES) exchange has 1-to-1 matching non-empty tool names & IDs
// so Vertex AI can NEVER receive empty functionCall.name or mismatched functionCall/functionResponse pairs (HTTP 400).
fww_msg_tools_valid :: (h: [] FwHist, asst: FwMsg, tr: FwMsg) -> bool {
  tu_idx: [FWW_MAX_BLOCKS] int; ntu := 0;
  for b: 0..<asst.nblocks {
    if asst.blocks[b].kind == FWW_MB_TOOL_USE {
      bk := asst.blocks[b];
      if bk.name_n <= 0 || bk.name_at < 0 || bk.name_at + bk.name_n > h[0].slab.count { return false; }
      tu_idx[ntu] = b; ntu += 1;
    }
  }
  if ntu <= 0 { return false; }
  tr_idx: [FWW_MAX_BLOCKS] int; ntr := 0;
  for b: 0..<tr.nblocks {
    if tr.blocks[b].kind == FWW_MB_TOOL_RES {
      bk := tr.blocks[b];
      if bk.name_n <= 0 || bk.name_at < 0 || bk.name_at + bk.name_n > h[0].slab.count { return false; }
      tr_idx[ntr] = b; ntr += 1;
    }
  }
  if ntr != ntu { return false; }
  for k: 0..<ntu {
    tb := asst.blocks[tu_idx[k]];
    rb := tr.blocks[tr_idx[k]];
    if fww_slab_str(h, tb.name_at, tb.name_n) != fww_slab_str(h, rb.name_at, rb.name_n) { return false; }
    if tb.id_n > 0 && rb.id_n > 0 && fww_slab_str(h, tb.id_at, tb.id_n) != fww_slab_str(h, rb.id_at, rb.id_n) { return false; }
  }
  return true;
}

fww_hist_sanitize :: (h: [] FwHist, tmp_buf: [] u8) {
  if h[0].nmsgs >= FWW_MAX_MSGS - 2 || h[0].nslab >= FWW_SLAB - 32768 {
    _ = fww_hist_compact(h, tmp_buf);
  }
  out_n := 0;
  for i: 0..<h[0].nmsgs {
    msg := h[0].msgs[i];
    // 1. Conversation MUST start with USER.
    if out_n == 0 && msg.role != FWW_MROLE_USER { continue; }

    if msg.role == FWW_MROLE_TOOL_RESULTS {
      // 2. TOOL_RESULTS MUST immediately follow ASSISTANT with matching, valid non-empty TOOL_USE/TOOL_RES pairs.
      valid_pair := out_n > 0
                 && h[0].msgs[out_n - 1].role == FWW_MROLE_ASSISTANT
                 && fww_msg_tools_valid(h, h[0].msgs[out_n - 1], msg);
      if !valid_pair {
        // Preserve any trailing user text (steers / merged follow-up prompt) as a clean USER turn instead of dropping it.
        mn := 0;
        for b: 0..<msg.nblocks {
          if msg.blocks[b].kind == FWW_MB_TEXT && msg.blocks[b].text_n > 0 {
            if mn > 0 { mn = fww_cat(tmp_buf, mn, "\n\n"); }
            mn = fww_cat(tmp_buf, mn, fww_slab_str(h, msg.blocks[b].text_at, msg.blocks[b].text_n));
          }
        }
        if mn > 0 {
          if out_n > 0 && h[0].msgs[out_n - 1].role == FWW_MROLE_USER {
            prev_txt := ifx h[0].msgs[out_n - 1].nblocks > 0 then fww_slab_str(h, h[0].msgs[out_n - 1].blocks[0].text_at, h[0].msgs[out_n - 1].blocks[0].text_n) else "";
            if prev_txt.count > 0 && prev_txt.count + 2 + mn <= tmp_buf.count {
              // Shift mn text rightward or copy into tail? Combine via slab safely:
              a0 := [1] int.[0];
              new_n := fww_slab_put(h, cast(string) tmp_buf[0..<mn], a0[..]);
              new_s := fww_slab_str(h, a0[0], new_n);
              cn := fww_cat(tmp_buf, 0, prev_txt);
              cn = fww_cat(tmp_buf, cn, "\n\n");
              cn = fww_cat(tmp_buf, cn, new_s);
              a1 := [1] int.[0];
              sn := fww_slab_put(h, cast(string) tmp_buf[0..<cn], a1[..]);
              h[0].msgs[out_n - 1].blocks[0] = FwBlock.{kind = FWW_MB_TEXT, text_at = a1[0], text_n = sn};
              h[0].msgs[out_n - 1].nblocks = 1;
            }
          } else if out_n < FWW_MAX_MSGS {
            a0 := [1] int.[0];
            sn := fww_slab_put(h, cast(string) tmp_buf[0..<mn], a0[..]);
            h[0].msgs[out_n] = FwMsg.{role = FWW_MROLE_USER, nblocks = 1};
            h[0].msgs[out_n].blocks[0] = FwBlock.{kind = FWW_MB_TEXT, text_at = a0[0], text_n = sn};
            out_n += 1;
          }
        }
        continue;
      }
      h[0].msgs[out_n] = msg;
      out_n += 1;
    } else if msg.role == FWW_MROLE_ASSISTANT {
      // 3. Never emit two consecutive ASSISTANT messages.
      if out_n > 0 && h[0].msgs[out_n - 1].role == FWW_MROLE_ASSISTANT { continue; }
      // 4. An ASSISTANT message with TOOL_USE MUST be immediately followed by TOOL_RESULTS with exact valid matching pairs;
      //    if it is dangling/mismatched/corrupted (e.g. stopped/failed mid-tool or truncated name), strip TOOL_USE cleanly.
      ntu := fww_msg_count_tool_use(msg);
      next_matches_tr := (i + 1 < h[0].nmsgs)
                      && h[0].msgs[i + 1].role == FWW_MROLE_TOOL_RESULTS
                      && fww_msg_tools_valid(h, msg, h[0].msgs[i + 1]);
      if ntu > 0 && !next_matches_tr {
        nb := 0;
        for b: 0..<msg.nblocks {
          if msg.blocks[b].kind == FWW_MB_TEXT && msg.blocks[b].text_n > 0 {
            msg.blocks[nb] = msg.blocks[b];
            nb += 1;
          }
        }
        if nb == 0 {
          a0 := [1] int.[0];
          n0 := fww_slab_put(h, "(Previous tool step was interrupted.)", a0[..]);
          msg.blocks[0] = FwBlock.{kind = FWW_MB_TEXT, text_at = a0[0], text_n = n0};
          nb = 1;
        }
        msg.nblocks = nb;
      }
      // 4b. Drop thought-only or empty ASSISTANT turns (Gemini skips them, which would expose consecutive user turns!).
      if !fww_msg_has_visible_model_part(msg) { continue; }
      h[0].msgs[out_n] = msg;
      out_n += 1;
    } else if msg.role == FWW_MROLE_USER {
      // 5. Never emit two consecutive USER-side messages (USER+USER or TOOL_RESULTS+USER -> merge into preceding turn!).
      if out_n > 0 && h[0].msgs[out_n - 1].role == FWW_MROLE_TOOL_RESULTS {
        prev := h[0].msgs[out_n - 1];
        if msg.nblocks > 0 && msg.blocks[0].text_n > 0 {
          if prev.nblocks < FWW_MAX_BLOCKS {
            h[0].msgs[out_n - 1].blocks[prev.nblocks] = msg.blocks[0];
            h[0].msgs[out_n - 1].nblocks = prev.nblocks + 1;
          } else {
            last_b := prev.nblocks - 1;
            prev_txt := fww_slab_str(h, prev.blocks[last_b].text_at, prev.blocks[last_b].text_n);
            cur_txt := fww_slab_str(h, msg.blocks[0].text_at, msg.blocks[0].text_n);
            mn := fww_cat(tmp_buf, 0, prev_txt);
            if prev_txt.count > 0 { mn = fww_cat(tmp_buf, mn, "\n\n"); }
            mn = fww_cat(tmp_buf, mn, cur_txt);
            a0 := [1] int.[0];
            sn := fww_slab_put(h, cast(string) tmp_buf[0..<mn], a0[..]);
            h[0].msgs[out_n - 1].blocks[last_b].text_at = a0[0];
            h[0].msgs[out_n - 1].blocks[last_b].text_n = sn;
          }
        }
        continue;
      }
      if out_n > 0 && h[0].msgs[out_n - 1].role == FWW_MROLE_USER {
        prev_txt := ifx h[0].msgs[out_n - 1].nblocks > 0 then fww_slab_str(h, h[0].msgs[out_n - 1].blocks[0].text_at, h[0].msgs[out_n - 1].blocks[0].text_n) else "";
        cur_txt := ifx msg.nblocks > 0 then fww_slab_str(h, msg.blocks[0].text_at, msg.blocks[0].text_n) else "";
        mn := fww_cat(tmp_buf, 0, prev_txt);
        if prev_txt.count > 0 && cur_txt.count > 0 { mn = fww_cat(tmp_buf, mn, "\n\n"); }
        mn = fww_cat(tmp_buf, mn, cur_txt);
        a0 := [1] int.[0];
        sn := fww_slab_put(h, cast(string) tmp_buf[0..<mn], a0[..]);
        h[0].msgs[out_n - 1].blocks[0] = FwBlock.{kind = FWW_MB_TEXT, text_at = a0[0], text_n = sn};
        h[0].msgs[out_n - 1].nblocks = 1;
        continue;
      }
      h[0].msgs[out_n] = msg;
      out_n += 1;
    }
  }
  h[0].nmsgs = out_n;

  // 6. Ironclad invariant: history sent to the model MUST NEVER be empty and MUST NEVER end with ASSISTANT ("model")!
  if h[0].nmsgs == 0 || h[0].msgs[h[0].nmsgs - 1].role == FWW_MROLE_ASSISTANT {
    if h[0].nmsgs >= FWW_MAX_MSGS || h[0].nslab >= FWW_SLAB - 1024 {
      _ = fww_hist_compact(h, tmp_buf);
    }
    fww_hist_push_user(h, "Continue and complete the user's request based on the steps above.");
  }
}

// Surgical Gemini thoughtSignature repair: if Vertex/Gemini rejects a corrupted/missing signature,
// preserve the ENTIRE conversation intact and swap tool_use signatures to Gemini's official
// skip_thought_signature_validator sentinel instead of wiping 50K+ tokens of history!
fww_hist_strip_thought_sigs :: (h: [] FwHist) {
  a0 := [1] int.[0];
  skip_n := fww_slab_put(h, "skip_thought_signature_validator", a0[..]);
  skip_at := a0[0];
  for i: 0..<h[0].nmsgs {
    if h[0].msgs[i].role != FWW_MROLE_ASSISTANT { continue; }
    for b: 0..<h[0].msgs[i].nblocks {
      if h[0].msgs[i].blocks[b].kind == FWW_MB_TOOL_USE {
        h[0].msgs[i].blocks[b].sig_at = skip_at;
        h[0].msgs[i].blocks[b].sig_n = skip_n;
      } else {
        h[0].msgs[i].blocks[b].sig_at = 0;
        h[0].msgs[i].blocks[b].sig_n = 0;
      }
    }
  }
}

// Hydrate persisted turns from MWW_RECALL JSON array [{"task":...,"reply":...},...].
fww_hist_recall :: (h: [] FwHist, recall_json: string) {
  fww_hist_clear(h);
  if recall_json.count < 2 { return; }
  cnt := cl_count(recall_json);
  ab: [65536] u8;
  ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  for i: 0..<cnt {
    if h[0].nmsgs + 8 >= FWW_MAX_MSGS { break; }
    ar[0].at = 0; ar[0].full = false;
    item := cl_json(recall_json, cl_item(recall_json, i));
    if item.count == 0 { continue; }
    tk := cl_str(ar[..], item, "task");
    rp := cl_str(ar[..], item, "reply");
    if tk.count > 0 {
      fww_hist_push_user(h, tk);
      fww_hist_push_assistant_text(h, ifx rp.count > 0 then rp else "(interrupted)");
    }
  }
}

// ---------------------------------------------------------------- system prompt & memory loader (Ch 04 + Ch 10)

// Run a fast, read-only, bounded git command inside `cwd` (never acquires optional locks).
fww_git_quick :: (cwd: string, a1: string, a2: string, a3: string, a4: string, out: [] u8) -> int {
  h := proc_new();
  if h < 0 { return 0; }
  ok := proc_arg(h, "git") && proc_arg(h, "--no-optional-locks");
  if a1.count > 0 { ok = ok && proc_arg(h, a1); }
  if a2.count > 0 { ok = ok && proc_arg(h, a2); }
  if a3.count > 0 { ok = ok && proc_arg(h, a3); }
  if a4.count > 0 { ok = ok && proc_arg(h, a4); }
  ok = ok && proc_cwd(h, cwd);
  n := 0;
  if ok && proc_start(h) == 0 {
    _ = proc_close_stdin(h);
    lbuf: [1024] u8;
    deadline := proc_now_ms() + 1200;
    while proc_now_ms() < deadline && n + 64 < out.count {
      r := proc_line(h, 100, lbuf[..]);
      if r == PROC_EOF || r < 0 { break; }
      if r == PROC_TIMEOUT { continue; }
      n = fww_cat(out, n, cast(string) lbuf[0..<r]);
      n = fww_cat(out, n, "\n");
    }
    ec := proc_wait(h, 400);
    if ec != 0 { n = 0; }
  }
  _ = proc_release(h);
  return n;
}

// Claude Code context.ts pattern: capture a one-time, cache-stable git snapshot at session start
// so the model never wastes Turn 1 running `git status && git log`.
fww_capture_git_snapshot :: (cwd: string, out: [] u8) -> int {
  if cwd.count == 0 { return 0; }
  br_b: [128] u8;
  bn := fww_git_quick(cwd, "rev-parse", "--abbrev-ref", "HEAD", "", br_b[..]);
  if bn <= 0 { return 0; }
  st_b: [1024] u8;
  sn := fww_git_quick(cwd, "status", "--short", "", "", st_b[..]);
  lg_b: [768] u8;
  ln := fww_git_quick(cwd, "log", "--oneline", "-n", "5", lg_b[..]);
  n := fww_cat(out, 0, "\n\n# Workspace Git Snapshot (captured at session start)\nBranch: ");
  n = fww_cat(out, n, fww_trim(cast(string) br_b[0..<bn]));
  n = fww_cat(out, n, "\nStatus: ");
  st_s := fww_trim(cast(string) st_b[0..<sn]);
  if st_s.count == 0 {
    n = fww_cat(out, n, "(clean)");
  } else {
    n = fww_cat(out, n, "\n");
    n = fww_cat(out, n, st_s);
    if sn + 64 >= st_b.count { n = fww_cat(out, n, "\n... (truncated)"); }
  }
  if ln > 0 {
    n = fww_cat(out, n, "\nRecent commits:\n");
    n = fww_cat(out, n, fww_trim(cast(string) lg_b[0..<ln]));
  }
  return n;
}

fww_append_instr_capped :: (out: [] u8, at: int, heading: string, path: string, max_bytes: int) -> int {
  if path.count == 0 || !fs_exists(path) { return at; }
  fbuf: [8192] u8;
  rn := fs_read(path, fbuf[..]);
  if rn <= 0 { return at; }
  n := fww_cat(out, at, heading);
  body := cast(string) fbuf[0..<rn];
  if body.count > max_bytes {
    cut := fww_utf8_cut(body, max_bytes);
    n = fww_cat(out, n, cast(string) body[0..<cut]);
    n = fww_cat(out, n, "\n... [truncated; use Read on ");
    n = fww_cat(out, n, path);
    n = fww_cat(out, n, " for more]");
  } else {
    n = fww_cat(out, n, body);
  }
  return n;
}

// Pure core of compact base conversational prompt (<25% of full coding prompt; #14054).
fww_build_base_system_prompt_core :: (cfg: [] FwConfig, platform: string, out: [] u8) -> int {
  n := 0;
  n = fww_cat(out, n, "You are OpenAgents, an AI assistant running natively inside OpenAgents Desktop.\nPlatform: ");
  n = fww_cat(out, n, platform);
  n = fww_cat(out, n, "\nBe helpful, accurate, concise, and direct. Use clear Markdown when helpful.\n");
  if cfg[0].output_style == FLAWED_STYLE_CONCISE {
    n = fww_cat(out, n, "\n[Output Style: Concise]: Be brief and direct. Avoid unnecessary filler.\n");
  } else if cfg[0].output_style == FLAWED_STYLE_EXPLANATORY {
    n = fww_cat(out, n, "\n[Output Style: Explanatory]: Explain the reasoning and tradeoffs clearly.\n");
  } else if cfg[0].output_style == FLAWED_STYLE_LEARNING {
    n = fww_cat(out, n, "\n[Output Style: Learning]: Explain key concepts clearly and invite collaborative decisions.\n");
  }
  return n;
}

fww_build_base_system_prompt :: (cfg: [] FwConfig, out: [] u8) -> int {
  platform := ifx tool_os() == TOOL_LINUX then "Linux" else "macOS";
  n := fww_build_base_system_prompt_core(cfg, platform, out);
  cspb: [FS_PATH_MAX] u8;
  cspath := csys_path(cspb[..]);
  csbuf: [CSYS_MAX_BYTES + 1] u8;
  csblk: [CSYS_BLOCK_BYTES] u8;
  cs := csys_block("\n\n# ", csys_read(cspath, csbuf[..]), csblk[..]);
  if cs.count > 0 {
    n = fww_cat(out, n, cs);
  }
  return n;
}

fww_hist_has_tools :: (h: [] FwHist) -> bool {
  for i: 0..<h[0].nmsgs {
    m := h[0].msgs[i];
    if fww_msg_count_tool_use(m) > 0 || fww_msg_count_tool_res(m) > 0 { return true; }
  }
  return false;
}

fww_is_ident_byte :: (c: u8) -> bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

fww_has_word_ci :: (text: string, word: string) -> bool {
  if word.count == 0 || text.count < word.count { return false; }
  for i: 0..<text.count - word.count + 1 {
    if i > 0 && fww_is_ident_byte(text[i - 1]) { continue; }
    end := i + word.count;
    if end < text.count && fww_is_ident_byte(text[end]) { continue; }
    matched := true;
    for j: 0..<word.count {
      if flawed_aw_lower(text[i + j]) != flawed_aw_lower(word[j]) { matched = false; break; }
    }
    if matched { return true; }
  }
  return false;
}

// Classify whether a turn needs the coding/workspace/tool-use addendum (#14054).
// Pure conversational greetings & general knowledge turns stay on the compact base prompt with no tool schemas.
fww_is_coding_turn :: (cfg: [] FwConfig, h: [] FwHist) -> bool {
  if cfg[0].permission_mode == FLAWED_PMODE_PLAN && !cfg[0].bypass_danger { return true; }
  if fww_hist_has_tools(h) { return true; }
  // Inspect the latest user message (and any prior user message in the thread)
  for ri: 0..<h[0].nmsgs {
    idx := h[0].nmsgs - 1 - ri;
    m := h[0].msgs[idx];
    if m.role != FWW_MROLE_USER { continue; }
    for bi: 0..<m.nblocks {
      if m.blocks[bi].kind != FWW_MB_TEXT { continue; }
      t := fww_slab_str(h, m.blocks[bi].text_at, m.blocks[bi].text_n);
      if t.count == 0 { continue; }
      // Code fences, inline code, file paths, or URLs
      for ci: 0..<t.count {
        if t[ci] == '`' { return true; }
      }
      if fww_contains_ci(t, ".coax") || fww_contains_ci(t, ".rs") || fww_contains_ci(t, ".py") ||
         fww_contains_ci(t, ".ts") || fww_contains_ci(t, ".js") || fww_contains_ci(t, ".swift") ||
         fww_contains_ci(t, ".json") || fww_contains_ci(t, ".md") || fww_contains_ci(t, ".sh") ||
         fww_contains_ci(t, ".c") || fww_contains_ci(t, ".h") || fww_contains_ci(t, "http://") ||
         fww_contains_ci(t, "https://") || fww_contains_ci(t, "::") || fww_contains_ci(t, "->") ||
         fww_contains_ci(t, "./") || fww_contains_ci(t, "~/") || fww_contains_ci(t, "src/") ||
         fww_contains_ci(t, "coax/") || fww_contains_ci(t, "openagents/") || fww_contains_ci(t, "apps/") ||
         fww_contains_ci(t, "coder/") || fww_contains_ci(t, ".png") || fww_contains_ci(t, ".jpg") ||
         fww_contains_ci(t, ".jpeg") || fww_contains_ci(t, ".webp") || fww_contains_ci(t, ".heic") ||
         fww_contains_ci(t, ".gif") || fww_contains_ci(t, "/Users/") || fww_contains_ci(t, "/tmp/") {
        return true;
      }
      // Coding, workspace, git, build, or symbol keywords (whole-word case-insensitive)
      kws := [42] string.[
        "file", "files", "repo", "repository", "workspace", "directory", "folder", "path",
        "code", "codebase", "bug", "fix", "edit", "write", "read", "search", "grep", "glob",
        "test", "tests", "build", "compile", "compiler", "check", "error", "crash", "debug",
        "git", "commit", "diff", "branch", "push", "pull", "issue", "pr", "patch",
        "bash", "shell", "command", "run", "refactor", "implement",
      ];
      for k: kws {
        if fww_has_word_ci(t, k) { return true; }
      }
      kws2 := [28] string.[
        "function", "proc", "struct", "symbol", "defines", "uses", "exports", "coax",
        "cargo", "npm", "pytest", "selftest",
        "wallet", "bitcoin", "lightning", "sats", "invoice", "spark", "nostr", "pylon",
        "vault", "realm", "tasks", "dictate", "transcribe", "metaverse", "gamebuilder", "playtest",
      ];
      for k: kws2 {
        if fww_has_word_ci(t, k) { return true; }
      }
    }
  }
  return false;
}

fww_is_coax_repo :: (cwd: string) -> bool {
  if cwd.count == 0 { return false; }
  p1: [FS_PATH_MAX] u8;
  p2: [FS_PATH_MAX] u8;
  return fs_exists(fs_join(cwd, "coax/lib/agent/intel/intel.coax", p1[..])) &&
         fs_exists(fs_join(cwd, "coax/web/tool.sh", p2[..]));
}

fww_wallet_control_path :: (out: [] u8) -> string {
  eb: [FS_PATH_MAX] u8;
  custom := fww_trim(cl_getenv("CODER_FOREMAN_CONTROL_FILE", eb[..]));
  if custom.count > 0 && custom.count <= out.count {
    n := fww_keep(out, custom);
    return cast(string) out[0..<n];
  }
  hb: [FS_PATH_MAX] u8;
  h := cl_getenv("HOME", hb[..]);
  if h.count == 0 { return ""; }
  return fs_join(h, "Library/Application Support/Coder/foreman-control.json", out);
}

// Compute active member-tool packs bitmask (#14057) from feature flags, env, and workspace.
fww_active_packs :: (cwd: string, include_coax_intel: bool) -> int {
  eb: [128] u8;
  w_env := fww_trim(cl_getenv("OA_WALLET_TOOLS", eb[..]));
  has_wallet := false;
  if w_env == "1" || w_env == "true" { has_wallet = true; }
  else if w_env != "0" && w_env != "false" {
    cpb: [FS_PATH_MAX] u8;
    cp := fww_wallet_control_path(cpb[..]);
    has_wallet = cp.count > 0 && fs_exists(cp);
  }

  c_env := fww_trim(cl_getenv("OA_CLI_TOOLS", eb[..]));
  has_cli := false;
  if c_env == "1" || c_env == "true" { has_cli = true; }
  else if c_env != "0" && c_env != "false" {
    cb: [FS_PATH_MAX] u8;
    p1: [FS_PATH_MAX] u8;
    has_cli = fww_trim(cl_getenv("OA_CLI_BIN", cb[..])).count > 0 ||
              (cwd.count > 0 && fs_exists(fs_join(cwd, "apps/openagents-cli/main.coax", p1[..])));
  }

  m_env := fww_trim(cl_getenv("OA_METAVERSE_TOOLS", eb[..]));
  has_mv := false;
  if m_env == "1" || m_env == "true" { has_mv = true; }
  else if m_env != "0" && m_env != "false" {
    gb1: [64] u8; gb2: [FS_PATH_MAX] u8; p2: [FS_PATH_MAX] u8;
    has_mv = fww_trim(cl_getenv("OA_GB_MCP", gb1[..])) == "1" ||
             fww_trim(cl_getenv("OA_GAMEBUILDER", gb2[..])).count > 0 ||
             (cwd.count > 0 && fs_exists(fs_join(cwd, "coax/lib/agent/desktop/metaverse-route.coax", p2[..])));
  }
  return oa_member_packs_from_flags(include_coax_intel, has_wallet, has_cli, has_mv);
}

// Compact coding system prompt for 32K local Inkling 2 Mini (#14055).
fww_build_local_coding_system_prompt_core :: (cfg: [] FwConfig, cwd: string, platform: string, out: [] u8) -> int {
  n := 0;
  n = fww_cat(out, n, "You are OpenAgents, a local coding assistant running in the user's workspace.\n");
  n = fww_cat(out, n, "Working directory: ");
  n = fww_cat(out, n, cwd);
  n = fww_cat(out, n, "\nPlatform: ");
  n = fww_cat(out, n, platform);
  n = fww_cat(out, n, "\n\nRules:\n");
  n = fww_cat(out, n, "- Use Read, Edit, Write, Glob, and Grep for files; use Bash for running tests and builds.\n");
  n = fww_cat(out, n, "- Always Read a file before calling Edit. Keep edits minimal and exact.\n");
  n = fww_cat(out, n, "- Run the relevant test command after editing to verify your fix, then answer concisely.\n");
  n = fww_cat(out, n, "- Never repeat an identical tool call. If stuck, try a different approach or report clearly.\n");
  n = fww_cat(out, n, "- Never run `git commit`, `git push`, or destructive commands outside the workspace (e.g. `rm -rf ..`) unless explicitly asked; refuse destructive requests outside the workspace.\n");
  if cfg[0].permission_mode == FLAWED_PMODE_PLAN && !cfg[0].bypass_danger {
    n = fww_cat(out, n, "\n[PLAN MODE ACTIVE]: Do not edit or write files. Present a concise plan.\n");
  }
  return n;
}

fww_build_coding_system_prompt_core :: (cfg: [] FwConfig, cwd: string, platform: string, out: [] u8) -> int {
  n := 0;
  n = fww_cat(out, n, "You are OpenAgents, an autonomous software engineering coding agent running natively inside OpenAgents Desktop.\n");
  n = fww_cat(out, n, "Working directory: ");
  n = fww_cat(out, n, cwd);
  n = fww_cat(out, n, "\nPlatform: ");
  n = fww_cat(out, n, platform);

  n = fww_cat(out, n, "\n\n# Working Efficiently & Using Tools\n");
  n = fww_cat(out, n, "- Go straight to the point. Try the simplest direct implementation first without going in circles — avoid speculative abstractions, unrelated refactors, or extra configurability.\n");
  n = fww_cat(out, n, "- Maximize parallel tool calls: emit ALL independent Read, Grep, Glob, Coax*, or Edit calls together in a single response instead of one call per turn.\n");
  n = fww_cat(out, n, "- Prefer compiler-backed Coax intelligence tools (`CoaxDefines`, `CoaxUses`, `CoaxShow`, `CoaxCheck`, `CoaxChecks`, `CoaxExports`, `CoaxEffects`, `CoaxDepends`, `CoaxLoaders`, `CoaxExplain`, `CoaxVocab`, `CoaxReplace`) over raw `Grep`/`Read` whenever querying or checking Coax symbols in a Coax repo.\n");
  n = fww_cat(out, n, "- Prefer dedicated tools over Bash: Read (not cat/head/tail/sed — Read also natively reads PNG/JPEG/GIF/WebP/BMP/TIFF/HEIC images and screenshots directly without scripts), Edit (not sed/awk), Write (not heredoc), Glob (not find/ls), Grep (not rg/grep). Reserve Bash for builds, tests, git, and scripts.\n");
  n = fww_cat(out, n, "- Keep exploration tightly bounded: read only the target file(s) and direct callers/tests needed for the task (typically 2-4 turns). Do not read peripheral docs, unrelated modules, or deep git history once you know enough to write your first working change.\n");
  n = fww_cat(out, n, "- Derive root causes and general invariants thoroughly before patching: fix the underlying invariant across multiple sequential, concurrent, or interleaved operations and edge cases (never just a single repro symptom). Batch independent edits cleanly, run targeted build/test checks right after editing, and fuzz boundary/malformed/stress inputs before finishing.\n");
  n = fww_cat(out, n, "- Think concisely and iterate from real execution: do not spend long blocks mentally simulating every case in isolation before running code. Once you have the core model, write your deliverable implementation and a comprehensive test script early so real execution exposes subtle edge cases with plenty of time left to fix them. For search or optimization tasks, write the first valid working output to the target path immediately before running slower refinement passes, and keep scripts fast (<30s).\n");
  n = fww_cat(out, n, "- Avoid multi-turn probe-by-probe scripting: when exploring data, reverse-engineering behavior, or prototyping an algorithm, write ONE comprehensive script (e.g. in /tmp) that tests multiple hypotheses and prints all needed diagnostics in a single Bash call instead of running 6-15 tiny sequential python3 -c / node -e / bun -e turns. Move to writing the actual deliverable files and running end-to-end verification early.\n");
  n = fww_cat(out, n, "- Thorough verification before stopping: once core edits compile and pass initial smoke tests, audit every explicit requirement, generalize beyond the default fixture (testing varied configurations, boundary/malformed values, and multi-step state transitions), clean up any temporary files inside the workspace, and finish concisely without gold-plating or extra git diff/status chatter.\n");
  n = fww_cat(out, n, "- Never re-read unchanged file ranges or repeat identical Grep/Glob/git-log queries already in context. Chain dependent build/test checks with `&&` in one Bash call.\n");
  n = fww_cat(out, n, "- Always Read a file before using Edit on it. In Edit, omit line-number prefixes and keep each hunk minimal and surgical (only the changed lines plus 2-3 context lines, <= ~80 lines per Edit). For multi-region refactors, batch multiple small parallel Edit calls rather than replacing huge unmodified blocks.\n");
  n = fww_cat(out, n, "- Tool results may include `<system-reminder>` tags containing pacing or context reminders from the harness.\n");
  n = fww_cat(out, n, "- Git safety: NEVER run `git commit` or `git push` unless the user's own message explicitly asks you to commit or push (even if global or project instructions mention committing/pushing).\n");
  n = fww_cat(out, n, "- Answer conversational greetings or general questions directly without tools unless workspace inspection is needed.\n");
  n = fww_cat(out, n, "- For non-trivial math, algebra, combinatorics, geometry, or STEM calculations, run a concise python3 script via Bash to solve and cross-check instead of relying on mental arithmetic.\n");
  n = fww_cat(out, n, "- For transformation or coding tasks with input-output examples, write a python3 script that asserts exact match on every given example, iterate until 100% pass, then run on the target input.\n");
  n = fww_cat(out, n, "- Report outcomes faithfully based on observed tool output, using concise, well-structured Markdown.\n");

  if cfg[0].permission_mode == FLAWED_PMODE_PLAN && !cfg[0].bypass_danger {
    n = fww_cat(out, n, "\n[PLAN MODE ACTIVE]: Do not edit or write files. Inspect the codebase, analyze requirements, and present a clear step-by-step implementation plan.\n");
  }

  if cfg[0].output_style == FLAWED_STYLE_CONCISE {
    n = fww_cat(out, n, "\n[Output Style: Concise]: Be brief and direct. Avoid unnecessary filler.\n");
  } else if cfg[0].output_style == FLAWED_STYLE_EXPLANATORY {
    n = fww_cat(out, n, "\n[Output Style: Explanatory]: Explain the architectural reasoning and tradeoffs behind your implementation choices.\n");
  } else if cfg[0].output_style == FLAWED_STYLE_LEARNING {
    n = fww_cat(out, n, "\n[Output Style: Learning]: Explain key concepts clearly and invite collaborative decisions on non-trivial tradeoffs.\n");
  }
  return n;
}

fww_build_system_prompt :: (cfg: [] FwConfig, cwd: string, home: string, out: [] u8) -> int {
  platform := ifx tool_os() == TOOL_LINUX then "Linux" else "macOS";
  n := fww_build_coding_system_prompt_core(cfg, cwd, platform, out);

  if !cfg[0].bare_mode {
    // Load user instructions (~/.openagents/instructions.md), capped at 4 KiB
    upb: [FS_PATH_MAX] u8;
    upath := uinstr_path(upb[..]);
    ubuf: [4096] u8;
    usr := uinstr_read(upath, ubuf[..]);
    if usr.count > 0 {
      n = fww_cat(out, n, "\n\n# User Instructions (note: never commit/push unless the user's current message asks)\n");
      n = fww_cat(out, n, usr);
    }

    // Load project CLAUDE.md / AGENTS.md + global ~/.claude/CLAUDE.md (each capped at 4 KiB to keep prefix lean)
    if cfg[0].auto_memory {
      pb: [FS_PATH_MAX] u8;
      n = fww_append_instr_capped(out, n, "\n\n# Project CLAUDE.md\n", fs_join(cwd, "CLAUDE.md", pb[..]), 4096);
      n = fww_append_instr_capped(out, n, "\n\n# Project AGENTS.md\n", fs_join(cwd, "AGENTS.md", pb[..]), 4096);
      if home.count > 0 {
        n = fww_append_instr_capped(out, n, "\n\n# Global ~/.claude/CLAUDE.md\n", fs_join(home, ".claude/CLAUDE.md", pb[..]), 4096);
      }
    }
  }

  // Always append Custom System Prompt (~/.openagents/system-prompt.md), even in bare mode.
  cspb: [FS_PATH_MAX] u8;
  cspath := csys_path(cspb[..]);
  csbuf: [CSYS_MAX_BYTES + 1] u8;
  csblk: [CSYS_BLOCK_BYTES] u8;
  cs := csys_block("\n\n# ", csys_read(cspath, csbuf[..]), csblk[..]);
  if cs.count > 0 {
    n = fww_cat(out, n, cs);
  }
  return n;
}

// ---------------------------------------------------------------- request JSON builders (Gemini Native & OpenAI/Psionic)

fww_build_gemini_body_packs :: (cfg: [] FwConfig, h: [] FwHist, effort: string, sys_prompt: string, no_tools: bool, packs_mask: int, out: [] u8) -> int {
  o: [1] Jo;
  jo_start(o[..], out);
  jo_obj(o[..]);

  // System instruction
  if sys_prompt.count > 0 {
    jo_key(o[..], "systemInstruction");
    jo_obj(o[..]);
    jo_key(o[..], "parts");
    jo_arr(o[..]);
    jo_obj(o[..]);
    jo_key(o[..], "text"); jo_str(o[..], sys_prompt);
    jo_end(o[..]);
    jo_end(o[..]);
    jo_end(o[..]);
  }

  // Tools (Gemini functionDeclarations; omit completely on non-coding turns with no prior tool history,
  // and keep declarations with toolConfig NONE on wrap-up turns that already contain tool history)
  if !no_tools || fww_hist_has_tools(h) {
    allowed := cast(string) cfg[0].allowed_tools[0..<cfg[0].nallowed];
    disallowed := cast(string) cfg[0].disallowed_tools[0..<cfg[0].ndisallowed];
    jo_key(o[..], "tools");
    _ = flawed_wire_write_tools_packs(o[..], true, allowed, disallowed, packs_mask);
    if no_tools {
      jo_key(o[..], "toolConfig");
      jo_raw(o[..], "{\"functionCallingConfig\":{\"mode\":\"NONE\"}}");
    }
  }

  // Contents (enforce strict non-empty user-started, user-terminated sequence on the wire too!)
  jo_key(o[..], "contents");
  jo_arr(o[..]);
  last_emitted_role := 0; // 0=none, 1=user, 2=model
  for i: 0..<h[0].nmsgs {
    msg := h[0].msgs[i];
    if last_emitted_role == 0 && msg.role != FWW_MROLE_USER { continue; }
    if msg.role == FWW_MROLE_USER {
      jo_obj(o[..]);
      jo_key(o[..], "role"); jo_str(o[..], "user");
      jo_key(o[..], "parts");
      jo_arr(o[..]);
      txt := ifx msg.nblocks > 0 then fww_slab_str(h, msg.blocks[0].text_at, msg.blocks[0].text_n) else "";
      jo_obj(o[..]);
      jo_key(o[..], "text"); jo_str(o[..], ifx txt.count > 0 then txt else "Continue.");
      jo_end(o[..]);
      jo_end(o[..]);
      jo_end(o[..]);
      last_emitted_role = 1;
    } else if msg.role == FWW_MROLE_ASSISTANT {
      // Count model parts (text + tool_use; skip thought-only blocks without text/tool)
      nparts := 0;
      for b: 0..<msg.nblocks {
        bk := msg.blocks[b];
        if (bk.kind == FWW_MB_TEXT && (bk.text_n > 0 || bk.sig_n > 0)) || bk.kind == FWW_MB_TOOL_USE { nparts += 1; }
      }
      if nparts == 0 { continue; }
      jo_obj(o[..]);
      jo_key(o[..], "role"); jo_str(o[..], "model");
      jo_key(o[..], "parts");
      jo_arr(o[..]);
      for b: 0..<msg.nblocks {
        bk := msg.blocks[b];
        if bk.kind == FWW_MB_TEXT && (bk.text_n > 0 || bk.sig_n > 0) {
          jo_obj(o[..]);
          jo_key(o[..], "text"); jo_str(o[..], fww_slab_str(h, bk.text_at, bk.text_n));
          if bk.sig_n > 0 { jo_key(o[..], "thoughtSignature"); jo_str(o[..], fww_slab_str(h, bk.sig_at, bk.sig_n)); }
          jo_end(o[..]);
        } else if bk.kind == FWW_MB_TOOL_USE {
          jo_obj(o[..]);
          jo_key(o[..], "functionCall");
          jo_obj(o[..]);
          fc_nm := fww_slab_str(h, bk.name_at, bk.name_n);
          jo_key(o[..], "name"); jo_str(o[..], ifx fc_nm.count > 0 then fc_nm else "tool");
          inp := fww_slab_str(h, bk.text_at, bk.text_n);
          jo_key(o[..], "args");
          jo_raw(o[..], ifx inp.count > 0 && json_valid(inp) && inp[0] == '{' then inp else "{}");
          if bk.id_n > 0 { jo_key(o[..], "id"); jo_str(o[..], fww_slab_str(h, bk.id_at, bk.id_n)); }
          jo_end(o[..]);
          if bk.sig_n > 0 { jo_key(o[..], "thoughtSignature"); jo_str(o[..], fww_slab_str(h, bk.sig_at, bk.sig_n)); }
          jo_end(o[..]);
        }
      }
      jo_end(o[..]);
      jo_end(o[..]);
      last_emitted_role = 2;
    } else if msg.role == FWW_MROLE_TOOL_RESULTS {
      last_tr_idx := -1;
      has_extra_txt := false;
      for b: 0..<msg.nblocks {
        bk := msg.blocks[b];
        if bk.kind == FWW_MB_TOOL_RES { last_tr_idx = b; }
        else if bk.kind == FWW_MB_TEXT && bk.text_n > 0 { has_extra_txt = true; }
      }
      if last_tr_idx < 0 && !has_extra_txt { continue; }
      jo_obj(o[..]);
      jo_key(o[..], "role"); jo_str(o[..], "user");
      jo_key(o[..], "parts");
      jo_arr(o[..]);
      if last_tr_idx >= 0 {
        // Vertex AI / Gemini strictly forbids mixing sibling {"text":...} parts inside a functionResponse turn.
        // Fold any trailing FWW_MB_TEXT blocks (steers, <system-reminder> pacing nudges, wrap-up prompts)
        // cleanly into the last functionResponse's output payload so part counts match functionCall 1-to-1!
        for b: 0..<msg.nblocks {
          bk := msg.blocks[b];
          if bk.kind != FWW_MB_TOOL_RES { continue; }
          jo_obj(o[..]);
          jo_key(o[..], "functionResponse");
          jo_obj(o[..]);
          nm := fww_slab_str(h, bk.name_at, bk.name_n);
          jo_key(o[..], "name"); jo_str(o[..], ifx nm.count > 0 then nm else "tool");
          if bk.id_n > 0 { jo_key(o[..], "id"); jo_str(o[..], fww_slab_str(h, bk.id_at, bk.id_n)); }
          jo_key(o[..], "response");
          jo_obj(o[..]);
          jo_key(o[..], "output");
          if b == last_tr_idx && has_extra_txt {
            comb: [FWW_TOOL_OUT_MAX + 4096] u8;
            cn := fww_cat(comb[..], 0, fww_slab_str(h, bk.text_at, bk.text_n));
            for tb_i: 0..<msg.nblocks {
              tbk := msg.blocks[tb_i];
              if tbk.kind == FWW_MB_TEXT && tbk.text_n > 0 {
                if cn > 0 { cn = fww_cat(comb[..], cn, "\n\n"); }
                cn = fww_cat(comb[..], cn, fww_slab_str(h, tbk.text_at, tbk.text_n));
              }
            }
            jo_str(o[..], cast(string) comb[0..<cn]);
          } else {
            jo_str(o[..], fww_slab_str(h, bk.text_at, bk.text_n));
          }
          if bk.is_error { jo_key(o[..], "is_error"); jo_bool(o[..], true); }
          jo_end(o[..]);
          if bk.img_n > 0 && bk.img_mime_n > 0 {
            jo_key(o[..], "parts");
            jo_arr(o[..]);
            jo_obj(o[..]);
            jo_key(o[..], "inlineData");
            jo_obj(o[..]);
            jo_key(o[..], "mimeType"); jo_str(o[..], fww_slab_str(h, bk.img_mime_at, bk.img_mime_n));
            jo_key(o[..], "data"); jo_str(o[..], fww_slab_str(h, bk.img_at, bk.img_n));
            jo_end(o[..]);
            jo_end(o[..]);
            jo_end(o[..]);
          }
          jo_end(o[..]);
          jo_end(o[..]);
        }
      } else {
        for b: 0..<msg.nblocks {
          bk := msg.blocks[b];
          if bk.kind == FWW_MB_TEXT && bk.text_n > 0 {
            jo_obj(o[..]);
            jo_key(o[..], "text"); jo_str(o[..], fww_slab_str(h, bk.text_at, bk.text_n));
            jo_end(o[..]);
          }
        }
      }
      jo_end(o[..]);
      jo_end(o[..]);
      last_emitted_role = 1;
    }
  }
  if last_emitted_role != 1 {
    jo_obj(o[..]);
    jo_key(o[..], "role"); jo_str(o[..], "user");
    jo_key(o[..], "parts");
    jo_arr(o[..]);
    jo_obj(o[..]);
    jo_key(o[..], "text"); jo_str(o[..], "Continue and complete the user's request.");
    jo_end(o[..]);
    jo_end(o[..]);
    jo_end(o[..]);
  }
  jo_end(o[..]);

  // Generation & thinking config
  jo_key(o[..], "generationConfig");
  jo_obj(o[..]);
  jo_key(o[..], "maxOutputTokens"); jo_int(o[..], flawed_wire_max_tokens(cfg[0].thinking_mode, effort, false));
  jo_key(o[..], "thinkingConfig");
  jo_obj(o[..]);
  if cfg[0].thinking_mode == FLAWED_THINK_OFF {
    jo_key(o[..], "includeThoughts"); jo_bool(o[..], false);
    jo_key(o[..], "thinkingLevel"); jo_str(o[..], "low");
  } else {
    jo_key(o[..], "includeThoughts"); jo_bool(o[..], true);
    jo_key(o[..], "thinkingLevel"); jo_str(o[..], flawed_wire_gemini_level(effort));
  }
  jo_end(o[..]);
  jo_end(o[..]);

  jo_end(o[..]);
  return ifx o[0].bad then -1 else o[0].n;
}

fww_build_gemini_body_ex :: (cfg: [] FwConfig, h: [] FwHist, effort: string, sys_prompt: string, no_tools: bool, include_coax_intel: bool, out: [] u8) -> int {
  return fww_build_gemini_body_packs(cfg, h, effort, sys_prompt, no_tools, ifx include_coax_intel then OA_PACK_COAX_INTEL else 0, out);
}

fww_build_gemini_body :: (cfg: [] FwConfig, h: [] FwHist, effort: string, sys_prompt: string, no_tools: bool, out: [] u8) -> int {
  return fww_build_gemini_body_packs(cfg, h, effort, sys_prompt, no_tools, 0, out);
}

fww_build_openai_body_packs :: (cfg: [] FwConfig, h: [] FwHist, model: string, effort: string, sys_prompt: string, is_local: bool, local_ctx: int, no_tools: bool, force_no_think: bool, packs_mask: int, out: [] u8) -> int {
  o: [1] Jo;
  jo_start(o[..], out);
  jo_obj(o[..]);
  jo_key(o[..], "model"); jo_str(o[..], model);
  eff_think_mode := ifx force_no_think then FLAWED_THINK_OFF else cfg[0].thinking_mode;
  mtok := ifx is_local && cfg[0].local_max_tokens > 0 && !force_no_think then cfg[0].local_max_tokens else flawed_wire_max_tokens(eff_think_mode, effort, is_local);
  if is_local && local_ctx > 0 && mtok > local_ctx / 2 { mtok = local_ctx / 2; }
  jo_key(o[..], "max_tokens"); jo_int(o[..], mtok);
  if is_local {
    if eff_think_mode == FLAWED_THINK_OFF {
      jo_key(o[..], "enable_thinking"); jo_bool(o[..], false);
      jo_key(o[..], "reasoning_effort"); jo_str(o[..], "none");
    } else {
      jo_key(o[..], "reasoning_effort"); jo_str(o[..], flawed_wire_local_effort(eff_think_mode, effort));
    }
    // Match Inky's proven interactive sampling defaults for Inkling 2 Mini & uncensored LoRA / AD quants.
    jo_key(o[..], "temperature"); jo_raw(o[..], "0.6");
    jo_key(o[..], "top_p"); jo_raw(o[..], "0.95");
    jo_key(o[..], "top_k"); jo_int(o[..], 40);
  } else if eff_think_mode != FLAWED_THINK_OFF && effort.count > 0 {
    jo_key(o[..], "reasoning_effort"); jo_str(o[..], flawed_wire_gemini_level(effort));
  }
  jo_key(o[..], "stream"); jo_bool(o[..], true);
  jo_key(o[..], "stream_options"); jo_raw(o[..], "{\"include_usage\":true}");

  if !no_tools {
    allowed := cast(string) cfg[0].allowed_tools[0..<cfg[0].nallowed];
    disallowed := cast(string) cfg[0].disallowed_tools[0..<cfg[0].ndisallowed];
    jo_key(o[..], "tools");
    _ = flawed_wire_write_tools_packs(o[..], false, allowed, disallowed, packs_mask);
  }

  jo_key(o[..], "messages");
  jo_arr(o[..]);
  // System message
  jo_obj(o[..]);
  jo_key(o[..], "role"); jo_str(o[..], "system");
  jo_key(o[..], "content"); jo_str(o[..], sys_prompt);
  jo_end(o[..]);

  last_oai_role := 0; // 0=none, 1=user/tool, 2=assistant
  for i: 0..<h[0].nmsgs {
    msg := h[0].msgs[i];
    if msg.role == FWW_MROLE_USER {
      jo_obj(o[..]);
      jo_key(o[..], "role"); jo_str(o[..], "user");
      txt := ifx msg.nblocks > 0 then fww_slab_str(h, msg.blocks[0].text_at, msg.blocks[0].text_n) else "";
      jo_key(o[..], "content"); jo_str(o[..], txt);
      jo_end(o[..]);
      last_oai_role = 1;
    } else if msg.role == FWW_MROLE_ASSISTANT {
      jo_obj(o[..]);
      jo_key(o[..], "role"); jo_str(o[..], "assistant");
      has_text := false;
      has_tools := false;
      has_think := false;
      for b: 0..<msg.nblocks {
        if msg.blocks[b].kind == FWW_MB_TEXT && msg.blocks[b].text_n > 0 { has_text = true; }
        if msg.blocks[b].kind == FWW_MB_TOOL_USE { has_tools = true; }
        if msg.blocks[b].kind == FWW_MB_THINK && msg.blocks[b].text_n > 0 { has_think = true; }
      }
      if has_text {
        jo_key(o[..], "content");
        for b: 0..<msg.nblocks {
          if msg.blocks[b].kind == FWW_MB_TEXT {
            jo_str(o[..], fww_slab_str(h, msg.blocks[b].text_at, msg.blocks[b].text_n));
            break;
          }
        }
      } else {
        jo_key(o[..], "content"); jo_raw(o[..], "null");
      }
      // Only replay reasoning_content on the immediately preceding assistant turn to prevent KV/prefill bloat on 32K local context.
      if is_local && has_think && i + 1 >= h[0].nmsgs {
        jo_key(o[..], "reasoning_content");
        for b: 0..<msg.nblocks {
          if msg.blocks[b].kind == FWW_MB_THINK {
            jo_str(o[..], fww_slab_str(h, msg.blocks[b].text_at, msg.blocks[b].text_n));
            break;
          }
        }
      }
      if has_tools {
        jo_key(o[..], "tool_calls");
        jo_arr(o[..]);
        for b: 0..<msg.nblocks {
          bk := msg.blocks[b];
          if bk.kind != FWW_MB_TOOL_USE { continue; }
          jo_obj(o[..]);
          jo_key(o[..], "id"); jo_str(o[..], fww_slab_str(h, bk.id_at, bk.id_n));
          jo_key(o[..], "type"); jo_str(o[..], "function");
          jo_key(o[..], "function");
          jo_obj(o[..]);
          jo_key(o[..], "name"); jo_str(o[..], fww_slab_str(h, bk.name_at, bk.name_n));
          inp := fww_slab_str(h, bk.text_at, bk.text_n);
          jo_key(o[..], "arguments"); jo_str(o[..], ifx inp.count > 0 then inp else "{}");
          jo_end(o[..]);
          jo_end(o[..]);
        }
        jo_end(o[..]);
      }
      jo_end(o[..]);
      last_oai_role = 2;
    } else if msg.role == FWW_MROLE_TOOL_RESULTS {
      has_tr_imgs := false;
      has_tr_txt := false;
      for b: 0..<msg.nblocks {
        bk := msg.blocks[b];
        if bk.kind == FWW_MB_TOOL_RES {
          jo_obj(o[..]);
          jo_key(o[..], "role"); jo_str(o[..], "tool");
          jo_key(o[..], "tool_call_id"); jo_str(o[..], fww_slab_str(h, bk.id_at, bk.id_n));
          if is_local && bk.name_n > 0 { jo_key(o[..], "name"); jo_str(o[..], fww_slab_str(h, bk.name_at, bk.name_n)); }
          jo_key(o[..], "content"); jo_str(o[..], fww_slab_str(h, bk.text_at, bk.text_n));
          if is_local && bk.is_error { jo_key(o[..], "is_error"); jo_bool(o[..], true); }
          jo_end(o[..]);
          last_oai_role = 1;
          if !is_local && bk.img_n > 0 && bk.img_mime_n > 0 { has_tr_imgs = true; }
        } else if bk.kind == FWW_MB_TEXT && bk.text_n > 0 {
          has_tr_txt = true;
        }
      }
      if has_tr_imgs {
        jo_obj(o[..]);
        jo_key(o[..], "role"); jo_str(o[..], "user");
        jo_key(o[..], "content");
        jo_arr(o[..]);
        for b: 0..<msg.nblocks {
          bk := msg.blocks[b];
          if bk.kind == FWW_MB_TOOL_RES && bk.img_n > 0 && bk.img_mime_n > 0 {
            jo_obj(o[..]);
            jo_key(o[..], "type"); jo_str(o[..], "text");
            jo_key(o[..], "text"); jo_str(o[..], fww_slab_str(h, bk.text_at, bk.text_n));
            jo_end(o[..]);
            jo_obj(o[..]);
            jo_key(o[..], "type"); jo_str(o[..], "image_url");
            jo_key(o[..], "image_url");
            jo_obj(o[..]);
            jo_key(o[..], "url");
            jo_value(o[..]);
            jo_put(o[..], "\"data:");
            jo_put(o[..], fww_slab_str(h, bk.img_mime_at, bk.img_mime_n));
            jo_put(o[..], ";base64,");
            jo_put(o[..], fww_slab_str(h, bk.img_at, bk.img_n));
            jo_put(o[..], "\"");
            jo_end(o[..]);
            jo_end(o[..]);
          }
        }
        if has_tr_txt {
          for b: 0..<msg.nblocks {
            bk := msg.blocks[b];
            if bk.kind == FWW_MB_TEXT && bk.text_n > 0 {
              jo_obj(o[..]);
              jo_key(o[..], "type"); jo_str(o[..], "text");
              jo_key(o[..], "text"); jo_str(o[..], fww_slab_str(h, bk.text_at, bk.text_n));
              jo_end(o[..]);
            }
          }
        }
        jo_end(o[..]);
        jo_end(o[..]);
        last_oai_role = 1;
      } else if has_tr_txt {
        for b: 0..<msg.nblocks {
          bk := msg.blocks[b];
          if bk.kind == FWW_MB_TEXT && bk.text_n > 0 {
            jo_obj(o[..]);
            jo_key(o[..], "role"); jo_str(o[..], "user");
            jo_key(o[..], "content"); jo_str(o[..], fww_slab_str(h, bk.text_at, bk.text_n));
            jo_end(o[..]);
            last_oai_role = 1;
          }
        }
      }
    }
  }
  if last_oai_role != 1 {
    jo_obj(o[..]);
    jo_key(o[..], "role"); jo_str(o[..], "user");
    jo_key(o[..], "content"); jo_str(o[..], "Continue and complete the user's request.");
    jo_end(o[..]);
  }
  jo_end(o[..]);
  jo_end(o[..]);
  return ifx o[0].bad then -1 else o[0].n;
}

fww_build_openai_body_ex :: (cfg: [] FwConfig, h: [] FwHist, model: string, effort: string, sys_prompt: string, is_local: bool, local_ctx: int, no_tools: bool, force_no_think: bool, include_coax_intel: bool, out: [] u8) -> int {
  return fww_build_openai_body_packs(cfg, h, model, effort, sys_prompt, is_local, local_ctx, no_tools, force_no_think, ifx include_coax_intel then OA_PACK_COAX_INTEL else 0, out);
}

fww_build_openai_body :: (cfg: [] FwConfig, h: [] FwHist, model: string, effort: string, sys_prompt: string, is_local: bool, local_ctx: int, no_tools: bool, force_no_think: bool, out: [] u8) -> int {
  return fww_build_openai_body_packs(cfg, h, model, effort, sys_prompt, is_local, local_ctx, no_tools, force_no_think, 0, out);
}

// ---------------------------------------------------------------- workspace tools implementation (8 Claude-Code-parity tools)

fww_resolve_path :: (cwd: string, raw: string, out: [] u8) -> string {
  if raw.count == 0 { return ""; }
  if raw[0] == '/' {
    n := fww_keep(out, raw);
    return cast(string) out[0..<n];
  }
  if raw.count >= 2 && raw[0] == '~' && raw[1] == '/' {
    hb: [1024] u8;
    home := cl_getenv("HOME", hb[..]);
    if home.count > 0 {
      return fs_join(home, cast(string) raw[2..<raw.count], out);
    }
  }
  return fs_join(cwd, raw, out);
}

// Format unified diff hunk for desktop UI's cp_act_edit (renders native +N/-M diff rows!).
fww_format_diff :: (old_s: string, new_s: string, out: [] u8) -> int {
  n := fww_cat(out, 0, "@@ -1 +1 @@\n");
  // Emit '-' lines for old_s
  i := 0;
  shown := 0;
  while i < old_s.count && shown < 24 && n + 128 < out.count {
    e := i;
    while e < old_s.count && old_s[e] != '\n' { e += 1; }
    n = fww_cat(out, n, "-");
    n = fww_cat(out, n, cast(string) old_s[i..<e]);
    n = fww_cat(out, n, "\n");
    i = e + 1; shown += 1;
  }
  // Emit '+' lines for new_s
  i = 0; shown = 0;
  while i < new_s.count && shown < 24 && n + 128 < out.count {
    e := i;
    while e < new_s.count && new_s[e] != '\n' { e += 1; }
    n = fww_cat(out, n, "+");
    n = fww_cat(out, n, cast(string) new_s[i..<e]);
    n = fww_cat(out, n, "\n");
    i = e + 1; shown += 1;
  }
  return n;
}

FwReadDedup :: struct {
  path_hash: int;
  offset: int;
  end_line: int;
  file_sz: int;
  content_hash: int;
  compact_epoch: int;
}

fww_str_hash :: (s: string) -> int {
  h := 2166136261;
  mod := 4294967291;
  for c: s { h = ((h * 131) + cast(int) c) % mod; }
  return ifx h == 0 then 1 else h;
}

// Hits when the exact range OR any sub-range is already covered by an earlier unchanged Read in this compaction epoch!
fww_read_dedup_hit :: (slots: [] FwReadDedup, path_hash: int, offset: int, req_end: int, file_sz: int, content_hash: int, compact_epoch: int) -> bool {
  for i: 0..<slots.count {
    if slots[i].path_hash == path_hash
       && slots[i].end_line > 0
       && offset >= slots[i].offset
       && req_end <= slots[i].end_line
       && slots[i].file_sz == file_sz
       && slots[i].content_hash == content_hash
       && slots[i].compact_epoch == compact_epoch {
      return true;
    }
  }
  return false;
}

fww_read_dedup_put :: (slots: [] FwReadDedup, cursor: [] int, path_hash: int, offset: int, end_line: int, file_sz: int, content_hash: int, compact_epoch: int) {
  for i: 0..<slots.count {
    if slots[i].path_hash == path_hash && slots[i].offset == offset {
      slots[i] = FwReadDedup.{path_hash = path_hash, offset = offset, end_line = end_line, file_sz = file_sz, content_hash = content_hash, compact_epoch = compact_epoch};
      return;
    }
  }
  idx := cursor[0] % slots.count;
  slots[idx] = FwReadDedup.{path_hash = path_hash, offset = offset, end_line = end_line, file_sz = file_sz, content_hash = content_hash, compact_epoch = compact_epoch};
  cursor[0] = (cursor[0] + 1) % slots.count;
}

fww_read_dedup_invalidate :: (slots: [] FwReadDedup, path_hash: int) {
  for i: 0..<slots.count {
    if slots[i].path_hash == path_hash { slots[i].path_hash = 0; }
  }
}

fww_count_lines :: (s: string) -> int {
  if s.count == 0 { return 0; }
  n := 1;
  for i: 0..<s.count {
    if s[i] == '\n' && i + 1 < s.count { n += 1; }
  }
  return n;
}

fww_line_num_at :: (s: string, byte_pos: int) -> int {
  ln := 1;
  lim := ifx byte_pos < s.count then byte_pos else s.count;
  for i: 0..<lim { if s[i] == '\n' { ln += 1; } }
  return ln;
}

fww_append_numbered_window :: (out: [] u8, at: int, content: string, from_line: int, to_line: int) -> int {
  n := at;
  ln := 1;
  i := 0;
  while i < content.count {
    e := i;
    while e < content.count && content[e] != '\n' { e += 1; }
    if ln >= from_line && ln <= to_line {
      if n + 64 >= out.count { break; }
      n = fww_put_int(out, n, ln);
      n = fww_cat(out, n, "\t");
      n = fww_cat(out, n, cast(string) content[i..<e]);
      n = fww_cat(out, n, "\n");
    }
    if ln > to_line { break; }
    ln += 1;
    i = e + 1;
  }
  return n;
}

// Trim trailing spaces/tabs/CR from a single line slice (for fallback edit matching).
fww_trim_line_end :: (s: string) -> string {
  b := s.count;
  while b > 0 && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\r') { b -= 1; }
  return cast(string) s[0..<b];
}

// Fallback edit matcher: matches `old_s` against `content` allowing trailing whitespace / CRLF differences per line.
// Returns count of matches, and writes the exact byte span [out_start[0]..<out_end[0]] in `content` of the first match.
fww_find_trimmed_match :: (content: string, old_s: string, out_start: [] int, out_end: [] int) -> int {
  // Extract old_s lines (up to 64 lines)
  ol_from: [64] int; ol_to: [64] int;
  nol := 0;
  p := 0;
  while p <= old_s.count && nol < 64 {
    e := p;
    while e < old_s.count && old_s[e] != '\n' { e += 1; }
    ol_from[nol] = p; ol_to[nol] = e;
    nol += 1;
    if e >= old_s.count { break; }
    p = e + 1;
  }
  if nol == 0 { return 0; }
  // If old_s ended with '\n', drop the empty trailing sentinel line
  has_trail_nl := old_s.count > 0 && old_s[old_s.count - 1] == '\n';
  if has_trail_nl && nol > 1 { nol -= 1; }

  // Walk lines of content and test window starting at each line
  matches := 0;
  ci := 0;
  while ci < content.count {
    ce := ci;
    while ce < content.count && content[ce] != '\n' { ce += 1; }
    t0 := fww_trim_line_end(cast(string) old_s[ol_from[0]..<ol_to[0]]);
    if fww_trim_line_end(cast(string) content[ci..<ce]) == t0 {
      ok := true;
      cur := ce;
      for k: 1..<nol {
        if cur >= content.count { ok = false; break; }
        ls := cur + 1;
        le := ls;
        while le < content.count && content[le] != '\n' { le += 1; }
        tk := fww_trim_line_end(cast(string) old_s[ol_from[k]..<ol_to[k]]);
        if fww_trim_line_end(cast(string) content[ls..<le]) != tk { ok = false; break; }
        cur = le;
      }
      if ok {
        end_b := ifx has_trail_nl && cur < content.count && content[cur] == '\n' then cur + 1 else cur;
        if matches == 0 { out_start[0] = ci; out_end[0] = end_b; }
        matches += 1;
      }
    }
    if ce >= content.count { break; }
    ci = ce + 1;
  }
  return matches;
}

// Find the closest matching line in `content` to lines in `old_s` (for actionable Edit diagnostics).
fww_find_nearest_line :: (content: string, old_s: string) -> int {
  best_from := 0; best_to := 0; best_len := 0;
  p := 0;
  while p < old_s.count {
    e := p;
    while e < old_s.count && old_s[e] != '\n' { e += 1; }
    t := fww_trim(cast(string) old_s[p..<e]);
    if t.count > best_len { best_from = p; best_to = e; best_len = t.count; }
    p = e + 1;
  }
  if best_len < 4 { return 0; }
  needle := fww_trim(cast(string) old_s[best_from..<best_to]);
  if needle.count > 64 { needle = cast(string) needle[0..<64]; }
  ln := 1;
  i := 0;
  while i < content.count {
    e := i;
    while e < content.count && content[e] != '\n' { e += 1; }
    if fww_contains_ci(cast(string) content[i..<e], needle) { return ln; }
    ln += 1;
    i = e + 1;
  }
  // Fallback 1: try any other non-trivial line in old_s (in case the longest line had the typo)
  p = 0;
  while p < old_s.count {
    e := p;
    while e < old_s.count && old_s[e] != '\n' { e += 1; }
    cand := fww_trim(cast(string) old_s[p..<e]);
    if cand.count >= 4 {
      if cand.count > 64 { cand = cast(string) cand[0..<64]; }
      ln = 1; i = 0;
      while i < content.count {
        ce := i;
        while ce < content.count && content[ce] != '\n' { ce += 1; }
        if fww_contains_ci(cast(string) content[i..<ce], cand) { return ln; }
        ln += 1;
        i = ce + 1;
      }
    }
    p = e + 1;
  }
  // Fallback 2: try first 20 chars of longest line
  if needle.count > 20 {
    short_n := cast(string) needle[0..<20];
    ln = 1; i = 0;
    while i < content.count {
      e := i;
      while e < content.count && content[e] != '\n' { e += 1; }
      if fww_contains_ci(cast(string) content[i..<e], short_n) { return ln; }
      ln += 1;
      i = e + 1;
    }
  }
  return 0;
}

// Detect top-level symbol/test/heading declarations across Coax, C/C++, Swift, Rust, Go, Python, TS/JS, and Markdown.
fww_is_outline_line :: (line: string) -> bool {
  if line.count < 4 { return false; }
  // Column-0 or 2-space indented declarations only (avoids noise inside function bodies)
  at := 0;
  if line[0] == ' ' && line.count > 2 && line[1] == ' ' && line[2] != ' ' { at = 2; }
  else if line[0] == ' ' || line[0] == '\t' { return false; }
  s := cast(string) line[at..<line.count];
  if s.count < 4 { return false; }
  if s[0] == '/' && s[1] == '/' { return false; }
  if flawed_aw_starts(s, "#test ") || flawed_aw_starts(s, "#forall ") || flawed_aw_starts(s, "## ") { return true; }
  if flawed_aw_starts(s, "fn ") || flawed_aw_starts(s, "pub fn ") || flawed_aw_starts(s, "func ") || flawed_aw_starts(s, "def ")
     || flawed_aw_starts(s, "class ") || flawed_aw_starts(s, "struct ") || flawed_aw_starts(s, "enum ")
     || flawed_aw_starts(s, "interface ") || flawed_aw_starts(s, "type ") || flawed_aw_starts(s, "export ")
     || flawed_aw_starts(s, "function ") || flawed_aw_starts(s, "public ") || flawed_aw_starts(s, "static ")
     || flawed_aw_starts(s, "impl ") || flawed_aw_starts(s, "async ") {
    return true;
  }
  // Coax top-level procedure/struct: `ident :: (` or `ident :: struct` / `enum`
  if at == 0 && ((s[0] >= 'a' && s[0] <= 'z') || (s[0] >= 'A' && s[0] <= 'Z') || s[0] == '_') {
    k := 1;
    while k < s.count && ((s[k] >= 'a' && s[k] <= 'z') || (s[k] >= 'A' && s[k] <= 'Z') || (s[k] >= '0' && s[k] <= '9') || s[k] == '_') { k += 1; }
    if k + 4 < s.count && s[k] == ' ' && s[k + 1] == ':' && s[k + 2] == ':' && s[k + 3] == ' ' {
      rest := cast(string) s[k + 4..<s.count];
      if rest.count > 0 && (rest[0] == '(' || flawed_aw_starts(rest, "struct") || flawed_aw_starts(rest, "enum")) {
        return true;
      }
    }
  }
  return false;
}

// Append a compact symbol outline of unread lines (from_line..total_lines) when Read truncates a large file,
// letting the model jump straight to target functions via offset/limit instead of paginating blindly.
fww_append_symbol_outline :: (out: [] u8, at: int, content: string, from_line: int, total_lines: int) -> int {
  n := at;
  if from_line > total_lines || n + 256 >= out.count { return n; }
  header_written := false;
  hits := 0;
  ln := 1;
  i := 0;
  while i < content.count && hits < 64 && n + 128 < out.count {
    e := i;
    while e < content.count && content[e] != '\n' { e += 1; }
    if ln >= from_line {
      line := cast(string) content[i..<e];
      if fww_is_outline_line(line) {
        if !header_written {
          n = fww_cat(out, n, "\n[Outline of remaining lines ");
          n = fww_put_int(out, n, from_line);
          n = fww_cat(out, n, "-");
          n = fww_put_int(out, n, total_lines);
          n = fww_cat(out, n, ":]\n");
          header_written = true;
        }
        t := fww_trim(line);
        if t.count > 76 { t = cast(string) t[0..<fww_utf8_cut(t, 76)]; }
        n = fww_cat(out, n, "  L");
        n = fww_put_int(out, n, ln);
        n = fww_cat(out, n, ": ");
        n = fww_cat(out, n, t);
        n = fww_cat(out, n, "\n");
        hits += 1;
      }
    }
    ln += 1;
    i = e + 1;
  }
  return n;
}

// Detect binary files (NUL byte or >15% non-text control/invalid-UTF-8 bytes in first 4 KiB).
fww_is_binary_bytes :: (s: string) -> bool {
  if s.count == 0 { return false; }
  lim := ifx s.count < 4096 then s.count else 4096;
  bad := 0;
  i := 0;
  while i < lim {
    b := s[i];
    if b == 0 { return true; }
    if b == 9 || b == 10 || b == 13 || (b >= 32 && b <= 126) {
      i += 1; continue;
    }
    if b >= 0xC2 && b <= 0xDF && i + 1 < lim && (s[i + 1] & 0xC0) == 0x80 {
      if b == 0xC2 && s[i + 1] < 0xA0 { bad += 2; }
      i += 2; continue;
    }
    if b >= 0xE0 && b <= 0xEF && i + 2 < lim && (s[i + 1] & 0xC0) == 0x80 && (s[i + 2] & 0xC0) == 0x80 {
      i += 3; continue;
    }
    if b >= 0xF0 && b <= 0xF4 && i + 3 < lim && (s[i + 1] & 0xC0) == 0x80 && (s[i + 2] & 0xC0) == 0x80 && (s[i + 3] & 0xC0) == 0x80 {
      i += 4; continue;
    }
    bad += 1;
    i += 1;
  }
  return lim >= 64 && bad * 100 > lim * 15;
}

// Sanitize arbitrary subprocess output into valid UTF-8, stripping CR/C0/C1 control noise and
// collapsing raw binary runs (>=4 invalid/control bytes) into `[binary]` so JSONL wire logs stay
// 100% valid and binary dumps never inflate LLM context with thousands of byte-fallback tokens.
fww_sanitize_text_line :: (src: string, dst: [] u8) -> int {
  n := 0;
  i := 0;
  bad_run := 0;
  while i < src.count && n + 16 < dst.count {
    b := src[i];
    if b == 13 {
      i += 1; continue;
    }
    if b == 9 || b == 10 || (b >= 32 && b <= 126) {
      bad_run = 0;
      dst[n] = b; n += 1; i += 1; continue;
    }
    if b >= 0xC2 && b <= 0xDF && i + 1 < src.count && (src[i + 1] & 0xC0) == 0x80 {
      if !(b == 0xC2 && src[i + 1] < 0xA0) {
        bad_run = 0;
        dst[n] = b; dst[n + 1] = src[i + 1]; n += 2; i += 2; continue;
      }
      i += 2;
    } else if b >= 0xE0 && b <= 0xEF && i + 2 < src.count && (src[i + 1] & 0xC0) == 0x80 && (src[i + 2] & 0xC0) == 0x80 {
      bad_run = 0;
      dst[n] = b; dst[n + 1] = src[i + 1]; dst[n + 2] = src[i + 2]; n += 3; i += 3; continue;
    } else if b >= 0xF0 && b <= 0xF4 && i + 3 < src.count && (src[i + 1] & 0xC0) == 0x80 && (src[i + 2] & 0xC0) == 0x80 && (src[i + 3] & 0xC0) == 0x80 {
      bad_run = 0;
      dst[n] = b; dst[n + 1] = src[i + 1]; dst[n + 2] = src[i + 2]; dst[n + 3] = src[i + 3]; n += 4; i += 4; continue;
    } else {
      i += 1;
    }
    bad_run += 1;
    if bad_run == 1 {
      dst[n] = '?'; n += 1;
    } else if bad_run == 4 {
      if n > 0 && dst[n - 1] == '?' { n -= 1; }
      n = fww_cat(dst, n, "[binary]");
    }
  }
  return n;
}

// ---------------------------------------------------------------- native image reading (Claude Code FileReadTool + imageResizer parity)

fww_path_ext_lower :: (path: string, out: [] u8) -> string {
  dot := -1;
  i := path.count - 1;
  while i >= 0 {
    if path[i] == '/' || path[i] == '\\' { break; }
    if path[i] == '.' { dot = i; break; }
    i -= 1;
  }
  if dot < 0 || dot + 1 >= path.count { return ""; }
  n := 0;
  for k: (dot + 1)..<path.count {
    if n >= out.count { break; }
    c := path[k];
    if c >= 'A' && c <= 'Z' { c += 32; }
    out[n] = c; n += 1;
  }
  return cast(string) out[0..<n];
}

fww_is_image_ext :: (ext: string) -> bool {
  return ext == "png" || ext == "jpg" || ext == "jpeg" || ext == "gif"
      || ext == "webp" || ext == "bmp" || ext == "tif" || ext == "tiff" || ext == "heic";
}

fww_is_web_image_mime :: (mime: string) -> bool {
  return mime == "image/png" || mime == "image/jpeg" || mime == "image/gif" || mime == "image/webp";
}

// Claude Code FileReadTool getAlternateScreenshotPath: macOS uses either ASCII space (0x20)
// or narrow no-break space U+202F (UTF-8 E2 80 AF) before AM/PM in screenshot filenames.
fww_alt_screenshot_path :: (path: string, out: [] u8) -> string {
  // Match suffix: (<space> | \xE2\x80\xAF) (AM|PM) (.png|.jpg|.jpeg)
  ext_b: [16] u8;
  ext := fww_path_ext_lower(path, ext_b[..]);
  if ext != "png" && ext != "jpg" && ext != "jpeg" { return ""; }
  ext_len := ext.count + 1; // includes '.'
  if path.count < ext_len + 4 { return ""; }
  ampm_pos := path.count - ext_len - 2;
  c0 := path[ampm_pos]; c1 := path[ampm_pos + 1];
  if !((c0 == 'A' || c0 == 'P') && c1 == 'M') { return ""; }
  if ampm_pos >= 1 && path[ampm_pos - 1] == ' ' {
    // Replace ' ' with UTF-8 U+202F (0xE2 0x80 0xAF)
    n := fww_cat(out, 0, cast(string) path[0..<ampm_pos - 1]);
    if n + 3 >= out.count { return ""; }
    out[n] = 0xE2; out[n + 1] = 0x80; out[n + 2] = 0xAF; n += 3;
    n = fww_cat(out, n, cast(string) path[ampm_pos..<path.count]);
    return cast(string) out[0..<n];
  }
  if ampm_pos >= 3 && path[ampm_pos - 3] == 0xE2 && path[ampm_pos - 2] == 0x80 && path[ampm_pos - 1] == 0xAF {
    // Replace UTF-8 U+202F with regular space ' '
    n := fww_cat(out, 0, cast(string) path[0..<ampm_pos - 3]);
    if n + 1 >= out.count { return ""; }
    out[n] = ' '; n += 1;
    n = fww_cat(out, n, cast(string) path[ampm_pos..<path.count]);
    return cast(string) out[0..<n];
  }
  return "";
}

// Claude Code imageResizer detectImageFormatFromBuffer: inspect real magic bytes (not extension).
fww_detect_image_mime :: (data: string) -> string {
  if data.count >= 8 && data[0] == 0x89 && data[1] == 0x50 && data[2] == 0x4E && data[3] == 0x47
     && data[4] == 0x0D && data[5] == 0x0A && data[6] == 0x1A && data[7] == 0x0A {
    return "image/png";
  }
  if data.count >= 3 && data[0] == 0xFF && data[1] == 0xD8 && data[2] == 0xFF {
    return "image/jpeg";
  }
  if data.count >= 6 && data[0] == 'G' && data[1] == 'I' && data[2] == 'F' && data[3] == '8'
     && (data[4] == '7' || data[4] == '9') && data[5] == 'a' {
    return "image/gif";
  }
  if data.count >= 12 && data[0] == 'R' && data[1] == 'I' && data[2] == 'F' && data[3] == 'F'
     && data[8] == 'W' && data[9] == 'E' && data[10] == 'B' && data[11] == 'P' {
    return "image/webp";
  }
  if data.count >= 2 && data[0] == 'B' && data[1] == 'M' {
    return "image/bmp";
  }
  if data.count >= 4 && ((data[0] == 'I' && data[1] == 'I' && data[2] == 42 && data[3] == 0)
                      || (data[0] == 'M' && data[1] == 'M' && data[2] == 0 && data[3] == 42)) {
    return "image/tiff";
  }
  if data.count >= 12 && data[4] == 'f' && data[5] == 't' && data[6] == 'y' && data[7] == 'p' {
    b0 := data[8]; b1 := data[9]; b2 := data[10]; b3 := data[11];
    if (b0 == 'h' && b1 == 'e' && b2 == 'i' && (b3 == 'c' || b3 == 'x'))
       || (b0 == 'm' && b1 == 'i' && b2 == 'f' && b3 == '1')
       || (b0 == 'm' && b1 == 's' && b2 == 'f' && b3 == '1')
       || (b0 == 'h' && b1 == 'e' && b2 == 'v' && b3 == 'c') {
      return "image/heic";
    }
  }
  return "";
}

// Pure-Coax image header dimension parser (PNG, GIF, JPEG, WebP) — zero subprocess overhead.
fww_image_dims :: (data: string, mime: string, out_w: [] int, out_h: [] int) -> bool {
  out_w[0] = 0; out_h[0] = 0;
  if mime == "image/png" && data.count >= 24 {
    w := (cast(int) data[16] << 24) | (cast(int) data[17] << 16) | (cast(int) data[18] << 8) | cast(int) data[19];
    h := (cast(int) data[20] << 24) | (cast(int) data[21] << 16) | (cast(int) data[22] << 8) | cast(int) data[23];
    if w > 0 && h > 0 { out_w[0] = w; out_h[0] = h; return true; }
    return false;
  }
  if mime == "image/gif" && data.count >= 10 {
    w := cast(int) data[6] | (cast(int) data[7] << 8);
    h := cast(int) data[8] | (cast(int) data[9] << 8);
    if w > 0 && h > 0 { out_w[0] = w; out_h[0] = h; return true; }
    return false;
  }
  if mime == "image/jpeg" && data.count >= 4 {
    i := 2;
    while i + 4 < data.count {
      if data[i] != 0xFF { i += 1; continue; }
      while i < data.count && data[i] == 0xFF { i += 1; }
      if i >= data.count { break; }
      m := data[i]; i += 1;
      if m == 0xD9 || m == 0xDA { break; } // EOI / SOS
      if m == 0x01 || (m >= 0xD0 && m <= 0xD8) { continue; } // standalone markers
      if i + 2 > data.count { break; }
      seg_len := (cast(int) data[i] << 8) | cast(int) data[i + 1];
      if seg_len < 2 || i + seg_len > data.count { break; }
      is_sof := (m >= 0xC0 && m <= 0xC3) || (m >= 0xC5 && m <= 0xC7) || (m >= 0xC9 && m <= 0xCB) || (m >= 0xCD && m <= 0xCF);
      if is_sof && seg_len >= 7 {
        h := (cast(int) data[i + 3] << 8) | cast(int) data[i + 4];
        w := (cast(int) data[i + 5] << 8) | cast(int) data[i + 6];
        if w > 0 && h > 0 { out_w[0] = w; out_h[0] = h; return true; }
        return false;
      }
      i += seg_len;
    }
    return false;
  }
  if mime == "image/webp" && data.count >= 30 {
    if data[12] == 'V' && data[13] == 'P' && data[14] == '8' && data[15] == 'X' {
      w := 1 + (cast(int) data[24] | (cast(int) data[25] << 8) | (cast(int) data[26] << 16));
      h := 1 + (cast(int) data[27] | (cast(int) data[28] << 8) | (cast(int) data[29] << 16));
      if w > 0 && h > 0 { out_w[0] = w; out_h[0] = h; return true; }
    } else if data[12] == 'V' && data[13] == 'P' && data[14] == '8' && data[15] == 'L' && data.count >= 25 {
      b0 := cast(int) data[21]; b1 := cast(int) data[22]; b2 := cast(int) data[23]; b3 := cast(int) data[24];
      w := 1 + (b0 | ((b1 & 0x3F) << 8));
      h := 1 + ((b1 >> 6) | (b2 << 2) | ((b3 & 0x0F) << 10));
      if w > 0 && h > 0 { out_w[0] = w; out_h[0] = h; return true; }
    } else if data[12] == 'V' && data[13] == 'P' && data[14] == '8' && data[15] == ' ' && data.count >= 30 {
      w := (cast(int) data[26] | (cast(int) data[27] << 8)) & 0x3FFF;
      h := (cast(int) data[28] | (cast(int) data[29] << 8)) & 0x3FFF;
      if w > 0 && h > 0 { out_w[0] = w; out_h[0] = h; return true; }
    }
  }
  return false;
}

// Run macOS native /usr/bin/sips (argv-safe, zero shell) to resize/re-encode an image to dst_path.
fww_sips_convert :: (src_path: string, dst_path: string, fmt: string, max_dim: int, jpeg_q: int) -> bool {
  if tool_os() == TOOL_LINUX { return false; }
  h := proc_new();
  if h < 0 { return false; }
  ok := proc_arg(h, "/usr/bin/sips");
  if max_dim > 0 {
    db: [24] u8; dn := fww_put_int(db[..], 0, max_dim);
    ok = ok && proc_arg(h, "-Z") && proc_arg(h, cast(string) db[0..<dn]);
  }
  ok = ok && proc_arg(h, "-s") && proc_arg(h, "format") && proc_arg(h, fmt);
  if fmt == "jpeg" && jpeg_q > 0 {
    qb: [24] u8; qn := fww_put_int(qb[..], 0, jpeg_q);
    ok = ok && proc_arg(h, "-s") && proc_arg(h, "formatOptions") && proc_arg(h, cast(string) qb[0..<qn]);
  }
  ok = ok && proc_arg(h, src_path) && proc_arg(h, "-o") && proc_arg(h, dst_path);
  ran_ok := false;
  if ok && proc_start(h) == 0 {
    _ = proc_close_stdin(h);
    ec := proc_wait(h, 15000);
    ran_ok = ec == 0 && fs_exists(dst_path);
  }
  _ = proc_release(h);
  return ran_ok;
}

// Linux fallback image resizer via python3 PIL (argv-safe, zero shell).
fww_py_convert :: (src_path: string, dst_path: string, max_dim: int, jpeg_q: int) -> bool {
  h := proc_new();
  if h < 0 { return false; }
  db: [24] u8; dn := fww_put_int(db[..], 0, max_dim);
  qb: [24] u8; qn := fww_put_int(qb[..], 0, jpeg_q);
  py := "import sys; from PIL import Image; im=Image.open(sys.argv[1]); d=int(sys.argv[3]); (d>0 and im.thumbnail((d,d))); im=im.convert('RGB'); im.save(sys.argv[2], format='JPEG', quality=int(sys.argv[4]), optimize=True)";
  ok := proc_arg(h, "python3") && proc_arg(h, "-c") && proc_arg(h, py)
     && proc_arg(h, src_path) && proc_arg(h, dst_path)
     && proc_arg(h, cast(string) db[0..<dn]) && proc_arg(h, cast(string) qb[0..<qn]);
  ran_ok := false;
  if ok && proc_start(h) == 0 {
    _ = proc_close_stdin(h);
    ec := proc_wait(h, 15000);
    ran_ok = ec == 0 && fs_exists(dst_path);
  }
  _ = proc_release(h);
  return ran_ok;
}

// Read, validate, optionally resize/compress, and base64-encode an image file (Claude Code imageResizer parity).
// Writes human/model metadata text into out_meta, MIME into out_mime, and base64 into out_b64.
fww_load_image_file :: (
  raw_path: string, full_path: string, is_local: bool,
  raw_buf: [] u8, out_meta: [] u8,
  out_mime: [] u8, out_mime_n: [] int,
  out_b64: [] u8, out_b64_n: [] int,
  is_err: [] bool
) -> int {
  out_mime_n[0] = 0;
  out_b64_n[0] = 0;
  orig_sz := fs_size(full_path);
  if orig_sz < 0 {
    is_err[0] = true;
    return fww_keep(out_meta, "Failed to inspect image file.");
  }
  if orig_sz == 0 {
    is_err[0] = true;
    return fww_keep(out_meta, "Image file is empty (0 bytes).");
  }
  // Read header (or whole file when it fits in raw_buf) to detect real magic bytes & original dimensions.
  hdr_n := ifx orig_sz <= raw_buf.count then fs_read(full_path, raw_buf) else fs_read_at(full_path, 0, raw_buf[0..<65536]);
  if hdr_n <= 0 {
    is_err[0] = true;
    return fww_keep(out_meta, "Failed to read image file.");
  }
  hdr_s := cast(string) raw_buf[0..<hdr_n];
  orig_mime := fww_detect_image_mime(hdr_s);
  if orig_mime.count == 0 {
    is_err[0] = true;
    return fww_keep(out_meta, "File does not have a valid image header (supported: PNG, JPEG, GIF, WebP, BMP, TIFF, HEIC).");
  }
  ow := [1] int.[0]; oh := [1] int.[0];
  _ = fww_image_dims(hdr_s, orig_mime, ow[..], oh[..]);

  final_mime := orig_mime;
  final_sz := 0;
  final_w := ow[0]; final_h := oh[0];
  resized := false;

  // Fast path: already web-safe format, within raw size target, and within 2000x2000 dimension cap -> zero subprocesses!
  dims_ok := (ow[0] == 0 && oh[0] == 0) || (ow[0] <= FWW_IMG_MAX_DIM && oh[0] <= FWW_IMG_MAX_DIM);
  if fww_is_web_image_mime(orig_mime) && orig_sz <= FWW_IMG_RAW_TARGET && orig_sz <= raw_buf.count && dims_ok {
    final_sz = hdr_n;
  } else {
    // Resize / compress into a temp file following Claude Code imageResizer.ts strategy:
    //   1) If PNG/BMP/TIFF and resize needed or format conversion needed: try PNG at <=2000px first (only if it fits target).
    //   2) Progressive JPEG at q=80, 60, 40, 20 (max dim 2000px only when orig exceeds 2000px or unknown oversized).
    //   3) Aggressive fallback: 1000px q=20, then 768px q=15.
    tmp_png_b: [128] u8; tmp_jpg_b: [128] u8;
    ts_us := cxproc_wall_us();
    pn := fww_cat(tmp_png_b[..], 0, "/tmp/oa-read-img-");
    pn = fww_put_int(tmp_png_b[..], pn, ts_us);
    pn = fww_cat(tmp_png_b[..], pn, ".png");
    tmp_png := cast(string) tmp_png_b[0..<pn];

    jn := fww_cat(tmp_jpg_b[..], 0, "/tmp/oa-read-img-");
    jn = fww_put_int(tmp_jpg_b[..], jn, ts_us);
    jn = fww_cat(tmp_jpg_b[..], jn, ".jpg");
    tmp_jpg := cast(string) tmp_jpg_b[0..<jn];

    need_cap := ow[0] > FWW_IMG_MAX_DIM || oh[0] > FWW_IMG_MAX_DIM;
    cap_dim := ifx need_cap then FWW_IMG_MAX_DIM else 0;

    // Step 1: Try PNG preservation for PNG/BMP/TIFF when output fits target
    if (orig_mime == "image/png" || orig_mime == "image/bmp" || orig_mime == "image/tiff") && fww_sips_convert(full_path, tmp_png, "png", cap_dim, 0) {
      psz := fs_size(tmp_png);
      if psz > 0 && psz <= FWW_IMG_RAW_TARGET && psz <= raw_buf.count {
        rn := fs_read(tmp_png, raw_buf);
        if rn > 0 {
          final_sz = rn;
          final_mime = "image/png";
          fw := [1] int.[0]; fh := [1] int.[0];
          if fww_image_dims(cast(string) raw_buf[0..<rn], final_mime, fw[..], fh[..]) {
            final_w = fw[0]; final_h = fh[0];
          }
          resized = true;
        }
      }
      _ = fs_remove(tmp_png);
    }

    // Step 2: Progressive JPEG compression (q=80, 60, 40, 20)
    if final_sz == 0 {
      quals := [4] int.[80, 60, 40, 20];
      for qi: 0..<4 {
        q := quals[qi];
        ok_c := fww_sips_convert(full_path, tmp_jpg, "jpeg", cap_dim, q);
        if !ok_c { ok_c = fww_py_convert(full_path, tmp_jpg, cap_dim, q); }
        if ok_c {
          jsz := fs_size(tmp_jpg);
          if jsz > 0 && jsz <= FWW_IMG_RAW_TARGET && jsz <= raw_buf.count {
            rn := fs_read(tmp_jpg, raw_buf);
            if rn > 0 {
              final_sz = rn;
              final_mime = "image/jpeg";
              fw := [1] int.[0]; fh := [1] int.[0];
              if fww_image_dims(cast(string) raw_buf[0..<rn], final_mime, fw[..], fh[..]) {
                final_w = fw[0]; final_h = fh[0];
              }
              resized = true;
              break;
            }
          }
        }
      }
    }

    // Step 3: Aggressive fallback (<=1000px q=20, then <=768px q=15)
    if final_sz == 0 {
      fb_dims := [2] int.[FWW_IMG_AGGRESSIVE_DIM, 768];
      fb_qs := [2] int.[20, 15];
      for fi: 0..<2 {
        ok_c := fww_sips_convert(full_path, tmp_jpg, "jpeg", fb_dims[fi], fb_qs[fi]);
        if !ok_c { ok_c = fww_py_convert(full_path, tmp_jpg, fb_dims[fi], fb_qs[fi]); }
        if ok_c {
          jsz := fs_size(tmp_jpg);
          if jsz > 0 && jsz <= FWW_IMG_RAW_TARGET && jsz <= raw_buf.count {
            rn := fs_read(tmp_jpg, raw_buf);
            if rn > 0 {
              final_sz = rn;
              final_mime = "image/jpeg";
              fw := [1] int.[0]; fh := [1] int.[0];
              if fww_image_dims(cast(string) raw_buf[0..<rn], final_mime, fw[..], fh[..]) {
                final_w = fw[0]; final_h = fh[0];
              }
              resized = true;
              break;
            }
          }
        }
      }
    }
    _ = fs_remove(tmp_jpg);

    // Final fallback: if conversion unavailable on host, pass through raw bytes if web-safe and within hard base64 capacity.
    if final_sz == 0 && fww_is_web_image_mime(orig_mime) && orig_sz <= FWW_IMG_RAW_TARGET && orig_sz <= raw_buf.count {
      rn := fs_read(full_path, raw_buf);
      if rn > 0 { final_sz = rn; final_mime = orig_mime; }
    }
    if final_sz == 0 {
      is_err[0] = true;
      return fww_keep(out_meta, "Image exceeds size limit and could not be resized/compressed to fit. Resize or crop the image and retry.");
    }
  }

  // Base64-encode into out_b64 (if caller has capacity in tool_img_slab).
  enc_need := base64_encode_size(final_sz);
  if enc_need <= 0 || enc_need > out_b64.count || enc_need > FWW_IMG_B64_MAX {
    is_err[0] = true;
    return fww_keep(out_meta, "Encoded image exceeds tool result buffer capacity.");
  }
  b64_r := base64_encode_checked(cast(string) raw_buf[0..<final_sz], out_b64, false);
  if b64_r.error != NC_OK || b64_r.written <= 0 {
    is_err[0] = true;
    return fww_keep(out_meta, "Failed to base64-encode image.");
  }
  out_mime_n[0] = fww_keep(out_mime, final_mime);
  out_b64_n[0] = b64_r.written;

  // Format Claude Code-style image metadata text (with coordinate scale info when resized).
  n := fww_cat(out_meta, 0, "[Image: ");
  n = fww_cat(out_meta, n, raw_path);
  n = fww_cat(out_meta, n, " | ");
  n = fww_cat(out_meta, n, final_mime);
  if final_w > 0 && final_h > 0 {
    n = fww_cat(out_meta, n, " | ");
    n = fww_put_int(out_meta, n, final_w);
    n = fww_cat(out_meta, n, "x");
    n = fww_put_int(out_meta, n, final_h);
  }
  n = fww_cat(out_meta, n, " | ");
  n = fww_put_int(out_meta, n, final_sz);
  n = fww_cat(out_meta, n, " bytes");
  if resized && ow[0] > 0 && oh[0] > 0 && (ow[0] != final_w || oh[0] != final_h) {
    n = fww_cat(out_meta, n, " (resized from ");
    n = fww_put_int(out_meta, n, ow[0]);
    n = fww_cat(out_meta, n, "x");
    n = fww_put_int(out_meta, n, oh[0]);
    n = fww_cat(out_meta, n, ")");
  }
  if is_local {
    n = fww_cat(out_meta, n, "] Image decoded, but the active local text-only model cannot inspect image pixels directly. Switch to a vision-capable cloud model (e.g. Gemini) to inspect this image visually.");
  } else {
    n = fww_cat(out_meta, n, "] Image attached natively in this tool result.");
  }
  return n;
}

fww_tool_read :: (cwd: string, args_json: string, fc: FlawedFileCache, dedup: [] FwReadDedup, dedup_cur: [] int, compact_epoch: int, is_local: bool, fbuf: [] u8, out_res: [] u8, out_img_mime: [] u8, out_img_mime_n: [] int, out_img_b64: [] u8, out_img_b64_n: [] int, is_err: [] bool, wire_out: [] u8) -> int {
  is_err[0] = false;
  out_img_mime_n[0] = 0;
  out_img_b64_n[0] = 0;
  nodes: [128] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) {
    is_err[0] = true; return fww_keep(out_res, "Invalid JSON arguments for Read.");
  }
  pb_raw: [1024] u8;
  pn := jv_str(d[0], jv_get(d[0], 0, "file_path"), pb_raw[..]);
  if pn <= 0 { pn = jv_str(d[0], jv_get(d[0], 0, "path"), pb_raw[..]); }
  if pn <= 0 { is_err[0] = true; return fww_keep(out_res, "Read requires file_path."); }
  raw_path := cast(string) pb_raw[0..<pn];
  def_lim := ifx is_local then FWW_READ_LOCAL_LINES else FWW_READ_CLOUD_LINES;
  offset := jv_int(d[0], jv_get(d[0], 0, "offset"), 1);
  limit := jv_int(d[0], jv_get(d[0], 0, "limit"), def_lim);
  if offset < 1 { offset = 1; }
  if limit < 1 { limit = def_lim; }
  if limit > 2000 { limit = 2000; }

  rval := flawed_read_validate_input(raw_path, false, offset, limit);
  if rval == FLAWED_RVAL_BLOCKED_DEVICE {
    is_err[0] = true; return fww_keep(out_res, "Refused: blocked special device file.");
  }

  full_b: [FS_PATH_MAX] u8;
  alt_b: [FS_PATH_MAX] u8;
  full := fww_resolve_path(cwd, raw_path, full_b[..]);
  if full.count > 0 && !fs_exists(full) {
    alt := fww_alt_screenshot_path(full, alt_b[..]);
    if alt.count > 0 && fs_exists(alt) {
      full = alt;
    }
  }
  if full.count == 0 || !fs_exists(full) {
    fww_send(wire_out, mww_view(wire_out, raw_path, false));
    is_err[0] = true;
    n := fww_cat(out_res, 0, "File not found: ");
    return fww_cat(out_res, n, raw_path);
  }

  // Native image handling (Claude Code FileReadTool parity): check image extensions BEFORE text fs_read
  // so multi-megabyte Retina screenshots never hit FWW_FILE_MAX or the binary rejection path!
  ext_b: [16] u8;
  ext := fww_path_ext_lower(full, ext_b[..]);
  if fww_is_image_ext(ext) {
    mn := fww_load_image_file(raw_path, full, is_local, fbuf, out_res, out_img_mime, out_img_mime_n, out_img_b64, out_img_b64_n, is_err);
    fww_send(wire_out, mww_view(wire_out, raw_path, !is_err[0]));
    return mn;
  }

  sz := fs_read(full, fbuf);
  if sz < 0 {
    fww_send(wire_out, mww_view(wire_out, raw_path, false));
    is_err[0] = true;
    return fww_keep(out_res, "Failed to read file.");
  }
  content := cast(string) fbuf[0..<sz];
  if fww_is_binary_bytes(content) {
    // Magic-byte sniff: even extensionless / misnamed image files are handled natively as images!
    if fww_detect_image_mime(content).count > 0 {
      mn := fww_load_image_file(raw_path, full, is_local, fbuf, out_res, out_img_mime, out_img_mime_n, out_img_b64, out_img_b64_n, is_err);
      fww_send(wire_out, mww_view(wire_out, raw_path, !is_err[0]));
      return mn;
    }
    fww_send(wire_out, mww_view(wire_out, raw_path, true));
    bn := fww_cat(out_res, 0, "[Binary file: ");
    bn = fww_cat(out_res, bn, raw_path);
    bn = fww_cat(out_res, bn, " (");
    bn = fww_put_int(out_res, bn, sz);
    return fww_cat(out_res, bn, " bytes). Use Bash with python3/file/xxd to inspect binary formats instead of Read.]");
  }
  total_lines := fww_count_lines(content);
  _ = flawed_fc_put(fc, full, content, 1, cast(u64) sz, proc_now_ms(), offset, limit, false);
  fww_send(wire_out, mww_view(wire_out, raw_path, true));

  // Claude Code FILE_UNCHANGED_STUB dedup (exact OR sub-range coverage): avoid burning tokens re-reading unchanged ranges!
  ph := fww_str_hash(full);
  ch := fww_str_hash(content);
  req_end := offset + limit - 1;
  if req_end > total_lines { req_end = total_lines; }
  if dedup.count > 0 && total_lines > 0 && offset <= total_lines && fww_read_dedup_hit(dedup, ph, offset, req_end, sz, ch, compact_epoch) {
    rn := fww_cat(out_res, 0, "File unchanged since last read (");
    rn = fww_cat(out_res, rn, raw_path);
    rn = fww_cat(out_res, rn, ", lines ");
    rn = fww_put_int(out_res, rn, offset);
    rn = fww_cat(out_res, rn, "-");
    rn = fww_put_int(out_res, rn, req_end);
    rn = fww_cat(out_res, rn, " of ");
    rn = fww_put_int(out_res, rn, total_lines);
    rn = fww_cat(out_res, rn, "). The content from the earlier Read tool_result in this conversation is still current — refer to that instead of re-reading.");
    return rn;
  }

  // Emit range header + numbered lines from offset..<offset+limit + explicit continuation hint if truncated
  max_read_b := ifx is_local then FWW_LOCAL_TOOL_OUT_MAX else FWW_READ_CLOUD_BYTES;
  if max_read_b > out_res.count { max_read_b = out_res.count; }
  n := fww_cat(out_res, 0, "[File: ");
  n = fww_cat(out_res, n, raw_path);
  n = fww_cat(out_res, n, " | total lines: ");
  n = fww_put_int(out_res, n, total_lines);
  n = fww_cat(out_res, n, " | showing from line ");
  n = fww_put_int(out_res, n, offset);
  n = fww_cat(out_res, n, "]\n");

  line_no := 1;
  shown := 0;
  last_shown := 0;
  byte_capped := false;
  i := 0;
  while i < content.count {
    e := i;
    while e < content.count && content[e] != '\n' { e += 1; }
    if line_no >= offset && shown < limit {
      if n + (e - i) + 128 >= max_read_b {
        byte_capped = true;
        break;
      }
      n = fww_put_int(out_res, n, line_no);
      n = fww_cat(out_res, n, "\t");
      n = fww_cat(out_res, n, cast(string) content[i..<e]);
      n = fww_cat(out_res, n, "\n");
      shown += 1;
      last_shown = line_no;
    }
    line_no += 1;
    i = e + 1;
  }
  if shown == 0 {
    n = fww_cat(out_res, 0, "(empty file or offset past EOF; total lines: ");
    n = fww_put_int(out_res, n, total_lines);
    n = fww_cat(out_res, n, ")");
  } else {
    if last_shown < total_lines {
      n = fww_cat(out_res, n, "... [showing lines ");
      n = fww_put_int(out_res, n, offset);
      n = fww_cat(out_res, n, "-");
      n = fww_put_int(out_res, n, last_shown);
      n = fww_cat(out_res, n, " of ");
      n = fww_put_int(out_res, n, total_lines);
      if byte_capped { n = fww_cat(out_res, n, " (size limit reached)"); }
      n = fww_cat(out_res, n, "; pass offset=");
      n = fww_put_int(out_res, n, last_shown + 1);
      n = fww_cat(out_res, n, " to read more]");
      if !is_local {
        n = fww_append_symbol_outline(out_res, n, content, last_shown + 1, total_lines);
      }
    }
    if dedup.count > 0 && dedup_cur.count > 0 {
      fww_read_dedup_put(dedup, dedup_cur, ph, offset, last_shown, sz, ch, compact_epoch);
    }
  }
  return n;
}

fww_tool_edit :: (cwd: string, args_json: string, fc: FlawedFileCache, dedup: [] FwReadDedup, fbuf: [] u8, ebuf: [] u8, out_res: [] u8, is_err: [] bool, wire_out: [] u8) -> int {
  is_err[0] = false;
  nodes: [128] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) {
    is_err[0] = true; return fww_keep(out_res, "Invalid JSON arguments for Edit.");
  }
  pb_raw: [1024] u8;
  pn := jv_str(d[0], jv_get(d[0], 0, "file_path"), pb_raw[..]);
  if pn <= 0 { pn = jv_str(d[0], jv_get(d[0], 0, "path"), pb_raw[..]); }
  if pn <= 0 { is_err[0] = true; return fww_keep(out_res, "Edit requires file_path."); }
  raw_path := cast(string) pb_raw[0..<pn];

  old_b: [65536] u8; new_b: [65536] u8;
  old_n := jv_str(d[0], jv_get(d[0], 0, "old_string"), old_b[..]);
  new_n := jv_str(d[0], jv_get(d[0], 0, "new_string"), new_b[..]);
  if old_n < 0 || new_n < 0 { is_err[0] = true; return fww_keep(out_res, "Edit requires old_string and new_string."); }
  old_s := cast(string) old_b[0..<old_n];
  new_s := cast(string) new_b[0..<new_n];
  rep_all := jv_bool(d[0], jv_get(d[0], 0, "replace_all"));

  lbl_b: [1088] u8;
  ln := fww_cat(lbl_b[..], 0, "Edit ");
  ln = fww_cat(lbl_b[..], ln, raw_path);
  label := cast(string) lbl_b[0..<ln];

  full_b: [FS_PATH_MAX] u8;
  full := fww_resolve_path(cwd, raw_path, full_b[..]);
  if full.count == 0 || !fs_exists(full) {
    is_err[0] = true;
    fww_send(wire_out, mww_command(wire_out, label, 1, false, "File not found."));
    return fww_keep(out_res, "File not found.");
  }
  sz := fs_read(full, fbuf);
  if sz < 0 {
    is_err[0] = true;
    fww_send(wire_out, mww_command(wire_out, label, 1, false, "Could not read file."));
    return fww_keep(out_res, "Could not read file.");
  }
  content := cast(string) fbuf[0..<sz];
  if old_s.count == 0 {
    is_err[0] = true;
    fww_send(wire_out, mww_command(wire_out, label, 1, false, "old_string cannot be empty."));
    return fww_keep(out_res, "old_string cannot be empty.");
  }
  if old_s == new_s {
    is_err[0] = true;
    fww_send(wire_out, mww_command(wire_out, label, 1, false, "old_string and new_string are identical."));
    return fww_keep(out_res, "No changes to make: old_string and new_string are identical.");
  }

  // Count exact matches of old_s in content (recording match line numbers for actionable multi-match errors)
  matches := 0;
  first_pos := -1;
  match_lines: [8] int;
  nml := 0;
  pos := 0;
  while pos + old_s.count <= content.count {
    if cast(string) content[pos..<pos + old_s.count] == old_s {
      if first_pos < 0 { first_pos = pos; }
      if nml < 8 { match_lines[nml] = fww_line_num_at(content, pos); nml += 1; }
      matches += 1;
      pos += old_s.count;
    } else {
      pos += 1;
    }
  }

  // Smart fallback (Claude Code FileEditTool pattern): if exact match failed, try trailing-whitespace/CRLF-normalized match!
  used_trimmed := false;
  trim_from := [1] int.[0];
  trim_to := [1] int.[0];
  if matches == 0 && !rep_all {
    tm := fww_find_trimmed_match(content, old_s, trim_from[..], trim_to[..]);
    if tm == 1 {
      used_trimmed = true;
      matches = 1;
      first_pos = trim_from[0];
    }
  }

  if matches == 0 {
    is_err[0] = true;
    fww_send(wire_out, mww_command(wire_out, label, 1, false, "old_string not found in file."));
    en_m := fww_cat(out_res, 0, "old_string not found in ");
    en_m = fww_cat(out_res, en_m, raw_path);
    en_m = fww_cat(out_res, en_m, ". Verify exact indentation and omit line-number prefixes.");
    near_ln := fww_find_nearest_line(content, old_s);
    if near_ln > 0 {
      w_from := ifx near_ln > 5 then near_ln - 5 else 1;
      w_to := near_ln + 5;
      en_m = fww_cat(out_res, en_m, "\nNearest lines in file (around line ");
      en_m = fww_put_int(out_res, en_m, near_ln);
      en_m = fww_cat(out_res, en_m, "):\n");
      en_m = fww_append_numbered_window(out_res, en_m, content, w_from, w_to);
    }
    return en_m;
  }
  if matches > 1 && !rep_all {
    is_err[0] = true;
    fww_send(wire_out, mww_command(wire_out, label, 1, false, "old_string matched multiple times."));
    en_m := fww_cat(out_res, 0, "old_string matched ");
    en_m = fww_put_int(out_res, en_m, matches);
    en_m = fww_cat(out_res, en_m, " times (lines ");
    for k: 0..<nml {
      if k > 0 { en_m = fww_cat(out_res, en_m, ", "); }
      en_m = fww_put_int(out_res, en_m, match_lines[k]);
    }
    en_m = fww_cat(out_res, en_m, "); provide more surrounding context or set replace_all: true.");
    return en_m;
  }

  // Build updated file contents into ebuf
  en := 0;
  replaced := 0;
  if used_trimmed {
    en = fww_cat(ebuf, en, cast(string) content[0..<trim_from[0]]);
    en = fww_cat(ebuf, en, new_s);
    en = fww_cat(ebuf, en, cast(string) content[trim_to[0]..<content.count]);
    replaced = 1;
  } else {
    pos = 0;
    while pos < content.count {
      if (rep_all || replaced == 0) && pos + old_s.count <= content.count && cast(string) content[pos..<pos + old_s.count] == old_s {
        en = fww_cat(ebuf, en, new_s);
        pos += old_s.count;
        replaced += 1;
      } else {
        if en < ebuf.count { ebuf[en] = content[pos]; en += 1; }
        pos += 1;
      }
    }
  }
  updated := cast(string) ebuf[0..<en];
  if !fs_write(full, updated) {
    is_err[0] = true;
    fww_send(wire_out, mww_command(wire_out, label, 1, false, "Failed to write edited file."));
    return fww_keep(out_res, "Failed to write edited file.");
  }
  _ = flawed_fc_put(fc, full, updated, 1, cast(u64) en, proc_now_ms(), -1, -1, false);
  if dedup.count > 0 { fww_read_dedup_invalidate(dedup, fww_str_hash(full)); }

  diff_b: [4096] u8;
  dn := fww_format_diff(old_s, new_s, diff_b[..]);
  fww_send(wire_out, mww_command(wire_out, label, 0, false, cast(string) diff_b[0..<dn]));

  edit_line := fww_line_num_at(content, first_pos);
  new_lines := fww_count_lines(new_s);
  rn := fww_cat(out_res, 0, "Edited ");
  rn = fww_cat(out_res, rn, raw_path);
  rn = fww_cat(out_res, rn, " (");
  rn = fww_put_int(out_res, rn, replaced);
  rn = fww_cat(out_res, rn, " replacement(s) at line ");
  rn = fww_put_int(out_res, rn, edit_line);
  rn = fww_cat(out_res, rn, ").\n");
  if !rep_all && new_lines <= 32 {
    w_from := ifx edit_line > 2 then edit_line - 2 else 1;
    w_to := edit_line + new_lines + 2;
    rn = fww_append_numbered_window(out_res, rn, updated, w_from, w_to);
  }
  return rn;
}

fww_tool_write :: (cwd: string, args_json: string, fc: FlawedFileCache, dedup: [] FwReadDedup, ebuf: [] u8, out_res: [] u8, is_err: [] bool, wire_out: [] u8) -> int {
  is_err[0] = false;
  nodes: [128] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) {
    is_err[0] = true; return fww_keep(out_res, "Invalid JSON arguments for Write.");
  }
  pb_raw: [1024] u8;
  pn := jv_str(d[0], jv_get(d[0], 0, "file_path"), pb_raw[..]);
  if pn <= 0 { pn = jv_str(d[0], jv_get(d[0], 0, "path"), pb_raw[..]); }
  if pn <= 0 { is_err[0] = true; return fww_keep(out_res, "Write requires file_path."); }
  raw_path := cast(string) pb_raw[0..<pn];

  cn := jv_str(d[0], jv_get(d[0], 0, "content"), ebuf);
  if cn < 0 { is_err[0] = true; return fww_keep(out_res, "Write requires content string (or content exceeds buffer)."); }
  body := cast(string) ebuf[0..<cn];

  lbl_b: [1088] u8;
  ln := fww_cat(lbl_b[..], 0, "Write ");
  ln = fww_cat(lbl_b[..], ln, raw_path);
  label := cast(string) lbl_b[0..<ln];

  full_b: [FS_PATH_MAX] u8;
  full := fww_resolve_path(cwd, raw_path, full_b[..]);
  if full.count == 0 {
    is_err[0] = true;
    fww_send(wire_out, mww_command(wire_out, label, 1, false, "Invalid path."));
    return fww_keep(out_res, "Invalid file path.");
  }
  parent := fs_dir(full);
  if parent.count > 0 && !fs_exists(parent) { _ = fs_mkdir(parent); }
  if !fs_write(full, body) {
    is_err[0] = true;
    fww_send(wire_out, mww_command(wire_out, label, 1, false, "Failed to write file."));
    return fww_keep(out_res, "Failed to write file.");
  }
  _ = flawed_fc_put(fc, full, body, 1, cast(u64) cn, proc_now_ms(), -1, -1, false);
  if dedup.count > 0 { fww_read_dedup_invalidate(dedup, fww_str_hash(full)); }
  diff_b: [4096] u8;
  dn := fww_format_diff("", body, diff_b[..]);
  fww_send(wire_out, mww_command(wire_out, label, 0, false, cast(string) diff_b[0..<dn]));

  rn := fww_cat(out_res, 0, "Wrote ");
  rn = fww_put_int(out_res, rn, cn);
  rn = fww_cat(out_res, rn, " bytes (");
  rn = fww_put_int(out_res, rn, fww_count_lines(body));
  rn = fww_cat(out_res, rn, " lines) to ");
  rn = fww_cat(out_res, rn, raw_path);
  return rn;
}

fww_glob_walk :: (dir: string, rel_prefix: string, pattern: string, depth: int, out: [] u8, at: [] int, hits: [] int, max_hits: int) {
  if depth > 12 || hits[0] >= max_hits || at[0] + 64 >= out.count { return; }
  lst: [1] FsList;
  n := fs_list(dir, lst[..]);
  for i: 0..<n {
    if hits[0] >= max_hits || at[0] + 64 >= out.count { break; }
    name := fs_entry(lst[..], i);
    if name.count == 0 || name == "." || name == ".." || name == ".git" || name == "node_modules" || name == ".build" || name == "build" || name == "target" || name == "dist" || name == ".venv" || name == ".cache" || name == "DerivedData" { continue; }
    fb: [FS_PATH_MAX] u8;
    full := fs_join(dir, name, fb[..]);
    rb: [FS_PATH_MAX] u8;
    rn := 0;
    if rel_prefix.count > 0 { rn = fww_cat(rb[..], 0, rel_prefix); rn = fww_cat(rb[..], rn, "/"); }
    rn = fww_cat(rb[..], rn, name);
    rel := cast(string) rb[0..<rn];
    k := fs_kind(full);
    if k == FS_DIR {
      fww_glob_walk(full, rel, pattern, depth + 1, out, at, hits, max_hits);
    } else if k == FS_FILE {
      if flawed_glob_match(pattern, rel) || flawed_glob_match(pattern, name) {
        at[0] = fww_cat(out, at[0], rel);
        at[0] = fww_cat(out, at[0], "\n");
        hits[0] += 1;
      }
    }
  }
}

fww_tool_glob :: (cwd: string, args_json: string, out_res: [] u8, is_err: [] bool, wire_out: [] u8) -> int {
  is_err[0] = false;
  nodes: [128] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) {
    is_err[0] = true; return fww_keep(out_res, "Invalid JSON arguments for Glob.");
  }
  pat_b: [512] u8; sub_b: [1024] u8;
  pn := jv_str(d[0], jv_get(d[0], 0, "pattern"), pat_b[..]);
  if pn <= 0 { is_err[0] = true; return fww_keep(out_res, "Glob requires pattern."); }
  pat := cast(string) pat_b[0..<pn];
  sn := jv_str(d[0], jv_get(d[0], 0, "path"), sub_b[..]);
  base_b: [FS_PATH_MAX] u8;
  base := ifx sn > 0 then fww_resolve_path(cwd, cast(string) sub_b[0..<sn], base_b[..]) else cwd;

  lbl_b: [600] u8;
  ln := fww_cat(lbl_b[..], 0, "Glob ");
  ln = fww_cat(lbl_b[..], ln, pat);
  label := cast(string) lbl_b[0..<ln];

  if base.count == 0 || !fs_exists(base) {
    is_err[0] = true;
    en := fww_cat(out_res, 0, "Directory not found: ");
    en = fww_cat(out_res, en, ifx sn > 0 then cast(string) sub_b[0..<sn] else cwd);
    fww_send(wire_out, mww_command(wire_out, label, 1, false, cast(string) out_res[0..<en]));
    return en;
  }
  if fs_kind(base) != FS_DIR {
    is_err[0] = true;
    en := fww_cat(out_res, 0, "Path is not a directory: ");
    en = fww_cat(out_res, en, cast(string) sub_b[0..<sn]);
    fww_send(wire_out, mww_command(wire_out, label, 1, false, cast(string) out_res[0..<en]));
    return en;
  }

  // Always return cwd-relative paths (even when `path` is passed) so results feed straight into Read/Edit!
  rel_pre := "";
  if base.count > cwd.count + 1 && flawed_aw_starts(base, cwd) && base[cwd.count] == '/' {
    rel_pre = cast(string) base[cwd.count + 1..<base.count];
    while rel_pre.count > 0 && rel_pre[rel_pre.count - 1] == '/' {
      rel_pre = cast(string) rel_pre[0..<rel_pre.count - 1];
    }
  }

  max_hits := 150;
  at := [1] int.[0];
  hits := [1] int.[0];
  fww_glob_walk(base, rel_pre, pat, 0, out_res, at[..], hits[..], max_hits);
  if hits[0] == 0 {
    at[0] = fww_keep(out_res, "No files matched.");
  } else if hits[0] >= max_hits {
    at[0] = fww_cat(out_res, at[0], "... [truncated at 150 files; narrow pattern or pass path=...]");
  }
  fww_send(wire_out, mww_command(wire_out, label, 0, false, cast(string) out_res[0..<at[0]]));
  return at[0];
}

fww_tool_grep :: (cwd: string, args_json: string, out_res: [] u8, is_err: [] bool, wire_out: [] u8) -> int {
  is_err[0] = false;
  nodes: [128] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) {
    is_err[0] = true; return fww_keep(out_res, "Invalid JSON arguments for Grep.");
  }
  pat_b: [512] u8; sub_b: [1024] u8; glob_b: [256] u8; type_b: [64] u8; mode_b: [32] u8;
  pn := jv_str(d[0], jv_get(d[0], 0, "pattern"), pat_b[..]);
  if pn <= 0 { is_err[0] = true; return fww_keep(out_res, "Grep requires pattern."); }
  pat := cast(string) pat_b[0..<pn];
  sn := jv_str(d[0], jv_get(d[0], 0, "path"), sub_b[..]);
  gn := jv_str(d[0], jv_get(d[0], 0, "glob"), glob_b[..]);
  tn := jv_str(d[0], jv_get(d[0], 0, "type"), type_b[..]);
  mn := jv_str(d[0], jv_get(d[0], 0, "output_mode"), mode_b[..]);
  mode := ifx mn > 0 then cast(string) mode_b[0..<mn] else "content";
  ci := jv_bool(d[0], jv_get(d[0], 0, "-i")) || jv_bool(d[0], jv_get(d[0], 0, "case_insensitive"));
  ctx_c := jv_int(d[0], jv_get(d[0], 0, "context"), -1);
  if ctx_c < 0 { ctx_c = jv_int(d[0], jv_get(d[0], 0, "-C"), 0); }
  ctx_a := jv_int(d[0], jv_get(d[0], 0, "-A"), 0);
  ctx_b := jv_int(d[0], jv_get(d[0], 0, "-B"), 0);
  if ctx_c > 12 { ctx_c = 12; }
  if ctx_a > 12 { ctx_a = 12; }
  if ctx_b > 12 { ctx_b = 12; }
  def_hlim := ifx mode == "content" then 60 else 100;
  hlim := jv_int(d[0], jv_get(d[0], 0, "head_limit"), def_hlim);
  if hlim <= 0 { hlim = 250; }
  if hlim > 250 { hlim = 250; }
  skip_n := jv_int(d[0], jv_get(d[0], 0, "offset"), 0);
  if skip_n < 0 { skip_n = 0; }

  // Run rg inside cwd with relative paths (eliminates 90-char /var/folders/... prefix noise on every line!)
  search_target := ".";
  if sn > 0 {
    raw_sub := cast(string) sub_b[0..<sn];
    if raw_sub.count > cwd.count + 1 && flawed_aw_starts(raw_sub, cwd) && raw_sub[cwd.count] == '/' {
      search_target = cast(string) raw_sub[cwd.count + 1..<raw_sub.count];
    } else if raw_sub == cwd {
      search_target = ".";
    } else {
      search_target = raw_sub;
    }
  }

  // Helper: try ripgrep (`rg`) first; if `rg` is not installed (PROC_ENOENT), transparently fall back to POSIX `grep -r -E -I`.
  n := 0;
  truncated := false;
  max_grep_b := ifx FWW_GREP_MAX_BYTES < out_res.count then FWW_GREP_MAX_BYTES else out_res.count;
  for backend_try: 0..<2 {
    use_rg := backend_try == 0;
    h := proc_new();
    if h < 0 { break; }
    ok := false;
    if use_rg {
      ok = proc_arg(h, "rg") && proc_arg(h, "--color=never") && proc_cwd(h, cwd);
      if mode == "files_with_matches" {
        ok = ok && proc_arg(h, "--files-with-matches");
      } else if mode == "count" {
        ok = ok && proc_arg(h, "--count");
      } else {
        ok = ok && proc_arg(h, "--no-heading") && proc_arg(h, "--line-number") && proc_arg(h, "--max-count=15");
        num_b: [16] u8;
        if ctx_c > 0 {
          nn := fww_put_int(num_b[..], 0, ctx_c);
          ok = ok && proc_arg(h, "-C") && proc_arg(h, cast(string) num_b[0..<nn]);
        } else {
          if ctx_b > 0 {
            nn := fww_put_int(num_b[..], 0, ctx_b);
            ok = ok && proc_arg(h, "-B") && proc_arg(h, cast(string) num_b[0..<nn]);
          }
          if ctx_a > 0 {
            nn := fww_put_int(num_b[..], 0, ctx_a);
            ok = ok && proc_arg(h, "-A") && proc_arg(h, cast(string) num_b[0..<nn]);
          }
        }
      }
      if ci { ok = ok && proc_arg(h, "-i"); }
      if gn > 0 { ok = ok && proc_arg(h, "--glob") && proc_arg(h, cast(string) glob_b[0..<gn]); }
      if tn > 0 { ok = ok && proc_arg(h, "--type") && proc_arg(h, cast(string) type_b[0..<tn]); }
      ok = ok && proc_arg(h, "--") && proc_arg(h, pat) && proc_arg(h, search_target) && proc_err_to_out(h);
    } else {
      ok = proc_arg(h, "grep") && proc_arg(h, "-r") && proc_arg(h, "-E") && proc_arg(h, "-I") && proc_arg(h, "-H")
           && proc_arg(h, "--exclude-dir=.git") && proc_arg(h, "--exclude-dir=node_modules")
           && proc_arg(h, "--exclude-dir=__pycache__") && proc_arg(h, "--exclude-dir=.venv")
           && proc_arg(h, "--exclude-dir=build") && proc_arg(h, "--exclude-dir=target")
           && proc_arg(h, "--exclude-dir=dist") && proc_cwd(h, cwd);
      if mode == "files_with_matches" {
        ok = ok && proc_arg(h, "-l");
      } else if mode == "count" {
        ok = ok && proc_arg(h, "-c");
      } else {
        ok = ok && proc_arg(h, "-n") && proc_arg(h, "-m") && proc_arg(h, "15");
        num_b: [16] u8;
        if ctx_c > 0 {
          nn := fww_put_int(num_b[..], 0, ctx_c);
          ok = ok && proc_arg(h, "-C") && proc_arg(h, cast(string) num_b[0..<nn]);
        } else {
          if ctx_b > 0 {
            nn := fww_put_int(num_b[..], 0, ctx_b);
            ok = ok && proc_arg(h, "-B") && proc_arg(h, cast(string) num_b[0..<nn]);
          }
          if ctx_a > 0 {
            nn := fww_put_int(num_b[..], 0, ctx_a);
            ok = ok && proc_arg(h, "-A") && proc_arg(h, cast(string) num_b[0..<nn]);
          }
        }
      }
      if ci { ok = ok && proc_arg(h, "-i"); }
      if gn > 0 {
        inc_b: [300] u8;
        in_n := fww_cat(inc_b[..], 0, "--include=");
        in_n = fww_cat(inc_b[..], in_n, cast(string) glob_b[0..<gn]);
        ok = ok && proc_arg(h, cast(string) inc_b[0..<in_n]);
      }
      ok = ok && proc_arg(h, "-e") && proc_arg(h, pat) && proc_arg(h, "--") && proc_arg(h, search_target) && proc_err_to_out(h);
    }
    st := ifx ok then proc_start(h) else -1;
    if st != 0 {
      _ = proc_release(h);
      if use_rg && st == PROC_ENOENT { continue; }
      break;
    }
    _ = proc_close_stdin(h);
    lbuf: [4096] u8;
    seen := 0;
    lines := 0;
    deadline := proc_now_ms() + 15000;
    while proc_now_ms() < deadline {
      r := proc_line(h, 200, lbuf[..]);
      if r == PROC_EOF { break; }
      if r == PROC_TIMEOUT { continue; }
      if r < 0 { break; }
      if seen < skip_n { seen += 1; continue; }
      line_s := cast(string) lbuf[0..<r];
      if line_s.count >= 2 && line_s[0] == '.' && line_s[1] == '/' {
        line_s = cast(string) line_s[2..<line_s.count];
      }
      line_clipped := false;
      if line_s.count > FWW_GREP_LINE_MAX {
        cut := fww_utf8_cut(line_s, FWW_GREP_LINE_MAX);
        line_s = cast(string) line_s[0..<cut];
        line_clipped = true;
      }
      if lines >= hlim || n + line_s.count + 128 >= max_grep_b {
        truncated = true;
        break;
      }
      n = fww_cat(out_res, n, line_s);
      if line_clipped { n = fww_cat(out_res, n, "..."); }
      n = fww_cat(out_res, n, "\n");
      lines += 1;
      seen += 1;
    }
    if truncated { _ = proc_kill(h, PROC_SIGTERM); }
    _ = proc_wait(h, 1000);
    _ = proc_release(h);
    break;
  }
  if truncated {
    n = fww_cat(out_res, n, "... [truncated; narrow with path/glob or output_mode=files_with_matches]");
  }
  if n == 0 { n = fww_keep(out_res, "No matches found."); }
  lbl_b: [600] u8;
  ln := fww_cat(lbl_b[..], 0, "Grep ");
  ln = fww_cat(lbl_b[..], ln, pat);
  fww_send(wire_out, mww_command(wire_out, cast(string) lbl_b[0..<ln], 0, false, cast(string) out_res[0..<n]));
  return n;
}

fww_tool_todos :: (args_json: string, out_res: [] u8, is_err: [] bool, wire_out: [] u8) -> int {
  is_err[0] = false;
  raw_todos := cl_raw(args_json, "todos");
  if raw_todos.count < 2 {
    is_err[0] = true; return fww_keep(out_res, "TodoWrite requires todos array.");
  }
  fww_send(wire_out, mww_todos(wire_out, raw_todos));
  return fww_keep(out_res, "Updated todo list.");
}

// Ch 13 SSRF check for WebFetch: blocks localhost, loopback, link-local 169.254.*, and non-http(s) schemes.
fww_url_safe :: (url: string) -> bool {
  if !(flawed_aw_starts(url, "https://") || flawed_aw_starts(url, "http://")) { return false; }
  at := ifx flawed_aw_starts(url, "https://") then 8 else 7;
  end := at;
  while end < url.count && url[end] != '/' && url[end] != ':' && url[end] != '?' { end += 1; }
  host := cast(string) url[at..<end];
  if host.count == 0 { return false; }
  if flawed_aw_eq_ci(host, "localhost") || host == "127.0.0.1" || host == "::1" || host == "[::1]" || flawed_aw_starts(host, "169.254.") || flawed_aw_starts(host, "10.") || flawed_aw_starts(host, "192.168.") || flawed_aw_starts(host, "0.") {
    return false;
  }
  return true;
}

fww_tool_webfetch :: (args_json: string, out_res: [] u8, is_err: [] bool, wire_out: [] u8) -> int {
  is_err[0] = false;
  nodes: [128] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) {
    is_err[0] = true; return fww_keep(out_res, "Invalid JSON arguments for WebFetch.");
  }
  ub: [2048] u8;
  un := jv_str(d[0], jv_get(d[0], 0, "url"), ub[..]);
  if un <= 0 { is_err[0] = true; return fww_keep(out_res, "WebFetch requires url."); }
  url := cast(string) ub[0..<un];

  lbl_b: [2100] u8;
  ln := fww_cat(lbl_b[..], 0, "WebFetch ");
  ln = fww_cat(lbl_b[..], ln, url);
  label := cast(string) lbl_b[0..<ln];

  if !fww_url_safe(url) {
    is_err[0] = true;
    fww_send(wire_out, mww_command(wire_out, label, 1, false, "Blocked by SSRF guard."));
    return fww_keep(out_res, "WebFetch blocked: private/local/non-HTTP(S) URL.");
  }
  h := proc_new();
  n := 0;
  exit_code := 1;
  if h >= 0 {
    ok := proc_arg(h, "curl") && proc_arg(h, "-sS") && proc_arg(h, "-L") && proc_arg(h, "--max-time") && proc_arg(h, "20") && proc_arg(h, "--max-filesize") && proc_arg(h, "262144") && proc_arg(h, "--") && proc_arg(h, url) && proc_err_to_out(h);
    if ok && proc_start(h) == 0 {
      _ = proc_close_stdin(h);
      lbuf: [4096] u8;
      deadline := proc_now_ms() + 22000;
      while proc_now_ms() < deadline {
        r := proc_line(h, 250, lbuf[..]);
        if r == PROC_EOF { break; }
        if r == PROC_TIMEOUT { continue; }
        if r < 0 { break; }
        if n + r + 2 >= out_res.count { break; }
        n = fww_cat(out_res, n, cast(string) lbuf[0..<r]);
        n = fww_cat(out_res, n, "\n");
      }
      exit_code = proc_wait(h, 2000);
    }
    _ = proc_release(h);
  }
  is_err[0] = exit_code != 0;
  if n == 0 { n = fww_keep(out_res, ifx exit_code == 0 then "(empty response)" else "Failed to fetch URL."); }
  fww_send(wire_out, mww_command(wire_out, label, exit_code, false, cast(string) out_res[0..<n]));
  return n;
}

fww_coax_intel_subcmd :: (name: string) -> string {
  if name == "CoaxDefines" { return "defines"; }
  if name == "CoaxUses" { return "uses"; }
  if name == "CoaxChecks" { return "checks"; }
  if name == "CoaxExports" { return "exports"; }
  if name == "CoaxShow" { return "show"; }
  if name == "CoaxCheck" { return "check"; }
  if name == "CoaxExplain" { return "explain"; }
  if name == "CoaxVocab" { return "vocab"; }
  if name == "CoaxEffects" { return "effects"; }
  if name == "CoaxDepends" { return "depends"; }
  if name == "CoaxLoaders" { return "loaders"; }
  if name == "CoaxReplace" { return "replace"; }
  return "";
}

fww_is_coax_intel_tool :: (name: string) -> bool {
  return fww_coax_intel_subcmd(name).count > 0;
}

// Execute one of the 12 compiler-backed Coax intelligence tools via coax/lib/agent/intel/intel.coax (#14054).
fww_tool_coax_intel :: (cwd: string, name: string, args_json: string, out_res: [] u8, is_err: [] bool, wire_out: [] u8) -> int {
  is_err[0] = false;
  sub := fww_coax_intel_subcmd(name);
  if sub.count == 0 {
    is_err[0] = true;
    return fww_keep(out_res, "Unknown Coax intelligence tool.");
  }
  if !fww_is_coax_repo(cwd) {
    is_err[0] = true;
    return fww_keep(out_res, "Coax intelligence tools require a Coax repository with coax/lib/agent/intel/intel.coax.");
  }
  nodes: [128] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) {
    is_err[0] = true;
    return fww_keep(out_res, "Invalid JSON arguments for Coax intelligence tool.");
  }

  arg1_b: [1024] u8; arg2_b: [1024] u8; seen_b: [128] u8; check_b: [1024] u8; text_b: [16384] u8; num_b: [32] u8;
  tool_pb: [FS_PATH_MAX] u8; intel_pb: [FS_PATH_MAX] u8;
  tool_sh := fs_join(cwd, "coax/web/tool.sh", tool_pb[..]);
  intel_coax := fs_join(cwd, "coax/lib/agent/intel/intel.coax", intel_pb[..]);

  h := proc_new();
  if h < 0 {
    is_err[0] = true;
    return fww_keep(out_res, "Failed to allocate process for Coax intelligence tool.");
  }
  ok := proc_arg(h, tool_sh) && proc_arg(h, intel_coax) && proc_arg(h, sub) && proc_cwd(h, cwd);
  lbl_b: [512] u8;
  ln := fww_cat(lbl_b[..], 0, name);
  ln = fww_cat(lbl_b[..], ln, " ");

  if sub == "defines" || sub == "vocab" {
    n1 := jv_str(d[0], jv_get(d[0], 0, "name"), arg1_b[..]);
    if n1 <= 0 { _ = proc_release(h); is_err[0] = true; return fww_keep(out_res, "Missing required argument: name."); }
    s1 := cast(string) arg1_b[0..<n1];
    ok = ok && proc_arg(h, s1);
    ln = fww_cat(lbl_b[..], ln, s1);
  } else if sub == "uses" || sub == "checks" {
    n1 := jv_str(d[0], jv_get(d[0], 0, "name"), arg1_b[..]);
    if n1 <= 0 { _ = proc_release(h); is_err[0] = true; return fww_keep(out_res, "Missing required argument: name."); }
    s1 := cast(string) arg1_b[0..<n1];
    ok = ok && proc_arg(h, s1);
    ln = fww_cat(lbl_b[..], ln, s1);
    n2 := jv_str(d[0], jv_get(d[0], 0, "file"), arg2_b[..]);
    if n2 > 0 { ok = ok && proc_arg(h, "--file") && proc_arg(h, cast(string) arg2_b[0..<n2]); }
    if sub == "checks" {
      dep := jv_int(d[0], jv_get(d[0], 0, "depth"), -1);
      if dep >= 0 {
        nn := fww_put_int(num_b[..], 0, dep);
        ok = ok && proc_arg(h, "--depth") && proc_arg(h, cast(string) num_b[0..<nn]);
      }
    }
  } else if sub == "exports" || sub == "check" || sub == "depends" || sub == "loaders" {
    n1 := jv_str(d[0], jv_get(d[0], 0, "file"), arg1_b[..]);
    if n1 <= 0 { _ = proc_release(h); is_err[0] = true; return fww_keep(out_res, "Missing required argument: file."); }
    s1 := cast(string) arg1_b[0..<n1];
    ok = ok && proc_arg(h, s1);
    ln = fww_cat(lbl_b[..], ln, s1);
  } else if sub == "show" {
    n1 := jv_str(d[0], jv_get(d[0], 0, "target"), arg1_b[..]);
    if n1 <= 0 { n1 = jv_str(d[0], jv_get(d[0], 0, "name"), arg1_b[..]); }
    if n1 <= 0 { _ = proc_release(h); is_err[0] = true; return fww_keep(out_res, "Missing required argument: target."); }
    s1 := cast(string) arg1_b[0..<n1];
    ok = ok && proc_arg(h, s1);
    ln = fww_cat(lbl_b[..], ln, s1);
    n2 := jv_str(d[0], jv_get(d[0], 0, "file"), arg2_b[..]);
    if n2 > 0 { ok = ok && proc_arg(h, "--file") && proc_arg(h, cast(string) arg2_b[0..<n2]); }
  } else if sub == "explain" {
    n1 := jv_str(d[0], jv_get(d[0], 0, "code"), arg1_b[..]);
    if n1 <= 0 { _ = proc_release(h); is_err[0] = true; return fww_keep(out_res, "Missing required argument: code."); }
    s1 := cast(string) arg1_b[0..<n1];
    ok = ok && proc_arg(h, s1);
    ln = fww_cat(lbl_b[..], ln, s1);
  } else if sub == "effects" {
    n1 := jv_str(d[0], jv_get(d[0], 0, "file"), arg1_b[..]);
    if n1 <= 0 { _ = proc_release(h); is_err[0] = true; return fww_keep(out_res, "Missing required argument: file."); }
    s1 := cast(string) arg1_b[0..<n1];
    ok = ok && proc_arg(h, s1);
    ln = fww_cat(lbl_b[..], ln, s1);
    n2 := jv_str(d[0], jv_get(d[0], 0, "proc"), arg2_b[..]);
    if n2 > 0 { ok = ok && proc_arg(h, cast(string) arg2_b[0..<n2]); }
  } else if sub == "replace" {
    n1 := jv_str(d[0], jv_get(d[0], 0, "target"), arg1_b[..]);
    ns := jv_str(d[0], jv_get(d[0], 0, "seen"), seen_b[..]);
    nt := jv_str(d[0], jv_get(d[0], 0, "text"), text_b[..]);
    if n1 <= 0 || ns <= 0 || jv_get(d[0], 0, "text") < 0 {
      _ = proc_release(h); is_err[0] = true;
      return fww_keep(out_res, "CoaxReplace requires target, seen, and text.");
    }
    s1 := cast(string) arg1_b[0..<n1];
    ok = ok && proc_arg(h, s1);
    ln = fww_cat(lbl_b[..], ln, s1);
    n2 := jv_str(d[0], jv_get(d[0], 0, "file"), arg2_b[..]);
    if n2 > 0 { ok = ok && proc_arg(h, "--file") && proc_arg(h, cast(string) arg2_b[0..<n2]); }
    ok = ok && proc_arg(h, "--seen") && proc_arg(h, cast(string) seen_b[0..<ns]);
    ok = ok && proc_arg(h, "--text") && proc_arg(h, cast(string) text_b[0..<nt]);
    nc := jv_str(d[0], jv_get(d[0], 0, "check"), check_b[..]);
    if nc > 0 { ok = ok && proc_arg(h, "--check") && proc_arg(h, cast(string) check_b[0..<nc]); }
  }

  ok = ok && proc_arg(h, "--root") && proc_arg(h, cwd) && proc_err_to_out(h);
  n := 0;
  exit_code := -1;
  if ok && proc_start(h) == 0 {
    _ = proc_close_stdin(h);
    lbuf: [4096] u8;
    deadline := proc_now_ms() + 30000;
    while proc_now_ms() < deadline {
      r := proc_line(h, 250, lbuf[..]);
      if r == PROC_EOF { break; }
      if r == PROC_TIMEOUT { continue; }
      if r < 0 { break; }
      if n + r + 2 >= out_res.count { break; }
      n = fww_cat(out_res, n, cast(string) lbuf[0..<r]);
      n = fww_cat(out_res, n, "\n");
    }
    exit_code = proc_wait(h, 2000);
  }
  _ = proc_release(h);
  is_err[0] = exit_code != 0;
  if n == 0 { n = fww_keep(out_res, ifx exit_code == 0 then "(ok)" else "Coax intelligence tool failed."); }
  if wire_out.count > 0 {
    fww_send(wire_out, mww_command(wire_out, cast(string) lbl_b[0..<ln], exit_code, false, cast(string) out_res[0..<n]));
  }
  return n;
}

// ---------------------------------------------------------------- Member Tool Packs (#14057): Wallet, CLI, Metaverse/GameBuilder

// Talk to OpenAgents Desktop's local Spark wallet loopback RPC (Window+WalletRPC.swift).
// Seeds and private keys NEVER enter the worker; WalletPay is bypass-immune in #authority members.coax
// and double-gated by Desktop's pay/wallet-rpc.coax + interactive approval dialog.
fww_tool_wallet :: (name: string, args_json: string, out_res: [] u8, is_err: [] bool, wire_out: [] u8) -> int {
  is_err[0] = false;
  cpath_b: [FS_PATH_MAX] u8;
  cpath := fww_wallet_control_path(cpath_b[..]);
  if cpath.count == 0 || !fs_exists(cpath) {
    is_err[0] = true;
    return fww_keep(out_res, "OpenAgents Desktop wallet RPC control server is not running (open OpenAgents.app with Wallet enabled first).");
  }
  raw: [8192] u8;
  rn := fs_read(cpath, raw[..]);
  if rn <= 0 {
    is_err[0] = true;
    return fww_keep(out_res, "Failed to read Desktop control server descriptor.");
  }
  cnodes: [128] JvNode; cd: [1] Jv;
  if !jv_parse(cd[..], cast(string) raw[0..<rn], cnodes[..]) {
    is_err[0] = true;
    return fww_keep(out_res, "Malformed Desktop control server descriptor.");
  }
  url_b: [256] u8; tok_b: [256] u8;
  un := jv_str(cd[0], jv_get(cd[0], 0, "url"), url_b[..]);
  tn := jv_str(cd[0], jv_get(cd[0], 0, "token"), tok_b[..]);
  if un <= 0 || tn <= 0 {
    is_err[0] = true;
    return fww_keep(out_res, "Desktop control descriptor missing url or token.");
  }

  method := "GET";
  route := "/v1/wallet/status";
  body_b: [8192] u8;
  body_s := "";

  if name != "WalletStatus" {
    method = "POST";
    nodes: [128] JvNode; d: [1] Jv;
    if !jv_parse(d[..], args_json, nodes[..]) {
      is_err[0] = true;
      return fww_keep(out_res, "Invalid JSON arguments for Wallet tool.");
    }
    o: [1] Jo; jo_start(o[..], body_b[..]);
    jo_obj(o[..]);
    if name == "WalletReceive" {
      route = "/v1/wallet/receive";
      kb: [32] u8; db: [512] u8;
      kn := jv_str(d[0], jv_get(d[0], 0, "kind"), kb[..]);
      dn := jv_str(d[0], jv_get(d[0], 0, "description"), db[..]);
      amt := jv_int(d[0], jv_get(d[0], 0, "amount_sats"), 0);
      jo_key(o[..], "kind"); jo_str(o[..], ifx kn > 0 then cast(string) kb[0..<kn] else "lightning");
      jo_key(o[..], "description"); jo_str(o[..], ifx dn > 0 then cast(string) db[0..<dn] else "OpenAgents");
      if amt > 0 { jo_key(o[..], "amount_sats"); jo_int(o[..], amt); }
    } else if name == "WalletQuote" || name == "WalletPay" {
      route = ifx name == "WalletQuote" then "/v1/wallet/quote" else "/v1/wallet/pay";
      dest_b: [2048] u8; cmt_b: [512] u8; rsn_b: [512] u8; x4_b: [2048] u8;
      dest_n := jv_str(d[0], jv_get(d[0], 0, "destination"), dest_b[..]);
      if dest_n <= 0 {
        is_err[0] = true;
        return fww_keep(out_res, "Wallet tool requires destination.");
      }
      jo_key(o[..], "destination"); jo_str(o[..], cast(string) dest_b[0..<dest_n]);
      amt := jv_int(d[0], jv_get(d[0], 0, "amount_sats"), 0);
      if amt > 0 { jo_key(o[..], "amount_sats"); jo_int(o[..], amt); }
      if name == "WalletQuote" {
        cn := jv_str(d[0], jv_get(d[0], 0, "comment"), cmt_b[..]);
        if cn > 0 { jo_key(o[..], "comment"); jo_str(o[..], cast(string) cmt_b[0..<cn]); }
      } else {
        rsn_n := jv_str(d[0], jv_get(d[0], 0, "reason"), rsn_b[..]);
        jo_key(o[..], "reason"); jo_str(o[..], ifx rsn_n > 0 then cast(string) rsn_b[0..<rsn_n] else "OpenAgents worker payment request");
        x4_n := jv_str(d[0], jv_get(d[0], 0, "x402"), x4_b[..]);
        if x4_n > 0 { jo_key(o[..], "x402"); jo_str(o[..], cast(string) x4_b[0..<x4_n]); }
      }
    } else {
      is_err[0] = true;
      return fww_keep(out_res, "Unknown Wallet tool.");
    }
    jo_end(o[..]);
    if o[0].bad {
      is_err[0] = true;
      return fww_keep(out_res, "Wallet request payload overflow.");
    }
    body_s = jo_text(o[..]);
  }

  full_url_b: [512] u8;
  fu_n := fww_cat(full_url_b[..], 0, cast(string) url_b[0..<un]);
  fu_n = fww_cat(full_url_b[..], fu_n, route);
  auth_b: [320] u8;
  an := fww_cat(auth_b[..], 0, "Authorization: Bearer ");
  an = fww_cat(auth_b[..], an, cast(string) tok_b[0..<tn]);

  h := proc_new();
  if h < 0 {
    is_err[0] = true;
    return fww_keep(out_res, "Failed to allocate process for Wallet RPC.");
  }
  ok := proc_arg(h, "curl") && proc_arg(h, "-sS") && proc_arg(h, "--max-time") && proc_arg(h, ifx name == "WalletPay" then "120" else "20") &&
        proc_arg(h, "-H") && proc_arg(h, cast(string) auth_b[0..<an]) &&
        proc_arg(h, "-X") && proc_arg(h, method);
  if method == "POST" {
    ok = ok && proc_arg(h, "-H") && proc_arg(h, "Content-Type: application/json") && proc_arg(h, "-d") && proc_arg(h, body_s);
  }
  ok = ok && proc_arg(h, cast(string) full_url_b[0..<fu_n]);

  n := 0;
  exit_code := -1;
  if ok && proc_start(h) == 0 {
    _ = proc_close_stdin(h);
    lbuf: [4096] u8;
    deadline := proc_now_ms() + (ifx name == "WalletPay" then 125000 else 25000);
    while proc_now_ms() < deadline {
      r := proc_line(h, 250, lbuf[..]);
      if r == PROC_EOF { break; }
      if r == PROC_TIMEOUT { continue; }
      if r < 0 { break; }
      if n + r + 2 >= out_res.count { break; }
      n = fww_cat(out_res, n, cast(string) lbuf[0..<r]);
      n = fww_cat(out_res, n, "\n");
    }
    exit_code = proc_wait(h, 2000);
  }
  _ = proc_release(h);
  is_err[0] = exit_code != 0;
  if n == 0 { n = fww_keep(out_res, ifx exit_code == 0 then "{}" else "Wallet RPC call failed."); }
  if wire_out.count > 0 {
    fww_send(wire_out, mww_command(wire_out, name, exit_code, false, cast(string) out_res[0..<n]));
  }
  return n;
}

// Execute an allowlisted OpenAgents CLI subcommand via argv array (NEVER sh -c).
fww_tool_cli :: (cwd: string, args_json: string, out_res: [] u8, is_err: [] bool, wire_out: [] u8) -> int {
  is_err[0] = false;
  nodes: [256] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) {
    is_err[0] = true;
    return fww_keep(out_res, "Invalid JSON arguments for OpenAgentsCli.");
  }
  sub_b: [64] u8;
  sub_n := jv_str(d[0], jv_get(d[0], 0, "subcommand"), sub_b[..]);
  sub := ifx sub_n > 0 then cast(string) sub_b[0..<sub_n] else "";
  if !oa_cli_subcmd_allowed(sub) {
    is_err[0] = true;
    return fww_keep(out_res, "Refused by #authority policy: subcommand not in OpenAgentsCli allowlist (nostr, pylon, project, dictate, transcribe, realm, vault, tasks).");
  }

  bin_b: [FS_PATH_MAX] u8;
  cli_bin := fww_trim(cl_getenv("OA_CLI_BIN", bin_b[..]));
  tool_pb: [FS_PATH_MAX] u8;
  main_pb: [FS_PATH_MAX] u8;
  use_tool_sh := false;
  if cli_bin.count == 0 {
    ts := fs_join(cwd, "coax/web/tool.sh", tool_pb[..]);
    mc := fs_join(cwd, "apps/openagents-cli/main.coax", main_pb[..]);
    if fs_exists(ts) && fs_exists(mc) {
      use_tool_sh = true;
    } else {
      is_err[0] = true;
      return fww_keep(out_res, "OpenAgents CLI not found (set OA_CLI_BIN or run inside the openagents workspace).");
    }
  }

  h := proc_new();
  if h < 0 {
    is_err[0] = true;
    return fww_keep(out_res, "Failed to allocate process for OpenAgentsCli.");
  }
  ok := ifx use_tool_sh
        then proc_arg(h, cast(string) tool_pb[0..<fs_join(cwd, "coax/web/tool.sh", tool_pb[..]).count]) &&
             proc_arg(h, cast(string) main_pb[0..<fs_join(cwd, "apps/openagents-cli/main.coax", main_pb[..]).count])
        else proc_arg(h, cli_bin);
  ok = ok && proc_arg(h, sub) && proc_cwd(h, cwd);

  lbl_b: [512] u8;
  ln := fww_cat(lbl_b[..], 0, "openagents ");
  ln = fww_cat(lbl_b[..], ln, sub);

  arr := jv_get(d[0], 0, "args");
  if jv_kind(d[0], arr) == JV_ARRAY {
    al := jv_len(d[0], arr);
    if al > 32 { al = 32; }
    ab: [2048] u8;
    for i: 0..<al {
      an := jv_str(d[0], jv_at(d[0], arr, i), ab[..]);
      if an < 0 { continue; }
      s := cast(string) ab[0..<an];
      if !oa_cli_arg_safe(s) {
        _ = proc_release(h);
        is_err[0] = true;
        return fww_keep(out_res, "Refused by #authority policy: unsafe control character in OpenAgentsCli argument.");
      }
      ok = ok && proc_arg(h, s);
      if ln + s.count + 2 < lbl_b.count {
        ln = fww_cat(lbl_b[..], ln, " ");
        ln = fww_cat(lbl_b[..], ln, s);
      }
    }
  }

  n := 0;
  exit_code := -1;
  if ok && proc_start(h) == 0 {
    _ = proc_close_stdin(h);
    lbuf: [4096] u8;
    deadline := proc_now_ms() + 30000;
    while proc_now_ms() < deadline {
      r := proc_line(h, 250, lbuf[..]);
      if r == PROC_EOF { break; }
      if r == PROC_TIMEOUT { continue; }
      if r < 0 { break; }
      if n + r + 2 >= out_res.count { break; }
      n = fww_cat(out_res, n, cast(string) lbuf[0..<r]);
      n = fww_cat(out_res, n, "\n");
    }
    exit_code = proc_wait(h, 2000);
  }
  _ = proc_release(h);
  is_err[0] = exit_code != 0;
  if n == 0 { n = fww_keep(out_res, ifx exit_code == 0 then "(ok)" else "OpenAgentsCli failed."); }
  if wire_out.count > 0 {
    fww_send(wire_out, mww_command(wire_out, cast(string) lbl_b[0..<ln], exit_code, false, cast(string) out_res[0..<n]));
  }
  return n;
}

// Metaverse / GameBuilder member tools (#14057):
// - MetaverseRoute: in-process #authority mv_route_classify + mv_route_write_json
// - GameBuilder: #authority allowlisted status/list/check-lease/build/playtest/etc.
fww_tool_metaverse :: (cwd: string, name: string, args_json: string, out_res: [] u8, is_err: [] bool, wire_out: [] u8) -> int {
  is_err[0] = false;
  nodes: [256] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) {
    is_err[0] = true;
    return fww_keep(out_res, "Invalid JSON arguments for Metaverse/GameBuilder tool.");
  }

  if name == "MetaverseRoute" {
    pb: [2048] u8;
    pn := jv_str(d[0], jv_get(d[0], 0, "path"), pb[..]);
    if pn <= 0 {
      is_err[0] = true;
      return fww_keep(out_res, "MetaverseRoute requires path.");
    }
    flags_mask := jv_int(d[0], jv_get(d[0], 0, "flags_mask"), DC_FLAGS_ALL);
    r := mv_route_classify(cast(string) pb[0..<pn], flags_mask);
    n := mv_route_write_json(r, out_res);
    if n <= 0 {
      is_err[0] = true;
      return fww_keep(out_res, "Failed to serialize metaverse route decision.");
    }
    return n;
  }

  // GameBuilder tool
  act_b: [64] u8; tgt_b: [1024] u8;
  act_n := jv_str(d[0], jv_get(d[0], 0, "action"), act_b[..]);
  act := ifx act_n > 0 then cast(string) act_b[0..<act_n] else "";
  if !oa_metaverse_action_allowed(act) {
    is_err[0] = true;
    return fww_keep(out_res, "Refused by #authority policy: action not in GameBuilder allowlist.");
  }
  tgt_n := jv_str(d[0], jv_get(d[0], 0, "target"), tgt_b[..]);
  tgt := ifx tgt_n > 0 then cast(string) tgt_b[0..<tgt_n] else "";

  if act == "route" {
    if tgt.count == 0 { is_err[0] = true; return fww_keep(out_res, "GameBuilder route requires target."); }
    r := mv_route_classify(tgt, DC_FLAGS_ALL);
    n := mv_route_write_json(r, out_res);
    return ifx n > 0 then n else fww_keep(out_res, "{}");
  }

  // Built-in status & catalog/lease inspection via coax/lib/agent/desktop/agents-catalog.coax or live attach pointer
  if act == "status" || act == "list" || act == "check-lease" {
    if act == "status" {
      hb: [FS_PATH_MAX] u8; apb: [FS_PATH_MAX] u8; raw: [1024] u8; gbb: [FS_PATH_MAX] u8;
      hdir := cl_getenv("HOME", hb[..]);
      ap := ifx hdir.count > 0 then fs_join(hdir, ".openagents/gamebuilder/Levels/attach", apb[..]) else "";
      attached := ap.count > 0 && fs_exists(ap);
      an := ifx attached then fs_read(ap, raw[..]) else 0;
      gb_bin := fww_trim(cl_getenv("OA_GAMEBUILDER", gbb[..]));
      o: [1] Jo; jo_start(o[..], out_res);
      jo_obj(o[..]);
      jo_key(o[..], "attached"); jo_bool(o[..], attached);
      jo_key(o[..], "attach_target"); jo_str(o[..], ifx an > 0 then fww_trim(cast(string) raw[0..<an]) else "");
      jo_key(o[..], "gamebuilder_bin"); jo_str(o[..], gb_bin);
      jo_end(o[..]);
      return ifx !o[0].bad then jo_text(o[..]).count else fww_keep(out_res, "{}");
    }
    ts_b: [FS_PATH_MAX] u8; cat_b: [FS_PATH_MAX] u8;
    ts := fs_join(cwd, "coax/web/tool.sh", ts_b[..]);
    cat := fs_join(cwd, "coax/lib/agent/desktop/agents-catalog.coax", cat_b[..]);
    if !fs_exists(ts) || !fs_exists(cat) {
      is_err[0] = true;
      return fww_keep(out_res, "agents-catalog.coax not found in workspace.");
    }
    h := proc_new();
    if h < 0 { is_err[0] = true; return fww_keep(out_res, "Failed to allocate process."); }
    ok := proc_arg(h, ts) && proc_arg(h, cat) && proc_arg(h, act) && proc_cwd(h, cwd);
    arr := jv_get(d[0], 0, "args");
    if jv_kind(d[0], arr) == JV_ARRAY {
      al := jv_len(d[0], arr);
      if al > 16 { al = 16; }
      ab: [1024] u8;
      for i: 0..<al {
        an := jv_str(d[0], jv_at(d[0], arr, i), ab[..]);
        if an > 0 {
          s := cast(string) ab[0..<an];
          if !oa_cli_arg_safe(s) { _ = proc_release(h); is_err[0] = true; return fww_keep(out_res, "Unsafe GameBuilder argument."); }
          ok = ok && proc_arg(h, s);
        }
      }
    }
    n := 0; exit_code := -1;
    if ok && proc_start(h) == 0 {
      _ = proc_close_stdin(h);
      lbuf: [4096] u8;
      deadline := proc_now_ms() + 20000;
      while proc_now_ms() < deadline {
        r := proc_line(h, 250, lbuf[..]);
        if r == PROC_EOF { break; }
        if r == PROC_TIMEOUT { continue; }
        if r < 0 { break; }
        if n + r + 2 >= out_res.count { break; }
        n = fww_cat(out_res, n, cast(string) lbuf[0..<r]);
        n = fww_cat(out_res, n, "\n");
      }
      exit_code = proc_wait(h, 2000);
    }
    _ = proc_release(h);
    is_err[0] = exit_code != 0 && act != "check-lease";
    if n == 0 { n = fww_keep(out_res, ifx exit_code == 0 then "(ok)" else "GameBuilder catalog command failed."); }
    return n;
  }

  // Live bundled GameBuilder CLI (--attach)
  gbb: [FS_PATH_MAX] u8;
  gb_bin := fww_trim(cl_getenv("OA_GAMEBUILDER", gbb[..]));
  if gb_bin.count == 0 {
    is_err[0] = true;
    return fww_keep(out_res, "Live GameBuilder Studio binary not attached (open GameBuilder in OpenAgents.app or set OA_GAMEBUILDER).");
  }
  h := proc_new();
  if h < 0 { is_err[0] = true; return fww_keep(out_res, "Failed to allocate GameBuilder process."); }
  ok := proc_arg(h, gb_bin) && proc_arg(h, "--attach") && proc_arg(h, act) && proc_cwd(h, cwd);
  if tgt.count > 0 {
    if !oa_cli_arg_safe(tgt) { _ = proc_release(h); is_err[0] = true; return fww_keep(out_res, "Unsafe GameBuilder target."); }
    ok = ok && proc_arg(h, tgt);
  }
  arr := jv_get(d[0], 0, "args");
  if jv_kind(d[0], arr) == JV_ARRAY {
    al := jv_len(d[0], arr);
    if al > 16 { al = 16; }
    ab: [1024] u8;
    for i: 0..<al {
      an := jv_str(d[0], jv_at(d[0], arr, i), ab[..]);
      if an > 0 {
        s := cast(string) ab[0..<an];
        if !oa_cli_arg_safe(s) { _ = proc_release(h); is_err[0] = true; return fww_keep(out_res, "Unsafe GameBuilder argument."); }
        ok = ok && proc_arg(h, s);
      }
    }
  }
  n := 0; exit_code := -1;
  if ok && proc_start(h) == 0 {
    _ = proc_close_stdin(h);
    lbuf: [4096] u8;
    deadline := proc_now_ms() + 30000;
    while proc_now_ms() < deadline {
      r := proc_line(h, 250, lbuf[..]);
      if r == PROC_EOF { break; }
      if r == PROC_TIMEOUT { continue; }
      if r < 0 { break; }
      if n + r + 2 >= out_res.count { break; }
      n = fww_cat(out_res, n, cast(string) lbuf[0..<r]);
      n = fww_cat(out_res, n, "\n");
    }
    exit_code = proc_wait(h, 2000);
  }
  _ = proc_release(h);
  is_err[0] = exit_code != 0;
  if n == 0 { n = fww_keep(out_res, ifx exit_code == 0 then "(ok)" else "GameBuilder command failed."); }
  if wire_out.count > 0 {
    fww_send(wire_out, mww_command(wire_out, "GameBuilder", exit_code, false, cast(string) out_res[0..<n]));
  }
  return n;
}

// ---------------------------------------------------------------- active streaming turn & tool loop state

FwPendingTool :: struct {
  id: [128] u8; nid: int;
  name: [64] u8; nname: int;
  args: [65536] u8; nargs: int;
  sig_at: int; nsig: int;
  done: bool;
  is_error: bool;
  res: [FWW_TOOL_OUT_MAX] u8; nres: int;
  img_mime: [32] u8; nimg_mime: int;
  img_at: int; nimg: int;
}

FwAsyncCmd :: struct {
  active: bool;
  h: int;
  tool_idx: int;
  deadline_ms: int;
  timed_out: bool;
  cmd: [FWW_CMD_MAX] u8; ncmd: int;
  head: [FWW_CMD_HEAD_MAX] u8; nhead: int;
  tail: [FWW_CMD_TAIL_MAX] u8; tail_pos: int; tail_len: int;
  omitted_bytes: int;
  out: [FWW_TOOL_OUT_MAX] u8; nout: int;
}

fww_cmd_ring_byte :: (c: [] FwAsyncCmd, ch: u8) {
  cap := c[0].tail.count;
  c[0].tail[c[0].tail_pos] = ch;
  c[0].tail_pos = (c[0].tail_pos + 1) % cap;
  if c[0].tail_len < cap {
    c[0].tail_len += 1;
  } else {
    c[0].omitted_bytes += 1;
  }
}

fww_cmd_push_line :: (c: [] FwAsyncCmd, line: string) {
  clean_b: [4096] u8;
  cn := fww_sanitize_text_line(line, clean_b[..]);
  clean := cast(string) clean_b[0..<cn];
  need := clean.count + 1;
  if c[0].tail_len == 0 && c[0].omitted_bytes == 0 && c[0].nhead + need <= c[0].head.count {
    c[0].nhead = fww_cat(c[0].head[..], c[0].nhead, clean);
    c[0].nhead = fww_cat(c[0].head[..], c[0].nhead, "\n");
    return;
  }
  for ch: clean { fww_cmd_ring_byte(c, ch); }
  fww_cmd_ring_byte(c, '\n');
}

// Assemble streaming head + omitted-byte marker + circular tail into c[0].out (UTF-8 safe).
fww_cmd_finalize :: (c: [] FwAsyncCmd) -> int {
  n := 0;
  if c[0].nhead > 0 {
    n = fww_cat(c[0].out[..], n, cast(string) c[0].head[0..<c[0].nhead]);
  }
  if c[0].omitted_bytes > 0 {
    n = fww_cat(c[0].out[..], n, "\n... [");
    n = fww_put_int(c[0].out[..], n, c[0].omitted_bytes);
    n = fww_cat(c[0].out[..], n, " bytes omitted in middle; showing head and tail] ...\n");
  }
  if c[0].tail_len > 0 {
    cap := c[0].tail.count;
    start := ifx c[0].tail_len < cap then 0 else c[0].tail_pos;
    skip := 0;
    if c[0].omitted_bytes > 0 {
      while skip < c[0].tail_len && skip < 4 && (c[0].tail[(start + skip) % cap] & 0xC0) == 0x80 {
        skip += 1;
      }
    }
    for i: skip..<c[0].tail_len {
      if n >= c[0].out.count { break; }
      c[0].out[n] = c[0].tail[(start + i) % cap];
      n += 1;
    }
  }
  c[0].nout = n;
  return n;
}

// Format finalized command output for the model's tool_result (preserving head+tail and explicit exit status).
fww_cmd_tool_result :: (c: [] FwAsyncCmd, exit_c: int, timed_out: bool, dst: [] u8) -> int {
  out_s := cast(string) c[0].out[0..<c[0].nout];
  if timed_out {
    n := 0;
    if out_s.count > 0 {
      lim := ifx out_s.count < dst.count - 192 then out_s.count else fww_utf8_cut(out_s, dst.count - 192);
      n = fww_cat(dst, n, cast(string) out_s[0..<lim]);
      n = fww_cat(dst, n, "\n");
    }
    return fww_cat(dst, n, "[Command timed out (exit 124). Check for deadlocks, infinite loops, or slow inner loops — bound/optimize the command or pass an explicit timeout if a legitimate run needs longer.]");
  }
  if out_s.count == 0 {
    if exit_c == 0 { return fww_keep(dst, "(command succeeded with no output)"); }
    n := fww_cat(dst, 0, "[Exit code: ");
    n = fww_put_int(dst, n, exit_c);
    return fww_cat(dst, n, "] (no output)");
  }
  if exit_c == 0 { return fww_keep(dst, out_s); }
  max_body := ifx dst.count > 48 then dst.count - 48 else dst.count;
  body_n := ifx out_s.count <= max_body then out_s.count else fww_utf8_cut(out_s, max_body);
  n := fww_cat(dst, 0, cast(string) out_s[0..<body_n]);
  n = fww_cat(dst, n, "\n[Exit code: ");
  n = fww_put_int(dst, n, exit_c);
  return fww_cat(dst, n, "]");
}

FwStreamAccum :: struct {
  text: [131072] u8; ntext: int;
  think: [65536] u8; nthink: int;
  sig: [131072] u8; nsig: int;
  tool_sig_slab: [262144] u8; ntool_sig_slab: int;
  tool_img_slab: [FWW_IMG_SLAB] u8; ntool_img_slab: int;
  tools: [FWW_MAX_TOOLS_CALL] FwPendingTool;
  ntools: int;
  cur_block_kind: int;
  cur_tool_idx: int;
  stop_reason: int;
  in_tok: int;
  out_tok: int;
  cache_read: int;
  cache_write: int;
  saw_error: bool;
  err_msg: [512] u8; nerr: int;
  err_body: [4096] u8; nerr_body: int;
  resp_model: [128] u8; nresp_model: int;
}

FwRun :: struct {
  active: bool;
  streaming: bool;
  waiting_permit: bool;
  waiting_ask_ticket: int;
  permit_ticket: int;
  permit_tool_idx: int;
  next_ticket: int;
  session_allow: bool;
  step_num: int;
  turn_cost_micros: int;
  cwd: [FS_PATH_MAX] u8; ncwd: int;
  model: [128] u8; nmodel: int;
  effort: [32] u8; neffort: int;
  sys_prompt: [32768] u8; nsys: int;
  gw: [1] GwStream;
  retry: [1] FlawedRetryState;
  retry_at_ms: int;
  req_start_ms: int;
  first_tok_ms: int;
  acc: [1] FwStreamAccum;
  cmd: [1] FwAsyncCmd;
  next_tool_idx: int;
  recoveries: int;
  force_no_think_once: bool;
  force_wrapup_once: bool;
  soft_deadline_ms: int;
  last_tool_hash: int;
  dup_tool_streak: int;
  ctx_recoveries: int;
  effective_ctx_cap: int;
  last_req_est_bytes: int;
  read_only_steps: int;
  post_edit_steps: int;
  turn_tool_bytes: int;
  turn_start_ms: int;
  last_req_dur_ms: int;
  stream_last_rx_ms: int;
  stall_recoveries: int;
  nudge_stage: int;
  long_think_nudges: int;
  has_edited: bool;
  last_bash_ok: bool;
  last_step_had_err: bool;
  audit_nudged: bool;
  audit_done: bool;
  finish_nudged: bool;
  time_warn_stage: int;
  calm_steps: int;
  force_low_once: bool;
  active_pack: [32] u8; nactive_pack: int;
  active_tier: [32] u8; nactive_tier: int;
  missing_cap_hint: [64] u8; nmissing_cap_hint: int;
  query_dedup: [16] int;
  query_dedup_cur: int;
  read_dedup: [FWW_READ_DEDUP_SLOTS] FwReadDedup;
  read_dedup_cur: [1] int;
  git_snap: [2560] u8; ngit_snap: int;
  git_snap_cwd: [FS_PATH_MAX] u8; ngit_snap_cwd: int;
}

fww_tool_sig_hash :: (name: string, args: string) -> int {
  h := 2166136261;
  mod := 4294967291;
  for c: name { h = ((h * 131) + cast(int) c) % mod; }
  h = ((h * 131) + 31) % mod;
  for c: args { h = ((h * 131) + cast(int) c) % mod; }
  return ifx h == 0 then 1 else h;
}

FwFollow :: struct {
  turn: int;
  steerable: bool;
  starting: bool;
  src: int;
  src_id: [MWQ_ID] u8; nsrc_id: int;
  src_text: [MWQ_TEXT] u8; nsrc_text: int;
  last: [MWQ_MESSAGE] u8; nlast: int;
  resubmit: [MWQ_MESSAGE] u8; nresubmit: int;
  resubmit_due: bool;
  force_head: bool;
  qbuf: [MWQ_FILE] u8;
  qarena: [MWQ_MESSAGE + MWQ_TEXT] u8;
}

FwBufs :: struct {
  req_body: [6291456] u8;
  sse_line: [262144] u8;
  ev_txt: [65536] u8;
  sig_buf: [131072] u8;
  file_buf: [FWW_FILE_MAX] u8;
  edit_buf: [FWW_FILE_MAX] u8;
  compact_buf: [4194304] u8;
  fc_entries: [FWW_FC_ENTRIES] FlawedFileEntry;
  fc_slab: [FWW_FC_SLAB] u8;
  fc_state: [1] FlawedFileCacheState;
}

fww_fc :: (b: [] FwBufs) -> FlawedFileCache {
  return FlawedFileCache.{entries = b[0].fc_entries[..], slab = b[0].fc_slab[..], state = b[0].fc_state[..]};
}

fww_gw_name :: (backend: int) -> string {
  if backend == FLAWED_BE_LOCAL { return "psionic"; }
  if backend == FLAWED_BE_VERTEX { return "vertex"; }
  if backend == FLAWED_BE_GEMINI { return "gemini"; }
  return "openrouter";
}

fww_emit_attempt :: (r: [] FwRun, auth: [] FwAuth, outcome: string, status: int, cost_micros: int, out: [] u8) {
  gw_name := fww_gw_name(auth[0].backend);
  mdl := ifx r[0].acc[0].nresp_model > 0 then cast(string) r[0].acc[0].resp_model[0..<r[0].acc[0].nresp_model] else cast(string) r[0].model[0..<r[0].nmodel];
  eff := cast(string) r[0].effort[0..<r[0].neffort];
  in_t := r[0].acc[0].in_tok;
  vals := [7] int.[
    ifx in_t > 0 then in_t else -1,
    ifx r[0].acc[0].out_tok > 0 then r[0].acc[0].out_tok else -1,
    ifx r[0].acc[0].cache_read > 0 then r[0].acc[0].cache_read else -1,
    -1,
    ifx r[0].acc[0].cache_write > 0 then r[0].acc[0].cache_write else -1,
    cost_micros,
    cost_micros,
  ];
  fww_send(out, mww_attempt(out, gw_name, mdl, eff, outcome, status, vals[..]));
  if outcome == "done" {
    now_ms := proc_now_ms();
    ttft := ifx r[0].first_tok_ms >= r[0].req_start_ms && r[0].first_tok_ms > 0 then r[0].first_tok_ms - r[0].req_start_ms else -1;
    if ttft == 0 { ttft = 1; }
    dec := ifx r[0].first_tok_ms > 0 && now_ms > r[0].first_tok_ms then now_ms - r[0].first_tok_ms else -1;
    if ttft > 0 || (r[0].acc[0].out_tok > 0 && dec > 0) {
      fww_send(out, mww_stats(out, ttft, dec, r[0].acc[0].out_tok));
    }
  }
}

// True FLAWED_THINK_ADAPTIVE step effort: keeps full requested effort ("high") across all core
// coding, debugging, and first post-edit audit steps; steps down to "medium" on cold Turn-1
// discovery, calm_steps cooldown after a heavy (>=90s) thinking turn or spiral, post-audit green
// follow-up steps, or once >=65% of an optional wall-clock budget has elapsed; and "low" once the
// anti-runaway finish guard triggers or >=85% of budget elapsed while already green.
fww_adaptive_effort :: (thinking_mode: int, raw_effort: string, step_num: int, nmsgs: int, has_edited: bool, last_bash_ok: bool, last_step_had_err: bool, audit_done: bool, finish_nudged: bool, calm_steps: int, elapsed_s: int, budget_s: int, bare_mode: bool) -> string {
  if thinking_mode != FLAWED_THINK_ADAPTIVE || bare_mode { return raw_effort; }
  if raw_effort == "high" || raw_effort == "xhigh" || raw_effort == "max" {
    if step_num == 1 && nmsgs <= 1 { return "medium"; }
    if has_edited && last_bash_ok && !last_step_had_err {
      if finish_nudged { return "low"; }
      if budget_s >= 120 && elapsed_s * 100 >= budget_s * 85 { return "low"; }
      if audit_done { return "medium"; }
    }
    if calm_steps > 0 { return "medium"; }
    if budget_s >= 120 && elapsed_s * 100 >= budget_s * 65 { return "medium"; }
  }
  return raw_effort;
}

// Pure check for cloud SSE dead-stream watchdog (aborts & retries only on >=150s of total silence with
// zero parsed content/thought/tool deltas, never interrupting active thinking or multi-edit tool batches).
fww_stream_stalled :: (streaming: bool, is_local: bool, stall_recoveries: int, last_rx_ms: int, now_ms: int) -> bool {
  if !streaming || is_local || stall_recoveries >= 1 || last_rx_ms <= 0 { return false; }
  return now_ms - last_rx_ms >= 150000;
}

// Pure check for cloud pure-thinking runaway spiral guard: triggers ONLY when zero visible text and
// zero tool calls have been emitted while active thinking (>=16K summarized thought chars) exceeds
// >=38K thought chars or the dynamic decode-time cap measured strictly from first_tok_ms (immune to
// API queueing/TTFT spikes: 205s default so healthy first-turn deep design up to ~180s completes
// uninterrupted, tightened to 40% of remaining wall budget clamped to [90s, 205s] when FLAWED_BUDGET_S
// is active). Preserves scratchpad conclusions and sets calm_steps=2 on recovery.
fww_think_spiral :: (streaming: bool, is_local: bool, recoveries: int, ntext: int, ntools: int, nthink: int, first_tok_ms: int, turn_start_ms: int, budget_s: int, now_ms: int) -> bool {
  if !streaming || is_local || recoveries >= 2 || ntext > 0 || ntools > 0 || nthink < 16000 { return false; }
  if nthink >= 38000 { return true; }
  cap_ms := 205000;
  if budget_s >= 120 && turn_start_ms > 0 && first_tok_ms >= turn_start_ms {
    rem_ms := budget_s * 1000 - (first_tok_ms - turn_start_ms);
    dyn_ms := (rem_ms * 40) / 100;
    if dyn_ms < 90000 { dyn_ms = 90000; }
    if dyn_ms < cap_ms { cap_ms = dyn_ms; }
  }
  return first_tok_ms > 0 && now_ms - first_tok_ms >= cap_ms;
}

// System One Front v2alpha1 routing for Auto mode (#14056):
// Calls elephant-1 or gemini-decision-1 when configured via OA_AGENT_ROUTER_DOOR,
// with deterministic offline #authority policy.coax fallback.
fww_route_auto_plan :: (
  tk: string, repo: string, active_pack: string, active_tier: string,
  local_ready: bool, cloud_ready: bool, door_pref: string, out_plan: [] Rtr2Plan
) {
  q: [1] Rtr2PlanRequest;
  q[0] = Rtr2PlanRequest.{
    text = tk,
    repo = repo,
    local_inkling_ready = local_ready,
    cloud_ready = cloud_ready,
    user_compute_pref = "auto"
  };
  if active_pack.count > 0 {
    q[0].active_packs[0] = active_pack;
    q[0].nactive_packs = 1;
  }
  q[0].active_compute_tier = active_tier;

  if door_pref == "elephant" {
    e: [1] Rtr2Eligible; w: [1] Rtr2Work;
    if rtr2_begin_elephant(q[..], e[..], out_plan, w[..]).count > 0 {
      gout: [32768] u8; err: [2048] u8;
      c := SoClient.{url = RTR2_ELEPHANT_URL, key_env = "", timeout_s = 3};
      sr := so_post(c, w[0].request, gout[..], err[..]);
      if sr.problem.count == 0 && sr.status == 200 { sr.problem = so_check(w[0].so_body[..], sr.body); sr.usage = so_usage(sr.body); }
      rtr2_finish_elephant(q[..], e[..], sr, out_plan, w[..]);
      return;
    }
  } else if door_pref == "google" {
    e: [1] Rtr2Eligible; w: [1] Rtr2Work;
    if rtr2_begin(q[..], e[..], out_plan, w[..], GD_MODEL).count > 0 {
      c: [1] SoClient; kb: [512] u8;
      why := agr_gemini_keyed(c[..], kb[..]);
      if why.count == 0 {
        gout: [32768] u8; err: [2048] u8; ab: [4096] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
        gr := gd_send(c[0], w[0].body[..], w[0].request, gout[..], err[..], ar[..]);
        for i: 0..<kb.count { kb[i] = 0; }
        rtr2_finish(q[..], e[..], gr, out_plan, w[..]);
        return;
      }
      for i: 0..<kb.count { kb[i] = 0; }
    }
  }
  rtr2_decide_offline(q[..], out_plan);
}

// Pure check: scratch files under /tmp or /var/tmp do not count as deliverable workspace edits.
fww_is_scratch_path :: (path: string) -> bool {
  return flawed_aw_starts(path, "/tmp/") || flawed_aw_starts(path, "/var/tmp/") || flawed_aw_starts(path, "/private/tmp/");
}

// Launch one streaming LLM request for the current history. Returns "" on success or error reason.
fww_start_request :: (r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, out: [] u8) -> string {
  r[0].acc[0] = FwStreamAccum.{cur_tool_idx = -1};
  r[0].first_tok_ms = 0;
  r[0].req_start_ms = proc_now_ms();
  r[0].stream_last_rx_ms = r[0].req_start_ms;

  is_local := auth[0].backend == FLAWED_BE_LOCAL;
  is_gem := flawed_wire_is_gemini(auth[0].backend);
  local_ctx := fww_env_int("PSIONIC_CTX", 32768);
  if local_ctx < 4096 { local_ctx = 4096; }
  if local_ctx > 131072 { local_ctx = 131072; }
  if r[0].effective_ctx_cap > 0 && r[0].effective_ctx_cap < local_ctx {
    local_ctx = r[0].effective_ctx_cap;
  }
  ctx_win := ifx is_local then local_ctx else (ifx r[0].effective_ctx_cap > 0 then r[0].effective_ctx_cap else 1048576);

  raw_m := cast(string) r[0].model[0..<r[0].nmodel];
  mdl_b: [128] u8;
  wire_model := "";
  if auth[0].backend == FLAWED_BE_OPENROUTER {
    n := flawed_wire_openrouter_model(raw_m, mdl_b[..]);
    wire_model = cast(string) mdl_b[0..<n];
  } else if is_local {
    lb: [128] u8;
    pm := fww_trim(cl_getenv("PSIONIC_MODEL", lb[..]));
    if pm.count > 0 {
      wire_model = pm;
    } else {
      stripped := flawed_wire_strip_model(raw_m);
      wire_model = ifx flawed_aw_starts(stripped, "inkling-2-mini") then stripped else "inkling-2-mini";
    }
  } else {
    n := flawed_wire_gemini_model(raw_m, mdl_b[..]);
    wire_model = cast(string) mdl_b[0..<n];
  }
  r[0].acc[0].nresp_model = fww_keep(r[0].acc[0].resp_model[..], wire_model);
  raw_eff := cast(string) r[0].effort[0..<r[0].neffort];
  req_elapsed_s := ifx r[0].turn_start_ms > 0 then (r[0].req_start_ms - r[0].turn_start_ms) / 1000 else 0;
  eff := ifx is_gem
         then fww_adaptive_effort(cfg[0].thinking_mode, raw_eff, r[0].step_num, h[0].nmsgs, r[0].has_edited, r[0].last_bash_ok, r[0].last_step_had_err, r[0].audit_done, r[0].finish_nudged, r[0].calm_steps, req_elapsed_s, cfg[0].budget_s, cfg[0].bare_mode)
         else raw_eff;
  // On 32K local Inkling 2 Mini in adaptive mode, map default "high" to "low" (gBench-proven Pareto champion: 100% seal_tools, 29-45% faster, no 8K thinking spirals).
  if is_local && ctx_win <= 32768 && cfg[0].thinking_mode == FLAWED_THINK_ADAPTIVE && !cfg[0].bare_mode && eff == "high" {
    eff = "low";
  }
  if is_gem && r[0].force_low_once && cfg[0].thinking_mode == FLAWED_THINK_ADAPTIVE && !cfg[0].bare_mode {
    eff = "low";
  }
  r[0].force_low_once = false;
  if r[0].calm_steps > 0 { r[0].calm_steps -= 1; }
  coding_turn := fww_is_coding_turn(cfg, h);
  base_sys_b: [4096] u8;
  full_sys := cast(string) r[0].sys_prompt[0..<r[0].nsys];
  sys := full_sys;
  if !coding_turn {
    bn_sys := fww_build_base_system_prompt(cfg, base_sys_b[..]);
    sys = cast(string) base_sys_b[0..<bn_sys];
  } else if is_local && ctx_win <= 32768 {
    platform := ifx tool_os() == TOOL_LINUX then "Linux" else "macOS";
    ln_sys := fww_build_local_coding_system_prompt_core(cfg, cast(string) r[0].cwd[0..<r[0].ncwd], platform, base_sys_b[..]);
    sys = cast(string) base_sys_b[0..<ln_sys];
  }
  if is_local && ctx_win <= 32768 {
    max_sys := ifx r[0].ctx_recoveries >= 2 then 2048 else 4096;
    if sys.count > max_sys {
      sc := fww_utf8_cut(sys, max_sys);
      sys = cast(string) sys[0..<sc];
    }
  }
  no_tools := r[0].force_wrapup_once || !coding_turn;
  cwd_now := cast(string) r[0].cwd[0..<r[0].ncwd];
  include_coax_intel := coding_turn && !no_tools && !(is_local && ctx_win <= 32768) && fww_is_coax_repo(cwd_now);
  packs_mask := ifx no_tools then 0 else fww_active_packs(cwd_now, include_coax_intel);
  no_think := r[0].force_no_think_once;
  r[0].force_no_think_once = false;

  // Multi-layer pre-flight compaction, hard context-fit guarantee, & structural history sanitizer!
  _ = fww_ensure_context_fits(h, sys.count, ctx_win, is_local, no_tools, cfg[0].auto_compact, b[0].compact_buf[..]);
  fww_hist_sanitize(h, b[0].compact_buf[..]);
  r[0].last_req_est_bytes = fww_estimate_prompt_bytes(h, sys.count, is_local, no_tools);

  bn := ifx is_gem
        then fww_build_gemini_body_packs(cfg, h, eff, sys, no_tools, packs_mask, b[0].req_body[..])
        else fww_build_openai_body_packs(cfg, h, wire_model, eff, sys, is_local, local_ctx, no_tools, no_think, packs_mask, b[0].req_body[..]);
  if bn <= 0 {
    _ = fww_emergency_compact(h, 2, ctx_win, b[0].compact_buf[..]);
    fww_hist_sanitize(h, b[0].compact_buf[..]);
    r[0].last_req_est_bytes = fww_estimate_prompt_bytes(h, sys.count, is_local, no_tools);
    bn = ifx is_gem
         then fww_build_gemini_body_packs(cfg, h, eff, sys, no_tools, packs_mask, b[0].req_body[..])
         else fww_build_openai_body_packs(cfg, h, wire_model, eff, sys, is_local, local_ctx, no_tools, no_think, packs_mask, b[0].req_body[..]);
  }
  if bn <= 0 {
    _ = fww_emergency_compact(h, 3, ctx_win, b[0].compact_buf[..]);
    fww_hist_sanitize(h, b[0].compact_buf[..]);
    r[0].last_req_est_bytes = fww_estimate_prompt_bytes(h, sys.count, is_local, no_tools);
    bn = ifx is_gem
         then fww_build_gemini_body_packs(cfg, h, eff, sys, no_tools, packs_mask, b[0].req_body[..])
         else fww_build_openai_body_packs(cfg, h, wire_model, eff, sys, is_local, local_ctx, no_tools, no_think, packs_mask, b[0].req_body[..]);
  }
  if bn <= 0 { return "Request body exceeded buffer capacity (try /compact)."; }

  ub: [512] u8;
  lbase_b: [512] u8;
  lbase := fww_trim(cl_getenv("PSIONIC_BASE_URL", lbase_b[..]));
  vx_proj := cast(string) auth[0].vx_project[0..<auth[0].nvx_project];
  vx_loc := cast(string) auth[0].vx_location[0..<auth[0].nvx_location];
  un := flawed_wire_endpoint_url(auth[0].backend, cast(string) cfg[0].base_url[0..<cfg[0].nbase_url], lbase, vx_proj, vx_loc, wire_model, ub[..]);
  url := cast(string) ub[0..<un];

  cli := GwClient.{url = url, connect_timeout_s = 15, max_time_s = 600};
  if is_local {
    cli.key_env = "";
    cli.key_value = "";
  } else if auth[0].backend == FLAWED_BE_GEMINI {
    cli.key_env = "FLAWED_REQ_KEY";
    cli.key_value = cast(string) auth[0].key[0..<auth[0].nkey];
    cli.key_header = "x-goog-api-key";
    cli.scheme = "";
  } else {
    // Vertex AI OAuth Bearer token or OpenRouter Bearer API key
    cli.key_env = "FLAWED_REQ_KEY";
    cli.key_value = cast(string) auth[0].key[0..<auth[0].nkey];
    cli.key_header = "Authorization";
    cli.scheme = "Bearer";
  }

  hdrs: [4] string;
  nh := 0;
  if auth[0].backend == FLAWED_BE_OPENROUTER {
    hdrs[nh] = "HTTP-Referer: https://openagents.com"; nh += 1;
    hdrs[nh] = "X-Title: OpenAgents Flawed"; nh += 1;
  }

  fww_emit_attempt(r, auth, "started", 0, 0, out);
  err := gw_start(cli, cast(string) b[0].req_body[0..<bn], hdrs[0..<nh], r[0].gw[..]);
  if err.count > 0 { return err; }
  r[0].streaming = true;
  return "";
}

// Start async Bash subprocess (respecting macOS Seatbelt sandbox & gitguard).
fww_start_bash :: (r: [] FwRun, cfg: [] FwConfig, tool_idx: int, cmd_str: string, timeout_s: int, out: [] u8) -> bool {
  r[0].cmd[0] = FwAsyncCmd.{h = -1, tool_idx = tool_idx};
  r[0].cmd[0].ncmd = fww_keep(r[0].cmd[0].cmd[..], cmd_str);
  def_t := ifx cfg[0].bash_timeout_s > 0 then cfg[0].bash_timeout_s else 60;
  ts := ifx timeout_s > 0 && timeout_s <= 300 then timeout_s else def_t;
  if cfg[0].bare_mode && cfg[0].bash_timeout_s > 0 && ts > cfg[0].bash_timeout_s { ts = cfg[0].bash_timeout_s; }
  if cfg[0].budget_s >= 120 && r[0].turn_start_ms > 0 {
    rem_s := cfg[0].budget_s - (proc_now_ms() - r[0].turn_start_ms) / 1000;
    max_cmd_s := rem_s - 25;
    if max_cmd_s < 15 { max_cmd_s = 15; }
    if ts > max_cmd_s { ts = max_cmd_s; }
  }
  r[0].cmd[0].deadline_ms = proc_now_ms() + ts * 1000;
  cwd := cast(string) r[0].cwd[0..<r[0].ncwd];

  h := proc_new();
  if h < 0 { return false; }

  shell_bin := ifx fs_exists("/bin/bash") then "/bin/bash" else "/bin/sh";
  use_sb := flawed_should_use_sandbox(cfg[0].sandbox_mode != FLAWED_SANDBOX_OFF, false, false, false, tool_os() == TOOL_MAC, true);
  ok := true;
  if use_sb && fs_exists("/usr/bin/sandbox-exec") {
    // Workspace-writable Seatbelt profile (Ch 12): allow read + process + writes only under cwd & /tmp.
    sb_b: [4096] u8;
    sn := fww_cat(sb_b[..], 0, "(version 1)(allow default)(deny file-write*)(allow file-write* (subpath \"");
    sn = fww_cat(sb_b[..], sn, cwd);
    sn = fww_cat(sb_b[..], sn, "\") (subpath \"/tmp\") (subpath \"/private/tmp\") (subpath \"/var/folders\") (literal \"/dev/null\") (literal \"/dev/tty\"))");
    ok = proc_arg(h, "/usr/bin/sandbox-exec") && proc_arg(h, "-p") && proc_arg(h, cast(string) sb_b[0..<sn]) && proc_arg(h, shell_bin) && proc_arg(h, "-c") && proc_arg(h, cmd_str);
  } else {
    ok = proc_arg(h, shell_bin) && proc_arg(h, "-c") && proc_arg(h, cmd_str);
  }
  ok = ok && proc_cwd(h, cwd) && proc_err_to_out(h) && proc_env(h, "PYTHONUNBUFFERED=1");
  if cfg[0].git_guard {
    ok = ok && proc_env(h, "CODER_GIT_GUARD=1");
  }
  if !ok || proc_start(h) != 0 {
    _ = proc_release(h);
    return false;
  }
  _ = proc_close_stdin(h);
  r[0].cmd[0].h = h;
  r[0].cmd[0].active = true;
  r[0].next_ticket += 1;
  r[0].waiting_ask_ticket = r[0].next_ticket;
  fww_send(out, mww_ask(out, cmd_str, r[0].waiting_ask_ticket));
  return true;
}

// Extract target path or command string from a tool call's JSON arguments for permission checking.
fww_tool_target :: (name: string, args_json: string, out: [] u8) -> string {
  nodes: [128] JvNode; d: [1] Jv;
  if !jv_parse(d[..], args_json, nodes[..]) { return ""; }
  n := 0;
  if name == "Bash" { n = jv_str(d[0], jv_get(d[0], 0, "command"), out); }
  else if name == "WebFetch" { n = jv_str(d[0], jv_get(d[0], 0, "url"), out); }
  else if name == "WalletPay" || name == "WalletQuote" {
    db: [512] u8; rb: [256] u8;
    dn := jv_str(d[0], jv_get(d[0], 0, "destination"), db[..]);
    amt := jv_int(d[0], jv_get(d[0], 0, "amount_sats"), 0);
    rn := jv_str(d[0], jv_get(d[0], 0, "reason"), rb[..]);
    if dn > 0 { n = fww_cat(out, n, cast(string) db[0..<dn]); }
    if amt > 0 { n = fww_cat(out, n, " ("); n = fww_put_int(out, n, amt); n = fww_cat(out, n, " sats)"); }
    if rn > 0 { n = fww_cat(out, n, " — "); n = fww_cat(out, n, cast(string) rb[0..<rn]); }
  }
  else if name == "OpenAgentsCli" {
    sb: [64] u8; vb: [256] u8;
    sn := jv_str(d[0], jv_get(d[0], 0, "subcommand"), sb[..]);
    if sn > 0 { n = fww_cat(out, n, cast(string) sb[0..<sn]); }
    arr := jv_get(d[0], 0, "args");
    if jv_kind(d[0], arr) == JV_ARRAY && jv_len(d[0], arr) > 0 {
      vn := jv_str(d[0], jv_at(d[0], arr, 0), vb[..]);
      if vn > 0 { n = fww_cat(out, n, " "); n = fww_cat(out, n, cast(string) vb[0..<vn]); }
    }
  }
  else if name == "GameBuilder" {
    ab: [64] u8; tb: [512] u8;
    an := jv_str(d[0], jv_get(d[0], 0, "action"), ab[..]);
    if an > 0 { n = fww_cat(out, n, cast(string) ab[0..<an]); }
    tn := jv_str(d[0], jv_get(d[0], 0, "target"), tb[..]);
    if tn > 0 { n = fww_cat(out, n, " "); n = fww_cat(out, n, cast(string) tb[0..<tn]); }
  }
  else {
    n = jv_str(d[0], jv_get(d[0], 0, "file_path"), out);
    if n <= 0 { n = jv_str(d[0], jv_get(d[0], 0, "file"), out); }
    if n <= 0 { n = jv_str(d[0], jv_get(d[0], 0, "path"), out); }
    if n <= 0 { n = jv_str(d[0], jv_get(d[0], 0, "target"), out); }
  }
  return ifx n > 0 then cast(string) out[0..<n] else "";
}

// Execute one tool call (after permission check passed). Returns true if async (Bash running).
fww_exec_tool_now :: (r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, idx: int, out: [] u8) -> bool {
  name := cast(string) r[0].acc[0].tools[idx].name[0..<r[0].acc[0].tools[idx].nname];
  args := cast(string) r[0].acc[0].tools[idx].args[0..<r[0].acc[0].tools[idx].nargs];
  cwd := cast(string) r[0].cwd[0..<r[0].ncwd];
  is_err := [1] bool.[false];

  if name == "Bash" {
    nodes: [128] JvNode; d: [1] Jv;
    cb: [FWW_CMD_MAX] u8;
    cn := 0; timeout_s := 0;
    if jv_parse(d[..], args, nodes[..]) {
      cn = jv_str(d[0], jv_get(d[0], 0, "command"), cb[..]);
      timeout_s = jv_int(d[0], jv_get(d[0], 0, "timeout"), 0);
      if timeout_s > 1000 { timeout_s = timeout_s / 1000; } // accept ms or seconds
    }
    if cn <= 0 {
      r[0].acc[0].tools[idx].done = true;
      r[0].acc[0].tools[idx].is_error = true;
      r[0].acc[0].tools[idx].nres = fww_keep(r[0].acc[0].tools[idx].res[..], "Bash requires command.");
      return false;
    }
    if fww_start_bash(r, cfg, idx, cast(string) cb[0..<cn], timeout_s, out) {
      return true;
    }
    r[0].acc[0].tools[idx].done = true;
    r[0].acc[0].tools[idx].is_error = true;
    r[0].acc[0].tools[idx].nres = fww_keep(r[0].acc[0].tools[idx].res[..], "Failed to spawn shell process.");
    return false;
  }

  rn := 0;
  is_local := auth[0].backend == FLAWED_BE_LOCAL;
  if name == "Read" {
    img_at := r[0].acc[0].ntool_img_slab;
    img_avail := r[0].acc[0].tool_img_slab.count - img_at;
    if img_avail < 0 { img_avail = 0; }
    img_mime_n := [1] int.[0];
    img_b64_n := [1] int.[0];
    rn = fww_tool_read(
      cwd, args, fww_fc(b), r[0].read_dedup[..], r[0].read_dedup_cur[..], h[0].compact_count, is_local,
      b[0].file_buf[..], r[0].acc[0].tools[idx].res[..],
      r[0].acc[0].tools[idx].img_mime[..], img_mime_n[..],
      r[0].acc[0].tool_img_slab[img_at..<img_at + img_avail], img_b64_n[..],
      is_err[..], out
    );
    if img_b64_n[0] > 0 && img_mime_n[0] > 0 {
      r[0].acc[0].tools[idx].nimg_mime = img_mime_n[0];
      r[0].acc[0].tools[idx].img_at = img_at;
      r[0].acc[0].tools[idx].nimg = img_b64_n[0];
      r[0].acc[0].ntool_img_slab = img_at + img_b64_n[0];
    }
  }
  else if name == "Edit" {
    rn = fww_tool_edit(cwd, args, fww_fc(b), r[0].read_dedup[..], b[0].file_buf[..], b[0].edit_buf[..], r[0].acc[0].tools[idx].res[..], is_err[..], out);
    if !is_err[0] { for qi: 0..<r[0].query_dedup.count { r[0].query_dedup[qi] = 0; } }
  }
  else if name == "Write" {
    rn = fww_tool_write(cwd, args, fww_fc(b), r[0].read_dedup[..], b[0].edit_buf[..], r[0].acc[0].tools[idx].res[..], is_err[..], out);
    if !is_err[0] { for qi: 0..<r[0].query_dedup.count { r[0].query_dedup[qi] = 0; } }
  }
  else if name == "Glob" || name == "Grep" {
    qh := fww_tool_sig_hash(name, args);
    q_dup := false;
    for qi: 0..<r[0].query_dedup.count { if r[0].query_dedup[qi] == qh { q_dup = true; break; } }
    if q_dup {
      rn = fww_cat(r[0].acc[0].tools[idx].res[..], 0, "Identical ");
      rn = fww_cat(r[0].acc[0].tools[idx].res[..], rn, name);
      rn = fww_cat(r[0].acc[0].tools[idx].res[..], rn, " query already ran earlier with no file edits since — refer to the earlier result above and move forward.");
    } else {
      rn = ifx name == "Glob"
           then fww_tool_glob(cwd, args, r[0].acc[0].tools[idx].res[..], is_err[..], out)
           else fww_tool_grep(cwd, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
      if !is_err[0] {
        r[0].query_dedup[r[0].query_dedup_cur % r[0].query_dedup.count] = qh;
        r[0].query_dedup_cur = (r[0].query_dedup_cur + 1) % r[0].query_dedup.count;
      }
    }
  }
  else if name == "TodoWrite" { rn = fww_tool_todos(args, r[0].acc[0].tools[idx].res[..], is_err[..], out); }
  else if name == "WebFetch" { rn = fww_tool_webfetch(args, r[0].acc[0].tools[idx].res[..], is_err[..], out); }
  else if fww_is_coax_intel_tool(name) {
    rn = fww_tool_coax_intel(cwd, name, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
    if name == "CoaxReplace" && !is_err[0] {
      for qi: 0..<r[0].query_dedup.count { r[0].query_dedup[qi] = 0; }
    }
  }
  else if oa_member_is_wallet_tool(name) {
    rn = fww_tool_wallet(name, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
  }
  else if oa_member_is_cli_tool(name) {
    rn = fww_tool_cli(cwd, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
  }
  else if oa_member_is_metaverse_tool(name) {
    rn = fww_tool_metaverse(cwd, name, args, r[0].acc[0].tools[idx].res[..], is_err[..], out);
  }
  else {
    is_err[0] = true;
    rn = fww_keep(r[0].acc[0].tools[idx].res[..], "Unknown tool.");
  }
  r[0].acc[0].tools[idx].nres = rn;
  r[0].acc[0].tools[idx].is_error = is_err[0];
  r[0].acc[0].tools[idx].done = true;
  return false;
}

// Advance tool execution queue; when all tools finish, append tool_results to history and start next LLM step.
fww_advance_tools :: (r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, st: [] McSteers, out: [] u8) -> string {
  while r[0].next_tool_idx < r[0].acc[0].ntools {
    idx := r[0].next_tool_idx;
    if r[0].acc[0].tools[idx].done { r[0].next_tool_idx += 1; continue; }

    name := cast(string) r[0].acc[0].tools[idx].name[0..<r[0].acc[0].tools[idx].nname];
    args := cast(string) r[0].acc[0].tools[idx].args[0..<r[0].acc[0].tools[idx].nargs];
    tb: [2048] u8;
    target := fww_tool_target(name, args, tb[..]);
    full_b: [FS_PATH_MAX] u8;
    check_target := ifx (name == "Edit" || name == "Write") && target.count > 0 then fww_resolve_path(cast(string) r[0].cwd[0..<r[0].ncwd], target, full_b[..]) else target;
    beh := flawed_wire_tool_permission(name, check_target, cfg[0].permission_mode, cfg[0].bypass_danger, r[0].session_allow);
    if beh == FLAWED_PBEH_DENY {
      r[0].acc[0].tools[idx].done = true;
      r[0].acc[0].tools[idx].is_error = true;
      r[0].acc[0].tools[idx].nres = fww_keep(r[0].acc[0].tools[idx].res[..], "Permission denied by active OpenAgents permission mode.");
      r[0].next_tool_idx += 1;
      continue;
    }
    if beh == FLAWED_PBEH_ASK {
      r[0].next_ticket += 1;
      r[0].permit_ticket = r[0].next_ticket;
      r[0].permit_tool_idx = idx;
      r[0].waiting_permit = true;
      is_sensitive := oa_member_is_bypass_immune(name, check_target);
      ttl_b: [160] u8;
      tn := fww_cat(ttl_b[..], 0, ifx is_sensitive then "Approve sensitive action: " else "Allow OpenAgents to run ");
      tn = fww_cat(ttl_b[..], tn, name);
      opts := ifx is_sensitive
              then "[{\"optionId\":\"allow_once\",\"name\":\"Approve once\",\"kind\":\"allow_once\"}]"
              else "[{\"optionId\":\"allow_once\",\"name\":\"Allow once\",\"kind\":\"allow_once\"},{\"optionId\":\"allow_session\",\"name\":\"Allow for session\",\"kind\":\"allow_always\"}]";
      fww_send(out, mww_permit(out, r[0].permit_ticket, false, cast(string) ttl_b[0..<tn], target, opts));
      return "";
    }
    r[0].next_tool_idx += 1;
    if fww_exec_tool_now(r, cfg, auth, h, b, idx, out) {
      return ""; // async Bash running
    }
  }

  // H3: Stuck / duplicate tool-call loop guard
  if r[0].acc[0].ntools == 1 {
    nm0 := cast(string) r[0].acc[0].tools[0].name[0..<r[0].acc[0].tools[0].nname];
    ar0 := cast(string) r[0].acc[0].tools[0].args[0..<r[0].acc[0].tools[0].nargs];
    th := fww_tool_sig_hash(nm0, ar0);
    if th == r[0].last_tool_hash {
      r[0].dup_tool_streak += 1;
      r[0].acc[0].tools[0].nres = fww_cat(r[0].acc[0].tools[0].res[..], r[0].acc[0].tools[0].nres,
        "\n[OpenAgents loop guard: you already ran this exact tool call above. Do not repeat it — try a genuinely different approach or synthesize your final answer now.]");
    } else {
      r[0].last_tool_hash = th;
      r[0].dup_tool_streak = 0;
    }
  } else {
    r[0].last_tool_hash = 0;
    r[0].dup_tool_streak = 0;
  }

  // Decide before appending tool results whether the next step must be a graceful final wrap-up (H2 + H3 + H8)
  r[0].step_num += 1;
  max_t := ifx cfg[0].max_turns > 0 then cfg[0].max_turns else 64;
  hit_last_turn := r[0].step_num >= max_t;
  hit_soft_time := r[0].soft_deadline_ms > 0 && proc_now_ms() >= r[0].soft_deadline_ms;
  hit_dup_limit := r[0].dup_tool_streak >= 2;
  need_wrapup := hit_last_turn || hit_soft_time || hit_dup_limit;

  // Track edit progress, bash verification status, & Stage-B per-turn aggregate tool-result budget
  // (Claude Code toolResultStorage.ts pattern: Read ALWAYS opts out — maxResultSizeChars: Infinity!)
  step_had_edit := false;
  step_had_bash := false;
  step_bash_ok := true;
  step_had_err := false;
  step_tot_bytes := 0;
  non_read_bytes := 0;
  non_read_cnt := 0;
  for ti: 0..<r[0].acc[0].ntools {
    nm_ti := cast(string) r[0].acc[0].tools[ti].name[0..<r[0].acc[0].tools[ti].nname];
    err_ti := r[0].acc[0].tools[ti].is_error;
    if err_ti { step_had_err = true; }
    if (nm_ti == "Edit" || nm_ti == "Write") && !err_ti {
      ar_ti := cast(string) r[0].acc[0].tools[ti].args[0..<r[0].acc[0].tools[ti].nargs];
      pt_b: [512] u8;
      tgt_ti := fww_tool_target(nm_ti, ar_ti, pt_b[..]);
      if !fww_is_scratch_path(tgt_ti) {
        step_had_edit = true;
      }
    }
    if nm_ti == "Bash" {
      step_had_bash = true;
      if err_ti { step_bash_ok = false; }
    }
    nb_ti := r[0].acc[0].tools[ti].nres;
    step_tot_bytes += nb_ti;
    if nm_ti != "Read" {
      non_read_bytes += nb_ti;
      non_read_cnt += 1;
    }
  }
  if step_had_edit { r[0].has_edited = true; r[0].last_bash_ok = false; }
  else if !r[0].has_edited { r[0].read_only_steps += 1; }
  if step_had_bash { r[0].last_bash_ok = step_bash_ok; }
  r[0].last_step_had_err = step_had_err;
  if r[0].has_edited { r[0].post_edit_steps += 1; }
  r[0].turn_tool_bytes += step_tot_bytes;

  // All tool calls finished! Compute exact slab bytes needed so TOOL_RESULTS NEVER truncates id/name/output/image.
  tr_need := 16384;
  for ti: 0..<r[0].acc[0].ntools {
    tr_need += r[0].acc[0].tools[ti].nid + r[0].acc[0].tools[ti].nname + r[0].acc[0].tools[ti].nres
             + r[0].acc[0].tools[ti].nimg_mime + r[0].acc[0].tools[ti].nimg;
  }
  if h[0].nmsgs >= FWW_MAX_MSGS - 1 || h[0].nslab + tr_need >= FWW_SLAB {
    _ = fww_hist_compact(h, b[0].compact_buf[..]);
  }
  if h[0].nmsgs >= FWW_MAX_MSGS - 1 || h[0].nslab + tr_need >= FWW_SLAB {
    _ = fww_emergency_compact(h, 2, 0, b[0].compact_buf[..]);
  }
  if h[0].nmsgs < FWW_MAX_MSGS {
    mi := h[0].nmsgs;
    h[0].msgs[mi] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS};
    nb := 0;
    is_local_tr := auth[0].backend == FLAWED_BE_LOCAL;
    turn_budget := ifx is_local_tr then FWW_TURN_TOOLS_BUDGET_LOCAL else FWW_TURN_TOOLS_BUDGET_CLOUD;
    per_non_read_cap := ifx is_local_tr then FWW_LOCAL_TOOL_OUT_MAX else FWW_TOOL_OUT_MAX;
    if non_read_bytes > turn_budget && non_read_cnt > 1 {
      share := turn_budget / non_read_cnt;
      min_share := ifx is_local_tr then 4096 else 10240;
      if share < min_share { share = min_share; }
      if share < per_non_read_cap { per_non_read_cap = share; }
    }
    for i: 0..<r[0].acc[0].ntools {
      if nb >= FWW_MAX_BLOCKS { break; }
      a0 := [1] int.[0];
      id_s := cast(string) r[0].acc[0].tools[i].id[0..<r[0].acc[0].tools[i].nid];
      nm_s := cast(string) r[0].acc[0].tools[i].name[0..<r[0].acc[0].tools[i].nname];
      res_s := cast(string) r[0].acc[0].tools[i].res[0..<r[0].acc[0].tools[i].nres];
      // Claude Code invariant: Read is self-bounded (FWW_READ_CLOUD_BYTES / FWW_LOCAL_TOOL_OUT_MAX) and opts out of Stage B!
      if nm_s != "Read" && res_s.count > per_non_read_cap {
        why_s := ifx is_local_tr then "truncated for 32K local context; use targeted filters;" else "trimmed by per-turn tool-result budget; use narrower Grep path/glob or concise Bash output;";
        sn := fww_shrink_head_tail(b[0].compact_buf[..], 0, res_s, per_non_read_cap, why_s);
        res_s = cast(string) b[0].compact_buf[0..<sn];
      }
      // Hard slab guard: reserve space for remaining tools' id+name+metadata so name/id can NEVER be clipped.
      rem_tools := r[0].acc[0].ntools - i;
      reserve := rem_tools * 512 + 8192;
      avail_res := FWW_SLAB - h[0].nslab - id_s.count - nm_s.count - reserve;
      if avail_res < 256 { avail_res = 256; }
      if res_s.count > avail_res {
        sn := fww_shrink_head_tail(b[0].compact_buf[..], 0, res_s, avail_res, "trimmed for history slab;");
        res_s = cast(string) b[0].compact_buf[0..<sn];
      }
      bk := FwBlock.{kind = FWW_MB_TOOL_RES, is_error = r[0].acc[0].tools[i].is_error};
      bk.id_n = fww_slab_put(h, id_s, a0[..]); bk.id_at = a0[0];
      bk.name_n = fww_slab_put(h, nm_s, a0[..]); bk.name_at = a0[0];
      bk.text_n = fww_slab_put(h, res_s, a0[..]); bk.text_at = a0[0];
      if r[0].acc[0].tools[i].nimg > 0 && r[0].acc[0].tools[i].nimg_mime > 0 {
        im_s := cast(string) r[0].acc[0].tools[i].img_mime[0..<r[0].acc[0].tools[i].nimg_mime];
        idb_s := cast(string) r[0].acc[0].tool_img_slab[r[0].acc[0].tools[i].img_at..<r[0].acc[0].tools[i].img_at + r[0].acc[0].tools[i].nimg];
        if h[0].nslab + im_s.count + idb_s.count + reserve < FWW_SLAB {
          bk.img_mime_n = fww_slab_put(h, im_s, a0[..]); bk.img_mime_at = a0[0];
          bk.img_n = fww_slab_put(h, idb_s, a0[..]); bk.img_at = a0[0];
        }
      }
      h[0].msgs[mi].blocks[nb] = bk;
      nb += 1;
    }
    // Cache-safe time-aware & wall-budget-aware <system-reminder> pacing nudges (folded into last functionResponse on Gemini)
    if !cfg[0].bare_mode && !need_wrapup && nb < FWW_MAX_BLOCKS {
      elapsed_s := ifx r[0].turn_start_ms > 0 then (proc_now_ms() - r[0].turn_start_ms) / 1000 else 0;
      bs := cfg[0].budget_s;
      nudge := "";
      nbuf: [512] u8;
      // Optional wall-budget checkpoints (when FLAWED_BUDGET_S > 0, e.g. timed CI/benchmark runs)
      if bs >= 120 {
        rem_s := ifx bs > elapsed_s then bs - elapsed_s else 0;
        if r[0].time_warn_stage < 4 && elapsed_s * 100 >= bs * 90 {
          r[0].time_warn_stage = 4;
          r[0].calm_steps = 2;
          nn := fww_cat(nbuf[..], 0, "<system-reminder>FINAL time checkpoint (~");
          nn = fww_put_int(nbuf[..], nn, rem_s);
          if r[0].has_edited && r[0].last_bash_ok && !r[0].last_step_had_err {
            r[0].finish_nudged = true;
            nn = fww_cat(nbuf[..], nn, "s left): your checks are green. Stop here and reply concisely NOW — do NOT run sleeps, slow commands, or extra checks.</system-reminder>");
          } else {
            nn = fww_cat(nbuf[..], nn, "s left): write/finalize your deliverable outputs IMMEDIATELY, run at most one quick (<15s) smoke check (no long sleeps), and conclude now.</system-reminder>");
          }
          nudge = cast(string) nbuf[0..<nn];
        } else if r[0].time_warn_stage < 3 && elapsed_s * 100 >= bs * 80 {
          r[0].time_warn_stage = 3;
          r[0].calm_steps = 2;
          nn := fww_cat(nbuf[..], 0, "<system-reminder>Time budget checkpoint (~");
          nn = fww_put_int(nbuf[..], nn, rem_s);
          if r[0].has_edited && r[0].last_bash_ok && !r[0].last_step_had_err {
            if !r[0].audit_nudged {
              r[0].audit_nudged = true;
              nn = fww_cat(nbuf[..], nn, "s left): your initial check passed. Run ONE fast adversarial/edge-case test checking every explicit requirement and varied inputs (not just default fixtures), fix any gap immediately, clean up temp files, and conclude before the deadline.</system-reminder>");
            } else {
              r[0].finish_nudged = true;
              nn = fww_cat(nbuf[..], nn, "s left): your workspace edits and post-audit checks are green. Clean up any stray temporary files if needed and conclude concisely now.</system-reminder>");
            }
          } else if !r[0].has_edited {
            nn = fww_cat(nbuf[..], nn, "s left): stop all exploration/probing immediately, write your complete deliverable solution files (or apply live target changes) in THIS turn, and run one fast end-to-end verification check.</system-reminder>");
          } else {
            nn = fww_cat(nbuf[..], nn, "s left): prioritize fixing the remaining failing check directly in this turn and re-run fast verification immediately.</system-reminder>");
          }
          nudge = cast(string) nbuf[0..<nn];
        } else if !r[0].has_edited && r[0].time_warn_stage < 2 && elapsed_s * 100 >= bs * 60 {
          r[0].time_warn_stage = 2;
          r[0].calm_steps = 2;
          nn := fww_cat(nbuf[..], 0, "<system-reminder>Urgent time checkpoint (");
          nn = fww_put_int(nbuf[..], nn, elapsed_s);
          nn = fww_cat(nbuf[..], nn, "s elapsed, ~");
          nn = fww_put_int(nbuf[..], nn, rem_s);
          nn = fww_cat(nbuf[..], nn, "s remaining, zero deliverable workspace files edited yet): stop incremental probe scripts now. Immediately write/apply your deliverable solution in THIS turn and verify end-to-end.</system-reminder>");
          nudge = cast(string) nbuf[0..<nn];
        } else if !r[0].has_edited && r[0].time_warn_stage < 1 && elapsed_s * 100 >= bs * 35 {
          r[0].time_warn_stage = 1;
          r[0].calm_steps = 1;
          nn := fww_cat(nbuf[..], 0, "<system-reminder>Time checkpoint (");
          nn = fww_put_int(nbuf[..], nn, elapsed_s);
          nn = fww_cat(nbuf[..], nn, "s elapsed, ~");
          nn = fww_put_int(nbuf[..], nn, rem_s);
          nn = fww_cat(nbuf[..], nn, "s remaining, no workspace edits yet): stop running probe-by-probe commands. Synthesize what you know, apply your concrete deliverable edits/writes (or target changes) now, and iterate from end-to-end test output.</system-reminder>");
          nudge = cast(string) nbuf[0..<nn];
        }
      }
      if nudge.count == 0 {
        if !r[0].has_edited {
          if r[0].nudge_stage == 2 && (r[0].read_only_steps >= 13 || (elapsed_s >= 320 && r[0].read_only_steps >= 9)) {
            r[0].nudge_stage = 3;
            nudge = "<system-reminder>Urgent pacing alert: stop further read-only exploration now. Emit your concrete Edit/Write in THIS turn and run the targeted verification command.</system-reminder>";
          } else if r[0].nudge_stage == 1 && (r[0].read_only_steps >= 10 || (elapsed_s >= 220 && r[0].read_only_steps >= 7)) {
            r[0].nudge_stage = 2;
            nudge = "<system-reminder>Pacing alert: stop searching peripheral files or running tiny probe scripts. Apply your concrete Edit/Write on the target file(s) in this turn (batching independent edits) and test against real execution.</system-reminder>";
          } else if r[0].nudge_stage == 0 && (r[0].read_only_steps >= 6 || (r[0].read_only_steps >= 4 && elapsed_s >= 120)) {
            r[0].nudge_stage = 1;
            nudge = "<system-reminder>Exploration checkpoint: you have inspected the relevant files across multiple read-only turns. Synthesize the general invariant, apply your Edit/Write changes now, and validate with automated tests. (If the user only asked a question, answer concisely now.)</system-reminder>";
          }
        } else if r[0].last_bash_ok && !r[0].last_step_had_err {
          if !r[0].audit_nudged {
            r[0].audit_nudged = true;
            nudge = "<system-reminder>Your initial check passed. Before finishing, critically challenge your patch from first principles: (1) does it hold for the general invariant across multiple sequential, concurrent, or interleaved operations and edge cases (such as multi-step state transitions, deletions, and boundary or malformed inputs), not only the minimal repro? (2) are all explicit specification constraints and error paths verified by an automated check (re-running your full test suite after any edit and cleaning up temporary test files inside the workspace afterward)? If everything holds, conclude concisely.</system-reminder>";
          } else {
            r[0].audit_done = true;
            if !r[0].finish_nudged && (r[0].post_edit_steps >= 7 || elapsed_s >= 420) {
              r[0].finish_nudged = true;
              nudge = "<system-reminder>Your edits and post-audit verification checks are green. Stop here and reply concisely — do NOT run redundant extra checks or gold-plate.</system-reminder>";
            }
          }
        }
      }
      if nudge.count > 0 {
        a0 := [1] int.[0];
        nb_rem := FwBlock.{kind = FWW_MB_TEXT};
        nb_rem.text_n = fww_slab_put(h, nudge, a0[..]); nb_rem.text_at = a0[0];
        h[0].msgs[mi].blocks[nb] = nb_rem;
        nb += 1;
      }
    }
    // Inject any pending mid-turn steers right into this user turn!
    if st[0].n > 0 && nb < FWW_MAX_BLOCKS {
      jb: [MWQ_MESSAGE] u8;
      stxt := mc_steer_join(st, jb[..]);
      if stxt.count > 0 {
        a0 := [1] int.[0];
        sb := FwBlock.{kind = FWW_MB_TEXT};
        sb.text_n = fww_slab_put(h, stxt, a0[..]); sb.text_at = a0[0];
        h[0].msgs[mi].blocks[nb] = sb;
        nb += 1;
        _ = mc_steer_take(st, r[0].step_num);
      }
    }
    // Inject graceful wrap-up instruction on final turn / soft deadline / duplicate-loop cap
    if need_wrapup && !r[0].force_wrapup_once && nb < FWW_MAX_BLOCKS {
      a0 := [1] int.[0];
      wb := FwBlock.{kind = FWW_MB_TEXT};
      wmsg := "Wrap-up turn: do not call any more tools. Using all computations and tool outputs above, write your complete, concise final answer now in the exact format requested by the user.";
      wb.text_n = fww_slab_put(h, wmsg, a0[..]); wb.text_at = a0[0];
      h[0].msgs[mi].blocks[nb] = wb;
      nb += 1;
    }
    h[0].msgs[mi].nblocks = nb;
    h[0].nmsgs += 1;
  }

  if need_wrapup {
    if r[0].force_wrapup_once {
      r[0].active = false;
      fww_send(out, mww_ended(out, "finished", "Reached Flawed max turns limit."));
      return "finished";
    }
    r[0].force_wrapup_once = true;
    if hit_soft_time && auth[0].backend == FLAWED_BE_LOCAL {
      r[0].force_no_think_once = true;
    }
  }
  if cfg[0].max_budget_micros > 0 && r[0].turn_cost_micros >= cfg[0].max_budget_micros {
    r[0].active = false;
    fww_send(out, mww_ended(out, "finished", "Reached Flawed max budget limit."));
    return "finished";
  }

  err := fww_start_request(r, cfg, auth, h, b, out);
  if err.count > 0 {
    r[0].active = false;
    fww_send(out, mww_ended(out, "failed", err));
    return "failed";
  }
  return "";
}

// Extract readable error.message from single-object or Gemini array error response body.
fww_extract_err_msg :: (raw_body: string, out: [] u8) -> int {
  t := fww_trim(raw_body);
  if t.count == 0 { return 0; }
  nodes: [256] JvNode; d: [1] Jv;
  if jv_parse(d[..], t, nodes[..]) {
    root := 0;
    if jv_kind(d[0], 0) == JV_ARRAY && jv_len(d[0], 0) > 0 { root = jv_at(d[0], 0, 0); }
    em := jv_path(d[0], root, "error.message");
    if em < 0 { em = jv_get(d[0], root, "message"); }
    if em >= 0 {
      n := jv_str(d[0], em, out);
      if n > 0 { return n; }
    }
  }
  return fww_keep(out, t);
}

// Commit finished assistant stream into history, then either run tools or end turn.
fww_finish_stream :: (r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, st: [] McSteers, out: [] u8) -> string {
  status := r[0].gw[0].status;
  exit_code := r[0].gw[0].exit;
  gw_close(r[0].gw[..]);
  r[0].streaming = false;
  r[0].last_req_dur_ms = ifx r[0].req_start_ms > 0 then proc_now_ms() - r[0].req_start_ms else 0;

  // Check transport / HTTP error with reactive context-overflow compaction + Ch 05 retry policy
  if status < 200 || status >= 300 || r[0].acc[0].saw_error {
    if r[0].acc[0].nerr == 0 && r[0].acc[0].nerr_body > 0 {
      r[0].acc[0].nerr = fww_extract_err_msg(cast(string) r[0].acc[0].err_body[0..<r[0].acc[0].nerr_body], r[0].acc[0].err_msg[..]);
    }
    err_s := cast(string) r[0].acc[0].err_msg[0..<r[0].acc[0].nerr];
    is_sig_err := fww_contains_ci(err_s, "thought signature")
               || fww_contains_ci(err_s, "thought_signature")
               || fww_contains_ci(err_s, "thoughtsignature");
    is_invalid_arg := (status == 400 || r[0].acc[0].saw_error)
                   && (fww_contains_ci(err_s, "invalid argument")
                    || fww_contains_ci(err_s, "proto is invalid"));
    is_struct_err := is_sig_err
                  || fww_contains_ci(err_s, "ending with a model turn")
                  || fww_contains_ci(err_s, "function call turn")
                  || fww_contains_ci(err_s, "function response turn")
                  || fww_contains_ci(err_s, "must alternate")
                  || fww_contains_ci(err_s, "tool_call_id")
                  || (is_invalid_arg && h[0].nmsgs > 1);
    if (fww_is_context_overflow_err(err_s) || is_struct_err) && r[0].ctx_recoveries < 3 {
      r[0].ctx_recoveries += 1;
      if fww_is_context_overflow_err(err_s) {
        parsed_lim := fww_parse_ctx_limit_from_err(err_s);
        if parsed_lim >= 2048 && (r[0].effective_ctx_cap == 0 || parsed_lim < r[0].effective_ctx_cap) {
          r[0].effective_ctx_cap = parsed_lim;
        }
        _ = fww_emergency_compact(h, r[0].ctx_recoveries, r[0].effective_ctx_cap, b[0].compact_buf[..]);
      } else if is_sig_err && r[0].ctx_recoveries == 1 {
        // Surgical signature repair: preserve full conversation history instead of wiping 50K+ tokens!
        if h[0].nslab + 64 >= FWW_SLAB { _ = fww_hist_compact(h, b[0].compact_buf[..]); }
        fww_hist_strip_thought_sigs(h);
      } else {
        // Structural turn mismatch / Vertex INVALID_ARGUMENT on multi-turn history: collapse to clean summary USER turn!
        _ = fww_emergency_compact(h, 3, r[0].effective_ctx_cap, b[0].compact_buf[..]);
      }
      fww_hist_sanitize(h, b[0].compact_buf[..]);
      r[0].retry[0] = FlawedRetryState.{};
      fww_emit_attempt(r, auth, "retried", status, 0, out);
      err2 := fww_start_request(r, cfg, auth, h, b, out);
      if err2.count == 0 { return ""; }
    }
    transient_sse := r[0].acc[0].saw_error && fww_is_transient_sse_err(err_s);
    eff_status := ifx transient_sse then 503 else (ifx status > 0 then status else 503);
    ri := FlawedRetryInput.{
      status = eff_status,
      is_foreground = true,
      retry_after_ms = -1,
    };
    dec := flawed_eval_retry(r[0].retry[..], ri);
    if dec.action == FLAWED_RETRY_SLEEP && (!r[0].acc[0].saw_error || transient_sse) {
      fww_emit_attempt(r, auth, "retried", eff_status, 0, out);
      r[0].retry_at_ms = proc_now_ms() + dec.delay_ms;
      return "";
    }
    fww_emit_attempt(r, auth, "failed", status, 0, out);
    eb: [640] u8;
    en := 0;
    if r[0].acc[0].nerr > 0 {
      en = fww_cat(eb[..], 0, cast(string) r[0].acc[0].err_msg[0..<r[0].acc[0].nerr]);
    } else if status == 401 || status == 403 {
      en = fww_cat(eb[..], 0, "Authentication failed (HTTP ");
      en = fww_put_int(eb[..], en, status);
      en = fww_cat(eb[..], en, "). Check your Vertex AI / Gemini credentials in Settings → Flawed.");
    } else if status > 0 {
      en = fww_cat(eb[..], 0, "API request failed with HTTP ");
      en = fww_put_int(eb[..], en, status);
    } else {
      en = fww_cat(eb[..], 0, "Could not reach API server (curl exit ");
      en = fww_put_int(eb[..], en, exit_code);
      en = fww_cat(eb[..], en, ").");
    }
    r[0].active = false;
    fww_send(out, mww_ended(out, "failed", cast(string) eb[0..<en]));
    return "failed";
  }

  // Account cost via coax/lib/gateway/card.coax ($0 for Local Psionic Metal)
  cost := 0;
  if auth[0].backend != FLAWED_BE_LOCAL {
    gwn := fww_gw_name(auth[0].backend);
    rm := ifx r[0].acc[0].nresp_model > 0 then cast(string) r[0].acc[0].resp_model[0..<r[0].acc[0].nresp_model] else flawed_wire_strip_model(cast(string) r[0].model[0..<r[0].nmodel]);
    rf := gw_rate(gwn, rm);
    if !rf.ok { rf = gw_rate("vertex", rm); }
    if rf.ok {
      cost = gw_card_cost(rf.rate, r[0].acc[0].in_tok, r[0].acc[0].cache_read, 0, r[0].acc[0].out_tok);
    }
  }
  r[0].ctx_recoveries = 0;
  r[0].turn_cost_micros += cost;
  h[0].total_in += r[0].acc[0].in_tok;
  h[0].total_out += r[0].acc[0].out_tok;
  h[0].total_cached += r[0].acc[0].cache_read;
  h[0].total_cost_micros += cost;
  if r[0].acc[0].in_tok > 0 {
    h[0].last_in_tok = r[0].acc[0].in_tok;
    h[0].last_in_bytes = r[0].last_req_est_bytes;
  }
  if auth[0].backend != FLAWED_BE_LOCAL {
    now_fin := proc_now_ms();
    h[0].last_cloud_turn_ms = now_fin;
    if r[0].acc[0].cache_read > 0 { h[0].last_cached_tok = r[0].acc[0].cache_read; }
    // Adaptive thinking cooldown: measured strictly on actual decode duration (excluding TTFT queue wait).
    // After a heavy (>=120s decode) deep-reasoning step, run the next 2 execution/testing steps at medium
    // effort so back-to-back 150-185s rumination loops don't starve edit-test-fix iteration.
    dec_fin_ms := ifx r[0].first_tok_ms > 0 && now_fin > r[0].first_tok_ms then now_fin - r[0].first_tok_ms else 0;
    if cfg[0].thinking_mode == FLAWED_THINK_ADAPTIVE && !cfg[0].bare_mode && dec_fin_ms >= 120000 && r[0].calm_steps < 2 {
      r[0].calm_steps = 2;
    }
  }
  fww_emit_attempt(r, auth, "done", status, cost, out);

  // Append assistant message to history (compute exact slab headroom so ASSISTANT + TOOL_USE names/args/sigs never clip!)
  asst_need := r[0].acc[0].nthink + r[0].acc[0].ntext + r[0].acc[0].nsig * 2 + 8192;
  for t: 0..<r[0].acc[0].ntools {
    asst_need += r[0].acc[0].tools[t].nid + r[0].acc[0].tools[t].nname + r[0].acc[0].tools[t].nargs + r[0].acc[0].tools[t].nsig;
  }
  if h[0].nmsgs >= FWW_MAX_MSGS - 2 || h[0].nslab + asst_need >= FWW_SLAB {
    _ = fww_hist_compact(h, b[0].compact_buf[..]);
  }
  if h[0].nmsgs >= FWW_MAX_MSGS - 2 || h[0].nslab + asst_need >= FWW_SLAB {
    _ = fww_emergency_compact(h, 2, 0, b[0].compact_buf[..]);
  }
  if h[0].nmsgs >= FWW_MAX_MSGS - 2 || h[0].nslab + asst_need >= FWW_SLAB {
    _ = fww_emergency_compact(h, 3, 0, b[0].compact_buf[..]);
  }
  if h[0].nmsgs < FWW_MAX_MSGS {
    mi := h[0].nmsgs;
    h[0].msgs[mi] = FwMsg.{role = FWW_MROLE_ASSISTANT};
    nb := 0;
    a0 := [1] int.[0];
    if r[0].acc[0].nthink > 0 && nb < FWW_MAX_BLOCKS {
      tb := FwBlock.{kind = FWW_MB_THINK};
      tb.text_n = fww_slab_put(h, cast(string) r[0].acc[0].think[0..<r[0].acc[0].nthink], a0[..]); tb.text_at = a0[0];
      if r[0].acc[0].nsig > 0 { tb.sig_n = fww_slab_put(h, cast(string) r[0].acc[0].sig[0..<r[0].acc[0].nsig], a0[..]); tb.sig_at = a0[0]; }
      h[0].msgs[mi].blocks[nb] = tb; nb += 1;
    }
    if (r[0].acc[0].ntext > 0 || (r[0].acc[0].nsig > 0 && r[0].acc[0].ntools == 0)) && nb < FWW_MAX_BLOCKS {
      xb := FwBlock.{kind = FWW_MB_TEXT};
      xb.text_n = fww_slab_put(h, cast(string) r[0].acc[0].text[0..<r[0].acc[0].ntext], a0[..]); xb.text_at = a0[0];
      if r[0].acc[0].nsig > 0 && r[0].acc[0].ntools == 0 { xb.sig_n = fww_slab_put(h, cast(string) r[0].acc[0].sig[0..<r[0].acc[0].nsig], a0[..]); xb.sig_at = a0[0]; }
      h[0].msgs[mi].blocks[nb] = xb; nb += 1;
    }
    for t: 0..<r[0].acc[0].ntools {
      if nb >= FWW_MAX_BLOCKS { break; }
      ub := FwBlock.{kind = FWW_MB_TOOL_USE};
      ub.id_n = fww_slab_put(h, cast(string) r[0].acc[0].tools[t].id[0..<r[0].acc[0].tools[t].nid], a0[..]); ub.id_at = a0[0];
      ub.name_n = fww_slab_put(h, cast(string) r[0].acc[0].tools[t].name[0..<r[0].acc[0].tools[t].nname], a0[..]); ub.name_at = a0[0];
      ub.text_n = fww_slab_put(h, cast(string) r[0].acc[0].tools[t].args[0..<r[0].acc[0].tools[t].nargs], a0[..]); ub.text_at = a0[0];
      if r[0].acc[0].tools[t].nsig > 0 {
        sa := r[0].acc[0].tools[t].sig_at;
        sn := r[0].acc[0].tools[t].nsig;
        ub.sig_n = fww_slab_put(h, cast(string) r[0].acc[0].tool_sig_slab[sa..<sa + sn], a0[..]); ub.sig_at = a0[0];
      } else if t == 0 && r[0].acc[0].nsig > 0 {
        ub.sig_n = fww_slab_put(h, cast(string) r[0].acc[0].sig[0..<r[0].acc[0].nsig], a0[..]); ub.sig_at = a0[0];
      }
      h[0].msgs[mi].blocks[nb] = ub; nb += 1;
    }
    if nb > 0 {
      h[0].msgs[mi].nblocks = nb;
      h[0].nmsgs += 1;
    }
  }

  // If tool calls were emitted, run them!
  if r[0].acc[0].ntools > 0 {
    r[0].next_tool_idx = 0;
    return fww_advance_tools(r, cfg, auth, h, b, st, out);
  }

  // H1: Automatic bounded recovery when a turn ends with empty visible text (e.g. max_tokens exhausted inside thinking).
  if r[0].acc[0].ntext == 0 && r[0].acc[0].stop_reason != FLAWED_STOP_REFUSAL && r[0].recoveries < 3 && h[0].nmsgs < FWW_MAX_MSGS {
    r[0].recoveries += 1;
    hit_think_cap := r[0].acc[0].stop_reason == FLAWED_STOP_MAX_TOKENS || r[0].acc[0].nthink > 8192;
    if hit_think_cap && auth[0].backend != FLAWED_BE_LOCAL {
      // Step down thinkingLevel one notch for the next 2 steps to break consecutive 32K thinking spirals.
      r[0].calm_steps = 2;
    }
    rb: [3072] u8;
    rn := 0;
    if r[0].acc[0].nthink > 0 {
      tlen := r[0].acc[0].nthink;
      tfrom := ifx tlen > 1800 then tlen - 1800 else 0;
      rn = fww_cat(rb[..], rn, "Your previous step hit the output token limit while reasoning without emitting tool calls or a reply. End of your scratchpad:\n\n");
      rn = fww_cat(rb[..], rn, cast(string) r[0].acc[0].think[tfrom..<tlen]);
      rn = fww_cat(rb[..], rn, "\n\nDo NOT re-derive from scratch. Keep reasoning brief and immediately emit your concrete Edit/Write/Bash tool calls to implement and test your changes (or, if already verified, write your concise final answer now).");
    } else {
      rn = fww_cat(rb[..], rn, "Your previous response was empty. Immediately emit your next concrete tool call or write your concise final answer.");
    }
    fww_hist_push_user(h, cast(string) rb[0..<rn]);
    if auth[0].backend == FLAWED_BE_LOCAL {
      r[0].force_no_think_once = true;
    }
    if r[0].recoveries >= 3 || (r[0].recoveries >= 2 && r[0].has_edited && r[0].last_bash_ok) {
      r[0].force_wrapup_once = true;
    }
    err := fww_start_request(r, cfg, auth, h, b, out);
    if err.count == 0 { return ""; }
  }

  // Otherwise finish the turn!
  r[0].active = false;
  final_txt := cast(string) r[0].acc[0].text[0..<r[0].acc[0].ntext];
  fww_send(out, mww_ended(out, "finished", final_txt));
  return "finished";
}

// Poll active stream, retry backoff, or active Bash subprocess. Returns (emitted_activity, ended_string).
fww_poll_step :: (r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, st: [] McSteers, out: [] u8, active_io: [] bool) -> string {
  active_io[0] = false;
  if !r[0].active { return ""; }

  // 1. Waiting for retry backoff timer
  if r[0].retry_at_ms > 0 {
    if proc_now_ms() >= r[0].retry_at_ms {
      r[0].retry_at_ms = 0;
      err := fww_start_request(r, cfg, auth, h, b, out);
      if err.count > 0 {
        r[0].active = false;
        fww_send(out, mww_ended(out, "failed", err));
        return "failed";
      }
      active_io[0] = true;
    }
    return "";
  }

  // 2. Waiting for interactive permission card answer
  if r[0].waiting_permit { return ""; }

  // 3. Active async Bash subprocess
  if r[0].cmd[0].active {
    lbuf: [4096] u8;
    for step: 0..<64 {
      ln := proc_line(r[0].cmd[0].h, 0, lbuf[..]);
      if ln == PROC_TIMEOUT { break; }
      if ln == PROC_EOF || ln < 0 {
        exit_c := proc_wait(r[0].cmd[0].h, 2000);
        _ = proc_release(r[0].cmd[0].h);
        r[0].cmd[0].h = -1;
        r[0].cmd[0].active = false;
        ti := r[0].cmd[0].tool_idx;
        cmd_s := cast(string) r[0].cmd[0].cmd[0..<r[0].cmd[0].ncmd];
        _ = fww_cmd_finalize(r[0].cmd[..]);
        out_s := cast(string) r[0].cmd[0].out[0..<r[0].cmd[0].nout];
        fww_send(out, mww_command(out, cmd_s, exit_c, r[0].cmd[0].timed_out, out_s));
        r[0].acc[0].tools[ti].nres = fww_cmd_tool_result(r[0].cmd[..], exit_c, r[0].cmd[0].timed_out, r[0].acc[0].tools[ti].res[..]);
        r[0].acc[0].tools[ti].is_error = exit_c != 0 || r[0].cmd[0].timed_out;
        r[0].acc[0].tools[ti].done = true;
        active_io[0] = true;
        return fww_advance_tools(r, cfg, auth, h, b, st, out);
      }
      active_io[0] = true;
      fww_cmd_push_line(r[0].cmd[..], cast(string) lbuf[0..<ln]);
    }
    if proc_now_ms() >= r[0].cmd[0].deadline_ms {
      r[0].cmd[0].timed_out = true;
      _ = proc_kill(r[0].cmd[0].h, PROC_SIGTERM);
      if proc_wait(r[0].cmd[0].h, 400) < 0 { _ = proc_kill(r[0].cmd[0].h, PROC_SIGKILL); _ = proc_wait(r[0].cmd[0].h, 400); }
      _ = proc_release(r[0].cmd[0].h);
      r[0].cmd[0].h = -1;
      r[0].cmd[0].active = false;
      ti := r[0].cmd[0].tool_idx;
      cmd_s := cast(string) r[0].cmd[0].cmd[0..<r[0].cmd[0].ncmd];
      _ = fww_cmd_finalize(r[0].cmd[..]);
      out_s := cast(string) r[0].cmd[0].out[0..<r[0].cmd[0].nout];
      fww_send(out, mww_command(out, cmd_s, 124, true, out_s));
      r[0].acc[0].tools[ti].nres = fww_cmd_tool_result(r[0].cmd[..], 124, true, r[0].acc[0].tools[ti].res[..]);
      r[0].acc[0].tools[ti].is_error = true;
      r[0].acc[0].tools[ti].done = true;
      return fww_advance_tools(r, cfg, auth, h, b, st, out);
    }
    return "";
  }

  // 4. Active streaming HTTP SSE response (drain up to 32 SSE lines per tick with zero lag!)
  if !r[0].streaming { return ""; }
  is_gem := flawed_wire_is_gemini(auth[0].backend);
  for step: 0..<32 {
    rd := gw_poll_wait(r[0].gw[..], b[0].sse_line[..], 0);
    if rd.kind == GW_IDLE { break; }
    active_io[0] = true;
    if rd.kind == GW_END {
      return fww_finish_stream(r, cfg, auth, h, b, st, out);
    }
    if rd.kind != GW_LINE { continue; }
    // Collect non-2xx error body (including multi-line Vertex JSON arrays) for clean reporting
    if r[0].gw[0].status >= 400 {
      if rd.text.count > 0 {
        r[0].acc[0].nerr_body = fww_cat(r[0].acc[0].err_body[..], r[0].acc[0].nerr_body, rd.text);
        r[0].acc[0].nerr_body = fww_cat(r[0].acc[0].err_body[..], r[0].acc[0].nerr_body, "\n");
      }
      continue;
    }
    // Feed line through SSE parser (or direct data: prefix)
    data := "";
    if flawed_aw_starts(rd.text, "data: ") {
      data = cast(string) rd.text[6..<rd.text.count];
    } else if flawed_aw_starts(rd.text, "data:") {
      data = cast(string) rd.text[5..<rd.text.count];
    } else {
      continue;
    }
    data = fww_trim(data);
    if data.count == 0 { continue; }

    ev: [1] FlawedWireSseEvent;
    if is_gem {
      sig_n := [1] int.[0];
      for pi: 0..<FWW_MAX_BLOCKS {
        nparts := flawed_wire_parse_gemini_sse(data, pi, ev[..], b[0].ev_txt[..], b[0].sig_buf[..], sig_n[..]);
        if nparts < 0 { break; }
        if ev[0].stop_reason != FLAWED_STOP_NONE { r[0].acc[0].stop_reason = ev[0].stop_reason; }
        if ev[0].input_tokens > 0 { r[0].acc[0].in_tok = ev[0].input_tokens; }
        if ev[0].output_tokens > 0 { r[0].acc[0].out_tok = ev[0].output_tokens; }
        if ev[0].cache_read_tokens > 0 { r[0].acc[0].cache_read = ev[0].cache_read_tokens; }
        k := ev[0].kind;
        if k == FLAWED_SSE_THINK_DELTA {
          if ev[0].text_n > 0 {
            now_rx := proc_now_ms();
            if r[0].first_tok_ms == 0 { r[0].first_tok_ms = now_rx; }
            r[0].stream_last_rx_ms = now_rx;
            piece := cast(string) b[0].ev_txt[0..<ev[0].text_n];
            r[0].acc[0].nthink = fww_cat(r[0].acc[0].think[..], r[0].acc[0].nthink, piece);
            if !cfg[0].thinking_hidden { fww_send(out, mww_thought(out, piece)); }
          }
          if sig_n[0] > 0 { r[0].acc[0].nsig = fww_keep(r[0].acc[0].sig[..], cast(string) b[0].sig_buf[0..<sig_n[0]]); }
        } else if k == FLAWED_SSE_TEXT_DELTA {
          if ev[0].text_n > 0 {
            now_rx := proc_now_ms();
            if r[0].first_tok_ms == 0 { r[0].first_tok_ms = now_rx; }
            r[0].stream_last_rx_ms = now_rx;
            piece := cast(string) b[0].ev_txt[0..<ev[0].text_n];
            r[0].acc[0].ntext = fww_cat(r[0].acc[0].text[..], r[0].acc[0].ntext, piece);
            fww_send(out, mww_reply(out, piece));
          }
          if sig_n[0] > 0 { r[0].acc[0].nsig = fww_keep(r[0].acc[0].sig[..], cast(string) b[0].sig_buf[0..<sig_n[0]]); }
        } else if k == FLAWED_SSE_SIG_DELTA {
          if sig_n[0] > 0 { r[0].acc[0].nsig = fww_keep(r[0].acc[0].sig[..], cast(string) b[0].sig_buf[0..<sig_n[0]]); }
        } else if k == FLAWED_SSE_OAI_TOOL_DELTA {
          if r[0].acc[0].ntools < FWW_MAX_TOOLS_CALL {
            now_rx := proc_now_ms();
            if r[0].first_tok_ms == 0 { r[0].first_tok_ms = now_rx; }
            r[0].stream_last_rx_ms = now_rx;
            ti := r[0].acc[0].ntools;
            r[0].acc[0].tools[ti] = FwPendingTool.{};
            if ev[0].id_n > 0 {
              r[0].acc[0].tools[ti].nid = fww_keep(r[0].acc[0].tools[ti].id[..], cast(string) ev[0].id_buf[0..<ev[0].id_n]);
            } else {
              idn := fww_cat(r[0].acc[0].tools[ti].id[..], 0, "call_");
              idn = fww_put_int(r[0].acc[0].tools[ti].id[..], idn, r[0].step_num);
              idn = fww_cat(r[0].acc[0].tools[ti].id[..], idn, "_");
              r[0].acc[0].tools[ti].nid = fww_put_int(r[0].acc[0].tools[ti].id[..], idn, ti);
            }
            if ev[0].name_n > 0 { r[0].acc[0].tools[ti].nname = fww_keep(r[0].acc[0].tools[ti].name[..], cast(string) ev[0].name_buf[0..<ev[0].name_n]); }
            if ev[0].text_n > 0 { r[0].acc[0].tools[ti].nargs = fww_keep(r[0].acc[0].tools[ti].args[..], cast(string) b[0].ev_txt[0..<ev[0].text_n]); }
            if sig_n[0] > 0 {
              at := r[0].acc[0].ntool_sig_slab;
              if at + sig_n[0] <= r[0].acc[0].tool_sig_slab.count {
                for si: 0..<sig_n[0] { r[0].acc[0].tool_sig_slab[at + si] = b[0].sig_buf[si]; }
                r[0].acc[0].tools[ti].sig_at = at;
                r[0].acc[0].tools[ti].nsig = sig_n[0];
                r[0].acc[0].ntool_sig_slab = at + sig_n[0];
              }
            }
            r[0].acc[0].ntools += 1;
          }
        } else if k == FLAWED_SSE_ERROR {
          r[0].acc[0].saw_error = true;
          r[0].acc[0].nerr = fww_keep(r[0].acc[0].err_msg[..], cast(string) b[0].ev_txt[0..<ev[0].text_n]);
        }
        if pi + 1 >= nparts { break; }
      }
      continue;
    }

    if !flawed_wire_parse_openai_sse(data, ev[..], b[0].ev_txt[..]) { continue; }
    if ev[0].stop_reason != FLAWED_STOP_NONE { r[0].acc[0].stop_reason = ev[0].stop_reason; }
    if ev[0].input_tokens > 0 { r[0].acc[0].in_tok = ev[0].input_tokens; }
    if ev[0].output_tokens > 0 { r[0].acc[0].out_tok = ev[0].output_tokens; }
    if ev[0].cache_read_tokens > 0 { r[0].acc[0].cache_read = ev[0].cache_read_tokens; }
    k := ev[0].kind;
    if k == FLAWED_SSE_THINK_DELTA {
      if ev[0].text_n > 0 {
        now_rx := proc_now_ms();
        if r[0].first_tok_ms == 0 { r[0].first_tok_ms = now_rx; }
        r[0].stream_last_rx_ms = now_rx;
        piece := cast(string) b[0].ev_txt[0..<ev[0].text_n];
        r[0].acc[0].nthink = fww_cat(r[0].acc[0].think[..], r[0].acc[0].nthink, piece);
        if !cfg[0].thinking_hidden {
          fww_send(out, mww_thought(out, piece));
        }
      }
    } else if k == FLAWED_SSE_TEXT_DELTA {
      if ev[0].text_n > 0 {
        now_rx := proc_now_ms();
        if r[0].first_tok_ms == 0 { r[0].first_tok_ms = now_rx; }
        r[0].stream_last_rx_ms = now_rx;
        piece := cast(string) b[0].ev_txt[0..<ev[0].text_n];
        r[0].acc[0].ntext = fww_cat(r[0].acc[0].text[..], r[0].acc[0].ntext, piece);
        fww_send(out, mww_reply(out, piece));
      }
    } else if k == FLAWED_SSE_OAI_TOOL_DELTA {
      ti := ev[0].block_index;
      if ti >= 0 && ti < FWW_MAX_TOOLS_CALL {
        now_rx := proc_now_ms();
        if r[0].first_tok_ms == 0 { r[0].first_tok_ms = now_rx; }
        r[0].stream_last_rx_ms = now_rx;
        if ti >= r[0].acc[0].ntools {
          for fill: r[0].acc[0].ntools..<ti + 1 { r[0].acc[0].tools[fill] = FwPendingTool.{}; }
          r[0].acc[0].ntools = ti + 1;
        }
        if ev[0].id_n > 0 { r[0].acc[0].tools[ti].nid = fww_keep(r[0].acc[0].tools[ti].id[..], cast(string) ev[0].id_buf[0..<ev[0].id_n]); }
        if ev[0].name_n > 0 { r[0].acc[0].tools[ti].nname = fww_cat(r[0].acc[0].tools[ti].name[..], r[0].acc[0].tools[ti].nname, cast(string) ev[0].name_buf[0..<ev[0].name_n]); }
        if ev[0].text_n > 0 { r[0].acc[0].tools[ti].nargs = fww_cat(r[0].acc[0].tools[ti].args[..], r[0].acc[0].tools[ti].nargs, cast(string) b[0].ev_txt[0..<ev[0].text_n]); }
      }
    } else if k == FLAWED_SSE_ERROR {
      r[0].acc[0].saw_error = true;
      r[0].acc[0].nerr = fww_keep(r[0].acc[0].err_msg[..], cast(string) b[0].ev_txt[0..<ev[0].text_n]);
    } else if k == FLAWED_SSE_MSG_STOP {
      return fww_finish_stream(r, cfg, auth, h, b, st, out);
    }
  }
  // Cloud pure-thinking runaway spiral guard: break out of pathological zero-tool thinking loops
  // while preserving the tail of the model's analysis (folded cleanly into the active user/tool_results turn)
  // and stepping down calm_steps so it emits concrete edits now!
  if fww_think_spiral(r[0].streaming, auth[0].backend == FLAWED_BE_LOCAL, r[0].recoveries, r[0].acc[0].ntext, r[0].acc[0].ntools, r[0].acc[0].nthink, r[0].first_tok_ms, r[0].turn_start_ms, cfg[0].budget_s, proc_now_ms()) {
    gw_close(r[0].gw[..]);
    r[0].streaming = false;
    r[0].recoveries += 1;
    r[0].calm_steps = 2;
    if r[0].recoveries >= 2 { r[0].force_low_once = true; }
    fww_emit_attempt(r, auth, "retried", 499, 0, out);
    if h[0].nmsgs > 0 {
      rb: [4096] u8;
      rn := 0;
      tlen := r[0].acc[0].nthink;
      tfrom := ifx tlen > 2800 then tlen - 2800 else 0;
      rn = fww_cat(rb[..], rn, "<system-reminder>Your internal thinking ran very long without emitting any tool calls. End of your analysis:\n\n");
      rn = fww_cat(rb[..], rn, cast(string) r[0].acc[0].think[tfrom..<tlen]);
      rn = fww_cat(rb[..], rn, "\n\nStop re-deriving from scratch. Immediately emit your concrete Edit/Write/Bash tool calls now and iterate from real test output.</system-reminder>");
      snudge := cast(string) rb[0..<rn];
      li := h[0].nmsgs - 1;
      if h[0].msgs[li].role == FWW_MROLE_TOOL_RESULTS && h[0].msgs[li].nblocks < FWW_MAX_BLOCKS {
        a0 := [1] int.[0];
        nb_sp := FwBlock.{kind = FWW_MB_TEXT};
        nb_sp.text_n = fww_slab_put(h, snudge, a0[..]); nb_sp.text_at = a0[0];
        h[0].msgs[li].blocks[h[0].msgs[li].nblocks] = nb_sp;
        h[0].msgs[li].nblocks += 1;
      } else if h[0].msgs[li].role == FWW_MROLE_USER && h[0].msgs[li].nblocks > 0 {
        prev := fww_slab_str(h, h[0].msgs[li].blocks[0].text_at, h[0].msgs[li].blocks[0].text_n);
        cn := fww_cat(b[0].compact_buf[..], 0, prev);
        cn = fww_cat(b[0].compact_buf[..], cn, "\n\n");
        cn = fww_cat(b[0].compact_buf[..], cn, snudge);
        a0 := [1] int.[0];
        h[0].msgs[li].blocks[0].text_n = fww_slab_put(h, cast(string) b[0].compact_buf[0..<cn], a0[..]);
        h[0].msgs[li].blocks[0].text_at = a0[0];
      }
    }
    err := fww_start_request(r, cfg, auth, h, b, out);
    if err.count > 0 {
      r[0].active = false;
      fww_send(out, mww_ended(out, "failed", err));
      return "failed";
    }
    active_io[0] = true;
    return "";
  }
  // Cloud SSE dead-stream watchdog: recover cleanly only if a stream goes completely silent for >=150s
  // with zero parsed content/thought/tool deltas (never aborts active reasoning or multi-edit batches).
  if fww_stream_stalled(r[0].streaming, auth[0].backend == FLAWED_BE_LOCAL, r[0].stall_recoveries, r[0].stream_last_rx_ms, proc_now_ms()) {
    gw_close(r[0].gw[..]);
    r[0].streaming = false;
    r[0].stall_recoveries += 1;
    fww_emit_attempt(r, auth, "retried", 504, 0, out);
    if h[0].nmsgs > 0 {
      li := h[0].nmsgs - 1;
      snudge := "<system-reminder>Your previous response stalled silently for over 150s without emitting a tool call or reply. Avoid rewriting large unmodified blocks in a single Edit — keep reasoning brief and immediately emit smaller, surgical parallel Edit calls (or your concise final answer).</system-reminder>";
      if h[0].msgs[li].role == FWW_MROLE_TOOL_RESULTS && h[0].msgs[li].nblocks < FWW_MAX_BLOCKS {
        a0 := [1] int.[0];
        nb_st := FwBlock.{kind = FWW_MB_TEXT};
        nb_st.text_n = fww_slab_put(h, snudge, a0[..]); nb_st.text_at = a0[0];
        h[0].msgs[li].blocks[h[0].msgs[li].nblocks] = nb_st;
        h[0].msgs[li].nblocks += 1;
      } else if h[0].msgs[li].role == FWW_MROLE_USER && h[0].msgs[li].nblocks > 0 {
        prev := fww_slab_str(h, h[0].msgs[li].blocks[0].text_at, h[0].msgs[li].blocks[0].text_n);
        cn := fww_cat(b[0].compact_buf[..], 0, prev);
        cn = fww_cat(b[0].compact_buf[..], cn, "\n\n");
        cn = fww_cat(b[0].compact_buf[..], cn, snudge);
        a0 := [1] int.[0];
        h[0].msgs[li].blocks[0].text_n = fww_slab_put(h, cast(string) b[0].compact_buf[0..<cn], a0[..]);
        h[0].msgs[li].blocks[0].text_at = a0[0];
      }
    }
    err := fww_start_request(r, cfg, auth, h, b, out);
    if err.count > 0 {
      r[0].active = false;
      fww_send(out, mww_ended(out, "failed", err));
      return "failed";
    }
    active_io[0] = true;
  }
  return "";
}

fww_stop_active :: (r: [] FwRun, out: [] u8) {
  if r[0].streaming { gw_close(r[0].gw[..]); r[0].streaming = false; }
  if r[0].cmd[0].active {
    _ = proc_kill(r[0].cmd[0].h, PROC_SIGTERM);
    if proc_wait(r[0].cmd[0].h, 400) < 0 { _ = proc_kill(r[0].cmd[0].h, PROC_SIGKILL); _ = proc_wait(r[0].cmd[0].h, 400); }
    _ = proc_release(r[0].cmd[0].h);
    r[0].cmd[0].h = -1;
    r[0].cmd[0].active = false;
  }
  r[0].waiting_permit = false;
  r[0].retry_at_ms = 0;
  r[0].active = false;
  fww_send(out, mww_ended(out, "stopped", ""));
}

// Handle inline slash commands (/compact, /clear, /cost, /status). Returns true if handled locally.
fww_handle_slash :: (tk: string, r: [] FwRun, cfg: [] FwConfig, auth: [] FwAuth, h: [] FwHist, b: [] FwBufs, out: [] u8) -> bool {
  cmd := fww_trim(tk);
  if cmd == "/clear" {
    fww_hist_clear(h);
    for di: 0..<r[0].read_dedup.count { r[0].read_dedup[di] = FwReadDedup.{}; }
    r[0].ngit_snap = 0; r[0].ngit_snap_cwd = 0;
    fww_send(out, mww_ended(out, "finished", "Cleared Flawed conversation history."));
    return true;
  }
  if cmd == "/compact" {
    if fww_hist_compact(h, b[0].compact_buf[..]) {
      fww_send(out, mww_ended(out, "finished", "Compacted conversation history."));
    } else {
      fww_send(out, mww_ended(out, "finished", "Conversation is already compact (fewer than 5 messages)."));
    }
    return true;
  }
  if cmd == "/cost" {
    rb: [512] u8;
    n := fww_cat(rb[..], 0, "**Flawed Session Usage**\n- Input tokens: ");
    n = fww_put_int(rb[..], n, h[0].total_in);
    n = fww_cat(rb[..], n, "\n- Cached input tokens: ");
    n = fww_put_int(rb[..], n, h[0].total_cached);
    n = fww_cat(rb[..], n, "\n- Output tokens: ");
    n = fww_put_int(rb[..], n, h[0].total_out);
    n = fww_cat(rb[..], n, "\n- Estimated cost: $");
    cents := (h[0].total_cost_micros + 5000) / 10000;
    n = fww_put_int(rb[..], n, cents / 100);
    n = fww_cat(rb[..], n, ".");
    if cents % 100 < 10 { n = fww_cat(rb[..], n, "0"); }
    n = fww_put_int(rb[..], n, cents % 100);
    fww_send(out, mww_ended(out, "finished", cast(string) rb[0..<n]));
    return true;
  }
  if cmd == "/status" {
    rb: [1024] u8;
    n := fww_cat(rb[..], 0, "**Flawed Runtime Status**\n- Model: `");
    n = fww_cat(rb[..], n, cast(string) r[0].model[0..<r[0].nmodel]);
    n = fww_cat(rb[..], n, "`\n- Effort: `");
    n = fww_cat(rb[..], n, cast(string) r[0].effort[0..<r[0].neffort]);
    n = fww_cat(rb[..], n, "`\n- Auth: ");
    n = fww_cat(rb[..], n, cast(string) auth[0].label[0..<auth[0].nlabel]);
    n = fww_cat(rb[..], n, "\n- Messages in context: ");
    n = fww_put_int(rb[..], n, h[0].nmsgs);
    n = fww_cat(rb[..], n, "\n- Auto-compactions this session: ");
    n = fww_put_int(rb[..], n, h[0].compact_count);
    fww_send(out, mww_ended(out, "finished", cast(string) rb[0..<n]));
    return true;
  }
  return false;
}

// ---------------------------------------------------------------- follow-up / queue / steer helpers

fww_src_name :: (src: int) -> string {
  if src == FWW_SRC_QUEUE { return "queue"; }
  if src == FWW_SRC_RESUBMIT { return "resubmit"; }
  return "message";
}

fww_queue_changed :: (q: [] MwQueue, f: [] FwFollow, o: [] u8) {
  _ = mwq_save(q, f[0].qbuf[..]);
  fww_send(o, mwq_line(q, o));
}

fww_task_with :: (f: [] FwFollow, text: string, out: [] u8) -> string {
  if f[0].nlast == 0 { return ""; }
  ab: [MWQ_MESSAGE] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  t: [1] McTask;
  last := cast(string) f[0].last[0..<f[0].nlast];
  if !mww_task_read(ar[..], last, t[..]) {
    t[0] = McTask.{cwd = cl_str(ar[..], last, "cwd"), session = cl_str(ar[..], last, "session"), sandbox = "danger-full-access"};
  }
  t[0].task = text;
  n := mww_task(out, t[0]);
  return ifx n < 2 then "" else cast(string) out[0..<n - 1];
}

fww_turn_begin :: (f: [] FwFollow, msg: string, o: [] u8) {
  f[0].turn += 1;
  fww_send(o, mww_turn(o, f[0].turn, fww_src_name(f[0].src), cast(string) f[0].src_id[0..<f[0].nsrc_id], cast(string) f[0].src_text[0..<f[0].nsrc_text]));
  f[0].nlast = ifx msg.count <= f[0].last.count then fww_keep(f[0].last[..], msg) else 0;
  st := cl_bool(msg, "steerable");
  f[0].steerable = !st.ok || st.value;
  f[0].starting = true;
  f[0].src = FWW_SRC_MESSAGE; f[0].nsrc_id = 0; f[0].nsrc_text = 0;
}

fww_drained :: (st: [] McSteers, f: [] FwFollow, o: [] u8) {
  for i: 0..<st[0].nd {
    fww_send(o, mww_steered(o, mc_steer_done_id(st, i), "applied", f[0].turn, "", st[0].done[i].step, ""));
  }
  st[0].nd = 0;
}

fww_turn_end :: (ending: string, st: [] McSteers, q: [] MwQueue, f: [] FwFollow, o: [] u8) {
  f[0].starting = false;
  mwq_ended(q);
  if st[0].n > 0 && f[0].resubmit_due {
    jb: [MWQ_MESSAGE] u8; text := mc_steer_join(st, jb[..]);
    m := fww_task_with(f, text, f[0].resubmit[..]);
    f[0].nresubmit = m.count;
    if m.count > 0 {
      f[0].nsrc_id = fww_keep(f[0].src_id[..], mc_steer_id(st, 0));
      f[0].nsrc_text = fww_keep(f[0].src_text[..], text);
      for i: 0..<st[0].n { fww_send(o, mww_steered(o, mc_steer_id(st, i), "resubmitted", f[0].turn, "", 0, "")); }
      mc_steer_clear(st);
    }
  }
  i := st[0].n - 1;
  while i >= 0 {
    mb: [MWQ_MESSAGE] u8; m := fww_task_with(f, mc_steer_text(st, i), mb[..]);
    why := ifx m.count > 0 then mwq_add_first(q, mc_steer_id(st, i), mc_steer_text(st, i), m) else "invalid";
    fww_send(o, mww_steered(o, mc_steer_id(st, i), ifx why.count == 0 then "queued" else "rejected", f[0].turn, why, 0, ""));
    i -= 1;
  }
  mc_steer_clear(st);
  f[0].resubmit_due = false;
  if ending == "stopped" && f[0].nresubmit == 0 && !f[0].force_head { mwq_pause(q, "interrupted"); }
  else if ending == "failed" || ending == "no_capacity" { mwq_pause(q, "error"); }
  fww_queue_changed(q, f, o);
}

fww_dispatch :: (q: [] MwQueue, f: [] FwFollow, line: [] u8, o: [] u8) -> int {
  if f[0].nresubmit > 0 {
    n := fww_keep(line, cast(string) f[0].resubmit[0..<f[0].nresubmit]);
    f[0].nresubmit = 0; f[0].src = FWW_SRC_RESUBMIT;
    return n;
  }
  if q[0].n == 0 || (q[0].paused && !f[0].force_head) { return 0; }
  n := fww_keep(line, mwq_message(q, 0));
  f[0].src = FWW_SRC_QUEUE;
  f[0].nsrc_id = fww_keep(f[0].src_id[..], mwq_id(q, 0));
  f[0].nsrc_text = fww_keep(f[0].src_text[..], mwq_text(q, 0));
  f[0].force_head = false;
  _ = mwq_start_head(q);
  fww_queue_changed(q, f, o);
  return n;
}

fww_steer :: (running: bool, req: [] MwwRequest, st: [] McSteers, f: [] FwFollow, o: [] u8) {
  why := "";
  if !running || f[0].starting { why = "no_active_turn"; }
  else if req[0].turn.ok && req[0].turn.value != f[0].turn { why = "expected_turn_mismatch"; }
  else if !f[0].steerable && !req[0].parent { why = "active_turn_not_steerable"; }
  else { why = mc_steer_add(st, req[0].id, req[0].text); }
  fww_send(o, mww_steered(o, req[0].id, ifx why.count == 0 then "accepted" else "rejected", f[0].turn, why, 0, ifx why.count == 0 then req[0].text else ""));
}

fww_queue_op :: (running: bool, req: [] MwwRequest, q: [] MwQueue, f: [] FwFollow, home: string, o: [] u8) -> bool {
  op := req[0].op; id := req[0].id; why := "";
  stop := false;
  if op == "open" {
    pb: [4096] u8; path := mwq_path(home, req[0].key, pb[..]);
    if path.count == 0 { why = "invalid"; }
    else if cast(string) q[0].path[0..<q[0].npath] != path {
      _ = mwq_save(q, f[0].qbuf[..]);
      if q[0].npath == 0 && q[0].n > 0 { q[0].npath = fww_keep(q[0].path[..], path); }
      else { _ = mwq_load(q, path, f[0].qbuf[..], f[0].qarena[..]); }
    }
  }
  else if op == "add" { why = mwq_add(q, id, req[0].text, req[0].message); }
  else if op == "update" { why = mwq_update(q, id, req[0].text, req[0].message); }
  else if op == "delete" { why = mwq_delete(q, id); }
  else if op == "move" { why = mwq_move(q, id, ifx req[0].to.ok then req[0].to.value else 0); }
  else if op == "promote" {
    why = mwq_move(q, id, 0);
    if why.count == 0 && req[0].now { f[0].force_head = true; stop = running; }
  }
  else if op == "pause" { mwq_pause(q, "user"); }
  else if op == "resume" { mwq_resume(q); }
  else if op == "clear" { mwq_clear(q); }
  else if op != "list" { why = "invalid"; }
  if why.count > 0 { fww_send(o, mww_queue_refused(o, op, id, why)); return false; }
  fww_queue_changed(q, f, o);
  return stop;
}

fww_flag_asked :: (flag: string) -> bool {
  a: [1] Args;
  if !args_load(a[..]) { return false; }
  for i: 0..<args_count(a[..]) { if args_at(a[..], i) == flag { return true; } }
  return false;
}

fww_auth_asked :: () -> bool {
  return fww_flag_asked("--auth");
}

#load "oa-serve.coax";

// ---------------------------------------------------------------- main event loop

tool_main :: () -> int #export_c #effects(all) {
  if fww_flag_asked("--selftest-coax-intel") {
    cwd_b: [FS_PATH_MAX] u8;
    cwd := fs_cwd(cwd_b[..]);
    if !fww_is_coax_repo(cwd) {
      print("FAIL: not a Coax repo: %\n", cwd);
      return 1;
    }
    res_b: [32768] u8;
    empty_wire: [1] u8;
    is_err := [1] bool.[false];

    n1 := fww_tool_coax_intel(cwd, "CoaxDefines", "{\"name\":\"rp_put\"}", res_b[..], is_err[..], empty_wire[0..<0]);
    if is_err[0] || !fww_contains_ci(cast(string) res_b[0..<n1], "coax/lib/repo/lines.coax") {
      print("FAIL: CoaxDefines rp_put: %\n", cast(string) res_b[0..<n1]);
      return 1;
    }
    print("OK CoaxDefines rp_put (% bytes)\n", n1);

    n2 := fww_tool_coax_intel(cwd, "CoaxUses", "{\"name\":\"rp_put\",\"file\":\"coax/lib/repo/lines.coax\"}", res_b[..], is_err[..], empty_wire[0..<0]);
    if is_err[0] || !fww_contains_ci(cast(string) res_b[0..<n2], "coax/lib/repo/lines.coax") {
      print("FAIL: CoaxUses rp_put: %\n", cast(string) res_b[0..<n2]);
      return 1;
    }
    print("OK CoaxUses rp_put (% bytes)\n", n2);

    n3 := fww_tool_coax_intel(cwd, "CoaxCheck", "{\"file\":\"coax/lib/repo/lines.coax\"}", res_b[..], is_err[..], empty_wire[0..<0]);
    if is_err[0] || n3 <= 0 {
      print("FAIL: CoaxCheck lines.coax: %\n", cast(string) res_b[0..<n3]);
      return 1;
    }
    print("OK CoaxCheck coax/lib/repo/lines.coax (% bytes)\n", n3);
    return 0;
  }

  homebuf: [4096] u8;
  home := cl_getenv("CODER_HOME", homebuf[..]);
  if home.count == 0 { home = cl_getenv("HOME", homebuf[..]); }

  cfg: [1] FwConfig;
  auth: [1] FwAuth;
  fww_load_config(cfg[..]);

  sopts: [1] FwServeOpts;
  if fws_parse_serve_args(sopts[..]) {
    return fws_serve_main(sopts[..], cfg[..], auth[..], home);
  }

  fww_resolve_auth(cfg[..], home, cast(string) cfg[0].model[0..<cfg[0].nmodel], auth[..], true);

  if fww_auth_asked() {
    ob: [512] u8;
    jo: [1] Jo;
    jo_start(jo[..], ob[..]);
    jo_obj(jo[..]);
    jo_key(jo[..], "source"); jo_str(jo[..], cast(string) auth[0].source[0..<auth[0].nsource]);
    jo_key(jo[..], "ready"); jo_bool(jo[..], auth[0].ok);
    jo_key(jo[..], "label"); jo_str(jo[..], cast(string) auth[0].label[0..<auth[0].nlabel]);
    jo_end(jo[..]);
    fww_send(ob[..], jo[0].n);
    return 0;
  }

  run: [1] FwRun;
  hist: [1] FwHist;
  bufs: [1] FwBufs;
  line: [FWW_LINE] u8; nl := 0;
  out: [FWW_LINE] u8;
  ab: [65536] u8; ar := [1] ClArena.[ClArena.{buf = ab[..]}];
  task_buf: [32768] u8; cwd_buf: [4096] u8;
  req: [1] MwwRequest;
  st: [1] McSteers; q: [1] MwQueue; f: [1] FwFollow;

  fww_send(out[..], mww_ready(out[..]));

  while true {
    ended := "";
    polled := [1] bool.[false];
    if run[0].active {
      ended = fww_poll_step(run[..], cfg[..], auth[..], hist[..], bufs[..], st[..], out[..], polled[..]);
      fww_drained(st[..], f[..], out[..]);
    }
    if !run[0].active && f[0].starting && ended.count == 0 { ended = "failed"; }
    if ended.count > 0 { fww_turn_end(ended, st[..], q[..], f[..], out[..]); }

    fed := false;
    if !run[0].active && nl == 0 { nl = fww_dispatch(q[..], f[..], line[..], out[..]); fed = nl > 0; }
    if !fed {
      ch := cxterm_byte(fww_poll_wait_ms(run[0].active, polled[0]));
      if ch == -2 { break; }
      got_line := false;
      while ch >= 0 {
        if ch == 10 { got_line = true; break; }
        if nl < line.count { line[nl] = cast,trunc(u8) ch; nl += 1; }
        ch = cxterm_byte(0);
      }
      if ch == -2 && !got_line { break; }
      if !got_line { continue; }
    }
    msg := cast(string) line[0..<nl];
    nl = 0;
    ar[0].at = 0; ar[0].full = false;
    what := mww_request(ar[..], msg, req[..]);

    if what == MWW_STEER { fww_steer(run[0].active, req[..], st[..], f[..], out[..]); continue; }
    if what == MWW_QUEUE {
      if !fww_queue_op(run[0].active, req[..], q[..], f[..], home, out[..]) { continue; }
      what = MWW_STOP;
    }
    if what == MWW_INTERRUPT {
      if !run[0].active { continue; }
      f[0].resubmit_due = req[0].resubmit;
      what = MWW_STOP;
    }
    if what == MWW_STOP {
      if run[0].active {
        fww_stop_active(run[..], out[..]);
        fww_turn_end("stopped", st[..], q[..], f[..], out[..]);
      }
      continue;
    }
    if what == MWW_FORGET {
      if !run[0].active {
        fww_hist_clear(hist[..]);
        for di: 0..<run[0].read_dedup.count { run[0].read_dedup[di] = FwReadDedup.{}; }
        run[0].ngit_snap = 0; run[0].ngit_snap_cwd = 0;
        run[0].session_allow = false;
      }
      continue;
    }
    if what == MWW_RECALL {
      if !run[0].active { fww_hist_recall(hist[..], req[0].recall); }
      continue;
    }
    if what == MWW_EMBED {
      fww_send(out[..], mww_embedding_error(out[..], "embeddings are not served by flawedworker"));
      continue;
    }
    if what == MWW_ANSWER {
      if run[0].active && run[0].waiting_permit {
        tk_ok := !req[0].ticket.ok || req[0].ticket.value == run[0].permit_ticket;
        if tk_ok {
          run[0].waiting_permit = false;
          ti := run[0].permit_tool_idx;
          if req[0].allow {
            tnm := cast(string) run[0].acc[0].tools[ti].name[0..<run[0].acc[0].tools[ti].nname];
            tar := cast(string) run[0].acc[0].tools[ti].args[0..<run[0].acc[0].tools[ti].nargs];
            ttb: [512] u8;
            ttgt := fww_tool_target(tnm, tar, ttb[..]);
            if req[0].option == "allow_session" && !oa_member_is_bypass_immune(tnm, ttgt) { run[0].session_allow = true; }
            run[0].next_tool_idx = ti + 1;
            if !fww_exec_tool_now(run[..], cfg[..], auth[..], hist[..], bufs[..], ti, out[..]) {
              e := fww_advance_tools(run[..], cfg[..], auth[..], hist[..], bufs[..], st[..], out[..]);
              if e.count > 0 { fww_turn_end(e, st[..], q[..], f[..], out[..]); }
            }
          } else {
            run[0].acc[0].tools[ti].done = true;
            run[0].acc[0].tools[ti].is_error = true;
            why := ifx req[0].why.count > 0 then req[0].why else "User denied tool permission.";
            run[0].acc[0].tools[ti].nres = fww_keep(run[0].acc[0].tools[ti].res[..], why);
            run[0].next_tool_idx = ti + 1;
            e := fww_advance_tools(run[..], cfg[..], auth[..], hist[..], bufs[..], st[..], out[..]);
            if e.count > 0 { fww_turn_end(e, st[..], q[..], f[..], out[..]); }
          }
        }
      }
      continue;
    }
    if what != MWW_TASK || run[0].active { continue; }

    fww_turn_begin(f[..], msg, out[..]);
    mw_task := req[0].task;
    mw_cwd := req[0].cwd;
    if mw_task.count > task_buf.count || mw_cwd.count == 0 || mw_cwd.count > cwd_buf.count {
      fww_send(out[..], mww_ended(out[..], "failed", "Task or workspace exceeds worker bounds."));
      fww_turn_end("failed", st[..], q[..], f[..], out[..]);
      continue;
    }
    tn := fww_keep(task_buf[..], mw_task);
    cn := fww_keep(cwd_buf[..], mw_cwd);
    tk := cast(string) task_buf[0..<tn];
    cd := cast(string) cwd_buf[0..<cn];

    // Refresh config & model-aware auth cleanly per turn so switching Inkling <-> Neon works seamlessly.
    fww_load_config(cfg[..]);

    // Model selection: custom override > task's requested model > config default
    req_model := ifx req[0].model.count > 0 then req[0].model else cl_str(ar[..], msg, "model");
    picked_model := ifx cfg[0].ncustom_model > 0 then cast(string) cfg[0].custom_model[0..<cfg[0].ncustom_model]
                    else ifx req_model.count > 0 then req_model
                    else cast(string) cfg[0].model[0..<cfg[0].nmodel];
    picked_effort := ifx req[0].effort.count > 0 then req[0].effort else cast(string) cfg[0].effort[0..<cfg[0].neffort];

    // System One Front v2alpha1 routing in Auto mode (#14056)
    run[0].nmissing_cap_hint = 0;
    if (picked_model == "oa:auto" || picked_model == "auto") && cfg[0].ncustom_model == 0 && !(tk.count > 0 && tk[0] == '/') {
      lbase_b: [512] u8;
      lbase := fww_trim(cl_getenv("PSIONIC_BASE_URL", lbase_b[..]));
      local_ready := fww_local_reachable(lbase);
      probe_auth: [1] FwAuth;
      fww_resolve_auth(cfg[..], home, "oa:cloud", probe_auth[..], true);
      cloud_ready := probe_auth[0].ok && probe_auth[0].backend != FLAWED_BE_LOCAL;
      door_b: [64] u8;
      door_pref := fww_trim(cl_getenv("OA_AGENT_ROUTER_DOOR", door_b[..]));
      plan: [1] Rtr2Plan;
      ap := cast(string) run[0].active_pack[0..<run[0].nactive_pack];
      at := cast(string) run[0].active_tier[0..<run[0].nactive_tier];
      fww_route_auto_plan(tk, "", ap, at, local_ready, cloud_ready, door_pref, plan[..]);
      if plan[0].ok {
        if plan[0].npacks > 0 { run[0].nactive_pack = fww_keep(run[0].active_pack[..], plan[0].capability_packs[0]); }
        run[0].nactive_tier = fww_keep(run[0].active_tier[..], plan[0].compute_tier);
        if plan[0].missing_capability_hint.count > 0 {
          run[0].nmissing_cap_hint = fww_keep(run[0].missing_cap_hint[..], plan[0].missing_capability_hint);
        }
        if plan[0].compute_tier == "local_inkling" && local_ready {
          picked_model = "oa:local";
        } else if cloud_ready {
          picked_model = "oa:cloud";
          if req[0].effort.count == 0 && plan[0].effort.count > 0 { picked_effort = plan[0].effort; }
        }
      }
    }

    fww_resolve_auth(cfg[..], home, picked_model, auth[..], false);

    run[0].ncwd = fww_keep(run[0].cwd[..], cd);
    run[0].nmodel = fww_keep(run[0].model[..], picked_model);
    run[0].neffort = fww_keep(run[0].effort[..], picked_effort);
    run[0].step_num = 1;
    run[0].turn_cost_micros = 0;
    run[0].retry[0] = FlawedRetryState.{max_retries = 3};
    run[0].retry_at_ms = 0;
    run[0].waiting_permit = false;
    run[0].recoveries = 0;
    run[0].ctx_recoveries = 0;
    run[0].stall_recoveries = 0;
    run[0].stream_last_rx_ms = 0;
    run[0].force_wrapup_once = false;
    run[0].force_no_think_once = false;
    run[0].soft_deadline_ms = 0;
    run[0].last_tool_hash = 0;
    run[0].dup_tool_streak = 0;
    run[0].read_only_steps = 0;
    run[0].post_edit_steps = 0;
    run[0].turn_tool_bytes = 0;
    run[0].turn_start_ms = proc_now_ms();
    run[0].last_req_dur_ms = 0;
    run[0].nudge_stage = 0;
    run[0].long_think_nudges = 0;
    run[0].has_edited = false;
    run[0].last_bash_ok = false;
    run[0].last_step_had_err = false;
    run[0].audit_nudged = false;
    run[0].audit_done = false;
    run[0].finish_nudged = false;
    run[0].time_warn_stage = 0;
    run[0].calm_steps = 0;
    run[0].force_low_once = false;
    for qi: 0..<run[0].query_dedup.count { run[0].query_dedup[qi] = 0; }

    // Handle local slash commands instantaneously
    if fww_handle_slash(tk, run[..], cfg[..], auth[..], hist[..], bufs[..], out[..]) {
      fww_turn_end("finished", st[..], q[..], f[..], out[..]);
      continue;
    }

    if !auth[0].ok {
      fww_send(out[..], mww_ended(out[..], "failed", cast(string) auth[0].label[0..<auth[0].nlabel]));
      fww_turn_end("failed", st[..], q[..], f[..], out[..]);
      continue;
    }

    if hist[0].nmsgs >= FWW_MAX_MSGS - 4 || hist[0].nslab + tk.count + 8192 >= FWW_SLAB {
      _ = fww_hist_compact(hist[..], bufs[0].compact_buf[..]);
    }
    if hist[0].nmsgs >= FWW_MAX_MSGS - 4 || hist[0].nslab + tk.count + 8192 >= FWW_SLAB {
      _ = fww_emergency_compact(hist[..], 3, 0, bufs[0].compact_buf[..]);
    }
    fww_hist_push_user(hist[..], tk);
    fww_hist_sanitize(hist[..], bufs[0].compact_buf[..]);
    mc_steer_clear(st[..]); st[0].nd = 0;

    // Non-coding turns skip git-snapshot capture and full coding prompt assembly (#14054).
    if fww_is_coding_turn(cfg[..], hist[..]) {
      run[0].nsys = fww_build_system_prompt(cfg[..], cd, home, run[0].sys_prompt[..]);
      if !cfg[0].bare_mode {
        if run[0].ngit_snap_cwd != cd.count || cast(string) run[0].git_snap_cwd[0..<run[0].ngit_snap_cwd] != cd {
          run[0].ngit_snap = fww_capture_git_snapshot(cd, run[0].git_snap[..]);
          run[0].ngit_snap_cwd = fww_keep(run[0].git_snap_cwd[..], cd);
        }
        if run[0].ngit_snap > 0 {
          run[0].nsys = fww_cat(run[0].sys_prompt[..], run[0].nsys, cast(string) run[0].git_snap[0..<run[0].ngit_snap]);
        }
      }
    } else {
      run[0].nsys = fww_build_base_system_prompt(cfg[..], run[0].sys_prompt[..]);
    }
    if run[0].nmissing_cap_hint > 0 {
      run[0].nsys = fww_cat(run[0].sys_prompt[..], run[0].nsys, "\n\n[Missing Capability Detected: ");
      run[0].nsys = fww_cat(run[0].sys_prompt[..], run[0].nsys, cast(string) run[0].missing_cap_hint[0..<run[0].nmissing_cap_hint]);
      run[0].nsys = fww_cat(run[0].sys_prompt[..], run[0].nsys, "] This request needs an integration not currently mounted. Offer to author a new OpenAgents capability/skill with the user.\n");
    }
    if auth[0].backend != FLAWED_BE_LOCAL && cfg[0].auto_compact && hist[0].nmsgs >= 6 {
      est_tok := fww_estimate_prompt_tokens(hist[..], run[0].nsys, false, !fww_is_coding_turn(cfg[..], hist[..]));
      if cp_cache_status(hist[0].last_cloud_turn_ms, proc_now_ms(), 0, hist[0].last_cached_tok, est_tok, true) == CP_CACHE_EXPIRED_COMPACT {
        _ = fww_hist_compact_ex(hist[..], 0, 2, 512, 0, 0, bufs[0].compact_buf[..]);
      }
    }

    err := fww_start_request(run[..], cfg[..], auth[..], hist[..], bufs[..], out[..]);
    if err.count > 0 {
      fww_send(out[..], mww_ended(out[..], "failed", err));
      fww_turn_end("failed", st[..], q[..], f[..], out[..]);
      continue;
    }
    run[0].active = true;
    f[0].starting = false;
  }

  if run[0].active { fww_stop_active(run[..], out[..]); }
  return 0;
}

#test "flawedworker: poll wait drains streaming tokens at 0ms and SSRF guard blocks private URLs" {
  #assert fww_poll_wait_ms(false, false) == 200;
  #assert fww_poll_wait_ms(true, false) == 10;
  #assert fww_poll_wait_ms(true, true) == 0;
  #assert fww_url_safe("https://openagents.com/docs") && !fww_url_safe("http://127.0.0.1:8080/x");
  #assert !fww_url_safe("http://169.254.169.254/latest/meta-data") && !fww_url_safe("file:///etc/passwd");
}

#test "flawedworker: default config is Allow All (no permission checks) and local uncensored bodies format cleanly" {
  #assert fww_parse_permission_mode("") == FLAWED_PMODE_BYPASS && fww_parse_permission_mode("allow_all") == FLAWED_PMODE_BYPASS;
  #assert fww_parse_permission_mode("ask") == FLAWED_PMODE_DEFAULT && fww_parse_permission_mode("accept_edits") == FLAWED_PMODE_ACCEPT_EDITS;
  #assert fww_parse_permission_mode("plan") == FLAWED_PMODE_PLAN && fww_parse_permission_mode("dont_ask") == FLAWED_PMODE_DONT_ASK;
  #assert fww_local_variant_short("inkling-2-mini-uncensored-lora") == "Uncensored LoRA";
  #assert fww_local_variant_short("inkling-2-mini-uncensored-maple") == "Uncensored (Maple)";
  #assert fww_local_variant_short("inkling-2-mini-uncensored-q4k") == "Uncensored AD-Q4_K";
  #assert fww_local_variant_short("inkling-2-mini-uncensored-iq3s") == "Uncensored AD-IQ3_S";
  #assert fww_local_variant_short("inkling-2-mini-uncensored-iq2m") == "Uncensored AD-IQ2_M";
  #assert fww_local_variant_short("inkling-2-mini-abliterated-mix16g") == "Abliterated Mix-16G";
  #assert fww_local_variant_short("inkling-2-mini-abliterated-mix12g") == "Abliterated Mix-12G";
  #assert fww_local_variant_short("inkling-2-mini-custom") == "Custom Local .gguf";
  #assert fww_local_variant_short("inkling-2-mini") == "Official IQ4_NL";
  #assert fww_local_variant_short("other-id") == "other-id";

  cfg: [1] FwConfig;
  h: [1] FwHist;
  fww_hist_push_user(h[..], "hi");
  body: [16384] u8;
  n1 := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini-uncensored-lora", "xhigh", "sys", true, 8192, false, false, body[..]);
  s1 := cast(string) body[0..<n1];
  nodes: [512] JvNode; d: [1] Jv; eb: [64] u8;
  #assert n1 > 0 && jv_parse(d[..], s1, nodes[..]);
  #assert jv_int(d[0], jv_get(d[0], 0, "max_tokens"), 0) == 4096;
  #assert jv_raw(d[0], jv_get(d[0], 0, "temperature")) == "0.6" && jv_int(d[0], jv_get(d[0], 0, "top_k"), 0) == 40;
  en1 := jv_str(d[0], jv_get(d[0], 0, "reasoning_effort"), eb[..]);
  #assert cast(string) eb[0..<en1] == "xhigh";
  #assert jv_kind(d[0], jv_get(d[0], 0, "tools")) == JV_ARRAY;

  cfg[0].thinking_mode = FLAWED_THINK_OFF;
  n2 := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini-uncensored-q4k", "high", "sys", true, 32768, true, false, body[..]);
  s2 := cast(string) body[0..<n2];
  #assert n2 > 0 && jv_parse(d[..], s2, nodes[..]);
  #assert !jv_bool(d[0], jv_get(d[0], 0, "enable_thinking")) && jv_raw(d[0], jv_get(d[0], 0, "enable_thinking")) == "false";
  en2 := jv_str(d[0], jv_get(d[0], 0, "reasoning_effort"), eb[..]);
  #assert cast(string) eb[0..<en2] == "none";
  #assert jv_get(d[0], 0, "tools") < 0;

  // Verify H1/H2/H3/H7 harness primitives: local_max_tokens, force_no_think, Gemini NONE wrap-up, tool loop hash
  cfg[0].thinking_mode = FLAWED_THINK_ADAPTIVE;
  cfg[0].local_max_tokens = 6144;
  n3 := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini-uncensored-lora", "low", "sys", true, 32768, false, false, body[..]);
  #assert n3 > 0 && jv_parse(d[..], cast(string) body[0..<n3], nodes[..]);
  #assert jv_int(d[0], jv_get(d[0], 0, "max_tokens"), 0) == 6144;

  n4 := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini-uncensored-lora", "low", "sys", true, 32768, true, true, body[..]);
  #assert n4 > 0 && jv_parse(d[..], cast(string) body[0..<n4], nodes[..]);
  #assert jv_raw(d[0], jv_get(d[0], 0, "enable_thinking")) == "false" && jv_get(d[0], 0, "tools") < 0;

  // Non-coding Gemini turn (no prior tool history) omits tools + toolConfig completely;
  // wrap-up turn with prior tool history keeps tools + toolConfig NONE so Gemini accepts functionResponse history.
  ng0 := fww_build_gemini_body(cfg[..], h[..], "low", "sys", true, body[..]);
  #assert ng0 > 0 && jv_parse(d[..], cast(string) body[0..<ng0], nodes[..]);
  #assert jv_get(d[0], 0, "tools") < 0 && jv_get(d[0], 0, "toolConfig") < 0;

  hw: [1] FwHist;
  fww_hist_push_user(hw[..], "check repo");
  a0 := [1] int.[0];
  hw[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  ub := FwBlock.{kind = FWW_MB_TOOL_USE};
  ub.id_n = fww_slab_put(hw[..], "c1", a0[..]); ub.id_at = a0[0];
  ub.name_n = fww_slab_put(hw[..], "Read", a0[..]); ub.name_at = a0[0];
  ub.text_n = fww_slab_put(hw[..], "{}", a0[..]); ub.text_at = a0[0];
  hw[0].msgs[1].blocks[0] = ub;
  hw[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
  rb := FwBlock.{kind = FWW_MB_TOOL_RES};
  rb.id_n = fww_slab_put(hw[..], "c1", a0[..]); rb.id_at = a0[0];
  rb.name_n = fww_slab_put(hw[..], "Read", a0[..]); rb.name_at = a0[0];
  rb.text_n = fww_slab_put(hw[..], "ok", a0[..]); rb.text_at = a0[0];
  hw[0].msgs[2].blocks[0] = rb;
  hw[0].nmsgs = 3;
  ng := fww_build_gemini_body(cfg[..], hw[..], "low", "sys", true, body[..]);
  #assert ng > 0 && jv_parse(d[..], cast(string) body[0..<ng], nodes[..]);
  #assert jv_kind(d[0], jv_get(d[0], 0, "toolConfig")) == JV_OBJECT;
  #assert fww_tool_sig_hash("Bash", "{\"command\":\"python3 a.py\"}") == fww_tool_sig_hash("Bash", "{\"command\":\"python3 a.py\"}");
  #assert fww_tool_sig_hash("Bash", "{\"command\":\"python3 a.py\"}") != fww_tool_sig_hash("Bash", "{\"command\":\"python3 b.py\"}");
}

#test "flawedworker: multi-layer compaction handles 17-command intra-turn 32K overflow, huge pastes, and HTTP 400 recovery" #steps 200000000 {
  // 1. UTF-8 safe head/tail truncation and overflow error detection + limit parsing
  #assert fww_utf8_cut("hello", 0) == 0 && fww_utf8_cut("hello", 10) == 5 && fww_utf8_cut("aéb", 2) == 1;
  #assert fww_utf8_tail_start("aéb", 2) == 3 && fww_utf8_tail_start("hello", 10) == 0;
  #assert fww_is_context_overflow_err("This model's maximum context length is 32768 tokens. However, your messages exceeded the context length.");
  #assert fww_is_context_overflow_err("prompt is too long: 41000 tokens > 32768 maximum") && fww_is_context_overflow_err("context_length_exceeded");
  #assert !fww_is_context_overflow_err("Authentication failed (HTTP 401)") && !fww_is_context_overflow_err("");
  #assert fww_parse_ctx_limit_from_err("This model's maximum context length is 32768 tokens. However, your messages exceeded the context length.") == 32768;
  #assert fww_parse_ctx_limit_from_err("Maximum context length is 8192 tokens") == 8192;
  #assert fww_parse_ctx_limit_from_err("generic error") == 0;

  // 2. Reproduce exact 17-command single-user-turn 32K local overflow scenario (>180 KB tool outputs in Turn 2)
  h: [1] FwHist;
  tmp: [524288] u8;
  fww_hist_push_user(h[..], "Look through ~/Desktop/GTA and summarize the project.");
  fww_hist_push_assistant_text(h[..], "Summary: reverse-engineered GTA VI mocap + WebGPU scenes.");
  fww_hist_push_user(h[..], "Create a new document specking out their mocap system and how to author animations.");

  big_chunk: [10240] u8;
  for i: 0..<big_chunk.count { big_chunk[i] = cast(u8) ('a' + (i % 26)); }
  big_s := cast(string) big_chunk[..];

  for step: 0..<17 {
    // Assistant tool_use
    am := h[0].nmsgs;
    h[0].msgs[am] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
    a0 := [1] int.[0];
    ub := FwBlock.{kind = FWW_MB_TOOL_USE};
    ub.id_n = fww_slab_put(h[..], "call_1", a0[..]); ub.id_at = a0[0];
    ub.name_n = fww_slab_put(h[..], "Read", a0[..]); ub.name_at = a0[0];
    ub.text_n = fww_slab_put(h[..], "{\"file_path\":\"mocap.c\"}", a0[..]); ub.text_at = a0[0];
    h[0].msgs[am].blocks[0] = ub;
    h[0].nmsgs += 1;
    // Tool result (10 KB each -> 170 KB = ~57K tokens > 32768!)
    tm := h[0].nmsgs;
    h[0].msgs[tm] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
    rb := FwBlock.{kind = FWW_MB_TOOL_RES};
    rb.id_n = fww_slab_put(h[..], "call_1", a0[..]); rb.id_at = a0[0];
    rb.name_n = fww_slab_put(h[..], "Read", a0[..]); rb.name_at = a0[0];
    rb.text_n = fww_slab_put(h[..], big_s, a0[..]); rb.text_at = a0[0];
    h[0].msgs[tm].blocks[0] = rb;
    h[0].nmsgs += 1;
  }
  #assert h[0].nmsgs == 37;
  #assert fww_estimate_prompt_tokens(h[..], 4000, true, false) > 32768;

  // Pre-flight guard MUST compact inside Turn 2 down below 32K while preserving strict role alternation & active user goal!
  #assert fww_ensure_context_fits(h[..], 4000, 32768, true, false, true, tmp[..]);
  post_tok := fww_estimate_prompt_tokens(h[..], 4000, true, false);
  #assert post_tok < 29184;
  #assert h[0].compact_count >= 1;
  #assert h[0].msgs[0].role == FWW_MROLE_USER;
  for i: 0..<h[0].nmsgs {
    // Never an orphaned TOOL_RESULTS at index 0 or after USER; never two consecutive ASSISTANT messages
    if h[0].msgs[i].role == FWW_MROLE_TOOL_RESULTS {
      #assert i > 0 && h[0].msgs[i - 1].role == FWW_MROLE_ASSISTANT;
    }
    if i > 0 && h[0].msgs[i].role == FWW_MROLE_ASSISTANT {
      #assert h[0].msgs[i - 1].role != FWW_MROLE_ASSISTANT;
    }
  }
  // Active user goal MUST still be present verbatim after compaction!
  found_goal := false;
  for i: 0..<h[0].nmsgs {
    if h[0].msgs[i].role == FWW_MROLE_USER && h[0].msgs[i].nblocks > 0 {
      ut := fww_slab_str(h[..], h[0].msgs[i].blocks[0].text_at, h[0].msgs[i].blocks[0].text_n);
      if fww_contains_ci(ut, "specking out their mocap system") { found_goal = true; }
    }
  }
  #assert found_goal;

  // Both OpenAI/Psionic and Gemini request bodies MUST serialize cleanly to valid JSON after intra-turn compaction!
  cfg: [1] FwConfig;
  body: [131072] u8;
  ob := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini-uncensored-maple", "high", "sys", true, 32768, false, false, body[..]);
  #assert ob > 0 && json_valid(cast(string) body[0..<ob]);
  gb := fww_build_gemini_body(cfg[..], h[..], "high", "sys", false, body[..]);
  #assert gb > 0 && json_valid(cast(string) body[0..<gb]);

  // 3. Double intra-turn compaction (run full compact again) MUST keep preserving the active user goal!
  #assert fww_hist_compact_ex(h[..], 2, 1, 512, 0, 8192, tmp[..]);
  u0 := fww_slab_str(h[..], h[0].msgs[0].blocks[0].text_at, h[0].msgs[0].blocks[0].text_n);
  #assert fww_contains_ci(u0, "specking out their mocap system") && fww_contains_ci(u0, "Read");

  // 4. Server-calibrated token estimation triggers compaction even if byte heuristic alone looks small
  h[0].last_in_tok = 29500;
  h[0].last_in_bytes = fww_estimate_prompt_bytes(h[..], 4000, true, false);
  #assert fww_estimate_prompt_tokens(h[..], 4000, true, false) >= 29500;
  #assert fww_ensure_context_fits(h[..], 4000, 32768, true, false, true, tmp[..]);
  #assert h[0].last_in_tok == 0;

  // 5. Giant single-message paste (150 KB in 1 USER message) MUST shrink below 32K even when auto_compact=false!
  fww_hist_clear(h[..]);
  huge: [150000] u8;
  for i: 0..<huge.count { huge[i] = cast(u8) ('A' + (i % 26)); }
  fww_hist_push_user(h[..], cast(string) huge[..]);
  #assert fww_estimate_prompt_tokens(h[..], 2000, true, false) > 45000;
  #assert fww_ensure_context_fits(h[..], 2000, 32768, true, false, false, tmp[..]);
  #assert fww_estimate_prompt_tokens(h[..], 2000, true, false) < 29184;

  // 6. Reactive emergency compaction level 3 collapses any history cleanly to fit even an 8K context window
  #assert fww_emergency_compact(h[..], 3, 8192, tmp[..]);
  #assert h[0].nmsgs == 1 && fww_estimate_prompt_tokens(h[..], 1024, true, true) < 4096;
}

#test "flawedworker: structural sanitizer and wire guards make model-terminated or mismatched Gemini/OpenAI requests impossible" #steps 200000000 {
  h: [1] FwHist;
  cfg: [1] FwConfig;
  tmp: [262144] u8;
  body: [131072] u8;
  nodes: [2048] JvNode;
  d: [1] Jv;
  rb: [64] u8;

  // 1. Exact FWW_MAX_MSGS saturation ending on ASSISTANT(tool_use) (build 34337 screenshot crash!)
  fww_hist_push_user(h[..], "Move the archive button to the top of the sidebar.");
  while h[0].nmsgs < FWW_MAX_MSGS {
    if h[0].nmsgs % 2 == 1 {
      mi := h[0].nmsgs;
      h[0].msgs[mi] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
      a0 := [1] int.[0];
      ub := FwBlock.{kind = FWW_MB_TOOL_USE};
      ub.id_n = fww_slab_put(h[..], "c1", a0[..]); ub.id_at = a0[0];
      ub.name_n = fww_slab_put(h[..], "Edit", a0[..]); ub.name_at = a0[0];
      ub.text_n = fww_slab_put(h[..], "{\"file_path\":\"zeron.coax\"}", a0[..]); ub.text_at = a0[0];
      h[0].msgs[mi].blocks[0] = ub;
      h[0].nmsgs += 1;
    } else {
      mi := h[0].nmsgs;
      h[0].msgs[mi] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
      a0 := [1] int.[0];
      tb := FwBlock.{kind = FWW_MB_TOOL_RES};
      tb.id_n = fww_slab_put(h[..], "c1", a0[..]); tb.id_at = a0[0];
      tb.name_n = fww_slab_put(h[..], "Edit", a0[..]); tb.name_at = a0[0];
      tb.text_n = fww_slab_put(h[..], "ok", a0[..]); tb.text_at = a0[0];
      h[0].msgs[mi].blocks[0] = tb;
      h[0].nmsgs += 1;
    }
  }
  #assert h[0].nmsgs == FWW_MAX_MSGS && h[0].msgs[h[0].nmsgs - 1].role == FWW_MROLE_ASSISTANT;
  fww_hist_sanitize(h[..], tmp[..]);
  #assert h[0].nmsgs > 0 && h[0].nmsgs < FWW_MAX_MSGS;
  #assert h[0].msgs[0].role == FWW_MROLE_USER && h[0].msgs[h[0].nmsgs - 1].role != FWW_MROLE_ASSISTANT;
  g1 := fww_build_gemini_body(cfg[..], h[..], "high", "sys", false, body[..]);
  #assert g1 > 0 && jv_parse(d[..], cast(string) body[0..<g1], nodes[..]);
  c1 := jv_get(d[0], 0, "contents");
  cl1 := jv_len(d[0], c1);
  #assert cl1 >= 1;
  prev_r := "";
  for i: 0..<cl1 {
    rn := jv_str(d[0], jv_get(d[0], jv_at(d[0], c1, i), "role"), rb[..]);
    cur_r := cast(string) rb[0..<rn];
    if i == 0 { #assert cur_r == "user"; }
    if i == cl1 - 1 { #assert cur_r == "user"; }
    if i > 0 { #assert cur_r != prev_r; }
    prev_r = ifx cur_r == "user" then "user" else "model";
  }

  // 2. Dangling ASSISTANT(tool_use) after mid-tool stop + new USER prompt -> tool_use stripped, strict alternation
  fww_hist_clear(h[..]);
  fww_hist_push_user(h[..], "First task");
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  a1 := [1] int.[0];
  d_ub := FwBlock.{kind = FWW_MB_TOOL_USE};
  d_ub.id_n = fww_slab_put(h[..], "call_dangling", a1[..]); d_ub.id_at = a1[0];
  d_ub.name_n = fww_slab_put(h[..], "Bash", a1[..]); d_ub.name_at = a1[0];
  d_ub.text_n = fww_slab_put(h[..], "{\"command\":\"ls\"}", a1[..]); d_ub.text_at = a1[0];
  h[0].msgs[1].blocks[0] = d_ub;
  h[0].nmsgs = 2;
  fww_hist_push_user(h[..], "Second task after stop");
  fww_hist_sanitize(h[..], tmp[..]);
  #assert h[0].nmsgs == 3;
  #assert h[0].msgs[0].role == FWW_MROLE_USER && h[0].msgs[1].role == FWW_MROLE_ASSISTANT && h[0].msgs[2].role == FWW_MROLE_USER;
  #assert fww_msg_count_tool_use(h[0].msgs[1]) == 0;

  // 3. Mismatched functionCall (2) vs functionResponse (1) -> stripped cleanly
  fww_hist_clear(h[..]);
  fww_hist_push_user(h[..], "Run two tools");
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 2};
  h[0].msgs[1].blocks[0] = d_ub;
  h[0].msgs[1].blocks[1] = d_ub;
  h[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
  m_tr := FwBlock.{kind = FWW_MB_TOOL_RES};
  m_tr.id_n = fww_slab_put(h[..], "call_dangling", a1[..]); m_tr.id_at = a1[0];
  m_tr.name_n = fww_slab_put(h[..], "Bash", a1[..]); m_tr.name_at = a1[0];
  m_tr.text_n = fww_slab_put(h[..], "only one", a1[..]); m_tr.text_at = a1[0];
  h[0].msgs[2].blocks[0] = m_tr;
  h[0].nmsgs = 3;
  fww_hist_sanitize(h[..], tmp[..]);
  #assert h[0].nmsgs == 3 && fww_msg_count_tool_use(h[0].msgs[1]) == 0 && h[0].msgs[2].role == FWW_MROLE_USER;

  // 4. Thought-only ASSISTANT between two USER turns (H1 recovery) -> dropped & USERs merged (no [user, user]!)
  fww_hist_clear(h[..]);
  fww_hist_push_user(h[..], "Solve hard math");
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  th_b := FwBlock.{kind = FWW_MB_THINK};
  th_b.text_n = fww_slab_put(h[..], "internal scratchpad", a1[..]); th_b.text_at = a1[0];
  h[0].msgs[1].blocks[0] = th_b;
  h[0].nmsgs = 2;
  fww_hist_push_user(h[..], "Now write final answer.");
  fww_hist_sanitize(h[..], tmp[..]);
  #assert h[0].nmsgs == 1 && h[0].msgs[0].role == FWW_MROLE_USER;
  m_txt := fww_slab_str(h[..], h[0].msgs[0].blocks[0].text_at, h[0].msgs[0].blocks[0].text_n);
  #assert fww_contains_ci(m_txt, "Solve hard math") && fww_contains_ci(m_txt, "Now write final answer.");

  // 5. Recall of interrupted turn (empty reply) + new user turn -> balanced user/model/user
  fww_hist_recall(h[..], "[{\"task\":\"old interrupted\",\"reply\":\"\"},{\"task\":\"done turn\",\"reply\":\"all set\"}]");
  #assert h[0].nmsgs == 4 && h[0].msgs[1].role == FWW_MROLE_ASSISTANT && h[0].msgs[3].role == FWW_MROLE_ASSISTANT;
  fww_hist_push_user(h[..], "new turn");
  fww_hist_sanitize(h[..], tmp[..]);
  #assert h[0].nmsgs == 5 && h[0].msgs[4].role == FWW_MROLE_USER;

  // 6. Wire-level last-line-of-defense: calling Gemini/OpenAI body builders DIRECTLY on model-terminated history STILL ends with "user"!
  fww_hist_clear(h[..]);
  fww_hist_push_assistant_text(h[..], "stray leading assistant");
  fww_hist_push_user(h[..], "hello");
  fww_hist_push_assistant_text(h[..], "world");
  g2 := fww_build_gemini_body(cfg[..], h[..], "low", "sys", false, body[..]);
  #assert g2 > 0 && jv_parse(d[..], cast(string) body[0..<g2], nodes[..]);
  c2 := jv_get(d[0], 0, "contents");
  cl2 := jv_len(d[0], c2);
  #assert cl2 == 3;
  r0n := jv_str(d[0], jv_get(d[0], jv_at(d[0], c2, 0), "role"), rb[..]);
  #assert cast(string) rb[0..<r0n] == "user";
  r2n := jv_str(d[0], jv_get(d[0], jv_at(d[0], c2, 2), "role"), rb[..]);
  #assert cast(string) rb[0..<r2n] == "user";

  o2 := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini-uncensored-maple", "low", "sys", true, 32768, false, false, body[..]);
  #assert o2 > 0 && jv_parse(d[..], cast(string) body[0..<o2], nodes[..]);
  ms2 := jv_get(d[0], 0, "messages");
  ml2 := jv_len(d[0], ms2);
  #assert ml2 >= 2;
  om_last := jv_str(d[0], jv_get(d[0], jv_at(d[0], ms2, ml2 - 1), "role"), rb[..]);
  #assert cast(string) rb[0..<om_last] == "user";
}

#test "flawedworker: v1 harness primitives (Read dedup/range, Edit fallback/diagnostics, Bash head+tail, signature repair)" #steps 200000000 {
  // 1. Line helpers + trimmed whitespace fallback + nearest-line diagnostics
  sample := "alpha\nbeta  \ngamma\r\ndelta\nalpha\n";
  #assert fww_count_lines(sample) == 5 && fww_count_lines("") == 0 && fww_count_lines("one") == 1;
  #assert fww_line_num_at(sample, 0) == 1 && fww_line_num_at(sample, 6) == 2;
  tf := [1] int.[0]; tt := [1] int.[0];
  #assert fww_find_trimmed_match(sample, "beta\ngamma\n", tf[..], tt[..]) == 1;
  #assert cast(string) sample[tf[0]..<tt[0]] == "beta  \ngamma\r\n";
  #assert fww_find_trimmed_match(sample, "alpha\n", tf[..], tt[..]) == 2;
  #assert fww_find_nearest_line(sample, "something_delta_missing\ngamma") == 3;

  // 2. Read dedup slot hit/miss/sub-range/epoch/invalidation
  slots: [4] FwReadDedup;
  cur := [1] int.[0];
  ph := fww_str_hash("/tmp/a.coax");
  ch := fww_str_hash("hello world");
  #assert !fww_read_dedup_hit(slots[..], ph, 1, 500, 11, ch, 0);
  fww_read_dedup_put(slots[..], cur[..], ph, 1, 500, 11, ch, 0);
  #assert fww_read_dedup_hit(slots[..], ph, 1, 500, 11, ch, 0);
  #assert fww_read_dedup_hit(slots[..], ph, 120, 320, 11, ch, 0); // sub-range covered!
  #assert !fww_read_dedup_hit(slots[..], ph, 1, 600, 11, ch, 0); // extends past cached end_line
  #assert !fww_read_dedup_hit(slots[..], ph, 1, 500, 11, ch, 1); // invalidated by compaction epoch
  #assert !fww_read_dedup_hit(slots[..], ph, 1, 500, 12, ch, 0); // invalidated by size change
  fww_read_dedup_invalidate(slots[..], ph);
  #assert !fww_read_dedup_hit(slots[..], ph, 1, 500, 11, ch, 0);

  // 3. Streaming Bash head+tail buffer preserves BOTH first lines and final summary lines + exit code!
  cmd: [1] FwAsyncCmd;
  for i: 0..<1200 {
    lb: [96] u8;
    ln := fww_cat(lb[..], 0, "line_");
    ln = fww_put_int(lb[..], ln, i);
    ln = fww_cat(lb[..], ln, "_012345678901234567890123456789012345678901234567890123456789");
    fww_cmd_push_line(cmd[..], cast(string) lb[0..<ln]);
  }
  fn := fww_cmd_finalize(cmd[..]);
  out_s := cast(string) cmd[0].out[0..<fn];
  #assert cmd[0].omitted_bytes > 0;
  #assert fww_contains_ci(out_s, "line_0_");
  #assert fww_contains_ci(out_s, "bytes omitted in middle");
  #assert fww_contains_ci(out_s, "line_1199_");
  res_b: [FWW_TOOL_OUT_MAX] u8;
  rn1 := fww_cmd_tool_result(cmd[..], 2, false, res_b[..]);
  #assert fww_contains_ci(cast(string) res_b[0..<rn1], "[Exit code: 2]");
  empty_cmd: [1] FwAsyncCmd;
  rn2 := fww_cmd_tool_result(empty_cmd[..], 0, false, res_b[..]);
  #assert cast(string) res_b[0..<rn2] == "(command succeeded with no output)";

  // 4. Surgical thoughtSignature repair preserves all messages & swaps tool_use sig to Gemini skip sentinel
  h: [1] FwHist;
  fww_hist_push_user(h[..], "fix bug");
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 2};
  a0 := [1] int.[0];
  b0 := FwBlock.{kind = FWW_MB_TEXT};
  b0.text_n = fww_slab_put(h[..], "checking", a0[..]); b0.text_at = a0[0];
  b0.sig_n = fww_slab_put(h[..], "bad_sig_text", a0[..]); b0.sig_at = a0[0];
  b1 := FwBlock.{kind = FWW_MB_TOOL_USE};
  b1.id_n = fww_slab_put(h[..], "c1", a0[..]); b1.id_at = a0[0];
  b1.name_n = fww_slab_put(h[..], "Read", a0[..]); b1.name_at = a0[0];
  b1.text_n = fww_slab_put(h[..], "{\"file_path\":\"a.coax\"}", a0[..]); b1.text_at = a0[0];
  b1.sig_n = fww_slab_put(h[..], "corrupted_sig", a0[..]); b1.sig_at = a0[0];
  h[0].msgs[1].blocks[0] = b0;
  h[0].msgs[1].blocks[1] = b1;
  h[0].nmsgs = 2;
  fww_hist_strip_thought_sigs(h[..]);
  #assert h[0].nmsgs == 2;
  #assert h[0].msgs[1].blocks[0].sig_n == 0;
  #assert fww_slab_str(h[..], h[0].msgs[1].blocks[1].sig_at, h[0].msgs[1].blocks[1].sig_n) == "skip_thought_signature_validator";

  // 5. Gemini wire serialization folds trailing FWW_MB_TEXT (<system-reminder>/steer) into last functionResponse.output
  //    so parts[] contains ONLY functionResponse parts (1-to-1 with functionCall, never HTTP 400 on Vertex AI!)
  h[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 2};
  tr0 := FwBlock.{kind = FWW_MB_TOOL_RES};
  tr0.id_n = fww_slab_put(h[..], "c1", a0[..]); tr0.id_at = a0[0];
  tr0.name_n = fww_slab_put(h[..], "Read", a0[..]); tr0.name_at = a0[0];
  tr0.text_n = fww_slab_put(h[..], "1\tline one", a0[..]); tr0.text_at = a0[0];
  tr1 := FwBlock.{kind = FWW_MB_TEXT};
  tr1.text_n = fww_slab_put(h[..], "<system-reminder>Edit now.</system-reminder>", a0[..]); tr1.text_at = a0[0];
  h[0].msgs[2].blocks[0] = tr0;
  h[0].msgs[2].blocks[1] = tr1;
  h[0].nmsgs = 3;
  cfg: [1] FwConfig;
  gbody: [32768] u8;
  gn := fww_build_gemini_body(cfg[..], h[..], "high", "sys", false, gbody[..]);
  nodes: [1024] JvNode; gd: [1] Jv;
  #assert gn > 0 && jv_parse(gd[..], cast(string) gbody[0..<gn], nodes[..]);
  cts := jv_get(gd[0], 0, "contents");
  #assert jv_len(gd[0], cts) == 3;
  tr_parts := jv_get(gd[0], jv_at(gd[0], cts, 2), "parts");
  #assert jv_len(gd[0], tr_parts) == 1; // strictly 1 functionResponse part, zero sibling text parts!
  fr0 := jv_get(gd[0], jv_at(gd[0], tr_parts, 0), "functionResponse");
  #assert jv_kind(gd[0], fr0) == JV_OBJECT;
  out_b: [512] u8;
  on := jv_str(gd[0], jv_get(gd[0], jv_get(gd[0], fr0, "response"), "output"), out_b[..]);
  #assert on > 0 && fww_contains_ci(cast(string) out_b[0..<on], "line one") && fww_contains_ci(cast(string) out_b[0..<on], "<system-reminder>Edit now.");

  // 6. Read auto-TOC symbol outline + true FLAWED_THINK_ADAPTIVE step effort policy
  code := "x := 1;\nfoo_bar :: (a: int) -> int {\n  return a;\n}\nMyRec :: struct {\n  v: int;\n}\n#test \"demo\" {\n  #assert true;\n}\n";
  ob: [2048] u8;
  oun := fww_append_symbol_outline(ob[..], 0, code, 2, 10);
  os := cast(string) ob[0..<oun];
  #assert fww_contains_ci(os, "L2: foo_bar ::") && fww_contains_ci(os, "L5: MyRec :: struct") && fww_contains_ci(os, "L8: #test");
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 1, 1, false, false, false, false, false, 0, 0, 0, false) == "medium";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 3, 5, false, false, false, false, false, 0, 120, 600, false) == "high";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 6, 11, true, true, false, false, false, 0, 300, 600, false) == "high";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 7, 13, true, true, false, true, false, 0, 300, 600, false) == "medium";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 8, 15, true, true, false, true, true, 0, 300, 600, false) == "low";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 5, 9, false, false, false, false, false, 2, 100, 600, false) == "medium";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 6, 11, true, false, true, true, false, 0, 200, 600, false) == "high";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 6, 11, false, false, false, false, false, 0, 390, 600, false) == "medium";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 9, 17, true, true, false, false, false, 0, 510, 600, false) == "low";
  #assert fww_adaptive_effort(FLAWED_THINK_EXTENDED, "high", 1, 1, false, false, false, false, false, 0, 500, 600, false) == "high";
  #assert fww_adaptive_effort(FLAWED_THINK_ADAPTIVE, "high", 1, 1, false, false, false, false, false, 0, 500, 600, true) == "high";

  // 7. SSE dead-stream watchdog + dynamic pure-thought spiral guard + binary/UTF-8 sanitizer + fww_hist_clear telemetry reset
  #assert !fww_stream_stalled(false, false, 0, 1000, 200000);
  #assert !fww_stream_stalled(true, true, 0, 1000, 200000);
  #assert !fww_stream_stalled(true, false, 1, 1000, 200000);
  #assert !fww_stream_stalled(true, false, 0, 1000, 150999);
  #assert fww_stream_stalled(true, false, 0, 1000, 151000);
  #assert !fww_think_spiral(false, false, 0, 0, 0, 60000, 1000, 1000, 600, 300000);
  #assert !fww_think_spiral(true, true, 0, 0, 0, 60000, 1000, 1000, 600, 300000);
  #assert !fww_think_spiral(true, false, 2, 0, 0, 60000, 1000, 1000, 600, 300000);
  #assert fww_is_transient_sse_err("This model is currently experiencing high demand. Spikes in demand are usually temporary.");
  #assert fww_is_transient_sse_err("Service UNAVAILABLE: please try again") && fww_is_transient_sse_err("RESOURCE_EXHAUSTED");
  #assert !fww_is_transient_sse_err("API key not valid") && !fww_is_transient_sse_err("");
  #assert !fww_think_spiral(true, false, 0, 1, 0, 60000, 1000, 1000, 600, 300000);
  #assert !fww_think_spiral(true, false, 0, 0, 1, 60000, 1000, 1000, 600, 300000);
  #assert !fww_think_spiral(true, false, 0, 0, 0, 15999, 1000, 1000, 600, 300000);
  #assert !fww_think_spiral(true, false, 0, 0, 0, 34000, 1000, 1000, 600, 186000);
  #assert fww_think_spiral(true, false, 0, 0, 0, 38000, 1000, 1000, 0, 100000);
  #assert fww_think_spiral(true, false, 0, 0, 0, 18000, 1000, 1000, 0, 206000);
  // Tight remaining budget (350s elapsed of 600s -> 250s left -> 40% = 100s cap from first_tok_ms) breaks spiral early!
  #assert !fww_think_spiral(true, false, 0, 0, 0, 18000, 351000, 1000, 600, 441000);
  #assert fww_think_spiral(true, false, 0, 0, 0, 18000, 351000, 1000, 600, 452000);
  // Binary / UTF-8 sanitization preserves valid text & UTF-8 while collapsing binary/C1-control streams
  #assert !fww_is_binary_bytes("hello café 123\nworld\t!");
  bin_raw := [8] u8.['A', 0x00, 0x80, 0xFF, 0x1B, 0xC2, 0x85, 'Z'];
  #assert fww_is_binary_bytes(cast(string) bin_raw[..]);
  san_out: [128] u8;
  sn := fww_sanitize_text_line("ok\rcafé\t1", san_out[..]);
  #assert cast(string) san_out[0..<sn] == "okcafé\t1";
  sn2 := fww_sanitize_text_line(cast(string) bin_raw[..], san_out[..]);
  #assert cast(string) san_out[0..<sn2] == "A[binary]Z";
  #assert fww_is_scratch_path("/tmp/test.py") && fww_is_scratch_path("/var/tmp/x.cc") && fww_is_scratch_path("/private/tmp/a");
  #assert !fww_is_scratch_path("/app/src/main.cc") && !fww_is_scratch_path("src/lib.ts") && !fww_is_scratch_path("");
  h[0].total_in = 999; h[0].total_out = 888; h[0].compact_count = 3;
  fww_hist_clear(h[..]);
  #assert h[0].total_in == 0 && h[0].total_out == 0 && h[0].compact_count == 0;
}

#test "flawedworker: atomic compaction never corrupts TOOL_USE names/sigs on tmp_buf overflow and sanitizer rejects invalid tool pairs" #steps 200000000 {
  h: [1] FwHist;
  cfg: [1] FwConfig;
  small_tmp: [131072] u8;
  body: [262144] u8;
  nodes: [2048] JvNode;
  d: [1] Jv;
  nb: [64] u8;

  // 1. Reproduce GTA CLEANROOM: many Write TOOL_USE messages whose total TOOL_USE JSON args exceed tmp_buf (128 KiB)
  //    AND hit FWW_MAX_MSGS - 6. Layer 1 (drop_to_tail=0) MUST fail atomically without corrupting trailing blocks,
  //    and fww_ensure_context_fits MUST escalate cleanly to Layer 2 keeping intact Write names, IDs, args, and sigs!
  fww_hist_push_user(h[..], "Implement Milestone 1 issues in order.");
  h[0].total_in = 317119;
  h[0].total_cost_micros = 13734794;

  // Build a ~4 KB valid JSON Write arg string
  warg: [4096] u8;
  wn := fww_cat(warg[..], 0, "{\"file_path\":\"src/render/frame_graph.mm\",\"content\":\"");
  while wn + 16 < warg.count { wn = fww_cat(warg[..], wn, "float x = 1.0f; "); }
  wn = fww_cat(warg[..], wn, "\"}");
  warg_s := cast(string) warg[0..<wn];

  // Fill to FWW_MAX_MSGS - 5 (251 msgs -> 125 Write steps -> ~500 KB of TOOL_USE args >> 128 KiB small_tmp!)
  for step: 0..<125 {
    a0 := [1] int.[0];
    am := h[0].nmsgs;
    h[0].msgs[am] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
    ub := FwBlock.{kind = FWW_MB_TOOL_USE};
    ub.id_n = fww_slab_put(h[..], "call_w", a0[..]); ub.id_at = a0[0];
    ub.name_n = fww_slab_put(h[..], "Write", a0[..]); ub.name_at = a0[0];
    ub.text_n = fww_slab_put(h[..], warg_s, a0[..]); ub.text_at = a0[0];
    ub.sig_n = fww_slab_put(h[..], "SIG_VALID_TOKEN_XYZ", a0[..]); ub.sig_at = a0[0];
    h[0].msgs[am].blocks[0] = ub;
    h[0].nmsgs += 1;

    tm := h[0].nmsgs;
    h[0].msgs[tm] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
    rb := FwBlock.{kind = FWW_MB_TOOL_RES};
    rb.id_n = fww_slab_put(h[..], "call_w", a0[..]); rb.id_at = a0[0];
    rb.name_n = fww_slab_put(h[..], "Write", a0[..]); rb.name_at = a0[0];
    rb.text_n = fww_slab_put(h[..], "Wrote 4000 bytes.", a0[..]); rb.text_at = a0[0];
    h[0].msgs[tm].blocks[0] = rb;
    h[0].nmsgs += 1;
  }
  #assert h[0].nmsgs == 251;
  last_before := h[0].nmsgs - 2;
  #assert fww_slab_str(h[..], h[0].msgs[last_before].blocks[0].name_at, h[0].msgs[last_before].blocks[0].name_n) == "Write";

  // Layer 1 in-place microcompact MUST refuse cleanly without mutating h when fixed TOOL_USE bytes exceed tmp_buf!
  #assert !fww_hist_compact_ex(h[..], 0, 2, 512, 0, 0, small_tmp[..]);
  #assert h[0].nmsgs == 251;
  #assert fww_slab_str(h[..], h[0].msgs[last_before].blocks[0].name_at, h[0].msgs[last_before].blocks[0].name_n) == "Write";
  #assert fww_slab_str(h[..], h[0].msgs[last_before].blocks[0].sig_at, h[0].msgs[last_before].blocks[0].sig_n) == "SIG_VALID_TOKEN_XYZ";

  // Full pre-flight guard MUST escalate cleanly to Layer 2, keeping intact Write calls, preserving session telemetry,
  // and serializing a valid Vertex/Gemini request with zero empty tool names!
  #assert fww_ensure_context_fits(h[..], 4000, 1048576, false, false, true, small_tmp[..]);
  #assert h[0].nmsgs == 5 && h[0].compact_count == 1 && h[0].total_in == 317119 && h[0].total_cost_micros == 13734794;
  fww_hist_sanitize(h[..], small_tmp[..]);
  #assert h[0].nmsgs == 5;
  gn := fww_build_gemini_body(cfg[..], h[..], "high", "sys", false, body[..]);
  #assert gn > 0 && jv_parse(d[..], cast(string) body[0..<gn], nodes[..]);
  cts := jv_get(d[0], 0, "contents");
  #assert jv_len(d[0], cts) == 5;
  fc1 := jv_get(d[0], jv_at(d[0], jv_get(d[0], jv_at(d[0], cts, 1), "parts"), 0), "functionCall");
  fr2 := jv_get(d[0], jv_at(d[0], jv_get(d[0], jv_at(d[0], cts, 2), "parts"), 0), "functionResponse");
  n1 := jv_str(d[0], jv_get(d[0], fc1, "name"), nb[..]);
  #assert n1 == 5 && cast(string) nb[0..<n1] == "Write";
  n2 := jv_str(d[0], jv_get(d[0], fr2, "name"), nb[..]);
  #assert n2 == 5 && cast(string) nb[0..<n2] == "Write";
  sig1 := jv_str(d[0], jv_get(d[0], jv_at(d[0], jv_get(d[0], jv_at(d[0], cts, 1), "parts"), 0), "thoughtSignature"), nb[..]);
  #assert cast(string) nb[0..<sig1] == "SIG_VALID_TOKEN_XYZ";

  // 2. Sanitizer rejects empty functionCall.name & mismatched functionCall/functionResponse names (Vertex 400 INVALID_ARGUMENT)
  //    while preserving any merged trailing user message ("continue")!
  fww_hist_clear(h[..]);
  fww_hist_push_user(h[..], "Original goal");
  a1 := [1] int.[0];
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  bad_tu := FwBlock.{kind = FWW_MB_TOOL_USE};
  bad_tu.id_n = fww_slab_put(h[..], "call_bad", a1[..]); bad_tu.id_at = a1[0];
  bad_tu.name_n = 0; // simulated empty corrupted tool name
  bad_tu.text_n = fww_slab_put(h[..], "{}", a1[..]); bad_tu.text_at = a1[0];
  h[0].msgs[1].blocks[0] = bad_tu;
  h[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 2};
  bad_tr := FwBlock.{kind = FWW_MB_TOOL_RES};
  bad_tr.id_n = fww_slab_put(h[..], "call_bad", a1[..]); bad_tr.id_at = a1[0];
  bad_tr.name_n = fww_slab_put(h[..], "Bash", a1[..]); bad_tr.name_at = a1[0];
  bad_tr.text_n = fww_slab_put(h[..], "ok", a1[..]); bad_tr.text_at = a1[0];
  cont_b := FwBlock.{kind = FWW_MB_TEXT};
  cont_b.text_n = fww_slab_put(h[..], "continue", a1[..]); cont_b.text_at = a1[0];
  h[0].msgs[2].blocks[0] = bad_tr;
  h[0].msgs[2].blocks[1] = cont_b;
  h[0].nmsgs = 3;

  // Wire-level defense even if called directly before sanitize: never emits empty functionCall.name!
  gn_raw := fww_build_gemini_body(cfg[..], h[..], "low", "sys", false, body[..]);
  #assert gn_raw > 0 && jv_parse(d[..], cast(string) body[0..<gn_raw], nodes[..]);
  raw_fc := jv_get(d[0], jv_at(d[0], jv_get(d[0], jv_at(d[0], jv_get(d[0], 0, "contents"), 1), "parts"), 0), "functionCall");
  rn_raw := jv_str(d[0], jv_get(d[0], raw_fc, "name"), nb[..]);
  #assert rn_raw == 4 && cast(string) nb[0..<rn_raw] == "tool";

  // Sanitizer strips the corrupted empty-name tool pair and preserves "continue" as a clean USER turn!
  #assert !fww_msg_tools_valid(h[..], h[0].msgs[1], h[0].msgs[2]);
  fww_hist_sanitize(h[..], small_tmp[..]);
  #assert h[0].nmsgs == 3;
  #assert h[0].msgs[0].role == FWW_MROLE_USER && h[0].msgs[1].role == FWW_MROLE_ASSISTANT && h[0].msgs[2].role == FWW_MROLE_USER;
  #assert fww_msg_count_tool_use(h[0].msgs[1]) == 0;
  #assert fww_slab_str(h[..], h[0].msgs[2].blocks[0].text_at, h[0].msgs[2].blocks[0].text_n) == "continue";

  // 3. Mismatched functionCall.name ("Bash") vs functionResponse.name ("tool") with matching id is also rejected!
  fww_hist_clear(h[..]);
  fww_hist_push_user(h[..], "Run build");
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  tu_m := FwBlock.{kind = FWW_MB_TOOL_USE};
  tu_m.id_n = fww_slab_put(h[..], "c1", a1[..]); tu_m.id_at = a1[0];
  tu_m.name_n = fww_slab_put(h[..], "Bash", a1[..]); tu_m.name_at = a1[0];
  tu_m.text_n = fww_slab_put(h[..], "{\"command\":\"ls\"}", a1[..]); tu_m.text_at = a1[0];
  h[0].msgs[1].blocks[0] = tu_m;
  h[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
  tr_m := FwBlock.{kind = FWW_MB_TOOL_RES};
  tr_m.id_n = fww_slab_put(h[..], "c1", a1[..]); tr_m.id_at = a1[0];
  tr_m.name_n = fww_slab_put(h[..], "tool", a1[..]); tr_m.name_at = a1[0];
  tr_m.text_n = fww_slab_put(h[..], "ok", a1[..]); tr_m.text_at = a1[0];
  h[0].msgs[2].blocks[0] = tr_m;
  h[0].nmsgs = 3;
  #assert !fww_msg_tools_valid(h[..], h[0].msgs[1], h[0].msgs[2]);
  fww_hist_sanitize(h[..], small_tmp[..]);
  #assert h[0].nmsgs == 3 && fww_msg_count_tool_use(h[0].msgs[1]) == 0 && h[0].msgs[2].role == FWW_MROLE_USER;
}

#test "flawedworker: native Read image detection, macOS screenshot thin-space fallback, dims, multimodal wire, and compaction" {
  // 1. Extension extraction & classification
  eb: [16] u8;
  #assert fww_path_ext_lower("/Users/a/Shot.PNG", eb[..]) == "png" && fww_is_image_ext("png");
  #assert fww_path_ext_lower("foo/bar.JPEG", eb[..]) == "jpeg" && fww_is_image_ext("jpeg");
  #assert fww_path_ext_lower("a.webp", eb[..]) == "webp" && fww_is_image_ext("webp");
  #assert fww_path_ext_lower("a.heic", eb[..]) == "heic" && fww_is_image_ext("heic");
  #assert !fww_is_image_ext(fww_path_ext_lower("dir.png/readme.md", eb[..]));

  // 2. macOS screenshot AM/PM space <-> U+202F narrow no-break space fallback
  ab: [256] u8; ab2: [256] u8;
  alt1 := fww_alt_screenshot_path("/Users/a/Desktop/Screenshot 2026-04-01 at 10.30.00 AM.png", ab[..]);
  #assert alt1.count > 0 && alt1 != "/Users/a/Desktop/Screenshot 2026-04-01 at 10.30.00 AM.png";
  // Round-trip back from U+202F to regular ASCII space
  alt2 := fww_alt_screenshot_path(alt1, ab2[..]);
  #assert alt2 == "/Users/a/Desktop/Screenshot 2026-04-01 at 10.30.00 AM.png";
  #assert fww_alt_screenshot_path("/Users/a/Desktop/plain.png", ab[..]).count == 0;

  // 3. Magic-byte MIME detection & pure-Coax dimension parsing (PNG, GIF, JPEG, WebP)
  png_hdr := [24] u8.[0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0, 0, 0, 13, 'I', 'H', 'D', 'R', 0, 0, 0x05, 0xA0, 0, 0, 0x03, 0x84];
  #assert fww_detect_image_mime(cast(string) png_hdr[..]) == "image/png";
  w := [1] int.[0]; hh := [1] int.[0];
  #assert fww_image_dims(cast(string) png_hdr[..], "image/png", w[..], hh[..]) && w[0] == 1440 && hh[0] == 900;

  gif_hdr := [10] u8.['G', 'I', 'F', '8', '9', 'a', 0x40, 0x01, 0xF0, 0x00];
  #assert fww_detect_image_mime(cast(string) gif_hdr[..]) == "image/gif";
  #assert fww_image_dims(cast(string) gif_hdr[..], "image/gif", w[..], hh[..]) && w[0] == 320 && hh[0] == 240;

  jpg_hdr := [11] u8.[0xFF, 0xD8, 0xFF, 0xC0, 0x00, 0x07, 0x08, 0x04, 0x38, 0x07, 0x80];
  #assert fww_detect_image_mime(cast(string) jpg_hdr[..]) == "image/jpeg";
  #assert fww_image_dims(cast(string) jpg_hdr[..], "image/jpeg", w[..], hh[..]) && w[0] == 1920 && hh[0] == 1080;

  webp_hdr := [30] u8.['R', 'I', 'F', 'F', 0, 0, 0, 0, 'W', 'E', 'B', 'P', 'V', 'P', '8', 'X', 0, 0, 0, 0, 0, 0, 0, 0, 0x3F, 0x03, 0x00, 0x57, 0x02, 0x00];
  #assert fww_detect_image_mime(cast(string) webp_hdr[..]) == "image/webp";
  #assert fww_image_dims(cast(string) webp_hdr[..], "image/webp", w[..], hh[..]) && w[0] == 832 && hh[0] == 600;

  // 4. Gemini multimodal functionResponse.parts[].inlineData & OpenAI multimodal user image_url serialization
  cfg: [1] FwConfig;
  h: [1] FwHist;
  fww_hist_push_user(h[..], "Inspect screenshot.png");
  a0 := [1] int.[0];
  h[0].msgs[1] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  tu := FwBlock.{kind = FWW_MB_TOOL_USE};
  tu.id_n = fww_slab_put(h[..], "call_img_1", a0[..]); tu.id_at = a0[0];
  tu.name_n = fww_slab_put(h[..], "Read", a0[..]); tu.name_at = a0[0];
  tu.text_n = fww_slab_put(h[..], "{\"file_path\":\"screenshot.png\"}", a0[..]); tu.text_at = a0[0];
  h[0].msgs[1].blocks[0] = tu;
  h[0].msgs[2] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
  tr := FwBlock.{kind = FWW_MB_TOOL_RES};
  tr.id_n = fww_slab_put(h[..], "call_img_1", a0[..]); tr.id_at = a0[0];
  tr.name_n = fww_slab_put(h[..], "Read", a0[..]); tr.name_at = a0[0];
  tr.text_n = fww_slab_put(h[..], "[Image: screenshot.png | image/png | 1440x900 | 1024 bytes] Image attached natively in this tool result.", a0[..]); tr.text_at = a0[0];
  tr.img_mime_n = fww_slab_put(h[..], "image/png", a0[..]); tr.img_mime_at = a0[0];
  tr.img_n = fww_slab_put(h[..], "iVBORw0KGgo=", a0[..]); tr.img_at = a0[0];
  h[0].msgs[2].blocks[0] = tr;
  h[0].nmsgs = 3;

  // Token estimate counts image as ~1600 tok (NOT base64_bytes/3)
  tok_est := fww_estimate_prompt_tokens(h[..], 100, false, false);
  #assert tok_est > 1600 && tok_est < 6000;

  body: [32768] u8;
  gn := fww_build_gemini_body(cfg[..], h[..], "low", "sys", false, body[..]);
  #assert gn > 0;
  nodes: [512] JvNode; d: [1] Jv; sb: [128] u8;
  #assert jv_parse(d[..], cast(string) body[0..<gn], nodes[..]);
  cts := jv_get(d[0], 0, "contents");
  tr_parts := jv_get(d[0], jv_at(d[0], cts, 2), "parts");
  #assert jv_len(d[0], tr_parts) == 1;
  fr := jv_get(d[0], jv_at(d[0], tr_parts, 0), "functionResponse");
  fr_parts := jv_get(d[0], fr, "parts");
  #assert jv_len(d[0], fr_parts) == 1;
  inl := jv_get(d[0], jv_at(d[0], fr_parts, 0), "inlineData");
  mn := jv_str(d[0], jv_get(d[0], inl, "mimeType"), sb[..]);
  #assert cast(string) sb[0..<mn] == "image/png";
  dn := jv_str(d[0], jv_get(d[0], inl, "data"), sb[..]);
  #assert cast(string) sb[0..<dn] == "iVBORw0KGgo=";

  // OpenAI cloud body emits role:tool text followed by multimodal role:user image_url
  on := fww_build_openai_body(cfg[..], h[..], "google/gemini-4-neon", "low", "sys", false, 0, false, false, body[..]);
  #assert on > 0 && jv_parse(d[..], cast(string) body[0..<on], nodes[..]);
  omsgs := jv_get(d[0], 0, "messages");
  #assert jv_len(d[0], omsgs) == 5; // system, user, assistant, tool, multimodal user
  mm_msg := jv_at(d[0], omsgs, 4);
  rn := jv_str(d[0], jv_get(d[0], mm_msg, "role"), sb[..]);
  #assert cast(string) sb[0..<rn] == "user";
  mc := jv_get(d[0], mm_msg, "content");
  #assert jv_len(d[0], mc) == 2;
  url_n := jv_str(d[0], jv_get(d[0], jv_get(d[0], jv_at(d[0], mc, 1), "image_url"), "url"), sb[..]);
  #assert cast(string) sb[0..<url_n] == "data:image/png;base64,iVBORw0KGgo=";

  // Local text-only body omits image_url
  ln := fww_build_openai_body(cfg[..], h[..], "inkling-2-mini", "low", "sys", true, 32768, false, false, body[..]);
  #assert ln > 0 && jv_parse(d[..], cast(string) body[0..<ln], nodes[..]);
  #assert jv_len(d[0], jv_get(d[0], 0, "messages")) == 4;

  // 5. Compaction preserves recent image blocks and drops old image blocks
  tmp: [65536] u8;
  // Add a second tool turn so turn 1 becomes "old" when keep_recent_tools = 1
  h[0].msgs[3] = FwMsg.{role = FWW_MROLE_ASSISTANT, nblocks = 1};
  tu2 := FwBlock.{kind = FWW_MB_TOOL_USE};
  tu2.id_n = fww_slab_put(h[..], "call_2", a0[..]); tu2.id_at = a0[0];
  tu2.name_n = fww_slab_put(h[..], "Read", a0[..]); tu2.name_at = a0[0];
  tu2.text_n = fww_slab_put(h[..], "{\"file_path\":\"shot2.png\"}", a0[..]); tu2.text_at = a0[0];
  h[0].msgs[3].blocks[0] = tu2;
  h[0].msgs[4] = FwMsg.{role = FWW_MROLE_TOOL_RESULTS, nblocks = 1};
  tr2 := FwBlock.{kind = FWW_MB_TOOL_RES};
  tr2.id_n = fww_slab_put(h[..], "call_2", a0[..]); tr2.id_at = a0[0];
  tr2.name_n = fww_slab_put(h[..], "Read", a0[..]); tr2.name_at = a0[0];
  tr2.text_n = fww_slab_put(h[..], "[Image: shot2.png]", a0[..]); tr2.text_at = a0[0];
  tr2.img_mime_n = fww_slab_put(h[..], "image/jpeg", a0[..]); tr2.img_mime_at = a0[0];
  tr2.img_n = fww_slab_put(h[..], "/9j/4AAQ", a0[..]); tr2.img_at = a0[0];
  h[0].msgs[4].blocks[0] = tr2;
  h[0].nmsgs = 5;

  #assert fww_hist_compact_ex(h[..], 0, 1, 512, 0, 0, tmp[..]);
  #assert h[0].msgs[2].blocks[0].img_n == 0; // older screenshot base64 stripped
  #assert h[0].msgs[4].blocks[0].img_n == 8 && fww_slab_str(h[..], h[0].msgs[4].blocks[0].img_at, h[0].msgs[4].blocks[0].img_n) == "/9j/4AAQ"; // recent screenshot preserved!
}

#test "flawedworker: split system prompt <25% on non-coding turns (Inkling 2 Mini & Neon) and Coax intel tools (#14054)" {
  cfg: [1] FwConfig;
  cfg[0].bare_mode = true;
  cfg[0].permission_mode = FLAWED_PMODE_BYPASS;
  cfg[0].thinking_mode = FLAWED_THINK_ADAPTIVE;

  base_b: [4096] u8;
  full_b: [16384] u8;
  base_n := fww_build_base_system_prompt_core(cfg[..], "macOS", base_b[..]);
  full_n := fww_build_coding_system_prompt_core(cfg[..], "/repo/openagents", "macOS", full_b[..]);
  base_sys := cast(string) base_b[0..<base_n];
  full_sys := cast(string) full_b[0..<full_n];
  // Base conversational prompt alone is <25% of full coding system prompt
  #assert base_n > 80 && full_n > 1500 && base_n * 4 < full_n;
  #assert fww_contains_ci(full_sys, "CoaxDefines") && fww_contains_ci(full_sys, "CoaxUses") && fww_contains_ci(full_sys, "CoaxCheck");

  // Turn classifier: conversational vs coding
  h_chat: [1] FwHist;
  fww_hist_push_user(h_chat[..], "Hello! Can you explain the difference between TCP and UDP?");
  #assert !fww_is_coding_turn(cfg[..], h_chat[..]);

  h_code: [1] FwHist;
  fww_hist_push_user(h_code[..], "Find where rp_put is defined in coax/lib/repo/lines.coax and check it.");
  #assert fww_is_coding_turn(cfg[..], h_code[..]);

  // Verify non-coding turn prompt token/byte count is <25% of full coding prompt on BOTH Inkling 2 Mini and Neon
  b_chat: [32768] u8;
  b_code: [32768] u8;

  // 1) Inkling 2 Mini (local OpenAI/Psionic wire body)
  ink_chat_n := fww_build_openai_body_ex(cfg[..], h_chat[..], "inkling-2-mini", "high", base_sys, true, 32768, true, false, false, b_chat[..]);
  ink_code_n := fww_build_openai_body_ex(cfg[..], h_code[..], "inkling-2-mini", "high", full_sys, true, 32768, false, false, true, b_code[..]);
  ink_chat_tok := fww_estimate_prompt_tokens(h_chat[..], base_n, true, true);
  ink_code_tok := fww_estimate_prompt_tokens(h_code[..], full_n, true, false);
  #assert ink_chat_n > 0 && ink_code_n > 0 && ink_chat_n * 4 < ink_code_n;
  #assert ink_chat_tok > 0 && ink_chat_tok * 4 < ink_code_tok;
  #assert !fww_contains_ci(cast(string) b_chat[0..<ink_chat_n], "CoaxDefines");
  #assert fww_contains_ci(cast(string) b_code[0..<ink_code_n], "CoaxDefines");

  // 2) Neon (Gemini native wire body)
  neon_chat_n := fww_build_gemini_body_ex(cfg[..], h_chat[..], "high", base_sys, true, false, b_chat[..]);
  neon_code_n := fww_build_gemini_body_ex(cfg[..], h_code[..], "high", full_sys, false, true, b_code[..]);
  neon_chat_tok := fww_estimate_prompt_tokens(h_chat[..], base_n, false, true);
  neon_code_tok := fww_estimate_prompt_tokens(h_code[..], full_n, false, false);
  #assert neon_chat_n > 0 && neon_code_n > 0 && neon_chat_n * 4 < neon_code_n;
  #assert neon_chat_tok > 0 && neon_chat_tok * 4 < neon_code_tok;
  #assert !fww_contains_ci(cast(string) b_chat[0..<neon_chat_n], "functionDeclarations");
  #assert fww_contains_ci(cast(string) b_code[0..<neon_code_n], "CoaxDefines");

  // 3) All 12 Coax compiler-backed intelligence tools map cleanly & have proper permission tiers
  #assert fww_is_coax_intel_tool("CoaxDefines") && fww_coax_intel_subcmd("CoaxDefines") == "defines";
  #assert fww_is_coax_intel_tool("CoaxUses") && fww_coax_intel_subcmd("CoaxUses") == "uses";
  #assert fww_is_coax_intel_tool("CoaxChecks") && fww_coax_intel_subcmd("CoaxChecks") == "checks";
  #assert fww_is_coax_intel_tool("CoaxExports") && fww_coax_intel_subcmd("CoaxExports") == "exports";
  #assert fww_is_coax_intel_tool("CoaxShow") && fww_coax_intel_subcmd("CoaxShow") == "show";
  #assert fww_is_coax_intel_tool("CoaxCheck") && fww_coax_intel_subcmd("CoaxCheck") == "check";
  #assert fww_is_coax_intel_tool("CoaxExplain") && fww_coax_intel_subcmd("CoaxExplain") == "explain";
  #assert fww_is_coax_intel_tool("CoaxVocab") && fww_coax_intel_subcmd("CoaxVocab") == "vocab";
  #assert fww_is_coax_intel_tool("CoaxEffects") && fww_coax_intel_subcmd("CoaxEffects") == "effects";
  #assert fww_is_coax_intel_tool("CoaxDepends") && fww_coax_intel_subcmd("CoaxDepends") == "depends";
  #assert fww_is_coax_intel_tool("CoaxLoaders") && fww_coax_intel_subcmd("CoaxLoaders") == "loaders";
  #assert fww_is_coax_intel_tool("CoaxReplace") && fww_coax_intel_subcmd("CoaxReplace") == "replace";
  #assert !fww_is_coax_intel_tool("Read");
  #assert flawed_wire_tool_permission("CoaxDefines", "rp_put", FLAWED_PMODE_PLAN, false, false) == FLAWED_PBEH_ALLOW;
  #assert flawed_wire_tool_permission("CoaxReplace", "coax/lib/repo/lines.coax", FLAWED_PMODE_PLAN, false, false) == FLAWED_PBEH_DENY;
  #assert flawed_wire_tool_permission("CoaxReplace", "coax/lib/repo/lines.coax", FLAWED_PMODE_ACCEPT_EDITS, false, false) == FLAWED_PBEH_ALLOW;

  // 4) Local 32K Inkling 2 Mini compact coding prompt is <30% of full Neon prompt (#14055)
  loc_b: [4096] u8;
  loc_n := fww_build_local_coding_system_prompt_core(cfg[..], "/repo/openagents", "macOS", loc_b[..]);
  loc_sys := cast(string) loc_b[0..<loc_n];
  #assert loc_n > 200 && loc_n < 1024 && loc_n * 3 < full_n;
  #assert fww_contains_ci(loc_sys, "rm -rf ..") && fww_contains_ci(loc_sys, "git push");

  // 5) Auto mode calls System One Front v2alpha1 policy with continuation & compute tier selection (#14056)
  p: [1] Rtr2Plan;
  fww_route_auto_plan("Hello there!", "", "", "", true, true, "", p[..]);
  #assert p[0].ok && p[0].capability_packs[0] == "general" && p[0].compute_tier == "local_inkling" && p[0].effort == "low";
  fww_route_auto_plan("Fix the bug in policy.coax", "", "", "", true, true, "", p[..]);
  #assert p[0].ok && p[0].capability_packs[0] == "coder" && p[0].compute_tier == "cloud_fast";
  fww_route_auto_plan("Now run the tests", "", "coder", "cloud_deep", true, true, "", p[..]);
  #assert p[0].ok && p[0].continue_active && p[0].capability_packs[0] == "coder" && p[0].compute_tier == "cloud_deep";
  fww_route_auto_plan("Check my Lightning wallet sats", "", "", "", true, true, "", p[..]);
  #assert p[0].ok && p[0].capability_packs[0] == "wallet";

  // 6) Member tool packs (#14057): Wallet, CLI, Metaverse/GameBuilder target extraction, schema mounting, & non-bypassable policy
  tb: [512] u8;
  #assert fww_tool_target("WalletPay", "{\"destination\":\"alice@openagents.com\",\"amount_sats\":500,\"reason\":\"coffee\"}", tb[..]) == "alice@openagents.com (500 sats) — coffee";
  #assert fww_tool_target("OpenAgentsCli", "{\"subcommand\":\"vault\",\"args\":[\"get\",\"api_key\"]}", tb[..]) == "vault get";
  #assert fww_tool_target("OpenAgentsCli", "{\"subcommand\":\"tasks\",\"args\":[\"list\",\"--json\"]}", tb[..]) == "tasks list";
  #assert fww_tool_target("GameBuilder", "{\"action\":\"build\",\"target\":\"scrappers-arena/level-1\"}", tb[..]) == "build scrappers-arena/level-1";

  // Wire serialization with all member packs includes WalletStatus, WalletPay, OpenAgentsCli, MetaverseRoute, GameBuilder
  packs_all := OA_PACK_COAX_INTEL | OA_PACK_WALLET | OA_PACK_CLI | OA_PACK_METAVERSE;
  mp_n := fww_build_gemini_body_packs(cfg[..], h_code[..], "high", full_sys, false, packs_all, b_code[..]);
  #assert mp_n > 0;
  mp_s := cast(string) b_code[0..<mp_n];
  #assert fww_contains_ci(mp_s, "WalletStatus") && fww_contains_ci(mp_s, "WalletPay");
  #assert fww_contains_ci(mp_s, "OpenAgentsCli") && fww_contains_ci(mp_s, "MetaverseRoute") && fww_contains_ci(mp_s, "GameBuilder");

  // In-process #authority MetaverseRoute tool execution returns canonical JSON for 3D assets and rejects traversal
  mr_out: [4096] u8;
  mr_err := [1] bool.[false];
  empty_w: [1] u8;
  mr_n := fww_tool_metaverse("/repo", "MetaverseRoute", "{\"path\":\"assets/robot.glb\"}", mr_out[..], mr_err[..], empty_w[0..<0]);
  #assert !mr_err[0] && mr_n > 0 && fww_contains_ci(cast(string) mr_out[0..<mr_n], "\"target_pane\":\"metaverse\"") && fww_contains_ci(cast(string) mr_out[0..<mr_n], "\"tab_kind\":\"model\"");
  mr_n2 := fww_tool_metaverse("/repo", "MetaverseRoute", "{\"path\":\"../../etc/passwd.glb\"}", mr_out[..], mr_err[..], empty_w[0..<0]);
  #assert !mr_err[0] && mr_n2 > 0 && fww_contains_ci(cast(string) mr_out[0..<mr_n2], "\"target_pane\":\"reject\"");

  // OpenAgentsCli rejects disallowed subcommands & unsafe args even at executor layer
  cli_n := fww_tool_cli("/repo", "{\"subcommand\":\"rm\",\"args\":[\"-rf\",\"/\"]}", mr_out[..], mr_err[..], empty_w[0..<0]);
  #assert mr_err[0] && cli_n > 0 && fww_contains_ci(cast(string) mr_out[0..<cli_n], "allowlist");

  // Wallet prompts activate tools on non-coding turns
  h_wal: [1] FwHist;
  fww_hist_push_user(h_wal[..], "What is my Bitcoin wallet balance?");
  #assert fww_is_coding_turn(cfg[..], h_wal[..]);
}
