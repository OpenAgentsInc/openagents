// oasim: the iOS Simulator for agents and the person (docs/desktop/ios-simulator-spec.md section 7;
// GitHub #13811). One program, three roles:
//   oasim VERB ...      a command (Microcoder's shell, Codex, any shell): sends one request to the
//                       helper and prints its reply, one JSON object (exit 0 when ok, 1 when not)
//   oasim serve         the helper itself (coax/lib/agent/device/sim-host.coax), started by the
//                       first client that finds none
//   oasim build ...     xcodebuild for the simulator, detached; oasim build_status ID reads it
// Verbs (arguments as Claude's simulator tool names them; coordinates are device points):
//   list | boot [DEVICE] | shutdown [DEVICE] | attach | screenshot [--out PATH] [--scale S]
//   tap X Y [--duration S] | swipe X Y X2 Y2 [--duration S] | touch_path POINTS_JSON
//   touch2_path POINTS2_JSON | text TEXT | press_key KEY [--count N] | button NAME
//   set_appearance light|dark | appearance | set_keyboard show|hide | rotate left|right
//   open_url URL | launch [--app PATH] [--bundle ID] | install APP | terminate BUNDLE
//   describe | logs [--bundle ID] [--since S] | status | quit
//   build (--project P | --workspace W) --scheme S [--configuration C] | build_status ID
//   run (--project P | --workspace W) --scheme S [--configuration C]: build, launch, screenshot
// Every verb takes --device NAME|UDID (default: the booted simulator).
// The environment: OA_SIM_CHAT and OA_SIM_ENGINE (who asks; the app writes them into a run),
// OA_SIM_SOCKET and OA_SIM_HOME (another helper, for checks), OA_SIM_SPILL (where screenshots go),
// OA_SIMHOST (the program to start as the helper; default this one).
//   coax/web/tool.sh coder/tui/oasim.coax list
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/agent/device/sim-host.coax";
#load "../../coax/lib/agent/device/sim-build.coax";

cxproc_self_pid :: () -> int #foreign #effects(all);
cxproc_self_path :: (out: [] u8) -> int #foreign #effects(all);
cxterm_write :: (s: [] u8) -> int #foreign #effects(all);

OS_PATH :: 1024;
os_out :: (s: string) {
  ob: [8192] u8; n := 0;
  for c: s { ob[n] = c; n += 1; if n == ob.count { _ = cxterm_write(ob[0..<n]); n = 0; } }
  if n > 0 { _ = cxterm_write(ob[0..<n]); }
}
os_outln :: (s: string) { os_out(s); os_out("\n"); }
os_env :: (name: string, fallback: string, out: [] u8) -> string {
  v := proc_getenv(name, out);
  return ifx v.count > 0 then v else fallback;
}
// ~/.openagents/sim, or OA_SIM_HOME.
os_home :: (out: [] u8) -> string {
  hb: [OS_PATH] u8; home := proc_getenv("HOME", hb[..]);
  d: [OS_PATH] u8; n := sh_put(d[..], 0, home); n = sh_put(d[..], n, "/.openagents/sim");
  v := proc_getenv("OA_SIM_HOME", out);
  if v.count > 0 { return v; }
  k := sh_put(out, 0, cast(string) d[0..<n]);
  return cast(string) out[0..<k];
}
os_sock :: (home: string, out: [] u8) -> string {
  v := proc_getenv("OA_SIM_SOCKET", out);
  if v.count > 0 { return v; }
  return fs_join(home, "simhost.sock", out);
}
os_print_error :: (code: string, why: string) -> int {
  m: [1] SwMsg; sw_reply_error(m[..], 0, code, why);
  out: [4096] u8; n := sw_write(m[..], out[..]);
  if n > 0 { os_outln(cast(string) out[0..<n]); }
  return 1;
}

// ---- reaching the helper

// A connection to the helper, starting it when none answers. -1 when none could be had.
os_connect :: () -> int {
  hb: [OS_PATH] u8; home := os_home(hb[..]);
  sb: [OS_PATH] u8; sock := os_sock(home, sb[..]);
  for c: sock { _ = cxsock_host_push(cast(int) c); }
  h := cxsock_connect_unix(2000);
  if h >= 0 { return h; }
  if !fs_exists(home) { _ = fs_mkdir_private(home); }
  me: [OS_PATH] u8; k := cxproc_self_path(me[..]);
  pb: [OS_PATH] u8; prog := os_env("OA_SIMHOST", ifx k > 0 && k <= me.count then cast(string) me[0..<k] else "", pb[..]);
  if prog.count == 0 { return -1; }
  p := proc_new();
  ok := p >= 0 && proc_arg(p, prog) && proc_arg(p, "serve") && proc_detach(p) && proc_start(p) == 0;
  if p >= 0 { _ = proc_release(p); }
  if !ok { return -1; }
  deadline := proc_now_ms() + 5000;
  while proc_now_ms() < deadline {
    proc_sleep(50);
    for c: sock { _ = cxsock_host_push(cast(int) c); }
    h = cxsock_connect_unix(1000);
    if h >= 0 { return h; }
  }
  return -1;
}
os_write_line :: (h: int, line: string) -> bool {
  for b: line { _ = cxsock_write(h, cast(int) b); }
  _ = cxsock_write(h, 10);
  return cxsock_flush(h, 5000) >= 0;
}
// The next line from the helper into out, waiting at most wait_ms. Its length, or -1.
OsReader :: struct { buf: [SW_LINE] u8; n: int; }
os_read_line :: (h: int, r: [] OsReader, out: [] u8, wait_ms: int) -> int {
  deadline := proc_now_ms() + wait_ms;
  while true {
    for i: 0..<r[0].n {
      if r[0].buf[i] == 10 {
        k := sh_put(out, 0, cast(string) r[0].buf[0..<i]);
        rest := r[0].n - i - 1;
        for j: 0..<rest { r[0].buf[j] = r[0].buf[i + 1 + j]; }
        r[0].n = rest;
        return k;
      }
    }
    left := deadline - proc_now_ms();
    if left <= 0 { return -1; }
    got := cxsock_read(h, ifx left > 500 then 500 else left);
    if got == -2 { continue; }
    if got < 0 { return -1; }
    for i: 0..<got { if r[0].n < SW_LINE { r[0].buf[r[0].n] = cast(u8) cxsock_byte(h, i); r[0].n += 1; } }
  }
  return -1;
}
// Sends hello and then m, prints the reply. The exit status: 0 when the reply is ok.
os_call :: (m: [] SwMsg, wait_ms: int, out: [] u8) -> int {
  h := os_connect();
  if h < 0 { return os_print_error("helper_down", "the simulator helper could not be started"); }
  defer { _ = cxsock_close(h); }
  hello: [1] SwMsg; sw_clear(hello[..]);
  sw_set_int(hello[..], SW_F_ID, 1); _ = sw_set_str(hello[..], SW_F_OP, "hello"); _ = sw_set_str(hello[..], SW_F_CLIENT, "oasim");
  sw_set_int(hello[..], SW_F_VERSION, SH_VERSION);
  cb: [64] u8; chat := proc_getenv("OA_SIM_CHAT", cb[..]); if chat.count > 0 { _ = sw_set_str(hello[..], SW_F_CHAT, chat); }
  eb: [32] u8; _ = sw_set_str(hello[..], SW_F_ENGINE, os_env("OA_SIM_ENGINE", "agent", eb[..]));
  fb: [OS_PATH] u8; folder := fs_cwd(fb[..]); if folder.count > 0 { _ = sw_set_str(hello[..], SW_F_FOLDER, folder); }
  line: [SW_LINE] u8; r: [1] OsReader;
  n := sw_write(hello[..], line[..]);
  if n < 0 || !os_write_line(h, cast(string) line[0..<n]) { return os_print_error("helper_down", "the simulator helper did not take the request"); }
  if os_read_line(h, r[..], line[..], 10000) < 0 { return os_print_error("helper_down", "the simulator helper did not answer"); }
  sw_set_int(m, SW_F_ID, 2);
  n = sw_write(m, line[..]);
  if n < 0 || !os_write_line(h, cast(string) line[0..<n]) { return os_print_error("helper_down", "the simulator helper did not take the request"); }
  got: [1] SwMsg; why: [1] SwText;
  while true {
    k := os_read_line(h, r[..], out, wait_ms);
    if k < 0 { return os_print_error("timeout", "the simulator helper did not answer in time"); }
    if !sw_read(cast(string) out[0..<k], got[..], why[..]) || sw_has(got[..], SW_F_EVENT) { continue; }
    if sw_int(got[..], SW_F_ID, -1) != 2 { continue; }
    os_outln(cast(string) out[0..<k]);
    return ifx sw_bool(got[..], SW_F_OK) then 0 else 1;
  }
  return 1;
}

// ---- verbs into requests

os_num :: (s: string, out: [] f64) -> bool { return sw_parse_num(s, out); }
// The request for verb with its words (a: the arguments after the verb). "" when it is made;
// else why it can't be.
os_request :: (verb: string, a: [] Args, m: [] SwMsg) -> string {
  sw_clear(m);
  if !sw_set_str(m, SW_F_OP, verb) { return "unknown verb"; }
  dev := args_value(a, "--device", "");
  if dev.count > 0 { _ = sw_set_str(m, SW_F_DEVICE, dev); }
  w0 := args_at(a, 1); w1 := args_at(a, 2);
  v: [1] f64;
  if verb == "list" || verb == "attach" || verb == "appearance" || verb == "status" || verb == "quit" || verb == "describe" { return ""; }
  if verb == "boot" || verb == "shutdown" {
    if dev.count == 0 && w0.count > 0 && w0[0] != '-' { _ = sw_set_str(m, SW_F_DEVICE, w0); }
    if verb == "boot" && !sw_has(m, SW_F_DEVICE) { return "boot needs a device: oasim boot NAME|UDID"; }
    return "";
  }
  if verb == "screenshot" {
    sc := args_value(a, "--scale", "");
    if sc.count > 0 { if !os_num(sc, v[..]) { return "--scale is a number from 0.25 to 1"; } sw_set_num(m, SW_F_SCALE, v[0]); }
    _ = sw_set_str(m, SW_F_FORMAT, "png");
    ob: [OS_PATH] u8; out := args_value(a, "--out", "");
    rb: [OS_PATH] u8;
    if out.count > 0 && out[0] != '/' { cw: [OS_PATH] u8; out = fs_join(fs_cwd(cw[..]), out, rb[..]); }
    if out.count == 0 {
      sb: [OS_PATH] u8; hb: [OS_PATH] u8; spill := proc_getenv("OA_SIM_SPILL", sb[..]);
      dir := ifx spill.count > 0 then spill else fs_join(os_home(hb[..]), "shots", ob[..]);
      db: [OS_PATH] u8; dn := sh_put(db[..], 0, dir);
      if !fs_exists(cast(string) db[0..<dn]) { _ = fs_mkdir(cast(string) db[0..<dn]); }
      nb: [64] u8; nn := sh_put(nb[..], 0, "sim-"); ib: [24] u8; nn = sh_put(nb[..], nn, sh_int(proc_now_ms(), ib[..])); nn = sh_put(nb[..], nn, ".png");
      out = fs_join(cast(string) db[0..<dn], cast(string) nb[0..<nn], rb[..]);
    }
    _ = sw_set_str(m, SW_F_OUT, out);
    return "";
  }
  if verb == "tap" || verb == "swipe" {
    need := ifx verb == "tap" then 2 else 4;
    fs := [4] int.[SW_F_X, SW_F_Y, SW_F_X2, SW_F_Y2];
    for i: 0..<need { if !os_num(args_at(a, 1 + i), v[..]) { return ifx verb == "tap" then "tap needs X Y (device points)" else "swipe needs X Y X2 Y2 (device points)"; } sw_set_num(m, fs[i], v[0]); }
    d := args_value(a, "--duration", "");
    if d.count > 0 { if !os_num(d, v[..]) { return "--duration is seconds"; } sw_set_num(m, SW_F_DURATION, v[0]); }
    return "";
  }
  if verb == "touch_path" || verb == "touch2_path" {
    // the points as JSON, read through the wire's own reader
    key := ifx verb == "touch_path" then "points" else "points2";
    lb: [SW_LINE] u8; n := sh_put(lb[..], 0, "{\"op\":\"x\",\""); n = sh_put(lb[..], n, key); n = sh_put(lb[..], n, "\":"); n = sh_put(lb[..], n, w0); n = sh_put(lb[..], n, "}");
    p: [1] SwMsg; why: [1] SwText;
    if !sw_read(cast(string) lb[0..<n], p[..], why[..]) || p[0].npts == 0 { return ifx verb == "touch_path" then "touch_path needs a JSON list of {x, y, dt_ms}" else "touch2_path needs a JSON list of {x1, y1, x2, y2, dt_ms}"; }
    f := ifx verb == "touch_path" then SW_F_POINTS else SW_F_POINTS2;
    for i: 0..<p[0].npts { _ = sw_add_point(m, f, p[0].pts[i]); }
    return "";
  }
  if verb == "text" { if w0.count == 0 { return "text needs the text to type"; } _ = sw_set_str(m, SW_F_TEXT, w0); return ""; }
  if verb == "press_key" {
    if w0.count == 0 { return "press_key needs a key: return, delete, forward_delete, left, right, up, down, home, end, page_up, page_down, select_all, undo, redo"; }
    _ = sw_set_str(m, SW_F_KEY, w0);
    c := args_value(a, "--count", "");
    if c.count > 0 { if !os_num(c, v[..]) { return "--count is 1 to 20"; } sw_set_num(m, SW_F_COUNT, v[0]); }
    return "";
  }
  if verb == "button" { if w0.count == 0 { return "button needs HOME, LOCK, SIDE_BUTTON, SIRI or APPLE_PAY"; } _ = sw_set_str(m, SW_F_NAME, w0); return ""; }
  if verb == "set_appearance" || verb == "set_keyboard" { if w0.count == 0 { return ifx verb == "set_appearance" then "set_appearance needs light or dark" else "set_keyboard needs show or hide"; } _ = sw_set_str(m, SW_F_STATE, w0); return ""; }
  if verb == "rotate" { if w0 != "left" && w0 != "right" { return "rotate needs left or right"; } _ = sw_set_str(m, SW_F_DIRECTION, w0); return ""; }
  if verb == "open_url" { if w0.count == 0 { return "open_url needs a URL"; } _ = sw_set_str(m, SW_F_URL, w0); return ""; }
  if verb == "launch" || verb == "install" {
    app := ifx verb == "install" then w0 else args_value(a, "--app", "");
    if app.count > 0 { rb: [OS_PATH] u8; real := fs_realpath(app, rb[..]); _ = sw_set_str(m, SW_F_APP_PATH, ifx real.count > 0 then real else app); }
    b := args_value(a, "--bundle", ""); if b.count > 0 { _ = sw_set_str(m, SW_F_BUNDLE, b); }
    if !sw_has(m, SW_F_APP_PATH) && !sw_has(m, SW_F_BUNDLE) { return ifx verb == "install" then "install needs an .app" else "launch needs --app PATH or --bundle ID"; }
    return "";
  }
  if verb == "terminate" { if w0.count == 0 { return "terminate needs a bundle id"; } _ = sw_set_str(m, SW_F_BUNDLE, w0); return ""; }
  if verb == "logs" {
    b := args_value(a, "--bundle", ""); if b.count > 0 { _ = sw_set_str(m, SW_F_BUNDLE, b); }
    s := args_value(a, "--since", ""); if s.count > 0 { if !os_num(s, v[..]) { return "--since is seconds"; } sw_set_num(m, SW_F_SINCE, v[0]); }
    return "";
  }
  return "unknown verb";
}
#test "verbs and their words become requests" {
  a: [1] Args; m: [1] SwMsg; out: [4096] u8;
  _ = args_add(a[..], "tap"); _ = args_add(a[..], "201"); _ = args_add(a[..], "640.5"); _ = args_add(a[..], "--device"); _ = args_add(a[..], "U1");
  #assert os_request("tap", a[..], m[..]) == "";
  #assert cast(string) out[0..<sw_write(m[..], out[..])] == "{\"op\":\"tap\",\"device\":\"U1\",\"x\":201,\"y\":640.5}";
  b: [1] Args; _ = args_add(b[..], "swipe"); _ = args_add(b[..], "1"); _ = args_add(b[..], "2");
  #assert os_request("swipe", b[..], m[..]) == "swipe needs X Y X2 Y2 (device points)";
  c: [1] Args; _ = args_add(c[..], "touch_path"); _ = args_add(c[..], "[{\"x\":1,\"y\":2,\"dt_ms\":0},{\"x\":3,\"y\":4,\"dt_ms\":16}]");
  #assert os_request("touch_path", c[..], m[..]) == "" && m[0].npts == 2 && m[0].pts[1].y == 4.0;
  #assert cast(string) out[0..<sw_write(m[..], out[..])] == "{\"op\":\"touch_path\",\"points\":[{\"x\":1,\"y\":2,\"dt_ms\":0},{\"x\":3,\"y\":4,\"dt_ms\":16}]}";
  d: [1] Args; _ = args_add(d[..], "boot"); _ = args_add(d[..], "iPhone 17");
  #assert os_request("boot", d[..], m[..]) == "" && sw_str(m[..], SW_F_DEVICE) == "iPhone 17";
  e: [1] Args; _ = args_add(e[..], "boot"); #assert os_request("boot", e[..], m[..]) == "boot needs a device: oasim boot NAME|UDID";
  f: [1] Args; _ = args_add(f[..], "rotate"); _ = args_add(f[..], "up"); #assert os_request("rotate", f[..], m[..]) == "rotate needs left or right";
  g: [1] Args; _ = args_add(g[..], "erase"); #assert os_request("erase", g[..], m[..]) == "unknown verb";
}

// ---- build (spec 7.3): xcodebuild, detached, its state a build_status reply line

os_builds :: (out: [] u8) -> string { hb: [OS_PATH] u8; return fs_join(os_home(hb[..]), "builds", out); }
os_build_file :: (id: string, ending: string, out: [] u8) -> string {
  bb: [OS_PATH] u8; dir := os_builds(bb[..]);
  n := sh_put(out, 0, dir); n = sh_put(out, n, "/"); n = sh_put(out, n, id); n = sh_put(out, n, ending);
  return cast(string) out[0..<n];
}
os_state :: (id: string, state: string, elapsed_s: int, m: [] SwMsg) {
  sw_reply_ok(m, 0); _ = sw_set_str(m, SW_F_BUILD, id); _ = sw_set_str(m, SW_F_STATE, state);
  if elapsed_s >= 0 { sw_set_int(m, SW_F_ELAPSED, elapsed_s); }
  lb: [OS_PATH] u8; _ = sw_set_str(m, SW_F_LOG, os_build_file(id, ".log", lb[..]));
}
os_write_state :: (id: string, m: [] SwMsg) {
  line: [SW_LINE] u8; n := sw_write(m, line[..]);
  if n < 0 { return; }
  sb: [OS_PATH] u8; tb: [OS_PATH] u8;
  path := os_build_file(id, ".state", sb[..]); tmp := os_build_file(id, ".state.new", tb[..]);
  if fs_write(tmp, cast(string) line[0..<n]) { _ = fs_rename(tmp, path); }
}
// The arguments of a build: what the request names, and the device's UDID ("" any).
os_build_args :: (a: [] Args, c: [] SbArgv, dd: [] u8) -> string {
  project := args_value(a, "--project", ""); workspace := args_value(a, "--workspace", "");
  scheme := args_value(a, "--scheme", ""); conf := args_value(a, "--configuration", "");
  hb: [OS_PATH] u8; home := proc_getenv("HOME", hb[..]);
  rb: [OS_PATH] u8; rn := sh_put(rb[..], 0, home); rn = sh_put(rb[..], rn, "/.cache/openagents/sim-dd");
  ddp := sb_dd(cast(string) rb[0..<rn], ifx project.count > 0 then project else workspace, scheme, dd);
  udid := args_value(a, "--device", "");
  return sb_command(c, project, workspace, scheme, conf, udid, ddp);
}
// Runs xcodebuild to its end (the build worker), writing the log and the final state.
os_build_worker :: (id: string, a: [] Args) -> int {
  c: [1] SbArgv; dd: [OS_PATH] u8;
  why := os_build_args(a, c[..], dd[..]);
  m: [1] SwMsg; t0 := proc_now_ms();
  if why.count > 0 { os_state(id, "failed", 0, m[..]); _ = sw_add_err(m[..], "", 0, 0, why); os_write_state(id, m[..]); return 1; }
  lb: [OS_PATH] u8; logp := os_build_file(id, ".log", lb[..]);
  _ = fs_write(logp, "");
  p := proc_new(); ok := p >= 0;
  for i: 0..<c[0].n { ok = ok && proc_arg(p, c[0].v[i]); }
  ok = ok && proc_err_to_out(p) && proc_start(p) == 0;
  if !ok { if p >= 0 { _ = proc_release(p); } os_state(id, "failed", 0, m[..]); _ = sw_add_err(m[..], "", 0, 0, "xcodebuild could not be started"); os_write_state(id, m[..]); return 1; }
  line: [65536] u8; chunk: [262144] u8; cn := 0; flushed := proc_now_ms();
  logbuf: [4194304] u8; ln := 0;   // the last 4 MB, for the errors
  while true {
    k := proc_line(p, 1000, line[..]);
    if k == PROC_TIMEOUT { continue; }
    if k == PROC_EOF || k == PROC_ERROR { break; }
    if k < 0 { continue; }
    // written out at least each second, so build_status and the person see it move
    if cn + k + 1 > chunk.count || (cn > 0 && proc_now_ms() - flushed > 1000) { _ = fs_append(logp, cast(string) chunk[0..<cn]); cn = 0; flushed = proc_now_ms(); }
    cn = sh_put(chunk[..], cn, cast(string) line[0..<k]); cn = sh_put(chunk[..], cn, "\n");
    if ln + k + 1 > logbuf.count { ln = 0; }
    ln = sh_put(logbuf[..], ln, cast(string) line[0..<k]); ln = sh_put(logbuf[..], ln, "\n");
  }
  if cn > 0 { _ = fs_append(logp, cast(string) chunk[0..<cn]); }
  status := proc_wait(p, 60000); _ = proc_release(p);
  elapsed := (proc_now_ms() - t0) / 1000;
  os_state(id, ifx status == 0 then "succeeded" else "failed", elapsed, m[..]);
  _ = sb_errors(cast(string) logbuf[0..<ln], m[..]);
  if status == 0 {
    // the built .app: the first under Build/Products/CONF-iphonesimulator
    conf := args_value(a, "--configuration", "Debug");
    pd: [OS_PATH] u8; pn := sh_put(pd[..], 0, cast(string) dd[..]);
    pn = sh_put(pd[..], 0, sd_cstr(dd[..])); pn = sh_put(pd[..], pn, "/Build/Products/"); pn = sh_put(pd[..], pn, conf); pn = sh_put(pd[..], pn, "-iphonesimulator");
    l: [1] FsList;
    if fs_list(cast(string) pd[0..<pn], l[..]) > 0 {
      for i: 0..<l[0].n {
        e := fs_entry(l[..], i);
        if e.count > 4 && e[e.count - 4..<e.count] == ".app" { ab: [OS_PATH] u8; _ = sw_set_str(m[..], SW_F_APP_PATH, fs_join(cast(string) pd[0..<pn], e, ab[..])); break; }
      }
    }
  }
  os_write_state(id, m[..]);
  return ifx status == 0 then 0 else 1;
}
// A NUL-ended (or full) buffer as a string.
sd_cstr :: (b: [] u8) -> string { n := 0; while n < b.count && b[n] != 0 { n += 1; } return cast(string) b[0..<n]; }
// oasim build: checks the arguments, starts the worker detached, prints the build's id.
os_build :: (a: [] Args) -> int {
  c: [1] SbArgv; dd: [OS_PATH] u8;
  why := os_build_args(a, c[..], dd[..]);
  if why.count > 0 { return os_print_error("bad_args", why); }
  bb: [OS_PATH] u8; dir := os_builds(bb[..]);
  hb: [OS_PATH] u8; home := os_home(hb[..]);
  if !fs_exists(home) { _ = fs_mkdir_private(home); }
  if !fs_exists(dir) { _ = fs_mkdir(dir); }
  ib: [32] u8; ip := sh_put(ib[..], 0, "b"); nb: [24] u8; ip = sh_put(ib[..], ip, sh_int(proc_now_ms(), nb[..]));
  id := cast(string) ib[0..<ip];
  m: [1] SwMsg; os_state(id, "running", 0, m[..]); os_write_state(id, m[..]);
  me: [OS_PATH] u8; k := cxproc_self_path(me[..]);
  p := proc_new();
  ok := p >= 0 && k > 0 && proc_arg(p, cast(string) me[0..<k]) && proc_arg(p, "build-worker") && proc_arg(p, id);
  for i: 1..<args_count(a) { ok = ok && proc_arg(p, args_at(a, i)); }
  ok = ok && proc_detach(p) && proc_start(p) == 0;
  if p >= 0 { _ = proc_release(p); }
  if !ok { return os_print_error("helper_down", "the build could not be started"); }
  sw_reply_ok(m[..], 0); _ = sw_set_str(m[..], SW_F_BUILD, id);
  out: [1024] u8; n := sw_write(m[..], out[..]); os_outln(cast(string) out[0..<n]);
  return 0;
}
// oasim build_status ID: the state line, with the time so far while it runs.
os_build_status :: (id: string, quiet: bool, m: [] SwMsg) -> int {
  sb: [OS_PATH] u8; path := os_build_file(id, ".state", sb[..]);
  line: [SW_LINE] u8; n := fs_read(path, line[..]);
  why: [1] SwText;
  if id.count == 0 || sd_find(id, "/", 0) >= 0 || n <= 0 || !sw_read(cast(string) line[0..<n], m, why[..]) { if !quiet { _ = os_print_error("bad_args", "no build with that id"); } return 1; }
  if sw_str(m, SW_F_STATE) == "running" {
    // the id is the monotonic clock (ms) when the build began
    born := 0; for c: id[1..<id.count] { if c >= '0' && c <= '9' { born = born * 10 + cast(int) (c - '0'); } }
    if born > 0 && proc_now_ms() >= born { sw_set_int(m, SW_F_ELAPSED, (proc_now_ms() - born) / 1000); }
  }
  if !quiet { k := sw_write(m, line[..]); os_outln(cast(string) line[0..<k]); }
  return ifx sw_str(m, SW_F_STATE) == "failed" then 1 else 0;
}

// oasim run: build in place, then launch the .app, then a screenshot.
os_run :: (a: [] Args) -> int {
  ib: [32] u8; ip := sh_put(ib[..], 0, "r"); nb: [24] u8; ip = sh_put(ib[..], ip, sh_int(proc_now_ms(), nb[..]));
  id := cast(string) ib[0..<ip];
  bb: [OS_PATH] u8; dir := os_builds(bb[..]); hb: [OS_PATH] u8; home := os_home(hb[..]);
  if !fs_exists(home) { _ = fs_mkdir_private(home); }
  if !fs_exists(dir) { _ = fs_mkdir(dir); }
  _ = os_build_worker(id, a);
  m: [1] SwMsg;
  if os_build_status(id, true, m[..]) != 0 || !sw_has(m[..], SW_F_APP_PATH) { _ = os_build_status(id, false, m[..]); return 1; }
  app: [OS_PATH] u8; an := sh_put(app[..], 0, sw_str(m[..], SW_F_APP_PATH));
  l: [1] SwMsg; sw_clear(l[..]); _ = sw_set_str(l[..], SW_F_OP, "launch"); _ = sw_set_str(l[..], SW_F_APP_PATH, cast(string) app[0..<an]);
  dev := args_value(a, "--device", ""); if dev.count > 0 { _ = sw_set_str(l[..], SW_F_DEVICE, dev); }
  out: [SW_LINE] u8;
  if os_call(l[..], 120000, out[..]) != 0 { return 1; }
  proc_sleep(1500);
  s: [1] Args; _ = args_add(s[..], "screenshot");
  if dev.count > 0 { _ = args_add(s[..], "--device"); _ = args_add(s[..], dev); }
  r: [1] SwMsg; _ = os_request("screenshot", s[..], r[..]);
  return os_call(r[..], 60000, out[..]);
}

os_usage :: () -> int {
  tool_errln("usage: oasim list | boot DEVICE | shutdown [DEVICE] | attach | screenshot [--out PATH] [--scale S] | tap X Y | swipe X Y X2 Y2");
  tool_errln("       | touch_path JSON | touch2_path JSON | text TEXT | press_key KEY [--count N] | button NAME | set_appearance light|dark");
  tool_errln("       | appearance | set_keyboard show|hide | rotate left|right | open_url URL | launch [--app PATH] [--bundle ID] | install APP");
  tool_errln("       | terminate BUNDLE | describe | logs | build (--project P|--workspace W) --scheme S | build_status ID | run ... | serve | status | quit");
  tool_errln("       every verb takes --device NAME|UDID; replies are one JSON object (docs/desktop/ios-simulator-spec.md)");
  return 2;
}
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) < 1 { return os_usage(); }
  verb := args_at(a[..], 0);
  if verb == "serve" {
    hb: [OS_PATH] u8; home := args_value(a[..], "--home", os_home(hb[..]));
    sb: [OS_PATH] u8; sock := args_value(a[..], "--socket", os_sock(home, sb[..]));
    host: [1] ShHost;
    why := sh_start(host[..], home, sock, cxproc_self_pid());
    if why.count > 0 { tool_errln(why); return 1; }
    return sh_serve(host[..]);
  }
  if verb == "build" { return os_build(a[..]); }
  if verb == "build-worker" { return os_build_worker(args_at(a[..], 1), a[..]); }
  if verb == "build_status" { m: [1] SwMsg; return os_build_status(args_at(a[..], 1), false, m[..]); }
  if verb == "run" { return os_run(a[..]); }
  if verb == "help" || verb == "--help" { _ = os_usage(); return 0; }
  m: [1] SwMsg;
  why := os_request(verb, a[..], m[..]);
  if why == "unknown verb" { return os_usage(); }
  if why.count > 0 { return os_print_error("bad_args", why); }
  out: [SW_LINE] u8;
  wait := ifx verb == "boot" then 240000 else 150000;
  return os_call(m[..], wait, out[..]);
}
