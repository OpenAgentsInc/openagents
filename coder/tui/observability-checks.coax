#load "coder.coax";
#run_steps 1000000;
main :: () {}

#test "Microcoder attempts reach the durable event writer with engine and presence" {
  a:[1]App;logs:[1]CsLog;a[0].log=logs[..];a[0].running=true;a[0].engine=ENGINE_MICRO;
  buf:[4096]u8;a[0].mcw[0].ar[0].buf=buf[..];
  line:="{\"kind\":\"attempt\",\"schema\":\"coder.observability.v2\",\"gateway\":\"vertex\",\"model\":\"test\",\"outcome\":\"done\",\"status\":200,\"input_tokens\":12,\"output_tokens\":2,\"cached_tokens\":0,\"usd_micros\":3,\"card_estimate_usd_micros\":3}";
  cd_micro_line(a[..],line);
  s:=cast(string)logs[0].line[..];
  #assert cd_holds(s,"\"engine\":\"micro\"") && cd_holds(s,"\"input_tokens\":12");
  #assert cd_holds(s,"\"cached_tokens\":0") && cd_holds(s,"\"provider_cost_usd_micros\":null");
  #assert a[0].cost>0.0;
  a[0].engine=ENGINE_PSIONIC;cd_micro_line(a[..],line);
  #assert cd_holds(cast(string)logs[0].line[..],"\"engine\":\"psionic\"");
}

#test "routing uses only eligible defaults and explains low confidence" {
  r: [1] AgRoute; r[0].eligible = 2;
  #assert cd_route_pick(r[..]) == ENGINE_CODEX;
  r[0].eligible = 0; #assert cd_route_pick(r[..]) == -1;
  r[0].eligible = 4; r[0].ok = true; r[0].probability = 0.1;
  r[0].nengine = cd_cat(r[0].engine[..], 0, "micro");
  a: [1] App; a[0].engine = ENGINE_MICRO; b: [1024] u8;
  #assert cd_holds(cd_route_line(a[..], r[..], b[..]), "low-confidence decision");
}

#test "automatic profiles own their model bytes and preserve explicit model and effort overrides" {
  a:[1]App; r:[1]AgRoute;
  r[0].eligible=3;r[0].ok=true;r[0].probability=0.9;
  r[0].nengine=cd_cat(r[0].engine[..],0,"claude");r[0].nmodel=cd_cat(r[0].model[..],0,"opus");
  r[0].neffort=cd_cat(r[0].effort[..],0,"high");
  cd_route_apply(a[..],r[..],false);
  r[0].model[0]='x';
  #assert a[0].engine==ENGINE_CLAUDE && a[0].model=="opus" && cd_effort(a[..])=="high";
  a[0].model="explicit";a[0].neffort=cd_cat(a[0].effort_b[..],0,"low");
  cd_route_apply(a[..],r[..],true);
  #assert a[0].model=="explicit" && cd_effort(a[..])=="low";
  a[0].model="";r[0].probability=0.1;cd_route_apply(a[..],r[..],false);
  #assert a[0].model=="";
}

#test "Elephant route v2 is distinct from the unchanged legacy route record" {
  r:[1]AgRoute; b:[2048]u8;
  #assert !cd_holds(agr_json(r[..],"",b[..]),"schema");
  r[0].nsource=cd_cat(r[0].source[..],0,"local-elephant");
  r[0].nwhy=cd_cat(r[0].why[..],0,"unavailable");
  line:=agr_json(r[..],"codex",b[..]);
  #assert cd_holds(line,"\"schema\":\"coder.route.v2\"") && cd_holds(line,"\"ran\":\"codex\"") && cd_holds(line,"unavailable");
}

#test "live stdout emits safe suffixes while durable replies remain canonical" {
  l:[1]CsLog;out:[262144]u8;ab:[65536]u8;ar:[1]ClArena;ar[0].buf=ab[..];
  cs_secret_add(l[..],"TOKEN-12345");
  l[0].nreply=cd_cat(l[0].reply[..],0,"hello TOK");
  line:=cs_live_line(l[..],false,out[..]);
  #assert cl_str(ar[..],line,"text")=="hello " && cd_holds(line,"coder.reply-stream.v1");
  l[0].nreply=cd_cat(l[0].reply[..],l[0].nreply,"EN-12345");
  line=cs_live_line(l[..],false,out[..]);
  #assert cl_str(ar[..],line,"text")=="[credential]" && !cd_holds(line,"TOKEN");
  #assert cs_live_line(l[..],false,out[..])=="";
  l[0].nreply=cd_cat(l[0].reply[..],l[0].nreply," world");
  line=cs_live_line(l[..],true,out[..]);#assert cl_str(ar[..],line,"text")==" world";
  a:[1]App;a[0].log=l[..];cs_reply_flush(a[..]);
  #assert cd_holds(cast(string)l[0].line[..],"\"kind\":\"reply\"") && !cd_holds(cast(string)l[0].line[..],"reply_delta");
  #assert l[0].live_sent==0 && l[0].live_segment==1;
}
#test "live records bound escaping and preserve multibyte chunk boundaries" {
  l:[1]CsLog;out:[65536]u8;ab:[65536]u8;ar:[1]ClArena;ar[0].buf=ab[..];
  for i:0..<8191 {l[0].reply[i]='x';}l[0].nreply=cd_cat(l[0].reply[..],8191,"é!");
  line:=cs_live_line(l[..],false,out[..]);#assert cl_str(ar[..],line,"text").count==8191;
  line=cs_live_line(l[..],false,out[..]);#assert cl_str(ar[..],line,"text")=="é!";
  l[0].live_sent=0;l[0].nreply=8193;for i:0..<8193 {l[0].reply[i]=0;}
  line=cs_live_line(l[..],false,out[..]);#assert line.count<65536 && json_valid(line) && l[0].live_sent==8192;
  line=cs_live_line(l[..],false,out[..]);#assert json_valid(line) && l[0].live_sent==8193;
}

#test "an unfinished durable turn has unknown effects even after a tool result" {
  s: [1] CsSummary; ar: [1] ClArena; ab: [8192] u8; ar[0].buf = ab[..]; b: [4096] u8;
  cs_read("{\"kind\":\"session\",\"id\":\"x\"}\n{\"kind\":\"user\",\"text\":\"edit\"}\n{\"kind\":\"tool\",\"label\":\"Write(file)\"}\n{\"kind\":\"result\",\"text\":\"done\",\"error\":false}\n", s[..], ar[..]);
  #assert cd_holds(cd_summary_line("x", s[..], true, b[..]), "\"effect_outcome\":\"unknown\"");
}

#test "Codex tool starts persist before their results" {
  a: [1] App; logs: [1] CsLog; a[0].log = logs[..]; a[0].plain = true; a[0].cols = 100;
  c: [1] CxClient; line: [4096] u8; arena: [4096] u8; out: [8192] u8;
  cx_init(c[..], line[..], arena[..], out[..]); a[0].cx = c[..];
  cd_codex_started(a[..], "{\"type\":\"commandExecution\",\"command\":\"pwd\"}");
  #assert a[0].steps == 1;
  #assert cd_holds(cast(string) a[0].log[0].line[..], "\"kind\":\"tool\"");
  #assert cd_holds(cast(string) a[0].log[0].line[..], "Bash(pwd)");
  cd_codex_completed(a[..], "{\"type\":\"commandExecution\",\"status\":\"completed\",\"exitCode\":0,\"aggregatedOutput\":\"/tmp\"}");
  #assert cd_holds(cast(string) a[0].log[0].line[..], "\"kind\":\"result\"");
}
#test "usage snapshots preserve unknowns and are never summed" {
  a: [1] App; logs: [1] CsLog; a[0].log = logs[..];
  cs_cx_usage(a[..], "{\"total\":{\"inputTokens\":100,\"cachedInputTokens\":20,\"outputTokens\":7,\"reasoningOutputTokens\":3}}");
  s := cast(string) a[0].log[0].line[..];
  #assert cd_holds(s, "\"inputTokens\":100");
  #assert cd_holds(s, "\"cachedInputTokens\":20");
  #assert cd_holds(s, "\"totalTokens\":null");
  #assert cd_holds(s, "\"scope\":\"thread_total\"");
  cs_cx_usage(a[..], "{\"total\":{\"inputTokens\":110,\"outputTokens\":-1}}");
  s = cast(string) a[0].log[0].line[..];
  #assert cd_holds(s, "\"inputTokens\":110");
  #assert cd_holds(s, "\"outputTokens\":null");
}
#test "resolved model metadata owns actual values and leaves unobserved cost null" {
  a: [1] App; logs: [1] CsLog; a[0].log = logs[..]; ar: [1] ClArena; b: [4096] u8; ar[0].buf = b[..];
  ccx_resolved(a[0].cx_options[..], ar[..], "{\"model\":\"test-model\",\"reasoningEffort\":\"high\"}");
  cs_cx_model(a[..]);
  s := cast(string) a[0].log[0].line[..];
  #assert cd_holds(s, "\"model\":\"test-model\"");
  #assert cd_holds(s, "\"effort\":\"high\"");
  #assert cd_holds(s, "\"cost_usd\":null");
}
