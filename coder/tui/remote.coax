// Coder on another machine (Coder book chapter 23): --on ssh:DEST runs a
// verb with Coder on that machine over ssh, --on cloud runs it on a host
// of the GCE pool (`openagents cloud`), reached as user coder through an IAP
// tunnel with the pool's key, and --on boat:ID runs it on a boat dev box
// (#13474): resumed under the dev box policy when a run or fork finds it
// stopped, its SSH entry (Host boat-ID) rewritten after every resume, its
// checkout ~/oa, and from there the ssh: route. The remote machine's own checkout runs the
// verb (--remote-repo DIR, default ~/openagents), so its sessions stay there.
// A session started this way leaves a record here, sessions/ID.remote, and
// status, log, stop, attach and replay of that ID go back to its machine.
//
//   coder run "TASK" --on ssh:coderos-4080 --engine echo
//   coder ls --on ssh:coderos-4080
//   coder run "TASK" --on boat:bx_fwh3xnws --engine claude
//   coder log ID                      (the record says where ID lives)

CD_REMOTE_REPO :: "~/openagents";
CD_BOAT_REPO :: "~/oa";                                 // the dev box template's checkout (docs/cloud/boat-devbox.md)
CD_POOL_KEY :: "/.openagents/cloud/pool_ed25519";      // under $HOME
CD_REMOTE_LINE :: 1048576;

CdRoute2 :: struct {
  ok: bool;
  ssh: bool; cloud: bool;
  boat: bool;                           // ssh to a boat box, by its alias boat-ID
  box: [16] u8; nbox: int;              // the box's id
  task: [512] u8; ntask: int;           // a boat session's task and engine, recorded for the chat's list
  engine: [32] u8; nengine: int;
  dest: [256] u8; ndest: int;           // ssh destination, or the pool host's name
  zone: [64] u8; nzone: int;
  project: [64] u8; nproject: int;
  config: [1024] u8; nconfig: int;      // the pool's CLOUDSDK_CONFIG
  repo: [512] u8; nrepo: int;
  why: [512] u8; nwhy: int;
}

cd_r2_s :: (b: [] u8, n: int) -> string { return cast(string) b[0..<n]; }
cd_r2_fail :: (r: [] CdRoute2, why: string) -> bool { r[0].ok = false; r[0].nwhy = cd_cat(r[0].why[..], 0, why); return false; }

// Characters a destination, zone, project or repo may hold, so they go into a shell line unquoted.
cd_r2_plain :: (s: string) -> bool {
  if s.count == 0 { return false; }
  for c: s { if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '/' || c == '~' || c == '@') { return false; } }
  return true;
}

// 'text' for a shell, with ' as '\''.
cd_r2_quote :: (out: [] u8, n0: int, s: string) -> int {
  n := cd_cat(out, n0, "'");
  for c: s { if c == '\'' { n = cd_cat(out, n, "'\\''"); } else if n < out.count { out[n] = c; n += 1; } }
  return cd_cat(out, n, "'");
}

// --on local or mac is this machine.
cd_on_local :: (on: string) -> bool { return on.count == 0 || on == "local" || on == "mac"; }

// The route for --on: ssh:DEST, or cloud (a pool host, started when there is none and start is set).
cd_r2_route :: (on: string, repo: string, start: bool, r: [] CdRoute2) -> bool {
  r[0] = CdRoute2.{};
  rp := ifx repo.count > 0 then repo else CD_REMOTE_REPO;
  if !cd_r2_plain(rp) { return cd_r2_fail(r, "--remote-repo takes a plain path"); }
  r[0].nrepo = cd_cat(r[0].repo[..], 0, rp);
  if on.count > 4 && cast(string) on[0..<4] == "ssh:" {
    d := cast(string) on[4..<on.count];
    if !cd_r2_plain(d) || d[0] == '-' { return cd_r2_fail(r, "--on ssh:DEST takes a plain ssh destination"); }
    r[0].ssh = true; r[0].ndest = cd_cat(r[0].dest[..], 0, d); r[0].ok = true;
    return true;
  }
  if on.count > 5 && cast(string) on[0..<5] == "boat:" {
    if repo.count == 0 { r[0].nrepo = cd_cat(r[0].repo[..], 0, CD_BOAT_REPO); }
    return cd_r2_boat(r, cast(string) on[5..<on.count], start);
  }
  if on != "cloud" { return cd_r2_fail(r, "--on is local, ssh:DEST, boat:ID or cloud"); }
  r[0].cloud = true;
  return cd_r2_pool_host(r, start);
}

// A boat box as an ssh route: up (resumed under the policy when start is
// set and it is stopped), its SSH entry fresh, then ssh to boat-ID.
cd_r2_boat :: (r: [] CdRoute2, id: string, start: bool) -> bool {
  if !bt_id_ok(id) { return cd_r2_fail(r, "--on boat:ID takes a box id (bx_...): coax/web/tool.sh boat ls"); }
  r[0].boat = true; r[0].ssh = true;
  r[0].nbox = cd_cat(r[0].box[..], 0, id);
  ab: [32] u8; r[0].ndest = cd_cat(r[0].dest[..], 0, bt_ssh_alias(ab[..], id));
  return cd_r2_boat_fresh(r, start);
}

// The box of a boat route up and its SSH entry rewritten; false (with why) when it can't be.
cd_r2_boat_fresh :: (r: [] CdRoute2, start: bool) -> bool {
  id := cd_r2_s(r[0].box[..], r[0].nbox);
  bb: [512] u8; kb: [512] u8;
  c := bt_local_client(bb[..], kb[..]);
  lb: [262144] u8; ob: [262144] u8; arb: [65536] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = arb[..]};
  u := bt_bring_up(c, id, start, 0, lb[..], ob[..], ar[..]);
  if u.refused != BP_OK { return cd_r2_fail(r, bp_words(u.refused)); }
  if bt_failed(u.error) {
    wb: [512] u8; w := cd_cat(wb[..], 0, "boat: "); w = cd_cat(wb[..], w, bt_kind_name(u.error.kind));
    if u.error.code.count > 0 { w = cd_cat(wb[..], w, " "); w = cd_cat(wb[..], w, u.error.code); }
    if u.error.why.count > 0 { w = cd_cat(wb[..], w, ": "); w = cd_cat(wb[..], w, u.error.why); }
    return cd_r2_fail(r, cast(string) wb[0..<w]);
  }
  if u.resumed { tool_err("coder: resumed "); tool_errln(id); }
  ar[0].at = 0;
  why := bt_ssh_refresh(c, id, ob[..], ar[..]);
  if why.count > 0 { return cd_r2_fail(r, why); }
  r[0].ok = true;
  return true;
}

// The pool's first running host, from `openagents --json cloud status`; with
// start, `openagents cloud up --hosts 1` first when there is none.
cd_r2_pool_host :: (r: [] CdRoute2, start: bool) -> bool {
  for attempt: 0..<2 {
    argv := [4] string.["openagents", "--json", "cloud", "status"];
    none: [1] string;
    ob: [262144] u8; ok: [1] bool;
    text := rt_run_in(argv[..], none[0..<0], "", 120, ob[..], ok[..]);
    if !ok[0] || text.count == 0 { return cd_r2_fail(r, "openagents cloud status failed: is the openagents CLI installed and the pool granted (openagents cloud up)?"); }
    ab: [65536] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
    hosts := cl_raw(text, "hosts");
    for i: 0..<cl_count(hosts) {
      h := cl_json(hosts, cl_item(hosts, i));
      name := cl_str(ar[..], h, "name"); if name.count == 0 { name = cl_str(ar[..], h, "instance"); }
      zone := cl_str(ar[..], h, "zone");
      if name.count == 0 || zone.count == 0 || !cd_r2_plain(name) || !cd_r2_plain(zone) { continue; }
      st := cl_str(ar[..], h, "status");
      if st.count > 0 && st != "RUNNING" && st != "running" && st != "ready" { continue; }
      r[0].ndest = cd_cat(r[0].dest[..], 0, name); r[0].nzone = cd_cat(r[0].zone[..], 0, zone);
      pj := cl_str(ar[..], text, "pool.project"); r[0].nproject = cd_cat(r[0].project[..], 0, ifx pj.count > 0 then pj else "openagentsgemini");
      cf := cl_str(ar[..], text, "pool.gcloud_config"); r[0].nconfig = cd_cat(r[0].config[..], 0, cf);
      r[0].ok = true;
      return true;
    }
    if !start || attempt == 1 { return cd_r2_fail(r, "the pool has no running host: start one with openagents cloud up --hosts 1"); }
    tool_errln("coder: starting a pool host (openagents cloud up --hosts 1); it deletes itself after its idle minutes");
    up := [5] string.["openagents", "cloud", "up", "--hosts", "1"];
    ub: [65536] u8; uok: [1] bool;
    out := rt_run_in(up[..], none[0..<0], "", 1200, ub[..], uok[..]);
    if !uok[0] { tool_errln(out); return cd_r2_fail(r, "openagents cloud up failed"); }
  }
  return false;
}

// The command line run on the remote machine: cd REPO && coder.sh ARGS.
cd_r2_line :: (r: [] CdRoute2, args: [] string, out: [] u8) -> string {
  repo := cd_r2_s(r[0].repo[..], r[0].nrepo);
  n := cd_cat(out, 0, "cd ");
  if repo.count >= 2 && repo[0] == '~' && repo[1] == '/' { n = cd_cat(out, n, "\"$HOME\"/"); n = cd_cat(out, n, cast(string) repo[2..<repo.count]); }
  else { n = cd_cat(out, n, repo); }
  n = cd_cat(out, n, " && BROWSER=/usr/bin/true coder/tui/coder.sh");
  for a: args { n = cd_cat(out, n, " "); n = cd_r2_quote(out, n, a); }
  return cast(string) out[0..<n];
}

// ssh's argv for the route and one remote command line.
cd_r2_argv :: (r: [] CdRoute2, line: string, argv: [] string, bufs: [] [1200] u8) -> int {
  n := 0;
  argv[n] = "ssh"; n += 1;
  argv[n] = "-o"; argv[n + 1] = "BatchMode=yes"; n += 2;
  argv[n] = "-o"; argv[n + 1] = "ConnectTimeout=20"; n += 2;
  if r[0].ssh { argv[n] = cd_r2_s(r[0].dest[..], r[0].ndest); n += 1; argv[n] = line; return n + 1; }
  // a pool host: user coder, the pool's key, IAP as the proxy, a host key that is new each time
  hb: [1024] u8; home := cl_getenv("HOME", hb[..]);
  k := cd_cat(bufs[0][..], cd_cat(bufs[0][..], 0, home), CD_POOL_KEY);
  argv[n] = "-i"; argv[n + 1] = cast(string) bufs[0][0..<k]; n += 2;
  argv[n] = "-o"; argv[n + 1] = "StrictHostKeyChecking=no"; n += 2;
  argv[n] = "-o"; argv[n + 1] = "UserKnownHostsFile=/dev/null"; n += 2;
  argv[n] = "-o"; argv[n + 1] = "LogLevel=ERROR"; n += 2;
  p := cd_cat(bufs[1][..], 0, "ProxyCommand=env");
  if r[0].nconfig > 0 { p = cd_cat(bufs[1][..], p, " CLOUDSDK_CONFIG="); p = cd_cat(bufs[1][..], p, cd_r2_s(r[0].config[..], r[0].nconfig)); }
  p = cd_cat(bufs[1][..], p, " gcloud compute start-iap-tunnel "); p = cd_cat(bufs[1][..], p, cd_r2_s(r[0].dest[..], r[0].ndest));
  p = cd_cat(bufs[1][..], p, " 22 --listen-on-stdin --zone "); p = cd_cat(bufs[1][..], p, cd_r2_s(r[0].zone[..], r[0].nzone));
  p = cd_cat(bufs[1][..], p, " --project "); p = cd_cat(bufs[1][..], p, cd_r2_s(r[0].project[..], r[0].nproject));
  p = cd_cat(bufs[1][..], p, " --verbosity=error");
  argv[n] = "-o"; argv[n + 1] = cast(string) bufs[1][0..<p]; n += 2;
  d := cd_cat(bufs[2][..], cd_cat(bufs[2][..], 0, "coder@"), cd_r2_s(r[0].dest[..], r[0].ndest));
  argv[n] = cast(string) bufs[2][0..<d]; n += 1;
  argv[n] = line; return n + 1;
}

// A session ID in one line of a remote verb's output, or "".
cd_r2_session_of :: (line: string, ar: [] ClArena) -> string {
  if line.count > 0 && line[0] == '{' {
    r: [1] SlReader; r[0] = SlReader.{text = line}; l: [1] SlLine;
    if sl_next(r[..], l[..]) {
      sl_read(ar, l[..]);
      if l[0].kind == SK_SESSION { return l[0].header.id; }
      if l[0].name.count > 0 { return ""; }
    }
    return cl_str(ar, line, "id");     // not a log line: `coder status --json`'s object, which names its session
  }
  t := line; while t.count > 0 && t[0] == ' ' { t = cast(string) t[1..<t.count]; }
  if t.count > 8 && cast(string) t[0..<8] == "session " { t = cast(string) t[8..<t.count]; }
  if t.count != 19 || t[8] != '-' || t[15] != '-' { return ""; }
  for c, i: t { if i != 8 && i != 15 && (c < '0' || c > '9') { return ""; } }
  return t;
}

// Runs args with Coder on the route's machine, its output relayed line by
// line; the exit status. sid gets the session it started, if any.
cd_r2_run :: (r: [] CdRoute2, args: [] string, sid: [] u8) -> int {
  lb: [16384] u8; line := cd_r2_line(r, args, lb[..]);
  argv: [32] string; bufs: [3] [1200] u8;
  na := cd_r2_argv(r, line, argv[..], bufs[..]);
  h := cxproc_new();
  if h < 0 { tool_errln("coder: no process slot is free"); return 1; }
  ok := true;
  for i: 0..<na { ok = ok && cl_push(h, CL_FIELD_ARG, argv[i]); }
  if !ok || cxproc_spawn(h) != 0 { x := cxproc_release(h); tool_errln("coder: ssh could not start"); return 1; }
  c := cxproc_close_stdin(h);
  for i: 0..<sid.count { sid[i] = 0; }
  ab: [65536] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  buf: [CD_REMOTE_LINE] u8;
  for guard: 0..<100000000 {
    m := cxproc_read_line(h, 1000);
    if m == CL_TIMEOUT { continue; }
    if m == CL_TOO_LONG { continue; }
    if m < 0 { break; }
    k := ifx m > buf.count then buf.count else m;
    for i: 0..<k { buf[i] = cast,trunc(u8) cxproc_line_byte(h, i); }
    text := cast(string) buf[0..<k];
    cd_outln(text);
    ar[0].at = 0; ar[0].full = false;
    if sid[0] == 0 { s := cd_r2_session_of(text, ar[..]); if s.count > 0 { e := cd_cat(sid, 0, s); } }
  }
  st := cxproc_wait(h, 30000);
  eb: [8192] u8; en := 0;
  sc := cxproc_stderr_count(h);
  for i: 0..<sc { if en < eb.count { eb[en] = cast,trunc(u8) cxproc_stderr_byte(h, i); en += 1; } }
  x := cxproc_release(h);
  if en > 0 { tool_err(cast(string) eb[0..<en]); }
  return ifx st < 0 then 1 else st;
}

// The route as one JSON object (with id when it is not ""); its length, or < 0.
cd_r2_json :: (r: [] CdRoute2, id: string, o: [] u8) -> int {
  n := json_raw(o, 0, "{");
  if id.count > 0 { n = json_raw(o, n, "\"id\":"); n = json_write_string(o, n, id); n = json_raw(o, n, ","); }
  n = json_raw(o, n, ifx r[0].boat then "\"on\":\"boat\"" else ifx r[0].ssh then "\"on\":\"ssh\"" else "\"on\":\"cloud\"");
  if r[0].boat { n = json_raw(o, n, ",\"box\":"); n = json_write_string(o, n, cd_r2_s(r[0].box[..], r[0].nbox)); }
  if r[0].ntask > 0 { n = json_raw(o, n, ",\"task\":"); n = json_write_string(o, n, cd_r2_s(r[0].task[..], r[0].ntask)); }
  if r[0].nengine > 0 { n = json_raw(o, n, ",\"engine\":"); n = json_write_string(o, n, cd_r2_s(r[0].engine[..], r[0].nengine)); }
  n = json_raw(o, n, ",\"dest\":"); n = json_write_string(o, n, cd_r2_s(r[0].dest[..], r[0].ndest));
  n = json_raw(o, n, ",\"repo\":"); n = json_write_string(o, n, cd_r2_s(r[0].repo[..], r[0].nrepo));
  if r[0].cloud {
    n = json_raw(o, n, ",\"zone\":"); n = json_write_string(o, n, cd_r2_s(r[0].zone[..], r[0].nzone));
    n = json_raw(o, n, ",\"project\":"); n = json_write_string(o, n, cd_r2_s(r[0].project[..], r[0].nproject));
    n = json_raw(o, n, ",\"config\":"); n = json_write_string(o, n, cd_r2_s(r[0].config[..], r[0].nconfig));
  }
  return json_raw(o, n, "}");
}

// A route read back from cd_r2_json's object; false when it is not one.
cd_r2_parse :: (rec: string, r: [] CdRoute2) -> bool {
  r[0] = CdRoute2.{};
  ab: [8192] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  on := cl_str(ar[..], rec, "on");
  r[0].boat = on == "boat";
  r[0].ssh = on == "ssh" || r[0].boat; r[0].cloud = on == "cloud";
  r[0].nbox = cd_cat(r[0].box[..], 0, cl_str(ar[..], rec, "box"));
  if r[0].boat && !bt_id_ok(cd_r2_s(r[0].box[..], r[0].nbox)) { return false; }
  r[0].ndest = cd_cat(r[0].dest[..], 0, cl_str(ar[..], rec, "dest"));
  r[0].nrepo = cd_cat(r[0].repo[..], 0, cl_str(ar[..], rec, "repo"));
  r[0].nzone = cd_cat(r[0].zone[..], 0, cl_str(ar[..], rec, "zone"));
  r[0].nproject = cd_cat(r[0].project[..], 0, cl_str(ar[..], rec, "project"));
  r[0].nconfig = cd_cat(r[0].config[..], 0, cl_str(ar[..], rec, "config"));
  r[0].ok = (r[0].ssh || r[0].cloud) && cd_r2_plain(cd_r2_s(r[0].dest[..], r[0].ndest)) && cd_r2_plain(cd_r2_s(r[0].repo[..], r[0].nrepo));
  if r[0].cloud { r[0].ok = r[0].ok && cd_r2_plain(cd_r2_s(r[0].zone[..], r[0].nzone)) && cd_r2_plain(cd_r2_s(r[0].project[..], r[0].nproject)); }
  return r[0].ok;
}

// sessions/ID.remote: where a session started with --on lives.
cd_r2_record :: (r: [] CdRoute2, id: string) -> bool {
  db: [1100] u8; dir := cs_dir(db[..]);
  if dir.count == 0 { return false; }
  o: [4096] u8;
  n := cd_r2_json(r, id, o[..]);
  if n < 0 { return false; }
  n = json_raw(o[..], n, "\n");
  pb: [1400] u8; pn := cd_cat(pb[..], cd_cat(pb[..], cd_cat(pb[..], 0, dir), "/"), id); pn = cd_cat(pb[..], pn, ".remote");
  return n > 0 && fs_write(cast(string) pb[0..<pn], cast(string) o[0..<n]);
}

// The route of a recorded remote session (an exact ID, or a prefix of one); false when there is none.
cd_r2_recorded :: (id: string, r: [] CdRoute2, full: [] u8) -> bool {
  r[0] = CdRoute2.{};
  if id.count == 0 { return false; }
  db: [1100] u8; dir := cs_dir(db[..]);
  if dir.count == 0 { return false; }
  l_b: [1] FsList; l := l_b[..];
  n := fs_list(dir, l);
  found := ""; count := 0;
  for i: 0..<n {
    name := fs_entry(l, i);
    if name.count < 8 || cast(string) name[name.count - 7..<name.count] != ".remote" { continue; }
    base := cast(string) name[0..<name.count - 7];
    if base.count >= id.count && cast(string) base[0..<id.count] == id { found = base; count += 1; if base == id { count = 1; break; } }
  }
  if count != 1 { return false; }
  fb: [4096] u8; pb: [1400] u8;
  pn := cd_cat(pb[..], cd_cat(pb[..], cd_cat(pb[..], 0, dir), "/"), found); pn = cd_cat(pb[..], pn, ".remote");
  k := fs_read(cast(string) pb[0..<pn], fb[..]);
  if k <= 0 { return false; }
  if !cd_r2_parse(cast(string) fb[0..<k], r) { return false; }
  e := cd_cat(full, 0, found); if e < full.count { full[e] = 0; }
  return true;
}

// The verb's arguments without --on and --remote-repo, for the remote Coder.
cd_r2_args :: (args: [] Args, out: [] string) -> int {
  n := 0; i := 0;
  while i < args_count(args) {
    v := args_at(args, i);
    if v == "--on" || v == "--remote-repo" { i += 2; continue; }
    if n < out.count { out[n] = v; n += 1; }
    i += 1;
  }
  return n;
}

// A verb run with --on ssh:DEST or cloud.
cd_cmd_on :: (args: [] Args, verb: string, on: string) -> int {
  r: [1] CdRoute2;
  if !cd_r2_route(on, args_value(args, "--remote-repo", ""), verb == "run" || verb == "fork", r[..]) {
    tool_err("coder: "); tool_errln(cd_r2_s(r[0].why[..], r[0].nwhy)); return 2;
  }
  a: [256] string; na := cd_r2_args(args, a[..]);
  sid: [64] u8;
  st := cd_r2_run(r[..], a[0..<na], sid[..]);
  k := 0; while k < sid.count && sid[k] != 0 { k += 1; }
  if r[0].boat {
    t := ifx verb == "fork" then args_at(args, 2) else ifx args_count(args) > 1 then args_at(args, 1) else "";
    r[0].ntask = cd_cat(r[0].task[..], 0, ifx t.count > 500 then cast(string) t[0..<500] else t);
    r[0].nengine = cd_cat(r[0].engine[..], 0, args_value(args, "--engine", "claude"));
  }
  if k > 0 && (verb == "run" || verb == "fork") { x := cd_r2_record(r[..], cast(string) sid[0..<k]); }
  if verb == "queue" && st == 255 { return dm_hold(r[..], a[0..<na], args_has(args, "--json")); }   // ssh could not reach it: the daemon here sends it later
  return st;
}

// status, log, stop, attach or replay of a session that lives on another machine; -1 when ID is local.
cd_cmd_remote_id :: (args: [] Args, id: string) -> int {
  r: [1] CdRoute2; full: [64] u8;
  if !cd_r2_recorded(id, r[..], full[..]) { return -1; }
  if r[0].boat && !cd_r2_boat_fresh(r[..], false) { tool_err("coder: "); tool_errln(cd_r2_s(r[0].why[..], r[0].nwhy)); return 1; }
  a: [256] string; na := cd_r2_args(args, a[..]);
  k := 0; while k < full.count && full[k] != 0 { k += 1; }
  for i: 0..<na { if a[i] == id { a[i] = cast(string) full[0..<k]; } }   // the remote's ID in full
  sid: [64] u8;
  return cd_r2_run(r[..], a[0..<na], sid[..]);
}

#test "remote: a route's command line quotes every argument; ssh destinations are plain" {
  r: [1] CdRoute2;
  #assert cd_r2_route("ssh:coderos-4080", "", false, r[..]);
  lb: [512] u8;
  a := [4] string.["run", "it's $HOME; rm -rf /", "--engine", "echo"];
  #assert cd_r2_line(r[..], a[..], lb[..]) == "cd \"$HOME\"/openagents && BROWSER=/usr/bin/true coder/tui/coder.sh 'run' 'it'\\''s $HOME; rm -rf /' '--engine' 'echo'";
  #assert !cd_r2_route("ssh:-oProxyCommand=x", "", false, r[..]);
  #assert !cd_r2_route("ssh:host;reboot", "", false, r[..]);
  #assert !cd_r2_route("mars", "", false, r[..]);
  #assert !cd_r2_route("boat:bx_nope", "", false, r[..]) && cd_r2_s(r[0].why[..], r[0].nwhy) == "--on boat:ID takes a box id (bx_...): coax/web/tool.sh boat ls";
  #assert !cd_r2_route("ssh:h", "/tmp/a b", false, r[..]);
  ab: [4096] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  #assert cd_r2_session_of("{\"kind\":\"session\",\"id\":\"20261102-073134-163\"}", ar[..]) == "20261102-073134-163";
  #assert cd_r2_session_of("20261102-073134-163", ar[..]) == "20261102-073134-163";
  #assert cd_r2_session_of("  session 20261102-073134-163", ar[..]) == "20261102-073134-163";
  #assert cd_r2_session_of("› $ echo hi", ar[..]) == "";
}

#test "remote: a boat route is recorded with its box and read back as ssh to boat-ID" {
  r: [1] CdRoute2; r[0] = CdRoute2.{};
  r[0].boat = true; r[0].ssh = true; r[0].ok = true;
  r[0].nbox = cd_cat(r[0].box[..], 0, "bx_fwh3xnws"); r[0].ndest = cd_cat(r[0].dest[..], 0, "boat-bx_fwh3xnws"); r[0].nrepo = cd_cat(r[0].repo[..], 0, CD_BOAT_REPO);
  o: [1024] u8; n := cd_r2_json(r[..], "20261113-160000-001", o[..]);
  rec := cast(string) o[0..<n];
  #assert rec == "{\"id\":\"20261113-160000-001\",\"on\":\"boat\",\"box\":\"bx_fwh3xnws\",\"dest\":\"boat-bx_fwh3xnws\",\"repo\":\"~/oa\"}";
  b: [1] CdRoute2;
  #assert cd_r2_parse(rec, b[..]) && b[0].boat && b[0].ssh && !b[0].cloud && cd_r2_s(b[0].box[..], b[0].nbox) == "bx_fwh3xnws" && cd_r2_s(b[0].dest[..], b[0].ndest) == "boat-bx_fwh3xnws";
  lb: [512] u8; a := [2] string.["ls", "--json"];
  #assert cd_r2_line(b[..], a[..], lb[..]) == "cd \"$HOME\"/oa && BROWSER=/usr/bin/true coder/tui/coder.sh 'ls' '--json'";
  #assert !cd_r2_parse("{\"on\":\"boat\",\"box\":\"bx_no\",\"dest\":\"boat-bx_no\",\"repo\":\"~/oa\"}", b[..]);
}
