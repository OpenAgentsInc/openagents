// Resizes Coder's terminal UI while a turn is working and checks the screen.
//
// Runs coder/tui/coder.sh on the offline echo engine in a real pseudo-terminal (120x30), runs
// "$ sleep 30" so the Working row shows, then narrows the terminal in steps (the pseudo-terminal's
// size, so Coder gets SIGWINCH) and widens it again. Coder's output feeds a small terminal model
// that reflows on a width change the way Ghostty (the Rex app's terminal), iTerm2, kitty and
// Terminal.app do: a line wider than the new width wraps onto more rows, the bottom of the screen
// stays put and rows pushed off the top go into the scrollback.
//
// After each resize the visible screen must hold one Working row, two rules, one composer and one
// footer, with the footer on the last row: no stale status rows, no rule fragments, no wrapped
// leftovers of the old rows.
//
//   coax/web/tool.sh coder/tui/resize_check.coax            prints the screens, exits 1 on a failure
//   coax/web/tool.sh coder/tui/resize_check.coax --quiet    only the verdicts
// RESIZE_RAW=PREFIX keeps Coder's bytes in PREFIX.early and PREFIX.full, for debugging.
#import "Basic";
#load "../../coax/lib/sys/tool.coax";
#load "../../coax/lib/sys/fs.coax";
#load "../../coax/lib/sys/args.coax";
#load "../../coax/lib/sys/proc.coax";

cxproc_pty :: (h: int, cols: int, rows: int) -> int #foreign #effects(all);
cxproc_pty_resize :: (h: int, cols: int, rows: int) -> int #foreign #effects(all);
cxproc_read_bytes :: (h: int, timeout_ms: int, out: [] u8) -> int #foreign #effects(all);
cxproc_self_path :: (out: [] u8) -> int #foreign #effects(all);
cxtool_out_flush :: () -> int #foreign #effects(all);

RC_COLS :: 128;          // cells a row holds at most (the widest terminal here is 120)
RC_ROWS :: 4096;         // rows the buffer keeps (screen and scrollback)
RC_LINE :: 8192;         // cells a rejoined line holds at most
RC_REST :: 4096;         // code points of an unfinished escape kept for the next read

// The reflowing terminal: rows of cells (a code point each, 0 an empty cell), a soft-wrap flag a
// row (the row continues on the next), the screen the last `rows` rows of the buffer.
Term :: struct {
  cols: int; rows: int;
  cells: [RC_ROWS * RC_COLS] int; len: [RC_ROWS] int; wrap: [RC_ROWS] bool; n: int;
  y: int; x: int; pending: bool;
  rest: [RC_REST] int; nrest: int;
  utf: [4] u8; nutf: int;
  // reflow's scratch
  line: [RC_LINE] int;
  nc: [RC_ROWS * RC_COLS] int; nl: [RC_ROWS] int; nw: [RC_ROWS] bool;
}

term_init :: (t: [] Term, cols: int, rows: int) {
  t[0].cols = cols; t[0].rows = rows; t[0].n = rows;
  for i: 0..<rows { t[0].len[i] = 0; t[0].wrap[i] = false; }
  t[0].y = 0; t[0].x = 0; t[0].pending = false; t[0].nrest = 0; t[0].nutf = 0;
}
top :: (t: [] Term) -> int { return t[0].n - t[0].rows; }
cell :: (t: [] Term, row: int, x: int) -> int { return ifx x < t[0].len[row] then t[0].cells[row * RC_COLS + x] else 0; }

// A new row at the bottom (the oldest is dropped when the buffer is full).
push_row :: (t: [] Term) {
  if t[0].n == RC_ROWS {
    for r: 1..<RC_ROWS { for x: 0..<t[0].len[r] { t[0].cells[(r - 1) * RC_COLS + x] = t[0].cells[r * RC_COLS + x]; } t[0].len[r - 1] = t[0].len[r]; t[0].wrap[r - 1] = t[0].wrap[r]; }
    t[0].n -= 1;
  }
  t[0].len[t[0].n] = 0; t[0].wrap[t[0].n] = false; t[0].n += 1;
}
line_feed :: (t: [] Term) {
  if t[0].y == t[0].rows - 1 { push_row(t); } else { t[0].y += 1; }
}
put :: (t: [] Term, ch: int) {
  if t[0].pending {
    t[0].wrap[top(t) + t[0].y] = true;
    line_feed(t); t[0].x = 0; t[0].pending = false;
  }
  r := top(t) + t[0].y;
  while t[0].len[r] <= t[0].x { t[0].cells[r * RC_COLS + t[0].len[r]] = 0; t[0].len[r] += 1; }
  t[0].cells[r * RC_COLS + t[0].x] = ch;
  if t[0].x == t[0].cols - 1 { t[0].pending = true; } else { t[0].x += 1; }
}
erase_right :: (t: [] Term, y: int, x: int) {
  r := top(t) + y;
  if t[0].len[r] > x { t[0].len[r] = x; }
  t[0].wrap[r] = false;
}

// A CSI sequence: its parameter code points and its final.
csi :: (t: [] Term, params: [] int, final: int) {
  if params.count > 0 && (params[0] == '?' || params[0] == '<' || params[0] == '>' || params[0] == '=') { return; }
  nums: [16] int; nn := 0;
  if params.count > 0 {
    v := 0; digits := true; any := false;
    for c: params {
      if c == ';' { if nn < 16 { nums[nn] = ifx digits && any then v else 0; nn += 1; } v = 0; digits = true; any = false; }
      else if c >= '0' && c <= '9' { v = v * 10 + (c - '0'); any = true; if v > 100000 { v = 100000; } }
      else { digits = false; }
    }
    if nn < 16 { nums[nn] = ifx digits && any then v else 0; nn += 1; }
  }
  n := ifx nn > 0 && nums[0] > 0 then nums[0] else 1;
  if final == 'A' { t[0].y = ifx t[0].y - n < 0 then 0 else t[0].y - n; t[0].pending = false; }
  else if final == 'B' { t[0].y = ifx t[0].y + n > t[0].rows - 1 then t[0].rows - 1 else t[0].y + n; t[0].pending = false; }
  else if final == 'C' { t[0].x = ifx t[0].x + n > t[0].cols - 1 then t[0].cols - 1 else t[0].x + n; t[0].pending = false; }
  else if final == 'D' { t[0].x = ifx t[0].x - n < 0 then 0 else t[0].x - n; t[0].pending = false; }
  else if final == 'H' || final == 'f' {
    r := ifx nn > 0 && nums[0] > 0 then nums[0] else 1;
    c := ifx nn > 1 && nums[1] > 0 then nums[1] else 1;
    t[0].y = (ifx r < t[0].rows then r else t[0].rows) - 1; t[0].x = (ifx c < t[0].cols then c else t[0].cols) - 1; t[0].pending = false;
  } else if final == 'K' {
    if nn == 0 || nums[0] == 0 { erase_right(t, t[0].y, t[0].x); }
    else if nums[0] == 2 { erase_right(t, t[0].y, 0); }
  } else if final == 'J' {
    mode := ifx nn > 0 then nums[0] else 0;
    if mode == 0 { erase_right(t, t[0].y, t[0].x); for y: t[0].y + 1..<t[0].rows { erase_right(t, y, 0); } }
    else if mode == 2 || mode == 3 { for y: 0..<t[0].rows { erase_right(t, y, 0); } }
  }
}

is_param :: (c: int) -> bool { return (c >= '0' && c <= '9') || c == ';' || c == '?' || c == '<' || c == '>' || c == '='; }
is_inter :: (c: int) -> bool { return c >= ' ' && c <= '/'; }
is_final :: (c: int) -> bool { return c >= '@' && c <= '~'; }

// Feeds code points (after what was left from the last read).
feed_cps :: (t: [] Term, data: [] int) {
  s: [65536 + RC_REST] int; ns := 0;
  for i: 0..<t[0].nrest { s[ns] = t[0].rest[i]; ns += 1; }
  for c: data { if ns < s.count { s[ns] = c; ns += 1; } }
  t[0].nrest = 0;
  i := 0;
  while i < ns {
    c := s[i];
    if c == 27 {
      if i + 1 < ns && s[i + 1] == '[' {
        p := i + 2; while p < ns && is_param(s[p]) { p += 1; }
        q := p; while q < ns && is_inter(s[q]) { q += 1; }
        if q < ns && is_final(s[q]) { csi(t, s[i + 2..<p], s[q]); i = q + 1; continue; }
        if q == ns { rest(t, s[i..<ns]); return; }      // the sequence goes on in the next read
        i += 2; continue;
      }
      if i + 1 >= ns { rest(t, s[i..<ns]); return; }
      if s[i + 1] == ']' {                                // OSC ... BEL or ST
        e := i; found := -1; width := 0;
        while e < ns { if s[e] == 7 { found = e; width = 1; break; } if s[e] == 27 && e + 1 < ns && s[e + 1] == '\\' { found = e; width = 2; break; } e += 1; }
        if found < 0 { rest(t, s[i..<ns]); return; }
        i = found + width; continue;
      }
      i += 2; continue;
    }
    if c == '\r' { t[0].x = 0; t[0].pending = false; }
    else if c == '\n' { line_feed(t); t[0].pending = false; }
    else if c == 8 { t[0].x = ifx t[0].x - 1 < 0 then 0 else t[0].x - 1; t[0].pending = false; }
    else if c >= ' ' { put(t, c); }
    i += 1;
  }
}
rest :: (t: [] Term, s: [] int) { for c: s { if t[0].nrest < RC_REST { t[0].rest[t[0].nrest] = c; t[0].nrest += 1; } } }

// Feeds bytes: UTF-8 decoded as it comes (a sequence split across reads waits for its end; a bad
// byte is U+FFFD).
feed :: (t: [] Term, bytes: [] u8) {
  cps: [65536] int; n := 0;
  for b: bytes {
    if t[0].nutf == 0 {
      if b < 128 { cps[n] = cast(int) b; n += 1; continue; }
      if b >= 0xc2 && b <= 0xf4 { t[0].utf[0] = b; t[0].nutf = 1; continue; }
      cps[n] = 0xfffd; n += 1; continue;
    }
    if b < 0x80 || b > 0xbf {
      cps[n] = 0xfffd; n += 1; t[0].nutf = 0;
      if b < 128 { cps[n] = cast(int) b; n += 1; } else if b >= 0xc2 && b <= 0xf4 { t[0].utf[0] = b; t[0].nutf = 1; } else { cps[n] = 0xfffd; n += 1; }
      continue;
    }
    t[0].utf[t[0].nutf] = b; t[0].nutf += 1;
    lead := t[0].utf[0];
    need := ifx lead < 0xe0 then 2 else ifx lead < 0xf0 then 3 else 4;
    if t[0].nutf == need {
      v := 0;
      if need == 2 { v = (cast(int) (lead & 0x1f) << 6) | cast(int) (t[0].utf[1] & 0x3f); }
      else if need == 3 { v = (cast(int) (lead & 0x0f) << 12) | (cast(int) (t[0].utf[1] & 0x3f) << 6) | cast(int) (t[0].utf[2] & 0x3f); }
      else { v = (cast(int) (lead & 0x07) << 18) | (cast(int) (t[0].utf[1] & 0x3f) << 12) | (cast(int) (t[0].utf[2] & 0x3f) << 6) | cast(int) (t[0].utf[3] & 0x3f); }
      cps[n] = v; n += 1; t[0].nutf = 0;
    }
    if n >= cps.count - 4 { feed_cps(t, cps[0..<n]); n = 0; }
  }
  feed_cps(t, cps[0..<n]);
}

// Reflow: rejoin soft-wrapped rows into lines, wrap each at the new width (trailing empty cells
// dropped, the cursor's cell kept), keep the cursor on its cell and the bottom of the buffer at the
// screen's bottom.
resize :: (t: [] Term, cols: int, rows: int) {
  cy := top(t) + t[0].y;
  m := 0; ny := 0; nx := 0;
  k := 0;
  while k < t[0].n {
    nl := 0; cur := -1;
    while true {
      if k == cy { cur = nl + t[0].x; }
      w := ifx t[0].wrap[k] then t[0].cols else t[0].len[k];
      for x: 0..<w { if nl < RC_LINE { t[0].line[nl] = cell(t, k, x); nl += 1; } }
      if !t[0].wrap[k] || k == t[0].n - 1 { break; }
      k += 1;
    }
    k += 1;
    while nl > 0 && t[0].line[nl - 1] == 0 { nl -= 1; }
    need := nl;
    if cur >= 0 && cur + 1 > need { need = cur + 1; }
    nrows := (need + cols - 1) / cols; if nrows < 1 { nrows = 1; }
    for j: 0..<nrows {
      if m == RC_ROWS { break; }
      from := j * cols; to := ifx (j + 1) * cols < nl then (j + 1) * cols else nl;
      c := 0;
      for x: from..<to { t[0].nc[m * RC_COLS + c] = t[0].line[x]; c += 1; }
      t[0].nl[m] = ifx to > from then to - from else 0; t[0].nw[m] = j < nrows - 1; m += 1;
    }
    if cur >= 0 { ny = m - nrows + cur / cols; nx = cur % cols; }
  }
  while m < rows { t[0].nl[m] = 0; t[0].nw[m] = false; m += 1; }
  for r: 0..<m { for x: 0..<t[0].nl[r] { t[0].cells[r * RC_COLS + x] = t[0].nc[r * RC_COLS + x]; } t[0].len[r] = t[0].nl[r]; t[0].wrap[r] = t[0].nw[r]; }
  t[0].n = m; t[0].cols = cols; t[0].rows = rows;
  y := ny - top(t);
  t[0].y = ifx y < 0 then 0 else ifx y > rows - 1 then rows - 1 else y;
  t[0].x = nx; t[0].pending = false;
}

// A row as UTF-8, empty cells as spaces; trailing spaces dropped when strip.
row_text :: (t: [] Term, row: int, strip: bool, out: [] u8) -> string {
  n := 0; end := t[0].len[row];
  if strip { while end > 0 && (cell(t, row, end - 1) == 0 || cell(t, row, end - 1) == ' ' || cell(t, row, end - 1) == '\t') { end -= 1; } }
  for x: 0..<end {
    c := cell(t, row, x); if c == 0 { c = ' '; }
    if n + 4 > out.count { break; }
    if c < 0x80 { out[n] = cast,trunc(u8) c; n += 1; }
    else if c < 0x800 { out[n] = cast,trunc(u8) (0xc0 | (c >> 6)); out[n + 1] = cast,trunc(u8) (0x80 | (c & 0x3f)); n += 2; }
    else if c < 0x10000 { out[n] = cast,trunc(u8) (0xe0 | (c >> 12)); out[n + 1] = cast,trunc(u8) (0x80 | ((c >> 6) & 0x3f)); out[n + 2] = cast,trunc(u8) (0x80 | (c & 0x3f)); n += 3; }
    else { out[n] = cast,trunc(u8) (0xf0 | (c >> 18)); out[n + 1] = cast,trunc(u8) (0x80 | ((c >> 12) & 0x3f)); out[n + 2] = cast,trunc(u8) (0x80 | ((c >> 6) & 0x3f)); out[n + 3] = cast,trunc(u8) (0x80 | (c & 0x3f)); n += 4; }
  }
  return cast(string) out[0..<n];
}
has :: (text: string, part: string) -> bool {
  if part.count > text.count { return false; }
  for at: 0..<text.count - part.count + 1 { if text[at..<at + part.count] == part { return true; } }
  return false;
}
// Rows anywhere in the buffer that hold text.
count_rows :: (t: [] Term, text: string) -> int {
  k := 0; b: [4096] u8;
  for r: 0..<t[0].n { if has(row_text(t, r, false, b[..]), text) { k += 1; } }
  return k;
}
// Whether a screen row is a whole rule: only ─, cols - 1 of them.
is_rule :: (t: [] Term, row: int, strip_len: int) -> bool {
  if strip_len == 0 { return false; }
  for x: 0..<strip_len { if cell(t, row, x) != 0x2500 { return false; } }
  return true;
}

#test "the terminal model writes, wraps and reflows" {
  t: [1] Term; term_init(t[..], 10, 3);
  s := "hello\r\nabcdefghijklm";
  b: [64] u8; for i: 0..<s.count { b[i] = s[i]; }
  feed(t[..], b[0..<s.count]);
  o: [256] u8;
  #assert row_text(t[..], top(t[..]) + 0, true, o[..]) == "hello";
  #assert row_text(t[..], top(t[..]) + 1, true, o[..]) == "abcdefghij" && t[0].wrap[top(t[..]) + 1];
  #assert row_text(t[..], top(t[..]) + 2, true, o[..]) == "klm";
  resize(t[..], 20, 3);
  // the lines rejoined, the rows the screen still needs padded below them (as the Python model did)
  #assert row_text(t[..], top(t[..]) + 1, true, o[..]) == "abcdefghijklm" && t[0].x == 13 && t[0].y == 1;
  #assert row_text(t[..], top(t[..]) + 0, true, o[..]) == "hello" && row_text(t[..], top(t[..]) + 2, true, o[..]) == "";
}
#test "escapes: cursor moves, erases, and a sequence split across reads" {
  t: [1] Term; term_init(t[..], 10, 2);
  b: [16] u8;
  b[0] = 'a'; b[1] = 'b'; b[2] = 'c'; b[3] = 27; b[4] = '['; b[5] = '2'; b[6] = 'D';
  feed(t[..], b[0..<7]);
  #assert t[0].x == 1;
  b[0] = 27; b[1] = '[';
  feed(t[..], b[0..<2]);
  #assert t[0].nrest == 2;
  b[0] = 'K'; b[1] = 0xe2; b[2] = 0x94;
  feed(t[..], b[0..<3]);
  b[0] = 0x80;
  feed(t[..], b[0..<1]);
  o: [256] u8;
  #assert cell(t[..], top(t[..]), 1) == 0x2500 && row_text(t[..], top(t[..]), true, o[..]) == "a─";
}

// One running session.
Rs :: struct { h: int; term: [1] Term; quiet: bool; prefix: string; failures: int; raw: [4096] u8; nraw: int; buf: [65536] u8; ended: bool; }

take :: (s: [] Rs, n: int) {
  if s[0].nraw > 0 { ok := fs_append(cast(string) s[0].raw[0..<s[0].nraw], cast(string) s[0].buf[0..<n]); }
  feed(s[0].term[..], s[0].buf[0..<n]);
}
screen_has :: (s: [] Rs, part: string) -> bool {
  t := s[0].term[..]; b: [4096] u8;
  for y: 0..<t[0].rows { if has(row_text(t, top(t) + y, true, b[..]), part) { return true; } }
  return false;
}
// Reads Coder's output for ms (until part shows, when part is given): false once it ended.
pump :: (s: [] Rs, ms: int, until: string) -> bool {
  end := proc_now_ms() + ms;
  while proc_now_ms() < end {
    n := cxproc_read_bytes(s[0].h, 50, s[0].buf[..]);
    if n < 0 { s[0].ended = true; return false; }
    if n > 0 { take(s, n); }
    if until.count > 0 && screen_has(s, until) { return true; }
  }
  return until.count == 0;
}
// As a terminal does: take in what has arrived, reflow, then tell the program.
drag :: (s: [] Rs, cols: int, rows: int) {
  while true { n := cxproc_read_bytes(s[0].h, 0, s[0].buf[..]); if n <= 0 { break; } take(s, n); }
  resize(s[0].term[..], cols, rows);
  r := cxproc_pty_resize(s[0].h, cols, rows);
}
// A frame comes in pieces (a pseudo-terminal passes about 1 KB at a time): read until 40 ms of quiet.
settle :: (s: [] Rs) {
  while true { n := cxproc_read_bytes(s[0].h, 40, s[0].buf[..]); if n <= 0 { return; } take(s, n); }
}
show_screen :: (s: [] Rs, mark: string) {
  t := s[0].term[..]; b: [4096] u8;
  for y: 0..<t[0].rows { print("%", mark); print("%\n", row_text(t, top(t) + y, true, b[..])); }
}
check :: (s: [] Rs, what: string, good: bool, screen: bool) {
  print("%", ifx good then "ok   " else "FAIL "); print("%", s[0].prefix); print("%\n", what);
  if !good {
    s[0].failures += 1;
    if screen && s[0].quiet { show_screen(s, "  |"); }
  }
  f := cxtool_out_flush();
}
rc_name :: (label: string, what: string, out: [] u8) -> string { n := 0; for c: label { out[n] = c; n += 1; } for c: what { out[n] = c; n += 1; } return cast(string) out[0..<n]; }
verdict :: (s: [] Rs, label: string, fill: bool) {
  settle(s);
  t := s[0].term[..];
  if !s[0].quiet { print("---- %", s[0].prefix); print("% (%x%)\n", label, t[0].cols, t[0].rows); show_screen(s, "|"); }
  working := 0; rules := 0; whole := true; footers := 0; stale := 0; kept := 0;
  b: [4096] u8;
  for y: 0..<t[0].rows {
    r := top(t) + y; l := row_text(t, r, true, b[..]);
    if has(l, "Esc to stop") { working += 1; }
    // a rule's length in cells: the row's, past trailing blanks
    e := t[0].len[r]; while e > 0 && (cell(t, r, e - 1) == 0 || cell(t, r, e - 1) == ' ') { e -= 1; }
    if is_rule(t, r, e) { rules += 1; if e != t[0].cols - 1 { whole = false; } }
    if has(l, "Enter send") { footers += 1; }
    nonblank := false; for c: l { if c != ' ' { nonblank = true; } }
    if nonblank && has(l, "to stop") && !has(l, "Esc") { stale += 1; }
    p := "› $ sleep 30";
    if l.count >= p.count && l[0..<p.count] == p { kept += 1; }
  }
  last := row_text(t, top(t) + t[0].rows - 1, true, b[..]);
  n1: [256] u8; check(s, rc_name(label, ": one Working row", n1[..]), working == 1, true);
  n2: [256] u8; check(s, rc_name(label, ": two whole rules, no fragments", n2[..]), rules == 2 && whole, true);
  n3: [256] u8; check(s, rc_name(label, ": one footer, on the last row", n3[..]), footers == 1 && has(last, "Enter send"), true);
  n4: [256] u8; check(s, rc_name(label, ": no wrapped leftovers", n4[..]), stale == 0, true);
  // the transcript stays on the screen above the region: its last line is still in view, once
  if fill { n5: [256] u8; check(s, rc_name(label, ": the transcript above is kept", n5[..]), kept == 1, true); }
}
send :: (s: [] Rs, text: string, until: string) -> bool {
  ok := proc_send(s[0].h, text); r := pump(s, 300, "");
  ok = proc_send(s[0].h, "\r");
  return ifx until.count > 0 then pump(s, 30000, until) else pump(s, 200, "");
}

// One Coder session: fill the screen with transcript first when fill is set, then work and drag
// the terminal's edges. The failures' count.
session :: (repo: string, prefix: string, fill: bool, quiet: bool) -> int {
  s: [1] Rs; s[0].quiet = quiet; s[0].prefix = prefix;
  cols := 120; rows := 30;
  term_init(s[0].term[..], cols, rows);
  rb: [4096] u8; raw := proc_getenv("RESIZE_RAW", rb[..]);
  if raw.count > 0 {
    n := 0; for c: raw { s[0].raw[n] = c; n += 1; } s[0].raw[n] = '.'; n += 1;
    for c: prefix { if c != ':' && c != ' ' { s[0].raw[n] = c; n += 1; } }
    s[0].nraw = n; ok := fs_write(cast(string) s[0].raw[0..<n], "");
  }
  tb: [FS_PATH_MAX] u8; home := fs_temp("coder-resize-", tb[..]);
  h := proc_new();
  cb: [4096] u8; n := 0; for c: repo { cb[n] = c; n += 1; } for c: "/coder/tui/coder.sh" { cb[n] = c; n += 1; }
  hb: [4200] u8; m := 0; for c: "HOME=" { hb[m] = c; m += 1; } for c: home { hb[m] = c; m += 1; }
  ok := h >= 0 && cxproc_pty(h, cols, rows) == 0 && proc_arg(h, cast(string) cb[0..<n]) && proc_arg(h, "--engine") && proc_arg(h, "echo")
    && proc_env(h, cast(string) hb[0..<m]) && proc_env(h, "TERM=xterm-256color") && proc_env(h, "BROWSER=/usr/bin/true") && proc_env(h, "NO_OPEN_BROWSER=1")
    && proc_env(h, "CODER_USAGE=0") && proc_env(h, "CODER_USAGE_KEYCHAIN=0") && proc_cwd(h, repo);
  if !ok || proc_start(h) != 0 { print("FAIL %can't start coder/tui/coder.sh\n", prefix); if h >= 0 { r := proc_release(h); } return 1; }
  s[0].h = h;
  check(s[..], "banner", pump(s[..], 120000, "/help for commands."), false);
  if fill {
    for i: 1..<9 {
      before := count_rows(s[0].term[..], "└ finished");
      mb: [256] u8; k := 0;
      for c: "message " { mb[k] = c; k += 1; }
      mb[k] = cast,trunc(u8) ('0' + i); k += 1;
      for c: ": a long line of text, so that the echo reply wraps across the width of this terminal window" { mb[k] = c; k += 1; }
      r := send(s[..], cast(string) mb[0..<k], "");
      end := proc_now_ms() + 30000;
      while proc_now_ms() < end && count_rows(s[0].term[..], "└ finished") <= before { r = pump(s[..], 100, ""); }
      r = pump(s[..], 300, "");
    }
  }
  check(s[..], "Working shows", send(s[..], "$ sleep 30", "Esc to stop"), false);
  r := pump(s[..], 500, "");
  verdict(s[..], "120 columns", fill);
  for c: [4] int.[100, 80, 64, 50] { drag(s[..], c, rows); r = pump(s[..], 150, ""); }   // a drag: several widths in a row
  r = pump(s[..], 800, "");
  verdict(s[..], "narrowed to 50", fill);
  drag(s[..], 50, 24); r = pump(s[..], 800, "");
  verdict(s[..], "shorter, 50x24", fill);
  for c: [3] int.[70, 96, 120] { drag(s[..], c, 24); r = pump(s[..], 150, ""); }
  r = pump(s[..], 800, "");
  verdict(s[..], "widened to 120", fill);
  // stop the command, then quit
  keys: [4] u8; keys[0] = 27; keys[1] = 3; keys[2] = 3; keys[3] = 3;
  for i: 0..<4 { if s[0].ended || !proc_send(h, cast(string) keys[i..<i + 1]) { break; } r = pump(s[..], 300, ""); }
  end := proc_now_ms() + 10000; done := false;
  while proc_now_ms() < end && !done {
    w := proc_wait(h, 0);
    done = w != PROC_RUNNING;
    if !done { r = pump(s[..], 100, ""); }
  }
  if !done { k := proc_kill(h, PROC_SIGKILL); w := proc_wait(h, 2000); }
  d := proc_release(h);
  if home.count > 0 { gone := fs_remove(home); }
  return s[0].failures;
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  ok := args_load(a[..]);
  quiet := args_has(a[..], "--quiet");
  sb: [4096] u8; sn := cxproc_self_path(sb[..]);
  if sn <= 0 || sn > sb.count { tool_errln("resize_check: can't find this tool's own path"); return 1; }
  // the repository's root from this tool's own binary (ROOT/coax/web/build/tools/NAME-HASH, tool.sh)
  repo := cast(string) sb[0..<sn]; for i: 0..<5 { repo = fs_dir(repo); }
  failures := session(repo, "early: ", false, quiet);   // blank rows keep the composer on the last row
  failures += session(repo, "full: ", true, quiet);     // the transcript fills the screen, as in a long session
  if failures == 0 { print("resize check: ok\n"); return 0; }
  print("resize check: FAILED (%)\n", failures);
  return 1;
}
