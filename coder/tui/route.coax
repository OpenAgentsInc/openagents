// Choose an engine (Coder book chapter 13): the task and this machine's
// environment (the OS, which agent CLIs are on PATH, whether a model server
// answers on this machine) go to System One as typed questions, and the
// answer names the engine, how hard the task is and the effort to give it.
// It is a decision, never a keyword rule. `coder run` asks when no --engine
// is given; --engine always overrides it.
//
// A shared router.json selects local Elephant or an explicit Pylon System One
// door. Without that configuration the legacy Baseten Mammoth path remains.
// The desktop creates a local, keyless config and never falls back to Baseten.
//
// The labels split Claude Code and Codex by the job's size, not by whether
// it mentions code, as the Lab's labels do; route-labels.tsv is the labelled
// set and route_eval.py scores the held-out half.

#load "../../coax/lib/systemone/systemone.coax";
#load "route-policy.coax";

CD_ROUTE_ENGINES :: [4] string.["claude", "codex", "micro", "psionic"];
CD_ROUTE_ENGINE_LABELS :: [4] string.[
  "Claude Code, Anthropic's coding agent CLI: for work that spans files or needs understanding first: refactors, restructuring, new features, debugging, reviews, design, and explaining a codebase",
  "Codex, OpenAI's coding agent CLI: for quick, contained jobs: a one-line or one-file edit, a typo, a version bump, running tests, a build, git or other terminal commands",
  "Microcoder, OpenAgents' own small agent on a hosted model: for small talk, a plain question with a short answer, or when neither coding agent CLI is installed",
  "Microcoder on a model served on this machine: only when the environment says a local model server is running and the user wants the work kept on this machine"];
CD_ROUTE_LEVELS :: [5] string.["Trivial: a one-line answer", "Easy: a short answer or a small edit", "Moderate: a few files or steps",
                               "Hard: many files, debugging or design", "Very hard: a long, open-ended or risky task"];
CD_ROUTE_EFFORTS :: [3] string.["low", "medium", "high"];
CD_ROUTE_EFFORT_LABELS :: [3] string.["Low: answer directly, little thinking", "Medium: some thought", "High: careful reasoning for hard problems"];
CD_ROUTE_SURE :: 0.5;            // below this the person's default engine runs, and Coder says so
CD_BASETEN_ENV :: "/work/.secrets/baseten.env";

CdRoute :: struct {
  ok: bool;
  eligible: int; allowed: int; blocked: int;
  engine: [16] u8; nengine: int;
  probability: f64;
  difficulty: int;               // 0 trivial to 4 very hard
  effort: [16] u8; neffort: int;
  why: [512] u8; nwhy: int;      // why there is no decision
  source: [32]u8; nsource:int;   // nonempty selects the new coder.route.v2 projection
  model: [128]u8; nmodel:int;
  context: [256]u8; ncontext:int; // recent inert conversation text on automatic forks
}

#test "routing projections keep UTF8 intact and bound current and recent context" {
  #assert cd_route_clip("abc",2,false)=="ab" && cd_route_clip("abc",2,true)=="bc";
  #assert cd_route_clip("éx",1,false)=="" && cd_route_clip("xé",1,true)=="";
  #assert cd_route_clip("éx",2,false)=="é" && cd_route_clip("xé",2,true)=="é";
  #assert cd_route_clip("abc",0,false)=="" && cd_route_clip("abc",0,true)=="";
  #assert cd_route_clip("abc",3,false)=="abc";
}
cd_route_clip :: (text:string,limit:int,tail:bool)->string {
  if text.count<=limit {return text;}
  if tail {at:=text.count-limit;while at<text.count && (text[at] & 0xc0)==0x80 {at+=1;}return cast(string)text[at..<text.count];}
  end:=limit;while end>0 && (text[end] & 0xc0)==0x80 {end-=1;}return cast(string)text[0..<end];
}

// Compact questions fit the resident Elephant's per-question context budget.
// Only eligible agents are options; the full prompt still goes to the worker.
cd_elephant_body :: (b:[]SoBody,buf:[]u8,state:string,eligible:int) {
  names:=CD_ROUTE_ENGINES;
  descriptions:=[4]string.["Complex multi-file work, debugging, design or reviews", "Small contained edits, builds, tests or terminal commands", "Brief answers and small talk on the configured hosted model", "Local-only work on the configured local text model"];
  keys:[4]string; labels:[4]string; n:=0;
  for i:0..<4 {if (eligible & (1<<i))!=0 {keys[n]=names[i];labels[n]=descriptions[i];n+=1;}}
  so_begin(b,buf,SO_PSIONIC_ELEPHANT,""); so_state_json(b,state);
  so_choice(b,"engine","Choose the eligible agent best suited to the task's complexity.",keys[0..<n],labels[0..<n]);
  levels:=CD_ROUTE_LEVELS; efforts:=CD_ROUTE_EFFORTS; effort_labels:=CD_ROUTE_EFFORT_LABELS;
  so_score(b,"difficulty","How difficult is this task?",levels[..]);
  so_choice(b,"effort","How much reasoning does this task need?",efforts[..],effort_labels[..]);
}

#test "Elephant routing asks typed complexity questions using only eligible agents" {
  b:[1]SoBody; buf:[8192]u8;
  cd_elephant_body(b[..],buf[..],"{\"message\":\"fix a typo\"}",3);
  body:=so_body(b[..]);
  #assert cl_raw(body,"model")=="\"elephant-1\"" && b[0].questions==3;
  engines:=cl_raw(body,"questions.engine.criteria");
  #assert cl_raw(engines,"claude").count>0 && cl_raw(engines,"codex").count>0 && cl_raw(engines,"micro").count==0;
}

// Whether name is a program in a PATH directory.
cd_on_path :: (name: string) -> bool {
  pb: [8192] u8; path := cl_getenv("PATH", pb[..]);
  at := 0;
  while at <= path.count {
    e := at; while e < path.count && path[e] != ':' { e += 1; }
    if e > at {
      fb: [4200] u8; n := cd_cat(fb[..], 0, cast(string) path[at..<e]); n = cd_cat(fb[..], n, "/"); n = cd_cat(fb[..], n, name);
      if fs_exists(cast(string) fb[0..<n]) { return true; }
    }
    at = e + 1;
  }
  return false;
}

// The state System One sees: {"message": ..., "environment": {...}}.
cd_route_state :: (task: string, claude: bool, codex: bool, local: bool, out: [] u8) -> string {
  n := json_raw(out, 0, "{\"message\":"); n = json_write_string(out, n, task);
  n = json_raw(out, n, ",\"environment\":{\"os\":\"macOS\",\"app\":\"Coder in the terminal\",\"agents\":{\"claude_code\":{\"installed\":");
  n = json_raw(out, n, ifx claude then "true" else "false");
  n = json_raw(out, n, "},\"codex\":{\"installed\":"); n = json_raw(out, n, ifx codex then "true" else "false");
  n = json_raw(out, n, "}},\"local_model_server\":"); n = json_raw(out, n, ifx local then "true" else "false");
  n = json_raw(out, n, "}}");
  return ifx n < 0 then "" else cast(string) out[0..<n];
}

cd_route_body :: (b: [] SoBody, buf: [] u8, state: string) {
  engines := CD_ROUTE_ENGINES; labels := CD_ROUTE_ENGINE_LABELS; levels := CD_ROUTE_LEVELS;
  efforts := CD_ROUTE_EFFORTS; effort_labels := CD_ROUTE_EFFORT_LABELS;
  so_begin(b, buf, SO_MAMMOTH, "");
  so_state_json(b, state);
  so_choice(b, "engine", "Which agent should handle the user's message? Only choose an agent listed in eligible_engines; installation alone does not establish availability.", engines[..], labels[..]);
  so_score(b, "difficulty", "How hard is the user's request to do well?", levels[..]);
  so_choice(b, "effort", "How much reasoning should the agent spend on this request? Hard requests need more.", efforts[..], effort_labels[..]);
}

// NAME=value from an env file's text ("" when absent); export and quotes dropped.
cd_env_value :: (text: string, name: string) -> string {
  at := 0;
  while at < text.count {
    e := at; while e < text.count && text[e] != 10 { e += 1; }
    line := cast(string) text[at..<e];
    at = e + 1;
    if line.count > 7 && cast(string) line[0..<7] == "export " { line = cast(string) line[7..<line.count]; }
    if line.count <= name.count || cast(string) line[0..<name.count] != name || line[name.count] != '=' { continue; }
    v := cast(string) line[name.count + 1..<line.count];
    while v.count > 0 && (v[v.count - 1] == 13 || v[v.count - 1] == ' ') { v = cast(string) v[0..<v.count - 1]; }
    if v.count >= 2 && (v[0] == '"' || v[0] == '\'') && v[v.count - 1] == v[0] { v = cast(string) v[1..<v.count - 1]; }
    return v;
  }
  return "";
}

// A System One client with its key: from BASETEN_API_KEY, or from
// ~/work/.secrets/baseten.env into kb, for curl's environment only. "" when
// it is ready, else why not. Wipe kb after the call.
cd_so_keyed :: (c: [] SoClient, kb: [] u8) -> string {
  c[0] = SoClient.{};
  ev: [16] u8;
  if cl_getenv(SO_BASETEN_KEY_ENV, ev[..]).count > 0 { return ""; }
  hb: [1024] u8; home := cl_getenv("HOME", hb[..]);
  pb: [1200] u8; pn := cd_cat(pb[..], cd_cat(pb[..], 0, home), CD_BASETEN_ENV);
  fb: [8192] u8; nf := fs_read(cast(string) pb[0..<pn], fb[..]);
  v := cd_env_value(cast(string) fb[0..<ifx nf > 0 then nf else 0], SO_BASETEN_KEY_ENV);
  kn := ifx v.count <= kb.count then cd_cat(kb, 0, v) else 0;
  for i: 0..<fb.count { fb[i] = 0; }
  if kn == 0 { return "no System One key: set BASETEN_API_KEY or add it to ~/work/.secrets/baseten.env"; }
  c[0].key_value = cast(string) kb[0..<kn];
  return "";
}

cd_route_fail :: (r: [] CdRoute, why: string) { r[0].ok = false; r[0].nwhy = cd_cat(r[0].why[..], 0, why); }

// Asks System One; r says what it chose, or why there is no decision.
cd_route :: (task: string, local: bool, r: [] CdRoute) {
  sb: [32768] u8;
  allowed: [1] int; blocked: [1] int;
  r[0].eligible = ca_eligible(local, allowed[..], blocked[..]); r[0].allowed = allowed[0]; r[0].blocked = blocked[0];
  if r[0].eligible == 0 { cd_route_fail(r, "no eligible engine: allowlist, installation or provider cooldown"); return; }
  // Shared config, optional env override, then the legacy hosted default.
  // A configured local/Pylon failure never sends the task to Baseten.
  cfg:[4096]u8; pathbuf:[1400]u8; hb:[1024]u8;
  hn:=cd_cat(pathbuf[..],0,cd_state_home(hb[..])); hn=cd_cat(pathbuf[..],hn,"/.openagents/coder/router.json");
  exists:=fs_exists(cast(string)pathbuf[0..<hn]);
  cn:=fs_read(cast(string)pathbuf[0..<hn],cfg[..]);
  if exists && cn<=0 {cd_route_fail(r,"router.json could not be read or is empty");return;}
  if cn>=cfg.count {cd_route_fail(r,"router.json exceeds its 4096-byte limit");return;}
  config:=cast(string)cfg[0..<ifx cn>0 then cn else 0];
  if config.count>0 && !json_valid(config) {cd_route_fail(r,"router.json is not valid JSON");return;}
  if config.count>0 && cl_raw(config,"schema")!="\"coder.router.v1\"" {cd_route_fail(r,"router.json needs schema coder.router.v1");return;}
  if config.count>0 && cl_raw(config,"remote")!="true" && cl_raw(config,"remote")!="false" {cd_route_fail(r,"router.json remote must be a boolean");return;}
  arbuf:[4096]u8; config_ar:[1]ClArena; config_ar[0]=ClArena.{buf=arbuf[..]};
  ub:[2048]u8; url:=cl_getenv(SO_PSIONIC_URL_ENV,ub[..]);
  if url.count==0 {url=cl_str(config_ar[..],config,"url");}
  if exists && url.count==0 {cd_route_fail(r,"router.json needs a System One URL");return;}
  remote:=cl_raw(config,"remote")=="true";
  rb:[16]u8; if cl_getenv("CODER_ROUTE_REMOTE",rb[..])=="1" {remote=true;}
  elephant:=url.count>0;
  if elephant {
    r[0].nsource=cd_cat(r[0].source[..],0,ifx remote then "pylon-elephant" else "local-elephant");
    if !cr_endpoint(url,remote) {cd_route_fail(r,"router endpoint refused: use loopback locally, or an explicit remote HTTPS/Pylon door");return;}
  }
  cut:=task.count; if elephant {cut=cd_route_clip(task,768,false).count;}
  state := cd_route_state(cast(string)task[0..<cut], cd_on_path("claude"), cd_on_path("codex"), local, sb[..]);
  if state.count == 0 { cd_route_fail(r, "the task is too long to route"); return; }
  n := json_raw(sb[..], state.count - 1, ",\"task_truncated\":"); n=json_raw(sb[..],n,ifx cut<task.count then "true" else "false");
  if r[0].ncontext>0 {n=json_raw(sb[..],n,",\"recent_context\":");n=json_write_string(sb[..],n,cast(string)r[0].context[0..<r[0].ncontext]);}
  n = json_raw(sb[..], n, ",\"eligible_engines\":["); comma := false;
  names := CD_ROUTE_ENGINES;
  for i: 0..<4 { if (r[0].eligible & (1 << i)) != 0 { if comma { n = json_raw(sb[..], n, ","); } n = json_write_string(sb[..], n, names[i]); comma = true; } }
  n = json_raw(sb[..], n, "]}");
  if n < 0 { cd_route_fail(r, "the task is too long to route"); return; }
  state = cast(string) sb[0..<n];
  cb: [1] SoClient; kb: [512] u8;
  why:="";
  if elephant {cb[0]=SoClient.{url=url,key_env="",timeout_s=8};
    keycheck:[1]u8; if cl_getenv(SO_PSIONIC_KEY_ENV,keycheck[..]).count>0 {cb[0].key_env=SO_PSIONIC_KEY_ENV;cb[0].scheme="Bearer";}
  } else {why=cd_so_keyed(cb[..],kb[..]);}
  if why.count > 0 { cd_route_fail(r, why); return; }
  // the task leaves only under a grant (chapter 18)
  gn: [1] int;
  if (!elephant || remote) && !gt_session_to_so(state, "the task", r[0].why[..], gn[..]) { for i: 0..<kb.count { kb[i] = 0; } r[0].ok = false; r[0].nwhy = gn[0]; return; }
  c := cb[0];
  buf: [16384] u8; b: [1] SoBody;
  if elephant {cd_elephant_body(b[..],buf[..],state,r[0].eligible);} else {cd_route_body(b[..], buf[..], state);}
  out: [65536] u8; err: [4096] u8;
  res := so_decide(c, b[..], out[..], err[..]);
  for i: 0..<kb.count { kb[i] = 0; }
  if res.problem.count > 0 { cd_route_fail(r, ifx res.stderr.count > 0 then res.stderr else res.problem); return; }
  if elephant && cl_str(config_ar[..],res.body,"model")!="elephant-1" {cd_route_fail(r,"router returned another model identity");return;}
  ab: [8192] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  e := so_choice_of(ar[..], res.body, "engine");
  if !e.ok { cd_route_fail(r, "System One's answer has no engine"); return; }
  r[0].nengine = cd_cat(r[0].engine[..], 0, e.choice);
  r[0].probability = e.probability;
  d := so_score_of(res.body, "difficulty");
  r[0].difficulty = ifx d.ok then d.level else 2;
  f := so_choice_of(ar[..], res.body, "effort");
  r[0].neffort = cd_cat(r[0].effort[..], 0, ifx f.ok then f.choice else "medium");
  if elephant {r[0].nmodel=cd_cat(r[0].model[..],0,cr_model(e.choice,r[0].difficulty));}
  chosen := ca_index(cd_route_engine(r));
  if chosen < 0 || (r[0].eligible & (1 << chosen)) == 0 { cd_route_fail(r, "System One selected an ineligible engine"); return; }
  r[0].ok = true;
}

cd_route_engine :: (r: [] CdRoute) -> string { return cast(string) r[0].engine[0..<r[0].nengine]; }

// "claude (0.93) · moderate · effort medium"
cd_route_text :: (r: [] CdRoute, out: [] u8) -> string {
  levels := [5] string.["trivial", "easy", "moderate", "hard", "very hard"];
  tb: [16] u8;
  n := cd_cat(out, 0, cd_route_engine(r)); n = cd_cat(out, n, " (");
  pc := cast(int) (r[0].probability * 100.0 + 0.5);
  n = cd_cat(out, n, ifx pc >= 100 then "1.00" else "0."); if pc < 100 { if pc < 10 { n = cd_cat(out, n, "0"); } n = cd_cat(out, n, cd_itoa(pc, tb[..])); }
  n = cd_cat(out, n, ") · "); n = cd_cat(out, n, levels[ifx r[0].difficulty >= 0 && r[0].difficulty < 5 then r[0].difficulty else 2]);
  n = cd_cat(out, n, " · effort "); n = cd_cat(out, n, cast(string) r[0].effort[0..<r[0].neffort]);
  return cast(string) out[0..<n];
}

#test "the route asks three typed questions about the message and this machine" {
  sb: [4096] u8; buf: [16384] u8; b: [1] SoBody;
  state := cd_route_state("fix the failing test", true, false, false, sb[..]);
  #assert state == "{\"message\":\"fix the failing test\",\"environment\":{\"os\":\"macOS\",\"app\":\"Coder in the terminal\",\"agents\":{\"claude_code\":{\"installed\":true},\"codex\":{\"installed\":false}},\"local_model_server\":false}}";
  cd_route_body(b[..], buf[..], state);
  body := so_body(b[..]);
  #assert body.count > 0;
  q := cl_raw(body, "questions");
  #assert cl_raw(q, "engine").count > 0 && cl_raw(q, "difficulty").count > 0 && cl_raw(q, "effort").count > 0;
}

#test "a decision reads back as engine, probability, difficulty and effort" {
  r: [1] CdRoute;
  r[0].nengine = cd_cat(r[0].engine[..], 0, "codex"); r[0].probability = 0.87; r[0].difficulty = 1;
  r[0].neffort = cd_cat(r[0].effort[..], 0, "low");
  ob: [128] u8;
  #assert cd_route_text(r[..], ob[..]) == "codex (0.87) · easy · effort low";
  r[0].probability = 0.05;
  #assert cd_route_text(r[..], ob[..]) == "codex (0.05) · easy · effort low";
}

#test "env files: export prefixes and quotes" {
  #assert cd_env_value("A=1\nexport BASETEN_API_KEY=\"k1\"\n", "BASETEN_API_KEY") == "k1";
  #assert cd_env_value("BASETEN_API_KEYS=x", "BASETEN_API_KEY") == "";
}

// System One as a tool (Coder book chapter 16): `coder decide QUESTION
// --options A,B[,...] [--state TEXT]` asks one typed choice question and
// answers the chosen option with its probability. The state is JSON when it
// starts with "{", else text. The coder_decide MCP tool runs this verb.
CD_DECIDE_MAX :: 32;

// 0.962: three places are what a decision carries.
cd_prob3 :: (out: [] u8, n: int, p: f64) -> int {
  pm := cast(int) (p * 1000.0 + 0.5);
  k := json_write_int(out, n, pm / 1000); k = json_raw(out, k, ".");
  k = json_raw(out, k, ifx pm % 1000 < 10 then "00" else ifx pm % 1000 < 100 then "0" else "");
  return json_write_int(out, k, pm % 1000);
}

// Splits A,B,C into keys; the count, or -1 when there are too many or one is empty.
cd_decide_options :: (options: string, keys: [] string) -> int {
  n := 0; at := 0;
  while at <= options.count {
    e := at; while e < options.count && options[e] != ',' { e += 1; }
    if e == at || n == keys.count { return -1; }
    keys[n] = cast(string) options[at..<e]; n += 1;
    at = e + 1;
  }
  return n;
}

// The decision as JSON: {"choice":"A","probability":0.962} or {"error":"..."}; ok[0] when decided.
cd_decide :: (question: string, options: string, state: string, out: [] u8, ok: [] bool) -> string {
  ok[0] = false;
  keys: [CD_DECIDE_MAX] string; labels: [CD_DECIDE_MAX] string;
  k := cd_decide_options(options, keys[..]);
  why := "";
  if question.count == 0 { why = "needs a question"; }
  else if k < 2 { why = "needs 2 to 32 options, separated by commas, none empty"; }
  if why.count == 0 {
    for i: 0..<k { labels[i] = ""; }
    cb: [1] SoClient; kb: [512] u8;
    why = cd_so_keyed(cb[..], kb[..]);
    if why.count == 0 {
      buf: [65536] u8; b: [1] SoBody;
      so_begin(b[..], buf[..], SO_MAMMOTH, "");
      if state.count > 0 && state[0] == '{' { so_state_json(b[..], state); } else { so_state_text(b[..], ifx state.count > 0 then state else question); }
      so_choice(b[..], "decision", question, keys[0..<k], labels[0..<k]);
      if b[0].at < 0 { why = "the question doesn't fit a System One request"; }
      else {
        ob: [65536] u8; err: [4096] u8;
        res := so_decide(cb[0], b[..], ob[..], err[..]);
        for i: 0..<kb.count { kb[i] = 0; }
        if res.problem.count > 0 { why = ifx res.stderr.count > 0 then res.stderr else res.problem; }
        else {
          ab: [8192] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
          c := so_choice_of(ar[..], res.body, "decision");
          if !c.ok { why = "System One's answer has no choice"; }
          else {
            n := json_raw(out, 0, "{\"choice\":"); n = json_write_string(out, n, c.choice);
            n = json_raw(out, n, ",\"probability\":"); n = cd_prob3(out, n, c.probability); n = json_raw(out, n, "}");
            ok[0] = n > 0;
            return ifx n < 0 then "" else cast(string) out[0..<n];
          }
        }
      }
    }
  }
  n := json_raw(out, 0, "{\"error\":"); n = json_write_string(out, n, why); n = json_raw(out, n, "}");
  return ifx n < 0 then "" else cast(string) out[0..<n];
}

#test "decide: options split on commas; empty or too few are refused" {
  keys: [CD_DECIDE_MAX] string;
  #assert cd_decide_options("yes,no,later", keys[..]) == 3 && keys[2] == "later";
  #assert cd_decide_options("a,,b", keys[..]) == -1;
  #assert cd_decide_options("", keys[..]) == -1;
  ob: [256] u8; ok: [1] bool;
  #assert cd_decide("Ship it?", "yes", "", ob[..], ok[..]) == "{\"error\":\"needs 2 to 32 options, separated by commas, none empty\"}" && !ok[0];
  b: [32] u8; n := cd_prob3(b[..], 0, 0.05);
  #assert cast(string) b[0..<n] == "0.050";
}
