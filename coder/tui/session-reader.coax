// CLI adapter for the shared native history filesystem reader.
#load "../../coax/lib/agent/observe/claude-files.coax";

cd_cmd_session_read :: (args: [] Args) -> int {
  request := args_value(args, "--request", ""); rb: [8192] u8;
  if request.count == 0 {
    action := cd_positional(args, 1); if action.count == 0 { action = "show"; }
    n := json_raw(rb[..], 0, "{\"source\":\"claude\",\"action\":"); n = json_write_string(rb[..], n, action);
    ref := cd_positional(args, 2); if ref.count > 0 { n = json_raw(rb[..], n, ",\"ref\":"); n = json_write_string(rb[..], n, ref); }
    cwd := args_value(args, "--cwd", ""); if cwd.count > 0 { n = json_raw(rb[..], n, ",\"cwd\":"); n = json_write_string(rb[..], n, cwd); }
    flags := [4] string.["--within-min", "--max-turns", "--before", "--max-tool-chars"];
    names := [4] string.["within_min", "max_turns", "before", "max_tool_chars"];
    for f, i: flags {
      value := args_value(args, f, "");
      if value.count > 0 {
        for c: value { if c < '0' || c > '9' { tool_errln("session-read: numeric flags take decimal integers"); return 2; } }
        n = json_raw(rb[..], n, ",\""); n = json_raw(rb[..], n, names[i]); n = json_raw(rb[..], n, "\":"); n = json_raw(rb[..], n, value);
      }
      else if args_has(args, f) { tool_errln("session-read: a numeric flag needs its value"); return 2; }
    }
    n = json_raw(rb[..], n, "}"); if n < 0 { tool_errln("session-read: arguments too long"); return 2; }
    request = cast(string) rb[0..<n];
  }
  out: [CSR_OUTPUT_MAX] u8; result := csr_request(request, out[..]); cd_outln(result);
  return ifx cl_raw(result, "error").count > 0 then 2 else 0;
}
