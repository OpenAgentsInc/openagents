// Coder's session log (Coder book chapters 2, 14 and 23): every session,
// in the terminal UI or `coder run`, appends one JSON object a line to
// ~/.openagents/coder/sessions/ID.jsonl as it happens. `coder ls`,
// `coder status ID` and `coder log ID` read these files, and `--json` on
// `coder run` prints the same lines to stdout as they are written.
//
// The events:
//   {"kind":"session","id":ID,"version":V,"engine":E,"cwd":DIR,"started_us":T}
//   {"kind":"user","text":T}                  a message the person sent
//   {"kind":"agent","engine":E}               the person switched agent
//   {"kind":"tool","label":"Bash(ls)"}        a tool call, as the transcript shows it
//   {"kind":"result","text":T,"error":B}      its result's first line and size
//   {"kind":"diff","path":P,"adds":N,"dels":N[,"old":T,"new":T]}   an edit's own text when both fit in 8 KiB
//   {"kind":"reply","text":T}                 the turn's reply, whole
//   {"kind":"end","ending":E,"ms":N,"steps":N,"text":T}   E: finished, stopped, failed or expired
//   {"kind":"job","id":ID,"ending":E,"text":T}  a job this session started ended (--report-to)
//
// The ID is the UTC start time and milliseconds (20261102-153012-417): it
// sorts by time. Nothing here leaves the machine (chapter 18's rule).
#load "../../coax/lib/agent/session/writer.coax";   // the writer: every line below is written there

CS_OUT :: 1048576;     // the lines --json owes stdout between two writes (a reply's last stream is the most)

cs_id :: (l: [] SwLog) -> string { return sw_id(l); }

// Where Coder keeps its state: $CODER_HOME when set, else $HOME (writer.coax).
cd_state_home :: (out: [] u8) -> string { return sw_state_home(out); }
cs_dir :: (out: [] u8) -> string { return sw_dir(out); }
cs_civil :: (days: int) -> int { return sw_civil(days); }
cs_make_id :: (us: int, out: [] u8) -> string { return sw_make_id(us, out); }
cs_sibling :: (l: [] SwLog, ext: string, out: [] u8) -> string { return sw_sibling(l, ext, out); }
cs_secrets :: (l: [] SwLog) { sw_secrets(l); }
cs_secret_add :: (l: [] SwLog, v: string) { sw_secret_add(l, v); }
cs_hide :: (l: [] SwLog, buf: [] u8, n0: int) -> int { return sw_hide(l, buf, n0); }
cs_complete :: (text: string) -> int { return sw_complete(text); }
cs_append_after :: (path: string, line: string) -> bool { return sw_append_after(path, line); }
cs_live_line :: (l:[]SwLog,final:bool,out:[]u8)->string { return sw_live_line(l, final, out); }

// After each write: the lines --json owes stdout, and a line that could not be stored stops the session.
cs_after :: (a: [] App) {
  l := a[0].log;
  if l[0].nout > 0 { r := cxterm_write(l[0].out[0..<l[0].nout]); l[0].nout = 0; }
  if sw_lost(l) { cs_storage_failed(a); }
}

// Starts the session's file with its header line.
cs_open :: (a: [] App) {
  effects := CD_EFFECTS;
  allow := ifx a[0].pol[0].on then effects[a[0].pol[0].allow] else "";
  ceiling := ifx a[0].pol[0].on then effects[a[0].pol[0].ceiling] else "";
  sw_open(a[0].log, cd_engine_name(a[0].engine), a[0].cwd, CODER_VERSION, cast(string) a[0].resume[0..<a[0].nresume], allow, ceiling);
  cs_after(a);
}

// Appends the line built in l.line[0..<n] (and prints it with --json).
cs_put :: (a: [] App, n0: int) { sw_put(a[0].log, n0); cs_after(a); }

cs_text :: (a: [] App, kind: string, key: string, text: string) { sw_text(a[0].log, kind, key, text); cs_after(a); }
// The remembered facts a first message carried, and how many the consent gate held back (chapters 18 and 19).
cs_memory :: (a: [] App, text: string, held: int) { sw_memory(a[0].log, text, held); cs_after(a); }
// The digest and length of what a turn sent its engine.
cs_request :: (a: [] App, sent: string) { sw_request(a[0].log, sent); cs_after(a); }
cs_user :: (a: [] App, text: string) { sw_user(a[0].log, text); cs_after(a); }
cs_agent :: (a: [] App, engine: int) { cs_text(a, "agent", "engine", cd_engine_name(engine)); }
cs_tool :: (a: [] App, label: string) { sw_tool(a[0].log, label); cs_after(a); cd_recap_note(a, label); }
cs_result :: (a: [] App, text: string, bad: bool) { sw_result(a[0].log, text, bad); cs_after(a); }
// The engine's own session ID: {"kind":"engine_session","engine":"claude","id":ID}.
cs_engine_session :: (a: [] App, engine: string, id: string) { sw_engine_session(a[0].log, engine, id); cs_after(a); }
// texts: whether old and next are the edit's own text (an Edit's old and new, a Write's new); they are logged when both fit.
cs_diff :: (a: [] App, path: string, adds: int, dels: int, texts: bool, old: string, next: string) { sw_diff(a[0].log, path, adds, dels, texts, old, next); cs_after(a); }
// The reply streams in pieces; it is logged whole, before the next tool and at the end.
cs_reply_add :: (a: [] App, s: string) { sw_reply_add(a[0].log, s); cs_after(a); }
cs_reply_flush :: (a: [] App) { sw_reply_flush(a[0].log); cs_after(a); }
cs_end :: (a: [] App, ending: string, ms: int, steps: int, text: string) {
  sw_end(a[0].log, ending, ms, steps, text, cast(string) a[0].cause[0..<a[0].ncause]);
  a[0].ncause = 0;
  cs_after(a);
}

// ---------------------------------------------------------------- reading sessions back

// What `coder ls` and `coder status` show of one session file.
CsSummary :: struct {
  ok: bool;
  engine: [32] u8; nengine: int;
  cwd: [1024] u8; ncwd: int;
  task: [512] u8; ntask: int;      // the first message
  ending: [32] u8; nending: int;   // the last turn's ending ("running" when a turn has no end yet)
  turns: int;
  steps: int;
  started_us: int;
  last: [512] u8; nlast: int;      // the last event's kind and text, for status
  cause: [32] u8; ncause: int;     // the last end line's cause, "" when it gave none
}

cs_read :: (text: string, s: [] CsSummary, ar: [] ClArena) {
  s[0] = CsSummary.{};
  open := false;
  at := 0;
  while at < text.count {
    e := at; while e < text.count && text[e] != 10 { e += 1; }
    line := cast(string) text[at..<e];
    at = e + 1;
    if line.count == 0 { continue; }
    ar[0].at = 0; ar[0].full = false;
    kind := cl_str(ar, line, "kind");
    if kind == "session" {
      s[0].ok = true;
      s[0].nengine = cd_cat(s[0].engine[..], 0, cl_str(ar, line, "engine"));
      s[0].ncwd = cd_cat(s[0].cwd[..], 0, cl_str(ar, line, "cwd"));
      st := cl_int(line, "started_us"); if st.ok { s[0].started_us = st.value; }
    } else if kind == "user" {
      s[0].turns += 1; open = true;
      if s[0].ntask == 0 { s[0].ntask = cd_cat(s[0].task[..], 0, cl_str(ar, line, "text")); }
    } else if kind == "agent" {
      s[0].nengine = cd_cat(s[0].engine[..], 0, cl_str(ar, line, "engine"));
    } else if kind == "end" {
      open = false;
      s[0].nending = cd_cat(s[0].ending[..], 0, cl_str(ar, line, "ending"));
      s[0].ncause = cd_cat(s[0].cause[..], 0, cl_str(ar, line, "cause"));
      st := cl_int(line, "steps"); if st.ok { s[0].steps += st.value; }
    }
    if kind != "session" {
      t := cl_str(ar, line, ifx kind == "tool" then "label" else ifx kind == "agent" || kind == "end" then (ifx kind == "end" then "ending" else "engine") else "text");
      s[0].nlast = cd_cat(s[0].last[..], 0, kind); s[0].nlast = cd_cat(s[0].last[..], s[0].nlast, ": ");
      e2 := 0; while e2 < t.count && t[e2] != 10 { e2 += 1; }
      s[0].nlast = cd_cat(s[0].last[..], s[0].nlast, cast(string) t[0..<e2]);
    }
  }
  // a header with no turn yet is a session starting, not one that ended: a
  // Router pass that reads it then must not report it (the live lab caught one)
  if open || (s[0].ok && s[0].turns == 0) { s[0].nending = cd_cat(s[0].ending[..], 0, "running"); }
}

#test "a session file reads back as its engine, first message, turns, steps and ending" {
  text := "{\"kind\":\"session\",\"id\":\"x\",\"engine\":\"claude\",\"cwd\":\"/w\",\"started_us\":5}\n{\"kind\":\"user\",\"text\":\"fix it\"}\n{\"kind\":\"tool\",\"label\":\"Bash(ls)\"}\n{\"kind\":\"end\",\"ending\":\"finished\",\"ms\":10,\"steps\":2}\n{\"kind\":\"agent\",\"engine\":\"codex\"}\n{\"kind\":\"user\",\"text\":\"again\"}\n";
  s: [1] CsSummary; ab: [4096] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  cs_read(text, s[..], ar[..]);
  #assert s[0].ok && cast(string) s[0].engine[0..<s[0].nengine] == "codex" && cast(string) s[0].task[0..<s[0].ntask] == "fix it";
  #assert s[0].turns == 2 && s[0].steps == 2 && cast(string) s[0].ending[0..<s[0].nending] == "running" && s[0].started_us == 5;
  #assert cast(string) s[0].last[0..<s[0].nlast] == "user: again";
  h := "{\"kind\":\"session\",\"id\":\"x\",\"engine\":\"claude\",\"cwd\":\"/w\",\"started_us\":5}\n";
  cs_read(h, s[..], ar[..]);
  #assert s[0].turns == 0 && cast(string) s[0].ending[0..<s[0].nending] == "running";
}

// Observability v1: snapshots, not estimates or additive accounting.
cs_cx_model :: (a: [] App) {
  opt := a[0].cx_options[..];
  sw_cx_model(a[0].log, ccx_text(opt[0].actual_model[..]), ccx_text(opt[0].actual_effort[..])); cs_after(a);
}
cs_cx_usage :: (a: [] App, usage: string) {
  c := a[0].cx.count > 0;
  sw_cx_usage(a[0].log, usage, c, ifx c then cx_thread_id(a[0].cx) else "", ifx c then cx_turn_id(a[0].cx) else ""); cs_after(a);
}

// Poison before closing concrete owners: callbacks cannot publish a success
// through this logger, and no later turn may dispatch through it.
cs_storage_failed :: (a:[]App) {
  a[0].log[0].failed=true;
  cd_command_stop(a);cd_micro_close(a);cd_codex_close(a);cd_cursor_close(a);cd_claude_close(a);
  a[0].running=false;a[0].ask=false;a[0].exit=1;
  tool_errln("Coder session storage failed; execution stopped. Inspect outstanding effects before retrying.");
}
