// Real signed HOST carriage, private files and native SDK process lifecycle.
// The provider is the existing Coax stand-in: no external login/model call.
#load "host-smoke-driver.coax";
#load "../../coax/lib/agent/environment/task-input.coax";
#load "../../coax/lib/agent/environment/task-wire.coax";
#load "../../coax/lib/agent/router/wire.coax";

sm_task_call :: (s:[]Sm,rp:[]Rp,key:string,grant:string,epoch:string,q:XtRequest) #effects(all) {
 packet:[XT_REQUEST_MAX]u8;n:=xt_request_write(q,packet[..]);p:[1200]u8;file:=sm_in_tmp(s,"task-request.json",p[..]);
 if n<1 || !fs_write(file,cast(string)packet[0..<n]) {rp[0].status= -1;rp[0].ok=false;return;}
 sm_execution(s,rp,key,grant,epoch,file);
}
sm_task_wait :: (s:[]Sm,rp:[]Rp,key:string,grant:string,epoch:string,task:string,state:string)->bool #effects(all) {
 q:=XtRequest.{method="ReadTask",task=task};deadline:=proc_now_ms()+30000;
 while proc_now_ms()<deadline {sm_task_call(s,rp,key,grant,epoch,q);if rp[0].status!=0 {return false;}native:[128]u8;
  if rp_is(rp,"state",state) && (state!="running" || rp_s(rp,"native_session_id",native[..]).count>0) {return true;}
  if rp_is(rp,"state","failed") || rp_is(rp,"state","unknown") {sm_out(sm_text(rp));sm_out("\n");return false;}}
 return false;
}
sm_task_input :: (v:[]ExInput,last:string) #effects(all) {
 v[0]=ExInput.{};v[0].ni=js_copy(v[0].instructions[..],"Keep these pinned instructions.");v[0].nr=js_copy(v[0].reference[..],"Pinned café reference.");
 for text,i:[3]string.["Prior question","Prior answer",last] {v[0].starts[i]=v[0].bytes;v[0].counts[i]=js_copy(v[0].text[v[0].bytes..<v[0].text.count],text);v[0].bytes+=v[0].counts[i];}
 v[0].n=3;v[0].assistant[1]=true;
}
sm_task_provider :: (s:[]Sm,rp:[]Rp,engine:string)->bool #effects(all) {
 name:[128]u8;n:=sm_cat(name[..],sm_cat(name[..],0,"bin/"),engine);p:[1200]u8;executable:=sm_in_tmp(s,cast(string)name[0..<n],p[..]);wrapper:[4096]u8;
 n=sm_cat(wrapper[..],0,"#!/bin/sh\n# Firm reason: 5 (thin fixture launcher with no logic)\nexec ");n=sm_cat(wrapper[..],n,sm_repo(s));n=sm_cat(wrapper[..],n,"/coax/web/tool.sh ");n=sm_cat(wrapper[..],n,sm_repo(s));n=sm_cat(wrapper[..],n,"/coder/tui/");n=sm_cat(wrapper[..],n,engine);n=sm_cat(wrapper[..],n,"_standin.coax \"$@\"\n");
 if !fs_write(executable,cast(string)wrapper[0..<n]) {return false;}chmod:=[3]string.["chmod","755",executable];sm_exec(s,rp,chmod[..],10000);if rp[0].status!=0 {return false;}
 source:[128]u8;n=sm_cat(source[..],sm_cat(source[..],0,"coder/tui/"),engine);n=sm_cat(source[..],n,"_standin.coax");compile:=[3]string.["coax/web/tool.sh",cast(string)source[0..<n],"--version"];sm_exec(s,rp,compile[..],600000);return rp[0].status==0;
}
sm_task_count :: (raw:string,needle:string)->int #effects(all) {
 count:=0;for i:0..<raw.count-needle.count+1 {if raw[i..<i+needle.count]==needle {count+=1;}}return count;
}

tool_main :: ()->int #export_c #effects(all) {
 state:[1]Sm;s:=state[..];rp:[1]Rp;cwd:[1024]u8;s[0].nrepo=js_copy(s[0].repo[..],fs_cwd(cwd[..]));
 s[0].ncoder=sm_cat(s[0].coder[..],sm_cat(s[0].coder[..],0,sm_repo(s)),"/coder/tui/coder.sh");
 tmp:[1024]u8;s[0].ntmp=js_copy(s[0].tmp[..],fs_temp("coder-task-host-",tmp[..]));home_path:[1200]u8;home:=sm_in_tmp(s,"home",home_path[..]);s[0].nhome=js_copy(s[0].home[..],home);
 bin_path:[1200]u8;bin:=sm_in_tmp(s,"bin",bin_path[..]);workspace_path:[1200]u8;workspace:=sm_in_tmp(s,"workspace",workspace_path[..]);
 if !fs_mkdir_private(home) || !fs_mkdir_private(bin) || !fs_mkdir_private(workspace) {return 2;}
 sm_env(s,0,"CODER_HOME",home);sm_env(s,1,"BROWSER","/usr/bin/true");sm_env(s,2,"NO_OPEN_BROWSER","1");sm_env(s,5,"CODER_USAGE_KEYCHAIN","0");sm_env(s,11,"HOME",home);
 fake:[1200]u8;fake_auth:=sm_in_home(s,".claude.json",fake[..]);if !fs_write(fake_auth,"{\"oauthAccount\":{}}") {return 2;}
 if !sm_task_provider(s,rp[..],"claude") || !sm_task_provider(s,rp[..],"codex") {sm_out(sm_text(rp[..]));return 2;}
 codex_path:[1200]u8;codex_dir:=sm_in_home(s,".codex",codex_path[..]);auth_path:[1200]u8;if !fs_mkdir_private(codex_dir) || !fs_write(fs_join(codex_dir,"auth.json",auth_path[..]),"{}") {return 2;}
 path:[8192]u8;prior:[8192]u8;np:=sm_cat(path[..],sm_cat(path[..],0,bin),":");np=sm_cat(path[..],np,proc_getenv("PATH",prior[..]));sm_env(s,6,"PATH",cast(string)path[0..<np]);
 notes_path:[1200]u8;notes:=sm_in_tmp(s,"provider-notes.jsonl",notes_path[..]);sm_env(s,8,"CLAUDE_STANDIN_OUT",notes);sm_env(s,10,"CLAUDE_STANDIN_SECONDS","90");
 codex_notes_path:[1200]u8;sm_env(s,7,"CODEX_STANDIN_OUT",sm_in_tmp(s,"codex-provider.jsonl",codex_notes_path[..]));
 relay_path:[1200]u8;relay_bin:=sm_in_tmp(s,"relay",relay_path[..]);build:=[2]string.["nostr/relay/build.sh",relay_bin];sm_exec(s,rp[..],build[..],600000);if rp[0].status!=0 {return 2;}
 pb:[24]u8;port:=sm_itoa(20000+proc_now_ms()%30000,pb[..]);s[0].nurl=sm_cat(s[0].url[..],sm_cat(s[0].url[..],0,"ws://localhost:"),port);url:=sm_str(s[0].url[..],s[0].nurl);sm_env(s,3,"OPENAGENTS_NIP_HOST_RELAY",url);
 relay_args:=[9]string.[relay_bin,"--listen","127.0.0.1","--port",port,"--url",url,"--rate","1024,1024,1024"];relay:=sm_spawn(s,relay_args[..],true);serve:= -1;defer {sm_stop(serve);sm_stop(relay);}
 if relay<0 {return 2;}
 key_args:=[1]string.["key"];sm_host(s,rp[..],key_args[..]);if rp[0].status!=0 || rp[0].n<64 {return 2;}_ = js_copy(s[0].key[..],cast(string)rp[0].text[0..<64]);
 serve_args:=[6]string.["--engine","echo","--for","600","--relay",url];serve=sm_serve(s,serve_args[..]);if serve<0 {return 2;}
 browser_path:[1200]u8;key:=sm_in_tmp(s,"browser.key",browser_path[..]);label:=[2]string.["--label","Task fixture browser"];sm_call(s,rp[..],"browser.request",key,label[..]);
 request:[64]u8;pairing:=rp_s(rp[..],"result.outcome.request",request[..]);allow:=[2]string.["allow",pairing];sm_host(s,rp[..],allow[..]);
 lookup:=[2]string.["--request",pairing];sm_call(s,rp[..],"browser.status",key,lookup[..]);grant_buf:[64]u8;grant:=rp_s(rp[..],"result.outcome.grant.grant",grant_buf[..]);epoch_buf:[32]u8;epoch:=sm_itoa(rp_i(rp[..],"result.outcome.grant.epoch"),epoch_buf[..]);
 list:=[2]string.["list","--json"];sm_host(s,rp[..],list[..]);device_buf:[64]u8;device:=rp_s(rp[..],"browsers.0.key",device_buf[..]);enable:=[9]string.["environment-enable","--device",device,"--grant",grant,"--workspace",workspace,"--label","Task fixture"];
 sm_host(s,rp[..],enable[..]);sm_check(s,rp[0].status==0,"the isolated browser is explicitly enrolled for its workspace");if rp[0].status!=0 {return 2;}
 n:=0;ids:=[6]string.["22222222222222222222222222222222","33333333333333333333333333333333","44444444444444444444444444444444","55555555555555555555555555555555","66666666666666666666666666666666","77777777777777777777777777777777"];
 for id,scenario:ids {
  station_args:=[13]string.["station-rpc","--host",sm_key(s),"--browser-key",key,"--grant",grant,"--epoch",epoch,"--relay",url,"--wait-ms","30000"];sm_host(s,rp[..],station_args[..]);
  report:[RTR_REPORT_MAX]u8;nr:=js_copy(report[..],sm_text(rp[..]));stations:[1]RtrRequest;nodes:[4096]JvNode;wire:[RTR_REPORT_MAX]u8;host:[64]u8;
  if rp[0].status!=0 || !rtr_report_read(cast(string)report[0..<nr],nodes[..],wire[..],stations[..],0,host[..]) {sm_out(sm_text(rp[..]));return 2;}
  rh:[64]u8;if !S_hex(S_hash(cast(string)report[0..<nr]),rh[..]) {return 2;}
  input:[1]ExInput;sm_task_input(input[..],ifx scenario==2 then "work slowly" else ifx scenario>=4 then "routed-task-smoke edit" else "routed-task-smoke");raw:[8192]u8;size:=ex_input_write(input[..],raw[..]);ih:[64]u8;if size<1 || !S_hex(S_hash(cast(string)raw[0..<size]),ih[..]) {return 2;}
  now:=cxproc_wall_us()/1000;b:=ExBinding.{task=id,conversation="cnv_0123456789abcdef0123456789abcdef",turn="trn_0123456789abcdef0123456789abcdef",route=id,host=sm_key(s),workspace="default",session=id,command=id,engine="claude",account="system",model="claude-task-fixture",effort="high",input_hash=cast(string)ih[..],input_bytes=size,report_hash=cast(string)rh[..],report_at=stations[0].stations[0].reported_at_ms,issued=now,expires=ea_deadline(now)};
  if scenario>=4 {b.engine="codex";b.model="gpt-standin";}
  file_path:[1200]u8;file:=sm_in_tmp(s,"prepare.json",file_path[..]);packet:[XT_REQUEST_MAX]u8;n=ex_binding_write(b,packet[..]);if n<1 || !fs_write(file,cast(string)packet[0..<n]) {return 2;}sm_execution(s,rp[..],key,grant,epoch,file);
  sm_check(s,rp[0].status==0,"preparation pins the resident's actual report and exact selected account");if rp[0].status!=0 {sm_out(sm_text(rp[..]));return 2;}
  chunk:=ExChunk.{task=id,command=id,hash=b.input_hash,total=size,text=cast(string)raw[0..<size],issued=now,expires=b.expires};n=ex_chunk_write(chunk,packet[..]);if n<1 || !fs_write(file,cast(string)packet[0..<n]) {return 2;}sm_execution(s,rp[..],key,grant,epoch,file);
  sm_check(s,rp[0].status==0 && rp_kind(rp[..],"complete")==JV_TRUE,"the complete input is admitted through signed HOST upload");
  decision:=[1]RtrDecision.[RtrDecision.{ok=true,station=stations[0].stations[0].id,engine=b.engine,model=b.model,effort=b.effort,difficulty=0,weight=0,door="native-fixture"}];route:[RTR_DECISION_MAX]u8;nd:=rtr_decision_write(decision[..],route[..]);
  start:=XtRequest.{method="StartTask",task=id,command=id,issued=now,expires=b.expires,route=cast(string)route[0..<nd]};sm_task_call(s,rp[..],key,grant,epoch,start);
  sm_check(s,rp[0].status==0,"StartTask commits one owned task through the real resident");if rp[0].status!=0 {sm_out(sm_text(rp[..]));return 2;}
  sm_task_call(s,rp[..],key,grant,epoch,start);sm_check(s,rp[0].status==0 && rp_kind(rp[..],"replay")==JV_TRUE,"retrying Start reconciles without a second native prompt");
  wanted:=ifx scenario==2 then "running" else "waiting";reached:=sm_task_wait(s,rp[..],key,grant,epoch,id,wanted);sm_check(s,reached,"the shared native engine reaches its actual running/permission state");if !reached {return 1;}
  note_file_path:[1200]u8;note_file:=fs_join(workspace,"note.txt",note_file_path[..]);
  if scenario<2 || scenario>=4 {
   sm_check(s,!fs_exists(note_file),"no file effect occurs before an actual permission answer");
   interaction_buf:[256]u8;interaction:=rp_s(rp[..],"interaction_id",interaction_buf[..]);revision:=rp_i(rp[..],"revision");
   accepted:=scenario==0 || scenario==4;commands:=[6]string.["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","cccccccccccccccccccccccccccccccc","dddddddddddddddddddddddddddddddd","eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee","ffffffffffffffffffffffffffffffff"];
   answer:=XtRequest.{method="RespondTask",task=id,command=commands[scenario],revision=revision-1,interaction=interaction,allow=accepted,issued=now,expires=b.expires};
   sm_task_call(s,rp[..],key,grant,epoch,answer);sm_check(s,rp[0].status==6 && !fs_exists(note_file),"an old permission revision cannot reach the native SDK");
   answer.revision=revision;answer.interaction="another-native-request";sm_task_call(s,rp[..],key,grant,epoch,answer);sm_check(s,rp[0].status==6 && !fs_exists(note_file),"a foreign permission ID cannot reach the native SDK");
   answer.interaction=interaction;sm_task_call(s,rp[..],key,grant,epoch,answer);sm_check(s,rp[0].status==0,"the exact native permission is answered through signed HOST");
   sm_task_call(s,rp[..],key,grant,epoch,answer);sm_check(s,rp[0].status==0 && rp_kind(rp[..],"replay")==JV_TRUE,"replayed permission commands observe their durable receipt");
   sm_check(s,sm_task_wait(s,rp[..],key,grant,epoch,id,"completed"),"the native tool result is followed by a completed continuation");
   sm_check(s,fs_exists(note_file)==accepted,"Allow writes the actual file and Deny leaves it absent");
   if scenario==0 {captured_path:[1200]u8;captured:=sm_in_tmp(s,"provider-notes.jsonl.prompt",captured_path[..]);seen:[16384]u8;seen_n:=fs_read(captured,seen[..]);
    sm_check(s,seen_n==XT_CONTEXT_HEADER.count+size && cast(string)seen[XT_CONTEXT_HEADER.count..<ifx seen_n>XT_CONTEXT_HEADER.count then seen_n else XT_CONTEXT_HEADER.count]==cast(string)raw[0..<size],"the actual native prompt retains instructions, knowledge and all history bytes");
    sm_check(s,rp_is(rp[..],"native_session_id","standin"),"the status exposes the actual provider session identity");_ = fs_remove(note_file);
   }
   if scenario==4 {_ = fs_remove(note_file);}
  }else if scenario==2 {
   stop:=XtRequest.{method="StopTask",task=id,command="cccccccccccccccccccccccccccccccc",issued=now,expires=b.expires};sm_task_call(s,rp[..],key,grant,epoch,stop);
   sm_check(s,rp[0].status==0 && rp_kind(rp[..],"stop_requested")==JV_TRUE,"Stop retains its request separately from the native outcome");
   sm_check(s,sm_task_wait(s,rp[..],key,grant,epoch,id,"canceled"),"an explicit native aborted-streaming result confirms interruption");
  }else {
   sm_stop(serve);serve=sm_serve(s,serve_args[..]);sm_task_call(s,rp[..],key,grant,epoch,start);
   sm_check(s,rp[0].status==0 && rp_kind(rp[..],"replay")==JV_TRUE && rp_is(rp[..],"state","unknown") && rp_is(rp[..],"error_code","resident_restarted"),"after owner loss Start observes uncertainty and never automatically repeats work");
   sm_check(s,!fs_exists(note_file),"a pending permission cannot write after resident restart");
  }
 }
 provider_log:[65536]u8;counted:=fs_read(notes,provider_log[..]);sm_check(s,counted>0 && sm_task_count(cast(string)provider_log[0..<ifx counted>0 then counted else 0],"\"task_started\":true")==4,"actual Claude prompt count stays four across Start retries and restart replay");
 codex_log:[65536]u8;counted=fs_read(sm_in_tmp(s,"codex-provider.jsonl",codex_notes_path[..]),codex_log[..]);sm_check(s,counted>0 && sm_task_count(cast(string)codex_log[0..<ifx counted>0 then counted else 0],"\"method\":\"turn/start\"")==2,"actual Codex turn/start count stays two across retries");
 forget:=[2]string.["forget",device];sm_host(s,rp[..],forget[..]);sm_check(s,rp[0].status==0,"the operator revokes the task's actual enrollment");
 read:=XtRequest.{method="ReadTask",task=ids[5]};sm_task_call(s,rp[..],key,grant,epoch,read);sm_check(s,rp[0].status==4,"a revoked enrollment cannot read retained task status");
 sm_out("Task HOST checks: ");out:[32]u8;sm_out(sm_itoa(s[0].checks,out[..]));sm_out("; failed: ");sm_out(sm_itoa(s[0].fails,out[..]));sm_out("\n");
 sm_out("Evidence: ");sm_out(sm_tmp(s));sm_out("\n");return ifx s[0].fails==0 then 0 else 1;
}
