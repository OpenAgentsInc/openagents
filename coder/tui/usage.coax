#load "../../coax/lib/agent/accounts/claude.coax";
// tool.sh: tls
// Coder book chapter 36: how much of the agent's plan limit is used.
//
// The same reads, windows, levels and timings as Zeron's composer usage
// ring (zeron crates/proto/src/plan_usage.rs, crates/ui/src/account_usage.rs,
// crates/engine/src/agent_accounts.rs):
//
// - Claude Code: the computer's provider-account adapter
//   (coax/lib/agent/accounts/claude.coax) does the whole read: its one
//   credential lookup (the Keychain item `Claude Code-credentials`, suffixed
//   with 8 hex of the SHA-256 of $CLAUDE_CONFIG_DIR when set, read without a
//   dialog; $CLAUDE_CONFIG_DIR/.credentials.json, default ~/.claude, only
//   when there is no item; a refusal is not "signed out") and its one HTTP
//   probe of https://api.anthropic.com/api/oauth/usage, in a child of this
//   program (`coder accounts-probe`). The token never reaches this process.
//   `five_hour` is the Session window, `seven_day` the Week.
// - Codex: GET https://chatgpt.com/backend-api/wham/usage with the ChatGPT
//   token and `chatgpt-account-id` from $CODEX_HOME/auth.json (default
//   ~/.codex). Its primary and secondary windows are named by their length:
//   28 days or more a Month, 5 days or more a Week, else a Session.
//
// The binding limit is the most-used window. Under 80% it is plain, from
// 80% amber, from 95% red. A probe runs at start, every 5 minutes, and when
// asked (/usage, a switch of agent) no more often than every 30 seconds;
// after a failure it waits as the shared policy says (pa_backoff_ms, Zeron's
// waits). The last answer is kept on disk, so a new terminal paints it at
// once. Codex's token goes to curl on its standard input only, never in its
// arguments or environment, and is wiped after.

US_POLL_MS :: 300000;          // Zeron's POLL_INTERVAL: usage moves as turns run
US_FORCE_MS :: 30000;          // FORCE_MIN_INTERVAL / FORCED_MIN_INTERVAL
US_HTTP_S :: "8";              // HTTP_TIMEOUT
US_WARN :: 0.80;
US_CRITICAL :: 0.95;
US_LEVEL_NORMAL :: 0; US_LEVEL_WARN :: 1; US_LEVEL_CRITICAL :: 2;
US_IDLE :: 0; US_FETCH :: 2;
US_PROV_CODEX :: 0; US_PROV_CLAUDE :: 1; US_PROV_AGY :: 2;
US_STALE_MS :: 900000;         // 15m (3 poll intervals) without a fresh read → stale
US_CODEX_URL :: "https://chatgpt.com/backend-api/wham/usage";

UsWindow :: struct {
  label: [16] u8; nlabel: int;
  used: f32;                     // 0 to 1
  reset_s: int;                  // Unix seconds, 0 when unknown
}

// One agent's login: its windows and the probe in flight.
UsAcct :: struct {
  claude: bool;                  // Claude Code, else Codex (or Antigravity when provider == US_PROV_AGY)
  provider: int;                 // US_PROV_CODEX, US_PROV_CLAUDE, US_PROV_AGY
  w: [4] UsWindow; nw: int;
  plan: [48] u8; nplan: int;
  got_ms: int;                   // when the windows were read (wall clock), 0 never
  why: [200] u8; nwhy: int;      // the last probe's failure, in plain words
  next_ms: int;                  // no probe before this (the poll, or a failure's wait)
  tried_ms: int;                 // the last probe's start
  stage: int;
  probe: [1] PaProbe;            // Claude Code's quota child (the shared adapter's)
  h: int = -1; started_ms: int;  // Codex's curl
  buf: [131072] u8; nbuf: int;   // what the running program printed
  tok: [8192] u8; ntok: int;     // the token, between reading it and handing it to curl
  acct: [128] u8; nacct: int;    // Codex's account ID
}

// ---------------------------------------------------------------- reading answers (pure)

// A JSON number's text as a fraction of 100: "84.0" → 0.84.
us_percent :: (raw: string) -> f32 {
  v: f32 = 0.0; frac: f32 = 0.0; scale: f32 = 1.0; seen := false; dot := false;
  for c: raw {
    if c >= '0' && c <= '9' {
      seen = true;
      if dot { scale = scale / 10.0; frac = frac + scale * cast(f32) cast(int) (c - '0'); }
      else { v = v * 10.0 + cast(f32) cast(int) (c - '0'); }
    } else if c == '.' { dot = true; }
    else if c == '-' || c == '+' || c == 'e' || c == 'E' { return -1.0; }
  }
  if !seen { return -1.0; }
  r := (v + frac) / 100.0;
  return ifx r < 0.0 then 0.0 else ifx r > 1.0 then 1.0 else r;
}

us_int :: (raw: string) -> int {
  v := 0; seen := false;
  for c: raw { if c >= '0' && c <= '9' { v = v * 10 + cast(int) (c - '0'); seen = true; } else if c == '.' { break; } }
  return ifx seen then v else 0;
}

us_add :: (a: [] UsAcct, label: string, used: f32, reset_s: int) {
  if a[0].nw >= a[0].w.count || used < 0.0 { return; }
  k := a[0].nw;
  a[0].w[k].nlabel = cd_cat(a[0].w[k].label[..], 0, label);
  a[0].w[k].used = used; a[0].w[k].reset_s = reset_s;
  a[0].nw += 1;
}

// Zeron's codex_window_label.
us_codex_label :: (span_s: int) -> string {
  day := 86400;
  return ifx span_s >= 28 * day then "Month" else ifx span_s >= 5 * day then "Week" else "Session";
}

// A reset time as Unix seconds or RFC 3339 (UTC).
us_when :: (raw: string, ar: [] ClArena, text: string, path: string) -> int {
  if raw.count == 0 || raw == "null" { return 0; }
  if raw[0] == '"' { us := ci_iso_us(cl_str(ar, text, path)); return us / 1000000; }
  return us_int(raw);
}

// The adapter's Claude windows as the Session and the Week; false when it has neither.
us_claude_windows :: (a: [] UsAcct, parsed: [] PaAccount) -> bool {
  a[0].nw=0;
  for i:0..<parsed[0].nw {w:=parsed[0].windows[i];id:=cast(string)w.id[0..<w.ni];if id!="five_hour" && id!="seven_day" {continue;}us_add(a,ifx id=="five_hour" then "Session" else "Week",cast(f32)w.used/10000.0,ci_iso_us(cast(string)w.reset[0..<w.nr])/1000000);}
  return a[0].nw>0;
}
// Claude's /api/oauth/usage into windows; false when it holds none.
us_read_claude :: (a: [] UsAcct, body: string) -> bool {
  parsed:[1]PaAccount;a[0].nw=0;if !pa_usage(body,parsed[..]) {return false;}
  return us_claude_windows(a,parsed[..]);
}

// "Claude Max", "ChatGPT Pro": the provider's name and the plan's, capitalized.
us_plan :: (a: [] UsAcct, provider: string, plan: string) {
  if plan.count == 0 || plan.count >= 30 { return; }
  n := cd_cat(a[0].plan[..], 0, provider);
  for c, i: plan { if n < a[0].plan.count { a[0].plan[n] = ifx i == 0 && c >= 'a' && c <= 'z' then c - 32 else c; n += 1; } }
  a[0].nplan = n;
}

// Codex's /wham/usage into windows and the live plan ("ChatGPT Pro").
us_read_codex :: (a: [] UsAcct, body: string) -> bool {
  ab: [8192] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  a[0].nw = 0;
  keys := [2] string.["rate_limit.primary_window", "rate_limit.secondary_window"];
  for i: 0..<2 {
    pb: [80] u8; pn := cd_cat(pb[..], 0, keys[i]); pn = cd_cat(pb[..], pn, ".used_percent");
    u := cl_raw(body, cast(string) pb[0..<pn]);
    if u.count == 0 || u == "null" { continue; }
    sb: [80] u8; sn := cd_cat(sb[..], 0, keys[i]); sn = cd_cat(sb[..], sn, ".limit_window_seconds");
    rb: [80] u8; rn := cd_cat(rb[..], 0, keys[i]); rn = cd_cat(rb[..], rn, ".reset_at");
    ar[0].at = 0;
    us_add(a, us_codex_label(us_int(cl_raw(body, cast(string) sb[0..<sn]))), us_percent(u), us_when(cl_raw(body, cast(string) rb[0..<rn]), ar[..], body, cast(string) rb[0..<rn]));
  }
  if a[0].nw == 0 { return false; }
  ar[0].at = 0;
  us_plan(a, "ChatGPT ", cl_str(ar[..], body, "plan_type"));
  return true;
}

// A JSON decimal in [0, 1] (e.g. remainingFraction "0.72" → 0.72), -1 on invalid.
us_fraction :: (raw: string) -> f32 {
  v: f32 = 0.0; frac: f32 = 0.0; scale: f32 = 1.0; seen := false; dot := false;
  for c: raw {
    if c >= '0' && c <= '9' {
      seen = true;
      if dot { scale = scale / 10.0; frac = frac + scale * cast(f32) cast(int) (c - '0'); }
      else { v = v * 10.0 + cast(f32) cast(int) (c - '0'); }
    } else if c == '.' { dot = true; }
    else if c == '-' || c == '+' || c == 'e' || c == 'E' { return -1.0; }
  }
  if !seen { return -1.0; }
  r := v + frac;
  return ifx r < 0.0 then 0.0 else ifx r > 1.0 then 1.0 else r;
}

// Add or tighten (keep highest used) a window with the given label.
us_add_max :: (a: [] UsAcct, label: string, used: f32, reset_s: int) {
  if used < 0.0 { return; }
  for i: 0..<a[0].nw {
    if cast(string) a[0].w[i].label[0..<a[0].w[i].nlabel] == label {
      if used > a[0].w[i].used { a[0].w[i].used = used; a[0].w[i].reset_s = reset_s; }
      return;
    }
  }
  us_add(a, label, used, reset_s);
}

us_agy_buckets :: (a: [] UsAcct, arr: string, ar: [] ClArena) {
  n := cl_count(arr);
  for i: 0..<n {
    item := cl_json(arr, cl_item(arr, i));
    if cl_raw(item, "disabled") == "true" { continue; }
    rem_raw := cl_raw(item, "remainingFraction");
    if rem_raw.count == 0 || rem_raw == "null" { continue; }
    rem := us_fraction(rem_raw);
    if rem < 0.0 { continue; }
    used := 1.0 - rem;
    ar[0].at = 0;
    win := cl_str(ar, item, "window");
    label := ifx win == "weekly" then "Week" else ifx win == "5h" then "Session" else "Quota";
    ar[0].at = 0;
    reset_s := us_when(cl_raw(item, "resetTime"), ar, item, "resetTime");
    us_add_max(a, label, used, reset_s);
  }
}

// Antigravity 1.5.x retrieveUserQuotaSummary (groups[].buckets[] or buckets[]) or
// fetchAvailableModels (models.*.quotaInfo / weeklyQuotaInfo) into windows (#13838).
us_read_antigravity :: (a: [] UsAcct, body: string) -> bool {
  ab: [16384] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  a[0].nw = 0;
  groups := cl_raw(body, "groups");
  if groups.count > 0 && groups[0] == '[' {
    ng := cl_count(groups);
    for g: 0..<ng {
      grp := cl_json(groups, cl_item(groups, g));
      b := cl_raw(grp, "buckets");
      if b.count > 0 && b[0] == '[' { us_agy_buckets(a, b, ar[..]); }
    }
  }
  if a[0].nw == 0 {
    b := cl_raw(body, "buckets");
    if b.count > 0 && b[0] == '[' { us_agy_buckets(a, b, ar[..]); }
  }
  // Fallback: fetchAvailableModels response with quotaInfo / weeklyQuotaInfo
  if a[0].nw == 0 {
    models := cl_raw(body, "models");
    if models.count > 0 && models[0] == '{' {
      qkeys := [2] string.["quotaInfo", "weeklyQuotaInfo"];
      qlabels := [2] string.["Quota", "Week"];
      // Scan top-level model objects inside models: { "gemini-...": { ... }, ... }
      pos := 1;
      while pos < models.count {
        while pos < models.count && (models[pos] == ' ' || models[pos] == '\n' || models[pos] == '\r' || models[pos] == '\t' || models[pos] == ',') { pos += 1; }
        if pos >= models.count || models[pos] == '}' { break; }
        if models[pos] != '"' { break; }
        pos += 1;
        while pos < models.count && models[pos] != '"' { if models[pos] == '\\' { pos += 1; } pos += 1; }
        if pos >= models.count { break; }
        pos += 1;
        while pos < models.count && (models[pos] == ' ' || models[pos] == ':' || models[pos] == '\t' || models[pos] == '\n' || models[pos] == '\r') { pos += 1; }
        if pos >= models.count || models[pos] != '{' { break; }
        obj_start := pos;
        depth := 0; in_str := false; esc := false;
        while pos < models.count {
          ch := models[pos];
          if in_str {
            if esc { esc = false; }
            else if ch == '\\' { esc = true; }
            else if ch == '"' { in_str = false; }
          } else {
            if ch == '"' { in_str = true; }
            else if ch == '{' { depth += 1; }
            else if ch == '}' { depth -= 1; if depth == 0 { pos += 1; break; } }
          }
          pos += 1;
        }
        mobj := cast(string) models[obj_start..<pos];
        for qi: 0..<2 {
          q := cl_raw(mobj, qkeys[qi]);
          if q.count == 0 || q == "null" { continue; }
          rem_raw := cl_raw(q, "remainingFraction");
          if rem_raw.count == 0 || rem_raw == "null" { continue; }
          rem := us_fraction(rem_raw);
          if rem < 0.0 { continue; }
          ar[0].at = 0;
          reset_s := us_when(cl_raw(q, "resetTime"), ar[..], q, "resetTime");
          us_add_max(a, qlabels[qi], 1.0 - rem, reset_s);
        }
      }
    }
  }
  if a[0].nw == 0 { return false; }
  if a[0].nplan == 0 { a[0].nplan = cd_cat(a[0].plan[..], 0, "Antigravity"); }
  return true;
}

// Explicit usage state matching docs/protocol/provider-accounts-v1.md (#13838).
us_status_label :: (a: [] UsAcct, now_ms: int) -> string {
  if a[0].nw > 0 {
    if a[0].got_ms > 0 && now_ms > a[0].got_ms && now_ms - a[0].got_ms > US_STALE_MS { return "stale"; }
    return "observed";
  }
  why := cast(string) a[0].why[0..<a[0].nwhy];
  if rt_has_prefix(why, "signed_out") || s_has(why, "isn't signed in") { return "signed_out"; }
  return "unavailable";
}

// The binding limit: the most-used window, -1 when none.
us_binding :: (a: [] UsAcct) -> int {
  best := -1;
  for i: 0..<a[0].nw { if best < 0 || a[0].w[i].used > a[0].w[best].used { best = i; } }
  return best;
}

us_level :: (f: f32) -> int { return ifx f >= US_CRITICAL then US_LEVEL_CRITICAL else ifx f >= US_WARN then US_LEVEL_WARN else US_LEVEL_NORMAL; }

// A ring filled to f, in quarters.
us_ring :: (f: f32) -> string { return ifx f < 0.125 then "○" else ifx f < 0.375 then "◔" else ifx f < 0.625 then "◑" else ifx f < 0.875 then "◕" else "●"; }

us_pct :: (f: f32, out: [] u8) -> string {
  p := cast(int) (f * 100.0 + 0.5);
  tb: [16] u8; n := cd_cat(out, 0, cd_itoa(p, tb[..])); n = cd_cat(out, n, "%");
  return cast(string) out[0..<n];
}

// "◕ Week 84%": the hint row's segment, "" when there is nothing to show.
us_segment :: (a: [] UsAcct, out: [] u8) -> string {
  b := us_binding(a);
  if b < 0 { return ""; }
  w := a[0].w[b];
  pb: [16] u8;
  n := cd_cat(out, 0, us_ring(w.used)); n = cd_cat(out, n, " ");
  n = cd_cat(out, n, cast(string) w.label[0..<w.nlabel]); n = cd_cat(out, n, " ");
  n = cd_cat(out, n, us_pct(w.used, pb[..]));
  return cast(string) out[0..<n];
}

// "4d 17h", "3h 10m", "12m": how long until a reset.
us_until :: (s: int, out: [] u8) -> string {
  tb: [16] u8; n := 0;
  if s <= 0 { return "now"; }
  d := s / 86400; h := (s % 86400) / 3600; m := (s % 3600) / 60;
  if d > 0 { n = cd_cat(out, n, cd_itoa(d, tb[..])); n = cd_cat(out, n, "d "); n = cd_cat(out, n, cd_itoa(h, tb[..])); n = cd_cat(out, n, "h"); }
  else if h > 0 { n = cd_cat(out, n, cd_itoa(h, tb[..])); n = cd_cat(out, n, "h "); n = cd_cat(out, n, cd_itoa(m, tb[..])); n = cd_cat(out, n, "m"); }
  else { n = cd_cat(out, n, cd_itoa(ifx m > 0 then m else 1, tb[..])); n = cd_cat(out, n, "m"); }
  return cast(string) out[0..<n];
}

// One meter line: "Week     ████████░░  84%  resets in 4d 17h". A used window shows at least one cell.
us_meter :: (w_in: UsWindow, now_s: int, out: [] u8) -> string {
  w := w_in;
  n := cd_cat(out, 0, cast(string) w.label[0..<w.nlabel]);
  for i: w.nlabel..<9 { n = cd_cat(out, n, " "); }
  cells := cast(int) (w.used * 10.0 + 0.5);
  if w.used > 0.0 && cells == 0 { cells = 1; }
  for i: 0..<10 { n = cd_cat(out, n, ifx i < cells then "█" else "░"); }
  pb: [16] u8; p := us_pct(w.used, pb[..]);
  for i: p.count..<5 { n = cd_cat(out, n, " "); }
  n = cd_cat(out, n, p);
  if w.reset_s > 0 { ub: [32] u8; n = cd_cat(out, n, "  resets in "); n = cd_cat(out, n, us_until(w.reset_s - now_s, ub[..])); }
  return cast(string) out[0..<n];
}

// ---------------------------------------------------------------- where the logins are

us_env :: (name: string, out: [] u8) -> string { return cl_getenv(name, out); }

// Codex's endpoint, or the fake provider a check names. Claude's is the adapter's (pa_usage_url).
us_url :: (out: [] u8) -> string {
  u := us_env("CODER_USAGE_CODEX_URL", out);
  return ifx u.count > 0 then u else US_CODEX_URL;
}

// ---------------------------------------------------------------- the probe

us_why :: (a: [] UsAcct, s: string) { a[0].nwhy = cd_cat(a[0].why[..], 0, s); }

us_wipe :: (a: [] UsAcct) {
  for i: 0..<a[0].ntok { a[0].tok[i] = 0; } a[0].ntok = 0;
  for i: 0..<a[0].nbuf { a[0].buf[i] = 0; } a[0].nbuf = 0;
}

us_end :: (a: [] UsAcct) {
  if a[0].h >= 0 { x := cxproc_close_stdin(a[0].h); y := cxproc_kill(a[0].h, 9); z := cxproc_wait(a[0].h, 500); r := cxproc_release(a[0].h); a[0].h = -1; }
  p := a[0].probe[..];
  if p[0].h >= 0 { r := proc_release(p[0].h); p[0].h = -1; }
  for i: 0..<p[0].n { p[0].raw[i] = 0; } p[0].n = 0;
  us_wipe(a);
  a[0].stage = US_IDLE;
}

us_fail :: (a: [] UsAcct, status: int, retry_after_s: int, why: string) {
  us_end(a);
  us_why(a, why);
  a[0].next_ms = cxproc_now_ms() + pa_backoff_ms(status, retry_after_s);
}

us_spawn :: (a: [] UsAcct, argv: [] string) -> bool {
  h := cxproc_new();
  if h < 0 { return false; }
  ok := true;
  for arg: argv { for b: arg { if b == 0 || cxproc_push(h, 0, cast(int) b) != 0 { ok = false; } } ok = ok && cxproc_end(h, 0) == 0; }
  if !ok || cxproc_spawn(h) != 0 { r := cxproc_release(h); return false; }
  a[0].h = h; a[0].started_ms = cxproc_now_ms(); a[0].nbuf = 0;
  return true;
}

// Codex's token and account ID from auth.json into a[0].tok and a[0].acct; false when it holds none.
us_take_token :: (a: [] UsAcct, blob: string) -> bool {
  ab: [16384] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  t := cl_str(ar[..], blob, "tokens.access_token");
  ok := t.count > 0 && t.count < a[0].tok.count;
  if ok { a[0].ntok = cd_cat(a[0].tok[..], 0, t); }
  a[0].nacct = cd_cat(a[0].acct[..], 0, cl_str(ar[..], blob, "tokens.account_id"));
  for i: 0..<ab.count { ab[i] = 0; }
  return ok;
}

// Starts curl with Codex's token on its standard input (curl -K -).
us_fetch :: (a: [] UsAcct) {
  ub: [1024] u8; url := us_url(ub[..]);
  argv := [9] string.["curl", "-sS", "-m", US_HTTP_S, "-D", "-", "-K", "-", url];
  if !us_spawn(a, argv[..]) { us_fail(a, 0, 0, "curl did not start"); return; }
  cb: [9000] u8; n := 0;
  n = cd_cat(cb[..], n, "header = \"Authorization: Bearer "); n = cd_cat(cb[..], n, cast(string) a[0].tok[0..<a[0].ntok]); n = cd_cat(cb[..], n, "\"\n");
  n = cd_cat(cb[..], n, "header = \"chatgpt-account-id: "); n = cd_cat(cb[..], n, cast(string) a[0].acct[0..<a[0].nacct]); n = cd_cat(cb[..], n, "\"\n");
  for i: 0..<n { x := cxproc_write(a[0].h, cast(int) cb[i]); }
  y := cxproc_flush(a[0].h); z := cxproc_close_stdin(a[0].h);
  for i: 0..<cb.count { cb[i] = 0; }
  us_wipe(a);
  a[0].stage = US_FETCH;
}

// Starts a probe: Claude's through the shared adapter's child; Codex's reads its login, then fetches.
// Antigravity quota probing via direct OAuth token extraction is intentionally disabled (#13995).
// Nothing when one is running.
us_probe :: (a: [] UsAcct) {
  if a[0].stage != US_IDLE { return; }
  a[0].tried_ms = cxproc_now_ms();
  db: [1300] u8;
  if a[0].claude || a[0].provider == US_PROV_CLAUDE {
    if !pa_quota_start(a[0].probe[..], pa_system_dir(db[..]), true, a[0].tried_ms) { us_fail(a, 0, 0, "the usage check did not start"); return; }
    a[0].stage = US_FETCH;
    return;
  }
  if a[0].provider == US_PROV_AGY {
    us_fail(a, -1, 0, "unavailable: Antigravity quota requires official agy CLI support");
    return;
  }
  pb: [1400] u8; pn := 0;
  d := us_env("CODEX_HOME", db[..]);
  if d.count == 0 { hb: [1024] u8; home := cl_getenv("HOME", hb[..]); dn := cd_cat(db[..], 0, home); dn = cd_cat(db[..], dn, "/.codex"); d = cast(string) db[0..<dn]; }
  pn = cd_cat(pb[..], 0, d); pn = cd_cat(pb[..], pn, "/auth.json");
  fb: [32768] u8; m := fs_read(cast(string) pb[0..<pn], fb[..]);
  if m > 0 {
    took := us_take_token(a, cast(string) fb[0..<m]);
    for i: 0..<m { fb[i] = 0; }
    if took { us_fetch(a); return; }
    us_fail(a, -1, 0, "Codex is signed in with an API key, which has no plan limits"); return;
  }
  us_fail(a, -1, 0, "Codex isn't signed in here");
}

// What the terminal says about a Claude probe that did not read limits.
// ok: the child gave its frame; status: how the child ended (PROC_RUNNING: cut off).
us_claude_why :: (ok: bool, status: int, code: int, error: string, out: [] u8) -> string {
  if !ok { return ifx status == PROC_RUNNING then "the usage service didn't answer" else "the usage check did not finish"; }
  if error == "credentials_unavailable" { return "Claude Code isn't signed in here"; }
  if error == "keychain_denied" { return "macOS Keychain denied access to the Claude Code login"; }
  if error == "credentials_unreadable" { return "the Claude Code login has no token"; }
  if code == 0 { return "the usage service didn't answer"; }
  if code == 200 { return "the usage answer held no limits"; }
  tb: [16] u8; n := cd_cat(out, 0, "the usage service answered "); n = cd_cat(out, n, cd_itoa(code, tb[..]));
  return cast(string) out[0..<n];
}

// The end of Claude's probe: the windows, or the failure and its wait.
us_claude_done :: (a: [] UsAcct, status: int, now: int) -> bool {
  next: [1] PaAccount; code := [1] int.[0]; retry := [1] int.[0];
  ok := pa_quota_read(a[0].probe[..], status, next[..], code[..], retry[..]);
  error := ifx ok then cast(string) next[0].error[0..<next[0].ner] else "";
  if ok { us_plan(a, "Claude ", cast(string) next[0].plan[0..<next[0].np]); }
  if ok && code[0] == 200 && next[0].ner == 0 && us_claude_windows(a, next[..]) { return us_done(a, now); }
  wb: [80] u8;
  us_fail(a, ifx ok then pa_quota_status(code[0], error) else 0, retry[0], us_claude_why(ok, status, code[0], error, wb[..]));
  return false;
}

// A probe that read limits: kept, saved, and the next one in 5 minutes.
us_done :: (a: [] UsAcct, now: int) -> bool {
  us_end(a);
  a[0].nwhy = 0;
  a[0].got_ms = cxproc_wall_us() / 1000;
  a[0].next_ms = now + US_POLL_MS;
  us_save(a);
  return true;
}

// Reads what the running program printed; true when the probe ended.
us_drain :: (a: [] UsAcct) -> bool {
  for guard: 0..<4096 {
    n := cxproc_read_line(a[0].h, 0);
    if n == -2 { return false; }
    if n < 0 { return true; }
    for i: 0..<n { if a[0].nbuf < a[0].buf.count { a[0].buf[a[0].nbuf] = cast,trunc(u8) cxproc_line_byte(a[0].h, i); a[0].nbuf += 1; } }
    if a[0].nbuf < a[0].buf.count { a[0].buf[a[0].nbuf] = 10; a[0].nbuf += 1; }
  }
  return false;
}

// The answer of curl -D -: its status, Retry-After and body (after the last header block).
us_answer :: (a: [] UsAcct, status_out: [] int, retry_out: [] int) -> string {
  text := cast(string) a[0].buf[0..<a[0].nbuf];
  status := 0; retry := 0; body_at := 0; at := 0; in_head := false;
  while at < text.count {
    e := at; while e < text.count && text[e] != 10 { e += 1; }
    line := cast(string) text[at..<(ifx e > at && text[e - 1] == 13 then e - 1 else e)];
    next := e + 1;
    if !in_head && rt_has_prefix(line, "HTTP/") {
      in_head = true;
      sp := 0; while sp < line.count && line[sp] != ' ' { sp += 1; }
      status = us_int(cast(string) line[sp..<(ifx sp + 4 <= line.count then sp + 4 else line.count)]);
    } else if in_head && line.count == 0 {
      in_head = false; body_at = next;
    } else if in_head && line.count > 12 && (line[0] == 'r' || line[0] == 'R') {
      lb: [16] u8; for i: 0..<12 { lb[i] = ifx line[i] >= 'A' && line[i] <= 'Z' then line[i] + 32 else line[i]; }
      if cast(string) lb[0..<12] == "retry-after:" { retry = us_int(cast(string) line[12..<line.count]); }
    }
    at = next;
  }
  status_out[0] = status; retry_out[0] = retry;
  return ifx body_at <= text.count then cast(string) text[body_at..<text.count] else "";
}

// Saves the windows, so the next start paints them at once.
us_cache_name :: (a: [] UsAcct) -> string {
  if a[0].claude || a[0].provider == US_PROV_CLAUDE { return "/../usage-claude.txt"; }
  if a[0].provider == US_PROV_AGY { return "/../usage-antigravity.txt"; }
  return "/../usage-codex.txt";
}

us_save :: (a: [] UsAcct) {
  db: [1100] u8; dir := cs_dir(db[..]);
  if dir.count == 0 { return; }
  pb: [1300] u8; pn := cd_cat(pb[..], 0, dir); pn = cd_cat(pb[..], pn, us_cache_name(a));
  ob: [2048] u8; tb: [32] u8;
  n := cd_cat(ob[..], 0, cd_itoa(a[0].got_ms, tb[..])); n = cd_cat(ob[..], n, "\n"); n = cd_cat(ob[..], n, cast(string) a[0].plan[0..<a[0].nplan]); n = cd_cat(ob[..], n, "\n");
  for i: 0..<a[0].nw {
    w := a[0].w[i];
    n = cd_cat(ob[..], n, cast(string) w.label[0..<w.nlabel]); n = cd_cat(ob[..], n, " ");
    n = cd_cat(ob[..], n, cd_itoa(cast(int) (w.used * 10000.0 + 0.5), tb[..])); n = cd_cat(ob[..], n, " ");
    n = cd_cat(ob[..], n, cd_itoa(w.reset_s, tb[..])); n = cd_cat(ob[..], n, "\n");
  }
  x := fs_write(cast(string) pb[0..<pn], cast(string) ob[0..<n]);
}

us_load :: (a: [] UsAcct) {
  db: [1100] u8; dir := cs_dir(db[..]);
  if dir.count == 0 { return; }
  pb: [1300] u8; pn := cd_cat(pb[..], 0, dir); pn = cd_cat(pb[..], pn, us_cache_name(a));
  fb: [2048] u8; m := fs_read(cast(string) pb[0..<pn], fb[..]);
  if m <= 0 { return; }
  text := cast(string) fb[0..<m];
  at := 0; line_no := 0; a[0].nw = 0;
  while at < text.count {
    e := at; while e < text.count && text[e] != 10 { e += 1; }
    line := cast(string) text[at..<e]; at = e + 1;
    if line_no == 0 { a[0].got_ms = us_int(line); }
    else if line_no == 1 { a[0].nplan = cd_cat(a[0].plan[..], 0, line); }
    else {
      s1 := 0; while s1 < line.count && line[s1] != ' ' { s1 += 1; }
      s2 := s1 + 1; while s2 < line.count && line[s2] != ' ' { s2 += 1; }
      if s2 < line.count {
        us_add(a, cast(string) line[0..<s1], cast(f32) us_int(cast(string) line[s1 + 1..<s2]) / 10000.0, us_int(cast(string) line[s2 + 1..<line.count]));
      }
    }
    line_no += 1;
  }
}

// One step of the probe without waiting; true when the windows changed.
us_tick :: (a: [] UsAcct) -> bool {
  now := cxproc_now_ms();
  if a[0].stage == US_IDLE {
    if now >= a[0].next_ms { us_probe(a); }
    return false;
  }
  if a[0].claude || a[0].provider == US_PROV_CLAUDE {
    status := pa_child_tick(a[0].probe[..], now);
    if a[0].probe[0].h >= 0 { return false; }
    return us_claude_done(a, status, now);
  }
  // US_FETCH
  done := us_drain(a);
  if !done && now - a[0].started_ms < 20000 { return false; }
  st: [1] int; ra: [1] int;
  body := us_answer(a, st[..], ra[..]);
  if st[0] == 0 { us_fail(a, 0, 0, "the usage service didn't answer"); return false; }
  if st[0] != 200 {
    if a[0].provider == US_PROV_AGY && (st[0] == 401 || st[0] == 403) {
      us_fail(a, st[0], ra[0], "signed_out: Antigravity session expired"); return false;
    }
    tb: [16] u8; wb: [80] u8; wn := cd_cat(wb[..], 0, "the usage service answered "); wn = cd_cat(wb[..], wn, cd_itoa(st[0], tb[..]));
    us_fail(a, st[0], ra[0], cast(string) wb[0..<wn]); return false;
  }
  bb: [131072] u8; bn := cd_cat(bb[..], 0, body);
  ok := ifx a[0].provider == US_PROV_AGY then us_read_antigravity(a, cast(string) bb[0..<bn]) else us_read_codex(a, cast(string) bb[0..<bn]);
  if !ok { us_fail(a, -2, 0, "the usage answer held no limits"); return false; }
  return us_done(a, now);
}

// Asks for a fresh read now, no more often than every 30 seconds, and not inside a failure's wait.
us_force :: (a: [] UsAcct) {
  now := cxproc_now_ms();
  if a[0].stage != US_IDLE || now - a[0].tried_ms < US_FORCE_MS { return; }
  if a[0].nwhy > 0 && now < a[0].next_ms { return; }
  a[0].next_ms = now;
}

#test "usage: Claude's and Codex's answers, levels, the ring, meters and waits (Zeron's rules)" {
  a: [1] UsAcct; a[0] = UsAcct.{claude = true};
  #assert us_read_claude(a[..], "{\"five_hour\":null,\"seven_day\":{\"utilization\":84.0,\"resets_at\":\"1970-01-02T00:00:00.000+00:00\"}}");
  #assert a[0].nw == 1;
  #assert cast(string) a[0].w[0].label[0..<a[0].w[0].nlabel] == "Week";
  #assert a[0].w[0].reset_s == 86400;
  sb: [64] u8;
  #assert us_segment(a[..], sb[..]) == "◕ Week 84%";
  #assert us_level(0.84) == US_LEVEL_WARN && us_level(0.95) == US_LEVEL_CRITICAL && us_level(0.5) == US_LEVEL_NORMAL;
  #assert !us_read_claude(a[..], "{\"five_hour\":null,\"seven_day\":null}");
  #assert us_read_claude(a[..], "{\"five_hour\":{\"utilization\":12.5,\"resets_at\":null},\"seven_day\":{\"utilization\":3,\"resets_at\":null}}");
  #assert a[0].nw == 2 && us_binding(a[..]) == 0;
  c: [1] UsAcct;
  #assert us_read_codex(c[..], "{\"plan_type\":\"pro\",\"rate_limit\":{\"primary_window\":{\"used_percent\":3,\"limit_window_seconds\":604800,\"reset_at\":1794234083},\"secondary_window\":null}}");
  #assert c[0].nw == 1 && c[0].w[0].reset_s == 1794234083;
  #assert cast(string) c[0].plan[0..<c[0].nplan] == "ChatGPT Pro";
  #assert us_codex_label(2592000) == "Month" && us_codex_label(18000) == "Session" && us_codex_label(604800) == "Week";
  mb: [128] u8;
  #assert us_meter(c[0].w[0], 1794234083 - 90000, mb[..]) == "Week     █░░░░░░░░░   3%  resets in 1d 1h";
  #assert us_ring(0.0) == "○" && us_ring(0.99) == "●";
}

#test "usage: what the terminal says for each Claude probe failure, and the wait it gets" {
  b: [80] u8;
  #assert us_claude_why(true, 0, 0, "credentials_unavailable", b[..]) == "Claude Code isn't signed in here" && pa_backoff_ms(pa_quota_status(0, "credentials_unavailable"), 0) == 600000;
  #assert us_claude_why(true, 0, 0, "keychain_denied", b[..]) == "macOS Keychain denied access to the Claude Code login" && pa_backoff_ms(pa_quota_status(0, "keychain_denied"), 0) == 600000;
  #assert us_claude_why(true, 0, 0, "credentials_unreadable", b[..]) == "the Claude Code login has no token";
  #assert us_claude_why(true, 0, 0, "usage_unavailable", b[..]) == "the usage service didn't answer" && pa_backoff_ms(pa_quota_status(0, "usage_unavailable"), 0) == 30000;
  #assert us_claude_why(true, 0, 401, "login_required", b[..]) == "the usage service answered 401" && pa_backoff_ms(pa_quota_status(401, "login_required"), 0) == 600000;
  #assert us_claude_why(true, 0, 429, "rate_limited", b[..]) == "the usage service answered 429" && pa_backoff_ms(pa_quota_status(429, "rate_limited"), 90) == 90000;
  #assert us_claude_why(true, 0, 503, "usage_unavailable", b[..]) == "the usage service answered 503" && pa_backoff_ms(pa_quota_status(503, "usage_unavailable"), 0) == 60000;
  #assert us_claude_why(true, 0, 200, "usage_unavailable", b[..]) == "the usage answer held no limits" && pa_backoff_ms(pa_quota_status(200, "usage_unavailable"), 0) == 900000;
  #assert us_claude_why(false, PROC_RUNNING, 0, "", b[..]) == "the usage service didn't answer" && us_claude_why(false, 1, 0, "", b[..]) == "the usage check did not finish";
  a: [1] UsAcct; us_plan(a[..], "Claude ", "max");
  #assert cast(string) a[0].plan[0..<a[0].nplan] == "Claude Max";
  a[0].nplan = 0; us_plan(a[..], "Claude ", ""); #assert a[0].nplan == 0;
}

#test "usage: Antigravity 1.5.x Summary and Models quota parsing, disabled buckets, and status states (#13838)" {
  // 1. retrieveUserQuotaSummary with groups[].buckets[], disabled bucket ignored, highest used kept
  a: [1] UsAcct; a[0].provider = US_PROV_AGY;
  sum := "{\"groups\":[{\"displayName\":\"Gemini\",\"buckets\":[{\"bucketId\":\"gemini-5h\",\"window\":\"5h\",\"remainingFraction\":0.28,\"resetTime\":\"1970-01-02T00:00:00Z\"},{\"bucketId\":\"gemini-wk\",\"window\":\"weekly\",\"remainingFraction\":0.85,\"resetTime\":\"1970-01-08T00:00:00Z\"},{\"bucketId\":\"disabled-1\",\"window\":\"5h\",\"remainingFraction\":0.0,\"disabled\":true}]}]}";
  #assert us_read_antigravity(a[..], sum);
  #assert a[0].nw == 2;
  #assert cast(string) a[0].w[0].label[0..<a[0].w[0].nlabel] == "Session" && a[0].w[0].reset_s == 86400;
  #assert a[0].w[0].used > 0.71 && a[0].w[0].used < 0.73;
  #assert cast(string) a[0].w[1].label[0..<a[0].w[1].nlabel] == "Week" && a[0].w[1].used > 0.14 && a[0].w[1].used < 0.16;
  #assert cast(string) a[0].plan[0..<a[0].nplan] == "Antigravity";
  a[0].got_ms = 1000000;
  #assert us_status_label(a[..], 1000000 + 60000) == "observed";
  #assert us_status_label(a[..], 1000000 + US_STALE_MS + 1) == "stale";

  // 2. fetchAvailableModels fallback with quotaInfo + weeklyQuotaInfo
  m: [1] UsAcct; m[0].provider = US_PROV_AGY;
  mod_json := "{\"models\":{\"gemini-3-pro\":{\"quotaInfo\":{\"remainingFraction\":0.40,\"resetTime\":\"1970-01-03T00:00:00Z\"},\"weeklyQuotaInfo\":{\"remainingFraction\":0.90}}}}";
  #assert us_read_antigravity(m[..], mod_json);
  #assert m[0].nw == 2;
  #assert cast(string) m[0].w[0].label[0..<m[0].w[0].nlabel] == "Quota" && m[0].w[0].used > 0.59 && m[0].w[0].used < 0.61;
  #assert cast(string) m[0].w[1].label[0..<m[0].w[1].nlabel] == "Week" && m[0].w[1].used > 0.09 && m[0].w[1].used < 0.11;

  // 3. Explicit signed_out and unavailable states
  s: [1] UsAcct; s[0].provider = US_PROV_AGY;
  us_why(s[..], "signed_out: Antigravity isn't signed in here");
  #assert us_status_label(s[..], 0) == "signed_out";
  us_why(s[..], "unavailable: the usage service answered 503");
  #assert us_status_label(s[..], 0) == "unavailable";
  #assert !us_read_antigravity(s[..], "{}");
}
