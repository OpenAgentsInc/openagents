// Coder book chapter 36: how much of the agent's plan limit is used.
//
// The same reads, windows, levels and timings as Zeron's composer usage
// ring (zeron crates/proto/src/plan_usage.rs, crates/ui/src/account_usage.rs,
// crates/engine/src/agent_accounts.rs):
//
// - Claude Code: GET https://api.anthropic.com/api/oauth/usage with the
//   login's OAuth token and `anthropic-beta: oauth-2025-04-20`. The token is
//   in $CLAUDE_CONFIG_DIR/.credentials.json (default ~/.claude), or on macOS
//   the Keychain item `Claude Code-credentials` (suffixed with 8 hex of the
//   SHA-256 of $CLAUDE_CONFIG_DIR when set), read with /usr/bin/security,
//   the program Claude Code itself saves it with. `five_hour` is the
//   Session window, `seven_day` the Week, each a 0-100 utilization.
// - Codex: GET https://chatgpt.com/backend-api/wham/usage with the ChatGPT
//   token and `chatgpt-account-id` from $CODEX_HOME/auth.json (default
//   ~/.codex). Its primary and secondary windows are named by their length:
//   28 days or more a Month, 5 days or more a Week, else a Session.
//
// The binding limit is the most-used window. Under 80% it is plain, from
// 80% amber, from 95% red. A probe runs at start, every 5 minutes, and when
// asked (/usage, a switch of agent) no more often than every 30 seconds;
// after a failure it waits as Zeron does. The last answer is kept on disk,
// so a new terminal paints it at once. Tokens go to curl on its standard
// input only, never in its arguments or environment, and are wiped after.

US_POLL_MS :: 300000;          // Zeron's POLL_INTERVAL: usage moves as turns run
US_FORCE_MS :: 30000;          // FORCE_MIN_INTERVAL / FORCED_MIN_INTERVAL
US_KEYCHAIN_MS :: 15000;       // an unanswered Keychain dialog would block security forever
US_HTTP_S :: "8";              // HTTP_TIMEOUT
US_WARN :: 0.80;
US_CRITICAL :: 0.95;
US_LEVEL_NORMAL :: 0; US_LEVEL_WARN :: 1; US_LEVEL_CRITICAL :: 2;
US_IDLE :: 0; US_TOKEN :: 1; US_FETCH :: 2;
US_CLAUDE_URL :: "https://api.anthropic.com/api/oauth/usage";
US_CODEX_URL :: "https://chatgpt.com/backend-api/wham/usage";

UsWindow :: struct {
  label: [16] u8; nlabel: int;
  used: f32;                     // 0 to 1
  reset_s: int;                  // Unix seconds, 0 when unknown
}

// One agent's login: its windows and the probe in flight.
UsAcct :: struct {
  claude: bool;                  // Claude Code, else Codex
  w: [4] UsWindow; nw: int;
  plan: [48] u8; nplan: int;
  got_ms: int;                   // when the windows were read (wall clock), 0 never
  why: [200] u8; nwhy: int;      // the last probe's failure, in plain words
  next_ms: int;                  // no probe before this (the poll, or a failure's wait)
  tried_ms: int;                 // the last probe's start
  stage: int;
  h: int = -1; started_ms: int;
  buf: [131072] u8; nbuf: int;   // what the running program printed
  tok: [8192] u8; ntok: int;     // the token, between reading it and handing it to curl
  acct: [128] u8; nacct: int;    // Codex's account ID
}

// ---------------------------------------------------------------- reading answers (pure)

// A JSON number's text as a fraction of 100: "84.0" → 0.84.
us_percent :: (raw: string) -> f32 {
  v: f32 = 0.0; frac: f32 = 0.0; scale: f32 = 1.0; seen := false; dot := false;
  for c: raw {
    if c >= '0' && c <= '9' {
      seen = true;
      if dot { scale = scale / 10.0; frac = frac + scale * cast(f32) cast(int) (c - '0'); }
      else { v = v * 10.0 + cast(f32) cast(int) (c - '0'); }
    } else if c == '.' { dot = true; }
    else if c == '-' || c == '+' || c == 'e' || c == 'E' { return -1.0; }
  }
  if !seen { return -1.0; }
  r := (v + frac) / 100.0;
  return ifx r < 0.0 then 0.0 else ifx r > 1.0 then 1.0 else r;
}

us_int :: (raw: string) -> int {
  v := 0; seen := false;
  for c: raw { if c >= '0' && c <= '9' { v = v * 10 + cast(int) (c - '0'); seen = true; } else if c == '.' { break; } }
  return ifx seen then v else 0;
}

us_add :: (a: [] UsAcct, label: string, used: f32, reset_s: int) {
  if a[0].nw >= a[0].w.count || used < 0.0 { return; }
  k := a[0].nw;
  a[0].w[k].nlabel = cd_cat(a[0].w[k].label[..], 0, label);
  a[0].w[k].used = used; a[0].w[k].reset_s = reset_s;
  a[0].nw += 1;
}

// Zeron's codex_window_label.
us_codex_label :: (span_s: int) -> string {
  day := 86400;
  return ifx span_s >= 28 * day then "Month" else ifx span_s >= 5 * day then "Week" else "Session";
}

// A reset time as Unix seconds or RFC 3339 (UTC).
us_when :: (raw: string, ar: [] ClArena, text: string, path: string) -> int {
  if raw.count == 0 || raw == "null" { return 0; }
  if raw[0] == '"' { us := ci_iso_us(cl_str(ar, text, path)); return us / 1000000; }
  return us_int(raw);
}

// Claude's /api/oauth/usage into windows; false when it holds none.
us_read_claude :: (a: [] UsAcct, body: string) -> bool {
  ab: [8192] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  a[0].nw = 0;
  keys := [2] string.["five_hour", "seven_day"];
  labels := [2] string.["Session", "Week"];
  for i: 0..<2 {
    pb: [64] u8; pn := cd_cat(pb[..], 0, keys[i]); pn = cd_cat(pb[..], pn, ".utilization");
    u := cl_raw(body, cast(string) pb[0..<pn]);
    if u.count == 0 || u == "null" { continue; }
    rb: [64] u8; rn := cd_cat(rb[..], 0, keys[i]); rn = cd_cat(rb[..], rn, ".resets_at");
    ar[0].at = 0;
    us_add(a, labels[i], us_percent(u), us_when(cl_raw(body, cast(string) rb[0..<rn]), ar[..], body, cast(string) rb[0..<rn]));
  }
  return a[0].nw > 0;
}

// Codex's /wham/usage into windows and the live plan ("ChatGPT Pro").
us_read_codex :: (a: [] UsAcct, body: string) -> bool {
  ab: [8192] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  a[0].nw = 0;
  keys := [2] string.["rate_limit.primary_window", "rate_limit.secondary_window"];
  for i: 0..<2 {
    pb: [80] u8; pn := cd_cat(pb[..], 0, keys[i]); pn = cd_cat(pb[..], pn, ".used_percent");
    u := cl_raw(body, cast(string) pb[0..<pn]);
    if u.count == 0 || u == "null" { continue; }
    sb: [80] u8; sn := cd_cat(sb[..], 0, keys[i]); sn = cd_cat(sb[..], sn, ".limit_window_seconds");
    rb: [80] u8; rn := cd_cat(rb[..], 0, keys[i]); rn = cd_cat(rb[..], rn, ".reset_at");
    ar[0].at = 0;
    us_add(a, us_codex_label(us_int(cl_raw(body, cast(string) sb[0..<sn]))), us_percent(u), us_when(cl_raw(body, cast(string) rb[0..<rn]), ar[..], body, cast(string) rb[0..<rn]));
  }
  if a[0].nw == 0 { return false; }
  ar[0].at = 0;
  plan := cl_str(ar[..], body, "plan_type");
  if plan.count > 0 && plan.count < 30 {
    n := cd_cat(a[0].plan[..], 0, "ChatGPT ");
    for c, i: plan { if n < a[0].plan.count { a[0].plan[n] = ifx i == 0 && c >= 'a' && c <= 'z' then c - 32 else c; n += 1; } }
    a[0].nplan = n;
  }
  return true;
}

// The binding limit: the most-used window, -1 when none.
us_binding :: (a: [] UsAcct) -> int {
  best := -1;
  for i: 0..<a[0].nw { if best < 0 || a[0].w[i].used > a[0].w[best].used { best = i; } }
  return best;
}

us_level :: (f: f32) -> int { return ifx f >= US_CRITICAL then US_LEVEL_CRITICAL else ifx f >= US_WARN then US_LEVEL_WARN else US_LEVEL_NORMAL; }

// A ring filled to f, in quarters.
us_ring :: (f: f32) -> string { return ifx f < 0.125 then "○" else ifx f < 0.375 then "◔" else ifx f < 0.625 then "◑" else ifx f < 0.875 then "◕" else "●"; }

us_pct :: (f: f32, out: [] u8) -> string {
  p := cast(int) (f * 100.0 + 0.5);
  tb: [16] u8; n := cd_cat(out, 0, cd_itoa(p, tb[..])); n = cd_cat(out, n, "%");
  return cast(string) out[0..<n];
}

// "◕ Week 84%": the hint row's segment, "" when there is nothing to show.
us_segment :: (a: [] UsAcct, out: [] u8) -> string {
  b := us_binding(a);
  if b < 0 { return ""; }
  w := a[0].w[b];
  pb: [16] u8;
  n := cd_cat(out, 0, us_ring(w.used)); n = cd_cat(out, n, " ");
  n = cd_cat(out, n, cast(string) w.label[0..<w.nlabel]); n = cd_cat(out, n, " ");
  n = cd_cat(out, n, us_pct(w.used, pb[..]));
  return cast(string) out[0..<n];
}

// "4d 17h", "3h 10m", "12m": how long until a reset.
us_until :: (s: int, out: [] u8) -> string {
  tb: [16] u8; n := 0;
  if s <= 0 { return "now"; }
  d := s / 86400; h := (s % 86400) / 3600; m := (s % 3600) / 60;
  if d > 0 { n = cd_cat(out, n, cd_itoa(d, tb[..])); n = cd_cat(out, n, "d "); n = cd_cat(out, n, cd_itoa(h, tb[..])); n = cd_cat(out, n, "h"); }
  else if h > 0 { n = cd_cat(out, n, cd_itoa(h, tb[..])); n = cd_cat(out, n, "h "); n = cd_cat(out, n, cd_itoa(m, tb[..])); n = cd_cat(out, n, "m"); }
  else { n = cd_cat(out, n, cd_itoa(ifx m > 0 then m else 1, tb[..])); n = cd_cat(out, n, "m"); }
  return cast(string) out[0..<n];
}

// One meter line: "Week     ████████░░  84%  resets in 4d 17h". A used window shows at least one cell.
us_meter :: (w_in: UsWindow, now_s: int, out: [] u8) -> string {
  w := w_in;
  n := cd_cat(out, 0, cast(string) w.label[0..<w.nlabel]);
  for i: w.nlabel..<9 { n = cd_cat(out, n, " "); }
  cells := cast(int) (w.used * 10.0 + 0.5);
  if w.used > 0.0 && cells == 0 { cells = 1; }
  for i: 0..<10 { n = cd_cat(out, n, ifx i < cells then "█" else "░"); }
  pb: [16] u8; p := us_pct(w.used, pb[..]);
  for i: p.count..<5 { n = cd_cat(out, n, " "); }
  n = cd_cat(out, n, p);
  if w.reset_s > 0 { ub: [32] u8; n = cd_cat(out, n, "  resets in "); n = cd_cat(out, n, us_until(w.reset_s - now_s, ub[..])); }
  return cast(string) out[0..<n];
}

// How long to leave the provider alone after a failure (Zeron's ProbeError::backoff), in ms.
// status 0: no answer (the network); -1: no login; -2: an answer it could not read.
us_clamp :: (v: int, lo: int, hi: int) -> int { return ifx v < lo then lo else ifx v > hi then hi else v; }
us_backoff_ms :: (status: int, retry_after_s: int) -> int {
  s := 0;
  if status == 429 { s = us_clamp(ifx retry_after_s > 0 then retry_after_s else 300, 30, 3600); }
  else if status >= 500 { s = us_clamp(ifx retry_after_s > 0 then retry_after_s else 60, 30, 1800); }
  else if status == 401 || status == 403 || status == -1 { s = 600; }
  else if status == 0 { s = 30; }
  else { s = 900; }
  return s * 1000;
}

// ---------------------------------------------------------------- where the logins are

us_env :: (name: string, out: [] u8) -> string { return cl_getenv(name, out); }

// Claude Code's config folder: $CLAUDE_CONFIG_DIR, else ~/.claude.
us_claude_dir :: (out: [] u8) -> string {
  d := us_env("CLAUDE_CONFIG_DIR", out);
  if d.count > 0 { return d; }
  hb: [1024] u8; home := cl_getenv("HOME", hb[..]);
  if home.count == 0 { return ""; }
  n := cd_cat(out, 0, home); n = cd_cat(out, n, "/.claude");
  return cast(string) out[0..<n];
}

// The Keychain service: `Claude Code-credentials`, with -HEX8 of the folder when CLAUDE_CONFIG_DIR moves it.
us_claude_service :: (out: [] u8) -> string {
  cb: [1024] u8; d := us_env("CLAUDE_CONFIG_DIR", cb[..]);
  n := cd_cat(out, 0, "Claude Code-credentials");
  if d.count > 0 { hb: [64] u8; h := cd_sha256_hex(d, hb[..]); n = cd_cat(out, n, "-"); n = cd_cat(out, n, cast(string) h[0..<8]); }
  return cast(string) out[0..<n];
}

// Whether the Keychain may be read: on macOS, unless CODER_USAGE_KEYCHAIN=0 (tests, which never read a real login).
us_keychain :: () -> bool {
  eb: [8] u8; if us_env("CODER_USAGE_KEYCHAIN", eb[..]) == "0" { return false; }
  return fs_exists("/usr/bin/security");
}

us_url :: (claude: bool, out: [] u8) -> string {
  u := us_env(ifx claude then "CODER_USAGE_CLAUDE_URL" else "CODER_USAGE_CODEX_URL", out);
  return ifx u.count > 0 then u else ifx claude then US_CLAUDE_URL else US_CODEX_URL;
}

// ---------------------------------------------------------------- the probe

us_why :: (a: [] UsAcct, s: string) { a[0].nwhy = cd_cat(a[0].why[..], 0, s); }

us_wipe :: (a: [] UsAcct) {
  for i: 0..<a[0].ntok { a[0].tok[i] = 0; } a[0].ntok = 0;
  for i: 0..<a[0].nbuf { a[0].buf[i] = 0; } a[0].nbuf = 0;
}

us_end :: (a: [] UsAcct) {
  if a[0].h >= 0 { x := cxproc_close_stdin(a[0].h); y := cxproc_kill(a[0].h, 9); z := cxproc_wait(a[0].h, 500); r := cxproc_release(a[0].h); a[0].h = -1; }
  us_wipe(a);
  a[0].stage = US_IDLE;
}

us_fail :: (a: [] UsAcct, status: int, retry_after_s: int, why: string) {
  us_end(a);
  us_why(a, why);
  a[0].next_ms = cxproc_now_ms() + us_backoff_ms(status, retry_after_s);
}

us_spawn :: (a: [] UsAcct, argv: [] string) -> bool {
  h := cxproc_new();
  if h < 0 { return false; }
  ok := true;
  for arg: argv { for b: arg { if b == 0 || cxproc_push(h, 0, cast(int) b) != 0 { ok = false; } } ok = ok && cxproc_end(h, 0) == 0; }
  if !ok || cxproc_spawn(h) != 0 { r := cxproc_release(h); return false; }
  a[0].h = h; a[0].started_ms = cxproc_now_ms(); a[0].nbuf = 0;
  return true;
}

// The token from a credentials blob into a[0].tok (and Codex's account ID); false when it holds none.
us_take_token :: (a: [] UsAcct, blob: string) -> bool {
  ab: [16384] u8; ar: [1] ClArena; ar[0] = ClArena.{buf = ab[..]};
  t := ifx a[0].claude then cl_str(ar[..], blob, "claudeAiOauth.accessToken") else cl_str(ar[..], blob, "tokens.access_token");
  ok := t.count > 0 && t.count < a[0].tok.count;
  if ok { a[0].ntok = cd_cat(a[0].tok[..], 0, t); }
  if a[0].claude && ok {
    s := cl_str(ar[..], blob, "claudeAiOauth.subscriptionType");
    if s.count > 0 && s.count < 30 {
      n := cd_cat(a[0].plan[..], 0, "Claude ");
      for c, i: s { if n < a[0].plan.count { a[0].plan[n] = ifx i == 0 && c >= 'a' && c <= 'z' then c - 32 else c; n += 1; } }
      a[0].nplan = n;
    }
  }
  if !a[0].claude { a[0].nacct = cd_cat(a[0].acct[..], 0, cl_str(ar[..], blob, "tokens.account_id")); }
  for i: 0..<ab.count { ab[i] = 0; }
  return ok;
}

// Starts curl with the token on its standard input (curl -K -).
us_fetch :: (a: [] UsAcct) {
  ub: [1024] u8; url := us_url(a[0].claude, ub[..]);
  argv := [9] string.["curl", "-sS", "-m", US_HTTP_S, "-D", "-", "-K", "-", url];
  if !us_spawn(a, argv[..]) { us_fail(a, 0, 0, "curl did not start"); return; }
  cb: [9000] u8; n := 0;
  n = cd_cat(cb[..], n, "header = \"Authorization: Bearer "); n = cd_cat(cb[..], n, cast(string) a[0].tok[0..<a[0].ntok]); n = cd_cat(cb[..], n, "\"\n");
  if a[0].claude { n = cd_cat(cb[..], n, "header = \"anthropic-beta: oauth-2025-04-20\"\nheader = \"Content-Type: application/json\"\n"); }
  else { n = cd_cat(cb[..], n, "header = \"chatgpt-account-id: "); n = cd_cat(cb[..], n, cast(string) a[0].acct[0..<a[0].nacct]); n = cd_cat(cb[..], n, "\"\n"); }
  for i: 0..<n { x := cxproc_write(a[0].h, cast(int) cb[i]); }
  y := cxproc_flush(a[0].h); z := cxproc_close_stdin(a[0].h);
  for i: 0..<cb.count { cb[i] = 0; }
  us_wipe(a);
  a[0].stage = US_FETCH;
}

// Starts a probe: reads the login, then fetches. Nothing when one is running.
us_probe :: (a: [] UsAcct) {
  if a[0].stage != US_IDLE { return; }
  a[0].tried_ms = cxproc_now_ms();
  db: [1100] u8; pb: [1300] u8; pn := 0;
  if a[0].claude {
    pn = cd_cat(pb[..], 0, us_claude_dir(db[..])); pn = cd_cat(pb[..], pn, "/.credentials.json");
  } else {
    d := us_env("CODEX_HOME", db[..]);
    if d.count == 0 { hb: [1024] u8; home := cl_getenv("HOME", hb[..]); dn := cd_cat(db[..], 0, home); dn = cd_cat(db[..], dn, "/.codex"); d = cast(string) db[0..<dn]; }
    pn = cd_cat(pb[..], 0, d); pn = cd_cat(pb[..], pn, "/auth.json");
  }
  fb: [32768] u8; m := fs_read(cast(string) pb[0..<pn], fb[..]);
  if m > 0 {
    took := us_take_token(a, cast(string) fb[0..<m]);
    for i: 0..<m { fb[i] = 0; }
    if took { us_fetch(a); return; }
    if !a[0].claude { us_fail(a, -1, 0, "Codex is signed in with an API key, which has no plan limits"); return; }
  }
  if a[0].claude && us_keychain() {
    sb: [80] u8; service := us_claude_service(sb[..]);
    ub: [256] u8; user := cl_getenv("USER", ub[..]);
    argv := [7] string.["/usr/bin/security", "find-generic-password", "-a", user, "-s", service, "-w"];
    if !us_spawn(a, argv[..]) { us_fail(a, -1, 0, "the macOS Keychain could not be asked"); return; }
    a[0].stage = US_TOKEN;
    return;
  }
  us_fail(a, -1, 0, ifx a[0].claude then "Claude Code isn't signed in here" else "Codex isn't signed in here");
}

// Reads what the running program printed; true when the probe ended.
us_drain :: (a: [] UsAcct) -> bool {
  for guard: 0..<4096 {
    n := cxproc_read_line(a[0].h, 0);
    if n == -2 { return false; }
    if n < 0 { return true; }
    for i: 0..<n { if a[0].nbuf < a[0].buf.count { a[0].buf[a[0].nbuf] = cast,trunc(u8) cxproc_line_byte(a[0].h, i); a[0].nbuf += 1; } }
    if a[0].nbuf < a[0].buf.count { a[0].buf[a[0].nbuf] = 10; a[0].nbuf += 1; }
  }
  return false;
}

// The answer of curl -D -: its status, Retry-After and body (after the last header block).
us_answer :: (a: [] UsAcct, status_out: [] int, retry_out: [] int) -> string {
  text := cast(string) a[0].buf[0..<a[0].nbuf];
  status := 0; retry := 0; body_at := 0; at := 0; in_head := false;
  while at < text.count {
    e := at; while e < text.count && text[e] != 10 { e += 1; }
    line := cast(string) text[at..<(ifx e > at && text[e - 1] == 13 then e - 1 else e)];
    next := e + 1;
    if !in_head && rt_has_prefix(line, "HTTP/") {
      in_head = true;
      sp := 0; while sp < line.count && line[sp] != ' ' { sp += 1; }
      status = us_int(cast(string) line[sp..<(ifx sp + 4 <= line.count then sp + 4 else line.count)]);
    } else if in_head && line.count == 0 {
      in_head = false; body_at = next;
    } else if in_head && line.count > 12 && (line[0] == 'r' || line[0] == 'R') {
      lb: [16] u8; for i: 0..<12 { lb[i] = ifx line[i] >= 'A' && line[i] <= 'Z' then line[i] + 32 else line[i]; }
      if cast(string) lb[0..<12] == "retry-after:" { retry = us_int(cast(string) line[12..<line.count]); }
    }
    at = next;
  }
  status_out[0] = status; retry_out[0] = retry;
  return ifx body_at <= text.count then cast(string) text[body_at..<text.count] else "";
}

// Saves the windows, so the next start paints them at once.
us_save :: (a: [] UsAcct) {
  db: [1100] u8; dir := cs_dir(db[..]);
  if dir.count == 0 { return; }
  pb: [1300] u8; pn := cd_cat(pb[..], 0, dir); pn = cd_cat(pb[..], pn, ifx a[0].claude then "/../usage-claude.txt" else "/../usage-codex.txt");
  ob: [2048] u8; tb: [32] u8;
  n := cd_cat(ob[..], 0, cd_itoa(a[0].got_ms, tb[..])); n = cd_cat(ob[..], n, "\n"); n = cd_cat(ob[..], n, cast(string) a[0].plan[0..<a[0].nplan]); n = cd_cat(ob[..], n, "\n");
  for i: 0..<a[0].nw {
    w := a[0].w[i];
    n = cd_cat(ob[..], n, cast(string) w.label[0..<w.nlabel]); n = cd_cat(ob[..], n, " ");
    n = cd_cat(ob[..], n, cd_itoa(cast(int) (w.used * 10000.0 + 0.5), tb[..])); n = cd_cat(ob[..], n, " ");
    n = cd_cat(ob[..], n, cd_itoa(w.reset_s, tb[..])); n = cd_cat(ob[..], n, "\n");
  }
  x := fs_write(cast(string) pb[0..<pn], cast(string) ob[0..<n]);
}

us_load :: (a: [] UsAcct) {
  db: [1100] u8; dir := cs_dir(db[..]);
  if dir.count == 0 { return; }
  pb: [1300] u8; pn := cd_cat(pb[..], 0, dir); pn = cd_cat(pb[..], pn, ifx a[0].claude then "/../usage-claude.txt" else "/../usage-codex.txt");
  fb: [2048] u8; m := fs_read(cast(string) pb[0..<pn], fb[..]);
  if m <= 0 { return; }
  text := cast(string) fb[0..<m];
  at := 0; line_no := 0; a[0].nw = 0;
  while at < text.count {
    e := at; while e < text.count && text[e] != 10 { e += 1; }
    line := cast(string) text[at..<e]; at = e + 1;
    if line_no == 0 { a[0].got_ms = us_int(line); }
    else if line_no == 1 { a[0].nplan = cd_cat(a[0].plan[..], 0, line); }
    else {
      s1 := 0; while s1 < line.count && line[s1] != ' ' { s1 += 1; }
      s2 := s1 + 1; while s2 < line.count && line[s2] != ' ' { s2 += 1; }
      if s2 < line.count {
        us_add(a, cast(string) line[0..<s1], cast(f32) us_int(cast(string) line[s1 + 1..<s2]) / 10000.0, us_int(cast(string) line[s2 + 1..<line.count]));
      }
    }
    line_no += 1;
  }
}

// One step of the probe without waiting; true when the windows changed.
us_tick :: (a: [] UsAcct) -> bool {
  now := cxproc_now_ms();
  if a[0].stage == US_IDLE {
    if now >= a[0].next_ms { us_probe(a); }
    return false;
  }
  if a[0].stage == US_TOKEN {
    done := us_drain(a);
    if !done && now - a[0].started_ms < US_KEYCHAIN_MS { return false; }
    code := ifx done then cxproc_wait(a[0].h, 200) else -1;
    blob := cast(string) a[0].buf[0..<a[0].nbuf];
    if !done || code != 0 || blob.count == 0 {
      us_fail(a, -1, 0, ifx !done then "the macOS Keychain didn't answer for the Claude Code login" else "macOS Keychain denied access to the Claude Code login, or there is none");
      return false;
    }
    bb: [16384] u8; bn := cd_cat(bb[..], 0, blob);
    x := cxproc_release(a[0].h); a[0].h = -1;
    for i: 0..<a[0].nbuf { a[0].buf[i] = 0; } a[0].nbuf = 0;
    took := us_take_token(a, cast(string) bb[0..<bn]);
    for i: 0..<bn { bb[i] = 0; }
    if !took { us_fail(a, -1, 0, "the Claude Code login has no token"); return false; }
    us_fetch(a);
    return false;
  }
  // US_FETCH
  done := us_drain(a);
  if !done && now - a[0].started_ms < 20000 { return false; }
  st: [1] int; ra: [1] int;
  body := us_answer(a, st[..], ra[..]);
  if st[0] == 0 { us_fail(a, 0, 0, "the usage service didn't answer"); return false; }
  if st[0] != 200 {
    tb: [16] u8; wb: [80] u8; wn := cd_cat(wb[..], 0, "the usage service answered "); wn = cd_cat(wb[..], wn, cd_itoa(st[0], tb[..]));
    us_fail(a, st[0], ra[0], cast(string) wb[0..<wn]); return false;
  }
  bb: [131072] u8; bn := cd_cat(bb[..], 0, body);
  ok := ifx a[0].claude then us_read_claude(a, cast(string) bb[0..<bn]) else us_read_codex(a, cast(string) bb[0..<bn]);
  if !ok { us_fail(a, -2, 0, "the usage answer held no limits"); return false; }
  us_end(a);
  a[0].nwhy = 0;
  a[0].got_ms = cxproc_wall_us() / 1000;
  a[0].next_ms = now + US_POLL_MS;
  us_save(a);
  return true;
}

// Asks for a fresh read now, no more often than every 30 seconds, and not inside a failure's wait.
us_force :: (a: [] UsAcct) {
  now := cxproc_now_ms();
  if a[0].stage != US_IDLE || now - a[0].tried_ms < US_FORCE_MS { return; }
  if a[0].nwhy > 0 && now < a[0].next_ms { return; }
  a[0].next_ms = now;
}

#test "usage: Claude's and Codex's answers, levels, the ring, meters and waits (Zeron's rules)" {
  a: [1] UsAcct; a[0] = UsAcct.{claude = true};
  #assert us_read_claude(a[..], "{\"five_hour\":null,\"seven_day\":{\"utilization\":84.0,\"resets_at\":\"1970-01-02T00:00:00.000+00:00\"}}");
  #assert a[0].nw == 1;
  #assert cast(string) a[0].w[0].label[0..<a[0].w[0].nlabel] == "Week";
  #assert a[0].w[0].reset_s == 86400;
  sb: [64] u8;
  #assert us_segment(a[..], sb[..]) == "◕ Week 84%";
  #assert us_level(0.84) == US_LEVEL_WARN && us_level(0.95) == US_LEVEL_CRITICAL && us_level(0.5) == US_LEVEL_NORMAL;
  #assert !us_read_claude(a[..], "{\"five_hour\":null,\"seven_day\":null}");
  #assert us_read_claude(a[..], "{\"five_hour\":{\"utilization\":12.5,\"resets_at\":null},\"seven_day\":{\"utilization\":3,\"resets_at\":null}}");
  #assert a[0].nw == 2 && us_binding(a[..]) == 0;
  c: [1] UsAcct;
  #assert us_read_codex(c[..], "{\"plan_type\":\"pro\",\"rate_limit\":{\"primary_window\":{\"used_percent\":3,\"limit_window_seconds\":604800,\"reset_at\":1794234083},\"secondary_window\":null}}");
  #assert c[0].nw == 1 && c[0].w[0].reset_s == 1794234083;
  #assert cast(string) c[0].plan[0..<c[0].nplan] == "ChatGPT Pro";
  #assert us_codex_label(2592000) == "Month" && us_codex_label(18000) == "Session" && us_codex_label(604800) == "Week";
  mb: [128] u8;
  #assert us_meter(c[0].w[0], 1794234083 - 90000, mb[..]) == "Week     █░░░░░░░░░   3%  resets in 1d 1h";
  #assert us_backoff_ms(429, 0) == 300000 && us_backoff_ms(429, 5) == 30000 && us_backoff_ms(429, 99999) == 3600000;
  #assert us_backoff_ms(503, 0) == 60000 && us_backoff_ms(404, 0) == 900000 && us_backoff_ms(0, 0) == 30000 && us_backoff_ms(401, 0) == 600000;
  #assert us_ring(0.0) == "○" && us_ring(0.99) == "●";
}
