// A JSON document's values as a form edits them: its editable leaves (a string, a
// boolean, and the next item of a list of strings) and the objects and arrays above
// them, each with its path, in a caller's array. The one JSON parser and writer
// (json.coax) owns escaping; a form's order, names and headings are its caller's
// (coax/lib/project/draft.coax is the project draft's). Bounds: JF_MAX entries,
// JF_DEPTH levels, JF_KEY bytes in a key; past them the build says so (overflow,
// unread) and counts the leaves it saw, so a surface can say how many it shows.
#load "../../coax/lib/json/json.coax";
JF_MAX :: 4096;    // entries, leaves and containers together
JF_DEPTH :: 10;    // keys in a path
JF_KEY :: 80;      // bytes in one key, unescaped
// at[i]: an object level's member node, or an array level's index (bit i of arrays set).
JsonField :: struct {node:int;parent:int;kind:int;depth:int;arrays:int;at:[JF_DEPTH]int;}
// leaves: every leaf seen, kept: those in fields; unread: a part was deeper than JF_DEPTH
// or had a longer key than JF_KEY, so its leaves were neither kept nor counted.
JsonFields :: struct {fields:[JF_MAX]JsonField;n:int;overflow:bool;leaves:int;kept:int;unread:bool;}

jf_leaf :: (f:JsonField)->bool {return f.kind==JV_STRING || f.kind==JV_TRUE || f.kind==JV_FALSE;}
jf_is_array :: (f:JsonField,level:int)->bool {return (f.arrays & (1 << level))!=0;}
// The level-th key, unescaped (an index in decimal): its length, or -1 when out is too small.
jf_key :: (v:Jv,field:JsonField,level:int,out:[]u8)->int {
 f:=field;if jf_is_array(f,level) {o:[1]Jo;jo_start(o[..],out);jo_int(o[..],f.at[level]);return ifx o[0].bad then -1 else o[0].n;}
 return jv_unescape(jv_key(v,f.at[level]),out);
}
// The path as the edit route takes it: a JSON array of strings, ["card","name"].
jf_path :: (v:Jv,field:JsonField,out:[]u8)->int {f:=field;o:[1]Jo;jo_start(o[..],out);jo_arr(o[..]);for i:0..<f.depth {key:[JF_KEY]u8;k:=jf_key(v,f,i,key[..]);jo_str(o[..],cast(string)key[0..<k]);}jo_end(o[..]);return ifx o[0].bad then -1 else o[0].n;}
jf_add :: (out:[]JsonFields,f:JsonField) {leaf:=jf_leaf(f);if leaf {out[0].leaves+=1;}if out[0].n==JF_MAX {out[0].overflow=true;return;}out[0].fields[out[0].n]=f;out[0].n+=1;if leaf {out[0].kept+=1;}}
// A path one key longer: member c of object at path's end, or item i of an array.
jf_member :: (path:JsonField,parent:int,c:int)->JsonField {f:=path;f.at[f.depth]=c;f.depth+=1;f.parent=parent;return f;}
jf_item :: (path:JsonField,parent:int,i:int)->JsonField {f:=path;f.arrays|=1 << f.depth;f.at[f.depth]=i;f.depth+=1;f.parent=parent;return f;}
// node and everything under it, its path being path. A container is an entry too, except the root (depth 0).
jf_walk :: (v:Jv,node:int,path:JsonField,out:[]JsonFields) {
 kind:=jv_kind(v,node);f:=path;f.node=node;f.kind=kind;
 if kind!=JV_OBJECT && kind!=JV_ARRAY {if jf_leaf(f) {jf_add(out,f);}return;}
 if path.depth>0 {jf_add(out,f);}
 if path.depth==JF_DEPTH {out[0].overflow=true;out[0].unread=true;return;}
 strings:=kind==JV_ARRAY;
 for i:0..<jv_len(v,node) {
  c:=jv_at(v,node,i);if jv_kind(v,c)!=JV_STRING {strings=false;}
  if kind==JV_ARRAY {jf_walk(v,c,jf_item(path,node,i),out);continue;}
  key:[JF_KEY]u8;if jv_unescape(jv_key(v,c),key[..])<0 {out[0].overflow=true;out[0].unread=true;continue;}
  jf_walk(v,c,jf_member(path,node,c),out);
 }
 if strings {a:=jf_item(path,node,jv_len(v,node));a.node= -1;a.kind=JV_STRING;jf_add(out,a);}
}
jf_build :: (v:Jv,root:int,out:[]JsonFields) {out[0]=JsonFields.{};f:JsonField;jf_walk(v,root,f,out);}

#test "nested draft fields retain exact paths, booleans, containers and string-list append slots" {
 d:[1]Jv;n:[48]JvNode;f:[1]JsonFields;#assert jv_parse(d[..],"{\"card\":{\"name\":\"A\"},\"checks\":[\"x\"],\"reuse\":true,\"n\":2}",n[..]);jf_build(d[0],0,f[..]);
 #assert f[0].n==6 && f[0].leaves==4 && f[0].kept==4 && !f[0].overflow && !f[0].unread;
 #assert f[0].fields[0].kind==JV_OBJECT && f[0].fields[2].kind==JV_ARRAY && jf_is_array(f[0].fields[4],1) && !jf_is_array(f[0].fields[4],0);
 b:[256]u8;k:=jf_path(d[0],f[0].fields[4],b[..]);#assert cast(string)b[0..<k]=="[\"checks\",\"1\"]" && f[0].fields[4].node== -1;
 k=jf_path(d[0],f[0].fields[1],b[..]);#assert cast(string)b[0..<k]=="[\"card\",\"name\"]";
 #assert f[0].fields[5].kind==JV_TRUE && f[0].fields[1].parent==f[0].fields[0].node && jf_path(d[0],f[0].fields[1],b[0..<4])== -1;
}
#test "form paths decode JSON object keys once" {d:[1]Jv;n:[8]JvNode;f:[1]JsonFields;#assert jv_parse(d[..],"{\"a\\\"b\":\"value\"}",n[..]);jf_build(d[0],0,f[..]);b:[64]u8;k:=jf_path(d[0],f[0].fields[0],b[..]);#assert cast(string)b[0..<k]=="[\"a\\\"b\"]";}
#test "past its bounds the build keeps what fits, counts every leaf and says what it could not read" {
 text:[40000]u8;o:[1]Jo;jo_start(o[..],text[..]);jo_arr(o[..]);for i:0..<JF_MAX+5 {jo_bool(o[..],true);}jo_end(o[..]);
 d:[1]Jv;n:[JF_MAX+8]JvNode;f:[1]JsonFields;#assert jv_parse(d[..],jo_text(o[..]),n[..]);jf_build(d[0],0,f[..]);
 #assert f[0].overflow && !f[0].unread && f[0].n==JF_MAX && f[0].kept==JF_MAX && f[0].leaves==JF_MAX+5;
 deep:="{\"a\":{\"b\":{\"c\":{\"d\":{\"e\":{\"f\":{\"g\":{\"h\":{\"i\":{\"j\":{\"k\":\"x\"}}}}}}}}}},\"z\":\"y\"}";
 #assert jv_parse(d[..],deep,n[..]);jf_build(d[0],0,f[..]);#assert f[0].unread && f[0].overflow && f[0].leaves==1 && f[0].n==JF_DEPTH+1;
 ten:="{\"a\":{\"b\":{\"c\":{\"d\":{\"e\":{\"f\":{\"g\":{\"h\":{\"i\":{\"j\":\"x\"}}}}}}}}}}";
 #assert jv_parse(d[..],ten,n[..]);jf_build(d[0],0,f[..]);#assert !f[0].unread && f[0].leaves==1 && f[0].fields[f[0].n-1].depth==JF_DEPTH;
 key:[200]u8;kn:=0;key[0]='{';key[1]='"';kn=2;for i:0..<JF_KEY+1 {key[kn]='k';kn+=1;}for c:"\":\"x\",\"ok\":\"y\"}" {key[kn]=c;kn+=1;}
 #assert jv_parse(d[..],cast(string)key[0..<kn],n[..]);jf_build(d[0],0,f[..]);#assert f[0].unread && f[0].overflow && f[0].leaves==1 && f[0].n==1;
}
#test "an empty key, false, nested lists and an index too long for its buffer" {
 d:[1]Jv;n:[32]JvNode;f:[1]JsonFields;
 #assert jv_parse(d[..],"{\"\":\"x\",\"no\":false,\"l\":[[\"y\"]]}",n[..]);jf_build(d[0],0,f[..]);#assert !f[0].unread && !f[0].overflow && f[0].leaves==4;
 #assert f[0].fields[0].kind==JV_STRING && f[0].fields[1].kind==JV_FALSE && f[0].fields[3].parent==f[0].fields[2].node && f[0].fields[4].parent==f[0].fields[3].node;
 kb:[1]u8;#assert jf_key(d[0],f[0].fields[4],1,kb[..])==1 && jf_key(d[0],f[0].fields[4],1,kb[0..<0])== -1;
}

// ---------------------------------------------------------------- the words a form shows

// The order a browser's localeCompare gives ASCII (CLDR root, punctuation not ignored):
// space and punctuation, then digits, then letters with lower case before upper.
// Bytes past ASCII come after, by value.
JF_COLLATION :: " _-,;:!?.'\"()[]{}@*/\\&#%`^+<=>|~$0123456789abcdefghijklmnopqrstuvwxyz";
jf_weight :: (c:u8)->int {
 b:=c;if b>='A' && b<='Z' {b=b-'A'+'a';}
 for w,i:JF_COLLATION {if w==b {return i;}}
 return JF_COLLATION.count+cast(int)c;
}
// -1, 0 or 1, as a.localeCompare(b) orders ASCII keys.
jf_collate :: (a:string,b:string)->int {
 i:=0;while i<a.count && i<b.count {wa:=jf_weight(a[i]);wb:=jf_weight(b[i]);if wa<wb {return -1;}if wa>wb {return 1;}i+=1;}
 if a.count<b.count {return -1;}
 if a.count>b.count {return 1;}
 // same weights and length: a byte that differs is one letter in two cases, and lower case comes first
 for j:0..<a.count {if a[j]!=b[j] {return ifx a[j]>='a' then -1 else 1;}}
 return 0;
}
#test "keys sort as the browser's localeCompare sorts them" {
 #assert jf_collate("a","A")== -1 && jf_collate("A","a")==1 && jf_collate("aB","Ab")== -1 && jf_collate("a_b","ab")== -1 && jf_collate("a1","a_1")==1;
 #assert jf_collate("a","a_")== -1 && jf_collate("a_","a")==1 && jf_collate("ab","a b")==1 && jf_collate("A","b")== -1 && jf_collate("a-b","a_b")==1 && jf_collate("a.b","a_b")==1;
 #assert jf_collate("x","x1")== -1 && jf_collate("co-op","coop")== -1 && jf_collate("zeta","alpha")==1 && jf_collate("name","name")==0 && jf_collate("9","a")== -1 && jf_collate("$","0")== -1;
 #assert jf_collate("Z","~")==1 && jf_collate("z","é")== -1 && jf_collate("é","z")==1 && jf_collate("","")==0;
 #assert jf_collate("Za","zb")== -1 && jf_collate("[","{")== -1 && jf_collate("z","Z")== -1 && jf_collate("Z","z")==1 && jf_collate("aZ","az")==1 && jf_collate("ab","abc")== -1 && jf_collate("abc","ab")==1;
}

// text with '|', CR, LF and tab as spaces, cut to units UTF-16 code units (as a JavaScript
// string's slice cuts it; a cut through a pair is U+FFFD), and "..." after it when cut and more.
jf_clip :: (text:string,units:int,more:bool,out:[]u8)->string {
 n:=0;u:=0;i:=0;
 while i<text.count {
  c:=text[i];k:=ifx c>=0xf0 then 4 else ifx c>=0xe0 then 3 else ifx c>=0xc2 then 2 else 1;
  w:=ifx k==4 then 2 else 1;
  if u+w>units {if u<units && n+3<=out.count {out[n]=0xef;out[n+1]=0xbf;out[n+2]=0xbd;n+=3;}break;}
  if n+k>out.count || i+k>text.count {break;}
  for j:0..<k {b:=text[i+j];out[n+j]=ifx b=='|' || b=='\r' || b=='\n' || b=='\t' then ' ' else b;}
  n+=k;u+=w;i+=k;
 }
 if more && i<text.count {for c:"..." {if n<out.count {out[n]=c;n+=1;}}}
 return cast(string)out[0..<n];
}
#test "a clip counts UTF-16 units, cleans the row's separators and marks a cut" {
 e:[8]u8;#assert jf_clip("ंx",1,true,e[..])=="ं..." && jf_clip("x",1,false,e[..])=="" && jf_clip("😀x",2,false,e[..])=="😀";
 #assert jf_clip("a😀",2,false,e[0..<4])=="a�" && jf_clip("a😀",2,false,e[0..<3])=="a" && jf_clip("ab",9,false,e[0..<2])=="ab";
 b:[64]u8;#assert jf_clip("a|b\nc\td\re",20,true,b[..])=="a b c d e" && jf_clip("abcdef",3,true,b[..])=="abc..." && jf_clip("abcdef",3,false,b[..])=="abc";
 #assert jf_clip("abc",3,true,b[..])=="abc" && jf_clip("",3,true,b[..])=="" && jf_clip("é€x",2,true,b[..])=="é€...";
 #assert jf_clip("a😀b",3,false,b[..])=="a😀" && jf_clip("a😀b",2,true,b[..])=="a�..." && jf_clip("😀",2,true,b[..])=="😀";
 part:[3]u8;part[0]=0x61;part[1]=0xe2;part[2]=0x82;
 #assert jf_clip("abcdef",3,true,b[0..<4])=="abc." && jf_clip("ab€",3,false,b[0..<4])=="ab" && jf_clip(cast(string)part[..],9,false,b[..])=="a";
}
