// The app set's account components (components/app/README.md; GitHub #13645):
// the login card, with its email step and its code step, and the notice a
// logged-out screen shows. They are built from the form set (kit/form.coax:
// heading, field, action, link, notice) and base.coax.
//
// The card takes a plain record. It holds no login logic: the app owns the
// step, the text and the error, and each part dispatches the action the
// caller gives it.
//   coax/bin/coax test components/app/account.coax

#load "base.coax";

APP_LOGIN_EMAIL :: 0;       // asks for the email address
APP_LOGIN_CODE :: 1;        // asks for the code sent to it

// What the login card shows. The caller holds the text.
AppLogin :: struct {
  step: int;                  // APP_LOGIN_*
  email: string;
  code: string;
  busy: bool;                 // the step's request is under way: the action is busy and the field rests
  error: string;              // what went wrong ("": nothing), under the field
  editing: bool;              // the platform's editor is over the focused field and draws its text
}
// What each part of the card dispatches.
AppLoginActions :: struct {
  field: int;                 // a press on the field (it asks for the keyboard)
  submit: int;                // Send code, or Log in
  back: int;                  // Use a different email
  resend: int;                // Send a new code
}
// The login card at (x, y), w wide. The email step: a heading, the email
// field (id + ".email") and Send code (id + ".submit"). The code step: who
// the code went to, the code field (id + ".code"), Log in (id + ".submit"),
// then Use a different email (id + ".back") and Send a new code (id +
// ".resend"). While busy the action shows the activity mark and nothing else
// can be pressed. An error shows under the field as a live notice. Rows are
// children of the card's region row. Returns its height.
app_login :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, l: AppLogin, act: AppLoginActions) -> f32 {
  s := f[0].skin; a := s.app; sh := f[0].sheet; pad := a.card_pad; code := l.step == APP_LOGIN_CODE;
  row := uiframe_semantic(f, id, EL_REGION, "Log in", x, y, w, pad, 0, 0);
  uiframe_open(f, row);
  ground := sheet_box(sh, x, y, w, 0, a.card_radius, s.border, s.surface, s.hover);
  ix := x + pad; iw := w - 2 * pad; h := pad;
  hid: [EL_ID] u8; did: [EL_ID] u8; fid: [EL_ID] u8; sid: [EL_ID] u8; bid: [EL_ID] u8; rid: [EL_ID] u8;
  h += ctx_heading(f, app_id(hid[..], id, ".title"), app_id(did[..], id, ".detail"), ix, y + h, iw,
    ifx code then "Enter your code" else "Log in", ifx code then l.email else "We email you a code. No password.") + s.space;
  rest := ifx l.busy then EL_S_DISABLED else 0;
  if code { h += app_field(f, app_id(fid[..], id, ".code"), ix, y + h, iw, "Email code", l.code, "6-digit code", false, l.editing, l.error, rest, act.field); }
  else { h += app_field(f, app_id(fid[..], id, ".email"), ix, y + h, iw, "Email address", l.email, "you@example.com", false, l.editing, l.error, rest, act.field); }
  h += s.space;
  ready := ifx code then l.code.count > 0 else l.email.count > 0;
  words := ifx code then (ifx l.busy then "Logging in…" else "Log in") else (ifx l.busy then "Sending code…" else "Send code");
  h += app_button(f, app_id(sid[..], id, ".submit"), ix, y + h, iw, -1, words, APP_BUTTON_PRIMARY, ifx l.busy then EL_S_BUSY else ifx ready then 0 else EL_S_DISABLED, act.submit);
  if code {
    h += a.gap_small;
    bw := form_link_width(f[0].m, s, "Use a different email"); rw := form_link_width(f[0].m, s, "Send a new code");
    _ := ctx_link(f, app_id(bid[..], id, ".back"), ix - s.space, y + h, "Use a different email", "", rest, ifx l.busy then 0 else act.back);
    // the two links share a row when they fit, else the second goes under the first
    if bw + rw - 2 * s.space > iw { h += s.control_h; _ := ctx_link(f, app_id(rid[..], id, ".resend"), ix - s.space, y + h, "Send a new code", "", rest, ifx l.busy then 0 else act.resend); }
    else { _ := ctx_link(f, app_id(rid[..], id, ".resend"), ix + iw - rw + s.space, y + h, "Send a new code", "", rest, ifx l.busy then 0 else act.resend); }
    h += s.control_h - pad / 2;
  }
  h += pad;
  uiframe_close(f);
  if ground >= 0 { sh[0].under[ground].h = h; }
  if row >= 0 { f[0].rows[0].rows[row].h = h; }
  return h;
}
// The notice a logged-out screen shows at (x, y), w wide: what the person
// can't do until they log in, and Log in (id + ".login"), which dispatches
// `action`. Returns its height.
app_logged_out :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, text: string, action: int) -> f32 {
  s := f[0].skin; lid: [EL_ID] u8;
  h := app_notice(f, id, x, y, w, text, APP_NOTICE_INFO) + s.app.gap;
  h += app_button(f, app_id(lid[..], id, ".login"), x, y + h, w, -1, "Log in", APP_BUTTON_PRIMARY, 0, action);
  return h;
}

#load "account-checks.coax" #test;
