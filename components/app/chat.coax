// The app set's chat components (components/app/README.md; GitHub #13645):
// the composer with the chips over it, a person's message, an agent's
// message in Markdown, a code block with its language and Copy, the typing
// mark, the empty conversation, an error with Try again, the jump to the
// latest message and a date or meta line.
//
// They follow base.coax's contract: one procedure a component on the frame
// context, the skin's roles and app measures, a semantic row and a hit region
// under a stable id, motion from the keyed store. A message rises into place
// when its id first appears. A component takes plain inputs; nothing here
// knows a conversation, a task or a service.
//   coax/bin/coax test components/app/chat.coax

#load "base.coax";
#load "../kit/composer.coax";
#load "../kit/markdown.coax";

APP_WRAP_LINES :: 64;       // rows one message or one notice wraps into
APP_DOTS :: 3;              // the typing mark's dots

// Wrapped text centred in (x, w), each row on its own. Returns its height.
app_centred :: (f: [] UiFrame, t: UiType, color: Rgba, x: f32, y: f32, w: f32, text: string) -> f32 {
  m := f[0].m; rows: [APP_WRAP_LINES] TextLine;
  n := text_wrap_lines(m, TextFaces.{plain = t.face, bold = t.face, code = t.face}, text, ifx w > 1 then w else 1.0f32, rows[..]);
  for i: 0..<n {
    part := cast(string) text[rows[i].from..<rows[i].to];
    _ := sheet_text(f[0].sheet, m, -1, x + (w - measure_width(m, t.face, part)) / 2, y + cast(f32) i * t.line, t.line, t.face, color, part);
  }
  return cast(f32) n * t.line;
}

// ---------------------------------------------------------------- composer

APP_COMPOSER_READY :: 0;      // the text can be edited; Send can be pressed once there is text
APP_COMPOSER_SENDING :: 1;    // a message is being sent: the text is locked and the action rests
APP_COMPOSER_RUNNING :: 2;    // a reply runs: the action is Stop
APP_COMPOSER_OFF :: 3;        // it can't be used now (logged out, no connection)

// What a composer shows. The caller holds the draft.
AppComposer :: struct {
  placeholder: string;
  text: string;
  model: string;              // the model's chip in the action row ("": none)
  state: int;                 // APP_COMPOSER_*
  editing: bool;              // the platform's editor is over the text and draws it
  editor_h: f32;              // the editor's own text height, layout units (while editing; 0: wrap here)
  unit: f32;                  // points a layout unit (the shared composer layout is in points; 0: 1)
  compact: bool;              // at rest: the one-line capsule (kit/composer.coax), never while editing
  deliver: string;            // the action's word while a turn runs ("Steer", "Queue"; "": the arrow)
}
// A composer docked by its bottom edge at `bottom`, w wide (kit/composer.coax's
// composer, with the app's states). Its rows are the field (id, the draft as
// its value), the action (send_id: Send, or Stop while a reply runs) and the
// model (id + ".model"). It grows with its text to the layout's four-line cap
// on a spring. Returns its box at the height it is drawn at.
app_composer :: (f: [] UiFrame, id: string, send_id: string, x: f32, bottom: f32, w: f32, c: AppComposer, field_action: int, send_action: int) -> ComposerBox {
  locked := c.state == APP_COMPOSER_SENDING || c.state == APP_COMPOSER_OFF;
  look := ComposerLook.{placeholder = c.placeholder, text = c.text, model = c.model, editing = c.editing && !locked, editor_h = c.editor_h, unit = c.unit, compact = c.compact && !c.editing, label = ifx c.state == APP_COMPOSER_READY then c.deliver else "",
    stop = c.state == APP_COMPOSER_RUNNING, locked = locked,
    enabled = c.state == APP_COMPOSER_RUNNING || (c.state == APP_COMPOSER_READY && c.text.count > 0)};
  return ctx_composer(f, id, send_id, x, bottom, w, look, ifx locked then 0 else field_action, ifx look.enabled then send_action else 0);
}
// The chips over a composer at (x, y), in w: where the next message runs
// (env_id) and its repository (repo_id; "" for no repository chip), each
// with its icon (-1: none). The environment takes at most half the row and
// the repository the rest; a longer value is cut with an ellipsis and its row
// keeps the whole. `state` applies to both (EL_S_DISABLED while a reply runs).
// Returns the row's height.
app_composer_chips :: (f: [] UiFrame, env_id: string, repo_id: string, x: f32, y: f32, w: f32, env_icon: int, env: string, repo_icon: int, repo: string, state: int, env_action: int, repo_action: int) -> f32 {
  s := f[0].skin; gap := s.app.gap;
  ew := app_chip(f, env_id, x, y, ifx repo.count > 0 then (w - gap) / 2 else w, env_icon, "Environment", env, state, env_action);
  if repo.count > 0 { _ := app_chip(f, repo_id, x + ew + gap, y, w - ew - gap, repo_icon, "Repository", repo, state, repo_action); }
  return s.cmp.chip_h;
}

// ---------------------------------------------------------------- messages

// A person's message at (x, y), in a column w wide: its text wrapped in a
// bubble at the column's right edge, as wide as its longest row and at most
// the skin's share of the column. Its rows of text are selectable. Returns its height.
app_message_user :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, text: string) -> f32 {
  return app_message_user_fold(f, id, x, y, w, text, false, 0);
}
APP_USER_LINES :: 512;      // rows a person's message wraps into
// A person's message that folds, as Zeron's (ds/user_message): past the skin's bubble_fold lines
// (five) it shows those, its foot fading over bubble_fade lines (one and a half), and "Show more"
// under them (id + ".more", dispatching `action`) opens it, the bubble's height easing to the
// whole text over bubble_ease (outQuart); "Show less" folds it again. `open` is the caller's,
// kept by the message. A message that fits, or action 0, is the plain bubble. Its ground is the
// skin's bubble (raised when it has none). Returns its height.
app_message_user_fold :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, text: string, open: bool, action: int) -> f32 {
  s := f[0].skin; a := s.app; sh := f[0].sheet; m := f[0].m; line := s.md.line;
  k := uiframe_key(f, id); from := app_sheet_mark(f);
  room := w * a.bubble_share - 2 * a.bubble_pad_x;
  rows: [APP_USER_LINES] TextLine;
  n := text_wrap_lines(m, uiskin_faces(s), text, ifx room > 1 then room else 1.0f32, rows[..]);
  widest: f32 = 0;
  for i: 0..<n { rw := measure_width(m, s.body.face, cast(string) text[rows[i].from..<rows[i].to]); if rw > widest { widest = rw; } }
  full := cast(f32) n * line; folded_h := a.bubble_fold * line;
  folds := action != 0 && full > folded_h + 0.5;
  // how far open, eased; the text's shown height
  p: f32 = 1;
  if folds { p = keyed_toward(f[0].keyed, k, open, a.bubble_ease, AM_OUT_QUART); }
  th := ifx folds then folded_h + (full - folded_h) * p else full;
  label := ifx open then "Show less" else "Show more";
  lw: f32 = 0; more_h: f32 = 0; icon := ifx open then -1 else s.icon_chevron;
  if folds {
    lw = measure_width(m, s.label.face, label);
    if icon >= 0 { lw += a.gap_small + a.code_copy_icon; }
    more_h = a.bubble_more_gap + s.label.line;
    if lw > widest { widest = lw; }
  }
  bw := ceil(widest) + 2 * a.bubble_pad_x; h := th + more_h + 2 * a.bubble_pad_y; bx := x + w - bw;
  _ := uiframe_semantic(f, id, EL_TEXT, text, bx, y, bw, h, 0, 0);
  sheet_fill(sh, bx, y, bw, h, a.bubble_radius, ifx s.bubble.a > 0 then s.bubble else s.raised);
  ty := y + a.bubble_pad_y;
  // folded or easing: cut at the shown height, the foot fading while it is folded
  cut := folds && p < 1;
  band := ifx cut then line * a.bubble_fade * (1 - p) else 0.0f32;
  if cut {
    if band > 0 {
      uiframe_fade_foot(f, ty + th, band);
    }
    uiframe_clip(f, bx, ty, bx + bw, ty + th);
  }
  for i: 0..<n {
    if cut && cast(f32) i * line >= th { break; }
    hard := rows[i].to >= text.count || text[rows[i].to] == '\n';
    _ := sheet_plain(sh, m, bx + a.bubble_pad_x, ty + cast(f32) i * line, line, s.body.face, s.ink, cast(string) text[rows[i].from..<rows[i].to], hard);
  }
  if cut {
    uiframe_unclip(f);
    if band > 0 { uiframe_fade_end(f); }
  }
  if folds {
    // the way to open it: a plain link under the text, at its left edge
    mid: [EL_ID] u8; more := app_id(mid[..], id, ".more");
    hovered := uiframe_hovered(f, more);
    cx := bx + a.bubble_pad_x; cy := ty + th + a.bubble_more_gap; ink := ifx hovered then s.ink else s.muted;
    tw := sheet_text(sh, m, -1, cx, cy, s.label.line, s.label.face, ink, label);
    if icon >= 0 { sheet_icon(sh, icon, cx + tw + a.gap_small, cy + (s.label.line - a.code_copy_icon) / 2, a.code_copy_icon, ink); }
    row := uiframe_semantic(f, more, EL_BUTTON, label, cx, cy, lw, s.label.line, EL_S_EXPANDS | (ifx open then EL_S_EXPANDED else 0), action);
    sheet_hit(sh, UIFRAME_HIT, row, 0, cx, cy, lw, s.label.line);
  }
  app_enter(f, k, from);
  return h;
}
// A code block's language as Zeron names it (ds/syntax `name`): "Rust" for
// a ```rust fence, the fence's own tag for one not known here, "text" for none.
APP_CODE_TAGS :: [32] string.["rust", "rs", "coax", "jai", "c", "h", "cpp", "c++", "swift", "ts", "typescript", "tsx", "js", "javascript", "jsx", "py",
                              "python", "sh", "bash", "zsh", "shell", "json", "toml", "yaml", "yml", "go", "html", "css", "md", "markdown", "luau", "diff"];
APP_CODE_NAMES :: [32] string.["Rust", "Rust", "Coax", "Jai", "C", "C", "C++", "C++", "Swift", "TypeScript", "TypeScript", "TSX", "JavaScript", "JavaScript", "JSX", "Python",
                               "Python", "Shell", "Bash", "Zsh", "Shell", "JSON", "TOML", "YAML", "YAML", "Go", "HTML", "CSS", "Markdown", "Markdown", "Luau", "Diff"];
app_code_lang :: (lang: string) -> string {
  if lang.count == 0 { return "text"; }
  tags := APP_CODE_TAGS; names := APP_CODE_NAMES;
  for i: 0..<tags.count { if lang == tags[i] { return names[i]; } }
  return lang;
}
// A code block at (x, y), w wide, as Zeron's (ds/markdown CodeBlock): one
// quiet panel, its strip (the language by its name, Copy at its end) sharing
// the panel's fill, then the lines in the mono face. Copy is a row of its own
// (id + ".copy"), its icon and word, that dispatches `action`; `copied` says
// the app has copied it, and it reads Copied by the check. Rust-like
// languages are highlighted in the skin's syntax roles. A line wider than the
// block is cut with an ellipsis. Returns its height.
app_code :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, lang: string, code: string, copied: bool, action: int) -> f32 {
  vv: MdVeil;
  return app_code_veiled(f, id, x, y, w, lang, code, copied, action, vv, 0);
}
app_code_veiled :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, lang: string, code: string, copied: bool, action: int, vv: MdVeil, base: int) -> f32 {
  s := f[0].skin; a := s.app; sh := f[0].sheet; m := f[0].m; line := s.md.block_line;
  nl := 1;
  for i: 0..<code.count { if code[i] == '\n' && i + 1 < code.count { nl += 1; } }
  h := a.code_head + 2 * a.code_pad + cast(f32) nl * line;
  name := app_code_lang(lang);
  uiframe_open(f, uiframe_semantic(f, id, EL_REGION, name, x, y, w, h, 0, 0));
  _ := sheet_box(sh, x, y, w, h, a.code_radius, s.border, s.surface, s.menu_divider);
  _ := sheet_text(sh, m, -1, x + a.code_pad, y + (a.code_head - s.small.line) / 2, s.small.line, s.small.face, s.muted, name);
  // Copy: its icon and word on a ground that shows under the pointer, as far from the end as from the strip's top
  cid: [EL_ID] u8; cpid := app_id(cid[..], id, ".copy");
  word := ifx copied then "Copied" else "Copy";
  bw := 2 * a.code_copy_x + a.code_copy_icon + a.code_copy_gap + measure_width(m, s.small.face, word);
  bh := a.code_copy_h; bx := x + w - s.border - a.code_copy_edge - bw; by := y + (a.code_head - bh) / 2;
  hovered := uiframe_hover(f, KEYED_LAZY, cpid);   // eased (kit/frame.coax)
  if hovered > 0 { sheet_fill(sh, bx, by, bw, bh, a.code_radius - a.code_copy_edge, opacity(s.hover, hovered)); }
  tone := rgba_mix(s.muted, s.ink, hovered);
  mid: [EL_ID] u8;
  app_icon_swap(f, app_id(mid[..], id, ".mark"), bx + a.code_copy_x, by + (bh - a.code_copy_icon) / 2, a.code_copy_icon, s.icon_copy, s.icon_check, copied, tone);
  _ := sheet_text(sh, m, -1, bx + a.code_copy_x + a.code_copy_icon + a.code_copy_gap, by + (bh - s.small.line) / 2, s.small.line, s.small.face, tone, word);
  crow := uiframe_semantic(f, cpid, EL_BUTTON, ifx copied then "Copied" else "Copy code", bx, by, bw, bh, 0, action);
  sheet_hit(sh, UIFRAME_HIT, crow, 0, bx, by, bw, bh);
  colored := lang == "rust" || lang == "coax" || lang == "jai" || lang == "c" || lang == "swift";
  top := y + a.code_head + a.code_pad;
  // a line wider than the block is cut with an ellipsis, not clipped: the
  // block may sit in a scroll area or a tool's reveal, which hold the one clip
  room := w - 2 * a.code_pad;
  runs: [128] MdRun;
  i := 0; row := 0;
  while i < code.count {
    j := i; while j < code.count && code[j] != '\n' { j += 1; }
    part := cast(string) code[i..<j]; ly := top + cast(f32) row * line;
    fits := measure_width(m, s.mono.face, part) <= room;
    if colored && fits { markdown_syntax_line_veiled(sh, m, s, part, runs[..], x + a.code_pad, ly, line, s.mono.face, s.ink, base + i, vv); }
    else if vv.veil.count > 0 && fits {
      px := x + a.code_pad; q := 0;
      while q < part.count {
        n_to := md_veil_next(vv, base + i + q, base + j) - (base + i);
        if n_to <= q { n_to = part.count; }
        seg := cast(string) part[q..<n_to];
        va := md_veil_alpha(vv, base + i + q);
        if va > 0.001f32 { _ := sheet_plain(sh, m, px, ly, line, s.mono.face, opacity(s.ink, va), seg, true); }
        px += measure_width(m, s.mono.face, seg);
        q = n_to;
      }
    } else { _ := sheet_plain(sh, m, x + a.code_pad, ly, line, s.mono.face, opacity(s.ink, md_veil_alpha(vv, base + i)), ifx fits then part else app_fit(f, s.mono.face, part, room), true); }
    row += 1; i = j + 1;
  }
  uiframe_close(f);
  return h;
}
// An agent's message at (x, y), w wide: the blocks of a parsed Markdown
// document (core/markdown.coax md_parse; `blocks` is what it returned),
// painted by the one Markdown component (kit/markdown.coax): headings,
// emphasis, lists, task lists, links, quotes and tables. A fenced block is an
// app_code under id + ".code.N", whose Copy dispatches `copy_action`;
// `copied` is the block the app has copied (-1: none). A rule is a divider.
// Returns its height.
app_message_agent :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, doc: [] MdDoc, blocks: int, copied: int, copy_action: int) -> f32 {
  return app_message_agent_part(f, id, x, y, w, doc, 0, blocks, copied, copy_action);
}
// The same for `blocks` blocks of doc from block0, as when several messages share one document.
// Code blocks are numbered from block0 (".code.0" is the first), and so is `copied`.
app_message_agent_part :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, doc: [] MdDoc, block0: int, blocks: int, copied: int, copy_action: int) -> f32 {
  return app_message_agent_linked(f, id, x, y, w, doc, block0, blocks, copied, copy_action, 0);
}
// The same, and inline code that names a file (`apps/page.coax`, core/markdown.coax
// md_path_like) is a link: a row of its own, id + ".path.N" for the message's Nth such file
// counted from block0 (app_message_path is its text), underlined under the pointer, that
// dispatches `path_action` (0: none, the code is only text).
app_message_agent_linked :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, doc: [] MdDoc, block0: int, blocks: int, copied: int, copy_action: int, path_action: int) -> f32 {
  vv: MdVeil;
  return app_message_agent_linked_veiled(f, id, x, y, w, doc, block0, blocks, copied, copy_action, path_action, 0, vv);
}
// The same, with both inline-code file paths (path_action, .path.N) and http(s) URLs (link_action, .url.N).
app_message_agent_linked_urls :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, doc: [] MdDoc, block0: int, blocks: int, copied: int, copy_action: int, path_action: int, link_action: int) -> f32 {
  vv: MdVeil;
  return app_message_agent_linked_veiled(f, id, x, y, w, doc, block0, blocks, copied, copy_action, path_action, link_action, vv);
}
// The same with an optional paint-only opacity veil (ignored under reduced motion).
app_message_agent_linked_veiled :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, doc: [] MdDoc, block0: int, blocks: int, copied: int, copy_action: int, path_action: int, link_action: int, veil_in: MdVeil) -> f32 {
  s := f[0].skin; sh := f[0].sheet; m := f[0].m;
  vv: MdVeil;
  if !f[0].reduced_motion { vv = veil_in; }
  k := uiframe_key(f, id); from := app_sheet_mark(f);
  // a screen reader hears the whole message, block by block, and a new reply is announced (EL_S_LIVE)
  row := uiframe_semantic(f, id, EL_TEXT, ifx blocks > 0 then md_block_text(doc, block0) else "", x, y, w, s.md.line, EL_S_LIVE, 0);
  for b: block0 + 1..<block0 + blocks { if doc[0].blocks[b].kind != MB_RULE { uiframe_say(f, row, md_block_text(doc, b)); } }
  uiframe_open(f, row);
  h: f32 = 0; files := 0; urls := 0;
  for b: block0..<block0 + blocks {
    if b > block0 { h += s.md.block_gap; }
    kind := doc[0].blocks[b].kind;
    if kind == MB_CODE {
      part: [EL_ID] u8; cid: [EL_ID] u8;
      n := el_copy(part[..], ".code."); n = text_put_int(part[..], n, b - block0);
      h += app_code_veiled(f, app_id(cid[..], id, cast(string) part[0..<n]), x, y + h, w, md_lang(doc, b), md_block_text(doc, b), copied == b - block0, copy_action, vv, doc[0].blocks[b].at);
    } else if kind == MB_RULE { h += app_divider(f, x, y + h, w); }
    else if path_action == 0 && link_action == 0 { h += markdown_block_veiled(sh, m, s, doc, b, x, y + h, w, vv); }
    else {
      ls := s; ls.md.link_paths = path_action != 0; ls.md.link_urls = link_action != 0; nh0 := sh[0].nh;
      h += markdown_block_veiled(sh, m, ls, doc, b, x, y + h, w, vv);
      if path_action != 0 { files += app_message_paths(f, id, doc, b, nh0, files, path_action); }
      if link_action != 0 { urls += app_message_links(f, id, doc, b, nh0, urls, link_action); }
    }
  }
  uiframe_close(f);
  if row >= 0 && h > 0 { f[0].rows[0].rows[row].h = h; }
  app_enter(f, k, from);
  return h;
}
APP_MESSAGE_PATHS :: 64;    // files one block's inline code may name as links
// The path hits block b left on the sheet from hit nh0 on become link rows, numbered from
// `first`; the block's other hits stay. Returns how many files the block names.
app_message_paths :: (f: [] UiFrame, id: string, doc: [] MdDoc, b: int, nh0: int, first: int, action: int) -> int {
  s := f[0].skin; sh := f[0].sheet;
  paths: [APP_MESSAGE_PATHS] MdPath; np := markdown_paths(doc, b, paths[..]);
  found: [APP_MESSAGE_PATHS] SheetHit; at: [APP_MESSAGE_PATHS] int; nf := 0;
  keep := nh0; c := 0;
  for q: nh0..<sh[0].nh {
    hit := sh[0].hits[q];
    if hit.kind != MARKDOWN_HIT_PATH { sh[0].hits[keep] = hit; keep += 1; continue; }
    while c < np && !(paths[c].from == hit.a && paths[c].to == hit.b) { c += 1; }
    if c < np && nf < found.count { found[nf] = hit; at[nf] = c; nf += 1; c += 1; }
  }
  sh[0].nh = keep;
  for q: 0..<nf {
    hit := found[q]; p := paths[at[q]];
    pb: [EL_ID] u8; pn := el_copy(pb[..], ".path."); pn = text_put_int(pb[..], pn, first + at[q]);
    lb: [EL_ID] u8; lid := app_id(lb[..], id, cast(string) pb[0..<pn]);
    name := cast(string) p.text[p.from..<p.to];
    if uiframe_hovered(f, lid) { sheet_rule(sh, hit.x + s.md.code_pad_x, hit.y + hit.h - s.md.code_inset_y - s.border, hit.w - 2 * s.md.code_pad_x, s.border, s.accent); }
    link := uiframe_semantic(f, lid, EL_LINK, name, hit.x, hit.y, hit.w, hit.h, 0, action);
    sheet_hit(sh, UIFRAME_HIT, link, 0, hit.x, hit.y, hit.w, hit.h);
  }
  return np;
}
// The Nth file the message's inline code names (app_message_agent_linked's id + ".path.N"), "" for none.
app_message_path :: (doc: [] MdDoc, block0: int, blocks: int, n: int) -> string {
  if n < 0 { return ""; }
  seen := 0;
  for b: block0..<block0 + blocks {
    paths: [APP_MESSAGE_PATHS] MdPath; np := markdown_paths(doc, b, paths[..]);
    if n < seen + np { p := paths[n - seen]; return cast(string) p.text[p.from..<p.to]; }
    seen += np;
  }
  return "";
}
APP_MESSAGE_LINKS :: 64;    // http(s) links one block may carry
// The link hits block b left on the sheet from hit nh0 on become link rows, numbered from
// `first`; the block's other hits stay. A link wrapped across lines shares one semantic row.
app_message_links :: (f: [] UiFrame, id: string, doc: [] MdDoc, b: int, nh0: int, first: int, action: int) -> int {
  s := f[0].skin; sh := f[0].sheet;
  links: [APP_MESSAGE_LINKS] MdLink; nl := markdown_links(doc, b, links[..]);
  found: [APP_MESSAGE_LINKS * 4] SheetHit; at: [APP_MESSAGE_LINKS * 4] int; nf := 0;
  keep := nh0; c := 0;
  for q: nh0..<sh[0].nh {
    hit := sh[0].hits[q];
    if hit.kind != MARKDOWN_HIT_LINK { sh[0].hits[keep] = hit; keep += 1; continue; }
    if c < nl && links[c].at == hit.a && links[c].n == hit.b {
      if nf < found.count { found[nf] = hit; at[nf] = c; nf += 1; }
      continue;
    }
    c2 := c + 1;
    while c2 < nl && !(links[c2].at == hit.a && links[c2].n == hit.b) { c2 += 1; }
    if c2 < nl {
      c = c2;
      if nf < found.count { found[nf] = hit; at[nf] = c; nf += 1; }
    }
  }
  sh[0].nh = keep;
  rows: [APP_MESSAGE_LINKS] int;
  for q: 0..<nl { rows[q] = -1; }
  for q: 0..<nf {
    hit := found[q]; idx := at[q]; l := links[idx];
    pb: [EL_ID] u8; pn := el_copy(pb[..], ".url."); pn = text_put_int(pb[..], pn, first + idx);
    lb: [EL_ID] u8; lid := app_id(lb[..], id, cast(string) pb[0..<pn]);
    url := cast(string) doc[0].links[l.at..<l.at + l.n];
    if uiframe_hovered(f, lid) { sheet_rule(sh, hit.x, hit.y + hit.h - s.border, hit.w, s.border, s.accent); }
    link := rows[idx];
    if link < 0 {
      link = uiframe_semantic(f, lid, EL_LINK, url, hit.x, hit.y, hit.w, hit.h, 0, action);
      rows[idx] = link;
    }
    sheet_hit(sh, UIFRAME_HIT, link, 0, hit.x, hit.y, hit.w, hit.h);
  }
  return nl;
}
// The Nth http(s) link the message carries (app_message_agent_linked_urls's id + ".url.N"), "" for none.
app_message_url :: (doc: [] MdDoc, block0: int, blocks: int, n: int) -> string {
  if n < 0 { return ""; }
  seen := 0;
  for b: block0..<block0 + blocks {
    links: [APP_MESSAGE_LINKS] MdLink; nl := markdown_links(doc, b, links[..]);
    if n < seen + nl { l := links[n - seen]; return cast(string) doc[0].links[l.at..<l.at + l.n]; }
    seen += nl;
  }
  return "";
}
// The typing mark at (x, y): three dots that brighten in turn on the frame's
// clock while a reply is being written. Reduced motion shows them still.
// `label` says what is happening, for its live row. Returns its height.
app_typing :: (f: [] UiFrame, id: string, x: f32, y: f32, label: string) -> f32 {
  s := f[0].skin; a := s.app; h := s.md.line; count := APP_DOTS;
  w := cast(f32) count * a.dot + cast(f32) (count - 1) * a.dot_gap;
  _ := uiframe_semantic(f, id, EL_PROGRESS, label, x, y, w, h, EL_S_BUSY | EL_S_LIVE, 0);
  for i: 0..<count {
    lit: f32 = 1;
    if !f[0].reduced_motion {
      v := f[0].clock / a.dot_period - cast(f32) i / cast(f32) count;
      t := v - floor(v);
      wave := ifx t < 0.5 then 2 * t else 2 - 2 * t;
      lit = a.dot_dim + (1 - a.dot_dim) * wave;
    }
    sheet_fill(f[0].sheet, x + cast(f32) i * (a.dot + a.dot_gap), y + (h - a.dot) / 2, a.dot, a.dot, a.dot / 2, opacity(s.muted, lit));
  }
  return h;
}
// The empty conversation at (x, y), centred in w: an icon in a well, a title
// and a line or two under it. Returns its height.
app_empty :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, icon: int, title: string, detail: string) -> f32 {
  s := f[0].skin; a := s.app; side := s.control_h; mark := a.icon;
  sheet_fill(f[0].sheet, x + (w - side) / 2, y, side, side, side / 2, s.raised);
  sheet_icon(f[0].sheet, icon, x + (w - mark) / 2, y + (side - mark) / 2, mark, s.muted);
  h := side + s.space;
  th := app_centred(f, s.title, s.ink, x, y + h, w, title);
  _ := uiframe_semantic(f, id, EL_HEADING, title, x, y + h, w, th, 0, 0);
  h += th + a.gap_small;
  if detail.count > 0 {
    did: [EL_ID] u8;
    dh := app_centred(f, s.body, s.muted, x, y + h, w, detail);
    _ := uiframe_semantic(f, app_id(did[..], id, ".detail"), EL_TEXT, detail, x, y + h, w, dh, 0, 0);
    h += dh;
  }
  return h;
}
// An error line with its retry at (x, y), w wide: the skin's failure mark,
// what went wrong (a live notice row under id), and a quiet action at the
// right edge (id + ".retry", "" for none) that dispatches `action`. EL_S_BUSY
// rests the action while the retry runs. Returns its height.
app_retry :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, text: string, retry: string, state: int, action: int) -> f32 {
  s := f[0].skin; a := s.app; sh := f[0].sheet; m := f[0].m;
  busy := (state & (EL_S_BUSY | EL_S_DISABLED)) != 0;
  lw := ifx retry.count > 0 then form_link_width(m, s, retry) else 0.0f32;
  lead := a.notice_icon + a.gap;
  rows: [APP_WRAP_LINES] TextLine;
  n := text_wrap_lines(m, uiskin_faces(s), text, ifx w - lead - lw > 1 then w - lead - lw else 1.0f32, rows[..]);
  th := cast(f32) n * s.body.line; h := ifx th > s.control_h then th else s.control_h; ty := y + (h - th) / 2;
  sheet_icon(sh, a.icon_alert, x, ty + (s.body.line - a.notice_icon) / 2, a.notice_icon, s.ink);
  for i: 0..<n { _ := sheet_text(sh, m, -1, x + lead, ty + cast(f32) i * s.body.line, s.body.line, s.body.face, s.ink, cast(string) text[rows[i].from..<rows[i].to]); }
  _ := uiframe_semantic(f, id, EL_NOTICE, text, x, ty, w - lw, th, EL_S_LIVE, 0);
  if retry.count > 0 {
    rid: [EL_ID] u8;
    _ := ctx_link(f, app_id(rid[..], id, ".retry"), x + w - lw, y + (h - s.control_h) / 2, retry, "", ifx busy then EL_S_DISABLED else 0, ifx busy then 0 else action);
  }
  return h;
}
// The jump to the latest message: a round button centred on cx, with the
// skin's lift under it, that rises in when its id first appears. `label` is
// what it does ("Jump to latest"). Returns the target's side.
app_jump :: (f: [] UiFrame, id: string, cx: f32, y: f32, label: string, state: int, action: int) -> f32 {
  s := f[0].skin; a := s.app; sh := f[0].sheet; side := a.icon_button; well := a.icon_well; x := cx - side / 2; inset := (side - well) / 2;
  mid: [EL_ID] u8;
  k := uiframe_key(f, app_id(mid[..], id, ".in")); from := app_sheet_mark(f);
  sheet_under(sh, uiskin_float(sh[0].under, sh[0].nu, s, x + inset, y + inset, well, well, well / 2));
  _ := app_icon_button(f, id, x, y, s.icon_chevron, label, APP_BUTTON_DEFAULT, state, action);
  app_enter(f, k, from);
  return side;
}
// The way back to the end of a transcript, as Zeron's (ds/transcript): a pill centred on cx, its
// foot at `bottom`, on the skin's floating ground with its lift under it: a working dot while a
// reply is written (`writing`), its label ("Jump to latest", "New reply") and a down arrow. While
// `shown` it rises in from pill_rise below over pill_in (outQuad), and when no longer shown it
// sinks and fades over pill_out; call it every frame, it draws nothing once gone. Returns whether
// it shows at all.
app_jump_pill :: (f: [] UiFrame, id: string, cx: f32, bottom: f32, label: string, writing: bool, shown: bool, action: int) -> bool {
  s := f[0].skin; a := s.app; sh := f[0].sheet; m := f[0].m;
  k := uiframe_key(f, id);
  v := keyed_press(f[0].keyed, k, shown, ifx shown then a.pill_in else a.pill_out, AM_OUT_QUAD);
  if v <= 0 { return false; }
  from := app_sheet_mark(f);
  dot := ifx writing then a.state_dot + a.pill_gap else 0.0f32;
  tw := measure_width(m, s.tool.face, label);
  pw := ceil(a.pill_pad + dot + tw + a.pill_gap + a.pill_icon + a.pill_pad); ph := a.pill_h;
  px := cx - pw / 2; py := bottom - ph; r := ph / 2;
  hovered := uiframe_hover(f, k, id);
  sheet_under(sh, uiskin_float(sh[0].under, sh[0].nu, s, px, py, pw, ph, r));
  sheet_under(sh, prim_box(sh[0].under, sh[0].nu, px, py, pw, ph, r, s.border, ifx s.float_ground.a > 0 then s.float_ground else s.surface, s.field_edge));
  if hovered > 0 { sheet_fill(sh, px, py, pw, ph, r, opacity(s.hover, hovered)); }
  tx := px + a.pill_pad;
  if writing { sheet_fill(sh, tx, py + (ph - a.state_dot) / 2, a.state_dot, a.state_dot, a.state_dot / 2, s.ink); tx += dot; }
  _ := sheet_text(sh, m, -1, tx, py + (ph - s.tool.line) / 2, s.tool.line, s.tool.face, s.ink, label);
  if s.icon_chevron >= 0 { sheet_icon(sh, s.icon_chevron, tx + tw + a.pill_gap, py + (ph - a.pill_icon) / 2, a.pill_icon, s.ink); }
  if shown {
    row := uiframe_semantic(f, id, EL_BUTTON, label, px, py, pw, ph, 0, action);
    sheet_hit(sh, UIFRAME_HIT, row, 0, px, py, pw, ph);
  }
  if v < 1 {
    dy := (1 - v) * a.pill_rise;
    prim_move(sh[0].under, from.nu, sh[0].nu, 0, dy); prim_move(sh[0].over, from.no, sh[0].no, 0, dy);
    prim_opacity(sh[0].under, from.nu, sh[0].nu, v); prim_opacity(sh[0].over, from.no, sh[0].no, v);
  }
  return true;
}
// A date or meta line at (x, y), w wide: small, quiet words, centred (a
// date between messages) or at the left (a message's time and model).
// Returns its height.
app_meta :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, text: string, centred: bool) -> f32 {
  s := f[0].skin; m := f[0].m; shown := app_fit(f, s.small.face, text, w);
  tx := ifx centred then x + (w - measure_width(m, s.small.face, shown)) / 2 else x;
  _ := sheet_text(f[0].sheet, m, -1, tx, y, s.small.line, s.small.face, s.faint, shown);
  _ := uiframe_semantic(f, id, EL_TEXT, text, x, y, w, s.small.line, 0, 0);
  return s.small.line;
}

#load "chat-checks.coax" #test;
