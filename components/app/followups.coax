// Follow-ups over a composer (GitHub #13717), after Zeron's composer deck (apps/zgx/ui/ds/composer_dock.luau,
// MIT, read only): the steers that wait for the reply's next step and the messages queued for after
// it, as one card docked on the composer's top edge, and a steer the reply took in, in the timeline.
//
// The tray: a head (what it holds, or why the queue is paused, with Resume and Clear) over its rows.
// A row is its badge (Steering, Not taken, or its place in the queue), its text on one line and its
// actions at its end. A queued row has Move up, Edit, Remove and one primary action, Steer while a
// reply runs (it goes in mid-turn) else Send now; a waiting steer has Send now (the reply stops and
// the steer starts the next one); a steer not taken has Queue and Dismiss. A row being edited says so.
//
// Each button's id is its row's id and the op's word ("coder.fu.q2.up"); app_fu_op reads the op back
// from a pressed id. The press reaches the app as the tray's action, as every component's does.
//
// Checks: coax/bin/coax test components/app/followups.coax
#load "chat.coax";

APP_FU_STEER :: 0;            // a steer the reply has not taken in yet
APP_FU_REJECTED :: 1;         // a steer the reply did not take
APP_FU_QUEUED :: 2;           // a message queued for after the reply

APP_FU_OP_NONE :: 0;
APP_FU_OP_RESUME :: 1; APP_FU_OP_CLEAR :: 2; APP_FU_OP_DELETE :: 3; APP_FU_OP_UP :: 4; APP_FU_OP_EDIT :: 5;
APP_FU_OP_SEND :: 6;          // a queued row's primary: Steer while a reply runs, else Send now
APP_FU_OP_NOW :: 7;           // a waiting steer's Send now: the reply stops and the steer starts the next
APP_FU_OP_DISMISS :: 8; APP_FU_OP_REQUEUE :: 9;
APP_FU_WORDS :: [10] string.["", "resume", "clear", "del", "up", "edit", "send", "now", "dismiss", "queue"];

APP_FU_SHOWN :: 5;            // rows the tray shows; the rest are counted under them

AppFuRow :: struct {
  id: string;                 // its buttons' ids start with it
  kind: int;                  // APP_FU_*
  text: string;               // what was written (its first line shows)
  place: int;                 // a queued row's place, from 1
  note: string;               // a steer not taken: why
  editing: bool;              // its text is in the composer
  first: bool;                // the queue's head: no Move up
}
AppFuTray :: struct {
  head: string;               // "Queued · 2", "Paused · after an error"
  paused: bool;               // Resume shows
  clear: bool;                // Clear shows (the queue has items)
  running: bool;              // a reply runs: a queued row's primary is Steer
  more: int;                  // rows not shown
}

// The op a pressed button's id names, from its last word; APP_FU_OP_NONE for none.
app_fu_op :: (pressed: string) -> int {
  at := -1;
  for c, i: pressed { if c == '.' { at = i; } }
  if at < 0 { return APP_FU_OP_NONE; }
  word := cast(string) pressed[at + 1..<pressed.count];
  words := APP_FU_WORDS;
  for k: 1..<words.count { if word == words[k] { return k; } }
  return APP_FU_OP_NONE;
}
// The first line of text, for a row.
app_fu_line :: (text: string) -> string {
  for c, i: text { if c == '\n' { return cast(string) text[0..<i]; } }
  return text;
}
// A row's badge: Steering, Not taken, or its place in the queue (written into nb).
app_fu_badge :: (r: AppFuRow, nb: [] u8) -> string {
  if r.kind == APP_FU_STEER { return "Steering"; }
  if r.kind == APP_FU_REJECTED { return "Not taken"; }
  return cast(string) nb[0..<el_put_i(nb, 0, r.place)];
}
// A row's height: a small button's with room around it.
app_fu_row_h :: (f: [] UiFrame) -> f32 { a := f[0].skin.app.icon_button; c := f[0].skin.cmp.chip_h; return (ifx a > c then a else c) + 2; }
// The tray's height for n rows shown.
app_fu_height :: (f: [] UiFrame, t: AppFuTray, n: int) -> f32 {
  a := f[0].skin.app; s := f[0].skin;
  h := 2 * a.gap_small + app_fu_row_h(f) + cast(f32) n * app_fu_row_h(f);
  if t.more > 0 { h += s.small.line + a.gap_small; }
  return h;
}

// The tray, docked by its bottom edge at `bottom` over a composer at x, w wide; rows in order.
// Returns its height (0 with nothing to show).
app_fu_tray :: (f: [] UiFrame, id: string, x: f32, bottom: f32, w: f32, t: AppFuTray, rows: [] AppFuRow, action: int) -> f32 {
  n := rows.count;
  if n == 0 && !t.paused { return 0; }
  s := f[0].skin; a := s.app; sh := f[0].sheet; m := f[0].m;
  h := app_fu_height(f, t, n);
  y := bottom - h;
  uiframe_open(f, uiframe_semantic(f, id, EL_REGION, "Follow-ups", x, y, w, h, 0, 0));
  _ := sheet_box(sh, x, y, w, h, a.card_radius, s.border, s.surface, s.hover);
  pad := a.gap; ib: [EL_ID] u8;
  // the head: what it holds, and Resume and Clear at its end
  hy := y + a.gap_small;
  bx := x + w - pad;
  rh := app_fu_row_h(f); side := a.icon_button; ch := s.cmp.chip_h;
  if t.clear {
    bx -= app_chip_width(f, -1, "Clear", 0);
    _ := app_chip(f, app_id(ib[..], id, ".clear"), bx, hy + (rh - ch) / 2, 0, -1, "Clear", "Clear", 0, action);
    bx -= a.gap_small;
  }
  if t.paused {
    bx -= app_chip_width(f, -1, "Resume", 0);
    _ := app_chip(f, app_id(ib[..], id, ".resume"), bx, hy + (rh - ch) / 2, 0, -1, "Resume", "Resume", EL_S_CURRENT, action);
    bx -= a.gap_small;
  }
  head := app_fit(f, s.label.face, t.head, bx - x - pad);
  _ := sheet_text(sh, m, -1, x + pad, hy + (rh - s.label.line) / 2, s.label.line, s.label.face, ifx t.paused then s.ink else s.muted, head);
  y = hy + rh;
  // the badge column is as wide as the widest badge shown, so a queue of numbers keeps its text close
  badge_w: f32 = 0;
  for i: 0..<n {
    nb: [24] u8;
    bw := measure_width(m, s.small.face, app_fu_badge(rows[i], nb[..]));
    if bw > badge_w { badge_w = bw; }
  }
  badge_w += a.gap;
  for i: 0..<n {
    r := rows[i];
    ry := y + cast(f32) i * rh;
    ty := ry + (rh - s.body.line) / 2;
    text := app_fu_line(r.text);
    if text.count == 0 { text = "(follow-up)"; }
    _ := uiframe_semantic(f, r.id, EL_TEXT, text, x + pad, ry, w - 2 * pad, rh, 0, 0);
    // its badge
    nb: [24] u8;
    badge := app_fu_badge(r, nb[..]);
    _ := sheet_text(sh, m, -1, x + pad, ry + (rh - s.small.line) / 2, s.small.line, s.small.face, ifx r.kind == APP_FU_QUEUED then s.faint else s.ink, sheet_pool(sh, badge));
    // its actions, from the row's end
    ax := x + w - pad;
    if r.editing {
      note := "Editing · Return saves · Esc cancels";
      nw := measure_width(m, s.small.face, note); ax -= nw;
      _ := sheet_text(sh, m, -1, ax, ry + (rh - s.small.line) / 2, s.small.line, s.small.face, s.muted, note);
      ax -= a.gap;
    } else if r.kind == APP_FU_QUEUED {
      label := ifx t.running then "Steer" else "Send now";
      ax -= app_chip_width(f, -1, label, 0);
      _ := app_chip(f, app_id(ib[..], r.id, ".send"), ax, ry + (rh - ch) / 2, 0, -1, label, label, 0, action);
      ax -= side + a.gap_small;
      _ := app_icon_button(f, app_id(ib[..], r.id, ".del"), ax, ry + (rh - side) / 2, ICON_CLOSE, "Remove", APP_BUTTON_QUIET, 0, action);
      ax -= side;
      _ := app_icon_button(f, app_id(ib[..], r.id, ".edit"), ax, ry + (rh - side) / 2, ICON_PEN, "Edit", APP_BUTTON_QUIET, 0, action);
      ax -= side;
      _ := app_icon_button(f, app_id(ib[..], r.id, ".up"), ax, ry + (rh - side) / 2, ICON_ARROW_UP, "Move up", APP_BUTTON_QUIET, ifx r.first then EL_S_DISABLED else 0, action);
    } else if r.kind == APP_FU_STEER {
      ax -= app_chip_width(f, -1, "Send now", 0);
      _ := app_chip(f, app_id(ib[..], r.id, ".now"), ax, ry + (rh - ch) / 2, 0, -1, "Send now", "Send now", 0, action);
    } else {
      ax -= side;
      _ := app_icon_button(f, app_id(ib[..], r.id, ".dismiss"), ax, ry + (rh - side) / 2, ICON_CLOSE, "Dismiss", APP_BUTTON_QUIET, 0, action);
      ax -= app_chip_width(f, -1, "Queue", 0) + a.gap_small;
      _ := app_chip(f, app_id(ib[..], r.id, ".queue"), ax, ry + (rh - ch) / 2, 0, -1, "Queue", "Queue", 0, action);
      if r.note.count > 0 {
        nw := measure_width(m, s.small.face, r.note); room := (ax - x) / 3;
        if nw > room { nw = room; }
        ax -= a.gap + nw;
        _ := sheet_text(sh, m, -1, ax, ry + (rh - s.small.line) / 2, s.small.line, s.small.face, s.muted, app_fit(f, s.small.face, r.note, nw));
      }
    }
    // its text, on one line, between
    tx := x + pad + badge_w; room := ax - a.gap - tx;
    if room > 0 {
      shown := app_fit(f, s.body.face, text, room);
      _ := sheet_text(sh, m, -1, tx, ty, s.body.line, s.body.face, ifx r.kind == APP_FU_REJECTED then s.muted else s.ink, shown);
    }
  }
  if t.more > 0 {
    mb: [48] u8; mn := el_put_i(mb[..], 0, t.more); mn = el_put(mb[..], mn, " more queued");
    _ := sheet_text(sh, m, -1, x + pad, y + cast(f32) n * rh, s.small.line, s.small.face, s.faint, sheet_pool(sh, cast(string) mb[0..<mn]));
  }
  uiframe_close(f);
  return h;
}

// A steer the reply took in, in the timeline at (x, y), w wide, where it was taken (#13809): the
// person's words at the column's right edge, as their message is, under a small "Steer" badge.
// Returns its height.
app_message_steer :: (f: [] UiFrame, id: string, x: f32, y: f32, w: f32, text: string) -> f32 {
  s := f[0].skin; a := s.app; m := f[0].m;
  label := "Steer";
  _ := sheet_text(f[0].sheet, m, -1, x + w - measure_width(m, s.small.face, label), y, s.small.line, s.small.face, s.faint, label);
  h := s.small.line + a.gap_small;
  return h + app_message_user(f, id, x, y + h, w, ifx text.count > 0 then text else "(steer)");
}

#load "followups-checks.coax" #test;
