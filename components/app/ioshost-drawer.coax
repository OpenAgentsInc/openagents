// A sliding drawer from the left edge with a scrim over the rest of the screen
// (components/app/README.md; GitHub #13645). Added by claude-ios-host for the
// iOS app's navigation button; the app set had no drawer.
//
// `share` is how far the drawer is open, 0 to 1: the caller animates it
// (app_drawer_ease) and owns whether it is open. The scrim dims the screen by
// the share and closes the drawer when pressed; the panel takes presses that
// land on it, so nothing under it is pressed through.
//   coax/bin/coax test components/app/ioshost-drawer.coax

#load "base.coax";

APP_DRAWER_MOST :: 320.0;     // the panel's widest, in layout units
APP_DRAWER_SHARE :: 0.84;     // the panel's share of a narrow screen
APP_DRAWER_DIM :: 0.55;       // the scrim's darkness when fully open
APP_DRAWER_RATE :: 16.0;      // how fast the share follows its target, per second

// The panel's width on a screen w wide.
app_drawer_width :: (w: f32) -> f32 { d := w * APP_DRAWER_SHARE; return ifx d > APP_DRAWER_MOST then APP_DRAWER_MOST else d; }

// The share one frame later, following `open`. Reduced motion jumps.
app_drawer_ease :: (share: f32, open: bool, dt: f32, reduced: bool) -> f32 {
  goal: f32 = ifx open then 1 else 0;
  if reduced { return goal; }
  k := dt * APP_DRAWER_RATE; if k > 1 { k = 1; }
  next := share + (goal - share) * k;
  if abs(next - goal) < 0.004 { return goal; }
  return next;
}

// The scrim over (0, 0, w, h) and the drawer's panel, h tall, slid in by
// `share`. The scrim is a button `scrim_id` ("Close menu") that dispatches
// `close`. Returns where the panel's content goes: inside its padding and
// under the safe area `top`. Draws nothing and returns w 0 at share 0.
app_drawer :: (f: [] UiFrame, id: string, scrim_id: string, w: f32, h: f32, top: f32, share: f32, label: string, close: int) -> PanelInside {
  if !(share > 0) { return PanelInside.{}; }
  s := f[0].skin; a := s.app; sh := f[0].sheet;
  pw := app_drawer_width(w); x := -(1 - share) * pw;
  black := Rgba.{r = 0, g = 0, b = 0, a = 1};
  sheet_fill(sh, 0, 0, w, h, 0, opacity(black, APP_DRAWER_DIM * share));
  scrim := uiframe_semantic(f, scrim_id, EL_BUTTON, "Close menu", x + pw, 0, w - x - pw, h, 0, close);
  sheet_hit(sh, UIFRAME_HIT, scrim, 0, x + pw, 0, w - x - pw, h);
  // the panel's box runs past the screen's left, top and bottom edges, so only its right edge shows
  // a border: it sits flush with the left edge
  out := a.card_radius + 4;
  sheet_under(sh, uiskin_float(sh[0].under, sh[0].nu, s, x - out, -out, pw + out, h + 2 * out, a.card_radius));
  _ := sheet_box(sh, x - out, -out, pw + out, h + 2 * out, a.card_radius, s.border, s.surface, s.hover);
  panel := uiframe_semantic(f, id, EL_REGION, label, x, 0, pw, h, 0, 0);
  sheet_hit(sh, UIFRAME_HIT, panel, 0, x, 0, pw, h);
  uiframe_open(f, panel);
  return PanelInside.{x = x + a.card_pad, y = top + a.card_pad, w = pw - 2 * a.card_pad};
}
app_drawer_end :: (f: [] UiFrame, inside: PanelInside) { if inside.w > 0 { uiframe_close(f); } }

#load "ioshost-drawer-checks.coax" #test;
