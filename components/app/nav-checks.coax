// Checks for the app set's navigation components (nav.coax).
#load "checks-kit.coax";

#test "app nav: grouped history measures headings and routes each visible row's own action" {
 t:[1]AppTest;app_test_init(t[..]);rows:=[3]AppSideRow.[AppSideRow.{id="g",title="Computer",heading=true,action=0},AppSideRow.{id="one",title="One",action=17},AppSideRow.{id="more",title="More",action=18}];
 app_test_begin(t[..],"","",true);height:=t[0].f[0].skin.app.side_row;head:=t[0].f[0].skin.app.side_head;
 #assert app_side_content(t[0].f[..],rows[..])==head+2*height;
 _:=app_side_window(t[0].f[..],0,0,80,head+height,rows[..],head,0,9);
 #assert app_test_end(t[..]) && app_test_row(t[..],"one").y==0 && app_test_row(t[..],"one").action==17 && app_test_row(t[..],"more").action==18;
 #assert !app_test_pressable(t[..],"g");
}

#test "app nav: the navigation button says what a press does; history rows are current, busy and two-line, and keep their state by id when reordered" {
  t: [1] AppTest; app_test_init(t[..]); f := t[0].f[..]; s := arcade_phone_skin();
  rows := [3] AppSideRow.[AppSideRow.{id = "chat.a1", title = "Fix the failing check", detail = "Codex · 2 min ago", state = EL_S_CURRENT},
    AppSideRow.{id = "chat.b2", title = "Why the build ran out of memory", detail = "", state = EL_S_BUSY},
    AppSideRow.{id = "chat.c3", title = "Draft the release notes for the week of November 9", detail = "Claude Code · Yesterday"}];
  app_test_begin(t[..], "chat.b2", "", false);
  side := app_nav_button(f, "nav", 10, 0, false, 0, 1);
  h := app_side_list(f, "side.today", 0, 60, 60, "Today", rows[..], 2);
  #assert app_test_end(t[..]) && side == s.app.nav && h == s.app.side_head + 2 * s.app.side_row_two + s.app.side_row;
  #assert app_test_label(t[..], "nav") == "Open sidebar" && app_test_has(t[..], "nav", EL_S_EXPANDS) && !app_test_has(t[..], "nav", EL_S_EXPANDED) && app_test_pressable(t[..], "nav") && app_test_prims(t[..], PRIM_ICON) == 1;
  #assert app_test_row(t[..], "side.today").role == EL_HEADING && app_test_row(t[..], "chat.a1").role == EL_ROW && app_test_has(t[..], "chat.a1", EL_S_CURRENT) && app_test_value(t[..], "chat.a1") == "Codex · 2 min ago";
  #assert app_test_has(t[..], "chat.b2", EL_S_BUSY | EL_S_PRESSED) && app_test_pressable(t[..], "chat.c3") && app_test_row(t[..], "chat.c3").action == 2 && app_test_prims(t[..], PRIM_ARC) == 2;
  // the long title is cut to the row (a cell a character: 32 of room); its row keeps what fits a label
  #assert app_test_texts(t[..], "Draft the release notes for the week of November 9") == 0;
  // chat.b2 is held: its press is under way. The list is reordered while it is: the motion stays with chat.b2
  k := keyed_find(t[0].ks[..], "chat.b2"); lit := t[0].keys[k].press[0].value;
  #assert lit > 0 && t[0].keys[keyed_find(t[0].ks[..], "chat.a1")].press[0].value == 0;
  back := [3] AppSideRow.[rows[2], rows[1], rows[0]];
  app_test_begin(t[..], "chat.b2", "", false);
  _ := app_side_list(f, "side.today", 0, 60, 60, "Today", back[..], 2);
  #assert app_test_end(t[..]) && t[0].keys[keyed_find(t[0].ks[..], "chat.b2")].press[0].value > lit && t[0].keys[keyed_find(t[0].ks[..], "chat.c3")].press[0].value == 0 && t[0].ks[0].refused == 0;
  #assert app_test_row(t[..], "chat.c3").y < app_test_row(t[..], "chat.b2").y && app_test_row(t[..], "chat.b2").y < app_test_row(t[..], "chat.a1").y;
  // the open sidebar's button
  app_test_begin(t[..], "", "", true);
  _ := app_nav_button(f, "nav", 10, 0, true, 0, 1);
  #assert app_test_end(t[..]) && app_test_label(t[..], "nav") == "Close sidebar" && app_test_has(t[..], "nav", EL_S_EXPANDED);
}

#test "app nav: a history window realizes only visible rows, two-line where a row has a detail, and uses their stable IDs" {
 t:[1]AppTest;app_test_init(t[..]);rows:=[4]AppSideRow.[AppSideRow.{id="h.a",title="First title",detail="Hidden detail"},AppSideRow.{id="h.b",title="A very long second title which is truncated"},AppSideRow.{id="h.c",title="Third",state=EL_S_CURRENT},AppSideRow.{id="h.d",title="Fourth"}];
 app_test_begin(t[..],"","",true);height:=t[0].f[0].skin.app.side_row;two:=t[0].f[0].skin.app.side_row_two;
 n:=app_side_window(t[0].f[..],0,20,40,height*2,rows[..],two,0,9);
 #assert app_test_end(t[..]) && n==two+3*height && t[0].sf[0].generation==1;
 #assert app_test_row(t[..],"h.b").h==height && app_test_row(t[..],"h.c").h==height && app_test_has(t[..],"h.c",EL_S_CURRENT);
 #assert app_test_texts(t[..],"Hidden detail")==0 && app_test_texts(t[..],"A very long second title which is truncated")==0;
 #assert !app_test_pressable(t[..],"h.a") && !app_test_pressable(t[..],"h.d");
 app_test_begin(t[..],"","",true);n=app_side_window(t[0].f[..],0,20,40,height*2,rows[..],two+height*2,height,9);
 #assert app_test_end(t[..]) && n==two+4*height && app_test_row(t[..],"h.d").y==20;
 // scrolled to the top, the first row shows its second line
 app_test_begin(t[..],"","",true);_=app_side_window(t[0].f[..],0,20,200,two+height,rows[..],0,0,9);
 #assert app_test_end(t[..]) && app_test_row(t[..],"h.a").h==two && app_test_texts(t[..],"Hidden detail")==1;

}

#test "app nav: unread rows draw a dot only when neither current nor busy" {
  t: [1] AppTest; app_test_init(t[..]); f := t[0].f[..];
  rows := [3] AppSideRow.[
    AppSideRow.{id = "u.read", title = "Read"},
    AppSideRow.{id = "u.unread", title = "Unread", unread = true},
    AppSideRow.{id = "u.busy", title = "Busy", state = EL_S_BUSY, unread = true}];
  app_test_begin(t[..], "", "", true);
  _ := app_side_window(f, 0, 0, 120, 200, rows[..], 0, 0, 5);
  #assert app_test_end(t[..]);
  // Only u.unread draws a filled dot primitive (u.read has none; u.busy draws its activity arcs).
  #assert app_test_prims(t[..], PRIM_BOX) == 1 && app_test_prims(t[..], PRIM_ARC) == 2;
  // Marking u.unread as current suppresses the dot (only the current highlight rect is drawn).
  cur_rows := [1] AppSideRow.[AppSideRow.{id = "u.unread", title = "Unread", state = EL_S_CURRENT, unread = true}];
  app_test_begin(t[..], "", "", true);
  _ := app_side_window(f, 0, 0, 120, 200, cur_rows[..], 0, 0, 5);
  #assert app_test_end(t[..]) && app_test_prims(t[..], PRIM_BOX) == 1;
}

#test "app nav: a window row carries Zeron's status at the right of its title: a short age, or Needs you with the accent dot, over the activity mark" {
 b:[8]u8;
 #assert app_side_age(1000000,0,b[..])=="" && app_side_age(1000000,990000,b[..])=="now" && app_side_age(10*60000,5*60000,b[..])=="5m";
 #assert app_side_age(4*3600000,3600000,b[..])=="3h" && app_side_age(3*86400000,86400000,b[..])=="2d" && app_side_age(43*86400000,1,b[..])=="6w";
 t:[1]AppTest;app_test_init(t[..]);
 rows:=[3]AppSideRow.[AppSideRow.{id="r.a",title="Alpha",status="5m"},AppSideRow.{id="r.b",title="Beta",status="Needs you",attention=true,state=EL_S_BUSY},AppSideRow.{id="r.c",title="Gamma",status="2h",state=EL_S_BUSY}];
 app_test_begin(t[..],"","",true);height:=t[0].f[0].skin.app.side_row;
 #assert app_side_content(t[0].f[..],rows[..])==3*height;
 _:=app_side_window(t[0].f[..],0,0,300,400,rows[..],0,0,5);
 #assert app_test_end(t[..]) && app_test_texts(t[..],"5m")==1 && app_test_texts(t[..],"Needs you")==1 && app_test_texts(t[..],"2h")==0;
 #assert app_test_row(t[..],"r.b").h==height && app_test_pressable(t[..],"r.a");
}

#test "app nav: Projects heading supports a trailing folder-plus button, folder rows carry icons, and child chats indent with a tree rail" {
  t: [1] AppTest; app_test_init(t[..]);
  rows := [3] AppSideRow.[
    AppSideRow.{id = "p.head", title = "Projects", heading = true, trail_icon = ICON_FOLDER_ADD, head_btn_id = "p.add", head_btn_label = "Add project", head_btn_action = 41},
    AppSideRow.{id = "p.0", title = "openagents", status = "3", icon = ICON_FOLDER, trail_icon = ICON_CHEVRON, action = 42, state = EL_S_EXPANDS | EL_S_EXPANDED},
    AppSideRow.{id = "c.0", title = "Fix sidebar", indent = 24.0f32, tree_line = true}];
  app_test_begin(t[..], "", "", true);
  _ := app_side_window(t[0].f[..], 0, 0, 260, 200, rows[..], 0, 0, 43);
  #assert app_test_end(t[..]);
  #assert app_test_row(t[..], "p.head").role == EL_HEADING && !app_test_pressable(t[..], "p.head");
  #assert app_test_row(t[..], "p.add").role == EL_BUTTON && app_test_row(t[..], "p.add").action == 41 && app_test_pressable(t[..], "p.add");
  #assert app_test_row(t[..], "p.0").action == 42 && app_test_has(t[..], "p.0", EL_S_EXPANDS | EL_S_EXPANDED);
  #assert app_test_row(t[..], "c.0").action == 43 && app_test_prims(t[..], PRIM_ICON) == 3 && app_test_prims(t[..], PRIM_BOX) == 1;
}

#test "app nav: compact 2-line chat card puts title and status on line 1, small folder icon with repo and branch plus harness on line 2" {
  t: [1] AppTest; app_test_init(t[..]);
  rows := [2] AppSideRow.[
    AppSideRow.{id = "chat.1", title = "Collapse sidebar card", status = "2m", icon = ICON_FOLDER_8, card = true, repo = "openagents", branch = "main", harness_icon = ICON_BOT},
    AppSideRow.{id = "chat.2", title = "No folder chat", status = "1h", icon = -1, card = true, harness_icon = ICON_BOT}];
  app_test_begin(t[..], "", "", true);
  #assert app_side_content(t[0].f[..], rows[..]) == 2 * APP_SIDE_CARD_H;
  _ := app_side_window(t[0].f[..], 0, 0, 260, 200, rows[..], 0, 0, 50);
  #assert app_test_end(t[..]);
  #assert app_test_row(t[..], "chat.1").h == APP_SIDE_CARD_H && app_test_row(t[..], "chat.2").h == APP_SIDE_CARD_H;
  #assert app_test_texts(t[..], "Collapse sidebar card") == 1 && app_test_texts(t[..], "2m") == 1;
  #assert app_test_texts(t[..], "openagents") == 1 && app_test_texts(t[..], "main") == 1;
  // Folder icon uses atlas slot ICON_FOLDER_8 (8pt) with 7pt right padding; harness icons draw at 11pt.
  sh := surface_sheet(t[0].sf[..]);
  folder_icons := 0;
  harness_icons := 0;
  folder_right := 0.0f32;
  for i: 0..<sh.nu {
    if sh.under[i].kind == PRIM_ICON {
      if sh.under[i].id == ICON_FOLDER_8 {
        #assert sh.under[i].w == APP_SIDE_CARD_FOLDER_ICON && sh.under[i].h == APP_SIDE_CARD_FOLDER_ICON;
        folder_right = sh.under[i].x + sh.under[i].w;
        folder_icons += 1;
      } else {
        #assert sh.under[i].w == APP_SIDE_CARD_ICON && sh.under[i].h == APP_SIDE_CARD_ICON;
        harness_icons += 1;
      }
    }
  }
  #assert folder_icons == 1 && harness_icons == 2 && ICON_SIZES[ICON_FOLDER_8] == 8.0f32;
  #assert app_test_text_x(t[..], "openagents") == folder_right + APP_SIDE_CARD_FOLDER_GAP;
}
