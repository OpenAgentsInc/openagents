// Responsive secondary/inspector pane shared by Coder Desktop and OpenAgents Mobile.
// On wide viewports it docks as a resizable right split pane; on narrow viewports it opens
// full-width over the conversation column.
#load "chat.coax";
#load "activity.coax";

APP_PANE_SIDE :: 0; // wide viewport: docked resizable right split pane
APP_PANE_FULL :: 1; // narrow viewport: full-width overlay sheet

APP_PANE_DEFAULT :: 440.0f32;
APP_PANE_MIN :: 320.0f32;
APP_PANE_MAX :: 900.0f32;
APP_PANE_MAIN_MIN :: 380.0f32;

AppPaneSpec :: struct {
  default_w: f32;
  min_w: f32;
  max_w: f32;
  main_min: f32;
}

app_pane_spec_default :: () -> AppPaneSpec {
  return AppPaneSpec.{
    default_w = APP_PANE_DEFAULT,
    min_w = APP_PANE_MIN,
    max_w = APP_PANE_MAX,
    main_min = APP_PANE_MAIN_MIN,
  };
}

AppPaneLayout :: struct {
  mode: int; // APP_PANE_SIDE or APP_PANE_FULL
  open: bool;
  x: f32;
  w: f32;
}

// Clamps a persisted user-dragged pane width into [min_w, max_w]; 0 keeps the default.
app_pane_clamp :: (w: f32, spec: AppPaneSpec) -> f32 {
  if !(w > 0) { return 0.0f32; }
  if w < spec.min_w { return spec.min_w; }
  if w > spec.max_w { return spec.max_w; }
  return w;
}

// Computes the new right pane width while dragging its left edge to ux.
app_pane_drag :: (ux: f32, win_w: f32, left_w: f32, spec: AppPaneSpec) -> f32 {
  wv := win_w - ux;
  most := win_w - left_w - spec.main_min;
  if wv > most { wv = most; }
  if wv > spec.max_w { wv = spec.max_w; }
  if wv < spec.min_w { wv = spec.min_w; }
  return wv;
}

// Solves the right pane's width and mode given the viewport width and user preference.
// When win_w - spec.min_w < spec.main_min, the pane takes the full viewport width.
app_pane_layout :: (win_w: f32, user_w: f32, open: bool, spec: AppPaneSpec) -> AppPaneLayout {
  lay: AppPaneLayout;
  lay.x = win_w;
  if !open { return lay; }
  lay.open = true;
  pw := ifx user_w > 0 then user_w else spec.default_w;
  if pw < spec.min_w { pw = spec.min_w; }
  if pw > spec.max_w { pw = spec.max_w; }
  if win_w - pw < spec.main_min {
    lay.mode = APP_PANE_FULL;
    lay.x = 0.0f32;
    lay.w = win_w;
    return lay;
  }
  lay.mode = APP_PANE_SIDE;
  lay.w = pw;
  lay.x = win_w - pw;
  return lay;
}

// Draws the secondary pane's divider (when docked), header icon, title, optional meta text,
// and close icon button. Returns the y coordinate where the scrollable body starts.
app_pane_shell :: (f: [] UiFrame, x: f32, y: f32, w: f32, h: f32, icon: int, title: string, meta_id: string, meta: string, close_id: string, close_action: int, pad: f32, corner: f32) -> f32 {
  k := f[0].skin; a := k.app; sh := f[0].sheet;
  side := a.icon_button;
  if x > 0 { sheet_fill(sh, x, y, k.border, h, 0, k.menu_divider); }
  hx := x + pad; mid := y + corner + side / 2;
  if icon >= 0 {
    sheet_icon(sh, icon, hx, mid - a.tool_icon / 2, a.tool_icon, k.muted);
    hx += a.tool_icon + a.gap;
  }
  hx += sheet_text(sh, f[0].m, -1, hx, mid - k.tool.line / 2, k.tool.line, k.tool.face, k.ink, title) + a.gap;
  if meta.count > 0 {
    _ := app_meta(f, meta_id, hx, mid - k.small.line / 2, x + w - side - corner - hx, meta, false);
  }
  _ := app_icon_button(f, close_id, x + w - side - corner, y + corner, ICON_CLOSE, "Close", APP_BUTTON_QUIET, 0, close_action);
  return y + corner + side + a.gap_small;
}

// Zeron's panel tab chip (apps/zgx/ui/screens/panel/init.luau, #13744), in points: 28 tall,
// rounded 8, its 20-point tile and end slot 4 in from its ends, 6 between its parts, its label
// at most 160 wide and fading past that; the strip 6 in from the panel's side, in a 40-point band.
APP_PANE_TAB_H :: 28.0f32; APP_PANE_TAB_RADIUS :: 8.0f32; APP_PANE_TAB_SLOT :: 20.0f32; APP_PANE_TAB_GAP :: 6.0f32;
APP_PANE_TAB_LABEL :: 160.0f32; APP_PANE_TAB_ICON :: 14.0f32; APP_PANE_TAB_CLOSE :: 12.0f32; APP_PANE_TAB_TILE_RADIUS :: 4.0f32;
APP_PANE_TAB_EDGE :: 6.0f32; APP_PANE_TAB_FADE :: 24.0f32;

// The width of the chip app_pane_tab draws for `title` at `scale` points a unit.
app_pane_tab_width :: (f: [] UiFrame, title: string, scale: f32) -> f32 {
  u := ifx scale > 0 then scale else 1.0f32; k := f[0].skin;
  tw := measure_width(f[0].m, k.tool.face, title); most := APP_PANE_TAB_LABEL / u;
  if tw > most { tw = most; }
  inset := (APP_PANE_TAB_H - APP_PANE_TAB_SLOT) / 2 / u;
  return 2 * inset + 2 * APP_PANE_TAB_SLOT / u + 2 * APP_PANE_TAB_GAP / u + tw;
}
// A panel's tab as Zeron draws its chosen one, at (x, y), at `scale` points a unit: on the
// selected wash, its icon on a tile, its title (fading past 160 points) and Close in its end
// slot, which dispatches close_action under close_id. Returns its width.
app_pane_tab :: (f: [] UiFrame, x: f32, y: f32, icon: int, title: string, close_id: string, close_action: int, scale: f32) -> f32 {
  tb: [EL_ID] u8;
  return app_pane_chip(f, x, y, icon, title, app_id(tb[..], close_id, ".tab"), true, 0, close_id, close_action, scale);
}
// One tab chip of a panel's strip, as app_pane_tab draws it, under tab_id: the chosen one (on) on
// the selected wash with Close in its end slot; another bare, washed under the pointer, its title
// in the muted ink, and a press on it dispatches tab_action under tab_id. Returns its width.
app_pane_chip :: (f: [] UiFrame, x: f32, y: f32, icon: int, title: string, tab_id: string, on: bool, tab_action: int, close_id: string, close_action: int, scale: f32) -> f32 {
  u := ifx scale > 0 then scale else 1.0f32; k := f[0].skin; sh := f[0].sheet; m := f[0].m;
  h := APP_PANE_TAB_H / u; slot := APP_PANE_TAB_SLOT / u; gap := APP_PANE_TAB_GAP / u; inset := (h - slot) / 2;
  w := app_pane_tab_width(f, title, scale);
  hovered_tab := uiframe_hover_on(f, KEYED_LAZY, tab_id, !on && uiframe_hovered(f, tab_id));   // eased (kit/frame.coax)
  wash := ifx k.set.selected.a > 0 then k.set.selected else k.hover;
  if on { sheet_fill(sh, x, y, w, h, APP_PANE_TAB_RADIUS / u, wash); }
  else if hovered_tab > 0 { sheet_fill(sh, x, y, w, h, APP_PANE_TAB_RADIUS / u, opacity(k.hover, hovered_tab)); }
  // the tile and its icon
  tx := x + inset; ty := y + inset;
  if icon >= 0 {
    sheet_fill(sh, tx, ty, slot, slot, APP_PANE_TAB_TILE_RADIUS / u, ifx k.set.well.a > 0 then k.set.well else k.raised);
    ic := APP_PANE_TAB_ICON / u;
    sheet_icon(sh, icon, tx + (slot - ic) / 2, ty + (slot - ic) / 2, ic, k.ink);
  }
  // the title, its end fading past the label's most
  lx := tx + slot + gap; right := x + w - inset - slot - gap;
  _ := app_act_fade_text(sh, m, lx, y + (h - k.tool.line) / 2, k.tool.line, k.tool.face, ifx on then k.ink else rgba_mix(k.muted, k.ink, hovered_tab), title, right, APP_PANE_TAB_FADE / u);
  tab := uiframe_semantic(f, tab_id, EL_TAB, title, x, y, w, h, ifx on then EL_S_CURRENT else 0, ifx on then 0 else tab_action);
  if !on { sheet_hit(sh, UIFRAME_HIT, tab, 0, x, y, w, h); return w; }
  // Close in the end slot, its wash under the pointer
  cx := x + w - inset - slot;
  hovered := uiframe_hover(f, KEYED_LAZY, close_id);
  if hovered > 0 { sheet_fill(sh, cx, ty, slot, slot, APP_PANE_TAB_TILE_RADIUS / u, opacity(k.hover, hovered)); }
  ci := APP_PANE_TAB_CLOSE / u;
  sheet_icon(sh, ICON_CLOSE, cx + (slot - ci) / 2, ty + (slot - ci) / 2, ci, rgba_mix(k.muted, k.ink, hovered));
  close := uiframe_semantic(f, close_id, EL_BUTTON, "Close", cx, ty, slot, slot, 0, close_action);
  sheet_hit(sh, UIFRAME_HIT, close, 0, cx, ty, slot, slot);
  return w;
}
// A panel's head as Zeron's (#13744): its divider when docked, one tab chip (app_pane_tab) whose
// middle sits `corner` plus half an icon button down from y, level with the window's corner
// buttons, and the meta text after it. Returns the y where the scrolling body starts.
app_pane_tab_shell :: (f: [] UiFrame, x: f32, y: f32, w: f32, h: f32, icon: int, title: string, meta_id: string, meta: string, close_id: string, close_action: int, corner: f32, scale: f32) -> f32 {
  k := f[0].skin; a := k.app; sh := f[0].sheet;
  u := ifx scale > 0 then scale else 1.0f32;
  if x > 0 { sheet_fill(sh, x, y, k.border, h, 0, k.menu_divider); }
  mid := y + corner + a.icon_button / 2; th := APP_PANE_TAB_H / u;
  cx := x + APP_PANE_TAB_EDGE / u;
  cw := app_pane_tab(f, cx, mid - th / 2, icon, title, close_id, close_action, scale);
  if meta.count > 0 {
    mx := cx + cw + a.gap;
    _ := app_meta(f, meta_id, mx, mid - k.small.line / 2, x + w - mx - APP_PANE_TAB_EDGE / u, meta, false);
  }
  return y + corner + a.icon_button + a.gap_small;
}

// A panel's head with tabs as Zeron's strip (#13696: a sub-agent's transcript and the code review
// side by side): its divider when docked, a chip each (app_pane_chip) in a row 6 points in, the
// chosen one with Close, the others pressable under prefix + their number ("pane.tab.1"), and the
// meta text after them. Level with app_pane_tab_shell. Returns the y where the body starts.
app_pane_tabs :: (f: [] UiFrame, x: f32, y: f32, w: f32, h: f32, icons: [] int, tabs: [] string, current: int, prefix: string, tab_action: int, meta_id: string, meta: string, close_id: string, close_action: int, corner: f32, scale: f32) -> f32 {
  k := f[0].skin; a := k.app; sh := f[0].sheet;
  u := ifx scale > 0 then scale else 1.0f32;
  if x > 0 { sheet_fill(sh, x, y, k.border, h, 0, k.menu_divider); }
  mid := y + corner + a.icon_button / 2; th := APP_PANE_TAB_H / u;
  cx := x + APP_PANE_TAB_EDGE / u; end := x + w - APP_PANE_TAB_EDGE / u;
  for t, i: tabs {
    if cx + app_pane_tab_width(f, t, scale) > end { break; }
    ib: [EL_ID] u8; n := el_put_i(ib[..], el_put(ib[..], 0, prefix), i);
    cx += app_pane_chip(f, cx, mid - th / 2, ifx i < icons.count then icons[i] else -1, t, cast(string) ib[0..<n], i == current, tab_action, close_id, close_action, scale) + APP_PANE_TAB_GAP / u;
  }
  if meta.count > 0 && end - cx > a.gap {
    _ := app_meta(f, meta_id, cx + a.gap - APP_PANE_TAB_GAP / u, mid - k.small.line / 2, end - cx, meta, false);
  }
  return y + corner + a.icon_button + a.gap_small;
}

#load "pane-checks.coax" #test;
