ic_name :: (icon: int) -> string { names := IC_NAMES; return ifx icon >= 0 && icon < IC_COUNT then names[icon] else ""; }
// The address of an icon's drawing: "/build/icons/copy.svg#i". Bytes written; 0 for no such icon.
ic_href :: (icon: int, out: [] u8) -> int {
  name := ic_name(icon);
  if name.count == 0 { return 0; }
  n := 0;
  for c: IC_BASE { if n < out.count { out[n] = c; n += 1; } }
  for c: name { if n < out.count { out[n] = c; n += 1; } }
  for c: ".svg#i" { if n < out.count { out[n] = c; n += 1; } }
  return n;
}
// The icon with this name, or -1 (a page that reads an icon's name from data).
ic_find :: (name: string) -> int {
  names := IC_NAMES;
  lo := 0; hi := IC_COUNT - 1;
  while lo <= hi {
    mid := (lo + hi) / 2;
    if names[mid] == name { return mid; }
    if ic_before(names[mid], name) { lo = mid + 1; } else { hi = mid - 1; }
  }
  return -1;
}
ic_before :: (a: string, b: string) -> bool {
  n := ifx a.count < b.count then a.count else b.count;
  for i: 0..<n { if a[i] != b[i] { return a[i] < b[i]; } }
  return a.count < b.count;
}

#test "every icon has a name, the names are in order with none twice, and a name finds its icon" {
  names := IC_NAMES;
  #assert IC_COUNT == 755 && names.count == IC_COUNT;
  for i: 1..<IC_COUNT { #assert ic_before(names[i - 1], names[i]); }
  #assert ic_name(IC_COPY) == "copy" && ic_find("copy") == IC_COPY && ic_find("check") == IC_CHECK && ic_find("no-such-icon") < 0;
  #assert ic_find(names[0]) == 0 && ic_find(names[IC_COUNT - 1]) == IC_COUNT - 1 && ic_name(-1) == "" && ic_name(IC_COUNT) == "";
  buf: [96] u8; n := ic_href(IC_COPY, buf[..]);
  #assert cast(string) buf[0..<n] == "/build/icons/copy.svg#i" && ic_href(-1, buf[..]) == 0;
}
