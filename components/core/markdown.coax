// Markdown, the parser: source text in, a document out (MdDoc: blocks, list
// items, table cells and styled runs over text with the markers taken out).
// No pixels, fonts, colours or platform calls: the first file of the
// component system's core layer (components/spec.md, GitHub #13153). Every
// consumer that shows Markdown parses it here; wrapping is
// components/layout/text.coax and painting is the components' own.
//
// It reads what an assistant's reply uses: paragraphs, headings, bullet and
// numbered lists with nesting and task boxes, fenced code with its language,
// quotes, rules and GFM tables, with **bold**, *italic*, ~~strike~~, `inline
// code`, [links](url) and backslash escapes inside them. A consumer that
// shows a reply a line at a time (a terminal) uses the same line rules
// (md_heading, md_rule, md_quote_at, md_bullet, md_ordinal, md_task,
// md_fence_char, md_delim) and md_inline_text for a line's spans. A block is a
// transcript row, as Zeron splits a text part (crates/ui/src/markdown/render.rs,
// parser.rs). An unfinished reply parses, so a streaming answer can be shown
// as it arrives. Based on Zeron by Wing, MIT.
//   coax/bin/coax test components/core/markdown.coax --library


// Inline styles of a run: what picks its face.
MD_PLAIN :: 0; MD_BOLD :: 1; MD_CODE :: 2;
// Marks a run carries beside its style. MD_STRONG: bold too (a code run inside bold).
MD_ITALIC :: 1; MD_STRIKE :: 2; MD_LINK :: 4; MD_STRONG :: 8;
// A list item's task box.
MD_TASK_NONE :: 0; MD_TASK_OPEN :: 1; MD_TASK_DONE :: 2;
MD_LINKS :: 8192;             // bytes of link targets kept
// Block kinds.
MB_PARA :: 0; MB_LIST :: 1; MB_CODE :: 2; MB_QUOTE :: 3; MB_TABLE :: 4;
// A table's column alignment (parser.rs TableAlign; none reads as left).
MA_LEFT :: 0; MA_CENTER :: 1; MA_RIGHT :: 2;
MD_TABLE_COLS :: 16;          // columns kept; a row's cells past them are dropped
MD_CELL :: 2048;              // a cell's source bytes read
MD_DEPTHS :: 4;               // list nesting drawn: deeper items sit at the last level

MD_TEXT :: 65536;
MD_BLOCKS :: 256;
MD_RUNS :: 2048;
MD_ITEMS :: 256;

// A styled stretch of a block's (or an item's) display text, in bytes.
// A link's run names its target: doc.links[link_at..<link_at+link_n] (md_link).
MdRun :: struct { from: int; to: int; style: int; marks: int; link_at: int; link_n: int; }
// One list item (or one paragraph of a quote, or one table cell): its display
// text (doc.text[at..<at+n]) and runs, its nesting depth and whether it's
// numbered; a cell's number is its column's alignment (MA_*).
MdItem :: struct { at: int; n: int; run0: int; runs: int; number: int; depth: int; ordered: bool; task: int; }
// A block: a paragraph (text and runs), a list (items, numbered or not, each
// at its depth), a quote (its paragraphs as items), a table (its cells as
// items, row by row, the header row first, cols to a row) or fenced code
// (its raw lines as text, the fence's language).
MdBlock :: struct {
  kind: int;
  at: int; n: int; run0: int; runs: int;
  item0: int; items: int; ordered: bool;
  cols: int;
  lang_at: int; lang_n: int;
  part: int;                  // which source text it came from (a row id's part)
}
MdDoc :: struct {
  text: [MD_TEXT] u8; n: int;
  blocks: [MD_BLOCKS] MdBlock; nb: int;
  runs: [MD_RUNS] MdRun; nr: int;
  items: [MD_ITEMS] MdItem; ni: int;
  links: [MD_LINKS] u8; nlink: int;
}

md_str :: (doc: [] MdDoc, at: int, n: int) -> string { return cast(string) doc[0].text[at..<at + n]; }
md_block_text :: (doc: [] MdDoc, b: int) -> string { return md_str(doc, doc[0].blocks[b].at, doc[0].blocks[b].n); }
md_item_text :: (doc: [] MdDoc, k: int) -> string { return md_str(doc, doc[0].items[k].at, doc[0].items[k].n); }
md_lang :: (doc: [] MdDoc, b: int) -> string { return md_str(doc, doc[0].blocks[b].lang_at, doc[0].blocks[b].lang_n); }
md_block_runs :: (doc: [] MdDoc, b: int) -> [] MdRun { r := doc[0].blocks[b].run0; return doc[0].runs[r..<r + doc[0].blocks[b].runs]; }
md_item_runs :: (doc: [] MdDoc, k: int) -> [] MdRun { r := doc[0].items[k].run0; return doc[0].runs[r..<r + doc[0].items[k].runs]; }

md_link :: (doc: [] MdDoc, r: MdRun) -> string { return cast(string) doc[0].links[r.link_at..<r.link_at + r.link_n]; }
// The marks of the run holding byte i (none outside every run).
md_marks_at :: (runs: [] MdRun, i: int) -> int {
  for k: 0..<runs.count { if i >= runs[k].from && i < runs[k].to { return runs[k].marks; } }
  return 0;
}
// The style of the run holding byte i (MD_PLAIN outside every run).
md_style_at :: (runs: [] MdRun, i: int) -> int {
  for k: 0..<runs.count { if i >= runs[k].from && i < runs[k].to { return runs[k].style; } }
  return MD_PLAIN;
}

md_put :: (doc: [] MdDoc, c: u8) {
  if doc[0].n < MD_TEXT { doc[0].text[doc[0].n] = c; doc[0].n += 1; }
}
md_run :: (doc: [] MdDoc, from: int, to: int, style: int) { md_run_marked(doc, from, to, style, 0, 0, 0); }
md_run_marked :: (doc: [] MdDoc, from: int, to: int, style: int, marks: int, link_at: int, link_n: int) {
  if to <= from || doc[0].nr >= MD_RUNS { return; }
  // a run continuing the one before in the same style and marks merges with it (a link never does)
  if doc[0].nr > 0 && (marks & MD_LINK) == 0 {
    last := doc[0].runs[doc[0].nr - 1];
    if last.to == from && last.style == style && last.marks == marks { doc[0].runs[doc[0].nr - 1].to = to; return; }
  }
  doc[0].runs[doc[0].nr] = MdRun.{from = from, to = to, style = style, marks = marks, link_at = link_at, link_n = link_n};
  doc[0].nr += 1;
}

// A byte that is part of a word: a letter, a digit or any non-ASCII byte.
md_word :: (c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c >= 0x80; }

// Where the closing mark for a span opened at s[at] is, or -1: it must come
// later in the text, after something that isn't a space; a closing _ is not
// followed by a word (snake_case_name has none).
md_close :: (s: string, at: int, mark: string) -> int {
  j := at + mark.count + 1;
  while j + mark.count <= s.count {
    if s[j] == '\\' { j += 2; continue; }
    if cast(string) s[j..<j + mark.count] == mark && s[j - 1] != ' ' {
      if mark[0] != '_' || j + mark.count >= s.count || !md_word(s[j + mark.count]) { return j; }
    }
    j += 1;
  }
  return -1;
}

// The run for display text start..<now under the open spans.
md_span :: (doc: [] MdDoc, start: int, base: int, bold: bool, italic: bool, strike: bool) {
  marks := (ifx italic then MD_ITALIC else 0) | (ifx strike then MD_STRIKE else 0);
  md_run_marked(doc, start - base, doc[0].n - base, ifx bold then MD_BOLD else MD_PLAIN, marks, 0, 0);
}

// Appends the inline text src (markers in it) as display text with runs.
// Returns the first run's index; runs are relative to `base` (the text's
// start). The spans: `code` (backtick runs of one length close each other),
// **bold** and __bold__, *italic* and _italic_ (opened at a word's start,
// closed after one), ~~strike~~, [text](target), and a backslash before
// punctuation, which keeps the punctuation. finished: the text is whole (a
// line a terminal shows once it has ended), so a span with no closing mark
// stays as written. Not finished (a reply still arriving): every ** turns
// bold on or off, so bold shows before its closing mark has come.
md_inline_mode :: (doc: [] MdDoc, src: string, base: int, finished: bool) -> int {
  first := doc[0].nr;
  i := 0; start := doc[0].n;
  bold := false; italic := false; strike := false;
  bold_close := -1; italic_close := -1; strike_close := -1;
  while i < src.count {
    c := src[i];
    if bold && i == bold_close { md_span(doc, start, base, bold, italic, strike); bold = false; bold_close = -1; start = doc[0].n; i += 2; continue; }
    if italic && i == italic_close { md_span(doc, start, base, bold, italic, strike); italic = false; italic_close = -1; start = doc[0].n; i += 1; continue; }
    if strike && i == strike_close { md_span(doc, start, base, bold, italic, strike); strike = false; strike_close = -1; start = doc[0].n; i += 2; continue; }
    if c == '\\' && i + 1 < src.count && !md_word(src[i + 1]) && src[i + 1] != ' ' { md_put(doc, src[i + 1]); i += 2; continue; }
    if c == '`' {
      // the fence: a run of backticks, closed by the same run
      k := i; while k < src.count && src[k] == '`' { k += 1; }
      tick := k - i;
      j := k; close := -1;
      while j < src.count {
        if src[j] == '`' {
          m := j; while m < src.count && src[m] == '`' { m += 1; }
          if m - j == tick { close = j; break; }
          j = m;
        } else { j += 1; }
      }
      if close >= 0 {
        md_span(doc, start, base, bold, italic, strike);
        cs := doc[0].n;
        for q: k..<close { md_put(doc, src[q]); }
        cm := (ifx italic then MD_ITALIC else 0) | (ifx strike then MD_STRIKE else 0) | (ifx bold then MD_STRONG else 0);
        md_run_marked(doc, cs - base, doc[0].n - base, MD_CODE, cm, 0, 0);
        start = doc[0].n; i = close + tick;
        continue;
      }
    }
    two := i + 1 < src.count && src[i + 1] == c;
    if c == '*' && two && !finished {
      md_span(doc, start, base, bold, italic, strike);
      bold = !bold; bold_close = -1; start = doc[0].n; i += 2;
      continue;
    }
    if (c == '*' || c == '_') && two && !bold && i + 2 < src.count && src[i + 2] != ' ' {
      e := md_close(src, i, ifx c == '*' then "**" else "__");
      if e > 0 { md_span(doc, start, base, bold, italic, strike); bold = true; bold_close = e; start = doc[0].n; i += 2; continue; }
    }
    if (c == '*' || c == '_') && !italic && i + 1 < src.count && src[i + 1] != ' ' && src[i + 1] != c && (i == 0 || !md_word(src[i - 1])) {
      e := md_close(src, i, ifx c == '*' then "*" else "_");
      if e > 0 { md_span(doc, start, base, bold, italic, strike); italic = true; italic_close = e; start = doc[0].n; i += 1; continue; }
    }
    if c == '~' && two && !strike {
      e := md_close(src, i, "~~");
      if e > 0 { md_span(doc, start, base, bold, italic, strike); strike = true; strike_close = e; start = doc[0].n; i += 2; continue; }
    }
    if c == '[' {
      e := i + 1; while e < src.count && src[e] != ']' { e += 1; }
      if e + 1 < src.count && src[e + 1] == '(' {
        u := e + 2; while u < src.count && src[u] != ')' { u += 1; }
        if u < src.count && e > i + 1 {
          md_span(doc, start, base, bold, italic, strike);
          ls := doc[0].n;
          for q: i + 1..<e { md_put(doc, src[q]); }
          la := doc[0].nlink;
          for q: e + 2..<u { if doc[0].nlink < MD_LINKS { doc[0].links[doc[0].nlink] = src[q]; doc[0].nlink += 1; } }
          lm := MD_LINK | (ifx italic then MD_ITALIC else 0) | (ifx strike then MD_STRIKE else 0);
          md_run_marked(doc, ls - base, doc[0].n - base, ifx bold then MD_BOLD else MD_PLAIN, lm, la, doc[0].nlink - la);
          start = doc[0].n; i = u + 1;
          continue;
        }
      }
    }
    md_put(doc, c); i += 1;
  }
  md_span(doc, start, base, bold, italic, strike);
  return first;
}
// A reply's inline text (it may still be arriving).
md_inline :: (doc: [] MdDoc, src: string, base: int) -> int { return md_inline_mode(doc, src, base, false); }

// One finished line's inline text into an emptied doc: its display text is
// doc.text[0..<doc.n] and its runs doc.runs[0..<doc.nr]. What a consumer
// that shows a line at a time calls.
md_inline_text :: (doc: [] MdDoc, src: string) {
  doc[0].n = 0; doc[0].nr = 0; doc[0].nb = 0; doc[0].ni = 0; doc[0].nlink = 0;
  r := md_inline_mode(doc, src, 0, true);
}

// A list item's marker: "- ", "* ", "+ " or "12. " at line start; its length, 0 if none.
md_bullet :: (line: string) -> int {
  if line.count >= 2 && (line[0] == '-' || line[0] == '*' || line[0] == '+') && line[1] == ' ' { return 2; }
  return 0;
}
md_ordinal :: (line: string) -> int {
  k := 0;
  while k < line.count && line[k] >= '0' && line[k] <= '9' { k += 1; }
  if k > 0 && k + 1 < line.count && (line[k] == '.' || line[k] == ')') && line[k + 1] == ' ' { return k + 2; }
  return 0;
}
md_number :: (line: string) -> int {
  v := 0; k := 0;
  while k < line.count && line[k] >= '0' && line[k] <= '9' { v = v * 10 + cast(int) (line[k] - '0'); k += 1; }
  return v;
}
// A heading's marker ("# " to "###### "): its length, 0 if none.
md_heading :: (line: string) -> int {
  k := 0;
  while k < line.count && k < 6 && line[k] == '#' { k += 1; }
  if k > 0 && k < line.count && line[k] == ' ' { return k + 1; }
  return 0;
}
// A thematic break: three or more of one of - * _ and nothing else.
md_rule :: (line: string) -> bool {
  if line.count < 3 || (line[0] != '-' && line[0] != '*' && line[0] != '_') { return false; }
  n := 0;
  for k: 0..<line.count { if line[k] == line[0] { n += 1; } else if line[k] != ' ' { return false; } }
  return n >= 3;
}
// Leading spaces (a tab counts 4).
md_indent :: (line: string) -> int {
  n := 0; k := 0;
  while k < line.count && (line[k] == ' ' || line[k] == '\t') { n += ifx line[k] == '\t' then 4 else 1; k += 1; }
  return n;
}
md_trim_left :: (line: string) -> string {
  k := 0; while k < line.count && (line[k] == ' ' || line[k] == '\t') { k += 1; }
  return cast(string) line[k..<line.count];
}
// A list marker after any indentation: its length from the trimmed start, 0 if none.
md_marker :: (line: string) -> int {
  t := md_trim_left(line);
  if md_rule(t) { return 0; }
  b := md_bullet(t); if b > 0 { return b; }
  return md_ordinal(t);
}
// A quote line ("> text" or ">text", indented up to 3): what follows the marker, or -1.
md_quote_at :: (line: string) -> int {
  k := 0; while k < line.count && k < 3 && line[k] == ' ' { k += 1; }
  if k >= line.count || line[k] != '>' { return -1; }
  k += 1; if k < line.count && line[k] == ' ' { k += 1; }
  return k;
}
// The character a code fence line opens or closes with (three backticks or three tildes), 0 if it is none.
md_fence_char :: (line: string) -> u8 {
  if line.count >= 3 && (line[0] == '`' || line[0] == '~') && line[1] == line[0] && line[2] == line[0] { return line[0]; }
  return 0;
}
md_fence :: (line: string) -> bool { return md_fence_char(md_trim_left(line)) != 0; }
// A list item's task box at its text's start ("[ ] " or "[x] "): MD_TASK_*; the box is four bytes.
md_task :: (body: string) -> int {
  if body.count < 4 || body[0] != '[' || body[2] != ']' || body[3] != ' ' { return MD_TASK_NONE; }
  if body[1] == 'x' || body[1] == 'X' { return MD_TASK_DONE; }
  return ifx body[1] == ' ' then MD_TASK_OPEN else MD_TASK_NONE;
}
md_blank :: (line: string) -> bool {
  for k: 0..<line.count { if line[k] != ' ' && line[k] != '\t' && line[k] != '\r' { return false; } }
  return true;
}
md_line_end :: (src: string, i: int) -> int {
  j := i; while j < src.count && src[j] != '\n' { j += 1; }
  return j;
}

// ---------------------------------------------------------------- tables
// GFM tables as pulldown-cmark 0.12 reads them (Zeron's parser.rs runs it
// with ENABLE_TABLES; firstpass.rs parse_table, scan_table_head,
// count_header_cols): a header row with a pipe, then a delimiter row
// (`---`, `:--`, `:-:`, `--:` between pipes) with as many columns; body rows
// until a blank line or a line that starts another block (a row without a
// pipe still counts). A table may start a paragraph, and one whose header
// begins with `|` may interrupt one. A row's cells past the header's count
// are dropped, missing ones are empty; `\|` is a pipe inside a cell.

// A row's columns as the header counts them: its unescaped pipes, less a
// leading one, less a trailing one with only blanks after it; 0 without a pipe.
md_table_cols :: (line: string) -> int {
  pipes := 0; last := -1; k := 0;
  while k < line.count {
    if line[k] == '\\' && k + 1 < line.count { k += 2; continue; }
    if line[k] == '|' { pipes += 1; last = k; }
    k += 1;
  }
  if pipes == 0 { return 0; }
  t := md_trim_left(line);
  if t.count > 0 && t[0] == '|' { pipes -= 1; }
  if md_blank(cast(string) line[last + 1..<line.count]) { return pipes; }
  return pipes + 1;
}

// A delimiter row: its column count (each column's alignment into align), 0 if it isn't one.
md_delim :: (line: string, align: [] int) -> int {
  if md_indent(line) > 3 { return 0; }
  t := md_trim_left(line);
  if t.count == 0 { return 0; }
  i := 0; cols := 0; active := -1; start := true; pipe := false; hyphen := false; in_col := false;
  if t[0] == '|' { i = 1; pipe = true; }
  while i < t.count {
    c := t[i];
    if c == '\r' { i += 1; continue; }
    if c == ' ' || c == '\t' {
    } else if c == ':' {
      if start && active < 0 { active = MA_LEFT; }
      else if !start && active == MA_LEFT { active = MA_CENTER; }
      else if !start && active < 0 { active = MA_RIGHT; }
      start = false;
    } else if c == '-' {
      start = false; hyphen = true; in_col = true;
    } else if c == '|' {
      if !in_col { return 0; }
      if cols < align.count { align[cols] = ifx active < 0 then MA_LEFT else active; }
      cols += 1; start = true; pipe = true; active = -1; in_col = false;
    } else { return 0; }
    i += 1;
  }
  if !start {
    if cols < align.count { align[cols] = ifx active < 0 then MA_LEFT else active; }
    cols += 1;
  }
  if !pipe || !hyphen { return 0; }
  return cols;
}

// Whether the line at src[i..<e] heads a table (its delimiter row next):
// its column count, else 0. interrupt: it would end a paragraph, so it must
// begin with a pipe.
md_table_head :: (src: string, i: int, e: int, interrupt: bool) -> int {
  if e >= src.count { return 0; }
  line := cast(string) src[i..<e];
  if md_indent(line) > 3 { return 0; }
  if interrupt { t := md_trim_left(line); if t.count == 0 || t[0] != '|' { return 0; } }
  cols := md_table_cols(line);
  if cols == 0 { return 0; }
  e2 := md_line_end(src, e + 1);
  align: [MD_TABLE_COLS] int;
  if md_delim(cast(string) src[e + 1..<e2], align[..]) != cols { return 0; }
  return cols;
}

// A line that ends a table's body (pulldown's scan_paragraph_interrupt_no_table).
md_ends_table :: (line: string) -> bool {
  return md_blank(line) || md_heading(md_trim_left(line)) > 0 || md_fence(line) || md_quote_at(line) >= 0
    || md_rule(md_trim_left(line)) || md_marker(line) > 0;
}

// One row's cells appended as items (cols of them: extra cells dropped,
// missing ones empty), each inlined with `\|` read as a pipe; strong: the
// header row, set bold (render.rs sets it at weight 700; the atlas's
// boldest Geist is SemiBold, 600, as for **bold**).
md_table_row :: (doc: [] MdDoc, line: string, cols: int, align: [] int, strong: bool) {
  i := 0; c := 0;
  t := md_trim_left(line);
  buf: [MD_CELL] u8;
  while c < cols {
    if i < t.count && t[i] == '|' { i += 1; }
    while i < t.count && (t[i] == ' ' || t[i] == '\t') { i += 1; }
    if i >= t.count || md_blank(cast(string) t[i..<t.count]) { break; }
    // the cell: up to the next unescaped pipe, `\|` unescaped, trailing blanks dropped
    nb := 0;
    while i < t.count && t[i] != '|' {
      if t[i] == '\\' && i + 1 < t.count && t[i + 1] == '|' { if nb < MD_CELL { buf[nb] = '|'; nb += 1; } i += 2; continue; }
      if t[i] == '\\' && i + 1 < t.count { if nb + 1 < MD_CELL { buf[nb] = t[i]; buf[nb + 1] = t[i + 1]; nb += 2; } i += 2; continue; }
      if nb < MD_CELL { buf[nb] = t[i]; nb += 1; }
      i += 1;
    }
    while nb > 0 && (buf[nb - 1] == ' ' || buf[nb - 1] == '\t' || buf[nb - 1] == '\r') { nb -= 1; }
    md_table_cell(doc, cast(string) buf[0..<nb], align[c], strong);
    c += 1;
  }
  while c < cols { md_table_cell(doc, "", align[c], strong); c += 1; }
  // cells past the header's count are dropped
}
md_table_cell :: (doc: [] MdDoc, src: string, align: int, strong: bool) {
  if doc[0].ni >= MD_ITEMS { return; }
  k := doc[0].ni; doc[0].ni += 1;
  at := doc[0].n; r0 := doc[0].nr;
  r := md_inline(doc, src, at);
  if strong { for z: r0..<doc[0].nr { if doc[0].runs[z].style != MD_CODE { doc[0].runs[z].style = MD_BOLD; } } }
  doc[0].items[k] = MdItem.{at = at, n = doc[0].n - at, run0 = r0, runs = doc[0].nr - r0, number = align};
}
// Parses the table whose header is the line at i (cols columns): returns where the source goes on.
md_table :: (doc: [] MdDoc, src: string, i: int, cols: int, part: int) -> int {
  b := md_new_block(doc, MB_TABLE, part);
  e := md_line_end(src, i);
  e2 := md_line_end(src, e + 1);
  if b < 0 { return e2 + 1; }
  align: [MD_TABLE_COLS] int;
  q := md_delim(cast(string) src[e + 1..<e2], align[..]);
  kept := ifx cols > MD_TABLE_COLS then MD_TABLE_COLS else cols;
  doc[0].blocks[b].cols = kept;
  md_table_row(doc, cast(string) src[i..<e], kept, align[..], true);
  j := e2 + 1;
  while j < src.count {
    le := md_line_end(src, j);
    line := cast(string) src[j..<le];
    if md_ends_table(line) { break; }
    if doc[0].ni + kept > MD_ITEMS { j = le + 1; continue; }
    md_table_row(doc, line, kept, align[..], false);
    j = le + 1;
  }
  doc[0].blocks[b].items = doc[0].ni - doc[0].blocks[b].item0;
  return j;
}
md_table_rows :: (doc: [] MdDoc, b: int) -> int {
  c := doc[0].blocks[b].cols;
  return ifx c > 0 then doc[0].blocks[b].items / c else 0;
}

md_new_block :: (doc: [] MdDoc, kind: int, part: int) -> int {
  if doc[0].nb >= MD_BLOCKS { return -1; }
  b := doc[0].nb; doc[0].nb += 1;
  doc[0].blocks[b] = MdBlock.{kind = kind, at = doc[0].n, run0 = doc[0].nr, item0 = doc[0].ni, part = part};
  return b;
}

// Parses Markdown source into blocks appended to doc, tagged with part.
// Returns how many blocks it added.
md_parse :: (doc: [] MdDoc, src: string, part: int) -> int {
  before := doc[0].nb;
  i := 0;
  while i < src.count {
    e := md_line_end(src, i);
    line := cast(string) src[i..<e];
    if md_blank(line) { i = e + 1; continue; }
    fc := md_fence_char(line);
    if fc != 0 {
      // fenced code: the raw lines up to the closing fence (the opening one's character)
      b := md_new_block(doc, MB_CODE, part);
      if b < 0 { return doc[0].nb - before; }
      la := doc[0].n;
      for q: 3..<line.count { if line[q] != ' ' { md_put(doc, line[q]); } }
      doc[0].blocks[b].lang_at = la; doc[0].blocks[b].lang_n = doc[0].n - la;
      doc[0].blocks[b].at = doc[0].n;
      i = e + 1; first := true;
      while i < src.count {
        e2 := md_line_end(src, i);
        l2 := cast(string) src[i..<e2];
        i = e2 + 1;
        if md_fence_char(l2) == fc { break; }
        if !first { md_put(doc, '\n'); }
        for q: 0..<l2.count { md_put(doc, l2[q]); }
        first = false;
      }
      doc[0].blocks[b].n = doc[0].n - doc[0].blocks[b].at;
      continue;
    }
    tc := md_table_head(src, i, e, false);
    if tc > 0 { i = md_table(doc, src, i, tc, part); continue; }
    if md_marker(line) > 0 {
      // a list: items at any indent (deeper indents nest, as CommonMark reads
      // them), an indented line without a marker continuing the item above,
      // and a blank line only when an indented item follows it
      b := md_new_block(doc, MB_LIST, part);
      if b < 0 { return doc[0].nb - before; }
      doc[0].blocks[b].ordered = md_ordinal(md_trim_left(line)) > 0;
      levels: [MD_DEPTHS] int; nl := 0;
      while i < src.count {
        e2 := md_line_end(src, i);
        l2 := cast(string) src[i..<e2];
        if md_blank(l2) {
          j := e2 + 1;
          while j < src.count && md_blank(cast(string) src[j..<md_line_end(src, j)]) { j = md_line_end(src, j) + 1; }
          if j >= src.count { i = j; break; }
          nx := cast(string) src[j..<md_line_end(src, j)];
          if md_marker(nx) > 0 && md_indent(nx) > 0 && nl > 0 { i = j; continue; }
          break;
        }
        ind := md_indent(l2); t2 := md_trim_left(l2); skip := md_marker(l2);
        if skip == 0 {
          // a continuation of the last item, joined with a space; anything else ends the list
          if ind == 0 || doc[0].ni == doc[0].blocks[b].item0 || md_fence(l2) || md_quote_at(l2) >= 0 { break; }
          k := doc[0].ni - 1;
          md_put(doc, ' '); md_run(doc, doc[0].n - 1 - doc[0].items[k].at, doc[0].n - doc[0].items[k].at, MD_PLAIN);
          r := md_inline(doc, t2, doc[0].items[k].at);
          doc[0].items[k].n = doc[0].n - doc[0].items[k].at; doc[0].items[k].runs = doc[0].nr - doc[0].items[k].run0;
          i = e2 + 1; continue;
        }
        if ind == 0 && nl > 0 && (md_ordinal(t2) > 0) != doc[0].blocks[b].ordered { break; }
        if doc[0].ni >= MD_ITEMS { break; }
        while nl > 0 && levels[nl - 1] > ind { nl -= 1; }
        if nl == 0 || levels[nl - 1] < ind { if nl < MD_DEPTHS { levels[nl] = ind; nl += 1; } }
        k := doc[0].ni; doc[0].ni += 1;
        at := doc[0].n;
        ord := md_ordinal(t2) > 0;
        body := cast(string) t2[skip..<t2.count];
        task := ifx ord then MD_TASK_NONE else md_task(body);
        if task != MD_TASK_NONE { body = cast(string) body[4..<body.count]; }
        r := md_inline(doc, body, at);
        doc[0].items[k] = MdItem.{at = at, n = doc[0].n - at, run0 = r, runs = doc[0].nr - r, number = ifx ord then md_number(t2) else 0, depth = nl - 1, ordered = ord, task = task};
        i = e2 + 1;
      }
      doc[0].blocks[b].items = doc[0].ni - doc[0].blocks[b].item0;
      continue;
    }
    if md_quote_at(line) >= 0 {
      // a quote: its lines with the marker taken off; a blank quoted line, a
      // list marker or a heading starts a new paragraph (an item) inside it
      b := md_new_block(doc, MB_QUOTE, part);
      if b < 0 { return doc[0].nb - before; }
      open := -1;
      while i < src.count {
        e2 := md_line_end(src, i);
        l2 := cast(string) src[i..<e2];
        q := md_quote_at(l2);
        if q < 0 { break; }
        body := cast(string) l2[q..<l2.count];
        i = e2 + 1;
        if md_blank(body) { open = -1; continue; }
        hk := md_heading(body); mk := md_marker(body);
        if hk > 0 || mk > 0 || open < 0 {
          if doc[0].ni >= MD_ITEMS { continue; }
          open = doc[0].ni; doc[0].ni += 1;
          at := doc[0].n; r0 := doc[0].nr;
          text := body;
          if hk > 0 { text = cast(string) body[hk..<body.count]; }
          if mk > 0 { tb := md_trim_left(body); md_put(doc, 0xE2); md_put(doc, 0x80); md_put(doc, 0xA2); md_put(doc, ' '); md_run(doc, 0, 4, MD_PLAIN); text = cast(string) tb[mk..<tb.count]; }
          r := md_inline(doc, text, at);
          if hk > 0 { for z: r0..<doc[0].nr { doc[0].runs[z].style = MD_BOLD; } }
          doc[0].items[open] = MdItem.{at = at, n = doc[0].n - at, run0 = r0, runs = doc[0].nr - r0};
          if hk > 0 || mk > 0 { open = -1; }
          continue;
        }
        md_put(doc, ' '); md_run(doc, doc[0].n - 1 - doc[0].items[open].at, doc[0].n - doc[0].items[open].at, MD_PLAIN);
        r := md_inline(doc, body, doc[0].items[open].at);
        doc[0].items[open].n = doc[0].n - doc[0].items[open].at; doc[0].items[open].runs = doc[0].nr - doc[0].items[open].run0;
      }
      doc[0].blocks[b].items = doc[0].ni - doc[0].blocks[b].item0;
      continue;
    }
    // a rule draws nothing here
    if md_rule(line) { i = e + 1; continue; }
    // a heading: its own paragraph, all bold (render.rs sets headings in the strong weight)
    hk := md_heading(line);
    if hk > 0 {
      b := md_new_block(doc, MB_PARA, part);
      if b < 0 { return doc[0].nb - before; }
      at := doc[0].n; r0 := doc[0].nr;
      first_run := md_inline(doc, cast(string) line[hk..<line.count], at);
      for q: r0..<doc[0].nr { doc[0].runs[q].style = MD_BOLD; }
      doc[0].blocks[b].at = at; doc[0].blocks[b].n = doc[0].n - at;
      doc[0].blocks[b].run0 = r0; doc[0].blocks[b].runs = doc[0].nr - r0;
      i = e + 1;
      continue;
    }
    // a paragraph: lines up to a blank line, a list or a fence, soft breaks as spaces
    b := md_new_block(doc, MB_PARA, part);
    if b < 0 { return doc[0].nb - before; }
    at := doc[0].n;
    // gather the source of the paragraph, then inline it once
    from := i; to := e;
    i = e + 1;
    while i < src.count {
      e2 := md_line_end(src, i);
      l2 := cast(string) src[i..<e2];
      if md_blank(l2) || md_marker(l2) > 0 || md_heading(l2) > 0 || md_fence(l2) || md_quote_at(l2) >= 0 || md_table_head(src, i, e2, true) > 0 { break; }
      to = e2; i = e2 + 1;
    }
    r0 := doc[0].nr;
    // inline the whole paragraph with newlines as spaces
    seg := from;
    while seg < to {
      se := md_line_end(src, seg);
      if se > to { se = to; }
      if seg > from { md_put(doc, ' '); md_run(doc, doc[0].n - 1 - at, doc[0].n - at, MD_PLAIN); }
      first_run := md_inline(doc, cast(string) src[seg..<se], at);
      seg = se + 1;
    }
    doc[0].blocks[b].at = at; doc[0].blocks[b].n = doc[0].n - at;
    doc[0].blocks[b].run0 = r0; doc[0].blocks[b].runs = doc[0].nr - r0;
  }
  return doc[0].nb - before;
}

// ---------------------------------------------------------------- checks

#test "a reply parses into paragraph, list and code blocks with bold and code runs" {
  doc: [1] MdDoc;
  src := "Done — the header keeps `text_muted` even on failure:\n\n- the header reads the group's **summary**, never its children\n- a failed chip\n\n```rust\nfn a() {\n    b\n}\n```\n\nMatches `1749890`.";
  #assert md_parse(doc[..], src, 3) == 4;
  #assert doc[0].blocks[0].kind == MB_PARA && md_block_text(doc[..], 0) == "Done — the header keeps text_muted even on failure:";
  r := md_block_runs(doc[..], 0);
  #assert r.count == 3 && r[1].style == MD_CODE && cast(string) md_block_text(doc[..], 0)[r[1].from..<r[1].to] == "text_muted";
  #assert doc[0].blocks[1].kind == MB_LIST && doc[0].blocks[1].items == 2 && !doc[0].blocks[1].ordered;
  ir := md_item_runs(doc[..], doc[0].blocks[1].item0);
  #assert md_item_text(doc[..], doc[0].blocks[1].item0) == "the header reads the group's summary, never its children";
  #assert ir.count == 3 && ir[1].style == MD_BOLD && ir[1].to - ir[1].from == 7;
  #assert doc[0].blocks[2].kind == MB_CODE && md_lang(doc[..], 2) == "rust" && md_block_text(doc[..], 2) == "fn a() {\n    b\n}";
  #assert md_block_text(doc[..], 3) == "Matches 1749890." && doc[0].blocks[3].part == 3;
}

#test "soft breaks join a paragraph; numbered lists keep their numbers; an unclosed tick is text" {
  doc: [1] MdDoc;
  #assert md_parse(doc[..], "one\ntwo `x\n\n3. a\n4. b", 0) == 2;
  #assert md_block_text(doc[..], 0) == "one two `x";
  #assert doc[0].blocks[1].ordered && doc[0].items[doc[0].blocks[1].item0 + 1].number == 4;
}

#test "a heading is its own bold paragraph; a rule draws nothing" {
  doc: [1] MdDoc;
  n := md_parse(doc[..], "## Files here\nsome text\n\n---\n\n- a", 1);
  #assert n == 3 && doc[0].blocks[0].kind == MB_PARA && md_block_text(doc[..], 0) == "Files here";
  #assert doc[0].runs[doc[0].blocks[0].run0].style == MD_BOLD && md_block_text(doc[..], 1) == "some text";
  #assert doc[0].blocks[2].kind == MB_LIST && md_heading("#nope") == 0 && md_rule("- - -") && !md_rule("--x");
}

#test "indented bullets nest under their item instead of joining a paragraph" {
  doc: [1] MdDoc;
  n := md_parse(doc[..], "- **Skills:** packaged instructions:\n  - code review\n  - charts and dashboards\n    - deeper\n- **Integrations**\n\nAfter.", 0);
  #assert n == 2 && doc[0].blocks[0].kind == MB_LIST && doc[0].blocks[0].items == 5;
  #assert md_item_text(doc[..], 1) == "code review" && doc[0].items[1].depth == 1;
  #assert md_item_text(doc[..], 2) == "charts and dashboards" && doc[0].items[2].depth == 1;
  #assert md_item_text(doc[..], 3) == "deeper" && doc[0].items[3].depth == 2;
  #assert md_item_text(doc[..], 4) == "Integrations" && doc[0].items[4].depth == 0;
  #assert md_block_text(doc[..], 1) == "After.";
}

#test "a paragraph line followed by an indented list starts the list; a continuation line joins its item" {
  doc: [1] MdDoc;
  n := md_parse(doc[..], "Skills:\n  - one\n    still one\n  1. numbered", 0);
  #assert n == 2 && doc[0].blocks[0].kind == MB_PARA && doc[0].blocks[1].kind == MB_LIST;
  #assert md_item_text(doc[..], 0) == "one still one" && doc[0].items[0].depth == 0;
  #assert doc[0].items[1].ordered && doc[0].items[1].number == 1;
}

#test "a quote keeps its lines apart from the paragraph after it; headings and bullets in it are their own lines" {
  doc: [1] MdDoc;
  n := md_parse(doc[..], "> # Scratch\n>\n> a quoted\n> paragraph\n> - point\n\nAfter.", 0);
  #assert n == 2 && doc[0].blocks[0].kind == MB_QUOTE && doc[0].blocks[0].items == 3;
  #assert md_item_text(doc[..], 0) == "Scratch" && md_item_text(doc[..], 1) == "a quoted paragraph";
  #assert md_item_text(doc[..], 2) == "• point";
  #assert md_block_text(doc[..], 1) == "After.";
}

#test "a GFM table: header, alignments, body rows with bold, code and an escaped pipe, a short row padded, extra cells dropped" {
  doc: [1] MdDoc;
  src := "| Tool | Purpose | Example |\n|:-----|:-------:|--------:|\n| **read_file** | Read a file | `cat a \\| b` |\n| short |\n| a | b | c | d |\n\nAfter.";
  #assert md_parse(doc[..], src, 0) == 2;
  #assert doc[0].blocks[0].kind == MB_TABLE && doc[0].blocks[0].cols == 3 && md_table_rows(doc[..], 0) == 4;
  i0 := doc[0].blocks[0].item0;
  #assert md_item_text(doc[..], i0) == "Tool" && doc[0].items[i0].number == MA_LEFT && doc[0].items[i0 + 1].number == MA_CENTER && doc[0].items[i0 + 2].number == MA_RIGHT;
  #assert md_item_runs(doc[..], i0)[0].style == MD_BOLD;
  #assert md_item_text(doc[..], i0 + 3) == "read_file" && md_item_runs(doc[..], i0 + 3)[0].style == MD_BOLD;
  #assert md_item_text(doc[..], i0 + 5) == "cat a | b" && md_item_runs(doc[..], i0 + 5)[0].style == MD_CODE;
  #assert md_item_text(doc[..], i0 + 6) == "short" && doc[0].items[i0 + 7].n == 0 && doc[0].items[i0 + 8].n == 0;
  #assert md_item_text(doc[..], i0 + 11) == "c";
  #assert md_block_text(doc[..], 1) == "After.";
}

#test "a table after a paragraph line: a header starting with a pipe interrupts it, one without doesn't" {
  doc: [1] MdDoc;
  #assert md_parse(doc[..], "Here they are:\n| a | b |\n|---|---|\n| 1 | 2 |", 0) == 2;
  #assert doc[0].blocks[0].kind == MB_PARA && md_block_text(doc[..], 0) == "Here they are:" && doc[0].blocks[1].kind == MB_TABLE;
  doc2: [1] MdDoc;
  #assert md_parse(doc2[..], "Here they are:\na | b\n--|--", 0) == 1 && doc2[0].blocks[0].kind == MB_PARA;
  // a table may start a paragraph without outer pipes; rows run until a blank line or another block
  doc3: [1] MdDoc;
  #assert md_parse(doc3[..], "a | b\n--|--\n1 | 2\nplain line\n- item", 0) == 2;
  #assert doc3[0].blocks[0].kind == MB_TABLE && md_table_rows(doc3[..], 0) == 3 && md_item_text(doc3[..], doc3[0].blocks[0].item0 + 4) == "plain line";
  #assert doc3[0].blocks[1].kind == MB_LIST;
  // a delimiter row whose count differs isn't one
  doc4: [1] MdDoc;
  #assert md_parse(doc4[..], "| a | b |\n|---|\n", 0) == 1 && doc4[0].blocks[0].kind == MB_PARA;
  al: [4] int;
  #assert md_delim("|---|:-:|", al[..]) == 2 && al[1] == MA_CENTER && md_delim("| -- || -- |", al[..]) == 0 && md_delim("---", al[..]) == 0;
  #assert md_table_cols("| a | b |") == 2 && md_table_cols("a | b") == 2 && md_table_cols("| a \\| b |") == 1;
}

#test "inline spans: italic at a word's start, strike, escapes, links with their targets; code inside bold stays strong" {
  doc: [1] MdDoc;
  md_inline_text(doc[..], "an *italic* and _this_ but not snake_case_name or 2*3*4");
  #assert md_str(doc[..], 0, doc[0].n) == "an italic and this but not snake_case_name or 2*3*4";
  #assert doc[0].nr == 5 && doc[0].runs[1].marks == MD_ITALIC && doc[0].runs[3].marks == MD_ITALIC && doc[0].runs[4].marks == 0;
  md_inline_text(doc[..], "~~gone~~ \\*star\\* and C:\\Users");
  #assert md_str(doc[..], 0, doc[0].n) == "gone *star* and C:\\Users" && doc[0].runs[0].marks == MD_STRIKE && doc[0].nr == 2;
  md_inline_text(doc[..], "see [the docs](https://x.y/z) and [x](#a), not [this] (that)");
  #assert md_str(doc[..], 0, doc[0].n) == "see the docs and x, not [this] (that)";
  #assert doc[0].runs[1].marks == MD_LINK && md_link(doc[..], doc[0].runs[1]) == "https://x.y/z" && md_link(doc[..], doc[0].runs[3]) == "#a";
  md_inline_text(doc[..], "**bold `code` more** and __also__");
  #assert md_str(doc[..], 0, doc[0].n) == "bold code more and also";
  #assert doc[0].runs[0].style == MD_BOLD && doc[0].runs[1].style == MD_CODE && doc[0].runs[1].marks == MD_STRONG && doc[0].runs[2].style == MD_BOLD && doc[0].runs[4].style == MD_BOLD;
  #assert md_marks_at(doc[0].runs[0..<doc[0].nr], 5) == MD_STRONG && md_marks_at(doc[0].runs[0..<doc[0].nr], 0) == 0;
}
#test "a finished line leaves an unclosed ** as written; a reply still arriving shows it bold already" {
  doc: [1] MdDoc;
  md_inline_text(doc[..], "**unclosed bold");
  #assert md_str(doc[..], 0, doc[0].n) == "**unclosed bold" && doc[0].runs[0].style == MD_PLAIN;
  doc[0].n = 0; doc[0].nr = 0;
  r := md_inline(doc[..], "**unclosed bold", 0);
  #assert md_str(doc[..], 0, doc[0].n) == "unclosed bold" && doc[0].runs[0].style == MD_BOLD;
}
#test "task boxes are their item's, not its text; a tilde fence is a fence and closes with tildes" {
  doc: [1] MdDoc;
  n := md_parse(doc[..], "- [x] done\n- [ ] to do\n- [y] not a box\n\n~~~sh\nls\n```\n~~~\nafter", 0);
  #assert n == 3 && doc[0].items[0].task == MD_TASK_DONE && md_item_text(doc[..], 0) == "done";
  #assert doc[0].items[1].task == MD_TASK_OPEN && md_item_text(doc[..], 1) == "to do" && doc[0].items[2].task == MD_TASK_NONE && md_item_text(doc[..], 2) == "[y] not a box";
  #assert doc[0].blocks[1].kind == MB_CODE && md_lang(doc[..], 1) == "sh" && md_block_text(doc[..], 1) == "ls\n```" && md_block_text(doc[..], 2) == "after";
  #assert md_task("[X] a") == MD_TASK_DONE && md_task("[x]") == MD_TASK_NONE && md_fence_char("~~~") == '~' && md_fence_char("``x") == 0;
}
