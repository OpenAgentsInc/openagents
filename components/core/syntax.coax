// Syntax highlighting, the part with no colours: a line of code in, its
// tokens' roles out (components/spec.md, GitHub #13153, #13992: the core layer).
// A code block, a diff, and the desktop file viewer share the same roles; the skin colours them.
// Based on Zeron by Wing, MIT.
//   coax/bin/coax test components/core/syntax.coax

#load "markdown.coax";      // MdRun: a stretch of bytes and its role

// The roles a token can have (Zeron's theme crate names them: builtins.rs syntax()).
// A skin gives each role its colour.
SYN_COMMENT :: 0; SYN_KEYWORD :: 1; SYN_STRING :: 2; SYN_NUMBER :: 3; SYN_TYPE :: 4; SYN_FUNCTION :: 5;
SYN_PROPERTY :: 6; SYN_VARIABLE :: 7; SYN_PUNCTUATION :: 8; SYN_TAG :: 9; SYN_ATTRIBUTE :: 10; SYN_INVALID :: 11;
SYN_PLAIN :: -1;

// Language identifiers for multi-language highlighting (#13992).
SYN_LANG_PLAIN :: 0;
SYN_LANG_RUST :: 1;
SYN_LANG_C :: 2;        // C, C++, Objective-C, Metal
SYN_LANG_COAX :: 3;     // Coax (.coax)
SYN_LANG_SWIFT :: 4;    // Swift (.swift)
SYN_LANG_PYTHON :: 5;   // Python (.py)
SYN_LANG_JS :: 6;       // JavaScript / TypeScript (.js, .jsx, .ts, .tsx, .mjs, .cjs)
SYN_LANG_JSON :: 7;     // JSON / JSONC (.json, .jsonc)
SYN_LANG_MD :: 8;       // Markdown (.md, .markdown)
SYN_LANG_SH :: 9;       // Shell (.sh, .bash, .zsh, Makefile, Dockerfile)
SYN_LANG_LEAN :: 10;    // Lean 4 (.lean)

syn_ident_start :: (c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'; }
syn_ident :: (c: u8) -> bool { return syn_ident_start(c) || (c >= '0' && c <= '9'); }
syn_lower :: (c: u8) -> u8 { return ifx c >= 'A' && c <= 'Z' then c + 32 else c; }
syn_is :: (s: string, w: string) -> bool {
  if s.count != w.count { return false; }
  for k: 0..<s.count { if s[k] != w[k] { return false; } }
  return true;
}
syn_ends_ci :: (s: string, suffix: string) -> bool {
  if suffix.count > s.count { return false; }
  off := s.count - suffix.count;
  for k: 0..<suffix.count { if syn_lower(s[off + k]) != syn_lower(suffix[k]) { return false; } }
  return true;
}
syn_in_list :: (w: string, list: [] const string) -> bool {
  for item: list { if syn_is(w, item) { return true; } }
  return false;
}

// Infers SYN_LANG_* from a file path or basename.
syn_lang_for_path :: (path: string) -> int {
  if path.count == 0 { return SYN_LANG_PLAIN; }
  if syn_ends_ci(path, ".txt") || syn_ends_ci(path, ".log") { return SYN_LANG_PLAIN; }
  if syn_ends_ci(path, ".rs") { return SYN_LANG_RUST; }
  if syn_ends_ci(path, ".coax") { return SYN_LANG_COAX; }
  if syn_ends_ci(path, ".c") || syn_ends_ci(path, ".h") || syn_ends_ci(path, ".cc") ||
     syn_ends_ci(path, ".cpp") || syn_ends_ci(path, ".cxx") || syn_ends_ci(path, ".hpp") ||
     syn_ends_ci(path, ".hh") || syn_ends_ci(path, ".m") || syn_ends_ci(path, ".mm") ||
     syn_ends_ci(path, ".metal") || syn_ends_ci(path, ".cu") || syn_ends_ci(path, ".cuh") {
    return SYN_LANG_C;
  }
  if syn_ends_ci(path, ".swift") { return SYN_LANG_SWIFT; }
  if syn_ends_ci(path, ".py") || syn_ends_ci(path, ".pyi") { return SYN_LANG_PYTHON; }
  if syn_ends_ci(path, ".js") || syn_ends_ci(path, ".jsx") || syn_ends_ci(path, ".mjs") ||
     syn_ends_ci(path, ".cjs") || syn_ends_ci(path, ".ts") || syn_ends_ci(path, ".tsx") {
    return SYN_LANG_JS;
  }
  if syn_ends_ci(path, ".json") || syn_ends_ci(path, ".jsonc") { return SYN_LANG_JSON; }
  if syn_ends_ci(path, ".md") || syn_ends_ci(path, ".markdown") { return SYN_LANG_MD; }
  if syn_ends_ci(path, ".sh") || syn_ends_ci(path, ".bash") || syn_ends_ci(path, ".zsh") ||
     syn_ends_ci(path, "Makefile") || syn_ends_ci(path, "Dockerfile") ||
     syn_ends_ci(path, ".toml") || syn_ends_ci(path, ".yaml") || syn_ends_ci(path, ".yml") {
    return SYN_LANG_SH;
  }
  if syn_ends_ci(path, ".lean") { return SYN_LANG_LEAN; }
  return SYN_LANG_PLAIN;
}

RUST_KEYWORDS :: [36] string.["fn", "let", "mut", "if", "else", "match", "return", "pub", "use", "impl", "struct", "enum",
  "for", "while", "loop", "in", "as", "const", "static", "mod", "crate", "self", "super", "where", "move", "ref",
  "trait", "type", "unsafe", "async", "await", "dyn", "break", "continue", "extern", "Self"];
syn_keyword :: (w: string) -> bool {
  ks := RUST_KEYWORDS;
  return syn_in_list(w, ks[..]);
}

C_KEYWORDS :: [54] string.["auto", "break", "case", "const", "continue", "default", "do", "else", "enum", "extern",
  "for", "goto", "if", "inline", "register", "restrict", "return", "sizeof", "static", "struct", "switch", "typedef",
  "union", "volatile", "while", "class", "namespace", "template", "typename", "public", "private", "protected",
  "virtual", "override", "final", "nullptr", "new", "delete", "using", "constexpr", "noexcept", "explicit",
  "operator", "this", "try", "catch", "throw", "kernel", "device", "constant", "thread", "threadgroup", "alignas", "static_assert"];

C_TYPES :: [26] string.["void", "char", "short", "int", "long", "float", "double", "bool", "signed", "unsigned",
  "size_t", "ssize_t", "ptrdiff_t", "intptr_t", "uintptr_t", "uint8_t", "uint16_t", "uint32_t", "uint64_t",
  "int8_t", "int16_t", "int32_t", "int64_t", "FILE", "half", "bfloat"];

COAX_KEYWORDS :: [17] string.["if", "ifx", "then", "else", "for", "while", "return", "break", "continue", "struct",
  "enum", "cast", "const", "defer", "in", "as", "null"];

COAX_TYPES :: [14] string.["u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64", "f32", "f64", "int", "bool", "string", "void"];

SWIFT_KEYWORDS :: [48] string.["func", "let", "var", "if", "else", "guard", "return", "struct", "class", "enum",
  "protocol", "extension", "import", "private", "public", "internal", "fileprivate", "open", "static", "final",
  "override", "weak", "unowned", "init", "deinit", "self", "Self", "switch", "case", "default", "for", "in",
  "while", "repeat", "do", "try", "catch", "throw", "throws", "rethrows", "async", "await", "defer", "where",
  "as", "is", "typealias", "associatedtype"];

PY_KEYWORDS :: [32] string.["def", "class", "import", "from", "as", "if", "elif", "else", "for", "while", "in",
  "not", "and", "or", "is", "return", "yield", "with", "try", "except", "finally", "raise", "pass", "break",
  "continue", "lambda", "async", "await", "global", "nonlocal", "del", "assert"];

JS_KEYWORDS :: [44] string.["function", "const", "let", "var", "if", "else", "for", "while", "do", "return", "import",
  "export", "from", "default", "class", "extends", "implements", "interface", "type", "enum", "async", "await",
  "try", "catch", "finally", "throw", "new", "this", "super", "typeof", "instanceof", "keyof", "readonly", "as",
  "switch", "case", "break", "continue", "in", "of", "void", "delete", "private", "public"];

SH_KEYWORDS :: [20] string.["if", "then", "else", "elif", "fi", "for", "in", "do", "done", "while", "until",
  "case", "esac", "function", "local", "export", "return", "exit", "set", "unset"];

LEAN_KEYWORDS :: [34] string.["theorem", "lemma", "def", "noncomputable", "private", "protected", "structure",
  "inductive", "class", "instance", "where", "by", "have", "let", "in", "if", "then", "else", "match", "with",
  "fun", "forall", "exists", "import", "open", "namespace", "end", "section", "variable", "universe", "axiom",
  "example", "abbrev", "deriving"];

LEAN_TYPES :: [8] string.["Prop", "Type", "Sort", "Nat", "Int", "Real", "Complex", "Bool"];

syn_is_c_type :: (w: string) -> bool {
  ts := C_TYPES;
  if syn_in_list(w, ts[..]) { return true; }
  // POSIX / stdint / codebase *_t types (e.g. off_t, ggml_type_t)
  if w.count >= 3 && w[w.count - 2] == '_' && w[w.count - 1] == 't' { return true; }
  return false;
}

syn_is_all_caps :: (w: string) -> bool {
  if w.count < 2 { return false; }
  has_letter := false;
  for k: 0..<w.count {
    c := w[k];
    if c >= 'a' && c <= 'z' { return false; }
    if c >= 'A' && c <= 'Z' { has_letter = true; }
  }
  return has_letter;
}

syn_emit :: (out: [] MdRun, n: int, from: int, to: int, style: int) -> int {
  if n >= out.count || to <= from { return n; }
  out[n] = MdRun.{from = from, to = to, style = style};
  return n + 1;
}

// Highlights one line of Rust into runs (style = a SYN_ role), the roles
// tree-sitter-rust's highlights give Zeron for what the transcript shows:
// keywords and operators, functions (defined or called), types, fields
// after a dot, parameters and locals as variables, brackets and delimiters
// as punctuation, comments, strings and numbers. Returns the run count.
syn_rust :: (line: string, out: [] MdRun) -> int {
  n := 0; i := 0; prev_fn := false; after_dot := false;
  while i < line.count && n < out.count {
    c := line[i];
    j := i + 1; role := SYN_PLAIN;
    if c == ' ' || c == '\t' {
      while j < line.count && (line[j] == ' ' || line[j] == '\t') { j += 1; }
      i = j; continue;
    } else if c == '/' && i + 1 < line.count && line[i + 1] == '/' {
      j = line.count; role = SYN_COMMENT;
    } else if c == '"' {
      while j < line.count && line[j] != '"' { if line[j] == '\\' { j += 1; } j += 1; }
      if j < line.count { j += 1; }
      if j > line.count { j = line.count; }
      role = SYN_STRING;
    } else if c >= '0' && c <= '9' {
      while j < line.count && (syn_ident(line[j]) || line[j] == '.') { j += 1; }
      role = SYN_NUMBER;
    } else if syn_ident_start(c) {
      while j < line.count && syn_ident(line[j]) { j += 1; }
      w := cast(string) line[i..<j];
      k := j; while k < line.count && line[k] == ' ' { k += 1; }
      called := k < line.count && line[k] == '(';
      if syn_keyword(w) && !after_dot { role = ifx syn_is(w, "Self") then SYN_TYPE else SYN_KEYWORD; }
      else if syn_is(w, "true") || syn_is(w, "false") { role = SYN_NUMBER; }
      else if prev_fn || called { role = SYN_FUNCTION; }
      else if after_dot { role = SYN_PROPERTY; }
      else if c >= 'A' && c <= 'Z' { role = SYN_TYPE; }
      else { role = SYN_VARIABLE; }
      prev_fn = syn_is(w, "fn");
      after_dot = false;
      out[n] = MdRun.{from = i, to = j, style = role}; n += 1;
      i = j; continue;
    } else if c == '-' && i + 1 < line.count && line[i + 1] == '>' {
      j = i + 2; role = SYN_PLAIN;
    } else if c == '(' || c == ')' || c == '{' || c == '}' || c == '[' || c == ']' || c == ',' || c == ';' || c == ':' || c == '.' {
      role = SYN_PUNCTUATION;
      if c == ':' && j < line.count && line[j] == ':' { j += 1; }
    } else if c == '&' || c == '=' || c == '+' || c == '-' || c == '*' || c == '!' || c == '<' || c == '>' || c == '|' || c == '%' || c == '^' || c == '?' {
      role = SYN_KEYWORD;
    }
    after_dot = c == '.';
    if c != ' ' { prev_fn = false; }
    out[n] = MdRun.{from = i, to = j, style = role}; n += 1;
    i = j;
  }
  return n;
}

// Tokenizes one line of JSON / JSONC.
syn_json_line :: (line: string, in_block: [] bool, out: [] MdRun) -> int {
  n := 0; i := 0;
  if in_block.count > 0 && in_block[0] {
    j := 0;
    while j + 1 < line.count && !(line[j] == '*' && line[j + 1] == '/') { j += 1; }
    if j + 1 < line.count { j += 2; in_block[0] = false; } else { j = line.count; }
    n = syn_emit(out, n, 0, j, SYN_COMMENT);
    i = j;
  }
  while i < line.count && n < out.count {
    c := line[i];
    if c == ' ' || c == '\t' { i += 1; continue; }
    if c == '/' && i + 1 < line.count && line[i + 1] == '/' {
      return syn_emit(out, n, i, line.count, SYN_COMMENT);
    }
    if c == '/' && i + 1 < line.count && line[i + 1] == '*' {
      j := i + 2;
      while j + 1 < line.count && !(line[j] == '*' && line[j + 1] == '/') { j += 1; }
      if j + 1 < line.count { j += 2; } else { j = line.count; if in_block.count > 0 { in_block[0] = true; } }
      n = syn_emit(out, n, i, j, SYN_COMMENT);
      i = j; continue;
    }
    if c == '"' {
      j := i + 1;
      while j < line.count && line[j] != '"' { if line[j] == '\\' { j += 1; } j += 1; }
      if j < line.count { j += 1; }
      if j > line.count { j = line.count; }
      k := j; while k < line.count && (line[k] == ' ' || line[k] == '\t') { k += 1; }
      role := ifx k < line.count && line[k] == ':' then SYN_PROPERTY else SYN_STRING;
      n = syn_emit(out, n, i, j, role);
      i = j; continue;
    }
    if (c >= '0' && c <= '9') || (c == '-' && i + 1 < line.count && line[i + 1] >= '0' && line[i + 1] <= '9') {
      j := i + 1;
      while j < line.count && (syn_ident(line[j]) || line[j] == '.' || line[j] == '+' || line[j] == '-') { j += 1; }
      n = syn_emit(out, n, i, j, SYN_NUMBER);
      i = j; continue;
    }
    if syn_ident_start(c) {
      j := i + 1;
      while j < line.count && syn_ident(line[j]) { j += 1; }
      w := cast(string) line[i..<j];
      role := ifx syn_is(w, "true") || syn_is(w, "false") || syn_is(w, "null") then SYN_NUMBER else SYN_PLAIN;
      n = syn_emit(out, n, i, j, role);
      i = j; continue;
    }
    n = syn_emit(out, n, i, i + 1, SYN_PUNCTUATION);
    i += 1;
  }
  return n;
}

// Tokenizes one line of Markdown source.
syn_md_line :: (line: string, out: [] MdRun) -> int {
  n := 0; i := 0;
  while i < line.count && (line[i] == ' ' || line[i] == '\t') { i += 1; }
  if i >= line.count { return 0; }
  if line[i] == '#' { return syn_emit(out, n, i, line.count, SYN_TAG); }
  if i + 2 < line.count && ((line[i] == '`' && line[i + 1] == '`' && line[i + 2] == '`') ||
                            (line[i] == '~' && line[i + 1] == '~' && line[i + 2] == '~')) {
    return syn_emit(out, n, i, line.count, SYN_ATTRIBUTE);
  }
  if line[i] == '>' { return syn_emit(out, n, i, line.count, SYN_COMMENT); }
  if (line[i] == '-' || line[i] == '*' || line[i] == '+') && i + 1 < line.count && line[i + 1] == ' ' {
    n = syn_emit(out, n, i, i + 1, SYN_KEYWORD);
    i += 1;
  }
  while i < line.count && n < out.count {
    c := line[i];
    if c == '`' {
      j := i + 1;
      while j < line.count && line[j] != '`' { j += 1; }
      if j < line.count { j += 1; }
      n = syn_emit(out, n, i, j, SYN_STRING);
      i = j; continue;
    }
    if c == '[' {
      j := i + 1;
      while j < line.count && line[j] != ']' { j += 1; }
      if j < line.count {
        n = syn_emit(out, n, i, j + 1, SYN_FUNCTION);
        i = j + 1;
        if i < line.count && line[i] == '(' {
          k := i + 1;
          while k < line.count && line[k] != ')' { k += 1; }
          if k < line.count { k += 1; }
          n = syn_emit(out, n, i, k, SYN_PROPERTY);
          i = k;
        }
        continue;
      }
    }
    if c == '*' && i + 1 < line.count && line[i + 1] == '*' {
      j := i + 2;
      while j + 1 < line.count && !(line[j] == '*' && line[j + 1] == '*') { j += 1; }
      if j + 1 < line.count {
        n = syn_emit(out, n, i, j + 2, SYN_TYPE);
        i = j + 2; continue;
      }
    }
    i += 1;
  }
  return n;
}

// Multi-language line tokenizer supporting multi-line block comments (in_block[0]).
// Returns the number of SYN_* runs written to `out`.
syn_tokenize_line :: (lang: int, line: string, in_block: [] bool, out: [] MdRun) -> int {
  if lang == SYN_LANG_PLAIN || line.count == 0 { return 0; }
  if lang == SYN_LANG_JSON { return syn_json_line(line, in_block, out); }
  if lang == SYN_LANG_MD { return syn_md_line(line, out); }

  n := 0; i := 0;
  has_c_block := (lang == SYN_LANG_C || lang == SYN_LANG_COAX || lang == SYN_LANG_RUST || lang == SYN_LANG_SWIFT || lang == SYN_LANG_JS);
  has_lean_block := (lang == SYN_LANG_LEAN);
  has_slash_comment := has_c_block;
  has_hash_comment := (lang == SYN_LANG_PYTHON || lang == SYN_LANG_SH);

  // Continue an open multi-line block comment from a previous line.
  if in_block.count > 0 && in_block[0] {
    j := 0;
    if has_lean_block {
      while j + 1 < line.count && !(line[j] == '-' && line[j + 1] == '/') { j += 1; }
      if j + 1 < line.count { j += 2; in_block[0] = false; } else { j = line.count; }
    } else {
      while j + 1 < line.count && !(line[j] == '*' && line[j + 1] == '/') { j += 1; }
      if j + 1 < line.count { j += 2; in_block[0] = false; } else { j = line.count; }
    }
    n = syn_emit(out, n, 0, j, SYN_COMMENT);
    i = j;
  }

  prev_def := false;
  after_dot := false;
  first_nonspace := true;
  in_include := false;

  while i < line.count && n < out.count {
    c := line[i];
    if c == ' ' || c == '\t' {
      while i < line.count && (line[i] == ' ' || line[i] == '\t') { i += 1; }
      continue;
    }

    // C/C++ preprocessor directive at start of line (#include, #define, #ifdef, #pragma...)
    if lang == SYN_LANG_C && first_nonspace && c == '#' {
      j := i + 1;
      while j < line.count && (line[j] == ' ' || line[j] == '\t') { j += 1; }
      ds := j;
      while j < line.count && syn_ident(line[j]) { j += 1; }
      dir := cast(string) line[ds..<j];
      n = syn_emit(out, n, i, j, SYN_ATTRIBUTE);
      in_include = syn_is(dir, "include") || syn_is(dir, "import");
      first_nonspace = false;
      i = j; continue;
    }
    first_nonspace = false;

    // #include <header.h>
    if in_include && c == '<' {
      j := i + 1;
      while j < line.count && line[j] != '>' { j += 1; }
      if j < line.count { j += 1; }
      n = syn_emit(out, n, i, j, SYN_STRING);
      in_include = false;
      i = j; continue;
    }

    // Coax directives (#load, #test, #authority, #export_c, #effects, #assert...)
    if lang == SYN_LANG_COAX && c == '#' && i + 1 < line.count && syn_ident_start(line[i + 1]) {
      j := i + 1;
      while j < line.count && syn_ident(line[j]) { j += 1; }
      n = syn_emit(out, n, i, j, SYN_ATTRIBUTE);
      i = j; continue;
    }

    // Rust attribute #[...] or #![...]
    if lang == SYN_LANG_RUST && c == '#' && i + 1 < line.count && (line[i + 1] == '[' || (line[i + 1] == '!' && i + 2 < line.count && line[i + 2] == '[')) {
      j := i + 1;
      while j < line.count && line[j] != ']' { j += 1; }
      if j < line.count { j += 1; }
      n = syn_emit(out, n, i, j, SYN_ATTRIBUTE);
      i = j; continue;
    }

    // Swift / Python / TS / ObjC @attributes & decorators
    if (lang == SYN_LANG_SWIFT || lang == SYN_LANG_PYTHON || lang == SYN_LANG_JS || lang == SYN_LANG_C) &&
       c == '@' && i + 1 < line.count && syn_ident_start(line[i + 1]) {
      j := i + 1;
      while j < line.count && syn_ident(line[j]) { j += 1; }
      n = syn_emit(out, n, i, j, SYN_ATTRIBUTE);
      i = j; continue;
    }

    // Shell variable $VAR / ${VAR}
    if lang == SYN_LANG_SH && c == '$' && i + 1 < line.count {
      j := i + 1;
      if line[j] == '{' {
        while j < line.count && line[j] != '}' { j += 1; }
        if j < line.count { j += 1; }
      } else {
        while j < line.count && syn_ident(line[j]) { j += 1; }
      }
      n = syn_emit(out, n, i, j, SYN_PROPERTY);
      i = j; continue;
    }

    // Line comments
    if has_slash_comment && c == '/' && i + 1 < line.count && line[i + 1] == '/' {
      return syn_emit(out, n, i, line.count, SYN_COMMENT);
    }
    if has_hash_comment && c == '#' {
      return syn_emit(out, n, i, line.count, SYN_COMMENT);
    }
    if lang == SYN_LANG_LEAN && c == '-' && i + 1 < line.count && line[i + 1] == '-' {
      return syn_emit(out, n, i, line.count, SYN_COMMENT);
    }

    // Block comments /* ... */ or /- ... -/
    if has_c_block && c == '/' && i + 1 < line.count && line[i + 1] == '*' {
      j := i + 2;
      while j + 1 < line.count && !(line[j] == '*' && line[j + 1] == '/') { j += 1; }
      if j + 1 < line.count { j += 2; } else { j = line.count; if in_block.count > 0 { in_block[0] = true; } }
      n = syn_emit(out, n, i, j, SYN_COMMENT);
      i = j; continue;
    }
    if has_lean_block && c == '/' && i + 1 < line.count && line[i + 1] == '-' {
      j := i + 2;
      while j + 1 < line.count && !(line[j] == '-' && line[j + 1] == '/') { j += 1; }
      if j + 1 < line.count { j += 2; } else { j = line.count; if in_block.count > 0 { in_block[0] = true; } }
      n = syn_emit(out, n, i, j, SYN_COMMENT);
      i = j; continue;
    }

    // Strings and char literals ("...", '...', JS `...`)
    if c == '"' || (c == '\'' && lang != SYN_LANG_RUST && lang != SYN_LANG_LEAN) || (c == '`' && lang == SYN_LANG_JS) {
      q := c; j := i + 1;
      while j < line.count && line[j] != q {
        if line[j] == '\\' { j += 1; }
        j += 1;
      }
      if j < line.count { j += 1; }
      if j > line.count { j = line.count; }
      n = syn_emit(out, n, i, j, SYN_STRING);
      in_include = false;
      after_dot = false; prev_def = false;
      i = j; continue;
    }
    // Rust char literal 'a' or '\n' (distinct from lifetime 'a)
    if lang == SYN_LANG_RUST && c == '\'' {
      if i + 2 < line.count && line[i + 1] != '\\' && line[i + 2] == '\'' {
        n = syn_emit(out, n, i, i + 3, SYN_STRING); i += 3; continue;
      }
      if i + 3 < line.count && line[i + 1] == '\\' && line[i + 3] == '\'' {
        n = syn_emit(out, n, i, i + 4, SYN_STRING); i += 4; continue;
      }
      j := i + 1;
      while j < line.count && syn_ident(line[j]) { j += 1; }
      n = syn_emit(out, n, i, j, SYN_ATTRIBUTE); i = j; continue;
    }

    // Numeric literals (decimal, hex 0x..., bin 0b..., float, suffixes like ull/f32/u64)
    if c >= '0' && c <= '9' {
      j := i + 1;
      while j < line.count && (syn_ident(line[j]) || line[j] == '.') { j += 1; }
      n = syn_emit(out, n, i, j, SYN_NUMBER);
      after_dot = false; prev_def = false;
      i = j; continue;
    }

    // Identifiers, keywords, types, functions, properties, variables
    if syn_ident_start(c) {
      j := i + 1;
      while j < line.count && syn_ident(line[j]) { j += 1; }
      w := cast(string) line[i..<j];
      k := j; while k < line.count && line[k] == ' ' { k += 1; }
      called := k < line.count && line[k] == '(';
      coax_def := lang == SYN_LANG_COAX && k + 1 < line.count && line[k] == ':' && line[k + 1] == ':';
      role := SYN_VARIABLE;

      if lang == SYN_LANG_C {
        cks := C_KEYWORDS;
        if syn_in_list(w, cks[..]) && !after_dot { role = SYN_KEYWORD; }
        else if syn_is(w, "true") || syn_is(w, "false") || syn_is(w, "NULL") { role = SYN_NUMBER; }
        else if syn_is_c_type(w) && !after_dot { role = SYN_TYPE; }
        else if called { role = SYN_FUNCTION; }
        else if after_dot { role = SYN_PROPERTY; }
        else if syn_is_all_caps(w) { role = SYN_NUMBER; }
        else if c >= 'A' && c <= 'Z' { role = SYN_TYPE; }
        else { role = SYN_VARIABLE; }
      } else if lang == SYN_LANG_COAX {
        cxk := COAX_KEYWORDS; cxt := COAX_TYPES;
        if syn_in_list(w, cxk[..]) && !after_dot { role = SYN_KEYWORD; }
        else if syn_is(w, "true") || syn_is(w, "false") { role = SYN_NUMBER; }
        else if syn_in_list(w, cxt[..]) && !after_dot { role = SYN_TYPE; }
        else if coax_def {
          // Top-level Foo :: struct -> SYN_TYPE; CONST :: 1 -> SYN_NUMBER; fn :: () -> SYN_FUNCTION
          m := k + 2; while m < line.count && line[m] == ' ' { m += 1; }
          if syn_is_all_caps(w) { role = SYN_NUMBER; }
          else if m < line.count && line[m] == '(' { role = SYN_FUNCTION; }
          else if c >= 'A' && c <= 'Z' { role = SYN_TYPE; }
          else { role = SYN_FUNCTION; }
        }
        else if called { role = SYN_FUNCTION; }
        else if after_dot { role = SYN_PROPERTY; }
        else if syn_is_all_caps(w) { role = SYN_NUMBER; }
        else if c >= 'A' && c <= 'Z' { role = SYN_TYPE; }
        else { role = SYN_VARIABLE; }
      } else if lang == SYN_LANG_RUST {
        if syn_keyword(w) && !after_dot { role = ifx syn_is(w, "Self") then SYN_TYPE else SYN_KEYWORD; }
        else if syn_is(w, "true") || syn_is(w, "false") { role = SYN_NUMBER; }
        else if prev_def || called { role = SYN_FUNCTION; }
        else if after_dot { role = SYN_PROPERTY; }
        else if c >= 'A' && c <= 'Z' { role = SYN_TYPE; }
        else { role = SYN_VARIABLE; }
      } else if lang == SYN_LANG_SWIFT {
        swk := SWIFT_KEYWORDS;
        if syn_in_list(w, swk[..]) && !after_dot { role = ifx syn_is(w, "Self") then SYN_TYPE else SYN_KEYWORD; }
        else if syn_is(w, "true") || syn_is(w, "false") || syn_is(w, "nil") { role = SYN_NUMBER; }
        else if prev_def || called { role = SYN_FUNCTION; }
        else if after_dot { role = SYN_PROPERTY; }
        else if c >= 'A' && c <= 'Z' { role = SYN_TYPE; }
        else { role = SYN_VARIABLE; }
      } else if lang == SYN_LANG_PYTHON {
        pyk := PY_KEYWORDS;
        if syn_in_list(w, pyk[..]) && !after_dot { role = SYN_KEYWORD; }
        else if syn_is(w, "True") || syn_is(w, "False") || syn_is(w, "None") { role = SYN_NUMBER; }
        else if prev_def || called { role = SYN_FUNCTION; }
        else if after_dot { role = SYN_PROPERTY; }
        else if c >= 'A' && c <= 'Z' { role = SYN_TYPE; }
        else { role = SYN_VARIABLE; }
      } else if lang == SYN_LANG_JS {
        jsk := JS_KEYWORDS;
        if syn_in_list(w, jsk[..]) && !after_dot { role = SYN_KEYWORD; }
        else if syn_is(w, "true") || syn_is(w, "false") || syn_is(w, "null") || syn_is(w, "undefined") { role = SYN_NUMBER; }
        else if prev_def || called { role = SYN_FUNCTION; }
        else if after_dot { role = SYN_PROPERTY; }
        else if c >= 'A' && c <= 'Z' { role = SYN_TYPE; }
        else { role = SYN_VARIABLE; }
      } else if lang == SYN_LANG_SH {
        shk := SH_KEYWORDS;
        if syn_in_list(w, shk[..]) { role = SYN_KEYWORD; }
        else if syn_is(w, "true") || syn_is(w, "false") { role = SYN_NUMBER; }
        else if called { role = SYN_FUNCTION; }
        else { role = SYN_VARIABLE; }
      } else if lang == SYN_LANG_LEAN {
        lnk := LEAN_KEYWORDS; lnt := LEAN_TYPES;
        if syn_in_list(w, lnk[..]) && !after_dot { role = SYN_KEYWORD; }
        else if syn_is(w, "sorry") { role = SYN_INVALID; }
        else if syn_is(w, "true") || syn_is(w, "false") { role = SYN_NUMBER; }
        else if syn_in_list(w, lnt[..]) { role = SYN_TYPE; }
        else if prev_def { role = SYN_FUNCTION; }
        else if after_dot { role = SYN_PROPERTY; }
        else if c >= 'A' && c <= 'Z' { role = SYN_TYPE; }
        else { role = SYN_VARIABLE; }
      }

      prev_def = syn_is(w, "fn") || syn_is(w, "func") || syn_is(w, "def") || syn_is(w, "function") ||
                 syn_is(w, "theorem") || syn_is(w, "lemma");
      after_dot = false;
      n = syn_emit(out, n, i, j, role);
      i = j; continue;
    }

    // Arrow operator -> (member access in C/C++, return type in Rust/Coax/Swift)
    if c == '-' && i + 1 < line.count && line[i + 1] == '>' {
      n = syn_emit(out, n, i, i + 2, SYN_PUNCTUATION);
      after_dot = (lang == SYN_LANG_C);
      prev_def = false;
      i += 2; continue;
    }

    // Punctuation & delimiters
    if c == '(' || c == ')' || c == '{' || c == '}' || c == '[' || c == ']' || c == ',' || c == ';' || c == ':' || c == '.' {
      j := i + 1;
      if c == ':' && j < line.count && (line[j] == ':' || line[j] == '=') { j += 1; }
      n = syn_emit(out, n, i, j, SYN_PUNCTUATION);
      after_dot = (c == '.');
      prev_def = false;
      i = j; continue;
    }

    // Operators
    if c == '&' || c == '=' || c == '+' || c == '-' || c == '*' || c == '/' || c == '!' || c == '<' || c == '>' || c == '|' || c == '%' || c == '^' || c == '?' || c == '~' {
      n = syn_emit(out, n, i, i + 1, SYN_PUNCTUATION);
      after_dot = false; prev_def = false;
      i += 1; continue;
    }

    n = syn_emit(out, n, i, i + 1, SYN_PLAIN);
    after_dot = false; prev_def = false;
    i += 1;
  }
  return n;
}

// ---------------------------------------------------------------- checks

#test "Rust lines highlight with Zeron Dark's roles" {
  runs: [64] MdRun;
  l := "fn header_color(_group: &ToolGroup) -> Hsla {";
  n := syn_rust(l, runs[..]);
  #assert runs[0].style == SYN_KEYWORD && runs[1].style == SYN_FUNCTION && runs[2].style == SYN_PUNCTUATION;
  #assert runs[3].style == SYN_VARIABLE && runs[4].style == SYN_PUNCTUATION && runs[5].style == SYN_KEYWORD && runs[6].style == SYN_TYPE;
  #assert runs[8].style == SYN_PLAIN && runs[9].style == SYN_TYPE && runs[n - 1].style == SYN_PUNCTUATION;
  n = syn_rust("    theme.text_muted // quiet", runs[..]);
  #assert n == 4 && runs[0].style == SYN_VARIABLE && runs[1].style == SYN_PUNCTUATION && runs[2].style == SYN_PROPERTY && runs[3].style == SYN_COMMENT;
  n = syn_rust("if group.any_failed() { \"s\" } else { 1 }", runs[..]);
  #assert runs[0].style == SYN_KEYWORD && runs[3].style == SYN_FUNCTION && runs[7].style == SYN_STRING && runs[9].style == SYN_KEYWORD && runs[11].style == SYN_NUMBER;
}

#test "multi-language path detection maps extensions to SYN_LANG_*" {
  #assert syn_lang_for_path("psionic/platform/inkling-gguf.c") == SYN_LANG_C;
  #assert syn_lang_for_path("host.h") == SYN_LANG_C && syn_lang_for_path("kernels.metal") == SYN_LANG_C;
  #assert syn_lang_for_path("apps/openagents-desktop/page/filepane.coax") == SYN_LANG_COAX;
  #assert syn_lang_for_path("Window+Files.swift") == SYN_LANG_SWIFT;
  #assert syn_lang_for_path("src/lib.rs") == SYN_LANG_RUST;
  #assert syn_lang_for_path("scripts/eval.py") == SYN_LANG_PYTHON;
  #assert syn_lang_for_path("ui/App.tsx") == SYN_LANG_JS;
  #assert syn_lang_for_path("package.json") == SYN_LANG_JSON;
  #assert syn_lang_for_path("README.md") == SYN_LANG_MD;
  #assert syn_lang_for_path("build.sh") == SYN_LANG_SH;
  #assert syn_lang_for_path("Main.lean") == SYN_LANG_LEAN;
  #assert syn_lang_for_path("notes.txt") == SYN_LANG_PLAIN;
}

#test "C syntax highlights keywords, stdint types, functions, hex/ull numbers, preprocessor, arrow fields, and block comments" {
  runs: [64] MdRun; blk: [1] bool;
  // Preprocessor + header string
  n := syn_tokenize_line(SYN_LANG_C, "#include <stdint.h>", blk[..], runs[..]);
  #assert n == 2 && runs[0].style == SYN_ATTRIBUTE && runs[1].style == SYN_STRING && !blk[0];
  // Real inkling-gguf.c signature & body
  n = syn_tokenize_line(SYN_LANG_C, "static uint64_t fnv1a(const char *s, size_t n) {", blk[..], runs[..]);
  #assert runs[0].style == SYN_KEYWORD && runs[1].style == SYN_TYPE && runs[2].style == SYN_FUNCTION;
  #assert runs[4].style == SYN_KEYWORD && runs[5].style == SYN_TYPE && runs[9].style == SYN_TYPE;
  n = syn_tokenize_line(SYN_LANG_C, "  uint64_t h = 14695981039346656037ull; return tok->tok_map;", blk[..], runs[..]);
  #assert runs[0].style == SYN_TYPE && runs[1].style == SYN_VARIABLE && runs[3].style == SYN_NUMBER;
  // Find tok->tok_map: tok is variable, -> is punctuation, tok_map is property
  found_prop := false;
  for k: 0..<n { if runs[k].style == SYN_PROPERTY { found_prop = true; } }
  #assert found_prop;
  // Multi-line /* ... */ block comment carries across lines
  n = syn_tokenize_line(SYN_LANG_C, "/* start of comment", blk[..], runs[..]);
  #assert n == 1 && runs[0].style == SYN_COMMENT && blk[0];
  n = syn_tokenize_line(SYN_LANG_C, "   still comment */ int x = 0x10;", blk[..], runs[..]);
  #assert !blk[0] && runs[0].style == SYN_COMMENT && runs[1].style == SYN_TYPE && runs[4].style == SYN_NUMBER;
}

#test "Coax, Swift, Python, JS/TS, JSON, Markdown, Shell, and Lean 4 tokenize key language roles" {
  runs: [64] MdRun; blk: [1] bool;
  // Coax
  n := syn_tokenize_line(SYN_LANG_COAX, "#load \"skin.coax\"; cp_add :: (x: f32) -> bool { return true; }", blk[..], runs[..]);
  #assert runs[0].style == SYN_ATTRIBUTE && runs[1].style == SYN_STRING && runs[3].style == SYN_FUNCTION;
  // Swift
  n = syn_tokenize_line(SYN_LANG_SWIFT, "@objc func openFile(_ url: URL) -> Bool { guard let x = nil else { return false } }", blk[..], runs[..]);
  #assert runs[0].style == SYN_ATTRIBUTE && runs[1].style == SYN_KEYWORD && runs[2].style == SYN_FUNCTION;
  // Python
  n = syn_tokenize_line(SYN_LANG_PYTHON, "def solve(x): # note", blk[..], runs[..]);
  #assert runs[0].style == SYN_KEYWORD && runs[1].style == SYN_FUNCTION && runs[n - 1].style == SYN_COMMENT;
  // JS/TS
  n = syn_tokenize_line(SYN_LANG_JS, "export async function fetchData(url: string) { return `ok`; }", blk[..], runs[..]);
  #assert runs[0].style == SYN_KEYWORD && runs[1].style == SYN_KEYWORD && runs[2].style == SYN_KEYWORD && runs[3].style == SYN_FUNCTION;
  // JSON
  n = syn_tokenize_line(SYN_LANG_JSON, "  \"name\": \"openagents\", \"count\": 42", blk[..], runs[..]);
  #assert runs[0].style == SYN_PROPERTY && runs[2].style == SYN_STRING && runs[4].style == SYN_PROPERTY && runs[6].style == SYN_NUMBER;
  // Markdown
  n = syn_tokenize_line(SYN_LANG_MD, "## Heading", blk[..], runs[..]);
  #assert n == 1 && runs[0].style == SYN_TAG;
  // Shell
  n = syn_tokenize_line(SYN_LANG_SH, "export PATH=\"$HOME/bin\" # set path", blk[..], runs[..]);
  #assert runs[0].style == SYN_KEYWORD && runs[n - 1].style == SYN_COMMENT;
  // Lean 4 + multi-line /- ... -/ comment
  n = syn_tokenize_line(SYN_LANG_LEAN, "theorem zero_add (n : Nat) : 0 + n = n := by sorry", blk[..], runs[..]);
  #assert runs[0].style == SYN_KEYWORD && runs[1].style == SYN_FUNCTION && runs[n - 1].style == SYN_INVALID;
  n = syn_tokenize_line(SYN_LANG_LEAN, "/- proof block", blk[..], runs[..]);
  #assert blk[0] && runs[0].style == SYN_COMMENT;
  n = syn_tokenize_line(SYN_LANG_LEAN, "done -/ def ok := true", blk[..], runs[..]);
  #assert !blk[0] && runs[0].style == SYN_COMMENT && runs[1].style == SYN_KEYWORD;
}
