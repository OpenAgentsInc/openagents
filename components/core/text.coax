// Text as the core layer reads it (components/spec.md, GitHub #13153): UTF-8
// code points and grapheme clusters, what a caret steps over and what a
// measure advances by. No fonts, pixels or cells here: a pixel target and a
// terminal measure the same clusters (components/layout/measure.coax).
//   coax/bin/coax test components/core/text.coax

Rune :: struct { code: u32; len: int; }

// The code point at byte i of UTF-8 text; a malformed byte reads as itself.
rune_at :: (text: string, i: int) -> Rune {
  b := cast(u32) text[i];
  if b < 0x80 { return Rune.{code = b, len = 1}; }
  n := ifx b >= 0xF0 then 4 else ifx b >= 0xE0 then 3 else 2;
  if b < 0xC0 || i + n > text.count { return Rune.{code = b, len = 1}; }
  mask: u32 = ifx n == 2 then 31 else ifx n == 3 then 15 else 7;
  c := b & mask;
  for k: 1..<n { c = (c << 6) | (cast(u32) text[i + k] & 63); }
  return Rune.{code = c, len = n};
}

// A code point that joins the one before it into one grapheme: combining
// marks, variation selectors, emoji skin tones and tags.
is_extend :: (c: u32) -> bool {
  return (c >= 0x300 && c <= 0x36F) || (c >= 0x483 && c <= 0x489) || (c >= 0x591 && c <= 0x5C7) ||
         (c >= 0x610 && c <= 0x61A) || (c >= 0x64B && c <= 0x65F) || (c >= 0x1AB0 && c <= 0x1AFF) ||
         (c >= 0x1DC0 && c <= 0x1DFF) || (c >= 0x20D0 && c <= 0x20FF) || (c >= 0x3099 && c <= 0x309A) ||
         (c >= 0xFE00 && c <= 0xFE0F) || (c >= 0xFE20 && c <= 0xFE2F) || (c >= 0x1F3FB && c <= 0x1F3FF) ||
         (c >= 0xE0020 && c <= 0xE007F) || (c >= 0xE0100 && c <= 0xE01EF);
}
is_regional :: (c: u32) -> bool { return c >= 0x1F1E6 && c <= 0x1F1FF; }

// The bytes of the grapheme at byte i (what GPUI's caret steps over: a
// letter with its marks, an emoji with its modifiers and joiners, a flag,
// CR LF). 0 at the end.
cluster_len :: (text: string, i: int) -> int {
  if i >= text.count { return 0; }
  r := rune_at(text, i);
  k := i + r.len;
  if r.code == '\r' && k < text.count && text[k] == '\n' { return 2; }
  if r.code < 0x80 && (k >= text.count || text[k] < 0x80) { return r.len; }
  if is_regional(r.code) && k < text.count {
    r2 := rune_at(text, k);
    if is_regional(r2.code) { k += r2.len; }
  }
  while k < text.count {
    r2 := rune_at(text, k);
    if r2.code == 0x200D {
      k += r2.len;
      if k < text.count { k += rune_at(text, k).len; }
    } else if is_extend(r2.code) {
      k += r2.len;
    } else {
      break;
    }
  }
  return k - i;
}

// Whether text ends with tail.
text_ends :: (text: string, tail: string) -> bool {
  if tail.count > text.count { return false; }
  for i: 0..<tail.count { if text[text.count - tail.count + i] != tail[i] { return false; } }
  return true;
}
// The decimal digits of a count (1 for anything under 10, 0 and less too).
text_digits :: (v: int) -> int {
  digits := 1; m := ifx v < 1 then 1 else v;
  while m >= 10 { m /= 10; digits += 1; }
  return digits;
}
// A count written in decimal into buf at `at` (a negative one as 0); returns the end.
text_put_int :: (buf: [] u8, at: int, v: int) -> int {
  digits: [20] u8; nd := 0; m := ifx v < 0 then 0 else v;
  if m == 0 { digits[0] = '0'; nd = 1; }
  while m > 0 && nd < 20 { digits[nd] = cast(u8) ('0' + m % 10); m /= 10; nd += 1; }
  for q: 0..<nd { if at + q < buf.count { buf[at + q] = digits[nd - 1 - q]; } }
  return at + nd;
}
// A span of seconds as a person reads it: "45s", "3m 07s" is "3m 7s", "2h 5m", "1d 3h" (a negative span is 0s).
text_elapsed :: (buf: [] u8, secs: int) -> int {
  s := ifx secs < 0 then 0 else secs;
  a := s; b := 0; ua: u8 = 's'; ub: u8 = 0;
  if s >= 86400 { a = s / 86400; b = (s % 86400) / 3600; ua = 'd'; ub = 'h'; }
  else if s >= 3600 { a = s / 3600; b = (s % 3600) / 60; ua = 'h'; ub = 'm'; }
  else if s >= 60 { a = s / 60; b = s % 60; ua = 'm'; ub = 's'; }
  n := text_put_int(buf, 0, a);
  if n < buf.count { buf[n] = ua; } n += 1;
  if ub != 0 {
    if n < buf.count { buf[n] = ' '; } n += 1;
    n = text_put_int(buf, n, b);
    if n < buf.count { buf[n] = ub; } n += 1;
  }
  return ifx n > buf.count then buf.count else n;
}

#test "counts in decimal: digits, a number written out, a span of seconds; a text's end" {
  #assert text_ends("main.rs", ".rs") && !text_ends("main.rsx", ".rs") && !text_ends("rs", ".rs") && text_ends("x", "");
  #assert text_digits(0) == 1 && text_digits(9) == 1 && text_digits(10) == 2 && text_digits(12345) == 5 && text_digits(-3) == 1;
  b: [32] u8;
  #assert cast(string) b[0..<text_put_int(b[..], 0, 0)] == "0" && cast(string) b[0..<text_put_int(b[..], 0, 1749890)] == "1749890";
  n := text_put_int(b[..], 0, 7); n = text_put_int(b[..], n, 42);
  #assert cast(string) b[0..<n] == "742";
  #assert cast(string) b[0..<text_elapsed(b[..], 45)] == "45s" && cast(string) b[0..<text_elapsed(b[..], 187)] == "3m 7s";
  #assert cast(string) b[0..<text_elapsed(b[..], 7500)] == "2h 5m" && cast(string) b[0..<text_elapsed(b[..], 97200)] == "1d 3h" && cast(string) b[0..<text_elapsed(b[..], -5)] == "0s";
}

#test "graphemes: a letter with its marks, emoji with modifiers and joiners, flags, CR LF" {
  #assert cluster_len("ab", 0) == 1 && cluster_len("", 0) == 0;
  #assert cluster_len("éx", 0) == 3;            // e + combining acute
  #assert cluster_len("👍🏽", 0) == 8;    // thumbs up, medium skin
  #assert cluster_len("👨‍👩", 0) == 11;   // man ZWJ woman
  #assert cluster_len("🇯🇵🇺", 0) == 8;   // JP, then a lone U
  #assert cluster_len("\r\nx", 0) == 2 && cluster_len("日本", 0) == 3;
}
