// The Everglade and Verse skins' colours are the realm HUD's FANTASY and
// SCIFI tokens (aethyr/ui/hud-style.coax), copied into components/skin/ so
// the component system does not load the engine. This holds the two equal
// until the HUD draws from the skins (components/spec.md Phase 5, GitHub
// #13153): change a colour in one place and this fails until the other
// follows.
//   coax/bin/coax test components/gallery/skin-parity.coax --only parity

#load "../skin/all.coax";
#load "../../aethyr/ui/hud-style.coax";

parity_same :: (c: Rgba, h: HudRgba) -> bool { return c.r == h.r && c.g == h.g && c.b == h.b && c.a == h.a; }

#test "parity: the Everglade skin's colours are FANTASY's" {
  s := everglade_skin(); t := hud_tokens(HUD_FANTASY);
  #assert parity_same(s.surface, t.frame_dark) && parity_same(s.frame_mid, t.frame_mid) && parity_same(s.frame_light, t.frame_light);
  #assert parity_same(s.trim, t.trim) && parity_same(s.accent, t.trim) && parity_same(s.ink, t.text) && parity_same(s.muted, t.text_dim);
  #assert parity_same(s.danger, t.bad) && parity_same(s.success, t.good) && parity_same(s.warning, t.damage);
  #assert s.radius == t.radius && s.border == t.line && s.stud == t.stud && s.shadow == t.shadow;
}
#test "parity: the Verse skin's colours are SCIFI's" {
  s := verse_skin(); t := hud_tokens(HUD_SCIFI);
  #assert parity_same(s.surface, t.frame_dark) && parity_same(s.frame_mid, t.frame_mid) && parity_same(s.frame_light, t.frame_light);
  #assert parity_same(s.trim, t.trim) && parity_same(s.accent, t.trim) && parity_same(s.ink, t.text) && parity_same(s.muted, t.text_dim);
  #assert parity_same(s.danger, t.bad) && parity_same(s.success, t.good) && parity_same(s.warning, t.damage);
  #assert s.radius == t.radius && s.border == t.line && s.stud == t.stud && s.shadow == t.shadow;
}
// The HUD set's roles (components/skin/hud.coax) are the same tokens.
parity_hud :: (h: UiHud, t: HudTokens) -> bool {
  return parity_same(h.hp, t.hp) && parity_same(h.hp_low, t.hp_low) && parity_same(h.groove, t.hp_back) && parity_same(h.magic, t.magic)
      && parity_same(h.ally, t.good) && parity_same(h.foe, t.bad) && parity_same(h.damage, t.damage) && parity_same(h.heal, t.heal)
      && parity_same(h.name, t.title) && parity_same(h.miss, t.text_dim) && parity_same(h.harm, t.bad);
}
#test "parity: the HUD set's roles are FANTASY's in Everglade and SCIFI's in the Verse" {
  #assert parity_hud(everglade_skin().hud, hud_tokens(HUD_FANTASY)) && parity_hud(verse_skin().hud, hud_tokens(HUD_SCIFI));
  #assert !parity_hud(verse_skin().hud, hud_tokens(HUD_FANTASY));
}
