// openagents.com/components: the frames set (components/kit/frames.coax) in
// the mono skin, drawn by the browser through the browser backend
// (components/backend/dom.coax). Every component is on the page and works:
// buttons count their presses, the composer sends, a tool call opens, rows
// and the menu pick, a notice's buttons answer, Replay enters everything
// again. docs/audits/2026-11-11-chat-zero-base-audit.md, sections 10 and 11.
//
// The page builds its tree only when something changed or is still
// entering, and the backend sends only what differs, so a still page does no
// work. The host (coax/web/dom-host.js) applies the commands and reports
// presses, typing and framed nodes' sizes.
//   coax/bin/coax test components/gallery/web.coax

#load "../kit/dock.coax";
#load "../kit/settings.coax";
#load "../kit/work.coax";
#load "../kit/listing.coax";
#load "../backend/dom.coax";

WG_INBOX :: 4096;      // a press's or a field's text from the host
WG_DRAFT :: 1024;
WG_SENT :: 4;          // messages the composer has sent, kept
WG_CSS :: 40960;
WG_CLICK :: 1; WG_INPUT :: 2; WG_SUBMIT :: 3;
WG_ROWS :: [3] string.["Zero-base the chat", "Why the runner ran out of memory", "Port the frames to SVG"];
WG_ROW_META :: [3] string.["Opus 5.5 · Nov 11 21:40", "Sonnet 5.5 · Nov 11 14:02", "Haiku 5.5 · Nov 10 09:15"];
WG_THINGS :: [3] string.["Cargo crate", "Parked rover", "Crab-bot"];
WG_MODELS :: [3] string.["Opus 5.5", "Sonnet 5.5", "Haiku 5.5"];
WG_MODEL_NOTES :: [3] string.["For complex work", "For everyday tasks", "Fastest for quick answers"];
WG_ANSWER :: "The page reads `/api/chat/state` every **2 seconds** and rebuilds the whole transcript from it. Three things follow:\n\n- an answer appears only when its turn ends\n- a stopped turn loses what was written\n- nothing marks where a long chat was cut\n\nThe fix is on the server first: keep each line of the session record, then stream it. See [the audit](/docs/audits/2026-11-11-chat-zero-base-audit.md).\n\n| Limit | Value |\n| --- | --- |\n| Turns sent | 40 |\n| Tools a turn | 12 |";
// What a refused tool call got back, as the realm CLI says it in words.
WG_REFUSED :: "refused (edit-refused; a retry won't help): foe 2 has no route for the dusk patrol\nrev 5, nothing was saved";
WG_CODE :: "dm_flush :: (d: [] Dom, t: [] Tree, sets: [] AfSettings) -> int {\n  // compare the tree with what was last sent, by id\n  // write only what changed\n}";

WebPage :: struct {
  ready: bool; time: f32; dirty: bool; animating: bool;
  presses: int;
  tool_open: bool;
  work: [4] bool;                    // the work log's run, group, refused row and its Show all are open
  row: int; model: int; thing: int; grouped: [3] bool;
  radius: int = 2;   // the dock's stepper: which of its five steps it stands at
  lit: [2] bool;     // the dock's switch rows: which of the two are on
  switched: bool = true;   // the settings page's switch
  section: int;            // the settings page's section shown
  answer: int;                       // the approval notice: 0 not answered, 1 allowed, 2 denied
  draft: [WG_DRAFT] u8; draft_n: int;
  sent: [WG_SENT] [WG_DRAFT] u8; sent_n: [WG_SENT] int; nsent: int;
  clip: [WG_DRAFT] u8; clip_n: int;  // text for the host to copy, until it has
  inbox: [WG_INBOX] u8;
  sets: [MF_COUNT] AfSettings;
  css: [WG_CSS] u8;
  ui: [1] Ui;
  doc: [1] MdDoc;
  tree: [1] Tree;
  dom: [1] Dom;
}

wg_section :: (t: [] Tree, id: string, title: string, note: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  i := tr_open(t, id, TG_SECTION, "sec");
  h := tr_leaf(t, tr_cat(ida[..], id, ".h"), TG_H2, "sec-h", title);
  if note.count > 0 { n := tr_leaf(t, tr_cat(idb[..], id, ".n"), TG_P, "sec-n", note); }
  return i;
}

wg_build :: (s: [] WebPage) {
  t := s[0].tree[..]; u := s[0].ui[..];
  buf: [UI_ID] u8; buf2: [UI_ID] u8;
  tr_begin(t);
  page := tr_open(t, "page", TG_MAIN, "page");

  top := tr_open(t, "top", TG_DIV, "col");
  hd := k_header(t, u, "title", "Components");
  tr_close(t);
  lede := tr_leaf(t, "lede", TG_P, "lede", "The components the OpenAgents chat is being rebuilt from: a small set, each a frame around content, in black, white and grey. The browser draws them, so the text here is real text: select it, search it, zoom it, have it read aloud.");
  bar := tr_open(t, "top.bar", TG_DIV, "rowf");
  rp := k_button(t, u, "replay", "Replay the entrance", BS_PLAIN);
  tr_close(t);
  tr_close(t);

  sec := wg_section(t, "buttons", "Button", "An octagon and a label. The primary action is the inverse. A disabled one is dashed.");
  row := tr_open(t, "buttons.row", TG_DIV, "rowf");
  b1 := k_button(t, u, "press.primary", "Send", BS_PRIMARY);
  b2 := k_button(t, u, "press.plain", "New chat", BS_PLAIN);
  b3 := k_button(t, u, "press.stop", "Stop", BS_PLAIN);
  b4 := k_button(t, u, "press.off", "Unavailable", BS_DISABLED);
  tr_close(t);
  count := tr_leaf(t, "buttons.count", TG_P, "meta", tr_cat(buf2[..], tr_join(buf[..], "Pressed ", s[0].presses), ifx s[0].presses == 1 then " time" else " times"));
  tr_close(t);

  sec = wg_section(t, "fields", "Field and composer", "Real text fields: the keyboard, paste, spell check and the phone's keys are the browser's. Enter sends; Shift and Enter makes a line.");
  f := k_field(t, u, "name", "Name this chat", "Name this chat");
  c := k_composer(t, u, "composer", "Ask the OpenAgents agent", "Opus 5.5", "Send", s[0].draft_n > 0);
  tr_close(t);

  sec = wg_section(t, "talk", "Conversation", "The person's message is in a dim frame. A tool call is a row that opens. The agent's answer is plain Markdown on the ground, with no frame and no effect: it is for reading.");
  th := tr_open(t, "thread", TG_DIV, "thread");
  m1 := k_user(t, u, "msg.0", "Why does the chat feel slow?");
  tool := k_tool(t, u, "tool.1", "Read", "apps/openagents-web/chat.coax", s[0].tool_open, "path: apps/openagents-web/chat.coax", "1,536 lines. WC_BUSY :: 2.0; // seconds between reads while a turn waits or runs");
  if s[0].doc[0].nb == 0 { n := md_parse(s[0].doc[..], WG_ANSWER, 0); }
  ans := k_agent(t, u, "msg.1", s[0].doc[..]);
  meta := k_meta(t, "msg.1.meta", "Opus 5.5 · OpenAgents key · $0.0412");
  for k: 0..<s[0].nsent {
    m := k_user(t, u, tr_join(buf[..], "sent.", k), cast(string) s[0].sent[k][0..<s[0].sent_n[k]]);
  }
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "work", "Work log", "An agent's tool calls. A call is a row: what it does in words, what it worked on, how it stands and how long it took; it opens onto what it sent and what came back. Calls of one tool in a row are a group with a count. A finished run is one line above the answer. A dry run, a refusal and a wait for approval each say so in words, and why.");
  wl := tr_open(t, "work.log", TG_DIV, "wk-log");
  sum := k_work_group_begin(t, u, "work.w", IC_EDIT_PENCIL, "Set foe plans ×12, Look up tools, and 2 more tools", 15, "", KW_REFUSED, s[0].work[0]);
  if s[0].work[0] {
    r0 := k_work_row(t, u, "work.c.0", IC_EYE, "Read the world splice", "splice", KW_DONE, "", 1200, false, "{\"slug\":\"splice\"}", "{\"ok\":true,\"things\":14}", false);
    g := k_work_group_begin(t, u, "work.g", IC_EDIT_PENCIL, "Set foe plans", 12, "Set foe 3's night plan: hunt", KW_REFUSED, s[0].work[1]);
    if s[0].work[1] {
      r1 := k_work_row(t, u, "work.c.1", IC_EDIT_PENCIL, "Set foe 2's dusk plan: rest", "splice", KW_REFUSED, "foe 2 has no route for the dusk patrol. Trying again won't help.", 0, s[0].work[2],
        "{\"slug\":\"splice\",\"foe\":2,\"daytime\":\"dusk\",\"act\":\"rest\"}", WG_REFUSED, s[0].work[3]);
      r2 := k_work_row(t, u, "work.c.2", IC_EDIT_PENCIL, "Set foe 3's dawn plan: patrol", "splice", KW_DRY, "Nothing was saved: carried out whole in a throwaway copy of the world.", 0, false, "", "", false);
      r3 := k_work_row(t, u, "work.c.3", IC_GLOBE, "Publish splice now", "splice", KW_ASK, "Nothing was done. It runs once it is approved.", 0, false, "", "", false);
      r4 := k_work_row(t, u, "work.c.4", IC_EDIT_PENCIL, "Set foe 3's night plan: hunt", "splice", KW_RUN, "", 4000, false, "", "", false);
    }
    k_work_group_end(t, s[0].work[1]);
  }
  k_work_group_end(t, s[0].work[0]);
  tr_close(t);
  wn := k_work_now(t, "work.now", "Set foe 3's night plan: hunt");
  tr_close(t);

  sec = wg_section(t, "code", "Code block", "Its language and Copy in a strip, then the code, which scrolls sideways before it wraps.");
  cb := k_code(t, u, "code.1", "coax", WG_CODE);
  tr_close(t);

  sec = wg_section(t, "code-fields", "Code field", "Code to edit: the code face, no wrapping, a set height that scrolls both ways. Enter makes a line and Tab indents. The editor's Code pane is built from it.");
  cf := k_code_field(t, u, "code.edit", "coax", "Code to edit");
  tr_close(t);

  sec = wg_section(t, "drops", "Drop and file", "A place to drop a file, or press to pick one: it says what it takes before anything is sent. A file in a list is its name and what it is. The editor's Assets pane is built from them.");
  dr := k_drop(t, u, "drop.1", "Drop a file here, or press to pick one", "A .glb, .png, .wav, .ogg or .mp3 file, 512 KB at most", ".glb,.png,.wav,.ogg,.mp3", false);
  db := k_drop(t, u, "drop.2", "Sending rock.glb", "2 KB", "", true);
  f1 := k_file(t, "file.1", "rock", "Mesh · 2 KB · CC0 1.0 Universal");
  f2 := k_file(t, "file.2", "door", "Sound · 4 KB · CC BY 4.0");
  tr_close(t);

  sec = wg_section(t, "notices", "Notice", "Between two lines, bright. It says its kind in words, since there is no red to say it.");
  n1 := k_notice(t, u, "notice.error", "Error", "The runner didn't answer. Your message is back in the composer.");
  tr_close(t);
  n2 := k_notice(t, u, "notice.ask", "Approval needed", "The agent wants to run: git push origin main");
  ask := tr_open(t, "notice.ask.row", TG_DIV, "rowf");
  if s[0].answer == 0 {
    a1 := k_button(t, u, "allow", "Allow", BS_PRIMARY);
    a2 := k_button(t, u, "deny", "Deny", BS_PLAIN);
  } else {
    said := tr_leaf(t, "notice.ask.said", TG_SPAN, "meta", ifx s[0].answer == 1 then "Allowed" else "Denied");
    a3 := k_link(t, "ask.again", "Ask again");
  }
  tr_close(t);
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "rows", "Row", "A conversation in the list. The current one is bright over an underline.");
  list := tr_open(t, "list", TG_NAV, "list");
  tr_attr(t, list, AT_LABEL, "Chats");
  titles := WG_ROWS; metas := WG_ROW_META;
  for k: 0..<3 { r := k_row(t, u, tr_join(buf[..], "row.", k), titles[k], metas[k], k == s[0].row); }
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "sides", "Side", "The frame down the left of every page for someone logged in: the mark and Hide the side, then Chats, Projects and Worlds as folds that open and shut their lists in place, each with a + at its right that makes a new one, and who is logged in at the foot. On a page it stands the window's height.");
  gs := k_side(t, "side", "Places");
  gh := k_side_head(t, "side.h", "OpenAgents", "/components");
  gn := k_icon_button(t, "side.hide", IC_SIDEBAR, "Hide the side");
  tr_close(t);
  gl := k_side_folds(t, "side");
  sf1 := k_fold(t, u, "side.chats", IC_CHATS, "Chats", true, true, "New chat");
  gm := k_side_mark(t, "side.recent", "Recent", 3);
  for k: 0..<3 { r := k_row(t, u, tr_join(buf[..], "side.row.", k), titles[k], "", k == 0); }
  tr_close(t);
  sf2 := k_fold(t, u, "side.projects", IC_FOLDER, "Projects", false, false, "New project");
  tr_close(t);
  sf3 := k_fold(t, u, "side.worlds", IC_GLOBE, "Worlds", true, false, "New world");
  p4 := k_sub_place(t, u, "side.splice", "Splice Bots", "/components");
  tr_close(t);
  k_side_end(t);
  gw := k_who(t, u, "side.who", "a•••@example.com", "/components", false);
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "settings", "Settings", "A settings page beside the side: its sections down the left, the one shown bright on the raised surface, and the section's rows in framed groups. A row is a name, what it is or does, and what changes it at its right: a switch that says On or Off, a button, a link or a value. /settings is built from it.");
  sp := k_set(t, "st");
  sn := k_set_nav(t, "st.nav", "Settings");
  snames := [2] string.["Account", "Appearance"]; sicons := [2] int.[IC_AVATAR_PROFILE, IC_COLOR_THEME];
  for k: 0..<2 { r := k_place(t, u, tr_join(buf[..], "st.nav.", k), sicons[k], snames[k], "/components", k == s[0].section); }
  tr_close(t);
  sb := k_set_body(t, u, "st.b", "Settings", snames[s[0].section]);
  sg := k_set_group(t, u, "st.g", ifx s[0].section == 0 then "You" else "");
  if s[0].section == 0 {
    r1 := k_set_row(t, "st.who", "Logged in as", "a•••@example.com"); k_set_row_end(t);
    r2 := k_set_row(t, "st.lim", "Email codes sent to one address", ""); v := k_set_value(t, "st.lim.v", "5 an hour"); k_set_row_end(t);
    r3 := k_set_row(t, "st.sec", "Security", "How you log in: your email, keys and passkeys."); g := k_go(t, "st.sec.go", "Open", "/components"); k_set_row_end(t);
    r4 := k_set_row(t, "st.out", "Log out", "Log out of this browser."); o := k_button(t, u, "st.out.b", "Log out", BS_PLAIN); k_set_row_end(t);
  } else {
    r1 := k_set_row(t, "st.side", "The side", "Places and chats down the left."); sw := k_switch(t, "st.side.sw", "The side", s[0].switched); k_set_row_end(t);
  }
  k_set_group_end(t);
  tr_close(t);
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "menus", "Menu", "Rows in a panel: the model for the next turn.");
  menu := k_menu(t, u, "menu", "Model");
  models := WG_MODELS; notes := WG_MODEL_NOTES;
  for k: 0..<3 { r := k_row(t, u, tr_join(buf[..], "model.", k), models[k], notes[k], k == s[0].model); }
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "cards", "World card", "A world as a conversation shows it: its name, what it holds, and a link that opens its editor.");
  wc := k_card(t, u, "card.world", "Splice");
  wm := k_meta(t, "card.world.facts", "12 things · revision 7");
  wo := k_go(t, "card.world.open", "Open the editor", "/worlds/splice?edit=agent");
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "lists", "Entries", "Things in a list beside the side, under a heading with their count: a small picture when one exists, the name as a link, a line about it, its facts, and its actions at the right. A choice of a few sorts or filters them. /projects and /worlds are built from them.");
  lch := k_choices(t, "ls.sort", "Sort by");
  lc0 := k_choice(t, "ls.sort.0", "Popular", true);
  lc1 := k_choice(t, "ls.sort.1", "A to Z", false);
  tr_close(t);
  le := k_entries(t, "ls", "Worlds", 2);
  le0 := k_entry(t, u, "ls.0", "Everglade", "/worlds/everglade", "A forest city with quests out to the deep wood", "Opened Oct 28, 2026 · 1,290 visitors", "/worlds/everglade/og.jpg", "Everglade");
  lp0 := k_go_button(t, u, "ls.0.play", "Play", "/worlds/everglade", true);
  lq0 := k_go_button(t, u, "ls.0.edit", "Edit", "/worlds/everglade?edit", false);
  k_entry_end(t);
  le1 := k_entry(t, u, "ls.1", "Farm", "/worlds/farm", "A meadow with a red barn", "Opened Nov 1, 2026", "", "");
  lp1 := k_go_button(t, u, "ls.1.play", "Play", "/worlds/farm", true);
  k_entry_end(t);
  k_entries_end(t);
  tr_close(t);

  sec = wg_section(t, "docks", "Dock", "Panes round something that still shows: a strip of actions, a list, the picked thing's fields and facts, and a foot. The editor that ?edit opens over a world is built from it.");
  dock := k_dock(t, "dock", false);
  strip := k_pane(t, u, "dock.bar", DK_TOP, "");
  d1 := k_button(t, u, "dock.undo", "Undo", BS_PLAIN);
  d2 := k_button(t, u, "dock.redo", "Redo", BS_DISABLED);
  d3 := tr_leaf(t, "dock.rev", TG_SPAN, "meta", "splice · revision 7");
  k_pane_end(t);
  things := k_pane(t, u, "dock.things", DK_LEFT, "Things");
  dl := tr_open(t, "dock.list", TG_NAV, "list");
  tr_attr(t, dl, AT_LABEL, "Things");
  pieces := WG_THINGS;
  for k: 0..<3 { r := k_row_with(t, u, tr_join(buf[..], "thing.", k), pieces[k], tr_join(buf2[..], "No. ", k + 1), k == s[0].thing, IC_PLUS, "Add to the group", s[0].grouped[k]); }
  tr_close(t);
  k_pane_end(t);
  one := k_pane(t, u, "dock.one", DK_RIGHT, "Selected");
  oc := k_card(t, u, "dock.card", pieces[s[0].thing]);
  px := k_prop(t, u, "dock.x", "X cm", "0");
  pz := k_prop(t, u, "dock.z", "Z cm", "0");
  fk := k_fact(t, "dock.kit", "Kit", "rover");
  // a stepper: a value that is stepped, not typed
  radii := [5] string.["2 m", "4 m", "8 m", "16 m", "32 m"];
  sr := k_stepper(t, "dock.radius", "Radius", radii[s[0].radius], s[0].radius > 0, s[0].radius < 4);
  // a slider: a whole number dragged along a line (its place is the browser's own; the words beside it say the usual)
  sh := k_slider(t, "dock.height", "Height", "145 to 225 cm", 145, 225, 1);
  // a meter: an amount against its limit, the limit in the words too
  mt := k_meter(t, "dock.spent", "Budget", "5,000 of 20,000", 0.25);
  tr_close(t);
  // switch rows: a list of named things that are each on or off (a realm's board, the tools its visitors get)
  bh := k_header(t, u, "dock.board", "Features");
  tr_close(t);
  sw0 := k_switch_row(t, "dock.sw.0", "Glowing mushrooms", "", s[0].lit[0]);
  sw1 := k_switch_row(t, "dock.sw.1", "A bridge over the stream", "Off until the stream is dug", s[0].lit[1]);
  k_pane_end(t);
  dfoot := k_pane(t, u, "dock.foot", DK_BOTTOM, "Agent");
  fm := k_meta(t, "dock.foot.note", "A foot across the bottom. In the editor its slot holds the chat's conversation.");
  k_pane_end(t);
  tr_close(t);
  tr_close(t);

  foot := tr_open(t, "foot", TG_FOOTER, "md");
  credit := tr_open(t, "credit", TG_P, "");
  c1 := tr_leaf(t, "credit.0", TG_SPAN, "", "The frames and their motion are ");
  c2 := tr_leaf(t, "credit.1", TG_A, "", "ARWES");
  tr_attr(t, c2, AT_HREF, "https://github.com/arwes/arwes/tree/bdbaa0324900ee978d42036d1304a053c1fe54b5");
  c3 := tr_leaf(t, "credit.2", TG_SPAN, "", " by Romel Perez, ported to Coax, under the ");
  c4 := tr_leaf(t, "credit.3", TG_A, "", "MIT license");
  tr_attr(t, c4, AT_HREF, "https://github.com/arwes/arwes/blob/bdbaa0324900ee978d42036d1304a053c1fe54b5/LICENSE");
  c5 := tr_leaf(t, "credit.4", TG_SPAN, "", ". The earlier components, drawn on the GPU, are at ");
  c6 := tr_leaf(t, "credit.5", TG_A, "", "/components-gpu");
  tr_attr(t, c6, AT_HREF, "/components-gpu");
  c7 := tr_leaf(t, "credit.6", TG_SPAN, "", ".");
  tr_close(t);
  tr_close(t);

  tr_close(t);
}

wg_id_is :: (id: string, part: string) -> bool { return id.count >= part.count && cast(string) id[0..<part.count] == part; }
// The digit after a part: "row.2" after "row." is 2.
wg_index :: (id: string, part: string) -> int {
  if !wg_id_is(id, part) || id.count != part.count + 1 { return -1; }
  c := id[part.count];
  return ifx c >= '0' && c <= '9' then cast(int) (c - '0') else -1;
}
wg_send :: (s: [] WebPage) {
  lo := 0; hi := s[0].draft_n;
  while lo < hi && (s[0].draft[lo] == ' ' || s[0].draft[lo] == '\n') { lo += 1; }
  while hi > lo && (s[0].draft[hi - 1] == ' ' || s[0].draft[hi - 1] == '\n') { hi -= 1; }
  if hi <= lo { return; }
  // the newest WG_SENT stay
  if s[0].nsent >= WG_SENT {
    for k: 1..<WG_SENT { s[0].sent[k - 1] = s[0].sent[k]; s[0].sent_n[k - 1] = s[0].sent_n[k]; }
    s[0].nsent = WG_SENT - 1;
  }
  k := s[0].nsent;
  for i: lo..<hi { s[0].sent[k][i - lo] = s[0].draft[i]; }
  s[0].sent_n[k] = hi - lo; s[0].nsent += 1;
  s[0].draft_n = 0;
  dm_value(s[0].dom[..], "composer", "");
}
wg_click :: (s: [] WebPage, id: string) {
  if id == "replay" { ui_replay(s[0].ui[..]); }
  else if id == "press.primary" || id == "press.plain" || id == "press.stop" { s[0].presses += 1; }
  else if id == "tool.1" { s[0].tool_open = !s[0].tool_open; }
  else if id == "work.w" { s[0].work[0] = !s[0].work[0]; }
  else if id == "work.g" { s[0].work[1] = !s[0].work[1]; }
  else if id == "work.c.1" { s[0].work[2] = !s[0].work[2]; }
  else if id == "work.c.1.all" { s[0].work[3] = !s[0].work[3]; }
  else if id == "work.c.1.copy" { s[0].clip_n = 0; for c: WG_REFUSED { if s[0].clip_n < WG_DRAFT { s[0].clip[s[0].clip_n] = c; s[0].clip_n += 1; } } }
  else if id == "allow" { s[0].answer = 1; }
  else if id == "deny" { s[0].answer = 2; }
  else if id == "ask.again" { s[0].answer = 0; }
  else if id == "composer.send" { wg_send(s); }
  else if id == "code.1.copy" { s[0].clip_n = 0; for c: WG_CODE { if s[0].clip_n < WG_DRAFT { s[0].clip[s[0].clip_n] = c; s[0].clip_n += 1; } } }
  else if wg_index(id, "row.") >= 0 { s[0].row = wg_index(id, "row."); }
  else if id.count == 9 && wg_id_is(id, "thing.") && cast(string) id[7..<9] == ".x" && id[6] >= '0' && id[6] <= '2' { k := cast(int) (id[6] - '0'); s[0].grouped[k] = !s[0].grouped[k]; }
  else if wg_index(id, "thing.") >= 0 { s[0].thing = wg_index(id, "thing."); }
  else if id == "dock.radius.less" && s[0].radius > 0 { s[0].radius -= 1; }
  else if id == "dock.radius.more" && s[0].radius < 4 { s[0].radius += 1; }
  else if wg_index(id, "model.") >= 0 { s[0].model = wg_index(id, "model."); }
  else if wg_index(id, "st.nav.") >= 0 && wg_index(id, "st.nav.") < 2 { s[0].section = wg_index(id, "st.nav."); }
  else if id == "st.side.sw" { s[0].switched = !s[0].switched; }
  else if id == "dock.sw.0" { s[0].lit[0] = !s[0].lit[0]; }
  else if id == "dock.sw.1" { s[0].lit[1] = !s[0].lit[1]; }
}

// ---------------------------------------------------------------- the face's calls

// One frame: builds and flushes if something changed or is entering. Bytes of commands to apply (at coaxial_kit_out).
coaxial_kit_frame :: (s: [] WebPage, dt: f32, reduced: bool) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  if !s[0].ready {
    n := mono_frames(s[0].sets[..]);
    s[0].ready = true; s[0].dirty = true;
  }
  step := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  s[0].time += step;
  if !s[0].dirty && !s[0].animating { return 0; }
  d := s[0].dom[..];
  if !d[0].styled {
    n := mono_page_css(s[0].css[..], mono_work_css(s[0].css[..], mono_set_css(s[0].css[..], mono_dock_css(s[0].css[..], mono_css(s[0].css[..])))));
    dm_style(d, cast(string) s[0].css[0..<n]);
  }
  ui_begin(s[0].ui[..], s[0].time, reduced);
  wg_build(s);
  ui_end(s[0].ui[..]);
  s[0].animating = s[0].ui[0].busy;
  s[0].dirty = false;
  bytes := dm_flush(d, s[0].tree[..], s[0].sets[..]);
  if d[0].overflow { dm_reset(d); s[0].dirty = true; return -1; }   // the host clears the page; the next frame sends it whole
  return bytes;
}
coaxial_kit_busy :: (s: [] WebPage) -> bool #export_c #effects(all) { return s.count > 0 && (s[0].dirty || s[0].animating); }
// A press (1), a field's text (2: the inbox holds it) or Enter in a field (3), on the node in this slot.
coaxial_kit_event :: (s: [] WebPage, kind: int, slot: int, length: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  id := dm_slot_id(s[0].dom[..], slot);
  if id.count == 0 { return; }
  if kind == WG_CLICK { wg_click(s, id); }
  else if kind == WG_INPUT && id == "composer" {
    n := ifx length < 0 then 0 else ifx length > WG_DRAFT then WG_DRAFT else ifx length > WG_INBOX then WG_INBOX else length;
    for i: 0..<n { s[0].draft[i] = s[0].inbox[i]; }
    s[0].draft_n = n;
  }
  else if kind == WG_SUBMIT && id == "composer" { wg_send(s); }
  s[0].dirty = true;
}
coaxial_kit_size :: (s: [] WebPage, slot: int, w: f32, h: f32) #export_c #effects(all) {
  if s.count > 0 && dm_size(s[0].dom[..], slot, w, h) { s[0].dirty = true; }
}
coaxial_kit_clip :: (s: [] WebPage) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].clip_n else 0; }
coaxial_kit_clip_done :: (s: [] WebPage) #export_c #effects(all) { if s.count > 0 { s[0].clip_n = 0; } }
coaxial_kit_inbox_cap :: () -> int #export_c #effects(all) { return WG_INBOX; }

// ---------------------------------------------------------------- checks

WgTest :: struct { s: [1] WebPage; }

#test "the page builds every component, sends itself once, and then is still" {
  h: [1] WgTest; s := h[0].s[..];
  n := coaxial_kit_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert n > 4000 && t[0].lost == 0 && t[0].depth == 0 && t[0].n > 120 && t[0].n < TR_NODES;
  #assert s[0].dom[0].out[0] == DC_STYLE && !coaxial_kit_busy(s);
  #assert tr_find(t, "press.primary") > 0 && tr_find(t, "composer") > 0 && tr_find(t, "tool.1") > 0 && tr_find(t, "code.1.pre") > 0;
  #assert tr_find(t, "notice.error") > 0 && tr_find(t, "row.2") > 0 && tr_find(t, "model.0") > 0 && tr_find(t, "msg.1.b0") > 0;
  #assert tr_class(t, tr_find(t, "ls.0")) == "ent" && tr_attr_of(t, tr_find(t, "ls.0.edit"), AT_HREF) == "/worlds/everglade?edit" && tr_find(t, "ls.1.pic") < 0 && tr_attr_of(t, tr_find(t, "ls.sort.0"), AT_PRESSED) == "true";
  #assert tr_find(t, "dock.bar.b") > 0 && tr_class(t, tr_find(t, "dock.foot")) == "pane pane-bm" && tr_find(t, "dock.x") > 0 && tr_text_of(t, tr_find(t, "dock.kit.v")) == "rover" && tr_class(t, tr_find(t, "dock")) == "dock";
  #assert tr_class(t, tr_find(t, "side")) == "side" && tr_text_of(t, tr_find(t, "side.who.go.t")) == "a•••@example.com" && tr_find(t, "side.row.2") > 0;
  #assert coaxial_kit_frame(s, 0.016, true) == 0;
  // the stepper steps: more raises its value, and at its last step More can't be pressed
  #assert tr_text_of(t, tr_find(t, "dock.radius")) == "8 m";
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "dock.radius.more"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "dock.radius.more"), 0);
  _ := coaxial_kit_frame(s, 0.016, true);
  #assert s[0].radius == 4 && tr_text_of(t, tr_find(t, "dock.radius")) == "32 m" && tr_has(t, tr_find(t, "dock.radius.more"), AT_DISABLED) && !tr_has(t, tr_find(t, "dock.radius.less"), AT_DISABLED);
  // a switch row: its name, its line and the switch; a press turns it on
  #assert tr_text_of(t, tr_find(t, "dock.sw.1.n")) == "A bridge over the stream" && tr_text_of(t, tr_find(t, "dock.sw.1.m")) == "Off until the stream is dug" && tr_text_of(t, tr_find(t, "dock.sw.1.l")) == "Off" && tr_find(t, "dock.sw.0.m") < 0;
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "dock.sw.1"), 0);
  _ = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].lit[1] && !s[0].lit[0] && tr_text_of(t, tr_find(t, "dock.sw.1.l")) == "On" && tr_attr_of(t, tr_find(t, "dock.sw.1"), AT_PRESSED) == "true";
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "thing.1"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].thing == 1 && tr_text_of(t, tr_find(t, "dock.card.h")) == "Parked rover";
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "thing.2.x"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].grouped[2] && s[0].thing == 1 && tr_has(t, tr_find(t, "thing.2.x"), AT_PRESSED) && !tr_has(t, tr_find(t, "thing.0.x"), AT_PRESSED);
}

#test "the settings page: its sections pick, the one shown is bright, and its switch says On or Off" {
  h: [1] WgTest; s := h[0].s[..];
  n := coaxial_kit_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert tr_class(t, tr_find(t, "st")) == "st" && tr_attr_of(t, tr_find(t, "st.nav.0"), AT_CURRENT) == "true" && tr_text_of(t, tr_find(t, "st.lim.v")) == "5 an hour" && tr_find(t, "st.side") < 0;
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "st.nav.1"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert tr_attr_of(t, tr_find(t, "st.nav.1"), AT_CURRENT) == "true" && !tr_has(t, tr_find(t, "st.nav.0"), AT_CURRENT) && tr_text_of(t, tr_find(t, "st.side.sw.l")) == "On";
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "st.side.sw"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert tr_text_of(t, tr_find(t, "st.side.sw.l")) == "Off" && tr_attr_of(t, tr_find(t, "st.side.sw"), AT_PRESSED) == "false";
}

#test "a press, a pick and an answer each change only their own nodes" {
  h: [1] WgTest; s := h[0].s[..];
  n := coaxial_kit_frame(s, 0.016, true);
  d := s[0].dom[..];
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "press.plain"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].presses == 1 && d[0].sent == 1 && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "buttons.count")) == "Pressed 1 time";
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "press.off"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].presses == 1 && n == 0;
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "row.2"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].row == 2 && d[0].sent == 4;   // one row loses its frame mark and its current mark, the other gains both
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "tool.1"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].tool_open && dm_find(d, "tool.1.out") >= 0;
  // the work log: its run opens onto a group, the group onto its rows, a refused row onto what came back
  #assert tr_find(s[0].tree[..], "work.w") > 0 && tr_find(s[0].tree[..], "work.g") < 0;
  for id: [3] string.["work.w", "work.g", "work.c.1"] { coaxial_kit_event(s, WG_CLICK, dm_find(d, id), 0); n = coaxial_kit_frame(s, 0.016, true); }
  #assert tr_attr_of(s[0].tree[..], tr_find(s[0].tree[..], "work.c.1.row"), AT_STATE) == "refused" && dm_find(d, "work.c.1.out") >= 0 && tr_find(s[0].tree[..], "work.c.4.g") > 0;
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "work.c.1.copy"), 0);
  #assert coaxial_kit_clip(s) == WG_REFUSED.count;
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "allow"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].answer == 1 && dm_find(d, "allow") < 0 && dm_find(d, "ask.again") >= 0;
}

#test "the composer sends what was typed, trimmed, clears its field and keeps the newest four" {
  h: [1] WgTest; s := h[0].s[..];
  n := coaxial_kit_frame(s, 0.016, true);
  d := s[0].dom[..];
  field := dm_find(d, "composer");
  #assert tr_has(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_DISABLED);
  text := "  hello there \n";
  for i: 0..<text.count { s[0].inbox[i] = text[i]; }
  coaxial_kit_event(s, WG_INPUT, field, text.count);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert !tr_has(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_DISABLED);
  coaxial_kit_event(s, WG_SUBMIT, field, 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].nsent == 1 && s[0].draft_n == 0 && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "sent.0.p")) == "hello there";
  #assert dm_test_count(d, n, DC_VALUE) == 1;
  for k: 0..<5 {
    s[0].inbox[0] = cast(u8) ('a' + k);
    coaxial_kit_event(s, WG_INPUT, field, 1);
    coaxial_kit_event(s, WG_CLICK, dm_find(d, "composer.send"), 0);
    n = coaxial_kit_frame(s, 0.016, true);
  }
  #assert s[0].nsent == WG_SENT && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "sent.3.p")) == "e";
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "code.1.copy"), 0);
  #assert coaxial_kit_clip(s) == WG_CODE.count;
  coaxial_kit_clip_done(s);
  #assert coaxial_kit_clip(s) == 0;
}

#test "everything enters, then stops; Replay enters it again; a size brings a frame" {
  h: [1] WgTest; s := h[0].s[..];
  n := coaxial_kit_frame(s, 0.016, false);
  #assert coaxial_kit_busy(s);
  d := s[0].dom[..];
  coaxial_kit_size(s, dm_find(d, "press.primary"), 96, 33);
  n = coaxial_kit_frame(s, 0.016, false);
  #assert dm_test_count(d, n, DC_FRAME) == 1;
  for k: 0..<40 { n = coaxial_kit_frame(s, 0.1, false); }
  #assert !coaxial_kit_busy(s) && coaxial_kit_frame(s, 0.016, false) == 0;
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "replay"), 0);
  n = coaxial_kit_frame(s, 0.016, false);
  #assert coaxial_kit_busy(s) && dm_test_count(d, n, DC_FRAME) == 1;
}
