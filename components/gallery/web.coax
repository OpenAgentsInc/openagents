// openagents.com/components: the frames set (components/kit/frames.coax) in
// the mono skin, drawn by the browser through the browser backend
// (components/backend/dom.coax). Every component is on the page and works:
// buttons count their presses, the composer sends, a tool call opens, rows
// and the menu pick, a notice's buttons answer, Replay enters everything
// again. docs/audits/2026-11-11-chat-zero-base-audit.md, sections 10 and 11.
//
// The page builds its tree only when something changed or is still
// entering, and the backend sends only what differs, so a still page does no
// work. The host (coax/web/dom-host.js) applies the commands and reports
// presses, typing and framed nodes' sizes.
//   coax/bin/coax test components/gallery/web.coax

#load "../kit/dock.coax";
#load "../kit/settings.coax";
#load "../kit/work.coax";
#load "../kit/listing.coax";
#load "../kit/apps-sdk.coax";
#load "../backend/dom.coax";

WG_INBOX :: 4096;      // a press's or a field's text from the host
WG_DRAFT :: 1024;
WG_SENT :: 4;          // messages the composer has sent, kept
WG_CSS :: 98304;
WG_AS_SNIPPET :: "#load \"components/kit/apps-sdk.coax\";\n\n_ = as_card_open(t, \"card\", \"Cloud\", \"Live\");\n_ = as_button(t, \"run\", \"Start\", AS_PRIMARY,\n  AS_SOLID, AS_MD, true, IC_PLAY, false, false);\nas_card_end(t);";
WG_AS_TARGETS :: [3] string.["Cloud", "Sandbox", "Local"];
WG_AS_TARGET_DESC :: [3] string.["Managed OpenAgents Cloud runners with instant SSE sync.", "Isolated GCE container VM with GitHub repo workspace.", "Your enrolled Mac or Linux workstation over local daemon."];
WG_AS_MODELS :: [3] string.["Gemini 4 Neon", "Claude Opus 5.5", "Inkling 2 Mini (Local)"];
WG_AS_RADIOS :: [3] string.["Lightning (sats)", "Promo credit first", "Card top-up"];
WG_AS_RADIO_DESC :: [3] string.["Instant settlement with 1% referral kickback.", "Spend eligible promotional credit up to $5/UTC day.", "Auto-refill when balance drops below threshold."];
WG_AS_TAGS_CAP :: 6;
WG_AS_TAG_LEN :: 24;
WG_DIALOG_CANCEL :: 18;
WG_CLICK :: 1; WG_INPUT :: 2; WG_SUBMIT :: 3;
WG_ROWS :: [3] string.["Zero-base the chat", "Why the runner ran out of memory", "Port the frames to SVG"];
WG_ROW_META :: [3] string.["Opus 5.5 · Nov 11 21:40", "Sonnet 5.5 · Nov 11 14:02", "Haiku 5.5 · Nov 10 09:15"];
WG_THINGS :: [3] string.["Cargo crate", "Parked rover", "Crab-bot"];
WG_MODELS :: [3] string.["Opus 5.5", "Sonnet 5.5", "Haiku 5.5"];
WG_MODEL_NOTES :: [3] string.["For complex work", "For everyday tasks", "Fastest for quick answers"];
WG_ANSWER :: "The page reads `/api/chat/state` every **2 seconds** and rebuilds the whole transcript from it. Three things follow:\n\n- an answer appears only when its turn ends\n- a stopped turn loses what was written\n- nothing marks where a long chat was cut\n\nThe fix is on the server first: keep each line of the session record, then stream it. See [the audit](/docs/audits/2026-11-11-chat-zero-base-audit.md).\n\n| Limit | Value |\n| --- | --- |\n| Turns sent | 40 |\n| Tools a turn | 12 |";
// What a refused tool call got back, as the realm CLI says it in words.
WG_REFUSED :: "refused (edit-refused; a retry won't help): foe 2 has no route for the dusk patrol\nrev 5, nothing was saved";
WG_CODE :: "dm_flush :: (d: [] Dom, t: [] Tree, sets: [] AfSettings) -> int {\n  // compare the tree with what was last sent, by id\n  // write only what changed\n}";

WebPage :: struct {
  ready: bool; time: f32; dirty: bool; animating: bool;
  as_presses: int;
  as_pill: bool;
  as_busy: bool;
  as_alert_gone: bool;
  as_invalid: bool;
  as_sw: [2] bool;
  as_chk: [2] bool;
  as_seg: int;
  as_copied: bool;
  as_key_copied: bool;
  as_radio: int;
  as_slider: int;
  as_sel_open: bool;
  as_sel_idx: int;
  as_tags: [WG_AS_TAGS_CAP] [WG_AS_TAG_LEN] u8;
  as_tag_n: [WG_AS_TAGS_CAP] int;
  as_ntags: int;
  as_tag_draft: [WG_AS_TAG_LEN] u8;
  as_tag_draft_n: int;
  as_cal_day: int;
  as_range_preset: int;
  as_pop_open: bool;
  as_menu_open: bool;
  as_menu_last: int;
  as_tip_open: bool;
  as_dialog_open: bool;
  as_tab: int;
  as_sb: int;
  as_chip_pick: int;
  presses: int;
  tool_open: bool;
  work: [4] bool;                    // the work log's run, group, refused row and its Show all are open
  row: int; model: int; thing: int; grouped: [3] bool;
  radius: int = 2;   // the dock's stepper: which of its five steps it stands at
  lit: [2] bool;     // the dock's switch rows: which of the two are on
  switched: bool = true;   // the settings page's switch
  section: int;            // the settings page's section shown
  answer: int;                       // the approval notice: 0 not answered, 1 allowed, 2 denied
  draft: [WG_DRAFT] u8; draft_n: int;
  sent: [WG_SENT] [WG_DRAFT] u8; sent_n: [WG_SENT] int; nsent: int;
  clip: [WG_DRAFT] u8; clip_n: int;  // text for the host to copy, until it has
  inbox: [WG_INBOX] u8;
  sets: [MF_COUNT] AfSettings;
  css: [WG_CSS] u8;
  ui: [1] Ui;
  doc: [1] MdDoc;
  tree: [1] Tree;
  dom: [1] Dom;
}

wg_section :: (t: [] Tree, id: string, title: string, note: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  i := tr_open(t, id, TG_SECTION, "sec");
  h := tr_leaf(t, tr_cat(ida[..], id, ".h"), TG_H2, "sec-h", title);
  if note.count > 0 { n := tr_leaf(t, tr_cat(idb[..], id, ".n"), TG_P, "sec-n", note); }
  return i;
}

wg_as_section :: (t: [] Tree, id: string, title: string, sub: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8;
  i := tr_open(t, id, TG_SECTION, "as-sec");
  _ = tr_open(t, tr_cat(ida[..], id, ".hd"), TG_DIV, "as-sec-head");
  _ = tr_leaf(t, tr_cat(idb[..], id, ".h"), TG_H2, "as-h2", title);
  if sub.count > 0 { _ = tr_leaf(t, tr_cat(idc[..], id, ".s"), TG_P, "as-sub", sub); }
  tr_close(t);
  return i;
}

wg_as_swatch :: (t: [] Tree, id: string, chip_cls: string, name: string, value: string) {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8;
  _ = tr_open(t, id, TG_DIV, "as-swatch");
  _ = tr_open(t, tr_cat(ida[..], id, ".c"), TG_DIV, chip_cls);
  tr_close(t);
  _ = tr_leaf(t, tr_cat(idb[..], id, ".n"), TG_SPAN, "as-swatch-n", name);
  _ = tr_leaf(t, tr_cat(idc[..], id, ".v"), TG_SPAN, "as-swatch-v", value);
  tr_close(t);
}

wg_as_showcase :: (s: [] WebPage) {
  t := s[0].tree[..];
  buf: [UI_ID] u8; buf2: [UI_ID] u8;
  pill := s[0].as_pill;
  busy := s[0].as_busy;

  _ = tr_open(t, "as.root", TG_DIV, "as-root");

  // Hero
  _ = tr_open(t, "as.hero", TG_HEADER, "as-hero");
  _ = tr_open(t, "as.hero.top", TG_DIV, "as-hero-top");
  _ = tr_open(t, "as.hero.badges", TG_DIV, "as-row");
  _ = as_badge(t, "as.hero.b0", "Dark Mode", AS_DISCOVERY, AS_SOFT, AS_MD, true, false);
  _ = as_badge(t, "as.hero.b1", "Coax DOM Kit", AS_INFO, AS_SOFT, AS_MD, true, false);
  _ = as_badge(t, "as.hero.b2", "755 SVG Icons", AS_SUCCESS, AS_SOFT, AS_MD, true, true);
  tr_close(t);
  _ = tr_open(t, "as.hero.links", TG_DIV, "as-row");
  _ = as_link(t, "as.hero.mono", "Mono Frames ↓", "#mono-frames", false);
  _ = as_link(t, "as.hero.gpu", "GPU + motion →", "/components-gpu", false);
  tr_close(t);
  tr_close(t);
  _ = tr_leaf(t, "as.h1", TG_H1, "as-h1", "Apps SDK UI · Coax Components");
  _ = tr_leaf(t, "as.lede", TG_P, "as-lede", "Dark-mode primitives powering OpenAgents Web (components/skin/apps-sdk.coax and components/kit/apps-sdk.coax). Compiled Coax WebAssembly renders real semantic DOM with zero WebGPU overhead.");
  tr_close(t);

  // 1. Buttons & Icon Buttons
  _ = wg_as_section(t, "as.buttons", "Buttons", "Solid, soft, outline, and ghost variants across semantic colors, sizes, pills, icon-only, and loading states.");
  _ = tr_open(t, "as.buttons.bar", TG_DIV, "as-demo-bar");
  _ = tr_leaf(t, "as.btn.count", TG_SPAN, "as-sub", tr_cat(buf2[..], tr_join(buf[..], "Interactive clicks: ", s[0].as_presses), ifx pill then " · Pill ON" else " · Rounded"));
  _ = tr_open(t, "as.buttons.toggles", TG_DIV, "as-row");
  _ = as_button(t, "as.btn.pill", ifx pill then "Pill: On" else "Pill: Off", AS_SECONDARY, AS_OUTLINE, AS_SM, pill, IC_SPARKLES, false, false);
  _ = as_button(t, "as.btn.busy", ifx busy then "Stop loading" else "Test loading", AS_INFO, AS_SOFT, AS_SM, pill, IC_BOLT, false, false);
  tr_close(t);
  tr_close(t);

  _ = tr_open(t, "as.buttons.solid", TG_DIV, "as-row");
  _ = as_button(t, "as.btn.primary", "Start session", AS_PRIMARY, AS_SOLID, AS_MD, pill, IC_PLAY, false, busy);
  _ = as_button(t, "as.btn.secondary", "New project", AS_SECONDARY, AS_SOLID, AS_MD, pill, IC_PLUS, false, false);
  _ = as_button(t, "as.btn.info", "Connect GitHub", AS_INFO, AS_SOLID, AS_MD, pill, IC_LINK, false, false);
  _ = as_button(t, "as.btn.success", "Deploy live", AS_SUCCESS, AS_SOLID, AS_MD, pill, IC_CHECK, false, false);
  _ = as_button(t, "as.btn.warning", "Retry", AS_WARNING, AS_SOLID, AS_MD, pill, IC_WARNING, false, false);
  _ = as_button(t, "as.btn.danger", "Delete", AS_DANGER, AS_SOLID, AS_MD, pill, IC_TRASH, false, false);
  _ = as_button(t, "as.btn.discovery", "Upgrade", AS_DISCOVERY, AS_SOLID, AS_MD, pill, IC_SPARKLES, false, false);
  tr_close(t);

  _ = tr_open(t, "as.buttons.soft", TG_DIV, "as-row");
  _ = as_button(t, "as.btn.soft.pri", "Soft primary", AS_PRIMARY, AS_SOFT, AS_MD, pill, -1, false, false);
  _ = as_button(t, "as.btn.soft.info", "Soft info", AS_INFO, AS_SOFT, AS_MD, pill, IC_INFO, false, false);
  _ = as_button(t, "as.btn.soft.ok", "Soft success", AS_SUCCESS, AS_SOFT, AS_MD, pill, IC_CHECK_CIRCLE, false, false);
  _ = as_button(t, "as.btn.soft.err", "Soft danger", AS_DANGER, AS_SOFT, AS_MD, pill, IC_ERROR, false, false);
  _ = as_button(t, "as.btn.out.pri", "Outline", AS_PRIMARY, AS_OUTLINE, AS_MD, pill, -1, false, false);
  _ = as_button(t, "as.btn.out.info", "Outline info", AS_INFO, AS_OUTLINE, AS_MD, pill, -1, false, false);
  _ = as_button(t, "as.btn.ghost", "Ghost", AS_SECONDARY, AS_GHOST, AS_MD, pill, IC_SETTINGS, false, false);
  _ = as_button(t, "as.btn.off", "Disabled", AS_PRIMARY, AS_SOLID, AS_MD, pill, -1, true, false);
  tr_close(t);

  _ = tr_open(t, "as.buttons.sizes", TG_DIV, "as-row");
  _ = as_button(t, "as.btn.sm", "Small", AS_SECONDARY, AS_OUTLINE, AS_SM, pill, -1, false, false);
  _ = as_button(t, "as.btn.md", "Medium", AS_SECONDARY, AS_OUTLINE, AS_MD, pill, -1, false, false);
  _ = as_button(t, "as.btn.lg", "Large", AS_SECONDARY, AS_OUTLINE, AS_LG, pill, -1, false, false);
  _ = as_button(t, "as.btn.xl", "Extra large", AS_PRIMARY, AS_SOLID, AS_XL, pill, IC_ARROW_RIGHT, false, false);
  _ = as_icon_button(t, "as.ib.copy", IC_COPY, "Copy", AS_SECONDARY, AS_OUTLINE, AS_MD, pill, false);
  _ = as_icon_button(t, "as.ib.search", IC_SEARCH, "Search", AS_SECONDARY, AS_SOFT, AS_MD, pill, false);
  _ = as_icon_button(t, "as.ib.set", IC_SETTINGS, "Settings", AS_SECONDARY, AS_GHOST, AS_MD, pill, false);
  _ = as_icon_button(t, "as.ib.del", IC_TRASH, "Delete", AS_DANGER, AS_SOFT, AS_MD, pill, false);
  tr_close(t);
  tr_close(t);

  // 2. Badges & Avatars
  _ = wg_as_section(t, "as.badges", "Badges & Avatars", "Compact status indicators and user/agent presence avatars.");
  _ = tr_open(t, "as.badges.grid", TG_DIV, "as-grid2");
  _ = as_card_open(t, "as.badges.card", "Badges", "Soft · Solid · Outline · Status dot");
  _ = tr_open(t, "as.badges.r1", TG_DIV, "as-row");
  _ = as_badge(t, "as.bg.live", "Connected", AS_SUCCESS, AS_SOFT, AS_MD, true, true);
  _ = as_badge(t, "as.bg.sync", "Syncing", AS_INFO, AS_SOFT, AS_MD, true, true);
  _ = as_badge(t, "as.bg.warn", "Sandbox idle", AS_WARNING, AS_SOFT, AS_MD, true, true);
  _ = as_badge(t, "as.bg.caut", "Rate limit", AS_CAUTION, AS_SOFT, AS_MD, false, false);
  _ = as_badge(t, "as.bg.err", "Offline", AS_DANGER, AS_SOFT, AS_MD, true, true);
  _ = as_badge(t, "as.bg.disc", "v1.0.0", AS_DISCOVERY, AS_SOFT, AS_MD, true, false);
  tr_close(t);
  _ = tr_open(t, "as.badges.r2", TG_DIV, "as-row");
  _ = as_badge(t, "as.bg.s0", "Primary", AS_PRIMARY, AS_SOLID, AS_SM, false, false);
  _ = as_badge(t, "as.bg.s1", "Cloud", AS_INFO, AS_SOLID, AS_SM, false, false);
  _ = as_badge(t, "as.bg.s2", "Paid", AS_SUCCESS, AS_SOLID, AS_SM, false, false);
  _ = as_badge(t, "as.bg.o0", "Outline", AS_SECONDARY, AS_OUTLINE, AS_MD, false, false);
  _ = as_badge(t, "as.bg.o1", "Promo", AS_DISCOVERY, AS_OUTLINE, AS_MD, true, false);
  tr_close(t);
  as_card_end(t);

  _ = as_card_open(t, "as.avatars.card", "Avatars & Presence", "Sizes · Shapes · Stacked group");
  _ = tr_open(t, "as.av.r1", TG_DIV, "as-row");
  _ = as_avatar(t, "as.av.sm", "OA", AS_PRIMARY, AS_SOLID, AS_SM, false, false);
  _ = as_avatar(t, "as.av.md", "CD", AS_INFO, AS_SOFT, AS_MD, false, true);
  _ = as_avatar(t, "as.av.lg", "AG", AS_DISCOVERY, AS_SOFT, AS_LG, false, true);
  _ = as_avatar(t, "as.av.sq", "VM", AS_SUCCESS, AS_SOFT, AS_LG, true, false);
  _ = as_avatar_group_open(t, "as.av.grp");
  _ = as_avatar(t, "as.av.g0", "CD", AS_INFO, AS_SOLID, AS_MD, false, false);
  _ = as_avatar(t, "as.av.g1", "OA", AS_DISCOVERY, AS_SOLID, AS_MD, false, false);
  _ = as_avatar(t, "as.av.g2", "WK", AS_WARNING, AS_SOFT, AS_MD, false, false);
  _ = as_avatar(t, "as.av.g3", "+4", AS_SECONDARY, AS_SOFT, AS_MD, false, false);
  as_avatar_group_end(t);
  tr_close(t);
  as_card_end(t);
  tr_close(t);
  tr_close(t);

  // 3. Alerts
  _ = wg_as_section(t, "as.alerts", "Alerts", "Semantic feedback banners with accessible alert semantics and actions.");
  _ = tr_open(t, "as.alerts.col", TG_DIV, "as-col");
  if !s[0].as_alert_gone {
    _ = as_alert_open(t, "as.al.info", "Cloud sandbox ready", "GCE container runner is warmed and syncing with your GitHub workspace.", AS_INFO, AS_SOFT, IC_INFO);
    _ = tr_open(t, "as.al.info.act", TG_DIV, "as-alert-act");
    _ = as_button(t, "as.alert.dismiss", "Dismiss", AS_INFO, AS_GHOST, AS_SM, false, IC_X_CROSSED, false, false);
    tr_close(t);
    as_alert_end(t);
  } else {
    _ = tr_open(t, "as.al.rest.row", TG_DIV, "as-row");
    _ = tr_leaf(t, "as.al.rest.msg", TG_SPAN, "as-sub", "Info alert dismissed.");
    _ = as_button(t, "as.alert.restore", "Restore alert", AS_SECONDARY, AS_OUTLINE, AS_SM, false, -1, false, false);
    tr_close(t);
  }
  _ = as_alert_open(t, "as.al.ok", "Referral credit unlocked", "$10.00 promotional credit applied after your first qualifying paid top-up.", AS_SUCCESS, AS_SOFT, IC_CHECK_CIRCLE);
  as_alert_end(t);
  _ = as_alert_open(t, "as.al.warn", "Approaching daily spend limit", "You have used 85% of your configured Cloud sandbox allowance.", AS_WARNING, AS_SOFT, IC_WARNING);
  as_alert_end(t);
  _ = as_alert_open(t, "as.al.err", "Session token expired", "Sign in again with your passkey or email code to resume syncing.", AS_DANGER, AS_SOFT, IC_ERROR);
  as_alert_end(t);
  tr_close(t);
  tr_close(t);

  // 4. Forms & Selection Controls
  _ = wg_as_section(t, "as.forms", "Forms & Selection Controls", "Real browser inputs, validation states, switches, checkboxes, and segmented controls.");
  _ = tr_open(t, "as.forms.grid", TG_DIV, "as-grid2");

  _ = as_card_open(t, "as.form.card", "Inputs & Textarea", "Outline · Soft · Pill · Validation");
  _ = as_field_open(t, "as.f.search", "Repository filter");
  _ = as_input(t, "as.in.search", "Search repositories or threads…", "search", AS_OUTLINE, AS_LG, true, IC_SEARCH, false, false);
  as_field_end(t, "as.f.search", "Matches GitHub repos linked via WorkOS Pipes.", false);

  _ = as_field_open(t, "as.f.email", "Invite email");
  _ = as_input(t, "as.in.email", "teammate@openagents.com", "email", AS_OUTLINE, AS_LG, false, IC_MAIL, s[0].as_invalid, false);
  as_field_end(t, "as.f.email", ifx s[0].as_invalid then "Enter a valid work or personal email address." else "They receive $10 promo credit after their first paid top-up.", s[0].as_invalid);

  _ = as_field_open(t, "as.f.notes", "System instructions");
  _ = as_textarea(t, "as.ta.notes", "Describe repository conventions, build targets, or verification commands…", "3", AS_SOFT, false, false);
  as_field_end(t, "as.f.notes", "", false);

  _ = tr_open(t, "as.form.acts", TG_DIV, "as-row");
  _ = as_button(t, "as.form.invalid", ifx s[0].as_invalid then "Clear error" else "Toggle validation error", AS_DANGER, AS_SOFT, AS_SM, false, -1, false, false);
  tr_close(t);
  as_card_end(t);

  _ = as_card_open(t, "as.sel.card", "Selection Controls", "Switch · Checkbox · Segmented");
  _ = as_switch(t, "as.sw.0", "Auto-sync across Web, iOS, and Desktop", "Stream thread deltas in real time over SSE.", s[0].as_sw[0], false);
  _ = as_switch(t, "as.sw.1", "Auto-start Cloud sandbox on repo attach", "Provision a fresh container VM when a repo is picked.", s[0].as_sw[1], false);
  _ = as_divider(t, "as.sel.div1");
  _ = as_checkbox(t, "as.chk.0", "Include verification screenshots in handoff", "Attach headless capture artifacts automatically.", s[0].as_chk[0], false);
  _ = as_checkbox(t, "as.chk.1", "Require explicit approval before git push", "Pause and prompt before pushing to origin/main.", s[0].as_chk[1], false);
  _ = as_divider(t, "as.sel.div2");
  _ = tr_leaf(t, "as.seg.lbl", TG_SPAN, "as-label", "Execution target");
  _ = as_seg_open(t, "as.seg", "Execution target", AS_MD, true);
  targets := WG_AS_TARGETS;
  ticons := [3] int.[IC_GLOBE, IC_SHIELD_CHECK, IC_TERMINAL];
  for k: 0..<3 { _ = as_seg_item(t, tr_join(buf[..], "as.seg.", k), targets[k], ticons[k], k == s[0].as_seg); }
  as_seg_end(t);
  descs := WG_AS_TARGET_DESC;
  _ = tr_leaf(t, "as.seg.desc", TG_P, "as-sub", descs[s[0].as_seg]);
  as_card_end(t);

  tr_close(t);
  tr_close(t);

  // 5. Complete Forms (RadioGroup, Slider, SelectControl, TagInput, DatePicker & DateRangePicker)
  _ = wg_as_section(t, "as.forms2", "RadioGroup, Slider, Select, TagInput & Dates", "Every Apps SDK UI form primitive with live interactive state.");
  _ = tr_open(t, "as.forms2.grid", TG_DIV, "as-grid2");

  _ = as_card_open(t, "as.rad.card", "RadioGroup & Slider", "Billing preference · Spend limit");
  _ = as_radio_group_open(t, "as.rg", "Billing preference", false);
  rnames := WG_AS_RADIOS; rdescs := WG_AS_RADIO_DESC;
  for k: 0..<3 { _ = as_radio_item(t, tr_join(buf[..], "as.rg.", k), rnames[k], rdescs[k], k == s[0].as_radio, false); }
  as_radio_group_end(t);
  _ = as_divider(t, "as.rad.div");
  sv_buf: [16] u8; sp_buf: [16] u8; sn_buf: [16] u8;
  sv := tr_cat(sv_buf[..], "$", tr_join(sn_buf[..], "", s[0].as_slider));
  sp := tr_join(sp_buf[..], "", s[0].as_slider);
  _ = as_slider(t, "as.sl", "Daily sandbox budget", sv, "0", "100", "5", sp, sp);
  as_card_end(t);

  _ = as_card_open(t, "as.sel2.card", "Select, TagInput & Date Pickers", "Dropdown · Removable tags · Calendar");
  models_as := WG_AS_MODELS;
  _ = as_field_open(t, "as.f.model", "Default model");
  _ = as_select_open(t, "as.sel", models_as[s[0].as_sel_idx], s[0].as_sel_open);
  if s[0].as_sel_open {
    for k: 0..<3 { _ = as_select_option(t, tr_join(buf[..], "as.sel.", k), models_as[k], k == s[0].as_sel_idx); }
  }
  as_select_end(t, s[0].as_sel_open);
  as_field_end(t, "as.f.model", "", false);

  _ = as_field_open(t, "as.f.tags", "Workspace tags");
  _ = as_tag_input_open(t, "as.tags");
  for k: 0..<s[0].as_ntags {
    _ = as_tag_chip(t, tr_join(buf[..], "as.tag.", k), cast(string) s[0].as_tags[k][0..<s[0].as_tag_n[k]]);
  }
  as_tag_input_end(t, "as.tags.in", "Add tag + Enter…");
  as_field_end(t, "as.f.tags", "Click × to remove or type a label and press Enter.", false);

  _ = as_field_open(t, "as.f.dates", "DatePicker & DateRangePicker");
  _ = tr_open(t, "as.date.row", TG_DIV, "as-date-row");
  _ = as_date_input(t, "as.dt.start", ifx s[0].as_range_preset == 0 then "2026-11-23" else ifx s[0].as_range_preset == 1 then "2026-10-31" else "2026-09-01", "Start date");
  _ = tr_leaf(t, "as.dt.to", TG_SPAN, "as-sub", "→");
  _ = as_date_input(t, "as.dt.end", "2026-11-30", "End date");
  _ = as_button(t, "as.rng.0", "7d", ifx s[0].as_range_preset == 0 then AS_PRIMARY else AS_SECONDARY, ifx s[0].as_range_preset == 0 then AS_SOLID else AS_OUTLINE, AS_SM, true, -1, false, false);
  _ = as_button(t, "as.rng.1", "30d", ifx s[0].as_range_preset == 1 then AS_PRIMARY else AS_SECONDARY, ifx s[0].as_range_preset == 1 then AS_SOLID else AS_OUTLINE, AS_SM, true, -1, false, false);
  _ = as_button(t, "as.rng.2", "90d", ifx s[0].as_range_preset == 2 then AS_PRIMARY else AS_SECONDARY, ifx s[0].as_range_preset == 2 then AS_SOLID else AS_OUTLINE, AS_SM, true, -1, false, false);
  tr_close(t);
  _ = tr_open(t, "as.cal", TG_DIV, "as-cal");
  _ = tr_open(t, "as.cal.hd", TG_DIV, "as-cal-hd");
  _ = tr_leaf(t, "as.cal.m", TG_SPAN, "", "November 2026");
  _ = as_badge(t, "as.cal.day.b", tr_join(buf[..], "Nov ", s[0].as_cal_day), AS_INFO, AS_SOFT, AS_SM, true, false);
  tr_close(t);
  _ = tr_open(t, "as.cal.g", TG_DIV, "as-cal-grid");
  dows := [7] string.["S", "M", "T", "W", "T", "F", "S"];
  for d: 0..<7 { _ = tr_leaf(t, tr_join(buf[..], "as.cal.w.", d), TG_SPAN, "as-cal-dow", dows[d]); }
  for d: 22..<31 {
    day_s: [8] u8;
    db := tr_leaf(t, tr_join(buf[..], "as.cal.d.", d), TG_BUTTON, "as-cal-day", tr_join(day_s[..], "", d));
    tr_attr(t, db, AT_TYPE, "button");
    if d == s[0].as_cal_day || d == 30 { tr_attr(t, db, AT_SELECTED, "true"); }
    else if d > s[0].as_cal_day && d < 30 { tr_attr(t, db, AT_STATE, "range"); }
  }
  tr_close(t);
  tr_close(t);
  as_field_end(t, "as.f.dates", "", false);
  as_card_end(t);
  tr_close(t);
  tr_close(t);

  // 6. Overlays (Popover, Menu, Tooltip, Modal Dialog)
  _ = wg_as_section(t, "as.overlays", "Overlays (Popover, Menu, Tooltip & Dialog)", "Anchored floating surfaces, action menus with keyboard shortcuts, tooltips, and native modal <dialog>.");
  _ = as_card_open(t, "as.ov.card", "Interactive Overlays", "Click triggers to open live surfaces");
  _ = tr_open(t, "as.ov.row", TG_DIV, "as-row");

  // Popover
  _ = as_popover_open(t, "as.pop");
  _ = as_button(t, "as.pop.trig", ifx s[0].as_pop_open then "Close Popover" else "Open Popover", AS_SECONDARY, AS_OUTLINE, AS_MD, pill, IC_INFO, false, false);
  if s[0].as_pop_open {
    _ = as_popover_panel_open(t, "as.pop.panel");
    _ = tr_leaf(t, "as.pop.t", TG_H3, "as-h3", "Cloud Sandbox Quota");
    _ = tr_leaf(t, "as.pop.d", TG_P, "as-sub", "2 of 4 container slots active · 72% daily budget remaining.");
    _ = as_progress_bar(t, "as.pop.pb", "72");
    _ = as_button(t, "as.pop.ok", "Done", AS_PRIMARY, AS_SOLID, AS_SM, true, -1, false, false);
  }
  as_popover_end(t, s[0].as_pop_open);

  // Menu
  _ = as_popover_open(t, "as.menu.wrap");
  _ = as_button(t, "as.menu.trig", ifx s[0].as_menu_open then "Close Menu" else "Actions Menu", AS_SECONDARY, AS_SOFT, AS_MD, pill, IC_CHEVRON_DOWN, false, false);
  if s[0].as_menu_open {
    _ = as_menu_panel_open(t, "as.menu.panel", "Thread actions");
    _ = as_menu_item(t, "as.menu.0", "Duplicate thread", IC_COPY, "⌘D", false);
    _ = as_menu_item(t, "as.menu.1", "Open in Desktop", IC_TERMINAL, "⌘O", false);
    _ = as_menu_item(t, "as.menu.2", "Share referral link", IC_LINK, "⇧⌘C", false);
    _ = as_menu_sep(t, "as.menu.sep");
    _ = as_menu_item(t, "as.menu.3", "Delete thread", IC_TRASH, "⌫", true);
    tr_close(t);
  }
  tr_close(t);

  // Tooltip
  _ = as_tooltip_open(t, "as.tip");
  _ = as_button(t, "as.tip.btn", "Hover or Pin Tooltip", AS_SECONDARY, AS_OUTLINE, AS_MD, pill, IC_SPARKLES, false, false);
  as_tooltip_end(t, "as.tip", "Synced live via Coax SSE · ⌘K to search", s[0].as_tip_open);

  // Native Modal Dialog trigger
  _ = as_button(t, "as.dlg.open", "Open Modal Dialog", AS_PRIMARY, AS_SOLID, AS_MD, pill, IC_PLAY, false, false);

  // ButtonLink + CopyButton + Kbd
  _ = as_button_link(t, "as.btn.link", "ButtonLink →", "/books", AS_INFO, AS_SOFT, AS_MD, pill, IC_GLOBE);
  _ = as_copy_button(t, "as.cp.btn", "Copy API Key", s[0].as_key_copied, AS_OUTLINE, AS_MD, pill);
  _ = as_kbd(t, "as.kbd.0", "⌘K");
  tr_close(t);

  if s[0].as_menu_last > 0 {
    m_acts := [4] string.["Duplicated thread.", "Opened in Desktop.", "Copied referral link.", "Delete confirmed."];
    _ = tr_leaf(t, "as.menu.said", TG_P, "as-sub", m_acts[s[0].as_menu_last - 1]);
  }
  as_card_end(t);

  if s[0].as_dialog_open {
    _ = as_dialog_open(t, "as.dlg", "Deploy to OpenAgents Production?", "as.dlg.close");
    _ = tr_leaf(t, "as.dlg.p", TG_P, "", "This uses a native <dialog> promoted via showModal() in dom-host.js with backdrop blur and Escape cancellation.");
    _ = as_alert_open(t, "as.dlg.al", "Canary rollout enabled", "All 6 shards will verify before switching traffic.", AS_INFO, AS_SOFT, IC_SHIELD_CHECK);
    as_alert_end(t);
    _ = as_dialog_footer_open(t, "as.dlg.ft");
    _ = as_button(t, "as.dlg.cancel", "Cancel", AS_SECONDARY, AS_GHOST, AS_MD, false, -1, false, false);
    _ = as_button(t, "as.dlg.ok", "Confirm deploy", AS_PRIMARY, AS_SOLID, AS_MD, true, IC_CHECK, false, false);
    as_dialog_end(t);
  }
  tr_close(t);

  // 7. Indicators, Media, Breadcrumb, Tabs, Table, Prose, Source, LinkCard & Activity
  _ = wg_as_section(t, "as.surfaces", "Content, Indicators, Tabs, Table & Media", "CircularProgress, LoadingDots, ProgressBar, Image, Breadcrumb, Tabs, Data Table, Prose, Source chips, LinkCards, Activity steps, CodeBlock, and EmptyMessage.");
  _ = tr_open(t, "as.surf.grid", TG_DIV, "as-grid2");

  _ = as_card_open(t, "as.stream.card", "Indicators, Progress & Code", "Spinner · LoadingDots · CircularProgress · Shimmer");
  _ = tr_open(t, "as.ind.row", TG_DIV, "as-row");
  _ = as_spinner(t, "as.sp.sm", false);
  _ = as_spinner(t, "as.sp.lg", true);
  _ = as_loading_dots(t, "as.ld.0");
  _ = as_progress_ring(t, "as.pr.0", "35", "35%", AS_INFO);
  _ = as_progress_ring(t, "as.pr.1", "72", "72%", AS_DISCOVERY);
  _ = as_progress_ring(t, "as.pr.2", "100", "100%", AS_SUCCESS);
  tr_close(t);
  _ = as_progress_bar(t, "as.pb.0", "68");
  _ = as_shimmer(t, "as.sh.0", "Compiling Coax component tree and syncing workspace…");
  _ = as_breadcrumb_open(t, "as.bc", "Breadcrumb");
  _ = as_breadcrumb_item(t, "as.bc.0", "OpenAgents", "/", false, false);
  _ = as_breadcrumb_item(t, "as.bc.1", "Design System", "/components", false, true);
  _ = as_breadcrumb_item(t, "as.bc.2", "Apps SDK UI", "", true, true);
  as_breadcrumb_end(t);
  _ = as_code(t, "as.code", "coax", WG_AS_SNIPPET, s[0].as_copied);
  as_card_end(t);

  _ = as_card_open(t, "as.tabs.card", "Tabs, Prose, Table & Activity", "Interactive tabbed content panel");
  _ = as_tabs_open(t, "as.tabs", "Content views");
  _ = as_tab(t, "as.tab.0", "Table", IC_CODE, s[0].as_tab == 0);
  _ = as_tab(t, "as.tab.1", "Prose & Sources", IC_INFO, s[0].as_tab == 1);
  _ = as_tab(t, "as.tab.2", "Activity & Media", IC_TERMINAL, s[0].as_tab == 2);
  as_tabs_end(t);

  if s[0].as_tab == 0 {
    _ = tr_open(t, "as.tbl.w", TG_DIV, "as-tbl-wrap");
    _ = tr_open(t, "as.tbl", TG_TABLE, "as-tbl");
    _ = tr_open(t, "as.tbl.hr", TG_TR, "");
    _ = tr_leaf(t, "as.tbl.h0", TG_TH, "", "Surface");
    _ = tr_leaf(t, "as.tbl.h1", TG_TH, "", "Runtime");
    _ = tr_leaf(t, "as.tbl.h2", TG_TH, "", "Status");
    tr_close(t);
    _ = tr_open(t, "as.tbl.r0", TG_TR, "");
    _ = tr_leaf(t, "as.tbl.r0.0", TG_TD, "", "OpenAgents Web");
    _ = tr_leaf(t, "as.tbl.r0.1", TG_TD, "", "Coax WASM DOM");
    _ = tr_open(t, "as.tbl.r0.2", TG_TD, ""); _ = as_badge(t, "as.tbl.b0", "Live", AS_SUCCESS, AS_SOFT, AS_SM, true, true); tr_close(t);
    tr_close(t);
    _ = tr_open(t, "as.tbl.r1", TG_TR, "");
    _ = tr_leaf(t, "as.tbl.r1.0", TG_TD, "", "OpenAgents iOS");
    _ = tr_leaf(t, "as.tbl.r1.1", TG_TD, "", "Coax Metal Cloud");
    _ = tr_open(t, "as.tbl.r1.2", TG_TD, ""); _ = as_badge(t, "as.tbl.b1", "TestFlight", AS_INFO, AS_SOFT, AS_SM, true, true); tr_close(t);
    tr_close(t);
    _ = tr_open(t, "as.tbl.r2", TG_TR, "");
    _ = tr_leaf(t, "as.tbl.r2.0", TG_TD, "", "OpenAgents Desktop");
    _ = tr_leaf(t, "as.tbl.r2.1", TG_TD, "", "Coax Native Metal");
    _ = tr_open(t, "as.tbl.r2.2", TG_TD, ""); _ = as_badge(t, "as.tbl.b2", "Installed", AS_DISCOVERY, AS_SOFT, AS_SM, true, false); tr_close(t);
    tr_close(t);
    tr_close(t);
    tr_close(t);
  } else if s[0].as_tab == 1 {
    _ = tr_open(t, "as.prose", TG_DIV, "as-prose");
    _ = tr_leaf(t, "as.prose.h", TG_H4, "", "Composable dark-mode prose");
    _ = tr_open(t, "as.prose.p", TG_P, "");
    _ = tr_leaf(t, "as.prose.p0", TG_SPAN, "", "Every web surface shares ");
    _ = tr_leaf(t, "as.prose.p1", TG_CODE, "", "apps_sdk_css()");
    _ = tr_leaf(t, "as.prose.p2", TG_SPAN, "", " with zero inline styles and full keyboard/ARIA support.");
    tr_close(t);
    _ = tr_leaf(t, "as.prose.bq", TG_BLOCKQUOTE, "", "One shared Coax component kit across Chat, Settings, Projects, and Referrals.");
    tr_close(t);
    _ = tr_open(t, "as.sources", TG_DIV, "as-row");
    _ = as_source(t, "as.src.0", "docs/v1/web.md", "/books", IC_GLOBE);
    _ = as_source(t, "as.src.1", "components/kit/apps-sdk.coax", "/components", IC_CODE);
    tr_close(t);
    _ = as_link_card(t, "as.lc.0", "OpenAgents Books", "817 chapters across 9 engineering books", "/books", IC_ARROW_RIGHT);
  } else {
    _ = as_step_row(t, "as.st.0", IC_CHECK_CIRCLE, "Build kit.wasm", "238 KB · 1.6 s", "Passed", AS_SUCCESS);
    _ = as_step_row(t, "as.st.1", IC_TERMINAL, "Run 102 component checks", "26 ms · 0 lost nodes", "Passed", AS_SUCCESS);
    _ = as_image(t, "as.img.0", "/favicon.svg", "OpenAgents Emblem", "Responsive 16:9 media card with rounded frame and caption");
  }
  _ = tr_open(t, "as.stream.links", TG_DIV, "as-row");
  _ = as_link(t, "as.lk.books", "OpenAgents Books", "/books", false);
  _ = as_link(t, "as.lk.chat", "Open Cloud Chat", "/chat", true);
  tr_close(t);
  as_card_end(t);

  _ = as_empty_open(t, "as.empty", IC_FOLDER, "No cloud sandboxes running", "Pick a GitHub repository or start a session to spin up an isolated workspace container.");
  _ = as_button(t, "as.empty.cta", "Create workspace", AS_PRIMARY, AS_SOLID, AS_MD, true, IC_PLUS, false, false);
  as_empty_end(t);

  _ = as_card_open(t, "as.media.card", "Image & LinkCard", "Local-origin media + destination cards");
  _ = as_link_card(t, "as.lc.1", "Cloud Chat Workspace", "Synced threads, GitHub repos & GCE sandboxes", "/chat", IC_ARROW_RIGHT);
  _ = as_link_card(t, "as.lc.2", "GPU & Motion Gallery", "WebGPU shader primitives and spring physics", "/components-gpu", IC_SPARKLES);
  as_card_end(t);

  tr_close(t);
  tr_close(t);

  // 8. AppShell, Sidebar, Messages, SuggestionChips & Composer
  _ = wg_as_section(t, "as.shell", "AppShell, Sidebar, Thread & Composer", "The complete dark-mode chat shell composed from Apps SDK UI primitives.");
  _ = tr_open(t, "as.shell.demo", TG_DIV, "as-shell-demo");
  _ = tr_open(t, "as.sb", TG_NAV, "as-sidebar");
  tr_attr(t, tr_find(t, "as.sb"), AT_LABEL, "Demo sidebar");
  _ = tr_leaf(t, "as.sb.l0", TG_SPAN, "as-sb-lbl", "Workspace");
  _ = as_sidebar_item(t, "as.sb.0", IC_SPARKLES, "Cloud Chat", s[0].as_sb == 0);
  _ = as_sidebar_item(t, "as.sb.1", IC_FOLDER, "Projects", s[0].as_sb == 1);
  _ = as_sidebar_item(t, "as.sb.2", IC_GLOBE, "Worlds", s[0].as_sb == 2);
  _ = as_sidebar_item(t, "as.sb.3", IC_SETTINGS, "Settings", s[0].as_sb == 3);
  tr_close(t);

  _ = tr_open(t, "as.shell.main", TG_DIV, "as-shell-main");
  _ = tr_leaf(t, "as.msg.u0", TG_DIV, "as-msg-u", "Port every Apps SDK UI component to Coax in dark mode.");
  _ = tr_open(t, "as.msg.a0", TG_DIV, "as-msg-a");
  _ = tr_leaf(t, "as.msg.a0.p", TG_P, "", "Done — all Actions, Forms, Overlays, Content, and Shell components are now live in components/kit/apps-sdk.coax.");
  _ = tr_open(t, "as.chips", TG_DIV, "as-chips");
  chips := [3] string.["Inspect mobile parity", "Run cross-surface sync", "Deploy staging"];
  for k: 0..<3 { _ = as_suggestion_chip(t, tr_join(buf[..], "as.chip.", k), IC_SPARKLES, chips[k]); }
  tr_close(t);
  if s[0].as_chip_pick > 0 {
    _ = tr_leaf(t, "as.chip.said", TG_SPAN, "as-sub", tr_cat(buf[..], "Selected suggestion: ", chips[s[0].as_chip_pick - 1]));
  }
  tr_close(t);
  _ = tr_open(t, "as.comp", TG_DIV, "as-composer");
  ct := tr_open(t, "as.comp.in", TG_TEXTAREA, "");
  tr_attr(t, ct, AT_PLACEHOLDER, "Ask OpenAgents anything…");
  tr_attr(t, ct, AT_LABEL, "Demo composer");
  tr_attr(t, ct, AT_ROWS, "2");
  tr_close(t);
  _ = tr_open(t, "as.comp.ft", TG_DIV, "as-composer-ft");
  _ = tr_open(t, "as.comp.l", TG_DIV, "as-row");
  _ = as_icon_button(t, "as.comp.add", IC_PLUS, "Attach", AS_SECONDARY, AS_GHOST, AS_SM, true, false);
  _ = as_badge(t, "as.comp.m", models_as[s[0].as_sel_idx], AS_SECONDARY, AS_SOFT, AS_MD, true, false);
  tr_close(t);
  _ = as_icon_button(t, "as.comp.send", IC_ARROW_RIGHT, "Send message", AS_PRIMARY, AS_SOLID, AS_MD, true, false);
  tr_close(t);
  tr_close(t);
  tr_close(t);
  tr_close(t);
  tr_close(t);

  // 9. Dark-Mode Token Swatches
  _ = wg_as_section(t, "as.tokens", "Dark-Mode Design Tokens", "Obsidian surface ladder and WCAG AA semantic colors from components/skin/apps-sdk.coax.");
  _ = tr_open(t, "as.swatches", TG_DIV, "as-swatches");
  wg_as_swatch(t, "as.sw.s0", "as-swatch-chip as-sw-surface", "Surface", "#0d0d0d");
  wg_as_swatch(t, "as.sw.s1", "as-swatch-chip as-sw-surf2", "Secondary", "#161616");
  wg_as_swatch(t, "as.sw.s2", "as-swatch-chip as-sw-elev", "Elevated", "#1c1c1c");
  wg_as_swatch(t, "as.sw.s3", "as-swatch-chip as-sw-elev2", "Elevated 2", "#282828");
  wg_as_swatch(t, "as.sw.t0", "as-swatch-chip as-sw-text", "Text", "#ffffff");
  wg_as_swatch(t, "as.sw.t1", "as-swatch-chip as-sw-text2", "Text Muted", "#afafaf");
  wg_as_swatch(t, "as.sw.c0", "as-swatch-chip as-sw-info", "Info", "#0285ff");
  wg_as_swatch(t, "as.sw.c1", "as-swatch-chip as-sw-success", "Success", "#00a240");
  wg_as_swatch(t, "as.sw.c2", "as-swatch-chip as-sw-warning", "Warning", "#e25507");
  wg_as_swatch(t, "as.sw.c3", "as-swatch-chip as-sw-danger", "Danger", "#e02e2a");
  wg_as_swatch(t, "as.sw.c4", "as-swatch-chip as-sw-discovery", "Discovery", "#924ff7");
  tr_close(t);
  tr_close(t);

  tr_close(t); // as.root
}

wg_build :: (s: [] WebPage) {
  t := s[0].tree[..]; u := s[0].ui[..];
  buf: [UI_ID] u8; buf2: [UI_ID] u8;
  tr_begin(t);
  page := tr_open(t, "page", TG_MAIN, "as-page");

  wg_as_showcase(s);

  _ = tr_open(t, "mono-frames", TG_DIV, "as-legacy-wrap");

  top := tr_open(t, "top", TG_DIV, "col");
  hd := k_header(t, u, "title", "Mono Frames (Legacy)");
  tr_close(t);
  lede := tr_leaf(t, "lede", TG_P, "lede", "The earlier monochrome ARWES framed set (components/kit/frames.coax + components/skin/mono.coax), kept live below alongside the new Apps SDK UI kit.");
  bar := tr_open(t, "top.bar", TG_DIV, "rowf");
  rp := k_button(t, u, "replay", "Replay", BS_PLAIN);
  gpu:=k_go(t,"gallery.gpu","GPU + motion →","/components-gpu");
  tr_close(t);
  tr_close(t);

  sec := wg_section(t, "buttons", "Button", "An octagon and a label. The primary action is the inverse. A disabled one is dashed.");
  row := tr_open(t, "buttons.row", TG_DIV, "rowf");
  b1 := k_button(t, u, "press.primary", "Send", BS_PRIMARY);
  b2 := k_button(t, u, "press.plain", "New chat", BS_PLAIN);
  b3 := k_button(t, u, "press.stop", "Stop", BS_PLAIN);
  b4 := k_button(t, u, "press.off", "Unavailable", BS_DISABLED);
  tr_close(t);
  count := tr_leaf(t, "buttons.count", TG_P, "meta", tr_cat(buf2[..], tr_join(buf[..], "Pressed ", s[0].presses), ifx s[0].presses == 1 then " time" else " times"));
  tr_close(t);

  // every variant and state a native host draws too (components/skin/mono-native.coax, mono_button; #13580)
  sec = wg_section(t, "variants", "Button variants", "Primary is filled. The default is a cut-corner outline. A quiet one is smaller and dimmer. An icon button is only its icon. A destructive one has a bright line, fills when pressed, and says what it removes. A disabled one is dashed; a busy one's dashes move and its label says what it is doing. The phone and desktop apps draw these same frames from the same points.");
  row = tr_open(t, "variants.primary", TG_DIV, "rowf");
  bv := k_button(t, u, "variant.primary", "Log in", BS_PRIMARY);
  bv = k_button(t, u, "variant.primary.off", "Log in", BS_DISABLED);
  bv = k_button(t, u, "variant.primary.busy", "Checking code…", BS_BUSY);
  tr_close(t);
  row = tr_open(t, "variants.default", TG_DIV, "rowf");
  bv = k_button(t, u, "variant.default", "Refresh chats", BS_PLAIN);
  bv = k_button(t, u, "variant.default.off", "Refresh chats", BS_DISABLED);
  bv = k_button(t, u, "variant.default.busy", "Loading chats…", BS_BUSY);
  tr_close(t);
  row = tr_open(t, "variants.rest", TG_DIV, "rowf");
  bv = k_link(t, "variant.quiet", "Build details");
  bv = k_icon_button(t, "variant.icon", IC_COPY, "Copy");
  bv = k_button(t, u, "variant.destructive", "Delete this chat", BS_DESTRUCTIVE);
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "fields", "Field and composer", "Real text fields: the keyboard, paste, spell check and the phone's keys are the browser's. Enter sends; Shift and Enter makes a line.");
  f := k_field(t, u, "name", "Name this chat", "Name this chat");
  c := k_composer(t, u, "composer", "Ask the OpenAgents agent", "Opus 5.5", "Send", s[0].draft_n > 0);
  tr_close(t);

  sec = wg_section(t, "talk", "Conversation", "The person's message is in a dim frame. A tool call is a row that opens. The agent's answer is plain Markdown on the ground, with no frame and no effect: it is for reading.");
  th := tr_open(t, "thread", TG_DIV, "thread");
  m1 := k_user(t, u, "msg.0", "Why does the chat feel slow?");
  tool := k_tool(t, u, "tool.1", "Read", "apps/openagents-web/chat.coax", s[0].tool_open, "path: apps/openagents-web/chat.coax", "1,536 lines. WC_BUSY :: 2.0; // seconds between reads while a turn waits or runs");
  if s[0].doc[0].nb == 0 { n := md_parse(s[0].doc[..], WG_ANSWER, 0); }
  ans := k_agent(t, u, "msg.1", s[0].doc[..]);
  meta := k_meta(t, "msg.1.meta", "Opus 5.5 · OpenAgents key · $0.0412");
  for k: 0..<s[0].nsent {
    m := k_user(t, u, tr_join(buf[..], "sent.", k), cast(string) s[0].sent[k][0..<s[0].sent_n[k]]);
  }
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "work", "Work log", "An agent's tool calls. A call is a row: what it does in words, what it worked on, how it stands and how long it took; it opens onto what it sent and what came back. Calls of one tool in a row are a group with a count. A finished run is one line above the answer. A dry run, a refusal and a wait for approval each say so in words, and why.");
  wl := tr_open(t, "work.log", TG_DIV, "wk-log");
  sum := k_work_group_begin(t, u, "work.w", IC_EDIT_PENCIL, "Set foe plans ×12, Look up tools, and 2 more tools", 15, "", KW_REFUSED, s[0].work[0]);
  if s[0].work[0] {
    r0 := k_work_row(t, u, "work.c.0", IC_EYE, "Read the world splice", "splice", KW_DONE, "", 1200, false, "{\"slug\":\"splice\"}", "{\"ok\":true,\"things\":14}", false);
    g := k_work_group_begin(t, u, "work.g", IC_EDIT_PENCIL, "Set foe plans", 12, "Set foe 3's night plan: hunt", KW_REFUSED, s[0].work[1]);
    if s[0].work[1] {
      r1 := k_work_row(t, u, "work.c.1", IC_EDIT_PENCIL, "Set foe 2's dusk plan: rest", "splice", KW_REFUSED, "foe 2 has no route for the dusk patrol. Trying again won't help.", 0, s[0].work[2],
        "{\"slug\":\"splice\",\"foe\":2,\"daytime\":\"dusk\",\"act\":\"rest\"}", WG_REFUSED, s[0].work[3]);
      r2 := k_work_row(t, u, "work.c.2", IC_EDIT_PENCIL, "Set foe 3's dawn plan: patrol", "splice", KW_DRY, "Nothing was saved: carried out whole in a throwaway copy of the world.", 0, false, "", "", false);
      r3 := k_work_row(t, u, "work.c.3", IC_GLOBE, "Publish splice now", "splice", KW_ASK, "Nothing was done. It runs once it is approved.", 0, false, "", "", false);
      r4 := k_work_row(t, u, "work.c.4", IC_EDIT_PENCIL, "Set foe 3's night plan: hunt", "splice", KW_RUN, "", 4000, false, "", "", false);
    }
    k_work_group_end(t, s[0].work[1]);
  }
  k_work_group_end(t, s[0].work[0]);
  tr_close(t);
  wn := k_work_now(t, "work.now", "Set foe 3's night plan: hunt");
  tr_close(t);

  sec = wg_section(t, "code", "Code block", "Its language and Copy in a strip, then the code, which scrolls sideways before it wraps.");
  cb := k_code(t, u, "code.1", "coax", WG_CODE);
  tr_close(t);

  sec = wg_section(t, "code-fields", "Code field", "Code to edit: the code face, no wrapping, a set height that scrolls both ways. Enter makes a line and Tab indents. The editor's Code pane is built from it.");
  cf := k_code_field(t, u, "code.edit", "coax", "Code to edit");
  tr_close(t);

  sec = wg_section(t, "drops", "Drop and file", "A place to drop a file, or press to pick one: it says what it takes before anything is sent. A file in a list is its name and what it is. The editor's Assets pane is built from them.");
  dr := k_drop(t, u, "drop.1", "Drop a file here, or press to pick one", "A .glb, .png, .wav, .ogg or .mp3 file, 512 KB at most", ".glb,.png,.wav,.ogg,.mp3", false);
  db := k_drop(t, u, "drop.2", "Sending rock.glb", "2 KB", "", true);
  f1 := k_file(t, "file.1", "rock", "Mesh · 2 KB · CC0 1.0 Universal");
  f2 := k_file(t, "file.2", "door", "Sound · 4 KB · CC BY 4.0");
  tr_close(t);

  sec = wg_section(t, "notices", "Notice", "Between two lines, bright. It says its kind in words, since there is no red to say it.");
  n1 := k_notice(t, u, "notice.error", "Error", "The runner didn't answer. Your message is back in the composer.");
  tr_close(t);
  n2 := k_notice(t, u, "notice.ask", "Approval needed", "The agent wants to run: git push origin main");
  ask := tr_open(t, "notice.ask.row", TG_DIV, "rowf");
  if s[0].answer == 0 {
    a1 := k_button(t, u, "allow", "Allow", BS_PRIMARY);
    a2 := k_button(t, u, "deny", "Deny", BS_PLAIN);
  } else {
    said := tr_leaf(t, "notice.ask.said", TG_SPAN, "meta", ifx s[0].answer == 1 then "Allowed" else "Denied");
    a3 := k_link(t, "ask.again", "Ask again");
  }
  tr_close(t);
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "rows", "Row", "A conversation in the list. The current one is bright and boxed.");
  list := tr_open(t, "list", TG_NAV, "list");
  tr_attr(t, list, AT_LABEL, "Chats");
  titles := WG_ROWS; metas := WG_ROW_META;
  for k: 0..<3 { r := k_row(t, u, tr_join(buf[..], "row.", k), titles[k], metas[k], k == s[0].row); }
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "sides", "Side", "The frame down the left of every page for someone logged in: the mark and Hide the side, then Chats, Projects and Worlds as folds that open and shut their lists in place, each with a + at its right that makes a new one, and who is logged in at the foot. On a page it stands the window's height.");
  gs := k_side(t, "side", "Places");
  gh := k_side_head(t, "side.h", "OpenAgents", "/components");
  gn := k_icon_button(t, "side.hide", IC_SIDEBAR, "Hide the side");
  tr_close(t);
  gl := k_side_folds(t, "side");
  sf1 := k_fold(t, u, "side.chats", IC_CHATS, "Chats", true, true, "New chat");
  gm := k_side_mark(t, "side.recent", "Recent", 3);
  for k: 0..<3 { r := k_row(t, u, tr_join(buf[..], "side.row.", k), titles[k], "", k == 0); }
  tr_close(t);
  sf2 := k_fold(t, u, "side.projects", IC_FOLDER, "Projects", false, false, "New project");
  tr_close(t);
  sf3 := k_fold(t, u, "side.worlds", IC_GLOBE, "Worlds", true, false, "New world");
  p4 := k_sub_place(t, u, "side.splice", "Splice Bots", "/components");
  tr_close(t);
  k_side_end(t);
  gw := k_who(t, u, "side.who", "a•••@example.com", "/components", false);
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "settings", "Settings", "A settings page beside the side: its sections down the left, the one shown bright on the raised surface, and the section's rows in framed groups. A row is a name, what it is or does, and what changes it at its right: a switch that says On or Off, a button, a link or a value. /settings is built from it.");
  sp := k_set(t, "st");
  sn := k_set_nav(t, "st.nav", "Settings");
  snames := [2] string.["Account", "Appearance"]; sicons := [2] int.[IC_AVATAR_PROFILE, IC_COLOR_THEME];
  for k: 0..<2 { r := k_place(t, u, tr_join(buf[..], "st.nav.", k), sicons[k], snames[k], "/components", k == s[0].section); }
  tr_close(t);
  sb := k_set_body(t, u, "st.b", "Settings", snames[s[0].section]);
  sg := k_set_group(t, u, "st.g", ifx s[0].section == 0 then "You" else "");
  if s[0].section == 0 {
    r1 := k_set_row(t, "st.who", "Logged in as", "a•••@example.com"); k_set_row_end(t);
    r2 := k_set_row(t, "st.lim", "Email codes sent to one address", ""); v := k_set_value(t, "st.lim.v", "5 an hour"); k_set_row_end(t);
    r3 := k_set_row(t, "st.sec", "Security", "How you log in: your email, keys and passkeys."); g := k_go(t, "st.sec.go", "Open", "/components"); k_set_row_end(t);
    r4 := k_set_row(t, "st.out", "Log out", "Log out of this browser."); o := k_button(t, u, "st.out.b", "Log out", BS_PLAIN); k_set_row_end(t);
  } else {
    r1 := k_set_row(t, "st.side", "The side", "Places and chats down the left."); sw := k_switch(t, "st.side.sw", "The side", s[0].switched); k_set_row_end(t);
  }
  k_set_group_end(t);
  tr_close(t);
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "menus", "Menu", "Rows in a panel: the model for the next turn.");
  menu := k_menu(t, u, "menu", "Model");
  models := WG_MODELS; notes := WG_MODEL_NOTES;
  for k: 0..<3 { r := k_row(t, u, tr_join(buf[..], "model.", k), models[k], notes[k], k == s[0].model); }
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "cards", "World card", "A world as a conversation shows it: its name, what it holds, and a link that opens its editor.");
  wc := k_card(t, u, "card.world", "Splice");
  wm := k_meta(t, "card.world.facts", "12 things · revision 7");
  wo := k_go(t, "card.world.open", "Open the editor", "/worlds/splice?edit=agent");
  tr_close(t);
  tr_close(t);

  sec = wg_section(t, "lists", "Entries", "Things in a list beside the side, under a heading with their count: a small picture when one exists, the name as a link, a line about it, its facts, and its actions at the right. A choice of a few sorts or filters them. /projects and /worlds are built from them.");
  lch := k_choices(t, "ls.sort", "Sort by");
  lc0 := k_choice(t, "ls.sort.0", "Popular", true);
  lc1 := k_choice(t, "ls.sort.1", "A to Z", false);
  tr_close(t);
  le := k_entries(t, "ls", "Worlds", 2);
  le0 := k_entry(t, u, "ls.0", "Everglade", "/worlds/everglade", "A forest city with quests out to the deep wood", "Opened Oct 28, 2026 · 1,290 visitors", "/worlds/everglade/og.jpg", "Everglade");
  lp0 := k_go_button(t, u, "ls.0.play", "Play", "/worlds/everglade", true);
  lq0 := k_go_button(t, u, "ls.0.edit", "Edit", "/worlds/everglade?edit", false);
  k_entry_end(t);
  le1 := k_entry(t, u, "ls.1", "Farm", "/worlds/farm", "A meadow with a red barn", "Opened Nov 1, 2026", "", "");
  lp1 := k_go_button(t, u, "ls.1.play", "Play", "/worlds/farm", true);
  k_entry_end(t);
  k_entries_end(t);
  tr_close(t);

  sec = wg_section(t, "docks", "Dock", "Panes round something that still shows: a strip of actions, a list, the picked thing's fields and facts, and a foot. The editor that ?edit opens over a world is built from it.");
  dock := k_dock(t, "dock", false);
  strip := k_pane(t, u, "dock.bar", DK_TOP, "");
  d1 := k_button(t, u, "dock.undo", "Undo", BS_PLAIN);
  d2 := k_button(t, u, "dock.redo", "Redo", BS_DISABLED);
  d3 := tr_leaf(t, "dock.rev", TG_SPAN, "meta", "splice · revision 7");
  k_pane_end(t);
  things := k_pane(t, u, "dock.things", DK_LEFT, "Things");
  dl := tr_open(t, "dock.list", TG_NAV, "list");
  tr_attr(t, dl, AT_LABEL, "Things");
  pieces := WG_THINGS;
  for k: 0..<3 { r := k_row_with(t, u, tr_join(buf[..], "thing.", k), pieces[k], tr_join(buf2[..], "No. ", k + 1), k == s[0].thing, IC_PLUS, "Add to the group", s[0].grouped[k]); }
  tr_close(t);
  k_pane_end(t);
  one := k_pane(t, u, "dock.one", DK_RIGHT, "Selected");
  oc := k_card(t, u, "dock.card", pieces[s[0].thing]);
  px := k_prop(t, u, "dock.x", "X cm", "0");
  pz := k_prop(t, u, "dock.z", "Z cm", "0");
  fk := k_fact(t, "dock.kit", "Kit", "rover");
  // a stepper: a value that is stepped, not typed
  radii := [5] string.["2 m", "4 m", "8 m", "16 m", "32 m"];
  sr := k_stepper(t, "dock.radius", "Radius", radii[s[0].radius], s[0].radius > 0, s[0].radius < 4);
  // a slider: a whole number dragged along a line (its place is the browser's own; the words beside it say the usual)
  sh := k_slider(t, "dock.height", "Height", "145 to 225 cm", 145, 225, 1);
  // its ends in words under the line, and why it stops at each
  se := k_slider_ends(t, "dock.height.ends", "145 cm", "225 cm", "The body is made for these heights.");
  // a meter: an amount against its limit, the limit in the words too
  mt := k_meter(t, "dock.spent", "Budget", "5,000 of 20,000", 0.25);
  tr_close(t);
  // switch rows: a list of named things that are each on or off (a realm's board, the tools its visitors get)
  bh := k_header(t, u, "dock.board", "Features");
  tr_close(t);
  sw0 := k_switch_row(t, "dock.sw.0", "Glowing mushrooms", "", s[0].lit[0]);
  sw1 := k_switch_row(t, "dock.sw.1", "A bridge over the stream", "Off until the stream is dug", s[0].lit[1]);
  k_pane_end(t);
  dfoot := k_pane(t, u, "dock.foot", DK_BOTTOM, "Agent");
  fm := k_meta(t, "dock.foot.note", "A foot across the bottom. In the editor its slot holds the chat's conversation.");
  k_pane_end(t);
  tr_close(t);
  tr_close(t);

  foot := tr_open(t, "foot", TG_FOOTER, "md");
  credit := tr_open(t, "credit", TG_P, "");
  c1 := tr_leaf(t, "credit.0", TG_SPAN, "", "The frames and their motion are ");
  c2 := tr_leaf(t, "credit.1", TG_A, "", "ARWES");
  tr_attr(t, c2, AT_HREF, "https://github.com/arwes/arwes/tree/bdbaa0324900ee978d42036d1304a053c1fe54b5");
  c3 := tr_leaf(t, "credit.2", TG_SPAN, "", " by Romel Perez, ported to Coax, under the ");
  c4 := tr_leaf(t, "credit.3", TG_A, "", "MIT license");
  tr_attr(t, c4, AT_HREF, "https://github.com/arwes/arwes/blob/bdbaa0324900ee978d42036d1304a053c1fe54b5/LICENSE");
  c5 := tr_leaf(t, "credit.4", TG_SPAN, "", ". The shared GPU components and motion lab are at ");
  c6 := tr_leaf(t, "credit.5", TG_A, "", "/components-gpu");
  tr_attr(t, c6, AT_HREF, "/components-gpu");
  c7 := tr_leaf(t, "credit.6", TG_SPAN, "", ".");
  tr_close(t);
  tr_close(t);

  tr_close(t); // mono-frames
  tr_close(t); // page
}

wg_id_is :: (id: string, part: string) -> bool { return id.count >= part.count && cast(string) id[0..<part.count] == part; }
// The digit after a part: "row.2" after "row." is 2.
wg_index :: (id: string, part: string) -> int {
  if !wg_id_is(id, part) || id.count != part.count + 1 { return -1; }
  c := id[part.count];
  return ifx c >= '0' && c <= '9' then cast(int) (c - '0') else -1;
}
wg_send :: (s: [] WebPage) {
  lo := 0; hi := s[0].draft_n;
  while lo < hi && (s[0].draft[lo] == ' ' || s[0].draft[lo] == '\n') { lo += 1; }
  while hi > lo && (s[0].draft[hi - 1] == ' ' || s[0].draft[hi - 1] == '\n') { hi -= 1; }
  if hi <= lo { return; }
  // the newest WG_SENT stay
  if s[0].nsent >= WG_SENT {
    for k: 1..<WG_SENT { s[0].sent[k - 1] = s[0].sent[k]; s[0].sent_n[k - 1] = s[0].sent_n[k]; }
    s[0].nsent = WG_SENT - 1;
  }
  k := s[0].nsent;
  for i: lo..<hi { s[0].sent[k][i - lo] = s[0].draft[i]; }
  s[0].sent_n[k] = hi - lo; s[0].nsent += 1;
  s[0].draft_n = 0;
  dm_value(s[0].dom[..], "composer", "");
}
wg_click :: (s: [] WebPage, id: string) {
  if id == "replay" { ui_replay(s[0].ui[..]); }
  else if id == "press.primary" || id == "press.plain" || id == "press.stop" { s[0].presses += 1; }
  else if id == "tool.1" { s[0].tool_open = !s[0].tool_open; }
  else if id == "work.w" { s[0].work[0] = !s[0].work[0]; }
  else if id == "work.g" { s[0].work[1] = !s[0].work[1]; }
  else if id == "work.c.1" { s[0].work[2] = !s[0].work[2]; }
  else if id == "work.c.1.all" { s[0].work[3] = !s[0].work[3]; }
  else if id == "work.c.1.copy" { s[0].clip_n = 0; for c: WG_REFUSED { if s[0].clip_n < WG_DRAFT { s[0].clip[s[0].clip_n] = c; s[0].clip_n += 1; } } }
  else if id == "allow" { s[0].answer = 1; }
  else if id == "deny" { s[0].answer = 2; }
  else if id == "ask.again" { s[0].answer = 0; }
  else if id == "composer.send" { wg_send(s); }
  else if id == "code.1.copy" { s[0].clip_n = 0; for c: WG_CODE { if s[0].clip_n < WG_DRAFT { s[0].clip[s[0].clip_n] = c; s[0].clip_n += 1; } } }
  else if wg_index(id, "row.") >= 0 { s[0].row = wg_index(id, "row."); }
  else if id.count == 9 && wg_id_is(id, "thing.") && cast(string) id[7..<9] == ".x" && id[6] >= '0' && id[6] <= '2' { k := cast(int) (id[6] - '0'); s[0].grouped[k] = !s[0].grouped[k]; }
  else if wg_index(id, "thing.") >= 0 { s[0].thing = wg_index(id, "thing."); }
  else if id == "dock.radius.less" && s[0].radius > 0 { s[0].radius -= 1; }
  else if id == "dock.radius.more" && s[0].radius < 4 { s[0].radius += 1; }
  else if wg_index(id, "model.") >= 0 { s[0].model = wg_index(id, "model."); }
  else if wg_index(id, "st.nav.") >= 0 && wg_index(id, "st.nav.") < 2 { s[0].section = wg_index(id, "st.nav."); }
  else if id == "st.side.sw" { s[0].switched = !s[0].switched; }
  else if id == "dock.sw.0" { s[0].lit[0] = !s[0].lit[0]; }
  else if id == "dock.sw.1" { s[0].lit[1] = !s[0].lit[1]; }
  else if id == "as.btn.pill" { s[0].as_pill = !s[0].as_pill; }
  else if id == "as.btn.busy" { s[0].as_busy = !s[0].as_busy; }
  else if id == "as.btn.primary" || id == "as.btn.secondary" || id == "as.btn.info" || id == "as.btn.success" || id == "as.btn.warning" || id == "as.btn.danger" || id == "as.btn.discovery" || id == "as.empty.cta" { s[0].as_presses += 1; }
  else if id == "as.alert.dismiss" { s[0].as_alert_gone = true; }
  else if id == "as.alert.restore" { s[0].as_alert_gone = false; }
  else if id == "as.form.invalid" { s[0].as_invalid = !s[0].as_invalid; }
  else if id == "as.sw.0" { s[0].as_sw[0] = !s[0].as_sw[0]; }
  else if id == "as.sw.1" { s[0].as_sw[1] = !s[0].as_sw[1]; }
  else if id == "as.chk.0" { s[0].as_chk[0] = !s[0].as_chk[0]; }
  else if id == "as.chk.1" { s[0].as_chk[1] = !s[0].as_chk[1]; }
  else if wg_index(id, "as.seg.") >= 0 && wg_index(id, "as.seg.") < 3 { s[0].as_seg = wg_index(id, "as.seg."); }
  else if id == "as.code.copy" {
    s[0].as_copied = true;
    s[0].clip_n = 0;
    for c: WG_AS_SNIPPET { if s[0].clip_n < WG_DRAFT { s[0].clip[s[0].clip_n] = c; s[0].clip_n += 1; } }
  }
  else if id == "as.cp.btn" {
    s[0].as_key_copied = true;
    s[0].clip_n = 0;
    ktxt := "oa_live_demo_token";
    for c: ktxt { if s[0].clip_n < WG_DRAFT { s[0].clip[s[0].clip_n] = c; s[0].clip_n += 1; } }
  }
  else if wg_index(id, "as.rg.") >= 0 && wg_index(id, "as.rg.") < 3 { s[0].as_radio = wg_index(id, "as.rg."); }
  else if id == "as.sel" { s[0].as_sel_open = !s[0].as_sel_open; }
  else if wg_index(id, "as.sel.") >= 0 && wg_index(id, "as.sel.") < 3 { s[0].as_sel_idx = wg_index(id, "as.sel."); s[0].as_sel_open = false; }
  else if id.count == 10 && wg_id_is(id, "as.tag.") && cast(string) id[8..<10] == ".x" && id[7] >= '0' && id[7] <= '5' {
    rm := cast(int) (id[7] - '0');
    if rm < s[0].as_ntags {
      for j: rm + 1..<s[0].as_ntags { s[0].as_tags[j - 1] = s[0].as_tags[j]; s[0].as_tag_n[j - 1] = s[0].as_tag_n[j]; }
      s[0].as_ntags -= 1;
    }
  }
  else if wg_index(id, "as.rng.") >= 0 && wg_index(id, "as.rng.") < 3 { s[0].as_range_preset = wg_index(id, "as.rng."); }
  else if id.count == 11 && wg_id_is(id, "as.cal.d.") && id[9] >= '0' && id[9] <= '9' && id[10] >= '0' && id[10] <= '9' {
    day := cast(int) (id[9] - '0') * 10 + cast(int) (id[10] - '0');
    if day >= 22 && day <= 30 { s[0].as_cal_day = day; }
  }
  else if id == "as.pop.trig" { s[0].as_pop_open = !s[0].as_pop_open; s[0].as_menu_open = false; }
  else if id == "as.pop.ok" { s[0].as_pop_open = false; }
  else if id == "as.menu.trig" { s[0].as_menu_open = !s[0].as_menu_open; s[0].as_pop_open = false; }
  else if wg_index(id, "as.menu.") >= 0 && wg_index(id, "as.menu.") < 4 { s[0].as_menu_last = wg_index(id, "as.menu.") + 1; s[0].as_menu_open = false; }
  else if id == "as.tip.btn" { s[0].as_tip_open = !s[0].as_tip_open; }
  else if id == "as.dlg.open" { s[0].as_dialog_open = true; }
  else if id == "as.dlg.close" || id == "as.dlg.cancel" || id == "as.dlg.ok" { s[0].as_dialog_open = false; }
  else if wg_index(id, "as.tab.") >= 0 && wg_index(id, "as.tab.") < 3 { s[0].as_tab = wg_index(id, "as.tab."); }
  else if wg_index(id, "as.sb.") >= 0 && wg_index(id, "as.sb.") < 4 { s[0].as_sb = wg_index(id, "as.sb."); }
  else if wg_index(id, "as.chip.") >= 0 && wg_index(id, "as.chip.") < 3 { s[0].as_chip_pick = wg_index(id, "as.chip.") + 1; }
}

wg_as_seed_tag :: (s: [] WebPage, tag: string) {
  if s[0].as_ntags >= WG_AS_TAGS_CAP { return; }
  k := s[0].as_ntags; n := 0;
  for c: tag { if n < WG_AS_TAG_LEN { s[0].as_tags[k][n] = c; n += 1; } }
  if n > 0 { s[0].as_tag_n[k] = n; s[0].as_ntags += 1; }
}

// ---------------------------------------------------------------- the face's calls

// One frame: builds and flushes if something changed or is entering. Bytes of commands to apply (at coaxial_kit_out).
coaxial_kit_frame :: (s: [] WebPage, dt: f32, reduced: bool) -> int #export_c #effects(all) {
  if s.count < 1 { return 0; }
  if !s[0].ready {
    n := mono_frames(s[0].sets[..]);
    s[0].as_sw[0] = true;
    s[0].as_chk[0] = true;
    s[0].as_slider = 45;
    s[0].as_cal_day = 27;
    wg_as_seed_tag(s, "coax");
    wg_as_seed_tag(s, "dark-mode");
    wg_as_seed_tag(s, "apps-sdk");
    s[0].ready = true; s[0].dirty = true;
  }
  step := ifx dt < 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  s[0].time += step;
  if !s[0].dirty && !s[0].animating { return 0; }
  d := s[0].dom[..];
  if !d[0].styled {
    n := mono_button_css(s[0].css[..], mono_page_css(s[0].css[..], mono_work_css(s[0].css[..], mono_set_css(s[0].css[..], mono_dock_css(s[0].css[..], mono_css(s[0].css[..]))))));
    n = apps_sdk_css(s[0].css[..], n);
    dm_style(d, cast(string) s[0].css[0..<n]);
  }
  ui_begin(s[0].ui[..], s[0].time, reduced);
  wg_build(s);
  ui_end(s[0].ui[..]);
  s[0].animating = s[0].ui[0].busy;
  s[0].dirty = false;
  bytes := dm_flush(d, s[0].tree[..], s[0].sets[..]);
  if d[0].overflow { dm_reset(d); s[0].dirty = true; return -1; }   // the host clears the page; the next frame sends it whole
  return bytes;
}
coaxial_kit_busy :: (s: [] WebPage) -> bool #export_c #effects(all) { return s.count > 0 && (s[0].dirty || s[0].animating); }
// A press (1), a field's text (2: the inbox holds it) or Enter in a field (3), on the node in this slot.
coaxial_kit_event :: (s: [] WebPage, kind: int, slot: int, length: int) #export_c #effects(all) {
  if s.count < 1 { return; }
  id := dm_slot_id(s[0].dom[..], slot);
  if id.count == 0 { return; }
  if kind == WG_CLICK { wg_click(s, id); }
  else if kind == WG_DIALOG_CANCEL && id == "as.dlg" { s[0].as_dialog_open = false; }
  else if kind == WG_INPUT && id == "as.sl" {
    v := 0;
    lim := ifx length < 0 then 0 else ifx length > 8 then 8 else length;
    for i: 0..<lim { c := s[0].inbox[i]; if c >= '0' && c <= '9' { v = v * 10 + cast(int) (c - '0'); } }
    s[0].as_slider = ifx v < 0 then 0 else ifx v > 100 then 100 else v;
  }
  else if kind == WG_INPUT && id == "as.tags.in" {
    n := ifx length < 0 then 0 else ifx length > WG_AS_TAG_LEN then WG_AS_TAG_LEN else length;
    for i: 0..<n { s[0].as_tag_draft[i] = s[0].inbox[i]; }
    s[0].as_tag_draft_n = n;
  }
  else if kind == WG_SUBMIT && id == "as.tags.in" {
    if s[0].as_tag_draft_n > 0 {
      wg_as_seed_tag(s, cast(string) s[0].as_tag_draft[0..<s[0].as_tag_draft_n]);
      s[0].as_tag_draft_n = 0;
      dm_value(s[0].dom[..], "as.tags.in", "");
    }
  }
  else if kind == WG_INPUT && id == "composer" {
    n := ifx length < 0 then 0 else ifx length > WG_DRAFT then WG_DRAFT else ifx length > WG_INBOX then WG_INBOX else length;
    for i: 0..<n { s[0].draft[i] = s[0].inbox[i]; }
    s[0].draft_n = n;
  }
  else if kind == WG_SUBMIT && id == "composer" { wg_send(s); }
  s[0].dirty = true;
}
coaxial_kit_size :: (s: [] WebPage, slot: int, w: f32, h: f32) #export_c #effects(all) {
  if s.count > 0 && dm_size(s[0].dom[..], slot, w, h) { s[0].dirty = true; }
}
coaxial_kit_clip :: (s: [] WebPage) -> int #export_c #effects(all) { return ifx s.count > 0 then s[0].clip_n else 0; }
coaxial_kit_clip_done :: (s: [] WebPage) #export_c #effects(all) { if s.count > 0 { s[0].clip_n = 0; } }
coaxial_kit_inbox_cap :: () -> int #export_c #effects(all) { return WG_INBOX; }

// ---------------------------------------------------------------- checks

WgTest :: struct { s: [1] WebPage; }

#test "the page builds every component, sends itself once, and then is still" {
  h: [1] WgTest; s := h[0].s[..];
  n := coaxial_kit_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert n > 4000 && t[0].lost == 0 && t[0].depth == 0 && t[0].n > 120 && t[0].n < TR_NODES;
  #assert s[0].dom[0].out[0] == DC_STYLE && !coaxial_kit_busy(s);
  #assert tr_find(t, "press.primary") > 0 && tr_find(t, "composer") > 0 && tr_find(t, "tool.1") > 0 && tr_find(t, "code.1.pre") > 0;
  #assert tr_find(t, "notice.error") > 0 && tr_find(t, "row.2") > 0 && tr_find(t, "model.0") > 0 && tr_find(t, "msg.1.b0") > 0;
  #assert tr_class(t, tr_find(t, "ls.0")) == "ent" && tr_attr_of(t, tr_find(t, "ls.0.edit"), AT_HREF) == "/worlds/everglade?edit" && tr_find(t, "ls.1.pic") < 0 && tr_attr_of(t, tr_find(t, "ls.sort.0"), AT_PRESSED) == "true";
  #assert tr_find(t, "dock.bar.b") > 0 && tr_class(t, tr_find(t, "dock.foot")) == "pane pane-bm" && tr_find(t, "dock.x") > 0 && tr_text_of(t, tr_find(t, "dock.kit.v")) == "rover" && tr_class(t, tr_find(t, "dock")) == "dock";
  #assert tr_class(t, tr_find(t, "side")) == "side" && tr_text_of(t, tr_find(t, "side.who.go.t")) == "a•••@example.com" && tr_find(t, "side.row.2") > 0;
  #assert coaxial_kit_frame(s, 0.016, true) == 0;
  // the stepper steps: more raises its value, and at its last step More can't be pressed
  #assert tr_text_of(t, tr_find(t, "dock.radius")) == "8 m";
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "dock.radius.more"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "dock.radius.more"), 0);
  _ := coaxial_kit_frame(s, 0.016, true);
  #assert s[0].radius == 4 && tr_text_of(t, tr_find(t, "dock.radius")) == "32 m" && tr_has(t, tr_find(t, "dock.radius.more"), AT_DISABLED) && !tr_has(t, tr_find(t, "dock.radius.less"), AT_DISABLED);
  // a switch row: its name, its line and the switch; a press turns it on
  #assert tr_text_of(t, tr_find(t, "dock.sw.1.n")) == "A bridge over the stream" && tr_text_of(t, tr_find(t, "dock.sw.1.m")) == "Off until the stream is dug" && tr_text_of(t, tr_find(t, "dock.sw.1.l")) == "Off" && tr_find(t, "dock.sw.0.m") < 0;
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "dock.sw.1"), 0);
  _ = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].lit[1] && !s[0].lit[0] && tr_text_of(t, tr_find(t, "dock.sw.1.l")) == "On" && tr_attr_of(t, tr_find(t, "dock.sw.1"), AT_PRESSED) == "true";
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "thing.1"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].thing == 1 && tr_text_of(t, tr_find(t, "dock.card.h")) == "Parked rover";
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "thing.2.x"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].grouped[2] && s[0].thing == 1 && tr_has(t, tr_find(t, "thing.2.x"), AT_PRESSED) && !tr_has(t, tr_find(t, "thing.0.x"), AT_PRESSED);
}

#test "the settings page: its sections pick, the one shown is bright, and its switch says On or Off" {
  h: [1] WgTest; s := h[0].s[..];
  n := coaxial_kit_frame(s, 0.016, true);
  t := s[0].tree[..];
  #assert tr_class(t, tr_find(t, "st")) == "st" && tr_attr_of(t, tr_find(t, "st.nav.0"), AT_CURRENT) == "true" && tr_text_of(t, tr_find(t, "st.lim.v")) == "5 an hour" && tr_find(t, "st.side") < 0;
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "st.nav.1"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert tr_attr_of(t, tr_find(t, "st.nav.1"), AT_CURRENT) == "true" && !tr_has(t, tr_find(t, "st.nav.0"), AT_CURRENT) && tr_text_of(t, tr_find(t, "st.side.sw.l")) == "On";
  coaxial_kit_event(s, WG_CLICK, dm_find(s[0].dom[..], "st.side.sw"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert tr_text_of(t, tr_find(t, "st.side.sw.l")) == "Off" && tr_attr_of(t, tr_find(t, "st.side.sw"), AT_PRESSED) == "false";
}

#test "a press, a pick and an answer each change only their own nodes" {
  h: [1] WgTest; s := h[0].s[..];
  n := coaxial_kit_frame(s, 0.016, true);
  d := s[0].dom[..];
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "press.plain"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].presses == 1 && d[0].sent == 1 && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "buttons.count")) == "Pressed 1 time";
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "press.off"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].presses == 1 && n == 0;
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "row.2"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].row == 2 && d[0].sent == 4;   // one row loses its frame mark and its current mark, the other gains both
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "tool.1"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].tool_open && dm_find(d, "tool.1.out") >= 0;
  // the work log: its run opens onto a group, the group onto its rows, a refused row onto what came back
  #assert tr_find(s[0].tree[..], "work.w") > 0 && tr_find(s[0].tree[..], "work.g") < 0;
  for id: [3] string.["work.w", "work.g", "work.c.1"] { coaxial_kit_event(s, WG_CLICK, dm_find(d, id), 0); n = coaxial_kit_frame(s, 0.016, true); }
  #assert tr_attr_of(s[0].tree[..], tr_find(s[0].tree[..], "work.c.1.row"), AT_STATE) == "refused" && dm_find(d, "work.c.1.out") >= 0 && tr_find(s[0].tree[..], "work.c.4.g") > 0;
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "work.c.1.copy"), 0);
  #assert coaxial_kit_clip(s) == WG_REFUSED.count;
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "allow"), 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].answer == 1 && dm_find(d, "allow") < 0 && dm_find(d, "ask.again") >= 0;
}

#test "the composer sends what was typed, trimmed, clears its field and keeps the newest four" {
  h: [1] WgTest; s := h[0].s[..];
  n := coaxial_kit_frame(s, 0.016, true);
  d := s[0].dom[..];
  field := dm_find(d, "composer");
  #assert tr_has(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_DISABLED);
  text := "  hello there \n";
  for i: 0..<text.count { s[0].inbox[i] = text[i]; }
  coaxial_kit_event(s, WG_INPUT, field, text.count);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert !tr_has(s[0].tree[..], tr_find(s[0].tree[..], "composer.send"), AT_DISABLED);
  coaxial_kit_event(s, WG_SUBMIT, field, 0);
  n = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].nsent == 1 && s[0].draft_n == 0 && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "sent.0.p")) == "hello there";
  #assert dm_test_count(d, n, DC_VALUE) == 1;
  for k: 0..<5 {
    s[0].inbox[0] = cast(u8) ('a' + k);
    coaxial_kit_event(s, WG_INPUT, field, 1);
    coaxial_kit_event(s, WG_CLICK, dm_find(d, "composer.send"), 0);
    n = coaxial_kit_frame(s, 0.016, true);
  }
  #assert s[0].nsent == WG_SENT && tr_text_of(s[0].tree[..], tr_find(s[0].tree[..], "sent.3.p")) == "e";
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "code.1.copy"), 0);
  #assert coaxial_kit_clip(s) == WG_CODE.count;
  coaxial_kit_clip_done(s);
  #assert coaxial_kit_clip(s) == 0;
}

#test "everything enters, then stops; Replay enters it again; a size brings a frame" {
  h: [1] WgTest; s := h[0].s[..];
  n := coaxial_kit_frame(s, 0.016, false);
  #assert coaxial_kit_busy(s);
  d := s[0].dom[..];
  coaxial_kit_size(s, dm_find(d, "press.primary"), 96, 33);
  n = coaxial_kit_frame(s, 0.016, false);
  #assert dm_test_count(d, n, DC_FRAME) == 1;
  for k: 0..<40 { n = coaxial_kit_frame(s, 0.1, false); }
  #assert !coaxial_kit_busy(s) && coaxial_kit_frame(s, 0.016, false) == 0;
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "replay"), 0);
  n = coaxial_kit_frame(s, 0.016, false);
  #assert coaxial_kit_busy(s) && dm_test_count(d, n, DC_FRAME) == 1;
}

#test "GPU gallery navigation is a real anchor with the shared Go component" {
 s:[1]WebPage;_:=coaxial_kit_frame(s[..],0.016,true);t:=s[0].tree[..];a:=tr_find(t,"gallery.gpu");
 #assert a>=0 && t[0].nodes[a].tag==TG_A && tr_attr_of(t,a,AT_HREF)=="/components-gpu";
}

#test "Apps SDK UI dark-mode showcase renders interactive controls and updates live state" {
  h: [1] WgTest; s := h[0].s[..];
  n := coaxial_kit_frame(s, 0.016, true);
  t := s[0].tree[..]; d := s[0].dom[..];
  #assert n > 12000 && t[0].lost == 0 && t[0].depth == 0;
  #assert tr_find(t, "as.root") > 0 && tr_find(t, "as.btn.primary") > 0 && tr_find(t, "as.al.err") > 0;
  #assert tr_attr_of(t, tr_find(t, "as.sw.0"), AT_CHECKED) == "true" && tr_attr_of(t, tr_find(t, "as.sw.1"), AT_CHECKED) == "false";
  #assert tr_attr_of(t, tr_find(t, "as.seg.0"), AT_CHECKED) == "true";

  // Interactive button press, pill toggle, loading state
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.btn.primary"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.btn.pill"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.btn.busy"), 0);
  _ = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].as_presses == 1 && s[0].as_pill && s[0].as_busy;
  #assert tr_has(t, tr_find(t, "as.btn.primary"), AT_DISABLED) && tr_attr_of(t, tr_find(t, "as.btn.primary"), AT_STATE) == "busy";

  // Switch, checkbox, segmented control, validation toggle, alert dismiss/restore, code copy
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.sw.0"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.chk.1"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.seg.2"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.form.invalid"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.alert.dismiss"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.code.copy"), 0);
  _ = coaxial_kit_frame(s, 0.016, true);
  #assert !s[0].as_sw[0] && s[0].as_chk[1] && s[0].as_seg == 2 && s[0].as_invalid && s[0].as_alert_gone && s[0].as_copied;
  #assert tr_attr_of(t, tr_find(t, "as.in.email"), AT_INVALID) == "true" && tr_find(t, "as.al.info") < 0 && tr_find(t, "as.alert.restore") > 0;
  #assert tr_text_of(t, tr_find(t, "as.code.copy.l")) == "Copied" && coaxial_kit_clip(s) == WG_AS_SNIPPET.count;

  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.alert.restore"), 0);
  _ = coaxial_kit_frame(s, 0.016, true);
  #assert !s[0].as_alert_gone && tr_find(t, "as.al.info") > 0;

  // Complete Apps SDK UI interactions: RadioGroup, Slider, Select, TagInput, Popover, Menu, Dialog, Tabs, Shell
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.rg.1"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.sel"), 0);
  _ = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].as_radio == 1 && s[0].as_sel_open && tr_find(t, "as.sel.2") > 0;
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.sel.2"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.tag.0.x"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.pop.trig"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.dlg.open"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.tab.1"), 0);
  coaxial_kit_event(s, WG_CLICK, dm_find(d, "as.chip.0"), 0);
  _ = coaxial_kit_frame(s, 0.016, true);
  #assert s[0].as_sel_idx == 2 && !s[0].as_sel_open && s[0].as_ntags == 2 && s[0].as_pop_open && s[0].as_dialog_open && tr_find(t, "as.dlg") > 0 && s[0].as_tab == 1 && s[0].as_chip_pick == 1;
  coaxial_kit_event(s, WG_DIALOG_CANCEL, dm_find(d, "as.dlg"), 0);
  _ = coaxial_kit_frame(s, 0.016, true);
  #assert !s[0].as_dialog_open && tr_find(t, "as.dlg") < 0;
}
