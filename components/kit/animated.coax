// GPU/terminal-independent animated components. All paint comes from the skin.
#load "controls.coax";
#load "../core/spring.coax";

// Arcade's corner-origin assembly (A01/A02). Progress is caller-owned.
animated_frame :: (sh:[]Sheet,s:UiSkin,x:f32,y:f32,w:f32,h:f32,progress:f32,highlight:f32) {
 p:=am_unit(progress);ink:=s.accent;off:=s.animated.frame_corner_stroke;
 if w<=off*2 || h<=off*2 {return;}
 square:=w*s.animated.frame_square_fraction;if s.animated.frame_square_limit>0 && square>s.animated.frame_square_limit {square=s.animated.frame_square_limit;}
 // FrameSquare scales about its own outer corner, including its stroke.
 for i:0..<4 {left:=i%2==0;top:=i<2;
  sx:=x+ifx left then off/2*p else w-(square+off/2)*p;
  sy:=y+ifx top then off/2*p else h-(square+off/2)*p;
  _:=sheet_box(sh,sx,sy,square*p,square*p,0,off*p,s.clear,ink);
 }
 // The border's four segments scale from their centres, as Arcade's Scaler.
 cx:=x+(w-off)/2;cy:=y+(h-off)/2;lx:=x+off;rx:=x+w-off;ty:=y+off;by:=y+h-off;
 ax:=cx+(lx-cx)*p;bx:=cx+(rx-cx)*p;ay:=cy+(ty-cy)*p;by2:=cy+(by-cy)*p;
 sh[0].nu=prim_line(sh[0].under,sh[0].nu,ax,ty,bx,ty,s.animated.frame_stroke,ink);
 sh[0].nu=prim_line(sh[0].under,sh[0].nu,lx,ay,lx,by2,s.animated.frame_stroke,ink);
 sh[0].nu=prim_line(sh[0].under,sh[0].nu,rx,ay,rx,by2,s.animated.frame_stroke,ink);
 sh[0].nu=prim_line(sh[0].under,sh[0].nu,ax,by,bx,by,s.animated.frame_stroke,ink);
 _:=sheet_box(sh,lx,ty,w-off*2,h-off*2,0,0,opacity(s.surface,p*s.animated.frame_wash),s.surface);
}
// A05: opposite quarter arcs, one half-turn per 500ms. Reduced motion is still.
activity :: (sh:[]Sheet,s:UiSkin,x:f32,y:f32,size:f32,seconds:f32,reduced:bool) {
 start:=ifx reduced then 0.0f32 else seconds;quarter:=s.animated.activity_sweep;
 sh[0].nu=prim_ring(sh[0].under,sh[0].nu,x,y,size,size,s.animated.activity_stroke,opacity(s.accent,s.animated.activity_wash));
 for i:0..<2 {a:=start+cast(f32)i/2;sh[0].nu=prim_arc(sh[0].under,sh[0].nu,x,y,size,size,s.animated.activity_stroke,a,quarter,s.accent);}
}
// A09: progress-squared round-cap ring. Shared primitive; no bespoke shader.
progress_ring :: (sh:[]Sheet,s:UiSkin,x:f32,y:f32,size:f32,progress:f32) {
 p:=am_unit(progress);sh[0].nu=prim_ring(sh[0].under,sh[0].nu,x,y,size,size,s.animated.progress_stroke,s.hairline);
 sh[0].nu=prim_arc(sh[0].under,sh[0].nu,x,y,size,size,s.animated.progress_stroke,0,p*p,s.accent);
}
animated_switch :: (sh:[]Sheet,s:UiSkin,x:f32,y:f32,w:f32,h:f32,progress:f32) {
 p:=am_unit(progress);pad:=s.animated.switch_inset;knob:=h-2*pad;_:=sheet_box(sh,x,y,w,h,h/2,1,s.surface,s.hairline);
 _:=sheet_box(sh,x,y,w,h,h/2,0,opacity(s.accent,p*s.animated.switch_wash),s.accent);
 _:=sheet_box(sh,x+pad+(w-h)*p,y+pad,knob,knob,knob/2,0,s.ink,s.ink);
}
// The parent owns clipping, hit ownership and content; these paint the surface.
animated_drawer :: (sh:[]Sheet,s:UiSkin,x:f32,y:f32,w:f32,h:f32,progress:f32) {
 p:=am_unit(progress);_:=sheet_box(sh,x,y,w*p,h,s.animated.drawer_radius,1,s.surface,s.hairline);
}
animated_reply :: (sh:[]Sheet,s:UiSkin,x:f32,y:f32,w:f32,h:f32,progress:f32) {
 p:=am_unit(progress);if p>0 {_:=sheet_box(sh,x,y,w,h*p,s.animated.reply_radius,0,opacity(s.accent,p*s.animated.reply_wash),s.surface);}
}

#test "animated components use the common list and stay bounded at reduced or completed motion" {
 under:[64]Prim;over:[8]Prim;sh:=[1]Sheet.[Sheet.{under=under[..],over=over[..]}];s:=UiSkin.{};
 animated_frame(sh[..],s,10,20,100,60,0.5,0.7);#assert sh[0].nu==9 && under[0].x==10.75 && under[0].w==5 && under[0].border==1.5 && under[1].x==104.25;
 activity(sh[..],s,0,0,32,0.125,false);#assert under[10].kind==PRIM_ARC && under[10].a==0.125;
 progress_ring(sh[..],s,0,0,35,0.5);#assert under[13].b==0.25;
 animated_switch(sh[..],s,0,0,52,28,4);#assert under[16].x==27;
 animated_drawer(sh[..],s,0,0,200,100,0.5);#assert under[17].w==100;
 animated_reply(sh[..],s,0,0,200,60,0);#assert sh[0].nu==18;
 animated_reply(sh[..],s,0,0,200,60,0.5);#assert under[18].h==30;
}

// Arcade's round send/action control. Text/glyphs use the same semantic node.
round_action :: (sh:[]Sheet,s:UiSkin,x:f32,y:f32,size:f32,progress:f32) {
 p:=am_unit(progress);_:=sheet_box(sh,x,y,size,size,size/2,1,opacity(s.surface,p),opacity(s.accent,p));
}

// The composer retains the shared pill geometry while its border enters.
composer_frame :: (sh:[]Sheet,s:UiSkin,x:f32,y:f32,w:f32,h:f32,progress:f32) {
 p:=am_unit(progress);_:=sheet_box(sh,x,y,w,h,s.cmp.radius,1,opacity(s.surface,p),opacity(s.accent,p));
}

// Arcade A14: one spring-owned hamburger-to-arrow pose, mirrored for RTL.
drawer_icon :: (sh:[]Sheet,s:UiSkin,x:f32,y:f32,w:f32,h:f32,progress:f32,rtl:bool) {
 p:=am_unit(progress);cx:=x+w/2;cy:=y+h/2;sign:=ifx rtl then -1.0f32 else 1.0f32;
 a:=s.animated;for i:0..<3 {y0:=(cast(f32)i-1)*a.drawer_gap;ax:= -a.drawer_half+a.drawer_shift*p;bx:=a.drawer_half-(ifx i==1 then 0.0f32 else a.drawer_head)*p;
  ay:=y0*(1-p);by:=y0+(ifx i==0 then -a.drawer_tip else ifx i==2 then a.drawer_tip else 0.0f32)*p;
  sh[0].nu=prim_line(sh[0].under,sh[0].nu,cx+sign*ax,cy+ay,cx+sign*bx,cy+by,a.drawer_stroke,s.ink);
 }
}
#test "drawer icon is three shared vector segments at closed, open and mirrored poses" {
 b:[8]Prim;sh:=[1]Sheet.[Sheet.{under=b[..]}];s:=UiSkin.{};drawer_icon(sh[..],s,0,0,44,44,0,false);#assert sh[0].nu==3 && b[0].x==13 && b[0].y==16;
 sh[0].nu=0;drawer_icon(sh[..],s,0,0,44,44,1,false);#assert b[0].x==15 && b[0].y==22;
 sh[0].nu=0;drawer_icon(sh[..],s,0,0,44,44,1,true);#assert b[0].x==29 && b[0].y==22;
}
