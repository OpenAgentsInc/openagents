// The small controls' checks: each control in every skin, on pixels and in
// cells, by the same code (components/spec.md, GitHub #13153).
//   coax/bin/coax test components/kit/controls-checks.coax

#load "controls.coax";
#load "../skin/all.coax";

CtlStore :: struct { under: [128] Prim; over: [128] Prim; lines: [8] SheetLine; hits: [32] SheetHit; pool: [16] u8; }
ctl_sheet :: (st: [] CtlStore) -> Sheet {
  return Sheet.{under = st[0].under[..], over = st[0].over[..], lines = st[0].lines[..], hits = st[0].hits[..], pool = st[0].pool[..]};
}
// The measure a skin is laid out with: cells for the terminal, the atlas for the rest.
ctl_measure :: (id: int, a: [] Atlas) -> TextMeasure { return ifx id == UISKIN_TERMINAL then measure_cells() else measure_font(a); }

#test "choice and setting rows wrap descriptions and keep their full hit bounds" {
 st:[1]CtlStore;a:[1]Atlas;text_test_atlas(a[..]);s:=zeron_skin();m:=measure_font(a[..]);sh:=[1]Sheet.[ctl_sheet(st[..])];
 h:=choice_row(sh[..],m,s,0,0,200,"Model","A longer description that wraps on a narrow screen",true,25,7,1,2);
 #assert h>s.control_h && sh[0].nh==1 && sh[0].hits[0].w==200 && sh[0].hits[0].h==h && sh[0].hits[0].b==2;
 #assert sh[0].under[0].kind==PRIM_ICON && sh[0].under[0].id==25;
 sh[0]=ctl_sheet(st[..]);h=setting_toggle_row(sh[..],m,s,0,0,200,"Replies","Notify when replies finish",true,8,1,0);
 #assert h>=s.control_h && sh[0].nh==1 && sh[0].hits[0].w==200 && sh[0].hits[0].h==h;
 #assert sh[0].under[0].x>100 && sh[0].no>=2;
}
#test "slider thumb corner cannot exceed half its size" {
 st:[1]CtlStore;sh:=[1]Sheet.[ctl_sheet(st[..])];s:=zeron_skin();s.knob=20;s.radius_control=22;
 slider(sh[..],s,0,0,200,0.5,4,0);
 #assert sh[0].under[2].w==20 && sh[0].under[2].radius==10;
}
#test "icon rows reserve their trailing disclosure and expose the entire row" {
 st:[1]CtlStore;a:[1]Atlas;text_test_atlas(a[..]);s:=zeron_skin();m:=measure_font(a[..]);sh:=[1]Sheet.[ctl_sheet(st[..])];
 h:=icon_detail_row(sh[..],m,s,10,20,200,15,"Projects","Recently updated",13,9,3,4);
 #assert h>=s.control_h && sh[0].nh==1 && sh[0].hits[0].x==10 && sh[0].hits[0].w==200 && sh[0].hits[0].b==4;
 #assert sh[0].nu==2 && sh[0].under[0].id==15 && sh[0].under[1].id==13;
 #assert sh[0].under[0].x < sh[0].over[0].x && sh[0].under[1].x>sh[0].over[0].x;
}
#test "centered header keeps actions apart and each has its own target" {
 st:[1]CtlStore;a:[1]Atlas;text_test_atlas(a[..]);s:=zeron_skin();m:=measure_font(a[..]);sh:=[1]Sheet.[ctl_sheet(st[..])];
 header_actions(sh[..],m,s,0,0,320,"Projects",26,10,20,7);
 #assert sh[0].nh==2 && sh[0].hits[0].b==0 && sh[0].hits[1].b==1;
 #assert sh[0].hits[0].x+sh[0].hits[0].w<=sh[0].hits[1].x;
 #assert sh[0].over[0].x+sh[0].over[0].w/2==160;
}
#test "picker row aligns its value and disclosure without overlapping its title" {
 st:[1]CtlStore;a:[1]Atlas;text_test_atlas(a[..]);s:=zeron_skin();m:=measure_font(a[..]);sh:=[1]Sheet.[ctl_sheet(st[..])];
 h:=picker_row(sh[..],m,s,0,0,320,"Effort","Medium",13,5,0,0);
 #assert h==s.control_h && sh[0].nh==1 && sh[0].hits[0].w==320;
 #assert sh[0].over[0].x+sh[0].over[0].w<sh[0].over[1].x && sh[0].under[0].id==13;
}
#test "account row and removable file tile keep their labels and distinct targets" {
 st:[1]CtlStore;a:[1]Atlas;text_test_atlas(a[..]);s:=zeron_skin();m:=measure_font(a[..]);sh:=[1]Sheet.[ctl_sheet(st[..])];
 h:=account_row(sh[..],m,s,0,0,240,"A","Personal","Example account",true,25,10,0,0);
 #assert h>=s.control_h && sh[0].nh==1 && sh[0].hits[0].w==240;
 #assert sh[0].over[0].text=="Personal" && sh[0].over[2].text=="A";
 sh[0]=ctl_sheet(st[..]);h=file_tile(sh[..],m,s,0,0,132,"MD","Project guide",11,3);
 #assert h>0 && sh[0].nh==1 && sh[0].hits[0].a==3 && sh[0].hits[0].w>=s.control_h;
 #assert sh[0].hits[0].x+sh[0].hits[0].w<=132 && sh[0].hits[0].y>=0;
}
#test "segmented icon actions have adjacent independent targets" {
 st:[1]CtlStore;sh:=[1]Sheet.[ctl_sheet(st[..])];s:=zeron_skin();
 w:=segmented_icon_actions(sh[..],s,10,20,7,10,22,1);
 #assert w==s.control_h*2 && sh[0].nh==2;
 #assert sh[0].hits[0].b==0 && sh[0].hits[1].b==1 && sh[0].hits[0].x+sh[0].hits[0].w==sh[0].hits[1].x;
}
#test "repository choice shows owner above name and selected check" {
 st:[1]CtlStore;a:[1]Atlas;text_test_atlas(a[..]);s:=zeron_skin();m:=measure_font(a[..]);sh:=[1]Sheet.[ctl_sheet(st[..])];
 h:=repository_choice(sh[..],m,s,0,0,240,"example","project",true,25,9,0,1);
 #assert h>=s.control_h && sh[0].over[0].text=="example" && sh[0].over[1].text=="project";
 #assert sh[0].over[0].y<sh[0].over[1].y && sh[0].under[0].id==25 && sh[0].hits[0].w==240;
}
#test "empty state centers its icon and text in the available width" {
 st:[1]CtlStore;a:[1]Atlas;text_test_atlas(a[..]);s:=zeron_skin();m:=measure_font(a[..]);sh:=[1]Sheet.[ctl_sheet(st[..])];
 h:=empty_state(sh[..],m,s,10,20,240,15,"No projects");
 #assert h>s.control_h && sh[0].nu==2 && sh[0].under[1].kind==PRIM_ICON;
 #assert sh[0].over[0].x+sh[0].over[0].w/2==130 && sh[0].nh==0;
}

#test "a button is its label and the padding either side; its hit covers it; primary reads on the accent" {
  st: [1] CtlStore; a: [1] Atlas; text_test_atlas(a[..]);
  for id: 0..<UISKINS {
    sh: [1] Sheet; sh[0] = ctl_sheet(st[..]);
    s := uiskin(id); m := ctl_measure(id, a[..]);
    w := button(sh[..], m, s, 10, 20, "Send", UISKIN_PRIMARY, 7, 3);
    #assert w == measure_width(m, s.label.face, "Send") + 2 * s.control_pad && w == button_width(m, s, "Send");
    #assert sh[0].nh == 1 && sh[0].hits[0].kind == 7 && sh[0].hits[0].a == 3 && sh[0].hits[0].w == w && sh[0].hits[0].h == s.control_h;
    #assert sh[0].no == 1 && sh[0].over[0].text == "Send" && sh[0].over[0].fill.r == s.on_accent.r && sh[0].over[0].x == 10 + s.control_pad;
    #assert sh[0].nu == 1 && sh[0].under[0].fill.r == s.accent.r;
  }
  // in a terminal a resting button is only its label; in pixels it has a ground
  sh: [1] Sheet; sh[0] = ctl_sheet(st[..]);
  w := button(sh[..], measure_cells(), terminal_skin(), 0, 0, "Send", UISKIN_REST, 1, 0);
  #assert w == 6 && sh[0].nu == 0 && sh[0].over[0].x == 1;
  w = button(sh[..], measure_font(a[..]), zeron_skin(), 0, 0, "Send", UISKIN_REST, 1, 0);
  #assert w == 32 + 24 && sh[0].nu == 1 && sh[0].under[0].radius == 8 && sh[0].over[1].y == (32 - zeron_skin().label.line) / 2;
}
#test "a toggle: a track with its knob at the on or off end; in cells a box with a mark; the label follows" {
  st: [1] CtlStore; a: [1] Atlas; text_test_atlas(a[..]);
  sh: [1] Sheet; sh[0] = ctl_sheet(st[..]);
  z := zeron_skin();
  w := toggle(sh[..], measure_font(a[..]), z, 0, 0, "Wrap", true, 2, 0);
  #assert sh[0].nu == 2 && sh[0].under[0].fill.r == z.accent.r && sh[0].under[1].x > sh[0].under[0].x + sh[0].under[0].w / 2;
  #assert w == uiskin_toggle_width(z) + z.space + 32 && sh[0].hits[0].w == w;
  sh[0] = ctl_sheet(st[..]);
  w = toggle(sh[..], measure_font(a[..]), z, 0, 0, "Wrap", false, 2, 0);
  #assert sh[0].under[1].x == 2 && sh[0].under[0].fill.r == z.sunk.r && sh[0].over[0].fill.r == z.muted.r;
  sh[0] = ctl_sheet(st[..]);
  t := terminal_skin();
  w = toggle(sh[..], measure_cells(), t, 0, 0, "Wrap", true, 2, 0);
  #assert w == 3 + 1 + 4 && sh[0].under[0].kind == PRIM_TEXT && sh[0].under[0].text == "[x]" && sh[0].over[0].x == 4;
}
#test "a slider fills to its value and reads a pointer back; tabs mark the active one; a list picks a row" {
  st: [1] CtlStore; a: [1] Atlas; text_test_atlas(a[..]);
  for id: 0..<UISKINS {
    sh: [1] Sheet; sh[0] = ctl_sheet(st[..]);
    s := uiskin(id); m := ctl_measure(id, a[..]);
    slider(sh[..], s, 10, 0, 200, 0.25, 4, 1);
    #assert sh[0].under[1].w == 50 && sh[0].hits[0].w == 200 && sh[0].hits[0].a == 1;
    labels := [3] string.["Chat", "Files", "Runs"];
    nu := sh[0].nu;
    tw := tabs(sh[..], m, s, 0, 40, labels[..], 1, -1, 5, 0);
    #assert sh[0].nh == 4 && sh[0].hits[2].b == 1 && sh[0].hits[3].b == 2 && sh[0].hits[2].x > sh[0].hits[1].x && tw > 0;
    #assert sh[0].over[1].fill.r == s.ink.r && sh[0].over[0].fill.r == s.muted.r && sh[0].nu > nu;
    rows := [3] string.["One", "Two", "Three"];
    h := list_rows(sh[..], m, s, 0, 100, 120, "Recent", rows[..], 2, 0, 6, 9);
    #assert h == s.small.line + s.space / 2 + 3 * s.control_h && sh[0].nh == 7 && sh[0].hits[6].b == 2 && sh[0].hits[6].a == 9 && sh[0].hits[6].y == 100 + h - s.control_h;
    bh := bar(sh[..], s, 0, 300, 100, 0.5, s.success);
    #assert bh > 0 && sh[0].under[sh[0].nu - 1].w == 50 && sh[0].under[sh[0].nu - 1].fill.g == s.success.g;
  }
  #assert slider_value(10, 200, 60) == 0.25 && slider_value(10, 200, 0) == 0 && slider_value(10, 200, 999) == 1 && slider_value(0, 0, 5) == 0;
}
#test "a panel frames its content: the title in the title face, the content inside the padding" {
  st: [1] CtlStore; a: [1] Atlas; text_test_atlas(a[..]);
  for id: 0..<UISKINS {
    sh: [1] Sheet; sh[0] = ctl_sheet(st[..]);
    s := uiskin(id); m := ctl_measure(id, a[..]);
    inside := panel(sh[..], m, s, 10, 20, 300, panel_height(s, 100, true), "Title");
    #assert inside.x == 10 + s.pad && inside.w == 300 - 2 * s.pad && inside.y == 20 + s.pad + s.title.line + s.space;
    #assert sh[0].over[0].text == "Title" && sh[0].over[0].id == s.title.face && sh[0].nu >= 1;
    #assert panel_height(s, 100, false) == 100 + 2 * s.pad;
  }
}

// ---------------------------------------------------------------- the frame context (GitHub #13645, stage G0)

// A surface over a test's own arrays, and a keyed store.
CtxStore :: struct { a: [1] CtlStore; b: [1] CtlStore; rows_a: [24] El; rows_b: [24] El; keyed: [8] Keyed; }
ctx_surface :: (st: [] CtxStore) -> UiSurface {
  return surface_over(ctl_sheet(st[0].a[..]), st[0].rows_a[..], ctl_sheet(st[0].b[..]), st[0].rows_b[..]);
}
ctx_same_color :: (a: Rgba, b: Rgba) -> bool { return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a; }
// Two primitives are the same primitive.
ctx_same_prim :: (a: Prim, b: Prim) -> bool {
  return a.kind == b.kind && a.x == b.x && a.y == b.y && a.w == b.w && a.h == b.h && a.radius == b.radius && a.border == b.border
    && ctx_same_color(a.fill, b.fill) && ctx_same_color(a.edge, b.edge) && a.a == b.a && a.b == b.b && a.c == b.c && a.d == b.d
    && a.id == b.id && a.on == b.on && a.text == b.text && a.line == b.line && a.off == b.off && a.pts.count == b.pts.count;
}
// Two sheets hold the same display lists, and hits over the same boxes.
ctx_same_sheet :: (a: Sheet, b: Sheet) -> bool {
  if a.nu != b.nu || a.no != b.no || a.nh != b.nh || a.nl != b.nl || a.np != b.np { return false; }
  for i: 0..<a.nu { if !ctx_same_prim(a.under[i], b.under[i]) { return false; } }
  for i: 0..<a.no { if !ctx_same_prim(a.over[i], b.over[i]) { return false; } }
  for i: 0..<a.nh { if a.hits[i].x != b.hits[i].x || a.hits[i].y != b.hits[i].y || a.hits[i].w != b.hits[i].w || a.hits[i].h != b.hits[i].h { return false; } }
  return true;
}
// The seven controls, laid out once through the context forms. `rest` puts no pointer on them.
ctx_all :: (f: [] UiFrame) {
  s := f[0].skin;
  tab_ids := [3] string.["tab.chat", "tab.files", "tab.runs"]; labels := [3] string.["Chat", "Files", "Runs"];
  row_ids := [3] string.["row.one", "row.two", "row.three"]; rows := [3] string.["One", "Two", "Three"];
  inside := ctx_panel(f, "panel", 0, 0, 400, 600, "Title");
  _ = ctx_button(f, "send", 10, 60, "Send", true, 0, 11);
  _ = ctx_button(f, "cancel", 200, 60, "Cancel", false, 0, 12);
  _ = ctx_toggle(f, "wrap", 10, 110, "Wrap", true, 0, 13);
  ctx_slider(f, "volume", 10, 160, 200, "Volume", 0.25, 0, 14);
  _ = ctx_tabs(f, tab_ids[..], 10, 210, labels[..], 1, 15);
  _ = ctx_list(f, row_ids[..], 10, 260, 120, "Recent", rows[..], 2, 16);
  _ = ctx_bar(f, "usage", 10, 500, 100, "Usage", 0.5, s.success);
  ctx_panel_end(f);
}
// The same seven through the forms that take a sheet, a measure and a skin.
ctx_all_before :: (sh: [] Sheet, m: TextMeasure, s: UiSkin) {
  labels := [3] string.["Chat", "Files", "Runs"]; rows := [3] string.["One", "Two", "Three"];
  inside := panel(sh, m, s, 0, 0, 400, 600, "Title");
  _ = button(sh, m, s, 10, 60, "Send", UISKIN_PRIMARY, 1, 0);
  _ = button(sh, m, s, 200, 60, "Cancel", UISKIN_REST, 1, 1);
  _ = toggle(sh, m, s, 10, 110, "Wrap", true, 2, 0);
  slider(sh, s, 10, 160, 200, 0.25, 3, 0);
  _ = tabs(sh, m, s, 10, 210, labels[..], 1, -1, 4, 0);
  _ = list_rows(sh, m, s, 10, 260, 120, "Recent", rows[..], 2, -1, 5, 0);
  _ = bar(sh, s, 10, 500, 100, 0.5, s.success);
}

#test "the context forms paint the same primitives as the forms before them, in every skin" #steps 100000000 {
  st: [1] CtxStore; old: [1] CtlStore; bare: [1] CtlStore; a: [1] Atlas; text_test_atlas(a[..]);
  for id: 0..<UISKINS {
    s := uiskin(id); m := ctl_measure(id, a[..]);
    before: [1] Sheet; before[0] = ctl_sheet(old[..]);
    ctx_all_before(before[..], m, s);
    #assert before[0].nu > 8 && before[0].no > 8 && before[0].nh == 10 && before[0].lost == 0;
    // on a surface, with rows and keyed state
    sf := [1] UiSurface.[ctx_surface(st[..])]; ks := [1] KeyedStore.[KeyedStore.{rows = st[0].keyed[..]}]; f: [1] UiFrame;
    uiframe_begin(f[..], sf[..], ks[..], m, s, UiInput.{}, 0, 0.016, false, false);
    ctx_all(f[..]);
    #assert uiframe_end(f[..], sf[..]) && ctx_same_sheet(surface_sheet(sf[..]), before[0]) && surface_rows(sf[..]).n == 12;
    // through the adapter: a context over a sheet, a measure and a skin alone
    plain: [1] Sheet; plain[0] = ctl_sheet(bare[..]); g := [1] UiFrame.[uiframe_over(plain[..], m, s)];
    ctx_all(g[..]);
    #assert ctx_same_sheet(plain[0], before[0]) && plain[0].hits[0].kind == UIFRAME_HIT && uiframe_hit_row(plain[0].hits[0]) == -1;
  }
}
#test "each context control records its row and its hit together, under its id" {
  st: [1] CtxStore; a: [1] Atlas; text_test_atlas(a[..]); s := zeron_skin(); m := measure_font(a[..]);
  sf := [1] UiSurface.[ctx_surface(st[..])]; ks := [1] KeyedStore.[KeyedStore.{rows = st[0].keyed[..]}]; f: [1] UiFrame;
  uiframe_begin(f[..], sf[..], ks[..], m, s, uiinput(0, 0, false, false, "", "wrap"), 0, 0.016, false, false);
  ctx_all(f[..]);
  #assert uiframe_end(f[..], sf[..]);
  out: [2048] u8; t := [1] ElTable.[surface_rows(sf[..])]; n := elt_detail(t[..], out[..]);
  got := cast(string) out[0..<n];
  #assert el_has(got, "panel region \"Title\" at 0 0 size 400x600\n");
  #assert el_has(got, "send button \"Send\" at 10 60 size 56x32 action 11 focus 1 in panel\n");
  #assert el_has(got, "cancel button \"Cancel\" at 200 60 size 72x32 action 12 focus 2 in panel\n");
  #assert el_has(got, "wrap toggle \"Wrap\" at 10 110 size 75x32 [checked focused checks] action 13 focus 3 in panel\n");
  #assert el_has(got, "volume slider \"Volume\" at 10 160 size 200x32 value \"25%\" action 14 focus 4 in panel\n");
  #assert el_has(got, "tab.chat tab \"Chat\" at 10 210 size 56x32 action 15 focus 5 in panel\n");
  #assert el_has(got, "tab.files tab \"Files\" at 70 210 size 64x32 [current] action 15 focus 6 in panel\n");
  #assert el_has(got, "tab.runs tab \"Runs\" at 138 210 size 56x32 action 15 focus 7 in panel\n");
  #assert el_has(got, "row.one row \"One\" at 10 282 size 120x32 action 16 focus 8 in panel\n");
  #assert el_has(got, "row.two row \"Two\" at 10 314 size 120x32 action 16 focus 9 in panel\n");
  #assert el_has(got, "row.three row \"Three\" at 10 346 size 120x32 [current] action 16 focus 10 in panel\n");
  #assert el_has(got, "usage progress \"Usage\" at 10 500 size 100x8 value \"50%\" in panel\n");
  #assert got.count == 41 + 66 + 71 + 92 + 84 + 68 + 80 + 69 + 67 + 67 + 82 + 56 + 9;
  // every hit names a row of the same generation, over the row's own box
  sh := surface_sheet(sf[..]);
  #assert sh.nh == 10;
  for i: 0..<sh.nh {
    r := uiframe_hit_row(sh.hits[i]);
    #assert r >= 1 && r <= 10 && t[0].rows[r].x == sh.hits[i].x && t[0].rows[r].y == sh.hits[i].y && t[0].rows[r].w == sh.hits[i].w && t[0].rows[r].h == sh.hits[i].h;
  }
  // a press is routed through the committed rows
  hit := surface_hit(sf[..], 80, 220); #assert surface_id(sf[..], hit) == "tab.files" && surface_action(sf[..], hit) == 15;
  #assert surface_id(sf[..], surface_hit(sf[..], 300, 400)) == "panel" && surface_id(sf[..], surface_focus_step(sf[..], surface_find(sf[..], "row.three"), false)) == "send";
}
#test "hover, press, focus and disabled come from the input snapshot and the row's state" {
  st: [1] CtxStore; a: [1] Atlas; text_test_atlas(a[..]); s := zeron_skin(); m := measure_font(a[..]);
  sf := [1] UiSurface.[ctx_surface(st[..])]; ks := [1] KeyedStore.[KeyedStore.{rows = st[0].keyed[..]}]; f: [1] UiFrame;
  // frame 1: no pointer. Frame 2: the pointer is over Cancel, as frame 1 committed it.
  uiframe_begin(f[..], sf[..], ks[..], m, s, UiInput.{}, 0, 0.016, false, false);
  _ = ctx_button(f[..], "cancel", 200, 60, "Cancel", false, 0, 12); _ = ctx_button(f[..], "off", 10, 60, "Off", true, EL_S_DISABLED, 9);
  #assert uiframe_end(f[..], sf[..]) && surface_sheet(sf[..]).under[0].fill.r == s.raised.r;
  off := surface_sheet(sf[..]); #assert off.under[1].fill.r == s.raised.r && off.over[1].fill.r == s.faint.r && off.nh == 2;
  uiframe_begin(f[..], sf[..], ks[..], m, s, uiinput(210, 70, true, true, "cancel", "cancel"), 0.016, 0.016, false, false);
  #assert uiframe_hovered(f[..], "cancel") && uiframe_pressed(f[..], "cancel") && uiframe_focused(f[..], "cancel") && !uiframe_hovered(f[..], "off") && uiframe_look(f[..], "cancel", false) == UISKIN_HOVER;
  _ = ctx_button(f[..], "cancel", 200, 60, "Cancel", false, 0, 12);
  k := uiframe_key(f[..], "cancel"); p := uiframe_press(f[..], k, "cancel");
  #assert k >= 0 && p > 0 && p < 1 && uiframe_key(f[..], "cancel") == -1 && ks[0].refused_duplicate == 1 && uiframe_entry(f[..], k) > 0 && uiframe_moving(f[..]);
  #assert uiframe_end(f[..], sf[..]) && surface_sheet(sf[..]).under[0].fill.r == s.hover.r;
  t := [1] ElTable.[surface_rows(sf[..])]; #assert elt_has(t[..], 0, EL_S_PRESSED | EL_S_FOCUSED);
  // frame 3: the pointer is lifted and "cancel" is not keyed, so its state retires
  uiframe_begin(f[..], sf[..], ks[..], m, s, uiinput(210, 70, false, false, "", ""), 0.032, 0.016, true, true);
  #assert !uiframe_hovered(f[..], "cancel") && f[0].reduced_motion && f[0].reduced_transparency && f[0].clock == 0.032;
  _ = ctx_button(f[..], "cancel", 200, 60, "Cancel", false, 0, 12);
  #assert uiframe_end(f[..], sf[..]) && ks[0].live == 0 && ks[0].retired == 1 && surface_sheet(sf[..]).under[0].fill.r == s.raised.r;
  out: [256] u8; n := uiframe_counts(sf[..], ks[..], out[..]);
  #assert cast(string) out[0..<n] == "generation 3 refused 0 lost 0 prims 1/128 text 1/128 hits 1/32 rows 1/24\nkeyed 0/8 refused 1 (full 0, duplicate 0 this frame) retired 1\n";
}
// One frame of the focus check: a field, a disabled field and a button; returns who has the keyboard.
ctx_focus_frame :: (f: [] UiFrame, sf: [] UiSurface, ks: [] KeyedStore, m: TextMeasure, s: UiSkin, in: UiInput) -> string {
  uiframe_begin(f, sf, ks, m, s, in, 0, 0.016, true, false);
  _ = uiframe_row(f, "email", EL_FIELD, "Email", 10, 10, 200, 40, 0, 1);
  _ = uiframe_row(f, "locked", EL_FIELD, "Locked", 10, 60, 200, 40, EL_S_DISABLED, 0);
  _ = ctx_button(f, "send", 10, 110, "Send", true, 0, 2);
  focus := uiframe_focus(f);
  #assert uiframe_end(f, sf);
  return focus;
}
#test "focus follows a press: a press on a text field takes the keyboard, a press anywhere else gives it up" {
  st: [1] CtxStore; a: [1] Atlas; text_test_atlas(a[..]); s := zeron_skin(); m := measure_font(a[..]);
  sf := [1] UiSurface.[ctx_surface(st[..])]; ks := [1] KeyedStore.[KeyedStore.{rows = st[0].keyed[..]}]; f: [1] UiFrame;
  // before anything is committed, the app's focus stands
  #assert ctx_focus_frame(f[..], sf[..], ks[..], m, s, uiinput(0, 0, false, false, "", "email")) == "email" && !uiframe_focus_moved(f[..]) && uiframe_keyboard(f[..]);
  // a press on the field it already has changes nothing; a press on nothing takes the keyboard away
  #assert ctx_focus_frame(f[..], sf[..], ks[..], m, s, uiinput(20, 20, true, true, "email", "email")) == "email" && !uiframe_focus_moved(f[..]);
  #assert ctx_focus_frame(f[..], sf[..], ks[..], m, s, uiinput(300, 300, true, true, "", "email")) == "" && uiframe_focus_moved(f[..]) && !uiframe_keyboard(f[..]);
  // the field's row is no longer focused in the frame the press lands
  t := [1] ElTable.[surface_rows(sf[..])]; #assert !elt_has(t[..], elt_find(t[..], "email"), EL_S_FOCUSED);
  // a press on the field gives it the keyboard; a press on a button takes it away; a disabled field never takes it
  #assert ctx_focus_frame(f[..], sf[..], ks[..], m, s, uiinput(20, 20, true, true, "email", "")) == "email" && uiframe_focus_moved(f[..]);
  #assert ctx_focus_frame(f[..], sf[..], ks[..], m, s, uiinput(20, 120, true, true, "send", "email")) == "" && uiframe_focus_moved(f[..]);
  #assert ctx_focus_frame(f[..], sf[..], ks[..], m, s, uiinput(20, 70, true, true, "locked", "")) == "" && !uiframe_focus_moved(f[..]);
  // a control the keyboard stepped to keeps focus through a press elsewhere; a lifted pointer changes nothing
  #assert ctx_focus_frame(f[..], sf[..], ks[..], m, s, uiinput(300, 300, true, true, "", "send")) == "send" && !uiframe_focus_moved(f[..]);
  #assert ctx_focus_frame(f[..], sf[..], ks[..], m, s, uiinput(300, 300, false, false, "", "email")) == "email" && !uiframe_focus_moved(f[..]);
}
#test "a frame that overflows its surface is refused whole; a clip cuts paint and presses together" {
  st: [1] CtxStore; a: [1] Atlas; text_test_atlas(a[..]); s := zeron_skin(); m := measure_font(a[..]);
  sf := [1] UiSurface.[ctx_surface(st[..])]; ks := [1] KeyedStore.[KeyedStore.{rows = st[0].keyed[..]}]; f: [1] UiFrame;
  uiframe_begin(f[..], sf[..], ks[..], m, s, UiInput.{}, 0, 0.016, false, false);
  uiframe_clip(f[..], 0, 0, 400, 70);
  _ = ctx_button(f[..], "half", 10, 60, "Half", false, 0, 1);       // y 60..<92: only 60..<70 shows
  uiframe_unclip(f[..]);
  _ = uiframe_row(f[..], "note", EL_TEXT, "Read me", 10, 100, 100, 20, 0, 0);
  #assert uiframe_end(f[..], sf[..]);
  sh := surface_sheet(sf[..]);
  #assert sh.under[0].kind == PRIM_CLIP && sh.under[0].on && sh.over[0].kind == PRIM_CLIP && sh.nh == 1 && surface_rows(sf[..]).n == 2;
  #assert surface_id(sf[..], surface_hit(sf[..], 20, 65)) == "half" && surface_hit(sf[..], 20, 80) == -1 && surface_id(sf[..], surface_hit(sf[..], 20, 110)) == "note";
  // 33 buttons need 33 hits and 33 rows: more than the surface declares
  uiframe_begin(f[..], sf[..], ks[..], m, s, UiInput.{}, 0, 0.016, false, false);
  name: [EL_ID] u8;
  for k: 0..<33 { n := el_put_i(name[..], el_copy(name[..], "b."), k); _ = ctx_button(f[..], cast(string) name[0..<n], 0, cast(f32) k * 40, "B", false, 0, 1); }
  #assert !uiframe_end(f[..], sf[..]) && sf[0].refused == 1 && sf[0].last.rows == 9 && sf[0].last.sheet == 1 && sf[0].generation == 1;
  // the committed frame is still the first one, in paint, hits and rows
  sh = surface_sheet(sf[..]);
  #assert sh.nh == 1 && sh.under[0].kind == PRIM_CLIP && surface_rows(sf[..]).n == 2 && surface_id(sf[..], 0) == "half" && surface_find(sf[..], "b.0") == -1;
}

SayStore :: struct { a: [1] CtlStore; b: [1] CtlStore; pa: [512] u8; pb: [512] u8; rows_a: [8] El; rows_b: [8] El; }
#test "a screen reader hears a long label whole and text added after it; a bridge reads the part a clip leaves" {
  st: [1] SayStore; a: [1] Atlas; text_test_atlas(a[..]); s := zeron_skin(); m := measure_font(a[..]);
  sa := ctl_sheet(st[0].a[..]); sa.pool = st[0].pa[..]; sb := ctl_sheet(st[0].b[..]); sb.pool = st[0].pb[..];
  sf := [1] UiSurface.[surface_over(sa, st[0].rows_a[..], sb, st[0].rows_b[..])]; ks := [1] KeyedStore.[KeyedStore.{}]; f: [1] UiFrame;
  uiframe_begin(f[..], sf[..], ks[..], m, s, UiInput.{}, 0, 0.016, false, false);
  long := "This reply is longer than the sixty-four bytes that a row label holds, so it is kept whole.";
  i := uiframe_semantic(f[..], "reply", EL_TEXT, long, 0, 0, 100, 40, EL_S_LIVE, 0);
  uiframe_say(f[..], i, "Second block.");
  j := uiframe_semantic(f[..], "note", EL_TEXT, "Short", 0, 50, 100, 20, 0, 0);
  _ := sheet_pool(f[0].sheet, "x");
  // the reply no longer ends the pool: what it says moves to the end, whole
  uiframe_say(f[..], j, "More.");
  uiframe_say(f[..], i, "Third.");
  uiframe_say(f[..], -1, "nothing");
  uiframe_clip(f[..], 0, 0, 100, 60);
  k := uiframe_semantic(f[..], "cut", EL_BUTTON, "Cut", 0, 40, 100, 40, 0, 1);
  uiframe_unclip(f[..]);
  #assert uiframe_end(f[..], sf[..]);
  t := [1] ElTable.[surface_rows(sf[..])];
  #assert elt_label(t[..], i).count == 64 && surface_say(sf[..], i) == "This reply is longer than the sixty-four bytes that a row label holds, so it is kept whole.\nSecond block.\nThird.";
  #assert surface_say(sf[..], j) == "Short\nMore." && surface_say(sf[..], k) == "Cut" && surface_say(sf[..], 9) == "";
  row: [8] f32;
  #assert surface_access_row(sf[..], k, 2, row[..]) && row[1] == 80 && row[2] == 200 && row[3] == 40 && row[4] == cast(f32) EL_BUTTON && row[6] == -1 && row[7] == 1;
  #assert surface_access_row(sf[..], i, 1, row[..]) && cast(int) row[5] == EL_S_LIVE && !surface_access_row(sf[..], 9, 1, row[..]);
  // the stamp moves when only the spoken text does
  before := surface_stamp(sf[..]);
  uiframe_begin(f[..], sf[..], ks[..], m, s, UiInput.{}, 0, 0.016, false, false);
  i = uiframe_semantic(f[..], "reply", EL_TEXT, long, 0, 0, 100, 40, EL_S_LIVE, 0);
  uiframe_say(f[..], i, "Second block.");
  j = uiframe_semantic(f[..], "note", EL_TEXT, "Short", 0, 50, 100, 20, 0, 0);
  _ = uiframe_semantic(f[..], "cut", EL_BUTTON, "Cut", 0, 40, 100, 40, 0, 1);
  #assert uiframe_end(f[..], sf[..]) && surface_stamp(sf[..]) != before;
}
