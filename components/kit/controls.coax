// The small controls: panel, button, toggle, slider, tabs, list and bar
// (components/spec.md, GitHub #13153). Each is laid out through a measure
// and painted onto a sheet in a skin, so the same call draws it in Zeron's
// glass, Everglade's iron, the Metaverse's lines or a terminal's cells. A
// control that can be pressed leaves a hit on the sheet (the caller's kind
// and number); the caller keeps the state (which tab, how far a slider is)
// and says how each control looks this frame (resting, hovered, primary).
//   coax/bin/coax test components/kit/controls-checks.coax

#load "../paint/sheet.coax";
#load "../skin/skin.coax";

// ---------------------------------------------------------------- panel

// Where a panel's content goes: its left, its top and its width.
PanelInside :: struct { x: f32; y: f32; w: f32; }

// A panel: the skin's frame around (x, y, w, h), and its title, if it has one.
panel :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, x: f32, y: f32, w: f32, h: f32, title: string) -> PanelInside {
  sh[0].nu = uiskin_panel(sh[0].under, sh[0].nu, s, x, y, w, h);
  cy := y + s.pad;
  if title.count > 0 {
    tw := sheet_text(sh, m, -1, x + s.pad, cy, s.title.line, s.title.face, s.ink, title);
    cy += s.title.line + s.space;
  }
  return PanelInside.{x = x + s.pad, y = cy, w = w - 2 * s.pad};
}
// The height a panel needs for content h tall.
panel_height :: (s: UiSkin, content: f32, titled: bool) -> f32 {
  return content + 2 * s.pad + (ifx titled then s.title.line + s.space else 0.0f32);
}

// ---------------------------------------------------------------- button

button_width :: (m: TextMeasure, s: UiSkin, label: string) -> f32 {
  return ceil(measure_width(m, s.label.face, label)) + 2 * s.control_pad;
}
// A button at (x, y) in a state (UISKIN_REST, UISKIN_HOVER, UISKIN_PRIMARY). Returns its width.
button :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, x: f32, y: f32, label: string, state: int, hit_kind: int, hit_a: int) -> f32 {
  w := button_width(m, s, label);
  sh[0].nu = uiskin_control(sh[0].under, sh[0].nu, s, x, y, w, s.control_h, state);
  ty := y + (s.control_h - s.label.line) / 2;
  tw := sheet_text(sh, m, -1, x + s.control_pad, ty, s.label.line, s.label.face, ifx state == UISKIN_PRIMARY then s.on_accent else s.ink, label);
  sheet_hit(sh, hit_kind, hit_a, 0, x, y, w, s.control_h);
  return w;
}

// ---------------------------------------------------------------- toggle

// A toggle with its label after it. Returns its width.
toggle :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, x: f32, y: f32, label: string, on: bool, hit_kind: int, hit_a: int) -> f32 {
  sh[0].nu = uiskin_toggle(sh[0].under, sh[0].nu, s, x, y, on);
  tw := uiskin_toggle_width(s);
  ty := y + (s.control_h - s.body.line) / 2;
  lw := sheet_text(sh, m, -1, x + tw + s.space, ty, s.body.line, s.body.face, ifx on then s.ink else s.muted, label);
  w := tw + s.space + lw;
  sheet_hit(sh, hit_kind, hit_a, 0, x, y, w, s.control_h);
  return w;
}

// ---------------------------------------------------------------- slider

// A slider w wide, filled to value (0..1), with its hit over the whole row;
// slider_value reads a pointer's x back into a value.
slider :: (sh: [] Sheet, s: UiSkin, x: f32, y: f32, w: f32, value: f32, hit_kind: int, hit_a: int) {
  v := ifx value < 0 then 0.0f32 else ifx value > 1 then 1.0f32 else value;
  th := s.slider_track;
  ty := y + (s.control_h - th) / 2;
  sh[0].nu = uiskin_bar(sh[0].under, sh[0].nu, s, x, ty, w, th, v, s.accent);
  if s.knob > 0 {
    // the knob, centred on the value
    k := s.knob;
    kx := x + (w - k) * v;
    knob_skin:=s;if knob_skin.radius_control>k/2 {knob_skin.radius_control=k/2;}
    sh[0].nu = uiskin_control(sh[0].under, sh[0].nu, knob_skin, kx, y + (s.control_h - k) / 2, k, k, UISKIN_PRIMARY);
  }
  sheet_hit(sh, hit_kind, hit_a, 0, x, y, w, s.control_h);
}
slider_value :: (x: f32, w: f32, px: f32) -> f32 {
  if w <= 0 { return 0; }
  v := (px - x) / w;
  return ifx v < 0 then 0.0f32 else ifx v > 1 then 1.0f32 else v;
}

// Wrapped row copy uses the shared line wrapper and the skin's type roles.
control_copy :: (sh:[]Sheet,m:TextMeasure,face:UiType,color:Rgba,x:f32,y:f32,w:f32,text:string)->f32 {
 if text.count==0 {return 0;}
 lines:[16]TextLine;runs:[1]MdRun;faces:=TextFaces.{plain=face.face,bold=face.face,code=face.face};
 n:=text_wrap(m,faces,text,runs[0..<0],ifx w>1 then w else 1.0f32,lines[..]);
 for i:0..<n {_:=sheet_text(sh,m,-1,x,y+cast(f32)i*face.line,face.line,face.face,color,cast(string)text[lines[i].from..<lines[i].to]);}
 return cast(f32)n*face.line;
}
// A choice row's title, supporting copy and trailing selected mark. The caller
// supplies the platform atlas's check icon and owns the selected state.
choice_row :: (sh:[]Sheet,m:TextMeasure,s:UiSkin,x:f32,y:f32,w:f32,title:string,detail:string,selected:bool,check:int,hit_kind:int,hit_a:int,hit_b:int)->f32 {
 pad:=s.control_pad;icon:=s.body.line;copy_w:=w-2*pad-icon-s.space;
 h:=control_copy(sh,m,s.body,s.ink,x+pad,y+pad,copy_w,title);
 h+=control_copy(sh,m,s.small,s.muted,x+pad,y+pad+h,copy_w,detail);
 h+=2*pad;if h<s.control_h {h=s.control_h;}
 if selected {sheet_icon(sh,check,x+w-pad-icon,y+(h-icon)/2,icon,s.accent);}
 sheet_hit(sh,hit_kind,hit_a,hit_b,x,y,w,h);return h;
}
// A descriptive setting with a trailing switch. Its entire row is a target.
setting_toggle_row :: (sh:[]Sheet,m:TextMeasure,s:UiSkin,x:f32,y:f32,w:f32,title:string,detail:string,on:bool,hit_kind:int,hit_a:int,hit_b:int)->f32 {
 pad:=s.control_pad;tw:=uiskin_toggle_width(s);copy_w:=w-2*pad-tw-s.space;
 h:=control_copy(sh,m,s.body,s.ink,x+pad,y+pad,copy_w,title);
 h+=control_copy(sh,m,s.small,s.muted,x+pad,y+pad+h,copy_w,detail);
 h+=2*pad;if h<s.control_h {h=s.control_h;}
 sh[0].nu=uiskin_toggle(sh[0].under,sh[0].nu,s,x+w-pad-tw,y+(h-s.control_h)/2,on);
 sheet_hit(sh,hit_kind,hit_a,hit_b,x,y,w,h);return h;
}

// A row with an icon, wrapped copy and a trailing disclosure icon.
icon_detail_row :: (sh:[]Sheet,m:TextMeasure,s:UiSkin,x:f32,y:f32,w:f32,icon:int,title:string,detail:string,disclosure:int,hit_kind:int,hit_a:int,hit_b:int)->f32 {
 pad:=s.control_pad;mark:=s.body.line;tx:=x+pad+mark+s.space;copy_w:=w-2*pad-2*mark-2*s.space;
 h:=control_copy(sh,m,s.body,s.ink,tx,y+pad,copy_w,title);
 h+=control_copy(sh,m,s.small,s.muted,tx,y+pad+h,copy_w,detail);
 h+=2*pad;if h<s.control_h {h=s.control_h;}
 sheet_icon(sh,icon,x+pad,y+(h-mark)/2,mark,s.muted);
 if disclosure>=0 {sheet_icon(sh,disclosure,x+w-pad-mark,y+(h-mark)/2,mark,s.faint);}
 sheet_hit(sh,hit_kind,hit_a,hit_b,x,y,w,h);return h;
}
// A centered header with independently reachable leading and trailing actions.
header_actions :: (sh:[]Sheet,m:TextMeasure,s:UiSkin,x:f32,y:f32,w:f32,title:string,leading:int,trailing:int,hit_kind:int,hit_a:int) {
 side:=s.control_h;sz:=s.body.line;inset:=(side-sz)/2;
 if leading>=0 {sh[0].nu=uiskin_control(sh[0].under,sh[0].nu,s,x,y,side,side,UISKIN_REST);sheet_icon(sh,leading,x+inset,y+inset,sz,s.ink);sheet_hit(sh,hit_kind,hit_a,0,x,y,side,side);}
 if trailing>=0 {sh[0].nu=uiskin_control(sh[0].under,sh[0].nu,s,x+w-side,y,side,side,UISKIN_REST);sheet_icon(sh,trailing,x+w-side+inset,y+inset,sz,s.ink);sheet_hit(sh,hit_kind,hit_a,1,x+w-side,y,side,side);}
 lines:[1]TextLine;runs:[1]MdRun;faces:=TextFaces.{plain=s.title.face,bold=s.title.face,code=s.title.face};
 n:=text_wrap(m,faces,title,runs[0..<0],ifx w>2*side then w-2*side else 1.0f32,lines[..]);
 if n>0 {part:=cast(string)title[lines[0].from..<lines[0].to];tw:=measure_width(m,s.title.face,part);_:=sheet_text(sh,m,-1,x+(w-tw)/2,y+(side-s.title.line)/2,s.title.line,s.title.face,s.ink,part);}
}
// A single-line picker with its value and disclosure at the trailing edge.
picker_row :: (sh:[]Sheet,m:TextMeasure,s:UiSkin,x:f32,y:f32,w:f32,title:string,value:string,disclosure:int,hit_kind:int,hit_a:int,hit_b:int)->f32 {
 pad:=s.control_pad;mark:=s.body.line;lines:[1]TextLine;value_lines:[1]TextLine;runs:[1]MdRun;faces:=TextFaces.{plain=s.body.face,bold=s.body.face,code=s.body.face};
 max_value:=(w-2*pad-mark-2*s.space)/2;vn:=text_wrap(m,faces,value,runs[0..<0],ifx max_value>1 then max_value else 1.0f32,value_lines[..]);
 shown:=ifx vn>0 then cast(string)value[value_lines[0].from..<value_lines[0].to] else "";
 vw:=measure_width(m,s.body.face,shown);vx:=x+w-pad-mark-s.space-vw;title_w:=vx-(x+pad)-s.space;
 n:=text_wrap(m,faces,title,runs[0..<0],ifx title_w>1 then title_w else 1.0f32,lines[..]);
 ty:=y+(s.control_h-s.body.line)/2;
 if n>0 {_:=sheet_text(sh,m,-1,x+pad,ty,s.body.line,s.body.face,s.ink,cast(string)title[lines[0].from..<lines[0].to]);}
 _:=sheet_text(sh,m,-1,vx,ty,s.body.line,s.body.face,s.muted,shown);
 sheet_icon(sh,disclosure,x+w-pad-mark,ty,mark,s.faint);sheet_hit(sh,hit_kind,hit_a,hit_b,x,y,w,s.control_h);return s.control_h;
}

// ---------------------------------------------------------------- tabs

// A row of tabs, one active (hit b = its index). Returns the row's width.
tabs :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, x: f32, y: f32, labels: [] string, active: int, hot: int, hit_kind: int, hit_a: int) -> f32 {
  pen := x;
  for k: 0..<labels.count {
    w := ceil(measure_width(m, s.label.face, labels[k])) + 2 * s.control_pad;
    if k == active || k == hot { sh[0].nu = uiskin_control(sh[0].under, sh[0].nu, s, pen, y, w, s.control_h, UISKIN_HOVER); }
    ty := y + (s.control_h - s.label.line) / 2;
    tw := sheet_text(sh, m, -1, pen + s.control_pad, ty, s.label.line, s.label.face, ifx k == active then s.ink else s.muted, labels[k]);
    // the active tab's mark: a rule in the accent under its label (a terminal has no room under a one-row tab)
    if k == active && s.control_h > s.label.line { sheet_rule(sh, pen + s.control_pad, y + s.control_h - 2 * s.border, w - 2 * s.control_pad, s.border, s.accent); }
    if sh[0].nh < sh[0].hits.count { sh[0].hits[sh[0].nh] = SheetHit.{x = pen, y = y, w = w, h = s.control_h, kind = hit_kind, a = hit_a, b = k}; sh[0].nh += 1; }
    pen += w + s.space / 2;
  }
  return pen - x;
}

// ---------------------------------------------------------------- list

// A list with a section heading: a caption, then a row for each entry, the
// picked one in the accent's wash and the hovered one lit (hit b = its
// index). Returns its height.
list_rows :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, x: f32, y: f32, w: f32, section: string, rows: [] string, picked: int, hot: int, hit_kind: int, hit_a: int) -> f32 {
  h: f32 = 0;
  if section.count > 0 {
    cw := sheet_text(sh, m, -1, x + s.control_pad, y, s.small.line, s.small.face, s.faint, section);
    h += s.small.line + s.space / 2;
  }
  for k: 0..<rows.count {
    ry := y + h;
    if k == picked { sh[0].nu = uiskin_control(sh[0].under, sh[0].nu, s, x, ry, w, s.control_h, UISKIN_HOVER); }
    else if k == hot { sheet_fill(sh, x, ry, w, s.control_h, s.radius_control, s.hover); }
    ty := ry + (s.control_h - s.body.line) / 2;
    tw := sheet_text(sh, m, -1, x + s.control_pad, ty, s.body.line, s.body.face, ifx k == picked then s.ink else s.muted, rows[k]);
    if sh[0].nh < sh[0].hits.count { sh[0].hits[sh[0].nh] = SheetHit.{x = x, y = ry, w = w, h = s.control_h, kind = hit_kind, a = hit_a, b = k}; sh[0].nh += 1; }
    h += s.control_h;
  }
  return h;
}

// ---------------------------------------------------------------- bar

// A bar filled to a share (0..1) in a colour role the caller picks from the skin. Returns its height.
bar :: (sh: [] Sheet, s: UiSkin, x: f32, y: f32, w: f32, share: f32, color: Rgba) -> f32 {
  h := s.bar_h;
  sh[0].nu = uiskin_bar(sh[0].under, sh[0].nu, s, x, y, w, h, share, color);
  return h;
}
