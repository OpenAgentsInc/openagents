// The dock: the frames set's pieces for panes that stand round something else (a canvas, a
// document, a map) and leave it showing (GitHub #13416). A dock is a layer over the page that
// takes no press itself; a pane is a panel on one of its sides with a strip of controls or a
// body that scrolls inside it; a prop is a field with its name beside it; a stepper is a value with
// a button to lower it and one to raise it; a slider is a value dragged along a line; a switch row is a
// named thing that is on or off. Each builds nodes in
// the tree and nothing else; every look is the skin's (components/skin/mono.coax, mono_dock_css).
//   coax/bin/coax test components/kit/dock.coax

#load "frames.coax";
#load "settings.coax";   // the one switch (k_switch)

DK_TOP :: 0; DK_LEFT :: 1; DK_RIGHT :: 2; DK_BOTTOM :: 3;
DK_WIDE :: 4;          // the right side, wide: a pane that holds a file of code
DK_SIDES :: [5] string.["pane pane-t", "pane pane-l", "pane pane-r", "pane pane-bm", "pane pane-r pane-w"];

// Dock: opens the layer. `over`: it lies over the whole window, and what is under it shows and
// takes the pointer wherever no pane is; else it stands in the page where it is put, as tall as
// the skin says. Close it with tr_close.
k_dock :: (t: [] Tree, id: string, over: bool) -> int { return tr_open(t, id, TG_DIV, ifx over then "dock dock-over" else "dock"); }
// Pane: a panel on a side of the dock, with its title when it has one. The top pane is a strip:
// its controls stand in a row. A side pane's content scrolls inside it, and the bottom pane lies
// across the foot. A wide pane is a right pane the dock gives more room. Close it with k_pane_end.
k_pane :: (t: [] Tree, u: [] Ui, id: string, side: int, title: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  sides := DK_SIDES;
  i := k_frame(t, u, id, TG_SECTION, sides[ifx side < 0 || side > DK_WIDE then 0 else side], MF_PANEL);
  if title.count > 0 {
    tr_attr(t, i, AT_LABEL, title);
    h := tr_leaf(t, tr_cat(ida[..], id, ".h"), TG_H2, "sec-h", title);
  }
  b := tr_open(t, tr_cat(idb[..], id, ".b"), TG_DIV, "pane-b");
  return i;
}
k_pane_end :: (t: [] Tree) { tr_close(t); tr_close(t); }
// Puts a pane away without unmaking it (what it holds stays as it is), or brings it back.
k_pane_shut :: (t: [] Tree, pane: int, shut: bool) { if shut { tr_attr(t, pane, AT_HIDDEN, "true"); } }
// Slot: an empty place in a pane that another surface fills (the chat's conversation in the editor's foot).
// The dock never puts anything in it.
k_slot :: (t: [] Tree, id: string) -> int { return tr_leaf(t, id, TG_DIV, "slot", ""); }
// Side: the dock's left column, from the window's top to its foot, with a slot the site's side fills (the world
// editor's left; docs/app-shell.md). The strip and the foot stand beside it. Answers the slot (its id is `id`.slot).
k_dock_side :: (t: [] Tree, id: string) -> int {
  ida: [UI_ID] u8;
  c := tr_open(t, id, TG_DIV, "dock-s");
  sl := k_slot(t, tr_cat(ida[..], id, ".slot"));
  tr_close(t);
  return sl;
}
// Prop: a one-line field with its name before it. Answers the field's node (its id is `id`).
k_prop :: (t: [] Tree, u: [] Ui, id: string, name: string, placeholder: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  p := tr_open(t, tr_cat(ida[..], id, ".prop"), TG_DIV, "prop");
  n := tr_leaf(t, tr_cat(idb[..], id, ".n"), TG_SPAN, "meta", name);
  f := k_field(t, u, id, placeholder, name);
  tr_close(t);
  return f;
}
// Row with a control: a row, and beside it an icon button that acts on what the row names without
// picking it (add it to a group, pin it). The button's id is the row's with ".x"; `on` marks it as done.
k_row_with :: (t: [] Tree, u: [] Ui, id: string, title: string, meta: string, current: bool, icon: int, label: string, on: bool) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  w := tr_open(t, tr_cat(ida[..], id, ".w"), TG_DIV, "row-x");
  r := k_row(t, u, id, title, meta, current);
  b := k_icon_button(t, tr_cat(idb[..], id, ".x"), icon, label);
  if on { tr_attr(t, b, AT_STATE, "done"); tr_attr(t, b, AT_PRESSED, "true"); }
  tr_close(t);
  return r;
}
// Fact: a name and what it is, as text, set as a prop is.
k_fact :: (t: [] Tree, id: string, name: string, value: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  p := tr_open(t, id, TG_DIV, "prop");
  n := tr_leaf(t, tr_cat(ida[..], id, ".n"), TG_SPAN, "meta", name);
  v := tr_leaf(t, tr_cat(idb[..], id, ".v"), TG_SPAN, "fact", value);
  tr_close(t);
  return p;
}

// Switch row: a named thing that is on or off (a board's row, a tool visitors get): its name, a line under it
// when it has one, and the switch at its right (settings.coax k_switch). Answers the switch's node (its id is `id`).
k_switch_row :: (t: [] Tree, id: string, title: string, meta: string, on: bool) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8; idd: [UI_ID] u8;
  r := tr_open(t, tr_cat(ida[..], id, ".row"), TG_DIV, "swr");
  c := tr_open(t, tr_cat(idb[..], id, ".w"), TG_DIV, "col");
  n := tr_leaf(t, tr_cat(idc[..], id, ".n"), TG_SPAN, "swr-t", title);
  if meta.count > 0 { m := tr_leaf(t, tr_cat(idd[..], id, ".m"), TG_SPAN, "meta", meta); }
  tr_close(t);
  sw := k_switch(t, id, title, on);
  tr_close(t);
  return sw;
}
// Stepper: a named value that is stepped, not typed: its name, a button that lowers it, what it is
// now, and a button that raises it (a brush's radius, a count). The buttons' ids are `id` with
// ".less" and ".more"; one at its end can't be pressed. Answers the value's node (its id is `id`).
k_stepper :: (t: [] Tree, id: string, name: string, value: string, can_less: bool, can_more: bool) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8; idd: [UI_ID] u8; la: [UI_ID] u8; lb: [UI_ID] u8;
  p := tr_open(t, tr_cat(ida[..], id, ".step"), TG_DIV, "step");
  tr_attr(t, p, AT_ROLE, "group"); tr_attr(t, p, AT_LABEL, name);
  n := tr_leaf(t, tr_cat(idb[..], id, ".n"), TG_SPAN, "meta", name);
  less := k_icon_button(t, tr_cat(idc[..], id, ".less"), IC_MINUS, tr_cat(la[..], "Less: ", name));
  if !can_less { tr_attr(t, less, AT_DISABLED, ""); }
  v := tr_leaf(t, id, TG_SPAN, "fact", value);
  tr_attr(t, v, AT_LIVE, "polite");
  more := k_icon_button(t, tr_cat(idd[..], id, ".more"), IC_PLUS, tr_cat(lb[..], "More: ", name));
  if !can_more { tr_attr(t, more, AT_DISABLED, ""); }
  tr_close(t);
  return v;
}

// Slider: a named whole number dragged along a line between two ends (a body's height, a volume):
// its name, the line, and what it is now as words. The line is the browser's own range control, so
// the arrow keys move it too. The tree holds its ends and its step, never its place: the page puts
// the value on it (dm_value) and hears each move as the field's text. Answers the line's node (its
// id is `id`); the words' id is `id` with ".v".
k_slider :: (t: [] Tree, id: string, name: string, value: string, low: int, high: int, step: int) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8; na: [12] u8; nb: [12] u8; nc: [12] u8;
  p := tr_open(t, tr_cat(ida[..], id, ".slide"), TG_DIV, "slide");
  n := tr_leaf(t, tr_cat(idb[..], id, ".n"), TG_SPAN, "meta", name);
  f := tr_open(t, id, TG_INPUT, "");
  tr_attr(t, f, AT_TYPE, "range"); tr_attr(t, f, AT_LABEL, name);
  tr_attr(t, f, AT_MIN, tr_join(na[..], "", low)); tr_attr(t, f, AT_MAX, tr_join(nb[..], "", high)); tr_attr(t, f, AT_STEP, tr_join(nc[..], "", ifx step < 1 then 1 else step));
  tr_close(t);
  v := tr_leaf(t, tr_cat(idc[..], id, ".v"), TG_SPAN, "fact", value);
  tr_close(t);
  return f;
}

// Meter: a named amount against its limit (a budget spent, a store filled): its name, a line filled as
// far as `share` of the limit is used (0 to 1; more shows as full), and the amount in words, which name
// the limit too, so the line is never the only place the limit is read. A meter is read, not pressed.
// Answers the line's node (its id is `id`); the words' id is `id` with ".v".
k_meter :: (t: [] Tree, id: string, name: string, value: string, share: f32) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8; idd: [UI_ID] u8;
  p := tr_open(t, tr_cat(ida[..], id, ".meter"), TG_DIV, "meter");
  n := tr_leaf(t, tr_cat(idb[..], id, ".n"), TG_SPAN, "meta", name);
  line := tr_open(t, id, TG_SPAN, "meter-l");
  tr_attr(t, line, AT_HIDDEN, "true");   // the words beside it say the same to a reader
  fill := tr_leaf(t, tr_cat(idc[..], id, ".f"), TG_SPAN, "meter-f", "");
  k_var(t, fill, share);
  tr_close(t);
  v := tr_leaf(t, tr_cat(idd[..], id, ".v"), TG_SPAN, "fact", value);
  tr_close(t);
  return line;
}

DkTest :: struct { t: [1] Tree; u: [1] Ui; }

#test "a dock holds a strip and side panes, each a framed section whose body is its own node" {
  h: [1] DkTest; t := h[0].t[..]; u := h[0].u[..];
  ui_begin(u, 0, true); tr_begin(t);
  d := k_dock(t, "dock", true);
  a := k_pane(t, u, "bar", DK_TOP, "");
  b1 := k_button(t, u, "undo", "Undo", BS_PLAIN);
  k_pane_end(t);
  b := k_pane(t, u, "things", DK_LEFT, "Things");
  r := k_row(t, u, "thing.1", "Cargo crate", "", true);
  rw := k_row_with(t, u, "thing.2", "Parked rover", "No. 2", false, IC_PLUS, "Add to the group", true);
  k_pane_end(t);
  c := k_pane(t, u, "one", DK_RIGHT, "Selected");
  f := k_prop(t, u, "x", "X cm", "0");
  g := k_fact(t, "kit", "Kit", "rover");
  k_pane_end(t);
  e := k_pane(t, u, "foot", DK_BOTTOM, "Agent");
  k_pane_shut(t, e, true);
  sl := k_slot(t, "foot.slot");
  k_pane_end(t);
  tr_close(t);
  ui_end(u);
  #assert t[0].lost == 0 && t[0].depth == 0;
  #assert tr_class(t, e) == "pane pane-bm" && tr_attr_of(t, e, AT_HIDDEN) == "true" && tr_class(t, sl) == "slot" && !tr_has(t, b, AT_HIDDEN);
  #assert tr_class(t, d) == "dock dock-over" && tr_class(t, a) == "pane pane-t" && tr_class(t, b) == "pane pane-l" && tr_class(t, c) == "pane pane-r";
  #assert tr_find(t, "bar.h") < 0 && tr_text_of(t, tr_find(t, "things.h")) == "Things" && tr_find(t, "one.b") > 0;
  #assert f == tr_find(t, "x") && tr_text_of(t, tr_find(t, "x.n")) == "X cm" && tr_class(t, tr_find(t, "x.prop")) == "prop";
  #assert tr_class(t, tr_find(t, "thing.2.w")) == "row-x" && rw == tr_find(t, "thing.2") && tr_attr_of(t, tr_find(t, "thing.2.x"), AT_PRESSED) == "true" && tr_attr_of(t, tr_find(t, "thing.2.x"), AT_LABEL) == "Add to the group";
  #assert tr_class(t, g) == "prop" && tr_text_of(t, tr_find(t, "kit.n")) == "Kit" && tr_text_of(t, tr_find(t, "kit.v")) == "rover";
  // a stepper: its name, less, the value, more; at an end, that end's button can't be pressed
  tr_begin(t);
  sv := k_stepper(t, "radius", "Radius", "8 m", true, false);
  #assert tr_class(t, tr_find(t, "radius.step")) == "step" && tr_attr_of(t, tr_find(t, "radius.step"), AT_LABEL) == "Radius" && tr_text_of(t, tr_find(t, "radius.n")) == "Radius";
  #assert sv == tr_find(t, "radius") && tr_text_of(t, sv) == "8 m" && tr_class(t, sv) == "fact";
  #assert tr_class(t, tr_find(t, "radius.less")) == "ib" && tr_attr_of(t, tr_find(t, "radius.less"), AT_LABEL) == "Less: Radius" && !tr_has(t, tr_find(t, "radius.less"), AT_DISABLED);
  #assert tr_attr_of(t, tr_find(t, "radius.more"), AT_LABEL) == "More: Radius" && tr_has(t, tr_find(t, "radius.more"), AT_DISABLED) && t[0].depth == 0;
  // a slider: its name, the browser's range control with its ends and step, and the value in words
  tr_begin(t);
  ln := k_slider(t, "height", "Height", "175 cm", 145, 225, 1);
  #assert ln == tr_find(t, "height") && t[0].nodes[ln].tag == TG_INPUT && tr_attr_of(t, ln, AT_TYPE) == "range" && tr_attr_of(t, ln, AT_LABEL) == "Height";
  #assert tr_attr_of(t, ln, AT_MIN) == "145" && tr_attr_of(t, ln, AT_MAX) == "225" && tr_attr_of(t, ln, AT_STEP) == "1";
  #assert tr_class(t, tr_find(t, "height.slide")) == "slide" && tr_text_of(t, tr_find(t, "height.n")) == "Height" && tr_text_of(t, tr_find(t, "height.v")) == "175 cm" && t[0].depth == 0;
  // a meter: its name, a line filled to its share of the limit, and the amount with the limit in words
  tr_begin(t);
  mt := k_meter(t, "spent", "Costliest call", "5,000 of 20,000", 0.25);
  #assert mt == tr_find(t, "spent") && tr_class(t, mt) == "meter-l" && tr_class(t, tr_find(t, "spent.meter")) == "meter" && tr_text_of(t, tr_find(t, "spent.n")) == "Costliest call";
  #assert tr_attr_of(t, tr_find(t, "spent.f"), AT_VARS) == "--p:0.250" && tr_text_of(t, tr_find(t, "spent.v")) == "5,000 of 20,000" && tr_attr_of(t, mt, AT_HIDDEN) == "true" && t[0].depth == 0;
  tr_begin(t);
  mo := k_meter(t, "over", "Costliest call", "20,000 of 20,000", 1.4);
  #assert tr_attr_of(t, tr_find(t, "over.f"), AT_VARS) == "--p:1";
  // a switch row: its name, a line under it, and the switch, which says On or Off in words
  tr_begin(t);
  sr := k_switch_row(t, "row.2", "Lanterns", "lanterns", true);
  so := k_switch_row(t, "tool.1", "build", "", false);
  #assert sr == tr_find(t, "row.2") && tr_class(t, sr) == "sw" && tr_attr_of(t, sr, AT_PRESSED) == "true" && tr_attr_of(t, sr, AT_LABEL) == "Lanterns" && tr_text_of(t, tr_find(t, "row.2.l")) == "On";
  #assert tr_class(t, tr_find(t, "row.2.row")) == "swr" && tr_text_of(t, tr_find(t, "row.2.n")) == "Lanterns" && tr_text_of(t, tr_find(t, "row.2.m")) == "lanterns" && t[0].nodes[sr].parent == tr_find(t, "row.2.row");
  #assert tr_attr_of(t, so, AT_PRESSED) == "false" && tr_text_of(t, tr_find(t, "tool.1.l")) == "Off" && tr_find(t, "tool.1.m") < 0 && t[0].depth == 0;
  tr_begin(t);
  d = k_dock(t, "dock", false);
  w := k_pane(t, u, "code", DK_WIDE, "Code");
  k_pane_end(t);
  x := k_pane(t, u, "odd", 9, "");
  k_pane_end(t);
  tr_close(t);
  #assert tr_class(t, d) == "dock" && tr_class(t, w) == "pane pane-r pane-w" && tr_class(t, x) == "pane pane-t" && t[0].depth == 0;
  // the side's column: a slot in it, for the site's side
  tr_begin(t);
  d = k_dock(t, "dock", true);
  ps := k_dock_side(t, "places");
  tr_close(t);
  #assert tr_class(t, tr_find(t, "places")) == "dock-s" && ps == tr_find(t, "places.slot") && tr_class(t, ps) == "slot" && t[0].nodes[ps].parent == tr_find(t, "places") && t[0].depth == 0;
}
