// The frames set: the components a text surface is built from when the
// browser draws it (docs/audits/2026-11-11-chat-zero-base-audit.md, section
// 11). Each is a frame around content, as ARWES's own examples build theirs:
// a button is an octagon and a label, a panel is corners around its rows.
// A component builds nodes in the tree (components/core/tree.coax) and
// nothing else. It doesn't know it is drawn by a browser: the frame's kind,
// its settings, every measure and every colour are the skin's
// (components/skin/mono.coax), and the backend draws it.
//
// Motion is ARWES's (components/core/arwes/motion.coax), computed here from
// the time the page supplies: a frame assembles when its node first appears,
// nodes that appear together enter a stagger apart, and a short label types
// in. Nothing moves once a node has entered, and with reduced motion nothing
// moves at all. A label that types in keeps its whole text in the node for a
// screen reader and for Find; the typed copy is hidden from both.
//
// The components: frame, text, icon, icon button, button, link, select, secret, card, field, composer, the person's
// message, the agent's message (Markdown), meta line, tool call, tool line, code block,
// notice, row, place, side (places, a page's list, and who is logged in: k_side, k_side_list, k_side_end, k_who),
// drop, file, header, menu; and three a page that stages its own moments builds with: a frame it
// draws at its own time (k_frame_at), a measure for the stylesheet (k_var) and a value that deciphers
// in (k_decipher). The stage's own pieces are in stage.coax.
//   coax/bin/coax test components/kit/frames.coax

#load "../core/tree.coax";
#load "../core/markdown.coax";
#load "../core/icons.coax";
#load "../core/arwes/motion.coax";
#load "../skin/mono.coax";

UI_BIRTHS :: 384;
UI_ID :: 96;          // bytes of an id built here
BS_PLAIN :: 0; BS_PRIMARY :: 1; BS_DISABLED :: 2;

// When a node first appeared: its id's hash and the second it starts to enter.
UiBirth :: struct { h: int; born: f32; seen: bool; }
Ui :: struct {
  now: f32;
  reduced: bool;               // the person asked for less motion: everything is entered at once
  births: [UI_BIRTHS] UiBirth; nb: int;
  fresh: int;                  // nodes that first appeared in this build
  busy: bool;                  // something is still entering: build again next frame
}

// A build starts: the time, and nothing seen yet.
ui_begin :: (u: [] Ui, now: f32, reduced: bool) {
  u[0].now = now; u[0].reduced = reduced; u[0].fresh = 0; u[0].busy = false;
  for k: 0..<u[0].nb { u[0].births[k].seen = false; }
}
// A build ends: what wasn't built this time is forgotten, so it enters again if it comes back.
ui_end :: (u: [] Ui) {
  kept := 0;
  for k: 0..<u[0].nb {
    if u[0].births[k].seen { u[0].births[kept] = u[0].births[k]; kept += 1; }
  }
  u[0].nb = kept;
}
// Everything enters again (a page's Replay).
ui_replay :: (u: [] Ui) { u[0].nb = 0; }
// How far the node with this id has entered, 0 to 1, over `seconds`.
ui_progress :: (u: [] Ui, id: string, seconds: f32) -> f32 {
  if u[0].reduced { return 1; }
  h := tr_hash(id);
  at := -1;
  for k: 0..<u[0].nb { if u[0].births[k].h == h { at = k; break; } }
  if at < 0 {
    if u[0].nb >= UI_BIRTHS { return 1; }
    wait := cast(f32) u[0].fresh * MONO_STAGGER;
    if wait > MONO_STAGGER_MOST { wait = MONO_STAGGER_MOST; }
    at = u[0].nb; u[0].nb += 1;
    u[0].births[at] = UiBirth.{h = h, born = u[0].now + wait, seen = true};
    u[0].fresh += 1;
  }
  u[0].births[at].seen = true;
  p := am_progress(u[0].now - u[0].births[at].born, seconds, 0);
  if u[0].now < u[0].births[at].born { p = 0; }
  if p < 1 { u[0].busy = true; }
  return p;
}

// ---------------------------------------------------------------- the components

// Frame: a node with one of the skin's frames behind it, assembling as it enters. Close it with tr_close.
k_frame :: (t: [] Tree, u: [] Ui, id: string, tag: int, cls: string, role: int) -> int {
  i := tr_open(t, id, tag, cls);
  tr_frame(t, i, mono_kind(role), role, ui_progress(u, id, MONO_ENTER));
  return i;
}
// Text: a short label that types in. Its whole text is in the node from the start.
k_text :: (t: [] Tree, u: [] Ui, id: string, tag: int, cls: string, text: string) -> int {
  count := ar_text_length(text);
  seconds := ar_text_duration(ifx count < 0 then 0 else count, MONO_TEXT_MOST, MONO_TEXT_RATE);
  p := ui_progress(u, id, seconds);
  if p >= 1 || count < 0 { return tr_leaf(t, id, tag, cls, text); }
  i := tr_open(t, id, tag, cls);
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  whole := tr_leaf(t, tr_cat(ida[..], id, ".all"), TG_SPAN, "sr", text);
  part: [512] u8;
  n := ar_text_sequence(text, p, true, part[..]);
  if n < 0 { n = 0; }
  typed := tr_leaf(t, tr_cat(idb[..], id, ".typed"), TG_SPAN, "tx", cast(string) part[0..<n]);
  tr_attr(t, typed, AT_HIDDEN, "true");
  tr_close(t);
  return i;
}
// Button: an octagon and its label. Primary is the inverse; a disabled one is dashed and can't be pressed.
k_button :: (t: [] Tree, u: [] Ui, id: string, label: string, state: int) -> int {
  i := k_frame(t, u, id, TG_BUTTON, "btn", MF_BUTTON);
  if state == BS_PRIMARY { tr_attr(t, i, AT_STATE, "primary"); }
  if state == BS_DISABLED { tr_attr(t, i, AT_DISABLED, ""); }
  ida: [UI_ID] u8;
  l := tr_leaf(t, tr_cat(ida[..], id, ".l"), TG_SPAN, "btn-l", label);
  tr_close(t);
  return i;
}
// Icon: one of the icons (components/core/icons.coax), in the colour of the text around it. It is
// decoration: what it means is said by the label of the button it is in.
k_icon :: (t: [] Tree, id: string, icon: int) -> int {
  ida: [UI_ID] u8; href: [UI_ID] u8;
  i := tr_open(t, id, TG_SVG, "ic");
  tr_attr(t, i, AT_HIDDEN, "true");
  u := tr_open(t, tr_cat(ida[..], id, ".use"), TG_USE, "");
  n := ic_href(icon, href[..]);
  tr_attr(t, u, AT_HREF, cast(string) href[0..<n]);
  tr_close(t);
  tr_close(t);
  return i;
}
// Icon button: a small quiet button that is only an icon. Its label is what a screen reader says and what
// shows when the pointer rests on it.
k_icon_button :: (t: [] Tree, id: string, icon: int, label: string) -> int {
  ida: [UI_ID] u8;
  i := tr_open(t, id, TG_BUTTON, "ib");
  tr_attr(t, i, AT_LABEL, label); tr_attr(t, i, AT_TITLE, label);
  g := k_icon(t, tr_cat(ida[..], id, ".ic"), icon);
  tr_close(t);
  return i;
}
// Link: a quiet text button, with no frame (Copy in a code block's strip).
k_link :: (t: [] Tree, id: string, label: string) -> int { return tr_leaf(t, id, TG_BUTTON, "lk", label); }
// Go: a quiet link to another page, in the look of Link (a world's card: Open the editor).
k_go :: (t: [] Tree, id: string, label: string, href: string) -> int {
  i := tr_leaf(t, id, TG_A, "lk", label);
  tr_attr(t, i, AT_HREF, href);
  return i;
}
// Field: one or more lines of typing over an underline.
k_field :: (t: [] Tree, u: [] Ui, id: string, placeholder: string, label: string) -> int {
  ida: [UI_ID] u8;
  i := k_frame(t, u, tr_cat(ida[..], id, ".frame"), TG_DIV, "field", MF_FIELD);
  f := tr_open(t, id, TG_TEXTAREA, "");
  tr_attr(t, f, AT_PLACEHOLDER, placeholder); tr_attr(t, f, AT_LABEL, label); tr_attr(t, f, AT_ROWS, "1");
  tr_close(t);
  tr_close(t);
  return f;
}
// Code field: many lines of code to edit, in the code face, as tall as the skin says and scrolling
// both ways. Enter makes a line and Tab indents; nothing is sent by a key (a button beside it saves).
// `lang` names what it holds ("coax"; "" is text). Answers the field's node (its id is `id`).
k_code_field :: (t: [] Tree, u: [] Ui, id: string, lang: string, label: string) -> int {
  ida: [UI_ID] u8;
  i := k_frame(t, u, tr_cat(ida[..], id, ".frame"), TG_DIV, "field code-in", MF_FIELD);
  f := tr_open(t, id, TG_TEXTAREA, "");
  tr_attr(t, f, AT_LABEL, label); tr_attr(t, f, AT_LANG, ifx lang.count > 0 then lang else "text");
  tr_close(t);
  tr_close(t);
  return f;
}
// Composer: the field a message is written in, over a row with Send on the right. The field is one line
// tall and grows with what is typed, to the skin's most (MONO_FIELD_LINES), then scrolls. Between
// k_composer_begin and k_composer_end the caller adds what sits on the row's left (a note, a menu, an icon
// button). k_composer is both, with a note or nothing.
k_composer_begin :: (t: [] Tree, u: [] Ui, id: string, placeholder: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  i := k_frame(t, u, tr_cat(ida[..], id, ".frame"), TG_DIV, "composer", MF_PANEL);
  f := tr_open(t, id, TG_TEXTAREA, "");
  tr_attr(t, f, AT_PLACEHOLDER, placeholder); tr_attr(t, f, AT_LABEL, placeholder); tr_attr(t, f, AT_ROWS, "1");
  tr_close(t);
  r := tr_open(t, tr_cat(idb[..], id, ".row"), TG_DIV, "composer-r");
  return f;
}
k_composer_end :: (t: [] Tree, u: [] Ui, id: string, send: string, can_send: bool) {
  ida: [UI_ID] u8;
  b := k_button(t, u, tr_cat(ida[..], id, ".send"), send, ifx can_send then BS_PRIMARY else BS_DISABLED);
  tr_close(t);
  tr_close(t);
}
k_composer :: (t: [] Tree, u: [] Ui, id: string, placeholder: string, note: string, send: string, can_send: bool) -> int {
  ida: [UI_ID] u8;
  f := k_composer_begin(t, u, id, placeholder);
  if note.count > 0 { m := tr_leaf(t, tr_cat(ida[..], id, ".note"), TG_SPAN, "meta", note); }
  k_composer_end(t, u, id, send, can_send);
  return f;
}
// Select: a quiet button showing what is chosen, which opens a menu of rows over it. The caller adds the
// rows (k_row) between k_select_begin and k_select_end while it is open.
k_select_begin :: (t: [] Tree, u: [] Ui, id: string, label: string, what: string, open: bool) {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8; idd: [UI_ID] u8;
  a := tr_open(t, tr_cat(ida[..], id, ".anchor"), TG_DIV, "anchor");
  b := tr_open(t, id, TG_BUTTON, "sel");
  tr_attr(t, b, AT_EXPANDED, ifx open then "true" else "false"); tr_attr(t, b, AT_TITLE, what);
  l := tr_leaf(t, tr_cat(idb[..], id, ".l"), TG_SPAN, "sel-l", label);
  g := k_icon(t, tr_cat(idc[..], id, ".ic"), ifx open then IC_CHEVRON_UP else IC_CHEVRON_DOWN);
  tr_close(t);
  if open {
    m := k_frame(t, u, tr_cat(idd[..], id, ".menu"), TG_DIV, "menu pop", MF_PANEL);
    tr_attr(t, m, AT_ROLE, "group"); tr_attr(t, m, AT_LABEL, what);
  }
}
k_select_end :: (t: [] Tree, open: bool) {
  if open { tr_close(t); }
  tr_close(t);
}
// Secret: a one-line field for something pasted once and never shown (a key): hidden as it is typed, and
// the browser is asked not to keep it.
k_secret :: (t: [] Tree, u: [] Ui, id: string, placeholder: string, label: string) -> int {
  ida: [UI_ID] u8;
  i := k_frame(t, u, tr_cat(ida[..], id, ".frame"), TG_DIV, "field", MF_FIELD);
  f := tr_open(t, id, TG_INPUT, "");
  tr_attr(t, f, AT_TYPE, "password"); tr_attr(t, f, AT_COMPLETE, "off");
  tr_attr(t, f, AT_PLACEHOLDER, placeholder); tr_attr(t, f, AT_LABEL, label);
  tr_close(t);
  tr_close(t);
  return f;
}
// Card: a panel with a title, for a group of settings. Close it with tr_close.
k_card :: (t: [] Tree, u: [] Ui, id: string, title: string) -> int {
  ida: [UI_ID] u8;
  i := k_frame(t, u, id, TG_SECTION, "card", MF_PANEL);
  h := tr_leaf(t, tr_cat(ida[..], id, ".h"), TG_H2, "sec-h", title);
  return i;
}
// The person's message: their words in a dim frame, on the right.
k_user :: (t: [] Tree, u: [] Ui, id: string, text: string) -> int {
  ida: [UI_ID] u8;
  i := k_frame(t, u, id, TG_DIV, "msg-user", MF_BUBBLE);
  p := tr_leaf(t, tr_cat(ida[..], id, ".p"), TG_P, "", text);
  tr_close(t);
  return i;
}
// A line under an answer: the model, whose key, the cost.
k_meta :: (t: [] Tree, id: string, text: string) -> int { return tr_leaf(t, id, TG_P, "meta", text); }

// A block's or an item's text with its runs as inline nodes under the open node.
k_inline :: (t: [] Tree, doc: [] MdDoc, id: string, text: string, runs: [] MdRun) {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  at := 0; k := 0; part := 0;
  while at < text.count {
    to := text.count; tag := TG_SPAN; link := "";
    if k < runs.count && runs[k].from <= at {
      r := runs[k];
      to = ifx r.to > text.count then text.count else r.to;
      if (r.marks & MD_LINK) != 0 { tag = TG_A; link = md_link(doc, r); }
      else if r.style == MD_CODE { tag = TG_CODE; }
      else if r.style == MD_BOLD || (r.marks & MD_STRONG) != 0 { tag = TG_STRONG; }
      else if (r.marks & MD_ITALIC) != 0 { tag = TG_EM; }
      else if (r.marks & MD_STRIKE) != 0 { tag = TG_DEL; }
      k += 1;
    } else if k < runs.count { to = ifx runs[k].from > text.count then text.count else runs[k].from; }
    if to <= at { break; }
    n := tr_leaf(t, tr_join(idb[..], tr_cat(ida[..], id, "."), part), tag, "", cast(string) text[at..<to]);
    if tag == TG_A { tr_attr(t, n, AT_HREF, link); }
    at = to; part += 1;
  }
}
// Code block: its language and Copy in a strip, then the code.
k_code :: (t: [] Tree, u: [] Ui, id: string, lang: string, code: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8; idd: [UI_ID] u8;
  i := k_frame(t, u, id, TG_DIV, "code", MF_PANEL);
  h := tr_open(t, tr_cat(ida[..], id, ".h"), TG_DIV, "code-h");
  l := tr_leaf(t, tr_cat(idb[..], id, ".lang"), TG_SPAN, "meta", ifx lang.count > 0 then lang else "text");
  c := k_icon_button(t, tr_cat(idc[..], id, ".copy"), IC_COPY, "Copy code");
  tr_close(t);
  p := tr_leaf(t, tr_cat(idd[..], id, ".pre"), TG_PRE, "", code);
  tr_close(t);
  return i;
}
// The agent's message: its Markdown as plain nodes on the ground. Reading text gets no frame and no effect.
k_agent :: (t: [] Tree, u: [] Ui, id: string, doc: [] MdDoc) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8;
  i := tr_open(t, id, TG_DIV, "md");
  for b: 0..<doc[0].nb {
    block := doc[0].blocks[b];
    bid := tr_join(idb[..], tr_cat(ida[..], id, ".b"), b);
    if block.kind == MB_PARA {
      p := tr_open(t, bid, TG_P, "");
      k_inline(t, doc, bid, md_block_text(doc, b), md_block_runs(doc, b));
      tr_close(t);
    } else if block.kind == MB_CODE {
      c := k_code(t, u, bid, md_lang(doc, b), md_block_text(doc, b));
    } else if block.kind == MB_LIST || block.kind == MB_QUOTE {
      l := tr_open(t, bid, ifx block.kind == MB_QUOTE then TG_BLOCKQUOTE else ifx block.ordered then TG_OL else TG_UL, "");
      for q: 0..<block.items {
        item := block.item0 + q;
        iid := tr_join(idc[..], tr_cat(ida[..], bid, ".i"), q);
        li := tr_open(t, iid, ifx block.kind == MB_QUOTE then TG_P else TG_LI, "");
        k_inline(t, doc, iid, md_item_text(doc, item), md_item_runs(doc, item));
        tr_close(t);
      }
      tr_close(t);
    } else if block.kind == MB_TABLE && block.cols > 0 {
      tb := tr_open(t, bid, TG_TABLE, "");
      rows := block.items / block.cols;
      for r: 0..<rows {
        rid := tr_join(idc[..], tr_cat(ida[..], bid, ".r"), r);
        row := tr_open(t, rid, TG_TR, "");
        for c: 0..<block.cols {
          item := block.item0 + r * block.cols + c;
          idd: [UI_ID] u8; ide: [UI_ID] u8;
          cid := tr_join(ide[..], tr_cat(idd[..], rid, ".c"), c);
          cell := tr_open(t, cid, ifx r == 0 then TG_TH else TG_TD, "");
          k_inline(t, doc, cid, md_item_text(doc, item), md_item_runs(doc, item));
          tr_close(t);
        }
        tr_close(t);
      }
      tr_close(t);
    }
  }
  tr_close(t);
  return i;
}
// The agent's message in a transcript: a node around its answer. While the answer is still coming it
// says so, and the skin marks where the text has got to (a caret at its end, or alone while nothing has
// come yet). The caller adds the answer (k_agent_text) and what goes under it, then closes it with tr_close.
k_reply_open :: (t: [] Tree, id: string, coming: bool, empty: bool) -> int {
  a := tr_open(t, id, TG_DIV, "msg-ai");
  if coming { tr_attr(t, a, AT_STATE, ifx empty then "waiting" else "streaming"); }
  return a;
}
// An answer's text as Markdown: parsed afresh into doc (which it empties), then drawn by k_agent.
k_agent_text :: (t: [] Tree, u: [] Ui, id: string, doc: [] MdDoc, text: string) -> int {
  doc[0].n = 0; doc[0].nb = 0; doc[0].nr = 0; doc[0].ni = 0; doc[0].nlink = 0;
  blocks := md_parse(doc, text, 0);
  return k_agent(t, u, id, doc);
}
// Tool call: what the agent did and to what, on one row that opens onto what it sent and what came back.
k_tool :: (t: [] Tree, u: [] Ui, id: string, what: string, detail: string, open: bool, input: string, output: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8; idd: [UI_ID] u8; ide: [UI_ID] u8; idf: [UI_ID] u8; idg: [UI_ID] u8;
  i := k_frame(t, u, tr_cat(ida[..], id, ".frame"), TG_DIV, "tool", MF_PANEL);
  h := tr_open(t, id, TG_BUTTON, "tool-h");
  tr_attr(t, h, AT_EXPANDED, ifx open then "true" else "false");
  a := tr_leaf(t, tr_cat(idb[..], id, ".what"), TG_SPAN, "tool-k", what);
  b := tr_leaf(t, tr_cat(idc[..], id, ".detail"), TG_SPAN, "tool-d", detail);
  c := tr_leaf(t, tr_cat(idd[..], id, ".x"), TG_SPAN, "tool-x", ifx open then "Hide" else "Show");
  tr_close(t);
  if open {
    body := tr_open(t, tr_cat(ide[..], id, ".body"), TG_DIV, "tool-b");
    m := tr_leaf(t, tr_cat(idf[..], id, ".in"), TG_PRE, "", input);
    o := tr_leaf(t, tr_cat(idg[..], id, ".out"), TG_PRE, "", output);
    tr_close(t);
  }
  tr_close(t);
  return i;
}
// A frame the caller draws: its assembly is `progress`, 0 to 1, at the caller's own moments (a stage
// that closes one frame after another). Close it with tr_close.
k_frame_at :: (t: [] Tree, id: string, tag: int, cls: string, role: int, progress: f32) -> int {
  i := tr_open(t, id, tag, cls);
  tr_frame(t, i, mono_kind(role), role, am_unit(progress));
  return i;
}
// A measure the stylesheet reads as --p on the node, 0 to 1 in thousandths: how far a line is drawn, a
// bar filled, a packet along its wire. The page computes it from its own time, so a recording steps it.
KV_PARTS :: 1000;      // a measure is written in thousandths
KV_TEN :: 10;
KD_SEED :: 2147483647; // a decipher's seed is 31 bits of its id's hash
k_var :: (t: [] Tree, i: int, p: f32) {
  v := ifx !(p > 0) then 0 else ifx p >= 1 then KV_PARTS else cast(int) (p * cast(f32) KV_PARTS + 0.5);
  b: [12] u8; n := 0;
  for c: "--p:" { b[n] = c; n += 1; }
  if v >= KV_PARTS { b[n] = '1'; n += 1; }
  else {
    b[n] = '0'; b[n + 1] = '.'; n += 2;
    d := KV_PARTS / KV_TEN;
    while d > 0 { b[n] = cast(u8) (cast(int) '0' + (v / d) % KV_TEN); n += 1; d /= KV_TEN; }
  }
  tr_attr(t, i, AT_VARS, cast(string) b[0..<n]);
}
// A value that deciphers in (ARWES's decipher, motion.coax): its letters settle in a seeded order as
// `progress` goes 0 to 1, the rest changing every `tick`. The whole value is in the node from the
// start for a screen reader and Find; the changing copy is hidden from both. At 1 it is plain text.
k_decipher :: (t: [] Tree, id: string, tag: int, cls: string, text: string, progress: f32, tick: int) -> int {
  part: [AM_MAX_TEXT_BYTES] u8;
  n := ifx progress >= 1 then -1 else ar_text_decipher(text, progress, true, tr_hash(id) & KD_SEED, tick, part[..]);
  if n < 0 { return tr_leaf(t, id, tag, cls, text); }
  i := tr_open(t, id, tag, cls);
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  whole := tr_leaf(t, tr_cat(ida[..], id, ".all"), TG_SPAN, "sr", text);
  copy := tr_leaf(t, tr_cat(idb[..], id, ".dx"), TG_SPAN, "dx", cast(string) part[0..<n]);
  tr_attr(t, copy, AT_HIDDEN, "true");
  tr_close(t);
  return i;
}
// Glyph: a small mark for how a piece of work stands: turning while it runs, a check when it held, a
// cross (inverted) when it was refused. The words beside it say the same.
TL_RUN :: 0; TL_OK :: 1; TL_NO :: 2;
k_glyph :: (t: [] Tree, id: string, state: int) -> int {
  ida: [UI_ID] u8;
  g := tr_open(t, id, TG_SPAN, "gl");
  tr_attr(t, g, AT_STATE, ifx state == TL_RUN then "run" else ifx state == TL_NO then "no" else "ok");
  ic := k_icon(t, tr_cat(ida[..], id, ".ic"), ifx state == TL_RUN then IC_CIRCLE_DASHED else ifx state == TL_NO then IC_X else IC_CHECK);
  tr_close(t);
  return g;
}
// Tool line: a tool call as one line: its glyph, its name, and a short result at the right. It opens on a
// press onto what it sent and what came back, with Copy for what came back (the caller copies the
// text of id.out when id.copy is pressed).
k_tool_line :: (t: [] Tree, u: [] Ui, id: string, what: string, detail: string, state: int, open: bool, input: string, output: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8; idd: [UI_ID] u8; ide: [UI_ID] u8; idf: [UI_ID] u8; idg: [UI_ID] u8; idh: [UI_ID] u8; idi: [UI_ID] u8; idj: [UI_ID] u8;
  i := k_frame(t, u, tr_cat(ida[..], id, ".frame"), TG_DIV, "tool tl", MF_PANEL);
  tr_attr(t, i, AT_STATE, ifx state == TL_RUN then "run" else ifx state == TL_NO then "no" else "ok");
  h := tr_open(t, id, TG_BUTTON, "tool-h");
  tr_attr(t, h, AT_EXPANDED, ifx open then "true" else "false");
  g := k_glyph(t, tr_cat(idb[..], id, ".g"), state);
  a := tr_leaf(t, tr_cat(idc[..], id, ".what"), TG_SPAN, "tool-k", what);
  b := tr_leaf(t, tr_cat(idd[..], id, ".detail"), TG_SPAN, "tool-d", detail);
  x := tr_open(t, tr_cat(ide[..], id, ".x"), TG_SPAN, "tool-x");
  c := k_icon(t, tr_cat(idf[..], id, ".x.ic"), ifx open then IC_CHEVRON_UP else IC_CHEVRON_DOWN);
  tr_close(t);
  tr_close(t);
  if open {
    body := tr_open(t, tr_cat(idg[..], id, ".body"), TG_DIV, "tool-b");
    m := tr_leaf(t, tr_cat(idh[..], id, ".in"), TG_PRE, "", input);
    o := tr_leaf(t, tr_cat(idi[..], id, ".out"), TG_PRE, "", output);
    cp := k_icon_button(t, tr_cat(idj[..], id, ".copy"), IC_COPY, "Copy what came back");
    tr_close(t);
  }
  tr_close(t);
  return i;
}
// Notice: something the person must see, between two lines: its kind in words, then what happened. Close it with tr_close.
k_notice :: (t: [] Tree, u: [] Ui, id: string, kind: string, text: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  i := k_frame(t, u, id, TG_DIV, "notice", MF_NOTICE);
  tr_attr(t, i, AT_ROLE, "status");
  a := tr_leaf(t, tr_cat(ida[..], id, ".k"), TG_P, "notice-k", kind);
  b := tr_leaf(t, tr_cat(idb[..], id, ".t"), TG_P, "notice-t", text);
  return i;
}
// Row: a conversation in a list or a choice in a menu. The current one has an underline.
k_row :: (t: [] Tree, u: [] Ui, id: string, title: string, meta: string, current: bool) -> int { return k_row_busy(t, u, id, title, meta, current, false); }
// The same, with a turning mark at its right while what the row names is at work.
k_row_busy :: (t: [] Tree, u: [] Ui, id: string, title: string, meta: string, current: bool, busy: bool) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8;
  i := tr_open(t, id, TG_BUTTON, "row");
  if current {
    tr_frame(t, i, mono_kind(MF_ROW), MF_ROW, ui_progress(u, tr_cat(ida[..], id, ".on"), MONO_ENTER));
    tr_attr(t, i, AT_CURRENT, "true");
  }
  a := tr_leaf(t, tr_cat(ida[..], id, ".t"), TG_SPAN, "row-t", title);
  if meta.count > 0 { b := tr_leaf(t, tr_cat(idb[..], id, ".m"), TG_SPAN, "meta", meta); }
  if busy { tr_attr(t, i, AT_STATE, "busy"); c := k_icon(t, tr_cat(idc[..], id, ".busy"), IC_CIRCLE_DASHED); }
  tr_close(t);
  return i;
}
// Place: a row of a page's own navigation: an icon and a name, a link to where it goes. The one you are on
// has the underline.
k_place :: (t: [] Tree, u: [] Ui, id: string, icon: int, title: string, href: string, current: bool) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8;
  i := tr_open(t, id, TG_A, "row row-i");
  tr_attr(t, i, AT_HREF, href);
  if current {
    tr_frame(t, i, mono_kind(MF_ROW), MF_ROW, ui_progress(u, tr_cat(ida[..], id, ".on"), MONO_ENTER));
    tr_attr(t, i, AT_CURRENT, "true");
  }
  g := k_icon(t, tr_cat(idb[..], id, ".ic"), icon);
  a := tr_leaf(t, tr_cat(idc[..], id, ".t"), TG_SPAN, "row-t", title);
  tr_close(t);
  return i;
}
// Side: the app's frame down the left of every page for someone logged in (docs/app-shell.md), top to bottom:
// a head (the product's mark and name, a link home, and the page's actions as icon buttons), the places
// (k_place rows), the page's own list (it alone scrolls; k_side_mark heads each section of it, k_search
// above it narrows it), and a foot with who is logged in (k_who). The page builds them in that order:
//   k_side(t, "side", "Places");
//   k_side_head(t, "side.h", "OpenAgents", "/"); k_icon_button(...); tr_close(t);
//   k_side_places(t, "side"); k_place(...); ...
//   k_side_list(t, "side"); k_side_mark(...); k_row(...); ...
//   k_side_end(t); k_who(...); tr_close(t);
// A page that lets the side be put away draws k_side_open in its place, a button that brings it back.
k_side :: (t: [] Tree, id: string, label: string) -> int {
  i := tr_open(t, id, TG_NAV, "side");
  tr_attr(t, i, AT_LABEL, label);
  return i;
}
// The head: the mark and the name, a link to `home`. Its actions follow as icon buttons; close it with tr_close.
k_side_head :: (t: [] Tree, id: string, name: string, home: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; idc: [UI_ID] u8; idd: [UI_ID] u8;
  i := tr_open(t, id, TG_DIV, "side-h");
  a := tr_open(t, tr_cat(ida[..], id, ".home"), TG_A, "side-b");
  tr_attr(t, a, AT_HREF, home);
  m := tr_open(t, tr_cat(idb[..], id, ".mark"), TG_SVG, "ic");
  tr_attr(t, m, AT_HIDDEN, "true");
  g := tr_open(t, tr_cat(idc[..], id, ".mark.use"), TG_USE, "");
  tr_attr(t, g, AT_HREF, MONO_MARK);
  tr_close(t);
  tr_close(t);
  l := tr_leaf(t, tr_cat(idd[..], id, ".name"), TG_SPAN, "side-n", name);
  tr_close(t);
  return i;
}
// The places begin.
k_side_places :: (t: [] Tree, id: string) -> int {
  ida: [UI_ID] u8;
  return tr_open(t, tr_cat(ida[..], id, ".p"), TG_DIV, "side-p");
}
// The places end and the page's own list begins.
k_side_list :: (t: [] Tree, id: string) -> int {
  ida: [UI_ID] u8;
  tr_close(t);
  return tr_open(t, tr_cat(ida[..], id, ".l"), TG_DIV, "side-l");
}
// The list ends; the foot (k_who) follows, then the side closes with tr_close.
k_side_end :: (t: [] Tree) { tr_close(t); }
// A section's head in the list: its name and how many are in it.
k_side_mark :: (t: [] Tree, id: string, label: string, count: int) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8; num: [24] u8;
  i := tr_open(t, id, TG_H3, "side-m");
  a := tr_leaf(t, tr_cat(ida[..], id, ".t"), TG_SPAN, "", label);
  b := tr_leaf(t, tr_cat(idb[..], id, ".n"), TG_SPAN, "side-c", tr_join(num[..], "", count));
  tr_close(t);
  return i;
}
// Search: a one-line field with a magnifier that narrows a list as it is typed. Answers the field's node.
k_search :: (t: [] Tree, id: string, placeholder: string, label: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  w := tr_open(t, tr_cat(ida[..], id, ".w"), TG_DIV, "side-s");
  g := k_icon(t, tr_cat(idb[..], id, ".ic"), IC_SEARCH);
  f := tr_open(t, id, TG_INPUT, "");
  tr_attr(t, f, AT_TYPE, "search"); tr_attr(t, f, AT_COMPLETE, "off");
  tr_attr(t, f, AT_PLACEHOLDER, placeholder); tr_attr(t, f, AT_LABEL, label);
  tr_close(t);
  tr_close(t);
  return f;
}
// Who: the person logged in, at the foot. Their name or address is a link to their settings (`href`), and a
// Log out button sits beside it when `out` is true (the page does the logging out). With no name, the foot is
// a Log in link to `href` instead.
k_who :: (t: [] Tree, u: [] Ui, id: string, name: string, href: string, out: bool) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  i := tr_open(t, id, TG_DIV, "side-f");
  if name.count == 0 { a := k_place(t, u, tr_cat(ida[..], id, ".go"), IC_ENTER_LOGIN, "Log in", href, false); }
  else {
    a := k_place(t, u, tr_cat(ida[..], id, ".go"), IC_AVATAR_PROFILE, name, href, false);
    tr_attr(t, a, AT_TITLE, "Settings");
    if out { b := k_icon_button(t, tr_cat(idb[..], id, ".out"), IC_LOGOUT, "Log out"); }
  }
  tr_close(t);
  return i;
}
// The side put away: a button at the top left that brings it back.
k_side_open :: (t: [] Tree, id: string, label: string) -> int {
  i := k_icon_button(t, id, IC_MENU_SIDEBAR, label);
  tr_attr(t, i, AT_STATE, "side");
  return i;
}
// Drop: a place a file is dropped on, or picked from: a press opens the browser's picker, which
// offers the kinds `accept` names (".glb,.png"). It says what to do and, under it, what it takes.
// The host tells the page a file's name and size, and the page says what becomes of it
// (coax/web/dom-host.js, "Files"). While `busy` a file is on its way and it takes no other.
k_drop :: (t: [] Tree, u: [] Ui, id: string, title: string, note: string, accept: string, busy: bool) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  i := k_frame(t, u, id, TG_BUTTON, "drop", MF_FIELD);
  if busy { tr_attr(t, i, AT_STATE, "busy"); tr_attr(t, i, AT_DISABLED, ""); } else { tr_attr(t, i, AT_DROP, accept); }
  a := tr_leaf(t, tr_cat(ida[..], id, ".t"), TG_SPAN, "row-t", title);
  if note.count > 0 { b := tr_leaf(t, tr_cat(idb[..], id, ".m"), TG_SPAN, "meta", note); }
  tr_close(t);
  return i;
}
// File: a file or an asset in a list, by its name, with what it is and how big under it. It is text:
// a list of what is there, not a control.
k_file :: (t: [] Tree, id: string, name: string, about: string) -> int {
  ida: [UI_ID] u8; idb: [UI_ID] u8;
  i := tr_open(t, id, TG_DIV, "file");
  a := tr_leaf(t, tr_cat(ida[..], id, ".t"), TG_SPAN, "row-t", name);
  if about.count > 0 { b := tr_leaf(t, tr_cat(idb[..], id, ".m"), TG_SPAN, "meta", about); }
  tr_close(t);
  return i;
}
// Whether a picture's or a document's address is a path on this site: "/" and no second slash after it,
// no "..", nothing that would make the browser go elsewhere or run something.
k_here :: (src: string) -> bool {
  if src.count < 2 || src.count > 600 || src[0] != '/' || src[1] == '/' || src[1] == '\\' { return false; }
  for i: 0..<src.count {
    c := src[i];
    if c <= ' ' || c == 127 || c == '"' || c == '<' || c == '>' || c == '\\' { return false; }
    if c == '.' && i + 1 < src.count && src[i + 1] == '.' { return false; }
  }
  return true;
}
// Image: a picture from this site, with words for someone who cannot see it. `big`: as wide as its
// place and as tall as the skin lets it be (an image opened or pinned); else a small preview in a
// list. Nothing is drawn for an address that is not a path here.
k_image :: (t: [] Tree, id: string, src: string, alt: string, big: bool) -> int {
  if !k_here(src) { return -1; }
  i := tr_open(t, id, TG_IMG, ifx big then "img img-big" else "img");
  tr_attr(t, i, AT_SRC, src); tr_attr(t, i, AT_LABEL, alt);
  tr_close(t);
  return i;
}
// Document: a document from this site the browser shows paged (a PDF), in a frame as wide as its
// place. `title` names it for a reader. Nothing for an address that is not a path here.
k_document :: (t: [] Tree, id: string, src: string, title: string) -> int {
  if !k_here(src) { return -1; }
  i := tr_open(t, id, TG_IFRAME, "doc");
  tr_attr(t, i, AT_SRC, src); tr_attr(t, i, AT_TITLE, title);
  tr_close(t);
  return i;
}
// Header: the page's or a conversation's title, typed in. Close it with tr_close.
k_header :: (t: [] Tree, u: [] Ui, id: string, title: string) -> int {
  ida: [UI_ID] u8;
  i := k_frame(t, u, id, TG_HEADER, "hd", MF_HEADER);
  h := k_text(t, u, tr_cat(ida[..], id, ".t"), TG_H1, "hd-t", title);
  return i;
}
// Menu: rows in a panel. Close it with tr_close.
k_menu :: (t: [] Tree, u: [] Ui, id: string, label: string) -> int {
  i := k_frame(t, u, id, TG_DIV, "menu", MF_PANEL);
  tr_attr(t, i, AT_ROLE, "group"); tr_attr(t, i, AT_LABEL, label);
  return i;
}

// ---------------------------------------------------------------- checks

#test "a node enters over its time, later ones a stagger after, and reduced motion enters at once" {
  us: [1] Ui; u := us[..];
  ui_begin(u, 10, false);
  #assert ui_progress(u, "a", 1) == 0 && ui_progress(u, "b", 1) == 0 && u[0].busy && u[0].fresh == 2;
  ui_end(u);
  ui_begin(u, 10.5, false);
  a := ui_progress(u, "a", 1); b := ui_progress(u, "b", 1);
  #assert a == 0.5 && b < a && b > 0 && u[0].busy;
  ui_end(u);
  ui_begin(u, 12, false);
  #assert ui_progress(u, "a", 1) == 1 && ui_progress(u, "b", 1) == 1 && !u[0].busy;
  ui_end(u);
  // b is not built: it is forgotten, and enters again when it comes back
  ui_begin(u, 13, false);
  #assert ui_progress(u, "a", 1) == 1;
  ui_end(u);
  #assert u[0].nb == 1;
  ui_begin(u, 14, false);
  #assert ui_progress(u, "b", 1) == 0;
  ui_end(u);
  ui_begin(u, 14, true);
  #assert ui_progress(u, "c", 1) == 1 && !u[0].busy;
  ui_replay(u);
  #assert u[0].nb == 0;
}

#test "a button is a framed node and its label; a disabled one says so" {
  ts: [1] Tree; t := ts[..]; us: [1] Ui; u := us[..];
  tr_begin(t); ui_begin(u, 0, true);
  a := k_button(t, u, "send", "Send", BS_PRIMARY);
  b := k_button(t, u, "wait", "Wait", BS_DISABLED);
  #assert t[0].n == 4 && t[0].nodes[a].tag == TG_BUTTON && tr_class(t, a) == "btn" && t[0].nodes[a].frame == mono_kind(MF_BUTTON) + 1;
  #assert t[0].nodes[a].progress == 1 && tr_attr_of(t, a, AT_STATE) == "primary" && !tr_has(t, a, AT_DISABLED);
  #assert tr_id(t, a + 1) == "send.l" && tr_text_of(t, a + 1) == "Send" && t[0].nodes[a + 1].parent == a;
  #assert tr_has(t, b, AT_DISABLED) && !tr_has(t, b, AT_STATE) && t[0].depth == 0;
}

#test "a label types in with its whole text present, then is plain text" {
  ts: [1] Tree; t := ts[..]; us: [1] Ui; u := us[..];
  tr_begin(t); ui_begin(u, 0, false);
  i := k_text(t, u, "title", TG_H1, "hd-t", "COMPONENTS");
  ui_end(u);
  tr_begin(t); ui_begin(u, 0.07, false);
  i = k_text(t, u, "title", TG_H1, "hd-t", "COMPONENTS");
  #assert t[0].n == 3 && !t[0].nodes[i].has_text && u[0].busy;
  #assert tr_class(t, i + 1) == "sr" && tr_text_of(t, i + 1) == "COMPONENTS";
  typed := tr_text_of(t, i + 2);
  #assert typed.count > 0 && typed.count < 10 && tr_attr_of(t, i + 2, AT_HIDDEN) == "true" && typed == cast(string) "COMPONENTS"[0..<typed.count];
  ui_end(u);
  tr_begin(t); ui_begin(u, 5, false);
  i = k_text(t, u, "title", TG_H1, "hd-t", "COMPONENTS");
  #assert t[0].n == 1 && tr_text_of(t, i) == "COMPONENTS" && !u[0].busy;
}

#test "an answer's Markdown becomes paragraphs, inline nodes, a list and a code block" {
  ts: [1] Tree; t := ts[..]; us: [1] Ui; u := us[..]; docs: [1] MdDoc; doc := docs[..];
  n := md_parse(doc, "It reads `chat.coax` and **stops**. See [the audit](/a).\n\n- one\n- two\n\n```sh\nls\n```", 0);
  #assert n == 3;
  tr_begin(t); ui_begin(u, 0, true);
  i := k_agent(t, u, "m", doc);
  p := tr_find(t, "m.b0");
  #assert p > 0 && t[0].nodes[p].tag == TG_P && !t[0].nodes[p].has_text;
  code := tr_find(t, "m.b0.1");
  #assert code > 0 && t[0].nodes[code].tag == TG_CODE && tr_text_of(t, code) == "chat.coax";
  strong := tr_find(t, "m.b0.3");
  #assert t[0].nodes[strong].tag == TG_STRONG && tr_text_of(t, strong) == "stops";
  found := false;
  for k: 0..<t[0].n { if t[0].nodes[k].tag == TG_A { found = tr_text_of(t, k) == "the audit" && tr_attr_of(t, k, AT_HREF) == "/a"; } }
  #assert found;
  li := tr_find(t, "m.b1.i1");
  #assert t[0].nodes[li].tag == TG_LI && t[0].nodes[t[0].nodes[li].parent].tag == TG_UL && tr_text_of(t, tr_find(t, "m.b1.i1.0")) == "two";
  pre := tr_find(t, "m.b2.pre");
  #assert t[0].nodes[pre].tag == TG_PRE && tr_text_of(t, pre) == "ls" && tr_text_of(t, tr_find(t, "m.b2.lang")) == "sh";
  #assert t[0].depth == 0 && t[0].lost == 0;
}

#test "a code field is a framed field that names its language and has no placeholder" {
  ts: [1] Tree; t := ts[..]; us: [1] Ui; u := us[..];
  ui_begin(u, 0, true); tr_begin(t);
  f := k_code_field(t, u, "src", "coax", "The file's text");
  g := k_code_field(t, u, "notes", "", "Notes");
  ui_end(u);
  #assert t[0].lost == 0 && t[0].depth == 0 && f == tr_find(t, "src") && t[0].nodes[f].tag == TG_TEXTAREA;
  #assert tr_class(t, tr_find(t, "src.frame")) == "field code-in" && tr_attr_of(t, f, AT_LANG) == "coax" && tr_attr_of(t, f, AT_LABEL) == "The file's text";
  #assert tr_attr_of(t, g, AT_LANG) == "text" && !tr_has(t, f, AT_PLACEHOLDER) && !tr_has(t, f, AT_ROWS);
}

#test "a tool call opens onto what it sent and what came back; a current row is framed" {
  ts: [1] Tree; t := ts[..]; us: [1] Ui; u := us[..];
  tr_begin(t); ui_begin(u, 0, true);
  a := k_tool(t, u, "tool.1", "Read", "docs/chat.md", false, "in", "out");
  #assert tr_find(t, "tool.1.body") < 0 && tr_attr_of(t, tr_find(t, "tool.1"), AT_EXPANDED) == "false" && tr_text_of(t, tr_find(t, "tool.1.x")) == "Show";
  tr_begin(t);
  a = k_tool(t, u, "tool.1", "Read", "docs/chat.md", true, "in", "out");
  #assert tr_text_of(t, tr_find(t, "tool.1.out")) == "out" && tr_attr_of(t, tr_find(t, "tool.1"), AT_EXPANDED) == "true";
  r := k_row(t, u, "row.1", "Zero-base the chat", "Opus 5.5", true);
  q := k_row(t, u, "row.2", "Other", "", false);
  #assert t[0].nodes[r].frame > 0 && tr_attr_of(t, r, AT_CURRENT) == "true" && t[0].nodes[q].frame == 0 && tr_find(t, "row.2.m") < 0;
  #assert t[0].depth == 0;
}

#test "a tool line is one row with a glyph that opens onto its input and output; a value deciphers with its whole text present" {
  ts: [1] Tree; t := ts[..]; us: [1] Ui; u := us[..];
  tr_begin(t); ui_begin(u, 0, true);
  a := k_tool_line(t, u, "tl.1", "nostr.sign", "sig 6d2a", TL_RUN, false, "in", "out");
  #assert tr_find(t, "tl.1.body") < 0 && tr_attr_of(t, a, AT_STATE) == "run" && tr_attr_of(t, tr_find(t, "tl.1.g"), AT_STATE) == "run";
  #assert t[0].nodes[tr_find(t, "tl.1")].tag == TG_BUTTON && tr_attr_of(t, tr_find(t, "tl.1"), AT_EXPANDED) == "false" && tr_text_of(t, tr_find(t, "tl.1.detail")) == "sig 6d2a";
  tr_begin(t);
  a = k_tool_line(t, u, "tl.1", "nostr.verify", "refused", TL_NO, true, "in", "out");
  #assert tr_attr_of(t, a, AT_STATE) == "no" && tr_text_of(t, tr_find(t, "tl.1.out")) == "out" && tr_find(t, "tl.1.copy") > 0 && t[0].depth == 0;
  tr_begin(t);
  d := k_decipher(t, "v", TG_P, "val", "npub1mlcawle2", 0.5, 3);
  #assert t[0].n == 3 && tr_text_of(t, d + 1) == "npub1mlcawle2" && tr_class(t, d + 1) == "sr" && tr_attr_of(t, d + 2, AT_HIDDEN) == "true";
  half := tr_text_of(t, d + 2); same := 0;
  for k: 0..<half.count { if half[k] == "npub1mlcawle2"[k] { same += 1; } }
  #assert half.count == 13 && same >= 6 && same < 13;
  tr_begin(t);
  d = k_decipher(t, "v", TG_P, "val", "npub1mlcawle2", 1, 3);
  #assert t[0].n == 1 && tr_text_of(t, d) == "npub1mlcawle2";
  f := k_frame_at(t, "f", TG_DIV, "x", MF_PANEL, 0.25);
  k_var(t, f, 0.4236); tr_close(t);
  #assert t[0].nodes[f].progress == 0.25 && t[0].nodes[f].frame == mono_kind(MF_PANEL) + 1 && tr_attr_of(t, f, AT_VARS) == "--p:0.424";
  g := tr_leaf(t, "g", TG_SPAN, "", ""); k_var(t, g, 2); #assert tr_attr_of(t, g, AT_VARS) == "--p:1";
  k_var(t, g, -1); #assert tr_attr_of(t, g, AT_VARS) == "--p:0.000";
}

#test "a drop target says what it takes and names the kinds its picker offers; a busy one takes nothing; a file is its name and what it is" {
  h: [1] DkDropTest; t := h[0].t[..]; u := h[0].u[..];
  ui_begin(u, 0, true); tr_begin(t);
  a := k_drop(t, u, "drop", "Drop a file here, or press to pick one", "512 KB at most", ".glb,.png", false);
  b := k_drop(t, u, "busy", "Sending rock.glb", "", "", true);
  f := k_file(t, "file.1", "rock", "Mesh, 2 KB");
  g := k_file(t, "file.2", "door", "");
  ui_end(u);
  #assert t[0].lost == 0 && t[0].depth == 0;
  #assert t[0].nodes[a].tag == TG_BUTTON && tr_class(t, a) == "drop" && tr_attr_of(t, a, AT_DROP) == ".glb,.png" && !tr_has(t, a, AT_DISABLED) && tr_has(t, a, AT_FRAME);
  #assert tr_text_of(t, tr_find(t, "drop.t")) == "Drop a file here, or press to pick one" && tr_text_of(t, tr_find(t, "drop.m")) == "512 KB at most";
  #assert !tr_has(t, b, AT_DROP) && tr_has(t, b, AT_DISABLED) && tr_attr_of(t, b, AT_STATE) == "busy" && tr_find(t, "busy.m") < 0;
  #assert t[0].nodes[f].tag == TG_DIV && tr_class(t, f) == "file" && tr_text_of(t, tr_find(t, "file.1.t")) == "rock" && tr_text_of(t, tr_find(t, "file.1.m")) == "Mesh, 2 KB" && tr_find(t, "file.2.m") < 0;
  names := AT_NAMES; #assert names[AT_DROP] == "data-drop" && names[AT_STEP] == "step" && names[AT_SRC] == "src" && AT_COUNT == 24;
}
#test "an image and a document from this site, and nothing from anywhere else" {
  h: [1] DkDropTest; t := h[0].t[..];
  tr_begin(t);
  a := k_image(t, "pic", "/api/worlds/splice/files/00112233445566aa", "Raider garage", true);
  b := k_image(t, "thumb", "/api/worlds/splice/files/00112233445566bb", "City", false);
  c := k_document(t, "pdf", "/api/worlds/splice/files/00112233445566cc", "Boss reference");
  #assert t[0].nodes[a].tag == TG_IMG && tr_class(t, a) == "img img-big" && tr_attr_of(t, a, AT_SRC) == "/api/worlds/splice/files/00112233445566aa" && tr_attr_of(t, a, AT_LABEL) == "Raider garage";
  #assert tr_class(t, b) == "img" && t[0].nodes[c].tag == TG_IFRAME && tr_attr_of(t, c, AT_TITLE) == "Boss reference";
  for bad: [7] string.["https://evil.example/x.png", "//evil.example/x.png", "javascript:alert(1)", "/a/../b", "/a b", "", "/\\evil"] {
    #assert k_image(t, "no", bad, "", true) == -1 && k_document(t, "no", bad, "") == -1;
  }
  names := TG_NAMES; #assert names[TG_IMG] == "img" && names[TG_IFRAME] == "iframe" && t[0].depth == 0;
}
DkDropTest :: struct { t: [1] Tree; u: [1] Ui; }

#test "a side is a head, places, a list that scrolls with its sections, then who is logged in" {
  h: [1] DkDropTest; t := h[0].t[..]; u := h[0].u[..];
  ui_begin(u, 0, true); tr_begin(t);
  s := k_side(t, "side", "Places");
  hd := k_side_head(t, "side.h", "OpenAgents", "/");
  x := k_icon_button(t, "side.hide", IC_MENU_SIDEBAR, "Hide the side");
  tr_close(t);
  p := k_side_places(t, "side");
  a := k_place(t, u, "place.a", IC_CHATS, "Chats", "/chat", true);
  b := k_place(t, u, "place.b", IC_FOLDER, "Projects", "/projects", false);
  l := k_side_list(t, "side");
  q := k_search(t, "side.q", "Search", "Search the chats");
  m := k_side_mark(t, "side.run", "Running", 2);
  r := k_row(t, u, "row.1", "A chat", "", false);
  k_side_end(t);
  w := k_who(t, u, "who", "a@example.com", "/settings", true);
  tr_close(t);
  ui_end(u);
  #assert t[0].lost == 0 && t[0].depth == 0;
  #assert t[0].nodes[s].tag == TG_NAV && tr_class(t, s) == "side" && tr_attr_of(t, s, AT_LABEL) == "Places";
  #assert tr_class(t, hd) == "side-h" && t[0].nodes[hd].parent == s && t[0].nodes[x].parent == hd;
  home := tr_find(t, "side.h.home");
  #assert tr_attr_of(t, home, AT_HREF) == "/" && tr_text_of(t, tr_find(t, "side.h.name")) == "OpenAgents" && tr_attr_of(t, tr_find(t, "side.h.mark.use"), AT_HREF) == MONO_MARK;
  #assert tr_class(t, p) == "side-p" && t[0].nodes[p].parent == s && t[0].nodes[a].parent == p && t[0].nodes[b].parent == p;
  #assert tr_class(t, l) == "side-l" && t[0].nodes[l].parent == s && t[0].nodes[r].parent == l && t[0].nodes[m].parent == l;
  #assert t[0].nodes[q].tag == TG_INPUT && tr_attr_of(t, q, AT_TYPE) == "search" && tr_attr_of(t, q, AT_LABEL) == "Search the chats";
  #assert tr_text_of(t, tr_find(t, "side.run.t")) == "Running" && tr_text_of(t, tr_find(t, "side.run.n")) == "2";
  #assert tr_class(t, w) == "side-f" && t[0].nodes[w].parent == s;
  #assert tr_attr_of(t, a, AT_CURRENT) == "true" && !tr_has(t, b, AT_CURRENT) && tr_attr_of(t, b, AT_HREF) == "/projects";
  go := tr_find(t, "who.go");
  #assert t[0].nodes[go].tag == TG_A && tr_attr_of(t, go, AT_HREF) == "/settings" && tr_text_of(t, tr_find(t, "who.go.t")) == "a@example.com";
  #assert tr_attr_of(t, tr_find(t, "who.out"), AT_LABEL) == "Log out";
  tr_begin(t);
  w = k_who(t, u, "who", "", "/login", true);
  o := k_side_open(t, "side.show", "Show the side");
  #assert tr_find(t, "who.out") < 0 && tr_text_of(t, tr_find(t, "who.go.t")) == "Log in" && tr_attr_of(t, tr_find(t, "who.go"), AT_HREF) == "/login";
  #assert tr_attr_of(t, o, AT_LABEL) == "Show the side" && tr_attr_of(t, o, AT_STATE) == "side";
}
