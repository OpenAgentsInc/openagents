// Markdown, the component: a parsed document's blocks (core/markdown.coax)
// laid out at a width in a skin and painted onto a sheet
// (components/spec.md, GitHub #13153). One file draws Markdown for every
// target and every skin: it measures through layout/measure.coax (pixels or
// cells), wraps with layout/text.coax, reads every colour, face and measure
// from the skin, and paints primitives, never vertices or escape codes.
//
// A block is a paragraph, a list (the skin's bullet or numbers in a marker
// column, a nested item one column further in, under its parent's text), a
// quote (a rail over a wash, its paragraphs in the muted tone), a fenced
// code block (a frame, a header with the language and its two actions, the
// highlighted lines) or a GFM table. The layout is Zeron's (render.rs,
// mugen-markdown's TableBlock under Zeron's md theme); a skin changes its
// measures and colours, not its rules. Based on Zeron by Wing, MIT.
//   coax/bin/coax test components/kit/markdown.coax

#load "../core/syntax.coax";
#load "../core/veil.coax";
#load "../paint/sheet.coax";
#load "../skin/skin.coax";

// Optional paint-only opacity veil for streaming markdown (empty veil = full opacity).
MdVeil :: struct { veil: [] Veil; now: f32; }
md_veil_alpha :: (vv: MdVeil, pos: int) -> f32 {
  if vv.veil.count == 0 { return 1.0f32; }
  return veil_alpha_at(vv.veil, vv.now, pos);
}
md_veil_next :: (vv: MdVeil, pos: int, limit: int) -> int {
  if vv.veil.count == 0 { return limit; }
  return veil_next_edge(vv.veil, pos, limit);
}

// The hits a code block's header leaves on the sheet: a = the block.
MARKDOWN_HIT_WRAP :: 3; MARKDOWN_HIT_COPY :: 4;
// With the skin's md.link_paths, inline code that names a file (md_path_like) drawn whole on
// one line leaves this hit over it: a = where the code starts in its text, b = where it ends.
MARKDOWN_HIT_PATH :: 6;
// With the skin's md.link_urls, a link run leaves this hit over each wrapped piece:
// a = link_at in doc.links, b = link_n.
MARKDOWN_HIT_LINK :: 7;

// Whether bytes i to j are one whole code run (not part of one wrapped over two lines).
markdown_whole_code :: (runs: [] MdRun, i: int, j: int) -> bool {
  for k: 0..<runs.count { if runs[k].style == MD_CODE && runs[k].from == i && runs[k].to == j { return true; } }
  return false;
}
// A file a block names in inline code: the text it is in (the block's, or an item's), and where.
MdPath :: struct { text: string; from: int; to: int; }
// The files block b names in inline code, in the order they are drawn, into out. Returns how many.
markdown_paths :: (doc: [] MdDoc, b: int, out: [] MdPath) -> int {
  kind := doc[0].blocks[b].kind;
  if kind == MB_CODE || kind == MB_RULE { return 0; }
  if kind == MB_PARA { return markdown_paths_in(md_block_text(doc, b), md_block_runs(doc, b), out, 0); }
  n := 0; i0 := doc[0].blocks[b].item0;
  for k: 0..<doc[0].blocks[b].items { n = markdown_paths_in(md_item_text(doc, i0 + k), md_item_runs(doc, i0 + k), out, n); }
  return n;
}
markdown_paths_in :: (text: string, runs: [] MdRun, out: [] MdPath, n0: int) -> int {
  n := n0;
  for k: 0..<runs.count {
    r := runs[k];
    if r.style != MD_CODE || r.to > text.count || r.from >= r.to || n >= out.count { continue; }
    if md_path_like(cast(string) text[r.from..<r.to]) { out[n] = MdPath.{text = text, from = r.from, to = r.to}; n += 1; }
  }
  return n;
}

// The index of the run covering byte pos that carries a link target, or -1.
markdown_link_run_at :: (runs: [] MdRun, pos: int) -> int {
  for k: 0..<runs.count {
    if (runs[k].marks & MD_LINK) != 0 && runs[k].link_n > 0 && pos >= runs[k].from && pos < runs[k].to { return k; }
  }
  return -1;
}
// An http:// or https:// link in a block: its slice in doc.links.
MdLink :: struct { at: int; n: int; }
// The http(s) links in block b, in the order they are drawn, into out. Returns how many.
markdown_links :: (doc: [] MdDoc, b: int, out: [] MdLink) -> int {
  kind := doc[0].blocks[b].kind;
  if kind == MB_CODE || kind == MB_RULE { return 0; }
  if kind == MB_PARA {
    return markdown_links_in(doc, md_block_runs(doc, b), out, 0);
  }
  n := 0; i0 := doc[0].blocks[b].item0;
  for k: 0..<doc[0].blocks[b].items { n = markdown_links_in(doc, md_item_runs(doc, i0 + k), out, n); }
  return n;
}
markdown_links_in :: (doc: [] MdDoc, runs: [] MdRun, out: [] MdLink, n0: int) -> int {
  n := n0;
  for k: 0..<runs.count {
    r := runs[k];
    if (r.marks & MD_LINK) == 0 || r.link_n <= 0 || r.link_at + r.link_n > doc[0].nlink || n >= out.count { continue; }
    url := cast(string) doc[0].links[r.link_at..<r.link_at + r.link_n];
    if md_url_http(url) { out[n] = MdLink.{at = r.link_at, n = r.link_n}; n += 1; }
  }
  return n;
}

// One wrapped line of styled text: each run in its face and colour, inline
// code on its rounded wash (painted under the glyphs, past them by the
// skin's pad, inset from the line box). A code run that ends the line leaves
// its trailing spaces off the wash, so a chip broken at a space ends at its
// last glyph, inside the column (text_wrap left room for the pad).
markdown_line :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, faces: TextFaces, text: string, runs: [] MdRun, from: int, to: int, x: f32, y: f32, lh: f32, color: Rgba, hard: bool) {
  markdown_line_veiled(sh, m, s, faces, text, runs, from, to, x, y, lh, color, hard, 0, MdVeil.{});
}
markdown_line_veiled :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, faces: TextFaces, text: string, runs: [] MdRun, from: int, to: int, x: f32, y: f32, lh: f32, color: Rgba, hard: bool, base: int, vv: MdVeil) {
  ln := sheet_line(sh, x, y, lh, hard);
  i := from; pen := x;
  while i < to {
    style := md_style_at(runs, i); marks := md_marks_at(runs, i);
    link_k := ifx (marks & MD_LINK) != 0 then markdown_link_run_at(runs, i) else -1;
    j := i;
    while j < to && md_style_at(runs, j) == style && md_marks_at(runs, j) == marks && (link_k < 0 || markdown_link_run_at(runs, j) == link_k) { j += 1; }
    if vv.veil.count > 0 {
      edge := md_veil_next(vv, base + i, base + j) - base;
      if edge > i && edge < j { j = edge; }
    }
    a := md_veil_alpha(vv, base + i);
    seg := cast(string) text[i..<j];
    face := text_face(faces, style);
    w: f32 = 0;
    pad_l: f32 = 0; pad_r: f32 = 0;
    if style == MD_CODE {
      lit := seg.count;
      if j == to { while lit > 0 && seg[lit - 1] == ' ' { lit -= 1; } }
      if lit > 0 {
        if i == from || md_style_at(runs, i - 1) != MD_CODE { pad_l = s.md.code_pad_x; }
        if j == to || md_style_at(runs, j) != MD_CODE { pad_r = s.md.code_pad_x; }
      }
      ww := measure_width(m, face, cast(string) seg[0..<lit]);
      if lit > 0 { sheet_fill(sh, pen, y + s.md.code_inset_y, ww + pad_l + pad_r, lh - 2 * s.md.code_inset_y, s.md.code_radius, opacity(s.code_wash, a)); }
      w = sheet_text(sh, m, ln, pen + pad_l, y, lh, face, opacity(s.accent, a), seg);
      if s.md.link_urls && link_k >= 0 && lit > 0 {
        sheet_hit(sh, MARKDOWN_HIT_LINK, runs[link_k].link_at, runs[link_k].link_n, pen, y, ww + pad_l + pad_r, lh);
      } else if s.md.link_paths && lit > 0 && markdown_whole_code(runs, i, j) && md_path_like(cast(string) seg[0..<lit]) {
        sheet_hit(sh, MARKDOWN_HIT_PATH, i, j, pen, y, ww + pad_l + pad_r, lh);
      }
    } else {
      // a link reads in the accent with an underline; struck text keeps its colour under a rule through its middle
      c := ifx (marks & MD_LINK) != 0 then s.accent else color;
      w = sheet_text(sh, m, ln, pen, y, lh, face, opacity(c, a), seg);
      if (marks & MD_LINK) != 0 && w > 0 {
        sheet_rule(sh, pen, y + lh - 2 * s.border, w, s.border, opacity(c, a * 0.55));
        if s.md.link_urls && link_k >= 0 {
          sheet_hit(sh, MARKDOWN_HIT_LINK, runs[link_k].link_at, runs[link_k].link_n, pen, y, w, lh);
        }
      }
    }
    if (marks & MD_STRIKE) != 0 { sheet_rule(sh, pen + pad_l, y + (lh - s.border) / 2, w, s.border, opacity(color, a)); }
    pen += pad_l + w + pad_r;
    i = j;
  }
}

// A wrapped styled text at (x, y), width w; returns its height.
markdown_text :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, text: string, runs: [] MdRun, x: f32, y: f32, w: f32, lh: f32, color: Rgba) -> f32 {
  return markdown_text_veiled(sh, m, s, text, runs, x, y, w, lh, color, 0, MdVeil.{});
}
markdown_text_veiled :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, text: string, runs: [] MdRun, x: f32, y: f32, w: f32, lh: f32, color: Rgba, base: int, vv: MdVeil) -> f32 {
  lines: [64] TextLine;
  faces := uiskin_faces(s);
  n := text_wrap(m, faces, text, runs, w, lines[..]);
  for k: 0..<n { markdown_line_veiled(sh, m, s, faces, text, runs, lines[k].from, lines[k].to, x, y + cast(f32) k * lh, lh, color, k + 1 == n, base, vv); }
  return cast(f32) n * lh;
}

// Paint a slice of a code line, splitting at veil chunk boundaries.
markdown_syntax_seg :: (sh: [] Sheet, m: TextMeasure, ln: int, line: string, from: int, to: int, pen: f32, y: f32, lh: f32, face: int, color: Rgba, base: int, vv: MdVeil) -> f32 {
  p := pen; i := from;
  while i < to {
    j := to;
    if vv.veil.count > 0 {
      edge := md_veil_next(vv, base + i, base + to) - base;
      if edge > i && edge < j { j = edge; }
    }
    a := md_veil_alpha(vv, base + i);
    p += sheet_text(sh, m, ln, p, y, lh, face, opacity(color, a), cast(string) line[i..<j]);
    i = j;
  }
  return p;
}

// A highlighted line of code as one selectable line (the spaces between
// tokens included, in the plain colour).
markdown_syntax_line :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, line: string, runs: [] MdRun, x: f32, y: f32, lh: f32, face: int, plain: Rgba) {
  markdown_syntax_line_veiled(sh, m, s, line, runs, x, y, lh, face, plain, 0, MdVeil.{});
}
markdown_syntax_line_veiled :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, line: string, runs: [] MdRun, x: f32, y: f32, lh: f32, face: int, plain: Rgba, base: int, vv: MdVeil) {
  ln := sheet_line(sh, x, y, lh, true);
  n := syn_rust(line, runs);
  pen := x; i := 0;
  for k: 0..<n {
    if runs[k].from > i { pen = markdown_syntax_seg(sh, m, ln, line, i, runs[k].from, pen, y, lh, face, plain, base, vv); }
    pen = markdown_syntax_seg(sh, m, ln, line, runs[k].from, runs[k].to, pen, y, lh, face, uiskin_syntax(s, runs[k].style, plain), base, vv);
    i = runs[k].to;
  }
  if i < line.count { pen = markdown_syntax_seg(sh, m, ln, line, i, line.count, pen, y, lh, face, plain, base, vv); }
}

// A slice [from..<to) of a syntax-highlighted line as one selectable line.
markdown_syntax_slice_veiled :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, line: string, runs: [] MdRun, nruns: int, from: int, to: int, x: f32, y: f32, lh: f32, face: int, plain: Rgba, base: int, vv: MdVeil, hard: bool) {
  ln := sheet_line(sh, x, y, lh, hard);
  pen := x; i := from;
  for k: 0..<nruns {
    rf := runs[k].from; rt := runs[k].to;
    if rt <= from { continue; }
    if rf >= to { break; }
    if rf < from { rf = from; }
    if rt > to { rt = to; }
    if rf > i { pen = markdown_syntax_seg(sh, m, ln, line, i, rf, pen, y, lh, face, plain, base, vv); }
    pen = markdown_syntax_seg(sh, m, ln, line, rf, rt, pen, y, lh, face, uiskin_syntax(s, runs[k].style, plain), base, vv);
    i = rt;
  }
  if i < to { pen = markdown_syntax_seg(sh, m, ln, line, i, to, pen, y, lh, face, plain, base, vv); }
}

// Wraps one logical line of code to fit inside `room` layout units so code never overflows its frame.
markdown_code_wrap :: (m: TextMeasure, face: int, line: string, room: f32, out: [] TextLine) -> int {
  if line.count == 0 || room <= 0.0f32 || out.count == 0 || measure_width(m, face, line) <= room + 0.5f32 {
    if out.count > 0 { out[0] = TextLine.{from = 0, to = line.count}; return 1; }
    return 0;
  }
  n := 0; at := 0;
  while at < line.count && n < out.count {
    rem := cast(string) line[at..<line.count];
    if n + 1 == out.count || measure_width(m, face, rem) <= room + 0.5f32 {
      out[n] = TextLine.{from = at, to = line.count};
      n += 1;
      break;
    }
    i := at; last_fit := at; brk := -1;
    while i < line.count {
      j := i + 1;
      while j < line.count && (line[j] & 0xC0) == 0x80 { j += 1; }
      if measure_width(m, face, cast(string) line[at..<j]) > room + 0.5f32 { break; }
      last_fit = j;
      ch := line[i];
      if (ch == ' ' || ch == '\t' || ch == '/' || ch == ':' || ch == '-' || ch == ',' || ch == ';' || ch == '=') && j - at >= 4 {
        brk = j;
      }
      i = j;
    }
    cut := ifx brk > at then brk else last_fit;
    if cut <= at {
      cut = at + 1;
      while cut < line.count && (line[cut] & 0xC0) == 0x80 { cut += 1; }
    }
    out[n] = TextLine.{from = at, to = cut};
    n += 1;
    at = cut;
  }
  return ifx n > 0 then n else 1;
}

// A fenced code block's height at any width: its borders, header, padding and lines.
markdown_code_height :: (s: UiSkin, code: string) -> f32 {
  nl := 1;
  for k: 0..<code.count { if code[k] == '\n' { nl += 1; } }
  return 2 * s.md.block_border + s.md.block_header + 2 * s.md.block_pad_y + cast(f32) nl * s.md.block_line;
}

// A fenced code block (render.rs code_block_frame): the frame, the header
// with the language and its two actions (a skin with no header or no
// actions draws none), the highlighted lines soft-wrapped to stay inside w.
markdown_code :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, doc: [] MdDoc, b: int, x: f32, y: f32, w: f32) -> f32 {
  return markdown_code_veiled(sh, m, s, doc, b, x, y, w, MdVeil.{});
}
markdown_code_veiled :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, doc: [] MdDoc, b: int, x: f32, y: f32, w: f32, vv: MdVeil) -> f32 {
  code := md_block_text(doc, b);
  lang := md_lang(doc, b);
  bd := s.md.block_border;
  head := ifx s.md.block_header > 0 && (lang.count > 0 || s.md.action > 0) then s.md.block_header else 0.0f32;
  room := w - 2 * bd - 2 * s.md.block_pad_x;
  wraps: [32] TextLine;
  total_rows := 0;
  ci := 0;
  while ci <= code.count {
    cj := ci; while cj < code.count && code[cj] != '\n' { cj += 1; }
    total_rows += markdown_code_wrap(m, s.mono.face, cast(string) code[ci..<cj], room, wraps[..]);
    ci = cj + 1;
  }
  if total_rows < 1 { total_rows = 1; }
  h := 2 * bd + head + 2 * s.md.block_pad_y + cast(f32) total_rows * s.md.block_line;
  border := s.hairline;
  bb := sheet_box(sh, x, y, w, h, s.md.block_radius, bd, s.sunk, border);
  if head > 0 {
    // the header: its wash over the frame, its bottom hairline
    sheet_fill(sh, x + bd, y + bd, w - 2 * bd, head - bd, 0, s.header_wash);
    sheet_fill(sh, x + bd, y + head, w - 2 * bd, bd, 0, border);
    llh := s.small.line;
    ly := y + bd + (head - bd - llh) / 2;
    lw := sheet_text(sh, m, -1, x + bd + s.md.block_pad_x, ly, llh, s.small.face, s.muted, lang);
    act := s.md.action;
    if act > 0 {
      // actions, right to left: Copy (two wider than Wrap: its side padding and its icon), then Wrap, 2 apart, 5 from the edge
      ay := y + bd + (head - bd - act) / 2;
      md := s.md;
      copy_w := act + md.action_gap;
      copy_x := x + w - bd - md.action_edge - copy_w;
      wrap_x := copy_x - md.action_gap - act;
      if sheet_hovered(sh, MARKDOWN_HIT_WRAP, b, 0) { sheet_fill(sh, wrap_x, ay, act, act, md.wrap_radius, s.hover); }
      if sheet_hovered(sh, MARKDOWN_HIT_COPY, b, 0) { sheet_fill(sh, copy_x, ay, copy_w, act, md.copy_radius, s.hover); }
      sheet_icon(sh, s.icon_wrap, wrap_x + (act - md.wrap_icon) / 2, ay + (act - md.wrap_icon) / 2, md.wrap_icon, s.muted);
      sheet_icon(sh, s.icon_copy, copy_x + md.copy_icon_x, ay + (act - md.copy_icon) / 2, md.copy_icon, s.muted);
      sheet_hit(sh, MARKDOWN_HIT_WRAP, b, 0, wrap_x, ay, act, act);
      sheet_hit(sh, MARKDOWN_HIT_COPY, b, 0, copy_x, ay, copy_w, act);
    }
  }
  // the lines (soft-wrapped to stay inside the code frame)
  top := y + bd + head + s.md.block_pad_y;
  lx := x + bd + s.md.block_pad_x;
  i := 0; k := 0;
  runs: [128] MdRun;
  while i <= code.count {
    j := i; while j < code.count && code[j] != '\n' { j += 1; }
    line := cast(string) code[i..<j];
    nw := markdown_code_wrap(m, s.mono.face, line, room, wraps[..]);
    if nw <= 1 {
      markdown_syntax_line_veiled(sh, m, s, line, runs[..], lx, top + cast(f32) k * s.md.block_line, s.md.block_line, s.mono.face, s.ink, doc[0].blocks[b].at + i, vv);
      k += 1;
    } else {
      nruns := syn_rust(line, runs[..]);
      for wi: 0..<nw {
        markdown_syntax_slice_veiled(sh, m, s, line, runs[..], nruns, wraps[wi].from, wraps[wi].to, lx, top + cast(f32) k * s.md.block_line, s.md.block_line, s.mono.face, s.ink, doc[0].blocks[b].at + i, vv, wi + 1 == nw);
        k += 1;
      }
    }
    i = j + 1;
  }
  return h;
}

// ---------------------------------------------------------------- tables
// A GFM table (render.rs render_table): every cell's natural width is its
// text unwrapped (the header row in its weight); a column's natural is the
// widest, floored at the skin's minimum content, plus its padding; its
// minimum min(natural, the skin's column minimum). The table spans the
// column, columns sharing it in proportion to their naturals (flex-grow
// natural on a zero basis), none below its minimum (CSS flex's frozen
// violations, as Taffy resolves them); when the minimums overflow the
// column, each column takes its minimum. Cells wrap their text at the
// column's width less the padding and align it as the delimiter row says; a
// row is as tall as its tallest cell; a hairline between rows. Copy reads
// the cells in order, one to a line.
MarkdownTable :: struct { cols: int; rows: int; w: [MD_TABLE_COLS] f32; x: [MD_TABLE_COLS + 1] f32; total: f32; }

// The column widths for naturals and minimums sharing width avail.
markdown_table_share :: (naturals: [] f32, minimums: [] f32, cols: int, avail: f32, out: [] f32) -> f32 {
  sum_min: f32 = 0;
  for c: 0..<cols { sum_min += minimums[c]; }
  space := ifx sum_min > avail then sum_min else avail;
  frozen: [MD_TABLE_COLS] bool;
  for c: 0..<cols { frozen[c] = false; }
  // freeze the columns whose share falls under their minimum until none does
  rounds := 0;
  while rounds <= cols {
    rounds += 1;
    left := space; grow: f32 = 0;
    for c: 0..<cols { if frozen[c] { left -= minimums[c]; } else { grow += naturals[c]; } }
    any := false;
    for c: 0..<cols {
      if frozen[c] { out[c] = minimums[c]; continue; }
      out[c] = ifx grow > 0 then left * naturals[c] / grow else 0.0f32;
    }
    for c: 0..<cols { if !frozen[c] && out[c] < minimums[c] { frozen[c] = true; any = true; } }
    if !any { break; }
  }
  return space;
}

markdown_table_measure :: (m: TextMeasure, s: UiSkin, doc: [] MdDoc, b: int, w: f32) -> MarkdownTable {
  L: MarkdownTable;
  L.cols = doc[0].blocks[b].cols; L.rows = md_table_rows(doc, b);
  i0 := doc[0].blocks[b].item0;
  faces := uiskin_faces(s);
  content: [MD_TABLE_COLS] f32; naturals: [MD_TABLE_COLS] f32; minimums: [MD_TABLE_COLS] f32;
  for c: 0..<L.cols { content[c] = 0; }
  for r: 0..<L.rows {
    for c: 0..<L.cols {
      k := i0 + r * L.cols + c;
      text := md_item_text(doc, k);
      cw := text_run_width(m, faces, text, md_item_runs(doc, k), 0, text.count);
      if cw > content[c] { content[c] = cw; }
    }
  }
  for c: 0..<L.cols {
    naturals[c] = (ifx content[c] > s.md.col_min_content then content[c] else s.md.col_min_content) + 2 * s.md.cell_pad;
    minimums[c] = ifx naturals[c] < s.md.col_min then naturals[c] else s.md.col_min;
  }
  L.total = markdown_table_share(naturals[..], minimums[..], L.cols, w, L.w[..]);
  // edges on whole layout units, as GPUI rounds Taffy's layout
  acc: f32 = 0; L.x[0] = 0;
  for c: 0..<L.cols { acc += L.w[c]; L.x[c + 1] = round_layout(acc); }
  return L;
}

// A table wider than its column keeps each column's minimum and is cut at the column's right edge.
markdown_table :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, doc: [] MdDoc, b: int, x: f32, y: f32, w: f32) -> f32 {
  return markdown_table_veiled(sh, m, s, doc, b, x, y, w, MdVeil.{});
}
markdown_table_veiled :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, doc: [] MdDoc, b: int, x: f32, y: f32, w: f32, vv: MdVeil) -> f32 {
  L := markdown_table_measure(m, s, doc, b, w);
  if L.cols == 0 || L.rows == 0 { return 0; }
  i0 := doc[0].blocks[b].item0;
  faces := uiskin_faces(s);
  pad := s.md.cell_pad; pad_y := s.md.cell_pad_y; lh := s.md.line;
  wider := L.total > w + 0.5;
  if wider { sheet_clip_right(sh, x + w); }
  h: f32 = 0;
  lines: [64] TextLine;
  for r: 0..<L.rows {
    if r > 0 { sheet_rule(sh, x, y + h, L.total, s.md.divider, s.hairline); h += s.md.divider; }
    // the row's height: its tallest cell
    tall := 1;
    for c: 0..<L.cols {
      k := i0 + r * L.cols + c;
      iw := L.x[c + 1] - L.x[c] - 2 * pad;
      n := text_wrap(m, faces, md_item_text(doc, k), md_item_runs(doc, k), iw, lines[..]);
      if n > tall { tall = n; }
    }
    for c: 0..<L.cols {
      k := i0 + r * L.cols + c;
      text := md_item_text(doc, k); runs := md_item_runs(doc, k);
      cx := x + L.x[c] + pad;
      iw := L.x[c + 1] - L.x[c] - 2 * pad;
      n := text_wrap(m, faces, text, runs, iw, lines[..]);
      if text.count == 0 { continue; }
      for q: 0..<n {
        lx := cx;
        al := doc[0].items[k].number;
        if al != MA_LEFT {
          end := lines[q].to;
          // a wrapped line's trailing space doesn't count toward its alignment
          if end > lines[q].from && text[end - 1] == ' ' { end -= 1; }
          lw := text_run_width(m, faces, text, runs, lines[q].from, end);
          lx = ifx al == MA_CENTER then cx + (iw - lw) / 2 else cx + iw - lw;
        }
        markdown_line_veiled(sh, m, s, faces, text, runs, lines[q].from, lines[q].to, lx, y + h + pad_y + cast(f32) q * lh, lh, s.ink, q + 1 == n, doc[0].items[k].at, vv);
      }
    }
    h += cast(f32) tall * lh + 2 * pad_y;
  }
  if wider { sheet_unclip(sh); }
  return h;
}

// ---------------------------------------------------------------- blocks

// A number and a dot, kept in the sheet's pool.
markdown_ordinal :: (sh: [] Sheet, number: int) -> string {
  nb: [24] u8;
  nn := text_put_int(nb[..], 0, number);
  nb[nn] = '.'; nn += 1;
  return sheet_pool(sh, cast(string) nb[0..<nn]);
}

// Lays out and paints block b of doc at (x, y), width w. Returns its height.
markdown_block :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, doc: [] MdDoc, b: int, x: f32, y: f32, w: f32) -> f32 {
  return markdown_block_veiled(sh, m, s, doc, b, x, y, w, MdVeil.{});
}
markdown_block_veiled :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, doc: [] MdDoc, b: int, x: f32, y: f32, w: f32, vv: MdVeil) -> f32 {
  kind := doc[0].blocks[b].kind;
  lh := s.md.line;
  if kind == MB_CODE { return markdown_code_veiled(sh, m, s, doc, b, x, y, w, vv); }
  if kind == MB_TABLE { return markdown_table_veiled(sh, m, s, doc, b, x, y, w, vv); }
  if kind == MB_PARA { return markdown_text_veiled(sh, m, s, md_block_text(doc, b), md_block_runs(doc, b), x, y, w, lh, s.ink, doc[0].blocks[b].at, vv); }
  i0 := doc[0].blocks[b].item0;
  if kind == MB_QUOTE {
    // measure first, so the wash and rail go under the text
    iw: f32 = w - s.md.quote_pad_l - s.md.quote_pad_r;
    th_: f32 = 2 * s.md.quote_pad_y;
    lines: [64] TextLine;
    faces := uiskin_faces(s);
    for k: 0..<doc[0].blocks[b].items {
      if k > 0 { th_ += s.md.quote_gap; }
      th_ += cast(f32) text_wrap(m, faces, md_item_text(doc, i0 + k), md_item_runs(doc, i0 + k), iw, lines[..]) * lh;
    }
    sheet_fill(sh, x, y, w, th_, 0, s.quote_wash);
    sheet_rule(sh, x, y, s.md.quote_rail, th_, s.quote_rail);
    h: f32 = s.md.quote_pad_y;
    for k: 0..<doc[0].blocks[b].items {
      if k > 0 { h += s.md.quote_gap; }
      h += markdown_text_veiled(sh, m, s, md_item_text(doc, i0 + k), md_item_runs(doc, i0 + k), x + s.md.quote_pad_l, y + h, iw, lh, s.muted, doc[0].items[i0 + k].at, vv);
    }
    return th_;
  }
  h: f32 = 0;
  col: f32 = s.md.marker_w + s.md.marker_gap;
  for k: 0..<doc[0].blocks[b].items {
    if k > 0 { h += s.md.item_gap; }
    ix := i0 + k;
    ix_x := x + cast(f32) doc[0].items[ix].depth * col;
    if doc[0].items[ix].ordered {
      q := sheet_text(sh, m, -1, ix_x, y + h, lh, s.body.face, s.accent, markdown_ordinal(sh, doc[0].items[ix].number));
    } else if doc[0].items[ix].task != MD_TASK_NONE && s.md.disc > 0 {
      // a task's box, drawn: an outline when it is open; filled, with the skin's check, when it is done
      done := doc[0].items[ix].task == MD_TASK_DONE;
      side := s.md.task;
      by := y + h + (lh - side) / 2;
      tb := sheet_box(sh, ix_x, by, side, side, s.md.task_radius, s.border, ifx done then s.accent else opacity(s.accent, 0), ifx done then s.accent else s.muted);
      if done && s.icon_check >= 0 { sheet_icon(sh, s.icon_check, ix_x, by, side, s.on_accent); }
    } else if doc[0].items[ix].task != MD_TASK_NONE {
      q := sheet_text(sh, m, -1, ix_x, y + h, lh, s.body.face, s.accent, ifx doc[0].items[ix].task == MD_TASK_DONE then s.md.task_done else s.md.task_open);
    } else if s.md.disc > 0 {
      sheet_fill(sh, ix_x + 1, y + h + (lh - s.md.disc) / 2, s.md.disc, s.md.disc, s.md.disc / 2, s.accent);
    } else {
      q := sheet_text(sh, m, -1, ix_x, y + h, lh, s.body.face, s.accent, s.md.bullet);
    }
    h += markdown_text_veiled(sh, m, s, md_item_text(doc, ix), md_item_runs(doc, ix), ix_x + col, y + h, x + w - ix_x - col, lh, s.ink, doc[0].items[ix].at, vv);
  }
  return h;
}

// The height block b takes at width w, painting nothing a caller keeps:
// it lays out onto the sheet and takes it back.
markdown_height :: (sh: [] Sheet, m: TextMeasure, s: UiSkin, doc: [] MdDoc, b: int, w: f32) -> f32 {
  nu := sh[0].nu; no := sh[0].no; nl := sh[0].nl; nh := sh[0].nh; np := sh[0].np;
  h := markdown_block(sh, m, s, doc, b, 0, 0, w);
  sh[0].nu = nu; sh[0].no = no; sh[0].nl = nl; sh[0].nh = nh; sh[0].np = np;
  return h;
}

#test "inline code broken across lines keeps each wash inside the width, with no trailing space washed" {
  a: [1] Atlas; text_test_atlas(a[..]); m := measure_font(a[..]);   // every glyph 8 wide
  s: UiSkin; s.body.face = 0; s.strong.face = 3; s.code.face = 4; s.md.code_pad_x = 4;
  under: [32] Prim; over: [8] Prim; lines: [8] SheetLine; hits: [1] SheetHit; pool: [1] u8;
  sh := [1] Sheet.[Sheet.{under = under[..], over = over[..], lines = lines[..], hits = hits[..], pool = pool[..]}];
  t := "aa bb cc dd";                                                // "aa `bb cc` dd"
  runs := [1] MdRun.[MdRun.{from = 3, to = 8, style = MD_CODE}];
  h := markdown_text(sh[..], m, s, t, runs[..], 0, 0, 50, 20, Rgba.{});
  #assert h == 40;                                                   // "aa bb " then "cc dd"
  boxes := 0;
  for k: 0..<sh[0].nu {
    if sh[0].under[k].kind == PRIM_BOX {
      boxes += 1;
      #assert sh[0].under[k].x + sh[0].under[k].w <= 50;
    }
  }
  #assert boxes == 2 && sh[0].under[0].w == 24;                        // "bb" (16) and its pads, not "bb " (24 + 8 past the width)
}

#test "inline code pads advance the pen so the wash never overlaps adjacent spaces or words" {
  a: [1] Atlas; text_test_atlas(a[..]); m := measure_font(a[..]);   // every glyph 8 wide
  s: UiSkin; s.body.face = 0; s.strong.face = 3; s.code.face = 4; s.md.code_pad_x = 4;
  under: [32] Prim; over: [8] Prim; lines: [8] SheetLine; hits: [1] SheetHit; pool: [1] u8;
  sh := [1] Sheet.[Sheet.{under = under[..], over = over[..], lines = lines[..], hits = hits[..], pool = pool[..]}];
  t := "the foo bar";                                                // "the `foo` bar"
  runs := [1] MdRun.[MdRun.{from = 4, to = 7, style = MD_CODE}];
  h := markdown_text(sh[..], m, s, t, runs[..], 0, 0, 200, 20, Rgba.{});
  #assert h == 20 && sh[0].nu == 1 && sh[0].no == 3;
  // "the " is 0..32; wash is 32..64 (pad 4 + 24 + pad 4); "foo" is at 36; " bar" starts at 64
  #assert sh[0].over[0].x == 0 && sh[0].over[0].w == 32;
  #assert sh[0].under[0].x == 32 && sh[0].under[0].w == 32;
  #assert sh[0].over[1].x == 36 && sh[0].over[1].w == 24;
  #assert sh[0].over[2].x == 64 && sh[0].over[2].w == 32;
}
