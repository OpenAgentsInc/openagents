// T3 Code f313d0a6cb, ThreadComposer.tsx / ComposerToolbar.tsx (MIT).
// Shared native layout. UIKit supplies measured text and executes these frames.
#test "composer keeps the editor above its action row and caps long drafts" {
  a:=nc_layout(378,23,1,false);#assert a.height==94 && a.editor_x==14 && a.editor_w==350 && a.toolbar_y==46 && !a.expanded;
  b:=nc_layout(378,46,1,true);#assert b.height==116 && b.editor_h==58 && b.toolbar_y==68 && b.expanded;
  c:=nc_layout(378,400,1,true);#assert c.editor_h==104 && c.height==162 && c.toolbar_y==114;
  d:=nc_layout(320,46,2,true);#assert d.send_x==272 && d.editor_w==292 && d.height>=104;
}
NativeComposerLayout :: struct {height:f64;radius:f64;editor_x:f64;editor_y:f64;editor_w:f64;editor_h:f64;toolbar_y:f64;send_x:f64;send_size:f64;expanded:bool;}
nc_layout :: (width:f64,text_height:f64,scale:f64,has_text:bool)->NativeComposerLayout #export_c #effects(all) {
  s:=ifx scale>1 then scale else 1.0;line:=23*s;expanded:=has_text && text_height>line*1.5;
  h:=text_height+12;if h<36*s {h=36*s;}if h>line*4+12 {h=line*4+12;}
  return NativeComposerLayout.{height=h+58,radius=22,editor_x=14,editor_y=6,editor_w=width-28,editor_h=h,toolbar_y=h+10,send_x=width-48,send_size=44,expanded=expanded};
}
