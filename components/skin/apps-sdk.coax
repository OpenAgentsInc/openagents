  n = as_put(out, n, ".as-date-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.as-date-in{height:var(--control-lg);padding:0 10px;border:0;border-radius:var(--radius-md);background:var(--color-surface);box-shadow:inset 0 0 0 1px var(--color-border-strong);color:var(--color-text);font:400 13px/1 var(--font-mono);color-scheme:dark}");
  n = as_put(out, n, ".as-cal{margin-top:8px;padding:12px;border-radius:var(--radius-xl);background:var(--color-surface-secondary);border:1px solid var(--color-border);display:flex;flex-direction:column;gap:8px;max-width:280px}");
  n = as_put(out, n, ".as-cal-hd{display:flex;align-items:center;justify-content:space-between;font:600 13px/1.2 var(--font-sans);color:var(--color-text)}");
  n = as_put(out, n, ".as-cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;text-align:center}");
  n = as_put(out, n, ".as-cal-dow{font:500 11px/24px var(--font-sans);color:var(--color-text-tertiary)}");
  n = as_put(out, n, ".as-cal-day{appearance:none;border:0;background:transparent;height:28px;border-radius:var(--radius-sm);color:var(--color-text-secondary);font:400 12px/1 var(--font-mono);cursor:pointer}");
  n = as_put(out, n, ".as-cal-day:hover{background:var(--alpha-10);color:var(--color-text)}.as-cal-day[aria-selected=true]{background:#ffffff;color:#0d0d0d;font-weight:600}");
  n = as_put(out, n, ".as-cal-day[data-state=range]{background:var(--blue-a50);color:var(--blue-200)}");

  // ---- Overlays: Popover, Menu, Tooltip, Dialog
  n = as_put(out, n, ".as-ov-anchor{position:relative;display:inline-flex}");
  n = as_put(out, n, ".as-popover{position:absolute;left:0;top:calc(100% + 8px);z-index:50;min-width:240px;padding:14px;border-radius:var(--radius-xl);background:var(--color-surface-elevated);box-shadow:var(--shadow-elev);display:flex;flex-direction:column;gap:10px}");
  n = as_put(out, n, ".as-menu{position:absolute;left:0;top:calc(100% + 6px);z-index:50;min-width:210px;padding:5px;border-radius:var(--radius-xl);background:var(--color-surface-elevated);box-shadow:var(--shadow-elev);display:flex;flex-direction:column;gap:2px}");
  n = as_put(out, n, ".as-menu-item{appearance:none;border:0;background:transparent;width:100%;padding:8px 10px;border-radius:var(--radius-md);color:var(--color-text);display:flex;align-items:center;justify-content:space-between;gap:10px;font:400 13px/1.2 var(--font-sans);cursor:pointer;text-align:left}");
  n = as_put(out, n, ".as-menu-item:hover{background:var(--alpha-10)}.as-menu-item.as-c-danger{color:var(--red-300)}.as-menu-item.as-c-danger:hover{background:var(--red-a50)}");
  n = as_put(out, n, ".as-menu-l{display:inline-flex;align-items:center;gap:8px}.as-menu-sep{height:1px;background:var(--color-border-subtle);margin:4px 6px}");
  n = as_put(out, n, ".as-tip-wrap{position:relative;display:inline-flex}");
  n = as_put(out, n, ".as-tip{position:absolute;left:50%;bottom:calc(100% + 8px);transform:translateX(-50%);padding:6px 10px;border-radius:var(--radius-md);background:var(--gray-250);box-shadow:var(--shadow-elev);color:var(--color-text);font:500 12px/1.3 var(--font-sans);white-space:nowrap;opacity:0;pointer-events:none;transition:opacity 140ms ease;z-index:60}");
  n = as_put(out, n, ".as-tip-wrap:hover .as-tip,.as-tip-wrap:focus-within .as-tip,.as-tip[data-state=open]{opacity:1}");
  n = as_put(out, n, ".as-dialog{padding:0;border:0;border-radius:var(--radius-2xl);background:var(--color-surface-elevated);color:var(--color-text);box-shadow:0 24px 64px rgba(0,0,0,.75),0 0 0 1px var(--color-border-strong);max-width:460px;width:calc(100% - 32px)}");
  n = as_put(out, n, ".as-dialog::backdrop{background:rgba(0,0,0,.68);backdrop-filter:blur(4px)}");
  n = as_put(out, n, ".as-dialog-hd{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 20px 12px;border-bottom:1px solid var(--color-border-subtle)}");
  n = as_put(out, n, ".as-dialog-bd{padding:16px 20px;display:flex;flex-direction:column;gap:12px;color:var(--color-text-secondary);font:400 14px/1.5 var(--font-sans)}");
  n = as_put(out, n, ".as-dialog-ft{display:flex;align-items:center;justify-content:flex-end;gap:8px;padding:12px 20px 18px;border-top:1px solid var(--color-border-subtle)}");

  // ---- Content: Tabs, Table, Prose, Source, LinkCard, Step/Activity
  n = as_put(out, n, ".as-tabs{display:flex;align-items:center;gap:4px;border-bottom:1px solid var(--color-border);width:100%}");
  n = as_put(out, n, ".as-tab{appearance:none;border:0;background:transparent;padding:9px 14px;color:var(--color-text-tertiary);font:500 13px/1 var(--font-sans);cursor:pointer;position:relative;display:inline-flex;align-items:center;gap:6px;transition:color var(--as-dur) ease}");
  n = as_put(out, n, ".as-tab:hover{color:var(--color-text)}.as-tab[aria-selected=true]{color:var(--color-text)}");
  n = as_put(out, n, ".as-tab[aria-selected=true]::after{content:'';position:absolute;left:8px;right:8px;bottom:-1px;height:2px;background:#ffffff;border-radius:2px}");
  n = as_put(out, n, ".as-tbl-wrap{width:100%;overflow-x:auto;border-radius:var(--radius-xl);border:1px solid var(--color-border);background:var(--color-surface-secondary)}");
  n = as_put(out, n, ".as-tbl{width:100%;border-collapse:collapse;font:400 13px/1.45 var(--font-sans);text-align:left}");
  n = as_put(out, n, ".as-tbl th{padding:10px 14px;font:600 12px/1.2 var(--font-sans);color:var(--color-text-tertiary);border-bottom:1px solid var(--color-border);background:var(--alpha-04)}");
  n = as_put(out, n, ".as-tbl td{padding:10px 14px;color:var(--color-text);border-bottom:1px solid var(--color-border-subtle)}.as-tbl tr:last-child td{border-bottom:0}");
  n = as_put(out, n, ".as-prose{display:flex;flex-direction:column;gap:10px;font:400 14px/1.6 var(--font-sans);color:var(--color-text-secondary)}");
  n = as_put(out, n, ".as-prose h4{margin:0;font:600 15px/1.35 var(--font-sans);color:var(--color-text)}.as-prose p{margin:0}.as-prose code{padding:2px 6px;border-radius:5px;background:var(--alpha-10);color:var(--color-text);font:400 12.5px/1 var(--font-mono)}");
  n = as_put(out, n, ".as-prose blockquote{margin:0;padding:8px 14px;border-left:2px solid var(--blue-400);background:var(--alpha-04);border-radius:0 var(--radius-md) var(--radius-md) 0;color:var(--color-text)}");
  n = as_put(out, n, ".as-source{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:var(--radius-full);background:var(--alpha-08);border:1px solid var(--color-border-subtle);color:var(--color-text-secondary);font:500 12px/1 var(--font-sans);text-decoration:none;transition:background-color var(--as-dur) ease,color var(--as-dur) ease}");
  n = as_put(out, n, ".as-source:hover{background:var(--alpha-15);color:var(--color-text)}");
  n = as_put(out, n, ".as-link-card{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-radius:var(--radius-xl);background:var(--color-surface-secondary);border:1px solid var(--color-border);text-decoration:none;color:var(--color-text);transition:border-color var(--as-dur) ease,background-color var(--as-dur) ease}");
  n = as_put(out, n, ".as-link-card:hover{background:var(--color-surface-elevated);border-color:var(--color-border-strong)}");
  n = as_put(out, n, ".as-step{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border-radius:var(--radius-lg);background:var(--color-surface-secondary);border:1px solid var(--color-border-subtle)}");
  n = as_put(out, n, ".as-step-l{display:flex;align-items:center;gap:10px;min-width:0}.as-step-t{font:500 13px/1.3 var(--font-sans);color:var(--color-text)}.as-step-m{font:400 12px/1.3 var(--font-mono);color:var(--color-text-tertiary)}");

  // ---- Shell: Sidebar, Composer, Message bubbles, SuggestionChips, ScrollToBottom
  n = as_put(out, n, ".as-shell-demo{display:grid;grid-template-columns:230px minmax(0,1fr);border-radius:var(--radius-2xl);border:1px solid var(--color-border);background:var(--color-surface);overflow:hidden}");
  n = as_put(out, n, "@media(max-width:760px){.as-shell-demo{grid-template-columns:1fr}}");
  n = as_put(out, n, ".as-sidebar{background:var(--color-surface-secondary);border-right:1px solid var(--color-border-subtle);padding:14px 10px;display:flex;flex-direction:column;gap:4px}");
  n = as_put(out, n, ".as-sb-lbl{padding:8px 10px 4px;font:600 11px/1 var(--font-sans);letter-spacing:.04em;text-transform:uppercase;color:var(--color-text-tertiary)}");
  n = as_put(out, n, ".as-sb-item{appearance:none;border:0;background:transparent;width:100%;padding:8px 10px;border-radius:var(--radius-md);color:var(--color-text-secondary);display:flex;align-items:center;justify-content:space-between;gap:8px;font:500 13px/1.2 var(--font-sans);cursor:pointer;text-align:left;text-decoration:none}");
  n = as_put(out, n, ".as-sb-item:hover{background:var(--alpha-06);color:var(--color-text)}.as-sb-item[aria-current=page]{background:var(--alpha-10);color:var(--color-text)}");
  n = as_put(out, n, ".as-shell-main{padding:18px 20px;display:flex;flex-direction:column;gap:14px;min-width:0}");
  n = as_put(out, n, ".as-msg-u{align-self:flex-end;max-width:80%;padding:10px 14px;border-radius:18px;background:var(--gray-200);color:var(--color-text);font:400 14px/1.45 var(--font-sans)}");
  n = as_put(out, n, ".as-msg-a{display:flex;flex-direction:column;gap:8px;color:var(--color-text);font:400 14px/1.55 var(--font-sans)}");
  n = as_put(out, n, ".as-chips{display:flex;flex-wrap:wrap;gap:8px}");
  n = as_put(out, n, ".as-chip{appearance:none;border:1px solid var(--color-border);background:var(--color-surface-secondary);color:var(--color-text-secondary);height:32px;padding:0 12px;border-radius:var(--radius-full);display:inline-flex;align-items:center;gap:6px;font:500 13px/1 var(--font-sans);cursor:pointer;transition:background-color var(--as-dur) ease,color var(--as-dur) ease,border-color var(--as-dur) ease}");
  n = as_put(out, n, ".as-chip:hover{background:var(--color-surface-elevated);border-color:var(--color-border-strong);color:var(--color-text)}");
  n = as_put(out, n, ".as-composer{border-radius:var(--radius-3xl);background:var(--color-surface-elevated);border:1px solid var(--color-border-strong);padding:12px 14px;display:flex;flex-direction:column;gap:10px}");
  n = as_put(out, n, ".as-composer textarea{width:100%;border:0;outline:0;background:transparent;color:var(--color-text);font:400 14px/1.45 var(--font-sans);resize:none;min-height:42px}");
  n = as_put(out, n, ".as-composer-ft{display:flex;align-items:center;justify-content:space-between;gap:8px}");

  n = as_put(out, n, ".as-legacy-wrap{max-width:960px;margin:0 auto;padding:36px 24px 96px;border-top:1px solid var(--color-border);display:flex;flex-direction:column;gap:40px}");
  return n;
}

#test "apps_sdk_css writes dark-mode tokens and component rules without overflowing buffer" {
  buf: [65536] u8;
  n := apps_sdk_css(buf[..], 0);
  #assert n > 12000 && n < 56000;
  css := cast(string) buf[0..<n];
  found_dark := false; found_btn := false; found_seg := false; found_dlg := false; found_comp := false;
  for i: 0..<css.count - 16 {
    if css[i..<i + 17] == "color-scheme:dark" { found_dark = true; }
    if css[i..<i + 7] == ".as-btn" { found_btn = true; }
    if css[i..<i + 7] == ".as-seg" { found_seg = true; }
    if css[i..<i + 10] == ".as-dialog" { found_dlg = true; }
    if css[i..<i + 12] == ".as-composer" { found_comp = true; }
  }
  #assert found_dark && found_btn && found_seg && found_dlg && found_comp;
}
