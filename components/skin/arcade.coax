// Arcade's component geometry/motion with the shared monochrome palette.
// Source inventory: docs/arcade/03-design-and-components.md and audit 06.
#load "mono.coax";
#load "zeron.coax";
ArcadeMotionSkin :: struct {enter:f32=0.2;press:f32=0.1;focus:f32=0.2;menu:f32=0.3;}
arcade_color :: (c:u32)->Rgba {return rgba(cast(f32)((c>>24)&255)/255,cast(f32)((c>>16)&255)/255,cast(f32)((c>>8)&255)/255,cast(f32)(c&255)/255);}
arcade_skin :: ()->UiSkin {
 s:=zeron_skin();s.name="Arcade";s.canvas=arcade_color(MONO_GROUND);s.surface=arcade_color(MONO_SURFACE);
 s.raised=arcade_color(MONO_RAISED);s.sunk=s.canvas;s.hairline=arcade_color(MONO_LINE);s.hover=arcade_color(MONO_PRESSED);
 s.ink=arcade_color(MONO_INK);s.muted=arcade_color(MONO_INK_MUTED);s.faint=arcade_color(MONO_INK_FAINT);
 s.accent=arcade_color(MONO_INK_BRIGHT);s.on_accent=s.canvas;s.selection=arcade_color(MONO_RAISED);
 s.animated.frame_stroke=1.5;s.animated.frame_square_limit=12;s.animated.frame_wash=1;return s;
}
#test "Arcade component accents and surfaces are the shared grayscale roles" {
 s:=arcade_skin();#assert s.accent.r==1 && s.accent.g==1 && s.accent.b==1;
 #assert s.surface.r==s.surface.g && s.surface.g==s.surface.b && s.ink.r==s.ink.g;
 #assert ArcadeMotionSkin.{}.enter==0.2 && ArcadeMotionSkin.{}.press==0.1;
}
// Arcade on a phone: the production grayscale with touch-sized controls, as
// mono-native's reference button and field are (44 points tall, 18 and 12 of
// padding). The first consumer is the native login (apps/shared/login/, #13645).
// What dims a screen behind a card laid over it: the ground, mostly opaque (mono-native's drawer shade).
arcade_scrim :: ()->Rgba {return arcade_color((MONO_GROUND&0xffffff00)|0x99);}
// Points per layout unit on a phone: the kit's 14-unit text is read at 16.8 points. A screen
// lays out in units, draws at the screen's scale times this, and gives its host points.
ARCADE_PHONE_SCALE :: 1.2;
arcade_phone_skin :: ()->UiSkin {
 s:=arcade_skin();s.name="Arcade phone";
 // the touch composer (kit/composer.coax): a 30-point action, a 34-point chip, 10 points from the edge
 s.cmp.line=23/ARCADE_PHONE_SCALE;s.cmp.text_inset=6/ARCADE_PHONE_SCALE;s.cmp.send=25;s.cmp.stop=10;s.cmp.stop_radius=2.5;s.cmp.chip_h=28;s.cmp.chip_pad=10;s.cmp.chip_radius=14;s.cmp.action_inset=8;s.cmp.chip_icon=13;s.cmp.chip_gap=5;
 s.label=s.body;s.control_h=44;s.control_pad=18;s.radius_control=22;s.pad=20;s.space=12;
 s.chrome.field_h=44;s.chrome.field_pad=18;s.chrome.field_radius=22;s.chrome.field_focus=1;
 s.field_edge=arcade_color(MONO_LINE);s.raised=arcade_color(MONO_RAISED);
 return s;
}
#test "the phone skin keeps Arcade's greys and gives every control a 44 point target" {
 s:=arcade_phone_skin();a:=arcade_skin();
 #assert s.control_h==44 && s.chrome.field_h==44 && s.radius_control==22 && s.chrome.field_radius==22;
 #assert s.ink.r==a.ink.r && s.accent.r==1 && s.surface.r==s.surface.g && s.field_edge.r==s.field_edge.b;
 #assert s.label.face==s.body.face && s.animated.frame_square_limit==12;
}
