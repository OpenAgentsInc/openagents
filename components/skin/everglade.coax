// The Everglade skin: dark iron and bronze frames, warm gold type and
// parchment tones, rounded corners with studs (docs/verse/hud-styles.md).
// Its colours are the FANTASY tokens of aethyr/ui/hud-style.coax
// (hud_tokens(HUD_FANTASY)), copied here so the component system does not
// load the engine; components/gallery/skin-parity.coax holds the two equal
// until the HUD draws from this file (components/spec.md Phase 5, GitHub
// #13153). The chat set wears it in Everglade for desktop (the Golemancers'
// Workshop).
//
// Its faces are the slots of the atlas it is drawn with. Until a host
// rasterizes Everglade's own typefaces for the components, those are
// Zeron's slots (Geist), so the measures of text are Zeron's too.
//   coax/bin/coax test components/skin/everglade.coax

#load "zeron.coax";

everglade_skin :: () -> UiSkin {
  s := zeron_skin();
  s.id = UISKIN_EVERGLADE; s.name = "everglade";
  trim := rgba(0.86, 0.68, 0.36, 1);            // gold trim, studs
  text := rgba(0.95, 0.89, 0.76, 1);
  dim := rgba(0.72, 0.64, 0.52, 1);
  s.canvas = rgba(0.040, 0.034, 0.028, 1);
  s.surface = rgba(0.075, 0.062, 0.050, 0.86);  // frame_dark: a panel's body
  s.raised = rgba(0.32, 0.24, 0.15, 0.35);      // the frame's metal, thin
  s.sunk = rgba(0.13, 0.05, 0.04, 0.55);
  s.hairline = rgba(0.32, 0.24, 0.15, 0.9);
  s.hover = opacity(trim, 0.14);
  s.ink = text; s.muted = dim; s.faint = opacity(dim, 0.75);
  s.accent = trim; s.on_accent = rgba(0.075, 0.062, 0.050, 1); s.selection = opacity(trim, 0.35);
  s.danger = rgba(0.92, 0.32, 0.22, 1); s.warning = rgba(1.0, 0.62, 0.26, 1); s.success = rgba(0.42, 0.80, 0.36, 1);
  s.code_wash = opacity(trim, 0.16); s.quote_wash = opacity(trim, 0.06); s.quote_rail = opacity(trim, 0.7);
  s.header_wash = rgba(0.62, 0.48, 0.30, 0.10);
  // comment, keyword, string, number, type, function, property, variable, punctuation, tag, attribute, invalid
  s.syntax[0] = dim; s.syntax[1] = trim; s.syntax[2] = s.success; s.syntax[3] = s.warning;
  s.syntax[4] = rgba(0.42, 0.62, 0.98, 1); s.syntax[5] = rgba(0.98, 0.84, 0.52, 1); s.syntax[6] = rgba(0.55, 0.95, 0.45, 1);
  s.syntax[7] = text; s.syntax[8] = dim; s.syntax[9] = s.danger; s.syntax[10] = rgba(0.42, 0.62, 0.98, 1); s.syntax[11] = s.danger;
  s.chip = opacity(trim, 0.10); s.well = rgba(0, 0, 0, 0.30); s.rail = rgba(0.32, 0.24, 0.15, 0.6);
  s.hunk_wash = opacity(trim, 0.08);
  s.add_wash = opacity(s.success, 0.07); s.add_bar = opacity(s.success, 0.6); s.del_wash = opacity(s.danger, 0.07); s.del_bar = opacity(s.danger, 0.6);
  s.danger_muted = rgba(0.96, 0.62, 0.52, 1); s.warning_muted = rgba(0.98, 0.84, 0.52, 1); s.file_tint = trim;
  s.spinner[0] = trim; s.spinner[1] = text; s.spinner[2] = rgba(0.62, 0.48, 0.30, 1);
  s.brand = rgba(0.85, 0.47, 0.34, 1); s.field_edge = rgba(0.32, 0.24, 0.15, 0.95); s.lift = rgba(0, 0, 0, 0.3); s.hover_chip = opacity(trim, 0.16);
  s.menu_hover = opacity(trim, 0.08); s.menu_selected = opacity(trim, 0.18); s.menu_ring = opacity(trim, 0.4);
  s.menu_rule = rgba(0.32, 0.24, 0.15, 0.8); s.menu_divider = rgba(0.32, 0.24, 0.15, 0.6); s.list_wash = rgba(0, 0, 0, 0.18);
  s.stop_on = opacity(text, 0.5);
  s.track = UiPlate.{top = rgba(0.13, 0.10, 0.07, 1), bottom = rgba(0.09, 0.07, 0.05, 1), rim = rgba(0.32, 0.24, 0.15, 1), inset = rgba(0, 0, 0, 0.3), inset_dy = 1, drop = rgba(0, 0, 0, 0.3), drop_dy = 1, drop_blur = 2};
  s.thumb = UiPlate.{top = rgba(0.98, 0.84, 0.52, 1), bottom = trim, rim = rgba(0.32, 0.24, 0.15, 1), inset = rgba(1, 0.95, 0.8, 0.6), inset_dy = 1, drop = rgba(0, 0, 0, 0.4), drop_dy = 1, drop_blur = 2};
  s.switch_shade = rgba(0, 0, 0, 0.2); s.switch_wash = opacity(dim, 0.25); s.switch_rim = opacity(trim, 0.5);
  s.switch_mark = text; s.switch_ring = text; s.switch_knob = text; s.switch_knob_rim = rgba(0.32, 0.24, 0.15, 0.5);
  s.radius = 6; s.radius_control = 4; s.border = 1.5;
  s.frame = UIFRAME_IRON;
  s.frame_mid = rgba(0.32, 0.24, 0.15, 1); s.frame_light = rgba(0.62, 0.48, 0.30, 1); s.trim = trim;
  s.shadow = 10; s.shade = rgba(0, 0, 0, 0.5); s.stud = 4;
  s.md.block_radius = 6; s.md.code_radius = 3;
  return s;
}

#test "the Everglade skin is warm and framed in iron; its measures of text are the atlas's" {
  s := everglade_skin(); z := zeron_skin();
  #assert s.id == UISKIN_EVERGLADE && s.name == "everglade" && s.frame == UIFRAME_IRON && s.stud > 0 && s.shadow > 0;
  // warm: more red than blue, everywhere it is read
  for c: [4] Rgba.[s.ink, s.muted, s.accent, s.trim] { #assert c.r > c.b + 0.15; }
  #assert s.body.face == z.body.face && s.md.line == z.md.line && s.md.block_radius < z.md.block_radius;
  #assert s.accent.r != z.accent.r && s.surface.a < 1;
}
