// Institute Noir — canonical default theme & zero-base stylesheet for OpenAgents
// (docs/web/2026-11-27-institute-noir-theme-spec.md).
//
// Visual reference: kitlangton/effect-institute (MIT License; see components/NOTICE).
// Typography: native system sans (-apple-system / SF Pro / Inter) for UI chrome and prose;
// Commit Mono Variable (SIL OFL 1.1; components/fonts/CommitMono-Variable.woff2) for code & tabular figures.
//
// Single stylesheet emitter for openagents.com (/chat, /login, /onboarding, /settings/*):
// replaces the 3-layer mono_css + apps_sdk_css + cwc_css stack with one cohesive sheet.
//   coax/bin/coax test components/skin/institute-noir.coax

IN_GROUND :: "#000000";
IN_HOVER :: "#080808";
IN_ACTIVE :: "#141414";
IN_TOOLTIP :: "#171717";
IN_BORDER :: "#222222";
IN_BORDER_ACTIVE :: "#333333";
IN_TEXT :: "#f1efe8";
IN_SUCCESS :: "#228c64";
IN_SUCCESS_MID :: "#2aaf7e";
IN_SUCCESS_BRIGHT :: "#34d399";
IN_RUNNING :: "#3b82f6";
IN_FAILED :: "#ef4444";
IN_WARN :: "#f97316";

// GitHub Dark 12-slot syntax palette (maps 1:1 to components/core/syntax.coax SYN_* roles).
INSTITUTE_SYNTAX :: [12] string.[
  "#6A737D", // 0 SYN_COMMENT
  "#F97583", // 1 SYN_KEYWORD
  "#9ECBFF", // 2 SYN_STRING
  "#79B8FF", // 3 SYN_NUMBER
  "#B392F0", // 4 SYN_TYPE
  "#B392F0", // 5 SYN_FUNCTION
  "#79B8FF", // 6 SYN_PROPERTY
  "#FFAB70", // 7 SYN_VARIABLE
  "#E1E4E8", // 8 SYN_PUNCTUATION
  "#85E89D", // 9 SYN_TAG
  "#B392F0", // 10 SYN_ATTRIBUTE
  "#EF4444", // 11 SYN_INVALID
];

in_put :: (out: [] u8, at: int, s: string) -> int {
  n := at;
  for c: s { if n < out.count { out[n] = c; n += 1; } }
  return n;
}

// Emits the complete sharp-geometry monochrome web stylesheet into `out` starting at `at`.
institute_noir_css :: (out: [] u8, at: int) -> int {
  n := at;

  // ---- Font face & exact design tokens
  n = in_put(out, n, "@font-face{font-family:'Commit Mono';src:url('/fonts/CommitMono-Variable.woff2') format('woff2');font-weight:200 700;font-style:normal;font-display:swap}");
  n = in_put(out, n, ":root{color-scheme:dark;--in-ground:#000000;--bg-hover:#080808;--bg-active:#141414;--in-tooltip-bg:#171717;--in-banner-wash:rgba(255,255,255,.02);--border-subtle:#222222;--border-inactive:#222222;--border-active:#333333;--color-text:#f1efe8;--color-accent:rgba(255,255,255,.10);--color-accent-foreground:#f1efe8;--color-muted-foreground:rgba(255,255,255,.45);--color-destructive:#ef4444;--in-focus-ring:rgba(255,255,255,.35);--color-success:#228c64;--color-success-mid:#2aaf7e;--color-success-bright:#34d399;--in-running:#3b82f6;--in-failed:#ef4444;--in-warn:#f97316;--white-90:rgba(255,255,255,.90);--white-80:rgba(255,255,255,.80);--white-70:rgba(255,255,255,.70);--white-60:rgba(255,255,255,.60);--white-50:rgba(255,255,255,.50);--white-45:rgba(255,255,255,.45);--white-40:rgba(255,255,255,.40);--white-30:rgba(255,255,255,.30);--white-20:rgba(255,255,255,.20);--white-15:rgba(255,255,255,.15);--white-12:rgba(255,255,255,.12);--white-08:rgba(255,255,255,.08);--white-06:rgba(255,255,255,.06);--white-04:rgba(255,255,255,.04);--font-sans:-apple-system,BlinkMacSystemFont,'SF Pro Display','SF Pro Text','Inter',system-ui,'Segoe UI',Roboto,sans-serif;--font-mono:'Commit Mono',ui-monospace,'SFMono-Regular',Menlo,Consolas,monospace;--nav-h:48px;--dur-fast:140ms;--dur:200ms}");

  // ---- Global ground, typography, calm instrument pointer, focus rings & scrollbars
  n = in_put(out, n, "*,*::before,*::after{box-sizing:border-box;border-radius:0}");
  n = in_put(out, n, "html,body,#coaxial-root{margin:0;padding:0;background:#000000;color:#f1efe8;font-family:var(--font-sans);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility}");
  n = in_put(out, n, "html:has(.chat),body:has(.chat){height:100%;overflow:hidden;overscroll-behavior:none}body:has(.chat){position:fixed;inset:0}");
  n = in_put(out, n, "body::before{display:none}svg.fr{display:none}::selection{background:var(--white-20);color:#ffffff}");
  n = in_put(out, n, "button,a,[role=button]{cursor:default;font-family:inherit}input,textarea{cursor:text;font-family:inherit}");
  n = in_put(out, n, ":focus-visible{outline:2px solid var(--in-focus-ring);outline-offset:2px}");
  n = in_put(out, n, ".log:focus,.log:focus-visible,.vl-scroll:focus,.vl-scroll:focus-visible{outline:none !important;box-shadow:none !important}");
  n = in_put(out, n, "::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-track{background:var(--white-04)}::-webkit-scrollbar-thumb{background:rgba(64,64,64,.50)}::-webkit-scrollbar-thumb:hover{background:rgba(64,64,64,.70)}");
  n = in_put(out, n, ".sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}");
  n = in_put(out, n, ".ic{width:16px;height:16px;display:block;flex:none;color:currentColor}");

  // ---- Zero-Based Sidebar (260px, #000000, 1px #222222 hairlines, 48px head, flush Credits foot)
  n = in_put(out, n, ".side{position:fixed;left:0;top:0;bottom:0;z-index:4;width:260px;background:#000000;border-right:1px solid #222222;padding:0;gap:0;display:flex;flex-direction:column}");
  n = in_put(out, n, ".side-h{display:flex;align-items:stretch;height:48px;min-height:48px;border-bottom:1px solid #222222;padding:0;gap:0}");
  n = in_put(out, n, ".side-b{flex:1;min-width:0;display:flex;align-items:center;gap:10px;padding:0 14px;color:#f1efe8;text-decoration:none;font:600 14px/1 var(--font-sans);letter-spacing:-0.015em;transition:background-color var(--dur-fast) ease,color var(--dur-fast) ease}");
  n = in_put(out, n, ".side-b:hover{background:var(--white-06);color:#ffffff}.side-b>.ic{width:17px;height:17px;color:#f1efe8}.side-n{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}");
  n = in_put(out, n, ".side-h>.ib{width:48px;height:48px;flex:none;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:0;border-left:1px solid #222222;color:var(--white-60);padding:0;transition:background-color var(--dur-fast) ease,color var(--dur-fast) ease}");
  n = in_put(out, n, ".side-h>.ib:hover,.side-h>.ib:focus-visible{background:var(--white-06);color:#ffffff}");
  n = in_put(out, n, ".side-sp{flex:1;min-height:0;background:#000000}");
  n = in_put(out, n, ".side-f{padding:0;margin-top:0;border-top:1px solid #222222;display:flex;flex-direction:column;align-items:stretch;gap:0;background:#000000}");
  n = in_put(out, n, ".side-cred-card{display:flex;flex-direction:column;padding:0;background:#000000;border:0}");
  n = in_put(out, n, ".side-cred-body{display:flex;flex-direction:column;padding:14px 16px;gap:10px;background:var(--in-banner-wash)}");
  n = in_put(out, n, ".side-cred-top{display:flex;align-items:baseline;justify-content:space-between;gap:8px}");
  n = in_put(out, n, ".side-cred-lbl{font:600 11px/1 var(--font-sans);letter-spacing:.12em;text-transform:uppercase;color:var(--white-45)}");
  n = in_put(out, n, ".side-cred-val{font:600 16px/1 var(--font-mono);letter-spacing:-0.02em;color:#f1efe8;font-variant-numeric:tabular-nums}");
  n = in_put(out, n, ".side-cred-val[data-state='active']{color:#34d399}");
  n = in_put(out, n, ".side-cred-bar{height:2px;width:100%;background:var(--white-12);overflow:hidden}");
  n = in_put(out, n, ".side-cred-fill{height:100%;width:0%;background:#228c64;transition:width 240ms ease}");
  n = in_put(out, n, ".side-cred-fill[data-state='10']{width:10%}.side-cred-fill[data-state='20']{width:20%}.side-cred-fill[data-state='30']{width:30%}.side-cred-fill[data-state='40']{width:40%}.side-cred-fill[data-state='50']{width:50%}");
  n = in_put(out, n, ".side-cred-fill[data-state='60']{width:60%}.side-cred-fill[data-state='70']{width:70%}.side-cred-fill[data-state='80']{width:80%}.side-cred-fill[data-state='90']{width:90%}.side-cred-fill[data-state='100']{width:100%;background:#34d399}");
  n = in_put(out, n, ".side-cred-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;font:500 11px/1.2 var(--font-sans);letter-spacing:.08em;text-transform:uppercase;color:var(--white-45)}");
  n = in_put(out, n, ".side-cred-sub{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}");
  n = in_put(out, n, ".side-cred-btn{display:flex;align-items:center;justify-content:center;width:100%;height:40px;background:#000000;border:0;border-top:1px solid #222222;color:var(--white-70);font:600 11.5px/1 var(--font-sans);letter-spacing:.10em;text-transform:uppercase;text-decoration:none;transition:background-color var(--dur-fast) ease,color var(--dur-fast) ease}");
  n = in_put(out, n, ".side-cred-btn:hover,.side-cred-btn:focus-visible{background:#080808;color:#ffffff}");

  // ---- Generic icon buttons, reveal toggle, mobile top bar
  n = in_put(out, n, ".ib{appearance:none;width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:0;color:var(--white-60);padding:0;transition:background-color var(--dur-fast) ease,color var(--dur-fast) ease}");
  n = in_put(out, n, ".ib:hover,.ib:focus-visible{background:var(--white-06);color:#ffffff}");
  n = in_put(out, n, ".ib[data-state=side]{position:fixed;left:0;top:0;width:48px;height:48px;background:#000000;border-right:1px solid #222222;border-bottom:1px solid #222222;color:var(--white-60);z-index:6}");
  n = in_put(out, n, ".ib[data-state=side]:hover{background:var(--white-06);color:#ffffff}");
  n = in_put(out, n, ".ib[data-state=side]~.cc-hud{padding-left:64px}");
  n = in_put(out, n, ".mob-top{display:none}");

  // ---- Chat shell, 48px bordered header bar, transcript, welcome/login card, composer
  n = in_put(out, n, ".chat{position:relative;display:flex;flex-direction:column;height:100dvh;max-width:none;margin:0;padding:0;background:#000000}");
  n = in_put(out, n, ".chat:has(.side){margin-left:260px}");
  n = in_put(out, n, ".chat>:not(.side):not(.log):not(.cc-hud):not(.mob-top):not(.ib),.chat .log>*{width:calc(100% - 40px);max-width:740px;margin-left:auto;margin-right:auto}");
  n = in_put(out, n, ".chat>header.cc-hud,.chat:has(.side)>header.cc-hud{width:100% !important;max-width:none !important;margin:0 !important}");
  n = in_put(out, n, ".cc-hud{display:flex;align-items:stretch;justify-content:space-between;gap:0;height:48px;min-height:48px;padding:0 0 0 20px;border-bottom:1px solid #222222;background:#000000;position:relative;z-index:3;flex:none}");
  n = in_put(out, n, ".cc-hud-title{display:flex;align-items:center;font:600 13px/1 var(--font-sans);letter-spacing:-0.01em;color:#f1efe8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}");
  n = in_put(out, n, ".cc-hud-r{display:flex;align-items:stretch;gap:0;flex:none;min-width:0}");
  n = in_put(out, n, ".cc-pill{display:inline-flex;align-items:center;gap:8px;height:100%;padding:0 16px;border:0;border-left:1px solid #222222;background:#000000;color:var(--white-60);font:500 11.5px/1 var(--font-sans);letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}");
  n = in_put(out, n, "#cc\\.hud\\.tier::before{content:'';width:6px;height:6px;background:#228c64;flex:none}");
  n = in_put(out, n, "#cc\\.hud\\.tier.cc-pill-local::before{background:#34d399;box-shadow:0 0 6px rgba(52,211,153,.45)}");
  n = in_put(out, n, ".cc-pill-usage{color:var(--white-45);font-family:var(--font-mono);font-variant-numeric:tabular-nums}");
  n = in_put(out, n, ".cc-pill-local,.cc-pill-live{color:#34d399}");
  n = in_put(out, n, ".cc-recon{color:#f97316;border-left-color:rgba(249,115,22,.4)}");

  n = in_put(out, n, ".log,.log.vl-scroll{display:flex;flex-direction:column;overflow-y:auto;flex:1;min-height:0}.vl-pad{flex-shrink:0;pointer-events:none}");
  n = in_put(out, n, ".log .thread{display:flex;flex-direction:column;padding:28px 0 32px;gap:0;margin-bottom:auto}");
  n = in_put(out, n, ".log .thread:has(.cc-welcome){margin:auto;padding:24px 0}");
  n = in_put(out, n, ".cc-welcome{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:14px;padding:32px 24px;max-width:560px;margin:0 auto;border:1px solid #222222;background:var(--in-banner-wash)}");
  n = in_put(out, n, ".cc-welcome-ic{width:40px;height:40px;background:#000000;border:1px solid #222222;color:#f1efe8;display:flex;align-items:center;justify-content:center}");
  n = in_put(out, n, ".cc-welcome-svg{width:20px;height:20px;color:#f1efe8}");
  n = in_put(out, n, ".cc-welcome-t{margin:0;font:600 22px/1.25 var(--font-sans);letter-spacing:-0.025em;color:#f1efe8}");
  n = in_put(out, n, ".cc-welcome-s{margin:0;max-width:46ch;font:400 14px/1.55 var(--font-sans);color:var(--white-50)}");
  n = in_put(out, n, ".cc-welcome-chips,.as-chips{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:6px}");
  n = in_put(out, n, ".as-chip{appearance:none;display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 12px;background:#000000;border:1px solid #222222;color:var(--white-70);font:500 12.5px/1 var(--font-sans);transition:background-color var(--dur-fast) ease,border-color var(--dur-fast) ease,color var(--dur-fast) ease}");
  n = in_put(out, n, ".as-chip:hover{background:#080808;border-color:#333333;color:#f1efe8}.as-chip .as-ic{width:14px;height:14px;color:var(--white-50)}");

  n = in_put(out, n, ".cc-login{max-width:420px;width:100%;margin:auto;padding:28px 24px;border:1px solid #222222;background:#000000;display:flex;flex-direction:column;gap:14px}");
  n = in_put(out, n, ".cc-login .hd-t{margin:0;font:600 20px/1.25 var(--font-sans);letter-spacing:-0.02em;color:#f1efe8}");
  n = in_put(out, n, ".cc-login .lede{margin:0;font:400 14px/1.55 var(--font-sans);color:var(--white-50)}");
  n = in_put(out, n, ".cc-login .btn{align-self:flex-start;height:40px;padding:0 20px;background:#f1efe8;color:#000000;border:1px solid #f1efe8;font:600 13px/1 var(--font-sans);letter-spacing:.04em;text-transform:uppercase;text-decoration:none}");
  n = in_put(out, n, ".cc-login .btn:hover{background:#ffffff;border-color:#ffffff}");

  // ---- Transcript messages, Markdown, GitHub Dark code blocks, tool activity
  n = in_put(out, n, ".cc-row{display:flex;flex-direction:column;width:100%}");
  n = in_put(out, n, ".msg-user{align-self:stretch;padding:14px 16px;border-left:2px solid #333333;border-top:1px solid #222222;border-bottom:1px solid #222222;background:#080808;color:#f1efe8;font:400 15px/1.6 var(--font-sans)}");
  n = in_put(out, n, ".log .msg-user{margin-top:24px}.cc-row:first-child .msg-user{margin-top:0}");
  n = in_put(out, n, ".msg-ai{margin-top:14px;display:flex;flex-direction:column;gap:10px;color:#f1efe8}");
  n = in_put(out, n, ".md{display:flex;flex-direction:column;gap:14px;font:400 15px/1.65 var(--font-sans);color:#f1efe8;max-width:72ch}");
  n = in_put(out, n, ".md p{margin:0}.md h1,.md h2,.md h3,.md h4{margin:8px 0 0;font-family:var(--font-sans);font-weight:600;letter-spacing:-0.02em;color:#f1efe8}");
  n = in_put(out, n, ".md :not(pre)>code{padding:.15em .4em;background:var(--white-08);border:1px solid var(--white-15);color:#f1efe8;font-family:var(--font-mono);font-size:.88em}");
  n = in_put(out, n, ".md a{color:#f1efe8;text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--white-30)}.md a:hover{color:#ffffff;text-decoration-color:#ffffff}");
  n = in_put(out, n, ".md blockquote{margin:0;padding:8px 14px;border-left:2px solid #333333;background:var(--in-banner-wash);color:var(--white-60)}");
  n = in_put(out, n, ".md table{width:100%;border-collapse:collapse;font:400 13.5px/1.45 var(--font-sans);background:#000000;border:1px solid #222222}");
  n = in_put(out, n, ".md th{padding:10px 14px;font:600 11px/1.2 var(--font-sans);letter-spacing:.10em;text-transform:uppercase;color:var(--white-45);background:var(--in-banner-wash);border-bottom:1px solid #222222;text-align:left}");
  n = in_put(out, n, ".md td{padding:10px 14px;color:#f1efe8;border-bottom:1px solid #222222}");
  n = in_put(out, n, ".md-code-block,.code{border:1px solid #222222;background:#000000;overflow:hidden;margin:6px 0}");
  n = in_put(out, n, ".md-code-hdr,.code-h{display:flex;justify-content:space-between;align-items:center;height:34px;padding:0 0 0 12px;border-bottom:1px solid #222222;background:var(--in-banner-wash);font:500 11px/1 var(--font-mono);letter-spacing:.10em;text-transform:uppercase;color:var(--white-45)}");
  n = in_put(out, n, ".md-code-copy{appearance:none;background:#000000;border:0;border-left:1px solid #222222;color:var(--white-60);font:500 11px/1 var(--font-sans);letter-spacing:.08em;text-transform:uppercase;height:34px;padding:0 12px}");
  n = in_put(out, n, ".md-code-copy:hover{background:#080808;color:#ffffff}");
  n = in_put(out, n, ".md-pre,.code pre{margin:0;padding:12px 14px;overflow-x:auto;font:400 13px/1.55 var(--font-mono);color:#E1E4E8;text-rendering:geometricPrecision}");
  n = in_put(out, n, ".md-code-body{display:block;padding:0;background:transparent;border:0;font:inherit}.md-code-line{display:block;min-height:1.55em}");
  n = in_put(out, n, ".syn-com{color:#6A737D}.syn-kw{color:#F97583}.syn-str{color:#9ECBFF}.syn-num{color:#79B8FF}.syn-ty{color:#B392F0}.syn-fn{color:#B392F0}.syn-prop{color:#79B8FF}.syn-var{color:#FFAB70}.syn-pun{color:#E1E4E8}.syn-tag{color:#85E89D}.syn-attr{color:#B392F0}.syn-err{color:#EF4444}");

  n = in_put(out, n, ".acts{display:flex;align-items:center;gap:8px;margin-top:6px}.acts .meta{font:400 12px/1.3 var(--font-sans);color:var(--white-45)}");
  n = in_put(out, n, ".cc-act{margin-top:12px;display:flex;flex-direction:column;gap:0;border:1px solid #222222;background:#000000}");
  n = in_put(out, n, ".cc-act-hd{appearance:none;background:var(--in-banner-wash);border:0;padding:8px 12px;display:flex;align-items:center;gap:8px;width:100%;color:var(--white-60);font:600 11.5px/1.3 var(--font-sans);letter-spacing:.06em;text-transform:uppercase;text-align:left}");
  n = in_put(out, n, ".cc-act-hd:hover{background:#080808;color:#f1efe8}.cc-act-chev{width:12px;height:12px;color:var(--white-45);flex:none}");
  n = in_put(out, n, ".cc-act-list{display:flex;flex-direction:column;border-top:1px solid #222222;background:#000000}.cc-act-list[hidden],.cc-act-list[data-state=closed]{display:none}");
  n = in_put(out, n, ".cc-titem{display:flex;flex-direction:column;border-top:1px solid #222222}.cc-titem:first-child{border-top:0}.cc-titem-fail .cc-tlabel{color:#ef4444}");
  n = in_put(out, n, ".cc-trow{appearance:none;background:transparent;border:0;width:100%;display:flex;align-items:center;gap:8px;padding:7px 12px;color:var(--white-70);font:400 12.5px/1.35 var(--font-sans);text-align:left}");
  n = in_put(out, n, ".cc-trow:hover{background:#080808;color:#f1efe8}.cc-tlabel,.cc-tname{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}");
  n = in_put(out, n, ".cc-tdot{width:6px;height:6px;background:#228c64;flex:none}.cc-tdot-run{background:#3b82f6}.cc-tdot-fail{background:#ef4444}");
  n = in_put(out, n, ".cc-tchk{width:12px;height:12px;color:#34d399;flex:none}.cc-tstatus{flex:none;font:400 11.5px/1 var(--font-sans);color:var(--white-45)}.cc-tstatus-fail{color:#ef4444}.cc-tchev{width:11px;height:11px;color:var(--white-40);flex:none}");
  n = in_put(out, n, ".cc-think-body{font:400 13px/1.6 var(--font-sans);color:var(--white-50);white-space:pre-wrap;padding:8px 12px 10px 26px;border-top:1px solid #222222}");
  n = in_put(out, n, ".cc-think-body[hidden],.cc-think-body[data-state=closed],.cc-tool-body[hidden],.cc-tool-body[data-state=closed]{display:none}");
  n = in_put(out, n, ".cc-tool-body{display:flex;flex-direction:column;gap:6px;padding:8px 12px 10px 26px;border-top:1px solid #222222}");
