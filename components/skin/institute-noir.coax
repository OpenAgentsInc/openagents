  // ---- Auth / Login / Onboarding
  n = in_put(out, n, ".lw-page{position:fixed;inset:0;height:100dvh;width:100%;overflow:hidden;overscroll-behavior:none;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px 18px 64px;background:#000000}");
