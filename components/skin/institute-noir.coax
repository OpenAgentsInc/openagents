  n = in_put(out, n, ".lw-or{display:flex;align-items:center;gap:12px;margin:4px 0;color:var(--white-40);font:500 11px/1 var(--font-sans);letter-spacing:.16em;text-transform:uppercase}");
  n = in_put(out, n, ".lw-or::before,.lw-or::after{content:'';flex:1;height:1px;background:#222222}");
  n = in_put(out, n, ".as-in-wrap{display:flex;align-items:center;width:100%;height:44px;background:#000000;border:1px solid #222222;padding:0 12px;transition:border-color var(--dur-fast) ease}");
  n = in_put(out, n, ".as-in-wrap:hover{border-color:#333333}.as-in-wrap:focus-within{border-color:#333333;outline:2px solid var(--in-focus-ring);outline-offset:2px}");
  n = in_put(out, n, ".as-in-wrap input{width:100%;height:100%;border:0;outline:0;background:transparent;color:#f1efe8;font:400 14px/1.4 var(--font-sans)}");
  n = in_put(out, n, ".as-in-wrap input::placeholder{color:var(--white-40)}");
  n = in_put(out, n, ".lw-primary{width:100%;height:44px !important;background:#f1efe8 !important;border:1px solid #f1efe8 !important;color:#000000 !important;font:600 13.5px/1 var(--font-sans) !important;letter-spacing:.03em;justify-content:center;gap:10px}");
  n = in_put(out, n, ".lw-primary:hover:not(:disabled){background:#ffffff !important;border-color:#ffffff !important}");
  n = in_put(out, n, ".lw-primary:disabled{opacity:.45}");
  n = in_put(out, n, ".lw-primary .si-mark{width:17px;height:17px;color:#000000}");
  n = in_put(out, n, ".lw-note{margin:0;text-align:center;font:400 12.5px/1.5 var(--font-sans);color:var(--white-45)}");
  n = in_put(out, n, ".lw-aux{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:2px}");
  n = in_put(out, n, ".lw-in-card{display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--in-banner-wash);border:1px solid #222222}");
  n = in_put(out, n, ".as-av{width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;border:1px solid #333333;background:#141414;color:#f1efe8;font:600 12.5px/1 var(--font-sans);flex:none}");
  n = in_put(out, n, ".as-ctl-txt{display:flex;flex-direction:column;gap:3px;min-width:0}.as-ctl-lbl{font:500 13.5px/1.2 var(--font-sans);color:#f1efe8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.as-ctl-desc{font:400 12px/1.3 var(--font-sans);color:var(--white-50)}");
  n = in_put(out, n, ".as-al{display:flex;align-items:flex-start;gap:10px;padding:12px 14px;border:1px solid #222222;background:var(--in-banner-wash);font:400 13px/1.45 var(--font-sans);color:#f1efe8}");
  n = in_put(out, n, ".as-al.as-c-danger{border-color:rgba(239,68,68,.55);background:rgba(239,68,68,.08)}.as-al.as-c-success{border-color:rgba(52,211,153,.45);background:rgba(34,140,100,.10)}");
  n = in_put(out, n, ".as-al-t{font-weight:600;color:#f1efe8;margin-bottom:2px}.as-al-d{color:var(--white-60)}.as-al .as-ic{width:15px;height:15px;margin-top:1px;flex:none}");
  n = in_put(out, n, ".as-sp{width:14px;height:14px;border:2px solid var(--white-20);border-top-color:#f1efe8;border-radius:9999px;display:inline-block;animation:in-spin .7s linear infinite}");
  n = in_put(out, n, "@keyframes in-spin{to{transform:rotate(360deg)}}");
  n = in_put(out, n, ".lw-foot{position:fixed;bottom:0;left:0;right:0;min-height:48px;padding:15px 20px;border-top:1px solid #222222;background:#000000;font:400 12px/1.5 var(--font-sans);color:var(--white-45);text-align:center}");
  n = in_put(out, n, ".lw-foot a{color:var(--white-60);text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--white-20)}.lw-foot a:hover{color:#f1efe8}");

  // ---- Home Dashboard & Settings inside the shell
  n = in_put(out, n, ".home{min-height:100dvh;background:#000000}.side~.st{margin-left:260px}.st{display:flex;min-height:100dvh;background:#000000}");
  n = in_put(out, n, ".st-nav{width:220px;flex:none;background:#000000;border-right:1px solid #222222;padding:16px 0;display:flex;flex-direction:column}");
  n = in_put(out, n, ".st-nav .row{display:flex;align-items:center;padding:10px 16px;color:var(--white-60);font:500 13px/1.3 var(--font-sans);text-decoration:none;border-left:2px solid transparent}");
  n = in_put(out, n, ".st-nav .row:hover{background:#080808;color:#f1efe8}.st-nav .row[aria-current=true]{background:#141414;border-left-color:#f1efe8;color:#ffffff}");
  n = in_put(out, n, ".st-b{flex:1;min-width:0;max-width:760px;padding:28px 32px 96px;display:flex;flex-direction:column;gap:28px}");
  n = in_put(out, n, ".st-t{margin:0;font:600 22px/1.25 var(--font-sans);letter-spacing:-0.025em;color:#f1efe8}");
  n = in_put(out, n, ".st-g{display:flex;flex-direction:column;gap:10px}.st-g .sec-h{margin:0;font:600 11.5px/1.3 var(--font-sans);letter-spacing:.14em;text-transform:uppercase;color:var(--white-40)}");
  n = in_put(out, n, ".st-l,.card{background:#000000;border:1px solid #222222;overflow:hidden}");
  n = in_put(out, n, ".st-r{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 18px}.st-r+.st-r{border-top:1px solid #222222}");
  n = in_put(out, n, ".st-n{font:500 14px/1.4 var(--font-sans);color:#f1efe8}.st-a{font:400 13px/1.45 var(--font-sans);color:var(--white-50)}");
  n = in_put(out, n, ".st-v{font:500 13px/1.3 var(--font-mono);color:#f1efe8;padding:4px 10px;border:1px solid #222222;background:var(--in-banner-wash);font-variant-numeric:tabular-nums}");
  n = in_put(out, n, ".field{background:#000000;border:1px solid #222222;padding:8px 12px}.field:focus-within{border-color:#333333}.field input{width:100%;border:0;outline:0;background:transparent;font:400 14px/1.4 var(--font-sans);color:#f1efe8}");

  // ---- Responsive mobile & reduced-motion rules
  n = in_put(out, n, ".mob-top .ib{width:48px;height:48px;flex:none;border-right:1px solid #222222;color:var(--white-60);display:inline-flex;align-items:center;justify-content:center}");
  n = in_put(out, n, ".mob-top .ib:hover{background:var(--white-06);color:#ffffff}");
  n = in_put(out, n, ".mob-top a{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 16px;border-left:1px solid #222222;color:var(--white-70);text-decoration:none;font:600 12px/1 var(--font-sans);letter-spacing:.06em;text-transform:uppercase}");
  n = in_put(out, n, ".mob-top a:hover{background:var(--white-06);color:#ffffff}");
  n = in_put(out, n, "@media (max-width:760px){.mob-top{display:flex;align-items:stretch;justify-content:space-between;height:48px;min-height:48px;border-bottom:1px solid #222222;background:#000000;z-index:5;flex:none}.side{display:none}.side[data-state=open]{display:flex;width:100%;z-index:20}.chat:has(.side){margin-left:0}.side~.st{margin-left:0}.st{flex-direction:column}.st-nav{width:100%;border-right:0;border-bottom:1px solid #222222;flex-direction:row;overflow-x:auto;padding:0}.cc-pill-usage{display:none}}");
  n = in_put(out, n, "@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001ms !important;transition-duration:.001ms !important}}");
  return n;
}

in_test_has :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  if needle.count > hay.count { return false; }
  for i: 0..<hay.count - needle.count + 1 {
    ok := true;
    for j: 0..<needle.count { if hay[i + j] != needle[j] { ok = false; break; } }
    if ok { return true; }
  }
  return false;
}

#test "Institute Noir stylesheet emits canonical tokens, zero radius, system sans UI + Commit Mono code, emerald credits, and GitHub Dark syntax" {
  buf: [32768] u8;
  n := institute_noir_css(buf[..], 0);
  css := cast(string) buf[0..<n];
  #assert n > 1000 && n < 32768;
  #assert in_test_has(css, "SF Pro Display") && in_test_has(css, "CommitMono-Variable.woff2") && in_test_has(css, "'Commit Mono'");
  #assert in_test_has(css, "#000000") && in_test_has(css, "#f1efe8") && in_test_has(css, "#222222") && in_test_has(css, "#333333");
  #assert in_test_has(css, "#228c64") && in_test_has(css, "#34d399") && in_test_has(css, "border-radius:0");
  #assert in_test_has(css, "rgba(255,255,255,.35)") && !in_test_has(css, "#0285ff") && !in_test_has(css, "#3b82f6;outline");
  #assert in_test_has(css, "#6A737D") && in_test_has(css, "#F97583") && in_test_has(css, "#9ECBFF") && in_test_has(css, "#79B8FF") && in_test_has(css, "#B392F0") && in_test_has(css, "#FFAB70") && in_test_has(css, "#85E89D") && in_test_has(css, "#EF4444");
  #assert INSTITUTE_SYNTAX[0] == "#6A737D" && INSTITUTE_SYNTAX[1] == "#F97583" && INSTITUTE_SYNTAX[11] == "#EF4444";
}
