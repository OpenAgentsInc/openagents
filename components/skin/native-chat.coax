// Regular phone text skin. The reading measures are adapted from T3 Code
// f313d0a6cb (MIT); every colour is the mono skin's (mono-native.coax, #13580).
// SDK hosts perform text measurement and paint these roles.
#load "mono-native.coax";
NativeChatSkin :: struct {body:f64;line:f64;code:f64;padding:f64;gap:f64;bubble_fraction:f64;ink:u32;strong:u32;muted:u32;link:u32;code_bg:u32;bubble:u32;border:u32;}
#test "message text keeps its reading measures and takes its colours from the mono skin" {
  s:=nt_skin();t:=mono_native();
  #assert s.body==16 && s.line==23 && s.code==14.4 && s.padding==14 && s.gap==12 && s.bubble_fraction==0.85;
  #assert s.ink==t.ink && s.strong==t.ink_bright && s.muted==t.ink_muted && s.link==t.ink && s.code_bg==t.raised && s.bubble==t.surface && s.border==t.line_dim;
}
// A link is the text's own ink, underlined: the skin has no hue to mark it with.
nt_skin :: ()->NativeChatSkin #export_c #effects(all) {
  return NativeChatSkin.{body=16,line=23,code=14.4,padding=14,gap=12,bubble_fraction=0.85,ink=MONO_INK,strong=MONO_INK_BRIGHT,muted=MONO_INK_MUTED,link=MONO_INK,code_bg=MONO_RAISED,bubble=MONO_SURFACE,border=MONO_LINE_DIM};
}

nt_heading :: (level:int)->f64 #export_c #effects(all) {sizes:=[7]f64.[16,21,19,17,16,15,14];return ifx level>=1 && level<=6 then sizes[level] else 16.0;}

// T3 mobile work-log-layout: 28-point row, 24-point icon slot, 14-point
// symbol and text, 6-point gap, 11-point disclosure. Details scroll locally.
NativeWorkSkin :: struct {row:f64;slot:f64;icon:f64;gap:f64;text:f64;chevron:f64;detail_max:f64;}
#test "native work rows follow the T3 mobile work-log measures" {
 s:=nt_work();#assert s.row==36 && s.slot==24 && s.icon==16 && s.gap==8 && s.text==14 && s.chevron==11 && s.detail_max==240;
}
nt_work :: ()->NativeWorkSkin #export_c #effects(all) {return NativeWorkSkin.{row=36,slot=24,icon=16,gap=8,text=14,chevron=11,detail_max=240};}
