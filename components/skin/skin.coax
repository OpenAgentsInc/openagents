// A skin: how components look, apart from what they are (components/spec.md,
// GitHub #13153). A skin is tokens (colour roles, type roles, spacing,
// radii, border weights) plus frames (how a panel, a button, a slot or a bar
// is built from primitives). A component reads only roles: it asks for
// "ink", "the body face" or "a panel here", never for a colour or a size.
//
// The skins are values of one struct, UiSkin, made by zeron_skin
// (skin/zeron.coax: Zeron Dark), everglade_skin (skin/everglade.coax: iron
// and gold), metaverse_skin (skin/metaverse.coax: the Metaverse's instrument look) and
// terminal_skin (skin/terminal.coax: cells). ui_skin (skin/all.coax) picks
// one by id. Sizes are in the target's units: logical pixels on a pixel
// target, cells in a terminal.
//
// A face is a slot in the target's fonts (layout/font.coax): the host
// rasterized that slot's typeface and size, so a type role names a slot and
// carries the size and line height layout needs.
//   coax/bin/coax test components/skin/skin.coax

#load "../layout/text.coax";
#load "../paint/list.coax";
#load "hud.coax";           // the game HUD's roles (UiHud)

UISKIN_ZERON :: 0; UISKIN_EVERGLADE :: 1; UISKIN_VERSE :: 2; UISKIN_TERMINAL :: 3;
UISKINS :: 4;

// A type role: its face, its size and the height of a line of it.
UiType :: struct { face: int; size: f32; line: f32; }

// How a skin builds its frames.
UIFRAME_PLATE :: 0;           // Zeron: a rounded box, a hairline, a soft drop shadow
UIFRAME_IRON :: 1;            // Everglade: a dark body in a metal frame with a lit edge and gold studs
UIFRAME_CUT :: 2;             // the Metaverse: a dark body, a thin grey line, cyan corner ticks
UIFRAME_CELLS :: 3;           // a terminal: a one-cell border, no fill

// The roles a code token can have, in core/syntax.coax's order.
UISKIN_SYNTAX :: 12;

// Markdown's own measures.
UiMarkdown :: struct {
  line: f32;                // a line of body text
  block_gap: f32;           // between two blocks of one reply
  item_gap: f32;            // between list items
  marker_w: f32; marker_gap: f32; disc: f32;        // a list's marker column, the gap before the text, the bullet's size
  quote_rail: f32; quote_pad_l: f32; quote_pad_r: f32; quote_pad_y: f32; quote_gap: f32;
  code_pad_x: f32; code_inset_y: f32; code_radius: f32;     // inline code's wash: past the glyphs, inset from the line, its rounding
  block_radius: f32; block_border: f32; block_header: f32;  // a code block's frame and its header's height (0: no header)
  block_pad_x: f32; block_pad_y: f32; block_line: f32;
  action: f32;              // a header action's size (copy, wrap); 0: none
  action_gap: f32; action_edge: f32;                // Copy's extra width and the gap before it; from the block's edge
  wrap_radius: f32; copy_radius: f32; wrap_icon: f32; copy_icon: f32; copy_icon_x: f32;
  task: f32; task_radius: f32;                      // a task's box, drawn (a pixel target)
  cell_pad: f32; cell_pad_y: f32; divider: f32;      // a table's cell padding (sideways, then above and below), its row divider
  col_min_content: f32; col_min: f32;                // and its columns' floors
  bullet: string;           // a terminal's bullet (a pixel target draws a disc)
  task_open: string; task_done: string;             // and its task boxes (a pixel target draws them)
  link_paths: bool;         // inline code that names a file leaves a MARKDOWN_HIT_PATH where it is drawn, for its reader to open
  link_urls: bool;          // http(s) links leave a MARKDOWN_HIT_LINK where they are drawn, for their reader to open
}

// A glass surface (a slider's track or thumb): a vertical gradient, a rim,
// an unblurred inset light dy down, and a soft drop under it.
UiPlate :: struct {
  top: Rgba; bottom: Rgba; rim: Rgba;
  inset: Rgba; inset_dy: f32;
  drop: Rgba; drop_dy: f32; drop_blur: f32;
}

// The chat set's measures: the transcript's rows, notices, working trailer,
// tool groups and their details (Zeron's transcript.rs, changes.rs,
// notice.rs and loaders.rs). Alphas here are a role's ink at a strength.
UiTranscript :: struct {
  titlebar: f32;            // the window's titlebar, which the first row clears and the content fades under
  fade_band: f32;           // that fade's band
  status_strip: f32;        // the strip under the composer
  column: f32;              // the column's width (settings transcriptWidth)
  row_pad_x: f32;           // the room either side of the column
  gap: f32; gap_turn: f32; gap_group: f32;        // between rows; above a turn's first row; around a group, between blocks
  gap_first: f32;           // the first row's gap past the titlebar and a turn's gap
  lane: f32;                // under an entry's last row (its time)
  cull: f32;                // how far past the view a box is still painted
  bubble_share: f32;        // a user bubble's widest, a share of the column
  bubble_radius: f32; bubble_pad_x: f32; bubble_pad_y: f32;
  // a notice: its tile, header, wrapped message and buttons
  notice_pad: f32; notice_py: f32; notice_gap: f32; notice_tile: f32; notice_line: f32;
  notice_radius: f32; notice_tile_radius: f32; notice_icon: f32; notice_icon_inset: f32; notice_label_gap: f32;
  notice_button_h: f32; notice_button_pad: f32; notice_button_py: f32; notice_button_gap: f32; notice_actions_gap: f32;
  notice_wash: f32; notice_tile_wash: f32; notice_ink: f32; notice_button_wash: f32; notice_button_hover: f32;   // alphas of the notice's tone
  meta_line: f32;           // a quiet line under a turn (a meta notice, "Stopped")
  stop_icon: f32; stop_dy: f32; stop_gap: f32;   // "Stopped": its mark, set down in the line, and the gap after it
  // the working trailer: the spinner's cells, the word and the time
  work_top: f32; work_line: f32;
  spin_cell: f32; spin_pitch: f32; spin_side: f32; spin_period: f32; spin_dim: f32;
  // a tool group's header and its rows
  group_header: f32; group_chevron: f32; group_chevron_dx: f32; group_chevron_box: f32; group_chevron_dy: f32; group_summary_x: f32;
  label_line: f32; chips_top: f32; tree_row: f32; chip_card: f32;
  trunk_x: f32; bend: f32; branch_end: f32; icon_left: f32; icon: f32; gutter: f32; text_gap: f32;
  // a chip's header: the gaps, the trailing chevron, a file's badge
  chip_gap: f32; chevron_room: f32; chevron: f32; chevron_inset: f32;
  badge_h: f32; badge_radius: f32; badge_well: f32; badge_well_radius: f32; badge_icon: f32; badge_icon_inset: f32; badge_pad: f32; badge_edge: f32;
  file_ink: f32;            // a file's name on its badge: the ink's alpha
  // an open chip's details: lines, then a diff
  separator: f32; output_line: f32; output_py: f32; output_pad: f32;
  hunk_header: f32; diff_line: f32; body_bottom: f32;
  diff_gutter: f32; diff_digit: f32; gutter_pad_l: f32; gutter_pad_r: f32; number_inset: f32;
  marker: f32; accent_bar: f32; code_pad_l: f32;
  marker_ink: f32; number_ink: f32; changed_ink: f32; code_ink: f32;   // alphas: a context marker, a line number, a changed one, the code
}

// The composer's measures (Zeron's composer.rs and pickers.rs trigger_chip):
// the pill, its text box, the actions row and its chips, and the one-row
// form it docks in under a chat.
UiComposer :: struct {
  radius: f32; max_width: f32;              // the pill's corner; its widest
  line: f32;                                // a line of typed text
  text_inset: f32;                          // the text's room inside the pill's hairline, either side
  pad_top: f32; pad_v: f32;                 // the text box's padding above, and above and below together
  min: f32; max: f32;                       // the text box's least and most height
  actions_row: f32; actions_bottom: f32;    // the actions row's height, and its room under the chips
  border_v: f32;                            // the hairline, top and bottom together
  action_inset: f32; primary_gap: f32;      // the actions from the pill's edges; the gap before Send
  chip_h: f32; chip_radius: f32; chip_gap: f32; chip_pad: f32; model_chip_pad: f32; chip_icon: f32; chip_line: f32;
  pickers_gap: f32;                         // between the access chip and the model chip
  send: f32; stop: f32; stop_radius: f32;   // Send's circle; Stop's square in it
  caret: f32; caret_blink: f32;             // the caret's width; its blink, seconds a phase
  underline: f32;                           // an IME underline, a share of the descent under the baseline
  model_ink: f32; effort_ink: f32;          // alphas of a chip's model (the ink) and effort (muted)
  compact_h: f32; compact_inset: f32; compact_text_pad: f32;   // the docked one-row form
}

// The menus' measures (Zeron's popover.rs, pickers/compact.rs and
// settings/widgets.rs toggle_switch): a card, its rows, the compact model
// panel with its effort slider, the model list with its search, the access
// menu and its switch.
UiMenus :: struct {
  card_radius: f32; card_inset: f32; card_borders: f32;      // the card's corner, its rows' inset, its hairline top and bottom together
  gap: f32; item_radius: f32;                                // between rows; a row's corner
  offset: f32; margin: f32; most: f32; room: f32; below_min: f32;   // from the chip; inside the window; its tallest; kept free; under this above, it opens below
  pad_x: f32;                                                // text and marks inside a row
  // the compact model panel
  width: f32; header: f32; header_single: f32;
  title_line: f32; name_line: f32; title_chevron_room: f32; chevron: f32; chevron_gap: f32; chevron_shift: f32;
  title_chevron_dy: f32; name_chevron_dy: f32; chevron_ink: f32;   // the chevron set down beside the title or the name; its alpha at rest
  slider_top: f32; slider: f32; slider_bottom: f32;
  rail: f32; rail_top: f32; fill_past: f32;
  thumb_w: f32; thumb_h: f32; thumb_inset: f32;
  stop: f32; stop_radius: f32; stop_off_ink: f32;            // a stop on the rail; past the thumb, the muted ink's alpha
  // the model list
  row: f32; list_header: f32; tab_icon: f32; tab_ink: f32;
  search_row: f32; search_icon: f32; search_icon_x: f32; search_gap: f32; search_text_dy: f32; search_line: f32; caret: f32;
  row_icon: f32; row_gap: f32; star_inset: f32; star: f32; detail_gap: f32; detail_min: f32;
  // the access menu
  access_width: f32; line: f32; desc_line: f32; row_py: f32; check: f32; check_gap: f32; label_ink: f32;
  // the switch: track, marks and knob
  switch_w: f32; switch_h: f32; switch_track: f32; switch_inset: f32; switch_knob: f32; switch_mark: f32; switch_gap: f32;
  switch_track_dy: f32; switch_empty: f32; switch_mark_dy: f32; switch_knob_h: f32; switch_travel: f32;
  bar_w: f32; bar_h: f32; bar_radius: f32; bar_dx: f32;      // the on mark
  ring_in: f32; ring: f32; ring_radius: f32;                 // the off mark
}

// The desk's measures (the desktop app's session sidebar, its tabs in the
// titlebar and the agents' room; Zeron's sidebar.rs and tab strip).
UiDesk :: struct {
  side_min: f32; side_max: f32; side: f32;     // the sidebar's width: least, most, at first
  top: f32;                 // the sidebar's first row under the titlebar
  pad: f32;                 // the sidebar's and the tab strip's side padding
  row: f32; gap: f32; header: f32; section_gap: f32;   // a session row, between rows, a folder's header, between sections
  row_radius: f32; inset: f32; icon: f32; icon_gap: f32; mark: f32;   // a row's corner; its content inset; New session's icon; the gap after a mark
  dot: f32; dot_gap: f32; idle_ink: f32;       // a status dot, the gap before it, an idle dot's alpha of the faint ink
  edge: f32;                // the resize handle, half its width
  lights: f32;              // the traffic lights' room, where tabs start with the sidebar collapsed
  tab_h: f32; tab_min: f32; tab_max: f32; tab_gap: f32; tab_pad: f32;
  room_pad: f32; room_unseen: f32; room_gap: f32;      // the ROOM tab: its label's padding, its unseen dot's room, before the session tabs
  chat_min: f32;            // the shown chat's least width
  room_col: f32; room_line: f32; room_head: f32; room_foot: f32;   // the room's column, a line of a message, its header, under it
  room_margin: f32; room_top: f32; room_bottom: f32; room_cull: f32; room_mark_dy: f32; room_mark_gap: f32;
}

// The chat screen's own parts around the composer (components/zeron/chrome.coax):
// the status strip, the failure notice's margins, the dictation button and
// its microphone, drawn from boxes.
UICHROME_STROKE :: 0; UICHROME_MASK :: 1; UICHROME_FILL :: 2;   // a box's paint: an outline in the ink, the well's ground, filled with the ink
UiChromeBox :: struct { x: f32; y: f32; w: f32; h: f32; radius: f32; border: f32; paint: int; }
UiChrome :: struct {
  status_top: f32; status_x: f32; status_dot: f32; status_gap: f32; idle_ink: f32;   // the strip under the composer; an idle dot's alpha of the faint ink
  failure_mx: f32; failure_gap: f32;                     // the failure notice inside the column; over the composer
  mic: f32; mic_gap: f32; mic_label_gap: f32; mic_wash: f32;   // the dictation well, under the composer, its label's gap; the accent's alpha while it listens
  mic_parts: [5] UiChromeBox;                            // the microphone in the well
  button_h: f32;                                         // a text button (a trigger chip's look)
  primary_h: f32; primary_pad: f32; primary_ink: f32;    // a filled button: its height, its label's padding, the ink's alpha at rest
  field_h: f32; field_radius: f32; field_pad: f32; field_caret: f32; field_focus: f32;   // a one-line field; the accent's alpha on its edge when focused
}

// The settings screen's measures, type and colours (components/app/settings.coax):
// Zeron's settings (apps/zgx/ui/ds/settings.luau, ds/account_row.luau,
// screens/shell/settings.luau and ds/tokens.luau's zeron.settings block), in
// points. A skin that draws its units larger than points divides them
// (uisettings_scaled). Based on Zeron by Wing, MIT.
UiSettings :: struct {
  // faces (slots in the target's fonts) and their lines
  title_face: int; title_line: f32;        // a page's title (20/26 semibold)
  text_face: int; text_line: f32;          // a list row's label, a page's description, a value (13 regular)
  page_line: f32;                          // a page's description's line (20)
  name_face: int; name_line: f32;          // a row's name, the account's name, a primary button (13 medium)
  desc_face: int; desc_line: f32;          // a row's description, a caption, a small button (12)
  head_face: int; head_line: f32;          // a list heading, a section's title (11 medium)
  // the list (Settings.Nav)
  strip: f32;               // the title bar's strip over the rows
  list_pad: f32; list_gap: f32;            // its inset; between rows
  heading: f32; heading_pad: f32;          // a heading's height and its top padding
  row: f32; row_pad: f32; row_gap: f32; row_radius: f32;   // a page's row: height, side padding, icon to label, corner
  icon: f32; icon_dy: f32;                 // a row's icon and its nudge
  edge: f32; handle: f32;                  // the hairline down its right; the drag handle
  search_h: f32; search_radius: f32; search_icon: f32; search_pad: f32; search_gap: f32;   // the search field (size sm)
  key_h: f32; key_icon: f32; key_pad: f32; key_radius: f32; key_gap: f32; // its quiet ⌘ F key chip
  account: f32; avatar: f32; account_top: f32; toggle_radius: f32;   // the account row: its slot, the avatar, the gap above it, the toggle's corner
  // a page (Settings.Page)
  measure: f32; page_pad: f32; page_top: f32; page_bottom: f32;    // its column at most; side, top and bottom padding
  block_gap: f32; title_gap: f32; text_inset: f32; min_text: f32;  // between blocks; title to description; the rows' text edge; the least words beside a control
  aside_w: f32; aside_h: f32; aside_zoom: f32; aside_narrow: f32; caption_gap: f32;   // the aside: its width, the card's height at its zoom, below what it moves over the rows, caption gap
  fade: f32;                // the page's scroll fade
  // a section, a group (card) and a row
  section_gap: f32; head_gap: f32;         // a section's parts; its title to its hint
  card_radius: f32; card_edge: f32;
  row_px: f32; row_py: f32; text_gap: f32; desc_gap: f32; control: f32;   // a row's padding, words to control, name to description, the control at most
  lead: f32; lead_radius: f32; lead_gap: f32; lead_icon: f32;   // a row's lead tile
  chevron: f32; chevron_gap: f32;          // a row that leads somewhere
  button_h: f32; button_pad: f32; button_radius: f32;          // a button (md)
  small_h: f32; small_pad: f32; small_radius: f32;             // a small button (sm)
  button_top: f32;          // a page's button under its card
  // colours
  text: Rgba; secondary: Rgba; tertiary: Rgba;   // text.primary and its 0.6 and 0.42
  selected: Rgba;           // the chosen list row (zeron.selected.flat.bg)
  tint: Rgba;               // a card's fill (zeron.settings.tint)
  subtle: Rgba; strong: Rgba;              // border.subtle (a card's edge, its rules, the list's hairline); border.strong (the hairline under the pointer)
  hover: Rgba; pressed: Rgba;              // a row that leads somewhere, under the pointer and held
  well: Rgba; well_hover: Rgba;            // a lead tile's ground and a secondary button's (zeron.secondary.bg); hovered
  field: Rgba; field_edge: Rgba;           // the search field's ground and edge
  primary: Rgba; primary_hover: Rgba; on_primary: Rgba;   // a primary button: its ground and ink
  danger: Rgba;
}

// The settings measures for a skin that draws a unit `by` points: every length divided by it, the faces and colours kept.
uisettings_scaled :: (t: UiSettings, by: f32) -> UiSettings {
  if !(by > 0) || by == 1 { return t; }
  s := t; d := 1 / by;
  s.title_line *= d; s.text_line *= d; s.page_line *= d; s.name_line *= d; s.desc_line *= d; s.head_line *= d;
  s.strip *= d; s.list_pad *= d; s.list_gap *= d; s.heading *= d; s.heading_pad *= d;
  s.row *= d; s.row_pad *= d; s.row_gap *= d; s.row_radius *= d; s.icon *= d; s.icon_dy *= d; s.edge *= d; s.handle *= d;
  s.search_h *= d; s.search_radius *= d; s.search_icon *= d; s.search_pad *= d; s.search_gap *= d;
  s.key_h *= d; s.key_icon *= d; s.key_pad *= d; s.key_radius *= d; s.key_gap *= d;
  s.account *= d; s.avatar *= d; s.account_top *= d; s.toggle_radius *= d;
  s.measure *= d; s.page_pad *= d; s.page_top *= d; s.page_bottom *= d;
  s.block_gap *= d; s.title_gap *= d; s.text_inset *= d; s.min_text *= d;
  s.aside_w *= d; s.aside_h *= d; s.aside_narrow *= d; s.caption_gap *= d; s.fade *= d;
  s.section_gap *= d; s.head_gap *= d; s.card_radius *= d; s.card_edge *= d;
  s.row_px *= d; s.row_py *= d; s.text_gap *= d; s.desc_gap *= d; s.control *= d;
  s.lead *= d; s.lead_radius *= d; s.lead_gap *= d; s.lead_icon *= d; s.chevron *= d; s.chevron_gap *= d;
  s.button_h *= d; s.button_pad *= d; s.button_radius *= d; s.small_h *= d; s.small_pad *= d; s.small_radius *= d; s.button_top *= d;
  return s;
}

// A floating surface's shadow (Tailwind's shadow-lg: two soft layers of the skin's lift).
UiFloat :: struct { dy: [2] f32; blur: [2] f32; spread: [2] f32; }

// Shared animated kit geometry and paint strengths. Skins may override them.
UiAnimated :: struct {
 frame_corner_stroke:f32=3;frame_square_fraction:f32=0.1;frame_square_limit:f32;
 activity_sweep:f32=0.25;frame_stroke:f32=1.5;activity_stroke:f32=2;progress_stroke:f32=3;
 drawer_gap:f32=6;drawer_half:f32=9;drawer_shift:f32=2;drawer_head:f32=9;drawer_tip:f32=1;drawer_stroke:f32=2;
 switch_inset:f32=3;drawer_radius:f32=6;reply_radius:f32=4;
 frame_wash:f32=0.7;activity_wash:f32=0.12;switch_wash:f32=0.35;reply_wash:f32=0.15;
}
// How long the kit's motion takes, in seconds (the times skin/arcade.coax's
// scene has used since build 1087). Keyed components read them through the
// frame context (kit/frame.coax).
// hover: a wash or an ink easing in and out under the pointer (Zeron's HoverFade, 100 to 150 ms);
// swap: one icon crossfading into another (a copy icon to its check and back); panel: a sidebar
// or a pane sliding open or shut (Zeron's 180 to 220 ms); roll: a status word rolling into the next;
// slide: a selection's wash gliding to the chosen tab (Zeron's SelectionSlide, 220 ms); toast: how
// long a toast stays before it leaves.
UiMotion :: struct { enter: f32 = 0.2; press: f32 = 0.1; focus: f32 = 0.2; menu: f32 = 0.3; hover: f32 = 0.12; swap: f32 = 0.14; panel: f32 = 0.2; roll: f32 = 0.18; slide: f32 = 0.22; toast: f32 = 4.0; }
// The app set's measures (components/app/; GitHub #13645): the components the
// native apps' screens are built from. Sizes are layout units; a skin may
// override any of them. A `_wash` or `_ink` is a role's strength, 0 to 1.
UiApp :: struct {
  gap: f32 = 8; gap_small: f32 = 4;                    // between a component's parts
  rise: f32 = 8;                                       // how far a component rises as it enters
  icon: f32 = 16;                                      // an icon beside a label
  icon_button: f32 = 44; icon_well: f32 = 34;          // an icon button's target, and the ground it shows
  primary_rest: f32 = 0.9;                             // a primary button's fill at rest (1 while held)
  quiet_h: f32 = 34;                                   // a quiet button's ground inside its target
  caret: f32 = 1.5; caret_blink: f32 = 0.55;           // a field's caret, and seconds a blink phase
  notice_pad: f32 = 12; notice_radius: f32 = 14; notice_icon: f32 = 14;
  card_radius: f32 = 18; card_pad: f32 = 16;
  sheet_radius: f32 = 22; grabber_w: f32 = 36; grabber_h: f32 = 4; grabber_top: f32 = 8;
  row_radius: f32 = 12; row_inset: f32 = 4;            // a menu or history row's ground, inset from its target
  switch_w: f32 = 48; switch_h: f32 = 28;
  ring: f32 = 22;
  bubble_radius: f32 = 18; bubble_pad_x: f32 = 14; bubble_pad_y: f32 = 9; bubble_share: f32 = 0.84;
  bubble_fold: f32 = 5; bubble_fade: f32 = 1.5;       // a person's message folds past this many lines, its foot fading over this many (Zeron's ds/user_message)
  bubble_ease: f32 = 0.26; bubble_more_gap: f32 = 8;   // seconds Show more and Show less ease the height over (outQuart); the text to the control
  pill_h: f32 = 30; pill_pad: f32 = 12; pill_gap: f32 = 8; pill_icon: f32 = 14;   // Jump to latest: its height, padding, gaps and arrow (ds/transcript)
  pill_lift: f32 = 6; pill_rise: f32 = 8; pill_in: f32 = 0.18; pill_out: f32 = 0.12;   // above what it floats over; how far it rises; seconds in and out
  code_radius: f32 = 12; code_head: f32 = 34; code_pad: f32 = 12; code_copy_pad: f32 = 10;
  code_copy_h: f32 = 24; code_copy_x: f32 = 8; code_copy_icon: f32 = 12; code_copy_gap: f32 = 4; code_copy_edge: f32 = 5;   // a code block's Copy: Zeron's 24 tall button, its padding, icon and gap, 5 from the strip's end
  dot: f32 = 6; dot_gap: f32 = 5; dot_period: f32 = 1.2; dot_dim: f32 = 0.3;
  jump: f32 = 38; jump_icon: f32 = 16;
  state_dot: f32 = 8;
  tool_h: f32 = 40; tool_pad: f32 = 12; tool_radius: f32 = 12; tool_icon: f32 = 14; tool_chevron: f32 = 12;
  tool_body_pad: f32 = 10; tool_page_lines: f32 = 8;   // lines of input or result a page shows
  pager_h: f32 = 32;
  group_rail: f32 = 1.5; group_inset: f32 = 14;        // a tool group's rail, and its rows' inset past it
  banner_h: f32 = 36; banner_radius: f32 = 18;
  nav: f32 = 44; nav_icon: f32 = 20;
  side_row: f32 = 44; side_row_two: f32 = 58; side_head: f32 = 30; side_pad: f32 = 14;
  side_text: UiType;                                   // a sidebar row's title (line 0: the skin's body)
  off_ink: f32 = 0.45;                                 // a disabled part's ink strength
  icon_alert: int = -1; icon_nav: int = -1; icon_disclose: int = -1;   // slots in the target's icons: a failure's mark, the navigation button's, a row that opens (-1: the skin has none)
}
// Conversation presentation; optional so other skins retain their geometry.
// The activity group's measures (components/app/activity.coax, GitHub #13731): Zeron's
// ds/activity.luau, tree_line.luau and working.luau, read in points, as layout units. A skin
// drawn at another scale divides the sizes by it (app_act_scaled). A
// `_ink` or `_wash` is a strength, 0 to 1; `_lines` and `rotate` are counts and seconds.
UiActivity :: struct {
  loader: f32 = 16;                                    // the working loader, and the trunk's x under its middle
  trunk: f32 = 8.5; bend: f32 = 6; branch_end: f32 = 20;   // the trunk's x, an elbow's bend, where a branch ends
  glyph_left: f32 = 24; glyph: f32 = 16; gutter: f32 = 48;   // a row's glyph, and where its words start
  row: f32 = 28; header: f32 = 26; header_gap: f32 = 8;   // a tool's row, the summary's line, the loader to the summary
  verb_gap: f32 = 4; fade: f32 = 24;                   // the verb to its target; how far a line that runs over fades
  tree_ink: f32 = 0.12;                                // the trunk and elbows: the ink at this strength
  thought_line: f32 = 20; thought_gap: f32 = 12;       // a thought's prose: its line, the gap between its blocks
  thought_lines: f32 = 6; thought_fade: f32 = 1.5;     // a thought folds past this many lines, its foot fading over this many
  thought_face: int = -1; thought_bold: int = -1; thought_code: int = -1;   // a thought's faces, a step smaller than a reply's (-1: the reply's)
  fold_h: f32 = 20; fold_pad: f32 = 6; fold_radius: f32 = 4; fold_room: f32 = 26; fold_wash: f32 = 0.08;   // "Show all N lines"
  detail_pad_x: f32 = 12; detail_pad_y: f32 = 8; detail_radius: f32 = 6; detail_gap: f32 = 4;   // a row opened onto its call and output
  detail_lines: f32 = 10; detail_wash: f32 = 0.05;     // an output folds past this many lines
  working_h: f32 = 26; working_gap: f32 = 8;   // the working line: its height and its gap
}
UiConversation :: struct {enabled:bool;inset:f32=14;action:f32=44;header_pad:f32=12;identity_radius:f32=22;greeting_gap:f32=16;mark:f32=30;menu_w:f32=240;}
// One drop shadow as CSS writes it (offset x, y; blur; spread; colour), as
// Zeron's tokens give them (zgx ui/ds/themes/zeron-dark.json). Draw one with
// uiskin_shadow: the blur is CSS's, twice the gaussian's sigma.
UiShadow :: struct { dx: f32; dy: f32; blur: f32; spread: f32; color: Rgba; }
// The elevation ramp and the floating surfaces' shadows (Zeron Dark).
UiShadows :: struct {
  sm: UiShadow = UiShadow.{dy = 1, blur = 2, color = Rgba.{a = 0.349}};          // 0 1 2 #00000059
  md: UiShadow = UiShadow.{dy = 4, blur = 12, color = Rgba.{a = 0.4}};           // 0 4 12 #00000066
  lg: UiShadow = UiShadow.{dy = 12, blur = 32, color = Rgba.{a = 0.502}};        // 0 12 32 #00000080
  composer: UiShadow = UiShadow.{dy = 12, blur = 32, color = Rgba.{a = 0.4}};    // 0 12 32 #00000066
  menu: UiShadow = UiShadow.{dy = 20, blur = 56, color = Rgba.{a = 0.322}};      // 0 20 56 #00000052
  dialog: UiShadow = UiShadow.{dy = 24, blur = 64, color = Rgba.{a = 0.502}};    // 0 24 64 #00000080
}
UiSkin :: struct {
 shadows:UiShadows;
 chat:UiConversation;
 animated:UiAnimated;
 motion:UiMotion;
 app:UiApp;
 act:UiActivity;
  id: int; name: string;
  // colour roles
  canvas: Rgba;             // the window behind everything
  surface: Rgba;            // a panel's body
  raised: Rgba;             // a control resting on a surface: a bubble, a chip's well
  bubble: Rgba;             // a person's message's ground (alpha 0: raised)
  float_ground: Rgba;       // a pill floating over the transcript: Jump to latest (alpha 0: surface)
  sunk: Rgba;               // a ground set into a surface: a code block, a slot
  hairline: Rgba;           // borders and dividers
  hover: Rgba;              // the wash under a hovered control
  ink: Rgba; muted: Rgba; faint: Rgba;
  accent: Rgba;             // the caret, a bullet, inline code, a primary action
  on_accent: Rgba;          // what is drawn on the accent
  selection: Rgba;
  danger: Rgba; warning: Rgba; success: Rgba;
  code_wash: Rgba;          // inline code's ground
  quote_wash: Rgba; quote_rail: Rgba;
  header_wash: Rgba;        // a code block's header over its ground
  syntax: [UISKIN_SYNTAX] Rgba;
  // the chat set's own roles
  chip: Rgba;               // a file's chip in a tool row
  well: Rgba;               // the well an icon sits in on a chip
  rail: Rgba;               // the activity rail beside a tool group's rows
  hunk_wash: Rgba;          // a diff's hunk header
  add_wash: Rgba; add_bar: Rgba; del_wash: Rgba; del_bar: Rgba;     // a diff's added and removed lines: the row and its edge bar
  danger_muted: Rgba; warning_muted: Rgba;          // a notice's text on its tinted ground
  file_tint: Rgba;          // a source file's icon
  doc_tint: Rgba;           // an attached document's icon (an image's is the muted ink)
  spinner: [3] Rgba;        // the working spinner's three rows
  clear: Rgba;              // nothing: the fill under a ring or a rim
  sidebar: Rgba;            // the session sidebar's ground
  action_hover: Rgba;       // a sidebar action (New session) under the pointer
  row_hover: Rgba; row_shown: Rgba;                 // a session's row hovered, and shown (its tab too)
  tab_hover: Rgba;          // a tab hovered
  brand: Rgba;              // Claude's mark, in its own tone
  field_edge: Rgba;         // the border of a field, a floating card, the sidebar and a shown tab: the composer's pill, a menu
  lift: Rgba;               // a floating card's soft shadow (two layers of it)
  hover_chip: Rgba;         // a chip hovered or with its menu open
  menu_hover: Rgba;         // a menu row under the pointer
  menu_selected: Rgba; menu_ring: Rgba;             // the chosen menu row and its ring
  menu_rule: Rgba; menu_divider: Rgba;              // under a menu's search field; between its sections
  list_wash: Rgba;          // a menu's list, set into the card
  stop_on: Rgba;            // a slider's stop at or under the thumb (one past it is the muted ink, faint)
  track: UiPlate; thumb: UiPlate;                   // a slider's track and thumb (the fill is the accent's plate)
  accent_light: Rgba;       // the lit edge inside the accent's plate
  switch_shade: Rgba; switch_wash: Rgba; switch_rim: Rgba;   // a switch's track, on (over the accent) and off (over the surface), and its rim on
  switch_mark: Rgba; switch_ring: Rgba;             // the on mark and the off ring
  switch_knob: Rgba; switch_knob_rim: Rgba;         // the knob (over the surface) and its rim (over the knob)
  // type roles
  body: UiType; strong: UiType; code: UiType;       // running text, **bold**, `inline code`
  mono: UiType;             // a code block's lines
  small: UiType;            // a caption: a code block's language, a timestamp
  label: UiType;            // a control's label: a button, a tab, a chip
  title: UiType;            // a panel's heading
  display: UiType;          // a large title, in a display face (size 0: the skin has none; use title)
  tool: UiType;             // a tool row's text, a notice's
  mono_small: UiType;       // tool output, an invocation, a diff's lines
  mono_tiny: UiType;        // a diff's gutters and hunk headers
  menu: UiType; menu_small: UiType;                 // a menu's rows and their descriptions
  search: UiType;           // a menu's search field
  // spacing, radii and weights
  space: f32;               // the base gap (Zeron's SPACE_SM)
  pad: f32;                 // a panel's padding
  radius: f32;              // a panel's corner
  radius_control: f32;      // a button's, a chip's
  border: f32;              // a hairline's weight
  control_h: f32;           // a button's or a tab's height
  control_pad: f32;         // a control's padding either side of its label
  slider_track: f32; knob: f32;                     // a slider's track and its knob (0: none, the value is the bar)
  bar_h: f32;               // a bar's thickness
  // frames
  frame: int;
  frame_mid: Rgba; frame_light: Rgba; trim: Rgba;   // a frame's metal, its lit edge, its ornaments
  shadow: f32;              // a panel's drop shadow reach; 0 none
  shade: Rgba;              // the shadow's colour
  stud: f32;                // an ornament's size; 0 none
  // icons a component asks for by role (slots in the target's icons; -1: the skin has none)
  icon_copy: int; icon_wrap: int; icon_chevron: int; icon_check: int;
  md: UiMarkdown;
  hud: UiHud;               // the game HUD's colours and measures (skin/hud.coax)
  tr: UiTranscript;         // the chat set's measures (a cell skin leaves them 0: the chat set is not laid out in cells)
  cmp: UiComposer;
  menus: UiMenus;
  desk: UiDesk;
  chrome: UiChrome;
  set: UiSettings;          // the settings screen (components/app/settings.coax)
  lifted: UiFloat;          // a floating card's shadow: the composer's pill, a menu
}

// A skin's faces for styled text (layout/text.coax).
uiskin_faces :: (s: UiSkin) -> TextFaces { return TextFaces.{plain = s.body.face, bold = s.strong.face, code = s.code.face, code_pad = s.md.code_pad_x}; }
// The faces for styled text a size down (a tool row's, a notice's): no bold face of its own.
uiskin_small_faces :: (s: UiSkin) -> TextFaces { return TextFaces.{plain = s.tool.face, bold = s.tool.face, code = s.mono_small.face, code_pad = s.md.code_pad_x}; }

// Whether a skin value has been set (a zeroed one has no name).
uiskin_is_set :: (s: UiSkin) -> bool { return s.name.count > 0; }

// A plate: the drop beneath, the fill with its rim, the inset light above. Returns the count.
uiskin_plate :: (list: [] Prim, n: int, x: f32, y: f32, w: f32, h: f32, radius: f32, p: UiPlate) -> int {
  k := prim_shadow(list, n, x, y, w, h, radius, 0, p.drop_dy, p.drop_blur, 0, p.drop);
  k = prim_gradient(list, k, x, y, w, h, radius, p.top, p.bottom);
  k = prim_box(list, k, x, y, w, h, radius, 1, rgba(0, 0, 0, 0), p.rim);
  return prim_inset(list, k, x, y, w, h, radius, p.inset_dy, p.inset);
}
// A floating surface's shadow, both layers of it, under (x, y, w, h). Returns the count.
uiskin_float :: (list: [] Prim, n: int, s: UiSkin, x: f32, y: f32, w: f32, h: f32, radius: f32) -> int {
  k := n;
  for i: 0..<s.lifted.dy.count { k = prim_shadow(list, k, x, y, w, h, radius, 0, s.lifted.dy[i], s.lifted.blur[i], s.lifted.spread[i], s.lift); }
  return k;
}
// A drop shadow token under (x, y, w, h) with its corner radius: the
// analytic gaussian rounded-rect shadow (backend/gpu-shader.coax, kind 1),
// sigma half the CSS blur. Returns the count.
uiskin_shadow :: (list: [] Prim, n: int, x: f32, y: f32, w: f32, h: f32, radius: f32, s: UiShadow) -> int {
  return prim_shadow(list, n, x, y, w, h, radius, s.dx, s.dy, s.blur / 2, s.spread, s.color);
}
#test "a shadow token is a prim_shadow at half its CSS blur, and Zeron's ramp is the default" {
  k: UiSkin;
  #assert k.shadows.menu.dy == 20 && k.shadows.menu.blur == 56 && k.shadows.dialog.color.a > 0.5 && k.shadows.sm.color.a > 0.34;
  p: [2] Prim;
  n := uiskin_shadow(p[..], 0, 10, 20, 100, 40, 26, k.shadows.composer);
  #assert n == 1 && p[0].kind == PRIM_SHADOW && p[0].b == 12 && p[0].c == 16 && p[0].d == 0 && p[0].fill.a == 0.4f32 && p[0].radius == 26;
}
// A colour moved toward white by amount (glass.rs lift).
uiskin_lift :: (c: Rgba, amount: f32) -> Rgba { return Rgba.{r = c.r + (1 - c.r) * amount, g = c.g + (1 - c.g) * amount, b = c.b + (1 - c.b) * amount, a = c.a}; }
// The accent's plate: a slider's fill (glass.rs accent_plate, from the skin's accent).
uiskin_accent_plate :: (s: UiSkin) -> UiPlate {
  base := s.accent;
  return UiPlate.{top = uiskin_lift(base, 0.06), bottom = base, rim = opacity(uiskin_lift(base, 0.35), 0.35),
                  inset = s.accent_light, inset_dy = 1, drop = s.clear, drop_dy = 0, drop_blur = 0};
}

// A syntax role's colour; anything outside the roles is the plain colour.
uiskin_syntax :: (s: UiSkin, role: int, plain: Rgba) -> Rgba {
  if role < 0 || role >= UISKIN_SYNTAX { return plain; }
  return s.syntax[role];
}

// ---------------------------------------------------------------- frames

// A panel: the skin's frame around (x, y, w, h), its body filled. Returns the count.
uiskin_panel :: (list: [] Prim, n: int, s: UiSkin, x: f32, y: f32, w: f32, h: f32) -> int {
  k := n;
  if s.frame == UIFRAME_CELLS {
    return prim_box(list, k, x, y, w, h, 0, s.border, rgba(0, 0, 0, 0), s.hairline);
  }
  if s.shadow > 0 { k = prim_shadow(list, k, x, y, w, h, s.radius, 0, s.shadow / 3, s.shadow, 0, s.shade); }
  if s.frame == UIFRAME_IRON {
    // the metal frame, its lit inner edge, the body, a stud at each corner
    k = prim_box(list, k, x, y, w, h, s.radius, s.border * 2, s.surface, s.frame_mid);
    k = prim_box(list, k, x + s.border * 2, y + s.border * 2, w - s.border * 4, h - s.border * 4, s.radius - s.border, s.border / 2, rgba(0, 0, 0, 0), s.frame_light);
    if s.stud > 0 {
      d := s.stud; o := d / 2;
      k = prim_fill(list, k, x - o + s.border, y - o + s.border, d, d, 1, s.trim);
      k = prim_fill(list, k, x + w - o - s.border, y - o + s.border, d, d, 1, s.trim);
      k = prim_fill(list, k, x - o + s.border, y + h - o - s.border, d, d, 1, s.trim);
      k = prim_fill(list, k, x + w - o - s.border, y + h - o - s.border, d, d, 1, s.trim);
    }
    return k;
  }
  if s.frame == UIFRAME_CUT {
    // a dark body in a thin line, with a brighter tick at each corner
    k = prim_box(list, k, x, y, w, h, 0, s.border, s.surface, s.frame_mid);
    t := s.radius; b := s.border * 2;
    k = prim_line(list, k, x, y + b / 2, x + t, y + b / 2, b, s.trim);
    k = prim_line(list, k, x + b / 2, y, x + b / 2, y + t, b, s.trim);
    k = prim_line(list, k, x + w - t, y + h - b / 2, x + w, y + h - b / 2, b, s.trim);
    k = prim_line(list, k, x + w - b / 2, y + h - t, x + w - b / 2, y + h, b, s.trim);
    return k;
  }
  return prim_box(list, k, x, y, w, h, s.radius, s.border, s.surface, s.hairline);
}

// A control's ground (a button, a chip, a tab): resting, hovered or the primary action.
UISKIN_REST :: 0; UISKIN_HOVER :: 1; UISKIN_PRIMARY :: 2;
uiskin_control :: (list: [] Prim, n: int, s: UiSkin, x: f32, y: f32, w: f32, h: f32, state: int) -> int {
  if s.frame == UIFRAME_CELLS {
    return ifx state == UISKIN_REST then n else prim_fill(list, n, x, y, w, h, 0, ifx state == UISKIN_PRIMARY then s.accent else s.hover);
  }
  fill := ifx state == UISKIN_PRIMARY then s.accent else ifx state == UISKIN_HOVER then s.hover else s.raised;
  if s.frame == UIFRAME_IRON { return prim_box(list, n, x, y, w, h, s.radius_control, s.border, fill, ifx state == UISKIN_REST then s.frame_mid else s.trim); }
  if s.frame == UIFRAME_CUT { return prim_box(list, n, x, y, w, h, 0, s.border, fill, ifx state == UISKIN_REST then s.frame_mid else s.trim); }
  return prim_box(list, n, x, y, w, h, s.radius_control, s.border, fill, s.hairline);
}

// A toggle's width, and the toggle itself in a control's row at (x, y): a
// track with a knob at its on or off end; in cells, a box with a mark.
uiskin_toggle_width :: (s: UiSkin) -> f32 {
  if s.frame == UIFRAME_CELLS { return 3; }
  return round_layout(s.control_h * 1.1);
}
uiskin_toggle :: (list: [] Prim, n: int, s: UiSkin, x: f32, y: f32, on: bool) -> int {
  w := uiskin_toggle_width(s);
  if s.frame == UIFRAME_CELLS { return prim_text(list, n, x, y, w, s.body.line, s.body.face, ifx on then s.accent else s.muted, ifx on then "[x]" else "[ ]"); }
  h := round_layout(s.control_h * 0.56);
  ty := y + (s.control_h - h) / 2;
  round := s.frame == UIFRAME_PLATE || s.frame == UIFRAME_IRON;
  k := prim_box(list, n, x, ty, w, h, ifx round then h / 2 else 0.0f32, s.border, ifx on then s.accent else s.sunk, ifx s.frame == UIFRAME_PLATE then s.hairline else s.frame_mid);
  knob := h - 4;
  kx := ifx on then x + w - 2 - knob else x + 2;
  return prim_fill(list, k, kx, ty + 2, knob, knob, ifx round then knob / 2 else 0.0f32, ifx on then s.on_accent else s.muted);
}

// A slot: a ground set into a surface (a code block's body, an item slot, a track).
uiskin_slot :: (list: [] Prim, n: int, s: UiSkin, x: f32, y: f32, w: f32, h: f32, radius: f32) -> int {
  if s.frame == UIFRAME_CELLS { return prim_box(list, n, x, y, w, h, 0, s.border, rgba(0, 0, 0, 0), s.hairline); }
  return prim_box(list, n, x, y, w, h, radius, s.border, s.sunk, ifx s.frame == UIFRAME_IRON then s.frame_mid else s.hairline);
}

// A bar: a track filled to a share (0..1) in a colour.
uiskin_bar :: (list: [] Prim, n: int, s: UiSkin, x: f32, y: f32, w: f32, h: f32, share: f32, color: Rgba) -> int {
  f := ifx share < 0 then 0.0f32 else ifx share > 1 then 1.0f32 else share;
  r := ifx s.frame == UIFRAME_PLATE || s.frame == UIFRAME_IRON then h / 2 else 0.0f32;
  k := prim_box(list, n, x, y, w, h, r, ifx s.frame == UIFRAME_IRON then s.border else 0.0f32, s.sunk, s.frame_mid);
  if f > 0 { k = prim_fill(list, k, x, y, w * f, h, r, color); }
  return k;
}
