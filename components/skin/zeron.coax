// Zeron Dark: zgx's themes/zeron-dark.json (Zeron e393c4a8), the one source of its colours. A
// skin reads its roles from here, and so does a page that draws a part the skin has no role for
// (Coder Desktop's composer and menus): no colour is written out anywhere else.
Theme :: struct {
  shell: Rgba;          // zeron.window
  surface: Rgba;        // zeron.composer.solid: the composer's pill
  border: Rgba;         // zeron.composer.edge
  text: Rgba; muted: Rgba; faint: Rgba;   // text.primary, .secondary (0.6), .tertiary (0.42)
  disabled: Rgba;       // text.disabled (0.28)
  accent: Rgba;         // the caret
  accent_hover: Rgba; accent_active: Rgba;
  selection: Rgba;      // the accent at 0.35: selected text
  focus_ring: Rgba;     // the accent at 0.6, 2 wide, 1 out
  bg: Rgba;             // zeron.primary.text: Send's arrow, what is drawn on the primary
  claude: Rgba;         // the Claude mark (icons.rs claude_brand)
  line: Rgba; line_subtle: Rgba; line_strong: Rgba;   // border, border.subtle, border.strong
  hover: Rgba; pressed: Rgba; selected: Rgba;         // washes: hover, pressed, selection.item
  raised: Rgba; base: Rgba;                           // surface.raised, surface.base
  sidebar: Rgba; row_selected: Rgba;                  // zeron.sidebar.tint, zeron.selected.flat.bg
  primary: Rgba; primary_hover: Rgba; primary_active: Rgba;   // zeron.primary
  secondary: Rgba; secondary_hover: Rgba;             // zeron.secondary
  menu: Rgba; menu_selected: Rgba;                    // zeron.menu.solid, .selected
  popover: Rgba;                                      // popover.bg
  composer_tint: Rgba;                                // zeron.composer.tint (frosted)
  shadow_sm: Rgba; shadow_md: Rgba; shadow_lg: Rgba;  // shadow.sm 0 1 2, .md 0 4 12, .lg 0 12 32
  composer_shadow: Rgba;                              // zeron.composer.shadow, 0 12 32
  menu_shadow: Rgba;                                  // zeron.menu.shadow, 0 20 56
  dialog_shadow: Rgba;                                // zeron.dialog.shadow, 0 24 64
  danger: Rgba; warning: Rgba; success: Rgba; info: Rgba;
  // an agent's state (zeron.status): palette 400 steps
  connecting: Rgba; input: Rgba; approval: Rgba; plan: Rgba; done: Rgba; failed: Rgba; limited: Rgba;
}
ZD_TEXT :: 0xededef; ZD_ACCENT :: 0x9277b0;
zeron_dark :: () -> Theme {
  text := hex(ZD_TEXT, 1);
  return Theme.{
    shell = hex(0x0e0e10, 1), surface = hex(0x18181b, 1), border = hex(0xc7d2de, 0x17 / 255.0),
    text = text, muted = opacity(text, 0.6), faint = opacity(text, 0.42), disabled = opacity(text, 0.28),
    accent = hex(ZD_ACCENT, 1), accent_hover = hex(0x9e85bb, 1), accent_active = hex(0x83699f, 1),
    selection = hex(ZD_ACCENT, 89.0 / 255.0), focus_ring = hex(ZD_ACCENT, 0.6),
    bg = hex(0x0b0b0c, 1), claude = hex(0xd97757, 1),
    line = rgba(1, 1, 1, 0x12 / 255.0), line_subtle = rgba(1, 1, 1, 0x0a / 255.0), line_strong = rgba(1, 1, 1, 0x2e / 255.0),
    hover = rgba(1, 1, 1, 0x0d / 255.0), pressed = rgba(1, 1, 1, 0x17 / 255.0), selected = rgba(1, 1, 1, 0x1a / 255.0),
    raised = rgba(1, 1, 1, 0x0f / 255.0), base = rgba(1, 1, 1, 0x08 / 255.0),
    sidebar = hex(0xebebeb, 0x0d / 255.0), row_selected = hex(0xebebeb, 0x24 / 255.0),
    primary = hex(0xececee, 1), primary_hover = hex(0xffffff, 1), primary_active = hex(0xd2d2d7, 1),
    secondary = rgba(1, 1, 1, 0x14 / 255.0), secondary_hover = rgba(1, 1, 1, 0x1f / 255.0),
    menu = hex(0x1c1c1f, 1), menu_selected = hex(0xebebeb, 0x17 / 255.0), popover = hex(0x2a2a2f, 1),
    composer_tint = hex(0x080808, 0x26 / 255.0),
    shadow_sm = rgba(0, 0, 0, 0x59 / 255.0), shadow_md = rgba(0, 0, 0, 0x66 / 255.0), shadow_lg = rgba(0, 0, 0, 0x80 / 255.0),
    composer_shadow = rgba(0, 0, 0, 0x66 / 255.0), menu_shadow = rgba(0, 0, 0, 0x52 / 255.0), dialog_shadow = rgba(0, 0, 0, 0x80 / 255.0),
    danger = hex(DANGER, 1), warning = hex(WARNING, 1), success = hex(SUCCESS, 1), info = hex(0x60a5fa, 1),
    connecting = hex(0x74acfe, 1), input = hex(0x93a3fe, 1), approval = hex(0xe9a64b, 1), plan = hex(0xad98fe, 1),
    done = hex(0x5dc496, 1), failed = hex(0xf9837b, 1), limited = hex(0xf4925e, 1)};
}
// Zeron's shadows (shadow.*, zeron.composer.shadow, zeron.menu.shadow, zeron.dialog.shadow): how far down and how soft.
ZD_SHADOW_SM :: [2] f32.[1, 2]; ZD_SHADOW_MD :: [2] f32.[4, 12]; ZD_SHADOW_LG :: [2] f32.[12, 32];
ZD_SHADOW_MENU :: [2] f32.[20, 56]; ZD_SHADOW_DIALOG :: [2] f32.[24, 64];
// The skin's shadow tokens (skin.coax UiShadows) from the theme: offset, CSS blur and colour.
zeron_shadows :: (th: Theme) -> UiShadows {
  t := UiShadows.{};
  t.sm = UiShadow.{dy = ZD_SHADOW_SM[0], blur = ZD_SHADOW_SM[1], color = th.shadow_sm};
  t.md = UiShadow.{dy = ZD_SHADOW_MD[0], blur = ZD_SHADOW_MD[1], color = th.shadow_md};
  t.lg = UiShadow.{dy = ZD_SHADOW_LG[0], blur = ZD_SHADOW_LG[1], color = th.shadow_lg};
  t.composer = UiShadow.{dy = ZD_SHADOW_LG[0], blur = ZD_SHADOW_LG[1], color = th.composer_shadow};
  t.menu = UiShadow.{dy = ZD_SHADOW_MENU[0], blur = ZD_SHADOW_MENU[1], color = th.menu_shadow};
  t.dialog = UiShadow.{dy = ZD_SHADOW_DIALOG[0], blur = ZD_SHADOW_DIALOG[1], color = th.dialog_shadow};
  return t;
}
#test "Zeron's skin takes its shadow tokens from the theme, and they match the skin's defaults" {
  k := zeron_skin(); d := UiShadows.{};
  #assert k.shadows.menu.dy == 20 && k.shadows.menu.blur == 56 && k.shadows.composer.blur == 32 && k.shadows.dialog.dy == 24;
  #assert abs(k.shadows.menu.color.a - d.menu.color.a) < 0.002 && abs(k.shadows.sm.color.a - d.sm.color.a) < 0.002 && abs(k.shadows.lg.color.a - d.lg.color.a) < 0.002;
}

// A chip hovered or with its menu open (Zeron Dark element_hover).
CHIP_WASH :: Rgba.{r = 1, g = 1, b = 1, a = 0.11};
// The working spinner's rows (loaders.rs).
GSPIN_TINTS :: [3] int.[0xB6D3EF, 0xEDB185, 0xF888A0];
// Zeron's own washes: white ink and the near-white wash at an alpha.
ink :: (a: f32) -> Rgba { return rgba(1, 1, 1, a); }
// zeron_theme keeps a color's alpha as a byte: opacity(0.055) is 14/255.
byte_alpha :: (c: Rgba, a: f32) -> Rgba { return opacity(c, floor(a * 255 + 0.5) / 255); }
wash :: (a: f32) -> Rgba { return rgba(0.92, 0.92, 0.92, a); }
DANGER :: 0xf87171; SUCCESS :: 0x34d399;
DANGER_MUTED :: 0xfca5a5; WARNING :: 0xfacc15; WARNING_MUTED :: 0xfde68a;

// Zeron Dark's code colours, by role (zeron.syntax): palette 300 steps for words, the text's own ink
// fainter for comments and punctuation, red 400 for what is invalid.
SYNTAX_DARK :: [12] int.[ZD_TEXT, 0xc6bbfe, 0x9edaa5, 0xffb58f, 0xf5c283, 0xa3c8fe, 0xffced3, 0xfaa9cf, ZD_TEXT, 0xffada6, 0xe6d288, 0xf9837b];
SYNTAX_DARK_ALPHA :: [12] f32.[0.46, 1, 1, 1, 1, 1, 1, 1, 0.5, 1, 1, 1];


