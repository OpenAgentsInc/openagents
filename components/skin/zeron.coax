// The spinner's pulse (loaders.rs): a cell's opacity at phase p, falling
// from full to dim, resting, then rising back.
gspin_opacity :: (p: f32, dim: f32) -> f32 {
  q := p - floor(p);
  if q < 0.45 { return 1 + (dim - 1) * (q / 0.45); }
  if q < 0.92 { return dim; }
  return dim + (1 - dim) * ((q - 0.92) / 0.08);
}
// A cell's opacity in the 3x3 spinner at phase (turns): the pulse rises
// from the bottom edge to the top-centre cell, a quarter turn a step.
gspin_cell :: (phase: f32, row: int, col: int, dim: f32) -> f32 {
  dist := 2.0f32 - cast(f32) row + abs(cast(f32) col - 1);
  return gspin_opacity(phase + dist / 4, dim);
}

// Zeron's transcript measures.
zeron_transcript :: () -> UiTranscript {
  return UiTranscript.{
    titlebar = TITLEBAR_HEIGHT, fade_band = TRANSCRIPT_FADE_BAND, status_strip = STATUS_STRIP_HEIGHT,
    column = TRANSCRIPT_WIDTH, row_pad_x = ROW_PAD_X,
    gap = SPACE_SM, gap_turn = SPACE_LG, gap_group = SPACE_MD, gap_first = 10, lane = TIMESTAMP_LANE, cull = 4,
    bubble_share = 0.8, bubble_radius = BUBBLE_RADIUS, bubble_pad_x = BUBBLE_PAD_X, bubble_pad_y = BUBBLE_PAD_Y,
    notice_pad = NOTICE_PAD, notice_py = NOTICE_PY, notice_gap = NOTICE_GAP, notice_tile = NOTICE_TILE, notice_line = NOTICE_LINE,
    notice_radius = 10, notice_tile_radius = 6, notice_icon = 12, notice_icon_inset = 4, notice_label_gap = 8,
    notice_button_h = NOTICE_BUTTON_H, notice_button_pad = 10, notice_button_py = 4, notice_button_gap = 8, notice_actions_gap = 2,
    notice_wash = 0.1, notice_tile_wash = 0.12, notice_ink = 0.8, notice_button_wash = 0.14, notice_button_hover = 0.22,
    meta_line = 18, stop_icon = 11, stop_dy = 3, stop_gap = 8,
    work_top = WORK_TOP, work_line = WORK_HEIGHT,
    spin_cell = GSPIN_CELL, spin_pitch = 1.5 * GSPIN_CELL, spin_side = 3 * GSPIN_CELL + 2 * (GSPIN_CELL / 2), spin_period = GSPIN_PERIOD, spin_dim = GSPIN_DIM,
    group_header = TOOL_GROUP_HEADER_HEIGHT, group_chevron = 14, group_chevron_dx = 7, group_chevron_box = 18, group_chevron_dy = 2, group_summary_x = 22 + 6,
    label_line = TOOL_LABEL_LINE_HEIGHT, chips_top = CHIPS_TOP_PAD, tree_row = TOOL_TREE_ROW_HEIGHT, chip_card = CHIP_CARD_HEIGHT,
    trunk_x = ACTIVITY_TRUNK_X, bend = ACTIVITY_BEND_RADIUS, branch_end = ACTIVITY_BRANCH_END_X, icon_left = ACTIVITY_ICON_LEFT,
    icon = ACTIVITY_ICON_SIZE, gutter = ACTIVITY_GUTTER_WIDTH, text_gap = ACTIVITY_TEXT_GAP,
    chip_gap = 8, chevron_room = 18, chevron = 12, chevron_inset = 3,
    badge_h = 22, badge_radius = 5, badge_well = 20, badge_well_radius = 4, badge_icon = 14, badge_icon_inset = 3, badge_pad = 6, badge_edge = 1,
    file_ink = 0.85,
    separator = DETAIL_SEPARATOR, output_line = OUTPUT_LINE_HEIGHT, output_py = 6, output_pad = OUTPUT_BODY_PAD,
    hunk_header = HUNK_HEADER_HEIGHT, diff_line = DIFF_LINE_HEIGHT, body_bottom = BODY_BOTTOM_PAD,
    diff_gutter = GUTTER_WIDTH, diff_digit = 6.6, gutter_pad_l = 8, gutter_pad_r = 6, number_inset = 8,
    marker = MARKER_WIDTH, accent_bar = ACCENT_BAR_WIDTH, code_pad_l = UNIFIED_CODE_PADDING_LEFT,
    marker_ink = 0.5, number_ink = 0.8, changed_ink = 0.9, code_ink = 0.92};
}


zeron_syntax :: (role: int, plain: Rgba) -> Rgba {
  if role < 0 || role > 11 { return plain; }
  palette := SYNTAX_DARK;
  return hex(palette[role], 1);
}

zeron_skin :: () -> UiSkin {
  th := zeron_dark();
  s := UiSkin.{id = UISKIN_ZERON, name = "zeron",
    canvas = th.shell, surface = th.surface, raised = wash(0.08), sunk = ink(0.035), hairline = ink(0.10), hover = ink(0.08),
    ink = th.text, muted = th.muted, faint = th.faint,
    accent = th.accent, on_accent = th.bg, selection = th.selection,
    danger = hex(DANGER, 1), warning = hex(WARNING, 1), success = hex(SUCCESS, 1),
    code_wash = opacity(th.accent, 56.0 / 255.0), quote_wash = opacity(th.accent, 0.05), quote_rail = opacity(th.accent, 0.6),
    header_wash = ink(0.02),
    body = UiType.{face = FONT_INPUT, size = 14, line = MD_LINE_HEIGHT},
    strong = UiType.{face = FONT_BOLD, size = 14, line = MD_LINE_HEIGHT},
    code = UiType.{face = FONT_MONO_14, size = 14, line = MD_LINE_HEIGHT},
    mono = UiType.{face = FONT_CODE, size = 12.5, line = CODE_LINE_HEIGHT},
    small = UiType.{face = FONT_SMALL, size = 11, line = 11 * PHI},
    label = UiType.{face = FONT_CHIP, size = 12, line = 12 * PHI},
    title = UiType.{face = FONT_BOLD, size = 14, line = MD_LINE_HEIGHT},
    tool = UiType.{face = FONT_TOOL, size = 12, line = 12 * PHI},
    mono_small = UiType.{face = FONT_MONO_12, size = 12, line = 12 * PHI},
    mono_tiny = UiType.{face = FONT_MONO_11, size = 11, line = 11 * PHI},
    menu = UiType.{face = FONT_MENU, size = 13, line = 13 * PHI},
    menu_small = UiType.{face = FONT_MENU_SMALL, size = 11, line = 11 * PHI},
    search = UiType.{face = FONT_SEARCH, size = 14, line = 14 * PHI},
    chip = ink(0.06), well = rgba(0, 0, 0, 0.16), rail = ink(0.12),
    hunk_wash = byte_alpha(th.accent, 0.08),
    add_wash = byte_alpha(hex(SUCCESS, 1), 0.055), add_bar = byte_alpha(hex(SUCCESS, 1), 0.55),
    del_wash = byte_alpha(hex(DANGER, 1), 0.055), del_bar = byte_alpha(hex(DANGER, 1), 0.55),
    danger_muted = hex(DANGER_MUTED, 1), warning_muted = hex(WARNING_MUTED, 1),
    file_tint = hex(0xfb923c, 1),
    space = 8, pad = 16, radius = 12, radius_control = 8, border = 1, control_h = 32, control_pad = 12,
    slider_track = 4, knob = 14, bar_h = 8,   // a 32px control's eighth, 0.44 of it rounded, its quarter
    frame = UIFRAME_PLATE, frame_mid = ink(0.10), frame_light = ink(0.16), trim = th.accent,
    shadow = 15, shade = rgba(0, 0, 0, 0.35), stud = 0,
    icon_copy = ICON_COPY, icon_wrap = ICON_WRAP, icon_chevron = ICON_CHEVRON, icon_check = ICON_CHECK,
    md = UiMarkdown.{line = MD_LINE_HEIGHT, block_gap = MD_BLOCK_GAP, item_gap = LIST_ITEM_GAP,
      marker_w = LIST_MARKER_W, marker_gap = LIST_MARKER_GAP, disc = LIST_DISC,
      quote_rail = QUOTE_RAIL, quote_pad_l = QUOTE_PAD_L, quote_pad_r = QUOTE_PAD_R, quote_pad_y = QUOTE_PAD_Y, quote_gap = QUOTE_GAP,
      code_pad_x = INLINE_CODE_PAD_X, code_inset_y = INLINE_CODE_INSET_Y, code_radius = INLINE_CODE_RADIUS,
      block_radius = CODE_RADIUS, block_border = 1, block_header = CODE_HEADER_HEIGHT,
      block_pad_x = CODE_PADDING_X, block_pad_y = CODE_PADDING_Y, block_line = CODE_LINE_HEIGHT, action = CODE_ACTION_SIZE,
      action_gap = 2, action_edge = 5, wrap_radius = 6, copy_radius = 5, wrap_icon = 13, copy_icon = 12, copy_icon_x = 6,
      task = LIST_DISC * 2 + 4, task_radius = 3,
      cell_pad = TABLE_CELL_PADDING, cell_pad_y = TABLE_CELL_PADDING, divider = TABLE_DIVIDER, col_min_content = TABLE_MIN_COLUMN_CONTENT, col_min = TABLE_MIN_COLUMN_WIDTH,
      bullet = "•", task_open = "☐", task_done = "☑"}};
  palette := SYNTAX_DARK;
  for k: 0..<UISKIN_SYNTAX { s.syntax[k] = hex(palette[k], 1); }
  tints := GSPIN_TINTS;
  for k: 0..<3 { s.spinner[k] = hex(tints[k], 1); }
  s.tr = zeron_transcript(); s.cmp = zeron_composer(); s.menus = zeron_menus(); s.desk = zeron_desk();
  s.lifted = UiFloat.{dy = [2] f32.[10, 4], blur = [2] f32.[15, 6], spread = [2] f32.[-3, -4]};   // Tailwind's shadow-lg
  // the composer and its menus (composer.rs, pickers.rs, glass.rs)
  s.doc_tint = rgba(0.796, 0.835, 0.882, 1);   // the file theme's dark tint, #CBD5E1
  s.clear = rgba(0, 0, 0, 0);
  s.sidebar = th.bg; s.action_hover = ink(0.06); s.row_hover = ink(0.05); s.row_shown = ink(0.08); s.tab_hover = ink(0.04); s.accent_light = ink(0.12);
  s.brand = th.claude; s.field_edge = th.border; s.lift = rgba(0, 0, 0, 0.1); s.hover_chip = CHIP_WASH;
  s.menu_hover = ink(0.05); s.menu_selected = wash(0.11); s.menu_ring = ink(0.09);   // card_selected_bg, card_selected_shadows
  s.menu_rule = ink(0.08); s.menu_divider = ink(0.07); s.list_wash = ink(0.02);
  s.stop_on = ink(0.4);
  s.track = UiPlate.{top = ink(0.08), bottom = ink(0.05), rim = ink(0.09), inset = ink(0.07), inset_dy = 1, drop = rgba(0, 0, 0, 0.16), drop_dy = 1, drop_blur = 2};
  s.thumb = UiPlate.{top = ink(1), bottom = rgba(0.965, 0.965, 0.965, 1), rim = rgba(0, 0, 0, 0.12), inset = ink(0.8), inset_dy = 1, drop = rgba(0, 0, 0, 0.22), drop_dy = 1, drop_blur = 2};
  s.switch_shade = rgba(0, 0, 0, 0.14); s.switch_wash = ink(0.18); s.switch_rim = ink(0.12);
  s.switch_mark = ink(0.96); s.switch_ring = ink(0.92); s.switch_knob = ink(0.96); s.switch_knob_rim = rgba(0, 0, 0, 0.10);
  s.hud = zeron_hud();
  return s;
}

#test "the Zeron skin is Zeron Dark: its roles, faces and Markdown measures" {
  s := zeron_skin();
  #assert s.id == UISKIN_ZERON && s.name == "zeron" && s.frame == UIFRAME_PLATE;
  #assert s.ink.r == hex(0xe8e8ea, 1).r && s.accent.b == hex(0x8b7cf6, 1).b && s.canvas.r == hex(0x0d0d0d, 1).r;
  #assert s.body.face == FONT_INPUT && s.strong.face == FONT_BOLD && s.code.face == FONT_MONO_14 && s.mono.face == FONT_CODE;
  f := uiskin_faces(s);
  #assert f.plain == FONT_INPUT && f.bold == FONT_BOLD && f.code == FONT_MONO_14;
  #assert s.md.line == 22 && s.md.block_line == 18 && s.md.marker_w + s.md.marker_gap == 26 && s.md.cell_pad == 12;
  #assert uiskin_syntax(s, 1, s.ink).r == hex(0x8b7cf6, 1).r && uiskin_syntax(s, -1, s.ink).r == s.ink.r;
  #assert s.syntax[0].r == zeron_syntax(0, s.ink).r;
}
