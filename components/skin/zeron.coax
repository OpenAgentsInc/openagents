    caret = 2, caret_blink = CARET_BLINK, underline = 0.618, model_ink = 0.9, effort_ink = 0.7,
    compact_h = COMPACT_TOTAL_HEIGHT, compact_inset = COMPACT_INSET, compact_text_pad = COMPACT_TEXT_PAD};
}

