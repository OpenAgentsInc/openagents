// The desktop app's sidebar, tabs and room (Zeron's compact sidebar).
zeron_desk :: () -> UiDesk {
  return UiDesk.{side_min = 208, side_max = 400, side = 256, top = 4, pad = 8,
    row = 29,            // a session row (Zeron's compact sidebar row)
    gap = 2,             // between rows (SIDEBAR_LIST_GAP)
    header = 28,         // a folder's header (SIDEBAR_DISCLOSURE_HEADER_HEIGHT)
    section_gap = 12, row_radius = 6, inset = 8, icon = 14, icon_gap = 8,
    mark = 13,           // a harness mark (SIDEBAR_ACTIVE_HARNESS_ICON_SIZE)
    dot = 6, dot_gap = 8, idle_ink = 0.5, edge = 4, lights = 80,
    tab_h = 28, tab_min = 96, tab_max = 200, tab_gap = 4, tab_pad = 10,
    room_pad = 10, room_unseen = 14, room_gap = 8, chat_min = 320,
    room_col = TRANSCRIPT_WIDTH, room_line = 20, room_head = 22, room_foot = 18,
    room_margin = 64, room_top = 8, room_bottom = 24, room_cull = 200, room_mark_dy = 4, room_mark_gap = 6};
}

// The chat screen's status strip, failure notice and dictation button.
zeron_chrome :: () -> UiChrome {
  c := UiChrome.{status_top = 8, status_x = 16, status_dot = 6, status_gap = 8, idle_ink = 0.5,
    failure_mx = 4, failure_gap = 6, mic = 28, mic_gap = 4, mic_label_gap = 8, mic_wash = 0.15,
    button_h = 28, primary_h = 32, primary_pad = 14, primary_ink = 0.9,
    field_h = 40, field_radius = 10, field_pad = 12, field_caret = 18, field_focus = 0.6};
  // the microphone: capsule, lower cradle (the well's ground over the capsule's foot), stem and base
  c.mic_parts[0] = UiChromeBox.{x = 7, y = 10, w = 14, h = 11, radius = 7, border = 1.5, paint = UICHROME_STROKE};
  c.mic_parts[1] = UiChromeBox.{x = 6, y = 8, w = 16, h = 7, paint = UICHROME_MASK};
  c.mic_parts[2] = UiChromeBox.{x = 10, y = 4, w = 8, h = 14, radius = 4, border = 1.5, paint = UICHROME_STROKE};
  c.mic_parts[3] = UiChromeBox.{x = 13.25, y = 21, w = 1.5, h = 3, paint = UICHROME_FILL};
  c.mic_parts[4] = UiChromeBox.{x = 9, y = 24, w = 10, h = 1.5, paint = UICHROME_FILL};
  return c;
}

zeron_menus :: () -> UiMenus {
  return UiMenus.{card_radius = CARD_RADIUS, card_inset = CARD_INSET, card_borders = CARD_BORDERS,
    gap = MENU_GAP, item_radius = MENU_ITEM_RADIUS, offset = MENU_OFFSET, margin = MENU_MARGIN, most = MENU_MAX, room = MENU_ROOM, below_min = 180,
    pad_x = 8,
    width = COMPACT_WIDTH, header = HEADER_HEIGHT, header_single = HEADER_HEIGHT_SINGLE,
    title_line = 17, name_line = 15, title_chevron_room = 13, chevron = 10, chevron_gap = 3, chevron_shift = 3,
    title_chevron_dy = (17 - 10) / 2, name_chevron_dy = (15 - 10) / 2, chevron_ink = 0.55,   // whole pixels, as Zeron's integer arithmetic set them
    slider_top = SLIDER_TOP, slider = SLIDER_HEIGHT, slider_bottom = SLIDER_BOTTOM,
    rail = RAIL_HEIGHT, rail_top = RAIL_TOP, fill_past = FILL_PAST,
    thumb_w = THUMB_WIDTH, thumb_h = THUMB_HEIGHT, thumb_inset = THUMB_INSET,
    stop = 4, stop_radius = 2, stop_off_ink = 0.28,
    row = COMPACT_ROW_HEIGHT, list_header = LIST_HEADER, tab_icon = 16, tab_ink = 0.7,
    search_row = SEARCH_ROW_HEIGHT, search_icon = 14, search_icon_x = 10, search_gap = 8,
    search_text_dy = 7.5,   // the input's line box in the 39px row above the hairline, as Zeron lays it (measured)
    search_line = INPUT_LINE_HEIGHT, caret = 2,
    row_icon = 14, row_gap = 8, star_inset = 4, star = 28, detail_gap = 6, detail_min = 12,
    access_width = ACCESS_WIDTH, line = MENU_LINE, desc_line = MENU_DESC_LINE, row_py = 6, check = 14, check_gap = 10, label_ink = 0.9,
    switch_w = SWITCH_WIDTH, switch_h = SWITCH_HEIGHT, switch_track = SWITCH_TRACK_HEIGHT, switch_inset = SWITCH_SIDE_INSET,
    switch_knob = SWITCH_THUMB_WIDTH, switch_mark = SWITCH_MARK_SIZE, switch_gap = 10,
    switch_track_dy = (SWITCH_HEIGHT - SWITCH_TRACK_HEIGHT) / 2, switch_empty = SWITCH_WIDTH - SWITCH_THUMB_WIDTH - SWITCH_SIDE_INSET,
    switch_mark_dy = (SWITCH_TRACK_HEIGHT - SWITCH_MARK_SIZE) / 2, switch_knob_h = SWITCH_TRACK_HEIGHT - 2 * SWITCH_SIDE_INSET,
    switch_travel = SWITCH_WIDTH - SWITCH_THUMB_WIDTH - 2 * SWITCH_SIDE_INSET,
    bar_w = 1.2, bar_h = 7.2, bar_radius = 0.6, bar_dx = (SWITCH_MARK_SIZE - 1.2) / 2,
    ring_in = 0.4, ring = 6.4, ring_radius = 3.2};
}

// The spinner's pulse (loaders.rs): a cell's opacity at phase p, falling
// from full to dim, resting, then rising back.
gspin_opacity :: (p: f32, dim: f32) -> f32 {
  q := p - floor(p);
  if q < 0.45 { return 1 + (dim - 1) * (q / 0.45); }
  if q < 0.92 { return dim; }
  return dim + (1 - dim) * ((q - 0.92) / 0.08);
}
// A cell's opacity in the 3x3 spinner at phase (turns): the pulse rises
// from the bottom edge to the top-centre cell, a quarter turn a step.
gspin_cell :: (phase: f32, row: int, col: int, dim: f32) -> f32 {
  dist := 2.0f32 - cast(f32) row + abs(cast(f32) col - 1);
  return gspin_opacity(phase + dist / 4, dim);
}

// Zeron's transcript measures.
zeron_transcript :: () -> UiTranscript {
  return UiTranscript.{
    titlebar = TITLEBAR_HEIGHT, fade_band = TRANSCRIPT_FADE_BAND, status_strip = STATUS_STRIP_HEIGHT,
    column = TRANSCRIPT_WIDTH, row_pad_x = ROW_PAD_X,
    gap = SPACE_SM, gap_turn = SPACE_LG, gap_group = SPACE_MD, gap_first = 10, lane = TIMESTAMP_LANE, cull = 4,
    bubble_share = 0.8, bubble_radius = BUBBLE_RADIUS, bubble_pad_x = BUBBLE_PAD_X, bubble_pad_y = BUBBLE_PAD_Y,
    notice_pad = NOTICE_PAD, notice_py = NOTICE_PY, notice_gap = NOTICE_GAP, notice_tile = NOTICE_TILE, notice_line = NOTICE_LINE,
    notice_radius = 10, notice_tile_radius = 6, notice_icon = 12, notice_icon_inset = 4, notice_label_gap = 8,
    notice_button_h = NOTICE_BUTTON_H, notice_button_pad = 10, notice_button_py = 4, notice_button_gap = 8, notice_actions_gap = 2,
    notice_wash = 0.1, notice_tile_wash = 0.12, notice_ink = 0.8, notice_button_wash = 0.14, notice_button_hover = 0.22,
    meta_line = 18, stop_icon = 11, stop_dy = 3, stop_gap = 8,
    work_top = WORK_TOP, work_line = WORK_HEIGHT,
    spin_cell = GSPIN_CELL, spin_pitch = 1.5 * GSPIN_CELL, spin_side = 3 * GSPIN_CELL + 2 * (GSPIN_CELL / 2), spin_period = GSPIN_PERIOD, spin_dim = GSPIN_DIM,
    group_header = TOOL_GROUP_HEADER_HEIGHT, group_chevron = 14, group_chevron_dx = 7, group_chevron_box = 18, group_chevron_dy = 2, group_summary_x = 22 + 6,
    label_line = TOOL_LABEL_LINE_HEIGHT, chips_top = CHIPS_TOP_PAD, tree_row = TOOL_TREE_ROW_HEIGHT, chip_card = CHIP_CARD_HEIGHT,
    trunk_x = ACTIVITY_TRUNK_X, bend = ACTIVITY_BEND_RADIUS, branch_end = ACTIVITY_BRANCH_END_X, icon_left = ACTIVITY_ICON_LEFT,
    icon = ACTIVITY_ICON_SIZE, gutter = ACTIVITY_GUTTER_WIDTH, text_gap = ACTIVITY_TEXT_GAP,
    chip_gap = 8, chevron_room = 18, chevron = 12, chevron_inset = 3,
    badge_h = 22, badge_radius = 5, badge_well = 20, badge_well_radius = 4, badge_icon = 14, badge_icon_inset = 3, badge_pad = 6, badge_edge = 1,
    file_ink = 0.85,
    separator = DETAIL_SEPARATOR, output_line = OUTPUT_LINE_HEIGHT, output_py = 6, output_pad = OUTPUT_BODY_PAD,
    hunk_header = HUNK_HEADER_HEIGHT, diff_line = DIFF_LINE_HEIGHT, body_bottom = BODY_BOTTOM_PAD,
    diff_gutter = GUTTER_WIDTH, diff_digit = 6.6, gutter_pad_l = 8, gutter_pad_r = 6, number_inset = 8,
    marker = MARKER_WIDTH, accent_bar = ACCENT_BAR_WIDTH, code_pad_l = UNIFIED_CODE_PADDING_LEFT,
    marker_ink = 0.5, number_ink = 0.8, changed_ink = 0.9, code_ink = 0.92};
}


zeron_syntax :: (role: int, plain: Rgba) -> Rgba {
  if role < 0 || role > 11 { return plain; }
  palette := SYNTAX_DARK; alpha := SYNTAX_DARK_ALPHA;
  return hex(palette[role], alpha[role]);
}

// Zeron's settings screen, dark (ds/settings.luau, ds/account_row.luau, ds/tokens.luau, themes/zeron-dark.json), in points.
zeron_settings :: () -> UiSettings { return zeron_settings_from(zeron_dark()); }
// The settings screen on any theme of Zeron's shape (Coder Noir's, noir.coax): Zeron's measures, the theme's colours.
zeron_settings_from :: (th: Theme) -> UiSettings {
  return UiSettings.{
    title_face = FONT_SET_TITLE, title_line = 26,
    text_face = FONT_MENU, text_line = 18, page_line = 20,   // (the atlas has no Geist 13 regular: a 1x skin reads it in the medium)
    name_face = FONT_MENU, name_line = 18,
    desc_face = FONT_SET_DESC, desc_line = 16,
    head_face = FONT_SET_HEAD, head_line = 14,
    strip = TITLEBAR_HEIGHT, list_pad = 8, list_gap = 2,          // zeron.list.gap
    heading = 24, heading_pad = 8,                                // zeron.menu.heading, space.2
    row = 28, row_pad = 8, row_gap = 8, row_radius = 6,           // zeron.menu.row, space.2, radius.md
    icon = 16, icon_dy = -0.5, edge = 1, handle = 6,
    search_h = 28, search_radius = 6, search_icon = 14, search_pad = 8, search_gap = 8,   // control sm
    key_h = 18, key_icon = 11, key_pad = 4, key_radius = 4, key_gap = 4,         // Kbd sm, a cap's space.1
    account = 30, avatar = 20, account_top = 4, toggle_radius = 8,
    measure = 640, page_pad = 32, page_top = 16, page_bottom = 64,   // zeron.settings.measure, space.6, space.4, space.8
    block_gap = 32, title_gap = 4, text_inset = 17, min_text = 180,
    aside_w = 180, aside_h = 252, aside_zoom = 0.6, aside_narrow = 620, caption_gap = 12,
    fade = 16,
    section_gap = 8, head_gap = 4, card_radius = 12, card_edge = 1,
    row_px = 16, row_py = 12, text_gap = 16, desc_gap = 2, control = 240,   // zeron.settings.control
    lead = 28, lead_radius = 8, lead_gap = 12, lead_icon = 16, chevron = 14, chevron_gap = 4,
    button_h = 32, button_pad = 12, button_radius = 8, small_h = 28, small_pad = 10, small_radius = 6, button_top = 8,
    text = th.text, secondary = th.muted, tertiary = th.faint,
    selected = th.row_selected, tint = hex(0xebebeb, 0x0b / 255.0),   // zeron.settings.tint
    subtle = th.line_subtle, strong = th.line_strong,
    hover = th.hover, pressed = th.pressed,
    well = th.secondary, well_hover = th.secondary_hover,
    field = rgba(0, 0, 0, 0x38 / 255.0), field_edge = rgba(1, 1, 1, 0x14 / 255.0),   // zeron.field.bg, .edge
    primary = th.primary, primary_hover = th.primary_hover, on_primary = th.bg,
    danger = th.danger};
}

zeron_skin :: () -> UiSkin { return zeron_skin_from(zeron_dark()); }
// Zeron's skin on any theme of Zeron's shape: its faces and measures, the theme's colours (Coder
// Noir wears it, noir.coax). Zeron Dark's own Markdown inks (diff washes, muted tiers, syntax,
// spinner) stay Zeron's here; a theme with its own sets them after.
zeron_skin_from :: (th: Theme) -> UiSkin {
  s := UiSkin.{id = UISKIN_ZERON, name = "zeron",
    canvas = th.shell, surface = th.surface, raised = th.raised, sunk = th.base, hairline = th.line, hover = th.hover,
    ink = th.text, muted = th.muted, faint = th.faint,
    accent = th.accent, on_accent = th.bg, selection = th.selection,
    danger = th.danger, warning = th.warning, success = th.success,
    code_wash = opacity(th.accent, 56.0 / 255.0), quote_wash = opacity(th.accent, 0.05), quote_rail = opacity(th.accent, 0.6),
    header_wash = ink(0.02),
    body = UiType.{face = FONT_INPUT, size = 14, line = MD_LINE_HEIGHT},
    strong = UiType.{face = FONT_BOLD, size = 14, line = MD_LINE_HEIGHT},
    code = UiType.{face = FONT_MONO_14, size = 14, line = MD_LINE_HEIGHT},
    mono = UiType.{face = FONT_CODE, size = 12.5, line = CODE_LINE_HEIGHT},
    small = UiType.{face = FONT_SMALL, size = 11, line = 11 * PHI},
    label = UiType.{face = FONT_CHIP, size = 12, line = 12 * PHI},
    title = UiType.{face = FONT_BOLD, size = 14, line = MD_LINE_HEIGHT},
    display = UiType.{face = FONT_DISPLAY, size = 24, line = 30},
    tool = UiType.{face = FONT_TOOL, size = 12, line = 12 * PHI},
    mono_small = UiType.{face = FONT_MONO_12, size = 12, line = 12 * PHI},
    mono_tiny = UiType.{face = FONT_MONO_11, size = 11, line = 11 * PHI},
    menu = UiType.{face = FONT_MENU, size = 13, line = 13 * PHI},
    menu_small = UiType.{face = FONT_MENU_SMALL, size = 11, line = 11 * PHI},
    search = UiType.{face = FONT_SEARCH, size = 14, line = 14 * PHI},
    chip = ink(0.06), well = rgba(0, 0, 0, 0.16), rail = ink(0.12),
    hunk_wash = byte_alpha(th.accent, 0.08),
    add_wash = byte_alpha(th.success, 0.055), add_bar = byte_alpha(th.success, 0.55),
    del_wash = byte_alpha(th.danger, 0.055), del_bar = byte_alpha(th.danger, 0.55),
    danger_muted = hex(DANGER_MUTED, 1), warning_muted = hex(WARNING_MUTED, 1),
    file_tint = hex(0xfb923c, 1),
    space = 8, pad = 16, radius = 12, radius_control = 8, border = 1, control_h = 32, control_pad = 12,
    slider_track = 4, knob = 14, bar_h = 8,   // a 32px control's eighth, 0.44 of it rounded, its quarter
    frame = UIFRAME_PLATE, frame_mid = ink(0.10), frame_light = ink(0.16), trim = th.accent,
    shadow = 15, shade = rgba(0, 0, 0, 0.35), stud = 0,
    icon_copy = ICON_COPY, icon_wrap = ICON_WRAP, icon_chevron = ICON_CHEVRON, icon_check = ICON_CHECK,
    md = UiMarkdown.{line = MD_LINE_HEIGHT, block_gap = MD_BLOCK_GAP, item_gap = LIST_ITEM_GAP,
      marker_w = LIST_MARKER_W, marker_gap = LIST_MARKER_GAP, disc = LIST_DISC,
      quote_rail = QUOTE_RAIL, quote_pad_l = QUOTE_PAD_L, quote_pad_r = QUOTE_PAD_R, quote_pad_y = QUOTE_PAD_Y, quote_gap = QUOTE_GAP,
      code_pad_x = INLINE_CODE_PAD_X, code_inset_y = INLINE_CODE_INSET_Y, code_radius = INLINE_CODE_RADIUS,
      block_radius = CODE_RADIUS, block_border = 1, block_header = CODE_HEADER_HEIGHT,
      block_pad_x = CODE_PADDING_X, block_pad_y = CODE_PADDING_Y, block_line = CODE_LINE_HEIGHT, action = CODE_ACTION_SIZE,
      action_gap = 2, action_edge = 5, wrap_radius = 6, copy_radius = 5, wrap_icon = 13, copy_icon = 12, copy_icon_x = 6,
      task = LIST_DISC * 2 + 4, task_radius = 3,
      cell_pad = TABLE_CELL_PADDING, cell_pad_y = TABLE_CELL_PADDING, divider = TABLE_DIVIDER, col_min_content = TABLE_MIN_COLUMN_CONTENT, col_min = TABLE_MIN_COLUMN_WIDTH,
      bullet = "•", task_open = "☐", task_done = "☑"}};
  for k: 0..<UISKIN_SYNTAX { s.syntax[k] = zeron_syntax(k, th.text); }
  tints := GSPIN_TINTS;
  for k: 0..<3 { s.spinner[k] = hex(tints[k], 1); }
  s.tr = zeron_transcript(); s.cmp = zeron_composer(); s.menus = zeron_menus(); s.desk = zeron_desk(); s.chrome = zeron_chrome();
  s.lifted = UiFloat.{dy = [2] f32.[10, 4], blur = [2] f32.[15, 6], spread = [2] f32.[-3, -4]};   // Tailwind's shadow-lg
  s.shadows = zeron_shadows(th);
  s.app.icon_alert = ICON_DANGER; s.app.icon_nav = ICON_SIDEBAR; s.app.icon_disclose = ICON_CHEVRON_RIGHT;   // the app set's marks (components/app/)
  // the composer and its menus (composer.rs, pickers.rs, glass.rs)
  s.doc_tint = rgba(0.796, 0.835, 0.882, 1);   // the file theme's dark tint, #CBD5E1
  s.clear = rgba(0, 0, 0, 0);
  s.sidebar = th.sidebar; s.action_hover = ink(0.06); s.row_hover = ink(0.05); s.row_shown = ink(0.08); s.tab_hover = ink(0.04); s.accent_light = ink(0.12);
  s.brand = th.claude; s.field_edge = th.border; s.lift = rgba(0, 0, 0, 0.1); s.hover_chip = CHIP_WASH;
  s.menu_hover = ink(0.05); s.menu_selected = th.menu_selected; s.menu_ring = ink(0.09);   // card_selected_bg, card_selected_shadows
  s.menu_rule = ink(0.08); s.menu_divider = ink(0.07); s.list_wash = ink(0.02);
  s.stop_on = ink(0.4);
  s.track = UiPlate.{top = ink(0.08), bottom = ink(0.05), rim = ink(0.09), inset = ink(0.07), inset_dy = 1, drop = rgba(0, 0, 0, 0.16), drop_dy = 1, drop_blur = 2};
  s.thumb = UiPlate.{top = ink(1), bottom = rgba(0.965, 0.965, 0.965, 1), rim = rgba(0, 0, 0, 0.12), inset = ink(0.8), inset_dy = 1, drop = rgba(0, 0, 0, 0.22), drop_dy = 1, drop_blur = 2};
  s.switch_shade = rgba(0, 0, 0, 0.14); s.switch_wash = ink(0.18); s.switch_rim = ink(0.12);
  s.switch_mark = ink(0.96); s.switch_ring = ink(0.92); s.switch_knob = ink(0.96); s.switch_knob_rim = rgba(0, 0, 0, 0.10);
  s.hud = zeron_hud();
  s.set = zeron_settings_from(th);
  return s;
}

#test "the Zeron skin is Zeron Dark: its roles, faces and Markdown measures" {
  s := zeron_skin();
  #assert s.id == UISKIN_ZERON && s.name == "zeron" && s.frame == UIFRAME_PLATE;
  // zgx's zeron-dark.json: window, text and its tiers, accent, borders, washes, warning, the primary button, composer, menus
  #assert s.ink.r == hex(0xededef, 1).r && s.accent.b == hex(0x9277b0, 1).b && s.canvas.r == hex(0x0e0e10, 1).r;
  #assert s.muted.a == 0.6 && s.faint.a == 0.42 && zeron_dark().disabled.a == 0.28 && s.muted.r == s.ink.r;
  #assert abs(s.hairline.a - 0x12 / 255.0) < 0.0001 && abs(s.hover.a - 0x0d / 255.0) < 0.0001 && abs(s.raised.a - 0x0f / 255.0) < 0.0001;
  #assert s.warning.g == hex(0xfacc15, 1).g && s.surface.r == hex(0x18181b, 1).r && abs(s.field_edge.a - 0x17 / 255.0) < 0.0001;
  th := zeron_dark();
  #assert th.primary.r == hex(0xececee, 1).r && th.primary_active.b == hex(0xd2d2d7, 1).b && th.bg.r == hex(0x0b0b0c, 1).r;
  #assert th.menu.r == hex(0x1c1c1f, 1).r && th.popover.r == hex(0x2a2a2f, 1).r && abs(th.line_strong.a - 0x2e / 255.0) < 0.0001;
  #assert s.set.text.r == th.text.r && s.set.primary.r == th.primary.r && s.set.selected.a == th.row_selected.a;
  #assert s.body.face == FONT_INPUT && s.strong.face == FONT_BOLD && s.code.face == FONT_MONO_14 && s.mono.face == FONT_CODE;
  f := uiskin_faces(s);
  #assert f.plain == FONT_INPUT && f.bold == FONT_BOLD && f.code == FONT_MONO_14;
  #assert s.md.line == 22 && s.md.block_line == 18 && s.md.marker_w + s.md.marker_gap == 26 && s.md.cell_pad == 12;
  #assert uiskin_syntax(s, 1, s.ink).r == hex(0xc6bbfe, 1).r && uiskin_syntax(s, -1, s.ink).r == s.ink.r && s.syntax[0].a == 0.46;
  #assert s.syntax[0].r == zeron_syntax(0, s.ink).r;
}
