// Coax UI Zero-Browser Story / Scene / Play Test Harness & Message Timeline Inspector (#14092):
// - Story: pure message-level update + emitted Command / Subscription assertions
// - Scene: in-memory Tree view + WAI-ARIA accessible role / label / text / visibility locators
// - Play:  multi-component deterministic flow runner with virtual TestClock & fake HTTP/SSE responder
// - Timeline: opt-in bounded Message log, dom_drive inspector formatter, and deterministic replay comparator
//   coax/bin/coax test components/ui/test_harness.coax --library
#load "runtime.coax";
#load "../backend/html.coax";

// ---- 1. Story (message-level Command & Subscription assertions)

st_expect_cmd :: (r: [] UiRuntime, owner: int, key: string, kind: int, url: string) -> bool {
  for i: 0..<UI_MAX_CMDS {
    c := r[0].cmds[i];
    if (c.state == UI_CS_PENDING || c.state == UI_CS_RUNNING) && c.owner == owner &&
       c.kind == kind && ui_eq(c.key[..], c.key_n, key) && ui_cmd_url(r, i) == url {
      return true;
    }
  }
  return false;
}

st_count_cmds :: (r: [] UiRuntime, owner: int) -> int {
  n := 0;
  for i: 0..<UI_MAX_CMDS {
    if r[0].cmds[i].state != UI_CS_FREE && r[0].cmds[i].owner == owner { n += 1; }
  }
  return n;
}

st_expect_sub :: (r: [] UiRuntime, owner: int, key: string, kind: int, url: string) -> bool {
  for s: 0..<UI_MAX_SUBS {
    sub := r[0].subs[s];
    if sub.active && sub.owner == owner && sub.kind == kind &&
       ui_eq(sub.key[..], sub.key_n, key) && ui_sub_url(r, s) == url {
      return true;
    }
  }
  return false;
}

// ---- 2. Scene (WAI-ARIA accessible locators over in-memory Tree)

sc_contains :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  if needle.count > hay.count { return false; }
  for i: 0..<hay.count - needle.count + 1 {
    if cast(string) hay[i..<i + needle.count] == needle { return true; }
  }
  return false;
}

sc_implicit_role :: (tag: int) -> string {
  if tag == TG_BUTTON { return "button"; }
  if tag == TG_A { return "link"; }
  if tag == TG_INPUT || tag == TG_TEXTAREA { return "textbox"; }
  if tag == TG_MAIN { return "main"; }
  if tag == TG_NAV { return "navigation"; }
  if tag == TG_H1 || tag == TG_H2 || tag == TG_H3 || tag == TG_H4 || tag == TG_H5 || tag == TG_H6 { return "heading"; }
  if tag == TG_UL || tag == TG_OL { return "list"; }
  if tag == TG_LI { return "listitem"; }
  if tag == TG_DIALOG { return "dialog"; }
  if tag == TG_TABLE { return "table"; }
  if tag == TG_HR { return "separator"; }
  return "";
}

sc_role_of :: (t: [] Tree, idx: int) -> string {
  if idx < 0 || idx >= t[0].n { return ""; }
  if tr_has(t, idx, AT_ROLE) { return tr_attr_of(t, idx, AT_ROLE); }
  return sc_implicit_role(t[0].nodes[idx].tag);
}

sc_is_visible :: (t: [] Tree, idx: int) -> bool {
  if idx < 0 || idx >= t[0].n { return false; }
  cur := idx;
  while cur >= 0 {
    if tr_has(t, cur, AT_HIDDEN) && tr_attr_of(t, cur, AT_HIDDEN) == "true" { return false; }
    cur = t[0].nodes[cur].parent;
  }
  return true;
}

sc_accessible_name :: (t: [] Tree, idx: int) -> string {
  if idx < 0 || idx >= t[0].n { return ""; }
  if tr_has(t, idx, AT_LABEL) { return tr_attr_of(t, idx, AT_LABEL); }
  if t[0].nodes[idx].has_text { return tr_text_of(t, idx); }
  if tr_has(t, idx, AT_PLACEHOLDER) { return tr_attr_of(t, idx, AT_PLACEHOLDER); }
  for c: idx + 1..<t[0].n {
    if t[0].nodes[c].parent == idx && t[0].nodes[c].has_text { return tr_text_of(t, c); }
  }
  return "";
}

sc_by_role :: (t: [] Tree, role: string, name: string) -> int {
  for i: 0..<t[0].n {
    if !sc_is_visible(t, i) { continue; }
    if sc_role_of(t, i) != role { continue; }
    if name.count == 0 || sc_accessible_name(t, i) == name { return i; }
  }
  return -1;
}

sc_by_label :: (t: [] Tree, label: string) -> int {
  for i: 0..<t[0].n {
    if !sc_is_visible(t, i) { continue; }
    if tr_has(t, i, AT_LABEL) && tr_attr_of(t, i, AT_LABEL) == label { return i; }
    if tr_has(t, i, AT_PLACEHOLDER) && tr_attr_of(t, i, AT_PLACEHOLDER) == label { return i; }
  }
  return -1;
}

sc_by_text :: (t: [] Tree, needle: string) -> int {
  for i: 0..<t[0].n {
    if !sc_is_visible(t, i) || !t[0].nodes[i].has_text { continue; }
    if sc_contains(tr_text_of(t, i), needle) { return i; }
  }
  return -1;
}

sc_count_role :: (t: [] Tree, role: string) -> int {
  n := 0;
  for i: 0..<t[0].n {
    if sc_is_visible(t, i) && sc_role_of(t, i) == role { n += 1; }
  }
  return n;
}

// ---- 3. Play (virtual TestClock + scripted HTTP & SSE responder)

PlClock :: struct { now_ms: int; }

pl_advance_ms :: (r: [] UiRuntime, clk: [] PlClock, delta_ms: int) -> int {
  if delta_ms > 0 { clk[0].now_ms += delta_ms; } // mutant: equivalent (adding 0 leaves now_ms unchanged)
  f1 := ui_cmd_tick(r, clk[0].now_ms);
  f2 := ui_sub_tick(r, clk[0].now_ms);
  return f1 + f2;
}

pl_cmd_respond :: (r: [] UiRuntime, owner: int, key: string, ok: bool, status: int, payload: string) -> bool {
  for i: 0..<UI_MAX_CMDS {
    c := r[0].cmds[i];
    if (c.state == UI_CS_PENDING || c.state == UI_CS_RUNNING) && c.owner == owner && ui_eq(c.key[..], c.key_n, key) {
      return ui_cmd_complete(r, c.run_id, ok, status, payload);
    }
  }
  return false;
}

pl_stream_find :: (r: [] UiRuntime, key: string) -> int {
  for s: 0..<UI_MAX_SUBS {
    if r[0].subs[s].active && ui_eq(r[0].subs[s].key[..], r[0].subs[s].key_n, key) { return s; }
  }
  return -1;
}

pl_stream_send :: (r: [] UiRuntime, slot: int, phase: int, status: int, payload: string) -> bool {
  return ui_sub_on_stream_event(r, UI_SUB_EVENT_BASE + slot * 4 + phase, status, payload);
}

pl_stream_open :: (r: [] UiRuntime, slot: int, status: int) -> bool {
  return pl_stream_send(r, slot, UI_SUB_PHASE_OPEN, status, "");
}

pl_stream_chunk :: (r: [] UiRuntime, slot: int, chunk: string) -> bool {
  return pl_stream_send(r, slot, UI_SUB_PHASE_CHUNK, 200, chunk);
}

pl_stream_end :: (r: [] UiRuntime, slot: int, status: int) -> bool {
  return pl_stream_send(r, slot, UI_SUB_PHASE_END, status, "");
}

pl_stream_error :: (r: [] UiRuntime, slot: int, status: int, detail: string) -> bool {
  return pl_stream_send(r, slot, UI_SUB_PHASE_ERROR, status, detail);
}

// ---- 4. Message Timeline, Replay Verifier & dom_drive Agent Inspector

UI_LOG_MAX :: 128;

UiLogEntry :: struct {
  step: int;
  now_ms: int;
  target: int;
  tag: int;
  arg_i: int;
  payload_h: int;
  state_h: int;
  cmd_count: int;
}

UiTimeline :: struct {
  enabled: bool;
  entries: [UI_LOG_MAX] UiLogEntry;
  count: int;
  total: int;
}

tl_enable :: (tl: [] UiTimeline) { tl[0].enabled = true; }
tl_clear :: (tl: [] UiTimeline) { tl[0].count = 0; tl[0].total = 0; }

tl_record :: (tl: [] UiTimeline, now_ms: int, target: int, tag: int, arg_i: int, payload: string, state_h: int, cmd_count: int) {
  if !tl[0].enabled { return; }
  idx := tl[0].total % UI_LOG_MAX;
  tl[0].entries[idx] = UiLogEntry.{
    step = tl[0].total,
    now_ms = now_ms,
    target = target,
    tag = tag,
    arg_i = arg_i,
    payload_h = tr_hash(payload),
    state_h = state_h,
    cmd_count = cmd_count
  };
  tl[0].total += 1;
  if tl[0].count < UI_LOG_MAX { tl[0].count += 1; }
}

// Compares two recorded message timelines step-by-step.
// Returns -1 when every step matches identically, or the 0-based index of the first divergent step.
tl_replay_compare :: (a: [] UiTimeline, b: [] UiTimeline) -> int {
  shared := ifx a[0].count < b[0].count then a[0].count else b[0].count; // mutant: equivalent (when equal, both branches return count)
  for i: 0..<shared {
    x := a[0].entries[i];
    y := b[0].entries[i];
    if x.target != y.target || x.tag != y.tag || x.arg_i != y.arg_i ||
       x.payload_h != y.payload_h || x.state_h != y.state_h || x.cmd_count != y.cmd_count {
      return i;
    }
  }
  if a[0].count != b[0].count { return shared; }
  return -1;
}

tl_put_int :: (b: [] HtBuf, v: int) {
  x := v;
  if x < 0 { ht_put_u8(b, '-'); x = -x; }
  digits: [20] u8; d := 0;
  if x == 0 { digits[0] = '0'; d = 1; }
  while x > 0 && d < digits.count { digits[d] = cast(u8) ('0' + x % 10); x /= 10; d += 1; } // mutant: equivalent (int has <= 19 decimal digits < 20)
  while d > 0 { d -= 1; ht_put_u8(b, digits[d]); }
}

tl_format_entry :: (b: [] HtBuf, e: UiLogEntry) {
  ht_put(b, "step="); tl_put_int(b, e.step);
  ht_put(b, " t="); tl_put_int(b, e.now_ms);
  ht_put(b, " target="); tl_put_int(b, e.target);
  ht_put(b, " tag="); tl_put_int(b, e.tag);
  ht_put(b, " arg="); tl_put_int(b, e.arg_i);
  ht_put(b, " state="); tl_put_int(b, e.state_h);
  ht_put(b, " cmds="); tl_put_int(b, e.cmd_count);
  ht_put_u8(b, '\n');
}

// Answers dom_drive inspector commands ("timeline count", "timeline dump").
tl_drive :: (tl: [] UiTimeline, op: string, out: [] u8) -> int {
  b := [1] HtBuf.[HtBuf.{bytes = out}];
  if op == "timeline count" {
    tl_put_int(b[..], tl[0].count);
    return ifx b[0].overflow then -1 else b[0].n;
  }
  if op == "timeline dump" {
    for i: 0..<tl[0].count { tl_format_entry(b[..], tl[0].entries[i]); }
    return ifx b[0].overflow then -1 else b[0].n;
  }
  return 0;
}

// ---- Zero-Browser Tests (Story, Scene, Play, SSR & Deterministic Replay)

#test "Story, Scene, Play, SSR and deterministic Timeline replay cover full streaming chat + reconnect with zero browser" {
  // Run the exact same streaming chat + reconnect scenario twice (run 0 clean, run 1 clean, run 2 with step-3 drift).
  timelines: [3] UiTimeline;
  last_tree: [1] Tree;
  for run: 0..<3 {
    rt: [1] UiRuntime; clk: [1] PlClock; tl := timelines[run..<run + 1];
    tl_enable(tl);
    composer := ui_mount(rt[..], "chat.composer", 1, -1, 0);
    transcript := ui_mount(rt[..], "chat.transcript", 2, -1, 0);
    draft: [64] u8; draft_n := 0;
    reply: [128] u8; reply_n := 0;
    streaming := false; reconnecting := false; reconnects := 0;
    drift_step := ifx run == 2 then 3 else -1;

    // 1. User types and submits prompt -> Story verifies POST /api/chat/turns emitted
    _ = ui_send(rt[..], composer, 1, 0, "Explain Coax UI");
    _ = ui_send(rt[..], composer, 2, 0, "");
    m: [1] UiMsg;
    while ui_take_msg(rt[..], m[..]) {
      p := ui_msg_payload(rt[..], m[0]);
      if m[0].tag == 1 { draft_n = ui_copy(draft[..], p); }
      else if m[0].tag == 2 {
        streaming = true;
        _ = ui_cmd_emit(rt[..], composer, "send-turn", UI_CMD_HTTP_POST, UI_CMD_SWITCH, "/api/chat/turns", cast(string) draft[0..<draft_n], 0, 3, 4, "");
      }
      sh := tr_hash(cast(string) draft[0..<draft_n]) + (ifx streaming then 1 else 0);
      tl_record(tl, clk[0].now_ms, m[0].target, m[0].tag, m[0].arg_i, p, sh, st_count_cmds(rt[..], m[0].target));
    }
    #assert st_expect_cmd(rt[..], composer, "send-turn", UI_CMD_HTTP_POST, "/api/chat/turns");
    #assert st_count_cmds(rt[..], composer) == 1 && st_count_cmds(rt[..], transcript) == 0;

    // 2. Fake HTTP responder resolves turn -> keyed SSE subscription declared
    #assert pl_cmd_respond(rt[..], composer, "send-turn", true, 200, "trn_42");
    while ui_take_msg(rt[..], m[..]) {
      p := ui_msg_payload(rt[..], m[0]);
      if m[0].tag == 3 {
        draft_n = 0;
        ui_sub_begin(rt[..], transcript);
        _ = ui_sub_want(rt[..], transcript, "turn-sse", UI_SUB_SSE, "/api/chat/events/stream/v2alpha1?id=trn_42", 1, 1000, 5, 6, 7, 8);
        ui_sub_commit(rt[..], transcript);
      }
      sh := tr_hash(p) + (ifx streaming then 1 else 0);
      tl_record(tl, clk[0].now_ms, m[0].target, m[0].tag, m[0].arg_i, p, sh, st_count_cmds(rt[..], m[0].target));
    }
    #assert st_expect_sub(rt[..], transcript, "turn-sse", UI_SUB_SSE, "/api/chat/events/stream/v2alpha1?id=trn_42");
    slot := pl_stream_find(rt[..], "turn-sse");
    #assert slot == 0;

    // 3. SSE opens, streams chunks, drops -> backoff timer scheduled
    #assert pl_stream_open(rt[..], slot, 200);
    #assert pl_stream_chunk(rt[..], slot, "Hello ");
    #assert pl_stream_chunk(rt[..], slot, "world");
    #assert pl_stream_error(rt[..], slot, 0, "reconnecting 500ms");
    while ui_take_msg(rt[..], m[..]) {
      p := ui_msg_payload(rt[..], m[0]);
      if m[0].tag == 5 { reconnecting = false; }
      else if m[0].tag == 6 { for c: p { if reply_n < reply.count { reply[reply_n] = c; reply_n += 1; } } }
      else if m[0].tag == 8 {
        reconnecting = true; reconnects += 1;
        _ = ui_cmd_emit(rt[..], transcript, "backoff", UI_CMD_TIMER, UI_CMD_SWITCH, "", "", 500, 9, 0, "");
      }
      sh := tr_hash(cast(string) reply[0..<reply_n]) + reconnects * 7 + (ifx drift_step == tl[0].total then 1 else 0);
      tl_record(tl, clk[0].now_ms, m[0].target, m[0].tag, m[0].arg_i, p, sh, st_count_cmds(rt[..], m[0].target));
    }
    #assert reconnecting && reconnects == 1;

    // 4. Virtual TestClock advances 500ms -> backoff timer fires -> stream resumes & finishes
    #assert pl_advance_ms(rt[..], clk[..], 499) == 0;
    #assert pl_advance_ms(rt[..], clk[..], 1) == 1;
    #assert pl_stream_open(rt[..], slot, 200);
    #assert pl_stream_chunk(rt[..], slot, "!");
    #assert pl_stream_end(rt[..], slot, 200);
    while ui_take_msg(rt[..], m[..]) {
      p := ui_msg_payload(rt[..], m[0]);
      if m[0].tag == 9 || m[0].tag == 5 { reconnecting = false; }
      else if m[0].tag == 6 { for c: p { if reply_n < reply.count { reply[reply_n] = c; reply_n += 1; } } }
      else if m[0].tag == 7 { streaming = false; ui_sub_begin(rt[..], transcript); ui_sub_commit(rt[..], transcript); }
      sh := tr_hash(cast(string) reply[0..<reply_n]) + (ifx streaming then 1 else 0);
      tl_record(tl, clk[0].now_ms, m[0].target, m[0].tag, m[0].arg_i, p, sh, st_count_cmds(rt[..], m[0].target));
    }

    if run == 0 {
      t := last_tree[..];
      tr_begin(t);
      _ = tr_open(t, "chat", TG_MAIN, "chat");
      _ = tr_leaf(t, "chat.title", TG_H1, "", "Cloud Chat");
      _ = tr_leaf(t, "chat.reply", TG_P, "reply", cast(string) reply[0..<reply_n]);
      hid := tr_open(t, "chat.hidden", TG_DIV, "");
      tr_attr(t, hid, AT_HIDDEN, "true");
      _ = tr_leaf(t, "chat.hidden.btn", TG_BUTTON, "", "Hidden");
      tr_close(t);
      inp := tr_open(t, "chat.composer", TG_TEXTAREA, "composer");
      tr_attr(t, inp, AT_PLACEHOLDER, "Message OpenAgents");
      tr_close(t);
      _ = tr_open(t, "chat.send", TG_BUTTON, "send");
      _ = tr_open(t, "chat.send.ico", TG_DIV, ""); tr_close(t);
      _ = tr_leaf(t, "chat.send.lbl", TG_SPAN, "", "Send");
      tr_close(t);
      tr_close(t);
    }
  }

  // Scene accessible locator assertions on final Tree
  t := last_tree[..];
  #assert sc_by_role(t, "main", "") == 0 && sc_by_role(t, "heading", "Cloud Chat") >= 0;
  #assert sc_by_role(t, "button", "Send") >= 0 && sc_by_role(t, "button", "Hidden") < 0;
  #assert sc_by_role(t, "textbox", "Message OpenAgents") >= 0 && sc_count_role(t, "button") == 1;
  #assert sc_by_label(t, "Message OpenAgents") >= 0 && sc_by_text(t, "Hello world!") >= 0 && sc_by_text(t, "Hidden") < 0;

  // SSR of Play Tree produces crawlable HTML with data-coax-ssr="1"
  html_buf: [2048] u8;
  hn := ht_render_root(t, "coaxial-root", "{\"turn\":\"trn_42\"}", html_buf[..]);
  #assert hn > 0 && sc_contains(cast(string) html_buf[0..<hn], "Hello world!") && sc_contains(cast(string) html_buf[0..<hn], "data-coax-ssr=\"1\"");

  // Deterministic replay verification: identical run returns -1; single-step drift flags exact step 3
  #assert tl_replay_compare(timelines[0..<1], timelines[1..<2]) == -1;
  #assert tl_replay_compare(timelines[0..<1], timelines[2..<3]) == 3;

  out: [2048] u8;
  cn := tl_drive(timelines[0..<1], "timeline count", out[..]);
  #assert cn > 0 && cast(string) out[0..<cn] == "11";
  dn := tl_drive(timelines[0..<1], "timeline dump", out[..]);
  #assert dn > 0 && sc_contains(cast(string) out[0..<dn], "step=0 ") && sc_contains(cast(string) out[0..<dn], "step=10 ");
  #assert tl_drive(timelines[0..<1], "unknown", out[..]) == 0;
}

#test "Story, Scene, Play and Timeline enforce every predicate, boundary, slot-1 SSE routing, and ring wrap" {
  // Story cmd & sub predicate matrix (PENDING, RUNNING, QUEUED, wrong owner/kind/key/url)
  r: [1] UiRuntime; clk: [1] PlClock;
  c0 := ui_mount(r[..], "a", 0, -1, 0);
  c1 := ui_mount(r[..], "b", 0, -1, 0);
  #assert st_count_cmds(r[..], c0) == 0 && st_count_cmds(r[..], c1) == 0;
  _ = ui_cmd_emit(r[..], c0, "q", UI_CMD_HTTP_GET, UI_CMD_QUEUE, "/v1", "", 0, 1, 2, "");
  _ = ui_cmd_emit(r[..], c0, "q", UI_CMD_HTTP_GET, UI_CMD_QUEUE, "/v2", "", 0, 1, 2, "");
  #assert st_count_cmds(r[..], c0) == 2 && st_count_cmds(r[..], c1) == 0;
  // Move slot 0 from PENDING -> RUNNING; slot 1 remains QUEUED
  sl: [1] int;
  #assert ui_cmd_take_pending(r[..], sl[..]) && sl[0] == 0;
  #assert st_expect_cmd(r[..], c0, "q", UI_CMD_HTTP_GET, "/v1");
  #assert !st_expect_cmd(r[..], c0, "q", UI_CMD_HTTP_GET, "/v2");   // QUEUED is not running/pending
  #assert !st_expect_cmd(r[..], c1, "q", UI_CMD_HTTP_GET, "/v1");   // wrong owner
  #assert !st_expect_cmd(r[..], c0, "q", UI_CMD_HTTP_POST, "/v1");  // wrong kind
  #assert !st_expect_cmd(r[..], c0, "x", UI_CMD_HTTP_GET, "/v1");   // wrong key
  #assert !pl_cmd_respond(r[..], c1, "q", true, 200, "");
  #assert !pl_cmd_respond(r[..], c0, "x", true, 200, "");
  #assert pl_cmd_respond(r[..], c0, "q", true, 200, "ok");          // responds to RUNNING cmd
  #assert st_count_cmds(r[..], c0) == 1;                            // promoted queued cmd now pending
  #assert pl_cmd_respond(r[..], c0, "q", true, 200, "ok2");
  #assert st_count_cmds(r[..], c0) == 0;
  // Slot-0 + slot-1 subscriptions: slot 0 closed (inactive with stale key), slot 1 active SSE + timer tick
  ui_sub_begin(r[..], c0);
  s0 := ui_sub_want(r[..], c0, "dead", UI_SUB_SSE, "/s0", 1, 100, 10, 11, 12, 13);
  s1 := ui_sub_want(r[..], c0, "live", UI_SUB_SSE, "/s1", 1, 100, 20, 21, 22, 23);
  s2 := ui_sub_want(r[..], c1, "tick", UI_SUB_TIMER, "", 0, 50, 0, 30, 0, 0);
  ui_sub_commit(r[..], c0);
  ui_sub_commit(r[..], c1);
  // Close slot 0 only so slot 0 is inactive while slot 1 stays live
  ui_sub_begin(r[..], c0);
  _ = ui_sub_want(r[..], c0, "live", UI_SUB_SSE, "/s1", 1, 100, 20, 21, 22, 23);
  ui_sub_commit(r[..], c0);
  #assert s0 == 0 && s1 == 1 && s2 == 2 && pl_stream_find(r[..], "dead") < 0 && pl_stream_find(r[..], "live") == 1;
  #assert st_expect_sub(r[..], c0, "live", UI_SUB_SSE, "/s1");
  #assert !st_expect_sub(r[..], c0, "dead", UI_SUB_SSE, "/s0");
  #assert !st_expect_sub(r[..], c1, "live", UI_SUB_SSE, "/s1");
  #assert !st_expect_sub(r[..], c0, "live", UI_SUB_WS, "/s1");
  #assert !st_expect_sub(r[..], c0, "other", UI_SUB_SSE, "/s1");
  #assert !st_expect_sub(r[..], c0, "live", UI_SUB_SSE, "/wrong");
  // Drive slot-1 SSE open/chunk/end/error + check exact message tags and status codes (kills slot*4, +phase, 200->201!)
  m: [1] UiMsg;
  while ui_take_msg(r[..], m[..]) {}
  #assert pl_stream_open(r[..], 1, 200) && ui_take_msg(r[..], m[..]) && m[0].tag == 20 && m[0].arg_i == 200;
  #assert pl_stream_chunk(r[..], 1, "tok") && ui_take_msg(r[..], m[..]) && m[0].tag == 21 && m[0].arg_i == 200;
  #assert pl_stream_end(r[..], 1, 204) && ui_take_msg(r[..], m[..]) && m[0].tag == 22 && m[0].arg_i == 204;
  #assert pl_stream_error(r[..], 1, 503, "drop") && ui_take_msg(r[..], m[..]) && m[0].tag == 23 && m[0].arg_i == 503;
  #assert !pl_stream_open(r[..], -1, 200) && !pl_stream_open(r[..], UI_MAX_SUBS, 200);
  #assert pl_advance_ms(r[..], clk[..], -10) == 0 && clk[0].now_ms == 0;
  #assert pl_advance_ms(r[..], clk[..], 50) == 1 && clk[0].now_ms == 50;   // UI_SUB_TIMER fired (f2 == 1)

  // Scene implicit roles, root-node (idx 0) visibility/label/count, explicit AT_ROLE, aria-hidden="false", and reused-tree bounds
  t: [1] Tree; tr_begin(t[..]);
  r0 := tr_leaf(t[..], "in0", TG_INPUT, "", "");
  tr_attr(t[..], r0, AT_LABEL, "First");
  tr_attr(t[..], r0, AT_HIDDEN, "false");
  r1 := tr_leaf(t[..], "st1", TG_SPAN, "", "Live");
  tr_attr(t[..], r1, AT_ROLE, "status");
  #assert sc_by_label(t[..], "First") == 0 && sc_by_label(t[..], "Missing") < 0 && sc_accessible_name(t[..], 0) == "First";
  #assert sc_role_of(t[..], r1) == "status" && sc_by_role(t[..], "status", "Live") == r1;
  #assert sc_count_role(t[..], "textbox") == 1 && sc_is_visible(t[..], 0);
  tr_attr(t[..], r0, AT_HIDDEN, "true");
  #assert !sc_is_visible(t[..], 0);
  // Reuse tree `t` with only 1 node so stale slot `t[0].nodes[1]` still has AT_ROLE/parent=-1 -> proves idx >= t[0].n guards!
  tr_begin(t[..]);
  _ = tr_leaf(t[..], "only", TG_DIV, "", "one");
  #assert t[0].n == 1 && sc_role_of(t[..], 1) == "" && !sc_is_visible(t[..], 1) && sc_accessible_name(t[..], 1) == "";
  #assert sc_implicit_role(TG_BUTTON) == "button" && sc_implicit_role(TG_A) == "link";
  #assert sc_implicit_role(TG_INPUT) == "textbox" && sc_implicit_role(TG_TEXTAREA) == "textbox";
  #assert sc_implicit_role(TG_MAIN) == "main" && sc_implicit_role(TG_NAV) == "navigation";
  #assert sc_implicit_role(TG_H1) == "heading" && sc_implicit_role(TG_H2) == "heading" && sc_implicit_role(TG_H3) == "heading";
  #assert sc_implicit_role(TG_H4) == "heading" && sc_implicit_role(TG_H5) == "heading" && sc_implicit_role(TG_H6) == "heading";
  #assert sc_implicit_role(TG_UL) == "list" && sc_implicit_role(TG_OL) == "list" && sc_implicit_role(TG_LI) == "listitem";
  #assert sc_implicit_role(TG_DIALOG) == "dialog" && sc_implicit_role(TG_TABLE) == "table" && sc_implicit_role(TG_HR) == "separator";
  #assert sc_implicit_role(TG_DIV) == "";
  // Bounds at exact t[0].n and nested hidden root 0 hiding child 1
  t2: [1] Tree; tr_begin(t2[..]);
  h0 := tr_open(t2[..], "h0", TG_DIV, ""); tr_attr(t2[..], h0, AT_HIDDEN, "true");
  c_hid := tr_leaf(t2[..], "c1", TG_P, "", "secret");
  tr_close(t2[..]);
  in2 := tr_open(t2[..], "in2", TG_INPUT, ""); tr_attr(t2[..], in2, AT_PLACEHOLDER, "Other"); tr_close(t2[..]);
  #assert !sc_is_visible(t2[..], c_hid) && sc_by_label(t2[..], "Missing") < 0 && sc_by_text(t2[..], "x") < 0;
  #assert sc_role_of(t2[..], -1) == "" && sc_role_of(t2[..], t2[0].n) == "";
  #assert !sc_is_visible(t2[..], -1) && !sc_is_visible(t2[..], t2[0].n);
  #assert sc_accessible_name(t2[..], -1) == "" && sc_accessible_name(t2[..], t2[0].n) == "" && sc_accessible_name(t2[..], h0) == "secret";
  #assert sc_contains("ab", "") && !sc_contains("ab", "x") && !sc_contains("a", "ab");

  // Timeline: disabled guard, exact formatting, field-by-field step-0 divergence, and 128-slot ring wrap
  tl1: [1] UiTimeline; tl2: [1] UiTimeline;
  tl_record(tl1[..], 10, 0, 1, -5, "p", 7, 0);
  #assert tl1[0].count == 0;
  tl_enable(tl1[..]); tl_enable(tl2[..]);
  tl_record(tl1[..], 10, 0, 1, -5, "p", 7, 0);
  out: [128] u8; tiny: [2] u8;
  n := tl_drive(tl1[..], "timeline dump", out[..]);
  #assert n > 0 && cast(string) out[0..<n] == "step=0 t=10 target=0 tag=1 arg=-5 state=7 cmds=0\n";
  #assert tl_drive(tl1[..], "timeline dump", tiny[..]) == -1 && tl_drive(tl1[..], "timeline count", tiny[0..<0]) == -1;
  // Field-by-field divergence at step 0
  tl_record(tl2[..], 10, 1, 1, -5, "p", 7, 0); #assert tl_replay_compare(tl1[..], tl2[..]) == 0;
  tl_clear(tl2[..]); tl_record(tl2[..], 10, 0, 2, -5, "p", 7, 0); #assert tl_replay_compare(tl1[..], tl2[..]) == 0;
  tl_clear(tl2[..]); tl_record(tl2[..], 10, 0, 1, -4, "p", 7, 0); #assert tl_replay_compare(tl1[..], tl2[..]) == 0;
  tl_clear(tl2[..]); tl_record(tl2[..], 10, 0, 1, -5, "q", 7, 0); #assert tl_replay_compare(tl1[..], tl2[..]) == 0;
  tl_clear(tl2[..]); tl_record(tl2[..], 10, 0, 1, -5, "p", 8, 0); #assert tl_replay_compare(tl1[..], tl2[..]) == 0;
  tl_clear(tl2[..]); tl_record(tl2[..], 10, 0, 1, -5, "p", 7, 1); #assert tl_replay_compare(tl1[..], tl2[..]) == 0;
  tl_clear(tl2[..]); tl_record(tl2[..], 10, 0, 1, -5, "p", 7, 0);
  tl_record(tl2[..], 20, 0, 2, 0, "q", 8, 1);
  #assert tl_replay_compare(tl1[..], tl2[..]) == 1;
  // Ring wrap past UI_LOG_MAX (128 -> 130)
  tl_clear(tl1[..]);
  #assert tl1[0].count == 0 && tl1[0].total == 0;
  for k: 0..<UI_LOG_MAX + 2 { tl_record(tl1[..], k, 0, 1, k, "", k, 0); }
  #assert tl1[0].count == UI_LOG_MAX && tl1[0].total == UI_LOG_MAX + 2 && tl1[0].entries[0].step == UI_LOG_MAX;
}
