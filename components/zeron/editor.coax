// The active GPU text body used where a platform exposes an input-method
// protocol rather than a native text view. One Composer owns editing; this
// adapter supplies no second edit buffer, line wrapper or key implementation.
// Its owner is a host-issued nonzero epoch, separate from the app reducer.
#load "composer.coax";

#test "active text stays provisional until commit and cancellation restores its selection" {
  e: [1] UiEditor; a: [1] Atlas; test_atlas(a[..]);
  #assert ue_open(e[..], 1, "ab");
  composer_select_all(e[0].body[..]);
  #assert ue_mark(e[..], "候補", 0, 6) && ue_value(e[..]) == "ab";
  #assert typed(e[0].body[..]) == "候補" && e[0].body[0].ed[0].marked;
  ue_cancel(e[..]);
  #assert typed(e[0].body[..]) == "ab" && sel_lo(e[0].body[..]) == 0 && sel_hi(e[0].body[..]) == 2;
  #assert ue_mark(e[..], "候補", 6, 6) && ue_insert(e[..], "確定🙂");
  #assert ue_value(e[..]) == "確定🙂" && !e[0].body[0].ed[0].marked;
  composer_undo(e[0].body[..]); ue_committed(e[..]); #assert ue_value(e[..]) == "ab";
}
#test "active editor fences owners and refuses an over-capacity whole edit" {
  e: [1] UiEditor; a: [1] Atlas; test_atlas(a[..]);
  #assert !ue_open(e[..], 0, "no owner") && ue_open(e[..], 7, "hello");
  #assert ue_key(e[..], a[..], KEY_LEFT, 0) && e[0].body[0].ed[0].caret == 4;
  #assert ue_insert(e[..], "🙂") && ue_value(e[..]) == "hell🙂o";
  big: [EB_TEXT+1] u8; for i: 0..<big.count {big[i]='a';}
  #assert !ue_insert(e[..], cast(string)big[..]) && ue_value(e[..]) == "hell🙂o";
  #assert !ue_open(e[..], 8, cast(string)big[..]) && e[0].owner == 7;
  #assert ue_mark(e[..], "x", 0, 1); ue_close(e[..]);
  #assert e[0].owner == 0 && e[0].n == 0 && !e[0].body[0].focused && e[0].body[0].ed[0].hist[0].used == 0;
  #assert !ue_insert(e[..], "stale") && !ue_mark(e[..], "stale", 0, 5);
  #assert ue_open(e[..], 8, "new") && ue_value(e[..]) == "new";
}
#test "field Return and Escape belong to the caller, ordinary keys use shared editing" {
  e: [1] UiEditor; a: [1] Atlas; test_atlas(a[..]); #assert ue_open(e[..], 1, "draft");
  #assert !ue_key(e[..], a[..], KEY_ENTER, 0) && ue_value(e[..]) == "draft";
  #assert !ue_key(e[..], a[..], KEY_ESCAPE, 0) && ue_value(e[..]) == "draft";
  #assert ue_key(e[..], a[..], KEY_ENTER, MOD_SHIFT) && ue_value(e[..]) == "draft\n";
  #assert ue_key(e[..], a[..], KEY_BACKSPACE, 0) && ue_value(e[..]) == "draft";
}
#test "an input-method transaction preflights commit and next preedit together" {
  e:[1]UiEditor;#assert ue_open(e[..],1,"ab");
  #assert ue_transaction(e[..],"","候補",0,6) && ue_value(e[..])=="ab";
  big:[EB_TEXT]u8;for i:0..<big.count {big[i]='x';}
  #assert !ue_transaction(e[..],"commit",cast(string)big[..],0,0);
  #assert ue_value(e[..])=="ab" && typed(e[0].body[..])=="ab候補" && e[0].body[0].ed[0].marked;
  #assert ue_transaction(e[..],"確定","次",-1,-1) && ue_value(e[..])=="ab確定";
  #assert e[0].body[0].caret_hidden && typed(e[0].body[..])=="ab確定次";
  #assert ue_transaction(e[..],"","",0,0) && ue_value(e[..])=="ab確定" && !e[0].body[0].caret_hidden;
}
#test "single-line fields scroll horizontally and pointer hit testing follows that offset" {
  e:[1]UiEditor;a:[1]Atlas;test_atlas(a[..]);#assert ue_open(e[..],1,"abcdefghijklmnop");
  c:=e[0].body[..];c[0].no_wrap=true;composer_body_layout(c,a[..],10,20,40,22.75);
  #assert c[0].lines==1 && c[0].scroll==0 && c[0].scroll_x>0;
  hit:=content_hit(c,a[..],50,25);#assert hit.at==16;
  move_to(c,0);composer_body_layout(c,a[..],10,20,40,22.75);#assert c[0].scroll_x==0;
}
#test "empty SDK spans are inert and a fresh owner retires all prior editing state" {
 e:[1]UiEditor;a:[1]Atlas;out:[16]u8;pixels:[32]f32;box:=[4]f32.[10,20,80,40];
 ue_close(e[0..<0]);ue_cancel(e[0..<0]);
 #assert !ue_open(e[0..<0],1,"") && !ue_insert(e[0..<0],"x") && !ue_mark(e[0..<0],"x",0,1);
 #assert !ue_transaction(e[0..<0],"x","",0,0) && !ue_key(e[0..<0],a[..],KEY_BACKSPACE,0) && !ue_paste(e[0..<0],"x");
 #assert ue_text(e[0..<0],out[..])== -1 && ue_owner(e[0..<0])==0 && ue_paint(e[0..<0],a[..],pixels[..],0,1,box[..],zeron_skin(),0)==0;
 #assert ue_open(e[..],17,"old");c:=e[0].body[..];c[0].no_wrap=true;c[0].scroll=23;c[0].scroll_x=14;c[0].since=3;c[0].caret_hidden=true;c[0].selecting=true;c[0].follow=false;
 #assert ue_open(e[..],18,"") && ue_owner(e[..])==18 && ue_value(e[..])=="" && typed(c)=="";
 #assert !c[0].no_wrap && c[0].scroll==0 && c[0].scroll_x==0 && c[0].since==0 && !c[0].caret_hidden && !c[0].selecting && c[0].focused && c[0].follow;
 ue_close(e[..]);ue_cancel(e[..]);#assert ue_owner(e[..])==0 && ue_value(e[..])=="";
 #assert !ue_paste(e[..],"x") && !ue_transaction(e[..],"x","",0,0) && !ue_key(e[..],a[..],KEY_LEFT,0);
}
#test "capacity is inclusive, an oversized composition is atomic, and text output is all or nothing" {
 e:[1]UiEditor;full:[EB_TEXT]u8;for i:0..<full.count {full[i]='a';}
 #assert ue_open(e[..],1,cast(string)full[..]) && ue_value(e[..]).count==EB_TEXT;
 #assert !ue_mark(e[..],"x",0,1) && !e[0].body[0].ed[0].marked && ue_value(e[..]).count==EB_TEXT;
 #assert !ue_paste(e[..],"x") && ue_value(e[..]).count==EB_TEXT;
 small:=[3]u8.[42,42,42];#assert ue_text(e[..],small[..])== -1 && small[0]==42 && small[2]==42;
 #assert ue_open(e[..],2,"é");#assert ue_text(e[..],small[0..<1])== -1 && small[0]==42;
 #assert ue_text(e[..],small[0..<2])==2 && small[0]==195 && small[1]==169 && small[2]==42;
 #assert ue_text(e[..],small[..])==2 && small[2]==42;
}
#test "cancelled composition clears its redo and caret state while ordinary cancellation preserves redo" {
 e:[1]UiEditor;#assert ue_open(e[..],1,"ab");c:=e[0].body[..];
 #assert ue_insert(e[..],"cd");composer_undo(c);ue_committed(e[..]);#assert can_redo(c);
 ue_cancel(e[..]);#assert can_redo(c) && ue_value(e[..])=="ab";
 composer_select_all(c);#assert ue_mark(e[..],"候補",-1,-1);c[0].follow=false;c[0].since=2;
 ue_cancel(e[..]);#assert ue_value(e[..])=="ab" && typed(c)=="ab" && !can_redo(c) && c[0].ed[0].hist[EB_REDO].used==0;
 #assert !c[0].caret_hidden && c[0].follow && c[0].since==0 && selected(c)=="ab";
}
#test "mark and insertion replace the current selection, restart the caret, and keep provisional text private" {
 e:[1]UiEditor;a:[1]Atlas;test_atlas(a[..]);#assert ue_open(e[..],1,"abcd");c:=e[0].body[..];
 move_to(c,1);select_to(c,3);c[0].follow=false;c[0].since=2;c[0].upstream=true;c[0].has_column=true;
 #assert ue_mark(e[..],"é",-1,-1) && typed(c)=="aéd" && ue_value(e[..])=="abcd" && c[0].caret_hidden;
 #assert c[0].follow && c[0].since==0 && !c[0].upstream && !c[0].has_column;
 #assert !ue_key(e[..],a[..],KEY_LEFT,0) && typed(c)=="aéd";
 c[0].follow=false;c[0].since=2;#assert ue_mark(e[..],"xyz",1,2) && selected(c)=="y" && !c[0].caret_hidden && c[0].follow && c[0].since==0;
 #assert ue_value(e[..])=="abcd";#assert ue_insert(e[..],"🙂") && ue_value(e[..])=="a🙂d" && typed(c)=="a🙂d" && !c[0].caret_hidden;
 move_to(c,1);select_to(c,5);c[0].caret_hidden=true;c[0].follow=false;c[0].since=2;
 #assert ue_insert(e[..],"Q") && ue_value(e[..])=="aQd" && !c[0].caret_hidden && c[0].follow && c[0].since==0;
 #assert !ue_key(e[..],a[..],999999,0) && ue_value(e[..])=="aQd";
}
#test "a single character paste has its own undo and replaces a marked range rather than committing it" {
 e:[1]UiEditor;a:[1]Atlas;test_atlas(a[..]);#assert ue_open(e[..],1,"") && ue_insert(e[..],"a");c:=e[0].body[..];
 #assert ue_paste(e[..],"b") && ue_value(e[..])=="ab";
 #assert ue_key(e[..],a[..],'z',MOD_CTRL) && ue_value(e[..])=="a";
 #assert ue_mark(e[..],"pending",-1,-1);c[0].since=3;c[0].follow=false;
 #assert ue_paste(e[..],"c") && ue_value(e[..])=="ac" && !c[0].caret_hidden && c[0].since==0 && c[0].follow;
 #assert !ue_paste(e[..],"") && ue_value(e[..])=="ac";
}
#test "whole input-method capacity admission includes selection replacement and never commits a prefix" {
 e:[1]UiEditor;full:[EB_TEXT]u8;for i:0..<full.count {full[i]='x';}
 #assert ue_open(e[..],1,cast(string)full[0..<EB_TEXT-2]);
 #assert ue_transaction(e[..],"a","b",1,1) && ue_value(e[..]).count==EB_TEXT-1 && typed(e[0].body[..]).count==EB_TEXT;
 #assert !ue_transaction(e[..],"ab","c",0,1) && ue_value(e[..]).count==EB_TEXT-1 && typed(e[0].body[..]).count==EB_TEXT;
 #assert ue_open(e[..],2,"z");composer_select_all(e[0].body[..]);
 #assert ue_transaction(e[..],cast(string)full[..],"",0,0) && ue_value(e[..]).count==EB_TEXT;
 #assert ue_open(e[..],3,"") && ue_transaction(e[..],"",cast(string)full[..],0,0) && ue_value(e[..])=="";
 #assert ue_open(e[..],4,"abcd");move_to(e[0].body[..],1);select_to(e[0].body[..],3);
 #assert ue_transaction(e[..],"X","yz",2,0) && ue_value(e[..])=="aXd" && selected(e[0].body[..])=="yz";
 #assert ue_transaction(e[..],"","",0,0) && ue_value(e[..])=="aXd";
 #assert ue_open(e[..],5,"ab");move_to(e[0].body[..],0);select_to(e[0].body[..],2);
 #assert ue_transaction(e[..],"","",0,0) && ue_value(e[..])=="ab" && selected(e[0].body[..])=="ab";
}
#test "the active text body paints its supplied skin and geometry, advances its clock and blinks one caret" {
 e:[1]UiEditor;a:[1]Atlas;test_atlas(a[..]);#assert ue_open(e[..],1,"ab");
 box:=[4]f32.[10,20,80,40];out:[10000]f32;sk:=zeron_skin();sk.ink=rgba(0.1,0.2,0.3,1);sk.cmp.line=33;sk.cmp.caret=3;sk.cmp.caret_blink=0.5;
 n:=ue_paint(e[..],a[..],out[..],0,2,box[..],sk,0.2);c:=e[0].body[..];
 #assert n==18 && c[0].x==10 && c[0].y==20 && c[0].w==80 && c[0].h==40 && c[0].text_x==10 && c[0].text_y==20 && c[0].text_w==80 && c[0].view_h==40;
 #assert c[0].since==0.2f32 && c[0].ed[0].clock==0.2f32 && c[0].skin.ink.r==0.1f32 && c[0].lines==1;
 #assert out[12]==0.1f32 && out[13]==0.2f32 && out[14]==0.3f32 && out[GP_VERTEX_FLOATS*12+6]==6;
 #assert ue_paint(e[..],a[..],out[..],0,2,box[..],sk,0.4)==12;
 #assert c[0].since>0.59f32 && c[0].ed[0].clock>0.59f32;
 saved:=c[0].since;#assert ue_paint(e[..],a[..],out[..],6,2,box[0..<3],sk,1)==6 && c[0].since==saved;
 box[2]=0;#assert ue_paint(e[..],a[..],out[..],6,2,box[..],sk,1)==6 && c[0].since==saved;box[2]=80;box[3]=0;#assert ue_paint(e[..],a[..],out[..],6,2,box[..],sk,1)==6 && c[0].since==saved;
 box[3]=40;a[0].ready=false;#assert ue_paint(e[..],a[..],out[..],6,2,box[..],sk,1)==6;
 ue_close(e[..]);a[0].ready=true;#assert ue_paint(e[..],a[..],out[..],6,2,box[..],sk,1)==6 && c[0].since==0;
}
#test "transaction capacity accounts for a nonempty range and one extra byte refuses atomically" {
 e:[1]UiEditor;full:[EB_TEXT]u8;for i:0..<full.count {full[i]='x';}
 #assert ue_open(e[..],1,cast(string)full[..]);c:=e[0].body[..];move_to(c,4);select_to(c,6);
 #assert !ue_transaction(e[..],"a","bc",1,1) && ue_value(e[..]).count==EB_TEXT && !c[0].ed[0].marked && selected(c)=="xx";
 #assert ue_transaction(e[..],"a","b",1,1) && ue_value(e[..]).count==EB_TEXT-1 && typed(c).count==EB_TEXT;
 // The protocol's empty transaction clears a hidden cursor even when no
 // provisional span is left (a compositor can send an empty preedit).
 #assert ue_insert(e[..],"");c[0].caret_hidden=true;
 #assert ue_transaction(e[..],"","",0,0) && !c[0].caret_hidden;
}

UiEditor :: struct {body: [1] Composer; owner: u64; committed: [EB_TEXT] u8; n: int;}
ue_value :: (e: [] UiEditor) -> string {return cast(string)e[0].committed[0..<e[0].n];}
ue_committed :: (e: [] UiEditor) {
  if e[0].body[0].ed[0].marked {return;}
  t:=typed(e[0].body[..]); for c,i:t {e[0].committed[i]=c;}e[0].n=t.count;
}
ue_close :: (e: [] UiEditor) #export_c #effects(all) {if e.count>0 {e[0]=UiEditor.{};}}
// A successful caller supplies complete valid UTF-8, already admitted by its
// platform text adapter. Oversize values never become a truncated document.
ue_open :: (e: [] UiEditor, owner: u64, text: string) -> bool #export_c #effects(all) {
  if e.count<1 || owner==0 || text.count>EB_TEXT {return false;}
  ue_close(e);e[0].owner=owner;e[0].body[0].focused=true;e[0].body[0].follow=true;
  eb_set(e[0].body[0].ed[..],text);ue_committed(e);return true;
}
ue_cancel :: (e: [] UiEditor) #export_c #effects(all) {
  if e.count<1 || !e[0].body[0].ed[0].marked {return;}
  composer_undo(e[0].body[..]);
  e[0].body[0].ed[0].hist[EB_REDO].count=0;e[0].body[0].ed[0].hist[EB_REDO].used=0;
  e[0].body[0].caret_hidden=false;ue_committed(e); // mutant: equivalent — cancellation restores the pre-mark snapshot already retained in committed; ue_committed copies those identical bytes
}
ue_insert :: (e: [] UiEditor, text: string) -> bool #export_c #effects(all) {
  if e.count<1 || e[0].owner==0 {return false;}
  b:=e[0].body[0].ed[..];g:=b[0].gen;
  if !eb_replace(b,-1,-1,text) {return false;} // mutant: equivalent — when from is negative eb_replace derives both endpoints, ignoring the supplied to
  e[0].body[0].caret_hidden=false;composer_touched(e[0].body[..],g);ue_committed(e);return true;
}
// Wayland's selection offsets are bytes in the marked text, not UTF-16.
// The SDK admits UTF-8 boundaries before this call; -1 means no visible caret.
ue_mark :: (e: [] UiEditor, text: string, from: int, to: int) -> bool #export_c #effects(all) {
  if e.count<1 || e[0].owner==0 {return false;}
  b:=e[0].body[0].ed[..];g:=b[0].gen;
  if !eb_mark(b,-1,-1,text,from,to) {return false;} // mutant: equivalent — when from is negative eb_mark derives both endpoints, ignoring the supplied to
  e[0].body[0].caret_hidden=from== -1 && to== -1; // mutant: equivalent — the SDK admits either two -1 offsets or two nonnegative UTF-8 boundaries, never one -1
  composer_touched(e[0].body[..],g);return true;
}
// Bytes from..<to of the committed text replaced by text, as one undo step, the caret after it (a
// mention's pick replaces its token: components/app/mention.coax). False with no owner, during a
// composition, outside the text or when it does not fit.
ue_replace :: (e: [] UiEditor, from: int, to: int, text: string) -> bool {
  if e.count<1 || e[0].owner==0 || e[0].body[0].ed[0].marked || from<0 || to<from || to>e[0].body[0].ed[0].n {return false;}
  c:=e[0].body[..];b:=c[0].ed[..];g:=b[0].gen;
  if !eb_replace(b,from,to,text) {return false;}
  c[0].caret_hidden=false;composer_touched(c,g);ue_committed(e);return true;
}
// The SDK has validated complete UTF-8 and cursor boundaries. Atomic capacity
// admission prevents a valid commit followed by an unrepresentable preedit.
ue_transaction :: (e:[]UiEditor,commit:string,preedit:string,begin:int,end:int)->bool #export_c #effects(all) {
  if e.count<1 || e[0].owner==0 {return false;}
  b:=e[0].body[0].ed[..];lo:=ifx b[0].marked then b[0].marked_at else eb_sel_lo(b);hi:=ifx b[0].marked then b[0].marked_end else eb_sel_hi(b);
  // Subtract from the available room: adding two borrowed string counts
  // could overflow before a capacity comparison. Valid buffer ranges leave
  // 0..EB_TEXT bytes, and string counts are nonnegative.
  room:=EB_TEXT-(b[0].n-(hi-lo));
  if commit.count>room-preedit.count {return false;}
  if commit.count>0 || b[0].marked {
    if !ue_insert(e,commit) {return false;} // mutant: equivalent — the preceding room preflight guarantees this insertion fits the same unchanged range; this failure is unreachable
  }
  if preedit.count>0 {
    lo_cursor:=ifx begin<end then begin else end; // mutant: equivalent — at equality either branch returns the same byte offset
    hi_cursor:=ifx begin>end then begin else end; // mutant: equivalent — at equality either branch returns the same byte offset
    return ue_mark(e,preedit,lo_cursor,hi_cursor);
  }
  e[0].body[0].caret_hidden=false;return true;
}
ue_key :: (e: [] UiEditor, a: [] Atlas, key: int, mods: int) -> bool #export_c #effects(all) {
  if e.count<1 || e[0].owner==0 || key==KEY_ESCAPE || (key==KEY_ENTER && mods==0) {return false;}
  if e[0].body[0].ed[0].marked {return false;}
  took:=composer_key(e[0].body[..],a,key,mods);if took {ue_committed(e);}return took;
}
ue_paste :: (e:[]UiEditor,text:string)->bool #export_c #effects(all) {
 if e.count<1 || e[0].owner==0 {return false;}b:=e[0].body[0].ed[..];g:=b[0].gen;
 if !eb_paste(b,text) {return false;}e[0].body[0].caret_hidden=false;composer_touched(e[0].body[..],g);ue_committed(e);return true;
}
ue_text :: (e: [] UiEditor, out: [] u8) -> int #export_c #effects(all) {
  if e.count<1 || out.count<e[0].n {return -1;}for i:0..<e[0].n {out[i]=e[0].committed[i];}return e[0].n;
}
ue_owner :: (e: [] UiEditor) -> u64 #export_c #effects(all) {return ifx e.count>0 then e[0].owner else 0;}
ue_paint :: (e: [] UiEditor, a: [] Atlas, out: [] f32, at: int, d: f32, box: [] f32, skin: UiSkin, dt: f32) -> int #export_c #effects(all) {
  if e.count<1 || e[0].owner==0 || box.count<4 || box[2]<=0 || box[3]<=0 || !a[0].ready {return at;} // not a size: four rectangle coordinates
  c:=e[0].body[..];composer_set_skin(c,skin);c[0].since+=dt;c[0].ed[0].clock+=dt;
  c[0].x=box[0];c[0].y=box[1];c[0].w=box[2];c[0].h=box[3];
  composer_body_layout(c,a,box[0],box[1],box[2],box[3]);
  // An arbitrary active field may expose every wrapped line at once, unlike
  // the bounded-height chat composer. Reserve all lines plus selection,
  // caret and clip scopes so a tall field cannot truncate the display list.
  list:[COMPOSER_LINES+8]Prim;split:[1]int; // not a size: display-list capacity, all lines plus at most three selection rects, a caret, two clip rows and spare
  n:=composer_body_prims(list[..],0,c,a,split[..]); // mutant: equivalent — the extra zero Prim is a transparent empty box; even all 1024 lines plus selection/caret/scopes and that box fit the declared capacity
  return composer_draw(out,at,c,a,d,list[..],n,split[0]);
}

// ---------------------------------------------------------------- AppKit's input client

// NSTextInputClient (apps/shared/host/linux/ui-host.h UiIme) names ranges in UTF-16 units of the
// whole text, marked text included; a negative from is the marked range, else the selection. A
// page that draws the field in its own display list lays it out with ue_layout and paints it with
// ue_prims; the Mac host's input client calls the *16 adapters (apps/coder-desktop/host.c).
UE_MARKED_FROM :: 2; UE_MARKED_TO :: 3; UE_RECT :: 4;   // ue_range16's marked range; a rectangle's four numbers
ue_replace16 :: (e: [] UiEditor, from16: int, to16: int, text: string) -> bool {
  if e.count<1 || e[0].owner==0 {return false;}
  if from16<0 {return ue_insert(e,text);}
  c:=e[0].body[..];b:=c[0].ed[..];g:=b[0].gen;
  if !eb_replace(b,byte_of(c,from16),byte_of(c,to16),text) {return false;}
  c[0].caret_hidden=false;composer_touched(c,g);ue_committed(e);return true;
}
// sel_from16 and sel_to16 are the selection inside the marked text, in its UTF-16 units.
ue_mark16 :: (e: [] UiEditor, from16: int, to16: int, text: string, sel_from16: int, sel_to16: int) -> bool {
  if e.count<1 || e[0].owner==0 {return false;}
  c:=e[0].body[..];b:=c[0].ed[..];g:=b[0].gen;
  sf:=ifx sel_from16<0 then -1 else byte_in(text,sel_from16);st:=ifx sel_from16<0 then -1 else byte_in(text,sel_to16);
  from:=ifx from16<0 then -1 else byte_of(c,from16);to:=ifx from16<0 then -1 else byte_of(c,to16);
  if !eb_mark(b,from,to,text,sf,st) {return false;}
  c[0].caret_hidden=false;composer_touched(c,g);return true;
}
// unmarkText: the composition is kept as typed text.
ue_unmark :: (e: [] UiEditor) {
  if e.count<1 || e[0].owner==0 || !e[0].body[0].ed[0].marked {return;}
  eb_unmark(e[0].body[0].ed[..]);e[0].body[0].caret_hidden=false;ue_committed(e);
}
// which 0: the selection's start, 1 its end, 2 the composition's start, 3 its end (-1 without
// one), 4 the text's length; all in UTF-16 units, -1 with no owner.
ue_range16 :: (e: [] UiEditor, which: int) -> int {
  if e.count<1 || e[0].owner==0 {return -1;}
  c:=e[0].body[..];
  if which==0 {return u16_of(c,sel_lo(c));}
  if which==1 {return u16_of(c,sel_hi(c));}
  if which==UE_MARKED_FROM || which==UE_MARKED_TO {
    if !c[0].ed[0].marked {return -1;}
    return u16_of(c,ifx which==2 then c[0].ed[0].marked_at else c[0].ed[0].marked_end);
  }
  return u16_of(c,c[0].ed[0].n);
}
// The bytes of a UTF-16 range, marked text included: their count, 0 when out does not hold them.
ue_text16 :: (e: [] UiEditor, from16: int, to16: int, out: [] u8) -> int {
  if e.count<1 || e[0].owner==0 {return 0;}
  c:=e[0].body[..];lo:=byte_of(c,from16);hi:=byte_of(c,to16);
  if hi<lo || hi-lo>out.count {return 0;}
  for k:lo..<hi {out[k-lo]=c[0].ed[0].text[k];}
  return hi-lo;
}
// The caret-sized box at a UTF-16 offset, where an input method puts its candidates: x, y, w, h
// in the units the field was last laid out in. False before a layout.
ue_rect16 :: (e: [] UiEditor, a: [] Atlas, at16: int, out: [] f32) -> bool {
  if e.count<1 || e[0].owner==0 || out.count<UE_RECT || !a[0].ready || !(e[0].body[0].text_w>0) {return false;}
  c:=e[0].body[..];ue_rewrap(c,a);i:=byte_of(c,at16);
  r:=ifx i==c[0].ed[0].caret then row_of(c,i,c[0].upstream) else row_of(c,i,false);
  out[0]=c[0].text_x-c[0].scroll_x+x_in_row(c,a,r,i);out[1]=c[0].text_y-c[0].scroll+cast(f32)r*composer_line(c);
  out[2]=composer_skin(c).cmp.caret;out[3]=composer_line(c);
  return true;
}
// The UTF-16 offset under a point in the field's units.
ue_index16 :: (e: [] UiEditor, a: [] Atlas, x: f32, y: f32) -> int {
  if e.count<1 || e[0].owner==0 || !a[0].ready {return -1;}
  c:=e[0].body[..];if !(c[0].text_w>0) {return -1;}ue_rewrap(c,a);return u16_of(c,content_hit(c,a,x,y).at);
}
// An edit since the last layout leaves its rows stale: wrapped again at the width laid out.
ue_rewrap :: (c: [] Composer, a: [] Atlas) {composer_wrap(c,a,ifx c[0].no_wrap then cast(f32)COMPOSER_UNBOUNDED else c[0].text_w);}
// The field in box (x, y, w, h) in skin, its clock dt seconds on: wrapped, scrolled to its caret.
// False with no owner, no atlas or an empty box.
ue_layout :: (e: [] UiEditor, a: [] Atlas, box: [] f32, skin: UiSkin, dt: f32) -> bool {
  if e.count<1 || e[0].owner==0 || box.count<UE_RECT || box[2]<=0 || box[3]<=0 || !a[0].ready {return false;} // not a size: a rectangle's indices
  c:=e[0].body[..];composer_set_skin(c,skin);
  if dt>0 {c[0].since+=dt;c[0].ed[0].clock+=dt;}
  c[0].x=box[0];c[0].y=box[1];c[0].w=box[2];c[0].h=box[3];
  composer_body_layout(c,a,box[0],box[1],box[2],box[3]);
  return true;
}
// The laid-out field into a display list: its selection, text (or placeholder), the input method's
// underline and its caret. Returns the list's new count.
ue_prims :: (e: [] UiEditor, a: [] Atlas, list: [] Prim, n: int) -> int {
  if e.count<1 || e[0].owner==0 || !a[0].ready || !(e[0].body[0].text_w>0) {return n;}
  c:=e[0].body[..];split:[1]int;ue_rewrap(c,a);
  k:=composer_body_prims(list,n,c,a,split[..]);
  return composer_underline_prims(list,k,c,a);
}
// Seconds until the caret next shows or hides, -1 when it does not blink (no focus, a selection,
// hidden by an input method).
ue_blink :: (e: [] UiEditor) -> f32 {
  if e.count<1 || e[0].owner==0 {return -1;}
  c:=e[0].body[..];b:=composer_skin(c).cmp.caret_blink;
  if !c[0].focused || c[0].caret_hidden || sel_lo(c)!=sel_hi(c) || !(b>0) {return -1;}
  return b-(c[0].since-floor(c[0].since/b)*b);
}

// A secure field (a password, a key): the editor keeps the text, and a mask composer the caller
// keeps draws one dot per code point in its place, with the caret and selection at the same code
// points. A press lands on the dots and comes back to the text. No copy or cut: the caller refuses them.
UE_DOT_BYTES :: 3;   // a dot (U+2022) in UTF-8: E2 80 A2

ue_cp_of :: (t: string, b: int) -> int {n:=0;for i:0..<(ifx b<t.count then b else t.count) {if (t[i]&0xC0)!=0x80 {n+=1;}}return n;}
ue_byte_of_cp :: (t: string, k: int) -> int {n:=0;for i:0..<t.count {if (t[i]&0xC0)!=0x80 {if n==k {return i;}n+=1;}}return t.count;}
// The mask follows the editor: as many dots as it holds code points, its selection, focus, blink and box.
ue_mask_sync :: (e: [] UiEditor, a: [] Atlas, m: [] Composer) {
  c:=e[0].body[..];t:=typed(c);k:=ue_cp_of(t,t.count);most:=EB_TEXT/UE_DOT_BYTES;if k>most {k=most;}
  n:=k*UE_DOT_BYTES;if m[0].ed[0].n!=n {dots:[EB_TEXT]u8;for i:0..<k {d:=i*UE_DOT_BYTES;dots[d]=0xE2;dots[d+1]=0x80;dots[d+2]=0xA2;}eb_set(m[0].ed[..],cast(string)dots[0..<n]);}
  an:=ue_cp_of(t,c[0].ed[0].anchor);ca:=ue_cp_of(t,c[0].ed[0].caret);
  m[0].ed[0].anchor=UE_DOT_BYTES*(ifx an>k then k else an);m[0].ed[0].caret=UE_DOT_BYTES*(ifx ca>k then k else ca);
  m[0].focused=c[0].focused;m[0].caret_hidden=c[0].caret_hidden;m[0].since=c[0].since;m[0].no_wrap=true;m[0].follow=true;
  m[0].placeholder=c[0].placeholder;composer_set_skin(m,composer_skin(c));
  m[0].x=c[0].x;m[0].y=c[0].y;m[0].w=c[0].w;m[0].h=c[0].h;
  if c[0].w>0 && c[0].h>0 {composer_body_layout(m,a,c[0].x,c[0].y,c[0].w,c[0].h);}
}
ue_mask_prims :: (e: [] UiEditor, a: [] Atlas, m: [] Composer, list: [] Prim, n: int) -> int {
  if e.count<1 || e[0].owner==0 || !a[0].ready || !(e[0].body[0].text_w>0) {return n;}
  ue_mask_sync(e,a,m);split:[1]int;
  return composer_body_prims(list,n,m,a,split[..]);
}
// The mask's selection back to the text's code points.
ue_mask_back :: (e: [] UiEditor, m: [] Composer) {
  c:=e[0].body[..];t:=typed(c);
  c[0].ed[0].anchor=ue_byte_of_cp(t,m[0].ed[0].anchor/UE_DOT_BYTES);c[0].ed[0].caret=ue_byte_of_cp(t,m[0].ed[0].caret/UE_DOT_BYTES);
  c[0].since=0;c[0].has_column=false;c[0].ed[0].gen+=1;
}
// A press (phase 0, with its clicks and Shift), drag (1) or release (2) on the dots.
ue_mask_pointer :: (e: [] UiEditor, a: [] Atlas, m: [] Composer, x: f32, y: f32, phase: int, clicks: int, shift: bool) {
  if e.count<1 || e[0].owner==0 || !a[0].ready {return;}
  if phase==0 {ue_mask_sync(e,a,m);_=composer_press(m,a,x,y,ifx clicks<1 then 1 else clicks,shift);ue_mask_back(e,m);return;}
  if phase==1 {composer_drag(m,a,x,y);ue_mask_back(e,m);return;}
  composer_release(m);
}

#test "AppKit's input client: UTF-16 ranges replace and mark, the composition stays provisional, unmark keeps it" {
  e:[1]UiEditor;a:[1]Atlas;test_atlas(a[..]);#assert ue_open(e[..],1,"a🙂b");
  #assert ue_range16(e[..],4)==4 && ue_range16(e[..],0)==4 && ue_range16(e[..],2)== -1;
  #assert ue_replace16(e[..],1,3,"x") && ue_value(e[..])=="axb" && ue_range16(e[..],0)==2;
  #assert ue_mark16(e[..],-1,-1,"か",1,1) && ue_value(e[..])=="axb" && typed(e[0].body[..])=="axかb";
  #assert ue_range16(e[..],2)==2 && ue_range16(e[..],3)==3;
  out:[16]u8;#assert ue_text16(e[..],2,3,out[..])==3 && cast(string)out[0..<3]=="か";
  #assert ue_mark16(e[..],-1,-1,"漢",1,1) && typed(e[0].body[..])=="ax漢b";
  #assert ue_replace16(e[..],-1,-1,"漢字") && ue_value(e[..])=="ax漢字b" && !e[0].body[0].ed[0].marked;
  #assert ue_mark16(e[..],-1,-1,"é",1,1);ue_unmark(e[..]);#assert ue_value(e[..])=="ax漢字éb" && ue_range16(e[..],2)== -1;
  ue_close(e[..]);#assert ue_range16(e[..],0)== -1 && !ue_replace16(e[..],0,0,"x") && !ue_mark16(e[..],0,0,"x",0,0);
}
#test "a field laid out in a page's list: prims inside its box, the caret's rect and index, and the blink's next phase" {
  e:[1]UiEditor;a:[1]Atlas;test_atlas(a[..]);#assert ue_open(e[..],1,"hello");
  sk:=zeron_skin();sk.cmp.caret_blink=0.5;box:=[4]f32.[10,20,200,40];
  r:[4]f32;#assert !ue_rect16(e[..],a[..],0,r[..]);
  #assert ue_layout(e[..],a[..],box[..],sk,0.2);
  list:[64]Prim;n:=ue_prims(e[..],a[..],list[..],0);
  #assert n>2 && list[0].kind==PRIM_CLIP && list[n-1].kind==PRIM_CLIP;
  #assert ue_rect16(e[..],a[..],5,r[..]);#assert r[0]>10;#assert r[1]==20;#assert r[2]==sk.cmp.caret;#assert r[3]==sk.cmp.line;
  #assert ue_index16(e[..],a[..],10,25)==0 && ue_index16(e[..],a[..],500,25)==5;
  b:=ue_blink(e[..]);#assert b>0.29 && b<0.31;
  composer_select_all(e[0].body[..]);#assert ue_blink(e[..])== -1;
  #assert ue_mark16(e[..],-1,-1,"か",1,1);m:=ue_prims(e[..],a[..],list[..],0);#assert m>n;
  box[2]=0;#assert !ue_layout(e[..],a[..],box[..],sk,0);
}
#test "a secure field draws a dot per code point and a press on the dots comes back to the text" {
  e:[1]UiEditor;a:[1]Atlas;test_atlas(a[..]);m:[1]Composer;#assert ue_open(e[..],1,"pä5");
  sk:=zeron_skin();box:=[4]f32.[0,0,200,40];#assert ue_layout(e[..],a[..],box[..],sk,0);
  list:[64]Prim;n:=ue_mask_prims(e[..],a[..],m[..],list[..],0);
  #assert n>2 && typed(m[..])=="•••" && m[0].ed[0].caret==9;
  ue_mask_pointer(e[..],a[..],m[..],0,10,0,1,false);#assert e[0].body[0].ed[0].caret==0;
  ue_mask_pointer(e[..],a[..],m[..],190,10,0,1,true);ue_mask_pointer(e[..],a[..],m[..],190,10,2,1,false);
  #assert e[0].body[0].ed[0].caret==4 && e[0].body[0].ed[0].anchor==0 && selected(e[0].body[..])=="pä5";
}
#test "a byte range replaced is one undo step with the caret after it; a range outside the text is refused" {
  e: [1] UiEditor;
  #assert !ue_replace(e[..], 0, 0, "x");
  #assert ue_open(e[..], 1, "see @ma now");
  #assert ue_replace(e[..], 4, 7, "@src/main.rs") && ue_value(e[..]) == "see @src/main.rs now";
  #assert e[0].body[0].ed[0].caret == 16 && !ue_replace(e[..], 3, 99, "") && !ue_replace(e[..], 5, 4, "");
  composer_undo(e[0].body[..]); ue_committed(e[..]); #assert ue_value(e[..]) == "see @ma now";
}
