// Shared frozen frame oracle, extracted unchanged from frames-checks.coax.
#load "../paint/list.coax";
#load "../layout/round.coax";

FC_PRIMS :: 4096;

#test "frozen frame hash includes a nonzero text offset" {
 p:[1]Prim;p[0].off=1;
 // One metadata word 1000004, followed by eighteen zero float words.
 #assert fc_hash(p[..],1,0)==784846122852;
}

// A list's prims hashed: every number in 1/65536ths, every text's bytes.
fc_q :: (h: int, v: f32) -> int { return (h * 1000003 + cast(int) floor(v * 65536 + 0.5)) & 0xFFFFFFFFFF; }
fc_hash :: (list: [] Prim, n: int, seed: int) -> int {
  h := (seed & 0xFFFFFFFF) * 31 + n;
  for i: 0..<n {
    p := list[i];
    h = (h * 1000003 + p.kind * 7 + p.id * 131 + (ifx p.on then 1 else 0) + p.line * 17 + p.off) & 0xFFFFFFFFFF;
    for v: [16] f32.[p.x, p.y, p.w, p.h, p.radius, p.border, p.a, p.b, p.c, p.d, p.fill.r, p.fill.g, p.fill.b, p.fill.a, p.edge.r, p.edge.a] { h = fc_q(h, v); }
    h = fc_q(fc_q(h, p.edge.g), p.edge.b);
    for c: p.text { h = (h * 257 + cast(int) c) & 0xFFFFFFFFFF; }
  }
  return h;
}

// The hashes as of #13738, Zeron Dark taken from zgx's zeron-dark.json (the composer's Everglade and Verse hashes
// are 6cc616b5eb's: those skins set every colour the composer draws).
FC_WANT :: [9] int.[57101955023, 35688652535, 842496758639,       // zeron: transcript, composer, menus
                    538021595987, 1036568112289, 767849352680,    // everglade
                    64846318443, 396024690953, 655685823925];     // verse
