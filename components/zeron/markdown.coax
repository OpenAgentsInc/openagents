// Zeron's Markdown, what is left of it here: the faces Zeron sets a reply in
// and Zeron Dark's syntax colours. The parser is components/core/markdown.coax,
// the highlighter's roles are components/core/syntax.coax and the line
// wrapper is components/layout/text.coax (components/spec.md, GitHub #13153);
// md_wrap and md_width are those, measured with the atlas's fonts, so every
// width here is the one painting uses. Based on Zeron by Wing, MIT.

#load "composer.coax";
#load "../core/syntax.coax";
#load "../layout/text.coax";

// The faces Zeron sets a reply in (Geist 14, SemiBold for bold, Geist Mono
// for code) or tool text a size down: the Zeron skin's.
md_faces :: (small: bool) -> TextFaces {
  s := zeron_skin();
  return ifx small then uiskin_small_faces(s) else uiskin_faces(s);
}

// The width of text[from..<to] drawn run by run (kerning inside a run).
md_width :: (a: [] Atlas, text: string, runs: [] MdRun, from: int, to: int, small: bool) -> f32 {
  return text_run_width(measure_font(a), md_faces(small), text, runs, from, to);
}
// Wraps text (styled by runs) to width (layout/text.coax text_wrap). Returns the line count (at least one).
md_wrap :: (a: [] Atlas, text: string, runs: [] MdRun, width: f32, small: bool, out: [] TextLine) -> int {
  return text_wrap(measure_font(a), md_faces(small), text, runs, width, out);
}

md_test_atlas :: (a: [] Atlas) { text_test_atlas(a); }

#test "Zeron's faces: Geist 14, SemiBold for bold, Geist Mono for code; tool text a size down" {
  f := md_faces(false); s := md_faces(true);
  #assert f.plain == FONT_INPUT && f.bold == FONT_BOLD && f.code == FONT_MONO_14;
  #assert s.plain == FONT_TOOL && s.bold == FONT_TOOL && s.code == FONT_MONO_12;
  a: [1] Atlas; md_test_atlas(a[..]);
  lines: [4] TextLine; no_runs: [1] MdRun;
  #assert md_wrap(a[..], "aaa bbb cc", no_runs[0..<0], 50, false, lines[..]) == 2 && md_width(a[..], "ab", no_runs[0..<0], 0, 2, false) == 16;
}
