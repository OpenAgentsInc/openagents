// Zeron's picker menus (crates/ui/src/pickers.rs, pickers/compact.rs,
// popover.rs, glass.rs, settings/widgets.rs toggle_switch) for the
// composer's chips, drawn with gpui.coax. The model chip opens the compact
// model picker, Zeron's default: a 256px card whose panel titles the effort
// over the model's name (a button onto the model list) above the effort
// slider (a 28px light-glass rail, the accent-glass fill to just past the
// thumb, the ladder's stops, the 44x32 white thumb); its second page is the
// model list (Back and the provider's tab, the search row, then the rows:
// the brand mark, the name, a description only for rows sharing a name, the
// selected row in the card's selected wash and ring). The access chip
// opens the access menu: each mode over what it allows (a check on the
// chosen one), a hairline, then Plan mode with its switch. Both are
// popover_card: the hairline border, radius 12, shadow-lg, anchored 6px
// from the chip's bottom (or top) at its right edge, kept 8px inside the
// window. Keys as Zeron binds them: the panel's Up/Down open the list on
// the next model, Enter or Space open it, Left/Right/Home/End set the
// effort, Escape closes; the list's arrows move, Enter picks, typing
// filters, Escape returns to the panel; the access menu's arrows move and
// Enter picks (or flips Plan mode). A press outside closes the menu.
//
// What the menus offer is data (PkCatalog): the models with their effort
// ladders and the access modes the active engine supplies (claude.coax's
// Claude catalog, an engine's own). Based on Zeron by Wing, MIT.

#load "transcript.coax";   // its theme roles (ink, wash) and PHI

// Its measures are the skin's (UiMenus, skin.menus: Zeron's are in skin/zeron.coax).
COMPACT_LIST_ROWS :: 7;
PK_EMPTY_ROWS :: 4;          // the list's height while nothing matches, in rows
PK_TABS :: 4;                // providers' tabs at most

PK_MODELS :: 32;
PK_LEVELS :: 8;
PK_ACCESS :: 4;
PK_QUERY :: 64;

// What an engine offers: its models (an id, the name, a description, which
// effort levels each takes), the effort levels, the access modes, and
// whether it has a plan mode. An empty id is the CLI's default model.
PkCatalog :: struct {
  provider: string;             // the provider's name (the list's tab)
  icon: int; tint: Rgba;        // its 14px brand mark and tint
  n: int;
  id: [PK_MODELS] string; label: [PK_MODELS] string; desc: [PK_MODELS] string;
  place: string; place_model: int;   // where one model runs ("This Mac"), shown after its name as a device row's detail
  ladder: [PK_MODELS] int;      // bit k: level k on that model's slider
  levels: int;
  level_id: [PK_LEVELS] string; level_label: [PK_LEVELS] string;
  default_level: int;
  access: int;
  access_label: [PK_ACCESS] string; access_desc: [PK_ACCESS] string;
  access_value: [PK_ACCESS] int;  // each row's value for the engine (its own numbering)
  full_access: int;             // the access mode that asks nothing (the chip is muted on it)
  plan: bool;                   // a plan mode to switch on
}
// What is chosen: indices into the catalog.
PkSel :: struct { model: int; level: int; access: int; plan: bool; }

// The level a model runs at: the chosen one when its ladder has it, else
// the catalog's default, else the ladder's last (-1: no ladder).
pk_level_for :: (cat: [] PkCatalog, m: int, level: int) -> int {
  if m < 0 || m >= cat[0].n || cat[0].ladder[m] == 0 { return -1; }
  if level >= 0 && (cat[0].ladder[m] & (1 << level)) != 0 { return level; }
  if (cat[0].ladder[m] & (1 << cat[0].default_level)) != 0 { return cat[0].default_level; }
  last := -1;
  for k: 0..<cat[0].levels { if (cat[0].ladder[m] & (1 << k)) != 0 { last = k; } }
  return last;
}
// A model's ladder: its levels in order, into out; how many.
pk_ladder :: (cat: [] PkCatalog, m: int, out: [] int) -> int {
  n := 0;
  if m < 0 || m >= cat[0].n { return 0; }
  for k: 0..<cat[0].levels { if (cat[0].ladder[m] & (1 << k)) != 0 && n < out.count { out[n] = k; n += 1; } }
  return n;
}
// Whether another model carries the same name (its description tells them apart).
pk_ambiguous :: (cat: [] PkCatalog, m: int) -> bool {
  for k: 0..<cat[0].n { if k != m && cat[0].label[k] == cat[0].label[m] { return true; } }
  return false;
}

PK_NONE :: 0; PK_MODEL :: 1; PK_ACCESS_MENU :: 2;
KEY_TAB :: -13;   // the host's Tab while a menu is open (composer.coax numbers the rest)

Picker :: struct {
  kind: int;                    // PK_NONE, PK_MODEL (the compact picker), PK_ACCESS_MENU
  list: bool;                   // the model picker's page: the model list
  active: int;                  // the highlighted row (hover or keyboard), -1 none
  keyboard: bool;               // the highlight came from the keyboard
  query: [PK_QUERY] u8; qn: int;   // the model search
  scroll: f32;                  // the list's scroll (px)
  // the chip it opened from (logical px), and which way it opens
  ax: f32; ay: f32; aw: f32; ah: f32;
  below: bool; budget: f32;
  // where it was last drawn
  x: f32; y: f32; w: f32; h: f32;
  title_hover: bool; back_hover: bool;
  sx: f32; sy: f32; sw: f32;    // the effort slider's box
  dragging: bool;
  since: f32;                   // seconds since the last key (the search caret's blink)
  list_y: f32; list_h: f32;     // the list's box (rows start CARD_INSET below its top)
  tab_x: f32;                   // the first provider's tab
  // the providers' tabs (Zeron's harness rail): how many (one once a chat
  // has its engine), which one the list shows, each one's mark
  tabs: int; view: int;
  tab_icon: [4] int; tab_tint: [4] Rgba;
  row_y: [8] f32; row_h: [8] f32; rows: int;   // the access menu's rows (the plan row last)
  // what the user picked, until the screen takes it (-1 none)
  pick_model: int; pick_level: int; pick_access: int; flip_plan: bool;
  skin: UiSkin;                 // the skin the menus are drawn in (pk_skin: Zeron's when none was set)
  pool: [PK_POOL] u8; pool_n: int;                 // the cut labels a layout's prims point into
}
PK_POOL :: 4096;

// menu_geometry: the room the menu may take, above the chip unless that is
// under 180 and there is more below (or below is asked for).
pk_open :: (p: [] Picker, kind: int, cat: [] PkCatalog, sel: PkSel, x: f32, y: f32, w: f32, h: f32, view_h: f32, force_below: bool) {
  m := pk_skin(p).menus;
  p[0].kind = kind; p[0].list = false; p[0].keyboard = false; p[0].qn = 0; p[0].scroll = 0; p[0].dragging = false;
  p[0].ax = x; p[0].ay = y; p[0].aw = w; p[0].ah = h;
  above := y - m.room; below := view_h - (y + h) - m.room;
  if above < 0 { above = 0; }
  if below < 0 { below = 0; }
  p[0].below = force_below || (above < m.below_min && below > above);
  room := ifx p[0].below then below else above;
  p[0].budget = ifx room < m.most then room else m.most;
  p[0].pick_model = -1; p[0].pick_level = -1; p[0].pick_access = -1; p[0].flip_plan = false;
  p[0].tabs = 1; p[0].view = 0;
  // the keyboard highlight starts on the chosen row
  p[0].active = ifx kind == PK_ACCESS_MENU then sel.access else -1;
}
// The providers' tabs the list offers (at most four) and the one it opens on.
pk_tabs :: (p: [] Picker, n: int, home: int) {
  p[0].tabs = ifx n < 1 then 1 else ifx n > PK_TABS then PK_TABS else n;
  p[0].view = ifx home >= 0 && home < p[0].tabs then home else 0;
}
pk_tab :: (p: [] Picker, k: int, icon: int, tint: Rgba) { if k >= 0 && k < PK_TABS { p[0].tab_icon[k] = icon; p[0].tab_tint[k] = tint; } }
// Tab: the next provider's models.
pk_next_tab :: (p: [] Picker) {
  p[0].list = true; p[0].qn = 0; p[0].scroll = 0; p[0].active = 0;
  p[0].view = (p[0].view + 1) % (ifx p[0].tabs < 1 then 1 else p[0].tabs);
}
pk_close :: (p: [] Picker) { p[0].kind = PK_NONE; p[0].list = false; p[0].dragging = false; p[0].active = -1; }
pk_is_open :: (p: [] Picker) -> bool { return p[0].kind != PK_NONE; }

// ---------------------------------------------------------------- the model list's rows

pk_lower :: (c: u8) -> u8 { return ifx c >= 'A' && c <= 'Z' then c + ('a' - 'A') else c; }
pk_contains :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  if needle.count > hay.count { return false; }
  for i: 0..<hay.count - needle.count + 1 {
    ok := true;
    for k: 0..<needle.count { if pk_lower(hay[i + k]) != pk_lower(needle[k]) { ok = false; break; } }
    if ok { return true; }
  }
  return false;
}
pk_query :: (p: [] Picker) -> string { return cast(string) p[0].query[0..<p[0].qn]; }
// The rows the search leaves (every model with none): catalog indices into out; how many.
pk_rows :: (p: [] Picker, cat: [] PkCatalog, out: [] int) -> int {
  q := pk_query(p); n := 0;
  // a query of spaces alone searches nothing
  blank := true;
  for c: q { if c != ' ' { blank = false; } }
  for m: 0..<cat[0].n {
    if !blank && !pk_contains(cat[0].label[m], q) && !pk_contains(cat[0].id[m], q) { continue; }
    if n < out.count { out[n] = m; n += 1; }
  }
  return n;
}
// compact_list_height: the rows (up to seven, four while empty) at a 34px pitch, the card inset around them.
pk_list_height :: (m: UiMenus, rows: int) -> f32 {
  r := ifx rows == 0 then PK_EMPTY_ROWS else ifx rows > COMPACT_LIST_ROWS then COMPACT_LIST_ROWS else rows;
  return cast(f32) r * (m.row + m.gap) + 2 * m.card_inset;
}
// Keeps the active row inside the list's box (scroll_to_item, Nearest).
pk_reveal :: (p: [] Picker, rows: int) {
  m := pk_skin(p).menus;
  pitch := m.row + m.gap;
  view := pk_list_height(m, rows) - 2 * m.card_inset;
  if p[0].list_h > 0 { view = p[0].list_h - 2 * m.card_inset; }
  if p[0].active < 0 { return; }
  top := cast(f32) p[0].active * pitch;
  if top < p[0].scroll { p[0].scroll = top; }
  if top + pitch > p[0].scroll + view { p[0].scroll = top + pitch - view; }
  most := cast(f32) rows * pitch - view;
  if p[0].scroll > most { p[0].scroll = ifx most > 0 then most else 0.0f32; }
  if p[0].scroll < 0 { p[0].scroll = 0; }
}
// The list on the model next to the chosen one (or the chosen one).
pk_show_list :: (p: [] Picker, cat: [] PkCatalog, sel: PkSel, delta: int) {
  p[0].list = true; p[0].qn = 0; p[0].scroll = 0; p[0].list_h = 0;
  rows: [PK_MODELS] int;
  n := pk_rows(p, cat, rows[..]);
  at := -1;
  for k: 0..<n { if rows[k] == sel.model { at = k; } }
  if n > 0 {
    if at < 0 { at = ifx delta < 0 then n - 1 else 0; }
    else { at = ((at + delta) % n + n) % n; }
  }
  p[0].active = at;
  pk_reveal(p, n);
}

// ---------------------------------------------------------------- keys

// A key while a menu is open (composer.coax's key numbering); whether it used it.
pk_key :: (p: [] Picker, cat: [] PkCatalog, sel: PkSel, key: int, mods: int) -> bool {
  if p[0].kind == PK_NONE { return false; }
  p[0].keyboard = true; p[0].since = 0;
  plain := (mods & (MOD_CMD | MOD_CTRL | MOD_ALT)) == 0;
  if p[0].kind == PK_ACCESS_MENU {
    count := cat[0].access + (ifx cat[0].plan then 1 else 0);
    if key == KEY_ESCAPE { pk_close(p); return true; }
    if (key == KEY_UP || key == KEY_DOWN) && count > 0 {
      d := ifx key == KEY_UP then -1 else 1;
      p[0].active = ifx p[0].active < 0 then (ifx d > 0 then 0 else count - 1) else ((p[0].active + d) % count + count) % count;
      return true;
    }
    if key == KEY_ENTER || key == ' ' {
      if p[0].active >= 0 && p[0].active < cat[0].access { p[0].pick_access = p[0].active; pk_close(p); }
      else if p[0].active == cat[0].access && cat[0].plan { p[0].flip_plan = true; }
      return true;
    }
    return true;   // the menu holds the focus: other keys go nowhere
  }
  if !p[0].list {
    if key == KEY_ESCAPE { pk_close(p); return true; }
    if key == KEY_UP || key == KEY_DOWN { pk_show_list(p, cat, sel, ifx key == KEY_UP then -1 else 1); return true; }
    if key == KEY_ENTER || key == ' ' { pk_show_list(p, cat, sel, 0); return true; }
    if key == KEY_TAB && p[0].tabs > 1 { pk_next_tab(p); return true; }
    ladder: [PK_LEVELS] int;
    n := pk_ladder(cat, sel.model, ladder[..]);
    if n > 0 && (key == KEY_LEFT || key == KEY_RIGHT || key == KEY_HOME || key == KEY_END) {
      at := 0; lv := pk_level_for(cat, sel.model, sel.level);
      for k: 0..<n { if ladder[k] == lv { at = k; } }
      if key == KEY_LEFT { at = ifx at > 0 then at - 1 else 0; }
      if key == KEY_RIGHT { at = ifx at + 1 < n then at + 1 else n - 1; }
      if key == KEY_HOME { at = 0; }
      if key == KEY_END { at = n - 1; }
      p[0].pick_level = ladder[at];
      return true;
    }
    return true;
  }
  // the model list (its search holds the focus)
  rows: [PK_MODELS] int;
  n := pk_rows(p, cat, rows[..]);
  if key == KEY_ESCAPE { p[0].list = false; p[0].qn = 0; p[0].active = -1; return true; }
  if key == KEY_TAB { if p[0].tabs > 1 { pk_next_tab(p); } return true; }
  if key == KEY_UP || key == KEY_DOWN {
    if n == 0 { return true; }
    d := ifx key == KEY_UP then -1 else 1;
    p[0].active = ifx p[0].active < 0 then (ifx d > 0 then 0 else n - 1) else ((p[0].active + d) % n + n) % n;
    pk_reveal(p, n);
    return true;
  }
  if key == KEY_ENTER {
    if p[0].active >= 0 && p[0].active < n { p[0].pick_model = rows[p[0].active]; p[0].list = false; p[0].qn = 0; p[0].active = -1; }
    return true;
  }
  if key == KEY_BACKSPACE {
    if plain && p[0].qn > 0 {
      k := p[0].qn - 1;
      while k > 0 && (cast(int) p[0].query[k] & 0xC0) == 0x80 { k -= 1; }
      p[0].qn = k;
    } else if (mods & (MOD_CMD | MOD_ALT)) != 0 { p[0].qn = 0; }
    pk_refilter(p, cat);
    return true;
  }
  return true;
}
// Typing while the list is open goes to its search; the highlight moves to the first match.
pk_text :: (p: [] Picker, cat: [] PkCatalog, text: string) -> bool {
  if p[0].kind != PK_MODEL || !p[0].list { return p[0].kind != PK_NONE; }
  p[0].since = 0;
  for c: text {
    if c == '\n' || c == '\r' || c == '\t' { continue; }
    if p[0].qn < PK_QUERY { p[0].query[p[0].qn] = c; p[0].qn += 1; }
  }
  pk_refilter(p, cat);
  return true;
}
pk_refilter :: (p: [] Picker, cat: [] PkCatalog) {
  rows: [PK_MODELS] int;
  n := pk_rows(p, cat, rows[..]);
  p[0].scroll = 0;
  p[0].active = ifx n > 0 then 0 else -1;
}

// ---------------------------------------------------------------- the pointer

pk_inside :: (p: [] Picker, x: f32, y: f32) -> bool { return x >= p[0].x && x < p[0].x + p[0].w && y >= p[0].y && y < p[0].y + p[0].h; }
// The slider's level under x (effort_index: stops include both ends).
pk_slider_pick :: (p: [] Picker, cat: [] PkCatalog, sel: PkSel, x: f32) {
  ladder: [PK_LEVELS] int;
  n := pk_ladder(cat, sel.model, ladder[..]);
  if n == 0 { return; }
  m := pk_skin(p).menus;
  run := p[0].sw - 2 * m.thumb_inset;
  f := (x - p[0].sx - m.thumb_inset) / (ifx run < 1 then 1.0f32 else run);
  f = ifx f < 0 then 0.0f32 else ifx f > 1 then 1.0f32 else f;
  p[0].pick_level = ladder[cast(int) floor(f * cast(f32) (n - 1) + 0.5)];
}
// The list row (its index among the rows) under y, or -1.
pk_list_row :: (p: [] Picker, rows: int, y: f32) -> int {
  m := pk_skin(p).menus;
  if y < p[0].list_y + m.card_inset || y >= p[0].list_y + p[0].list_h - m.card_inset { return -1; }
  pitch := m.row + m.gap;
  off := y - p[0].list_y - m.card_inset + p[0].scroll;
  k := cast(int) floor(off / pitch);
  if off - cast(f32) k * pitch >= m.row || k < 0 || k >= rows { return -1; }
  return k;
}
// A press at logical (x, y): true when the menu took it. Outside the card
// it closes the menu and lets the press through (on_mouse_down_out); the
// chip it opened from is the screen's to toggle.
pk_press :: (p: [] Picker, cat: [] PkCatalog, sel: PkSel, x: f32, y: f32) -> bool {
  if p[0].kind == PK_NONE { return false; }
  if !pk_inside(p, x, y) { pk_close(p); return false; }
  p[0].keyboard = false;
  m := pk_skin(p).menus;
  if p[0].kind == PK_ACCESS_MENU {
    for k: 0..<p[0].rows {
      if y >= p[0].row_y[k] && y < p[0].row_y[k] + p[0].row_h[k] {
        if k < cat[0].access { p[0].pick_access = k; pk_close(p); }
        else { p[0].flip_plan = true; }
      }
    }
    return true;
  }
  if !p[0].list {
    if y >= p[0].sy && y < p[0].sy + m.slider && x >= p[0].sx && x < p[0].sx + p[0].sw {
      p[0].dragging = true; pk_slider_pick(p, cat, sel, x);
    } else if y < p[0].sy || pk_ladder_count(cat, sel.model) == 0 {
      if y >= p[0].y + 1 + m.card_inset && y < p[0].y + 1 + m.card_inset + pk_header_height(m, cat, sel) { pk_show_list(p, cat, sel, 0); p[0].active = -1; }
    }
    return true;
  }
  // the list page: Back, the rows
  if y < p[0].y + 1 + m.row + 2 * m.card_inset && x < p[0].x + 1 + m.card_inset + m.row {
    p[0].list = false; p[0].qn = 0; p[0].active = -1; return true;
  }
  if y < p[0].y + 1 + m.row + 2 * m.card_inset {
    t := cast(int) floor((x - p[0].tab_x) / (m.row + m.gap));
    if x >= p[0].tab_x && t < p[0].tabs && t != p[0].view { p[0].view = t; p[0].qn = 0; p[0].scroll = 0; p[0].active = 0; }
    return true;
  }
  rows: [PK_MODELS] int;
  n := pk_rows(p, cat, rows[..]);
  k := pk_list_row(p, n, y);
  if k >= 0 { p[0].pick_model = rows[k]; p[0].list = false; p[0].qn = 0; p[0].active = -1; }
  return true;
}
pk_ladder_count :: (cat: [] PkCatalog, m: int) -> int { ladder: [PK_LEVELS] int; return pk_ladder(cat, m, ladder[..]); }
pk_header_height :: (m: UiMenus, cat: [] PkCatalog, sel: PkSel) -> f32 { return ifx pk_ladder_count(cat, sel.model) == 0 then m.header_single else m.header; }
// The pointer moving (a drag of the thumb, else hover).
pk_move :: (p: [] Picker, cat: [] PkCatalog, sel: PkSel, x: f32, y: f32) {
  if p[0].kind == PK_NONE { return; }
  if p[0].dragging { pk_slider_pick(p, cat, sel, x); return; }
  inside := pk_inside(p, x, y);
  m := pk_skin(p).menus;
  p[0].title_hover = false; p[0].back_hover = false;
  if p[0].kind == PK_ACCESS_MENU {
    if !inside { return; }
    for k: 0..<p[0].rows { if y >= p[0].row_y[k] && y < p[0].row_y[k] + p[0].row_h[k] { p[0].active = k; p[0].keyboard = false; } }
    return;
  }
  if !inside { return; }
  if !p[0].list {
    top := p[0].y + 1 + m.card_inset;
    p[0].title_hover = y >= top && y < top + pk_header_height(m, cat, sel);
    return;
  }
  p[0].back_hover = y < p[0].y + 1 + m.row + 2 * m.card_inset && x < p[0].x + 1 + m.card_inset + m.row;
  rows: [PK_MODELS] int;
  n := pk_rows(p, cat, rows[..]);
  k := pk_list_row(p, n, y);
  if k >= 0 { p[0].active = k; p[0].keyboard = false; }
}
pk_release :: (p: [] Picker) { p[0].dragging = false; }
// The wheel over the list scrolls it.
pk_wheel :: (p: [] Picker, cat: [] PkCatalog, dy: f32) -> bool {
  if p[0].kind != PK_MODEL || !p[0].list { return p[0].kind != PK_NONE; }
  rows: [PK_MODELS] int;
  n := pk_rows(p, cat, rows[..]);
  m := pk_skin(p).menus;
  most := cast(f32) n * (m.row + m.gap) - (p[0].list_h - 2 * m.card_inset);
  s := p[0].scroll - dy;
  p[0].scroll = ifx s < 0 then 0.0f32 else ifx s > most then (ifx most > 0 then most else 0.0f32) else s;
  return true;
}

// ---------------------------------------------------------------- paint

// The menus paint into a display list (paint/list.coax) in their skin's
// roles, and pk_paint draws it (backend/gpu.coax gpu_draw). Zeron's popover
// roles (card_selected_bg, card_selected_shadows, glass.rs's plates) are
// the Zeron skin's.
PK_PRIMS :: 512;

// The skin the menus are drawn in: Zeron's until pk_set_skin gives them another.
pk_skin :: (p: [] Picker) -> UiSkin {
  if !uiskin_is_set(p[0].skin) { p[0].skin = zeron_skin(); }
  return p[0].skin;
}
pk_set_skin :: (p: [] Picker, skin: UiSkin) { p[0].skin = skin; }

// A copy of s in the menu's text pool, which lives until the next layout
// (a prim keeps a slice of its text, so a cut label must outlive its buffer).
pk_keep :: (p: [] Picker, s: string) -> string {
  if p[0].pool_n + s.count > PK_POOL { return ""; }
  at := p[0].pool_n;
  for k: 0..<s.count { p[0].pool[at + k] = s[k]; }
  p[0].pool_n += s.count;
  return cast(string) p[0].pool[at..<at + s.count];
}

// popover_card: shadow-lg (Tailwind's two drops), the surface, the hairline border.
pk_card :: (list: [] Prim, n: int, sk: UiSkin, x: f32, y: f32, w: f32, h: f32) -> int {
  k := uiskin_float(list, n, sk, x, y, w, h, sk.menus.card_radius);
  // a card floats over what it covers: a see-through surface (Everglade's) is laid on the canvas first
  return prim_box(list, k, x, y, w, h, sk.menus.card_radius, 1, flatten(sk.surface, sk.canvas), sk.field_edge);
}

// Text cut to a width with an ellipsis (GPUI truncate), into buf.
pk_fit :: (a: [] Atlas, font: int, s: string, w: f32, buf: [] u8) -> string {
  if text_width(a, font, s) <= w { return s; }
  ell := "…";
  room := w - text_width(a, font, ell);
  k := 0; x: f32 = 0; prev := -1;
  while k < s.count {
    st := gp_step(a, font, s, k, prev);
    if x + st.advance > room { break; }
    x += st.advance; prev = st.glyph; k += st.len;
  }
  n := 0;
  for i: 0..<k { if n < buf.count { buf[n] = s[i]; n += 1; } }
  for c: ell { if n < buf.count { buf[n] = c; n += 1; } }
  return cast(string) buf[0..<n];
}

// Where the card goes: its right edge on the chip's, 6px past the chip
// (below or above), inside the window's 8px margin.
pk_place :: (p: [] Picker, w: f32, h: f32, view_w: f32, view_h: f32) {
  m := pk_skin(p).menus;
  x := p[0].ax + p[0].aw - w;
  y := ifx p[0].below then p[0].ay + p[0].ah + m.offset else p[0].ay - m.offset - h;
  if x + w > view_w - m.margin { x = view_w - m.margin - w; }
  if x < m.margin { x = m.margin; }
  if y + h > view_h - m.margin { y = view_h - m.margin - h; }
  if y < m.margin { y = m.margin; }
  p[0].x = x; p[0].y = y; p[0].w = w; p[0].h = h;
}

// The open menu into list (laid out too); returns the count.
pk_prims :: (list: [] Prim, n: int, p: [] Picker, cat: [] PkCatalog, sel: PkSel, a: [] Atlas, view_w: f32, view_h: f32) -> int {
  if p[0].kind == PK_NONE { return n; }
  sk := pk_skin(p);
  p[0].pool_n = 0;
  if p[0].kind == PK_ACCESS_MENU { return pk_access_prims(list, n, p, cat, sel, a, sk, view_w, view_h); }
  if p[0].list { return pk_list_prims(list, n, p, cat, sel, a, sk, view_w, view_h); }
  return pk_panel_prims(list, n, p, cat, sel, a, sk, view_w, view_h);
}
// The open menu, over everything; returns the vertex count. It is drawn in its own skin (pk_skin); th is not read.
pk_paint :: (out: [] f32, at: int, p: [] Picker, cat: [] PkCatalog, sel: PkSel, a: [] Atlas, th: Theme, d: f32, view_w: f32, view_h: f32) -> int {
  if p[0].kind == PK_NONE || !a[0].ready { return at; }
  list: [PK_PRIMS] Prim;
  n := pk_prims(list[..], 0, p, cat, sel, a, view_w, view_h);
  return gpu_draw(out, at, a, d, list[0..<n], 0, 0, -PRIM_OPEN, PRIM_OPEN);
}

// The compact panel: the header (the effort over the model's name, a
// button onto the list), then the effort slider.
pk_panel_prims :: (list: [] Prim, n0: int, p: [] Picker, cat: [] PkCatalog, sel: PkSel, a: [] Atlas, sk: UiSkin, view_w: f32, view_h: f32) -> int {
  m := sk.menus;
  ladder: [PK_LEVELS] int;
  n := pk_ladder(cat, sel.model, ladder[..]);
  head := ifx n == 0 then m.header_single else m.header;
  h := m.card_borders + 2 * m.card_inset + head + (ifx n == 0 then 0.0f32 else m.slider_top + m.slider + m.slider_bottom);
  if h > p[0].budget && p[0].budget > 0 { h = p[0].budget; }
  pk_place(p, m.width, h, view_w, view_h);
  x := p[0].x; y := p[0].y;
  k := pk_card(list, n0, sk, x, y, m.width, h);
  ix := x + 1 + m.card_inset; iy := y + 1 + m.card_inset; iw := m.width - 2 - 2 * m.card_inset;
  // the title button: the menu's hover wash
  if p[0].title_hover { k = prim_fill(list, k, ix, iy, iw, head, m.item_radius, sk.menu_hover); }
  name := ifx sel.model >= 0 && sel.model < cat[0].n then cat[0].label[sel.model] else "";
  buf: [160] u8;
  lv := pk_level_for(cat, sel.model, sel.level);
  tx := ix + m.pad_x;
  shift := ifx p[0].title_hover then m.chevron_shift else 0.0f32;
  chev := opacity(ifx p[0].title_hover then sk.ink else sk.muted, ifx p[0].title_hover then 1.0f32 else m.chevron_ink);
  if n > 0 {
    // SemiBold 14 on a 17px line, then the name Medium 12 on 15, both centered in the 48px header
    ty := iy + round_layout((head - m.title_line - m.name_line) / 2);
    k = prim_text(list, k, tx, ty, 0, m.title_line, sk.strong.face, sk.ink, ifx lv >= 0 then cat[0].level_label[lv] else "Default");
    nm := pk_keep(p, pk_fit(a, sk.label.face, name, iw - 2 * m.pad_x - m.title_chevron_room, buf[..]));
    tone := ifx p[0].title_hover then sk.ink else sk.muted;
    k = prim_text(list, k, tx, ty + m.title_line, 0, m.name_line, sk.label.face, tone, nm);
    cx := tx + text_width(a, sk.label.face, nm) + m.chevron_gap;
    k = prim_icon(list, k, ICON_CHEVRON_10, cx + shift, ty + m.title_line + m.name_chevron_dy, m.chevron, m.chevron, chev);
  } else {
    ty := iy + round_layout((head - m.title_line) / 2);
    nm := pk_keep(p, pk_fit(a, sk.strong.face, name, iw - 2 * m.pad_x - m.title_chevron_room, buf[..]));
    k = prim_text(list, k, tx, ty, 0, m.title_line, sk.strong.face, sk.ink, nm);
    cx := tx + text_width(a, sk.strong.face, nm) + m.chevron_gap;
    k = prim_icon(list, k, ICON_CHEVRON_10, cx + shift, ty + m.title_chevron_dy, m.chevron, m.chevron, chev);
  }
  if n == 0 { p[0].sw = 0; return k; }
  // the slider: px 8, 2 above and 4 below its 36px box
  sx := ix + m.pad_x; sy := iy + head + m.slider_top; sw := iw - 2 * m.pad_x;
  p[0].sx = sx; p[0].sy = sy; p[0].sw = sw;
  at_stop := 0;
  for q: 0..<n { if ladder[q] == lv { at_stop = q; } }
  fraction := ifx n > 1 then cast(f32) at_stop / cast(f32) (n - 1) else 0.0f32;
  run := sw - 2 * m.thumb_inset;
  center := m.thumb_inset + fraction * run;
  k = uiskin_plate(list, k, sx, sy + m.rail_top, sw, m.rail, m.rail / 2, sk.track);
  fill_w := ifx center + m.fill_past < sw then center + m.fill_past else sw;
  k = uiskin_plate(list, k, sx, sy + m.rail_top, fill_w, m.rail, m.rail / 2, uiskin_accent_plate(sk));
  // the stops: filled up to the thumb, open past it
  for q: 0..<n {
    stop := ifx n > 1 then cast(f32) q / cast(f32) (n - 1) else 0.0f32;
    c := ifx stop <= fraction then sk.stop_on else opacity(sk.muted, m.stop_off_ink);
    k = prim_fill(list, k, sx + m.thumb_inset + stop * run - m.stop / 2, sy + m.slider / 2 - m.stop / 2, m.stop, m.stop, m.stop_radius, c);
  }
  return uiskin_plate(list, k, sx + center - m.thumb_w / 2, sy + (m.slider - m.thumb_h) / 2, m.thumb_w, m.thumb_h, m.thumb_h / 2, sk.thumb);
}

// The model list: Back and the provider's tab, the search row, the rows.
pk_list_prims :: (list: [] Prim, n0: int, p: [] Picker, cat: [] PkCatalog, sel: PkSel, a: [] Atlas, sk: UiSkin, view_w: f32, view_h: f32) -> int {
  m := sk.menus;
  rows: [PK_MODELS] int;
  n := pk_rows(p, cat, rows[..]);
  list_h := pk_list_height(m, n);
  if p[0].budget > 0 && m.list_header + list_h + m.card_borders > p[0].budget {
    list_h = p[0].budget - m.list_header - m.card_borders;
    if list_h < 0 { list_h = 0; }
  }
  h := m.list_header + list_h + m.card_borders;
  pk_place(p, m.width, h, view_w, view_h);
  x := p[0].x; y := p[0].y; w := m.width;
  k := pk_card(list, n0, sk, x, y, w, h);
  ix := x + 1; iy := y + 1; iw := w - 2;
  // the strip: Back, then the provider's tab (viewed: the hover wash), each a row-height square
  bx := ix + m.card_inset; by := iy + m.card_inset;
  if p[0].back_hover { k = prim_fill(list, k, bx, by, m.row, m.row, m.item_radius, sk.menu_hover); }
  k = prim_icon(list, k, ICON_BACK, bx, by, m.row, m.row, sk.muted);
  tx := bx + m.row + m.gap;
  p[0].tab_x = tx;
  // the tabs: the viewed one on the hover wash, the others at 0.7 (each mark 16px, centered); none while searching
  if pk_query(p).count == 0 {
    for t: 0..<p[0].tabs {
      kx := tx + cast(f32) t * (m.row + m.gap);
      icon := p[0].tab_icon[t]; tint := p[0].tab_tint[t];
      if t == p[0].view { k = prim_fill(list, k, kx, by, m.row, m.row, m.item_radius, sk.hover); }
      ti := (m.row - m.tab_icon) / 2;
      k = prim_icon(list, k, icon, kx + ti, by + ti, m.tab_icon, m.tab_icon, ifx t == p[0].view then tint else opacity(tint, m.tab_ink));
    }
  }
  // the search row: 40 tall, px 10, the magnifier, the query (or its placeholder), the rule under it
  sy := iy + m.row + 2 * m.card_inset;
  k = prim_icon(list, k, ICON_MAGNIFER_14, ix + m.search_icon_x, sy + (m.search_row - m.search_icon) / 2, m.search_icon, m.search_icon, sk.muted);
  // the search is a ComposerInput: 14px (Medium, inherited) on the composer's 22.75 line, its placeholder, its blinking caret
  qlh := m.search_line;
  qy := sy + m.search_text_dy;
  q := pk_query(p);
  qx := ix + m.search_icon_x + m.search_icon + m.search_gap;
  if q.count == 0 { k = prim_text(list, k, qx, qy, 0, qlh, sk.search.face, sk.faint, "Search models…"); }
  else { k = prim_text(list, k, qx, qy, 0, qlh, sk.search.face, sk.ink, q); }
  if cast(int) floor(p[0].since / sk.cmp.caret_blink) % 2 == 0 {
    k = prim_fill(list, k, qx + text_width(a, sk.search.face, q), qy, m.caret, qlh, 0, sk.accent);
  }
  k = prim_fill(list, k, ix, sy + m.search_row - 1, iw, 1, 0, sk.menu_rule);
  // the rows on the list's wash, py 4, clipped to the list's box
  ly := sy + m.search_row;
  p[0].list_y = ly; p[0].list_h = list_h;
  k = prim_fill(list, k, ix, ly, iw, list_h, 0, sk.list_wash);
  k = prim_clip(list, k, ix, ly, ix + iw, ly + list_h);
  pitch := m.row + m.gap;
  rx := ix + m.card_inset; rw := iw - 2 * m.card_inset;
  lh := sk.label.line;
  buf: [160] u8; dbuf: [160] u8;
  if n == 0 {
    k = prim_text(list, k, rx + m.pad_x, ly + m.card_inset + (m.row - lh) / 2, 0, lh, sk.tool.face, sk.muted, "No models found");
  }
  for r: 0..<n {
    ry := ly + m.card_inset + cast(f32) r * pitch - p[0].scroll;
    if ry + m.row < ly || ry > ly + list_h { continue; }
    md := rows[r];
    is_sel := md == sel.model;
    if is_sel {
      k = prim_fill(list, k, rx, ry, rw, m.row, m.item_radius, sk.menu_selected);
      k = prim_box(list, k, rx, ry, rw, m.row, m.item_radius, 1, sk.clear, sk.menu_ring);
    } else if r == p[0].active {
      k = prim_fill(list, k, rx, ry, rw, m.row, m.item_radius, sk.menu_hover);
    }
    k = prim_icon(list, k, cat[0].icon, rx + m.pad_x, ry + (m.row - m.row_icon) / 2, m.row_icon, m.row_icon, cat[0].tint);
    lx := rx + m.pad_x + m.row_icon + m.row_gap;
    room := rx + rw - m.star_inset - m.star - m.pad_x - lx;   // the star button's room stays (its control is not offered)
    ty := ry + round_half_toward_zero((m.row - lh) / 2);
    label := pk_keep(p, pk_fit(a, sk.label.face, cat[0].label[md], room, buf[..]));
    k = prim_text(list, k, lx, ty, 0, lh, sk.label.face, sk.ink, label);
    // the muted detail after the name: where the model runs (as pickers.rs's
    // device rows put a checkout's path), else the description that tells
    // identically named rows apart
    detail := ifx md == cat[0].place_model && cat[0].place.count > 0 then cat[0].place else ifx pk_ambiguous(cat, md) then cat[0].desc[md] else "";
    if detail.count > 0 {
      dx := lx + text_width(a, sk.label.face, label) + m.detail_gap;
      // a place may run into the star's room (no star is drawn); a description keeps clear of it
      if md == cat[0].place_model && cat[0].place.count > 0 {
        room = rx + rw - m.pad_x - lx;
        // too long: its first part ("coderos-4080 · RTX 4080" -> "coderos-4080") before an ellipsis
        if text_width(a, sk.menu_small.face, detail) > room - (dx - lx) { detail = pk_first_part(detail); }
      }
      if room - (dx - lx) > m.detail_min {
        // baseline-aligned with the name
        lf := sk.label.face; sf := sk.menu_small.face;
        dlh := sk.menu_small.line;
        base := ty + (lh - a[0].fonts[lf].ascent - a[0].fonts[lf].descent) / 2 + a[0].fonts[lf].ascent;
        dty := base - a[0].fonts[sf].ascent - (dlh - a[0].fonts[sf].ascent - a[0].fonts[sf].descent) / 2;
        k = prim_text(list, k, dx, dty, 0, dlh, sf, sk.muted, pk_keep(p, pk_fit(a, sf, detail, room - (dx - lx), dbuf[..])));
      }
    }
  }
  return prim_unclip(list, k);
}

// A detail's text before its first " · " (all of it when there is none).
pk_first_part :: (s: string) -> string {
  for k: 0..<s.count { if k + 1 < s.count && s[k] == ' ' && s[k + 1] == 0xC2 { return cast(string) s[0..<k]; } }
  return s;
}

#test "a place too long for its row keeps its first part" {
  #assert pk_first_part("coderos-4080 · RTX 4080") == "coderos-4080" && pk_first_part("This Mac") == "This Mac";
}

// A menu row's description wrapped to w (its small face, at spaces): line ends into ends; how many lines.
pk_wrap :: (a: [] Atlas, face: int, s: string, w: f32, ends: [] int) -> int {
  n := 0; start := 0;
  while start < s.count && n < ends.count {
    x: f32 = 0; i := start; brk := -1; prev := -1; stop := s.count;
    while i < s.count {
      st := gp_step(a, face, s, i, prev);
      if x + st.advance > w && i > start { stop = ifx brk > start then brk else i; break; }
      if s[i] == ' ' { brk = i; }
      x += st.advance; prev = st.glyph; i += st.len;
    }
    ends[n] = stop; n += 1;
    start = stop;
    while start < s.count && s[start] == ' ' { start += 1; }
  }
  return ifx n == 0 then 1 else n;
}
// A row's height: py 6, the 13px label and its description's lines on
// phi lines, each line box whole pixels (the skin's line and desc_line).
pk_row_height :: (m: UiMenus, a: [] Atlas, face: int, desc: string, w: f32) -> f32 {
  ends: [8] int;
  return 2 * m.row_py + m.line + cast(f32) pk_wrap(a, face, desc, w, ends[..]) * m.desc_line;
}

// The access menu: the modes, a divider, Plan mode with its switch.
pk_access_prims :: (list: [] Prim, n0: int, p: [] Picker, cat: [] PkCatalog, sel: PkSel, a: [] Atlas, sk: UiSkin, view_w: f32, view_h: f32) -> int {
  m := sk.menus;
  w := m.access_width;
  rw := w - 2 - 2 * m.card_inset;
  check_w := m.check + m.check_gap;
  text_w := rw - 2 * m.pad_x - check_w;
  plan_text_w := rw - 2 * m.pad_x - m.switch_w - m.switch_gap;
  plan_desc := "Explore and propose a plan before changing anything.";
  sf := sk.menu_small.face;
  // the rows' heights, laid out as Taffy rounds them
  hs: [8] f32; n := 0;
  for k: 0..<cat[0].access { hs[n] = pk_row_height(m, a, sf, cat[0].access_desc[k], text_w); n += 1; }
  if cat[0].plan { hs[n] = pk_row_height(m, a, sf, plan_desc, plan_text_w); n += 1; }
  content: f32 = 0;
  for k: 0..<n { content += hs[k]; }
  content += cast(f32) (n - 1) * m.gap;
  if cat[0].plan { content += 1 + 2 * m.gap + m.gap; }   // the separator and its gap
  h := round_layout(m.card_borders + 2 * m.card_inset + content);
  pk_place(p, w, h, view_w, view_h);
  x := p[0].x; y := p[0].y;
  v := pk_card(list, n0, sk, x, y, w, h);
  rx := x + 1 + m.card_inset;
  ry := y + 1 + m.card_inset;
  p[0].rows = n;
  lh := m.line; dlh := m.desc_line;
  for k: 0..<n {
    plan_row := k == cat[0].access;
    if plan_row {
      ry += m.gap;
      sep_y := round_layout(ry);
      v = prim_fill(list, v, x + 1, sep_y, w - 2, 1, 0, sk.menu_divider);
      ry += 1 + m.gap + m.gap;
    }
    top := round_layout(ry); bottom := round_layout(ry + hs[k]);
    p[0].row_y[k] = top; p[0].row_h[k] = bottom - top;
    chosen := !plan_row && k == sel.access;
    if chosen || k == p[0].active { v = prim_fill(list, v, rx, top, rw, bottom - top, m.item_radius, sk.menu_selected); }
    label := ifx plan_row then "Plan mode" else cat[0].access_label[k];
    desc := ifx plan_row then plan_desc else cat[0].access_desc[k];
    tone := ifx chosen || k == p[0].active then sk.ink else opacity(sk.ink, m.label_ink);
    v = prim_text(list, v, rx + m.pad_x, top + m.row_py, 0, lh, sk.menu.face, tone, label);
    ends: [8] int;
    nl := pk_wrap(a, sf, desc, ifx plan_row then plan_text_w else text_w, ends[..]);
    from := 0;
    for q: 0..<nl {
      to := ends[q];
      v = prim_text(list, v, rx + m.pad_x, top + m.row_py + lh + cast(f32) q * dlh, 0, dlh, sf, sk.muted, cast(string) desc[from..<to]);
      from = to;
      while from < desc.count && desc[from] == ' ' { from += 1; }
    }
    if chosen { v = prim_icon(list, v, ICON_CHECK, rx + rw - m.pad_x - m.check, top + (bottom - top - m.check) / 2, m.check, m.check, sk.muted); }
    if plan_row { v = pk_switch(list, v, sk, rx + rw - m.pad_x - m.switch_w, top + (bottom - top - m.switch_h) / 2, sel.plan); }
    ry += hs[k] + m.gap;
  }
  return v;
}

// toggle_switch, opaque (not frost): the track (the accent darkened by the
// switch's shade when on, its wash over the surface when off) with its 1px
// rim, the on mark (a 1.2x7.2 bar) or the off mark (a 6.4 ring), and the
// knob with its rim.
pk_switch :: (list: [] Prim, n: int, sk: UiSkin, x: f32, y: f32, on: bool) -> int {
  m := sk.menus;
  surface := sk.surface;
  track := ifx on then flatten(sk.switch_shade, sk.accent) else flatten(sk.switch_wash, surface);
  rim := ifx on then flatten(sk.switch_rim, track) else flatten(sk.field_edge, track);
  ty := y + m.switch_track_dy;
  k := prim_box(list, n, x, ty, m.switch_w, m.switch_track, m.switch_track / 2, 1, track, rim);
  empty := m.switch_empty;
  pad := (empty - m.switch_mark) / 2;
  my := ty + m.switch_mark_dy;
  if on {
    k = prim_fill(list, k, x + pad + m.bar_dx, my, m.bar_w, m.bar_h, m.bar_radius, sk.switch_mark);
  } else {
    mx := x + m.switch_w - pad - m.switch_mark;
    k = prim_box(list, k, mx + m.ring_in, my + m.ring_in, m.ring, m.ring, m.ring_radius, 1, sk.clear, sk.switch_ring);
  }
  thumb := flatten(sk.switch_knob, surface);
  thumb_h := m.switch_knob_h;
  tx := x + m.switch_inset + (ifx on then m.switch_travel else 0.0f32);
  return prim_box(list, k, tx, ty + m.switch_inset, m.switch_knob, thumb_h, thumb_h / 2, 1, thumb, flatten(sk.switch_knob_rim, thumb));
}

// ---------------------------------------------------------------- checks

// Written into the caller's catalog: its strings outnumber the 64 a returned
// value's borrow analysis follows.
test_catalog :: (out: [] PkCatalog) {
  c := PkCatalog.{provider = "Claude", icon = ICON_CLAUDE_14, tint = zeron_dark().claude, n = 4, levels = 5, default_level = 2,
                  access = 3, full_access = 2, plan = true};
  c.id[0] = ""; c.label[0] = "Default (recommended)"; c.ladder[0] = 31;
  c.id[1] = "claude-opus-5-5"; c.label[1] = "Opus 5.5"; c.desc[1] = "Best for everyday, complex tasks"; c.ladder[1] = 31;
  c.id[2] = "claude-sonnet-5-5"; c.label[2] = "Sonnet 5.5"; c.desc[2] = "Most efficient for simpler tasks"; c.ladder[2] = 31;
  c.id[3] = "claude-haiku-4-5"; c.label[3] = "Haiku 4.5"; c.ladder[3] = 0;
  names := [5] string.["Low", "Medium", "High", "X-High", "Max"];
  ids := [5] string.["low", "medium", "high", "xhigh", "max"];
  for k: 0..<5 { c.level_id[k] = ids[k]; c.level_label[k] = names[k]; }
  c.access_label[0] = "Supervised"; c.access_desc[0] = "Ask before commands and file changes.";
  c.access_label[1] = "Auto-accept edits"; c.access_desc[1] = "Apply edits, ask before other actions.";
  c.access_label[2] = "Full access"; c.access_desc[2] = "Run commands and edits without asking.";
  out[0] = c;
}

#test "the panel's keys: Left/Right/Home/End step the effort along the model's ladder; Up/Down open the list beside it" {
  cat: [1] PkCatalog; test_catalog(cat[..]);
  p: [1] Picker;
  sel := PkSel.{model = 0, level = 2, access = 2};
  pk_open(p[..], PK_MODEL, cat[..], sel, 600, 450, 200, 32, 880, true);
  #assert pk_is_open(p[..]) && p[0].below && p[0].budget == 880 - 482 - 14;
  #assert pk_key(p[..], cat[..], sel, KEY_RIGHT, 0) && p[0].pick_level == 3;
  #assert pk_key(p[..], cat[..], sel, KEY_HOME, 0) && p[0].pick_level == 0;
  #assert pk_key(p[..], cat[..], sel, KEY_END, 0) && p[0].pick_level == 4;
  sel.level = 0;
  #assert pk_key(p[..], cat[..], sel, KEY_LEFT, 0) && p[0].pick_level == 0;
  // Haiku 4.5 has no ladder: no level, the arrows do nothing to it
  #assert pk_level_for(cat[..], 3, 2) == -1 && pk_level_for(cat[..], 1, 9) == 2 && pk_level_for(cat[..], 1, 4) == 4;
  #assert pk_key(p[..], cat[..], sel, KEY_DOWN, 0) && p[0].list && p[0].active == 1;
  #assert pk_key(p[..], cat[..], sel, KEY_UP, 0) && p[0].active == 0;
  #assert pk_key(p[..], cat[..], sel, KEY_UP, 0) && p[0].active == 3;     // wraps
  #assert pk_key(p[..], cat[..], sel, KEY_ENTER, 0) && p[0].pick_model == 3 && !p[0].list && pk_is_open(p[..]);
  #assert pk_key(p[..], cat[..], sel, KEY_ESCAPE, 0) && !pk_is_open(p[..]);
}

#test "typing filters the model list, Backspace widens it, Escape returns to the panel" {
  cat: [1] PkCatalog; test_catalog(cat[..]);
  p: [1] Picker;
  sel := PkSel.{model = 0, level = 2, access = 2};
  pk_open(p[..], PK_MODEL, cat[..], sel, 600, 600, 200, 32, 880, false);
  #assert !p[0].below;   // in a chat the menu opens above
  #assert pk_key(p[..], cat[..], sel, KEY_ENTER, 0) && p[0].list && p[0].active == 0;
  #assert pk_text(p[..], cat[..], "5.5");
  rows: [PK_MODELS] int;
  #assert pk_rows(p[..], cat[..], rows[..]) == 2 && rows[0] == 1 && rows[1] == 2 && p[0].active == 0;
  #assert pk_text(p[..], cat[..], "x") && pk_rows(p[..], cat[..], rows[..]) == 0 && p[0].active == -1;
  #assert pk_key(p[..], cat[..], sel, KEY_BACKSPACE, 0) && pk_rows(p[..], cat[..], rows[..]) == 2;
  #assert pk_key(p[..], cat[..], sel, KEY_DOWN, 0) && p[0].active == 1;
  #assert pk_key(p[..], cat[..], sel, KEY_ENTER, 0) && p[0].pick_model == 2;
  #assert pk_key(p[..], cat[..], sel, KEY_ENTER, 0) && p[0].list;
  #assert pk_key(p[..], cat[..], sel, KEY_ESCAPE, 0) && !p[0].list && pk_is_open(p[..]) && p[0].qn == 0;
  // the descriptions: only for rows sharing a name
  #assert !pk_ambiguous(cat[..], 1) && !pk_ambiguous(cat[..], 0);
  cat[0].label[2] = "Opus 5.5";
  #assert pk_ambiguous(cat[..], 1) && pk_ambiguous(cat[..], 2);
}

#test "the access menu: arrows move over the modes and Plan mode, Enter picks and closes, or flips Plan mode" {
  cat: [1] PkCatalog; test_catalog(cat[..]);
  p: [1] Picker;
  sel := PkSel.{model = 0, level = 2, access = 2};
  pk_open(p[..], PK_ACCESS_MENU, cat[..], sel, 600, 450, 80, 32, 880, true);
  #assert p[0].active == 2;
  #assert pk_key(p[..], cat[..], sel, KEY_DOWN, 0) && p[0].active == 3;
  #assert pk_key(p[..], cat[..], sel, KEY_ENTER, 0) && p[0].flip_plan && pk_is_open(p[..]);
  #assert pk_key(p[..], cat[..], sel, KEY_DOWN, 0) && p[0].active == 0;
  #assert pk_key(p[..], cat[..], sel, KEY_ENTER, 0) && p[0].pick_access == 0 && !pk_is_open(p[..]);
}

#test "the menus paint where Zeron puts them, and the pointer picks from them" {
  a: [1] Atlas; test_atlas(a[..]);
  cat: [1] PkCatalog; test_catalog(cat[..]);
  p: [1] Picker;
  sel := PkSel.{model = 0, level = 2, access = 2};
  out: [60000] f32;
  // the compact panel under the model chip, its right edge on the chip's: 256 x 100
  pk_open(p[..], PK_MODEL, cat[..], sel, 781, 447, 198, 32, 880, true);
  n := pk_paint(out[..], 0, p[..], cat[..], sel, a[..], zeron_dark(), 2, 1320, 880);
  #assert n > 60 && p[0].x == 723 && p[0].y == 485 && p[0].w == 256 && p[0].h == 100;
  #assert p[0].sx == 736 && p[0].sy == 540 && p[0].sw == 230;
  // a press on the slider's last stop picks the ladder's top
  #assert pk_press(p[..], cat[..], sel, 736 + 230 - 22, 558) && p[0].pick_level == 4 && p[0].dragging;
  pk_move(p[..], cat[..], sel, 736 + 22, 558);
  #assert p[0].pick_level == 0;
  pk_release(p[..]);
  // the header opens the list: 13 rows would cap at seven; four here
  #assert pk_press(p[..], cat[..], sel, 800, 500) && p[0].list;
  n = pk_paint(out[..], 0, p[..], cat[..], sel, a[..], zeron_dark(), 2, 1320, 880);
  #assert p[0].h == 80 + 4 * 34 + 8 + 2 && p[0].list_y == 485 + 1 + 80;
  // the third row picks the opus alias
  #assert pk_press(p[..], cat[..], sel, 800, p[0].list_y + 4 + 2 * 34 + 10) && p[0].pick_model == 2 && !p[0].list;
  // a press outside closes it and passes through
  #assert !pk_press(p[..], cat[..], sel, 10, 10) && !pk_is_open(p[..]);
  // the access menu: 288 wide at the access chip, three modes and Plan mode
  pk_open(p[..], PK_ACCESS_MENU, cat[..], sel, 694, 447, 83, 32, 880, true);
  n = pk_paint(out[..], 0, p[..], cat[..], sel, a[..], zeron_dark(), 2, 1320, 880);
  #assert p[0].w == 288 && p[0].x == 777 - 288 && p[0].rows == 4;
  #assert pk_press(p[..], cat[..], sel, 600, p[0].row_y[3] + 5) && p[0].flip_plan && pk_is_open(p[..]);
  #assert pk_press(p[..], cat[..], sel, 600, p[0].row_y[1] + 5) && p[0].pick_access == 1 && !pk_is_open(p[..]);
}
