// The chat set in every pixel skin (components/spec.md Phase 2, GitHub
// #13153, #13230): the same transcript, composer and menus laid out in
// Zeron, Everglade, the Metaverse and the terminal in pixels (uiskin_pixels),
// and nothing another skin draws wears one of Zeron's colours. A colour
// still written into a component shows up here as a Zeron colour in another
// skin's frame. Zeron's own frames are pinned by
// apps/openagents-web/chat-frames.coax.
//   coax/bin/coax test components/zeron/skins-checks.coax

#load "picker.coax";       // the transcript, the composer and the menus
#load "../skin/all.coax";

SC_MAX :: 4096;

// Every colour a list paints, visible ones only.
sc_colours :: (list: [] Prim, n: int, out: [] Rgba, m: int) -> int {
  k := m;
  for i: 0..<n {
    for c: [2] Rgba.[list[i].fill, list[i].edge] {
      if c.a <= 0 || k >= out.count { continue; }
      seen := false;
      for j: 0..<k { if out[j].r == c.r && out[j].g == c.g && out[j].b == c.b && out[j].a == c.a { seen = true; } }
      if !seen { out[k] = c; k += 1; }
    }
  }
  return k;
}
sc_has :: (set: [] Rgba, n: int, c: Rgba) -> bool {
  for j: 0..<n { if set[j].r == c.r && set[j].g == c.g && set[j].b == c.b && set[j].a == c.a { return true; } }
  return false;
}

// How many of a skin's colours are also Zeron's.
sc_shared :: (z: [] Rgba, nz: int, e: [] Rgba, ne: int) -> int {
  shared := 0;
  for j: 0..<ne { if sc_has(z, nz, e[j]) { shared += 1; } }
  return shared;
}

// The demo with every group and chip open, the table reply, a notice of each
// kind and the working trailer, laid out in a skin; returns its colours.
sc_transcript :: (sk: UiSkin, out: [] Rgba) -> int {
  t: [1] Transcript; a: [1] Atlas;
  t_test_setup(t[..], a[..]);
  t_set_skin(t[..], sk);
  t_table_demo(t[..]);
  kinds := [5] int.[N_ASK, N_BUSY, N_LIMIT, N_META, N_STOPPED];
  for kd: kinds { _ = t_notice(t[..], kd, "Claude Code needs your approval to run a command in this folder."); }
  t[0].working = true; t[0].work_secs = 12;
  for g: 0..<t[0].ng {
    t_set_open(t[..], g, -1, true);
    for c: 0..<t[0].groups[g].tools { t_set_open(t[..], g, c, true); }
  }
  t_layout(t[..], a[..], zeron_dark(), 292, 736, 145);
  n := sc_colours(t[0].boxes[..], t[0].nbox, out, 0);
  return sc_colours(t[0].texts[..], t[0].ntext, out, n);
}

#test "the transcript in Everglade, the Metaverse and the terminal wears none of Zeron's colours" #steps 1200000000 {
  z: [SC_MAX] Rgba; e: [SC_MAX] Rgba;
  nz := sc_transcript(zeron_skin(), z[..]);
  #assert nz > 10;
  for id: 1..<UISKINS {
    ne := sc_transcript(uiskin_pixels(id), e[..]);
    #assert ne > 10 && sc_shared(z[..], nz, e[..], ne) == 0;
  }
}

#test "the transcript in each other skin: the bubble is the skin's raised wash, the reply its ink" #steps 1600000000 {
  for id: 1..<UISKINS { #assert sc_bubble(uiskin_pixels(id)); }
}
// Whether the bubble wears the skin's raised wash and the reply its ink, at Zeron's places.
sc_bubble :: (sk: UiSkin) -> bool {
  t: [1] Transcript; a: [1] Atlas;
  t_test_setup(t[..], a[..]);
  t_set_skin(t[..], sk);
  t_layout(t[..], a[..], zeron_dark(), 292, 736, 145);
  bubble := false; ink := false;
  for k: 0..<t[0].nbox { b := t[0].boxes[k]; if b.kind == PRIM_BOX && b.fill.r == sk.raised.r && b.fill.a == sk.raised.a { bubble = true; } }
  for k: 0..<t[0].ntext { if t[0].texts[k].fill.r == sk.ink.r && t[0].texts[k].fill.g == sk.ink.g { ink = true; } }
  // the same rows at the same places: the skin changes the look, not the layout
  z: [1] Transcript; za: [1] Atlas;
  t_test_setup(z[..], za[..]);
  return bubble && ink && z[0].nr == t[0].nr && z[0].content_h == t[0].content_h;
}

// The composer, expanded and docked: two lines typed and selected, the
// model chip hovered and the access chip in plan mode, the caret on; then
// empty with Stop. Returns its colours.
sc_composer :: (sk: UiSkin, out: [] Rgba) -> int {
  c: [1] Composer; a: [1] Atlas;
  md_test_atlas(a[..]);
  composer_set_skin(c[..], sk);
  c[0].focused = true;
  composer_insert(c[..], "Keep the tool group headers quiet\nand let the chips carry the error.");
  list: [COMPOSER_PRIMS] Prim; split: [1] int;
  c[0].hover = CH_MODEL; c[0].plan = true; c[0].access_set = true;
  n := composer_prims(list[..], 0, c[..], a[..], 292, 368, 736, split[..]);
  m := sc_colours(list[..], n, out, 0);
  composer_select_all(c[..]);
  c[0].hover = CH_ACCESS; c[0].brand = ICON_OPENAI;
  n = composer_prims(list[..], 0, c[..], a[..], 292, 368, 736, split[..]);
  m = sc_colours(list[..], n, out, m);
  e: [1] Composer; composer_set_skin(e[..], sk); e[0].running = true; e[0].focused = true;
  n = composer_docked_prims(list[..], 0, e[..], a[..], 292, 860, 736, split[..]);
  return sc_colours(list[..], n, out, m);
}

#test "the composer in Everglade, the Metaverse and the terminal wears none of Zeron's colours" #steps 1200000000 {
  z: [SC_MAX] Rgba; e: [SC_MAX] Rgba;
  nz := sc_composer(zeron_skin(), z[..]);
  #assert nz > 8;
  for id: 1..<UISKINS {
    ne := sc_composer(uiskin_pixels(id), e[..]);
    #assert ne > 8 && sc_shared(z[..], nz, e[..], ne) == 0;
  }
}

// The menus: the model panel with its slider, the model list (a selected
// row, an active one, a place, the search caret), the access menu with Plan
// mode on and off. Returns their colours.
sc_menus :: (sk: UiSkin, out: [] Rgba) -> int {
  a: [1] Atlas; test_atlas(a[..]);
  cat: [1] PkCatalog; test_catalog(cat[..]);
  cat[0].place = "coderos-4080"; cat[0].place_model = 1; cat[0].tint = sk.brand;   // the catalog's tint is the app's
  p: [1] Picker; pk_set_skin(p[..], sk);
  list: [PK_PRIMS] Prim;
  sel := PkSel.{model = 1, level = 2, access = 1, plan = true};
  pk_open(p[..], PK_MODEL, cat[..], sel, 781, 447, 198, 32, 880, true);
  p[0].title_hover = true;
  m := sc_colours(list[..], pk_prims(list[..], 0, p[..], cat[..], sel, a[..], 1320, 880), out, 0);
  _ = pk_press(p[..], cat[..], sel, 800, 500);
  p[0].active = 2; p[0].back_hover = true; p[0].tabs = 1; p[0].tab_icon[0] = ICON_CLAUDE_14; p[0].tab_tint[0] = sk.brand;
  m = sc_colours(list[..], pk_prims(list[..], 0, p[..], cat[..], sel, a[..], 1320, 880), out, m);
  pk_open(p[..], PK_ACCESS_MENU, cat[..], sel, 694, 447, 83, 32, 880, true);
  m = sc_colours(list[..], pk_prims(list[..], 0, p[..], cat[..], sel, a[..], 1320, 880), out, m);
  sel.plan = false;
  return sc_colours(list[..], pk_prims(list[..], 0, p[..], cat[..], sel, a[..], 1320, 880), out, m);
}

#test "the menus in Everglade, the Metaverse and the terminal wear none of Zeron's colours" #steps 1200000000 {
  z: [SC_MAX] Rgba; e: [SC_MAX] Rgba;
  nz := sc_menus(zeron_skin(), z[..]);
  #assert nz > 12;
  for id: 1..<UISKINS {
    ne := sc_menus(uiskin_pixels(id), e[..]);
    #assert ne > 12 && sc_shared(z[..], nz, e[..], ne) == 0;
  }
}
