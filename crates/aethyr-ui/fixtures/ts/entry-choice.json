          }
        },
        {
          "id": "verse-choices",
          "style": {
            "gap": "md"
          },
          "element": {
            "kind": "stack",
            "axis": "vertical",
            "children": [
              {
                "id": "choice-label",
                "element": {
                  "kind": "label",
