                }
              },
              {
                "id": "choice-actions",
                "style": {
                  "gap": "sm"
                },
                "element": {
                  "kind": "stack",
                  "axis": "vertical",
                  "children": [
                    {
                      "id": "verse-explore",
                      "element": {
                        "kind": "button",
                        "label": "Explore the planets",
                        "trailing": "forward"
                      }
                    },
                    {
                      "id": "verse-haunt",
