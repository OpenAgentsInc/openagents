  "sdk_method": "ssh_key",
  "sdk_response_type": "SshKeyResponse",
  "summary": "Configure sandbox SSH key",
  "description": "Adds an OpenSSH public key to the running sandbox so the caller can SSH as user `user`. The response carries `machineIp`, which is the host to connect to on port 22.\n\nThis is also how you reach your own machine from inside a sandbox without the CLI: authorize the key, then open a reverse tunnel with stock OpenSSH, and a port on your machine answers at `127.0.0.1:<port>` inside the sandbox for as long as the ssh process runs.\n\n```bash\nssh -o ExitOnForwardFailure=yes -i ~/.ssh/id_ed25519 -N -R 7777:127.0.0.1:7777 user@<machineIp>\n```\n\n`boat forward <id> --reverse --local 7777` is the same tunnel with the key handling and redial done for you.\n",
  "parameters": [
    {
      "name": "sandboxId",
      "in": "path",
      "required": true,
      "description": "Public Sandbox id returned by create/list/get sandbox calls.",
      "example_value": "sample"
    }
  ],
