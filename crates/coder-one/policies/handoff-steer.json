{
  "schema": "openagents.coder-one.policy.v1",
  "name": "coder-one-handoff-steer",
  "note": "Steer in place: Claude Code on Haiku 4.5, whose adapter demonstrated steering, keeps running; when two judgments in a row flag a stall or a repeated failure, the monitor steers the session with the last errors and the open requirements. Codex can't run this pattern: its adapter has not demonstrated steering.",
  "policy": {
    "jev": {
      "mode": "deep",
      "model": "jev-1.13.0",
      "question_sets": "builtin-v1"
    },
    "evidence": {
      "probes": "v2",
      "survey_files": 40
    },
    "control": {
      "delegate": "always",
      "explore_steps": 0,
      "max_steps": 50,
      "command_timeout_sec": 300,
      "lane": "free",
      "error_streak": 3,
      "unchanged_steps": 6,
      "handoff": {
        "pattern": "steer",
        "on": [
          "stalled",
          "repeating"
        ],
        "after": 2,
        "max_handoffs": 1,
        "brief": {
          "requirements": true,
          "diff": true,
          "errors": true,
          "packets": true
        }
      }
    },
    "brief": {
      "cap": 12000,
      "directions": "batch"
    },
    "executor": {
      "agent": "claude-code",
      "version": "2.1.280",
      "model": "claude-haiku-4-5-20251001",
      "effort": "low",
      "tools": "Bash,Read,Edit,Write,Glob,Grep",
      "prompt_cache_ttl": "5m",
      "deadline_sec": 600
    }
  },
  "protected": {
    "isolation": "task-container",
    "effect_policy": "executor-bypasses-its-own-sandbox",
    "acceptance": "task-verifier",
    "ceilings": {
      "episode_deadline_sec": null,
      "reserve_sec": 30,
      "spend_soft_usd": null,
      "spend_hard_usd": null
    }
  }
}
