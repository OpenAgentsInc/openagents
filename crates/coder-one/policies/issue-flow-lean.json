{
  "schema": "openagents.coder-one.policy.v1",
  "name": "coder-issue-flow-lean",
  "note": "The issue flow on the lean loop: up to four work sessions from a strong first one, a frozen evaluation script that keeps the best-scoring workspace, finishes turned back while the score is below full, a spend bound per session and a 300-second bound per command, retained candidates, and a read-only review. Unmeasured on issues: select it with CODER_ISSUE_POLICY until the issue-flow evaluation set compares it with issue-flow.json. The issue flow's review session and gate still run after the loop.",
  "policy": {
    "jev": {
      "mode": "deep",
      "model": "jev-1.13.0",
      "question_sets": "builtin-v1"
    },
    "evidence": {
      "probes": "v2",
      "survey_files": 40
    },
    "control": {
      "delegate": "always",
      "explore_steps": 0,
      "max_steps": 50,
      "command_timeout_sec": 300,
      "lane": "free",
      "error_streak": 3,
      "unchanged_steps": 6
    },
    "brief": {
      "cap": 12000,
      "directions": "batch"
    },
    "executor": {
      "agent": "microluna",
      "version": null,
      "model": "gpt-6-luna",
      "effort": null,
      "tools": null,
      "prompt_cache_ttl": null,
      "deadline_sec": 2400,
      "microluna": {
        "mode": "requirements",
        "max_sessions": 10,
        "max_attempts": 3,
        "max_groups": 5,
        "session_turns": 60,
        "session_sec": 900,
        "spend_usd": 1.0,
        "evidence_chars": 14000,
        "checks": false,
        "require_evidence": true,
        "read_first": false,
        "accept": false,
        "parallel_tools": true,
        "lean": {
          "sessions": 4,
          "source_chars": 40000,
          "sample_chars": 0,
          "self_check": true,
          "keep_best": true,
          "score_sec": 120,
          "persist": {
            "max_returns": 3,
            "not_done": true,
            "reserve_turns": 8,
            "reserve_sec": 90
          },
          "wall_sec": 2100,
          "session_spend": true,
          "command_sec": 300,
          "symptoms": true,
          "retain_candidates": true,
          "observe_review": true,
          "failures": true
        }
      }
    }
  },
  "protected": {
    "isolation": "task-container",
    "effect_policy": "executor-bypasses-its-own-sandbox",
    "acceptance": "task-verifier",
    "ceilings": {
      "episode_deadline_sec": null,
      "reserve_sec": 30,
      "spend_soft_usd": null,
      "spend_hard_usd": null
    }
  }
}
