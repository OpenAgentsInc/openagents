{
  "schema": "openagents.coder-one.policy.v1",
  "name": "matched-opus-medium-v8",
  "note": "The tunable-v8 controller with every executor fixed to lean Claude Code on Opus 5.5 at medium effort, for the matched controller experiment of issue #9567. It keeps v8's deep Jev briefing with the coverage packer, monitoring, same-model escalation on a stall, requirement and behavior checks, support judgments, self-report checks, checked repair, a second executor after a failed check, and up to four persistence rounds under the spending cap. It removes task.profile routing and the family table, runs the second executor and every persistence round on Opus instead of GPT-6 Astra or Sol, and keeps medium effort on long tasks instead of xhigh. The executor's model, effort, tools, system prompt sections, and five-minute prompt cache match the claude-code-opus-matched baseline arm, so the two arms differ only in the controller.",
  "policy": {
    "jev": {
      "mode": "deep",
      "model": "jev-1.13.0",
      "question_sets": "builtin-v1"
    },
    "evidence": {
      "probes": "v2",
      "survey_files": 40
    },
    "control": {
      "delegate": "always",
      "explore_steps": 0,
      "max_steps": 50,
      "command_timeout_sec": 300,
      "lane": "free",
      "error_streak": 3,
      "unchanged_steps": 6,
      "monitor": {
        "on_operation": true,
        "on_artifact": true,
        "on_claim": true,
        "silence_ms": 300000,
        "window": 8,
        "event_chars": 300,
        "requirements": 10,
        "threshold": 0.5,
        "jev": true,
        "stall_commands": 12,
        "latency_ms": 800
      },
      "handoff": {
        "pattern": "escalate",
        "to": {
          "agent": "claude-code",
          "model": "claude-opus-5-5",
          "effort": "medium",
          "tools": "Bash,Read,Edit,Write,Glob,Grep",
          "prompt_cache_ttl": "5m",
          "version": "2.1.280"
        },
        "on": [
          "stalled",
          "repeating"
        ],
        "after": 3,
        "max_handoffs": 1,
        "brief": {
          "requirements": true,
          "diff": true,
          "errors": true,
          "packets": true
        },
        "monitor": {
          "on_operation": true,
          "on_artifact": true,
          "on_claim": true,
          "silence_ms": 300000,
          "window": 8,
          "event_chars": 300,
          "requirements": 10,
          "threshold": 0.5,
          "jev": true,
          "stall_commands": 12,
          "latency_ms": 800
        }
      },
      "horizon": {
        "first_share": 0.55,
        "later_share": 0.75,
        "min_dispatch_sec": 300,
        "check_share": 0.05,
        "long_after_sec": 3600,
        "long_effort": "medium",
        "long_command_sec": 3600
      },
      "persist": {
        "max_rounds": 4,
        "min_remaining_sec": 1800,
        "share": 0.5,
        "long_only": true,
        "stop_when_unchanged": true,
        "stop_when_confirmed": true,
        "guard": true,
        "max_copy_mb": 256,
        "own_tests": {
          "runner": "/tmp/persist-tests/run.sh",
          "timeout_sec": 600
        },
        "stop_when_no_progress": true,
        "spend": {
          "budget_usd": 10.0,
          "share": 0.5
        }
      }
    },
    "brief": {
      "cap": 12000,
      "directions": "batch-checked",
      "packer": "coverage-jev"
    },
    "executor": {
      "agent": "claude-code",
      "version": "2.1.280",
      "model": "claude-opus-5-5",
      "effort": "medium",
      "tools": "Bash,Read,Edit,Write,Glob,Grep",
      "prompt_cache_ttl": "5m",
      "deadline_sec": 600,
      "system": {
        "mode": "replace",
        "sections": [
          "role",
          "security",
          "authority",
          "verify",
          "report",
          "code-style"
        ]
      }
    },
    "verify": {
      "checks": true,
      "support": true,
      "repair": {
        "brief": "packet",
        "trigger": "checked"
      },
      "support_budget": {
        "max_requirements": 3,
        "long_max_requirements": 8,
        "order": "behavior-first"
      },
      "self_report": true,
      "optional_outputs": true,
      "behavior": true,
      "snapshot": {
        "max_mb": 256,
        "max_files": 50000
      },
      "second": {
        "to": [
          {
            "agent": "claude-code",
            "model": "claude-opus-5-5",
            "effort": "medium",
            "tools": "Bash,Read,Edit,Write,Glob,Grep",
            "prompt_cache_ttl": "5m",
            "version": "2.1.280"
          }
        ],
        "on": [
          "failed"
        ],
        "share": 0.6,
        "min_remaining_sec": 1800,
        "max_copy_mb": 256
      }
    }
  },
  "protected": {
    "isolation": "task-container",
    "effect_policy": "executor-bypasses-its-own-sandbox",
    "acceptance": "task-verifier",
    "ceilings": {
      "episode_deadline_sec": null,
      "reserve_sec": 30,
      "spend_soft_usd": null,
      "spend_hard_usd": null
    }
  }
}
