{
  "schema": "openagents.coder-one.policy.v1",
  "name": "coder-one-microluna-best-of-3-suite",
  "note": "microluna-best-of-3 with control.best_of.select \"suite\": the host runs the test commands the task names on each candidate's code, under each candidate's own test files and every other candidate's, and keeps the candidate with the most passing runs; then the calibrated verdict's call and failure probability, then the check scorecard, then cost. The suite may take 900 seconds. Otherwise identical to microluna-best-of-3, so the two differ only in the selection key. Written for issue #9587.",
  "policy": {
    "jev": {
      "mode": "deep",
      "model": "jev-1.13.0",
      "question_sets": "builtin-v1"
    },
    "evidence": {
      "probes": "v2",
      "survey_files": 40
    },
    "control": {
      "delegate": "always",
      "explore_steps": 0,
      "max_steps": 50,
      "command_timeout_sec": 300,
      "lane": "free",
      "error_streak": 3,
      "unchanged_steps": 6,
      "horizon": {
        "first_share": 0.55,
        "later_share": 0.75,
        "min_dispatch_sec": 300,
        "check_share": 0.05,
        "long_after_sec": 3600,
        "long_effort": "high",
        "long_command_sec": 3600
      },
      "best_of": {
        "n": 3,
        "max_copy_mb": 256,
        "archive": true,
        "select": "suite"
      }
    },
    "brief": {
      "cap": 12000,
      "directions": "batch-checked",
      "packer": "coverage-jev"
    },
    "executor": {
      "agent": "microluna",
      "version": null,
      "model": "gpt-6-luna",
      "effort": null,
      "tools": null,
      "prompt_cache_ttl": null,
      "deadline_sec": 600,
      "microluna": {
        "mode": "requirements",
        "max_sessions": 8,
        "max_attempts": 2,
        "max_groups": 4,
        "session_turns": 30,
        "session_sec": 600,
        "spend_usd": 0.5,
        "evidence_chars": 14000,
        "checks": true,
        "require_evidence": true,
        "read_first": false,
        "accept": false
      }
    },
    "verify": {
      "checks": true,
      "support": false,
      "verdict": true
    }
  },
  "protected": {
    "isolation": "task-container",
    "effect_policy": "executor-bypasses-its-own-sandbox",
    "acceptance": "task-verifier",
    "ceilings": {
      "episode_deadline_sec": null,
      "reserve_sec": 30,
      "spend_soft_usd": null,
      "spend_hard_usd": null
    }
  }
}
