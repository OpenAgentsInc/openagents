{
  "schema": "openagents.coder-one.policy.v1",
  "name": "coder-one-microluna-best-of-3",
  "note": "microluna-v1 with control.best_of: 3 Microluna dispatches on GPT-6 Luna run at once, each in its own copy of the workspace, with the workspace's path rewritten in the task and evidence each reads. The host keeps the candidate with the best calibrated verdict, then the best check scorecard, then the lowest cost, and archives every candidate's workspace under best-of/. verify.repair is removed, as in microluna-best-of-1. Written for issue #9587.",
  "policy": {
    "jev": {
      "mode": "deep",
      "model": "jev-1.13.0",
      "question_sets": "builtin-v1"
    },
    "evidence": {
      "probes": "v2",
      "survey_files": 40
    },
    "control": {
      "delegate": "always",
      "explore_steps": 0,
      "max_steps": 50,
      "command_timeout_sec": 300,
      "lane": "free",
      "error_streak": 3,
      "unchanged_steps": 6,
      "horizon": {
        "first_share": 0.55,
        "later_share": 0.75,
        "min_dispatch_sec": 300,
        "check_share": 0.05,
        "long_after_sec": 3600,
        "long_effort": "high",
        "long_command_sec": 3600
      },
      "best_of": {
        "n": 3,
        "max_copy_mb": 256,
        "archive": true
      }
    },
    "brief": {
      "cap": 12000,
      "directions": "batch-checked",
      "packer": "coverage-jev"
    },
    "executor": {
      "agent": "microluna",
      "version": null,
      "model": "gpt-6-luna",
      "effort": null,
      "tools": null,
      "prompt_cache_ttl": null,
      "deadline_sec": 600,
      "microluna": {
        "mode": "requirements",
        "max_sessions": 8,
        "max_attempts": 2,
        "max_groups": 4,
        "session_turns": 30,
        "session_sec": 600,
        "spend_usd": 0.5,
        "evidence_chars": 14000,
        "checks": true
      }
    },
    "verify": {
      "checks": true,
      "support": false,
      "verdict": true
    }
  },
  "protected": {
    "isolation": "task-container",
    "effect_policy": "executor-bypasses-its-own-sandbox",
    "acceptance": "task-verifier",
    "ceilings": {
      "episode_deadline_sec": null,
      "reserve_sec": 30,
      "spend_soft_usd": null,
      "spend_hard_usd": null
    }
  }
}
