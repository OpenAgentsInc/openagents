          "wall_sec": 1200,
          "session_spend": true,
          "records": true,
          "command_sec": 180,
          "symptoms": true,
          "example_first": true,
          "standard_forms": true,
          "rationale": true,
          "retain_candidates": true,
          "finish_rule": {
            "max_refusals": 3,
            "baseline": false
