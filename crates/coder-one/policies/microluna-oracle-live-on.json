              "warmup": 1,
              "repeats": 3,
              "run_sec": 60,
              "budget_sec": 180
            },
            "write_harness": true,
            "harness_usd": 0.02,
            "harness_sec": 180,
            "finish": true
          },
          "oracle": {
            "writer_turns": 30,
            "writer_sec": 600,
            "writer_usd": 0.08,
            "experiment": {
              "id": "2026-09-25-oracle-live",
              "protocol_sha256": "2c4a5521bd40c7419d1d904f4ea25c52ab0462ad813a4f932afc0cb21b3d1d94"
            }
          }
        }
