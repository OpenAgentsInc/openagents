{
  "schema": "openagents.coder-one.policy.v1",
  "name": "coder-one-microluna-v2",
  "note": "microluna-v1 with the two Fable moves from #9586's fingerprints: read_first runs a read-only reconnaissance session on each group before any edit, and require_evidence (also on in v1) accepts a done only when the session edited a file and ran a command after it. Everything else is microluna-v1: Microluna on the Codex login, the mini-handoff loop, verify.checks and the combined verdict between sessions, one verify.repair, and no escalation to Opus. Written for issue #9585.",
  "policy": {
    "jev": {
      "mode": "deep",
      "model": "jev-1.13.0",
      "question_sets": "builtin-v1"
    },
    "evidence": {
      "probes": "v2",
      "survey_files": 40
    },
    "control": {
      "delegate": "always",
      "explore_steps": 0,
      "max_steps": 50,
      "command_timeout_sec": 300,
      "lane": "free",
      "error_streak": 3,
      "unchanged_steps": 6,
      "horizon": {
        "first_share": 0.55,
        "later_share": 0.75,
        "min_dispatch_sec": 300,
        "check_share": 0.05,
        "long_after_sec": 3600,
        "long_effort": "high",
        "long_command_sec": 3600
      }
    },
    "brief": {
      "cap": 12000,
      "directions": "batch-checked",
      "packer": "coverage-jev"
    },
    "executor": {
      "agent": "microluna",
      "version": null,
      "model": "gpt-6-luna",
      "effort": null,
      "tools": null,
      "prompt_cache_ttl": null,
      "deadline_sec": 600,
      "microluna": {
        "mode": "requirements",
        "max_sessions": 8,
        "max_attempts": 2,
        "max_groups": 4,
        "session_turns": 30,
        "session_sec": 600,
        "spend_usd": 0.5,
        "evidence_chars": 14000,
        "checks": true,
        "read_first": true,
        "require_evidence": true,
        "accept": false
      }
    },
    "verify": {
      "checks": true,
      "support": false,
      "repair": {
        "brief": "packet",
        "trigger": "detected"
      }
    }
  },
  "protected": {
    "isolation": "task-container",
    "effect_policy": "executor-bypasses-its-own-sandbox",
    "acceptance": "task-verifier",
    "ceilings": {
      "episode_deadline_sec": null,
      "reserve_sec": 30,
      "spend_soft_usd": null,
      "spend_hard_usd": null
    }
  }
}
