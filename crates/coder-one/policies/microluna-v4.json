{
  "schema": "openagents.coder-one.policy.v1",
  "name": "coder-one-microluna-v4",
  "note": "microluna-v3 (read_first plus the minimal acceptance gate) with the loop's budget raised well above v3's. v3 caps the loop at 8 sessions, $0.50, and a 600-second executor deadline, so a task with any depth runs out of loop before it runs out of ideas, while Fable spends $3 to $7 and 30 to 90 minutes per pass. Luna is 10 to 50 times cheaper per session, so v4 raises the executor deadline to 2400 seconds, the loop to 30 sessions and 4 attempts per group, each session to 900 seconds, the spend bound to $1.50, and the per-session evidence to 20000 characters. Loop-to-green stays the stopping rule. Written for issue #9585's overnight run.",
  "policy": {
    "jev": {
      "mode": "deep",
      "model": "jev-1.13.0",
      "question_sets": "builtin-v1"
    },
    "evidence": {
      "probes": "v2",
      "survey_files": 40
    },
    "control": {
      "delegate": "always",
      "explore_steps": 0,
      "max_steps": 50,
      "command_timeout_sec": 300,
      "lane": "free",
      "error_streak": 3,
      "unchanged_steps": 6,
      "horizon": {
        "first_share": 0.55,
        "later_share": 0.75,
        "min_dispatch_sec": 300,
        "check_share": 0.05,
        "long_after_sec": 3600,
        "long_effort": "high",
        "long_command_sec": 3600
      }
    },
    "brief": {
      "cap": 12000,
      "directions": "batch-checked",
      "packer": "coverage-jev"
    },
    "executor": {
      "agent": "microluna",
      "version": null,
      "model": "gpt-6-luna",
      "effort": null,
      "tools": null,
      "prompt_cache_ttl": null,
      "deadline_sec": 2400,
      "microluna": {
        "mode": "requirements",
        "max_sessions": 30,
        "max_attempts": 4,
        "max_groups": 4,
        "session_turns": 40,
        "session_sec": 900,
        "spend_usd": 1.5,
        "evidence_chars": 20000,
        "checks": true,
        "read_first": true,
        "require_evidence": true,
        "accept": true
      }
    },
    "verify": {
      "checks": true,
      "support": false,
      "repair": {
        "brief": "packet",
        "trigger": "detected"
      }
    }
  },
  "protected": {
    "isolation": "task-container",
    "effect_policy": "executor-bypasses-its-own-sandbox",
    "acceptance": "task-verifier",
    "ceilings": {
      "episode_deadline_sec": null,
      "reserve_sec": 30,
      "spend_soft_usd": null,
      "spend_hard_usd": null
    }
  }
}
