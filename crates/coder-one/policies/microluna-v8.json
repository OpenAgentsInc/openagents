{
  "schema": "openagents.coder-one.policy.v1",
  "name": "coder-one-microluna-v8",
  "note": "microluna-v7 with the lessons of its first trace analysis, and task-neutral guidance. A guard, a test that passed on the untouched workspace, no longer holds the loop once an edit turns it red: the loop decides on the other tests, names the guard in each later brief as possibly pinning a defect, and sends the close to an audit. Tests run four at a time on the host and in each run.sh. The first gap round runs as soon as the suite is frozen with gaps, beside session 1. The writers, Jev's faithfulness question, the defended-comment scan, the first session, and the audit read general guidance: property probes, stated documentation, and defended simplifications as suspects, with nothing taken from one task's defects. The checks cost each frozen test at its measured time, and the repair's recheck observes the frozen suite. The spend bound is $0.08 a dispatch. Written for issues #9585 and #9588.",
  "policy": {
    "jev": {
      "mode": "deep",
      "model": "jev-1.13.0",
      "question_sets": "builtin-v1"
    },
    "evidence": {
      "probes": "v2",
      "survey_files": 40
    },
    "control": {
      "delegate": "always",
      "explore_steps": 0,
      "max_steps": 50,
      "command_timeout_sec": 300,
      "lane": "free",
      "error_streak": 3,
      "unchanged_steps": 6,
      "horizon": {
        "first_share": 0.55,
        "later_share": 0.75,
        "min_dispatch_sec": 300,
        "check_share": 0.05,
        "long_after_sec": 3600,
        "long_effort": "high",
        "long_command_sec": 3600
      }
    },
    "brief": {
      "cap": 12000,
      "directions": "batch-checked",
      "packer": "coverage-jev"
    },
    "executor": {
      "agent": "microluna",
      "version": null,
      "model": "gpt-6-luna",
      "effort": null,
      "tools": null,
      "prompt_cache_ttl": null,
      "deadline_sec": 2400,
      "microluna": {
        "mode": "requirements",
        "max_sessions": 30,
        "max_attempts": 4,
        "max_groups": 4,
        "session_turns": 40,
        "session_sec": 900,
        "spend_usd": 0.08,
        "evidence_chars": 20000,
        "checks": true,
        "require_evidence": true,
        "read_first": false,
        "accept": true,
        "focus_actionable": true,
        "suite": true,
        "suite_writer": {
          "writers": 3,
          "rewrite": "hard",
          "rounds": 2,
          "turns": 24,
          "repair_turns": 10,
          "effort": "low",
          "one_pass": true,
          "discover": true,
          "inventory": true,
          "standard_methods": true,
          "guards": true,
          "general": true
        },
        "overlap_suite": true,
        "parallel_edits": 3,
        "handoff_jev": true,
        "final_guard": true,
        "gap_rounds": 1,
        "fast_runs": true,
        "close_audit": true,
        "prefix_sources": 24000,
        "parallel_tools": true,
        "orient_effort": "low",
        "test_jobs": 4,
        "advisory_guards": true,
        "gap_overlap": true
      }
    },
    "verify": {
      "checks": true,
      "support": false,
      "repair": {
        "brief": "packet",
        "trigger": "unobserved"
      },
      "suite_checks": true
    }
  },
  "protected": {
    "isolation": "task-container",
    "effect_policy": "executor-bypasses-its-own-sandbox",
    "acceptance": "task-verifier",
    "ceilings": {
      "episode_deadline_sec": null,
      "reserve_sec": 30,
      "spend_soft_usd": null,
      "spend_hard_usd": null
    }
  }
}
