{
  "schema": "openagents.coder-one.policy.v1",
  "name": "coder-one-tunable-luna-pack-solo",
  "note": "tunable-luna-pack with every dispatch on Codex with GPT-6 Luna: control.handoff is removed, so nothing escalates to Claude Code on Opus 5.5, and control.horizon.long_effort is high, the reasoning effort the codex-gpt-6-luna arm runs at. The briefing, coverage packer, monitor, checks, and the one verify.repair are unchanged; the repair runs on Luna, the tier that made the candidate. Written for the first Luna measurement on TB4 (#9583).",
  "policy": {
    "jev": {
      "mode": "deep",
      "model": "jev-1.13.0",
      "question_sets": "builtin-v1"
    },
    "evidence": {
      "probes": "v2",
      "survey_files": 40
    },
    "control": {
      "delegate": "always",
      "explore_steps": 0,
      "max_steps": 50,
      "command_timeout_sec": 300,
      "lane": "free",
      "error_streak": 3,
      "unchanged_steps": 6,
      "monitor": {
        "on_operation": true,
        "on_artifact": true,
        "on_claim": true,
        "silence_ms": 300000,
        "window": 8,
        "event_chars": 300,
        "requirements": 10,
        "threshold": 0.5,
        "jev": true,
        "stall_commands": 12,
        "latency_ms": 800
      },
      "horizon": {
        "first_share": 0.55,
        "later_share": 0.75,
        "min_dispatch_sec": 300,
        "check_share": 0.05,
        "long_after_sec": 3600,
        "long_effort": "high",
        "long_command_sec": 3600
      }
    },
    "brief": {
      "cap": 12000,
      "directions": "batch-checked",
      "packer": "coverage-jev"
    },
    "executor": {
      "agent": "codex",
      "version": "0.155.1",
      "model": "gpt-6-luna",
      "effort": null,
      "tools": null,
      "prompt_cache_ttl": null,
      "deadline_sec": 600,
      "system": {
        "mode": "replace",
        "sections": [
          "role",
          "security",
          "authority",
          "verify",
          "report",
          "code-style"
        ]
      }
    },
    "verify": {
      "checks": true,
      "support": false,
      "repair": {
        "brief": "packet",
        "trigger": "detected"
      }
    }
  },
  "protected": {
    "isolation": "task-container",
    "effect_policy": "executor-bypasses-its-own-sandbox",
    "acceptance": "task-verifier",
    "ceilings": {
      "episode_deadline_sec": null,
      "reserve_sec": 30,
      "spend_soft_usd": null,
      "spend_hard_usd": null
    }
  }
}
