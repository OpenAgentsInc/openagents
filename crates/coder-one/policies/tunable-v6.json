      "horizon": {
        "first_share": 0.55,
        "later_share": 0.75,
        "min_dispatch_sec": 300,
        "check_share": 0.05,
        "long_after_sec": 3600,
        "long_effort": "xhigh",
        "long_command_sec": 3600
      },
      "persist": {
        "max_rounds": 2,
        "min_remaining_sec": 1800,
        "share": 0.5,
        "long_only": true,
        "stop_when_unchanged": true,
        "stop_when_confirmed": true,
        "guard": true,
        "max_copy_mb": 256
      }
    },
    "brief": {
      "cap": 12000,
      "directions": "batch-checked",
      "packer": "coverage-jev"
    },
    "executor": {
      "agent": "claude-code",
      "version": "2.1.280",
      "model": "claude-opus-5-5",
      "effort": "low",
      "tools": "Bash,Read,Edit,Write,Glob,Grep",
      "prompt_cache_ttl": "5m",
      "deadline_sec": 600,
      "system": {
        "mode": "replace",
        "sections": [
          "role",
          "security",
          "authority",
          "verify",
          "report",
          "code-style"
        ]
