{
  "schema": "openagents.coder-one.policy.v1",
  "name": "coder-one-tunable",
  "note": "The whole tunable composition in a Terminal-Bench episode: task.profile routes the start (Codex on GPT-6 Luna for cheap, likely-easy tasks; lean Claude Code on Opus 5.5 for hard or long ones), deep Jev briefs it, control.monitor watches, verify.checks and verify.support judge the result, control.handoff escalates Luna to lean Opus on a stall, a failed check, a contradicted requirement, or no answer, and verify.repair runs once from the diagnostic packets. control.horizon sizes every dispatch from the task's own timeout. Both executors run the headless core system prompt with its protected sections, and Claude Code writes the five-minute prompt cache.",
  "policy": {
    "jev": {
      "mode": "deep",
      "model": "jev-1.13.0",
      "question_sets": "builtin-v1"
    },
    "evidence": {
      "probes": "v2",
      "survey_files": 40
    },
    "control": {
      "delegate": "always",
      "explore_steps": 0,
      "max_steps": 50,
      "command_timeout_sec": 300,
      "lane": "free",
      "error_streak": 3,
      "unchanged_steps": 6,
      "monitor": {
        "on_operation": true,
        "on_artifact": true,
        "on_claim": true,
        "silence_ms": 300000,
        "window": 8,
        "event_chars": 300,
        "requirements": 10,
        "threshold": 0.5,
        "jev": true,
        "stall_commands": 12,
        "latency_ms": 800
      },
      "handoff": {
        "pattern": "escalate",
        "to": {
          "agent": "claude-code",
          "model": "claude-opus-5-5",
          "effort": "low",
          "tools": "Bash,Read,Edit,Write,Glob,Grep",
          "prompt_cache_ttl": "5m",
          "version": "2.1.280"
        },
        "on": [
          "stalled",
          "repeating"
        ],
        "after": 3,
        "max_handoffs": 1,
        "brief": {
          "requirements": true,
          "diff": true,
          "errors": true,
          "packets": true
        },
        "monitor": {
          "on_operation": true,
          "on_artifact": true,
          "on_claim": true,
          "silence_ms": 300000,
          "window": 8,
          "event_chars": 300,
          "requirements": 10,
          "threshold": 0.5,
          "jev": true,
          "stall_commands": 12,
          "latency_ms": 800
        }
      },
      "route": {
        "rule": "profile-v1",
        "cheap": {
          "agent": "codex",
          "model": "gpt-6-luna",
          "version": "0.155.1"
        },
        "strong": {
          "agent": "claude-code",
          "model": "claude-opus-5-5",
          "effort": "low",
          "tools": "Bash,Read,Edit,Write,Glob,Grep",
          "prompt_cache_ttl": "5m",
          "version": "2.1.280"
        },
        "hard_at": 0.5,
        "hard_features": [
          "builds_code",
          "concurrency"
        ],
        "feature_at": 0.7,
        "long_after_sec": 3600
      },
      "horizon": {
        "first_share": 0.55,
        "later_share": 0.75,
        "min_dispatch_sec": 300,
        "check_share": 0.05,
        "long_after_sec": 3600,
        "long_effort": "medium",
        "long_command_sec": 3600
      }
    },
    "brief": {
      "cap": 12000,
      "directions": "batch-checked"
    },
    "executor": {
      "agent": "claude-code",
      "version": "2.1.280",
      "model": "claude-opus-5-5",
      "effort": "low",
      "tools": "Bash,Read,Edit,Write,Glob,Grep",
      "prompt_cache_ttl": "5m",
      "deadline_sec": 600,
      "system": {
        "mode": "replace",
        "sections": [
          "role",
          "security",
          "authority",
          "verify",
          "report",
          "code-style"
        ]
      }
    },
    "verify": {
      "checks": true,
      "support": true,
      "repair": {
        "brief": "packet",
        "trigger": "detected"
      }
    }
  },
  "protected": {
    "isolation": "task-container",
    "effect_policy": "executor-bypasses-its-own-sandbox",
    "acceptance": "task-verifier",
    "ceilings": {
      "episode_deadline_sec": null,
      "reserve_sec": 30,
      "spend_soft_usd": null,
      "spend_hard_usd": null
    }
  }
}
