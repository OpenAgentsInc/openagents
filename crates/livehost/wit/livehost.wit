// The boundary between the livehost host and a route handler component.
// A handler gets one request and returns one response. It has no access to
// the host's state; the host passes what a render needs.
package openagents:livehost@0.1.0;

interface handler {
  record request {
    method: string,
    path: string,
    query: list<tuple<string, string>>,
    // The manifest this request is pinned to.
    manifest: string,
    // Asset paths in the manifest mapped to their content-addressed URLs.
    assets: list<tuple<string, string>>,
  }

  record response {
    status: u16,
    content-type: string,
    body: string,
  }

  handle: func(request: request) -> response;
}

// Named data the embedding host chooses to share, such as a live snapshot
// a page renders. The host decides which names exist; anything else is
// none.
interface data {
  read: func(name: string) -> option<string>;
}

world route {
  export handler;
}

// A route that also reads host data, for a site embedding handlers.
world site-route {
  import data;
  export handler;
}
