# Rebuild the Rust server while retaining a digest-pinned image's browser assets.
ARG LIVE_WEB_IMAGE

FROM rust:1.97.1-slim-trixie AS builder
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        --no-install-recommends build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY . .
ARG OPENAGENTS_COMMIT=unknown
ENV OPENAGENTS_COMMIT=${OPENAGENTS_COMMIT}
RUN cargo build --locked --release -p openagents-web-site --bin openagents-web -p openagents-web \
    && strip target/release/openagents-web

FROM ${LIVE_WEB_IMAGE} AS site
USER 0:0
COPY --from=builder /build/target/release/openagents-web /usr/local/bin/openagents-web

# Repair private source modes in retained browser assets too.
RUN chmod -R a+rX /srv
USER 10001:10001
RUN unreadable="$(find /srv ! -readable -print -quit)" && test -z "$unreadable"
