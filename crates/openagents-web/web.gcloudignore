# Build context for the openagents-web image (crates/openagents-web/Dockerfile),
# uploaded from the repository root by crates/openagents-web/cloudbuild.yaml.
# The workspace manifest, every crate, and the files outside crates/ that the
# site's dependencies compile in (include_str!/include_bytes!), and what the
# Everglade web build stage needs: its build script, and the Verse assets
# the build compiles in plus the pinned pack it copies (assets/verse/), and
# Cargo's configuration, where the wasm32 getrandom backend flag lives.
/*
!/Cargo.toml
!/Cargo.lock
!/vendor/
!/.cargo/
!/crates/
# Coder shares the app harness and its workspace dependencies.
!/apps/
/apps/*
!/apps/openagents/
/apps/openagents/*
!/apps/openagents/Cargo.toml
!/apps/openagents/crates/
!/migrations/
!/nips/
!/tests/
!/assets/
!/scripts/
/scripts/*
!/scripts/build-everglade-web.sh
!/scripts/build-bunny-web.sh
!/scripts/build-icecream-web.sh
!/scripts/build-snap-web.sh
!/scripts/build-att-web.sh
!/scripts/build-cad-web.sh
!/scripts/build-robot-web.sh
!/scripts/build-sand-garden.sh
!/scripts/build-layertree-web.sh
!/scripts/film/
/scripts/film/*
!/scripts/film/lab_words.json
!/scripts/film/lab_private.json
!/scripts/film/lab_player.html
!/scripts/install/
/scripts/install/*
!/scripts/install/coder.sh
!/scripts/install/coder.ps1
# coder-lease compiles in the agent build environment (#12071).
!/scripts/dev/
/scripts/dev/*
!/scripts/dev/cargo-build-env.sh
!/programs/
!/questions/
!/plugins/
!/knowledge/
!/packages/
/packages/*
!/packages/coder-defaults/
!/deploy/
/deploy/*
!/deploy/eval-runner/
!/docs/
/docs/*
!/docs/agents/
!/docs/coder/
!/docs/cost/
!/docs/decision-models/
!/docs/protocol/
!/docs/sales/
!/docs/sdk/
!/docs/terminal-bench/
!/docs/transcripts/
!/docs/video-lab/
/docs/video-lab/*
!/docs/video-lab/schemas/
!/bench/
/bench/*
!/bench/coder/
!/bench/efficiency/
!/bench/web-chat/
!/bench/ui-format/
!/bench/terminal-bench/
/bench/terminal-bench/*
!/bench/terminal-bench/profiles/
!/bench/terminal-bench/tests/
