  "findings": [
    {
      "claim": "Top-level prompt_eval_cached_count is the scorer CachedTokens count, not generated output or answer-cache telemetry.",
      "sources": [
        "decision/types.go",
        "decision/systemone.go",
        "mlxrunner/model/clef/score.go"
      ]
    },
    {
      "claim": "The MLX scoring path obtains a prefix session, computes offset as input length minus remaining length, forwards only remaining tokens, and reports that offset.",
      "sources": [
        "mlxrunner/score.go",
        "mlxrunner/prefix_cache.go"
      ]
    },
    {
      "claim": "The inspected System One Request type has model/state/images/videos/questions/keep_alive and no cache-disabling request option.",
      "sources": [
        "decision/types.go"
      ]
    },
    {
      "claim": "The inspected published environment registry has no prefix-cache disable option. OLLAMA_KV_CACHE_TYPE selects representation, not whether prefixes are reused.",
      "sources": [
        "envconfig/config.go"
      ]
    },
    {
      "claim": "The inspected MLX scorer constructs/reuses a model-local scoring cache unconditionally. No supported cache-disable control was found in these source paths; this is a scoped source review, not a claim about every possible private or future control.",
      "sources": [
        "mlxrunner/score.go",
        "mlxrunner/prefix_cache.go",
        "mlxrunner/runner.go"
      ]
    },
    {
      "claim": "Unique leading state nonces did not remove shared template-prefix reuse in this run; 31 of 36 Ollama responses reported 37\u201339 cached tokens. No controlled cache-free Ollama rerun was performed.",
      "sources": [
        "../run-1/records.jsonl"
      ]
    }
  ],
  "next_step": "A separately reviewed future comparison must either explicitly allow and match prefix reuse, or establish a supported zero-cache path and verify prompt_eval_cached_count==0 per request. No rerun or server change is authorized by this audit."
