+#[test]
+#[ignore = "requires explicit Metal hardware validation"]
+fn block_delta_same_token_matches_prepared_diagonal_from_zero_state() {
+    objc::rc::autoreleasepool(|| {
+        let metal = metal();
+        let kh = 2;
+        let vh = 6;
+        let width = (2 * kh + vh) * 128;
+        let offset = 2 * kh * 128;
+        let mut conv_values = vec![0.0; width];
+        for h in 0..kh {
+            for i in 0..128 {
+                conv_values[h * 128 + i] =
+                    (((i * 7 + h * 3) % 19) as f32 - 9.0) / 32.0;
+                conv_values[(kh + h) * 128 + i] =
+                    (((i * 11 + h * 5) % 23) as f32 - 11.0) / 64.0;
+            }
+        }
+        for i in 0..vh * 128 {
+            conv_values[offset + i] = 0.125 + ((i * 13) % 17) as f32 / 64.0;
+        }
+        let conv = Guarded::new(&metal, &conv_values);
+        let alpha = Guarded::new(&metal, &vec![0.0; vh]);
+        let beta_in = Guarded::new(
+            &metal,
+            &(0..vh).map(|h| h as f32 / 8.0 - 0.25).collect::<Vec<_>>(),
+        );
+        let a = Guarded::new(&metal, &vec![-1.0; vh]);
+        let dt = Guarded::new(&metal, &vec![0.0; vh]);
+        let q = Guarded::new(&metal, &vec![SENTINEL; kh * 128]);
+        let k = Guarded::new(&metal, &vec![SENTINEL; kh * 128]);
+        let decay = Guarded::new(&metal, &vec![SENTINEL; vh]);
+        let beta = Guarded::new(&metal, &vec![SENTINEL; vh]);
+        let kq = Guarded::new(&metal, &vec![SENTINEL; kh]);
+        let prep = metal.batch();
+        prep.delta_prep(
+            &conv.view, &alpha.view, &beta_in.view, &a.view, &dt.view,
+            &q.view, &k.view, &decay.view, &beta.view, &kq.view,
+            1, kh, vh, 128, width,
+        ).unwrap();
+        prep.commit_wait().unwrap();
+        let dots = kq.read();
+        assert!(dots.iter().all(|x| x.is_finite() && *x != 0.0));
+        assert_ne!(dots[0].to_bits(), dots[1].to_bits());
+        for reordered in [false, true] {
+            let sequential_state = Guarded::new(&metal, &vec![0.0; vh * 128 * 128]);
+            let block_state = Guarded::new(&metal, &vec![0.0; vh * 128 * 128]);
+            let sequential_output = Guarded::new(&metal, &vec![SENTINEL; vh * 128]);
+            let block_output = Guarded::new(&metal, &vec![SENTINEL; vh * 128]);
+            let shape = ClefDeltaPlan::new(1, kh, vh, 128, reordered, width, offset).unwrap();
+            let workspace = Guarded::new(&metal, &vec![SENTINEL; shape.workspace_bytes / 4]);
+            let batch = metal.batch();
+            batch.delta_scan(
+                &q.view, &k.view, &conv.view, &decay.view, &beta.view, &kq.view,
+                &sequential_state.view, &sequential_output.view,
+                1, kh, vh, 128, reordered, width, offset,
+            ).unwrap();
+            batch.delta_scan_block(
+                &q.view, &k.view, &conv.view, &decay.view, &beta.view, &kq.view,
+                &block_state.view, &block_output.view, &workspace.view,
+                1, kh, vh, 128, reordered, width, offset,
+            ).unwrap();
+            batch.commit_wait().unwrap();
+            let actual = block_output.read();
+            let sequential = sequential_output.read();
+            assert_eq!(
+                actual.iter().map(|x| x.to_bits()).collect::<Vec<_>>(),
+                sequential.iter().map(|x| x.to_bits()).collect::<Vec<_>>(),
+                "same-token output differs for reordered={reordered}",
+            );
+            // This reference updates every state component in f64, then dots
+            // that state with Q. It does not use the supplied K·Q or block solve.
+            let case = Case {
+                n: 1, kh, vh, reordered, width, offset,
+                q: q.read(), k: k.read(), conv: conv_values.clone(),
+                decay: decay.read(), beta: beta.read(),
+                state: vec![0.0; vh * 128 * 128],
+            };
+            let oracle = serial(&case);
+            close(&actual, &oracle.0, "same-token output");
+            close(&block_state.read(), &oracle.1, "same-token state");
+            sequential_state.check();
+            workspace.check();
+        }
+        for input in [&conv, &alpha, &beta_in, &a, &dt, &q, &k, &decay, &beta, &kq] {
+            input.check();
+        }
+        assert_eq!(kq.read(), dots, "prepared diagonal changed");
+    });
+}
