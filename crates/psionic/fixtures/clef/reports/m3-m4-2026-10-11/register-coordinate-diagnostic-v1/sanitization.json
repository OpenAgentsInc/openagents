  "rules": [
    "Replace private absolute paths with documented labels; preserve original SHA-256 values.",
    "Split each original JSON coordinate export into eight object files and one header without dropping slots or holes.",
    "Reconstruct both complete original JSON and raw UInt32 files exactly with restore_exports.py; verify original SHA-256.",
    "Do not include executables, metallibs, or model weights. No outcomes are removed."
  ],
