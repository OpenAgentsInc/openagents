+#[test]
+#[ignore = "requires explicit Metal hardware validation"]
+fn block_delta_carries_correlated_state_across_2032_tokens() {
+    let metal = metal();
+    let case = Case::correlated(2032, 1, 1, false);
+    let chunks = [257, 257, 257, 257, 257, 257, 257, 233];
+    let oracle = serial(&case);
+    let sequential = run(&metal, &case, &chunks, false);
+    close(&sequential.0, &oracle.0, "long sequential output");
+    close(&sequential.1, &oracle.1, "long sequential state");
+    for chunks in [&[2032][..], &chunks[..]] {
+        let actual = run(&metal, &case, chunks, true);
+        close(&actual.0, &oracle.0, "long block output");
+        close(&actual.1, &oracle.1, "long block state");
+        close(
+            &actual.0,
+            &sequential
+                .0
+                .iter()
+                .map(|&x| f64::from(x))
+                .collect::<Vec<_>>(),
+            "long baseline output",
+        );
+        close(
+            &actual.1,
+            &sequential
+                .1
+                .iter()
+                .map(|&x| f64::from(x))
+                .collect::<Vec<_>>(),
+            "long baseline state",
+        );
+        let worst = actual
+            .0
+            .iter()
+            .zip(&sequential.0)
+            .map(|(a, b)| (a - b).abs())
+            .fold(0.0f32, f32::max);
+        eprintln!("long block Delta: chunks={chunks:?} max_abs_delta={worst:.8e}");
+    }
+}
