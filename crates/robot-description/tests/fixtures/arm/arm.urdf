<?xml version="1.0"?>
<!--
  A hand-written six-joint desk arm with SO-101-like proportions, for the
  robot-description tests and the Verse capture. It is not the SO-101
  description and copies none of its files. The base mesh is in
  millimeters and scaled into meters here.
-->
<robot name="desk_arm">
  <material name="printed">
    <color rgba="0.95 0.72 0.12 1"/>
  </material>
  <material name="servo">
    <color rgba="0.08 0.08 0.09 1"/>
  </material>

  <link name="base">
    <visual>
      <geometry>
        <mesh filename="meshes/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="printed"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.025"/>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  <link name="shoulder">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <material name="servo"/>
    </visual>
  </link>
  <link name="upper_arm">
    <visual>
      <origin xyz="0 0 0.055"/>
      <geometry>
        <box size="0.03 0.03 0.11"/>
      </geometry>
      <material name="printed"/>
    </visual>
  </link>
  <link name="forearm">
    <visual>
      <origin xyz="0 0 0.065"/>
      <geometry>
        <box size="0.028 0.028 0.13"/>
      </geometry>
      <material name="printed"/>
    </visual>
  </link>
  <link name="wrist">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <box size="0.03 0.03 0.05"/>
      </geometry>
      <material name="servo"/>
    </visual>
  </link>
  <link name="gripper">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry>
        <box size="0.04 0.02 0.06"/>
      </geometry>
      <material name="printed"/>
    </visual>
  </link>
  <link name="jaw">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry>
        <box size="0.01 0.02 0.06"/>
      </geometry>
      <material name="printed"/>
    </visual>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base"/>
    <child link="shoulder"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.92" upper="1.92" effort="3" velocity="5"/>
  </joint>
  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.75" upper="1.75" effort="3" velocity="5"/>
  </joint>
  <joint name="elbow_flex" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 0.11"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.69" upper="1.69" effort="3" velocity="5"/>
  </joint>
  <joint name="wrist_flex" type="revolute">
    <parent link="forearm"/>
    <child link="wrist"/>
    <origin xyz="0 0 0.13"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.66" upper="1.66" effort="3" velocity="5"/>
  </joint>
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist"/>
    <child link="gripper"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.74" upper="2.84" effort="3" velocity="5"/>
  </joint>
  <joint name="gripper" type="revolute">
    <parent link="gripper"/>
    <child link="jaw"/>
    <origin xyz="0.02 0 0.02"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.17" upper="1.75" effort="3" velocity="5"/>
  </joint>
</robot>
