snap.level.v1
# Job 5: build a berth that fits the cargo ship and holds when it tugs
# on its moorings.
name Cargo Dock
number 5
crew cog
job dock B
area -2 -3 5 4
give module -0.5 -0.5 0
give module -0.5 0.5 0 B
give module -0.5 1.5 0
tray square 8 triangle 4 strut 6 bolt 8
par 18
run 11
ship 9 0.5 2.6 0.8 1.6 0.15
moor 3 1.5
