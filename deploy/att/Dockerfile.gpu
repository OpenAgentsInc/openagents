# The NIP-ATT attested decision provider, GPU lane (#11241;
# docs/security/private-inference.md): Psionic's Clef lane on CUDA on one
# NVIDIA H100 in confidential-computing mode, and the pylon's attested
# serve mode, run as a Google Confidential Space workload on an
# a3-highgpu-1g (Intel TDX + H100). Built by deploy/att/cloudbuild-gpu.yaml
# from a `git archive` of one commit, reproducibly like deploy/att/Dockerfile:
# base images pinned by digest, the Rust toolchain copied from the same
# pinned rust image, --locked builds at fixed paths with remapped path
# prefixes, SOURCE_DATE_EPOCH, and BuildKit's rewrite-timestamp.
#
# The builder is NVIDIA's CUDA 13.0 devel image, so Psionic's CUDA backend
# compiles its real kernels with nvcc for sm_90 (H100) instead of stubs; the
# build refuses to finish unless psionic-openai-server links libcudart and
# carries sm_90 code. The final image is NVIDIA's CUDA 13.0 runtime image
# (cudart and cuBLAS, which Psionic loads as libcudart.so.13 and
# libcublas.so.13) plus two binaries and this configuration. The driver
# libraries come from the host: Confidential Space installs NVIDIA's
# confidential-computing driver (tee-install-gpu-driver=true) and mounts it
# at /usr/local/nvidia/lib64.
ARG RUST_IMAGE=rust:1.97.1-slim-trixie@sha256:8e8cf8f7fd54a2d23d5a743b3a03f56e26b6c774276c33fa0595111704ebb15c
ARG CUDA_DEVEL_IMAGE=nvidia/cuda:13.0.2-devel-ubuntu24.04@sha256:5dc1bca23d05bd37b011be68ec470c03b403a5da07ec3a86e41af9470e9d0cc6
ARG CUDA_RUNTIME_IMAGE=nvidia/cuda:13.0.2-runtime-ubuntu24.04@sha256:6a0e31b59e70890446f2c17356d6efc0d54260090a8c63d6ca7c2ad049db95d2

FROM ${RUST_IMAGE} AS rust

FROM ${CUDA_DEVEL_IMAGE} AS builder
ARG SOURCE_DATE_EPOCH=0
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/cuda/bin:${PATH} \
    NVCC=/usr/local/cuda/bin/nvcc \
    PSI_CUDA_ARCH=90 \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    CARGO_PROFILE_RELEASE_DEBUG=0 \
    RUSTFLAGS="--remap-path-prefix=/build=/src --remap-path-prefix=/usr/local/cargo=/cargo -C link-arg=-Wl,--build-id=none"
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY . .
# Psionic is its own workspace (crates/psionic). With nvcc present its CUDA
# backend builds the real kernels; check that it did (a stub build links no
# cudart and carries no sm_90 code).
RUN cd crates/psionic \
    && cargo build --locked --release -p psionic-serve --bin psionic-openai-server \
    && ldd target/release/psionic-openai-server | grep -q 'libcudart\.so\.13' \
    && cuobjdump --list-elf target/release/psionic-openai-server | grep -q 'sm_90' \
    && echo "psionic-openai-server: real CUDA kernels for sm_90, cudart linked" \
    && strip --strip-all target/release/psionic-openai-server \
    && cp target/release/psionic-openai-server /psionic-openai-server
RUN cargo build --locked --release -p pylon --bin pylon \
    && strip --strip-all target/release/pylon \
    && cp target/release/pylon /pylon \
    && sha256sum /psionic-openai-server /pylon

FROM ${CUDA_RUNTIME_IMAGE}
COPY --from=builder /psionic-openai-server /usr/local/bin/psionic-openai-server
COPY --from=builder /pylon /usr/local/bin/pylon
# Confidential Space launch policy: the operator may set only the release
# ID (the client checks the release against the image digest anyway), and
# the workload's stdout goes to Cloud Logging. The pylon logs no prompt or
# answer.
LABEL "tee.launch_policy.allow_env_override"="OA_ATT_RELEASE" \
      "tee.launch_policy.log_redirect"="always" \
      "org.opencontainers.image.source"="https://github.com/OpenAgentsInc/openagents"
ENV OA_ATT_PUBLISHER=77fabebbeb49a7b9b384422ee6ef5662cf4db7da70acc94981378c0017ecc56e \
    OPENAGENTS_PYLON_HOME=/tmp/pylon \
    LD_LIBRARY_PATH=/usr/local/nvidia/lib64:/usr/local/cuda/lib64
# --require-gpu-cc: refuse to start unless Google's token says the GPU is
# an H100 in confidential-computing mode (NIP-ATT).
ENTRYPOINT ["/usr/local/bin/pylon", "serve", "--attested", \
    "--workload", "clef-decisions-gpu", \
    "--decision-device", "cuda", "--decision-chunk", "2048", "--require-gpu-cc", \
    "--weights-url", "https://huggingface.co/ggml-org/Clef-Flash-GGUF/resolve/4a192915ef971886004b5b13294f2b4c7a7fc39d/Clef-Flash-Q4_K_M.gguf", \
    "--weights-sha256", "fd3e90605e8103307dca37cb5a8cdb036267e2fe3cb2d908d80a8ceb9ec0638c", \
    "--weights", "/tmp/Clef-Flash-Q4_K_M.gguf", \
    "--psionic", "/usr/local/bin/psionic-openai-server", \
    "--pylon", "att-h100", "--slots", "2", "--rate", "20"]
