# Build context for deploy/att/Dockerfile: the workspace manifest, every
# crate (Psionic included), Cargo's configuration, the vendored sources,
# the NIP texts some crates compile in, and the recipe itself.
/*
!/Cargo.toml
!/Cargo.lock
!/vendor/
!/.cargo/
!/crates/
!/nips/
# coder-lease compiles in the agent build environment (#12071).
!/scripts/
/scripts/*
!/scripts/dev/
/scripts/dev/*
!/scripts/dev/cargo-build-env.sh
!/deploy/
/deploy/*
!/deploy/att/
!/migrations/
!/assets/
!/knowledge/
!/programs/
!/questions/
!/plugins/
!/packages/
**/target/
