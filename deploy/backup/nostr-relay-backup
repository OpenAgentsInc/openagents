#!/bin/sh
# Create one restorable nostr-relay backup unit: a database dump, a media
# archive that holds every blob the dump references, and a manifest that
# names both with their digests. The manifest is written last and only when
# both components are complete and verified; a run that fails leaves no
# manifest, so a dump or archive without one is not a restorable pair.
#
# Consistency rests on the relay's deletion barrier: a deleted blob's bytes
# stay under `<media root>/.deleted/` for `DELETED_RETENTION` (48 hours), and
# the dump is taken before staging. A blob the dump references is
# therefore either live or retained when staging reads it, as long as the
# run finishes inside that window. Only referenced blobs enter the archive.
# Staging temporarily needs one additional copy of the referenced media beside
# the archive; provision backup storage for both until cleanup completes.
#
# Environment (all optional):
#   NOSTR_RELAY_BACKUP_DIR        where the unit is written; default
#                                 /var/backups/nostr-relay
#   NOSTR_RELAY_BACKUP_DATABASE   pg_dump --dbname value; default nostr_relay
#   NOSTR_RELAY_MEDIA_ROOT        media root; default /var/lib/nostr-relay/media
#   NOSTR_RELAY_BACKUP_RETENTION  days to keep units; default 14
set -eu

backup_dir="${NOSTR_RELAY_BACKUP_DIR:-/var/backups/nostr-relay}"
database="${NOSTR_RELAY_BACKUP_DATABASE:-nostr_relay}"
media_root="${NOSTR_RELAY_MEDIA_ROOT:-/var/lib/nostr-relay/media}"
retention_days="${NOSTR_RELAY_BACKUP_RETENTION:-14}"
stamp="$(date -u +%Y-%m-%dT%H%M%SZ)"
unit="nostr-relay-${stamp}"
dump="${backup_dir}/${unit}.dump"
archive="${backup_dir}/${unit}-media.tar"
manifest="${backup_dir}/${unit}.manifest"
work="${backup_dir}/.${unit}.work"

cleanup() {
    rm -rf -- "${work}"
}
trap cleanup EXIT HUP INT TERM

fail() {
    echo "nostr-relay-backup: $*" >&2
    exit 1
}

umask 077
test -d "${backup_dir}" || fail "backup directory ${backup_dir} is missing"
mkdir -- "${work}"

# 1. Database dump. It is the reference set for the archive.
pg_dump --dbname="${database}" --format=custom --no-owner --no-acl \
    --file="${work}/db.dump"

# 2. Read the dump's reference set before collecting immutable blob bytes.
# Walking the live tree can miss a blob renamed into an already visited
# .deleted directory. Copy each reference from its live path, falling back
# to the retained path if deletion wins the open, then archive the staging tree.
pg_restore --data-only --table=media_blob --file="${work}/media_blob.sql" \
    "${work}/db.dump"
awk '
    /^COPY / { copying = 1; next }
    /^\\\.$/ { copying = 0; next }
    copying && $6 == "t" { print $1 "\t" $2 }
' "${work}/media_blob.sql" | LC_ALL=C sort > "${work}/referenced.tsv"
mkdir -- "${work}/media"
while IFS="$(printf '\t')" read -r sha256 storage_key; do
    test -n "${sha256}" || continue
    case "${sha256}${storage_key}" in
        *[!0-9a-f]*) fail "invalid blob identity in dump" ;;
    esac
    test "${#sha256}" -eq 64 && test "${#storage_key}" -eq 64 \
        || fail "invalid blob identity length in dump"
    prefix="$(printf '%s' "${sha256}" | cut -c1-2)"
    mkdir -p -- "${work}/media/${prefix}"
    destination="${work}/media/${prefix}/${sha256}.${storage_key}"
    if ! cp -- "${media_root}/${prefix}/${sha256}.${storage_key}" "${destination}" 2>/dev/null; then
        cp -- "${media_root}/.deleted/${sha256}.${storage_key}" "${destination}" \
            || fail "blob ${sha256} is in the dump but has no readable bytes"
    fi
    test "$(sha256sum "${destination}" | cut -d' ' -f1)" = "${sha256}" \
        || fail "blob ${sha256} does not match its content digest"
done < "${work}/referenced.tsv"
tar --create --file="${work}/media.tar" --directory="${work}/media" .

# 3. Verify archive membership independently before publishing the pair.
tar --list --file="${work}/media.tar" | LC_ALL=C sort > "${work}/archived.txt"
missing=0
while IFS="$(printf '\t')" read -r sha256 storage_key; do
    prefix="$(printf '%s' "${sha256}" | cut -c1-2)"
    if ! grep -qxF -e "./${prefix}/${sha256}.${storage_key}" \
        -e "./.deleted/${sha256}.${storage_key}" "${work}/archived.txt"
    then
        echo "nostr-relay-backup: blob ${sha256} is in the dump but not the archive" >&2
        missing=$((missing + 1))
    fi
done < "${work}/referenced.tsv"
test "${missing}" -eq 0 || fail "${missing} referenced blob(s) missing; no manifest written"

# 4. Publish. The dump and archive move into place first; the manifest,
#    naming both with their digests, is the last write.
chmod 0600 "${work}/db.dump" "${work}/media.tar"
mv -- "${work}/db.dump" "${dump}"
mv -- "${work}/media.tar" "${archive}"
dump_digest="$(sha256sum "${dump}" | cut -d' ' -f1)"
archive_digest="$(sha256sum "${archive}" | cut -d' ' -f1)"
referenced="$(wc -l < "${work}/referenced.tsv" | tr -d ' ')"
{
    printf 'unit\t%s\n' "${unit}"
    printf 'created_at\t%s\n' "${stamp}"
    printf 'database\t%s\t%s\t%s\n' "$(basename -- "${dump}")" "${dump_digest}" \
        "$(wc -c < "${dump}" | tr -d ' ')"
    printf 'media\t%s\t%s\t%s\n' "$(basename -- "${archive}")" "${archive_digest}" \
        "$(wc -c < "${archive}" | tr -d ' ')"
    printf 'referenced_blobs\t%s\n' "${referenced}"
} > "${work}/manifest"
chmod 0600 "${work}/manifest"
mv -- "${work}/manifest" "${manifest}"

# 5. Retention: whole units past the window go together. A dump or archive
#    whose manifest never appeared is a failed run and goes at once.
find "${backup_dir}" -maxdepth 1 -type f -name 'nostr-relay-*.manifest' \
    -mtime "+${retention_days}" | while read -r old_manifest; do
    old_unit="$(basename -- "${old_manifest}" .manifest)"
    rm -f -- "${backup_dir}/${old_unit}.dump" "${backup_dir}/${old_unit}-media.tar" \
        "${old_manifest}"
done
for candidate in "${backup_dir}"/nostr-relay-*.dump; do
    test -f "${candidate}" || continue
    candidate_unit="$(basename -- "${candidate}" .dump)"
    if test "${candidate_unit}" != "${unit}" \
        && ! test -f "${backup_dir}/${candidate_unit}.manifest"
    then
        rm -f -- "${candidate}" "${backup_dir}/${candidate_unit}-media.tar"
    fi
done
