# Copy to /etc/coder-worker/coder-worker-chat.env, replace every placeholder,
# and keep the installed file root:coder-worker mode 0640. This is the
# OpenAgents chat worker: the basic Coder that the OpenAgents app talks to
# before any computer is connected. Read docs/deployment/chat-worker.md.
#
# The credential decision, stated once:
#
# - One worker key. CODER_WORKER_SECRET is the chat worker's identity. The
#   app ships its public key (`basic_coder::WORKER` in
#   crates/openagents-mobile), so the secret here must be the one whose
#   public key the app carries. Rotating it needs an app release.
# - One door key. CODER_DOOR_KEY is the gateway credential the worker pays
#   with. It lives here and nowhere else; no app carries a model key.
# - Open, with no usage limit (#10120). A fresh install's device key is one
#   no operator has seen, so the worker answers every caller
#   (CODER_WORKER_OPEN=1) with conversation jobs and counts nothing; every
#   job is recorded in the usage log instead. `coder-worker --check` refuses
#   a worker off loopback that names no customers and is not opened.

# --- Identity ----------------------------------------------------------------

# 64 hex characters or an nsec.
CODER_WORKER_SECRET=<THE_CHAT_WORKER_SECRET>

# --- Relay -------------------------------------------------------------------

CODER_RELAY=wss://relay.openagents.com

# --- Admission ---------------------------------------------------------------

# Answer every caller, with no usage limit: conversation jobs only, each
# request at most 96 KiB.
CODER_WORKER_OPEN=1

# An abuse brake for emergencies only. Leave it unset: unset is unlimited.
# Each part is unlimited unless named: minute=N and day=N per caller key,
# total=N for every caller together per UTC day, bytes=N the size bound.
#CODER_WORKER_QUOTA=minute=600
#CODER_WORKER_QUOTA_FILE=/var/lib/coder-worker-chat/quota.json

# The usage log: one JSON line per job, rotated by UTC day. Unset, it is
# usage/ in the unit's state directory, which is this path.
# Read it with `coder-worker usage` (docs/deployment/chat-worker-usage.md).
#CODER_WORKER_USAGE_DIR=/var/lib/coder-worker-chat/usage
# Days of usage files kept, today included; older day files are deleted at
# start and as each new day begins (#11042). Unset is 30; `forever` keeps
# them all.
#CODER_WORKER_USAGE_DAYS=30

# Operator keys this worker answers with everything (delegation and
# execution too), comma-separated npub or hex. Optional.
#CODER_WORKER_ALLOW=<OPERATOR_NPUB>

# Jobs that run at once; a job past the bound is refused busy. Chat jobs
# wait on the network, not this machine, so the bound is wide.
CODER_WORKER_JOBS=64

# --- First door: Gemini on Vertex AI (2026-10-10, #11219) --------------------
# google/gemini-3.8-flash on Vertex AI, billed to the prepaid Google credit,
# in front of every door below (CODER_WORKER_VERTEX; on whenever
# VERTEX_PROJECT is set, `off` to leave it out). On the VM the token is the
# instance service account's, from the metadata server; no key file.
VERTEX_PROJECT=openagentsgemini
VERTEX_LOCATION=global
GCE_METADATA_HOST=metadata.google.internal
# Vertex embeddings for the product notes and the Gym records (gemini-
# embedding-001 at 768 dimensions; text-embedding-005 when unset). The
# codebase index is read with the model it was built with.
KB_VERTEX_PROJECT=openagentsgemini
KB_VERTEX_MODEL=gemini-embedding-001

# --- Door: the Open Responses gateway ----------------------------------------

CODER_DOOR_KEY=<YOUR_GATEWAY_KEY>
#CODER_DOOR_URL=https://ai-gateway.vercel.sh

# The lane: gemini (google/gemini-3.8-flash). With a primary (below), this
# door is the fallback.
CODER_WORKER_MODEL=gemini

# The primary every turn asks first, through OpenRouter at reasoning effort
# low (#10109). Unset, it is Gemini Flash (google/gemini-3.8-flash; Space
# Bunny Alpha was retired 2026-10-05) whenever OPENROUTER_API_KEY is set (it
# is, below, for personalization), so no variable is needed; a lane name or
# an OpenRouter model id names another, and `off` answers on the door above
# alone. A turn the primary has not started in four seconds (or, while it
# streams its reasoning, answered in eight), or that it fails before its
# first words (402, 401/403, 404, 429, 5xx, no connection), goes to the door
# above, then to each backup below in turn.
#CODER_WORKER_PRIMARY=gemini

# The backups after the primary and the door above (2026-10-09 failover):
# `door:model` entries, the door `openrouter` (OPENROUTER_API_KEY) or
# `vercel` (AI_GATEWAY_API_KEY), or `off`. Unset, every entry of
# openrouter:gemini,openrouter:glm,vercel:gemini,vercel:glm whose key is
# here. A door that answers 404 (model gone) sits out 30 minutes, one that
# answers 401/402/403 (key or account) five; the journal logs each switch
# ("… takes the turn") and each bench.
#CODER_WORKER_BACKUPS=openrouter:gemini,openrouter:glm,vercel:gemini,vercel:glm

# What every chat-model request asks its provider (#11040), beside
# "store": false. strict (unset): OpenRouter gets provider.data_collection
# "deny" and provider.zdr true, the Vercel AI Gateway gets
# providerOptions.gateway.zeroDataRetention true. no-training: OpenRouter's
# data_collection "deny" only. off: neither. A model with no endpoint that
# honors the request is refused by the router, so under strict a primary
# without zero retention fails every turn over to the door above; the
# worker's `privacy` log line names the level. OpenRouter personalization
# (below) reads the same variable.
#CODER_PROVIDER_PRIVACY=strict

# --- Judge: the first response (Jev) -----------------------------------------

# The TypeSafe key the worker's System One judge answers through. With it, an
# admitted turn that asks ("opener": true) gets a typed judgment in well under
# a second, beside the model call rather than in front of it: a prepared
# answer as the whole reply, or a one-line opener, when Jev is sure enough of
# one (coder-first-response-v2), and `rank` jobs
# are answered. Without it, the reply starts at the model's first token.
# The worker's first log lines name the judge. Read coder::first.
TYPESAFE_API_KEY=<YOUR_TYPESAFE_KEY>
# Jev's fallback doors (jev::doors), asked in this order only when TypeSafe
# cannot answer for its own reasons (402, 429, 5xx, a timeout, no
# connection): the Vercel AI Gateway (typesafe-ai/jev) under
# AI_GATEWAY_API_KEY, then OpenRouter (typesafe/jev-1.13) under
# OPENROUTER_API_KEY (the same variable personalization reads below). A door
# with no key is off; the `judge` log lines say which. The privacy answer
# names the doors that are on.
#AI_GATEWAY_API_KEY=<YOUR_AI_GATEWAY_KEY>

# --- The chat router's seams -------------------------------------------------

# T1 personalization: OpenRouter's Gemini 2.5 Flash Lite finishes a stem such
# as "Working on ..." with the user's own request. Needs the
# owner's OpenRouter key; OpenRouter then receives the redacted latest message
# of a personalized turn, which the privacy answer names.
CODER_PERSONALIZE=openrouter
OPENROUTER_API_KEY=<YOUR_OPENROUTER_KEY>
# Product knowledge: knowledge/openagents/ copied beside the release, embedded
# on Vertex AI (above) at startup. `gateway` embeds through the AI Gateway
# with OpenRouter and OpenAI behind it instead.
OPENAGENTS_PRODUCT_KNOWLEDGE=/opt/coder-worker/chat/knowledge/openagents
OPENAGENTS_PRODUCT_KB_EMBEDDINGS=vertex
# Codebase knowledge: an index built by scripts/build-codebase-kb.sh with
# CODER_CODEBASE_EMBEDDINGS=vertex (text-embedding-005).
CODER_CODEBASE_KB=/opt/coder-worker/chat/codebase-kb.gz
# The CLI route is on whenever a judge is configured; `off` turns it off.
#CODER_WORKER_CLI=off
