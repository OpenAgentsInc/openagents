# Copy to /etc/coder-worker/coder-worker.env, replace every placeholder, and
# keep the installed file root:coder-worker mode 0640. Two secrets live here
# and nowhere else: the worker's identity and the door key it spends.
#
# The credential decision, stated once so nobody has to infer it:
#
# - One worker key. CODER_WORKER_SECRET is the service's identity. Its public
#   key is what customers put in CODER_WORKER, so rotating it is a customer-
#   visible change. Generate it once and keep it in this file only.
# - One door key. CODER_DOOR_KEY is the gateway credential the service pays
#   with. Every admitted job spends against it, so the spend control is the
#   allowlist below and nothing else.
# - An explicit allowlist. CODER_WORKER_ALLOW names every customer this
#   worker answers. A request names the worker with a public `p` tag, and
#   public keys are not secret, so a worker with this unset answers whoever
#   finds it on the same key. Never deploy an open worker: the binary logs
#   `admits every customer` when this is unset, and that line in the journal
#   is a misconfiguration.
#
# Anyone outside the list is refused with the typed NIP-CJ code
# `not_admitted`, which the terminal reports as `the worker declined
# (not_admitted)`. Widening the list is an edit here and a restart.

# --- Identity ----------------------------------------------------------------

# 64 hex characters or an nsec. Generate with: openssl rand -hex 32
# The worker prints the matching public key as `worker <hex>` on every
# start; that hex is what a customer sets CODER_WORKER to.
CODER_WORKER_SECRET=<YOUR_WORKER_SECRET>

# --- Relay -------------------------------------------------------------------

# The relay the worker subscribes to. On the relay's own host this may be the
# local listener, ws://127.0.0.1:8080, which keeps the worker's traffic off
# the public proxy; from anywhere else use the public URL.
CODER_RELAY=wss://relay.openagents.com

# --- Admission ---------------------------------------------------------------

# Comma-separated npub or hex public keys of the customers this worker
# answers. Required for a public relay. Never leave it unset in service.
CODER_WORKER_ALLOW=<CUSTOMER_NPUB>

# Jobs that run at once; a job past the bound is refused `busy`. Unset, a
# gateway worker runs four and an executor worker runs its manifest's
# `concurrent_max`.
CODER_WORKER_JOBS=4

# --- Door: the Open Responses gateway (default) ------------------------------

# The service's one gateway credential. CODER_AI_GATEWAY_KEY is read when
# this is unset; set exactly one of them. Leave both unset when the worker
# answers through a local executor instead; setting a key and CODER_EXECUTOR
# together is refused at start.
CODER_DOOR_KEY=<YOUR_GATEWAY_KEY>

# The door's base URL. Unset, the worker uses the public Vercel AI Gateway.
#CODER_DOOR_URL=https://ai-gateway.vercel.sh

# The lane or model this worker answers through: `gemini` (the default,
# google/gemini-3.8-flash), `glm` (zai/glm-5.3-flash), or a gateway model
# id. This outranks CODER_MODEL, which the worker does not read.
CODER_WORKER_MODEL=gemini

# --- Door: a local executor (alternative) ------------------------------------

# Uncomment this block, and comment out CODER_DOOR_KEY above, to answer jobs
# through an approved capability instead of the gateway. Read
# docs/coder/worker-executor.md and the executor section of deploy/README.md
# first: the executor needs the drop-in under deploy/systemd/ because it
# spawns a sandbox the hardened unit forbids.
#
# Capability slug under CODER_CAPABILITY_DIR, for example devin-local.
#CODER_EXECUTOR=devin-local
# Directory the executor runs in. Read-only to the job.
#CODER_EXECUTOR_WORKDIR=/var/lib/coder-worker/exec
# Bound for one job, in whole minutes.
#CODER_EXECUTOR_MINUTES=10
# Where manifests are read from; the checkout's capabilities/ directory.
#CODER_CAPABILITY_DIR=/opt/openagents/capabilities
# The trust store `capability-trust approve` wrote. Unset, the worker reads
# $HOME/.openagents/capability-trust.json, and the unit sets HOME to
# /var/lib/coder-worker.
#CODER_CAPABILITY_TRUST=/var/lib/coder-worker/capability-trust.json
# The executor's own state, inside the writable grant of the approval.
#XDG_DATA_HOME=/var/lib/coder-worker/jobs/xdg
