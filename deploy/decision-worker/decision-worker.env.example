# Copy to /etc/decision-worker/decision-worker.env, replace both
# placeholders, and keep the installed file root:root mode 0600 (systemd
# reads it as root). This is the hosted decision service: Jev for a
# computer with no TypeSafe key. Read docs/deployment/decision-worker.md.
#
# - One worker key. DECISION_WORKER_SECRET is the worker's identity.
#   Clients carry its public key (`jev_hosted::WORKER` in
#   crates/jev-hosted), so rotating it needs a client release.
# - One door key. TYPESAFE_API_KEY is the TypeSafe key the worker pays
#   with. It lives here and nowhere else; no client carries it.
# - Optional: a backup door key. OPENROUTER_API_KEY lets the worker ask
#   OpenRouter's Decisions API (typesafe/jev-1.13) when TypeSafe is
#   unreachable or refusing for its own reasons. Leave it out and the
#   backup stays off (the journal says so at start).

# 64 lowercase hex characters.
DECISION_WORKER_SECRET=replace-with-the-worker-secret

TYPESAFE_API_KEY=replace-with-the-typesafe-key

# Optional: uncomment and fill to turn the backup door on.
# OPENROUTER_API_KEY=replace-with-an-openrouter-key
