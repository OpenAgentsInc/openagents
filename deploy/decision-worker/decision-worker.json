{
  "relay": "wss://relay.openagents.com",
  "upstream": "https://api.typesafe.ai",
  "anonymous": false,
  "jobs": 8,
  "upstream_timeout_secs": 30,
  "jobs_dir": "/var/lib/decision-worker",
  "probe_secs": 30,
  "open": {
    "key_env": "TYPESAFE_API_KEY",
    "models": ["jev-1.13.0", "jev-latest"],
    "upstream_last": true,
    "quota": {
      "max_request_bytes": 262144,
      "file": "/var/lib/decision-worker/quota.json"
    }
  },
  "service": {
    "door": "https://api.typesafe.ai",
    "version": "decision-worker@RELEASE"
  },
  "backups": [
    {
      "url": "https://ai-gateway.vercel.sh/typesafe/v1/systemone",
      "key_env": "AI_GATEWAY_API_KEY",
      "door": "https://ai-gateway.vercel.sh",
      "naming": "gateway"
    },
    {
      "url": "https://openrouter.ai/api/alpha/decisions",
      "key_env": "OPENROUTER_API_KEY",
      "door": "https://openrouter.ai",
      "naming": "openrouter"
    }
  ]
}
