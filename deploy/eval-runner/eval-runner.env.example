# The hosted eval runner's environment: ~/.config/openagents/eval-runner.env
# on the runner host, mode 0600. docs/deployment/eval-runner.md explains
# each line. Never commit a filled copy.

# Where it listens and publishes.
EVAL_RUNNER_RELAY=wss://relay.openagents.com
# The runner key: 64 hex, mode 0600. Its public key is
# nostr::eval_ext::hosted::RUNNER, which the app sends to.
EVAL_RUNNER_KEY_FILE=/home/USER/.openagents/nostr/eval-runner-key
# Its ledger, counts, jobs, results, and usage log.
EVAL_RUNNER_STATE=/home/USER/.openagents/eval-runner

# Where suite files go. relay.openagents.com serves no Blossom media yet,
# so the runner keeps them in a public-read bucket, written by a service
# account that may only create objects there (its key and gcloud
# configuration stay on the host).
EVAL_RUNNER_BLOSSOM=https://storage.googleapis.com/openagentsgemini-eval-blobs
EVAL_RUNNER_BUCKET=gs://openagentsgemini-eval-blobs
EVAL_RUNNER_GCLOUD_CONFIG=/home/USER/.openagents/eval-runner-gcloud

# What it runs, from the worktree install.sh builds.
EVAL_RUNNER_CODER=/home/USER/.local/libexec/openagents-eval-runner/coder
EVAL_RUNNER_QUESTIONS=/home/USER/.cache/openagents/eval-runner/src/questions
# The catalog (EVAL_RUNNER_CATALOG) is not set here: install.sh writes it
# from deploy/eval-runner/catalog to ~/.cache/openagents/eval-runner/catalog.env,
# which the service reads after this file.
GYM_GATES_DIR=/home/USER/.cache/openagents/eval-runner/src/crates/gym/gates

# The chat door both arms answer through. The key never reaches a run.
CODER_DOOR_URL=https://ai-gateway.vercel.sh
CODER_MODEL=google/gemini-3.8-flash
CODER_DOOR_KEY=
# The decision door: decision graders and the child's classifier.
TYPESAFE_API_KEY=

# No usage limit (owner decision, 2026-10-01, #10121): a trainer may run
# as often as they like, and every job is a line in the usage log
# (usage/ in the state directory; `eval-runner usage` reads it). For an
# abuse emergency only, an operator may set EVAL_RUNNER_RUNS_PER_DAY (runs
# per trainer per UTC day) or EVAL_RUNNER_TURNS_PER_DAY (agent turns per
# UTC day for everyone) and restart; leave both unset otherwise.
# Suites and runs at once (queued, never refused):
EVAL_RUNNER_JOBS=2
EVAL_RUNNER_CONCURRENCY=4
