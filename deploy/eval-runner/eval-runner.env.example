# The hosted eval runner's environment: ~/.config/openagents/eval-runner.env
# on the runner host, mode 0600. docs/deployment/eval-runner.md explains
# each line. Never commit a filled copy.

# Where it listens and publishes.
EVAL_RUNNER_RELAY=wss://relay.openagents.com
# The runner key: 64 hex, mode 0600. Its public key is
# nostr::eval_ext::hosted::RUNNER, which the app sends to.
EVAL_RUNNER_KEY_FILE=/home/USER/.openagents/nostr/eval-runner-key
# Its ledger, quota, jobs, and results.
EVAL_RUNNER_STATE=/home/USER/.openagents/eval-runner

# What it runs, from the worktree install.sh builds.
EVAL_RUNNER_CODER=/home/USER/.local/libexec/openagents-eval-runner/coder
EVAL_RUNNER_QUESTIONS=/home/USER/.cache/openagents/eval-runner/src/questions
EVAL_RUNNER_CATALOG=/home/USER/.cache/openagents/eval-runner/src/crates/plugin-repo-map:/home/USER/.cache/openagents/eval-runner/src/crates/plugin-code-search:/home/USER/.cache/openagents/eval-runner/src/crates/plugin-test-report
GYM_GATES_DIR=/home/USER/.cache/openagents/eval-runner/src/crates/gym/gates

# The chat door both arms answer through. The key never reaches a run.
CODER_DOOR_URL=https://ai-gateway.vercel.sh
CODER_MODEL=google/gemini-3.8-flash
CODER_DOOR_KEY=
# The decision door: decision graders and the child's classifier.
TYPESAFE_API_KEY=

# Limits. A run is one test set; a check doesn't count against a trainer.
EVAL_RUNNER_RUNS_PER_DAY=3
# The spend ceiling: agent turns (tests x runs x 2 arms) per UTC day, for
# every trainer together.
EVAL_RUNNER_TURNS_PER_DAY=2000
EVAL_RUNNER_JOBS=2
EVAL_RUNNER_CONCURRENCY=4
