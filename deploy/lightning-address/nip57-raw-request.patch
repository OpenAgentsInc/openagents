+// Keep the description exactly as it was hashed when the invoice was issued.
+fn raw_zap_receipt(bolt11: &str, preimage: &str, raw: &str, request: &nostr::Event, keys: &nostr::Keys) -> Result<nostr::Event, anyhow::Error> {
+    let mut receipt=nostr::EventBuilder::zap_receipt(bolt11,Some(preimage.to_owned()),request).build(keys.public_key());
+    receipt.id=None;
+    receipt.tags.retain(|tag| tag.as_slice().first().map(String::as_str)!=Some("description"));
+    receipt.tags.push(nostr::Tag::parse(vec!["description".to_owned(),raw.to_owned()])?);
+    Ok(receipt.sign_with_keys(keys)?)
+}
+
+#[cfg(test)]
+mod raw_zap_tests {
+    use super::*;
+    use nostr::{EventBuilder,JsonUtil,Keys,Kind};
+    #[test]
+    fn raw_zap_receipt_keeps_the_invoice_description_with_its_original_formatting() {
+        let keys=Keys::generate();
+        let request=EventBuilder::new(Kind::ZapRequest,"").sign_with_keys(&keys).unwrap();
+        let raw=serde_json::to_string_pretty(&request).unwrap();
+        assert_ne!(raw,request.as_json());
+        let receipt=raw_zap_receipt("lnbc1","fixture",&raw,&request,&keys).unwrap();
+        receipt.verify().unwrap();
+        let descriptions:Vec<_>=receipt.tags.iter().filter(|tag|tag.as_slice().first().map(String::as_str)==Some("description")).collect();
+        assert_eq!(descriptions.len(),1);
+        assert_eq!(descriptions[0].as_slice()[1],raw);
+    }
+}
