[Unit]
Description=OpenAgents encrypted LND backup upload
After=openagents-lnd-backups.service
OnFailure=openagents-lnd-alert.service
[Service]
User=oa-lnd-backup
Group=oa-lnd-backup
ExecStart=/usr/local/sbin/openagents-lnd-backup-upload
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/openagents-lnd-backup
[Install]
WantedBy=multi-user.target
