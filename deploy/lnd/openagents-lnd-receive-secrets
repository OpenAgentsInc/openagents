#!/usr/bin/env bash
# Fetch only receive and read-only credentials; never a node seed or payout key.
set -euo pipefail
umask 077
runtime=/run/openagents-lnd-receive
install -d -o root -g openagents-pay -m 0750 "$runtime"
export CLOUDSDK_CONFIG="$runtime/gcloud"
install -d -m 0700 "$CLOUDSDK_CONFIG"
for role in invoice readonly; do
  temporary="$runtime/$role.new"
  gcloud --quiet secrets versions access latest --project=openagentsgemini --secret="lnd-oa-lnd-1-macaroon-$role" --out-file="$temporary" >/dev/null
  chown openagents-pay:openagents-pay "$temporary"
  chmod 0600 "$temporary"
  mv "$temporary" "$runtime/$role.macaroon"
done
gcloud --quiet secrets versions access latest --project=openagentsgemini --secret=lnd-oa-lnd-1-tls-cert --out-file="$runtime/tls.cert" >/dev/null
pin=$(openssl x509 -in "$runtime/tls.cert" -outform DER | sha256sum | cut -d' ' -f1)
# A staged stanza; installing credentials does not change the active routes.
cat > "$runtime/receive.toml" <<CONFIG
[lnd_receive]
backend = "mdk"
network = "mainnet"
endpoint = "https://10.128.0.103:10009"
node_id = "03bb4d4950167daf3f9693c6cdb70cbe160ebbd19afacc1ea509116b2d716c4acd"
certificate_sha256 = "$pin"
invoice_macaroon = "$runtime/invoice.macaroon"
readonly_macaroon = "$runtime/readonly.macaroon"
CONFIG
chown openagents-pay:openagents-pay "$runtime/receive.toml"
chmod 0600 "$runtime/receive.toml"
