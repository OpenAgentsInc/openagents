[Unit]
Description=Load the experimental LND receiver credentials
After=network-online.target
Wants=network-online.target
Before=openagents-pay-front.service openagents-pay-reconcile.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/openagents-lnd-receive-secrets
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run
[Install]
WantedBy=multi-user.target
