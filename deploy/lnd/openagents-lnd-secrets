#!/usr/bin/env bash
# Render root-owned runtime files; never print secret values.
set -euo pipefail
umask 077
project=openagentsgemini
region=us-central1
node=oa-lnd-1
runtime=/run/openagents-lnd/secrets
install -d -o root -g oa-lnd -m 0750 "$runtime"
export CLOUDSDK_CONFIG="$runtime/gcloud"
install -d -o root -g root -m 0700 "$CLOUDSDK_CONFIG"
if [[ ${1:-} == --initialize-password ]]; then
  if ! gcloud --quiet secrets versions access latest --project="$project" --secret="lnd-$node-password-kms" > "$runtime/password.enc" 2> "$runtime/password-status"; then
    if ! grep -q 'NOT_FOUND' "$runtime/password-status"; then echo 'Could not check the existing wallet password.' >&2; exit 1; fi
    # A fresh password is generated here; the wallet seed is generated by LND.
    openssl rand -hex 32 | tr -d '\n' > "$runtime/password"
    gcloud --quiet kms encrypt --project="$project" --location="$region" --keyring=openagents-lnd --key="$node-password" \
      --plaintext-file="$runtime/password" --ciphertext-file="$runtime/password.enc"
    gcloud --quiet secrets versions add "lnd-$node-password-kms" --project="$project" --data-file="$runtime/password.enc" >/dev/null
  else
    echo 'A wallet password already exists; initialization refused.' >&2
    exit 1
  fi
else
  gcloud --quiet secrets versions access latest --project="$project" --secret="lnd-$node-password-kms" > "$runtime/password.enc"
fi
gcloud --quiet kms decrypt --project="$project" --location="$region" --keyring=openagents-lnd --key="$node-password" \
  --ciphertext-file="$runtime/password.enc" --plaintext-file="$runtime/password" >/dev/null
gcloud --quiet secrets versions access latest --project="$project" --secret=oa-bitcoind-rpc-creds > "$runtime/bitcoin-rpc"
private_ip=$(curl -fsS -H Metadata-Flavor:Google http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/ip)
external_ip=$(curl -fsS -H Metadata-Flavor:Google http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/access-configs/0/external-ip)
LND_PRIVATE_IP="$private_ip" LND_EXTERNAL_IP="$external_ip" LND_RUNTIME="$runtime" python3 - <<'PY'
import os,pathlib
root=pathlib.Path(os.environ['LND_RUNTIME'])
fields=dict(line.split('=',1) for line in (root/'bitcoin-rpc').read_text().splitlines() if '=' in line and not line.startswith('#'))
user,password=fields['rpcuser'],fields['rpcpassword']
if any('\n' in s or '\r' in s for s in [user,password]):raise SystemExit('Invalid Bitcoin RPC credential format')
text=f'''[Application Options]
lnddir=/var/lib/openagents-lnd/lnd
listen=0.0.0.0:9735
externalip={os.environ['LND_EXTERNAL_IP']}:9735
rpclisten=127.0.0.1:10009
rpclisten={os.environ['LND_PRIVATE_IP']}:10009
restlisten=127.0.0.1:8080
tlsextraip={os.environ['LND_PRIVATE_IP']}
debuglevel=info
maxpendingchannels=1
[Bitcoin]
bitcoin.mainnet=true
bitcoin.node=bitcoind
[Bitcoind]
bitcoind.rpchost=10.42.0.2:8332
bitcoind.rpcuser={user}
bitcoind.rpcpass={password}
bitcoind.zmqpubrawblock=tcp://10.42.0.2:28332
bitcoind.zmqpubrawtx=tcp://10.42.0.2:28333
'''
(root/'lnd.conf').write_text(text)
PY
chown root:oa-lnd "$runtime/password" "$runtime/lnd.conf"
chmod 0640 "$runtime/password" "$runtime/lnd.conf"
rm -f "$runtime/password.enc" "$runtime/bitcoin-rpc"
