[Unit]
Description=OpenAgents third-party watchtower Tor connection
After=tor@default.service
Wants=tor@default.service
[Service]
DynamicUser=true
ExecStart=/usr/bin/socat TCP4-LISTEN:19911,bind=127.0.0.1,reuseaddr,fork SOCKS4A:127.0.0.1:6kh3htmifene35brvqwvm6jasdb72g56kgmz2f5jrpovk3tq3xmfw3qd.onion:9911,socksport=9050
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
[Install]
WantedBy=multi-user.target
