# Copy to /etc/nostr-relay/nostr-relay.env, replace every placeholder, and keep
# the installed file root:nostr-relay mode 0640.
DATABASE_URL=postgres://nostr_relay:<YOUR_DB_PASSWORD>@127.0.0.1:5432/nostr-relay
NOSTR_RELAY_BIND_ADDR=127.0.0.1
NOSTR_RELAY_PORT=8080
NOSTR_RELAY_URL=wss://relay.example.com
NOSTR_RELAY_TRUST_PROXY=true
# Proxies that append to X-Forwarded-For: 1 for this nginx config or Cloud
# Run alone, 2 for an external load balancer in front of Cloud Run.
NOSTR_RELAY_TRUSTED_HOPS=1
NOSTR_RELAY_EXPIRATION_SWEEP_SECONDS=60
NOSTR_RELAY_MEDIA_ROOT=/var/lib/nostr-relay/media
NOSTR_RELAY_MEDIA_MAX_BLOB_BYTES=10485760
NOSTR_RELAY_MEDIA_MAX_BYTES_PER_PUBKEY=1073741824
NOSTR_RELAY_RATE_GIFT_WRAPS_PER_MIN_RECIPIENT=60
NOSTR_RELAY_RATE_OBSERVER_PER_SEC_IP=200
NOSTR_RELAY_RATE_OBSERVER_PER_SEC_AGENT=100
NOSTR_RELAY_RATE_MEDIA_PER_MIN_IP=30
NOSTR_RELAY_RATE_MEDIA_PER_MIN_PUBKEY=15
NOSTR_RELAY_LOG_LEVEL=info
NOSTR_RELAY_SHUTDOWN_GRACE_SECONDS=10
# Optional NIP-29/NIP-86 settings contain sensitive material. Add them only to
# the installed protected file as documented in docs/deployment/configuration.md;
# never commit real values.
# Optional NIP-RS atomic snapshots: set a canonical community UUID in the
# installed configuration. The public Host must match NOSTR_RELAY_URL.
# NOSTR_RELAY_READ_STATE_COMMUNITY=<YOUR_COMMUNITY_UUID>
# NIP-PL delivery is off unless NOSTR_RELAY_PUSH_SECRET is set in the installed
# protected file; the other push variables are then required. See
# docs/deployment/configuration.md. Never commit real values.
# One profile (single-profile form):
# NOSTR_RELAY_PUSH_SECRET=<64_HEX_EXECUTOR_SECRET>
# NOSTR_RELAY_PUSH_APP_PROFILE=<APP_PROFILE_ID>
# NOSTR_RELAY_PUSH_TRANSPORT=apns
# NOSTR_RELAY_PUSH_GATEWAY=http://127.0.0.1:8090
# iPhones and Android phones from one relay (multi-profile form); do not
# combine it with the single-profile settings above:
# NOSTR_RELAY_PUSH_PROFILES=IOS,ANDROID
# NOSTR_RELAY_PUSH_PROFILE_IOS_APP_PROFILE=<IOS_APP_PROFILE_ID>
# NOSTR_RELAY_PUSH_PROFILE_IOS_TRANSPORT=apns
# NOSTR_RELAY_PUSH_PROFILE_IOS_GATEWAY=http://127.0.0.1:8090
# NOSTR_RELAY_PUSH_PROFILE_ANDROID_APP_PROFILE=<ANDROID_APP_PROFILE_ID>
# NOSTR_RELAY_PUSH_PROFILE_ANDROID_TRANSPORT=fcm
# NOSTR_RELAY_PUSH_PROFILE_ANDROID_GATEWAY=http://127.0.0.1:8090
