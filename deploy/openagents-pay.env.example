# Copy to /etc/openagents-pay/openagents-pay.env and keep it root:openagents-pay
# mode 0640. This file names where things live; it holds no credential. The
# wallet seed is in Secret Manager (OPENAGENTS_PAY_SEED_SECRET) and the backup
# decryption key is in Secret Manager too, never on this host.
# See docs/deployment/pay-host.md.

# --- The wallet (the x402 payTo node) -----------------------------------------

# config.json, the `seed` symlink, ldk/ (the channel store), control.sock.
OPENAGENTS_WALLET_HOME=/var/lib/openagents-pay/wallet
# The x402 replay store: one per payTo, shared by every process that settles
# for this node, never rolled back (docs/deployment/pay-host.md, Restore).
OPENAGENTS_X402_HOME=/var/lib/openagents-pay/x402
HOME=/var/lib/openagents-pay

# --- Secret Manager -------------------------------------------------------------

OPENAGENTS_PAY_PROJECT=<GCP_PROJECT_ID>
# Holds the BIP39 mnemonic. The host's service account may read it and add
# versions; nothing else on the host can.
OPENAGENTS_PAY_SEED_SECRET=openagents-pay-wallet-seed

# --- Backups ------------------------------------------------------------------

# Every hour the backup unit writes `x402 node backup`, the replay store, and the
# ledger into one tar, encrypts it to this age recipient, and uploads it. The
# matching identity is in Secret Manager (openagents-pay-backup-age-key) and
# is not on this host, so the host can write backups but cannot read them.
OPENAGENTS_PAY_BACKUP_RECIPIENT=<AGE_RECIPIENT age1...>
OPENAGENTS_PAY_BACKUP_BUCKET=<BUCKET_NAME>
# Object prefix inside the bucket; one per host.
OPENAGENTS_PAY_BACKUP_PREFIX=<HOST_NAME>
# Encrypted copies kept on the data disk as well.
OPENAGENTS_PAY_BACKUP_LOCAL_KEEP=48

# --- Health -------------------------------------------------------------------

# The health check fails when the newest backup is older than this.
OPENAGENTS_PAY_BACKUP_MAX_AGE_SECS=7200
