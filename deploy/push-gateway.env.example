# Copy to /etc/push-gateway/push-gateway.env, replace every placeholder, and
# keep the installed file root:push-gateway mode 0640. This file names
# credential files; it holds no credential itself. Each credential file is
# owned by push-gateway with mode 0400, or the gateway refuses to start.
# Never commit real values. See docs/deployment/push-gateway.md.

# --- Listeners ---------------------------------------------------------------

# The relay posts deliveries here over plain HTTP. Keep it on loopback.
PUSH_GATEWAY_DELIVERY_ADDR=127.0.0.1:8090
# Devices register here through the TLS proxy. Proxy only the installation
# and delegation routes.
PUSH_GATEWAY_REGISTRATION_ADDR=127.0.0.1:8091

# --- State -------------------------------------------------------------------

PUSH_GATEWAY_STATE_DIR=/var/lib/push-gateway
# 64 hexadecimal characters. Generate with: openssl rand -hex 32
PUSH_GATEWAY_STATE_KEY_FILE=/etc/push-gateway/state.key

# --- Relays ------------------------------------------------------------------

# The public key of each relay's NOSTR_RELAY_SECRET_KEY, comma-separated.
PUSH_GATEWAY_RELAY_PUBKEYS=<RELAY_SIGNING_PUBKEY_HEX>

# --- APNs --------------------------------------------------------------------

# Equal to the relay's NOSTR_RELAY_PUSH_APP_PROFILE.
PUSH_GATEWAY_APNS_APP_PROFILE=<APP_PROFILE_ID>
# The .p8 key from Certificates, Identifiers & Profiles > Keys, with the
# Apple Push Notifications service enabled.
PUSH_GATEWAY_APNS_KEY_FILE=/etc/push-gateway/apns-auth-key.p8
PUSH_GATEWAY_APNS_KEY_ID=<APNS_KEY_ID>
PUSH_GATEWAY_APNS_TEAM_ID=<APPLE_TEAM_ID>
PUSH_GATEWAY_APNS_TOPIC=<APP_BUNDLE_ID>
# production for TestFlight and App Store builds; development otherwise.
PUSH_GATEWAY_APNS_ENVIRONMENT=production

# --- FCM (optional) ----------------------------------------------------------

# Uncomment to serve Android devices. The profile must differ from APNs.
# PUSH_GATEWAY_FCM_APP_PROFILE=<ANDROID_APP_PROFILE_ID>
# PUSH_GATEWAY_FCM_SERVICE_ACCOUNT_FILE=/etc/push-gateway/fcm-service-account.json
# PUSH_GATEWAY_FCM_PROJECT_ID=<FIREBASE_PROJECT_ID>

# --- Bounds (optional) -------------------------------------------------------

# PUSH_GATEWAY_MAX_INSTALLATION_SECONDS=7776000
# PUSH_GATEWAY_MAX_GRANT_SECONDS=2678400
# PUSH_GATEWAY_WAKES_PER_HOUR=120
