#!/usr/bin/env bash
# The solver container's entrypoint (#11560, docs/cloud/solver-on-gcp.md).
#
# Reads the run's settings and credentials from /run/oa-solver/env (written
# by the dispatcher through the box's files API, mode 600) and deletes the
# file first, clones the repository (blobless, full history), and runs
#   coder-new solver $OA_ISSUE --engine coder --plain --json
# with every hand on $OA_SOLVER_MODEL. The solver's NDJSON goes to stdout as
# it arrives; this script's own steps are `{"type":"solver_box_step",...}`
# lines, and the last line is `{"type":"solver_box_summary",...}` with the
# run's summary.json and change.patch (cut at 200 KB). Exit 0 when a pull
# request opened, 1 when the run ended without one, 2 when it never started.
set -uo pipefail

ENV_FILE="${OA_SOLVER_ENV:-/run/oa-solver/env}"
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
  rm -f "$ENV_FILE"
fi

export CODER_VERTEX_TOKEN_FILE="${CODER_VERTEX_TOKEN_FILE:-/run/oa-solver/vertex-token}"
export CODER_VERTEX_PROJECT="${CODER_VERTEX_PROJECT:-openagentsgemini}"
export CODER_VERTEX_LOCATION="${CODER_VERTEX_LOCATION:-global}"
MODEL="${OA_SOLVER_MODEL:-google/gemini-4-argon}"
WORK="${OA_SOLVER_WORK:-/work}"
REPO_DIR="$WORK/repo"
STATE="$WORK/state"
PATCH_MAX=200000
STARTED=$(date +%s)

# One JSON line about this script's own steps.
step() {
  python3 -c 'import json,sys,time; print(json.dumps({"type":"solver_box_step","step":sys.argv[1],"state":sys.argv[2],"text":sys.argv[3],"secs":round(time.time()-int(sys.argv[4]),1)}), flush=True)' \
    "$1" "$2" "${3:-}" "$STARTED"
}

# The last line when the run never got to the solver.
give_up() {
  python3 -c 'import json,sys; print(json.dumps({"type":"solver_box_summary","ok":False,"started":False,"error":sys.argv[1]}), flush=True)' "$1"
  exit 2
}

[[ "${OA_REPO:-}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || give_up "The repository is not named as OWNER/NAME."
[[ "${OA_ISSUE:-}" =~ ^[0-9]+$ ]] || give_up "The issue is not a number."
[ -n "${GH_TOKEN:-}" ] || give_up "There is no GitHub token for $OA_REPO."
[[ "$MODEL" =~ ^[A-Za-z0-9_./:-]+$ ]] || give_up "The model name is not valid."

git config --global user.name "${OA_GIT_NAME:-OpenAgents Solver}"
git config --global user.email "${OA_GIT_EMAIL:-solver@openagents.com}"
git config --global init.defaultBranch main
unset OA_GIT_NAME OA_GIT_EMAIL
gh auth setup-git >/dev/null 2>&1 || give_up "GitHub sign-in on the box failed."

step clone start "Cloning $OA_REPO"
mkdir -p "$WORK" "$STATE"
if ! git clone -q --filter=blob:none "https://github.com/$OA_REPO.git" "$REPO_DIR" 2>"$WORK/clone.err"; then
  why=$(tail -n 3 "$WORK/clone.err" | tr '\n' ' ')
  give_up "Could not clone $OA_REPO: ${why:-no answer from GitHub}. Connect GitHub with access to $OA_REPO."
fi
step clone done "Cloned $OA_REPO at $(git -C "$REPO_DIR" rev-parse --short HEAD)"
if ! gh issue view "$OA_ISSUE" -R "$OA_REPO" --json number,stateReason >/dev/null 2>"$WORK/issue.err"; then
  why=$(tail -n 1 "$WORK/issue.err")
  give_up "Could not read issue #$OA_ISSUE in $OA_REPO: ${why:-no answer from GitHub}. Connect GitHub with access to $OA_REPO."
fi

step solver start "Solver on issue #$OA_ISSUE with $MODEL"
coder-new solver "$OA_ISSUE" \
  --repo "$REPO_DIR" --github "$OA_REPO" \
  --engine coder \
  --coder-model "$MODEL" --briefer-model "$MODEL" --tester-model "$MODEL" \
  --state "$STATE" \
  --plain --json
code=$?
step solver done "The solver exited $code"

# The run's folder: the newest one under the state root.
folder=$(ls -1dt "$STATE"/*/ 2>/dev/null | head -n 1)
python3 - "$folder" "$PATCH_MAX" "$code" "$STARTED" <<'PY'
import json, os, subprocess, sys, time
folder, cap, code, started = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
line = {"type": "solver_box_summary", "started": True, "solver_exit": code,
        "secs": round(time.time() - started, 1)}
summary = {}
if folder and os.path.isfile(os.path.join(folder, "summary.json")):
    try:
        with open(os.path.join(folder, "summary.json")) as f:
            summary = json.load(f)
    except (OSError, ValueError) as e:
        line["error"] = f"summary.json could not be read: {e}"
else:
    line["error"] = "The solver wrote no summary."
solver = summary.get("solver") or {}
solver.pop("judgments", None)
pr = solver.get("pull_request")
line["ok"] = bool(pr)
line["pr"] = pr
line["outcome"] = summary.get("outcome")
line["cost_usd"] = (summary.get("cost") or {}).get("total_usd")
line["checks"] = summary.get("checks") or []
line["required_checks"] = summary.get("required_checks") or []
line["files"] = summary.get("changed") or []
line["added"] = summary.get("added") or 0
line["removed"] = summary.get("removed") or 0
line["reply"] = summary.get("reply")
line.setdefault("error", summary.get("error"))
line["summary"] = summary
worktree = summary.get("worktree")
if pr and worktree and os.path.isdir(worktree):
    try:
        line["commit"] = subprocess.run(["git", "-C", worktree, "rev-parse", "HEAD"],
                                        capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        pass
patch_path = os.path.join(folder, "change.patch") if folder else ""
if patch_path and os.path.isfile(patch_path):
    with open(patch_path, "rb") as f:
        data = f.read(cap + 1)
    line["patch_truncated"] = len(data) > cap
    line["patch"] = data[:cap].decode("utf-8", "replace")
print(json.dumps(line), flush=True)
sys.exit(0 if pr else 1)
PY
