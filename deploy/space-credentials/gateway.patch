+/// Private deployment extension: current native authority for the host broker.
+/// The normal native tenant and sandbox-owner middleware applies to this read.
+pub async fn credential_context(
+    State(state): State<AppState>,
+    Extension(AuthOrg(org)): Extension<AuthOrg>,
+    Path(sandbox_id): Path<String>,
+) -> Result<Json<serde_json::Value>, PublicApiError> {
+    let sandbox_id = parse_public_sandbox_id(&sandbox_id)?;
+    ensure_sandbox_owner(&state.pool, org.id, sandbox_id).await?;
+    let candidate =
+        pplx_space_credential_injection_store::resolution::load_network_policy_candidate(
+            &state.pool,
+            sandbox_id.into(),
+        )
+        .await
+        .map_err(|_| PublicApiError::internal())?
+        .ok_or_else(|| PublicApiError::not_found("sandbox execution unavailable"))?;
+    if candidate.state.organization_id != org.id.as_uuid() {
+        return Err(PublicApiError::not_found("sandbox execution unavailable"));
+    }
+    Ok(Json(serde_json::json!({
+        "native_resource":pplx_space_common_core::types::SandboxId::from(sandbox_id).to_string(),
+        "node":candidate.state.node_id.to_string(),
+        "execution_generation":candidate.state.execution_generation.get(),
+        "native_policy_ref":candidate.effective_network_policy_ref,
+        "policy":candidate.policy,
+    })))
+}
+
