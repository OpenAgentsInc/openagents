+
+/// Install host-only node authority for the isolated gateway identity. Neither
+/// the guest UID nor caller-controlled launch environment can read the key.
+pub(super) fn credential_broker_environment(
+    sandbox_id: &str,
+    uid: u32,
+    isolated: bool,
+) -> Result<std::collections::HashMap<String, String>, Status> {
+    use std::{
+        io::{Read, Write},
+        os::unix::fs::{MetadataExt, OpenOptionsExt},
+    };
+    let mut env = std::collections::HashMap::new();
+    let origin = match std::env::var("OA_SPACE_CREDENTIAL_BROKER") {
+        Ok(value) => value,
+        Err(std::env::VarError::NotPresent) => return Ok(env),
+        Err(_) => {
+            return Err(Status::failed_precondition(
+                "invalid credential broker configuration",
+            ));
+        }
+    };
+    if !isolated {
+        return Err(Status::failed_precondition(
+            "credential injection requires an isolated gateway identity",
+        ));
+    }
+    let node = std::env::var("OA_SPACE_CREDENTIAL_NODE_ID")
+        .map_err(|_| Status::failed_precondition("credential node identity is missing"))?;
+    let source = std::env::var_os("OA_SPACE_CREDENTIAL_NODE_TOKEN_FILE")
+        .ok_or_else(|| Status::failed_precondition("credential node file is missing"))?;
+    let file = std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW)
+        .open(source)
+        .map_err(|_| Status::unavailable("credential node file is unavailable"))?;
+    let metadata = file
+        .metadata()
+        .map_err(|_| Status::unavailable("credential node file is unavailable"))?;
+    if !metadata.is_file()
+        || metadata.uid() != 0
+        || metadata.mode() & 0o077 != 0
+        || metadata.len() > 8192
+    {
+        return Err(Status::failed_precondition(
+            "credential node file must be private",
+        ));
+    }
+    let mut bytes = zeroize::Zeroizing::new(Vec::new());
+    file.take(8193)
+        .read_to_end(&mut bytes)
+        .map_err(|_| Status::unavailable("credential node file is unavailable"))?;
+    if !(32..=8192).contains(&bytes.len()) {
+        return Err(Status::failed_precondition(
+            "credential node file has invalid size",
+        ));
+    }
+    let directory = PathBuf::from(paths::isolated_net_gateway_run_dir(sandbox_id));
+    let target = directory.join("credential-node-token");
+    let staging = directory.join(format!("credential-node-token.{}", uuid::Uuid::now_v7()));
+    let result = (|| {
+        let mut output = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(&staging)?;
+        output.write_all(&bytes)?;
+        output.sync_all()?;
+        nix::unistd::fchown(
+            &output,
+            Some(nix::unistd::Uid::from_raw(uid)),
+            Some(nix::unistd::Gid::from_raw(uid)),
+        )?;
+        std::fs::rename(&staging, &target)?;
+        Ok::<(), std::io::Error>(())
+    })();
+    if result.is_err() {
+        let _ = std::fs::remove_file(&staging);
+        return Err(Status::unavailable(
+            "credential node file couldn't be installed",
+        ));
+    }
+    env.insert("OA_SPACE_CREDENTIAL_BROKER".into(), origin);
+    env.insert("OA_SPACE_CREDENTIAL_NODE_ID".into(), node);
+    env.insert(
+        "OA_SPACE_CREDENTIAL_NODE_TOKEN_FILE".into(),
+        target.display().to_string(),
+    );
+    Ok(env)
+}
