@@ -0,0 +1,184 @@
+//! Exercise the maintained adapter across real verified HTTPS and HTTP/2.
+use super::*;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+#[tokio::test]
+async fn broker_markers_are_replaced_per_request_and_revocation_closes_the_lease() {
+    use computer_credentials::{Secret, gateway};
+    use http_body_util::{BodyExt as _, Full};
+
+    let revoked = Arc::new(AtomicBool::new(false));
+    let reads = Arc::new(AtomicUsize::new(0));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let rcgen::CertifiedKey { cert, signing_key } =
+        rcgen::generate_simple_self_signed(vec!["127.0.0.1".into()]).unwrap();
+    let pem = cert.pem();
+    let config = rustls::ServerConfig::builder_with_provider(Arc::new(
+        rustls::crypto::aws_lc_rs::default_provider(),
+    ))
+    .with_safe_default_protocol_versions()
+    .unwrap()
+    .with_no_client_auth()
+    .with_single_cert(
+        vec![cert.der().clone()],
+        rustls::pki_types::PrivatePkcs8KeyDer::from(signing_key.serialize_der()).into(),
+    )
+    .unwrap();
+    let acceptor = tokio_rustls::TlsAcceptor::from(Arc::new(config));
+    let broker_revoked = revoked.clone();
+    let broker_reads = reads.clone();
+    let broker = tokio::spawn(async move {
+        loop {
+            let (io, _) = listener.accept().await.unwrap();
+            let acceptor = acceptor.clone();
+            let revoked = broker_revoked.clone();
+            let reads = broker_reads.clone();
+            tokio::spawn(async move {
+                let Ok(io) = acceptor.accept(io).await else {
+                    return;
+                };
+                let service = service_fn(move |request: Request<Incoming>| {
+                    let revoked = revoked.clone();
+                    let reads = reads.clone();
+                    async move {
+                        let path = request.uri().path().to_owned();
+                        let authenticated =
+                            request.headers().get("authorization").is_some_and(|v| {
+                                v == "Bearer fixture-node-token-which-is-never-in-the-guest"
+                            });
+                        let body = request.into_body().collect().await.unwrap().to_bytes();
+                        let body: serde_json::Value = serde_json::from_slice(&body).unwrap();
+                        let scope = "b".repeat(64);
+                        let admitted = authenticated
+                            && !revoked.load(Ordering::SeqCst)
+                            && body["context"]["node"] == "fixture-node"
+                            && (body["scope"].is_null() || body["scope"] == scope);
+                        let (status, reply) = if !admitted {
+                            (403, serde_json::json!({"error":"denied"}))
+                        } else if path == "/v1/check" {
+                            (200, serde_json::json!({"scope":scope}))
+                        } else if path == "/v1/resolve"
+                            && body["host"] == "allowed.test"
+                            && body["port"] == 443
+                            && body["path"] == "/v1/messages"
+                            && body["method"] == "POST"
+                            && body["selectors"]["x-api-key"]
+                                == "00000000-0000-4000-8000-000000000013"
+                        {
+                            reads.fetch_add(1, Ordering::SeqCst);
+                            (
+                                200,
+                                serde_json::json!([{"name":"x-api-key","value":"synthetic-native-proxy-canary"}]),
+                            )
+                        } else {
+                            (403, serde_json::json!({"error":"denied"}))
+                        };
+                        Ok::<_, Infallible>(
+                            Response::builder()
+                                .status(status)
+                                .body(Full::new(Bytes::from(serde_json::to_vec(&reply).unwrap())))
+                                .unwrap(),
+                        )
+                    }
+                });
+                let _ = hyper::server::conn::http1::Builder::new()
+                    .serve_connection(TokioIo::new(io), service)
+                    .await;
+            });
+        }
+    });
+    let client = gateway::Client::new(
+        &format!("https://{address}"),
+        Secret::new(b"fixture-node-token-which-is-never-in-the-guest".to_vec()).unwrap(),
+        gateway::Context {
+            native_resource: "fixture-native".into(),
+            node: "fixture-node".into(),
+            execution_generation: 0,
+            native_policy_ref: "pending".into(),
+        },
+    )
+    .unwrap()
+    .with_root_certificate(pem.as_bytes())
+    .unwrap();
+    let state = crate::state::GatewayNetworkState::pending_policy()
+        .with_credential_broker(Arc::new(client));
+    let profile = computer_credentials::policy::Profile::new(
+        "fixture-v1",
+        [computer_credentials::policy::Host::parse("allowed.test").unwrap()].into(),
+    );
+    let policy: pplx_space_net_common::NetworkPolicyV1 =
+        serde_json::from_value(profile.space_policy().unwrap()).unwrap();
+    let (_, _, provider) = crate::certificates::local_provider_with_policy(
+        state.clone(),
+        policy.clone(),
+        Default::default(),
+    )
+    .await;
+    state.dns_allow_cache().observe_response(
+        &crate::dns::test_fixtures::a_response("allowed.test", [93, 184, 216, 34], 60),
+        &policy,
+    );
+    let lease = provider
+        .get("allowed.test".parse().unwrap(), 443)
+        .await
+        .unwrap();
+    let lease = Arc::new(lease.for_connection());
+    let binding = HostBinding::new("test", "93.184.216.34:443".parse().unwrap(), state);
+    let (origin, peer) = tokio::io::duplex(4096);
+    let (observed, mut received) = tokio::sync::mpsc::channel(2);
+    let origin_task = tokio::spawn(
+        hyper::server::conn::http2::Builder::new(TokioExecutor::new()).serve_connection(
+            TokioIo::new(peer),
+            service_fn(move |request: Request<Incoming>| {
+                let observed = observed.clone();
+                async move {
+                    observed
+                        .send(request.headers().get("x-api-key").unwrap().to_owned())
+                        .await
+                        .unwrap();
+                    Ok::<_, Infallible>(Response::new(Full::new(Bytes::from_static(
+                        b"data: fixture\n\n",
+                    ))))
+                }
+            }),
+        ),
+    );
+    let (guest, peer) = tokio::io::duplex(4096);
+    let serving_lease = lease.clone();
+    let gateway_task = tokio::spawn(serve(guest, binding, serving_lease, move |_| async move {
+        Ok((origin, HttpProtocol::Http2))
+    }));
+    let (mut sender, connection) = http2::handshake(TokioExecutor::new(), TokioIo::new(peer))
+        .await
+        .unwrap();
+    let connection = tokio::spawn(connection);
+    let request = |path| {
+        Request::post(format!("https://allowed.test{path}"))
+            .header("x-api-key", "oa-ref:00000000-0000-4000-8000-000000000013")
+            .body(Empty::<Bytes>::new())
+            .unwrap()
+    };
+    let response = sender.send_request(request("/v1/messages")).await.unwrap();
+    assert_eq!(response.status(), StatusCode::OK);
+    assert_eq!(
+        response.into_body().collect().await.unwrap().to_bytes(),
+        b"data: fixture\n\n"[..]
+    );
+    let header = received.recv().await.unwrap();
+    assert_eq!(header, "synthetic-native-proxy-canary");
+    assert_eq!(reads.load(Ordering::SeqCst), 1);
+    let response = sender.send_request(request("/wrong-path")).await.unwrap();
+    assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
+    assert!(received.try_recv().is_err());
+    assert_eq!(reads.load(Ordering::SeqCst), 1);
+    revoked.store(true, Ordering::SeqCst);
+    tokio::time::timeout(Duration::from_secs(7), lease.invalidated())
+        .await
+        .unwrap();
+    assert_eq!(reads.load(Ordering::SeqCst), 1);
+    connection.abort();
+    gateway_task.abort();
+    origin_task.abort();
+    broker.abort();
+}
