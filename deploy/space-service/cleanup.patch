+#[tokio::test]
+async fn unfinished_listing_hits_page_budget_without_reporting_completion() {
+    let uri = fixture_uri();
+    let client = FakeS3Client::new();
+    for page in 0..=MAX_DELETE_PAGES {
+        client.enqueue_list_page(ListObjectsResponse {
+            keys: vec![format!("{}/object-{page}", uri.key_prefix)],
+            next_continuation_token: Some(format!("page-{page}")),
+        });
+    }
+    let backend = S3StorageBackend::new(client.clone());
+    assert!(backend.delete_prefix(&uri).await.is_err());
+    assert_eq!(client.list_calls().len(), MAX_DELETE_PAGES);
+    assert_eq!(client.delete_calls().len(), MAX_DELETE_PAGES);
+}
