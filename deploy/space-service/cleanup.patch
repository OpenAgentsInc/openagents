+#[test]
+fn configured_storage_sweep_bounds_can_reduce_but_not_expand_defaults() {
+    let mut env = pplx_space_test_env::TestEnv::default();
+    env.set("SPACE_SNAPSHOT_STORAGE_SWEEPER_MAX_PER_TICK", "8");
+    env.set("SPACE_SNAPSHOT_STORAGE_SWEEPER_CONCURRENCY", "2");
+    let config = ReconcilerConfig::from_environment(&env);
+    assert_eq!(config.max_per_tick, 8);
+    assert_eq!(config.concurrency, 2);
+    assert_eq!(config.min_age, Some(DEFAULT_MIN_AGE));
+    for value in ["0", "invalid", "999999999999999999999999999"] {
+        env.set("SPACE_SNAPSHOT_STORAGE_SWEEPER_MAX_PER_TICK", value);
+        env.set("SPACE_SNAPSHOT_STORAGE_SWEEPER_CONCURRENCY", value);
+        let config = ReconcilerConfig::from_environment(&env);
+        assert_eq!(config.max_per_tick, DEFAULT_MAX_PER_TICK);
+        assert_eq!(config.concurrency, DEFAULT_CONCURRENCY);
+        assert_eq!(config.min_age, Some(DEFAULT_MIN_AGE));
+    }
+}
