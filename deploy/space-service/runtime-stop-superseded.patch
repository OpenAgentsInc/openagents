index cdec1cd..7a85dab 100644
--- a/crates/libs/node/runtime/supervisor/src/service/execution.rs
+++ b/crates/libs/node/runtime/supervisor/src/service/execution.rs
@@ -79,6 +79,14 @@ impl RuntimeSupervisorService {
                     require_quiescence(sandbox)?;
                     Ok(requested)
                 }
+                // A stop of a superseded execution has nothing to stop once
+                // the sandbox is quiescent. A node reset can leave the sandbox
+                // manager's identity behind this store's; its cleanup must
+                // still finish instead of retrying forever (#12151).
+                Some(_) if allow_absent => {
+                    require_quiescence(sandbox)?;
+                    Ok(requested)
+                }
                 _ => Err(Status::failed_precondition(
                     "runtime execution identity is missing or superseded",
                 )),
@@ -107,7 +115,18 @@ impl RuntimeSupervisorService {
             if current == Some(execution) {
                 return Ok(());
             }
-            if current.is_some() && current != previous {
+            // A binding that moved past the caller's previous identity fences a
+            // stale caller while a runtime may still use it. Once the sandbox is
+            // quiescent nothing uses it, and a node reset can leave the node
+            // manager's identity behind this store's, so its cleanup rebinds
+            // instead of failing forever (#12151). A newer activation that has
+            // not launched yet fails its launch check and retries.
+            if current.is_some()
+                && current != previous
+                && !cgroup::sandbox_is_quiescent(&sandbox.to_string()).map_err(|error| {
+                    Status::unavailable(format!("runtime occupancy unavailable: {error}"))
+                })?
+            {
                 return Err(Status::failed_precondition(
                     "runtime execution binding was superseded",
                 ));
