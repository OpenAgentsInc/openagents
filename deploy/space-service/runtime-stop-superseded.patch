@@ -172,6 +172,17 @@ async fn execution_checks_survive_supervisor_restart_and_reject_superseded_work(
             accepted
         );
     }
+    // A stop (allow_absent) of a superseded execution proceeds only when the
+    // sandbox is quiescent; this test sandbox has no cgroup, so it is (#12151).
+    assert!(service.check_execution(sandbox, &old, None, true).await.is_ok());
+    assert_eq!(
+        service
+            .check_execution(sandbox, "", None, true)
+            .await
+            .unwrap_err()
+            .code(),
+        tonic::Code::FailedPrecondition
+    );
 }
 
