diff --git a/crates/libs/node/runtime/supervisor/src/service/execution.rs b/crates/libs/node/runtime/supervisor/src/service/execution.rs
index cdec1cd..70d96dc 100644
--- a/crates/libs/node/runtime/supervisor/src/service/execution.rs
+++ b/crates/libs/node/runtime/supervisor/src/service/execution.rs
@@ -79,6 +79,14 @@ impl RuntimeSupervisorService {
                     require_quiescence(sandbox)?;
                     Ok(requested)
                 }
+                // A stop of a superseded execution has nothing to stop once
+                // the sandbox is quiescent. A node reset can leave the sandbox
+                // manager's identity behind this store's; its cleanup must
+                // still finish instead of retrying forever (#12151).
+                Some(_) if allow_absent => {
+                    require_quiescence(sandbox)?;
+                    Ok(requested)
+                }
                 _ => Err(Status::failed_precondition(
                     "runtime execution identity is missing or superseded",
                 )),
diff --git a/crates/libs/node/runtime/supervisor/src/service/tests.rs b/crates/libs/node/runtime/supervisor/src/service/tests.rs
index 97d81ff..66d7c4b 100644
