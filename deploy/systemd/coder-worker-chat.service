[Unit]
Description=OpenAgents chat worker (the app's basic Coder)
Documentation=https://github.com/OpenAgentsInc/openagents/tree/main/deploy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=coder-worker
Group=coder-worker
EnvironmentFile=/etc/coder-worker/coder-worker-chat.env
Environment=HOME=/var/lib/coder-worker-chat
ExecStartPre=/usr/bin/test -x /opt/coder-worker/current/coder-worker
ExecStart=/opt/coder-worker/current/coder-worker
Restart=on-failure
RestartSec=2
# The backstop behind the worker's own relay liveness probes (#9946): every
# answered probe (one each 30 seconds) sends WATCHDOG=1, and a worker that
# has not proven its relay subscription for two minutes is restarted.
WatchdogSec=120
NotifyAccess=main
TimeoutStopSec=15
KillSignal=SIGTERM
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coder-worker-chat

# The worker listens on nothing. It opens two outbound connections, one to
# the relay and one to the door, so it may not bind a port at all.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any

# The state directory holds the quota file (CODER_WORKER_QUOTA_FILE), the
# day's admitted jobs per caller key, so a restart does not reset the day.
StateDirectory=coder-worker-chat
StateDirectoryMode=0750
ReadWritePaths=/var/lib/coder-worker-chat
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
DevicePolicy=closed
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
RemoveIPC=true
UMask=0027

[Install]
WantedBy=multi-user.target
