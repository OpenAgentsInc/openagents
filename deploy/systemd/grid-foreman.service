[Unit]
Description=Grid Foreman (the giant Foreman on the Grid, #12445)
Documentation=https://github.com/OpenAgentsInc/openagents/blob/main/docs/deployment/grid-foreman.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
User=grid-foreman
Group=grid-foreman
# The key comes from Secret Manager at each start, as root, into the state
# directory, readable only by the service user.
ExecStartPre=+/opt/grid-foreman/fetch-key.sh /var/lib/grid-foreman/key
ExecStart=/opt/grid-foreman/current/grid-foreman serve --state /var/lib/grid-foreman
Restart=always
RestartSec=5
# The host tells systemd it's alive every 20 seconds while its relay session
# is online and frames go out; two silent minutes restart it.
WatchdogSec=120
NotifyAccess=main
TimeoutStartSec=120
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grid-foreman

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
StateDirectory=grid-foreman
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
