{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethyrforge.invalid/contracts/channel.schema.json",
  "title": "Signed-channel body",
  "type": "object",
  "properties": {
    "schema": {
      "const": "aethyrforge.channel.v1"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "channel": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previousRefDigest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "releaseId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "issuedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "trustVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema",
    "projectId",
    "channel",
    "sequence",
    "previousRefDigest",
    "releaseId",
    "keyId",
    "issuedAt",
    "expiresAt",
    "trustVersion"
  ],
  "additionalProperties": false
}
