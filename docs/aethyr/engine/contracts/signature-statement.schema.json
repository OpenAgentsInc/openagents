{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethyrforge.invalid/contracts/signature-statement.schema.json",
  "title": "Exact Ed25519 signed identity statement",
  "type": "object",
  "properties": {
    "schema": {
      "const": "aethyrforge.signature.v1"
    },
    "purpose": {
      "enum": [
        "release",
        "channel"
      ]
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "subjectDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "schema",
    "purpose",
    "projectId",
    "subjectDigest",
    "keyId"
  ],
  "additionalProperties": false
}
