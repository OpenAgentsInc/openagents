+/// Whether the ignored entry `entry` (a path relative to `top`, ending in
+/// `/` when Git reports a whole directory) is disposable: a real directory
+/// named like a build or package cache, a regular `.DS_Store` file, or a
+/// real directory holding only those. Anything else, a symbolic link
+/// included, may be someone's data.
+fn disposable(top: &Path, entry: &[u8]) -> bool {
+    use std::os::unix::ffi::OsStrExt;
+    let name = entry.strip_suffix(b"/").unwrap_or(entry);
+    disposable_path(&top.join(std::ffi::OsStr::from_bytes(name)))
+}
+
+fn disposable_path(path: &Path) -> bool {
+    use std::os::unix::ffi::OsStrExt;
+    let Ok(meta) = std::fs::symlink_metadata(path) else {
+        return false;
+    };
+    let Some(base) = path.file_name().map(OsStrExt::as_bytes) else {
+        return false;
+    };
+    if meta.is_file() {
+        return base == b".DS_Store";
+    }
+    if !meta.is_dir() || base == b".DS_Store" {
+        return false;
+    }
+    if base == b"target" || base == b"node_modules" || base.starts_with(b".cargo-target") {
+        return true;
+    }
+    // An ignored directory of another name is disposable only when all it
+    // holds is, so a cache nested in it stays eligible.
+    let Ok(entries) = std::fs::read_dir(path) else {
+        return false;
+    };
+    entries
+        .map(|entry| entry.map(|entry| entry.path()))
+        .all(|entry| entry.is_ok_and(|path| disposable_path(&path)))
+}
+
+/// Check that the worktree at `top` holds no ignored file other than
+/// disposable caches, since `git worktree remove` deletes ignored files
+/// and undo cannot bring them back.
+fn ignored_data(top: &Path) -> Result<(), String> {
+    let output = Command::new("git")
+        .arg("-C")
+        .arg(top)
+        .args([
+            "ls-files",
+            "-z",
+            "--others",
+            "--ignored",
+            "--exclude-standard",
+            "--directory",
+        ])
+        .env("GIT_TERMINAL_PROMPT", "0")
+        .env("GIT_OPTIONAL_LOCKS", "0")
+        .stdin(std::process::Stdio::null())
+        .output()
+        .map_err(|error| format!("git: {error}"))?;
+    if !output.status.success() {
+        return Err(format!(
+            "git ls-files: {}",
+            String::from_utf8_lossy(&output.stderr).trim()
+        ));
+    }
+    let kept = output
+        .stdout
+        .split(|&byte| byte == 0)
+        .filter(|entry| !entry.is_empty())
+        .any(|entry| !disposable(top, entry));
+    if kept {
+        Err("ignored files that are not a cache".into())
+    } else {
+        Ok(())
+    }
+}
