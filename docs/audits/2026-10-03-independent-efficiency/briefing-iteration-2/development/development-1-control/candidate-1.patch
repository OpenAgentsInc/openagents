 #[test]
+fn ignored_data_keeps_a_worktree_and_ignored_caches_do_not() {
+    let home = Home::new();
+    let names = ["caches", "private", "spaced", "link", "filename", "dsdir"];
+    let (repo, trees) = repo(&home, &names);
+    std::fs::create_dir_all(repo.join(".git/info")).unwrap();
+    std::fs::write(
+        repo.join(".git/info/exclude"),
+        "private/\ntarget\nnode_modules\n.cargo-target*\n.DS_Store\nnested/\nmy *\n",
+    )
+    .unwrap();
+    let [caches, private, spaced, link, filename, dsdir] = [
+        &trees[0], &trees[1], &trees[2], &trees[3], &trees[4], &trees[5],
+    ];
+    for dir in [
+        "target/debug",
+        "node_modules/pkg",
+        ".cargo-target-agent1",
+        "crates/app/target",
+        "nested/deep/target",
+    ] {
+        std::fs::create_dir_all(caches.join(dir)).unwrap();
+        std::fs::write(caches.join(dir).join("out"), "built").unwrap();
+    }
+    std::fs::write(caches.join(".DS_Store"), "finder").unwrap();
+    std::fs::create_dir_all(private.join("private")).unwrap();
+    std::fs::write(private.join("private/data"), "secret").unwrap();
+    std::fs::write(spaced.join("my data\nfile"), "line one\nline two").unwrap();
+    std::os::unix::fs::symlink(repo.join("file"), link.join("target")).unwrap();
+    std::fs::write(filename.join("target"), "not a cache").unwrap();
+    std::fs::create_dir_all(dsdir.join(".DS_Store")).unwrap();
+    std::fs::write(dsdir.join(".DS_Store/notes"), "mine").unwrap();
+    let facts = home.facts();
+    let volumes = low();
+    let env = env(&home, &facts, &volumes, &Idle);
+    let report = run::run(&env, &disk(), Cause::Manual, false, true).unwrap();
+    assert!(!caches.exists());
+    for kept in [private, spaced, link, filename, dsdir] {
+        assert!(kept.exists(), "{}", kept.display());
+    }
+    let kept = report
+        .plan
+        .kept
+        .iter()
+        .filter(|kept| kept.why == "ignored files that are not a cache")
+        .count();
+    assert_eq!(kept, 5, "{:?}", report.plan.kept);
+    assert_eq!(
+        std::fs::read_to_string(private.join("private/data")).unwrap(),
+        "secret"
+    );
+    assert_eq!(
+        std::fs::read_to_string(spaced.join("my data\nfile")).unwrap(),
+        "line one\nline two"
+    );
+    assert!(link.join("target").is_symlink());
+    assert_eq!(
+        std::fs::read_to_string(dsdir.join(".DS_Store/notes")).unwrap(),
+        "mine"
+    );
+}
