 #[test]
+fn ignored_user_files_keep_a_worktree_and_ignored_caches_do_not() {
+    let home = Home::new();
+    let names = ["caches", "private", "named", "linked", "dsdir", "spaced"];
+    let (repo, trees) = repo(&home, &names);
+    std::fs::write(
+        repo.join(".git/info/exclude"),
+        "private/\ntarget\nnode_modules\n.cargo-target*\n.DS_Store\n*.secret\n",
+    )
+    .unwrap();
+    let [caches, private, named, linked, dsdir, spaced] = [
+        &trees[0], &trees[1], &trees[2], &trees[3], &trees[4], &trees[5],
+    ];
+
+    // Only recognized caches, including nested ones, and a `.DS_Store` file.
+    std::fs::create_dir_all(caches.join("target/debug")).unwrap();
+    std::fs::write(caches.join("target/debug/out"), "built").unwrap();
+    std::fs::create_dir_all(caches.join("web app/node_modules/pkg")).unwrap();
+    std::fs::write(caches.join("web app/node_modules/pkg/index"), "js").unwrap();
+    std::fs::create_dir_all(caches.join(".cargo-target-agent1")).unwrap();
+    std::fs::write(caches.join(".cargo-target-agent1/x"), "x").unwrap();
+    std::fs::write(caches.join(".DS_Store"), "finder").unwrap();
+
+    // Ignored user data.
+    std::fs::create_dir_all(private.join("private")).unwrap();
+    std::fs::write(private.join("private/data"), "secret rows").unwrap();
+    // A regular file with a cache name is not a cache.
+    std::fs::write(named.join("target"), "not a build").unwrap();
+    // A symbolic link with a cache name is not a cache.
+    let elsewhere = home.layout.home.join("modules");
+    std::fs::create_dir_all(&elsewhere).unwrap();
+    std::os::unix::fs::symlink(&elsewhere, linked.join("node_modules")).unwrap();
+    // A `.DS_Store` directory is not the metadata file.
+    std::fs::create_dir_all(dsdir.join(".DS_Store")).unwrap();
+    std::fs::write(dsdir.join(".DS_Store/kept"), "mine").unwrap();
+    // Names and contents with spaces and newlines survive exactly.
+    let odd = spaced.join("my notes\nfinal draft.secret");
+    std::fs::write(&odd, "line one\nline two \n").unwrap();
+
+    let facts = home.facts();
+    let volumes = low();
+    let env = env(&home, &facts, &volumes, &Idle);
+    let report = run::run(&env, &disk(), Cause::Manual, false, true).unwrap();
+
+    assert!(!caches.exists());
+    for kept in [private, named, linked, dsdir, spaced] {
+        assert!(kept.exists(), "{}", kept.display());
+    }
+    let refused = report
+        .plan
+        .kept
+        .iter()
+        .filter(|kept| kept.why == "ignored files that are not a disposable cache")
+        .count();
+    assert_eq!(refused, 5, "{:?}", report.plan.kept);
+    assert_eq!(
+        std::fs::read_to_string(private.join("private/data")).unwrap(),
+        "secret rows"
+    );
+    assert_eq!(
+        std::fs::read_to_string(named.join("target")).unwrap(),
+        "not a build"
+    );
+    assert!(
+        std::fs::symlink_metadata(linked.join("node_modules"))
+            .unwrap()
+            .file_type()
+            .is_symlink()
+    );
+    assert!(elsewhere.exists());
+    assert_eq!(
+        std::fs::read_to_string(dsdir.join(".DS_Store/kept")).unwrap(),
+        "mine"
+    );
+    assert_eq!(
+        std::fs::read_to_string(&odd).unwrap(),
+        "line one\nline two \n"
+    );
+}
