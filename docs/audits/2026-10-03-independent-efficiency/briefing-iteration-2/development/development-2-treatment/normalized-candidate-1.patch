+/// Whether a directory of this name is a build cache that rebuilds.
+fn cache_dir_name(name: &[u8]) -> bool {
+    name == b"target" || name == b"node_modules" || name.starts_with(b".cargo-target")
+}
+
+/// Whether every file Git ignores in the worktree `top` is disposable: it
+/// is inside, or is, a real directory with a cache name (`target`,
+/// `node_modules`, `.cargo-target*`), or it is a regular `.DS_Store` file.
+/// A symbolic link, a regular file with a cache name, or anything else
+/// ignored is user data that `git worktree remove` would delete and an
+/// undo could not bring back.
+///
+/// # Errors
+/// Git failed.
+fn only_caches_ignored(top: &Path) -> Result<bool, String> {
+    let out = git_bytes(
+        top,
+        &[
+            "status",
+            "--porcelain",
+            "-z",
+            "--ignored=matching",
+            "--untracked-files=all",
+        ],
+    )?;
+    for entry in out.split(|&byte| byte == 0).filter(|e| !e.is_empty()) {
+        // Untracked and changed entries were refused already; anything
+        // that is not `!! path` here means the tree changed, so keep it.
+        let Some(relative) = entry.strip_prefix(b"!! ") else {
+            return Ok(false);
+        };
+        let relative = relative.strip_suffix(b"/").unwrap_or(relative);
+        if !disposable(top, relative) {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+
+/// Whether the ignored path `relative` under `top` is disposable; see
+/// [`only_caches_ignored`].
+fn disposable(top: &Path, relative: &[u8]) -> bool {
+    use std::ffi::OsStr;
+    use std::os::unix::ffi::OsStrExt;
+
+    let parts: Vec<&[u8]> = relative.split(|&byte| byte == b'/').collect();
+    if parts
+        .iter()
+        .any(|part| part.is_empty() || *part == b".." || *part == b".")
+    {
+        return false;
+    }
+    let mut at = top.to_owned();
+    for (index, part) in parts.iter().enumerate() {
+        at.push(OsStr::from_bytes(part));
+        let Ok(meta) = std::fs::symlink_metadata(&at) else {
+            return false;
+        };
+        let last = index + 1 == parts.len();
+        if meta.is_dir() && cache_dir_name(part) {
+            return true;
+        }
+        if last {
+            return meta.is_file() && *part == b".DS_Store";
+        }
+        if !meta.is_dir() {
+            return false;
+        }
+    }
+    false
+}
