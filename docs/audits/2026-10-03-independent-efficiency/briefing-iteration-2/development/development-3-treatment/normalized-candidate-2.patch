+/// Whether an ignored entry `relative` (as `git status -z --ignored=matching`
+/// lists it) inside the worktree `top` is a cache that rebuilds: a real
+/// directory (not a link) named `target`, `node_modules`, or
+/// `.cargo-target*`, at any depth, or a regular `.DS_Store` file. Removing
+/// the worktree deletes ignored files, and undo does not bring them back.
+fn disposable(top: &Path, relative: &[u8]) -> bool {
+    use std::os::unix::ffi::OsStrExt;
+    let relative = relative.strip_suffix(b"/").unwrap_or(relative);
+    let name = relative
+        .rsplit(|&byte| byte == b'/')
+        .next()
+        .unwrap_or_default();
+    let Ok(meta) = std::fs::symlink_metadata(top.join(std::ffi::OsStr::from_bytes(relative)))
+    else {
+        return false;
+    };
+    if meta.is_dir() {
+        name == b"target" || name == b"node_modules" || name.starts_with(b".cargo-target")
+    } else {
+        meta.is_file() && name == b".DS_Store"
+    }
+}
