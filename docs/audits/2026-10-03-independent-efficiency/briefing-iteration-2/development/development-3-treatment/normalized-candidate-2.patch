 #[test]
+fn ignored_data_keeps_a_worktree_and_ignored_caches_do_not() {
+    let home = Home::new();
+    let (repo, trees) = repo(
+        &home,
+        &["caches", "private", "file-target", "linked", "ds-dir"],
+    );
+    let [caches, private, file_target, linked, ds_dir] =
+        [&trees[0], &trees[1], &trees[2], &trees[3], &trees[4]];
+    std::fs::create_dir_all(repo.join(".git/info")).unwrap();
+    std::fs::write(
+        repo.join(".git/info/exclude"),
+        "private/\n.env\ntarget\nnode_modules\n.cargo-target*\n.DS_Store\n",
+    )
+    .unwrap();
+    // Recognized caches, nested ones and one under a name with a space and
+    // a newline, and a regular .DS_Store file: the worktree goes.
+    for dir in [
+        "target/debug",
+        "web/node_modules/pkg",
+        ".cargo-target-agent1/debug",
+        "odd name\nhere/target",
+    ] {
+        std::fs::create_dir_all(caches.join(dir)).unwrap();
+        std::fs::write(caches.join(dir).join("out"), "cache").unwrap();
+    }
+    std::fs::write(caches.join(".DS_Store"), "finder").unwrap();
+    // Ignored data that rebuilds from nothing: the worktree stays, intact.
+    let data = private.join("private/data with space\nand newline");
+    std::fs::create_dir_all(private.join("private")).unwrap();
+    std::fs::write(&data, "precious\ncontents ").unwrap();
+    std::fs::write(private.join(".env"), "TOKEN=x").unwrap();
+    // A cache name that is not a real directory, or a .DS_Store directory.
+    std::fs::write(file_target.join("target"), "not a cache").unwrap();
+    let outside = home.layout.home.join("outside");
+    std::fs::create_dir_all(&outside).unwrap();
+    std::fs::write(outside.join("keep"), "x").unwrap();
+    std::os::unix::fs::symlink(&outside, linked.join("node_modules")).unwrap();
+    std::fs::create_dir_all(ds_dir.join(".DS_Store")).unwrap();
+    std::fs::write(ds_dir.join(".DS_Store/notes"), "mine").unwrap();
+    let facts = home.facts();
+    let volumes = low();
+    let env = env(&home, &facts, &volumes, &Idle);
+    let report = run::run(&env, &disk(), Cause::Manual, false, true).unwrap();
+    assert!(!caches.exists());
+    for kept in [private, file_target, linked, ds_dir] {
+        assert!(kept.exists(), "{}", kept.display());
+    }
+    assert_eq!(std::fs::read(&data).unwrap(), b"precious\ncontents ");
+    assert_eq!(std::fs::read(private.join(".env")).unwrap(), b"TOKEN=x");
+    assert_eq!(
+        std::fs::read(file_target.join("target")).unwrap(),
+        b"not a cache"
+    );
+    assert!(linked.join("node_modules").is_symlink());
+    assert!(outside.join("keep").exists());
+    assert!(ds_dir.join(".DS_Store/notes").exists());
+    for name in ["private", "file-target", "linked", "ds-dir"] {
+        assert!(
+            report.plan.kept.iter().any(|kept| kept.path.ends_with(name)
+                && kept
+                    .why
+                    .starts_with("ignored files that are not disposable caches: ")),
+            "{name}: {:?}",
+            report.plan.kept
+        );
+    }
+}
