+/// Whether an ignored entry `name` (relative to the worktree `top`, as
+/// `git status` prints it) is safe to lose with the worktree: a real
+/// directory named `target`, `node_modules`, or `.cargo-target*`, or a
+/// regular `.DS_Store` file. A symbolic link or anything else is not.
+fn disposable(top: &Path, name: &[u8]) -> bool {
+    use std::os::unix::ffi::OsStrExt;
+    let name = name.strip_suffix(b"/").unwrap_or(name);
+    let Some(last) = name.rsplit(|&byte| byte == b'/').next() else {
+        return false;
+    };
+    let Ok(meta) = std::fs::symlink_metadata(top.join(std::ffi::OsStr::from_bytes(name))) else {
+        return false;
+    };
+    if last == b".DS_Store" {
+        return meta.file_type().is_file();
+    }
+    let cache = last == b"target" || last == b"node_modules" || last.starts_with(b".cargo-target");
+    cache && meta.file_type().is_dir()
+}
