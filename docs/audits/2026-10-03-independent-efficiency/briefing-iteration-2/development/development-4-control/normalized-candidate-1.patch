 #[test]
+fn ignored_files_keep_a_worktree_unless_they_are_caches() {
+    let home = Home::new();
+    let (repo, trees) = repo(
+        &home,
+        &["private", "caches", "linked", "fake", "dsdir", "dotenv"],
+    );
+    let [private, caches, linked, fake, dsdir, dotenv] = [
+        &trees[0], &trees[1], &trees[2], &trees[3], &trees[4], &trees[5],
+    ];
+    std::fs::create_dir_all(repo.join(".git/info")).unwrap();
+    std::fs::write(
+        repo.join(".git/info/exclude"),
+        "/private/\n.env\ntarget\nnode_modules\n.cargo-target*\n.DS_Store\n",
+    )
+    .unwrap();
+    // Ignored user data, named with a space and a newline.
+    let data = private.join("private/my data\nfile");
+    std::fs::create_dir_all(data.parent().unwrap()).unwrap();
+    std::fs::write(&data, "secret\ncontents with spaces").unwrap();
+    // Only recognized caches, some nested, and a regular .DS_Store.
+    for dir in [
+        "target/debug",
+        "web/node_modules/pkg",
+        ".cargo-target-agent1/debug",
+        "crates/a b/target/release",
+    ] {
+        std::fs::create_dir_all(caches.join(dir)).unwrap();
+        std::fs::write(caches.join(dir).join("out"), "build").unwrap();
+    }
+    std::fs::write(caches.join(".DS_Store"), "finder").unwrap();
+    // A cache beside an ignored secret: the secret keeps it.
+    std::fs::create_dir_all(dotenv.join("web/node_modules")).unwrap();
+    std::fs::write(dotenv.join("web/node_modules/x"), "x").unwrap();
+    std::fs::write(dotenv.join(".env"), "KEY=1").unwrap();
+    // A cache name that is a link, a regular file, or a .DS_Store directory.
+    let outside = home.layout.home.join("outside");
+    std::fs::create_dir_all(&outside).unwrap();
+    std::fs::write(outside.join("keep"), "x").unwrap();
+    std::os::unix::fs::symlink(&outside, linked.join("target")).unwrap();
+    std::fs::write(fake.join("node_modules"), "not a directory").unwrap();
+    std::fs::create_dir_all(dsdir.join(".DS_Store")).unwrap();
+    std::fs::write(dsdir.join(".DS_Store/inner"), "x").unwrap();
+
+    let facts = home.facts();
+    let volumes = low();
+    let env = env(&home, &facts, &volumes, &Idle);
+    let report = run::run(&env, &disk(), Cause::Manual, false, true).unwrap();
+    assert!(!caches.exists());
+    for kept in [private, linked, fake, dsdir, dotenv] {
+        assert!(kept.exists(), "{}", kept.display());
+    }
+    assert_eq!(
+        std::fs::read_to_string(&data).unwrap(),
+        "secret\ncontents with spaces"
+    );
+    assert!(dotenv.join(".env").exists());
+    assert!(outside.join("keep").exists());
+    let reasons: Vec<String> = report
+        .plan
+        .kept
+        .iter()
+        .map(|kept| kept.why.clone())
+        .collect();
+    let ignored = reasons
+        .iter()
+        .filter(|why| *why == "ignored files that are not caches")
+        .count();
+    assert!(ignored >= 5, "{reasons:?}");
+}
