 #[test]
+fn ignored_files_keep_a_worktree_unless_they_are_build_caches() {
+    let home = Home::new();
+    let (repo, trees) = repo(
+        &home,
+        &["caches", "secret", "file-target", "linked-target", "ds-dir"],
+    );
+    let [caches, secret, file_target, linked_target, ds_dir] =
+        [&trees[0], &trees[1], &trees[2], &trees[3], &trees[4]];
+    std::fs::create_dir_all(repo.join(".git/info")).unwrap();
+    std::fs::write(
+        repo.join(".git/info/exclude"),
+        "target\nnode_modules/\n.cargo-target*\n.DS_Store\nprivate/\n",
+    )
+    .unwrap();
+    // Build caches, nested ones, and Finder metadata: all rebuild.
+    for file in [
+        "target/debug/out",
+        "dir with space/target/debug/a b\nc",
+        "crates/a/node_modules/m/index.js",
+        ".cargo-target-1/debug/out",
+        ".DS_Store",
+        "sub/.DS_Store",
+    ] {
+        let path = caches.join(file);
+        std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+        std::fs::write(path, "cache").unwrap();
+    }
+    // Ignored user data whose name holds a space and a newline.
+    std::fs::create_dir_all(secret.join("private")).unwrap();
+    let data = secret.join("private/my data\nfile");
+    std::fs::write(&data, "keep me\nplease").unwrap();
+    // A cache name that is a regular file, or a link, is not a cache.
+    std::fs::write(file_target.join("target"), "not a cache").unwrap();
+    let outside = home.layout.home.join("outside");
+    std::fs::create_dir_all(&outside).unwrap();
+    std::fs::write(outside.join("keep"), "x").unwrap();
+    std::os::unix::fs::symlink(&outside, linked_target.join("target")).unwrap();
+    // A `.DS_Store` directory is not Finder's metadata file.
+    std::fs::create_dir_all(ds_dir.join(".DS_Store")).unwrap();
+    std::fs::write(ds_dir.join(".DS_Store/notes"), "mine").unwrap();
+    let facts = home.facts();
+    let volumes = low();
+    let env = env(&home, &facts, &volumes, &Idle);
+    let report = run::run(&env, &disk(), Cause::Manual, false, true).unwrap();
+    assert!(!caches.exists());
+    for kept in [secret, file_target, linked_target, ds_dir] {
+        assert!(kept.exists(), "{}", kept.display());
+        assert!(
+            report.plan.kept.iter().any(|entry| entry.path == *kept
+                && entry.why == "ignored files that are not build caches"),
+            "{}: {:?}",
+            kept.display(),
+            report.plan.kept
+        );
+    }
+    assert_eq!(std::fs::read_to_string(&data).unwrap(), "keep me\nplease");
+    assert_eq!(
+        std::fs::read_to_string(file_target.join("target")).unwrap(),
+        "not a cache"
+    );
+    assert!(linked_target.join("target").is_symlink());
+    assert!(outside.join("keep").exists());
+    assert!(ds_dir.join(".DS_Store/notes").exists());
+}
