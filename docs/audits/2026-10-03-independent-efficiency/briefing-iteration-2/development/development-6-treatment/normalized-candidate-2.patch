+/// Whether `name` names a build cache directory that rebuilds on its own.
+fn cache_name(name: &OsStr) -> bool {
+    let name = name.as_bytes();
+    name == b"target" || name == b"node_modules" || name.starts_with(b".cargo-target")
+}
+
+/// Whether the ignored path `name` (relative to the checkout `top`, as
+/// `git status -z` prints it) is disposable: a real directory with a cache
+/// name or a path inside one, or a regular `.DS_Store` file. A symbolic
+/// link never is.
+fn disposable(top: &Path, name: &[u8]) -> bool {
+    let name = name.strip_suffix(b"/").unwrap_or(name);
+    let relative = Path::new(OsStr::from_bytes(name));
+    let Ok(meta) = std::fs::symlink_metadata(top.join(relative)) else {
+        return false;
+    };
+    if meta.file_type().is_symlink() {
+        return false;
+    }
+    if meta.is_file() && relative.file_name() == Some(OsStr::new(".DS_Store")) {
+        return true;
+    }
+    let mut at = top.to_owned();
+    for component in relative.components() {
+        let Component::Normal(part) = component else {
+            return false;
+        };
+        at.push(part);
+        let Ok(meta) = std::fs::symlink_metadata(&at) else {
+            return false;
+        };
+        if meta.file_type().is_symlink() {
+            return false;
+        }
+        if meta.is_dir() && cache_name(part) {
+            return true;
+        }
+    }
+    false
+}
