 #[test]
+fn ignored_user_data_keeps_a_worktree_and_build_caches_do_not() {
+    let home = Home::new();
+    let (repo, trees) = repo(
+        &home,
+        &["data", "link", "file", "store", "store-dir", "caches"],
+    );
+    let [data, link, file, store, store_dir, caches] = [
+        &trees[0], &trees[1], &trees[2], &trees[3], &trees[4], &trees[5],
+    ];
+    std::fs::create_dir_all(repo.join(".git/info")).unwrap();
+    std::fs::write(
+        repo.join(".git/info/exclude"),
+        "private/\ntarget\nnode_modules\n.cargo-target*\n.DS_Store\n*.env\n",
+    )
+    .unwrap();
+    // Unknown ignored data, with a space and a newline in its name.
+    let secret = data.join("private/my data\nset");
+    std::fs::create_dir_all(data.join("private")).unwrap();
+    std::fs::write(&secret, "rows").unwrap();
+    std::fs::write(data.join("local .env"), "KEY=1").unwrap();
+    // Cache names that are not real directories.
+    let outside = home.layout.home.join("outside");
+    std::fs::create_dir_all(&outside).unwrap();
+    std::fs::write(outside.join("keep"), "keep").unwrap();
+    std::os::unix::fs::symlink(&outside, link.join("target")).unwrap();
+    std::fs::write(file.join("node_modules"), "not a cache").unwrap();
+    // A regular `.DS_Store` beside other ignored data, and a `.DS_Store`
+    // directory.
+    std::fs::write(store.join(".DS_Store"), "finder").unwrap();
+    std::fs::write(store.join("x.env"), "KEY=2").unwrap();
+    std::fs::create_dir_all(store_dir.join(".DS_Store")).unwrap();
+    std::fs::write(store_dir.join(".DS_Store/inside"), "data").unwrap();
+    // Recognized caches, nested ones included, and a regular `.DS_Store`.
+    for dir in [
+        "target/debug",
+        "web/node_modules/pkg",
+        ".cargo-target-1/release",
+        "crates/a b/target/debug",
+    ] {
+        std::fs::create_dir_all(caches.join(dir)).unwrap();
+        std::fs::write(caches.join(dir).join("out"), "built").unwrap();
+    }
+    std::fs::write(caches.join(".DS_Store"), "finder").unwrap();
+
+    let facts = home.facts();
+    let volumes = low();
+    let env = env(&home, &facts, &volumes, &Idle);
+    let report = run::run(&env, &disk(), Cause::Manual, false, true).unwrap();
+    assert!(!caches.exists());
+    for kept in [data, link, file, store, store_dir] {
+        assert!(kept.exists(), "{}", kept.display());
+        let why = report
+            .plan
+            .kept
+            .iter()
+            .find(|entry| &entry.path == kept)
+            .map(|entry| entry.why.as_str());
+        assert!(
+            why.is_some_and(|why| why.starts_with("ignored files that are not a build cache: ")),
+            "{}: {why:?}",
+            kept.display()
+        );
+    }
+    assert_eq!(std::fs::read_to_string(&secret).unwrap(), "rows");
+    assert_eq!(
+        std::fs::read_to_string(data.join("local .env")).unwrap(),
+        "KEY=1"
+    );
+    assert!(
+        std::fs::symlink_metadata(link.join("target"))
+            .unwrap()
+            .file_type()
+            .is_symlink()
+    );
+    assert_eq!(
+        std::fs::read_to_string(outside.join("keep")).unwrap(),
+        "keep"
+    );
+    assert_eq!(
+        std::fs::read_to_string(file.join("node_modules")).unwrap(),
+        "not a cache"
+    );
+    assert_eq!(
+        std::fs::read_to_string(store.join("x.env")).unwrap(),
+        "KEY=2"
+    );
+    assert_eq!(
+        std::fs::read_to_string(store_dir.join(".DS_Store/inside")).unwrap(),
+        "data"
+    );
+}
