 #[test]
+fn ignored_files_keep_a_worktree_unless_they_are_build_caches() {
+    let home = Home::new();
+    let names = ["cache", "private", "fake", "linked", "dsdir", "spaced"];
+    let (repo, trees) = repo(&home, &names);
+    let [cache, private, fake, linked, dsdir, spaced] = [
+        &trees[0], &trees[1], &trees[2], &trees[3], &trees[4], &trees[5],
+    ];
+    let info = repo.join(".git/info");
+    std::fs::create_dir_all(&info).unwrap();
+    std::fs::write(
+        info.join("exclude"),
+        "private/\ntarget\nnode_modules\n.cargo-target*\n.DS_Store\n*.dat\n",
+    )
+    .unwrap();
+    // Caches, nested caches, and a .DS_Store file: disposable.
+    std::fs::create_dir_all(cache.join("target/debug")).unwrap();
+    std::fs::write(cache.join("target/debug/out"), "build").unwrap();
+    std::fs::create_dir_all(cache.join("web/node_modules/pkg")).unwrap();
+    std::fs::write(cache.join("web/node_modules/pkg/index.js"), "js").unwrap();
+    std::fs::create_dir_all(cache.join(".cargo-target-agent1")).unwrap();
+    std::fs::write(cache.join(".cargo-target-agent1/out"), "build").unwrap();
+    std::fs::write(cache.join(".DS_Store"), "finder").unwrap();
+    // Unknown ignored data.
+    std::fs::create_dir_all(private.join("private")).unwrap();
+    std::fs::write(private.join("private/data"), "secret").unwrap();
+    // A regular file with a cache's name.
+    std::fs::write(fake.join("target"), "not a directory").unwrap();
+    // A link with a cache's name.
+    let outside = home.layout.home.join("modules");
+    std::fs::create_dir_all(&outside).unwrap();
+    std::fs::write(outside.join("keep"), "x").unwrap();
+    std::os::unix::fs::symlink(&outside, linked.join("node_modules")).unwrap();
+    // A .DS_Store directory.
+    std::fs::create_dir_all(dsdir.join(".DS_Store")).unwrap();
+    std::fs::write(dsdir.join(".DS_Store/notes"), "mine").unwrap();
+    // A name with a space and a newline.
+    let odd = spaced.join("my data\nnext line.dat");
+    std::fs::write(&odd, "line one\nline two").unwrap();
+    for tree in [cache, private, fake, linked, dsdir, spaced] {
+        assert_eq!(
+            git(tree, &["status", "--porcelain"]),
+            "",
+            "{}",
+            tree.display()
+        );
+    }
+    let facts = home.facts();
+    let volumes = low();
+    let env = env(&home, &facts, &volumes, &Idle);
+    let report = run::run(&env, &disk(), Cause::Manual, false, true).unwrap();
+    assert!(!cache.exists());
+    for kept in [private, fake, linked, dsdir, spaced] {
+        assert!(kept.exists(), "{}", kept.display());
+        let why = report
+            .plan
+            .kept
+            .iter()
+            .find(|item| &item.path == kept)
+            .map(|item| item.why.clone());
+        assert_eq!(
+            why.as_deref(),
+            Some("ignored files that are not a build cache"),
+            "{}",
+            kept.display()
+        );
+    }
+    assert_eq!(
+        std::fs::read_to_string(private.join("private/data")).unwrap(),
+        "secret"
+    );
+    assert_eq!(
+        std::fs::read_to_string(fake.join("target")).unwrap(),
+        "not a directory"
+    );
+    assert!(linked.join("node_modules").is_symlink());
+    assert!(outside.join("keep").exists());
+    assert_eq!(
+        std::fs::read_to_string(dsdir.join(".DS_Store/notes")).unwrap(),
+        "mine"
+    );
+    assert_eq!(std::fs::read_to_string(&odd).unwrap(), "line one\nline two");
+}
