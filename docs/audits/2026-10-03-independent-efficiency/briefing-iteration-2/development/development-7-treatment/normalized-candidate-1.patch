+/// Whether `name` is a directory name the monitor treats as a disposable
+/// build cache inside a worktree: `target`, `node_modules`, or
+/// `.cargo-target*`.
+fn cache_name(name: &[u8]) -> bool {
+    name == b"target" || name == b"node_modules" || name.starts_with(b".cargo-target")
+}
+
+/// Whether the ignored entry `relative` (as `git status` names it, a
+/// directory with a trailing `/`) inside `top` is disposable: it is, or
+/// lies inside, a real directory with a cache name, or it is a regular
+/// `.DS_Store` file. Symbolic links and anything else are not.
+fn disposable(top: &Path, relative: &[u8]) -> bool {
+    use std::os::unix::ffi::OsStrExt;
+    let trimmed = relative.strip_suffix(b"/").unwrap_or(relative);
+    let mut prefix = top.to_owned();
+    let parts: Vec<&[u8]> = trimmed.split(|byte| *byte == b'/').collect();
+    for (index, part) in parts.iter().enumerate() {
+        if part.is_empty() {
+            return false;
+        }
+        prefix.push(std::ffi::OsStr::from_bytes(part));
+        let Ok(meta) = std::fs::symlink_metadata(&prefix) else {
+            return false;
+        };
+        if meta.file_type().is_symlink() {
+            return false;
+        }
+        if meta.is_dir() && cache_name(part) {
+            return true;
+        }
+        if index + 1 == parts.len() {
+            return meta.is_file() && *part == b".DS_Store";
+        }
+    }
+    false
+}
