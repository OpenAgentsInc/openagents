+/// Whether `name` is a build or package cache directory that rebuilds:
+/// `target`, `node_modules`, or `.cargo-target*`.
+fn cache_name(name: &OsStr) -> bool {
+    let name = name.as_bytes();
+    name == b"target" || name == b"node_modules" || name.starts_with(b".cargo-target")
+}
+
+/// Whether everything at `path`, which Git ignores, is disposable: a real
+/// directory with a cache name, a regular `.DS_Store` file, or a real
+/// directory (not named `.DS_Store`) holding only those. A symbolic link or
+/// anything else is not.
+fn disposable(path: &Path) -> bool {
+    let Ok(meta) = std::fs::symlink_metadata(path) else {
+        return false;
+    };
+    let name = path.file_name().unwrap_or_default();
+    let metadata_file = name.as_bytes() == b".DS_Store";
+    if meta.is_file() {
+        return metadata_file;
+    }
+    if !meta.is_dir() || metadata_file {
+        return false;
+    }
+    if cache_name(name) {
+        return true;
+    }
+    let Ok(mut entries) = std::fs::read_dir(path) else {
+        return false;
+    };
+    entries.all(|entry| entry.is_ok_and(|entry| disposable(&entry.path())))
+}
+
+/// The first ignored path in the worktree at `top` that is not disposable.
+///
+/// # Errors
+/// Git could not list ignored files.
+fn ignored_data(top: &Path) -> Result<Option<PathBuf>, String> {
+    let output = Command::new("git")
+        .arg("-C")
+        .arg(top)
+        .args([
+            "ls-files",
+            "-z",
+            "--others",
+            "--ignored",
+            "--exclude-standard",
+            "--directory",
+        ])
+        .env("GIT_TERMINAL_PROMPT", "0")
+        .env("GIT_OPTIONAL_LOCKS", "0")
+        .stdin(std::process::Stdio::null())
+        .output()
+        .map_err(|error| format!("git: {error}"))?;
+    if !output.status.success() {
+        return Err(format!(
+            "git ls-files: {}",
+            String::from_utf8_lossy(&output.stderr).trim()
+        ));
+    }
+    for entry in output.stdout.split(|byte| *byte == 0) {
+        if entry.is_empty() {
+            continue;
+        }
+        // Git marks a directory with a trailing slash; the path itself
+        // decides what it is.
+        let entry = entry.strip_suffix(b"/").unwrap_or(entry);
+        let path = top.join(OsStr::from_bytes(entry));
+        if !disposable(&path) {
+            return Ok(Some(path));
+        }
+    }
+    Ok(None)
+}
