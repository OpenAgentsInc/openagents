 #[test]
+fn ignored_data_keeps_a_worktree_and_ignored_caches_do_not() {
+    let home = Home::new();
+    let (repo, trees) = repo(
+        &home,
+        &["private", "caches", "file", "linked", "dsdir", "odd"],
+    );
+    let [private, caches, file, linked, dsdir, odd] = [
+        &trees[0], &trees[1], &trees[2], &trees[3], &trees[4], &trees[5],
+    ];
+    std::fs::write(
+        repo.join(".git/info/exclude"),
+        "private/\ntarget\nnode_modules\n.cargo-target*\n.DS_Store\n*.secret\n",
+    )
+    .unwrap();
+    // Unknown ignored data.
+    std::fs::create_dir_all(private.join("private")).unwrap();
+    std::fs::write(private.join("private/data"), "mine").unwrap();
+    // Caches, nested caches, and a metadata file, with awkward names.
+    std::fs::create_dir_all(caches.join("target/debug")).unwrap();
+    std::fs::write(caches.join("target/debug/a b\nc"), "x").unwrap();
+    std::fs::create_dir_all(caches.join("crates/one/target")).unwrap();
+    std::fs::write(caches.join("crates/one/target/x"), "x").unwrap();
+    std::fs::create_dir_all(caches.join("web dir/deep/node_modules/m")).unwrap();
+    std::fs::write(caches.join("web dir/deep/node_modules/m/i.js"), "x").unwrap();
+    std::fs::create_dir_all(caches.join(".cargo-target-2")).unwrap();
+    std::fs::write(caches.join(".cargo-target-2/x"), "x").unwrap();
+    std::fs::write(caches.join(".DS_Store"), "x").unwrap();
+    // A regular file with a cache's name.
+    std::fs::write(file.join("target"), "not a cache").unwrap();
+    // A symbolic link with a cache's name.
+    let outside = home.layout.home.join("outside");
+    std::fs::create_dir_all(&outside).unwrap();
+    std::fs::write(outside.join("keep"), "x").unwrap();
+    std::os::unix::fs::symlink(&outside, linked.join("node_modules")).unwrap();
+    // A directory with the metadata file's name.
+    std::fs::create_dir_all(dsdir.join(".DS_Store")).unwrap();
+    std::fs::write(dsdir.join(".DS_Store/data"), "mine").unwrap();
+    // Unknown ignored data whose name holds a space and a newline.
+    std::fs::write(odd.join("my key\nfile.secret"), "a b\nc").unwrap();
+    let facts = home.facts();
+    let volumes = low();
+    let env = env(&home, &facts, &volumes, &Idle);
+    let report = run::run(&env, &disk(), Cause::Manual, false, true).unwrap();
+    assert!(!caches.exists());
+    for kept in [private, file, linked, dsdir, odd] {
+        assert!(kept.exists(), "{}", kept.display());
+    }
+    assert_eq!(
+        std::fs::read_to_string(private.join("private/data")).unwrap(),
+        "mine"
+    );
+    assert_eq!(
+        std::fs::read_to_string(dsdir.join(".DS_Store/data")).unwrap(),
+        "mine"
+    );
+    assert_eq!(
+        std::fs::read_to_string(odd.join("my key\nfile.secret")).unwrap(),
+        "a b\nc"
+    );
+    assert!(linked.join("node_modules").is_symlink());
+    assert!(outside.join("keep").exists());
+    for tree in [private, file, linked, dsdir, odd] {
+        assert!(
+            report
+                .plan
+                .kept
+                .iter()
+                .any(|kept| &kept.path == tree
+                    && kept.why == "ignored files that are not a build cache"),
+            "{}: {:?}",
+            tree.display(),
+            report.plan.kept
+        );
+    }
+}
