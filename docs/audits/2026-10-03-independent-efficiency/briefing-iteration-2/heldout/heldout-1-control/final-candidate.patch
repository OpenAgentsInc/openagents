+/// The run directories under a list of directories, one copy of each run,
+/// and the marks their manifests give. The result doesn't depend on the
+/// list's order.
+#[derive(Clone, Debug, Default)]
+pub struct Copies {
+    /// Each directory and its manifest, when it has one, in the list's order.
+    pub hosts: Vec<(PathBuf, Option<Manifest>)>,
+    /// Every manifest's commit attributions and mixed marks, by run name,
+    /// for every copy of the run wherever it's read from.
+    pub marks: Manifest,
+    /// Each run's chosen copy by name, with the index into `hosts` of the
+    /// directory it's read from.
+    pub runs: BTreeMap<String, (PathBuf, usize)>,
+}
+
+impl Copies {
+    /// Finds the runs under `dirs`. A run under more than one directory is
+    /// read from the copy whose manifest names it, else from a retained host
+    /// directory, else from the first path in sorted order.
+    #[must_use]
+    pub fn find(dirs: &[PathBuf]) -> Self {
+        let hosts: Vec<(PathBuf, Option<Manifest>)> = dirs
+            .iter()
+            .map(|dir| (dir.clone(), Manifest::read(dir)))
+            .collect();
+        // Marks merge in path order, so two manifests that disagree resolve
+        // the same way whatever order the directories came in.
+        let mut order: Vec<usize> = (0..hosts.len()).collect();
+        order.sort_by(|a, b| hosts[*a].0.cmp(&hosts[*b].0));
+        let mut marks = Manifest::default();
+        for &host in &order {
+            let Some(manifest) = &hosts[host].1 else {
+                continue;
+            };
+            for (name, commit) in &manifest.commits {
+                marks
+                    .commits
+                    .entry(name.clone())
+                    .or_insert_with(|| commit.clone());
+            }
+            for (name, why) in &manifest.mixed {
+                marks
+                    .mixed
+                    .entry(name.clone())
+                    .or_insert_with(|| why.clone());
+            }
+        }
+        let rank = |name: &str, path: &Path, host: usize| {
+            let preference = match &hosts[host].1 {
+                Some(manifest) if manifest.names(name) => 0,
+                Some(_) => 1,
+                None => 2,
+            };
+            (preference, path.to_path_buf())
+        };
+        let mut runs: BTreeMap<String, (PathBuf, usize)> = BTreeMap::new();
+        for (host, (dir, _)) in hosts.iter().enumerate() {
+            for run_dir in run_dirs(dir) {
+                let name = run_dir
+                    .file_name()
+                    .map(|n| n.to_string_lossy().into_owned())
+                    .unwrap_or_default();
+                let better = runs.get(&name).is_none_or(|(path, chosen)| {
+                    rank(&name, &run_dir, host) < rank(&name, path, *chosen)
+                });
+                if better {
+                    runs.insert(name, (run_dir, host));
+                }
+            }
+        }
+        Copies { hosts, marks, runs }
+    }
+
+    /// The manifest of the directory at `host`, when it has one.
+    #[must_use]
+    pub fn manifest(&self, host: usize) -> Option<&Manifest> {
+        self.hosts
+            .get(host)
+            .and_then(|(_, manifest)| manifest.as_ref())
+    }
 }
 
