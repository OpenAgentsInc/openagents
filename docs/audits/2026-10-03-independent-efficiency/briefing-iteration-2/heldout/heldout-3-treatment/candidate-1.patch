+pub fn copies(dirs: &[PathBuf]) -> Vec<(PathBuf, Option<Manifest>)> {
+    let mut sorted: Vec<&PathBuf> = dirs.iter().collect();
+    sorted.sort();
+    sorted.dedup();
+    let manifests: Vec<Option<Manifest>> = sorted
+        .iter()
+        .map(|dir| Manifest::read(dir.as_path()))
+        .collect();
+    // Per name: (rank, path, the index of its host directory).
+    let mut chosen: BTreeMap<String, ((u8, PathBuf), usize)> = BTreeMap::new();
+    for (index, dir) in sorted.iter().enumerate() {
         for run_dir in run_dirs(dir) {
             let name = run_dir
                 .file_name()
                 .map(|n| n.to_string_lossy().into_owned())
                 .unwrap_or_default();
-            if !seen.insert(name) {
-                continue;
+            let rank = match &manifests[index] {
+                Some(manifest) if manifest.files.contains_key(&name) => 0,
+                Some(_) => 1,
+                None => 2,
+            };
+            let key = (rank, run_dir);
+            match chosen.get(&name) {
+                Some((best, _)) if *best <= key => {}
+                _ => {
+                    chosen.insert(name, (key, index));
+                }
             }
-            runs.push(read(&run_dir, knowledge, manifest.as_ref(), now));
-        }
-    }
-    runs
+        }
+    }
+    chosen
+        .into_iter()
+        .map(|(name, ((_, run_dir), index))| {
+            let own = manifests[index].as_ref();
+            let others = manifests
+                .iter()
+                .enumerate()
+                .filter(|(other, _)| *other != index)
+                .filter_map(|(_, manifest)| manifest.as_ref());
+            let order: Vec<&Manifest> = own.into_iter().chain(others).collect();
+            let mut manifest = Manifest {
+                retained: own.is_some(),
+                ..Manifest::default()
+            };
+            if let Some(files) = own.and_then(|m| m.files.get(&name)) {
+                manifest.files.insert(name.clone(), files.clone());
+            }
+            if let Some(commit) = order.iter().find_map(|m| m.commits.get(&name)) {
+                manifest.commits.insert(name.clone(), commit.clone());
+            }
+            if let Some(why) = order.iter().find_map(|m| m.mixed.get(&name)) {
+                manifest.mixed.insert(name.clone(), why.clone());
+            }
+            let marked = !manifest.commits.is_empty() || !manifest.mixed.is_empty();
+            let manifest = (own.is_some() || marked).then_some(manifest);
+            (run_dir, manifest)
+        })
+        .collect()
+}
+
+/// Every run in `dirs`, one copy each, chosen and marked as [`copies`]
+/// says.
+#[must_use]
+pub fn read_all(dirs: &[PathBuf], knowledge: &Knowledge, now: i64) -> Vec<Run> {
+    copies(dirs)
+        .into_iter()
+        .map(|(run_dir, manifest)| read(&run_dir, knowledge, manifest.as_ref(), now))
+        .collect()
 }
 
