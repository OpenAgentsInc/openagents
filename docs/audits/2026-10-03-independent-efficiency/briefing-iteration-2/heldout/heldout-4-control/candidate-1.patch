-/// Every run in `dirs`, the first directory's copy of a run winning.
+/// Gives `run` the marks a manifest of another directory carries for its
+/// name: the mixed note, and the commit attribution when the record has no
+/// commit. A run read from a live directory keeps a retained copy's marks.
+pub fn apply_marks(run: &mut Run, marks: &Manifest) {
+    let Some(m) = run.microcoder.as_deref_mut() else {
+        return;
+    };
+    if !m.mixed
+        && let Some(why) = marks.mixed.get(&m.name)
+    {
+        m.mixed = true;
+        run.notes.push(format!("its records are mixed: {why}"));
+    }
+    if m.commit.is_none()
+        && let Some((commit, source)) = marks.commits.get(&m.name)
+    {
+        m.commit = Some(commit.clone());
+        m.commit_source = Some(source.clone());
+    }
+}
+
+/// The Microcoder run directories in a list of source directories, one copy
+/// per run name, chosen the same way whatever the list's order.
+#[derive(Clone, Debug, Default)]
+pub struct Sources {
+    /// Each source directory's manifest, in the order given.
+    pub manifests: Vec<Option<Manifest>>,
+    /// Every manifest's mixed notes and commit attributions by run name.
+    pub marks: Manifest,
+    /// One copy per run name, by name: its directory and the index of the
+    /// source directory it is read from.
+    pub runs: Vec<(PathBuf, usize)>,
+}
+
+impl Sources {
+    /// Finds every run in `dirs`. When two directories hold a run of the
+    /// same name, the copy a manifest lists wins, then a copy in a retained
+    /// directory, then the copy in the earlier directory.
+    #[must_use]
+    pub fn locate(dirs: &[PathBuf]) -> Self {
+        let manifests: Vec<Option<Manifest>> = dirs.iter().map(|dir| Manifest::read(dir)).collect();
+        let mut marks = Manifest::default();
+        for manifest in manifests.iter().flatten() {
+            for (name, why) in &manifest.mixed {
+                marks
+                    .mixed
+                    .entry(name.clone())
+                    .or_insert_with(|| why.clone());
+            }
+            for (name, commit) in &manifest.commits {
+                marks
+                    .commits
+                    .entry(name.clone())
+                    .or_insert_with(|| commit.clone());
+            }
+        }
+        let mut chosen: BTreeMap<String, (u8, usize, PathBuf)> = BTreeMap::new();
+        for (source, dir) in dirs.iter().enumerate() {
+            let manifest = manifests[source].as_ref();
+            for run_dir in run_dirs(dir) {
+                let name = run_dir
+                    .file_name()
+                    .map(|n| n.to_string_lossy().into_owned())
+                    .unwrap_or_default();
+                let rank = match manifest {
+                    Some(m) if m.files.contains_key(&name) => 0,
+                    Some(_) => 1,
+                    None => 2,
+                };
+                let better = chosen
+                    .get(&name)
+                    .is_none_or(|(best, _, _)| rank < *best);
+                if better {
+                    chosen.insert(name, (rank, source, run_dir));
+                }
+            }
+        }
+        Sources {
+            manifests,
+            marks,
+            runs: chosen
+                .into_values()
+                .map(|(_, source, run_dir)| (run_dir, source))
+                .collect(),
+        }
+    }
+
+    /// Reads one located run under its own directory's manifest, with
+    /// every manifest's marks for its name.
+    #[must_use]
+    pub fn read(&self, run_dir: &Path, source: usize, knowledge: &Knowledge, now: i64) -> Run {
+        let manifest = self.manifests.get(source).and_then(Option::as_ref);
+        let mut run = read(run_dir, knowledge, manifest, now);
+        apply_marks(&mut run, &self.marks);
+        run
+    }
+}
