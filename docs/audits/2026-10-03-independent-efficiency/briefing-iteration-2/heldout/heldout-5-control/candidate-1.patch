+
+    /// Reads run `index` from the copy chosen, with every manifest's marks
+    /// for its name.
+    #[must_use]
+    pub fn read(&self, index: usize, knowledge: &Knowledge, now: i64) -> Run {
+        let (name, run_dir, manifest) = &self.chosen[index];
+        let mut run = read(run_dir, knowledge, self.manifests[*manifest].as_ref(), now);
+        let marked = || self.manifests.iter().flatten();
+        apply_marks(
+            &mut run,
+            marked().find_map(|m| m.mixed.get(name)).map(String::as_str),
+            marked().find_map(|m| m.commits.get(name)),
+        );
+        run
+    }
+}
+
+/// Applies a manifest's marks to a run read from anywhere: the mixed mark,
+/// and the commit attribution when the run has no commit of its own.
+fn apply_marks(run: &mut Run, mixed: Option<&str>, commit: Option<&(String, String)>) {
+    let Some(m) = run.microcoder.as_deref_mut() else {
+        return;
+    };
+    if let Some(why) = mixed
+        && !m.mixed
+    {
+        m.mixed = true;
+        run.notes.push(format!("its records are mixed: {why}"));
+    }
+    if let Some((commit, source)) = commit
+        && m.commit.is_none()
+    {
+        m.commit = Some(commit.clone());
+        m.commit_source = Some(source.clone());
+    }
 }
 
