-    }
-    runs
+        }
+        let chosen = found
+            .into_iter()
+            .filter_map(|(name, copies)| {
+                let (_, run_dir, index) = copies.into_iter().min()?;
+                Some((name, run_dir, index))
+            })
+            .collect();
+        Copies { manifests, chosen }
+    }
+
+    /// How many runs there are.
+    #[must_use]
