+/// The runs in a set of directories, one copy per run directory name, chosen
+/// the same way whatever order the directories come in.
+#[derive(Clone, Debug, Default)]
+pub struct Copies {
+    manifests: Vec<Option<Manifest>>,
+    /// Each run's name, the copy chosen, and its directory's manifest.
+    chosen: Vec<(String, PathBuf, usize)>,
+}
+
+impl Copies {
+    /// Finds every run in `dirs` and chooses one copy of each, in name
