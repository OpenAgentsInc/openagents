+    #[must_use]
+    pub fn find(dirs: &[PathBuf]) -> Self {
+        let mut dirs: Vec<&PathBuf> = dirs.iter().collect();
+        dirs.sort();
+        dirs.dedup();
+        let manifests: Vec<Option<Manifest>> =
+            dirs.iter().map(|dir| Manifest::read(dir)).collect();
+        // Every copy of each run: its rank, its path, and its manifest.
