+/// One copy of a run chosen to be read: its directory, the manifest of
+/// the host directory it sits in, and the marks every manifest gives its
+/// name, wherever that manifest was read from.
+#[derive(Clone, Debug)]
+pub struct RunCopy {
+    pub dir: PathBuf,
+    pub manifest: Option<Arc<Manifest>>,
+    /// The `mixed` and commit marks any manifest in the read gives this
+    /// run's name; `files` stays empty.
+    pub marks: Manifest,
+}
+
+impl RunCopy {
+    /// Reads the copy with its marks.
+    #[must_use]
+    pub fn read(&self, knowledge: &Knowledge, now: i64) -> Run {
+        read_marked(
+            &self.dir,
+            knowledge,
+            self.manifest.as_deref(),
+            Some(&self.marks),
+            now,
+        )
+    }
+}
+
+/// One copy of every run in `dirs`, independent of their order. A copy
+/// whose host directory's manifest names the run wins over a copy in a
+/// directory with a manifest that doesn't, and that wins over a copy with
+/// no manifest, such as the live `~/.openagents/microcoder/runs`; among
+/// equals, the earlier directory wins. Every manifest's `mixed` mark and
+/// commit attribution for a name apply to the copy that's read, the
+/// copy's own manifest first.
+#[must_use]
+pub fn copies(dirs: &[PathBuf]) -> Vec<RunCopy> {
+    let manifests: Vec<Option<Arc<Manifest>>> = dirs
+        .iter()
+        .map(|dir| Manifest::read(dir).map(Arc::new))
+        .collect();
+    let listed: Vec<Vec<(String, PathBuf)>> = dirs
+        .iter()
+        .map(|dir| {
+            run_dirs(dir)
+                .into_iter()
+                .map(|run_dir| {
+                    let name = run_dir
+                        .file_name()
+                        .map(|n| n.to_string_lossy().into_owned())
+                        .unwrap_or_default();
+                    (name, run_dir)
+                })
+                .collect()
+        })
+        .collect();
+    let rank = |index: usize, name: &str| match &manifests[index] {
+        Some(manifest) if manifest.files.contains_key(name) => 0,
+        Some(_) => 1,
+        None => 2,
+    };
+    let mut chosen: HashMap<&str, (u8, usize)> = HashMap::new();
+    for (index, runs) in listed.iter().enumerate() {
+        for (name, _) in runs {
+            let candidate = (rank(index, name), index);
+            chosen
+                .entry(name.as_str())
+                .and_modify(|best| *best = (*best).min(candidate))
+                .or_insert(candidate);
+        }
+    }
+    let mut copies = Vec::new();
+    for (index, runs) in listed.iter().enumerate() {
+        for (name, run_dir) in runs {
+            if chosen.get(name.as_str()).map(|&(_, at)| at) != Some(index) {
+                continue;
+            }
+            let mut marks = Manifest::default();
+            let own = manifests[index].iter();
+            let others = manifests
+                .iter()
+                .enumerate()
+                .filter(|&(at, _)| at != index)
+                .filter_map(|(_, manifest)| manifest.as_ref());
+            for manifest in own.chain(others) {
+                if let Some(commit) = manifest.commits.get(name) {
+                    marks
+                        .commits
+                        .entry(name.clone())
+                        .or_insert_with(|| commit.clone());
+                }
+                if let Some(why) = manifest.mixed.get(name) {
+                    marks
+                        .mixed
+                        .entry(name.clone())
+                        .or_insert_with(|| why.clone());
+                }
+            }
+            copies.push(RunCopy {
+                dir: run_dir.clone(),
+                manifest: manifests[index].clone(),
+                marks,
+            });
+        }
+    }
+    copies
+}
