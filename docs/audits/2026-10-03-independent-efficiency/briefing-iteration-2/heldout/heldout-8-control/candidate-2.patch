-/// Every run in `dirs`, the first directory's copy of a run winning.
+/// Applies the marks any manifest makes about a run of this name, the
+/// mixed mark and the commit attribution, to a copy read from anywhere.
+fn apply_marks(run: &mut Run, marks: &Manifest) {
+    let Some(m) = run.microcoder.as_deref_mut() else {
+        return;
+    };
+    if !m.mixed
+        && let Some(why) = marks.mixed.get(&m.name)
+    {
+        m.mixed = true;
+        run.notes.push(format!("its records are mixed: {why}"));
+    }
+    if m.commit.is_none()
+        && let Some((commit, source)) = marks.commits.get(&m.name)
+    {
+        m.commit = Some(commit.clone());
+        m.commit_source = Some(source.clone());
+    }
+}
+
+/// Which copy of each run to read from a set of directories, whatever
+/// order they're given in, and the marks every manifest makes.
+#[derive(Clone, Debug, Default)]
+pub struct Selection {
+    /// Each directory's manifest, by directory, lowest path first.
+    pub manifests: Vec<Option<Manifest>>,
+    /// Per run directory name, by name: the copy to read and the index of
+    /// its directory's manifest in `manifests`.
+    pub runs: Vec<(String, PathBuf, usize)>,
+    /// Every manifest's mixed marks and commit attributions, the lowest
+    /// path's winning a conflict.
+    pub marks: Manifest,
+}
+
+impl Selection {
+    /// One copy per run directory name in `dirs`. A copy a retained
+    /// manifest lists wins over one it doesn't, and the lowest path breaks
+    /// a tie.
+    #[must_use]
+    pub fn new(dirs: &[PathBuf]) -> Self {
+        let mut sorted: Vec<&PathBuf> = dirs.iter().collect();
+        sorted.sort();
+        sorted.dedup();
+        let manifests: Vec<Option<Manifest>> =
+            sorted.iter().map(|dir| Manifest::read(dir)).collect();
+
+        let mut marks = Manifest::default();
+        for manifest in manifests.iter().flatten() {
+            for (name, why) in &manifest.mixed {
+                marks
+                    .mixed
+                    .entry(name.clone())
+                    .or_insert_with(|| why.clone());
+            }
+            for (name, commit) in &manifest.commits {
+                marks
+                    .commits
+                    .entry(name.clone())
+                    .or_insert_with(|| commit.clone());
+            }
+        }
+
+        // (not listed in its manifest, path) orders the copies of a name.
+        let mut chosen: BTreeMap<String, (bool, PathBuf, usize)> = BTreeMap::new();
+        for (index, dir) in sorted.iter().enumerate() {
+            for run_dir in run_dirs(dir) {
+                let name = run_dir
+                    .file_name()
+                    .map(|n| n.to_string_lossy().into_owned())
+                    .unwrap_or_default();
+                let unlisted = !manifests[index]
+                    .as_ref()
+                    .is_some_and(|m| m.files.contains_key(&name));
+                let better = chosen
+                    .get(&name)
+                    .is_none_or(|(held, path, _)| (unlisted, &run_dir) < (*held, path));
+                if better {
+                    chosen.insert(name, (unlisted, run_dir, index));
+                }
+            }
+        }
+        Selection {
+            manifests,
+            runs: chosen
+                .into_iter()
+                .map(|(name, (_, path, index))| (name, path, index))
+                .collect(),
+            marks,
+        }
+    }
+
+    /// Reads one selected copy with its own manifest and every manifest's
+    /// marks.
+    #[must_use]
+    pub fn read(&self, path: &Path, index: usize, knowledge: &Knowledge, now: i64) -> Run {
+        let manifest = self.manifests.get(index).and_then(Option::as_ref);
+        let mut run = read(path, knowledge, manifest, now);
+        apply_marks(&mut run, &self.marks);
+        run
+    }
+}
