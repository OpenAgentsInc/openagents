+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_new_folder_changes_the_listing_though_its_chat_goes_unreported() {
+        // Routed without a platform watch, so only the events below arrive.
+        let root = PathBuf::from("/nonexistent/coder-connect-watch-test");
+        let inbox = Arc::new(Inbox::default());
+        let id = routes()
+            .next
+            .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        lock(&routes().subscribers).insert(
+            id,
+            Subscriber {
+                roots: vec![(root.clone(), root.clone())],
+                inbox: Arc::downgrade(&inbox),
+            },
+        );
+        // inotify reports the folder, then misses the chat written into it
+        // before it watches the folder.
+        let day = root.join("sessions/2026/01/02");
+        deliver(&Event::new(EventKind::Create(CreateKind::Folder)).add_path(day));
+        assert_eq!(
+            inbox.take(),
+            Touched {
+                any: true,
+                listing: true
+            }
+        );
+        // A file that holds no chat still nudges nothing.
+        deliver(&Event::new(EventKind::Create(CreateKind::File)).add_path(root.join("notes.txt")));
+        assert_eq!(inbox.take(), Touched::default());
+        lock(&routes().subscribers).remove(&id);
+    }
+}
