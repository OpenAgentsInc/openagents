+#[cfg(test)]
+mod tests {
+    use super::*;
+    use notify::event::{AccessKind, DataChange};
+
+    /// A subscription's inbox under a fresh root, cleared of anything the
+    /// platform reported while it started.
+    fn subscribed() -> (tempfile::TempDir, Arc<Inbox>, Subscription) {
+        let root = tempfile::tempdir().unwrap();
+        let inbox = Arc::new(Inbox::default());
+        let subscription = subscribe(vec![root.path().to_path_buf()], &inbox);
+        (root, inbox, subscription)
+    }
+
+    fn event(kind: EventKind, path: &Path) -> Event {
+        Event::new(kind).add_path(path.to_path_buf())
+    }
+
+    #[test]
+    fn a_new_directory_changes_the_listing_even_when_its_chat_goes_unreported() {
+        let (root, inbox, _subscription) = subscribed();
+        let day = root.path().join("sessions/2026/01/02");
+        std::fs::create_dir_all(&day).unwrap();
+        let _ = inbox.take();
+        // inotify reports the folder, then misses a chat written into it
+        // before its watch on the folder starts.
+        deliver(&event(EventKind::Create(CreateKind::Folder), &day));
+        assert_eq!(
+            inbox.take(),
+            Touched {
+                any: true,
+                listing: true
+            }
+        );
+        // A platform that does not say what it created.
+        let other = root.path().join("sessions/2026/01/03");
+        std::fs::create_dir(&other).unwrap();
+        let _ = inbox.take();
+        deliver(&event(EventKind::Create(CreateKind::Any), &other));
+        assert!(inbox.take().listing);
+        deliver(&event(EventKind::Remove(RemoveKind::Folder), &other));
+        assert!(inbox.take().listing);
+    }
+
+    #[test]
+    fn files_that_hold_no_chat_change_nothing() {
+        let (root, inbox, _subscription) = subscribed();
+        let note = root.path().join("notes.txt");
+        std::fs::write(&note, b"x").unwrap();
+        let _ = inbox.take();
+        deliver(&event(EventKind::Create(CreateKind::File), &note));
+        deliver(&event(
+            EventKind::Modify(ModifyKind::Data(DataChange::Any)),
+            root.path(),
+        ));
+        deliver(&event(EventKind::Access(AccessKind::Any), root.path()));
+        assert_eq!(inbox.take(), Touched::default());
+    }
+}
