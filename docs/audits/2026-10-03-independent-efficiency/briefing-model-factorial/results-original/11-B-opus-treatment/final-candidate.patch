+/// Whether an event made, removed, or renamed a directory. A recursive
+/// watch on Linux (inotify) starts watching a new directory only after it
+/// reports it, so a chat written into the directory at once, as Codex does
+/// in a new day's folder, can go unreported. The directory's own event
+/// stands for what it holds: the chat list may have changed.
+fn directory(kind: &EventKind, path: &Path) -> bool {
+    match kind {
+        EventKind::Create(CreateKind::Folder) | EventKind::Remove(RemoveKind::Folder) => true,
+        EventKind::Create(_) | EventKind::Modify(ModifyKind::Name(_)) => path.is_dir(),
+        _ => false,
+    }
+}
