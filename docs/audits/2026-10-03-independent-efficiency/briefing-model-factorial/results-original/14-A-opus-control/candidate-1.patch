+#[cfg(test)]
+mod tests {
+    use super::*;
+    use notify::event::RenameMode;
+
+    /// Route events to one inbox without a platform watcher, so only the
+    /// events a test delivers reach it.
+    fn routed(root: &Path) -> (u64, Arc<Inbox>) {
+        let inbox = Arc::new(Inbox::default());
+        let id = routes()
+            .next
+            .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        lock(&routes().subscribers).insert(
+            id,
+            Subscriber {
+                roots: vec![(root.to_path_buf(), root.canonicalize().unwrap())],
+                inbox: Arc::downgrade(&inbox),
+            },
+        );
+        (id, inbox)
+    }
+
+    #[test]
+    fn a_directory_arriving_under_a_root_changes_the_list() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().canonicalize().unwrap();
+        let day = root.join("sessions/2026/01/02");
+        std::fs::create_dir_all(&day).unwrap();
+        let moved = root.join("moved");
+        std::fs::create_dir_all(&moved).unwrap();
+        let (id, inbox) = routed(&root);
+        // inotify adds a new directory's watch only after reporting it, so a
+        // chat written in it at once is never reported: the folder must count.
+        deliver(&Event::new(EventKind::Create(CreateKind::Folder)).add_path(day.clone()));
+        assert_eq!(
+            inbox.take(),
+            Touched {
+                any: true,
+                listing: true
+            }
+        );
+        // A platform that cannot say what it created, or a directory renamed
+        // in, counts by what the path is now.
+        deliver(&Event::new(EventKind::Create(CreateKind::Any)).add_path(day));
+        assert!(inbox.take().listing);
+        deliver(&Event::new(EventKind::Modify(ModifyKind::Name(RenameMode::To))).add_path(moved));
+        assert!(inbox.take().listing);
+        // The root itself, and a file that is no chat, change nothing.
+        deliver(&Event::new(EventKind::Create(CreateKind::Folder)).add_path(root.clone()));
+        let other = root.join("notes.txt");
+        std::fs::write(&other, b"x").unwrap();
+        deliver(&Event::new(EventKind::Create(CreateKind::Any)).add_path(other));
+        assert_eq!(inbox.take(), Touched::default());
+        lock(&routes().subscribers).remove(&id);
+    }
+}
