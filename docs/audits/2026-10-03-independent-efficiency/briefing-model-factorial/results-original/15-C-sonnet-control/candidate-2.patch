+/// Whether an event created, moved in, or removed a folder, which may hold
+/// chat files the platform never reports one by one.
+fn new_folder(event: &Event, path: &Path) -> bool {
+    match event.kind {
+        EventKind::Create(notify::event::CreateKind::Folder)
+        | EventKind::Remove(notify::event::RemoveKind::Folder) => true,
+        EventKind::Create(_) | EventKind::Modify(ModifyKind::Name(_)) => path.is_dir(),
+        _ => false,
+    }
+}
