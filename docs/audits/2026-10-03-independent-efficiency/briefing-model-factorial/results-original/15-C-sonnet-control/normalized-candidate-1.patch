+#[cfg(test)]
+mod tests {
+    use super::*;
+    use notify::event::{CreateKind, RemoveKind};
+
+    #[test]
+    fn a_created_folder_counts_but_a_created_file_or_removed_folder_does_not() {
+        let path = Path::new("/history/sessions/2026/01/02");
+        let folder = Event::new(EventKind::Create(CreateKind::Folder));
+        assert!(new_folder(&folder, path));
+        let file = Event::new(EventKind::Create(CreateKind::File));
+        assert!(!new_folder(&file, Path::new("/history/notes.txt")));
+        let removed = Event::new(EventKind::Remove(RemoveKind::Folder));
+        assert!(!new_folder(&removed, path));
