+/// Whether an event created a folder, which may arrive holding chat files.
+fn new_folder(event: &Event, path: &Path) -> bool {
+    match event.kind {
+        EventKind::Create(notify::event::CreateKind::Folder) => true,
+        EventKind::Create(notify::event::CreateKind::Any | notify::event::CreateKind::Other) => {
+            path.is_dir()
+        }
+        _ => false,
+    }
+}
