+#[cfg(test)]
+mod tests {
+    use super::*;
+    use notify::event::{DataChange, RenameMode};
+
+    #[test]
+    fn a_new_folder_changes_the_list_even_when_its_chat_went_unreported() {
+        let root = tempfile::tempdir().unwrap();
+        let canonical = root.path().canonicalize().unwrap();
+        let inbox = Arc::new(Inbox::default());
+        // Routed without the platform watcher, so only these reports arrive.
+        let id = routes()
+            .next
+            .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        lock(&routes().subscribers).insert(
+            id,
+            Subscriber {
+                roots: vec![(root.path().to_path_buf(), canonical.clone())],
+                inbox: Arc::downgrade(&inbox),
+            },
+        );
+        let day = canonical.join("sessions/2026/01/02");
+        std::fs::create_dir_all(&day).unwrap();
+        // As inotify reports it: the folder alone, not the chat written into it.
+        deliver(&Event::new(EventKind::Create(CreateKind::Folder)).add_path(day.clone()));
+        assert!(inbox.take().listing);
+        // A folder the platform names only as created counts by looking.
+        deliver(&Event::new(EventKind::Create(CreateKind::Any)).add_path(day.clone()));
+        assert!(inbox.take().listing);
+        // A populated folder moved in reports itself and none of its chats.
+        deliver(
+            &Event::new(EventKind::Modify(ModifyKind::Name(RenameMode::To))).add_path(day.clone()),
+        );
+        assert!(inbox.take().listing);
+        // A folder moved away or removed takes its chats with it.
+        let gone = canonical.join("sessions/2026/01/03");
+        deliver(
+            &Event::new(EventKind::Modify(ModifyKind::Name(RenameMode::From)))
+                .add_path(gone.clone()),
+        );
+        assert!(inbox.take().listing);
+        deliver(&Event::new(EventKind::Remove(RemoveKind::Folder)).add_path(gone));
+        assert!(inbox.take().listing);
+        // An ordinary file renamed in does not.
+        let note = canonical.join("notes.txt");
+        std::fs::write(&note, b"note").unwrap();
+        deliver(&Event::new(EventKind::Modify(ModifyKind::Name(RenameMode::To))).add_path(note));
+        // A folder that changes otherwise, or one outside every root, does not.
+        deliver(
+            &Event::new(EventKind::Modify(ModifyKind::Data(DataChange::Any))).add_path(day.clone()),
+        );
+        let outside = tempfile::tempdir().unwrap();
+        deliver(
+            &Event::new(EventKind::Create(CreateKind::Folder)).add_path(outside.path().join("x")),
+        );
+        assert_eq!(inbox.take(), Touched::default());
+        lock(&routes().subscribers).remove(&id);
+    }
