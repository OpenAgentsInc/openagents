+/// Whether an event made a directory appear under a root. A recursive
+/// watcher that follows directories one by one, as inotify does, starts
+/// watching a new directory only after it reports it, so a chat file written
+/// into it at once, such as the first chat in a new Codex day folder, is
+/// never reported itself. The directory's arrival stands in for it.
+fn arrived_directory(kind: EventKind, path: &Path) -> bool {
+    match kind {
+        EventKind::Create(CreateKind::Folder) => true,
+        EventKind::Create(_) | EventKind::Modify(ModifyKind::Name(_)) => path.is_dir(),
+        _ => false,
+    }
+}
