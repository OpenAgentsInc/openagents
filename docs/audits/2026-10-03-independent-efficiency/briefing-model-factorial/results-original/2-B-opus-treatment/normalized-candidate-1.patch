+#[cfg(test)]
+mod tests {
+    use super::*;
+    use notify::event::DataChange;
+
+    /// Route a root to a fresh inbox without a platform watch, so only the
+    /// events a test delivers reach it.
+    fn routed(root: &Path) -> (u64, Arc<Inbox>) {
+        let inbox = Arc::new(Inbox::default());
+        let id = routes()
+            .next
+            .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        lock(&routes().subscribers).insert(
+            id,
+            Subscriber {
+                roots: vec![(root.to_path_buf(), root.canonicalize().unwrap())],
+                inbox: Arc::downgrade(&inbox),
+            },
+        );
+        (id, inbox)
+    }
+
+    #[test]
+    fn a_directory_that_appears_under_a_root_changes_the_list() {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().join("sessions");
+        let day = root.join("2026/01/02");
+        std::fs::create_dir_all(&day).unwrap();
+        std::fs::write(root.join("notes.txt"), b"not a chat").unwrap();
+        let (id, inbox) = routed(&root);
+        let listing = Touched {
+            any: true,
+            listing: true,
+        };
+        // inotify names a new directory, then watches it too late to report
+        // the chat written into it.
+        deliver(&Event::new(EventKind::Create(CreateKind::Folder)).add_path(day.clone()));
+        assert_eq!(inbox.take(), listing);
+        // A platform that does not say what it created.
+        deliver(&Event::new(EventKind::Create(CreateKind::Any)).add_path(day.clone()));
+        assert_eq!(inbox.take(), listing);
+        // A directory moved in.
+        deliver(
+            &Event::new(EventKind::Modify(ModifyKind::Name(
+                notify::event::RenameMode::To,
+            )))
+            .add_path(day.clone()),
+        );
+        assert_eq!(inbox.take(), listing);
+        // Neither another file nor a directory's own change counts.
+        deliver(&Event::new(EventKind::Create(CreateKind::File)).add_path(root.join("notes.txt")));
+        deliver(
+            &Event::new(EventKind::Modify(ModifyKind::Data(DataChange::Any))).add_path(day.clone()),
+        );
+        assert_eq!(inbox.take(), Touched::default());
+        // Outside the root, nothing.
+        let elsewhere = temp.path().join("elsewhere");
+        std::fs::create_dir_all(&elsewhere).unwrap();
+        deliver(&Event::new(EventKind::Create(CreateKind::Folder)).add_path(elsewhere));
+        assert_eq!(inbox.take(), Touched::default());
+        lock(&routes().subscribers).remove(&id);
+    }
+}
