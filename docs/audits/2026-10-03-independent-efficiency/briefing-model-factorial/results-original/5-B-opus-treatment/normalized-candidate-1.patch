+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_new_folder_under_a_root_changes_the_listing() {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        let inbox = Arc::new(Inbox::default());
+        let _subscription = subscribe(vec![root.clone()], &inbox);
+        // Only synthetic events: nothing on disk changes, so the platform
+        // watcher reports nothing of its own.
+        let event = |kind, path: PathBuf| Event::new(kind).add_path(path);
+        deliver(&event(
+            EventKind::Create(CreateKind::File),
+            root.join("notes.txt"),
+        ));
+        assert_eq!(inbox.take(), Touched::default());
+        deliver(&event(
+            EventKind::Create(CreateKind::Folder),
+            root.join("sessions/2026/01/02"),
+        ));
+        assert_eq!(
+            inbox.take(),
+            Touched {
+                any: true,
+                listing: true
+            }
+        );
+        // A folder outside every root nudges nobody.
+        let elsewhere = tempfile::tempdir().unwrap();
+        deliver(&event(
+            EventKind::Create(CreateKind::Folder),
+            elsewhere.path().canonicalize().unwrap().join("day"),
+        ));
+        assert_eq!(inbox.take(), Touched::default());
+    }
+}
