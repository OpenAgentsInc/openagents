 #[tokio::test]
+async fn a_new_nested_folder_that_already_holds_a_chat_nudges_the_catalog() {
+    let f = Fixture::new("wss://relay.example/");
+    let address = listener(Arc::new(f.host())).await;
+    let client = Arc::new(f.client());
+    client.set_direct(Some(address));
+    let mut changes = client.changes();
+    client
+        .observe(Query::Catalog(CatalogRequest::default()))
+        .await
+        .unwrap();
+    // The chat is written before any watch could exist inside its new
+    // folders, so only the folder's creation can announce it.
+    let staging = f.root.parent().unwrap().join("staging-month");
+    let day = staging.join("02");
+    std::fs::create_dir_all(&day).unwrap();
+    std::fs::write(
+        day.join("three.jsonl"),
+        b"{\"type\":\"session_meta\",\"payload\":{\"id\":\"third-chat\"}}\n",
+    )
+    .unwrap();
+    std::fs::rename(&staging, f.root.join("sessions/2026/02")).unwrap();
+    let change = tokio::time::timeout(std::time::Duration::from_secs(4), changes.recv())
+        .await
+        .expect("a nudge")
+        .unwrap();
+    assert_eq!(change, Change::Catalog);
+}
