+#[cfg(test)]
+mod tests {
+    use super::*;
+    use notify::event::RenameMode;
+
+    #[test]
+    fn a_new_folder_under_a_root_changes_the_list() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().join("sessions");
+        let moved = root.join("2026/01/03");
+        std::fs::create_dir_all(&moved).unwrap();
+        let root = root.canonicalize().unwrap();
+        let inbox = Arc::new(Inbox::default());
+        let _subscription = subscribe(vec![root.clone()], &inbox);
+        inbox.take();
+        // A file that is neither a chat nor the archive changes nothing.
+        deliver(&Event::new(EventKind::Create(CreateKind::File)).add_path(root.join("notes.txt")));
+        assert_eq!(inbox.take(), Touched::default());
+        // Inotify watches a new folder only after reporting it, so a chat
+        // written into it at once goes unreported: the folder itself counts.
+        deliver(
+            &Event::new(EventKind::Create(CreateKind::Folder)).add_path(root.join("2026/01/02")),
+        );
+        let changed = Touched {
+            any: true,
+            listing: true,
+        };
+        assert_eq!(inbox.take(), changed);
+        // So does a folder moved in under the root.
+        deliver(
+            &Event::new(EventKind::Modify(ModifyKind::Name(RenameMode::To)))
+                .add_path(moved.canonicalize().unwrap()),
+        );
+        assert_eq!(inbox.take(), changed);
+    }
+}
