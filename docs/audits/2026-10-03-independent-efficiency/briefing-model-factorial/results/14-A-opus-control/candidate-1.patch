+
+/// Whether an event says a directory appeared under a root, by creation or
+/// by a rename into place. A platform that watches recursively by adding a
+/// watch to each new directory (inotify on Linux) can miss a chat file
+/// written into it before that watch exists, so a new directory counts as a
+/// change to the chat list.
+fn arrived(kind: EventKind, path: &Path) -> bool {
+    match kind {
+        EventKind::Create(CreateKind::Folder) => true,
+        EventKind::Create(_) | EventKind::Modify(ModifyKind::Name(_)) => path.is_dir(),
+        _ => false,
+    }
+}
+
+/// Mark the inbox of each connection whose roots hold `path`.
+fn touch(routes: &Routes, path: &Path, listing: bool) {
+    for subscriber in lock(&routes.subscribers).values() {
+        if subscriber
+            .roots
+            .iter()
+            .any(|(given, canonical)| path.starts_with(canonical) || path.starts_with(given))
+            && let Some(inbox) = subscriber.inbox.upgrade()
+        {
+            inbox.touch(listing);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_new_directory_under_a_root_changes_the_listing() {
+        let root = tempfile::tempdir().unwrap();
+        let inbox = Arc::new(Inbox::default());
+        let _subscription = subscribe(vec![root.path().to_path_buf()], &inbox);
+        let canonical = root.path().canonicalize().unwrap();
+        // The directory's own events, as inotify reports them before it
+        // watches the directory; the chat file's events never arrive.
+        let folder = canonical.join("sessions/2026/01/02");
+        deliver(&Event::new(EventKind::Create(CreateKind::Folder)).add_path(folder));
+        assert_eq!(
+            inbox.take(),
+            Touched {
+                any: true,
+                listing: true
+            }
+        );
+        // A directory elsewhere touches nothing.
+        let elsewhere = tempfile::tempdir().unwrap();
+        deliver(
+            &Event::new(EventKind::Create(CreateKind::Folder))
+                .add_path(elsewhere.path().canonicalize().unwrap().join("day")),
+        );
+        assert_eq!(inbox.take(), Touched::default());
+    }
+
+    #[test]
+    fn a_directory_renamed_into_a_root_changes_the_listing() {
+        let root = tempfile::tempdir().unwrap();
+        let inbox = Arc::new(Inbox::default());
+        let _subscription = subscribe(vec![root.path().to_path_buf()], &inbox);
+        let canonical = root.path().canonicalize().unwrap();
+        let moved = canonical.join("moved");
+        std::fs::create_dir(&moved).unwrap();
+        let _ = inbox.take();
+        deliver(
+            &Event::new(EventKind::Modify(ModifyKind::Name(
+                notify::event::RenameMode::To,
+            )))
+            .add_path(moved),
+        );
+        assert!(inbox.take().listing);
+    }
+}
