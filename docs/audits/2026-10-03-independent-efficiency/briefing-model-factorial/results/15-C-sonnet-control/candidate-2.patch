+/// Whether `path` is a folder that a create or rename event brought in.
+fn arrived_folder(event: &Event, path: &Path) -> bool {
+    match event.kind {
+        EventKind::Create(CreateKind::Folder) => true,
+        EventKind::Create(_) | EventKind::Modify(ModifyKind::Name(_)) => path.is_dir(),
+        _ => false,
+    }
