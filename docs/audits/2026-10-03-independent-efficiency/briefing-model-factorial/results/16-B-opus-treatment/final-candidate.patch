+#[cfg(test)]
+mod tests {
+    use super::*;
+    use notify::event::RenameMode;
+
+    #[test]
+    fn a_new_folder_under_a_root_changes_the_listing() {
+        // Routed without the platform watcher, so only these events arrive.
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().canonicalize().unwrap();
+        let inbox = Arc::new(Inbox::default());
+        let id = routes()
+            .next
+            .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        lock(&routes().subscribers).insert(
+            id,
+            Subscriber {
+                roots: vec![(root.clone(), root.clone())],
+                inbox: Arc::downgrade(&inbox),
+            },
+        );
+        // A folder outside every root changes nothing here.
+        let elsewhere = tempfile::tempdir().unwrap();
+        deliver(
+            &Event::new(EventKind::Create(CreateKind::Folder))
+                .add_path(elsewhere.path().join("2026")),
+        );
+        assert_eq!(inbox.take(), Touched::default());
+        // The platform reports a new day's folder, but not the chat written
+        // into it before the platform watched the folder.
+        let day = root.join("sessions/2026/01/02");
+        std::fs::create_dir_all(&day).unwrap();
+        deliver(&Event::new(EventKind::Create(CreateKind::Folder)).add_path(day.clone()));
+        assert_eq!(
+            inbox.take(),
+            Touched {
+                any: true,
+                listing: true
+            }
+        );
+        // A folder renamed into a root is new to the list as well.
+        deliver(&Event::new(EventKind::Modify(ModifyKind::Name(RenameMode::To))).add_path(day));
+        assert!(inbox.take().listing);
+        lock(&routes().subscribers).remove(&id);
+    }
