 #[test]
+fn ignored_user_files_keep_a_worktree_but_build_outputs_do_not() {
+    let home = Home::new();
+    let (repo, trees) = repo(&home, &["secret", "built"]);
+    let [secret, built] = [&trees[0], &trees[1]];
+    let excludes = home.layout.home.join("src/excludes");
+    std::fs::write(&excludes, ".env\nprivate/\ntarget/\n").unwrap();
+    git(&repo, &["config", "core.excludesFile", excludes.to_str().unwrap()]);
+    std::fs::write(secret.join(".env"), "TOKEN=local").unwrap();
+    std::fs::create_dir_all(secret.join("private")).unwrap();
+    std::fs::write(secret.join("private/data"), "mine").unwrap();
+    std::fs::create_dir_all(built.join("target/debug")).unwrap();
+    std::fs::write(built.join("target/debug/out"), "rebuilds").unwrap();
+    assert!(git(secret, &["status", "--porcelain", "--untracked-files=all"]).is_empty());
+    let facts = home.facts();
+    let volumes = low();
+    let env = env(&home, &facts, &volumes, &Idle);
+    let report = run::run(&env, &disk(), Cause::Manual, false, true).unwrap();
+    assert!(secret.join(".env").exists());
+    assert!(secret.join("private/data").exists());
+    assert!(!built.exists());
+    let reasons: Vec<String> = report
+        .plan
+        .kept
+        .iter()
+        .map(|kept| kept.why.clone())
+        .collect();
+    assert!(
+        reasons
+            .iter()
+            .any(|why| why == "holds ignored files: .env, private/"),
+        "{reasons:?}"
+    );
+}
