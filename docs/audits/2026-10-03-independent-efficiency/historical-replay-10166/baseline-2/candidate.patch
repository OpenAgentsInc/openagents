+/// Build output folder names an ignored path may sit in and still be
+/// disposable: they rebuild.
+const DISPOSABLE_DIRS: [&str; 2] = ["target", "node_modules"];
+
+/// Whether an ignored path from `git ls-files --directory` is a disposable
+/// build output: it is inside (or is) a folder named in `DISPOSABLE_DIRS`
+/// or starting with `.cargo-target`, or it is a Finder `.DS_Store`.
+fn disposable(entry: &str) -> bool {
+    let dir = entry.ends_with('/');
+    let parts: Vec<&str> = entry.trim_end_matches('/').split('/').collect();
+    let Some((last, parents)) = parts.split_last() else {
+        return false;
+    };
+    if !dir && *last == ".DS_Store" {
+        return true;
+    }
+    let folders = if dir { &parts[..] } else { parents };
+    folders.iter().any(|name| build_dir(name))
+}
+
+fn build_dir(name: &str) -> bool {
+    DISPOSABLE_DIRS.contains(&name) || name.starts_with(".cargo-target")
+}
+
+/// The ignored paths in the worktree at `path` that are not disposable
+/// build outputs, an ignored folder listed once as `folder/`.
+fn ignored_files(path: &Path) -> Result<Vec<String>, String> {
+    let listed = git(
+        path,
+        &[
+            "ls-files",
+            "-z",
+            "--others",
+            "--ignored",
+            "--exclude-standard",
+            "--directory",
+        ],
+    )?;
+    Ok(listed
+        .split('\0')
+        .filter(|entry| !entry.is_empty() && !disposable(entry))
+        .map(str::to_owned)
+        .collect())
+}
