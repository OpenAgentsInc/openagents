 #[test]
+fn ignored_user_files_keep_a_worktree_and_an_ignored_target_alone_does_not() {
+    let home = Home::new();
+    let (repo, trees) = repo(&home, &["secret", "built"]);
+    let [secret, built] = [&trees[0], &trees[1]];
+    std::fs::create_dir_all(repo.join(".git/info")).unwrap();
+    std::fs::write(repo.join(".git/info/exclude"), ".env\n/private/\n/target/\n").unwrap();
+    std::fs::write(secret.join(".env"), "TOKEN=local").unwrap();
+    std::fs::create_dir_all(secret.join("private")).unwrap();
+    std::fs::write(secret.join("private/data"), "mine").unwrap();
+    target(&built.join("target"), 10);
+    let facts = home.facts();
+    let volumes = low();
+    let env = env(&home, &facts, &volumes, &Idle);
+    let dry = run::run(&env, &disk(), Cause::Manual, true, true).unwrap();
+    let why = dry.plan.kept.iter().find(|kept| kept.path == *secret);
+    assert_eq!(
+        why.map(|kept| kept.why.as_str()),
+        Some("holds ignored files: .env, private/")
+    );
+    run::run(&env, &disk(), Cause::Manual, false, true).unwrap();
+    assert_eq!(std::fs::read_to_string(secret.join(".env")).unwrap(), "TOKEN=local");
+    assert!(secret.join("private/data").exists());
+    assert!(!built.exists());
+}
