+/// Folder names whose contents a build or package manager regenerates.
+const DISPOSABLE_DIRS: &[&str] = &["target", "node_modules", "__pycache__"];
+
+/// Whether an ignored entry `git ls-files` listed (a folder ends in `/`)
+/// is, or lies inside, a disposable cache: a folder named in
+/// [`DISPOSABLE_DIRS`] or starting with `.cargo-target`, or a `.DS_Store`.
+fn disposable(entry: &str) -> bool {
+    let is_dir = entry.ends_with('/');
+    let parts: Vec<&str> = entry.trim_end_matches('/').split('/').collect();
+    let dirs = if is_dir {
+        &parts[..]
+    } else {
+        &parts[..parts.len().saturating_sub(1)]
+    };
+    let cache = |name: &&str| DISPOSABLE_DIRS.contains(name) || name.starts_with(".cargo-target");
+    dirs.iter().any(cache) || parts.last() == Some(&".DS_Store")
+}
+
+/// The ignored files and folders in the worktree at `path` that are not
+/// disposable caches, sorted. `git worktree remove` deletes ignored files
+/// without `--force`, and undo cannot bring them back.
+///
+/// # Errors
+/// Git failed.
+pub fn ignored_files(path: &Path) -> Result<Vec<String>, String> {
+    let listed = git(
+        path,
+        &[
+            "ls-files",
+            "-z",
+            "--others",
+            "--ignored",
+            "--exclude-standard",
+            "--directory",
+            "--no-empty-directory",
+        ],
+    )?;
+    let mut found: Vec<String> = listed
+        .split('\0')
+        .filter(|entry| !entry.is_empty() && !disposable(entry))
+        .map(str::to_owned)
+        .collect();
+    found.sort();
+    Ok(found)
+}
