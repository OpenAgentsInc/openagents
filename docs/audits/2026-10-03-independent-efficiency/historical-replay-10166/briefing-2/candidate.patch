 #[test]
+fn ignored_user_files_keep_a_worktree_and_ignored_build_output_does_not() {
+    let home = Home::new();
+    let (repo, trees) = repo(&home, &["secret", "built"]);
+    let [secret, built] = [&trees[0], &trees[1]];
+    let info = repo.join(".git/info");
+    std::fs::create_dir_all(&info).unwrap();
+    std::fs::write(info.join("exclude"), ".env\n/private/\ntarget/\n").unwrap();
+    std::fs::write(secret.join(".env"), "TOKEN=1").unwrap();
+    std::fs::create_dir_all(secret.join("private")).unwrap();
+    std::fs::write(secret.join("private/data"), "mine").unwrap();
+    target(&built.join("target"), 10);
+    assert_eq!(git(secret, &["status", "--porcelain"]), "");
+    let facts = home.facts();
+    let volumes = low();
+    let env = env(&home, &facts, &volumes, &Idle);
+    let dry = run::run(&env, &disk(), Cause::Manual, true, true).unwrap();
+    let reasons: Vec<String> = dry.plan.kept.iter().map(|kept| kept.why.clone()).collect();
+    assert!(
+        reasons
+            .iter()
+            .any(|why| why == "holds ignored files: .env, private/"),
+        "{reasons:?}"
+    );
+    run::run(&env, &disk(), Cause::Manual, false, true).unwrap();
+    let read = |name: &str| std::fs::read_to_string(secret.join(name)).unwrap();
+    assert_eq!(read(".env"), "TOKEN=1");
+    assert_eq!(read("private/data"), "mine");
+    assert!(!built.exists());
+}
