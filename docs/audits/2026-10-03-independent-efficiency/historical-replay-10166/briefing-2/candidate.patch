+/// Whether an ignored path a worktree holds is a cache that rebuilds: it is
+/// in a `target/`, `node_modules/`, or `.cargo-target*` directory.
+fn disposable(entry: &str) -> bool {
+    let dir = entry.ends_with('/');
+    let parts: Vec<&str> = entry.split('/').filter(|part| !part.is_empty()).collect();
+    let dirs = if dir {
+        &parts[..]
+    } else {
+        &parts[..parts.len().saturating_sub(1)]
+    };
+    dirs.iter().any(|part| cache(part))
+}
+
+fn cache(dir: &str) -> bool {
+    dir == "target" || dir == "node_modules" || dir.starts_with(".cargo-target")
+}
+
+/// The ignored paths in the worktree at `path` that are not disposable
+/// caches: what `git worktree remove` would delete and undo cannot bring
+/// back. A wholly ignored directory is one entry ending in `/`.
+fn ignored_files(path: &Path) -> Result<Vec<String>, String> {
+    let listed = git(
+        path,
+        &[
+            "ls-files",
+            "-z",
+            "--others",
+            "--ignored",
+            "--exclude-standard",
+            "--directory",
+        ],
+    )?;
+    Ok(listed
+        .split('\0')
+        .filter(|entry| !entry.is_empty() && !disposable(entry))
+        .map(str::to_owned)
+        .collect())
+}
