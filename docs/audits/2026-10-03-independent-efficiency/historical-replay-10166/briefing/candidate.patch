 #[test]
+fn ignored_user_files_keep_a_worktree_and_build_outputs_do_not() {
+    let home = Home::new();
+    let (repo, trees) = repo(&home, &["secret", "built"]);
+    let [secret, built] = [&trees[0], &trees[1]];
+    // The repository's exclude file applies to every worktree.
+    std::fs::create_dir_all(repo.join(".git/info")).unwrap();
+    std::fs::write(
+        repo.join(".git/info/exclude"),
+        "/target\n/node_modules\n.env\n/private\n",
+    )
+    .unwrap();
+    std::fs::write(secret.join(".env"), "TOKEN=x").unwrap();
+    std::fs::create_dir_all(secret.join("private")).unwrap();
+    std::fs::write(secret.join("private/data"), "mine").unwrap();
+    std::fs::create_dir_all(secret.join("target/debug")).unwrap();
+    std::fs::write(secret.join("target/debug/out"), "built").unwrap();
+    std::fs::create_dir_all(built.join("target/debug")).unwrap();
+    std::fs::write(built.join("target/debug/out"), "built").unwrap();
+    std::fs::create_dir_all(built.join("node_modules/x")).unwrap();
+    std::fs::write(built.join("node_modules/x/index.js"), "").unwrap();
+    let facts = home.facts();
+    let volumes = low();
+    let env = env(&home, &facts, &volumes, &Idle);
+    let dry = run::run(&env, &disk(), Cause::Manual, true, true).unwrap();
+    let why = dry
+        .plan
+        .kept
+        .iter()
+        .find(|kept| kept.path.ends_with("secret"))
+        .map(|kept| kept.why.clone())
+        .expect("the worktree with ignored files is kept");
+    assert!(why.starts_with("holds ignored files: "), "{why}");
+    assert!(why.contains(".env") && why.contains("private/"), "{why}");
+    assert!(!why.contains("target"), "{why}");
+    run::run(&env, &disk(), Cause::Manual, false, true).unwrap();
+    assert_eq!(std::fs::read_to_string(secret.join(".env")).unwrap(), "TOKEN=x");
+    assert!(secret.join("private/data").exists());
+    assert!(!built.exists());
+}
