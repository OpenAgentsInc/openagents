+/// Names of ignored paths a worktree may hold and still be removed: build
+/// outputs and caches that rebuild. A name ending in `*` matches by prefix.
+const DISPOSABLE: &[&str] = &[
+    "target",
+    "node_modules",
+    ".cargo-target*",
+    "__pycache__",
+    ".DS_Store",
+];
+
+fn disposable(relative: &str) -> bool {
+    relative.split('/').any(|part| {
+        DISPOSABLE.iter().any(|name| match name.strip_suffix('*') {
+            Some(prefix) => part.starts_with(prefix),
+            None => part == *name,
+        })
+    })
+}
+
+/// The ignored paths in the worktree at `path` that are not build outputs
+/// ([`DISPOSABLE`]): local data such as `.env` that `git status` does not
+/// show and `git worktree remove` would delete. A wholly ignored directory
+/// is one entry, ending in `/`.
+fn ignored_data(path: &Path) -> Result<Vec<String>, String> {
+    let listed = git(
+        path,
+        &[
+            "ls-files",
+            "-z",
+            "--others",
+            "--ignored",
+            "--exclude-standard",
+            "--directory",
+        ],
+    )?;
+    Ok(listed
+        .split('\0')
+        .filter(|entry| !entry.is_empty() && !disposable(entry))
+        .map(str::to_owned)
+        .collect())
+}
