-/// Every run in `dirs`, the first directory's copy of a run winning.
+/// One copy of every run in a list of directories, chosen the same way
+/// whatever order the directories come in.
+///
+/// Copies share a run's directory name, which is its identity
+/// (`microcoder/<run directory>`). The copy a manifest names wins, then a
+/// copy in a directory with a manifest, then any other copy; a tie goes to
+/// the directory whose path sorts first. Every manifest's commit
+/// attributions and mixed marks apply to the chosen copy, wherever it was
+/// read from.
+#[derive(Clone, Debug, Default)]
+pub struct Copies {
+    manifests: Vec<Option<Manifest>>,
+    marks: Manifest,
+    /// Each run's name and the directory of its chosen copy, by name.
+    pub runs: Vec<(String, PathBuf)>,
+    /// For each run, the index in `dirs` of the directory it was read from.
+    from: Vec<usize>,
+}
+
+impl Copies {
+    /// Lists the run directories in `dirs` and chooses one copy of each.
+    #[must_use]
+    pub fn find(dirs: &[PathBuf]) -> Self {
+        let manifests: Vec<Option<Manifest>> = dirs.iter().map(|dir| Manifest::read(dir)).collect();
+        // Path order, so that a conflict resolves the same way every time.
+        let mut order: Vec<usize> = (0..dirs.len()).collect();
+        order.sort_by(|&a, &b| dirs[a].cmp(&dirs[b]).then(a.cmp(&b)));
+        let mut marks = Manifest::default();
+        for manifest in order.iter().filter_map(|&i| manifests[i].as_ref()) {
+            for (name, commit) in &manifest.commits {
+                marks
+                    .commits
+                    .entry(name.clone())
+                    .or_insert_with(|| commit.clone());
+            }
+            for (name, why) in &manifest.mixed {
+                marks
+                    .mixed
+                    .entry(name.clone())
+                    .or_insert_with(|| why.clone());
+            }
+        }
+        let mut chosen: BTreeMap<String, (u8, usize, PathBuf)> = BTreeMap::new();
+        for &i in &order {
+            for run_dir in run_dirs(&dirs[i]) {
+                let name = run_dir
+                    .file_name()
+                    .map(|n| n.to_string_lossy().into_owned())
+                    .unwrap_or_default();
+                let rank = match &manifests[i] {
+                    Some(manifest) if manifest.files.contains_key(&name) => 0,
+                    Some(_) => 1,
+                    None => 2,
+                };
+                let better = chosen.get(&name).is_none_or(|(best, _, _)| rank < *best);
+                if better {
+                    chosen.insert(name, (rank, i, run_dir));
+                }
+            }
+        }
+        let mut runs = Vec::with_capacity(chosen.len());
+        let mut from = Vec::with_capacity(chosen.len());
+        for (name, (_, i, run_dir)) in chosen {
+            runs.push((name, run_dir));
+            from.push(i);
+        }
+        Copies {
+            manifests,
+            marks,
+            runs,
+            from,
+        }
+    }
+
+    /// Reads the run at `index` in [`Copies::runs`].
+    #[must_use]
+    pub fn read(&self, index: usize, knowledge: &Knowledge, now: i64) -> Run {
+        let manifest = self.manifests[self.from[index]].as_ref();
+        read_marked(
+            &self.runs[index].1,
+            knowledge,
+            manifest,
+            Some(&self.marks),
+            now,
+        )
+    }
+}
