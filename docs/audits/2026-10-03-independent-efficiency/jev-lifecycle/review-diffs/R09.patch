+/// The run directories to read across `dirs`, one per run name, and the
+/// manifests that describe them.
+#[derive(Clone, Debug, Default)]
+pub struct Plan {
+    /// Each directory's manifest, in the order of `dirs`.
+    pub manifests: Vec<Option<Manifest>>,
+    /// Every manifest's marks together: the mixed notes and the commit
+    /// attributions, which apply to every copy of a run of that name.
+    pub marks: Manifest,
+    /// Each run directory to read, ordered by name, with the index in
+    /// `dirs` of the directory it was found in.
+    pub runs: Vec<(PathBuf, usize)>,
+}
+
+impl Plan {
+    /// Chooses one copy of each run in `dirs`, so the result doesn't depend
+    /// on their order: a copy its own directory's manifest lists wins, then
+    /// a copy in any retained host directory, then the first copy found.
+    #[must_use]
+    pub fn new(dirs: &[PathBuf]) -> Self {
+        let manifests: Vec<Option<Manifest>> = dirs.iter().map(|dir| Manifest::read(dir)).collect();
+        // Marks are merged by directory path, so a conflict between two
+        // manifests resolves the same way whatever order the flags came in.
+        let mut by_path: Vec<usize> = (0..dirs.len()).collect();
+        by_path.sort_by(|a, b| dirs[*a].cmp(&dirs[*b]));
+        let mut marks = Manifest::default();
+        for manifest in by_path.iter().filter_map(|i| manifests[*i].as_ref()) {
+            for (name, commit) in &manifest.commits {
+                marks
+                    .commits
+                    .entry(name.clone())
+                    .or_insert_with(|| commit.clone());
+            }
+            for (name, why) in &manifest.mixed {
+                marks
+                    .mixed
+                    .entry(name.clone())
+                    .or_insert_with(|| why.clone());
+            }
+        }
+        let mut chosen: BTreeMap<String, (PathBuf, usize, u8)> = BTreeMap::new();
+        for (index, dir) in dirs.iter().enumerate() {
+            let manifest = manifests[index].as_ref();
+            for run_dir in run_dirs(dir) {
+                let name = run_dir
+                    .file_name()
+                    .map(|n| n.to_string_lossy().into_owned())
+                    .unwrap_or_default();
+                let rank = match manifest {
+                    Some(m) if m.files.contains_key(&name) => 2,
+                    Some(_) => 1,
+                    None => 0,
+                };
+                if chosen.get(&name).is_none_or(|(_, _, held)| *held < rank) {
+                    chosen.insert(name, (run_dir, index, rank));
+                }
+            }
+        }
+        Plan {
+            manifests,
+            marks,
+            runs: chosen
+                .into_values()
+                .map(|(run_dir, index, _)| (run_dir, index))
+                .collect(),
+        }
+    }
+}
