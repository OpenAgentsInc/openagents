{
  "$id": "https://openagents.com/schemas/cad/assembly.v1.json",
  "additionalProperties": false,
  "properties": {
    "assemblies": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "contacts": {
            "type": "array"
          },
          "instances": {
            "type": "array"
          },
          "joints": {
            "type": "array"
          },
          "note": {
            "type": "string"
          },
          "source": {
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "instances"
        ],
        "type": "object"
      },
      "description": "subassembly templates by id; an instance with assembly places a copy, its instances named by path (copy.inner)",
      "type": "object"
    },
    "contacts": {
      "items": {
        "items": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}(\\.[a-z][a-z0-9_-]{0,47})*$",
          "type": "string"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,47}$",
      "type": "string"
    },
    "instances": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assembly": {
            "pattern": "^[a-z][a-z0-9_-]{0,47}$",
            "type": "string"
          },
          "at": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "group": {
            "pattern": "^[a-z][a-z0-9_-]{0,47}$",
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_-]{0,47}(\\.[a-z][a-z0-9_-]{0,47})*$",
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "parent": {
            "pattern": "^[a-z][a-z0-9_-]{0,47}(\\.[a-z][a-z0-9_-]{0,47})*$",
            "type": "string"
          },
          "part": {
            "pattern": "^[a-z][a-z0-9_-]{0,47}$",
            "type": "string"
          },
          "pattern": {
            "description": "copies of this instance (id, id-2, id-3, ...): linear {count, step: [dx,dy,dz], count2?, step2?} or circular {count, axis, origin?, angle? (degrees between copies)}",
            "type": "object"
          },
          "rotate": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "joints": {
      "items": {
        "properties": {
          "axis": {
            "oneOf": [
              {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              {
                "description": "a mate: {face: name} or {edge: [face, face]} of the instance's part, flip?: true",
                "properties": {
                  "edge": {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                  },
                  "face": {
                    "type": "string"
                  },
                  "flip": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            ]
          },
          "child": {
            "pattern": "^[a-z][a-z0-9_-]{0,47}(\\.[a-z][a-z0-9_-]{0,47})*$",
            "type": "string"
          },
          "child_axis": {
            "oneOf": [
              {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              {
                "description": "a mate: {face: name} or {edge: [face, face]} of the instance's part, flip?: true",
                "properties": {
                  "edge": {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                  },
                  "face": {
                    "type": "string"
                  },
                  "flip": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            ]
          },
          "child_origin": {
            "oneOf": [
              {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              {
                "description": "a mate: {face: name} or {edge: [face, face]} of the instance's part, flip?: true",
                "properties": {
                  "edge": {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                  },
                  "face": {
                    "type": "string"
                  },
                  "flip": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            ]
          },
          "child_x_dir": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "closes": {
            "description": "closes a loop: holds parent and child (both already placed) together instead of placing the child; types fastened, revolute, slider, cylindrical, planar, spherical, parallel, or gear (a coupling: driven = ratio × driver)",
            "type": "boolean"
          },
          "drive": {
            "description": "this joint keeps its value and the other joints of its loops follow",
            "type": "boolean"
          },
          "driven": {
            "pattern": "^[a-z][a-z0-9_-]{0,47}(\\.[a-z][a-z0-9_-]{0,47})*$",
            "type": "string"
          },
          "driver": {
            "pattern": "^[a-z][a-z0-9_-]{0,47}(\\.[a-z][a-z0-9_-]{0,47})*$",
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_-]{0,47}(\\.[a-z][a-z0-9_-]{0,47})*$",
            "type": "string"
          },
          "limits": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "origin": {
            "oneOf": [
              {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              {
                "description": "a mate: {face: name} or {edge: [face, face]} of the instance's part, flip?: true",
                "properties": {
                  "edge": {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                  },
                  "face": {
                    "type": "string"
                  },
                  "flip": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            ]
          },
          "parent": {
            "pattern": "^[a-z][a-z0-9_-]{0,47}(\\.[a-z][a-z0-9_-]{0,47})*$",
            "type": "string"
          },
          "ratio": {
            "description": "gear: turns of the child per turn of the driver",
            "type": "number"
          },
          "type": {
            "enum": [
              "fastened",
              "revolute",
              "slider",
              "cylindrical",
              "planar",
              "spherical",
              "gear",
              "parallel"
            ]
          },
          "value": {
            "type": [
              "number",
              "array"
            ]
          },
          "x_dir": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "const": "assembly.v1"
    },
    "note": {
      "type": "string"
    },
    "parameters": {
      "items": {
        "properties": {
          "description": {
            "type": "string"
          },
          "expression": {
            "type": [
              "string",
              "number"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "expression"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "parts": {
      "additionalProperties": {
        "$ref": "part.v1.json"
      },
      "type": "object"
    },
    "title": {
      "type": "string"
    },
    "units": {
      "const": "mm"
    }
  },
  "required": [
    "kind",
    "id",
    "parts",
    "instances"
  ],
  "title": "assembly.v1: parts, their instances, joints and contacts",
  "type": "object"
}
