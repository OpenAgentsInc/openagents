r":366,"content":"      echo \"FAILED: environment preflight; fix the prerequisites above and rerun.\" >&2"},{"lineNumber":369,"content":"    record_phase preflight \"Environment preflight\" \"passed\" 0 0 1 \"$preflight_log\" \"environment preflight\""},{"lineNumber":372,"content":"  record_skip preflight \"not in --phases\""}]}],"totalLines":17,"totalMatchedLines":17,"headLimitApplied":30}}}}}}

