id: 1791473469464-0
event: tool_call
data: {"callId":"call-282a3e12-a31d-441f-875f-ce21ad5f870f-106\nfc_60b35d08-57e7-95d4-baa3-0618e7552664_1","name":"get_mcp_tools","status":"completed","args":{"server":"cursor-cloud","toolName":"list-environment-builds","toolCallId":"call-282a3e12-a31d-441f-875f-ce21ad5f870f-106\nfc_60b35d08-57e7-95d4-baa3-0618e7552664_1"},"result":{"success":{"content":"{\n  \"tool\": \"list-environment-builds\",\n  \"description\": \"List this run's environment builds — the prebuilt environment snapshots a cloud agent can boot from instead of running install from scratch — newest first, so build ids can be found for environment-build-logs. Pass environmentId (an environmentId from list-environments) to list another environment owned by this run's user or team instead, e.g. to pick a CreateAgent environment_build_id for a worker in that environment; environment-build-logs still reads only this run's own environment. Each entry carries buildId, status (IN_PROGRESS, SUCCEEDED, FAILED), failureType, source, triggerType, environmentVersionId, userFacingSnapshotId, createdAtMs, and completedAtMs. Filters: statuses, createdAfter, createdBefore. Paging: limit (default 25, max 100); when hasMore is true, pass the response's opaque nextCursor back as cursor to fetch the next (older) page. Builds exist only for environments that have environment builds enabled; a run with no linked environment returns an empty list.\",\n  \"inputSchema\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"environmentId\": {\n        \"type\": \"string\",\n        \"minLength\": 1,\n        \"maxLength\": 255,\n        \"description\": \"Environment public id (environmentId from list-environments) whose builds to list. Defaults to this run's environment. Only environments owned by this run's user or team are readable.\"\n      },\n      \"statuses\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"IN_PROGRESS\",\n            \"SUCCEEDED\",\n            \"FAILED\",\n            \"CANCELLED\",\n            \"SKIPPED\"\n          ]\n        },\n        \"maxItems\": 5,\n        \"description\": \"Filter by build outcome. One or more of: IN_PROGRESS, SUCCEEDED, FAILED, CANCELLED, SKIPPED.\"\n      },\n      \"createdAfter\": {\n        \"type\": \"string\",\n        \"description\": \"Only include builds created at or after this ISO-8601 UTC instant.\"\n      },\n      \"createdBefore\": {\n        \"type\": \"string\",\n        \"description\": \"Only include builds created strictly before this ISO-8601 UTC instant.\"\n      },\n      \"cursor\": {\n        \"type\": \"string\",\n        \"minLength\": 1,\n        \"description\": \"Opaque pagination cursor: pass the previous response's nextCursor to fetch the next (older) page.\"\n      },\n      \"limit\": {\n        \"type\": \"integer\",\n        \"minimum\": 1,\n        \"maximum\": 100,\n        \"description\": \"Max builds to return (default 25, max 100).\"\n      }\n    },\n    \"additionalProperties\": false,\n    \"$schema\": \"http://json-schema.org/draft-07/schema#\"\n  }\n}"}}}

