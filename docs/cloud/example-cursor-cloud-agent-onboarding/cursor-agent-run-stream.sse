data: {"type":"tool-call-completed","callId":"call-0283d004-c120-4603-a419-f7a866e61b3f-22\nfc_122d740f-575c-9786-84da-5b59723b3346_0","toolCall":{"type":"read","args":{"path":"/workspace/crates/openagents-cli/Cargo.toml"},"result":{"status":"success","value":{"content":"[package]\nname = \"openagents-cli\"\n# The CLI release version, shared with Coder and its bundled Microcoder.\n# The release scripts check this value before naming downloadable artifacts.\nversion = \"1.0.0-rc.5\"\nedition.workspace = true\nrust-version.workspace = true\npublish.workspace = true\ndescription = \"The openagents command: one program that reaches every OpenAgents surface an agent needs, over Nostr.\"\n\n[[bin]]\nname = \"openagents\"\npath = \"src/main.rs\"\n\n[dependencies]\ncoder-cloud = { path = \"../coder-cloud\" }\ncoder-new = { path = \"../coder-new\" }\nbrainstorm-client = { path = \"../brainstorm-client\" }\nreceipts = { path = \"../receipts\" }\nterminal-tty = { path = \"../terminal-tty\" }\nterminal-core = { path = \"../terminal-core\" }\ntenancy = { path = \"../tenancy\" }\naxum = \"0.8\"\ncoder-delegate = { path = \"../coder-delegate\" }\nacp-client = { path = \"../acp-client\" }\njsonschema = { version = \"0.33\", default-features = false }\nsupervise = { path = \"../supervise\" }\n# `openagents background`: the host's background rules (the disk monitor).\nbackground = { path = \"../background\" }\nbase64 = \"0.22\"\n# Human-readable amounts: BIP 177 base units, or legacy BTC.\nbitcoin-amount = { path = \"../bitcoin-amount\" }\n# `openagents boat run`: this checkout's change, built and tested on Boat.\nboat = { path = \"../boat\" }\ncoder = { path = \"../coder\" }\nroute-contract = { path = \"../route-contract\" }\ncoder-access = { path = \"../coder-access\", default-features = false }\ncoder-computers = { path = \"../coder-computers\" }\ncoder-connect = { path = \"../coder-connect\" }\n# `openagents connect`: the local control protocol and the connect code.\nopenagents-connect = { path = \"../openagents-connect\" }\n# `openagents chat`: the shared chat service, threads, and their ATIF export.\nopenagents-chat = { path = \"../openagents-chat\" }\n# `openagents terminal`: OpenAgents Terminal, the full-screen chat.\nopenagents-terminal = { path = \"../openagents-terminal\" }\n# `openagents terminal --computer`: another computer's threads over NIP-HOST.\nopenagents-chat-app = { path = \"../openagents-chat-app\" }\natif = { path = \"../atif\" }\ncoder-host = { path = \"../coder-host\" }\ncoder-link = { path = \"../coder-link\" }\n# `openagents lease`: the host resource broker's leases.\ncoder-lease = { path = \"../coder-lease\" }\ncoder-reach = { path = \"../coder-reach\" }\ncoder-service = { path = \"../coder-service\" }\ndiscovery = { path = \"../discovery\" }\n# `openagents ext eval`: the runner, the sandbox, the publish and check\n# builders, and the authoring interview (`ext eval init`).\next-eval = { path = \"../ext-eval\" }\nglam = \"0.30.10\"\ngym = { path = \"../gym\" }\ngym-bridge = { path = \"../gym-bridge\", default-features = false }\njev = { path = \"../jev\" }\njev-hosted = { path = \"../jev-hosted\" }\nknowledge = { path = \"../knowledge\" }\nlibc = \"0.2\"\nmicrocoder = { path = \"../microcoder\" }\n# BYOK: the person's own provider keys, tested over HTTPS and kept in the\n# keychain or 0600 files.\nmodel-access = { path = \"../model-access\", features = [\"http\", \"keychain\"] }\nnostr = { path = \"../nostr\" }\n# `openagents pylon`: NIP-PYLON beacons, free jobs, receipts, and pools.\npylon = { path = \"../pylon\" }\nopenagents-wallet = { path = \"../wallet\" }\n# Idempotency keys for wallet payments.\nuuid = { version = \"1\", features = [\"v4\"] }\n# The person's Spark wallet, the same as the phone's (`openagents wallet`).\nopenagents-spark = { path = \"../spark-wallet\" }\nopenagents-x402 = { path = \"../x402\" }\n# `openagents pay serve`: paid plugin invocations run a release's guest\n# (`/v1/plugins/{id}/invoke`), and settlements go to the ledger.\npay-ledger = { path = \"../pay-ledger\" }\nplugin = { path = \"../plugin\" }\n# The playtest triage inbox: reports, drafts, and the triage log.\nplaytest = { path = \"../playtest\" }\nreqwest = { version = \"0.12\", default-features = false, features = [\"blocking\", \"json\", \"rustls-tls\"] }\n# ES256 App Store Connect API tokens for `playtest testflight`.\nring = \"0.17\"\nsecp256k1 = { version = \"0.31.1\", features = [\"rand\"] }\n# The workshop agent's memory read from disk applies the secret screen.\nsecret-screen = { path = \"../secret-screen\" }\nserde = { version = \"1\", features = [\"derive\"] }\nserde_json = \"1\"\nsha2 = \"0.11.0\"\ntempfile = \"3\"\ntokio = { version = \"1\", features = [\"macros\", \"net\", \"rt-multi-thread\", \"signal\", \"sync\", \"time\"] }\n# `openagents pay serve --routes FILE`.\ntoml = \"0.9\"\nverse = { path = \"../verse\", default-features = false, features = [\"xp-host\", \"remote-chamber\", \"studio-host\"] }\nverse-engine = { path = \"../verse-engine\" }\nverse-world = { path = \"../verse-world\", features = [\"service-net\", \"service-reach\", \"studio\"] }\nrustls = { version = \"0.23\", default-features = false, features = [\"ring\", \"std\", \"tls12\"] }\nrcgen = { version = \"0.14\", default-features = false, features = [\"crypto\", \"ring\"] }\nverse-lagrange = { path = \"../verse-lagrange\" }\n# `openagents verse town`: Everglade's townsfolk definitions and roster.\ntownsfolk = { path = \"../townsfolk\" }\ntown-clock = { path = \"../town-clock\" }\nworld-tree = { path = \"../world-tree\" }\n\n# `openagents ssh` runs the system ssh through Unix process groups, and\n# `openagents labor`'s, `openagents pay commission`'s, and plugin purchases'\n# stores rest on Unix file modes; Windows builds without them.\n[target.'cfg(unix)'.dependencies]\ncommercial-accounts = { path = \"../commercial-accounts\", features = [\"merchant-commissions\"] }\ncommercial-spend = { path = \"../commercial-spend\" }\ncoder-labor = { path = \"../coder-labor\" }\ncoder-ssh = { path = \"../coder-ssh\" }\n\n# Owner-only sales inputs on Windows, where there are no modes.\n[target.'cfg(windows)'.dependencies]\nprivate-fs = { path = \"../private-fs\" }\n\n[target.'cfg(unix)'.dependencies.coder-project]\npath = \"../coder-project\"\n\n[dev-dependencies]\ncommercial-accounts = { path = \"../commercial-accounts\" }\nhex = \"0.4\"\nreceipts = { path = \"../receipts\" }\n# `tests/chat.rs` runs a local NIP-42 relay with a scripted chat worker.\nfutures-util = \"0.3\"\ntokio-tungstenite = \"0.30\"\nnostr = { path = \"../nostr\", features = [\"test-invoice\"] }\n# `tests/ext_eval.rs` publishes to and checks against a local relay.\nnostr-relay = { path = \"../nostr-relay\" }\ntempfile = \"3\"\n# `tests/terminal.rs` reads OpenAgents Terminal's screen in a\n# pseudo-terminal with the emulator the phone's terminal uses.\ncoder-vt = { path = \"../coder-vt\" }\n\n[lints]\nworkspace = true\n","totalLines":142,"fileSize":6336}}},"modelCallId":"b21cd8fc-e789-4fcd-8956-616a859ead7e-40-k1br"}

