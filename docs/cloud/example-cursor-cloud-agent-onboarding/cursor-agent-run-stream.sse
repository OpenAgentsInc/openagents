id: 1791472526778-0
event: tool_call
data: {"callId":"call-c2beba95-b511-4340-aa60-19013b6c1e35-45\nfc_244b1f4e-5de8-9d10-8271-9783d4105ff0_2","name":"read_file","status":"completed","args":{"path":"/workspace/crates/nostr/Cargo.toml","limit":40},"result":{"success":{"content":"[package]\nname = \"nostr\"\nversion.workspace = true\nedition.workspace = true\nrust-version.workspace = true\ndescription = \"Pure Nostr protocol and verification primitives\"\npublish.workspace = true\n\n[lib]\npath = \"src/lib.rs\"\n\n[features]\ndefault = []\n# The relay enables `server` for the signer internals it needs.\nserver = []\n# Test-only BOLT11 signing for crates that exercise settlement end to end.\ntest-invoice = []\n\n# Dependency allowlist carried over from immortal-core: secp256k1, sha2,\n# serde, serde_json. `ryu-js` renders finite numbers with the ECMAScript\n# algorithm RFC 8785 requires. The ordinary `ryu` form disagrees with\n# `JSON.stringify` on published JCS vectors.\n[dependencies]\nryu-js = \"1.0.2\"\nsecp256k1 = { version = \"0.31.1\", features = [\"recovery\"] }\nserde = { version = \"1.0.229\", features = [\"derive\"] }\nserde_json = \"1.0.151\"\nsha2 = \"0.11.0\"\n\n[lints]\nworkspace = true\n\n# Test-only oracles for the hand-written NIP-44 primitives and the property\n# tests. Read docs/nostr/crypto-primitives.md before promoting one of these to\n# a runtime dependency.\n[dev-dependencies]\nchacha20 = \"0.10.2\"\nhkdf = \"0.13.0\"\nhmac = \"0.13.0\"\nproptest = \"1.11.0\"","totalLines":42,"fileSize":1177,"path":"/workspace/crates/nostr/Cargo.toml","readRange":{"startLine":1,"endLine":40}}}}

