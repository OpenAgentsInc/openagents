data: {"callId":"call-d1ed7d62-6038-4c29-a1e4-cf223d9bcee3-94\nfc_801bafa7-c370-97ae-9ee3-7b454287f6af_0","name":"get_mcp_tools","status":"completed","args":{"server":"cursor-cloud","toolName":"take-environment-snapshot","toolCallId":"call-d1ed7d62-6038-4c29-a1e4-cf223d9bcee3-94\nfc_801bafa7-c370-97ae-9ee3-7b454287f6af_0"},"result":{"success":{"content":"{\n  \"tool\": \"take-environment-snapshot\",\n  \"description\": \"Snapshot this VM's disk. Call only after the final update script has run successfully and all setup work is complete. Call it alone: never in the same message as another tool call, and never while a background subagent is working in this VM. It pauses the VM while it captures the disk, and tool calls that overlap the pause can hang. Returns a snapshot id once the capture finishes, usually within seconds; the upload then continues in the background, so use check-environment-snapshot to monitor it. If this run already has a snapshot uploading, returns that snapshot instead of starting another. If the VM changed after that existing snapshot began, wait for it to finish and then call this tool again.\",\n  \"inputSchema\": {\n    \"type\": \"object\",\n    \"properties\": {},\n    \"additionalProperties\": false,\n    \"$schema\": \"http://json-schema.org/draft-07/schema#\"\n  }\n}"}}}

