ipgrep|jq|nodejs|postgresql|libsqlite'"}],"fullText":"grep -E 'libssl|protobuf|bubblewrap|libclang|pkg-config|build-essential|ripgrep|jq|nodejs|postgresql|libsqlite'"},{"name":"true","fullText":"true"},{"name":"echo","args":[{"type":"string","value":"\"--- PATH ---\""}],"fullText":"echo \"--- PATH ---\""},{"name":"echo","args":[{"type":"string","value":"\"$PATH\""}],"fullText":"echo \"$PATH\""},{"name":"ls","args":[{"type":"word","value":"/usr/local/cargo/bin"}],"fullText":"ls /usr/local/cargo/bin"},{"name":"head","args":[{"type":"number","value":"-50"}],"fullText":"head -50"},{"name":"echo","args":[{"type":"string","value":"\"--- protoc ---\""}],"fullText":"echo \"--- protoc ---\""},{"name":"command","args":[{"type":"word","value":"-v"},{"type":"word","value":"protoc"}],"fullText":"command -v protoc"},{"name":"true","fullText":"true"},{"name":"echo","args":[{"type":"string","value":"\"--- sudo ---\""}],"fullText":"echo \"--- sudo ---\""},{"name":"sudo","args":[{"type":"word","value":"-n"},{"type":"word","value":"true"}],"fullText":"sudo -n true"},{"name":"echo","args":[{"type":"word","value":"sudo_ok"}],"fullText":"echo sudo_ok"}],"hasCommandSubstitution":true},"fileOutputThresholdBytes":"40000","timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Check Rust version and system packages","closeStdin":true,"conversationId":"bc-83e18906-00e2-436c-978b-13a4932f58b0","requestId":"b21cd8fc-e789-4fcd-8956-616a859ead7e"}}

