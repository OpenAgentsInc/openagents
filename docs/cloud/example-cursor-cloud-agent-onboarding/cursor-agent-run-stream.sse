id: 1791473773083-0
event: tool_call
data: {"callId":"call-2fe5d248-90ec-45d2-89a8-1c42f3d2c9ad-114\nfc_6210d29e-88f3-93ed-b95d-fdf53d255942_0","name":"get_mcp_tools","status":"completed","args":{"server":"cursor-cloud","toolName":"environment-build-logs","toolCallId":"call-2fe5d248-90ec-45d2-89a8-1c42f3d2c9ad-114\nfc_6210d29e-88f3-93ed-b95d-fdf53d255942_0"},"result":{"success":{"content":"{\n  \"tool\": \"environment-build-logs\",\n  \"description\": \"Fetch the install/setup logs for one environment build by buildId (bld-<YYYYMMDD>-<uuid>, as surfaced by environment-info's build block). Returns the log text inline (large outputs are spilled to a file automatically by the MCP framework). Logs cover the build's Docker image build plus clone/install/setup output and are retained for ~10 days after the build; older builds (or builds from before build-log capture shipped) return a retention note with no log body. Only builds of this run's own environment are accessible.\",\n  \"inputSchema\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"buildId\": {\n        \"type\": \"string\",\n        \"minLength\": 1,\n        \"description\": \"The environment build id to fetch install/setup logs for (e.g. bld-20260709-<uuid>).\"\n      }\n    },\n    \"required\": [\n      \"buildId\"\n    ],\n    \"additionalProperties\": false,\n    \"$schema\": \"http://json-schema.org/draft-07/schema#\"\n  }\n}"}}}

