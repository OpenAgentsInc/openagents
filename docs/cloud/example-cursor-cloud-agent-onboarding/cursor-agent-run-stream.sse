event: tool_call
data: {"callId":"call-c2beba95-b511-4340-aa60-19013b6c1e35-43\nfc_244b1f4e-5de8-9d10-8271-9783d4105ff0_0","name":"read_file","status":"completed","args":{"path":"/workspace/crates/gateway/Cargo.toml","limit":100},"result":{"success":{"content":"[package]\nname = \"gateway\"\nversion.workspace = true\nedition.workspace = true\nrust-version.workspace = true\ndescription = \"The keyed HTTP gateway in front of decision doors: authenticate, authorize, reserve quota, verify backend identity, forward bounded work, and record a receipt.\"\npublish.workspace = true\n\n[dependencies]\natif = { path = \"../atif\" }\ngym = { path = \"../gym\", default-features = false }\n# Paper Mono, the one typeface, for the pages this crate renders.\npaper-mono = { path = \"../paper-mono\" }\ncommercial-accounts = { path = \"../commercial-accounts\" }\nfs2 = \"0.4\"\nlibc = \"0.2\"\nopenagents-wallet = { path = \"../wallet\", default-features = false }\ndiscovery = { path = \"../discovery\" }\njev = { path = \"../jev\" }\naxum = { version = \"0.8\", features = [\"multipart\"] }\nfutures-util = { version = \"0.3\", default-features = false, features = [\"sink\"] }\nhmac = \"0.12.1\"\nnostr = { path = \"../nostr\" }\npay-ledger = { path = \"../pay-ledger\" }\nreceipts = { path = \"../receipts\" }\nring = \"0.17\"\nreqwest = { version = \"0.12\", default-features = false, features = [\"json\", \"rustls-tls\"] }\nsecp256k1 = { version = \"0.31\", features = [\"rand\"] }\nserde = { version = \"1\", features = [\"derive\"] }\nserde_json = \"1\"\nsha2 = \"0.10\"\ntenancy = { path = \"../tenancy\" }\ntokio = { version = \"1\", features = [\"full\"] }\ntokio-tungstenite = { version = \"0.30.0\", features = [\"rustls-tls-webpki-roots\"] }\n\n[dev-dependencies]\ncommercial-spend = { path = \"../commercial-spend\" }\nhex = \"0.4\"\nnostr = { path = \"../nostr\", features = [\"test-invoice\"] }\ntempfile = \"3\"\n\n[lints]\nworkspace = true\n","totalLines":44,"fileSize":1571,"path":"/workspace/crates/gateway/Cargo.toml","readRange":{"startLine":1,"endLine":44}}}}

