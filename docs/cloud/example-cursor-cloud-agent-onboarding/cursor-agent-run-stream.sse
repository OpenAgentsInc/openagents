data: {"callId":"call-282a3e12-a31d-441f-875f-ce21ad5f870f-105\nfc_60b35d08-57e7-95d4-baa3-0618e7552664_0","name":"mcp","status":"completed","args":{"name":"cursor-cloud-trigger-environment-build","args":{"environmentJson":{"install":"set -euo pipefail\nexport DEBIAN_FRONTEND=noninteractive\nsudo apt-get update\nsudo apt-get install -y --no-install-recommends build-essential pkg-config clang cmake protobuf-compiler libprotobuf-dev libssl-dev libsqlite3-dev libclang-dev ca-certificates curl git ripgrep jq xz-utils unzip zstd procps bubblewrap python3\nif ! command -v rustup >/dev/null 2>&1; then\n  curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal --default-toolchain none\n  sudo ln -sfn \"${HOME}/.cargo/bin/rustup\" /usr/local/bin/rustup\n  sudo ln -sfn \"${HOME}/.cargo/bin/cargo\" /usr/local/bin/cargo\n  sudo ln -sfn \"${HOME}/.cargo/bin/rustc\" /usr/local/bin/rustc\n  sudo ln -sfn \"${HOME}/.cargo/bin/rustfmt\" /usr/local/bin/rustfmt\n  sudo ln -sfn \"${HOME}/.cargo/bin/cargo-fmt\" /usr/local/bin/cargo-fmt\n  sudo ln -sfn \"${HOME}/.cargo/bin/cargo-clippy\" /usr/local/bin/cargo-clippy\nfi\nrustup toolchain install 1.97.1 --profile minimal --component rustfmt,clippy\nrustup default 1.97.1\nmkdir -p \"${HOME}/work\"\ncargo fetch --locked --manifest-path Cargo.toml\n","snapshot":"snapshot-20261008-c299d928-d12c-4169-ab8e-0b22d49b2f5a"}},"toolCallId":"call-282a3e12-a31d-441f-875f-ce21ad5f870f-105\nfc_60b35d08-57e7-95d4-baa3-0618e7552664_0","providerIdentifier":"cursor-cloud","toolName":"trigger-environment-build","serverIdentifier":"cursor-cloud"},"result":{"success":{"content":[{"text":{"text":"Started draft build bld-20261008-26522d23-d3aa-427c-b6f2-3fc6ffbabdb8 for this run's environment 7ce2f49e-c32a-11f1-bb68-864e54d14197. Draft builds do not affect new agents until someone activates one; activating a build made with `environmentJson` also saves that config as the environment's saved settings. Track it with list-environment-builds and fetch logs with environment-build-logs once it completes.\n{\n  \"environmentPublicId\": \"7ce2f49e-c32a-11f1-bb68-864e54d14197\",\n  \"buildId\": \"bld-20261008-26522d23-d3aa-427c-b6f2-3fc6ffbabdb8\",\n  \"createdDraftEnvironment\": false,\n  \"isDraft\": true\n}"}}],"structuredContent":{"environmentPublicId":"7ce2f49e-c32a-11f1-bb68-864e54d14197","buildId":"bld-20261008-26522d23-d3aa-427c-b6f2-3fc6ffbabdb8","createdDraftEnvironment":false,"isDraft":true}}}}

