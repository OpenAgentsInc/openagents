id: 1791472611009-0
event: tool_call
data: {"callId":"call-2daf38b1-c66b-416d-8493-bd40a0ece5e6-59\nfc_1640facb-12c6-9c7a-a8db-ba23f921c724_1","name":"get_mcp_tools","status":"completed","args":{"server":"cursor-cloud","toolName":"trigger-environment-build","toolCallId":"call-2daf38b1-c66b-416d-8493-bd40a0ece5e6-59\nfc_1640facb-12c6-9c7a-a8db-ba23f921c724_1"},"result":{"success":{"content":"{\n  \"tool\": \"trigger-environment-build\",\n  \"description\": \"Start one DRAFT environment build of this run's own environment (fresh git checkout + install script, snapshotted at the end). OK to call during environment setup to validate the config before proposing, or when the user asks to trigger a build. Each build boots a pod and runs the full install for up to a few hours, so do not trigger casually outside setup. By default every repo in the environment builds at its default branch; pass `refs` (per repoUrl) to build specific branches/tags/SHAs — every repoUrl must belong to this run's environment. Note: for db-managed environments, a build created from a non-default ref can be tested but cannot be promoted to active later — only builds from every repo's default branch are promotable, so omit `refs` if you want a promotable build. Pass `environmentJson` to build with a custom config instead of the environment's saved db-backed config. For a greenfield run with no linked environment, `environmentJson` is required and creates a personal transitional draft automatically. The config is recorded durably on the build and leaves the environment's saved settings unchanged until someone activates the build; activating it saves this config as the environment's saved settings, and moving the build back to draft does not undo that. `environmentJson` is not supported for repo-file managed environments (those whose config is read from a repository environment.json — see `environmentJsonPath` in environment-info) and is rejected for them; test repo-file environments by building off a branch instead — create a branch, edit its environment.json, and build that branch via `refs`. Draft builds skip warm-pool seeding and do not affect new agents until someone activates one, which makes it an active build (new agents boot from the newest active build); they appear in list-environment-builds (source AGENT, trigger MANUAL) and their logs are fetchable with environment-build-logs. Returns the new buildId immediately; the build runs in the background. Limited to a few in-flight builds per environment.\",\n  \"inputSchema\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"refs\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"repoUrl\": {\n              \"type\": \"string\",\n              \"minLength\": 1,\n              \"description\": \"Repository URL matching one of environment-info's top-level `repos` (same strings as environment.repos).\"\n            },\n            \"ref\": {\n              \"type\": \"string\",\n              \"minLength\": 1,\n              \"description\": \"Branch, tag, or commit SHA to build this repo at.\"\n            }\n          },\n          \"required\": [\n            \"repoUrl\",\n            \"ref\"\n          ],\n          \"additionalProperties\": false\n        },\n        \"description\": \"Per-repository ref overrides. Every repoUrl must belong to this run's environment; repos left out build at their default branch.\"\n      },\n      \"environmentJson\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"install\": {\n            \"type\": \"string\",\n            \"description\": \"Idempotent repository bootstrap command run from /workspace after checkout (and when refreshing dependencies). Must terminate; use for dependency install and source-derived generation, not long-running servers, migrations, or tests. Prefer one command per line rather than chaining with &&.\"\n          },\n          \"start\": {\n            \"type\": \"string\",\n            \"description\": \"Command run on each container start after install. Use for per-boot service startup with a non-daemonizing process (for example a dev server that stays attached). Do not use for dependency install or one-time setup.\"\n          },\n          \"snapshot\": {\n            \"type\": \"string\",\n            \"description\": \"Saved base-environment snapshot ID. One of build, image, or snapshot typically defines the environment base.\"\n          }\n        },\n        \"additionalProperties\": false,\n        \"description\": \"environment.json object used instead of the environment's saved db-backed config for this draft build. Property schema is authoritative (install, start, and optional snapshot). The override replaces saved config wholesale for the build, so include snapshot when the build should start from a READY take-environment-snapshot base. Required when this run has no linked environment (creates a personal transitional draft). Recorded on the build; the environment's saved settings stay unchanged until someone activates the build, which saves this config as the environment's saved settings. Not supported for repo-file managed environments (see environmentJsonPath in environment-info)—test those via branch refs instead.\"\n      }\n    },\n    \"additionalProperties\": false,\n    \"description\": \"Trigger a draft build for this run's environment. If the current run has no environment returned from environment-info, environmentJson is required.\",\n    \"$schema\": \"http://json-schema.org/draft-07/schema#\"\n  }\n}"}}}

