# The editor's acceptance run, for coax drive (docs/editor/acceptance/README.md).
# Start from an empty world on the dev server, which must watch and rebuild (start it without --build).
# Size 1280x800, query "edit&stage=5".
clock +1500
clock until page.f.rev >= 0 within 20000
# start the game; it holds the pointer to look round, and Escape lets go of it so the panes take presses again
type - key Enter
clock +800
type - key Escape
# place three pieces with the realm commands: revisions 1 to 3
place 117 17500 -7500
place 117 17650 -7350
place 116 17350 -7350
clock until game.layer.st.n == 3 within 6000
# the select tool: a tap in the world picks the crate under it and marks the point
tap tool
tap tool.1
# points are the window's, inside the scene's frame: at 1280x800 the canvas runs from x 308 to 964, below the strip, between the site's side and the editor's side
tap 820 480
clock until page.sel == 3 within 6000
tap 475 525
clock until page.sel == 2 within 6000
# move it with the gizmo: one snapped move, revision 4
tap tool
tap tool.2
drag 475 525 435 525
clock until page.f.rev == 4 within 6000
# turn it: revision 5
tap thing.2
tap tool
tap tool.3
drag 465 560 525 560
clock until page.f.rev == 5 within 6000
# edit a content row: the kind's name, in place, revision 6
type cell.112  XL
type cell.112 key Enter
clock until page.f.rev == 6 within 6000
clock until page.tables_gen >= 1 within 6000
# delete the selected piece: revision 7
tap remove
clock until page.f.rev == 7 within 6000
clock until game.layer.st.n == 2 within 6000
# undo brings it back, redo removes it again
tap undo
clock until game.layer.st.n == 3 within 6000
tap redo
clock until game.layer.st.n == 2 within 6000
# ---- a line of game code and a shader, from the Code pane (the dev server watches and rebuilds)
tap code
tap file
tap file=splice-game.coax
# one constant, saved: the engine swaps and the run keeps its state; then back, so the file is as it was found
swap code.text T_HIT_COOL :: 1.0f32 => T_HIT_COOL :: 1.5f32
tap code.save
swaps until wasm >= 1 within 30000
swap code.text T_HIT_COOL :: 1.5f32 => T_HIT_COOL :: 1.0f32
tap code.save
swaps until wasm >= 2 within 30000
# a shader: the Coax that writes Splice's WGSL
tap file
tap file=gpu/splice.coax
swap code.text pow(face,0.85f32) => pow(face,0.80f32)
tap code.save
swaps until wgsl >= 1 within 30000
swap code.text pow(face,0.80f32) => pow(face,0.85f32)
tap code.save
swaps until wgsl >= 2 within 30000
# the world came through the four swaps: the same revision, the same two pieces
clock until page.f.rev == 9 within 500
clock until game.layer.st.n == 2 within 500
tap code
swaps
# the agent's turns come right after the swaps: a page whose engine was swapped follows its world at once (#13457)
# ---- the same kind of edits through an agent: the /chat conversation in the editor's foot.
# The model's answers are scripted (the dev server has no model). After the answer everything is the real
# path: the plan, the shell's batch, the world's route and its rules.
# Coder on this machine is scripted too (#13465): no sessions yet, and a Claude Code that is ready
answer /local/sessions docs/editor/acceptance/local-sessions.json
answer /local/claude docs/editor/acceptance/local-claude.json
answer /local/agents docs/editor/acceptance/local-agents.json
tap agent
# a turn's edits are one batch: a revision for each edit, and one step to undo
answer /api/chat/complete docs/editor/acceptance/agent-place.json
type composer put two small crates by the bay
type composer key Enter
clock until page.f.rev == 11 within 6000
clock until game.layer.st.n == 4 within 6000
answer /api/chat/complete docs/editor/acceptance/agent-change.json
type composer move the first one a little and take the other away
type composer key Enter
clock until page.f.rev == 13 within 6000
clock until game.layer.st.n == 3 within 6000
# undo takes the whole turn back
answer /api/chat/complete docs/editor/acceptance/agent-undo.json
type composer undo that
type composer key Enter
clock until page.f.rev == 15 within 6000
clock until game.layer.st.n == 4 within 6000
# talk changes nothing
answer /api/chat/complete docs/editor/acceptance/agent-talk.json
type composer what stands by the bay?
type composer key Enter
clock +1500
clock until page.f.rev == 15 within 500
# the agents on this machine: the menu lists Claude Code beside us (Gemini), and the conversation switches to it
# and back (a tap on a row that isn't there fails the run)
tap agent=OpenAgents
clock +300
tap agent=Claude Code
clock +300
tap agent=Claude Code
clock +300
tap agent=OpenAgents
clock +300
tap model=Gemini 3.8 Flash
clock +300
tap model=Gemini 3.8 Flash
tap agent
# the agent's pane put away, the scene's frame grows to the window's foot: a frame drawn at the new size
clock +300
# the run kept its state: the player has not moved from where stage 5 put them
where
# what a tap reaches, and the tap targets
hit 57 35
hit 640 300
screenshot apps/openagents-web/build/editor-run.png
logs
