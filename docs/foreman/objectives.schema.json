{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foreman standing-objective authoring catalog",
  "description": "Local authoring data for a future WORK/AUTO importer. This schema does not define a signed Nostr event or grant execution rights.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "v", "requires", "repository", "stage", "selection", "execution", "objectives"],
  "properties": {
    "$schema": {"const": "./objectives.schema.json"},
    "v": {"const": "openagents.foreman-objective-catalog.v1"},
    "requires": {"type": "array", "maxItems": 0},
    "repository": {"const": "OpenAgentsInc/openagents"},
    "stage": {"const": "authoring"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "explicit_requests_first", "unknown_backlog", "equal_priority_order", "duplicate_checks", "no_candidate", "review_interval_seconds", "max_active_explorations", "excluded_issues"],
      "properties": {
        "trigger": {"const": "no_eligible_issue"},
        "explicit_requests_first": {"const": true},
        "unknown_backlog": {"const": "report_and_wait"},
        "equal_priority_order": {"const": "least_recently_explored"},
        "duplicate_checks": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["claims", "issues", "pull_requests", "objective_history"]}},
        "no_candidate": {"const": "record_and_back_off"},
        "review_interval_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "max_active_explorations": {"const": 1},
        "excluded_issues": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred_computers", "requires_host_admission", "delivery", "limits", "merge", "deploy", "new_spend", "owner_account_tests"],
      "properties": {
        "preferred_computers": {"$ref": "#/$defs/text_list"},
        "requires_host_admission": {"const": true},
        "delivery": {"const": "draft_pull_request"},
        "limits": {"const": "existing_grants"},
        "merge": {"const": "owner_only"},
        "deploy": {"const": "owner_only"},
        "new_spend": {"const": "owner_only"},
        "owner_account_tests": {"const": "forbidden"}
      }
    },
    "objectives": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/objective"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "text_list": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "path_list": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(crates|apps|docs)/[^\\\\]+$"}},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "desired_state", "priority", "intent", "source_paths", "read_first", "outcomes", "measurements", "candidate_examples", "constraints"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "desired_state": {"enum": ["active", "paused", "proposed"]},
        "priority": {"enum": ["high", "normal", "low"]},
        "intent": {"$ref": "#/$defs/text"},
        "source_paths": {"$ref": "#/$defs/path_list"},
        "read_first": {"$ref": "#/$defs/path_list"},
        "outcomes": {"$ref": "#/$defs/text_list"},
        "measurements": {"$ref": "#/$defs/text_list"},
        "candidate_examples": {"$ref": "#/$defs/text_list"},
        "constraints": {"$ref": "#/$defs/text_list"}
      }
    }
  }
}
