{
  "v": "openagents.buyer-attestation-vectors.v1",
  "status": "draft",
  "purpose": "Drive a test-first implementation of the merchant-side BuyerAttestation::verify hook (see ../2026-10-09-x402-merchant-facilitator-api-sketch.md §2). Each vector is a self-contained (inputs -> verdict) case.",
  "scope": "Synthetic. ArtifactRefs and digests are placeholders; no real signature, admission, POL/CAP/SOV artifact bytes, or RFC8785 canonicalization is asserted. Signature validity is modeled by the control flag `signature_valid`. Admission-of-authority is modeled by the merchant-supplied `trusted_authorities` set, because NIP-SOV states self-publication cannot establish authority trust: the merchant must independently trust the admitting authority. A production verifier replaces both models with real signature checks and real host-admission evidence.",
  "models": {
    "sovereign_profile": "openagents.sovereign-profile.v1 (NIP-SOV): fields agent, authority, policy, custody, treasury.",
    "spend_grant": "openagents.grant.v1 (NIP-CAP): fields issuer, principal, binding, effects (subset of reads/writes/network/process/delegates/spend, each granted separately), bounds, scope, purpose (evaluation|operational), expires_at.",
    "ceiling_source": "The per-tx ceiling used for the OverCeiling check is grant.bounds.max_per_tx_msat. A full verifier also cross-checks the SOV treasury aggregate allowance and reconciliation authority; that is out of scope for these single-call vectors.",
    "amounts": "millisatoshi as canonical nonnegative decimal strings (NIP-X402). One satoshi is \"1000\". Never round a liability down to zero."
  },
  "legend": {
    "OWNER": "79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798",
    "AGENT": "f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9",
    "AGENT_ROTATED": "e493dbf1c10d80f3581e4904930b1404cc6c13900ee0758474fa94abe8c4cd13",
    "UNTRUSTED_AUTHORITY": "c6047f9441ed7d6d3045406e95c07cd85c778e4b8cef3ca7abac09b95c709ee5"
  },
  "error_vocabulary": [
    "missing",
    "signature",
    "authority",
    "principal_mismatch",
    "purpose_not_operational",
    "effect_absent",
    "expired",
    "over_ceiling",
    "reputation_too_low"
  ],
  "evaluation_order": [
    { "step": 1, "check": "attestation present (profile + grant + signature)", "else": "missing" },
    { "step": 2, "check": "signature valid over the bound request", "else": "signature" },
    { "step": 3, "check": "profile.authority is in the merchant's trusted (admitted) authority set", "else": "authority" },
    { "step": 4, "check": "grant.principal == profile.agent", "else": "principal_mismatch" },
    { "step": 5, "check": "grant.purpose == \"operational\"", "else": "purpose_not_operational" },
    { "step": 6, "check": "\"spend\" is in grant.effects", "else": "effect_absent" },
    { "step": 7, "check": "now < grant.expires_at", "else": "expired" },
    { "step": 8, "check": "price_msat <= grant.bounds.max_per_tx_msat", "else": "over_ceiling" },
    { "step": 9, "check": "reputation >= min_reputation", "else": "reputation_too_low" },
    { "step": 10, "check": "all passed", "then": "ok { buyer: profile.agent, owner: profile.authority, max_per_tx_msat: grant.bounds.max_per_tx_msat }" }
  ],
  "common": {
