                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppDevicePoll"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/AppDevicePoll"
              }
            }
          }
        }
      }
    },
    "/v1/device/sign-out": {
      "post": {
        "operationId": "signOutApp",
        "tags": [
          "App authentication"
        ],
        "security": [
          {
            "appBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "The app's result. Tokens and codes are returned only here; do not cache.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppSignedOut"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, pending, slow_down, denied, expired, or already redeemed grant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppOAuthError"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppOAuthError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid app credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppOAuthError"
                }
              }
            }
          }
        },
        "description": "Revoke this app session. Already expired/revoked sessions are signed out. A sign-in key is a session too; revoking it here is not a local forget operation."
      }
    },
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "security": [
          {
            "appBearer": []
          }
        ],
        "description": "Existing account and current workspace memberships. Accepts app sess_ sessions, oa_sk_ sign-in keys, and account-bound oak_ API keys. Credential prefixes alone do not prove authorization.",
        "responses": {
          "200": {
            "description": "The authenticated account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppAccountView"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, invalid, or revoked credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppAccountError"
                }
              }
            }
          },
          "403": {
            "description": "Credential cannot act for an account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppAccountError"
                }
              }
            }
          },
          "404": {
            "description": "The account no longer exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppAccountError"
                }
              }
            }
          },
          "503": {
            "description": "Account storage is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppAccountError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/history": {
      "get": {
        "operationId": "listSavedChats",
        "tags": [
          "Saved history"
        ],
        "security": [
          {
            "appBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Last public ID from this same list. Empty filtered pages may still have next. ID-order discovery is not a snapshot; restart to find newly inserted earlier IDs.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "query",
            "description": "A currently authorized shared project ID. Omit for all owned chats, including archived.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A read-only saved page. No hosts are contacted and no seen/send state changes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor, signed out, denied, missing, changed, throttled, or unavailable. A failure is never an empty success.",
