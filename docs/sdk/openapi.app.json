  "components": {
    "securitySchemes": {
      "appBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "An app sess_ session or supported oa_sk_ sign-in key. API cookies are ignored."
      }
    },
    "schemas": {
      "AppDeviceRequest": {
        "type": "object",
        "required": [
          "computer"
        ],
        "properties": {
          "app": {
            "type": "string",
            "maxLength": 64,
            "default": "Coder"
          },
          "computer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "AppDeviceGrant": {
        "type": "object",
        "required": [
          "device_code",
          "user_code",
          "verification_uri",
          "verification_uri_complete",
          "expires_in",
          "interval"
        ],
        "properties": {
          "device_code": {
            "type": "string",
            "x-sensitive": true
          },
          "user_code": {
            "type": "string"
          },
          "verification_uri": {
            "type": "string",
            "format": "uri"
          },
          "verification_uri_complete": {
            "type": "string",
            "format": "uri"
          },
          "expires_in": {
            "type": "integer",
            "const": 600
          },
          "interval": {
            "type": "integer",
            "const": 5
          }
        }
      },
      "AppDevicePoll": {
        "type": "object",
        "required": [
          "device_code"
        ],
        "properties": {
          "device_code": {
            "type": "string",
            "x-sensitive": true
          },
          "grant_type": {
            "type": "string",
            "const": "urn:ietf:params:oauth:grant-type:device_code"
          }
        }
      },
      "AppSession": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "account"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "x-sensitive": true
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2592000
          },
          "account": {
            "$ref": "#/components/schemas/AppAccount"
          }
        }
      },
      "AppSignedOut": {
        "type": "object",
        "required": [
          "signed_out"
        ],
        "properties": {
          "signed_out": {
            "const": true
          }
        }
      },
      "AppAccount": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "admin": {
            "type": "boolean"
          }
        }
      },
      "AppAccountView": {
        "type": "object",
        "required": [
          "account",
          "workspaces"
        ],
        "properties": {
          "v": {
            "const": "openagents.accounts.v1"
          },
          "account": {
            "$ref": "#/components/schemas/AppAccount"
          },
          "workspaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AppWorkspace"
            }
          }
        }
      },
      "AppWorkspace": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "role",
          "tenant"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "tenant": {
            "type": "string"
          },
          "seats": {
            "type": [
              "integer",
              "null"
            ]
          },
          "members": {
            "type": "integer"
          }
        }
      },
      "AppOAuthError": {
        "type": "object",
        "required": [
          "error",
          "error_description"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "error_description": {
            "type": "string"
          },
          "interval": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        }
      },
      "AppAccountError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "HistorySummary": {
        "type": "object",
        "required": [
          "id",
          "title",
          "revision",
          "updated_unix",
          "pinned_unix",
          "archived_unix",
          "project",
          "source",
          "messages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "updated_unix": {
            "type": "integer",
            "minimum": 0
          },
          "pinned_unix": {
            "type": [
              "integer",
              "null"
            ]
          },
          "archived_unix": {
            "type": [
              "integer",
              "null"
            ]
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "enum": [
              "web",
              "terminal",
              "phone"
            ]
          },
          "messages": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "HistoryProject": {
        "type": "object",
        "required": [
          "id",
          "name",
          "shared"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "shared": {
            "type": "boolean"
          }
        }
      },
      "HistoryFile": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "size"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "png",
              "jpeg",
              "gif",
              "webp",
              "pdf",
              "text",
              "step",
              "stl"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "HistoryTool": {
        "type": [
          "object",
          "null"
        ],
        "required": [
          "name",
          "summary",
          "status",
          "input",
          "output"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "enum": [
              "running",
              "done",
              "failed"
            ]
          },
          "input": {
            "type": "string"
          },
          "output": {
            "type": "string"
          }
        }
      },
      "HistoryMessage": {
        "type": "object",
        "required": [
          "id",
          "role",
          "text",
          "files",
          "tool",
          "generated_files",
          "artifacts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^msg_[0-9]+$"
          },
          "role": {
            "enum": [
              "user",
              "assistant",
              "tool",
              "thinking"
            ]
          },
          "text": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryFile"
            }
          },
          "tool": {
            "$ref": "#/components/schemas/HistoryTool"
          },
          "generated_files": {
            "type": "array",
            "maxItems": 0,
            "items": {}
          },
          "artifacts": {
            "type": "array",
            "maxItems": 0,
            "items": {}
          }
        }
      },
      "HistoryList": {
        "type": "object",
        "required": [
          "data",
          "next"
        ],
        "properties": {
          "data": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/HistorySummary"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "HistoryProjects": {
        "type": "object",
        "required": [
          "data",
          "next"
        ],
        "properties": {
          "data": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/HistoryProject"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "HistoryCapture": {
        "type": "object",
        "required": [
          "id",
          "name",
          "state",
          "size",
          "media"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "enum": [
              "saved",
              "unavailable",
              "not_saved"
            ]
          },
          "size": {
            "type": [
              "integer",
              "null"
            ]
          },
          "media": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "HistoryMessages": {
        "type": "object",
        "required": [
          "thread",
          "revision",
          "data",
          "next",
          "captures"
        ],
        "properties": {
          "captures": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/HistoryCapture"
            }
          },
          "thread": {
            "$ref": "#/components/schemas/HistorySummary"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "data": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/HistoryMessage"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
