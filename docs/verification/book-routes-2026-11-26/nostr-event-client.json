  "route": {
    "id": "nostr-event-client",
    "book": "nostr",
    "title": "Sign and verify an event, then replay a client connection",
    "scope": "Sign a complete event with a published BIP-340 test key, verify its ID/signature and altered-field refusals, then drive the pure client connection through scripted handshakes, reconnects, verified events, duplicate/stale reports, acknowledgments and shutdown.",
    "limitations": [
      "Signing material is a committed public test vector. No user key, Keychain, wallet, entropy source or external signer is opened.",
      "Transport bytes and times are scripted in memory. No socket is opened or relay contacted; native TLS, browser secret handling, durable storage, live interoperability and deployed relays are separate profiles.",
      "The Pylon consumes the shared signer and relay state machine through its own real transport and admission paths. This offline route does not establish that consumer or production relay readiness."
    ]
  },
