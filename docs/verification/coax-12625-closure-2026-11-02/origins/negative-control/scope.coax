}
#forall "R2 focused borrow checked constructors re-admit payloads in a new generic context" nominal:bool,generated:bool {
 nodes:[40]CK_Node;types:[24]CK_Type;locals:[2]CK_Local;errors:[8]CK_Error;bytes:[1024]u8;state:=[1]CK_State.[CK_State.{used=13,type_count=18,local_count=1,generic=3}];for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.optional,elem=11,size=16,alignment=8,sum_payload_offset=8,sum_default=0};types[17]=CK_Type.{kind=CK_Kind.param,name="$T",decl=3,elem=6};nodes[3]=CK_Node.{kind=CK_Tag.proc,name="instance"};nodes[8]=CK_Node.{kind=CK_Tag.param,name="x",type=6};locals[0]=CK_Local.{name="x",type=6,decl=8,immutable="parameter"};nodes[10]=CK_Node.{kind=CK_Tag.expr_sum,name="some",type=16,a=11,d=12,sum_variant=1};nodes[11]=CK_Node.{kind=CK_Tag.expr_ident,name="x",type=11,loc=CK_Loc.{line=904,column=9}};nodes[12]=CK_Node.{kind=CK_Tag.type_optional,b=13};nodes[13]=CK_Node.{kind=CK_Tag.type_param,name="T"};
 if nominal {types[16]=CK_Type.{kind=CK_Kind.union_,name="Choice",decl=2,size=16,alignment=8,sum_payload_offset=8,sum_default= -1};nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.union_,name="Choice",type=16,head=5,mark=2};nodes[5]=CK_Node.{kind=CK_Tag.variant,name="item",type=11};nodes[10].name="item";nodes[10].sum_variant=0;nodes[12]=CK_Node.{kind=CK_Tag.type_named,name="Choice"};}
 if generated {nodes[10].mark=1;}c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};expected:=0;if !nominal {expected=CK_sum_type(c,CK_Kind.optional,6,0,CK_Loc.{});}copy:=CK_clone(c,10);got:=CK_value(c,copy,CK_Hint.{});#assert !state[0].fatal;
 if nominal {#assert state[0].error_count==1 && errors[0].code=="E0901" && errors[0].loc.line==904;}
 else {#assert state[0].error_count==0 && got==expected && types[got].kind==CK_Kind.optional && types[got].elem==6 && nodes[nodes[copy].a].type==6;}
}

#forall "R2 focused literal witness identity requires every frozen key component" changed:0..<7 {
 p:=CB_LiteralBlock.{id=10,type=16,head=20,used=80,types=24,block=1};id:=10;type:=16;head:=20;used:=80;types:=24;block:=1;
 if changed==1 {id=11;}if changed==2 {type=17;}if changed==3 {head=21;}if changed==4 {used=81;}if changed==5 {types=25;}if changed==6 {block=2;}
 #assert CB_literal_same(p,id,type,head,used,types,block)==(changed==0);
}
#forall "R2 focused literal FIFO refresh preserves two working sets within remaining fuel" third:bool {
 nodes:[96]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=95,type_count=17}];work:[1]CB_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.struct_,decl=2};nodes[10]=CK_Node.{kind=CK_Tag.expr_struct,type=16,head=20};nodes[11]=CK_Node.{kind=CK_Tag.expr_struct,type=16,head=24};nodes[12]=CK_Node.{kind=CK_Tag.expr_struct,type=16,head=32};
 nodes[20]=CK_Node.{kind=CK_Tag.field_init,field_index=0,a=40,next=21};nodes[21]=CK_Node.{kind=CK_Tag.field_init,field_index=1,a=41};
 for i:0..<8 {nodes[24+i]=CK_Node.{kind=CK_Tag.field_init,field_index=i,a=48+i,next=ifx i==7 then 0 else 25+i};nodes[48+i]=CK_Node.{kind=CK_Tag.expr_string,type=3};}
 nodes[32]=CK_Node.{kind=CK_Tag.field_init,field_index=0,a=42};for i:40..<43 {nodes[i]=CK_Node.{kind=CK_Tag.expr_string,type=3};}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..],literal_cache=true};out:[64]BS_Origin;path:=BS_Path.{count=1};path.steps[0].kind=BS_FIELD;
 got:=CB_expr(b,10,path,false,out[..]);#assert !state[0].fatal && got.count==1 && out[0].root==40;
 path.steps[0].index=7;got=CB_expr(b,11,path,false,out[..]);#assert !state[0].fatal && got.count==1 && out[0].root==55;
 path.steps[0].index=1;got=CB_expr(b,10,path,false,out[..]);#assert !state[0].fatal && got.count==1 && out[0].root==41;
 id:=10;expected:=41;if third {path.steps[0].index=0;got=CB_expr(b,12,path,false,out[..]);#assert !state[0].fatal && got.count==1 && out[0].root==42;id=11;expected=55;path.steps[0].index=7;}
 // Each warmed source read costs the expression, selected witness, and payload ticks.
 work[0].work=1048384;for i:0..<64 {got=CB_expr(b,id,path,false,out[..]);#assert !state[0].fatal && state[0].error_count==0 && got.count==1 && !got.incomplete && out[0].kind==BS_STATIC && out[0].root==expected && out[0].type==12;}
 #assert work[0].work<=1048576;
}


CB_query :: (b:CB_Context,kind:u8,decl:int,path:BS_Path,out:[]BS_Origin)->CB_Result {
 if (kind<1 || (kind>3 && kind!=5)) || decl<2 || decl>b.c.state[0].used || !BS_path_valid(path) {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}
 if b.state[0].queries<0 || b.state[0].queries>b.queries.count || b.state[0].origins<0 || b.state[0].origins>b.origins.count {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}
 projection:[1]CB_QueryProjection;expected_type:=CB_query_project(b,kind,decl,path,projection[..]);if b.c.state[0].fatal {return CB_Result.{};}prior_loc:=b.state[0].loc;if b.c.nodes[decl].loc.line>0 {b.state[0].loc=b.c.nodes[decl].loc;}defer b.state[0].loc=prior_loc;
 indirect:=false;for i:0..<path.count {if path.steps[i].kind==BS_DEREFERENCE {indirect=true;}}
 // Direct owned storage has no value/write/alias dependencies or recursion.
 // B1 can derive it without a separate origin-query row or origin span.
 if b.retain_fields && kind==3 && !indirect {owner:=b.c.nodes[decl].borrow_owner;if owner<2 || owner>b.c.state[0].used || (b.c.nodes[owner].kind!=CK_Tag.proc && b.c.nodes[owner].kind!=CK_Tag.check) {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}if !CB_tick(b,b.c.nodes[decl].loc) {return CB_Result.{};}return CB_put(b,out,CB_Result.{},BS_Origin.{kind=BS_LOCAL,root=decl,type=CB_key(b,expected_type,true),path=path});}
 // Per-declaration one-based links keep unrelated procedures out of a lookup.
 // Rows stay append-only: even a recursive query retains its original slot.
 head:=b.c.nodes[decl].borrow_query;link:=head;bucket:int;if b.query_index {bucket=CB_index_bucket(kind,path);link=CB_index_start(b,decl,head,bucket);if b.c.state[0].fatal {return CB_Result.{};}}
 while link!=0 {
  if link<1 || link>b.state[0].queries {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}
  if !(b.query_index && link==head) {if !CB_tick(b,b.c.nodes[decl].loc) {return CB_Result.{};}}q:=b.queries[link-1];
  if q.decl!=decl || q.kind<1 || (q.kind>3 && q.kind!=5) || q.status<1 || q.status>3 || q.next<0 || q.next>=link || !BS_path_valid(q.path) {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}
  next:=q.next;if b.query_index {next=CB_index_next(b,decl,link,q,bucket);if b.c.state[0].fatal {return CB_Result.{};}}same:=q.retain_classes==b.retain_classes;
  // Complete raw facts survive source normalization. Reverse
  // value/procedure reuse and unknown/active rows remain unsupported.
  if q.kind==kind && bs_path_equal(q.path,path) && (same || (b.retain_fields && q.status==2 && !q.retain_classes)) {
   if q.type!=expected_type {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}if q.status==1 {return CB_Result.{incomplete=true};}
   if q.start<0 || q.count<0 || q.start>b.state[0].origins || q.count>b.state[0].origins-q.start {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}
   if same {if q.count>out.count {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}for i:0..<q.count {out[i]=b.origins[q.start+i];}CB_projection_commit(b,projection[0],link);return CB_Result.{count=q.count,incomplete=q.status==3};}
   // A complete raw dependency graph is already admitted. Derive its class
   // result with the same normalization, without publishing a second row/span.
   if q.count>64 {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}staged:[64]BS_Origin;mapped:CB_Result;
   for i:0..<q.count {if !CB_tick(b,b.c.nodes[decl].loc) {return CB_Result.{};}value:=b.origins[q.start+i];if !BS_origin_valid(value) {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}mapped=CB_put(b,staged[..],mapped,value);}
   if mapped.count>out.count {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}for i:0..<mapped.count {out[i]=staged[i];}return mapped;
  }link=next;
 }
 slot:=b.state[0].queries;if slot>=b.queries.count {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}if !CB_index_prepare(b,slot,kind,path,head) {return CB_Result.{};}b.state[0].queries+=1;b.queries[slot]=CK_BorrowQuery.{kind=kind,decl=decl,type=expected_type,path=path,status=1,next=head,retain_classes=b.retain_classes};b.c.nodes[decl].borrow_query=slot+1;r:CB_Result;n:=b.c.nodes[decl];
 if kind==1 {
  if n.kind!=CK_Tag.proc {CK_resource(b.c,n.loc);return CB_Result.{};}if n.flag2 || n.generic || n.b==0 || n.borrow_returns==0 {CK_resource(b.c,n.loc);return CB_Result.{};}
  // A caller asks where an array behind the returned descriptor lives (its
  // storage), or what a returned descriptor points at (its value).
  ret:=n.borrow_returns;temp:[64]BS_Origin;place:=b.c.types[expected_type].kind==CK_Kind.array;
  while ret!=0 {
   if ret<2 || ret>b.c.state[0].used {CK_resource(b.c,n.loc);return CB_Result.{};}edge:=b.c.nodes[ret];z:CB_Result;witness:=b.c.nodes[edge.a].loc;
   if edge.kind==CK_Tag.stmt_return {z=CB_expr(b,edge.a,path,place,temp[..]);}
   else if edge.kind==CK_Tag.expr_try {
    if edge.propagate_type!=n.type || path.count==0 || path.steps[0].kind!=BS_VARIANT {CK_resource(b.c,edge.loc);return CB_Result.{};}
    failure:=ifx b.c.types[n.type].kind==CK_Kind.result then 1 else 0;witness=edge.loc;
    if path.steps[0].index==failure && failure==1 {z=CB_expr(b,edge.a,CB_prepend(b,CB_tail(path),BS_VARIANT,1),place,temp[..]);}
   }else {CK_resource(b.c,n.loc);return CB_Result.{};}
   for i:0..<z.count {if temp[i].kind==BS_LOCAL && b.c.state[0].error_count==0 {CK_error(b.c,witness,"E0383","returned borrow may refer to local inline storage through a helper or aggregate","return owned storage, or keep the borrowed backing in the caller");break;}}
   r=CB_merge(b,out,r,temp[..],z);ret=edge.borrow_next;
  }
 }else {
  owner:=n.borrow_owner;if owner<2 || owner>b.c.state[0].used || (b.c.nodes[owner].kind!=CK_Tag.proc && b.c.nodes[owner].kind!=CK_Tag.check) {CK_resource(b.c,n.loc);return CB_Result.{};}
  t:=expected_type;
  if kind==3 && !indirect {r=CB_put(b,out,r,BS_Origin.{kind=BS_LOCAL,root=decl,type=CB_key(b,t,true),path=path});}
  else if kind==5 {if n.kind!=CK_Tag.param || !indirect {CK_resource(b.c,n.loc);return CB_Result.{};}}
  else if n.kind==CK_Tag.param {
   at:=b.c.nodes[owner].head;ordinal:=0;while at!=decl {if at<2 || at>b.c.state[0].used || !CB_tick(b,n.loc) {CK_resource(b.c,n.loc);return CB_Result.{};}at=b.c.nodes[at].next;ordinal+=1;}
   r=CB_put(b,out,r,BS_Origin.{kind=BS_PARAMETER,root=ordinal,role=BS_DESCRIPTOR,type=CB_key(b,t,kind==3),path=path});
  }else if n.kind==CK_Tag.case_binding {r=CB_expr(b,n.a,CB_prepend(b,path,BS_VARIANT,n.sum_variant),kind==3,out);}
  else if n.kind==CK_Tag.stmt_var {if n.a!=0 {r=CB_expr(b,n.a,path,kind==3,out);}else {r=CB_default(b,n.type,path,out);}}
  else if n.kind==CK_Tag.stmt_each {collection:=b.c.types[b.c.nodes[n.a].type];r=CB_expr(b,n.a,CB_prepend(b,path,ifx collection.kind==CK_Kind.array then BS_ELEMENT else BS_DEREFERENCE,ifx collection.kind==CK_Kind.array then 2147483647 else 0),false,out);}
  else {CK_resource(b.c,n.loc);return CB_Result.{};}
  if !(kind==3 && !indirect) {write:=n.borrow_writes;temp:[64]BS_Origin;
  while write!=0 {p:=CB_place(b,b.c.nodes[write].c);if p.decl!=decl {CK_resource(b.c,n.loc);return CB_Result.{};}if CB_prefix(p.path,path) {rest:BS_Path;for i:p.path.count..<path.count {rest=CB_add_path(b,rest,path.steps[i].kind,path.steps[i].index);}z:=CB_expr(b,b.c.nodes[write].a,rest,kind==3,temp[..]);if kind==5 {CB_external_local(b,b.c.nodes[write].a,temp[..],z);}r=CB_merge(b,out,r,temp[..],z);}write=b.c.nodes[write].borrow_next;}
  r=CB_alias_writes_mode(b,decl,path,out,r,kind==5);
  // Raw return queries compose selected helper writes. Retained-store-only
  // misses keep B1's manual boundary; a complete raw memo above is reusable.
  // This never certifies unknown effects or expands the shared work budget.
  if b.retain_fields {r.incomplete=r.incomplete || CB_opaque(b,decl,path);}
  else {r=CB_call_writes(b,decl,path,out,r);}}
 }
 if b.c.state[0].fatal {return CB_Result.{};}if r.count>b.origins.count-b.state[0].origins {CK_resource(b.c,n.loc);return CB_Result.{};}
 start:=b.state[0].origins;for i:0..<r.count {b.origins[start+i]=out[i];}b.state[0].origins+=r.count;b.queries[slot].start=start;b.queries[slot].count=r.count;b.queries[slot].status=ifx r.incomplete then cast(u8)3 else cast(u8)2;CB_projection_commit(b,projection[0],slot+1);return r;
}
// The leaves of a type holding a borrow when every element is its own: 128
// stands for more than 64. Stops once over, so a wide or deep type costs at
// most the budget per level.

#load "coax/lib/compiler/checker.coax";

#load "coax/tests/results-cache-policy.coax";
#load "coax/tests/results-projection-policy.coax";
