#test "return borrow presence discovery does not impose projection depth on owned scalar records" {
 nodes:[64]CK_Node;types:[32]CK_Type;locals:[4]CK_Local;errors:[4]CK_Error;bytes:[512]u8;state:=[1]CK_State.[CK_State.{used=63,type_count=26}];c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 nodes[1]=CK_Node.{kind=CK_Tag.file,head=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,b=3,loc=CK_Loc.{line=10,column=2}};nodes[3]=CK_Node.{kind=CK_Tag.stmt_block};
 for i:0..<10 {types[16+i]=CK_Type.{kind=CK_Kind.struct_,decl=32+i*2};nodes[32+i*2]=CK_Node.{kind=CK_Tag.struct_,head=33+i*2};nodes[33+i*2]=CK_Node.{kind=CK_Tag.field,type=ifx i==9 then 12 else 17+i};}
 CK_borrow_returns(c);#assert !state[0].fatal && state[0].error_count==0 && nodes[2].borrow_status==0;
}

#forall "retained discovery keeps the exact 256-level type boundary" mutable:bool,too_deep:bool {
 types:[274]CK_Type;nodes:[4]CK_Node;errors:[4]CK_Error;state:[1]CK_State;work:[1]CB_State;
 for i:0..<16 {types[i]=CK_builtin(i);}layers:=ifx too_deep then 257 else 256;
 for i:0..<layers {types[16+i]=CK_Type.{kind=CK_Kind.array,length=1,elem=17+i};}
 types[16+layers]=CK_Type.{kind=CK_Kind.view,elem=3};state[0]=CK_State.{used=3,type_count=17+layers};work[0].loc=CK_Loc.{line=901,column=8,offset=90108};
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,state=work[..]};answer:=ifx mutable then CR_mutable(b,16) else CR_presence(b,16);
 if too_deep {#assert !answer && state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==901 && errors[0].loc.column==8 && errors[0].loc.offset==90108;}
 else {#assert answer && !state[0].fatal && state[0].error_count==0;}
}

// Repeated whole-record writes exercise the full CR_run wiring, not a cache row.
// A single shared budget has 4096 steps left; no per-query or test budget changes.
#test "R2 Result and optional identities use existing scalar IDs and checked payload layout" {
 nodes:[24]CK_Node;types:[40]CK_Type;locals:[2]CK_Local;errors:[8]CK_Error;bytes:[2048]u8;state:=[1]CK_State.[CK_State.{used=16,type_count=16}];
 c:=CK_Context.{nodes=nodes[..],types=types[..],locals=locals[..],errors=errors[..],bytes=bytes[..],state=state[..]};for i:0..<16 {types[i]=CK_builtin(i);}
 nodes[2]=CK_Node.{kind=CK_Tag.type_named,name="Result",head=3};nodes[3]=CK_Node.{kind=CK_Tag.type_named,name="int",next=4};nodes[4]=CK_Node.{kind=CK_Tag.type_named,name="u8"};
 a:=CK_resolve(c,2,CK_Access.value);#assert a==16 && types[a].kind==CK_Kind.result && types[a].elem==11 && types[a].sum_error==12;
 #assert types[a].size==16 && types[a].alignment==8 && types[a].sum_payload_offset==8 && types[a].sum_default== -1;
 #assert CK_resolve(c,2,CK_Access.value)==a && state[0].type_count==17 && types[13].name=="u16";
 nodes[5]=CK_Node.{kind=CK_Tag.type_optional,b=6};nodes[6]=CK_Node.{kind=CK_Tag.type_named,name="int"};b:=CK_resolve(c,5,CK_Access.value);
 #assert b==17 && types[b].kind==CK_Kind.optional && types[b].elem==11 && types[b].sum_default==0 && types[b].size==16;
 nodes[3].name="void";u:=CK_resolve(c,2,CK_Access.value);#assert u==18 && types[u].elem==1 && types[u].size==8 && types[u].sum_payload_offset==4 && types[u].sum_default== -1;
 #assert state[0].error_count==0 && !state[0].fatal;
}
