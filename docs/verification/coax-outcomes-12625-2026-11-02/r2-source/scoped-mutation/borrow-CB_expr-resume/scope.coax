CB_expr :: (b:CB_Context,id:int,path:BS_Path,storage:bool,out:[]BS_Origin)->CB_Result {
 if id<2 || id>b.c.state[0].used {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}e:=b.c.nodes[id];prior_loc:=b.state[0].loc;if e.loc.line>0 {b.state[0].loc=e.loc;}defer b.state[0].loc=prior_loc;if e.type<1 || e.type>=b.c.state[0].type_count {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}if !CB_tick(b,e.loc) {return CB_Result.{};}
 if b.state[0].depth>=32 {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}b.state[0].depth+=1;defer b.state[0].depth-=1;
 if e.kind==CK_Tag.expr_sum || e.kind==CK_Tag.expr_some || e.kind==CK_Tag.expr_null {
  if !CK_sum(b.c,e.type) || e.sum_variant<0 || e.sum_variant>=CK_sum_count(b.c,e.type) || path.count==0 || path.steps[0].kind!=BS_VARIANT {CK_resource(b.c,e.loc);return CB_Result.{};}
  payload:=CB_variant(b,e.type,path.steps[0].index);if payload==0 {return CB_Result.{};}if path.steps[0].index!=e.sum_variant {return CB_Result.{};}
  if payload==1 {if path.count!=1 {CK_resource(b.c,e.loc);}return CB_Result.{};}return CB_expr(b,e.a,CB_tail(path),storage,out);
 }
 if e.kind==CK_Tag.expr_try {operand:=b.c.types[b.c.nodes[e.a].type];variant:=0;if operand.kind==CK_Kind.optional {variant=1;}return CB_expr(b,e.a,CB_prepend(b,path,BS_VARIANT,variant),storage,out);}
 if e.kind==CK_Tag.expr_or_else {
  operand:=b.c.nodes[e.a];success:=0;if b.c.types[operand.type].kind==CK_Kind.optional {success=1;}
  known:=operand.kind==CK_Tag.expr_sum || operand.kind==CK_Tag.expr_some || operand.kind==CK_Tag.expr_null;
  if known && operand.sum_variant!=success {return CB_expr(b,e.b,path,storage,out);}
  r:=CB_expr(b,e.a,CB_prepend(b,path,BS_VARIANT,success),storage,out);if known {return r;}temp:[64]BS_Origin;z:=CB_expr(b,e.b,path,storage,temp[..]);return CB_merge(b,out,r,temp[..],z);
 }
 if e.kind==CK_Tag.expr_ident {
  if e.borrow_binding!=0 {return CB_query(b,ifx storage then cast(u8)3 else cast(u8)2,e.borrow_binding,path,out);}
  if e.constant<2 || e.constant>b.c.state[0].used || b.c.nodes[e.constant].kind!=CK_Tag.constant {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}
  // A constant holds compile-time data only (a #run result cannot hold a
  // view, E0409), so its storage and every descriptor in it are static. One
  // origin stands for them all, rather than one per literal in the table.
  return CB_put(b,out,CB_Result.{},BS_Origin.{kind=BS_STATIC,root=e.constant,type=CB_key(b,CB_type(b,e.type,path),true),path=path});
 }
 if e.kind==CK_Tag.expr_field {return CB_expr(b,e.a,CB_prepend(b,path,BS_FIELD,e.field_index),storage,out);}
 if e.kind==CK_Tag.expr_index {
  t:=b.c.types[b.c.nodes[e.a].type];if t.kind==CK_Kind.view {return CB_expr(b,e.a,CB_prepend(b,path,BS_DEREFERENCE,0),storage,out);}
  index:=2147483647;if b.c.nodes[e.b].kind==CK_Tag.expr_int && b.c.nodes[e.b].value>>31==0 {index=cast(int)b.c.nodes[e.b].value;}return CB_expr(b,e.a,CB_prepend(b,path,BS_ELEMENT,index),storage,out);
 }
 if e.kind==CK_Tag.expr_slice {
  t:=b.c.types[b.c.nodes[e.a].type];if path.count==0 {return CB_expr(b,e.a,path,t.kind==CK_Kind.array,out);}
  if path.steps[0].kind!=BS_DEREFERENCE {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}
  if t.kind==CK_Kind.array {return CB_expr(b,e.a,CB_prepend(b,CB_tail(path),BS_ELEMENT,2147483647),storage,out);}return CB_expr(b,e.a,path,storage,out);
 }
 if e.kind==CK_Tag.expr_cast || e.kind==CK_Tag.expr_run {return CB_expr(b,e.a,path,storage,out);}
 if e.kind==CK_Tag.expr_ifx {r:=CB_expr(b,e.b,path,storage,out);temp:[64]BS_Origin;z:=CB_expr(b,e.c,path,storage,temp[..]);return CB_merge(b,out,r,temp[..],z);}
 // An rvalue's own storage is a temporary. Storage behind one of its
 // descriptors (a dereferencing path) is wherever that descriptor points.
 if storage && CB_direct(b,path).count==path.count {return CB_put(b,out,CB_Result.{},BS_Origin.{kind=BS_LOCAL,root=id,type=CB_key(b,CB_type(b,e.type,path),true),path=path});}
 if e.kind==CK_Tag.expr_string || e.kind==CK_Tag.expr_ct {return CB_put(b,out,CB_Result.{},BS_Origin.{kind=BS_STATIC,root=id,type=CB_descriptor_key(b,CB_type(b,e.type,path))});}
 if e.kind==CK_Tag.expr_struct {
  if path.count==0 || path.steps[0].kind!=BS_FIELD {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}field:=CB_literal_field(b,id,path.steps[0].index);if b.c.state[0].fatal {return CB_Result.{};}if field!=0 {return CB_expr(b,b.c.nodes[field].a,CB_tail(path),storage,out);}return CB_default(b,e.type,path,out);
 }
 if e.kind==CK_Tag.expr_array {
  if path.count==0 || path.steps[0].kind!=BS_ELEMENT {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}r:CB_Result;at:=0;item:=e.head;temp:[64]BS_Origin;
  while item!=0 {if !CB_tick(b,e.loc) {return CB_Result.{};}if path.steps[0].index==2147483647 || path.steps[0].index==at {z:=CB_expr(b,item,CB_tail(path),storage,temp[..]);r=CB_merge(b,out,r,temp[..],z);}item=b.c.nodes[item].next;at+=1;}return r;
 }
 if e.kind==CK_Tag.expr_call {
  summary:[64]BS_Origin;s:=CB_query(b,1,e.proc,path,summary[..]);
  r:=CB_Result.{incomplete=s.incomplete};
  for i:0..<s.count {
   origin:=summary[i];if origin.kind!=BS_PARAMETER {r=CB_put(b,out,r,origin);continue;}
   actual:=CB_at(b,e.head,origin.root);if actual<2 {return CB_Result.{};}
   // An origin whose place is an array names storage the view parameter
   // points into, not a descriptor held there, so the caller's actual is
   // read for its storage at that place too: a slice of the caller's array
   // passed on is the same borrow.
   place:=CB_type(b,b.c.nodes[CB_at(b,b.c.nodes[e.proc].head,origin.root)].type,origin.path);temp:[64]BS_Origin;a:=CB_expr(b,actual,origin.path,origin.role==BS_INLINE || b.c.types[place].kind==CK_Kind.array,temp[..]);r.incomplete=r.incomplete || a.incomplete;
   for j:0..<a.count {if temp[j].type!=origin.type {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}}
   // The enumerated known-term set is complete as a set; this does not
   // qualify the whole value. Its separate incompleteness remains sticky.
   // One valid descriptor binding, matching canonical terms and <=64 values
   // fit both the 64-term output and the foundation's 128-candidate budget.
   one:=[1]BS_Origin.[origin];binding:=[1]BS_Binding.[BS_Binding.{formal=origin,actual_type=origin.type,complete=true,count=a.count}];mapped:[64]BS_Origin;z:=BS_substitute(one[..],true,binding[..],temp[0..<a.count],mapped[..]);r=CB_merge(b,out,r,mapped[..],CB_Result.{count=z.count});
  }return r;
 }
 CK_resource(b.c,b.state[0].loc);return CB_Result.{};
}


