#authority;
#forall "return borrow missing indexed returns and short cached outputs are resource failures" sample:0..<5 {
 nodes:[40]CK_Node;types:[20]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=31,type_count=17}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;memo:[1]CB_State;c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=memo[..]};types[16]=CK_Type.{kind=CK_Kind.view,elem=12};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,head=3,b=7,borrow_returns=31,loc=CK_Loc.{line=5,column=2}};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};nodes[7].kind=CK_Tag.stmt_block;nodes[31]=CK_Node.{kind=CK_Tag.stmt_return,a=8};nodes[8]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3,loc=CK_Loc.{line=9,column=10}};out:[64]BS_Origin;
 if sample==0 {nodes[2].borrow_returns=0;}if sample==1 {nodes[31].kind=CK_Tag.stmt_var;}if sample==2 {nodes[2].borrow_returns=32;}
 if sample==3 {first:=CB_query(b,1,2,BS_Path.{},out[..]);#assert !state[0].fatal && first.count==1 && !first.incomplete;second:=CB_query(b,1,2,BS_Path.{},out[0..<0]);#assert second.count==0 && !second.incomplete;}
 else {r:=CB_query(b,1,2,BS_Path.{},ifx sample==4 then out[0..<0] else out[..]);#assert r.count==0 && !r.incomplete;}
 #assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381";#assert errors[0].loc.line==5 && errors[0].loc.column==2;
}

#test "query index sixteen paths retain exact facts within fixed lookup fuel" {
 nodes:[32]CK_Node;types:[18]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=31,type_count=18}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;scratch:[1280]int;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=scratch[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.array,elem=16,length=16};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=17,borrow_owner=2,loc=CK_Loc.{line=601,column=7}};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};out:[64]BS_Origin;path:=BS_Path.{count=1};path.steps[0].kind=BS_ELEMENT;
 for i:0..<16 {path.steps[0].index=i;r:=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && !r.incomplete && r.count==1 && out[0].root==0 && out[0].type==12 && out[0].path.steps[0].index==i;}
 b.query_index=CB_index_begin(b);#assert !state[0].fatal;path.steps[0].index=0;warm:=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && warm.count==1;work[0].work=1048320;
 for i:0..<64 {path.steps[0].index=i%16;r:=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && state[0].error_count==0 && !r.incomplete && r.count==1 && out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].role==BS_DESCRIPTOR && out[0].type==12 && bs_path_equal(out[0].path,path);}
 #assert work[0].queries==16 && work[0].origins==16 && work[0].work<=1048576;
}
#test "query index dirty prior flow words and new heads preserve all colliding paths" {
 nodes:[32]CK_Node;types:[18]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=31,type_count=18}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;scratch:[1280]int;for i:0..<scratch.count {scratch[i]=-1;}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=scratch[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.array,elem=16,length=32};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=17,borrow_owner=2};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};b.query_index=CB_index_begin(b);out:[64]BS_Origin;path:=BS_Path.{count=1};path.steps[0].kind=BS_ELEMENT;
 for i:0..<32 {path.steps[0].index=i;r:=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && !r.incomplete && r.count==1 && out[0].kind==BS_PARAMETER && out[0].root==0 && bs_path_equal(out[0].path,path);}
 for i:0..<32 {path.steps[0].index=31-i;r:=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && !r.incomplete && r.count==1 && out[0].type==12 && bs_path_equal(out[0].path,path);}
 #assert state[0].error_count==0 && work[0].queries==32 && work[0].origins==32;
}
#forall "query index preserves newest eligible modes active completion and manual lower bounds" mode:0..<7 {
 nodes:[16]CK_Node;types:[18]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=18}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{queries=3,origins=3}];scratch:[1280]int;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=scratch[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2,borrow_query=3};nodes[7]=CK_Node.{kind=CK_Tag.stmt_var,type=16,borrow_owner=2};nodes[8]=nodes[7];
 origins[0]=BS_Origin.{kind=BS_STATIC,root=30,type=12};origins[1]=BS_Origin.{kind=BS_LOCAL,root=7,type=12};origins[2]=BS_Origin.{kind=BS_LOCAL,root=8,type=12};for i:0..<3 {queries[i]=CK_BorrowQuery.{kind=2,decl=3,type=16,status=2,start=i,count=1,next=i};}queries[1].retain_classes=true;queries[2].status=3;
 b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true,retain_classes=mode==1 || mode==3 || mode==6};
 if mode==2 || mode==3 {queries[2].status=1;queries[2].count=0;}if mode==4 {queries[2].status=2;queries[2].count=0;}if mode==5 {queries[2].retain_classes=true;queries[2].status=2;}if mode==6 {queries[2].status=2;origins[2]=origins[0];}
 b.query_index=CB_index_begin(b);out:[64]BS_Origin;out[0]=BS_Origin.{kind=BS_STATIC,root=900,type=12};r:=CB_query(b,2,3,BS_Path.{},out[..]);#assert !state[0].fatal && state[0].error_count==0 && work[0].queries==3 && work[0].origins==3;
 if mode==0 {#assert r.count==1 && r.incomplete && out[0].kind==BS_LOCAL && out[0].root==8;}
 if mode==1 || mode==3 {#assert r.count==1 && !r.incomplete && out[0].kind==BS_LOCAL && out[0].root==7;}
 if mode==2 {#assert r.count==0 && r.incomplete && out[0].root==900;queries[2].status=2;queries[2].count=1;again:=CB_query(b,2,3,BS_Path.{},out[..]);#assert !state[0].fatal && !again.incomplete && again.count==1 && out[0].root==8;}
 if mode==4 {#assert r.count==0 && !r.incomplete && out[0].root==900;}
 if mode==5 {#assert r.count==1 && !r.incomplete && out[0].kind==BS_STATIC && out[0].root==30;}
 if mode==6 {#assert r.count==1 && !r.incomplete && out[0].kind==BS_STATIC && out[0].root==1;}
}
#forall "query index exact short scratch and unowned contexts keep original facts" mode:0..<3 {
 nodes:[12]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=11,type_count=17}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;scratch:[1280]int;for i:0..<scratch.count {scratch[i]=-1;}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=ifx mode==1 then scratch[0..<1279] else scratch[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};if mode!=2 {b.query_index=CB_index_begin(b);}out:[64]BS_Origin;
 for i:0..<3 {r:=CB_query(b,2,3,BS_Path.{},out[..]);#assert !state[0].fatal && !r.incomplete && r.count==1 && out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].role==BS_DESCRIPTOR && out[0].type==12;}
 #assert state[0].error_count==0 && work[0].queries==1 && work[0].origins==1;
}
#test "query index publishes active rows before recursive calls without inventing completeness" {
 nodes:[24]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=23,type_count=17}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;scratch:[1280]int;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=scratch[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};nodes[2]=CK_Node.{kind=CK_Tag.proc,type=16,head=3,b=4,borrow_returns=5};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};nodes[4]=CK_Node.{kind=CK_Tag.stmt_block,head=5};nodes[5]=CK_Node.{kind=CK_Tag.stmt_return,a=6};nodes[6]=CK_Node.{kind=CK_Tag.expr_call,type=16,proc=2,head=7};nodes[7]=CK_Node.{kind=CK_Tag.expr_ident,type=16,borrow_binding=3};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};b.query_index=CB_index_begin(b);out:[64]BS_Origin;
 for i:0..<2 {r:=CB_query(b,1,2,BS_Path.{},out[..]);#assert !state[0].fatal && state[0].error_count==0 && r.count==0 && r.incomplete;}
}
#forall "query index warm current head and selected row metadata refuse before output" mode:0..<21 {
 nodes:[16]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=17}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{queries=2,origins=2}];scratch:[1280]int;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=scratch[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2,borrow_query=2,loc=CK_Loc.{line=602,column=9}};queries[0]=CK_BorrowQuery.{kind=2,decl=3,type=16,status=2,count=1};queries[1]=CK_BorrowQuery.{kind=2,decl=3,type=16,status=2,start=1,count=1,next=1,retain_classes=true};origins[0]=BS_Origin.{kind=BS_STATIC,root=30,type=12};origins[1]=BS_Origin.{kind=BS_LOCAL,root=7,type=12};
 b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};b.query_index=CB_index_begin(b);out:[64]BS_Origin;warm:=CB_query(b,2,3,BS_Path.{},out[..]);#assert !state[0].fatal && warm.count==1 && out[0].root==30;
 if mode==0 {nodes[3].borrow_query=-1;}if mode==1 {nodes[3].borrow_query=3;}if mode==2 {work[0].queries=1;}if mode==3 {queries[1].decl=4;}if mode==4 {queries[1].kind=4;}if mode==5 {queries[1].status=0;}if mode==6 {queries[1].next=2;}if mode==7 {queries[1].path.steps[7].index=1;}if mode==8 {queries[0].type=12;}if mode==9 {queries[0].start=-1;}if mode==10 {queries[0].count=-1;}if mode==11 {queries[0].start=3;}if mode==12 {queries[0].count=3;}if mode==14 {scratch[19]=1;}if mode==15 {for i:0..<8 {if scratch[10+i]==2 {scratch[10+i]=-1;}}}if mode==16 {for i:0..<8 {if scratch[10+i]==2 {scratch[10+i]=3;}}}if mode==17 {scratch[18]=2;}if mode==18 {scratch[8]=1;}if mode==19 {work[0].work=1048576;}if mode==20 {queries[0].decl=4;}
 out[0]=BS_Origin.{kind=BS_STATIC,root=900,type=12};r:=CB_query(b,2,3,BS_Path.{},ifx mode==13 then out[0..<0] else out[..]);#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && r.count==0 && out[0].root==900 && state[0].retain_report_count==0;
}
#forall "query index lazy rebuild validates complete existing origin chain before publication" malformed:0..<7 {
 nodes:[12]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=11,type_count=17}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{queries=2,origins=1}];scratch:[1280]int;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=scratch[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2,borrow_query=2};queries[0]=CK_BorrowQuery.{kind=2,decl=3,type=16,status=2,count=1};queries[1]=CK_BorrowQuery.{kind=2,decl=3,type=16,status=2,count=1,next=1};origins[0]=BS_Origin.{kind=BS_STATIC,root=30,type=12};
 if malformed==0 {queries[0].decl=4;}if malformed==1 {queries[0].kind=4;}if malformed==2 {queries[0].status=4;}if malformed==3 {queries[0].next=1;}if malformed==4 {queries[0].next=-1;}if malformed==5 {queries[0].path.steps[7].kind=BS_FIELD;}if malformed==6 {work[0].work=1048575;}
 b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};b.query_index=CB_index_begin(b);out:[64]BS_Origin;out[0]=BS_Origin.{kind=BS_STATIC,root=900,type=12};r:=CB_query(b,2,3,BS_Path.{},out[..]);#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && r.count==0 && out[0].root==900;
}
#test "query index full pools reuse facts and reject an additional key without allocation" {
 nodes:[16]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=17}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{queries=128,origins=1024}];scratch:[1280]int;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=scratch[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2,borrow_query=128};nodes[4]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};queries[127]=CK_BorrowQuery.{kind=2,decl=3,type=16,status=2,count=1};origins[0]=BS_Origin.{kind=BS_PARAMETER,root=0,role=BS_DESCRIPTOR,type=12};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};b.query_index=CB_index_begin(b);out:[64]BS_Origin;
 for i:0..<2 {r:=CB_query(b,2,3,BS_Path.{},out[..]);#assert !state[0].fatal && !r.incomplete && r.count==1 && out[0].kind==BS_PARAMETER && out[0].root==0 && work[0].queries==128 && work[0].origins==1024;}
 out[0]=BS_Origin.{kind=BS_STATIC,root=900,type=12};r:=CB_query(b,2,4,BS_Path.{},out[..]);#assert state[0].fatal && errors[0].code=="E0381" && r.count==0 && out[0].root==900 && work[0].queries==128 && work[0].origins==1024;
}
#forall "query index validates skipped original head before trusting nonhead bucket" fault:0..<9 {
 nodes:[16]CK_Node;types:[18]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=15,type_count=18}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{queries=2,origins=2}];scratch:[1280]int;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=scratch[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.array,elem=16,length=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=17,borrow_owner=2,borrow_query=2};left:=BS_Path.{count=1};left.steps[0]=BS_Step.{kind=BS_ELEMENT,index=0};right:=left;right.steps[0].index=1;queries[0]=CK_BorrowQuery.{kind=2,decl=3,type=16,path=left,status=2,count=1};queries[1]=CK_BorrowQuery.{kind=2,decl=3,type=16,path=right,status=2,start=1,count=1,next=1};origins[0]=BS_Origin.{kind=BS_PARAMETER,root=0,role=BS_DESCRIPTOR,type=12,path=left};origins[1]=origins[0];origins[1].path=right;
 b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};b.query_index=CB_index_begin(b);out:[64]BS_Origin;warm:=CB_query(b,2,3,left,out[..]);#assert !state[0].fatal && warm.count==1 && bs_path_equal(out[0].path,left);
 if fault==0 {nodes[3].borrow_query=-1;}if fault==1 {work[0].queries=1;}if fault==2 {queries[1].decl=4;}if fault==3 {queries[1].kind=4;}if fault==4 {queries[1].status=0;}if fault==5 {queries[1].next=2;}if fault==6 {queries[1].next=-1;}if fault==7 {queries[1].path.steps[7].index=1;}if fault==8 {scratch[19]=1;}
 out[0]=BS_Origin.{kind=BS_STATIC,root=900,type=12};r:=CB_query(b,2,3,left,out[..]);#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && r.count==0 && out[0].root==900;
}
#test "query index exhausted new record commit refuses before active or origin publication" {
 nodes:[12]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=11,type_count=17}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;scratch:[1280]int;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=scratch[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};b.query_index=CB_index_begin(b);work[0].work=1048576;out:[64]BS_Origin;out[0]=BS_Origin.{kind=BS_STATIC,root=900,type=12};r:=CB_query(b,2,3,BS_Path.{},out[..]);#assert state[0].fatal && errors[0].code=="E0381" && r.count==0 && out[0].root==900 && nodes[3].borrow_query==0 && work[0].queries==0 && work[0].origins==0;
}

#test "query index rebuilds existing A1 facts over dirty completed flow scratch" {
 nodes:[12]CK_Node;types:[17]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=11,type_count=17}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{queries=1,origins=1}];scratch:[1280]int;for i:0..<scratch.count {scratch[i]=i+7;}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=scratch[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2,borrow_query=1};queries[0]=CK_BorrowQuery.{kind=2,decl=3,type=16,status=2,count=1};origins[0]=BS_Origin.{kind=BS_PARAMETER,root=0,role=BS_DESCRIPTOR,type=12};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};b.query_index=CB_index_begin(b);out:[64]BS_Origin;r:=CB_query(b,2,3,BS_Path.{},out[..]);#assert !state[0].fatal && state[0].error_count==0 && r.count==1 && !r.incomplete && out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].role==BS_DESCRIPTOR && out[0].type==12 && work[0].queries==1 && work[0].origins==1;
}
#test "query index short scratch keeps full original 128 row capacity linear" {
 nodes:[80]CK_Node;types:[18]CK_Type;errors:[4]CK_Error;state:=[1]CK_State.[CK_State.{used=79,type_count=18}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;scratch:[1279]int;
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..],result_work=scratch[..]};for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.array,elem=16,length=2};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};for i:0..<64 {nodes[i+3]=CK_Node.{kind=CK_Tag.param,type=17,borrow_owner=2,next=ifx i==63 then 0 else i+4};}b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};b.query_index=CB_index_begin(b);out:[64]BS_Origin;path:=BS_Path.{count=1};path.steps[0].kind=BS_ELEMENT;
