#test "R2 current part23 empty projections cannot evict completed field witnesses" {
 nodes:[96]CK_Node;types:[20]CK_Type;errors:[8]CK_Error;state:=[1]CK_State.[CK_State.{used=95,type_count=20}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.view,elem=13};types[18]=CK_Type.{kind=CK_Kind.struct_,decl=10};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=18,borrow_owner=2,next=4};nodes[4]=CK_Node.{kind=CK_Tag.param,type=16,borrow_owner=2};nodes[10]=CK_Node.{kind=CK_Tag.struct_,head=20};for i:0..<64 {nodes[20+i]=CK_Node.{kind=CK_Tag.field,type=ifx i==0 then 17 else 16,next=ifx i==63 then 0 else 21+i};}c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};path:=BS_Path.{count=1};path.steps[0].kind=BS_FIELD;out:[2]BS_Origin;
 for i:0..<8 {path.steps[0].index=i*8;#assert CB_type(b,18,path)>0 && !state[0].fatal;}order:=[4]int.[0,8,0,8];for i:order {path.steps[0].index=i;r:=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && r.count==1 && out[0].type==(ifx i==0 then 13 else 12);}
 r:=CB_query(b,2,4,BS_Path.{},out[..]);#assert !state[0].fatal && r.count==1 && out[0].kind==BS_PARAMETER && out[0].root==1;
 work[0].work=1048573;path.steps[0].index=0;r=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && state[0].error_count==0 && r.count==1 && !r.incomplete && out[0].root==0 && out[0].type==13 && bs_path_equal(out[0].path,path);
}

