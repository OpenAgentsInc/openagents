#authority;
#test "R2 projection witness reuses two distant field blocks within remaining work" {
 nodes:[96]CK_Node;types:[19]CK_Type;errors:[8]CK_Error;state:=[1]CK_State.[CK_State.{used=95,type_count=19}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:[1]CB_State;
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.view,elem=13};types[18]=CK_Type.{kind=CK_Kind.struct_,decl=10};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=18,borrow_owner=2};nodes[10]=CK_Node.{kind=CK_Tag.struct_,head=20};for i:0..<64 {nodes[20+i]=CK_Node.{kind=CK_Tag.field,type=ifx i==0 then 17 else 16,next=ifx i==63 then 0 else 21+i};}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};p:=BS_Path.{count=1};p.steps[0].kind=BS_FIELD;out:[2]BS_Origin;
 for i:0..<8 {p.steps[0].index=i*8;#assert CB_type(b,18,p)>0 && !state[0].fatal;}
 for i:0..<4 {p.steps[0].index=ifx i%2==0 then 0 else 8;r:=CB_query(b,2,3,p,out[..]);#assert !state[0].fatal && !r.incomplete && r.count==1;}
 work[0].work=1048512;
 for i:0..<16 {p.steps[0].index=ifx i%2==0 then 0 else 8;r:=CB_query(b,2,3,p,out[..]);#assert !state[0].fatal && state[0].error_count==0 && !r.incomplete && r.count==1 && out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].type==(ifx i%2==0 then 13 else 12) && out[0].role==BS_DESCRIPTOR && out[0].path.count==1 && out[0].path.steps[0].index==p.steps[0].index;}
 #assert work[0].work<=1048576;
}
#forall "R2 projection witness preserves endpoint row prefix and mode refusals" mode:0..<15 {
 nodes:[96]CK_Node;types:[19]CK_Type;errors:[8]CK_Error;state:=[1]CK_State.[CK_State.{used=95,type_count=19}];queries:[128]CK_BorrowQuery;origins:[1024]BS_Origin;work:=[1]CB_State.[CB_State.{loc=CK_Loc.{line=71,column=9,offset=7109}}];
 for i:0..<16 {types[i]=CK_builtin(i);}types[16]=CK_Type.{kind=CK_Kind.view,elem=12};types[17]=CK_Type.{kind=CK_Kind.view,elem=13};types[18]=CK_Type.{kind=CK_Kind.struct_,decl=10};nodes[2]=CK_Node.{kind=CK_Tag.proc,head=3};nodes[3]=CK_Node.{kind=CK_Tag.param,type=18,borrow_owner=2,loc=CK_Loc.{line=81,column=7,offset=8107}};nodes[10]=CK_Node.{kind=CK_Tag.struct_,head=20};for i:0..<64 {nodes[20+i]=CK_Node.{kind=CK_Tag.field,type=ifx i==0 then 17 else 16,next=ifx i==63 then 0 else 21+i};}
 c:=CK_Context.{nodes=nodes[..],types=types[..],errors=errors[..],state=state[..]};b:=CB_Context.{c=c,queries=queries[..],origins=origins[..],state=work[..],retain_fields=true};p:=BS_Path.{count=1};p.steps[0]=BS_Step.{kind=BS_FIELD,index=56};out:[2]BS_Origin;r:=CB_query(b,2,3,p,out[..]);#assert !state[0].fatal && r.count==1 && !r.incomplete;
 row:=types[18].retain_fields-1;memo:=nodes[3].borrow_query-1;
 if mode==1 {nodes[76].type=0;}if mode==2 {nodes[76].type=17;}if mode==3 {queries[row].status=3;}if mode==4 {queries[row].next=row+1;}if mode==5 {queries[row].count=21;}
 if mode==6 {p.steps[0].index=0;}if mode==7 {b.retain_classes=true;}if mode==8 {b.retain_fields=false;}if mode==9 {work[0].queries=0;}if mode==10 {work[0].origins=0;}if mode==11 {queries[memo].status=1;}if mode==12 {queries[memo].status=3;}if mode==13 {queries[memo].type=17;}if mode==14 {queries[memo].retain_classes=true;work[0].queries=128;}
 out[0]=BS_Origin.{kind=BS_STATIC,root=901,type=12};out[1]=BS_Origin.{kind=BS_STATIC,root=902,type=12};r=CB_query(b,2,3,p,out[..]);
 if (mode>=1 && mode<=5) || mode==9 || mode==10 || mode==13 || mode==14 {#assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && r.count==0 && !r.incomplete && out[0].root==901 && out[1].root==902;}
 else if mode==11 {#assert !state[0].fatal && state[0].error_count==0 && r.count==0 && r.incomplete && out[0].root==901;}
 else {#assert !state[0].fatal && state[0].error_count==0 && r.count==1 && r.incomplete==(mode==12) && out[0].kind==BS_PARAMETER && out[0].root==0 && out[0].type==(ifx mode==6 then 13 else 12) && out[0].path.steps[0].index==p.steps[0].index && out[1].root==902;}
}

