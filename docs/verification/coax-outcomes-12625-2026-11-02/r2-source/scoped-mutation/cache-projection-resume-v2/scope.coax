 nodes[20].kind=CK_Tag.invalid;out[0]=BS_Origin.{kind=BS_STATIC,root=901,type=12};out[1]=BS_Origin.{kind=BS_STATIC,root=902,type=12};r=CB_query(b,2,3,p,out[..]);
 #assert state[0].fatal && state[0].error_count==1 && errors[0].code=="E0381" && errors[0].loc.line==72 && errors[0].loc.column==9 && errors[0].loc.offset==7209 && r.count==0 && !r.incomplete && out[0].root==901 && out[1].root==902;
