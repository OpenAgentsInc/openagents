 path.steps[0].index=(1-block)*8;#assert CB_type(b,18,path)>0 && !state[0].fatal;path.steps[0].index=block*8;r:=CB_query(b,2,3,path,out[..]);#assert !state[0].fatal && r.count==1 && out[0].type==(ifx block==0 then 13 else 12);
 work[0].work=1048575;#assert CB_type(b,18,path)==(ifx block==0 then 17 else 16) && !state[0].fatal && state[0].error_count==0;
