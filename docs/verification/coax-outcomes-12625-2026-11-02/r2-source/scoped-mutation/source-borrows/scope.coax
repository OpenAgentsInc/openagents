#load "coax/lib/compiler/checker.coax";
#authority;
CB_variant :: (b:CB_Context,type:int,ordinal:int)->int {
 if type<16 || type>=b.c.state[0].type_count || ordinal<0 || ordinal>=64 || !CB_tick(b,b.state[0].loc) {CK_resource(b.c,b.state[0].loc);return 0;}
 r:=b.c.types[type];payload:=0;
 if r.kind==CK_Kind.union_ {field:=CB_at(b,b.c.nodes[r.decl].head,ordinal);if field==0 {return 0;}f:=b.c.nodes[field];if f.kind!=CK_Tag.variant || f.value!=cast(u64)ordinal {CK_resource(b.c,b.state[0].loc);return 0;}payload=f.type;}
 else if r.kind==CK_Kind.result || r.kind==CK_Kind.optional {payload=CK_sum_payload(b.c,type,ordinal);}
 if payload<1 || payload>=b.c.state[0].type_count {CK_resource(b.c,b.state[0].loc);return 0;}return payload;
}

CB_discover :: (b:CB_Context,type:int,start_depth:int,mutable:bool)->bool {
 if start_depth<0 {CK_resource(b.c,b.state[0].loc);return false;}fields:[256]int;depths:[256]int;used:=0;t:=type;depth:=start_depth;again:=true;
 while again {
  if !CB_tick(b,b.state[0].loc) {return false;}if t<1 || t>=b.c.state[0].type_count {CK_resource(b.c,b.state[0].loc);return false;}r:=b.c.types[t];
  if CK_sum(b.c,t) {if depth>=256 {CK_resource(b.c,b.state[0].loc);return false;}for variant:0..<CK_sum_count(b.c,t) {payload:=CB_variant(b,t,variant);if payload==0 {return false;}if CB_discover(b,payload,depth+1,mutable) {return true;}if b.c.state[0].fatal {return false;}}}
  if !mutable && t==3 {return true;}if r.kind==CK_Kind.view {if !mutable {return true;}if CB_has_borrow(b,r.elem,0) {return true;}}
  if r.kind==CK_Kind.array || r.kind==CK_Kind.struct_ {
   if depth>=256 {CK_resource(b.c,b.state[0].loc);return false;}
   if r.kind==CK_Kind.array {if r.length>0 {t=r.elem;depth+=1;continue;}}
   else {field:=CB_fields(b,t);if field!=0 {if field<2 || field>b.c.state[0].used || b.c.nodes[field].kind!=CK_Tag.field {CK_resource(b.c,b.state[0].loc);return false;}fields[used]=b.c.nodes[field].next;depths[used]=depth;used+=1;t=b.c.nodes[field].type;depth+=1;continue;}}
  }
  resumed:=false;
  while used>0 {
   field:=fields[used-1];if field==0 {used-=1;continue;}if field<2 || field>b.c.state[0].used || b.c.nodes[field].kind!=CK_Tag.field {CK_resource(b.c,b.state[0].loc);return false;}
   fields[used-1]=b.c.nodes[field].next;t=b.c.nodes[field].type;depth=depths[used-1]+1;resumed=true;break;
  }
  if !resumed {again=false;}
 }return false;
}

CB_expr :: (b:CB_Context,id:int,path:BS_Path,storage:bool,out:[]BS_Origin)->CB_Result {
 if id<2 || id>b.c.state[0].used {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}e:=b.c.nodes[id];prior_loc:=b.state[0].loc;if e.loc.line>0 {b.state[0].loc=e.loc;}defer b.state[0].loc=prior_loc;if e.type<1 || e.type>=b.c.state[0].type_count {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}if !CB_tick(b,e.loc) {return CB_Result.{};}
 if b.state[0].depth>=32 {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}b.state[0].depth+=1;defer b.state[0].depth-=1;
 if e.kind==CK_Tag.expr_sum || e.kind==CK_Tag.expr_some || e.kind==CK_Tag.expr_null {
  if !CK_sum(b.c,e.type) || e.sum_variant<0 || e.sum_variant>=CK_sum_count(b.c,e.type) || path.count==0 || path.steps[0].kind!=BS_VARIANT {CK_resource(b.c,e.loc);return CB_Result.{};}
  payload:=CB_variant(b,e.type,path.steps[0].index);if payload==0 {return CB_Result.{};}if path.steps[0].index!=e.sum_variant {return CB_Result.{};}
  if payload==1 {if path.count!=1 {CK_resource(b.c,e.loc);}return CB_Result.{};}return CB_expr(b,e.a,CB_tail(path),storage,out);
 }
 if e.kind==CK_Tag.expr_try {operand:=b.c.types[b.c.nodes[e.a].type];variant:=0;if operand.kind==CK_Kind.optional {variant=1;}return CB_expr(b,e.a,CB_prepend(b,path,BS_VARIANT,variant),storage,out);}
 if e.kind==CK_Tag.expr_or_else {
  operand:=b.c.nodes[e.a];success:=0;if b.c.types[operand.type].kind==CK_Kind.optional {success=1;}
  known:=operand.kind==CK_Tag.expr_sum || operand.kind==CK_Tag.expr_some || operand.kind==CK_Tag.expr_null;
  if known && operand.sum_variant!=success {return CB_expr(b,e.b,path,storage,out);}
  r:=CB_expr(b,e.a,CB_prepend(b,path,BS_VARIANT,success),storage,out);if known {return r;}temp:[64]BS_Origin;z:=CB_expr(b,e.b,path,storage,temp[..]);return CB_merge(b,out,r,temp[..],z);
 }
 if e.kind==CK_Tag.expr_ident {
  if e.borrow_binding!=0 {return CB_query(b,ifx storage then cast(u8)3 else cast(u8)2,e.borrow_binding,path,out);}
  if e.constant<2 || e.constant>b.c.state[0].used || b.c.nodes[e.constant].kind!=CK_Tag.constant {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}
  // A constant holds compile-time data only (a #run result cannot hold a
  // view, E0409), so its storage and every descriptor in it are static. One
  // origin stands for them all, rather than one per literal in the table.
  return CB_put(b,out,CB_Result.{},BS_Origin.{kind=BS_STATIC,root=e.constant,type=CB_key(b,CB_type(b,e.type,path),true),path=path});
 }
 if e.kind==CK_Tag.expr_field {return CB_expr(b,e.a,CB_prepend(b,path,BS_FIELD,e.field_index),storage,out);}
 if e.kind==CK_Tag.expr_index {
  t:=b.c.types[b.c.nodes[e.a].type];if t.kind==CK_Kind.view {return CB_expr(b,e.a,CB_prepend(b,path,BS_DEREFERENCE,0),storage,out);}
  index:=2147483647;if b.c.nodes[e.b].kind==CK_Tag.expr_int && b.c.nodes[e.b].value>>31==0 {index=cast(int)b.c.nodes[e.b].value;}return CB_expr(b,e.a,CB_prepend(b,path,BS_ELEMENT,index),storage,out);
 }
 if e.kind==CK_Tag.expr_slice {
  t:=b.c.types[b.c.nodes[e.a].type];if path.count==0 {return CB_expr(b,e.a,path,t.kind==CK_Kind.array,out);}
  if path.steps[0].kind!=BS_DEREFERENCE {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}
  if t.kind==CK_Kind.array {return CB_expr(b,e.a,CB_prepend(b,CB_tail(path),BS_ELEMENT,2147483647),storage,out);}return CB_expr(b,e.a,path,storage,out);
 }
 if e.kind==CK_Tag.expr_cast || e.kind==CK_Tag.expr_run {return CB_expr(b,e.a,path,storage,out);}
 if e.kind==CK_Tag.expr_ifx {r:=CB_expr(b,e.b,path,storage,out);temp:[64]BS_Origin;z:=CB_expr(b,e.c,path,storage,temp[..]);return CB_merge(b,out,r,temp[..],z);}
 // An rvalue's own storage is a temporary. Storage behind one of its
 // descriptors (a dereferencing path) is wherever that descriptor points.
 if storage && CB_direct(b,path).count==path.count {return CB_put(b,out,CB_Result.{},BS_Origin.{kind=BS_LOCAL,root=id,type=CB_key(b,CB_type(b,e.type,path),true),path=path});}
 if e.kind==CK_Tag.expr_string || e.kind==CK_Tag.expr_ct {return CB_put(b,out,CB_Result.{},BS_Origin.{kind=BS_STATIC,root=id,type=CB_descriptor_key(b,CB_type(b,e.type,path))});}
 if e.kind==CK_Tag.expr_struct {
  if path.count==0 || path.steps[0].kind!=BS_FIELD {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}field:=CB_literal_field(b,id,path.steps[0].index);if b.c.state[0].fatal {return CB_Result.{};}if field!=0 {return CB_expr(b,b.c.nodes[field].a,CB_tail(path),storage,out);}return CB_default(b,e.type,path,out);
 }
 if e.kind==CK_Tag.expr_array {
  if path.count==0 || path.steps[0].kind!=BS_ELEMENT {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}r:CB_Result;at:=0;item:=e.head;temp:[64]BS_Origin;
  while item!=0 {if !CB_tick(b,e.loc) {return CB_Result.{};}if path.steps[0].index==2147483647 || path.steps[0].index==at {z:=CB_expr(b,item,CB_tail(path),storage,temp[..]);r=CB_merge(b,out,r,temp[..],z);}item=b.c.nodes[item].next;at+=1;}return r;
 }
 if e.kind==CK_Tag.expr_call {
  summary:[64]BS_Origin;s:=CB_query(b,1,e.proc,path,summary[..]);
  r:=CB_Result.{incomplete=s.incomplete};
  for i:0..<s.count {
   origin:=summary[i];if origin.kind!=BS_PARAMETER {r=CB_put(b,out,r,origin);continue;}
   actual:=CB_at(b,e.head,origin.root);if actual<2 {return CB_Result.{};}
   // An origin whose place is an array names storage the view parameter
   // points into, not a descriptor held there, so the caller's actual is
   // read for its storage at that place too: a slice of the caller's array
   // passed on is the same borrow.
   place:=CB_type(b,b.c.nodes[CB_at(b,b.c.nodes[e.proc].head,origin.root)].type,origin.path);temp:[64]BS_Origin;a:=CB_expr(b,actual,origin.path,origin.role==BS_INLINE || b.c.types[place].kind==CK_Kind.array,temp[..]);r.incomplete=r.incomplete || a.incomplete;
   for j:0..<a.count {if temp[j].type!=origin.type {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}}
   // The enumerated known-term set is complete as a set; this does not
   // qualify the whole value. Its separate incompleteness remains sticky.
   // One valid descriptor binding, matching canonical terms and <=64 values
   // fit both the 64-term output and the foundation's 128-candidate budget.
   one:=[1]BS_Origin.[origin];binding:=[1]BS_Binding.[BS_Binding.{formal=origin,actual_type=origin.type,complete=true,count=a.count}];mapped:[64]BS_Origin;z:=BS_substitute(one[..],true,binding[..],temp[0..<a.count],mapped[..]);r=CB_merge(b,out,r,mapped[..],CB_Result.{count=z.count});
  }return r;
 }
 CK_resource(b.c,b.state[0].loc);return CB_Result.{};
}

CB_query :: (b:CB_Context,kind:u8,decl:int,path:BS_Path,out:[]BS_Origin)->CB_Result {
 if (kind<1 || (kind>3 && kind!=5)) || decl<2 || decl>b.c.state[0].used || !BS_path_valid(path) {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}
 if b.state[0].queries<0 || b.state[0].queries>b.queries.count || b.state[0].origins<0 || b.state[0].origins>b.origins.count {CK_resource(b.c,b.state[0].loc);return CB_Result.{};}
 projection:[1]CB_QueryProjection;expected_type:=CB_query_project(b,kind,decl,path,projection[..]);if b.c.state[0].fatal {return CB_Result.{};}prior_loc:=b.state[0].loc;if b.c.nodes[decl].loc.line>0 {b.state[0].loc=b.c.nodes[decl].loc;}defer b.state[0].loc=prior_loc;
 indirect:=false;for i:0..<path.count {if path.steps[i].kind==BS_DEREFERENCE {indirect=true;}}
 // Direct owned storage has no value/write/alias dependencies or recursion.
 // B1 can derive it without a separate origin-query row or origin span.
 if b.retain_fields && kind==3 && !indirect {owner:=b.c.nodes[decl].borrow_owner;if owner<2 || owner>b.c.state[0].used || (b.c.nodes[owner].kind!=CK_Tag.proc && b.c.nodes[owner].kind!=CK_Tag.check) {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}if !CB_tick(b,b.c.nodes[decl].loc) {return CB_Result.{};}return CB_put(b,out,CB_Result.{},BS_Origin.{kind=BS_LOCAL,root=decl,type=CB_key(b,expected_type,true),path=path});}
 // Per-declaration one-based links keep unrelated procedures out of a lookup.
 // Rows stay append-only: even a recursive query retains its original slot.
 head:=b.c.nodes[decl].borrow_query;link:=head;bucket:=0;if b.query_index {bucket=CB_index_bucket(kind,path);link=CB_index_start(b,decl,head,bucket);if b.c.state[0].fatal {return CB_Result.{};}}
 while link!=0 {
  if link<1 || link>b.state[0].queries {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}
  if !(b.query_index && link==head) {if !CB_tick(b,b.c.nodes[decl].loc) {return CB_Result.{};}}q:=b.queries[link-1];
  if q.decl!=decl || q.kind<1 || (q.kind>3 && q.kind!=5) || q.status<1 || q.status>3 || q.next<0 || q.next>=link || !BS_path_valid(q.path) {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}
  next:=q.next;if b.query_index {next=CB_index_next(b,decl,link,q,bucket);if b.c.state[0].fatal {return CB_Result.{};}}same:=q.retain_classes==b.retain_classes;
  // Complete raw facts survive source normalization. Reverse
  // value/procedure reuse and unknown/active rows remain unsupported.
  if q.kind==kind && bs_path_equal(q.path,path) && (same || (b.retain_fields && q.status==2 && !q.retain_classes)) {
   if q.type!=expected_type {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}if q.status==1 {return CB_Result.{incomplete=true};}
   if q.start<0 || q.count<0 || q.start>b.state[0].origins || q.count>b.state[0].origins-q.start {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}
   if same {if q.count>out.count {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}for i:0..<q.count {out[i]=b.origins[q.start+i];}CB_projection_commit(b,projection[0],link);return CB_Result.{count=q.count,incomplete=q.status==3};}
   // A complete raw dependency graph is already admitted. Derive its class
   // result with the same normalization, without publishing a second row/span.
   if q.count>64 {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}staged:[64]BS_Origin;mapped:CB_Result;
   for i:0..<q.count {if !CB_tick(b,b.c.nodes[decl].loc) {return CB_Result.{};}value:=b.origins[q.start+i];if !BS_origin_valid(value) {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}mapped=CB_put(b,staged[..],mapped,value);}
   if mapped.count>out.count {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}for i:0..<mapped.count {out[i]=staged[i];}CB_projection_commit(b,projection[0],link);return mapped;
  }link=next;
 }
 slot:=b.state[0].queries;if slot>=b.queries.count {CK_resource(b.c,b.c.nodes[decl].loc);return CB_Result.{};}if !CB_index_prepare(b,slot,kind,path,head) {return CB_Result.{};}b.state[0].queries+=1;b.queries[slot]=CK_BorrowQuery.{kind=kind,decl=decl,type=expected_type,path=path,status=1,next=head,retain_classes=b.retain_classes};b.c.nodes[decl].borrow_query=slot+1;r:CB_Result;n:=b.c.nodes[decl];
 if kind==1 {
  if n.kind!=CK_Tag.proc {CK_resource(b.c,n.loc);return CB_Result.{};}if n.flag2 || n.generic || n.b==0 || n.borrow_returns==0 {CK_resource(b.c,n.loc);return CB_Result.{};}
  // A caller asks where an array behind the returned descriptor lives (its
