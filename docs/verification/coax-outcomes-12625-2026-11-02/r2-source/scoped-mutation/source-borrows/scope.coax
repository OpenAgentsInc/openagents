  while ret!=0 {
   if ret<2 || ret>b.c.state[0].used {CK_resource(b.c,n.loc);return CB_Result.{};}edge:=b.c.nodes[ret];z:CB_Result;witness:=b.c.nodes[edge.a].loc;
   if edge.kind==CK_Tag.stmt_return {z=CB_expr(b,edge.a,path,place,temp[..]);}
   else if edge.kind==CK_Tag.expr_try {
    if edge.propagate_type!=n.type || path.count==0 || path.steps[0].kind!=BS_VARIANT {CK_resource(b.c,edge.loc);return CB_Result.{};}
    failure:=ifx b.c.types[n.type].kind==CK_Kind.result then 1 else 0;witness=edge.loc;
    if path.steps[0].index==failure && failure==1 {z=CB_expr(b,edge.a,CB_prepend(b,CB_tail(path),BS_VARIANT,1),place,temp[..]);}
   }else {CK_resource(b.c,n.loc);return CB_Result.{};}
   for i:0..<z.count {if temp[i].kind==BS_LOCAL && b.c.state[0].error_count==0 {CK_error(b.c,witness,"E0383","returned borrow may refer to local inline storage through a helper or aggregate","return owned storage, or keep the borrowed backing in the caller");break;}}
   r=CB_merge(b,out,r,temp[..],z);ret=edge.borrow_next;
  }
 }else {
  owner:=n.borrow_owner;if owner<2 || owner>b.c.state[0].used || (b.c.nodes[owner].kind!=CK_Tag.proc && b.c.nodes[owner].kind!=CK_Tag.check) {CK_resource(b.c,n.loc);return CB_Result.{};}
  t:=expected_type;
  if kind==3 && !indirect {r=CB_put(b,out,r,BS_Origin.{kind=BS_LOCAL,root=decl,type=CB_key(b,t,true),path=path});}
  else if kind==5 {if n.kind!=CK_Tag.param || !indirect {CK_resource(b.c,n.loc);return CB_Result.{};}}
  else if n.kind==CK_Tag.param {
   at:=b.c.nodes[owner].head;ordinal:=0;while at!=decl {if at<2 || at>b.c.state[0].used || !CB_tick(b,n.loc) {CK_resource(b.c,n.loc);return CB_Result.{};}at=b.c.nodes[at].next;ordinal+=1;}
   r=CB_put(b,out,r,BS_Origin.{kind=BS_PARAMETER,root=ordinal,role=BS_DESCRIPTOR,type=CB_key(b,t,kind==3),path=path});
  }else if n.kind==CK_Tag.case_binding {r=CB_expr(b,n.a,CB_prepend(b,path,BS_VARIANT,n.sum_variant),kind==3,out);}
  else if n.kind==CK_Tag.stmt_var {if n.a!=0 {r=CB_expr(b,n.a,path,kind==3,out);}else {r=CB_default(b,n.type,path,out);}}
  else if n.kind==CK_Tag.stmt_each {collection:=b.c.types[b.c.nodes[n.a].type];r=CB_expr(b,n.a,CB_prepend(b,path,ifx collection.kind==CK_Kind.array then BS_ELEMENT else BS_DEREFERENCE,ifx collection.kind==CK_Kind.array then 2147483647 else 0),false,out);}
  else {CK_resource(b.c,n.loc);return CB_Result.{};}
  if !(kind==3 && !indirect) {write:=n.borrow_writes;temp:[64]BS_Origin;
  while write!=0 {p:=CB_place(b,b.c.nodes[write].c);if p.decl!=decl {CK_resource(b.c,n.loc);return CB_Result.{};}if CB_prefix(p.path,path) {rest:BS_Path;for i:p.path.count..<path.count {rest=CB_add_path(b,rest,path.steps[i].kind,path.steps[i].index);}z:=CB_expr(b,b.c.nodes[write].a,rest,kind==3,temp[..]);if kind==5 {CB_external_local(b,b.c.nodes[write].a,temp[..],z);}r=CB_merge(b,out,r,temp[..],z);}write=b.c.nodes[write].borrow_next;}
  r=CB_alias_writes_mode(b,decl,path,out,r,kind==5);
  // Raw return queries compose selected helper writes. Retained-store-only
  // misses keep B1's manual boundary; a complete raw memo above is reusable.
  // This never certifies unknown effects or expands the shared work budget.
  if b.retain_fields {r.incomplete=r.incomplete || CB_opaque(b,decl,path);}
  else {r=CB_call_writes(b,decl,path,out,r);}}
 }
 if b.c.state[0].fatal {return CB_Result.{};}if r.count>b.origins.count-b.state[0].origins {CK_resource(b.c,n.loc);return CB_Result.{};}
 start:=b.state[0].origins;for i:0..<r.count {b.origins[start+i]=out[i];}b.state[0].origins+=r.count;b.queries[slot].start=start;b.queries[slot].count=r.count;b.queries[slot].status=ifx r.incomplete then cast(u8)3 else cast(u8)2;CB_projection_commit(b,projection[0],slot+1);return r;
}

CB_leaf_count :: (b:CB_Context,type:int)->int {
 if type<1 || type>=b.c.state[0].type_count {CK_resource(b.c,b.state[0].loc);return 0;}r:=b.c.types[type];
 if (type==3 && r.kind==CK_Kind.string_) || r.kind==CK_Kind.view {return 1;}n:=0;
 if r.kind==CK_Kind.array {n=r.length*CB_leaf_count(b,r.elem);}
 else if CK_sum(b.c,type) {
  // Count every possible payload, not only a constructor's active variant.
  // Unit/owned payloads contribute zero; the existing overflow sentinel stays128.
  count:=CK_sum_count(b.c,type);variant:=0;while variant<count && n<=64 {payload:=CB_variant(b,type,variant);if payload==0 {return 0;}if CB_has_borrow(b,payload,0) {n+=CB_leaf_count(b,payload);}variant+=1;}
 }
 else if r.kind==CK_Kind.struct_ {field:=CB_fields(b,type);while field!=0 && n<=64 {if CB_has_borrow(b,b.c.nodes[field].type,0) {n+=CB_leaf_count(b,b.c.nodes[field].type);}field=b.c.nodes[field].next;}}
 else if r.kind==CK_Kind.void_ || r.kind==CK_Kind.integer || r.kind==CK_Kind.floating || r.kind==CK_Kind.bool_ || r.kind==CK_Kind.untyped_int || r.kind==CK_Kind.untyped_float || r.kind==CK_Kind.enum_ {return 0;}
 else {CK_resource(b.c,b.state[0].loc);return 0;}
 return ifx n>64 then 128 else n;
}
