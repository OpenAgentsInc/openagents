#load "coax/lib/compiler/checker.coax";
#authority;
// Only CB_run enables this after A1 and completed Result handling, on fresh
// invocation-owned state. Scratch views retain the existing valid/disjoint/
// exclusive ownership contract. Short scratch and direct contexts stay linear.
// Frozen concrete query keys/next links are the trust boundary: skipped old
// metadata is not reauthenticated after this private phase builds its index.
CB_index_bucket :: (kind:u8,path:BS_Path)->int {
 // Every caller has admitted the ordinary origin kinds1..3 or write-summary kind5; only path mixing needs a mask.
 hash:=cast(int)kind;for i:0..<path.count {hash=((hash<<1) ^ cast(int)path.steps[i].kind ^ path.steps[i].index) & 7;}return hash;
}
CB_index_begin :: (b:CB_Context)->bool {
 if b.queries.count>b.c.result_work.count/10 {return false;}
 // A1 owns this committed prefix. Invalidate only each head marker; rebuild
 // initializes every visited next link and all eight snapshot heads before
 // publishing that marker. No other old RF word can be read beforehand.
 for slot:0..<b.state[0].queries {if !CB_tick(b,b.state[0].loc) {return false;}b.c.result_work[slot*10+9]=0;}
 return true;
}
// Every rejected probe sets or preserves fatal. Callers stop before reading any row or scratch.
CB_index_probe :: (b:CB_Context,decl:int,link:int) {
 if link<1 || link>b.state[0].queries {CK_resource(b.c,b.c.nodes[decl].loc);}
 else if CB_tick(b,b.c.nodes[decl].loc) {
  q:=b.queries[link-1];
  if q.decl!=decl || q.kind<1 || (q.kind>3 && q.kind!=5) || q.status<1 || q.status>3 || q.next<0 || q.next>=link || !BS_path_valid(q.path) {CK_resource(b.c,b.c.nodes[decl].loc);}
 }
}
// On fatal the private link value is unspecified; the sole CB_query caller
// checks fatal before using it. Bounds failures still stop immediately.
CB_index_start :: (b:CB_Context,decl:int,head:int,bucket:int)->int {
 if head==0 {return 0;}
 // Validate the ORIGINAL head before any scratch access or substitution.
 CB_index_probe(b,decl,head);if b.c.state[0].fatal {return head;}base:=(head-1)*10;marker:=b.c.result_work[base+9];
 if marker==0 {
  heads:[8]int;tails:[8]int;link:=head;
  while link!=0 {
   if link!=head {CB_index_probe(b,decl,link);if b.c.state[0].fatal {return link;}}q:=b.queries[link-1];at:=CB_index_bucket(q.kind,q.path);prior:=tails[at];
   if prior==0 {heads[at]=link;}else {b.c.result_work[(prior-1)*10+8]=link;}b.c.result_work[(link-1)*10+8]=0;tails[at]=link;link=q.next;
  }
  // Each visited row was charged. Publish the complete snapshot last.
  for i:0..<8 {b.c.result_work[base+i]=heads[i];}b.c.result_work[base+9]=head;
 }else if marker!=head {CK_resource(b.c,b.c.nodes[decl].loc);return 0;}
 link:=b.c.result_work[base+bucket];if link<0 || link>head {CK_resource(b.c,b.c.nodes[decl].loc);return link;}return link;
}
CB_index_next :: (b:CB_Context,decl:int,link:int,q:CK_BorrowQuery,bucket:int)->int {
 next:=b.c.result_work[(link-1)*10+8];
 if next<0 || next>=link || next>q.next || CB_index_bucket(q.kind,q.path)!=bucket {CK_resource(b.c,b.c.nodes[decl].loc);return 0;}return next;
}
CB_index_prepare :: (b:CB_Context,slot:int,kind:u8,path:BS_Path,head:int)->bool {
 if !b.query_index {return true;}staged:[10]int;
 if head!=0 {for i:0..<8 {staged[i]=b.c.result_work[(head-1)*10+i];}}
 bucket:=CB_index_bucket(kind,path);staged[8]=staged[bucket];staged[bucket]=slot+1;staged[9]=slot+1;
 // The sole ordinary-origin allocation site commits a fully initialized row
 // before ACTIVE/head publication. Recursion can then observe that active row.
 if !CB_tick(b,b.state[0].loc) {return false;}for i:0..<10 {b.c.result_work[slot*10+i]=staged[i];}return true;
}

#authority;
// Private typed-projection witnesses. They cache field resolution, never origin
// facts. The complete declaration query chain and raw/class eligibility remain
// authoritative. Only successful completed query rows publish a witness.
CB_ProjectionStep :: struct {type:int;decl:int;head:int;field_head:int;row:int;field:int;next_type:int;}
CB_QueryProjection :: struct {decl:int;kind:u8;classes:bool;root:int;type:int;path:BS_Path;query:int;head:int;used:int;types:int;steps:[8]CB_ProjectionStep;}
// The private hit value is unspecified after fatal; its sole caller checks fatal before use.
CB_projection_hit :: (b:CB_Context,p:CB_QueryProjection,kind:u8,decl:int,path:BS_Path)->bool {
 if p.classes!=b.retain_classes || p.root!=b.c.nodes[decl].type || p.used!=b.c.state[0].used || p.types!=b.c.state[0].type_count || p.head!=b.c.nodes[decl].borrow_query {return false;}
 if p.query<1 || p.query>b.state[0].queries {return false;}memo:=b.queries[p.query-1];
 if memo.decl!=decl || memo.kind!=kind || memo.status!=2 || !bs_path_equal(memo.path,path) || !(memo.retain_classes==b.retain_classes || !memo.retain_classes) {return false;}
 t:=p.root;
 for i:0..<path.count {
  // Published step types were admitted composite IDs in the unchanged p.types prefix.
  w:=p.steps[i];step:=path.steps[i];if w.type!=t {return false;}r:=b.c.types[t];
  if step.kind==BS_FIELD && r.kind==CK_Kind.struct_ {
   if r.decl!=w.decl || r.decl<2 || r.decl>b.c.state[0].used || b.c.nodes[r.decl].kind!=CK_Tag.struct_ || b.c.nodes[r.decl].head!=w.head || r.retain_fields!=w.field_head {return false;}
   // CB_field published this head in the same used prefix; the current declaration head still matches.
   if b.c.nodes[w.head].kind!=CK_Tag.field {CK_resource(b.c,b.state[0].loc);return false;}
   if w.row<1 || w.row>b.state[0].queries || w.field_head<1 || w.field_head>b.state[0].queries {CK_resource(b.c,b.state[0].loc);return false;}
   charged:=CB_tick(b,b.state[0].loc);if !charged {return charged;}q:=b.queries[w.row-1];
   if q.kind!=4 || q.decl!=t || q.type!=r.decl || q.status!=2 || q.count!=w.head || q.retain_classes || q.start!=step.index/8 || q.path.count!=0 || q.next<0 || q.next>=w.row {CK_resource(b.c,b.state[0].loc);return false;}
   for j:0..<8 {if q.path.steps[j].kind!=0 {CK_resource(b.c,b.state[0].loc);return charged;}}
   if q.path.steps[step.index%8].index!=w.field {return false;}
   if w.field<2 || w.field>b.c.state[0].used {CK_resource(b.c,b.state[0].loc);return false;}
   f:=b.c.nodes[w.field];if f.kind!=CK_Tag.field || f.type<1 || f.type>=b.c.state[0].type_count {CK_resource(b.c,b.state[0].loc);return false;}
   if f.type!=w.next_type {return false;}t=f.type;
   b.state[0].field_type=w.type;b.state[0].field_block=step.index/8;b.state[0].field_head=w.field_head;b.state[0].field_row=w.row;
  }else if step.kind==BS_ELEMENT && r.kind==CK_Kind.array && (step.index==2147483647 || step.index<r.length) {t=r.elem;}
  else if step.kind==BS_DEREFERENCE && r.kind==CK_Kind.view {t=r.elem;}
  else {return false;}
 }
 return t==p.type && t>=1 && t<b.c.state[0].type_count;
}
// On fatal, the private returned type is unspecified; CB_query immediately
// checks fatal before any use. Stop here without another probe or record write.
CB_query_project :: (b:CB_Context,kind:u8,decl:int,path:BS_Path,record:[]CB_QueryProjection)->int {
 // Keep A1, empty projections and new active-variant paths on the original
 // resolver. Source can extend this witness independently after its variant
 // validator is qualified; this optimization supplies no sum-path permission.
 eligible:=b.retain_fields && path.count>0;for i:0..<path.count {if path.steps[i].kind!=BS_FIELD && path.steps[i].kind!=BS_ELEMENT && path.steps[i].kind!=BS_DEREFERENCE {eligible=false;}}
 if !eligible {return CB_type(b,b.c.nodes[decl].type,path);}
 for i:0..<2 {p:=b.state[0].projections[i];hit:=CB_projection_hit(b,p,kind,decl,path);if b.c.state[0].fatal {return p.type;}if hit {record[0]=p;return p.type;}}
 // One original walk, recording only field rows that CB_field has admitted.
 p:=CB_QueryProjection.{decl=decl,kind=kind,classes=b.retain_classes,root=b.c.nodes[decl].type,path=path,used=b.c.state[0].used,types=b.c.state[0].type_count};t:=p.root;
 if !BS_path_valid(path) {CK_resource(b.c,b.state[0].loc);return 0;}
 for i:0..<path.count {
  if t<16 || t>=b.c.state[0].type_count {CK_resource(b.c,b.state[0].loc);return p.type;}r:=b.c.types[t];step:=path.steps[i];w:=CB_ProjectionStep.{type=t};
  if step.kind==BS_FIELD && r.kind==CK_Kind.struct_ {field:=CB_field(b,t,step.index);if field==0 {return 0;}w.decl=r.decl;w.head=b.c.nodes[r.decl].head;w.field_head=b.c.types[t].retain_fields;w.row=b.state[0].field_row;w.field=field;t=b.c.nodes[field].type;}
  else if step.kind==BS_ELEMENT && r.kind==CK_Kind.array && (step.index==2147483647 || step.index<r.length) {t=r.elem;}
  else if step.kind==BS_DEREFERENCE && r.kind==CK_Kind.view {t=r.elem;}
  else {CK_resource(b.c,b.state[0].loc);return p.type;}w.next_type=t;p.steps[i]=w;
 }
 if t<1 || t>=b.c.state[0].type_count {CK_resource(b.c,b.state[0].loc);return 0;}p.type=t;record[0]=p;return t;
}
CB_projection_commit :: (b:CB_Context,pending:CB_QueryProjection,query:int) {
 if pending.decl==0 || b.queries[query-1].status!=2 {return;}p:=pending;p.query=query;p.head=b.c.nodes[p.decl].borrow_query;
 for i:0..<2 {old:=b.state[0].projections[i];if old.decl==p.decl && old.kind==p.kind && old.classes==p.classes && bs_path_equal(old.path,p.path) {b.state[0].projections[i]=p;return;}}
 slot:=ifx b.state[0].projection_next then 1 else 0;b.state[0].projections[slot]=p;b.state[0].projection_next=!b.state[0].projection_next;
}

#authority;
// Only CB_run enables this on its fresh, invocation-owned CB_State after A1.
// Checked literal heads/links/indices are frozen for B1. Direct contexts stay
// cold, even when retain_fields is true. These witnesses select syntax only:
// every selected source is re-read and analyzed normally, never cached as facts.
CB_LiteralBlock :: struct {id:int;type:int;head:int;used:int;types:int;block:int;fields:[8]int;}
CB_literal_same :: (p:CB_LiteralBlock,id:int,type:int,head:int,used:int,types:int,block:int)->bool {
 return p.id==id && p.type==type && p.head==head && p.used==used && p.types==types && p.block==block;
}
CB_literal_keep :: (b:CB_Context,p:CB_LiteralBlock) {
 if CB_literal_same(b.state[0].literal_current,p.id,p.type,p.head,p.used,p.types,p.block) {b.state[0].literal_current=p;return;}
 if CB_literal_same(b.state[0].literal_previous,p.id,p.type,p.head,p.used,p.types,p.block) {b.state[0].literal_previous=p;return;}
 // Distinct keys retain FIFO insertion order; refreshing an existing key above does not promote it.
 b.state[0].literal_previous=b.state[0].literal_current;b.state[0].literal_current=p;
}
CB_literal_field :: (b:CB_Context,id:int,index:int)->int {
 e:=b.c.nodes[id];enabled:=b.literal_cache && index>=0;block:=0;if enabled {block=index/8;
  p:=b.state[0].literal_current;if !CB_literal_same(p,id,e.type,e.head,b.c.state[0].used,b.c.state[0].type_count,block) {p=b.state[0].literal_previous;}
  if CB_literal_same(p,id,e.type,e.head,b.c.state[0].used,b.c.state[0].type_count,block) {
   // Nonzero slots were visited valid node IDs under this exact frozen pool/prefix key.
   // Keep the live ordinal check: an updated initializer must fall back to the original scan.
   selected:=p.fields[index%8];if selected!=0 && b.c.nodes[selected].field_index==index {if !CB_tick(b,e.loc) {return 0;}return selected;}
  }
 }
 staged:=CB_LiteralBlock.{id=id,type=e.type,head=e.head,used=b.c.state[0].used,types=b.c.state[0].type_count,block=block};field:=e.head;
 while field!=0 {
  if !CB_tick(b,e.loc) {return 0;}f:=b.c.nodes[field];
  // Stage only the actually visited prefix. First occurrence wins even for
  // a supplied duplicate graph; no later initializer or value is inspected.
  if enabled && f.field_index>=0 && f.field_index/8==block {slot:=f.field_index%8;if staged.fields[slot]==0 {staged.fields[slot]=field;}}
  if f.field_index==index {if enabled {CB_literal_keep(b,staged);}return field;}
  field=f.next;
 }return 0; // No negative/default cache, and no publication after failed scan.
}
