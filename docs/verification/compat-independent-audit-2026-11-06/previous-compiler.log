usage: coax run     file.coax [--release]
       coax build   file.coax [-o out] [--release] [--keep-c]
       coax lib     file.coax [-o out.o] [--release] [--keep-c]
       coax header  file.coax [-o out.h]
       coax c       file.coax [--release] [--library [--header out.h] [--split N [--split-unit BYTES]]]
       coax checks-c file.coax [--verification-abi 1|2] [--only SUBSTR] [-o checks.c]  verification-only checked C
       coax metal   file.coax [--vertex V --fragment F [--tree]] [-o out.metal]
       coax cuda    file.coax [--release]
       coax metal-compute file.coax [--release]
       coax spirv   file.coax [--kernel NAME | --fill A[,B,C,D] | --stroke NAME | --vertex V --fragment F [--tree]] [-o out.spv]
       coax wgsl    file.coax (--functions A,B | --vertices A,B --fragments C,D --bindings F [--strip P]) [--tree] [-o out.wgsl]
       coax check   file.coax [--slots N]  (--slots also on run, build, lib, header, c: a smaller slot limit for #authority checks)
       coax proto   profile.pb --prefix Name [-o output.coax]
       coax layout  file.coax
       coax deps    file.coax                           JSON source/descriptor inputs
       coax deps    file.coax --declarations            JSON logical owners, declaration IDs, references
       coax query   file.coax defines NAME | uses NAME | exports [MODULE] [--json] [--fresh]
       coax deps    file.coax --lowering [--proc NAME]  JSON ordered lowering: operations, traps, sequencing
       coax deps    file.coax --effects [--proc NAME]   JSON transitive may-effects and witness paths
       coax deps    file.coax --modules                 JSON module content and dependency revisions
       coax test    file.coax [--steps N] [--slots N] [--only SUBSTR] [--list] [--profile steps] [--evidence FILE]
       coax mutate  file.coax [--jobs N] [--shard I/N | --merge RECORD...] [--evidence FILE]
                    [--root-only | --unit PART.coax] [--killers FILE] [--source-order]
                    [--mutation-reference] [--mutation-stats] [--mutation-trace]
                    --root-only mutates entry-source procedures; all baseline checks still run
                    --unit PART.coax mutates one loaded unit's procedures; every check still runs
                    --killers FILE runs each mutant's last killing check first and records
                    this run's; the verdicts are the same with or without it
                    each mutant tries its likely killers first (the file's, then this run's,
                    then checks entering its procedure, cheapest first); --source-order
                    (implied by --mutation-trace) runs the rest in source order instead;
                    only the work changes, never the report
                    --jobs N evaluates mutants in up to N processes (default: $COAX_MUTATE_JOBS,
                    $COAX_JOBS or the build-worker budget); the report is the same for every N
                    --shard I/N runs mutants I-1, I-1+N, ... and prints a record on stdout
                    --merge RECORD (repeated) combines all N records into the full report
       coax explain CODE | --all [--markdown]
       coax version
       coax source-digest ROOT          (the hash of ROOT/coax's compiler sources)
       coax status [--json] | --jobs [--json]   (the build-worker budget: on stderr, or alone with --jobs)
options: --arithmetic checked|wrapping selects runtime integer arithmetic
       --target native-lp64 names the layout target for layout/deps (others: E0612)
       --opt 0|1|2|3 selects native optimization for run/build/lib
       --build-profile development|release selects BUILD_DEBUG source/layout
       --release retains the legacy wrapping/O2/release/no-debug bundle
       --profile-report FILE records the resolved profile and source/artifact hashes
       --run-steps N sets the bounded aggregate compile-time work limit
       --traversal N sets the aggregate traversal limit of the compilation and of each check without #traversal
       --json prints diagnostics as JSON lines
       --near-limit P notes each limit used above P percent (1 to 100; default 75, or COAX_NEAR_LIMIT)
       --diagnostics json prints coax.diagnostic.v1 lines: spans, notes and fixes
       --debug-info maps native code to original Coax source
       --no-debug-info omits native source debugging independently
       --source-map FILE writes debugger names/locations (implies --debug-info)
       --timings FILE writes phase wall times and generated byte count (JSON; --timings-json FILE is the same)
       --timings-table prints phase, check, library and declaration times on stderr
       --timings-top N lists the N costliest declarations in those reports (default 20)
       --jobs N runs at most N parallel check workers; every coax process shares one build-worker budget (coax status --jobs)

