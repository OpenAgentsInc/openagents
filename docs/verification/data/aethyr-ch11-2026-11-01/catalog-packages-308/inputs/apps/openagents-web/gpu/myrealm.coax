  }
  lit:V3=myrealm_daylight(n,u);
  lit=wg_add_f3f3(lit,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(v3(1.0f32,0.62f32,0.28f32),myrealm_lamp_near(s.world,n,u)),1.6f32),u[55]));
  lit=wg_add_f3f3(lit,wg_add_f3f3(wg_mul_f3f(myrealm_lanterns_near(s.world,n,u),1.4f32),wg_make_f3_f(fmax(s.glow,0.0f32))));
  far:f32=fmax(wg_length3(wg_sub_f3f3(s.world,v3(u[28],u[29],u[30])))-u[39],0.0f32);
  haze:f32=clampf(1.0f32-exp((-far)*0.018f32*(1.0f32+3.0f32*u[43])),0.0f32,1.0f32);
  // a floating island's sky is clear: what floats in it keeps its colour further off
  thick:f32=ifx (myrealm_land(u)>0.5f32)&&(myrealm_land(u)<1.5f32) then 0.4f32 else 0.85f32;
  c:V3=wg_mul_f3f(wg_mix_f3f3f(wg_mul_f3f3(wg_mul_f3f3(myrealm_paletted(v3(tex.x,tex.y,tex.z),u),s.tint),lit),v3(u[48],u[49],u[50]),haze*thick),u[3]);
  return wg_make_f4_f3f(myrealm_panels(v2(s.pos.x,s.pos.y),c,u),1.0f32);
}
// ---- the strokes: one quad per stroke or light (myrealm.coax lit, tinted_dot)
MyrealmV :: struct {pos:V4; place:V2; shape:V4; tint:V4; bar:V4; }
// along, across, pixels
// length, core, light, glow
// red, green, blue, mode
myrealm_fx_vs_in :: struct {a:V4; b:V4; c:V4; d:V4; }
myrealm_fx_vs :: (_vid2:u32,_iid3:u32,in_:myrealm_fx_vs_in,u:[]f32)->MyrealmV {
  a:V4=in_.a;
  b:V4=in_.b;
  c:V4=in_.c;
  d:V4=in_.d;
  o:MyrealmV;
  ndc:V2=v2(((a.x/u[0])*2.0f32)-1.0f32,1.0f32-((a.y/u[1])*2.0f32));
  o.pos=v4(ndc.x,ndc.y,0.0f32,1.0f32);
  o.place=v2(a.z,a.w);
  o.shape=b;
  o.tint=c;
  o.bar=d;
  return o;
}
myrealm_fx_fs :: (v:MyrealmV,u:[]f32)->V4 {
  along:f32=fmax(fmax(-v.place.x,v.place.x-v.shape.x),0.0f32);
  d:f32=wg_length2(v2(along,v.place.y));
  core:f32=1.0f32-smoothstep(v.shape.y-0.5f32,v.shape.y+0.6f32,d);
  g:f32=d/fmax(v.shape.w,1.0f32);
