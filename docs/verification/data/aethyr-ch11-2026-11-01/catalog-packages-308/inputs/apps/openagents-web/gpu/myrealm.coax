// A painted piece: its texture's grain kept as light and dark, its own colour all the tint's.
// Stone in courses: blocks half a metre high and about a metre long, each course offset by half a
// block, each block its own shade, dark mortar between them.
myrealm_masonry :: (p:V3)->f32 {
  row:f32=floor(p.y/0.5f32);
  along:f32=((p.x+(p.z*0.83f32))/1.05f32)+(0.5f32*(row-(2.0f32*floor(row*0.5f32))));
  fu:f32=fract(along);
  fv:f32=fract(p.y/0.5f32);
  joint:f32=fmin(fmin(fu,1.0f32-fu)*1.05f32,fmin(fv,1.0f32-fv)*0.5f32);
  block:f32=(0.78f32+(0.2f32*myrealm_hash(v2(floor(along),row))))+(0.06f32*myrealm_noise(wg_add_f2f2(wg_mul_f2f(v2(p.x,p.z),3.0f32),wg_mul_f2f(v2(p.y,p.y),2.0f32))));
  return mix(0.42f32,block,smoothstep(0.012f32,0.035f32,joint));
}
myrealm_surfaced :: (t:V3,w:f32)->V3 {
  return wg_mix_f3f3f(t,wg_make_f3_f(0.42f32+(0.8f32*wg_dot3(t,v3(0.3f32,0.59f32,0.11f32)))),clampf(-w,0.0f32,1.0f32));
}
myrealm_scene_fs :: (s:MyrealmS,u:[]f32,sheets:Tex2DArray,sheet:Sampler)->V4 {
