    tex=wg_make_f4_f3f(wg_make_f3_f(myrealm_masonry(s.world)),1.0f32);
  }
  // painterly leaves are blobs: their cutout from a nearer mip, so pinholes of sky close up
  cut:f32=ifx bare then 1.0f32 else ifx (u[449]>0.5f32)&&(u[449]<1.5f32) then gpu_sample_layer_level(sheets,sheet,s.uv,cast,trunc(s32)(layer),2.0f32).w else tex.w;
  if (cut<0.35f32) {
    gpu_demote_helper();
  }
  // nothing shows below the ground (a round piece's lower half ball, a rock's buried foot)
  if ((s.world.y<(-0.04f32))&&(((wg_length2(v2(s.world.x,s.world.z))<u[31])||(myrealm_land(u)<0.5f32))||(myrealm_land(u)>1.5f32))) {
    gpu_demote_helper();
  }
  n:V3=wg_normalize3(s.normal);
  if myrealm_styled(u) {
    d:V3=wg_normalize3(wg_sub_f3f3(s.world,v3(u[28],u[29],u[30])));
    dist:f32=wg_length3(wg_sub_f3f3(s.world,v3(u[28],u[29],u[30])));
    // painted: the texture's grain softened toward a nearer mip; flat: large fills of colour, the
    // texture's own mean (a far mip) more than its grain
