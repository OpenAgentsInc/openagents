  rounded:bool=s.slice>=4096;
  layer:u32=ifx rounded then 0 else s.slice;
  sampled:V4=render_sample_layer8(sheets,sheet,s.uv,cast,trunc(s32)(layer));
  // plain (glow below -2.5, myrealm-things.coax untextured): its tint alone, like a round piece
  bare:bool=rounded||(s.glow<(-2.5f32));
  tex:V4=ifx bare then v4(1.0f32,1.0f32,1.0f32,1.0f32) else wg_make_f4_f3f(myrealm_surfaced(v3(sampled.x,sampled.y,sampled.z),s.glow),sampled.w);
  // stone (glow below -1.5, myrealm-things.coax stone): laid blocks in courses, whatever the mesh
