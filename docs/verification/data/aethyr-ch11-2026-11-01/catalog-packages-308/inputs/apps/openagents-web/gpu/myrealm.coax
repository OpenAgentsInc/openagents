// myrealm's shaders, the source of apps/openagents-web/myrealm.wgsl (docs/verse/native-gpu.md, G6):
// build.sh writes that module from this with coax/web/wgsl-module.coax (myrealm.module,
// myrealm.bindings beside it). It began as coax/web/wgsl-coax.coax's translation of the hand-written WGSL.
#load "../../../aethyr/render/sampling.coax";
#load "../../../aethyr/render/noise.coax";
#load "../../../verse/gpu/wgsl.coax";
#load "../../../verse/style.coax";

// A realm someone built: its three passes (myrealm.coax). The sky and the ground behind (the sky by
// the realm's time of day, the ground by its kind, where each pixel's ray meets it, the water where
// it has some, lit by the sun and, after dark, the lamp you carry; the plates over both), the pack's
// meshes (scene_vs, scene_fs: lit by the same sun and lamp, fading into the haze) and the strokes
// over all of it. Low poly keeps this file's own sky and light. A painterly or flat realm reads its
// style block (verse/style-preset.coax, at its time of day; docs/verse/art-styles.md): painterly
// in soft toon bands with cool shadows, a rim, haze, a painted sky with clouds and a tone curve;
// flat in three hard tones of a few flat colours, a flat sky and one soft fade (the style
// functions are verse/style.coax's, generated below by build.sh). Forked from droprealm.wgsl;
// every place, size and colour comes from myrealm.coax.
// MyrealmU, a uniform block, is read from a []f32 at these offsets (floats):
//   size 0
//   time 2
//   fade 3
//   still 4
//   panels 5
//   k 6
//   palette 7
//   r0 8
//   r1 12
//   r2 16
//   r3 20
//   lamp 24
//   eye 28
//   fwd 32
//   rx 36
//   uy 40
//   sky 44
//   horizon 48
//   ground 52
//   sun 56
//   water 60
//   panel 64
//   pool 256
//   pool_tint 320
//   st 324
// palette: myrealm.coax PALETTES (1 pastel)
// the view: clip = rows · world
// the lamp: where (metres), strength
// the eye (metres), then the floor's radius
// a pixel's ray: fwd + ndc.x · rx + ndc.y · uy; fwd.w 1: orthographic
// (2D: every ray is fwd, from eye + ndc.x · rx + ndc.y · uy); rx.w: metres before haze
// the sky's top, then 1 for painterly
// the horizon, then the stars' share
// the ground's colour, then the lamp's share
// toward the sun, then its strength
// the water: x, z, radius (a river's half width), then 0 none, 1 a pond,
// 2 a river across the land, 3 a frozen pond, 4 a pool of lava
// per plate (myrealm.coax PLATES): x0, y0, x1, y1 (device pixels), then scale, alpha, look, 0
// the lanterns' lights (myrealm.coax POOL_AT): x, y, z (metres), on
// their colour, then their strength (the time of day's share)
// the style block (myrealm.coax STYLE_AT; verse/style-preset.coax SU_*): 0 for low poly
// A plate (verse.wgsl's): a dark wood fill with one thin bronze line round
// it and small rounded corners. Look 1 lights the line; 2 (under the mouse
// or pressed) adds a step lighter fill and the bright line.
myrealm_plate :: (p:V2,under:V3,r:V4,s:V4)->V3 {
  if (s.y<=0.0f32) {
    return under;
  }
  half:V2=wg_mul_f2f(wg_sub_f2f2(v2(r.z,r.w),v2(r.x,r.y)),0.5f32);
  corner:f32=4.0f32*s.x;
  q:V2=wg_add_f2f2(wg_sub_f2f2(wg_abs_f2(wg_sub_f2f2(p,wg_add_f2f2(v2(r.x,r.y),half))),half),v2(corner,corner));
  d:f32=(wg_length2(wg_max_f2f2(q,v2(0.0f32,0.0f32)))+fmin(fmax(q.x,q.y),0.0f32))-corner;
  if (d>1.0f32) {
    return under;
  }
  over:bool=s.z>=2.0f32;
  lit:bool=over||((s.z>=1.0f32)&&(s.z<2.0f32));
  fill:V3=ifx over then v3(0.235f32,0.168f32,0.115f32) else v3(0.165f32,0.114f32,0.078f32);
  line:V3=ifx lit then v3(0.86f32,0.70f32,0.42f32) else v3(0.69f32,0.541f32,0.29f32);
  w:f32=1.25f32*s.x;
  inside:f32=clampf(0.5f32-d,0.0f32,1.0f32);
  edge:f32=clampf(((w*0.5f32)+0.5f32)-abs(d+(w*0.5f32)),0.0f32,1.0f32);
  a:f32=clampf(s.y,0.0f32,1.0f32);
  return wg_mix_f3f3f(wg_mix_f3f3f(under,fill,a*inside),line,edge*fmin(1.0f32,a+0.1f32));
}
myrealm_panels :: (p:V2,under:V3,u:[]f32)->V3 {
  c:V3=under;
  {
    k:s32=0;
    while k<24 {
      if ((cast(f32)(k))>=u[5]) {
        break;
      }
      c=myrealm_plate(p,c,wg_at4(u,(cast(int)(k*2))*4+64),wg_at4(u,(cast(int)((k*2)+1))*4+64));
      k+=1;
    }
  }
  return c;
}
#test "myrealm_hash live lattice uses the portable integer noise profile" {
  #assert f32_bits(myrealm_hash(v2(1,2)))==0x3f6013da;
}
myrealm_hash :: (p:V2)->f32 {
  return render_noise2(p.x,p.y);
}
// Stars: one at most per cell of 3 CSS pixels' grid, a few of them brighter, twinkling slowly.
myrealm_stars :: (p:V2,u:[]f32)->f32 {
  cell:f32=(3.0f32*fmax(u[6],1.0f32))*6.0f32;
  g:V2=wg_floor_f2(wg_div_f2f(p,cell));
  h:f32=myrealm_hash(g);
  if (h<0.93f32) {
    return 0.0f32;
  }
  at:V2=wg_mul_f2f(wg_add_f2f(wg_add_f2f2(g,wg_mul_f2f(v2(myrealm_hash(wg_add_f2f(g,1.7f32)),myrealm_hash(wg_add_f2f(g,9.1f32))),0.8f32)),0.1f32),cell);
  d:f32=wg_length2(wg_sub_f2f2(p,at))/fmax(u[6],1.0f32);
  size:f32=ifx h>0.992f32 then 0.95f32 else 0.55f32;
  twinkle:f32=ifx u[4]>0.5f32 then 1.0f32 else 0.75f32+(0.25f32*sin((u[2]*(0.6f32+(h*2.0f32)))+(h*40.0f32)));
  peak:f32=(ifx h>0.992f32 then 0.75f32 else 0.32f32)*twinkle;
  return peak*(1.0f32-smoothstep(size*0.4f32,size+0.6f32,d));
}
myrealm_bg_vs :: (i:u32,_iid1:u32)->V4 {
  p:[3]V2=[3]V2.[v2(-1.0f32,-3.0f32),v2(-1.0f32,1.0f32),v2(3.0f32,1.0f32)];
  return v4(p[cast(int)i].x,p[cast(int)i].y,0.0f32,1.0f32);
}
// The lamp's light on what it reaches, a share of its strength.
myrealm_lamp_near :: (p:V3,n:V3,u:[]f32)->f32 {
  to:V3=wg_sub_f3f3(v3(u[24],u[25],u[26]),p);
  d:f32=wg_length3(to);
  return (fmax(0.0f32,wg_dot3(n,wg_div_f3f(to,fmax(d,0.001f32))))*u[27])/(1.0f32+((0.18f32*d)*d));
}
// The lanterns' light on what they reach: a warm pool round each post after dark.
myrealm_lanterns_near :: (p:V3,n:V3,u:[]f32)->V3 {
  if (u[323]<=0.0f32) {
    return v3(0.0f32,0.0f32,0.0f32);
  }
  sum:f32=0.0f32;
  {
    i:s32=0;
    while i<16 {
      l:V4=wg_at4(u,(cast(int)i)*4+256);
      if (l.w<0.5f32) {
        break;
      }
      to:V3=wg_sub_f3f3(v3(l.x,l.y,l.z),p);
      d:f32=wg_length3(to);
      sum=sum+((0.25f32+(0.75f32*fmax(0.0f32,wg_dot3(n,wg_div_f3f(to,fmax(d,0.001f32))))))/(1.0f32+((0.55f32*d)*d)));
      i+=1;
    }
  }
  return wg_mul_f3f(wg_mul_f3f(v3(u[320],u[321],u[322]),sum),u[323]);
}
myrealm_noise :: (p:V2)->f32 {
  i:V2=wg_floor_f2(p);
  f:V2=wg_fract_f2(p);
  w:V2=wg_mul_f2f2(wg_mul_f2f2(f,f),wg_sub_ff2(3.0f32,wg_mul_ff2(2.0f32,f)));
  return mix(mix(myrealm_hash(i),myrealm_hash(wg_add_f2f2(i,v2(1.0f32,0.0f32))),w.x),mix(myrealm_hash(wg_add_f2f2(i,v2(0.0f32,1.0f32))),myrealm_hash(wg_add_f2f2(i,v2(1.0f32,1.0f32))),w.x),w.y);
}
// ---- the style block: SU_* rows (verse/style-preset.coax); st(31).y the style: 1 painterly, 3 flat
myrealm_st :: (i:u32,u:[]f32)->V4 {
  return wg_at4(u,(cast(int)i)*4+324);
}
myrealm_styled :: (u:[]f32)->bool {
  return u[449]>0.5f32;
}
// A pastel realm's textures, lifted pale before their (pastel) tint: wood and hide read soft, not dark.
myrealm_paletted :: (t:V3,u:[]f32)->V3 {
  return ifx (myrealm_pal(u)>0.5f32)&&(myrealm_pal(u)<1.5f32) then wg_add_f3f3(wg_mul_f3f(t,0.35f32),v3(0.62f32,0.62f32,0.62f32)) else t;
}
// u.palette carries the land too (myrealm.coax LAND_*): the palette plus 10 times 1 for a floating
// island (the ground ends at its edge, open sky beyond) or 2 for an island in the sea.
myrealm_land :: (u:[]f32)->f32 {
  return floor((u[7]/10.0f32)+0.001f32);
}
myrealm_pal :: (u:[]f32)->f32 {
  return u[7]-(10.0f32*myrealm_land(u));
}
// How far inside the water's edge q is (negative: outside): a pond is a circle, a river a band
// across the land that bends (myrealm.coax water_gap, the same curve).
myrealm_water_in :: (q:V2,u:[]f32)->f32 {
  if ((u[63]>1.5f32)&&(u[63]<2.5f32)) {
    return u[62]-abs((q.y-u[61])-(2.5f32*sin(q.x*0.15f32)));
  }
  return u[62]-wg_length2(wg_sub_f2f2(q,v2(u[60],u[61])));
}
// Ice: pale, a little blue, with dark cracks. Lava: bright and moving, with a dark crust; it glows.
myrealm_ice_at :: (q:V2)->V3 {
  crack:f32=smoothstep(0.47f32,0.5f32,myrealm_noise(wg_mul_f2f(q,1.3f32)))*(1.0f32-smoothstep(0.5f32,0.53f32,myrealm_noise(wg_mul_f2f(q,1.3f32))));
  return wg_mix_f3f3f(v3(0.8f32,0.88f32,0.94f32),v3(0.55f32,0.66f32,0.75f32),(crack*0.8f32)+(0.15f32*myrealm_noise(wg_mul_f2f(q,0.4f32))));
}
myrealm_lava_at :: (q:V2,u:[]f32)->V3 {
  flow:f32=myrealm_noise(wg_add_f2f2(wg_mul_f2f(q,0.9f32),v2(u[2]*0.15f32,u[2]*0.07f32)));
  crust:f32=smoothstep(0.55f32,0.7f32,myrealm_noise(wg_sub_f2f2(wg_mul_f2f(q,1.7f32),v2(u[2]*0.05f32,0.0f32))));
  return wg_mix_f3f3f(wg_mix_f3f3f(v3(1.0f32,0.3f32,0.04f32),v3(1.0f32,0.78f32,0.25f32),flow),v3(0.12f32,0.05f32,0.04f32),crust*0.85f32);
}
myrealm_sea_at :: (q:V2,mirror:V3,u:[]f32)->V3 {
  return wg_add_f3f3(wg_mul_f3f(mirror,0.45f32),wg_mul_f3f(v3(0.03f32,0.16f32,0.26f32),(0.85f32+(0.3f32*myrealm_noise(wg_add_f2f2(wg_mul_f2f(q,0.5f32),v2(u[2]*0.1f32,0.0f32)))))));
}
myrealm_flat_style :: (u:[]f32)->bool {
  return u[449]>2.5f32;
}
myrealm_key_l :: (u:[]f32)->V3 {
  return wg_normalize3(wg_add_f3f3(wg_sw_xyz_f4(myrealm_st(1,u)),v3(0.0f32,0.00001f32,0.0f32)));
}
// The painted or flat sky along d (fixture.wgsl's painterly sky; fairy.wgsl's flat one), stars after dark.
myrealm_sky_styled :: (d:V3,p:V2,u:[]f32)->V3 {
  up:f32=d.y;
  l:V3=myrealm_key_l(u);
  ct:f32=wg_dot3(d,l);
  moon:bool=myrealm_st(1,u).w>0.5f32;
  if myrealm_flat_style(u) {
    c:V3=wg_mix_f3f3f(wg_sw_xyz_f4(myrealm_st(12,u)),wg_sw_xyz_f4(myrealm_st(13,u)),verse_style_flat_sky(up));
    if (ct>cos(myrealm_st(14,u).x)) {
      c=wg_mul_f3f(wg_sw_xyz_f4(myrealm_st(17,u)),ifx moon then 0.85f32 else 1.1f32);
    }
    return wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(wg_sw_xyz_f4(myrealm_st(17,u)),myrealm_stars(p,u)),myrealm_st(14,u).w),smoothstep(0.0f32,0.2f32,up)));
  }
  c:V3=wg_mix_f3f3f(wg_sw_xyz_f4(myrealm_st(13,u)),wg_sw_xyz_f4(myrealm_st(12,u)),verse_style_sky_t(up));
  c=wg_mix_f3f3f(c,wg_sw_xyz_f4(myrealm_st(10,u)),verse_style_sky_band(up,myrealm_st(12,u).w));
  disc:f32=smoothstep(cos(myrealm_st(14,u).x*1.15f32),cos(myrealm_st(14,u).x*0.85f32),ct);
  halo:f32=(verse_style_halo(ct,myrealm_st(14,u).y)*0.5f32)+(verse_style_halo(ct,myrealm_st(14,u).z)*0.25f32);
  if moon {
    c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(wg_sw_xyz_f4(myrealm_st(0,u)),halo),0.5f32));
  } else {
    c=wg_mix_f3f3f(c,wg_mul_f3f(wg_sw_xyz_f4(myrealm_st(11,u)),1.5f32),clampf(halo*1.1f32,0.0f32,0.9f32));
  }
  c=wg_mix_f3f3f(c,ifx moon then wg_mul_f3f(v3(0.85f32,0.88f32,1.0f32),1.6f32) else wg_mul_f3f(v3(1.0f32,0.97f32,0.88f32),4.0f32),disc);
  cl:V4=myrealm_st(15,u);
  c2:V4=myrealm_st(16,u);
  if ((up>0.01f32)&&(cl.x>0.0f32)) {
    t:f32=ifx u[4]>0.5f32 then 0.0f32 else u[2];
    q:V2=wg_add_f2f2(wg_mul_f2f(wg_div_f2f(v2(d.x,d.z),up),cl.y),wg_mul_f2f(wg_mul_f2f(wg_sw_xy_f4(myrealm_st(25,u)),cl.z),t));
    n:f32=verse_style_cloud_field(q.x,q.y,c2.x,c2.y,cl.w);
    cover:f32=verse_style_cloud_cover(n,cl.x,c2.z,c2.w);
    toward:V2=wg_mul_f2f(wg_normalize2(wg_add_f2f2(v2(l.x,l.z),v2(0.0001f32,0.0001f32))),260.0f32);
    lit:f32=verse_style_cloud_lit(n,verse_style_cloud_field(q.x+toward.x,q.y+toward.y,c2.x,c2.y,cl.w));
    night:f32=myrealm_st(14,u).w;
    cloud:V3=wg_mul_f3f(wg_mul_f3f(wg_mix_f3f3f(wg_mul_f3f(wg_mul_f3f(wg_sw_xyz_f4(myrealm_st(4,u)),myrealm_st(17,u).w),0.9f32),wg_sw_xyz_f4(myrealm_st(17,u)),lit),fmax(myrealm_st(0,u).w,0.3f32)),(1.0f32-(0.75f32*night)));
    c=wg_mix_f3f3f(c,cloud,(cover*verse_style_cloud_fade(up))*(1.0f32-(0.5f32*night)));
  }
  return wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(wg_make_f3_f(myrealm_stars(p,u)),myrealm_st(14,u).w),smoothstep(0.0f32,0.25f32,up)));
}
// A painterly surface (fixture.wgsl's shade, without its shadow map): the albedo under the tinted,
// cooled ambient in the shadow band and under the key in the lit ones, and the rim of the key's light.
myrealm_painted :: (a:V3,n:V3,d:V3,u:[]f32)->V3 {
  l:V3=myrealm_key_l(u);
  ndl:f32=wg_dot3(n,l);
  band:f32=verse_style_bands(verse_style_wrap(ndl),myrealm_st(7,u).x,myrealm_st(7,u).y,myrealm_st(7,u).z,myrealm_st(7,u).w);
  amb:V3=v3(verse_style_ambient(n.y,myrealm_st(5,u).x,myrealm_st(6,u).x,myrealm_st(5,u).w),verse_style_ambient(n.y,myrealm_st(5,u).y,myrealm_st(6,u).y,myrealm_st(5,u).w),verse_style_ambient(n.y,myrealm_st(5,u).z,myrealm_st(6,u).z,myrealm_st(5,u).w));
  s:V3=wg_mul_f3f3(wg_mul_f3f3(a,wg_sw_xyz_f4(myrealm_st(4,u))),amb);
  t:V3=wg_sw_xyz_f4(myrealm_st(4,u));
  tl:f32=verse_style_luma(t.x,t.y,t.z);
  k:f32=myrealm_st(21,u).w;
  m:V3=v3(verse_style_cool(s.x,t.x,tl,k),verse_style_cool(s.y,t.y,tl,k),verse_style_cool(s.z,t.z,tl,k));
  y:f32=verse_style_luma(s.x,s.y,s.z);
  ym:f32=verse_style_luma(m.x,m.y,m.z);
  cool:V3=v3(verse_style_keep_value(m.x,y,ym),verse_style_keep_value(m.y,y,ym),verse_style_keep_value(m.z,y,ym));
  lit:V3=wg_mul_f3f3(a,wg_add_f3f3(wg_mul_f3f(wg_sw_xyz_f4(myrealm_st(0,u)),myrealm_st(0,u).w),amb));
  c:V3=v3(verse_style_banded(cool.x,lit.x,band),verse_style_banded(cool.y,lit.y,band),verse_style_banded(cool.z,lit.z,band));
  c=wg_add_f3f3(c,wg_mul_f3f(wg_sw_xyz_f4(myrealm_st(2,u)),verse_style_rim(wg_dot3(n,wg_neg_f3(d)),ndl,myrealm_st(3,u).y,myrealm_st(3,u).z,myrealm_st(2,u).w)));
  return c;
}
// A flat surface (fairy.wgsl's): three hard tones between the palette's shade and lit colours.
myrealm_flat_lit :: (a:V3,n:V3,u:[]f32)->V3 {
  band:f32=verse_style_flat_band(verse_style_flat_light(wg_dot3(n,myrealm_key_l(u)),1.0f32));
  return wg_mul_f3f3(a,wg_mix_f3f3f(wg_sw_xyz_f4(myrealm_st(4,u)),wg_mul_f3f(wg_sw_xyz_f4(myrealm_st(0,u)),myrealm_st(0,u).w),band));
}
// The lamp and the lanterns on a styled surface: soft for painterly, in two flat steps for flat.
myrealm_styled_lights :: (a:V3,p:V3,n:V3,u:[]f32)->V3 {
  lamp:V3=wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(v3(1.0f32,0.62f32,0.28f32),myrealm_lamp_near(p,n,u)),1.6f32),u[55]);
  pools:V3=wg_mul_f3f(myrealm_lanterns_near(p,n,u),1.4f32);
  if myrealm_flat_style(u) {
    w:V3=wg_add_f3f3(lamp,pools);
    return wg_mul_f3f(wg_mul_f3f3(wg_add_f3f3(wg_mul_f3f(a,2.2f32),v3(0.04f32,0.04f32,0.04f32)),wg_floor_f3(wg_clamp_f3f3f3(wg_mul_f3f(w,2.0f32),v3(0.0f32,0.0f32,0.0f32),v3(2.0f32,2.0f32,2.0f32)))),0.5f32);
  }
  return wg_mul_f3f3(wg_add_f3f3(wg_mul_f3f(a,2.2f32),v3(0.04f32,0.04f32,0.04f32)),wg_add_f3f3(lamp,pools)); // linear light: the pools read as warm light, not just a tint
}
// Distance: painterly haze (its height falloff, its hue, the key's glow through it); flat's one soft fade.
myrealm_styled_far :: (c:V3,p:V3,dist:f32,d:V3,u:[]f32)->V3 {
  hz:V4=myrealm_st(9,u);
  if myrealm_flat_style(u) {
    return wg_mix_f3f3f(c,wg_sw_xyz_f4(myrealm_st(13,u)),verse_style_flat_fade(fmax(dist-u[39],0.0f32),hz.x,1.0f32/fmax(hz.y,0.0001f32),hz.z));
  }
  f:f32=verse_style_haze(fmax(dist-u[39],0.0f32),p.y,0.0f32,hz.x,hz.y,hz.z,hz.w);
  hz3:V3=wg_sw_xyz_f4(myrealm_st(10,u));
  hue:V3=v3(verse_style_haze_hue(hz3.x,0.0f32,f,hz.z),verse_style_haze_hue(hz3.y,1.0f32,f,hz.z),verse_style_haze_hue(hz3.z,2.0f32,f,hz.z));
  hc:V3=wg_mix_f3f3f(hue,wg_sw_xyz_f4(myrealm_st(11,u)),verse_style_haze_glow(wg_dot3(d,myrealm_key_l(u))));
  return v3(verse_style_fog(c.x,hc.x,f),verse_style_fog(c.y,hc.y,f),verse_style_fog(c.z,hc.z,f));
}
// Painterly's tone curve, saturation and black lift (none for flat: the palette shows as it is).
myrealm_tone :: (c:V3,u:[]f32)->V3 {
  if (myrealm_st(18,u).w<0.5f32) {
    return c;
  }
  e:f32=myrealm_st(18,u).x;
  t:V3=v3(verse_style_tone(c.x,e),verse_style_tone(c.y,e),verse_style_tone(c.z,e));
  y:f32=verse_style_luma(t.x,t.y,t.z);
  t=v3(verse_style_saturation(t.x,y,myrealm_st(18,u).y),verse_style_saturation(t.y,y,myrealm_st(18,u).y),verse_style_saturation(t.z,y,myrealm_st(18,u).y));
  return v3(verse_style_lift(t.x,myrealm_st(18,u).z),verse_style_lift(t.y,myrealm_st(18,u).z),verse_style_lift(t.z,myrealm_st(18,u).z));
}
// A styled realm's colour is linear light (the preset's numbers, the sheets' samples): toned, then
// encoded for the screen (fixture.wgsl's post).
myrealm_encoded :: (c:V3,u:[]f32)->V3 {
  return wg_pow_f3f3(wg_clamp_f3f3f3(myrealm_tone(c,u),v3(0.0f32,0.0f32,0.0f32),v3(1.0f32,1.0f32,1.0f32)),wg_make_f3_f(1.0f32/2.2f32));
}
// A styled realm's ground at hit (seen along ray from t away): brushed for painterly, broad flat
// patches for flat; the water in the preset's bands by depth (painterly mirrors the sky at a glance).
myrealm_styled_ground :: (hit:V3,ray:V3,t:f32,p:V2,u:[]f32)->V3 {
  up:V3=v3(0.0f32,1.0f32,0.0f32);
  d:V3=wg_normalize3(ray);
  a:V3=wg_pow_f3f3(v3(u[52],u[53],u[54]),v3(2.2f32,2.2f32,2.2f32)); // myrealm.coax's ground colours are the screen's
  if myrealm_flat_style(u) {
    a=wg_mul_f3f(a,ifx myrealm_noise(wg_mul_f2f(v2(hit.x,hit.z),0.07f32))>0.58f32 then 0.88f32 else 1.0f32);
  } else {
    big:f32=myrealm_noise(wg_mul_f2f(v2(hit.x,hit.z),0.18f32));
    brush:f32=myrealm_noise(v2((hit.x*0.9f32)+(hit.z*0.4f32),hit.z*3.2f32));
    a=wg_mul_f3f(a,(0.8f32+(0.18f32*big))+(0.12f32*brush));
  }
  c:V3=ifx myrealm_flat_style(u) then myrealm_flat_lit(a,up,u) else myrealm_painted(a,up,d,u);
  wi:f32=myrealm_water_in(v2(hit.x,hit.z),u);
  if ((u[63]>0.5f32)&&(wi>0.0f32)) {
    depth:f32=wi*0.5f32;
    sh:V4=myrealm_st(27,u);
    md:V4=myrealm_st(28,u);
    dp:V4=myrealm_st(29,u);
    soft:f32=fmax(dp.w,0.01f32);
    w:V3=wg_mix_f3f3f(wg_mix_f3f3f(v3(sh.x,sh.y,sh.z),v3(md.x,md.y,md.z),smoothstep(sh.w-soft,sh.w+soft,depth)),v3(dp.x,dp.y,dp.z),smoothstep(md.w-soft,md.w+soft,depth));
    if myrealm_flat_style(u) {
      w=myrealm_flat_lit(ifx depth<sh.w then v3(sh.x,sh.y,sh.z) else v3(md.x,md.y,md.z),up,u);
      w=wg_mix_f3f3f(w,wg_sw_xyz_f4(myrealm_st(17,u)),1.0f32-stepf(myrealm_st(30,u).w,wi)); // the flat shore line
    } else {
      rip:f32=myrealm_noise(wg_add_f2f2(wg_mul_f2f(v2(hit.x,hit.z),2.4f32),v2(u[2]*0.3f32,u[2]*0.2f32)))-0.5f32;
      w=myrealm_painted(w,up,d,u);
      f:f32=0.02f32+(0.98f32*pow(1.0f32-fmax(-d.y,0.0f32),5.0f32));
      w=wg_mix_f3f3f(w,myrealm_sky_styled(v3(d.x+(rip*0.04f32),-d.y,d.z+(rip*0.04f32)),p,u),clampf(f+0.15f32,0.0f32,1.0f32));
    }
    if ((u[63]>2.5f32)&&(u[63]<3.5f32)) {
      w=ifx myrealm_flat_style(u) then myrealm_flat_lit(wg_pow_f3f3(myrealm_ice_at(v2(hit.x,hit.z)),v3(2.2f32,2.2f32,2.2f32)),up,u) else myrealm_painted(wg_pow_f3f3(myrealm_ice_at(v2(hit.x,hit.z)),v3(2.2f32,2.2f32,2.2f32)),up,d,u);
    }
    if (u[63]>3.5f32) {
      w=wg_mul_f3f(wg_pow_f3f3(myrealm_lava_at(v2(hit.x,hit.z),u),v3(2.2f32,2.2f32,2.2f32)),1.6f32);
    }
    c=w;
  }
  // an island: the sea from the beach out, in the water's own bands
  if ((myrealm_land(u)>1.5f32)&&(wg_length2(v2(hit.x,hit.z))>(u[31]-3.0f32))) {
    sea:V3=ifx myrealm_flat_style(u) then myrealm_flat_lit(wg_sw_xyz_f4(myrealm_st(28,u)),up,u) else myrealm_painted(wg_sw_xyz_f4(myrealm_st(28,u)),up,d,u);
    c=wg_mix_f3f3f(c,sea,smoothstep(u[31]-3.0f32,u[31]-2.0f32,wg_length2(v2(hit.x,hit.z))));
  }
  c=wg_add_f3f3(c,myrealm_styled_lights(a,hit,up,u));
  return myrealm_styled_far(c,hit,t,d,u);
}
// The sky along a ray: the horizon below, the top above, the sun's glow, and stars after dark.
myrealm_sky_of :: (ray:V3,p:V2,u:[]f32)->V3 {
  r:V3=wg_normalize3(ray);
  c:V3=wg_mix_f3f3f(v3(u[48],u[49],u[50]),v3(u[44],u[45],u[46]),smoothstep(-0.02f32,0.45f32,r.y));
  toward:f32=fmax(wg_dot3(r,wg_normalize3(v3(u[56],u[57],u[58]))),0.0f32);
  c=wg_add_f3f3(c,wg_add_f3f3(wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(v3(1.0f32,0.85f32,0.6f32),pow(toward,40.0f32)),u[59]),0.6f32),wg_mul_f3f(wg_mul_f3f(v3(u[48],u[49],u[50]),pow(toward,6.0f32)),0.25f32)));
  c=wg_add_f3f3(c,wg_mul_f3f(wg_mul_f3f(wg_make_f3_f(myrealm_stars(p,u)),u[51]),smoothstep(0.0f32,0.25f32,r.y)));
  // soft clouds drifting over the day, fewer at dawn and dusk, none at night (the stars' share)
  if (r.y>0.0f32) {
    q:V2=wg_add_f2f2(wg_mul_f2f(wg_div_f2f(v2(r.x,r.z),(r.y+0.12f32)),1.4f32),v2(u[2]*0.015f32,0.0f32));
    n:f32=((myrealm_noise(q)*0.6f32)+(myrealm_noise(wg_add_f2f2(wg_mul_f2f(q,2.3f32),v2(7.0f32,7.0f32)))*0.3f32))+(myrealm_noise(wg_add_f2f2(wg_mul_f2f(q,5.1f32),v2(3.0f32,3.0f32)))*0.1f32);
    cover:f32=(smoothstep(0.5f32,0.78f32,n)*smoothstep(0.02f32,0.3f32,r.y))*(1.0f32-u[51]);
    c=wg_mix_f3f3f(c,wg_mix_f3f3f(v3(u[48],u[49],u[50]),wg_mul_f3f(myrealm_sun_tint(u),1.05f32),0.6f32),cover*0.85f32);
  }
  return c;
}
// The sun's colour by the realm's palette: natural warm white, pastel rosy, vivid golden, muted grey.
myrealm_sun_tint :: (u:[]f32)->V3 {
  k:f32=myrealm_pal(u);
  if ((k>0.5f32)&&(k<1.5f32)) {
    return v3(1.0f32,0.88f32,0.92f32);
  }
  if ((k>1.5f32)&&(k<2.5f32)) {
    return v3(1.1f32,0.95f32,0.72f32);
  }
  if (k>2.5f32) {
    return v3(0.84f32,0.86f32,0.9f32);
  }
  return v3(1.0f32,0.94f32,0.82f32);
}
// Sun and sky light on a surface.
myrealm_daylight :: (n:V3,u:[]f32)->V3 {
  key:f32=fmax(0.0f32,wg_dot3(n,wg_normalize3(v3(u[56],u[57],u[58]))));
  soft:f32=ifx u[47]>0.5f32 then (key*0.6f32)+0.25f32 else key;
  amb:V3=wg_add_f3f3(wg_mul_f3f(wg_mix_f3f3f(v3(u[48],u[49],u[50]),v3(u[44],u[45],u[46]),0.5f32+(0.5f32*n.y)),0.55f32),v3(0.04f32,0.04f32,0.04f32));
  return wg_add_f3f3(amb,wg_mul_f3f(wg_mul_f3f(myrealm_sun_tint(u),soft),u[59]));
}
myrealm_bg_fs :: (pos:V4,u:[]f32)->V4 {
  p:V2=v2(pos.x,pos.y);
  ndc:V2=v2(((p.x/u[0])*2.0f32)-1.0f32,1.0f32-((p.y/u[1])*2.0f32));
  off:V3=wg_add_f3f3(wg_mul_ff3(ndc.x,v3(u[36],u[37],u[38])),wg_mul_ff3(ndc.y,v3(u[40],u[41],u[42])));
  ortho:bool=u[35]>0.5f32;
  ray:V3=ifx ortho then v3(u[32],u[33],u[34]) else wg_add_f3f3(v3(u[32],u[33],u[34]),off);
  org:V3=ifx ortho then wg_add_f3f3(v3(u[28],u[29],u[30]),off) else v3(u[28],u[29],u[30]);
  down:bool=ray.y<(-0.0001f32);
  t:f32=ifx down then (-org.y)/fmin(ray.y,-0.0001f32) else 1000.0f32;
  hit:V3=wg_add_f3f3(org,wg_mul_f3f(ray,fmin(t,1000.0f32)));
  r:f32=wg_length2(v2(hit.x,hit.z));
  if myrealm_styled(u) {
    sky_s:V3=myrealm_sky_styled(wg_normalize3(ray),p,u);
    edge_s:f32=ifx down then 1.0f32-smoothstep(u[31]-3.0f32,u[31]+6.0f32,r) else 0.0f32;
    far:V3=wg_sw_xyz_f4(myrealm_st(13,u));
    cs:V3=sky_s;
    if down {
      cs=wg_mix_f3f3f(far,myrealm_styled_ground(hit,ray,t*wg_length3(ray),p,u),ifx myrealm_land(u)>1.5f32 then 1.0f32 else edge_s);
    }
    if ((((myrealm_land(u)>0.5f32)&&(myrealm_land(u)<1.5f32))&&down)&&(r>u[31])) {
      cs=sky_s;
    }
    return wg_make_f4_f3f(myrealm_panels(p,wg_mul_f3f(myrealm_encoded(cs,u),u[3]),u),1.0f32);
  }
  sky:V3=myrealm_sky_of(ray,p,u);
  // the ground: its colour, broken up (brushed when painterly), lit by the sun and your lamp
  big:f32=myrealm_noise(wg_mul_f2f(v2(hit.x,hit.z),0.18f32));
  fine:f32=myrealm_noise(wg_mul_f2f(v2(hit.x,hit.z),1.7f32));
  brush:f32=myrealm_noise(v2((hit.x*0.9f32)+(hit.z*0.4f32),hit.z*3.2f32));
  vary:f32=ifx u[47]>0.5f32 then (0.78f32+(0.2f32*big))+(0.16f32*brush) else (0.82f32+(0.22f32*big))+(0.08f32*fine);
  // and broad patches of warmer, drier grass and cooler, lusher ground
  patches:f32=myrealm_noise(wg_add_f2f2(wg_mul_f2f(v2(hit.x,hit.z),0.06f32),v2(3.1f32,7.7f32)));
  hue:V3=wg_mix_f3f3f(v3(1.12f32,1.06f32,0.78f32),v3(0.84f32,1.0f32,0.98f32),smoothstep(0.25f32,0.75f32,patches));
  ground:V3=wg_mul_f3f3(wg_mul_f3f3(wg_mul_f3f(v3(u[52],u[53],u[54]),vary),hue),myrealm_daylight(v3(0.0f32,1.0f32,0.0f32),u));
  // water: the sky in it, rippled, a pale rim where it meets the ground
  wi:f32=myrealm_water_in(v2(hit.x,hit.z),u);
  if ((u[63]>0.5f32)&&(wi>0.0f32)) {
    rip:f32=myrealm_noise(wg_add_f2f2(wg_mul_f2f(v2(hit.x,hit.z),2.4f32),v2(u[2]*0.3f32,u[2]*0.2f32)))-0.5f32;
    mirror:V3=myrealm_sky_of(v3(ray.x+(rip*0.05f32),-ray.y,ray.z+(rip*0.05f32)),p,u);
    deep:f32=smoothstep(0.0f32,u[62]*0.6f32,wi);
    water:V3=wg_mix_f3f3f(wg_add_f3f3(wg_mul_f3f(mirror,0.75f32),v3(0.02f32,0.05f32,0.08f32)),wg_add_f3f3(wg_mul_f3f3(v3(0.03f32,0.09f32,0.14f32),myrealm_daylight(v3(0.0f32,1.0f32,0.0f32),u)),wg_mul_f3f(mirror,0.4f32)),deep*0.6f32);
    rim:f32=1.0f32-smoothstep(0.0f32,0.25f32,wi);
    ground=wg_mix_f3f3f(water,wg_mul_f3f3(wg_mul_f3f(v3(u[52],u[53],u[54]),1.2f32),myrealm_daylight(v3(0.0f32,1.0f32,0.0f32),u)),rim*0.5f32);
    if ((u[63]>2.5f32)&&(u[63]<3.5f32)) {
      ground=wg_add_f3f3(wg_mul_f3f3(myrealm_ice_at(v2(hit.x,hit.z)),myrealm_daylight(v3(0.0f32,1.0f32,0.0f32),u)),wg_mul_f3f(mirror,0.12f32));
    }
    if (u[63]>3.5f32) {
      ground=myrealm_lava_at(v2(hit.x,hit.z),u);
    }
  }
  ground=wg_add_f3f3(ground,wg_mul_f3f(wg_mul_f3f(wg_mul_f3f(v3(1.0f32,0.62f32,0.28f32),myrealm_lamp_near(hit,v3(0.0f32,1.0f32,0.0f32),u)),0.55f32),u[55]));
  ground=wg_add_f3f3(ground,wg_mul_f3f(myrealm_lanterns_near(hit,v3(0.0f32,1.0f32,0.0f32),u),0.9f32));
  // an island: the sea from the beach out to the horizon
  if (myrealm_land(u)>1.5f32) {
    rip:f32=myrealm_noise(wg_add_f2f2(wg_mul_f2f(v2(hit.x,hit.z),1.2f32),v2(u[2]*0.2f32,u[2]*0.1f32)))-0.5f32;
    sea:V3=myrealm_sea_at(v2(hit.x,hit.z),myrealm_sky_of(v3(ray.x+(rip*0.05f32),-ray.y,ray.z+(rip*0.05f32)),p,u),u);
    ground=wg_mix_f3f3f(ground,sea,smoothstep(u[31]-3.0f32,u[31]-2.2f32,r));
  }
  // a floating island: a band of earth at its edge, and past it nothing but sky
  if ((myrealm_land(u)>0.5f32)&&(myrealm_land(u)<1.5f32)) {
    ground=wg_mix_f3f3f(ground,wg_mul_f3f3(v3(0.32f32,0.22f32,0.15f32),myrealm_daylight(v3(0.0f32,1.0f32,0.0f32),u)),smoothstep(u[31]-0.9f32,u[31]-0.4f32,r));
  }
  // the realm's edge fades into the horizon's haze (u[43]: mist over the land, four times as thick)
  haze:f32=clampf(1.0f32-exp((-fmax(t-u[39],0.0f32))*0.018f32*(1.0f32+3.0f32*u[43])),0.0f32,1.0f32);
  ground=wg_mix_f3f3f(ground,v3(u[48],u[49],u[50]),haze*0.85f32);
  edge:f32=ifx down then 1.0f32-smoothstep(u[31]-3.0f32,u[31]+6.0f32,r) else 0.0f32;
  if ((myrealm_land(u)>1.5f32)&&down) {
    edge=1.0f32;
  }
  c:V3=wg_mul_f3f(wg_mix_f3f3f(sky,wg_mix_f3f3f(v3(u[48],u[49],u[50]),ground,edge),ifx down then 1.0f32 else 0.0f32),u[3]);
  if ((((myrealm_land(u)>0.5f32)&&(myrealm_land(u)<1.5f32))&&down)&&(r>u[31])) {
    c=wg_mul_f3f(sky,u[3]);
  }
  return wg_make_f4_f3f(myrealm_panels(p,c,u),1.0f32);
}
// ---- the pack's meshes: its vertices (pack_realm.py and drops.c: the Haunted House's 48
// bytes, position, normal, uv, colour with its layer in the top byte), a
// transform and tint a draw, its texture layers
MyrealmObject :: struct {r0:V4; r1:V4; r2:V4; material:V4; }
myrealm_word :: (i:u32,vertices:[]u32)->f32 {
  return f32_from_bits(vertices[cast(int)i]);
}
MyrealmS :: struct {pos:V4; world:V3; normal:V3; uv:V2; tint:V3; slice:u32 #flat; glow:f32 #flat; }
// its own light (myrealm-things.coax glowing), or below 0 its paint (paint)
// A round piece (myrealm.coax ROUND, drawn from vertex ROUND_BASE on, no index): a round cone from
// end a (r0: its place, its radius) to end b (r1), two half balls and the side between, twelve
// round and three rings to a half (ROUND_VERTICES, 504), as Dead Gears and Hecate's draw their
// figures' bones. Figures, owls, a windmill's tower: what the pack has no round mesh for.
MYREALM_ROUND_BASE :: cast(u32)16777216;
MYREALM_AROUND :: cast(u32)12;
MYREALM_RINGS :: cast(u32)3;
myrealm_quad :: (v:u32)->V2 {
  q:[6]V2=[6]V2.[v2(0.0f32,0.0f32),v2(1.0f32,0.0f32),v2(1.0f32,1.0f32),v2(0.0f32,0.0f32),v2(1.0f32,1.0f32),v2(0.0f32,1.0f32)];
  return q[cast(int)v];
}
MyrealmVert :: struct {p:V3; n:V3; }
myrealm_round_vertex :: (m:MyrealmObject,id:u32)->MyrealmVert {
  q:u32=id/6;
  c:V2=myrealm_quad(id%6);
  row:u32=add_wrap(q/MYREALM_AROUND,wg_u32_f(c.y));
  k:f32=((cast(f32)(add_wrap(q%MYREALM_AROUND,wg_u32_f(c.x))))/(cast(f32)(MYREALM_AROUND)))*6.2831853f32;
  a:V3=v3(m.r0.x,m.r0.y,m.r0.z);
  b:V3=v3(m.r1.x,m.r1.y,m.r1.z);
  axis:V3=wg_normalize3(wg_add_f3f3(wg_sub_f3f3(b,a),v3(0.0f32,0.00001f32,0.0f32)));
  side:V3=wg_normalize3(wg_cross3(axis,ifx abs(axis.y)<0.9f32 then v3(0.0f32,1.0f32,0.0f32) else v3(1.0f32,0.0f32,0.0f32)));
  other:V3=wg_cross3(axis,side);
  out:V3=wg_add_f3f3(wg_mul_f3f(side,cos(k)),wg_mul_f3f(other,sin(k)));
  top:bool=row>MYREALM_RINGS;
  step:f32=((cast(f32)(ifx top then sub_wrap(sub_wrap(row,MYREALM_RINGS),cast(u32)1) else row))/(cast(f32)(MYREALM_RINGS)))*1.5707963f32;
  phi:f32=ifx top then step else step-1.5707963f32;
  n:V3=wg_add_f3f3(wg_mul_f3f(out,cos(phi)),wg_mul_f3f(axis,sin(phi)));
  r:f32=ifx top then m.r1.w else m.r0.w;
  return MyrealmVert.{p=wg_add_f3f3(ifx top then b else a,wg_mul_f3f(n,r)),n=n};
}
myrealm_scene_vs :: (id:u32,instance:u32,u:[]f32,vertices:[]u32,objects:[]MyrealmObject)->MyrealmS {
  if (id>=MYREALM_ROUND_BASE) {
    m:MyrealmObject=objects[cast(int)instance];
    v:MyrealmVert=myrealm_round_vertex(m,sub_wrap(id,MYREALM_ROUND_BASE));
    o:MyrealmS;
    o.pos=v4(wg_dot4(wg_at4(u,8),v4(v.p.x,v.p.y,v.p.z,1.0f32)),wg_dot4(wg_at4(u,12),v4(v.p.x,v.p.y,v.p.z,1.0f32)),wg_dot4(wg_at4(u,16),v4(v.p.x,v.p.y,v.p.z,1.0f32)),wg_dot4(wg_at4(u,20),v4(v.p.x,v.p.y,v.p.z,1.0f32)));
    o.world=v.p;
    o.normal=v.n;
