    a:V3=wg_mul_f3f3(myrealm_paletted(wg_mix_f3f3f(v3(tex.x,tex.y,tex.z),soft,ifx myrealm_flat_style(u) then 0.8f32 else 0.55f32),u),s.tint);
    c:V3=wg_add_f3f3(wg_add_f3f3(ifx myrealm_flat_style(u) then myrealm_flat_lit(a,n,u) else myrealm_painted(a,n,d,u),myrealm_styled_lights(a,s.world,n,u)),wg_mul_f3f(a,fmax(s.glow,0.0f32)));
    c=myrealm_styled_far(c,s.world,dist,d,u);
