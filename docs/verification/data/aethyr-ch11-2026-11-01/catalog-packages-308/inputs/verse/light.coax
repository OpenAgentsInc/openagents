// Scalar visual functions shared by native numerical tests and Metal stages.
// Stage binding, texture sampling and vector packing belong to the driver.
lo :: (a:f32,b:f32)->f32 { if a<b { return a; } return b; }
hi :: (a:f32,b:f32)->f32 { if a>b { return a; } return b; }
sat :: (a:f32)->f32 { return lo(1.0f32,hi(0.0f32,a)); }
smooth :: (a:f32,b:f32,x:f32)->f32 { t:=sat((x-a)/(b-a));return t*t*(3.0f32-2.0f32*t); }
verse_sky :: (x:f32,y:f32)->f32 #export_c {
  r:=sqrt(x*x+y*y); return 0.006f32+0.018f32*exp(-r*r*1.8f32);
}
verse_dot :: (x:f32,y:f32,light:f32,soft:f32,crisp:f32)->f32 #export_c {
  r2:=x*x+y*y;
  if r2>=1.0f32 { return 0.0f32; }
  r:=sqrt(r2);
  point:=exp(-r2*10.0f32)+0.12f32*exp(-r2*3.0f32);
  disc:=(1.0f32-smooth(0.55f32,1.0f32,r))*0.9f32+0.1f32*exp(-r2*4.0f32);
  a:=(point+(disc-point)*soft)*(1.0f32-smooth(0.85f32,1.0f32,r2));
  node:=(1.0f32-smooth(0.40f32,0.5f32,r))+0.22f32*exp(-r2*7.0f32)*(1.0f32-smooth(0.7f32,1.0f32,r));
  return light*(a*1.6f32+(node-a*1.6f32)*crisp);
}
verse_line :: (across:f32,along:f32,a:f32,b:f32)->f32 #export_c {
  return (a+(b-a)*sat(along))*exp(-across*across*4.0f32);
}
cut_distance :: (x:f32,y:f32,w:f32,h:f32,k:f32)->f32 {
  dx:=abs(x)-w;dy:=abs(y)-h;
  box:=sqrt(hi(dx,0.0f32)*hi(dx,0.0f32)+hi(dy,0.0f32)*hi(dy,0.0f32))+lo(hi(dx,dy),0.0f32);
  return hi(box,(abs(x+y)-(w+h-14.0f32*k))*0.70710678f32);
}
verse_bar :: (x:f32,y:f32,w:f32,h:f32,k:f32,t:f32,press:f32,flash:f32)->f32 #export_c {
  d:=cut_distance(x,y,w,h,k);
  inside:=1.0f32-smooth(-0.5f32,0.5f32,d);
  edge:=1.0f32-smooth(0.5f32*k,1.6f32*k,abs(d));
  phase:=t/6.0f32-floor(t/6.0f32);
  sweep:=exp(-pow(((x+y*0.6f32)/w-(-1.6f32+3.2f32*phase/0.22f32))/0.10f32,2.0f32));
  if phase>0.22f32 { sweep=0.0f32; }
  glass:=(0.035f32+0.025f32*(1.0f32-y/h)+0.10f32*press+0.10f32*sweep)*inside;
  glow:=exp(-hi(d,0.0f32)/(9.0f32*k))*(1.0f32-inside)*(0.10f32+0.30f32*flash);
  return glass+edge*(0.65f32+0.5f32*flash)+glow;
}
verse_label :: (mask:f32,flash:f32)->f32 #export_c { return mask*(0.94f32+0.06f32*flash); }
verse_tone :: (light:f32)->f32 #export_c { return 1.0f32-exp(-light*1.35f32); }
verse_bloom :: (center:f32,near:f32,far:f32)->f32 #export_c { return center*0.4f32+near*0.24f32+far*0.06f32; }
// The Grid's cast (verse/cast.coax). Colours arrive as display values
// (sRGB, as aethyr's art stores them); the scene is light the tone curve
// maps back to the screen.
verse_decode :: (v:f32)->f32 #export_c {
  if v<=0.04045f32 { return v/12.92f32; }
  return pow((v+0.055f32)/1.055f32,2.4f32);
}
verse_encode :: (c:f32)->f32 #export_c {
  x:=sat(c);
  if x<=0.0031308f32 { return x*12.92f32; }
  return 1.055f32*pow(x,1.0f32/2.4f32)-0.055f32;
}
// The light whose tone is the display value v: the inverse of verse_tone.
verse_unlit :: (v:f32)->f32 #export_c { return -log(1.0f32-lo(sat(v),0.98f32))/1.35f32; }
// aethyr's Grid light on a surface facing (nx, ny, nz): a sun of 0.9 from
// (0.3, 0.9, 0.35), and a sky of 0.32 over a ground of 0.05.
verse_lit :: (nx:f32,ny:f32,nz:f32)->f32 #export_c {
  n:=sqrt(nx*nx+ny*ny+nz*nz);
  if n<=0.0f32 { return 0.32f32; }
  sun:=hi(0.0f32,(0.3f32*nx+0.9f32*ny+0.35f32*nz)/(n*1.0111874f32));
  up:=ny/n*0.5f32+0.5f32;
  return 0.9f32*sun+0.05f32+(0.32f32-0.05f32)*up;
}
// A lit character's colour channel: its linear albedo under that light,
// shown as the display value aethyr would show.
verse_character :: (albedo:f32,light:f32)->f32 #export_c { return verse_unlit(verse_encode(albedo*light)); }

// A robot's line art, `distance` metres from the eye (its depth), on a
// screen of `scale` pixels a point. Its width in pixels: half a point near,
// thinning to a quarter of a point from 8 m, never under a pixel. Its light:
// the tint's at 0.7, fading as the floor's lines do from 6 m to 110 m, and
// dimmer as a far robot's lines crowd into a few pixels.
verse_cast_line_width :: (scale:f32,distance:f32)->f32 #export_c {
  near:=lo(1.0f32,4.0f32/hi(distance,4.0f32));
  return hi(scale*0.5f32*hi(near,0.5f32),1.0f32);
}
verse_cast_line_light :: (tint:f32,distance:f32)->f32 #export_c {
  crowd:=hi(lo(1.0f32,6.0f32/hi(distance,0.001f32)),0.3f32);
  return verse_unlit(tint)*0.7f32*(1.0f32-smooth(6.0f32,110.0f32,distance))*crowd;
}

// A hotbar slot, as aethyr's HUD draws one (src/metal/home.metal, kSlot):
// dark glass with rounded corners, its icon in the middle, the picked one
// edged bright, a glow as it is used. (px, py) are pixels from its centre,
// y down; (ex, ey) its half size; k pixels a point. The host layers the
// light (premultiplied) over the screen with its coverage; the glow adds.
// Icons: 0 none, 1 the dance (a quaver; aethyr has none).
cover :: (d:f32)->f32 { return 1.0f32-smooth(-0.5f32,0.5f32,d); }
rim :: (d:f32,w:f32)->f32 { return 1.0f32-smooth(w*0.5f32-0.5f32,w*0.5f32+0.5f32,abs(d+w*0.5f32)); }
stroke :: (d:f32,w:f32)->f32 { return 1.0f32-smooth(w*0.5f32-0.5f32,w*0.5f32+0.5f32,d); }
sd_box :: (px:f32,py:f32,bx:f32,by:f32,r:f32)->f32 {
  qx:=abs(px)-bx+r; qy:=abs(py)-by+r;
  mx:=hi(qx,0.0f32); my:=hi(qy,0.0f32);
  return sqrt(mx*mx+my*my)+lo(hi(qx,qy),0.0f32)-r;
}
sd_segment :: (px:f32,py:f32,ax:f32,ay:f32,bx:f32,by:f32)->f32 {
  vx:=px-ax; vy:=py-ay; wx:=bx-ax; wy:=by-ay;
  t:=sat((vx*wx+vy*wy)/(wx*wx+wy*wy));
  dx:=vx-wx*t; dy:=vy-wy*t;
  return sqrt(dx*dx+dy*dy);
}
verse_slot_icon :: (icon:f32,px:f32,py:f32,s:f32,w:f32)->f32 #export_c {
  if icon<0.5f32 || icon>1.5f32 { return 0.0f32; }
  hx:=(px+0.2f32*s)/(0.24f32*s); hy:=(py-0.38f32*s)/(0.18f32*s);
  head:=cover((sqrt(hx*hx+hy*hy)-1.0f32)*0.18f32*s);
  stem:=stroke(sd_segment(px,py,0.03f32*s,0.36f32*s,0.03f32*s,-0.6f32*s),w);
  flag:=stroke(sd_segment(px,py,0.03f32*s,-0.6f32*s,0.42f32*s,-0.3f32*s),w);
  return hi(head,hi(stem,flag));
}
// The slot's layers, light and coverage, `alpha` choosing which.
slot :: (px:f32,py:f32,ex:f32,ey:f32,k:f32,press:f32,flash:f32,sel:f32,icon:f32,alpha:bool)->f32 {
  sink:=1.0f32-0.03f32*press;
  x:=px/sink; y:=py/sink;
  d:=sd_box(x,y,ex,ey,5.0f32*k);
  inside:=cover(d);
  ny:=y/ey;
  g:=0.0f32; a:=0.0f32;
  // glass
  la:=0.62f32*inside; lc:=0.04f32+0.05f32*(0.5f32-0.5f32*ny)+0.08f32*press+0.05f32*sel;
  g=lc*la+g*(1.0f32-la); a=la+a*(1.0f32-la);
  // icon
  la=verse_slot_icon(icon,x,y-1.5f32*k,lo(ex,ey)*0.36f32,1.5f32*k); lc=0.72f32+0.28f32*sel;
  g=lc*la+g*(1.0f32-la); a=la+a*(1.0f32-la);
  // edge
  la=sat(rim(d,(1.0f32+0.6f32*sel)*k)*(0.28f32+0.62f32*sel+0.4f32*flash)); lc=0.95f32;
  g=lc*la+g*(1.0f32-la); a=la+a*(1.0f32-la);
  if alpha { return a; }
  return g;
}
verse_slot_light :: (px:f32,py:f32,ex:f32,ey:f32,k:f32,press:f32,flash:f32,sel:f32,icon:f32)->f32 #export_c {
  return slot(px,py,ex,ey,k,press,flash,sel,icon,false);
}
verse_slot_cover :: (px:f32,py:f32,ex:f32,ey:f32,k:f32,press:f32,flash:f32,sel:f32,icon:f32)->f32 #export_c {
  return slot(px,py,ex,ey,k,press,flash,sel,icon,true);
}
verse_slot_glow :: (px:f32,py:f32,ex:f32,ey:f32,k:f32,flash:f32,sel:f32)->f32 #export_c {
  d:=sd_box(px,py,ex,ey,5.0f32*k);
  return exp(-hi(d,0.0f32)/(7.0f32*k))*(1.0f32-cover(d))*(0.12f32*sel+0.25f32*flash);
}

within :: (a:f32,b:f32,t:f32)->bool { return abs(a-b)<=t; }
#test "display values round trip through linear light" {
  for i: 0..<11 { v:=f32(i)/10.0f32; #assert within(verse_encode(verse_decode(v)),v,0.0001f32); }
  #assert verse_decode(0.0f32)==0.0f32 && within(verse_decode(1.0f32),1.0f32,0.00001f32);
  #assert within(verse_decode(0.5f32),0.21404f32,0.0001f32) && within(verse_decode(0.04f32),0.04f32/12.92f32,0.000001f32);
  #assert verse_encode(2.0f32)==verse_encode(1.0f32) && verse_encode(-1.0f32)==0.0f32;
  #assert within(verse_encode(0.002f32),0.002f32*12.92f32,0.000001f32);
}
#test "unlit light tones back to its display value" {
  for i: 0..<10 { v:=f32(i)/10.0f32; #assert within(verse_tone(verse_unlit(v)),v,0.0001f32); }
  #assert within(verse_tone(verse_unlit(1.0f32)),0.98f32,0.0001f32);
  #assert verse_unlit(-1.0f32)==0.0f32;
}
#test "the sun and sky light a surface as aethyr's Grid" {
  // Facing the sun: all of it, and most of the sky.
  #assert within(verse_lit(0.3f32,0.9f32,0.35f32),0.9f32+0.05f32+0.27f32*(0.9f32/1.0111874f32*0.5f32+0.5f32),0.0001f32);
  // Straight down: no sun, the ground only.
  #assert within(verse_lit(0.0f32,-2.0f32,0.0f32),0.05f32,0.00001f32);
  // Straight up, unnormalized.
  #assert within(verse_lit(0.0f32,3.0f32,0.0f32),0.9f32*0.9f32/1.0111874f32+0.32f32,0.0001f32);
  #assert verse_lit(0.0f32,0.0f32,0.0f32)==0.32f32;
  #assert within(verse_character(0.5f32,1.0f32),verse_unlit(verse_encode(0.5f32)),0.000001f32);
}
#forall "robot lines thin and dim with distance, never under a pixel" i: 0..<60, k: 1..<4 {
  d:=f32(i)*2.0f32; e:=d+2.0f32; scale:=f32(k);
  #assert verse_cast_line_width(scale,e)<=verse_cast_line_width(scale,d) && verse_cast_line_width(scale,e)>=1.0f32;
  #assert verse_cast_line_light(0.5f32,e)<=verse_cast_line_light(0.5f32,d);
}
#test "robot line widths and light at their ends" {
  #assert verse_cast_line_width(3.0f32,1.0f32)==1.5f32 && verse_cast_line_width(3.0f32,4.0f32)==1.5f32;
  #assert verse_cast_line_width(3.0f32,8.0f32)==1.0f32 && verse_cast_line_width(3.0f32,6.0f32)==1.0f32;
  #assert verse_cast_line_width(6.0f32,8.0f32)==1.5f32 && verse_cast_line_width(6.0f32,100.0f32)==1.5f32;
  #assert verse_cast_line_width(1.0f32,0.0f32)==1.0f32;
  #assert within(verse_cast_line_light(0.5f32,3.0f32),verse_unlit(0.5f32)*0.7f32,0.00001f32);
  #assert within(verse_cast_line_light(0.5f32,12.0f32),verse_unlit(0.5f32)*0.7f32*(1.0f32-smooth(6.0f32,110.0f32,12.0f32))*0.5f32,0.00001f32);
  #assert verse_cast_line_light(0.5f32,30.0f32)==verse_unlit(0.5f32)*0.7f32*(1.0f32-smooth(6.0f32,110.0f32,30.0f32))*0.3f32;
  #assert verse_cast_line_light(0.5f32,110.0f32)==0.0f32 && verse_cast_line_light(0.0f32,1.0f32)==0.0f32;
}
#test "a hotbar slot: glass inside, nothing far outside, brighter picked and pressed" {
  // Its middle-left: the glass (no icon there), 0.62 covered.
  #assert within(verse_slot_cover(-15.0f32,0.0f32,23.0f32,23.0f32,1.0f32,0.0f32,0.0f32,0.0f32,1.0f32),0.62f32,0.001f32);
  #assert within(verse_slot_light(-15.0f32,0.0f32,23.0f32,23.0f32,1.0f32,0.0f32,0.0f32,0.0f32,1.0f32),0.62f32*0.065f32,0.001f32);
  #assert verse_slot_light(-15.0f32,0.0f32,23.0f32,23.0f32,1.0f32,1.0f32,0.0f32,1.0f32,1.0f32)>verse_slot_light(-15.0f32,0.0f32,23.0f32,23.0f32,1.0f32,0.0f32,0.0f32,0.0f32,1.0f32);
  #assert verse_slot_cover(40.0f32,0.0f32,23.0f32,23.0f32,1.0f32,0.0f32,0.0f32,1.0f32,1.0f32)==0.0f32;
  // Its edge is lit, more when picked.
  #assert verse_slot_light(22.5f32,0.0f32,23.0f32,23.0f32,1.0f32,0.0f32,0.0f32,1.0f32,1.0f32)>verse_slot_light(22.5f32,0.0f32,23.0f32,23.0f32,1.0f32,0.0f32,0.0f32,0.0f32,1.0f32);
  #assert verse_slot_light(22.5f32,0.0f32,23.0f32,23.0f32,1.0f32,0.0f32,0.0f32,0.0f32,1.0f32)>0.2f32;
  // The glow: only outside, only picked or flashing, fading away.
  #assert verse_slot_glow(0.0f32,0.0f32,23.0f32,23.0f32,1.0f32,0.0f32,1.0f32)==0.0f32;
  #assert verse_slot_glow(30.0f32,0.0f32,23.0f32,23.0f32,1.0f32,0.0f32,0.0f32)==0.0f32;
  #assert verse_slot_glow(30.0f32,0.0f32,23.0f32,23.0f32,1.0f32,1.0f32,0.0f32)>verse_slot_glow(40.0f32,0.0f32,23.0f32,23.0f32,1.0f32,1.0f32,0.0f32);
}
#test "the dance icon is a note: a head, a stem, a flag" {
  #assert verse_slot_icon(1.0f32,-2.0f32,3.8f32,10.0f32,1.5f32)==1.0f32;    // the head
  #assert verse_slot_icon(1.0f32,0.3f32,-2.0f32,10.0f32,1.5f32)>0.9f32;     // the stem
  #assert verse_slot_icon(1.0f32,2.25f32,-4.5f32,10.0f32,1.5f32)>0.9f32;    // the flag
  #assert verse_slot_icon(1.0f32,-4.0f32,-4.0f32,10.0f32,1.5f32)==0.0f32;   // empty
  #assert verse_slot_icon(0.0f32,-2.0f32,3.8f32,10.0f32,1.5f32)==0.0f32 && verse_slot_icon(2.0f32,-2.0f32,3.8f32,10.0f32,1.5f32)==0.0f32;
}
