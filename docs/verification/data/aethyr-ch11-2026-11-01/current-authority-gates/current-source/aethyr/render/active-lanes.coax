// Ordered iteration over the active members of one TL,TR,BL,BR quad.
#module "aethyr.render.active.lanes";
#authority;
RQActiveLanes :: struct {count:int;lanes:[4]int;}
#load "tests/active-lanes-checks.coax";
rq_active_lanes :: (mask:u32)->RQActiveLanes {
 r:RQActiveLanes;bits:=mask&15;lane:=0;
 while bits!=0 {
  if (bits&1)!=0 {r.lanes[r.count]=lane;r.count+=1;}
  bits>>=1;lane+=1;
 }return r;
}
