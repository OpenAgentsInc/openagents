// Raster precision is a declared backend profile, not a universal GPU bit
// width. Analytic mode is a mathematical conformance model. Fixed modes need
// device/probe provenance in the enclosing qualification receipt.
#module "aethyr.render.raster.profile";
#load "reference-quad.coax";
#authority;
RRRasterRounding :: enum u8 {analytic;nearest_even;nearest_positive;invalid;}
RRXYClipping :: enum u8 {viewport;guard_band;invalid;}
RRRasterProfile :: struct {rounding:RRRasterRounding;subpixel_bits:int;xy:RRXYClipping;guard_pixels:int;}
RRCoordinate :: struct {status:RQStatus;value:f64;}
#load "tests/raster-profile-checks.coax";
rr_raster_profile :: (name:string,bits:int)->RRRasterProfile {
 p:=RRRasterProfile.{rounding=RRRasterRounding.invalid,subpixel_bits=bits};
 if name=="analytic" {p.rounding=RRRasterRounding.analytic;}if name=="nearest-even" {p.rounding=RRRasterRounding.nearest_even;}if name=="nearest-positive" {p.rounding=RRRasterRounding.nearest_positive;}return p;
}
rr_raster_profile_ok :: (p:RRRasterProfile)->bool {
 if p.rounding==RRRasterRounding.analytic {if p.subpixel_bits!=0 {return false;}}
 else {if (p.rounding!=RRRasterRounding.nearest_even && p.rounding!=RRRasterRounding.nearest_positive) || p.subpixel_bits<0 || p.subpixel_bits>16 {return false;}}
 if p.xy==RRXYClipping.viewport {return p.guard_pixels==0;}
 return p.xy==RRXYClipping.guard_band && p.guard_pixels>=0 && p.guard_pixels<=65536;
}
// Self-subtraction is exactlyzero for every finitevalue, including signedzero
// and largest normals. Infinities and every NaN payload instead yieldNaN.
rr_coordinate_finite :: (v:f64)->bool {return (v-v)==0;}
rr_subpixel :: (value:f64,p:RRRasterProfile)->RRCoordinate {
 if !rr_raster_profile_ok(p) {return RRCoordinate.{status=RQStatus.unsupported};}
 if !rr_coordinate_finite(value) {return RRCoordinate.{status=RQStatus.resource};}
 if p.rounding==RRRasterRounding.analytic {return RRCoordinate.{value=value};}
 scale:=cast(f64)(cast(u64)1<<cast(u32)p.subpixel_bits);scaled:=value*scale;
 if !rr_coordinate_finite(scaled) {return RRCoordinate.{status=RQStatus.resource};}
 low:=floor(scaled);fraction:=scaled-low;
 // A represented half-integer has magnitude below2^53. Its floor therefore
 // fits int64 before parity is inspected; larger finite values have fraction0.
 if fraction>0.5 || (fraction==0.5 && (p.rounding==RRRasterRounding.nearest_positive || (cast(int)low&1)!=0)) {low+=1;}
 return RRCoordinate.{value=low/scale};
}

rr_raster_xy_profile :: (name:string,bits:int,xy:string,guard:int)->RRRasterProfile {
 p:=rr_raster_profile(name,bits);p.guard_pixels=guard;p.xy=RRXYClipping.invalid;
 if xy=="viewport" {p.xy=RRXYClipping.viewport;}if xy=="guard-band" {p.xy=RRXYClipping.guard_band;}return p;
}
