#test "render geometry grass near rings retain phone threshold and checked u32 arithmetic" {
  u:[2300]f32;u[1172]=1;u[1173]=0.5;u[1191]=3;
  f:=RenderFeatures.{scene=true,grass=true};c:=FrameCounts.{grass_instances=1};g:=RGContext.{app="everglade",u=u[..]};
  r:=rg_direct(g,f,c);#assert r.status==RenderGeometryStatus.ok && r.direct.grass_instances==589;
  u[1210]=0.5;r=rg_direct(g,f,c);#assert r.status==RenderGeometryStatus.ok && r.direct.grass_instances==589;
  u[1210]=1;r=rg_direct(g,f,c);#assert r.status==RenderGeometryStatus.ok && r.direct.grass_instances==433;
  u[1191]=0;r=rg_direct(g,f,c);#assert r.status==RenderGeometryStatus.ok && r.direct.grass_instances==1;
  u[1210]=0;u[1172]=64847;u[1173]=128.5;u[1191]=60652;
  r=rg_direct(g,f,c);#assert r.status==RenderGeometryStatus.ok && r.direct.grass_instances==4294967295;
  u[1172]=64;u[1173]=4096;u[1191]=0;#assert rg_direct(g,f,c).status==RenderGeometryStatus.bad_uniforms;
  u[1172]=65535;u[1173]=128;r=rg_direct(g,f,c);#assert r.status==RenderGeometryStatus.ok && r.direct.grass_instances==4294901760;
}
