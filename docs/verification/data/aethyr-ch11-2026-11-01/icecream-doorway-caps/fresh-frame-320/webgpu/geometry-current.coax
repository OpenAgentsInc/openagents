  b[1].words=nodes[0..<31];#assert render_geometry_admit(2,c,rg_local_words[..],none,u[..],b[..],rg_hud_payload,out[..],8).status==RenderGeometryStatus.bad_resources;
  u[1083]=0;#assert render_geometry_admit(2,c,rg_local_words[..],none,u[..],b[..],rg_hud_payload,out[..],8).status==RenderGeometryStatus.ok;
}
#test "render geometry shard plane encoding uses a full byte below the plane index" {
  v:[24]u32;o:[3184]u32;o[15]=f32_bits(50885.0f32);w:=[1]RGWork.[RGWork.{left=1}];
  g:=RGContext.{app="everglade",vertices=v[..],objects=o[..],cells=1};d:=RenderDecodedDraw.{kind=RenderDrawKind.nonindexed,base_instance=1,instances=1};
  #assert rg_record(g,d,w[..]).status==RenderGeometryStatus.bad_resources;
  o[15]=f32_bits(50629.0f32);w[0]=RGWork.{left=1};#assert rg_record(g,d,w[..]).status==RenderGeometryStatus.ok;
}
#forall "render geometry river spacing is finite bounded and may disable node reads" variant:0..<4 {
  u:[2300]f32;u[32]=1;u[1072]=2;u[1073]=2;u[1074]=1;u[1075]=1;u[1076]=1;u[1083]=1;
  if variant==0 {u[1083]=-1;}if variant==1 {u[1083]=4294967296.0f32;}if variant==2 {z:=0.0f32;u[1083]=z/z;}if variant==3 {u[1072]=1;}
  h:[4]u32;nodes:[32]u32;rg_hud_payload:[]f32;none:[]u32;out:[1]RenderDrawDomain;
  b:=[2]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=2,words=h[..]},RenderGeometryBuffer.{resource=5,words=nodes[..]}];
  rg_local_words:=[4]u32.[0,6,0x80000000,1];c:=FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=1};
  r:=render_geometry_admit(2,c,rg_local_words[..],none,u[..],b[..],rg_hud_payload,out[..],8);
  #assert r.status==(ifx variant==3 then RenderGeometryStatus.ok else RenderGeometryStatus.bad_uniforms);
}

RGWork :: struct { left:int; used:int; }
RGContext :: struct {
  app:string; u:[]f32; vertices:[]u32; objects:[]u32; heights:[]u32; indices:[]u32;
  pose:[]u32; water:[]u32; puffs:[]u32; lights:[]u32;
  cells:u64;
}
RGDomain :: struct { status:RenderGeometryStatus=RenderGeometryStatus.bad_draw; domain:RenderDrawDomain; }
RGGround :: struct { ok:bool; n:int; rows:int; cells:u64; points:int; }
rg_min :: (a:u64,b:u64)->u64 {
  if b==0 {return 0;}
  return ifx a<=b-1 then a else b;
}
rg_take :: (w:[]RGWork)->bool {
  if w[0].left<1 {return false;}
  w[0].left-=1;w[0].used+=1;return true;
}
// Strict address metadata is an exactly represented nonnegative integer. Shape
// words may additionally carry their documented fractional opacity.
rg_integer :: (v:f32,rg_local_most:int)->int {
  if !(v>=0 && f64(v)<=f64(rg_local_most)) {return -1;}
  n:=cast(int)v;return ifx f32(n)==v then n else -1;
}
rg_code :: (v:f32)->int {
  if !(v>=0 && v<4294967296.0f32) {return -1;}
  return cast(int)v;
}
rg_finite_word :: (word:u32)->bool {
  exponent:u32=0x7f800000;
  return (word&exponent)!=exponent;
}
rg_integer_word :: (word:u32,rg_local_most:int)->int {
  if !rg_finite_word(word) {return -1;}
  return rg_integer(f32_from_bits(word),rg_local_most);
}
rg_code_word :: (word:u32)->int {
  if !rg_finite_word(word) {return -1;}
  return rg_code(f32_from_bits(word));
}
rg_payload :: (profile:int,set:int,name:string,buffers:[]RenderGeometryBuffer)->[]u32 {
  for b:buffers {if b.binding_set==set && render_catalog_binding(profile,set,b.resource).name==name {return b.words;}}
  empty:[]u32;return empty;
}
rg_buffers :: (profile:int,buffers:[]RenderGeometryBuffer)->int {
  if buffers.count>RENDER_RESOURCES {return -2;}
  for i:0..<buffers.count {
    b:=buffers[i];rb:=render_catalog_binding(profile,b.binding_set,b.resource);
    if rb.kind!=RenderResourceKind.storage {return i;}
    if b.words.count%(rb.stride/4)!=0 {return i;}
    for j:0..<i {if b.binding_set==buffers[j].binding_set && b.resource==buffers[j].resource {return i;}}
  }
  return -1;
}

rg_ground :: (n_value:f32,rows_value:f32,height_words:int,planes:bool,plane_offset:f32)->RGGround {
  r:=RGGround.{};r.n=rg_integer(n_value,32767);r.rows=rg_integer(rows_value,32767);
  if r.n<1 || r.rows<1 {return r;}
  r.points=(r.n+1)*(r.rows+1);
  if height_words<r.points {return r;}
  if planes && (f64(plane_offset)!=f64(r.points) || height_words<r.points*3) {return r;}
  r.cells=u64(r.n)*u64(r.rows);r.ok=true;return r;
}

rg_icecream :: (g:RGContext,d:RenderDecodedDraw)->RGDomain {
  r:=RGDomain.{};vcount:=cast(u64)g.vertices.count/6;
  object_base:u64=8388608;rg_local_outline:u64=4194304;chunks:u64=1024;chunk_vertices:u64=1020;
  start:=u64(d.base_instance);amount:=u64(d.instances);last:=start+amount-1;
  offset:u64;prefix:u64;available:u64;
  if start<object_base {
    available=(vcount+chunk_vertices-1)/chunk_vertices;
    r.domain.instances=rg_min(available,object_base);
    if last>=r.domain.instances {return r;}
    offset=last*chunk_vertices;
  } else {
    if start>=object_base+2*rg_local_outline || vcount==0 {return r;}
    k:=start-object_base;object:=(k%rg_local_outline)/chunks;record_words:u64=24;
    if object>=cast(u64)g.objects.count/record_words {return r;}
    chunk:=rg_integer_word(g.objects[cast(int)(object*record_words+20)],cast(int)((vcount-1)/chunk_vertices));
    if chunk<0 {r.status=RenderGeometryStatus.bad_resources;return r;}
    prefix=object_base+(k/rg_local_outline)*rg_local_outline+object*chunks;
    available=rg_min(chunks,(vcount-u64(chunk)*chunk_vertices+chunk_vertices-1)/chunk_vertices);
    r.domain.instance_begin=prefix;r.domain.instances=prefix+available;
    if last>=r.domain.instances {return r;}
    offset=(u64(chunk)+last-prefix)*chunk_vertices;
  }
  r.domain.vertices=rg_min(chunk_vertices,vcount-offset);
  r.status=RenderGeometryStatus.ok;return r;
}

rg_skin :: (g:RGContext,d:RenderDecodedDraw,row:int,w:[]RGWork)->RGDomain {
  r:=RGDomain.{status=RenderGeometryStatus.bad_resources};
  marker_word:=g.objects[row*16+14];
  if !rg_finite_word(marker_word) {return r;}
  marker:=f32_from_bits(marker_word);
  if !(marker>=0 && marker<=2) {return r;}
  rg_local_person:=marker>1.5;stride:=ifx rg_local_person then 6 else 8;
  offset:=rg_integer_word(g.objects[row*16+12],g.vertices.count-stride);
  if offset<0 {return r;}
  pose_rows:=g.pose.count/4;
  if rg_local_person {
    pose_base:=rg_integer_word(g.objects[row*16+13],pose_rows-198);
    if pose_base<0 {return r;}
  }
  r.domain.vertices=cast(u64)((g.vertices.count-offset)/stride);
  for j:0..<cast(int)d.count {
    if !rg_take(w) {r.status=RenderGeometryStatus.work_budget;return r;}
    id:=ifx d.kind==RenderDrawKind.indexed then u64(g.indices[cast(int)d.first+j]) else u64(d.first)+u64(j);
    at:=u64(offset)+id*u64(stride);
    if at+u64(stride)>u64(g.vertices.count) {r.status=RenderGeometryStatus.bad_draw;return r;}
    joints:=g.vertices[cast(int)at+(ifx rg_local_person then 4 else 6)];
    for k:0..<4 {
      joint:=cast(int)((joints>>u32(8*k))&255);
      if rg_local_person {if joint>=65 {return r;}}
      else if joint*3+2>=pose_rows {return r;}
    }
  }
  r.status=RenderGeometryStatus.ok;return r;
}

rg_water :: (g:RGContext)->RGDomain {
  r:=RGDomain.{status=RenderGeometryStatus.bad_uniforms};
  at:=ifx g.app=="everglade" then 1072 else 780;
  cols:=rg_integer(g.u[at],32767);rows:=rg_integer(g.u[at+1],32767);
  across:=rg_integer(g.u[at+2],4096);along:=rg_integer(g.u[at+3],4096);
  distance:=g.u[at+4];
  // The profile admits patch lengths of at least 1/1024 grid units; with
  // <=32767 rows this proves the derived piece count fits u32 without a cast
  // overflow or an unbounded reciprocal of a positive subnormal.
  if cols<2 || rows<2 || across<1 || along<1 || !(distance>=0.0009765625f32 && distance<4294967296.0f32) {return r;}
  if u64(cols)*u64(rows)*8>u64(g.water.count) {r.status=RenderGeometryStatus.bad_resources;return r;}
  r.domain.vertices=u64(across)*u64(along)*6;
  if g.app=="everglade" {
    rg_local_patches:=rg_integer(g.u[at+5],65535);
    if rg_local_patches<0 {return r;}
    per:=u64(across)*u64(along);
    // The producer reserves three spray slots at both tiers. At the desktop
    // tier only the first has live particles; eg_fx_vertex clips k>=64 before
    // any particle read. Those two bounded empty slots are valid draws too.
    spray:=(64+per-1)/per;
    spray=3+spray-rg_min(3,spray);
    r.domain.instances=u64(rg_local_patches)+65+spray;
  } else {
    pieces:=f64(rows-1)/f64(distance);
    n:=cast(u64)pieces;r.domain.instances=n+(ifx f64(n)<pieces then u64(1) else u64(0));
  }
  r.status=RenderGeometryStatus.ok;return r;
}

rg_direct :: (g:RGContext,f:RenderFeatures,c:FrameCounts)->RenderGeometryResult {
  r:=RenderGeometryResult.{status=RenderGeometryStatus.ok};
  if f.casters {r.direct.caster_vertices=1872;r.direct.caster_instances=8;}
  if f.grass && c.grass_instances>0 {
    at:=ifx g.app=="fixture" then 244 else 1172;
    most_instances:u64=4294967295;
    per:=rg_integer(g.u[at],65535);side:=rg_integer(g.u[at+1]*2,cast(int)most_instances);
    if per<1 || side<1 {r.status=RenderGeometryStatus.bad_uniforms;return r;}
    if u64(side)>most_instances/u64(per)/u64(side) {r.status=RenderGeometryStatus.bad_uniforms;return r;}
    r.direct.grass_instances=u64(per)*u64(side)*u64(side);
    if g.app=="everglade" {
      near_per:=rg_integer(g.u[1191],65535);rg_phone:=g.u[1210];
      if near_per<0 || !(rg_phone>=0 && rg_phone<=1) {r.status=RenderGeometryStatus.bad_uniforms;return r;}
      near_side:=ifx rg_phone>0.5 then u64(12) else u64(14);
      near_count:=u64(near_per)*near_side*near_side;
      if near_count>most_instances-r.direct.grass_instances {r.status=RenderGeometryStatus.bad_uniforms;return r;}
      r.direct.grass_instances+=near_count;
    }
  }
  if f.surface && c.surface_vertices>0 {
    n:=32;levels:=rg_integer(g.u[45],12);
    if g.u[44]==64 {n=64;}else if g.u[44]!=32 {r.status=RenderGeometryStatus.bad_uniforms;return r;}
    if levels<1 {r.status=RenderGeometryStatus.bad_uniforms;return r;}
    for i:0..<levels {
      cell:=g.u[50+i*4];hole:=rg_integer(g.u[51+i*4],3);
      if !(cell>0 && cell<4294967296.0f32) || hole<0 {r.status=RenderGeometryStatus.bad_uniforms;return r;}
    }
    full:=n*n;rg_surface_ring:=full-(n/2)*(n/2);
    r.direct.surface_vertices=u64(6*(full+(levels-1)*rg_surface_ring));
  }
  return r;
}

// Pure extent arithmetic is separate from payload inspection, so its boundary
// checks can exercise huge virtual domains without allocating huge fixtures.
// Production callers obtain both word counts from the admitted borrowed views.
rg_packed :: (app:string,vertex_words:int,object_words:int,d:RenderDecodedDraw)->RGDomain {
  r:=RGDomain.{};rows:=u64(object_words/16);
  if u64(d.base_instance)+u64(d.instances)>rows {return r;}
  r.domain.instances=rows;r.domain.vertices=u64(vertex_words/12);
  if app=="myrealm" {
    round_base:u64=16777216;
    r.domain.vertices=rg_min(r.domain.vertices,round_base);
    r.domain.vertex_alt_begin=round_base;r.domain.vertex_alt_end=round_base+504;
  }
  r.status=RenderGeometryStatus.ok;return r;
}

rg_record :: (g:RGContext,d:RenderDecodedDraw,w:[]RGWork)->RGDomain {
  r:=RGDomain.{};
  if g.app=="icecream" {return rg_icecream(g,d);}
  rows:=cast(u64)g.objects.count/16;
  start:=u64(d.base_instance);past:=start+u64(d.instances);
  if g.app=="realm" || g.app=="droprealm" || g.app=="fixture" || g.app=="myrealm" {
    return rg_packed(g.app,g.vertices.count,g.objects.count,d);
  }
  if g.app=="deadgears" {
    if past>rows {return r;}
    r.domain.instances=rows;r.domain.vertices=ifx past<=96 then 240 else 36;
    r.status=RenderGeometryStatus.ok;return r;
  }
  if start<g.cells {
    if past>g.cells {return r;}
    r.domain.vertices=6;r.domain.instances=g.cells;
    r.status=RenderGeometryStatus.ok;return r;
  }
  if past>g.cells+rows {return r;}
  r.domain.instance_begin=g.cells;r.domain.instances=g.cells+rows;
  first:=cast(int)(start-g.cells);
  for i:first..<cast(int)(past-g.cells) {
    if !rg_take(w) {r.status=RenderGeometryStatus.work_budget;return r;}
    code:=rg_code_word(g.objects[i*16+15]);
    if code<0 {r.status=RenderGeometryStatus.bad_resources;return r;}
    kind:=code%8;rg_local_most:u64=ifx g.app=="villa" then 48 else 96;
    if kind==1 {rg_local_most=36;}
    else if kind==2 {rg_local_most=ifx g.app=="villa" then 240 else 960;}
    else if kind==3 {rg_local_most=ifx g.app=="villa" then 96 else 192;}
    else if g.app=="villa" && kind==5 {rg_local_most=240;}
    else if g.app=="everglade" {
      if kind==5 {
        if (code/8)%32==24 && u64(code/256)+2>rows {r.status=RenderGeometryStatus.bad_resources;return r;}
        rg_local_most=cast(u64)g.vertices.count/12;
      }
      else if kind==6 {
        skin:=rg_skin(g,d,i,w);
        if skin.status!=RenderGeometryStatus.ok {return skin;}
        rg_local_most=skin.domain.vertices;
      }
      else if kind==7 {rg_local_most=1008;}
    }
    r.domain.vertices=ifx i==first then rg_local_most else rg_min(r.domain.vertices,rg_local_most);
  }
  r.status=RenderGeometryStatus.ok;return r;
}

render_geometry_admit :: (profile:int,c:FrameCounts,draw_words:[]u32,indices:[]u32,u:[]f32,buffers:[]RenderGeometryBuffer,rg_hud_payload:[]f32,domains:[]RenderDrawDomain,work_limit:int)->RenderGeometryResult {
  result:=RenderGeometryResult.{};meta:=render_catalog(profile);
  if !meta.valid {return result;}
  if c.draw_count<0 || c.draw_count>RENDER_GEOMETRY_DRAWS || domains.count<c.draw_count || draw_words.count<c.draw_count*4 {result.status=RenderGeometryStatus.capacity;return result;}
  if c.vertex_stride!=meta.vertex_stride || c.water_draws<0 || c.water_draws>c.draw_count || (!meta.features.scene && c.draw_count>0) || (!meta.features.water && c.water_draws>0) {result.status=RenderGeometryStatus.bad_counts;return result;}
  if work_limit<1 || work_limit>RENDER_GEOMETRY_WORK {result.status=RenderGeometryStatus.work_budget;return result;}
  if u.count<meta.uniform_vec4s*4 {result.status=RenderGeometryStatus.bad_uniforms;return result;}
  bad:=rg_buffers(profile,buffers);
  if bad!=-1 {result.status=ifx bad==-2 then RenderGeometryStatus.capacity else RenderGeometryStatus.bad_resources;result.bad_resource=bad;return result;}
  g:=RGContext.{app=meta.app,u=u,indices=indices,vertices=rg_payload(profile,0,"vertices",buffers),objects=rg_payload(profile,0,"objects",buffers),heights=rg_payload(profile,0,"heights",buffers),pose=rg_payload(profile,0,"pose",buffers),water=rg_payload(profile,0,"water_nodes",buffers),lights=rg_payload(profile,0,"lights",buffers)};
  direct:=rg_direct(g,meta.features,c);
  if direct.status!=RenderGeometryStatus.ok {return direct;}
  result.direct=direct.direct;result.direct.hud_vertices=cast(u64)(rg_hud_payload.count/meta.vertex_stride);
  if meta.features.particles {
    name:=ifx meta.app=="everglade" then "puffs" else "emitters";
    g.puffs=rg_payload(profile,1,name,buffers);
    result.direct.particle_instances=ifx meta.app=="everglade" then cast(u64)g.puffs.count/12 else (cast(u64)g.puffs.count/16)*64;
  }
  rg_local_active:=c.grass_instances>0;
  for i:0..<c.draw_count {if draw_words[i*4+1]!=0 && draw_words[i*4+3]!=0 {rg_local_active=true;}}
  if rg_local_active && meta.app=="realm" && rg_integer(u[27],g.lights.count/8)<0 {result.status=RenderGeometryStatus.bad_resources;return result;}
  if rg_local_active && (meta.app=="garden" || meta.app=="villa" || meta.app=="fairy" || meta.app=="everglade") {
    at:=ifx meta.app=="villa" then 168 else 32;
    fairy:=meta.app=="fairy";
    rg_local_ground:=rg_ground(u[at],ifx fairy then u[238] else u[at],g.heights.count,fairy,ifx fairy then u[239] else 0.0f32);
    if !rg_local_ground.ok {result.status=RenderGeometryStatus.bad_resources;return result;}
    g.cells=rg_local_ground.cells;
  }
  if rg_local_active && meta.app=="everglade" {
    rg_cell_step:=u[1083];
    if !(rg_cell_step>=0 && rg_cell_step<4294967296.0f32) {result.status=RenderGeometryStatus.bad_uniforms;return result;}
    if rg_cell_step>0 && !(u[1072]<2) {
      water:=rg_water(g);
      if water.status!=RenderGeometryStatus.ok {result.status=water.status;return result;}
    }
  }
  work:[1]RGWork;work[0].left=work_limit;local:[RENDER_GEOMETRY_DRAWS]RenderDrawDomain;
  for i:0..<c.draw_count {
    d:=render_decode_draw(draw_words,i);
    // The preflight proves every record's four words exist, so decoding can
    // return only skip, indexed or nonindexed here.
    if d.kind==RenderDrawKind.skip {continue;}
    if !rg_take(work[..]) {result.status=RenderGeometryStatus.work_budget;result.bad_draw=i;result.work=work[0].used;return result;}
    if d.kind==RenderDrawKind.indexed && u64(d.first)+u64(d.count)>u64(indices.count) {result.status=RenderGeometryStatus.bad_draw;result.bad_draw=i;return result;}
    r:=ifx i>=c.draw_count-c.water_draws then rg_water(g) else rg_record(g,d,work[..]);
    if r.status!=RenderGeometryStatus.ok {result.status=r.status;result.bad_draw=i;result.work=work[0].used;return result;}
    r.domain.indices=cast(u64)indices.count;local[i]=r.domain;
    one:=[1]RenderDrawDomain.[r.domain];uploads:[]RenderUpload;
    check:=render_frame_admit(FrameCounts.{width=c.width,height=c.height,vertex_stride=meta.vertex_stride,draw_count=1},RenderFrameLimits.{index_work=work[0].left},RenderDirectDomains.{},uploads,draw_words[i*4..<i*4+4],one[..],indices);
    if check.status!=RenderFrameStatus.ok {result.status=ifx check.status==RenderFrameStatus.index_budget then RenderGeometryStatus.work_budget else RenderGeometryStatus.bad_draw;result.bad_draw=i;result.work=work[0].used+check.checked_indices;return result;}
    work[0].used+=check.checked_indices;work[0].left-=check.checked_indices;
  }
  for i:0..<c.draw_count {domains[i]=local[i];}
  result.status=RenderGeometryStatus.ok;result.work=work[0].used;return result;
}
