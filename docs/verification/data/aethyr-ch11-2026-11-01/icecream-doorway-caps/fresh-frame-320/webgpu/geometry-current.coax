// Command/fetch domains derived from the renderer's declared encodings and
// initialized typed payloads. The caller admits source spans before borrowing
// these views; no GPU effects or output writes occur on refusal.
#module "aethyr.render.geometry";
#load "catalog.coax";
#load "frame.coax";
#authority;

RENDER_GEOMETRY_DRAWS :: 4096;
RENDER_GEOMETRY_WORK :: 16777216;
RenderGeometryBuffer :: struct { binding_set:int; resource:int; words:[]u32; }
RenderGeometryStatus :: enum u8 { ok; bad_profile; bad_counts; bad_uniforms; bad_resources; bad_draw; capacity; work_budget; }
RenderGeometryResult :: struct {
  status:RenderGeometryStatus=RenderGeometryStatus.bad_profile;
  bad_draw:int=-1; bad_resource:int=-1; work:int; direct:RenderDirectDomains;
}

#test "render geometry derives stored vertex records and object rows rather than trusting counts" {
  u:[256]f32;v:[24]u32;o:[32]u32;rg_local_lights:[8]u32;rg_hud_payload:[32]f32;
  b:=[3]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=1,words=v[..]},RenderGeometryBuffer.{resource=2,words=o[..]},RenderGeometryBuffer.{resource=3,words=rg_local_lights[..]}];
  rg_local_words:=[4]u32.[0,2,0x80000000,2];indices:[1]u32;domains:[1]RenderDrawDomain;
  c:=FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=1};
  q:=render_geometry_admit(0,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.ok && q.direct.hud_vertices==2;
  #assert domains[0].vertices==2 && domains[0].instances==2 && domains[0].indices==0;
}
#test "render geometry ground and object partitions have distinct vertex domains" {
  u:[328]f32;u[32]=1;h:[4]u32;o:[16]u32;o[15]=f32_bits(1.0f32);rg_hud_payload:[16]f32;indices:[1]u32;
  b:=[2]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=1,words=h[..]},RenderGeometryBuffer.{resource=2,words=o[..]}];
  rg_local_words:=[8]u32.[0,6,0x80000000,1,0,36,0x80000001,1];domains:[2]RenderDrawDomain;
  c:=FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=2};
  q:=render_geometry_admit(16,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.ok && domains[0].vertices==6 && domains[0].instance_begin==0 && domains[0].instances==1;
  #assert domains[1].vertices==36 && domains[1].instance_begin==1 && domains[1].instances==2;
}
#test "render geometry refuses a bad second record without publishing the first" {
  u:[328]f32;u[32]=1;h:[4]u32;o:[16]u32;rg_hud_payload:[16]f32;indices:[1]u32;
  b:=[2]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=1,words=h[..]},RenderGeometryBuffer.{resource=2,words=o[..]}];
  rg_local_words:=[8]u32.[0,6,0x80000000,1,0,36,0x80000040,1];domains:[2]RenderDrawDomain;domains[0].vertices=99;domains[1].vertices=77;
  c:=FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=2};
  q:=render_geometry_admit(16,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.bad_draw && q.bad_draw==1 && domains[0].vertices==99 && domains[1].vertices==77;
}
#test "render geometry retains the sparse Myrealm round vertex interval" {
  u:[452]f32;v:[24]u32;o:[16]u32;rg_hud_payload:[16]f32;indices:[1]u32;
  b:=[2]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=1,words=v[..]},RenderGeometryBuffer.{resource=2,words=o[..]}];
  rg_local_words:=[4]u32.[16777216,504,0x80000000,1];domains:[1]RenderDrawDomain;
  c:=FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=1};
  q:=render_geometry_admit(10,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.ok && domains[0].vertices==2 && domains[0].vertex_alt_begin==16777216 && domains[0].vertex_alt_end==16777720;
  rg_local_words[0]=2;rg_local_words[1]=1;
  q=render_geometry_admit(10,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.bad_draw;
}
#test "render geometry decodes Icecream terrain chunks and object outline prefixes" {
  u:[764]f32;v:[12240]u32;o:[24]u32;rg_hud_payload:[16]f32;indices:[1]u32;o[20]=f32_bits(1.0f32);
  b:=[2]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=1,words=v[..]},RenderGeometryBuffer.{resource=2,words=o[..]}];
  rg_local_words:=[8]u32.[0,1020,0x80000000,2,0,1020,0x80c00000,1];domains:[2]RenderDrawDomain;
  c:=FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=2};
  q:=render_geometry_admit(12,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.ok && domains[0].vertices==1020 && domains[0].instances==2;
  #assert domains[1].instance_begin==12582912 && domains[1].instances==12582913;
  rg_local_words[6]=0x80c00400;
  q=render_geometry_admit(12,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.bad_draw;
}
#test "render geometry checks every packed skin joint against the initialized pose" {
  u:[2300]f32;u[32]=1;h:[4]u32;v:[8]u32;o:[16]u32;o[15]=f32_bits(6.0f32);p:[12]u32;rg_hud_payload:[16]f32;indices:[1]u32;
  b:=[4]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=1,words=v[..]},RenderGeometryBuffer.{resource=2,words=h[..]},RenderGeometryBuffer.{resource=3,words=o[..]},RenderGeometryBuffer.{resource=4,words=p[..]}];
  rg_local_words:=[4]u32.[0,1,0x80000001,1];domains:[1]RenderDrawDomain;c:=FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=1};
  good:=render_geometry_admit(2,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert good.status==RenderGeometryStatus.ok && domains[0].vertices==1;
  v[6]=1;domains[0].vertices=99;
  bad:=render_geometry_admit(2,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert bad.status==RenderGeometryStatus.bad_resources && domains[0].vertices==99;
}
#test "render geometry rectangular Fairy ground includes both additional path planes" {
  u:[796]f32;u[32]=1;u[238]=2;u[239]=6;h:[18]u32;rg_hud_payload:[16]f32;indices:[1]u32;
  b:=[1]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=1,words=h[..]}];
  rg_local_words:=[4]u32.[0,6,0x80000000,2];domains:[1]RenderDrawDomain;c:=FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=1};
  q:=render_geometry_admit(3,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.ok && domains[0].instances==2;
  b[0].words=h[0..<17];q=render_geometry_admit(3,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.bad_resources;
}
#test "render geometry derives river grid vertices and all Everglade water piece classes" {
  u:[2300]f32;u[32]=1;u[1072]=2;u[1073]=2;u[1074]=2;u[1075]=3;u[1076]=1;u[1077]=1;
  h:[4]u32;nodes:[32]u32;rg_hud_payload:[16]f32;indices:[1]u32;
  b:=[2]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=2,words=h[..]},RenderGeometryBuffer.{resource=5,words=nodes[..]}];
  rg_local_words:=[4]u32.[0,36,0x80000000,1];domains:[1]RenderDrawDomain;c:=FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=1,water_draws=1};
  q:=render_geometry_admit(2,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.ok && domains[0].vertices==36 && domains[0].instances==77;
  b[1].words=nodes[0..<31];q=render_geometry_admit(2,c,rg_local_words[..],indices[0..<0],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.bad_resources;
}
#test "render geometry derives Waterlab clipmap and uniform-only fixture direct capacities" {
  u:[15748]f32;u[44]=32;u[45]=2;u[50]=0.5;u[54]=1;
  rg_hud_payload:[32]f32;none:[]u32;buffers:[]RenderGeometryBuffer;domains:[]RenderDrawDomain;
  c:=FrameCounts.{width=1,height=1,vertex_stride=16,surface_vertices=10752};
  q:=render_geometry_admit(8,c,none,none,u[..],buffers,rg_hud_payload[..],domains,64);
  #assert q.status==RenderGeometryStatus.ok && q.direct.surface_vertices==10752 && q.direct.hud_vertices==2;
  u[44]=63;q=render_geometry_admit(8,c,none,none,u[..],buffers,rg_hud_payload[..],domains,64);
  #assert q.status==RenderGeometryStatus.bad_uniforms;
  u[244]=1;u[245]=1;c.surface_vertices=0;c.grass_instances=1;
  q=render_geometry_admit(7,c,none,none,u[0..<284],buffers,rg_hud_payload[..],domains,64);
  #assert q.status==RenderGeometryStatus.ok && q.direct.grass_instances==4 && q.direct.caster_vertices==1872 && q.direct.caster_instances==8;
}
#forall "render geometry accepts empty frames for all catalog profiles" profile:0..<18 {
  meta:=render_catalog(profile);u:[15748]f32;rg_hud_payload:[32]f32;rg_local_words:[]u32;buffers:[]RenderGeometryBuffer;domains:[]RenderDrawDomain;
  q:=render_geometry_admit(profile,FrameCounts.{width=1,height=1,vertex_stride=meta.vertex_stride},rg_local_words,rg_local_words,u[..],buffers,rg_hud_payload[..],domains,1);
  #assert q.status==RenderGeometryStatus.ok && q.direct.hud_vertices==u64(32/meta.vertex_stride);
}
#forall "render geometry procedural shape limits follow each realm's actual encoding" realm:0..<4, kind:0..<8 {
  profiles:=[4]int.[16,13,3,2];
  limits:=[4][8]u64.[[8]u64.[96,36,960,192,96,96,96,96],[8]u64.[48,36,240,96,48,240,48,48],[8]u64.[96,36,960,192,96,96,96,96],[8]u64.[96,36,960,192,96,2,3,1008]];
  u:[2300]f32;u[32]=1;u[168]=1;u[238]=1;u[239]=4;h:[12]u32;o:[16]u32;o[15]=f32_bits(f32(kind));v:[24]u32;p:[12]u32;rg_hud_payload:[16]f32;indices:[]u32;
  b:[4]RenderGeometryBuffer;b[0]=RenderGeometryBuffer.{resource=1,words=h[..]};b[1]=RenderGeometryBuffer.{resource=2,words=o[..]};nb:=2;
  if realm==3 {nb=4;b[0]=RenderGeometryBuffer.{resource=1,words=v[..]};b[1]=RenderGeometryBuffer.{resource=2,words=h[..]};b[2]=RenderGeometryBuffer.{resource=3,words=o[..]};b[3]=RenderGeometryBuffer.{resource=4,words=p[..]};}
  rg_local_words:=[4]u32.[0,1,0x80000001,1];domains:[1]RenderDrawDomain;
  q:=render_geometry_admit(profiles[realm],FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=1},rg_local_words[..],indices,u[..],b[0..<nb],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.ok && domains[0].vertices==limits[realm][kind];
}
#test "render geometry indexed domains retain initialized index length and actual index values" {
  u:[172]f32;v:[24]u32;o:[16]u32;rg_hud_payload:[16]f32;
  b:=[2]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=1,words=v[..]},RenderGeometryBuffer.{resource=2,words=o[..]}];
  rg_local_words:=[4]u32.[0,1,0,1];indices:=[1]u32.[1];domains:[1]RenderDrawDomain;c:=FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=1};
  q:=render_geometry_admit(9,c,rg_local_words[..],indices[..],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.ok && domains[0].indices==1;
  indices[0]=2;domains[0].vertices=99;q=render_geometry_admit(9,c,rg_local_words[..],indices[..],u[..],b[..],rg_hud_payload[..],domains[..],64);
  #assert q.status==RenderGeometryStatus.bad_draw && domains[0].vertices==99;
}
#test "render geometry refuses a water tail on a nonwater profile" {
  u:[256]f32;rg_local_words:=[4]u32.[0,1,0x80000000,1];indices:[]u32;buffers:[]RenderGeometryBuffer;rg_hud_payload:[]f32;domains:[1]RenderDrawDomain;
  q:=render_geometry_admit(0,FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=1,water_draws=1},rg_local_words[..],indices,u[..],buffers,rg_hud_payload,domains[..],64);
  #assert q.status==RenderGeometryStatus.bad_counts;
}
#test "render geometry skips empty commands before looking at unused ground metadata" {
  u:[328]f32;rg_local_words:=[4]u32.[4294967295,0,4294967295,1];indices:[]u32;buffers:[]RenderGeometryBuffer;rg_hud_payload:[]f32;domains:[1]RenderDrawDomain;domains[0].vertices=99;
  q:=render_geometry_admit(16,FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=1},rg_local_words[..],indices,u[..],buffers,rg_hud_payload,domains[..],1);
  #assert q.status==RenderGeometryStatus.ok && q.work==0 && domains[0].vertices==0;
}
#forall "render geometry integer cap primitive includes adjacent values zero and ties" a:0..<5, b:0..<5 {
  expected:=[5][5]u64.[[5]u64.[0,0,0,0,0],[5]u64.[0,1,1,1,1],[5]u64.[0,1,2,2,2],[5]u64.[0,1,2,3,3],[5]u64.[0,1,2,3,4]];
  #assert rg_min(u64(a),u64(b))==expected[a][b];
}
#test "render geometry budget and numeric metadata distinguish every refusal boundary" {
  w:=[1]RGWork.[RGWork.{left=1}];#assert rg_take(w[..]) && w[0].left==0 && w[0].used==1;
  #assert !rg_take(w[..]) && w[0].left==0 && w[0].used==1;
  #assert rg_integer(0,0)==0 && rg_integer(1,1)==1 && rg_integer(1,0)==-1;
  #assert rg_integer(-1,1)==-1 && rg_integer(0.5,1)==-1 && rg_integer(65536,65535)==-1;
  zero:=0.0f32;nan:=zero/zero;infinity:=1.0f32/zero;
  #assert rg_integer(nan,1)==-1 && rg_integer(infinity,1)==-1;
  #assert rg_code(-1)==-1 && rg_code(nan)==-1 && rg_code(4294967296.0f32)==-1 && rg_code(0.5)==0 && rg_code(3.75)==3;
}
#forall "render geometry validates catalog resources and borrowed view record strides" variant:0..<5 {
  data:[17]u32;b:=[2]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=2,words=data[0..<16]},RenderGeometryBuffer.{resource=3,words=data[0..<8]}];
  if variant==0 {b[0].resource=-1;}if variant==1 {b[0].binding_set=2;}if variant==2 {b[0].words=data[..];}if variant==3 {b[1]=b[0];}if variant==4 {b[0].resource=4;}
  #assert rg_buffers(0,b[..])>=0;
}
#test "render geometry exact buffer table outer capacity precedes invalid resource contents" {
  b:[49]RenderGeometryBuffer;
  #assert rg_buffers(0,b[..])==-2 && rg_buffers(0,b[0..<48])==0;
  #assert rg_payload(0,0,"missing",b[0..<0]).count==0;
}
#forall "render geometry preflight refusals leave a caller's domains intact" variant:0..<11 {
  u:[328]f32;rg_local_words:[4]u32;indices:[]u32;buffers:[]RenderGeometryBuffer;rg_hud_payload:[]f32;domains:[1]RenderDrawDomain;domains[0].vertices=99;
  profile:=16;c:=FrameCounts.{width=1,height=1,vertex_stride=16};budget:=64;uc:=328;wc:=4;dc:=1;
  if variant==0 {profile=-1;}if variant==1 {c.draw_count=-1;}if variant==2 {c.draw_count=4097;}
  if variant==3 {c.draw_count=1;dc=0;}if variant==4 {c.draw_count=1;wc=3;}if variant==5 {c.vertex_stride=12;}
  if variant==6 {c.water_draws=-1;}if variant==7 {c.water_draws=1;}if variant==8 {budget=0;}if variant==9 {budget=16777217;}if variant==10 {uc=327;}
  q:=render_geometry_admit(profile,c,rg_local_words[0..<wc],indices,u[0..<uc],buffers,rg_hud_payload,domains[0..<dc],budget);
  #assert q.status!=RenderGeometryStatus.ok && domains[0].vertices==99;
}
#test "render geometry admits exact empty command and work capacities without amplification" {
  u:[328]f32;rg_local_words:[16384]u32;indices:[]u32;buffers:[]RenderGeometryBuffer;rg_hud_payload:[]f32;domains:[4096]RenderDrawDomain;
  q:=render_geometry_admit(16,FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=4096},rg_local_words[..],indices,u[..],buffers,rg_hud_payload,domains[..],16777216);
  #assert q.status==RenderGeometryStatus.ok && q.work==0;
}
#test "render geometry generic particle instances expand sixty four slots per initialized emitter" {
  u:[496]f32;puffs:[96]u32;rg_hud_payload:[16]f32;rg_local_words:[]u32;domains:[]RenderDrawDomain;
  b:=[1]RenderGeometryBuffer.[RenderGeometryBuffer.{binding_set=1,resource=1,words=puffs[..]}];
  c:=FrameCounts.{width=1,height=1,vertex_stride=16,particle_instances=384};
  q:=render_geometry_admit(13,c,rg_local_words,rg_local_words,u[..],b[..],rg_hud_payload[..],domains,64);
  #assert q.status==RenderGeometryStatus.ok && q.direct.particle_instances==384;
  uploads:[]RenderUpload;c.particle_instances=385;
  #assert render_frame_admit(c,RenderFrameLimits.{},q.direct,uploads,rg_local_words,domains,rg_local_words).status==RenderFrameStatus.bad_direct;
}
#forall "render geometry Icecream prefixes chunks partial tails and metadata bounds are exact" variant:0..<16 {
  v:[12246]u32;o:[48]u32;o[44]=f32_bits(1.0f32);
  rg_local_starts:=[16]u32.[0,1,2,3,8388608,8389632,8389633,8389634,12583936,16777216,8388608,8388608,8388608,8390656,8388608,0];
  statuses:=[16]RenderGeometryStatus.[RenderGeometryStatus.ok,RenderGeometryStatus.ok,RenderGeometryStatus.ok,RenderGeometryStatus.bad_draw,RenderGeometryStatus.ok,RenderGeometryStatus.ok,RenderGeometryStatus.ok,RenderGeometryStatus.bad_draw,RenderGeometryStatus.ok,RenderGeometryStatus.bad_draw,RenderGeometryStatus.bad_resources,RenderGeometryStatus.bad_resources,RenderGeometryStatus.bad_draw,RenderGeometryStatus.bad_draw,RenderGeometryStatus.ok,RenderGeometryStatus.bad_draw];
  begins:=[16]u64.[0,0,0,0,8388608,8389632,8389632,0,12583936,0,0,0,0,0,8388608,0];
  ends:=[16]u64.[3,3,3,0,8388611,8389634,8389634,0,12583938,0,0,0,0,0,8388609,0];
  caps:=[16]u64.[1020,1,1,0,1020,1020,1,0,1020,0,0,0,0,0,1,0];
  d:=RenderDecodedDraw.{kind=RenderDrawKind.nonindexed,base_instance=rg_local_starts[variant],instances=1};
  if variant==1 {d.instances=2;}if variant==15 {d.instances=4;}
  if variant==10 {o[20]=f32_bits(-1.0f32);}if variant==11 {o[20]=f32_bits(3.0f32);}if variant==14 {o[20]=f32_bits(2.0f32);}
  g:=RGContext.{vertices=v[..],objects=o[..]};if variant==12 {g.vertices=v[0..<0];}
  r:=rg_icecream(g,d);#assert r.status==statuses[variant];
  if r.status==RenderGeometryStatus.ok {#assert r.domain.vertices==caps[variant] && r.domain.instance_begin==begins[variant] && r.domain.instances==ends[variant];}
}
#test "render geometry person packed offsets pose blocks and threshold equality are observable" {
  v:[31]u32;o:[32]u32;p:[796]u32;
  o[28]=f32_bits(7.0f32);o[29]=f32_bits(1.0f32);o[30]=f32_bits(2.0f32);
  v[17]=0x40020100;v[23]=0x00020140;
  g:=RGContext.{vertices=v[..],objects=o[..],pose=p[..]};w:=[1]RGWork.[RGWork.{left=2}];
  d:=RenderDecodedDraw.{kind=RenderDrawKind.nonindexed,first=1,count=2,instances=1};
  r:=rg_skin(g,d,1,w[..]);#assert r.status==RenderGeometryStatus.ok && r.domain.vertices==4 && w[0].used==2 && w[0].left==0;
  g.pose=p[0..<792];w[0]=RGWork.{left=2};#assert rg_skin(g,d,1,w[..]).status==RenderGeometryStatus.bad_resources;
  g.pose=p[..];o[29]=0;w[0]=RGWork.{left=2};#assert rg_skin(g,d,1,w[..]).status==RenderGeometryStatus.ok;
  o[30]=f32_bits(1.5f32);g.pose=p[0..<12];w[0]=RGWork.{left=1};d.first=0;d.count=1;
  #assert rg_skin(g,d,1,w[..]).status==RenderGeometryStatus.ok;
}
#forall "render geometry checks all four joint bytes even when weights are zero" rg_local_person:0..<2, byte:0..<4 {
  v:[8]u32;o:[16]u32;p:[792]u32;
  o[14]=f32_bits(f32(rg_local_person*2));slot:=ifx rg_local_person==1 then 4 else 6;
  v[slot]=u32(ifx rg_local_person==1 then 65 else 1)<<u32(8*byte);
  g:=RGContext.{vertices=v[..],objects=o[..],pose=p[..]};if rg_local_person==0 {g.pose=p[0..<12];}
  w:=[1]RGWork.[RGWork.{left=1}];d:=RenderDecodedDraw.{kind=RenderDrawKind.nonindexed,count=1,instances=1};
  #assert rg_skin(g,d,0,w[..]).status==RenderGeometryStatus.bad_resources;
}
#test "render geometry skin refusals distinguish malformed metadata out of bounds fetch and work" {
  v:[16]u32;o:[16]u32;p:[792]u32;g:=RGContext.{vertices=v[..],objects=o[..],pose=p[..]};
  d:=RenderDecodedDraw.{kind=RenderDrawKind.nonindexed,count=1,instances=1};w:=[1]RGWork.[RGWork.{left=1}];
  o[12]=f32_bits(-1.0f32);#assert rg_skin(g,d,0,w[..]).status==RenderGeometryStatus.bad_resources;
  o[12]=0;o[14]=f32_bits(3.0f32);#assert rg_skin(g,d,0,w[..]).status==RenderGeometryStatus.bad_resources;
  o[14]=f32_bits(2.0f32);o[13]=f32_bits(-1.0f32);#assert rg_skin(g,d,0,w[..]).status==RenderGeometryStatus.bad_resources;
  o[13]=0;w[0]=RGWork.{};#assert rg_skin(g,d,0,w[..]).status==RenderGeometryStatus.work_budget;
  w[0]=RGWork.{left=1};d.first=3;#assert rg_skin(g,d,0,w[..]).status==RenderGeometryStatus.bad_draw;
}
