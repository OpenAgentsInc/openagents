  r=render_geometry_admit(16,c,rg_local_words[..],none,u[..],b[..],rg_hud_payload,out[..],1);#assert r.status==RenderGeometryStatus.capacity && r.bad_resource==-2;
  r=render_geometry_admit(16,c,rg_local_words[..],none,u[0..<327],b[0..<0],rg_hud_payload,out[..],1);#assert r.status==RenderGeometryStatus.bad_uniforms;
