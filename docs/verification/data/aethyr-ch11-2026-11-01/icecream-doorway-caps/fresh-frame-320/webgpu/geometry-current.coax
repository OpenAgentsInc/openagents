#test "render geometry index work is paid once per checked word and refusal is atomic" {
  u:[172]f32;v:[24]u32;o:[16]u32;rg_hud_payload:[16]f32;
  b:=[2]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=1,words=v[..]},RenderGeometryBuffer.{resource=2,words=o[..]}];
  rg_local_words:=[8]u32.[0,1,0,1,0,1,0,1];indices:=[2]u32.[0,1];out:[2]RenderDrawDomain;out[0].vertices=99;out[1].vertices=77;
  c:=FrameCounts.{width=1,height=1,vertex_stride=16,draw_count=2};
  r:=render_geometry_admit(9,c,rg_local_words[..],indices[..],u[..],b[..],rg_hud_payload[..],out[..],2);
  #assert r.status==RenderGeometryStatus.work_budget && r.bad_draw==1 && r.work==2 && out[0].vertices==99 && out[1].vertices==77;
  r=render_geometry_admit(9,c,rg_local_words[..],indices[..],u[..],b[..],rg_hud_payload[..],out[..],4);
  #assert r.status==RenderGeometryStatus.ok && r.work==4;
  c.draw_count=1;rg_local_words[1]=2;out[0].vertices=99;
  r=render_geometry_admit(9,c,rg_local_words[..],indices[..],u[..],b[..],rg_hud_payload[..],out[..],2);
  #assert r.status==RenderGeometryStatus.work_budget && r.bad_draw==0 && r.work==2 && out[0].vertices==99;
}
