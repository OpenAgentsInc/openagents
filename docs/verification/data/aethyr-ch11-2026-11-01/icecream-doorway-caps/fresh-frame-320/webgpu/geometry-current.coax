#forall "render geometry retains Everglade's three reserved spray slots at both river tiers" rg_spray_case:0..<8 {
  rg_per:=[8]int.[1,2,21,22,24,32,64,96];
  rg_expected:=[8]u64.[181,149,121,120,120,120,120,120];
  rg_u:[2300]f32;rg_nodes:[32]u32;
  rg_u[1072]=2;rg_u[1073]=2;rg_u[1074]=f32(rg_per[rg_spray_case]);rg_u[1075]=1;rg_u[1076]=1;rg_u[1077]=52;
  rg_q:=rg_water(RGContext.{app="everglade",u=rg_u[..],water=rg_nodes[..]});
  #assert rg_q.status==RenderGeometryStatus.ok && rg_q.domain.vertices==u64(rg_per[rg_spray_case]*6) && rg_q.domain.instances==rg_expected[rg_spray_case];
}
#test "render geometry admits the actual desktop river tail and refuses its first excess instance" {
  rg_u:[2300]f32;rg_u[32]=104;
  rg_u[1072]=13;rg_u[1073]=209;rg_u[1074]=12;rg_u[1075]=8;rg_u[1076]=4;rg_u[1077]=52;
  rg_heights:[11025]u32;rg_nodes:[21736]u32;rg_hud:[]f32;
  rg_spray_buffers:=[2]RenderGeometryBuffer.[RenderGeometryBuffer.{resource=2,words=rg_heights[..]},RenderGeometryBuffer.{resource=5,words=rg_nodes[..]}];
  // The captured draw starts at463572 in the pack's identity-index tail.
  // Rebase that identical576-word interval to zero for this bounded fixture.
  rg_words:=[4]u32.[0,576,0,120];rg_indices:[576]u32;for rg_i:0..<576 {rg_indices[rg_i]=u32(rg_i);}
  rg_domains:[1]RenderDrawDomain;rg_domains[0].vertices=999;
  rg_counts:=FrameCounts.{width=1280,height=800,vertex_stride=16,draw_count=1,water_draws=1};
  rg_q:=render_geometry_admit(2,rg_counts,rg_words[..],rg_indices[..],rg_u[..],rg_spray_buffers[..],rg_hud,rg_domains[..],2048);
  #assert rg_q.status==RenderGeometryStatus.ok && rg_domains[0].vertices==576 && rg_domains[0].instances==120;
  rg_domains[0].vertices=999;rg_words[3]=121;
  rg_q=render_geometry_admit(2,rg_counts,rg_words[..],rg_indices[..],rg_u[..],rg_spray_buffers[..],rg_hud,rg_domains[..],2048);
  #assert rg_q.status==RenderGeometryStatus.bad_draw && rg_q.bad_draw==0 && rg_domains[0].vertices==999;
  rg_words[3]=120;rg_indices[575]=576;
  rg_q=render_geometry_admit(2,rg_counts,rg_words[..],rg_indices[..],rg_u[..],rg_spray_buffers[..],rg_hud,rg_domains[..],2048);
  #assert rg_q.status==RenderGeometryStatus.bad_draw && rg_domains[0].vertices==999;
  rg_indices[575]=575;rg_spray_buffers[1].words=rg_nodes[0..<21735];
  rg_q=render_geometry_admit(2,rg_counts,rg_words[..],rg_indices[..],rg_u[..],rg_spray_buffers[..],rg_hud,rg_domains[..],2048);
  #assert rg_q.status==RenderGeometryStatus.bad_resources && rg_domains[0].vertices==999;
}
#test "render geometry water dimensions preserve exact and fractional piece counts" {
