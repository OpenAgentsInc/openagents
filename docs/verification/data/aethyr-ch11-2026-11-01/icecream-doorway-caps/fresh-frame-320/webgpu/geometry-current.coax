  u[1074]=8;u[1075]=8;r=rg_water(g);#assert r.status==RenderGeometryStatus.ok && r.domain.vertices==384 && r.domain.instances==68;
  u[1077]=65535;r=rg_water(g);#assert r.status==RenderGeometryStatus.ok && r.domain.instances==65603;
  g.app="fairy";u[780]=2;u[781]=3;u[782]=1;u[783]=2;u[784]=1;
  r=rg_water(g);#assert r.status==RenderGeometryStatus.ok && r.domain.instances==2 && r.domain.vertices==12;
  u[784]=1.5;r=rg_water(g);#assert r.status==RenderGeometryStatus.ok && r.domain.instances==2;
  u[784]=0.0009765625;r=rg_water(g);#assert r.status==RenderGeometryStatus.ok && r.domain.instances==2048;
  g.water=nodes[0..<47];#assert rg_water(g).status==RenderGeometryStatus.bad_resources;
}
