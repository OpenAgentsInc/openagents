// Shared media text and rectangle policy. Platforms retain the input text,
// decode/upload images and execute the admitted rectangle; Coax owns the
// first112-line window, record selection, numeric decoding and aspect fit.
#module "aethyr.render.media.commands";
#import "Basic";
#load "media-limits.coax";
#authority;
RENDER_MEDIA_TEXT_BYTES :: 65536;
RENDER_MEDIA_IMAGE_SIDE :: 2048;
RenderMediaKind :: enum u8 {invalid;image;video;}
RenderMediaStatus :: enum u8 {ok;capacity;}
RenderMediaRequest :: struct {kind:RenderMediaKind;url:string;over:bool;line:int=-1;box:[4]f64;}
RenderMediaParse :: struct {status:RenderMediaStatus;count:int;lines:int;truncated:bool;}
RenderMediaRect :: struct {ok:bool;draw:bool;line:int=-1;over:bool;uniforms:[8]f32;}
RenderMediaExtent :: struct {ok:bool;width:int;height:int;}
RenderMediaNumber :: struct {ok:bool;value:f64;}
#load "tests/media-commands-checks.coax";

rmc_finite :: (x:f64)->bool {return x>=-1.7976931348623157e308 && x<=1.7976931348623157e308;}
// Both candidates are positive. Select their bits from the difference's sign
// rather than subtracting nearly equal large values to recover a small ratio.
rmc_lower_positive :: (a:f64,b:f64)->f64 {
  mask:=cast,trunc(u64)(-cast(int)(f64_bits(a-b)>>63));
  return f64_from_bits(f64_bits(b)^((f64_bits(a)^f64_bits(b))&mask));
}
rmc_space :: (c:int)->bool {return c==32 || (c>=9 && c<=13);}
rmc_digit :: (c:int)->int {
  if c>='0' && c<='9' {return c-'0';}
  if c>='a' && c<='f' {return c-'a'+10;}
  if c>='A' && c<='F' {return c-'A'+10;}
  return -1;
}
// The parser's mantissa is zero or at least1. Apply negative powers in
// bounded finite pieces, then admit only a finite final value.
rmc_scale_decimal :: (mantissa:f64,exponent:f64)->RenderMediaNumber {
  value:=mantissa;power:=exponent;
  if power!=power {return RenderMediaNumber.{};}
  if value!=0 {
    if power>308 {return RenderMediaNumber.{};}
    while power<0 && value!=0 {
      step:=rmc_lower_positive(-power,308);value*=pow(10.0,-step);power+=step;
    }
    if value!=0 {
      scale10:=pow(10.0,power);
      value*=scale10;
    }
  }
  return RenderMediaNumber.{ok=rmc_finite(value),value=value};
}
// The producer writes whole device pixels. Decimal fractions/exponents and
// prefixed integer columns are also decoded here, without a host number parser.
rmc_number :: (text:string)->RenderMediaNumber {
  a:=0;b:=text.count;
  while a<b && rmc_space(cast(int)text[a]) {a+=1;}
  while b>a && rmc_space(cast(int)text[b-1]) {b-=1;}
  if a==b {return RenderMediaNumber.{ok=true};}
  negative:=false;signed:=false;
  if text[a]=='-' || text[a]=='+' {negative=text[a]=='-';signed=true;a+=1;}
  if a==b {return RenderMediaNumber.{};}
  value:f64=0;
  prefix:int;
  if text[a]=='0' {
    if a+1==b {return RenderMediaNumber.{ok=true,value=ifx negative then -value else value};}
    prefix=cast(int)text[a+1];
  }
  if prefix=='x' || prefix=='X' || prefix=='b' || prefix=='B' || prefix=='o' || prefix=='O' {
    if signed {return RenderMediaNumber.{};}
    base:=16;if prefix=='b' || prefix=='B' {base=2;}if prefix=='o' || prefix=='O' {base=8;}
    a+=2;if a==b {return RenderMediaNumber.{};}
    while a<b {digit:=rmc_digit(cast(int)text[a]);if digit<0 || digit>=base {return RenderMediaNumber.{};}value=value*f64(base)+f64(digit);a+=1;}
  }else{
    has_digit:=false;fraction:=0;bias:=0;dot:=false;
    while a<b {
      c:=text[a];
      if c=='.' && !dot {dot=true;a+=1;continue;}
      if c<'0' || c>'9' {break;}
      value=value*10+f64(c-'0');has_digit=true;if dot {fraction+=1;}
      // Keep a long mantissa finite until its explicit decimal scale is known.
      if (f64_bits(value)>>56)==127 {value*=1e-100;bias+=100;}
      a+=1;
    }
    if !has_digit {return RenderMediaNumber.{};}
    exponent:f64=0;
    if a<b && (text[a]=='e' || text[a]=='E') {
      a+=1;minus:=false;
      if a<b && (text[a]=='+' || text[a]=='-') {minus=text[a]=='-';a+=1;}
      start:=a;
      while a<b && text[a]>='0' && text[a]<='9' {exponent=exponent*10+f64(text[a]-'0');a+=1;}
      if a==start {return RenderMediaNumber.{};}if minus {exponent= -exponent;}
    }
    if a!=b {return RenderMediaNumber.{};}
    scaled:=rmc_scale_decimal(value,exponent+f64(bias)-f64(fraction));
    if !scaled.ok {return scaled;}value=scaled.value;
  }
  if negative {value= -value;}
  return RenderMediaNumber.{ok=rmc_finite(value),value=value};
}
rmc_line :: (text:string,line:int)->RenderMediaRequest {
  columns:[6]string;at:=0;
  for i:0..<6 {
    begin:=at;while at<text.count && text[at]!=' ' {at+=1;}columns[i]=text[begin..<at];
    if i<5 {if at==text.count {return RenderMediaRequest.{};}at+=1;}
    else if at!=text.count {return RenderMediaRequest.{};}
  }
  kind:=RenderMediaKind.invalid;over:=false;
  if columns[0]=="image" {kind=RenderMediaKind.image;}
  if columns[0]=="video" {kind=RenderMediaKind.video;}
  if columns[0]=="over" {kind=RenderMediaKind.image;over=true;}
  url:=columns[1];
  if kind==RenderMediaKind.invalid || url.count==0 || url[0]!='/' {return RenderMediaRequest.{};}
  if url.count>1 && url[1]=='/' {return RenderMediaRequest.{};}
  request:=RenderMediaRequest.{kind=kind,url=url,over=over,line=line};
  for i:0..<4 {number:=rmc_number(columns[i+2]);if !number.ok {return RenderMediaRequest.{};}request.box[i]=number.value;}
  return request;
}
rmc_parse_pass :: (text:string,out:[]RenderMediaRequest,store:bool)->RenderMediaParse {
  r:RenderMediaParse;at:=0;
  for line:0..<RENDER_MEDIA_ITEMS {
    end:=at;while end<text.count && text[end]!=10 {end+=1;}
    request:=rmc_line(text[at..<end],line);r.lines=line+1;
    if request.kind!=RenderMediaKind.invalid {if store {out[r.count]=request;}r.count+=1;}
    if end==text.count {return r;}at=end+1;
  }
  r.truncated=true;return r;
}
render_media_parse :: (text:string,out:[]RenderMediaRequest)->RenderMediaParse {
  if text.count>RENDER_MEDIA_TEXT_BYTES {return RenderMediaParse.{status=RenderMediaStatus.capacity};}
  counted:=rmc_parse_pass(text,out,false);
  if counted.count>out.count {counted.status=RenderMediaStatus.capacity;counted.count=0;return counted;}
  return rmc_parse_pass(text,out,true);
}
render_media_rect :: (request:RenderMediaRequest,width:int,height:int,image_width:int,image_height:int)->RenderMediaRect {
  if (request.kind!=RenderMediaKind.image && request.kind!=RenderMediaKind.video) || request.line<0 || request.line>=RENDER_MEDIA_ITEMS || width<1 || height<1 {return RenderMediaRect.{};}
  bw:=request.box[2]-request.box[0];bh:=request.box[3]-request.box[1];
  if !rmc_finite(bw) || !rmc_finite(bh) {return RenderMediaRect.{};}
  r:=RenderMediaRect.{ok=true,line=request.line,over=request.over};
  if image_width==0 && image_height==0 {return r;}
  if image_width<1 || image_height<1 {return RenderMediaRect.{};}
  if bw<=1 || bh<=1 {return r;}
  scale:=rmc_lower_positive(bw/f64(image_width),bh/f64(image_height));dw:=f64(image_width)*scale;dh:=f64(image_height)*scale;
  cx:=request.box[0]+(bw-dw)/2;cy:=request.box[1]+(bh-dh)/2;
  values:=[4]f64.[cx/f64(width)*2-1,1-cy/f64(height)*2,(cx+dw)/f64(width)*2-1,1-(cy+dh)/f64(height)*2];
  for i:0..<4 {if !rmc_finite(values[i]) || abs(values[i])>3.4028234663852886e38 {return RenderMediaRect.{};}}
  for i:0..<4 {r.uniforms[i]=cast(f32)values[i];}r.uniforms[4]=1;r.draw=true;return r;
}
render_media_image_extent :: (kind:RenderMediaKind,width:int,height:int)->RenderMediaExtent {
  if (kind!=RenderMediaKind.image && kind!=RenderMediaKind.video) || width<1 || height<1 {return RenderMediaExtent.{};}
  if kind==RenderMediaKind.video {return RenderMediaExtent.{ok=true,width=width,height=height};}
  scale:=rmc_lower_positive(rmc_lower_positive(1.0,f64(RENDER_MEDIA_IMAGE_SIDE)/f64(width)),f64(RENDER_MEDIA_IMAGE_SIDE)/f64(height));
  w:=cast(int)floor(f64(width)*scale+0.5);h:=cast(int)floor(f64(height)*scale+0.5);
  return RenderMediaExtent.{ok=true,width=ifx w==0 then 1 else w,height=ifx h==0 then 1 else h};
}
