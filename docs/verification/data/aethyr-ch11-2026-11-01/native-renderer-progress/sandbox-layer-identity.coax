#load "../asset-profile.coax";
#test "actual immutable Haunt texture observations also match all canonical Sandbox layer sources" {
 a:=render_asset_find(0,RenderAssetKind.layers,0);b:=render_asset_find(11,RenderAssetKind.layers,0);
 #assert a.valid && b.valid && !a.packed && !b.packed && a.url_count==12 && b.url_count==12;
 for i:0..<12 {#assert render_asset_url(0,a.row,i)==render_asset_url(11,b.row,i);}
}
