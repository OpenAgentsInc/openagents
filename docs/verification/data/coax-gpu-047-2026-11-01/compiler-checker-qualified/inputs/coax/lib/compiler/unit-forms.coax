// Canonical nominal unit products. No physical metadata or compiler effects.
#authority;
UF_Form :: struct {count:int;atoms:[8]int;powers:[8]int;}
UF_Status :: enum u8 {ok;metadata;power;capacity;}
UF_Result :: struct {status:UF_Status;form:UF_Form;}

#test "unit one and atom retain canonical identity without merging nominal tags" {
  one:=UF_one();#assert UF_valid(one) && one.count==0 && UF_equal(one,one);
  for i:0..<8 {#assert one.atoms[i]==0 && one.powers[i]==0;}
  for id:[5]int.[1,2,65536,1048576,2147483647] {r:=UF_atom(id);#assert r.status==UF_Status.ok && UF_valid(r.form) && r.form.count==1 && r.form.atoms[0]==id && r.form.powers[0]==1;
    for i:1..<8 {#assert r.form.atoms[i]==0 && r.form.powers[i]==0;}
    #assert !UF_equal(one,r.form) && !UF_equal(r.form,one);}
  a:=UF_atom(1).form;b:=UF_atom(2).form;r:=UF_product(a,b);
  #assert r.status==UF_Status.ok && r.form.count==2 && r.form.atoms[0]==1 && r.form.atoms[1]==2 && r.form.powers[0]==1 && r.form.powers[1]==1;
}
#test "atom identifiers admit both boundaries and refuse zero negative and oversized IDs" {
  for id:[5]int.[0,-1,2147483648,-9223372036854775808,9223372036854775807] {r:=UF_atom(id);#assert r.status==UF_Status.metadata && r.form.count==0;
    for i:0..<8 {#assert r.form.atoms[i]==0 && r.form.powers[i]==0;}}
}
#forall "canonical form admission checks every active and inactive lane" lane:0..<8,mode:0..<9 {
  a:UF_Form;a.count=8;for i:0..<8 {a.atoms[i]=(i+1)*10;a.powers[i]=1;}#assert UF_valid(a);
  if mode==0 {a.atoms[lane]=0;}if mode==1 {a.atoms[lane]=2147483648;}
  if mode==2 {a.powers[lane]=0;}if mode==3 {a.powers[lane]=2147483648;}if mode==4 {a.powers[lane]= -2147483648;}
  if mode==5 {a.atoms[lane]= -9223372036854775808;}
  if mode==6 {a.powers[lane]=9223372036854775807;}
  if mode==7 {a=UF_one();a.atoms[lane]=1;}if mode==8 {a=UF_one();a.powers[lane]=1;}
  #assert !UF_valid(a) && !UF_equal(a,a) && !UF_equal(a,UF_one()) && !UF_equal(UF_one(),a);
  results:=[4]UF_Result.[UF_product(a,UF_one()),UF_product(UF_one(),a),UF_quotient(a,UF_one()),UF_quotient(UF_one(),a)];
  for r:results {#assert r.status==UF_Status.metadata && r.form.count==0;for i:0..<8 {#assert r.form.atoms[i]==0 && r.form.powers[i]==0;}}
}
#test "counts sorting and duplicate active atoms are admitted before merge" {
  for count:[5]int.[-1,9,-9223372036854775808,9223372036854775807,2147483647] {a:=UF_one();a.count=count;#assert !UF_valid(a);}
  a:=UF_atom(2).form;a.count=2;a.atoms[1]=2;a.powers[1]=1;#assert !UF_valid(a);a.atoms[1]=1;#assert !UF_valid(a);
  a.atoms[1]=3;#assert UF_valid(a);a.count=1;#assert !UF_valid(a);
}
#forall "symmetric exponent boundaries and first overflow have explicit status" sign:0..<2,division:0..<2 {
  a:=UF_atom(7).form;b:=a;direction:=1;if sign==1 {direction= -1;}
  a.powers[0]=direction*2147483646;b.powers[0]=direction;if division==1 {b.powers[0]= -b.powers[0];}
  r:=UF_product(a,b);if division==1 {r=UF_quotient(a,b);}
  #assert r.status==UF_Status.ok && r.form.count==1 && r.form.atoms[0]==7 && r.form.powers[0]==direction*2147483647;
  a.powers[0]=direction*2147483647;#assert UF_valid(a);
  r=UF_product(a,b);if division==1 {r=UF_quotient(a,b);}
  #assert r.status==UF_Status.power && r.form.count==0;for i:0..<8 {#assert r.form.atoms[i]==0 && r.form.powers[i]==0;}
  r=UF_product(a,UF_one());#assert r.status==UF_Status.ok && UF_equal(r.form,a);
}
#test "sorted merge handles both operand tails equal atoms and division signs" {
  a:UF_Form;a.count=3;a.atoms[0]=1;a.atoms[1]=4;a.atoms[2]=9;a.powers[0]=2;a.powers[1]= -3;a.powers[2]=5;
  b:UF_Form;b.count=3;b.atoms[0]=2;b.atoms[1]=4;b.atoms[2]=10;b.powers[0]= -4;b.powers[1]=3;b.powers[2]= -6;
  p:=UF_product(a,b);q:=UF_quotient(a,b);#assert p.status==UF_Status.ok && p.form.count==4 && q.status==UF_Status.ok && q.form.count==5;
  ids:=[4]int.[1,2,9,10];powers:=[4]int.[2,-4,5,-6];
  for i:0..<4 {#assert p.form.atoms[i]==ids[i] && p.form.powers[i]==powers[i];}
  qids:=[5]int.[1,2,4,9,10];qpowers:=[5]int.[2,4,-6,5,6];for i:0..<5 {#assert q.form.atoms[i]==qids[i] && q.form.powers[i]==qpowers[i];}
  for i:4..<8 {#assert p.form.atoms[i]==0 && p.form.powers[i]==0;}for i:5..<8 {#assert q.form.atoms[i]==0 && q.form.powers[i]==0;}
  #assert UF_equal(p.form,UF_product(b,a).form);
  #assert UF_equal(UF_product(a,UF_one()).form,a) && UF_equal(UF_product(UF_one(),a).form,a);
  #assert UF_equal(UF_quotient(a,UF_one()).form,a) && UF_equal(UF_quotient(a,a).form,UF_one());
}
#test "all matching factors cancel before the eight atom capacity is enforced" {
  a:UF_Form;a.count=8;b:UF_Form;b.count=8;
  for i:0..<8 {a.atoms[i]=i+1;a.powers[i]=1;b.atoms[i]=i+1;b.powers[i]= -1;}
  p:=UF_product(a,b);#assert p.status==UF_Status.ok && UF_equal(p.form,UF_one());
  q:=UF_quotient(a,a);#assert q.status==UF_Status.ok && UF_equal(q.form,UF_one());
  b.atoms[7]=9;p=UF_product(a,b);#assert p.status==UF_Status.ok && p.form.count==2 && p.form.atoms[0]==8 && p.form.atoms[1]==9 && p.form.powers[0]==1 && p.form.powers[1]== -1;
  for i:2..<8 {#assert p.form.atoms[i]==0 && p.form.powers[i]==0;}
}
#test "capacity is refused only after every later power has been admitted" {
  a:UF_Form;a.count=8;b:UF_Form;b.count=8;
  for i:0..<8 {a.atoms[i]=2*i+1;a.powers[i]=1;b.atoms[i]=2*i+2;b.powers[i]=1;}
  results:=[2]UF_Result.[UF_product(a,b),UF_quotient(a,b)];for r:results {#assert r.status==UF_Status.capacity && r.form.count==0;for i:0..<8 {#assert r.form.atoms[i]==0 && r.form.powers[i]==0;}}
  b.atoms[7]=15;a.powers[7]=2147483647;r:=UF_product(a,b);#assert r.status==UF_Status.power && r.form.count==0;
  b.powers[7]= -1;r=UF_quotient(a,b);#assert r.status==UF_Status.power && r.form.count==0;
  b.count=9;r=UF_quotient(a,b);#assert r.status==UF_Status.metadata && r.form.count==0;
}
#test "eight final atoms are admitted and the ninth is refused" {
  a:UF_Form;a.count=8;for i:0..<8 {a.atoms[i]=i+1;a.powers[i]=1;}
  results:=[3]UF_Result.[UF_product(a,UF_one()),UF_product(UF_one(),a),UF_quotient(a,UF_one())];
  for r:results {#assert r.status==UF_Status.ok && r.form.count==8 && UF_equal(r.form,a);}
  r:=UF_product(a,UF_atom(9).form);#assert r.status==UF_Status.capacity && r.form.count==0;
  for i:0..<8 {#assert r.form.atoms[i]==0 && r.form.powers[i]==0;}
}
#forall "exact equality inspects every atom and power rather than a fingerprint" lane:0..<8 {
  a:UF_Form;a.count=8;for i:0..<8 {a.atoms[i]=(i+1)*65536;a.powers[i]=i+1;}b:=a;#assert UF_equal(a,b);
  b.atoms[lane]+=1;#assert !UF_equal(a,b) && !UF_equal(b,a);b=a;b.powers[lane]= -b.powers[lane];#assert !UF_equal(a,b) && !UF_equal(b,a);
}

// Product implementation follows the independent contract checks.
UF_valid :: (form:UF_Form)->bool #export_c {
  if form.count<0 || form.count>8 {return false;}previous:=0;
  for i:0..<8 {
    if i<form.count {
      if form.atoms[i]<=previous || form.atoms[i]>2147483647 || form.powers[i]==0 || form.powers[i]< -2147483647 || form.powers[i]>2147483647 {return false;}
      previous=form.atoms[i];
    }else if form.atoms[i]!=0 || form.powers[i]!=0 {return false;}
  }
  return true;
}
UF_one :: ()->UF_Form #export_c {return UF_Form.{};}
UF_atom :: (atom:int)->UF_Result #export_c {
  form:=UF_Form.{count=1};form.atoms[0]=atom;form.powers[0]=1;
  if !UF_valid(form) {return UF_Result.{status=UF_Status.metadata};}
  return UF_Result.{form=form};
}
UF_equal :: (a:UF_Form,b:UF_Form)->bool #export_c {
  if !UF_valid(a) || !UF_valid(b) {return false;}if a.count!=b.count {return false;}
  for i:0..<a.count {if a.atoms[i]!=b.atoms[i] || a.powers[i]!=b.powers[i] {return false;}}
  return true;
}
UF_merge :: (a:UF_Form,b:UF_Form,division:bool)->UF_Result {
  if !UF_valid(a) || !UF_valid(b) {return UF_Result.{status=UF_Status.metadata};}
  i:=0;j:=0;count:=0;staged:UF_Form;
  while i<a.count || j<b.count {
    atom:int;power:int;
    if j==b.count || (i<a.count && a.atoms[i]<b.atoms[j]) {atom=a.atoms[i];power=a.powers[i];i+=1;}
    else if i==a.count || b.atoms[j]<a.atoms[i] {atom=b.atoms[j];power=b.powers[j];if division {power= -power;}j+=1;}
    else {atom=a.atoms[i];power=b.powers[j];if division {power= -power;}power+=a.powers[i];i+=1;j+=1;}
    if power< -2147483647 || power>2147483647 {return UF_Result.{status=UF_Status.power};}
    if power!=0 {if count<8 {staged.atoms[count]=atom;staged.powers[count]=power;}count+=1;}
  }
  if count>8 {return UF_Result.{status=UF_Status.capacity};}
  staged.count=count;return UF_Result.{form=staged};
}
UF_product :: (a:UF_Form,b:UF_Form)->UF_Result #export_c {return UF_merge(a,b,false);}
UF_quotient :: (a:UF_Form,b:UF_Form)->UF_Result #export_c {return UF_merge(a,b,true);}
