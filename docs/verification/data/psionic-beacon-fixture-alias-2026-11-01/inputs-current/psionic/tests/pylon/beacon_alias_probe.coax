// Test-only native/CT probe. The product reader and writer are unchanged.
#load "../../lib/pylon/beacon.coax";

PylonBeaconAliasProbe :: struct {
    before_code:int;borrowed_code:int;stable_code:int;
    borrowed_count:int;stable_count:int;borrowed_tail:int;stable_tail:int;
}
pylon_beacon_alias_probe :: ()->PylonBeaconAliasProbe #export_c {
    scratch:[512]u8;stable_tags:[512]u8;
    borrowed := pb_tags_for(scratch[..],PB_CONTENT,"1791400300","");
    stable := pb_tags_for(stable_tags[..],PB_CONTENT,"1791400300","");
    before := pb_read(PB_KIND,PB_KEY,borrowed,PB_CONTENT,PB_Y).code;
    // This appends a duplicate expiration tag, replacing the old outer ']'
    // with ',' inside the original borrowed view's unchanged length.
    rewritten := pb_tags_for(scratch[..],PB_CONTENT,"1791400300",",[\"expiration\",\"1\"]");
    after := pb_read(PB_KIND,PB_KEY,borrowed,PB_CONTENT,PB_Y).code;
    held := pb_read(PB_KIND,PB_KEY,stable,PB_CONTENT,PB_Y).code;
    return PylonBeaconAliasProbe.{before_code=cast(int)before,borrowed_code=cast(int)after,
        stable_code=cast(int)held,borrowed_count=borrowed.count,stable_count=stable.count,
        borrowed_tail=cast(int)borrowed[borrowed.count-1],stable_tail=cast(int)stable[stable.count-1]};
}
