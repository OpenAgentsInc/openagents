// Actual-Wasm oracle for the frozen take-two layout; reuses the resident
// muted recording page. The named offsets are from its emitted .drive table.
#load "../../../../coax/web/resident.coax";
tool_main :: ()->int #export_c #effects(all) {
 c:[1]Cdp;r:[1]Rs;if !rs_open(c[..],r[..]) || !rs_kept(c[..],r[..]) {print("No resident recording\n");return 1;}
 v:=cdp_evaluate(c[..],"(async()=>{const fail=m=>{throw Error(m)},hex=(p,n)=>coaxial.drive.peek(p,n),bytes=(p,n)=>Uint8Array.from(hex(p,n).match(/../g),s=>parseInt(s,16)),f=p=>new DataView(bytes(p,4).buffer).getFloat32(0,true),key=k=>{if(!document.querySelector('.coax-view-menu dialog').open)document.querySelector('[aria-label=\"Viewer menu\"]').click();document.querySelector('[data-key=\"'+k+'\"]').click();};if(coaxial.drive.stateSize()!==80536||!coaxial.sceneReady||coaxial.drawStats().draws!==70||hex(80529,1)!=='01'||f(74848)!==18)fail('Recording did not complete');const endCamera=[f(36),f(40),f(44)],distance=f(74836);for(let i=0;i<14;i++){const p=1624+136+i*184,q=f(48480+i*4);if(q<f(p+168)||q>f(p+172))fail('Joint outside source limits');}if(distance<0.2)fail('Walk did not translate');key(4002);await coaxialClipStep(750,60);if(f(48624)!==0||f(74848)>=10)fail('No restored stand');for(let i=0;i<14;i++)if(hex(48480+i*4,4)!==hex(1624+136+i*184+176,4))fail('Stand word differs');const standTime=f(74848),standCamera=hex(36,12);coaxial.send(601,'');await coaxialClipStep(60,60);if(f(74848)!==standTime||hex(36,12)!==standCamera)fail('Hidden camera advanced');coaxial.send(602,'');await coaxialClipStep(1,60);if(f(74848)!==standTime)fail('Resume caught up');key(4000);if(hex(80529,1)!=='00')fail('Original take unavailable');return JSON.stringify({actualWasm:true,renderedParts:70,takeTwoCompleted:true,allJointLimits:true,walkDistance:distance,endCamera,exactRestoredStand:true,hiddenClockHeld:true,resumeSkippedDelta:true,originalTakeRetained:true});})()");
 ok:=v>=0 && jv_kind(c[0].doc[0],v)==JV_STRING;out:[8192]u8;n:=ifx ok then jv_str(c[0].doc[0],v,out[..]) else -1;
 if n>=0 {print("%\n",cast(string)out[0..<n]);}else {print("%\n",cdp_doc(c[..]).text);}
 rs_release(c[..],r[..],true);return ifx n>=0 then 0 else 1;
}
