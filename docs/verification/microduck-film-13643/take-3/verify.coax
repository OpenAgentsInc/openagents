// Actual-Wasm oracle for the frozen take-three layout. Uses the shared,
// muted recording page; offsets come from its emitted .drive table.
#load "../../../../coax/web/resident.coax";
tool_main :: ()->int #export_c #effects(all) {
 c:[1]Cdp;r:[1]Rs;if !rs_open(c[..],r[..]) || !rs_kept(c[..],r[..]) {print("No resident recording\n");return 1;}
 v:=cdp_evaluate(c[..],"(async()=>{const fail=m=>{throw Error(m)},hex=(p,n)=>coaxial.drive.peek(p,n),bytes=(p,n)=>Uint8Array.from(hex(p,n).match(/../g),s=>parseInt(s,16)),f=p=>new DataView(bytes(p,4).buffer).getFloat32(0,true),u=p=>new DataView(bytes(p,4).buffer).getUint32(0,true),key=k=>{if(!document.querySelector('.coax-view-menu dialog').open)document.querySelector('[aria-label=\"Viewer menu\"]').click();document.querySelector('[data-key=\"'+k+'\"]').click();};if(coaxial.drive.stateSize()!==80552||!coaxial.sceneReady||hex(80530,1)!=='01'||f(74848)<24.9||f(74848)>25)fail('Parade recording did not complete');const camera=[f(36),f(40),f(44)],distance=f(74836),copies=u(80536),centre=f(80544),reveal=f(80548);if(copies!==11||Math.abs(centre+1.7)>1e-6||reveal!==1||Math.abs(camera[2]-4.8)>1e-6)fail('Wide reveal incomplete');const draws=coaxial.drawStats();if(draws.draws!==70||draws.indices!==26294466)fail('Missing rendered instances');for(let i=0;i<70;i++){if(u(84+i*16+8)!==i*16||u(84+i*16+12)!==11)fail('Part or copy identity differs');}for(let i=0;i<14;i++){const p=1624+136+i*184,q=f(48480+i*4);if(q<f(p+168)||q>f(p+172))fail('Joint outside source limits');}if(distance<0.4)fail('Walk did not translate');const held=hex(36,12)+hex(74836,16)+hex(80536,16);coaxial.send(601,'');await coaxialClipStep(10,10);if(hex(36,12)+hex(74836,16)+hex(80536,16)!==held)fail('Hidden parade advanced');coaxial.send(602,'');await coaxialClipStep(1,60);if(hex(36,12)+hex(74836,16)+hex(80536,16)!==held)fail('Resume caught up');key(4003);await coaxialClipStep(125,10);if(f(48624)!==0||f(74848)>=10||u(80536)!==1)fail('No single restored stand');for(let i=0;i<14;i++)if(hex(48480+i*4,4)!==hex(1624+136+i*184+176,4))fail('Stand word differs');key(4002);await coaxialClipStep(1,60);if(hex(80529,1)!=='01'||hex(80530,1)!=='00'||u(80536)!==1)fail('Take two unavailable');key(4000);await coaxialClipStep(1,60);if(hex(80529,1)!=='00'||hex(80530,1)!=='00'||u(80536)!==1)fail('Original take unavailable');key(114);await coaxialClipStep(1,60);if(hex(74720,1)!=='00'||coaxial.drawStats().indices!==2390406)fail('Reset did not restore one model');return JSON.stringify({actualWasm:true,renderedParts:70,renderedCopies:copies,renderedIndices:draws.indices,takeThreeCompleted:true,allJointLimits:true,walkDistance:distance,endCamera:camera,centre,reveal,partCopyIdentity:true,exactRestoredStand:true,hiddenClockHeld:true,resumeSkippedDelta:true,previousTakesRetained:true,resetRestoresSingleModel:true});})()");
 ok:=v>=0 && jv_kind(c[0].doc[0],v)==JV_STRING;out:[8192]u8;n:=ifx ok then jv_str(c[0].doc[0],v,out[..]) else -1;
 if n>=0 {print("%\n",cast(string)out[0..<n]);}else {print("%\n",cdp_doc(c[..]).text);}
 rs_release(c[..],r[..],true);return ifx n>=0 then 0 else 1;
}
