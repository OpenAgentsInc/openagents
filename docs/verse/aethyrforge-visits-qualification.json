  "scope": {
    "invitation": "One saved personal-world playable version; opaque link; sign-in-required or anonymous play, with signed-in chat only; 1 hour, 1 day, or 7 day expiry; host revocation; no editor/project membership.",
    "chat": "Bounded Loro document in existing coder-sync row storage, not a second session transport. Native website authenticates each request and writes participant identity. Its signed 30-second room token never reaches the browser and cannot open other rooms/devices/checkpoints.",
    "bounds": "32 invitations per world; 64 participants per invitation; 512 messages; 1000 UTF-8 bytes per message; 12 new messages per minute/person.",
    "controls": "Per-viewer visibility, mute and hidden-person preferences; leave/rejoin; message reports marked for the host; unchanged rows retain focus; stale/account-changed/disposed requests cannot update a later view.",
    "rights": "Private compiled kit/runtime resources remain outside public Git. Quaternius CC0 and OpenAgents original-art distribution terms remain separate."
  },
