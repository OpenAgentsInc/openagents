  "captions": [
    {
      "text": "What if anyone could create a world of their own?",
      "at": 1.07,
      "dur": 2.63,
      "vo": true
    },
    {
      "text": "Imagine it. Describe it.",
      "at": 8.54,
      "dur": 2.02,
      "vo": true
    },
    {
      "text": "Build it with AI—from wherever you are.",
      "at": 10.64,
      "dur": 2.504,
      "vo": true
    },
    {
      "text": "From a shared universe to worlds limited only by your imagination.",
      "at": 20.61,
      "dur": 4.255,
      "vo": true
    },
    {
      "text": "Create games. Build experiences.",
      "at": 32.65,
      "dur": 2.81,
      "vo": true
    },
    {
      "text": "Bring your ideas to life for others to explore.",
      "at": 35.54,
      "dur": 2.858,
      "vo": true
    },
    {
      "text": "Share what you create. Find your audience.",
      "at": 46.04,
      "dur": 2.746,
      "vo": true
    },
    {
      "text": "Earn from your worlds.",
      "at": 52.54,
      "dur": 1.52,
      "vo": true
    },
    {
      "text": "The Verse.",
      "at": 66.34,
      "dur": 1.32,
      "vo": true
    },
    {
      "text": "Your imagination is the starting point.",
      "at": 67.74,
      "dur": 2.275,
