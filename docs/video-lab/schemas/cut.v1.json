{
  "$id": "https://openagents.com/schemas/video-lab/cut.v1.json",
  "title": "cut.v1: a film's edit, the cut list scripts/film/cut.py reads",
  "type": "object",
  "required": ["fps", "size", "shots", "out"],
  "additionalProperties": false,
  "properties": {
    "timeline": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "music_at": {"type": "number", "minimum": 0},
        "links": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "size": {"type": "array", "items": {"type": "integer", "minimum": 16}, "minItems": 2, "maxItems": 2},
    "bpm": {"type": "number", "exclusiveMinimum": 0},
    "music": {"type": "string"},
    "music_gain": {"type": "number", "minimum": 0},
    "music_duck": {"type": "number", "minimum": 0, "maximum": 1, "description": "The music's level under a shot that keeps its own sound (default 0.2)."},
    "out": {"type": "string"},
    "sheets": {"type": "string"},
    "cache": {"type": "string"},
    "fade_in": {"type": "number", "minimum": 0},
    "fade_out": {"type": "number", "minimum": 0},
    "voice": {
      "type": "object", "required": ["src"], "additionalProperties": false,
      "properties": {"src": {"type": "string"}, "at": {"type": "number", "minimum": 0}, "gain": {"type": "number", "minimum": 0}}
    },
    "voices": {
      "description": "Voiceover clips placed by Video Lab's lab_voice, each from its time at its own length, with the music ducked under it.",
      "type": "array",
      "items": {"type": "object", "required": ["src", "at"], "additionalProperties": false,
                "properties": {"src": {"type": "string"}, "at": {"type": "number", "minimum": 0}, "gain": {"type": "number", "minimum": 0}}}
    },
    "caption_style": {
      "type": "object", "additionalProperties": false,
      "properties": {"size": {"type": "number", "exclusiveMinimum": 0}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}}
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["text", "at", "dur"], "additionalProperties": false,
        "properties": {"text": {"type": "string"}, "at": {"type": "number", "minimum": 0}, "dur": {"type": "number", "exclusiveMinimum": 0}, "shot": {"type": "string", "description": "Made from this shot's own speech (lab_splice, lab_captions)."}, "vo": {"type": "boolean", "description": "A voiceover line not yet recorded, shown at a speaking pace (lab_lines)."}}
      }
    },
    "score": {
      "description": "Video Lab: the music is made by scripts/film/music.py to the cut's length, with a whoosh at the start of each named shot and the end chord from end_at's start. Remade when the cut's length changes.",
      "type": "object", "required": ["cuts_at"], "additionalProperties": false,
      "properties": {"cuts_at": {"type": "array", "items": {"type": "string"}}, "end_at": {"type": "string"}}
    },
    "shots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shot"}}
  },
  "$defs": {
    "shot": {
      "type": "object",
      "required": ["name", "dur"],
      "anyOf": [{"required": ["src"]}, {"required": ["title"]}],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "src": {"type": "string"},
        "in": {"type": "number", "minimum": 0},
        "dur": {"type": "number", "exclusiveMinimum": 0},
        "xfade": {"type": "number", "minimum": 0},
        "xfade_kind": {"type": "string"},
        "play": {"type": "number", "minimum": 0},
        "push": {"type": "number", "minimum": 0, "maximum": 0.3},
        "speed": {"type": "number", "exclusiveMinimum": 0},
        "dark_ok": {"type": "boolean"},
        "hold_ok": {"type": "number", "minimum": 0},
        "still_ok": {"type": "number", "minimum": 0, "description": "Allow this many seconds of intentional stillness, such as reading a live chat; otherwise the limit is 0.4 seconds."},
        "label": {"type": "string"},
        "fit": {"type": "string", "enum": ["pad", "blur", "crop"], "description": "A clip of another shape: whole on black, whole over a blurred copy of itself, or cropped to fill."},
        "focus": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2, "description": "With fit crop: the part kept, x and y from 0 to 1."},
        "sound": {"type": "object", "additionalProperties": false, "description": "Keep the clip's own sound (speech), with the music ducked under it. Its cuts must fall in pauses.", "properties": {"gain": {"type": "number", "minimum": 0}}},
        "over": {
          "type": "object", "required": ["src"], "additionalProperties": false,
          "properties": {"src": {"type": "string"}, "at": {"type": "number", "minimum": 0}}
        },
        "title": {
          "type": "object", "required": ["lines"],
          "properties": {
            "lines": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["text", "size"]}},
            "under": {"type": "object", "required": ["src"]}
          }
        }
      }
    }
  }
}
