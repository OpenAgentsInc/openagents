{
  "id": "k09_email_regex",
  "category": "bench_python",
  "fixture": "emails",
  "description": "Fix an email-extracting regex",
  "budget_usd_micros": 100000,
  "timeout_s": 300,
  "steps": [
    {
      "send": "emails() in extract.py misses real addresses and test_extract.py fails. Fix the regex without changing the tests."
    }
  ],
  "graders": [
    {
      "type": "not_timed_out"
    },
    {
      "type": "ended"
    },
    {
      "type": "command",
      "run": "python3 -m unittest -q",
      "restore": [
        "test_extract.py"
      ]
    },
    {
      "type": "files_unchanged",
      "paths": [
        "test_*.py"
      ]
    },
    {
      "type": "outside_unchanged"
    },
    {
      "type": "no_guard_trips"
    }
  ]
}
