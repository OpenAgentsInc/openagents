// Prints the long-horizon compaction scenarios' numbers (scenarios.coax), one line each, for
// evals/openagents-desktop/compaction/run.sh and docs/coder/compaction-theory.md. No model is called.
// The scenarios load the worker's transports, whose process natives tool.sh links: with `coax run`
// gcc at -O0 keeps their unused callers and the link fails on Linux (GitHub #13734).
//   coax/web/tool.sh evals/openagents-desktop/compaction/report.coax
#import "Basic";
#load "scenarios.coax";

CS_REPORT_STEPS :: 200;

tool_main :: () -> int #export_c #effects(all) {
  z: [1] CsBufs;
  windows := CS_WINDOWS;
  for w: windows {
    for kind: 0..<CS_KINDS {
      r := cs_run_window(z[..], kind, CS_REPORT_STEPS, w);
      print("window % scenario % steps % compactions % evictions % left_out % earlier % actions % earlier_cap % request_max % max_prompt % avg_prompt % cache_shared_permille % overs % breaks % gaps % invalid % memory_kept %\n",
        w, cs_name(kind), r.steps, r.compactions, r.evictions, r.left_out, r.nearly, r.nacts, r.earlier_cap, r.request_max, r.max_prompt, r.prompt_bytes / r.steps, cs_shared_permille(r), r.overs, r.breaks, r.gaps, r.invalid, r.memory_kept);
    }
  }
  return 0;
}
