{
  "name": "21_subagent_cc_five_parallel_explore_bg",
  "description": "5 parallel read-only Explore subagents with wait_all:true plus 1 run_in_background subagent (#14096)",
  "workers": {
    "main": {
      "turns": [
        {
          "steps": [
            {
              "emit": {
                "kind": "delegate",
                "wait_all": true,
                "ticket": 1,
                "tasks": [
                  {"level": "neon", "subagent_type": "Explore", "description": "Inspect 1", "agent_id": "aexp-0000000000000001", "read_only": true, "omit_claudemd": true, "task": "Read part 1"},
                  {"level": "neon", "subagent_type": "Explore", "description": "Inspect 2", "agent_id": "aexp-0000000000000002", "read_only": true, "omit_claudemd": true, "task": "Read part 2"},
                  {"level": "neon", "subagent_type": "Explore", "description": "Inspect 3", "agent_id": "aexp-0000000000000003", "read_only": true, "omit_claudemd": true, "task": "Read part 3"},
                  {"level": "neon", "subagent_type": "Explore", "description": "Inspect 4", "agent_id": "aexp-0000000000000004", "read_only": true, "omit_claudemd": true, "task": "Read part 4"},
                  {"level": "neon", "subagent_type": "Explore", "description": "Inspect 5", "agent_id": "aexp-0000000000000005", "read_only": true, "omit_claudemd": true, "task": "Read part 5"}
                ]
              }
            },
            {"expect": "results"},
            {"emit": {"kind": "reply", "text": "Synthesized all 5 parallel read-only Explore subagents."}},
            {"emit": {"kind": "ended", "ending": "finished", "text": "Synthesized all 5 parallel read-only Explore subagents."}}
          ]
        }
      ]
    },
    "sub": {
      "turns": [
        {
          "steps": [
            {"emit": {"kind": "view", "path": "README.md", "found": true}},
            {"emit": {"kind": "ended", "ending": "finished", "text": "Explore finding ok"}}
          ]
        }
      ]
    }
  },
  "commands": [
    {"cmd": "OPEN 0 0 {resources}", "expect": {"ok": true}},
    {"cmd": "SPAWN_WORKER 0 {script:main} {record:main}", "expect": {"ok": true}},
    {"cmd": "SET_AGENT_SCRIPT 0 -1 {script:sub}", "expect": {"ok": true}},
    {"cmd": "SET_TEXT 0 delegate to 5 subagents very simple readonly tasks and summarize at the end", "expect": {"ok": true}},
    {"cmd": "SUBMIT 0", "expect": {"ok": true}},
    {"cmd": "PUMP 0 8000 1", "expect": {"ok": true, "running": 0, "agents_running": 0, "lines_from_agents": 10, "max_vertices_seen_lte": 200000}},
    {"cmd": "QUIT", "expect": {"ok": true}}
  ],
  "assert_records": {
    "main": {
      "count_by_kind": {"task": 1, "results": 1},
      "contains": ["Explore finding ok", "aexp-0000000000000005"]
    }
  }
}
