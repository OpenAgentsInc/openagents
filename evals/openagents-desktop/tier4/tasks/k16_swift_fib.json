{
  "id": "k16_swift_fib",
  "category": "bench_swift",
  "fixture": "swiftfib",
  "description": "Fix a Swift function's base case",
  "budget_usd_micros": 100000,
  "timeout_s": 300,
  "steps": [
    {
      "send": "`make test` fails: fib in Fib.swift returns the wrong value for small n. Fix Fib.swift without changing main.swift or the Makefile."
    }
  ],
  "graders": [
    {
      "type": "not_timed_out"
    },
    {
      "type": "ended"
    },
    {
      "type": "command",
      "run": "make test",
      "restore": [
        "main.swift",
        "Makefile"
      ],
      "timeout_s": 180
    },
    {
      "type": "files_unchanged",
      "paths": [
        "main.swift",
        "Makefile"
      ]
    },
    {
      "type": "outside_unchanged"
    },
    {
      "type": "no_guard_trips"
    }
  ]
}
