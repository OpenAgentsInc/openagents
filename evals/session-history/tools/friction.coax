// Read-only Transcript Friction Hillclimb Scorecard (pure Coax).
// Measures real friction KPIs across local Antigravity transcripts,
// OpenAgents Desktop persisted chats, AJR1 sessions, and daemon host state.
//
// Usage:
//   coax/web/tool.sh evals/session-history/tools/friction.coax [--limit N] [--json] [--out PATH] [--home DIR]
//   evals/session-history/run.sh friction [--limit N] [--json] [--out PATH]
//   coax/bin/coax test evals/session-history/tools/friction.coax --library
#import "Basic";
#load "../../../coax/lib/json/json.coax";
#load "../../../coax/lib/agent/observe/antigravity.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/clock.coax";
#load "../../../coax/lib/sys/proc.coax";

FR_MAX_FILES :: 4096;
FR_LINE_MAX :: 262144;
FR_READ_CHUNK :: 65536;
FR_COAX_SLOTS :: 64;

FrFile :: struct {
  path: [1024] u8; path_n: int;
  mtime: int;
  size: int;
}

FrReader :: struct {
  path: [1024] u8; path_n: int;
  file_size: int;
  offset: int;
  chunk: [FR_READ_CHUNK] u8;
  chunk_n: int;
  chunk_at: int;
  eof: bool;
}

FrictionStats :: struct {
  // Antigravity transcripts
  agy_sessions: int;
  agy_user_turns: int;
  agy_model_steps: int;
  agy_empty_model_turns: int;
  agy_tool_calls: int;
  agy_cmd_runs: int;
  agy_cmd_failures: int;
  agy_manage_task_polls: int;
  agy_sleep_polls: int;
  agy_ask_questions: int;
  agy_truncated_outputs: int;
  agy_compactions: int;
  agy_prepush_rejections: int;
  agy_rework_turns: int;
  agy_verify_nudges: int;
  coax_err_total: int;
  coax_err_codes: [FR_COAX_SLOTS] int;
  coax_err_counts: [FR_COAX_SLOTS] int;
  coax_err_n: int;

  // OpenAgents Desktop UI chats (Coder/chats/*.json)
  desk_chats: int;
  desk_turns: int;
  desk_turns_done: int;
  desk_turns_stopped: int;
  desk_turns_failed: int;
  desk_turns_running: int;
  desk_empty_with_note: int;
  desk_empty_silent: int;
  desk_cmds_total: int;
  desk_cmds_failed: int;
  desk_steers: int;
  desk_cost_micros: int;
  desk_rework_turns: int;
  desk_verify_nudges: int;

  // OpenAgents runtime hygiene
  ajr_total: int;
  ajr_zero_bytes: int;
  run_stops_lines: int;
  host_runs_running: int;
}

// ---- Pure string & text helpers

fr_copy :: (dst: [] u8, src: string) -> int {
  n := ifx src.count < dst.count then src.count else dst.count;
  for i: 0..<n { dst[i] = src[i]; }
  return n;
}

fr_ends_with :: (s: string, suf: string) -> bool {
  return s.count >= suf.count && s[s.count - suf.count..<s.count] == suf;
}

fr_lower :: (c: u8) -> u8 {
  return ifx c >= 'A' && c <= 'Z' then cast(u8) (c + 32) else c;
}

fr_has_ci :: (hay: string, needle: string) -> bool {
  if needle.count == 0 { return true; }
  if hay.count < needle.count { return false; }
  limit := hay.count - needle.count + 1;
  n0 := fr_lower(needle[0]);
  for i: 0..<limit {
    if fr_lower(hay[i]) != n0 { continue; }
    ok := true;
    for j: 1..<needle.count {
      if fr_lower(hay[i + j]) != fr_lower(needle[j]) { ok = false; break; }
    }
    if ok { return true; }
  }
  return false;
}

fr_has_nonzero_exit :: (s: string) -> bool {
  if agr_has(s, "Encountered error") || agr_has(s, "failed with exit code") { return true; }
  needle := "Command exited with code ";
  pos := 0;
  while pos + needle.count <= s.count {
    at := agr_find(s, needle, pos);
    if at < 0 { break; }
    i := at + needle.count;
    neg := false;
    if i < s.count && s[i] == '-' { neg = true; i += 1; }
    if i < s.count && s[i] >= '0' && s[i] <= '9' {
      v := 0;
      while i < s.count && s[i] >= '0' && s[i] <= '9' {
        v = v * 10 + cast(int) (s[i] - '0');
        i += 1;
      }
      if neg || v != 0 { return true; }
    }
    pos = at + needle.count;
  }
  return false;
}

fr_is_rework_cue :: (msg: string) -> bool {
  if msg.count == 0 { return false; }
  if fr_has_ci(msg, "still broken") || fr_has_ci(msg, "still fail") || fr_has_ci(msg, "still doesn") || fr_has_ci(msg, "still not ") { return true; }
  if fr_has_ci(msg, "doesn't work") || fr_has_ci(msg, "doesnt work") || fr_has_ci(msg, "didn't work") || fr_has_ci(msg, "didnt work") || fr_has_ci(msg, "not working") { return true; }
  if fr_has_ci(msg, "that's wrong") || fr_has_ci(msg, "thats wrong") || fr_has_ci(msg, "you broke") || fr_has_ci(msg, "why did you") { return true; }
  if fr_has_ci(msg, "revert ") || fr_has_ci(msg, "undo ") || fr_has_ci(msg, "instead of ") { return true; }
  // Short direct negation turns ("no, ...", "actually, ...", "wrong ...")
  if msg.count <= 240 {
    if fr_has_ci(msg, "no, ") || fr_has_ci(msg, "actually,") || fr_has_ci(msg, "wait, ") || fr_has_ci(msg, "wrong ") { return true; }
  }
  return false;
}

fr_is_verify_nudge :: (msg: string) -> bool {
  if msg.count == 0 { return false; }
  if fr_has_ci(msg, "did you test") || fr_has_ci(msg, "did you verify") || fr_has_ci(msg, "did you run") || fr_has_ci(msg, "did you check") { return true; }
  if fr_has_ci(msg, "did you build") || fr_has_ci(msg, "did you push") || fr_has_ci(msg, "did you commit") || fr_has_ci(msg, "did you install") { return true; }
  if fr_has_ci(msg, "please verify") || fr_has_ci(msg, "push to main") || fr_has_ci(msg, "build and install") || fr_has_ci(msg, "install it") { return true; }
  return false;
}

fr_is_sleep_poll :: (cmd: string) -> bool {
  if cmd.count < 6 { return false; }
  pos := 0;
  while pos + 6 <= cmd.count {
    at := agr_find(cmd, "sleep ", pos);
    if at < 0 { break; }
    prev_ok := at == 0 || cmd[at - 1] == ' ' || cmd[at - 1] == ';' || cmd[at - 1] == '&' || cmd[at - 1] == '|' || cmd[at - 1] == '\n' || cmd[at - 1] == '(';
    if prev_ok && at + 6 < cmd.count && cmd[at + 6] >= '0' && cmd[at + 6] <= '9' { return true; }
    pos = at + 6;
  }
  return false;
}

fr_note_coax_code :: (st: [] FrictionStats, code: int) {
  st[0].coax_err_total += 1;
  for i: 0..<st[0].coax_err_n {
    if st[0].coax_err_codes[i] == code {
      st[0].coax_err_counts[i] += 1;
      return;
    }
  }
  if st[0].coax_err_n < FR_COAX_SLOTS {
    idx := st[0].coax_err_n;
    st[0].coax_err_codes[idx] = code;
    st[0].coax_err_counts[idx] = 1;
    st[0].coax_err_n += 1;
  }
}

fr_scan_coax_errors :: (text: string, st: [] FrictionStats) {
  needle := "error[E";
  pos := 0;
  while pos + needle.count + 5 <= text.count {
    at := agr_find(text, needle, pos);
    if at < 0 { break; }
    p := at + needle.count;
    if p + 4 < text.count && text[p + 4] == ']' {
      ok := true;
      code := 0;
      for k: 0..<4 {
        c := text[p + k];
        if c < '0' || c > '9' { ok = false; break; }
        code = code * 10 + cast(int) (c - '0');
      }
      if ok { fr_note_coax_code(st, code); }
    }
    pos = at + needle.count;
  }
}

// ---- Pure transcript & chat analyzers

fr_analyze_agy_line :: (line: string, st: [] FrictionStats, ar: [] ClArena) {
  if line.count == 0 { return; }
  step := agr_step(line, ar);
  if step.kind == AGR_OTHER {
    if agr_has(line, "\"type\":\"CHECKPOINT\"") || agr_has(line, "CONTEXT_SUMMARY") { st[0].agy_compactions += 1; }
    return;
  }
  if step.kind == AGR_USER {
    if agr_has(line, "CONTEXT_SUMMARY") { st[0].agy_compactions += 1; }
    st[0].agy_user_turns += 1;
    if fr_is_rework_cue(step.text) { st[0].agy_rework_turns += 1; }
    if fr_is_verify_nudge(step.text) { st[0].agy_verify_nudges += 1; }
    return;
  }
  if step.kind == AGR_MODEL {
    st[0].agy_model_steps += 1;
    if step.tools == 0 && step.done && step.text.count == 0 {
      st[0].agy_empty_model_turns += 1;
    }
    calls := cl_raw(line, "tool_calls");
    if calls.count >= 2 && calls[0] == '[' {
      cj: [1] Json; cl_parse(cj[..], calls);
      if json_next(cj[..]) == JSON_ARRAY {
        while true {
          ct := json_next(cj[..]);
          if ct == JSON_ARRAY_END || ct == JSON_ERROR { break; }
          cv := cl_value_here(cj[..]);
          if !cv.ok { break; }
          tc := cl_json(calls, cv);
          st[0].agy_tool_calls += 1;
          ar[0].at = 0; ar[0].full = false;
          cname := cl_str(ar, tc, "name");
          args := cl_raw(tc, "args");
          if cname == "run_command" {
            st[0].agy_cmd_runs += 1;
            ar[0].at = 0; ar[0].full = false;
            cmdline := agr_unquote(cl_str(ar, args, "CommandLine"));
            if fr_is_sleep_poll(cmdline) { st[0].agy_sleep_polls += 1; }
          } else if cname == "manage_task" {
            ar[0].at = 0; ar[0].full = false;
            act := agr_unquote(cl_str(ar, args, "Action"));
            if act == "status" { st[0].agy_manage_task_polls += 1; }
          } else if cname == "ask_question" {
            st[0].agy_ask_questions += 1;
          }
        }
      }
    }
    return;
  }
  if step.kind == AGR_RESULT {
    if fr_has_nonzero_exit(step.text) { st[0].agy_cmd_failures += 1; }
    if agr_has(step.text, "output was truncated") { st[0].agy_truncated_outputs += 1; }
    if agr_has(step.text, "prepush:") && (agr_has(step.text, "REFUSED") || agr_has(step.text, "refused") || agr_has(step.text, "Agent:") || agr_has(step.text, "cannot push")) {
      st[0].agy_prepush_rejections += 1;
    }
    fr_scan_coax_errors(step.text, st);
  }
}

fr_analyze_desk_chat :: (text: string, st: [] FrictionStats, ar: [] ClArena) -> bool {
  turns_raw := cl_raw(text, "turns");
  if turns_raw.count < 2 || turns_raw[0] != '[' { return false; }
  st[0].desk_chats += 1;
  cost_r := cl_int(text, "cost_usd_micros");
  if cost_r.ok && cost_r.value > 0 { st[0].desk_cost_micros += cost_r.value; }

  tj: [1] Json; cl_parse(tj[..], turns_raw);
  if json_next(tj[..]) != JSON_ARRAY { return true; }
  while true {
    t := json_next(tj[..]);
    if t == JSON_ARRAY_END || t == JSON_ERROR { break; }
    tv := cl_value_here(tj[..]);
    if !tv.ok { break; }
    turn := cl_json(turns_raw, tv);
    st[0].desk_turns += 1;

    sr := cl_int(turn, "state");
    state := ifx sr.ok then sr.value else 0;
    if state == 1 { st[0].desk_turns_done += 1; }
    else if state == 2 { st[0].desk_turns_stopped += 1; }
    else if state == 3 { st[0].desk_turns_failed += 1; }
    else { st[0].desk_turns_running += 1; }

    ar[0].at = 0; ar[0].full = false;
    ask := cl_str(ar, turn, "ask");
    if fr_is_rework_cue(ask) { st[0].desk_rework_turns += 1; }
    if fr_is_verify_nudge(ask) { st[0].desk_verify_nudges += 1; }

    ar[0].at = 0; ar[0].full = false;
    reply := cl_str(ar, turn, "reply");
    ar[0].at = 0; ar[0].full = false;
    note := cl_str(ar, turn, "note");
    if reply.count == 0 {
      if note.count > 0 { st[0].desk_empty_with_note += 1; }
      else { st[0].desk_empty_silent += 1; }
    }

    steers_raw := cl_raw(turn, "steers");
    if steers_raw.count >= 2 && steers_raw[0] == '[' {
      sc := cl_count(steers_raw);
      if sc > 0 { st[0].desk_steers += sc; }
    }

    cmds_raw := cl_raw(turn, "cmds");
    if cmds_raw.count >= 2 && cmds_raw[0] == '[' {
      cj: [1] Json; cl_parse(cj[..], cmds_raw);
      if json_next(cj[..]) == JSON_ARRAY {
        while true {
          ct := json_next(cj[..]);
          if ct == JSON_ARRAY_END || ct == JSON_ERROR { break; }
          cv := cl_value_here(cj[..]);
          if !cv.ok { break; }
          cmd := cl_json(cmds_raw, cv);
          th_r := cl_bool(cmd, "thought");
          sd_r := cl_bool(cmd, "said");
          if (th_r.ok && th_r.value) || (sd_r.ok && sd_r.value) { continue; }
          st[0].desk_cmds_total += 1;
          fl_r := cl_bool(cmd, "failed");
          if fl_r.ok && fl_r.value { st[0].desk_cmds_failed += 1; }
        }
      }
    }
  }
  return true;
}

// ---- Formatting helpers

fr_put_str :: (out: [] u8, at: [] int, s: string) {
  n := s.count;
  if at[0] + n > out.count { n = out.count - at[0]; }
  if n <= 0 { return; }
  for i: 0..<n { out[at[0] + i] = s[i]; }
  at[0] += n;
}

fr_put_int :: (out: [] u8, at: [] int, v_in: int) {
  v := v_in;
  if v < 0 { fr_put_str(out, at, "-"); v = -v; }
  tmp: [32] u8;
  k := 0;
  if v == 0 { tmp[0] = '0'; k = 1; }
  else {
    while v > 0 && k < tmp.count {
      tmp[k] = cast(u8) ('0' + (v % 10));
      v /= 10;
      k += 1;
    }
  }
  i := k - 1;
  while i >= 0 {
    if at[0] < out.count { out[at[0]] = tmp[i]; at[0] += 1; }
    i -= 1;
  }
}

fr_put_pct :: (out: [] u8, at: [] int, num: int, den: int) {
  if den <= 0 { fr_put_str(out, at, "0.0%"); return; }
  tenths := (num * 1000 + den / 2) / den;
  fr_put_int(out, at, tenths / 10);
  fr_put_str(out, at, ".");
  fr_put_int(out, at, tenths % 10);
  fr_put_str(out, at, "%");
}

fr_put_code :: (out: [] u8, at: [] int, code: int) {
  fr_put_str(out, at, "E");
  fr_put_int(out, at, (code / 1000) % 10);
  fr_put_int(out, at, (code / 100) % 10);
  fr_put_int(out, at, (code / 10) % 10);
  fr_put_int(out, at, code % 10);
}

fr_put_usd :: (out: [] u8, at: [] int, micros: int) {
  cents := (micros + 5000) / 10000;
  fr_put_str(out, at, "$");
  fr_put_int(out, at, cents / 100);
  fr_put_str(out, at, ".");
  rem := cents % 100;
  if rem < 10 { fr_put_str(out, at, "0"); }
  fr_put_int(out, at, rem);
}

fr_sort_coax_errors :: (st: [] FrictionStats) {
  n := st[0].coax_err_n;
  for i: 1..<n {
    kc := st[0].coax_err_codes[i];
    kv := st[0].coax_err_counts[i];
    j := i - 1;
    while j >= 0 && st[0].coax_err_counts[j] < kv {
      st[0].coax_err_codes[j + 1] = st[0].coax_err_codes[j];
      st[0].coax_err_counts[j + 1] = st[0].coax_err_counts[j];
      j -= 1;
    }
    st[0].coax_err_codes[j + 1] = kc;
    st[0].coax_err_counts[j + 1] = kv;
  }
}

fr_format_markdown :: (st_in: FrictionStats, out: [] u8) -> int {
  st := [1] FrictionStats.[st_in];
  fr_sort_coax_errors(st[..]);
  at: [1] int;
  fr_put_str(out, at[..], "# Transcript Friction Hillclimb Scorecard\n\n");

  fr_put_str(out, at[..], "## Antigravity Transcripts\n\n");
  fr_put_str(out, at[..], "| Metric | Value |\n| --- | ---: |\n");
  fr_put_str(out, at[..], "| Sessions scanned | "); fr_put_int(out, at[..], st[0].agy_sessions); fr_put_str(out, at[..], " |\n");
  fr_put_str(out, at[..], "| User turns | "); fr_put_int(out, at[..], st[0].agy_user_turns); fr_put_str(out, at[..], " |\n");
  fr_put_str(out, at[..], "| Model steps / tool calls | "); fr_put_int(out, at[..], st[0].agy_model_steps); fr_put_str(out, at[..], " / "); fr_put_int(out, at[..], st[0].agy_tool_calls); fr_put_str(out, at[..], " |\n");
  fr_put_str(out, at[..], "| Rework/correction turns | "); fr_put_int(out, at[..], st[0].agy_rework_turns); fr_put_str(out, at[..], " ("); fr_put_pct(out, at[..], st[0].agy_rework_turns, st[0].agy_user_turns); fr_put_str(out, at[..], ") |\n");
  fr_put_str(out, at[..], "| Verify/ship nudge turns | "); fr_put_int(out, at[..], st[0].agy_verify_nudges); fr_put_str(out, at[..], " ("); fr_put_pct(out, at[..], st[0].agy_verify_nudges, st[0].agy_user_turns); fr_put_str(out, at[..], ") |\n");
  fr_put_str(out, at[..], "| Command runs / non-zero failures | "); fr_put_int(out, at[..], st[0].agy_cmd_runs); fr_put_str(out, at[..], " / "); fr_put_int(out, at[..], st[0].agy_cmd_failures); fr_put_str(out, at[..], " ("); fr_put_pct(out, at[..], st[0].agy_cmd_failures, st[0].agy_cmd_runs); fr_put_str(out, at[..], ") |\n");
  fr_put_str(out, at[..], "| Polling (`manage_task(status)` / `sleep`) | "); fr_put_int(out, at[..], st[0].agy_manage_task_polls); fr_put_str(out, at[..], " / "); fr_put_int(out, at[..], st[0].agy_sleep_polls); fr_put_str(out, at[..], " |\n");
  fr_put_str(out, at[..], "| `prepush` rejections | "); fr_put_int(out, at[..], st[0].agy_prepush_rejections); fr_put_str(out, at[..], " |\n");
  fr_put_str(out, at[..], "| Coax compiler `error[E0xxx]` hits | "); fr_put_int(out, at[..], st[0].coax_err_total); fr_put_str(out, at[..], " |\n");
  fr_put_str(out, at[..], "| Truncated tool outputs | "); fr_put_int(out, at[..], st[0].agy_truncated_outputs); fr_put_str(out, at[..], " |\n");
  fr_put_str(out, at[..], "| Context compactions | "); fr_put_int(out, at[..], st[0].agy_compactions); fr_put_str(out, at[..], " |\n");
  fr_put_str(out, at[..], "| Empty completed model turns | "); fr_put_int(out, at[..], st[0].agy_empty_model_turns); fr_put_str(out, at[..], " |\n");
  fr_put_str(out, at[..], "| `ask_question` prompts | "); fr_put_int(out, at[..], st[0].agy_ask_questions); fr_put_str(out, at[..], " |\n");

  if st[0].coax_err_n > 0 {
    fr_put_str(out, at[..], "\nTop Coax error codes: ");
    top := ifx st[0].coax_err_n < 8 then st[0].coax_err_n else 8;
    for i: 0..<top {
      if i > 0 { fr_put_str(out, at[..], ", "); }
      fr_put_str(out, at[..], "`");
      fr_put_code(out, at[..], st[0].coax_err_codes[i]);
      fr_put_str(out, at[..], "` (");
      fr_put_int(out, at[..], st[0].coax_err_counts[i]);
      fr_put_str(out, at[..], ")");
    }
    fr_put_str(out, at[..], "\n");
  }

  fr_put_str(out, at[..], "\n## OpenAgents Desktop Chats\n\n");
  fr_put_str(out, at[..], "| Metric | Value |\n| --- | ---: |\n");
  fr_put_str(out, at[..], "| Chats scanned | "); fr_put_int(out, at[..], st[0].desk_chats); fr_put_str(out, at[..], " |\n");
  fr_put_str(out, at[..], "| Turns (done / stopped / failed / stuck-running) | "); fr_put_int(out, at[..], st[0].desk_turns); fr_put_str(out, at[..], " (");
  fr_put_int(out, at[..], st[0].desk_turns_done); fr_put_str(out, at[..], " / ");
  fr_put_int(out, at[..], st[0].desk_turns_stopped); fr_put_str(out, at[..], " / ");
  fr_put_int(out, at[..], st[0].desk_turns_failed); fr_put_str(out, at[..], " / ");
  fr_put_int(out, at[..], st[0].desk_turns_running); fr_put_str(out, at[..], ") |\n");
  fr_put_str(out, at[..], "| Silent empty replies (no reply, no note) | "); fr_put_int(out, at[..], st[0].desk_empty_silent); fr_put_str(out, at[..], " ("); fr_put_pct(out, at[..], st[0].desk_empty_silent, st[0].desk_turns); fr_put_str(out, at[..], ") |\n");
  fr_put_str(out, at[..], "| Empty replies with explicit note | "); fr_put_int(out, at[..], st[0].desk_empty_with_note); fr_put_str(out, at[..], " ("); fr_put_pct(out, at[..], st[0].desk_empty_with_note, st[0].desk_turns); fr_put_str(out, at[..], ") |\n");
  fr_put_str(out, at[..], "| Commands total / failed | "); fr_put_int(out, at[..], st[0].desk_cmds_total); fr_put_str(out, at[..], " / "); fr_put_int(out, at[..], st[0].desk_cmds_failed); fr_put_str(out, at[..], " ("); fr_put_pct(out, at[..], st[0].desk_cmds_failed, st[0].desk_cmds_total); fr_put_str(out, at[..], ") |\n");
  fr_put_str(out, at[..], "| Mid-turn steers | "); fr_put_int(out, at[..], st[0].desk_steers); fr_put_str(out, at[..], " |\n");
  fr_put_str(out, at[..], "| Rework/correction turns | "); fr_put_int(out, at[..], st[0].desk_rework_turns); fr_put_str(out, at[..], " ("); fr_put_pct(out, at[..], st[0].desk_rework_turns, st[0].desk_turns); fr_put_str(out, at[..], ") |\n");
  fr_put_str(out, at[..], "| Verify/ship nudge turns | "); fr_put_int(out, at[..], st[0].desk_verify_nudges); fr_put_str(out, at[..], " ("); fr_put_pct(out, at[..], st[0].desk_verify_nudges, st[0].desk_turns); fr_put_str(out, at[..], ") |\n");
  fr_put_str(out, at[..], "| Recorded spend | "); fr_put_usd(out, at[..], st[0].desk_cost_micros); fr_put_str(out, at[..], " |\n");

  fr_put_str(out, at[..], "\n## OpenAgents Runtime Hygiene\n\n");
  fr_put_str(out, at[..], "| Metric | Value |\n| --- | ---: |\n");
  fr_put_str(out, at[..], "| Session `.ajr` files / 0-byte leaks | "); fr_put_int(out, at[..], st[0].ajr_total); fr_put_str(out, at[..], " / "); fr_put_int(out, at[..], st[0].ajr_zero_bytes); fr_put_str(out, at[..], " ("); fr_put_pct(out, at[..], st[0].ajr_zero_bytes, st[0].ajr_total); fr_put_str(out, at[..], ") |\n");
  fr_put_str(out, at[..], "| `run-stops.log` zombie/stop events | "); fr_put_int(out, at[..], st[0].run_stops_lines); fr_put_str(out, at[..], " |\n");
  fr_put_str(out, at[..], "| Host runs currently `state=running` | "); fr_put_int(out, at[..], st[0].host_runs_running); fr_put_str(out, at[..], " |\n");
  return at[0];
}

fr_format_json :: (st_in: FrictionStats, now_s: int, out: [] u8) -> int {
  st := [1] FrictionStats.[st_in];
  fr_sort_coax_errors(st[..]);
  o: [1] Jo; jo_start(o[..], out);
  jo_obj(o[..]);
  jo_key(o[..], "schema"); jo_str(o[..], "openagents.friction-scorecard.v1");
  jo_key(o[..], "generated_at_s"); jo_int(o[..], now_s);
  jo_key(o[..], "antigravity"); jo_obj(o[..]);
  jo_key(o[..], "sessions"); jo_int(o[..], st[0].agy_sessions);
  jo_key(o[..], "user_turns"); jo_int(o[..], st[0].agy_user_turns);
  jo_key(o[..], "model_steps"); jo_int(o[..], st[0].agy_model_steps);
  jo_key(o[..], "empty_model_turns"); jo_int(o[..], st[0].agy_empty_model_turns);
  jo_key(o[..], "tool_calls"); jo_int(o[..], st[0].agy_tool_calls);
  jo_key(o[..], "cmd_runs"); jo_int(o[..], st[0].agy_cmd_runs);
  jo_key(o[..], "cmd_failures"); jo_int(o[..], st[0].agy_cmd_failures);
  jo_key(o[..], "manage_task_polls"); jo_int(o[..], st[0].agy_manage_task_polls);
  jo_key(o[..], "sleep_polls"); jo_int(o[..], st[0].agy_sleep_polls);
  jo_key(o[..], "ask_questions"); jo_int(o[..], st[0].agy_ask_questions);
  jo_key(o[..], "truncated_outputs"); jo_int(o[..], st[0].agy_truncated_outputs);
  jo_key(o[..], "compactions"); jo_int(o[..], st[0].agy_compactions);
  jo_key(o[..], "prepush_rejections"); jo_int(o[..], st[0].agy_prepush_rejections);
  jo_key(o[..], "rework_turns"); jo_int(o[..], st[0].agy_rework_turns);
  jo_key(o[..], "verify_nudges"); jo_int(o[..], st[0].agy_verify_nudges);
  jo_key(o[..], "coax_err_total"); jo_int(o[..], st[0].coax_err_total);
  jo_key(o[..], "coax_err_top"); jo_arr(o[..]);
  top := ifx st[0].coax_err_n < 10 then st[0].coax_err_n else 10;
  for i: 0..<top {
    cb: [8] u8; cat: [1] int;
    fr_put_code(cb[..], cat[..], st[0].coax_err_codes[i]);
    jo_obj(o[..]);
    jo_key(o[..], "code"); jo_str(o[..], cast(string) cb[0..<cat[0]]);
    jo_key(o[..], "count"); jo_int(o[..], st[0].coax_err_counts[i]);
    jo_end(o[..]);
  }
  jo_end(o[..]);
  jo_end(o[..]);
  jo_key(o[..], "desktop"); jo_obj(o[..]);
  jo_key(o[..], "chats"); jo_int(o[..], st[0].desk_chats);
  jo_key(o[..], "turns"); jo_int(o[..], st[0].desk_turns);
  jo_key(o[..], "turns_done"); jo_int(o[..], st[0].desk_turns_done);
  jo_key(o[..], "turns_stopped"); jo_int(o[..], st[0].desk_turns_stopped);
  jo_key(o[..], "turns_failed"); jo_int(o[..], st[0].desk_turns_failed);
  jo_key(o[..], "turns_running"); jo_int(o[..], st[0].desk_turns_running);
  jo_key(o[..], "empty_silent"); jo_int(o[..], st[0].desk_empty_silent);
  jo_key(o[..], "empty_with_note"); jo_int(o[..], st[0].desk_empty_with_note);
  jo_key(o[..], "cmds_total"); jo_int(o[..], st[0].desk_cmds_total);
  jo_key(o[..], "cmds_failed"); jo_int(o[..], st[0].desk_cmds_failed);
  jo_key(o[..], "steers"); jo_int(o[..], st[0].desk_steers);
  jo_key(o[..], "cost_usd_micros"); jo_int(o[..], st[0].desk_cost_micros);
  jo_key(o[..], "rework_turns"); jo_int(o[..], st[0].desk_rework_turns);
  jo_key(o[..], "verify_nudges"); jo_int(o[..], st[0].desk_verify_nudges);
  jo_end(o[..]);
  jo_key(o[..], "runtime"); jo_obj(o[..]);
  jo_key(o[..], "ajr_total"); jo_int(o[..], st[0].ajr_total);
  jo_key(o[..], "ajr_zero_bytes"); jo_int(o[..], st[0].ajr_zero_bytes);
  jo_key(o[..], "run_stops_lines"); jo_int(o[..], st[0].run_stops_lines);
  jo_key(o[..], "host_runs_running"); jo_int(o[..], st[0].host_runs_running);
  jo_end(o[..]);
  jo_end(o[..]);
  jo_byte(o[..], 10);
  return ifx o[0].bad then -1 else o[0].n;
}

// ---- Filesystem readers & discovery

fr_reader_init :: (r: [] FrReader, path: string) -> bool {
  r[0] = FrReader.{};
  sz := fs_size(path);
  if sz <= 0 { return false; }
  r[0].path_n = fr_copy(r[0].path[..], path);
  r[0].file_size = sz;
  return true;
}

fr_reader_next_line :: (r: [] FrReader, line_buf: [] u8) -> int {
  if r[0].eof { return -1; }
  n := 0;
  overflow := false;
  got_any := false;
  path := cast(string) r[0].path[0..<r[0].path_n];
  while true {
    if r[0].chunk_at >= r[0].chunk_n {
      if r[0].offset >= r[0].file_size {
        r[0].eof = true;
        if !got_any { return -1; }
        if overflow { return 0; }
        if n > 0 && line_buf[n - 1] == 13 { n -= 1; }
        return n;
      }
      want := r[0].file_size - r[0].offset;
      if want > FR_READ_CHUNK { want = FR_READ_CHUNK; }
      got := fs_read_at(path, r[0].offset, r[0].chunk[0..<want]);
      if got <= 0 {
        r[0].eof = true;
        if !got_any { return -1; }
        if overflow { return 0; }
        return n;
      }
      r[0].offset += got;
      r[0].chunk_n = got;
      r[0].chunk_at = 0;
    }
    c := r[0].chunk[r[0].chunk_at];
    r[0].chunk_at += 1;
    got_any = true;
    if c == 10 {
      if overflow { return 0; }
      if n > 0 && line_buf[n - 1] == 13 { n -= 1; }
      return n;
    }
    if !overflow {
      if n < line_buf.count { line_buf[n] = c; n += 1; }
      else { overflow = true; }
    }
  }
  return -1;
}

fr_add_file :: (list: [] FrFile, count: [] int, path: string) {
  if count[0] >= list.count { return; }
  sz := fs_size(path);
  if sz <= 0 { return; }
  idx := count[0];
  list[idx] = FrFile.{};
  list[idx].path_n = fr_copy(list[idx].path[..], path);
  list[idx].mtime = fs_mtime_ns(path);
  list[idx].size = sz;
  count[0] += 1;
}

fr_sort_newest :: (list: [] FrFile, n: int) {
  for i: 1..<n {
    key := list[i];
    j := i - 1;
    while j >= 0 && list[j].mtime < key.mtime {
      list[j + 1] = list[j];
      j -= 1;
    }
    list[j + 1] = key;
  }
}

fr_discover_agy_root :: (brain_root: string, list: [] FrFile, count: [] int) {
  if fs_kind(brain_root) != FS_DIR { return; }
  dirs: [1] FsList; nd := fs_list(brain_root, dirs[..]);
  if nd <= 0 { return; }
  for i: 0..<nd {
    id := fs_entry(dirs[..], i);
    if id.count == 0 || id[0] == '.' { continue; }
    b1: [1024] u8; b2: [1024] u8;
    tp := fs_join(fs_join(brain_root, id, b1[..]), ".system_generated/logs/transcript.jsonl", b2[..]);
    if fs_kind(tp) == FS_FILE { fr_add_file(list, count, tp); }
  }
}

fr_discover_desk_chats :: (home: string, list: [] FrFile, count: [] int) {
  rb: [1024] u8; root := fs_join(home, "Library/Application Support/Coder/chats", rb[..]);
  if fs_kind(root) != FS_DIR { return; }
  files: [1] FsList; nf := fs_list(root, files[..]);
  if nf <= 0 { return; }
  for i: 0..<nf {
    fname := fs_entry(files[..], i);
    if fname.count <= 5 || fname[0] == '.' || !fr_ends_with(fname, ".json") { continue; }
    if fname == "index.json" || fname == "sidebar-meta.json" { continue; }
    pb: [1024] u8; full := fs_join(root, fname, pb[..]);
    if fs_kind(full) == FS_FILE { fr_add_file(list, count, full); }
  }
}

fr_scan_runtime :: (home: string, st: [] FrictionStats) {
  // 1. AJR1 session files & 0-byte leaks
  sb: [1024] u8; sdir := fs_join(home, ".openagents/coder/sessions", sb[..]);
  if fs_kind(sdir) == FS_DIR {
    files: [1] FsList; nf := fs_list(sdir, files[..]);
    if nf > 0 {
      for i: 0..<nf {
        fname := fs_entry(files[..], i);
        if !fr_ends_with(fname, ".ajr") { continue; }
        pb: [1024] u8; full := fs_join(sdir, fname, pb[..]);
        if fs_kind(full) != FS_FILE { continue; }
        st[0].ajr_total += 1;
        if fs_size(full) == 0 { st[0].ajr_zero_bytes += 1; }
      }
    }
  }
  // 2. run-stops.log lines (macOS Application Support/Coder/run-stops.log, or ~/.openagents/coder/host/run-stops.log)
  lb: [1024] u8; lpath := fs_join(home, "Library/Application Support/Coder/run-stops.log", lb[..]);
  if fs_kind(lpath) != FS_FILE {
    lpath = fs_join(home, ".openagents/coder/host/run-stops.log", lb[..]);
  }
  if fs_kind(lpath) == FS_FILE {
    rd: [1] FrReader;
    if fr_reader_init(rd[..], lpath) {
      lbuf: [4096] u8;
      while true {
        ln := fr_reader_next_line(rd[..], lbuf[..]);
        if ln < 0 { break; }
        if ln > 0 { st[0].run_stops_lines += 1; }
      }
    }
  }
  // 3. Host runs currently state=running
  hb: [1024] u8; hdir := fs_join(home, ".openagents/coder/host/runs", hb[..]);
  if fs_kind(hdir) == FS_DIR {
    rfiles: [1] FsList; nr := fs_list(hdir, rfiles[..]);
    if nr > 0 {
      sbuf: [2048] u8;
      for i: 0..<nr {
        fname := fs_entry(rfiles[..], i);
        if !fr_ends_with(fname, ".state") { continue; }
        pb: [1024] u8; full := fs_join(hdir, fname, pb[..]);
        if fs_kind(full) != FS_FILE { continue; }
        got := fs_read_at(full, 0, sbuf[..]);
        if got > 0 && agr_has(cast(string) sbuf[0..<got], "\"state\":\"running\"") {
          st[0].host_runs_running += 1;
        }
      }
    }
  }
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) { tool_errln("friction: arguments too large"); return 2; }
  if args_has(a[..], "--help") || args_has(a[..], "-h") {
    print("usage: friction.coax [--limit N] [--json] [--out PATH] [--home DIR]\n");
    return 0;
  }

  lim_s := args_value(a[..], "--limit", "0");
  limit := args_whole(lim_s);
  if limit < 0 { tool_errln("friction: invalid --limit"); return 2; }
  as_json := args_has(a[..], "--json");
  out_path := args_value(a[..], "--out", "");

  hb: [1024] u8;
  home := args_value(a[..], "--home", "");
  if home.count == 0 { home = proc_getenv("HOME", hb[..]); }
  if home.count == 0 { tool_errln("friction: HOME not set"); return 1; }

  st: [1] FrictionStats;
  ab: [65536] u8; ar: [1] ClArena; ar[0].buf = ab[..];

  // 1. Scan Antigravity transcripts
  agy_files: [FR_MAX_FILES] FrFile;
  na: [1] int;
  b1: [1024] u8; fr_discover_agy_root(fs_join(home, ".gemini/antigravity/brain", b1[..]), agy_files[..], na[..]);
  b2: [1024] u8; fr_discover_agy_root(fs_join(home, ".gemini/antigravity-cli/brain", b2[..]), agy_files[..], na[..]);
  fr_sort_newest(agy_files[..], na[0]);
  take_a := na[0];
  if limit > 0 && take_a > limit { take_a = limit; }
  line_buf: [FR_LINE_MAX] u8;
  for i: 0..<take_a {
    p := cast(string) agy_files[i].path[0..<agy_files[i].path_n];
    rd: [1] FrReader;
    if !fr_reader_init(rd[..], p) { continue; }
    st[0].agy_sessions += 1;
    while true {
      ln := fr_reader_next_line(rd[..], line_buf[..]);
      if ln < 0 { break; }
      if ln > 0 { fr_analyze_agy_line(cast(string) line_buf[0..<ln], st[..], ar[..]); }
    }
  }

  // 2. Scan OpenAgents Desktop persisted UI chats
  desk_files: [FR_MAX_FILES] FrFile;
  nd: [1] int;
  fr_discover_desk_chats(home, desk_files[..], nd[..]);
  fr_sort_newest(desk_files[..], nd[0]);
  take_d := nd[0];
  if limit > 0 && take_d > limit { take_d = limit; }
  chat_buf: [8388608] u8;
  for i: 0..<take_d {
    p := cast(string) desk_files[i].path[0..<desk_files[i].path_n];
    sz := desk_files[i].size;
    if sz <= 0 || sz > chat_buf.count { continue; }
    got := fs_read_at(p, 0, chat_buf[0..<sz]);
    if got > 0 { _ = fr_analyze_desk_chat(cast(string) chat_buf[0..<got], st[..], ar[..]); }
  }

  // 3. Scan OpenAgents runtime hygiene
  fr_scan_runtime(home, st[..]);

  report_buf: [32768] u8;
  rn := 0;
  if as_json { rn = fr_format_json(st[0], cxproc_wall_us() / 1000000, report_buf[..]); }
  else { rn = fr_format_markdown(st[0], report_buf[..]); }
  if rn <= 0 { tool_errln("friction: report overflow"); return 1; }
  report := cast(string) report_buf[0..<rn];
  if out_path.count > 0 {
    if !fs_write(out_path, report) { tool_errln("friction: failed to write --out"); return 1; }
  }
  print("%", report);
  return 0;
}

// ---- Unit tests

#test "friction: nonzero exit, sleep poll, rework/verify cues, and coax E0xxx scanning" {
  #assert !fr_has_nonzero_exit("Command exited with code 0.");
  #assert fr_has_nonzero_exit("Command exited with code 1.");
  #assert fr_has_nonzero_exit("Command exited with code 2.\nbad flag");
  #assert fr_has_nonzero_exit("Command exited with code 127.");
  #assert fr_has_nonzero_exit("Encountered error: timeout");

  #assert fr_is_sleep_poll("sleep 10 && echo hi");
  #assert fr_is_sleep_poll("while true; do sleep 5; done");
  #assert !fr_is_sleep_poll("echo asleep 10");
  #assert !fr_is_sleep_poll("coax test foo.coax");

  #assert fr_is_rework_cue("still broken after rebuild");
  #assert fr_is_rework_cue("No, don't touch main");
  #assert !fr_is_rework_cue("Please implement feature X and verify with coax test.");

  #assert fr_is_verify_nudge("did you test it on the built app?");
  #assert fr_is_verify_nudge("push to main and install it");
  #assert !fr_is_verify_nudge("looks good, thanks");

  st: [1] FrictionStats;
  fr_scan_coax_errors("a.coax:1: error[E0302]: x\nb.coax:2: error[E0216]: y\nc.coax:3: error[E0302]: z\n", st[..]);
  #assert st[0].coax_err_total == 3 && st[0].coax_err_n == 2;
  fr_sort_coax_errors(st[..]);
  #assert st[0].coax_err_codes[0] == 302 && st[0].coax_err_counts[0] == 2;
  #assert st[0].coax_err_codes[1] == 216 && st[0].coax_err_counts[1] == 1;
}

#test "friction: analyzes Antigravity lines, Desktop chats, and formats Markdown + JSON" {
  st: [1] FrictionStats;
  ab: [16384] u8; ar: [1] ClArena; ar[0].buf = ab[..];

  fr_analyze_agy_line("{\"type\":\"USER_INPUT\",\"status\":\"DONE\",\"content\":\"<USER_REQUEST>still broken, did you test it?</USER_REQUEST>\"}", st[..], ar[..]);
  fr_analyze_agy_line("{\"type\":\"PLANNER_RESPONSE\",\"status\":\"DONE\",\"content\":\"\",\"tool_calls\":[{\"name\":\"manage_task\",\"args\":{\"Action\":\"\\\"status\\\"\"}},{\"name\":\"run_command\",\"args\":{\"CommandLine\":\"\\\"sleep 5 && echo ok\\\"\"}}]}", st[..], ar[..]);
  fr_analyze_agy_line("{\"type\":\"GENERIC\",\"status\":\"DONE\",\"content\":\"Command exited with code 2.\\nfoo.coax:9: error[E0342]: builtin\\nThe tool's output was truncated\\nprepush: REFUSED missing Agent:\"}", st[..], ar[..]);
  fr_analyze_agy_line("{\"type\":\"PLANNER_RESPONSE\",\"status\":\"DONE\",\"content\":\"\"}", st[..], ar[..]);
  fr_analyze_agy_line("{\"type\":\"CHECKPOINT\",\"status\":\"DONE\",\"content\":\"summary\"}", st[..], ar[..]);

  #assert st[0].agy_user_turns == 1 && st[0].agy_rework_turns == 1 && st[0].agy_verify_nudges == 1;
  #assert st[0].agy_tool_calls == 2 && st[0].agy_manage_task_polls == 1 && st[0].agy_sleep_polls == 1 && st[0].agy_cmd_runs == 1;
  #assert st[0].agy_cmd_failures == 1 && st[0].agy_truncated_outputs == 1 && st[0].agy_prepush_rejections == 1;
  #assert st[0].agy_empty_model_turns == 1 && st[0].agy_compactions == 1 && st[0].coax_err_total == 1;

  chat := "{\"v\":1,\"cost_usd_micros\":1250000,\"turns\":[{\"ask\":\"build it\",\"reply\":\"\",\"state\":1,\"note\":\"\",\"cmds\":[{\"text\":\"run\",\"out\":\"x\",\"read\":false,\"failed\":true}]},{\"ask\":\"still broken\",\"reply\":\"\",\"state\":2,\"note\":\"Stopped.\",\"steers\":[\"hurry\"],\"cmds\":[]}]}";
  #assert fr_analyze_desk_chat(chat, st[..], ar[..]);
  #assert st[0].desk_chats == 1 && st[0].desk_turns == 2 && st[0].desk_turns_done == 1 && st[0].desk_turns_stopped == 1;
  #assert st[0].desk_empty_silent == 1 && st[0].desk_empty_with_note == 1;
  #assert st[0].desk_cmds_total == 1 && st[0].desk_cmds_failed == 1 && st[0].desk_steers == 1;
  #assert st[0].desk_rework_turns == 1 && st[0].desk_cost_micros == 1250000;

  md_buf: [8192] u8;
  mn := fr_format_markdown(st[0], md_buf[..]);
  #assert mn > 0 && agr_has(cast(string) md_buf[0..<mn], "E0342") && agr_has(cast(string) md_buf[0..<mn], "$1.25");

  js_buf: [8192] u8;
  jn := fr_format_json(st[0], 1795400000, js_buf[..]);
  #assert jn > 0;
  nodes: [512] JvNode; d: [1] Jv;
  #assert jv_parse(d[..], cast(string) js_buf[0..<jn], nodes[..]);
  #assert jv_int(d[0], jv_path(d[0], 0, "antigravity.manage_task_polls"), -1) == 1;
  #assert jv_int(d[0], jv_path(d[0], 0, "desktop.empty_silent"), -1) == 1;
}
