// Everglade II's class bar (#13058): your Character Create class's kit at its level, 1 to 6 (#13046;
// class-kit.coax xk_bar_at, Everglade Experimental's bar at that level), pressed with 1 to 9 or a click.
// It aims as Experimental's does, ahead of you and never at anyone for you (xc_aim_for, xc_aim_point),
// and looks and sounds as it does (class-look.coax xc_look_of, class-kit.coax xc_sound,
// everglade/sound.coax). Everglade II has no monsters and its players can't harm each other: a cast
// has no harmful target. The server now resolves self effects and cast costs through
// shared rules; this page predicts presentation. A bolt flies to its range and fizzles, a blow swings at the air,
// an area opens ahead.
//
// A press asks first (aethyr/action/deed.coax, docs/verse/action-pipeline.md, #13072): your bearing
// (the SRD conditions on the room's row of you) must let you act, the slot must not be cooling down,
// what the room's rules hold of it must not be spent (b, everglade/client/net.coax e2n_slot), and every
// ability declares its feel (class-feel.coax). When this page's own answer is yes it plays at once
// (#13157): your press is never held for the room's round trip. It goes to the room in the same frame
// (everglade/client/net.coax e2n_cast: C SEQ SLOT AX AY AZ -1), which takes it when the slot is your class's
// and tells every page near (e cast SS SLOT AX AY AZ SEED, coax/web/room/room-everglade.coax
// eg_e2_cast). The room's yes confirms what is already playing. Its refusal (r SEQ WHY), or no word in
// 1.5 s, takes it back: the effects and sounds fade out over E2K_FADE s, the clip on your body stops,
// a loosed arrow fades (everglade/client/arrows.coax), the slot greys and its cooldown lifts. Nothing the
// press showed has harmed anyone: only the room rolls and spends. Another's plays here when the
// picture of it reaches the tick it came with, from where it is drawn, at its seed.
// everglade/client/client.coax loads this beside class-look.coax and everglade/sound.coax (as exsound).

E2K_LATER :: 8;      // sounds waiting a moment: a bolt's fizzle where it ends
E2K_GAIN_START :: 0.55; E2K_GAIN_LAYER :: 0.32; E2K_GAIN_MISS :: 0.4;   // as Experimental's (xc_cast_sound)
E2kLater :: struct { on: bool; t: f32; name: string; x: f32; z: f32; rate: f32 = 1; mine: bool; }
// A refused cast's look and sound (#13046, #13157): what your press started, faded out over E2K_FADE s, never cut.
E2K_FADE :: 0.25; E2K_MINE :: 4; E2K_FADES :: 8;
E2kFade :: struct { slot: int = -1; t0: f32; at: f32; }
// A body's cast: when it began and its clip (a blow's slash, a spell's cast), drawn over its gait.
E2kAct :: struct { at: f32 = -100; clip: int = -1; }
// Your press waiting for the room's answer: its request, its slot and where you faced; the number it
// went to the room under, and whether what it showed was taken back.
// replay: it was taken back for want of an answer (not refused), so the room's late yes plays it after all.
E2kAsk :: struct { seq: int; slot: int = -1; wire: int; face: f32; net_seq: int; rolled: bool; replay: bool; }
E2Cast :: struct {
  klass: int = -1; level: int = 1; bar: [XC_SLOTS] FbAb; bar_n: int;
  wire: [XC_SLOTS] int;                    // each slot's ability on the wire (class-kit.coax xk_wire)
  cool_at: f32 = -100; used: int = -1; hover: int = -1;
  menu: int = -1; side_hover: int = -1; menu_hover: int = -1;   // the class menus' open one (EG_SIDE_*, everglade/hud/class-bar.coax) and what the pointer is over
  puffs: [1] FxPuffs;                      // the casts' effects (aethyr/fx/puff.coax), drawn by everglade/client/gpu/everglade2-fx.coax
  audio: [1] exsound.ExperimentalSound;    // their sounds, for the host (everglade2-face.c coaxial_sounds)
  later: [E2K_LATER] E2kLater;
  me: [1] E2kAct; them: [E2N_ENTS] E2kAct;     // yours, and each other's by its slot in the room's list
  pressed: int; others: int; unseen: int; shown: int; seed: u64 = 0x2545f4914f6cdd1d;   // shown: your own casts' presentations begun
  refused_seen: int;                       // the room's refusals of your casts this page has reconciled
  // your last press's look and sound: its effects' slots (and their starts) and its voices
  mine: [E2K_MINE] int; mine_t0: [E2K_MINE] f32; mine_n: int; voice0: int; voice1: int;
  fades: [E2K_FADES] E2kFade; undone: int;
  deeds: [1] DeedBar;                      // the bar's asks and the room's answers (aethyr/action/deed.coax, #13072)
  ask: E2kAsk;                             // your press the room hasn't answered
  mine_heard: int;                         // your casts the room took that this page has played
  locked: bool; stopped: int;              // your bearing stops your actions: what you had going was stopped (e2k_lock_step)
  area: [1] aa.AreaAim;                    // a placed area armed: its square or circle on the ground at the crosshair (aethyr/action/area-aim.coax)
  opened: aa.AreaAim; opened_sp: int = -1; // your last area where it opened (Thunderwave's cube, Entangle's square), shown until its until
  aimed_x: f32; aimed_z: f32;              // where your last cast was aimed
  loosing: bool;                           // the bow's loose is pressing its Attack now (everglade/client/mouse.coax e2m_loose)
  rolled: int;                             // your presses whose presentation was taken back (the room refused, or never answered)
}

// Your class's bar at its level: once either changes (the druid at 1 until Character Create says).
e2k_set_class :: (k: [] E2Cast, c: int, level: int) {
  l := xk_level(level);
  if c < 0 || c >= FB_CL_N || (c == k[0].klass && l == k[0].level) { return; }
  k[0].klass = c; k[0].level = l; k[0].bar_n = xk_bar_at(c, l, k[0].bar[..]); k[0].used = -1; k[0].hover = -1;
  for i: 0..<k[0].bar_n { k[0].wire[i] = xk_wire(c, k[0].bar[i]); }
}
e2k_on :: (s: [] E2) -> bool { return s[0].placed && !e2c_creating(s) && s[0].casts[0].bar_n > 0; }

// One sound where it happens: softer the farther from you, panned the way the camera faces.
e2k_cue :: (s: [] E2, name: string, gain: f32, x: f32, z: f32, rate: f32) {
  if name.count == 0 { return; }
  f:=e2n_familiar_view(s[0].net[..]);
  borrowed:=f.live && s[0].net[0].familiar_sense==2;
  dx:=x-(ifx borrowed then f.x else s[0].you_x);
  dz:=z-(ifx borrowed then f.z else s[0].you_z);
  d:=sqrt(dx*dx+dz*dz);
  pan := ifx d > 0.5 then (dx * s[0].right[0] + dz * s[0].right[2]) / d * 0.7 else 0.0f32;
  exsound.experimental_sound_play(s[0].casts[0].audio[..], name, gain / (1 + d / 10), pan, rate);
}
e2k_later :: (k: [] E2Cast, t: f32, name: string, x: f32, z: f32, rate: f32, mine: bool) {
  if name.count == 0 { return; }
  for i: 0..<E2K_LATER { if !k[0].later[i].on { k[0].later[i] = E2kLater.{on = true, t = t, name = name, x = x, z = z, rate = rate, mine = mine}; return; } }
}
// How much of effect slot q (started at t0) is still shown: 1, or less while it fades.
e2k_shown :: (k: [] E2Cast, q: int, t0: f32, now: f32) -> f32 {
  for f: 0..<E2K_FADES {
    d := k[0].fades[f];
    if d.slot == q && d.t0 == t0 { u := e2_sat((now - d.at) / f32(E2K_FADE)); return 1 - u * u * (3 - 2 * u); }
  }
  return 1;
}

// Class c's ability on wire slot `slot` cast by someone whose feet are at (px, py, pz), facing `face`, at the point
// (ax, ay, az), now: its look and its sound; a blow's or spell's clip on its body (act). The causes
// started.
e2k_play :: (s: [] E2, c: int, slot: int, px: f32, py: f32, pz: f32, face: f32, ax: f32, ay: f32, az: f32, seed: int, act: [] E2kAct, mine: bool) -> int {
  k := s[0].casts[..];
  e := xk_entry(c, slot);
  if !e.ok { return 0; }
  now := s[0].clock;
  if mine { k[0].shown += 1; }
  // a bow's Attack is its arrow (everglade/client/arrows.coax): the loose, its flight and where it ends are
  // drawn and heard there, and nothing flashes where it was aimed
  if xc_kit(c) == XC_KIT_BOW && e.ab.kind == FB_ATTACK { act[0].at = now; act[0].clip = -1; return 1; }
  started := xc_look_start(k[0].puffs[..], xc_look_of(e.ab, px, py, pz, face, fxp_v(ax, ay, az)), now, f32(seed % 9973));
  d := xc_sound(e.ab, c);
  e2k_cue(s, d.start, f32(E2K_GAIN_START), px, pz, d.rate);
  e2k_cue(s, d.layer, f32(E2K_GAIN_LAYER), px, pz, d.rate);
  // a bolt meets no one: it fizzles where its range ends
  if e.aim.kind == XC_AIM_BOLT {
    dx := ax - px; dz := az - pz; fly := sqrt(dx * dx + dz * dz) / 22;
    fly = ifx fly < 0.15 then 0.15f32 else ifx fly > 0.8 then 0.8f32 else fly;
    e2k_later(k, now + fly, ifx d.miss.count > 0 then d.miss else "fizzle", ax, az, d.rate, mine);
  }
  // a blow's slash or a spell's cast, as Experimental's (cast-pose.coax; no weapon drawn here, so no cleave)
  // a bow's arrow is the bow's own pose (its draw and follow-through, everglade/client/mouse.coax and e2_remote_aim)
  act[0].at = now; act[0].clip = ifx xc_kit(c) == XC_KIT_BOW && e.ab.kind == FB_ATTACK then -1 else cp_cast_clip(xc_kit(c), e.aim.kind == XC_AIM_MELEE, false);
  return started;
}

// Your bearing: the SRD conditions on the room's row of you (aethyr/rules/srd/condition-bearing.coax).
// Before the room has said, nothing holds you back: the room is still the one that decides.
e2k_bearing :: (s: [] E2) -> DeedBearing {
  row := e2n_vitals(s[0].net[..]);
  if row.id < 0 { return DeedBearing.{}; }
  return e2k_bearing_row(row);
}
// Any player's bearing from the room's row of them (yours, or another's body as the room has it).
e2k_bearing_row :: (row: WireS) -> DeedBearing {
  return rs_bearing_of(row.hp, (row.g & WG_DEAD) != 0, row.cond & 32767, (row.cond & WC_HALTED) != 0, false);
}
// Each frame: once your bearing stops your actions (Unconscious at 0 Hit Points, Stunned...), what you
// had going stops with it: your cast's clip on your body ends, a drawn bow is let down, an armed area
// is dropped. Nothing new starts (deed_ask refuses while locked).
e2k_lock_step :: (s: [] E2) {
  k := s[0].casts[..];
  locked := !deed_can_act(e2k_bearing(s));
  if locked && !k[0].locked {
    k[0].me[0] = E2kAct.{}; k[0].stopped += 1; _ := aa.area_aim_cancel(k[0].area[..]);
    m := s[0].mouse[..]; if m[0].draw[0].on { bow.bow_cancel(m[0].draw[..]); m[0].cancels += 1; }
  }
  k[0].locked = locked;
}
// The plain line while you are down: centred over the bar, the Death Saving Throws as the room rolls
// them (aethyr/rules/srd/death-save-line.coax).
e2k_down_line :: (s: [] E2, out: [] f32, at: int) -> int {
  if !e2k_on(s) { return at; }
  row := e2n_vitals(s[0].net[..]);
  if row.id < 0 { return at; }
  line: [64] u8; ln := rs_death_line(rs_death_saves(row.hp, (row.g & WG_DEAD) != 0, row.p2), line[..]);
  return eg_down_line(out, at, cast(string) line[0..<ln], s[0].width, s[0].height, s[0].k);   // everglade/hud/windows.coax
}
// Whether slot i can go now (a held action, such as the bow's draw, asks before it starts): a no from
// your bearing greys the slot.
e2k_ready :: (s: [] E2, i: int) -> bool {
  k := s[0].casts[..];
  if !e2k_on(s) || i < 0 || i >= k[0].bar_n { return false; }
  tick := deed_tick(s[0].clock);
  v := deed_can(k[0].deeds[0], i, tick, e2k_bearing(s), xf_feel(k[0].klass, k[0].bar[i]));
  if v == DeedVerdict.locked || v == DeedVerdict.no_feel { deed_grey(k[0].deeds[..], i, tick); }
  return v == DeedVerdict.ok;
}
// Slot i pressed: asked, then sent; it plays once the room takes it (e2k_step). False when it can't go
// (cooling down, held by your conditions, no room).
e2k_press :: (s: [] E2, i: int) -> bool {
  k := s[0].casts[..];
  if !e2k_on(s) || i < 0 || i >= k[0].bar_n { return false; }
  if s[0].clock - k[0].cool_at < f32(XC_COOL) { return false; }
  c := k[0].klass; a := k[0].bar[i];
  // a Ranger's Attack is the Longbow's: its key or its slot draws, and looses at full draw, as the
  // left button does and as Experimental's key does (everglade/client/mouse.coax)
  if a.kind == FB_ATTACK && !k[0].loosing && e2m_archer(s) { return e2m_draw(s, true); }
  m := xc_aim_for(a, xk_weapon(c));
  face := e2_show_face(s); fx := sin(face); fz := cos(face);   // mouselook: the camera's way
  // a placed area (class-kit.coax xk_area_placed): the first press arms its preview on the ground, the
  // second (or a click) casts it there
  if !xk_area_placed(a) { _ := aa.area_aim_cancel(k[0].area[..]); }   // another slot lets an armed area go
  else {
    ar := k[0].area[..];
    if ar[0].on && ar[0].slot == i { shot := aa.area_aim_confirm(ar); return e2k_cast(s, i, face, shot.x, shot.z); }
    if !e2k_ready(s, i) { return false; }   // arming asks nothing of the room, but your bearing must let you act
    ar[0] = xk_area_arm(a, i, m.reach, s[0].clock);
    e2k_area_step(s);
    return true;
  }
  p0 := xc_aim_point(a, m, s[0].you_x, s[0].you_z, fx, fz);
  p := e2gd_aim(s, m, p0, fx, fz);   // at the path's guard when he is before you (everglade/client/guard.coax)
  if p[0] == p0[0] && p[1] == p0[1] { p = e2mn_aim(s, m, p0, fx, fz); }   // else at a monster before you (everglade/client/creatures.coax)
  return e2k_cast(s, i, face, p[0], p[1]);
}
// Where the crosshair meets the ground: along the camera's line from the eye, the first step under the
// land, 80 m at most (looking up: the furthest point straight on along it).
e2k_crosshair_ground :: (s: [] E2) -> [2] f32 {
  e := s[0].eye; f := s[0].fwd; t: f32 = 0.5;
  while t < 80 {
    x := e[0] + f[0] * t; y := e[1] + f[1] * t; z := e[2] + f[2] * t;
    if y <= e2_height(x, z) { return [2] f32.[x, z]; }
    t += 0.25;
  }
  return [2] f32.[e[0] + f[0] * 80, e[2] + f[2] * 80];
}
// Each frame: the armed area follows the crosshair, held to its range; dropped once the slot can't be used.
e2k_area_step :: (s: [] E2) {
  k := s[0].casts[..]; ar := k[0].area[..];
  if !ar[0].on { return; }
  if !e2k_on(s) || !deed_can_act(e2k_bearing(s)) || ar[0].slot >= k[0].bar_n { _ := aa.area_aim_cancel(ar); return; }
  h := e2k_crosshair_ground(s);
  ar[0] = aa.area_aim_follow(ar[0], s[0].you_x, s[0].you_z, h[0], h[1]);
}
e2k_area_confirm :: (s: [] E2) -> bool { k := s[0].casts[..]; if !k[0].area[0].on { return false; } return e2k_press(s, k[0].area[0].slot); }
e2k_area_cancel :: (s: [] E2) -> bool { return aa.area_aim_cancel(s[0].casts[0].area[..]); }
E2K_OPENED :: 1.4;   // s an area shows where it opened, as Experimental's Thunderwave
// The area to show now beside an armed one: the slot under the pointer's, ahead of you, when it opens
// from you (Thunderwave's cube before you press it); else your last area while it shows.
e2k_area_seen :: (s: [] E2) -> aa.AreaAim {
  k := s[0].casts[..];
  if e2k_on(s) && k[0].hover >= 0 && k[0].hover < k[0].bar_n {
    r := xk_area(k[0].bar[k[0].hover]);
    if r.on && aa.area_from_caster(r) { return aa.area_face(r, s[0].you_x, s[0].you_z, e2_show_face(s)); }
  }
  if s[0].clock < k[0].opened.until { return k[0].opened; }
  return aa.AreaAim.{};
}
// Whether a creature at (x, z) is inside the area you aim or the one shown (its plate lights).
e2k_area_holds :: (s: [] E2, x: f32, z: f32) -> bool {
  return aa.area_aim_contains(s[0].casts[0].area[0], x, z) || aa.area_aim_contains(e2k_area_seen(s), x, z);
}
// One area on the ground through this camera (aethyr/action/area-aim.coax area_aim_point), its guides finer.
e2k_area_draw :: (s: [] E2, a: aa.AreaAim, out: [] f32, at: int, cr: f32, cg: f32, cb: f32) -> int {
  v := at; k := s[0].k;
  view := aa.AreaView.{eye = s[0].eye, fwd = s[0].fwd, right = s[0].right, up = s[0].up, focal = s[0].focal,
    cx = s[0].width * 0.5, cy = ifx s[0].cy > 0 then s[0].cy else s[0].height * 0.5, near = 0.3};
  last: aa.AreaAt;
  for p: 0..<aa.area_aim_points(a) {
    w := aa.area_aim_point(a, p);
    q := aa.area_view_at(view, w[0], e2_height(w[0], w[1]) + 0.06, w[1]);
    g := ifx aa.area_aim_guide(p) then 0.55f32 else 1.0f32;
    if aa.area_aim_joined(a, p) && q.ok && last.ok { v = cc.line(out, v, last.x, last.y, q.x, q.y, k * (ifx aa.area_aim_guide(p) then 0.8f32 else 1.4f32), cr * g, cg * g, cb * g); }
    last = q;
  }
  return v;
}
// The armed area's outline on the ground, gold (red where the crosshair is past its range), and the
// area shown beside it in its spell's colour.
e2k_area_marks :: (s: [] E2, out: [] f32, at: int) -> int {
  v := at;
  seen := e2k_area_seen(s);
  if seen.on {
    k := s[0].casts[..]; sp := ifx s[0].clock < k[0].opened.until then k[0].opened_sp else -1;
    if k[0].hover >= 0 && k[0].hover < k[0].bar_n && k[0].bar[k[0].hover].kind == FB_SPELL { sp = k[0].bar[k[0].hover].sp; }
    c := ifx sp >= 0 then fxl_spell_rgb(sp) else fxp_v(0.55, 0.75, 1.0);
    v = e2k_area_draw(s, seen, out, v, c.x, c.y, c.z);
  }
  a := s[0].casts[0].area[0];
  if !a.on { return v; }
  pulse := 0.75 + 0.25 * sin(s[0].clock * 6);
  cr := ifx a.far then 1.0f32 else 0.86f32; cg := ifx a.far then 0.32f32 else 0.78f32; cb := ifx a.far then 0.28f32 else 0.42f32;
  return e2k_area_draw(s, a, out, v, cr * pulse, cg * pulse, cb * pulse);
}
// The room refused your last press, or never answered: what it showed is taken back. Its effects fade
// out where they are, its sounds fade out, the fizzle still to come never plays, its clip on your body
// stops and its arrow fades. Nothing pops.
e2k_undo :: (s: [] E2) {
  k := s[0].casts[..]; now := s[0].clock;
  if k[0].ask.rolled || k[0].ask.slot < 0 { return; }
  for v: k[0].voice0 + 1..<k[0].voice1 + 1 {
    b: [24] u8; m := e2k_put(b[..], 0, "-x"); m = e2k_int(b[..], m, v); m = e2k_put(b[..], m, "\n");
    exsound.experimental_sound_add(k[0].audio[..], cast(string) b[0..<m]);
  }
  for j: 0..<k[0].mine_n {
    q := k[0].mine[j];
    if !k[0].puffs[0].on[q] || k[0].puffs[0].live[q].t0 != k[0].mine_t0[j] { continue; }
    for f: 0..<E2K_FADES { if k[0].fades[f].slot < 0 || now - k[0].fades[f].at > f32(E2K_FADE) { k[0].fades[f] = E2kFade.{slot = q, t0 = k[0].mine_t0[j], at = now}; break; } }
  }
  for i: 0..<E2K_LATER { if k[0].later[i].mine { k[0].later[i].on = false; } }
  k[0].mine_n = 0; k[0].voice0 = k[0].voice1; k[0].undone += 1;
  k[0].me[0] = E2kAct.{}; k[0].opened.until = -1;
  e2bw_undo(s, k[0].ask.net_seq);
  k[0].ask.rolled = true; k[0].rolled += 1;
}
// Your press's presentation, begun now (#13157): its look and sound from where you stand, its clip on
// your body, its area where it opens. What it starts is kept so a refusal can take it back (e2k_undo).
e2k_predict :: (s: [] E2, i: int, face: f32, ax: f32, ay: f32, az: f32) {
  k := s[0].casts[..]; now := s[0].clock; c := k[0].klass; ab := k[0].bar[i];
  r := xk_area(ab);
  if r.on {
    k[0].opened = ifx aa.area_from_caster(r) then aa.area_face(r, s[0].you_x, s[0].you_z, face) else aa.area_face(r, ax, az, 0);
    k[0].opened.until = now + f32(E2K_OPENED); k[0].opened_sp = ifx ab.kind == FB_SPELL then ab.sp else -1;
  }
  k[0].seed ^= k[0].seed << 13; k[0].seed ^= k[0].seed >> 7; k[0].seed ^= k[0].seed << 17;
  before: [FX_LIVE] bool; for q: 0..<FX_LIVE { before[q] = k[0].puffs[0].on[q] && k[0].puffs[0].live[q].t0 == now; }
  k[0].voice0 = k[0].audio[0].voice;
  _ := e2k_play(s, c, k[0].wire[i], s[0].you_x, s[0].you_y, s[0].you_z, face, ax, ay, az, cast(int)(k[0].seed % 999983), k[0].me[..], true);
  k[0].voice1 = k[0].audio[0].voice; k[0].mine_n = 0;
  for q: 0..<FX_LIVE {
    if before[q] || !k[0].puffs[0].on[q] || k[0].puffs[0].live[q].t0 != now || k[0].mine_n >= E2K_MINE { continue; }
    k[0].mine[k[0].mine_n] = q; k[0].mine_t0[k[0].mine_n] = now; k[0].mine_n += 1;
  }
}
// Slot i cast at (px, pz) on the ground: asked (aethyr/action/deed.coax), and when this page's own
// answer is yes, played now and sent in the same frame; the room's word confirms it (e2k_taken) or
// takes it back (e2k_undo). False when the ask is refused or nothing could be sent.
e2k_cast :: (s: [] E2, i: int, face: f32, px: f32, pz: f32) -> bool {
  k := s[0].casts[..];
  now := s[0].clock; tick := deed_tick(now);
  // what the room's rules hold of this slot is spent (its uses, its Rages): this page's own no
  left := e2n_slot(s[0].net[..], i, k[0].bar_n);
  if left.ok && left.left == 0 { deed_grey(k[0].deeds[..], i, tick); k[0].deeds[0].last = DeedVerdict.refused; return false; }
  seq := deed_ask(k[0].deeds[..], i, tick, e2k_bearing(s), xf_feel(k[0].klass, k[0].bar[i]));
  if seq == 0 { return false; }
  // another slot while the bow is drawn lets the draw down first: the press is this one, and the
  // loose it would have been never comes (the draw's loose is this same Attack: e2m_loose)
  mo := s[0].mouse[..];
  if mo[0].draw[0].on && i != e2m_attack(k) { bow.bow_cancel(mo[0].draw[..]); mo[0].cancels += 1; }
  k[0].aimed_x = px; k[0].aimed_z = pz;
  ay := s[0].you_y + 1.0;
  if !e2n_open(s[0].net[..]) { _ := deed_answer(k[0].deeds[..], seq, false, tick, 0); return false; }
  k[0].ask = E2kAsk.{seq = seq, slot = i, wire = k[0].wire[i], face = face, net_seq = e2n_cast_next(s[0].net[..])};
  k[0].cool_at = now; k[0].used = i; k[0].pressed += 1;
  // a bow's Attack is its arrow: loosed here now, and the room told of its launch under the same number
  if xc_kit(k[0].klass) == XC_KIT_BOW && k[0].bar[i].kind == FB_ATTACK { _ := e2bw_loose(s, k[0].ask.net_seq); }
  _ := e2n_cast(s[0].net[..], k[0].wire[i], px, ay, pz);
  e2k_predict(s, i, face, px, ay, pz);
  return true;
}
// The room took your cast (its e cast for your seat): what your press began is confirmed, and its
// arrow stays. A word that comes after this page gave up on it (1.5 s) and took it back plays it now,
// from where you stand, at the room's aim and seed: it did happen.
e2k_taken :: (s: [] E2, e: E2nCast) {
  k := s[0].casts[..];
  if deed_answer(k[0].deeds[..], k[0].ask.seq, true, deed_tick(s[0].clock), 0) >= 0 { e2bw_taken(s, k[0].ask.net_seq); return; }
  if !k[0].ask.rolled || !k[0].ask.replay || k[0].ask.wire != e.slot { return; }
  k[0].ask.rolled = false; k[0].ask.replay = false;
  c := xk_slot_class(e.slot);
  if c < 0 { c = k[0].klass; }
  _ := e2k_play(s, c, e.slot, s[0].you_x, s[0].you_y, s[0].you_z, k[0].ask.face, e.ax, e.ay, e.az, e.seed, k[0].me[..], true);
}

// The frame's casts: the others' the picture has reached, played where they are drawn; the sounds
// waiting; then the effects for the host, round the eye.
e2k_step :: (s: [] E2) {
  k := s[0].casts[..]; n := s[0].net[..];
  now := s[0].clock;
  if n[0].familiar_heal_cue {
    n[0].familiar_heal_cue=false;
    own:=n[0].seat;
    if own>=0 && own<E2N_FAMILIARS && n[0].familiar_rows[own].live {
      f:=n[0].familiar_rows[own];
      cue:=xc_sound(fb_spell(SP_CURE_WOUNDS,1,FB_ALLY),FB_CL_DRUID);
      e2k_cue(s,cue.start,f32(E2K_GAIN_START),f.x,f.z,cue.rate);
    }
  }
  // the room turned your last cast down before it spent anything (eg_e2_cast is all or nothing): what
  // your press showed is taken back, its slot greys, and the cooldown is lifted, so the bar is yours
  // again at once
  tick := deed_tick(now);
  if n[0].cast_refused != k[0].refused_seen {
    k[0].refused_seen = n[0].cast_refused; k[0].cool_at = -100;
    if deed_waiting(k[0].deeds[0], k[0].ask.seq) { _ := deed_answer(k[0].deeds[..], k[0].ask.seq, false, tick, 0); e2k_undo(s); }
  }
  // the room took it: what is playing is confirmed
  if n[0].cast_mine != k[0].mine_heard { k[0].mine_heard = n[0].cast_mine; e2k_taken(s, n[0].mine_cast); }
  // no word in 1.5 s (the room is gone, or the request was lost): taken back as a refusal is
  expired := k[0].deeds[0].expired;
  deed_expire(k[0].deeds[..], tick);
  if k[0].deeds[0].expired != expired { e2k_undo(s); k[0].ask.replay = true; }
  e2k_lock_step(s);
  while true {
    e := e2n_cast_due(n, n[0].rt);
    if !e.live { break; }
    r := e2n_remote_seat(n, e.ss);
    if !r.ok { k[0].unseen += 1; continue; }   // not drawn here (gone, or beyond what this page holds)
    c := xk_slot_class(e.slot);
    y := e2_height(r.x, r.z) + r.y;
    dx := e.ax - r.x; dz := e.az - r.z;
    face := ifx dx * dx + dz * dz > 0.09 then figs.atan2(dx, dz) else r.yaw;
    if e2k_play(s, c, e.slot, r.x, y, r.z, face, e.ax, e.ay, e.az, e.seed, k[0].them[r.slot..<r.slot + 1], false) > 0 { k[0].others += 1; }
  }
  for i: 0..<E2K_LATER {
    l := k[0].later[i];
    if l.on && now >= l.t { k[0].later[i].on = false; e2k_cue(s, l.name, f32(E2K_GAIN_MISS), l.x, l.z, l.rate); }
  }
  pf := k[0].puffs[..];
  fxp_begin(pf, now, fxp_v(s[0].eye[0], s[0].eye[1], s[0].eye[2]));
  // every live effect's puffs (fxp_emit_all), a refused one's dimmed and drawn in as it fades
  for q: 0..<FX_LIVE {
    if !pf[0].on[q] { continue; }
    o := pf[0].live[q];
    if now < o.t0 { continue; }
    from := pf[0].n;
    fxp_emit(pf, o, now - o.t0);
    f := e2k_shown(k, q, o.t0, now);
    if f >= 1 { continue; }
    for j: from..<pf[0].n {
      a := j * FX_PUFF_FLOATS;
      pf[0].stage[a + 3] *= 0.6 + 0.4 * f;
      for c: 4..<8 { pf[0].stage[a + c] *= f; }
    }
    if f <= 0 { pf[0].on[q] = false; }
  }
  e2bw_puffs(s, pf);   // the arrows in the air and stuck (everglade/client/arrows.coax)
  _ := fxp_close(pf);
}

// A body's cast or blow over its gait (everglade/scene/bodies.coax bd_layer): standing it takes the whole
// body; on the move only the upper body, the walk or run keeping the hips and legs. It eases in and
// out over BD_LAYER_FADE, so nothing pops. A remote's gait comes from its own motion and its act from
// the wire, so others see the same layered pose.
e2k_figure :: (a0: figs.BdAnim, act: E2kAct, clock: f32) -> figs.BdAnim {
  if act.clip < 0 || a0.clip < 0 { return a0; }
  d := figs.bd_seconds(act.clip); t := clock - act.at;
  if t < 0 || t >= d { return a0; }
  return figs.bd_layer(a0, act.clip, act.at, t / d, figs.bd_layer_weight(t, d), clock);
}
#test "a cast on the run keeps the run's legs; standing it takes the whole body" {
  run: figs.BdAnim; run.clip = figs.BD_RUN; run.x = 3; run.yaw = 1.2;
  act := E2kAct.{at = 10, clip = figs.BD_SPELL};
  a := e2k_figure(run, act, 10.5);
  #assert a.clip == figs.BD_SPELL && a.prev == figs.BD_RUN && a.lay && a.lay_up == 0 && a.lay_low == 1 && a.x == 3 && a.yaw == 1.2;
  idle: figs.BdAnim; idle.clip = figs.BD_IDLE;
  b := e2k_figure(idle, act, 10.5); #assert b.lay_up == 0 && b.lay_low == 0;
  // it eases in and out over BD_LAYER_FADE
  c := e2k_figure(run, act, 10.05); #assert c.lay_up > 0 && c.lay_up < 1;
  #assert !e2k_figure(run, act, 9.9).lay && !e2k_figure(run, act, 10 + figs.bd_seconds(figs.BD_SPELL)).lay;
  m := E2kAct.{at = 10, clip = figs.BD_SLASH};
  #assert e2k_figure(run, m, 10.4).lay_low == 1 && e2k_figure(run, m, 10.4).prev == figs.BD_RUN;
}

// ---- the bar: each slot's picture, its key, its cooldown; a card over the slot the pointer is on
e2k_box :: (k: [] E2Cast, i: int, w: f32, h: f32, kk: f32) -> [4] f32 { return xc_slot_at(k[0].bar_n, i, w, h, kk); }
// A slot's card: 358x171 CSS px over its slot, kept 12 px inside the page, its foot over the slot and over
// the bar's emblem (everglade/hud/parts.coax eg_bar_frame: 32 px over the top row).
e2k_card_box :: (k: [] E2Cast, i: int, w: f32, h: f32, kk: f32) -> [4] f32 {
  boxes: [XC_SLOTS * 4] f32;
  for j: 0..<k[0].bar_n { b := e2k_box(k, j, w, h, kk); for q: 0..<4 { boxes[j * 4 + q] = b[q]; } }
  return eg_slot_card(boxes[..], k[0].bar_n, i, w, kk);   // everglade/hud/windows.coax
}
e2k_put :: (m: [] u8, at: int, t: string) -> int { n := at; for ch: t { if n < m.count { m[n] = ch; n += 1; } } return n; }
e2k_int :: (m: [] u8, at: int, v: int) -> int {
  n := at; x := v; if x < 0 { n = e2k_put(m, n, "-"); x = -x; }
  d: [12] u8; c := 0; while true { d[c] = cast(u8)('0' + x % 10); c += 1; x /= 10; if x == 0 { break; } }
  while c > 0 { c -= 1; if n < m.count { m[n] = d[c]; n += 1; } }
  return n;
}
// One media line, when it fits whole: WHAT URL X0 Y0 X1 Y1, then TAIL (an "over"'s fade and share).
e2k_media :: (s: [] E2, what: string, url: string, art: string, size: string, b: [4] f32, tail: string) {
  m := s[0].media[..]; n := s[0].media_n;
  if n + what.count + url.count + art.count + size.count + tail.count + 64 > m.count { return; }
  if n > 0 { m[n] = 10; n += 1; }
  n = e2k_put(m, n, what); n = e2k_put(m, n, " "); n = e2k_put(m, n, url); n = e2k_put(m, n, art); n = e2k_put(m, n, size);
  for q: 0..<4 { n = e2k_put(m, n, " "); n = e2k_int(m, n, cast(int) floor(b[q] + 0.5)); }
  n = e2k_put(m, n, tail);
  s[0].media_n = n;
}
// The bar: Everglade's iron round the slots (everglade/hud/parts.coax eg_bar_frame), each slot's
// picture with its grey and its cooling (the page's pictures), the marks over it (everglade/hud/
// windows.coax eg_slot_marks), the card of the one under the pointer (eg_slot_card), the open class
// menu under your portrait and a refusal over the emblem (eg_bar_refused).
e2k_bar_draw :: (s: [] E2, out: [] f32, at: int) -> int {
  n := at;
  if !e2k_on(s) { return n; }
  k := s[0].casts[..]; w := s[0].width; h := s[0].height; kk := s[0].k;
  now := s[0].clock;
  size := ifx kk > 1.4 then "-128.jpg" else "-72.jpg";
  left := f32(XC_COOL) - (now - k[0].cool_at);
  tick := deed_tick(now); bar_dim := deed_bar_dim(e2k_bearing(s));
  boxes: [XC_SLOTS * 4] f32;
  for i: 0..<k[0].bar_n { b := e2k_box(k, i, w, h, kk); for q: 0..<4 { boxes[i * 4 + q] = b[q]; } }
  ui := s[0].creator[0].ui; tray := cc.uit_next(ui);   // the layout trace (#13076): the tray, its slots after it (eg_bar_slot_at)
  n = cc.eg_bar_frame(ui, out, n, boxes[..], k[0].bar_n, kk, E2C_CLASS_TITLES[e2c_class_of(s)][0], 1);
  for i: 0..<k[0].bar_n {
    b := e2k_box(k, i, w, h, kk);
    a := k[0].bar[i]; art := xc_art(a, i);
    e2k_media(s, "image", xc_url(art), art, size, b, "");
    // refused, or held by your conditions: the slot greys (#13072), no words
    grey := deed_look(k[0].deeds[0], i, tick, 0).grey; if bar_dim > grey { grey = bar_dim; }
    if grey > 0 {
      tail: [24] u8; tn := e2k_put(tail[..], 0, " "); tn = e2k_int(tail[..], tn, cast(int)(100 - 65 * grey)); tn = e2k_put(tail[..], tn, " 0 1000");
      e2k_media(s, "over", xc_url(art), art, size, b, cast(string) tail[0..<tn]);
    }
    // the wait as a sweep on the picture (everglade/hud/parts.coax eg_slot_sweep)
    if left > 0 { n = cc.eg_slot_sweep(out, n, b[..], left / f32(XC_COOL), kk); }
    // the room's count for it (slots at its level, uses, Rages, Focus) and a gold frame while its
    // effect holds (a Rage, Wild Shape's form): the room's word only (#13046)
    kit := e2n_slot(s[0].net[..], i, k[0].bar_n);
    m: EgSlotMarks;
    if i < 9 && xc_draw_slot_key(i, art) { m.key = cast(u8)(49 + i); }
    m.used = i == k[0].used && left > 0;
    if kit.ok && kit.left >= 0 { m.count = kit.left; }
    m.held = kit.ok && kit.on;
    n = eg_slot_marks(ui, cc.eg_bar_slot_at(ui, tray, i), out, n, b[..], m, kk);
  }
  // the class resource bar (Rages, Focus) over the tray, from the room's counts (everglade/hud/class-resource.coax)
  lefts: [XC_SLOTS] int; ons: [XC_SLOTS] bool;
  for i: 0..<k[0].bar_n { w2 := e2n_slot(s[0].net[..], i, k[0].bar_n); lefts[i] = ifx w2.ok then w2.left else -1; ons[i] = w2.ok && w2.on; }
  res := eg_resource_of(fb_cl_hero(e2c_class_of(s), "You", 0, e2c_level_of(s)), k[0].bar[..], k[0].bar_n, lefts[..], ons[..]);
  if k[0].bar_n > 0 {
    top := h; for i: 0..<k[0].bar_n { b := e2k_box(k, i, w, h, kk); if b[1] < top { top = b[1]; } }
    n = eg_resource_draw(ui, out, n, res, w / 2, top - 22 * kk, 160 * kk, kk);
  }
  if k[0].hover >= 0 && k[0].hover < k[0].bar_n {
    a := k[0].bar[k[0].hover]; c := e2k_card_box(k, k[0].hover, w, h, kk);
    e2k_media(s, "over", xc_url(a.art), a.art, "-card-2x.jpg", c, "");
    cc.uit_add(ui, cc.UIT_NONE, cc.UIT_PANEL, c[0], c[1], c[2], c[3], "card");
  }
  // your health and what holds you are on the portrait plate (everglade/client/client.coax e2_world_view, everglade/hud/parts.coax eg_world)
  // Healer's Kit, the companion and rest: the menus your portrait opens (nothing of them over the bar)
  n = e2k_side_bar(s, out, n);
  refused := e2n_rest_message(s[0].net[..]);   // a refused cast greys its slot instead (#13072)
  if refused.count == 0 { refused = e2n_aid_message(s[0].net[..]); }
  if refused.count == 0 { refused = e2n_familiar_message(s[0].net[..]); }
  if refused.count == 0 { refused = e2n_full_message(s[0].net[..]); }   // the room you asked was full, and where you went (#13263)
  // over the bar's emblem (the class's initial: its name is on the portrait plate)
  return eg_bar_refused(ui, out, n, refused, w * 0.5, ifx refused.count > 0 then e2k_bar_top(s) else 0.0f32, kk);
}

// ---- input: 1 to 9 press the bar's slots; the pointer presses a slot or shows its card
e2k_key :: (s: [] E2, key: int) -> bool {
  if !e2k_on(s) || key < '1' || key > '9' { return false; }
  i := key - '1';
  if i >= s[0].casts[0].bar_n { return false; }
  _ := e2k_press(s, i);
  return true;
}
e2k_slot_at :: (s: [] E2, x: f32, y: f32) -> int {
  k := s[0].casts[..];
  for i: 0..<k[0].bar_n { b := e2k_box(k, i, s[0].width, s[0].height, s[0].k); if x >= b[0] && x <= b[2] && y >= b[1] && y <= b[3] { return i; } }
  return -1;
}
e2k_pointer :: (s: [] E2, x: f32, y: f32, phase: int) -> bool {
  if !e2k_on(s) { return false; }
  if e2k_side_pointer(s, x, y, phase) { return true; }
  i := e2k_slot_at(s, x, y);
  s[0].casts[0].hover = i;
  if i < 0 || phase != 0 { return false; }   // a move over it shows its card and leaves the look's drag be
  _ := e2k_press(s, i);
  return true;
}

// The latest server health, independent of movement-input acknowledgements: your Hit Points, your
// rest, then what holds you in the shared condition display's words (aethyr/rules/srd/condition-display.coax).
e2k_vitals_text :: (s:[] E2,out:[] u8)->int {
  row:=e2n_vitals(s[0].net[..]); if row.id<0 { return 0; }
  n:=e2k_put(out,0,"HP "); n=e2k_int(out,n,row.hp); n=e2k_put(out,n,"/"); n=e2k_int(out,n,row.max);
  if row.temp>0 { n=e2k_put(out,n," · TEMP "); n=e2k_int(out,n,row.temp); }
  if row.hp==0 { n=e2k_put(out,n,ifx (row.g&WG_DEAD)!=0 then " · DEAD" else " · UNCONSCIOUS"); }
  net:=s[0].net[..];
  if row.hp>0 && net[0].rest_known {
    code:=net[0].rest_code;
    if code==WIRE_REST_SHORT { n=e2k_put(out,n," · SHORT REST"); }
    if code==WIRE_REST_CHOOSE { n=e2k_put(out,n," · HIT DICE "); n=e2k_int(out,n,net[0].rest_dice); }
    if code==WIRE_REST_SLEEP { n=e2k_put(out,n," · ASLEEP"); }
    if code==WIRE_REST_WATCH { n=e2k_put(out,n," · ON WATCH"); }
    if code==WIRE_REST_EXERT { n=e2k_put(out,n," · ON THE MOVE"); }
    if code==WIRE_REST_BROKEN { n=e2k_put(out,n," · REST BROKEN"); }
  }
  // Unconscious is said above, at 0 HP or asleep
  asleep:=row.hp>0 && net[0].rest_known && net[0].rest_code==WIRE_REST_SLEEP;
  return cd_held_text(out,n,row.cond,ifx row.hp==0 || asleep then RS_UNCONSCIOUS else 0,true);
}
E2K_HEALTH :: CD_TEXT + 64;   // bytes: the numbers and rest, then every condition and effect at once
// the room's effect bits (everglade-wire.coax WC_*) are the shared display's (CD_*)
#test "Everglade II's rows carry the shared display's effect bits" { #assert WC_HALTED == CD_HALTED && WC_SLOWED == CD_SLOWED && WC_BOUND == CD_BOUND && WC_BANED == CD_BANED && WC_ENFEEBLED == CD_ENFEEBLED && WC_HEXED == CD_HEXED && WC_BLESSED == CD_BLESSED && WC_FAITH == CD_FAITH; }

// ---- rest (#13046): the choices the room's rest allows now, in REST's menu, which your portrait opens; the room decides each
// The rest requests (RS_REST_*) shown now, into out: none until the room has said your rest.
e2k_rest_choices :: (s: [] E2, out: [] int) -> int {
  n := s[0].net[..];
  if !e2k_on(s) || !e2n_open(n) || !n[0].rest_known || out.count < 4 { return 0; }
  row := e2n_vitals(n); if row.id < 0 || row.hp <= 0 { return 0; }
  c := n[0].rest_code;
  if c == WIRE_REST_NONE { out[0] = RS_REST_SHORT; out[1] = RS_REST_SLEEP; return 2; }
  if c == WIRE_REST_SHORT { out[0] = RS_REST_END; return 1; }
  if c == WIRE_REST_CHOOSE { if n[0].rest_dice > 0 { out[0] = RS_REST_DIE; out[1] = RS_REST_END; return 2; } out[0] = RS_REST_END; return 1; }
  if c == WIRE_REST_SLEEP { out[0] = RS_REST_WATCH; out[1] = RS_REST_END; return 2; }
  if c == WIRE_REST_WATCH || c == WIRE_REST_EXERT { out[0] = RS_REST_SLEEP; out[1] = RS_REST_END; return 2; }
  if c == WIRE_REST_BROKEN { out[0] = RS_REST_SLEEP; out[1] = RS_REST_WATCH; out[2] = RS_REST_END; return 3; }
  return 0;
}
e2k_rest_label :: (s: [] E2, req: int) -> string { return eg_rest_label(req, s[0].net[0].rest_known && s[0].net[0].rest_code != WIRE_REST_NONE); }


// Keep the kit separate from the changing rest buttons.
e2k_aid_on :: (s:[] E2)->bool {
  return e2n_open(s[0].net[..]) && e2n_vitals(s[0].net[..]).hp>0;
}

e2k_familiar_on :: (s:[]E2)->bool {
  return e2k_aid_on(s) && (s[0].net[0].klass==FB_CL_WIZARD || (s[0].net[0].klass==FB_CL_DRUID && s[0].net[0].level>=2));
}

e2k_familiar_heal_target :: (s:[]E2)->int {
  n:=s[0].net[..]; own:=n[0].seat;
  if own<0 || own>=E2N_FAMILIARS || !n[0].familiar_rows[own].live { return -1; }
  f:=n[0].familiar_rows[own];
  best:=-1; nearest:=12.0f32;
  for target:0..<E2N_FAMILIARS {
    row:=wire_mirror_of(n[0].mir[..],target);
    if row.id!=target || row.kind!=WK_PLAYER || (row.g&WG_DEAD)!=0 || row.hp<0 || row.hp>=row.max { continue; }
    x:=s[0].you_x; z:=s[0].you_z;
    if target!=own {
      remote:=e2n_remote_seat(n,target);
      if !remote.ok { continue; }
      x=remote.x; z=remote.z;
    }
    dx:=x-f.x; dz:=z-f.z; d:=dx*dx+dz*dz;
    if d<nearest { nearest=d; best=target; }
  }
  return best;
}

// ---- the class menus under your portrait (zone wiring): Everglade's class features and rest (the
// game's everglade/hud/class-bar.coax) drawn with the engine's widgets (aethyr/ui/hud-menu.coax), from
// what this zone's room said; a press sends the room its request. Nothing of them is over the bar.
e2k_facts :: (s: [] E2) -> EgBarFacts {
  f: EgBarFacts; net := s[0].net[..];
  f.kit = e2k_aid_on(s); f.aid_left = net[0].aid_left;
  f.pet = e2k_familiar_on(s); f.wizard = net[0].klass == FB_CL_WIZARD; f.druid = net[0].klass == FB_CL_DRUID;
  f.form = rs_monster_block(RS_FAMILIAR_FORMS[net[0].familiar_form]).name; f.spirit = net[0].familiar_spirit - RS_FAMILIAR_FEY; f.paid_slot = net[0].familiar_slot != 0;
  f.rest_n = e2k_rest_choices(s, f.rest[..]); f.resting = net[0].rest_known && net[0].rest_code != WIRE_REST_NONE;
  return f;
}
// The top of this zone's bar's first slot (device px): what sits over the bar starts above it.
e2k_bar_top :: (s: [] E2) -> f32 { return e2k_box(s[0].casts[..], 0, s[0].width, s[0].height, s[0].k)[1]; }
// Everglade's class menus (everglade/hud/class-bar.coax) under your portrait plate (everglade/hud/parts.coax
// eg_world_portrait), down to this zone's bar at most, with this zone's facts.
e2k_side_geo :: (s: [] E2) -> EgSideGeo { kk := s[0].k; return eg_side_geo(e2k_facts(s), s[0].width, s[0].height, kk, cc.eg_world_portrait(s[0].width, s[0].height, kk), e2k_bar_top(s) - 8 * kk); }
e2k_side_st :: (s: [] E2) -> EgSideState { k := s[0].casts[0]; return EgSideState.{menu = k.menu, side_hover = k.side_hover, menu_hover = k.menu_hover}; }
e2k_rect :: (b: cc.HudPrim) -> [4] f32 { return [4] f32.[b.x0, b.y0, b.x1, b.y1]; }
e2k_side_h :: (s: [] E2) -> f32 { return eg_side_h(s[0].width, s[0].height, s[0].k); }
e2k_side :: (s: [] E2, ids: [] int) -> int { return eg_side_items(e2k_facts(s), ids); }
e2k_side_find :: (s: [] E2, id: int) -> int { return eg_side_find(e2k_side_geo(s), id); }
e2k_menu_rows :: (s: [] E2, id: int, rows: [] int) -> int { return eg_menu_rows(e2k_facts(s), id, rows); }
e2k_menu_panel :: (s: [] E2, id: int) -> [4] f32 { return e2k_rect(eg_menu_of(e2k_facts(s), e2k_side_geo(s), id).panel); }
e2k_menu_box :: (s: [] E2, id: int, r: int) -> [4] f32 { rows: [EG_MENU_ROWS] int; if r < 0 || r >= e2k_menu_rows(s, id, rows[..]) { return [4] f32.[0, 0, 0, 0]; } return e2k_rect(cc.hud_menu_row(eg_menu_of(e2k_facts(s), e2k_side_geo(s), id), r)); }
// The centres a check presses. Toward item id's menu ([-1, -1] when the room doesn't offer it): your
// portrait, or with the portrait's own menu open, id's row in it. And action a's row in id's menu.
e2k_side_centre :: (s: [] E2, id: int) -> [2] f32 {
  g := e2k_side_geo(s); if eg_side_find(g, id) < 0 { return [2] f32.[-1, -1]; }
  if s[0].casts[0].menu == EG_SIDE_ROOT { return e2k_menu_centre(s, EG_SIDE_ROOT, ifx id == EG_SIDE_KIT then EG_DO_KIT else EG_DO_OPEN + id); }
  return [2] f32.[(g.anchor.x0 + g.anchor.x1) * 0.5, (g.anchor.y0 + g.anchor.y1) * 0.5];
}
// For the checks: press toward item id until its menu is open (the kit: until its row is pressed).
e2k_side_open :: (s: [] E2, id: int) -> bool {
  for step: 0..<2 {
    if id != EG_SIDE_KIT && s[0].casts[0].menu == id { return true; }
    c := e2k_side_centre(s, id); if !(c[0] > 0) { return false; }
    kit_row := id == EG_SIDE_KIT && s[0].casts[0].menu == EG_SIDE_ROOT;
    if !e2_pointer(s, c[0], c[1], 0, 0, 1) { return false; }
    if kit_row { return true; }
  }
  return id != EG_SIDE_KIT && s[0].casts[0].menu == id;
}
e2k_menu_centre :: (s: [] E2, id: int, a: int) -> [2] f32 {
  rows: [EG_MENU_ROWS] int; m := e2k_menu_rows(s, id, rows[..]);
  for r: 0..<m { if rows[r] == a { b := e2k_menu_box(s, id, r); return [2] f32.[(b[0] + b[2]) * 0.5, (b[1] + b[3]) * 0.5]; } }
  return [2] f32.[-1, -1];
}
// A row pressed: asks the room, or changes what the next summons asks for.
e2k_menu_do :: (s: [] E2, a: int) {
  net := s[0].net[..];
  if a == EG_DO_FORM { net[0].familiar_form = (net[0].familiar_form + 1) % RS_FAMILIAR_FORMS.count; return; }
  if a == EG_DO_SPIRIT { net[0].familiar_spirit = RS_FAMILIAR_FEY + (net[0].familiar_spirit - RS_FAMILIAR_FEY + 1) % 3; return; }
  if a == EG_DO_PAY { net[0].familiar_slot = 1 - net[0].familiar_slot; return; }
  if a == EG_DO_SUMMON { _ := e2n_familiar(net); return; }
  if a == EG_DO_CURE { _ := e2n_familiar_heal(net, e2k_familiar_heal_target(s)); return; }
  if a > EG_DO_ORDER && a <= EG_DO_ORDER + 6 { _ := e2n_familiar_order(net, a - EG_DO_ORDER); return; }
  reqs: [4] int; c := e2k_rest_choices(s, reqs[..]); j := a - EG_DO_REST;
  if j >= 0 && j < c { _ := e2n_rest(net, reqs[j]); }
}
e2k_side_pointer :: (s: [] E2, x: f32, y: f32, phase: int) -> bool {
  p := eg_side_press(e2k_facts(s), e2k_side_geo(s), e2k_side_st(s), x, y, phase);
  k := s[0].casts[..]; k[0].menu = p.st.menu; k[0].side_hover = p.st.side_hover; k[0].menu_hover = p.st.menu_hover;
  if p.act == EG_DO_KIT { _ := e2n_aid(s[0].net[..]); } else if p.act > 0 { e2k_menu_do(s, p.act); }
  return p.taken;
}
e2k_side_bar :: (s: [] E2, out: [] f32, at: int) -> int {
  g := e2k_side_geo(s); k := s[0].casts[..]; if k[0].menu >= 0 && !eg_menu_on(g, k[0].menu) { k[0].menu = -1; }
  return eg_side_draw(s[0].creator[0].ui, e2k_facts(s), g, e2k_side_st(s), out, at);
}
