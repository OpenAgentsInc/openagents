// How a class kit's ability looks and where its bar's slots sit (#13025, #13058): the effect a cast
// starts (aethyr/fx/puff.coax recipes, Everglade's looks: everglade-classes.coax cl_look) in its
// spell's colour (aethyr/fx/spell-light.coax), and the bar's boxes along the bottom of the screen.
// Everglade Experimental (experimental-combat.coax) and Everglade II (everglade/client/cast.coax) draw the
// same; what each ability is, how it aims and sounds is class-kit.coax's.
//   coax/bin/coax test everglade/client/class-look.coax
#load "../shared/class-kit.coax";
#load "../../aethyr/fx/puff.coax";
#load "../../aethyr/fx/spell-light.coax";   // each spell's colour

// A cast's look: the recipe, from the hand to where it lands (or round you), its colour and its reach;
// glimmer, a second cause on it (Guiding Bolt's glow).
XcLook :: struct { recipe: int; from: FxV; to: FxV; col: FxV; reach: f32 = 1; glimmer: bool; }
// Ability a's look for a caster whose feet are (px, py, pz), facing `face` (you face atan2(x, z)), at
// `at`: where it lands, ahead of you (a bolt's full range when it meets no one) or on the one struck.
xc_look_of :: (a: FbAb, px: f32, py: f32, pz: f32, face: f32, at: FxV) -> XcLook {
  hand := fxp_v(px + cos(face) * 0.3, py + 1.3, pz - sin(face) * 0.3);
  me := fxp_v(px, py + 1.0, pz);
  gold := fxp_v(1.0, 0.78, 0.4);
  col := ifx a.kind == FB_SPELL then fxl_spell_rgb(a.sp) else gold;
  r := FXR_HIT; to := at; reach := 1.0f32;
  if a.kind == FB_SPELL {
    sp := a.sp;
    if sp == SP_FIRE_BOLT || sp == SP_FLAME_HURL { r = FXR_FIREBOLT; }
    else if sp == SP_ELDRITCH_BLAST { r = FXR_ELDRITCH; }
    else if sp == SP_STARRY_WISP { r = FXR_STAR; }
    else if sp == SP_SACRED_FLAME { r = FXR_COLUMN; }
    else if sp == SP_VICIOUS_MOCKERY { r = FXR_MOCKERY; }
    else if sp == SP_HEX || sp == SP_HUNTERS_MARK { r = FXR_MARK; }
    else if sp == SP_DIVINE_SMITE { r = FXR_SMITE; }
    else if sp == SP_HEALING_WORD || sp == SP_LESSER_RESTORATION || sp == SP_AID || sp == SP_GUIDANCE { r = FXR_HEAL; to = me; }
    else if sp == SP_REVIVIFY { r = FXR_HEAL; }
    else if sp == SP_FALSE_LIFE { r = FXR_DRAIN; to = me; }
    else if sp == SP_THUNDERWAVE { r = FXR_SHOCK; to = fxp_v(px + sin(face) * 2.286, py + 1.0, pz + cos(face) * 2.286); reach = 2.286; }
    else if sp == SP_ENTANGLE { r = FXR_BLOOM; reach = 3; }
    // the 5E Lab's own looks (fivelab.coax fx_event), sized to the SRD areas
    else if sp == SP_FIREBALL { r = FXR_FIREBALL; reach = 6.096; }                // a 20-foot radius
    else if sp == SP_HYPNOTIC_PATTERN { r = FXR_SHIMMER; reach = 4.572; }         // a 30-foot Cube
    else if sp==SP_ZONE_OF_TRUTH { r=FXR_SHIMMER; reach=4.572; }
    else if sp == SP_CALL_LIGHTNING || sp == SP_CALL_BOLT { r = FXR_LIGHTNING; reach = 1.524; }   // within 5 feet of the point
    else if sp == SP_SPIRIT_GUARDIANS { r = FXR_ORBIT; to = fxp_v(px, py, pz); reach = 4.572; }   // a 15-foot Emanation
    else if sp == SP_HOLD_PERSON { r = FXR_BIND; }
    else if sp == SP_BLINDNESS { r = FXR_VEIL; }
    else if sp == SP_SHIELD || sp==SP_PROTECTION_GOOD_EVIL { r = FXR_BARRIER; to = fxp_v(px, py, pz); }
    else { r = FXR_STREAK; }   // Chill Touch, Ray of Sickness, Guiding Bolt
  }
  else if a.kind == FB_RAGE { r = FXR_EMBERS; to = me; }
  else if a.kind == FB_SECOND { r = FXR_BREATH; to = me; }
  else if a.kind == FB_LAY { r = FXR_LAY; to = me; }
  else if a.kind == FB_INNATE { r = FXR_ARCANE; to = me; }
  else if a.name == "Sneak Attack" { r = FXR_SHADOW_SLASH; }
  // a burst of movement shows where it starts (#13072: Dash plays its feel, never nothing)
  else if a.kind == FB_DASH { r = FXR_DUST; to = fxp_v(px, py + 0.2, pz); }
  else if a.kind == FB_CDASH { r = FXR_AFTERIMAGE; to = me; }
  else if a.kind == FB_WIND || a.kind == FB_PATIENT { r = FXR_WIND; to = me; reach = ifx a.kind == FB_WIND then 2.0f32 else 1.0f32; }
  else if a.kind == FB_AIM { r = FXR_RETICLE; }
  return XcLook.{recipe = r, from = hand, to = to, col = col, reach = reach, glimmer = a.kind == FB_SPELL && a.sp == SP_GUIDING_BOLT};
}
// Look l started at `now` into p, from `seed` (the wire's for another's cast, so every page draws it
// alike). The causes started (0 when the effects' budget is full).
xc_look_start :: (p: [] FxPuffs, l: XcLook, now: f32, seed: f32) -> int {
  n := 0;
  if fxp_start(p, FxCause.{recipe = l.recipe, seed = seed + f32(l.recipe), t0 = now, from = l.from, to = l.to, col = l.col, big = 1, reach = l.reach}, now) >= 0 { n += 1; }
  if l.glimmer && fxp_start(p, FxCause.{recipe = FXR_GLIMMER, seed = seed + f32(FXR_GLIMMER), t0 = now, from = l.from, to = l.to, col = l.col, big = 1, reach = 1}, now) >= 0 { n += 1; }
  return n;
}

// ---- the bar, CSS px: slots of XC_SLOT, XC_STEP apart, nine a row (fewer when the page is narrower:
// a phone's six), XC_BOTTOM up from the bottom
XC_SLOT :: 52.0; XC_STEP :: 60.0; XC_BOTTOM :: 30.0; XC_EDGE :: 8.0;
// Slots a row holds on a page w device px wide at scale k, XC_EDGE clear of each side.
xc_slot_row :: (w: f32, k: f32) -> int {
  fit := cast(int) floor((w / k - 2 * f32(XC_EDGE) + (f32(XC_STEP) - f32(XC_SLOT))) / f32(XC_STEP));
  return ifx fit > 9 then 9 else ifx fit < 1 then 1 else fit;
}
// Slot i of a bar of bar_n on a w by h screen at scale k: x0, y0, x1, y1 in device px.
xc_slot_at :: (bar_n: int, i: int, w: f32, h: f32, k: f32) -> [4] f32 {
  per := xc_slot_row(w, k);
  rows := (bar_n + per - 1) / per; row := i / per; count := rs_min(per, bar_n - row * per);
  wide := f32(count) * f32(XC_STEP) - (f32(XC_STEP) - f32(XC_SLOT));
  x0 := (w - wide * k) / 2 + f32(i % per) * f32(XC_STEP) * k;
  y0 := h - (f32(XC_SLOT) + f32(XC_BOTTOM) + f32(rows - row - 1) * f32(XC_STEP)) * k;
  return [4] f32.[x0, y0, x0 + f32(XC_SLOT) * k, y0 + f32(XC_SLOT) * k];
}

#test "class looks: a bolt flies from the hand to where it lands, a heal rises round you, a cube is set ahead" #steps 400000000 {
  at := fxp_v(0, 1, 30);
  b := xc_look_of(fb_spell(SP_FIRE_BOLT, 0, FB_FOE), 0, 0, 0, 0, at);
  #assert b.recipe == FXR_FIREBOLT && b.to.z == 30 && abs(b.from.y - 1.3) < 0.001 && b.col.x == 1.0;
  h := xc_look_of(fb_spell(SP_HEALING_WORD, 1, FB_ALLY), 2, 0, 3, 0, at); #assert h.recipe == FXR_HEAL && h.to.x == 2 && h.to.z == 3;
  t := xc_look_of(fb_spell(SP_THUNDERWAVE, 1, FB_POINT), 0, 0, 0, 1.5707963, at); #assert t.recipe == FXR_SHOCK && abs(t.to.x - 2.286) < 0.01 && t.reach > 2;
  g := xc_look_of(fb_spell(SP_GUIDING_BOLT, 1, FB_FOE), 0, 0, 0, 0, at); #assert g.glimmer && g.recipe == FXR_STREAK;
  // every kit spell with a look of its own in the 5E Lab keeps it here
  #assert xc_look_of(fb_spell(SP_FIREBALL, 3, FB_POINT), 0, 0, 0, 0, at).recipe == FXR_FIREBALL;
  #assert xc_look_of(fb_spell(SP_HYPNOTIC_PATTERN, 3, FB_POINT), 0, 0, 0, 0, at).recipe == FXR_SHIMMER;
  #assert xc_look_of(fb_spell(SP_CALL_LIGHTNING, 3, FB_POINT), 0, 0, 0, 0, at).recipe == FXR_LIGHTNING;
  sg := xc_look_of(fb_spell(SP_SPIRIT_GUARDIANS, 3, FB_SELF), 2, 0, 3, 0, at); #assert sg.recipe == FXR_ORBIT && sg.to.x == 2 && sg.to.z == 3;
  #assert xc_look_of(fb_spell(SP_HOLD_PERSON, 2, FB_FOE), 0, 0, 0, 0, at).recipe == FXR_BIND;
  #assert xc_look_of(fb_spell(SP_BLINDNESS, 2, FB_FOE), 0, 0, 0, 0, at).recipe == FXR_VEIL;
  #assert xc_look_of(fb_spell(SP_SHIELD, 1, FB_SELF), 0, 0, 0, 0, at).recipe == FXR_BARRIER;
  p: [1] FxPuffs; #assert xc_look_start(p[..], g, 1, 7) == 2 && p[0].started == 2;
  s := xc_slot_at(5, 0, 1280, 720, 1); #assert s[2] - s[0] == 52 && s[3] == 720 - 30 && s[0] == (1280 - 292) / 2;
  // a phone's page: six a row, every slot on it
  #assert xc_slot_row(390 * 3, 3) == 6 && xc_slot_row(1920, 1) == 9;
  for i: 0..<12 { sb := xc_slot_at(12, i, 390 * 3, 844 * 3, 3); #assert sb[0] >= 8 * 3 && sb[2] <= (390 - 8) * 3 && sb[1] >= 0; }
}
