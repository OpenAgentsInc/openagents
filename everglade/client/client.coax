// Everglade v2, openagents.com/worlds/everglade2 (docs/metaverse/everglade2.md): Character Create's glade,
// one winding path out of it through dense woods, and a clearing at the path's end. You walk your own
// character (the one Character Create saved) on Everglade's controller and follow camera. Nothing
// else: no town, gate, people or HUD.
//
// The land is everglade/world/forest.coax, the planting everglade/world/plant.coax, the pack
// metaverse/tools/assets/everglade2_pack.coax, and the passes everglade/client/gpu/everglade2.coax. everglade2-face.c steps
// the controller (everglade-step.coax) as fivelab-face.c does; this unit says what is round you,
// where you may stand, and what is drawn.
#load "../scene/charactercreator.coax" as cc;
#load "../scene/bodies.coax" as figs;
#load "../shared/everglade-move-types.coax";
#load "../shared/move.coax";   // where you may stand, the trunks and rocks, the pace: the room steps the same (#13053)
#load "net.coax";    // the room: the others, your inputs and the server's word on you (#13054)
#load "class-look.coax";        // your class's bar, how it aims, looks and sounds: Everglade Experimental's (#13058)
#load "../sound.coax" as exsound;
#load "../hud/class-bar.coax";   // Everglade's class menus under your portrait: class features and rest, every zone's (the game)
#load "../hud/windows.coax";   // Everglade's HUD windows and marks: talk, the workbench, the bar's marks, the wedge (#13083)
#load "../hud/bag.coax";       // Everglade's bag, quest log and coin: the column under the map and the bag's window (#13381)
#load "../hud/class-resource.coax";   // Everglade's class resource bar: Rages, Focus (#13084)
#load "../hud/create.coax";    // Everglade's Character Create panel and the world's menu (#13083)
#load "sight.coax";   // ... from this zone's land, trunks, rocks and camp
#load "../../rules/srd/condition-display.coax";   // the conditions' words and icons, every zone's (#13082)
#load "cast.coax";   // the bar here, and everyone's casts through the room (#13058)
#load "guard.coax";  // the path's guard, as the room walks him
#load "creatures.coax";   // the wolves and the goblins, as the room moves them
#load "ride-view.coax";   // riding: E and X, the mounts drawn, a rider in the saddle (#13268)
#load "wild.coax";   // the glade's cat (everglade/creatures/cat.coax), and ?stage=cat
#load "npc.coax";    // Pansopher, the Golemancy trainer, and his talk (everglade/world/pansopher.coax)
#load "bench.coax";  // the Golemancer's Workbench beside him and its window (everglade/world/golem-bench.coax)
#load "speakers.coax";   // the Warden and the other speakers of the content tables, where their spawns are (#13381)
#load "bag.coax";    // your coin, quests and bag as the room holds them, worded from the content tables (#13381)
#load "../world/plant.coax";
#load "../world/field.coax";
#load "../world/ground.coax";   // the ground's admitted tiles, from the pack's record, and the canopy bake (#12995, #13059)
#load "../../metaverse-engine/core/quality.coax";
#load "../../metaverse-engine/render/cascades.coax";   // the key light's shadow tiles (#13016), as Everglade's
#load "create.coax";   // Character Create, in this world: /worlds/character-creator
#load "range.coax";    // the Archery Range, in this world: /worlds/archery-range (#13507)
#load "../../metaverse-engine/character/material.coax" as cmat;   // the characters' material table (#13012)
#load "cull.coax";   // what the host's instance cull reads each frame (#13050)
#load "../../metaverse-engine/render/frame-plan.coax";   // the frame's order, as words for the host (#13303)
#load "cell-view.coax";  // the world's cells as the frame reads them; the controller is everglade/client/cells.coax, in the step's unit (#13280)
#load "../world/cell-content.coax";   // a cell's content as the pack carries it: its planting put in and taken out, the ground's record (#13280)
#load "../../metaverse-engine/render/environment-frame.coax" as envf;   // the camera's resolved environment, a frame (#13066)
#load "../world/environment.coax";   // the world's places and their light (#13065)
#load "../../metaverse-engine/render/environment-debug.coax" as envd;   // ?light=VIEW: the developer's light views (#13067)
#load "../../metaverse-engine/cam/mouselook.coax" as mlook;   // the mouse looks round with no button held, as Neverwinter's
#load "../../metaverse-engine/cam/reticle.coax" as reticle;   // and its reticle, the one bow aim shares
#load "../../metaverse-engine/action/bow.coax" as bow;   // the Ranger's Longbow, drawn with the right button
#load "../../metaverse-engine/action/archery.coax" as arch;   // the archer's frame: the draw eases, comes due and shows on the body (engine)
#load "../longbow.coax";   // Everglade's Longbow: its sounds (game)
#load "class-feel.coax";        // every action's feel and the SRD conditions as a bearing (docs/metaverse/action-pipeline.md, #13072)
#load "cast-pose.coax";        // a cast's body clip and the bow's aim pose: Experimental's
#load "mouse.coax";  // the mouse buttons: the left casts, a Ranger's right draws
#load "../shared/archery.coax";   // this zone's ground and bodies for an arrow, the room's too (#13157)
#load "../../metaverse-engine/net/shots.coax";   // the room's word on each arrow (engine, #13157)
#load "arrows.coax";    // the arrows: yours drawn at once, everyone's the room's
#load "class-menu.coax";        // Experimental's CLASSES column, for admin mode
#load "admin.coax";  // admin mode: dev builds on this machine only, every call below in #if BUILD_DEBUG
#load "track.coax";  // what players do, as analytics.coax events (the face keeps the Track)
#load "stage.coax";  // ?stage=: the path and the empty clearing for film, the HUD off
#load "../../metaverse-engine/action/floats.coax" as fl;   // the numbers over whoever a blow struck, as Experimental's
#load "../../metaverse-engine/action/area-aim.coax" as aa;   // ground targeting for a placed area (Entangle's square)
#load "../../metaverse-engine/agent/drive.coax";   // the agent driver: entities by id, the HUD's widgets, world operations (#13095)
#load "drive.coax";   // ... wired to this world

E2_VERTEX_FLOATS :: 16;
E2_MAX_VERTICES :: 32768;     // strokes: the frame rate in the bottom right corner
E2_UNIFORM_FLOATS :: 316;     // 79 vec4s (everglade/client/gpu/everglade2.bindings)
E2_U_ENV :: 208;              // the camera's resolved environment, 27 vec4s (metaverse-engine/render/painterly.coax PAINT_ENV_U, env_gpu_pack)
E2_U_LIGHT_VIEW :: 51;        // the developer's light view (?light=, metaverse-engine/render/environment-debug.coax env_view_word): 0 the ordinary frame
E2_U_CASCADE :: 104;          // the key light's shadow tiles' rows (metaverse-engine/render/cascades.coax cascade_rows)
// A zone seats 150 (everglade-wire.coax WIRE_ZONE_SEATS, #13275), so the page holds and draws that many
// others (#13268, #13306): the records and draws are sized for 149 bodies of 11 parts beside the world's.
E2_RECORDS :: 2048;           // the objects store: the glade, its grass, your character's parts and the others' (11 a body)
E2_DRAWS :: 2560;             // draws a pass at most (the woods' runs, the grass field's blocks, 11 a body)
E2_REMOTES :: WIRE_ZONE_SEATS - 1;   // other players drawn at most (a zone's seats but yours); the graphics quality's crowd knob draws fewer
E2_REMOTE_PROBES :: 16;       // the others the crowd check's probes name (66 to 81), whatever is drawn
E2_FADE_S :: 0.6;             // s: another player thins in as it comes into your view, and out as it leaves
E2_POP :: 0.25;               // a body cut off while more than this of it showed is a pop (e2_probe 19)
E2_VISIBLE :: 60000;          // kit pieces drawn a frame at most, both passes
E2_KIT_BASE :: 1048576;       // everglade/client/gpu/everglade2.coax E2_KIT_BASE
E2_BUCKETS :: E2_KITS * E2_LODS;
HOLD_W :: 1; HOLD_A :: 2; HOLD_S :: 4; HOLD_D :: 8; HOLD_LEFT :: 16; HOLD_RIGHT :: 32; HOLD_UP :: 64; HOLD_DOWN :: 128; HOLD_IN :: 256; HOLD_OUT :: 512;
HOLD_JUMP :: 1024; HOLD_ALL :: 2047;
KEY_SHIFT :: -13; KEY_LEFT :: -4; KEY_RIGHT :: -5; KEY_UP :: -6; KEY_DOWN :: -7;

E2 :: struct {
  creator: [1] cc.Creator;
  vig: [1] cc.HudVignette; vig_at: f32; vig_max: int;   // the screen's red edges (everglade/hud/parts.coax eg_vignette), when last stepped, for which maximum
  hp_trail: [1] cc.HudTrail; hp_trail_at: f32; hp_trail_max: int;   // your health bar's fill and damage trail (metaverse-engine/ui/hud-style.coax), when it was last stepped, and for which maximum
  bodies: [1] figs.Bodies;
  items: [E2_ITEMS * E2_ITEM_FLOATS] f32; kinds: [E2_ITEMS] u8; first: [E2_CELLS_X * E2_CELLS_Z + 1] int; planted: int; plant_done: bool;
  plant_due: bool; plant_route: int;   // plant here on the next frame; 1 the pack's P lines, 2 planted here, 3 by cell as each arrives (e2_take_planting)
  // the world by cell (everglade/world/cell-content.coax, #13280): the pack's catalog has a line a cell, so each
  // cell's planting comes when the controller asks for it and goes when the cell leaves
  paged: bool; world_in: bool;                        // ... and the cells round you were in once: the scene may draw
  plant_held: [E2P_CELLS] int; cell_have: [E2CV_CELLS] bool;   // each planting cell's cell + 1 (0: the catalog's, or not in); the cells whose content is in
  cells_in: int; cells_out: int; bake_due: bool;      // cells taken and let go; the glade's canopy changed, so its bake is due
  eg: [1] E2Ground;                                   // the ground's tiles and the glade's baked AO (everglade/world/ground.coax)
  cl: [1] E2CellView;                                 // the world's cells round you: each one's level, written by the cell controller once a frame (everglade/client/cells.coax)
  catalog_in: bool; ground_code: int = -1; ground_done: bool;   // the catalog came; its ground record's status (-1 none); the ground settled and baked
  kit_first: [E2_BUCKETS] int; kit_count: [E2_BUCKETS] int; kits: bool;
  records: [E2_RECORDS * 24] f32;
  // the characters' materials, one record a colour layer (metaverse-engine/character/material.coax), the
  // fourth store; mats_n the records admitted, 0 when the pack's table was refused (no maps)
  mats: [cmat.CM_MAX * cmat.CM_FLOATS] f32; mat_table: [cmat.CM_MAX] cmat.CharMaterial; mats_n: int; mats_v: int;
  film: bool; maps_off: bool;   // ?film, ?maps=0 (e2_material_facts)
  inst: [E2_VISIBLE] u32; inst_n: int;   // the pieces drawn this frame, a word each: its row of items and its fade code (everglade2.coax e2_vis_word)
  rec_n: int;                            // the records this frame wrote (the span the host uploads)
  fly: trk.CamTrack; fly_from: f32;   // #fly=PATH: the flyover benchmark flies the camera (e2_hash)
  draws: [E2_DRAWS * 4] u32; draw_n: int;
  shadow: [E2_DRAWS * 4] u32; shadow_n: int;
  frame: [16] f32;
  move_bodies: [E2_NEAR_BODIES * 7] f32;
  move_hulls: [E2_HULL_ROOM] f32;   // the rocks' hulls round you this step (everglade/shared/move.coax e2m_world)
  rig_packed: bool;                      // the bake's rig came from the pack's rig entry (probe 179)
  bake: [figs.BD_BAKE_FLOATS] f32;
  orbit: figs.Orbit; look_yaw: f32; look_pitch: f32;
  ride_back: f32;                                     // metres the riding camera has added to the orbit (figs.cam_chase_seat)
  ml: [1] mlook.Mouselook;   // mouselook (metaverse-engine/cam/mouselook.coax): in the world, not Character Create's studio
  held: int; shift: bool; dragging: bool; drag_x: f32; drag_y: f32;
  you_x: f32; you_y: f32; you_z: f32; you_face: f32 = 3.14159265; jump: f32; placed: bool; start_z: f32; autowalk: bool; stage: int; stage_t0: f32 = -1; stage_fire: int = -1; stage_aim: [3] f32; stage_aim_at: f32 = -1;
  // everglade.world's /play (e2c_play_page): one address for Character Create and the world; where you
  // stood is kept in this browser (host action 11, message 11) and you start there again
  play: bool; start_x: f32; start_face: f32; start_kept: bool; kept_at: f32 = -100; kept_x: f32; kept_z: f32; kept_any: bool;
  anim: [1] figs.BdAnim;
  airborne: bool; air_at: f32; land_at: f32 = -100;   // the jump's takeoff and landing (e2_jump_figure)
  press: f32; eye_pitch: f32;                        // the eye's pitch, held on the land, and how far the look has gone past it (e2_chase_step)
  ground: [1] figs.CamGround;                         // the land round you for the camera (figs.cam_ground_next, filled from e2_height)
  view: figs.CamMode;                                 // Everglade II's follow mode (e2_mode)
  q: [1] Quality; q_ready: bool;                     // the graphics governor (metaverse-engine/core/quality.coax): the pixels drawn
  q_dev: QualityDevice; q_facts: bool; q_mode: int = QUALITY_AUTO; q_tell: bool;   // the page's device and the player's pick (e2_quality_facts)
  q_settled: [QUALITY_CLASSES] int;                 // the rung each class settled at on an earlier visit (-1 none)
  gpu_vendor: [24] u8; gpu_vendor_n: int; gpu_arch: [24] u8; gpu_arch_n: int;   // the adapter's, as host.js said them (the graphics event)
  kn: QualityKnobs; kn_ready: bool; casc_n: int;     // the rung's knobs as the frame uses them, eased in (e2_knobs_frame); the host's shadow tiles
  q_box: cc.Box; q_finger: int = -1; golden: bool;   // the GFX control beside the frame rate, the finger on it; a golden frame
  fps_counter:[1]cc.FpsCounter;          // the frame rate shown, and the frames since it was last worked out
  clock: f32; width: f32; height: f32; k: f32 = 1;
  eye: [3] f32; fwd: [3] f32; right: [3] f32; up: [3] f32; focal: f32;
  shade: [3] f32; casc: [1] CascadeState;
  cz: [1] E2Create;                      // Character Create's studio and its run (everglade/client/create.coax)
  rg: [1] E2Range;                       // the Archery Range's scene (everglade/client/range.coax)
  outbox: [1024] u8; out_n: int; action: int;   // the host action this frame (5 keep the player key, 16 keep the record, 19 the address)
  player_key: [1024] u8; player_key_n: int;      // a minted player key waiting for the host action (e2_keep_player)
  reseat: bool;                          // the controller to take you as the studio drew you (everglade2-face.c)
  media: [6144] u8; media_n: int;        // the pictures this frame names for the host (the class pane's, everglade/client/create.coax; the bar's, everglade/client/cast.coax)
  casts: [1] E2Cast;                      // your class's bar and everyone's casts (everglade/client/cast.coax)
  // the room (everglade/client/net.coax): the others, each with its own animation, its jump and its look
  net: [1] E2Net; staged: bool;          // staged: ?at= or ?walk, a shot that opens no room
  ranim: [E2N_ENTS] figs.BdAnim; rair: [E2N_ENTS] bool; rair_at: [E2N_ENTS] f32; rland_at: [E2N_ENTS] f32; rlife: [E2N_ENTS] int;
  // each slot's fade (0 gone, 1 whole) and what it last drew, so one coming into your view (the room's
  // interest, 110 m) thins in and one leaving it (130 m, or the room) thins out where it was: no pops
  rfade: [E2N_ENTS] f32; rlast: [E2N_ENTS] E2Remote; rseat: [E2N_ENTS] int; rlook: [E2N_ENTS * NET_LOOK] u8; rlook_n: [E2N_ENTS] int;
  fade_ins: int; pops: int; ghosts: int;   // e2_probe 18, 19, 87
  rtmp: [1] cc.Creator;                  // a remote's look: your creator's catalog with its record (e2_remote_look)
  heads: [E2_REMOTES] E2Head; head_n: int;     // the others' heads this frame (e2_remotes_draw): their plates, the map's dots, the reticle
  plates: [1] cc.HudPlates;                      // the frame's plates over bodies (e2_heads: metaverse-engine/ui/hud-plates.coax)
  // what floats over each body shows while the body does (everglade/client/sight.coax): each one's share, fading
  sight_rem: [E2_REMOTES] cc.HudSight; sight_mon: [12] cc.HudSight; sight_guard: cc.HudSight; sight_dt: f32 = 1; sight_at: f32 = -1;
  cy: f32;                                       // the picture's centre row (e2c_view_lens: the studio frames you off centre)
  env: [1] envf.EnvFrame;                        // the light: the world's environment set, its clock and the record each frame writes (e2_light)
  light_view: int; light_text: [1] envd.EnvDebugText;   // ?light=VIEW (developer-only, off by default) and its readout (e2_light_readout)
  net_view: bool; net_text: [1] NetStatsText; link_text: [1] NetConnText;   // ?net: the netcode readout (e2_net_readout, metaverse-engine/net/stats.coax)
  guard: [1] E2GuardLook;                        // the path's guard as drawn (everglade/client/guard.coax)
  mouse: [1] E2Mouse;                            // the mouse buttons' cast and bow (everglade/client/mouse.coax)
  bows: [1] E2Bow;                               // the arrows in the air and stuck (everglade/client/arrows.coax)
  adm: [1] E2Admin;                              // admin mode (everglade/client/admin.coax): set and read in dev builds only
  monsters: [1] E2MonLooks;                      // the wolves and goblins as drawn (everglade/client/creatures.coax)
  rv: [1] E2RideView;                            // the zone's mounts as drawn, and the pack's frames for them (everglade/client/ride-view.coax)
  wild: [1] E2Wild;                              // the glade's cat (everglade/client/wild.coax)
  speakers: [1] E2Speakers;                      // the content tables' speakers: the Warden (everglade/client/speakers.coax)
  npc: [1] E2Npc;                                // Pansopher and his talk (everglade/client/npc.coax)
  bench: [1] E2Bench;                            // the Golemancer's Workbench (everglade/client/bench.coax)
  bag: [1] E2Bag;                                // your coin, quests and bag, and the content tables that word them (everglade/client/bag.coax)
  own_dev: int;                                  // ?own=N in a dev build: a stand-in for the room's word on your record (e2i_dev)
  hud_day: f32 = 0.5;                            // the time of day the light is at (e2_light), for the map's clock
  zone: int = -1; zone_at: f32 = -100;           // the place you are in (e2_zone) and when you came to it, for its banner
  drive: [1] Drive;                              // the agent driver (metaverse-engine/agent/drive.coax): off until a driver speaks
  hero_class: int = -1; hero_level: int; hero_ac: int; hero_slots: [10] int;   // your class's AC and spell slots by level, as the rules build it (fb_cl_hero)
  floats: [1] fl.Floats;                         // the numbers over whoever a blow struck: the room's hit words (e2_float)
}
E2Head :: struct { x: f32; y: f32; z: f32; fade: f32 = 1; name: [NET_NAME] u8; name_n: int; }

// ---- the pack: the catalog's kit rows (e2/k<kit>/<level>), and Character Create's own rows
// The face keeps the ground's two tile sets outside the state (everglade2-face.c), as it does the catalog.
e2_ground_store :: (s: [] E2, sets: [] E2Tiles) #export_c #effects(all) { e2g_store(s[0].eg[..], sets); }
// The world's cells as the frame reads them, for the face to hand the cell controller once a frame
// (everglade/client/cells.coax e2cl_page_frame), and whether the woods are in: the cells' content.
e2_cell_view :: (s: [] E2) -> [] E2CellView #export_c #effects(all) { return s[0].cl[..]; }
e2_cells_due :: (s: [] E2) -> bool #export_c #effects(all) { return s[0].plant_done; }
// Whether a catalog has a line a world cell (metaverse-engine/host/pack-cells.coax): the pack is paged by cell.
e2_catalog_paged :: (t: string) -> bool {
  at := 0;
  while at < t.count {
    if at + 1 < t.count && t[at] == 'Z' && t[at + 1] == ' ' { return true; }
    while at < t.count && t[at] != '\n' { at += 1; }
    at += 1;
  }
  return false;
}
e2_catalog :: (s: [] E2, whole: string, rec: [] u8, rest: [] u8) #export_c #effects(all) {
  // the ground's record rides in the catalog as G lines (everglade/world/ground.coax): read and
  // published now, whole or not at all; the rest is the catalog the others read. A pack paged by
  // cell carries the record with its cells (e2_cell_take), and the planting cell by cell.
  s[0].paged = e2_catalog_paged(whole);
  n := e2g_record_from_catalog(whole, rec);
  s[0].ground_code = ifx n > 0 then e2g_record_read(s[0].eg[..], rec[0..<n]) else -1;
  e2_take_planting(s, whole); s[0].catalog_in = true;
  text := e2_catalog_rest(whole, rest);
  figs.bd_catalog(s[0].bodies[..], text); cc.catalog(s[0].creator[..], text); e2w_catalog(s, text); e2b_catalog(s, text); e2rv_catalog(s, text); e2rg_catalog(s, text);
  s[0].mats_n = cmat.cm_table(text, s[0].mat_table[..], s[0].mats[..]); s[0].mats_v += 1;
  for b: 0..<E2_BUCKETS { s[0].kit_first[b] = 0; s[0].kit_count[b] = 0; }
  at := 0; any := false;
  while at < text.count {
    e := at; while e < text.count && text[e] != '\n' { e += 1; }
    row := text[at..<e]; at = e + 1;
    if row.count < 10 || row[0..<6] != "C e2/k" { continue; }
    p := 6; kit := 0; while p < row.count && row[p] >= '0' && row[p] <= '9' { kit = kit * 10 + cast(int)(row[p] - '0'); p += 1; }
    if p >= row.count || row[p] != '/' { continue; }
    lod := cast(int)(row[p + 1] - '0'); ne := figs.bd_word_end(row, p);
    if kit < 0 || kit >= E2_KITS || lod < 0 || lod >= E2_LODS { continue; }
    first := figs.bd_whole_at(row, ne); q := figs.bd_word_end(row, ne + 1); count := figs.bd_whole_at(row, q);
    if first >= 0 && count > 0 { s[0].kit_first[kit * E2_LODS + lod] = first; s[0].kit_count[kit * E2_LODS + lod] = count; any = true; }
  }
  s[0].kits = any;
}
// The woods from the catalog's P lines (everglade/world/plant.coax e2p_from_catalog, written by
// build.sh), when they read back whole and the spot check finds this tree's planting in them; else
// the next frame plants them here, as every frame-one did before (docs/metaverse/fast-loads.md).
e2_take_planting :: (s: [] E2, whole: string) {
  if s[0].plant_done { return; }
  pn := e2p_from_catalog(whole, s[0].items[..], s[0].kinds[..], s[0].first[..]);
  if s[0].paged {
    // by cell: the catalog holds only the planting no cell carries (none: nothing is planted yet).
    // Its first planting cell with pieces must be this tree's; else the pack is another planting's,
    // and the woods are planted here, whole.
    if pn == 0 { for c: 0..<E2P_CELLS + 1 { s[0].first[c] = 0; } }
    good := pn >= 0;
    if pn > 0 { p := 0; while p < E2P_CELLS - 1 && s[0].first[p + 1] == s[0].first[p] { p += 1; } good = e2cc_cell_agrees(s[0].items[..], s[0].kinds[..], s[0].first[..], p); }
    for p: 0..<E2P_CELLS { s[0].plant_held[p] = 0; }
    if good { s[0].planted = pn; s[0].plant_done = true; s[0].plant_route = 3; return; }
    s[0].paged = false; s[0].plant_due = true; return;
  }
  if pn > 0 && e2p_agrees(s[0].items[..], s[0].kinds[..], s[0].first[..], pn) { s[0].planted = pn; s[0].plant_done = true; s[0].plant_route = 1; return; }
  s[0].plant_due = true;
}
// No catalog came (the pack failed, or it is too big for the face's buffer): plant here.
e2_plant_due :: (s: [] E2) #export_c #effects(all) { if !s[0].plant_done { s[0].plant_due = true; } }
// ---- the world by cell (GitHub #13280): what the face asks and tells as cells arrive and leave
e2_paged :: (s: [] E2) -> bool #export_c #effects(all) { return s[0].paged; }
// Whether a cell's bytes are content the page can take for that cell: a run of whole blobs with the
// cell's planting, this tree's, that fits. The face asks before it answers the controller, so a
// cell is never admitted without its content.
e2_cell_checks :: (s: [] E2, cell: int, b: [] u8) -> bool #export_c #effects(all) {
  if !s[0].paged || cell < 0 || cell >= E2CV_CELLS || s[0].cell_have[cell] || !e2cc_whole(b) { return false; }
  blob := e2cc_blob(b, E2CC_PLANT);
  return blob.count > 0 && e2cc_plant_read(blob).cell == cell && e2cc_fits(blob, E2_ITEMS, E2_ITEMS, s[0].first[..], s[0].plant_held[..], s[0].planted) && e2cc_agrees(blob);
}
// Whether a tree one of the cell's planting cells holds stands where its crown shades the glade's tile.
e2_cell_shades :: (s: [] E2, cell: int) -> bool {
  if !s[0].eg[0].ok { return false; }
  for p: 0..<E2P_CELLS {
    if s[0].plant_held[p] != cell + 1 { continue; }
    for q: s[0].first[p]..<s[0].first[p + 1] { if cast(int) s[0].kinds[q] < E2_TREES && e2g_near(s[0].eg[..], s[0].items[q * E2_ITEM_FLOATS], s[0].items[q * E2_ITEM_FLOATS + 2]) { return true; } }
  }
  return false;
}
// A cell's content, once the controller has admitted the cell (e2_cell_checks held): the ground's
// record when no ground is published yet, and the cell's planting into the page's.
e2_cell_take :: (s: [] E2, cell: int, b: [] u8) #export_c #effects(all) {
  if !e2_cell_checks(s, cell, b) { return; }
  if !s[0].eg[0].ok && s[0].ground_code != E2G_REC_OK {
    rec := e2cc_ground(b);
    if rec.count > 0 { s[0].ground_code = e2g_record_read(s[0].eg[..], rec); }
  }
  n := e2cc_insert(e2cc_blob(b, E2CC_PLANT), s[0].items[..], s[0].kinds[..], s[0].first[..], s[0].plant_held[..], s[0].planted);
  if n < 0 { return; }
  s[0].planted = n; s[0].cell_have[cell] = true; s[0].cells_in += 1;
  if e2_cell_shades(s, cell) { s[0].bake_due = true; }
}
// Once a frame after the controller has stepped: a cell that left (its level is absent again) gives
// its planting back. `near_in`: every cell within the draw ring of you is in (cells.coax
// e2cl_near_in); the first time it is, the world may draw.
e2_cells_settle :: (s: [] E2, near_in: bool) #export_c #effects(all) {
  if !s[0].paged { return; }
  for i: 0..<E2CV_CELLS {
    if !s[0].cell_have[i] || s[0].cl[0].level[i] != 0 { continue; }
    if e2_cell_shades(s, i) { s[0].bake_due = true; }
    s[0].planted = e2cc_remove(i, s[0].items[..], s[0].kinds[..], s[0].first[..], s[0].plant_held[..], s[0].planted);
    s[0].cell_have[i] = false; s[0].cells_out += 1;
  }
  if near_in { s[0].world_in = true; }
}
// Whether the scene may draw: with the world by cell, once the cells round you were in and the
// ground has settled, so the woods never arrive in a picture.
e2_world_ready :: (s: [] E2) -> bool #export_c #effects(all) { return !s[0].paged || (s[0].world_in && s[0].ground_done); }
#test "the woods come from the catalog's P lines, or are planted on the next frame" {
  s: [1] E2; rec: [16] u8; rest: [512] u8;
  e2_catalog(s[..], "C glade/environment 9 12 250 100 8 0\n", rec[..], rest[..]);
  #assert !s[0].plant_done && s[0].plant_due && s[0].plant_route == 0;
  // a damaged record is no planting: it is planted here
  s[0].plant_due = false; e2_catalog(s[..], "C glade/environment 9 12 250 100 8 0\nP RTJQMQ==\n", rec[..], rest[..]);
  #assert !s[0].plant_done && s[0].plant_due && cast(string) rest[0..<37] == "C glade/environment 9 12 250 100 8 0\n";
}
#test "the world by cell: a cell's content is taken for its own cell once, shows in the planting, and is given back when the cell leaves" #steps 400000000 {
  s: [1] E2; rec: [16] u8; rest: [512] u8;
  e2_catalog(s[..], "C glade/environment 9 12 250 100 8 0\nZ 0 0 5 100 20\n", rec[..], rest[..]);
  #assert s[0].paged && s[0].plant_done && !s[0].plant_due && s[0].plant_route == 3 && s[0].planted == 0 && !e2_world_ready(s[..]) && e2_probe(s[..], 194) == 1;
  #assert !e2_catalog_paged("C a 1 2 3\nZx 0 0\n") && e2_catalog_paged("Z 1 1 1 1 1") && !e2_catalog_paged("");
  // cell 2's blob: one planting cell of the woods
  f: [E2CC_CELL_MOST * E2_ITEM_FLOATS] f32; k: [E2CC_CELL_MOST] u8; first: [E2P_CELLS + 1] int; carrier: [E2P_CELLS] int; b: [8192] u8;
  pc := 23 * E2_CELLS_X + 13; m := e2_plant_cell(f[..], k[..], 0, 13, 23); #assert m > 20;
  for c: pc + 1..<E2P_CELLS + 1 { first[c] = m; } carrier[pc] = 3;
  n := e2cc_plant_write(f[..], k[..], first[..], carrier[..], 2, b[..]); #assert n > 0;
  // not another cell's, not cut short, not with a moved piece
  #assert e2_cell_checks(s[..], 2, b[0..<n]) && !e2_cell_checks(s[..], 1, b[0..<n]) && !e2_cell_checks(s[..], 2, b[0..<n - 4]) && !e2_cell_checks(s[..], -1, b[0..<n]);
  b[E2CC_PLANT_HEAD + 8] += 1; #assert !e2_cell_checks(s[..], 2, b[0..<n]); b[E2CC_PLANT_HEAD + 8] -= 1;
  e2_cell_take(s[..], 1, b[0..<n]); #assert s[0].planted == 0 && s[0].cells_in == 0;
  s[0].cl[0].level[2] = cast(u8) E2CV_DRAW;
  e2_cell_take(s[..], 2, b[0..<n]);
  #assert s[0].planted == m && s[0].cells_in == 1 && s[0].cell_have[2] && s[0].plant_held[pc] == 3 && s[0].first[pc] == 0 && s[0].first[pc + 1] == m && s[0].first[E2P_CELLS] == m && !e2_cell_checks(s[..], 2, b[0..<n]);
  for q: 0..<m { #assert s[0].kinds[q] == k[q] && f32_bits(s[0].items[q * E2_ITEM_FLOATS + 2]) == f32_bits(f[q * E2_ITEM_FLOATS + 2]); }
  // the cells round you are in: the scene waits for the ground too
  e2_cells_settle(s[..], false); #assert s[0].planted == m && !s[0].world_in;
  e2_cells_settle(s[..], true); #assert s[0].world_in && !e2_world_ready(s[..]) && e2_probe(s[..], 195) == 1 && e2_probe(s[..], 196) == 0;
  s[0].ground_done = true; #assert e2_world_ready(s[..]) && e2_probe(s[..], 197) == 1;
  // the cell leaves: its planting is given back, and it can be taken again
  s[0].cl[0].level[2] = 0; e2_cells_settle(s[..], false);
  #assert s[0].planted == 0 && s[0].cells_out == 1 && !s[0].cell_have[2] && s[0].plant_held[pc] == 0 && s[0].first[E2P_CELLS] == 0 && s[0].world_in && e2_cell_checks(s[..], 2, b[0..<n]);
  // a pack that is not by cell: nothing is taken, and the scene never waits
  w: [1] E2; e2_catalog(w[..], "C glade/environment 9 12 250 100 8 0\n", rec[..], rest[..]);
  #assert !w[0].paged && e2_world_ready(w[..]) && !e2_cell_checks(w[..], 2, b[0..<n]);
}
// The catalog without its G and P lines (or as it came, when that is too long to copy).
e2_catalog_rest :: (t: string, out: [] u8) -> string {
  n := 0; at := 0;
  while at < t.count {
    e := at; while e < t.count && t[e] != '\n' { e += 1; }
    if !(e - at > 1 && (t[at] == 'G' || t[at] == 'P') && t[at + 1] == ' ') {
      if n + e - at + 1 > out.count { return t; }
      for q: at..<e { out[n] = t[q]; n += 1; } out[n] = '\n'; n += 1;
    }
    at = e + 1;
  }
  return cast(string) out[0..<n];
}
// The ground, once the planting and the catalog are in: the pack's record published it, or (no
// record, or it refused) the land is converted here; then the woods' crowns are baked onto the glade's tile.
e2_ground :: (s: [] E2) {
  s[0].ground_done = true; s[0].bake_due = false;
  if !s[0].eg[0].ok && !e2g_build(s[0].eg[..]) { return; }
  _b := e2g_bake(s[0].eg[..], s[0].items[..], s[0].kinds[..], s[0].planted);
}
// The clips, baked once into the state's own store, sized by the bodies module so it never falls behind.
// The clips, once: the shared ones and the bow's draw.
// The people's rig is the pack's (its rig entry, a VRG1 file: everglade/scene/rig-asset.coax,
// GitHub #13306, #13508): every host's pack carries it (the desktop and phone apps' build puts it into
// the pack they bundle). Without it nothing is baked and this says false, so the face asks again
// once the rig is in.
e2_bake :: (s: [] E2, d: [] figs.People, file: [] u8) -> bool #export_c #effects(all) {
  s[0].rig_packed = figs.e2rig_people(file, d);
  if !s[0].rig_packed { return false; }
  figs.bd_bake(d, s[0].bake[..]); figs.bd_bake_bow(d, s[0].bake[..]);
  // the hands' rows of every baked frame, for what a figure holds (cc.held_pieces through figs.bd_hand):
  // without them a bow, a sword and the Guard's blade stand at their owner's feet
  figs.bd_keep_hands(s[0].bodies[..], d, s[0].bake[..]);
  return true;
}
e2_layers_side :: (s: [] E2) -> int #export_c #effects(all) { return ifx s[0].width >= 840 * s[0].k then 1024 else 512; }
// Your saved character (message 16, the browser's own copy) or a kept appearance (4); the page's
// facts (600): ?at=METRES starts you that far down the path (a shot's or a test's way in).
E2_HOST_PAGE :: 600;
E2_HOST_HIDDEN :: 601;   // the page out of sight (a hidden tab, or opened in place under another page: zone-host.js)
E2_HOST_SHOWN :: 602;    // and shown again (with now= when handed over in place)
// The characters' shading quality from the page's facts: ?film draws them at the film quality
// (everglade/client/gpu/everglade2.coax cc_player_fs: cloth sheen, skin's wrapped light, hair's highlight), and
// ?maps=0 without their normal and ORM maps, for before/after captures.
e2_material_facts :: (s: [] E2, t: string) { s[0].film = e2c_fact_has(t, "film"); s[0].maps_off = e2c_fact_has(t, "maps=0"); }
#test "the latency check's probes are answered by their own fields: none is another readout's number" {
  s: [1] E2; s[0].you_x = 1.5; s[0].you_z = -2.25; s[0].casts[0].shown = 7;
  s[0].bows[0].net[0].loosed = 3; s[0].bows[0].net[0].others = 4; s[0].bows[0].net[0].landed = 5; s[0].bows[0].net[0].named = 6; s[0].bows[0].net[0].fix_mm = 9;
  #assert e2_probe(s[..], 210) == 1500 && e2_probe(s[..], 211) == -2250 && e2_probe(s[..], 213) == 7;
  #assert e2_probe(s[..], 214) == 3 && e2_probe(s[..], 215) == 4 && e2_probe(s[..], 217) == 5 && e2_probe(s[..], 218) == 6 && e2_probe(s[..], 219) == 9;
}
#test "?film and ?maps=0 set the characters' shading quality" {
  s: [1] E2; e2_material_facts(s[..], "url=/worlds/character-creator?film&maps=0\n"); #assert s[0].film && s[0].maps_off;
  e2_material_facts(s[..], "url=/worlds/character-creator?filmic=1\n"); #assert !s[0].film && !s[0].maps_off;
  u: [E2_UNIFORM_FLOATS] f32; s[0].film = true; e2_material_uniforms(s[..], u[..]); #assert u[60] == 1 && u[61] == 0;
}
// u[60] the film quality, u[61] the maps off (everglade/client/gpu/everglade2.coax cc_player_fs).
// u[62] the canopy's baked AO at your middle (everglade/world/ground.coax): it shades only your indirect light.
e2_material_uniforms :: (s: [] E2, u: [] f32) { u[60] = ifx s[0].film then 1.0f32 else 0.0f32; u[61] = ifx s[0].maps_off then 1.0f32 else 0.0f32; u[62] = e2g_ao(s[0].eg[..], s[0].you_x, s[0].you_z, 1.0); }
E2_HOST_DRIVE :: 700;   // a driver's command (coax/web/host.js coaxial.drive)
e2_message :: (s: [] E2, kind: int, t: string) #export_c #effects(all) {
  e2i_load(s);   // the content tables, before the page asks for a seat: their revision is its content pin
  if kind == E2_HOST_DRIVE { e2d_message(s, t); return; }
  if kind == 1 { e2c_name_type(s, t); return; }   // typed or pasted text: Character Create's NAME
  if kind == 16 { cc.load_player(s[0].creator[..], t); e2_net_look(s); return; }
  if kind == 4 { ok := cc.restore(s[0].creator[..], t); return; }
  if kind == E2C_KEPT { e2c_reply(s, t); return; }
  if kind == E2_HOST_PLACE { e2_place_take(s, t); return; }
  if kind == E2_HOST_HIDDEN || kind == E2_HOST_SHOWN { e2c_seen(s, kind == E2_HOST_SHOWN, t); return; }
  if kind == E2_HOST_GPU { e2_quality_gpu(s, t); return; }
  if kind == E2_HOST_PAGE {
    s[0].play = e2c_play_page(t);
    #if BUILD_DEBUG { od := net_query(fact_of(t, "url"), "own"); s[0].own_dev = ifx od.count == 1 && od[0] >= '1' && od[0] <= '4' then cast(int) (od[0] - '0') else 0; }
    e2_material_facts(s, t); e2c_facts(s, t); s[0].light_view = envd.env_view_query(t); s[0].net_view = e2_net_query(t); e2_quality_facts(s, t);
    if !s[0].cz[0].on { at := e2_query_at(t); if at > 0 { s[0].start_z = -f32(at); } s[0].autowalk = e2_query_walk(t); e2st_facts(s, t); }
    // a staged shot (?at=, ?walk) and a film stand where they are put: no room; but ?at= with a local
    // room (?relay=ws://localhost:PORT, a check's or a capture's) starts you there in that room, told to
    // it as a kept place is (e2_place_take)
    local := e2_query_local(t);
    s[0].wild[0].stage = e2w_stage(t);
    if s[0].wild[0].stage { e2w_stage_you(s); }   // you stand out of the shot
    s[0].staged = (s[0].start_z < 0 && !local) || s[0].autowalk || s[0].film || s[0].wild[0].stage || e2st_apart(s[0].stage);
    e2n_facts(s[0].net[..], t, s[0].staged);
    if local && s[0].start_z < 0 && !s[0].autowalk && !s[0].film {
      z := s[0].start_z; s[0].start_x = e2_road_x(z); s[0].start_face = figs.atan2(e2_road_x(z - 2) - s[0].start_x, -2.0f32);
      s[0].start_kept = true; s[0].net[0].sat_before = true;
    }
    e2rg_facts(s, t);   // /worlds/archery-range: at the range, in the room (everglade/client/range.coax)
    e2_net_look(s);
    #if BUILD_DEBUG { e2a_facts(s, t); }
    return;
  }
  if kind >= 256 && kind < 512 { seen := e2n_event(s[0].net[..], kind, t); return; }
}
// Whether the page's room is a local one (?relay=ws://localhost:PORT).
e2_query_local :: (t: string) -> bool {
  url := fact_of(t, "url"); r := net_query(url, "relay");
  if r.count <= 15 || r.count >= 40 || r[0..<15] != "ws://localhost:" { return false; }
  for c: r[15..<r.count] { if c < '0' || c > '9' { return false; } }
  return true;
}
#test "?at= with a local room starts you there in the room; without one it is a staged shot" #steps 200000000 {
  u: [1] E2; e2_message(u[..], E2_HOST_PAGE, "url=http://127.0.0.1:8863/worlds/everglade2?at=120&relay=ws://localhost:8971\n");
  #assert !u[0].staged && u[0].start_kept && abs(u[0].start_z + 120) < 0.001 && abs(u[0].start_x - e2_road_x(-120)) < 0.001 && u[0].net[0].sat_before;
  w: [1] E2; e2_message(w[..], E2_HOST_PAGE, "url=http://127.0.0.1:8863/worlds/everglade2?at=120&relay=wss://example.com:1\n");
  #assert w[0].staged && !w[0].start_kept;
}
#test "a page's ?at= says how far down the path you start" {
  #assert e2_query_at("url=http://127.0.0.1:8863/worlds/everglade2?at=120\n") == 120;
  #assert e2_query_at("url=/worlds/everglade2?x=1&at=45.5&y=2\n") == 45;
  #assert e2_query_at("url=/worlds/everglade2\n") == 0 && e2_query_at("url=/worlds/everglade2?cat=9\n") == 0;
  #assert e2_query_walk("url=/worlds/everglade2?at=10&walk\n") && e2_query_walk("url=/worlds/everglade2?walk=1\n") && !e2_query_walk("url=/worlds/everglade2?sidewalk\n");
}
#test "the walk steers along the path and into the clearing" {
  for i: 0..<40 { z := -40 - f32(i) * 10; x := e2_road_x(z); hd := e2_auto_heading(x, z);
    nz := z + cos(hd) * 2; nx := x + sin(hd) * 2; #assert nz < z && e2_may_stand(nx, nz); }
  hd := e2_auto_heading(e2_clear_x(), E2_CLEAR_Z + 5); #assert cos(hd) < 0;
  // the controller then goes that way, not back up the path
  for i: 0..<8 { h := f32(i) * 0.785 - 3.1; t := e2_walk_theta(h); #assert abs(-sin(t) - sin(h)) < 0.001 && abs(-cos(t) - cos(h)) < 0.001; }
}
// ?walk: your character walks the path by itself, at a walk, and the camera eases in behind (the
// film's way to walk it; any key takes over).
e2_query_walk :: (t: string) -> bool {
  for i: 0..<t.count - 4 { if (t[i] == '?' || t[i] == '&') && t[i + 1] == 'w' && t[i + 2] == 'a' && t[i + 3] == 'l' && t[i + 4] == 'k' { return true; } }
  return false;
}
e2_query_at :: (t: string) -> int {
  for i: 0..<t.count - 3 {
    if t[i + 1] == 'a' && t[i + 2] == 't' && t[i + 3] == '=' && (t[i] == '?' || t[i] == '&') {
      v := 0; j := i + 4; while j < t.count && t[j] >= '0' && t[j] <= '9' { v = v * 10 + cast(int)(t[j] - '0'); j += 1; }
      return ifx v > 520 then 520 else v;
    }
  }
  return 0;
}

// ---- where you may stand: the glade, the path's corridor, the clearing
#test "the catalog's kit rows fill their (kit, level) buckets" {
  s: [1] E2;
  rec: [16] u8; rest: [512] u8;
  e2_catalog(s[..], "C glade/environment 9 12 250 100 8 0\nC e2/k0/0 100 30 250 100 8 0\nC e2/k0/2 130 12 250 100 8 0\nC e2/k32/0 200 6 250 100 8 0\nC e2/k33/0 1 3 250 100 8 0\n", rec[..], rest[..]);
  #assert s[0].kits && s[0].kit_first[0] == 100 && s[0].kit_count[0] == 30 && s[0].kit_count[2] == 12 && s[0].kit_count[1] == 0;
  #assert s[0].kit_first[32 * E2_LODS] == 200 && s[0].kit_count[32 * E2_LODS] == 6;
}
#test "wherever you may not go on, thick woods stand: no edge on open ground" {
  // round the glade, off the path, and along both sides of the path to the clearing
  for i: 0..<64 { a := f32(i) * 0.0982; x := cos(a) * (f32(E2_GLADE_WALK) + 0.5); z := sin(a) * (f32(E2_GLADE_WALK) + 0.5);
    if e2_may_stand(x, z) { continue; }
    #assert e2_forest(x, z) > 0.7; }
  for i: 0..<88 { z := -40 - f32(i) * 5; if e2_clearing(e2_road_x(z), z) > 0.1 { continue; }
    for side: 0..<2 { x := e2_road_x(z) + (ifx side == 0 then -1.0f32 else 1.0f32) * (f32(E2_WALK) + 0.5);
      if e2_may_stand(x, z) { continue; }
      #assert e2_forest(x, z) > 0.7; } }
  // and round the clearing
  for i: 0..<64 { a := f32(i) * 0.0982; r := f32(E2_CLEAR_R) * 1.2; x := e2_clear_x() + cos(a) * r; z := E2_CLEAR_Z + sin(a) * r;
    if e2_may_stand(x, z) || e2_road_dist(x, z) < f32(E2_WALK) + 1 { continue; }
    #assert e2_forest(x, z) > 0.7; }
  // and round the city's clearing, past its brook's banks (#13093)
  for i: 0..<64 { a := f32(i) * 0.0982; r := f32(E2_CITY_R) * 1.25; x := f32(E2_CITY_X) + cos(a) * r; z := f32(E2_CITY_Z) + sin(a) * r;
    if e2_may_stand(x, z) || e2_road_dist(x, z) < f32(E2_WALK) + 1 || stream_dist(e2_brook(), x, z) < 10 { continue; }
    #assert e2_forest(x, z) > 0.7; }
}
// Where the step leaves you, from where you stood (everglade/shared/move.coax e2m_keep).
e2_keep :: (s: [] E2, x: f32, z: f32) -> figs.Point #export_c #effects(all) { k := e2m_keep(x, z, s[0].you_x, s[0].you_z); return figs.v3(k.x, 0, k.z); }
// Kept where you may stand from where the step began (fx, fz): the room keeps you so (room-world.c world2_step).
e2_keep_from :: (s: [] E2, x: f32, z: f32, fx: f32, fz: f32) -> figs.Point #export_c #effects(all) { k := e2m_keep(x, z, fx, fz); return figs.v3(k.x, 0, k.z); }

// ---- the controller's half of a step (everglade2-face.c)
hold_bit :: (key: int) -> int {
  if key == 'w' || key == 'W' { return HOLD_W; } if key == 'a' || key == 'A' { return HOLD_A; }
  if key == 's' || key == 'S' { return HOLD_S; } if key == 'd' || key == 'D' { return HOLD_D; }
  if key == KEY_LEFT { return HOLD_LEFT; } if key == KEY_RIGHT { return HOLD_RIGHT; }
  if key == KEY_UP { return HOLD_UP; } if key == KEY_DOWN { return HOLD_DOWN; }
  if key == '=' || key == '+' { return HOLD_IN; } if key == '-' || key == '_' { return HOLD_OUT; }
  return 0;
}
axis :: (held: int, plus: int, minus: int) -> f32 { a: f32 = 0; if held & plus != 0 { a += 1; } if held & minus != 0 { a -= 1; } return a; }
// The point the walk steers for: 5 m on along the path, or the clearing's middle once there.
e2_auto_heading :: (x: f32, z: f32) -> f32 {
  if z < E2_CLEAR_Z + 10 { cx := e2_clear_x(); return figs.atan2(cx - x, E2_CLEAR_Z - 12 - z); }
  tz := z - 5; return figs.atan2(e2_road_x(tz) - x, tz - z);
}
// The controller's theta is the camera's (walk.coax: forward goes along -(sin theta, cos theta));
// a heading is the way you face, along (sin, cos).
e2_walk_theta :: (heading: f32) -> f32 { return figs.wrap_angle(heading + 3.14159265); }
e2_move_in :: (s: [] E2) -> EgMoveIn #export_c #effects(all) {
  m := e2_move_asked(s);
  // a step toward a cell of the world whose content is not in yet is not asked for (cell-view.coax
  // e2cv_holds): the hold is on the input, so prediction and the room, which is sent it, agree
  if e2cv_holds_push(s[0].cl[..], s[0].you_x, s[0].you_z, m.key_x, m.key_y, m.theta) || e2cv_holds_push(s[0].cl[..], s[0].you_x, s[0].you_z, m.pad_x, m.pad_y, m.theta) {
    return EgMoveIn.{theta = m.theta, link_flags = m.link_flags};
  }
  return m;
}
// What your controls, the run, an agent's walk or the stage ask of the walker this frame.
e2_move_asked :: (s: [] E2) -> EgMoveIn {
  h := s[0].held;
  #if BUILD_DEBUG { if e2a_noclip(s) { return EgMoveIn.{theta = figs.wrap_angle(s[0].orbit.yaw + 3.14159265)}; } }
  // Character Create: still in the studio; on the run, on down the path on its own, at a jog
  if e2c_creating(s) { return EgMoveIn.{theta = figs.wrap_angle(s[0].orbit.yaw + 3.14159265)}; }
  if e2c_running(s) { return EgMoveIn.{key_y = 1, theta = e2_walk_theta(e2_auto_heading(s[0].you_x, s[0].you_z))}; }
  if e2st_moves(s) { return e2st_move_in(s); }
  if s[0].autowalk && h == 0 {
    if s[0].you_z < E2_CLEAR_Z - 6 { return EgMoveIn.{theta = figs.wrap_angle(s[0].orbit.yaw + 3.14159265)}; }
    // run is the keys' Shift: the keys run by default (metaverse-engine/core/input.coax), so this walks
    return EgMoveIn.{key_y = 1, run = true, theta = e2_walk_theta(e2_auto_heading(s[0].you_x, s[0].you_z))};
  }
  if h != 0 { s[0].autowalk = false; }
  dm := e2d_move_in(s); if dm.ok && h == 0 { return dm.in; }   // an agent's walk-to, face or use (everglade/client/drive.coax)
  // asleep, as the room's rules hold you: your keys move nothing until you wake (WATCH, END)
  if e2n_asleep(s[0].net[..]) { return EgMoveIn.{theta = figs.wrap_angle(s[0].orbit.yaw + 3.14159265)}; }
  // down, or held by a condition (your bearing, rules/srd/condition-bearing.coax): your keys move nothing, as the room steps you
  if !deed_can_move(e2k_bearing(s)) { return EgMoveIn.{theta = figs.wrap_angle(s[0].orbit.yaw + 3.14159265)}; }
  return EgMoveIn.{key_x = axis(h, HOLD_D, HOLD_A), key_y = axis(h, HOLD_W, HOLD_S), run = s[0].shift, jump = h & HOLD_JUMP != 0,
                   theta = figs.wrap_angle(s[0].orbit.yaw + 3.14159265)};
}
// The trunks and rocks round you (everglade/shared/move.coax e2m_world, which the room steps by too).
e2_move_world :: (s: [] E2, x: f32, z: f32) -> EgMoveWorld #export_c #effects(all) {
  w := e2m_world(s[0].items[..], s[0].kinds[..], s[0].first[..], s[0].plant_done, s[0].move_bodies[..], s[0].move_hulls[..], x, z);
  w.bodies = e2gd_body(s, w.bodies, x, z);   // the path's guard, where he is drawn
  return w;
}
e2_move_hulls :: (s: [] E2) -> [] f32 #export_c #effects(all) { return s[0].move_hulls[..]; }
#test "the body's gait reads Everglade II's jog and stroll as a run and a walk" {
  #assert f32(E2_RUN_SPEED) > f32(figs.BD_RUN_FROM) + 0.5 && f32(E2_WALK_SPEED) < f32(figs.BD_RUN_FROM) && f32(E2_WALK_SPEED) > f32(figs.BD_WALK_FROM);
}
e2_move_bodies :: (s: [] E2) -> [] f32 #export_c #effects(all) { return s[0].move_bodies[..]; }
// Where the step left you: the controller walks a level plane, the land lifts you onto the ground.
e2_you :: (s: [] E2, x: f32, y: f32, z: f32, face: f32) #export_c #effects(all) {
  s[0].you_x = x; s[0].jump = y; s[0].you_z = z; s[0].you_face = face; s[0].you_y = e2g_y(s[0].eg[..], x, z) + y;   // the admitted triangles in the glade
  e2_air(s, y > f32(E2_AIRBORNE));
}
// ---- the jump (ported from Everglade Experimental, charactercreator.coax experimental_*): the
// takeoff plays over E2_TAKEOFF seconds, the loop while you are up, the landing over E2_LANDING, all
// blended at E2_JUMP_BLEND over the gait, so the legs keep their stride and the arms never fully change.
E2_AIRBORNE :: 0.03;   // metres over the ground that count as off it
E2_TAKEOFF :: 0.2; E2_LANDING :: 0.35;
E2_JUMP_BLEND :: 0.45; E2_JUMP_IN :: 0.12; E2_JUMP_OUT :: 0.18;
e2_air :: (s: [] E2, air: bool) {
  if air && !s[0].airborne { s[0].air_at = s[0].clock; }
  if !air && s[0].airborne { s[0].land_at = s[0].clock; }
  s[0].airborne = air;
}
// The jump clip at `clock`, or -1 once you have landed.
e2_jump_clip :: (air: bool, clock: f32, air_at: f32, land_at: f32) -> int {
  if air { return ifx clock - air_at < f32(E2_TAKEOFF) then figs.BD_JUMP_START else figs.BD_JUMP_LOOP; }
  if clock - land_at < f32(E2_LANDING) { return figs.BD_JUMP_LAND; }
  return -1;
}
e2_sat :: (v: f32) -> f32 { return ifx v < 0 then 0.0f32 else ifx v > 1 then 1.0f32 else v; }
e2_jump_weight :: (air: bool, clock: f32, air_at: f32, land_at: f32) -> f32 {
  if air { return f32(E2_JUMP_BLEND) * e2_sat((clock - air_at) / f32(E2_JUMP_IN)); }
  return f32(E2_JUMP_BLEND) * (1 - e2_sat((clock - land_at) / f32(E2_JUMP_OUT)));
}
// The figure to draw: the gait bd_step chose, under the jump while you are up or just down. It is a
// copy, so bd_step's own clip and stride carry on beneath it.
e2_jump_figure :: (a0: figs.BdAnim, air: bool, clock: f32, air_at: f32, land_at: f32) -> figs.BdAnim {
  j := e2_jump_clip(air, clock, air_at, land_at);
  if j < 0 || a0.clip < 0 { return a0; }
  a := a0;
  a.prev = a0.clip; a.pt0 = a0.t0; a.pphase = a0.phase;
  a.clip = j;
  a.t0 = ifx j == figs.BD_JUMP_START then clock - (clock - air_at) * figs.bd_seconds(j) / f32(E2_TAKEOFF)
    else ifx j == figs.BD_JUMP_LAND then clock - (clock - land_at) * figs.bd_seconds(j) / f32(E2_LANDING) else 0.0f32;
  a.phase = clock / figs.bd_seconds(j);
  a.fade_at = clock - f32(figs.BD_FADE) * e2_jump_weight(air, clock, air_at, land_at);
  return a;
}
#test "a jump picks takeoff, the air and landing, then gives the gait back" {
  #assert e2_jump_clip(true, 1, 1, -100) == figs.BD_JUMP_START;
  #assert e2_jump_clip(true, 1.3, 1, -100) == figs.BD_JUMP_LOOP;
  #assert e2_jump_clip(false, 1.4, 1, 1.4) == figs.BD_JUMP_LAND;
  #assert e2_jump_clip(false, 2, 1, 1.4) == -1;
}
#test "a jump eases in over the gait and back out after landing" {
  #assert e2_jump_weight(true, 1, 1, -100) == 0;
  w := e2_jump_weight(true, 1.06, 1, -100); #assert w > 0 && w < 0.45;
  #assert abs(e2_jump_weight(true, 1.3, 1, -100) - 0.45) < 0.001;
  w = e2_jump_weight(false, 1.39, 1, 1.3); #assert w > 0 && w < 0.45;
  #assert e2_jump_weight(false, 1.49, 1, 1.3) == 0;
  g: figs.BdAnim; g.clip = figs.BD_RUN; g.t0 = 0.5; g.phase = 2.25;
  a := e2_jump_figure(g, true, 1.3, 1, -100);
  #assert a.clip == figs.BD_JUMP_LOOP && a.prev == figs.BD_RUN && a.pphase == 2.25;
  out: [24] f32; figs.bd_record(a, figs.BdLook.{}, 0, false, 1.3, out[..], 0); #assert out[6] > 0.55 && out[6] < 0.60;
  // landed and settled: the gait as it was
  b := e2_jump_figure(g, false, 2, 1, 1.3); #assert b.clip == figs.BD_RUN && b.fade_at == g.fade_at;
  s: [1] E2; s[0].clock = 1; e2_you(s[..], 0, 0.5, 0, 0); #assert s[0].airborne && s[0].air_at == 1;
  s[0].clock = 1.8; e2_you(s[..], 0, 0, 0, 0); #assert !s[0].airborne && s[0].land_at == 1.8;
}
// ---- /play: where you stood, kept in this browser (host action 11; message 11 gives it back after
// the page facts and before the first frame). A line each, millimetres and milliradians:
// "e2-place 1", x=, z=, face=. Only on /play, in the world (not the studio or its run), never staged.
E2_HOST_PLACE :: 11;
E2_PLACE_HEAD :: "e2-place 1\n";
E2_PLACE_EVERY :: 2.0;     // s between keeps while you move
E2_PLACE_STEP :: 0.25;     // m: moved less than this, nothing new to keep
e2_place_int :: (t: string, key: string, ok: [] bool) -> int {
  at := 0;
  while at < t.count {
    e := at; while e < t.count && t[e] != '\n' { e += 1; }
    if e - at > key.count && t[at..<at + key.count] == key {
      j := at + key.count; neg := t[j] == '-'; if neg { j += 1; }
      v := 0; any := false;
      while j < e && t[j] >= '0' && t[j] <= '9' && v < 100000000 { v = v * 10 + cast(int)(t[j] - '0'); j += 1; any = true; }
      if !any || j != e { ok[0] = false; return 0; }
      return ifx neg then -v else v;
    }
    at = e + 1;
  }
  ok[0] = false; return 0;
}
e2_place_put :: (out: [] u8, at: int, key: string, v: int) -> int {
  o := at; for i: 0..<key.count { out[o] = key[i]; o += 1; }
  if v < 0 { out[o] = '-'; o += 1; }
  m := ifx v < 0 then -v else v; d: [12] u8; n := 0;
  while true { d[n] = cast(u8)('0' + m % 10); n += 1; m /= 10; if m == 0 { break; } }
  while n > 0 { n -= 1; out[o] = d[n]; o += 1; }
  out[o] = '\n'; return o + 1;
}
e2_place_mm :: (v: f32) -> int { return cast(int) floor(v * 1000 + 0.5); }
// The kept place, back before the first frame: you start there, and the room's first word on you
// is told it (the hello's A, as after a lost room: #13057).
e2_place_take :: (s: [] E2, t: string) {
  if !s[0].play || s[0].cz[0].on || s[0].staged || s[0].placed { return; }
  if t.count < E2_PLACE_HEAD.count || t[0..<E2_PLACE_HEAD.count] != E2_PLACE_HEAD { return; }
  ok: [1] bool; ok[0] = true;
  x := f32(e2_place_int(t, "x=", ok[..])) / 1000; z := f32(e2_place_int(t, "z=", ok[..])) / 1000; f := f32(e2_place_int(t, "face=", ok[..])) / 1000;
  if !ok[0] || !e2_may_stand(x, z) { return; }
  s[0].start_x = x; s[0].start_z = z; s[0].start_face = figs.wrap_angle(f); s[0].start_kept = true;
  s[0].kept_x = x; s[0].kept_z = z; s[0].kept_any = true;
  s[0].net[0].sat_before = true;
}
// Each frame, when the action slot is free: where you stand, if you have moved since it was last kept.
e2_place_keep :: (s: [] E2) {
  if !s[0].play || s[0].staged || !s[0].placed || s[0].action != 0 || e2c_creating(s) || e2c_running(s) { return; }
  if s[0].clock - s[0].kept_at < f32(E2_PLACE_EVERY) { return; }
  dx := s[0].you_x - s[0].kept_x; dz := s[0].you_z - s[0].kept_z;
  if s[0].kept_any && dx * dx + dz * dz < f32(E2_PLACE_STEP * E2_PLACE_STEP) { return; }
  o := 0; for i: 0..<E2_PLACE_HEAD.count { s[0].outbox[i] = E2_PLACE_HEAD[i]; } o = E2_PLACE_HEAD.count;
  o = e2_place_put(s[0].outbox[..], o, "x=", e2_place_mm(s[0].you_x));
  o = e2_place_put(s[0].outbox[..], o, "z=", e2_place_mm(s[0].you_z));
  o = e2_place_put(s[0].outbox[..], o, "face=", e2_place_mm(s[0].you_face));
  s[0].out_n = o; s[0].action = E2_HOST_PLACE;
  s[0].kept_at = s[0].clock; s[0].kept_x = s[0].you_x; s[0].kept_z = s[0].you_z; s[0].kept_any = true;
}
#test "/play keeps where you stand, once you have moved" #steps 200000000 {
  s: [1] E2; s[0].play = true;
  z := -60.0f32; x := e2_road_x(z);
  s[0].placed = true; s[0].you_x = x; s[0].you_z = z; s[0].you_face = -2.5; s[0].clock = 10;
  e2_place_keep(s[..]);
  #assert s[0].action == E2_HOST_PLACE && cast(string) s[0].outbox[0..<11] == E2_PLACE_HEAD;
  ok: [1] bool; ok[0] = true; t := cast(string) s[0].outbox[0..<s[0].out_n];
  #assert e2_place_int(t, "z=", ok[..]) == -60000 && e2_place_int(t, "face=", ok[..]) == -2500 && ok[0];
  // nothing new to keep until you move
  s[0].action = 0; s[0].clock = 20; e2_place_keep(s[..]); #assert s[0].action == 0;
  s[0].you_z = z - 1; e2_place_keep(s[..]); #assert s[0].action == E2_HOST_PLACE;
}
#test "/play starts you where you stood, told to the room; never in the studio, the woods or a broken text" #steps 200000000 {
  z := -60.0f32; x := e2_road_x(z);
  t: [96] u8; n := E2_PLACE_HEAD.count; for i: 0..<n { t[i] = E2_PLACE_HEAD[i]; }
  n = e2_place_put(t[..], n, "x=", e2_place_mm(x)); n = e2_place_put(t[..], n, "z=", -60000); n = e2_place_put(t[..], n, "face=", -2500);
  u: [1] E2; e2_message(u[..], E2_HOST_PAGE, "url=https://everglade.world/play\n");
  #assert u[0].cz[0].on;   // no character yet: the studio, and no place taken
  e2_message(u[..], E2_HOST_PLACE, cast(string) t[0..<n]); #assert !u[0].start_kept;
  u[0].cz[0].on = false;
  e2_message(u[..], E2_HOST_PLACE, "e2-place 1\nx=900000\nz=-60000\nface=0\n"); #assert !u[0].start_kept;
  e2_message(u[..], E2_HOST_PLACE, "e2-place 1\nx=1a\nz=-60000\nface=0\n"); #assert !u[0].start_kept;
  e2_message(u[..], E2_HOST_PLACE, cast(string) t[0..<n]);
  #assert u[0].start_kept && abs(u[0].start_z - z) < 0.001 && abs(u[0].start_x - x) < 0.001 && abs(u[0].start_face + 2.5) < 0.001 && u[0].net[0].sat_before;
  #assert e2_start(u[..]) && abs(u[0].you_z - z) < 0.001 && abs(u[0].you_x - x) < 0.001;
}
e2_start :: (s: [] E2) -> bool #export_c #effects(all) {
  s[0].view = e2_mode();
  if s[0].placed { return false; }
  // the glade's spot, or ?at='s point on the path, facing on along it
  z := s[0].start_z; x := ifx z < 0 then e2_road_x(z) else 0.0f32;
  face := ifx z < 0 then figs.atan2(e2_road_x(z - 2) - x, -2.0f32) else 3.14159265f32;
  if s[0].start_kept { x = s[0].start_x; face = s[0].start_face; }   // /play: where you stood last
  s[0].placed = true; s[0].you_x = x; s[0].you_z = z; s[0].you_face = face; s[0].you_y = e2_height(x, z);
  s[0].orbit = figs.metaverse_orbit_start(figs.v3(x, s[0].you_y, z), face);
  return true;
}

// ---- input
e2_key :: (s: [] E2, key: int, mods: int) -> bool #export_c #effects(all) {
  #if BUILD_DEBUG { if e2a_key(s, key) { return true; } }
  if key == -1 && e2k_area_cancel(s) { return true; }   // Esc lets an armed area go before it opens the menu
  if e2i_key(s, key) { return true; }   // the bag: B opens and shuts it; E asks for a quest's talk; Esc, E or 1 ends a line read
  if e2b_key(s, key) { return true; }   // the workbench's window: E opens it near the bench; 1 to 4 pick a kind, Esc shuts it
  if e2p_key(s, key) { return true; }   // Pansopher's talk: E opens it near him; 1 to 9 answer, Esc ends it
  if e2rv_key(s, key) { return true; }   // riding: E mounts the mount in reach or gets you down, X brings a flier down (ride-view.coax)
  if e2c_key(s, key) { return true; }
  if mlook.ml_key(s[0].ml[..], key) { return true; }
  if e2k_key(s, key) { return true; }
  if key == ' ' { s[0].held |= HOLD_JUMP; return true; }
  if key == KEY_SHIFT { s[0].shift = true; return true; }
  h := hold_bit(key); if h != 0 { s[0].held |= h; return true; }
  return false;
}
e2_key_up :: (s: [] E2, key: int, mods: int) -> bool #export_c #effects(all) {
  if key == KEY_SHIFT { s[0].shift = false; }
  if mlook.ml_key_up(s[0].ml[..], key) { return true; }
  h := ifx key == ' ' then HOLD_JUMP else hold_bit(key);
  s[0].held = s[0].held & (HOLD_ALL - h); return h != 0;
}
e2_blur :: (s: [] E2) #export_c #effects(all) { s[0].held = 0; s[0].shift = false; s[0].dragging = false; mlook.ml_blur(s[0].ml[..]); }
// A mouse drag looks round (a finger is the face's: metaverse-engine/core/sticks.coax).
e2_pointer :: (s: [] E2, x: f32, y: f32, phase: int, kind: int, id: int) -> bool #export_c #effects(all) {
  if phase == 0 { s[0].ml[0].touch = kind != 0; }
  if e2_quality_pointer(s, x, y, phase, id) { return true; }   // the GFX control
  if !s[0].cz[0].menu && e2i_pointer(s, x, y, phase) { return true; }   // the bag's button, window and the talk's prompt
  if !s[0].cz[0].menu && e2b_pointer(s, x, y, phase) { return true; }   // the workbench's prompt and window
  if !s[0].cz[0].menu && e2rv_pointer(s, x, y, phase) { return true; }
  if !s[0].cz[0].menu && e2rg_pointer(s, x, y, phase) { return true; }   // the Archery Range's RESET (range.coax)   // riding's prompt: the phone's MOUNT, DISMOUNT and LAND button
  if !s[0].cz[0].menu && e2p_pointer(s, x, y, phase) { return true; }   // Pansopher's prompt and answers
  #if BUILD_DEBUG { if e2a_pointer(s, x, y, phase) { return true; } }
  if e2c_pointer(s, x, y, phase, id) { return true; }
  if e2k_pointer(s, x, y, phase) { return true; }
  if kind != 0 { return false; }
  // a press on the world (not the bar): the mouse looks again (mouselook; the drag still orbits without it)
  if phase == 0 { mlook.ml_press(s[0].ml[..], kind); s[0].dragging = true; s[0].drag_x = x; s[0].drag_y = y; return true; }
  if phase == 1 && s[0].dragging {
    d := figs.cam_drag(x - s[0].drag_x, y - s[0].drag_y, s[0].k); s[0].look_yaw += d[0]; s[0].look_pitch += d[1];
    s[0].drag_x = x; s[0].drag_y = y; return true;
  }
  if phase == 2 { s[0].dragging = false; return true; }
  return false;
}
// host.js's pointer with its button (0 left, 2 right): the cast's and the bow's first
// (everglade/client/mouse.coax), then the rest as e2_pointer.
e2_pointer_buttons :: (s: [] E2, x: f32, y: f32, phase: int, kind: int, id: int, button: int) -> bool #export_c #effects(all) {
  if phase == 0 { s[0].ml[0].touch = kind != 0; }
  if !s[0].cz[0].menu && e2i_pointer(s, x, y, phase) { return true; }   // the bag's window before a click casts
  if !s[0].cz[0].menu && e2b_pointer(s, x, y, phase) { return true; }   // the workbench's window before a click casts
  if !s[0].cz[0].menu && e2p_pointer(s, x, y, phase) { return true; }   // his answers before a click casts
  // an armed area: a left click casts it where it shows, a right click lets it go
  if phase == 0 && !s[0].cz[0].menu && s[0].casts[0].area[0].on { if button == 2 { _ := e2k_area_cancel(s); } else { _ := e2k_area_confirm(s); } return true; }
  if !s[0].cz[0].menu && e2m_buttons(s, phase, kind, button) { return true; }   // the Esc menu's clicks are its own
  return e2_pointer(s, x, y, phase, kind, id);
}
e2_wheel :: (s: [] E2, dy: f32) -> bool #export_c #effects(all) {
  if e2c_wheel(s, dy) { return true; }
  #if BUILD_DEBUG { if e2a_wheel(s, dy) { return true; } }
  s[0].orbit = figs.cam_wheel(s[0].orbit, dy); return true;
}
// Mouselook, the host's face: whether the pointer is wanted, the mouse's travel while held, and what
// the browser did (metaverse-engine/cam/mouselook.coax). The turn goes the way a drag's does.
// No OS cursor while the reticle is up (host.js cursor 4): the reticle is the pointer.
e2_cursor :: (s: [] E2) -> int #export_c #effects(all) { return ifx s[0].ml[0].shown > 0.01 then 4 else 0; }
e2_mouselook :: (s: [] E2) -> int #export_c #effects(all) { return mlook.ml_host(s[0].ml[0]); }
e2_look_delta :: (s: [] E2, dx: f32, dy: f32) #export_c #effects(all) {
  t := mlook.ml_turn(s[0].ml[0], dx, dy); s[0].look_yaw -= t[0]; s[0].look_pitch -= t[1];
}
e2_pointer_lock :: (s: [] E2, status: int) #export_c #effects(all) { mlook.ml_lock(s[0].ml[..], status); if status == 1 { s[0].dragging = false; } }
// The reticle at the view's centre while the mouse looks (the shared one: metaverse-engine/cam/reticle.coax),
// warmer over one of the others.
e2_reticle :: (s: [] E2, out: [] f32, at: int) -> int {
  m := s[0].ml[0]; if m.shown <= 0.01 { return at; }
  k := s[0].k; cx := s[0].width * 0.5; cy := s[0].cy;
  over := false; e := s[0].eye; f := s[0].fwd; r := s[0].right; up := s[0].up;
  for i: 0..<s[0].head_n {
    p := s[0].heads[i]; dx := p.x - e[0]; dy := p.y - 0.8 - e[1]; dz := p.z - e[2];
    z := dx * f[0] + dy * f[1] + dz * f[2]; if z < 0.5 { continue; }
    sx := cx + s[0].focal * (dx * r[0] + dy * r[1] + dz * r[2]) / z; sy := cy - s[0].focal * (dx * up[0] + dy * up[1] + dz * up[2]) / z;
    reach := 26 * k + s[0].focal * 0.5 / z;
    if (sx - cx) * (sx - cx) + (sy - cy) * (sy - cy) < reach * reach { over = true; }
  }
  st: [reticle.RETICLE_MAX] reticle.ReticleStroke;
  sn := reticle.reticle_strokes(st[..], cx, cy, k, m.shown * 0.9, 0, 0);
  n := at;
  // a dark edge under it, so it reads on a bright coat or the sky
  for i: 0..<sn { q := st[i]; if cc.lit(out, n, q.ax, q.ay, q.bx, q.by, q.width + 1.6 * k, q.alpha * 0.45, 0.5, 0.05, 0.05, 0.06, 0) { n += 6; } }
  for i: 0..<sn { q := mlook.ml_tint(st[i], over); if cc.lit(out, n, q.ax, q.ay, q.bx, q.by, q.width, q.alpha, 0.5, q.r, q.g, q.b, 0) { n += 6; } }
  return n;
}
// The way you face as drawn and as you cast: in mouselook the camera's way, as far as its fade has
// come (A and D strafe, S backpedals); otherwise where the walk turned you.
e2_show_face :: (s: [] E2) -> f32 {
  m := s[0].ml[0].shown; if m <= 0 { return s[0].you_face; }
  return figs.wrap_angle(s[0].you_face + figs.wrap_angle(s[0].orbit.yaw - s[0].you_face) * m);
}
#test "mouselook faces you the camera's way and frames you below and left of the reticle" {
  s: [1] E2; s[0].you_face = 0; s[0].orbit.yaw = 1.0;
  #assert e2_show_face(s[..]) == 0;
  s[0].ml[0].shown = 1; #assert abs(e2_show_face(s[..]) - 1.0) < 0.001;
  shot := figs.Shot.{}; shot.eye = figs.v3(0, 2, 4); shot.at = figs.v3(0, 1.5, 0);   // looking down -z
  t := figs.cam_shoulder_shot(shot, s[0].ml[0].shown);
  #assert t.eye.x > 0.6 && t.at.x > 0.6 && t.eye.y > 2.5 && abs(t.eye.z - 4) < 0.001;   // right and up: you below and left
  s[0].ml[0].shown = 0; t = figs.cam_shoulder_shot(shot, s[0].ml[0].shown); #assert t.eye.x == 0;
}
e2_look :: (s: [] E2, dyaw: f32, dpitch: f32, zoom: f32) #export_c #effects(all) {
  s[0].look_yaw += dyaw; s[0].look_pitch += dpitch;
  s[0].orbit = figs.cam_pinch(s[0].orbit, zoom);
}

// ---- the frame: the follow camera, the uniforms
// ---- the look up: the Metaverse Engine's centred follow mode (metaverse-engine/cam/modes.coax, #12994), first written here
// from Everglade Experimental's camera. The pitch goes 1.2 rad above the horizon (the shared orbit
// stops at 0.55). The eye sits on a line straight back from your head, centred on you at every pitch.
// Looking up swings the eye down behind you until it meets the land, 0.2 m over it; past that the eye
// holds where it met the ground and the look tilts on up, the aim rising up to 2 m over your head, as
// a camera pressed to the ground does in WoW. Nothing jumps as the eye reaches the ground.
// The mode's record: the shared defaults are Everglade II's.
e2_mode :: () -> figs.CamMode { return figs.CamMode.{id = figs.CamModeId.follow}; }
E2_CAM_REACH :: 13.0;   // metres of land round the pivot the camera's ground ring holds (the farthest zoom and a cell)
e2_familiar_shot :: (s:[]E2,shot:figs.Shot)->figs.Shot {
  f:=e2n_familiar_view(s[0].net[..]);
  if !f.live { return shot; }
  eye:=figs.v3(f.x,e2_height(f.x,f.z)+0.45,f.z);
  seen:=shot;
  seen.eye=eye;
  seen.at=figs.v3(eye.x+shot.at.x-shot.eye.x,eye.y+shot.at.y-shot.eye.y,eye.z+shot.at.z-shot.eye.z);
  return seen;
}
#test "a drag looks up past the horizon, centred on you; on the land the eye holds and the view tilts on up" #steps 400000000 {
  s: [1] E2; s[0].k = 1; s[0].plant_done = true;
  e2_you(s[..], 0, 0, 0, 3.14159265); s[0].orbit = figs.metaverse_orbit_start(figs.v3(0, s[0].you_y, 0), 3.14159265);
  s[0].orbit.want = 4; s[0].orbit.zoom = 4; s[0].view = e2_mode();
  // from looking down to looking up, a step at a time: centred, over the land, and no jump
  last := figs.Shot.{}; lastp := -1.0f32; pressed := false;
  _ := e2_pointer(s[..], 700, 0, 0, 0, 1);
  for i: 0..<120 {
    _ = e2_pointer(s[..], 700, f32(900 - i * 15), 1, 0, 1);
    e2_chase_step(s[..], 1.0f32 / 30);
    shot := figs.cam_shot(s[0].view, s[0].orbit, s[0].eye_pitch, s[0].press);
    #assert figs.cam_off_axis(shot, s[0].you_x, s[0].you_z) < 0.01;
    #assert shot.eye.y >= e2_height(shot.eye.x, shot.eye.z) + 0.19;
    if s[0].press > 0 { pressed = true; }
    if i > 1 {
      // each step turns the pitch 0.08 rad: the eye moves a little round the orbit, and the aim lifts a little
      dx := shot.eye.x - last.eye.x; dy := shot.eye.y - last.eye.y; dz := shot.eye.z - last.eye.z;
      #assert sqrt(dx * dx + dy * dy + dz * dz) < 0.4;
      #assert abs(s[0].press - lastp) < 0.1;
    }
    last = shot; lastp = s[0].press;
  }
  _ = e2_pointer(s[..], 700, 0, 2, 0, 1);
  #assert pressed && s[0].orbit.pitch < -1.0 && s[0].orbit.pitch >= -1.2;
  // all the way up on the land: the eye stays back from you (you don't fill the view), and it
  // looks up over your head, so you stand low in the middle of the screen
  shot := figs.cam_shot(s[0].view, s[0].orbit, s[0].eye_pitch, s[0].press);
  ex := s[0].you_x - shot.eye.x; ez := s[0].you_z - shot.eye.z;
  #assert sqrt(ex * ex + ez * ez) > 2.5;
  vx := shot.at.x - shot.eye.x; vy := shot.at.y - shot.eye.y; vz := shot.at.z - shot.eye.z; vl := sqrt(vx * vx + vy * vy + vz * vz);
  #assert vy / vl > 0.3;
  // your head is below the view's middle
  hx := s[0].you_x - shot.eye.x; hy := s[0].you_y + 1.7 - shot.eye.y; hz := s[0].you_z - shot.eye.z; hl := sqrt(hx * hx + hy * hy + hz * hz);
  #assert hy / hl < vy / vl;
}
// The follow camera this frame (metaverse-engine/cam/chase.coax): the look, the keys and the walk move the
// orbit, then its room before this zone's land (the camera's ground ring, from e2_height) and the
// trunks round the pivot.
e2_chase_step :: (s: [] E2, dt: f32) {
  s[0].ml[0].able = s[0].placed && !e2c_creating(s) && !e2c_running(s) && !e2_wants_text(s) && !s[0].cz[0].menu;
  mlook.ml_step(s[0].ml[..], dt);
  h := s[0].held;
  in := figs.CamChaseIn.{look_yaw = s[0].look_yaw, look_pitch = s[0].look_pitch, turn = axis(h, HOLD_LEFT, HOLD_RIGHT), tilt = axis(h, HOLD_UP, HOLD_DOWN),
    zoom = axis(h, HOLD_OUT, HOLD_IN), feet = figs.v3(s[0].you_x, s[0].you_y, s[0].you_z), heading = s[0].you_face, moving = s[0].anim[0].speed > 0.6,
    held = mlook.ml_on(s[0].ml[0]), look_up = true};
  // the camera eases round behind the walk (and Character Create's run)
  if s[0].autowalk || e2c_running(s) { in.behind = true; in.behind_heading = e2_auto_heading(s[0].you_x, s[0].you_z); }
  s[0].look_yaw = 0; s[0].look_pitch = 0;
  // riding, the camera pulls back and up to see the mount (everglade/client/ride-view.coax e2rv_cam)
  rc := e2rv_cam(s); in.feet.y += rc.up;
  seat := figs.cam_chase_seat(s[0].orbit, rc.back, s[0].ride_back); s[0].orbit = seat.orbit; s[0].ride_back = seat.had;
  o := figs.cam_chase_orbit(s[0].view, s[0].orbit, in, dt);
  // the land round the pivot: only the cells the ring lacks
  cells: [7000] int; g := s[0].ground[..];
  n := figs.cam_ground_next(g, o.pivot.x, o.pivot.z, f32(E2_CAM_REACH), cells[..]);
  for k: 0..<n { i := cells[k * 2]; j := cells[k * 2 + 1]; figs.cam_ground_put(g, i, j, e2_height(figs.cam_ground_x(g, i), figs.cam_ground_x(g, j))); }
  // the trunks between the eye and you, in the cells round the pivot
  spheres: [figs.CAM_TRUNKS * 3 * 4] f32; sn := 0; pv := o.pivot;
  ci := cast(int) floor((pv.x - f32(E2_CELL_X0)) / f32(E2_CELL)); cj := cast(int) floor((f32(E2_CELL_Z0) - pv.z) / f32(E2_CELL));
  for dj: -1..<2 { for di: -1..<2 {
    i := ci + di; j := cj + dj;
    if i < 0 || j < 0 || i >= E2_CELLS_X || j >= E2_CELLS_Z || !s[0].plant_done { continue; }
    c := j * E2_CELLS_X + i;
    for q: s[0].first[c]..<s[0].first[c + 1] {
      kit := cast(int) s[0].kinds[q];
      if kit >= E2_TREES { continue; }
      qo := q * E2_ITEM_FLOATS;
      // a pine's boughs reach out at the eye's height; the others' crowns start above it
      sn = figs.cam_trunk(spheres[..], sn, pv, s[0].items[qo], s[0].items[qo + 2], ifx kit >= 10 then 2.2 * s[0].items[qo + 5] else 0.30 * s[0].items[qo + 5] + 0.35);
    }
  }}
  c := figs.cam_chase_settle(s[0].view, g, o, spheres[0..<sn * 12], dt);
  s[0].orbit = c.orbit; s[0].eye_pitch = c.eye_pitch; s[0].press = c.press;
}
// ---- the graphics governor (metaverse-engine/core/quality.coax, as Everglade's everglade-quality.coax): in AUTO
// it draws fewer pixels when frames run long and more again when they keep on time, so the page
// holds 60 frames a second. It starts from the page's facts (the device, ?quality= and the tier this
// browser kept, e2_quality_facts) on the first frame with a size; the face asks it for the host's
// pixel budget. A golden frame holds the rung its screen's size alone gives, so a golden is the
// same on every machine.
ACT_QUALITY :: 6;   // host.js: the tier to keep in verse.quality
e2_quality_facts :: (s: [] E2, t: string) {
  s[0].q_dev = quality_device_from_facts(t); s[0].q_mode = quality_mode_from_facts(t);
  s[0].q_tell = quality_url_new(t); s[0].q_facts = true;
  for c: 0..<QUALITY_CLASSES { s[0].q_settled[c] = quality_settled_from_facts(t, c); }
  s[0].q_ready = false;   // started again from these facts on the next frame
}
// The GPU's facts (host.js message 613, once the adapter opens): the device's class may change
// with them, so the governor starts again, unless the measured start has already begun.
E2_HOST_GPU :: 613;
ACT_SETTLED :: 33;   // host.js: the rung AUTO settled at, kept in verse.quality.settled
e2_quality_gpu :: (s: [] E2, t: string) {
  v := quality_fact(t, "gpu_vendor"); a := quality_fact(t, "gpu_arch");
  s[0].gpu_vendor_n = 0; for c: v { if s[0].gpu_vendor_n < 24 { s[0].gpu_vendor[s[0].gpu_vendor_n] = c; s[0].gpu_vendor_n += 1; } }
  s[0].gpu_arch_n = 0; for c: a { if s[0].gpu_arch_n < 24 { s[0].gpu_arch[s[0].gpu_arch_n] = c; s[0].gpu_arch_n += 1; } }
  g := quality_gpu_from_facts(t);
  if g == s[0].q_dev.gpu { return; }
  s[0].q_dev.gpu = g;
  if !s[0].q[0].probed && s[0].q[0].probe < 0 { s[0].q_ready = false; }
}
e2_quality_device :: (s: [] E2, w: f32, h: f32, dpr: f32) -> QualityDevice {
  d: QualityDevice; if s[0].q_facts && !s[0].golden { d = s[0].q_dev; }
  k := ifx dpr > 0.01 then dpr else 1.0f32;
  if w >= 1 && h >= 1 { d.css_w = w / k; d.css_h = h / k; d.dpr = k; }
  return d;
}
e2_quality_frame :: (s: [] E2, dt: f32, w: f32, h: f32, dpr: f32, golden: bool) #export_c #effects(all) {
  e2_quality_govern(s, dt, w, h, dpr, golden); e2_knobs_frame(s, dt);
}
e2_quality_govern :: (s: [] E2, dt: f32, w: f32, h: f32, dpr: f32, golden: bool) {
  s[0].golden = golden;
  if !s[0].q_ready || golden {
    if w < 1 || h < 1 { return; }
    d := e2_quality_device(s, w, h, dpr);
    if golden { quality_start(s[0].q[..], d, QUALITY_AUTO); s[0].q_ready = true; return; }
    k := quality_device_class(d);
    quality_start_settled(s[0].q[..], d, s[0].q_mode, ifx s[0].q_facts then s[0].q_settled[k] else -1); s[0].q_ready = true; return;
  }
  // the measured start: the first frames once the scene draws (quality_probe_begin)
  if !s[0].q[0].probed && s[0].q[0].probe < 0 && s[0].plant_done && s[0].kits && s[0].draw_n > 0 { quality_probe_begin(s[0].q[..]); }
  _ := quality_frame(s[0].q[..], dt);
  if quality_settled_due(s[0].q[..]) && s[0].action == 0 && !s[0].q_tell {
    s[0].out_n = quality_settled_text(s[0].outbox[..], s[0].q[0].kind, s[0].q[0].rung);
    s[0].action = ACT_SETTLED; quality_settled_kept(s[0].q[..]); return;
  }
  if s[0].q_tell && s[0].action == 0 {
    s[0].out_n = quality_put(s[0].outbox[..], 0, QUALITY_HOST[s[0].q[0].mode]);
    s[0].action = ACT_QUALITY; s[0].q_tell = false;
  }
}
// The pixels a frame draws at most: the governor's; before it starts, the start rung's for the
// device the facts (or the canvas) give; 0 when there is neither yet.
e2_pixel_budget :: (s: [] E2, w: f32, h: f32, dpr: f32) -> int #export_c #effects(all) {
  k := ifx dpr > 0.01 then dpr else 1.0f32;
  if s[0].q_ready { return quality_pixels(s[0].q[..], w / k, h / k); }
  d := e2_quality_device(s, w, h, dpr);
  return quality_start_pixels(d, s[0].q_mode);
}
// The control, left of the frame rate on its line: "GFX AUTO · MED", or the tier the player picked.
// A tap or a click on it picks the next (quality_next), and the host keeps it (action 6).
e2_gfx_control :: (s: [] E2, out: [] f32, at: int, right: f32, base: f32) -> int {
  s[0].q_box = cc.Box.{};
  if s[0].golden || !s[0].q_ready { return at; }
  k := s[0].k; l: [32] u8; t := quality_label(s[0].q[..], l[..]); bx: [1] cc.Box;
  // e2_fps keeps its line clear of the bar (e2_fps_clear); Everglade's control (everglade/hud/windows.coax eg_gfx)
  n := eg_gfx(s[0].creator[0].ui, out, at, t, e2c_text_w(t, 13 * k), right, base, k, s[0].q_finger >= 0, bx[..]);
  s[0].q_box = bx[0];
  return n;
}
e2_quality_pointer :: (s: [] E2, x: f32, y: f32, phase: int, id: int) -> bool {
  if phase == 0 {
    if !e2c_inside(s[0].q_box, x, y) { return false; }
    s[0].q_finger = id; return true;
  }
  if s[0].q_finger < 0 || id != s[0].q_finger { return false; }
  if phase >= 2 {
    s[0].q_finger = -1;
    if phase == 2 && e2c_inside(s[0].q_box, x, y) { e2_quality_pick(s, quality_next(s[0].q[0].mode)); }
  }
  return true;
}
e2_quality_pick :: (s: [] E2, mode: int) {
  quality_choose(s[0].q[..], mode); s[0].q_mode = s[0].q[0].mode; s[0].q_tell = true;
}
// ---- the rung's knobs, as the frame uses them (metaverse-engine/core/quality.coax quality_rung_knobs)
// grass: the grass field's reach (e2_field, the shader's u[35]); fine: the finest grass tier's share
// (u[36]); scenery: the kit pieces' reach (e2_pieces); shadow: 0 no tiles, under 0.5 the nearest tile
// only, under 1 the full set with the nearest redrawn every other frame and six filter taps
// (e2_shadows); post: 1 the full post pass, under 1 no foliage filter and the glow from the quarter
// chain alone, under 0.45 no contact shade, no edge smoothing and plain glass (u[37],
// e2_bloom_passes); crowd: the share of other players drawn (e2_remotes_draw).
// The studio, while you make your character below HIGH, trims what stands behind its panes. The
// reaches ease at E2_KNOB_EASE a second, so a change thins or fills in through the pieces' own
// dither over about 3 s (the run-out's length) and nothing pops; the others step.
E2_KNOB_EASE :: 0.34;
E2_STUDIO_GRASS :: 0.45;
E2_STUDIO_SCENERY :: 0.7;
E2_STUDIO_SHADOW :: 0.3;
E2_STUDIO_POST :: 0.6;
e2_knob_target :: (s: [] E2) -> QualityKnobs {
  if !s[0].q_ready { return QualityKnobs.{}; }
  k := quality_rung_knobs(s[0].q[0].rung);
  if e2c_creating(s) && quality_tier(s[0].q[..]) != QUALITY_HIGH {
    k.grass = ifx k.grass < E2_STUDIO_GRASS then k.grass else E2_STUDIO_GRASS;
    k.scenery = ifx k.scenery < E2_STUDIO_SCENERY then k.scenery else E2_STUDIO_SCENERY;
    k.shadow = ifx k.shadow < E2_STUDIO_SHADOW then k.shadow else E2_STUDIO_SHADOW;
    k.post = ifx k.post < E2_STUDIO_POST then k.post else E2_STUDIO_POST;
  }
  return k;
}
e2_knob_ease :: (at: f32, to: f32, dt: f32) -> f32 {
  step := f32(E2_KNOB_EASE) * (ifx dt > 0.25 then 0.25f32 else dt);
  return ifx to > at + step then at + step else ifx to < at - step then at - step else to;
}
e2_knobs_frame :: (s: [] E2, dt: f32) {
  t := e2_knob_target(s);
  if s[0].golden || !s[0].kn_ready { s[0].kn = t; s[0].kn_ready = s[0].q_ready; return; }
  k := s[0].kn;
  k.grass = e2_knob_ease(k.grass, t.grass, dt); k.fine = e2_knob_ease(k.fine, t.fine, dt); k.scenery = e2_knob_ease(k.scenery, t.scenery, dt);
  k.scale = t.scale; k.debris = t.debris; k.fx = t.fx; k.shadow = t.shadow; k.post = t.post; k.crowd = t.crowd;
  s[0].kn = k;
}
// The host's bloom passes this frame (coaxial_bloom_passes_v1, coax/web/host.js): all five, the
// quarter chain's three, or none (the post pass then reads no glow).
e2_bloom_passes :: (s: [] E2) -> int #export_c #effects(all) {
  p := s[0].kn.post; return ifx p >= 0.99 then 5 else ifx p >= 0.45 then 3 else 0;
}
#test "e2 quality: graphics start from the page's facts: a phone held sideways starts at MED or lower; ?quality=low holds LOW" #steps 60000000 {
  s: [1] E2;
  e2_message(s[..], E2_HOST_PAGE, QUALITY_FACTS_IPHONE_SIDE);
  #assert e2_pixel_budget(s[..], 0, 0, 0) == 844 * 390;   // before the first frame: the start rung's (a phone's: LOW, #13190)
  e2_quality_frame(s[..], 0, 844 * 3, 390 * 3, 3, false);
  #assert s[0].q_ready && quality_auto(s[0].q[..]) && s[0].q[0].rung <= QUALITY_TIER_RUNG[QUALITY_MEDIUM];
  #assert e2_pixel_budget(s[..], 844 * 3, 390 * 3, 3) <= cast(int) (844.0 * 390.0 * 2.25);
  l: [1] E2;
  e2_message(l[..], E2_HOST_PAGE, "url=https://everglade.world/play?quality=low\nvw=1440\nvh=900\ndpr=2\ncores=10\nquality=high");
  e2_quality_frame(l[..], 0, 2880, 1800, 2, false);
  #assert !quality_auto(l[0].q[..]) && quality_tier(l[0].q[..]) == QUALITY_LOW;
  for i: 0..<600 { e2_quality_frame(l[..], 0.05, 2880, 1800, 2, false); }
  #assert quality_tier(l[0].q[..]) == QUALITY_LOW;
  // the URL's pick is told to the host to keep, once
  #assert l[0].action == ACT_QUALITY && cast(string) l[0].outbox[0..<l[0].out_n] == "low";
  e2_action_done(l[..]); e2_quality_frame(l[..], 0.016, 2880, 1800, 2, false); #assert l[0].action == 0;
}
#test "e2 quality: a computer with no pick starts at HIGH; the facts coming later start it again from them" {
  c: [1] E2; e2_quality_frame(c[..], 0, 2880, 1800, 2, false); #assert quality_tier(c[0].q[..]) == QUALITY_HIGH;
  e2_message(c[..], E2_HOST_PAGE, QUALITY_FACTS_IPAD); e2_quality_frame(c[..], 0, 2732, 2048, 2, false);
  #assert quality_tier(c[0].q[..]) == QUALITY_MEDIUM;
}
#test "e2 quality: each rung down draws no more: the grass's and scenery's reach, the shadow tiles, the post pass and the crowd" {
  s: [1] E2; s[0].q_ready = true; quality_start(s[0].q[..], QualityDevice.{}, QUALITY_AUTO);
  last := QualityKnobs.{}; last_bloom := 5;
  for i: 0..<QUALITY_RUNGS { r := QUALITY_RUNGS - 1 - i; s[0].q[0].rung = r; s[0].kn_ready = false; e2_knobs_frame(s[..], 0);
    k := s[0].kn;
    #assert k.grass <= last.grass && k.fine <= last.fine && k.scenery <= last.scenery && k.shadow <= last.shadow && k.post <= last.post && k.crowd <= last.crowd;
    #assert e2_bloom_passes(s[..]) <= last_bloom && quality_share(E2_REMOTES, k.crowd, 1) >= 1;
    for t: 0..<E2_FIELD_TIERS { #assert e2_field_out_r(t, k.grass, k.fine) <= e2_field_out_r(t, last.grass, last.fine) + 0.0001; }
    last = k; last_bloom = e2_bloom_passes(s[..]); }
  // the top rung is the whole picture: every knob 1, all five bloom passes
  s[0].q[0].rung = QUALITY_RUNGS - 1; s[0].kn_ready = false; e2_knobs_frame(s[..], 0);
  #assert s[0].kn.grass == 1 && s[0].kn.fine == 1 && s[0].kn.scenery == 1 && s[0].kn.shadow == 1 && s[0].kn.post == 1 && e2_bloom_passes(s[..]) == 5;
  // the lowest: no shadow tiles, no bloom
  s[0].q[0].rung = 0; s[0].kn_ready = false; e2_knobs_frame(s[..], 0); #assert s[0].kn.shadow == 0 && e2_bloom_passes(s[..]) == 0;
}
#test "e2 quality: the studio trims what stands behind its panes below HIGH, and the run-out eases it back with nothing popping" {
  s: [1] E2; s[0].q_ready = true; quality_start(s[0].q[..], QualityDevice.{}, QUALITY_AUTO);
  s[0].cz[0].on = true; s[0].cz[0].walking = false;
  // at HIGH the studio is whole
  s[0].q[0].rung = QUALITY_RUNGS - 1; s[0].kn_ready = false; e2_knobs_frame(s[..], 0);
  #assert s[0].kn.grass == 1 && s[0].kn.scenery == 1 && s[0].kn.shadow == 1 && s[0].kn.post == 1;
  // at MED: trimmed to the studio's
  med := QUALITY_TIER_RUNG[QUALITY_MEDIUM]; s[0].q[0].rung = med; s[0].kn_ready = false; e2_knobs_frame(s[..], 0);
  #assert s[0].kn.grass <= f32(E2_STUDIO_GRASS) && s[0].kn.scenery <= f32(E2_STUDIO_SCENERY) && s[0].kn.shadow <= f32(E2_STUDIO_SHADOW) && s[0].kn.post <= f32(E2_STUDIO_POST);
  // the run-out: the reaches climb back at most E2_KNOB_EASE a second, and are whole within 3.5 s
  s[0].cz[0].walking = true; want := quality_rung_knobs(med);
  g := s[0].kn.grass; sc := s[0].kn.scenery;
  for i: 0..<210 { e2_knobs_frame(s[..], 1.0 / 60.0);
    #assert s[0].kn.grass >= g && s[0].kn.grass - g <= f32(E2_KNOB_EASE) / 60 + 0.0001 && s[0].kn.scenery - sc <= f32(E2_KNOB_EASE) / 60 + 0.0001;
    g = s[0].kn.grass; sc = s[0].kn.scenery; }
  #assert s[0].kn.grass == want.grass && s[0].kn.scenery == want.scenery && s[0].kn.shadow == want.shadow && s[0].kn.post == want.post;
  // golden frames hold the top rung's knobs whatever the studio
  s[0].cz[0].walking = false; s[0].golden = true; s[0].q[0].rung = QUALITY_RUNGS - 1; e2_knobs_frame(s[..], 0.016);
  #assert s[0].kn.grass == 1 && s[0].kn.post == 1 && e2_bloom_passes(s[..]) == 5;
}
#test "e2 quality: the shadow knob: no tiles, the nearest only, or the full set" #steps 100000000 {
  s: [1] E2; u: [E2_UNIFORM_FLOATS] f32;
  e2_shadow_event(s[..], 0, 0); s[0].eye = [3]f32.[3, 2, -150]; e2_light(s[..], u[..]);
  s[0].kn.shadow = 1; e2_shadows(s[..], u[..]); #assert s[0].casc[0].tier.count == s[0].casc_n && u[E2_U_CASCADE + CASCADE_HEADER + 23] == 0;
  s[0].kn.shadow = 0.3; e2_shadows(s[..], u[..]); #assert s[0].casc[0].tier.count == 1 && u[E2_U_CASCADE] == 1 && u[E2_U_CASCADE + CASCADE_HEADER + 23] == 1;
  s[0].kn.shadow = 0; e2_shadows(s[..], u[..]); #assert u[E2_U_CASCADE] == 0 && s[0].casc[0].draw == -1;
  // back to the full set: the tiles left out are drawn again before they are used
  s[0].kn.shadow = 1; e2_shadows(s[..], u[..]); #assert s[0].casc[0].tier.count == s[0].casc_n && !s[0].casc[0].slot[s[0].casc_n - 1].drawn;
}
#test "e2 quality: the GPU's facts and the kept rung start it; the measured start runs once the scene draws, and a settled rung is told to the host" #steps 80000000 {
  s: [1] E2;
  e2_message(s[..], E2_HOST_PAGE, "url=https://everglade.world/play\nvw=1366\nvh=657\nsw=1366\nsh=768\ndpr=1\ncores=8\nmemory=8\nquality=");
  e2_quality_frame(s[..], 0, 1366, 657, 1, false); #assert s[0].q[0].kind == QUALITY_DESKTOP && quality_tier(s[0].q[..]) == QUALITY_HIGH;
  // an Intel laptop's GPU, said once the adapter opens: started again as a laptop
  e2_message(s[..], E2_HOST_GPU, "gpu_vendor=intel\ngpu_arch=gen-12lp\ngpu_fallback=0");
  #assert !s[0].q_ready; e2_quality_frame(s[..], 0, 1366, 657, 1, false);
  #assert s[0].q[0].kind == QUALITY_LAPTOP && s[0].q[0].rung == QUALITY_CLASS_RUNG[QUALITY_LAPTOP] && e2_probe(s[..], 170) == QUALITY_GPU_BUILTIN;
  // no scene yet: no measuring; once it draws, slow frames step it down at once
  for i: 0..<30 { e2_quality_frame(s[..], 0.05, 1366, 657, 1, false); } #assert s[0].q[0].probe < 0 && !s[0].q[0].probed;
  s[0].plant_done = true; s[0].kits = true; s[0].draw_n = 1;
  for i: 0..<60 { if s[0].q[0].probed { break; } e2_quality_frame(s[..], 0.05, 1366, 657, 1, false); }
  #assert s[0].q[0].probed && e2_probe(s[..], 171) == QUALITY_CLASS_RUNG[QUALITY_LAPTOP] && e2_probe(s[..], 172) == s[0].q[0].rung && s[0].q[0].rung < QUALITY_CLASS_RUNG[QUALITY_LAPTOP] - 1;
  // held 20 s: the host keeps it (action 33), once
  for i: 0..<1300 { e2_quality_frame(s[..], 0.0178, 1366, 657, 1, false); if s[0].action == ACT_SETTLED { break; } }
  told := cast(string) s[0].outbox[0..<s[0].out_n];
  #assert s[0].action == ACT_SETTLED && told.count >= 5 && told[0..<4] == "3/3/";
  e2_action_done(s[..]);
  for i: 0..<100 { e2_quality_frame(s[..], 0.0178, 1366, 657, 1, false); } #assert s[0].action != ACT_SETTLED;
  // the next visit: the kept rung is where AUTO starts
  n: [1] E2;
  e2_message(n[..], E2_HOST_PAGE, "url=https://everglade.world/play\nvw=1366\nvh=657\nsw=1366\nsh=768\ndpr=1\ncores=8\ngpu_vendor=intel\nsettled=3/3/4\nquality=");
  e2_quality_frame(n[..], 0, 1366, 657, 1, false); #assert n[0].q[0].rung == 4 && n[0].q[0].start == 4;
}
#test "e2 quality: golden frames hold the screen's rung; the GFX control is hidden there" {
  s: [1] E2; e2_message(s[..], E2_HOST_PAGE, QUALITY_FACTS_INTEL);
  e2_message(s[..], E2_HOST_PAGE, "url=/worlds/character-creator\nvw=1280\nvh=800\ndpr=1\ncoarse=1\ntouch=5\ncores=2\nsw=800\nsh=600\nquality=low");
  for i: 0..<600 { e2_quality_frame(s[..], 0.05, 1280, 800, 1, true); }
  #assert s[0].q[0].rung == QUALITY_RUNGS - 1;
  out: [4096] f32; #assert e2_gfx_control(s[..], out[..], 0, 1200, 780) == 0 && s[0].q_box.x1 <= s[0].q_box.x0;
}
#test "e2 quality: the GFX control beside the frame rate, a finger's size; a tap picks the next and the host keeps it" {
  s: [1] E2; s[0].width = 1170; s[0].height = 2532; s[0].k = 3;
  e2_message(s[..], E2_HOST_PAGE, QUALITY_FACTS_IPHONE); e2_quality_frame(s[..], 0, 1170, 2532, 3, false);
  out: [4096] f32;
  n := e2_gfx_control(s[..], out[..], 0, 1000, 2480);
  b := s[0].q_box;
  #assert n > 0 && b.x1 > b.x0 && b.x1 <= 1020 && b.y1 - b.y0 >= 44 * 3 - 0.01;
  cx := (b.x0 + b.x1) / 2; cy := (b.y0 + b.y1) / 2;
  #assert e2_pointer(s[..], cx, cy, 0, 1, 4) && e2_pointer(s[..], cx, cy, 2, 1, 4);
  #assert !quality_auto(s[0].q[..]) && quality_tier(s[0].q[..]) == QUALITY_HIGH && s[0].q_finger == -1;
  e2_quality_frame(s[..], 0.016, 1170, 2532, 3, false);
  #assert s[0].action == ACT_QUALITY && cast(string) s[0].outbox[0..<s[0].out_n] == "high";
  e2_action_done(s[..]);
  // HIGH, MED, LOW, then AUTO again
  for m: 0..<3 { #assert e2_pointer(s[..], cx, cy, 0, 1, 5) && e2_pointer(s[..], cx, cy, 2, 1, 5); }
  #assert quality_auto(s[0].q[..]) && s[0].q[0].rung == s[0].q[0].start;
  #assert !e2_quality_pointer(s[..], 5, 5, 0, 9);   // elsewhere: not the control's
}
// ---- the frame rate, bottom right, always shown: frames over the last half second or so
e2_fps_count :: (s: [] E2, dt: f32) {cc.fps_count(s[0].fps_counter[..],dt);}
e2_fps :: (s: [] E2, out: [] f32, at: int, dt: f32) -> int {
 e2_fps_count(s,dt);h:=s[0].height;k:=s[0].k;s[0].q_box=cc.Box.{};
 // on a phone's studio held upright it sits over the sheet, clear of its tabs (e2c_layout)
 if s[0].cz[0].mobile && !s[0].cz[0].wide && e2c_shown(s)>0.003 {h=s[0].cz[0].sheet.y0-2*k;}
 if s[0].cz[0].arriving && e2c_shown(s)<0.5 {return at;}   // through the portal: with the wardrobe
 // the GFX control to its left, on its line (cc.fps_draw's: "NN FPS" at 13 px, 16 px in from the corner)
 v:=cast(int)(s[0].fps_counter[0].fps+0.5);if v>999 {v=999;}buf:[8]u8;m:=0;
 if v>=100 {buf[m]=cast(u8)(48+v/100);m+=1;}if v>=10 {buf[m]=cast(u8)(48+v/10%10);m+=1;}buf[m]=cast(u8)(48+v%10);m+=1;
 m=quality_put(buf[..],m," FPS");
 // both on a dark plaque, so they read over the bright glade
 fw:=e2c_text_w(cast(string)buf[0..<m],13*k);gl:[32]u8;gw:=ifx s[0].golden || !s[0].q_ready then 0.0f32 else e2c_text_w(quality_label(s[0].q[..],gl[..]),13*k)+24*k;
 base:=e2_fps_clear(s,s[0].width-16*k-fw-14*k-gw,s[0].width-8*k,h-16*k);
 // an open class menu on a short page reaches over it: it steps aside under the menu
 if e2k_on(s) && cc.eg_meets(eg_menu_cover(e2k_facts(s),e2k_side_geo(s),e2k_side_st(s)),cc.hud_box(s[0].width-16*k-fw-14*k-gw,base-13*k-9*k,s[0].width-8*k,base+9*k)) {return at;}
 // a slot's card is up over the corner: the plaque steps aside under it
 hv:=s[0].casts[0].hover;
 if e2k_on(s) && hv>=0 && hv<s[0].casts[0].bar_n {cb:=e2k_card_box(s[0].casts[..],hv,s[0].width,s[0].height,k);
  if cc.eg_meets(cc.hud_box(cb[0],cb[1],cb[2],cb[3]),cc.hud_box(s[0].width-16*k-fw-14*k-gw-10*k,base-44*k,s[0].width-8*k,base+16*k)) {return at;}}
 p:=cc.eg_plaque(out,at,s[0].width-16*k-fw-14*k-gw,base-13*k-9*k,s[0].width-8*k,base+9*k,k);
 n:=e2_gfx_control(s,out,p,s[0].width-16*k-fw-14*k,base);
 return cc.fps_draw(s[0].creator[0].ui,s[0].fps_counter[0],out,n,s[0].width,base+16*k,k);
}
// The plaque's baseline, from y up: clear of the class bar's slots and its emblem over the middle,
// wherever they share its width (x0..x1). On a phone the bar spans the page, so the plaque sits over
// all of it.
e2_fps_clear :: (s: [] E2, x0: f32, x1: f32, y: f32) -> f32 {
  k := s[0].k; base := y; if !e2k_on(s) { return base; }
  w := s[0].width; h := s[0].height; top := y + 1000;
  for i: 0..<s[0].casts[0].bar_n { b := e2k_box(s[0].casts[..], i, w, h, k);
    if b[2] > b[0] && b[2] > x0 - 8 * k && b[0] < x1 + 8 * k {
      t := b[1] - 8 * k; mid := w * 0.5; if x0 < mid + 30 * k && x1 > mid - 30 * k { t = b[1] - 32 * k; }   // the emblem's medallion
      if t < top { top = t; } } }
  if top < y + 1000 && base + 16 * k > top { base = top - 16 * k; }
  return base;
}
// ---- the world's HUD (Everglade's FANTASY style, everglade/hud/parts.coax): your portrait plate top left,
// the map ring top right with the place and the time of day, and a place's banner as you come to it.
// All from what the page knows: the room's word on your health (e2n_vitals), the rules' AC and slots
// for your class and level (fb_cl_hero), the room's counts on your bar (e2n_slot).
E2_ZONES :: [5] string.["The Glade", "The Sunlit Path", "The Deep Canopy", "The Clearing", "Goblin Camp"];
e2_zone :: (x: f32, z: f32) -> int {
  cx := e2_camp_x() - x; cz := f32(E2_CAMP_Z) - z;
  if cx * cx + cz * cz < 24 * 24 { return 4; }
  if z > -24 { return 0; }
  if z < f32(E2_CLEAR_Z) + 40 { return 3; }
  if z < -250 { return 2; }
  return 1;
}
#test "the places: the glade, the path, the canopy, the clearing and the camp" {
  #assert e2_zone(0, 0) == 0 && e2_zone(e2_road_x(-100), -100) == 1 && e2_zone(e2_road_x(-320), -320) == 2;
  #assert e2_zone(e2_clear_x(), f32(E2_CLEAR_Z)) == 3 && e2_zone(e2_camp_x(), f32(E2_CAMP_Z)) == 4;
}
e2_hero :: (s: [] E2) {
  c := e2c_class_of(s); l := e2c_level_of(s);
  if s[0].hero_class == c && s[0].hero_level == l { return; }
  h := fb_cl_hero(c, "You", 0, l);
  s[0].hero_class = c; s[0].hero_level = l; s[0].hero_ac = h.ac;
  for i: 0..<10 { s[0].hero_slots[i] = h.slots_max[i]; }
}
// Your portrait's facts: the class, its level, the room's health, the rules' AC, the slots the room
// has counted on your bar (a level the bar does not count is left out), and what holds you.
e2_portrait :: (s: [] E2, conds: [] u8) -> cc.EgPortrait {
  e2_hero(s);
  p: cc.EgPortrait; cl := e2c_class_of(s);
  nm := e2c_name_shown(s); p.name = ifx nm.count > 0 then nm else E2C_CLASS_TITLES[cl];
  p.klass = E2C_CLASS_TITLES[cl]; p.level = e2c_level_of(s); p.ac = s[0].hero_ac;
  row := e2n_vitals(s[0].net[..]);
  if row.id >= 0 { p.hp = row.hp; p.max = row.max; p.temp = row.temp; }
  k := s[0].casts[..];
  for lv: 0..<10 { p.slot_max[lv] = s[0].hero_slots[lv]; p.slot_left[lv] = -1; }
  for i: 0..<k[0].bar_n {
    a := k[0].bar[i]; if a.kind != FB_SPELL || a.lvl < 1 || a.lvl > 9 { continue; }
    kit := e2n_slot(s[0].net[..], i, k[0].bar_n); if kit.ok && kit.left >= 0 { p.slot_left[a.lvl] = ifx kit.left > p.slot_max[a.lvl] then p.slot_max[a.lvl] else kit.left; }
  }
  // what holds you: the health line's words after its numbers (e2k_vitals_text)
  h: [E2K_HEALTH] u8; hn := e2k_vitals_text(s, h[..]); from := 0; i := 0;
  while i + 2 < hn { if h[i] == ' ' && h[i + 1] == 0xC2 { j := i + 4; if j + 4 <= hn && h[j] == 'T' && h[j + 1] == 'E' && h[j + 2] == 'M' && h[j + 3] == 'P' { i = j; continue; } from = j; break; } i += 1; }
  m := 0; if from > 0 { for q: from..<hn { if m < conds.count { conds[m] = h[q]; m += 1; } } }
  p.conds = cast(string) conds[0..<m];
  return p;
}
// The screen's red edges: a blow on you flashes them, and they pulse while you are under a quarter of
// your Hit Points (metaverse-engine/ui/hud-style.coax hud_vignette). Drawn before the rest of the HUD, in the world only.
e2_vignette :: (s: [] E2, out: [] f32, at: int) -> int {
  row := e2n_vitals(s[0].net[..]);
  if !e2k_on(s) || row.id < 0 || row.max <= 0 { s[0].vig[0].on = false; return at; }
  share := f32(row.hp) / f32(row.max);
  if s[0].vig_max != row.max { s[0].vig_max = row.max; s[0].vig[0].on = false; }   // a new maximum is no blow
  cc.hud_vignette_step(s[0].vig[..], share, s[0].clock - s[0].vig_at); s[0].vig_at = s[0].clock;
  return cc.eg_vignette(out, at, s[0].vig[0], s[0].width, s[0].height);
}
e2_world_view :: (s: [] E2, out: [] f32, at: int) -> int {
  if !e2k_on(s) { s[0].zone = -1; return at; }
  // the place, and its banner as you come to it
  z := e2_zone(s[0].you_x, s[0].you_z);
  if z != s[0].zone { s[0].zone = z; s[0].zone_at = s[0].clock; }
  // what the map shows: the open ground, the path ahead and behind, the others, the creatures, the guard
  dots: [64] cc.EgDot; nd := 0;
  dots[nd] = cc.EgDot.{x = 0, z = 0, kind = cc.EG_DOT_OPEN, r = 17}; nd += 1;
  dots[nd] = cc.EgDot.{x = e2_clear_x(), z = f32(E2_CLEAR_Z), kind = cc.EG_DOT_OPEN, r = f32(E2_CLEAR_R)}; nd += 1;
  reach := 60.0f32; z0 := s[0].you_z - reach * 1.5;
  pz := floor(z0 / 6) * 6;
  while pz < s[0].you_z + reach * 1.5 && nd < 40 { if pz < -6 && pz > f32(E2_CLEAR_Z) + f32(E2_CLEAR_R) * 0.5 { dots[nd] = cc.EgDot.{x = e2_road_x(pz), z = pz, kind = cc.EG_DOT_PATH}; nd += 1; } pz += 6; }
  for i: 0..<s[0].head_n { if nd < 64 { dots[nd] = cc.EgDot.{x = s[0].heads[i].x, z = s[0].heads[i].z, kind = cc.EG_DOT_FRIEND}; nd += 1; } }
  ml := s[0].monsters[0];
  for m: 0..<E2MN_N { g := ml.mon[m]; if g.up && g.fade > 0.05 && nd < 64 { dots[nd] = cc.EgDot.{x = g.x, z = g.z, kind = cc.EG_DOT_FOE}; nd += 1; } }
  gl := s[0].guard[0]; if gl.up && gl.fade > 0.05 && nd < 64 { dots[nd] = cc.EgDot.{x = gl.x, z = gl.z, kind = cc.EG_DOT_GUARD}; nd += 1; }
  cb: [8] u8; cn := cc.eg_clock(s[0].hud_day, cb[..]);
  conds: [E2K_HEALTH] u8; p := e2_portrait(s, conds[..]);
  // your health bar eases to what the room says, and a blow leaves its trail; a new maximum sets it anew
  if p.max > 0 {
    share := f32(p.hp) / f32(p.max); tr := s[0].hp_trail[..];
    if s[0].hp_trail_max != p.max { s[0].hp_trail_max = p.max; cc.hud_trail_snap(tr, share); }
    cc.hud_trail_step(tr, share, s[0].clock - s[0].hp_trail_at); s[0].hp_trail_at = s[0].clock;
    p.fill = tr[0].fill; p.trail = tr[0].trail;
  }
  p.lit = s[0].casts[0].side_hover >= 0 || s[0].casts[0].menu >= 0;
  wd := cc.EgWorld.{you_x = s[0].you_x, you_z = s[0].you_z, fx = s[0].fwd[0], fz = s[0].fwd[2], reach = reach, place = E2_ZONES[z], clock = cast(string) cb[0..<cn], since = s[0].clock - s[0].zone_at, cover = eg_menu_cover(e2k_facts(s), e2k_side_geo(s), e2k_side_st(s))};
  return cc.eg_world(s[0].creator[0].ui, out, at, s[0].width, s[0].height, s[0].k, wd, dots[..], nd, p);
}
#test "the frame rate is the frames over the last half second" {
  s: [1] E2;
  for i: 0..<40 { e2_fps_count(s[..], 1.0f32 / 60); }
  #assert abs(s[0].fps_counter[0].fps - 60) < 0.5;
  // slowed to 30: within a second it says so
  for i: 0..<30 { e2_fps_count(s[..], 1.0f32 / 30); }
  #assert abs(s[0].fps_counter[0].fps - 30) < 0.5;
}
e2_frame :: (s: [] E2, out: [] f32, u: [] f32, w: f32, h: f32, dpr: f32, dt: f32, still: bool) -> int #export_c #effects(all) {
  if u.count < E2_UNIFORM_FLOATS || w < 1 || h < 1 { return 0; }
  s[0].width = w; s[0].height = h; s[0].k = ifx dpr < 0.5 then 0.5f32 else dpr; s[0].media_n = 0;
  cc.ensure(s[0].creator[..]); s[0].creator[0].clock = s[0].clock;
  e2c_action(s); e2_place_keep(s);
  if !s[0].plant_done && s[0].plant_due {
    s[0].planted = e2_plant(s[0].items[..], s[0].kinds[..], s[0].first[..]); s[0].plant_done = true; s[0].plant_route = 2;
  }
  if !s[0].ground_done && s[0].catalog_in && (!s[0].paged || s[0].world_in) { e2_ground(s); }
  // a cell beside the glade came or went: the canopy's bake again, once nothing is on its way
  if s[0].ground_done && s[0].bake_due && s[0].cl[0].probe[3] == 0 { s[0].bake_due = false; _b := e2g_bake(s[0].eg[..], s[0].items[..], s[0].kinds[..], s[0].planted); }
  step := ifx still || dt <= 0 then 0.0f32 else ifx dt > 0.1 then 0.1f32 else dt;
  s[0].clock += step;
  e2_chase_step(s, step);
  e2c_arrive_step(s, step);
  e2w_step(s, step);
  e2p_step(s, step); e2b_step(s); e2sp_step(s, step);
  #if BUILD_DEBUG { e2i_dev(s, s[0].own_dev); }
  e2i_step(s);
  chase := figs.cam_shoulder_shot(figs.cam_shot(s[0].view, s[0].orbit, s[0].eye_pitch, s[0].press), s[0].ml[0].shown);
  shot := e2st_shot(s, e2w_shot(s, e2_familiar_shot(s,e2c_view(s, figs.v3(s[0].you_x, s[0].you_y, s[0].you_z), chase, step))));
  if e2_flying(s) {   // #fly=: the benchmark's path has the camera
    fv := trk.cam_track_at(s[0].fly, s[0].clock - s[0].fly_from);
    shot = figs.Shot.{eye = figs.v3(fv.ex, fv.ey, fv.ez), at = figs.v3(fv.lx, fv.ly, fv.lz)};
  }
  f := [3]f32.[shot.at.x - shot.eye.x, shot.at.y - shot.eye.y, shot.at.z - shot.eye.z];
  l := sqrt(f[0] * f[0] + f[1] * f[1] + f[2] * f[2]); if l < 0.0001 { l = 1; } for q: 0..<3 { f[q] /= l; }
  r := [3]f32.[-f[2], 0, f[0]]; rl := sqrt(r[0] * r[0] + r[2] * r[2]); if rl < 0.0001 { rl = 1; } r[0] /= rl; r[2] /= rl;
  up := [3]f32.[r[1] * f[2] - r[2] * f[1], r[2] * f[0] - r[0] * f[2], r[0] * f[1] - r[1] * f[0]];
  fy := (w / h) * 1.25; fy = ifx fy < 0.95 then 0.95f32 else ifx fy > 1.9 then 1.9f32 else fy;
  lens := e2c_view_lens(s, fy * h / 2, w * 0.5, h * 0.5);
  s[0].focal = lens[0]; s[0].cy = lens[2];
  s[0].eye = [3]f32.[shot.eye.x, shot.eye.y, shot.eye.z]; s[0].fwd = f; s[0].right = r; s[0].up = up;
  // the shadow casters' centre: the eye (e2_shadows draws the tiles round it)
  s[0].shade = [3]f32.[shot.eye.x, shot.eye.y, shot.eye.z];
  for i: 0..<u.count { u[i] = 0; }
  u[0] = w; u[1] = h; u[2] = s[0].clock; u[3] = 1; u[4] = s[0].k; u[10] = 2; u[11] = 1;
  for q: 0..<3 { u[16 + q] = s[0].eye[q]; u[20 + q] = f[q]; u[24 + q] = r[q]; u[28 + q] = up[q]; u[44 + q] = s[0].shade[q]; }
  u[19] = s[0].focal; u[23] = lens[1]; u[27] = lens[2];
  e2_light(s, u);
  u[48] = f32(s[0].creator[0].glade_word);
  u[35] = s[0].kn.grass; u[36] = s[0].kn.fine; u[37] = s[0].kn.post;   // the knobs the shaders read (e2_knobs_frame)
  e2c_arrive_uniforms(s, u);
  e2_material_uniforms(s, u);
  u[E2_U_LIGHT_VIEW] = envd.env_view_word(s[0].light_view);
  e2_shadows(s, u);
  // the studio's class is your character's once you are back in the world (Change character's too); the
  // room's when it sat you otherwise (its ticket's class and level, #13259)
  if s[0].net[0].served && !e2c_creating(s) { s[0].creator[0].klass = s[0].net[0].klass; s[0].creator[0].level = s[0].net[0].level; s[0].net[0].served = false; }
  e2k_set_class(s[0].casts[..], e2c_class_of(s), e2c_level_of(s)); if !e2c_creating(s) { e2n_set_class(s[0].net[..], e2c_class_of(s), e2c_level_of(s)); }
  // the bow first, so an arrow loosed this frame is flown and drawn this frame
  e2m_step(s, dt); e2bw_step(s); e2k_step(s); e2k_area_step(s); e2gd_hits(s); e2mn_hits(s);
  // the frame's step for the plates' fades (the first frame snaps them)
  s[0].sight_dt = ifx s[0].sight_at < 0 then 1.0f32 else ifx s[0].clock - s[0].sight_at > 0.1 then 0.1f32 else ifx s[0].clock < s[0].sight_at then 0.0f32 else s[0].clock - s[0].sight_at;
  s[0].sight_at = s[0].clock;
  e2d_frame(s);   // the agent driver's entities this frame (off: nothing)
  hud := e2_overlay(s, out, dt);
  e2d_bar(s);
  #if BUILD_DEBUG { hud = e2a_frame(s, out, hud, step); }
  if s[0].wild[0].stage || s[0].stage != E2ST_NONE { hud = 0; s[0].media_n = 0; }   // a staged shot (?stage=cat, everglade/client/stage.coax) draws no HUD: no strokes, no bar pictures
  cc.hud_seal(out, 0, hud);   // every stroke blends by its coverage (everglade2-face.c coaxial_fx_alpha_v1)
  return hud;
}
// The HUD's strokes, in the order they are drawn over the world (the overlap check, apps/openagents-web/hud-overlap-everglade2.coax, draws the same).
e2_overlay :: (s: [] E2, out: [] f32, dt: f32) -> int {
  return e2rg_overlay(s, out, e2i_overlay(s, out, e2rv_overlay(s, out, e2b_overlay(s, out, e2p_overlay(s, out, e2_net_readout(s, out, e2_light_readout(s, out, e2_fps(s, out, e2_world_view(s, out, e2_reticle(s, out, e2_heads(s, out, e2mn_wedge(s, out, e2_floats_draw(s, out, e2k_area_marks(s, out, e2k_down_line(s, out, e2k_bar_draw(s, out, e2_vignette(s, out, e2c_draw(s, out)))))))))), dt))))))));
}

// ---- the light (lighting plan Phase 1, #13066): every lit input the passes read is the camera's
// resolved environment, written each frame at E2_U_ENV (everglade/client/gpu/everglade2.coax through the cg_* names,
// metaverse-engine/render/painterly.coax paint_env_*). The world's set is e2_environment_set: the glade (the
// painterly default) with the sunlit path's and the deep canopy's deltas; its day is the room's (W: the room's ms into its day at a tick,
// metaverse-engine/world/day.coax day_from_room), or the glade's fixed noon before a room is heard and in a
// shot or Character Create, which open none. The key's shadow tiles look along the same direction.
// The world's set (everglade/world/environment.coax), admitted whole once.
e2_env_route :: (e: [] envf.EnvFrame) { next: [1] EnvironmentSet; next[0] = e2_environment_set(); _ := envf.env_frame_admit(e, next[..]); }
e2_light :: (s: [] E2, u: [] f32) {
  e := s[0].env[..];
  if !e[0].admitted { e2_env_route(e); }
  n := s[0].net[..]; tick: s64 = 0;
  if n[0].w_day >= 0 && n[0].worlds > 0 {
    _ := envf.env_frame_room(e, cast(s64) n[0].w_tick, cast(u32) n[0].hz, cast(s64) n[0].w_day, WIRE_DAY_MS);
    tick = cast(s64) (ifx n[0].tick > n[0].w_tick then n[0].tick else n[0].w_tick);
  }
  if s[0].stage != E2ST_NONE { _ := envf.env_frame_room(e, 0, 30, e2st_day_ms(), WIRE_DAY_MS); tick = 0; }   // a stage's late afternoon
  #if BUILD_DEBUG { tick = e2a_light(s, e, tick); }
  _ := envf.env_frame_write_eye(e, tick, s[0].eye[0], s[0].eye[1], s[0].eye[2], u, E2_U_ENV);
  s[0].hud_day = envf.env_frame_day(e, tick);
  envf.env_frame_sky_halo(u, 32);
  if s[0].light_view != envd.ENV_VIEW_OFF { read := envd.env_debug_read(e, tick, EnvDir.{x = s[0].eye[0], y = s[0].eye[1], z = s[0].eye[2]}, s[0].light_text[..]); }
}
// ?net (a flag, or net=1): the netcode readout, under the light's. Off without it.
e2_net_query :: (t: string) -> bool {
  key := "net";
  for i: 1..<t.count - key.count + 1 {
    if (t[i - 1] == '?' || t[i - 1] == '&') && t[i..<i + key.count] == key {
      e := i + key.count;
      if e >= t.count || t[e] == '&' || t[e] == '#' || t[e] == '\n' { return true; }
      if t[e] == '=' { return e + 1 < t.count && t[e + 1] != '0' && t[e + 1] != '&' && t[e + 1] != '\n'; }
    }
  }
  return false;
}
// The netcode readout, top left (metaverse-engine/net/stats.coax): round trip, the room's rate and its state
// frames' spacing, the others' delay, bytes each way, the last snapshot's size, your re-runs' corrections.
e2_net_readout :: (s: [] E2, out: [] f32, at: int) -> int {
  if !s[0].net_view { return at; }
  n := s[0].net[..];
  rtt := ifx n[0].pings > 0 then n[0].ping_rtt[net_ping_best(n[0].ping_rtt[..], n[0].pings)] else -1;
  net_stats_roll(n[0].stats[..], n[0].mono);
  net_stats_text(n[0].stats[0], NetStatsView.{rtt_ms = rtt, hz = n[0].hz, delay_ms = n[0].delay}, s[0].net_text[..]);
  t := s[0].net_text[..]; lines: [NET_STATS_LINES + NET_CONN_LINES] string;
  for l: 0..<t[0].count { lines[l] = net_stats_line(t, l); }
  // the transport, its loss, keyframes and stale drops (metaverse-engine/net/transport.coax, #13176)
  net_conn_text(n[0].link[0], s[0].link_text[..]);
  for l: 0..<NET_CONN_LINES { lines[t[0].count + l] = net_conn_line(s[0].link_text[..], l); }
  return eg_readout(s[0].creator[0].ui, out, at, "net", "NET", ifx e2n_open(n) then "ROOM" else "OFFLINE", lines[0..<t[0].count + NET_CONN_LINES], s[0].k);
}
#test "?net turns on the netcode readout; without it nothing is drawn" {
  #assert e2_net_query("url=/worlds/everglade2?net\n") && e2_net_query("url=/worlds/everglade2?at=60&net=1\n") && e2_net_query("url=/x?net&y=1");
  #assert !e2_net_query("url=/worlds/everglade2?at=60\n") && !e2_net_query("url=/x?net=0") && !e2_net_query("url=/x?network=1") && !e2_net_query("url=/x?cabinet");
}
// ?light=VIEW's readout, top left: the camera's region weights by profile id, its ambient, key and
// grade (metaverse-engine/render/environment-debug.coax). Nothing without the query.
e2_light_readout :: (s: [] E2, out: [] f32, at: int) -> int {
  if s[0].light_view == envd.ENV_VIEW_OFF { return at; }
  t := s[0].light_text[..]; lines: [envd.ENV_DEBUG_LINES] string;
  for l: 0..<t[0].count { lines[l] = envd.envd_line(t, l); }
  return eg_readout(s[0].creator[0].ui, out, at, "light", "LIGHT", envd.ENV_VIEW_NAMES[s[0].light_view], lines[0..<t[0].count], s[0].k);
}
#test "?light=VIEW turns on one light view and its readout; without it nothing changes" {
  s: [1] E2; u: [E2_UNIFORM_FLOATS] f32; s[0].eye = [3]f32.[2, 3, 5];
  e2_message(s[..], E2_HOST_PAGE, "url=/worlds/everglade2?at=60\n"); #assert s[0].light_view == envd.ENV_VIEW_OFF;
  e2_light(s[..], u[..]); #assert s[0].light_text[0].count == 0 && envd.env_view_word(s[0].light_view) == 0;
  e2_message(s[..], E2_HOST_PAGE, "url=/worlds/everglade2?at=60&light=ambient\n"); #assert s[0].light_view == envd.ENV_VIEW_AMBIENT;
  e2_light(s[..], u[..]); #assert s[0].light_text[0].count == 6 && envd.envd_line(s[0].light_text[..], 0) == "REGIONS 1:1.000*";
  #assert envd.env_view_word(s[0].light_view) == 1;
  // the record the shaders read is the same with a view on
  g := envf.env_frame_glade_words(); for i: 0..<envf.ENV_FRAME_FLOATS { #assert u[E2_U_ENV + i] == g[i]; }
}
#test "every frame writes the camera's environment: the glade's noon in the glade, the canopy's in the woods" {
  s: [1] E2; u: [E2_UNIFORM_FLOATS] f32;
  s[0].eye = [3]f32.[2, 3, 5];
  e2_light(s[..], u[..]);
  g := envf.env_frame_glade_words();
  for i: 0..<envf.ENV_FRAME_FLOATS { #assert u[E2_U_ENV + i] == g[i]; }
  #assert u[32] == -0.45f32 && u[33] == 0.78f32 && u[34] == -0.42f32 && s[0].env[0].writes == 1 && s[0].env[0].refusals == 0;
  // the shadow tiles look along the record's key: the glade's sun, made unit
  l := s[0].env[0].held.dir; m := sqrt(0.40f32 * 0.40f32 + 0.58f32 * 0.58f32 + 0.62f32 * 0.62f32);
  #assert l.x == -0.40f32 / m && l.y == 0.58f32 / m && l.z == -0.62f32 / m;
  // a room heard: its day (the glade is one knot, so the same light) from the room's clock
  s[0].net[0].w_day = 1440000; s[0].net[0].worlds = 1; s[0].net[0].w_tick = 9000; s[0].net[0].hz = 30; s[0].net[0].tick = 9030;
  e2_light(s[..], u[..]);
  #assert s[0].env[0].clock.seconds == 2880 && s[0].env[0].clock.hz == 30 && s[0].env[0].refusals == 0 && s[0].env[0].writes == 2;
  // the time of day is the room's (word 3), 30 ticks past its noon; every light word is the glade's
  #assert abs(u[E2_U_ENV + 3] - (0.5f32 + 1.0f32 / 2880)) < 0.00001;
  for i: 0..<envf.ENV_FRAME_FLOATS { if i != 3 { #assert u[E2_U_ENV + i] == g[i]; } }
  // deep in the woods, the canopy's delta: some light words move, the record is written, none refused
  p := e2_env_on_path(-300, 1.7); s[0].eye = [3]f32.[p.x, p.y, p.z];
  e2_light(s[..], u[..]); off := 0;
  for i: 4..<envf.ENV_FRAME_FLOATS { if u[E2_U_ENV + i] != g[i] { off += 1; } }
  #assert off > 0 && s[0].env[0].writes == 3 && s[0].env[0].refusals == 0 && u[32] == -0.45f32;
}
// ---- the key light's shadow tiles (metaverse-engine/render/cascades.coax, #13016, as Everglade's)
// The host makes one depth atlas of up to four tiles (two on a phone), each a ring further out round
// the eye. A tile's middle snaps to a whole number of its texels in the light's own space and it is
// drawn again only once the eye has walked past that step, so every shadow stays fixed to the land:
// a tile never slides under it. The nearest tile is drawn every frame (your character moves in it);
// at most one other tile a frame. Its casters are the pieces as the view draws them, at the same
// levels (e2_pieces casting).
// The tiles look along the key the frame's environment resolved (e2_light: the record's unit direction).
e2_shadows :: (s: [] E2, u: [] f32) {
  c := s[0].casc[..];
  for i: 0..<CASCADE_BLOCK { u[E2_U_CASCADE + i] = 0; }
  if !c[0].on { return; }
  // the graphics quality's shadow knob (e2_knobs_frame): no tiles (all lit), the nearest only, or
  // the full set; under 1 the nearest is redrawn for movers every other frame and filtered with six taps
  sh := s[0].kn.shadow;
  if s[0].casc_n == 0 { s[0].casc_n = c[0].tier.count; }
  if sh <= 0.001 { c[0].draw = -1; return; }
  want := ifx sh < 0.5 then 1 else s[0].casc_n;
  for k: c[0].tier.count..<want { c[0].slot[k].drawn = false; }
  c[0].tier.count = want;
  l := s[0].env[0].held.dir;
  _ := cascade_frame(c, s[0].eye[0], s[0].eye[2], l.x, l.y, l.z, sh >= 0.99 || c[0].frame % 2 == 0);
  // the filter: 2.5 texels of a 2048 map over 68 m, the same metres of penumbra in every tile
  cascade_rows(c[0], u[E2_U_CASCADE..<E2_U_CASCADE + CASCADE_BLOCK], 2.5, 68.0f32 / 2048, 34);
  if sh < 0.99 { for k: 0..<want { u[E2_U_CASCADE + CASCADE_HEADER + k * CASCADE_FLOATS + 23] = 1; } }
}
// How far round the eye a tile's casters reach: its own reach across its diagonal and its leash,
// and the tallest tree's shadow beside it.
e2_cast_reach :: (s: [] E2) -> f32 {
  c := s[0].casc[0];
  if !c.on || c.draw < 0 { return 0; }
  return c.tier.reach[c.draw] * 1.42 + cascade_leash(c.tier, c.draw) + 20;
}
// Whether a piece standing at p, up to h tall, can throw its shadow into the tile drawn this frame:
// its span up the light's view (base to top) crosses the tile's square, with room for its crown.
e2_casts_into :: (s: [] E2, x: f32, y: f32, z: f32, h: f32) -> bool {
  c := s[0].casc[0];
  if !c.on || c.draw < 0 { return false; }
  q := c.slot[c.draw]; a := cascade_axes(q.lx, q.ly, q.lz); r := c.tier.reach[c.draw] + h * 0.35 + 1;
  across := x * a.axx + z * a.axz - q.cx;
  if across < -r || across > r { return false; }
  up0 := x * a.ayx + y * a.ayy + z * a.ayz - q.cy; up1 := up0 + a.ayy * h;
  lo := ifx up0 < up1 then up0 else up1; hi := ifx up0 < up1 then up1 else up0;
  return hi >= -r && lo <= r;
}
// The host's side (the face's coaxial_shadow_*_v1, coax/web/host.js), as Everglade's
// (everglade.coax everglade_shadow_field): the atlas in texels (`which` 0 across, 1 down; a phone's
// when `coarse`); field 0 the tile drawn this frame (-1 none), 1 to 4 its rect in texels, 5 the
// host's character pass (none here: your character is in the shadow list), 6 the tiles, 7 those
// cleared first, 16 + 4 k to 19 + 4 k tile k's rect; events 0 the atlas made (arg 1 a phone's),
// 1 geometry installed, 2 this frame's tile not drawn.
e2_shadow_atlas :: (s: [] E2, coarse: int, which: int) -> int #export_c #effects(all) { return cascade_atlas(coarse != 0, which); }
e2_shadow_field :: (s: [] E2, field: int) -> int #export_c #effects(all) {
  c := s[0].casc[0];
  if !c.on { return -1; }
  if field == 6 { return c.tier.count; }
  if field >= 16 && field < 16 + 4 * c.tier.count { j := (field - 16) % 4; return cascade_rect_px(c.tier, (field - 16) / 4, ifx j <= 1 then j else 2); }
  d := c.draw;
  if field == 0 { return d; }
  if d < 0 { return -1; }
  if field >= 1 && field <= 4 { return cascade_rect_px(c.tier, d, ifx field <= 2 then field - 1 else 2); }
  if field == 5 { return 0; }
  if field == 7 { return 1 << cast(u64) d; }
  return -1;
}
e2_shadow_event :: (s: [] E2, kind: int, arg: int) #export_c #effects(all) {
  c := s[0].casc[..];
  if kind == 0 { cascade_open(c, arg != 0); s[0].casc_n = c[0].tier.count; } else if kind == 1 { cascade_stale(c); } else if kind == 2 { cascade_dropped(c); }
}
#test "Everglade II's shadow tiles: snapped to the light's texels, redrawn only past a step, the near one every frame" #steps 400000000 {
  s: [1] E2; u: [E2_UNIFORM_FLOATS] f32;
  #assert e2_shadow_field(s[..], 0) == -1;
  e2_shadow_event(s[..], 0, 0);
  #assert e2_shadow_field(s[..], 6) == 4 && e2_shadow_atlas(s[..], 0, 0) == 2048;
  // standing still: every tile is drawn once, then only the near one
  s[0].eye = [3]f32.[3, 2, -150];
  e2_light(s[..], u[..]);   // the frame writes the light first: the tiles look along its key
  drawn: [4] int;
  for f: 0..<40 { e2_shadows(s[..], u[..]); d := e2_shadow_field(s[..], 0); if d >= 0 { drawn[d] += 1; } }
  #assert drawn[0] >= 30 && drawn[1] == 1 && drawn[2] == 1 && drawn[3] == 1;
  // a tile's middle is a whole number of its texels along the light's axes
  for k: 0..<4 { q := s[0].casc[0].slot[k]; e := cascade_texel(s[0].casc[0].tier, k);
    #assert abs(q.cx / e - floor(q.cx / e + 0.5)) < 0.01 && abs(q.cy / e - floor(q.cy / e + 0.5)) < 0.01; }
  // the far tile holds still while the eye walks less than its step
  far := s[0].casc[0].slot[3];
  for f: 0..<60 { s[0].eye[2] -= 0.05; e2_shadows(s[..], u[..]); }
  #assert s[0].casc[0].slot[3].cx == far.cx && s[0].casc[0].slot[3].cy == far.cy;
  #assert u[E2_U_CASCADE] == 4;
}
// ---- the scene: the glade's records and draws, your character, the kit pieces in view
e2_rec_clear :: (s: [] E2, n: int) { for k: 0..<24 { s[0].records[n * 24 + k] = 0; } }
e2_draw :: (d: [] u32, n: int, first: int, count: int, base: int, instances: int) -> int {
  if n >= E2_DRAWS || count <= 0 || instances <= 0 { return n; }
  d[n * 4] = cast(u32) first; d[n * 4 + 1] = cast(u32) count; d[n * 4 + 2] = cast(u32) base; d[n * 4 + 3] = cast(u32) instances; return n + 1;
}
// Whether a piece at p (its reach r) is in front of the eye and inside the frame.
e2_in_view :: (s: [] E2, x: f32, y: f32, z: f32, r: f32) -> bool {
  vx := x - s[0].eye[0]; vy := y - s[0].eye[1]; vz := z - s[0].eye[2];
  d := vx * s[0].fwd[0] + vy * s[0].fwd[1] + vz * s[0].fwd[2];
  if d < -r { return false; }
  sx := abs(vx * s[0].right[0] + vy * s[0].right[1] + vz * s[0].right[2]);
  sy := abs(vx * s[0].up[0] + vy * s[0].up[1] + vz * s[0].up[2]);
  reach := (d + r) / s[0].focal;
  return sx <= reach * s[0].width * 0.5 + r * 1.2 && sy <= reach * s[0].height * 0.5 + r * 1.2;
}
// The grass field's blocks in view (everglade/world/field.coax): for each tier, the blocks whose
// ground lies in its ring round the eye and in view, one draw of 256 tufts each (two near, one
// mesh each keeping half; one further). The GPU places every tuft.
e2_field :: (s: [] E2, d: [] u32, n0: int) -> int {
  n := n0; if !s[0].kits { return n; }
  ex := s[0].eye[0]; ez := s[0].eye[2];
  for t: 0..<E2_FIELD_TIERS {
    g := s[0].kn.grass; cap := s[0].kn.fine;
    bs := e2_field_block(t); out := e2_field_out_r(t, g, cap);
    inner := e2_field_start_r(t, g, cap);
    if out <= inner { continue; }
    x0 := cast(int) floor((ex - out - E2_WEST) / bs); x1 := cast(int) floor((ex + out - E2_WEST) / bs);
    z0 := cast(int) floor((E2_BACK - ez - out) / bs); z1 := cast(int) floor((E2_BACK - ez + out) / bs);
    for bz: z0..<z1 + 1 { for bx: x0..<x1 + 1 {
      if bx < 0 || bz < 0 || bx >= E2_FIELD_ROW || bz >= E2_FIELD_ROW { continue; }
      wx := e2_field_block_x(t, bx); nz := e2_field_block_z(t, bz);
      if wx > E2_EAST || nz - bs < E2_FAR { continue; }
      // the block's nearest and farthest ground from the eye
      qx := ifx ex < wx then wx else ifx ex > wx + bs then wx + bs else ex; qz := ifx ez > nz then nz else ifx ez < nz - bs then nz - bs else ez;
      near := sqrt((qx - ex) * (qx - ex) + (qz - ez) * (qz - ez));
      fx := ifx ex - wx > wx + bs - ex then ex - wx else wx + bs - ex; fz := ifx nz - ez > ez - (nz - bs) then nz - ez else ez - (nz - bs);
      far := sqrt(fx * fx + fz * fz);
      if near > out || far < inner { continue; }
      cx := wx + bs * 0.5; cz := nz - bs * 0.5;
      if !e2cv_draws_at(s[0].cl[..], cx, cz) { continue; }
      if !e2_in_view(s, cx, e2_height(cx, cz) + 1, cz, bs * 0.75) { continue; }
      // one draw a block: every tier draws Grass_Common_Short (465 vertices a tuft)
      b := E2_GRASS * E2_LODS;
      if s[0].kit_count[b] <= 0 || n >= E2_DRAWS { continue; }
      n = e2_draw(d, n, s[0].kit_first[b], s[0].kit_count[b], e2_field_code(t, bx, bz, 2), E2_FIELD_CELLS * E2_FIELD_CELLS);
    }}
  }
  return n;
}
// A drawn piece's word (everglade/client/gpu/everglade2.coax e2_vis_word, repeated here as E2_KIT_BASE is):
// its row of items in the low 24 bits, its fade code above.
e2_vis_word :: (row: int, code: int) -> u32 { return cast(u32) row | (cast(u32) code << 24); }
e2_vis_row :: (w: u32) -> int { return cast(int) (w & 0x00FFFFFF); }
// Each visible piece into its (kit, level) bucket's run of the instance store; one draw a bucket.
// `casting` lists the pieces for the shadow tile drawn this frame instead (e2_cast_reach).
// Every piece keeps its one place, turn and size at every distance: distance only picks its level
// and fades it. A tree is whole near you, two of its crown's cards in three past E2_LOD1 and one in
// three past E2_LOD2 (the same cards in the same places, metaverse/tools/assets/everglade2_pack.coax),
// each pair of levels cross-fading in a screen dither over E2_LOD_BAND, and every piece dithers out
// past E2_FAR_START of its kit's reach, each at its own rank (e2_piece_shown).
e2_pieces :: (s: [] E2, d: [] u32, n0: int, casting: bool) -> int {
  n := n0;
  if !s[0].plant_done || !s[0].kits { return n; }
  counts: [E2_BUCKETS] int; start: [E2_BUCKETS] int;
  ex := s[0].eye[0]; ez := s[0].eye[2];
  cast_far := ifx casting then e2_cast_reach(s) else 0.0f32;
  if casting && cast_far <= 0 { return n; }
  sc := s[0].kn.scenery; reach0 := E2_KIT_FAR[0] * sc;
  for pass: 0..<2 {
    if pass == 1 {
      at := s[0].inst_n;
      for b: 0..<E2_BUCKETS { start[b] = at; at += counts[b]; counts[b] = 0; }
      if at > E2_VISIBLE { return n; }
    }
    for c: 0..<E2_CELLS_X * E2_CELLS_Z {
      i := c % E2_CELLS_X; j := c / E2_CELLS_X;
      mx := e2_cell_x(i) + f32(E2_CELL) * 0.5; mz := e2_cell_z(j) - f32(E2_CELL) * 0.5;
      if !e2cv_plant_draws(s[0].cl[..], c) { continue; }   // its world cell isn't drawn (everglade/client/cells.coax)
      far := ifx casting then (ifx cast_far < reach0 then cast_far else reach0) else reach0;
      dx := mx - ex; dz := mz - ez;
      if dx * dx + dz * dz > (far + 12) * (far + 12) { continue; }
      if !casting && !e2_in_view(s, mx, e2_height(mx, mz) + 6, mz, 20) { continue; }
      for q: s[0].first[c]..<s[0].first[c + 1] {
        kit := cast(int) s[0].kinds[q]; o := q * E2_ITEM_FLOATS;
        px := s[0].items[o]; py := s[0].items[o + 1]; pz := s[0].items[o + 2];
        qx := px - ex; qz := pz - ez; dd := sqrt(qx * qx + qz * qz);
        looks: E2Looks;
        if casting {
          // what the view draws, at its levels, but all round the eye (a shadow falls from behind
          // you too); a piece more than half faded out casts nothing. The near tile, drawn every
          // frame, takes every tree at level 1 (the same cards, two in three) so it never changes
          // level as you walk and stays cheap.
          if kit >= 25 || dd > cast_far || dd >= E2_KIT_FAR[kit] * sc { continue; }
          if !e2_casts_into(s, px, py, pz, ifx kit < E2_TREES then 9.0f32 * s[0].items[o + 4] else 3.0f32) { continue; }
          looks = e2_piece_looks(kit, dd, e2_piece_rank(px, pz), sc);
          if looks.n == 1 && looks.code[0] >= 32 { continue; }
          if s[0].casc[0].draw == 0 && kit < E2_TREES { looks.n = 1; looks.lod[0] = 1; looks.code[0] = 0; }
          // the far tiles (past 60 m) take the trees at their sparsest level, as the view draws
          // them out there, and the big rocks; a bush's shadow that far is under a texel
          if s[0].casc[0].draw >= 2 { if kit >= 15 && kit < 23 { continue; } if kit < E2_TREES { looks.n = 1; looks.lod[0] = 2; looks.code[0] = 0; } }
        } else {
          if dd >= E2_KIT_FAR[kit] * sc { continue; }
          reach := ifx kit < E2_TREES then 9.0f32 * s[0].items[o + 4] else 2.5f32;
          if !e2_in_view(s, px, py + reach * 0.5, pz, reach) { continue; }
          looks = e2_piece_looks(kit, dd, e2_piece_rank(px, pz), sc);
        }
        for e: 0..<looks.n {
          b := kit * E2_LODS + looks.lod[e];
          if s[0].kit_count[b] <= 0 { continue; }
          if pass == 1 { s[0].inst[start[b] + counts[b]] = e2_vis_word(q, looks.code[e]); }
          counts[b] += 1;
        }
      }
    }
  }
  for b: 0..<E2_BUCKETS { if counts[b] > 0 { n = e2_draw(d, n, s[0].kit_first[b], s[0].kit_count[b], E2_KIT_BASE + start[b], counts[b]); } }
  s[0].inst_n = start[E2_BUCKETS - 1] + counts[E2_BUCKETS - 1];
  return n;
}
// The one or two ways a piece is drawn at dd metres: its levels and their fade codes (the shader's
// e2_inst_fade: 0 whole, 1 to 63 that many 64ths of its pixels dropped, 65 to 127 only (code - 64)
// 64ths kept, the other half of a cross-fade).
E2Looks :: struct { n: int; lod: [2] int; code: [2] int; }
E2_LOD_BAND :: 8.0;      // metres a tree's two levels cross-fade over, centred on E2_LOD1 and E2_LOD2
E2_FAR_START :: 0.55;    // of a kit's reach: past this its pieces thin out, each at its own rank
E2_FAR_BAND :: 0.10;     // of the share: how long one piece takes to dither out
e2_fade_code :: (drop: f32) -> int { k := cast(int) floor(drop * 64 + 0.5); return ifx k < 0 then 0 else ifx k > 63 then 63 else k; }
// A piece's rank (0 to 1) from where it stands alone: the order the pieces of a kit thin out in.
e2_piece_rank :: (x: f32, z: f32) -> f32 { return e2_unit(e2_field_hash(cast(u32)(cast(int) floor(x * 16) + 65536), cast(u32)(cast(int) floor(z * 16) + 65536), 9)); }
// How much of a piece shows at dd (its rank `rank`): all near; past E2_FAR_START of its kit's
// reach the share left falls smoothly to none at the reach, and each piece dithers out over
// E2_FAR_BAND as the share passes its rank, so the edge is ragged and nothing pops or shrinks.
e2_piece_shown :: (kit: int, dd: f32, rank: f32, sc: f32) -> f32 {
  far := E2_KIT_FAR[kit] * sc; t := (dd - far * f32(E2_FAR_START)) / (far * (1 - f32(E2_FAR_START)));
  t = ifx t < 0 then 0.0f32 else ifx t > 1 then 1.0f32 else t;
  share := 1 - t * t * (3 - 2 * t);
  v := (share - rank * (1 - f32(E2_FAR_BAND))) / f32(E2_FAR_BAND);
  return ifx v < 0 then 0.0f32 else ifx v > 1 then 1.0f32 else v;
}
e2_piece_looks :: (kit: int, dd: f32, rank: f32, sc: f32) -> E2Looks {
  l: E2Looks;
  l.n = 1; l.lod[0] = 0; l.code[0] = e2_fade_code(1 - e2_piece_shown(kit, dd, rank, sc));
  if kit >= E2_TREES { return l; }
  // the level this far, and how far into the cross-fade to the next one
  lod := 0; at := f32(E2_LOD1);
  if dd >= f32(E2_LOD1) + f32(E2_LOD_BAND) * 0.5 { lod = 1; at = f32(E2_LOD2); }
  if dd >= f32(E2_LOD2) + f32(E2_LOD_BAND) * 0.5 { lod = 2; }
  l.lod[0] = lod;
  if lod == 2 { return l; }
  k := e2_fade_code((dd - (at - f32(E2_LOD_BAND) * 0.5)) / f32(E2_LOD_BAND));
  if k == 0 { return l; }
  if k >= 63 { l.lod[0] = lod + 1; return l; }
  // the nearer level drops k 64ths of its pixels and the farther one keeps exactly those
  l.n = 2; l.code[0] = k; l.lod[1] = lod + 1; l.code[1] = 64 + k;
  return l;
}
#test "a piece keeps its place and size at every distance and only fades" #steps 40000000 {
  // a tree: whole near, cross-faded round E2_LOD1 and E2_LOD2 (the two halves cover each pixel
  // once), then its sparsest level out to its reach
  last := 0;
  for i: 0..<3000 { dd := f32(i) * 0.1; l := e2_piece_looks(3, dd, 0.5, 1);
    #assert l.n >= 1 && l.n <= 2;
    if l.n == 2 { #assert l.lod[1] == l.lod[0] + 1 && l.code[1] == 64 + l.code[0] && l.code[0] > 0 && l.code[0] < 63; }
    if dd < f32(E2_LOD1) - f32(E2_LOD_BAND) { #assert l.n == 1 && l.lod[0] == 0 && l.code[0] == 0; }
    if dd > f32(E2_LOD1) + f32(E2_LOD_BAND) && dd < f32(E2_LOD2) - f32(E2_LOD_BAND) { #assert l.n == 1 && l.lod[0] == 1 && l.code[0] == 0; }
    if dd > f32(E2_LOD2) + f32(E2_LOD_BAND) { #assert l.n == 1 && l.lod[0] == 2; }
    // the far fade only grows with distance, by at most a couple of 64ths a step
    if dd > f32(E2_LOD2) + f32(E2_LOD_BAND) { #assert l.code[0] >= last && l.code[0] - last <= 2; last = l.code[0]; }
  }
  // through each band the farther level's share rises smoothly from none to all
  for band: 0..<2 { c := ifx band == 0 then f32(E2_LOD1) else f32(E2_LOD2); prev := 0;
    for i: 0..<201 { dd := c - f32(E2_LOD_BAND) * 0.5 - 0.5 + f32(i) * 0.045; l := e2_piece_looks(0, dd, 0.5, 1);
      k := ifx l.n == 2 then l.code[0] else ifx l.lod[0] == band + 1 then 64 else 0;
      #assert k >= prev && k - prev <= 3; prev = k; } #assert prev == 64; }
  // small pieces thin out over the far part of their reach, each at its own rank: near all show,
  // at the reach none; a piece's share only falls with distance and never jumps
  for kit: 15..<E2_KITS { far := E2_KIT_FAR[kit];
    for r: 0..<20 { rank := f32(r) / 20 + 0.02; was := 1.0f32;
      #assert e2_piece_shown(kit, far * 0.5, rank, 1) == 1 && e2_piece_shown(kit, far, rank, 1) == 0;
      for i: 0..<400 { v := e2_piece_shown(kit, far * f32(i) / 400, rank, 1); #assert v <= was && was - v < 0.2; was = v; } } }
  // ranks spread, so the edge is ragged: halfway through the thinning about half the pieces show
  shown := 0; for i: 0..<1000 { if e2_piece_shown(18, E2_KIT_FAR[18] * 0.78, e2_piece_rank(f32(i) * 1.37, f32(i) * 0.71), 1) > 0.5 { shown += 1; } }
  #assert shown > 300 && shown < 700;
}
// The draws of the woods with the eye at path metre m (3 m behind and 2 up, looking down the path).
e2_test_view :: (s: [] E2, d: [] u32, m: f32) -> int {
  z := -m; x := e2_road_x(z); s[0].eye = [3]f32.[x, e2_height(x, z + 3) + 2, z + 3];
  s[0].fwd = [3]f32.[0, 0, -1]; s[0].right = [3]f32.[1, 0, 0]; s[0].up = [3]f32.[0, 1, 0];
  s[0].width = 1280; s[0].height = 720; s[0].focal = 900; s[0].inst_n = 0;
  return e2_pieces(s, d, 0, false);
}
#test "the woods' pieces never move, grow or swap as you walk, and come back the same" #steps 60000000000 {
  s: [1] E2; s[0].planted = e2_plant(s[0].items[..], s[0].kinds[..], s[0].first[..]); s[0].plant_done = true; s[0].kits = true;
  for b: 0..<E2_BUCKETS { s[0].kit_first[b] = b; s[0].kit_count[b] = 1; }
  d: [E2_DRAWS * 4] u32;
  // A, then a metre on, then 30 m on and back to A
  na := e2_test_view(s[..], d[..], 150); an := s[0].inst_n; a: [E2_VISIBLE] u32;
  for k: 0..<an { a[k] = s[0].inst[k]; }
  walk := [7]f32.[151, 160, 170, 180, 170, 160, 152];
  for step: 0..<7 {
    m := walk[step];
    n := e2_test_view(s[..], d[..], m);
    // every drawn piece is a planted one exactly (its row of items, never a copy), only its fade beside it
    for i: 0..<s[0].inst_n { w := s[0].inst[i]; #assert e2_vis_row(w) < s[0].planted && (w >> 24) < 128; }
  }
  nb := e2_test_view(s[..], d[..], 150);
  #assert nb == na && s[0].inst_n == an && an > 1000;
  for k: 0..<an { #assert s[0].inst[k] == a[k]; }
}
e2_scene :: (s: [] E2) -> int #export_c #effects(all) {
  c := s[0].creator[0]; b := s[0].bodies[..];
  s[0].draw_n = 0; s[0].shadow_n = 0; s[0].inst_n = 0; s[0].rec_n = 0;
  if !b[0].ready || !cc.catalog_ready(c) || c.glade_count <= 0 { return 0; }
  n := 0; sn := 0;
  // record 0 the glade, 1 to 3 its grass (their base instance (record + 1) << 16: cg_instanced_vs)
  e2_rec_clear(s, 0); s[0].records[7] = f32(c.glade_word); s[0].records[15] = 16;
  n = e2_draw(s[0].draws[..], n, c.glade_first, c.glade_count, 0, 1);
  tile := s[0].casc[0].on && s[0].casc[0].draw >= 0;
  near_glade := s[0].eye[2] - e2_cast_reach(s) < 75;
  if tile && near_glade { sn = e2_draw(s[0].shadow[..], sn, c.glade_first, c.glade_count, 0, 1); }
  rec := 1;
  // the glade's own grass (Character Create's, about 27 000 tufts of up to 1 482 vertices: 35 million
  // vertices a frame) is not drawn: the grass field (everglade/world/field.coax) covers the glade too.
  // Its records stay, so the character's parts keep their places.
  glade_near := false;
  for gi: 0..<c.grass_groups {
    g := c.grass[gi]; e2_rec_clear(s, rec);
    s[0].records[rec * 24] = f32(g.word); s[0].records[rec * 24 + 7] = f32(c.glade_word); s[0].records[rec * 24 + 15] = 17;
    if glade_near { n = e2_draw(s[0].draws[..], n, g.first, g.count, (rec + 1) << 16, g.n); }
    rec += 1;
  }
  // your character: the look Character Create saved, walking as the controller moves you
  a := s[0].anim[..];
  a[0].on = true; a[0].x = s[0].you_x; a[0].z = s[0].you_z; a[0].y = s[0].you_y; a[0].yaw = e2_show_face(s); a[0].own = true;
  if !e2c_creating(s) { e2_fall(a, e2k_bearing(s), s[0].clock); }   // down at 0 Hit Points: you fall and lie Prone
  bdt := ifx s[0].clock > b[0].now then s[0].clock - b[0].now else 0.0f32;
  figs.bd_step(a, s[0].clock, bdt);
  b[0].now = s[0].clock;
  fig := ifx e2c_creating(s) then e2c_figure(s) else e2k_figure(e2_jump_figure(a[0], s[0].airborne, s[0].clock, s[0].air_at, s[0].land_at), s[0].casts[0].me[0], s[0].clock);
  // mouselook backpedal: the rig has no backpedal clip, so the gait plays backwards while you face the camera
  if mlook.ml_on(s[0].ml[0]) && axis(s[0].held, HOLD_W, HOLD_S) < 0 && !s[0].airborne && (fig.clip == figs.BD_RUN || fig.clip == figs.BD_WALK) { fig.phase = -fig.phase; }
  if !e2c_creating(s) { fig = e2m_figure(s, fig); }   // the bow drawn (everglade/client/mouse.coax)
  if !e2c_creating(s) && e2n_open(s[0].net[..]) { fig = e2rv_figure(s, fig, s[0].net[0].seat, e2rp_tick(s[0].net[0].ride[..], s[0].net[0].pred[0].seq)); }   // riding: seated in the saddle (ride-view.coax)
  #if BUILD_DEBUG { fig = e2a_figure(s, fig); }
  s[0].cz[0].fig0 = rec;
  d := e2_body(s, c, fig, E2Drawn.{rec = rec, n = n, sn = sn});
  if d.rec > rec { d = e2_my_held(s, d, rec); }   // the class's kit in hand: the Ranger's Longbow
  s[0].cz[0].fig1 = d.rec;
  if d.n > 0 { s[0].cz[0].drawn += 1; }
  d = e2_familiars_draw(s,d);
  d = e2w_draw(s, d);               // the glade's cat (everglade/client/wild.coax)
  d = e2p_draw(s, d, bdt);          // Pansopher (everglade/client/npc.coax)
  d = e2sp_draw(s, d, bdt);         // the Warden and the tables' other speakers (everglade/client/speakers.coax)
  d = e2b_draw(s, d);               // his workbench (everglade/client/bench.coax)
  d = e2_remotes_draw(s, d, bdt);   // the others in the room (everglade/client/net.coax)
  d = e2gd_draw(s, d, bdt);          // the path's guard (everglade/client/guard.coax)
  d = e2mn_draw(s, d, bdt);          // the wolves and the goblins (everglade/client/creatures.coax)
  d = e2rv_draw(s, d, bdt);          // the zone's mounts (everglade/client/ride-view.coax)
  d = e2rg_draw(s, d);               // the Archery Range (everglade/client/range.coax)
  rec = d.rec; n = d.n; sn = d.sn; s[0].rec_n = rec;
  n = e2_pieces(s, s[0].draws[..], n, false);
  n = e2_field(s, s[0].draws[..], n);
  sn = e2_pieces(s, s[0].shadow[..], sn, true);
  s[0].draw_n = n; s[0].shadow_n = sn;
  return n;
}
// The frame's order for the host (the face's coaxial_frame_plan_v1, #13303): the engine's pass
// program (metaverse-engine/render/passes.coax) for this frame's counts, the shadow tile the
// cascades name, the separate shadow list, the instance cull's runs and the bloom stages the
// quality asks for. `features` is the host's word (frame-plan.coax FPH_*), `hud` the HUD's
// vertices this frame and `runs` the cull's runs (e2_cull_fill). The words written, 0 refused.
e2_frame_plan :: (s: [] E2, features: u32, w: int, h: int, hud: int, runs: int, out: [] u32) -> int #export_c #effects(all) {
  c := FrameCounts.{width = w, height = h, vertex_stride = E2_VERTEX_FLOATS, hud_vertices = hud, draw_count = s[0].draw_n,
                    particle_instances = s[0].casts[0].puffs[0].out_n};
  x := RenderShipping.{shadow_draws = s[0].shadow_n, cull = runs > 0, cull_runs = runs, sort = true, grass_last = true, bloom_passes = e2_bloom_passes(s)};
  k := s[0].casc[0];
  if k.on && k.tier.count <= RENDER_SHADOW_TILES {
    x.tiles = true; x.tile_count = k.tier.count; x.tile = k.draw;
    if k.draw >= 0 { x.clears = 1 << cast(u64) k.draw; }
    for t: 0..<k.tier.count { side := cascade_rect_px(k.tier, t, 2); x.rects[t] = [4] int.[cascade_rect_px(k.tier, t, 0), cascade_rect_px(k.tier, t, 1), side, side]; }
  }
  return frame_plan_page(features, c, x, out);
}
// What a frame sends the GPU of the scene (the retained scene, #13303): the records this frame wrote
// (a record past them is drawn by nothing), one word a piece drawn, and the planted pieces' rows
// once, when they are planted (e2_items_version moves only then).
e2_record_bytes :: (s: [] E2) -> int #export_c #effects(all) { n := ifx s[0].rec_n > E2_RECORDS then E2_RECORDS else s[0].rec_n; return n * 24 * 4; }
e2_inst_bytes :: (s: [] E2) -> int #export_c #effects(all) { return s[0].inst_n * 4; }
e2_items_bytes :: (s: [] E2) -> int #export_c #effects(all) { return ifx s[0].plant_done then s[0].planted * E2_ITEM_FLOATS * 4 else 0; }
e2_items_version :: (s: [] E2) -> int #export_c #effects(all) { return ifx s[0].plant_done then 1 + s[0].plant_route else 0; }
#test "the retained scene: a frame's upload is its records and a word a piece; the rows go once" {
  s: [1] E2;
  #assert e2_items_bytes(s[..]) == 0 && e2_items_version(s[..]) == 0 && e2_record_bytes(s[..]) == 0 && e2_inst_bytes(s[..]) == 0;
  s[0].planted = 1000; s[0].plant_done = true; s[0].plant_route = 1; s[0].rec_n = 40; s[0].inst_n = 5190;
  #assert e2_items_bytes(s[..]) == 32000 && e2_items_version(s[..]) == 2;
  #assert e2_record_bytes(s[..]) == 3840 && e2_inst_bytes(s[..]) == 20760;
  s[0].rec_n = E2_RECORDS + 9; #assert e2_record_bytes(s[..]) == E2_RECORDS * 96;
}
// The host action this frame (everglade2-face.c coaxial_action): its code, its bytes; done clears it.
e2_action :: (s: [] E2) -> int #export_c #effects(all) { return s[0].action; }
e2_action_done :: (s: [] E2) #export_c #effects(all) { s[0].action = 0; s[0].out_n = 0; }
// Whether the controller should take you where and as you stand now (once, after the studio).
e2_reseat :: (s: [] E2) -> bool #export_c #effects(all) { r := s[0].reseat; s[0].reseat = false; return r; }
coaxial_e2_max_vertices :: () -> int #export_c #effects(all) { return E2_MAX_VERTICES; }
coaxial_e2_vertex_floats :: () -> int #export_c #effects(all) { return E2_VERTEX_FLOATS; }
coaxial_e2_uniform_floats :: () -> int #export_c #effects(all) { return E2_UNIFORM_FLOATS; }
// Read-only observations for headless checks (coaxial_field_probe): 0 draws, 1 shadow draws, 2 kit
// pieces stored, 3 pieces planted, 4 kit rows read, 5 your z in centimetres, 173 where the woods came
// from (0 not yet, 1 the pack's P lines, 2 planted here, 3 by cell as each arrives).
// The page's hash (the face's coaxial_hash). "fly=T,EX,EY,EZ,AX,AY,AZ~...": the flyover benchmark
// (coax/web/flyover.coax) takes the camera along that path from now and holds its last key; "fly="
// (or any path metaverse-engine/cam/track.coax's cam_track_fly refuses) hands it back. Nothing else is read.
e2_hash :: (s: [] E2, hash: string) #export_c #effects(all) {
  if hash.count >= 4 && hash[0..<4] == "fly=" { s[0].fly = trk.cam_track_fly(hash[4..<hash.count]); s[0].fly_from = s[0].clock; }
}
e2_flying :: (s: [] E2) -> bool #effects(all) { return s[0].fly.flight.count >= 2; }
// The flyover benchmark's probe (coaxial.fieldProbe(30)): 0 when no #fly= path has the camera, else
// 1 + the milliseconds it has flown.
e2_fly_ms :: (s: [] E2) -> int #effects(all) {
  if !e2_flying(s) { return 0; }
  t := s[0].clock - s[0].fly_from;
  return 1 + cast(int) ((ifx t < 0 then 0.0f32 else ifx t > 86400 then 86400.0f32 else t) * 1000);
}
#test "e2 fly: a #fly= path takes the camera and says how long it has flown; an empty one hands it back" {
  s: [1] E2; s[0].clock = 5;
  #assert e2_fly_ms(s[..]) == 0;
  e2_hash(s[..], "fly=0,0,10,0,0,2,-40~4,0,10,-80,0,2,-120");
  #assert e2_flying(s[..]) && e2_probe(s[..], 30) == 1;
  s[0].clock = 7.5; #assert e2_probe(s[..], 30) == 2501;
  mid := trk.cam_track_at(s[0].fly, s[0].clock - s[0].fly_from);
  #assert mid.ez < -30 && mid.ez > -70 && mid.ey > 9.9 && mid.ey < 10.1;
  e2_hash(s[..], "something else"); #assert e2_flying(s[..]);
  e2_hash(s[..], "fly="); #assert !e2_flying(s[..]) && e2_fly_ms(s[..]) == 0 && e2_probe(s[..], 30) <= 0;
  e2_hash(s[..], "fly=0,1,2"); #assert !e2_flying(s[..]);
}
e2_probe :: (s: [] E2, field: int) -> int #export_c #effects(all) {
  // 30 while a #fly= path has the camera: the flyover benchmark's probe (otherwise the room's rest code, below)
  if field == 30 && e2_flying(s) { return e2_fly_ms(s); }
  #if BUILD_DEBUG { if field >= 980 && field < 1000 { return e2a_probe(s, field); } }
  if field == 0 { return s[0].draw_n; } if field == 1 { return s[0].shadow_n; } if field == 2 { return s[0].inst_n; }
  if field == 3 { return s[0].planted; } if field == 173 { return s[0].plant_route; }
  // the world's cells (everglade/client/cells.coax e2cl_probe): 180 the manifest's cells, 181 resident,
  // 182 drawing, 183 loading, 184 frames you stood in a cell that didn't simulate, 185 loads that waited
  // a round, 186 origin rebases, 187 your cell, 188 and 189 the origin's cell, 190 the most resident,
  // 191 frames off the manifest, 192 loads asked, 193 answers refused
  if field == 179 { return ifx s[0].rig_packed then 1 else 0; }   // the people's rig came from the pack's rig entry
  if field >= 180 && field < 194 { return e2cv_probe(s[0].cl[..], field - 180); }
  // the world by cell: 194 the pack is paged by cell, 195 cells taken, 196 cells let go, 197 the cells
  // round you were in once (the scene may draw), 198 the ground's record's status (0 published, -1 none yet)
  if field == 194 { return ifx s[0].paged then 1 else 0; } if field == 195 { return s[0].cells_in; } if field == 196 { return s[0].cells_out; }
  if field == 197 { return ifx e2_world_ready(s) then 1 else 0; } if field == 198 { return s[0].ground_code; }
  // 160 to 168 the graphics quality (e2_knobs_frame): the rung, its tier, the mode, the knobs as the
  // frame uses them (in hundredths: grass, scenery, shadow, post, crowd), the bloom passes
  if field == 160 { return ifx s[0].q_ready then s[0].q[0].rung else -1; } if field == 161 { return ifx s[0].q_ready then quality_tier(s[0].q[..]) else -1; }
  if field == 162 { return s[0].q[0].mode; }
  if field == 163 { return cast(int) (s[0].kn.grass * 100 + 0.5); } if field == 164 { return cast(int) (s[0].kn.scenery * 100 + 0.5); }
  if field == 165 { return cast(int) (s[0].kn.shadow * 100 + 0.5); } if field == 166 { return cast(int) (s[0].kn.post * 100 + 0.5); }
  if field == 167 { return cast(int) (s[0].kn.crowd * 100 + 0.5); } if field == 168 { return e2_bloom_passes(s); }
  // 169 to 172: the device's class and GPU, the rungs the measured start stepped from and to
  if field == 169 { return s[0].q[0].kind; } if field == 170 { return s[0].q_dev.gpu; }
  if field == 171 { return s[0].q[0].probe_from; } if field == 172 { return s[0].q[0].probe_to; }
  if field == 4 { n := 0; for b: 0..<E2_BUCKETS { if s[0].kit_count[b] > 0 { n += 1; } } return n; }
  if field == 5 { return cast(int)(s[0].you_z * 100); }
  // 6 the camera's room along its ray, 7 the eye's height over your feet, 8 your feet over the land (cm)
  if field == 6 { return cast(int)(s[0].orbit.shown * 100); }
  // mouselook: 140 what the host is told, 141 the pointer held, 142 the reticle (percent), 143 the camera's turn, 144 its tilt (milliradians)
  if field == 140 { return mlook.ml_host(s[0].ml[0]); } if field == 141 { return ifx s[0].ml[0].locked then 1 else 0; }
  if field == 142 { return cast(int)(s[0].ml[0].shown * 100); } if field == 143 { return cast(int)(s[0].orbit.yaw * 1000); } if field == 144 { return cast(int)(s[0].orbit.pitch * 1000); }
  // 145, 146 the bar's first slot's middle (device pixels), 147 the slot the pointer is over (-1 none)
  if field == 145 || field == 146 { k := s[0].casts[..]; b := e2k_box(k, 0, s[0].width, s[0].height, s[0].k); return cast(int)(ifx field == 145 then (b[0] + b[2]) / 2 else (b[1] + b[3]) / 2); }
  if field == 147 { return s[0].casts[0].hover; }
  if field >= 150 && field < 160 { return e2m_probe(s, field); }   // the mouse buttons (everglade/client/mouse.coax)
  // the latency check's (coax/web/everglade2-latency.coax): 210, 211 where you are drawn (mm), 212 the
  // way your body faces as drawn (mrad), 213 your own casts' presentations begun (everglade/client/cast.coax e2k_play).
  // They were 190 to 199, which the cells' view (180 to 193) and the world by cell (194 to 198) answer first.
  if field == 210 { return cast(int)(s[0].you_x * 1000); } if field == 211 { return cast(int)(s[0].you_z * 1000); }
  if field == 212 { return cast(int)(e2_show_face(s) * 1000); } if field == 213 { return s[0].casts[0].shown; }
  if field >= 214 && field <= 219 { return e2bw_probe(s, field); }   // the arrows (everglade/client/arrows.coax)
  if field == 7 { return cast(int)((s[0].eye[1] - s[0].you_y) * 100); }
  if field == 8 { return cast(int)((s[0].you_y - e2_height(s[0].you_x, s[0].you_z)) * 100); }
  // 9 the bake's publish status (0 live, -1 not yet), 10 the baked AO at you (thousandths), 11 its crowns
  if field == 9 { return s[0].eg[0].baked; }
  if field == 10 { return cast(int)(e2g_ao(s[0].eg[..], s[0].you_x, s[0].you_z, 1.0) * 1000); }
  if field == 11 { return s[0].eg[0].crown_n; }
  // 12 the vertices the scene's draws run this frame (thousands), 13 the shadow tiles'
  if field == 12 || field == 13 { n := ifx field == 12 then s[0].draw_n else s[0].shadow_n; v := 0;
    for i: 0..<n { k := i * 4; v += cast(int)(ifx field == 12 then s[0].draws[k + 1] * s[0].draws[k + 3] else s[0].shadow[k + 1] * s[0].shadow[k + 3]) / 1000; } return v; }
  // 14 the grass field's share of 12 (thousands), 15 the trees' (kits 0 to 14)
  if field == 14 || field == 15 { v := 0; for i: 0..<s[0].draw_n { k := i * 4; grass := s[0].draws[k + 2] >= cast(u32) E2_FIELD_BASE;
      tree := !grass && s[0].draws[k + 2] >= cast(u32) E2_KIT_BASE && s[0].draws[k] < cast(u32) s[0].kit_first[E2_TREES * E2_LODS];
      if (field == 14 && grass) || (field == 15 && tree) { v += cast(int)(s[0].draws[k + 1] * s[0].draws[k + 3]) / 1000; } } return v; }
  // 16 the plates drawn over bodies this frame (e2_heads), 17 the others' heads collected for them
  if field == 16 { return s[0].plates[0].placed; }
  if field == 17 { return s[0].head_n; }
  // 18 the others that came into your view and thinned in, 19 pops (a body cut off more than E2_POP
  // shown), 87 the bodies thinning out this frame (e2_remotes_draw)
  if field == 18 { return s[0].fade_ins; } if field == 19 { return s[0].pops; } if field == 87 { return s[0].ghosts; }
  if field >= 20 && field < 30 { return e2c_probe(s, field); }   // Character Create's (everglade/client/create.coax)
  // rest (#13046), for a check that presses its controls: 30 the room's rest code (WIRE_REST_*, -1 not
  // said yet), 31 the controls shown, 32 and 33 the first's and the last's requests (RS_REST_*), 34 to
  // 37 their centres in the REST menu (canvas px: x, y, x, y; 132 to 134 open it), 38 your x (cm), 39 a rest refusal shown (1)
  if field >= 30 && field < 40 { n := s[0].net[..]; reqs: [4] int; rn := e2k_rest_choices(s, reqs[..]);
    if field == 30 { return ifx n[0].rest_known then n[0].rest_code else -1; } if field == 31 { return rn; }
    if field == 38 { return cast(int)(s[0].you_x * 100); } if field == 39 { return ifx e2n_rest_message(n).count > 0 then 1 else 0; }
    if rn == 0 { return -1; }
    j := ifx field == 32 || field == 34 || field == 35 then 0 else rn - 1; if field < 34 { return reqs[j]; }
    r := e2k_menu_centre(s, EG_SIDE_REST, EG_DO_REST + j); return cast(int)(ifx (field - 34) % 2 == 0 then r[0] else r[1]); }
  // the casts (#13058): 82 yours sent to the room, 83 others' played here, 88 yours the room said
  // back, 89 cast sounds played (everglade/client/cast.coax)
  if field == 82 { return s[0].net[0].cast_sent; } if field == 83 { return s[0].casts[0].others; }
  if field == 88 { return s[0].net[0].cast_mine; } if field == 89 { return s[0].casts[0].audio[0].played; }
  if field == 200 || field >= E2N_DRIFT { return e2n_drift_probe(s[0].net[..], field); }   // the drift check's (everglade/client/net.coax e2n_drift_probe, #13277)
  if (field >= 40 && field < 66 + E2_REMOTE_PROBES) || (field >= 84 && field <= 86) { return e2_net_probe(s, field); }   // the room's, and the crowd check's boxes and names (e2_net_probe)
  // levels (#13046): 100 to 103 the right halves of Character Create's LEVEL and CLASS boxes (canvas
  // px: x, y, x, y), 104 its level, 105 your bar's slots, 106 the room's word on it known (1), 107
  // refused casts undone, 108 their fades still going, 110 + i what slot i has left (-1 unknown) and
  // 120 + i whether it holds (1)
  // 132, 133: what to press toward REST's menu (canvas px, -1 none): your portrait, or REST's row in
  // the portrait's own menu while that is open; 134 the menu open (EG_SIDE_*, -1 none)
  if field == 132 || field == 133 { c := e2k_side_centre(s, EG_SIDE_REST); return cast(int)(ifx field == 132 then c[0] else c[1]); }
  if field == 134 { return s[0].casts[0].menu; }
  // 130, 131: on a phone, the CLASS tab's centre (canvas px), which shows NAME, CLASS and LEVEL; 0 with no tabs
  if field == 130 || field == 131 { b := s[0].cz[0].boxes[E2C_TAB_BOX + E2C_TAB_CLASS]; if e2c_empty(b) { return 0; } return cast(int)(ifx field == 130 then (b.x0 + b.x1) / 2 else (b.y0 + b.y1) / 2); }
  if field >= 100 && field < 130 { k := s[0].casts[..];
    if field < 104 { b := s[0].cz[0].boxes[ifx field < 102 then E2C_LEVEL_BOX else E2C_CLASS_BOX];
      return cast(int)(ifx field % 2 == 0 then b.x0 + (b.x1 - b.x0) * 0.8 else (b.y0 + b.y1) / 2); }
    if field == 104 { return e2c_level_of(s); } if field == 105 { return k[0].bar_n; }
    if field == 106 { return ifx e2n_slot(s[0].net[..], 0, k[0].bar_n).ok then 1 else 0; } if field == 107 { return k[0].undone; }
    if field == 108 { m := 0; for f: 0..<E2K_FADES { if k[0].fades[f].slot >= 0 && s[0].clock - k[0].fades[f].at <= f32(E2K_FADE) { m += 1; } } return m; }
    w := e2n_slot(s[0].net[..], field % 10, k[0].bar_n); if field >= 110 && field < 120 { return w.left; } if field >= 120 { return ifx w.on then 1 else 0; }
    return -1; }
  // the ground (#13059): 90 its route (1 the pack's record, 2 converted here), 91 its tiles, 92 sets
  // published, 93 refusals, 94 the first refusal's code, 95 KiB resident, 96 and 97 the set's and the
  // glade tile's revision (first word, as a signed int), 98 queries off the tiles
  if field >= 90 && field < 99 { g := s[0].eg[..];
    if field == 90 { return g[0].route; } if field == 92 { return g[0].published; }
    if field == 93 { return g[0].refused; } if field == 94 { return g[0].first_refusal; } if field == 95 { return e2g_resident(g) / 1024; }
    if field == 91 || field == 96 { if !g[0].ok { return 0; } ls := e2g_live_set(g); return ifx field == 91 then ls[0].n else cast(int)cast,trunc(s32) ls[0].revision[0]; }
    if field == 97 { return cast(int)cast,trunc(s32) g[0].receipt.output[0]; }
    return g[0].outside; }
  return -1;
}

// ---- the room (#13054): what the face asks of everglade/client/net.coax, and the others drawn

// Your look for the room's hello: the record Character Create keeps for you.
e2_net_look :: (s: [] E2) {
  b: [64] u8;
  if !s[0].creator[0].configured { return; }
  m := cc.save(s[0].creator[0], b[..]);
  if m > 0 { e2n_set_look(s[0].net[..], cast(string) b[0..<m]); }
}
// The frame's room work, from the face: you join once the run starts (USE IN EVERGLADE), or at once
// when you come in with a character; then the clock, the socket, the others where they are drawn.
e2_net_step :: (s: [] E2, mono: int) #export_c #effects(all) {
  n := s[0].net[..];
  if s[0].player_key_n > 0 && s[0].action == 0 {
    for i: 0..<s[0].player_key_n { s[0].outbox[i] = s[0].player_key[i]; }
    s[0].out_n = s[0].player_key_n; s[0].action = E2_ACT_PLAYER; s[0].player_key_n = 0;
  }
  _ := e2c_unclassed(s);   // /play, a kept look, no class kept by the API: Character Create before the hello (#13268)
  n[0].joined = !s[0].cz[0].on || s[0].cz[0].walking;
  e2n_where(n, s[0].you_x, s[0].you_z, s[0].you_face);   // for a hello after a lost room (#13057)
  if n[0].joined { e2_net_look(s); }   // the record as it stands: a change in the studio is said again
  e2n_step(n, mono);
}
// Seated in a room: the face steps you at its rate and sends each step.
e2_net_live :: (s: [] E2) -> bool #export_c #effects(all) { return e2n_open(s[0].net[..]); }
// The run holds its feet until the room seats you, E2N_HOLD_MS at most (then it walks on alone).
e2_net_holding :: (s: [] E2, waited_ms: int) -> bool #export_c #effects(all) {
  n := s[0].net[0];
  return n.want && n.joined && !n.stale && !n.elsewhere && !e2n_open(s[0].net[..]) && !n.sat && waited_ms < E2N_HOLD_MS;
}
e2_net_as_sent :: (s: [] E2, m: EgMoveIn) -> EgMoveIn #export_c #effects(all) { return e2n_as_sent(m); }
e2_net_input :: (s: [] E2, m: EgMoveIn) -> int #export_c #effects(all) { return e2n_input(s[0].net[..], m); }
e2_net_fix_due :: (s: [] E2) -> bool #export_c #effects(all) { return e2n_fix_due(s[0].net[..]); }
e2_net_fix :: (s: [] E2) -> NetFix #export_c #effects(all) { return s[0].net[0].fix; }
e2_net_replay_n :: (s: [] E2) -> int #export_c #effects(all) { return net_predict_pending(s[0].net[0].pred[..]); }
e2_net_replay_input :: (s: [] E2, k: int) -> EgMoveIn #export_c #effects(all) { return e2n_replay_input(s[0].net[..], k); }
e2_net_fixed :: (s: [] E2, dx: f32, dy: f32, dz: f32) #export_c #effects(all) { e2n_fixed(s[0].net[..], dx, dy, dz); }
e2_net_offset :: (s: [] E2, dt: f32) -> figs.Point #export_c #effects(all) { o := net_correct_step(s[0].net[0].off[..], dt); return figs.v3(o[0], o[1], o[2]); }
// The socket's commands for the host (the face drains them): the pipe, as Everglade's.
e2_net_pipe :: (s: [] E2) -> int #export_c #effects(all) { return s[0].net[0].pipe[0].n; }
e2_net_pipe_op :: (s: [] E2, k: int) -> int #export_c #effects(all) { return s[0].net[0].pipe[0].op[k]; }
e2_net_pipe_id :: (s: [] E2, k: int) -> int #export_c #effects(all) { return s[0].net[0].pipe[0].id[k]; }
e2_net_pipe_from :: (s: [] E2, k: int) -> int #export_c #effects(all) { return s[0].net[0].pipe[0].from[k]; }
e2_net_pipe_len :: (s: [] E2, k: int) -> int #export_c #effects(all) { return s[0].net[0].pipe[0].len[k]; }
e2_net_pipe_done :: (s: [] E2) #export_c #effects(all) { pipe_drained(s[0].net[0].pipe[..]); }
e2_net_named :: (s: [] E2, answer: string) #export_c #effects(all) { e2c_named(s, answer); }
// The host's keyboard field (host.js coaxial_wants_text, coaxial_field): over NAME while it takes keys.
e2_wants_text :: (s: [] E2) -> bool #export_c #effects(all) { return e2c_creating(s) && s[0].cz[0].editing; }
e2_text_field :: (s: [] E2, out: [] f32) #export_c #effects(all) { b := s[0].cz[0].boxes[E2C_NAME_BOX]; if out.count >= 4 { out[0] = b.x0; out[1] = b.y0; out[2] = b.x1; out[3] = b.y1; } }
e2_net_opened :: (s: [] E2, id: int) #export_c #effects(all) { e2n_opened(s[0].net[..], id); }
e2_net_ticket :: (s: [] E2, answer: string) #export_c #effects(all) { e2n_ticket(s[0].net[..], answer); }
// For headless checks (e2_probe 40 to 59): the room as this page has it.
e2_net_probe :: (s: [] E2, f: int) -> int {
  n := s[0].net[..];   // a view: E2Net is too big to copy onto the stack for each probe
  if f == 40 { return n[0].state; } if f == 41 { return n[0].seat; } if f == 42 { return e2n_remotes(s[0].net[..]); }
  if f == 43 { return n[0].delay; } if f == 44 { return cast(int) n[0].lag; } if f == 45 { return cast(int)(n[0].jitter * 100); }
  if f == 46 { return n[0].pred[0].replays; } if f == 47 { return cast(int)(sqrt(n[0].fix_sq) * 1000); } if f == 48 { return n[0].frames_in; }
  if f == 49 { return n[0].tries; } if f == 50 { return ifx n[0].want then 1 else 0; } if f == 51 { return ifx n[0].joined then 1 else 0; }
  if f == 52 { return n[0].look_n; } if f == 54 { return n[0].pings; }
  // 84 the times this page sat again and said where it stood (A), 85 the room's first word on you after
  // the last of them less where you were drawn (mm, -1 none), 86 the ms from losing the room to it (#13057)
  if f == 84 { return n[0].agains; } if f == 85 { return n[0].back_fix_mm; } if f == 86 { return n[0].back_ms; }
  if f == 53 { c := 0; for e: 0..<E2N_ENTS { en := n[0].ents[e]; if en.live && en.kind == WK_PLAYER && en.seat != n[0].seat && en.name_n > 0 { c += 1; } } return c; }
  if f == 55 { return ifx n[0].pings > 0 then n[0].ping_rtt[net_ping_best(n[0].ping_rtt[..], n[0].pings)] else -1; }
  // 56, 57: USE IN EVERGLADE's centre (canvas px), for a check that presses it; 58 the first other's
  // drawn x and 59 its z (cm), -999999 none
  if f == 56 || f == 57 { b := s[0].cz[0].boxes[17]; return cast(int)(ifx f == 56 then (b.x0 + b.x1) / 2 else (b.y0 + b.y1) / 2); }
  // 60, 61: SURPRISE ME's centre, for a check that makes each page someone different
  if f == 60 || f == 61 { b := s[0].cz[0].boxes[14]; return cast(int)(ifx f == 60 then (b.x0 + b.x1) / 2 else (b.y0 + b.y1) / 2); }
  // 62, 63: NAME's centre; 64 a refused name's reason shown (its length), 65 the name with the API;
  // 66 + K the K-th other's name as 31 bits of FNV-1a (0 none), for a check that names each page
  if f == 62 || f == 63 { b := s[0].cz[0].boxes[E2C_NAME_BOX]; return cast(int)(ifx f == 62 then (b.x0 + b.x1) / 2 else (b.y0 + b.y1) / 2); }
  if f == 64 { return s[0].cz[0].said_n; } if f == 65 { return ifx s[0].cz[0].naming then 1 else 0; }
  if f >= 66 && f < 66 + E2_REMOTE_PROBES {
    r := e2n_remote(s[0].net[..], f - 66); if !r.ok { return 0; }
    en := s[0].net[0].ents[r.slot]; return e2_name_hash(cast(string) en.name[0..<en.name_n]);
  }
  if f == 58 || f == 59 { r := e2n_remote(s[0].net[..], 0); if !r.ok { return -999999; } return cast(int)((ifx f == 58 then r.x else r.z) * 100); }
  return -1;
}

// 31 bits of FNV-1a: the probes' way to say a name (e2_net_probe 66 + K).
e2_name_hash :: (t: string) -> int { h := 2166136261; for ch: t { h = ((h ^ cast(int) ch) * 16777619) & 0xffffffff; } return h & 0x7fffffff; }
#test "the crowd check's probes: SURPRISE ME's and NAME's boxes, the name with the API, and the others' names" {
  s: [1] E2; e2c_layout(s[..], 1280, 720, 1);
  // held sideways, NAME is on the CLASS tab: the check presses the tab first (e2_probe 130, 131)
  #assert e2_probe(s[..], 60) > 0 && e2_probe(s[..], 61) > 0 && e2_probe(s[..], 62) == 0 && e2_probe(s[..], 130) > 0 && e2_probe(s[..], 131) > 0;
  s[0].cz[0].tab = E2C_TAB_CLASS; e2c_layout(s[..], 1280, 720, 1);
  #assert e2_probe(s[..], 62) > 0 && e2_probe(s[..], 63) > 0 && e2_probe(s[..], 102) > 0 && e2_probe(s[..], 100) > 0;
  #assert e2_probe(s[..], 64) == 0 && e2_probe(s[..], 65) == 0 && e2_probe(s[..], 66) == 0 && e2_probe(s[..], 66 + E2_REMOTE_PROBES) == 0;   // 82 on: the casts' (none sent)
}
#test "a name's probe hash is FNV-1a's, 31 bits" { #assert e2_name_hash("") == 2166136261 & 0x7fffffff && e2_name_hash("a") == 0x640c292c && e2_name_hash("Crowd Alpha") != e2_name_hash("Crowd Bravo"); }
// A remote's look: your creator (its catalog, its parts) with that player's record restored. When the
// record is no Character Create record (a v1 page's ranger.S.D.T, or none) it is Character Create's
// default body, never you as you are dressed. False then.
e2_remote_look :: (s: [] E2, look: string) -> bool {
  s[0].rtmp[0] = s[0].creator[0];
  if cc.restore(s[0].rtmp[..], look) { return true; }
  s[0].rtmp[0] = s[0].creator[0]; cc.reset(s[0].rtmp[..]);
  return false;
}
#test "another's v1 look or none draws Character Create's default body, not you" {
  s: [1] E2;
  cc.reset(s[0].creator[..]); s[0].creator[0].outfit = 3; s[0].creator[0].dye = 2; s[0].creator[0].female = true;
  #assert !e2_remote_look(s[..], "ranger.1.2.3");
  #assert s[0].rtmp[0].outfit == 2 && s[0].rtmp[0].dye == 8 && !s[0].rtmp[0].female;
  #assert !e2_remote_look(s[..], "");
  #assert s[0].rtmp[0].outfit == 2 && s[0].creator[0].outfit == 3;
  out: [64] u8; n := cc.save(s[0].creator[0], out[..]);
  #assert e2_remote_look(s[..], cast(string) out[0..<n]) && s[0].rtmp[0].outfit == 3 && s[0].rtmp[0].female;
}
E2Drawn :: struct { rec: int; n: int; sn: int; }
// One body's draws: its worn parts, then its head, hair and beard, each a record with the figure's
// pose and the body's eyes.
e2_body :: (s: [] E2, c: cc.Creator, fig: figs.BdAnim, at: E2Drawn) -> E2Drawn { return e2_body_of(s, c, fig, at, false); }
// any: every worn part the catalog holds, not only those a player may pick (the guard's knight armour).
e2_body_of :: (s: [] E2, c: cc.Creator, fig: figs.BdAnim, at: E2Drawn, any: bool) -> E2Drawn {
  b := s[0].bodies[..]; out := s[0].records[..];
  rec := at.rec; n := at.n; sn := at.sn; from := rec;
  l := cc.look(c); l.variant = 0;
  for i: 0..<40 { if c.worn[i] && (any || cc.available(c, i)) && c.source_count[i + (ifx c.female then 0 else 40)] > 0 && rec < E2_RECORDS {
    p := i + ifx c.female then 0 else 40;
    figs.bd_record(fig, l, c.source_word[p], false, s[0].clock, out, rec); out[rec * 24 + 11] = f32(c.variant);
    n = e2_draw(s[0].draws[..], n, c.source_first[p], c.source_count[p], rec, 1); sn = e2_draw(s[0].shadow[..], sn, c.source_first[p], c.source_count[p], rec, 1); rec += 1;
  } }
  parts: [3] int; pn := 0;
  if !c.worn[7] { parts[pn] = l.head; pn += 1; }
  if l.hair >= 0 && !c.worn[7] && !c.worn[26] { parts[pn] = l.hair; pn += 1; }
  if l.extra == figs.BP_BEARD && !c.worn[7] { parts[pn] = l.extra; pn += 1; }
  for i: 0..<pn { if rec < E2_RECORDS {
    p := parts[i]; figs.bd_record(fig, l, b[0].part_word[p], false, s[0].clock, out, rec);
    n = e2_draw(s[0].draws[..], n, b[0].part_first[p], b[0].part_count[p], rec, 1); sn = e2_draw(s[0].shadow[..], sn, b[0].part_first[p], b[0].part_count[p], rec, 1); rec += 1;
  } }
  for i: from..<rec { for k: 0..<3 { out[i * 24 + 20 + k] = cc.EYES[c.eye_color][k]; } out[i * 24 + 23] = 2; }
  return E2Drawn.{rec = rec, n = n, sn = sn};
}
// A body down (its bearing's pose, rules/srd/condition-bearing.coax: Unconscious or dead): it
// falls (the rig's fall, once, then held) and lies Prone until the rules have it up again, when it
// stands back into its gait.
e2_fall :: (a: [] figs.BdAnim, b: DeedBearing, now: f32) {
  lie := b.pose == DeedPose.down;
  if lie && a[0].state == 0 { a[0].state = 1; a[0].fell_at = now; }
  if !lie && a[0].state != 0 { a[0].state = 0; }
}
// A blow's number over (x, y, z) from source (0 the guard struck, 1 his blows, 2 + M monster M's): the
// room's own amount (metaverse-engine/action/floats.coax: red when you took it, "miss" when it missed, a
// critical hit larger), so the number is the Hit Points you lost.
// It is the present of an accepted action (metaverse-engine/action/deed.coax deed_show, docs/metaverse/action-pipeline.md):
// feel is the action's (class-feel.coax), and only a result the show plays puts a number up.
e2_float :: (s: [] E2, feel: DeedFeel, source: int, x: f32, y: f32, z: f32, kind: int, crit: bool, amount: int) -> DeedShow {
  show := deed_show(feel, ifx amount > 0 then DeedResult.hit else DeedResult.miss);
  if show.play { _ := fl.floats_amount(s[0].floats[..], source, x, y, z, s[0].clock, kind, crit, amount); }
  return show;
}
// Each live number where it has risen to, its size and colour by kind, thinning as it goes.
e2_floats_draw :: (s: [] E2, out: [] f32, at: int) -> int {
  v := at; now := s[0].clock; view := e2_eg_view(s);
  for q: 0..<fl.FLOATS {
    l := cc.eg_numbers_look(s[0].floats[..], q, now);
    if !l.ok { continue; }
    n := s[0].floats[0].items[q];
    // only while the body it rose off shows (everglade/client/sight.coax)
    if eg_view_ahead(view, l.x, l.y, l.z) < 0.5 || !e2_sight_shows(s, n.x, n.y - 1.2, n.z, 1.2) { continue; }
    // Everglade's damage number (everglade/hud/numbers.coax, placed by windows.coax eg_float_over): red when you took it, small
    // "miss"; a critical hit drawn larger over it (floats_look's size)
    v = eg_float_over(out, v, view, l.x, l.y, l.z, fl.floats_text(s[0].floats[..], q), s[0].k * l.size, cc.eg_numbers_ink(n.kind), l.alpha);
  }
  cc.eg_numbers_frame(s[0].floats[..]);
  return v;
}
// Where the camera looks from, for the HUD's marks over the world (everglade/hud/windows.coax EgView).
e2_eg_view :: (s: [] E2) -> EgView {
  cy := ifx s[0].cy > 0 then s[0].cy else s[0].height * 0.5;
  return EgView.{eye = s[0].eye, fwd = s[0].fwd, right = s[0].right, up = s[0].up, focal = s[0].focal, w = s[0].width, h = s[0].height, cy = cy};
}
// The kit a class's body carries here (class-kit.coax xc_kit, charactercreator.coax CC_KITS): the Ranger
// starts with the Longbow in hand (SRD 5.2.1 p.58). The melee kits wait for Everglade II's hold clips.
e2_kit_of :: (klass: int) -> int { k := xc_kit(klass); return ifx k == XC_KIT_BOW then k else -1; }
// A body's kit after its records (its first record, from, its pose): the shared held pieces
// (charactercreator.coax held_pieces: the bow on its attach, its string and a nocked arrow), each a
// flag-19 record thinned as the body is (drop).
e2_held :: (s: [] E2, at: E2Drawn, from: int, kit: int, female: bool, aim: f32, nocked: bool, drop: f32) -> E2Drawn {
  c := s[0].creator[..]; out := s[0].records[..]; d := at;
  if kit < 0 || from >= d.rec { return d; }
  if kit == XC_KIT_BOW { cc.bow_arm_records(out, from, d.rec); }   // a bow carrier: the bow arm out (the body's records, from to d.rec)
  h: [1] cc.HeldPieces; cc.held_pieces(h[..], kit, female, aim, nocked, s[0].bodies[..], out[from * 24..<from * 24 + 24]);
  for i: 0..<h[0].n {
    m := h[0].mesh[i];
    if c[0].weapon_count[m] <= 0 || d.rec >= E2_RECORDS || d.n >= E2_DRAWS { continue; }
    q := d.rec * 24;
    for k: 0..<24 { out[q + k] = 0; }
    put := [4] int.[0, 8, 16, 20];
    for j: 0..<4 { for r: 0..<3 { out[q + put[j] + r] = h[0].w[i][j * 3 + r]; } }
    out[q + 7] = f32(c[0].glade_word); out[q + 15] = 19; out[q + 23] = drop;
    d.n = e2_draw(s[0].draws[..], d.n, c[0].weapon_first[m], c[0].weapon_count[m], d.rec, 1);
    d.sn = e2_draw(s[0].shadow[..], d.sn, c[0].weapon_first[m], c[0].weapon_count[m], d.rec, 1);
    d.rec += 1;
  }
  return d;
}
// Another player's class as the room names it (-1 none), and how far their bow's aim is in: up as
// their Attack's arrow looses (its act, the room's e cast) and down over the follow-through.
e2_remote_class :: (s: [] E2, slot: int) -> int { return ifx slot >= 0 && slot < E2N_ENTS then s[0].net[0].ent_class[slot] else -1; }
e2_remote_aim :: (s: [] E2, slot: int) -> f32 {
  if slot < 0 || slot >= E2N_ENTS || e2_kit_of(e2_remote_class(s, slot)) != XC_KIT_BOW { return 0; }
  t := s[0].clock - s[0].casts[0].them[slot].at;
  return ifx t < 0 || t > f32(bow.BOW_FOLLOW) then 0.0f32 else 1 - t / f32(bow.BOW_FOLLOW);
}
// Your own kit: the class Character Create has (in the studio the one picked), drawn and nocked as
// the mouse draws it (everglade/client/mouse.coax).
e2_my_held :: (s: [] E2, d: E2Drawn, from: int) -> E2Drawn {
  m := s[0].mouse[0];
  klass := ifx e2c_creating(s) then e2c_class_of(s) else s[0].casts[0].klass;
  return e2_held(s, d, from, e2_kit_of(klass), s[0].creator[0].female, bow.bow_aim(m.draw[0]), m.draw[0].on, 0);
}
// The others, as the room has them drawn this frame: each on the land, its own walk and run from how
// fast it goes, its jump from its feet off the ground, its own look; and its name for e2_heads.
e2_familiars_draw :: (s:[]E2,at:E2Drawn)->E2Drawn {
  d:=at; net:=s[0].net[..]; c:=s[0].creator[..];
  for i:0..<E2N_FAMILIARS {
    f:=e2n_familiar_of(net,i);
    if !f.live || (i==net[0].seat && e2n_familiar_sense(net)>E2_SENSE_OWNER) || d.rec>=E2_RECORDS || d.n>=E2_DRAWS { continue; }
    count:=c[0].familiar_count[f.form];
    if count<=0 { continue; }
    yaw:=ifx i==net[0].seat then s[0].you_face else e2n_remote_seat(net,i).yaw;
    cc.familiar_record(s[0].records[..],d.rec,c[0].familiar_word[f.form],f.x,e2_height(f.x,f.z),f.z,yaw);
    first:=c[0].familiar_first[f.form];
    d.n=e2_draw(s[0].draws[..],d.n,first,count,d.rec,1);
    d.sn=e2_draw(s[0].shadow[..],d.sn,first,count,d.rec,1);
    d.rec+=1;
  }
  return d;
}
e2_remotes_draw :: (s: [] E2, at: E2Drawn, bdt: f32) -> E2Drawn {
  d := at; s[0].head_n = 0; s[0].ghosts = 0;
  step := ifx bdt > 0 then bdt / f32(E2_FADE_S) else 0.0f32;
  seen: [E2N_ENTS] bool;
  // the graphics quality's crowd knob: past its share, the others thin out as if gone from view
  most := quality_share(E2_REMOTES, s[0].kn.crowd, 1);
  for k: 0..<most {
    r := e2n_remote(s[0].net[..], k);
    if !r.ok { break; }
    r = e2rv_remote(s, r);   // in the saddle of the mount that carries them (ride-view.coax)
    en := s[0].net[0].ents[r.slot]; slot := r.slot; seen[slot] = true;
    // a new player in this slot: from nothing (one still thinning out here is cut: a pop if it showed)
    if s[0].rseat[slot] != r.seat + 1 {
      if s[0].rfade[slot] > f32(E2_POP) { s[0].pops += 1; }
      s[0].rfade[slot] = 0; s[0].rseat[slot] = r.seat + 1; s[0].fade_ins += 1;
    }
    up := s[0].rfade[slot] + step; s[0].rfade[slot] = ifx up > 1 then 1.0f32 else up;
    s[0].rlast[slot] = r;
    ln := ifx en.look_n < NET_LOOK then en.look_n else NET_LOOK; s[0].rlook_n[slot] = ln; for i: 0..<ln { s[0].rlook[slot * NET_LOOK + i] = en.look[i]; }
    a := s[0].ranim[slot..<slot + 1];
    if !a[0].on || s[0].rlife[slot] != en.born { a[0] = figs.BdAnim.{}; a[0].on = true; s[0].rair[slot] = false; s[0].rland_at[slot] = -100; s[0].rlife[slot] = en.born; s[0].casts[0].them[slot] = E2kAct.{}; }
    ground := e2_height(r.x, r.z);
    d = e2_remote_body(s, r, slot, d, bdt);
    if s[0].head_n < E2_REMOTES && en.name_n > 0 {
      p := s[0].heads[s[0].head_n..<s[0].head_n + 1];
      p[0].x = r.x; p[0].y = ground + r.y + 2.05; p[0].z = r.z; p[0].fade = s[0].rfade[slot];   // the head's top
      p[0].name_n = en.name_n; for i: 0..<en.name_n { p[0].name[i] = en.name[i]; }
      s[0].head_n += 1;
    }
  }
  // the ones gone from your view: thinning out where they were last drawn
  for slot: 0..<E2N_ENTS {
    if seen[slot] || s[0].rseat[slot] == 0 { continue; }
    down := s[0].rfade[slot] - step; s[0].rfade[slot] = ifx down < 0 then 0.0f32 else down;
    if s[0].rfade[slot] <= 0 { s[0].rseat[slot] = 0; continue; }
    s[0].ghosts += 1;
    d = e2_remote_body(s, s[0].rlast[slot], slot, d, bdt);
  }
  return d;
}
// One other's body at r with slot's look and fade: on the land, its walk and run from its speed, its
// jump from its feet off the ground, its records' fade word (everglade/client/gpu/everglade2.coax e2_body_fade).
e2_remote_body :: (s: [] E2, r: E2Remote, slot: int, at: E2Drawn, bdt: f32) -> E2Drawn {
  a := s[0].ranim[slot..<slot + 1];
  ground := e2_height(r.x, r.z);
  a[0].x = r.x; a[0].z = r.z; a[0].y = ground + r.y; a[0].yaw = r.yaw; a[0].own = false;
  row := wire_mirror_of(s[0].net[0].mir[..], r.seat);
  if row.id == r.seat && row.kind == WK_PLAYER { e2_fall(a, e2k_bearing_row(row), s[0].clock); }   // theirs as the room has them
  figs.bd_step(a, s[0].clock, bdt);
  air := r.y > f32(E2_AIRBORNE);
  if air && !s[0].rair[slot] { s[0].rair_at[slot] = s[0].clock; }
  if !air && s[0].rair[slot] { s[0].rland_at[slot] = s[0].clock; }
  s[0].rair[slot] = air;
  fig := e2k_figure(e2_jump_figure(a[0], air, s[0].clock, s[0].rair_at[slot], s[0].rland_at[slot]), s[0].casts[0].them[slot], s[0].clock);
  aim := e2_remote_aim(s, slot);   // a Ranger's loose: the drawn bow's pose, then its follow-through
  if aim > 0 && !air { fig = cc.held_bow_layer(fig, aim, 1, false, s[0].clock - s[0].casts[0].them[slot].at, s[0].clock); }
  fig = e2rv_figure(s, fig, r.seat, s[0].net[0].tick);   // riding: seated in the saddle
  look := cast(string) s[0].rlook[slot * NET_LOOK..<slot * NET_LOOK + s[0].rlook_n[slot]];
  _ := e2_remote_look(s, look); c := s[0].rtmp[0];
  from := at.rec;
  d := e2_body(s, c, fig, at);
  drop := e2_fade_drop(s[0].rfade[slot]);
  for i: from..<d.rec { s[0].records[i * 24 + 23] = 2 + drop; }
  if d.rec > from { d = e2_held(s, d, from, e2_kit_of(e2_remote_class(s, slot)), c.female, e2_remote_aim(s, slot), false, drop); }
  return d;
}
// The share of a body's pixels the dither drops at fade f (0 gone, 1 whole): eased, and never all of
// them while it is drawn (the record's word stays under 3).
e2_fade_drop :: (f: f32) -> f32 { t := ifx f < 0 then 0.0f32 else ifx f > 1 then 1.0f32 else f; e := t * t * (3 - 2 * t); return ifx 1 - e > 0.999 then 0.999f32 else 1 - e; }
#test "another player thins in over E2_FADE_S as it comes into your view, and out where it was as it leaves" {
  #assert e2_fade_drop(1) == 0 && e2_fade_drop(0) > 0.99 && e2_fade_drop(0) < 1 && abs(e2_fade_drop(0.5) - 0.5) < 0.001;
  s: [1] E2; s[0].net[0].state = E2N_OPEN; s[0].net[0].seat = 1;
  k := e2n_ent(s[0].net[..], 3, true); en := s[0].net[0].ents[k..<k + 1]; en[0].kind = WK_PLAYER; en[0].seat = 3;
  net_push(en, NetState.{t = 0, x = 4, z = -2});
  rows := 0; shown: [45] f32;
  for f: 0..<45 {
    if f == 20 { s[0].net[0].ents[k].live = false; }   // the room's x: gone from your view
    d := e2_remotes_draw(s[..], E2Drawn.{}, 1.0 / 60.0);
    shown[f] = s[0].rfade[k]; if d.rec > 0 { rows += 1; }
  }
  #assert s[0].fade_ins == 1 && s[0].pops == 0;
  // up a sixtieth over E2_FADE_S a frame, never a jump; then down from where it was to nothing
  for f: 1..<45 { #assert abs(shown[f] - shown[f - 1]) < 0.03; }
  #assert shown[19] > 0.5 && shown[19] < 0.6 && shown[44] == 0 && s[0].rseat[k] == 0 && rows >= 38 && rows <= 40;
}
// The view the plates over bodies are placed from: the eye, its axes, the picture's centre and size.
e2_plate_view :: (s: [] E2) -> cc.HudPlateView {
  return cc.HudPlateView.{eye = s[0].eye, fwd = s[0].fwd, right = s[0].right, up = s[0].up, focal = s[0].focal,
                          cx = s[0].width * 0.5, cy = ifx s[0].cy > 0 then s[0].cy else s[0].height * 0.5, w = s[0].width, h = s[0].height};
}
// The plates over bodies, Everglade's shared ones (metaverse-engine/ui/hud-plates.coax places them,
// everglade/hud/parts.coax eg_plates draws them): the others' names, the familiars' names and health,
// the monsters' and the guard's. Each shows while its body does (everglade/client/sight.coax), whole within
// HUD_PLATE_NEAR m and gone past HUD_PLATE_FAR; a farther name over a nearer one lifts clear of it.
e2_heads :: (s: [] E2, out: [] f32, at: int) -> int {
  p := s[0].plates[..]; view := e2_plate_view(s);
  cc.hud_plates_begin(p);
  // the others first, in order, so plate i is head i
  for i: 0..<s[0].head_n {
    h := s[0].heads[i];
    s[0].sight_rem[i] = ifx cc.hud_plate_in_reach(view, h.x, h.y, h.z, cc.HUD_PLATE_FAR) then e2_sight_step(s, s[0].sight_rem[i], h.x, h.y - 2.05, h.z, 1.8) else cc.hud_sight_gone();
    seen := s[0].sight_rem[i].share;
    cc.hud_plates_push(p, h.x, h.y, h.z, cast(string) h.name[0..<h.name_n], -1, false, false, seen * h.fade);
  }
  for owner: 0..<E2N_FAMILIARS {
    row := e2n_familiar_of(s[0].net[..], owner);
    if !row.live || row.max <= 0 { continue; }
    foot := e2_height(row.x, row.z);
    if !cc.hud_plate_in_reach(view, row.x, foot + 0.65, row.z, cc.HUD_PLATE_FAR) || !e2_sight_shows(s, row.x, foot, row.z, 0.6) { continue; }
    cc.hud_plates_push(p, row.x, foot + 0.65, row.z, rs_monster_block(RS_FAMILIAR_FORMS[row.form]).name, f32(row.hp) / f32(row.max), false, false, 1);
  }
  e2mn_plate_add(s, p, view); e2gd_plate_add(s, p, view); e2p_plate_add(s, p, view); e2sp_plate_add(s, p, view);
  return cc.eg_plates(out, at, p, view, s[0].k, 0);
}
#test "two names in the same place in the picture: the farther one moves up clear of the nearer" {
  s: [1] E2; out: [8192 * E2_VERTEX_FLOATS] f32;
  s[0].k = 1; s[0].width = 1280; s[0].height = 720; s[0].focal = 900;
  y := e2_height(0, -150) + 2;
  s[0].eye = [3]f32.[0, y, -150]; s[0].fwd = [3]f32.[0, 0, -1]; s[0].right = [3]f32.[1, 0, 0]; s[0].up = [3]f32.[0, 1, 0];
  s[0].head_n = 2;
  s[0].heads[0].x = 0; s[0].heads[0].y = y + 0.4; s[0].heads[0].z = -162;   // farther, first in the list
  s[0].heads[1].x = 0; s[0].heads[1].y = y + 0.3; s[0].heads[1].z = -158;
  for i: 0..<2 { for c: 0..<6 { s[0].heads[i].name[c] = "Badger"[c]; } s[0].heads[i].name_n = 6; }
  _ := e2_heads(s[..], out[..], 0);
  pl := s[0].plates[0];
  #assert pl.placed == 2 && pl.items[0].sy < pl.items[1].sy - 13;
}
#test "a name is drawn over a head ahead within reach, and not over one behind you or too far" {
  s: [1] E2; out: [4096 * E2_VERTEX_FLOATS] f32;
  s[0].k = 1; s[0].width = 1280; s[0].height = 720; s[0].focal = 900;
  y := e2_height(0, -150) + 2;
  s[0].eye = [3]f32.[0, y, -150]; s[0].fwd = [3]f32.[0, 0, -1]; s[0].right = [3]f32.[1, 0, 0]; s[0].up = [3]f32.[0, 1, 0];
  s[0].head_n = 3;
  s[0].heads[0].x = 0; s[0].heads[0].y = e2_height(0, -158) + 2.05; s[0].heads[0].z = -158;   // 8 m ahead
  s[0].heads[1].x = 0; s[0].heads[1].y = e2_height(0, -142) + 2.05; s[0].heads[1].z = -142;   // behind
  s[0].heads[2].x = 0; s[0].heads[2].y = e2_height(0, -200) + 2.05; s[0].heads[2].z = -200;   // 50 m off
  for i: 0..<3 { s[0].heads[i].name[0] = 'A'; s[0].heads[i].name[1] = 'r'; s[0].heads[i].name_n = 2; }
  v := e2_heads(s[..], out[..], 0);
  pl := s[0].plates[0];
  #assert pl.placed == 1 && v > 0 && pl.items[0].shown == 1 && pl.items[1].shown == 0 && pl.items[2].shown == 0;
}
#test "a plate shows only while its body does: behind the camp's stall none is drawn, beside it one is, fading over 0.15 s" {
  s: [1] E2; out: [4096 * E2_VERTEX_FLOATS] f32; s[0].k = 1; s[0].width = 1280; s[0].height = 720; s[0].focal = 900;
  st := E2_CAMP[1]; sx := e2_camp_px(st); sz := e2_camp_pz(st); c := cos(st.yaw); sn := sin(st.yaw);
  // the eye 9 m off the stall's deep side, low; a body 3 m past its far side, and one 12 m to the side
  ex := sx - 9 * sn; ez := sz - 9 * c; s[0].eye = [3] f32.[ex, e2_height(ex, ez) + 0.9, ez];
  hx := sx + 3 * sn; hz := sz + 3 * c; ox := hx + 12 * c; oz := hz - 12 * sn;
  #assert !e2_sight_shows(s[..], hx, e2_height(hx, hz), hz, 1.8) && e2_sight_shows(s[..], ox, e2_height(ox, oz), oz, 1.8);
  for q: 0..<2 {
    bx := ifx q == 0 then hx else ox; bz := ifx q == 0 then hz else oz;
    dx := bx - ex; dz := bz - ez; l := sqrt(dx * dx + dz * dz);
    s[0].fwd = [3] f32.[dx / l, 0, dz / l]; s[0].right = [3] f32.[-dz / l, 0, dx / l]; s[0].up = [3] f32.[0, 1, 0];
    s[0].head_n = 1; s[0].heads[0].x = bx; s[0].heads[0].y = e2_height(bx, bz) + 2.05; s[0].heads[0].z = bz;
    s[0].heads[0].name[0] = 'A'; s[0].heads[0].name_n = 1; s[0].sight_rem[0] = cc.HudSight.{}; s[0].sight_dt = 1;
    _ := e2_heads(s[..], out[..], 0);
    #assert (q == 0) == (s[0].plates[0].placed == 0);
  }
  // coming into view, it fades in over 0.15 s, not at once
  s[0].sight_rem[0] = cc.HudSight.{}; s[0].sight_dt = 0.05; _ := e2_heads(s[..], out[..], 0);
  #assert s[0].plates[0].placed == 1 && s[0].sight_rem[0].share > 0.3 && s[0].sight_rem[0].share < 0.4;
  // its health bar and name ride the same answer: behind the stall again, the plate holds one stray
  // frame (metaverse-engine/physics/visibility.coax vis_settle), then fades
  s[0].heads[0].x = hx; s[0].heads[0].y = e2_height(hx, hz) + 2.05; s[0].heads[0].z = hz;
  dx := hx - ex; dz := hz - ez; l := sqrt(dx * dx + dz * dz);
  s[0].fwd = [3] f32.[dx / l, 0, dz / l]; s[0].right = [3] f32.[-dz / l, 0, dx / l];
  s[0].sight_rem[0] = cc.HudSight.{share = 1}; _ = e2_heads(s[..], out[..], 0);
  #assert s[0].sight_rem[0].memo.shown && s[0].plates[0].placed == 1;
  _ = e2_heads(s[..], out[..], 0); #assert !s[0].sight_rem[0].memo.shown && s[0].sight_rem[0].share < 0.7;
}
#test "a name over a head fades with distance and hides behind the land" {
  s: [1] E2; s[0].eye = [3] f32.[0, e2_height(0, 0) + 2, 0];
  #assert e2_sight_shows(s[..], 0, e2_height(0, -10), -10, 1.8);
  s[0].eye = [3] f32.[0, e2_height(0, 0) - 50, 0];
  #assert !e2_sight_shows(s[..], 0, e2_height(0, -10) - 50, -10, 1.8);
}
// A player key the API minted (POST /api/playtest/player): the host keeps it as this browser's player
// (host.js action 5) when no other action is waiting, and the seat ticket asks with it.
E2_ACT_PLAYER :: 5;
e2_keep_player :: (s: [] E2, record: string) #export_c #effects(all) {
  if record.count > 1024 { return; }
  for i: 0..<record.count { s[0].player_key[i] = record[i]; }
  s[0].player_key_n = record.count;
}

// ---- the class bar (#13058)
// The room takes your last cast: its e cast for your seat, at (ax, az), and the frame that plays it.
e2_test_taken :: (s: [] E2, slot: int, ax: f32, az: f32) {
  n := s[0].net[..];
  b: [128] u8; m := wire_put_cast_e(b[..], 0, WireCastE.{ss = n[0].seat, slot = slot, ax = ax, ay = 1, az = az, seed = 41});
  e2n_entry(n, cast(string) b[0..<m], WireD.{tick = 9});
  e2k_step(s);
}
e2_test_cast_state :: (s: [] E2, c: int) {
  s[0].placed = true; s[0].width = 1440; s[0].height = 900; s[0].k = 1; s[0].clock = 10;
  s[0].you_x = 0; s[0].you_z = -10; s[0].you_y = e2_height(0, -10); s[0].you_face = 3.14159265;   // facing -z
  s[0].right = [3] f32.[1, 0, 0];
  n := s[0].net[..]; n[0].state = E2N_OPEN; n[0].sock = 1; n[0].seat = 1;
  e2k_set_class(s[0].casts[..], c, 1); e2n_set_class(n, c, 1);
}
#test "Everglade II's bar holds your class's kit, its keys press it at what is ahead, it cools down, and it goes to the room (#13058)" #steps 1000000000 {
  s: [1] E2; e2_test_cast_state(s[..], FB_CL_WIZARD);
  k := s[0].casts[..];
  bar: [XC_SLOTS] FbAb; want := xk_bar(FB_CL_WIZARD, bar[..]);
  #assert k[0].bar_n == want && k[0].bar_n >= 2 && k[0].bar[0].name == bar[0].name;
  // the bar's pictures for the host, one a slot, and a press on its first
  out: [8192] f32;
  s[0].media_n = 0; _ := e2k_bar_draw(s[..], out[..], 0);
  lines := 1; for i: 0..<s[0].media_n { if s[0].media[i] == 10 { lines += 1; } }
  #assert s[0].media_n > 0 && lines == k[0].bar_n;
  b := e2k_box(k, 0, 1440, 900, 1);
  #assert e2k_slot_at(s[..], (b[0] + b[2]) / 2, (b[1] + b[3]) / 2) == 0 && e2k_slot_at(s[..], 10, 10) < 0;
  // Fire Bolt (the Wizard's first? find it): flies ahead, to its range
  fb := -1; for i: 0..<k[0].bar_n { if k[0].bar[i].kind == FB_SPELL && k[0].bar[i].sp == SP_FIRE_BOLT { fb = i; } }
  #assert fb >= 0 && fb < 9;
  #assert e2_key(s[..], '1' + fb, 0) && k[0].pressed == 1 && s[0].net[0].cast_sent == 1;
  // asked, sent, and played at once, before the room's word (#13157): the room's yes confirms it
  #assert fxp_live(k[0].puffs[..]) >= 1 && k[0].audio[0].played >= 1 && k[0].me[0].clip == figs.BD_SPELL && k[0].deeds[0].asked == fb && k[0].shown == 1 && k[0].deeds[0].accepted == 0;
  last := s[0].net[0].pipe[0].n - 1; p := s[0].net[0].pipe[0];
  cw := cast(string) p.buf[p.from[last]..<p.from[last] + p.len[last]];
  r: [1] WireRd; r[0] = wire_rd(cw, 1); wc := wire_read_cast(cw, r[..]);
  #assert cw[0] == 'C' && wc.slot == xk_slot(FB_CL_WIZARD, fb) && abs(wc.ax) < 0.05 && abs(wc.az - (-10 - 36.576)) < 0.05;
  played := k[0].audio[0].played;
  e2_test_taken(s[..], wc.slot, wc.ax, wc.az);
  #assert fxp_live(k[0].puffs[..]) >= 1 && k[0].audio[0].played == played && k[0].me[0].clip == figs.BD_SPELL && k[0].deeds[0].accepted == 1 && k[0].shown == 1;   // confirmed, not played twice
  // too soon: nothing, a second on too (its Action is the turn's: 1.5 s, cast-pace.coax); when the turn's beat is over, the next
  #assert e2_key(s[..], '1', 0) && k[0].pressed == 1;
  s[0].clock += 1.01; #assert e2_key(s[..], '1', 0) && k[0].pressed == 1;
  s[0].clock += 0.5; #assert e2_key(s[..], '1', 0) && k[0].pressed == 2;
  // the bolt fizzles where it ends: its sound a moment later
  heard := k[0].audio[0].played; s[0].clock += 1; e2k_step(s[..]); #assert k[0].audio[0].played > heard;
  // a key past the bar is left alone; in the studio the bar is away
  #assert !e2_key(s[..], '1' + k[0].bar_n, 0) || k[0].bar_n >= 9;
  s[0].cz[0].on = true; #assert !e2k_on(s[..]);
}
// Your own row in the room's mirror for a check: Hit Points, conditions and the saves' word.
e2_test_vitals :: (s: [] E2, hp: int, max: int, cond: int, word: int) {
  m := s[0].net[0].mir[..]; seat := s[0].net[0].seat;
  e := wire_mirror_find(m, seat); if e < 0 { e = 0; }
  m[0].ents[e].live = true; m[0].ents[e].id = seat; m[0].ents[e].n = 1; m[0].ents[e].at = 1; m[0].ents[e].tick[0] = 1;
  wire_s_pack(WireS.{id = seat, kind = WK_PLAYER, hp = hp, max = max, cond = cond, p2 = word}, m[0].ents[e].f[0..<WIRE_SF]);
}
#test "at 0 Hit Points you are down: what you were casting stops, no cast or draw starts, the body lies Prone and the line says the saves; healed, you get up" #steps 1000000000 {
  s: [1] E2; e2_test_cast_state(s[..], FB_CL_RANGER); k := s[0].casts[..]; n := s[0].net[..];
  e2_test_vitals(s[..], 20, 20, 0, 0);
  #assert e2k_press(s[..], 0);
  e2_test_taken(s[..], k[0].wire[0], 0, -12);   // the room took it: it plays
  #assert k[0].me[0].clip >= 0 && fxp_live(k[0].puffs[..]) + k[0].audio[0].played > 0;
  sent := n[0].cast_sent; pressed := k[0].pressed;
  // 0 Hit Points, Unconscious, one save made and two failed
  dying: RsCreature; dying.hp = 0; dying.death_ok = 1; dying.death_fail = 2;
  e2_test_vitals(s[..], 0, 20, RS_UNCONSCIOUS | RS_PRONE, rs_death_word(dying));
  e2k_lock_step(s[..]);
  #assert k[0].me[0].clip < 0 && k[0].stopped == 1;   // its pose gone
  s[0].clock += 5; played := k[0].audio[0].played; live := fxp_live(k[0].puffs[..]);
  for i: 0..<k[0].bar_n { #assert !e2k_press(s[..], i); }
  #assert !e2m_draw(s[..], false) && !s[0].mouse[0].draw[0].on;
  #assert n[0].cast_sent == sent && k[0].pressed == pressed && k[0].audio[0].played == played && fxp_live(k[0].puffs[..]) <= live && k[0].me[0].clip < 0;
  a: [1] figs.BdAnim; e2_fall(a[..], e2k_bearing(s[..]), s[0].clock); #assert a[0].state == 1;
  row := e2n_vitals(n); line: [64] u8; ln := rs_death_line(rs_death_saves(row.hp, false, row.p2), line[..]);
  #assert cast(string) line[0..<ln] == "You are down · death saves: 1 saved, 2 failed";
  out: [8192] f32; #assert e2k_down_line(s[..], out[..], 0) > 0;
  // healed: up, and the bar is yours again
  e2_test_vitals(s[..], 4, 20, RS_PRONE, 0); e2k_lock_step(s[..]);
  e2_fall(a[..], e2k_bearing(s[..]), s[0].clock); #assert a[0].state == 0 && e2k_press(s[..], 0) && n[0].cast_sent == sent + 1;
}
#test "e2 mouse: every draw of the Longbow looses an arrow, and when the rules wouldn't allow it no draw starts" #steps 1000000000 {
  s: [1] E2; e2_test_cast_state(s[..], FB_CL_RANGER); k := s[0].casts[..]; m := s[0].mouse[..]; n := s[0].net[..];
  e2_test_vitals(s[..], 20, 20, 0, 0);
  // held and let go at many timings, some during the cooldown, some after another slot's press
  holds := [8] f32.[0.9, 0.2, 1.4, 0.05, 0.8, 2.0, 0.4, 1.1];
  for q: 0..<24 {
    draws := m[0].draws; arrows := n[0].cast_sent;
    if q % 5 == 3 { _ := e2k_press(s[..], (e2m_attack(k) + 1) % k[0].bar_n); arrows = n[0].cast_sent; }
    pressed := e2m_buttons(s[..], 0, 0, 2);
    drew := m[0].draw[0].on;
    s[0].clock += holds[q % 8]; e2m_step(s[..], holds[q % 8]);
    released := e2m_buttons(s[..], 2, 0, 2);
    shot := n[0].cast_sent - arrows;
    #assert (drew && m[0].draws == draws + 1 && shot == 1) || (!drew && m[0].draws == draws && shot == 0);
    s[0].clock += 0.15 * f32(q % 4);
  }
  #assert m[0].looses > 4 && m[0].draws == m[0].looses;
  // down: no draw at all
  e2_test_vitals(s[..], 0, 20, RS_UNCONSCIOUS | RS_PRONE, 0); s[0].clock += 3;
  draws := m[0].draws; _ := e2m_buttons(s[..], 0, 0, 2); #assert !m[0].draw[0].on && m[0].draws == draws;
}
#test "a Ranger carries the Longbow on the body from the start, and every other Ranger is drawn with one" #steps 1000000000 {
  s: [1] E2; e2_test_cast_state(s[..], FB_CL_RANGER);
  #assert e2_kit_of(s[0].casts[0].klass) == XC_KIT_BOW && e2_kit_of(FB_CL_WIZARD) < 0 && e2_kit_of(FB_CL_FIGHTER) < 0;
  body: [24] f32;
  h: [1] cc.HeldPieces; cc.held_pieces(h[..], XC_KIT_BOW, false, 0, false, s[0].bodies[..], body[..]);
  #assert h[0].n >= 2 && h[0].mesh[0] == cc.CC_KIT_MESH[XC_KIT_BOW];   // the bow, and its string
  // the kit's meshes loaded: your body's records carry them, at rest and drawn
  for i: 0..<h[0].n { s[0].creator[0].weapon_count[h[0].mesh[i]] = 1; }
  d := e2_my_held(s[..], E2Drawn.{rec = 1}, 0); #assert d.rec >= 1 + h[0].n;
  s[0].mouse[0].draw[0].on = true; drawn := e2_my_held(s[..], E2Drawn.{rec = 1}, 0); #assert drawn.rec >= d.rec;
}
#test "a blow of the room's at you shows one red number over your head, the Hit Points it took; a critical hit larger; a miss says miss" #steps 1000000000 {
  s: [1] E2; e2_test_cast_state(s[..], FB_CL_RANGER); n := s[0].net[..]; n[0].seat = 0; n[0].hz = 30; n[0].worlds = 1;
  e2n_record(n, "D 0 0 0 1 e guard 0 2 0 7"); n[0].rt = 1000000; e2gd_hits(s[..]);
  shown := 0; at := -1; for q: 0..<fl.FLOATS { if s[0].floats[0].items[q].on { shown += 1; at = q; } }
  #assert shown == 1 && fl.floats_text(s[0].floats[..], at) == "-7" && s[0].floats[0].items[at].kind == fl.FLOAT_TAKEN;
  #assert abs(s[0].floats[0].items[at].x - s[0].you_x) < 0.01 && s[0].floats[0].items[at].y > s[0].you_y + 1.5;
  e2n_record(n, "D 0 0 0 2 e guard 0 4 0 19"); e2n_record(n, "D 0 0 0 3 e guard 0 2 0 0"); e2gd_hits(s[..]);
  crit := false; miss := false;
  for q: 0..<fl.FLOATS { it2 := s[0].floats[0].items[q]; if it2.on && it2.crit && fl.floats_text(s[0].floats[..], q) == "-19" { crit = true; } if it2.on && it2.kind == fl.FLOAT_MISS { miss = true; } }
  #assert crit && miss;
}
#test "Entangle aims on the ground: its square follows the crosshair, held to 90 feet, and the cast lands where it showed" #steps 1000000000 {
  s: [1] E2; e2_test_cast_state(s[..], FB_CL_DRUID);
  k := s[0].casts[..];
  en := -1; for i: 0..<k[0].bar_n { if k[0].bar[i].kind == FB_SPELL && k[0].bar[i].sp == SP_ENTANGLE { en = i; } }
  #assert en >= 0 && en < 9;
  // looking up over the hill ahead (the glade's 11 m rise 24 m down the path, everglade/world/forest.coax
  // e2_height): the crosshair meets no ground, so the square stops at 90 feet along the line
  s[0].eye = [3] f32.[0, s[0].you_y + 2, -10]; l := sqrt(1.25f32); s[0].fwd = [3] f32.[0, 0.5f32 / l, -1.0f32 / l]; s[0].up = [3] f32.[0, 1, 0];
  sent := s[0].net[0].cast_sent;
  #assert e2_key(s[..], '1' + en, 0) && k[0].area[0].on && k[0].pressed == 0 && s[0].net[0].cast_sent == sent;   // armed, not cast
  a := k[0].area[0];
  dx := a.x - s[0].you_x; dz := a.z - s[0].you_z;
  #assert a.far && a.shape == aa.AREA_SQUARE;
  #assert abs(sqrt(dx * dx + dz * dz) - 90 * f32(XC_FT)) < 0.01;   // held at 90 feet
  #assert abs(a.half - 10 * f32(XC_FT)) < 0.01;                     // a 20-foot square
  s[0].focal = 800; out: [16384] f32; #assert e2k_area_marks(s[..], out[..], 0) > 0;   // its outline drawn
  // nearer: it follows the crosshair onto the ground in range
  l = sqrt(1.09f32); s[0].fwd = [3] f32.[0, -0.3f32 / l, -1.0f32 / l]; e2k_area_step(s[..]);
  // looking down onto the ground within range: the square sits where the crosshair meets the ground,
  // not far and not held
  a = k[0].area[0]; dz = a.z - s[0].you_z; #assert !a.far && dz < -3 && dz > -12;
  hit := e2k_crosshair_ground(s[..]); #assert abs(a.x - hit[0]) < 0.001 && abs(a.z - hit[1]) < 0.001;
  #assert abs(e2_height(hit[0], hit[1]) - (s[0].eye[1] + s[0].fwd[1] * abs(hit[1] - s[0].eye[2]) / abs(s[0].fwd[2]))) < 0.3;   // on the ground there
  // a left click casts it there: the room is sent that point
  #assert e2_pointer_buttons(s[..], 700, 450, 0, 0, 1, 0) && !k[0].area[0].on && k[0].pressed == 1 && s[0].net[0].cast_sent == sent + 1;
  last := s[0].net[0].pipe[0].n - 1; p := s[0].net[0].pipe[0];
  cw := cast(string) p.buf[p.from[last]..<p.from[last] + p.len[last]];
  r: [1] WireRd; r[0] = wire_rd(cw, 1); wc := wire_read_cast(cw, r[..]);
  #assert abs(wc.ax - a.x) < 0.01 && abs(wc.az - a.z) < 0.01 && k[0].aimed_x == a.x && k[0].aimed_z == a.z;
  // armed again, Esc lets it go: nothing cast
  s[0].clock += 2; #assert e2_key(s[..], '1' + en, 0) && k[0].area[0].on && e2_key(s[..], -1, 0) && !k[0].area[0].on && k[0].pressed == 1 && !s[0].cz[0].menu;
}
#test "Thunderwave shows its cube ahead of you before and after you cast it, and lights who stands in it (#13081)" #steps 1000000000 {
  s: [1] E2; e2_test_cast_state(s[..], FB_CL_DRUID);
  k := s[0].casts[..];
  tw := -1; for i: 0..<k[0].bar_n { if k[0].bar[i].kind == FB_SPELL && k[0].bar[i].sp == SP_THUNDERWAVE { tw = i; } }
  #assert tw >= 0 && !xk_area_placed(k[0].bar[tw]);
  #assert !e2k_area_seen(s[..]).on;
  // the pointer over its slot: its 15-foot cube from you, the way you face
  k[0].hover = tw; a := e2k_area_seen(s[..]);
  #assert a.on && a.shape == aa.AREA_BOX && a.x == s[0].you_x && a.z == s[0].you_z;
  fx := sin(e2_show_face(s[..])); fz := cos(e2_show_face(s[..]));
  #assert e2k_area_holds(s[..], s[0].you_x + fx * 3, s[0].you_z + fz * 3) && !e2k_area_holds(s[..], s[0].you_x - fx * 3, s[0].you_z - fz * 3);
  s[0].eye = [3] f32.[s[0].you_x - fx * 6, s[0].you_y + 4, s[0].you_z - fz * 6]; s[0].fwd = [3] f32.[fx * 0.8f32, -0.6, fz * 0.8f32];
  s[0].right = [3] f32.[fz, 0, -fx]; s[0].up = [3] f32.[0, 1, 0]; s[0].focal = 800;
  out: [32768] f32; #assert e2k_area_marks(s[..], out[..], 0) > 0;
  // cast: it stays where it opened for a moment, then goes
  k[0].hover = -1; k[0].opened = aa.area_face(xk_spell_area(SP_THUNDERWAVE), 0, 0, 0); k[0].opened.until = s[0].clock + 1.4; k[0].opened_sp = SP_THUNDERWAVE;
  #assert e2k_area_seen(s[..]).on && e2k_area_holds(s[..], 0, 3);
  s[0].clock += 2; #assert !e2k_area_seen(s[..]).on && !e2k_area_holds(s[..], 0, 3);
}
#test "another's e cast plays when the picture reaches its tick, at it as drawn: a blow swings and sounds there (#13058)" #steps 1000000000 {
  s: [1] E2; e2_test_cast_state(s[..], FB_CL_WIZARD);
  n := s[0].net[..]; n[0].mono = 1000;
  // seat 3, a Fighter, stands 4 m ahead of you
  for i: 0..<12 {
    q := e2n_ent(n, 3, true); en := n[0].ents[q..<q + 1]; en[0].kind = WK_PLAYER; en[0].seat = 3; en[0].seen = i;
    net_push(en, NetState.{t = 1000 + i * 33, x = 0, z = -14});
  }
  e2n_step(n, 1300);
  #assert e2n_remote_seat(n, 3).ok;
  fbar: [XC_SLOTS] FbAb; fn := xk_bar(FB_CL_FIGHTER, fbar[..]); fi := -1;
  for i: 0..<fn { if fbar[i].kind == FB_ATTACK && fi < 0 { fi = i; } }
  sword := xk_slot(FB_CL_FIGHTER, fi);
  #assert xk_entry(FB_CL_FIGHTER, sword).aim.kind == XC_AIM_MELEE;
  n[0].tick_t = n[0].rt + 500;   // a tick the picture hasn't reached
  b: [128] u8; m := wire_put_cast_e(b[..], 0, WireCastE.{ss = 3, slot = sword, ax = 0, ay = 1, az = -16, seed = 77});
  e2n_entry(n, cast(string) b[0..<m], WireD.{tick = 9});
  k := s[0].casts[..];
  e2k_step(s[..]); #assert k[0].others == 0 && n[0].cast_heard == 1;
  n[0].casts[0].t = n[0].rt;     // now it has
  heard := k[0].audio[0].played;
  e2k_step(s[..]);
  r := e2n_remote_seat(n, 3);
  #assert k[0].others == 1 && k[0].them[r.slot].clip == figs.BD_SLASH && abs(k[0].them[r.slot].at - s[0].clock) < 0.001;
  #assert fxp_live(k[0].puffs[..]) >= 1 && k[0].puffs[0].out_n > 0 && k[0].audio[0].played > heard;
  // its body swings over its gait, eased in
  g: figs.BdAnim; g.clip = figs.BD_IDLE;
  a := e2k_figure(g, k[0].them[r.slot], s[0].clock + 0.3); #assert a.clip == figs.BD_SLASH && a.prev == figs.BD_IDLE;
  #assert e2k_figure(g, k[0].them[r.slot], s[0].clock + 5).clip == figs.BD_IDLE;
}

#test "Everglade II greys a refused cast's slot, with no words over the bar, and the grey fades (#13072)" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_WIZARD);
  n:=s[0].net[..]; n[0].mono=100; k:=s[0].casts[..];
  #assert e2k_press(s[..],0);
  out:[8192] f32;
  message:[64] u8; count:=wire_put(message[..],0,"r "); count=wire_int(message[..],count,n[0].cast_seq); count=wire_put(message[..],count," no");
  e2n_record(n,cast(string)message[0..<count]); e2k_step(s[..]);
  #assert k[0].deeds[0].refused==1 && deed_look(k[0].deeds[0],0,deed_tick(s[0].clock),0).grey==1 && k[0].rolled==1 && k[0].me[0].clip<0;   // what it showed is taken back (#13157)
  // the slot's picture again, dimmed over it: a grey veil, and no words
  s[0].media_n=0; _:=e2k_bar_draw(s[..],out[..],0);
  media:=cast(string)s[0].media[0..<s[0].media_n]; veil:=false;
  for i:0..<media.count-9 { if media[i..<i+10]==" 35 0 1000" { veil=true; } }
  #assert veil;
  s[0].clock+=1; #assert deed_look(k[0].deeds[0],0,deed_tick(s[0].clock),0).grey==0;
}

#test "Everglade II at 0 Hit Points: the bar greys, a press sends nothing, the bow doesn't draw (#13072)" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_RANGER); n:=s[0].net[..]; k:=s[0].casts[..];
  row:[WIRE_SF] s32; zero:[WIRE_SF] s32; frame:[1024] u8;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=0,max=12},row[..]); count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1});
  count=wire_put_s(frame[..],count,1,0,zero[..],row[..]); e2n_record(n,cast(string)frame[0..<count]);
  b:=e2k_bearing(s[..]); #assert b.pose==DeedPose.down && !deed_can_act(b) && !deed_can_move(b);
  sent:=n[0].cast_sent;
  #assert !e2k_press(s[..],0) && n[0].cast_sent==sent && k[0].deeds[0].last==DeedVerdict.locked;
  #assert !e2m_draw(s[..],false) && !s[0].mouse[0].draw[0].on && k[0].audio[0].played==0;
  #assert deed_bar_dim(b)==1;
}

#test "Everglade II lifts the cooldown it predicted for a cast the room refused; an older cast's refusal changes nothing (#13046)" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_WIZARD); n:=s[0].net[..]; n[0].mono=100; k:=s[0].casts[..];
  #assert e2k_press(s[..],0); first:=n[0].cast_seq; sent:=n[0].cast_sent;
  #assert !e2k_press(s[..],0) && n[0].cast_sent==sent;   // predicted: cooling down
  message:[64] u8; count:=wire_put(message[..],0,"r "); count=wire_int(message[..],count,first-1); count=wire_put(message[..],count," no");
  e2n_record(n,cast(string)message[0..<count]); e2k_step(s[..]); #assert !e2k_press(s[..],0) && k[0].deeds[0].asked==0;   // not your last cast's number
  count=wire_put(message[..],0,"r "); count=wire_int(message[..],count,first); count=wire_put(message[..],count," range");
  e2n_record(n,cast(string)message[0..<count]); e2k_step(s[..]);
  #assert e2k_press(s[..],0) && n[0].cast_sent==sent+1 && n[0].cast_seq!=first;
  // the new cast cools down again, and reconciling once more changes nothing
  e2k_step(s[..]); #assert !e2k_press(s[..],0) && s[0].casts[0].refused_seen==n[0].cast_refused;
}

#test "Everglade II takes back a refused cast: what it showed fades out, its fizzle never plays, and a late word changes nothing (#13072, #13157)" #steps 2000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_WIZARD); n:=s[0].net[..]; n[0].mono=100;
  k:=s[0].casts[..];
  fb:=-1; for i:0..<k[0].bar_n { if k[0].bar[i].kind==FB_SPELL && k[0].bar[i].sp==SP_FIRE_BOLT { fb=i; } }
  #assert fb>=0 && e2k_press(s[..],fb);
  message:[64] u8; count:=wire_put(message[..],0,"r "); count=wire_int(message[..],count,n[0].cast_seq); count=wire_put(message[..],count," no");
  e2n_record(n,cast(string)message[0..<count]);
  #assert k[0].shown==1 && k[0].audio[0].played>=1;   // it played at once
  for f:0..<60 { s[0].clock+=1.0f32/60; e2k_step(s[..]); }
  #assert fxp_live(k[0].puffs[..])==0 && k[0].me[0].clip<0 && k[0].rolled==1 && k[0].undone==1;
  for i:0..<E2K_LATER { #assert !k[0].later[i].on; }
  // the room's word for it, if it came late, plays nothing either
  e2_test_taken(s[..],k[0].wire[fb],0,-40); #assert fxp_live(k[0].puffs[..])==0 && k[0].deeds[0].stale==1;
}

#test "Everglade II's unanswered cast is taken back after 1.5 s, and the room's late yes plays it after all (#13072, #13157)" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_WIZARD); k:=s[0].casts[..];
  #assert e2k_press(s[..],0) && k[0].shown==1;
  s[0].clock+=1.6; e2k_step(s[..]);
  #assert k[0].deeds[0].expired==1 && deed_look(k[0].deeds[0],0,deed_tick(s[0].clock),0).grey==1 && k[0].rolled==1 && k[0].me[0].clip<0;
  e2_test_taken(s[..],k[0].wire[0],0,-12); #assert k[0].shown==2 && k[0].me[0].clip>=0 && !k[0].ask.rolled;
  e2_test_taken(s[..],k[0].wire[0],0,-12); #assert k[0].shown==2;   // once
}

#test "Everglade II's bar is your class's at your level: a level 5 Fighter's Action Surge goes by its own wire slot (#13046)" #steps 2000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_FIGHTER);
  k:=s[0].casts[..]; n:=s[0].net[..];
  e2k_set_class(k,FB_CL_FIGHTER,5); e2n_set_class(n,FB_CL_FIGHTER,5);
  want:[XC_SLOTS] FbAb; wn:=xk_bar_at(FB_CL_FIGHTER,5,want[..]);
  #assert k[0].level==5 && k[0].bar_n==wn && wn>xk_bar(FB_CL_FIGHTER,want[..]);
  surge:=-1; for i:0..<k[0].bar_n { if k[0].bar[i].kind==FB_SURGE { surge=i; } }
  #assert surge>=0 && e2k_press(s[..],surge);
  last:=n[0].pipe[0].n-1; p:=n[0].pipe[0]; cw:=cast(string)p.buf[p.from[last]..<p.from[last]+p.len[last]];
  r:[1] WireRd; r[0]=wire_rd(cw,1); wc:=wire_read_cast(cw,r[..]);
  #assert wc.slot==xk_wire(FB_CL_FIGHTER,k[0].bar[surge]) && xk_entry_at(FB_CL_FIGHTER,5,wc.slot).ab.kind==FB_SURGE && !xk_entry_at(FB_CL_FIGHTER,1,wc.slot).ok;
  // the hello says the level
  n[0].pipe[0].n=0; n[0].pipe[0].used=0; e2n_hello(n);
  pipe:=cast(string)n[0].pipe[0].buf[0..<n[0].pipe[0].used];
  has:=false; for i:0..<pipe.count-13 { if pipe[i..<i+13]=="srd-fighter-5" { has=true; } } #assert has;
}

#test "Everglade II draws the room's counts on the bar's icons and frames a Rage while it holds (#13046)" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_BARBARIAN);
  k:=s[0].casts[..]; n:=s[0].net[..];
  out:[8192] f32; plain:=e2k_bar_draw(s[..],out[..],0);
  // Rage (slot 1): 1 left, raging; the rest nothing to count
  m:[128] u8; c:=wire_put(m[..],0,"b"); c=wire_int(m[..],c,k[0].bar_n);
  for i:0..<k[0].bar_n { c=wire_int(m[..],c,ifx i==0 then wire_kit_v(1,true) else wire_kit_v(-1,false)); }
  e2n_record(n,cast(string)m[0..<c]);
  #assert e2n_slot(n,0,k[0].bar_n).ok && e2n_slot(n,0,k[0].bar_n).left==1 && e2n_slot(n,0,k[0].bar_n).on;
  drawn:=e2k_bar_draw(s[..],out[..],0); #assert drawn>plain+4*6;   // a count and four frame lines
  // no longer raging, none left: the count only
  c=wire_put(m[..],0,"b"); c=wire_int(m[..],c,k[0].bar_n);
  for i:0..<k[0].bar_n { c=wire_int(m[..],c,ifx i==0 then wire_kit_v(0,false) else wire_kit_v(-1,false)); }
  e2n_record(n,cast(string)m[0..<c]);
  calm:=e2k_bar_draw(s[..],out[..],0); #assert calm>plain && calm<drawn;
}

#test "Everglade II health label uses its server row including temporary HP and snapshot removal" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_WIZARD);
  n:=s[0].net[..]; label:[80] u8;
  #assert e2k_vitals_text(s[..],label[..])==0;
  geometry:[8192] f32; plain:=e2k_bar_draw(s[..],geometry[..],0);
  frame:[1024] u8; row:[WIRE_SF] s32; zero:[WIRE_SF] s32;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=3,max=8,temp=7},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1});
  count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  count=e2k_vitals_text(s[..],label[..]); #assert cast(string)label[0..<count]=="HP 3/8 · TEMP 7";
  #assert e2k_bar_draw(s[..],geometry[..],0)==plain;   // your health is on the portrait plate; nothing is added over the bar
  newer:[WIRE_SF] s32; wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=6,max=8},newer[..]);
  count=wire_put_d(frame[..],0,WireD.{tick=2}); count=wire_put_s(frame[..],count,1,1,row[..],newer[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  count=e2k_vitals_text(s[..],label[..]); #assert cast(string)label[0..<count]=="HP 6/8";
  count=wire_put_d(frame[..],0,WireD.{tick=3,f=1}); e2n_record(n,cast(string)frame[0..<count]);
  #assert e2k_vitals_text(s[..],label[..])==0;
  #assert e2k_bar_draw(s[..],geometry[..],0)==plain;
}

#test "Everglade II health ignores peers and invalid rows and distinguishes unconscious from dead" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_WIZARD); n:=s[0].net[..];
  label:[80] u8; frame:[1024] u8; row:[WIRE_SF] s32; zero:[WIRE_SF] s32;
  for pass:0..<8 {
    w:=WireS.{id=1,kind=WK_PLAYER,hp=0,max=8};
    if pass==1 { w.g=WG_DEAD; }
    if pass==2 { w.id=2; }
    if pass==3 { w.max=0; }
    if pass==4 { w.hp=9; }
    if pass==5 { w.hp=-1; }
    if pass==6 { w.temp=-1; }
    if pass==7 { w.kind=WK_BEAST; }
    wire_s_pack(w,row[..]); count:=wire_put_d(frame[..],0,WireD.{tick=pass+1,f=1});
    count=wire_put_s(frame[..],count,w.id,0,zero[..],row[..]); e2n_record(n,cast(string)frame[0..<count]);
    count=e2k_vitals_text(s[..],label[..]);
    if pass==0 { #assert cast(string)label[0..<count]=="HP 0/8 · UNCONSCIOUS"; }
    else if pass==1 { #assert cast(string)label[0..<count]=="HP 0/8 · DEAD"; }
    else { #assert count==0; }
  }
  e2n_down(n); #assert e2k_vitals_text(s[..],label[..])==0;
}

#test "Everglade II health names the conditions and spell effects the room's row holds, once each (#13046)" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_CLERIC); n:=s[0].net[..];
  label:[E2K_HEALTH] u8; frame:[1024] u8; row:[WIRE_SF] s32; zero:[WIRE_SF] s32; tick:=1;
  for pass:0..<5 {
    w:=WireS.{id=1,kind=WK_PLAYER,hp=5,max=12};
    if pass==1 { w.cond=RS_PRONE|RS_POISONED|WC_BLESSED; }
    if pass==2 { w.cond=RS_UNCONSCIOUS|RS_EXHAUSTION; w.hp=0; }
    if pass==3 { w.cond=RS_UNCONSCIOUS; }
    if pass==4 { w.cond=RS_BLINDED|RS_CHARMED|RS_DEAFENED|RS_EXHAUSTION|RS_FRIGHTENED|RS_GRAPPLED|RS_INCAPACITATED|RS_INVISIBLE|RS_PARALYZED|RS_PETRIFIED|RS_POISONED|RS_PRONE|RS_RESTRAINED|RS_STUNNED|WC_HALTED|WC_SLOWED|WC_BOUND|WC_BANED|WC_ENFEEBLED|WC_HEXED|WC_BLESSED|WC_FAITH; }
    wire_s_pack(w,row[..]); count:=wire_put_d(frame[..],0,WireD.{tick=tick,f=1}); tick+=1;
    count=wire_put_s(frame[..],count,1,0,zero[..],row[..]); e2n_record(n,cast(string)frame[0..<count]);
    count=e2k_vitals_text(s[..],label[..]); t:=cast(string)label[0..<count];
    if pass==0 { #assert t=="HP 5/12"; }
    if pass==1 { #assert t=="HP 5/12 · POISONED · PRONE · BLESSED"; }
    if pass==2 { #assert t=="HP 0/12 · UNCONSCIOUS · EXHAUSTION"; }
    if pass==3 {
      #assert t=="HP 5/12 · UNCONSCIOUS";
      // asleep, as the room's rest says: Unconscious once, as ASLEEP
      e2n_record(n,"z 0 3 1"); count=e2k_vitals_text(s[..],label[..]); #assert cast(string)label[0..<count]=="HP 5/12 · ASLEEP";
      e2n_record(n,"z 0 0 1");
    }
    if pass==4 { #assert t=="HP 5/12 · BLINDED · CHARMED · DEAFENED · EXHAUSTION · FRIGHTENED · GRAPPLED · INCAPACITATED · INVISIBLE · PARALYZED · PETRIFIED · POISONED · PRONE · RESTRAINED · STUNNED · HALTED · SLOWED · EARTHBOUND · BANED · ENFEEBLED · HEXED · BLESSED · SHIELD OF FAITH" && count<E2K_HEALTH; }
  }
}

// For the checks: open the companion's menu if it is shut, then press action a's row in it.
e2k_tap_pet :: (s: [] E2, a: int) -> bool {
  if !e2k_side_open(s, EG_SIDE_PET) { return false; }
  r := e2k_menu_centre(s, EG_SIDE_PET, a); return r[0] > 0 && e2_pointer(s, r[0], r[1], 0, 0, 1);
}
#test "Everglade II class menus: kit, companion and rest are no buttons over the bar; your portrait opens them, and every menu hangs under it on the page, at any width" #steps 2000000000 {
  s:[1]E2; e2_test_cast_state(s[..],FB_CL_DRUID);
  n:=s[0].net[..]; n[0].mono=100;
  e2k_set_class(s[0].casts[..],FB_CL_DRUID,2); e2n_set_class(n,FB_CL_DRUID,2);
  frame:[1024]u8; row:[WIRE_SF]s32; zero:[WIRE_SF]s32;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=21,max=21},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1}); count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]); e2n_record(n,"z 0 0 1"); n[0].aid_left=9;
  sizes:=[6]f32.[1920,1080, 390,844, 844,390];
  for q:0..<3 {
    s[0].width=sizes[q*2]; s[0].height=sizes[q*2+1];
    ids:[3]int; c:=e2k_side(s[..],ids[..]); #assert c==3;
    b0:=e2k_box(s[0].casts[..],0,s[0].width,s[0].height,s[0].k); g:=e2k_side_geo(s[..]);
    // your portrait is what opens them: on the page, well over the bar, and no slot under it
    #assert g.anchor.x0>=0 && g.anchor.x1<=s[0].width && g.anchor.y1<b0[1]-30 && e2k_slot_at(s[..],(g.anchor.x0+g.anchor.x1)*0.5,(g.anchor.y0+g.anchor.y1)*0.5)<0;
    #assert eg_side_first(g)==EG_SIDE_ROOT && (q==0 || e2k_side_h(s[..])>=44);
    // the portrait's own menu and each item's: on the page, over the bar, rows inside and apart
    menus:=[3]int.[EG_SIDE_ROOT,EG_SIDE_PET,EG_SIDE_REST];
    for id:menus { rows:[EG_MENU_ROWS]int; m:=e2k_menu_rows(s[..],id,rows[..]); p:=e2k_menu_panel(s[..],id);
      #assert m>0 && p[0]>=8 && p[2]<=s[0].width-8 && p[1]>=0 && p[3]<=b0[1];
      for r:0..<m { a:=e2k_menu_box(s[..],id,r); #assert a[0]>=p[0] && a[2]<=p[2] && a[1]>=p[1] && a[3]<=p[3];
        for r2:0..<r { z:=e2k_menu_box(s[..],id,r2); #assert a[2]<=z[0] || z[2]<=a[0] || a[3]<=z[1] || z[3]<=a[1]; } } }
  }
  // the companion's row says its form in words, not a code
  b:[48]u8; c:=eg_side_label(e2k_facts(s[..]),EG_SIDE_PET,b[..]); #assert cast(string)b[0..<c]=="WILD COMPANION · CAT";
  c=eg_menu_label(e2k_facts(s[..]),EG_DO_PAY,b[..]); #assert cast(string)b[0..<c]=="PAY: WILD SHAPE";
  // shut, the menus draw nothing; your portrait opens its own menu, a row the companion's; a press
  // elsewhere shuts an open menu
  out:[32768*16]f32; nt:[] cc.UitTrace; shut:=e2k_bar_draw(s[..],out[..],0);
  #assert eg_side_draw(nt,e2k_facts(s[..]),e2k_side_geo(s[..]),e2k_side_st(s[..]),out[..],0)==0;
  pc:=e2k_side_centre(s[..],EG_SIDE_PET); #assert e2_pointer(s[..],pc[0],pc[1],0,0,1) && s[0].casts[0].menu==EG_SIDE_ROOT;
  #assert e2k_bar_draw(s[..],out[..],0)>shut;
  #assert e2k_side_open(s[..],EG_SIDE_PET) && s[0].casts[0].menu==EG_SIDE_PET;
  #assert e2k_bar_draw(s[..],out[..],0)>shut;
  // a press outside the menu (a short page's menu grows up toward the top, so the corner)
  #assert e2_pointer(s[..],2,2,0,0,1) && s[0].casts[0].menu== -1;
}
#test "Everglade II rest controls follow the room's rest: a click asks it, sleep holds the keys, and the label says it (#13046)" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_FIGHTER); n:=s[0].net[..]; n[0].mono=100;
  label:[80] u8; frame:[1024] u8; row:[WIRE_SF] s32; zero:[WIRE_SF] s32; reqs:[4] int;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=5,max=12},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1}); count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  // until the room says your rest: no controls
  #assert e2k_rest_choices(s[..],reqs[..])==0;
  geometry:[8192] f32; plain:=e2k_bar_draw(s[..],geometry[..],0);
  e2n_record(n,"z 0 0 1");
  #assert e2k_rest_choices(s[..],reqs[..])==2 && reqs[0]==RS_REST_SHORT && reqs[1]==RS_REST_SLEEP && e2k_rest_label(s[..],reqs[1])=="LONG REST";
  #assert e2k_bar_draw(s[..],geometry[..],0)==plain;   // nothing new over the bar: the choices wait in the menu your portrait opens
  // REST is in the menus your portrait opens, well over the bar and apart from the slots; its menu hangs under the portrait
  b0:=e2k_box(s[0].casts[..],0,s[0].width,s[0].height,s[0].k); rb:=e2k_side_centre(s[..],EG_SIDE_REST);
  #assert rb[1]<b0[1]-40 && rb[0]>0 && rb[0]<s[0].width && e2k_slot_at(s[..],rb[0],rb[1])<0;
  #assert e2_probe(s[..],132)==cast(int)rb[0] && e2_probe(s[..],133)==cast(int)rb[1] && e2_probe(s[..],134)== -1;
  #assert e2k_side_open(s[..],EG_SIDE_REST) && s[0].casts[0].menu==EG_SIDE_REST && e2_probe(s[..],134)==EG_SIDE_REST;
  a:=e2k_menu_centre(s[..],EG_SIDE_REST,EG_DO_REST); z:=e2k_menu_centre(s[..],EG_SIDE_REST,EG_DO_REST+1);
  #assert a[1]>rb[1] && a[1]<z[1] && a[1]<b0[1] && a[0]>=0 && e2k_slot_at(s[..],a[0],a[1])<0;
  // the probes a browser check presses them by
  #assert e2_probe(s[..],30)==WIRE_REST_NONE && e2_probe(s[..],31)==2 && e2_probe(s[..],32)==RS_REST_SHORT && e2_probe(s[..],33)==RS_REST_SLEEP;
  #assert e2_probe(s[..],34)==cast(int)a[0] && e2_probe(s[..],35)==cast(int)a[1] && e2_probe(s[..],36)==cast(int)z[0] && e2_probe(s[..],37)==cast(int)z[1];
  #assert e2_probe(s[..],38)==cast(int)(s[0].you_x*100) && e2_probe(s[..],39)==0;
  sent:=n[0].pipe[0].n;
  #assert e2_pointer(s[..],z[0],z[1],0,0,1) && n[0].pipe[0].n==sent+1 && s[0].casts[0].pressed==0 && s[0].casts[0].menu== -1;
  p:=n[0].pipe[0]; last:=p.n-1; ask:=cast(string)p.buf[p.from[last]..<p.from[last]+p.len[last]];
  r:[1] WireRd; r[0]=wire_rd(ask,1); w:=wire_read_rest_ask(ask,r[..]); #assert ask[0]=='Z' && w.req==RS_REST_SLEEP && w.seq==n[0].rest_seq;
  // the room's answer: asleep; your keys move nothing, and the label says so
  m:[64] u8; c:=wire_put_rest_state(m[..],0,WireRestState.{seq=w.seq,code=WIRE_REST_SLEEP,dice=1}); e2n_record(n,cast(string)m[0..<c]);
  s[0].held=HOLD_W; mv:=e2_move_in(s[..]); #assert mv.key_y==0 && mv.key_x==0 && !mv.jump; s[0].held=0;
  count=e2k_vitals_text(s[..],label[..]); #assert cast(string)label[0..<count]=="HP 5/12 · ASLEEP";
  #assert e2k_rest_choices(s[..],reqs[..])==2 && reqs[0]==RS_REST_WATCH && reqs[1]==RS_REST_END;
  // a refusal shows briefly over the bar in the cast feedback's place
  #assert e2n_rest(n,RS_REST_WATCH); c=wire_put_refused(m[..],0,n[0].rest_seq,"rest"); e2n_record(n,cast(string)m[0..<c]);
  #assert e2n_rest_message(n).count>0 && e2_probe(s[..],39)==1;
  e2n_record(n,"z 0 2 1"); #assert e2k_rest_choices(s[..],reqs[..])==2 && reqs[0]==RS_REST_DIE;
  count=e2k_vitals_text(s[..],label[..]); #assert cast(string)label[0..<count]=="HP 5/12 · HIT DICE 1";
  e2n_down(n); #assert e2k_rest_choices(s[..],reqs[..])==0 && e2_probe(s[..],30)== -1 && e2_probe(s[..],31)==0 && e2_probe(s[..],32)== -1 && e2_probe(s[..],34)== -1;
}

#test "Everglade II Healer's Kit control asks the room and displays the room's result" #steps 1000000000 {
  s:[1] E2; e2_test_cast_state(s[..],FB_CL_FIGHTER);
  n:=s[0].net[..]; n[0].mono=100;
  frame:[1024]u8; row:[WIRE_SF]s32; zero:[WIRE_SF]s32;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=5,max=12},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1});
  count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  sent:=n[0].pipe[0].n;
  #assert e2k_side_open(s[..],EG_SIDE_KIT);   // your portrait, then the kit's row in its menu
  #assert n[0].pipe[0].n==sent+1 && n[0].aid_left==-1;
  p:=n[0].pipe[0]; last:=p.n-1;
  #assert cast(string)p.buf[p.from[last]..<p.from[last]+p.len[last]]=="E 3000001 15 0";
  e2n_record(n,"D 2 0 4 0 e kit 3000000 8"); #assert n[0].aid_left==-1;
  e2n_record(n,"D 2 0 4 0 e kit 3000001 9"); #assert n[0].aid_left==9 && e2n_aid_message(n)=="ALLY STABILIZED";
  #assert e2n_aid(n);
  e2n_record(n,"r 3000002 kit"); #assert n[0].aid_left==9 && e2n_aid_message(n)=="CAN'T USE HEALER'S KIT";
  e2n_down(n); #assert n[0].aid_left==-1 && e2n_aid_message(n)=="";
}

#test "Everglade II Wild Companion control sends the selected form and payment to the room" #steps 1000000000 {
  s:[1]E2; e2_test_cast_state(s[..],FB_CL_DRUID);
  n:=s[0].net[..]; n[0].mono=100;
  e2k_set_class(s[0].casts[..],FB_CL_DRUID,2); e2n_set_class(n,FB_CL_DRUID,2);
  frame:[1024]u8; row:[WIRE_SF]s32; zero:[WIRE_SF]s32;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=5,max=12},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1});
  count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  #assert e2k_tap_pet(s[..],EG_DO_FORM); #assert e2k_tap_pet(s[..],EG_DO_PAY); #assert e2k_tap_pet(s[..],EG_DO_SUMMON);
  p:=n[0].pipe[0]; last:=p.n-1;
  #assert cast(string)p.buf[p.from[last]..<p.from[last]+p.len[last]]=="E 4000001 9 101";
  e2n_record(n,"D 2 0 4 0 e fam 4000000 0 1"); #assert e2n_familiar_message(n)=="";
  e2n_record(n,"D 2 0 4 0 e fam 4000001 0 1"); #assert e2n_familiar_message(n)=="COMPANION SUMMONED";
}

#test "Everglade II familiars are the rows the room sends: one gone with its x leaves the others, and its plate goes with it" #steps 1000000000 {
  s:[1]E2; e2_test_cast_state(s[..],FB_CL_DRUID);
  n:=s[0].net[..]; fid:=WIRE_ID_MADE+WIRE_FAM_EID; own:=WIRE_TGT_SEAT;
  e2n_test_row(n,4,WireS.{id=fid,kind=WK_FAMILIAR,x=1.5,z=-2,hp=1,max=1,owner=own,p1=8,life=1});
  e2n_test_row(n,4,WireS.{id=fid+2,kind=WK_FAMILIAR,x=-4,z=5.5,hp=2,max=2,owner=own+2,p1=0,life=1});
  #assert e2n_familiar_of(n,0).live && e2n_familiar_of(n,0).form==8 && e2n_familiar_of(n,0).x==1.5;
  #assert e2n_familiar_of(n,2).live && e2n_familiar_of(n,2).z==5.5;
  e2n_record(n,"D 5 0 0 0 x 1170200");
  #assert fid==1170200 && !e2n_familiar_of(n,0).live && e2n_familiar_of(n,2).live;
  s[0].k=1; s[0].width=1280; s[0].height=720; s[0].focal=900;
  s[0].eye=[3]f32.[-4,e2_height(-4,13.5)+2,13.5];
  s[0].fwd=[3]f32.[0,0,-1]; s[0].right=[3]f32.[1,0,0]; s[0].up=[3]f32.[0,1,0];
  out:[8192 * E2_VERTEX_FLOATS]f32;
  #assert e2_heads(s[..],out[..],0)>0;
  e2n_record(n,"D 6 0 0 0 x 1170202");
  #assert !e2n_familiar_of(n,2).live && e2_heads(s[..],out[..],0)==0;
  e2n_test_row(n,7,WireS.{id=fid+2,kind=WK_FAMILIAR,x=-4,z=-470,hp=2,max=2,owner=own+2,p1=0,life=2});
  #assert e2n_familiar_of(n,2).live && e2n_familiar_of(n,2).z== -470;
}

#test "Everglade II Wizard Find Familiar control sends the mode and spirit and reports casting" #steps 1000000000 {
  s:[1]E2; e2_test_cast_state(s[..],FB_CL_WIZARD);
  n:=s[0].net[..]; n[0].mono=100;
  frame:[1024]u8; row:[WIRE_SF]s32; zero:[WIRE_SF]s32;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=5,max=12},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1});
  count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  #assert e2k_tap_pet(s[..],EG_DO_SPIRIT); #assert e2k_tap_pet(s[..],EG_DO_PAY); #assert e2k_tap_pet(s[..],EG_DO_FORM); #assert e2k_tap_pet(s[..],EG_DO_SUMMON);
  p:=n[0].pipe[0]; last:=p.n-1;
  #assert cast(string)p.buf[p.from[last]..<p.from[last]+p.len[last]]=="E 4000001 10 20101";
  e2n_record(n,"D 2 0 4 0 e fam-cast 4000001 1"); #assert e2n_familiar_message(n)=="CASTING FIND FAMILIAR";
  #assert !e2n_familiar(n);
  e2n_record(n,"D 2 0 4 0 e fam-cast 4000000 3"); #assert e2n_familiar_message(n)=="CASTING FIND FAMILIAR";
  e2n_record(n,"D 2 0 4 0 e fam-cast 4000001 2"); #assert e2n_familiar_message(n)=="FAMILIAR SUMMONED";
}

#test "Everglade II familiar lifecycle buttons send requests and display room results" #steps 1000000000 {
  s:[1]E2; e2_test_cast_state(s[..],FB_CL_WIZARD);
  n:=s[0].net[..]; n[0].mono=100;
  frame:[1024]u8; row:[WIRE_SF]s32; zero:[WIRE_SF]s32;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=5,max=12},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1});
  count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  #assert e2k_tap_pet(s[..],EG_DO_ORDER+2);
  p:=n[0].pipe[0]; last:=p.n-1;
  #assert cast(string)p.buf[p.from[last]..<p.from[last]+p.len[last]]=="E 4000001 11 2";
  e2n_record(n,"D 2 0 4 0 e fam 4000000 2 0");
  e2n_record(n,"D 2 0 4 0 e fam 4000001 3 0");
  #assert e2n_familiar_message(n)=="";
  e2n_record(n,"D 2 0 4 0 e fam 4000001 2 0");
  #assert e2n_familiar_message(n)=="FAMILIAR RECALLED";
  #assert e2n_familiar_order(n,3);
  e2n_record(n,"r 4000002 familiar");
  #assert e2n_familiar_message(n)=="FAMILIAR COMMAND REFUSED";
  #assert e2k_tap_pet(s[..],EG_DO_ORDER+4);
  q:=n[0].pipe[0]; step:=q.n-1;
  #assert cast(string)q.buf[q.from[step]..<q.from[step]+q.len[step]]=="E 4000003 12 0";
  e2n_record(n,"D 2 0 4 0 e fam 4000003 1 0"); #assert e2n_familiar_message(n)=="";
  e2n_record(n,"D 2 0 4 0 e fam 4000003 4 0"); #assert e2n_familiar_message(n)=="FAMILIAR MOVED";
}

#test "Everglade II familiar Cure requests a wounded nearby seat and waits for the room" #steps 1000000000 {
  s:[1]E2; e2_test_cast_state(s[..],FB_CL_DRUID);
  n:=s[0].net[..]; n[0].mono=100;
  e2k_set_class(s[0].casts[..],FB_CL_DRUID,2); e2n_set_class(n,FB_CL_DRUID,2);
  frame:[1024]u8; row:[WIRE_SF]s32; zero:[WIRE_SF]s32;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=5,max=12},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1});
  count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  e2n_test_row(n,1,WireS.{id=WIRE_ID_MADE+WIRE_FAM_EID+1,kind=WK_FAMILIAR,x=s[0].you_x,z=s[0].you_z,hp=1,max=1,owner=WIRE_TGT_SEAT+1,p1=0,life=1});
  #assert e2k_tap_pet(s[..],EG_DO_CURE);
  p:=n[0].pipe[0]; last:=p.n-1;
  #assert cast(string)p.buf[p.from[last]..<p.from[last]+p.len[last]]=="E 4000001 13 1";
  #assert !n[0].familiar_heal_cue;
  e2n_record(n,"D 2 0 4 0 e fam 4000001 5 0");
  #assert n[0].familiar_heal_cue && e2n_familiar_message(n)=="FAMILIAR DELIVERED CURE WOUNDS";
}

#test "Everglade II familiar Sense follows the room viewpoint until it ends" #steps 1000000000 {
  s:[1]E2; e2_test_cast_state(s[..],FB_CL_WIZARD);
  n:=s[0].net[..]; n[0].mono=100;
  frame:[1024]u8; row:[WIRE_SF]s32; zero:[WIRE_SF]s32;
  wire_s_pack(WireS.{id=1,kind=WK_PLAYER,hp=5,max=12},row[..]);
  count:=wire_put_d(frame[..],0,WireD.{tick=1,f=1});
  count=wire_put_s(frame[..],count,1,0,zero[..],row[..]);
  e2n_record(n,cast(string)frame[0..<count]);
  fam:=WireS.{id=WIRE_ID_MADE+WIRE_FAM_EID+1,kind=WK_FAMILIAR,x=4,z=-6,hp=1,max=1,owner=WIRE_TGT_SEAT+1,p1=8,life=1};
  e2n_test_row(n,1,fam);
  #assert e2k_tap_pet(s[..],EG_DO_ORDER+6);
  p:=n[0].pipe[0]; last:=p.n-1;
  #assert cast(string)p.buf[p.from[last]..<p.from[last]+p.len[last]]=="E 4000001 14 0";
  base:=figs.cam_shot(s[0].view,s[0].orbit,s[0].eye_pitch,s[0].press);
  e2n_record(n,"D 2 0 4 0 e fam 4000001 6 0");
  #assert !e2n_familiar_view(n).live && e2n_familiar_message(n)=="BORROWED FAMILIAR SENSES";
  fam.g=E2_SENSE_SIGHT_HEARING; e2n_test_row(n,2,fam);
  view:=e2_familiar_shot(s[..],base);
  #assert view.eye.x==4 && view.eye.z== -6 && e2n_familiar_sense(n)==2;
  fam.g=9; e2n_test_row(n,3,fam);   // senses the wire has none of: no row of a familiar
  #assert e2n_familiar_sense(n)==2;
  fam.g=E2_SENSE_SIGHT; e2n_test_row(n,4,fam);
  #assert e2_familiar_shot(s[..],base).eye.x==4 && e2n_familiar_sense(n)==1;
  fam.g=E2_SENSE_OWNER; e2n_test_row(n,5,fam);
  #assert e2_familiar_shot(s[..],base).eye.x==base.eye.x && !e2n_familiar_view(n).live;
}

#test "Everglade II familiar meshes use replicated forms and positions" {
  s:[1]E2; e2_test_cast_state(s[..],FB_CL_WIZARD);
  cc.catalog(s[0].creator[..],"C glade/environment 9 12 250 100 8 0\nC glade/familiar8 50 240 248 120 0 0\n");
  n:=s[0].net[..];
  fam:=WireS.{id=WIRE_ID_MADE+WIRE_FAM_EID+1,kind=WK_FAMILIAR,x=4,z=-470,hp=1,max=1,owner=WIRE_TGT_SEAT+1,p1=8,life=1};
  e2n_test_row(n,1,fam);
  d:=e2_familiars_draw(s[..],E2Drawn.{});
  #assert d.n==1 && d.sn==1 && d.rec==1 && s[0].draws[0]==50 && s[0].draws[1]==240;
  #assert s[0].records[0]==4 && s[0].records[2]== -470 && s[0].records[7]==120 && s[0].records[15]==18;
  fam.g=E2_SENSE_SIGHT_HEARING; e2n_test_row(n,2,fam);   // seen through its eyes, it is not drawn
  #assert e2_familiars_draw(s[..],E2Drawn.{}).n==0;
  fam.g=E2_SENSE_OWNER; e2n_test_row(n,3,fam);
  #assert e2_familiars_draw(s[..],E2Drawn.{}).n==1;
  e2n_record(n,"D 4 0 0 0 x 1170201");
  #assert e2_familiars_draw(s[..],E2Drawn.{}).n==0;
}
