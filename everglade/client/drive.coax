#load "../shared/mount-why.coax";
// Everglade II's wiring for the agent driver (metaverse-engine/agent/drive.coax, GitHub #13095): what it lists
// (you, the others in the room, the path's guard, the wolves and goblins, by the room's own slots, so
// an id stays the same while that creature lives), and how its world operations turn into a player's
// input: walking is the keys' forward along the way drv_steer says, and a use presses the bar's slot as
// 1 to 9 would (everglade/client/cast.coax e2k_press, a deed the room answers).
// The zone's mounts are listed as `horse-N` and `dragon-N` (N the mount's number in the zone, as the
// room counts them), `mount ID` walks to one and presses E as a player does (ride-view.coax
// e2rv_key), and while you ride, `walk-to ID` rides there: forward, and A or D toward it (#13449).
// everglade/client/client.coax loads this after the cast, the guard, the monsters and the ride view.

// The frame's entities, from what the room last said (the same rows the guard and monsters draw from).
e2d_frame :: (s: [] E2) {
  d := s[0].drive[..];
  drv_frame(d, s[0].width, s[0].height, s[0].k, false);
  if !d[0].on { return; }
  n := s[0].net[..]; me := e2n_vitals(n);
  drv_add(d, DRV_PLAYER, "you", -1, E2C_CLASS_TITLES[e2c_class_of(s)], s[0].you_x, s[0].you_y, s[0].you_z,
               ifx me.id >= 0 then me.hp else -1, ifx me.id >= 0 then me.max else -1, me.id >= 0 && (me.g & WG_DEAD) != 0);
  for k: 0..<E2N_ENTS {
    r := e2n_remote(n, k); if !r.ok { break; }
    drv_add(d, DRV_PLAYER, "player", r.seat, "Player", r.x, r.y, r.z, -1, -1, false);
  }
  g := e2n_guard_at(n, n[0].rt);
  if g.state != E2GD_NONE && g.life > 0 { drv_add(d, DRV_NPC, "guard", -1, "Guard", g.x, s[0].you_y, g.z, g.hp, g.max, g.state == E2GD_DOWN); }
  e2p_drive(s, d); e2b_drive(s, d); e2sp_drive(s, d);
  // the zone's mounts, by the room's own numbers (the page's copy: yours predicted, the others' as heard)
  rd := n[0].ride[..];
  for k: 0..<rd[0].m[0].n {
    h := rd[0].m[0].m[k]; if !h.on { continue; }
    dragon := rd[0].m[0].kind[k] == MK_DRAGON;
    drv_add(d, DRV_MOUNT, ifx dragon then "dragon" else "horse", k, ifx dragon then "Dragon" else "Horse", h.x, s[0].you_y, h.z, -1, -1, false);
  }
  // what is still scheduled here, for `clock settle`: a number still rising over someone
  for q: 0..<fl.FLOATS { if s[0].floats[0].items[q].on { drv_busy(d, "a damage number rising"); break; } }
  for m: 0..<E2N_MONS {
    r := e2n_mon_at(n, m, n[0].rt);
    if r.state == E2MN_GONE || r.life <= 0 { continue; }
    kind := ifx r.kind == 1 then 1 else 0;
    drv_add(d, DRV_MONSTER, E2MN_NAME[kind], m, E2MN_NAME[kind], r.x, s[0].you_y, r.z, r.hp, r.max, r.state == E2MN_DEAD);
  }
}
// The input a world operation makes this frame, in place of the keys' (ok false: none going). A use
// near and facing its target presses the slot it names.
E2dIn :: struct { ok: bool; in: EgMoveIn; }
e2d_move_in :: (s: [] E2) -> E2dIn {
  d := s[0].drive[..];
  if !d[0].on || d[0].status != DRV_GOING { return E2dIn.{}; }
  // in the saddle the operation steers the mount: where it stands and faces, forward, and A or D toward the way to go
  rd := s[0].net[0].ride[..]; mine := ifx e2n_open(s[0].net[..]) then e2rp_mine(rd, s[0].net[0].seat) else -1;
  if mine >= 0 && mount_ridden(rd[0].m[0].m[mine]) {
    h := rd[0].m[0].m[mine];
    rs := drv_steer(d, h.x, h.z, h.face, s[0].clock);
    if rs.press { e2d_press(s); return E2dIn.{}; }
    if !rs.go { return E2dIn.{}; }
    return E2dIn.{ok = true, in = EgMoveIn.{key_x = mk_rein(h.face, rs.dx, rs.dz), key_y = 1, run = rs.dist > 12, theta = e2_walk_theta(h.face)}};
  }
  st := drv_steer(d, s[0].you_x, s[0].you_z, s[0].you_face, s[0].clock);
  if st.press { e2d_press(s); return E2dIn.{}; }
  if !st.go { return E2dIn.{}; }
  // the controller's theta is the camera's; forward goes the way the camera looks (e2_walk_theta)
  return E2dIn.{ok = true, in = EgMoveIn.{key_y = 1, run = st.dist > 6, theta = e2_walk_theta(figs.atan2(st.dx, st.dz))}};
}
e2d_press :: (s: [] E2) {
  d := s[0].drive[..]; k := s[0].casts[..];
  if d[0].op == DRV_RIDE { drv_pressed(d, e2rv_key(s, 'E'), "E (mount)"); return; }   // the key a player presses (ride-view.coax)
  names: [256] u8; nn := 0;
  for i: 0..<k[0].bar_n {
    word: [XK_NAME] u8; name := e2k_name(s, i, word[..]);   // the content row's name, as the bar shows it (#13285)
    if drv_ability_is(d, name, i + 1) { drv_pressed(d, e2k_press(s, i), name); return; }
    nn = drv_put_s(names[..], nn, ifx i == 0 then ": " else ", "); nn = drv_put_s(names[..], nn, name);
  }
  if k[0].bar_n == 0 { nn = drv_put_s(names[..], 0, ": the bar is empty"); }
  drv_no_ability(d, cast(string) names[0..<nn]);
}
// The bar's slots, your portrait (it opens the class menus) and the open menu's rows, as the HUD draws
// them, for `tree` and `tap`.
e2d_bar :: (s: [] E2) {
  t := drv_trace(s[0].drive[..]); if t.count == 0 || !e2k_on(s) { return; }
  k := s[0].casts[..];
  uit_part(t, "bar");
  for i: 0..<k[0].bar_n { word: [XK_NAME] u8; b := e2k_box(k, i, s[0].width, s[0].height, s[0].k); uit_add(t, UIT_NONE, UIT_BUTTON, b[0], b[1], b[2], b[3], e2k_name(s, i, word[..])); }
  g := e2k_side_geo(s);
  uit_part(t, "portrait");
  if g.n > 0 { uit_add(t, UIT_NONE, UIT_BUTTON, g.anchor.x0, g.anchor.y0, g.anchor.x1, g.anchor.y1, "portrait"); }
  if k[0].menu >= 0 {
    rows: [EG_MENU_ROWS] int; m := e2k_menu_rows(s, k[0].menu, rows[..]);
    uit_part(t, "menu");
    for r: 0..<m { b := e2k_menu_box(s, k[0].menu, r); lb: [32] u8; ln := eg_menu_label(e2k_facts(s), rows[r], lb[..]); uit_add(t, UIT_NONE, UIT_BUTTON, b[0], b[1], b[2], b[3], cast(string) lb[0..<ln]); }
  }
}
// A driver's command (host message 700): the answer goes back through coaxial_drive_out.
e2d_message :: (s: [] E2, t: string) {
  d := s[0].drive[..]; id := why_asks(t);
  if id == "-" { _ := drv_command(d, t, s[0].clock); return; }
  d[0].on = true;
  r := s[0].net[0].ride[0].m[..];
  for k: 0..<r[0].n {
    nb: [32] u8; nn := drv_put_s(nb[..], 0, ifx r[0].kind[k] == MK_DRAGON then "dragon-" else "horse-"); nn = drv_put_i(nb[..], nn, k);
    if id != cast(string) nb[0..<nn] { continue; }
    h := r[0].m[k]; walls: [E2ML_BOXES * 6] f32; none: [] E2Still;
    n := e2ml_boxes(none, s[0].items[..], s[0].kinds[..], s[0].first[..], s[0].plant_done, h.x, h.z, e2ml_reach(r[0], k), walls[..]);
    step := ifx h.speed < 0 then -0.25f32 else 0.25f32;
    nx := h.x + sin(h.face) * step; nz := h.z + cos(h.face) * step; kept := e2m_keep(nx, nz, h.x, h.z);
    _ := emw_mount(d, id, h, mk_tune(r[0].kind[k]), e2rv_ready(s, r[0].kind[k]), walls[..], n, kept.x != nx || kept.z != nz); return;
  }
  _ := emw_entity(d, id);
}
e2_drive_out :: (s: [] E2) -> [] u8 #export_c #effects(all) { return s[0].drive[0].out[0..<s[0].drive[0].out_n]; }

#test "client driver why answers from room mounts and their catalog (#13491)" #steps 400000000 {
  s: [1] E2; r := s[0].net[0].ride[0].m[..];
  r[0].n = 1; r[0].m[0] = mount_place(10, 9, 0);
  e2d_message(s[..], "why horse-0"); #assert cp_has(drv_said(s[0].drive[..]), "asset-missing");
  #assert s[0].net[0].ride[0].asked == 0 && r[0].m[0].x == 10;
  e2d_message(s[..], "why missing"); #assert cp_has(drv_said(s[0].drive[..]), "not-in-state");
}
