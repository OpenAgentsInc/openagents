// The room client's Everglade half (GitHub #13054; docs/verse/2026-11-07-everglade-multiplayer-audit.md):
// what Everglade's page (everglade-net.coax) and Everglade II's (everglade/client/net.coax) both keep of the
// room's world. How it is drawn is the engine's (#13277): the interpolation buffer, its clock and the
// easing of corrections are aethyr/net/interp.coax, and your inputs' re-run and your actions' ledger are
// aethyr/net/predict.coax. This file is the game's row beside them:
//   - an entity as Everglade's rows describe it (NetEnt: its states' ring, who a player is, its row's
//     fields), with the engine's calls on it by name (net_push, net_state_at, net_ease);
//   - how far each kind goes on past its newest state (net_ahead: a townsperson further);
//   - an input as the engine keeps it (net_move_words), and the room's word on you (NetFix);
//   - a tree's own scalars sampled at the pose's time (net_forest_sample);
//   - the page's facts, the API's answers and the build, as both pages read them.
// It holds no page's world: the pages say where things are drawn.
//   coax/bin/coax test --library everglade/client/net-core.coax
#load "../shared/everglade-wire.coax";
#load "../shared/everglade-move-types.coax";
#load "../../aethyr/net/interp.coax";
#load "../../aethyr/net/predict.coax";

NET_ID :: 24; NET_NAME :: 40; NET_CODE :: 24; NET_URL :: 200;
NET_TICKET :: 4096;  // profile 2's v4 envelope (legacy core remains 256 bytes)
NET_LOOK :: 64;   // a look: Everglade's ranger.SKIN.DYE.TRIM, or a Character Create record (CC3, 57 bytes)
// ms a townsperson goes on: they walk their way at their pace, so their velocity holds while the
// states stop. A read lost on the socket holds every read after it for TCP's resend (200 ms, or two
// round trips: 500 ms at 250 ms), which NET_AHEAD and the buffer's spread don't cover (#12890).
NET_AHEAD_FOLK :: 700;
// A socket that goes quiet is closed and tried again: the server sends state every tick, so an open
// socket that hears nothing for NET_SILENT_MS lost its network without a close (a phone between
// networks, a laptop's wifi gone), which the browser can take minutes to notice; one opening that
// hasn't opened in NET_OPEN_MS the same. A frame that comes NET_STALL_MS or more after the last one (a
// hidden or frozen tab draws none) starts the wait again: the socket had no chance to be heard.
NET_SILENT_MS :: 6000; NET_OPEN_MS :: 10000; NET_STALL_MS :: 1000;

NetEnt :: struct {
  generation:u32 #counter;
  live: bool; eid: int; kind: int; owner: int = -1;   // eid: a seat, NET_FOLK_ID + its index, NET_MADE_ID + the server's EID
  ring: [NET_RING] NetState; ring_n: int;   // oldest first, server times
  hp: int; max: int; temp: int; p1: int; p2: int; form: int;
  cond: int;                 // its row's COND: the conditions on it (a townsperson's; a player's is P1 too)
  wanted: int;               // a player's WANTED level (w)
  born: int;                 // server ms it was first seen
  seen: int;                 // the last tick it was in
  life: int; warp: int;      // its row's LIFE and WARP: a new life or a jump starts its ring again
  t0: int; dur: int;         // its row's T0 and DUR (ticks): an effect's start and length, DUR 0 held up
  // who a player is (n)
  seat: int = -1; id: [NET_ID] u8; id_n: int; look: [NET_LOOK] u8; look_n: int; name: [NET_NAME] u8; name_n: int;
  cls: [16] u8; cls_n: int; hello_flags: int;   // its class and its hello's FLAGS (1 touch, 2 an account)
  // drawn this frame (net_step)
  shown: NetState; run: f32;
  // where it went on to past its newest state (lead: that state; lead_on: drawn past it last frame),
  // and the difference from where the states after it put it, eased out (NET_EASE)
  ease: [1] NetLead;
  cast_slot: int = -1; cast_at: int;   // its last cast (e cast), server ms
}
// An input as the engine keeps it for the re-run (aethyr/net/predict.coax): its eight fields as whole
// numbers, the f32s by their bits.
NET_MOVE_WORDS :: 8;
net_move_words :: (m: EgMoveIn, w: [] int) {
  w[0] = cast(int) f32_bits(m.key_x); w[1] = cast(int) f32_bits(m.key_y); w[2] = cast(int) f32_bits(m.pad_x); w[3] = cast(int) f32_bits(m.pad_y);
  w[4] = ifx m.run then 1 else 0; w[5] = ifx m.jump then 1 else 0; w[6] = cast(int) f32_bits(m.theta); w[7] = m.link_flags;
}
net_move_of :: (w: [] int) -> EgMoveIn {
  return EgMoveIn.{key_x = f32_from_bits(cast(u32) w[0]), key_y = f32_from_bits(cast(u32) w[1]), pad_x = f32_from_bits(cast(u32) w[2]), pad_y = f32_from_bits(cast(u32) w[3]),
                   run = w[4] != 0, jump = w[5] != 0, theta = f32_from_bits(cast(u32) w[6]), link_flags = w[7]};
}
// You as the server has you after input `ack` (D's p entry for your seat).
NetFix :: struct { ok: bool; ack: int; x: f32; y: f32; z: f32; yaw: f32; vx: f32; vy: f32; vz: f32; ground: bool; carry: f32; jump: bool; }

// ---- the engine's buffer on an Everglade entity (aethyr/net/interp.coax)
// A state into an entity's ring, oldest first: one no newer than the newest replaces it.
net_push :: (en: [] NetEnt, p: NetState) { en[0].ring_n = net_ring_push(en[0].ring[..], en[0].ring_n, p); }
// How long entity en goes on past its newest state (ms).
net_ahead :: (en: [] NetEnt) -> int { return ifx en[0].kind == WK_FOLK then NET_AHEAD_FOLK else NET_AHEAD; }
// Where entity en is at server time rt.
net_state_at :: (en: [] NetEnt, rt: int) -> NetState { return net_ring_at(en[0].ring[0..<en[0].ring_n], rt, net_ahead(en)); }
// The difference between where it went on to and where newer states put it, eased out (one state at least).
net_ease :: (en: [] NetEnt, p: NetState, rt: int, dt: f32) { net_lead_ease(en[0].ease[..], en[0].ring[0..<en[0].ring_n], p, rt, dt, net_ahead(en)); }
// A row's state into the ring (a standing entity's last state goes in again a tick before it).
net_push_row :: (en: [] NetEnt, p: NetState, hz: int) { en[0].ring_n = net_ring_push_row(en[0].ring[..], en[0].ring_n, p, hz); }
// Tree-specific fields share the pose's sampled time. The common pose buffer stays realm-neutral.
net_forest_sample :: (en: [] NetEnt, pose: NetState) -> NetState {
  if en[0].kind != WK_TREE || en[0].ring_n == 0 { return pose; }
  sample := en[0].ring[0];
  for q: 1..<en[0].ring_n {
    next := en[0].ring[q];
    if pose.t <= next.t {
      f := nc_clamp01(f32(pose.t - sample.t) / f32(nc_hi(next.t - sample.t, 1)));
      sample.ax = nc_lerp(sample.ax, next.ax, f); sample.az = nc_lerp(sample.az, next.az, f); sample.age = nc_lerp(sample.age, next.age, f);
      break;
    }
    sample = next;
  }
  out := pose; out.ax = sample.ax; out.az = sample.az; out.age = sample.age;
  return out;
}

#test "net core: an Everglade entity is drawn by the engine's buffer; a townsperson goes on further; an input keeps every field" {
  en: [1] NetEnt; en[0].kind = WK_PLAYER;
  net_push(en[..], NetState.{t = 100, x = 0, z = 0, yaw = 3.0, vz = -4.25});
  net_push_row(en[..], NetState.{t = 133, x = 0, z = -0.14, yaw = -3.0, vz = -4.25}, 30);
  #assert en[0].ring_n == 2 && abs(net_state_at(en[..], 116).z + 0.0679) < 0.002 && net_ahead(en[..]) == NET_AHEAD;
  held := net_state_at(en[..], 133 + 900); #assert abs(held.z - (-0.14 - 4.25 * 0.15)) < 0.001;
  net_ease(en[..], held, 133 + 900, 0.016); #assert en[0].ease[0].on && en[0].ease[0].lead.t == 133;
  en[0].kind = WK_FOLK; #assert net_ahead(en[..]) == NET_AHEAD_FOLK;
  folk := net_state_at(en[..], 133 + 900); #assert abs(folk.z - (-0.14 - 4.25 * 0.7)) < 0.001;
  for i: 0..<20 { net_push(en[..], NetState.{t = 200 + i * 33}); } #assert en[0].ring_n == NET_RING;
  w: [NET_MOVE_WORDS] int; m := EgMoveIn.{key_x = -1, key_y = 0.5, pad_x = 0.25, pad_y = -0.75, run = true, jump = false, theta = 1.2345, link_flags = 33};
  net_move_words(m, w[..]); o := net_move_of(w[..]);
  #assert o.key_x == -1 && o.key_y == 0.5 && o.pad_x == 0.25 && o.pad_y == -0.75 && o.run && !o.jump && o.theta == m.theta && o.link_flags == 33 && NET_MOVE_WORDS <= NET_PREDICT_WORDS;
  m.run = false; m.jump = true; net_move_words(m, w[..]); #assert !net_move_of(w[..]).run && net_move_of(w[..]).jump;
}

// ---- the page's facts, the API's answers and the build, as every realm's page reads them
net_copy :: (out: [] u8, t: string) -> int {
  n := 0;
  for ch: t { if n >= out.count { break; } if ch <= 32 || ch == 127 { continue; } out[n] = ch; n += 1; }
  return n;
}
net_query :: (url: string, key: string) -> string {
  at := 0;
  while at + key.count + 1 <= url.count {
    before := ifx at == 0 then cast(u8) 63 else url[at - 1];
    if (before == 63 || before == 38) && url[at..<at + key.count] == key && url[at + key.count] == 61 {
      i := at + key.count + 1; e := i;
      while e < url.count && url[e] != 38 && url[e] != 35 { e += 1; }
      return url[i..<e];
    }
    at += 1;
  }
  return "";
}
net_code_ok :: (t: string) -> bool {
  if t.count == 0 || t.count > NET_CODE { return false; }
  for ch: t { if !((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '-') { return false; } }
  return true;
}
net_number :: (t: string) -> int { r: [1] WireRd; v := wire_num(t, r[..]); return ifx r[0].ok then v else -1; }
net_json_field :: (t: string, name: string) -> string {
  for i: 0..<t.count {
    if t[i] != '"' || i + name.count + 3 > t.count || t[i + 1..<i + 1 + name.count] != name || t[i + 1 + name.count] != '"' || t[i + 2 + name.count] != ':' { continue; }
    a := i + 3 + name.count;
    q := a < t.count && t[a] == '"';
    if q { a += 1; }
    e := a;
    while e < t.count && (ifx q then t[e] != '"' else (t[e] != ',' && t[e] != '}')) { e += 1; }
    return t[a..<e];
  }
  return "";
}
// This page's build, "ENGINE.RULES.CONTENT" (WirePins), at `at` in out: the end.
net_put_build :: (out: [] u8, at: int) -> int { return net_put_build_at(out, at, 0); }
// ... with its content tables at revision `rev` (wire_pins_at; 0: a page that carries none).
net_put_build_at :: (out: [] u8, at: int, rev: int) -> int {
  p := wire_pins_at(rev);
  pins := [3] int.[p.engine, p.rules, p.content];
  k := at;
  for i: 0..<3 {
    if i > 0 { k = wire_put(out, k, "."); }
    d := wire_int(out, k, pins[i]);   // " N": its digits moved over the space
    for j: k + 1..<d { out[j - 1] = out[j]; }
    k = d - 1;
  }
  return k;
}
