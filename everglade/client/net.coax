// Everglade II's room (#13054): the page's side of the server's world for the Everglade II realm.
// From USE IN EVERGLADE on, the run down the path and the clearing are one room
// (coax/web/room/room-everglade.coax eg_e2_code: everglade2-N, a check's pair-e2-*), whose world steps
// you as this page does (everglade/shared/move.coax). This file holds the socket, the seat ticket, the
// clock, your inputs and the server's word on you, and the other players as the room says them,
// drawn a jitter buffer behind (everglade/client/net-core.coax, which Everglade's page shares). The face
// (everglade2-face.c) carries its pipe to the host and steps you at the room's rate.
//
// The order of a join: the page facts (message 600) name the room's host and your player id; a seat
// ticket is asked for with the realm (the API's directory places you in an instance and on its shard);
// the socket opens with it; the room's y seats you; the page sends its build (WirePins) and hello with
// your Character Create record as its look and your name; the room's rows follow. A dropped socket
// comes back on a doubling, jittered wait, each open with a fresh ticket.
#load "../../coax/web/socket.coax";
#load "net-core.coax";
#load "own.coax";   // your character as the room holds it: coin, quests, the bag (#13381)
#load "../shared/player-name.coax";
#load "../shared/class-kit.coax";   // the class kits: the hello's class (srd-*), a cast's slot (#13058)
#load "../../coax/web/analytics.coax";   // fact_of; and the page's Track (everglade/client/track.coax)
#load "../../metaverse-engine/net/projectile.coax";   // arrows over the room: the launch, the room's flight and its end (#13157)
#load "../../metaverse-engine/net/stats.coax";   // the netcode readout's counts (?net, #13157)
#load "../../metaverse-engine/net/transport.coax";   // WebSocket or WebTransport under one interface (#13176)
#load "../server/creature-wire.coax";   // what the guard and the monsters did (e guard, e mon), the room's codec (#13246, #13276)
#load "../server/kit-wire.coax";   // the Healer's Kit's frames, the room's codec (#13245)
#load "../../metaverse-engine/net/relay-wire.coax";   // the relay's own frames: y and the clock's ping and pong (#13245)

E2N_OFF :: 0; E2N_OPENING :: 1; E2N_OPEN :: 2; E2N_DOWN :: 3;
E2N_ENTS :: 48;                 // the room's players (a room seats 16), monsters, guard and familiars this page holds: every entity it draws (#13276, #13277)
E2N_REALM :: "everglade2";
E2N_GAME :: "everglade";        // the room server's game path (/api/room/relay/everglade/CODE)
E2N_PIPE_TICKET :: 4;           // the pipe's ask for a seat ticket: the API path, a newline, the body (as Everglade's, everglade5e-face.c)
E2N_PIPE_NAME :: 9;             // the pipe's POST of your name: /api/playtest/player/name, a newline, the body
E2N_HOLD_MS :: 4000;            // the run waits this long at most for its seat before it walks on its own
E2N_SAY :: 48;
E2N_BAR_NONE :: 0; E2N_BAR_KICKED :: 1; E2N_BAR_BANNED :: 2;
E2N_BAR_TEXT :: 96;
E2N_BAR_ASK_MS :: 600000;       // with no end said, the page asks for a seat again this often, not on the lost socket's short waits
E2N_ACT_CAST :: 1; E2N_ACT_REST :: 2;   // your actions' kinds in the ledger (metaverse-engine/net/predict.coax)
E2N_ACT_WAIT_MS :: 5000;        // a request the room has not answered in this long has timed out
E2N_CASTS :: 16;                // the others' casts heard and not yet played (e2n_cast_due)
E2N_SHOTS :: 16;                // the room's words on arrows heard and not yet drawn (everglade/client/arrows.coax e2bw_step)
// The room over WebTransport (#13176): ?transport=wt asks for it, ?transport=ws keeps the WebSocket;
// with neither, E2N_WT_DEFAULT on a shard's own endpoint (a room VM, whose UDP the room answers; the
// load balancer's path carries TCP only). The host falls back to the WebSocket where WebTransport
// fails to connect (coax/web/room-wt.js). On since the loss matrix of #13187.
E2N_WT_DEFAULT :: true;

// One cast the room said (e cast SS SLOT AX AY AZ SEED, #13058): another player's, played when the
// drawn picture reaches the tick it came with (t, the room's clock), at that player as drawn.
E2nCast :: struct { live: bool; ss: int; slot: int; ax: f32; ay: f32; az: f32; seed: int; t: int; }

// The path's guard and the monsters as the room's rows say them (everglade-wire.coax WK_GUARD,
// WK_MONSTER, #13276): each is an entity of the page's one list (ents), drawn from the engine's
// interpolation buffer as the other players are (metaverse-engine/net/interp.coax). These are what the page's
// readers ask for (e2n_guard_at, e2n_mon_at). Their blows, arrows and falls are e entries (e guard,
// e mon: everglade/server/creature-wire.coax), kept until the picture reaches their moment.
E2N_GUARD_HITS :: 8;
E2nGuard :: struct { t: int; life: int; state: int = 4; x: f32; z: f32; yaw: f32; hp: int; max: int; swing: int = -1; foe: int = -1; }
E2nGuardHit :: struct { live: bool; t: int; kind: int; seat: int; amount: int; }
E2N_MONS :: WIRE_MONS; E2N_MON_HITS :: 16;
E2nMon :: struct { t: int; life: int; kind: int; state: int = 4; x: f32; z: f32; yaw: f32; hp: int; max: int = 1; act: int; act_t: int; foe: int = -1; }
E2nMonHit :: struct { live: bool; t: int; kind: int; m: int; seat: int; amount: int; fx: f32; fz: f32; tx: f32; tz: f32; fly: f32; }
E2N_MON_STATE :: 255;   // a monster's state in its ring's flags; its act under way is above it (E2N_MON_ACT)
E2N_MON_ACT :: 8;
// A familiar is an entity of the page's one list too (#13277): its owner's seat in owner, its form in
// p1, drawn from the engine's interpolation buffer (metaverse-engine/net/interp.coax) as every other entity is.
// The room tells them in m2 (everglade/server/familiar.coax) until they are rows (#13276), so their
// ids and their kind are the page's own for now: no row has them.
E2N_FAMILIARS :: 16;
E2N_FAM_EID :: 970200;          // owner seat S's familiar: WIRE_ID_MADE + E2N_FAM_EID + S
E2N_ENT_FAMILIAR :: 1015;       // such an entity's kind in ents: no row's kind
E2N_FAM_JUMP :: 4.0;            // metres: farther than this in one word is a recall or a new summons, never drawn between
E2nFamiliar :: struct { live:bool; form:int; x:f32; z:f32; hp:int; max:int; }
E2Net :: struct {
  want: bool;                   // a room: the page facts named a host and this is not a staged shot
  state: int; sock: int = -1; tries: int; retry: int;
  url: [NET_URL] u8; url_n: int; host: [NET_URL] u8; host_n: int;   // (the page's host, kept apart: a shard's endpoint overwrites url)
  code: [NET_CODE] u8; code_n: int;   // the instance: the directory's, a check's (?room=) or none (the realm asks)
  local_relay: bool;            // ?relay=ws://localhost:PORT: a room server on this machine
  ticket: [NET_TICKET] u8; ticket_n: int; ticket_asked: bool;
  pid: [NET_ID] u8; pid_n: int; account: bool;
  look: [NET_LOOK] u8; look_n: int;   // your Character Create record (CC3), the hello's look
  name: [NET_NAME] u8; name_n: int;   // your name, as the ticket's answer says it
  naming: bool;                 // your name's POST is out: the seat ticket waits for it, so it carries the name
  joined: bool;                 // the run began (USE IN EVERGLADE) or you came in with a record: the page joins
  mono: int; offset: int; synced: int;
  ping_rtt: [NET_PINGS] int; ping_off: [NET_PINGS] int; pings: int; ping_at: int; ping_n: int;
  seat: int = -1; sat: bool; lost: bool; stale: bool; elsewhere: bool;
  ents: [E2N_ENTS] NetEnt;
  hz: int = WIRE_HZ; w_tick: int; w_t: int; worlds: int;
  w_day: int = -1;              // the room's ms into its day at w_tick (W), -1 before one is heard: the light's clock (everglade/client/client.coax e2_light)
  tick: int; tick_t: int;
  late_mean: f32; jitter: f32; interval: f32 = 33; delay: int = NET_LOW; ticks: int;
  lag: f32 = NET_LOW; rt: int; drawn_at: int;
  mir: [1] WireMirror;
  pred: [1] NetPredict;   // your inputs, the newest the room stepped and the re-run due (metaverse-engine/net/predict.coax)
  fix: NetFix;            // the room's word on you: your row's fields after input pred.acked
  off: [1] NetCorrect;    // where you are drawn less where the re-runs put you, eased out (metaverse-engine/net/interp.coax)
  hello_due: bool;
  change_due: bool;             // your class or look changed while seated: the room is told (V), for it holds a ticket's later hellos
  // the room sat your seat at another class or level than yours (its n row: the ticket's, or a level its
  // XP gave, #13259): taken as yours, the bar and Character Create's record too (everglade/client/client.coax)
  served: bool;
  // where you stand (the face's, each frame), and whether this page sat before: sitting again after a
  // lost or restarted room, the hello says it first (A), so the room puts you back here (#13057)
  at_x: f32; at_z: f32; at_yaw: f32; at_known: bool; sat_before: bool; again: bool; agains: int;
  // the last such return: the room's first word on you less where you were drawn (mm), and the time
  // from losing the room to it (ms); lost_at when the socket went (0 not lost)
  lost_at: int; back_pending: bool; back_fix_mm: int = -1; back_ms: int = -1;
  pipe: [1] Pipe;
  out: [WIRE_FRAME] u8;
  frames_in: int; frames_out: int; bytes_in: int; fix_sq: f32;
  stats: [1] NetStats;           // the netcode readout's counts (metaverse-engine/net/stats.coax): bytes, frames, state gaps, corrections
  link: [1] NetConn;             // the transport the socket runs on, its owed inputs and counts (metaverse-engine/net/transport.coax)
  wt_ask: int = -1;              // ?transport=: 1 wt, 0 ws, -1 neither (e2n_wt)
  direct: bool;                  // the URL is a shard's own endpoint, from the seat ticket (#13179)
  direct_blocked: bool;          // a shard's own endpoint never opened (a network that blocks its port): the load balancer's path from then on
  wout: [NET_DATAGRAM_MAX] u8;   // a frame as the pipe carries it (net_conn_frame, net_conn_input)
  said: [E2N_SAY] u8; said_n: int; said_at: int;
  full: [E2N_SAY] u8; full_n: int; full_at: int = -100000;   // a full room, as said over the bar (e2n_full_message, #13263)
  // a moderator's kick or ban, as the seat ticket's refusal said it (#13302): which (E2N_BAR_*), when it
  // ends on the wall clock (ms; 0 no end, or not said), and the line over the bar (e2n_barred_message)
  barred: int; barred_until: int; barred_text: [E2N_BAR_TEXT] u8;
  klass: int = 3;               // your Character Create class (FB_CL_*: the druid until it says), the hello's srd-*
  level: int = 1;               // and its level (the hello's srd-CLASS-LEVEL past 1, #13046)
  ent_class: [E2N_ENTS] int;    // each other player's class (FB_CL_*, -1 none) from its n row's CLASS: the kit their body carries
  casts: [E2N_CASTS] E2nCast;   // the others' casts, waiting for their tick to be drawn
  // the room's arrows (metaverse-engine/net/projectile.coax a and d), each with the moment it names on this
  // page's clock of the room (ms): when it left, when it ended; and how many were heard
  shots: [E2N_SHOTS] NetShot; shot_t: [E2N_SHOTS] int; ends: [E2N_SHOTS] NetShotEnd; end_t: [E2N_SHOTS] int; shots_heard: int; ends_heard: int;
  // the arrows' ids heard, loosed and ended: on WebTransport each word comes as a datagram and on the
  // combat stream (coax/web/room/room-wt.coax rm_wt_hasten), and is taken once (a seat's room numbers them from 1)
  shot_ids: [1] NetSeen; end_ids: [1] NetSeen;
  mine_cast: E2nCast;           // your last cast the room took, as it said it (everglade/client/cast.coax e2k_taken plays it)
  cast_sent: int; cast_mine: int; cast_heard: int; cast_refused: int;   // yours sent, yours heard back, others' heard, yours refused
  cast_said: string; cast_said_at: int; // bounded local feedback from the latest request
  cast_seq: int;                // your last cast's number (the room's r SEQ names it)
  acts: [1] NetLedger;          // your casts and rests that wait for the room: pressed, then confirmed, refused or timed out (metaverse-engine/net/predict.coax)
  familiar_tick:int=-1;
  guard_hits: [E2N_GUARD_HITS] E2nGuardHit;
  mon_hits: [E2N_MON_HITS] E2nMonHit;
  familiar_seq:int=4000000; familiar_at:int=-100000; familiar_ok:bool; familiar_form:int; familiar_slot:int; familiar_spirit:int=RS_FAMILIAR_FEY; familiar_cast:int; familiar_order:int; familiar_heal_cue:bool; familiar_sense:int;
  aid_seq: int = 3000000; aid_left: int = -1; aid_at: int = -100000; aid_ok: bool;
  // your rest as the room's rules hold it (z SEQ CODE DICE, everglade/server/rest.coax): known
  // only once this socket's room has said it; your last rest request's number and when it was refused
  rest_known: bool; rest_code: int; rest_dice: int; rest_seq: int; rest_sent: int; rest_refused: int; rest_refused_at: int = -100000;
  // your bar as the room's rules hold it (b N V ..., #13046): known once this socket's room has said it
  kit_known: bool; kit: [1] WireKit;
  // What you did and what befell you, counted as the room says it, for analytics (everglade/client/track.coax
  // reads the counts each frame): by foe, 0 a wolf, 1 a goblin, 2 the guard (E2N_FOE_*), your blows that
  // landed, theirs that landed on you, the ones that fell after you hurt them; your XP gained and the
  // level the room last raised you to (e xp, e level); your last cast's slot; who last hurt you.
  hit_n: [3] int; hurt_n: [3] int; fell_n: [3] int; xp_n: int; level_got: int; cast_slot: int = -1; hurt_by: int = -1;
  mine: [E2N_MONS + 1] bool;   // a monster (or, last, the guard) you hurt and that hasn't fallen yet
  // your character as the room holds it (everglade/client/own.coax, #13381): its coin, quests and bag
  own: [1] E2Own;
  content_rev: int;            // this page's content tables' revision (everglade/client/bag.coax e2i_load): the P frame's content pin
}
E2N_FOE_WOLF :: 0; E2N_FOE_GOBLIN :: 1; E2N_FOE_GUARD :: 2;
E2N_FOE_NAMES :: [3] string.["wolf", "goblin", "guard"];
// Monster m's kind as the room last said it (0 a wolf, 1 a goblin).
e2n_mon_kind :: (n: [] E2Net, m: int) -> int {
  k := ifx m >= 0 && m < E2N_MONS then e2n_ent(n, WIRE_ID_MADE + WIRE_MON_EID + m, false) else -1;
  return ifx k >= 0 && n[0].ents[k].p2 == 1 then E2N_FOE_GOBLIN else E2N_FOE_WOLF;
}

// Whether the room opens as WebTransport first: as ?transport= asks, else E2N_WT_DEFAULT on a shard's own endpoint.
e2n_wt :: (n: [] E2Net) -> bool { return ifx n[0].wt_ask >= 0 then n[0].wt_ask == 1 else E2N_WT_DEFAULT && n[0].direct; }
e2n_open :: (n: [] E2Net) -> bool { return n[0].state == E2N_OPEN && n[0].seat >= 0; }
e2n_now :: (n: [] E2Net) -> int { return n[0].mono + n[0].offset; }
// A frame to the room on its channel: a cast, its launch and an interaction on the combat stream, the
// rest on the session's (metaverse-engine/net/transport.coax). On a WebSocket the bytes are the frame's own.
// On WebTransport a cast and its launch also ride the input datagrams, owed with the next input's
// number until the room acknowledges it, so a lost packet costs them no resend's wait; the room hears
// each once, whichever way comes first (room-wt.coax rm_wt_once, #13187).
e2n_send :: (n: [] E2Net, count: int) {
  if n[0].state != E2N_OPEN || n[0].sock < 0 || count <= 0 { return; }
  f := cast(string) n[0].out[0..<count];
  if (f[0] == 'C' || f[0] == 'F') && n[0].link[0].kind == NET_WT { e2n_pipe(n, net_conn_owe(n[0].link[..], n[0].pred[0].seq + 1, f, n[0].wout[..])); }
  e2n_pipe(n, net_conn_frame(n[0].link[..], ifx f[0] == 'C' || f[0] == 'F' || f[0] == 'E' then NET_COMBAT else NET_SESSION, f, n[0].wout[..]));
}
e2n_pipe :: (n: [] E2Net, d: string) {
  if d.count > 0 && pipe_send(n[0].pipe[..], n[0].sock, d) { n[0].frames_out += 1; net_stats_out(n[0].stats[..], d.count, n[0].mono); }
}
e2n_tell :: (n: [] E2Net, t: string) {
  n[0].said_n = 0;
  for ch: t { if n[0].said_n < E2N_SAY { n[0].said[n[0].said_n] = ch; n[0].said_n += 1; } }
  n[0].said_at = n[0].mono;
}

// ---- the page: where the socket goes

// The page facts (message 600): the host, ?relay= and ?room=, your player id, the wall clock. A
// staged shot (?at=, ?walk) and a golden page open no socket.
e2n_facts :: (n: [] E2Net, facts: string, alone: bool) {
  url := fact_of(facts, "url");
  sl := 0; k := 0;
  while k < url.count && sl < 3 { if url[k] == '/' { sl += 1; } if sl < 3 { k += 1; } }
  secure := url.count > 5 && url[0..<5] == "https";
  start := ifx secure then 8 else 7;
  m := wire_put(n[0].url[..], 0, ifx secure then "wss://" else "ws://");
  if start < k { m = wire_put(n[0].url[..], m, url[start..<k]); }
  n[0].local_relay = false;
  relay := net_query(url, "relay");
  if relay.count > 15 && relay.count < 40 && relay[0..<15] == "ws://localhost:" {
    ok := true;
    for c: relay[15..<relay.count] { if c < '0' || c > '9' { ok = false; } }
    if ok { m = wire_put(n[0].url[..], 0, relay); n[0].local_relay = true; }
  }
  n[0].host_n = net_copy(n[0].host[..], cast(string) n[0].url[0..<m]);
  m = wire_put(n[0].url[..], m, "/api/room/relay/"); m = wire_put(n[0].url[..], m, E2N_GAME); m = wire_put(n[0].url[..], m, "/");
  n[0].url_n = m;
  room := net_query(url, "room");
  n[0].code_n = 0;
  if net_code_ok(room) && e2n_code_ok(room) { n[0].code_n = net_copy(n[0].code[..], room); n[0].url_n = wire_put(n[0].url[..], n[0].url_n, room); }
  n[0].want = !alone && start < k;
  pid := fact_of(facts, "player");
  if pid.count > 0 { n[0].pid_n = net_copy(n[0].pid[..], pid); }
  n[0].account = fact_of(facts, "account").count > 0;
  tr := net_query(url, "transport"); n[0].wt_ask = ifx tr == "wt" then 1 else ifx tr == "ws" then 0 else -1;
  wall := net_number(fact_of(facts, "now")); nav := net_number(fact_of(facts, "nav"));
  if wall > 0 && nav >= 0 && n[0].synced == 0 { n[0].offset = wall - nav; }
}
// The rooms Everglade II plays in: its realm's instances, and its checks' (the room's eg_e2_code).
e2n_code_ok :: (code: string) -> bool {
  return (code.count > 11 && code[0..<11] == "everglade2-") || (code.count > 8 && code[0..<8] == "pair-e2-");
}
#test "Everglade II's page finds its room's host, a local room and a check's room in the page facts" {
  n: [1] E2Net;
  e2n_facts(n[..], "url=https://openagents.com/worlds/everglade2\nplayer=p-abc\nnow=5000\nnav=1000\n", false);
  #assert n[0].want && cast(string) n[0].url[0..<n[0].url_n] == "wss://openagents.com/api/room/relay/everglade/" && n[0].code_n == 0;
  #assert cast(string) n[0].pid[0..<n[0].pid_n] == "p-abc" && n[0].offset == 4000;
  m: [1] E2Net;
  e2n_facts(m[..], "url=http://127.0.0.1:8863/worlds/everglade2?relay=ws://localhost:8930&room=pair-e2-check-1\n", false);
  #assert m[0].local_relay && cast(string) m[0].url[0..<m[0].url_n] == "ws://localhost:8930/api/room/relay/everglade/pair-e2-check-1";
  // a v1 room's code is not Everglade II's: the realm asks instead
  o: [1] E2Net; e2n_facts(o[..], "url=http://127.0.0.1:8863/worlds/everglade2?room=pair-load-1\n", false); #assert o[0].code_n == 0;
  q: [1] E2Net; e2n_facts(q[..], "url=http://127.0.0.1:8863/worlds/everglade2?at=40\n", true); #assert !q[0].want;
}

// A shard's endpoint the directory may name (#13179): wss:// on an openagents.com name, at a shard's
// room path, ending in "/". Anything else, and the page opens the load balancer's /api/room/sK/.
e2n_endpoint_ok :: (ep: string) -> bool {
  if ep.count < 30 || ep[0..<6] != "wss://" || ep[ep.count - 1] != '/' { return false; }
  host := 6;
  while host < ep.count && ep[host] != '/' && ep[host] != ':' { if ep[host] == '"' || ep[host] == '\\' || ep[host] <= ' ' { return false; } host += 1; }
  tail := ".openagents.com";
  if host < 6 + tail.count + 1 || ep[host - tail.count..<host] != tail { return false; }
  p := host; while p < ep.count && ep[p] != '/' { p += 1; }
  room := "/api/room/s";
  return p + room.count < ep.count && ep[p..<p + room.count] == room;
}
#test "a shard's endpoint is taken only on an openagents.com name at a room path" {
  #assert e2n_endpoint_ok("wss://room.openagents.com/api/room/s1/") && e2n_endpoint_ok("wss://room-staging.openagents.com:443/api/room/s1/");
  #assert !e2n_endpoint_ok("ws://room.openagents.com/api/room/s1/") && !e2n_endpoint_ok("wss://room.openagents.com.evil.io/api/room/s1/");
  #assert !e2n_endpoint_ok("wss://evilopenagents.com/api/room/s1/") && !e2n_endpoint_ok("wss://room.openagents.com/api/other/s1/") && !e2n_endpoint_ok("wss://room.openagents.com/api/room/s1");
}

// The seat ticket's ask: /api/playtest/room-ticket/CODE (a check's room) or the realm's
// (?realm=everglade2: the directory places you), with this page's build and checkpoint 2.
e2n_ask_ticket :: (n: [] E2Net) {
  t: [256] u8;
  k := wire_put(t[..], 0, "/api/playtest/room-ticket/");
  listed := n[0].code_n == 0;
  k = wire_put(t[..], k, ifx listed then E2N_REALM else cast(string) n[0].code[0..<n[0].code_n]);
  if listed { k = wire_put(t[..], k, "?realm="); k = wire_put(t[..], k, E2N_REALM); k = net_put_build_at(t[..], wire_put(t[..], k, "&build="), n[0].content_rev); k = wire_put(t[..], k, "&checkpoint=2&rest=1"); }
  else if e2n_realm_instance(cast(string) n[0].code[0..<n[0].code_n]) {
    // the realm's own instance, asked again (a reconnect): naming the realm, the directory answers
    // its shard and endpoint, or places you on a live shard when that one is down (#13179)
    k = wire_put(t[..], k, "?realm="); k = wire_put(t[..], k, E2N_REALM); k = wire_put(t[..], k, "&checkpoint=2&rest=1");
  }
  else { k = wire_put(t[..], k, "?checkpoint=2&rest=1"); }   // rest=1: a profile 3 capture as it is (#13046)
  k = wire_put(t[..], k, "\n{}");
  if pipe_put(n[0].pipe[..], E2N_PIPE_TICKET, -1, cast(string) t[0..<k]) { n[0].ticket_asked = true; }
}
// An instance of the listed realm (everglade2-3), not a check's room (pair-e2-x-1).
e2n_realm_instance :: (code: string) -> bool {
  r := E2N_REALM;
  return code.count > r.count + 1 && code[0..<r.count] == r && code[r.count] == '-';
}
#test "a reconnect names the realm for the realm's instances only" {
  #assert e2n_realm_instance("everglade2-3") && !e2n_realm_instance("everglade2") && !e2n_realm_instance("pair-e2-ab-1");
}
// The ticket's answer: the ticket, the instance and shard the directory placed you in, your name.
e2n_ticket :: (n: [] E2Net, answer: string) {
  n[0].ticket_asked = false; n[0].ticket_n = 0;
  if answer.count > 4 && answer[0..<4] == "403\n" {
    // a moderator kicked or banned this account (player.c room_ticket, moderation-policy.coax): the page
    // says so over the bar and plays on alone
    why := net_json_field(answer, "error");
    if why == "banned" || why == "kicked" {
      e2n_barred(n, ifx why == "banned" then E2N_BAR_BANNED else E2N_BAR_KICKED, net_number(net_json_field(answer, "until"))); return;
    }
  }
  n[0].barred = E2N_BAR_NONE; n[0].barred_until = 0;
  if answer.count <= 4 || answer[0..<4] != "200\n" {
    // every room is full: the API says how many wait, and the page asks again (player.c room_ticket)
    if answer[0..<4] == "503\n" && net_json_field(answer, "waiting").count > 0 { e2n_full(n, "", ""); }
    // maintenance (#13299, the API's flag): the page says the API's words of why, and asks again
    if answer[0..<4] == "503\n" && net_json_field(answer, "until_ms").count > 0 { e2n_maintenance(n, net_json_field(answer, "maintenance")); }
    e2n_down(n); return;
  }
  tk := net_json_field(answer, "ticket");
  if tk.count == 0 || tk.count > NET_TICKET { e2n_down(n); return; }
  n[0].ticket_n = net_copy(n[0].ticket[..], tk);
  // the instance the ticket is for (the directory's, or the API's numbered instance of a check's room:
  // pair-e2-x becomes pair-e2-x-1), on its shard when the answer names one
  room := net_json_field(answer, "room"); shard := net_number(net_json_field(answer, "shard"));
  if e2n_code_ok(room) && net_code_ok(room) {
    n[0].direct = false;
    n[0].code_n = net_copy(n[0].code[..], room);
    m := wire_put(n[0].url[..], 0, cast(string) n[0].host[0..<n[0].host_n]);
    ep := net_json_field(answer, "endpoint");
    if !n[0].local_relay && !n[0].direct_blocked && e2n_endpoint_ok(ep) && ep.count + 64 < NET_URL {
      // the shard's own endpoint, from the directory (a room VM, #13179): wss://room.openagents.com/api/room/sK/
      m = wire_put(n[0].url[..], 0, ep); m = wire_put(n[0].url[..], m, "relay/"); n[0].direct = true;
    } else if !n[0].local_relay && shard >= 1 && shard <= 99 {
      m = wire_put(n[0].url[..], m, "/api/room/s"); d := wire_int(n[0].url[..], m, shard);
      for q: m + 1..<d { n[0].url[q - 1] = n[0].url[q]; }   // wire_int puts " N": the space goes
      m = d - 1;
      m = wire_put(n[0].url[..], m, "/relay/");
    } else { m = wire_put(n[0].url[..], m, "/api/room/relay/"); }
    m = wire_put(n[0].url[..], m, E2N_GAME); m = wire_put(n[0].url[..], m, "/");
    m = wire_put(n[0].url[..], m, room);
    n[0].url_n = m;
  }
  // the room you asked for was full: the directory placed you in another, and the page says which
  if net_json_field(answer, "full") == "true" && net_json_field(answer, "asked").count > 0 { e2n_full(n, net_json_field(answer, "asked"), room); }
  name := net_json_field(answer, "name");
  if name.count > 0 { e2n_name_is(n, name); }
}
// A full room, said over the bar for E2N_FULL_MS: ROOM 3 HAS 16 PLAYERS · JOINING ROOM 5, or with no
// room asked, every room full (EVERY ROOM HAS 16 PLAYERS · TRYING AGAIN). The number is WIRE_SEATS.
E2N_FULL_MS :: 8000;
e2n_full :: (n: [] E2Net, asked: string, placed: string) {
  t: [E2N_SAY] u8; k := 0;
  if asked.count == 0 { k = wire_put(t[..], 0, "EVERY ROOM HAS"); }
  else { k = e2n_room_name(t[..], 0, asked, "THAT ROOM"); k = wire_put(t[..], k, " HAS"); }
  k = wire_int(t[..], k, WIRE_SEATS); k = wire_put(t[..], k, " PLAYERS");
  if asked.count == 0 { k = wire_put(t[..], k, " · TRYING AGAIN"); }
  else { k = e2n_room_name(t[..], wire_put(t[..], k, " · JOINING "), placed, "ANOTHER"); }
  e2n_tell(n, cast(string) t[0..<k]);
  for i: 0..<k { n[0].full[i] = t[i]; }
  n[0].full_n = k; n[0].full_at = n[0].mono;
}
// Maintenance, said over the bar as a full room is: MAINTENANCE · WHY (the API's words, cut to the bar).
e2n_maintenance :: (n: [] E2Net, why: string) {
  t: [E2N_SAY] u8; k := wire_put(t[..], 0, "MAINTENANCE");
  if why.count > 0 {
    k = wire_put(t[..], k, " · ");
    for ch: why { if k < E2N_SAY && ch >= 32 && ch < 127 { t[k] = ifx ch >= 'a' && ch <= 'z' then ch - 32 else ch; k += 1; } }
  }
  e2n_tell(n, cast(string) t[0..<k]);
  for i: 0..<k { n[0].full[i] = t[i]; }
  n[0].full_n = k; n[0].full_at = n[0].mono;
}
// A realm instance's name as a player reads it (everglade2-3: ROOM 3), else other.
e2n_room_name :: (t: [] u8, at: int, code: string, other: string) -> int {
  if !e2n_realm_instance(code) { return wire_put(t, at, other); }
  r := E2N_REALM;
  return wire_put(t, wire_put(t, at, "ROOM "), code[r.count + 1..<code.count]);
}
e2n_full_message :: (n: [] E2Net) -> string {
  age := n[0].mono - n[0].full_at;
  return ifx age >= 0 && age < E2N_FULL_MS then cast(string) n[0].full[0..<n[0].full_n] else "";
}
// A seat refused for a kick or a ban. The socket's short waits are for a lost connection; this asks
// again when the kick or ban ends, or every E2N_BAR_ASK_MS when no end was said, and never sooner
// than a minute.
e2n_barred :: (n: [] E2Net, kind: int, until: int) {
  e2n_down(n);
  n[0].barred = kind; n[0].barred_until = ifx until > 0 then until else 0;
  wait := E2N_BAR_ASK_MS;
  if n[0].barred_until > 0 { wait = nc_lo(nc_hi(n[0].barred_until - e2n_now(n), 60000), 6 * 3600000); }
  n[0].retry = n[0].mono + wait;
}
// How long is left, in a player's words: ms rounded up to whole minutes under two hours, whole hours
// under two days, else whole days. Writes at `at`, returns the new end.
e2n_time_left :: (t: [] u8, at: int, ms: int) -> int {
  minutes := (nc_hi(ms, 1) + 59999) / 60000;
  if minutes < 120 { k := wire_int(t, at, minutes); return wire_put(t, k, ifx minutes == 1 then " MINUTE" else " MINUTES"); }
  hours := (minutes + 59) / 60;
  if hours < 48 { k := wire_int(t, at, hours); return wire_put(t, k, " HOURS"); }
  k := wire_int(t, at, (hours + 23) / 24); return wire_put(t, k, " DAYS");
}
// The line over the bar while a kick or a ban holds ("" when none): what happened, and when it ends
// if the refusal said. You keep playing; only the others are gone.
e2n_barred_message :: (n: [] E2Net) -> string {
  if n[0].barred == E2N_BAR_NONE { return ""; }
  t := n[0].barred_text[..];
  k := wire_put(t, 0, ifx n[0].barred == E2N_BAR_BANNED then "THIS ACCOUNT IS BANNED FROM PLAYING WITH OTHERS" else "A MODERATOR REMOVED YOU FROM THIS ROOM");
  left := n[0].barred_until - e2n_now(n);
  if n[0].barred_until > 0 && left > 0 {
    k = wire_put(t, k, ifx n[0].barred == E2N_BAR_BANNED then " FOR" else " · BACK IN");
    k = e2n_time_left(t, k, left);
  }
  return cast(string) t[0..<k];
}
#test "a kick or a ban: the seat ticket's refusal is said over the bar with when it ends, and the page asks again then" {
  n: [1] E2Net; n[0].mono = 5000; n[0].offset = 1000000;   // the wall clock is 1,005,000
  e2n_ticket(n[..], "403\n{\"error\":\"banned\",\"until\":0}");
  #assert n[0].barred == E2N_BAR_BANNED && n[0].barred_until == 0 && n[0].state == E2N_DOWN && n[0].ticket_n == 0 && !n[0].ticket_asked;
  #assert e2n_barred_message(n[..]) == "THIS ACCOUNT IS BANNED FROM PLAYING WITH OTHERS";
  #assert n[0].retry == 5000 + E2N_BAR_ASK_MS;
  // a ban with an end: said in whole minutes, hours or days, and asked again when it ends
  e2n_ticket(n[..], "403\n{\"error\":\"banned\",\"until\":1905000}");   // 15 minutes on
  #assert e2n_barred_message(n[..]) == "THIS ACCOUNT IS BANNED FROM PLAYING WITH OTHERS FOR 15 MINUTES" && n[0].retry == 5000 + 900000;
  n[0].mono += 899000; #assert e2n_barred_message(n[..]) == "THIS ACCOUNT IS BANNED FROM PLAYING WITH OTHERS FOR 1 MINUTE";
  n[0].mono += 2000; #assert e2n_barred_message(n[..]) == "THIS ACCOUNT IS BANNED FROM PLAYING WITH OTHERS";   // its time has passed: the next ask says
  n[0].mono = 5000;
  e2n_ticket(n[..], "403\n{\"error\":\"kicked\",\"until\":87405000}");   // a day on
  #assert n[0].barred == E2N_BAR_KICKED && e2n_barred_message(n[..]) == "A MODERATOR REMOVED YOU FROM THIS ROOM · BACK IN 24 HOURS";
  #assert n[0].retry == 5000 + 6 * 3600000;   // asked again at most six hours on
  e2n_ticket(n[..], "403\n{\"error\":\"kicked\"}");
  #assert e2n_barred_message(n[..]) == "A MODERATOR REMOVED YOU FROM THIS ROOM" && n[0].barred_until == 0;
  e2n_ticket(n[..], "403\n{\"error\":\"banned\",\"until\":1010000}");   // five seconds on: never asked sooner than a minute
  #assert n[0].retry == 5000 + 60000;
  // the times, rounded up: 119 minutes, then hours, then days
  b: [32] u8;
  #assert cast(string) b[0..<e2n_time_left(b[..], 0, 1)] == " 1 MINUTE" && cast(string) b[0..<e2n_time_left(b[..], 0, 60001)] == " 2 MINUTES";
  #assert cast(string) b[0..<e2n_time_left(b[..], 0, 119 * 60000)] == " 119 MINUTES" && cast(string) b[0..<e2n_time_left(b[..], 0, 120 * 60000)] == " 2 HOURS";
  #assert cast(string) b[0..<e2n_time_left(b[..], 0, 47 * 3600000)] == " 47 HOURS" && cast(string) b[0..<e2n_time_left(b[..], 0, 48 * 3600000)] == " 2 DAYS" && cast(string) b[0..<e2n_time_left(b[..], 0, 49 * 3600000)] == " 3 DAYS";
  // any other refusal is not a ban, and a seat ticket lifts the line
  e2n_ticket(n[..], "403\n{\"error\":\"forbidden\"}");
  #assert n[0].barred == E2N_BAR_NONE && e2n_barred_message(n[..]) == "" && n[0].state == E2N_DOWN;
  e2n_ticket(n[..], "403\n{\"error\":\"banned\",\"until\":0}"); #assert n[0].barred == E2N_BAR_BANNED;
  e2n_ticket(n[..], "200\n{\"ticket\":\"t.1\",\"room\":\"everglade2-3\"}");
  #assert n[0].barred == E2N_BAR_NONE && n[0].ticket_n == 3 && e2n_barred_message(n[..]) == "";
}
e2n_name_is :: (n: [] E2Net, name: string) {
  m := 0;
  for ch: name { if m >= NET_NAME { break; } if ch < 32 || ch == 127 { continue; } n[0].name[m] = ch; m += 1; }
  n[0].name_n = m;
}
// Your own name (Character Create's NAME): POST /api/playtest/player/name {name}, with your player key.
// The seat ticket is asked after its answer, so the room's row for you carries it. A shape the page
// already refused is never sent (player-name.coax).
e2n_rename :: (n: [] E2Net, name: string) -> bool {
  if n[0].naming || name.count > PN_MAX { return false; }
  t: [128] u8;
  k := wire_put(t[..], 0, "/api/playtest/player/name\n{\"name\":\"");
  for ch: name { if ch == '"' || ch == '\\' || ch < 32 { return false; } }
  k = wire_put(t[..], k, name); k = wire_put(t[..], k, "\"}");
  if !pipe_put(n[0].pipe[..], E2N_PIPE_NAME, -1, cast(string) t[0..<k]) { return false; }
  n[0].naming = true;
  return true;
}
// Its answer ("STATUS\nBODY"): the name everyone now sees, or the API's refusal (its error, "" none).
E2nNamed :: struct { ok: bool; said: string; }
e2n_named :: (n: [] E2Net, answer: string) -> E2nNamed {
  n[0].naming = false;
  if answer.count > 4 && answer[0..<4] == "200\n" {
    name := net_json_field(answer, "name");
    if name.count > 0 { e2n_name_is(n, name); }
    return E2nNamed.{ok = true};
  }
  return E2nNamed.{said = ifx answer.count > 4 then net_json_field(answer, "error") else ""};
}
#test "your name's POST goes before the seat ticket, and its answer is your name" {
  n: [1] E2Net;
  e2n_facts(n[..], "url=http://127.0.0.1:8946/worlds/character-creator?relay=ws://localhost:8945\nplayer=p-1\n", false);
  #assert e2n_rename(n[..], "Crowd Alpha") && n[0].naming && !e2n_rename(n[..], "Other");
  #assert n[0].pipe[0].n == 1 && n[0].pipe[0].op[0] == E2N_PIPE_NAME;
  #assert pipe_bytes(n[0].pipe[..], 0) == "/api/playtest/player/name\n{\"name\":\"Crowd Alpha\"}";
  // the run starts while it is out: no ticket yet
  n[0].joined = true; pipe_drained(n[0].pipe[..]); e2n_step(n[..], 1000);
  #assert !n[0].ticket_asked;
  r := e2n_named(n[..], "200\n{\"name\":\"Crowd Alpha\",\"account\":false}");
  #assert r.ok && cast(string) n[0].name[0..<n[0].name_n] == "Crowd Alpha";
  e2n_step(n[..], 1016); #assert n[0].ticket_asked;
  // a refusal says the API's words and keeps the name
  q := e2n_named(n[..], "400\n{\"error\":\"pick another name\"}");
  #assert !q.ok && q.said == "pick another name" && cast(string) n[0].name[0..<n[0].name_n] == "Crowd Alpha";
  #assert !e2n_rename(n[..], "A\"b");
}
#test "a seat ticket's answer places you on its shard's room and says your name" {
  n: [1] E2Net;
  e2n_facts(n[..], "url=https://openagents.com/worlds/everglade2\nplayer=p-1\n", false);
  e2n_ticket(n[..], "200\n{\"ticket\":\"abc.def\",\"room\":\"everglade2-3\",\"shard\":4,\"name\":\"Ash Wood\"}");
  #assert cast(string) n[0].ticket[0..<n[0].ticket_n] == "abc.def";
  #assert cast(string) n[0].url[0..<n[0].url_n] == "wss://openagents.com/api/room/s4/relay/everglade/everglade2-3";
  #assert cast(string) n[0].name[0..<n[0].name_n] == "Ash Wood";
  // a room VM's shard: the directory's endpoint, in place of the load balancer's path (#13179)
  v: [1] E2Net;
  e2n_facts(v[..], "url=https://openagents.com/worlds/everglade2\nplayer=p-1\n", false);
  e2n_ticket(v[..], "200\n{\"ticket\":\"abc.def\",\"room\":\"everglade2-3\",\"shard\":2,\"endpoint\":\"wss://room.openagents.com/api/room/s2/\"}");
  #assert cast(string) v[0].url[0..<v[0].url_n] == "wss://room.openagents.com/api/room/s2/relay/everglade/everglade2-3";
  // a check's room: the API's numbered instance of it, on the room server's own path
  l: [1] E2Net;
  e2n_facts(l[..], "url=http://127.0.0.1:8863/worlds/character-creator?relay=ws://localhost:8945&room=pair-e2-ab\n", false);
  e2n_ticket(l[..], "200\n{\"ticket\":\"t1\",\"room\":\"pair-e2-ab-1\"}");
  #assert cast(string) l[0].url[0..<l[0].url_n] == "ws://localhost:8945/api/room/relay/everglade/pair-e2-ab-1";
  // a refusal: no ticket, and the next ask waits
  m: [1] E2Net; e2n_ticket(m[..], "503\n{}"); #assert m[0].ticket_n == 0 && m[0].state == E2N_DOWN && m[0].tries == 1;
}
#test "a full room is said: the room you asked, its size and the room the directory placed you in (#13263)" {
  n: [1] E2Net; n[0].mono = 5000;
  e2n_facts(n[..], "url=https://openagents.com/worlds/everglade2\nplayer=p-1\n", false);
  #assert e2n_full_message(n[..]) == "";
  e2n_ticket(n[..], "200\n{\"ticket\":\"t\",\"room\":\"everglade2-5\",\"shard\":1,\"full\":true,\"asked\":\"everglade2-3\"}");
  #assert e2n_full_message(n[..]) == "ROOM 3 HAS 16 PLAYERS · JOINING ROOM 5";
  n[0].mono += E2N_FULL_MS; #assert e2n_full_message(n[..]) == "";
  // a room not full says nothing
  q: [1] E2Net; e2n_ticket(q[..], "200\n{\"ticket\":\"t\",\"room\":\"everglade2-5\",\"shard\":1}"); #assert e2n_full_message(q[..]) == "";
  // every room full: the page waits and asks again
  w: [1] E2Net; e2n_ticket(w[..], "503\n{\"error\":\"every room is full: try again in a minute\",\"waiting\":3,\"retry_ms\":20000}");
  #assert e2n_full_message(w[..]) == "EVERY ROOM HAS 16 PLAYERS · TRYING AGAIN" && w[0].state == E2N_DOWN;
  // maintenance: the API's words of why, over the bar; the page waits and asks again
  m: [1] E2Net; e2n_ticket(m[..], "503\n{\"error\":\"maintenance: A new release\",\"maintenance\":\"A new release\",\"until_ms\":0,\"retry_ms\":30000}");
  #assert e2n_full_message(m[..]) == "MAINTENANCE · A NEW RELEASE" && m[0].state == E2N_DOWN;
  m2: [1] E2Net; e2n_ticket(m2[..], "503\n{\"error\":\"maintenance\",\"maintenance\":\"\",\"until_ms\":1762990000000,\"retry_ms\":30000}");
  #assert e2n_full_message(m2[..]) == "MAINTENANCE";
  m3: [1] E2Net; e2n_ticket(m3[..], "503\n{\"error\":\"x\",\"maintenance\":\"Moving every room to the new release, back in ten minutes\",\"until_ms\":0,\"retry_ms\":30000}");
  #assert e2n_full_message(m3[..]).count == E2N_SAY && m3[0].state == E2N_DOWN;
}

// ---- the socket

e2n_opened :: (n: [] E2Net, id: int) { if id < 0 { e2n_down(n); return; } n[0].sock = id; }
// Closed: everyone else goes (nothing is drawn that the room isn't saying) and the socket is tried
// again after a wait that doubles to a minute, 75% to 125% of it, so a restarted room's pages spread.
e2n_down :: (n: [] E2Net) {
  if n[0].seat >= 0 && n[0].lost_at == 0 { n[0].lost_at = ifx n[0].mono > 0 then n[0].mono else 1; }
  _ := net_action_rejoin(n[0].acts[..], n[0].mono);   // what waited on this socket's room will never be answered
  e2o_forget(n[0].own[..]);   // your record is the room's to say: none while it isn't saying it
  n[0].state = E2N_DOWN; n[0].sock = -1; n[0].seat = -1; n[0].rest_known = false; n[0].kit_known = false; n[0].aid_left = -1; n[0].aid_at = -100000; n[0].familiar_at=-100000;
  n[0].tries += 1;
  wait := 1000;
  for q: 0..<nc_lo(n[0].tries - 1, 6) { wait *= 2; }
  wait = nc_lo(wait, 60000);
  j := ((n[0].mono * 7919 + n[0].tries * 104729 + n[0].pid_n * 31) % 1000 + 1000) % 1000;
  n[0].retry = n[0].mono + wait * 3 / 4 + wait * j / 2000;
  e2n_clear_familiars(n);
  for e: 0..<E2N_ENTS { n[0].ents[e].live = false; }
  wire_mirror_forget(n[0].mir[..]);
  n[0].pred[0].due = false; n[0].off[0] = NetCorrect.{}; n[0].ticks = 0;
}
// A socket event (message 256 + 4 id + event): true when it was this room's.
e2n_event :: (n: [] E2Net, kind: int, text: string) -> bool {
  ev := socket_event(kind);
  if ev.id < 0 || ev.id != n[0].sock { return false; }
  if ev.event == SOCKET_OPENED { n[0].state = E2N_OPEN; n[0].tries = 0; n[0].ping_n = 0; n[0].ping_at = 0; _ := net_conn_opened(n[0].link[..], ev.id, text); return true; }
  if ev.event == SOCKET_ERROR && text.count > 0 && n[0].state == E2N_OPEN { return true; }   // a frame over the inbox: dropped
  if ev.event == SOCKET_CLOSED || ev.event == SOCKET_ERROR {
    if n[0].seat >= 0 { n[0].lost = true; e2n_tell(n, "LOST THE ROOM · REJOINING"); }
    if n[0].state == E2N_OPENING && n[0].direct { n[0].direct_blocked = true; }   // (WebTransport's own fallback was tried first, room-wt.js)
    e2n_down(n); return true;
  }
  if ev.event == SOCKET_FRAME { n[0].frames_in += 1; n[0].bytes_in += text.count; net_stats_in(n[0].stats[..], text.count, text.count > 0 && text[0] == 'D', n[0].mono); e2n_record(n, text); }
  return true;
}
// The entity with id eid, made when new (make); -1 none.
e2n_ent :: (n: [] E2Net, eid: int, make: bool) -> int {
  free := -1;
  for e: 0..<E2N_ENTS {
    if n[0].ents[e].live && n[0].ents[e].eid == eid { return e; }
    if !n[0].ents[e].live && free < 0 { free = e; }
  }
  if !make || free < 0 { return -1; }
  n[0].ents[free] = NetEnt.{live = true, eid = eid, born = n[0].tick_t};
  return free;
}
e2n_tick_t :: (n: [] E2Net, tick: int) -> int {
  if n[0].worlds == 0 || n[0].hz <= 0 { return e2n_now(n); }
  return n[0].w_t + (tick - n[0].w_tick) * 1000 / n[0].hz;
}
// One frame from the room.
e2n_record :: (n: [] E2Net, t: string) {
  if t.count < 1 { return; }
  if net_conn_note(n[0].link[..], t) { return; }   // the room's word on a WebTransport link (?net)
  if t.count > 2 && t[1] == ' ' && (t[0] == 'a' || t[0] == 'd') { e2n_shot_word(n, t); return; }   // an arrow loosed or ended
  if wire_is(t,"m2") { e2n_familiar_snapshot(n,t); return; }
  if wire_is(t,"m8") {
    rd:=[1]WireRd.[wire_rd(t,2)];
    mode:=wire_num(t,rd[..]);
    if rd[0].ok && !wire_more(t,rd[..]) && e2n_open(n) && mode>=0 && mode<=2 { n[0].familiar_sense=mode; }
    return;
  }
  step:=wire_is(t,"m5"); heal:=wire_is(t,"m6"); sense:=wire_is(t,"m7");
  if step || heal || sense || wire_is(t,"m4") {
    rd:=[1]WireRd.[wire_rd(t,2)];
    seq:=wire_num(t,rd[..]); order:=ifx sense then 6 else ifx heal then 5 else ifx step then 4 else wire_num(t,rd[..]);
    if rd[0].ok && !wire_more(t,rd[..]) && e2n_open(n) && seq==n[0].familiar_seq && order>0 && (step || heal || sense || order<=3) && order==n[0].familiar_order {
      n[0].familiar_ok=true; n[0].familiar_at=n[0].mono;
      if heal { n[0].familiar_heal_cue=true; }
    }
    return;
  }
  if wire_is(t,"m3") {
    rd:=[1]WireRd.[wire_rd(t,2)];
    seq:=wire_num(t,rd[..]); status:=wire_num(t,rd[..]);
    if rd[0].ok && !wire_more(t,rd[..]) && e2n_open(n) && n[0].klass==FB_CL_WIZARD &&
      n[0].familiar_order==0 && seq==n[0].familiar_seq && seq>4000000 && status>=1 && status<=3 {
      n[0].familiar_cast=status; n[0].familiar_at=n[0].mono;
    }
    return;
  }
  if wire_is(t,"m1") {
    rd:=[1]WireRd.[wire_rd(t,2)];
    seq:=wire_num(t,rd[..]); form:=wire_num(t,rd[..]);
    if rd[0].ok && !wire_more(t,rd[..]) && e2n_open(n) && n[0].familiar_order==0 && seq==n[0].familiar_seq && seq>4000000 && form>=0 && form<RS_FAMILIAR_FORMS.count {
      n[0].familiar_ok=true; n[0].familiar_at=n[0].mono;
    }
    return;
  }
  if wire_is(t,"u1") {
    used:=egk_used_read(t);
    if used.ok && e2n_open(n) && used.seq==n[0].aid_seq && used.seq>3000000 {
      n[0].aid_left=used.left; n[0].aid_ok=true; n[0].aid_at=n[0].mono;
    }
    return;
  }
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  if !r[0].ok { return; }
  c := t[0];
  if c == RLW_YOU {
    you := rlw_read(t);
    if !you.ok { return; }
    seat := you.seat; clock := you.clock;
    e2n_clear_familiars(n);
    n[0].seat = seat; n[0].sat = true; n[0].rest_known = false; n[0].kit_known = false; n[0].aid_left = -1; n[0].aid_at = -100000; n[0].familiar_at=-100000;
    n[0].again = n[0].sat_before; n[0].sat_before = true; n[0].back_pending = n[0].again;
    wire_mirror_forget(n[0].mir[..]);
    n[0].shot_ids[0] = NetSeen.{}; n[0].end_ids[0] = NetSeen.{};
    for e: 0..<E2N_ENTS { n[0].ents[e].live = false; }
    if n[0].lost { n[0].lost = false; e2n_tell(n, "BACK IN THE ROOM"); }
    if clock > 0 && n[0].synced < 2 { n[0].offset = clock - n[0].mono; n[0].synced = 1; }
    n[0].hello_due = true; n[0].change_due = false; net_predict_rejoin(n[0].pred[..]);
    return;
  }
  if c == RLW_PONG {
    pong := rlw_read(t);
    sent := pong.sent; clock := pong.clock;
    if !pong.ok || sent > n[0].mono || sent <= 0 { return; }
    rtt := n[0].mono - sent;
    q := n[0].pings % NET_PINGS;
    n[0].ping_rtt[q] = rtt; n[0].ping_off[q] = clock + rtt / 2 - n[0].mono;
    n[0].pings += 1;
    n[0].offset = n[0].ping_off[net_ping_best(n[0].ping_rtt[..], n[0].pings)]; n[0].synced = 2;
    return;
  }
  if c == 'W' {
    w := wire_read_world(t, r[..]);
    if !r[0].ok { return; }
    n[0].w_tick = w.tick; n[0].w_t = e2n_now(n); n[0].hz = nc_clamp(w.hz, 1, 120); n[0].worlds += 1; n[0].w_day = w.day;
    return;
  }
  if c == 'D' {
    d := wire_read_d(t, r[..]);
    if !r[0].ok { return; }
    // out of band (a WebTransport seat's outcomes on the combat stream): its entries, nothing of the tick
    if (d.f & WIRE_F_OOB) != 0 { for k: 0..<wire_entries(t, r[0].at) { e2n_entry(n, wire_entry(t, r[0].at, k), d); } return; }
    net_conn_ack(n[0].link[..], d.ack); net_conn_tick(n[0].link[..], d.tick, (d.f & 1) != 0);
    clock := e2n_tick_t(n, d.tick);
    if d.part == 0 && (d.tick != n[0].tick || n[0].ticks == 0) {
      j := net_jitter_heard(NetJitter.{late_mean = n[0].late_mean, jitter = n[0].jitter, interval = n[0].interval}, n[0].ticks, e2n_now(n), clock, n[0].tick_t);
      n[0].late_mean = j.late_mean; n[0].jitter = j.jitter; n[0].interval = j.interval;
      f := net_map_follow(n[0].late_mean, n[0].ticks); n[0].w_t += f; n[0].late_mean -= f32(f);   // the tick map follows a drift (everglade/client/net-core.coax)
      n[0].delay = net_jitter_delay(j);
      n[0].ticks += 1;
    }
    n[0].tick = d.tick; n[0].tick_t = clock;
    _ := wire_mirror_d(n[0].mir[..], d);
    from := r[0].at;
    rows := 0; row_b := 0;
    for k: 0..<wire_entries(t, from) {
      en := wire_entry(t, from, k);
      if (en.count > 1 && en[0] == 's' && en[1] == ' ') || (en.count > 1 && en[0] == 'S') { rows += 1; row_b += en.count + 1; }   // the ?net overlay's ROWS (#13165)
      e2n_entry(n, en, d);
    }
    net_stats_rows(n[0].stats[..], rows, row_b);
    wire_mirror_end(n[0].mir[..], d);
    if (d.f & 1) != 0 && (d.f & 2) == 0 {
      // a whole snapshot: whoever it doesn't hold has gone
      // (a familiar is not a row yet: m2's whole list says which are gone, e2n_familiar_snapshot)
      for e: 0..<E2N_ENTS { if n[0].ents[e].live && n[0].ents[e].kind != E2N_ENT_FAMILIAR && n[0].ents[e].seen != d.tick { n[0].ents[e].live = false; } }
    }
    return;
  }
  if c == 'b' {   // your bar's counts and effects, as the room's rules hold them
    w := wire_read_kit(t, r[..]);
    if !r[0].ok || n[0].seat < 0 { return; }
    n[0].kit[0] = w; n[0].kit_known = true;
    return;
  }
  if c == 'z' {   // your rest, as the room's rules hold it
    z := wire_read_rest_state(t, r[..]);
    if !r[0].ok || n[0].seat < 0 || z.seq < 0 || z.code < 0 || z.code >= WIRE_REST_CODES || z.dice < 0 || z.dice > 20 { return; }
    n[0].rest_known = true; n[0].rest_code = z.code; n[0].rest_dice = z.dice;
    if z.seq > 0 && net_action_confirm(n[0].acts[..], z.seq, n[0].mono) == E2N_ACT_REST && z.seq == n[0].rest_seq { n[0].rest_refused_at = -100000; }
    return;
  }
  if c == 'r' {
    seq := wire_num(t, r[..]);
    why := wire_word(t, r[..]);
    if why == WIRE_REFUSE_VERSION { n[0].stale = true; n[0].want = false; e2n_tell(n, "A NEW VERSION IS OUT · RELOAD THE PAGE"); return; }
    if why == WIRE_REFUSE_ELSEWHERE { n[0].elsewhere = true; n[0].want = false; e2n_tell(n, "YOU'RE PLAYING ELSEWHERE · RELOAD TO PLAY HERE"); return; }
    if why == WIRE_REFUSE_RESTARTING {
      if n[0].sock >= 0 { _ := pipe_close(n[0].pipe[..], n[0].sock); }
      e2n_tell(n, "RESTARTING · BACK IN A MOMENT"); n[0].ticket_n = 0; n[0].tries = 0; e2n_down(n);
      return;
    }
    if r[0].ok && why=="familiar" && seq==n[0].familiar_seq && seq>4000000 {
      n[0].familiar_ok=false; n[0].familiar_cast=3; n[0].familiar_at=n[0].mono; return;
    }
    if r[0].ok && why=="kit" && seq==n[0].aid_seq && seq>3000000 {
      n[0].aid_ok=false; n[0].aid_at=n[0].mono; return;
    }
    if !r[0].ok || why.count == 0 { return; }
    // a request of yours the ledger still holds open, refused once; what is said is your latest one's
    kind := net_action_refuse(n[0].acts[..], seq, 0, n[0].mono);
    if kind == E2N_ACT_REST && seq == n[0].rest_seq { n[0].rest_refused += 1; n[0].rest_refused_at = n[0].mono; return; }
    if kind == E2N_ACT_CAST && seq == n[0].cast_seq {
      n[0].cast_refused += 1; n[0].cast_said=e2n_cast_reason(why); n[0].cast_said_at=n[0].mono;
    }   // your last cast, turned down (slot, cooldown, range, sight, aim)
    return;
  }
}
// One entry of a state (D): a row (s), who a seat is (n), your link (k), one gone (x).
e2n_entry :: (n: [] E2Net, t: string, d: WireD) {
  if t.count < 1 { return; }
  r: [1] WireRd; r[0] = wire_rd(t, 1);
  c := t[0];
  if c == 's' || c == 'S' {   // a row, as text or packed (everglade-wire.coax, #13165)
    e := wire_mirror_s(n[0].mir[..], d.tick, t);
    if e >= 0 { e2n_row(n, wire_mirror_get(n[0].mir[..], e), d); }
    return;
  }
  if c == 'n' {
    w := wire_read_n(t, r[..]);
    if !r[0].ok || w.ss < 0 { return; }
    k := e2n_ent(n, w.ss, true);
    if k < 0 { return; }
    en := n[0].ents[k..<k + 1];
    if en[0].ring_n == 0 { en[0].kind = WK_PLAYER; en[0].owner = w.ss; }
    en[0].seat = w.ss; en[0].seen = d.tick;
    en[0].id_n = net_copy(en[0].id[..], w.id);
    en[0].look_n = net_copy(en[0].look[..], w.look);
    n[0].ent_class[k] = fb_cl_of_kind(w.kind);
    // yours: the class and level the room says (#13259), not told back to it; not while your own change waits to go
    sc := fb_cl_of_kind(w.kind); sl := xk_level(fb_cl_level_of_kind(w.kind));
    if w.ss == n[0].seat && sc >= 0 && !n[0].change_due && (sc != n[0].klass || sl != n[0].level) {
      n[0].klass = sc; n[0].level = sl; n[0].kit_known = false; n[0].aid_left = -1; n[0].aid_at = -100000; n[0].served = true;
    }
    nm := 0;
    for ch: w.name { if nm >= NET_NAME { break; } if ch < 32 { continue; } en[0].name[nm] = ch; nm += 1; }
    en[0].name_n = nm;
    return;
  }
  if c == 'e' && wire_own(t) >= 0 {   // your character's record, aimed at your seat (everglade/client/own.coax)
    what := wire_own(t);
    r[0] = wire_rd(t, WIRE_OWN[what].count);
    w := wire_read_own(t, r[..], what);
    if !r[0].ok || wire_more(t, r[..]) || w.ss != n[0].seat { return; }
    e2o_entry(n[0].own[..], what, w);
    return;
  }
  if c == 'e' && (wire_is(t, "e xp") || wire_is(t, "e level")) {   // aimed at your seat: counted (everglade/client/track.coax)
    xp := wire_is(t, "e xp");
    r[0] = wire_rd(t, ifx xp then 4 else 7);
    g := wire_read_gain(t, r[..]); ss := g.ss; v := g.v;
    if !r[0].ok || ss != n[0].seat || v < 0 || v > 1000000 { return; }
    if xp { n[0].xp_n += v; } else { n[0].level_got = v; }
    return;
  }
  if c == 'e' && wire_is(t, EGC_MON_E) { e2n_mon_hit(n, t); return; }
  if c == 'e' && wire_is(t, EGC_GUARD_E) { e2n_guard_hit(n, t); return; }
  if c == 'e' && wire_is(t, "e cast") {
    r[0] = wire_rd(t, 6);
    ce := wire_read_cast_e(t, r[..]);
    if !r[0].ok || ce.ss < 0 || !xk_entry(xk_slot_class(ce.slot), ce.slot).ok { return; }
    if ce.ss == n[0].seat {   // yours, taken: it plays now (metaverse-engine/action/deed.coax: nothing plays before the room says yes)
      n[0].mine_cast = E2nCast.{live = true, ss = ce.ss, slot = ce.slot, ax = ce.ax, ay = ce.ay, az = ce.az, seed = ce.seed, t = n[0].tick_t};
      _ := net_action_confirm(n[0].acts[..], net_action_oldest(n[0].acts[..], E2N_ACT_CAST).seq, n[0].mono);   // the room takes your casts in order
      n[0].cast_mine += 1; return;
    }
    n[0].cast_heard += 1;
    q := 0; old := 0;
    for i: 0..<E2N_CASTS { if !n[0].casts[i].live { q = i; old = -1; break; } if n[0].casts[i].t < n[0].casts[old].t { old = i; } }
    if old >= 0 { q = old; }   // all waiting: the oldest gives way
    n[0].casts[q] = E2nCast.{live = true, ss = ce.ss, slot = ce.slot, ax = ce.ax, ay = ce.ay, az = ce.az, seed = ce.seed, t = n[0].tick_t};
    return;
  }
  if c == 'k' {   // the room's word on your link: the ?net overlay's BUDGET and DROP (#13178)
    l := wire_read_link(t, r[..]);
    if r[0].ok { net_stats_link(n[0].stats[..], l.rate, l.used, l.dropped, l.every); }
    return;
  }
  if c == 'x' {
    id := wire_num(t, r[..]);
    if !r[0].ok { return; }
    _ := wire_mirror_x(n[0].mir[..], id);
    k := e2n_ent(n, id, false);
    if k >= 0 { n[0].ents[k].live = false; }
    return;
  }
}
// A row the mirror took: a player, a monster or the guard into the page's one list of entities, its
// state into the engine's ring (metaverse-engine/net/interp.coax). A new LIFE or a WARP starts its ring again,
// so nothing is drawn between the last life and this one.
e2n_row :: (n: [] E2Net, w: WireS, d: WireD) {
  creature := w.kind == WK_MONSTER || w.kind == WK_GUARD;
  if w.id < 0 || (w.kind != WK_PLAYER && !creature) { return; }
  if w.kind == WK_MONSTER && (w.id != WIRE_ID_MADE + WIRE_MON_EID + w.p1 || w.p1 < 0 || w.p1 >= E2N_MONS) { return; }
  if w.kind == WK_GUARD && w.id != WIRE_ID_MADE + WIRE_GUARD_EID { return; }
  k := e2n_ent(n, w.id, true);
  if k < 0 { return; }
  en := n[0].ents[k..<k + 1];
  if en[0].ring_n > 0 && (w.life != en[0].life || w.warp != en[0].warp) { en[0].ring_n = 0; en[0].born = n[0].tick_t; }
  // the guard you hurt fell: counted once, as his row first says so (everglade/client/track.coax)
  if w.kind == WK_GUARD && w.g == 3 && !(en[0].ring_n > 0 && en[0].ring[en[0].ring_n - 1].f == 3) && n[0].mine[E2N_MONS] { n[0].fell_n[E2N_FOE_GUARD] += 1; n[0].mine[E2N_MONS] = false; }
  en[0].life = w.life; en[0].warp = w.warp; en[0].kind = w.kind; en[0].seen = d.tick; en[0].hp = w.hp; en[0].max = w.max;
  if creature {
    // its state and its act ride its ring with its place, so each is drawn at the moment the room names
    // (a monster's flags: its state, its act above it; its ring's a: the tick the act began, the guard's last swing)
    en[0].owner = w.owner; en[0].p1 = w.p1; en[0].p2 = w.p2; en[0].t0 = w.t0;
    net_push_row(en, NetState.{t = n[0].tick_t, x = w.x, y = w.y, z = w.z, yaw = w.yaw, vx = w.vx, vy = w.vy, vz = w.vz,
                               f = ifx w.kind == WK_MONSTER then (w.g & E2N_MON_STATE) | (w.clip << E2N_MON_ACT) else w.g, a = w.t0}, n[0].hz);
    if en[0].ring_n == 1 { en[0].shown = en[0].ring[0]; }
    return;
  }
  en[0].seat = w.id;
  net_push_row(en, NetState.{t = n[0].tick_t, x = w.x, y = w.y, z = w.z, yaw = w.yaw, vx = w.vx, vy = w.vy, vz = w.vz, f = w.g, a = w.clip}, n[0].hz);
  if en[0].ring_n == 1 { en[0].shown = en[0].ring[0]; }
  if w.id == n[0].seat && net_predict_heard(n[0].pred[..], d.ack) {
    held: [NET_MOVE_WORDS] int;
    jumped := net_predict_held(n[0].pred[..], d.ack, held[..]) == NET_MOVE_WORDS && net_move_of(held[..]).jump;
    n[0].fix = NetFix.{ok = true, ack = d.ack, x = w.x, y = w.y, z = w.z, yaw = w.yaw, vx = w.vx, vy = w.vy, vz = w.vz,
                       ground = (w.g & WG_GROUND) != 0, carry = w.carry, jump = jumped};
  }
}

// ---- your inputs and the server's word on you

// An input as the wire carries it (sticks in whole hundredths, the heading in WIRE_FINE units), so the
// page steps what the room steps.
e2n_as_sent :: (m: EgMoveIn) -> EgMoveIn {
  theta := f32(wire_fine(m.theta)) / f32(WIRE_FINE);
  return EgMoveIn.{key_x = f32(wire_axis(m.key_x)) / 100, key_y = f32(wire_axis(m.key_y)) / 100, pad_x = f32(wire_axis(m.pad_x)) / 100,
                   pad_y = f32(wire_axis(m.pad_y)) / 100, run = m.run, jump = m.jump, theta = theta};
}
// One step's input: kept for the re-run (metaverse-engine/net/predict.coax) and sent (I). Its sequence number, 0 with no room.
e2n_input :: (n: [] E2Net, input: EgMoveIn) -> int {
  if !e2n_open(n) { return 0; }
  words: [NET_MOVE_WORDS] int; net_move_words(input, words[..]);
  seq := net_predict_input(n[0].pred[..], words[..]);
  b := (ifx input.run then WB_RUN else 0) | (ifx input.jump then WB_JUMP else 0);
  m := wire_put_in(n[0].out[..], 0, WireIn.{seq = seq, kx = wire_axis(input.key_x), ky = wire_axis(input.key_y), px = wire_axis(input.pad_x), py = wire_axis(input.pad_y), theta = input.theta, b = b, heard = n[0].mir[0].heard});
  // a datagram that repeats what the room hasn't acknowledged (on a WebSocket, the frame alone)
  if n[0].state == E2N_OPEN && n[0].sock >= 0 { e2n_pipe(n, net_conn_input(n[0].link[..], seq, cast(string) n[0].out[0..<m], n[0].wout[..])); }
  return seq;
}
e2n_fix_due :: (n: [] E2Net) -> bool { return e2n_open(n) && net_predict_due(n[0].pred[..]) && n[0].fix.ok; }
// The k-th input the room hasn't stepped, oldest first, as the wire carried it: what the re-run steps.
e2n_replay_input :: (n: [] E2Net, k: int) -> EgMoveIn {
  w: [NET_MOVE_WORDS] int;
  if net_predict_take(n[0].pred[..], k, w[..]) != NET_MOVE_WORDS { return EgMoveIn.{}; }
  return e2n_as_sent(net_move_of(w[..]));
}
// The re-run is done: (dx, dy, dz) is where it puts you less where you were drawn; the engine eases it
// out, or past NET_SNAP m takes it at once. The page's own counts of it are kept here.
e2n_fixed :: (n: [] E2Net, dx: f32, dy: f32, dz: f32) {
  net_predict_done(n[0].pred[..]); n[0].fix_sq = dx * dx + dy * dy + dz * dz;
  net_stats_fix(n[0].stats[..], cast(int)(sqrt(n[0].fix_sq) * 1000), n[0].mono);
  if n[0].back_pending { n[0].back_pending = false; n[0].back_fix_mm = cast(int)(sqrt(dx * dx + dz * dz) * 1000); n[0].back_ms = ifx n[0].lost_at > 0 then n[0].mono - n[0].lost_at else -1; n[0].lost_at = 0; }
  net_correct_take(n[0].off[..], dx, dy, dz);
}
#test "your inputs go as the wire carries them and the re-run takes those the room hasn't stepped" {
  n: [1] E2Net; n[0].state = E2N_OPEN; n[0].sock = 1; n[0].seat = 2;
  for i: 0..<5 { _ := e2n_input(n[..], EgMoveIn.{key_y = 1, run = true, theta = 0.123456}); }
  #assert n[0].pred[0].seq == 5 && n[0].pipe[0].n == 5;
  n[0].fix = NetFix.{ok = true, ack = 3}; #assert net_predict_heard(n[0].pred[..], 3);
  #assert e2n_fix_due(n[..]) && net_predict_pending(n[0].pred[..]) == 2;
  m := e2n_replay_input(n[..], 1); #assert m.key_y == 1 && m.run && abs(m.theta - 0.1235) < 0.0001;
  e2n_fixed(n[..], 0.1, 0, 0); #assert !e2n_fix_due(n[..]) && abs(n[0].off[0].x + 0.1) < 0.0001 && n[0].pred[0].replays == 1;
  e2n_fixed(n[..], 5, 0, 0); #assert n[0].off[0].x == 0;   // a jump of metres is taken at once
}
#test "on WebTransport your inputs go as datagrams that repeat the unacknowledged, casts on the combat stream, outcomes out of band; on a WebSocket every byte is as before (#13176)" {
  n: [1] E2Net; n[0].state = E2N_OPEN; n[0].sock = 1; n[0].seat = 2;
  #assert e2n_event(n[..], SOCKET_KIND + 4 + SOCKET_OPENED, "wt") && n[0].link[0].kind == NET_WT;
  n[0].seat = 2;
  for i: 0..<3 { _ := e2n_input(n[..], EgMoveIn.{key_y = 1}); }
  d := pipe_bytes(n[0].pipe[..], 2);
  #assert d[0] == NET_MARK + NET_DATAGRAM && net_bundle_count(d[1..<d.count]) == 3 && net_bundle_frame(d[1..<d.count], 2)[0..<4] == "I 3 ";
  // (a held stick: the owed ones the same but their numbers, one byte each, made whole by the room)
  xb: [96] u8; #assert net_bundle_frame(d[1..<d.count], 0) == NET_SAME && net_bundle_expand(d[1..<d.count], 0, xb[..])[0..<4] == "I 1 ";
  // the room stepped 2: the next datagram repeats only 3
  e2n_record(n[..], "D 40 2 0 0 ");
  _2 := e2n_input(n[..], EgMoveIn.{key_y = 1});
  d = pipe_bytes(n[0].pipe[..], 3);
  #assert net_bundle_count(d[1..<d.count]) == 2 && net_bundle_expand(d[1..<d.count], 0, xb[..])[0..<4] == "I 3 " && n[0].link[0].ticks == 1;
  // a cast: in a datagram with the inputs still owed, and on the combat stream
  #assert e2n_cast(n[..], 128, 0, 1, -40) && pipe_bytes(n[0].pipe[..], 4)[0] == NET_MARK + NET_DATAGRAM && pipe_bytes(n[0].pipe[..], 5)[0] == NET_MARK + NET_COMBAT && pipe_bytes(n[0].pipe[..], 5)[1] == 'C';
  cd := pipe_bytes(n[0].pipe[..], 4); #assert net_bundle_count(cd[1..<cd.count]) == 3 && net_bundle_frame(cd[1..<cd.count], 2)[0..<2] == "C ";
  _5 := e2n_input(n[..], EgMoveIn.{key_y = 1});
  cd = pipe_bytes(n[0].pipe[..], 6); #assert net_bundle_count(cd[1..<cd.count]) == 4 && net_bundle_frame(cd[1..<cd.count], 2)[0..<2] == "C " && net_bundle_frame(cd[1..<cd.count], 3)[0..<4] == "I 5 ";
  // an out-of-band D: its entries, nothing of the tick (not heard, not a gap)
  e2n_record(n[..], "D 45 2 4 0 n 3 - ranger.0.0.0 druid 0 Ash");
  #assert n[0].tick == 40 && n[0].link[0].ticks == 1 && n[0].mir[0].heard == 40;
  e2n_record(n[..], "nq 5 1 2"); #assert n[0].link[0].stale == 5 && n[0].link[0].lost == 2;
  // a WebSocket's: the frames themselves
  w: [1] E2Net; w[0].state = E2N_OPEN; w[0].sock = 1; w[0].seat = 2;
  #assert e2n_event(w[..], SOCKET_KIND + 4 + SOCKET_OPENED, "") && w[0].link[0].kind == NET_WS;
  w[0].seat = 2;
  _3 := e2n_input(w[..], EgMoveIn.{key_y = 1}); _4 := e2n_input(w[..], EgMoveIn.{key_y = 1});
  #assert pipe_bytes(w[0].pipe[..], 1)[0..<4] == "I 2 " && net_bundle_count(pipe_bytes(w[0].pipe[..], 1)) == 1;
  #assert e2n_cast(w[..], 128, 0, 1, -40) && pipe_bytes(w[0].pipe[..], 2)[0] == 'C';
  // ?transport= picks it; the URL the host opens says so
  q: [1] E2Net; e2n_facts(q[..], "url=http://127.0.0.1:8863/worlds/everglade2?relay=ws://localhost:8930&transport=wt\n", false); #assert e2n_wt(q[..]);
  e2n_facts(q[..], "url=http://127.0.0.1:8863/worlds/everglade2?relay=ws://localhost:8930&transport=ws\n", false); #assert !e2n_wt(q[..]);
  e2n_facts(q[..], "url=http://127.0.0.1:8863/worlds/everglade2?relay=ws://localhost:8930\n", false); #assert !e2n_wt(q[..]);   // no shard endpoint: the WebSocket
  // with neither, the default on a shard's own endpoint, and not on the load balancer's path
  p: [1] E2Net; p[0].want = true;
  e2n_facts(p[..], "url=https://openagents.com/worlds/everglade2\n", false);
  e2n_ticket(p[..], "200\n{\"ticket\":\"abc.def\",\"room\":\"everglade2-3\",\"shard\":2,\"endpoint\":\"wss://room.openagents.com:4432/api/room/s2/\"}");
  #assert p[0].direct && e2n_wt(p[..]) == E2N_WT_DEFAULT;
  e2n_ticket(p[..], "200\n{\"ticket\":\"abc.def\",\"room\":\"everglade2-3\",\"shard\":2}");
  #assert !p[0].direct && !e2n_wt(p[..]);
  // a shard's own endpoint that never opens (its port blocked, both ways): the load balancer's path after
  e2n_ticket(p[..], "200\n{\"ticket\":\"abc.def\",\"room\":\"everglade2-3\",\"shard\":2,\"endpoint\":\"wss://room.openagents.com:4432/api/room/s2/\"}");
  p[0].state = E2N_OPENING; p[0].sock = 3;
  #assert e2n_event(p[..], SOCKET_KIND + 3 * 4 + SOCKET_CLOSED, "") && p[0].direct_blocked && p[0].state == E2N_DOWN;
  e2n_ticket(p[..], "200\n{\"ticket\":\"abc.def\",\"room\":\"everglade2-3\",\"shard\":2,\"endpoint\":\"wss://room.openagents.com:4432/api/room/s2/\"}");
  #assert !p[0].direct && cast(string) p[0].url[0..<p[0].url_n] == "wss://openagents.com/api/room/s2/relay/everglade/everglade2-3";
}

// ---- each frame

// The clock, the socket, a ping, the hello, the others where they are drawn. Joins only once you
// joined (the run began).
e2n_step :: (n: [] E2Net, mono: int) {
  n[0].mono = mono;
  _ := net_action_expire(n[0].acts[..], mono, E2N_ACT_WAIT_MS);
  if n[0].want && n[0].joined && (n[0].state == E2N_OFF || (n[0].state == E2N_DOWN && mono >= n[0].retry)) {
    if n[0].ticket_n > 0 {
      u: [NET_URL + NET_TICKET + 9] u8;
      k := wire_put(u[..], 0, cast(string) n[0].url[0..<n[0].url_n]);
      k = wire_put(u[..], k, "?t="); k = wire_put(u[..], k, cast(string) n[0].ticket[0..<n[0].ticket_n]);
      if n[0].lost { k = wire_put(u[..], k, "&re=1"); }
      w: [NET_URL + NET_TICKET + 12] u8;
      if pipe_open(n[0].pipe[..], net_conn_url(w[..], cast(string) u[0..<k], e2n_wt(n))) { n[0].state = E2N_OPENING; n[0].sock = -1; n[0].ticket_n = 0; }
    } else if !n[0].ticket_asked && !n[0].naming { e2n_ask_ticket(n); }
  }
  if e2n_open(n) {
    if n[0].ping_at == 0 || mono - n[0].ping_at >= (ifx n[0].ping_n < 8 then 1000 else 10000) {
      m := rlw_put_ping(n[0].out[..], mono);
      e2n_send(n, m);
      n[0].ping_at = mono; n[0].ping_n += 1;
    }
    if n[0].hello_due { e2n_hello(n); }
  }
  dt := f32(nc_clamp(mono - n[0].drawn_at, 0, 100)) / 1000; n[0].drawn_at = mono;
  n[0].lag = net_lag_step(n[0].lag, n[0].delay, n[0].ticks, dt);
  rt := e2n_now(n) - cast(int) n[0].lag; n[0].rt = rt;
  for e: 0..<E2N_ENTS {
    en := n[0].ents[e..<e + 1];
    if !en[0].live || en[0].ring_n == 0 { continue; }
    p := net_state_at(en, rt);
    net_ease(en, p, rt, dt);
    p.x += en[0].ease[0].x; p.y += en[0].ease[0].y; p.z += en[0].ease[0].z;
    en[0].shown = p;
  }
}
e2n_hello :: (n: [] E2Net) {
  n[0].hello_due = false;
  look := ifx n[0].look_n > 0 then cast(string) n[0].look[0..<n[0].look_n] else "ranger.0.0.0";
  e2n_send(n, wire_put_pins(n[0].out[..], 0, wire_pins_at(n[0].content_rev)));
  if n[0].again && n[0].at_known { e2n_send(n, wire_put_at(n[0].out[..], 0, WireAt.{x = n[0].at_x, z = n[0].at_z, yaw = n[0].at_yaw})); n[0].agains += 1; }
  n[0].again = false;
  kind: [24] u8; kn := fb_cl_kind_at(e2n_class(n), n[0].level, kind[..]);
  e2n_send(n, wire_put_hello_value(n[0].out[..], 0, wire_hello_value(WireHello.{look = look, kind = cast(string) kind[0..<kn], flags = (ifx n[0].account then 2 else 0) | WIRE_HELLO_PACKED, name = ""})));
  if n[0].change_due { _ := e2n_change(n); }
}
// V LOOK KIND: Change character (the Esc menu's, through Character Create, and the admin CLASSES and
// LEVEL menus): your seat sits again as this look and class (room-everglade.coax eg_heard_change).
// False with no seat.
e2n_change :: (n: [] E2Net) -> bool {
  if !e2n_open(n) { return false; }
  n[0].change_due = false;
  look := ifx n[0].look_n > 0 then cast(string) n[0].look[0..<n[0].look_n] else "ranger.0.0.0";
  kind: [24] u8; kn := fb_cl_kind_at(e2n_class(n), n[0].level, kind[..]);
  e2n_send(n, wire_put_change(n[0].out[..], 0, WireChange.{look = look, kind = cast(string) kind[0..<kn]}));
  return true;
}
// Your class for the hello (srd-*: the room's kit for your casts), said again if seated and changed.
e2n_class :: (n: [] E2Net) -> int { return ifx n[0].klass >= 0 && n[0].klass < FB_CL_N then n[0].klass else 3; }
e2n_set_class :: (n: [] E2Net, c: int, level: int) {
  l := xk_level(level);
  if c < 0 || c >= FB_CL_N || (c == n[0].klass && l == n[0].level) { return; }
  n[0].klass = c; n[0].level = l; n[0].kit_known = false; n[0].aid_left = -1; n[0].aid_at = -100000; n[0].familiar_at=-100000; n[0].familiar_cast=0; n[0].familiar_order=0; n[0].familiar_sense=0;   // the room says the new bar's
  if e2n_open(n) { n[0].hello_due = true; n[0].change_due = true; }
}
// A cast (C SEQ SLOT AX AY AZ -1): the slot (class-kit.coax xk_slot) at the point it aims at. False
// with no seat; the room then says e cast to everyone near, you too, or r SEQ WHY.
e2n_cast :: (n: [] E2Net, slot: int, ax: f32, ay: f32, az: f32) -> bool {
  if !e2n_open(n) { return false; }
  n[0].cast_said="";
  n[0].cast_seq = n[0].pred[0].seq + 1000000 + n[0].cast_sent;   // apart from the inputs' numbers
  n[0].cast_sent += 1; n[0].cast_slot = slot;
  _ := net_action_press(n[0].acts[..], E2N_ACT_CAST, n[0].cast_seq, n[0].mono);
  e2n_send(n, wire_put_cast(n[0].out[..], 0, WireCast.{seq = n[0].cast_seq, slot = slot, ax = ax, ay = ay, az = az}));
  return true;
}
// The number the next cast's request will carry (e2n_cast), for what is said just before it under
// the same number (an arrow's launch, e2n_loose).
e2n_cast_next :: (n: [] E2Net) -> int { return n[0].pred[0].seq + 1000000 + n[0].cast_sent; }
e2n_clamp_ms :: (v: int, lo: int, hi: int) -> int { return ifx v < lo then lo else ifx v > hi then hi else v; }
// The moment of the room's world this page draws the others at, in ms of the room's ticks (tick *
// 1000 / hz): what an arrow's launch says, so the room flies it from what you saw (0 before a W).
e2n_view_ms :: (n: [] E2Net) -> int {
  if n[0].worlds == 0 || n[0].hz <= 0 { return 0; }
  v := n[0].w_tick * 1000 / n[0].hz + (n[0].rt - n[0].w_t);
  return ifx v > 0 then v else 0;
}
// An arrow's launch (F), just before its Attack's request. False with no seat.
e2n_loose :: (n: [] E2Net, l: NetLoose) -> bool {
  if !e2n_open(n) { return false; }
  c := net_loose_write(l, n[0].out[..]);
  if c <= 0 { return false; }
  e2n_send(n, c);
  return true;
}
// The room's word on an arrow: loosed (a) or ended (d), kept until the picture reaches it. When
// every place is taken the oldest gives way.
e2n_shot_word :: (n: [] E2Net, t: string) {
  if !e2n_open(n) { return; }
  if t[0] == 'a' {
    w := net_shot_read(t); if !w.ok || !net_seen_fresh(n[0].shot_ids[..], w.id) { return; }
    q := 0; for i: 0..<E2N_SHOTS { if !n[0].shots[i].ok { q = i; break; } if n[0].shot_t[i] < n[0].shot_t[q] { q = i; } }
    n[0].shots[q] = w; n[0].shot_t[q] = e2n_tick_t(n, w.tick) - w.age_ms; n[0].shots_heard += 1;
    return;
  }
  w := net_shot_end_read(t); if !w.ok || !net_seen_fresh(n[0].end_ids[..], w.id) { return; }
  q := 0; for i: 0..<E2N_SHOTS { if !n[0].ends[i].ok { q = i; break; } if n[0].end_t[i] < n[0].end_t[q] { q = i; } }
  n[0].ends[q] = w; n[0].end_t[q] = e2n_tick_t(n, w.tick); n[0].ends_heard += 1;
}
#test "an arrow's launch goes under the next cast's number, and the room's words on arrows wait for their moment (#13157)" {
  n: [1] E2Net; n[0].state = E2N_OPEN; n[0].sock = 1; n[0].seat = 2; n[0].hz = 30; n[0].worlds = 1; n[0].w_tick = 300; n[0].w_t = 50000; n[0].mono = 50500; n[0].rt = 50400;
  #assert e2n_view_ms(n[..]) == 10400;   // tick 300 is 10 000 ms of ticks; the picture is 400 ms past the W's moment
  seq := e2n_cast_next(n[..]);
  #assert e2n_loose(n[..], NetLoose.{seq = seq, from = [3] f32.[0, 1.45, -30], to = [3] f32.[0, 0, -60], strength = 1, view_ms = e2n_view_ms(n[..])});
  #assert e2n_cast(n[..], 128, 0, 1, -40) && n[0].cast_seq == seq;
  #assert pipe_bytes(n[0].pipe[..], 0) == "F 1000000 0 1450 -30000 0 0 -60000 1000 10400" && pipe_bytes(n[0].pipe[..], 1)[0] == 'C';
  e2n_record(n[..], "a 315 9 4 1000007 0 1450 -30000 0 5000 -40000 1000 100");
  #assert n[0].shots_heard == 1 && n[0].shots[0].ok && n[0].shots[0].id == 9 && n[0].shot_t[0] == 50400;   // tick 315 is 500 ms past the W's; it left 100 ms before
  e2n_record(n[..], "d 330 9 1 0 200 -60000 0 -300 -950 -1");
  #assert n[0].ends_heard == 1 && n[0].ends[0].ok && n[0].end_t[0] == 51000;
  e2n_record(n[..], "a 315 0 4 7 0 0 0 0 0 0 1000 0"); e2n_record(n[..], "d nonsense"); #assert n[0].shots_heard == 1 && n[0].ends_heard == 1;
  // the same words again (a datagram and the stream): taken once
  e2n_record(n[..], "a 315 9 4 1000007 0 1450 -30000 0 5000 -40000 1000 100"); e2n_record(n[..], "d 330 9 1 0 200 -60000 0 -300 -950 -1");
  #assert n[0].shots_heard == 1 && n[0].ends_heard == 1 && n[0].shot_ids[0].dups == 1 && n[0].end_ids[0].dups == 1;
  m: [1] E2Net; #assert !e2n_loose(m[..], NetLoose.{seq = 1}) && e2n_view_ms(m[..]) == 0;
}
// The room chooses the patient and reports the remaining charges.
e2n_aid :: (n:[] E2Net)->bool {
  if !e2n_open(n) || n[0].aid_left==0 { return false; }
  n[0].aid_seq=add_sat(n[0].aid_seq,1);
  n[0].aid_at=-100000;
  count:=egk_ask_put(n[0].out[..],n[0].aid_seq);
  e2n_send(n,count);
  return true;
}
e2n_aid_message :: (n:[] E2Net)->string {
  age:=n[0].mono-n[0].aid_at;
  if age<0 || age>=4000 || !e2n_open(n) { return ""; }
  return ifx n[0].aid_ok then "ALLY STABILIZED" else "CAN'T USE HEALER'S KIT";
}

e2n_clear_familiars :: (n:[]E2Net) {
  for h:0..<E2N_GUARD_HITS { n[0].guard_hits[h].live=false; }
  for h:0..<E2N_MON_HITS { n[0].mon_hits[h].live=false; }
  n[0].familiar_tick=-1; n[0].familiar_cast=0; n[0].familiar_order=0; n[0].familiar_heal_cue=false; n[0].familiar_sense=0;
  for e:0..<E2N_ENTS { if n[0].ents[e].kind==E2N_ENT_FAMILIAR { n[0].ents[e].live=false; } }
}
e2n_familiar_snapshot :: (n:[]E2Net,t:string) {
  if !e2n_open(n) { return; }
  rd:=[1]WireRd.[wire_rd(t,2)];
  tick:=wire_num(t,rd[..]); count:=wire_num(t,rd[..]);
  if !rd[0].ok || tick<0 || tick<=n[0].familiar_tick || count<0 || count>E2N_FAMILIARS { return; }
  rows:[E2N_FAMILIARS]E2nFamiliar; prior:=-1;
  for q:0..<count {
    s:=wire_num(t,rd[..]); form:=wire_num(t,rd[..]);
    x:=wire_num(t,rd[..]); z:=wire_num(t,rd[..]);
    hp:=wire_num(t,rd[..]); max:=wire_num(t,rd[..]);
    if !rd[0].ok || s<=prior || s>=E2N_FAMILIARS || form<0 || form>=RS_FAMILIAR_FORMS.count || hp<=0 || max<hp ||
      x < -200000 || x > 200000 || z < -650000 || z > 200000 { return; }
    rows[s]=E2nFamiliar.{live=true,form=form,x=f32(x)/1000,z=f32(z)/1000,hp=hp,max=max};
    prior=s;
  }
  if wire_more(t,rd[..]) { return; }
  n[0].familiar_tick=tick;
  // the whole list, taken whole: each familiar's place into its entity's ring at the tick the room
  // names, and one the list leaves out is gone
  at:=e2n_tick_t(n,tick);
  for s:0..<E2N_FAMILIARS {
    eid:=WIRE_ID_MADE+E2N_FAM_EID+s;
    if !rows[s].live { k:=e2n_ent(n,eid,false); if k>=0 { n[0].ents[k].live=false; } continue; }
    k:=e2n_ent(n,eid,true);
    if k<0 { continue; }
    en:=n[0].ents[k..<k+1];
    if en[0].ring_n>0 {
      last:=en[0].ring[en[0].ring_n-1]; dx:=rows[s].x-last.x; dz:=rows[s].z-last.z;
      if dx*dx+dz*dz>f32(E2N_FAM_JUMP*E2N_FAM_JUMP) || last.t>at { en[0].ring_n=0; en[0].born=at; }
    }
    en[0].kind=E2N_ENT_FAMILIAR; en[0].owner=s; en[0].p1=rows[s].form; en[0].hp=rows[s].hp; en[0].max=rows[s].max; en[0].seen=tick;
    net_push_row(en,NetState.{t=at,x=rows[s].x,z=rows[s].z},n[0].hz);
    if en[0].ring_n==1 { en[0].shown=en[0].ring[0]; }
  }
}
// Owner seat s's familiar as drawn at the page's moment of the room (rt): from the engine's buffer.
e2n_familiar_of :: (n:[]E2Net,s:int)->E2nFamiliar {
  k:=ifx s>=0 && s<E2N_FAMILIARS then e2n_ent(n,WIRE_ID_MADE+E2N_FAM_EID+s,false) else -1;
  if k<0 || n[0].ents[k].ring_n==0 || n[0].ents[k].kind!=E2N_ENT_FAMILIAR { return E2nFamiliar.{}; }
  en:=n[0].ents[k..<k+1]; p:=net_state_at(en,n[0].rt);
  return E2nFamiliar.{live=true,form=en[0].p1,x=p.x,z=p.z,hp=en[0].hp,max=en[0].max};
}
#test "a familiar is drawn from the engine's buffer: a step is blended at its moment, a recall never is, and one the list leaves out is gone (#13277)" {
  n:[1]E2Net; n[0].state=E2N_OPEN; n[0].sock=1; n[0].seat=0; n[0].hz=30; n[0].worlds=1; n[0].w_tick=0; n[0].w_t=0;
  #assert !e2n_familiar_of(n[..],2).live && !e2n_familiar_of(n[..],-1).live && !e2n_familiar_of(n[..],E2N_FAMILIARS).live;
  e2n_record(n[..],"m2 30 1 2 8 4000 -6000 3 5");
  f:=e2n_familiar_of(n[..],2); #assert f.live && f.form==8 && f.x==4 && f.z== -6 && f.hp==3 && f.max==5;
  // it stood a second, then stepped a square: the step takes the tick it was told at, not the second between
  e2n_record(n[..],"m2 60 1 2 8 5500 -6000 3 5");
  n[0].rt=1500; #assert e2n_familiar_of(n[..],2).x==4;
  n[0].rt=1983; a:=e2n_familiar_of(n[..],2); #assert a.x>4.5 && a.x<5.0;
  n[0].rt=2000; #assert e2n_familiar_of(n[..],2).x==5.5;
  // a recall to somewhere else is no walk: nothing is drawn between
  e2n_record(n[..],"m2 90 1 2 8 5500 -40000 2 5");
  n[0].rt=2990; b:=e2n_familiar_of(n[..],2); #assert b.z== -40 && b.hp==2;
  // a whole snapshot of the rows leaves it be (it is no row yet); the next list without it takes it away
  e2n_record(n[..],"D 91 0 1 0 "); #assert e2n_familiar_of(n[..],2).live;
  e2n_record(n[..],"m2 92 0"); #assert !e2n_familiar_of(n[..],2).live;
  e2n_record(n[..],"m2 93 1 2 8 5500 -40000 2 5"); #assert e2n_familiar_of(n[..],2).live;
  e2n_down(n[..]); #assert !e2n_familiar_of(n[..],2).live;
}
// A blow at or by the guard (creature-wire.coax e guard).
e2n_guard_hit :: (n:[]E2Net,t:string) {
  if !e2n_open(n) { return; }
  h:=egc_guard_hit_read(t);
  if !h.ok { return; }
  if h.seat==n[0].seat && h.amount>0 && h.kind==EGC_GUARD_HIT { n[0].hit_n[E2N_FOE_GUARD]+=1; n[0].mine[E2N_MONS]=true; }
  if h.seat==n[0].seat && h.amount>0 && h.kind>=EGC_GUARD_BLOW { n[0].hurt_n[E2N_FOE_GUARD]+=1; n[0].hurt_by=E2N_FOE_GUARD; }
  for q:0..<E2N_GUARD_HITS { if !n[0].guard_hits[q].live { n[0].guard_hits[q]=E2nGuardHit.{live=true,t=e2n_tick_t(n,h.tick),kind=h.kind,seat=h.seat,amount=h.amount}; return; } }
}
// The guard at the room's time rt (ms), from the engine's buffer of his row's states; state 4 (none)
// while the room's rows hold no guard for you (none yet, or out of your view).
e2n_guard_at :: (n:[]E2Net,rt:int)->E2nGuard {
  k:=e2n_ent(n,WIRE_ID_MADE+WIRE_GUARD_EID,false);
  if k<0 || n[0].ents[k].ring_n==0 || n[0].ents[k].kind!=WK_GUARD { return E2nGuard.{}; }
  en:=n[0].ents[k..<k+1]; p:=net_state_at(en,rt);
  return E2nGuard.{t=rt,life=en[0].life,state=p.f,x=p.x,z=p.z,yaw=p.yaw,hp=en[0].hp,max=en[0].max,swing=ifx p.a>=0 then e2n_tick_t(n,p.a) else -1,
                   foe=ifx en[0].owner>=WIRE_TGT_SEAT then en[0].owner-WIRE_TGT_SEAT else -1};
}
// A D frame of one absolute row, as the room writes it (a check's).
e2n_test_row :: (n:[]E2Net,tick:int,w:WireS) {
  b:[512]u8; z:[WIRE_SF]s32; f:[WIRE_SF]s32;
  wire_s_pack(WireS.{},z[..]); for q:0..<WIRE_SF { z[q]=0; }
  wire_s_pack(w,f[..]); wire_kind_keep(w.kind,f[..]);
  m:=wire_put_d(b[..],0,WireD.{tick=tick,ack=0,f=0,part=0});
  m=wire_put_s(b[..],m,w.id,0,z[..],f[..]);
  e2n_record(n,cast(string)b[0..<m]);
}
#test "the guard is his row: drawn from the engine's buffer, a new life never blended with the last, gone with his x (#13276)" {
  n:[1]E2Net; n[0].state=E2N_OPEN; n[0].seat=0; n[0].hz=30; n[0].worlds=1; n[0].w_tick=0; n[0].w_t=0;
  gid:=WIRE_ID_MADE+WIRE_GUARD_EID;
  #assert e2n_guard_at(n[..],0).state==4;
  e2n_test_row(n[..],30,WireS.{id=gid,kind=WK_GUARD,x=0,z=-20,yaw=3.14,g=0,hp=11,max=11,owner=-1,t0=-1,life=1});
  e2n_test_row(n[..],31,WireS.{id=gid,kind=WK_GUARD,x=0,z=-21.4,yaw=3.14,g=2,hp=9,max=11,owner=WIRE_TGT_SEAT+2,t0=24,life=1});
  g:=e2n_guard_at(n[..],1016); #assert abs(g.z+20.68)<0.01 && g.life==1 && g.hp==9 && g.max==11 && g.foe==2;
  // his state and his swing are drawn at their moment: the nearer of the two states round the time asked
  #assert e2n_guard_at(n[..],1010).state==0 && e2n_guard_at(n[..],1010).swing== -1 && e2n_guard_at(n[..],1030).state==2 && e2n_guard_at(n[..],1030).swing==800;
  #assert abs(e2n_guard_at(n[..],5000).z+21.4)<0.001 && abs(e2n_guard_at(n[..],0).z+20)<0.001;
  // a row after a quiet while: he stood where he was until the tick before it
  e2n_test_row(n[..],63,WireS.{id=gid,kind=WK_GUARD,x=0,z=-21.5,yaw=3.14,g=2,hp=9,max=11,owner=WIRE_TGT_SEAT+2,t0=24,life=1});
  #assert abs(e2n_guard_at(n[..],1600).z+21.4)<0.001 && abs(e2n_guard_at(n[..],2100).z+21.5)<0.001;
  // you hurt him and he falls: counted once, however many rows say he lies
  n[0].mine[E2N_MONS]=true;
  e2n_test_row(n[..],70,WireS.{id=gid,kind=WK_GUARD,x=0,z=-21.4,yaw=3.14,g=3,hp=0,max=11,owner=-1,t0=45,life=1});
  e2n_test_row(n[..],71,WireS.{id=gid,kind=WK_GUARD,x=0,z=-21.4,yaw=3.1,g=3,hp=0,max=11,owner=-1,t0=45,life=1});
  #assert n[0].fell_n[E2N_FOE_GUARD]==1 && !n[0].mine[E2N_MONS];
  // the next guard: a new life, drawn where the room puts him and nowhere between
  e2n_test_row(n[..],90,WireS.{id=gid,kind=WK_GUARD,x=0,z=-18,yaw=0,g=0,hp=11,max=11,owner=-1,t0=-1,life=2});
  #assert abs(e2n_guard_at(n[..],2500).z+18)<0.001 && e2n_guard_at(n[..],2500).life==2 && e2n_guard_at(n[..],2500).state==0;
  e2n_record(n[..],"D 90 0 0 1 e guard 90 1 2 5");
  #assert n[0].guard_hits[0].live && n[0].guard_hits[0].t==3000 && n[0].guard_hits[0].amount==5 && n[0].guard_hits[0].seat==2;
  e2n_record(n[..],"D 90 0 0 2 e guard 90 3 2 5"); #assert !n[0].guard_hits[1].live;
  // a row that is not his (another id under his kind) is no guard
  e2n_test_row(n[..],91,WireS.{id=gid+1,kind=WK_GUARD,x=5,z=5,g=0,hp=1,max=1,life=1});
  #assert e2n_ent(n[..],gid+1,false)<0;
  // out of your view: the room's x, and he is none until his row comes again
  e2n_record(n[..],"D 92 0 0 0 x 1170100"); #assert gid==1170100 && e2n_guard_at(n[..],3100).state==4;
}
// A monster's event (creature-wire.coax e mon).
e2n_mon_hit :: (n:[]E2Net,t:string) {
  if !e2n_open(n) { return; }
  h:=egc_mon_hit_read(t);
  if !h.ok || h.m>=E2N_MONS { return; }
  e:=E2nMonHit.{live=true,t=e2n_tick_t(n,h.tick),kind=h.kind,m=h.m,seat=h.seat,amount=h.amount};
  if h.kind==EGC_MON_LOOSED { e.fx=f32(h.fx)/100; e.fz=f32(h.fz)/100; e.tx=f32(h.tx)/100; e.tz=f32(h.tz)/100; e.fly=f32(h.fly)/1000; }
  foe:=e2n_mon_kind(n,h.m);
  if h.kind==EGC_MON_BLOW && h.seat==n[0].seat && h.amount>0 { n[0].hurt_n[foe]+=1; n[0].hurt_by=foe; }
  if h.kind==EGC_MON_HIT && h.seat==n[0].seat && h.amount>0 { n[0].hit_n[foe]+=1; n[0].mine[h.m]=true; }
  if h.kind==EGC_MON_FELL && n[0].mine[h.m] { n[0].fell_n[foe]+=1; n[0].mine[h.m]=false; }
  for q:0..<E2N_MON_HITS { if !n[0].mon_hits[q].live { n[0].mon_hits[q]=e; return; } }
}
// Monster m at the room's time rt (ms), from the engine's buffer of its row's states; state 4 (gone)
// while the room's rows hold none for you (none yet, or out of your view).
e2n_mon_at :: (n:[]E2Net,m:int,rt:int)->E2nMon {
  k:=ifx m>=0 && m<E2N_MONS then e2n_ent(n,WIRE_ID_MADE+WIRE_MON_EID+m,false) else -1;
  if k<0 || n[0].ents[k].ring_n==0 || n[0].ents[k].kind!=WK_MONSTER { return E2nMon.{}; }
  en:=n[0].ents[k..<k+1]; p:=net_state_at(en,rt);
  return E2nMon.{t=rt,life=en[0].life,kind=en[0].p2,state=p.f&E2N_MON_STATE,x=p.x,z=p.z,yaw=p.yaw,hp=en[0].hp,max=en[0].max,act=p.f>>E2N_MON_ACT,
                 act_t=ifx p.a>0 then e2n_tick_t(n,p.a) else -1,foe=ifx en[0].owner>=WIRE_TGT_SEAT then en[0].owner-WIRE_TGT_SEAT else -1};
}
#test "a monster is its row: drawn from the engine's buffer with its state and act at their moment; out of view it is gone (#13276)" {
  n:[1]E2Net; n[0].state=E2N_OPEN; n[0].seat=0; n[0].hz=30; n[0].worlds=1; n[0].w_tick=0; n[0].w_t=0;
  m3:=WIRE_ID_MADE+WIRE_MON_EID+3; m9:=WIRE_ID_MADE+WIRE_MON_EID+9;
  #assert e2n_mon_at(n[..],3,0).state==4 && e2n_mon_at(n[..],-1,0).state==4 && e2n_mon_at(n[..],E2N_MONS,0).state==4;
  e2n_test_row(n[..],30,WireS.{id=m3,kind=WK_MONSTER,x=10,z=-200,yaw=3.14,g=1,hp=11,max=11,owner=WIRE_TGT_SEAT,p1=3,p2=0,life=1});
  e2n_test_row(n[..],30,WireS.{id=m9,kind=WK_MONSTER,x=5,z=-300,yaw=0,g=0,clip=2,hp=7,max=7,owner=-1,p1=9,p2=1,t0=30,life=1});
  e2n_test_row(n[..],31,WireS.{id=m3,kind=WK_MONSTER,x=13,z=-200,yaw=3.14,g=1,clip=1,hp=9,max=11,owner=WIRE_TGT_SEAT,p1=3,p2=0,t0=31,life=1});
  w:=e2n_mon_at(n[..],3,1016); #assert abs(w.x-11.45)<0.02 && w.life==1 && w.state==1 && w.hp==9 && w.max==11 && w.foe==0 && w.kind==0;
  // its act begins when the picture reaches the row that says it, not before
  #assert e2n_mon_at(n[..],3,1010).act==0 && e2n_mon_at(n[..],3,1010).act_t== -1 && e2n_mon_at(n[..],3,1030).act==1 && e2n_mon_at(n[..],3,1030).act_t==1033;
  #assert e2n_mon_at(n[..],9,1000).kind==1 && e2n_mon_at(n[..],9,1000).act==2 && e2n_mon_at(n[..],9,1000).act_t==1000 && e2n_mon_at(n[..],9,1000).foe== -1;
  #assert e2n_mon_kind(n[..],9)==E2N_FOE_GOBLIN && e2n_mon_kind(n[..],3)==E2N_FOE_WOLF && e2n_mon_kind(n[..],4)==E2N_FOE_WOLF;
  // a row whose index is not its id's, or past the last monster, is no monster
  e2n_test_row(n[..],61,WireS.{id=m3+1,kind=WK_MONSTER,x=1,z=1,g=1,hp=1,max=1,p1=3,life=1});
  e2n_test_row(n[..],61,WireS.{id=WIRE_ID_MADE+WIRE_MON_EID+E2N_MONS,kind=WK_MONSTER,x=1,z=1,g=1,hp=1,max=1,p1=E2N_MONS,life=1});
  #assert e2n_mon_at(n[..],4,2100).state==4 && e2n_ent(n[..],WIRE_ID_MADE+WIRE_MON_EID+E2N_MONS,false)<0;
  // out of view: the room's x; back in view, a new life is not blended with the last
  e2n_record(n[..],"D 62 0 0 0 x 1170009"); #assert m9==1170009 && e2n_mon_at(n[..],9,2100).state==4 && e2n_mon_at(n[..],3,2100).state==1;
  e2n_test_row(n[..],90,WireS.{id=m3,kind=WK_MONSTER,x=40,z=-100,yaw=0,g=0,hp=11,max=11,owner=-1,p1=3,p2=0,life=2});
  #assert abs(e2n_mon_at(n[..],3,2500).x-40)<0.001 && e2n_mon_at(n[..],3,2500).life==2;
  e2n_record(n[..],"D 90 0 0 1 e mon 90 3 10 0 0 500 -30000 520 -31000 700");
  #assert n[0].mon_hits[0].live && n[0].mon_hits[0].t==3000 && abs(n[0].mon_hits[0].tz+310)<0.001 && abs(n[0].mon_hits[0].fly-0.7)<0.001;
  e2n_record(n[..],"D 90 0 0 2 e mon 90 2 3 -1 4"); #assert n[0].mon_hits[1].live && n[0].mon_hits[1].seat== -1 && n[0].mon_hits[1].amount==4;
  e2n_record(n[..],"D 90 0 0 3 e mon 90 5 3 0 4"); #assert !n[0].mon_hits[2].live;
  // a whole snapshot that holds no monster: every one has gone
  e2n_record(n[..],"D 95 0 1 0 "); #assert e2n_mon_at(n[..],3,3200).state==4;
}
e2n_familiar :: (n:[]E2Net)->bool {
  wizard:=n[0].klass==FB_CL_WIZARD;
  if !e2n_open(n) || (!wizard && (n[0].klass!=FB_CL_DRUID || n[0].level<2)) { return false; }
  if wizard && (n[0].familiar_cast==1 || (n[0].familiar_cast==4 && n[0].mono-n[0].familiar_at<4000)) { return false; }
  n[0].familiar_seq=add_sat(n[0].familiar_seq,1);
  n[0].familiar_order=0;
  n[0].familiar_cast=ifx wizard then 4 else 0;
  n[0].familiar_at=ifx wizard then n[0].mono else -100000;
  out:=n[0].out[..];
  count:=wire_int(out,wire_put(out,0,ifx wizard then "M3" else "M1"),n[0].familiar_seq);
  count=wire_int(out,count,n[0].familiar_form);
  count=wire_int(out,count,n[0].familiar_slot);
  if wizard { count=wire_int(out,count,n[0].familiar_spirit); }
  e2n_send(n,count);
  return true;
}
e2n_familiar_order :: (n:[]E2Net,order:int)->bool {
  if !e2n_open(n) || order<1 || order==5 || order>6 || n[0].familiar_cast==1 ||
    (n[0].familiar_cast==4 && n[0].mono-n[0].familiar_at<4000) { return false; }
  n[0].familiar_seq=add_sat(n[0].familiar_seq,1);
  n[0].familiar_order=order; n[0].familiar_at=-100000; n[0].familiar_cast=0;
  out:=n[0].out[..];
  count:=wire_int(out,wire_put(out,0,ifx order==6 then "M7" else ifx order==4 then "M5" else "M4"),n[0].familiar_seq);
  if order<4 { count=wire_int(out,count,order); }
  e2n_send(n,count);
  return true;
}
e2n_familiar_heal :: (n:[]E2Net,target:int)->bool {
  if !e2n_open(n) || n[0].klass!=FB_CL_DRUID || n[0].level<2 || target<0 || target>=E2N_FAMILIARS { return false; }
  n[0].familiar_seq=add_sat(n[0].familiar_seq,1);
  n[0].familiar_order=5; n[0].familiar_at=-100000; n[0].familiar_cast=0;
  out:=n[0].out[..];
  count:=wire_int(out,wire_put(out,0,"M6"),n[0].familiar_seq);
  e2n_send(n,wire_int(out,count,target));
  return true;
}
e2n_familiar_view :: (n:[]E2Net)->E2nFamiliar {
  own:=n[0].seat;
  if n[0].familiar_sense>0 && e2n_open(n) { return e2n_familiar_of(n,own); }
  return E2nFamiliar.{};
}
e2n_familiar_message :: (n:[]E2Net)->string {
  if !e2n_open(n) { return ""; }
  wizard:=n[0].klass==FB_CL_WIZARD;
  if wizard && n[0].familiar_cast==1 { return "CASTING FIND FAMILIAR"; }
  age:=n[0].mono-n[0].familiar_at;
  if age<0 || age>=4000 { return ""; }
  if n[0].familiar_order>0 {
    messages:=[6]string.["FAMILIAR POCKETED","FAMILIAR RECALLED","FAMILIAR RELEASED","FAMILIAR MOVED","FAMILIAR DELIVERED CURE WOUNDS","BORROWED FAMILIAR SENSES"];
    return ifx n[0].familiar_ok then messages[n[0].familiar_order-1] else "FAMILIAR COMMAND REFUSED";
  }
  if wizard {
    if n[0].familiar_cast==4 { return "ASKING TO CAST"; }
    return ifx n[0].familiar_cast==2 then "FAMILIAR SUMMONED" else "FIND FAMILIAR FAILED";
  }
  return ifx n[0].familiar_ok then "COMPANION SUMMONED" else "CAN'T SUMMON COMPANION";
}

// An ask about your own record (E SEQ KIND ID, #13381): WE_SAY talks to dialogue ID, WE_WEAR wears
// item ID, WE_BARE empties equipment slot ID (0 to 9). The room decides it and tells your seat what
// changed (e say, e item); the page changes nothing itself. False with no seat.
e2n_use :: (n: [] E2Net, kind: int, id: int) -> bool {
  if !e2n_open(n) || kind < WE_SAY || kind > WE_BARE || id < 0 { return false; }
  seq := n[0].pred[0].seq + 5000000 + n[0].own[0].use_sent;   // apart from the inputs', the casts', the rests' and the aids' numbers
  n[0].own[0].use_sent += 1;
  e2n_send(n, wire_put_use(n[0].out[..], 0, WireUse.{seq = seq, kind = kind, id = id}));
  return true;
}
// A rest request (Z SEQ REQ: RS_REST_*): the room decides it from the body it steps.
e2n_rest :: (n: [] E2Net, req: int) -> bool {
  if !e2n_open(n) || req < 1 || req > 5 { return false; }
  n[0].rest_seq = n[0].pred[0].seq + 2000000 + n[0].rest_sent;   // apart from the inputs' and the casts' numbers
  n[0].rest_sent += 1; n[0].rest_refused_at = -100000;
  _ := net_action_press(n[0].acts[..], E2N_ACT_REST, n[0].rest_seq, n[0].mono);
  e2n_send(n, wire_put_rest_ask(n[0].out[..], 0, WireRestAsk.{seq = n[0].rest_seq, req = req}));
  return true;
}
// The refusal of your latest rest request, for four seconds.
e2n_rest_message :: (n: [] E2Net) -> string {
  age := n[0].mono - n[0].rest_refused_at;
  return ifx age >= 0 && age < 4000 then "YOU CAN'T REST RIGHT NOW" else "";
}
// Whether the room holds you asleep (your keys move nothing until you wake).
// Your bar's slot i as the room holds it: what it has left (-1 nothing to count) and whether its
// effect holds; ok false until the room has said a bar of `count` slots.
e2n_slot :: (n: [] E2Net, i: int, count: int) -> XkSlot { return xk_room_slot(e2n_open(n), n[0].kit_known, n[0].kit[0].n, n[0].kit[0].v[..], i, count); }
#test "b: the room's word on your bar, slot by slot, until the socket goes or your bar changes (#13046)" {
  n: [1] E2Net; n[0].state = E2N_OPEN; n[0].sock = 1; n[0].seat = 2;
  #assert !e2n_slot(n[..], 0, 3).ok;
  e2n_record(n[..], "b 3 0 7 4");
  a := e2n_slot(n[..], 1, 3); #assert a.ok && a.left == 2 && a.on && e2n_slot(n[..], 0, 3).left == -1 && e2n_slot(n[..], 2, 3).left == 1 && !e2n_slot(n[..], 2, 3).on;
  #assert !e2n_slot(n[..], 1, 4).ok;   // a bar of another size: not this one
  e2n_record(n[..], "b 2 4"); #assert e2n_slot(n[..], 1, 3).ok;   // a malformed b changes nothing
  e2n_set_class(n[..], FB_CL_MONK, 3); #assert !e2n_slot(n[..], 1, 3).ok;
  e2n_record(n[..], "b 1 5"); #assert e2n_slot(n[..], 0, 1).ok;
  e2n_down(n[..]); #assert !e2n_slot(n[..], 0, 1).ok;
}
e2n_asleep :: (n: [] E2Net) -> bool { return e2n_open(n) && n[0].rest_known && n[0].rest_code == WIRE_REST_SLEEP; }
#test "rest: z sets the rest the room holds, a matching refusal shows for four seconds, and a new socket forgets it" {
  n: [1] E2Net; n[0].state = E2N_OPEN; n[0].sock = 1; n[0].seat = 0; n[0].mono = 100;
  #assert e2n_rest(n[..], 2) && !e2n_rest(n[..], 6);
  p := n[0].pipe[0]; last := p.n - 1; sent := cast(string) p.buf[p.from[last]..<p.from[last] + p.len[last]];
  #assert sent[0] == 'Z' && n[0].rest_seq >= 2000000;
  m: [64] u8; c := wire_put_rest_state(m[..], 0, WireRestState.{seq = n[0].rest_seq, code = WIRE_REST_SLEEP, dice = 2});
  e2n_record(n[..], cast(string) m[0..<c]);
  #assert n[0].rest_known && e2n_asleep(n[..]) && n[0].rest_dice == 2;
  e2n_record(n[..], "z 0 9 2"); e2n_record(n[..], "z 0 4 -1"); #assert n[0].rest_code == WIRE_REST_SLEEP;
  #assert e2n_rest(n[..], 3);
  c = wire_put_refused(m[..], 0, n[0].rest_seq, "rest"); e2n_record(n[..], cast(string) m[0..<c]);
  #assert e2n_rest_message(n[..]).count > 0 && n[0].cast_refused == 0;
  n[0].mono = 4100; #assert e2n_rest_message(n[..]).count == 0;
  e2n_down(n[..]); #assert !n[0].rest_known && !e2n_asleep(n[..]);
}
// The next of the others' casts whose tick the picture has reached (rt): taken, so it plays once.
e2n_cast_due :: (n: [] E2Net, rt: int) -> E2nCast {
  b := -1;
  for i: 0..<E2N_CASTS { c := n[0].casts[i]; if c.live && c.t <= rt && (b < 0 || c.t < n[0].casts[b].t) { b = i; } }
  if b < 0 { return E2nCast.{}; }
  c := n[0].casts[b];
  n[0].casts[b].live = false;
  return c;
}
// Where seat ss is drawn now (E2Remote; ok false when it isn't drawn).
e2n_remote_seat :: (n: [] E2Net, ss: int) -> E2Remote {
  k := 0;
  while true { r := e2n_remote(n, k); if !r.ok || r.seat == ss { return r; } k += 1; }
  return E2Remote.{};
}
// Where you stand this frame (the face's feet and facing), for a hello after a lost room (A).
e2n_where :: (n: [] E2Net, x: f32, z: f32, yaw: f32) {
  if !(x == x) || !(z == z) || !(yaw == yaw) { return; }
  n[0].at_x = x; n[0].at_z = z; n[0].at_yaw = yaw; n[0].at_known = true;
}
#test "sitting again after a lost room, the hello first says where you stand" {
  n: [1] E2Net; n[0].state = E2N_OPEN; n[0].sock = 1; n[0].mono = 1000;
  e2n_where(n[..], 3, -40.5, 3.1);
  e2n_record(n[..], "y 1 0 1000"); e2n_step(n[..], 1000);
  for i: 0..<n[0].pipe[0].n { #assert pipe_bytes(n[0].pipe[..], i)[0] != 'A'; }   // the first sit: none
  pipe_drained(n[0].pipe[..]);
  e2n_down(n[..]); n[0].state = E2N_OPEN; n[0].sock = 2; e2n_where(n[..], 3, -60.25, 3.0);
  e2n_record(n[..], "y 2 0 2000"); e2n_step(n[..], 2000);
  said := false; for i: 0..<n[0].pipe[0].n { if pipe_bytes(n[0].pipe[..], i) == "A 300 0 -6025 300" { said = true; } }
  #assert said && n[0].agains == 1;
}
// Your look for the hello: the record Character Create keeps (CC2 or CC3); said again if seated.
e2n_set_look :: (n: [] E2Net, record: string) {
  b: [NET_LOOK] u8; m := 0;
  for ch: record { if m >= NET_LOOK { break; } if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') { b[m] = ch; m += 1; } }
  changed := m != n[0].look_n;
  for i: 0..<m { if n[0].look[i] != b[i] { changed = true; } n[0].look[i] = b[i]; }
  n[0].look_n = m;
  if e2n_open(n) && changed { n[0].hello_due = true; n[0].change_due = true; }
}

// ---- the others, for the scene

// The k-th other player drawn this frame: false past the last. Its seat, where it is drawn (feet, the
// room's flat ground: the page lifts it onto the land), facing, speed and whether it is in the air.
E2Remote :: struct { ok: bool; slot: int; seat: int; x: f32; y: f32; z: f32; yaw: f32; speed: f32; air: bool; }
e2n_remote :: (n: [] E2Net, k: int) -> E2Remote {
  c := 0;
  for e: 0..<E2N_ENTS {
    en := n[0].ents[e];
    if !en.live || en.ring_n == 0 || en.kind != WK_PLAYER || en.seat == n[0].seat || en.seat < 0 { continue; }
    if c == k {
      p := en.shown;
      return E2Remote.{ok = true, slot = e, seat = en.seat, x = p.x, y = p.y, z = p.z, yaw = p.yaw, speed = sqrt(p.vx * p.vx + p.vz * p.vz), air = (p.f & WG_GROUND) == 0};
    }
    c += 1;
  }
  return E2Remote.{};
}
e2n_remotes :: (n: [] E2Net) -> int { c := 0; while e2n_remote(n, c).ok { c += 1; } return c; }
// The drift check's probes (coax/web/everglade2-drift.coax, #13277; e2_probe 200, and 1200 on). 200: the
// moment of the room this frame draws the others at, in thousandths of a tick (-1 before the room's
// clock is known). 1200 + 64 * SEAT + K: that seat's player as this page has it. K 32 and 33: where it
// is drawn this frame (mm; -999999 when it is not here). K 4 * I + 0, 1, 2: the I-th state of its
// buffer, oldest first, as the room's rows said it: its tick (-1 past the last), and its place (mm).
E2N_DRIFT :: 1200; E2N_DRIFT_SEAT :: 64; E2N_DRIFT_SHOWN :: 32; E2N_DRIFT_NONE :: -999999;
e2n_mm :: (m: f32) -> int { return cast(int) floor(m * 1000 + 0.5); }
e2n_drift_probe :: (n: [] E2Net, f: int) -> int {
  if f == 200 { return ifx n[0].worlds > 0 then (n[0].rt - n[0].w_t) * n[0].hz + n[0].w_tick * 1000 else -1; }
  if f < E2N_DRIFT || f >= E2N_DRIFT + E2N_DRIFT_SEAT * WIRE_SEATS { return -1; }
  seat := (f - E2N_DRIFT) / E2N_DRIFT_SEAT; k := (f - E2N_DRIFT) % E2N_DRIFT_SEAT;
  none := ifx k >= E2N_DRIFT_SHOWN then E2N_DRIFT_NONE else -1;
  e := ifx seat != n[0].seat then e2n_ent(n, seat, false) else -1;
  if e < 0 || n[0].ents[e].kind != WK_PLAYER || n[0].ents[e].seat != seat || n[0].ents[e].ring_n == 0 { return none; }
  en := n[0].ents[e..<e + 1];
  if k == E2N_DRIFT_SHOWN { return e2n_mm(en[0].shown.x); }
  if k == E2N_DRIFT_SHOWN + 1 { return e2n_mm(en[0].shown.z); }
  i := k / 4; j := k % 4;
  if k > E2N_DRIFT_SHOWN || i >= en[0].ring_n || j == 3 { return none; }
  st := en[0].ring[i];
  // the state's time back to its tick: the page's clock of the room follows a drift a few ms at a time, so to the nearest
  if j == 0 { return n[0].w_tick + ((st.t - n[0].w_t) * n[0].hz + 500 + 1000000000) / 1000 - 1000000; }
  return e2n_mm(ifx j == 1 then st.x else st.z);
}
#test "the drift check's probes: the drawn moment in ticks, a player's drawn place and its buffer's states by tick, never you (#13277)" {
  n: [1] E2Net; n[0].state = E2N_OPEN; n[0].seat = 0; n[0].hz = 30; n[0].worlds = 1; n[0].w_tick = 600; n[0].w_t = 5000;
  n[0].rt = 5100; #assert e2n_drift_probe(n[..], 200) == 603000;
  b := E2N_DRIFT + 3 * E2N_DRIFT_SEAT;
  #assert e2n_drift_probe(n[..], b) == -1 && e2n_drift_probe(n[..], b + E2N_DRIFT_SHOWN) == E2N_DRIFT_NONE;
  e2n_test_row(n[..], 630, WireS.{id = 3, kind = WK_PLAYER, x = 1.5, z = -20.25, g = WG_GROUND, hp = 5, max = 5, life = 1});
  e2n_test_row(n[..], 632, WireS.{id = 3, kind = WK_PLAYER, x = 1.75, z = -20, g = WG_GROUND, hp = 5, max = 5, life = 1});
  // a row after a tick with none: the last state again a tick before it (metaverse-engine/net/interp.coax net_ring_push_row)
  #assert e2n_drift_probe(n[..], b) == 630 && e2n_drift_probe(n[..], b + 1) == 1500 && e2n_drift_probe(n[..], b + 2) == -20250;
  #assert e2n_drift_probe(n[..], b + 4) == 631 && e2n_drift_probe(n[..], b + 5) == 1500 && e2n_drift_probe(n[..], b + 8) == 632 && e2n_drift_probe(n[..], b + 9) == 1750 && e2n_drift_probe(n[..], b + 10) == -20000;
  #assert e2n_drift_probe(n[..], b + 12) == -1 && e2n_drift_probe(n[..], b + 3) == -1;
  // where it is drawn is what the frame's step set (shown)
  k := e2n_ent(n[..], 3, false); n[0].ents[k].shown = NetState.{x = 1.625, z = -20.125};
  #assert e2n_drift_probe(n[..], b + E2N_DRIFT_SHOWN) == 1625 && e2n_drift_probe(n[..], b + E2N_DRIFT_SHOWN + 1) == -20125;
  // never you, never a seat past the room's, never a monster
  #assert e2n_drift_probe(n[..], E2N_DRIFT) == -1 && e2n_drift_probe(n[..], E2N_DRIFT + E2N_DRIFT_SEAT * WIRE_SEATS) == -1 && e2n_drift_probe(n[..], 199) == -1;
  n[0].worlds = 0; #assert e2n_drift_probe(n[..], 200) == -1;
}
#test "the room's rows draw the others a jitter buffer behind, never you, and a snapshot drops who left" {
  n: [1] E2Net; n[0].state = E2N_OPEN; n[0].sock = 1; n[0].mono = 1000;
  e2n_record(n[..], "y 1 0 1000");
  #assert n[0].seat == 1 && n[0].hello_due;
  e2n_step(n[..], 1000); #assert !n[0].hello_due && n[0].pipe[0].n >= 3;   // ping, pins, hello
  // seat 3 runs north; you (1) stand
  for i: 0..<12 {
    e := n[0].ents[0..<1];
    k := e2n_ent(n[..], 3, true); en := n[0].ents[k..<k + 1]; en[0].kind = WK_PLAYER; en[0].seat = 3; en[0].seen = i;
    net_push(en, NetState.{t = 1000 + i * 33, z = -4.25 * f32(i) / 30, vz = -4.25});
    y := e2n_ent(n[..], 1, true); n[0].ents[y].kind = WK_PLAYER; n[0].ents[y].seat = 1; net_push(n[0].ents[y..<y + 1], NetState.{t = 1000 + i * 33});
  }
  e2n_step(n[..], 1300);
  r := e2n_remote(n[..], 0); #assert r.ok && r.seat == 3 && r.z < 0 && r.z > -1.7 && abs(r.speed - 4.25) < 0.01;
  #assert !e2n_remote(n[..], 1).ok && e2n_remotes(n[..]) == 1;
  // the socket goes: so does everyone
  e2n_down(n[..]); #assert e2n_remotes(n[..]) == 0 && n[0].state == E2N_DOWN;
}
#test "your class goes with the hello, your casts go as C, and the others' e cast wait for their tick (#13058)" {
  n: [1] E2Net; n[0].state = E2N_OPEN; n[0].sock = 1; n[0].mono = 1000;
  e2n_set_class(n[..], FB_CL_WIZARD, 1);
  e2n_record(n[..], "y 1 0 1000");
  e2n_step(n[..], 1000);
  pipe := cast(string) n[0].pipe[0].buf[0..<n[0].pipe[0].used];
  has := false; for i: 0..<pipe.count - 10 { if pipe[i..<i + 10] == "srd-wizard" { has = true; } }
  #assert has;
  // Fire Bolt, ahead
  slot := xk_slot(FB_CL_WIZARD, 0);
  #assert e2n_cast(n[..], slot, 0, 1, -20) && n[0].cast_sent == 1;
  last := n[0].pipe[0].n - 1; c := cast(string) n[0].pipe[0].buf[n[0].pipe[0].from[last]..<n[0].pipe[0].from[last] + n[0].pipe[0].len[last]];
  #assert c[0] == 'C';
  // the room's word: yours (counted), another's (waits for the picture to reach its tick), a refusal
  n[0].tick_t = 2000;
  d := WireD.{tick = 5};
  b: [128] u8; m := wire_put_cast_e(b[..], 0, WireCastE.{ss = 1, slot = slot, ax = 0, ay = 1, az = -20, seed = 7});
  e2n_entry(n[..], cast(string) b[0..<m], d);
  m = wire_put_cast_e(b[..], 0, WireCastE.{ss = 4, slot = xk_slot(FB_CL_FIGHTER, 0), ax = 3, ay = 1, az = 2, seed = 9});
  e2n_entry(n[..], cast(string) b[0..<m], d);
  m = wire_put_cast_e(b[..], 0, WireCastE.{ss = 4, slot = 7, ax = 3, ay = 1, az = 2, seed = 9});   // not a kit's: nothing
  e2n_entry(n[..], cast(string) b[0..<m], d);
  #assert n[0].cast_mine == 1 && n[0].cast_heard == 1 && n[0].mine_cast.seed == 7 && n[0].mine_cast.slot == slot;
  #assert !e2n_cast_due(n[..], 1999).live;
  e := e2n_cast_due(n[..], 2000); #assert e.live && e.ss == 4 && e.slot == xk_slot(FB_CL_FIGHTER, 0) && abs(e.ax - 3) < 0.01;
  #assert !e2n_cast_due(n[..], 3000).live;   // once
  // the ledger: that cast is confirmed, so a refusal of it now is no word on anything; the next cast's is, once
  #assert net_action_last(n[0].acts[..], E2N_ACT_CAST).state == NET_ACT_CONFIRMED;
  rb: [64] u8; rn := wire_put(rb[..], 0, "r"); rn = wire_int(rb[..], rn, n[0].cast_seq); rn = wire_put(rb[..], rn, " cooldown");
  e2n_record(n[..], cast(string) rb[0..<rn]); #assert n[0].cast_refused == 0;
  #assert e2n_cast(n[..], slot, 0, 1, -20) && net_action_last(n[0].acts[..], E2N_ACT_CAST).state == NET_ACT_PENDING;
  rn = wire_put(rb[..], 0, "r"); rn = wire_int(rb[..], rn, n[0].cast_seq); rn = wire_put(rb[..], rn, " cooldown");
  e2n_record(n[..], cast(string) rb[0..<rn]); #assert n[0].cast_refused == 1 && net_action_last(n[0].acts[..], E2N_ACT_CAST).state == NET_ACT_REFUSED;
  e2n_record(n[..], cast(string) rb[0..<rn]); #assert n[0].cast_refused == 1;
  // a cast the room never answers times out; a lost socket times out what waits
  #assert e2n_cast(n[..], slot, 0, 1, -20); e2n_step(n[..], n[0].mono + E2N_ACT_WAIT_MS);
  #assert net_action_last(n[0].acts[..], E2N_ACT_CAST).state == NET_ACT_TIMED_OUT && n[0].acts[0].timed_out == 1;
  #assert e2n_cast(n[..], slot, 0, 1, -20); e2n_down(n[..]); #assert net_action_last(n[0].acts[..], E2N_ACT_CAST).state == NET_ACT_TIMED_OUT && n[0].acts[0].timed_out == 2;
}

// Only fixed player-facing text is retained; a server word is never drawn raw.
e2n_cast_reason :: (why:string)->string {
  if why=="cooldown" { return "CAST NOT READY"; }
  if why=="range" { return "OUT OF RANGE"; }
  if why=="sight" { return "NOT IN SIGHT"; }   // a trunk or rock in the way (#13262)
  if why=="slot" { return "ABILITY UNAVAILABLE"; }
  if why=="aim" { return "CANNOT AIM THERE"; }
  return "CAST NOT ALLOWED";
}
e2n_cast_message :: (n:[] E2Net)->string {
  age:=n[0].mono-n[0].cast_said_at;
  if age<0 || age>=4000 { return ""; }
  return n[0].cast_said;
}

#test "cast refusal feedback matches the latest request never raw server text and clears on a new press" {
  n:[1] E2Net; n[0].state=E2N_OPEN; n[0].seat=0; n[0].sock=1;
  #assert e2n_cast(n[..],xk_slot(FB_CL_WIZARD,0),0,1,20);
  seq:=n[0].cast_seq; msg:[128] u8;
  count:=wire_put(msg[..],0,"r "); count=wire_int(msg[..],count,seq-1); count=wire_put(msg[..],count," no");
  e2n_record(n[..],cast(string)msg[0..<count]); #assert n[0].cast_refused==0 && e2n_cast_message(n[..]).count==0;
  e2n_record(n[..],"r malformed no"); e2n_record(n[..],"r 0 no");
  #assert n[0].cast_refused==0;
  count=wire_put(msg[..],0,"r "); count=wire_int(msg[..],count,seq); count=wire_put(msg[..],count," unknown-server-detail");
  e2n_record(n[..],cast(string)msg[0..<count]);
  #assert e2n_cast_message(n[..])=="CAST NOT ALLOWED" && n[0].cast_refused==1;
  n[0].mono=-1; #assert e2n_cast_message(n[..]).count==0;
  n[0].mono=3999; #assert e2n_cast_message(n[..]).count>0;
  n[0].mono=4000; #assert e2n_cast_message(n[..]).count==0;
  #assert e2n_cast(n[..],xk_slot(FB_CL_WIZARD,0),0,1,20);
  #assert n[0].cast_said.count==0;
  #assert e2n_cast_reason("cooldown")=="CAST NOT READY" && e2n_cast_reason("range")=="OUT OF RANGE" && e2n_cast_reason("sight")=="NOT IN SIGHT";
  #assert e2n_cast_reason("slot")=="ABILITY UNAVAILABLE" && e2n_cast_reason("aim")=="CANNOT AIM THERE";
}

// Read the authoritative mirror, not a predicted/default class HP value.
// Snapshot removal, seat replacement and disconnection naturally hide it.
e2n_vitals :: (n:[] E2Net)->WireS {
  if !e2n_open(n) { return WireS.{id=-1}; }
  row:=wire_mirror_of(n[0].mir[..],n[0].seat);
  if row.id!=n[0].seat || row.kind!=WK_PLAYER || row.max<=0 || row.hp<0 || row.hp>row.max || row.temp<0 { return WireS.{id=-1}; }
  return row;
}
#test "your seat's class and level are the room's: its n row sets them, and the page tells the room nothing back (#13259)" {
  n: [1] E2Net; n[0].state = E2N_OPEN; n[0].sock = 1; n[0].mono = 1000;
  e2n_set_class(n[..], FB_CL_FIGHTER, 6);   // Character Create said a level 6 Fighter
  e2n_record(n[..], "y 1 0 1000");
  e2n_step(n[..], 1000);
  #assert n[0].seat == 1 && !n[0].change_due;
  d := WireD.{tick = 5};
  b: [160] u8;
  // the room sat you at the ticket's level 1
  m := wire_put_n(b[..], 0, WireN.{ss = 1, id = "p-1", look = "ranger.0.0.0", kind = "srd-fighter", flags = 0, name = "Ash"});
  e2n_entry(n[..], cast(string) b[0..<m], d);
  #assert n[0].klass == FB_CL_FIGHTER && n[0].level == 1 && n[0].served && !n[0].hello_due && !n[0].change_due;
  // a level its XP gave
  m = wire_put_n(b[..], 0, WireN.{ss = 1, id = "p-1", look = "ranger.0.0.0", kind = "srd-fighter-2", flags = 0, name = "Ash"});
  n[0].served = false; e2n_entry(n[..], cast(string) b[0..<m], d);
  #assert n[0].level == 2 && n[0].served && !n[0].change_due;
  // another seat's row is theirs
  m = wire_put_n(b[..], 0, WireN.{ss = 2, id = "p-2", look = "ranger.0.0.0", kind = "srd-wizard-5", flags = 0, name = "Bo"});
  n[0].served = false; e2n_entry(n[..], cast(string) b[0..<m], d);
  #assert n[0].klass == FB_CL_FIGHTER && n[0].level == 2 && !n[0].served;
  // your own change waiting to go is not undone by a row from before it
  e2n_set_class(n[..], FB_CL_BARD, 3);
  m = wire_put_n(b[..], 0, WireN.{ss = 1, id = "p-1", look = "ranger.0.0.0", kind = "srd-fighter-2", flags = 0, name = "Ash"});
  e2n_entry(n[..], cast(string) b[0..<m], d);
  #assert n[0].klass == FB_CL_BARD && n[0].level == 3 && n[0].change_due;
}
