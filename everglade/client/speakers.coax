// Everglade's speakers on the page (#13381, #13293): the Warden and anyone else the content tables
// say stands and talks. A speaker is rows: a creature, its template of the `stands` behavior
// (everglade/model/content.coax EC_STYLE_STANDS), a spawn at a point and its troop (the way it faces).
// The page draws each where its spawn's point is, a Character Create body in a ranger's leathers,
// turned to you when you come near, with its name over it. A speaker walks nowhere and nothing strikes
// it, so the room sends no row for it: every page reads the same tables (the content pin), and so draws
// it in the same place. Its dialogue is the room's (everglade/client/bag.coax: the prompt, E SEQ 6 ID).
//   coax/bin/coax test --library everglade/client/client.coax --only speaker

E2SP_N :: 4;              // speakers drawn at most
E2SP_TURN_AT :: 9.0;      // m: inside this it turns to you
E2SP_TURN :: 2.5;         // how fast it turns, a second
E2SP_FAR :: 110.0;        // m: past this it isn't drawn
E2SP_BODY :: 0.45;        // m: its body, to walk round
E2SP_WORN :: [7] int.[22, 23, 24, 25, 27, 34, 35];   // the ranger's pauldrons, arms, body, feet, legs, bracer and belt (charactercreator-parts.coax)

E2Speaker :: struct {
  anim: [1] figs.BdAnim; on: bool;
  creature: int;                    // its creature's content ID: its name is that row's
  x: f32; y: f32; z: f32; yaw: f32; home_yaw: f32;
  sight: cc.HudSight; drawn: int;
}
E2Speakers :: struct { who: [E2SP_N] E2Speaker; n: int; placed: bool; }

// The speakers of tables d, into sp: each troop whose spawn's creature has a template of the stands behavior.
e2sp_read :: (d: [] ContentDoc, sp: [] E2Speakers) {
  sp[0].n = 0; sp[0].placed = true;
  if !ec_wild(d) { return; }
  for r: 0..<ct_rows(d, EC_TROOP) {
    sr := ct_find(d, EC_SPAWN, ct_get(d, EC_TROOP, r, EC_TROOP_SPAWN)); creature := ct_get(d, EC_SPAWN, sr, EC_SPAWN_CREATURE);
    stands := false;
    for t: 0..<ct_rows(d, EC_TEMPLATE) { if ct_get(d, EC_TEMPLATE, t, EC_TEMPLATE_CREATURE) == creature && ct_get(d, EC_TEMPLATE, t, EC_TEMPLATE_STYLE) == EC_STYLE_STANDS { stands = true; } }
    pr := ct_find(d, EC_POINT, ct_get(d, EC_SPAWN, sr, EC_SPAWN_POINT));
    if !stands || sp[0].n >= E2SP_N { continue; }
    x := f32(ct_get(d, EC_POINT, pr, EC_POINT_X)) * 0.01; z := f32(ct_get(d, EC_POINT, pr, EC_POINT_Z)) * 0.01;
    yaw := figs.wrap_angle(f32(ct_get(d, EC_TROOP, r, EC_TROOP_FACE) % 360) * 0.017453293);
    w := sp[0].who[sp[0].n..<sp[0].n + 1]; sp[0].n += 1;
    w[0] = E2Speaker.{on = true, creature = creature, x = x, z = z, yaw = yaw, home_yaw = yaw};
    a := w[0].anim[..]; a[0].on = true; a[0].x = x; a[0].z = z; a[0].lx = x; a[0].lz = z; a[0].yaw = yaw; a[0].own = true;
  }
}
e2sp_name :: (s: [] E2, w: E2Speaker) -> string { d := s[0].bag[0].doc[..]; return ct_str(d, EC_CREATURE, ct_find(d, EC_CREATURE, w.creature), EC_NAME); }
// Each frame: read once the tables are; each turns toward you when you are near, else the way its troop faces.
e2sp_step :: (s: [] E2, dt: f32) {
  sp := s[0].speakers[..];
  if !sp[0].placed { if !s[0].bag[0].loaded { return; } e2sp_read(s[0].bag[0].doc[..], sp); }
  for i: 0..<sp[0].n {
    w := sp[0].who[i..<i + 1]; dx := s[0].you_x - w[0].x; dz := s[0].you_z - w[0].z;
    want := ifx dx * dx + dz * dz < f32(E2SP_TURN_AT) * f32(E2SP_TURN_AT) && e2p_in_world(s) then figs.atan2(dx, dz) else w[0].home_yaw;
    t := dt * f32(E2SP_TURN); if t > 1 { t = 1; }
    w[0].yaw = figs.wrap_angle(w[0].yaw + figs.wrap_angle(want - w[0].yaw) * t);
  }
}
e2sp_dress :: (c: [] cc.Creator) {
  c[0].female = false; for i: 0..<40 { c[0].worn[i] = false; }
  for w: E2SP_WORN { c[0].worn[w] = true; }
  c[0].hood = false; c[0].beard = true; c[0].hair = 1; c[0].hair_color = 2; c[0].dye = 4; c[0].skin = 2; c[0].variant = 0; c[0].eye_color = 0;
}
e2sp_draw :: (s: [] E2, at: E2Drawn, bdt: f32) -> E2Drawn {
  sp := s[0].speakers[..]; d := at;
  for i: 0..<sp[0].n {
    w := sp[0].who[i..<i + 1]; dx := w[0].x - s[0].eye[0]; dz := w[0].z - s[0].eye[2];
    if dx * dx + dz * dz > f32(E2SP_FAR) * f32(E2SP_FAR) { continue; }
    a := w[0].anim[..]; a[0].x = w[0].x; a[0].z = w[0].z; a[0].y = e2g_y(s[0].eg[..], w[0].x, w[0].z); a[0].yaw = w[0].yaw; a[0].own = true;
    w[0].y = a[0].y;
    figs.bd_step(a, s[0].clock, bdt);
    s[0].rtmp[0] = s[0].creator[0]; e2sp_dress(s[0].rtmp[..]);
    was := d.rec; d = e2_body_of(s, s[0].rtmp[0], a[0], d, true);
    if d.rec > was { w[0].drawn += 1; }
  }
  return d;
}
e2sp_plate_add :: (s: [] E2, pl: [] cc.HudPlates, view: cc.HudPlateView) {
  sp := s[0].speakers[..];
  for i: 0..<sp[0].n {
    w := sp[0].who[i..<i + 1]; y := w[0].y + 2.05;
    w[0].sight = ifx cc.hud_plate_in_reach(view, w[0].x, y, w[0].z, cc.HUD_PLATE_FAR) then e2_sight_step(s, w[0].sight, w[0].x, w[0].y, w[0].z, 1.9) else cc.hud_sight_gone();
    cc.hud_plates_push(pl, w[0].x, y, w[0].z, e2sp_name(s, w[0]), -1, false, false, w[0].sight.share);
  }
}
e2sp_drive :: (s: [] E2, d: [] Drive) {
  sp := s[0].speakers[..];
  for i: 0..<sp[0].n { w := sp[0].who[i]; drv_add(d, DRV_NPC, "speaker", w.creature, e2sp_name(s, w), w.x, w.y, w.z, -1, -1, false); }
}

#test "speaker: the Warden stands at the glade's edge, where his dialogue is heard, on ground you may stand on, and turns to you (#13381)" #steps 400000000 {
  s: [1] E2; s[0].placed = true; e2i_load(s[..]); e2sp_step(s[..], 0.016);
  sp := s[0].speakers[..]; #assert sp[0].placed && sp[0].n == 1;
  w := sp[0].who[0]; d := s[0].bag[0].doc[..];
  #assert e2sp_name(s[..], w) == "Warden" && e2_may_stand(w.x, w.z) && e2_zone(w.x, w.z) == 0 && w.x == 3 && w.z == -5;
  // every dialogue of his is heard where he stands
  for r: 0..<ct_rows(d, EC_DIALOGUE) {
    p := ct_find(d, EC_POINT, ct_get(d, EC_DIALOGUE, r, EC_DIALOGUE_POINT));
    #assert ct_str(d, EC_DIALOGUE, r, EC_NAME) == "Warden" && f32(ct_get(d, EC_POINT, p, EC_POINT_X)) * 0.01 == w.x && f32(ct_get(d, EC_POINT, p, EC_POINT_Z)) * 0.01 == w.z;
  }
  // he faces the glade's middle at rest, and you when you come near
  #assert abs(figs.wrap_angle(w.home_yaw - figs.atan2(-w.x, -w.z))) < 0.02;
  s[0].you_x = w.x + 4; s[0].you_z = w.z; for q: 0..<240 { e2sp_step(s[..], 0.016); }
  #assert abs(figs.wrap_angle(sp[0].who[0].yaw - 1.5707963)) < 0.01;
  s[0].you_x = w.x + 40; for q: 0..<240 { e2sp_step(s[..], 0.016); }
  #assert abs(figs.wrap_angle(sp[0].who[0].yaw - w.home_yaw)) < 0.01;
  // tables with no template and troop have no speakers; the room's guard and monsters are not speakers
  o: [1] ContentDoc; q: [1] E2Speakers; #assert ct_read(o[..], EC_FIXTURE); e2sp_read(o[..], q[..]); #assert q[0].placed && q[0].n == 0;
  c: [1] cc.Creator; e2sp_dress(c[..]); n := 0; for i: 0..<40 { if c[0].worn[i] { n += 1; } } #assert n == 7 && !c[0].female;
}
