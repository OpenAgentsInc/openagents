// Everglade II's colliders through the real controller step (everglade-step.coax): you walk into a rock
// from three sides and stop at its side, step onto a low one, jump onto the glade's mossy one and stand
// on its top, stop at a trunk, and run the path, at Everglade II's own pace.
//   coax/bin/coax test --library everglade/client/walk-test.coax
#load "client.coax";
#load "../shared/everglade-step.coax" as step;
#load "cells.coax";   // the world's cell controller, stepped in the route walks as the page steps it
#load "../../aethyr/move/walk.coax" as walk;
#load "../../aethyr/physics/query.coax" as scaled;

// Walks you from (x, z) toward (tx, tz) for `seconds` among `bodies` and `hulls`, running or walking;
// where you end, and how you stand.
e2t_walk_among :: (x: f32, z: f32, tx: f32, tz: f32, bodies: [] f32, hulls: [] f32, running: bool, seconds: f32) -> walk.Player {
  p := walk.walk_place(x, 0, z, 0);
  // theta is the camera's: forward goes along -(sin theta, cos theta)
  theta := e2_walk_theta(walk.atan2(tx - x, tz - z));
  // running: no Shift (the keys run by default); walking: Shift held
  i := EgMoveIn.{key_y = 1, run = !running, theta = theta};
  i.run = walk.walk_runs(i.run, false, 0, 0);
  w: EgMoveWorld; w.deck = true; w.bodies = bodies.count / 7; w.hulls = hulls.count; w.pace = e2_pace(i.run);
  none: [1] f32;
  steps := cast(int) (seconds * 64);
  for k: 0..<steps { p.body = step.eg_step_begin(p.body, i, w, 1.0f32 / 64); p.body = step.eg_step_advance_among(p.body, w, bodies, none[0..<0], none[0..<0], hulls, 1.0f32 / 64); }
  return p;
}
e2t_walk :: (x: f32, z: f32, tx: f32, tz: f32, bodies: [] f32, running: bool, seconds: f32) -> walk.Vec3 {
  none: [1] f32; return e2t_walk_among(x, z, tx, tz, bodies, none[0..<0], running, seconds).body.pos;
}
e2t_segment_distance :: (px: f32, pz: f32, ax: f32, az: f32, bx: f32, bz: f32) -> f32 {
  dx := bx - ax; dz := bz - az; l := dx * dx + dz * dz;
  t := ifx l > 0 then ((px - ax) * dx + (pz - az) * dz) / l else 0.0f32; t = ifx t < 0 then 0 else ifx t > 1 then 1 else t;
  qx := ax + dx * t - px; qz := az + dz * t - pz; return sqrt(qx * qx + qz * qz);
}

// The glade's mossy rock by the path, right of the spawn (verse/character-glade.coax cg_item 20: a
// Rock_Big_1 about a metre high), as the page and the room step you among it.
e2t_rock :: (out: [] f32, rock: E2Rock) -> int { return e2_rock_hull(out, 0, rock, rock.x, rock.z); }
// How far you are from a hull's side at your step height, middle and head: the nearest of the three.
e2t_side :: (h: [] f32, p: walk.Player) -> f32 {
  k := scaled.query_hull(h, 0); near := 1000.0f32;
  for i: 0..<3 { g := scaled.query_hull_gap(h, k, p.body.pos.x, p.body.pos.y + 0.55 + 1.25 * f32(i) / 2, p.body.pos.z); if g.gap < near { near = g.gap; } }
  return near;
}
#test "walking into the glade's mossy rock from three sides stops you at its side, where you see it" #steps 400000000 {
  h: [E2_HULL_HEAD + E2_HULL_FACES * E2_HULL_FACE] f32; r := e2_glade_rock(cg_item(20)); n := e2t_rock(h[..], r); #assert n > 0 && r.model == 4;
  for side: 0..<3 {
    a := f32(side) * 1.5708 + 0.3; sx := r.x + cos(a) * 5; sz := r.z + sin(a) * 5;
    p := e2t_walk_among(sx, sz, r.x, r.z, h[0..<0], h[0..<n], false, 3);
    d := e2t_side(h[0..<n], p);
    // you went most of the way, up its low skirt if it has one, and stopped your radius from the part
    // too high to step onto, short of its middle, your feet on what is under you
    w: walk.World; w.hulls = h[0..<n];
    #assert sqrt((p.body.pos.x - sx) * (p.body.pos.x - sx) + (p.body.pos.z - sz) * (p.body.pos.z - sz)) > 2.5;
    #assert sqrt((p.body.pos.x - r.x) * (p.body.pos.x - r.x) + (p.body.pos.z - r.z) * (p.body.pos.z - r.z)) > 0.4;
    #assert d >= 0.3 - 0.02;
    #assert d < 0.3 + 0.05;
    #assert p.body.collision_refusals == 0;
    #assert abs(p.body.pos.y - walk.floor_at(w, p.body.pos.x, p.body.pos.z, p.body.pos.y)) < 0.03 && p.body.pos.y < 0.55;
  }
}
#test "you step up onto a low rock, walk across its top with your feet on it, and down off it" #steps 400000000 {
  h: [E2_HULL_HEAD + E2_HULL_FACES * E2_HULL_FACE] f32; r := e2_glade_rock(cg_item(21)); n := e2t_rock(h[..], r);
  #assert n > 0 && h[2] > 0.2 && h[2] < f32(walk.STEP_UP);
  k := scaled.query_hull(h[0..<n], 0);
  p := walk.walk_place(r.x - 3, 0, r.z, 0);
  w: EgMoveWorld; w.deck = true; w.hulls = n; w.pace = e2_pace(false); none: [1] f32; up := 0.0f32; stood := false;
  // walk at it and stop over its middle; stand a moment; walk on off it
  for t: 0..<448 {
    go := t < 64 * 7 && (p.body.pos.x < r.x || t > 64 * 4);
    i := EgMoveIn.{key_y = ifx go then 1.0f32 else 0.0f32, run = false, theta = e2_walk_theta(1.5708)};
    p.body = step.eg_step_begin(p.body, i, w, 1.0f32 / 64); p.body = step.eg_step_advance_among(p.body, w, none[0..<0], none[0..<0], none[0..<0], h[0..<n], 1.0f32 / 64);
    if p.body.pos.y > up { up = p.body.pos.y; }
    if t == 64 * 4 - 1 {
      // standing on its top: your feet on it, not floating, not sunk
      top := scaled.query_hull_top(h[0..<n], k, p.body.pos.x, p.body.pos.z);
      #assert top.over && top.y > 0.2 && abs(p.body.pos.y - top.y) < 0.02 && p.body.on_ground; stood = true;
    }
  }
  #assert stood && up > 0.2 && p.body.pos.x > r.x + 1 && p.body.pos.y < 0.05 && p.body.collision_refusals == 0;
}
#test "you jump onto the glade's mossy rock and stand on its top, feet on it" #steps 400000000 {
  h: [E2_HULL_HEAD + E2_HULL_FACES * E2_HULL_FACE] f32; r := e2_glade_rock(cg_item(20)); n := e2t_rock(h[..], r);
  k := scaled.query_hull(h[0..<n], 0); #assert h[2] > 0.8 && h[2] < 1.6;
  mid := scaled.query_hull_top(h[0..<n], k, r.x, r.z); #assert mid.over && mid.y > 0.7;
  p := walk.walk_place(r.x - 3, 0, r.z, 0); theta := e2_walk_theta(1.5708);
  w: EgMoveWorld; w.deck = true; w.hulls = n; w.pace = e2_pace(false); none: [1] f32;
  // up to it at a jog, a jump a stride from its side, the key held until over it, then still
  for t: 0..<320 {
    side := e2t_side(h[0..<n], p);
    i := EgMoveIn.{key_y = ifx p.body.pos.x < r.x - 0.2 then 1.0f32 else 0.0f32, run = false, theta = theta, jump = side < 0.9 && p.body.on_ground && p.body.pos.y < 0.1};
    p.body = step.eg_step_begin(p.body, i, w, 1.0f32 / 64); p.body = step.eg_step_advance_among(p.body, w, none[0..<0], none[0..<0], none[0..<0], h[0..<n], 1.0f32 / 64);
  }
  top := scaled.query_hull_top(h[0..<n], k, p.body.pos.x, p.body.pos.z);
  #assert top.over && p.body.on_ground && p.body.pos.y > 0.7 && abs(p.body.pos.y - top.y) < 0.03 && p.body.collision_refusals == 0;
}
#test "walking straight into a trunk stops you, and you pass close beside it" {
  t := e2_trunk(2, 3, -80, 1.1, 0.8);   // a CommonTree_3
  b := [7] f32.[t[0], 0.3, t[1], t[0], 1.6, t[1], t[2]];
  e := e2t_walk(t[0] + 8, t[1], t[0], t[1], b[..], true, 4);
  d := sqrt((e.x - t[0]) * (e.x - t[0]) + (e.z - t[1]) * (e.z - t[1]));
  #assert d >= t[2] + 0.3 - 0.05 && d < t[2] + 0.3 + 0.25;
  // aimed to pass 0.9 m from its middle, you go by without a nudge
  f := e2t_walk(t[0] + 8, t[1] + 0.9, t[0] - 8, t[1] + 0.9, b[..], true, 3);
  #assert f.x < t[0] - 3 && abs(f.z - (t[1] + 0.9)) < 0.05;
}
#test "you jog at about 4.25 m/s and stroll at about 1.5 m/s" {
  none: [1] f32;
  r := e2t_walk(0, 0, 0, -100, none[0..<0], true, 4);
  w := e2t_walk(0, 0, 0, -100, none[0..<0], false, 4);
  // four seconds, less the moment's start
  #assert -r.z > 4.25 * 4 - 0.6 && -r.z < 4.25 * 4 + 0.01;
  #assert -w.z > 1.5 * 4 - 0.3 && -w.z < 1.5 * 4 + 0.01;
}
// Walks the path from the glade to the clearing, `off` metres to the side of its middle, among every
// collider the page builds (planted trees and rocks, the glade's own) and inside where you may stand:
// from 2 m down the path past the spawn to the clearing, both Everglade II's named points
// (verse/everglade2/points.coax, #13078: z -2 and -470 on 11-09). The longest you were held up
// (seconds), and whether you reached the clearing (1000 when not, or when the map lacks either).
E2T_PATH_FROM :: 2.0;   // m down the path past the spawn the walk starts
e2t_path_walk :: (s: [] E2, off: f32) -> f32 {
  spawn := e2_point("spawn"); clearing := e2_point("clearing");
  if !spawn.found || !clearing.found { return 1000; }
  z0 := spawn.z - f32(E2T_PATH_FROM);
  p := walk.walk_place(e2_road_x(z0) + off, 0, z0, 0);
  dt := 1.0f32 / 20; held := 0.0f32; worst := 0.0f32;
  for k: 0..<3000 {
    x := p.body.pos.x; z := p.body.pos.z;
    if z < clearing.z { return worst; }
    tz := z - 3; tx := e2_road_x(tz) + off;
    i := EgMoveIn.{key_y = 1, run = false, theta = e2_walk_theta(walk.atan2(tx - x, tz - z))};
    i.run = walk.walk_runs(i.run, false, 0, 0);
    w := e2_move_world(s, x, z); w.pace = e2_pace(i.run);
    none: [1] f32;
    p.body = step.eg_step_begin(p.body, i, w, dt); p.body = step.eg_step_advance_among(p.body, w, s[0].move_bodies[0..<w.bodies * 7], none[0..<0], none[0..<0], s[0].move_hulls[0..<w.hulls], dt);
    kept := e2_keep(s, p.body.pos.x, p.body.pos.z);
    if kept.x != p.body.pos.x || kept.z != p.body.pos.z { return 1000; }   // an edge you can't see, on the path
    s[0].you_x = p.body.pos.x; s[0].you_z = p.body.pos.z;
    if z - p.body.pos.z < f32(E2_RUN_SPEED) * dt * 0.5 { held += dt; if held > worst { worst = held; } } else { held = 0; }
  }
  return 1000;
}
// A moment's slowing where the path bends is fine; being held up is not.
#test "the path walk runs between Everglade II's named spawn and clearing" {
  #assert e2_point("spawn").found && e2_point("clearing").found && e2_point("clearing").z == f32(E2_CLEAR_Z);
}
#test "you run the whole path, glade to clearing, down its middle, and nothing stops you" #steps 6000000000 {
  s: [1] E2; s[0].planted = e2_plant(s[0].items[..], s[0].kinds[..], s[0].first[..]); s[0].plant_done = true;
  #assert e2t_path_walk(s[..], 0) < 0.3;
}
#test "you run the whole path a metre left of its middle, and nothing stops you" #steps 6000000000 {
  s: [1] E2; s[0].planted = e2_plant(s[0].items[..], s[0].kinds[..], s[0].first[..]); s[0].plant_done = true;
  #assert e2t_path_walk(s[..], -1) < 0.3;
}
#test "you run the whole path a metre right of its middle, and nothing stops you" #steps 6000000000 {
  s: [1] E2; s[0].planted = e2_plant(s[0].items[..], s[0].kinds[..], s[0].first[..]); s[0].plant_done = true;
  #assert e2t_path_walk(s[..], 1) < 0.3;
}

// ---- the route walks, one a place (GitHub #13280): what you can see you can walk to. Each walks
// from the place before to a named point of this one, down the path's middle and then straight at
// the point, through the real controller among every collider the page builds, with the world's
// cells stepped as the page steps them (everglade/client/cells.coax). The longest you were held up
// (seconds); 1000 when you never arrived, 2000 when an edge you can't see turned you, 3000 when your
// cell did not simulate as you stepped into it. `turn`: metres short of the point, along the path,
// from where you leave the path's middle and walk straight at it.
E2T_ROUTE_TURN :: 30.0;
e2t_route :: (s: [] E2, x0: f32, z0: f32, tx: f32, tz: f32, near: f32, turn: f32) -> f32 {
  c: [1] E2Cells; if !e2cl_start(c[..], s[0].cl[..]) { return 1000; }
  p := walk.walk_place(x0, 0, z0, 0);
  dt := 1.0f32 / 20; held := 0.0f32; worst := 0.0f32;
  for k: 0..<3000 {
    x := p.body.pos.x; z := p.body.pos.z;
    _c := e2cl_frame(c[..], s[0].cl[..], x, z, x, z, true);
    if !e2cv_may_enter(s[0].cl[..], x, z) || c[0].held > 0 || c[0].off > 0 { return 3000; }
    gx := tx - x; gz := tz - z; gap := sqrt(gx * gx + gz * gz);
    if gap < near { return worst; }
    ax := tx; az := tz;
    if z - tz > turn { az = z - 3; ax = e2_road_x(az); }
    i := EgMoveIn.{key_y = 1, run = false, theta = e2_walk_theta(walk.atan2(ax - x, az - z))};
    i.run = walk.walk_runs(i.run, false, 0, 0);
    w := e2_move_world(s, x, z); w.pace = e2_pace(i.run);
    none: [1] f32;
    p.body = step.eg_step_begin(p.body, i, w, dt); p.body = step.eg_step_advance_among(p.body, w, s[0].move_bodies[0..<w.bodies * 7], none[0..<0], none[0..<0], s[0].move_hulls[0..<w.hulls], dt);
    kept := e2_keep(s, p.body.pos.x, p.body.pos.z);
    if kept.x != p.body.pos.x || kept.z != p.body.pos.z { return 2000; }
    s[0].you_x = p.body.pos.x; s[0].you_z = p.body.pos.z;
    mx := p.body.pos.x - x; mz := p.body.pos.z - z;
    if sqrt(mx * mx + mz * mz) < f32(E2_RUN_SPEED) * dt * 0.5 { held += dt; if held > worst { worst = held; } } else { held = 0; }
  }
  return 1000;
}
// A path point's place in the world: its x is metres across from the path's middle at its z.
e2t_at :: (name: string) -> walk.Vec3 { p := e2_point(name); return walk.Vec3.{x = e2_road_x(p.z) + p.x, y = 0, z = p.z}; }
#test "route walk, The Glade: from the spawn to the guard's post" #steps 6000000000 {
  s: [1] E2; s[0].planted = e2_plant(s[0].items[..], s[0].kinds[..], s[0].first[..]); s[0].plant_done = true;
  to := e2t_at("guard-post"); #assert e2_point("guard-post").found && e2_zone(to.x, to.z) == 0;
  #assert e2t_route(s[..], f32(E2_SPAWN_X), f32(E2_SPAWN_Z) - f32(E2T_PATH_FROM), to.x, to.z, 1, f32(E2T_ROUTE_TURN)) < 0.3;
}
#test "route walk, The Sunlit Path: from the guard's post into the woods" #steps 6000000000 {
  s: [1] E2; s[0].planted = e2_plant(s[0].items[..], s[0].kinds[..], s[0].first[..]); s[0].plant_done = true;
  from := e2t_at("guard-post"); to := e2t_at("woods"); #assert e2_point("woods").found && e2_zone(to.x, to.z) == 1;
  #assert e2t_route(s[..], from.x, from.z, to.x, to.z, 1, f32(E2T_ROUTE_TURN)) < 0.3;
}
#test "route walk, The Deep Canopy: from the woods to under the deepest canopy" #steps 6000000000 {
  s: [1] E2; s[0].planted = e2_plant(s[0].items[..], s[0].kinds[..], s[0].first[..]); s[0].plant_done = true;
  from := e2t_at("woods"); to := e2t_at("deep-canopy"); #assert e2_point("deep-canopy").found && e2_zone(to.x, to.z) == 2;
  #assert e2t_route(s[..], from.x, from.z, to.x, to.z, 1, f32(E2T_ROUTE_TURN)) < 0.3;
}
#test "route walk, The Clearing: from the deep canopy to the clearing's middle" #steps 6000000000 {
  s: [1] E2; s[0].planted = e2_plant(s[0].items[..], s[0].kinds[..], s[0].first[..]); s[0].plant_done = true;
  from := e2t_at("deep-canopy"); to := e2t_at("clearing"); #assert e2_zone(to.x, to.z) == 3;
  #assert e2t_route(s[..], from.x, from.z, to.x, to.z, 1, f32(E2T_ROUTE_TURN)) < 0.3;
}
#test "route walk, Goblin Camp: from the path's last bend to the camp" #steps 6000000000 #traversal 1000000000 {
  s: [1] E2; s[0].planted = e2_plant(s[0].items[..], s[0].kinds[..], s[0].first[..]); s[0].plant_done = true;
  from := walk.Vec3.{x = e2_road_x(-400), y = 0, z = -400}; #assert e2_point("goblin-camp").found && e2_zone(e2_camp_x(), f32(E2_CAMP_Z)) == 4;
  // down the path until you are level with the camp, then across the clearing's grass to within
  // sight of its fire: the camp's own things stand in its middle
  held := e2t_route(s[..], from.x, from.z, e2_camp_x(), f32(E2_CAMP_Z), 8, 0.5);
  #assert held != 3000;
  #assert held != 2000;
  #assert held != 1000;
  #assert held < 0.3;
}
#test "everywhere you may stand is a cell of the world's manifest" #steps 6000000000 {
  c: [1] E2Cells; v: [1] E2CellView; #assert e2cl_start(c[..], v[..]);
  stood := 0;
  for j: 0..<361 { for i: 0..<211 {
    x := f32(E2_WEST) + f32(i) * 2; z := f32(E2_BACK) - f32(j) * 2;
    if !e2_may_stand(x, z) { continue; }
    stood += 1; #assert e2cv_of(v[..], f64(x), f64(z)) >= 0;
  } }
  #assert stood > 2000;
}
