// Everglade II's wildlife: one cat in the glade near where you start (everglade/creatures/cat.coax,
// the game layer's cat: its frames, its wandering, sitting and looking at a player who comes close).
// This unit only places it, hands it the nearest player and draws the frame the game layer names on
// the land, as a moved-mesh record (charactercreator.coax familiar_record).
//
// ?stage=cat is the cat's shot (docs/metaverse/clips.md): it sits in the glade's light and looks at the
// camera, which sits low at its eye level, where its turned head looks (egcat.EG_CAT_LOOK off its
// body's facing, so the sit shows in three-quarter view), and closes in slowly over ten seconds. A
// staged shot opens no room.
//   coax/bin/coax test --library everglade/client/client.coax --only cat
#load "../creatures/cat.coax" as egcat;

E2W_CAT_X :: 2.4; E2W_CAT_Z :: -4.2; E2W_CAT_YAW :: 2.6;   // its home in the glade, south-east of you
E2W_CAT_SEED :: 293;
// The stage: the cat sits on the glade's path (the grass would hide it), STAGE_Z down it, facing
// back along it; the camera EYE_UP over the ground and FAR out where it looks, closing to NEAR over
// CLOSE_S seconds, looking at AIM_UP over the ground, so the glade stands behind the cat.
E2W_STAGE_Z :: -7.0; E2W_STAGE_YAW :: 3.0; E2W_STAGE_FAR :: 1.05; E2W_STAGE_NEAR :: 0.8; E2W_STAGE_CLOSE_S :: 10.0;
E2W_STAGE_EYE_UP :: 0.28; E2W_STAGE_AIM_UP :: 0.17;

E2Wild :: struct {
  cat: [1] egcat.EgCat; frames: [1] egcat.EgCatFrames;
  placed: bool; stage: bool; stage_at: f32 = -1;
  drawn: int;   // frames the cat was drawn (e2_probe)
}

// The page's facts: ?stage=cat.
e2w_stage :: (t: string) -> bool { return e2c_fact_has(t, "stage=cat"); }
// The stage puts you down the path behind the camera, facing on along it, out of the shot.
E2W_STAGE_YOU_Z :: -20.0;
e2w_stage_you :: (s: [] E2) {
  z := f32(E2W_STAGE_YOU_Z); s[0].start_z = z; s[0].start_x = e2_road_x(z); s[0].start_face = 3.14159265; s[0].start_kept = true;
}
e2w_catalog :: (s: [] E2, text: string) { egcat.eg_cat_catalog(s[0].wild[0].frames[..], text); }

// Each frame: placed once, then stepped with you as the nearest player.
e2w_step :: (s: [] E2, dt: f32) {
  w := s[0].wild[..];
  if !w[0].placed {
    w[0].placed = true;
    if w[0].stage { z := f32(E2W_STAGE_Z); egcat.eg_cat_hold(w[0].cat[..], e2_road_x(z), z, f32(E2W_STAGE_YAW)); }
    else { egcat.eg_cat_place(w[0].cat[..], f32(E2W_CAT_X), f32(E2W_CAT_Z), f32(E2W_CAT_YAW), E2W_CAT_SEED, s[0].clock); }
  }
  egcat.eg_cat_step(w[0].cat[..], s[0].clock, dt, s[0].placed && !e2c_creating(s), s[0].you_x, s[0].you_z);
  // it stands on the land, where it went (out of the trunks and rocks)
  if !w[0].cat[0].held { c := w[0].cat[0]; k := e2m_keep(c.x, c.z, c.x, c.z); w[0].cat[0].x = k.x; w[0].cat[0].z = k.z; }
}

// The stage's shot: low, at the cat's eye, where its head looks, closing in.
e2w_shot :: (s: [] E2, shot: figs.Shot) -> figs.Shot {
  w := s[0].wild[..];
  if !w[0].stage || !w[0].placed { return shot; }
  if w[0].stage_at < 0 { w[0].stage_at = s[0].clock; }
  c := w[0].cat[0]; t := e2_sat((s[0].clock - w[0].stage_at) / f32(E2W_STAGE_CLOSE_S));
  e := t * t * (3 - 2 * t);
  far := f32(E2W_STAGE_FAR) + (f32(E2W_STAGE_NEAR) - f32(E2W_STAGE_FAR)) * e;
  y := e2g_y(s[0].eg[..], c.x, c.z);
  seen := shot;
  look := c.yaw + f32(egcat.EG_CAT_LOOK);
  seen.eye = figs.v3(c.x + sin(look) * far, y + f32(E2W_STAGE_EYE_UP), c.z + cos(look) * far);
  seen.at = figs.v3(c.x, y + f32(E2W_STAGE_AIM_UP), c.z);
  return seen;
}

// The cat's record and draw, when the pack has its frames.
e2w_draw :: (s: [] E2, at: E2Drawn) -> E2Drawn {
  d := at; w := s[0].wild[..]; f := w[0].frames[0];
  if !w[0].placed || f.n < egcat.EG_CAT_FRAMES || d.rec >= E2_RECORDS || d.n >= E2_DRAWS - 1 { return d; }
  c := w[0].cat[0]; k := egcat.eg_cat_frame(c, s[0].clock);
  if f.count[k] <= 0 { return d; }
  cc.familiar_record(s[0].records[..], d.rec, f.word[k], c.x, e2g_y(s[0].eg[..], c.x, c.z), c.z, c.yaw);
  d.n = e2_draw(s[0].draws[..], d.n, f.first[k], f.count[k], d.rec, 1);
  d.sn = e2_draw(s[0].shadow[..], d.sn, f.first[k], f.count[k], d.rec, 1);
  d.rec += 1; w[0].drawn += 1;
  return d;
}

#test "?stage=cat holds the cat sitting in front of a low camera that closes in, and draws its frame" #steps 40000000 {
  #assert e2w_stage("url=/worlds/everglade2?stage=cat\n") && !e2w_stage("url=/worlds/everglade2?stage=cats\n");
  s: [1] E2; s[0].wild[0].stage = true; s[0].clock = 1;
  e2w_step(s[..], 0.1);
  c := s[0].wild[0].cat[0];
  #assert c.held && c.mode == egcat.EG_CAT_SIT && abs(c.x - e2_road_x(f32(E2W_STAGE_Z))) < 0.01;
  shot := e2w_shot(s[..], figs.Shot.{});
  dx := shot.eye.x - c.x; dz := shot.eye.z - c.z;
  look := c.yaw + f32(egcat.EG_CAT_LOOK);
  #assert abs(sqrt(dx * dx + dz * dz) - f32(E2W_STAGE_FAR)) < 0.01 && (dx * sin(look) + dz * cos(look)) > 1.0;   // where its head looks
  s[0].clock = 20; shot = e2w_shot(s[..], figs.Shot.{}); dx = shot.eye.x - c.x; dz = shot.eye.z - c.z;
  #assert abs(sqrt(dx * dx + dz * dz) - f32(E2W_STAGE_NEAR)) < 0.01;
  // the page's frames in the catalog, then its record
  t: [4096] u8; n := 0;
  for i: 0..<egcat.EG_CAT_FRAMES { row := "C glade/cat"; for ch: row { t[n] = ch; n += 1; } if i >= 10 { t[n] = cast(u8)('0' + i / 10); n += 1; } t[n] = cast(u8)('0' + i % 10); n += 1; for ch: " 100 30 245 5000 0 0\n" { t[n] = ch; n += 1; } }
  e2w_catalog(s[..], cast(string) t[0..<n]);
  d := e2w_draw(s[..], E2Drawn.{rec = 3});
  #assert d.rec == 4 && d.n == 1 && s[0].records[3 * 24 + 7] == 5000 && s[0].records[3 * 24 + 15] == 18;
}
#test "without the stage the cat is the glade's own, at home and free to wander" #steps 40000000 {
  u: [1] E2; u[0].clock = 0; e2w_step(u[..], 0.1);
  #assert !u[0].wild[0].cat[0].held && u[0].wild[0].cat[0].seed == E2W_CAT_SEED && abs(u[0].wild[0].cat[0].z - f32(E2W_CAT_Z)) < 0.01;
}
