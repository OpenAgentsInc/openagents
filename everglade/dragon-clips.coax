#module "everglade.dragonclips";
// The Shapechange dragon's clips as baked frames (Everglade's game layer, shared by every Everglade
// zone). The model is assets/verse/beasts/dragon.gltf, made by scripts/blender/dragon.py (CC0). The
// baker (verse/tools/assets/dragon_bake.py) writes the clips in this order, DR_FRAMES[c] frames
// each, and the pack names them glade/dragon0 to glade/dragon(DR_TOTAL - 1) in the same order. A loop's
// frames run round the clip (its last frame is not its first again); a clip played once runs to its
// last pose.
//   coax/bin/coax test everglade/dragon-clips.coax

DR_IDLE :: 0; DR_WALK :: 1; DR_FLY :: 2; DR_GLIDE :: 3; DR_BITE :: 4; DR_BREATH :: 5; DR_ROAR :: 6; DR_SWEEP :: 7;
// The mount's clips: standing for a rider, taking off, hovering, landing, and banking left or right.
DR_IDLE_SADDLED :: 8; DR_TAKEOFF :: 9; DR_HOVER :: 10; DR_LAND :: 11; DR_BANK_LEFT :: 12; DR_BANK_RIGHT :: 13;
DR_CLIPS :: 14;
DR_CLIP_NAME :: [14] string.["idle", "walk", "fly", "glide", "bite", "breath", "roar", "sweep", "idle_saddled", "takeoff", "hover", "land", "bank_left", "bank_right"];
DR_FRAMES :: [14] int.[4, 8, 8, 4, 5, 6, 5, 5, 4, 7, 6, 7, 3, 3];
DR_LOOPS :: [14] bool.[true, true, true, true, false, false, false, false, true, false, true, false, true, true];
// Each clip's length in the model, seconds (its glTF keys run from 1/24 s, so the span is last key - first key).
DR_SECONDS :: [14] f32.[4.0, 2.0, 1.0, 4.0, 1.0833, 1.9167, 1.9167, 1.4167, 4.0, 1.5833, 1.0, 1.5833, 4.0, 4.0];
DR_TOTAL :: 75;
// Where a rider sits: the model's `saddle` bone at rest, astride the base of the neck, in metres
// in the dragon's own unscaled frame (x to its left, y up from its feet, z forward). Multiply by
// the drawn scale. In motion the saddle rides the chest; this is its standing place.
DR_SADDLE_X :: 0.0; DR_SADDLE_Y :: 3.62; DR_SADDLE_Z :: 1.2;
// The model's size: about 5.8 m to the top of its horns (its folded wings' tips rise to 7.9 m), 14 m from
// snout to tail and 22.5 m across its spread wings, standing on its feet at
// the origin, facing +z.
DR_HEIGHT :: 5.8;
// The saddle bone a frame (dragon_bake.py saddle.txt): where a rider sits as each clip carries the
// chest, rearing up to take off and hover, rolled in a bank. Same frame and units as DR_SADDLE_*.
DR_SEAT :: [225] f32.[
  0, 3.65, 1.2, 0, 3.66, 1.195, 0, 3.65, 1.2, 0, 3.64, 1.204, 0, 3.68, 1.2, 0.011, 3.65, 1.2,
