// Everglade's feature manifest (#13075, docs/verse/everglade-feature-parity.md). The owner's rule
// (2026-11-09): no one-off zone code. A feature is engine-wide (aethyr/) or game-wide (the Everglade
// layer), and a zone only wires it in. coax/web/everglade-parity.coax reads this file and fails when
// a zone defines its own copy of a feature listed here, declares a feature it doesn't load, or lacks
// a required one. Data only: no procedures.
//
// A feature (EfFeature):
//   name      the word zones declare it by;
//   title     how the report and the doc say it;
//   required  every zone must wire it;
//   issue     the GitHub issue that burns down its existing duplicates (0: none);
//   owners    the shared modules that implement it, repository paths split by spaces (a path ending
//             "/" owns everything under it); a zone that declares the feature must #load one;
//   marks     a top-level definition in a zone whose name contains one of these is the zone's own
//             copy of the feature ("=name" matches the whole name only);
//   files     a zone file whose name contains one of these is the zone's own copy.
// To add a feature: add its row, wire it in each zone, and add the word to each zone's uses.
EfFeature :: struct { name: string; title: string; required: bool; issue: int; owners: string; marks: string; files: string; }
EF_FEATURES :: [11] EfFeature.[
  EfFeature.{name = "bow", title = "bow carry and draw", required = true, issue = 13079,
    owners = "aethyr/action/bow.coax aethyr/action/archery.coax aethyr/action/bow-pose.coax everglade/longbow.coax everglade/held-kit.coax",
    marks = "BowDraw =Arrows arrow_pos arrow_aim_velocity arrow_timed_velocity bow_strength _bow_layer bow_basis bow_matrix bow_string held_weapon",
    files = "bow"},
  EfFeature.{name = "damage-numbers", title = "damage numbers", required = true, issue = 13080,
    owners = "aethyr/action/floats.coax everglade/hud/",
    marks = "WatchPop watch_pop pops_ POP_ DamagePop E2mnMark E2gdMark E2MN_MARK E2GD_MARK e2mn_mark xc_hit_mark XcFloat xc_float XC_FLOAT HitGroup hit_group HIT_GROUP HIT_FOLD HIT_SHOW hit_shown damage_number float_text",
    files = ""},
  EfFeature.{name = "area-targeting", title = "area targeting", required = true, issue = 13081,
    owners = "aethyr/action/area-aim.coax everglade/shared/class-kit.coax rules/srd/area-origin.coax",
    marks = "aim_ring sp_ring =sp_aim ab_aimed XcWave xc_wave draw_zones area_ring target_ring aim_circle ground_target",
    files = ""},
  EfFeature.{name = "conditions", title = "conditions", required = true, issue = 13082,
    owners = "rules/srd/",
    marks = "StEffect =st_add st_cond st_word st_tags_draw st_bodies_draw st_draw_on _cond E2K_CONDITION E2K_EFFECT e2k_health_text WC_SLOWED WC_BOUND WC_HALTED fx_lasting condition_icon",
    files = ""},
  EfFeature.{name = "hud", title = "HUD parts", required = true, issue = 13083,
    owners = "everglade/hud/ aethyr/ui/ verse/hud.coax verse/hud/ everglade/client/class-look.coax everglade/client/class-menu.coax",
    marks = "_hud =hud =layout draw_panel draw_player draw_top draw_sliders xc_frame_box xc_slot_box _bar_desk _bar_card =sp_bar pt_draw",
    files = "hotbar"},
  EfFeature.{name = "class-bars", title = "class bars", required = true, issue = 13084,
    owners = "everglade/shared/class-kit.coax everglade/shared/fivebar.coax",
    marks = "EgClass =cl_bar =cl_cast CL_ABILITY =abilities E2nKit e2n_kit class_bar resource_bar",
    files = "classes"},
  EfFeature.{name = "dash", title = "Dash", required = true, issue = 13085,
    owners = "rules/srd/ aethyr/action/sprint.coax everglade/dash.coax",
    marks = "_dash dash_ =dash _DASH DASH_ CDASH =Dash",
    files = "dash"},
  EfFeature.{name = "mounts", title = "mounts", required = false, issue = 0,
    owners = "aethyr/action/mount.coax aethyr/action/ride-pose.coax everglade/mounts.coax everglade/zone-mounts.coax",
    marks = "=Mount =mount Mounted mounted_ mount_up dismount =ride_pose rider_ Steed steed_ Horse horse_",
    files = "mount"},
  EfFeature.{name = "name-plates", title = "name plates", required = true, issue = 13088,
    owners = "aethyr/ui/hud-plates.coax everglade/hud/",
    marks = "E2Plate _plates remote_plate REMOTE_PLATE PLATE_NEAR _plate_seen =Label _labels =labels draw_names np_named name_point name_hidden md_plate nameplate name_plate",
    files = "nameplate"},
  EfFeature.{name = "spell-effects", title = "spell effects", required = true, issue = 13086,
    owners = "aethyr/fx/ everglade/client/class-look.coax verse/everglade/gpu-fx.coax",
    marks = "sp_fx SpPuff SpMeteor FX_FIRE =FX_BOLT sp_glow sp_shards sp_bolt_jag =spell_col fx_spot fx_col fx_attacks fx_cause fx_event MOCK_FX fx_feat lw_fx lw_spell_col =Fx =add_fx draw_fx net_draw_ wl_draw",
    files = ""},
  EfFeature.{name = "camera", title = "camera", required = true, issue = 13087,
    owners = "aethyr/camera.coax aethyr/cam/ aethyr/shot.coax aethyr/follow.coax",
    marks = "=camera camera_frame cc_camera walk_camera =e2_follow follow_cam =e2_shot e2_ml_shot e2_cam_ cam_zoom cam_home cam_pan LOOK_DRAG CAM_TRUNK _place_camera cz_frame_shot e2c_shot e2c_lens orbit_cam",
    files = "camera"}
];

// A zone (EfZone):
//   name     its word in reports;
//   paths    the path prefixes of its own .coax files, split by spaces;
//   entries  the units its pages are built from: the check follows their #load lines;
//   uses     the features it wires, by name.
EfZone :: struct { name: string; paths: string; entries: string; uses: string; }
EF_ZONES :: [4] EfZone.[
  EfZone.{name = "everglade-ii",
    paths = "everglade/client/ everglade/server/ coax/web/room/room-everglade.coax",
    entries = "everglade/client/client.coax coax/web/room/room-everglade.coax",
    uses = "bow damage-numbers area-targeting conditions hud class-bars dash name-plates spell-effects camera"},
  EfZone.{name = "experimental",
    paths = "apps/openagents-web/fivelab apps/openagents-web/charactercreator everglade/scene/bodies.coax everglade/scene/charactercreator everglade/scene/preview-clips.coax apps/openagents-web/experimental- everglade/zone-combat.coax everglade/zone-objects.coax verse/experimental-",
    entries = "apps/openagents-web/fivelab.coax",
    uses = "bow damage-numbers area-targeting conditions hud class-bars dash name-plates spell-effects camera"},
  EfZone.{name = "archery-range",
    paths = "apps/openagents-web/archery-range everglade/range/",
    entries = "apps/openagents-web/archery-range.coax",
    uses = "bow damage-numbers area-targeting conditions hud class-bars dash name-plates spell-effects camera mounts"},
  EfZone.{name = "everglade-v1",
    paths = "apps/openagents-web/everglade- apps/openagents-web/everglade.coax",
    entries = "apps/openagents-web/everglade.coax",
    uses = "area-targeting conditions hud dash spell-effects camera"}
];

// The burn-down: the zone-local copies that were there when the check landed, and the ten that
// landed on main before the check gated it (#13135), one row each as
// "feature path symbol" ("-" for a file whose name marks it). Each is a warning that names its
// feature's issue; the check passes. Take a row off when its copy is gone (the check says so).
// Never add a row for new code: wire the shared module instead.
