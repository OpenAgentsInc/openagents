// Everglade's HUD parts, drawn in the realm's HUD style (EG_HUD, FANTASY: aethyr/ui/hud-style.coax,
// docs/verse/hud-styles.md): the unit frames (your portrait plate and your target's frame, their
// health bars with a damage trail), the action bar's tray and a slot's cooldown sweep, the map ring
// top right with the place and the time of day, the plates over creatures, damage numbers, a place's
// banner and the frame rate's plaque. Plain data in, vertices out: Everglade II and Everglade
// Experimental both draw through these. Each part lays its frames (hud_emit) before its words, so
// the words sit on the iron. Sizes are CSS px times k (device px a CSS px).
//   coax/bin/coax test everglade/scene/charactercreator.coax --only "eg "

// What a unit frame says: your portrait plate, or your target's frame beside it. A number the page
// does not know yet is left out, never guessed: max 0 (no room yet) draws no health bar; ac 0 no
// shield; level 0 no badge; a spell level whose slots the room has not said draws no gems.
EgPortrait :: struct {
  name: string; klass: string; level: int;
  hp: int; max: int; temp: int; down: bool;   // down: at 0 HP
  ac: int;
  slot_max: [10] int; slot_left: [10] int;     // by spell level; left -1 unknown
  conds: string;                               // the conditions and effects held, " · " between; "" none
  // the health bar as it stands this frame (aethyr/ui/hud-style.coax hud_trail_step): where its fill
  // has eased to and where its damage trail is; -1 each: the bar at hp / max, no trail
  fill: f32 = -1; trail: f32 = -1;
  foe: bool;      // a monster's frame: red where yours is gold
  mirror: bool;   // the medallion on the right (a target's frame faces yours)
  combat: f32;    // 0 to 1: how far the medallion's ring glows red (a zone pulses it while you fight)
  lit: bool;      // the pointer is over it, and a press opens its menus: its ring brightens
}
EG_PORTRAIT_W :: 330.0;   // CSS px: the plate's full width at its widest
eg_say :: (out: [] f32, n: int, t: string, x: f32, y: f32, cap: f32, role: int, a: f32, k: f32, centre: bool) -> int {
  return hud_say(out, n, t, x, y, cap, hud_text(eg_tokens(), role), a, k, centre);
}
eg_say_ink :: (out: [] f32, n: int, t: string, x: f32, y: f32, cap: f32, role: int, ink: HudRgba, a: f32, k: f32, centre: bool) -> int {
  r := hud_text(eg_tokens(), role); r.ink = ink; return hud_say(out, n, t, x, y, cap, r, a, k, centre);
}
eg_fade_list :: (l: [] HudList, a: f32) { if a >= 1 { return; } for i: 0..<l[0].n { l[0].p[i].top.a *= a; l[0].p[i].bottom.a *= a; } }
eg_int :: (b: [] u8, at: int, v: int) -> int {
  n := at; x := v; if x < 0 { if n < b.count { b[n] = '-'; n += 1; } x = -x; }
  d: [12] u8; c := 0; while true { d[c] = cast(u8)('0' + x % 10); c += 1; x /= 10; if x == 0 || c >= 12 { break; } }
  while c > 0 { c -= 1; if n < b.count { b[n] = d[c]; n += 1; } }
  return n;
}
eg_put :: (b: [] u8, at: int, t: string) -> int { n := at; for ch: t { if n < b.count { b[n] = ch; n += 1; } } return n; }
eg_upper :: (b: [] u8, at: int, t: string) -> int { n := at; for ch: t { c := ch; if c >= 'a' && c <= 'z' { c -= 32; } if n < b.count { b[n] = c; n += 1; } } return n; }

// The portrait plate's box, device px, its top left at (x, y) and wide CSS px wide: what a press on
// your portrait hits, and what its menus hang under (everglade/hud/class-bar.coax).
eg_portrait_box :: (x: f32, y: f32, wide: f32, k: f32) -> HudPrim { return hud_box(x, y, x + wide * k, y + 76 * k); }
EG_UNIT_R :: 34.0;      // CSS px: the medallion's radius
EG_UNIT_BAR :: 16.0;    // the health bar's height
// A unit frame (GitHub #13147): a medallion ringed in gold with the class's (or the creature's)
// initial and a level badge, over the end of a dark glass plate with a hairline of gold and an
// accent rule along its top; on the plate the name, the class beside it, and the health bar with its
// damage trail and its numbers; the AC shield at the plate's far end; spell slots as gems and the
// conditions under it. Yours is gold with the medallion on the left; a target's (mirror, foe) is red
// with it on the right, so the two face each other. (x, y) its top left, wide its width (CSS px).
// Returns the end. With a layout trace attached (ui, aethyr/ui/trace.coax) it puts the plate there.
eg_portrait :: (ui: [] UitTrace, out: [] f32, at: int, x: f32, y: f32, wide: f32, k: f32, p: EgPortrait, a: f32) -> int {
  if !(a > 0.01) { return at; }
  t := eg_tokens(); l: [1] HudList;
  accent := ifx p.foe then t.bad else t.trim;
  r := f32(EG_UNIT_R) * k; x1 := x + wide * k;
  mx := ifx p.mirror then x1 - r - 4 * k else x + r + 4 * k; my := y + r + 4 * k;
  // the plate runs from under the medallion to the frame's far end
  bx0 := ifx p.mirror then x else mx + r - 30 * k; bx1 := ifx p.mirror then mx - r + 30 * k else x1;
  py0 := y + 11 * k; py1 := y + 67 * k;
  tx0 := ifx p.mirror then bx0 + 12 * k else mx + r + 10 * k;     // where its words and its bar run
  tx1 := ifx p.mirror then mx - r - 10 * k else bx1 - 12 * k;
  body := hud_box(bx0, py0, bx1, py1);
  hud_shadow(l[..], body, 4 * k, 9 * k, hud_rgba(0, 0, 0, 0.5));
  hud_fill(l[..], body, 3 * k, hud_rgba(0.094, 0.078, 0.067, 0.82), hud_rgba(0.035, 0.031, 0.027, 0.82));
  hud_ring(l[..], body, 3 * k, 1 * k, hud_fade(t.trim, 0.46), hud_fade(t.trim, 0.2));
  // the accent rule along the top: strong in the middle, gone at the ends
  for q: 0..<3 { u0 := 0.5 - 0.5 / f32(q + 1) * 0.94; hud_line(l[..], tx0 + (tx1 - tx0) * u0, py0, tx1 - (tx1 - tx0) * u0, py0, 1 * k, hud_fade(accent, 0.26)); }
  uit_part(ui, ifx p.foe then "target" else "portrait"); uit_add(ui, UIT_NONE, UIT_PANEL, x, y, x1, y + 76 * k, ifx p.foe then "target" else "portrait");
  shield := p.ac > 0; sx := ifx p.mirror then tx0 + 12 * k else tx1 - 12 * k; sy := (py0 + py1) * 0.5 + 9 * k;
  bar_x0 := ifx shield && p.mirror then sx + 20 * k else tx0; bar_x1 := ifx shield && !p.mirror then sx - 20 * k else tx1;
  bar := hud_box(bar_x0, py1 - 10 * k - f32(EG_UNIT_BAR) * k, bar_x1, py1 - 10 * k);
  if p.max > 0 {
    share := f32(p.hp) / f32(p.max); low := share < 0.34 && !p.foe;
    fill := ifx p.fill >= 0 then p.fill else share; trail := ifx p.trail >= 0 then p.trail else fill;
    hud_vital(l[..], t, bar, fill, trail, ifx low then t.hp_low else t.hp, true, 1, k);
  }
  if shield { hud_shield(l[..], t, sx, sy, 13 * k, k); }
  // the medallion over the plate's end: a glow while you fight, its face tinted with the accent, a gold rim
  if p.combat > 0 { hud_shadow(l[..], hud_box(mx - r, my - r, mx + r, my + r), r, (6 + 8 * p.combat) * k, hud_rgba(0.92, 0.3, 0.2, 0.3 + 0.4 * p.combat)); }
  rim := t; rim.frame_light = ifx p.lit then hud_rgba(1, 0.96, 0.8, 1) else hud_rgba(0.96, 0.89, 0.68, 1); rim.frame_mid = hud_rgba(0.55, 0.42, 0.17, 1);
  hud_medallion(l[..], rim, mx, my, r, hud_mix(hud_rgba(0.11, 0.086, 0.07, 1), accent, 0.34), hud_rgba(0.047, 0.039, 0.035, 1), k);
  hud_circle(l[..], mx, my, r - 3.5 * k, 1 * k, hud_rgba(0.95, 0.87, 0.65, 0.28), hud_rgba(0.95, 0.87, 0.65, 0.1));
  badge := p.level > 0; bx := ifx p.mirror then mx + r * 0.74 else mx - r * 0.74; by := my + r * 0.74;
  if badge { hud_badge(l[..], t, bx, by, 12 * k, k); }
  // spell slots: a gem each, filled while left, by level, a little apart
  gx := tx0; gy := py1 + 12 * k; gems := false;
  for lv: 1..<10 {
    if p.slot_max[lv] <= 0 || p.slot_left[lv] < 0 { continue; }
    for g: 0..<p.slot_max[lv] { hud_gem(l[..], t, gx, gy, 5.5 * k, g < p.slot_left[lv], k); gx += 13 * k; }
    gx += 9 * k; gems = true;
  }
  eg_fade_list(l[..], a);
  n := hud_emit(out, at, l[..]);
  // the words
  ini: [1] u8; ini[0] = ifx p.klass.count > 0 then p.klass[0] else ifx p.name.count > 0 then p.name[0] else '?';
  if ini[0] >= 'a' && ini[0] <= 'z' { ini[0] -= 32; }
  n = eg_say_ink(out, n, cast(string) ini[..], mx, my + 11 * k, 22 * k, HUD_TEXT_TITLE, hud_mix(accent, hud_rgba(1, 0.95, 0.84, 1), ifx p.foe then 0.2 else 0.45), a, k, true);
  if badge { lv: [4] u8; ln := eg_int(lv[..], 0, p.level); n = eg_say_ink(out, n, cast(string) lv[0..<ln], bx, by + 4 * k, 8.5 * k, HUD_TEXT_NUMBER, t.title, a, k, true); }
  // the name, and the class beside it where it says more than the name does
  name_ink := ifx p.foe then hud_mix(accent, hud_rgba(1, 0.95, 0.84, 1), 0.45) else t.title;
  sub: [48] u8; sn := 0; same := p.klass.count == p.name.count;
  if same { for q: 0..<p.name.count { c0 := p.name[q]; c1 := p.klass[q]; if c0 >= 'a' && c0 <= 'z' { c0 -= 32; } if c1 >= 'a' && c1 <= 'z' { c1 -= 32; } if c0 != c1 { same = false; } } }
  if !same { sn = eg_put(sub[..], 0, p.klass); }
  sub_w := ifx sn > 0 then face_width(cast(string) sub[0..<sn], 7.5 * k * hud_text(t, HUD_TEXT_LABEL).scale, hud_text(t, HUD_TEXT_LABEL).face) else 0.0f32;
  name_cap := 12 * k; room := tx1 - tx0 - (ifx sn > 0 then sub_w + 10 * k else 0.0f32);
  name_w := face_width(p.name, name_cap, hud_text(t, HUD_TEXT_NAME).face); if name_w > room && name_w > 0 { name_cap = name_cap * room / name_w; name_w = room; }
  ny := py0 + 21 * k;
  n = eg_say_ink(out, n, p.name, ifx p.mirror then tx1 - name_w else tx0, ny, name_cap, HUD_TEXT_NAME, name_ink, a, k, false);
  if sn > 0 { n = eg_say(out, n, cast(string) sub[0..<sn], ifx p.mirror then tx0 else tx1 - sub_w, ny, 7.5 * k, HUD_TEXT_LABEL, a, k, false); }
  if p.max > 0 {
    hp: [32] u8; hn := eg_int(hp[..], 0, p.hp); hn = eg_put(hp[..], hn, " / "); hn = eg_int(hp[..], hn, p.max);
    if p.temp > 0 { hn = eg_put(hp[..], hn, "  +"); hn = eg_int(hp[..], hn, p.temp); }
    n = eg_say_ink(out, n, cast(string) hp[0..<hn], (bar.x0 + bar.x1) * 0.5, bar.y1 - 4.2 * k, 8 * k, HUD_TEXT_NUMBER, hud_rgba(1, 0.965, 0.9, 1), a, k, true);
  }
  if shield { ac: [4] u8; an := eg_int(ac[..], 0, p.ac); n = eg_say(out, n, cast(string) ac[0..<an], sx, sy + 3.5 * k, 8.5 * k, HUD_TEXT_NUMBER, a, k, true);
              n = eg_say(out, n, "AC", sx, sy - 16 * k, 5.5 * k, HUD_TEXT_LABEL, a, k, true); }
  cy := ifx gems then gy + 22 * k else py1 + 18 * k;
  if p.down { n = eg_say(out, n, ifx p.foe then "DOWN" else "UNCONSCIOUS", tx0, cy, 7.5 * k, HUD_TEXT_WARN, a, k, false); cy += 14 * k; }
  if p.conds.count > 0 { n = eg_say(out, n, p.conds, tx0, cy, 7 * k, HUD_TEXT_WARN, a, k, false); }
  return n;
}
#test "eg portrait: a plate with the name, the class, health and AC; nothing it does not know" #steps 200000000 {
  out: [60000] f32; nt: [] UitTrace; p: EgPortrait; p.name = "Ash"; p.klass = "Druid"; p.level = 2;
  for i: 0..<10 { p.slot_left[i] = -1; }
  bare := eg_portrait(nt, out[..], 0, 12, 12, EG_PORTRAIT_W, 1, p, 1);
  p.hp = 9; p.max = 18; p.ac = 13; p.slot_max[1] = 3; p.slot_left[1] = 2;
  full := eg_portrait(nt, out[..], 0, 12, 12, EG_PORTRAIT_W, 1, p, 1);
  #assert bare > 0 && full > bare + 60;
  // every vertex sits in the plate's corner of the screen
  for q: 0..<full { #assert out[q * VERTEX_FLOATS] >= 0 && out[q * VERTEX_FLOATS] <= 12 + EG_PORTRAIT_W + 20 && out[q * VERTEX_FLOATS + 1] <= 160; }
  // its frames come first, then its words: the words are never under the iron
  first_text := -1; last_prim := -1;
  for q: 0..<full { m := out[q * VERTEX_FLOATS + 11]; if m >= 10 { last_prim = q; } else if first_text < 0 { first_text = q; } }
  #assert first_text > last_prim;
  // a blow's trail adds its pale strip to the bar; a target's frame is a mirror of yours in the same room
  p.fill = 0.5; p.trail = 0.9; #assert eg_portrait(nt, out[..], 0, 12, 12, EG_PORTRAIT_W, 1, p, 1) == full + 6;   // one more box: the trail
  f := EgPortrait.{name = "Imp", hp = 13, max = 21, foe = true, mirror = true}; for i: 0..<10 { f.slot_left[i] = -1; }
  foe := eg_portrait(nt, out[..], 0, 12, 12, 300, 1, f, 1); #assert foe > 0 && eg_portrait(nt, out[..], 0, 12, 12, 300, 1, f, 0) == 0;
  for q: 0..<foe { #assert out[q * VERTEX_FLOATS] >= 0 && out[q * VERTEX_FLOATS] <= 12 + 300 + 20 && out[q * VERTEX_FLOATS + 1] <= 110; }
  b := eg_portrait_box(12, 12, EG_PORTRAIT_W, 1); #assert b.x0 == 12 && b.x1 == 12 + EG_PORTRAIT_W && b.y1 - b.y0 == 76;
}

// The action bar's tray round its slots: iron strips that leave each slot's picture clear, a sunk
// frame round each, and the class's emblem over the middle. b holds each slot's box (x0, y0, x1,
// y1, 4 a slot). Returns the end; the realm then draws the pictures, the keys and the counts. With a
// layout trace attached it puts the tray there and each slot in it as a button, "slot 1" on, then the
// emblem: the tray's index is uit_next before the call, and slot i's that plus 1 + i (eg_bar_slot_at).
eg_bar_frame :: (ui: [] UitTrace, out: [] f32, at: int, b: [] f32, n: int, k: f32, initial: u8, a: f32) -> int {
  if n <= 0 { return at; }
  t := eg_tokens(); l: [1] HudList;
  x0 := b[0]; x1 := b[2]; y0 := b[1]; y1 := b[3];
  for i: 0..<n { if b[i * 4] < x0 { x0 = b[i * 4]; } if b[i * 4 + 2] > x1 { x1 = b[i * 4 + 2]; } if b[i * 4 + 1] < y0 { y0 = b[i * 4 + 1]; } if b[i * 4 + 3] > y1 { y1 = b[i * 4 + 3]; } }
  m := 9 * k; tray := hud_box(x0 - m - 10 * k, y0 - m, x1 + m + 10 * k, y1 + m);
  sx: [64] f32; c := ifx n > 32 then 32 else n;
  for i: 0..<c { sx[2 * i] = b[i * 4] - 1; sx[2 * i + 1] = b[i * 4 + 2] + 1; }
  hud_tray_round(l[..], t, tray, y0 - 1, y1 + 1, sx[..], c, k);
  for i: 0..<c { hud_slot(l[..], t, hud_box(b[i * 4], b[i * 4 + 1], b[i * 4 + 2], b[i * 4 + 3]), k, true); }
  cx := (x0 + x1) * 0.5; er := 15 * k; ey := y0 - er - 2 * k;   // clear of the slots: its foot 2 px over them
  uit_part(ui, "bar"); bar := uit_put(ui, UIT_NONE, UIT_PANEL, tray.x0, tray.y0, tray.x1, tray.y1, "bar tray");
  for i: 0..<n { _ := uit_put_i(ui, bar, UIT_BUTTON, b[i * 4], b[i * 4 + 1], b[i * 4 + 2], b[i * 4 + 3], "slot", i + 1); }
  if initial == 0 { eg_fade_list(l[..], a); return hud_emit(out, at, l[..]); }   // no emblem (an upright phone: your portrait names your class)
  uit_over(ui, uit_put(ui, bar, UIT_PANEL, cx - er, ey - er, cx + er, ey + er, "emblem"));   // on the tray's rim, on purpose
  hud_medallion(l[..], t, cx, ey, er, hud_rgba(0.20, 0.30, 0.22, 1), hud_rgba(0.06, 0.10, 0.07, 1), k);
  eg_fade_list(l[..], a);
  v := hud_emit(out, at, l[..]);
  ini: [1] u8; ini[0] = initial;
  return eg_say(out, v, cast(string) ini[..], cx, ey + 6 * k, 12 * k, HUD_TEXT_TITLE, a, k, true);
}
// A slot's cooldown, on its picture, every Everglade bar's (GitHub #13147): the engine's sweep, a dark
// pie that starts whole and closes clockwise from twelve o'clock as the wait runs out. share: how
// much of the wait is left, 0 to 1. b: the slot's box (x0, y0, x1, y1).
eg_slot_sweep :: (out: [] f32, at: int, b: [] f32, share: f32, k: f32) -> int {
  if !(share > 0) { return at; }
  l: [1] HudList; hud_sweep(l[..], hud_box(b[0], b[1], b[2], b[3]), share, hud_rgba(0.02, 0.015, 0.01, 0.68));
  return hud_emit(out, at, l[..]);
}
// The screen's red edges, every Everglade zone's (GitHub #13147, aethyr/ui/hud-style.coax
// hud_vignette): a flash when a blow lands on you and a pulse while you are under a quarter of your
// Hit Points. A zone keeps one HudVignette, steps it with your share each frame, and draws this first.
eg_vignette :: (out: [] f32, at: int, v: HudVignette, w: f32, h: f32) -> int {
  l: [1] HudList; hud_vignette(l[..], v, w, h); return hud_emit(out, at, l[..]);
}
#test "eg slot sweep: one pie over the slot's picture while the wait runs, the share of it left; nothing once it is over" {
  out: [6 * VERTEX_FLOATS] f32; b := [4] f32.[100, 500, 152, 552];
  #assert eg_slot_sweep(out[..], 0, b[..], 0.5, 1) == 6 && out[7] == 0.5 && out[11] >= 40;   // a sweep prim (kind 4), its share in its width
  #assert eg_slot_sweep(out[..], 0, b[..], 0, 1) == 0 && eg_slot_sweep(out[..], 0, b[..], -1, 1) == 0;
  #assert eg_slot_sweep(out[..], 0, b[..], 3, 1) == 6 && out[7] == 1;
}
#test "eg bar: a tray, a sunk frame a slot and the emblem, then the emblem's letter (hud-style.coax checks the tray leaves the pictures clear)" #steps 100000000 {
  out: [40000] f32; b: [12] f32; nt: [] UitTrace;
  for i: 0..<3 { b[i * 4] = 100 + f32(i) * 60; b[i * 4 + 1] = 500; b[i * 4 + 2] = 152 + f32(i) * 60; b[i * 4 + 3] = 552; }
  n := eg_bar_frame(nt, out[..], 0, b[..], 3, 1, 'D', 1);
  #assert n > 6 * 20 && out[(n - 1) * VERTEX_FLOATS + 11] < 10 && out[11] >= 10;
  #assert eg_bar_frame(nt, out[..], 0, b[..], 0, 1, 'D', 1) == 0;
  bare := eg_bar_frame(nt, out[..], 0, b[..], 3, 1, 0, 1); #assert bare > 0 && bare < n && out[(bare - 1) * VERTEX_FLOATS + 11] >= 10;   // no emblem, no letter
  // traced: the tray, then each slot in it
  tr: [1] UitTrace; at := uit_next(tr[..]);
  #assert eg_bar_frame(tr[..], out[..], 0, b[..], 3, 1, 'D', 1) == n && tr[0].n == 5 && eg_bar_slot_at(tr[..], at, 2) == 3 && tr[0].rects[3].parent == at;
}
// Slot i's index in the trace, from the tray's (uit_next before eg_bar_frame); UIT_NONE when it isn't there.
eg_bar_slot_at :: (ui: [] UitTrace, tray: int, i: int) -> int {
  if tray == UIT_NONE || ui.count == 0 || tray + 1 + i >= ui[0].n { return UIT_NONE; }
  return tray + 1 + i;
}

// The map ring top right: the land round you within reach metres, turned with your view, ahead up.
// Things on it (EgDot): 0 a friend, 1 a foe, 2 a guard, 3 the path, 4 open ground (r its radius,
// metres). zone and clock under it. Returns the end.
EgDot :: struct { x: f32; z: f32; kind: int; r: f32; }
EG_DOT_FRIEND :: 0; EG_DOT_FOE :: 1; EG_DOT_GUARD :: 2; EG_DOT_PATH :: 3; EG_DOT_OPEN :: 4;
eg_map :: (ui: [] UitTrace, out: [] f32, at: int, cx: f32, cy: f32, r: f32, k: f32, you_x: f32, you_z: f32, fx: f32, fz: f32,
           reach: f32, dots: [] EgDot, nd: int, zone: string, clock: string, a: f32) -> int {
  t := eg_tokens(); l: [1] HudList;
  fl := sqrt(fx * fx + fz * fz); ffx := ifx fl > 0.0001 then fx / fl else 0.0f32; ffz := ifx fl > 0.0001 then fz / fl else -1.0f32;
  rx := -ffz; rz := ffx;   // your right on the ground, y up
  hud_map_ring(l[..], t, cx, cy, r, k);
  uit_part(ui, "map"); uit_add(ui, UIT_NONE, UIT_PANEL, cx - r, cy - r, cx + r, cy + r, "map");   // the layout trace, when attached
  ground := hud_rgba(0.82, 0.74, 0.55, 0.9); path := hud_rgba(0.50, 0.36, 0.20, 0.85);
  for pass: 0..<2 {
    for i: 0..<nd {
      d := dots[i]; open := d.kind == EG_DOT_OPEN || d.kind == EG_DOT_PATH;
      if (pass == 0) != open { continue; }
      dx := d.x - you_x; dz := d.z - you_z;
      if dx * dx + dz * dz > (reach * 1.6) * (reach * 1.6) && d.kind >= EG_DOT_PATH { continue; }
      q := hud_map_point(cx, cy, r, dx, dz, ffx, ffz, rx, rz, reach);
      ex := q.x - cx; ey := q.y - cy;
      if d.kind == EG_DOT_OPEN { rr := d.r * r / reach; if sqrt(ex * ex + ey * ey) + rr * 0.3 < r * 0.92 { if rr > r * 0.8 { rr = r * 0.8; } hud_disc(l[..], q.x, q.y, rr, hud_fade(ground, 0.55), hud_fade(ground, 0.4)); } continue; }
      if d.kind == EG_DOT_PATH { if sqrt(ex * ex + ey * ey) < r * 0.86 { hud_disc(l[..], q.x, q.y, 2.6 * k, path, path); } continue; }
      c := ifx d.kind == EG_DOT_FOE then t.bad else ifx d.kind == EG_DOT_GUARD then t.trim else hud_rgba(0.45, 0.75, 1.0, 1);
      hud_disc(l[..], q.x, q.y, 4 * k, hud_rgba(0, 0, 0, 0.55), hud_rgba(0, 0, 0, 0.55));
      hud_disc(l[..], q.x, q.y, 3 * k, hud_mix(c, hud_rgba(1, 1, 1, 1), 0.25), c);
    }
  }
  // you: an arrowhead at the middle, ahead up
  hud_diamond(l[..], cx, cy + 1 * k, 6 * k, hud_rgba(0, 0, 0, 0.6), hud_rgba(0, 0, 0, 0.6));
  hud_diamond(l[..], cx, cy, 5 * k, hud_rgba(1.0, 0.92, 0.70, 1), t.trim);
  // north on the ring's edge
  nq := hud_map_point(cx, cy, r, 0, -reach * 4, ffx, ffz, rx, rz, reach);
  nx := cx + (nq.x - cx) / 0.9 * 1.0; ny := cy + (nq.y - cy) / 0.9 * 1.0;
  hud_disc(l[..], nx, ny, 8 * k, hud_rgba(0.30, 0.22, 0.13, 1), hud_rgba(0.12, 0.09, 0.06, 1));
  hud_circle(l[..], nx, ny, 8 * k, 1.2 * k, t.trim, hud_mix(t.trim, t.frame_mid, 0.5));
  // the place's ribbon under the ring
  zy := cy + r + 20 * k; zw := 8 * k + face_width(zone, 9 * k, HUD_FACE_TITLE) * 0.5 + 18 * k;
  hud_banner(l[..], t, cx, zy, zw, 22 * k, 1, k);
  eg_fade_list(l[..], a);
  v := hud_emit(out, at, l[..]);
  v = eg_say(out, v, "N", nx, ny + 3.5 * k, 7 * k, HUD_TEXT_TITLE, a, k, true);
  v = eg_say(out, v, zone, cx, zy + 4.5 * k, 9 * k, HUD_TEXT_TITLE, a, k, true);
  if clock.count > 0 { v = eg_say(out, v, clock, cx, zy + 26 * k, 8 * k, HUD_TEXT_NUMBER, a, k, true); }
  return v;
}
// The time of day (0 midnight to 1) as a 24-hour clock, "HH:MM".
eg_clock :: (day: f32, b: [] u8) -> int {
  d := day - floor(day); m := cast(int)(d * 1440.0); if m >= 1440 { m = 1439; }
  h := m / 60; mm := m % 60; n := 0;
  b[0] = cast(u8)('0' + h / 10); b[1] = cast(u8)('0' + h % 10); b[2] = ':'; b[3] = cast(u8)('0' + mm / 10); b[4] = cast(u8)('0' + mm % 10);
  return 5;
}
#test "eg map: you in the middle, ahead up; the clock reads the day" #steps 200000000 {
  b: [8] u8; #assert cast(string) b[0..<eg_clock(0.5, b[..])] == "12:00" && cast(string) b[0..<eg_clock(0.75 + 1.0 / 1440 * 7, b[..])] == "18:07";
  #assert cast(string) b[0..<eg_clock(0, b[..])] == "00:00" && cast(string) b[0..<eg_clock(0.99999, b[..])] == "23:59";
  out: [60000] f32; d: [2] EgDot; d[0] = EgDot.{x = 0, z = -20, kind = EG_DOT_FOE}; d[1] = EgDot.{x = 0, z = 0, kind = EG_DOT_OPEN, r = 17};
  nt: [] UitTrace; n := eg_map(nt, out[..], 0, 300, 100, 70, 1, 0, 0, 0, -1, 60, d[..], 2, "The Glade", "12:00", 1);
  #assert n > 0;
  for q: 0..<n { #assert out[q * VERTEX_FLOATS] > 300 - 120 && out[q * VERTEX_FLOATS] < 300 + 120 && out[q * VERTEX_FLOATS + 1] < 100 + 70 + 60; }
}

// A plate over a creature: its name, and its health under it while known (share in 0..1; -1 none).
// foe: a monster's red, else a friend's green; alpha its fade. (sx, sy) the bar's middle.
eg_plate :: (out: [] f32, at: int, name: string, sx: f32, sy: f32, k: f32, share: f32, foe: bool, target: bool, alpha: f32) -> int {
  return eg_plate_trail(out, at, name, sx, sy, k, share, share, foe, target, alpha);
}
EG_PLATE_HALF :: 32.0;   // CSS px: half a plate's bar
EG_PLATE_UP :: 10.0;     // its name's baseline over the bar's middle
// The same with its damage trail (trail: where the bar stood, in 0..1; the share itself for none): a
// foe's name in red, a friend's in green, your target's in bright gold over a bar ringed in gold.
eg_plate_trail :: (out: [] f32, at: int, name: string, sx: f32, sy: f32, k: f32, share: f32, trail: f32, foe: bool, target: bool, alpha: f32) -> int {
  if !(alpha > 0.01) { return at; }
  t := eg_tokens(); v := at;
  if share >= 0 { l: [1] HudList; hud_plate_trail(l[..], t, sx, sy, f32(EG_PLATE_HALF) * k, share, trail, foe, target, alpha, k); v = hud_emit(out, v, l[..]); }
  ink := ifx target then hud_mix(t.title, hud_rgba(1, 1, 1, 1), 0.25) else ifx foe then hud_rgba(0.94, 0.41, 0.35, 1) else hud_rgba(0.53, 0.86, 0.55, 1);
  return eg_say_ink(out, v, name, sx, sy - f32(EG_PLATE_UP) * k, 10.5 * k, HUD_TEXT_NAME, ink, alpha, k, true);
}
// The frame's plates over bodies, every zone's (aethyr/ui/hud-plates.coax places them): each name in
// the title face over its bar, a covered one's count ("+3") beside the name over it. Measures the
// names, places the plates from the camera, then draws them; most is the vertex count to stop short
// of (0: none), and a plate left off for want of room is counted in skipped.
EG_PLATE_CAP :: 10.5;    // CSS px: a plate's name
EG_PLATE_ROOM :: 900;    // vertices one plate may take
eg_plates :: (out: [] f32, at: int, p: [] HudPlates, view: HudPlateView, k: f32, most: int) -> int {
  cap := EG_PLATE_CAP * k; p[0].cap = cap;
  for i: 0..<p[0].n { plate := p[0].items[i]; p[0].items[i].wide = ifx plate.n > 0 then face_width(cast(string) plate.text[0..<plate.n], cap, HUD_FACE_TITLE) else 0.0f32; }
  hud_plates_place(p, view);
  t := eg_tokens(); v := at;
  for i: 0..<p[0].n {
    plate := p[0].items[i];
    if !(plate.shown > 0.01) { continue; }
    if most > 0 && v + EG_PLATE_ROOM > most { p[0].skipped += 1; continue; }
    name := ifx plate.named then cast(string) plate.text[0..<plate.n] else "";
    fill := ifx plate.fill >= 0 then plate.fill else plate.share; trail := ifx plate.trail >= 0 then plate.trail else fill;
    if !plate.inked { v = eg_plate_trail(out, v, name, plate.sx, plate.sy, k, ifx plate.share >= 0 then fill else plate.share, trail, plate.foe, plate.target, plate.shown); }
    else {
      if plate.share >= 0 { l: [1] HudList; hud_plate_trail(l[..], t, plate.sx, plate.sy, f32(EG_PLATE_HALF) * k, fill, trail, plate.foe, plate.target, plate.shown, k); v = hud_emit(out, v, l[..]); }
      if plate.named { v = eg_say_ink(out, v, name, plate.sx, plate.sy - f32(EG_PLATE_UP) * k, cap, HUD_TEXT_NAME, hud_rgba(plate.r, plate.g, plate.b, 1), plate.shown, k, true); }
    }
    if plate.named && plate.more > 0 {
      b: [12] u8; m := eg_put(b[..], 0, "+"); m = eg_int(b[..], m, plate.more);
      v = eg_say(out, v, cast(string) b[0..<m], plate.sx + plate.wide * 0.5 + 3 * k, plate.sy - f32(EG_PLATE_UP) * k, 7.5 * k, HUD_TEXT_LABEL, plate.shown, k, false);
    }
  }
  return v;
}
// A number rising off a creature: damage dealt (orange), harm to you (red), a miss, healing (green).
EG_FLOAT_DEALT :: 0; EG_FLOAT_HARM :: 1; EG_FLOAT_MISS :: 2; EG_FLOAT_HEAL :: 3;
eg_float :: (out: [] f32, at: int, t: string, sx: f32, sy: f32, k: f32, kind: int, alpha: f32) -> int {
  if !(alpha > 0.01) { return at; }
  tk := eg_tokens(); miss := kind == EG_FLOAT_MISS;
  ink := ifx miss then tk.text_dim else ifx kind == EG_FLOAT_HARM then tk.bad else ifx kind == EG_FLOAT_HEAL then tk.heal else tk.damage;
  return eg_say_ink(out, at, t, sx, sy, (ifx miss then 9.0f32 else 13.0f32) * k, HUD_TEXT_DAMAGE, ink, alpha, k, true);
}
// The frame rate on its plaque, bottom right (fps_draw's place and size).
eg_fps :: (ui: [] UitTrace, f: FpsCounter, out: [] f32, at: int, w: f32, h: f32, k: f32) -> int {
  buf: [16] u8; n := 0; v := cast(int)(f.fps + 0.5); if v > 999 { v = 999; }
  n = eg_int(buf[..], 0, v); n = eg_put(buf[..], n, " FPS");
  wide := face_width(cast(string) buf[0..<n], 13 * k, HUD_FACE_BODY);
  p := eg_plaque(out, at, w - 16 * k - wide - 10 * k, h - 16 * k - 22 * k, w - 8 * k, h - 16 * k + 9 * k, k);
  return fps_draw(ui, f, out, p, w, h, k);
}
// The frame rate with the graphics control to its left on the one plaque ("GFX AUTO · MED  60 FPS",
// aethyr/quality-page.coax qp_label); box gets where a tap or a click takes the control. With no
// words it is the frame rate alone (eg_fps) and box is empty.
eg_fps_gfx :: (ui: [] UitTrace, f: FpsCounter, gfx: string, out: [] f32, at: int, w: f32, h: f32, k: f32, box: [] Box) -> int {
  box[0] = Box.{};
  if gfx.count == 0 { return eg_fps(ui, f, out, at, w, h, k); }
  buf: [16] u8; n := 0; v := cast(int)(f.fps + 0.5); if v > 999 { v = 999; }
  n = eg_int(buf[..], 0, v); n = eg_put(buf[..], n, " FPS");
  wide := face_width(cast(string) buf[0..<n], 13 * k, HUD_FACE_BODY);
  em := sans_em(13 * k); gw := 0.0f32;
  for ch: gfx { code := int(ch); a := ifx code >= 32 && code <= 126 then int(EG_BODY_WIDTH[code - 32]) else int(EG_BODY_WIDTH[31]); gw += f32(a) / f32(EG_FONT_UPM) * em; }
  right := w - 16 * k - wide - 14 * k; base := h - 16 * k;
  p := eg_plaque(out, at, right - gw - 10 * k, base - 22 * k, w - 8 * k, base + 9 * k, k);
  box[0] = Box.{x0 = right - gw - 10 * k, y0 = base - 13 * k - 15 * k, x1 = right + 6 * k, y1 = base + 15 * k};
  uit_part(ui, "gfx"); b := box[0]; g := uit_put(ui, UIT_NONE, UIT_BUTTON, b.x0, b.y0, b.x1, b.y1, "GFX");
  p = ttext(ui, g, out, p, gfx, right - gw, base, 13 * k, ink(k, 0.76, 0.74, 0.66), "GFX");
  return fps_draw(ui, f, out, p, w, h, k);
}
// "DRUID" as a name: "Druid".
eg_title :: (b: [] u8, t: string) -> string {
  n := 0; for ch: t { c := ch; if n > 0 && c >= 'A' && c <= 'Z' { c += 32; } if n < b.count { b[n] = c; n += 1; } }
  return cast(string) b[0..<n];
}
// A place reached: its name on a ribbon across the upper screen, age seconds into its life.
EG_BANNER_S :: 3.6;
eg_banner :: (out: [] f32, at: int, w: f32, y: f32, k: f32, title: string, age: f32) -> int {
  a := hud_banner_alpha(age, f32(EG_BANNER_S));
  if !(a > 0) { return at; }
  t := eg_tokens(); l: [1] HudList; cap := 15 * k;
  half := face_width(title, cap * 1.5, HUD_FACE_TITLE) * 0.5 + 60 * k;
  hud_banner(l[..], t, w * 0.5, y, half, 42 * k, a, k);
  v := hud_emit(out, at, l[..]);
  return eg_say(out, v, title, w * 0.5, y + cap * 0.75, cap, HUD_TEXT_BANNER, a, k, true);
}
// A dark plaque behind a line of small controls (the frame rate, the graphics tier).
eg_plaque :: (out: [] f32, at: int, x0: f32, y0: f32, x1: f32, y1: f32, k: f32) -> int {
  t := eg_tokens(); l: [1] HudList; b := hud_box(x0, y0, x1, y1);
  hud_fill(l[..], b, 6 * k, hud_rgba(0.10, 0.08, 0.06, 0.72), hud_rgba(0.05, 0.04, 0.03, 0.78));
  hud_ring(l[..], b, 6 * k, 1 * k, hud_fade(t.frame_light, 0.7), hud_fade(t.frame_mid, 0.7));
  return hud_emit(out, at, l[..]);
}
#test "eg plate, float, banner and plaque draw, and draw nothing faded out" #steps 200000000 {
  out: [60000] f32;
  #assert eg_plate(out[..], 0, "Wolf", 400, 300, 1, 0.5, true, false, 1) > eg_plate(out[..], 0, "Wolf", 400, 300, 1, -1, true, false, 1);
  #assert eg_plate(out[..], 0, "Wolf", 400, 300, 1, 0.5, true, false, 0) == 0 && eg_float(out[..], 0, "-7", 400, 300, 1, EG_FLOAT_DEALT, 0) == 0;
  #assert eg_float(out[..], 0, "-7", 400, 300, 1, EG_FLOAT_DEALT, 1) == 2 * 6 * 9;   // outlined: eight dark copies and the number
  b: [16] u8; #assert eg_title(b[..], "DRUID") == "Druid";
  #assert eg_banner(out[..], 0, 1920, 200, 1, "The Glade", 1) > 0 && eg_banner(out[..], 0, 1920, 200, 1, "The Glade", 9) == 0;
  #assert eg_plaque(out[..], 0, 10, 10, 100, 40, 1) == 12;
}

// ---- the world's HUD, every Everglade zone's: the map ring at the top right with the place and the
// time of day, the portrait plate top left as wide as the map leaves it, and a place's banner. A zone
// passes what it knows (EgWorld, its map's dots, your portrait); this lays them out for the page
// (w, h device px, k device px per CSS px), a phone's narrower and closer to the corners.
// cover is what an open menu takes (everglade/hud/class-bar.coax eg_menu_cover): it hangs under your
// plate, and on a narrow page the map steps aside under it.
EgWorld :: struct { you_x: f32; you_z: f32; fx: f32; fz: f32; reach: f32 = 60; place: string; clock: string; since: f32; cover: HudPrim; }
// Whether boxes a and b share area (an empty box meets nothing).
eg_meets :: (a: HudPrim, b: HudPrim) -> bool { return a.x1 > a.x0 && b.x1 > b.x0 && a.x0 < b.x1 && b.x0 < a.x1 && a.y0 < b.y1 && b.y0 < a.y1; }
// ui: the layout trace (aethyr/ui/trace.coax), when the overlap check attaches one; empty for none.
eg_world :: (ui: [] UitTrace, out: [] f32, at: int, w: f32, h: f32, k: f32, wd: EgWorld, dots: [] EgDot, nd: int, p: EgPortrait) -> int {
  W := w / k; phone := W < 700 || h / k < 500;
  mr := ifx phone then 40.0f32 else 70.0f32; top := ifx phone then 14.0f32 else 16.0f32;
  mcx := w - (mr + 22) * k; mcy := (top + mr + 10) * k; v := at;
  if !eg_meets(wd.cover, hud_box(mcx - (mr + 8) * k, top * k, mcx + (mr + 8) * k, mcy + (mr + 30) * k)) {
    v = eg_map(ui, out, v, mcx, mcy, mr * k, k, wd.you_x, wd.you_z, wd.fx, wd.fz, wd.reach, dots, nd, wd.place, wd.clock, 1);
  }
  // the plate stays under its own menus, which hang from its foot
  wide := W - (2 * mr + 44) - 20; if wide > f32(EG_PORTRAIT_W) { wide = f32(EG_PORTRAIT_W); }
  px := ifx phone then 8.0f32 else 14.0f32;
  v = eg_portrait(ui, out, v, px * k, top * k, wide, k, p, 1);
  return eg_banner(out, v, w, h * 0.22, k, wd.place, wd.since);
}
// Where eg_world puts your portrait plate on a w by h page (device px).
eg_world_portrait :: (w: f32, h: f32, k: f32) -> HudPrim {
  W := w / k; phone := W < 700 || h / k < 500;
  mr := ifx phone then 40.0f32 else 70.0f32; top := ifx phone then 14.0f32 else 16.0f32;
  wide := W - (2 * mr + 44) - 20; if wide > f32(EG_PORTRAIT_W) { wide = f32(EG_PORTRAIT_W); }
  px := ifx phone then 8.0f32 else 14.0f32;
  return eg_portrait_box(px * k, top * k, wide, k);
}
#test "eg plates: the frame's plates placed and drawn, a covered name counted on the one over it, none past most" #steps 400000000 {
  out: [60000] f32; p: [1] HudPlates;
  v := HudPlateView.{eye = [3] f32.[0, 2, 0], fwd = [3] f32.[0, 0, -1], right = [3] f32.[1, 0, 0], up = [3] f32.[0, 1, 0], focal = 900, cx = 640, cy = 360, w = 1280, h = 720};
  hud_plates_begin(p[..]); p[0].fold = true;
  hud_plates_push(p[..], 0, 2.3, -8, "Wolf", 0.5, true, false, 1);
  hud_plates_push(p[..], 0, 2.4, -12, "Wolf", 0.5, true, false, 1);
  a := eg_plates(out[..], 0, p[..], v, 1, 0);
  #assert a > 0 && p[0].placed == 2 && p[0].items[0].named && p[0].items[0].more == 1 && !p[0].items[1].named;
  #assert eg_plates(out[..], 0, p[..], v, 1, 100) == 0 && p[0].skipped == 2;
  hud_plates_begin(p[..]); i := hud_plates_add(p[..], 0, 2.3, -8, "Ana", -1, false, false, 1); hud_plates_ink(p[..], i, 0.3, 0.8, 1);
  #assert eg_plates(out[..], 0, p[..], v, 1, 0) > 0 && p[0].items[i].named;
}
