// The buildings you walk into (eg-buildings, eg-interiors): every one, the inn, the three shops,
// the two guild halls, the mages' tower, the temple, the observatory, the stables and the six houses.
// Their walls stand 0.4 m thick inside the footprint, with a doorway in the wall that faces the door spot.
EG_INTERIOR :: [16] bool.[true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true];
EG_INTERIORS :: 16;
// The hash that starts you inside one (#in-inn): "" for those you can't enter.
EG_ROOM_ID :: [16] string.["in-inn", "in-store", "in-smithy", "in-alchemist", "in-fighters", "in-rangers", "in-mages", "in-temple",
  "in-observatory", "in-stables", "in-house-1", "in-house-2", "in-house-3", "in-house-4", "in-house-5", "in-house-6"];
EG_WALL :: 0.4;         // a wall's thickness
EG_MODULE :: 2.0;       // the kit's walls are 2 m modules
EG_DOORWAY :: 1.9;      // the gap a doorway leaves in a wall
EG_INN :: 0; EG_STORE :: 1; EG_SMITHY :: 2; EG_ALCHEMIST :: 3; EG_FIGHTERS :: 4; EG_RANGERS :: 5;
EG_MAGES :: 6; EG_TEMPLE :: 7; EG_OBSERVATORY :: 8; EG_STABLES :: 9; EG_HOUSES :: 10;

// ---- wave 1's districts past the old town (docs/metaverse/everglade.md, "The districts"): the map's
// landmarks and the houses and shops on their streets, built from the same kit as the old town's.
// Each is a box, the spot just outside its door on the street, its name ("" for a plain house or
// workshop) and whether its walls are stone. They are shut: their doors open (everglade-doors.coax)
// on a dark hall you don't go into yet, as the crypt's does, so each stands in the way as one box.
