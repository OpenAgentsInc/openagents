// Everglade's content registry (GitHub #13286): every ability, spell, creature template, item kind
// and spawn that a wire frame or a save names has one row here, a number and the key that names it.
// A number is never changed and never used again: a row is only ever added, or its content retired
// while the row stays. The wire and the checkpoint carry the numbers; the order a class's bar, the
// spell table or a spawn list is written in is presentation and changes no byte.
//
// The pinned copy is proto/verse/everglade-content-ids-v1.json (docs/protocol/everglade-content-ids-v1.md).
// coax/web/room/content-profile.coax holds this table to it, and coax/web/tool.sh wire-check fails
// when a row of origin/main's copy is gone or changed. To add content: add its row at the end of its
// kind here and in the profile, with the next unused number, and set CONTENT_HASH to what the check prints.
//   coax/bin/coax test everglade/model/content-ids.coax
#load "../../metaverse-engine/core/ids.coax";

CT_ABILITY :: 1; CT_SPELL :: 2; CT_CREATURE :: 3; CT_ITEM :: 4; CT_SPAWN :: 5;
CT_KINDS :: 5;
CT_KIND :: [6] string.["", "ability", "spell", "creature", "item", "spawn"];
CT_KEY :: 96;   // bytes in a key at most
ContentRow :: struct { kind: int; id: int; key: string; }
CONTENT_N :: 211;
CONTENT_HASH :: 55127017896882;
CONTENT :: [CONTENT_N] ContentRow.[
