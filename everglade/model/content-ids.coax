// The number of `key` in `kind` (-1: no such content).
content_id :: (kind: int, key: string) -> int {
  for i: 0..<CONTENT_N { if CONTENT[i].kind == kind && CONTENT[i].key == key { return CONTENT[i].id; } }
  return -1;
}
// The key of number `id` in `kind` ("": no such content).
content_key :: (kind: int, id: int) -> string {
  for i: 0..<CONTENT_N { if CONTENT[i].kind == kind && CONTENT[i].id == id { return CONTENT[i].key; } }
  return "";
}
content_has :: (kind: int, id: int) -> bool { return content_key(kind, id).count > 0; }
// "a/b/c" as one key: the parts with a slash between them (an empty part is left out). The bytes
// written, 0 when it doesn't fit.
content_join :: (out: [] u8, a: string, b: string, c: string) -> int {
  n := 0;
  for part: [3] string.[a, b, c] {
    if part.count == 0 { continue; }
    if n + part.count + 1 > out.count { return 0; }
    if n > 0 { out[n] = '/'; n += 1; }
    for ch: part { out[n] = ch; n += 1; }
  }
  return n;
}
// The typed numbers.
content_ability :: (key: string) -> AbilityId { return AbilityId.{value = content_id(CT_ABILITY, key)}; }
content_spell :: (key: string) -> SpellId { return SpellId.{value = content_id(CT_SPELL, key)}; }
content_template :: (key: string) -> TemplateId { return TemplateId.{value = content_id(CT_CREATURE, key)}; }
content_item :: (key: string) -> ItemKindId { return ItemKindId.{value = content_id(CT_ITEM, key)}; }
content_spawn :: (key: string) -> SpawnId { return SpawnId.{value = content_id(CT_SPAWN, key)}; }

// The table's hash: every row's "KIND ID KEY\n" in order, two modular sums in one number below 2^53 (a JSON number holds it). The P
// frame's content pin (everglade/shared/everglade-wire.coax WIRE_CONTENT) is sealed with it: a
// table that changes changes the hash, and the pin's check then asks for a new pin.
content_hash_byte :: (h: [] int, b: int) {
  h[0] = (h[0] * 131 + b) % 1000000007; h[1] = (h[1] * 137 + b) % 998244353;
}
content_hash_int :: (h: [] int, v: int) {
  d: [20] int; n := 0; q := v;
  if q == 0 { d[0] = 0; n = 1; }
  while q > 0 { d[n] = q % 10; n += 1; q = q / 10; }
  for k: 0..<n { content_hash_byte(h, '0' + d[n - 1 - k]); }
}
content_hash_rows :: (rows: [] const ContentRow) -> int {
  h := [2] int.[7, 11];
  for i: 0..<rows.count {
    content_hash_int(h[..], rows[i].kind); content_hash_byte(h[..], ' ');
    content_hash_int(h[..], rows[i].id); content_hash_byte(h[..], ' ');
    for ch: rows[i].key { content_hash_byte(h[..], cast(int) ch); }
    content_hash_byte(h[..], '\n');
  }
  return h[0] * 1000000 + h[1] % 1000000;
}
content_hash :: () -> int { return content_hash_rows(CONTENT[..]); }

#test "content ids: no number and no key is used twice in a kind, and every row is well formed" #steps 200000000 {
  for i: 0..<CONTENT_N {
    r := CONTENT[i];
    #assert r.kind >= 1 && r.kind <= CT_KINDS && r.id >= 0 && r.key.count > 0 && r.key.count <= CT_KEY;
    for ch: r.key { #assert (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '-' || ch == '/'; }
    for j: 0..<i { #assert CONTENT[j].kind != r.kind || (CONTENT[j].id != r.id && CONTENT[j].key != r.key); }
    #assert content_id(r.kind, r.key) == r.id && content_key(r.kind, r.id) == r.key && content_has(r.kind, r.id);
  }
  #assert content_id(CT_ABILITY, "ability/none") == -1 && content_key(CT_SPELL, 9999) == "" && !content_has(CT_ITEM, 0);
  #assert content_id(CT_SPELL, "ability/barbarian/rage") == -1;
}
#test "content ids: the numbers the wire and the saves already carry are the frozen ones" {
  #assert content_ability("ability/barbarian/rage").value == 128 && content_ability("ability/wizard/spell/fire-bolt").value == 392;
  #assert content_ability("ability/cleric/spell/revivify").value == 186 && content_ability("ability/fighter/action-surge").value == 227;
  #assert content_spell("spell/produce-flame").value == 0 && content_spell("spell/fireball").value == 25 && content_spell("spell/revivify").value == 89;
  #assert content_spell("spell/water-orb").value == 103;
  #assert content_template("monster/wolf").value == 6 && content_template("monster/goblin-warrior").value == 3;
  #assert content_spawn("everglade2/pack-1/wolf-1").value == 0 && content_spawn("everglade2/camp/archer-2").value == 11;
  #assert content_item("item/none").value == -1;
}
#test "content ids: the recorded hash is the table's, and any changed row changes it" #steps 200000000 {
  #assert content_hash() == CONTENT_HASH;
  rows: [3] ContentRow; for i: 0..<3 { rows[i] = CONTENT[i]; }
  base := content_hash_rows(rows[..]);
  rows[1].id += 1; #assert content_hash_rows(rows[..]) != base; rows[1].id -= 1;
  rows[2].kind = CT_SPELL; #assert content_hash_rows(rows[..]) != base; rows[2].kind = CT_ABILITY;
  rows[0].key = "ability/barbarian/rag"; #assert content_hash_rows(rows[..]) != base; rows[0] = CONTENT[0];
  swap := rows[0]; rows[0] = rows[1]; rows[1] = swap; #assert content_hash_rows(rows[..]) != base;
  #assert content_hash_rows(rows[0..<2]) != base;
}
#test "content ids: a key is its parts with a slash between" {
  b: [32] u8;
  #assert cast(string) b[0..<content_join(b[..], "ability", "bard", "dash")] == "ability/bard/dash";
  #assert cast(string) b[0..<content_join(b[..], "spell", "", "hex")] == "spell/hex";
  small: [8] u8; #assert content_join(small[..], "ability", "bard", "") == 0;
}
