// The fixtures of everglade/model/item-op.coax's checks (proto/verse/everglade-item-op-v1.json holds
// the same bytes): a quest's reward grant, its answer with the character's record
// (character-checks.coax char_fixture), and a replayed refusal for a character with no record.

io_fixture :: () -> ItemOp #effects(all) {
  a := ItemOp.{op = LOP_GRANT, gen = 4, ver = 2, kind = 3, sent = 1762190000000};
  id := "s3-1762190000-7"; pid := "p-a";
  for i: 0..<id.count { a.id[i] = id[i]; } a.id_n = id.count;
  for i: 0..<pid.count { a.pid[i] = pid[i]; } a.pid_n = pid.count;
  a.claim = CharClaim.{quest = 1, from = 8, to = 9, coin = 25, xp = 100};
  return a;
}
IO_ASK_WIRE :: "{\"id\":\"s3-1762190000-7\",\"op\":\"grant\",\"pid\":\"p-a\",\"gen\":4,\"ver\":2,\"item\":null,\"to\":\"\",\"kind\":3,\"sent\":1762190000000,\"quest\":1,\"from\":8,\"stage\":9,\"coin\":25,\"xp\":100,\"slot\":-1,\"wear\":0}";
IO_ANSWER_WIRE :: "{\"status\":\"ok\",\"item\":12,\"replay\":false,\"ver\":5,\"kinds\":[3,1,3],\"rec\":{\"v\":1,\"who\":\"p-a\",\"class\":\"srd-ranger\",\"xp\":950,\"floor\":2,\"known\":[7,31],\"bag\":[4,9,12],\"inv\":5,\"worn\":[0,9,0,0,0,0,0,4,0,0],\"coin\":1250,\"quests\":[[3,0],[8,255]]}}";
IO_NONE_WIRE :: "{\"status\":\"version\",\"item\":null,\"replay\":true,\"ver\":0,\"kinds\":[],\"rec\":null}";

// Where `what` first stands in s, or -1.
io_find :: (s: string, what: string) -> int #effects(all) {
  for a: 0..<s.count { if a + what.count <= s.count && s[a..<a + what.count] == what { return a; } }
  return -1;
}

