// Everglade II's world into its pack by cell (GitHub #13280, AAA P2.7; docs/metaverse/one-world.md,
// "Paged by cell"): IN.pack with this tree's planting and the ground's record moved out of the
// catalog into a cells entry (kind 8, "cells"), written to OUT.pack. The catalog loses its G lines
// (the ground's record, read here and carried as the entry's first blob) and any P, Z and W lines,
// its "bytes" line states the new size,
// and gains:
//   P ...        the planting no cell carries (everglade/world/cell-pack.coax), when there is any
//   W cells K    the entry's account: it is source K's (the Stylized Nature kit the planting places)
//   Z CX CZ DIGEST AT N AT N    a line a cell of the manifest: its digest, the ground's blob and its own
// A page that is handed cells on demand (coax/web/host.js, pack-host.js loadPaged demand) takes a
// cell's bytes when the cell controller asks; page-pack defers the entry, so the pack publishes
// without it. apps/openagents-web/build.sh runs this on Everglade II's pack after rig-pack --into
// (the Z lines name places in the pack, so this entry goes in last) and before page-pack.
// The tracked pack keeps its G lines and carries no planting: a host that bundles it (the desktop
// and phone apps) plants at start and holds the world whole.
// Run: coax/web/tool.sh everglade/model/tools/cell-pack.coax IN.pack OUT.pack
// tool.sh: release
// tool.sh: stack-gib 8
#import "Basic";
#load "pack-entry.coax";
#load "../../world/cell-pack.coax";
#load "../../world/ground.coax";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";
#load "../../../coax/lib/sys/args.coax";

CLP_PACK :: 67108864;       // a pack at most (the paged reader's window)
CLP_CATALOG :: 16777216;
CLP_SOURCE :: "Quaternius Stylized Nature MegaKit";   // the L line the planting's pieces are licensed by starts with this
CLP_ROUNDS :: 8;            // the Z lines name places that move with their own length: written until they stand

// `pack` with the world w as its cells entry, into out: the size, -1 refused (not a pack, no source
// for the planting, no room, or the lines never stood). body is scratch for the catalog.
clp_into :: (pack: [] u8, w: [] E2cpWorld, out: [] u8, body: [] u8) -> int {
  t: [1] PackTable;
  if !pack_table(cast(string) pack, pack.count, t[..]) || t[0].count < 1 || t[0].entries[0].kind != PACK_CATALOG { return -1; }
  cat := cast(string) pack[t[0].entries[0].at..<t[0].entries[0].at + t[0].entries[0].n];
  bn := pke_strip(cat, "PGZW", body); lic := pke_source(cat, CLP_SOURCE);
  if bn < 0 || lic < 0 || lic > 254 { return -1; }
  if w[0].rest > 0 {
    ln := e2p_lines(w[0].rest_items[..], w[0].rest_kinds[..], w[0].rest_first[..], w[0].rest, body[bn..<body.count]);
    if ln < 0 { return -1; }
    bn += ln;
  }
  if bn + 32 > body.count { return -1; }
  for ch: "W cells " { body[bn] = ch; bn += 1; } bn += pke_number(lic, body[bn..<body.count]); body[bn] = '\n'; bn += 1;
  // the "bytes" line and the Z lines both state places that move with their own length: written until they stand
  drop := 1 << PACK_CELLS; zn := 0; total := 0; stood := false; zat := bn;
  for round: 0..<CLP_ROUNDS {
    zat = pke_bytes(body, bn, total);
    if zat < 0 { return -1; }
    at := pke_place(t[..], drop, zat + zn); size := at + pke_pad(w[0].bytes);
    z := e2cp_lines(w, at, size, body[zat..<body.count]);
    if z < 0 { return -1; }
    if z == zn && size == total { stood = true; break; }
    zn = z; total = size;
  }
  if !stood { return -1; }
  return pke_into(pack, t[..], drop, body[0..<zat + zn], PACK_CELLS, lic, "cells", w[0].entry[0..<w[0].bytes], out);
}
ClpCheck :: struct { w: [1] E2cpWorld; p: [4096] u8; o: [524288] u8; o2: [524288] u8; body: [262144] u8; back: [1] E2ccCheck; }
#test "a pack takes the world by cell: the cells entry last, a line a cell that finds its bytes, and the catalog's planting" #steps 8000000000 {
  c: [1] ClpCheck; #assert e2cp_test_world(c[0].w[..], e2_rows(19, 22)) && c[0].w[0].rest > 0;
  // a three-entry pack: the catalog with lines to go, four vertex bytes, a cells entry that is to go
  cat := "bytes 0000000000\nL 0 Quaternius Stylized Nature MegaKit|CC0|u\nG AAAA\nP AAAA\nZ 0 0 1 2 3\nW old 0\nC a 1 2 3\n";
  p := c[0].p[..]; for ch, i: "VPK1" { p[i] = ch; } pack_put32(p, 4, 3); pack_put32(p, 12, 4096); pack_put32(p, 16, 32); pack_put32(p, 20, 176);
  at := 176; p[32] = 1; p[33] = 255; pack_put32(p, 36, at); pack_put32(p, 40, cat.count); for ch, i: "catalog" { p[48 + i] = ch; } for ch: cat { p[at] = ch; at += 1; } at = ((at + 3) / 4) * 4;
  p[80] = 2; p[81] = 255; pack_put32(p, 84, at); pack_put32(p, 88, 4); for ch, i: "vertices" { p[96 + i] = ch; } for k: 0..<4 { p[at + k] = cast(u8) (200 + k); } at += 4;
  p[128] = cast(u8) PACK_CELLS; pack_put32(p, 132, at); pack_put32(p, 136, 3); for ch, i: "old" { p[144 + i] = ch; } p[at] = 9; at += 4; pack_put32(p, 8, at);
  n := clp_into(p[0..<at], c[0].w[..], c[0].o[..], c[0].body[..]); #assert n > 0 && n % 4 == 0;
  o := c[0].o[0..<n]; t: [1] PackTable; #assert pack_table(cast(string) o, n, t[..]) && t[0].count == 3;
  e := t[0].entries; #assert e[0].kind == 1 && e[1].kind == 2 && e[1].n == 4 && o[e[1].at] == 200 && e[2].kind == PACK_CELLS && e[2].name == "cells" && e[2].licence == 0 && e[2].n == c[0].w[0].bytes && e[2].at + pke_pad(e[2].n) == n;
  c2 := cast(string) o[e[0].at..<e[0].at + e[0].n]; line: [24] u8; ln := pke_bytes(line[..], 0, n); states := 0;
  for k: 0..<c2.count - ln + 1 { if (k == 0 || c2[k - 1] == '\n') && c2[k..<k + ln] == cast(string) line[0..<ln] { states += 1; } } #assert states == 1;
  // the catalog: the lines to go are gone, the catalog's planting reads back, and each cell's line finds the ground's blob and its own
  #assert c2[0..<44] == "L 0 Quaternius Stylized Nature MegaKit|CC0|u" && pke_source(c2, "W") == -1;
  olds := 0; for k: 0..<c2.count - 5 { if c2[k..<k + 6] == "W old " || c2[k..<k + 6] == "G AAAA" || c2[k..<k + 6] == "P AAAA" { olds += 1; } } #assert olds == 0;
  rest := e2p_from_catalog(c2, c[0].back[0].b[..], c[0].back[0].bk[..], c[0].back[0].bf[..]); #assert rest == c[0].w[0].rest;
  cells := E2Z_CELL; m := rest; held: [E2P_CELLS] int;
  for i: 0..<E2Z_CELLS {
    z := pack_cell_find(c2, pack_cell_key(cells[i].cx, cells[i].cz), n); #assert z.ok && z.ranges == 2 && z.digest == cells[i].digest;
    #assert e2cc_ground(o[z.at[0]..<z.at[0] + z.n[0]]).count == 6;
    blob := o[z.at[1]..<z.at[1] + z.n[1]]; #assert e2cc_plant_read(blob).ok && e2cc_plant_read(blob).cell == i;
    m = e2cc_insert(blob, c[0].back[0].b[..], c[0].back[0].bk[..], c[0].back[0].bf[..], held[..], m); #assert m > 0;
  }
  // the catalog's planting and every cell's together are the whole planting
  #assert m == c[0].w[0].planted;
  for q: 0..<E2P_CELLS + 1 { #assert c[0].back[0].bf[q] == c[0].w[0].first[q]; }
  for q: 0..<m { #assert c[0].back[0].bk[q] == c[0].w[0].kinds[q] && f32_bits(c[0].back[0].b[q * E2_ITEM_FLOATS + 2]) == f32_bits(c[0].w[0].items[q * E2_ITEM_FLOATS + 2]); }
  // again on its own output: the same bytes
  n2 := clp_into(o, c[0].w[..], c[0].o2[..], c[0].body[..]); #assert n2 == n && cast(string) c[0].o2[0..<n] == cast(string) o;
  // no source for the planting, not a pack, no room
  p[176 + 22] = 'q'; #assert clp_into(p[0..<at], c[0].w[..], c[0].o2[..], c[0].body[..]) == -1; p[176 + 22] = 'Q';
  #assert clp_into(p[0..<at - 4], c[0].w[..], c[0].o2[..], c[0].body[..]) == -1 && clp_into(p[0..<at], c[0].w[..], c[0].o2[0..<n - 1], c[0].body[..]) == -1 && clp_into(p[0..<at], c[0].w[..], c[0].o2[..], c[0].body[0..<200]) == -1;
}
tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) != 2 { tool_errln("usage: cell-pack IN.pack OUT.pack"); return 2; }
  pack: [CLP_PACK] u8; out: [CLP_PACK] u8; body: [CLP_CATALOG] u8; w: [1] E2cpWorld; rec: [E2G_RECORD_MAX] u8;
  size := fs_read(args_at(a[..], 0), pack[..]);
  if size < 32 { tool_errln("cell-pack: can't read the pack"); return 1; }
  t: [1] PackTable;
  if !pack_table(cast(string) pack[0..<size], size, t[..]) || t[0].count < 1 || t[0].entries[0].kind != PACK_CATALOG { tool_errln("cell-pack: not a pack with a catalog"); return 1; }
  rn := e2g_record_from_catalog(cast(string) pack[t[0].entries[0].at..<t[0].entries[0].at + t[0].entries[0].n], rec[..]);
  if rn <= 0 { tool_errln("cell-pack: the pack's catalog has no ground record (G lines); start from the tracked pack"); return 1; }
  w[0].planted = e2_plant(w[0].items[..], w[0].kinds[..], w[0].first[..]);
  if !e2cp_build(w[..], rec[0..<rn]) { tool_errln("cell-pack: the world doesn't fit its entry"); return 1; }
  at := clp_into(pack[0..<size], w[..], out[..], body[..]);
  if at < 0 { tool_errln("cell-pack: the pack is refused, has no source for the planting, or grows past 64 MiB"); return 1; }
  if !fs_write(args_at(a[..], 1), cast(string) out[0..<at]) { return 1; }
  most := 0; for i: 0..<E2Z_CELLS { if w[0].cell_n[i] > most { most = w[0].cell_n[i]; } }
  print("cell-pack: % pieces in % cells (the largest % bytes), % left to the catalog; the ground % bytes; the entry % bytes; the pack % bytes\n", w[0].planted - w[0].rest, E2Z_CELLS, most, w[0].rest, rn, w[0].bytes, at);
  return 0;
}
