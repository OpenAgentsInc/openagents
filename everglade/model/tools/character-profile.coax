// Checks proto/verse/everglade-character-v1.schema.json against everglade/model/character.coax, the
// record's one codec (#13290): each fixture's values, built into a Character here, write the fixture's
// bytes exactly and read back to the same character; each rejected body reads as not ok; the profile
// names itself, its version and this check.
// Usage: coax/web/tool.sh everglade/model/tools/character-profile.coax FILE.schema.json
#import "Basic";
#load "../character.coax";
#load "../character-checks.coax";   // the tool runs the record's check fixtures as code
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";

CP_FILE :: 65536;
CP_NODES :: 4096;
CP_CHECK :: "coax/web/tool.sh everglade/model/tools/character-profile.coax proto/verse/everglade-character-v1.schema.json";

cp_str :: (d: Jv, at: int, out: [] u8) -> string {
  n := jv_str(d, at, out);
  return ifx n >= 0 then cast(string) out[0..<n] else "";
}
// The integers of the array at node `at` into v: their count, or -1.
cp_ints :: (d: Jv, at: int, v: [] int) -> int {
  if jv_kind(d, at) != JV_ARRAY || jv_len(d, at) > v.count { return -1; }
  for i: 0..<jv_len(d, at) {
    n := jv_int(d, jv_at(d, at, i), -1);
    if n < 0 { return -1; }
    v[i] = n;
  }
  return jv_len(d, at);
}
// The character a fixture's values name, built field by field without the codec's reader.
cp_values :: (d: Jv, v: int) -> Character #effects(all) {
  wb: [CHAR_WHO + 8] u8; kb: [64] u8;
  c := char_new(cp_str(d, jv_get(d, v, "who"), wb[..]), jv_int(d, jv_get(d, v, "floor"), 0));
  if !c.ok || jv_int(d, jv_get(d, v, "v"), 0) != CHAR_VERSION { return Character.{}; }
  klass := cp_str(d, jv_get(d, v, "class"), kb[..]);
  one: [1] Character; one[0] = c;
  if klass.count > 0 && !char_class_set(one[..], klass) { return Character.{}; }
  c = one[0];
  c.xp = jv_int(d, jv_get(d, v, "xp"), -1);
  c.inv = jv_int(d, jv_get(d, v, "inv"), -1);
  c.coin = jv_int(d, jv_get(d, v, "coin"), -1);
  c.known_n = cp_ints(d, jv_get(d, v, "known"), c.known[..]);
  c.bag_n = cp_ints(d, jv_get(d, v, "bag"), c.bag[..]);
  if cp_ints(d, jv_get(d, v, "worn"), c.worn[..]) != CHAR_WORN { return Character.{}; }
  q := jv_get(d, v, "quests");
  if jv_kind(d, q) != JV_ARRAY || jv_len(d, q) > CHAR_QUESTS { return Character.{}; }
  for i: 0..<jv_len(d, q) {
    pair: [2] int;
    if cp_ints(d, jv_at(d, q, i), pair[..]) != 2 { return Character.{}; }
    c.quest[i] = pair[0]; c.stage[i] = pair[1];
  }
  c.quest_n = jv_len(d, q);
  return c;
}

cp_check :: (profile_json: string) -> bool #effects(all) {
  nodes: [CP_NODES] JvNode; da: [1] Jv;
  if !jv_parse(da[..], profile_json, nodes[..]) { return false; }
  d := da[0];
  nb: [128] u8; cb: [256] u8;
  if cp_str(d, jv_get(d, 0, "profile"), nb[..]) != "everglade-character-v1" || jv_int(d, jv_get(d, 0, "version"), 0) != CHAR_VERSION { return false; }
  if cp_str(d, jv_get(d, 0, "check"), cb[..]) != CP_CHECK { return false; }
  fxs := jv_get(d, 0, "fixtures");
  if jv_kind(d, fxs) != JV_ARRAY || jv_len(d, fxs) < 2 { return false; }
  for i: 0..<jv_len(d, fxs) {
    fx := jv_at(d, fxs, i);
    wb: [CHAR_BODY] u8; ob: [CHAR_BODY] u8; ob2: [CHAR_BODY] u8;
    wire := cp_str(d, jv_get(d, fx, "wire"), wb[..]);
    want := cp_values(d, jv_get(d, fx, "values"));
    if wire.count == 0 || !want.ok || char_write(want, ob[..]) != wire { return false; }
    got := char_read(wire);
    if !got.ok || char_write(got, ob2[..]) != wire || !char_same(got, want) { return false; }
  }
  rej := jv_get(d, 0, "rejected");
  if jv_kind(d, rej) != JV_ARRAY || jv_len(d, rej) < 4 { return false; }
  for i: 0..<jv_len(d, rej) {
    rb: [CHAR_BODY + 64] u8;
    n := jv_str(d, jv_at(d, rej, i), rb[..]);
    if n < 0 || char_read(cast(string) rb[0..<n]).ok { return false; }
  }
  return true;
}

#test "character profile tool refuses a profile that is not one" {
  #assert !cp_check("{}") && !cp_check("bad");
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) != 1 { tool_errln("usage: character-profile FILE.schema.json"); return 2; }
  raw: [CP_FILE] u8; n := fs_read(args_at(a[..], 0), raw[..]);
  if n <= 0 { tool_errln("character-profile: cannot read JSON"); return 2; }
  if !cp_check(cast(string) raw[0..<n]) { print("everglade-character-v1: profile fails\n"); return 1; }
  print("everglade-character-v1: profile holds\n");
  return 0;
}
