// Checks proto/verse/everglade-item-op-v1.json against everglade/model/item-op.coax, the item
// operation's one codec (#13291): the operation's fixture is the bytes the writer writes; each answer
// reads to the profile's values and writes back its own bytes; each rejected body does not read; the
// profile names itself, its version and this check.
// Usage: coax/web/tool.sh everglade/model/tools/item-op-profile.coax proto/verse/everglade-item-op-v1.json
#import "Basic";
#load "../item-op.coax";
#load "../../../coax/lib/sys/tool.coax";
#load "../../../coax/lib/sys/fs.coax";

IOP_FILE :: 65536;
IOP_CHECK :: "coax/web/tool.sh everglade/model/tools/item-op-profile.coax proto/verse/everglade-item-op-v1.json";

iop_str :: (d: Jv, at: int, out: [] u8) -> string {
  n := jv_str(d, at, out);
  return ifx n >= 0 then cast(string) out[0..<n] else "";
}
iop_check :: (profile_json: string) -> bool #effects(all) {
  nodes: [2048] JvNode; da: [1] Jv;
  if !jv_parse(da[..], profile_json, nodes[..]) { return false; }
  d := da[0];
  nb: [128] u8; cb: [256] u8; ib: [64] u8; wb: [IO_ANSWER] u8; ob: [IO_ANSWER] u8; sb: [32] u8;
  if iop_str(d, jv_get(d, 0, "profile"), nb[..]) != "everglade-item-op-v1" || iop_str(d, jv_get(d, 0, "id"), ib[..]) != "everglade.item-op.v1" || jv_int(d, jv_get(d, 0, "version"), 0) != 1 { return false; }
  if iop_str(d, jv_get(d, 0, "check"), cb[..]) != IOP_CHECK { return false; }
  // the operation: the fixture the codec's own checks build
  ask := iop_str(d, jv_path(d, 0, "ask.wire"), wb[..]);
  if ask.count == 0 || io_ask(io_fixture(), ob[..]) != ask { return false; }
  answers := jv_get(d, 0, "answers");
  if jv_kind(d, answers) != JV_ARRAY || jv_len(d, answers) < 2 { return false; }
  for i: 0..<jv_len(d, answers) {
    e := jv_at(d, answers, i);
    wire := iop_str(d, jv_get(d, e, "wire"), wb[..]);
    a := io_read(wire);
    if wire.count == 0 || !a.ok || io_word(a.status) != iop_str(d, jv_get(d, e, "status"), sb[..]) { return false; }
    if a.item != jv_int(d, jv_get(d, e, "item"), -1) || a.replay != jv_bool(d, jv_get(d, e, "replay")) || a.ver != jv_int(d, jv_get(d, e, "ver"), -1) { return false; }
    kinds := jv_get(d, e, "kinds");
    if a.kinds_n != jv_len(d, kinds) || a.has != jv_bool(d, jv_get(d, e, "record")) { return false; }
    for k: 0..<a.kinds_n { if a.kinds[k] != jv_int(d, jv_at(d, kinds, k), -1) { return false; } }
    // written again from what was read: the same bytes
    rb: [CHAR_BODY] u8; kb: [CHAR_BAG * 12 + 2] u8; ko: [1] Jo; jo_start(ko[..], kb[..]); jo_arr(ko[..]);
    for k: 0..<a.kinds_n { jo_int(ko[..], a.kinds[k]); }
    jo_end(ko[..]);
    if io_answer(a.status, a.item, a.replay, a.ver, jo_text(ko[..]), ifx a.has then char_write(a.rec, rb[..]) else "", ob[..]) != wire { return false; }
  }
  rej := jv_get(d, 0, "rejected");
  if jv_kind(d, rej) != JV_ARRAY || jv_len(d, rej) < 4 { return false; }
  for i: 0..<jv_len(d, rej) {
    n := jv_str(d, jv_at(d, rej, i), wb[..]);
    if n < 0 || io_read(cast(string) wb[0..<n]).ok { return false; }
  }
  return true;
}

#test "item op profile tool refuses a profile that is not one" {
  #assert !iop_check("{}") && !iop_check("bad");
}

tool_main :: () -> int #export_c #effects(all) {
  a: [1] Args;
  if !args_load(a[..]) || args_count(a[..]) != 1 { tool_errln("usage: item-op-profile FILE.json"); return 2; }
  raw: [IOP_FILE] u8; n := fs_read(args_at(a[..], 0), raw[..]);
  if n <= 0 { tool_errln("item-op-profile: cannot read JSON"); return 2; }
  if !iop_check(cast(string) raw[0..<n]) { print("everglade-item-op-v1: profile fails\n"); return 1; }
  print("everglade-item-op-v1: profile holds\n");
  return 0;
}
