EG_RIDE_CAM_BACK :: 1.5;   // metres the follow camera pulls back while you ride, and up
EG_RIDE_CAM_UP :: 0.5;
EG_GALLOP_STICK :: 0.92;   // a phone's stick pushed this far gallops
EG_REFUSED_S :: 2.0;       // seconds "No room to step down" shows

EG_PRESS_NONE :: 0; EG_PRESS_MOUNTED :: 1; EG_PRESS_DISMOUNTED :: 2; EG_PRESS_NO_ROOM :: 3; EG_PRESS_REFUSED :: 4; EG_PRESS_LAND_FIRST :: 5;
// The kinds of mount.
EG_HORSE :: MK_HORSE; EG_DRAGON :: MK_DRAGON;
// The seat a rider's legs take on each kind (everglade/scene/bodies.coax BD_SEAT_*: the same order).
EG_SEAT_OF :: [2] int.[0, 1];
// The SRD's Adult Red Dragon (shared/mount-kinds.coax).
EG_RED_DRAGON :: MK_RED_DRAGON;
EG_DRAGON_FRAMES :: DR_TOTAL;    // its baked frames in the pack
EG_DRAGON_PACE :: MK_DRAGON_PACE;
EG_DRAGON_SCALE :: 1.0;         // the model drawn at its own size
EG_DRAGON_CAM_BACK :: 15.0;     // metres the camera pulls back round the dragon, and up
EG_DRAGON_CAM_UP :: 4.0;
EG_LAND_FIRST_S :: 2.0;         // seconds "Land first" shows
// The two deeds, slots of the mounts' own bar, and their animations (Everglade's IDs, past class-feel.coax's).
EG_DEED_MOUNT :: 0; EG_DEED_DISMOUNT :: 1; EG_DEED_BREATH :: 2;
EG_ANIM_MOUNT :: 16; EG_ANIM_DISMOUNT :: 17; EG_ANIM_BREATH :: 18;
// Mounting: the swing up (the seat's blend), dust at the stirrup, a footfall; getting off the same down.
eg_mount_feel :: (slot: int) -> DeedFeel {
  if slot == EG_DEED_BREATH { return DeedFeel.{anim = EG_ANIM_BREATH, fx = FXR_DRAGON_BREATH, sound = "fireball", move = DeedMove.still}; }
  up := slot == EG_DEED_MOUNT;
  return DeedFeel.{anim = ifx up then EG_ANIM_MOUNT else EG_ANIM_DISMOUNT, fx = FXR_DUST, sound = ifx up then "step-2" else "step-1", move = DeedMove.step};
}

EgMounts :: struct {
  mounts: [EG_MOUNTS] Mount; n: int;
  first: [EG_HORSE_FRAMES] int; count: [EG_HORSE_FRAMES] int; word: [EG_HORSE_FRAMES] int; frames: int;   // the pack's glade/horse frames
  riding: int = -1;          // the mount you are on (or mounting, or getting off), -1 none
  refused_at: f32 = -100;    // when a dismount found no room
  ticked: f32 = -1;          // the clock at the last eg_mounts_dt
  deeds: [1] DeedBar;        // mounting's and getting off's asks and answers
  show: DeedShow; shows: int;   // the last accepted deed's presentation, and how many there have been
  kind: [EG_MOUNTS] int;     // EG_HORSE or EG_DRAGON, a mount
  clip_was: [EG_MOUNTS] int; clip_at: [EG_MOUNTS] f32;   // a dragon's clip and when it began, for its frames
  dfirst: [DR_TOTAL] int; dcount: [DR_TOTAL] int; dword: [DR_TOTAL] int; dframes: int;   // the pack's glade/dragon frames
  aloft_at: f32 = -100;      // when a dismount in the air was refused
  breath_at: f32 = -100;     // when the dragon you ride last breathed fire (its torrent pours on a moment: the zone's)
  land: bool;                // X pressed on the dragon in the air: it comes down to land (eg_ride_land)
}
// A kind's handling, and the dragon's wings.
eg_tune :: (m: EgMounts, k: int) -> MountTune { return mk_tune(m.kind[k]); }
eg_dragon_wings :: () -> WingProfile { return mk_dragon_wings(); }
// Seconds since the last call (the first, none), at most a tenth: a zone that steps its horses where it
// has no frame time of its own.
eg_mounts_dt :: (m: [] EgMounts, now: f32) -> f32 {
  last := m[0].ticked; m[0].ticked = now;
  if last < 0 || !(now > last) { return 0; }
  return ifx now - last > 0.1 then 0.1f32 else now - last;
}
// Where the rider is: on (in the saddle or on the way), at (x, z), y the pelvis's height in the
// world, facing `face`, `seated` 0 standing to 1 in the saddle.
EgRider :: struct { on: bool; x: f32; y: f32; z: f32; face: f32; seated: f32; }

eg_word_end :: (t: string, from: int) -> int { e := from; while e < t.count && t[e] != ' ' { e += 1; } return e; }
eg_whole_at :: (t: string, from: int) -> int {
  i := from; while i < t.count && t[i] == ' ' { i += 1; }
  v := 0; any := false;
  while i < t.count && t[i] >= '0' && t[i] <= '9' && v < 100000000 { v = v * 10 + cast(int) (t[i] - '0'); i += 1; any = true; }
  return ifx any then v else -1;
}
// The pack's catalog: "C glade/horseN FIRST COUNT SOURCE WORD 0 0" a frame.
eg_mounts_catalog :: (m: [] EgMounts, text: string) {
  m[0].frames = 0; for i: 0..<EG_HORSE_FRAMES { m[0].count[i] = 0; }
  m[0].dframes = 0; for i: 0..<DR_TOTAL { m[0].dcount[i] = 0; }
  at := 0;
  while at < text.count {
    e := at; while e < text.count && text[e] != '\n' { e += 1; }
    row := text[at..<e]; at = e + 1;
    horse := row.count >= 16 && row[0..<13] == "C glade/horse";
    dragon := row.count >= 17 && row[0..<14] == "C glade/dragon";
    if !horse && !dragon { continue; }
    ne := eg_word_end(row, 2); i := eg_whole_at(row[0..<ne], ifx horse then 13 else 14);
    if i < 0 || i >= (ifx horse then EG_HORSE_FRAMES else DR_TOTAL) { continue; }
    p := ne; first := eg_whole_at(row, p); p = eg_word_end(row, p + 1); count := eg_whole_at(row, p);
    p = eg_word_end(row, p + 1); p = eg_word_end(row, p + 1); word := eg_whole_at(row, p);
    if first < 0 || count <= 0 || count % 3 != 0 || word < 0 { continue; }
    if horse {
      if m[0].count[i] == 0 { m[0].frames += 1; }
      m[0].first[i] = first; m[0].count[i] = count; m[0].word[i] = word;
    } else {
      if m[0].dcount[i] == 0 { m[0].dframes += 1; }
      m[0].dfirst[i] = first; m[0].dcount[i] = count; m[0].dword[i] = word;
    }
  }
}
eg_mounts_ready :: (m: EgMounts) -> bool { return m.frames == EG_HORSE_FRAMES; }
eg_dragon_ready :: (m: EgMounts) -> bool { return m.dframes == DR_TOTAL; }
// A zone places a horse at (x, z) facing `face`; its index, or -1 when the zone has its EG_MOUNTS.
eg_mount_add :: (m: [] EgMounts, x: f32, z: f32, face: f32) -> int {
  if m[0].n >= EG_MOUNTS { return -1; }
  i := m[0].n; m[0].mounts[i] = mount_place(x, z, face); m[0].kind[i] = EG_HORSE; m[0].n += 1; return i;
}
// A zone places a red dragon standing on `ground` at (x, z) facing `face`; its index, or -1.
eg_dragon_add :: (m: [] EgMounts, x: f32, z: f32, face: f32, ground: f32) -> int {
  if m[0].n >= EG_MOUNTS { return -1; }
  i := m[0].n; m[0].mounts[i] = mount_place_wings(x, z, face, ground); m[0].kind[i] = EG_DRAGON; m[0].n += 1; return i;
}
// The free horse you could mount from (x, z): the nearest in reach, or -1.
eg_mount_nearest :: (m: EgMounts, x: f32, z: f32) -> int {
  best := -1; far: f32 = 1000000;
  for i: 0..<m.n { t := eg_tune(m, i); if !mount_near(m.mounts[i], t, x, z) { continue; } d := mount_distance(m.mounts[i], t, x, z); if d < far { far = d; best = i; } }
  return best;
}
eg_riding :: (m: EgMounts) -> bool { return m.riding >= 0; }
// E (or the phone's button) from you, `who`, standing at (x, z) with bearing b: mount the nearest free
// horse, or get off the one you ride where there's room. Ask, act, present: the bearing must let you
// act and move; then the mount's rules decide; a yes leaves its show. What happened (EG_PRESS_*).
eg_mount_press :: (m: [] EgMounts, who: int, x: f32, z: f32, now: f32, b: DeedBearing, walls: [] f32, n: int) -> int {
  slot := EG_DEED_MOUNT; i := -1;
  if m[0].riding >= 0 {
    if m[0].mounts[m[0].riding].state != MOUNT_RIDDEN { return EG_PRESS_NONE; }
    if mount_aloft(m[0].mounts[m[0].riding]) { m[0].aloft_at = now; return EG_PRESS_LAND_FIRST; }
    slot = EG_DEED_DISMOUNT;
  } else { i = eg_mount_nearest(m[0], x, z); if i < 0 { return EG_PRESS_NONE; } }
  tick := deed_tick(now); feel := eg_mount_feel(slot);
  seq := deed_ask(m[0].deeds[..], slot, tick, b, feel);
  if seq == 0 { return EG_PRESS_REFUSED; }
  r := EG_PRESS_REFUSED;
  if deed_can_move(b) {
    if slot == EG_DEED_DISMOUNT {
      k := m[0].riding;
      if mount_dismount(m[0].mounts[k..<k + 1], eg_tune(m[0], k), now, walls, n) { r = EG_PRESS_DISMOUNTED; }
      else { m[0].refused_at = now; r = EG_PRESS_NO_ROOM; }
    } else if mount_begin(m[0].mounts[i..<i + 1], eg_tune(m[0], i), who, x, z, now) { m[0].riding = i; r = EG_PRESS_MOUNTED; }
  }
  ok := r == EG_PRESS_MOUNTED || r == EG_PRESS_DISMOUNTED;
  _ := deed_answer(m[0].deeds[..], seq, ok, tick, 0);
  if ok { m[0].show = deed_show(feel, DeedResult.effect); m[0].shows += 1; }
  return r;
}
// The rider's steering from the keys (W and S forward and back, D and A turn right and left, Shift
// gallops) and a phone's stick (up forward, sideways turns, pushed all the way gallops).
eg_mount_input :: (forward: f32, turn: f32, gallop: bool, stick_on: bool, stick_x: f32, stick_y: f32) -> MountIn {
  if stick_on && stick_x * stick_x + stick_y * stick_y > 0.0004 {
    far := sqrt(stick_x * stick_x + stick_y * stick_y);
    return MountIn.{forward = stick_y, turn = stick_x, gallop = gallop || (far >= EG_GALLOP_STICK && stick_y > 0)};
  }
  return MountIn.{forward = forward, turn = turn, gallop = gallop};
}
// The rider's keys, every zone's: W and S go and slow, A and D turn (forward, turn: -1 to 1), a
// phone's stick does both. On the horse Shift gallops and Space jumps. On the dragon Space takes off, beats and
// (held) climbs, Shift dives in the air, and X lands (eg_ride_land) until Space flies on.
EgRideKeys :: struct { forward: f32; turn: f32; shift: bool; space: bool; stick_on: bool; stick_x: f32; stick_y: f32; }
eg_ride_input :: (m: [] EgMounts, k: EgRideKeys) -> MountIn {
  dragon := eg_on_dragon(m[0]); aloft := eg_aloft(m[0]);
  i := eg_mount_input(k.forward, k.turn, k.shift && !dragon, k.stick_on, k.stick_x, k.stick_y);
  if dragon { m[0].land = mk_land_holds(m[0].land, k.space, aloft); }
  return mk_keys(ifx dragon then EG_DRAGON else EG_HORSE, i, k.space, k.shift, aloft, m[0].land);   // the horse jumps (aethyr/action/mount.coax mount_step)
}
// The mount you ride is in the air on a jump (aethyr/action/mount.coax mount_jumping).
eg_jumping :: (m: EgMounts) -> bool { return m.riding >= 0 && mount_jumping(m.mounts[m.riding]); }
// X on the dragon in the air: it comes down to land. False otherwise (the key goes on).
eg_ride_land :: (m: [] EgMounts) -> bool {
  if !eg_on_dragon(m[0]) || !eg_aloft(m[0]) { return false; }
  m[0].land = true; return true;
}
// The phone's MOUNT and DISMOUNT button on a page w by h at scale k: right of centre, above the bar
// (x0, y0, x1, y1). A prompt is a button unless it only tells you something ("No room to step
// down", "Land first").
eg_ride_button :: (w: f32, h: f32, k: f32) -> [4] f32 { return [4] f32.[w - 170 * k, h * 0.52, w - 30 * k, h * 0.52 + 48 * k]; }
eg_prompt_pressable :: (t: string) -> bool { return t.count > 0 && t[0] != 'N' && t[0] != 'L'; }
// The mount's keys (eg_mount_hint) are a small line under the bar, never in the middle of the view,
// so nothing sits over the horse or the dragon while you ride. Its size: EG_RIDE_HINT_CAP, made
// smaller until a line `wide` at that size fits the page; its baseline EG_RIDE_HINT_UP from the foot.
EG_RIDE_HINT_CAP :: 9.0;    // CSS px
EG_RIDE_HINT_UP :: 11.0;
EG_RIDE_HINT_SIDE :: 16.0;  // CSS px kept clear at each side
eg_ride_hint_cap :: (wide: f32, w: f32, k: f32) -> f32 {
  cap := f32(EG_RIDE_HINT_CAP) * k; room := w - 2 * f32(EG_RIDE_HINT_SIDE) * k;
  return ifx wide > room && wide > 0 then cap * room / wide else cap;
}
// A frame: the horse you ride steps (dt seconds, among the walker's boxes), every horse finishes its
// mount or dismount, and the free ones stand where they were left. False when you've just got off.
eg_mounts_tick :: (m: [] EgMounts, i: MountIn, dt: f32, now: f32, walls: [] f32, n: int) -> bool {
  return eg_mounts_fly(m, i, dt, now, 0, walls, n);
}
// The same, `ground` the floor's height under the mount you ride (a dragon lands on it, takes off from
// it): a dragon flies on the jump, dive and land, and its clip's clock keeps its frames.
eg_mounts_fly :: (m: [] EgMounts, i: MountIn, dt: f32, now: f32, ground: f32, walls: [] f32, n: int) -> bool {
  for k: 0..<m[0].n {
    one := m[0].mounts[k..<k + 1]; t := eg_tune(m[0], k); in := ifx k == m[0].riding then i else MountIn.{};
    mount_settle(one, t, now);
    if m[0].kind[k] == EG_DRAGON { mount_step_wings(one, t, eg_dragon_wings(), in, ifx k == m[0].riding then ground else one[0].wing.y, dt, walls, n); }
    else { mount_step(one, t, in, dt, walls, n); }
    if one[0].clip != m[0].clip_was[k] { m[0].clip_was[k] = one[0].clip; m[0].clip_at[k] = now; }
  }
  if m[0].riding >= 0 && m[0].mounts[m[0].riding].state == MOUNT_FREE { m[0].riding = -1; return false; }
  return true;
}
// Mount k's saddle in the world at `now` (where your pelvis goes), its feet on `ground`.
eg_saddle :: (m: EgMounts, k: int, ground: f32, now: f32) -> [3] f32 {
  h := m.mounts[k];
  if m.kind[k] == EG_DRAGON {
    // the saddle bone in this frame (the clip rears the chest to take off and hover), turned with
    // the dragon's pitch: the seat swings with the body
    sc := f32(EG_DRAGON_SCALE); lp := eg_dragon_pitch(h); f := eg_dragon_frame(m, k, now);
    x0 := DR_SEAT[f * 3] * sc; y0 := DR_SEAT[f * 3 + 1] * sc + f32(EG_DRAGON_SEAT_UP); z0 := DR_SEAT[f * 3 + 2] * sc;
    sp := sin(lp); cp := cos(lp);
    return mount_seat(h, h.wing.y, [3] f32.[x0, cp * y0 + sp * z0, -sp * y0 + cp * z0]);
  }
  f := mount_frame(h, EG_HORSE_CLIP);
  return mount_seat(h, mount_feet(h, ground), [3] f32.[EG_SADDLE[f * 3], EG_SADDLE[f * 3 + 1] + f32(EG_HORSE_SEAT_UP), EG_SADDLE[f * 3 + 2]]);   // a jump lifts the saddle with the horse
}
// The seat your legs take on what you ride (everglade/scene/bodies.coax BD_SEAT_*).
eg_seat :: (m: EgMounts) -> int { return ifx m.riding >= 0 then EG_SEAT_OF[m.kind[m.riding]] else 0; }
// Where you are while you ride (ground: under the horse) and your pelvis's height standing (hip): from
// where you stood to the saddle and back as you mount and get off.
eg_rider :: (m: EgMounts, now: f32, ground: f32, standing_ground: f32, hip: f32) -> EgRider {
  if m.riding < 0 { return EgRider.{}; }
  h := m.mounts[m.riding]; s := mount_seated(h, eg_tune(m, m.riding), now); seat := eg_saddle(m, m.riding, ground, now);
  stand := [3] f32.[h.from_x, standing_ground + hip, h.from_z];
  return EgRider.{on = true, seated = s, face = h.face,
    x = stand[0] + (seat[0] - stand[0]) * s, y = stand[1] + (seat[1] - stand[1]) * s, z = stand[2] + (seat[2] - stand[2]) * s};
}
// What the prompt says (keyboard) and the phone's button (touch); "" for nothing.
eg_mount_prompt :: (m: EgMounts, x: f32, z: f32, now: f32, touch: bool) -> string {
  if now - m.refused_at < EG_REFUSED_S { return "No room to step down"; }
  if now - m.aloft_at < f32(EG_LAND_FIRST_S) { return "Land first"; }
  if m.riding >= 0 {
    h := m.mounts[m.riding]; if h.state != MOUNT_RIDDEN { return ""; }
    if mount_aloft(h) { return ifx touch then "" else "X  Land"; }
    return ifx touch then "DISMOUNT" else "E  Dismount";
  }
  if eg_mount_nearest(m, x, z) >= 0 { return ifx touch then "MOUNT" else "E  Mount"; }
  return "";
}
// How far the riding camera is in, 0 to 1 (it eases with your seat).
eg_ride_cam :: (m: EgMounts, now: f32) -> f32 { if m.riding < 0 { return 0; } return mount_seated(m.mounts[m.riding], eg_tune(m, m.riding), now); }
// How far back and up the riding camera goes, metres: round a dragon far more than a horse.
eg_ride_cam_back :: (m: EgMounts) -> f32 { return ifx m.riding >= 0 && m.kind[m.riding] == EG_DRAGON then f32(EG_DRAGON_CAM_BACK) else f32(EG_RIDE_CAM_BACK); }
eg_ride_cam_up :: (m: EgMounts) -> f32 { return ifx m.riding >= 0 && m.kind[m.riding] == EG_DRAGON then f32(EG_DRAGON_CAM_UP) else f32(EG_RIDE_CAM_UP); }
// Whether you ride the dragon, and whether it is in the air.
eg_on_dragon :: (m: EgMounts) -> bool { return m.riding >= 0 && m.kind[m.riding] == EG_DRAGON; }
eg_aloft :: (m: EgMounts) -> bool { return m.riding >= 0 && mount_aloft(m.mounts[m.riding]); }
// Horse k as a moved mesh record (24 floats at out[rec * 24]: its feet, its facing's sine and cosine, its
// vertex word; the shared mode 18 of everglade/scene/gpu/character-glade.coax) and its frame's draw: the index range.
EgHorseDraw :: struct { first: int; count: int; }
eg_horse_record :: (m: EgMounts, k: int, ground: f32, out: [] f32, rec: int) -> EgHorseDraw {
  if m.kind[k] == EG_DRAGON { return eg_dragon_record(m, k, 0, out, rec); }
  h := m.mounts[k]; f := mount_frame(h, EG_HORSE_CLIP); at := rec * 24;
  if at + 24 > out.count || !eg_mounts_ready(m) { return EgHorseDraw.{}; }
  for i: 0..<24 { out[at + i] = 0; }
  out[at] = h.x; out[at + 1] = mount_feet(h, ground); out[at + 2] = h.z; out[at + 7] = f32(m.word[f]);
  out[at + 8] = sin(h.face); out[at + 9] = cos(h.face); out[at + 15] = 18;
  return EgHorseDraw.{first = m.first[f], count = m.count[f]};
}

// ---- the red dragon's look

// Its clip for the flight's (WING_CLIP_*): it stands saddled, walks, takes off, flies, glides (and
// dives on folded wings), hovers and lands. It turns flying level: its rider sits upright, and a
// body rolled into a bank (the bank clips, or a lean) would swing the neck into the rider's legs.
EG_DRAGON_CLIP :: [10] int.[DR_IDLE_SADDLED, DR_WALK, DR_TAKEOFF, DR_FLY, DR_GLIDE, DR_HOVER, DR_FLY, DR_FLY, DR_GLIDE, DR_LAND];
// The baked frame dragon k shows at `now`: its walk by the ground covered, the rest by their own clock.
eg_dragon_frame :: (m: EgMounts, k: int, now: f32) -> int {
  h := m.mounts[k]; c := ifx h.clip >= 0 && h.clip < 10 then h.clip else 0; dc := EG_DRAGON_CLIP[c];
  t := ifx c == WING_CLIP_WALK then h.phase * DR_SECONDS[DR_WALK] else now - m.clip_at[k];
  return dr_frame(dc, t);
}
// Its nose up as it climbs and down as it dives, in the air only: never so far down that its neck
// rises into the upright rider's thighs (EG_DRAGON_DIVE_PITCH, checked with the legs).
EG_DRAGON_DIVE_PITCH :: -0.2;
EG_DRAGON_CLIMB_PITCH :: 0.3;
eg_dragon_pitch :: (h: Mount) -> f32 {
  if h.wing.phase != WING_AIR { return 0; }
  return mt_clamp(h.wing.vy * 0.05, f32(EG_DRAGON_DIVE_PITCH), f32(EG_DRAGON_CLIMB_PITCH));
}
// Dragon k as a placed mesh record (the shared mode 19: its feet, and its turned, pitched and scaled
// axes) and its frame's draw at `now`.
eg_dragon_record :: (m: EgMounts, k: int, now: f32, out: [] f32, rec: int) -> EgHorseDraw {
  at := rec * 24;
  if at + 24 > out.count || !eg_dragon_ready(m) { return EgHorseDraw.{}; }
  h := m.mounts[k]; f := eg_dragon_frame(m, k, now);
  if f < 0 || f >= DR_TOTAL || m.dcount[f] <= 0 { return EgHorseDraw.{}; }
  for i: 0..<24 { out[at + i] = 0; }
  sc := f32(EG_DRAGON_SCALE); yaw := h.face; pitch := eg_dragon_pitch(h);
  cy := cos(yaw); sy := sin(yaw); cp := cos(pitch); sp := sin(pitch);
  // the model's axes (x its left, y up, z ahead): pitched nose up by the climb, then turned to its
  // heading (eg_saddle turns the seat the same)
  ax := [9] f32.[1, 0, 0,   0, cp, -sp,   0, sp, cp];
  base := [3] int.[8, 16, 20];
  for j: 0..<3 {
    lx := ax[j * 3]; ly := ax[j * 3 + 1]; lz := ax[j * 3 + 2];
    out[at + base[j]] = (lx * cy + lz * sy) * sc; out[at + base[j] + 1] = ly * sc; out[at + base[j] + 2] = (-lx * sy + lz * cy) * sc;
  }
  out[at] = h.x; out[at + 1] = h.wing.y; out[at + 2] = h.z; out[at + 7] = f32(m.dword[f]); out[at + 15] = 19;
  return EgHorseDraw.{first = m.dfirst[f], count = m.dcount[f]};
}

// ---- the dragon's Fire Breath, at your word

// Its jaws at rest, in its own frame (x its left, y up, z ahead), metres: a little over its height
// and a little under half its length ahead of its feet.
EG_DRAGON_MOUTH :: [3] f32.[0, 3.6, 6.3];
EG_BREATH_M :: 18.288;   // the SRD's 60-foot cone, in metres
// Where the jaws are now: turned to its heading and pitched with its climb.
eg_dragon_mouth :: (m: EgMounts, k: int) -> [3] f32 {
  h := m.mounts[k]; p := eg_dragon_pitch(h); sc := f32(EG_DRAGON_SCALE);
  y := EG_DRAGON_MOUTH[1] * sc; z := EG_DRAGON_MOUTH[2] * sc;
  return mount_seat(h, h.wing.y, [3] f32.[0, y * cos(p) + z * sin(p), -y * sin(p) + z * cos(p)]);
}
// F on the dragon: the rider asks with their bearing (the dragon breathes at your word; knocked out or
// held, you can't give it). The request's number for the zone, which acts with the SRD's breath on
// its battle and answers with eg_breath_answer; 0 when there's no dragon under you or no yes.
eg_breath_ask :: (m: [] EgMounts, now: f32, b: DeedBearing) -> int {
  if !eg_on_dragon(m[0]) || m[0].mounts[m[0].riding].state != MOUNT_RIDDEN { return 0; }
  return deed_ask(m[0].deeds[..], EG_DEED_BREATH, deed_tick(now), b, eg_mount_feel(EG_DEED_BREATH));
}
// The rules' answer: only a yes presents (its fire, its roar of flame).
eg_breath_answer :: (m: [] EgMounts, seq: int, ok: bool, now: f32) {
  _ := deed_answer(m[0].deeds[..], seq, ok, deed_tick(now), 0);
  if ok { m[0].show = deed_show(eg_mount_feel(EG_DEED_BREATH), DeedResult.effect); m[0].shows += 1; m[0].breath_at = now; }
}
// The keys while you ride, or stand by a mount: a short line for the HUD's hint under the bar, never
// the middle of the view. What E, Space, Shift, A and D, X and F do now; "" for nothing.
eg_mount_hint :: (m: EgMounts, x: f32, z: f32, now: f32) -> string {
  if now - m.refused_at < EG_REFUSED_S { return "NO ROOM TO STEP DOWN"; }
  if now - m.aloft_at < f32(EG_LAND_FIRST_S) { return "LAND FIRST"; }
  if m.riding >= 0 {
    h := m.mounts[m.riding]; if h.state != MOUNT_RIDDEN { return ""; }
    if m.kind[m.riding] == EG_DRAGON {
      if mount_aloft(h) { return "SPACE CLIMB  SHIFT DIVE  A D BANK  F FIRE BREATH  X LAND"; }
      return "SPACE TAKE OFF  F FIRE BREATH  E DISMOUNT";
    }
    return "SPACE JUMP  SHIFT GALLOP  E DISMOUNT";
  }
  if eg_mount_nearest(m, x, z) >= 0 { return "E MOUNT"; }
  return "";
}

// ---- checks
#test "the rider's keys: Shift gallops a horse and dives a dragon in the air; Space takes off and climbs; X lands until Space flies on (mounts)" #steps 400000000 {
  m: [1] EgMounts; #assert eg_mount_add(m[..], 0, 0, 0) == 0; m[0].riding = 0; m[0].mounts[0].state = MOUNT_RIDDEN;
  i := eg_ride_input(m[..], EgRideKeys.{forward = 1, shift = true}); #assert i.gallop && i.forward == 1 && !i.jump && !i.dive && !eg_ride_land(m[..]);
  #assert eg_ride_input(m[..], EgRideKeys.{forward = 1, space = true}).jump && !eg_ride_input(m[..], EgRideKeys.{space = true}).climb;   // Space jumps the horse
  s := eg_ride_input(m[..], EgRideKeys.{stick_on = true, stick_x = 0.2, stick_y = 0.95}); #assert s.gallop && s.turn == 0.2;
  d: [1] EgMounts; #assert eg_dragon_add(d[..], 0, 0, 0, 0) == 0; d[0].riding = 0; d[0].mounts[0].state = MOUNT_RIDDEN; none: [6] f32;
  g := eg_ride_input(d[..], EgRideKeys.{forward = 1, shift = true, space = true}); #assert !g.gallop && g.jump && g.climb && !g.dive && !g.land && !eg_ride_land(d[..]);
  for k: 0..<240 { on := eg_mounts_fly(d[..], eg_ride_input(d[..], EgRideKeys.{forward = 1, space = true}), 1.0 / 60, f32(k) / 60, 0, none[..], 0); }
  #assert eg_aloft(d[0]);
  a := eg_ride_input(d[..], EgRideKeys.{shift = true}); #assert a.dive && !a.land;
  #assert eg_ride_land(d[..]) && eg_ride_input(d[..], EgRideKeys.{}).land && !eg_ride_input(d[..], EgRideKeys.{space = true}).land && !d[0].land;
}
#test "the phone's button sits right of centre above the bar; the hint's line shrinks to fit a narrow page (mounts)" {
  b := eg_ride_button(1170, 2532, 3); #assert b[0] > 1170 * 0.5 && b[2] < 1170 && b[1] > 2532 * 0.5 && b[3] - b[1] == 144;
  #assert eg_prompt_pressable("MOUNT") && eg_prompt_pressable("DISMOUNT") && !eg_prompt_pressable("No room to step down") && !eg_prompt_pressable("Land first") && !eg_prompt_pressable("");
  #assert eg_ride_hint_cap(300, 1920, 1) == EG_RIDE_HINT_CAP && eg_ride_hint_cap(700, 382, 1) == EG_RIDE_HINT_CAP * 350 / 700;
}

EG_TEST_CATALOG :: "C glade/environment 9 12 250 100 8 0\nC glade/horse0 300 60 247 100 0 0\nC glade/horse35 900 63 247 100 0 0\n";
#test "the catalog finds the horse's frames; a zone is ready only with all 36" {
  m: [1] EgMounts; eg_mounts_catalog(m[..], EG_TEST_CATALOG);
  #assert m[0].frames == 2 && m[0].first[0] == 300 && m[0].count[35] == 63 && m[0].word[35] == 100 && !eg_mounts_ready(m[0]);
}
#test "E mounts only near a free horse, E again gets off, and the horse stays where you left it" {
  m: [1] EgMounts; _ := eg_mount_add(m[..], 10, 0, 0); none: [6] f32;
  #assert eg_mount_press(m[..], 0, 13.5, 0, 0, DeedBearing.{}, none[..], 0) == EG_PRESS_NONE && !eg_riding(m[0]);
  #assert eg_mount_prompt(m[0], 13.5, 0, 0, false) == "" && eg_mount_prompt(m[0], 12, 0, 0, false) == "E  Mount" && eg_mount_prompt(m[0], 12, 0, 0, true) == "MOUNT";
  #assert eg_mount_press(m[..], 0, 12, 0, 0, DeedBearing.{}, none[..], 0) == EG_PRESS_MOUNTED && eg_riding(m[0]);
  // the mount's moment: the horse stands, you rise from where you stood to the saddle
  r0 := eg_rider(m[0], 0, 0, 0, 0.91); #assert r0.on && r0.x == 12 && r0.y == 0.91;
  for k: 1..<60 { go := eg_mounts_tick(m[..], MountIn.{forward = 1}, 1.0f32 / 60, f32(k) / 60, none[..], 0); }
  r1 := eg_rider(m[0], 1, 0, 0, 0.91); #assert r1.seated == 1 && r1.y > 1.45 && abs(r1.x - 10) < 0.1;
  #assert eg_mount_prompt(m[0], 0, 0, 1, false) == "E  Dismount";
  for k: 60..<240 { go := eg_mounts_tick(m[..], MountIn.{forward = 1, gallop = true}, 1.0f32 / 60, f32(k) / 60, none[..], 0); }
  #assert eg_mount_press(m[..], 0, 0, 0, 4, DeedBearing.{}, none[..], 0) == EG_PRESS_DISMOUNTED;
  left := true; for k: 240..<300 { if !eg_mounts_tick(m[..], MountIn.{}, 1.0f32 / 60, f32(k) / 60, none[..], 0) { left = false; } }
  #assert !left && !eg_riding(m[0]);
  x := m[0].mounts[0].x; z := m[0].mounts[0].z; #assert z > 15;
  for k: 300..<600 { go := eg_mounts_tick(m[..], MountIn.{forward = 1, gallop = true}, 1.0f32 / 60, f32(k) / 60, none[..], 0); }
  #assert m[0].mounts[0].x == x && m[0].mounts[0].z == z;
  // walk back to it and mount again
  #assert eg_mount_press(m[..], 0, x + 1.5, z, 10, DeedBearing.{}, none[..], 0) == EG_PRESS_MOUNTED;
}
#test "no room to step down keeps you on, and says so" {
  m: [1] EgMounts; _ := eg_mount_add(m[..], 0, 0, 0); none: [6] f32;
  _ = eg_mount_press(m[..], 0, 1, 0, 0, DeedBearing.{}, none[..], 0); go := eg_mounts_tick(m[..], MountIn.{}, 0.05, 1, none[..], 0); #assert go;
  both := [12] f32.[0.8, 0, -2, 3, 2, 2,   -3, 0, -2, -0.8, 2, 2];
  #assert eg_mount_press(m[..], 0, 0, 0, 2, DeedBearing.{}, both[..], 2) == EG_PRESS_NO_ROOM && eg_riding(m[0]) && eg_mount_prompt(m[0], 0, 0, 2.5, false) == "No room to step down";
}
#test "a phone's stick steers, and pushed all the way it gallops" {
  a := eg_mount_input(0, 0, false, true, 0.2, 0.5); #assert a.forward == 0.5 && a.turn == 0.2 && !a.gallop;
  b := eg_mount_input(0, 0, false, true, 0, 1); #assert b.gallop;
  c := eg_mount_input(1, -1, true, false, 0, 0); #assert c.forward == 1 && c.turn == -1 && c.gallop;
}
#test "the horse's record: its feet, its facing and its frame's mesh" {
  m: [1] EgMounts; _ := eg_mount_add(m[..], 3, 4, 1.5707964);
  for i: 0..<EG_HORSE_FRAMES { m[0].first[i] = 1000 + i * 100; m[0].count[i] = 99; m[0].word[i] = 7; } m[0].frames = EG_HORSE_FRAMES;
  out: [48] f32; d := eg_horse_record(m[0], 0, 2, out[..], 1);
  #assert d.first == 1000 && d.count == 99 && out[24] == 3 && out[25] == 2 && out[26] == 4 && abs(out[32] - 1) < 0.0001 && out[39] == 18 && out[31] == 7;
}
#test "mounting is a deed: it asks with your bearing, and only a yes plays its feel" {
  m: [1] EgMounts; _ := eg_mount_add(m[..], 0, 0, 0); none: [6] f32;
  #assert deed_feel_ok(eg_mount_feel(EG_DEED_MOUNT)) && deed_feel_ok(eg_mount_feel(EG_DEED_DISMOUNT));
  down := deed_bear(DeedBearing.{}, DeedPose.down, DEED_LOCK_ALL);     // unconscious
  #assert eg_mount_press(m[..], 0, 1.5, 0, 0, down, none[..], 0) == EG_PRESS_REFUSED && !eg_riding(m[0]) && m[0].shows == 0;
  held := deed_bear(DeedBearing.{}, DeedPose.held, DEED_LOCK_MOVE);    // grappled: it can act but not move
  #assert eg_mount_press(m[..], 0, 1.5, 0, 1, held, none[..], 0) == EG_PRESS_REFUSED && !eg_riding(m[0]) && m[0].shows == 0;
  #assert m[0].deeds[0].refused == 2;
  #assert eg_mount_press(m[..], 0, 1.5, 0, 2, DeedBearing.{}, none[..], 0) == EG_PRESS_MOUNTED && m[0].shows == 1;
  #assert m[0].show.play && m[0].show.anim == EG_ANIM_MOUNT && m[0].show.sound == "step-2" && m[0].show.fx == FXR_DUST;
  go := eg_mounts_tick(m[..], MountIn.{}, 0.05, 3, none[..], 0); #assert go;
  #assert eg_mount_press(m[..], 0, 0, 0, 4, DeedBearing.{}, none[..], 0) == EG_PRESS_DISMOUNTED && m[0].shows == 2 && m[0].show.anim == EG_ANIM_DISMOUNT;
}
#test "the catalog finds the dragon's frames beside the horse's; the dragon is ready with all 75" {
  m: [1] EgMounts; eg_mounts_catalog(m[..], "C glade/horse0 300 60 247 100 0 0\nC glade/dragon0 5000 90 246 200 0 0\nC glade/dragon74 9000 93 246 200 0 0\n");
  #assert m[0].frames == 1 && m[0].dframes == 2 && m[0].dfirst[74] == 9000 && m[0].dcount[0] == 90 && m[0].dword[74] == 200 && !eg_dragon_ready(m[0]);
  for i: 0..<DR_TOTAL { m[0].dcount[i] = 3; } m[0].dframes = DR_TOTAL; #assert eg_dragon_ready(m[0]);
}
#test "the red dragon: mounted in reach, Space takes off, it outflies a gallop, nobody gets off aloft, X lands, and it stays where you leave it" #steps 400000000 {
  m: [1] EgMounts; none: [6] f32; g: f32 = 2;
  k := eg_dragon_add(m[..], 0, 0, 0, g); #assert k == 0 && m[0].kind[0] == EG_DRAGON && m[0].mounts[0].flies;
  // its flank is 1.6 m from its spine; 4 m of reach from there, not from a horse's 2.5
  #assert eg_mount_press(m[..], 0, 6.2, 0, 0, DeedBearing.{}, none[..], 0) == EG_PRESS_NONE;
  #assert eg_mount_prompt(m[0], 3.5, 0, 0, false) == "E  Mount";
  #assert eg_mount_press(m[..], 0, 3.5, 0, 0, DeedBearing.{}, none[..], 0) == EG_PRESS_MOUNTED && eg_on_dragon(m[0]);
  now: f32 = 0; dt: f32 = 1.0 / 60;
  for i: 0..<60 { now += dt; go := eg_mounts_fly(m[..], MountIn.{}, dt, now, g, none[..], 0); }
  r := eg_rider(m[0], now, g, g, 0.91); #assert r.seated == 1 && r.y > g + 3.5 && abs(r.z - 1.2) < 0.1;
  // Space: up off the ground, and held it climbs
  for i: 0..<90 { now += dt; go := eg_mounts_fly(m[..], MountIn.{forward = 1, jump = true, climb = true}, dt, now, g, none[..], 0); }
  #assert eg_aloft(m[0]) && m[0].mounts[0].wing.y > g + 6 && eg_mount_prompt(m[0], 0, 0, now, false) == "X  Land";
  // forward on: it flies at its Fly 80 ft, well past the horse's 14 m/s gallop
  for i: 0..<240 { now += dt; go := eg_mounts_fly(m[..], MountIn.{forward = 1}, dt, now, g, none[..], 0); }
  z0 := m[0].mounts[0].z; for i: 0..<60 { now += dt; go := eg_mounts_fly(m[..], MountIn.{forward = 1}, dt, now, g, none[..], 0); }
  #assert m[0].mounts[0].z - z0 > EG_RIDING_HORSE.gallop + 2;
  // E in the air: "Land first", and you stay on
  #assert eg_mount_press(m[..], 0, 0, 0, now, DeedBearing.{}, none[..], 0) == EG_PRESS_LAND_FIRST && eg_on_dragon(m[0]) && eg_mount_prompt(m[0], 0, 0, now + 0.5, false) == "Land first";
  // X: it comes down and settles on its feet
  for i: 0..<900 { now += dt; go := eg_mounts_fly(m[..], MountIn.{land = true}, dt, now, g, none[..], 0); }
  #assert !eg_aloft(m[0]) && m[0].mounts[0].wing.y == g;
  now += 3;
  #assert eg_mount_press(m[..], 0, 0, 0, now, DeedBearing.{}, none[..], 0) == EG_PRESS_DISMOUNTED;
  left := true; for i: 0..<60 { now += dt; if !eg_mounts_fly(m[..], MountIn.{}, dt, now, g, none[..], 0) { left = false; } }
  #assert !left && !eg_riding(m[0]);
  x := m[0].mounts[0].x; z := m[0].mounts[0].z;
  for i: 0..<120 { now += dt; go := eg_mounts_fly(m[..], MountIn.{forward = 1, jump = true}, dt, now, g, none[..], 0); }
  #assert m[0].mounts[0].x == x && m[0].mounts[0].z == z && m[0].mounts[0].wing.y == g;
}
#test "the dragon's record: its feet, its axes turned to its heading and leaning into a turn, and its clip's frame" {
  m: [1] EgMounts; _ := eg_dragon_add(m[..], 3, 4, 1.5707964, 1);
  for i: 0..<DR_TOTAL { m[0].dfirst[i] = 1000 + i * 10; m[0].dcount[i] = 9; m[0].dword[i] = 5; } m[0].dframes = DR_TOTAL;
  out: [48] f32; d := eg_dragon_record(m[0], 0, 0, out[..], 1);
  // standing for its rider: the saddled stand's first frame; its z axis (ahead) turned to +X
  #assert d.first == 1000 + dr_first(DR_IDLE_SADDLED) * 10 && d.count == 9 && out[24] == 3 && out[25] == 1 && out[26] == 4 && out[39] == 19 && out[31] == 5;
  #assert abs(out[44] - 1) < 0.0001 && abs(out[46]) < 0.0001 && abs(out[41] - 1) < 0.0001;
  // a left turn in the air: it turns level under its upright rider (no lean, no bank clip); climbing,
  // its nose comes up and the seat swings back with it
  m[0].mounts[0].face = 0; m[0].mounts[0].wing.phase = WING_AIR; m[0].mounts[0].wing.bank = 0.5; m[0].mounts[0].clip = WING_CLIP_BANK_LEFT;
  d = eg_dragon_record(m[0], 0, 0, out[..], 0); #assert abs(out[16]) < 0.0001 && abs(out[17] - 1) < 0.0001 && d.first == 1000 + dr_first(DR_FLY) * 10;
  s := eg_saddle(m[0], 0, 0, 0); #assert abs(s[0] - 3) < 0.05 && abs(s[1] - (1 + DR_SEAT[dr_first(DR_FLY) * 3 + 1] + f32(EG_DRAGON_SEAT_UP))) < 0.01;
  m[0].mounts[0].wing.vy = 20;
  c := eg_saddle(m[0], 0, 0, 0); #assert eg_dragon_pitch(m[0].mounts[0]) == f32(EG_DRAGON_CLIMB_PITCH) && c[2] < s[2] - 0.5;
}
#test "the breath is a deed the rider asks for: only on the dragon, and only a yes shows its fire" {
  m: [1] EgMounts; none: [6] f32;
  _ := eg_mount_add(m[..], 0, 0, 0); _ = eg_dragon_add(m[..], 20, 0, 0, 0);
  #assert deed_feel_ok(eg_mount_feel(EG_DEED_BREATH)) && eg_mount_feel(EG_DEED_BREATH).fx == FXR_DRAGON_BREATH;
  #assert eg_mount_press(m[..], 0, 1.5, 0, 0, DeedBearing.{}, none[..], 0) == EG_PRESS_MOUNTED;
  go := eg_mounts_fly(m[..], MountIn.{}, 0.05, 1, 0, none[..], 0); #assert eg_breath_ask(m[..], 1, DeedBearing.{}) == 0;   // a horse has none
  #assert eg_mount_press(m[..], 0, 0, 0, 2, DeedBearing.{}, none[..], 0) == EG_PRESS_DISMOUNTED;
  for i: 0..<30 { go = eg_mounts_fly(m[..], MountIn.{}, 0.05, 2 + f32(i) * 0.05, 0, none[..], 0); }
  #assert eg_mount_press(m[..], 0, 23.5, 0, 4, DeedBearing.{}, none[..], 0) == EG_PRESS_MOUNTED && eg_on_dragon(m[0]);
  for i: 0..<30 { go = eg_mounts_fly(m[..], MountIn.{}, 0.05, 4 + f32(i) * 0.05, 0, none[..], 0); }
  shows := m[0].shows;
  down := deed_bear(DeedBearing.{}, DeedPose.down, DEED_LOCK_ALL);
  #assert eg_breath_ask(m[..], 6, down) == 0 && m[0].shows == shows;
  seq := eg_breath_ask(m[..], 7, DeedBearing.{}); #assert seq != 0;
  eg_breath_answer(m[..], seq, false, 7); #assert m[0].shows == shows;
  seq = eg_breath_ask(m[..], 9, DeedBearing.{}); #assert seq != 0;
  eg_breath_answer(m[..], seq, true, 9); #assert m[0].shows == shows + 1 && m[0].show.fx == FXR_DRAGON_BREATH && m[0].show.sound == "fireball";
  j := eg_dragon_mouth(m[0], 1); #assert abs(j[2] - 6.3) < 0.01 && abs(j[0] - 20) < 0.01 && j[1] > 3;
}
#test "the mount's keys are a short hint: by a horse, on it, on the dragon on the ground and in the air" #steps 400000000 {
  m: [1] EgMounts; none: [6] f32; g: f32 = 0;
  _ := eg_mount_add(m[..], 0, 0, 0); _ = eg_dragon_add(m[..], 30, 0, 0, g);
  #assert eg_mount_hint(m[0], 9, 9, 0) == "" && eg_mount_hint(m[0], 1.5, 0, 0) == "E MOUNT";
  _ = eg_mount_press(m[..], 0, 1.5, 0, 0, DeedBearing.{}, none[..], 0); go := eg_mounts_fly(m[..], MountIn.{}, 0.05, 1, g, none[..], 0);
  #assert eg_mount_hint(m[0], 0, 0, 1) == "SPACE JUMP  SHIFT GALLOP  E DISMOUNT";
  _ = eg_mount_press(m[..], 0, 0, 0, 2, DeedBearing.{}, none[..], 0);
  for i: 0..<30 { go = eg_mounts_fly(m[..], MountIn.{}, 0.05, 2 + f32(i) * 0.05, g, none[..], 0); }
  #assert eg_mount_press(m[..], 0, 33.5, 0, 4, DeedBearing.{}, none[..], 0) == EG_PRESS_MOUNTED;
  now: f32 = 4; dt: f32 = 1.0 / 60;
  for i: 0..<60 { now += dt; go = eg_mounts_fly(m[..], MountIn.{}, dt, now, g, none[..], 0); }
  #assert eg_mount_hint(m[0], 0, 0, now) == "SPACE TAKE OFF  F FIRE BREATH  E DISMOUNT";
  for i: 0..<90 { now += dt; go = eg_mounts_fly(m[..], MountIn.{forward = 1, jump = true, climb = true}, dt, now, g, none[..], 0); }
  #assert eg_aloft(m[0]) && eg_mount_hint(m[0], 0, 0, now) == "SPACE CLIMB  SHIFT DIVE  A D BANK  F FIRE BREATH  X LAND";
  #assert eg_mount_press(m[..], 0, 0, 0, now, DeedBearing.{}, none[..], 0) == EG_PRESS_LAND_FIRST && eg_mount_hint(m[0], 0, 0, now + 0.5) == "LAND FIRST";
}
