// The Archery Range, lit: Aethyr shaders, written in Coax and emitted for each GPU (`coax metal`,
// `coax wgsl`, `coax spirv`), that draw what place.coax builds. The host binds them exactly as it
// binds the Workshop's (everglade/workshop/gpu/temple.coax): the same resources at the same places.
//
//   range_sky_vs / range_sky_fs      dusk behind everything: deep blue overhead, an ember band low
//                                    where the sun went down, first stars, thin cloud, far hills
//   range_scene_vs / range_scene_fs  the parts: a vertex pulled from the mesh, stood by its record,
//                                    lit by the last of the sky and by the lanterns at each butt
//                                    and along the shooting line
//   range_light_vs / range_light_fs  what is only light, added on top: the glow round each flame
//
// The picture is kept dim on purpose. The app draws its HUD as white and cyan strokes added over
// the picture, and they must read everywhere: the grass never goes above about a quarter of full
// brightness (range_dim), and only the target faces, chalk and flames are bright.
//
// The range has no mirror, but the host may still draw a mirror pass and always binds the mirror
// image and its sampler, so the scene's fragment stage takes both and reads the image for nothing.
//
// The uniform block is floats: the picture's size 0, the clock 2, the mirror flag 3, the eye 4, its
// right 8, up 12 and forward 16 with the focal length in pixels at 19, and where you stand 20.
//   coax/bin/coax test --library everglade/range/gpu/range.coax
#load "../../../verse/gpu/shader.coax";
#load "../../../verse/gpu/wgsl.coax";
#load "../../../aethyr/render/noise.coax";
#load "../place.coax";

RangeObj :: struct {a:V4; b:V4; c:V4; d:V4;}
// info: material, the record's value, its phase. tint: the record's own colour.
RangeS :: struct {pos:V4; world:V3; normal:V3; uv:V2; info:V4 #flat; tint:V4 #flat;}

RANGE_TAU :: 6.2831853f32;
RANGE_GRASS_CAP :: 0.052f32;   // the most light the grass sends on, before the film: a quarter on the screen
// A shader cannot read layout.coax's tables (a table outside a function is not lowered), so the
// three it needs are written again here, and the check at the end holds them to the layout.
// A lane's butt: its x, its face's z, and the face's radius.
range_lane :: (i:int)->V3 {
  x:[5]f32=[5]f32.[-16.0f32,-8.0f32,0.0f32,8.0f32,16.0f32];
  z:[5]f32=[5]f32.[-10.0f32,-20.0f32,-30.0f32,-50.0f32,-70.0f32];
  r:[5]f32=[5]f32.[0.61f32,0.61f32,0.61f32,0.80f32,1.00f32];
  return v3(x[i],z[i],r[i]);
}
// A sky face's middle.
range_sky_face :: (i:int)->V3 {
  x:[2]f32=[2]f32.[-24.0f32,24.0f32];
  y:[2]f32=[2]f32.[14.0f32,20.0f32];
  z:[2]f32=[2]f32.[-36.0f32,-58.0f32];
  return v3(x[i],y[i],z[i]);
}
// Where the sun went down: RG_SUN's way along the ground.
range_west :: ()->V3 {return normalize3(v3(0.42f32,0.0f32,0.39f32));}
range_ember :: ()->V3 {return v3(0.85f32,0.30f32,0.08f32);}
range_lantern :: ()->V3 {return v3(1.0f32,0.76f32,0.48f32);}
range_haze :: ()->V3 {return v3(0.030f32,0.032f32,0.055f32);}

// Smooth noise on Aethyr's lattice hash (aethyr/render/noise.coax): the hash gives one value a
// whole-number cell, and these blend the cells' corners.
range_cell :: (x:f32)->u32 {return cast,trunc(u32)(cast(s32)floor(fmin(fmax(x,0.0f32-33554432.0f32),33554430.0f32)));}
range_hash2 :: (x:f32,y:f32)->f32 {return render_noise_unit(render_noise_mix2(range_cell(x),range_cell(y)));}
range_hash3 :: (x:f32,y:f32,z:f32)->f32 {return render_noise_unit(render_noise_mix3(range_cell(x),range_cell(y),range_cell(z)));}
range_noise2 :: (x:f32,y:f32)->f32 {
  ix:f32=floor(x); iy:f32=floor(y); fx:f32=x-ix; fy:f32=y-iy;
  sx:f32=fx*fx*(3.0f32-2.0f32*fx); sy:f32=fy*fy*(3.0f32-2.0f32*fy);
  return mix(mix(range_hash2(ix,iy),range_hash2(ix+1.0f32,iy),sx),mix(range_hash2(ix,iy+1.0f32),range_hash2(ix+1.0f32,iy+1.0f32),sx),sy);
}
range_noise3 :: (x:f32,y:f32,z:f32)->f32 {
  ix:f32=floor(x); iy:f32=floor(y); iz:f32=floor(z); fx:f32=x-ix; fy:f32=y-iy; fz:f32=z-iz;
  sx:f32=fx*fx*(3.0f32-2.0f32*fx); sy:f32=fy*fy*(3.0f32-2.0f32*fy); sz:f32=fz*fz*(3.0f32-2.0f32*fz);
  a:f32=mix(mix(range_hash3(ix,iy,iz),range_hash3(ix+1.0f32,iy,iz),sx),mix(range_hash3(ix,iy+1.0f32,iz),range_hash3(ix+1.0f32,iy+1.0f32,iz),sx),sy);
  b:f32=mix(mix(range_hash3(ix,iy,iz+1.0f32),range_hash3(ix+1.0f32,iy,iz+1.0f32),sx),mix(range_hash3(ix,iy+1.0f32,iz+1.0f32),range_hash3(ix+1.0f32,iy+1.0f32,iz+1.0f32),sx),sy);
  return mix(a,b,sz);
}
range_fbm2 :: (x:f32,y:f32)->f32 {
  v:f32=0.0f32; a:f32=0.5f32; px:f32=x; py:f32=y;
  {
    k:s32=0;
    while k<4 {
      v+=a*range_noise2(px,py);
      px=px*2.03f32+1.7f32; py=py*2.03f32+9.2f32; a*=0.5f32;
      k+=1;
    }
  }
  return v;
}
// A world point on the screen: the eye's own right, up and forward, then a perspective divide.
// The range is long and a dragon flies over it, so the far plane is further than the temple's.
range_project :: (w:V3,u:[]f32)->V4 {
  e:V3=sub3(w,wg_at3(u,4));
  x:f32=dot3(e,wg_at3(u,8)); y:f32=dot3(e,wg_at3(u,12)); z:f32=dot3(e,wg_at3(u,16));
  near:f32=0.1f32; far:f32=600.0f32;
  return v4(x*u[19]*2.0f32/u[0],y*u[19]*2.0f32/u[1],far*(z-near)/(far-near),z);
}
// The ray through a pixel.
range_ray :: (pos:V4,u:[]f32)->V3 {
  return normalize3(add3(scale3(wg_at3(u,16),u[19]),add3(scale3(wg_at3(u,8),pos.x-u[0]*0.5f32),scale3(wg_at3(u,12),u[1]*0.5f32-pos.y))));
}
// To the screen: a filmic curve, then the display's gamma.
range_film :: (c:V3)->V3 {
  x:V3=scale3(c,0.95f32);
  r:f32=saturate(x.x*(2.51f32*x.x+0.03f32)/(x.x*(2.43f32*x.x+0.59f32)+0.14f32));
  g:f32=saturate(x.y*(2.51f32*x.y+0.03f32)/(x.y*(2.43f32*x.y+0.59f32)+0.14f32));
  b:f32=saturate(x.z*(2.51f32*x.z+0.03f32)/(x.z*(2.43f32*x.z+0.59f32)+0.14f32));
  return v3(pow(r,1.0f32/2.2f32),pow(g,1.0f32/2.2f32),pow(b,1.0f32/2.2f32));
}
// A colour held under `cap`: dim light passes nearly as it is, strong light closes on the cap and
// never reaches it. This is what keeps the grass dark enough for the HUD's strokes.
range_dim :: (c:V3,cap:f32)->V3 {
  m:f32=fmax(fmax(c.x,c.y),fmax(c.z,0.0f32));
  return scale3(c,cap/(cap+m));
}

// Where lantern `i`'s flame is: place.coax's rp_lamp, written for the shader (the check at the
// end holds the two together).
range_lamp :: (i:s32)->V3 {
  if (i<RG_LANES) {
    b:V3=range_lane(cast(int)i);
    return v3(b.x+b.z+RG_BUTT_MARGIN+RP_LAMP_SIDE,RP_LAMP_HIGH,b.y+RP_LAMP_FRONT);
  }
  if (i<RG_TARGETS) {
    f:V3=range_sky_face(cast(int)(i-RG_LANES));
    return v3(f.x+RG_SKY_RADIUS+RG_BUTT_MARGIN+RP_LAMP_SIDE,f.y+sin(RG_SKY_TILT)*RP_LAMP_OUT,f.z+cos(RG_SKY_TILT)*RP_LAMP_OUT);
  }
  return v3(RP_LINE_LAMP_X+RP_LINE_LAMP_STEP*(cast(f32)(i-RG_TARGETS)),RP_LINE_LAMP_HIGH,RG_LINE_Z);
}
// How a flame flickers: never far from full.
range_flicker :: (time:f32,phase:f32)->f32 {return 0.9f32+0.1f32*sin(time*7.0f32+phase)*sin(time*4.3f32+phase*1.7f32);}
// The lanterns' light on a point facing `n`: every flame's share, falling off with distance.
range_lamps :: (p:V3,n:V3,time:f32)->f32 {
  sum:f32=0.0f32;
  {
    k:s32=0;
    while k<RP_LAMPS {
      to:V3=sub3(range_lamp(k),p); d:f32=fmax(length3(to),0.05f32);
      facing:f32=saturate(dot3(n,scale3(to,1.0f32/d))*0.7f32+0.3f32);
      sum+=facing*range_flicker(time,(cast(f32)(k))*2.1f32)*4.0f32/(1.0f32+0.5f32*d*d);
      k+=1;
    }
  }
  return sum;
}

// Dusk: deep blue overhead falling to an ember band where the sun went down, first stars, a few
// slow thin clouds, and a dark line of hills and trees on the horizon with fields below it.
range_sky :: (rd:V3,time:f32)->V3 {
  west:V3=range_west();
  flat:f32=fmax(sqrt(rd.x*rd.x+rd.z*rd.z),0.0001f32);
  fx:f32=rd.x/flat; fz:f32=rd.z/flat;
  toward:f32=saturate((fx*west.x+fz*west.z)*0.5f32+0.5f32);
  up:f32=saturate(rd.y);
  c:V3=mix3(v3(0.045f32,0.06f32,0.13f32),v3(0.006f32,0.012f32,0.045f32),pow(up,0.45f32));
  // The band: widest and brightest where the sun went, a dull violet round the rest of the horizon.
  low:f32=exp(0.0f32-up*(5.0f32+6.0f32*(1.0f32-toward)));
  c=add3(c,scale3(range_ember(),0.34f32*low*toward*toward*toward));
  c=add3(c,scale3(v3(0.10f32,0.06f32,0.11f32),0.35f32*exp(0.0f32-up*9.0f32)));
  // The last of the sun, just under the hills.
  glow:f32=saturate(rd.x*west.x+rd.z*west.z-abs(rd.y-0.02f32)*2.0f32);
  c=add3(c,scale3(v3(1.0f32,0.55f32,0.2f32),0.18f32*pow(glow,24.0f32)));
  // First stars, away from the band.
  g:V3=scale3(rd,170.0f32);
  star:f32=range_hash3(g.x,g.y,g.z);
  twinkle:f32=0.6f32+0.4f32*sin(time*(1.0f32+star*3.0f32)+star*40.0f32);
  sx:f32=fract(g.x)-0.5f32; sy:f32=fract(g.y)-0.5f32; sz:f32=fract(g.z)-0.5f32;
  speck:f32=smoothstep(0.7f32,0.2f32,sqrt(sx*sx+sy*sy+sz*sz));
  c=add3(c,scale3(v3(0.85f32,0.9f32,1.0f32),stepf(0.9978f32,star)*twinkle*speck*smoothstep(0.08f32,0.4f32,rd.y)*(1.0f32-0.7f32*low*toward)));
  // Cloud: thin bars, dark against the sky, their undersides catching the ember.
  if (rd.y>0.01f32) {
    cx:f32=rd.x/(rd.y+0.12f32); cz:f32=rd.z/(rd.y+0.12f32);
    n:f32=range_fbm2(cx*0.55f32+time*0.006f32,cz*1.5f32+3.0f32);
    cloud:f32=smoothstep(0.52f32,0.74f32,n)*smoothstep(0.01f32,0.1f32,rd.y)*(1.0f32-smoothstep(0.35f32,0.8f32,rd.y));
    lit:V3=add3(v3(0.02f32,0.022f32,0.04f32),scale3(range_ember(),0.22f32*toward*toward*exp(0.0f32-up*4.0f32)));
    c=mix3(c,lit,cloud*0.75f32);
  }
  // The horizon: hills, a tree-line on them, and dark fields below.
  hill:f32=0.028f32+0.032f32*range_noise3(fx*3.0f32+7.0f32,0.0f32,fz*3.0f32+7.0f32)+0.012f32*range_noise3(fx*26.0f32,3.0f32,fz*26.0f32)+0.004f32*range_noise3(fx*90.0f32,5.0f32,fz*90.0f32);
  land:f32=1.0f32-smoothstep(hill-0.003f32,hill+0.003f32,rd.y);
  field:V3=mix3(v3(0.012f32,0.02f32,0.014f32),v3(0.014f32,0.017f32,0.026f32),smoothstep(0.0f32-0.25f32,0.0f32,rd.y));
  return mix3(c,field,land);
}

range_sky_vs :: (i:u32,_iid:u32)->V4 {
  p:[3]V2=[3]V2.[v2(-1.0f32,-3.0f32),v2(-1.0f32,1.0f32),v2(3.0f32,1.0f32)];
  return v4(p[cast(int)i].x,p[cast(int)i].y,1.0f32,1.0f32);
}
range_sky_fs :: (pos:V4,u:[]f32)->V4 {
  rd:V3=range_ray(pos,u);
  // A mirror image looks up where the picture looks down.
  if (u[3]>0.5f32) { rd=v3(rd.x,0.0f32-rd.y,rd.z); }
  c:V3=range_sky(rd,u[2]);
  if (u[3]>0.5f32) { return v4(c.x,c.y,c.z,1.0f32); }
  f:V3=range_film(c);
  return v4(f.x,f.y,f.z,1.0f32);
}

range_scene_vs :: (id:u32,instance:u32,u:[]f32,mesh:[]f32,objects:[]RangeObj)->RangeS {
  m:RangeObj=objects[cast(int)instance];
  o:int=cast(int)id*12;
  local:V3=scale3(v3(mesh[o],mesh[o+1],mesh[o+2]),m.b.x);
  n:V3=v3(mesh[o+3],mesh[o+4],mesh[o+5]);
  mat:f32=mesh[o+6];
  yaw:f32=m.a.w; lift:f32=0.0f32;
  // A floating part bobs and turns.
  if (m.b.y>0.5f32) { yaw=yaw+u[2]*0.6f32; lift=0.07f32*sin(u[2]*1.1f32+m.b.z); }
  c:f32=cos(yaw); sn:f32=sin(yaw);
  w:V3=v3(local.x*c+local.z*sn+m.a.x,local.y+m.a.y+lift,(0.0f32-local.x)*sn+local.z*c+m.a.z);
  // The pennant's cloth stirs: more the further from its pole, and its tip hangs a little.
  if (mat>4.5f32&&mat<5.5f32) {
    along:f32=mesh[o+7];
    w=v3(w.x,w.y-0.18f32*along*along,w.z+0.13f32*along*sin(u[2]*1.6f32-along*4.0f32));
  }
  s:RangeS;
  s.world=w;
  s.normal=v3(n.x*c+n.z*sn,n.y,(0.0f32-n.x)*sn+n.z*c);
  s.uv=v2(mesh[o+7],mesh[o+8]);
  s.info=v4(mat,m.c.w,m.b.z,0.0f32);
  s.tint=v4(m.c.x,m.c.y,m.c.z,1.0f32);
  seen:V3=w;
  if (u[3]>0.5f32) { seen=v3(w.x,0.0f32-w.y,w.z); }
  s.pos=range_project(seen,u);
  return s;
}

// A target face at `uv` (length 0 at its middle, 1 at its rim): ten rings, outermost to
// innermost white, white, black, black, blue, blue, red, red, gold, gold, a thin dark line
// between them (pale between the two blacks, where a dark one would not show).
range_face :: (uv:V2)->V3 {
  d:f32=sqrt(uv.x*uv.x+uv.y*uv.y);
  ring:f32=fmin(floor(d/RG_RING),9.0f32);       // 0 the gold's middle, 9 the outermost white
  c:V3=v3(0.90f32,0.90f32,0.86f32);
  if (ring<1.5f32) { c=v3(0.95f32,0.74f32,0.10f32); }
  else if (ring<3.5f32) { c=v3(0.85f32,0.10f32,0.08f32); }
  else if (ring<5.5f32) { c=v3(0.08f32,0.30f32,0.85f32); }
  else if (ring<7.5f32) { c=v3(0.03f32,0.03f32,0.035f32); }
  e:f32=fract(d/RG_RING);
  edge:f32=fmin(e,1.0f32-e)*RG_RING;
  line:f32=(1.0f32-smoothstep(0.003f32,0.006f32,edge))*stepf(RG_RING*0.5f32,d)*stepf(d,1.0f32-RG_RING*0.5f32);
  ink:V3=v3(0.02f32,0.02f32,0.02f32);
  if (d>0.65f32&&d<0.75f32) { ink=v3(0.55f32,0.55f32,0.55f32); }
  return mix3(c,ink,line);
}

// A surface's own colour and light by what it is made of, and the most it may send on.
RangeSurface :: struct {albedo:V3; glow:V3; cap:f32; lamp:f32;}   // lamp: how much of the lanterns it takes
range_surface :: (s:RangeS,u:[]f32)->RangeSurface {
  o:RangeSurface;
  p:V3=s.world; time:f32=u[2]; mat:f32=s.info.x;
  o.albedo=v3(0.5f32,0.5f32,0.5f32); o.glow=v3(0.0f32,0.0f32,0.0f32); o.cap=0.0f32; o.lamp=1.0f32;
  if (mat<1.5f32) {
    // The ground: two greens, the mown lanes down to each butt, the chalk line, the dirt track.
    patch:f32=range_fbm2(p.x*0.35f32,p.z*0.35f32);
    blade:f32=range_noise2(p.x*9.0f32,p.z*9.0f32);
    grass:V3=scale3(mix3(v3(0.05f32,0.13f32,0.04f32),v3(0.10f32,0.20f32,0.06f32),patch),0.75f32+0.4f32*blade);
    // A lane is the strip either side of a butt's own x, from the line down past the last butt.
    fold:f32=p.x-8.0f32*floor(p.x/8.0f32+0.5f32);
    lane:f32=(1.0f32-smoothstep(2.0f32,2.3f32,abs(fold)))*stepf(abs(p.x),RG_LINE_HALF-2.0f32)*smoothstep(range_lane(RG_LANES-1).y-4.0f32,range_lane(RG_LANES-1).y-2.0f32,p.z)*stepf(p.z,RG_LINE_Z);
    stripe:f32=0.86f32+0.14f32*stepf(0.5f32,fract(p.x*0.5f32));
    mown:V3=scale3(mix3(v3(0.09f32,0.21f32,0.06f32),v3(0.13f32,0.25f32,0.08f32),patch),(0.9f32+0.15f32*blade)*stripe);
    o.albedo=mix3(grass,mown,lane);
    // The riding track: trodden earth with soft edges.
    track:f32=(1.0f32-smoothstep(RG_TRACK_WIDE*0.5f32-0.4f32,RG_TRACK_WIDE*0.5f32+0.2f32+0.5f32*patch,abs(p.z-RG_TRACK_Z)))*(1.0f32-smoothstep(RG_TRACK_HALF-1.0f32,RG_TRACK_HALF,abs(p.x)));
    earth:V3=scale3(v3(0.20f32,0.14f32,0.09f32),0.7f32+0.5f32*range_noise2(p.x*3.0f32,p.z*14.0f32));
    o.albedo=mix3(o.albedo,earth,track);
    // The shooting line, in chalk a little worn.
    chalk:f32=(1.0f32-smoothstep(0.05f32,0.08f32,abs(p.z-RG_LINE_Z)))*stepf(abs(p.x),RG_LINE_HALF)*(0.7f32+0.3f32*blade);
    o.albedo=mix3(o.albedo,v3(0.8f32,0.8f32,0.76f32),chalk);
    // A soft dark under each butt, and under you.
    {
      k:s32=0;
      while k<RG_LANES {
        b:V3=range_lane(cast(int)k);
        r:f32=b.z+RG_BUTT_MARGIN;
        bx:f32=p.x-b.x; bz:f32=p.z-(b.y-RG_BUTT_DEEP*0.5f32);
        o.albedo=scale3(o.albedo,1.0f32-0.6f32*exp(0.0f32-(bx*bx+bz*bz*2.0f32)/(r*r)));
        k+=1;
      }
    }
    fx:f32=p.x-u[20]; fz:f32=p.z-u[22]; lift:f32=fmax(u[21],0.0f32);
    o.albedo=scale3(o.albedo,1.0f32-0.5f32*exp(0.0f32-(fx*fx+fz*fz)/(0.09f32+0.3f32*lift))/(1.0f32+2.0f32*lift));
    o.cap=mix(RANGE_GRASS_CAP,0.3f32,chalk);
    if (s.normal.y<0.5f32) { o.albedo=v3(0.08f32,0.06f32,0.04f32); o.cap=RANGE_GRASS_CAP; }
  } else if (mat<2.5f32) {
    // Straw: warm yellow, bound in strands.
    strand:f32=range_noise3(p.x*55.0f32,p.y*7.0f32,p.z*55.0f32)*0.6f32+range_noise3(p.x*9.0f32,p.y*40.0f32,p.z*9.0f32)*0.4f32;
    o.albedo=scale3(v3(0.62f32,0.46f32,0.20f32),0.55f32+0.7f32*strand);
    o.lamp=0.6f32;
  } else if (mat<3.5f32) {
    // A face: its rings, and a little light of its own so it reads from the line at dusk.
    o.albedo=range_face(s.uv);
    o.glow=scale3(o.albedo,0.10f32);
  } else if (mat<4.5f32) {
    grain:f32=range_noise3(p.x*30.0f32,p.y*4.0f32,p.z*30.0f32);
    o.albedo=scale3(v3(0.30f32,0.20f32,0.12f32),0.6f32+0.6f32*grain);
    o.cap=0.12f32;
  } else if (mat<5.5f32) {
    // The pennant: red cloth, darker in its folds.
    fold:f32=0.75f32+0.25f32*sin(s.uv.x*9.0f32-time*1.6f32);
    o.albedo=scale3(v3(0.70f32,0.12f32,0.10f32),fold);
    o.glow=scale3(o.albedo,0.04f32);
  } else if (mat<6.5f32) {
    // A distance post's top: the lane's own paint.
    o.albedo=v3(s.tint.x,s.tint.y,s.tint.z);
    o.glow=scale3(o.albedo,0.05f32);
  } else {
    // A flame: brighter at its heart, flickering.
    o.albedo=v3(0.3f32,0.1f32,0.02f32);
    o.glow=scale3(mix3(v3(1.0f32,0.45f32,0.10f32),v3(1.0f32,0.8f32,0.45f32),saturate(1.0f32-s.uv.y)),1.6f32*range_flicker(time,s.info.z));
    o.lamp=0.0f32;
  }
  return o;
}

range_scene_fs :: (s:RangeS,front:bool,u:[]f32,mirror:Tex2D,smooth:Sampler)->V4 {
  p:V3=s.world; time:f32=u[2];
  n:V3=normalize3(s.normal);
  if (!front) { n=scale3(n,0.0f32-1.0f32); }
  eye:V3=wg_at3(u,4);
  m:RangeSurface=range_surface(s,u);
  // The sky's own light: blue from above, and the last ember from where the sun went.
  light:V3=scale3(v3(0.045f32,0.06f32,0.11f32),0.55f32+0.45f32*n.y);
  west:V3=normalize3(add3(range_west(),v3(0.0f32,0.2f32,0.0f32)));
  light=add3(light,scale3(range_ember(),0.16f32*saturate(dot3(n,west))));
  // The lanterns.
  light=add3(light,scale3(range_lantern(),range_lamps(p,n,time)*m.lamp));
  c:V3=mul3(m.albedo,light);
  if (m.cap>0.0f32) { c=range_dim(c,m.cap); }
  c=add3(c,m.glow);
  if (u[3]>0.5f32) {
    // A mirror image stays linear, for whatever reads it.
    return v4(c.x,c.y,c.z,1.0f32);
  }
  // The range mirrors nothing: the image is read, as the host binds it, and adds nothing.
  seen:V4=gpu_sample(mirror,smooth,v2(s.pos.x/u[0],s.pos.y/u[1]));
  c=add3(c,scale3(v3(seen.x,seen.y,seen.z),0.0f32));
  // Dusk haze, toward the horizon's colour.
  far:f32=length3(sub3(p,eye));
  c=mix3(c,range_haze(),1.0f32-exp(0.0f32-far*0.004f32));
  f:V3=range_film(c);
  return v4(f.x,f.y,f.z,1.0f32);
}

// The glow round a flame at `uv` (-1 to 1 across its panel): strongest at the middle, gone at the edge.
range_glow :: (uv:V2)->f32 {
  r:f32=saturate(sqrt(uv.x*uv.x+uv.y*uv.y));
  return (1.0f32-r)*(1.0f32-r)*(0.25f32+0.75f32*exp(0.0f32-r*r*14.0f32));
}
range_light_vs :: (id:u32,instance:u32,u:[]f32,mesh:[]f32,objects:[]RangeObj)->RangeS {return range_scene_vs(id,instance,u,mesh,objects);}
range_light_fs :: (s:RangeS,front:bool,u:[]f32)->V4 {
  c:V3=scale3(range_lantern(),range_glow(s.uv)*range_flicker(u[2],s.info.z)*(ifx front then 0.42f32 else 0.36f32));
  return v4(c.x,c.y,c.z,1.0f32);
}

#test "the range's shading keeps its bounds: the film stays in range, the grass stays dim, a face's rings are its colours, the sky is dusk" {
  f:=range_film(v3(100.0f32,0.0f32,0.5f32)); #assert f.x<=1.0f32 && f.y>=0.0f32 && f.z>0.0f32 && f.z<1.0f32;
  // However strong the light, the grass comes out under a quarter on the screen; dim light passes nearly whole.
  bright:=range_film(range_dim(v3(40.0f32,90.0f32,20.0f32),RANGE_GRASS_CAP)); #assert bright.x<0.26f32 && bright.y<0.26f32 && bright.z<0.26f32 && bright.y>0.2f32;
  faint:=range_dim(v3(0.002f32,0.004f32,0.001f32),RANGE_GRASS_CAP); #assert faint.y>0.0037f32 && faint.y<0.004f32;
  // The rings, from the middle out: gold, red, blue, black, white.
  gold:=range_face(v2(0.05f32,0.0f32)); #assert gold.x>0.9f32 && gold.y>0.6f32 && gold.z<0.2f32;
  gold2:=range_face(v2(0.0f32,0.15f32)); #assert gold2.x==gold.x && gold2.y==gold.y;
  red:=range_face(v2(0.25f32,0.0f32)); #assert red.x>0.8f32 && red.y<0.2f32 && red.z<0.2f32;
  red2:=range_face(v2(0.0f32,0.0f32-0.35f32)); #assert red2.x==red.x;
  blue:=range_face(v2(0.0f32-0.45f32,0.0f32)); #assert blue.z>0.8f32 && blue.x<0.2f32;
  blue2:=range_face(v2(0.55f32,0.0f32)); #assert blue2.z==blue.z;
  black:=range_face(v2(0.65f32,0.0f32)); #assert black.x<0.05f32 && black.y<0.05f32 && black.z<0.05f32;
  black2:=range_face(v2(0.0f32,0.76f32)); #assert black2.x==black.x;
  white:=range_face(v2(0.85f32,0.0f32)); #assert white.x>0.85f32 && white.y>0.85f32 && white.z>0.8f32;
  white2:=range_face(v2(0.0f32,0.96f32)); #assert white2.x==white.x;
  // Between two rings there is a line: dark between the golds and the reds, pale between the blacks.
  line:=range_face(v2(0.2f32,0.0f32)); #assert line.x<0.1f32;
  pale:=range_face(v2(0.7f32,0.0f32)); #assert pale.x>0.4f32;
  // Dusk: dark overhead, the brightest of it low where the sun went, and never glaring.
  west:=range_west();
  over:=range_sky(v3(0.0f32,1.0f32,0.0f32),0.0f32); #assert over.x<0.05f32 && over.y<0.05f32 && over.z<0.1f32 && over.z>over.x;
  band:=range_sky(normalize3(v3(west.x,0.12f32,west.z)),0.0f32); away:=range_sky(normalize3(v3(0.0f32-west.x,0.12f32,0.0f32-west.z)),0.0f32);
  #assert band.x>away.x*2.0f32 && band.x>band.z && band.x<0.6f32 && band.x==band.x;
  under:=range_sky(v3(0.0f32,0.0f32-0.6f32,0.8f32),0.0f32); #assert under.y<0.05f32;
  #assert range_glow(v2(0.0f32,0.0f32))==1.0f32 && range_glow(v2(1.0f32,0.0f32))==0.0f32 && range_glow(v2(1.0f32,1.0f32))==0.0f32;
}
#test "the shader's lanterns stand where the place puts them, and light each face from in front" {
  // The shader's own copies of the layout's tables, and of the materials' numbers it tests against.
  for i: 0..<RG_LANES { b:=range_lane(i); #assert b.x==RG_LANE_X[i] && b.y==RG_LANE_Z[i] && b.z==RG_LANE_RADIUS[i]; }
  for i: 0..<RG_SKY { f:=range_sky_face(i); #assert f.x==RG_SKY_X[i] && f.y==RG_SKY_Y[i] && f.z==RG_SKY_Z[i]; }
  west:=range_west(); flat:=sqrt(RG_SUN[0]*RG_SUN[0]+RG_SUN[2]*RG_SUN[2]);
  #assert abs(west.x-RG_SUN[0]/flat)<0.0001f32 && abs(west.z-RG_SUN[2]/flat)<0.0001f32 && west.y==0.0f32;
  #assert RG_MAT_GRASS==1 && RG_MAT_STRAW==2 && RG_MAT_FACE==3 && RG_MAT_WOOD==4 && RG_MAT_CLOTH==5 && RG_MAT_POST_TOP==6 && RG_MAT_FLAME==7 && RG_MAT_GLOW==8;
  #assert RG_RINGS==10 && ARCH_VERTEX_FLOATS==12 && ARCH_RECORD_FLOATS==16 && size_of(RangeObj)==64;
  for i: 0..<RP_LAMPS {
    a:=rp_lamp(i); b:=range_lamp(cast(s32)i);
    #assert abs(a.x-b.x)<0.001f32 && abs(a.y-b.y)<0.001f32 && abs(a.z-b.z)<0.001f32;
  }
  for i: 0..<RG_TARGETS {
    f:=rg_face(i);
    lit:=range_lamps(v3(f.x,f.y,f.z),v3(f.nx,f.ny,f.nz),0.0f32);
    // A face's middle gets enough for its white to be bright, and not so much that its colours wash out.
    #assert lit>0.6f32 && lit<1.6f32;
  }
  // Away in a corner of the ground the lanterns give next to nothing: the range stays dark between them.
  #assert range_lamps(v3(0.0f32-RG_HALF_WIDE,0.0f32,RG_BACK),v3(0.0f32,1.0f32,0.0f32),0.0f32)<0.05f32;
}
