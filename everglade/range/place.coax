// The Archery Range, built: the ground, seven targets on their stands and poles, the distance
// posts, a rail fence round the boundary, a rack by the line and a pennant, put together from
// Aethyr's architecture kit (aethyr/arch/) to layout.coax's numbers. Parts go into one mesh;
// records stand them; draws name a part and its records. The host uploads the three and the
// range's shaders (gpu/range.coax) draw them, exactly as it does the Workshop's temple.
//
// It is dusk there, so the range is lit by lanterns: one on a post beside each lane's butt, one
// hung before each sky face, and a row of low ones along the shooting line (rp_lamp says where).
//
// Three groups of draws:
//   RP_STANDING  what stands on the ground (butts and faces, legs, poles, posts, fence, rack,
//                pennant, the lanterns' posts and their flames)
//   RP_GROUND    the ground: one slab; the shader draws the lanes, the line and the track on it
//   RP_LIGHT     what is only light, added on top: the glow round each lantern's flame
//
// A face is one disc. Its two surface coordinates run from (0, 0) at its middle to length 1 at
// its rim, so the shader colours the ten rings by how far a point is from the middle.
//   coax/bin/coax test --library everglade/range/place.coax
#module "everglade.range.place";
#load "../../aethyr/arch/classical.coax";
#load "../../aethyr/arch/place.coax";
#load "layout.coax";

// What a surface is made of (the shader reads it from each vertex; gpu/range.coax checks its
// own numbers against these).
RG_MAT_GRASS :: 1;      // the ground
RG_MAT_STRAW :: 2;      // a butt
RG_MAT_FACE :: 3;       // a target face: ten rings by distance from the middle
RG_MAT_WOOD :: 4;       // legs, poles, posts, the fence, the rack
RG_MAT_CLOTH :: 5;      // the pennant: it sways
RG_MAT_POST_TOP :: 6;   // a distance post's painted top: the record's tint
RG_MAT_FLAME :: 7;      // a lantern's flame
RG_MAT_GLOW :: 8;       // the glow round a flame: only light

RP_STANDING :: 0; RP_GROUND :: 1; RP_LIGHT :: 2; RP_GROUPS :: 3;
RP_VERTICES :: 9000;
RP_RECORDS :: 160;
RP_DRAWS :: 16;
RP_ROUND :: 32;           // steps round a butt and its face
RP_GROUND_MARGIN :: 20.0; // the slab reaches this far past the boundary
RP_FACE_PROUD :: 0.012;   // a face stands this far off its straw
RP_FENCE_STEP :: 4.0;     // metres between fence posts
RP_CLOTH_STEPS :: 8;      // the pennant's cloth, cut along its length so it can sway
RP_CLOTH_LONG :: 1.5;
RP_RACK_X :: -20.0; RP_RACK_Z :: 2.0;

// The lanterns. A lane's stands at the right of its butt and a little toward the line, so it
// lights the face; a sky face's hangs at its right on an arm from the pole; the line's stand between the lanes.
RP_LINE_LAMPS :: 6;
RP_LAMPS :: 13;               // the seven targets' (in rg_face's order), then the line's
RP_LAMP_SIDE :: 0.7;          // a lane's lantern, this far right of the straw's edge
RP_LAMP_FRONT :: 0.8;         // and this far toward the line
RP_LAMP_HIGH :: 2.0;          // its flame, over the ground
RP_LAMP_OUT :: 0.9;           // a sky face's lantern: as far to its right, and this far out along its normal
RP_LINE_LAMP_X :: -20.0;      // the line's lanterns: the first, then one every RP_LINE_LAMP_STEP
RP_LINE_LAMP_STEP :: 8.0;
RP_LINE_LAMP_HIGH :: 1.2;
RP_GLOW_HALF :: 0.55;         // half the width of a flame's glow

// Where lantern `i`'s flame is.
RpLamp :: struct { x: f32; y: f32; z: f32; }
rp_lamp :: (i: int) -> RpLamp {
  if i >= 0 && i < RG_LANES { return RpLamp.{x = RG_LANE_X[i] + RG_LANE_RADIUS[i] + RG_BUTT_MARGIN + RP_LAMP_SIDE, y = RP_LAMP_HIGH, z = RG_LANE_Z[i] + RP_LAMP_FRONT}; }
  if i >= RG_LANES && i < RG_TARGETS { f := rg_face(i); return RpLamp.{x = f.x + f.radius + RG_BUTT_MARGIN + RP_LAMP_SIDE, y = f.y + f.ny * RP_LAMP_OUT, z = f.z + f.nz * RP_LAMP_OUT}; }
  k := i - RG_TARGETS; if k < 0 || k >= RP_LINE_LAMPS { k = 0; }
  return RpLamp.{x = RP_LINE_LAMP_X + RP_LINE_LAMP_STEP * cast(f32) k, y = RP_LINE_LAMP_HIGH, z = RG_LINE_Z};
}

// A distance post's top, a different paint for each lane.
RP_TINT :: [15] f32.[0.90, 0.90, 0.86,  0.95, 0.78, 0.16,  0.86, 0.22, 0.16,  0.20, 0.42, 0.85,  0.12, 0.12, 0.13];

RangePlace :: struct {
  mesh: [RP_VERTICES * ARCH_VERTEX_FLOATS] f32; vertices: int;
  records: [RP_RECORDS * ARCH_RECORD_FLOATS] f32; record_n: int;
  draws: [RP_DRAWS * 4] u32; draw_n: int;
  group_first: [RP_GROUPS] int; group_count: [RP_GROUPS] int;
  faces: int;
  built: bool;
}

// A flat disc facing along its normal (a unit vector): a fan of `segments` triangles. u and v
// run from (0, 0) at the middle to length 1 at the rim; v is up the disc when it stands upright.
rp_disc :: (p: [] ArchPen, cx: f32, cy: f32, cz: f32, nx: f32, ny: f32, nz: f32, r: f32, segments: int) {
  // Two directions across the disc: a level one, and the normal crossed with it.
  ax: f32 = nz; az: f32 = -nx; al := sqrt(ax * ax + az * az);
  if al < 0.0001 { ax = 1; az = 0; al = 1; }
  ax /= al; az /= al;
  bx := ny * az; by := nz * ax - nx * az; bz := -ny * ax;
  mid := arch_at(cx, cy, cz, nx, ny, nz, 0, 0);
  for i: 0..<segments {
    a := f32(ARCH_TAU) * cast(f32) i / cast(f32) segments; b := f32(ARCH_TAU) * cast(f32) (i + 1) / cast(f32) segments;
    ca := cos(a); sa := sin(a); cb := cos(b); sb := sin(b);
    qa := arch_at(cx + (ax * ca + bx * sa) * r, cy + by * sa * r, cz + (az * ca + bz * sa) * r, nx, ny, nz, ca, sa);
    qb := arch_at(cx + (ax * cb + bx * sb) * r, cy + by * sb * r, cz + (az * cb + bz * sb) * r, nx, ny, nz, cb, sb);
    arch_tri(p, mid, qa, qb);
  }
}

// One target: a round straw butt behind the face, and the face a little proud of it.
rp_target :: (p: [] ArchPen, f: RgFace) {
  r := f.radius + f32(RG_BUTT_MARGIN); deep := f32(RG_BUTT_DEEP);
  bx := f.x - f.nx * deep; by := f.y - f.ny * deep; bz := f.z - f.nz * deep;
  p[0].material = RG_MAT_STRAW;
  arch_limb(p, bx, by, bz, f.x, f.y, f.z, r, r, RP_ROUND);
  rp_disc(p, bx, by, bz, -f.nx, -f.ny, -f.nz, r, RP_ROUND);
  rp_disc(p, f.x, f.y, f.z, f.nx, f.ny, f.nz, r, RP_ROUND);
  p[0].material = RG_MAT_FACE;
  proud := f32(RP_FACE_PROUD);
  rp_disc(p, f.x + f.nx * proud, f.y + f.ny * proud, f.z + f.nz * proud, f.nx, f.ny, f.nz, f.radius, RP_ROUND);
}

// A lane butt's stand: two legs at its sides leaning in, a bar under it, and a prop behind.
rp_stand :: (p: [] ArchPen, f: RgFace) {
  r := f.radius + f32(RG_BUTT_MARGIN); leg := f32(RG_STAND_LEG); mid := f.z - f32(RG_BUTT_DEEP) * 0.5;
  p[0].material = RG_MAT_WOOD;
  for side: 0..<2 {
    sx: f32 = ifx side == 0 then -1 else 1;
    arch_limb(p, f.x + sx * (r + 0.14), 0, mid + 0.22, f.x + sx * r * 0.55, f.y + r * 0.8, mid - 0.08, leg, leg, 8);
  }
  arch_limb(p, f.x, 0, f.z - f32(RG_BUTT_DEEP) - r - 0.3, f.x, f.y + r * 0.6, f.z - f32(RG_BUTT_DEEP) + 0.05, leg, leg, 8);
  arch_box(p, f.x, f.y - r - leg, mid, r * 0.8, leg, leg);
}

// A sky face's pole: from the ground up into the back of its butt, with an arm out to its lantern.
rp_pole :: (p: [] ArchPen, f: RgFace, lamp: RpLamp) {
  p[0].material = RG_MAT_WOOD;
  bx := f.x - f.nx * f32(RG_BUTT_DEEP) * 0.5; by := f.y - f.ny * f32(RG_BUTT_DEEP) * 0.5; bz := f.z - f.nz * f32(RG_BUTT_DEEP) * 0.5;
  arch_limb(p, bx, 0, bz, bx, by, bz, 0.2, 0.12, 12);
  arch_box(p, bx, 0.1, bz, 0.4, 0.1, 0.4);
  arch_limb(p, bx, by - 1.6, bz, lamp.x, lamp.y - 0.14, lamp.z, 0.05, 0.03, 8);
  arch_box(p, lamp.x, lamp.y - 0.14, lamp.z, 0.13, 0.02, 0.13);
}

// A lantern's post, built at the origin for a flame RP_LAMP_HIGH up: a post and a dish for the flame.
rp_lamp_post :: (p: [] ArchPen) -> ArchPart {
  from := p[0].n; tall := f32(RP_LAMP_HIGH) - 0.16;
  p[0].material = RG_MAT_WOOD;
  arch_box(p, 0, tall * 0.5, 0, 0.05, tall * 0.5, 0.05);
  arch_box(p, 0, tall + 0.02, 0, 0.13, 0.02, 0.13);
  return arch_part(p, from);
}

// A distance post, built at the origin: a square post with a painted top.
rp_post :: (p: [] ArchPen) -> ArchPart {
  from := p[0].n; cap: f32 = 0.22; tall := f32(RG_POST_HEIGHT);
  p[0].material = RG_MAT_WOOD;
  arch_box(p, 0, (tall - cap) * 0.5, 0, 0.06, (tall - cap) * 0.5, 0.06);
  p[0].material = RG_MAT_POST_TOP;
  arch_box(p, 0, tall - cap * 0.5, 0, 0.09, cap * 0.5, 0.09);
  return arch_part(p, from);
}

// The rack by the line: two uprights, two bars across, feet, and three staves leant on it.
rp_rack :: (p: [] ArchPen) {
  x := f32(RP_RACK_X); z := f32(RP_RACK_Z);
  p[0].material = RG_MAT_WOOD;
  for side: 0..<2 {
    sx: f32 = ifx side == 0 then -0.9 else 0.9;
    arch_box(p, x + sx, 0.8, z, 0.045, 0.8, 0.045);
    arch_box(p, x + sx, 0.04, z, 0.06, 0.04, 0.35);
  }
  arch_box(p, x, 1.5, z, 0.98, 0.04, 0.04);
  arch_box(p, x, 0.55, z, 0.98, 0.035, 0.035);
  for i: 0..<3 {
    bx := x - 0.5 + 0.5 * cast(f32) i;
    arch_limb(p, bx, 0.02, z + 0.3, bx + 0.04, 1.72, z + 0.05, 0.016, 0.012, 6);
  }
}

// The pennant: a pole with a knob, and a cloth cut to a point, seen from both sides. Along the
// cloth u runs 0 at the pole to 1 at its tip (the shader sways it by u), v from 0 to 1 up it.
rp_pennant :: (p: [] ArchPen) {
  x := f32(RG_PENNANT_X); z := f32(RG_PENNANT_Z); tall := f32(RG_PENNANT_HEIGHT);
  p[0].material = RG_MAT_WOOD;
  arch_limb(p, x, 0, z, x, tall, z, 0.06, 0.04, 10);
  arch_ellipsoid(p, x, tall + 0.03, z, 0.07, 0.07, 0.07, 10, 6);
  p[0].material = RG_MAT_CLOTH;
  top := tall - 0.08; drop: f32 = 0.8;
  for i: 0..<RP_CLOTH_STEPS {
    u0 := cast(f32) i / cast(f32) RP_CLOTH_STEPS; u1 := cast(f32) (i + 1) / cast(f32) RP_CLOTH_STEPS;
    // The cloth narrows to its tip: both edges close on the middle.
    lo0 := top - drop + drop * 0.45 * u0; hi0 := top - drop * 0.45 * u0;
    lo1 := top - drop + drop * 0.45 * u1; hi1 := top - drop * 0.45 * u1;
    x0 := x + 0.04 + f32(RP_CLOTH_LONG) * u0; x1 := x + 0.04 + f32(RP_CLOTH_LONG) * u1;
    arch_quad(p, arch_at(x0, lo0, z, 0, 0, 1, u0, 0), arch_at(x1, lo1, z, 0, 0, 1, u1, 0), arch_at(x1, hi1, z, 0, 0, 1, u1, 1), arch_at(x0, hi0, z, 0, 0, 1, u0, 1));
    arch_quad(p, arch_at(x0, lo0, z, 0, 0, -1, u0, 0), arch_at(x0, hi0, z, 0, 0, -1, u0, 1), arch_at(x1, hi1, z, 0, 0, -1, u1, 1), arch_at(x1, lo1, z, 0, 0, -1, u1, 0));
  }
}

// Builds the range: every part, every place. True when it all fitted.
rp_build :: (t: [] RangePlace) -> bool {
  p: [1] ArchPen; arch_pen(p[..], t[0].mesh[..]);
  s: [1] ArchScene; arch_scene(s[..], t[0].records[..], t[0].draws[..]);
  wide := f32(RG_HALF_WIDE); back := f32(RG_BACK); far := f32(RG_FAR);

  // ---- what stands on the ground
  t[0].group_first[RP_STANDING] = 0;
  // The targets, their stands and poles, the fence's rails, the rack and the pennant: one part,
  // built where it stands.
  from := p[0].n;
  t[0].faces = 0;
  for i: 0..<RG_TARGETS {
    f := rg_face(i);
    rp_target(p[..], f);
    if i < RG_LANES { rp_stand(p[..], f); } else { rp_pole(p[..], f, rp_lamp(i)); }
    t[0].faces += 1;
  }
  p[0].material = RG_MAT_WOOD;
  for rail: 0..<2 {
    y := f32(RG_FENCE_HEIGHT) * (ifx rail == 0 then 0.45f32 else 0.85f32);
    arch_box(p[..], -wide, y, (far + back) * 0.5, 0.03, 0.05, (back - far) * 0.5);
    arch_box(p[..], wide, y, (far + back) * 0.5, 0.03, 0.05, (back - far) * 0.5);
    arch_box(p[..], 0, y, back, wide, 0.05, 0.03);
    arch_box(p[..], 0, y, far, wide, 0.05, 0.03);
  }
  rp_rack(p[..]);
  rp_pennant(p[..]);
  arch_once(s[..], arch_part(p[..], from));

  // The fence's posts: one post, stood every few metres round the boundary and at its corners.
  p[0].material = RG_MAT_WOOD;
  from = p[0].n; arch_box(p[..], 0, f32(RG_FENCE_HEIGHT) * 0.5, 0, 0.06, f32(RG_FENCE_HEIGHT) * 0.5, 0.06);
  fence := arch_part(p[..], from);
  first := s[0].rn;
  z := far;
  while z < back - 0.5 {
    r := arch_stand(s[..], -wide, 0, z, 0, 1); r = arch_stand(s[..], wide, 0, z, 0, 1);
    z += f32(RP_FENCE_STEP);
  }
  x := -wide + f32(RP_FENCE_STEP);
  while x < wide - 0.5 {
    r := arch_stand(s[..], x, 0, back, 0, 1); r = arch_stand(s[..], x, 0, far, 0, 1);
    x += f32(RP_FENCE_STEP);
  }
  corner := arch_stand(s[..], -wide, 0, back, 0, 1); corner = arch_stand(s[..], wide, 0, back, 0, 1);
  arch_draw(s[..], fence, first, s[0].rn - first);

  // A distance post at the left of each lane, its top painted the lane's own colour.
  post := rp_post(p[..]);
  first = s[0].rn;
  for i: 0..<RG_LANES {
    r := arch_stand(s[..], RG_LANE_X[i] - f32(RG_POST_OFFSET), 0, RG_LANE_Z[i], 0, 1);
    if r >= 0 { o := r * ARCH_RECORD_FLOATS; for k: 0..<3 { t[0].records[o + 8 + k] = RP_TINT[i * 3 + k]; } }
    arch_value(s[..], r, cast(f32) i);
  }
  arch_draw(s[..], post, first, s[0].rn - first);

  // The lanterns' posts: full height beside each lane's butt, low ones along the line (a sky
  // face's lantern hangs from its pole's arm).
  lamp_post := rp_lamp_post(p[..]);
  first = s[0].rn;
  for i: 0..<RP_LAMPS {
    if i >= RG_LANES && i < RG_TARGETS { continue; }
    l := rp_lamp(i);
    r := arch_stand(s[..], l.x, 0, l.z, 0, l.y / f32(RP_LAMP_HIGH));
  }
  arch_draw(s[..], lamp_post, first, s[0].rn - first);
  // The flames: one record each, which the glow in the light group shares.
  p[0].material = RG_MAT_FLAME;
  from = p[0].n; arch_gem(p[..], 0, 0, 0, 0.07, 0.13);
  flame := arch_part(p[..], from);
  lamps := s[0].rn;
  for i: 0..<RP_LAMPS {
    l := rp_lamp(i);
    r := arch_stand(s[..], l.x, l.y, l.z, 0, 1);
    arch_motion(s[..], r, ARCH_STILL, cast(f32) i * 2.1);
  }
  arch_draw(s[..], flame, lamps, s[0].rn - lamps);
  t[0].group_count[RP_STANDING] = s[0].dn;

  // ---- the ground: one slab, its top at y = 0
  t[0].group_first[RP_GROUND] = s[0].dn;
  p[0].material = RG_MAT_GRASS;
  margin := f32(RP_GROUND_MARGIN);
  from = p[0].n; arch_box(p[..], 0, -0.5, (far + back) * 0.5, wide + margin, 0.5, (back - far) * 0.5 + margin);
  arch_once(s[..], arch_part(p[..], from));
  t[0].group_count[RP_GROUND] = s[0].dn - t[0].group_first[RP_GROUND];

  // ---- what is only light: the glow round each flame, a panel facing the line and seen from both sides
  t[0].group_first[RP_LIGHT] = s[0].dn;
  p[0].material = RG_MAT_GLOW;
  from = p[0].n; arch_panel(p[..], 0, 0, 0, RP_GLOW_HALF, RP_GLOW_HALF);
  arch_draw(s[..], arch_part(p[..], from), lamps, RP_LAMPS);
  t[0].group_count[RP_LIGHT] = s[0].dn - t[0].group_first[RP_LIGHT];

  t[0].vertices = p[0].n; t[0].record_n = s[0].rn; t[0].draw_n = s[0].dn;
  t[0].built = !p[0].full && !s[0].full;
  return t[0].built;
}

// ---- the host's face: sizes, then copies of the three buffers

rp_size :: () -> int #export_c #effects(all) { return size_of(RangePlace); }
rp_make :: (t: [] RangePlace) -> bool #export_c #effects(all) { return rp_build(t); }
rp_vertex_floats :: () -> int #export_c #effects(all) { return ARCH_VERTEX_FLOATS; }
rp_record_floats :: () -> int #export_c #effects(all) { return ARCH_RECORD_FLOATS; }
rp_vertices :: (t: [] RangePlace) -> int #export_c #effects(all) { return t[0].vertices; }
rp_records :: (t: [] RangePlace) -> int #export_c #effects(all) { return t[0].record_n; }
rp_draws :: (t: [] RangePlace) -> int #export_c #effects(all) { return t[0].draw_n; }
rp_group_first :: (t: [] RangePlace, group: int) -> int #export_c #effects(all) { return ifx group >= 0 && group < RP_GROUPS then t[0].group_first[group] else 0; }
rp_group_count :: (t: [] RangePlace, group: int) -> int #export_c #effects(all) { return ifx group >= 0 && group < RP_GROUPS then t[0].group_count[group] else 0; }
rp_copy_mesh :: (t: [] RangePlace, out: [] f32) -> bool #export_c #effects(all) {
  n := t[0].vertices * ARCH_VERTEX_FLOATS; if out.count < n { return false; }
  for i: 0..<n { out[i] = t[0].mesh[i]; } return true;
}
rp_copy_records :: (t: [] RangePlace, out: [] f32) -> bool #export_c #effects(all) {
  n := t[0].record_n * ARCH_RECORD_FLOATS; if out.count < n { return false; }
  for i: 0..<n { out[i] = t[0].records[i]; } return true;
}
rp_copy_draws :: (t: [] RangePlace, out: [] u32) -> bool #export_c #effects(all) {
  n := t[0].draw_n * 4; if out.count < n { return false; }
  for i: 0..<n { out[i] = t[0].draws[i]; } return true;
}

#test "a disc faces the way it is told, upright or leant back, and its coordinates reach 1 at the rim" {
  buf: [200 * ARCH_VERTEX_FLOATS] f32; p: [1] ArchPen; arch_pen(p[..], buf[..]);
  rp_disc(p[..], 1, 2, 3, 0, 0, 1, 0.5, 16); up := arch_part(p[..], 0);
  #assert up.count == 48 && arch_facing(buf[..], up) > 15.9;
  // Upright, v is up the disc and u to its right.
  for i: 0..<up.count { o := i * ARCH_VERTEX_FLOATS; #assert abs(buf[o] - 1 - buf[o + 7] * 0.5) < 0.001 && abs(buf[o + 1] - 2 - buf[o + 8] * 0.5) < 0.001 && abs(buf[o + 2] - 3) < 0.001; }
  from := p[0].n; rp_disc(p[..], 0, 0, 0, 0, 0.5646425, 0.8253356, 1, 16); leant := arch_part(p[..], from);
  #assert arch_facing(buf[..], leant) > 15.9;
  from = p[0].n; rp_disc(p[..], 0, 0, 0, 0, 0, -1, 1, 16); back := arch_part(p[..], from);
  #assert arch_facing(buf[..], back) > 15.9 && !p[0].full;
}
#test "a target's straw faces out and holds its face, which stands proud of it" {
  buf: [1000 * ARCH_VERTEX_FLOATS] f32; p: [1] ArchPen; arch_pen(p[..], buf[..]);
  for i: 0..<RG_TARGETS {
    f := rg_face(i); from := p[0].n; rp_target(p[..], f); part := arch_part(p[..], from);
    #assert !p[0].full && arch_facing(buf[..], part) > cast(f32) (part.count / 3) * 0.95;
    for k: 0..<part.count {
      o := (part.first + k) * ARCH_VERTEX_FLOATS;
      dx := buf[o] - f.x; dy := buf[o + 1] - f.y; dz := buf[o + 2] - f.z;
      along := dx * f.nx + dy * f.ny + dz * f.nz; across := sqrt(abs(dx * dx + dy * dy + dz * dz - along * along));
      if buf[o + 6] == RG_MAT_FACE { #assert abs(along - RP_FACE_PROUD) < 0.001 && across <= f.radius + 0.001; }
      else { #assert along <= 0.001 && along >= -RG_BUTT_DEEP - 0.001 && across <= f.radius + RG_BUTT_MARGIN + 0.001; }
    }
    p[0].n = 0;
  }
}
#test "the range fits its buffers, every draw lies inside them, the three groups answer and nothing is NaN" {
  t: [1] RangePlace;
  #assert rp_make(t[..]) && t[0].built;
  #assert rp_size() == size_of(RangePlace) && rp_vertex_floats() == 12 && rp_record_floats() == 16;
  v := rp_vertices(t[..]); r := rp_records(t[..]); d := rp_draws(t[..]);
  #assert v > 0 && v <= RP_VERTICES && v % 3 == 0 && r > 0 && r <= RP_RECORDS && d > 0 && d <= RP_DRAWS;
  for i: 0..<d {
    o := i * 4;
    #assert t[0].draws[o + 1] > 0 && t[0].draws[o + 1] % 3 == 0 && cast(int) (t[0].draws[o] + t[0].draws[o + 1]) <= v;
    #assert t[0].draws[o + 3] > 0 && cast(int) (t[0].draws[o + 2] + t[0].draws[o + 3]) <= r;
  }
  // The groups: what stands, then the ground, then light, covering every draw between them.
  #assert rp_group_first(t[..], RP_STANDING) == 0 && rp_group_count(t[..], RP_STANDING) > 0;
  #assert rp_group_first(t[..], RP_GROUND) == rp_group_count(t[..], RP_STANDING) && rp_group_count(t[..], RP_GROUND) == 1;
  #assert rp_group_first(t[..], RP_LIGHT) == rp_group_first(t[..], RP_GROUND) + 1 && rp_group_first(t[..], RP_LIGHT) + rp_group_count(t[..], RP_LIGHT) == d && rp_group_count(t[..], RP_LIGHT) == 1;
  #assert rp_group_first(t[..], 3) == 0 && rp_group_count(t[..], -1) == 0;
  // A number that is not itself is NaN; and nothing is absurdly far away.
  for i: 0..<v * ARCH_VERTEX_FLOATS { #assert t[0].mesh[i] == t[0].mesh[i] && abs(t[0].mesh[i]) < 1000; }
  for i: 0..<r * ARCH_RECORD_FLOATS { #assert t[0].records[i] == t[0].records[i] && abs(t[0].records[i]) < 1000; }
  // Every vertex has a material the shader knows and a unit normal.
  for i: 0..<v {
    o := i * ARCH_VERTEX_FLOATS; m := t[0].mesh[o + 6];
    #assert m >= RG_MAT_GRASS && m <= RG_MAT_GLOW;
    n := t[0].mesh[o + 3] * t[0].mesh[o + 3] + t[0].mesh[o + 4] * t[0].mesh[o + 4] + t[0].mesh[o + 5] * t[0].mesh[o + 5];
    #assert n > 0.98 && n < 1.02;
  }
}
#test "there are RG_TARGETS faces, each a whole disc; the ground covers the boundary and nothing built goes under it" {
  t: [1] RangePlace; #assert rp_make(t[..]);
  face := 0; v := t[0].vertices;
  for i: 0..<v { if t[0].mesh[i * ARCH_VERTEX_FLOATS + 6] == RG_MAT_FACE { face += 1; } }
  #assert t[0].faces == RG_TARGETS && face == RG_TARGETS * RP_ROUND * 3;
  // The ground is one draw: a slab with its top at y = 0, out past the fence each way.
  o := t[0].group_first[RP_GROUND] * 4; first := cast(int) t[0].draws[o]; count := cast(int) t[0].draws[o + 1];
  #assert count == 36;
  lx: f32 = 0; hx: f32 = 0; lz: f32 = 0; hz: f32 = 0;
  for i: 0..<count {
    g := (first + i) * ARCH_VERTEX_FLOATS;
    #assert t[0].mesh[g + 6] == RG_MAT_GRASS && t[0].mesh[g + 1] <= 0;
    if t[0].mesh[g] < lx { lx = t[0].mesh[g]; } if t[0].mesh[g] > hx { hx = t[0].mesh[g]; }
    if t[0].mesh[g + 2] < lz { lz = t[0].mesh[g + 2]; } if t[0].mesh[g + 2] > hz { hz = t[0].mesh[g + 2]; }
  }
  #assert abs(lx + RG_HALF_WIDE + 20) < 0.001 && abs(hx - RG_HALF_WIDE - 20) < 0.001 && abs(lz - RG_FAR + 20) < 0.001 && abs(hz - RG_BACK - 20) < 0.001;
  // (A leaning leg's foot sinks a little into the ground.)
  for i: 0..<cast(int) t[0].draws[1] { #assert t[0].mesh[i * ARCH_VERTEX_FLOATS + 1] >= -0.1; }
  // The fence: a post at each corner and no gap wider than its step; the posts carry each lane's paint.
  posts := cast(int) t[0].draws[4 + 3]; lanes := cast(int) t[0].draws[8 + 3];
  #assert posts == 2 * 29 + 2 * 14 + 2 && lanes == RG_LANES;
  from := cast(int) t[0].draws[8 + 2];
  for i: 0..<RG_LANES {
    q := (from + i) * ARCH_RECORD_FLOATS;
    #assert abs(t[0].records[q] - (RG_LANE_X[i] - RG_POST_OFFSET)) < 0.001 && t[0].records[q + 2] == RG_LANE_Z[i] && t[0].records[q + 8] == RP_TINT[i * 3];
  }
}
#test "every target has a lantern near enough to light its face, the line has its row, and the glow shares the flames' records" {
  t: [1] RangePlace; #assert rp_make(t[..]);
  for i: 0..<RG_TARGETS {
    f := rg_face(i); l := rp_lamp(i);
    dx := l.x - f.x; dy := l.y - f.y; dz := l.z - f.z; d := sqrt(dx * dx + dy * dy + dz * dz);
    // In front of the face, within three metres of its middle, and clear of the straw.
    #assert dx * f.nx + dy * f.ny + dz * f.nz > 0.5 && d < 3.0 && d > 1.0;
  }
  for k: 0..<RP_LINE_LAMPS {
    l := rp_lamp(RG_TARGETS + k);
    #assert l.z == RG_LINE_Z && abs(l.x) <= RG_LINE_HALF;
    // A line lantern stands between two lanes, never in one.
    for i: 0..<RG_LANES { #assert abs(l.x - RG_LANE_X[i]) > 2; }
  }
  // The flames are the last standing draw and the glow the light group's: the same records.
  fo := (t[0].group_count[RP_STANDING] - 1) * 4; go := t[0].group_first[RP_LIGHT] * 4;
  #assert t[0].draws[fo + 2] == t[0].draws[go + 2] && t[0].draws[fo + 3] == RP_LAMPS && t[0].draws[go + 3] == RP_LAMPS && t[0].draws[go + 1] == 12;
  from := cast(int) t[0].draws[go + 2];
  for i: 0..<RP_LAMPS { l := rp_lamp(i); q := (from + i) * ARCH_RECORD_FLOATS; #assert t[0].records[q] == l.x && t[0].records[q + 1] == l.y && t[0].records[q + 2] == l.z; }
  #assert t[0].mesh[cast(int) t[0].draws[fo] * ARCH_VERTEX_FLOATS + 6] == RG_MAT_FLAME && t[0].mesh[cast(int) t[0].draws[go] * ARCH_VERTEX_FLOATS + 6] == RG_MAT_GLOW;
}
