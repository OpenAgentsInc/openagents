// The Archery Range, built (everglade/docs/archery-range-spec.md): five straw butts on wooden
// legs, two faces on tall poles, a distance post beside each lane and a chalk shooting line, each
// standing on the ground under it. Made in Coax from the engine's build-site meshes
// (metaverse-engine/world/build-site-mesh.coax), in its materials (timber; straw and paint in their own colours),
// to layout.coax's numbers; the scene packer adds the whole range to a pack as one mesh
// (metaverse/tools/assets/character_glade_pack.coax --append-range, "C glade/range").
//
//   the pieces (layout.coax rg_piece): what stands where, in the range's frame;
//   the mesh (rg_build): every piece, on the ground heights it is given;
//   the colliders are layout.coax's (rg_boxes), which the room and the walker load without this.
//
// A face is ten flat rings of paint on a disc, a little proud of its straw, so an arrow meets the
// face (metaverse-engine/action/target.coax) before the straw behind it.
//   coax/bin/coax test --library everglade/range/place.coax
#module "everglade.range.place";
#load "layout.coax";
#load "../../metaverse-engine/world/build-site.coax" as bs;
#load "../../metaverse-engine/world/build-site-mesh.coax" as bsm;
#load "../../metaverse-engine/world/building.coax" as building;

RG_FACE_PROUD :: 0.012;       // a face stands this far off its straw
RG_ROUND :: 40;               // steps round a face
RG_ROUND_E2 :: 16;            // and in Everglade's pack, which has less room (metaverse/tools/assets/character_glade_pack.coax --append-range-e2)
// Straw: its own colour on the packer's plain tile (the earth material's), so a butt reads as a
// pale gold bale and not as a board.
RG_STRAW :: [3] f32.[0.86, 0.70, 0.34];
RG_STRAW_MAT :: bs.BS_EARTH;
// A ring's paint, the outermost first: white, white, black, black, blue, blue, red, red, gold, gold.
RG_PAINT :: [5][3] f32.[[3] f32.[0.94, 0.93, 0.88], [3] f32.[0.07, 0.07, 0.08], [3] f32.[0.16, 0.42, 0.86], [3] f32.[0.85, 0.14, 0.12], [3] f32.[0.98, 0.80, 0.12]];

// A face's rings about `o`, in the plane of unit `ax` and `ay` (ax across ay is the way it looks).
rg_rings :: (m: [] bsm.BsMesh, o: [3] f32, ax: [3] f32, ay: [3] f32, radius: f32, steps: int) {
  for ring: 0..<RG_RINGS {
    r1 := radius * (1 - f32(RG_RING) * f32(ring)); r0 := radius * (1 - f32(RG_RING) * f32(ring + 1));
    col := RG_PAINT[ring / 2];
    for j: 0..<steps {
      a := f32(j) * 6.2831853 / f32(steps); b := f32(j + 1) * 6.2831853 / f32(steps);
      da := bsm.bm_add(bsm.bm_mul(ax, cos(a)), bsm.bm_mul(ay, sin(a))); db := bsm.bm_add(bsm.bm_mul(ax, cos(b)), bsm.bm_mul(ay, sin(b)));
      p0 := bsm.bm_add(o, bsm.bm_mul(da, r0)); p1 := bsm.bm_add(o, bsm.bm_mul(da, r1)); p2 := bsm.bm_add(o, bsm.bm_mul(db, r1)); p3 := bsm.bm_add(o, bsm.bm_mul(db, r0));
      uv := [4][2] f32.[[2] f32.[cos(a) * r0, sin(a) * r0], [2] f32.[cos(a) * r1, sin(a) * r1], [2] f32.[cos(b) * r1, sin(b) * r1], [2] f32.[cos(b) * r0, sin(b) * r0]];
      if r0 < 0.0001 { i0 := bsm.bm_vert(m, p1, bsm.bm_cross(ax, ay), uv[1][0], uv[1][1], col, bs.BS_DAUB); i1 := bsm.bm_vert(m, p2, bsm.bm_cross(ax, ay), uv[2][0], uv[2][1], col, bs.BS_DAUB); i2 := bsm.bm_vert(m, o, bsm.bm_cross(ax, ay), 0, 0, col, bs.BS_DAUB); bsm.bm_tri(m, i0, i1, i2); }
      else { bsm.bm_quad(m, p0, p1, p2, p3, uv, col, bs.BS_DAUB); }
    }
  }
}
// A lane's butt about its foot: the straw, its face, two legs and a prop behind.
rg_butt :: (m: [] bsm.BsMesh, lane: int, steps: int) {
  r := RG_LANE_RADIUS[lane]; h := rg_straw(r); deep := f32(RG_BUTT_DEEP); y := f32(RG_FACE_Y); leg := f32(RG_STAND_LEG);
  straw := RG_STRAW; wood := [3] f32.[0.9, 0.86, 0.8];
  bsm.bm_box(m, [3] f32.[0, y, -deep * 0.5], [3] f32.[h, 0, 0], [3] f32.[0, h, 0], [3] f32.[0, 0, deep * 0.5], straw, RG_STRAW_MAT, false);
  rg_rings(m, [3] f32.[0, y, f32(RG_FACE_PROUD)], [3] f32.[1, 0, 0], [3] f32.[0, 1, 0], r, steps);
  // the legs run from under the turf to the straw's top, behind its front
  for side: 0..<2 { x := (ifx side == 0 then -1.0f32 else 1.0f32) * (h - leg * 2);
    top := y + h + 0.12; bsm.bm_box(m, [3] f32.[x, (top - 0.4) * 0.5, -deep - leg], [3] f32.[0, (top + 0.4) * 0.5, 0], [3] f32.[leg, 0, 0], [3] f32.[0, 0, leg], wood, bs.BS_TIMBER, true); }
  bsm.bm_pole(m, [3] f32.[0, y + h * 0.5, -deep - leg], [3] f32.[0, -0.3, -deep - f32(RG_PROP_BACK)], leg, leg, 6, wood, bs.BS_TIMBER);
}
// A sky face about its pole's foot: the pole, a round board leaning back on its top, and its face.
rg_skyface :: (m: [] bsm.BsMesh, k: int, steps: int) {
  y := RG_SKY_Y[k]; r := f32(RG_SKY_RADIUS); wood := [3] f32.[0.9, 0.86, 0.8];
  n := [3] f32.[0, 0.5646425, 0.8253356]; ax := [3] f32.[1, 0, 0]; ay := bsm.bm_cross(n, ax);   // up the face
  bsm.bm_pole(m, [3] f32.[0, -0.4, -0.2], [3] f32.[0, y, -0.2], f32(RG_SKY_POLE), f32(RG_SKY_POLE) * 0.7, 8, wood, bs.BS_TIMBER);
  back := bsm.bm_mul(n, -0.07);
  bsm.bm_box(m, [3] f32.[back[0], y + back[1], back[2]], bsm.bm_mul(ax, r + 0.08), bsm.bm_mul(ay, r + 0.08), bsm.bm_mul(n, 0.06), RG_STRAW, RG_STRAW_MAT, false);
  proud := bsm.bm_mul(n, f32(RG_FACE_PROUD));
  rg_rings(m, [3] f32.[proud[0], y + proud[1], proud[2]], ax, ay, r, steps);
}
// Piece i into the mesh, its foot on `ground`, a face's rings `steps` round.
rg_build_piece :: (m: [] bsm.BsMesh, i: int, ground: f32) { rg_build_piece_steps(m, i, ground, RG_ROUND); }
rg_build_piece_steps :: (m: [] bsm.BsMesh, i: int, ground: f32, steps: int) {
  p := rg_piece(i); at := rg_piece_at(i);
  m[0].f = building.BuildingFrame.{x = at[0], z = at[1]}; m[0].y = ground; bsm.bm_key(m, 0, -1);
  if p.kind == RG_BUTT { rg_butt(m, p.k, steps); }
  else if p.kind == RG_SKYFACE { rg_skyface(m, p.k, steps); }
  else if p.kind == RG_POST { h := f32(RG_POST_HALF); top := f32(RG_POST_HEIGHT);
    bsm.bm_box(m, [3] f32.[0, (top - 0.4) * 0.5, 0], [3] f32.[0, (top + 0.4) * 0.5, 0], [3] f32.[h, 0, 0], [3] f32.[0, 0, h], [3] f32.[0.9, 0.86, 0.8], bs.BS_TIMBER, true);
    // a painted band for each ten metres... the nearest lane one band, the farthest five
    for b: 0..<p.k + 1 { y := top - 0.1 - f32(b) * 0.16; bsm.bm_box(m, [3] f32.[0, y, 0], [3] f32.[h + 0.008, 0, 0], [3] f32.[0, 0.045, 0], [3] f32.[0, 0, h + 0.008], RG_PAINT[3], bs.BS_DAUB, false); } }
  else { bsm.bm_box(m, [3] f32.[0, 0.012, 0], [3] f32.[f32(RG_MARK) * 0.5, 0, 0], [3] f32.[0, 0.014, 0], [3] f32.[0, 0, 0.06], RG_PAINT[0], bs.BS_DAUB, false); }
}
// The whole range into the mesh: ground[i] the meadow's height under piece i (rg_piece_at).
rg_build :: (m: [] bsm.BsMesh, ground: [] f32) { rg_build_steps(m, ground, RG_ROUND); }
rg_build_steps :: (m: [] bsm.BsMesh, ground: [] f32, steps: int) {
  for i: 0..<RG_PIECES { rg_build_piece_steps(m, i, ifx i < ground.count then ground[i] else 0.0f32, steps); }
}
#test "a butt's mesh is its straw, ten rings of paint proud of it, and its timber, standing on its ground" #steps 200000000 {
  m: [1] bsm.BsMesh; rg_build_piece(m[..], 2, 3.0);
  #assert !m[0].over && m[0].nv > 1000 && m[0].ni % 3 == 0;
  at := rg_piece_at(2); paint := 0; straw := 0; wood := 0; front := -1000.0f32; gold := false;
  for k: 0..<m[0].nv { v := m[0].v[k];
    if v.mat == bs.BS_DAUB { paint += 1; #assert abs(v.p[2] - at[1] - RG_FACE_PROUD) < 0.0001 && v.n[2] > 0.99;
      dx := v.p[0] - at[0]; dy := v.p[1] - 3 - RG_FACE_Y; #assert sqrt(dx * dx + dy * dy) <= RG_LANE_RADIUS[2] + 0.001;
      if v.c[0] > 0.9 && v.c[2] < 0.2 && sqrt(dx * dx + dy * dy) < RG_LANE_RADIUS[2] * 0.21 { gold = true; } }
    if v.mat == RG_STRAW_MAT { straw += 1; if v.p[2] > front { front = v.p[2]; } }
    if v.mat == bs.BS_TIMBER { wood += 1; }
  }
  #assert paint > 0 && straw == 24 && wood > 0 && gold && abs(front - at[1]) < 0.0001;
}
#test "the whole range fits its mesh, and a sky face's paint looks up and toward the line" #steps 2000000000 {
  m: [1] bsm.BsMesh; g: [RG_PIECES] f32; rg_build(m[..], g[..]);
  #assert !m[0].over && m[0].nv < 40000;
  n := m[0].nv; rg_build_piece(m[..], RG_LANES, 0);
  for k: n..<m[0].nv { v := m[0].v[k]; if v.mat == bs.BS_DAUB { #assert v.n[1] > 0.5 && v.n[2] > 0.8; } }
}
#test "Everglade's range is the same pieces with fewer steps round a face: under 6000 vertices" #steps 2000000000 {
  m: [1] bsm.BsMesh; g: [RG_PIECES] f32; rg_build_steps(m[..], g[..], RG_ROUND_E2);
  #assert !m[0].over && m[0].nv < 6000 && m[0].ni % 3 == 0;
  full: [1] bsm.BsMesh; rg_build(full[..], g[..]); #assert full[0].nv > m[0].nv;
}
