// The Archery Range's rules (everglade/docs/archery-range-spec.md): what an arrow scores and how
// good your shooting is. Nothing here moves or draws.
//
//   a strike (rg_strike): an arrow's step crosses a face's plane from the front, inside its rim;
//   its points (rg_points): the ring it landed in, 10 for the gold's middle down to 1 for the
//   outer white, a line counting for the ring inside it; off the face, 0;
//   how sure the aim is (rg_spread): the angle an arrow may leave the line of sight by. A full,
//   fresh draw from a still stance is the surest; a half-drawn bow, a draw held too long, your own
//   pace and the pace of what you ride each widen it;
//   the tally (RgScore): shots, hits, points and golds, kept apart for each way of shooting (on
//   foot, from horseback, from dragonback) and each band of distance, with the run of hits in a row.
//   coax/bin/coax test --library everglade/range/score.coax
#module "everglade.range.score";
#load "layout.coax";

RG_FOOT :: 0; RG_HORSE :: 1; RG_DRAGON :: 2; RG_MODES :: 3;
// The bands of distance a shot is counted in, by how far you stood from the face: up to 15 m,
// to 25, to 40, to 60, and beyond.
RG_BANDS :: 5;
RG_BAND_TO :: [4] f32.[15.0, 25.0, 40.0, 60.0];

// The aim's spread, radians.
RG_SPREAD_BEST :: 0.0035;     // a full fresh draw, standing still: about 25 cm at 70 m
RG_SPREAD_SLACK :: 0.030;     // more, for a bow not drawn at all
RG_SPREAD_PACE :: 0.016;      // more, moving at a full gallop or a full flight
RG_SPREAD_TIRED :: 0.020;     // more, for a draw held RG_TIRED_FULL seconds past RG_TIRED_FROM
RG_TIRED_FROM :: 2.5; RG_TIRED_FULL :: 4.0;

rg_clamp :: (v: f32, a: f32, b: f32) -> f32 { if v < a { return a; } if v > b { return b; } return v; }

// The points for landing `off` metres from the middle of a face of `radius`.
rg_points :: (off: f32, radius: f32) -> int {
  if !(radius > 0) || !(off >= 0) || off > radius { return 0; }
  ring := cast(int) floor(off / (radius * f32(RG_RING)));   // 0 the gold's middle
  if ring >= RG_RINGS { ring = RG_RINGS - 1; }
  return RG_RINGS - ring;
}

// Where an arrow's step from p0 to p1 meets face f: `hit` when it crossed the face's plane from the
// front inside the rim; then `u` is how far along the step, `off` how far from the middle.
RgStrike :: struct { hit: bool; u: f32; off: f32; points: int; }
rg_strike :: (f: RgFace, p0: [3] f32, p1: [3] f32) -> RgStrike {
  s: RgStrike;
  d0 := (p0[0] - f.x) * f.nx + (p0[1] - f.y) * f.ny + (p0[2] - f.z) * f.nz;
  d1 := (p1[0] - f.x) * f.nx + (p1[1] - f.y) * f.ny + (p1[2] - f.z) * f.nz;
  if !(d0 > 0) || d1 > 0 { return s; }
  u := d0 / (d0 - d1);
  x := p0[0] + (p1[0] - p0[0]) * u - f.x; y := p0[1] + (p1[1] - p0[1]) * u - f.y; z := p0[2] + (p1[2] - p0[2]) * u - f.z;
  off := sqrt(x * x + y * y + z * z);
  if off > f.radius { return s; }
  s.hit = true; s.u = u; s.off = off; s.points = rg_points(off, f.radius);
  return s;
}

// The spread of a shot: `strength` how drawn the bow is (0 to 1), `held` the seconds it has been
// drawn, `pace` your speed as a share of the fastest you can go this way (0 still, 1 flat out).
rg_spread :: (strength: f32, held: f32, pace: f32) -> f32 {
  tired := rg_clamp((held - f32(RG_TIRED_FROM)) / f32(RG_TIRED_FULL), 0, 1);
  return f32(RG_SPREAD_BEST) + f32(RG_SPREAD_SLACK) * (1 - rg_clamp(strength, 0, 1)) + f32(RG_SPREAD_PACE) * rg_clamp(pace, 0, 1) + f32(RG_SPREAD_TIRED) * tired;
}

rg_band :: (distance: f32) -> int {
  for i: 0..<RG_BANDS - 1 { if distance <= RG_BAND_TO[i] { return i; } }
  return RG_BANDS - 1;
}

RgTally :: struct { shots: int; hits: int; points: int; golds: int; }
RgScore :: struct {
  cell: [RG_MODES * RG_BANDS] RgTally;
  run: int; best_run: int;                 // hits in a row now, and the longest
  last_points: int = -1; last_distance: f32; last_mode: int; last_at: f32 = -100;   // the last arrow to land, -1 none yet
}
// One arrow has landed: shot this `mode` from `distance` metres, for `points` (0 a miss), at clock `now`.
rg_record :: (s: [] RgScore, mode: int, distance: f32, points: int, now: f32) {
  m := mode; if m < 0 || m >= RG_MODES { m = 0; }
  c := s[0].cell[m * RG_BANDS + rg_band(distance)..<m * RG_BANDS + rg_band(distance) + 1];
  c[0].shots += 1;
  if points > 0 { c[0].hits += 1; c[0].points += points; if points >= 9 { c[0].golds += 1; } s[0].run += 1; if s[0].run > s[0].best_run { s[0].best_run = s[0].run; } }
  else { s[0].run = 0; }
  s[0].last_points = points; s[0].last_distance = distance; s[0].last_mode = m; s[0].last_at = now;
}
// A way of shooting's tally over every band (mode -1: every way), or one band's over every way (band >= 0).
rg_sum :: (s: RgScore, mode: int, band: int) -> RgTally {
  t: RgTally;
  for m: 0..<RG_MODES { for b: 0..<RG_BANDS {
    if (mode >= 0 && m != mode) || (band >= 0 && b != band) { continue; }
    c := s.cell[m * RG_BANDS + b];
    t.shots += c.shots; t.hits += c.hits; t.points += c.points; t.golds += c.golds;
  } }
  return t;
}
// Hits in a hundred shots, and points an arrow in tenths; 0 before any shot.
rg_accuracy :: (t: RgTally) -> int { return ifx t.shots > 0 then (t.hits * 100 + t.shots / 2) / t.shots else 0; }
rg_average_tenths :: (t: RgTally) -> int { return ifx t.shots > 0 then (t.points * 10 + t.shots / 2) / t.shots else 0; }

#test "a face scores 10 at its middle down to 1 at its rim, a line for the ring inside, nothing off it" {
  #assert rg_points(0, 0.61) == 10 && rg_points(0.06, 0.61) == 10 && rg_points(0.062, 0.61) == 9;
  #assert rg_points(0.60, 0.61) == 1 && rg_points(0.61, 0.61) == 1 && rg_points(0.62, 0.61) == 0;
  #assert rg_points(0.5, 1.0) == 5 && rg_points(0.45, 1.0) == 6 && rg_points(-1, 1) == 0 && rg_points(0.1, 0) == 0;
  zero: f32 = 0; #assert rg_points(zero / zero, 1) == 0;
  last := 11;
  for i: 0..<100 { p := rg_points(f32(i) * 0.01, 1.0); #assert p <= last && p >= 1; last = p; }
}
#test "an arrow strikes a face it crosses from the front inside the rim, and no other way" {
  f := rg_face(2);   // the 30 m lane, facing +z
  a := rg_strike(f, [3] f32.[f.x + 0.2, f.y, f.z + 1], [3] f32.[f.x + 0.2, f.y, f.z - 1]);
  #assert a.hit && a.u > 0.49 && a.u < 0.51 && a.off > 0.19 && a.off < 0.21 && a.points == 7;
  #assert !rg_strike(f, [3] f32.[f.x, f.y, f.z - 1], [3] f32.[f.x, f.y, f.z + 1]).hit;                  // from behind
  #assert !rg_strike(f, [3] f32.[f.x + 0.7, f.y, f.z + 1], [3] f32.[f.x + 0.7, f.y, f.z - 1]).hit;      // past the rim
  #assert !rg_strike(f, [3] f32.[f.x, f.y, f.z + 3], [3] f32.[f.x, f.y, f.z + 1]).hit;                  // not there yet
  // A sky face leans back: an arrow falling onto it from above and in front strikes it.
  k := rg_face(RG_LANES);
  b := rg_strike(k, [3] f32.[k.x, k.y + 2, k.z + 2], [3] f32.[k.x, k.y - 1, k.z - 1]);
  #assert b.hit && b.points >= 1;
}
#test "the aim is surest drawn full, fresh and still, and each of the three widens it" {
  best := rg_spread(1, 1, 0);
  #assert best == RG_SPREAD_BEST && rg_spread(0.5, 1, 0) > best && rg_spread(1, 1, 1) > best && rg_spread(1, 9, 0) > best;
  #assert rg_spread(1, RG_TIRED_FROM, 0) == best && rg_spread(0, 99, 5) <= RG_SPREAD_BEST + RG_SPREAD_SLACK + RG_SPREAD_PACE + RG_SPREAD_TIRED + 0.0001;
}
#test "the tally keeps each way of shooting and each band apart, and the run of hits" {
  s: [1] RgScore;
  #assert rg_band(10) == 0 && rg_band(15) == 0 && rg_band(20) == 1 && rg_band(30) == 2 && rg_band(50) == 3 && rg_band(70) == 4 && rg_band(500) == 4;
  rg_record(s[..], RG_FOOT, 10, 10, 1); rg_record(s[..], RG_FOOT, 10, 7, 2); rg_record(s[..], RG_HORSE, 30, 0, 3); rg_record(s[..], RG_DRAGON, 70, 9, 4);
  foot := rg_sum(s[0], RG_FOOT, -1); all := rg_sum(s[0], -1, -1);
  #assert foot.shots == 2 && foot.hits == 2 && foot.points == 17 && foot.golds == 1;
  #assert all.shots == 4 && all.hits == 3 && all.points == 26 && all.golds == 2 && rg_sum(s[0], -1, 2).shots == 1 && rg_sum(s[0], RG_HORSE, 2).hits == 0;
  #assert rg_accuracy(all) == 75 && rg_average_tenths(all) == 65 && rg_accuracy(RgTally.{}) == 0;
  #assert s[0].run == 1 && s[0].best_run == 2 && s[0].last_points == 9 && s[0].last_mode == RG_DRAGON;
  rg_record(s[..], 99, 5, 3, 5); #assert rg_sum(s[0], RG_FOOT, 0).shots == 3;
}
