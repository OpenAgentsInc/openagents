}
#test "every hostile kind draws a body with geometry where it stands, asleep or awake" {
 s:[1]Creator;b:[1]figs.Bodies;out:[44*24]f32;ensure(s[..]);
 for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}
 s[0].scene_only=true;s[0].experimental=true;s[0].glade_word=7;b[0].ready=true;
 for k:0..<2 {s[0].npc_n[k]=48;for f:0..<48 {s[0].npc_first[k][f]=1000+k*100000+f*1000;s[0].npc_count[k][f]=900+k*30;}}
 hostile.hostile_start(s[0].hostiles[..]);
 seen:[5]bool;
 for i:0..<hostile.HS_N {e:=s[0].hostiles[0].enemies[i];if seen[e.kind] {continue;}seen[e.kind]=true;
  #assert e.sleeper && !e.awake;   // asleep: never yet turned toward anyone
  // you a step off it: in the part of the dungeon you see, or beside it in the meadow
  s[0].player_x=e.x+0.5;s[0].player_z=e.z;
  for pass:0..<2 {
   if pass==1 {s[0].hostiles[0].enemies[i].face_x=0;s[0].hostiles[0].enemies[i].face_z=0;}   // even a zero facing draws
   n:=scene(s[..],b[..],out[..]);found:=false;
   for d:0..<n {r:=d*24;if out[r+15]!=18 || out[r]!=e.x || out[r+2]!=e.z {continue;}found=true;
    mesh:=dungeon.dg_kind_mesh(e.kind);w:=b[0].draws[d*4+2];
    #assert b[0].draws[d*4+1]>0 && b[0].draws[d*4+3]==1 && cast(int)w==d;
    #assert cast(int)b[0].draws[d*4]>=s[0].npc_first[mesh][0] && cast(int)b[0].draws[d*4+1]==s[0].npc_count[mesh][0];
    #assert abs(out[r+8]*out[r+8]+out[r+9]*out[r+9]-1)<0.001 && out[r+10]>0.5;   // a real turn and size: not folded flat
    #assert out[r+4]==ifx mesh==0 then 6.0f32 else 9.0f32;}
   #assert found;
  }
 }
 for k:0..<5 {#assert seen[k];}
}
#test "monsters cycle animations every three seconds" {
 #assert monster_frame(0)==0 && monster_frame(0.5)==4 && monster_frame(3)==8 && monster_frame(18)==0;
 s:[1]Creator;catalog(s[..],"C glade/monster0 80 6 254 20 0 0\nC glade/monster47 200 9 254 20 0 0\n");
 #assert s[0].monster_n==2 && s[0].monster_first[0]==80 && s[0].monster_count[47]==9;
}
monster_frame :: (clock:f32)->int {clip:=int(floor(clock/3))%6;sample:=int(floor(clock*8))%8;return clip*8+sample;}
animal_frame :: (clock:f32)->int {return int(floor(clock*(10.0/0.6)))%10;}
// The shared static-mesh record translates model-space metres to the familiar's feet.
familiar_record :: (out:[]f32,rec:int,word:int,x:f32,y:f32,z:f32,yaw:f32) {
  at:=rec*24;
  for i:0..<24 { out[at+i]=0; }
  out[at]=x; out[at+1]=y; out[at+2]=z;
  out[at+7]=f32(word);
  out[at+8]=sin(yaw); out[at+9]=cos(yaw);
  out[at+15]=18;
}
// The dragon's baked frame at the druid's feet: like a familiar, scaled (1 = the model's own
// metres, about dragon.DR_HEIGHT tall), never to nothing.
dragon_record :: (out:[]f32,rec:int,word:int,x:f32,y:f32,z:f32,yaw:f32,scale:f32) {
  familiar_record(out,rec,word,x,y,z,yaw);
  out[rec*24+10]=ifx scale>0.001 then scale else 0.001f32;
}
#test "the dragon's frames read from the catalog and its record scales the model" {
  s:[1]Creator;catalog(s[..],"C glade/dragon0 500 30 247 900 0 0\nC glade/dragon1 530 30 247 900 0 0\nC glade/dragon75 1 3 247 900 0 0\n");
  #assert s[0].dragon_n==2 && s[0].dragon_first==500 && s[0].dragon_count==30 && s[0].dragon_word==900;
  // a frame out of line (not where the first frame and the size put it) leaves the dragon undrawn
  catalog(s[..],"C glade/dragon0 500 30 247 900 0 0\nC glade/dragon1 531 30 247 900 0 0\n");#assert s[0].dragon_n<0;
  catalog(s[..],"C glade/dragon1 530 30 247 900 0 0\nC glade/dragon0 500 30 247 900 0 0\n");#assert s[0].dragon_n==2 && s[0].dragon_first==500;
  out:[48]f32;dragon_record(out[..],1,900,2,3,4,0,0.5);
  #assert out[24]==2 && out[25]==3 && out[26]==4 && out[31]==900 && out[33]==1 && out[34]==0.5 && out[39]==18;
  dragon_record(out[..],0,900,0,0,0,0,0);
  #assert out[10]==0.001f32;
}
// The records of a figure wearing your character's parts, playing a: its worn pieces, head, hair and
// beard, from record n; returns the count after them.
figure_records :: (s:[]Creator,b:[]figs.Bodies,l:figs.BdLook,a:figs.BdAnim,out:[]f32,n0:int)->int {
  n:=n0;
  for i:0..<40 { if s[0].worn[i] && available(s[0],i) && s[0].source_count[i+(ifx s[0].female then 0 else 40)]>0 {
    p:=i+ifx s[0].female then 0 else 40;
    figs.bd_record(a,l,s[0].source_word[p],false,s[0].clock,out,n);out[n*24+11]=f32(s[0].variant);
    b[0].draws[n*4]=cast(u32)s[0].source_first[p];b[0].draws[n*4+1]=cast(u32)s[0].source_count[p];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  } }
  parts:[3]int;pn:=0;
  if !s[0].worn[7] { parts[pn]=l.head;pn+=1; }
  if l.hair>=0 && !s[0].worn[7] && !s[0].worn[26] {parts[pn]=l.hair;pn+=1;}
  if l.extra==figs.BP_BEARD && !s[0].worn[7] {parts[pn]=l.extra;pn+=1;}
  for i:0..<pn {
    p:=parts[i];figs.bd_record(a,l,b[0].part_word[p],false,s[0].clock,out,n);
    b[0].draws[n*4]=cast(u32)b[0].part_first[p];b[0].draws[n*4+1]=cast(u32)b[0].part_count[p];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }
  for i:n0..<n {for k:0..<3 {out[i*24+20+k]=EYES[s[0].eye_color][k];}out[i*24+23]=2;}
  return n;
}
scene :: (s:[]Creator,b:[]figs.Bodies,out:[]f32)->int { return scene_reserved(s,b,out,0); }
scene_reserved :: (s:[]Creator,b:[]figs.Bodies,out:[]f32,reserved:int)->int {
  b[0].draw_n=0;b[0].self_n=0;
  if !b[0].ready || !catalog_ready(s[0]) { return 0; }
  l:=look(s[0]); l.variant=0;
  a:figs.BdAnim; a.on=true; a.clip=[4]int.[figs.BD_IDLE,figs.BD_WALK,figs.BD_RUN,figs.BD_SPELL][s[0].pose];
  a.t0=s[0].pose_at; a.fade_at=-100; a.phase=(s[0].clock-s[0].pose_at)/figs.bd_seconds(a.clip); a.yaw=s[0].yaw;
  if s[0].pose==3 { dur:=figs.bd_seconds(figs.BD_SPELL); a.t0=s[0].pose_at+floor((s[0].clock-s[0].pose_at)/dur)*dur; }
  if s[0].walk.on {a=walk_figure(s[0],a);}
  if s[0].experimental {a=experimental_figure(s,a);a.yaw+=s[0].body_spin;}
  n:=figure_records(s,b,l,a,out,0);
  // first person: the camera is in your head, so your body's draws are left out of the view (not the shadows)
  b[0].self_n=ifx s[0].experimental && !s[0].scene_only && cc_self_hidden(s[0]) then n else 0;
  if s[0].experimental && !s[0].scene_only && n>0 && n<43 {n=held_weapon(s[0],b,out,n);}
  // and what your hands hold, unless it is up in front of you (a drawn bow): carried at your side it would float, handless, across the view
  if b[0].self_n>0 && s[0].aim<0.3 {b[0].self_n=n;}
  if s[0].scene_only || s[0].body_hidden {n=0;b[0].self_n=0;}   // body_hidden: a shape stands in for you (everglade/zone-shapechange.coax)
  // The open field (Creator.field, once its meadow is in the pack) stands in for the glade, its
  // village and its showcases: only the meadow, its grass and the creatures on it.
  open_field:=s[0].field && s[0].field_count>0;
  meadow_on:=open_field && !s[0].flat;   // a level zone draws its own floor: no meadow, no grass
  if meadow_on && n<43 {
    for k:0..<24 {out[n*24+k]=0;}
    out[n*24+7]=f32(s[0].field_word);out[n*24+8]=1;out[n*24+15]=16;   // c.x 1: the open meadow's ground, shaded as Everglade II's (cg_environment_fs)
    b[0].draws[n*4]=cast(u32)s[0].field_first;b[0].draws[n*4+1]=cast(u32)s[0].field_count;b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }
  // the builders at the build sites (charactercreator-crew.coax): each the character you made, at work
  if s[0].experimental && !open_field {for ci:0..<CC_CREWS {if !s[0].crews[ci].on || n>=36 {continue;}n=figure_records(s,b,l,cc_crew_anim(s[0],s[0].crews[ci]),out,n);}}
  if !open_field && s[0].glade_count>0 && n<43 {
    for k:0..<24 {out[n*24+k]=0;}
    out[n*24+7]=f32(s[0].glade_word);out[n*24+15]=16;
    b[0].draws[n*4]=cast(u32)s[0].glade_first;b[0].draws[n*4+1]=cast(u32)s[0].glade_count;b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }
  // the dungeon's inside, only the parts you can see into (experimental-dungeon.coax dg_seen); its
  // shadows are the shell's[0], so these cast none (everglade/zone.coax zone_shadow_select reads out[14])
  if s[0].experimental && !open_field && s[0].dungeon_n==dungeon.DG_CHUNKS {seen:=dungeon.dg_seen(s[0].player_x,s[0].player_z);for part:0..<dungeon.DG_CHUNKS {
    if n>=43 || (seen&(1<<part))==0 {continue;}
    for k:0..<24 {out[n*24+k]=0;}out[n*24+7]=f32(s[0].glade_word);out[n*24+14]=1;out[n*24+15]=16;
    b[0].draws[n*4]=cast(u32)s[0].dungeon_first[part];b[0].draws[n*4+1]=cast(u32)s[0].dungeon_count[part];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }}
  if s[0].experimental && !open_field && s[0].zero_ad_count>0 && n<43 {
    for k:0..<24 {out[n*24+k]=0;}out[n*24+7]=f32(s[0].glade_word);out[n*24+15]=16;
    b[0].draws[n*4]=cast(u32)s[0].zero_ad_first;b[0].draws[n*4+1]=cast(u32)s[0].zero_ad_count;b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }
  if s[0].experimental && !open_field && s[0].animal_n==10 && n<43 {
    take:=animal_frame(s[0].clock);for k:0..<24 {out[n*24+k]=0;}
    out[n*24+7]=f32(s[0].glade_word);out[n*24+15]=16;
    b[0].draws[n*4]=cast(u32)s[0].animal_first[take];b[0].draws[n*4+1]=cast(u32)s[0].animal_count[take];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }
  if s[0].experimental && (!open_field || s[0].mounts_stood) && n<43 {n=xh_records(s,b,out,n,43);}   // on the open field, only mounts a zone stood there (xh_stand)
  if s[0].experimental && !open_field && s[0].monster_n==48 && n<43 {
    take:=monster_frame(s[0].clock);for k:0..<24 {out[n*24+k]=0;}
    out[n*24+7]=f32(s[0].glade_word);out[n*24+15]=16;
    b[0].draws[n*4]=cast(u32)s[0].monster_first[take];b[0].draws[n*4+1]=cast(u32)s[0].monster_count[take];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }
  if s[0].experimental && s[0].npc_n[0]==48 && s[0].npc_n[1]==48 {seen:=dungeon.dg_seen(s[0].player_x,s[0].player_z);in_dungeon:=dungeon.dg_inside(s[0].player_x,s[0].player_z,0);
   // the monsters you could see: near, and in the dungeon only in a part you see into; nearest first,
   // so the slots left always hold the ones by you (their names show within 30 m)
   near:[hostile.HS_N]int;far:[hostile.HS_N]f32;nn:=0;
   for i:0..<hostile.HS_N {e:=s[0].hostiles[0].enemies[i];if e.dead && s[0].clock-e.died>2.4 {continue;}
    dx:=e.x-s[0].player_x;dz:=e.z-s[0].player_z;if dx*dx+dz*dz>48*48 {continue;}
    if dungeon.dg_inside(e.x,e.z,0) {part:=dungeon.dg_cell_chunk(dungeon.dg_col(e.x),dungeon.dg_row(e.z));if part>=0 && (seen&(1<<part))==0 {continue;}}else if in_dungeon {continue;}
    near[nn]=i;far[nn]=dx*dx+dz*dz;nn+=1;}
   for pick:0..<nn {if n>=41 {break;}best:=pick;for j:pick+1..<nn {if far[j]<far[best] {best=j;}}
    ti:=near[pick];tf:=far[pick];near[pick]=near[best];far[pick]=far[best];near[best]=ti;far[best]=tf;
    e:=s[0].hostiles[0].enemies[near[pick]];sink:=ifx e.dead then (s[0].clock-e.died)*0.9*e.scale else 0.0f32;
    kind:=dungeon.dg_kind_mesh(e.kind);take:=(ifx e.swing>=0 then 32 else ifx e.moving then 16 else 0)+int(floor(s[0].clock*8))%8;
    // its turn (sin, cos): a unit facing, never zero (a zero one folds the body flat to an unseen line)
    fl:=sqrt(e.face_x*e.face_x+e.face_z*e.face_z);fx:=ifx fl>0.001 then e.face_x/fl else 0.0f32;fz:=ifx fl>0.001 then e.face_z/fl else 1.0f32;
    for k:0..<24 {out[n*24+k]=0;}out[n*24]=e.x;out[n*24+1]=meadow.exp_height(e.x,e.z)-sink;out[n*24+2]=e.z;out[n*24+8]=fx;out[n*24+9]=fz;out[n*24+10]=ifx e.scale>0 then e.scale else 1.0f32;
    out[n*24+4]=ifx kind==0 then 6 else 9;out[n*24+5]=meadow.exp_height(out[n*24+4],-7);out[n*24+6]= -7;out[n*24+7]=f32(s[0].glade_word);out[n*24+15]=18;
    b[0].draws[n*4]=cast(u32)s[0].npc_first[kind][take];b[0].draws[n*4+1]=cast(u32)s[0].npc_count[kind][take];b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;n+=1;
  }}
  // its grass and understory: each kit's mesh once (kit_first, glade/meadowkitK, slot K-20), placed by
  // the GPU over a grid of cells round the eye (record kind 20, everglade/scene/gpu/character-glade.coax cg_meadow_vs)
  if meadow_on {for j:0..<14 {kit:=20+j;for t:0..<(ifx kit==grid.E2_MEADOW_GRASS then 4 else 1) {side:=grid.e2_meadow_side(kit,t);if side<=0 || s[0].kit_count[j]<3 || n>=44-reserved {break;}
    for k:0..<24 {out[n*24+k]=0;}
    out[n*24]=f32(kit);out[n*24+1]=f32(t);out[n*24+2]=f32(side);out[n*24+7]=f32(s[0].kit_word[j]);out[n*24+15]=20;
    if kit>=20 && kit<=22 {for k:0..<4 {out[n*24+8+k]=s[0].field_clear[k];}out[n*24+3]=s[0].field_band;out[n*24+4]=s[0].field_keep;}   // rocks keep out of a zone's clearing (everglade/scene/gpu/character-glade.coax cg_meadow_vs reads c)
    // the quality's reach (b.y: the grass's, the rocks' or the understory's) and, for the grass, its finest tier's share (b.z): cg_meadow_vs draws to them
    out[n*24+5]=ifx kit==grid.E2_MEADOW_GRASS then s[0].q_grass else ifx kit>=20 && kit<=22 then s[0].q_scenery else s[0].q_understory;out[n*24+6]=ifx kit==grid.E2_MEADOW_GRASS then s[0].q_fine else 1.0f32;   // the rocks stand far off; the small pieces cost a phone most and show least (#13190)
    b[0].draws[n*4]=cast(u32)s[0].kit_first[j];b[0].draws[n*4+1]=cast(u32)s[0].kit_count[j];b[0].draws[n*4+2]=cast(u32)((n+1)<<16);b[0].draws[n*4+3]=cast(u32)(side*side);n+=1;
  }}}
  for gi:0..<(ifx open_field then 0 else s[0].grass_groups) {if n>=44-reserved {break;}g:=s[0].grass[gi];
    for k:0..<24 {out[n*24+k]=0;}
    out[n*24]=f32(g.word);out[n*24+7]=f32(s[0].glade_word);out[n*24+15]=17;
    b[0].draws[n*4]=cast(u32)g.first;b[0].draws[n*4+1]=cast(u32)g.count;
    b[0].draws[n*4+2]=cast(u32)((n+1)<<16);b[0].draws[n*4+3]=cast(u32)(ifx grass_sorted(s[0]) then g.n else grass_share(g.n,s[0].q_grass));n+=1;   // sorted seeds: meadow_cull takes each cell's share
  }
  n=build_sites_draw(s,b,out,n,b[0].draws.count/4-reserved);
  n=range_draw(s,b,out,n,b[0].draws.count/4-reserved);
  n=cc_crew_piles_draw(s,b,out,n,b[0].draws.count/4-reserved);   // the builders' piles and loads
  b[0].draw_n=n;return n;
}

// The glade's grass seeds drawn at a graphics quality's grass knob: all at 1, a share below it
// (never under a quarter). The pack lists the seeds in no order of place, so the first of them
// are an even thinning of the whole glade.
grass_share :: (n:int,knob:f32)->int {
  k:=ifx knob>=1 then 1.0f32 else ifx knob<0.25 then 0.25f32 else knob;m:=cast(int)(f32(n)*k+0.5);
  return ifx m>n then n else ifx m<1 then (ifx n<1 then n else 1) else m;
}
// The open field's grids, culled (metaverse-engine/render/geometry/grid-cull.coax, #13147): scene() gives each kit one
// draw of its whole grid round the eye, side by side instances. Most of those cells are behind the
// camera, beside the view or out of the kit's ring, and the GPU ran every vertex of each to learn
// it. This gives the draw the first run of cells the view can see and adds a draw for each further
// run, after every other draw (they share the kit's record: the base instance's high half names
// it). A grid whose runs have no room keeps its one whole draw. Returns the draws.
meadow_cull :: (s:[]Creator,b:[]figs.Bodies,out:[]f32,n0:int,cap:int)->int {
  n:=n0;if !s[0].view_ok || !(s[0].view[3]>1) || !(s[0].view_w>1) {return n;}
  cx:=s[0].view[7];w:=s[0].view_w;
  v:=gcull.GridView.{ex=s[0].view[0],ez=s[0].view[2],fx=s[0].view[4],fy=s[0].view[5],fz=s[0].view[6],rx=s[0].view[8],ry=s[0].view[9],rz=s[0].view[10],half=(ifx cx>w-cx then cx else w-cx)/s[0].view[3]};
  // nothing on the field stands further above or below the eye than the eye is over its ground, and the land's own rise and fall
  up:=s[0].view[1]-cc_ground(s[0].flat,v.ex,v.ez);v.rise=(ifx up>0 then up else 0.0f32)+40;
  runs:[1024]u32;origin:f32= -32768;   // E2_MEADOW_ORIGIN: the grids' corner (everglade/scene/gpu/character-glade.coax cg_meadow_vs)
  for i:0..<n0 {
    base:=cast(int)b[0].draws[i*4+2];if base<65536 || (base&65535)!=0 {continue;}
    r:=(base>>16)-1;if (r+1)*24>out.count {continue;}
    if out[r*24+15]==17 {n=grass_cull(s,b,out,v,i,r,base,n,cap);continue;}
    if out[r*24+15]!=20 {continue;}
    kit:=cast(int)out[r*24];t:=cast(int)out[r*24+1];side:=cast(int)out[r*24+2];c:=grid.e2_meadow_grid_cell(kit,t);
    if side<=0 || c<=0 || cast(int)b[0].draws[i*4+3]!=side*side {continue;}
    gx:=floor((v.ex-origin)/c)-f32(side/2);gz:=floor((v.ez-origin)/c)-f32(side/2);
    // the ring at the quality's reach (everglade/world/field.coax e2_field_start_r, e2_field_out_r; meadow.coax e2_meadow_fade)
    g:=ifx out[r*24+5]>0 then out[r*24+5] else 1.0f32;inner:=grid.e2_meadow_grid_inner(kit,t)*g;outer:=grid.e2_meadow_grid_outer(kit,t)*g;
    if kit==grid.E2_MEADOW_GRASS && out[r*24+6]>0 && out[r*24+6]<=0.2501 {if t==0 {outer=0;}if t==1 {inner=0;}}
    if outer<=inner {b[0].draws[i*4+3]=0;continue;}
    // a quarter cell more round every test: the GPU works the eye's cell out for itself
    // a zone's clearing (the record's c, its band a.w; scene): no rock inside it, and with a band none past that
    clear:gcull.GridClear;if out[r*24+10]>out[r*24+8] {clear=gcull.GridClear.{on=true,x0=out[r*24+8],z0=out[r*24+9],x1=out[r*24+10],z1=out[r*24+11],band=out[r*24+3],slack=0.25*c};}
    m:=gcull.grid_cull_runs_clear(v,clear,origin+gx*c,origin+gz*c,c,side,inner,outer,grid.e2_meadow_grid_pad(kit)+0.25*c,runs[..]);
    if m<0 || n+m-1>cap {continue;}
    if m==0 {b[0].draws[i*4+3]=0;continue;}
    // nearest run first: what stands in front is drawn before what it hides, so the GPU's depth test
    // drops the hidden pixels before it shades them (the scene's shader cuts leaves out, so the GPU
    // can't sort them itself)
    if m<=256 {far:[256]f32;
      for k:0..<m {first:=cast(int)runs[k*2];count:=cast(int)runs[k*2+1];rx:=origin+(gx+f32(first%side)+f32(count)*0.5)*c-v.ex;rz:=origin+(gz+f32(first/side)+0.5)*c-v.ez;far[k]=rx*rx+rz*rz;}
      for k:1..<m {d:=far[k];r0:=runs[k*2];r1:=runs[k*2+1];j:=k;while j>0 && far[j-1]>d {far[j]=far[j-1];runs[j*2]=runs[j*2-2];runs[j*2+1]=runs[j*2-1];j-=1;}far[j]=d;runs[j*2]=r0;runs[j*2+1]=r1;}
    }
    b[0].draws[i*4+2]=cast(u32)(base+cast(int)runs[0]);b[0].draws[i*4+3]=runs[1];
    for k:1..<m {b[0].draws[n*4]=b[0].draws[i*4];b[0].draws[n*4+1]=b[0].draws[i*4+1];b[0].draws[n*4+2]=cast(u32)(base+cast(int)runs[k*2]);b[0].draws[n*4+3]=runs[k*2+1];n+=1;}
  }
  return n;
}
// The glade's grass, culled (metaverse/experimental-grass-grid.coax): a group whose seeds the pack holds
// sorted into cells draws only the cells the view can see, nearest first, each the quality's share
// of its seeds (a cell's first seeds are an even thinning of it). The draw takes the first cell and
// a draw is added for each further one. With no room for them the group keeps its one whole draw.
// The pack's grass is the sorted one: every group it lists has the baked count for its number.
grass_sorted :: (s:Creator)->bool {
  if s.grass_groups<1 {return false;}
  for k:0..<s.grass_groups {if s.grass[k].group<0 {return false;}}
  return true;
}
grass_cull :: (s:[]Creator,b:[]figs.Bodies,out:[]f32,v:gcull.GridView,i:int,r:int,base:int,n0:int,cap:int)->int {
  n:=n0;gi:= -1;for k:0..<s[0].grass_groups {if f32(s[0].grass[k].word)==out[r*24] {gi=k;}}
  if gi<0 || !grass_sorted(s[0]) {return n;}g:=s[0].grass[gi];if cast(int)b[0].draws[i*4+3]!=g.n {return n;}
  cells:[ggrid.EXG_CELLS]int;far:[ggrid.EXG_CELLS]f32;m:=0;big:f32=1000000;
  for c:0..<ggrid.EXG_CELLS {
    if gbaked.EXG_BAKED_AT[g.group][c+1]<=gbaked.EXG_BAKED_AT[g.group][c] {continue;}
    q:=ggrid.exg_rect(c);if !gcull.grid_cull_seen(v,q[0],q[1],q[2],q[3],0,big,1.5) {continue;}
    mid:=ggrid.exg_mid(c);dx:=mid[0]-v.ex;dz:=mid[1]-v.ez;d:=dx*dx+dz*dz;
    j:=m;while j>0 && far[j-1]>d {far[j]=far[j-1];cells[j]=cells[j-1];j-=1;}far[j]=d;cells[j]=c;m+=1;
  }
  // each cell its share of seeds, and past the near ring fewer, as every field in the engine thins
  // with distance (meadow-grid.coax e2_meadow_density at the quality's grass reach, from the cell's
  // nearest point): far cells drew every seed of their share, tufts a few pixels tall (#13147)
  counts:[ggrid.EXG_CELLS]int;kept:=0;
  for k:0..<m {
    first:=gbaked.EXG_BAKED_AT[g.group][cells[k]];all:=gbaked.EXG_BAKED_AT[g.group][cells[k]+1]-first;
    counts[k]=grass_kept(all,s[0].q_grass,grass_cell_near(cells[k],v.ex,v.ez));
    if counts[k]>0 {kept+=1;}
  }
  if n+kept-1>cap {return n;}
  if kept==0 {b[0].draws[i*4+3]=0;return n;}
  put:=0;
  for k:0..<m {
    if counts[k]<=0 {continue;}
    first:=gbaked.EXG_BAKED_AT[g.group][cells[k]];
    at:=ifx put==0 then i else n;
    b[0].draws[at*4]=b[0].draws[i*4];b[0].draws[at*4+1]=b[0].draws[i*4+1];b[0].draws[at*4+2]=cast(u32)(base+first);b[0].draws[at*4+3]=cast(u32)counts[k];
    if put>0 {n+=1;}
    put+=1;
  }
  return n;
}
// How far a grass cell's nearest seed may stand from the eye (x, z): to its square, less a tuft's reach.
grass_cell_near :: (c:int,ex:f32,ez:f32)->f32 {
  x0:=f32(ggrid.EXG_X0)+f32(c%ggrid.EXG_SIDE)*f32(ggrid.EXG_CELL);z0:=f32(ggrid.EXG_Z0)+f32(c/ggrid.EXG_SIDE)*f32(ggrid.EXG_CELL);
  dx:=ifx ex<x0 then x0-ex else ifx ex>x0+f32(ggrid.EXG_CELL) then ex-x0-f32(ggrid.EXG_CELL) else 0.0f32;
  dz:=ifx ez<z0 then z0-ez else ifx ez>z0+f32(ggrid.EXG_CELL) then ez-z0-f32(ggrid.EXG_CELL) else 0.0f32;
  d:=sqrt(dx*dx+dz*dz)-1;return ifx d>0 then d else 0.0f32;
}
// A cell of n seeds d metres off: its share at the quality's grass knob, and no more than the
// field's density there (the cell's first seeds are an even thinning of it, so fewer stay even).
grass_kept :: (n:int,knob:f32,d:f32)->int {
  share:=grass_share(n,knob);far:=cast(int)(f32(n)*grid.e2_meadow_density(d,knob)+0.5);
  return ifx far<share then far else share;
}
#test "the glade's grass, sorted into cells, draws the cells in view nearest first, each its share thinned with distance; an unsorted pack draws every seed" #steps 400000000 {
 s:[1]Creator;b:[1]figs.Bodies;out:[44*24]f32;
 total:=gbaked.EXG_BAKED_N[2];#assert total>0 && gbaked.EXG_BAKED_AT[2][ggrid.EXG_CELLS]==total && gbaked.EXG_BAKED_AT[2][0]==0;
 for c:0..<ggrid.EXG_CELLS {#assert gbaked.EXG_BAKED_AT[2][c+1]>=gbaked.EXG_BAKED_AT[2][c];}
 // one group, the pack's third, as scene() draws it: record 0 of kind 17, one draw of every seed
 s[0].grass_groups=1;s[0].grass[0]=GrassDraw.{first=700,count=1482,word=4242,n=total,group=2};
 out[0]=4242;out[15]=17;b[0].draws[0]=700;b[0].draws[1]=1482;b[0].draws[2]=cast(u32)(1<<16);b[0].draws[3]=cast(u32)total;
 // a view from the glade's middle looking along -z, level
 s[0].view=[16]f32.[0,1.6,0,712, 0,0,-1,640, 1,0,0,384, 0,1,0,0];s[0].view_w=1280;s[0].view_ok=true;
 m:=meadow_cull(s[..],b[..],out[..],1,1024);#assert m>1 && m<=1+ggrid.EXG_CELLS;
 drawn:=0;last:f32= -1;thinned:=0;
 for i:0..<m {
  #assert b[0].draws[i*4]==700 && b[0].draws[i*4+1]==1482 && (b[0].draws[i*4+2]>>16)==1;
  first:=cast(int)(b[0].draws[i*4+2]&65535);count:=cast(int)b[0].draws[i*4+3];drawn+=count;
  // the draw is one cell's seeds, whole, and the cell is ahead of the eye or beside it, never well behind
  c:= -1;for k:0..<ggrid.EXG_CELLS {if gbaked.EXG_BAKED_AT[2][k]==first && gbaked.EXG_BAKED_AT[2][k+1]>first {c=k;}}
  // its seeds as far off as it lies: all of them near, fewer past the field's near ring (grass_kept)
  #assert c>=0 && count>0 && count==grass_kept(gbaked.EXG_BAKED_AT[2][c+1]-first,1,grass_cell_near(c,0,0));
  if grass_cell_near(c,0,0)<=16 {#assert count==gbaked.EXG_BAKED_AT[2][c+1]-first;}
  if grass_cell_near(c,0,0)>=40 {thinned+=1;#assert count*8<gbaked.EXG_BAKED_AT[2][c+1]-first+8;}
  mid:=ggrid.exg_mid(c);#assert mid[1]<16;far:=mid[0]*mid[0]+mid[1]*mid[1];#assert far>=last;last=far;
 }
 #assert drawn>0 && drawn<total*7/10 && thinned>0;
 #assert grass_kept(100,1,0)==100 && grass_kept(100,0.5,0)==50 && grass_kept(100,1,28)==25 && grass_kept(100,1,200)==0;
 // a second cull changes nothing; at a lower quality each cell draws its share
 #assert meadow_cull(s[..],b[..],out[..],m,1024)==m;
 b[0].draws[2]=cast(u32)(1<<16);b[0].draws[3]=cast(u32)total;s[0].q_grass=0.5;half:=meadow_cull(s[..],b[..],out[..],1,1024);#assert half>1 && half<=m;
 less:=0;for i:0..<half {less+=cast(int)b[0].draws[i*4+3];}#assert less<drawn*6/10 && less>0;s[0].q_grass=1;
 // no room for the cells: the one whole draw stays; an unsorted pack's group is left alone
 b[0].draws[2]=cast(u32)(1<<16);b[0].draws[3]=cast(u32)total;#assert meadow_cull(s[..],b[..],out[..],1,1)==1 && b[0].draws[3]==cast(u32)total;
 s[0].grass[0].group= -1;#assert !grass_sorted(s[0]) && meadow_cull(s[..],b[..],out[..],1,1024)==1 && b[0].draws[3]==cast(u32)total;
 // one group of another pack's among them: none is culled
 s[0].grass[0].group=2;s[0].grass_groups=2;s[0].grass[1]=GrassDraw.{first=1,count=3,word=9,n=5};#assert !grass_sorted(s[0]) && meadow_cull(s[..],b[..],out[..],1,1024)==1;s[0].grass_groups=1;#assert grass_sorted(s[0]);
 // the catalog: a group with the baked count is sorted; any other count is not
 ctext:[96]u8;t:=0;for ch:"C glade/grass2 21 465 250 164 " {ctext[t]=ch;t+=1;}dg:[12]u8;dk:=0;left:=total;while left>0 {dg[dk]=cast,trunc(u8)(48+left%10);left/=10;dk+=1;}for j:0..<dk {ctext[t]=dg[dk-1-j];t+=1;}for ch:" 0\nC glade/grass1 21 465 250 164 7 0\n" {ctext[t]=ch;t+=1;}
 q:[1]Creator;ensure(q[..]);catalog(q[..],cast(string)ctext[0..<t]);#assert q[0].grass_groups==2 && q[0].grass[0].group==2 && q[0].grass[0].n==total && q[0].grass[1].group== -1 && !grass_sorted(q[0]);
}
#test "the open field's grids are drawn as the runs of cells the view can see, and the glade's grass thins with its knob" #steps 400000000 {
 s:[1]Creator;b:[1]figs.Bodies;out:[44*24]f32;ensure(s[..]);
 catalog(s[..],"C glade/environment 9 12 250 100 8 0\nC glade/grass 21 465 250 164 20000 0\nC glade/meadow 40 600 250 300 0 0\nC glade/meadowkit33 700 90 250 310 0 0\nC glade/meadowkit25 800 120 250 320 0 0\nC glade/meadowkit20 900 50 250 300 0 0\n");
 for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}b[0].ready=true;s[0].scene_only=true;s[0].field=true;
 n:=scene(s[..],b[..],out[..]);#assert n==7;
 // no view yet: nothing changes
 #assert meadow_cull(s[..],b[..],out[..],n,1024)==n && b[0].draws[1*4+3]==67*67;
 // a view from (3, 1.6, -4) looking along -z, level, 1280 wide with a focal of 712
 s[0].view=[16]f32.[3,1.6,-4,712, 0,0,-1,640, 1,0,0,384, 0,1,0,0];s[0].view_w=1280;s[0].view_ok=true;
 m:=meadow_cull(s[..],b[..],out[..],n,1024);#assert m>n && m<=1024;
 // every kit's draws keep its mesh and its record, stay inside its grid, and together are well under the whole grid
 for d:1..<7 {
  side:=cast(int)out[d*24+2];rec:=cast(u32)(d+1);cells:=0;
  for i:0..<m {base:=b[0].draws[i*4+2];if (base>>16)!=rec {continue;}
   #assert b[0].draws[i*4]==b[0].draws[d*4] && b[0].draws[i*4+1]==b[0].draws[d*4+1];
   first:=cast(int)(base&65535);count:=cast(int)b[0].draws[i*4+3];#assert first+count<=side*side && first/side==(first+count-1)/side;cells+=count;
   // each kept cell row is ahead of the eye or within a cell or two of it: z at most the eye's
   iz:=first/side;#assert iz<=side/2+6;}
  #assert cells>0 && cells<side*side/2;
 }
 // a kit's runs come nearest first: each run's middle no nearer the eye than the one before
 for d:1..<7 {side:=cast(int)out[d*24+2];c:=grid.e2_meadow_grid_cell(cast(int)out[d*24],cast(int)out[d*24+1]);rec:=cast(u32)(d+1);last:f32= -1;
  gx:=floor((3.0f32+32768)/c)-f32(side/2);gz:=floor((-4.0f32+32768)/c)-f32(side/2);
  for i:0..<m {base:=b[0].draws[i*4+2];if (base>>16)!=rec {continue;}first:=cast(int)(base&65535);count:=cast(int)b[0].draws[i*4+3];
   rx:= -32768+(gx+f32(first%side)+f32(count)*0.5)*c-3;rz:= -32768+(gz+f32(first/side)+0.5)*c+4;far:=rx*rx+rz*rz;#assert far>=last;last=far;}}
 // a second cull changes nothing more (its draws are no longer whole grids)
 #assert meadow_cull(s[..],b[..],out[..],m,1024)==m;
 // a lower quality's reach draws fewer cells still; with the finest grass tier off, the 1 m tier draws from the eye
 s[0].q_scenery=0.7;s[0].q_understory=0.4;s[0].q_grass=0.45;s[0].q_fine=0.25;n=scene(s[..],b[..],out[..]);flowers:=0;stones:=0;for r:0..<n {if out[r*24+15]==20 && out[r*24]==25 {#assert out[r*24+5]==0.4f32;flowers+=1;}if out[r*24+15]==20 && out[r*24]==20 {#assert out[r*24+5]==0.7f32;stones+=1;}}#assert flowers==1 && stones==1;   // the understory's own reach; the rocks keep the scenery's
 #assert out[3*24+5]==0.45f32 && out[3*24+6]==0.25f32 && out[1*24+6]==1;
 low:=meadow_cull(s[..],b[..],out[..],n,1024);#assert low<m && b[0].draws[3*4+3]==0 && b[0].draws[4*4+3]>0;
 s[0].q_scenery=1;s[0].q_understory=1;s[0].q_grass=1;s[0].q_fine=1;
 // a zone's clearing with a band: the rocks' grid draws only the cells in the band round it (the field's first kit here is a rock, 20)
 n=scene(s[..],b[..],out[..]);all:=meadow_cull(s[..],b[..],out[..],n,1024);rocks:=0;for i:0..<all {if (b[0].draws[i*4+2]>>16)==2 {rocks+=cast(int)b[0].draws[i*4+3];}}
 s[0].field_clear=[4]f32.[-34,-43,34,59];s[0].field_band=9;s[0].field_keep=0.25;n=scene(s[..],b[..],out[..]);band:=meadow_cull(s[..],b[..],out[..],n,1024);ring:=0;for i:0..<band {if (b[0].draws[i*4+2]>>16)==2 {ring+=cast(int)b[0].draws[i*4+3];}}
 #assert rocks>0 && ring<rocks/2;s[0].field_clear=[4]f32.[0,0,0,0];s[0].field_band=0;s[0].field_keep=0;
 // with no room for the runs a grid keeps its one whole draw
 n=scene(s[..],b[..],out[..]);#assert meadow_cull(s[..],b[..],out[..],n,n)==n && b[0].draws[1*4+3]==67*67;
 // the glade's grass: all its seeds at 1, a share below, never under a quarter or over all
 #assert grass_share(20000,1)==20000 && grass_share(20000,0.7)==14000 && grass_share(20000,0)==5000 && grass_share(20000,3)==20000 && grass_share(0,0.5)==0 && grass_share(1,0.3)==1;
}

// ---- Build sites (metaverse-engine/world/build-site.coax, #13106): houses drawn at any progress, from each
// part's mesh packed once in its tier's frame ("C glade/build<i>", character_glade_pack.coax
// gp_build_parts). A zone or a stage sets a slot each frame: the tier, where it stands (its frame
// and ground height) and its progress from 0 to the tier's last stage. Each shown part is one
// instance (record kind 19: the frame times the part's pose, bs_pose); a part still growing carries
// 1 less its fraction in a.w, and the shader drops the pixels whose reveal key is past it. Colliders
// are the zone's, at whole stages (hw_boxes at floor(progress)).
BUILD_SITES :: 32;
BuildSite :: struct {on:bool;tier:int;f:building.BuildingFrame;y:f32;progress:f32;}
build_site_set :: (s:[]Creator,slot:int,tier:int,f:building.BuildingFrame,y:f32,progress:f32) {
 if slot<0 || slot>=BUILD_SITES || tier<0 || tier>=hw.HW_TIERS {return;}
 last:=f32(hw.hw_stages(tier));s[0].sites[slot]=BuildSite.{on=true,tier=tier,f=f,y=y,progress=ifx progress<0 then 0.0f32 else ifx progress>last then last else progress};
 cc_crew_set(s,slot,tier,f,y,s[0].sites[slot].progress);   // its builder and sounds (charactercreator-crew.coax)
}
build_site_clear :: (s:[]Creator,slot:int) {if slot>=0 && slot<BUILD_SITES {s[0].sites[slot].on=false;}cc_crew_clear(s,slot);}
// One part's record at r: kind 19, its whole matrix (columns c, e, f; translation a), a.w the cutoff,
// d.y 7 marks it a build part (everglade/zone.coax zone_shadow_select leaves it out of the shadow tiles).
build_record :: (out:[]f32,r:int,word:int,site:BuildSite,p:bs.BuildPart,frac:f32) {build_instance(out,r,word,site.f,site.y,bs.bs_pose(p,frac),frac);}
// Any packed mesh with reveal keys (a part, a builder's pile) as a build instance: placed at the
// frame and ground y, moved by `pose` in the frame, showing the vertices whose key is at most frac.
build_instance :: (out:[]f32,r:int,word:int,f:building.BuildingFrame,y:f32,pose:[12]f32,frac:f32) {
 o:=r*24;for k:0..<24 {out[o+k]=0;}
 m:=building.building_turn_matrix(f.turn,pose);
 out[o]=m[9]+f.x;out[o+1]=m[10]+y;out[o+2]=m[11]+f.z;out[o+3]=ifx frac<1 then 1-frac else 0.0f32;
 out[o+7]=f32(word);out[o+13]=7;out[o+15]=19;
 for k:0..<3 {out[o+8+k]=m[k];out[o+16+k]=m[3+k];out[o+20+k]=m[6+k];}
}
// The Archery Range's mesh where a zone stands it: one instance, whole, at the place it was packed for.
range_draw :: (s:[]Creator,b:[]figs.Bodies,out:[]f32,n:int,cap:int)->int {
 if !s[0].range_on || s[0].range_count<=0 || n>=cap || (n+1)*24>out.count {return n;}
 build_instance(out,n,s[0].range_word,building.BuildingFrame.{},0,[12]f32.[1,0,0,0,1,0,0,0,1,0,0,0],1);
 b[0].draws[n*4]=cast(u32)s[0].range_first;b[0].draws[n*4+1]=cast(u32)s[0].range_count;b[0].draws[n*4+2]=cast(u32)n;b[0].draws[n*4+3]=1;
 return n+1;
}
build_sites_draw :: (s:[]Creator,b:[]figs.Bodies,out:[]f32,n:int,cap:int)->int {
 if s[0].build_n!=hw.HW_PARTS {return n;}
 c:=n;parts:[hw.HW_MOST_PARTS]bs.BuildPart;fr:[hw.HW_MOST_PARTS]f32;
 for si:0..<BUILD_SITES {site:=s[0].sites[si];if !site.on {continue;}
  pn:=hw.hw_tier_parts(site.tier,parts[..]);bs.bs_fractions(parts[0..<pn],site.progress,fr[..]);
  for j:0..<pn {if c>=cap || (c+1)*24>out.count {return c;}if !bs.bs_shown(parts[0..<pn],fr[..],j) {continue;}
   i:=hw.HW_FIRST[site.tier]+j;if s[0].build_count[i]<=0 {continue;}
   build_record(out,c,s[0].build_word,site,parts[j],fr[j]);
   b[0].draws[c*4]=cast(u32)s[0].build_first[i];b[0].draws[c*4+1]=cast(u32)s[0].build_count[i];b[0].draws[c*4+2]=cast(u32)c;b[0].draws[c*4+3]=1;c+=1;}}
 return c;
}
#test "a build site at a whole progress draws exactly its stage, every part in place and whole" {
 s:[1]Creator;b:[1]figs.Bodies;out:[1024*24]f32;s[0].build_n=hw.HW_PARTS;s[0].build_word=5;
 for i:0..<hw.HW_PARTS {s[0].build_first[i]=i*100;s[0].build_count[i]=60;}
 parts:[hw.HW_MOST_PARTS]bs.BuildPart;
 for t:0..<hw.HW_TIERS {pn:=hw.hw_tier_parts(t,parts[..]);
  // a woven wall leaves the showcase at the stage the daub on its line is done
  gone:[hw.HW_MOST_PARTS]int;for j:0..<pn {gone[j]=99;if parts[j].mat!=bs.BS_WITHY {continue;}for q:0..<pn {if parts[q].mat==bs.BS_DAUB && parts[q].stage<gone[j] && parts[q].form==parts[j].form && parts[q].x0==parts[j].x0 && parts[q].z0==parts[j].z0 && parts[q].x1==parts[j].x1 && parts[q].z1==parts[j].z1 {gone[j]=parts[q].stage;}}}
  for k:0..<hw.hw_stages(t)+1 {f:=building.BuildingFrame.{x=10,z= -4,turn=3};build_site_set(s[..],0,t,f,2,f32(k));
   n:=build_sites_draw(s[..],b[..],out[..],0,1024);
   // the parts the whole-stage showcase draws (character_glade_pack.coax gp_housewright): stage <= k, a woven wall under finished daub left out
   want:=0;for j:0..<pn {if parts[j].stage>k || gone[j]<=k {continue;}
    #assert b[0].draws[want*4]==cast(u32)((hw.HW_FIRST[t]+j)*100);want+=1;}
   #assert n==want;
   id:=building.building_turn_matrix(3,[12]f32.[1,0,0,0,1,0,0,0,1,0,0,0]);
   for r:0..<n {o:=r*24;#assert out[o+3]==0 && out[o]==10 && out[o+1]==2 && out[o+2]== -4 && out[o+15]==19;for k2:0..<3 {#assert out[o+8+k2]==id[k2] && out[o+16+k2]==id[3+k2] && out[o+20+k2]==id[6+k2];}}
  }}
 // between stages the arriving part carries its cutoff: the hut at 1.5 has its two stage-1 parts whole and its one stage-2 part half done
 build_site_set(s[..],0,hw.HW_HUT,building.BuildingFrame.{},0,1.5);n:=build_sites_draw(s[..],b[..],out[..],0,1024);part:=0;for r:0..<n {if out[r*24+3]>0 && out[r*24+3]<1 {part+=1;}}#assert n==3 && part==1;
}

inside :: (b:Box,x:f32,y:f32)->bool { return x>=b.x0 && x<=b.x1 && y>=b.y0 && y<=b.y1; }
#test "creator desktop controls share one compact left sidebar without overlapping actions" {
 s:[1]Creator;creator_layout(s[..],1440,900,1);
 for i:0..<13 {b:=s[0].boxes[i];#assert b.x0==28 && b.x1==332 && b.y1-b.y0==36;if i>0 {#assert b.y0>=s[0].boxes[i-1].y1+4;}}
 for i:13..<18 {if i==15 {continue;}b:=s[0].boxes[i];#assert b.x0>=28 && b.x1<=332 && b.y1<=714;}
 #assert s[0].boxes[13].y0>s[0].boxes[12].y1 && s[0].boxes[16].y0>s[0].boxes[13].y1;
}
// The page's size and Character Create's boxes (everglade/hud/screens.coax eg_create_boxes).
creator_layout :: (s:[]Creator,w:f32,h:f32,k:f32) {
 s[0].width=w;s[0].height=h;s[0].scale=k;s[0].mobile=eg_create_boxes(s[0].boxes[..],w,h,k);
}
value :: (s:Creator,f:int)->string {
  if f==0 { return ifx s.female then "FEMALE" else "MALE"; }
  if f==1 { return [4]string.["PEASANT","RANGER","WIZARD","NOBLE"][s.outfit]; }
  if f==2 { return ifx s.hood then "HOODED" else "UNCOVERED"; }
  if f==3 { return [3]string.["ORIGINAL","COLOR II","COLOR III"][s.variant]; }
  if f==4 { return [9]string.["PINE","WINE","MIDNIGHT","IVORY","PLUM","INK","OCHRE","SLATE","NO DYE"][s.dye]; }
  if f==5 { return [6]string.["PORCELAIN","SAND","HONEY","COPPER","UMBER","EBONY"][s.skin]; }
  if f==6 { if s.hood { return "UNDER HOOD"; } return ifx s.female then [4]string.["LONG","BUNS","CROPPED","NONE"][s.hair] else [3]string.["PARTED","CROPPED","NONE"][s.hair]; }
  if f==7 { return [6]string.["DARK","CHESTNUT","GOLD","AUBURN","SILVER","VIOLET"][s.hair_color]; }
  if f==8 { if s.female { return "MALE ONLY"; } return ifx s.beard then "BEARDED" else "CLEAN SHAVEN"; }
  if f==12 {return [6]string.["BROWN","BLUE","GREEN","AMBER","GRAY","VIOLET"][s.eye_color];}
  if f==10 { return appearance.PART_LABELS[s.piece]; }
  if f==11 {if !available(s,s.piece) {return "MALE ONLY";}return ifx s.worn[s.piece] then "ON" else "OFF";}
  return [4]string.["IDLE","WALK","RUN","CAST"][s.pose];
}
ink :: (k:f32,r:f32,g:f32,b:f32)->Ink { return Ink.{core=0.55*k,light=1,glow=0.5*k,red=r,green=g,blue=b,scale=k,sans=false}; }
// Every Everglade label is set in its reading face (Spectral, everglade/hud/fonts.coax), a soft dark copy
// under it so it reads over the bright glade; other realms retain their own font.
text :: (out:[]f32,n:int,t:string,x:f32,y:f32,cap:f32,k:Ink)->int {
  d:=cc_text_drop(cap);under:=k;under.red=0;under.green=0;under.blue=0;under.light=k.light*0.55;
  v:=face_text(out,n,t,x+d,y+d,cap,under,HUD_FACE_BODY);
  return face_text(out,v,t,x,y,cap,k,HUD_FACE_BODY);
}
cc_text_drop :: (cap:f32)->f32 {d:=cap*0.09;return ifx d<1 then 1.0f32 else d;}
// One run of text in a face (HUD_FACE_BODY or HUD_FACE_TITLE), no shadow: the title face's glyphs
// are the atlas's green (tint.w 5, everglade/scene/gpu/fivelab.coax fivelab_hud_fs).
face_text :: (out:[]f32,n:int,t:string,x:f32,y:f32,cap:f32,k:Ink,face:int)->int {
  pen:=x;v:=n;i:=0;em:=sans_em(cap);
  while i<t.count {d:=decode(t,i);end:=i+d.len;code:=d.code;
    at:=v;v=draw_sans(out,v,t[i..<end],pen,y,cap,k);
    if face==HUD_FACE_TITLE {for q:at..<v {out[q*VERTEX_FLOATS+11]=MODE_SANS+1;}}
    pen+=face_advance(code,face)*em;i=end;
  }
  return v;
}
face_advance :: (code:u32,face:int)->f32 {
  c:=ifx code>=32 && code<=126 then int(code)-32 else 31;
  return f32(ifx face==HUD_FACE_TITLE then int(EG_TITLE_WIDTH[c]) else int(EG_BODY_WIDTH[c]))/f32(EG_FONT_UPM);
}
// How wide t is in a face at cap.
face_width :: (t:string,cap:f32,face:int)->f32 {w:f32=0;em:=sans_em(cap);for ch:t {w+=face_advance(cast(u32)ch,face)*em;}return w;}
// Each byte's advance in face at cap, into out (as many as fit); the filled part. face_width is their sum.
face_advances :: (t:string,cap:f32,face:int,out:[]f32)->[]f32 {em:=sans_em(cap);n:=0;for ch:t {if n>=out.count {break;}out[n]=face_advance(cast(u32)ch,face)*em;n+=1;}return out[0..<n];}
// Text in a HUD style's role (metaverse-engine/ui/hud-style.coax hud_text): its face, colour and size, a drop
// shadow, or an outline (damage, banners), at alpha a. x is its left end; centred when centre.
hud_say :: (out:[]f32,n:int,t:string,x:f32,y:f32,cap:f32,r:HudText,a:f32,k:f32,centre:bool)->int {
  c:=cap*r.scale;left:=ifx centre then x-face_width(t,c,r.face)*0.5 else x;v:=n;
  base:=ink(k,r.ink.r,r.ink.g,r.ink.b);base.light=r.ink.a*a;
  dark:=base;dark.red=0.03;dark.green=0.02;dark.blue=0.01;
  if r.outline {
    o:=ifx c*0.07<1.2*k then 1.2*k else c*0.07;dark.light=0.85*a;
    for q:0..<8 {ang:=f32(q)*0.7853982;v=face_text(out,v,t,left+cos(ang)*o,y+sin(ang)*o,c,dark,r.face);}
  } else if r.shadow {
    dark.light=0.6*a;d:=cc_text_drop(c);v=face_text(out,v,t,left+d,y+d,c,dark,r.face);
  }
  return face_text(out,v,t,left,y,c,base,r.face);
}
// hud_say, and its box in the layout trace when one is attached (metaverse-engine/ui/trace.coax): held by
// `parent`, named `name`, or its own words when name is "". The one place a HUD run is traced.
hud_say_ui :: (ui:[]UitTrace,parent:int,name:string,out:[]f32,n:int,t:string,x:f32,y:f32,cap:f32,r:HudText,a:f32,k:f32,centre:bool)->int {
  if uit_on(ui) && !uit_blank(t) {c:=cap*r.scale;wide:=face_width(t,c,r.face);_:=uit_words(ui,parent,ifx name.count>0 then name else t,ifx centre then x-wide*0.5 else x,y,c,wide);}
  return hud_say(out,n,t,x,y,cap,r,a,k,centre);
}
#test "text in the title face is the atlas's green, the reading face its red, and both are measured" {
  out:[8192]f32;n:=face_text(out[..],0,"Ab",0,20,10,ink(1,1,1,1),HUD_FACE_TITLE);
  #assert n==12;for q:0..<n {#assert out[q*VERTEX_FLOATS+11]==MODE_SANS+1;}
  m:=face_text(out[..],0,"Ab",0,20,10,ink(1,1,1,1),HUD_FACE_BODY);for q:0..<m {#assert out[q*VERTEX_FLOATS+11]==MODE_SANS;}
  #assert face_width("MMM",10,HUD_FACE_TITLE)>face_width("iii",10,HUD_FACE_TITLE);
  // a role's outline draws eight dark copies under the word; a shadow one
  t:=hud_tokens(HUD_FANTASY);
  #assert hud_say(out[..],0,"7",50,50,10,hud_text(t,HUD_TEXT_DAMAGE),1,1,true)==54;
  #assert hud_say(out[..],0,"7",50,50,10,hud_text(t,HUD_TEXT_NAME),1,1,false)==12;
}

// ---- Everglade's HUD style: the primitives metaverse-engine/ui/hud-style.coax's drawers write, as this
// realm's vertices (everglade/scene/gpu/fivelab.coax fivelab_hud_fs), and the mark that has the shader blend them.
EG_HUD :: HUD_FANTASY;
eg_tokens :: ()->HudTokens {return hud_tokens(EG_HUD);}
// The engine's widgets (metaverse-engine/ui/hud-menu.coax) as this renderer's vertices: their frames, then
// their words, each in its role (or its own ink), at alpha a. With a layout trace on the words
// (ws[0].ui), each word's box goes in it too, under the widget that holds it.
hud_draw :: (out:[]f32,at:int,l:[]HudList,ws:[]HudWords,a:f32,k:f32)->int {
  v:=hud_emit(out,at,l);
  for i:0..<ws[0].n {w:=ws[0].w[i];r:=hud_text(eg_tokens(),w.role);if w.inked {r.ink=w.ink;}
    v=hud_say_ui(ws[0].ui,w.parent,"",out,v,hud_word_text(ws,i),w.x,w.y,w.cap,r,a,k,w.centre);}
  return v;
}
hud_emit :: (out:[]f32,at:int,l:[]HudList)->int {
  v:=at;
  for i:0..<l[0].n {
    p:=l[0].p[i];
    if (v+6)*VERTEX_FLOATS>out.count {return v;}
    hw:=(p.x1-p.x0)*0.5;hh:=(p.y1-p.y0)*0.5;cx:=p.x0+hw;cy:=p.y0+hh;
    m:=hw;if hh<m {m=hh;} r:=p.radius;if r>m {r=m;}if r<0 {r=0;}
    a:=p.top.a;if a>1 {a=1;}if !(a>0) {continue;}
    pad:=1.5f32;ex:=hw+pad;ey:=hh+pad;co:=cos(p.turn);si:=sin(p.turn);
    lx:=[6]f32.[-ex,ex,ex,-ex,ex,-ex];ly:=[6]f32.[-ey,-ey,ey,-ey,ey,ey];
    wd:=ifx p.kind==HUD_PRIM_SWEEP then p.share else p.width;
    for q:0..<6 {
      o:=(v+q)*VERTEX_FLOATS;
      out[o]=cx+lx[q]*co-ly[q]*si;out[o+1]=cy+lx[q]*si+ly[q]*co;out[o+2]=lx[q];out[o+3]=ly[q];
      out[o+4]=hw;out[o+5]=hh;out[o+6]=r;out[o+7]=wd;
      out[o+8]=p.top.r;out[o+9]=p.top.g;out[o+10]=p.top.b;out[o+11]=f32(p.kind)*10+a;
      out[o+12]=p.bottom.r;out[o+13]=p.bottom.g;out[o+14]=p.bottom.b;out[o+15]=1;
    }
    v+=6;
  }
  return v;
}
// Every vertex in [from, to) blends by its coverage (the realm's host blends straight alpha:
// everglade2-face.c and fivelab-face.c coaxial_fx_alpha_v1). Run once a frame over all it drew.
hud_seal :: (out:[]f32,from:int,to:int) {for q:from..<to {o:=q*VERTEX_FLOATS+15;if o<out.count {out[o]=1;}}}
#test "a primitive becomes one quad round its box, turned about its centre, and sealed" {
  l:[1]HudList;hud_fill(l[..],hud_box(10,20,50,40),4,hud_rgba(1,0,0,0.5),hud_rgba(0,0,1,1));
  out:[256]f32;n:=hud_emit(out[..],0,l[..]);#assert n==6;
  #assert out[0]==30-21.5 && out[1]==30-11.5 && out[4]==20 && out[5]==10 && out[6]==4;
  #assert out[11]==10.5 && out[12]==0 && out[14]==1 && out[15]==1;
  hud_clear(l[..]);hud_diamond(l[..],0,0,10,hud_rgba(1,1,1,1),hud_rgba(1,1,1,1));n=hud_emit(out[..],0,l[..]);
  // a quarter-turned square: its first corner straight up
  #assert n==6 && abs(out[0])<0.001 && out[1]< -8;
  short:[40]f32;#assert hud_emit(short[..],0,l[..])==0;
  hud_seal(out[..],0,2);#assert out[15]==1 && out[31]==1;
}

// text, and its box in the layout trace when one is attached (metaverse-engine/ui/trace.coax): held by
// `parent` (a trace index, or UIT_NONE), named `name`, or its own words when name is "".
ttext :: (ui:[]UitTrace,parent:int,out:[]f32,n:int,t:string,x:f32,y:f32,cap:f32,k:Ink,name:string)->int {
  if ui.count>0 && !uit_blank(t) {uit_add(ui,parent,UIT_TEXT,x,y-cap,x+face_width(t,cap,HUD_FACE_BODY),y+cap*UIT_DESCENT,ifx name.count>0 then name else t);}
  return text(out,n,t,x,y,cap,k);
}
#test "traced text keeps the box text draws in, and draws the same strokes" {
  t:[1]UitTrace;a:[2048]f32;b:[2048]f32;nt:[]UitTrace;
  k:=ink(1,1,1,1);
  #assert ttext(t[..],UIT_NONE,a[..],0,"SAVE",10,40,10,k,"")==text(b[..],0,"SAVE",10,40,10,k);
  #assert ttext(nt,UIT_NONE,b[..],0,"SAVE",10,40,10,k,"")>0 && t[0].n==1;
  wd:=face_width("SAVE",10,HUD_FACE_BODY);
  r:=t[0].rects[0];#assert r.kind==UIT_TEXT && r.x0==10 && r.y1>40 && r.y0==30 && abs(r.x1-10-wd)<0.001 && wd>20;
  for i:0..<12 {#assert a[i]==b[i];}
  #assert ttext(t[..],UIT_NONE,a[..],0,"   ",10,40,10,k,"")>=0 && t[0].n==1;   // blank: nothing kept
}
line :: (out:[]f32,n:int,x:f32,y:f32,bx:f32,by:f32,k:f32,r:f32,g:f32,b:f32)->int {
  if lit(out,n,x,y,bx,by,0.6*k,1,0,r,g,b,0) { return n+6; } return n;
}
// The dungeon's darkness and its torches for the glade shader (everglade/scene/gpu/character-glade.coax
// cg_dungeon_light): its block and ceiling in u[60..64], then the nine torches nearest you, each
// x, y, z and a flickering brightness, in u[68..103]. Nothing when the scene has no dungeon.
dungeon_light :: (s:[]Creator,u:[]f32,x:f32,z:f32) {
  if s[0].dungeon_n!=dungeon.DG_CHUNKS || u.count<104 || (s[0].field && s[0].field_count>0) {return;}   // the open field has no dungeon
  if s[0].torch_n==0 {t:[dungeon.DG_TORCHES_MAX]dungeon.DgTorch;n:=dungeon.dg_torches(t[..]);for i:0..<n {f:=dungeon.dg_flame(t[i]);for k:0..<3 {s[0].torches[i*3+k]=f[k];}}
    // and the fire bowls, lights too
    for i:0..<dungeon.DG_PROPS {p:=dungeon.dg_prop(i);if p.piece!=dungeon.DG_P_FIRE || (n+1)*3>s[0].torches.count {continue;}s[0].torches[n*3]=p.x;s[0].torches[n*3+1]=0.9*p.scale;s[0].torches[n*3+2]=p.z;n+=1;}
    s[0].torch_n=n;}
  floor_y:=meadow.exp_height(-38,-54);
  u[60]=f32(dungeon.DG_X0);u[61]=dungeon.dg_south();u[62]=dungeon.dg_east();u[63]=f32(dungeon.DG_Z0);u[64]=floor_y+f32(dungeon.DG_HEIGHT)+0.1;
  best:[9]int;dist:[9]f32;m:=0;
  for i:0..<s[0].torch_n {dx:=s[0].torches[i*3]-x;dz:=s[0].torches[i*3+2]-z;d:=dx*dx+dz*dz;if d>30*30 {continue;}
    j:=ifx m<9 then m else 9;while j>0 && dist[j-1]>d {if j<9 {best[j]=best[j-1];dist[j]=dist[j-1];}j-=1;}if j<9 {best[j]=i;dist[j]=d;if m<9 {m+=1;}}}
  for k:0..<m {i:=best[k];o:=68+k*4;u[o]=s[0].torches[i*3];u[o+1]=floor_y+s[0].torches[i*3+1];u[o+2]=s[0].torches[i*3+2];
    u[o+3]=0.88+0.08*sin(s[0].clock*11.0+f32(i)*1.7)+0.04*sin(s[0].clock*23.0+f32(i)*0.6);}
}
frame :: (s:[]Creator,out:[]f32,u:[]f32,w:f32,h:f32,k:f32,dt:f32,still:bool)->int {
  if s[0].walk.on || s[0].profile_go {ensure(s);creator_layout(s,w,h,k);return walk_frame(s,out,u,w,h,k,dt,still);}
  if s[0].experimental {
    ensure(s);creator_layout(s,w,h,k);hostile.hostile_start(s[0].hostiles[..]);build_review_frame(s);if !still && dt>0 && dt<1 {s[0].clock+=dt;if !s[0].hostile_external {hostile.hostile_tick(s[0].hostiles[..],s[0].player_x,s[0].player_y,s[0].player_z,ifx dt>0.25 then 0.25 else dt);}}
    for i:0..<u.count {u[i]=0;}u[0]=w;u[1]=h;u[2]=s[0].clock;u[3]=1;u[4]=k;u[42]=ifx s[0].experimental then 0.0f32 else 1.0f32;if s[0].stage_on && s[0].shadow[0].on {s[0].shadow[0].glade=true;}u[10]=shadow_frame(s);u[11]=ifx !s[0].dev_animations then 1 else ifx s[0].preview_collapsed then 3 else 2;dungeon_light(s,u,s[0].player_x,s[0].player_z);
    if s[0].camera_room>=0 && !still && dt>0 && dt<1 {s[0].camera_room+=dt*4;}
    cc_view(s[0],u,w,h,k);for i:0..<16 {s[0].view[i]=u[16+i];}s[0].view_w=w;s[0].view_h=h;s[0].view_ok=true;dx:=u[16]-s[0].player_x;dy:=u[17]-(cc_ground(s[0].flat,s[0].player_x,s[0].player_z)+s[0].player_y+1.2);dz:=u[18]-s[0].player_z;s[0].camera_room=sqrt(dx*dx+dy*dy+dz*dz);if s[0].stage_on {u[11]=1;fps_count(s[0].fps[..],dt);return 0;}n:=ifx s[0].dev_animations then dev_panel(s[0],out,w,h,k) else 0;if !s[0].hostiles[0].shared {n=combat_overlay(s[0],out,u,n,w,k);}fps_count(s[0].fps[..],dt);if s[0].experimental && !s[0].walk.on {return n;}   // Experimental's HUD places them over its bar (everglade/zone-combat.coax xc_corner)
if !s[0].flat {n=coord_draw(s[0],out,n,w,h,k);}return ifx s[0].experimental then eg_fps(s[0].ui,s[0].fps[0],out,n,w,h,k) else fps_draw(s[0].ui,s[0].fps[0],out,n,w,h,k);
  }
  ensure(s); creator_layout(s,w,h,k); if !still && dt>0 && dt<1 { s[0].clock+=dt; }
  n:=0; white:=ink(k,0.91,0.92,0.9); dim:=ink(k,0.70,0.76,0.74); gold:=ink(k,0.83,0.69,0.43);
  n=text(out,n,"Character Create",(ifx s[0].mobile then 24.0f32 else 30.0f32)*k,(ifx s[0].mobile then 58.0f32 else 60.0f32)*k,(ifx s[0].mobile then 18 else 22)*k,white);
  if !s[0].mobile {n=line(out,n,30*k,78*k,334*k,78*k,k,gold.red,gold.green,gold.blue);}
  for i:0..<13 {
    b:=s[0].boxes[i]; cap:=10.0f32;
    if s[0].mobile {n=text(out,n,FIELD_NAMES[i],b.x0,b.y0-7*k,8*k,dim);}else {n=text(out,n,(ifx i==11 then "WEAR PART" else FIELD_NAMES[i]),b.x0,b.y0+22*k,7.4*k,ink(k,0.93,0.88,0.72));}
    selected:=s[0].focused==i;
    c:=ifx selected then gold else dim;
    n=line(out,n,b.x0,b.y1,b.x1,b.y1,k,c.red,c.green,c.blue);
    n=text(out,n,"<",b.x0+(ifx s[0].mobile then 4.0f32 else 116.0f32)*k,b.y0+cap*k+10*k,cap*k,c);
    value_cap:=ifx i==10 then (ifx s[0].mobile then 6.5f32 else 8.5f32) else cap;
    n=text(out,n,value(s[0],i),b.x0+(ifx s[0].mobile then 25.0f32 else 138.0f32)*k,b.y0+cap*k+10*k,value_cap*k,white);
    n=text(out,n,">",b.x1-14*k,b.y0+cap*k+10*k,cap*k,c);
    if i==4 || i==5 || i==7 || i==12 {
      rgb:=ifx i==4 then DYES[s[0].dye] else ifx i==5 then SKINS[s[0].skin] else ifx i==12 then EYES[s[0].eye_color] else HAIRS[s[0].hair_color];
      if lit(out,n,b.x0+(ifx s[0].mobile then 26.0f32 else 138.0f32)*k,b.y1-5*k,b.x1-26*k,b.y1-5*k,2*k,1,0,rgb[0],rgb[1],rgb[2],0) { n+=6; }
    }
  }
  for i:13..<15 { b:=s[0].boxes[i]; n=text(out,n,ifx i==13 then "RESET" else "SURPRISE ME",b.x0+10*k,b.y0+23*k,10*k,gold); }
  if s[0].mobile {b:=s[0].boxes[15];n=text(out,n,ifx s[0].pan_mode then "DRAG: PAN" else "DRAG: ROTATE",b.x0+10*k,b.y0+23*k,10*k,gold);}
  for i:16..<18 {b:=s[0].boxes[i];label:=ifx i==17 then "USE IN EVERGLADE" else ifx s[0].profile_pending then "SAVING..." else ifx s[0].profile_failed then "RETRY SAVE" else ifx s[0].profile_ok && s[0].profile_revision==s[0].revision then "PLAYER SAVED" else "SAVE PLAYER";n=text(out,n,label,b.x0+8*k,b.y0+23*k,9*k,gold);}
  if !s[0].mobile {n=text(out,n,"LEFT DRAG: ROTATE / RIGHT DRAG: PAN / SCROLL: ZOOM",w*0.5-230*k,h-77*k,9*k,ink(k,0.20,0.23,0.15));}
  for i:0..<u.count { u[i]=0; }
  u[0]=w;u[1]=h;u[2]=s[0].clock;u[3]=1;u[4]=k;u[10]=shadow_frame(s);u[11]=ifx s[0].scene_only then 1 else 0;
  cc_view(s[0],u,w,h,k);
  if s[0].scene_only {return 0;}
  return n;
}
#test "experimental mouse and touch look up while the camera stays above ground" {
 s:[1]Creator;s[0].experimental=true;s[0].dist=4;s[0].pitch=0.35;
 used:=mouse_pointer(s[..],700,400,0,1,0);used=mouse_pointer(s[..],700,0,1,1,-1);
 #assert s[0].pitch< -1.0;
 u:[40]f32;cc_view(s[0],u[..],1280,720,1);#assert u[21]>0.8 && u[17]>=meadow.exp_height(u[16],u[18])+0.19;
 s[0].dragging=false;s[0].pitch=0.35;used=pointer(s[..],700,400,0,2);used=pointer(s[..],700,0,1,2);#assert s[0].pitch< -1.0;
}
#test "experimental zoomed all the way in is first person: the camera at your eyes, no shoulder, your body not drawn" {
 s:[1]Creator;s[0].experimental=true;s[0].player_x=70;s[0].player_z=0;s[0].yaw=0.4;s[0].pitch=0.2;s[0].ml[0].shown=1;s[0].aim=0.7;
 s[0].source_n=76;for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=1;}}
 b:[1]figs.Bodies;b[0].ready=true;out:[44*24]f32;u:[40]f32;
 eye_y:=meadow.exp_height(70,0)+f32(fpcam.FP_EYE);sx:=sin(s[0].yaw);cz:=cos(s[0].yaw);
 wheel(s[..],-10000);#assert s[0].dist<f32(fpcam.FP_NEAR) && cc_first_person(s[0])==1 && cc_self_hidden(s[0]);
 cc_view(s[0],u[..],1280,720,1);
 // at the eye: its height, a hand's width ahead of the head's middle along the view, none of it to the side
 dx:=u[16]-70;dz:=u[18]-0;
 #assert abs(u[17]-eye_y)<0.001 && abs(dx*cz-dz*sx)<0.001 && abs(dx*sx+dz*cz+f32(fpcam.FP_AHEAD))<0.001;
 // still looking along the aim: the crosshair (the view's centre) is where the arrow goes
 #assert abs(u[20]+sx*cos(s[0].pitch))<0.001 && abs(u[21]+sin(s[0].pitch))<0.001 && u[23]==640;
 n:=scene(s[..],b[..],out[..]);#assert n>0 && b[0].self_n>0 && b[0].self_n<=n;
 s[0].aim=0;n=scene(s[..],b[..],out[..]);#assert b[0].self_n==n;   // a weapon carried at your side isn't drawn either
 s[0].aim=0.7;
 // zoomed out it is the over-the-shoulder view again, with your body drawn
 wheel(s[..],1000);#assert s[0].dist>f32(fpcam.FP_FAR) && cc_first_person(s[0])==0;
 cc_view(s[0],u[..],1280,720,1);dx=u[16]-70;dz=u[18]-0;#assert dx*cz-dz*sx>0.5 && dx*sx+dz*cz>1;
 n=scene(s[..],b[..],out[..]);#assert b[0].self_n==0;
 // in between it blends: the camera slides from the shoulder into the head
 last:f32=1000;for k:0..<9 {s[0].dist=f32(fpcam.FP_FAR)-f32(k)*(f32(fpcam.FP_FAR)-f32(fpcam.FP_NEAR))/8;cc_view(s[0],u[..],1280,720,1);
  dx=u[16]-70;dz=u[18]-0;side:=dx*cz-dz*sx;#assert side<=last+0.0001;last=side;}
 #assert abs(last)<0.001;
}
#test "experimental camera pulls in before a wall and keeps the shoulder clear" {
 wall:=[6]f32.[-2,0,1,2,3,1.2];
 blocked:=figs.cam_boom_walls(wall[..],0,1.2,0,[3]f32.[0,0,4]);
 #assert blocked>0.7 && blocked<0.81;
 clear:=figs.cam_boom_walls(wall[..],0,1.2,0,[3]f32.[0,0,-4]);#assert clear==4;
 side:=[6]f32.[0.8,0,-2,1.0,3,2];
 shoulder:=figs.cam_boom_walls(side[..],0,1.2,0,[3]f32.[2,0,0]);#assert shoulder>0.5 && shoulder<0.61;
}
#test "on the open field the camera's boom meets no village wall, only a zone's own box" {
 s:[1]Creator;s[0].experimental=true;s[0].field=true;s[0].player_x= -23;s[0].player_z= -25;s[0].yaw=0;s[0].pitch=0.1;s[0].dist=6;
 u:[40]f32;cc_view(s[0],u[..],1280,720,1);
 dx:=u[16]-s[0].player_x;dz:=u[18]-s[0].player_z;open:=sqrt(dx*dx+dz*dz);#assert open>5.5;
 g:=meadow.exp_height(u[16],u[18]);b:=[6]f32.[(s[0].player_x+u[16])*0.5-2,g-1,(s[0].player_z+u[18])*0.5-0.3,(s[0].player_x+u[16])*0.5+2,g+6,(s[0].player_z+u[18])*0.5+0.3];
 _:=wprops.props_set(s[0].props[..],b[..],1);cc_view(s[0],u[..],1280,720,1);
 dx=u[16]-s[0].player_x;dz=u[18]-s[0].player_z;#assert sqrt(dx*dx+dz*dz)<open-1.5;
}
#test "experimental camera follows the real village collision geometry" {
 s:[1]Creator;s[0].experimental=true;s[0].player_x= -23;s[0].player_z= -25;s[0].yaw=0;s[0].pitch=0.1;s[0].dist=6;
 near:[1]village.EvNear;village.ev_camera_near(near[..],s[0].player_x,s[0].player_z);
 #assert !near[0].overflow && near[0].wall_n>0;
 u:[40]f32;cc_view(s[0],u[..],1280,720,1);
 dx:=u[16]-s[0].player_x;dy:=u[17]-meadow.exp_height(s[0].player_x,s[0].player_z)-1.2;dz:=u[18]-s[0].player_z;
 length:=sqrt(dx*dx+dy*dy+dz*dz);#assert length<5.9;
 clear:=figs.cam_boom_walls(near[0].walls[0..<near[0].wall_n*6],s[0].player_x,1.2,s[0].player_z,[3]f32.[dx,dy,dz]);#assert clear+0.001>=length;
}
#test "experimental camera stays above uneven ground even when walls pull it in" #steps 200000000 {
 s:[1]Creator;s[0].experimental=true;s[0].dist=6;
 for point:[4][2]f32.[[2]f32.[-32,-44.4],[2]f32.[-35.5,-48],[2]f32.[-28.5,-50],[2]f32.[-22,-40]] {s[0].player_x=point[0];s[0].player_z=point[1];
  for yi:0..<8 {s[0].yaw=f32(yi)*0.785398;for pi:0..<5 {s[0].pitch=-1.2+f32(pi)*0.6;for ri:0..<2 {s[0].camera_room=0.4+f32(ri)*1.2;u:[40]f32;cc_view(s[0],u[..],1280,720,1);#assert u[17]>=meadow.exp_height(u[16],u[18])+0.19;}}}
 }
}
#test "experimental camera stays close as it eases back into open space" {
 s:[1]Creator;s[0].experimental=true;s[0].camera_room=0.8;s[0].dist=4;s[0].yaw=0;s[0].pitch=0.1;s[0].player_x=70;s[0].player_z=0;
 u:[40]f32;cc_view(s[0],u[..],1280,720,1);
 dx:=u[16]-s[0].player_x;dy:=u[17]-meadow.exp_height(s[0].player_x,s[0].player_z)-1.2;dz:=u[18]-s[0].player_z;
 #assert abs(sqrt(dx*dx+dy*dy+dz*dz)-0.8)<0.001;
}
// How far into first person the camera is, 0 (behind you) to 1 (your eyes): the zoom, eased.
cc_first_person :: (s:Creator)->f32 { if !s.experimental || s.walk.on {return 0;} return fpcam.fp_share(s.dist); }
// Whether your own body is left undrawn: the camera is in your head.
cc_self_hidden :: (s:Creator)->bool { return s.stage_on || fpcam.fp_hidden(cc_first_person(s)); }   // a ?stage= setup films the scene, not you
// A ?stage= setup (apps/openagents-web/old/experimental/fivelab.coax lab_stage, #13107) sets the shot and the day each
// frame: the camera is its eye and look, the frame draws no HUD, and the glade's shadow is redrawn
// every frame so it follows the sun (everglade/zone.coax zone_light writes that day's light).
stage_set :: (s:[]Creator,v:trk.CamView,day:f32) {s[0].stage_on=true;s[0].stage_view=v;s[0].stage_day=day;}
stage_camera :: (s:Creator,u:[]f32,w:f32,h:f32) {
  v:=s.stage_view;fx:=v.lx-v.ex;fy:=v.ly-v.ey;fz:=v.lz-v.ez;l:=sqrt(fx*fx+fy*fy+fz*fz);
  if !(l>0.0001) {fx=0;fy=0;fz= -1;l=1;}fx/=l;fy/=l;fz/=l;
  rx:= -fz;rz:=fx;rl:=sqrt(rx*rx+rz*rz);if !(rl>0.0001) {rx=1;rz=0;rl=1;}rx/=rl;rz/=rl;
  u[16]=v.ex;u[17]=v.ey;u[18]=v.ez;u[19]=h*0.89;
  u[20]=fx;u[21]=fy;u[22]=fz;u[23]=w*0.5;
  u[24]=rx;u[25]=0;u[26]=rz;u[27]=h*0.5;
  u[28]= -rz*fy;u[29]=rz*fx-rx*fz;u[30]=rx*fy;
  u[32]= -0.45;u[33]=0.78;u[34]= -0.42;
}
#test "a stage's camera looks from its eye at its look, level and upright" {
  s:Creator;s.stage_on=true;s.stage_view=trk.CamView.{ex=0,ey=2,ez=10,lx=0,ly=2,lz=0};u:[40]f32;cc_view(s,u[..],1920,1080,1);
  #assert u[16]==0 && u[17]==2 && u[18]==10 && u[22]== -1 && u[21]==0 && u[29]==1 && abs(u[24])==1 && u[19]==1080*0.89f32;
  s.stage_view=trk.CamView.{ex=3,ey=12,ez=1,lx=0,ly=0,lz=0};cc_view(s,u[..],1920,1080,1);
  #assert u[21]< -0.9 && u[25]==0 && u[29]>0 && abs(u[20]*u[24]+u[21]*u[25]+u[22]*u[26])<0.0001 && abs(u[20]*u[28]+u[21]*u[29]+u[22]*u[30])<0.0001;
}
// The camera's uniforms: a ?stage= setup's eye and look; else Experimental's world through the Metaverse Engine's
// over-the-shoulder boom (metaverse-engine/cam/boom.coax), before the village's walls, this meadow's land and
// the eye's last distance; the studio through the Metaverse Engine's studio camera (metaverse-engine/cam/studio.coax), held
// over the glade.
cc_view :: (s:Creator,u:[]f32,w:f32,h:f32,k:f32) {
  if s.stage_on {stage_camera(s,u,w,h);return;}
  if s.experimental {
    ck:=ifx s.cam_k>1 then s.cam_k else 1.0f32;   // a bigger body's camera: further out and higher (everglade/zone-shapechange.coax)
    target:=cc_ground(s.flat,s.player_x,s.player_z)+s.player_y+1.2+(ck-1)*1.6;
    cy:=cos(s.pitch); sy:=sin(s.pitch); sx:=sin(s.yaw+s.orbit); cz:=cos(s.yaw+s.orbit);
    ride:=egm.eg_ride_cam(s.mounts[0],s.clock);target+=egm.eg_ride_cam_up(s.mounts[0])*ride;   // riding, the camera pulls back and up to see the horse
    b:=figs.cam_boom(figs.CamBoomIn.{yaw=s.yaw+s.orbit,pitch=s.pitch,dist=s.dist*ck+egm.eg_ride_cam_back(s.mounts[0])*ride,aim=s.aim,look=s.ml[0].shown,first=cc_first_person(s)});
    target+=b.lift;boom:=b.boom;
    // the open field has no village for the boom to meet: only the zone's own standing things (metaverse-engine/world/props.coax)
    near:[1]village.EvNear;if s.field {near[0].wall_n=wprops.props_near(s.props[0],s.player_x,s.player_z,12,cc_ground(s.flat,s.player_x,s.player_z),near[0].walls[..],0);} else {village.ev_camera_near(near[..],s.player_x,s.player_z);}room:=figs.cam_boom_walls(near[0].walls[0..<near[0].wall_n*6],s.player_x,s.player_y+1.2,s.player_z,boom);
    sw:[1]figs.CamSweep;sw[0]=figs.cam_sweep(s.player_x,target,s.player_z,boom,f32(figs.CAM_BOOM_CLEAR));
    while !sw[0].done {p:=figs.cam_sweep_at(sw[0]);figs.cam_sweep_feed(sw[..],cc_ground(s.flat,p[0],p[1]));}
    if sw[0].room<room {room=sw[0].room;}if s.camera_room>=0 && s.camera_room<room {room=s.camera_room;}share:=figs.cam_boom_share(b.length,room);
    u[16]=s.player_x+boom[0]*share;u[17]=target+boom[1]*share;u[18]=s.player_z+boom[2]*share;u[19]=h*0.89*(1+0.18*s.aim);
    u[20]= -sx*cy;u[21]= -sy;u[22]= -cz*cy;u[23]=w*0.5;
    u[24]=cz;u[25]=0;u[26]= -sx;u[27]=h*0.48;
    u[28]= -sx*sy;u[29]=cy;u[30]= -cz*sy;
    u[32]= -0.45;u[33]=0.78;u[34]= -0.42;return;
  }
  // A steady studio camera; dragging turns the figure, the wheel changes distance.
  st:=figs.cam_studio(figs.v3(0,0,0),s.dist,s.pitch,s.pan_x,s.pan_y);
  shot:=figs.cam_studio_shot(st,glade.cg_height(st.eye.x,st.eye.z)+0.28);
  focal:=ifx s.mobile then (h-624*k)*1.3 else h*0.89;
  u[16]=shot.eye.x;u[17]=shot.eye.y;u[18]=shot.eye.z;u[19]=focal;
  u[20]=0;u[21]=st.dir.y;u[22]=st.dir.z;u[23]=w*0.5;
  u[24]=1;u[25]=0;u[26]=0;u[27]=ifx s.mobile then (h-384*k)*0.5 else h*0.48;
  u[28]=0;u[29]=-st.dir.z;u[30]=st.dir.y;
  u[32]=-0.45;u[33]=0.78;u[34]=-0.42;
}
pointer :: (s:[]Creator,x:f32,y:f32,phase:int,id:int)->bool {
  if s[0].walk.on {return true;}
  if s[0].experimental {
    if dev_pointer(s,x,y,phase) {return true;}
    if phase==0 {mlook.ml_press(s[0].ml[..],ifx s[0].ml[0].touch then 1 else 0);s[0].dragging=true;s[0].drag_id=id;s[0].dx=x;s[0].dy=y;}
    else if id==s[0].drag_id && phase==1 && s[0].dragging {s[0].yaw-=(x-s[0].dx)*0.0055;s[0].pitch=cc_clamp(s[0].pitch+(y-s[0].dy)*0.0055,-1.2,1.2);s[0].dx=x;s[0].dy=y;}
    else if phase==2 || phase==3 {s[0].dragging=false;}return true;
  }
  if phase==0 {
    for i:0..<18 { if i==15 && !s[0].mobile {continue;}if inside(s[0].boxes[i],x,y) { s[0].down=i; s[0].drag_id=id; return true; } }
    s[0].drag_pan=s[0].pan_mode;s[0].dragging=true;s[0].drag_id=id;s[0].dx=x;s[0].dy=y;return true;
  }
  if id!=s[0].drag_id { return true; }
  if phase==1 && s[0].dragging { if s[0].drag_pan {
      focal:=ifx s[0].mobile then (s[0].height-624*s[0].scale)*1.3 else s[0].height*0.89;
      units:=s[0].dist/(ifx focal>1 then focal else 1);
      s[0].pan_x=cc_clamp(s[0].pan_x-(x-s[0].dx)*units,-2,2);
      s[0].pan_y=cc_clamp(s[0].pan_y+(y-s[0].dy)*units,-2,2);
    } else {s[0].yaw+=(x-s[0].dx)*0.008/s[0].scale; s[0].pitch=cc_clamp(s[0].pitch+(y-s[0].dy)*0.003/s[0].scale,-0.2,0.6); } s[0].dx=x;s[0].dy=y;return true; }
  if phase==2 || phase==3 {
    i:=s[0].down;s[0].down=-1;s[0].dragging=false;
    if phase==2 && i>=0 && inside(s[0].boxes[i],x,y) {
      if i<13 { change(s,i,ifx x<s[0].boxes[i].x0+(ifx s[0].mobile then 22.0f32 else 136.0f32)*s[0].scale then -1 else 1); }
      else if i==13 { reset(s); }
      else if i==16 || i==17 {request_player(s,i==17);}
      else if i==15 {s[0].pan_mode=!s[0].pan_mode;}
      else { surprise(s); }
    }
  }
  return true;
}
key :: (s:[]Creator,k:int)->bool {
  if s[0].walk.on {return true;}
  if k=='p' || k=='P' {s[0].pan_mode=!s[0].pan_mode;return true;}
  if k==-15 { s[0].focused=(s[0].focused+1)%13;return true; }
  if k==-4 || k==-5 { change(s,s[0].focused,ifx k==-4 then -1 else 1);return true; }
  if k==' ' { change(s,9,1);return true; }
  return false;
}
wheel :: (s:[]Creator,dy:f32) { if s[0].walk.on {return;} if s[0].dev_animations && s[0].preview_hover {dev_scroll(s,dy);return;} s[0].dist=cc_clamp(s[0].dist+dy*0.003,0.65,6); }
// Page identity is a bounded host fact, not a search over arbitrary message content.
page_path :: (facts:string,path:string)->bool {
  at:=0;
  while at<facts.count { e:=at;while e<facts.count && facts[e]!='\n' { e+=1; } fact:=facts[at..<e];at=e+1;
    if fact.count>=4 && fact[0..<4]=="url=" { url:=fact[4..<fact.count];start:=0;for j:0..<url.count-2 {if url[j..<j+3]=="://" {start=j+3;while start<url.count && url[start]!='/' {start+=1;} break;}}end:=start;while end<url.count && url[end]!='?' && url[end]!='#' { end+=1; } return url[start..<end]==path; }
  }
  return false;
}

page :: (facts:string)->bool {return page_path(facts,"/worlds/character-creator") || page_path(facts,"/worlds/character-creator/");}
dev_local :: (facts:string)->bool {
 at:=0;while at<facts.count {e:=at;while e<facts.count && facts[e]!='\n' {e+=1;}fact:=facts[at..<e];at=e+1;
  for host:[4]string.["url=http://localhost", "url=https://localhost", "url=http://127.0.0.1", "url=https://127.0.0.1"] {
   if fact.count>host.count && fact[0..<host.count]==host && (fact[host.count]==':' || fact[host.count]=='/') {return true;}
  }}return false;
}
experimental_page :: (facts:string)->bool {return page_path(facts,"/worlds/everglade-experimental") || page_path(facts,"/worlds/everglade-experimental/");}

// The ground's height under (x, z): the meadow's, or 0 everywhere in a level zone (Creator.level).
cc_ground :: (level:bool,x:f32,z:f32)->f32 { if level {return 0;} return meadow.exp_height(x,z); }
#test "a level zone's ground is 0 everywhere; the meadow's is its own" {
 #assert cc_ground(true,30,-40)==0 && cc_ground(false,30,-40)==meadow.exp_height(30,-40);
}
cc_clamp :: (v:f32,a:f32,b:f32)->f32 { if v<a {return a;} if v>b {return b;} return v; }

lit :: (out: [] f32, at: int, ax: f32, ay: f32, bx: f32, by: f32, core: f32, light: f32, glow: f32,
        red: f32, green: f32, blue: f32, mode: f32) -> bool {
  if at < 0 || (at + 6) * VERTEX_FLOATS > out.count { return false; }
  dx := bx - ax; dy := by - ay;
  size := sqrt(dx * dx + dy * dy);
  if size <= 0 { size = 0.01; dx = 0.01; dy = 0; }
  ux := dx / size; uy := dy / size;
  nx := -uy; ny := ux;
  r := glow + core;
  a := [6] f32.[-r, size + r, size + r, -r, size + r, -r];
  c := [6] f32.[-r, -r, r, -r, r, r];
  for v: 0..<6 {
    o := (at + v) * VERTEX_FLOATS;
    out[o] = ax + ux * a[v] + nx * c[v];
    out[o + 1] = ay + uy * a[v] + ny * c[v];
    out[o + 2] = a[v]; out[o + 3] = c[v];
    out[o + 4] = size; out[o + 5] = core; out[o + 6] = light; out[o + 7] = glow;
    out[o + 8] = red; out[o + 9] = green; out[o + 10] = blue; out[o + 11] = mode;
    for e: 12..<16 { out[o + e] = 0; }
  }
  return true;
}

preset :: (s:[]Creator,family:int) {
  for i:0..<40 { s[0].worn[i]=false; }
  for i:0..<8 {p:=appearance.PART_PRESETS[family][i];if p>=0 && (!s[0].female || appearance.PART_NAMES[p].count>0) {s[0].worn[p]=true;}}
  s[0].hood=false;s[0].configured=true;
}
ensure :: (s:[]Creator) {if !s[0].configured {preset(s,s[0].outfit);}}
reset :: (s:[]Creator) { s[0].pan_x=0;s[0].pan_y=0;s[0].pan_mode=false;s[0].piece=18;s[0].female=false;s[0].outfit=2;s[0].hood=false;s[0].hair=0;s[0].beard=false;s[0].dye=8;s[0].skin=1;s[0].hair_color=0;s[0].eye_color=0;s[0].variant=0;s[0].pose=0;s[0].pose_at=s[0].clock;s[0].yaw=-0.22;s[0].pitch=0.1;s[0].dist=3.1;preset(s,2);s[0].revision+=1; }
catalog :: (s:[]Creator,t:string) {
  egm.eg_mounts_catalog(s[0].mounts[..],t);xh_place(s);
  s[0].build_n=0;s[0].source_n=0;s[0].glade_count=0;s[0].zero_ad_count=0;s[0].grass_groups=0;s[0].animal_n=0;s[0].monster_n=0;s[0].dungeon_n=0;for i:0..<8 {s[0].dungeon_count[i]=0;}s[0].npc_n=[2]int.[0,0];for k:0..<2 {for i:0..<48 {s[0].npc_count[k][i]=0;}}for i:0..<48 {s[0].monster_count[i]=0;}for i:0..<10 {s[0].animal_count[i]=0;}for i:0..<7 {s[0].weapon_count[i]=0;}
  for i:0..<11 {s[0].familiar_count[i]=0;}
  s[0].dragon_n=0;s[0].dragon_count=0;s[0].field_count=0;for i:0..<14 {s[0].kit_count[i]=0;}
  for i:0..<80 {s[0].source_count[i]=0;}
  at:=0;
  while at<t.count {e:=at;while e<t.count && t[e]!='\n' {e+=1;} row:=t[at..<e];at=e+1;
    if row.count<9 || row[0..<2]!="C " {continue;}
    ne:=figs.bd_word_end(row,2);name:=row[2..<ne];
    if name=="glade/environment" {
      p:=ne;s[0].glade_first=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].glade_count=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);s[0].glade_word=figs.bd_whole_at(row,p);
    }
    if name.count>10 && name[0..<10]=="glade/pile" {i:=figs.bd_whole_at(name,10);if i>=0 && i<hw.HW_STOCKS {p:=ne;s[0].pile_first[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].pile_count[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);s[0].pile_word=figs.bd_whole_at(row,p);if s[0].pile_count[i]>0 {s[0].pile_n+=1;}}}
    if name=="glade/range" {p:=ne;s[0].range_first=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].range_count=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);s[0].range_word=figs.bd_whole_at(row,p);}
    if name.count>11 && name[0..<11]=="glade/build" {i:=figs.bd_whole_at(name,11);if i>=0 && i<hw.HW_PARTS {p:=ne;s[0].build_first[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].build_count[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);s[0].build_word=figs.bd_whole_at(row,p);if s[0].build_count[i]>0 {s[0].build_n+=1;}}}
    if name=="glade/0ad" {p:=ne;s[0].zero_ad_first=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].zero_ad_count=figs.bd_whole_at(row,p);}
    if name.count>14 && name[0..<14]=="glade/familiar" {
      i:=figs.bd_whole_at(name,14);
      if i>=0 && i<11 {
        s[0].familiar_first[i]=figs.bd_whole_at(row,ne);
        p:=figs.bd_word_end(row,ne+1);
        s[0].familiar_count[i]=figs.bd_whole_at(row,p);
        p=figs.bd_word_end(row,p+1);
        p=figs.bd_word_end(row,p+1);
        s[0].familiar_word[i]=figs.bd_whole_at(row,p);
      }
    }
    // The dragon's frames lie one after another, the same size and vertex word (dragon_pack.coax), so
    // the Creator keeps frame 0's place and the size: frame k starts at dragon_first + k * dragon_count.
    // A frame out of that line leaves the dragon undrawn (dragon_n never reaches DR_TOTAL).
    if name.count>12 && name[0..<12]=="glade/dragon" {
      i:=figs.bd_whole_at(name,12);
      if i>=0 && i<dragon.DR_TOTAL && s[0].dragon_n>=0 {
        first:=figs.bd_whole_at(row,ne);p:=figs.bd_word_end(row,ne+1);count:=figs.bd_whole_at(row,p);
        p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);word:=figs.bd_whole_at(row,p);
        if s[0].dragon_n==0 {s[0].dragon_first=first-i*count;s[0].dragon_count=count;s[0].dragon_word=word;}
        if count>0 && count==s[0].dragon_count && word==s[0].dragon_word && first==s[0].dragon_first+i*count {s[0].dragon_n+=1;}else{s[0].dragon_n= -1;}
      }
    }
    // The open field (meadow_pack.coax): Everglade II's meadow, drawn in place of the glade where
    // the page asks for the field (Creator.field): its ground, and each kit the GPU scatters over it.
    if name=="glade/meadow" {
      p:=ne;s[0].field_first=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].field_count=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);s[0].field_word=figs.bd_whole_at(row,p);
    }
    if name.count>15 && name[0..<15]=="glade/meadowkit" {
      j:=figs.bd_whole_at(name,15)-20;if j>=0 && j<14 {p:=ne;s[0].kit_first[j]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].kit_count[j]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);s[0].kit_word[j]=figs.bd_whole_at(row,p);}
    }
    if name.count>12 && name[0..<12]=="glade/animal" {
      i:=figs.bd_whole_at(name,12);if i>=0 && i<10 {p:=ne;s[0].animal_first[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].animal_count[i]=figs.bd_whole_at(row,p);if s[0].animal_count[i]>0 {s[0].animal_n+=1;}}
    }
    if name.count>12 && name[0..<12]=="glade/weapon" {
      i:=figs.bd_whole_at(name,12);if i>=0 && i<7 {p:=ne;s[0].weapon_first[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].weapon_count[i]=figs.bd_whole_at(row,p);}
    }
    if name.count>13 && name[0..<13]=="glade/dungeon" {
      i:=figs.bd_whole_at(name,13);if i>=0 && i<dungeon.DG_CHUNKS {p:=ne;s[0].dungeon_first[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].dungeon_count[i]=figs.bd_whole_at(row,p);if s[0].dungeon_count[i]>0 {s[0].dungeon_n+=1;}}
    }
    if name.count>13 && name[0..<13]=="glade/monster" {
      i:=figs.bd_whole_at(name,13);if i>=0 && i<48 {p:=ne;s[0].monster_first[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].monster_count[i]=figs.bd_whole_at(row,p);if s[0].monster_count[i]>0 {s[0].monster_n+=1;}}
    }
    if (name.count>9 && name[0..<9]=="glade/imp") || (name.count>13 && name[0..<13]=="glade/gremlin") {
      kind:=ifx name[6]=='i' then 0 else 1;offset:=ifx kind==0 then 9 else 13;i:=figs.bd_whole_at(name,offset);if i>=0 && i<48 {p:=ne;s[0].npc_first[kind][i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);s[0].npc_count[kind][i]=figs.bd_whole_at(row,p);if s[0].npc_count[kind][i]>0 {s[0].npc_n[kind]+=1;}}
    }
    if name.count>=11 && name[0..<11]=="glade/grass" && s[0].grass_groups<3 {
      g:GrassDraw;p:=ne;g.first=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);g.count=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);g.word=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);g.n=figs.bd_whole_at(row,p);
      // "glade/grassK": the pack's seeds are sorted into cells when their count is the baked one
      k:=ifx name.count==12 then cast(int)name[11]-cast(int)'0' else -1;if k>=0 && k<ggrid.EXG_GROUPS && g.n==gbaked.EXG_BAKED_N[k] {g.group=k;}
      if g.n>=1 && g.n<=65535 && g.count>=3 {s[0].grass[s[0].grass_groups]=g;s[0].grass_groups+=1;}
    }
    for i:0..<80 {if name==appearance.PART_NAMES[i] {
      p:=ne;s[0].source_first[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);
      s[0].source_count[i]=figs.bd_whole_at(row,p);p=figs.bd_word_end(row,p+1);p=figs.bd_word_end(row,p+1);
      s[0].source_word[i]=figs.bd_whole_at(row,p);
    }}
  }
  for i:0..<80 {if s[0].source_count[i]>0 {s[0].source_n+=1;}}
}
#test "creator available garments are selectable on both sexes and presets cover four outfits" {
  s:[1]Creator;ensure(s[..]);
  for family:0..<4 {preset(s[..],family);n:=0;for i:0..<40 {if s[0].worn[i] {n+=1;}}#assert n>=1 && n<=8;}
  for i:0..<40 {if !available(s[0],i) {continue;}s[0].piece=i;s[0].worn[i]=false;change(s[..],11,1);#assert s[0].worn[i];#assert appearance.PART_NAMES[i+40].count>8;}
}

#test "creator page identity accepts absolute host URLs and rejects other routes" { #assert page("url=http://127.0.0.1:8812/worlds/character-creator?x=1\n");#assert page("url=/worlds/character-creator/\n");#assert !page("url=https://openagents.com/worlds/5e-lab?next=/worlds/character-creator\n"); }

probe :: (s:[]Creator,f:int)->int {
  if f==0 {return s[0].source_n;} if f==1 {return s[0].outfit;}if f==2 {return ifx s[0].female then 1 else 0;}
  if f==3 {return s[0].variant;}if f==4 {return s[0].dye;}if f==5 {return s[0].skin;}if f==6 {return s[0].pose;}
  if f==7 {return s[0].piece;}if f==8 {return ifx s[0].worn[s[0].piece] then 1 else 0;}if f==9 {return s[0].revision;}if f==10 {return s[0].eye_color;}if f==11 {return int(s[0].pan_x*1000);}if f==12 {return int(s[0].pan_y*1000);}if f==13 {return int(s[0].yaw*1000);}if f==18 {return ifx s[0].profile_ok then 1 else 0;}if f==19 {return ifx s[0].profile_failed then 1 else 0;}if f==14 {return s[0].glade_count;}
  if f==29 && s[0].experimental {return s[0].preview_clip;}
  if f==30 && s[0].experimental {return s[0].preview_scroll;}
  if f==28 && s[0].experimental {return experimental_clip(s);}
  if f==26 && s[0].experimental {return int(s[0].player_x*1000);}
  if f==27 && s[0].experimental {return int(s[0].player_z*1000);}
  if f>=20 && f<=25 {return walk_probe(s[0],f);}
  return -1;
}
append :: (out:[]u8,at:int,t:string)->int {for i:0..<t.count {out[at+i]=t[i];}return at+t.count;}
#test "creator catalog resolves 76 source meshes and every worn part reaches a bounded GPU draw" {
  s:[1]Creator;b:[1]figs.Bodies;buf:[16384]u8;at:=0;
  for i:0..<80 {if appearance.PART_NAMES[i].count>0 {at=append(buf[..],at,"C ");at=append(buf[..],at,appearance.PART_NAMES[i]);at=append(buf[..],at," 100 300 7 600 100 65\n");}}
  catalog(s[..],cast(string)buf[0..<at]);#assert s[0].source_n==76;
  for i:0..<80 {if appearance.PART_NAMES[i].count>0 {#assert s[0].source_first[i]==100 && s[0].source_count[i]==300 && s[0].source_word[i]==600;}}
  b[0].ready=true;for i:0..<39 {s[0].worn[i]=true;}out:[44*24]f32;
  for body:0..<2 {s[0].female=body==1;n:=scene(s[..],b[..],out[..]);#assert n==26-body*1 && b[0].draw_n==n;
    for i:0..<n {#assert b[0].draws[i*4+2]==cast(u32)i && b[0].draws[i*4+3]==1;}
  }
}

// Versioned appearance only: no asset offsets, clocks or borrowed renderer state are persisted.
to_appearance :: (s:Creator)->appearance.CharacterAppearance {a:appearance.CharacterAppearance;a.configured=s.configured;a.female=s.female;a.worn=s.worn;a.piece=s.piece;a.outfit=s.outfit;a.hood=s.hood;a.hair=s.hair;a.beard=s.beard;a.dye=s.dye;a.skin=s.skin;a.hair_color=s.hair_color;a.eye_color=s.eye_color;a.variant=s.variant;a.pose=s.pose;a.source_first=s.source_first;a.source_count=s.source_count;a.source_word=s.source_word;a.source_n=s.source_n;a.klass=s.klass;a.level=s.level;return a;}
save :: (s:Creator,out:[]u8)->int {return appearance.ca_save(to_appearance(s),out);}
restore :: (s:[]Creator,t:string)->bool {a:[1]appearance.CharacterAppearance;a[0]=to_appearance(s[0]);if !appearance.ca_restore(a[..],t) {return false;}s[0].configured=a[0].configured;s[0].female=a[0].female;s[0].worn=a[0].worn;s[0].piece=a[0].piece;s[0].outfit=a[0].outfit;s[0].hood=a[0].hood;s[0].hair=a[0].hair;s[0].beard=a[0].beard;s[0].dye=a[0].dye;s[0].skin=a[0].skin;s[0].hair_color=a[0].hair_color;s[0].eye_color=a[0].eye_color;s[0].variant=a[0].variant;s[0].pose=a[0].pose;s[0].source_first=a[0].source_first;s[0].source_count=a[0].source_count;s[0].source_word=a[0].source_word;s[0].source_n=a[0].source_n;s[0].klass=a[0].klass;s[0].level=a[0].level;s[0].pose_at=s[0].clock;s[0].revision+=1;s[0].saved=s[0].revision;return true;}
#test "creator appearance save round trips and malformed saves preserve the live choices" {
  a:[1]Creator;ensure(a[..]);change(a[..],1,1);change(a[..],3,2);change(a[..],4,3);a[0].piece=38;change(a[..],11,1);
  out:[64]u8;n:=save(a[0],out[..]);b:[1]Creator;ok:=restore(b[..],cast(string)out[0..<n]);#assert ok && b[0].outfit==a[0].outfit && b[0].variant==2 && b[0].piece==38 && b[0].worn[38]==a[0].worn[38];
  for i:0..<56 {old:=out[i];out[i]='x';before:=b[0].revision;#assert !restore(b[..],cast(string)out[0..<n]) && b[0].revision==before;out[i]=old;}
  #assert !restore(b[..],cast(string)out[0..<53]);
}

available :: (s:Creator,p:int)->bool {return p>=0 && p<40 && appearance.PART_SELECTABLE[p] && appearance.PART_NAMES[p+(ifx s.female then 0 else 40)]!="";}
catalog_ready :: (s:Creator)->bool {for i:0..<80 {if appearance.PART_NAMES[i]!="" && s.source_count[i]<=0 {return false;}}return true;}


#test "creator hood keeps beard in actual draw list and crown cannot be worn" {
  s:[1]Creator;ensure(s[..]);change(s[..],8,1);change(s[..],2,1);
  #assert s[0].beard && s[0].hood && look(s[0]).extra==figs.BP_BEARD;
  b:[1]figs.Bodies;b[0].ready=true;s[0].source_n=76;for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=1;}}b[0].part_word[figs.BP_BEARD]=12345;
  out:[44*24]f32;n:=scene(s[..],b[..],out[..]);found:=false;
  for i:0..<n {if out[i*24+7]==12345 {found=true;}}#assert found;
  s[0].piece=15;change(s[..],10,1);#assert s[0].piece==17;
  s[0].piece=16;change(s[..],11,1);#assert !s[0].worn[16] && !available(s[0],16);
  bytes:[64]u8;s[0].worn[16]=true;size:=save(s[0],bytes[..]);t:[1]Creator;
  #assert restore(t[..],cast(string)bytes[0..<size]) && !t[0].worn[16] && t[0].beard && t[0].hood;
}
