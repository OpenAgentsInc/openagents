  #assert appearance.PART_IDS[59]=="quaternius/fantasy/male-peasant-body";
  #assert !appearance.PART_SELECTABLE[16] && !appearance.PART_SELECTABLE[39];
  s:[1]Creator;b:[65536]u8;n:=0;
  for i:0..<80 {if appearance.PART_NAMES[i]!="" {n=append(b[..],n,"C ");n=append(b[..],n,appearance.PART_NAMES[i]);n=append(b[..],n," 100 300 7 600 100 65\n");}}
  catalog(s[..],cast(string)b[0..<n]);#assert catalog_ready(s[0]);
  s[0].source_count[19]=0;#assert !catalog_ready(s[0]);
  s[0].worn[19]=true;bytes:[64]u8;size:=save(s[0],bytes[..]);t:[1]Creator;
  #assert restore(t[..],cast(string)bytes[0..<size]) && t[0].worn[19];
}

#test "creator glade catalog keeps scenery separate from wardrobe and saved appearance" {
  s:[1]Creator;catalog(s[..],"C glade/environment 9 12 250 100 8 0\n");
  #assert s[0].glade_first==9 && s[0].glade_count==12 && s[0].glade_word==100 && s[0].source_n==0;
  // A scenery draw needs no animation palette and never receives the eye-color marker.
  ensure(s[..]);for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}
  b:[1]figs.Bodies;b[0].ready=true;out:[44*24]f32;n:=scene(s[..],b[..],out[..]);
  #assert n>1 && out[(n-1)*24+15]==16 && out[(n-1)*24+7]==100;
  #assert b[0].draws[(n-1)*4]==9 && b[0].draws[(n-1)*4+1]==12;
  saved:[64]u8;size:=save(s[0],saved[..]);t:[1]Creator;
  #assert restore(t[..],cast(string)saved[0..<size]) && t[0].glade_count==0;
  catalog(s[..],"C other 0 3 1 0 3 65\n");#assert s[0].glade_count==0;
}

#test "creator reference camera places the horizon near three fifths and keeps face inspection" {
 s:[1]Creator;u:[104]f32;out:[64000]f32;
 n:=frame(s[..],out[..],u[..],1920,1080,1,0,true);
 horizon:=u[27]+u[21]*u[19]/u[29];#assert horizon>1080*0.56 && horizon<1080*0.64;
 s[0].dist=0.65;n=frame(s[..],out[..],u[..],1920,1080,1,0,true);#assert u[21]<0;
}
#test "creator scene capture is a transient exact query flag" {
 #assert scene_capture("url=http://127.0.0.1/worlds/character-creator?scene=1\n");
 #assert !scene_capture("url=http://127.0.0.1/worlds/character-creator?scene=10\n");
 #assert !scene_capture("url=http://127.0.0.1/worlds/character-creator?scene=0\n");
}
// ?stage=build-cottage (#13106's review clip): a wattle-and-daub cottage goes up from its bare
// site to its last stage, two seconds a stage, starting a second in, with no HUD (fivelab.coax).
build_review_page :: (facts:string)->bool {
 want:="stage=build-cottage";if facts.count<want.count+1 {return false;}
 for i:1..<facts.count-want.count+1 {if (facts[i-1]=='?' || facts[i-1]=='&') && facts[i..<i+want.count]==want {e:=i+want.count;if e==facts.count || facts[e]=='\n' || facts[e]=='&' || facts[e]=='#' {return true;}}}return false;
}
BUILD_REVIEW_AT :: [2]f32.[-60,-38];   // the open grass south of the glade's village, where the time-lapses stand (fivelab.coax LAB_STAGE_X)
build_review_frame :: (s:[]Creator) {
 if !s[0].build_review {return;}
 if s[0].build_t0<0 {s[0].clock=0;s[0].build_t0=0;}   // from 0, so the builder's trips land on the same frames every recording
 f:=building.BuildingFrame.{x=BUILD_REVIEW_AT[0],z=BUILD_REVIEW_AT[1],turn=2};g:=meadow.exp_height(f.x,f.z);
 // the player stands off the front-left corner; the camera looks on from the front right, drifting a little
 p:=building.building_point(f,-3.2,4.6);s[0].player_x=p[0];s[0].player_z=p[1];
 t:=s[0].clock-s[0].build_t0;ex:=4.6+0.06*t;ez:=8.6-0.1*t;
 e:=building.building_point(f,ex,ez);l:=building.building_point(f,0,0.2);
 stage_set(s,trk.CamView.{ex=e[0],ey=g+3.3,ez=e[1],lx=l[0],ly=g+1.2,lz=l[1]},0.42);
 build_site_set(s,0,hw.HW_COTTAGE,f,g,(t-1)/2);
}
#test "the build review page is asked for by its stage and nothing else" {
 #assert build_review_page("url=http://127.0.0.1:8800/worlds/everglade-experimental?stage=build-cottage\n") && !build_review_page("url=http://x/worlds/everglade-experimental?stage=build-cottages\n");
}
scene_capture :: (facts:string)->bool {
 if facts.count<8 {return false;}
 for i:0..<facts.count-7 {if facts[i..<i+8]=="?scene=1" || facts[i..<i+8]=="&scene=1" {e:=i+8;if e==facts.count || facts[e]=='\n' || facts[e]=='&' || facts[e]=='#' {return true;}}}return false;
}

#test "animation heading uses the smaller creator font and plus minus toggle" {
 s:Creator;s.preview_collapsed=true;s.height=720;s.scale=1;
 out:[64000]f32;expected:[4096]f32;n:=dev_panel(s,out[..],1280,720,1);
 e:=text(expected[..],0,"+ ANIMATIONS",32,45,10,ink(1,0.95,0.9,0.7));#assert n==e;
 for i:0..<n*16 {#assert out[i]==expected[i];}
 s.preview_collapsed=false;n=dev_panel(s,out[..],1280,720,1);
 e=text(expected[..],0,"- ANIMATIONS",32,45,10,ink(1,0.95,0.9,0.7));#assert n>e;
 for i:0..<e*16 {#assert out[i]==expected[i];}
}

#test "creator main font uses textured glyphs at heading and control sizes, each over its shadow" {
  out:[4096]f32;k:=ink(1,1,1,1);
  for cap:0..<2 {n:=text(out[..],0,"Character Create",0,50,ifx cap==0 then 8 else 22,k);#assert n==180;
    for i:0..<n {#assert out[i*16+11]==MODE_SANS;}}
}

#test "creator explicit player save waits for storage confirmation and preserves a snapshot" {
  s:[1]Creator;ensure(s[..]);change(s[..],0,1);change(s[..],12,3);request_player(s[..],true);
  #assert s[0].profile_pending && s[0].profile_request && !s[0].profile_ok;
  bytes:[64]u8;for i:0..<56 {bytes[i]=s[0].profile_bytes[i];}
  change(s[..],4,1);player_reply(s[..],cast(string)bytes[0..<56]);
  #assert s[0].profile_ok && s[0].profile_go && s[0].profile_revision!=s[0].revision;
  request_player(s[..],false);player_reply(s[..],"");#assert s[0].profile_failed && !s[0].profile_pending && !s[0].profile_go;
}

// The explicit shared player profile is separate from automatic draft saving.
request_player :: (s:[]Creator,go:bool) {
 if s[0].profile_pending {return;}ensure(s);n:=save(s[0],s[0].profile_bytes[..]);if n!=56 {return;}
 s[0].profile_at=s[0].revision;s[0].profile_pending=true;s[0].profile_request=true;s[0].profile_want_go=go;s[0].profile_go=false;s[0].profile_failed=false;
}
player_reply :: (s:[]Creator,t:string) {
 if !s[0].profile_pending {return;}s[0].profile_pending=false;s[0].profile_request=false;
 same:=t.count==56;if same {for i:0..<56 {if t[i]!=s[0].profile_bytes[i] {same=false;}}}
 s[0].profile_failed=!same;s[0].profile_ok=same;s[0].profile_go=same && s[0].profile_want_go;
 if same {s[0].profile_revision=s[0].profile_at;}
}
load_player :: (s:[]Creator,t:string) {
 a:[1]appearance.CharacterAppearance;if !appearance.ca_restore(a[..],t) {return;}
 if !s[0].configured {ok:=restore(s,t);}
 b:[64]u8;n:=save(s[0],b[..]);same:=n==t.count;if same {for i:0..<n {if b[i]!=t[i] {same=false;}}}
 s[0].profile_ok=true;s[0].profile_revision=ifx same then s[0].revision else -1;
}
#test "creator shared player loads without overwriting a different working draft" {
 a:[1]Creator;ensure(a[..]);a[0].female=true;a[0].eye_color=3;b:[64]u8;n:=save(a[0],b[..]);
 s:[1]Creator;load_player(s[..],cast(string)b[0..<n]);#assert s[0].female && s[0].profile_ok && s[0].profile_revision==s[0].revision;
 change(s[..],4,1);load_player(s[..],cast(string)b[0..<n]);#assert s[0].dye==0 && s[0].profile_revision<0;
}
#test "creator source grass instances use a separate bounded static draw" {
 s:[1]Creator;b:[1]figs.Bodies;out:[44*24]f32;ensure(s[..]);for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}
 catalog(s[..],"C glade/environment 9 12 250 100 8 0\nC glade/grass 21 465 250 164 20000 0\n");
 for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}b[0].ready=true;
 n:=scene(s[..],b[..],out[..]);#assert out[(n-1)*24+15]==17 && out[(n-1)*24]==164;
 #assert b[0].draws[(n-1)*4+2]==cast(u32)(n<<16) && b[0].draws[(n-1)*4+3]==20000;
 s[0].scene_only=true;n=scene(s[..],b[..],out[..]);#assert n==2;
 catalog(s[..],"C glade/grass 0 465 250 100 65536 0\n");#assert s[0].grass_groups==0;
}

#test "a zone's clearing on the open field goes to the rocks' grid alone" {
 s:[1]Creator;b:[1]figs.Bodies;out:[44*24]f32;ensure(s[..]);
 catalog(s[..],"C glade/meadow 40 600 250 300 0 0\nC glade/meadowkit20 700 90 250 310 0 0\nC glade/meadowkit25 800 120 250 320 0 0\n");
 for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}b[0].ready=true;s[0].scene_only=true;s[0].field=true;
 n:=scene(s[..],b[..],out[..]);#assert n==3 && out[24]==20 && out[48]==25;
 for k:0..<4 {#assert out[24+8+k]==0 && out[48+8+k]==0;}   // no clearing: the meadow as it is everywhere
 s[0].field_clear=[4]f32.[-34,-43,34,59];n=scene(s[..],b[..],out[..]);
 #assert n==3 && out[24+8]== -34 && out[24+9]== -43 && out[24+10]==34 && out[24+11]==59 && out[24+3]==0;
 s[0].field_band=10;s[0].field_keep=0.25;n=scene(s[..],b[..],out[..]);#assert out[24+3]==10 && out[24+4]==0.25 && out[48+3]==0 && out[48+4]==0;
 for k:0..<4 {#assert out[48+8+k]==0;}   // the flowers grow in it
}
#test "the open field draws Everglade II's meadow, its grass and its understory in place of the glade" {
 s:[1]Creator;b:[1]figs.Bodies;out:[44*24]f32;ensure(s[..]);
 catalog(s[..],"C glade/environment 9 12 250 100 8 0\nC glade/grass 21 465 250 164 20000 0\nC glade/meadow 40 600 250 300 0 0\nC glade/meadowkit33 700 90 250 310 0 0\nC glade/meadowkit25 800 120 250 320 0 0\nC glade/meadowkit23 900 50 250 300 0 0\n");
 for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}b[0].ready=true;s[0].scene_only=true;
 n:=scene(s[..],b[..],out[..]);#assert n==2;#assert b[0].draws[0]==9;#assert out[15]==16;#assert out[24]==164;
 s[0].field=true;n=scene(s[..],b[..],out[..]);
 // the meadow's ground, then the flowers' one grid (kit 25) and the grass's four tiers (kit 33); the
 // glade's own grass, and a kit the meadow does not scatter (23), stay out
 #assert n==6 && b[0].draws[0]==40 && b[0].draws[1]==600 && out[7]==300 && out[8]==1;
 #assert b[0].draws[4]==800 && b[0].draws[5]==120 && b[0].draws[6]==cast(u32)(2<<16) && b[0].draws[7]==49*49 && out[24+15]==20 && out[24]==25 && out[24+7]==320;
 // and no dungeon darkens it (cg_dungeon_in): the field has none
 lu:[104]f32;s[0].dungeon_n=dungeon.DG_CHUNKS;dungeon_light(s[..],lu[..],0,0);#assert lu[64]==0;s[0].dungeon_n=0;
 for t:0..<4 {r:=2+t;#assert b[0].draws[r*4]==700 && out[r*24+7]==310 && out[r*24]==33 && out[r*24+1]==f32(t) && b[0].draws[r*4+3]==cast(u32)(grid.e2_meadow_side(33,t)*grid.e2_meadow_side(33,t));}
 // with no meadow in the pack the field shows the glade, never nothing
 catalog(s[..],"C glade/environment 9 12 250 100 8 0\n");for i:0..<80 {if appearance.PART_NAMES[i]!="" {s[0].source_count[i]=3;}}n=scene(s[..],b[..],out[..]);#assert n==1 && b[0].draws[0]==9;
}
#test "creator texture detail is bounded independently for desktop and phone layouts" {
 s:Creator;s.on=true;s.width=1440;#assert texture_side(s)==1024;
 s.width=390;#assert texture_side(s)==512;s.on=false;#assert texture_side(s)==0;
}
texture_side :: (s:Creator)->int {if !s.on {return 0;}return ifx s.width>=840*s.scale then 1024 else 512;}

#test "creator camera stays above terrain at every zoom pitch and pan limit" {
 s:[1]Creator;u:[104]f32;out:[64000]f32;
 for i:0..<3 {for j:0..<3 {for py:0..<3 {for px:0..<3 {
  s[0].dist=[3]f32.[0.65,3.1,6][i];s[0].pitch=[3]f32.[-0.2,0.1,0.6][j];s[0].pan_y=cast(f32)(py-1)*2;s[0].pan_x=cast(f32)(px-1)*2;
  cc_view(s[0],u[..],1440,900,1);
  #assert u[17]>=glade.cg_height(u[16],u[18])+0.2799 && u[22]<0;
 }}}}
}

#test "combat health labels retain class maximum and separate temporary HP" {
  b: [96] u8;
  #assert eg_hp_label(b[..],7,12,0)=="HP 7 / 12";
  #assert eg_hp_label(b[..],100,120,9)=="HP 100 / 120 + 9 TEMP";
