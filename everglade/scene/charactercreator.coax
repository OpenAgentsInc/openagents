// The Metaverse Engine's live Quaternius wardrobe. Shared people parts, skinning and baked clips;
// no cloned geometry or per-outfit skeleton. Used by fivelab's character-creator route.
#module "openagents.charactercreator";
#load "../../metaverse-engine/ui/font.coax";
#load "../dragon-clips.coax" as dragon;   // the Shapechange dragon's baked frames
#load "../../metaverse/character-glade.coax" as glade;
#load "../../metaverse/experimental-terrain.coax" as meadow;
#load "../../metaverse/experimental-grass-grid.coax" as ggrid;    // the glade's grass seeds by cell (meadow_cull)
#load "../../metaverse/experimental-grass-baked.coax" as gbaked;  // where each cell's seeds start in the committed glade pack
#load "../../metaverse-engine/render/geometry/grid-cull.coax" as gcull;   // the open field draws only the cells its view can see (meadow_cull)
#load "../world/meadow-grid.coax" as grid;   // the open field's scatter grids (everglade/world/meadow.coax)
#load "../../metaverse/experimental-village.coax" as village;
#load "../../metaverse-engine/cam/follow.coax" as follow;
#load "../../metaverse-engine/physics/query.coax" as query;
#load "../../metaverse-engine/core/space.coax" as world;
#load "charactercreator-font.coax";
#load "../hud/fonts.coax";   // Everglade's HUD faces: Spectral to read, Cinzel for names and places
#load "../../metaverse-engine/ui/hud-menu.coax";   // the engine's HUD style layer (hud-style.coax) and widgets; Everglade draws in FANTASY (docs/metaverse/hud-styles.md)
#load "../hud/parts.coax";   // Everglade's HUD parts in that style (the game's, every zone's)
#load "../hud/screens.coax";   // Everglade's plain HUD parts: the clip list, health, the boxes (#13083)
#load "../hud/numbers.coax";   // Everglade's damage numbers, every zone's (#13080)
#load "../../metaverse/experimental-hostiles.coax" as hostile;
#load "../../metaverse/experimental-dungeon.coax" as dungeon;
