VERTEX_FLOATS :: 16;
#load "bodies.coax" as figs;
#load "../../metaverse-engine/action/attach-overlap.coax" as overlap;   // a held item through the body (#13073)
#load "../../metaverse-engine/cam/mouselook.coax" as mlook;   // Experimental's world: the mouse looks round with no button held
#load "../../metaverse-engine/cam/firstperson.coax" as fpcam;   // zoomed all the way in, the camera is your eyes
#load "../../metaverse-engine/action/mount.coax" as mount;
#load "../../metaverse-engine/action/deed.coax";       // your bearing, as the mounts ask with it
#load "../mounts.coax" as egm;   // Everglade's horses (everglade/docs/mounts-spec.md)
#load "../../metaverse-engine/world/props.coax" as wprops;   // a zone's own standing things: what you walk into and an arrow sticks in
#load "../zone-mounts.coax";   // Everglade's horse and red dragon standing in a zone: placed, mounted, ridden, their prompt (game)
#load "../../metaverse-engine/cam/track.coax" as trk;   // a ?stage= setup's camera track (fivelab.coax lab_stage)
#load "../../metaverse-engine/world/build-site.coax" as bs;          // build sites at any progress (#13106)
#load "../world/housewright.coax" as hw;      // the house tiers' parts
