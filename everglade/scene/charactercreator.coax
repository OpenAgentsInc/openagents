  bytes:[64]u8;n:=save(s[0],bytes[..]);t:[1]Creator;
  #assert restore(t[..],cast(string)bytes[0..<n]) && t[0].outfit==2 && !t[0].worn[39] && t[0].eye_color==3;
  #assert !available(t[0],39);
}

#test "creator mouse buttons select rotate or pan per drag without a toggle" {
  s:[1]Creator;creator_layout(s[..],1440,900,1);s[0].pan_mode=true;
  yaw:=s[0].yaw;ok:=mouse_pointer(s[..],700,400,0,31,0);ok=mouse_pointer(s[..],800,450,1,31,-1);ok=mouse_pointer(s[..],800,450,2,31,0);
  #assert s[0].yaw>yaw && s[0].pan_x==0 && s[0].pan_y==0;
  yaw=s[0].yaw;pitch:=s[0].pitch;
  ok=mouse_pointer(s[..],700,400,0,31,2);ok=mouse_pointer(s[..],800,550,1,31,-1);
  #assert s[0].pan_x<0 && s[0].pan_y>0 && s[0].yaw==yaw && s[0].pitch==pitch;
  ok=mouse_pointer(s[..],800,550,2,31,0);#assert s[0].dragging;
  ok=mouse_pointer(s[..],800,550,2,31,2);#assert !s[0].dragging;
  before:=s[0].outfit;ok=mouse_pointer(s[..],250,250,0,31,2);ok=mouse_pointer(s[..],250,250,2,31,2);#assert s[0].outfit==before;
}

// DOM button numbers: left 0, right 2. Latch the gesture on down; moves may report -1.
mouse_pointer :: (s:[]Creator,x:f32,y:f32,phase:int,id:int,button:int)->bool {
  if s[0].walk.on {return true;}
  if s[0].experimental {
    if dev_pointer(s,x,y,phase) {return true;}
    if phase==0 {mlook.ml_press(s[0].ml[..],ifx s[0].ml[0].touch then 1 else 0);s[0].dragging=true;s[0].drag_id=id;s[0].dx=x;s[0].dy=y;}
    else if id==s[0].drag_id && phase==1 && s[0].dragging {s[0].yaw-=(x-s[0].dx)*0.0055;s[0].pitch=cc_clamp(s[0].pitch+(y-s[0].dy)*0.0055,-1.2,1.2);s[0].dx=x;s[0].dy=y;}
    else if phase==2 || phase==3 {s[0].dragging=false;}return true;
  }
  if phase==0 {
    if s[0].dragging || (button!=0 && button!=2) {return true;}
    s[0].drag_button=button;
    if button==2 {s[0].down=-1;s[0].dragging=true;s[0].drag_pan=true;s[0].drag_id=id;s[0].dx=x;s[0].dy=y;return true;}
    used:=pointer(s,x,y,phase,id);s[0].drag_pan=false;return used;
  }
  if phase==2 && button!=s[0].drag_button {return true;}
  return pointer(s,x,y,phase,id);
}

#test "creator registry identities preserve CC2 wardrobe keys and require complete referenced meshes" {
