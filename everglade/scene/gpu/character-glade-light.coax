// Character Create's glade light, now the shared painterly default (lighting plan Phase 1 step 0,
// GitHub #13060). The functions and numbers live in the Metaverse Engine: the profile's numbers in
// metaverse-engine/world/environment.coax (ENV_GLADE_*, env_glade_profile), their evaluation in
// metaverse-engine/render/shade/painterly.coax, the transfer helpers in metaverse-engine/render/transfer.coax and the normal
// packing in metaverse-engine/render/shade/contact-shade.coax, with their checks. The cg_* names below are thin
// delegates. Since #13066 every one that lights (the key, the ambient, the air, the film and output)
// reads the frame's resolved environment, which the page writes into its uniforms at PAINT_ENV_U
// (metaverse-engine/render/shade/environment-frame.coax), so Character Create, Everglade II, Experimental and the
// lighting probes all draw what the resolver gives them. The transfer and packing names need none.
#load "../../../metaverse-engine/render/shade/painterly.coax";
#load "../../../metaverse-engine/render/shade/contact-shade.coax";
#test "the glade's names are the shared painterly default's, read from the frame's record" {
 u:=paint_env_glade_u();
 n:=normalize3(v3(0.3,0.7,-0.4));e:=v3(0,1,3);p:=v3(4,2,-50);c:=v3(0.4,0.3,0.2);
 #assert cg_linear(0.5)==transfer_linear(0.5) && cg_srgb(0.5)==transfer_srgb(0.5) && cg_shoulder(3)==transfer_shoulder(3);
 #assert cg_decode(c).y==transfer_decode(c).y && cg_encode(c).z==transfer_encode(c).z && cg_film(paint_env_of(u[..]),c).x==paint_film(c).x && cg_output(paint_env_of(u[..]),c).y==paint_output(c).y;
 #assert abs(cg_hemisphere(paint_env_of(u[..]),n).x-paint_hemisphere(n).x)<0.000001 && abs(cg_irradiance(paint_env_of(u[..]),n,0.5,0.7,0.3).z-paint_irradiance(n,0.5,0.7,0.3).z)<0.000001;
 #assert cg_air_depth(paint_env_of(u[..]),e,p)==paint_air_depth(e,p) && cg_phase(0.4,0.62)==paint_phase(0.4,0.62) && cg_haze_window(paint_env_of(u[..]),50)==paint_haze_window(50);
 #assert abs(cg_sun_dir(paint_env_of(u[..])).y-paint_sun_dir().y)<0.000001 && cg_sun_colour(paint_env_of(u[..])).z==paint_sun_colour().z && abs(cg_atmosphere(paint_env_of(u[..]),c,e,p).x-paint_atmosphere(c,e,p).x)<0.000001;
 #assert cg_sign(-2)==shade_sign(-2) && cg_normal_pack(n).x==shade_normal_pack(n).x && cg_normal_unpack(v2(0.2,-0.3)).z==shade_normal_unpack(v2(0.2,-0.3)).z;
}
cg_linear :: (x:f32)->f32 {return transfer_linear(x);}
cg_srgb :: (x:f32)->f32 {return transfer_srgb(x);}
cg_decode :: (c:V3)->V3 {return transfer_decode(c);}
cg_encode :: (c:V3)->V3 {return transfer_encode(c);}
cg_shoulder :: (x:f32)->f32 {return transfer_shoulder(x);}
cg_film :: (env:EnvBlock,c:V3)->V3 {return paint_env_film(env,c);}
cg_output :: (env:EnvBlock,c:V3)->V3 {return paint_env_output(env,c);}
cg_hemisphere :: (env:EnvBlock,n:V3)->V3 {return paint_env_hemisphere(env,n);}
cg_irradiance :: (env:EnvBlock,n:V3,direct:f32,occlusion:f32,visibility:f32)->V3 {return paint_env_irradiance(env,n,direct,occlusion,visibility);}
cg_air_depth :: (env:EnvBlock,eye:V3,p:V3)->f32 {return paint_env_air_depth(env,eye,p);}
cg_phase :: (cos_t:f32,g:f32)->f32 {return paint_phase(cos_t,g);}
cg_haze_window :: (env:EnvBlock,distance:f32)->f32 {return paint_env_haze_window(env,distance);}
cg_sun_dir :: (env:EnvBlock)->V3 {return paint_env_sun_dir(env);}
cg_sun_colour :: (env:EnvBlock)->V3 {return paint_env_sun_colour(env);}
cg_atmosphere :: (env:EnvBlock,colour:V3,eye:V3,p:V3)->V3 {return paint_env_atmosphere(env,colour,eye,p);}
cg_sign :: (x:f32)->f32 {return shade_sign(x);}
cg_normal_pack :: (n:V3)->V2 {return shade_normal_pack(n);}
cg_normal_unpack :: (p:V2)->V3 {return shade_normal_unpack(p);}
